<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TH" style="id">tcfU (54-2Tes) - Me̱ꞌpha̱a̱ Mañúwi̱ín (Malinaltepec), PZM Sep-2006, c3/v47</book>
  <para style="h">2 Xa̱bo̱ Tesalóni̱ka̱</para>
  <para style="toc3">2 Ts</para>
  <para style="toc2">2 Xa̱bo̱ Tesalóni̱ka̱</para>
  <para style="toc1">Riajma̱ i̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inúú xa̱bo̱ Tesalóni̱ka̱</para>
  <para style="mt2">Riajma̱ i̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inúú</para>
  <para style="mt1">Xa̱bo̱ Tesalóni̱ka̱</para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="s">Páblo̱ naraxi̱in tsí nanimbu̱únꞌ juyáá Jesús ná xuajen Tesalóni̱ka̱</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1" />Ikhúúnꞌ ñajunꞌ Páblo̱, ga̱jmi̱ꞌ Silbáno̱ jamí Timotéo̱.</para>
  <para style="p" vid="2TH 1:1">Nu̱tháánxo̱ꞌ i̱yi̱i̱ꞌ ríge̱ꞌ ma̱ꞌga ná inúú tsí nanimbu̱únꞌ juyáá Jesús ná xuajen Tesalóni̱ka̱, tsáanꞌ mbá ꞌnduꞌ juwalaꞌ ná inuu Ana̱ꞌlóꞌ xúꞌkhue̱n máꞌ ná inuu Táta̱ Jesukrísto̱.<verse eid="2TH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2" />A̱gu̱ma-tsakun-rámáaꞌlaꞌ jamí ga̱juwalaꞌ tsímáá gáꞌne Ana̱ꞌlóꞌ Mikhuíí jamí Táta̱ Jesukrísto̱.<verse eid="2TH 1:2" /></para>
  <para style="s">Ana̱ꞌlóꞌ maxúdaa awan ga̱jma̱á numúú xa̱bo̱ ído̱ rí ma̱ꞌkha̱a Krísto̱</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />A̱ngui̱nꞌ, jámba̱ miꞌtsú jaꞌyoo rí mu̱rígu̱uxo̱ꞌ gamaku ná inuu Ana̱ꞌlóꞌ ga̱jma̱á numalaꞌ. Xkuaꞌnii jaꞌyoo rí mu̱ne̱xo̱ꞌ numuu rí na̱ka̱-ragaja̱a̱ rí wéje̱ a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ, xúꞌkhue̱n máꞌ mbá xúgiáanꞌlaꞌ jamí mbámbáa tsí ikháanꞌlaꞌ na̱ka̱-ragaja̱a̱ i̱tha̱án rí nandalaꞌ ju̱ñu̱ú tsí i̱ꞌwíin. <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />Ikhaa jngó ikháanꞌxo̱ꞌ maphú nadxu a̱kia̱nꞌxo̱ꞌ e̱ne̱laꞌ ná inúú mbámbá kuthuun tsí nanimbu̱únꞌ juyáá Ana̱ꞌlóꞌ. Nu̱thúu̱nxo̱ꞌ rí maske máꞌ nuña̱ꞌlaꞌ mi̱ndaꞌkho xa̱bo̱, ikháanꞌlaꞌ kuajún-gúkuálaꞌ jamí wéje̱ a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ, jamí na̱ꞌngo̱o̱ a̱kia̱nꞌlaꞌ inuu mbá xúgíí rí nune̱-ngínáaꞌlaꞌ. <verse eid="2TH 1:4" /><verse number="5" style="v" sid="2TH 1:5" />Mbá xúgíí rúꞌkhue̱n nasngájma rí Ana̱ꞌlóꞌ máján naxúdaa̱ awan ga̱jma̱á numúú xa̱bo̱, kajngó ikháanꞌlaꞌ ma̱juwa-na̱ma̱ñalaꞌ rí ma̱nindxa̱ꞌlaꞌ xa̱bo̱ tsí nithán-ñájúún eꞌne Ana̱ꞌlóꞌ, numuu rí ikhaa máꞌ numuu rúꞌkhue̱n nu̱míni̱ílaꞌ rí xúge̱ꞌ.<verse eid="2TH 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 1:6" />Numuu rí Ana̱ꞌlóꞌ phú jmbii̱, ikhaa̱ ma̱ꞌnii̱ rí mu̱míni̱í xa̱bo̱ tsí nune̱-ngínáaꞌlaꞌ. <verse eid="2TH 1:6" /><verse number="7" style="v" sid="2TH 1:7" />Xómáꞌ ikháanꞌlaꞌ tsáanꞌ juwa nu̱míni̱ílaꞌ xúge̱ꞌ rá, Ana̱ꞌlóꞌ ma̱ꞌne rí mbu̱ya̱a xa̱ꞌlaꞌ xómá ma̱ꞌnii̱ ga̱jma̱á nindxa̱ꞌ ikháanꞌxo̱ꞌ. Rúꞌkhue̱n ma̱ꞌnii̱ ído̱ ma̱kujma rí na̱ꞌkha̱a Táta̱ Jesús ná majñu̱u̱ ri̱ꞌyu̱u̱ agu asndo ná mikhuíí gajmíi̱ ánje̱l tsí juya̱ ski̱yu̱u̱ꞌ. <verse eid="2TH 1:7" /><verse number="8" style="v" sid="2TH 1:8" />Kajngó ma̱ꞌnii̱ rí xa̱bo̱ tsí ra̱khúún gúne̱-nuwiin Ana̱ꞌlóꞌ mune̱-numa̱a rí nene̱ ga̱jma̱á jamínu̱ꞌ, xúꞌkhue̱n máꞌ ga̱jma̱á numuu rí tsíni̱i̱ rí naꞌsngáá ajngáa máján ga̱jma̱á numuu Tátiálóꞌ Jesukrísto̱.<note caller="+" style="f"><char style="fr" closed="false">1.8 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «Tátiálóꞌ Jesús». Xkuaꞌnii máꞌ ná na̱gi̱ꞌdu̱u̱n kíxnuu 12 mangaa.</char></note> <verse eid="2TH 1:8" /><verse number="9" style="v" sid="2TH 1:9" />Xa̱bo̱ tsúꞌkhue̱n mu̱dri̱gú mbá jamínu̱ꞌ rí ni miꞌtsú tsíyámba̱. Ma̱ju̱wée̱ꞌ tsíngua̱ꞌ ná inuu Táta̱, ná mu̱xúyáa̱ rí maphú mba̱a̱ tsiakhe̱ drígo̱o̱. <verse eid="2TH 1:9" /><verse number="10" style="v" sid="2TH 1:10" />Ído̱ gága̱nú mbiꞌi rí ma̱ꞌkha̱a Táta̱, mi̱tiamakuíi̱ gúne̱ xa̱bii̱ tsí ninimbu̱únꞌ juyáa̱ jamí phú ma̱makúu̱n gáꞌnii̱. Ikháanꞌlaꞌ máꞌ mangáanꞌlaꞌ jimáaꞌlaꞌ ga̱jma̱á nindxu̱ún tsúꞌkhue̱n, numuu rí ninimba̱ꞌlaꞌ ju̱ya̱á ajngáa rí ni̱tha̱nꞌlaꞌxo̱ꞌ ga̱jma̱á numuu Táta̱.<verse eid="2TH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11" />Ikhaa numuu rúꞌkhue̱n, jámba̱ miꞌtsú nu̱tha̱n-jáñííxo̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á numalaꞌ, kajngó ikhaa̱ ma̱ꞌnii̱ rí ma̱juwalaꞌ xómá ga̱náꞌyoo rí ma̱ju̱wá xa̱bo̱ tsí ikhaa̱ nindxaꞌwúu̱n. Xúꞌkhue̱n máꞌ nu̱tha̱n-jáñííxo̱ꞌ Ana̱ꞌlóꞌ rí ga̱jma̱á ski̱yu̱u̱ꞌ ga̱ꞌne-gáxu̱u̱ mbá xúgíí rí máján rí nu̱ꞌgí-mijnálaꞌ rí mu̱ne̱laꞌ, jamí mbá xúgíí ñajun rí nu̱ne̱laꞌ numuu rí wéje̱ a̱kia̱nꞌlaꞌ ná inuu̱. <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" />Xkuaꞌnii kajngó Tátiálóꞌ Jesukrísto̱ mi̱tiamakuíí gúne̱ xa̱bo̱ ga̱jma̱á numalaꞌ ikháanꞌlaꞌ, jamí ikhaa̱ mbayamakualaꞌ ikháanꞌlaꞌ. Mbá xúgíí rúꞌkhue̱n ma̱ꞌne xkuaꞌnii, numuu rí maphú májáan a̱kui̱in Ana̱ꞌlóꞌ jamí Táta̱ Jesukrísto̱.<verse eid="2TH 1:12" /></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="s">Mbiꞌi rí ma̱kujmaa xa̱bo̱ numbaa tsí ninújngoo naꞌne aꞌkhán</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />A̱ngui̱nꞌ, xómáꞌ ga̱jma̱á numuu mbiꞌi rí ma̱ꞌkha̱a Tátiálóꞌ Jesukrísto̱ rá, jamí xáne ma̱mba̱xíiꞌlóꞌ ga̱jma̱á nindxu̱u̱, phú nu̱tha̱n-jáñalaꞌxo̱ꞌ <verse eid="2TH 2:1" /><verse number="2" style="v" sid="2TH 2:2" />rí mu̱xúni̱ꞌñá-mijnálaꞌ rí mbá nacha̱ jayu mune̱-ngra̱ꞌáanꞌlaꞌ xa̱bo̱, ni máꞌ ma̱xájuwalaꞌ gaꞌkho̱ gáꞌne rí nuthan xa̱bo̱, rí ni̱ga̱nú máꞌ mbiꞌi rí ma̱ꞌkha̱a Táta̱. Maske máꞌ nuthee̱n rí Xu̱u̱ꞌ Ana̱ꞌlóꞌ ni̱gu̱wíjnga̱a ajngáa ná inúu̱, o nuthee̱n rí xkuaꞌnii nu̱dxawíi̱n nuthan xa̱bo̱ mbo̱ꞌ, o nuthee̱n rí ni̱dri̱guíi̱ mbá i̱yi̱i̱ꞌ rí ikháanꞌxo̱ꞌ ni̱tháán mbo̱ꞌ, ma̱xánimba̱ꞌlaꞌ ju̱ñúu̱. <verse eid="2TH 2:2" /><verse number="3" style="v" sid="2TH 2:3" />Asndo nimbáa ma̱xáꞌne-nduwáanꞌlaꞌ ga̱jma̱á nimbá rí nuthan xa̱bo̱. Numuu rí mbiꞌi rí ma̱ꞌkha̱a Táta̱, ma̱xága̱nú ne̱ asndo mbiꞌi rí ma̱ju̱wá xa̱bo̱ tsí tsíñúú mbá jayu gánimbu̱únꞌ juyáá Ana̱ꞌlóꞌ, jamí ma̱kujmaa xa̱bo̱ numbaa tsí ninújngoo naꞌne aꞌkhán,<note caller="+" style="f"><char style="fr" closed="false">2.3 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán: «tsí tsíꞌne-mbánuu xtángoo».</char></note> tsí wéje̱ máꞌ rí ma̱mbáa jámuu. <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" />Tsúꞌkhue̱n ñajuun xa̱bo̱ sia̱nꞌ ga̱jma̱á nindxu̱u̱ mbá xúgíí rí nuxna-mbiꞌíí xa̱bo̱ Ana̱ꞌlóꞌ o mbá xúgíí rí nune̱-mba̱a̱ xa̱bo̱ mbo̱ꞌ. Asndo maꞌgíi̱ xílii̱ ná guꞌwá dxákuiin Ana̱ꞌlóꞌ kajngó ma̱gi̱ꞌi̱i̱, jamí maꞌthée̱n rí ikhaa̱ ñajuu̱n Ana̱ꞌlóꞌ.<verse eid="2TH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5" />Á tsírmáꞌáan a̱kia̱nꞌlaꞌ rí ni̱tha̱nꞌlaꞌ máꞌ ríge̱ꞌ nákhí xóó xtáá ga̱jma̱á nindxa̱ꞌlaꞌ dxe̱ꞌ. <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />Jamí xúge̱ꞌ ikháanꞌlaꞌ ndu̱ya̱álaꞌ dí ñajuun rí narikhoo xa̱bo̱ aꞌkhán tsúꞌkhue̱n, kajngó ma̱kujmaa̱ asndo gága̱nú mbiꞌi rí jaꞌyoo ma̱kujmaa̱. <verse eid="2TH 2:6" /><verse number="7" style="v" sid="2TH 2:7" />Numuu rí nañajun máꞌ ná numbaa awan ngu̱ꞌwa̱ drígo̱o̱ rí ra̱máján, i̱ndo̱ó numuu rí xúge̱ꞌ xtáa tsí narikhoo ne̱, asndo gága̱nú mbiꞌi rí ma̱ꞌga jiꞌyáa janíí tsí narikhoo ne̱ ná majñu̱ú xa̱bo̱. <verse eid="2TH 2:7" /><verse number="8" style="v" sid="2TH 2:8" />A̱ꞌkhue̱n rí masngájma-mina̱ꞌ xa̱bo̱ tsúꞌkhue̱n tsí ninújngoo naꞌne aꞌkhán, tsí ma̱ja̱ñúu gáꞌne Táta̱ Jesús ga̱jma̱á xu̱u̱ꞌ rawuun, jamí ma̱ꞌne-gámbaa̱ ga̱jma̱á rí phú wáá nambiꞌi-taꞌaa̱ ído̱ gáꞌkhaa̱. <verse eid="2TH 2:8" /><verse number="9" style="v" sid="2TH 2:9" />Jmína̱a̱ꞌ máꞌ Satanás ma̱ꞌne rí masngájma-mina̱ꞌ xa̱bo̱ aꞌkhán tsúꞌkhue̱n ga̱jma̱á phú mba̱a̱ tsiakhe̱, kajngó phú ma̱makúún xa̱bo̱ gáꞌnii̱ ga̱jma̱á rí phú wáá mi̱nduwa rí ma̱ꞌnii̱. <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />Ma̱jmuu̱ mbá xúgíí inii rí xkawe̱ꞌ kajngó ma̱ꞌne-nduwii̱n tsí na̱ka̱-rayámbi̱in, numuu rí ra̱khúu̱n gúdri̱guíi̱ ajngóo Ana̱ꞌlóꞌ, kajngó ma̱jáwíi̱n gáꞌne ne̱. <verse eid="2TH 2:10" /><verse number="11" style="v" sid="2TH 2:11" />Ikhaa numuu rúꞌkhue̱n Ana̱ꞌlóꞌ naniñúu̱ rí ma̱gu̱ma-nduwii̱n, kajngó ma̱nimbúu̱n juyáa̱ rí mi̱nduwa rúꞌkhue̱n. <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />A̱ꞌkhue̱n rí mi̱ꞌxná-máꞌíin mbá xúgíin xa̱bo̱ tsí ra̱khúún gánimbu̱ún juyáá rí gakon, rí i̱wa̱á máꞌ ni̱ni̱gúu̱n eꞌne rí ra̱máján.<verse eid="2TH 2:12" /></para>
  <para style="s">Ana̱ꞌlóꞌ niraꞌwiáanꞌlaꞌ rí ma̱jáwiáanꞌlaꞌ</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />Xómáꞌ ikháanꞌlaꞌ rá, a̱ngui̱nꞌ, tsáanꞌ nandoo jaꞌyalaꞌ Táta̱, jámba̱ miꞌtsú jaꞌyaxo̱ꞌ rí mu̱rígu̱uxo̱ꞌ gamaku ná inuu Ana̱ꞌlóꞌ ga̱jma̱á numalaꞌ. Numuu rí asndo nákhí máꞌ ni̱gi̱ꞌdu̱u̱n-muu, Ana̱ꞌlóꞌ niraꞌwiáanꞌlaꞌ rí ma̱jáwiáanꞌlaꞌ ga̱jma̱á majñu̱u̱ rí na̱ka̱-ra̱gu̱ma-jaꞌwáanꞌlaꞌ eꞌne Xu̱u̱ꞌ Ana̱ꞌlóꞌ, jamí ga̱jma̱á numuu rí wéje̱ a̱kia̱nꞌlaꞌ ná inuu rí gakon. <verse eid="2TH 2:13" /><verse number="14" style="v" sid="2TH 2:14" />Ikhaa máꞌ numuu rúꞌkhue̱n neꞌne-jáwiáanꞌlaꞌ Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ ajngáa máján rí nu̱tha̱n-ráꞌaxo̱ꞌ, kajngó ma̱nindxa̱ꞌlaꞌ xómá rí phú wáá jaꞌnii Tátiálóꞌ Jesukrísto̱. <verse eid="2TH 2:14" /><verse number="15" style="v" sid="2TH 2:15" />Ikhaa jngó, a̱ngui̱nꞌ, ga̱wajúnlaꞌ xa̱ꞌ ná inuu Ana̱ꞌlóꞌ, jamí mu̱xúni̱ꞌñáá-ranimba̱ꞌlaꞌ gisngáá rí ni̱ma̱ñalaꞌ, ga̱jma̱á majñu̱u̱ ajngáa rí ni̱tha̱nxo̱ꞌ ná inalaꞌ, o ga̱jma̱á majñu̱u̱ mbá i̱yi̱i̱ꞌ rí ni̱xu̱ꞌmáxo̱ꞌ ná inalaꞌ mbo̱ꞌ.<verse eid="2TH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16" />Ana̱ꞌlóꞌ Mikhuíí ndiyoo jaꞌyalóꞌ jamí jámuu nixnáa̱ la tsiakhe̱ a̱kia̱nꞌlóꞌ, jamí naꞌnii̱ rí ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ mu̱guáꞌthi̱ínlóꞌ rí ma̱jáwiáanꞌlóꞌ, numuu rí májáan a̱kuii̱n jaꞌyalóꞌ. Naꞌne a̱kui̱nꞌ rí jmína̱a̱ꞌ máꞌ Tátiálóꞌ Jesukrísto̱ jamí Ana̱ꞌlóꞌ Mikhuíí <verse eid="2TH 2:16" /><verse number="17" style="v" sid="2TH 2:17" />muxnáa la tsiakhe̱ a̱kia̱nꞌlaꞌ, jamí muni̱i̱ rí ma̱wajún-gúkuálaꞌ kajngó mu̱tha̱nlaꞌ jamí mu̱ne̱laꞌ mbá xúgíí inii rí máján.<verse eid="2TH 2:17" /></para>
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="s">Páblo̱ na̱nda̱ꞌa̱ rí mi̱ꞌthán-jáñíí Ana̱ꞌlóꞌ ga̱jma̱á numuu̱</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />A̱ngui̱nꞌ, ríga̱ i̱mba̱ rí nandaxo̱ꞌ mu̱tha̱nꞌlaꞌ: gu̱tha̱n-jáñíílaꞌ Ana̱ꞌlóꞌ ga̱jma̱á numaxo̱ꞌ, kajngó ma̱dróꞌoo nacha̱ ajngóo Táta̱ ná i̱ꞌwá janíí jamí mu̱dri̱gú ne̱ xa̱bo̱ ga̱jma̱á gamaku, xómá rí ni̱drígúlaꞌ ne̱ ikháanꞌlaꞌ ga̱jma̱á gamaku. <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />Xúꞌkhue̱n máꞌ gu̱tha̱n-jáñíílaꞌ Ana̱ꞌlóꞌ rí ma̱ꞌne-jáwiáanꞌlóꞌ ná inúú xa̱bo̱ tsí ra̱májíin, numuu rí ra̱ꞌkhá mbá xúgíin xa̱bo̱ wéje̱ a̱kui̱ín ná inuu Jesukrísto̱. <verse eid="2TH 3:2" /><verse number="3" style="v" sid="2TH 3:3" />I̱ndo̱ó máꞌ numuu rí jmbii Táta̱, ikhaa jngó ma̱ꞌnii̱ rí ma̱wajún-gúkuálaꞌ jamí ma̱ña̱wa̱nꞌlaꞌ inuu tsí ra̱májáan. <verse eid="2TH 3:3" /><verse number="4" style="v" sid="2TH 3:4" />Jamí naꞌne jañii a̱kia̱nꞌxo̱ꞌ ná inuu Táta̱ rí ikháanꞌlaꞌ nu̱ne̱-mbáníílaꞌ máꞌ jamí mu̱ne̱-mbáníílaꞌ xóó rí ni̱xna̱-ñájwanlaꞌxo̱ꞌ. <verse eid="2TH 3:4" /><verse number="5" style="v" sid="2TH 3:5" />Táta̱ Jesús gáꞌne rí ma̱ma̱ñalaꞌ rí ma̱galaꞌ ju̱ya̱-mijnálaꞌ xómá rí nandoo Ana̱ꞌlóꞌ jaꞌyalóꞌ, xúꞌkhue̱n máꞌ ga̱ꞌnii̱ rí ma̱ꞌngo̱o̱ a̱kia̱nꞌlaꞌ ná inuu jamínu̱ꞌ, xómá rí ni̱ꞌngo̱o̱ a̱kui̱in Krísto̱ ná inuu jamínu̱ꞌ.<verse eid="2TH 3:5" /></para>
  <para style="s">Jámba̱a̱ xa̱bo̱ jaꞌyoo rí mañajun</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />A̱ngui̱nꞌ, ga̱jma̱á máꞌ numuu Tátiálóꞌ Jesukrísto̱ nu̱xna̱-ñájwanlaꞌxo̱ꞌ rí gu̱ne̱-janíí-mijnálaꞌ inuu jámba̱a̱ dxájwalóꞌ tsí ngrigo̱o̱ꞌ naskoo, jamí na̱nguá xtáa xómá naꞌthán gisngáá rí ni̱sngálaꞌxo̱ꞌ. <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />Numuu rí jmínáaꞌ máꞌ ikháanꞌlaꞌ ndu̱ya̱álaꞌ xáne jaꞌyoo ma̱juwalaꞌ kajngó mbu̱ya̱-ri̱dalaꞌxo̱ꞌ. Ikháanꞌxo̱ꞌ táꞌskaxo̱ꞌ nákhí nijuwaxo̱ꞌ ná majña̱ꞌlaꞌ, <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />ni máꞌ tóphóxo̱ꞌ xúgi̱í gaꞌwuun nimbáa. A̱ꞌkhue̱n gakon, ni̱ñajunxo̱ꞌ mi̱ndaꞌkho mbiꞌíí mbruꞌwíín jamí neꞌne níꞌnga̱ꞌxo̱ꞌ, kajngó mu̱xúne̱-gajmááxo̱ꞌ nimbáa tsí ikháanꞌlaꞌ ga̱jma̱á numuu rí ndaꞌyáxo̱ꞌ. <verse eid="2TH 3:8" /><verse number="9" style="v" sid="2TH 3:9" />Ra̱ꞌkhá máꞌ numuu rí ra̱jáꞌyaxo̱ꞌ rí mu̱xníꞌtsaxo̱ꞌ, rí ndiyaxo̱ꞌ rí jmínáaꞌ máꞌ ikháanꞌxo̱ꞌ mu̱xna̱ꞌlaꞌ mbá xkri̱da kajngó mbu̱ya̱álaꞌ xáne jaꞌyoo ma̱juwalaꞌ. <verse eid="2TH 3:9" /><verse number="10" style="v" sid="2TH 3:10" />Numuu rí nákhí juwaxo̱ꞌ a̱ꞌkhue̱n ga̱jma̱á nindxa̱ꞌlaꞌ, nu̱xna̱-ñájwanlaꞌxo̱ꞌ ríge̱ꞌ: «Xí mbáa tsíyoo gáñajun, ma̱xákuiꞌtsii̱ máꞌ mangaa».<verse eid="2TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11" />Numuu rí nu̱dxawíínxo̱ꞌ rí mbá tikhuun tsí júwa̱ꞌ ná majña̱ꞌlaꞌ a̱ꞌkhue̱n, ngrigúu̱n naskúu̱n jamí tsíni̱i̱ nimbá ñajun, rí ngrigúu̱n nu̱xu̱ꞌdá-mijnée̱ ná gajmá rí jáꞌñúú i̱ꞌwíin. <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />Ikhiin xa̱bo̱ tsúꞌkhue̱n nu̱tha̱n-múꞌúúnxo̱ꞌ jamí nu̱xprígúúnxo̱ꞌ ga̱jma̱á numuu Tátiálóꞌ Jesukrísto̱, rí i̱ndo̱ó máꞌ gu̱ꞌgí-mijée̱ rí mu̱ñajwii̱n, kajngó mu̱guaꞌdáa̱ rí mu̱phi̱i̱. <verse eid="2TH 3:12" /><verse number="13" style="v" sid="2TH 3:13" />Xómáꞌ ikháanꞌlaꞌ rá, a̱ngui̱nꞌ, ma̱xáꞌne níꞌnga̱ꞌlaꞌ rí nu̱ne̱laꞌ rí máján.<verse eid="2TH 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TH 3:14" />Xí mbáa tsíꞌne-mbánuu rí nu̱tha̱nxo̱ꞌ ga̱jma̱á majñu̱u̱ i̱yi̱i̱ꞌ ríge̱ꞌ, gu̱ya̱á májánlaꞌ tsáa ñajuu̱n, jamí ma̱xámbáxa̱ꞌlaꞌ ga̱jma̱á nindxu̱u̱, kajngó ma̱ti̱yu̱u̱ꞌ. <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />I̱ndo̱ó máꞌ numuu rí mu̱xúguaꞌdaa̱laꞌ xómá xa̱bo̱ sia̱nꞌ dríga̱ꞌlaꞌ, rí gu̱xpríguíi̱laꞌ xómá dxájwalóꞌ.<verse eid="2TH 3:15" /></para>
  <para style="s">Naꞌthángoo Páblo̱</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />Jamí jmína̱a̱ꞌ máꞌ Táta̱ tsí naꞌne rí ma̱juwalóꞌ tsímáá, jámba̱ miꞌtsú gáxnálaꞌ rí tsímáá jamí asndo náá máꞌ rí naríga̱. Táta̱ gáxtáa ga̱jma̱á nindxa̱ꞌ mbá xúgiáanꞌlaꞌ.<verse eid="2TH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17" />Jmínu̱úꞌ ikhúúnꞌ, Páblo̱, na̱tháán ga̱jma̱á ñawúnꞌ rí na̱ra̱xáanꞌlaꞌ. Xkuaꞌnii na̱xnu̱u̱ ñawúnꞌ ikhúúnꞌ ná mbá xúgíí i̱yi̱i̱ꞌ rí na̱tháánlo̱ꞌ.<verse eid="2TH 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2TH 3:18" />Tátiálóꞌ Jesukrísto̱ gáꞌne-tsakun-rámáaꞌlaꞌ mbá xúgiáanꞌlaꞌ. Xkuaꞌnii gáꞌne.<note caller="+" style="f"><char style="fr" closed="false">3.18 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «Xkuaꞌnii gáꞌne».</char></note><verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>