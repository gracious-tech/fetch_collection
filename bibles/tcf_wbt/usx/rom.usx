<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ROM" style="id">tcfU (46-Rom) - Me̱ꞌpha̱a̱ Mañúwi̱ín (Malinaltepec) ECZ 14-oct-2005; Revisión de PZM de 26-jun-2006; c16/v433</book>
  <para style="h">Xa̱bo̱ Róma̱</para>
  <para style="toc3">Rm</para>
  <para style="toc2">Xa̱bo̱ Róma̱</para>
  <para style="toc1">I̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inúú xa̱bo̱ Róma̱</para>
  <para style="mt2">I̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inúú</para>
  <para style="mt1">Xa̱bo̱ Róma̱</para>
  <chapter number="1" style="c" sid="ROM 1" />
  <para style="s">Páblo̱ naꞌthán ga̱jma̱á numuu ajngáa máján</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1" />Ikhúúnꞌ ñajunꞌ Páblo̱, yumbée Jesukrísto̱. Watsaꞌwóꞌ rí ma̱nindxu̱ꞌ mbáa xa̱bo̱ tsí waxúngua̱a̱ꞌ, watraꞌwúún rí ma̱tha̱n-ráꞌa ajngáa máján drígo̱o̱ Ana̱ꞌlóꞌ. <verse eid="ROM 1:1" /><verse number="2" style="v" sid="ROM 1:2" />Nixuda-mine̱e̱ꞌ máꞌ ajngáa rúꞌkhue̱n asndo nákhí wajyúú mbiꞌi ga̱jma̱á majñu̱ú tsí ni̱rawíjnga̱a ajngóo̱, xómá ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ. <verse eid="ROM 1:2" /><verse number="3" style="v" sid="ROM 1:3" />Xa̱bo̱ tsúꞌkhue̱n nithan ga̱jma̱á numuu A̱dée Ana̱ꞌlóꞌ, Tátiálóꞌ Jesukrísto̱, tsí ni̱gu̱maa xómá xa̱bo̱ numbaa ná ri̱jyu̱u̱ꞌ thúngaa Dabíd. <verse eid="ROM 1:3" /><verse number="4" style="v" sid="ROM 1:4" />Xómáꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ nasngájma ga̱jma̱á mbá xúgíí tsiakhe̱ rí Jesukrísto̱ ñajuun A̱dée Ana̱ꞌlóꞌ, numuu rí ndiyáa̱ mbiꞌyuu̱. <verse eid="ROM 1:4" /><verse number="5" style="v" sid="ROM 1:5" />Ga̱jma̱á majñu̱u̱ máꞌ Jesukrísto̱ nijanúꞌ rí ma̱nindxu̱ꞌ mbáa tsí waxúngua̱a̱ꞌ, kajngó ma̱thu̱ún xa̱bo̱ ná mbá xúgíí xuajen numbaa rí ga̱nimbúu̱n juyáa̱ jamí guni̱i̱ rí nandoo̱. Na̱ne̱ ñajun ríge̱ꞌ numuu rí nandoꞌ ja̱yo̱o̱ Krísto̱. <verse eid="ROM 1:5" /><verse number="6" style="v" sid="ROM 1:6" />Ná majñu̱ú máꞌ xa̱bo̱ tsúꞌkhue̱n juwa mangáanꞌlaꞌ, jamí watsaꞌwálaꞌ rí ma̱nindxa̱ꞌlaꞌ xa̱bi̱i Jesukrísto̱. <verse eid="ROM 1:6" /><verse number="7" style="v" sid="ROM 1:7" />Na̱xu̱ꞌmá i̱yi̱i̱ꞌ ríge̱ꞌ inalaꞌ mbá xúgiáanꞌlaꞌ tsáanꞌ juwalaꞌ ná xuajen Róma̱, tsáanꞌ nandoo Ana̱ꞌlóꞌ jaꞌyalaꞌ jamí watsaꞌwálaꞌ rí ma̱gu̱ma-jaꞌwáanꞌlaꞌ. Ana̱ꞌlóꞌ Mikhuíí jamí Táta̱ Jesukrísto̱ gúne̱-tsakun-rámáaꞌlaꞌ jamí ikhii̱n máꞌ gúni̱i̱ rí ma̱juwalaꞌ tsímáá.<verse eid="ROM 1:7" /></para>
  <para style="s">Páblo̱ naꞌgí-mina̱ꞌ rí ma̱ꞌga ná Róma̱</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8" />Rí ginii jayu, na̱rígu̱u gamaku ná inuu Anu̱ꞌ Mikhuíí ga̱jma̱á numalaꞌ mbá xúgiáanꞌlaꞌ ga̱jma̱á majñu̱u̱ Jesukrísto̱. Numuu rí mbá xúgíí numbaa nuthan xa̱bo̱ ga̱jma̱á numuu rí wéje̱ a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ. <verse eid="ROM 1:8" /><verse number="9" style="v" sid="ROM 1:9" />Ikhúúnꞌ na̱yumbáá ga̱jma̱á mbá jañii a̱kui̱nꞌ ná inuu Ana̱ꞌlóꞌ rí na̱tha̱n-ráꞌa ajngáa máján ga̱jma̱á numuu A̱dée̱. Ana̱ꞌlóꞌ ndaꞌyoo rí jámba̱ miꞌtsú gíwa̱a̱n a̱kui̱nꞌ ja̱ya̱ꞌlaꞌ ído̱ rí na̱tha̱n-jáñuu̱. <verse eid="ROM 1:9" /><verse number="10" style="v" sid="ROM 1:10" />Mbámbá mbiꞌi na̱ndo̱ꞌo̱o̱ Ana̱ꞌlóꞌ rí marmáꞌthoo̱ jamba̱a̱ kajngó ma̱ꞌgá gáya̱ꞌlaꞌ, xí ikhaa̱ nandoo̱. <verse eid="ROM 1:10" /><verse number="11" style="v" sid="ROM 1:11" />Numuu rí phú naꞌne a̱kui̱nꞌ rí mba̱ya̱ꞌlaꞌ kajngó ma̱xna̱ꞌlaꞌ mbá xtambáyú rí naxná Xu̱u̱ꞌ Ana̱ꞌlóꞌ, kajngó ma̱wajún-gúkuálaꞌ. <verse eid="ROM 1:11" /><verse number="12" style="v" sid="ROM 1:12" />A̱ꞌkhue̱n rí mu̱ꞌxná-mijnálóꞌ tsiakhe̱ ga̱jma̱á numuu rí ikhaa máꞌ rí nanimba̱ꞌlóꞌ juꞌyáá, ikháanꞌlaꞌ jamí ikhúúnꞌ.<verse eid="ROM 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 1:13" />A̱ngui̱nꞌ, nandoꞌ rí ma̱gi̱da̱ꞌ idxa̱ꞌlaꞌ ríge̱ꞌ: asndo xúge̱ꞌ na̱nguá ndiyoo rí ma̱ꞌgá ná juwalaꞌ, maske máꞌ phú mbaꞌa nothon ni̱ꞌgí-mina̱ꞌ rí ma̱ꞌgá gáya̱ꞌlaꞌ. Numuu rí nandoꞌ ma̱ꞌgá gágu̱u tháan rí máján najma̱a̱ ná majña̱ꞌlaꞌ ikháanꞌlaꞌ, xómá rí na̱gu̱u ne̱ ná majñu̱ú i̱ꞌwíin xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún. <verse eid="ROM 1:13" /><verse number="14" style="v" sid="ROM 1:14" />Mbá xúgíin xa̱bo̱ gíꞌmúú inúú: xa̱bo̱ tsí na̱ju̱mu̱ú rí maphú gíꞌdoo numúú jamí xa̱bo̱ tsí ngíníi, xa̱bo̱ tsí phú na̱ma̱ñúú jamí xa̱bo̱ tsí tsíma̱ñúú mbá jayu. <verse eid="ROM 1:14" /><verse number="15" style="v" sid="ROM 1:15" />Ikhaa jngó, naꞌne a̱kui̱nꞌ rí ma̱ꞌgá máꞌ wapha gátha̱n-ráꞌalaꞌ ajngáa máján mangáanꞌlaꞌ, tsáanꞌ juwalaꞌ ná xuajen Róma̱.<verse eid="ROM 1:15" /></para>
  <para style="s">Tsiakhe̱ rí gíꞌdoo ajngáa máján</para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16" />Ikhúúnꞌ tsíti̱yu̱ꞌ eꞌne ajngáa máján, numuu rí ikhaa ne̱ ñajuun ski̱yu̱u̱ꞌ Ana̱ꞌlóꞌ rí ma̱ꞌne-jríya̱a̱ꞌ jámba̱a̱ tsí nanimbo̱o̱ꞌ jaꞌyoo ne̱, xa̱bo̱ judío̱ ginii jayu, jamí xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún mangaa. <verse eid="ROM 1:16" /><verse number="17" style="v" sid="ROM 1:17" />Numuu rí ga̱jma̱á majñu̱u̱ ajngáa máján Ana̱ꞌlóꞌ nasngájma xáne iꞌnii̱ rí ma̱nindxa̱ꞌlóꞌ xa̱bo̱ tsí nánda̱a̱ aꞌkhúún, i̱ndo̱ó máꞌ ga̱jma̱á majñu̱u̱ rí wéje̱ a̱kia̱nꞌlóꞌ ná inuu̱ ikhaa̱, xómá ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ: «Xómáꞌ xa̱bo̱ tsí nánda̱a̱ aꞌkhúun, ma̱xtáa̱ jámuu ga̱jma̱á numuu rí wéje̱ a̱kuii̱n ná inuu Ana̱ꞌlóꞌ».<note caller="+" style="f"><char style="fr" closed="false">1.17 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Abakúk 2.14.</char></note><verse eid="ROM 1:17" /></para>
  <para style="s">Gíꞌmii aꞌkhán mbá xúgíin xa̱bo̱ numbaa</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18" />Numuu rí Ana̱ꞌlóꞌ nasngájma asndo ná mikhuíí rí najiꞌnáa̱ jaꞌyoo̱ rí tsíñúú xa̱bo̱ numbaa ágúyáá rí xtáa̱ jamí rí xkawe̱ꞌ nuni̱i̱, numuu rí nawajún-ꞌthíi̱n ñajúu̱n rí gakon ga̱jma̱á rí xkawe̱ꞌ nuni̱i̱. <verse eid="ROM 1:18" /><verse number="19" style="v" sid="ROM 1:19" />Nduyáa̱ máꞌ xúgíí rí nasngájma rí xtáa Ana̱ꞌlóꞌ, numuu rí jmína̱a̱ꞌ máꞌ Ana̱ꞌlóꞌ nisngájmúu̱ ne̱. <verse eid="ROM 1:19" /><verse number="20" style="v" sid="ROM 1:20" />Tsí Ana̱ꞌlóꞌ, tsíyoo mbu̱ꞌyáa̱lóꞌ ga̱jma̱á idalóꞌ, i̱ndo̱ó máꞌ nandoo nduꞌyáálóꞌ rí jámuu gíꞌdoo̱ tsiakhe̱ jamí jámuu ñajuu̱n Ana̱ꞌlóꞌ asndo nákhí máꞌ ni̱gu̱ma-ku̱maa numbaa. Ikhaa jngó, rí ni̱gu̱ma-ku̱maa nasngájma ne̱ rí xtáa Ana̱ꞌlóꞌ. Rúꞌkhue̱n iꞌthán rí nda̱a̱ rí mune̱-tsu̱díi̱. <verse eid="ROM 1:20" /><verse number="21" style="v" sid="ROM 1:21" />Maske máꞌ xa̱bo̱ numbaa nene̱-nuwii̱n Ana̱ꞌlóꞌ, túne̱-mba̱a̱ xómá Ana̱ꞌlóꞌ, ni máꞌ túríguu̱ la gamaku inuu̱. A̱ꞌkhue̱n gakon, i̱wa̱á máꞌ ni̱ndxa̱ꞌwa̱-mijnée̱ rí tsíjmaa mbá jayu, jamí nijúgoo inúu̱ numuu rí najñaguu̱n. <verse eid="ROM 1:21" /><verse number="22" style="v" sid="ROM 1:22" />Awúun máꞌ rí ikhii̱n na̱ju̱múu̱ rí phú i̱tha̱án na̱ma̱ñúu̱, a̱ꞌkhue̱n nene̱-mijnée̱ tsí na̱nguá i̱ma̱ñúú mbá jayu. <verse eid="ROM 1:22" /><verse number="23" style="v" sid="ROM 1:23" />Ni̱riꞌkhu-raꞌáa̱ rí mune̱-mba̱a̱ Ana̱ꞌlóꞌ tsí phú wáá ñajuun jamí jámuu xtáa, ga̱jma̱á numuu rí mune̱-mba̱a̱ xtiꞌkhuu xa̱bo̱ numbaa tsí wéje̱ máꞌ rí ma̱ja̱ñúu, xtiꞌkhúún xu̱kú xna, xtiꞌkhúún xu̱kú tsí akho̱ nakhúún jamí xtiꞌkhúún xu̱kú tsí nu̱xma̱ta-mijná.<verse eid="ROM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24" />Ikhaa numuu rúꞌkhue̱n, niniñúu̱ máꞌ Ana̱ꞌlóꞌ ná awúun aꞌkhán, kajngó muni̱i̱ máꞌ rí phú xkawe̱ꞌ naꞌne a̱kuíi̱n muni̱i̱. Ikhaa jngó, nene̱-mijnée̱ rí phú mate̱ꞌ mi̱ndaꞌkho ga̱jma̱á xuñúu̱. <verse eid="ROM 1:24" /><verse number="25" style="v" sid="ROM 1:25" />Rí gakon drígo̱o̱ Ana̱ꞌlóꞌ rí wasngájmúu̱, ni̱riꞌkhu-raꞌáa̱ ne̱ ga̱jma̱á rí mi̱nduwa. Xkuaꞌnii túya̱-makuíi̱ ni máꞌ túne̱-mba̱a̱ tsí neꞌne-ku̱maa numbaa, rí i̱wa̱á máꞌ ndiya-makúu̱n jamí nene̱-mbii̱n tsí ni̱gu̱ma-ku̱mii. Xómáꞌ tsí neꞌne-ku̱maa numbaa, jámuu mbiꞌi jaꞌyoo rí ma̱gu̱ma-mba̱a̱. Xkuaꞌnii gáꞌne.<verse eid="ROM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26" />Ikhaa numuu rúꞌkhue̱n Ana̱ꞌlóꞌ niniñúu̱ rí muni̱i̱ máꞌ rí phú mate̱ꞌ mi̱ndaꞌkho naꞌne a̱kuíi̱n muni̱i̱. Asndo go̱ꞌo̱ máꞌ mangiin nánguá ibúún gajmíí xa̱bekha, xómá rí phú jaꞌyoo, rí mbáko máꞌ ikhii̱n nubúu̱n. <verse eid="ROM 1:26" /><verse number="27" style="v" sid="ROM 1:27" />Xúꞌkhue̱n máꞌ xa̱bekha mangiin, ni̱ni̱ꞌñáa̱ rí nubúu̱n gajmíi̱ go̱ꞌo̱, jamí ni̱gíꞌdíi̱n na̱ni̱gúu̱nꞌ juya-mijnée̱ mbáko máꞌ ikhii̱n. Xa̱bekha jamí xa̱bekha nune̱-mijná rí mate̱ꞌ mi̱ndaꞌkho, a̱ꞌkhue̱n nu̱dri̱guíi̱ jamínu̱ꞌ rí jaꞌyoo mu̱dri̱guíi̱ ná xuñúu̱ ga̱jma̱á numuu rí nene̱-maꞌkhí-mijnée̱.<verse eid="ROM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28" />Ga̱jma̱á numuu rí ikhii̱n ni̱ju̱múu̱ rí ra̱gíꞌdoo máꞌ numuu rí naꞌthán Ana̱ꞌlóꞌ, ikhaa jngó Ana̱ꞌlóꞌ mangaa niniñúu̱ rí mu̱ndxa̱ꞌwa̱-mijnée̱ máꞌ rí tsíjmaa mbá jayu, kajngó muni̱i̱ rí ra̱jáꞌyoo muni̱i̱. <verse eid="ROM 1:28" /><verse number="29" style="v" sid="ROM 1:29" />Gatíí mbá xúgíí inii rí ra̱máján nuni̱i̱: nuni̱i̱ mbaꞌa inii aꞌkhán, na̱ni̱gúu̱nꞌ rí ma̱guáꞌdáa̱ mi̱ndaꞌkho, nda̱a̱ gamakúu̱n. Phú naxígúu̱n juñúu̱ xa̱bo̱, nu̱radíi̱n xa̱bo̱, na̱tsa̱ñúu̱ gajmíi̱ xa̱bo̱, nune̱-nduwee̱ jamí mbáko máꞌ nuꞌgí-mijnée̱ muni̱i̱ rí xkawe̱ꞌ. <verse eid="ROM 1:29" /><verse number="30" style="v" sid="ROM 1:30" />Nune̱-xtutaa̱ ga̱jma̱á numúú xa̱bo̱, nuthan-xkawi̱i̱ꞌ numúú xa̱bo̱, tsíñúu̱ juyáa̱ Ana̱ꞌlóꞌ, nune̱-ku̱maa̱ ajngáa numúú xa̱bo̱, nu̱xu̱xí-mijnée̱, na̱ga̱níi̱ a̱kuíi̱n, nune̱-ku̱maa̱ rí xkawe̱ꞌ, tsíne̱-mbáníi̱ rí nuthan anúu̱. <verse eid="ROM 1:30" /><verse number="31" style="v" sid="ROM 1:31" />Tsíñúu̱ gánimbúu̱n rí gakon, tsíne̱-mbáníi̱ rí nuthee̱n, tsíñúu̱ juñúu̱ xa̱bo̱, tsíne̱ mba̱a̱ a̱kuíi̱n, ni máꞌ tsíñáwíin a̱kuíi̱n ene̱ xa̱bo̱. <verse eid="ROM 1:31" /><verse number="32" style="v" sid="ROM 1:32" />Nduyáa̱ mújúu̱n máꞌ awan rí gíꞌdoo Ana̱ꞌlóꞌ ga̱jma̱á numúú xa̱bo̱ tsí nune̱ mbá xúgíí rúꞌkhue̱n: gíꞌmaa rí ma̱ja̱ñúu̱. Maske máꞌ nduyáa̱ rúꞌkhue̱n, nuni̱i̱ máꞌ ne̱ tsiakhe̱, jamí ra̱ꞌkhá i̱ndo̱ó rúꞌkhue̱n, rí asndo nadxu a̱kuíi̱n ído̱ rí i̱ꞌwíin xa̱bo̱ nune̱ ne̱.<verse eid="ROM 1:32" /></para>
  <chapter eid="ROM 1" />
  <chapter number="2" style="c" sid="ROM 2" />
  <para style="s">Ana̱ꞌlóꞌ naxudaa mújúun awan ga̱jma̱á numúú xa̱bo̱</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1" />Ikhaa jngó, ikháánꞌ tsáánꞌ narathán rí ra̱máján ene̱ xa̱bo̱, nda̱a̱ rí ma̱tha̱ne̱ tsu̱di̱í, asndo tsáa máꞌ najwaanꞌ. Ído̱ narathán rí ra̱máján ene̱ i̱ꞌwíin, naraxná-maꞌán-mina̱ꞌ máꞌ ikháánꞌ, numuu rí nathane̱ ikhaa máꞌ rí nuni̱i̱ ikhii̱n. <verse eid="ROM 2:1" /><verse number="2" style="v" sid="ROM 2:2" />Xómáꞌ Ana̱ꞌlóꞌ, ído̱ naxudaa̱ awan numúú xa̱bo̱ tsí nune̱ rúꞌkhue̱n, nduꞌyáálóꞌ rí gakon rí naꞌthée̱n. <verse eid="ROM 2:2" /><verse number="3" style="v" sid="ROM 2:3" />Tsáánꞌ narathán rí ra̱máján ene̱ xa̱bo̱ jamí ikhaa máꞌ ithane̱ ikháánꞌ, á na̱ju̱ma̱a̱ꞌ rí ma̱jríñáaꞌ ído̱ rí Ana̱ꞌlóꞌ maxúdaa awan ga̱jma̱á numúú xa̱bo̱ rá dxe̱ꞌ. <verse eid="ROM 2:3" /><verse number="4" style="v" sid="ROM 2:4" />Ikháánꞌ tsítiamakuíí rí phú májáan Ana̱ꞌlóꞌ jaꞌyaaꞌ, rí phú mba̱a̱ a̱kuii̱n jamí rí na̱ꞌngo̱o̱ a̱kuii̱n ithane̱. Jamí tsífraꞌa̱a̱ꞌ rí Ana̱ꞌlóꞌ májáan a̱kuii̱n jaꞌyaa̱ꞌ numuu nandoo̱ rí ma̱thanga̱a a̱kia̱anꞌ ná inuu̱.<verse eid="ROM 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 2:5" />Xómáꞌ ikháánꞌ phú najñaguíín jamí tsíyoo gáthanga̱a a̱kia̱anꞌ inuu Ana̱ꞌlóꞌ. Ga̱jma̱á numuu rúꞌkhue̱n nathane̱-matíí jamínu̱ꞌ rí ma̱tri̱gú ído̱ gága̱nú mbiꞌi rí mu̱míni̱í xa̱bo̱, ikhaa máꞌ mbiꞌi rí Ana̱ꞌlóꞌ masngájma rí máján naxudaa̱ awan ga̱jma̱á numúú xa̱bo̱. <verse eid="ROM 2:5" /><verse number="6" style="v" sid="ROM 2:6" />Numuu rí Ana̱ꞌlóꞌ ma̱ꞌne-numa̱a mbámbáa xa̱bo̱ xómá jaꞌyoo rí neꞌne. <verse eid="ROM 2:6" /><verse number="7" style="v" sid="ROM 2:7" />Tsí nune̱ máꞌ xúꞌkhue̱n rí máján, nduꞌyée̱ rí ma̱gi̱ꞌdoo numúu̱, rí mi̱tiamakúu̱n, jamí nduꞌyée̱ rí ma̱ju̱wée̱ꞌ jámuu, ikhiin tsúꞌkhue̱n ma̱ju̱wá jámuu gáꞌne Ana̱ꞌlóꞌ. <verse eid="ROM 2:7" /><verse number="8" style="v" sid="ROM 2:8" />Xómáꞌ tsí na̱ju̱mu̱ú rí i̱ndo̱ó máꞌ ikhiin gíꞌdoo numuu rí nuthan, jamí tsíñúú gánimbu̱únꞌ rí gakon, ga̱jma̱á numuu rí nune̱ rí xkawe̱ꞌ rá, Ana̱ꞌlóꞌ ma̱ꞌne rí mu̱míníi̱ ga̱jma̱á mbá xúgíí ski̱yu̱u̱ꞌ rí najiꞌnáa̱. <verse eid="ROM 2:8" /><verse number="9" style="v" sid="ROM 2:9" />Madaa jamínu̱ꞌ jamí mbayá xkuíya̱ jámba̱a̱ xa̱bo̱ tsí naꞌne rí ra̱máján, xa̱bo̱ judío̱ ginii jayu, xúꞌkhue̱n máꞌ xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajuun mangaa. <verse eid="ROM 2:9" /><verse number="10" style="v" sid="ROM 2:10" />Xómáꞌ xa̱bo̱ tsí naꞌne rí máján, ma̱gi̱ꞌdoo numuu̱, mi̱tiamakuíi̱ jamí ma̱xtáa̱ tsímáá, xa̱bo̱ judío̱ ginii jayu, xúꞌkhue̱n máꞌ xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajuun mangaa. <verse eid="ROM 2:10" /><verse number="11" style="v" sid="ROM 2:11" />Numuu rí Ana̱ꞌlóꞌ tsíraꞌwíi̱n xa̱bo̱ tsí ma̱ꞌne-nga̱júu̱n.<verse eid="ROM 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12" />Numuu rí mbá xúgíin xa̱bo̱ tsí nune̱ aꞌkhán, maske máꞌ tsíne̱-nuwiin xtángawoo Moisés, ma̱ja̱ñúu̱, ra̱ꞌkhá máꞌ ga̱jma̱á majñu̱u̱ xtángoo rúꞌkhue̱n. Xúꞌkhue̱n máꞌ, mbá xúgíin xa̱bo̱ tsí nune̱ aꞌkhán, maske máꞌ nune̱-nuwiin xtángawoo Moisés, ga̱jma̱á majñu̱u̱ máꞌ xtángoo rúꞌkhue̱n mi̱tra̱jwa̱ꞌ numúu̱. <verse eid="ROM 2:12" /><verse number="13" style="v" sid="ROM 2:13" />Numuu rí ra̱ꞌkháa xa̱bo̱ tsí i̱ndo̱ó máꞌ nu̱dxawíín xtángawoo Moisés ñajúún tsí nánda̱a̱ aꞌkhúún ná inuu Ana̱ꞌlóꞌ, rí xa̱bo̱ tsí nune̱-mbáníí xtángoo, ikhiin tsúꞌkhue̱n maꞌthán Ana̱ꞌlóꞌ rí nánda̱a̱ aꞌkhúún. <verse eid="ROM 2:13" /><verse number="14" style="v" sid="ROM 2:14" />Xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún ra̱guáꞌdáa̱ xtángawoo Moisés. Ído̱ rí xa̱bo̱ tsúꞌkhue̱n nune̱-mbáníí rí naꞌthán xtángoo, nune̱-mbáníi̱ ne̱ numuu rí nduyáa̱ máꞌ ná awúun a̱kuíi̱n náá rí máján jamí náá rí ra̱máján muni̱i̱, maske máꞌ ra̱guáꞌdáa̱ xtángawoo Moisés. <verse eid="ROM 2:14" /><verse number="15" style="v" sid="ROM 2:15" />Rí xkuaꞌnii ini̱i̱, nu̱snga̱jmee̱ rí waꞌtháán xtángoo ná awúun a̱kuíi̱n, numuu rí ju̱ma̱ rí guáꞌdáa̱ naꞌthán rí xkuaꞌnii jaꞌnii. Jamí a̱kuíi̱n maꞌthán rí gíꞌmii̱ aꞌkhán o maꞌthán-mbáá ne̱ numúu̱ mbo̱ꞌ, <verse eid="ROM 2:15" /><verse number="16" style="v" sid="ROM 2:16" />ído̱ gága̱nú mbiꞌi rí Ana̱ꞌlóꞌ maxúdaa awan numuu rí guáꞌdáá ngu̱ꞌwa̱ xa̱bo̱ ná awúun a̱kui̱ín. Ana̱ꞌlóꞌ maxúdaa awan ga̱jma̱á majñu̱u̱ Jesukrísto̱, xómá iꞌthán ajngáa máján rí na̱sngáálo̱ꞌ.<verse eid="ROM 2:16" /></para>
  <para style="s">Tsí maphú gakon rí xa̱bo̱ judío̱ ñajuun</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17" />Xómáꞌ ikháánꞌ tsáánꞌ narathán rí xa̱bo̱ judío̱ ñajwaanꞌ, na̱ju̱ma̱a̱ꞌ rí maphú mambáyáaꞌ xtángoo, jamí natakúxe̱-mina̱ꞌ numuu rí phú máján xtaa ná inuu Ana̱ꞌlóꞌ. <verse eid="ROM 2:17" /><verse number="18" style="v" sid="ROM 2:18" />Nathayáá máꞌ dí ñajuun rí nandoo Ana̱ꞌlóꞌ ma̱tha̱ne̱, jamí ga̱jma̱á majñu̱u̱ rí na̱ma̱ñaaꞌ xtángoo natraꞌwíí ma̱tha̱ne̱ rí i̱tha̱án máján. <verse eid="ROM 2:18" /><verse number="19" style="v" sid="ROM 2:19" />Na̱ju̱ma̱a̱ꞌ rí ikháánꞌ ꞌchá ikhúún tsí júgoo inúú, rí ikháánꞌ ñajwaanꞌ agu rí ma̱mbiꞌñúú tsí júwa̱ꞌ ná mijína, <verse eid="ROM 2:19" /><verse number="20" style="v" sid="ROM 2:20" />xúꞌkhue̱n máꞌ na̱ju̱ma̱a̱ꞌ rí na̱ma̱ñaaꞌ ma̱ra̱sngúún tsí tsíma̱ñúú jamí e̱je̱n. Numuu rí ga̱jma̱á majñu̱u̱ xtángoo na̱ju̱ma̱a̱ꞌ rí na̱ma̱ñaaꞌ mbá xúgíí rí phú gakon. <verse eid="ROM 2:20" /><verse number="21" style="v" sid="ROM 2:21" />Ikhaa jngó, ikháánꞌ tsáánꞌ narasngúún i̱ꞌwíin xa̱bo̱, náá numuu kajngó tsírasngá-mina̱ꞌ máꞌ ikháánꞌ róꞌ. Ikháánꞌ tsáánꞌ narathán rí ra̱gíꞌmaa mune̱ ku̱ꞌwá xa̱bo̱, náá numuu kajngó nathane̱ ku̱ꞌwá ikháánꞌ róꞌ. <verse eid="ROM 2:21" /><verse number="22" style="v" sid="ROM 2:22" />Ikháánꞌ tsáánꞌ narathán rí xa̱bo̱ ra̱gíꞌmaa mubúu̱n gajmíi̱ xa̱bo̱ tsí túya̱a̱, náá numuu kajngó ikháánꞌ nathabáaꞌ ga̱jma̱a̱ꞌ xa̱bo̱ tsí tíya̱a̱ róꞌ. Ikháánꞌ tsáánꞌ narathán rí tsíni̱gua̱a̱ꞌ ene̱ tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún, náá numuu kajngó nathane̱ ku̱ꞌwá ná guꞌwá dxákuíi̱n xúꞌkhue̱n róꞌ. <verse eid="ROM 2:22" /><verse number="23" style="v" sid="ROM 2:23" />Ikháánꞌ tsáánꞌ natakúxe̱-mina̱ꞌ ga̱jma̱á numuu rí na̱ma̱ñaaꞌ xtángoo, phú natríya̱ꞌ gamakuu Ana̱ꞌlóꞌ ído̱ rí tsíthane̱-mbáníí xtángoo. <verse eid="ROM 2:23" /><verse number="24" style="v" sid="ROM 2:24" />Numuu rí xkuaꞌnii ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ: «Ga̱jma̱á numalaꞌ ikháanꞌlaꞌ, xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún nuthan-xkawi̱i̱ꞌ ga̱jma̱á numuu Ana̱ꞌlóꞌ».<note caller="+" style="f"><char style="fr" closed="false">2.24 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 52.5.</char></note><verse eid="ROM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25" />Gakon máꞌ rí gíꞌdoo numuu rí ni̱tri̱gú tsina jndi, xí nathane̱-mbáníí rí naꞌthán xtángoo. I̱ndo̱ó máꞌ numuu rí, xí tsíthane̱-mbáníí xtángoo rá, asndo xómá rí na̱nguá máꞌ ꞌchá tsina jndi jaꞌnii rí xkuaꞌnii. <verse eid="ROM 2:25" /><verse number="26" style="v" sid="ROM 2:26" />Xí mbáa xa̱bo̱ tsí ra̱jáyá tsina jndi naꞌne-mbánuu rí naꞌthán xtángoo drígo̱o̱ Moisés, asndo xó rí jayée̱ máꞌ tsina jndi jaꞌnii rí xkuaꞌnii. <verse eid="ROM 2:26" /><verse number="27" style="v" sid="ROM 2:27" />Tsí ra̱jáyá tsina jndi ná xuyuu, jamí naꞌne-mbánuu mújúun rí naꞌthán xtángoo, ikhaa̱ maxná-máꞌáa̱n ikháánꞌ, numuu rí maske máꞌ ꞌchá tsina jndi, tsíthane̱-mbáníí rí naꞌthán xtángoo. <verse eid="ROM 2:27" /><verse number="28" style="v" sid="ROM 2:28" />Numuu ra̱ꞌkhá rí rígu inúú naꞌne rí mbáa phú gakon rí xa̱bo̱ judío̱ ñajuun, ni máꞌ ra̱ꞌkhá tsina jndi rí phú gakon ñajuun rí na̱gu̱ma ná xuyuu xa̱bo̱. <verse eid="ROM 2:28" /><verse number="29" style="v" sid="ROM 2:29" />Tsí phú gakon rí xa̱bo̱ judío̱ ñajuun, ikhaa̱ ñajuu̱n ne̱ ná awúún. Xúꞌkhue̱n máꞌ rí phú gakon tsina jndi ñajuun, na̱gu̱ma ne̱ ná awúun a̱kui̱in xa̱bo̱, rí naꞌne Xu̱u̱ꞌ Ana̱ꞌlóꞌ, ra̱ꞌkháa rí na̱gu̱ma ga̱jma̱á ajngóo xtángoo. Xa̱bo̱ tsí xkuaꞌnii jaꞌñúú, Ana̱ꞌlóꞌ naꞌthán rí máján ga̱jma̱á numúu̱, ra̱ꞌkhá xa̱bo̱ numbaa nuthan rí máján ga̱jma̱á numúu̱.<verse eid="ROM 2:29" /></para>
  <chapter eid="ROM 2" />
  <chapter number="3" style="c" sid="ROM 3" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1" />Á gíꞌdoo numuu rí mbá tikhuun ñajúún xa̱bo̱ judío̱ xúꞌkhue̱n rá. Á nambáyúu rí ndiye̱e̱ tsina jndi rá. <verse eid="ROM 3:1" /><verse number="2" style="v" sid="ROM 3:2" />Mi̱ndaꞌkho gíꞌdoo numuu ne̱. Rí phú ginii jayu, xa̱bo̱ judío̱ waꞌxná-ngáwúu̱n ajngáa rawuun Ana̱ꞌlóꞌ. <verse eid="ROM 3:2" /><verse number="3" style="v" sid="ROM 3:3" />Xí mbá tikhuun tsí ikhii̱n tánimbúu̱n juyáa̱ ne̱, á rúꞌkhue̱n iꞌthán rí náxáꞌne-mbánuu Ana̱ꞌlóꞌ rí nixuda-mina̱ꞌ ma̱ꞌne rá. <verse eid="ROM 3:3" /><verse number="4" style="v" sid="ROM 3:4" />¡Na̱nguá mbá jayu! Numuu rí Ana̱ꞌlóꞌ jámba̱ miꞌtsú naꞌthée̱n rí gakon, maske máꞌ mbá xúgíin xa̱bo̱ numbaa mixtutii̱n. Xómá ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="q" vid="ROM 3:4">«Kajngó ma̱kujma rí gakon ajngáaꞌ,</para>
  <para style="q" vid="ROM 3:4">jamí ma̱ꞌnga̱a̱ꞌ ído̱ rí ma̱mba̱núu numaaꞌ».<note caller="+" style="f"><char style="fr" closed="false">3.4 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 51.4.</char></note><verse eid="ROM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5" />Ído̱ rí nu̱ne̱xo̱ꞌ rí ra̱máján, tsáanꞌ xa̱bo̱ judío̱ ñajwanxo̱ꞌ, a̱ꞌkhue̱n phú i̱tha̱án nakujma rí máján naꞌne Ana̱ꞌlóꞌ. Dí gúꞌthánlóꞌ xúꞌkhue̱n rá. Á mu̱ꞌthánlóꞌ rí ra̱máján eꞌne Ana̱ꞌlóꞌ ído̱ naꞌnii̱ rí mu̱drígú jamínu̱ꞌ tsí nene̱ rí ra̱máján rá. (Gu̱ne̱ mba̱a̱ a̱kia̱nꞌlaꞌ, xómá ithan jayu xa̱bo̱ numbaa i̱tha̱nlo̱ꞌ.) <verse eid="ROM 3:5" /><verse number="6" style="v" sid="ROM 3:6" />¡Na̱nguá, tsíꞌnii̱ mbá jayu rí ra̱máján! Xí ra̱máján eꞌne Ana̱ꞌlóꞌ, xáne lá gáxudaa̱ awan ga̱jma̱á numúú mbá xúgíin xa̱bo̱ numbaa xúꞌkhue̱n rá.<verse eid="ROM 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 3:7" />Xí ído̱ rí ikhúúnꞌ na̱ne̱-ndúwalo̱ꞌ, i̱tha̱án máꞌ nakujma rí kuwiin Ana̱ꞌlóꞌ kajngó ma̱gu̱ma-mba̱a̱, náá numuu kajngó xóó nithán rí xa̱bo̱ aꞌkhán ñajunꞌ xúꞌkhue̱n rá. <verse eid="ROM 3:7" /><verse number="8" style="v" sid="ROM 3:8" />Náá numuu kajngó tsíꞌthánlóꞌ xómá nuthan mbá tikhuun tsí nu̱rígu ajngáa waꞌa tsu̱da̱xo̱ꞌ róꞌ: «Gu̱ꞌne̱lóꞌ rí xkawe̱ꞌ kajngó ma̱ꞌkha̱ rí máján». Xkuaꞌnii i̱sngáá ikháanꞌxo̱ꞌ méꞌ. Ana̱ꞌlóꞌ gáxná-máꞌíin rí mu̱míni̱í xa̱bo̱ tsí nuthan rúꞌkhue̱n.<verse eid="ROM 3:8" /></para>
  <para style="s">Ndawa̱a̱ asndo nimbáa xa̱bo̱ tsí májáan</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9" />Dí gúꞌthánlóꞌ xúꞌkhue̱n rá. Á i̱wa̱á máján kuajún ikháanꞌxo̱ꞌ ná inuu Ana̱ꞌlóꞌ, tsáanꞌ ñajwanxo̱ꞌ xa̱bo̱ judío̱ rá. ¡Na̱nguá mbá jayu! Numuu rí niꞌthánlóꞌ máꞌ rí mbá xúgíin xa̱bo̱ gíꞌmii aꞌkhán: xa̱bo̱ judío̱ jamí xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún. <verse eid="ROM 3:9" /><verse number="10" style="v" sid="ROM 3:10" />Xómá ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="q" vid="ROM 3:10">«Ndawa̱a̱ asndo nimbáa xa̱bo̱ tsí naꞌne rí máján.<verse eid="ROM 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ROM 3:11" />Ndawa̱a̱ xa̱bo̱ tsí nafroꞌo̱o̱,</para>
  <para style="q" vid="ROM 3:11">ndawa̱a̱ xa̱bo̱ tsí ndaꞌyáa Ana̱ꞌlóꞌ.<verse eid="ROM 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ROM 3:12" />Mbá xúgíin jayu xa̱bo̱ nene̱-tsíngua̱ꞌ-mijná,</para>
  <para style="q" vid="ROM 3:12">mbá xúgíi̱n jayu niꞌchíi̱n.</para>
  <para style="q" vid="ROM 3:12">Ndawa̱a̱ xa̱bo̱ tsí naꞌne rí máján,</para>
  <para style="q" vid="ROM 3:12">ndawa̱a̱ asndo nimbáa wáa».<note caller="+" style="f"><char style="fr" closed="false">3.10-12 </char><char style="ft" closed="false">Ju̱ma̱ ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 14.1-3 jamí ná 53.1-3.</char></note><verse eid="ROM 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ROM 3:13" />«Xómá iñúu-wa̱jen rí ja̱ma̱ꞌtha jaꞌnii aphúu̱n,</para>
  <para style="q" vid="ROM 3:13">jamí ga̱jma̱á ra̱júu̱n nune̱-nduwee̱».<note caller="+" style="f"><char style="fr" closed="false">3.13 </char><char style="ft" closed="false">Ju̱ma̱ ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 5.9.</char></note></para>
  <para style="q" vid="ROM 3:13">«Asndo xómá iyandawoo a̱bo̱ꞌ jaꞌnii ajngáa rí nagájnuu ná rawúu̱n».<note caller="+" style="f"><char style="fr" closed="false">3.13 </char><char style="ft" closed="false">Ju̱ma̱ ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 140.3.</char></note><verse eid="ROM 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ROM 3:14" />«Gatíí ajngáa xkawe̱ꞌ jamí rí tsíjmaa ná rawúu̱n».<note caller="+" style="f"><char style="fr" closed="false">3.14 </char><char style="ft" closed="false">Ju̱ma̱ ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 7.10.</char></note><verse eid="ROM 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ROM 3:15" />«Maphú nachúu̱n rí magóo̱ gúradíi̱n xa̱bo̱.<verse eid="ROM 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ROM 3:16" />Nune̱ gámbúu̱n mbá xúgíí rí ríga̱</para>
  <para style="q" vid="ROM 3:16">jamí i̱ndo̱ó máꞌ tsingíná ríga̱ asndo náá máꞌ nagóo̱.<verse eid="ROM 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ROM 3:17" />Tsíne̱-nuwii̱n jambo̱o̱ rí tsímáá».<note caller="+" style="f"><char style="fr" closed="false">3.17 </char><char style="ft" closed="false">Mbaꞌa ju̱ma̱ ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 59.7-8.</char></note><verse eid="ROM 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ROM 3:18" />«Jamí na̱nguá imíñúu̱ juyáa̱ Ana̱ꞌlóꞌ».<note caller="+" style="f"><char style="fr" closed="false">3.18 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 36.1.</char></note><verse eid="ROM 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19" />Nduꞌyáálóꞌ máꞌ rí mbá xúgíí rí naꞌthán xtángawoo Moisés, gíꞌdoo ski̱yu̱u̱ꞌ ne̱ ná inúú tsí gíꞌmii rí mune̱-mbáníí rí naꞌthán ne̱. Kajngó mbá xúgíin xa̱bo̱ gáꞌne-wíyuu rawúún jamí ma̱kujma aꞌkhúún ná inuu Ana̱ꞌlóꞌ. <verse eid="ROM 3:19" /><verse number="20" style="v" sid="ROM 3:20" />Numuu rí asndo nimbáa xa̱bo̱ ma̱xíꞌthán rí nánda̱a̱ aꞌkhúun ná inuu Ana̱ꞌlóꞌ ga̱jma̱á numuu rí naꞌne-mbánuu rí naꞌthán xtángoo. Rí xtángoo i̱ndo̱ó máꞌ najmaa ne̱ rí mbu̱ꞌyáálóꞌ rí xa̱bo̱ aꞌkhán ñajwanlóꞌ.<verse eid="ROM 3:20" /></para>
  <para style="s">Nánda̱a̱ aꞌkhúun xa̱bo̱ tsí wéje̱ a̱kui̱in ná inuu Jesús</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21" />Xómáꞌ xúge̱ꞌ rá, nisngájmalóꞌ rí waꞌtháán máꞌ ná xtángoo jamí rí nithan máꞌ tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ wajyúú. Nisngájmalóꞌ rí Ana̱ꞌlóꞌ naꞌthán rí nánda̱a̱ aꞌkhánlóꞌ, ra̱ꞌkhá ga̱jma̱á numuu rí nu̱ꞌne̱-mbáníílóꞌ rí naꞌthán xtángawoo Moisés. <verse eid="ROM 3:21" /><verse number="22" style="v" sid="ROM 3:22" />Ana̱ꞌlóꞌ naꞌthán rí nánda̱a̱ aꞌkhúún xa̱bo̱ tsí wéje̱ a̱kui̱ín ná inuu Jesukrísto̱, jámbi̱in tsí nanimbu̱únꞌ juyáa̱. Numuu rí mbá xúgíin xa̱bo̱ mbríguii̱n ná inuu Ana̱ꞌlóꞌ. <verse eid="ROM 3:22" /><verse number="23" style="v" sid="ROM 3:23" />Xúꞌkhue̱n máꞌ mbá xúgíi̱n nini̱i̱ aꞌkhán, jamí tsíngua̱ꞌ júwe̱e̱ꞌ inuu rí phú wáá ñajuun Ana̱ꞌlóꞌ. <verse eid="ROM 3:23" /><verse number="24" style="v" sid="ROM 3:24" />Xómáꞌ Ana̱ꞌlóꞌ, ga̱jma̱á numuu rí maphú májáan a̱kuii̱n jamí tsíru̱mee̱ máꞌ nitháan, naꞌthée̱n rí nánda̱a̱ aꞌkhúu̱n, ga̱jma̱á numuu rí Krísto̱ Jesús niꞌtse̱-ri̱ñii̱ꞌ ná awúun aꞌkhán.<verse eid="ROM 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 3:25" />Ana̱ꞌlóꞌ nixnáxi̱i̱ Jesukrísto̱ rí ma̱ja̱ñúu kajngó ma̱goo ma̱ꞌne mba̱a̱ a̱kuii̱n jaꞌyoo̱ aꞌkhánlóꞌ. Jamí naꞌne mba̱a̱ a̱kuii̱n jaꞌyalóꞌ ga̱jma̱á numuu nanimba̱ꞌlóꞌ rí Jesukrísto̱ nijáñuu ga̱jma̱á numalóꞌ. Xkuaꞌnii neꞌne Ana̱ꞌlóꞌ kajngó masngájmee̱ rí ikhaa̱ naꞌnii̱ rí máján, jamí phú mba̱a̱ a̱kuii̱n jaꞌñúu̱ xa̱bo̱ rí neꞌne mba̱a̱ a̱kuii̱n jaꞌyoo̱ aꞌkhán rí nini̱i̱ nákhí wajyúú. <verse eid="ROM 3:25" /><verse number="26" style="v" sid="ROM 3:26" />Numuu niꞌgí-mine̱e̱ꞌ rí xúge̱ꞌ masngájmee̱ rí máján naꞌnii̱, kajngó ma̱kujma rí ikhaa̱ ñajuu̱n tsí naꞌnii̱ rí máján, jamí tsí naꞌthán rí nánda̱a̱ aꞌkhúún tsí wéje̱ a̱kui̱ín ná inuu Jesús.<verse eid="ROM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27" />Á ma̱goo mu̱ꞌne̱-tsiꞌyálóꞌ ná inuu Ana̱ꞌlóꞌ rí xkuaꞌnii rá. ¡Na̱nguá mbá jayu! Náá numuu róꞌ. Numuu rí ra̱ꞌkhá ga̱jma̱á numuu rí nu̱ꞌne̱-mbáníílóꞌ rí naꞌthán xtángoo, naꞌthán Ana̱ꞌlóꞌ rí nánda̱a̱ aꞌkhánlóꞌ, rí ga̱jma̱á numuu rí wéje̱ a̱kia̱nꞌlóꞌ ná inuu Jesús. <verse eid="ROM 3:27" /><verse number="28" style="v" sid="ROM 3:28" />A̱ꞌkhue̱n nakujma rí Ana̱ꞌlóꞌ naꞌthán rí nánda̱a̱ aꞌkhúun xa̱bo̱ ga̱jma̱á numuu rí wéje̱ a̱kuii̱n ná inuu Jesús, jamí ra̱ꞌkhá ga̱jma̱á numuu rí naꞌne-mbánuu̱ rí naꞌthán xtángoo.<verse eid="ROM 3:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ROM 3:29" />Á i̱ndo̱ó máꞌ Anu̱ú xa̱bo̱ judío̱ ñajuun tsí Ana̱ꞌlóꞌ rá dxe̱ꞌ. Á ra̱ꞌkhá ikhaa̱ ñajuu̱n Anu̱ú xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún mangaa rá. Gakon máꞌ rí Ana̱ꞌlóꞌ ñajuun Anu̱ú xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún mangaa. <verse eid="ROM 3:29" /><verse number="30" style="v" sid="ROM 3:30" />Numuu rí mbáwíi máꞌ tsí ñajuun Ana̱ꞌlóꞌ mbá xúgiáanꞌlóꞌ. Jamí ikhaa̱ maꞌthée̱n rí nánda̱a̱ aꞌkhúún xa̱bo̱ tsí wéje̱ a̱kui̱ín ná inuu Jesús, ga̱nindxúu̱n xa̱bo̱ judío̱ o xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún mbo̱ꞌ. <verse eid="ROM 3:30" /><verse number="31" style="v" sid="ROM 3:31" />Á ga̱jma̱á numuu rí wéje̱ a̱kia̱nꞌlóꞌ ná inuu Jesús, nuꞌthánlóꞌ rí na̱nguá gíꞌdoo numuu xtángoo rá dxe̱ꞌ. ¡Na̱nguá mbá jayu! A̱ꞌkhue̱n gakon, nuꞌthánlóꞌ rí phú gíꞌdoo numuu ne̱.<verse eid="ROM 3:31" /></para>
  <chapter eid="ROM 3" />
  <chapter number="4" style="c" sid="ROM 4" />
  <para style="s">Xkri̱da xó rí Ana̱ꞌlóꞌ niꞌthán rí nánda̱a̱ aꞌkhúun Abraám</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1" />Gu̱ꞌthán-mijnálóꞌ ga̱jma̱á numuu rí nijanáá Abraám, táta̱-xi̱ꞌñáxo̱ꞌ wajyúú tsí ju̱ya̱xo̱ꞌ iꞌdiuu. <verse eid="ROM 4:1" /><verse number="2" style="v" sid="ROM 4:2" />Xí numuu rí Ana̱ꞌlóꞌ niꞌthán rí nánda̱a̱ aꞌkhúun Abraám ga̱jma̱á numuu rí máján niꞌnii̱, ma̱goo máꞌ makúxe̱-mine̱e̱ꞌ xúꞌkhue̱n rá, i̱ndo̱ó máꞌ numuu rí ra̱ꞌkhá ná inuu Ana̱ꞌlóꞌ. <verse eid="ROM 4:2" /><verse number="3" style="v" sid="ROM 4:3" />Numuu rí xáꞌnii ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ: «Ninimbo̱o̱ꞌ Abraám jaꞌyoo Ana̱ꞌlóꞌ, rúꞌkhue̱n jngó ndiꞌyoo Ana̱ꞌlóꞌ rí májáan a̱kuii̱n».<note caller="+" style="f"><char style="fr" closed="false">4.3 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ xó ni̱gi̱ꞌdu̱u̱n-muu 15.6.</char></note><verse eid="ROM 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 4:4" />Ído̱ rí mbáa xa̱bo̱ nañajun, nadaa̱ numuu̱. Ra̱ꞌkhá mbá rí najanáa̱ ñajuun rúꞌkhue̱n, rí mbá rí jaꞌyoo mbayée̱. <verse eid="ROM 4:4" /><verse number="5" style="v" sid="ROM 4:5" />Xómáꞌ xa̱bo̱ tsí nda̱a̱ rí eꞌne rá, rí i̱ndo̱ó máꞌ nanimbo̱o̱ꞌ rí Ana̱ꞌlóꞌ naꞌne májáan a̱kui̱in xa̱bo̱ aꞌkhán, tsúꞌkhue̱n tsí nánda̱a̱ aꞌkhúun numuu rí wéje̱ a̱kuii̱n ná inuu Ana̱ꞌlóꞌ. <verse eid="ROM 4:5" /><verse number="6" style="v" sid="ROM 4:6" />Xkuaꞌnii máꞌ niꞌthán Dabíd mangaa, rí phú gagi xtáa xa̱bo̱ tsí naꞌthán Ana̱ꞌlóꞌ rí nánda̱a̱ aꞌkhúun, jamí ra̱ꞌkhá máꞌ ga̱jma̱á majñu̱u̱ rí máján naꞌnii̱. <verse eid="ROM 4:6" /><verse number="7" style="v" sid="ROM 4:7" />Xáꞌnii niꞌthán Dabíd:</para>
  <para style="q" vid="ROM 4:7">«Phú gagi júwa̱ꞌ xa̱bo̱ tsí naꞌne mba̱a̱ a̱kui̱in Ana̱ꞌlóꞌ jaꞌyoo aꞌkhúún,</para>
  <para style="q" vid="ROM 4:7">jamí narngudi̱i rí xkawe̱ꞌ nuni̱i̱.<verse eid="ROM 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ROM 4:8" />Phú gagi xtáa xa̱bo̱ tsí naꞌthán Táta̱ rí nánda̱a̱ aꞌkhúun».<note caller="+" style="f"><char style="fr" closed="false">4.8 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 32.1-2.</char></note><verse eid="ROM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9" />Á i̱ndo̱ó máꞌ xa̱bo̱ tsí juya̱ tsina jndi jaꞌñúú mu̱guaꞌdáá gagi ríge̱ꞌ rá, o jaꞌñúú máꞌ xa̱bo̱ tsí ra̱júya̱ tsina jndi mangiin dxe̱ꞌ. Numuu nuꞌthánlóꞌ rí Abraám ni̱we̱je̱ a̱kui̱in ná inuu Ana̱ꞌlóꞌ, kajngó niꞌthán Ana̱ꞌlóꞌ rí xa̱bo̱ tsí májáan a̱kui̱in ñajuu̱n. <verse eid="ROM 4:9" /><verse number="10" style="v" sid="ROM 4:10" />Nguáná niꞌthán Ana̱ꞌlóꞌ rí xa̱bo̱ tsí májáan a̱kui̱in ñajuun Abraám róꞌ. Ído̱ wámba̱ ndiyée̱ tsina jndi ráanꞌ, o nákhí xóó táyée̱ tsina jndi dxe̱ꞌ. Ra̱ꞌkhá ído̱ wámba̱ máꞌ ndiyée̱ tsina jndi, rí asndo nákhí máꞌ xóó táyée̱ tsina jndi ndiꞌyoo Ana̱ꞌlóꞌ rí xa̱bo̱ tsí májáan a̱kui̱in ñajuu̱n. <verse eid="ROM 4:10" /><verse number="11" style="v" sid="ROM 4:11" />Abraám ni̱grui̱gú tsina jndi, numuu rí rúꞌkhue̱n nasngájma rí xa̱bo̱ tsí májáan a̱kui̱in ñajuu̱n, ga̱jma̱á numuu rí ni̱we̱je̱ a̱kuii̱n ná inuu Ana̱ꞌlóꞌ nákhí rí xóó ra̱jáyée̱ tsina jndi. Xkuaꞌnii kajngó, Abraám ninindxu̱u̱ anu̱ú mbá xúgíin xa̱bo̱ tsí wéje̱ a̱kui̱ín ná inuu Ana̱ꞌlóꞌ, maske máꞌ ra̱júye̱e̱ tsina jndi. Ikhaa jngó, tsíge̱ꞌ mangiin nandoo nithán rí xa̱bo̱ tsí májáan a̱kui̱ín ñajúu̱n ga̱jma̱á numuu rí wéje̱ a̱kuíi̱n ná inuu Ana̱ꞌlóꞌ. <verse eid="ROM 4:11" /><verse number="12" style="v" sid="ROM 4:12" />Jamí xúꞌkhue̱n máꞌ mangaa, Abraám ñajuun anu̱ú tsí juda tsina jndi, jamí wéje̱ a̱kui̱ín ná inuu Ana̱ꞌlóꞌ xómá ni̱we̱je̱ a̱kui̱in tátiáxo̱ꞌ Abraám nákhí rí xóó ra̱jáyée̱ tsina jndi.<verse eid="ROM 4:12" /></para>
  <para style="s">Rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ na̱gu̱ma-mbáníí ne̱ ga̱jma̱á majñu̱u̱ rí wéje̱ a̱kia̱nꞌlóꞌ ná inuu̱</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13" />Numuu rí Ana̱ꞌlóꞌ nixuda-mina̱ꞌ ga̱jma̱á nindxu̱u̱ Abraám, rí ikhaa̱ gajmíi̱ xa̱bii̱ ma̱ꞌne drígúu̱n ñajuun mbá xúgíí numbaa. Ra̱ꞌkhá ga̱jma̱á numuu rí neꞌne-mbánuu̱ xtángoo rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ ríge̱ꞌ, rí ga̱jma̱á numuu rí xa̱bo̱ tsí májáan a̱kui̱in ñajuu̱n ndiꞌyoo Ana̱ꞌlóꞌ, numuu rí wéje̱ a̱kuii̱n ná inuu Ana̱ꞌlóꞌ. <verse eid="ROM 4:13" /><verse number="14" style="v" sid="ROM 4:14" />Xí tsí nune̱-mbáníí xtángoo ñajúún tsí ma̱ꞌne drígu̱ún rí niꞌthán Ana̱ꞌlóꞌ, nda̱a̱ máꞌ numuu rí ma̱we̱je̱ a̱kia̱nꞌlóꞌ ná inuu Ana̱ꞌlóꞌ xúꞌkhue̱n rá, ni máꞌ nda̱a̱ numuu rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ mangaa. <verse eid="ROM 4:14" /><verse number="15" style="v" sid="ROM 4:15" />Numuu rí ná ríga̱ xtángoo, mudaa jamínu̱ꞌ xa̱bo̱ tsí na̱nguá ene̱-mbáníí ne̱. Xómáꞌ ná nda̱a̱ xtángoo rá, ndawa̱a̱ máꞌ tsí ma̱rigu tsu̱du̱u̱ rí tsíꞌne-mbánuu ne̱ mangaa.<verse eid="ROM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16" />Ikhaa jngó, Ana̱ꞌlóꞌ nixuda-mina̱ꞌ ga̱jma̱á majñu̱u̱ rí ni̱we̱je̱ a̱kui̱in Abraám ná inuu̱, numuu ndiyoo Ana̱ꞌlóꞌ rí mbá xúgíin xa̱bi̱i Abraám ma̱janúú rí naxuda-mine̱e̱ꞌ. Ra̱ꞌkhá i̱ndo̱ó tsí nune̱-mbáníí xtángoo ma̱janúú rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ, rí asndo tsí wéje̱ a̱kui̱ín ná inuu Ana̱ꞌlóꞌ mangiin xómá ni̱we̱je̱ a̱kui̱in Abraám. Ikhaa̱ ñajuu̱n tátiálóꞌ mbá xúgiáanꞌ ikháánꞌlóꞌ. <verse eid="ROM 4:16" /><verse number="17" style="v" sid="ROM 4:17" />Xómá ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ: «Ni̱ꞌgíínlo̱ꞌ rí ma̱nindxa̱a̱ꞌ anu̱ú mbaꞌa inii xa̱bo̱».<note caller="+" style="f"><char style="fr" closed="false">4.17 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ xó ni̱gi̱ꞌdu̱u̱n-muu 17.5».</char></note> Xkuaꞌnii ninimbo̱o̱ꞌ Abraám jaꞌyoo Ana̱ꞌlóꞌ, tsí naꞌne rí mbuya̱a mbiꞌñúú wa̱jen, jamí naꞌthán numuu rí xóó nda̱a̱, asndo xó rí ríga̱ máꞌ ne̱ jaꞌnii.<verse eid="ROM 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 4:18" />Abraám ninimbo̱o̱ꞌ jaꞌyoo Ana̱ꞌlóꞌ jamí ga̱jma̱á mbá jañii a̱kuii̱n ni̱gi̱ꞌthu̱u̱n, maske máꞌ nánguá jaꞌnii rí ma̱gi̱ꞌthu̱u̱n, rí ikhaa̱ ma̱nindxu̱u̱ anu̱ú mbaꞌa inii xa̱bo̱, xómá waꞌtháa̱n neꞌne Ana̱ꞌlóꞌ: «Xkuaꞌnii mbaꞌiin xa̱bia̱aꞌ gáꞌne».<note caller="+" style="f"><char style="fr" closed="false">4.18 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ xó ni̱gi̱ꞌdu̱u̱n-muu 15.5.</char></note> <verse eid="ROM 4:18" /><verse number="19" style="v" sid="ROM 4:19" />Jamí táꞌne wabaa a̱kuii̱n rí ma̱gi̱ꞌthu̱u̱n, maske máꞌ ndiꞌyoo̱ rí maphú nikhi̱i̱ jamí asndo xó rí nijáñúu̱ máꞌ jaꞌnii, numuu rí naꞌne máꞌ xí mbá witsu skíñú (100) wáa tsiguu̱, jamí ndiꞌyoo̱ máꞌ rí náxáꞌngo̱o̱ gáꞌne xuajen Sára̱ mangaa. <verse eid="ROM 4:19" /><verse number="20" style="v" sid="ROM 4:20" />Xúꞌkhue̱n máꞌ táꞌne a̱jma̱ a̱kuii̱n, ni máꞌ táꞌnii̱ rí ma̱xánimbo̱o̱ꞌ rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ ma̱ꞌne, a̱ꞌkhue̱n gakon i̱wa̱á ni̱we̱je̱-gúkúu a̱kuii̱n ná inuu Ana̱ꞌlóꞌ. Xkuaꞌnii neꞌne-mba̱a̱ Ana̱ꞌlóꞌ. <verse eid="ROM 4:20" /><verse number="21" style="v" sid="ROM 4:21" />Mbá jañii a̱kui̱in Abraám ninimbo̱o̱ꞌ rí Ana̱ꞌlóꞌ gíꞌdoo tsiakhe̱ rí ma̱ꞌne-mbánuu mbá xúgíí rí nixuda-mina̱ꞌ ma̱ꞌne. <verse eid="ROM 4:21" /><verse number="22" style="v" sid="ROM 4:22" />Ikhaa numuu rúꞌkhue̱n, niꞌthán Ana̱ꞌlóꞌ rí xa̱bo̱ tsí májáan a̱kui̱in ñajuun Abraám ga̱jma̱á numuu rí ni̱we̱je̱ a̱kuii̱n ná inuu Ana̱ꞌlóꞌ.<verse eid="ROM 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 4:23" />Ra̱ꞌkhá máꞌ i̱ndo̱ó ga̱jma̱á numuu Abraám waꞌtháán rí ndiꞌyoo Ana̱ꞌlóꞌ rí májáan a̱kuii̱n, <verse eid="ROM 4:23" /><verse number="24" style="v" sid="ROM 4:24" />rí ga̱jma̱á máꞌ numalóꞌ ikháánꞌlóꞌ mangaa, tsáanꞌ nanimba̱ꞌlóꞌ juꞌyáá Ana̱ꞌlóꞌ, tsí neꞌne rí mbayáa mbiꞌyuu Tátiálóꞌ Jesús, mi̱ꞌthán rí xa̱bo̱ tsí májáan a̱kui̱ín ñajwanlóꞌ. <verse eid="ROM 4:24" /><verse number="25" style="v" sid="ROM 4:25" />Ana̱ꞌlóꞌ nixnáxi̱i̱ Jesús kajngó ma̱ja̱ñúu̱ ga̱jma̱á numuu aꞌkhánlóꞌ, jamí Ana̱ꞌlóꞌ máꞌ neꞌne rí mbayáa̱ mbiꞌyuu̱ kajngó maꞌthée̱n rí nánda̱a̱ aꞌkhánlóꞌ.<verse eid="ROM 4:25" /></para>
  <chapter eid="ROM 4" />
  <chapter number="5" style="c" sid="ROM 5" />
  <para style="s">Nimbáxi̱iꞌlóꞌ ga̱jma̱á nindxu̱u̱ Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1" />Numuu rí Ana̱ꞌlóꞌ naꞌthán rí nánda̱a̱ aꞌkhánlóꞌ ga̱jma̱á numuu rí wéje̱ a̱kia̱nꞌlóꞌ ná inuu̱, ikhaa jngó juwalóꞌ tsímáá ga̱jma̱á nindxu̱u̱ Ana̱ꞌlóꞌ, ga̱jma̱á numuu rí neꞌne Tátiálóꞌ Jesukrísto̱ ga̱jma̱á numalóꞌ. <verse eid="ROM 5:1" /><verse number="2" style="v" sid="ROM 5:2" />Xúꞌkhue̱n máꞌ mangaa, ga̱jma̱á majñu̱u̱ Jesús jamí ga̱jma̱á majñu̱u̱ rí wéje̱ a̱kia̱nꞌlóꞌ ná inuu Ana̱ꞌlóꞌ, nandoo najanálóꞌ rí máján ríge̱ꞌ, ná kuajún-gúkuálóꞌ jamí nadxalóꞌ, numuu rí ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ guáꞌthi̱ínlóꞌ rí ma̱juwalóꞌ ná phú tsímáá xtáa Ana̱ꞌlóꞌ. <verse eid="ROM 5:2" /><verse number="3" style="v" sid="ROM 5:3" />Jamí ra̱ꞌkhá i̱ndo̱ó rúꞌkhue̱n, rí mangaa máꞌ nadxu a̱kia̱nꞌlóꞌ ná awúun jamínu̱ꞌ, numuu nduꞌyáálóꞌ rí jamínu̱ꞌ naꞌne rí ma̱ꞌngo̱o̱ a̱kia̱nꞌlóꞌ inuu mbá xúgíí. <verse eid="ROM 5:3" /><verse number="4" style="v" sid="ROM 5:4" />Jamí xí na̱ꞌngo̱o̱ a̱kia̱nꞌlóꞌ inuu mbá xúgíí rá, nadxu a̱kui̱in Ana̱ꞌlóꞌ e̱ꞌne̱lóꞌ. Jamí xí nadxu a̱kui̱in Ana̱ꞌlóꞌ e̱ꞌne̱lóꞌ, rúꞌkhue̱n naꞌne rí ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ mu̱waꞌthi̱ínlóꞌ rí wéje̱ ma̱ri̱gá. <verse eid="ROM 5:4" /><verse number="5" style="v" sid="ROM 5:5" />Jamí rí ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ guáꞌthi̱ínlóꞌ tsíꞌne-matiáanꞌlóꞌ, numuu rí Ana̱ꞌlóꞌ nisngájmee̱ rí phú nandoo̱ jaꞌyalóꞌ ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ tsí nixniálóꞌ.<verse eid="ROM 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6" />Numuu nákhí rí ikháánꞌlóꞌ tsíꞌnga̱ꞌlóꞌ gúꞌne̱-jríya̱ꞌ-mijnálóꞌ, jamí ído̱ ni̱ga̱nú mbiꞌi rí niraꞌwíí Ana̱ꞌlóꞌ, Krísto̱ nijáñuu ga̱jma̱á numalóꞌ, tsáanꞌ xa̱bo̱ aꞌkhán ñajwanlóꞌ. <verse eid="ROM 5:6" /><verse number="7" style="v" sid="ROM 5:7" />Phú mingíjyúu rí mbáa xa̱bo̱ maniña-mina̱ꞌ rí ma̱ja̱ñúu ga̱jma̱á numuu mbáa xa̱bo̱ tsí naꞌne rí máján. O á gáꞌne xí xtáa mbáa tsí maniña-mina̱ꞌ ma̱ja̱ñúu ga̱jma̱á numuu mbáa tsí naꞌne mi̱ndaꞌkho rí máján mbo̱ꞌ. <verse eid="ROM 5:7" /><verse number="8" style="v" sid="ROM 5:8" />Xómáꞌ Ana̱ꞌlóꞌ, nasngájmee̱ rí phú nandoo̱ jaꞌyalóꞌ, rí nákhí xóó xa̱bo̱ tsí nune̱ aꞌkhán ñajwanlóꞌ, Krísto̱ nijáñuu ga̱jma̱á numalóꞌ.<verse eid="ROM 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 5:9" />I̱wa̱á lá xúge̱ꞌ rí naꞌthán máꞌ Ana̱ꞌlóꞌ rí nánda̱a̱ aꞌkhánlóꞌ ga̱jma̱á numuu rí nijáñuu Krísto̱ rá, ikhaa̱ naꞌne-jríñáa̱ꞌlóꞌ kajngó mu̱xúdrígúlóꞌ jamínu̱ꞌ ga̱jma̱á numuu rí najiꞌnáa Ana̱ꞌlóꞌ jaꞌyoo aꞌkhán. <verse eid="ROM 5:9" /><verse number="10" style="v" sid="ROM 5:10" />Xí nákhí xa̱bo̱ sia̱nꞌ ñajwanlóꞌ, nimbáxi̱iꞌlóꞌ ga̱jma̱á nindxu̱u̱ Ana̱ꞌlóꞌ ga̱jma̱á numuu rí nijáñuu A̱dée̱, i̱wa̱á lá xúge̱ꞌ rí nimbáxi̱iꞌlóꞌ ga̱jma̱á nindxu̱u̱, ma̱jáwiáanꞌlóꞌ ga̱jma̱á numuu rí ndiyáa mbiꞌyuu̱. <verse eid="ROM 5:10" /><verse number="11" style="v" sid="ROM 5:11" />Jamí ra̱ꞌkhá máꞌ i̱ndo̱ó rúꞌkhue̱n, rí asndo phú nadxu a̱kia̱nꞌlóꞌ eꞌne Ana̱ꞌlóꞌ mangaa ga̱jma̱á numuu Tátiálóꞌ Jesukrísto̱, numuu rí ikhaa̱ niꞌnii̱ rí ma̱goo ma̱mba̱xíiꞌlóꞌ ga̱jma̱á nindxu̱u̱ Ana̱ꞌlóꞌ.<verse eid="ROM 5:11" /></para>
  <para style="s">Xkri̱da ga̱jma̱á numuu Adán jamí Krísto̱</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12" />Ga̱jma̱á numuu mbáwíi xa̱bo̱ ni̱to̱ꞌo̱o̱ aꞌkhán ná numbaa, jamí ga̱jma̱á numuu aꞌkhán ni̱gi̱ꞌdu̱u̱n nijáñúú xa̱bo̱. Xkuaꞌnii máꞌ na̱ka̱-rajáñúú mbá xúgíin xa̱bo̱ asndo xúge̱ꞌ, numuu rí mbá xúgíi̱n nini̱i̱ aꞌkhán. <verse eid="ROM 5:12" /><verse number="13" style="v" sid="ROM 5:13" />Nákhí rí xóó nda̱a̱ xtángawoo Moisés, ríga̱ máꞌ aꞌkhán ná numbaa. Xómáꞌ ná nda̱a̱ xtángoo rá, na̱nguá máꞌ gíꞌmii aꞌkhán xa̱bo̱. <verse eid="ROM 5:13" /><verse number="14" style="v" sid="ROM 5:14" />Maske máꞌ xkuaꞌnii, ni̱ka̱-rajáñúú máꞌ xúꞌkhue̱n xa̱bo̱ eꞌne tsiakhe̱ rí na̱gu̱díin xa̱bo̱, asndo nákhí nixtáa Adán asndo mbiꞌi rí nixtáa Moisés. Tsíꞌñuu máꞌ xí túni̱i̱ aꞌkhán xómá neꞌne Adán rí táꞌne-mbánuu mbóó xtángoo. Adán ninindxu̱u̱ xkri̱doo mbáa tsí wéje̱ ma̱ꞌkha̱ nda̱wa̱á.<verse eid="ROM 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 5:15" />Xómáꞌ aꞌkhán rí neꞌne Adán, na̱nguá mbrígu ne̱ ga̱jma̱á rí máján naxná Ana̱ꞌlóꞌ. Ga̱jma̱á numuu aꞌkhán rí neꞌne mbáwíi xa̱bo̱, mbá xúgíin xa̱bo̱ nijáñúú. Xómáꞌ rí máján naxná Ana̱ꞌlóꞌ rá, rí najanálóꞌ ga̱jma̱á majñu̱u̱ mbáwíi xa̱bo̱, Jesukrísto̱, phú i̱tha̱án mba̱a̱ ne̱ jamí phú mbaꞌiin xa̱bo̱ mambáñúú ne̱. <verse eid="ROM 5:15" /><verse number="16" style="v" sid="ROM 5:16" />Xúꞌkhue̱n máꞌ, na̱nguá mbrígu rí naxná Ana̱ꞌlóꞌ ga̱jma̱á aꞌkhán rí neꞌne mbáwíi xa̱bo̱. Numuu rí ga̱jma̱á numuu mbóó aꞌkhán, waꞌxná-máꞌíin xa̱bo̱ rí mu̱míni̱í jámuu. Xómá rí naxná Ana̱ꞌlóꞌ rá, ni̱ꞌkha̱ ne̱ ga̱jma̱á numuu mbaꞌa aꞌkhán, kajngó maꞌthán Ana̱ꞌlóꞌ rí nánda̱a̱ aꞌkhúún xa̱bo̱. <verse eid="ROM 5:16" /><verse number="17" style="v" sid="ROM 5:17" />Gakon máꞌ rí ga̱jma̱á numuu aꞌkhúun mbáwíi xa̱bo̱, Adán, wéje̱ rí ma̱ja̱ñúú mbá xúgíin xa̱bo̱. Xómáꞌ tsí nanújngo-rámuu nu̱drígú rí máján naxná Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ mbáwíi xa̱bo̱ rá, Jesukrísto̱, i̱tha̱án máꞌ ma̱ju̱wée̱ꞌ jámuu, numuu rí naꞌthán Ana̱ꞌlóꞌ rí nánda̱a̱ máꞌ aꞌkhúu̱n.<verse eid="ROM 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18" />Ikhaa jngó, xómá rí ga̱jma̱á numuu aꞌkhúun mbáwíi xa̱bo̱ waꞌxná-máꞌíin mbá xúgíin xa̱bo̱ rí ma̱ja̱ñúú, xkuaꞌnii máꞌ mangaa, ga̱jma̱á numuu rí máján neꞌne mbáwíi xa̱bo̱, nandoo naꞌthán Ana̱ꞌlóꞌ rí nánda̱a̱ aꞌkhúún mbá xúgíin xa̱bo̱, kajngó ma̱ju̱wée̱ꞌ jámuu. <verse eid="ROM 5:18" /><verse number="19" style="v" sid="ROM 5:19" />Ga̱jma̱á numuu rí mbáwíi tsí táꞌne-mbánuu, phú mbaꞌiin ninindxu̱ún xa̱bo̱ tsí nune̱ aꞌkhán. Xkuaꞌnii máꞌ mangaa, ga̱jma̱á numuu mbáwíi tsí neꞌne-mbánuu, phú mbaꞌiin ma̱nindxu̱ún xa̱bo̱ tsí nánda̱a̱ aꞌkhúún.<verse eid="ROM 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20" />Xómáꞌ rí xtángoo rá, ni̱ꞌkha̱ ne̱ kajngó mbuyáá xa̱bo̱ rí phú mba̱a̱ aꞌkhúu̱n. Jamí ído̱ neꞌne mba̱a̱ guéño máꞌ aꞌkhán rá, a̱ꞌkhue̱n phú i̱tha̱án mba̱a̱ rí máján nixná Ana̱ꞌlóꞌ. <verse eid="ROM 5:20" /><verse number="21" style="v" sid="ROM 5:21" />Xómá rí ni̱gi̱ꞌdoo tsiakhe̱ aꞌkhán rí ma̱ꞌne rí ma̱ja̱ñálóꞌ, xkuaꞌnii máꞌ rí máján naxná Ana̱ꞌlóꞌ mangaa, gíꞌdoo ne̱ tsiakhe̱ rí ma̱ꞌne ne̱ rí ma̱juwalóꞌ jámuu ga̱jma̱á numuu rí naꞌthán Ana̱ꞌlóꞌ rí nánda̱a̱ máꞌ aꞌkhánlóꞌ ga̱jma̱á majñu̱u̱ Tátiálóꞌ Jesukrísto̱.<verse eid="ROM 5:21" /></para>
  <chapter eid="ROM 5" />
  <chapter number="6" style="c" sid="ROM 6" />
  <para style="s">Nánguá juwalóꞌ rí mu̱ꞌne̱lóꞌ aꞌkhán</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1" />Dí gúꞌne̱lóꞌ xúꞌkhue̱n rá. Mu̱ꞌne̱lóꞌ máꞌ xúꞌkhue̱n aꞌkhán kajngó ma̱ꞌne i̱tha̱án mba̱a̱ rí máján naxná Ana̱ꞌlóꞌ ráanꞌ. <verse eid="ROM 6:1" /><verse number="2" style="v" sid="ROM 6:2" />¡Na̱nguá mbá jayu! Numuu rí ikháánꞌlóꞌ tsáanꞌ nijáñalóꞌ máꞌ ná inuu aꞌkhán, ma̱xáxóo ma̱juwalóꞌ rí mu̱ꞌne̱lóꞌ xóó aꞌkhán. <verse eid="ROM 6:2" /><verse number="3" style="v" sid="ROM 6:3" />Á tsíya̱álaꞌ rí mbá xúgiáanꞌlóꞌ tsáanꞌ waxúꞌdu-maꞌáanꞌlóꞌ ná awúun iya numuu rí nanimba̱ꞌlóꞌ juꞌyáá Krísto̱ Jesús, asndo xó rí nijáñalóꞌ ga̱jma̱á nindxu̱u̱ rá dxe̱ꞌ. <verse eid="ROM 6:3" /><verse number="4" style="v" sid="ROM 6:4" />Numuu rí ga̱jma̱á majñu̱u̱ rí waxúꞌdu-maꞌáanꞌlóꞌ ná awúun iya, nijáñalóꞌ jamí waꞌdiáanꞌlóꞌ ga̱jma̱á nindxu̱u̱. Ikhaa jngó, xómá rí Krísto̱ ndiyáa mbiꞌyuu ga̱jma̱á ski̱yu̱u̱ꞌ Ana̱ꞌlóꞌ, xkuaꞌnii máꞌ mbu̱ꞌyáa mbiꞌyalóꞌ rí nuxe̱ꞌ mangáanꞌlóꞌ, kajngó ma̱nindxa̱ꞌlóꞌ xa̱bo̱ nuxi̱inꞌ.<verse eid="ROM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5" />Xí mbáwíi xa̱bo̱ ninindxa̱ꞌlóꞌ gajmiálóꞌ Krísto̱ ga̱jma̱á numuu xó rí nijáñuu̱, xkuaꞌnii máꞌ mangaa, mbáwíi xa̱bo̱ gánindxa̱ꞌlóꞌ gajmiálóꞌ ga̱jma̱á numuu xó rí ndiyáa̱ mbiꞌyuu̱. <verse eid="ROM 6:5" /><verse number="6" style="v" sid="ROM 6:6" />Nduꞌyáálóꞌ máꞌ rí xa̱bo̱ wayii tsí ninindxa̱ꞌlóꞌ wajyúú, waꞌdujmaa̱ ná ixe̱ krúsi̱ ga̱jma̱á nindxu̱u̱ Krísto̱, kajngó ma̱mbáa ski̱yu̱u̱ꞌ aꞌkhán rí ríga̱ ná xuyalóꞌ, xkuaꞌnii rí náxáꞌthán-ñájwanlóꞌ aꞌkhán. <verse eid="ROM 6:6" /><verse number="7" style="v" sid="ROM 6:7" />Numuu rí xa̱bo̱ tsí nijáñuu máꞌ, nijríya̱a̱ꞌ máꞌ ná inuu aꞌkhán.<verse eid="ROM 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 6:8" />Numuu rí nijáñalóꞌ máꞌ ga̱jma̱á nindxu̱u̱ Krísto̱, ikhaa jngó naꞌne jañii a̱kia̱nꞌlóꞌ rí mbu̱ꞌyalóꞌ ga̱jma̱á nindxu̱u̱ mangaa. <verse eid="ROM 6:8" /><verse number="9" style="v" sid="ROM 6:9" />Jamí nduꞌyáálóꞌ máꞌ ríge̱ꞌ, ído̱ rí Krísto̱ ndiyáa mbiꞌyuu, jámuu xtáa̱. Ikhaa jngó, nánguá máꞌ wéje̱ rí ma̱ja̱ñúu̱. <verse eid="ROM 6:9" /><verse number="10" style="v" sid="ROM 6:10" />Numuu rí nákhí nijáñúu̱ mbóó miꞌtsú, jámuu neꞌne-gámbo̱o̱ ski̱yu̱u̱ꞌ aꞌkhán. Ikhaa jngó rí xúge̱ꞌ rá, xtáa̱ ndaꞌyee̱ ma̱ꞌnii̱ rí nandoo Ana̱ꞌlóꞌ. <verse eid="ROM 6:10" /><verse number="11" style="v" sid="ROM 6:11" />Xkuaꞌnii máꞌ mangáanꞌlaꞌ, a̱gu̱ya̱álaꞌ rí nánguá máꞌ juwalaꞌ rí mu̱ne̱laꞌ aꞌkhán, numuu rí nijáñalaꞌ inuu ne̱. Xómáꞌ xúge̱ꞌ rá, juwa ndu̱ya̱laꞌ kajngó mu̱ne̱laꞌ rí nandoo Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ Krísto̱ Jesús.<verse eid="ROM 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12" />Ikhaa numuu rúꞌkhue̱n, náxáꞌthán-ñájuun aꞌkhán xuyalaꞌ rí wéje̱ ma̱mbáa, ni máꞌ náxúne̱laꞌ rí xkawe̱ꞌ nandoo xuyalaꞌ. <verse eid="ROM 6:12" /><verse number="13" style="v" sid="ROM 6:13" />Mu̱xúxna̱xílaꞌ xuyalaꞌ ná inuu aꞌkhán kajngó ma̱jmuu ne̱ rí ma̱ꞌne rí xkawe̱ꞌ. A̱ꞌkhue̱n gakon, gu̱xna̱xí-mijnálaꞌ mbá jayu ná inuu Ana̱ꞌlóꞌ xómá tsí ndiya̱a mbiꞌñúú, kajngó ma̱jmuu Ana̱ꞌlóꞌ xuyalaꞌ rí ma̱ꞌne rí máján. <verse eid="ROM 6:13" /><verse number="14" style="v" sid="ROM 6:14" />Xkuaꞌnii kajngó, náxági̱ꞌdoo tsiakhe̱ aꞌkhán rí maꞌthán-ñájwanlaꞌ. Numuu rí nánguá máꞌ juwalaꞌ rí mu̱ne̱-mbáníílaꞌ xtángawoo Moisés, rí juwalaꞌ ga̱jma̱á numuu rí máján naxná Ana̱ꞌlóꞌ.<verse eid="ROM 6:14" /></para>
  <para style="s">Juwalóꞌ rí mu̱ꞌne̱lóꞌ ñajuun Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15" />Dí gúꞌne̱lóꞌ xúꞌkhue̱n rá. Á mu̱ꞌne̱lóꞌ máꞌ xúꞌkhue̱n aꞌkhán numuu rí nánguá máꞌ juwalóꞌ rí mu̱ꞌne̱-mbáníílóꞌ xtángoo, rí juwalóꞌ ga̱jma̱á numuu rí máján naxná Ana̱ꞌlóꞌ rá. ¡Na̱nguá mbá jayu! <verse eid="ROM 6:15" /><verse number="16" style="v" sid="ROM 6:16" />Xí ikháanꞌlaꞌ nu̱xna̱xí-mijnálaꞌ rí maꞌthán-ñájwanlaꞌ mbáa xa̱bo̱ xómá yumbáá waꞌtsi̱in jamí nu̱ne̱-mbáníílaꞌ rí naꞌthée̱n, ikháanꞌlaꞌ ñajwanlaꞌ yumbáá waꞌtsi̱in drígo̱o̱ tsí nu̱ne̱-mbáníílaꞌ rí naꞌthán. Xí ikháanꞌlaꞌ ñajwanlaꞌ yumbáá waꞌtsi̱in drígo̱o̱ aꞌkhán, ma̱ja̱ñálaꞌ, jamí xí ikháanꞌlaꞌ ñajwanlaꞌ yumbáá waꞌtsi̱in drígo̱o̱ Ana̱ꞌlóꞌ, ikhaa̱ maꞌthée̱n rí nánda̱a̱ aꞌkhánlaꞌ ná inuu̱. <verse eid="ROM 6:16" /><verse number="17" style="v" sid="ROM 6:17" />Rí nákhí wapha ikháanꞌlaꞌ ninindxa̱ꞌlaꞌ yumbáá waꞌtsi̱in drígo̱o̱ aꞌkhán. Xómáꞌ xúge̱ꞌ rá, núma̱aꞌ la Ana̱ꞌlóꞌ rí mbá jañii a̱kia̱nꞌlaꞌ ninimba̱ꞌlaꞌ jamí ni̱drígúlaꞌ gisngáá rí waꞌsngálaꞌ. <verse eid="ROM 6:17" /><verse number="18" style="v" sid="ROM 6:18" />Ído̱ rí nijríñáaꞌlaꞌ máꞌ ná ñawúun aꞌkhán, nánguá máꞌ ñajwanlaꞌ yumbée ne̱, rí yumbée Ana̱ꞌlóꞌ ñajwanlaꞌ kajngó mu̱ne̱laꞌ rí máján. <verse eid="ROM 6:18" /><verse number="19" style="v" sid="ROM 6:19" />Na̱tha̱nꞌ-makalaꞌ ríge̱ꞌ, numuu rí wabáanꞌlaꞌ jamí tsíꞌnga̱ꞌlaꞌ gáfraꞌa̱ꞌ-májánlaꞌ ne̱. Xómá rí ni̱xna̱xí-mijnálaꞌ nákhí wapha ná ñawúun aꞌkhán rí mu̱ne̱ miꞌsmba-mijnálaꞌ jamí mu̱ne̱laꞌ rí xkawe̱ꞌ, xkuaꞌnii máꞌ gúxna̱xí-mijnálaꞌ xúge̱ꞌ ná ñawúun Ana̱ꞌlóꞌ kajngó ma̱ꞌne-jaꞌwáa̱nꞌlaꞌ jamí mu̱ne̱laꞌ rí máján.<verse eid="ROM 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 6:20" />Numuu rí nákhí ninindxa̱ꞌlaꞌ yumbáá waꞌtsi̱in drígo̱o̱ aꞌkhán, na̱nguá máꞌ ni̱we̱je̱ inalaꞌ rí mu̱ne̱laꞌ rí máján ná inuu Ana̱ꞌlóꞌ. <verse eid="ROM 6:20" /><verse number="21" style="v" sid="ROM 6:21" />Náá lá rí máján ni̱da̱alaꞌ nákhí ne̱ne̱laꞌ rí nandoo aꞌkhán rá. I̱ndo̱ó máꞌ na̱ti̱ya̱ꞌlaꞌ ído̱ rí na̱rmáꞌáan a̱kia̱nꞌlaꞌ rí ne̱ne̱laꞌ rí naꞌne rí ma̱ja̱ñálaꞌ. <verse eid="ROM 6:21" /><verse number="22" style="v" sid="ROM 6:22" />Xómáꞌ xúge̱ꞌ rá, rí nijríñáaꞌlaꞌ máꞌ ná ñawúun aꞌkhán jamí ninindxa̱ꞌlaꞌ máꞌ yumbée Ana̱ꞌlóꞌ rá, na̱ka̱-ra̱gu̱ma-jaꞌwáanꞌlaꞌ eꞌne Ana̱ꞌlóꞌ, jamí nda̱wa̱á ma̱juwalaꞌ jámuu. <verse eid="ROM 6:22" /><verse number="23" style="v" sid="ROM 6:23" />Numuu rí aꞌkhán naꞌne-numa̱aꞌlóꞌ ga̱jma̱á rí ma̱ja̱ñálóꞌ, xómáꞌ Ana̱ꞌlóꞌ naxná rí ma̱juwalóꞌ jámuu ga̱jma̱á majñu̱u̱ Tátiálóꞌ Krísto̱ Jesús.<verse eid="ROM 6:23" /></para>
  <chapter eid="ROM 6" />
  <chapter number="7" style="c" sid="ROM 7" />
  <para style="s">Mbá xkri̱da ga̱jma̱á numúú xa̱bo̱ tsí nida-mijná</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1" />A̱ngui̱nꞌ, á tsíya̱álaꞌ rí i̱ndo̱ó máꞌ mbiꞌi rí xtáa ndaꞌya xa̱bo̱ nithán-ñájwíi̱n eꞌne xtángoo rá dxe̱ꞌ. (Numuu rí na̱tha̱nꞌlaꞌ ikháanꞌlaꞌ tsáanꞌ nu̱ne̱-nuwiinlaꞌ xtángoo.) <verse eid="ROM 7:1" /><verse number="2" style="v" sid="ROM 7:2" />Ma̱ña̱ꞌlaꞌ mbá xkri̱da: ga̱jma̱á majñu̱u̱ xtángoo nduꞌyáálóꞌ rí mbáa a̱ꞌgo̱ tsí ninújún, ma̱nindxu̱u̱ a̱ꞌgui̱i xa̱bo̱ awúun mbiꞌi rí xtáa ndaꞌya. Jamí xí nijáñuu máꞌ a̱jmbee̱ rá, nánguá máꞌ wéje̱ inuu̱ rí ma̱ꞌne-mbánuu̱ xtángoo rúꞌkhue̱n. <verse eid="ROM 7:2" /><verse number="3" style="v" sid="ROM 7:3" />Ikhaa jngó, xí awúun mbiꞌi rí xtáa ndaꞌya a̱jmbee̱ ndayáa̱ i̱mba̱a̱ꞌ xa̱biya̱, mi̱ꞌthán rí nabóo̱ ga̱jmáa̱ xa̱bo̱ tsí táyáa̱. Jamí xí nijáñuu máꞌ a̱jmbee̱ rá, nánguá gíꞌmaa̱ rí ma̱ꞌne-mbánuu̱ xtángoo rúꞌkhue̱n. Maske máꞌ ndayáa̱ i̱mba̱a̱ꞌ xa̱biya̱, ma̱xíꞌthán rí nabóo̱ ga̱jmáa̱ xa̱bo̱ tsí táyáa̱.<verse eid="ROM 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 7:4" />Xkuaꞌnii máꞌ mangáanꞌlaꞌ a̱ngui̱nꞌ, nijáñalaꞌ ná inuu xtángoo ga̱jma̱á majñu̱u̱ rí nijáñuu Krísto̱, kajngó ma̱nindxa̱ꞌlaꞌ xa̱bi̱i i̱mba̱a̱ꞌ. Rí xúge̱ꞌ rá, ñajwanlaꞌ xa̱bi̱i Krísto̱, tsí ndiyáa mbiꞌyuu. Xkuaꞌnii kajngó ma̱grui̱gúu gamaku Ana̱ꞌlóꞌ ga̱jma̱á numuu rí máján nu̱ꞌne̱lóꞌ. <verse eid="ROM 7:4" /><verse number="5" style="v" sid="ROM 7:5" />Numuu rí nákhí nijuwalóꞌ xómá rí nandoo xuyalóꞌ, rí xtángoo nixkaxi̱i xuyalóꞌ rí ma̱ni̱gua̱ꞌlóꞌ mu̱ꞌne̱lóꞌ aꞌkhán, rí na̱ka̱ jaguáanꞌlóꞌ ná ma̱ja̱ñálóꞌ. <verse eid="ROM 7:5" /><verse number="6" style="v" sid="ROM 7:6" />Xómáꞌ xúge̱ꞌ rá, nijáñalóꞌ ná inuu xtángoo, jamí nánguá máꞌ gíꞌdoo ne̱ tsiakhe̱ rí maꞌthán-ñájwanlóꞌ, kajngó ma̱goo mu̱ꞌne̱-mba̱a̱lóꞌ Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ mbiꞌyalóꞌ rí nuxe̱ꞌ rí naxnálóꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ, ra̱ꞌkhá ga̱jma̱á majñu̱u̱ xtángoo wayuu rí ninguanúu máꞌ tsu̱di̱í.<verse eid="ROM 7:6" /></para>
  <para style="s">Xkujndu rí guáꞌdáálóꞌ ga̱jma̱á nindxu̱u̱ aꞌkhán</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7" />Dí gúꞌthánlóꞌ xúꞌkhue̱n rá. Á mu̱ꞌthánlóꞌ rí aꞌkhán ñajuun xtángoo rá. ¡Na̱nguá mbá jayu! I̱ndo̱ó máꞌ numuu rí ikhúúnꞌ ma̱xáne̱-núwíinlo̱ꞌ aꞌkhán xí ra̱ꞌkhá ga̱jma̱á numuu xtángoo. Xúꞌkhue̱n máꞌ mangaa, ma̱xáni̱gu̱ꞌ máꞌ ma̱gúꞌdo̱ꞌ rí na̱nguá gúꞌdo̱ꞌ, xí ra̱ꞌkhá numuu rí xtángoo naꞌthán: «Ma̱xáni̱gua̱a̱ꞌ ma̱raꞌdáá rí na̱nguá xtaꞌdáá». <verse eid="ROM 7:7" /><verse number="8" style="v" sid="ROM 7:8" />Xómáꞌ aꞌkhán ndiyá ne̱ tsiakhe̱ rí ríga̱ xtángoo, a̱ꞌkhue̱n nijmuu ne̱ xtángoo rí maxkaxi̱i ne̱ a̱kui̱nꞌ kajngó ma̱ni̱gu̱ꞌ ma̱gúꞌdo̱ꞌ mbá xúgíí inii rí ríga̱ ná numbaa. Numuu rí nda̱a̱ máꞌ ski̱yu̱u̱ꞌ rí aꞌkhán ído̱ rí nda̱a̱ xtángoo. <verse eid="ROM 7:8" /><verse number="9" style="v" sid="ROM 7:9" />Rí nákhí wajyúú, nákhí rí xóó nda̱a̱ xtángoo, ikhúúnꞌ tsímáá xtáálo̱ꞌ. I̱ndo̱ó máꞌ numuu ído̱ rí ni̱ꞌkha̱ xtángoo rá, a̱ꞌkhue̱n ni̱gi̱ꞌdu̱u̱n rí na̱wa̱ꞌa̱ a̱kui̱nꞌ ma̱ne̱ aꞌkhán, jamí ikhúúnꞌ nijáñuꞌ ná inuu Ana̱ꞌlóꞌ. <verse eid="ROM 7:9" /><verse number="10" style="v" sid="ROM 7:10" />A̱ꞌkhue̱n ndi̱yo̱o̱ rí ikhaa xtángoo rí jaꞌyoo ma̱ꞌne rí mba̱ya̱, ikhaa ne̱ neꞌne rí ma̱ja̱ñúꞌ. <verse eid="ROM 7:10" /><verse number="11" style="v" sid="ROM 7:11" />Numuu rí aꞌkhán ndiyá ne̱ tsiakhe̱ ga̱jma̱á xtángoo, a̱ꞌkhue̱n neꞌne-nduwúún ne̱. Jamí xúꞌkhue̱n máꞌ ga̱jma̱á majñu̱u̱ xtángoo neꞌne ne̱ rí ma̱ja̱ñúꞌ.<verse eid="ROM 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 7:12" />Ikhaa jngó, rí xtángoo jaꞌwu ne̱, jamí mbámbá ajngóo ne̱ jaꞌwu mangaa, phú jmbu ne̱ jamí máján ne̱. <verse eid="ROM 7:12" /><verse number="13" style="v" sid="ROM 7:13" />Á ikhaa rí máján neꞌne rí ma̱ja̱ñúꞌ xúꞌkhue̱n rá. ¡Na̱nguá mbá jayu! Rí aꞌkhán neꞌne rí ma̱ja̱ñúꞌ ga̱jma̱á majñu̱u̱ mbá rí máján kajngó ma̱kujma xáne phú jaꞌnii rí aꞌkhán. Ikhaa jngó, ga̱jma̱á majñu̱u̱ xtángoo nakujma rí phú xkawe̱ꞌ rí aꞌkhán.<verse eid="ROM 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14" />Numuu nduꞌyáálóꞌ máꞌ rí ná inuu Ana̱ꞌlóꞌ ni̱ꞌkha̱ rí xtángoo. Xómáꞌ ikhúúnꞌ rá, xa̱bo̱ numbaa jayu ñajunꞌ, jamí watangu̱ju̱ún ná ñawúun aꞌkhán. <verse eid="ROM 7:14" /><verse number="15" style="v" sid="ROM 7:15" />Tsífroꞌo̱ꞌ rí na̱ne̱lo̱ꞌ, numuu rí tsíne̱lo̱ꞌ rí nandoꞌ. Maphú ikhaa rí tsíyoꞌ gáne̱lo̱ꞌ, ikhaa e̱ne̱lo̱ꞌ. <verse eid="ROM 7:15" /><verse number="16" style="v" sid="ROM 7:16" />Jamí xí ikhaa rí tsíyoꞌ gáne̱lo̱ꞌ, ikhaa e̱ne̱lo̱ꞌ rá, rúꞌkhue̱n iꞌthán rí nda̱yo̱o̱ máꞌ rí máján rí xtángoo. <verse eid="ROM 7:16" /><verse number="17" style="v" sid="ROM 7:17" />Ikhaa jngó, ra̱ꞌkhá ikhúúnꞌ ñajunꞌ tsí naꞌne rí xkawe̱ꞌ na̱ne̱lo̱ꞌ, rí aꞌkhán rí kra̱ꞌa ná xuyuꞌ naꞌne ne̱. <verse eid="ROM 7:17" /><verse number="18" style="v" sid="ROM 7:18" />Jamí ikhúúnꞌ nda̱yo̱o̱ rí ga̱jma̱á nindxu̱ꞌ ikhúúnꞌ, rí xa̱bo̱ numbaa ñajunꞌ, nda̱a̱ rí máján. Numuu rí naꞌne máꞌ a̱kui̱nꞌ rí ma̱ne̱lo̱ꞌ rí máján, i̱ndo̱ó máꞌ numuu rí tsíyoo rí ma̱ne̱lo̱ꞌ ne̱. <verse eid="ROM 7:18" /><verse number="19" style="v" sid="ROM 7:19" />Numuu rí tsíne̱lo̱ꞌ rí máján rí naꞌne a̱kui̱nꞌ rí ma̱ne̱lo̱ꞌ, rí i̱ndo̱ó máꞌ na̱ne̱lo̱ꞌ rí xkawe̱ꞌ rí tsíyoꞌ gáne̱lo̱ꞌ. <verse eid="ROM 7:19" /><verse number="20" style="v" sid="ROM 7:20" />Ikhaa jngó, xí na̱ne̱lo̱ꞌ rí tsíyoꞌ gáne̱lo̱ꞌ, ra̱ꞌkhá ikhúúnꞌ e̱ne̱lo̱ꞌ ne̱, rí aꞌkhán rí kra̱ꞌa ná xuyuꞌ naꞌne ne̱.<verse eid="ROM 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21" />Ikhaa jngó, ído̱ rí nandoꞌ gáne̱lo̱ꞌ rí máján, na̱xkamaa ríge̱ꞌ: i̱ndo̱ó máꞌ rí xkawe̱ꞌ ríga̱ ná xuyuꞌ jamí tsíyoo gáni̱ꞌñúu-ra̱ne̱ rí xkawe̱ꞌ. <verse eid="ROM 7:21" /><verse number="22" style="v" sid="ROM 7:22" />Ná awúun a̱kui̱nꞌ awúún, phú naꞌne a̱kui̱nꞌ rí ma̱ne̱-mbánuu xtángawoo Ana̱ꞌlóꞌ. <verse eid="ROM 7:22" /><verse number="23" style="v" sid="ROM 7:23" />Xómáꞌ ná awúun xuyuꞌ rá, ríga̱ i̱mba̱ xtángoo rí tsíyoo gániñiꞌ ma̱ne̱ rí nda̱yo̱o̱ máꞌ rí máján ma̱ne̱, jamí xa̱ꞌ gatuwúún ne̱ asndo xó rí gíꞌdúún ne̱ ná géjwa̱nꞌ jaꞌnii: ikhaa rúꞌkhue̱n ñajuun xtángoo drígo̱o̱ aꞌkhán rí ríga̱ ná xuyuꞌ.<verse eid="ROM 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 7:24" />¡Phú mingínúú mi̱ndaꞌkho! Tsáa gáꞌne-jríñúu ná ñawúun xuwi aꞌkhán ríge̱ꞌ rí naꞌne rí ma̱ja̱ñúꞌ róꞌ. <verse eid="ROM 7:24" /><verse number="25" style="v" sid="ROM 7:25" />¡I̱ndo̱ó máꞌ numuu rí núma̱aꞌ la Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ Tátiálóꞌ Jesukrísto̱!</para>
  <para style="p" vid="ROM 7:25">Ikhaa jngó, jmínu̱úꞌ máꞌ ikhúúnꞌ ga̱jma̱á ju̱mu̱ꞌ na̱ne̱-mbánuulo̱ꞌ xtángawoo Ana̱ꞌlóꞌ, xómáꞌ rí xa̱bo̱ numbaa ñajunꞌ rá, na̱ne̱-mbánuulo̱ꞌ xtángawoo aꞌkhán.<verse eid="ROM 7:25" /></para>
  <chapter eid="ROM 7" />
  <chapter number="8" style="c" sid="ROM 8" />
  <para style="s">Xu̱u̱ꞌ Ana̱ꞌlóꞌ naꞌne rí ma̱nindxa̱ꞌlóꞌ xa̱bo̱ nuxi̱i̱ꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1" />Ikhaa jngó rí xúge̱ꞌ rá, nánguá máꞌ mi̱ꞌxná-máꞌíin rí mu̱míni̱í tsí mbá ꞌnduꞌ júwa̱ꞌ ga̱jma̱á nindxu̱u̱ Krísto̱ Jesús, ikhiin tsí na̱nguá júwa̱ꞌ xómá rí nandoo xuñúú, rí júwe̱e̱ꞌ xómá rí nandoo Xu̱u̱ꞌ Ana̱ꞌlóꞌ.<note caller="+" style="f"><char style="fr" closed="false">8.1 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «ikhiin tsí na̱nguá júwa̱ꞌ xómá rí nandoo xuñúú, rí júwe̱e̱ꞌ xómá rí nandoo Xu̱u̱ꞌ Ana̱ꞌlóꞌ».</char></note> <verse eid="ROM 8:1" /><verse number="2" style="v" sid="ROM 8:2" />Numuu rí xtángawoo Xu̱u̱ꞌ Ana̱ꞌlóꞌ, tsí naꞌne rí mbu̱ꞌyalóꞌ ga̱jma̱á nindxu̱u̱ Krísto̱, neꞌne-jríñáaꞌlóꞌ ná inuu xtángawoo aꞌkhán rí naꞌne rí ma̱ja̱ñálóꞌ. <verse eid="ROM 8:2" /><verse number="3" style="v" sid="ROM 8:3" />Táꞌngo̱o̱ xtángoo gáꞌne-jríñáaꞌlóꞌ ga̱jma̱á numuu rí nda̱a̱ ski̱ñu̱ú xa̱bo̱ numbaa rí mune̱-mbáníí ne̱. I̱ndo̱ó máꞌ Ana̱ꞌlóꞌ ni̱ꞌngo̱o̱ neꞌne-jríñáaꞌlóꞌ ído̱ rí nixuꞌmaa̱ A̱dée̱ rí ma̱nindxu̱u̱ xómá xa̱bo̱ numbaa jayu, kajngó ma̱ja̱ñúu̱ ga̱jma̱á numuu aꞌkhúún xa̱bo̱. Xkuaꞌnii neꞌne-gámbo̱o̱ Ana̱ꞌlóꞌ ski̱yu̱u̱ꞌ aꞌkhán ga̱jma̱á majñu̱u̱ xuyuu Krísto̱, <verse eid="ROM 8:3" /><verse number="4" style="v" sid="ROM 8:4" />kajngó ma̱mba̱núu mbá xúgíí rí na̱nda̱ꞌa̱ xtángoo ga̱jma̱á nindxa̱ꞌlóꞌ ikháánꞌlóꞌ. Numuu rí nánguá máꞌ juwalóꞌ xómá rí nandalóꞌ ikháánꞌlóꞌ, rí juwalóꞌ xómá rí nandoo Xu̱u̱ꞌ Ana̱ꞌlóꞌ.<verse eid="ROM 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 8:5" />Tsí júwa̱ꞌ xómá rí nandúún ikhiin, i̱ndo̱ó máꞌ nu̱ndxa̱ꞌwa̱-mijnée̱ rí muni̱i̱ rí nandoo xuñúu̱. Xómáꞌ tsí júwa̱ꞌ xómá rí nandoo Xu̱u̱ꞌ Ana̱ꞌlóꞌ rá, nu̱ndxa̱ꞌwa̱-mijnée̱ rí muni̱i̱ rí nandoo Xu̱u̱ꞌ Ana̱ꞌlóꞌ. <verse eid="ROM 8:5" /><verse number="6" style="v" sid="ROM 8:6" />Tsí i̱ndo̱ó máꞌ xtáa ma̱ꞌne rí nandoo xuyuu, ma̱ja̱ñúu̱. Xómáꞌ tsí xtáa ma̱ꞌne rí nandoo Xu̱u̱ꞌ Ana̱ꞌlóꞌ rá, mba̱ꞌyee̱ jámuu jamí ma̱xtáa̱ tsímáá. <verse eid="ROM 8:6" /><verse number="7" style="v" sid="ROM 8:7" />Numuu rí Ana̱ꞌlóꞌ xtáa sia̱nꞌ ga̱jma̱á rí nu̱ndxa̱ꞌwa̱-mijná xa̱bo̱ mune̱, numuu rí tsíndxa̱ꞌwa̱-mijnée̱ rí mune̱-mbáníi̱ xtángawoo Ana̱ꞌlóꞌ, ni máꞌ tsíꞌngúu̱n gúne̱-mbáníi̱ ne̱. <verse eid="ROM 8:7" /><verse number="8" style="v" sid="ROM 8:8" />Ikhaa jngó, tsí i̱ndo̱ó máꞌ júwa̱ꞌ rí mune̱ rí nandoo xuñúú, tsíyoo rí ma̱ni̱gu̱u̱ꞌ Ana̱ꞌlóꞌ gúni̱i̱ ga̱jma̱á numuu rí nuni̱i̱.<verse eid="ROM 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9" />Xómáꞌ ikháanꞌlaꞌ rá, nánguá máꞌ juwalaꞌ xómá rí nandoo xuyalaꞌ, rí juwalaꞌ xómá rí nandoo Xu̱u̱ꞌ Ana̱ꞌlóꞌ, numuu rí Xu̱u̱ꞌ Ana̱ꞌlóꞌ xtáa ga̱jma̱á nindxa̱ꞌlaꞌ. Jamí xí mbáa na̱nguá xtáa Xu̱u̱ꞌ Krísto̱ ga̱jma̱á nindxu̱u̱, ra̱ꞌkhá xa̱bi̱i Krísto̱ ñajuun tsúꞌkhue̱n. <verse eid="ROM 8:9" /><verse number="10" style="v" sid="ROM 8:10" />Xí Krísto̱ xtáa ná awúun a̱kia̱nꞌlaꞌ, maske máꞌ wéje̱ tsiakhe̱ rí ma̱ja̱ñúu xuyalaꞌ ga̱jma̱á numuu aꞌkhán, Xu̱u̱ꞌ Ana̱ꞌlóꞌ naꞌne rí ma̱juwalaꞌ jámuu ga̱jma̱á numuu rí Ana̱ꞌlóꞌ naꞌthán rí nánda̱a̱ máꞌ aꞌkhánlaꞌ. <verse eid="ROM 8:10" /><verse number="11" style="v" sid="ROM 8:11" />Xu̱u̱ꞌ Ana̱ꞌlóꞌ tsí neꞌne rí mbayáa mbiꞌyuu Jesús xtáa ga̱jma̱á nindxa̱ꞌlaꞌ. Ikhaa̱ máꞌ ma̱ꞌnii̱ rí mba̱ꞌya̱a xuyalaꞌ mangáanꞌlaꞌ, ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ tsí xtáa ga̱jma̱á nindxa̱ꞌlaꞌ.<verse eid="ROM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12" />Ikhaa jngó, a̱ngui̱nꞌ, gíꞌmáálóꞌ ná inuu Xu̱u̱ꞌ Ana̱ꞌlóꞌ, jamí na̱nguá gíꞌmáálóꞌ ná inuu xuyalóꞌ, ikhaa jngó náxúꞌne̱lóꞌ rí nandoo ne̱. <verse eid="ROM 8:12" /><verse number="13" style="v" sid="ROM 8:13" />Xí ikháanꞌlaꞌ juwalaꞌ xómá nandoo xuyalaꞌ, ma̱ja̱ñálaꞌ. Jamí xí ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ nu̱ne̱-gámba̱ꞌlaꞌ mbá xúgíí rí xkawe̱ꞌ nandoo xuyalaꞌ, ma̱juwalaꞌ jámuu.<verse eid="ROM 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 8:14" />Numuu rí mbá xúgíin tsí jiꞌyá ikhúún eꞌne Xu̱u̱ꞌ Ana̱ꞌlóꞌ, tsúꞌkhue̱n ñajúún i̱ji̱in Ana̱ꞌlóꞌ. <verse eid="ROM 8:14" /><verse number="15" style="v" sid="ROM 8:15" />Numuu rí Ana̱ꞌlóꞌ táxnálaꞌ Xu̱u̱ꞌ kajngó ma̱juwalaꞌ máꞌ xúꞌkhue̱n ná awúun ngamí mbu̱júꞌ, rí nixnálaꞌ Xu̱u̱ꞌ numuu rí niguáa̱nꞌlaꞌ kajngó ma̱nindxa̱ꞌlaꞌ i̱jii̱n. Jamí ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ nuꞌtháa̱nlóꞌ: «Táa». <verse eid="ROM 8:15" /><verse number="16" style="v" sid="ROM 8:16" />Jmína̱a̱ꞌ máꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ naꞌthúun a̱kia̱nꞌlóꞌ rí i̱ji̱in Ana̱ꞌlóꞌ ñajwanlóꞌ. <verse eid="ROM 8:16" /><verse number="17" style="v" sid="ROM 8:17" />Ga̱jma̱á numuu rí i̱ji̱in Ana̱ꞌlóꞌ ñajwanlóꞌ, mu̱ꞌda̱alóꞌ rí gíꞌdoo̱ xómá rí magu̱u ne̱ Krísto̱ mangaa. I̱ndo̱ó máꞌ numuu rí xúge̱ꞌ, ndaꞌyóo rí mu̱míni̱ílóꞌ ga̱jma̱á nindxu̱u̱ Krísto̱, kajngó ma̱juwalóꞌ mangáanꞌlóꞌ ga̱jma̱á nindxu̱u̱ ná phú tsímáá xtáa̱ ikhaa̱.<verse eid="ROM 8:17" /></para>
  <para style="s">Maphú tsímáá ma̱juwalóꞌ nda̱wa̱á</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18" />Ikhúúnꞌ nda̱yo̱o̱ mújúnꞌ rí ni na̱nguá mba̱a̱ jamínu̱ꞌ rí nanújngalóꞌ xúge̱ꞌ xó rí phú mba̱a̱ rí tsímáá maxnálóꞌ Ana̱ꞌlóꞌ nda̱wa̱á. <verse eid="ROM 8:18" /><verse number="19" style="v" sid="ROM 8:19" />Mbá xúgíí rí ni̱gu̱ma-ku̱maa ná numbaa ríge̱ꞌ maphú gíꞌthu̱u̱n mba̱ꞌyoo mbiꞌi ído̱ rí Ana̱ꞌlóꞌ masngájmii tsí phú gakon rí ñajúún i̱jii̱n. <verse eid="ROM 8:19" /><verse number="20" style="v" sid="ROM 8:20" />Numuu rí mbá xúgíí rí ni̱gu̱ma-ku̱maa ná numbaa ríge̱ꞌ waꞌxná-máꞌáan ne̱, kajngó ma̱ꞌne rí nda̱a̱ mbá jayu numuu gáríga̱ ne̱, ra̱ꞌkhá numuu rí ikhaa ne̱ ndiyoo, rí ga̱jma̱á numuu rí xkuaꞌnii ndiꞌyoo Ana̱ꞌlóꞌ. I̱ndo̱ó máꞌ numuu rí ninguanúu ne̱ rí ma̱gi̱ꞌthu̱u̱n ga̱jma̱á mbá jañii a̱kui̱in ne̱, <verse eid="ROM 8:20" /><verse number="21" style="v" sid="ROM 8:21" />numuu rí ma̱ga̱nú mbiꞌi rí ma̱jríya̱a̱ꞌ ne̱ inuu rí waꞌxná-máꞌáan ne̱. A̱ꞌkhue̱n rí nánguá ma̱ꞌchúu ne̱, kajngó ma̱ꞌdxu a̱kui̱in ne̱ mangaa ído̱ rí maphú tsímáá nijáwíin i̱ji̱in Ana̱ꞌlóꞌ.<verse eid="ROM 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 8:22" />Numuu nduꞌyáálóꞌ rí asndo xúge̱ꞌ, mbá xúgíí rí ni̱gu̱ma-ku̱maa ná numbaa ríge̱ꞌ naguwan ne̱. Naꞌkhui̱i̱ ne̱ xómá naꞌkho̱ awúun mbáa a̱ꞌgo̱ tsí inu ma̱ꞌne-xuajen. <verse eid="ROM 8:22" /><verse number="23" style="v" sid="ROM 8:23" />Jamí ra̱ꞌkhá máꞌ i̱ndo̱ó rí ni̱gu̱ma-ku̱maa ná numbaa ríge̱ꞌ, rí ikháánꞌlóꞌ máꞌ mangaa tsáanꞌ ni̱dríguíilóꞌ ginii jayu Xu̱u̱ꞌ Ana̱ꞌlóꞌ, nu̱guwanlóꞌ ná awúun a̱kia̱nꞌlóꞌ, awúun mbiꞌi rí guáꞌthi̱ínlóꞌ rí Ana̱ꞌlóꞌ maguáa̱nꞌlóꞌ rí ma̱nindxa̱ꞌlóꞌ i̱jii̱n, ído̱ rí ma̱ꞌne-jríya̱a̱ꞌ mbá jayu xuyalóꞌ ná inuu mbá xúgíí. <verse eid="ROM 8:23" /><verse number="24" style="v" sid="ROM 8:24" />Numuu rí ikhaa máꞌ numuu rúꞌkhue̱n ni̱gu̱ma-jríñáaꞌlóꞌ, rí ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ mu̱waꞌthi̱ínlóꞌ rí ma̱jríya̱a̱ꞌ mbá jayu xuyalóꞌ. Jamí xí xóó na̱nguá iꞌyáálóꞌ rí ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ guáꞌthi̱ínlóꞌ, ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ guáꞌthi̱ínlóꞌ ne̱. Numuu rí ndawa̱a̱ máꞌ tsí gíꞌthu̱u̱n rí ndaꞌyoo máꞌ ga̱jma̱á iduu. <verse eid="ROM 8:24" /><verse number="25" style="v" sid="ROM 8:25" />Jamí xí guáꞌthi̱ínlóꞌ mbá rí xóó tsíkujma mbu̱ꞌyáálóꞌ, tsíꞌne níꞌnga̱ꞌlóꞌ rí mu̱waꞌthi̱ínlóꞌ ne̱.<verse eid="ROM 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26" />Xúꞌkhue̱n máꞌ mangaa nambáyálóꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ numuu rí wabáanꞌlóꞌ. Tsíma̱ñalóꞌ gúꞌthán-jáñíí Ana̱ꞌlóꞌ xómá phú jaꞌyoo, xómáꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ naꞌthán-kháan ga̱jma̱á numalóꞌ, ga̱jma̱á a̱ꞌwá rí tsíyoo mi̱ꞌthán ga̱jma̱á ajngáa. <verse eid="ROM 8:26" /><verse number="27" style="v" sid="ROM 8:27" />Xómáꞌ Ana̱ꞌlóꞌ, tsí naꞌne-nuwiin máꞌ a̱kia̱nꞌlóꞌ rá, ndaꞌyoo̱ máꞌ dí ñajuun naꞌthán Xu̱u̱ꞌ, numuu rí Xu̱u̱ꞌ Ana̱ꞌlóꞌ naꞌthán kháan numalóꞌ xómá rí nandoo Ana̱ꞌlóꞌ.<verse eid="ROM 8:27" /></para>
  <para style="s">Mbá xúgíí rí naꞌne Ana̱ꞌlóꞌ nambáyálóꞌ</para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28" />Jamí nduꞌyáálóꞌ máꞌ rí mbá xúgíí rí naríga̱, nambáñúú ne̱ tsí nandúún juyáá Ana̱ꞌlóꞌ, ikhiin máꞌ tsí Ana̱ꞌlóꞌ nindxaꞌwúún rí ma̱nindxu̱ún xómá niꞌgí-mine̱e̱ꞌ ikhaa̱. <verse eid="ROM 8:28" /><verse number="29" style="v" sid="ROM 8:29" />Numuu rí Ana̱ꞌlóꞌ asndo nákhí máꞌ ginii neꞌne-nuwii̱n tsí ma̱nindxu̱ún xa̱bii̱, jamí asndo nákhí máꞌ ginii niꞌgí-mine̱e̱ꞌ rí tsíge̱ꞌ ma̱nindxu̱ún xómá jaꞌnii A̱dée̱ mangaa, kajngó ikhaa̱ ma̱nindxu̱u̱ ada̱ ginii inúú mbaꞌiin a̱nguii̱n. <verse eid="ROM 8:29" /><verse number="30" style="v" sid="ROM 8:30" />Ikhiin máꞌ tsí asndo nákhí ginii niꞌgí-mina̱ꞌ Ana̱ꞌlóꞌ rí ma̱nindxu̱ún i̱ji̱in, ikhiin máꞌ tsíge̱ꞌ nindxaꞌwúu̱n mangaa. Jamí ikhiin máꞌ tsí nindxaꞌwúu̱n, ikhiin máꞌ tsíge̱ꞌ niꞌthée̱n rí nánda̱a̱ aꞌkhúún mangaa. Jamí ikhiin máꞌ tsí niꞌthée̱n rí nánda̱a̱ aꞌkhúún, ikhiin máꞌ tsíge̱ꞌ niꞌnii̱ rí ma̱ju̱wá ga̱jma̱á nindxu̱u̱ ná phú tsímáá xtáa̱ ikhaa̱.<verse eid="ROM 8:30" /></para>
  <para style="s">Nimbá miꞌtsú ma̱xániñuu Ana̱ꞌlóꞌ rí nandoo jaꞌyalóꞌ</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31" />Dí gúꞌthánlóꞌ xúꞌkhue̱n rá. Xí Ana̱ꞌlóꞌ xtáa ga̱jma̱á nindxa̱ꞌlóꞌ, tsáa gáꞌngo̱o̱ ma̱ꞌne ga̱jma̱á nindxa̱ꞌlóꞌ xúꞌkhue̱n rá. <verse eid="ROM 8:31" /><verse number="32" style="v" sid="ROM 8:32" />Ana̱ꞌlóꞌ táꞌne xtándúu̱ ni máꞌ ga̱jma̱á numuu asndo jmína̱a̱ꞌ A̱dée̱, a̱ꞌkhue̱n gakon nixnáxi̱i̱ kajngó ma̱ja̱ñúu̱ ga̱jma̱á numalóꞌ mbá xúgiáanꞌlóꞌ. Á ma̱xáxnálóꞌ ga̱jma̱á nindxu̱u̱ Krísto̱ mbá xúgíí rí gíꞌdoo̱ mangaa rá. <verse eid="ROM 8:32" /><verse number="33" style="v" sid="ROM 8:33" />Ana̱ꞌlóꞌ ñajuun tsí naꞌthán rí nánda̱a̱ aꞌkhánlóꞌ tsáanꞌ xa̱bii̱ tsí niraꞌwíi̱n ñajwanlóꞌ, tsáa gáꞌngo̱o̱ maꞌthán rí ríga̱ aꞌkhánlóꞌ xúꞌkhue̱n rá. <verse eid="ROM 8:33" /><verse number="34" style="v" sid="ROM 8:34" />Ndawa̱a̱ tsí ma̱ꞌngo̱o̱ maxná-máꞌáanꞌlóꞌ rí mu̱míni̱ílóꞌ, numuu rí Krísto̱ nijáñuu ga̱jma̱á numalóꞌ. Ra̱ꞌkhá máꞌ i̱ndo̱ó rúꞌkhue̱n, rí ndiyáa̱ mbiꞌyuu̱ mangaa, ꞌgíi̱ ná ñawún mújúun Ana̱ꞌlóꞌ, jamí naꞌthán-jáñuu̱ Ana̱ꞌlóꞌ ga̱jma̱á numalóꞌ mangaa. <verse eid="ROM 8:34" /><verse number="35" style="v" sid="ROM 8:35" />Tsáa gáꞌngo̱o̱ ma̱ꞌne-tsíngua̱ꞌlóꞌ inuu rí nandoo jaꞌyalóꞌ Krísto̱ róꞌ. Á ma̱ꞌngo̱o̱ jamínu̱ꞌ dxe̱ꞌ, o gaꞌkho̱ dxe̱ꞌ, o rí nune̱-ngínáaꞌlóꞌ xa̱bo̱ dxe̱ꞌ, o rí na̱xki̱dxa̱ꞌlóꞌ dxe̱ꞌ, o rí nda̱a̱ xtíñalóꞌ dxe̱ꞌ, o rí ngamí ma̱ja̱ñálóꞌ dxe̱ꞌ, o rí ma̱ja̱ñálóꞌ dxe̱ꞌ. <verse eid="ROM 8:35" /><verse number="36" style="v" sid="ROM 8:36" />Xómá ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="q" vid="ROM 8:36">«Ga̱jma̱á numaaꞌ ikháánꞌ najáñaxo̱ꞌ mbámbá mbiꞌi.</para>
  <para style="q" vid="ROM 8:36">Nuña̱ꞌxo̱ꞌ xa̱bo̱ xómá xu̱kú mogo̱ tsí na̱ka̱ jiꞌdiin rí ma̱ja̱ñúú».<note caller="+" style="f"><char style="fr" closed="false">8.36 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 44.22.</char></note><verse eid="ROM 8:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ROM 8:37" />Xómáꞌ ikháánꞌlóꞌ, ído̱ rí juwalóꞌ awúun mbá xúgíí gaꞌkho̱ ríge̱ꞌ, i̱tha̱án máꞌ nanújngo-rámuu rí na̱ꞌnga̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ tsí ndiyoo jaꞌyalóꞌ. <verse eid="ROM 8:37" /><verse number="38" style="v" sid="ROM 8:38" />Ikhaa jngó, ikhúúnꞌ nda̱yo̱o̱ mújúnꞌ rí nda̱a̱ nimbá rí ma̱ꞌngo̱o̱ ma̱ꞌne-tsíngua̱ꞌlóꞌ inuu rí nandoo Ana̱ꞌlóꞌ jaꞌyalóꞌ, ni máꞌ rí ma̱ja̱ñálóꞌ, ni máꞌ rí juwa nduꞌyalóꞌ, ni máꞌ ánje̱l, ni máꞌ nimbá inii tsiakhe̱, ni máꞌ rí ríga̱ xúge̱ꞌ, ni máꞌ rí ma̱ri̱gá nda̱wa̱á. <verse eid="ROM 8:38" /><verse number="39" style="v" sid="ROM 8:39" />Ni máꞌ tsiakhe̱ rí ríga̱ ná i̱tha̱án tsída̱ꞌ, ni máꞌ tsiakhe̱ rí ríga̱ ná me̱jno̱ꞌ, ni máꞌ nimbá rí ni̱gu̱ma-ku̱maa, ma̱xáꞌngo̱o̱ ma̱ꞌne-tsíngua̱ꞌlóꞌ inuu rí nandoo Ana̱ꞌlóꞌ jaꞌyalóꞌ ga̱jma̱á majñu̱u̱ Tátiálóꞌ Krísto̱ Jesús.<verse eid="ROM 8:39" /></para>
  <chapter eid="ROM 8" />
  <chapter number="9" style="c" sid="ROM 9" />
  <para style="s">Ana̱ꞌlóꞌ naraꞌwíin xa̱bo̱ tsí ikhaa̱ máꞌ nandoo̱ maraꞌwíi̱n</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1" />Ikhúúnꞌ na̱tha̱nꞌlaꞌ rí gakon, numuu rí nanimbo̱ꞌ ja̱yo̱o̱ Krísto̱. Xu̱u̱ꞌ Ana̱ꞌlóꞌ jayá ikhoꞌ, jamí ikhaa̱ naꞌthán-múꞌúu̱n awúun a̱kui̱nꞌ rí tsíne̱-ndúwalo̱ꞌ. <verse eid="ROM 9:1" /><verse number="2" style="v" sid="ROM 9:2" />Phú xtáá gaꞌkho̱, jamí phú ngíná eꞌne a̱kui̱nꞌ. <verse eid="ROM 9:2" /><verse number="3" style="v" sid="ROM 9:3" />Numuu rí asndo naꞌne a̱kui̱nꞌ rí jmínu̱úꞌ máꞌ ikhúúnꞌ gánindxu̱ꞌ tsí kixná-máꞌáan, jamí tsí xtáa tsíngua̱ꞌ inuu Krísto̱, xí numuu rí xkuaꞌnii ma̱goo ma̱mbáñúú a̱ngui̱nꞌ, xa̱bo̱ xuajñuꞌ tsí juya̱ iꞌdiuꞌ. <verse eid="ROM 9:3" /><verse number="4" style="v" sid="ROM 9:4" />Ikhii̱n ñajúu̱n xa̱bo̱ xuajen Israél, tsí nigu̱un Ana̱ꞌlóꞌ rí ma̱ꞌne i̱ji̱in. Phú wáá xó rí nixtáa Ana̱ꞌlóꞌ ga̱jma̱á nindxúu̱n, jamí niꞌnii̱ awan ga̱jma̱á nindxúu̱n, xúꞌkhue̱n máꞌ ikhii̱n ni̱dri̱guíi̱ xtángawoo Moisés. Ikhii̱n waꞌsngúu̱n rí mune̱-mba̱a̱ Ana̱ꞌlóꞌ jamí mbaꞌa inii rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxúu̱n. <verse eid="ROM 9:4" /><verse number="5" style="v" sid="ROM 9:5" />Ikhii̱n ñajúu̱n i̱ji̱ín táta̱-xi̱ꞌñáxo̱ꞌ wajyúú, jamí ná ri̱jñúu̱ ikhii̱n ni̱gu̱maa Krísto̱ xómá xa̱bo̱ numbaa. Krísto̱ ñajuun Ana̱ꞌlóꞌ tsí naꞌthán-ñájuun mbá xúgíí. ¡A̱gu̱ma-mba̱a̱ ikhaa̱ jámuu mbiꞌi! Xkuaꞌnii gáꞌne.<verse eid="ROM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6" />Ra̱ꞌkhá máꞌ numuu rí Ana̱ꞌlóꞌ táꞌne-mbánuu ajngóo ga̱jma̱á nindxúu̱n, i̱ndo̱ó máꞌ numuu rí ra̱ꞌkhá mbá xúgíin xa̱bo̱ ri̱jyu̱u̱ꞌ Israél phú gakon rí xa̱bo̱ xuajen Israél ñajúu̱n. <verse eid="ROM 9:6" /><verse number="7" style="v" sid="ROM 9:7" />Ni máꞌ ra̱ꞌkhá mbá xúgíin xa̱bo̱ ri̱jyu̱u̱ꞌ Abraám, phú gakon rí i̱ji̱in Abraám ñajúu̱n. Numuu rí waꞌtháa̱n neꞌne Ana̱ꞌlóꞌ: «Ga̱jma̱á majñu̱u̱ Isaák ma̱gu̱mii xa̱bo̱ ri̱jya̱a̱ꞌ».<note caller="+" style="f"><char style="fr" closed="false">9.7 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ xó ni̱gi̱ꞌdu̱u̱n-muu 21.12.</char></note> <verse eid="ROM 9:7" /><verse number="8" style="v" sid="ROM 9:8" />Rúꞌkhue̱n iꞌthán rí ra̱ꞌkhá mbá xúgíin xa̱bo̱ ri̱jyu̱u̱ꞌ Abraám ñajúún i̱ji̱in Ana̱ꞌlóꞌ, rí i̱ji̱in Ana̱ꞌlóꞌ ñajúún tsí ni̱gu̱mii xómá nixuda-mina̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxu̱u̱ Abraám. <verse eid="ROM 9:8" /><verse number="9" style="v" sid="ROM 9:9" />Numuu rí xáꞌnii nixuda-mina̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxu̱u̱ Abraám: «Ma̱thangu̱ún gáya̱a̱ꞌlo̱ꞌ xíríga̱a̱ rí i̱mba̱ tsígu. A̱ꞌkhue̱n rí Sára̱ gíꞌdaa̱ máꞌ mbáa ada̱ gáꞌne».<note caller="+" style="f"><char style="fr" closed="false">9.9 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ xó ni̱gi̱ꞌdu̱u̱n-muu 18.10, 14.</char></note><verse eid="ROM 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10" />Jamí ra̱ꞌkhá i̱ndo̱ó rúꞌkhue̱n, rí mangaa máꞌ Rebéka̱ ni̱gi̱ꞌdiin a̱jmi̱i e̱je̱n, i̱ji̱in táta̱-xi̱ꞌñáxo̱ꞌ Isaák. <verse eid="ROM 9:10" /><verse number="11" style="v" sid="ROM 9:11" />Nákhí rí xóó tágu̱mii e̱je̱n, xóó máꞌ tsíkujma xí muni̱i̱ rí máján o rí ra̱máján mbo̱ꞌ. I̱ndo̱ó máꞌ numuu rí mbu̱ꞌyáá májánlóꞌ rí Ana̱ꞌlóꞌ tsíraꞌwíin xa̱bo̱ ga̱jma̱á numuu rí nuni̱i̱, rí ga̱jma̱á numuu rí ikhaa̱ máꞌ nandoo̱, <verse eid="ROM 9:11" /><verse number="12" style="v" sid="ROM 9:12" />ikhaa jngó Ana̱ꞌlóꞌ niꞌthúun Rebéka̱: «Tsí ginii ma̱gu̱maa mayumbáá inuu tsí ma̱gu̱maa nda̱wa̱á».<note caller="+" style="f"><char style="fr" closed="false">9.12 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ xó ni̱gi̱ꞌdu̱u̱n-muu 25.23.</char></note> <verse eid="ROM 9:12" /><verse number="13" style="v" sid="ROM 9:13" />Xómá ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ: «Ndiyoꞌ ja̱yo̱o̱ Jakób. Xómáꞌ Esaú, ra̱khóꞌ ja̱yo̱o̱».<note caller="+" style="f"><char style="fr" closed="false">9.13 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Malakía̱s 1.2-3.</char></note><verse eid="ROM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14" />Dí gúꞌthánlóꞌ xúꞌkhue̱n rá. Á mu̱ꞌthánlóꞌ rí ra̱máján eꞌne Ana̱ꞌlóꞌ rá. ¡Na̱nguá mbá jayu! <verse eid="ROM 9:14" /><verse number="15" style="v" sid="ROM 9:15" />Numuu rí Ana̱ꞌlóꞌ niꞌthúun Moisés: «Ma̱ñáwíin a̱kui̱nꞌ ja̱yo̱o̱ tsí nandoꞌ rí ma̱ñáwíin a̱kui̱nꞌ ja̱yo̱o̱, jamí ma̱ne̱ mba̱a̱ a̱kui̱nꞌ ja̱yo̱o̱ tsí nandoꞌ rí ma̱ne̱ mba̱a̱ a̱kui̱nꞌ ja̱yo̱o̱».<note caller="+" style="f"><char style="fr" closed="false">9.15 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ xó nigájna̱á xa̱bo̱ 33.19.</char></note><verse eid="ROM 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 9:16" />Ikhaa jngó, Ana̱ꞌlóꞌ naraꞌwíi̱ tsí ikhaa̱ nañáwíin a̱kuii̱n jaꞌyoo̱, ra̱ꞌkhá numuu rí mbáa xa̱bo̱ nandoo o naxná-mina̱ꞌ tsiakhe̱ kajngó mi̱traꞌwíi gáꞌne Ana̱ꞌlóꞌ. <verse eid="ROM 9:16" /><verse number="17" style="v" sid="ROM 9:17" />Ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ ka̱ma naꞌthán rí Ana̱ꞌlóꞌ niꞌthúun thúngaa Faraón: «Ikhaa máꞌ numuu ríge̱ꞌ ni̱ꞌgíínlo̱ꞌ rí ma̱ra̱tha̱n-ñájun, kajngó ma̱snga̱jmá ski̱yu̱ꞌ ga̱jma̱á nindxa̱a̱ꞌ ikháánꞌ, jamí ma̱gu̱ma-nuwúún ná tsu̱du̱u̱ mbá xúgíí numbaa».<note caller="+" style="f"><char style="fr" closed="false">9.17 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ xó nigájna̱á xa̱bo̱ 9.16.</char></note> <verse eid="ROM 9:17" /><verse number="18" style="v" sid="ROM 9:18" />Ikhaa jngó, Ana̱ꞌlóꞌ nañáwíin a̱kuii̱n jaꞌyoo̱ tsí nandoo̱ rí ma̱ñáwíin a̱kuii̱n jaꞌyoo̱, jamí naꞌne-gúkuíi̱ a̱kui̱in tsí nandoo̱ rí ma̱ꞌne-gúkuíi̱ a̱kui̱in.<verse eid="ROM 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19" />Xómáꞌ ikháánꞌ ma̱tra̱xu̱ꞌ: «Náá numuu kajngó naꞌthán Ana̱ꞌlóꞌ rí gíꞌmáálóꞌ aꞌkhán, xí nimbáa tsíꞌngo̱o̱ gáwe̱je̱-ꞌthu̱u̱n rí ma̱ꞌnii̱ rí nandoo̱ róꞌ». <verse eid="ROM 9:19" /><verse number="20" style="v" sid="ROM 9:20" />Jamí ikhúúnꞌ ma̱riꞌñaaꞌ: «Tsáa najwaanꞌ ikháánꞌ kajngó ma̱tra̱xi̱í Ana̱ꞌlóꞌ ga̱jma̱á numuu rí naꞌne róꞌ». Xa̱bo̱ tsí naꞌne daan ju̱ba̱ꞌ na̱nguá nitraxíi̱ eꞌne daan: «Náá numuu kajngó xáꞌnii nithane̱-ku̱múú róꞌ».<note caller="+" style="f"><char style="fr" closed="false">9.20 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 29.16.</char></note> <verse eid="ROM 9:20" /><verse number="21" style="v" sid="ROM 9:21" />Xa̱bo̱ tsí naꞌne daan ju̱ba̱ꞌ gíꞌdoo̱ tsiakhe̱ rí ma̱ꞌnii̱ asndo dí máꞌ iyoo̱ ga̱jma̱á mbóó ikhaa máꞌ ju̱ba̱ꞌ. Ikhaa máꞌ ju̱ba̱ꞌ ma̱goo ma̱ꞌnii̱ mbá daan rí gíꞌdoo guéño numuu o ma̱ꞌnii̱ mbá daan rí na̱nguá máꞌ gíꞌdoo numuu mbo̱ꞌ.<verse eid="ROM 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22" />Maske máꞌ Ana̱ꞌlóꞌ ndiyoo̱ maxnée̱ mbá xkri̱doo rí najiꞌnáa̱ jamí masngájmee̱ ski̱yu̱u̱ꞌ, phú neꞌne mba̱a̱ a̱kuii̱n jaꞌñúu̱ tsí wéje̱ máꞌ rí mu̱drígú jamínu̱ꞌ jamí ma̱mbíin. <verse eid="ROM 9:22" /><verse number="23" style="v" sid="ROM 9:23" />Xkuaꞌnii neꞌne Ana̱ꞌlóꞌ kajngó masngájmee̱ rí ikhaa̱ phú mba̱a̱ ski̱yu̱u̱ꞌ ga̱jma̱á nindxu̱ún tsí niñáwíin a̱kuii̱n jaꞌñúu̱, ikhiin máꞌ tsí asndo nákhí ginii neꞌne-ku̱mii̱ rí ma̱ju̱wá ga̱jma̱á nindxu̱u̱ ná phú tsímáá. <verse eid="ROM 9:23" /><verse number="24" style="v" sid="ROM 9:24" />Ikhiin xa̱bo̱ tsúꞌkhue̱n ñajwanlóꞌ ikháánꞌlóꞌ, tsáanꞌ nindxaꞌwálóꞌ Ana̱ꞌlóꞌ. Jamí ra̱ꞌkhá máꞌ i̱ndo̱ó ikháanꞌxo̱ꞌ tsáanꞌ xa̱bo̱ judío̱ ñajwanxo̱ꞌ, rí mangaa máꞌ xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún. <verse eid="ROM 9:24" /><verse number="25" style="v" sid="ROM 9:25" />Xómá ka̱ma niꞌthán Ana̱ꞌlóꞌ ná i̱yu̱u̱ꞌ Oséa̱s mangaa:</para>
  <para style="q" vid="ROM 9:25">«Ma̱thu̱ún xa̱bo̱ tsí ra̱ꞌkháa xa̱bo̱ xuajñuꞌ ñajúún, “xa̱bo̱ xuajñuꞌ”,</para>
  <para style="q" vid="ROM 9:25">Jamí ma̱thu̱u̱n a̱ꞌgo̱ tsí ra̱ꞌkháa a̱ꞌgui̱ꞌ ñajuun, “a̱ꞌgo̱ tsí nandoꞌ ja̱yo̱o̱”».<note caller="+" style="f"><char style="fr" closed="false">9.25 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Oséa̱s 2.23.</char></note><verse eid="ROM 9:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="ROM 9:26" />Jamí xúꞌkhue̱n máꞌ niꞌthán Ana̱ꞌlóꞌ mangaa:</para>
  <para style="q" vid="ROM 9:26">«Ikhín ná waꞌthúún xa̱bo̱, “Ra̱ꞌkhá xa̱bo̱ xuajñuꞌ ñajwanlaꞌ ikháanꞌlaꞌ”,</para>
  <para style="q" vid="ROM 9:26">ikhín máꞌ mi̱ꞌthúu̱n, “Ikháanꞌlaꞌ ñajwanlaꞌ i̱ji̱in Ana̱ꞌlóꞌ tsí xtáa ndaꞌya”».<note caller="+" style="f"><char style="fr" closed="false">9.26 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Oséa̱s 1.10.</char></note><verse eid="ROM 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 9:27" />Xómáꞌ Isaía̱s naꞌthán ga̱jma̱á numuu xuajen Israél:</para>
  <para style="q" vid="ROM 9:27">«Maske máꞌ phú mbaꞌiin mi̱ndaꞌkho i̱ji̱in Israél xómá we̱ꞌe̱ rí ríga̱ ná rawuun iya a̱pha̱,</para>
  <para style="q" vid="ROM 9:27">i̱ndo̱ó máꞌ mbá tikhuun jayu tsí ma̱jáwíin.<verse eid="ROM 9:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ROM 9:28" />Numuu rí Táta̱ ma̱ꞌne-mbánuu ajngóo</para>
  <para style="q" vid="ROM 9:28">mbá nacha̱ jayu ná tsu̱du̱u̱ mbá xúgíí numbaa».<note caller="+" style="f"><char style="fr" closed="false">9.28 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 10.22-23.</char></note><verse eid="ROM 9:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="ROM 9:29" />Xómá niꞌthán Isaía̱s nákhí wapha:</para>
  <para style="q" vid="ROM 9:29">«Xí ra̱ꞌkhá numuu rí Táta̱ tsí gíꞌdoo mbá xúgíí tsiakhe̱ niniñúú mbá tikhuun i̱jña̱ꞌlóꞌ,</para>
  <para style="q" vid="ROM 9:29">xómá xuajen Sodóma̱ jamí xuajen Gomóra̱ jaꞌñáaꞌlóꞌ gáꞌne».<note caller="+" style="f"><char style="fr" closed="false">9.29 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 1.9.</char></note><verse eid="ROM 9:29" /></para>
  <para style="s">Tánimbu̱únꞌ xa̱bo̱ Israél juyáá Krísto̱</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30" />Dí gúꞌthánlóꞌ xúꞌkhue̱n rá. Maske máꞌ xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, na̱nguá ndiꞌyée̱ rí Ana̱ꞌlóꞌ maꞌthán rí nánda̱a̱ aꞌkhúu̱n, ikhii̱n naꞌthán Ana̱ꞌlóꞌ rí nánda̱a̱ aꞌkhúu̱n ga̱jma̱á numuu rí wéje̱ a̱kuíi̱n ná inuu Ana̱ꞌlóꞌ. <verse eid="ROM 9:30" /><verse number="31" style="v" sid="ROM 9:31" />Xómáꞌ xa̱bo̱ xuajen Israél rá, maske máꞌ ndiꞌyée̱ rí Ana̱ꞌlóꞌ maꞌthán rí nánda̱a̱ aꞌkhúu̱n ga̱jma̱á majñu̱u̱ xtángoo, táꞌngúu̱n gúne̱-mbáníi̱ ne̱. <verse eid="ROM 9:31" /><verse number="32" style="v" sid="ROM 9:32" />Náá numuu róꞌ. Numuu túꞌyée̱ rí Ana̱ꞌlóꞌ maꞌthán rí nánda̱a̱ aꞌkhúu̱n ga̱jma̱á majñu̱u̱ rí wéje̱ a̱kuíi̱n ná inuu Ana̱ꞌlóꞌ, rí ndiꞌyée̱ ne̱ ga̱jma̱á majñu̱u̱ rí nune̱-mbáníi̱ rí naꞌthán xtángoo. Ikhaa jngó ni̱xi̱ꞌnée̱ ná tsu̱du̱u̱ itsí rí naꞌne rí mu̱xi̱ꞌná xa̱bo̱. <verse eid="ROM 9:32" /><verse number="33" style="v" sid="ROM 9:33" />Xómá ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="q" vid="ROM 9:33">«Ikhúúnꞌ na̱ꞌgíi ná xuajen Sióón mbáa tsí xómá itsí jaꞌnii,</para>
  <para style="q" vid="ROM 9:33">tsí naꞌne rí mu̱xi̱ꞌná jamí ma̱xpátrigi̱in xa̱bo̱.</para>
  <para style="q" vid="ROM 9:33">Xómáꞌ tsí ma̱nimbo̱o̱ꞌ jaꞌyoo̱ ikhaa̱, ma̱xáthájwíin a̱kuii̱n».<note caller="+" style="f"><char style="fr" closed="false">9.33 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 8.14 jamí ná 28.16.</char></note><verse eid="ROM 9:33" /></para>
  <chapter eid="ROM 9" />
  <chapter number="10" style="c" sid="ROM 10" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1" />A̱ngui̱nꞌ, phú naꞌne a̱kui̱nꞌ jamí na̱tha̱n-jáñuu Ana̱ꞌlóꞌ, rí ma̱jáwíin mbá xúgíin xa̱bo̱ Israél. <verse eid="ROM 10:1" /><verse number="2" style="v" sid="ROM 10:2" />Ikhúúnꞌ na̱tha̱n mbá rí máján ga̱jma̱á numúu̱: phú naꞌne máꞌ a̱kuíi̱n rí mune̱-mba̱a̱ Ana̱ꞌlóꞌ, i̱ndo̱ó máꞌ numuu rí tsífruꞌúu̱n xáne gúne̱-mba̱a̱. <verse eid="ROM 10:2" /><verse number="3" style="v" sid="ROM 10:3" />Numuu rí tsíyáa̱ rí i̱ndo̱ó máꞌ Ana̱ꞌlóꞌ ñajuun tsí naꞌthán xí nánda̱a̱ aꞌkhúún xa̱bo̱, ikhaa jngó ikhii̱n nuxna-mijnée̱ tsiakhe̱ kajngó maꞌthán Ana̱ꞌlóꞌ rí nánda̱a̱ aꞌkhúu̱n, jamí tsídri̱guíi̱ awan rí niꞌgí Ana̱ꞌlóꞌ. <verse eid="ROM 10:3" /><verse number="4" style="v" sid="ROM 10:4" />Numuu rí mbá xúgíí xtángoo ni̱gu̱ma-mbáníí ga̱jma̱á nindxu̱u̱ Krísto̱, kajngó maꞌthán Ana̱ꞌlóꞌ rí nánda̱a̱ aꞌkhúun jámba̱a̱ tsí nanimbo̱o̱ꞌ jaꞌyoo Krísto̱.<verse eid="ROM 10:4" /></para>
  <para style="s">Mbá xúgíin xa̱bo̱ ma̱goo ma̱jáwíin</para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5" />Xáꞌnii niꞌtháán Moisés ga̱jma̱á numuu xa̱bo̱ tsí ma̱ꞌne nánda̱a̱ aꞌkhúun ga̱jma̱á majñu̱u̱ xtángoo: «Xa̱bo̱ tsí naꞌne-mbánuu mbá xúgíí xtángoo, ma̱xtáa̱ mba̱ꞌyee̱ ga̱jma̱á numuu ne̱».<note caller="+" style="f"><char style="fr" closed="false">10.5 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yi̱i̱ꞌ rí naꞌthán ga̱jma̱á numúú xa̱bi̱i Lebí 18.5.</char></note> <verse eid="ROM 10:5" /><verse number="6" style="v" sid="ROM 10:6" />Xómáꞌ ga̱jma̱á numuu rí nánda̱a̱ aꞌkhúun tsí wéje̱ a̱kui̱in ná inuu Ana̱ꞌlóꞌ rá, xáꞌnii ka̱ma naꞌthán: «Ma̱xára̱tha̱n ná awúun a̱kia̱anꞌ: “Tsáa gátsimuu mikhuíí róꞌ”, (kajngó ma̱ꞌkha̱ jayáa̱ Krísto̱ ge̱jyoꞌ). <verse eid="ROM 10:6" /><verse number="7" style="v" sid="ROM 10:7" />Ni máꞌ ma̱xára̱tha̱n: “Tsáa gága̱taa ná numbaa rí gachúún wa̱jen róꞌ”, (kajngó ma̱ꞌnii̱ rí ma̱ga̱jnáa Krísto̱ ná gatiin tsí nijáñúú)». <verse eid="ROM 10:7" /><verse number="8" style="v" sid="ROM 10:8" />Dí iꞌthée̱n xúꞌkhue̱n rá. «Mijngi máꞌ ríga̱ ajngáa ga̱jma̱á nindxa̱a̱ꞌ, ná rawaanꞌ jamí ná awúun a̱kia̱anꞌ».<note caller="+" style="f"><char style="fr" closed="false">10.6-8 </char><char style="ft" closed="false">Mbá tikhu ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yi̱i̱ꞌ rí naꞌthán ikhaa máꞌ xtángoo 30.12-14.</char></note> Ikhaa ríge̱ꞌ ñajuun ajngáa rí nu̱tha̱n-ráꞌaxo̱ꞌ, rí ma̱we̱je̱ a̱kia̱nꞌlóꞌ ná inuu Ana̱ꞌlóꞌ. <verse eid="ROM 10:8" /><verse number="9" style="v" sid="ROM 10:9" />Xí ga̱jma̱á rawaanꞌ narathán-jmbaaꞌ rí Jesús ñajuun Táta̱ tsí naꞌthán-ñájun, jamí ga̱jma̱á a̱kia̱anꞌ nanimba̱a̱ꞌ rí Ana̱ꞌlóꞌ neꞌne rí mbayáa̱ mbiꞌyuu̱, a̱ꞌkhue̱n rí ma̱jríñáaꞌ. <verse eid="ROM 10:9" /><verse number="10" style="v" sid="ROM 10:10" />Numuu rí ga̱jma̱á a̱kia̱anꞌ gíꞌmaa rí ma̱nimba̱a̱ꞌ kajngó maꞌthán Ana̱ꞌlóꞌ rí nánda̱a̱ aꞌkháanꞌ, jamí ga̱jma̱á rawaanꞌ gíꞌmaa rí ma̱ra̱tha̱n jmbaaꞌ rí nanimba̱a̱ꞌ xtayáa̱ kajngó ma̱jríñáaꞌ.<verse eid="ROM 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 10:11" />Numuu rí xáꞌnii ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ: «Jámba̱a̱ tsí nanimbo̱o̱ꞌ jaꞌyoo̱ ikhaa̱, ma̱xáthájwíin a̱kuii̱n».<note caller="+" style="f"><char style="fr" closed="false">10.11 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 28.16.</char></note> <verse eid="ROM 10:11" /><verse number="12" style="v" sid="ROM 10:12" />Numuu rí nda̱a̱ máꞌ rí kriꞌkhuiin xa̱bo̱ judío̱ gajmíí xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, numuu rí mbáwíi máꞌ Táta̱ tsí naꞌthán-ñájwanlóꞌ mbá xúgiáanꞌlóꞌ. Ikhaa̱ maphú mba̱a̱ naꞌne-tsakun-rámii̱ mbá xúgíin tsí nu̱xríga̱á mbiꞌyuu̱. <verse eid="ROM 10:12" /><verse number="13" style="v" sid="ROM 10:13" />Numuu rí jámba̱a̱ tsí naxrígo̱o̱ mbiꞌyuu Táta̱, ma̱jríya̱a̱ꞌ.<verse eid="ROM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14" />Xáne gúxri̱gáa̱ mbiꞌyuu tsí tánimbúu̱n juyáa̱ rá. Xáne gánimbúu̱n juyáa̱ tsí túdxawíi̱n ga̱jma̱á numuu rá. Xáne gúdxawíi̱n xí ndawa̱a̱ tsí maꞌthán-rúꞌúu̱n rá. <verse eid="ROM 10:14" /><verse number="15" style="v" sid="ROM 10:15" />Jamí xáne gúthan-raꞌee̱ xí ndawa̱a̱ tsí ixúnguii̱nꞌ rá. Xómá ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ: «¡Rí maphú mitsaan ído̱ rí naguáꞌnú tsí naguwá juñu̱ú ajngáa rí tsímáá, ikhiin máꞌ tsí nuthan-raꞌa ajngáa máján!».<note caller="+" style="f"><char style="fr" closed="false">10.15 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 52.7.</char></note><verse eid="ROM 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 10:16" />I̱ndo̱ó máꞌ numuu rí ra̱ꞌkhá mbá xúgíi̱n ni̱dri̱guíi̱ ajngáa máján. Xómá niꞌthán Isaía̱s: «Táta̱, tsáa ninimbo̱o̱ꞌ ajngáa rí ni̱tha̱n-ráꞌaxo̱ꞌ róꞌ».<note caller="+" style="f"><char style="fr" closed="false">10.16 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 53.1.</char></note> <verse eid="ROM 10:16" /><verse number="17" style="v" sid="ROM 10:17" />Ikhaa jngó, ndaꞌyóo rí mu̱dxawíín xa̱bo̱ ajngóo Ana̱ꞌlóꞌ,<note caller="+" style="f"><char style="fr" closed="false">10.17 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán: «ndaꞌyóo rí mu̱dxawíín xa̱bo̱ ajngáa máján ga̱jma̱á numuu Krísto̱».</char></note> a̱ꞌkhue̱n rí ma̱goo ma̱we̱je̱ a̱kuíi̱n ná inuu̱. <verse eid="ROM 10:17" /><verse number="18" style="v" sid="ROM 10:18" />Xómáꞌ ikhúúnꞌ na̱ra̱xe̱lo̱ꞌ: Á gakon rí xóó túdxawíi̱n rá. Phú gakon rí ni̱dxawíi̱n máꞌ. Xómá ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="q" vid="ROM 10:18">«Mbá xúgíí tsu̱du̱u̱ ju̱ba̱ꞌ niwán a̱ꞌwúu̱n,</para>
  <para style="q" vid="ROM 10:18">jamí asndo mbá xúgíí rawuun numbaa ni̱ga̱nú ajngúu̱n».<note caller="+" style="f"><char style="fr" closed="false">10.18 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 19.4.</char></note><verse eid="ROM 10:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="ROM 10:19" />Jamí na̱ra̱xe̱ mbu̱júꞌ: Á táfruꞌu̱ún ríge̱ꞌ xa̱bo̱ Israél rá. Rí ginii jayu, Moisés niꞌtháa̱n rí waꞌtháa̱n neꞌne Ana̱ꞌlóꞌ:</para>
  <para style="q" vid="ROM 10:19">«Ikhúúnꞌ ma̱ne̱ rí ma̱xíya̱ꞌlaꞌ gúne̱ mbá xuajiin xa̱bo̱ tsí na̱nguá gíꞌdoo numúú,</para>
  <para style="q" vid="ROM 10:19">jamí ma̱ne̱ rí ma̱jiꞌnáaꞌlaꞌ gúne̱ mbá xuajiin xa̱bo̱ tsí tsífruꞌu̱ún».<note caller="+" style="f"><char style="fr" closed="false">10.19 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yi̱i̱ꞌ rí naꞌthán ikhaa máꞌ xtángoo 32.21.</char></note><verse eid="ROM 10:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="ROM 10:20" />Xómáꞌ Isaía̱s ni̱ꞌngo̱o̱ a̱kui̱in niꞌthán ajngáa rí niꞌthán máꞌ Ana̱ꞌlóꞌ:</para>
  <para style="q" vid="ROM 10:20">«Ikhiin xa̱bo̱ tsí na̱nguá i̱ꞌñúú, ni̱xkamúú,</para>
  <para style="q" vid="ROM 10:20">jamí ni̱snga̱jmá-mina̱ꞌ inúú xa̱bo̱ tsí na̱nguá i̱ra̱xe̱ numuꞌ».<note caller="+" style="f"><char style="fr" closed="false">10.20 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 65.1.</char></note><verse eid="ROM 10:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 10:21" />Xómáꞌ ga̱jma̱á numúú xa̱bo̱ Israél, xáꞌnii niꞌthán Ana̱ꞌlóꞌ:</para>
  <para style="q" vid="ROM 10:21">«Jañii mbiꞌi ni̱tsriya̱ꞌ ñawúnꞌ</para>
  <para style="q" vid="ROM 10:21">rí ma̱mbáñúú xa̱bo̱ tsí najñaguun jamí tsínimbu̱únꞌ».<note caller="+" style="f"><char style="fr" closed="false">10.21 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 65.2.</char></note><verse eid="ROM 10:21" /></para>
  <chapter eid="ROM 10" />
  <chapter number="11" style="c" sid="ROM 11" />
  <para style="s">Ana̱ꞌlóꞌ tániñúú xa̱bo̱ xuajñuu</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1" />Ikhaa numuu rúꞌkhue̱n, na̱ra̱xe̱lo̱ꞌ: Á neꞌne-janíí-mina̱ꞌ Ana̱ꞌlóꞌ inúú xa̱bo̱ xuajñuu rá. ¡Na̱nguá mbá jayu! Numuu rí mangúúnꞌ máꞌ ñajunꞌ xa̱bo̱ Israél. A̱ꞌdá-xíñu-egoo Abraám, jamí xa̱bo̱ ri̱jyu̱u̱ꞌ Benjamín ñajunꞌlo̱ꞌ. <verse eid="ROM 11:1" /><verse number="2" style="v" sid="ROM 11:2" />Tániñúú Ana̱ꞌlóꞌ xa̱bo̱ xuajen Israél, xuajñuu̱ rí niraꞌwíi̱ asndo nákhí ginii jayu. Á tsíya̱álaꞌ rí ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ ga̱jma̱á numuu Elía̱s dxe̱ꞌ, rí neꞌne xkujndii̱ ná inuu Ana̱ꞌlóꞌ ga̱jma̱á numuu rí nune̱ xa̱bo̱ Israél. Xáꞌnii niꞌthée̱n: <verse eid="ROM 11:2" /><verse number="3" style="v" sid="ROM 11:3" />«Táta̱, ni̱radíi̱n xa̱bia̱aꞌ tsí nu̱rawíjnga̱a ajngáaꞌ, jamí ni̱rngáxi̱i̱ itsí ja̱rngo̱xe̱ dríga̱a̱ꞌ ná nakha tsi̱gi̱jña̱ꞌ. I̱ndo̱ó máꞌ ikhúúnꞌ xóó xtáá nda̱ya̱lo̱ꞌ, jamí nandúu̱n gúxíñúu̱ mangúúnꞌ».<note caller="+" style="f"><char style="fr" closed="false">11.3 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná Timbá i̱yi̱i̱ꞌ ga̱jma̱á numúú thúngaa 19.10, 14.</char></note> <verse eid="ROM 11:3" /><verse number="4" style="v" sid="ROM 11:4" />Jamí xáne niriꞌña Ana̱ꞌlóꞌ rá. Xáꞌnii niꞌthán Ana̱ꞌlóꞌ, niꞌthúu̱n Elía̱s: «Xóó máꞌ gúꞌdiin mbá juwan míl (7 000) xa̱bekha tsí túsmáti̱gu̱ún ná inuu Ba̱ál».<note caller="+" style="f"><char style="fr" closed="false">11.4 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná Timbá i̱yi̱i̱ꞌ ga̱jma̱á numúú thúngaa 19.18.</char></note> <verse eid="ROM 11:4" /><verse number="5" style="v" sid="ROM 11:5" />Xkuaꞌnii máꞌ xúge̱ꞌ mangaa, xóó júwa̱ꞌ mbá tikhuun tsí niraꞌwíin Ana̱ꞌlóꞌ ga̱jma̱á numuu rí phú májáan a̱kuii̱n jaꞌñúu̱. <verse eid="ROM 11:5" /><verse number="6" style="v" sid="ROM 11:6" />Xí Ana̱ꞌlóꞌ niraꞌwíin tsíge̱ꞌ ga̱jma̱á numuu rí phú májáan a̱kuii̱n jaꞌñúu̱, ra̱ꞌkhá máꞌ ga̱jma̱á numuu ñajun rí nuni̱i̱ xúꞌkhue̱n rá. Jamí xí watraꞌwíi̱n ga̱jma̱á numuu ñajun rí nuni̱i̱, ra̱ꞌkhá máꞌ numuu rí májáan a̱kui̱in Ana̱ꞌlóꞌ jaꞌñúu̱ xúꞌkhue̱n rá.<verse eid="ROM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7" />Dí gúꞌthánlóꞌ xúꞌkhue̱n rá. Rí xa̱bo̱ Israél túxkamaa̱ rí nduꞌyée̱. Xómáꞌ tsí niraꞌwíin Ana̱ꞌlóꞌ rá, ni̱xkamaa̱ ne̱. Jamí tsí i̱ꞌwíin rá, ni̱gu̱ma-gúkú a̱kuíi̱n. <verse eid="ROM 11:7" /><verse number="8" style="v" sid="ROM 11:8" />Xómá ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="q" vid="ROM 11:8">«Ana̱ꞌlóꞌ neꞌne gúkú a̱kuíi̱n kajngó ma̱xáju̱múu̱,</para>
  <para style="q" vid="ROM 11:8">jamí xkuaꞌnii jaꞌñúu̱ asndo xúge̱ꞌ.</para>
  <para style="q" vid="ROM 11:8">Ana̱ꞌlóꞌ nirogoo idúu̱n jamí nirogoo ñaꞌwúu̱n</para>
  <para style="q" vid="ROM 11:8">kajngó ma̱xáfrigúu̱n, ni máꞌ mu̱xúdxawíi̱n».<note caller="+" style="f"><char style="fr" closed="false">11.8 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 29.10, jamí ná I̱yi̱i̱ꞌ rí naꞌthán ikhaa máꞌ xtángoo 29.4.</char></note><verse eid="ROM 11:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="ROM 11:9" />Jamí thúngaa Dabíd mangaa niꞌthán:</para>
  <para style="q" vid="ROM 11:9">«Ga̱ꞌni̱i xómá géjwa̱nꞌ jamí tsáꞌkhán ndxa̱a̱ rí nuni̱i̱.</para>
  <para style="q" vid="ROM 11:9">Ga̱duáꞌíi̱n ikhín jamí gu̱dríguíi̱ jamínu̱ꞌ rí jaꞌñúu̱.<verse eid="ROM 11:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ROM 11:10" />Ga̱ju̱góo idúu̱n kajngó ma̱xáfrigúu̱n,</para>
  <para style="q" vid="ROM 11:10">jamí ga̱ꞌne nde̱tse̱ tsu̱dúu̱n jámba̱ miꞌtsú».<note caller="+" style="f"><char style="fr" closed="false">11.10 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 69.22-23.</char></note><verse eid="ROM 11:10" /></para>
  <para style="s">Nandoo najáwíin xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún</para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11" />Kajngó na̱ra̱xe̱lo̱ꞌ: Á nixpátri̱gi̱in xa̱bo̱ Israél rí asndo náxáwáxúu̱nꞌ rá. ¡Na̱nguá mbá jayu! A̱ꞌkhue̱n gakon, ga̱jma̱á numuu rí ikhii̱n nijñaguu̱n, a̱ꞌkhue̱n ndiyoo nijáwíin xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún. Rúꞌkhue̱n ma̱ꞌne rí ma̱xígu̱únꞌ xa̱bo̱ Israél juñúu̱. <verse eid="ROM 11:11" /><verse number="12" style="v" sid="ROM 11:12" />Xí ga̱jma̱á numuu rí nijñaguu̱n phú mba̱a̱ ni̱gu̱ma-tsakun-rámii xa̱bi̱i numbaa, jamí xí ga̱jma̱á numuu rí ni̱ngra̱ꞌii̱n phú mba̱a̱ nimbáñúú xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, á ra̱ꞌkhá phú i̱tha̱án mba̱a̱ ma̱gu̱ma-tsakun-rámii xa̱bi̱i numbaa ído̱ rí xa̱bo̱ judío̱ ma̱ꞌne jañii a̱kui̱ín mbu̱júꞌ juyáá Ana̱ꞌlóꞌ rá.<verse eid="ROM 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13" />Ikháanꞌlaꞌ i̱tha̱nꞌlaꞌ, tsáanꞌ ra̱ꞌkháa xa̱bo̱ judío̱ ñajwanlaꞌ. Numuu rí ikhúúnꞌ ñajunꞌ tsí waxúngua̱a̱ꞌ ná júwa̱ꞌ xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, ikhaa jngó ikhúúnꞌ nda̱yo̱o̱ rí phú gíꞌdoo numuu ñajun rí na̱ne̱lo̱ꞌ. <verse eid="ROM 11:13" /><verse number="14" style="v" sid="ROM 11:14" />Á gáꞌne xí ga̱jma̱á numuu ríge̱ꞌ, ma̱ne̱ rí ma̱xígu̱únꞌ xa̱bo̱ xuajñuꞌ, jamí ma̱goo ma̱jáwíi̱n mbá tikhuu̱n. <verse eid="ROM 11:14" /><verse number="15" style="v" sid="ROM 11:15" />Xí ga̱jma̱á numuu rí ninguanúú janíí xa̱bo̱ Israél, a̱ꞌkhue̱n nimbáxi̱iꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxu̱ún xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, dí gáríga̱ ído̱ rí Ana̱ꞌlóꞌ ma̱grui̱gúu̱n xúꞌkhue̱n rá. Tsí júwa̱ꞌ asndo xó rí nijáñúú xúge̱ꞌ, ma̱ju̱wée̱ꞌ jámuu. <verse eid="ROM 11:15" /><verse number="16" style="v" sid="ROM 11:16" />Xí ñu̱u̱ rí na̱gu̱ma guma ginii kixnáxe̱ ná inuu Ana̱ꞌlóꞌ, mangaa máꞌ kixnáxe̱ ná inuu̱ mbá xúgíí ñu̱u̱. Xí ajmu̱u̱ ixe̱ kixnáxe̱ ná inuu Ana̱ꞌlóꞌ, mangaa máꞌ kixnáxe̱ ná inuu̱ ñawúun ne̱.<verse eid="ROM 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 11:17" />Gakon máꞌ rí nithon-ri̱ya̱ꞌ mbá tikhu ñawúun ixe̱ olíbo̱ máján, rí ñajúún xa̱bo̱ judío̱. A̱ꞌkhue̱n rí ikháánꞌ tsáánꞌ ra̱ꞌkháa xa̱bo̱ judío̱ ñajwaanꞌ jamí xómá ixe̱ olíbo̱ xáná jaꞌníí, nikhuáꞌáánꞌ ná nithon-ri̱ya̱ꞌ ne̱. Kajngó xúge̱ꞌ rá, ndayá mbiꞌyaaꞌ ga̱jma̱á ski̱yu̱u̱ꞌ ajmu̱u̱ ixe̱ olíbo̱ rí máján. <verse eid="ROM 11:17" /><verse number="18" style="v" sid="ROM 11:18" />I̱ndo̱ó máꞌ numuu rí ma̱xáju̱ma̱a̱ꞌ lá rí ikháánꞌ phú i̱tha̱án gíꞌdoo numaaꞌ xó rí ñawúun ixe̱ olíbo̱ máján. Xí natakúxe̱-mina̱ꞌ, athayáá lá rí ra̱ꞌkhá ga̱jma̱á numaaꞌ ikháánꞌ ndaꞌya ajmu̱u̱ ixe̱ olíbo̱ rí máján, rí ga̱jma̱á numuu ne̱ ikhaa xtaa nathaya ikháánꞌ.<verse eid="ROM 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 11:19" />Á gáꞌne xí ma̱ra̱tha̱n: «Nithon-ri̱ya̱ꞌ mbá tikhu ñawúun ne̱ kajngó ma̱khúꞌwúún ikhúúnꞌ ná ixe̱». <verse eid="ROM 11:19" /><verse number="20" style="v" sid="ROM 11:20" />Gakon máꞌ rí xkuaꞌnii. I̱ndo̱ó máꞌ numuu rí ikhii̱n nithon-ri̱ñii̱ꞌ ga̱jma̱á numuu rí táwe̱je̱ a̱kuíi̱n ná inuu Ana̱ꞌlóꞌ. Xómáꞌ ikháánꞌ, nikhuáꞌáánꞌ ná ixe̱ ga̱jma̱á numuu rí wéje̱ a̱kia̱anꞌ ná inuu Ana̱ꞌlóꞌ. Ikhaa jngó, ma̱xáta̱ku̱xí-mina̱ꞌ, rí xawi lá gátha̱ne̱. <verse eid="ROM 11:20" /><verse number="21" style="v" sid="ROM 11:21" />Xí Ana̱ꞌlóꞌ táꞌne mba̱a̱ a̱kui̱in jaꞌyoo ñawúun ixe̱ rí phú ikhaa, ma̱xáꞌne mba̱a̱ a̱kuii̱n máꞌ jaꞌyaa̱ꞌ ikháánꞌ mangaa.<verse eid="ROM 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 11:22" />Atiaxe̱ ma̱tha̱ya̱á rí phú májáan a̱kui̱in Ana̱ꞌlóꞌ, jamí phú mikoo ajngóo̱ mangaa. Phú mikoo ajngóo̱ jaꞌñúu̱ tsí nimbumúú juyáa̱. Xómáꞌ ikháánꞌ rá, phú májáan a̱kuii̱n jaꞌyaa̱ꞌ. I̱ndo̱ó máꞌ numuu rí ndaꞌyóo rí ma̱riajún gúkuáaꞌ. Jamí xí na̱nguá rá, ma̱ro̱thon-ri̱ñáa̱ꞌ mangáánꞌ. <verse eid="ROM 11:22" /><verse number="23" style="v" sid="ROM 11:23" />Asndo mangii̱n máꞌ ma̱khuáꞌíi̱n mbu̱júꞌ ná ixe̱ olíbo̱, xí numuu rí nanimbúu̱n juyáa̱ Jesús. Numuu rí Ana̱ꞌlóꞌ gíꞌdoo tsiakhe̱ rí masngujmii̱ mbu̱júꞌ ná timii̱ máꞌ nákhí ginii. <verse eid="ROM 11:23" /><verse number="24" style="v" sid="ROM 11:24" />Xí ikháánꞌ tsáánꞌ ñawúun ixe̱ olíbo̱ xáná ñajwaanꞌ, nithon-ri̱ñáaꞌ jamí ndiyoo nikhuáꞌáánꞌ ná ixe̱ olíbo̱ máján, i̱wa̱á máꞌ ra̱ngíjyúu rí xa̱bo̱ judío̱, tsí ñajúún ñawúun ixe̱ olíbo̱ máján, ma̱khuáꞌíi̱n ná ixe̱ rí phú jaꞌñúu̱.<verse eid="ROM 11:24" /></para>
  <para style="s">Ana̱ꞌlóꞌ ma̱ꞌne-jáwíin xa̱bo̱ xuajñuu</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25" />A̱ngui̱nꞌ, nandoꞌ rí ma̱fraꞌa̱ꞌ májánlaꞌ awan drígo̱o̱ Ana̱ꞌlóꞌ rí i̱ndo̱ó máꞌ ikhaa̱ ni̱gi̱da̱ꞌ idxu̱u̱ nákhí wajyúú, kajngó mu̱xúxu̱xí-mijnálaꞌ. Mbá tikhuun xa̱bo̱ Israél neꞌne gúkú a̱kuíi̱n, jamí xkuaꞌñúu̱ máꞌ gáꞌne asndo gátu̱ꞌu̱ún káxe̱ kíxnuu xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, tsí wéje̱ máꞌ rí ma̱jáwíin. <verse eid="ROM 11:25" /><verse number="26" style="v" sid="ROM 11:26" />A̱ꞌkhue̱n rí mbá xúgíin xa̱bo̱ Israél ma̱jáwíin, xómá ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="q" vid="ROM 11:26">«Tsí naꞌne-jáwíin xa̱bo̱ ma̱ꞌkha̱ ná Sióón,</para>
  <para style="q" vid="ROM 11:26">jamí ikhaa̱ ma̱ꞌnii̱ janíí aꞌkhúún xa̱bi̱i Jakób.<note caller="+" style="f"><char style="fr" closed="false">11.26 </char><char style="ft" closed="false">«Jakób» ñajuun i̱mba̱ mbiꞌyuu Israél, mbáa táta̱-xi̱ꞌñú-egúún xa̱bo̱ judío̱.</char></note><verse eid="ROM 11:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ROM 11:27" />Ikhaa awan ríge̱ꞌ ma̱ne̱ ga̱jma̱á nindxúu̱n,</para>
  <para style="q" vid="ROM 11:27">ído̱ rí ikhúúnꞌ ma̱ne̱ mba̱a̱ a̱kui̱nꞌ ja̱yo̱o̱ aꞌkhúu̱n».<note caller="+" style="f"><char style="fr" closed="false">11.27 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 59.20-21.</char></note><verse eid="ROM 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 11:28" />Tsí xa̱bo̱ Israél túdri̱guíi̱ ajngáa máján ga̱jma̱á numuu Jesús, ga̱jma̱á numuu rúꞌkhue̱n ninindxúu̱n xa̱bo̱ sia̱nꞌ ná inuu Ana̱ꞌlóꞌ, jamí rúꞌkhue̱n nambáyálaꞌ, tsáanꞌ ra̱ꞌkháa xa̱bo̱ judío̱ ñajwanlaꞌ. Xómáꞌ ga̱jma̱á numuu rí wapha máꞌ watraꞌwíin xa̱bo̱ Israél rá, Ana̱ꞌlóꞌ nandoo jaꞌñúu̱ ga̱jma̱á numúú táta̱-xi̱ꞌñúu̱ wajyúú. <verse eid="ROM 11:28" /><verse number="29" style="v" sid="ROM 11:29" />Numuu rí ma̱xáxóo ma̱thanga̱a a̱kui̱in Ana̱ꞌlóꞌ jaꞌyoo rí nixuda-mina̱ꞌ maxnúú xa̱bi̱i ni máꞌ rí nindxaꞌwúu̱n rí ma̱nindxúu̱n. <verse eid="ROM 11:29" /><verse number="30" style="v" sid="ROM 11:30" />Xúꞌkhue̱n máꞌ mangáanꞌlaꞌ nákhí wajyúú, túne̱-mbáníílaꞌ rí naꞌthán Ana̱ꞌlóꞌ. Xómáꞌ xúge̱ꞌ rá, rí xa̱bo̱ Israél tsíne̱-mbáníí rí naꞌthán Ana̱ꞌlóꞌ, niñáwíin a̱kui̱in Ana̱ꞌlóꞌ jaꞌyalaꞌ ikháanꞌlaꞌ. <verse eid="ROM 11:30" /><verse number="31" style="v" sid="ROM 11:31" />Xkuaꞌnii máꞌ tsíge̱ꞌ mangiin, maske máꞌ xúge̱ꞌ najñaguu̱n, ma̱ñáwíin a̱kui̱in Ana̱ꞌlóꞌ jaꞌñúu̱, xómá rí niñáwíin a̱kui̱in Ana̱ꞌlóꞌ jaꞌyalaꞌ ikháanꞌlaꞌ. <verse eid="ROM 11:31" /><verse number="32" style="v" sid="ROM 11:32" />Numuu rí Ana̱ꞌlóꞌ neꞌne rí mbá xúgíin xa̱bo̱ ma̱jñaguun, kajngó ma̱ñáwíin a̱kuii̱n jaꞌñúu̱ mbá xúgíin.<verse eid="ROM 11:32" /></para>
  <para style="s">Phú na̱ma̱ñuu mi̱ndaꞌkho Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33" />¡Maphú mba̱a̱ mi̱ndaꞌkho rí na̱ma̱ñuu jamí rí ndaꞌyoo Ana̱ꞌlóꞌ! Asndo nimbáa ma̱xáxóo maꞌthán-makoo rí na̱ma̱ñuu̱, ni máꞌ ma̱xáxóo ma̱froꞌo̱o̱ náá ndayée̱ idxu̱u̱ ga̱jma̱á numuu rí naꞌnii̱. <verse eid="ROM 11:33" /><verse number="34" style="v" sid="ROM 11:34" />Á xtáa mbáa tsí ndaꞌyoo rí nandxaꞌwá-mina̱ꞌ Táta̱ rá, o xtáa mbáa tsí niꞌthán-múꞌúu̱n dxe̱ꞌ. <verse eid="ROM 11:34" /><verse number="35" style="v" sid="ROM 11:35" />Tsáa ginii nixnátíꞌñuu Ana̱ꞌlóꞌ, kajngó jaꞌyoo ma̱gu̱ma-numa̱a gáꞌne Ana̱ꞌlóꞌ róꞌ. <verse eid="ROM 11:35" /><verse number="36" style="v" sid="ROM 11:36" />Numuu rí Ana̱ꞌlóꞌ neꞌne-ku̱maa mbá xúgíí rí ríga̱. Ga̱jma̱á majñu̱u̱ ikhaa̱ ríga̱ ne̱, jamí drígo̱o̱ máꞌ ikhaa̱ ñajuun ne̱ mbá xúgíí. ¡A̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ jámuu mbiꞌi! Xkuaꞌnii gáꞌne.<verse eid="ROM 11:36" /></para>
  <chapter eid="ROM 11" />
  <chapter number="12" style="c" sid="ROM 12" />
  <para style="s">Gu̱xna̱xí-mijnálóꞌ mbá jayu ná ñawúun Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1" />Ikhaa jngó, a̱ngui̱nꞌ, ga̱jma̱á numuu rí phú nañáwíin a̱kui̱in Ana̱ꞌlóꞌ jaꞌyalóꞌ, na̱tha̱n-jáñalaꞌ rí gu̱xna̱xílaꞌ mbá xúgíí rí ñajwanlaꞌ ná inuu Ana̱ꞌlóꞌ. Ga̱nindxu̱u̱ xuyalaꞌ xómá mbá tsi̱gi̱jña̱ꞌ rí ndaꞌya jamí rí jaꞌwu, xómá rí phú na̱ni̱gu̱u̱ꞌ Ana̱ꞌlóꞌ, numuu rí xkuaꞌnii phú jaꞌyoo rí mu̱ne̱-mba̱a̱laꞌ ikhaa̱. <verse eid="ROM 12:1" /><verse number="2" style="v" sid="ROM 12:2" />Ma̱xájuwalaꞌ xómá júwa̱ꞌ xa̱bo̱ ná numbaa ríge̱ꞌ, rí ga̱xtiꞌkhu̱u xó rí juwalaꞌ ga̱jma̱á numuu rí na̱gu̱ma-nuxi̱iꞌ rí na̱ju̱ma̱ꞌlaꞌ. A̱ꞌkhue̱n rí ma̱goo mu̱ne̱-nuwiinlaꞌ jamí mu̱ra̱ꞌwíí mu̱ne̱laꞌ rí nandoo Ana̱ꞌlóꞌ, ikhaa máꞌ rí máján, rí mitsaan jamí rí káxe̱ mbá jayu.<verse eid="ROM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3" />Ga̱jma̱á numuu ñajun rí nixníꞌ Ana̱ꞌlóꞌ ma̱ne̱, na̱tha̱nꞌlaꞌ mbá xúgiáanꞌlaꞌ rí nimbáa ma̱xákúxe̱-mina̱ꞌ rí ma̱ju̱mu̱u̱ jaꞌya-mina̱ꞌ rí i̱tha̱án gíꞌdoo numuu xó rí i̱ꞌwíin. Rí ga̱ju̱mu̱u̱ jaꞌya-mine̱e̱ꞌ xómá phú jaꞌyoo, jamí ga̱ju̱mu̱u̱ xómá awan rí nijanáá ñajun mbámbáa numuu rí wéje̱ a̱kui̱in ná inuu Ana̱ꞌlóꞌ. <verse eid="ROM 12:3" /><verse number="4" style="v" sid="ROM 12:4" />Rí xuyuu xa̱bo̱ phú mbaꞌa xtóo ne̱ kajwa̱a̱, i̱ndo̱ó máꞌ numuu rí ra̱ꞌkhá mbóó inii ñajun naꞌne mbá xúgíí xtóo xuyuu xa̱bo̱. <verse eid="ROM 12:4" /><verse number="5" style="v" sid="ROM 12:5" />Xkuaꞌnii máꞌ mangáanꞌlóꞌ, maske máꞌ phú mbaꞌáanꞌlóꞌ, mbáwíi máꞌ xa̱bo̱ ñajwanlóꞌ ga̱jma̱á nindxu̱u̱ Krísto̱, jamí mbámbáa tsí ikháánꞌlóꞌ kajwa̱a̱ gajmíi̱ mbá xúgíin.<verse eid="ROM 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 12:6" />Kriꞌkhu ñajun rí nijanáá ma̱ꞌne mbámbáa tsí ikháánꞌlóꞌ kajngó ma̱ꞌne-mba̱a̱ Ana̱ꞌlóꞌ, xómá rí ikhaa̱ ndiyoo̱. Ikhaa jngó, tsí ni̱ge̱ꞌe̱ inuu rí ma̱gu̱wíjnga̱a ajngóo Ana̱ꞌlóꞌ, gaꞌthée̱n xómá jaꞌyoo rí wéje̱ a̱kia̱nꞌlóꞌ ná inuu Ana̱ꞌlóꞌ. <verse eid="ROM 12:6" /><verse number="7" style="v" sid="ROM 12:7" />Tsí ni̱ge̱ꞌe̱ inuu rí ma̱ꞌne-mba̱ꞌwi̱in xa̱bo̱, ga̱ꞌne-mba̱ꞌwii̱n xa̱bo̱. Tsí ni̱ge̱ꞌe̱ inuu rí maꞌsngáá, gaꞌsngáa̱. <verse eid="ROM 12:7" /><verse number="8" style="v" sid="ROM 12:8" />Tsí ni̱ge̱ꞌe̱ inuu rí maxná tsiakhe̱, gaxnúu̱ tsiakhe̱ xa̱bo̱. Tsí ni̱ge̱ꞌe̱ inuu rí maxpíꞌtháa rí gíꞌdoo, ma̱xáꞌne xtándúu̱. Tsí ni̱ge̱ꞌe̱ inuu rí ma̱nindxu̱u̱ xa̱bo̱ ede̱, gaxná-mine̱e̱ꞌ tsiakhe̱ rí ma̱ga̱jnúu mújúun ñajun. Tsí ni̱ge̱ꞌe̱ inuu rí ma̱ñáwíin a̱kui̱in jaꞌñúú xa̱bo̱, gagi a̱kuii̱n gáꞌnii̱ ñajun rúꞌkhue̱n.<verse eid="ROM 12:8" /></para>
  <para style="s">Xáne gíꞌmaa rí ma̱ju̱wá tsí nagóó tsu̱du̱u̱ Krísto̱</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9" />Ga̱galaꞌ ju̱ya̱-mijnálaꞌ ga̱jma̱á mbá jañii a̱kia̱nꞌlaꞌ. Ma̱xáni̱ꞌgua̱ꞌlaꞌ rí mu̱ne̱laꞌ rí xkawe̱ꞌ, jamí mu̱xúni̱ꞌñáá-ru̱ne̱laꞌ rí máján. <verse eid="ROM 12:9" /><verse number="10" style="v" sid="ROM 12:10" />Ga̱galaꞌ ju̱ya̱-mijnálaꞌ xómá nandúún juya-mijná mbá guꞌwíin xa̱bo̱. Gu̱ya̱-maku-mijnálaꞌ jamí gu̱ne̱-mba̱ꞌwo̱-mijnálaꞌ. <verse eid="ROM 12:10" /><verse number="11" style="v" sid="ROM 12:11" />Gu̱xna̱-míjnálaꞌ tsiakhe̱ jamí ma̱xáꞌskalaꞌ. Gu̱ne̱laꞌ ñajuun Táta̱ ga̱jma̱á mbá jañii a̱kia̱nꞌlaꞌ. <verse eid="ROM 12:11" /><verse number="12" style="v" sid="ROM 12:12" />Ga̱ꞌdxalaꞌ ná rí ga̱jma̱á mbá jañii a̱kia̱nꞌlaꞌ guáꞌthi̱ínlaꞌ. Gu̱ne̱ gakhe̱ a̱kia̱nꞌlaꞌ ído̱ rí nanújngalaꞌ ná awúun gajmá, jamí mu̱xúni̱ꞌñáálaꞌ rí nu̱tha̱n-jáñíílaꞌ Ana̱ꞌlóꞌ. <verse eid="ROM 12:12" /><verse number="13" style="v" sid="ROM 12:13" />Gu̱mbáñúúlaꞌ xa̱bi̱i Ana̱ꞌlóꞌ ga̱jma̱á rí ndaꞌñúú. Ga̱juwa-na̱ma̱ñalaꞌ rí mu̱drígúun ná guꞌwálaꞌ xa̱bo̱ tsí naguwá i̱mba̱ janíí.<verse eid="ROM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14" />Gu̱nda̱ꞌa̱álaꞌ Ana̱ꞌlóꞌ rí ma̱ꞌne-tsakun-rámii tsí nune̱-ngínáaꞌlaꞌ. Gu̱nda̱ꞌa̱álaꞌ Ana̱ꞌlóꞌ rí ma̱ꞌne-tsakun-rámii̱ jamí mu̱xúxna̱-maꞌíi̱nlaꞌ. <verse eid="ROM 12:14" /><verse number="15" style="v" sid="ROM 12:15" />Ga̱ꞌdxu a̱kia̱nꞌlaꞌ gajmiálaꞌ tsí nadxu a̱kui̱ín, jamí gu̱mbi̱ya̱ꞌ gajmiálaꞌ tsí nu̱mbi̱ya̱ꞌ. <verse eid="ROM 12:15" /><verse number="16" style="v" sid="ROM 12:16" />Gu̱ru̱wa̱a ju̱ma̱ꞌlaꞌ gajmiálaꞌ i̱ꞌwíin. Mu̱xúxu̱xí-mijnálaꞌ, rí ga̱mbáxa̱ꞌ gajmiálaꞌ tsí ngíníi. Ma̱xáju̱ma̱ꞌlaꞌ rí ikháanꞌlaꞌ phú na̱ma̱ñalaꞌ mbá xúgíí.<verse eid="ROM 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17" />Mu̱xúrthanga̱alaꞌ ná inuu nimbáa rí ra̱máján niꞌñalaꞌ. Gu̱xna̱-míjnálaꞌ tsiakhe̱ rí mu̱ne̱laꞌ rí máján ná inúú mbá xúgíin xa̱bo̱. <verse eid="ROM 12:17" /><verse number="18" style="v" sid="ROM 12:18" />Asndo náá máꞌ na̱ꞌngo̱o̱, gu̱xna̱-míjnálaꞌ tsiakhe̱ rí ma̱juwalaꞌ tsímáá gajmiálaꞌ mbá xúgíin xa̱bo̱. <verse eid="ROM 12:18" /><verse number="19" style="v" sid="ROM 12:19" />A̱ngui̱nꞌ, mu̱xúrthanga̱alaꞌ máꞌ ikháanꞌlaꞌ ná inuu xa̱bo̱ tsí niꞌñalaꞌ rí ra̱máján, rí gu̱ni̱ꞌñáálaꞌ Ana̱ꞌlóꞌ ma̱ꞌne-mbánuu ga̱jma̱á numalaꞌ. Numuu rí xkuaꞌnii ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="q" vid="ROM 12:19">«Ikhúúnꞌ ma̱rthanga̱a ná inúú xa̱bo̱ rí nene̱.</para>
  <para style="q" vid="ROM 12:19">Ikhúúnꞌ ma̱ne̱ rí mu̱drígú xa̱bo̱ xómá jaꞌyoo rí nene̱».<note caller="+" style="f"><char style="fr" closed="false">12.19 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yi̱i̱ꞌ rí naꞌthán ikhaa máꞌ xtángoo 32.35.</char></note><verse eid="ROM 12:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="ROM 12:20" />Ikhaa jngó,</para>
  <para style="q" vid="ROM 12:20">«Xí xa̱bo̱ tsí gíꞌdáán sia̱nꞌ na̱xki̱dxu̱u̱, araxnáa̱ guma mi̱khui̱i̱.</para>
  <para style="q" vid="ROM 12:20">Xí najándawoo̱, araxnáa̱ yaꞌsi ma̱ga̱a̱n.</para>
  <para style="q" vid="ROM 12:20">Xí xkuaꞌnii ithane̱, ma̱tha̱ne̱ rí</para>
  <para style="q" vid="ROM 12:20">ma̱ꞌne maña̱ꞌ inuu̱ numuu rí na̱ti̱yu̱u̱ꞌ».<note caller="+" style="f"><char style="fr" closed="false">12.20 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajngáa ju̱ma̱ 25.21-22.</char></note><verse eid="ROM 12:20" /></para>
  <para style="b" />
  <para style="m">
    <verse number="21" style="v" sid="ROM 12:21" />Ma̱xáta̱tsi̱ꞌñá-mina̱ꞌ rí ma̱ꞌngo̱o̱ rí xkawe̱ꞌ inaaꞌ, rí ga̱ꞌnga̱a̱ꞌ ikháánꞌ inuu rí xkawe̱ꞌ ga̱jma̱á rí máján.<verse eid="ROM 12:21" /></para>
  <chapter eid="ROM 12" />
  <chapter number="13" style="c" sid="ROM 13" />
  <para style="s">Mu̱ꞌne̱-mbáníílóꞌ rí nuthan xa̱bo̱ ñajun</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1" />Jámba̱a̱ xa̱bo̱ gíꞌmaa rí ma̱ꞌne-mbánuu̱ rí nuthan xa̱bo̱ ñajun. Numuu rí Ana̱ꞌlóꞌ niskuíji̱in mbá xúgíin xa̱bo̱ ñajun. Rúꞌkhue̱n iꞌthán rí xa̱bo̱ ñajun tsí trigi̱in, Ana̱ꞌlóꞌ máꞌ niskuíjii̱n. <verse eid="ROM 13:1" /><verse number="2" style="v" sid="ROM 13:2" />Ikhaa jngó, jámba̱a̱ xa̱bo̱ tsí najñaguii inúú xa̱bo̱ ñajun, rí niꞌgí máꞌ Ana̱ꞌlóꞌ na̱we̱je̱-ꞌthu̱u̱n, jamí ma̱grui̱guíi̱ jamínu̱ꞌ ga̱jma̱á numuu rí naꞌnii̱. <verse eid="ROM 13:2" /><verse number="3" style="v" sid="ROM 13:3" />Numuu rí tátrigi̱in xa̱bo̱ ñajun kajngó ma̱mi̱ꞌñúú tsí nune̱ rí máján, rí nitrigii̱n kajngó ma̱mi̱ꞌñúú tsí nune̱ rí xkawe̱ꞌ. Á nandaaꞌ rí ma̱xámíñaaꞌ gúne̱ xa̱bo̱ ñajun dxe̱ꞌ. Athane̱ rí máján, jamí ikhii̱n muthee̱n rí máján ga̱jma̱á numaaꞌ. <verse eid="ROM 13:3" /><verse number="4" style="v" sid="ROM 13:4" />Numuu rí yumbée Ana̱ꞌlóꞌ ñajúu̱n, kajngó ma̱ra̱xtaa májáanꞌ ikháánꞌ. I̱ndo̱ó máꞌ numuu rí, xí nathane̱ rí ra̱máján rá, ga̱mi̱ꞌñáaꞌ xúꞌkhue̱n rá, numuu rí yumbée Ana̱ꞌlóꞌ ñajúu̱n. Jamí ra̱ꞌkhá máꞌ nijanúu̱ xúgi̱í tsiakhe̱, rí nijanúu̱ ne̱ kajngó mu̱xpa̱thúu̱n tsí nune̱ rí ra̱máján. <verse eid="ROM 13:4" /><verse number="5" style="v" sid="ROM 13:5" />Ikhaa jngó, ndaꞌyóo rí mu̱ꞌne̱-mbáníílóꞌ rí nuthan xa̱bo̱ ñajun, ra̱ꞌkhá máꞌ i̱ndo̱ó numuu rí mu̱xúxpa̱tháa̱nꞌlóꞌ, rí ga̱jma̱á numuu rí nduꞌyáálóꞌ máꞌ ná awúun a̱kia̱nꞌlóꞌ rí jaꞌyalóꞌ mu̱ꞌne̱-mbáníílóꞌ rí nuthee̱n. <verse eid="ROM 13:5" /><verse number="6" style="v" sid="ROM 13:6" />Ikhaa máꞌ numuu rúꞌkhue̱n nu̱ne̱-numalaꞌ rí jaꞌyalaꞌ ná inuu xa̱bo̱ ñajun, numuu rí ikhii̱n ñajúu̱n yumbée Ana̱ꞌlóꞌ tsí nitrigi̱in rí muthan-ñajun. <verse eid="ROM 13:6" /><verse number="7" style="v" sid="ROM 13:7" />Gu̱xna̱álaꞌ mbámbáa rí jaꞌyoo mu̱xna̱álaꞌ: xí jaꞌyoo mu̱xna̱laꞌ mbúkho̱o̱ guꞌwá-ñajun, gu̱xna̱laꞌ ne̱. Xí gíꞌmaa mu̱xna̱laꞌ rí ma̱jmaa ná xuajen, gu̱xna̱laꞌ ne̱. Tsí gíꞌmaa mbu̱ya̱-makuíílaꞌ, gu̱ya̱-makuíi̱laꞌ. Tsí gíꞌmaa mu̱xna̱álaꞌ gamaku, gu̱xnáa̱laꞌ ne̱.<verse eid="ROM 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8" />Ma̱xági̱ꞌmáaꞌlaꞌ inuu nimbáa xa̱bo̱. Mbóó máꞌ rí phú gíꞌmáaꞌlaꞌ mu̱ne̱, rí ma̱galaꞌ ju̱ya̱-mijnálaꞌ. Numuu rí tsí nandoo jaꞌyoo xa̱bo̱ numbaa ga̱jma̱á, neꞌne-mbánuu̱ máꞌ mbá xúgíí rí naꞌthán xtángoo. <verse eid="ROM 13:8" /><verse number="9" style="v" sid="ROM 13:9" />Numuu rí xtángoo naꞌthán: «Ma̱xátha̱ba̱a̱ꞌ ga̱jma̱a̱ꞌ xa̱bo̱ tsí tíya̱a̱. Ma̱xáta̱xíya̱a̱ xa̱bo̱. Ma̱xátha̱ne̱ ku̱ꞌwá. Ma̱xátrígu ajngáa waꞌa tsu̱du̱u̱ xa̱bo̱. Ma̱xáni̱gua̱a̱ꞌ ma̱raꞌdáá rí na̱nguá xtaꞌdáá». Jamí asndo náá máꞌ rí i̱mba̱ xtángoo, na̱gu̱ma-mbáníí ne̱ ga̱jma̱á mbóó xtángoo ríge̱ꞌ: «Ga̱gaaꞌ xtayáá xa̱bo̱ numbaa ga̱jma̱a̱ꞌ xómá rí nandaaꞌ xtaya-mina̱ꞌ ikháánꞌ». <verse eid="ROM 13:9" /><verse number="10" style="v" sid="ROM 13:10" />Tsí nandoo jaꞌñúú xa̱bo̱, tsíꞌne-ñawúu̱n máꞌ nimbáa. Ikhaa jngó, tsí nandoo jaꞌñúú xa̱bo̱, naꞌne-mbánuu̱ máꞌ xúgíí xtángoo.<verse eid="ROM 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11" />Gu̱ne̱laꞌ rí na̱tha̱nꞌlaꞌ ge̱jyoꞌ, numuu rí ndu̱ya̱álaꞌ máꞌ náá mbiꞌi juwalóꞌ xúge̱ꞌ. Nixtáa máꞌ rí ma̱jwi̱iꞌlóꞌ rá, numuu rí i̱tha̱án máꞌ nangiyuu mbiꞌi rí ma̱jríñáaꞌlóꞌ xúge̱ꞌ xó rí nákhí ninimba̱ꞌlóꞌ. <verse eid="ROM 13:11" /><verse number="12" style="v" sid="ROM 13:12" />Ni̱ka̱ guéño máꞌ mbroꞌon rá, jamí inu máꞌ ma̱ga̱nú mbiꞌi. Ikhaa jngó, gu̱ni̱ꞌñáá-ru̱ꞌne̱lóꞌ rí nune̱ xa̱bo̱ tsí júwa̱ꞌ ná mijína, jamí ga̱jmalóꞌ ski̱yu̱u̱ꞌ Ana̱ꞌlóꞌ rí xómá xtíin ajwa̱nꞌ jaꞌnii. <verse eid="ROM 13:12" /><verse number="13" style="v" sid="ROM 13:13" />Ga̱juwalóꞌ ga̱jma̱á gamaku ná awúun mbiꞌi rí juwalóꞌ, xómá jaꞌyoo rí mu̱ꞌne̱lóꞌ. Ma̱xápeꞌtso guéñalóꞌ jamí ma̱xájngáanꞌlóꞌ. Ma̱xáni̱gua̱ꞌlóꞌ rí mu̱ꞌbálóꞌ gajmiálóꞌ xa̱bo̱ tsí túꞌyáalóꞌ ni máꞌ mu̱xúꞌne̱lóꞌ rí xkawe̱ꞌ nu̱ndxa̱ꞌwa̱-mijnálóꞌ. Ma̱xátsa̱ña̱ꞌlóꞌ gajmiálóꞌ xa̱bo̱ jamí ma̱xáxígua̱ꞌlóꞌ juꞌñúu̱. <verse eid="ROM 13:13" /><verse number="14" style="v" sid="ROM 13:14" />A̱ꞌkhue̱n gakon, ga̱nindxa̱ꞌlaꞌ xómá jaꞌnii Táta̱ Jesukrísto̱, jamí mu̱xúꞌyálaꞌ rí mu̱ne̱laꞌ rí nandoo xuyalaꞌ.<verse eid="ROM 13:14" /></para>
  <chapter eid="ROM 13" />
  <chapter number="14" style="c" sid="ROM 14" />
  <para style="s">Mu̱xúꞌthán numa-mijnálóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1" />Gu̱drígúunlaꞌ tsí na̱nguá wéje̱-gúkúu a̱kui̱ín ná inuu Ana̱ꞌlóꞌ, i̱ndo̱ó máꞌ numuu rí ra̱ꞌkháa rí ma̱tsa̱ña̱ꞌlaꞌ gajmiálaꞌ ga̱jma̱á numuu rí kriꞌkhu rí na̱ju̱múu̱. <verse eid="ROM 14:1" /><verse number="2" style="v" sid="ROM 14:2" />Numuu rí mbá tikhuun na̱ju̱mu̱ú rí ma̱goo mu̱pho̱ mbá xúgíí inii ganitsu. Xómáꞌ i̱ꞌwíin, tsí na̱nguá wéje̱-gúkúu a̱kui̱ín ná inuu Ana̱ꞌlóꞌ, i̱ndo̱ó máꞌ ya̱ꞌwo̱ iꞌphi̱i̱. <verse eid="ROM 14:2" /><verse number="3" style="v" sid="ROM 14:3" />Tsí naꞌkho̱ mbá xúgíí inii ganitsu, ma̱xáꞌthée̱n rí ra̱gíꞌdoo numuu tsí tsíꞌkho̱ mbá xúgíí inii ganitsu. Xúꞌkhue̱n máꞌ tsí tsíꞌkho̱ mbá xúgíí inii ganitsu, ma̱xáꞌthée̱n rí ra̱gíꞌdoo numuu tsí naꞌkho̱ mbá xúgíí inii ganitsu, numuu rí Ana̱ꞌlóꞌ ni̱grui̱guíi̱ mangaa̱. <verse eid="ROM 14:3" /><verse number="4" style="v" sid="ROM 14:4" />Tsáa ñajwaanꞌ ikháánꞌ kajngó ma̱ra̱tha̱n rí ra̱máján eꞌne yumbée xa̱bo̱ róꞌ. Á máján o ra̱máján iꞌnii̱, xa̱bo̱ tsí gíꞌdaa yumbée jaꞌyoo rí maꞌthán rúꞌkhue̱n. I̱ndo̱ó máꞌ numuu rí ma̱ga̱jnúu̱ mújúu̱n máꞌ, numuu rí Táta̱ tsí naꞌthán-ñájun gíꞌdoo tsiakhe̱ ma̱ꞌne rí ma̱ga̱jnúu̱ mújúu̱n.<verse eid="ROM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5" />Mbá tikhuun na̱ju̱mu̱ú rí i̱tha̱án gíꞌdoo numuu mbá tikhu mbiꞌi, xómáꞌ i̱ꞌwíin na̱ju̱mu̱ú rí mbéꞌtháán mbá xúgíí mbiꞌi. Mbámbáa gáwe̱je̱ gúkúu ga̱jma̱á rí na̱ju̱mu̱u̱. <verse eid="ROM 14:5" /><verse number="6" style="v" sid="ROM 14:6" />Tsí na̱ju̱mu̱u̱ rí mbá tikhu mbiꞌi i̱wa̱á gíꞌdoo numuu, Táta̱ máꞌ eꞌne-mba̱a̱. Jamí tsí na̱ju̱mu̱u̱ rí mbéꞌtháán mbá xúgíí mbiꞌi rá, Táta̱ máꞌ eꞌne-mba̱a̱ mangaa̱. Xúꞌkhue̱n máꞌ tsí naꞌkho̱ mbá xúgíí inii ganitsu, Táta̱ máꞌ eꞌne-mba̱a̱, numuu rí naríguu̱ gamaku inuu Ana̱ꞌlóꞌ. Xkuaꞌnii máꞌ tsí tsíꞌkho̱ mbá xúgíí inii ganitsu mangaa, Táta̱ máꞌ eꞌne-mba̱a̱, jamí naríguu̱ gamaku inuu Ana̱ꞌlóꞌ mangaa̱.<verse eid="ROM 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 14:7" />Numuu rí nimbáa máꞌ tsí ikháánꞌlóꞌ na̱nguá xtáa i̱ndo̱ó máꞌ ga̱jma̱á numuu ikhaa, ni máꞌ tsíjáñuu i̱ndo̱ó máꞌ ga̱jma̱á numuu ikhaa. <verse eid="ROM 14:7" /><verse number="8" style="v" sid="ROM 14:8" />Xí nduꞌyalóꞌ, juwalóꞌ ga̱jma̱á numuu Táta̱. Jamí xí nijáñalóꞌ, nijáñalóꞌ ga̱jma̱á numuu máꞌ Táta̱. Ikhaa jngó, xí nduꞌyalóꞌ o nijáñalóꞌ mbo̱ꞌ, xa̱bi̱i máꞌ Táta̱ ñajwanlóꞌ. <verse eid="ROM 14:8" /><verse number="9" style="v" sid="ROM 14:9" />Ikhaa máꞌ numuu rúꞌkhue̱n nijáñuu jamí ndiyáa mbiꞌyuu Krísto̱, kajngó ma̱nindxu̱u̱ Táta̱ tsí naꞌthán-ñájúún tsí nduya jamí tsí nijáñúú.<verse eid="ROM 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 14:10" />Xómáꞌ ikháánꞌ, náá numuu kajngó narathán numuu dxájwaaꞌ róꞌ. Náá numuu kajngó na̱ju̱ma̱a̱ꞌ rí ra̱gíꞌdoo numuu dxájwaaꞌ róꞌ. Numuu rí xúgiáanꞌlóꞌ mu̱xna̱xí-mijnálóꞌ ná inuu Krísto̱,<note caller="+" style="f"><char style="fr" closed="false">14.10 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí tsíꞌthán «inuu Krísto̱», rí «inuu Ana̱ꞌlóꞌ» iꞌthán ne̱.</char></note> kajngó ma̱ra̱jwe̱e̱ꞌ numalóꞌ. <verse eid="ROM 14:10" /><verse number="11" style="v" sid="ROM 14:11" />Numuu rí xkuaꞌnii ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="q" vid="ROM 14:11">«Xáꞌnii iꞌthán Táta̱: Na̱xu̱ꞌdá-mina̱ꞌ ga̱jma̱á numuꞌ máꞌ ikhúúnꞌ,</para>
  <para style="q" vid="ROM 14:11">rí jámba̱a̱ xa̱bo̱ masmáti̱go̱o̱ ná inuꞌ,</para>
  <para style="q" vid="ROM 14:11">jamí mbá xúgíin xa̱bo̱ tsí júwa̱ꞌ ná numbaa mune̱-mbu̱únꞌ ikhúúnꞌ».<note caller="+" style="f"><char style="fr" closed="false">14.11 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 45.23.</char></note><verse eid="ROM 14:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 14:12" />Ikhaa jngó, mbámbáa tsí ikháánꞌlóꞌ maꞌthán ná inuu Ana̱ꞌlóꞌ ga̱jma̱á numuu rí neꞌne.<verse eid="ROM 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13" />Ikhaa numuu rúꞌkhue̱n, gu̱ni̱ꞌñáálóꞌ rí nuꞌthán numa-mijnálóꞌ. A̱ꞌkhue̱n gakon, gu̱ꞌgí-mijnálaꞌ rí mu̱xúne̱laꞌ rí ma̱ꞌne wabaa o ma̱ꞌne a̱jma̱ a̱kui̱in nimbáa dxájwalóꞌ. <verse eid="ROM 14:13" /><verse number="14" style="v" sid="ROM 14:14" />Ikhúúnꞌ nanimbo̱ꞌ ja̱yo̱o̱ Táta̱ Jesús, jamí nda̱yo̱o̱ mújúnꞌ rí nda̱a̱ nimbá ganitsu rí tsúꞌkhaa mu̱ꞌpholóꞌ. Xómáꞌ tsí na̱ju̱mu̱u̱ rí mbá tikhu ganitsu tsúꞌkhaa rí mu̱ꞌpholóꞌ rá, tsúꞌkhaa ne̱ iꞌyoo̱ ikhaa̱. <verse eid="ROM 14:14" /><verse number="15" style="v" sid="ROM 14:15" />Xí ga̱jma̱á numuu rí natso, nathane̱ rí ma̱ꞌne-ngíná a̱kui̱in dxájwaaꞌ, na̱nguá máꞌ itasngájma rí nandaaꞌ xtayáa̱ xúꞌkhue̱n rá. Ma̱xátha̱ne̱ rí ga̱jma̱á numuu rí natso, ma̱ndáti̱ga̱a̱ tsí nijáñuu Krísto̱ ga̱jma̱á numuu. <verse eid="ROM 14:15" /><verse number="16" style="v" sid="ROM 14:16" />Mu̱xúne̱laꞌ rí muthan xkawe̱ꞌ xa̱bo̱ ga̱jma̱á numuu rí máján rí nandoo nu̱ne̱laꞌ ikháanꞌlaꞌ. <verse eid="ROM 14:16" /><verse number="17" style="v" sid="ROM 14:17" />Numuu rí napholóꞌ o rí nawanlóꞌ mbo̱ꞌ, tsísngájma rúꞌkhue̱n xí Ana̱ꞌlóꞌ ñajuun tsí naꞌthán-ñájwanlóꞌ. Rí phú i̱tha̱án gíꞌdoo numuu ñajuun rí mu̱ꞌne̱lóꞌ rí máján, rí ma̱juwalóꞌ tsímáá jamí gagi ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ. <verse eid="ROM 14:17" /><verse number="18" style="v" sid="ROM 14:18" />Tsí xkuaꞌnii nayumbáá inuu Krísto̱, tsúꞌkhue̱n tsí na̱ni̱gu̱u̱ꞌ Ana̱ꞌlóꞌ jaꞌyoo, xúꞌkhue̱n máꞌ nuthan rí máján xa̱bo̱ ga̱jma̱á numuu̱.<verse eid="ROM 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19" />Ikhaa jngó, gu̱ꞌxná-mijnálóꞌ tsiakhe̱ rí mu̱ꞌne̱lóꞌ rí nambáyúu rí ma̱juwalóꞌ tsímáá, jamí rí ma̱gajáanꞌlóꞌ mbá xúgiáanꞌlóꞌ. <verse eid="ROM 14:19" /><verse number="20" style="v" sid="ROM 14:20" />Ma̱xátha̱ne̱ gámba̱a̱ꞌ ñajun rí naꞌne Ana̱ꞌlóꞌ ga̱jma̱á numuu rí natso. Gakon máꞌ rí mbá xúgíí inii ganitsu ma̱goo mu̱ꞌpholóꞌ. I̱ndo̱ó máꞌ numuu rí ra̱máján rí ma̱ꞌne-ngíná a̱kui̱ín i̱ꞌwíin a̱ngia̱nꞌlóꞌ ga̱jma̱á numuu rí napholóꞌ. <verse eid="ROM 14:20" /><verse number="21" style="v" sid="ROM 14:21" />I̱wa̱á máꞌ máján rí mu̱xúꞌpholóꞌ xuwi, ni máꞌ mu̱xúꞌwa̱a̱nlóꞌ iyoo úba̱ rí ni̱ga̱yu̱u̱ꞌ, ni máꞌ mu̱xúꞌne̱lóꞌ nimbá rí ma̱ꞌne-ngra̱ꞌaa o ma̱ꞌne-ngíná a̱kui̱in o ma̱ꞌne wabaa<note caller="+" style="f"><char style="fr" closed="false">14.21 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «o ma̱ꞌne-ngíná a̱kui̱in o ma̱ꞌne wabaa».</char></note> dxájwalóꞌ gáꞌne. <verse eid="ROM 14:21" /><verse number="22" style="v" sid="ROM 14:22" />Rí nathayáá májáanꞌ máꞌ rí ma̱goo ma̱tha̱ne̱, ga̱nindxu̱u̱ ne̱ mbá rí nathayáá i̱ndo̱ó máꞌ ikháánꞌ ga̱jma̱á nindxu̱u̱ Ana̱ꞌlóꞌ. Phú gagi xtáa tsí ndaꞌyoo mújúun máꞌ rí na̱nguá eꞌne aꞌkhán ga̱jma̱á majñu̱u̱ rí naꞌne. <verse eid="ROM 14:22" /><verse number="23" style="v" sid="ROM 14:23" />Xómáꞌ tsí a̱jma̱ a̱kui̱in jaꞌyoo rí naꞌkho̱ rá, naxuda-mine̱e̱ꞌ aꞌkhán, numuu na̱ju̱mu̱u̱ rí ma̱xáxóo mi̱khui̱i̱ ne̱. Mbá xúgíí rí naꞌne xa̱bo̱ ga̱jma̱á a̱jma̱ a̱kui̱in, aꞌkhán ñajuun ne̱.<verse eid="ROM 14:23" /></para>
  <chapter eid="ROM 14" />
  <chapter number="15" style="c" sid="ROM 15" />
  <para style="s">Jaꞌyoo rí mu̱mbáñúúlóꞌ tsí wabiin</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1" />Ikhaa jngó, ikháánꞌlóꞌ tsáanꞌ wéje̱-gúkúu a̱kia̱nꞌlóꞌ ná inuu Ana̱ꞌlóꞌ, jaꞌyalóꞌ rí mu̱mbáñúúlóꞌ tsí wabiin, ra̱ꞌkhá máꞌ i̱ndo̱ó mu̱ꞌne̱lóꞌ rí na̱ni̱gua̱ꞌlóꞌ ikháánꞌlóꞌ. <verse eid="ROM 15:1" /><verse number="2" style="v" sid="ROM 15:2" />Mbámbáa tsí ikháánꞌlóꞌ jaꞌyoo ma̱ꞌne rí na̱ni̱gu̱u̱ꞌ dxájuu, kajngó ma̱ꞌga-ragaja̱a̱ awúun rí máján. <verse eid="ROM 15:2" /><verse number="3" style="v" sid="ROM 15:3" />Numuu rí asndo ni máꞌ Krísto̱ táꞌnii̱ rí na̱ni̱gu̱u̱ꞌ ikhaa̱, ikhaa jngó ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ: «Ído̱ rí nuthan-xkawia̱a̱ꞌ xa̱bo̱, asndo ikhúúnꞌ máꞌ nuthan-xkawi̱ꞌ».<note caller="+" style="f"><char style="fr" closed="false">15.3 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 69.9.</char></note> <verse eid="ROM 15:3" /><verse number="4" style="v" sid="ROM 15:4" />Mbá xúgíí rí waꞌtháán wajyúú, waꞌtháán ne̱ kajngó maꞌsngálóꞌ ne̱. Ikhaa jngó ga̱jma̱á majñu̱u̱ i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ ma̱ꞌne mba̱a̱ a̱kia̱nꞌlóꞌ jamí mu̱drígúlóꞌ tsiakhe̱, xkuaꞌnii kajngó ma̱mba̱núu rí ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ guáꞌthi̱ínlóꞌ.<verse eid="ROM 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 15:5" />Ana̱ꞌlóꞌ tsí naꞌne rí ma̱ꞌngo̱o̱ a̱kia̱nꞌlóꞌ jamí naxnálóꞌ tsiakhe̱ gáꞌne rí mu̱wa̱a ju̱ma̱ꞌlaꞌ, xómá rí nandoo Krísto̱ Jesús. <verse eid="ROM 15:5" /><verse number="6" style="v" sid="ROM 15:6" />Kajngó mbá xúgiáanꞌlaꞌ, mbóó a̱ꞌwálaꞌ gúne̱-mba̱a̱laꞌ Ana̱ꞌlóꞌ, tsí ñajuun Anu̱u̱ Tátiálóꞌ Jesukrísto̱.<verse eid="ROM 15:6" /></para>
  <para style="s">Mbá xúgíin xa̱bo̱ numbaa mu̱dxawíín ajngáa máján</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7" />Ikhaa numuu rúꞌkhue̱n, gu̱drígú-mijná májánlaꞌ xómá rí Krísto̱ ni̱grui̱guáanꞌlóꞌ, kajngó ma̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ. <verse eid="ROM 15:7" /><verse number="8" style="v" sid="ROM 15:8" />Numuu rí ikhúúnꞌ na̱tha̱nꞌlaꞌ rí Krísto̱ ni̱ꞌkha̱ gáꞌne-mba̱ꞌwu̱un xa̱bo̱ judío̱, kajngó ma̱ꞌne-mbánuu̱ rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxu̱ún táta̱-xi̱ꞌñáxo̱ꞌ wajyúú, jamí xkuaꞌnii nisngájmee̱ rí kuwiin Ana̱ꞌlóꞌ. <verse eid="ROM 15:8" /><verse number="9" style="v" sid="ROM 15:9" />Xúꞌkhue̱n máꞌ mangaa, Krísto̱ ni̱ꞌkha̱ kajngó xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún mune̱-mba̱a̱ Ana̱ꞌlóꞌ ga̱jma̱á numuu rí nañáwíin a̱kuii̱n jaꞌñúu̱. Xómá ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="q" vid="ROM 15:9">«Ikhaa numuu rúꞌkhue̱n ma̱ne̱-mba̱ánꞌ ná majñu̱ú xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún,</para>
  <para style="q" vid="ROM 15:9">jamí ma̱ne̱ ajmúú ga̱jma̱á numaaꞌ ikháánꞌ».<note caller="+" style="f"><char style="fr" closed="false">15.9 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 18.49.</char></note><verse eid="ROM 15:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="ROM 15:10" />Mangaa máꞌ ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="q" vid="ROM 15:10">«Ga̱ꞌdxu a̱kia̱nꞌlaꞌ, xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajwanlaꞌ,</para>
  <para style="q" vid="ROM 15:10">ga̱jma̱á nindxu̱ún xa̱bi̱i Ana̱ꞌlóꞌ».<note caller="+" style="f"><char style="fr" closed="false">15.10 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yi̱i̱ꞌ rí naꞌthán ikhaa máꞌ xtángoo 32.43.</char></note><verse eid="ROM 15:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="ROM 15:11" />Jamí i̱mba̱ janíí ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="q" vid="ROM 15:11">«Gu̱ne̱-mba̱a̱laꞌ Táta̱, mbá xúgiáanꞌlaꞌ xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajwanlaꞌ,</para>
  <para style="q" vid="ROM 15:11">jamí mbá xúgiáanꞌlaꞌ gu̱tha̱nlaꞌ rí máján naꞌnii̱».<note caller="+" style="f"><char style="fr" closed="false">15.11 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 117.1.</char></note><verse eid="ROM 15:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 15:12" />Xúꞌkhue̱n máꞌ iꞌthán Isaía̱s mangaa:</para>
  <para style="q" vid="ROM 15:12">«Ma̱gu̱maa mbáa a̱ꞌdá-ri̱jyu̱u̱ꞌ Isaí,</para>
  <para style="q" vid="ROM 15:12">tsí ma̱ge̱ꞌe̱ maꞌthán-ñájuun mbá xúgíí xuajen numbaa.</para>
  <para style="q" vid="ROM 15:12">Ná inuu̱ ikhaa̱ mu̱waꞌthi̱ín mbá xúgíin xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún».<note caller="+" style="f"><char style="fr" closed="false">15.12 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 11.10.</char></note><verse eid="ROM 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13" />Ana̱ꞌlóꞌ tsí mbá jañii a̱kia̱nꞌlóꞌ guáꞌthi̱ínlóꞌ inuu gáꞌne rí ma̱juwalaꞌ gagi mi̱ndaꞌkho jamí tsímáá, awúun máꞌ rí nanimba̱ꞌlaꞌ ju̱yáa̱. Xkuaꞌnii kajngó asndo ma̱ga̱dí-rígúu rí ga̱jma̱á mbá jañii a̱kia̱nꞌlaꞌ guáꞌthi̱ínlaꞌ ga̱jma̱á majñu̱u̱ ski̱yu̱u̱ꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ.<verse eid="ROM 15:13" /></para>
  <para style="s">Páblo̱ naꞌthán-rúꞌúún ajngáa máján xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14" />A̱ngui̱nꞌ, ikhúúnꞌ nda̱yo̱o̱ mújúnꞌ rí ikháanꞌlaꞌ phú májáan a̱kia̱nꞌlaꞌ, jamí phú na̱ma̱ñalaꞌ máꞌ, kajngó ma̱goo máꞌ mu̱tha̱n-máꞌán-mijnálaꞌ ikháanꞌlaꞌ. <verse eid="ROM 15:14" /><verse number="15" style="v" sid="ROM 15:15" />Maske máꞌ xkuaꞌnii rá, a̱ngui̱nꞌ, ni̱ꞌngo̱o̱ a̱kui̱nꞌ ni̱tháán mu̱raxnuulaꞌ mbá tikhu rí na̱ma̱ñalaꞌ máꞌ, kajngó ma̱xámbumalaꞌ ne̱. Na̱ne̱ ríge̱ꞌ ga̱jma̱á numuu ñajun rí nixnángaweꞌ Ana̱ꞌlóꞌ rí ma̱ne̱, <verse eid="ROM 15:15" /><verse number="16" style="v" sid="ROM 15:16" />rí ma̱nindxu̱ꞌ yumbée Jesukrísto̱ ná majñu̱ú xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún. Wéje̱ inuꞌ rí ma̱tha̱n-rúꞌúu̱n ajngáa máján drígo̱o̱ Ana̱ꞌlóꞌ, kajngó ikhii̱n ma̱nindxúu̱n xó mbá tsi̱gi̱jña̱ꞌ rí ndaa thawuun, tsí ñajúún i̱ndo̱ó máꞌ xa̱bi̱i Ana̱ꞌlóꞌ eꞌne Xu̱u̱ꞌ máꞌ ikhaa̱.<verse eid="ROM 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 15:17" />Ikhaa jngó, ríga̱ numuu rí ma̱ꞌdxu a̱kui̱nꞌ ga̱jma̱á numuu ñajun rí na̱ne̱ ná inuu Ana̱ꞌlóꞌ, numuu rí Krísto̱ Jesús xtáa ga̱jma̱á nindxu̱ꞌ. <verse eid="ROM 15:17" /><verse number="18" style="v" sid="ROM 15:18" />Jamí tsíyoꞌ máꞌ gátha̱nꞌlaꞌ rí na̱ne̱ ikhúúnꞌ, rí nandoꞌ ma̱tha̱nꞌlaꞌ rí naꞌne Krísto̱ ga̱jma̱á majñu̱ꞌ ikhúúnꞌ, kajngó xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún ma̱nimbúu̱n juyáa̱ Ana̱ꞌlóꞌ. Ikhii̱n ninimbúu̱n ga̱jma̱á majñu̱u̱ ajngáa rí ni̱thúu̱n jamí ga̱jma̱á majñu̱u̱ ñajun rí na̱ne̱lo̱ꞌ, <verse eid="ROM 15:18" /><verse number="19" style="v" sid="ROM 15:19" />ga̱jma̱á ski̱yu̱u̱ꞌ rí phú wáá jamí rí ma̱makualóꞌ, rí naꞌne ski̱yu̱u̱ꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ. Xkuaꞌnii kajngó wámbo̱ꞌ ni̱tha̱n-ráꞌalo̱ꞌ ajngáa máján ga̱jma̱á numuu Krísto̱ asndo ná Jerusalén, jamí asndo mbá xúgíí xuajen rí triga̱ asndo ná numbaa Ilíri̱ko̱. <verse eid="ROM 15:19" /><verse number="20" style="v" sid="ROM 15:20" />Jámba̱ mbiꞌi ni̱ꞌgí-mina̱ꞌ rí ma̱tha̱n-ráꞌa ajngáa máján ga̱jma̱á numuu Krísto̱ ná xuajen rí xóó tsígu̱ma-nuwii̱n, xkuaꞌnii kajngó ma̱xáne̱-ra̱múꞌ ná tsu̱du̱u̱ rí niꞌgí máꞌ i̱mba̱a̱ꞌ. <verse eid="ROM 15:20" /><verse number="21" style="v" sid="ROM 15:21" />Ne̱ne̱ xómá ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="q" vid="ROM 15:21">«Ikhiin tsí ni miꞌtsú táwaꞌthúún ga̱jma̱á numuu̱, mbuyáa̱.</para>
  <para style="q" vid="ROM 15:21">Jamí ikhiin tsí túdxawíín ga̱jma̱á numuu̱, ma̱fruꞌúu̱n». <note caller="+" style="f"><char style="fr" closed="false">15.21 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 52.15.</char></note><verse eid="ROM 15:21" /></para>
  <para style="s">Páblo̱ naꞌgí-mina̱ꞌ rí ma̱ꞌga ná Róma̱</para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22" />Ikhaa numuu rúꞌkhue̱n, xóó máꞌ táyaphúún rí ma̱ꞌgá gáya̱ꞌlaꞌ. <verse eid="ROM 15:22" /><verse number="23" style="v" sid="ROM 15:23" />I̱ndo̱ó máꞌ numuu rí xúge̱ꞌ rá, wámbo̱ꞌ máꞌ ni̱tha̱n-ráꞌalo̱ꞌ ná numbaa ríge̱ꞌ, jamí phú wajyúú máꞌ ni̱ꞌgí-mina̱ꞌ rí ma̱ꞌgá gáya̱ꞌlaꞌ, <verse eid="ROM 15:23" /><verse number="24" style="v" sid="ROM 15:24" />ikhaa jngó ma̱ꞌgá gáya̱ꞌlaꞌ ído̱ gáꞌgálo̱ꞌ ná numbaa Espáña̱, jamí ma̱xtáá gagi mbá wátha̱ wáa mbiꞌi ga̱jma̱á nindxa̱ꞌlaꞌ. Wámba̱ rúꞌkhue̱n, nandoꞌ rí ikháanꞌlaꞌ mu̱mbáyúꞌlaꞌ rí ma̱gíꞌma̱alo̱ꞌ jamba̱a̱.<verse eid="ROM 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 15:25" />Rí xúge̱ꞌ rá, inu xtáá naka ja̱yo̱ꞌ ná Jerusalén rí mambáñúú a̱ngia̱nꞌlóꞌ tsí júwa̱ꞌ ikhín. <verse eid="ROM 15:25" /><verse number="26" style="v" sid="ROM 15:26" />Numuu rí a̱ngia̱nꞌlóꞌ tsí júwa̱ꞌ ná numbaa Masedónia̱ jamí Akáya̱, nigájnuu ná awúun a̱kuíi̱n rí mu̱ru̱waa̱ tháan mbúkha̱a̱, kajngó mu̱xu̱ꞌmee̱ ne̱ mambáñúú a̱ngia̱nꞌlóꞌ tsí ngíníi júwa̱ꞌ ná Jerusalén. <verse eid="ROM 15:26" /><verse number="27" style="v" sid="ROM 15:27" />Ikhii̱n ni̱ju̱múu̱ rí máján rí muni̱i̱ ríge̱ꞌ, jamí gakon máꞌ rí gíꞌmii̱ muni̱i̱ xkuaꞌnii mangaa. Numuu rí xa̱bo̱ judío̱ nixnee̱ rí mambáyúu ními̱í xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, xkuaꞌnii máꞌ gíꞌmii̱ mangii̱n rí mu̱xpi̱ꞌtha̱a̱ rí guáꞌdáa̱ kajngó mambáyúu xuñúú xa̱bo̱ judío̱. <verse eid="ROM 15:27" /><verse number="28" style="v" sid="ROM 15:28" />Ikhaa jngó, ído̱ gáne̱-mbánuu ñajun ríge̱ꞌ, jamí wámbo̱ꞌ ni̱xna̱xí mbúkha̱a̱ ríge̱ꞌ, a̱ꞌkhue̱n rí ma̱ga̱jnúꞌ ma̱ꞌgá Espáña̱ jamí ma̱nújngoꞌ gáya̱ꞌlaꞌ. <verse eid="ROM 15:28" /><verse number="29" style="v" sid="ROM 15:29" />Nda̱yo̱o̱ mújúnꞌ máꞌ rí ído̱ ma̱gánú a̱ꞌkhue̱n, gúꞌdo̱ꞌ guéño rí ma̱tha̱nꞌlaꞌ ga̱jma̱á numuu rí naꞌne-tsakun-rámáaꞌlóꞌ ajngáa máján drígo̱o̱<note caller="+" style="f"><char style="fr" closed="false">15.29 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «ajngáa máján drígo̱o̱».</char></note> Krísto̱.<verse eid="ROM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30" />A̱ngui̱nꞌ, ga̱jma̱á numuu Tátiálóꞌ Jesukrísto̱ jamí ga̱jma̱á máꞌ numuu rí Xu̱u̱ꞌ Ana̱ꞌlóꞌ naꞌne rí nandalaꞌ ju̱yo̱ꞌ, na̱nda̱ꞌa̱ꞌlaꞌ mu̱mbáyúꞌlaꞌ rí mu̱tha̱n-jáñíílaꞌ Ana̱ꞌlóꞌ ga̱jma̱á numuꞌ. <verse eid="ROM 15:30" /><verse number="31" style="v" sid="ROM 15:31" />Gu̱nda̱ꞌa̱laꞌ rí ma̱jríñu̱úꞌ ná ñawúún tsí tsínimbu̱únꞌ juyáá Jesús ná numbaa Judéa̱, jamí rí ma̱ni̱gu̱únꞌ a̱ngia̱nꞌlóꞌ tsí júwa̱ꞌ ná Jerusalén rí mu̱dríguíi̱ mbúkha̱a̱ rí naka ja̱yo̱ꞌ mambáñúu̱. <verse eid="ROM 15:31" /><verse number="32" style="v" sid="ROM 15:32" />Ikhaa jngó, xí Ana̱ꞌlóꞌ nandoo, gagi a̱kui̱nꞌ ma̱gánú ná juwalaꞌ a̱ꞌkhue̱n, jamí ma̱goo mba̱ya̱a xu̱ꞌ ga̱jma̱á nindxa̱ꞌlaꞌ. <verse eid="ROM 15:32" /><verse number="33" style="v" sid="ROM 15:33" />Ana̱ꞌlóꞌ, tsí naꞌne rí ma̱juwalóꞌ tsímáá, gáxtáa ga̱jma̱á nindxa̱ꞌlaꞌ mbá xúgiáanꞌlaꞌ. Xkuaꞌnii gáꞌne.<verse eid="ROM 15:33" /></para>
  <chapter eid="ROM 15" />
  <chapter number="16" style="c" sid="ROM 16" />
  <para style="s">Páblo̱ naraxi̱in xa̱bi̱i Jesús</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1" />Na̱xna̱ngáwalaꞌ tháan dxájwalóꞌ Fébe̱, tsí nambáyú-jmuu ná majñu̱ú tsí nanimbu̱únꞌ juyáá Jesús ná xuajen Senkréa̱. <verse eid="ROM 16:1" /><verse number="2" style="v" sid="ROM 16:2" />Gu̱dríguíi̱laꞌ xómá jaꞌyoo mbáa yumbée Táta̱, xómá jaꞌyoo rí mune̱-mba̱ꞌwo̱-mijná xa̱bi̱i Ana̱ꞌlóꞌ. Gu̱mbáyíi̱laꞌ asndo náá máꞌ rí ndaꞌyóo̱ ágúya̱álaꞌ, numuu rí ikhaa̱ phú mbaꞌiin xa̱bo̱ nimbáñúu̱, jamí asndo mangúúnꞌ máꞌ nimbáyíꞌ.<verse eid="ROM 16:2" /></para>
  <para style="ph">
    <verse number="3" style="v" sid="ROM 16:3" />Na̱ra̱xi̱ilo̱ꞌ Prisíla̱<note caller="+" style="f"><char style="fr" closed="false">16.3 </char><char style="ft" closed="false">Ikhaa máꞌ Prisíla̱ ñajuun Príska̱.</char></note> ga̱jma̱á Akíla̱, a̱ngui̱nꞌ tsí nu̱mbáyíꞌ rí na̱gu̱ma ñajuun Krísto̱ Jesús, <verse eid="ROM 16:3" /><verse number="4" style="v" sid="ROM 16:4" />jamí asndo inu ma̱ja̱ñúu̱ ga̱jma̱á numuꞌ ikhúúnꞌ. Ikhaa jngó na̱rígu̱u gamaku ná inúu̱, jamí ra̱ꞌkhá máꞌ i̱ndo̱ó ikhúúnꞌ, rí mbá xúgíí máꞌ kuthuun tsí nanimbu̱únꞌ juyáá Jesús tsí ra̱ꞌkháa xa̱bo̱ judío̱ ñajúún mangiin.<verse eid="ROM 16:4" /></para>
  <para style="ph">
    <verse number="5" style="v" sid="ROM 16:5" />Xúꞌkhue̱n máꞌ na̱ra̱xi̱inlo̱ꞌ tsí nanimbu̱únꞌ juyáá Jesús tsí na̱gi̱mbíin ná guꞌwóo Prisíla̱ ga̱jma̱á Akíla̱.</para>
  <para style="ph" vid="ROM 16:5">Na̱ra̱xi̱ilo̱ꞌ xa̱bo̱ iyanga̱jwe̱ꞌ Epéne̱to̱. Ikhaa̱ ñajuu̱n tsí ginii jayu ninimbo̱o̱ꞌ jaꞌyoo Krísto̱ ná numbaa Ásia̱.<verse eid="ROM 16:5" /></para>
  <para style="ph">
    <verse number="6" style="v" sid="ROM 16:6" />Na̱ra̱xi̱ilo̱ꞌ María̱, tsí phú niñajun ga̱jma̱á numalaꞌ.<verse eid="ROM 16:6" /></para>
  <para style="ph">
    <verse number="7" style="v" sid="ROM 16:7" />Na̱ra̱xi̱ilo̱ꞌ Andróni̱ko̱ ga̱jma̱á Júnia̱s, xa̱bo̱ xuajñuꞌ tsí nitraꞌi̱in géjwa̱nꞌ ga̱jma̱á nindxu̱ꞌ. Ikhii̱n na̱gu̱maꞌnuu̱ májíi̱n ná inúú tsí waxúngui̱inꞌ, jamí ginuu̱ ikhii̱n ninimbúu̱n juyáa̱ Krísto̱ xó rí ikhúúnꞌ.<verse eid="ROM 16:7" /></para>
  <para style="ph">
    <verse number="8" style="v" sid="ROM 16:8" />Na̱ra̱xi̱ilo̱ꞌ Ámplia̱s, iyanga̱jwe̱ꞌ tsí phú nandoꞌ ja̱yo̱o̱ ga̱jma̱á numuu Táta̱.<verse eid="ROM 16:8" /></para>
  <para style="ph">
    <verse number="9" style="v" sid="ROM 16:9" />Na̱ra̱xi̱ilo̱ꞌ Urbáno̱, tsí nañajun ga̱jma̱á nindxa̱ꞌxo̱ꞌ ná ñajuun Krísto̱. Xúꞌkhue̱n máꞌ na̱ra̱xi̱ilo̱ꞌ Estáki̱s mangaa, iyanga̱jwe̱ꞌ tsí phú nandoꞌ ja̱yo̱o̱.<verse eid="ROM 16:9" /></para>
  <para style="ph">
    <verse number="10" style="v" sid="ROM 16:10" />Na̱ra̱xi̱ilo̱ꞌ Apéle̱s, tsí phú mbaꞌa miꞌtsú nisngájma rí jmbii ná inuu Krísto̱.</para>
  <para style="ph" vid="ROM 16:10">Xúꞌkhue̱n máꞌ na̱ra̱xi̱inlo̱ꞌ xa̱bo̱ guꞌwóo Aristóbu̱lo̱.<verse eid="ROM 16:10" /></para>
  <para style="ph">
    <verse number="11" style="v" sid="ROM 16:11" />Na̱ra̱xi̱ilo̱ꞌ xa̱bo̱ xuajñuꞌ, Erodión.</para>
  <para style="ph" vid="ROM 16:11">Xúꞌkhue̱n máꞌ na̱ra̱xi̱inlo̱ꞌ xa̱bo̱ guꞌwóo Narsíso̱, tsí nanimbu̱únꞌ juyáá Táta̱ Jesukrísto̱.<verse eid="ROM 16:11" /></para>
  <para style="ph">
    <verse number="12" style="v" sid="ROM 16:12" />Na̱ra̱xi̱ilo̱ꞌ Triféna̱ ga̱jma̱á Trifósa̱, go̱ꞌo̱ tsí phú nuxna-mijná tsiakhe̱ rí mune̱ ñajuun Táta̱.</para>
  <para style="ph" vid="ROM 16:12">Xúꞌkhue̱n máꞌ na̱ra̱xi̱ilo̱ꞌ dxájwalóꞌ Pérsi̱da̱, tsí maphú niñajun ga̱jma̱á numuu Táta̱.<verse eid="ROM 16:12" /></para>
  <para style="ph">
    <verse number="13" style="v" sid="ROM 16:13" />Na̱ra̱xi̱ilo̱ꞌ Rúfo̱, tsí watraꞌwíi rí ma̱nimbo̱o̱ꞌ jaꞌyoo Táta̱, jamí xúꞌkhue̱n máꞌ nánée̱ mangaa, tsí ñajuun xómá nánéꞌ mangúúnꞌ.<verse eid="ROM 16:13" /></para>
  <para style="ph">
    <verse number="14" style="v" sid="ROM 16:14" />Na̱ra̱xi̱ilo̱ꞌ Asínkri̱to̱, Flegónte̱, Érma̱s, Patróba̱s, jamí Érme̱s mangaa. Xúꞌkhue̱n máꞌ na̱ra̱xi̱in a̱ngia̱nꞌlóꞌ tsí júwa̱ꞌ ga̱jma̱á nindxúu̱n.<verse eid="ROM 16:14" /></para>
  <para style="ph">
    <verse number="15" style="v" sid="ROM 16:15" />Na̱ra̱xi̱ilo̱ꞌ Filólo̱go̱ ga̱jma̱á Júlia̱, xúꞌkhue̱n máꞌ Neréo̱ ga̱jma̱á máꞌ dxáguíi̱ mangaa. Xúꞌkhue̱n máꞌ na̱ra̱xi̱ilo̱ꞌ Olímpa̱s jamí mbá xúgíin a̱ngia̱nꞌlóꞌ tsí júwa̱ꞌ ga̱jma̱á nindxúu̱n.<verse eid="ROM 16:15" /></para>
  <para style="ph">
    <verse number="16" style="v" sid="ROM 16:16" />Gu̱ra̱xi̱-mijnáalaꞌ mbá xúgiáanꞌlaꞌ ga̱jma̱á gamaku.</para>
  <para style="ph" vid="ROM 16:16">Nu̱ra̱xáanꞌlaꞌ mbá xúgíí kuthuun tsí nanimbu̱únꞌ juyáá Krísto̱.<verse eid="ROM 16:16" /></para>
  <para style="s">Rí naxnángoo Páblo̱ nda̱wa̱á jayu</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17" />A̱ngui̱nꞌ, na̱tha̱n-jáñalaꞌ rí gu̱ña̱wa̱n-mijnálaꞌ inúú tsí nune̱ rí mu̱xpi̱ꞌtha̱-mijná xa̱bo̱, jamí nune̱ rí ma̱ꞌne a̱jma̱ a̱kui̱ín mbá tikhuun ga̱jma̱á numuu rí kriꞌkhu isngáa̱ xó rí ni̱ma̱ñalaꞌ ikháanꞌlaꞌ. Ma̱xámbáxa̱ꞌlaꞌ gajmiálaꞌ xa̱bo̱ tsúꞌkhue̱n. <verse eid="ROM 16:17" /><verse number="18" style="v" sid="ROM 16:18" />Numuu rí ikhii̱n ra̱ꞌkhá ñajuun Tátiálóꞌ Jesukrísto̱ ini̱i̱, rí i̱ndo̱ó máꞌ nu̱ñajwii̱n ga̱jma̱á numuu rí nandúu̱n máꞌ ikhii̱n, jamí ga̱jma̱á ajngáa mi̱nduwa rí mitsaan iwán nune̱-nduwii̱n xa̱bo̱ tsí tsíma̱ñúú. <verse eid="ROM 16:18" /><verse number="19" style="v" sid="ROM 16:19" />Mbá xúgíin xa̱bo̱ nduyáá rí ikháanꞌlaꞌ nu̱ne̱-mbáníílaꞌ ajngóo Jesús. Ikhaa jngó phú nadxu a̱kui̱nꞌ e̱ne̱laꞌ. I̱ndo̱ó máꞌ numuu rí nandoꞌ rí phú wiphiáanꞌlaꞌ gáꞌne rí mu̱ne̱laꞌ rí máján, ra̱ꞌkhá rí mu̱ne̱laꞌ rí xkawe̱ꞌ.<verse eid="ROM 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 16:20" />Ana̱ꞌlóꞌ, tsí naꞌne rí ma̱juwalóꞌ tsímáá, inu máꞌ masngutiga̱a̱ Satanás ná agoo nakhuálaꞌ. Tátiálóꞌ Jesukrísto̱<note caller="+" style="f"><char style="fr" closed="false">16.20 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «Tátiálóꞌ Jesús».</char></note> gáꞌne-tsakun-rámáaꞌlaꞌ.<verse eid="ROM 16:20" /></para>
  <para style="s">Mbaꞌiin tsí nu̱ra̱xi̱in xa̱bi̱i Jesús tsí júwa̱ꞌ ná Róma̱</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21" />Naraxáa̱nꞌlaꞌ Timotéo̱, dxájuꞌ tsí na̱ñajun ga̱jmi̱ꞌ. Xúꞌkhue̱n máꞌ nu̱ra̱xáa̱nꞌlaꞌ xa̱bo̱ xuajñuꞌ Lúsio̱, Jasón, jamí Sosípa̱te̱r.<verse eid="ROM 16:21" /></para>
  <para style="ph">
    <verse number="22" style="v" sid="ROM 16:22" />Ikhúúnꞌ ñajunꞌ Térsio̱, tsúún ni̱tháánlo̱ꞌ i̱yi̱i̱ꞌ ríge̱ꞌ. Na̱ra̱xáanꞌlaꞌ mangúúnꞌ ga̱jma̱á majñu̱u̱ Táta̱.<verse eid="ROM 16:22" /></para>
  <para style="ph">
    <verse number="23" style="v" sid="ROM 16:23" />Naraxáa̱nꞌlaꞌ Gáyo̱, tsí xtáálo̱ꞌ ná guꞌwóo, jamí ikhaa̱ máꞌ naxnátiꞌñee̱ guꞌwóo rí ma̱gi̱mbíin mbá xúgíin tsí nanimbu̱únꞌ juyáá Jesús ge̱jyoꞌ.</para>
  <para style="ph" vid="ROM 16:23">Naraxáa̱nꞌlaꞌ Erásto̱ mangaa, tsí na̱ña̱wu̱u̱n mbúkho̱o̱ guꞌwá-ñajun.</para>
  <para style="ph" vid="ROM 16:23">Xúꞌkhue̱n máꞌ dxájwalóꞌ Kuárto̱ mangaa, naraxáa̱nꞌlaꞌ.<verse eid="ROM 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 16:24" />Tátiálóꞌ Jesukrísto̱ gáꞌne-tsakun-rámáaꞌlaꞌ mbá xúgiáanꞌlaꞌ. Xkuaꞌnii gáꞌne.<note caller="+" style="f"><char style="fr" closed="false">16.24 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa rí tima ná kíxnuu 24.</char></note><verse eid="ROM 16:24" /></para>
  <para style="s">A̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ Jesukrísto̱</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25" />Gu̱ꞌne̱-mba̱a̱lóꞌ Ana̱ꞌlóꞌ. Ikhaa̱ na̱ma̱ñuu̱ ma̱ꞌnii̱ rí ma̱wajún-gúkuálaꞌ ga̱jma̱á majñu̱u̱ ajngáa máján rí na̱sngáálo̱ꞌ jamí ga̱jma̱á majñu̱u̱ gisngáá rí na̱tha̱n-ráꞌalo̱ꞌ ga̱jma̱á numuu Jesukrísto̱. Ajngáa máján ríge̱ꞌ ñajuun awan drígo̱o̱ Ana̱ꞌlóꞌ rí i̱ndo̱ó máꞌ ikhaa̱ ni̱gi̱da̱ꞌ idxu̱u̱ nákhí wajyúú, rí niríga̱ ngu̱ꞌwa̱ asndo nákhí máꞌ xóó nda̱a̱ numbaa. <verse eid="ROM 16:25" /><verse number="26" style="v" sid="ROM 16:26" />Xómáꞌ xúge̱ꞌ rá, nikujma ne̱ ga̱jma̱á majñu̱u̱ rí nitháán tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ, xómá nixnángoo Ana̱ꞌlóꞌ tsí xtáa jámuu. Awan ríge̱ꞌ, rí ni̱gi̱ꞌdoo ngu̱ꞌwo̱o̱ Ana̱ꞌlóꞌ, ni̱ma̱ꞌthoo ne̱ ná inúú mbá xúgíin xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, kajngó ma̱nimbúu̱n juyáa̱ gisngáá ga̱jma̱á numuu Jesús. <verse eid="ROM 16:26" /><verse number="27" style="v" sid="ROM 16:27" />Ga̱jma̱á majñu̱u̱ Jesukrísto̱, a̱gu̱ma-mba̱a̱ jámuu Ana̱ꞌlóꞌ tsí mbáwíi phú na̱ma̱ñuu. Xkuaꞌnii gáꞌne.<verse eid="ROM 16:27" /></para>
  <chapter eid="ROM 16" />
</usx>