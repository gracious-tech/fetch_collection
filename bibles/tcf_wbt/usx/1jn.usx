<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id">tcfU (63-1Juan) - Me̱ꞌpha̱a̱ Mañuwi̱ín (Malinaltepec), c5/v105</book>
  <para style="h">1 Juáán</para>
  <para style="toc3">1 Jn</para>
  <para style="toc2">1 Juáán</para>
  <para style="toc1">Timbá i̱yi̱i̱ꞌ rí niꞌtháán Juáán</para>
  <para style="mt2">Timbá i̱yi̱i̱ꞌ rí niꞌtháán</para>
  <para style="mt1">Juáán</para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s">Ajngáa tsí naꞌne rí ma̱ju̱wá mbá jámuu xa̱bo̱</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />Nu̱tha̱nxo̱ꞌ rí mu̱dxawíínlaꞌ ga̱jma̱á numuu tsí xtáa máꞌ asndo nákhí ginii jayu, tsí ni̱dxawíínxo̱ꞌ, tsí ndi̱ya̱áxo̱ꞌ ga̱jma̱á idaxo̱ꞌ, tsí ni̱ya̱xi̱íxo̱ꞌ, jamí asndo ni̱xkajmaaxo̱ꞌ ga̱jma̱á ñawánxo̱ꞌ. Ikhaa tsíge̱ꞌ ñajuun Ajngáa tsí naꞌne rí ma̱ju̱wá mbá jámuu xa̱bo̱. <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" />Tsúꞌkhue̱n nisngájma-mina̱ꞌ jamí ikháanꞌ ndi̱yáaxo̱ꞌ, ikhaa jngó nu̱tha̱nxo̱ꞌ rí gakon nikujmaa̱, xúꞌkhue̱n máꞌ nu̱tha̱n-ráꞌalaꞌxo̱ꞌ rí ma̱goo ma̱juwalaꞌ mbá jámuu. Ikhaa̱ xtáa̱ jayu ga̱jmáa̱ Ana̱ꞌlóꞌ Mikhuíí, jamí nisngájma-mine̱e̱ꞌ ná inaxo̱ꞌ. <verse eid="1JN 1:2" /><verse number="3" style="v" sid="1JN 1:3" />Rí ndi̱ya̱áxo̱ꞌ ga̱jma̱á rí ni̱dxawíínxo̱ꞌ, ikhaa rúꞌkhue̱n nu̱tha̱nxo̱ꞌ rí mu̱dxawíínlaꞌ, kajngó mangáanꞌlaꞌ mbóó gámbáxa̱ꞌlaꞌ ga̱jma̱á nindxa̱ꞌxo̱ꞌ, xómá rí ikháanꞌxo̱ꞌ nambáxa̱ꞌxo̱ꞌ gajmiáxo̱ꞌ Ana̱ꞌlóꞌ Mikhuíí, xúꞌkhue̱n máꞌ ga̱jma̱á nindxu̱u̱ Jesukrísto̱, tsí A̱dée̱ máꞌ ikhaa̱. <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />Nu̱tháánxo̱ꞌ i̱yi̱i̱ꞌ ríge̱ꞌ ma̱ꞌga inalaꞌ kajngó ma̱ꞌne káxe̱ rí gagi a̱kia̱nꞌlaꞌ.<note caller="+" style="f"><char style="fr" closed="false">1.4 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «gagi a̱kia̱nꞌlóꞌ».</char></note><verse eid="1JN 1:4" /></para>
  <para style="s">Ana̱ꞌlóꞌ naꞌne mba̱a̱ a̱kui̱in jaꞌyoo aꞌkhánlóꞌ</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />Ríge̱ꞌ ñajuun ajngóo Jesukrísto̱ rí ni̱dxawíínxo̱ꞌ rí niꞌthée̱n, jamí nu̱tha̱nxo̱ꞌ ne̱ rí mu̱dxawíínlaꞌ: Ana̱ꞌlóꞌ Mikhuíí ñajuun agu rí nambiꞌi taꞌa, jamí nda̱a̱ nitháan rí mijína ná inuu̱ ikhaa̱. <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />Xí nuꞌthánlóꞌ rí nambáxa̱ꞌlóꞌ gajmiálóꞌ Ana̱ꞌlóꞌ, jamí xóó ngriga̱ꞌlóꞌ ná mijína, a̱ꞌkhue̱n rí nu̱ꞌne̱-nduwalóꞌ, jamí na̱nguá juwalóꞌ nu̱ꞌne̱ rí gakon. <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />Xúꞌkhue̱n máꞌ xí ngriga̱ꞌlóꞌ ná nambiꞌi agu, xómá rí Ana̱ꞌlóꞌ Mikhuíí xtáa ná nambiꞌi agu, a̱ꞌkhue̱n rí nambáxa̱ꞌlóꞌ gajmiálóꞌ a̱ngia̱nꞌlóꞌ jamí ga̱jma̱á majñu̱u̱ iꞌdiuu Jesukrísto̱, Ana̱ꞌlóꞌ naꞌne mba̱a̱ a̱kui̱in jaꞌyoo mbá xúgíí aꞌkhánlóꞌ.<verse eid="1JN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8" />Xí nuꞌthánlóꞌ rí na̱nguá guaꞌdáálóꞌ aꞌkhán, nu̱ꞌne̱-nduwa-mijná máꞌ ikháánꞌlóꞌ, jamí na̱nguá ríga̱ rí gakon ná awúun a̱kia̱nꞌlóꞌ. <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />Xúꞌkhue̱n máꞌ xí nu̱ꞌne̱-maphú aꞌkhánlóꞌ ná inuu Ana̱ꞌlóꞌ, ikhaa̱ phú májáan a̱kuii̱n jamí phú jmbii̱ rí ma̱ꞌne mba̱a̱ a̱kuii̱n jaꞌyoo̱ aꞌkhánlóꞌ. Xúꞌkhue̱n máꞌ ma̱ꞌne-jaꞌwáa̱nꞌlóꞌ inuu mbá xúgíí rí ra̱máján ne̱ꞌne̱lóꞌ. <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />Jamí xí nuꞌthánlóꞌ rí na̱nguá gíꞌmáálóꞌ aꞌkhán, nuꞌthánlóꞌ rí mi̱nduwaa Ana̱ꞌlóꞌ, jamí nakujma rí na̱nguá ríga̱ ajngóo̱ ná awúun a̱kia̱nꞌlóꞌ.<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="s">Krísto̱ ñajuun tsí naꞌthán mbáá numalóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />Na̱tháánlo̱ꞌ ajngáa ríge̱ꞌ ma̱ꞌga ná inalaꞌ, ikháanꞌlaꞌ tsáanꞌ ñajwanlaꞌ xómá i̱ji̱nꞌ, kajngó mu̱xúne̱laꞌ aꞌkhán. Jamí xí mbáa neꞌne aꞌkhán rá, kuaꞌdaalóꞌ mbáa tsí maꞌthán mbáá numalóꞌ ná inuu Ana̱ꞌlóꞌ Mikhuíí. Ikhaa tsúꞌkhue̱n ñajuun Jesukrísto̱ tsí jmbii. <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />Ikhaa̱ nixnáxe̱-mine̱e̱ꞌ rí ma̱ja̱ñúu̱ kajngó ma̱goo ma̱ꞌne mba̱a̱ a̱kui̱in Ana̱ꞌlóꞌ jaꞌyoo aꞌkhánlóꞌ. Jamí ra̱ꞌkhá máꞌ i̱ndo̱ó ga̱jma̱á numuu aꞌkhánlóꞌ ikháánꞌlóꞌ, rí ga̱jma̱á máꞌ numuu aꞌkhúún mbá xúgíin xa̱bo̱ numbaa mangaa.<verse eid="1JN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3" />Xí nu̱ꞌne̱-mbáníílóꞌ xtángawoo Ana̱ꞌlóꞌ, a̱ꞌkhue̱n rí naꞌne jañii a̱kia̱nꞌlóꞌ rí nu̱ꞌne̱-nuwii̱nlóꞌ ikhaa̱. <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />Xúꞌkhue̱n máꞌ xí mbáa xa̱bo̱ naꞌthán: «Ikhúúnꞌ na̱ne̱-núwíinlo̱ꞌ Ana̱ꞌlóꞌ», jamí tsíꞌne-mbánuu̱ rí naꞌthán xtángawoo Ana̱ꞌlóꞌ, ikhaa xa̱bo̱ tsúꞌkhue̱n mi̱nduwaa, jamí nda̱a̱ rí gakon ná a̱kuii̱n. <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />Xómáꞌ tsí nandoo jaꞌyoo Ana̱ꞌlóꞌ ga̱jma̱á mbá jañii a̱kui̱in rá, tsúꞌkhue̱n tsí naꞌne-mbánuu ajngóo Ana̱ꞌlóꞌ. Xí xúꞌkhue̱n e̱ꞌne̱lóꞌ, nduꞌyáálóꞌ rí juwalóꞌ mbóó ga̱jma̱á nindxu̱u̱ Ana̱ꞌlóꞌ. <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />Xa̱bo̱ tsí naꞌthán rí xtáa jayu ga̱jma̱á nindxu̱u̱ Ana̱ꞌlóꞌ, gíꞌmaa ma̱xtáa̱ xómá rí nixtáa Jesukrísto̱.<verse eid="1JN 2:6" /></para>
  <para style="s">Xtángoo nuxe̱ꞌ</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />A̱ngui̱nꞌ, tsítháánlo̱ꞌ mbá xtángoo nuxe̱ꞌ rí ma̱ꞌga ná inalaꞌ, rí na̱tháánlo̱ꞌ xtángoo wayuu rí ni̱drígúlaꞌ máꞌ asndo nákhí ginii jayu. Xtángoo ríge̱ꞌ ñajuun ajngáa rí ni̱dxawíínlaꞌ máꞌ asndo nákhí ginii jayu. <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />I̱ndo̱ó máꞌ numuu rí xtángoo nuxe̱ꞌ ñajuun ne̱ mangaa. Xómá rí nixtáa Krísto̱ jamí xómá rí juwa ikháanꞌlaꞌ, nasngájma rí gakon ne̱. Numuu rí na̱ka̱-rayámba̱ máꞌ rí mijína, jamí agu rí gakon na̱ka̱-rambiꞌi máꞌ.<verse eid="1JN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9" />Tsí naꞌthán rí xtáa ná nambiꞌi agu, jamí tsíyoo jaꞌyoo dxájuu, xóó máꞌ xtáa̱ ná mijína. <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />Xómáꞌ xa̱bo̱ tsí nandoo jaꞌyoo dxájuu rá, tsúꞌkhue̱n xtáa mbá jayu ná nambiꞌi agu, jamí nda̱a̱ nitháan rí ma̱ꞌne-ngra̱ꞌa-mine̱e̱ꞌ ga̱jma̱á. <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />Xómáꞌ tsí tsíyoo jaꞌyoo dxájuu rá, xtáa̱ ná mijína, jamí xóó ngrigo̱o̱ꞌ ná mijína. Na̱nguá iꞌyoo̱ náá i̱ke̱e̱, numuu rí mijína naꞌne rí tsífrigo̱o̱ꞌ.<verse eid="1JN 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="1JN 2:12" />I̱ji̱nꞌ, na̱tháánlo̱ꞌ i̱yi̱i̱ꞌ ríge̱ꞌ ma̱ꞌga inalaꞌ,</para>
  <para style="q" vid="1JN 2:12">numuu rí ga̱jma̱á majñu̱u̱ Krísto̱, Ana̱ꞌlóꞌ naꞌne mba̱a̱ a̱kui̱in jaꞌyoo aꞌkhánlaꞌ.<verse eid="1JN 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="1JN 2:13" />Xa̱bo̱ buanuu, na̱tháánlo̱ꞌ i̱yi̱i̱ꞌ ríge̱ꞌ ma̱ꞌga inalaꞌ,</para>
  <para style="q" vid="1JN 2:13">numuu rí nu̱ne̱-nuwiinlaꞌ tsí xtáa asndo nákhí ginii jayu.</para>
  <para style="q" vid="1JN 2:13">Jñáma, na̱tháánlo̱ꞌ i̱yi̱i̱ꞌ ríge̱ꞌ ma̱ꞌga inalaꞌ,</para>
  <para style="q" vid="1JN 2:13">numuu rí ni̱ꞌnga̱ꞌlaꞌ ne̱ne̱-gajmiálaꞌ xa̱bo̱ xkawi̱i̱ꞌ.</para>
  <para style="q" vid="1JN 2:13">I̱ji̱nꞌ, na̱tháán i̱yi̱i̱ꞌ<note caller="+" style="f"><char style="fr" closed="false">2.13 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ rí wayuu ná mbá xúgíí ajngáa ga̱jma̱á numúú e̱je̱n na̱ꞌkha̱ ná kíxnuu 14, xúꞌkhue̱n máꞌ ríga̱ i̱yi̱i̱ꞌ wayuu rí naꞌthán «ni̱tháán i̱yi̱i̱ꞌ».</char></note> ríge̱ꞌ ma̱ꞌga inalaꞌ,</para>
  <para style="q" vid="1JN 2:13">numuu rí ne̱ne̱-nuwiinlaꞌ Ana̱ꞌlóꞌ Mikhuíí.<verse eid="1JN 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="1JN 2:14" />Xa̱bo̱ buanuu, ni̱tháán i̱yi̱i̱ꞌ ríge̱ꞌ ma̱ꞌga inalaꞌ,</para>
  <para style="q" vid="1JN 2:14">numuu rí ne̱ne̱-nuwiinlaꞌ tsí xtáa asndo nákhí ginii jayu.</para>
  <para style="q" vid="1JN 2:14">Jñáma, ni̱tháán i̱yi̱i̱ꞌ ríge̱ꞌ ma̱ꞌga inalaꞌ,</para>
  <para style="q" vid="1JN 2:14">numuu rí gúkuáa̱nꞌlaꞌ,</para>
  <para style="q" vid="1JN 2:14">xúꞌkhue̱n máꞌ ríga̱ jayu ajngóo Ana̱ꞌlóꞌ ná awúun a̱kia̱nꞌlaꞌ,</para>
  <para style="q" vid="1JN 2:14">jamí ni̱ꞌnga̱ꞌlaꞌ ne̱ne̱-gajmiálaꞌ xa̱bo̱ xkawi̱i̱ꞌ.<verse eid="1JN 2:14" /></para>
  <para style="s">Ma̱xágalóꞌ juꞌyáá rí ríga̱ ná numbaa</para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />Ma̱xágalaꞌ ju̱ya̱á rí xkawe̱ꞌ nune̱ xa̱bo̱ ná numbaa ríge̱ꞌ, ni máꞌ ma̱xágalaꞌ ju̱ya̱á rí ríga̱ guéño ná inuu numbaa. Xí mbáa nandoo jaꞌyoo rí xkawe̱ꞌ nune̱ xa̱bo̱ ná numbaa ríge̱ꞌ, ikhaa tsúꞌkhue̱n tsíyoo jaꞌñúú xa̱bo̱ xómá naꞌne Ana̱ꞌlóꞌ Mikhuíí. <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />Numuu rí mbá xúgíí rí ríga̱ ná numbaa ríge̱ꞌ, ikhaa ñajuun: rí nandoo xuyuu xa̱bo̱, rí na̱ni̱gu̱u̱ꞌ xa̱bo̱ ma̱gi̱ꞌdoo rí ndaꞌyoo, jamí rí nakúxe̱-mina̱ꞌ xa̱bo̱ ga̱jma̱á numuu rí gíꞌdoo. Mbá xúgíí rúꞌkhue̱n na̱ꞌkha̱ ná numbaa ríge̱ꞌ, ra̱ꞌkhá ná inuu Ana̱ꞌlóꞌ Mikhuíí i̱ꞌkha̱ ne̱. <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />Mbáá máꞌ rí numbaa na̱ka̱-rayámba̱a la, ga̱jma̱á mbá xúgíí rí na̱ni̱gu̱u̱ꞌ guéño xa̱bo̱. Xómáꞌ tsí naꞌne rí nandoo Ana̱ꞌlóꞌ, ma̱xtáa mbá jámuu.<verse eid="1JN 2:17" /></para>
  <para style="s">Xa̱bo̱ tsí gíꞌdaa sia̱nꞌ Krísto̱</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />I̱ji̱nꞌ, na̱ka̱-ra̱tri̱go̱o̱ máꞌ mbiꞌi rí ma̱mbá numbaa. Xómá rí ni̱dxawíínlaꞌ rí wéje̱ rí ma̱ꞌkha̱ xa̱bo̱ tsí sia̱nꞌ ga̱jma̱á Krísto̱, xkuaꞌnii máꞌ xúge̱ꞌ na̱ka̱-rakujmii guéño xa̱bo̱ tsí sia̱nꞌ gajmíí Krísto̱. Ikhaa numuu rúꞌkhue̱n nduꞌyáálóꞌ rí na̱ka̱-ra̱tri̱go̱o̱ máꞌ mbiꞌi rí ma̱mbá numbaa. <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />Xa̱bo̱ tsúꞌkhue̱n nigájnúú ná majña̱ꞌlóꞌ, i̱ndo̱ó máꞌ numuu rí ra̱ꞌkhíin a̱ngia̱nꞌlóꞌ ñajúu̱n. Xí numuu rí a̱ngia̱nꞌlóꞌ ñajúu̱n, tágájnúu̱ máꞌ ná majña̱ꞌlóꞌ xúꞌkhue̱n rá. I̱ndo̱ó máꞌ numuu rí nigájnúu̱, kajngó ma̱kujma rí ra̱ꞌkhá mbá xúgíin tsí júwa̱ꞌ ná majña̱ꞌlóꞌ ñajúún a̱ngia̱nꞌlóꞌ.<verse eid="1JN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20" />Xómáꞌ ikháanꞌlaꞌ ni̱dríguíilaꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ neꞌne Krísto̱, ikhaa jngó nu̱ne̱-nuwiinlaꞌ mbá xúgíí rí gakon. <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />Na̱tháánlo̱ꞌ i̱yi̱i̱ꞌ ríge̱ꞌ ma̱ꞌga inalaꞌ, ra̱ꞌkhá numuu rí tsíne̱ nuwiinlaꞌ rí gakon, rí na̱tháán ne̱ numuu rí nu̱ne̱-nuwiinlaꞌ ne̱, jamí tsígájnuu nimbá rí mi̱nduwa ná awúun rí gakon. <verse eid="1JN 2:21" /><verse number="22" style="v" sid="1JN 2:22" />Tsáa ñajuun tsí mi̱nduwaa rá. Ikhaa tsí naꞌthán rí ra̱gákon rí Jesús ñajuun Krísto̱. Tsúꞌkhue̱n ñajuun xa̱bo̱ tsí sia̱nꞌ ga̱jma̱á Krísto̱, numuu rí tsíya-makuu̱ Ana̱ꞌlóꞌ Mikhuíí ni máꞌ A̱dée̱. <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />Jámba̱a̱ tsí tsíya-makuu A̱dée Ana̱ꞌlóꞌ, ndawa̱a̱ Ana̱ꞌlóꞌ Mikhuíí ga̱jma̱á nindxu̱u̱. Xómáꞌ tsí naꞌthán rí nanimbo̱o̱ꞌ jaꞌyoo A̱dée Ana̱ꞌlóꞌ rá, xtáa Ana̱ꞌlóꞌ Mikhuíí ga̱jma̱á nindxu̱u̱.<verse eid="1JN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24" />Ga̱ri̱gá jayu ná awúun a̱kia̱nꞌlaꞌ rí ni̱dxawíínlaꞌ asndo nákhí ginii jayu. Xí rí ni̱dxawíínlaꞌ asndo nákhí ginii jayu ríga̱ jayu ná awúun a̱kia̱nꞌlaꞌ, a̱ꞌkhue̱n rí ma̱juwalaꞌ jayu ga̱jma̱á nindxu̱u̱ A̱dée Ana̱ꞌlóꞌ jamí ga̱jma̱á nindxu̱u̱ máꞌ Ana̱ꞌlóꞌ Mikhuíí. <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />Jamí ríge̱ꞌ ñajuun rí nixuda-mina̱ꞌ Jesukrísto̱ ga̱jma̱á nindxa̱ꞌlóꞌ, rí ma̱juwalóꞌ mbá jámuu.<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />Na̱tháán i̱yi̱i̱ꞌ ríge̱ꞌ ma̱ꞌga inalaꞌ ga̱jma̱á numúú xa̱bo̱ tsí nandúún gúne̱-nduwáanꞌlaꞌ. <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />Xómáꞌ ikháanꞌlaꞌ, ni̱dríguíilaꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ neꞌne Jesukrísto̱, xúꞌkhue̱n máꞌ xtáa̱ jayu ga̱jma̱á nindxa̱ꞌlaꞌ, ikhaa jngó tsíꞌyóo máꞌ rí nimbáa maꞌsngálaꞌ. Ikhaa máꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ naꞌsngálaꞌ mbá xúgíí rí gakon, jamí ra̱ꞌkhá rí mi̱nduwa ñajuun ne̱. Ikhaa jngó xómá rí Xu̱u̱ꞌ Ana̱ꞌlóꞌ niꞌsngálaꞌ, xkuaꞌnii máꞌ ga̱juwalaꞌ jayu ga̱jma̱á nindxu̱u̱ Krísto̱.<verse eid="1JN 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28" />Rí xúge̱ꞌ rá, i̱ji̱nꞌ, ga̱juwalaꞌ jayu ga̱jma̱á nindxu̱u̱ Krísto̱, kajngó ído̱ gákujmaa̱ inalóꞌ, a̱ꞌkhue̱n rí mbá jañii a̱kia̱nꞌlóꞌ gájuwalóꞌ inuu̱, xúꞌkhue̱n máꞌ ma̱xáti̱ya̱ꞌlóꞌ ído̱ mbu̱ꞌyáa̱lóꞌ. <verse eid="1JN 2:28" /><verse number="29" style="v" sid="1JN 2:29" />Numuu rí ndu̱ya̱álaꞌ máꞌ rí Krísto̱ ñajuun tsí naꞌne rí máján, xúꞌkhue̱n máꞌ mangaa a̱gu̱ya̱álaꞌ rí jámba̱a̱ tsí naꞌne rí máján, tsúꞌkhue̱n ñajuun a̱dée Ana̱ꞌlóꞌ.<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="s">Tsí ñajúún i̱ji̱in Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />A̱gu̱ya̱álaꞌ rí ra̱ꞌkhá tháán nandoo Ana̱ꞌlóꞌ Mikhuíí jaꞌyalóꞌ, rí asndo naꞌne mbiꞌyalóꞌ i̱ji̱in Ana̱ꞌlóꞌ. ¡Jamí ikhaa máꞌ ñajwanlóꞌ!<note caller="+" style="f"><char style="fr" closed="false">3.1 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná tsíꞌkha̱ ajngáa ríge̱ꞌ: «Jamí ikhaa máꞌ ñajwanlóꞌ».</char></note> Ikhaa numuu rúꞌkhue̱n xa̱bo̱ tsí júwa̱ꞌ ná numbaa ríge̱ꞌ tsíyáa̱ rí i̱ji̱in Ana̱ꞌlóꞌ ñajwanlóꞌ, numuu rí ikhii̱n tsínimbúu̱n juyáa̱ Ana̱ꞌlóꞌ. <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />A̱ngui̱nꞌ, tsáanꞌ phú nandoꞌ ja̱ya̱ꞌlaꞌ, rí xúge̱ꞌ rá, i̱ji̱in máꞌ Ana̱ꞌlóꞌ ñajwanlóꞌ, jamí xóó máꞌ tsíkujma rí ma̱nindxa̱ꞌlóꞌ nda̱wa̱á. I̱ndo̱ó máꞌ numuu rí nduꞌyáálóꞌ máꞌ rí ído̱ ma̱ꞌkha̱a Krísto̱, ma̱nindxa̱ꞌlóꞌ xómá jaꞌnii̱ jayu ikhaa̱, numuu rí mbu̱ꞌyáa̱lóꞌ xómá jaꞌnii̱ jayu ikhaa̱. <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />Jamí jámba̱a̱ tsí gíꞌthu̱u̱n ga̱jma̱á mbá jañii a̱kui̱in ríge̱ꞌ ná inuu̱ ikhaa̱, naꞌne-khaꞌwu-minaa̱ꞌ máꞌ xúꞌkhue̱n, xómá rí khaꞌwii Krísto̱.<verse eid="1JN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4" />Jámba̱a̱ xa̱bo̱ tsí naꞌne aꞌkhán, tsúꞌkhue̱n tsíꞌne-mbánuu rí naꞌthán xtángoo. Numuu rí ído̱ tsígu̱ma-mbáníí xtángoo, aꞌkhán ñajuun rúꞌkhue̱n. <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />Ndu̱ya̱á máꞌ ikháanꞌlaꞌ rí Krísto̱ ni̱ꞌkha̱ rí marngudi̱i aꞌkhánlóꞌ. Jamí ikhaa̱ na̱nguá gíꞌdoo̱ nimbá aꞌkhán. <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />Jámba̱a̱ xa̱bo̱ tsí xtáa jayu ga̱jma̱á nindxu̱u̱ ikhaa̱, tsíꞌnii̱ máꞌ xúꞌkhue̱n aꞌkhán. Jamí jámba̱a̱ xa̱bo̱ tsí naꞌne máꞌ xúꞌkhue̱n aꞌkhán, táꞌyoo̱ Krísto̱, ni máꞌ táꞌne-nuwii̱n. <verse eid="1JN 3:6" /><verse number="7" style="v" sid="1JN 3:7" />I̱ji̱nꞌ, mu̱xúni̱ꞌñá-mijnálaꞌ rí ma̱ꞌne-nduwáanꞌlaꞌ nimbáa. Tsí naꞌne rí máján, xa̱bo̱ tsí májáan ñajuun tsúꞌkhue̱n, xómá rí májáan Krísto̱. <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />Xa̱bo̱ tsí naꞌne máꞌ xúꞌkhue̱n aꞌkhán, xa̱bi̱i gixa̱a̱ ñajuun tsúꞌkhue̱n. Numuu rí gixa̱a̱ naꞌne máꞌ xúꞌkhue̱n aꞌkhán asndo nákhí ginii jayu. Ikhaa numuu rúꞌkhue̱n ni̱ꞌkha̱ A̱dée Ana̱ꞌlóꞌ kajngó ma̱ꞌne-gámba̱a rí naꞌne jayu gixa̱a̱. <verse eid="1JN 3:8" /><verse number="9" style="v" sid="1JN 3:9" />Jámba̱a̱ xa̱bo̱ tsí ñajuun a̱dée Ana̱ꞌlóꞌ, tsíꞌne máꞌ xúꞌkhue̱n aꞌkhán, numuu rí ski̱yu̱u̱ꞌ Ana̱ꞌlóꞌ ríga̱ jayu ná awúun a̱kuii̱n. Tsíyoo ma̱ꞌnii̱ máꞌ xúꞌkhue̱n aꞌkhán, numuu rí a̱dée Ana̱ꞌlóꞌ ñajuu̱n. <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />Xáꞌnii ma̱kujma tsíin ñajúún i̱ji̱in Ana̱ꞌlóꞌ, jamí xúꞌkhue̱n máꞌ tsíin ñajúún i̱ji̱in gixa̱a̱: jámba̱a̱ xa̱bo̱ tsí tsíꞌne rí máján, ni máꞌ tsíyoo jaꞌyoo dxájuu, ra̱ꞌkhá a̱dée Ana̱ꞌlóꞌ ñajuun tsúꞌkhue̱n.<verse eid="1JN 3:10" /></para>
  <para style="s">Gíꞌmaa rí ma̱galóꞌ juꞌya-mijnálóꞌ</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />Ríge̱ꞌ ñajuun ajngáa rí ni̱dxawíínlaꞌ máꞌ asndo nákhí ginii jayu: gíꞌmaa rí ma̱galóꞌ juꞌya-mijnálóꞌ. <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />Ma̱xánindxa̱ꞌlóꞌ xómá ninindxu̱u̱ Kaín, tsí xa̱bi̱i xa̱bo̱ xkawi̱i̱ꞌ, jamí nixíya̱a̱ dxíyo̱o̱. Náá numuu kajngó nixíya̱a̱ rá. Numuu rí ra̱máján rí naꞌne Kaín, xómáꞌ dxíyo̱o̱ naꞌne rí máján.<verse eid="1JN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13" />A̱ngui̱nꞌ, ma̱xámakualaꞌ gáꞌne xí tsíñúú gúyalaꞌ xa̱bo̱ tsí júwa̱ꞌ ná numbaa ríge̱ꞌ. <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" />Xí nandalóꞌ juꞌñúú a̱ngia̱nꞌlóꞌ, a̱ꞌkhue̱n nduꞌyáálóꞌ rí nijríñáaꞌlóꞌ máꞌ inuu rí ma̱ja̱ñálóꞌ, jamí nduꞌyalóꞌ rí xúge̱ꞌ rá. Xómáꞌ xa̱bo̱ tsí tsíyoo jaꞌyoo dxájuu, xóó máꞌ nijáñúu̱ xtáa̱. <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />Jámba̱a̱ xa̱bo̱ tsí tsíyoo jaꞌyoo dxájuu, tsúꞌkhue̱n ñajuun xómá tsí na̱gu̱díin xa̱bo̱. Jamí ndu̱ya̱álaꞌ máꞌ rí asndo nimbáa tsí na̱gu̱díin xa̱bo̱, na̱nguá xtáa ndaꞌya mbá jámuu tsúꞌkhue̱n.<verse eid="1JN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 3:16" />Ga̱jma̱á majñu̱u̱ ríge̱ꞌ nduꞌyáálóꞌ rí nandoo Ana̱ꞌlóꞌ jaꞌyalóꞌ, rí nixnáxe̱-mina̱ꞌ Jesukrísto̱ rí ma̱ja̱ñúu ga̱jma̱á numalóꞌ. Xkuaꞌnii máꞌ mangáánꞌlóꞌ, jaꞌyoo mu̱xna̱xí-mijnálóꞌ rí ma̱ja̱ñálóꞌ ga̱jma̱á numúú a̱ngia̱nꞌlóꞌ. <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />Xí mbáa xa̱bo̱ gíꞌdoo rí ma̱xtáa-muu ndaꞌyoo rí dxájuu na̱nguá gíꞌdoo rí ma̱xtáa-muu, jamí na̱nguá imbáyúu̱, á nandoo xa̱bo̱ tsúꞌkhue̱n jaꞌyoo dxájuu xómá nandoo Ana̱ꞌlóꞌ jaꞌñúú xa̱bo̱ rá. <verse eid="1JN 3:17" /><verse number="18" style="v" sid="1JN 3:18" />I̱ji̱nꞌ, ra̱ꞌkhá i̱ndo̱ó mu̱ꞌthánlóꞌ rí nandalóꞌ juꞌya-mijnálóꞌ, rí gu̱snga̱jmálóꞌ rí gakon nandalóꞌ juꞌya-mijnálóꞌ ga̱jma̱á majñu̱u̱ rí nu̱ꞌne̱lóꞌ.<verse eid="1JN 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />Ikhaa numuu rúꞌkhue̱n nduꞌyáálóꞌ rí juwalóꞌ ná awúun rí gakon, jamí mbá jañii a̱kia̱nꞌlóꞌ juwalóꞌ ná inuu Ana̱ꞌlóꞌ. <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />Maske máꞌ ná awúun a̱kia̱nꞌlóꞌ na̱ju̱ma̱ꞌlóꞌ rí gíꞌmáálóꞌ aꞌkhán, i̱tha̱án máꞌ mba̱a̱ Ana̱ꞌlóꞌ xó rí a̱kia̱nꞌlóꞌ, jamí ikhaa̱ ndaꞌyoo̱ mbá xúgíí. <verse eid="1JN 3:20" /><verse number="21" style="v" sid="1JN 3:21" />A̱ngui̱nꞌ, xí ná awúun a̱kia̱nꞌlóꞌ na̱nguá i̱ju̱ma̱ꞌlóꞌ rí gíꞌmáálóꞌ aꞌkhán, mbá jañii a̱kia̱nꞌlóꞌ juwalóꞌ ná inuu Ana̱ꞌlóꞌ xúꞌkhue̱n rá. <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />Jamí ikhaa̱ maxnálóꞌ mbá xúgíí rí nu̱nda̱ꞌáa̱lóꞌ, numuu rí nu̱ꞌne̱-mbáníílóꞌ xtángawoo̱, jamí nuꞌne̱lóꞌ rí na̱ni̱gu̱u̱ꞌ ikhaa̱. <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" />Ríge̱ꞌ ñajuun xtángawoo̱: rí ma̱nimba̱ꞌlóꞌ juꞌyáá Jesukrísto̱, tsí A̱dée Ana̱ꞌlóꞌ, jamí xúꞌkhue̱n máꞌ rí ma̱galóꞌ juꞌya-mijná xómáꞌ rí nixná-ñájwanlóꞌ ikhaa̱. <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />Xa̱bo̱ tsí naꞌne-mbánuu xtángawoo Ana̱ꞌlóꞌ, xtáa jayu ga̱jma̱á nindxu̱u̱ Ana̱ꞌlóꞌ, jamí Ana̱ꞌlóꞌ xtáa jayu ga̱jma̱á nindxu̱u̱ ikhaa̱. Xkuaꞌnii nduꞌyáálóꞌ rí xtáa jayu Ana̱ꞌlóꞌ ga̱jma̱á nindxa̱ꞌlóꞌ, numuu rí nixniálóꞌ Xu̱u̱ꞌ ikhaa̱.<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s">Tsí ñajúún xa̱bi̱i Ana̱ꞌlóꞌ nuthan rí gakon</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />A̱ngui̱nꞌ, tsáanꞌ phú nandoꞌ ja̱ya̱ꞌlaꞌ, ma̱xánimba̱ꞌlaꞌ ju̱ñu̱ú mbá xúgíin xa̱bo̱ tsí nuthan rí Xu̱u̱ꞌ Ana̱ꞌlóꞌ naꞌthán-múꞌúún rí nuthan, a̱ꞌkhue̱n gakon a̱gu̱ya̱á májánlaꞌ xí gakon rí xa̱bi̱i Ana̱ꞌlóꞌ ñajúu̱n. Numuu rí ná numbaa ríge̱ꞌ júwa̱ꞌ mbaꞌiin tsí mi̱nduwiin rí ajngóo Ana̱ꞌlóꞌ nu̱rawíjnga̱a. <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />Xáꞌnii ma̱goo mbu̱ya̱álaꞌ tsáa tsí gakon ga̱jma̱á Xu̱u̱ꞌ Ana̱ꞌlóꞌ: jámba̱a̱ xa̱bo̱ tsí naꞌthán jmbuu rí Jesukrísto̱ ninindxu̱u̱ xa̱bo̱ numbaa, tsúꞌkhue̱n ñajuun xa̱bi̱i Ana̱ꞌlóꞌ. <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />Jamí jámba̱a̱ xa̱bo̱ tsí tsíꞌthán jmbuu rúꞌkhue̱n ga̱jma̱á numuu Jesukrísto̱, rí ninindxu̱u̱ xa̱bo̱ numbaa,<note caller="+" style="f"><char style="fr" closed="false">4.3 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná tsíꞌthán «rí ninindxu̱u̱ xa̱bo̱ numbaa».</char></note> ra̱ꞌkhá xa̱bi̱i Ana̱ꞌlóꞌ ñajuu̱n. Tsúꞌkhue̱n ñajuun xa̱bo̱ tsí sia̱nꞌ ga̱jma̱á Krísto̱, tsí ni̱dxawíínlaꞌ máꞌ rí ma̱ꞌkha̱, jamí xtáa̱ máꞌ ná numbaa xúge̱ꞌ rá.<verse eid="1JN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4" />I̱ji̱nꞌ, ikháanꞌlaꞌ ñajwanlaꞌ xa̱bi̱i Ana̱ꞌlóꞌ, jamí ni̱ꞌnga̱ꞌlaꞌ inúú xa̱bo̱ tsúꞌkhue̱n, tsí mi̱nduwiin. Numuu rí i̱tha̱án máꞌ mba̱a̱ ski̱yu̱u̱ꞌ tsí xtáa ga̱jma̱á nindxa̱ꞌlaꞌ ikháanꞌlaꞌ, xó rí tsí xtáa ná numbaa. <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />Ikhiin tsúꞌkhue̱n ñajúún xa̱bi̱i numbaa ríge̱ꞌ, ikhaa jngó nuthee̱n ga̱jma̱á numuu rí ríga̱ ná numbaa ríge̱ꞌ, jamí xa̱bo̱ numbaa nudxawíín rí nuthee̱n. <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />Ikháánꞌlóꞌ ñajwanlóꞌ xa̱bi̱i Ana̱ꞌlóꞌ. Tsí naꞌne-nuwiin Ana̱ꞌlóꞌ, nadxawuun rí nuꞌthánlóꞌ. Tsí ra̱ꞌkhá xa̱bi̱i Ana̱ꞌlóꞌ ñajuun, tsídxawuun rí nuꞌthánlóꞌ. Xkuaꞌnii nduꞌyáálóꞌ tsáa ñajuun tsí ga̱jma̱á Xu̱u̱ꞌ Ana̱ꞌlóꞌ, tsí kuwiin, jamí tsáa ga̱jma̱á xu̱u̱ꞌ tsí mi̱nduwaa.<verse eid="1JN 4:6" /></para>
  <para style="s">Ana̱ꞌlóꞌ nasngájma rí phú nandoo jaꞌyalóꞌ</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />A̱ngui̱nꞌ, tsáanꞌ phú nandoꞌ ja̱ya̱ꞌlaꞌ, ga̱galóꞌ juꞌya-mijnálóꞌ, numuu rí Ana̱ꞌlóꞌ nandoo jaꞌñúú xa̱bo̱. Jámba̱a̱ xa̱bo̱ tsí nandoo jaꞌñúú xa̱bo̱, a̱dée Ana̱ꞌlóꞌ ñajuun tsúꞌkhue̱n, jamí naꞌne-nuwii̱n Ana̱ꞌlóꞌ. <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />Tsí tsíyoo jaꞌñúú xa̱bo̱, tsúꞌkhue̱n táꞌne-nuwiin Ana̱ꞌlóꞌ. Numuu rí Ana̱ꞌlóꞌ nandoo jaꞌñúú xa̱bo̱. <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />Xáꞌnii nisngájma Ana̱ꞌlóꞌ rí nandoo jaꞌyalóꞌ: rí nixúngua̱a̱ꞌ A̱dée̱ tsí mbáwíi ma̱ꞌkha̱ ná numbaa, kajngó ma̱juwalóꞌ ga̱jma̱á majñu̱u̱ ikhaa̱. <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />Xáꞌnii nakujma rí Ana̱ꞌlóꞌ nandoo jaꞌñúú xa̱bo̱: ra̱ꞌkhá ikháánꞌlóꞌ ndiyalóꞌ juꞌyáá Ana̱ꞌlóꞌ, rí ikhaa̱ ndiyoo̱ jaꞌyalóꞌ, jamí nixúngua̱a̱ꞌ A̱dée̱ rí ma̱ja̱ñúu kajngó ma̱goo ma̱ꞌne mba̱a̱ a̱kuii̱n jaꞌyoo̱ aꞌkhánlóꞌ. <verse eid="1JN 4:10" /><verse number="11" style="v" sid="1JN 4:11" />A̱ngui̱nꞌ, tsáanꞌ phú nandoꞌ ja̱ya̱ꞌlaꞌ, xí xkuaꞌnii ndiyoo Ana̱ꞌlóꞌ jaꞌyalóꞌ, xkuaꞌnii máꞌ jaꞌyoo rí ma̱galóꞌ juꞌya-mijná mangáánꞌlóꞌ. <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />Maske máꞌ asndo nimbáa xa̱bo̱ ninguáná táꞌyoo Ana̱ꞌlóꞌ, xí nandalóꞌ juꞌya-mijnálóꞌ, Ana̱ꞌlóꞌ xtáa jayu ga̱jma̱á nindxa̱ꞌlóꞌ, jamí ga̱jma̱á majña̱ꞌ ikháánꞌlóꞌ nakujma jaꞌwu rí Ana̱ꞌlóꞌ nandoo jaꞌñúú xa̱bo̱.<verse eid="1JN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13" />Xáne lá gágoo mbu̱ꞌyáálóꞌ rí juwalóꞌ jayu ga̱jma̱á nindxu̱u̱ Ana̱ꞌlóꞌ, jamí ikhaa̱ xtáa̱ jayu ga̱jma̱á nindxa̱ꞌlóꞌ ikháánꞌlóꞌ rá. Nduꞌyáálóꞌ rúꞌkhue̱n numuu rí ikhaa̱ nixniálóꞌ Xu̱u̱ꞌ. <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />Jamí ikháanꞌxo̱ꞌ ndi̱ya̱áxo̱ꞌ, xúꞌkhue̱n máꞌ nu̱tha̱nxo̱ꞌ rí Ana̱ꞌlóꞌ Mikhuíí nixúꞌmaa A̱dée ma̱ꞌkha̱ ná numbaa, kajngó ma̱nindxu̱u̱ tsí naꞌne-jáwíin xa̱bo̱. <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />Jámba̱a̱ xa̱bo̱ tsí naꞌthán jmbuu rí Jesús ñajuun A̱dée Ana̱ꞌlóꞌ, Ana̱ꞌlóꞌ xtáa jayu ga̱jma̱á nindxu̱u̱ tsúꞌkhue̱n, jamí ikhaa̱ xtáa̱ jayu ga̱jma̱á nindxu̱u̱ Ana̱ꞌlóꞌ.<verse eid="1JN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 4:16" />Xómáꞌ ikháánꞌlóꞌ nduꞌyáálóꞌ jamí nanimba̱ꞌlóꞌ rí Ana̱ꞌlóꞌ nandoo jaꞌyalóꞌ. Ana̱ꞌlóꞌ nandoo jaꞌñúú xa̱bo̱. Xa̱bo̱ tsí nandoo máꞌ xúꞌkhue̱n jaꞌñúú xa̱bo̱, tsúꞌkhue̱n xtáa jayu ga̱jma̱á nindxu̱u̱ Ana̱ꞌlóꞌ, jamí Ana̱ꞌlóꞌ xtáa jayu ga̱jma̱á nindxu̱u̱ ikhaa̱. <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />Rúꞌkhue̱n nasngájma jaꞌwu rí Ana̱ꞌlóꞌ nandoo jaꞌñúú xa̱bo̱ ga̱jma̱á majña̱ꞌ ikháánꞌlóꞌ. A̱ꞌkhue̱n rí ma̱xámíñalóꞌ ído̱ ma̱ga̱nú mbiꞌi rí ma̱to̱ꞌo̱o̱ awan ga̱jma̱á numalóꞌ. Numuu rí ikháánꞌlóꞌ juwalóꞌ xómá nixtáa Jesús ná numbaa ríge̱ꞌ. <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />Xa̱bo̱ tsí ndaꞌyoo rí Ana̱ꞌlóꞌ nandoo jiꞌyáá eꞌne, na̱nguá imíñuu̱, a̱ꞌkhue̱n gakon ído̱ ndaꞌyoo̱ rí Ana̱ꞌlóꞌ nandoo jiꞌyáa̱ eꞌne, ikhaa rúꞌkhue̱n naꞌne rí ma̱xámíñuu̱. Numuu rí xa̱bo̱ tsí namíñuu, gíꞌthu̱u̱n rí ma̱ꞌne-numaa̱ aꞌkhúu̱n. Ikhaa jngó tsí namíñuu, xóó máꞌ tsíꞌyoo mújúu̱n rí nandoo jiꞌyáa̱ eꞌne Ana̱ꞌlóꞌ.<verse eid="1JN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19" />Ikháánꞌlóꞌ nandalóꞌ juꞌyáá Ana̱ꞌlóꞌ, numuu rí ikhaa̱ ginii̱ ndiyoo̱ jaꞌyalóꞌ. <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />Xí mbáa naꞌthán: «Ikhúúnꞌ nandoꞌ ja̱yo̱o̱ Ana̱ꞌlóꞌ», jamí tsíyoo̱ gáꞌyoo̱ dxájuu̱, naꞌne-nduwa tsúꞌkhue̱n. Numuu rí xa̱bo̱ tsí tsíyoo gáꞌyoo dxájuu, tsí nandoo ndaꞌyoo̱, xáne lá gágoo ma̱goo̱ jaꞌyoo̱ Ana̱ꞌlóꞌ, tsí tsíyoo mba̱ꞌyoo̱ xúꞌkhue̱n rá. <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />Jamí Jesukrísto̱ nixnálóꞌ xtángoo ríge̱ꞌ: tsí nandoo jaꞌyoo Ana̱ꞌlóꞌ, ga̱goo jaꞌyoo dxájuu mangaa.<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s">Tsí nanimbo̱o̱ꞌ jaꞌyoo Jesús na̱ꞌngo̱o̱ inuu numbaa ríge̱ꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />Jámba̱a̱ xa̱bo̱ tsí nanimbo̱o̱ꞌ rí Jesús ñajuun Krísto̱, a̱dée Ana̱ꞌlóꞌ ñajuun tsúꞌkhue̱n. Jamí jámba̱a̱ tsí nandoo jaꞌyoo mbá táta̱ tsí gíꞌdiin i̱ji̱in, nandoo̱ máꞌ jaꞌñúu̱ i̱ji̱in táta̱ tsúꞌkhue̱n mangaa. <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />Xáne lá gágoo mbu̱ꞌyáálóꞌ rí nandalóꞌ juꞌñúú i̱ji̱in Ana̱ꞌlóꞌ rá. Nduꞌyáálóꞌ ne̱ ído̱ rí nandalóꞌ juꞌyáá Ana̱ꞌlóꞌ jamí nu̱ꞌne̱-mbáníílóꞌ xtángawoo̱. <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" />Xáꞌnii nakujma rí nandalóꞌ juꞌyáá Ana̱ꞌlóꞌ: rí nu̱ꞌne̱-mbáníílóꞌ xtángawoo̱. Jamí na̱nguá máꞌ mingíjyúu rí mu̱ꞌne̱-mbáníílóꞌ xtángawoo̱. <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />Numuu rí jámba̱a̱ xa̱bo̱ tsí ñajuun a̱dée Ana̱ꞌlóꞌ, na̱ꞌngo̱o̱ naꞌne ga̱jmáa̱ rí xkawe̱ꞌ rí ríga̱ ná numbaa ríge̱ꞌ. Ríge̱ꞌ ñajuun rí naꞌne rí na̱ꞌnga̱ꞌlóꞌ inuu rí xkawe̱ꞌ rí ríga̱ ná numbaa ríge̱ꞌ: rí wéje̱ a̱kia̱nꞌlóꞌ ná inuu Jesús. <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />Tsáa ñajuun tsí na̱ꞌngo̱o̱ naꞌne ga̱jma̱á rí xkawe̱ꞌ rí ríga̱ ná numbaa ríge̱ꞌ róꞌ. Ikhaa tsí nanimbo̱o̱ꞌ rí Jesús ñajuun A̱dée Ana̱ꞌlóꞌ.<verse eid="1JN 5:5" /></para>
  <para style="s">Rí naꞌthán Ana̱ꞌlóꞌ ga̱jma̱á numuu Jesukrísto̱</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />Tsíge̱ꞌ ñajuun Jesukrísto̱, tsí ni̱ꞌkha̱ ga̱jma̱á majñu̱u̱ iya jamí iꞌdi. Ra̱ꞌkhá i̱ndo̱ó máꞌ ga̱jma̱á majñu̱u̱ iya, rí ga̱jma̱á majñu̱u̱ iya jamí iꞌdi. Jamí Xu̱u̱ꞌ Ana̱ꞌlóꞌ ñajuun tsí naꞌthán rí xkuaꞌnii niríga̱, numuu rí Xu̱u̱ꞌ Ana̱ꞌlóꞌ ñajuun tsí kuwiin. <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />Numuu rí júwa̱ꞌ atsúun tsí nuthan ga̱jma̱á numuu ríge̱ꞌ ná mikhuíí: [Ana̱ꞌlóꞌ Mikhuíí, tsí ñajuun Ajngáa ga̱jma̱á Xu̱u̱ꞌ Ana̱ꞌlóꞌ. Jamí atsúun tsúꞌkhue̱n, mbóó máꞌ rí ñajúu̱n. <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />Jamí atsúun tsí nuthan ga̱jma̱á numuu rúꞌkhue̱n ná mbayíí:]<note caller="+" style="f"><char style="fr" closed="false">5.7-8 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa rí júguaraꞌa ga̱jma̱á [...].</char></note> Xu̱u̱ꞌ Ana̱ꞌlóꞌ, iya jamí iꞌdi. Jamí atsúun tsúꞌkhue̱n, naꞌkho̱-mina̱aꞌ rí nuthee̱n. <verse eid="1JN 5:8" /><verse number="9" style="v" sid="1JN 5:9" />Xí nanimba̱ꞌlóꞌ rí nuthan xa̱bo̱ numbaa, i̱tha̱án máꞌ gíꞌdoo numuu rí ma̱nimba̱ꞌlóꞌ rí naꞌthán Ana̱ꞌlóꞌ, numuu rí rúꞌkhue̱n ñajuun rí naꞌthán Ana̱ꞌlóꞌ ga̱jma̱á numuu A̱dée. <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />Xa̱bo̱ tsí nanimbo̱o̱ꞌ jaꞌyoo A̱dée Ana̱ꞌlóꞌ, tsúꞌkhue̱n naꞌne jañii a̱kui̱in rí naꞌthán Ana̱ꞌlóꞌ. Xómáꞌ xa̱bo̱ tsí tsínimbo̱o̱ꞌ jaꞌyoo Ana̱ꞌlóꞌ rá, naꞌnii̱ asndo xó rí mi̱nduwaa Ana̱ꞌlóꞌ, numuu rí tsínimbo̱o̱ꞌ rí naꞌthán Ana̱ꞌlóꞌ ga̱jma̱á numuu A̱dée. <verse eid="1JN 5:10" /><verse number="11" style="v" sid="1JN 5:11" />Ikhaa ríge̱ꞌ ñajuun ajngáa rí niꞌthán Ana̱ꞌlóꞌ: rí ma̱juwalóꞌ mbá jámuu. Jamí A̱dée̱ ñajuun tsí naꞌne rí ma̱juwalóꞌ mbá jámuu. <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />Xa̱bo̱ tsí xtáa A̱dée Ana̱ꞌlóꞌ ná awúun a̱kui̱in, xtáa jámuu tsúꞌkhue̱n. Xómáꞌ xa̱bo̱ tsí na̱nguá xtáa A̱dée Ana̱ꞌlóꞌ ná awúun a̱kui̱in rá, na̱nguá xtáa jámuu tsúꞌkhue̱n.<verse eid="1JN 5:12" /></para>
  <para style="s">I̱ꞌwá rí naꞌthán-máꞌán Juáán</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />Na̱tháánlo̱ꞌ ajngáa ríge̱ꞌ ma̱ꞌga ná inalaꞌ, tsáanꞌ nanimba̱ꞌlaꞌ ju̱ya̱á A̱dée Ana̱ꞌlóꞌ, kajngó mbu̱ya̱álaꞌ rí juwalaꞌ mbá jámuu, jamí ma̱nimba̱ꞌlaꞌ ju̱ya̱á A̱dée Ana̱ꞌlóꞌ.<note caller="+" style="f"><char style="fr" closed="false">5.13 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «jamí ma̱nimba̱ꞌlaꞌ ju̱ya̱á A̱dée Ana̱ꞌlóꞌ».</char></note> <verse eid="1JN 5:13" /><verse number="14" style="v" sid="1JN 5:14" />Ríge̱ꞌ ñajuun rí naꞌne jañii a̱kia̱nꞌlóꞌ juꞌyáa̱ ikhaa̱: Ana̱ꞌlóꞌ nadxawanlóꞌ xí nu̱nda̱ꞌáa̱lóꞌ mbá rí naꞌne máꞌ a̱kuii̱n ikhaa̱. <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />Numuu rí nduꞌyáálóꞌ máꞌ rí Ana̱ꞌlóꞌ nadxawanlóꞌ asndo náá máꞌ rí nu̱nda̱ꞌáa̱lóꞌ, xúꞌkhue̱n máꞌ mangaa nduꞌyáálóꞌ máꞌ rí maxnálóꞌ rí nu̱nda̱ꞌáa̱lóꞌ.<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />Xí mbáa xa̱bo̱ ndaꞌyoo rí dxájuu naꞌne mbá aꞌkhán rí tsírikhoo máꞌ rí ma̱xtáa̱ mbá jámuu, gaꞌthán-jáñuu̱ Ana̱ꞌlóꞌ ga̱jma̱á numuu dxájuu̱, jamí Ana̱ꞌlóꞌ ma̱ꞌne rí ma̱xtáa̱. Rúꞌkhue̱n i̱tha̱nlo̱ꞌ ga̱jma̱á numuu tsí naꞌne aꞌkhán rí tsírikhoo máꞌ rí ma̱xtáa mbá jámuu xa̱bo̱. Gakon máꞌ rí ríga̱ mangaa aꞌkhán rí narikhoo rí ma̱xtáa mbá jámuu xa̱bo̱, i̱ndo̱ó máꞌ numuu rí tsítha̱n rí mi̱ꞌthán-jáñíí Ana̱ꞌlóꞌ ga̱jma̱á numuu xa̱bo̱ tsí naꞌne aꞌkhán rúꞌkhue̱n. <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />Aꞌkhán ñajuun mbá xúgíí inii rí ra̱máján, i̱ndo̱ó máꞌ numuu rí ríga̱ aꞌkhán rí tsírikhoo máꞌ rí ma̱xtáa mbá jámuu xa̱bo̱.<verse eid="1JN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18" />Nduꞌyáálóꞌ máꞌ rí jámba̱a̱ tsí ñajuun a̱dée Ana̱ꞌlóꞌ, tsíꞌne máꞌ xúꞌkhue̱n aꞌkhán. Numuu rí ikhaa tsí ñajuun A̱dée Ana̱ꞌlóꞌ na̱ña̱wu̱u̱n, jamí xa̱bo̱ xkawi̱i̱ꞌ tsíxkajmaa̱.<verse eid="1JN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19" />Nduꞌyáálóꞌ máꞌ rí ikháánꞌ ñajwanlóꞌ i̱ji̱in Ana̱ꞌlóꞌ, maske máꞌ xa̱bo̱ xkawi̱i̱ꞌ naꞌthán ñájúún mbá xúgíin i̱ꞌwíin xa̱bo̱ numbaa.<verse eid="1JN 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20" />Mangaa máꞌ nduꞌyáálóꞌ rí A̱dée Ana̱ꞌlóꞌ ni̱ꞌkha̱ ná numbaa, jamí ikhaa̱ máꞌ nixnálóꞌ rí mu̱ꞌne̱-nuwiinlóꞌ Ana̱ꞌlóꞌ, tsí phú gakon rí Ana̱ꞌlóꞌ ñajuun. Xómáꞌ ikháánꞌlóꞌ, juwalóꞌ mbóó ga̱jma̱á nindxu̱u̱ Jesukrísto̱, tsí phú gakon rí A̱dée Ana̱ꞌlóꞌ ñajuun. Tsíge̱ꞌ tsí phú gakon rí Ana̱ꞌlóꞌ ñajuun, jamí ikhaa̱ ñajuun tsí naꞌne rí ma̱juwalóꞌ mbá jámuu. <verse eid="1JN 5:20" /><verse number="21" style="v" sid="1JN 5:21" />I̱ji̱nꞌ, a̱gu̱ne̱ janíí-mijnálaꞌ ná inúú tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún. Xkuaꞌnii gáꞌne.<note caller="+" style="f"><char style="fr" closed="false">5.21 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná tsíꞌkha̱ ajngáa ríge̱ꞌ: «Xkuaꞌnii gáꞌne».</char></note><verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>