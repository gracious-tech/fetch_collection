<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">tcfU (56-2Tim) - Me̱ꞌpha̱a̱ Mañúwi̱ín (Malinaltepec) (sfm NVI), c4/v83</book>
  <para style="h">2 Timotéo̱</para>
  <para style="toc3">2 Tm</para>
  <para style="toc2">2 Timotéo̱</para>
  <para style="toc1">Riajma̱ i̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inuu Timotéo̱</para>
  <para style="mt2">Riajma̱ i̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inuu</para>
  <para style="mt1">Timotéo̱</para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="s">Páblo̱ naraxi̱i Timotéo̱</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />Ikhúúnꞌ ñajunꞌ Páblo̱, mbáa xa̱bo̱ tsí waxúngua̱a̱ꞌ neꞌne Jesukrísto̱ numuu rí xkuaꞌnii ndiyoo Ana̱ꞌlóꞌ, tsí nixuda-mina̱ꞌ rí mbu̱ꞌyalóꞌ jámuu ga̱jma̱á majñu̱u̱ Krísto̱ Jesús.<verse eid="2TI 1:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="2TI 1:2" />Na̱xu̱ꞌmá i̱yi̱i̱ꞌ ríge̱ꞌ inaaꞌ ikháánꞌ, a̱ꞌdéꞌ Timotéo̱, tsáánꞌ phú nandoꞌ ja̱ya̱a̱ꞌ. Na̱ra̱xi̱ínlo̱ꞌ.</para>
  <para style="b" vid="2TI 1:2" />
  <para style="p" vid="2TI 1:2">Ana̱ꞌlóꞌ Mikhuíí jamí Tátiálóꞌ Jesukrísto̱ gúne̱-tsakun-rámááꞌ. Ikhii̱n máꞌ gáñáwíin a̱kuíi̱n juyaa̱ꞌ jamí gúni̱i̱ rí ma̱ra̱xtaa tsímáá.<verse eid="2TI 1:2" /></para>
  <para style="s">Páblo̱ narígu̱u la gamaku inuu Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />Mbámbá mbiꞌi na̱rmáꞌáan a̱kui̱nꞌ ja̱ya̱a̱ꞌ ído̱ rí na̱tha̱n-jáñuu Ana̱ꞌlóꞌ, mbiꞌíí mbruꞌwíín na̱rígu̱u gamaku ná inuu Ana̱ꞌlóꞌ ga̱jma̱á numaaꞌ. Ikhúúnꞌ jaꞌwu a̱kui̱nꞌ na̱ñajun ná inuu Ana̱ꞌlóꞌ xómá rí nene̱ táta̱-xi̱ꞌñúꞌ wajyúú. <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />Ído̱ na̱rmáꞌáan a̱kui̱nꞌ rí ni̱ta̱mbi̱ya̱ꞌ nákhí rí ni̱ꞌthángoo-mijnálóꞌ, naꞌne a̱kui̱nꞌ rí mba̱ya̱a̱ꞌ mbu̱júꞌ kajngó ma̱jni̱í rí gagi ná awúun a̱kui̱nꞌ gátha̱ne̱. <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" />Na̱rmáꞌáan a̱kui̱nꞌ rí phú gakon rí wéje̱ a̱kia̱anꞌ ná inuu Ana̱ꞌlóꞌ, xómá rí ginii jayu ni̱we̱je̱ a̱kui̱in nána̱ xíñaaꞌ Lóida̱ ga̱jma̱á nániáaꞌ Euníse̱. Ikhaa jngó naꞌne jañii a̱kui̱nꞌ rí xkuaꞌnii máꞌ wéje̱ a̱kia̱anꞌ mangáánꞌ.<verse eid="2TI 1:5" /></para>
  <para style="s">Ma̱xáti̱ya̱a̱ꞌ rí ma̱ra̱tha̱n ga̱jma̱á numuu Jesús</para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 1:6" />Ikhaa numuu rúꞌkhue̱n na̱nda̱ꞌa̱a̱ꞌlo̱ꞌ rí ma̱ta̱skráꞌa̱a aguu ñajun rí nixnáaꞌ Ana̱ꞌlóꞌ ma̱tha̱ne̱ nákhí rí ni̱xkrámáálo̱ꞌ ga̱jma̱á ñawúnꞌ. <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />Numuu rí Ana̱ꞌlóꞌ táxniálóꞌ Xu̱u̱ꞌ kajngó ma̱mi̱ꞌñálóꞌ gúne̱ xa̱bo̱, rí nixniálóꞌ Xu̱u̱ꞌ kajngó ma̱ri̱gá tsiakhe̱ gúꞌne̱lóꞌ, xúꞌkhue̱n máꞌ rí ma̱galóꞌ juꞌñúú xa̱bo̱ jamí rí ma̱ꞌnga̱lóꞌ mu̱ꞌthán-ñájun-mijnálóꞌ.<verse eid="2TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8" />Ikhaa jngó, ma̱xáti̱ya̱a̱ꞌ rí ma̱ra̱thu̱ún xa̱bo̱ ga̱jma̱á numuu Tátiálóꞌ, ni máꞌ ga̱jma̱á numuꞌ ikhúúnꞌ, tsúún kru̱ꞌúún géjwa̱nꞌ ga̱jma̱á numuu̱ ikhaa̱. A̱ꞌkhue̱n gakon, ski̱yu̱u̱ꞌ Ana̱ꞌlóꞌ gáꞌne rí ma̱ra̱xtaa na̱ma̱ñaaꞌ rí ma̱ta̱míni̱í mangáánꞌ ga̱jma̱á numuu ajngáa máján. <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />Ana̱ꞌlóꞌ neꞌne-jríñáaꞌlóꞌ jamí nindxaꞌwálóꞌ rí ma̱nindxa̱ꞌlóꞌ xa̱bo̱ xuajñuu̱ tsí jaꞌwuun. Ra̱ꞌkhá ga̱jma̱á numuu rí máján ne̱ꞌne̱lóꞌ, rí numuu rí xkuaꞌnii ndiyoo̱ ikhaa̱, jamí ga̱jma̱á numuu rí nandoo Ana̱ꞌlóꞌ jaꞌyalóꞌ ga̱jma̱á majñu̱u̱ Krísto̱ Jesús asndo nákhí máꞌ xóó tágu̱ma-ku̱maa numbaa. <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />Xómáꞌ xúge̱ꞌ rá, nigájnuu máꞌ ná pa̱jnu rí nandoo Ana̱ꞌlóꞌ jaꞌyalóꞌ ga̱jma̱á numuu rí nikujmaa Jesukrísto̱, tsí naꞌne-jríñáaꞌlóꞌ. Ikhaa̱ neꞌne-gámbo̱o̱ tsiakhe̱ rí naꞌne rí ma̱ja̱ñúú xa̱bo̱ jamí niꞌnii̱ rí ma̱kujma xó rí ma̱juwalóꞌ jámuu ga̱jma̱á majñu̱u̱ ajngáa máján. <verse eid="2TI 1:10" /><verse number="11" style="v" sid="2TI 1:11" />Ga̱jma̱á numuu ajngáa máján rúꞌkhue̱n, ikhúúnꞌ ninindxu̱ꞌ xa̱bo̱ tsí naꞌthán-ráꞌa, mbáa xa̱bo̱ tsí waxúngua̱a̱ꞌ jamí tsí naꞌsngúún xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún.<note caller="+" style="f"><char style="fr" closed="false">1.11 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «tsí ra̱ꞌkháa judío̱ ñajúún».</char></note> <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />Ikhaa máꞌ numuu ajngáa máján rúꞌkhue̱n na̱mínu̱u̱ꞌ mbá xúgíí ríge̱ꞌ. Xómáꞌ ikhúúnꞌ tsíti̱yu̱ꞌ, numuu rí nda̱yo̱o̱ máꞌ tsáa ñajuun tsí ninimbo̱ꞌ ja̱yo̱o̱, jamí ikhúúnꞌ nda̱yo̱o̱ mújúnꞌ rí ikhaa̱ gíꞌdoo̱ tsiakhe̱ rí ma̱ña̱wu̱u̱n rí ni̱xna̱ngáwoo̱lo̱ꞌ asndo mbiꞌi rí ma̱ꞌkha̱a Krísto̱.<verse eid="2TI 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 1:13" />Ma̱xáta̱tsi̱ꞌñáá gisngáá máján rí ni̱sngáaꞌlo̱ꞌ, rí ma̱we̱je̱ a̱kia̱anꞌ ná inuu Ana̱ꞌlóꞌ jamí rí ma̱gaaꞌ xtañúú xa̱bo̱ ga̱jma̱á majñu̱u̱ Krísto̱ Jesús. <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />Ga̱jma̱á majñu̱u̱ ski̱yu̱u̱ꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ tsí xtáa ná awúun a̱kia̱nꞌlóꞌ, a̱tia̱wa̱án májáanꞌ gisngáá rí waꞌxnángawaaꞌ.<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />Nathayáá máꞌ rí mbá xúgíin tsí júwa̱ꞌ ná numbaa Ásia̱ ni̱ni̱ñi̱ꞌ, asndo Fijélo̱ jamí Ermóje̱ne̱s mangiin.<verse eid="2TI 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 1:16" />Ga̱ñáwíin a̱kui̱in Táta̱ jaꞌñúú mbá guꞌwíin xa̱bi̱i Onesífo̱ro̱, numuu rí phú mbaꞌa nothon ni̱ꞌkhe̱e̱ gáxníꞌ tsiakhe̱, jamí táti̱yu̱u̱ꞌ rí kru̱ꞌúún géjwa̱nꞌ. <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />A̱ꞌkhue̱n gakon, ído̱ rí ni̱ꞌkhe̱e̱ ná xuajen Róma̱, mbá xúgíí ningrigo̱o̱ꞌ ndiꞌñúu̱ asndo náá nixkamúu̱. <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />Ga̱ñáwíin a̱kui̱in Táta̱ jaꞌyoo̱ ído̱ gága̱nú mbiꞌi rí ndámba̱wóo. Nathayáá májáanꞌ máꞌ ikháánꞌ wátha̱ nimbáyálóꞌ Onesífo̱ro̱ ná xuajen Éfe̱so̱.<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="s">Xkri̱da ga̱jma̱á numúú xa̱bo̱ tsí na̱ꞌngo̱o̱ a̱kui̱ín rí mu̱míni̱í</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />Ikhaa jngó, ikháánꞌ táa, araxná-mina̱ꞌ tsiakhe̱ ga̱jma̱á numuu rí máján nijanálóꞌ ga̱jma̱á majñu̱u̱ Krísto̱ Jesús. <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />Rí nitadxawíín rí ni̱sngáá ná inúú mbaꞌiin xa̱bo̱, ikhaa máꞌ rúꞌkhue̱n gára̱sngúún xa̱bo̱ tsí jmbiin, tsí ma̱goo musngúún i̱ꞌwíin xa̱bo̱ mangaa. <verse eid="2TI 2:2" /><verse number="3" style="v" sid="2TI 2:3" />Ikháánꞌ ga̱ꞌngo̱o̱ a̱kia̱anꞌ rí ma̱ta̱míni̱í ga̱jma̱á nindxu̱ꞌ, numuu rí ikháánꞌ ñajwaanꞌ xómá mbáa xa̱bo̱ tsí kuatuun ajwa̱nꞌ tsí máján naꞌne ñajun drígo̱o̱ Jesukrísto̱. <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />Nimbáa xa̱bo̱ tsí nawatuun ajwa̱nꞌ tsíxuda-mine̱e̱ꞌ rí ma̱ꞌnii̱ i̱ꞌwá ñajun, kajngó ma̱ꞌnii̱ rí tsí nithán-ñájwíi̱n eꞌne ma̱ni̱gu̱u̱ꞌ jaꞌyoo̱. <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />Xúꞌkhue̱n máꞌ xa̱bo̱ tsí nagáyuu mangaa, nda̱a̱ rí gájanáa̱ xí tsíya-makuu̱ xtángoo xó rí nagáñúú xa̱bo̱. <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />Xúꞌkhue̱n máꞌ xa̱bo̱ tsí nañajun gakhe̱ xanáá mangaa, ikhaa̱ ginii̱ jaꞌyoo̱ maguu̱ rí nijma̱a̱ rí jaꞌyoo̱. <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />Atandxaꞌwá-mina̱ꞌ rí na̱tha̱a̱nꞌ ge̱jyoꞌ, jamí Táta̱ ma̱ꞌne rí ma̱fraꞌa̱a̱ꞌ ne̱ mbá xúgíí.<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />Ga̱rmáꞌáan a̱kia̱anꞌ xtayáá Jesukrísto̱. Ikhaa̱ ñajuu̱n a̱ꞌdá-xíñu-egoo Dabíd, jamí ndiyáa̱ mbiꞌyuu̱, xómá iꞌthán ajngáa máján rí na̱sngáálo̱ꞌ. <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />Ga̱jma̱á numuu ajngáa rúꞌkhue̱n na̱mínu̱u̱ꞌ mi̱ndaꞌkho, asndo xtuꞌwá-ti̱gu̱ún ga̱jma̱á ñuu ajwa̱nꞌ xómá mbáa xa̱bo̱ tsí ra̱máján eꞌne. Xómáꞌ ajngáa rawuun Ana̱ꞌlóꞌ na̱nguá xtuꞌwá-ti̱go̱o̱ ne̱. <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />Ikhaa jngó, na̱ꞌngo̱o̱ a̱kui̱nꞌ rí na̱mínu̱u̱ꞌ mbá xúgíí ga̱jma̱á numúú tsí niraꞌwíin Ana̱ꞌlóꞌ, kajngó ma̱jáwíi̱n mangii̱n ga̱jma̱á majñu̱u̱ Krísto̱ Jesús jamí jámuu ma̱ju̱wée̱ꞌ tsímáá.<verse eid="2TI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 2:11" />Maphú gakon ajngáa ríge̱ꞌ:</para>
  <para style="b" vid="2TI 2:11" />
  <para style="q" vid="2TI 2:11">Xí nijáñalóꞌ ga̱jma̱á nindxu̱u̱ ikhaa̱,</para>
  <para style="q" vid="2TI 2:11">mbu̱ꞌyalóꞌ ga̱jma̱á nindxu̱u̱ ikhaa̱ mangaa.<verse eid="2TI 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="2TI 2:12" />Xí nu̱míni̱ílóꞌ ga̱jma̱á numuu̱ ikhaa̱,</para>
  <para style="q" vid="2TI 2:12">mu̱ꞌthán-ñájunlóꞌ ga̱jma̱á nindxu̱u̱ ikhaa̱ mangaa.</para>
  <para style="q" vid="2TI 2:12">Xí nuꞌthánlóꞌ rí tsíꞌne̱-nuwii̱nlóꞌ,</para>
  <para style="q" vid="2TI 2:12">maꞌthée̱n rí tsíꞌne-nuwáanꞌlóꞌ mangaa̱.<verse eid="2TI 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="2TI 2:13" />Xí ikháánꞌlóꞌ tsíꞌne̱-mbáníílóꞌ ajngálóꞌ,</para>
  <para style="q" vid="2TI 2:13">ikhaa̱ tsíniñuu̱ rí naꞌne-mbánuu̱ ajngóo̱,</para>
  <para style="q" vid="2TI 2:13">numuu rí ikhaa̱ tsíyoo ma̱ꞌne-nduwee̱ rí ñajuu̱n.<verse eid="2TI 2:13" /></para>
  <para style="s">Yumbáá tsí nda̱a̱ numuu rí ma̱ti̱yu̱u̱ꞌ</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />Arathúu̱n mbu̱jwáaꞌ ríge̱ꞌ kajngó ma̱rmáꞌáan a̱kuíi̱n, jamí arathán-múꞌúu̱n ná inuu Táta̱ rí ma̱xátsa̱ñúu̱ gajmíi̱ xa̱bo̱ ga̱jma̱á numuu ajngáa. Numuu rí nda̱a̱ rí imbáyúu rúꞌkhue̱n, rí i̱ndo̱ó máꞌ nambáyúu ne̱ rí ma̱ꞌne-gámbi̱in ne̱ tsí nu̱dxawíín ne̱. <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />Athane̱-tsiakhe̱-mina̱ꞌ rí maꞌthán Ana̱ꞌlóꞌ rí máján nithane̱ ído̱ gáta̱xna̱xí-mina̱ꞌ ná inuu̱, xómá mbáa yumbáá tsí nda̱a̱ numuu rí ma̱ti̱yu̱u̱ꞌ, numuu rí najmuu mújúun ajngáa rí gakon. <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />Athane̱-tsíngua̱ꞌ-mina̱ꞌ inuu ajngáa rí nda̱a̱ gamakuu jamí ajngáa tsíjmaa rí nune̱ xa̱bo̱, numuu rí ajngáa rúꞌkhue̱n naꞌne rí mune̱-tsíngua̱ꞌ-mijná mbá jayu xa̱bo̱ ná inuu Ana̱ꞌlóꞌ. <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />Jamí ajngáa rúꞌkhue̱n ma̱ꞌga-raꞌne-gámbi̱in xa̱bo̱ xómá nandii rí naꞌga xuyuu xa̱bo̱. Xa̱bo̱ tsí nuthan ajngáa rúꞌkhue̱n ñajúún Imenéo̱ ga̱jma̱á Filéto̱, <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />tsí nene̱-tsíngua̱ꞌ-mijná ná inuu rí gakon. Ikhii̱n ngrigúu̱n nuthee̱n rí ndiya̱a máꞌ mbiꞌñúú xa̱bo̱ tsí nijáñúú, jamí nune̱-ngra̱ꞌii̱n mbá tikhuun tsí nanimbu̱únꞌ juyáá Ana̱ꞌlóꞌ. <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" />Xómáꞌ nakhúu rí niꞌgí Ana̱ꞌlóꞌ ꞌgí xa̱ꞌ ne̱. Ikhín ka̱ma naꞌthán ríge̱ꞌ: «Táta̱ naꞌne-nuwiin tsí ñajúún xa̱bi̱i». Jamí ka̱ma naꞌthán ríge̱ꞌ mangaa: «Tsí naꞌthán rí xa̱bi̱i Krísto̱ ñajuun, ga̱ꞌne-janíí-mine̱e̱ꞌ inuu rí xkawe̱ꞌ».<verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />Ná awúun guꞌwóo mbáa xa̱bo̱ tsí phú gíꞌdoo numuu, ra̱ꞌkhá máꞌ i̱ndo̱ó xúba̱ ajwa̱nꞌ mo̱jmo̱ꞌ jamí xúba̱ ajwa̱nꞌ miꞌxá ríga̱, rí ríga̱ máꞌ xúba̱ ixe̱ jamí xúba̱ ju̱ba̱ꞌ mangaa. Mbá tikhu xúba̱ rúꞌkhue̱n najmaa ná na̱gu̱ma ñajun rí phú gíꞌdoo numuu, jamí i̱ꞌwá ne̱ najmaa ná na̱gu̱ma ñajun rí na̱nguá máꞌ gíꞌdoo guéño numuu. <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />Xkuaꞌnii máꞌ ná guꞌwóo Táta̱ mangaa. Xí mbáa naꞌne-jaꞌwu-mina̱aꞌ máꞌ xúꞌkhue̱n, ma̱nindxu̱u̱ xómá xúba̱ rí najmaa ná na̱gu̱ma ñajun rí phú gíꞌdoo numuu, rí najmuu i̱ndo̱ó máꞌ Ana̱ꞌlóꞌ, jamí xtáa̱ máꞌ na̱ma̱ñuu̱ rí ma̱ꞌnii̱ mbá xúgíí inii rí máján.<verse eid="2TI 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22" />Atagáyaaꞌ inuu mbá xúgíí rí xkawe̱ꞌ na̱wa̱ꞌwa̱ a̱kui̱ín mu̱ne̱ jñáma jamí i̱jín-go̱ꞌo̱. Araxná-mina̱ꞌ tsiakhe̱ rí ma̱tha̱ne̱ rí máján, rí ma̱we̱je̱ a̱kia̱anꞌ ná inuu Ana̱ꞌlóꞌ, rí ma̱gaaꞌ xtañúú xa̱bo̱ jamí rí ma̱ra̱xtaa tsímáá. Athane̱ rúꞌkhue̱n mbá ꞌnduꞌ gajmiáaꞌ mbá xúgíin tsí jaꞌwu a̱kui̱ín nu̱xríga̱á mbiꞌyuu Táta̱. <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />Ma̱xáta̱dxawúún xa̱bo̱ tsí na̱tsa̱ñu̱ú ga̱jma̱á ajngáa rí nda̱a̱ mbá jayu numuu, numuu rí nathayáá máꞌ rí rúꞌkhue̱n naꞌne rí ma̱tsa̱ñu̱ú xa̱bo̱. <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />Mbáa tsí ñajuun yumbée Táta̱ ra̱gíꞌmaa rí ma̱tsa̱ñu̱u̱ꞌ gajmíi̱ xa̱bo̱, rí gíꞌmaa rí ma̱ꞌne gamakuii̱ inúú mbá xúgíin xa̱bo̱, ma̱ma̱ñuu̱ maꞌsngáa̱ jamí ma̱ꞌngo̱o̱ a̱kuii̱n jaꞌñúu̱ mbá xúgíin xa̱bo̱. <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />Xkuaꞌnii kajngó maxrígú-mine̱e̱ꞌ rí maꞌsngúu̱n rí gakon tsí tsíñúú gúdxawíín rí naꞌthée̱n. Á gáꞌne xí Ana̱ꞌlóꞌ ma̱ꞌne rí ma̱thanga̱a a̱kuíi̱n jamí mune̱-nuwii̱n rí gakon, <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />a̱ꞌkhue̱n rí ma̱jáwíi̱n inuu mi̱nduwa rí nanimbúu̱n neꞌne gixa̱a̱, tsí nirugua-raꞌii̱n kajngó muni̱i̱ rí nandoo.<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s">Xáne jaꞌñúú xa̱bo̱ gáꞌne ído̱ rí na̱ka̱-rayámba̱ numbaa</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />Gíꞌmaa máꞌ rí ma̱tha̱ya̱á ríge̱ꞌ mangaa: rí awúun mbiꞌi rí na̱ka̱-rayámba̱ numbaa, maphú gakhe̱ gáꞌne. <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />Numuu rí ma̱ju̱wá xa̱bo̱ tsí naxná-gajmiéjúún juya-mijná i̱ndo̱ó máꞌ ikhiin, tsí na̱ni̱gu̱ún mu̱guaꞌdáá mi̱ndaꞌkho, tsí nune̱-tsiꞌyá, tsí nu̱xu̱xí-mijná, tsí nuthan xkawe̱ꞌ numuu Ana̱ꞌlóꞌ, tsí najñaguun inuu anu̱ú, tsí tsíthan núma̱aꞌ la, tsí tsíne̱-mba̱a̱ Ana̱ꞌlóꞌ, <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />tsí na̱nguá iñáwíin a̱kui̱ín ene̱ xa̱bo̱, tsí na̱nguá ene̱ mba̱a̱ a̱kui̱ín, tsí nune̱-xuxtaa ga̱jma̱á numúú xa̱bo̱, tsí tsíyoo gúni̱ꞌñáá rí nune̱ rí xkawe̱ꞌ, tsí nune̱ rí mu̱míni̱í xa̱bo̱, tsí na̱nguá i̱ni̱gu̱ún rí máján. <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />Ma̱ju̱wá xa̱bo̱ tsí mu̱xna̱xíin a̱ngui̱ín, tsí na̱nguá i̱ndxa̱ꞌwa̱-mijná rí mune̱, tsí na̱ju̱mu̱ú rí phú gíꞌdoo numúú, tsí i̱tha̱án máꞌ na̱ni̱gu̱ún mune̱ rí nandúún ikhiin xó rí nandoo Ana̱ꞌlóꞌ. <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />Muthee̱n rí nune̱-mba̱a̱ Ana̱ꞌlóꞌ, xómáꞌ rí nuni̱i̱ masngájma rí na̱nguá gakon rí nuthee̱n. Ikhaa jngó ma̱xámbáxa̱a̱ꞌ gajmiáaꞌ xa̱bo̱ tsí xkuaꞌnii jaꞌñúú.<verse eid="2TI 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 3:6" />Numuu rí a̱ngui̱ín tsíge̱ꞌ ñajúún tsí na̱tu̱ꞌu̱ún mbámbá guꞌwá kajngó mune̱-nduwii̱n go̱ꞌo̱ tsí wabiin jamí gatíí aꞌkhán rí nune̱, tsí na̱gu̱ma-rájíin ga̱jma̱á mbá xúgíí inii rí na̱ni̱gu̱u̱ꞌ xuñúú. <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />Go̱ꞌo̱ tsíge̱ꞌ jámba̱ miꞌtsú na̱ka̱-ra̱ma̱ñúu̱, jamí ni miꞌtsú tsíꞌngúu̱n gájráꞌíi̱n rí ma̱ma̱ñúu̱ rí gakon. <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />Jamí xómá neꞌne Jáne̱s ga̱jma̱á Jámbre̱s rí niwajún-ꞌthíi̱n ajngóo Moisés, xkuaꞌnii máꞌ ene̱ xa̱bo̱ tsíge̱ꞌ mangiin rí nawajún-ꞌthíi̱n rí mi̱ꞌthán-raꞌa rí gakon. Xa̱bo̱ tsí niꞌchúu mbá jayu idxu̱ún ñajúu̱n, jamí ra̱ꞌkhá xa̱bo̱ tsí wéje̱ a̱kui̱ín ná inuu Ana̱ꞌlóꞌ ñajúu̱n. <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />I̱ndo̱ó máꞌ numuu rí ma̱xágaja̱a̱ rí nuni̱i̱, numuu rí mbá xúgíin máꞌ xa̱bo̱ mbuyáá rí namijñúu̱, xómá rí tágaja̱a̱ rí nene̱ nájmi̱i̱ tsí ndiñúú gáwajún-ꞌthi̱ín Moisés.<verse eid="2TI 3:9" /></para>
  <para style="s">Rí Páblo̱ naxnángawoo Timotéo̱</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />Xómáꞌ ikháánꞌ rá Timotéo̱, nathayáá májáanꞌ máꞌ xáne i̱sngáálo̱ꞌ, xáne xtáálo̱ꞌ, náá numuu xtáálo̱ꞌ, rí wéje̱ a̱kui̱nꞌ ná inuu Ana̱ꞌlóꞌ, rí phú mba̱a̱ a̱kui̱nꞌ, rí nandoꞌ ja̱ñu̱ú xa̱bo̱. Mangaa máꞌ nathayáá májáanꞌ rí na̱ꞌngo̱o̱ a̱kui̱nꞌ inuu mbá xúgíí. <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" />Nathayáá máꞌ mangaa wátha̱ ni̱gu̱ma-ngínúú jamí ni̱mínu̱u̱ꞌ ná xuajen Antiokía̱, Ikónio̱ jamí Lístra̱. Xómáꞌ Táta̱ neꞌne-jríñúu̱ inuu mbá xúgíí rúꞌkhue̱n. <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />Xkuaꞌnii máꞌ mangaa ma̱gu̱ma-ngíníi mbá xúgíin tsí nandúún ma̱ju̱wá xómá rí nandoo Krísto̱ Jesús. <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />Xómáꞌ xa̱bo̱ tsí xkawi̱i̱ꞌ a̱kui̱ín jamí tsí nune̱-nduwa rá, i̱tha̱án máꞌ xkawe̱ꞌ gúni̱i̱. Mune̱-nduwii̱n xa̱bo̱ jamí ikhii̱n máꞌ ma̱gu̱ma-nduwii̱n gúne̱ i̱ꞌwíin xa̱bo̱. <verse eid="2TI 3:13" /><verse number="14" style="v" sid="2TI 3:14" />Xómáꞌ ikháánꞌ rá, ma̱xáta̱tsi̱ꞌñáá rí ni̱ma̱ñaaꞌ máꞌ jamí nithayáá májáanꞌ máꞌ rí gakon ne̱, numuu rí nathayáá máꞌ tsáa niꞌsngáaꞌ ne̱. <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />Asndo nákhí máꞌ lájwíín na̱ma̱ñaaꞌ i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ, rí ma̱goo ma̱ꞌne rí ma̱nindxa̱a̱ꞌ xa̱bo̱ tsí na̱ma̱ñuu, kajngó ma̱jríñáaꞌ ga̱jma̱á majñu̱u̱ rí wéje̱ a̱kia̱anꞌ ná inuu Krísto̱ Jesús. <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />Mbá xúgíí i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ, jmína̱a̱ꞌ máꞌ niꞌthán-múꞌúu̱n xa̱bo̱ tsí nitháán ne̱. Ikhaa jngó, mbá xúgíí ne̱ najmaa rí mi̱ꞌsngúún xa̱bo̱, rí mi̱ꞌthán-múꞌúún xa̱bo̱, rí mi̱xprígúún xa̱bo̱, rí mi̱ꞌsngúún xa̱bo̱ mune̱ rí máján, <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />kajngó ma̱ꞌne káxi̱i̱ tsí ñajuun yumbée Ana̱ꞌlóꞌ, jamí ma̱xtáa̱ na̱ma̱ñuu̱ rí ma̱ꞌnii̱ mbá xúgíí inii rí máján.<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />Ído̱ rí ma̱ꞌkha̱a Táta̱ Jesukrísto̱ maxúꞌdaa̱ awan numúú xa̱bo̱ tsí nduya jamí tsí nijáñúú máꞌ, jamí magíꞌdu̱u̱n maꞌthán-ñájwii̱n. Ikhaa jngó, ná inuu Ana̱ꞌlóꞌ jamí ná inuu máꞌ Táta̱ Jesukrísto̱ na̱xna̱ngáwaaꞌ ríge̱ꞌ: <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />Arathán-raꞌa ajngóo Ana̱ꞌlóꞌ. Ma̱xáta̱tsi̱ꞌñáá rí ma̱ra̱tha̱n-ráꞌa, á ikhaa mbiꞌi o ra̱ꞌkháa mbiꞌi rí ma̱ra̱tha̱n-ráꞌa mbo̱ꞌ. Atasngájmúú xa̱bo̱ rí ra̱máján nune̱, ataxprígúu̱n, arathán-múꞌúu̱n ga̱jma̱á gisngáá rí máján, jamí phú mba̱a̱ a̱kia̱anꞌ gátha̱ne̱. <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />Numuu rí ma̱ga̱nú mbiꞌi rí náxáxúún xa̱bo̱ gúdxawíín gisngáá rí máján, rí ma̱gúu̱n gúdxawíi̱n i̱ꞌwá ajngáa rí kuitsúun iwán, a̱ꞌkhue̱n rí ma̱gi̱mbúun xa̱bo̱ tsí nusngáá, tsí nuthan ajngáa rí na̱ni̱gúu̱nꞌ mu̱dxawíi̱n. <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />Mu̱ni̱ꞌñáa̱ rí nu̱dxawíi̱n gisngáá rí gakon, jamí ma̱thangii̱n mu̱dxawíi̱n ajngáa kuitsúun rí nune̱-ku̱maa xa̱bo̱ numbaa. <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />Xómáꞌ ikháánꞌ rá, Timotéo̱, xawi lá gátha̱ne̱ inuu mbá xúgíí. Ga̱ꞌngo̱o̱ a̱kia̱anꞌ rí ma̱ta̱míni̱í. Arathán-rúꞌúún máꞌ xúꞌkhue̱n xa̱bo̱ ajngáa máján, jamí athane̱-mbáníí ñajun rí ni̱ge̱ꞌe̱ inaaꞌ ma̱tha̱ne̱.<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />Numuu rí ikhúúnꞌ inu máꞌ xtáá rí mi̱xnáxu̱ún xómá mbá tsi̱gi̱jña̱ꞌ ná inuu Ana̱ꞌlóꞌ, inu máꞌ na̱ga̱nú mbiꞌi rí ma̱ni̱ꞌñúu numbaa ríge̱ꞌ. <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />Phú gakhe̱ nigíꞌnuꞌ rí ma̱ne̱ ñajuun Ana̱ꞌlóꞌ, ni̱ꞌngo̱ꞌ ne̱ne̱-gáxu̱u̱ ñajun rí ni̱ge̱ꞌe̱ inuꞌ rí ma̱ne̱, jamí táni̱ꞌñúu rí nanimbo̱ꞌ gisngáá ga̱jma̱á numuu Krísto̱. <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />Rí xúge̱ꞌ rá, ríga̱ mújúun máꞌ gamaku rí maxníꞌ Táta̱, tsí naxúdaa mújúun awan. Ikhaa̱ maxníꞌ gamaku ído̱ rí ma̱ꞌkhaa̱, numuu rí nixtáá xómá rí nandoo Ana̱ꞌlóꞌ, jamí ra̱ꞌkhá máꞌ i̱ndo̱ó ikhúúnꞌ maxníꞌ gamaku mbiꞌi rúꞌkhue̱n, rí mangaa máꞌ mbá xúgíin tsí mbá jañii a̱kui̱ín guáꞌthi̱ín rí ma̱ꞌkhaa̱.<verse eid="2TI 4:8" /></para>
  <para style="s">Mbaꞌa inii rí nitháán Timotéo̱</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />Araxná-mina̱ꞌ tsiakhe̱ rí mi̱dxa̱ꞌ máꞌ wapha gátha̱yo̱ꞌ. <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" />Déma̱s niniña-ti̱gu̱ún, numuu rí phú nandoo̱ jaꞌyoo̱ rí ríga̱ ná numbaa, jamí ni̱ke̱e̱ ná xuajen Tesalóni̱ka̱. Xómáꞌ Kresénte̱ ni̱ka̱ ná numbaa Galásia̱, jamí Títo̱ ni̱ka̱ ná numbaa Dalmásia̱. <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" />I̱ndo̱ó máꞌ Lúka̱s xtáa ga̱jma̱á nindxu̱ꞌ ge̱jyoꞌ. Ído̱ gídxá, aya̱ ga̱jma̱a̱ꞌ Márko̱s numuu rí ma̱jmaa̱ mambáyíꞌ ma̱ꞌnii̱ ñajun rí gúꞌdo̱ꞌ ge̱jyoꞌ. <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" />Xómáꞌ Tíki̱ko̱ ni̱xu̱ꞌmáa̱ ma̱ꞌgee̱ ná xuajen Éfe̱so̱. <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" />Ído̱ gídxá, ayá mi̱dxa̱ꞌ tháan xtátsi̱nꞌ rí ni̱ni̱ꞌñúu ná Tróa̱s, ná guꞌwóo Kárpo̱. Ada mi̱dxa̱ꞌ tháan i̱yu̱u̱ꞌ jambúxu̱u̱ꞌ rí waꞌtháán inuu mangaa, jamí phú i̱tha̱án máꞌ na̱xna̱ngáwaaꞌ rí mi̱da-gídxá tháan xtá jambúxu̱u̱ꞌ rí waꞌtháán inuu.<verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />Alejándro̱, xa̱bo̱ tsí nañajuun ajwa̱nꞌ, phú niꞌñiꞌ mi̱ndaꞌkho rí ra̱máján. Táta̱ gáꞌne-numaa̱ xómá jaꞌyoo rí niꞌnii̱. <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />A̱tia̱wa̱n-mína̱ꞌ mangáánꞌ inuu̱, numuu rí phú gakhe̱ ni̱we̱je̱-ꞌthu̱u̱n rí nu̱sngááxo̱ꞌ.<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />Nákhí timbá miꞌtsú rí ni̱tha̱n-mbáyú-mina̱ꞌ ná inuu xa̱bo̱ ñajun ná Róma̱, asndo nimbáa dxájwalóꞌ táꞌthán-mbáá numuꞌ. A̱ꞌkhue̱n gakon, mbá xúgíi̱n ni̱ni̱ꞌñá-ti̱gúu̱n. Ana̱ꞌlóꞌ gáꞌne mba̱a̱ a̱kui̱in jaꞌñúu̱ ga̱jma̱á numuu rúꞌkhue̱n. <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />I̱ndo̱ó máꞌ numuu rí Táta̱ nixtáa ga̱jma̱á nindxu̱ꞌ, jamí nixníꞌ tsiakhe̱ rí ma̱tha̱n-ráꞌa ajngóo̱ kajngó mu̱dxawíín ne̱ mbá xúgíin xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún. Xkuaꞌnii neꞌne-jríñúuꞌ Táta̱ kajngó ma̱xája̱ñúꞌ gúne̱ xa̱bo̱ tsí xómá i̱ndi̱í phuu jaꞌñúú. <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />Nda̱yo̱o̱ mújúnꞌ máꞌ rí Táta̱ ma̱ꞌne-jríñúu̱ inuu mbá xúgíí rí ra̱máján, jamí ma̱ña̱wi̱nꞌ asndo mbiꞌi rí ma̱ꞌgaa̱ jañúu̱ mikhuíí ná naꞌthán-ñájwii̱n. A̱gu̱ma-mba̱a̱ ikhaa̱ jámuu mbiꞌi. Xkuaꞌnii gáꞌne.<verse eid="2TI 4:18" /></para>
  <para style="s">Naꞌthángoo Páblo̱</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />Na̱ra̱xi̱inlo̱ꞌ a̱ngia̱nꞌlóꞌ Prisíla̱<note caller="+" style="f"><char style="fr" closed="false">4.19 </char><char style="ft" closed="false">Ná ajngáa griégo̱ a̱jma̱ mbiꞌyuu a̱ꞌgo̱ tsíge̱ꞌ: «Prisíla̱» jamí «Príska̱».</char></note> jamí Akíla̱, xúꞌkhue̱n máꞌ mbá guꞌwíin xa̱bi̱i Onesífo̱ro̱ mangiin. <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" />Erásto̱ ninguanúu ná xuajen Korínto̱, xómáꞌ Trófi̱mo̱ najáñuu̱ ni̱ni̱ꞌñúu̱ ná xuajen Miléto̱. <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />Araxná-mina̱ꞌ tsiakhe̱ rí mi̱dxa̱ꞌ máꞌ wapha, nákhí rí xóó máꞌ tsíga̱nú go̱nꞌ rí naꞌne ngúwán. Nu̱ra̱xi̱ín Eubúlo̱, Pudénte̱, Líno̱, Kláu̱dia̱ jamí mbá xúgíin a̱ngia̱nꞌlóꞌ. <verse eid="2TI 4:21" /><verse number="22" style="v" sid="2TI 4:22" />Táta̱ Jesukrísto̱ gáxtáa ga̱jma̱á nindxa̱a̱ꞌ, jamí Ana̱ꞌlóꞌ gáꞌne-tsakun-rámáaꞌlaꞌ mbá xúgiáanꞌlaꞌ. Xkuaꞌnii gáꞌne.<note caller="+" style="f"><char style="fr" closed="false">4.22 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa «Xkuaꞌnii gáꞌne».</char></note><verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>