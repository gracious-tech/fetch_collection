<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id">tcfU (45-Hech) - Me̱ꞌpha̱a̱ Mañuwi̱ín (Malinaltepec) pzm 6-jul-2004, c28/v1007</book>
  <para style="h">Rí nene̱</para>
  <para style="toc3">Rnw</para>
  <para style="toc2">Rí nene̱</para>
  <para style="toc1">I̱yi̱i̱ꞌ rí naꞌthán rí nene̱ tsí waxúngui̱inꞌ</para>
  <para style="mt1">I̱yi̱i̱ꞌ rí naꞌthán rí nene̱</para>
  <para style="mt2">tsí waxúngui̱inꞌ</para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="s">Jesús naꞌthán rí ma̱ꞌkha̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />Táta̱ nikhi̱i̱ Teófi̱lo̱, ná i̱yu̱ꞌ rí ne̱ne̱ ginii jayu, ni̱tháán ga̱jma̱á numuu mbá xúgíí rí neꞌne jamí rí niꞌsngáá Jesús, <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />asndo mbiꞌi rí ni̱ka̱ jiꞌyáa̱ mikhuíí. Ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ wapha máꞌ nixná-ñájúu̱n rí mune̱ xa̱bo̱ tsí nixúnguii̱nꞌ, tsí ikhaa̱ máꞌ niraꞌwíi̱n. <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />Ikhiin máꞌ tsúꞌkhue̱n nisngájma-mine̱e̱ꞌ ná inúú, ído̱ rí wámba̱ nimínu̱u̱ꞌ. Mbaꞌa rí niꞌnii̱ ná inúú kajngó mbuyáa̱ rí gakon rí xtáa̱ ndaꞌyee̱. A̱jma̱ skíñú (40) mbiꞌi ni̱ka̱-rasngájma-mine̱e̱ꞌ ná inúú, xúꞌkhue̱n máꞌ ni̱ka̱-raꞌthúu̱n ga̱jma̱á numuu rí Ana̱ꞌlóꞌ ñajuun tsí naꞌthán-ñájúún xa̱bo̱.<verse eid="ACT 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 1:4" />Jamí nákhí rí mbóó xtáa̱ gajmíi̱, nixná-ñájúu̱n ríge̱ꞌ: «Ma̱xágájnalaꞌ ná Jerusalén, aguaꞌthi̱ínlaꞌ tsí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ rí ma̱ꞌkha̱, ikhaa tsí ni̱tha̱nꞌlaꞌ máꞌ ga̱jma̱á numuu. <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />Gakon máꞌ rí Juáán nixúꞌdu-maꞌíin xa̱bo̱ ná awúun iya, xómáꞌ Ana̱ꞌlóꞌ ma̱ꞌne rí ikháanꞌlaꞌ mu̱dríguíilaꞌ Xu̱u̱ꞌ awúun rí i̱mbá wátha̱ máwáa mbiꞌi rí na̱ꞌkha̱ ge̱jyoꞌ».<verse eid="ACT 1:5" /></para>
  <para style="s">Jesús na̱ka̱a mikhuíí</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />A̱ꞌkhue̱n rí xa̱bo̱ tsí ni̱gi̱mbíin ga̱jma̱á nindxu̱u̱ ni̱ra̱xíi̱:</para>
  <para style="p" vid="ACT 1:6">―Táta̱, á mbiꞌi máꞌ xúge̱ꞌ ma̱tha̱ne̱ rí maꞌthán-ñájun mbu̱júu Israél rá.<verse eid="ACT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7" />Xómáꞌ ikhaa̱ niꞌthúu̱n:</para>
  <para style="p" vid="ACT 1:7">―Ra̱jáꞌyalaꞌ ikháanꞌlaꞌ mbu̱ya̱á náá mbiꞌi gáꞌne o nguáná gáꞌne rí niꞌgí-mina̱ꞌ ikhaa Ana̱ꞌlóꞌ ma̱ꞌne. <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />I̱ndo̱ó máꞌ numuu rí ikháanꞌlaꞌ mu̱drígúlaꞌ tsiakhe̱, ído̱ gáꞌkha̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxa̱ꞌlaꞌ, a̱ꞌkhue̱n mu̱tha̱nlaꞌ rí gakon ga̱jma̱á numuꞌ ná Jerusalén, mbá xúgíí numbaa Judéa̱, ná numbaa Samária̱, jamí asndo ná ndámba̱-ri̱go̱o̱ rawuun numbaa.<verse eid="ACT 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 1:9" />Ído̱ wámbo̱o̱ niꞌthée̱n ajngáa rúꞌkhue̱n, jamí awúun máꞌ rí ikhii̱n nu̱ya̱xíi̱, a̱ꞌkhue̱n ndiyáa̱ rí na̱ka̱ jiꞌyáa̱ mikhuíí, asndo rí mbá du̱u̱n nirkaꞌwii̱ ná inúu̱, jamí nánguá máꞌ ndiyáa̱. <verse eid="ACT 1:9" /><verse number="10" style="v" sid="ACT 1:10" />Xómáꞌ ikhii̱n wéje̱ idúu̱n nu̱ya̱xi̱i̱ ná mikhu awúun máꞌ rí ikhaa̱ na̱ka̱-raꞌne-tsíngo̱o̱ꞌ. A̱ꞌkhue̱n ni̱xu̱ꞌma-mijná a̱jmi̱i xa̱bekha tsí miꞌxá xtíñúú ná nijñúu̱. <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />Ikhiin tsúꞌkhue̱n nithan: «Xa̱bo̱ buanuu tsáanꞌ naguwalaꞌ ná numbaa Galiléa̱, náá numuu kajngó nu̱ya̱xe̱laꞌ ná mikhu róꞌ. Ikhaa máꞌ Jesús tsíge̱ꞌ, tsí watríya̱aꞌ ná majña̱ꞌlaꞌ, ni̱ka̱ jiꞌyáa̱ mikhuíí. Xómá ndi̱ya̱álaꞌ rí na̱kaa̱ mikhuíí xkuaꞌnii máꞌ ma̱ꞌkhaa̱».<verse eid="ACT 1:11" /></para>
  <para style="s">Nagájnuu xa̱bo̱ tsí ma̱wi̱ji̱i numuu Júda̱s Iskarióte̱</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />A̱ꞌkhue̱n niguátaa̱n ná júba̱ rí mbiꞌyuu Olíbo̱, niguwáa̱n ná Jerusalén. Mijngi máꞌ ꞌgí júba̱ rúꞌkhue̱n ná Jerusalén, xómá rí nandoo ma̱ꞌga nakhúu xa̱bo̱ awúun mbiꞌi rí nduya̱a xu̱únꞌ xa̱bo̱. <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />Jamí ído̱ niguáꞌnúu̱ ná xuajen, a̱ꞌkhue̱n nitsimáa̱ ná guꞌwá ri̱jma̱á ná niwájwii̱n. Ikhii̱n ñajúún</para>
  <para style="li" vid="ACT 1:13">Pédro̱,</para>
  <para style="li" vid="ACT 1:13">Santiágo̱,<note caller="+" style="f"><char style="fr" closed="false">1.13 </char><char style="ft" closed="false">Ná i̱yi̱i̱ꞌ griégo̱ rí wayuu naꞌthán «Jakóbo̱», rí nithán «Santiágo̱» ná ajngáa xtílo̱o̱.</char></note></para>
  <para style="li" vid="ACT 1:13">Juáán,</para>
  <para style="li" vid="ACT 1:13">Andrés,</para>
  <para style="li" vid="ACT 1:13">Felípe̱,</para>
  <para style="li" vid="ACT 1:13">Tomás,</para>
  <para style="li" vid="ACT 1:13">Bartolomé,</para>
  <para style="li" vid="ACT 1:13">Matéo̱,</para>
  <para style="li" vid="ACT 1:13">Santiágo̱ a̱dée Alféo̱,</para>
  <para style="li" vid="ACT 1:13">Simón Selóte̱</para>
  <para style="li" vid="ACT 1:13">jamí Júda̱s dxíyo̱o̱<note caller="+" style="f"><char style="fr" closed="false">1.13 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «a̱dée».</char></note> Santiágo̱.<verse eid="ACT 1:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="ACT 1:14" />Mbá xúgíin tsíge̱ꞌ na̱gi̱mbúu̱n máꞌ xúꞌkhue̱n rí muthán-jáñíi̱ Ana̱ꞌlóꞌ, gajmíi̱ mbá tikhuun go̱ꞌo̱, ga̱jma̱á María̱ nánée Jesús, jamí gajmíí máꞌ dxíyo̱o̱.<verse eid="ACT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />Mbá mbiꞌi máꞌ rúꞌkhue̱n ni̱tu̱xu̱u̱ꞌ Pédro̱ ná majñu̱ú a̱ngia̱nꞌlóꞌ, tsí naꞌne máꞌ xí mbá majun skíñíi (120) wáa xa̱bo̱ ñajúún, jamí niꞌthúu̱n: <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />«Xa̱bo̱ buanuu a̱ngui̱nꞌ, ndiꞌyóo rí ma̱mba̱núu i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ rí niꞌthán Xu̱u̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ Dabíd ga̱jma̱á numuu Júda̱s, tsí ndiyá ikhúún xa̱bo̱ tsí ni̱rtuwiin Jesús. <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />Júda̱s ningrigo̱o̱ꞌ ga̱jma̱á nindxa̱ꞌlóꞌ, jamí niꞌnii̱ mangaa̱ ñajun rí nu̱ꞌne̱ ikháánꞌlóꞌ».<verse eid="ACT 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 1:18" />(Ikhaa̱ niꞌtsi̱i̱ mbá mbaa ga̱jma̱á mbúkha̱a̱ rí nijanáa̱ ga̱jma̱á numuu rí ra̱máján niꞌnii̱, ikhín ni̱rákaa̱ ga̱jma̱á idxu̱u̱ jamí nimídáa̱ ti̱kua̱pha̱a̱, xúꞌkhue̱n máꞌ mbá xúgíí chámbóo̱ ningujwíi. <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />Jamí mbá xúgíin xa̱bo̱ xuajen Jerusalén ni̱dxawíín rúꞌkhue̱n, ikhaa jngó mbaa rúꞌkhue̱n nixna-mbiꞌíi̱ Asélda̱ma̱ rí ná ajngúu̱n ikhii̱n, rí nandoo gáꞌthán «Mbayuu Iꞌdi»).<verse eid="ACT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20" />«Numuu rí ka̱ma naꞌthán ná I̱yu̱u̱ꞌ ajmúú:</para>
  <para style="q" vid="ACT 1:20">“Ga̱nguanáchúu la guꞌwóo̱,</para>
  <para style="q" vid="ACT 1:20">jamí ma̱xáxtáa nimbáa ná awúun ne̱”<note caller="+" style="f"><char style="fr" closed="false">1.20 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 69.25.</char></note>.</para>
  <para style="m" vid="ACT 1:20">Jamí naꞌthán ne̱ mangaa:</para>
  <para style="q" vid="ACT 1:20">“I̱mba̱a̱ꞌ gáyáa la ñajuu̱n”<note caller="+" style="f"><char style="fr" closed="false">1.20 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 109.8.</char></note>.<verse eid="ACT 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 1:21" />»Ikhaa jngó, ndaꞌyóo rí mu̱ꞌgíilóꞌ mbáa xa̱bo̱ tsí ma̱xtáa ga̱jma̱á nindxa̱ꞌxo̱ꞌ kajngó maꞌthée̱n mangaa̱ rí ndiyáa mbiꞌyuu Jesús. Mu̱ríya̱a̱ꞌlóꞌ ná majñu̱ú máꞌ xa̱bo̱ tsíge̱ꞌ, tsí ningrigu̱ún ga̱jma̱á nindxa̱ꞌxo̱ꞌ mbá xúgíí mbiꞌi rí ningrigo̱o̱ꞌ Táta̱ Jesús ga̱jma̱á nindxa̱ꞌxo̱ꞌ, <verse eid="ACT 1:21" /><verse number="22" style="v" sid="ACT 1:22" />asndo nákhí nigíꞌdu̱u̱n Juáán nixúꞌdu-maꞌíin xa̱bo̱ ná awúun iya asndo mbiꞌi rí ni̱ka̱ jiꞌyáa Jesús mikhuíí».<verse eid="ACT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />A̱ꞌkhue̱n ni̱raꞌwíi̱n a̱jmi̱i xa̱bo̱: José tsí mbiꞌyuu Barsabás, tsí mangaa máꞌ nutháa̱n Jústo̱, jamí Matía̱s. <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />A̱ꞌkhue̱n nithán-jáñíi̱ Ana̱ꞌlóꞌ xáꞌnii: «Ikháánꞌ, Táta̱, nathane̱-nuwiin a̱kui̱ín mbá xúgíin xa̱bo̱, atasngájma tsáa tsí a̱jmi̱i tsíge̱ꞌ nitraꞌwíi, <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />kajngó ma̱grui̱guíi̱ ma̱ꞌnii̱ ñajun ríge̱ꞌ rí nune̱ tsí nixúngui̱inꞌ Jesús, ñajun rí niniñuu Júda̱s ga̱jma̱á numuu aꞌkhúun, kajngó ma̱ꞌgee̱ ná jaꞌyoo̱». <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />A̱ꞌkhue̱n ni̱ra̱xe̱-mijnée̱ kajngó mbuyáa̱ tsáa ágájnuu mbiꞌyuu ma̱ꞌne ñajun rúꞌkhue̱n, a̱ꞌkhue̱n nigájnuu mbiꞌyuu Matía̱s. Jamí asndo nákhí máꞌ mbiꞌi rúꞌkhue̱n ninindxu̱u̱ tsí waxúngua̱a̱ꞌ gajmíi̱ tsí mbá gu̱wa̱ꞌ i̱mbi̱in (11) tsí nixúngui̱inꞌ Jesús.<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s">Ni̱ꞌkha̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />Ído̱ ni̱ga̱nú mbiꞌi rí na̱gu̱ma ndxa̱a̱ Pentekostés, mbá xúgíi̱n mbá ꞌnduꞌ júwe̱e̱ꞌ ni̱gi̱mbúu̱n ná awúun ikhaa máꞌ guꞌwá. <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />A̱ꞌkhue̱n nda̱a̱ ajngóo ni̱ꞌkha̱ mbá a̱ꞌwá ná mikhuíí xómá mbá gíñá rí phú gakhe̱ ixnúu, jamí niwán-toꞌoo a̱ꞌwá ná awúun mbá xúgíí guꞌwá ná traꞌii̱n. <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />A̱ꞌkhue̱n ndiyáa̱ rí xómá ri̱ꞌyu̱u̱ agu jaꞌnii, rí niwiꞌtháa jamí ni̱dráma ná mbámbáa tsí ikhii̱n. <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />Jamí mbá xúgíi̱n ni̱dri̱guíi̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ, a̱ꞌkhue̱n ni̱gíꞌdíi̱n nithee̱n i̱ꞌwá ajngáa, xómá rí Xu̱u̱ꞌ Ana̱ꞌlóꞌ naꞌne rí muthee̱n.<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />Mbiꞌi máꞌ rúꞌkhue̱n júwa̱ꞌ ná Jerusalén xa̱bo̱ judío̱ tsí májáan a̱kui̱ín, tsí niguwá mbá xúgíí xuajen rí ríga̱ ná inuu numbaa. <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />Jamí ído̱ ni̱dxawíi̱n a̱ꞌwá gakhe̱ rúꞌkhue̱n, a̱ꞌkhue̱n ni̱gi̱mbúun mbaꞌiin xa̱bo̱ tsúꞌkhue̱n jamí ni̱ka̱ a̱kuíi̱n, numuu rí mbámbáa nadxawuun rí nuthee̱n, xómá rí ajngóo mbámbáa. <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />Phú ni̱ka̱ a̱kuíi̱n jamí phú nimakúu̱n, a̱ꞌkhue̱n nithee̱n: «Gu̱ya̱xe̱laꞌ, á ra̱ꞌkhá xa̱bo̱ tsí naguwá ná numbaa Galiléa̱ ñajúún mbá xúgíin tsí nuthan ge̱jyoꞌ dxe̱ꞌ. <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />Xáne jaꞌnii kajngó mbámbáa tsí ikháánꞌlóꞌ nu̱dxawíínlóꞌ rí nuthee̱n ajngálóꞌ rí ni̱gu̱máálóꞌ ga̱jma̱á róꞌ. <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />Tsáanꞌ ñajwanlóꞌ xa̱bo̱ Pártia̱, xa̱bo̱ Média̱, xa̱bo̱ Elám, jamí tsáanꞌ juwalóꞌ ná Mesopotámia̱, ná numbaa Judéa̱, ná Kapadósia̱, ná Pónto̱, jamí ná Ásia̱, <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />ná Fríjia̱, ná Panfília̱, ná Ejípto̱, jamí ná mbayuu Áfri̱ka̱ i̱tha̱án ñúꞌún ná Siréne̱, jamí xa̱bo̱ Róma̱ tsí júwa̱ꞌ ge̱jyoꞌ, mbá tikhuáánlóꞌ ñajwanlóꞌ xa̱bo̱ judío̱ asndo nákhí ni̱gu̱máálóꞌ jamí i̱ꞌwíin ni̱rtaxe̱-mijná rí ma̱nindxu̱ún xa̱bo̱ judío̱, <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />xúꞌkhue̱n máꞌ xa̱bo̱ Kréta̱ jamí xa̱bo̱ Arábia̱, mbá xúgiáanꞌlóꞌ nu̱dxawíínlóꞌ rí phú wáá naꞌne Ana̱ꞌlóꞌ, rí nuthee̱n ga̱jma̱á ajngálóꞌ».<verse eid="ACT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 2:12" />Mbá xúgíi̱n phú ni̱ka̱ a̱kuíi̱n jamí phú nimakúu̱n, a̱ꞌkhue̱n ni̱ra̱xe̱-mijnée̱: «Dí lá iyoo gáꞌthán ríge̱ꞌ rá».<verse eid="ACT 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 2:13" />I̱ndo̱ó máꞌ numuu rí i̱ꞌwíin, nune̱-matii̱nꞌ jamí nuthee̱n ríge̱ꞌ: «Najngi̱in tsúꞌkhue̱n».<verse eid="ACT 2:13" /></para>
  <para style="s">Pédro̱ naꞌthán-ráꞌa a̱pha̱ ná inúú mbaꞌiin xa̱bo̱</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />A̱ꞌkhue̱n Pédro̱ ni̱we̱je̱ gajmíí tsí mbá gu̱wa̱ꞌ i̱mbi̱in (11), nixúxi̱i̱ a̱ꞌwóo̱ jamí niꞌthúu̱n: «Xa̱bo̱ buanuu judío̱, jamí mbá xúgiáanꞌlaꞌ tsáanꞌ juwalaꞌ ná Jerusalén ge̱jyoꞌ, a̱gu̱ya̱álaꞌ dí ñajuun rí niríga̱, jamí gu̱dxawíín májánlaꞌ rí ma̱tha̱nꞌlaꞌ. <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />Tsíjngi̱in xa̱bo̱ tsíge̱ꞌ, xómá rí na̱ju̱ma̱ꞌ ikháanꞌlaꞌ, numuu rí ni̱kú máꞌ mijnagu̱wa̱ꞌ i̱ka̱ ajwa̱nꞌ rí miꞌcha̱. <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />Ikhaa ríge̱ꞌ ñajuun rí niꞌthán Joél, tsí ni̱gu̱wíjnga̱a ajngóo Ana̱ꞌlóꞌ wajyúú:<verse eid="ACT 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ACT 2:17" />“Naꞌthán Ana̱ꞌlóꞌ: awúun mbiꞌi rí na̱ka̱-rayámba̱ numbaa,</para>
  <para style="q" vid="ACT 2:17">ma̱xnu̱ú Xu̱ꞌ mbá xúgíin xa̱bo̱ numbaa.</para>
  <para style="q" vid="ACT 2:17">I̱jña̱ꞌlaꞌ tsí xa̱bekha jamí i̱jña̱ꞌlaꞌ tsí go̱ꞌo̱ mu̱rawíjnga̱a ajngóꞌ.</para>
  <para style="q" vid="ACT 2:17">Tsí jñáma mbuyáa̱ inu-mbiꞌíí gáꞌne Ana̱ꞌlóꞌ,</para>
  <para style="q" vid="ACT 2:17">jamí tsí xa̱bo̱ buanuu Ana̱ꞌlóꞌ maꞌthúu̱n ga̱jma̱á majñu̱u̱ xnuꞌndaa.<verse eid="ACT 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ACT 2:18" />Jamí gakon máꞌ rí mbiꞌi rúꞌkhue̱n ma̱xnu̱ú Xu̱ꞌ yumbéꞌ,</para>
  <para style="q" vid="ACT 2:18">kajngó xa̱bekha jamí go̱ꞌo̱ mu̱rawíjnga̱a ajngóꞌ.<verse eid="ACT 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ACT 2:19" />Jamí ma̱ne̱ rí phú wáá ná mikhuíí,</para>
  <para style="q" vid="ACT 2:19">xúꞌkhue̱n máꞌ ma̱ri̱gá rí phú ma̱makúún xa̱bo̱ gáꞌne ná inuu numbaa:</para>
  <para style="q" vid="ACT 2:19">iꞌdi jamí agu, xúꞌkhue̱n máꞌ ru̱jmbo̱oꞌ gúní.<verse eid="ACT 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ACT 2:20" />Xómáꞌ a̱kha̱ꞌ ma̱ꞌni̱i mijína,</para>
  <para style="q" vid="ACT 2:20">jamí go̱nꞌ ma̱ꞌni̱i xómá iꞌdi,</para>
  <para style="q" vid="ACT 2:20">nákhí rí xóó tsíga̱nú mbiꞌi rí ma̱ꞌkha̱a Táta̱.</para>
  <para style="q" vid="ACT 2:20">Mbiꞌi rí phú mba̱a̱ jamí phú mitsaan ñajuun ne̱.<verse eid="ACT 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ACT 2:21" />Jamí jámba̱a̱ tsí naxrígo̱o̱ mbiꞌyuu Táta̱,</para>
  <para style="q" vid="ACT 2:21">ma̱jríya̱a̱ꞌ”.<note caller="+" style="f"><char style="fr" closed="false">2.17-21 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Joél 2.28-32.</char></note><verse eid="ACT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />»Xa̱bo̱ buanuu Israél, gu̱dxawíínlaꞌ ajngáa ríge̱ꞌ: Jesús tsí na̱ꞌkha̱ ná Nasarét, Ana̱ꞌlóꞌ nisngájma rí xtáa ga̱jma̱á nindxu̱u̱ ná majña̱ꞌlaꞌ ga̱jma̱á rí phú wáá, jamí rí ma̱makualóꞌ rí neꞌne Ana̱ꞌlóꞌ ná inalaꞌ ga̱jma̱á majñu̱u̱ ikhaa̱, xómá rí ndu̱ya̱á jmína̱áꞌ ikháanꞌlaꞌ. <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />Ikhaa tsíge̱ꞌ waxnáxi̱i̱ xómá rí awuun Ana̱ꞌlóꞌ jamí xómá rí asndo nákhí máꞌ wapha ndaꞌyoo̱ rí ma̱ri̱gá. Ikháanꞌlaꞌ ni̱rtuwii̱n xúꞌkhue̱n máꞌ ni̱xíya̱a̱laꞌ ga̱jma̱á majñu̱ú xa̱bo̱ tsí ra̱májíin, jamí ni̱dujmaa̱laꞌ ná ixe̱ krúsi̱. <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />I̱ndo̱ó máꞌ numuu rí Ana̱ꞌlóꞌ neꞌne rí mbayáa̱ mbiꞌyuu̱, jamí neꞌne-jríya̱a̱ꞌ inuu ski̱yu̱u̱ꞌ tsí naꞌne rí ma̱ja̱ñúú xa̱bo̱, numuu rí tsiakhe̱ rúꞌkhue̱n tsíꞌngo̱o̱ ne̱ rí ma̱gi̱ꞌdaa̱ mbá jayu. <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />Numuu rí thúngaa Dabíd naꞌthán ga̱jma̱á numuu Jesús:</para>
  <para style="q" vid="ACT 2:25">“Jámba̱ miꞌtsú nda̱yo̱o̱lo̱ꞌ Táta̱ ná inuꞌ.</para>
  <para style="q" vid="ACT 2:25">Numuu rí ikhaa̱ xtáa̱ ná ñawún mújúnꞌ,</para>
  <para style="q" vid="ACT 2:25">nda̱a̱ rí ma̱ꞌne rí ma̱ba̱ñu̱úlo̱ꞌ.<verse eid="ACT 2:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ACT 2:26" />Ikhaa numuu rúꞌkhue̱n nixtáá gagi,</para>
  <para style="q" vid="ACT 2:26">jamí nadxu a̱kui̱nꞌ ne̱ne̱ ajmúú,</para>
  <para style="q" vid="ACT 2:26">jamí asndo ga̱jma̱á mbá jañii a̱kui̱nꞌ mba̱ya̱a xu̱ꞌlo̱ꞌ.<verse eid="ACT 2:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ACT 2:27" />Numuu rí ma̱xáta̱tsi̱ꞌñáá ními̱ꞌ ná iñá-wajíín,</para>
  <para style="q" vid="ACT 2:27">ni máꞌ ma̱xáta̱tsi̱ꞌñáá rí Xa̱bia̱aꞌ tsí Jaꞌwii mi̱ga xuyuu.<verse eid="ACT 2:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ACT 2:28" />Nithane̱ rí ma̱ne̱-núwíinlo̱ꞌ jambo̱o̱ rí ma̱ju̱wá jámuu xa̱bo̱,</para>
  <para style="q" vid="ACT 2:28">jamí ma̱tha̱ne̱ rí ma̱xtáálo̱ꞌ gagi ná inaaꞌ”.<note caller="+" style="f"><char style="fr" closed="false">2.25-28 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 16.8-11.</char></note><verse eid="ACT 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />»Xa̱bo̱ buanuu a̱ngui̱nꞌ, nandoꞌ ma̱tha̱nꞌlaꞌ rí gakon ga̱jma̱á numuu táta̱-xi̱ꞌñálóꞌ Dabíd. Nákhí rí ikhaa̱ nijáñuu̱, waꞌdii̱ la, jamí nduꞌyáálóꞌ rí iñá-wajñuu̱ kri̱ga̱ ne̱ ná majña̱ꞌlóꞌ asndo mbiꞌi xúge̱ꞌ. <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />I̱ndo̱ó máꞌ numuu rí Dabíd ninindxu̱u̱ tsí ni̱gu̱wíjnga̱a ajngóo Ana̱ꞌlóꞌ, jamí ndaꞌyoo̱ máꞌ rí Ana̱ꞌlóꞌ nixuda-mina̱ꞌ ga̱jma̱á nindxu̱u̱ rí ná majñu̱ú xa̱bo̱ ri̱jyu̱u̱ꞌ ma̱ꞌkha̱ Krísto̱, tsí ma̱nindxu̱u̱ thúngaa. <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />Wapha máꞌ ndiꞌyoo̱ rí ma̱ri̱gá, ikhaa jngó niꞌthée̱n rí mbayáa mbiꞌyuu Krísto̱, rí ma̱xánguanúu nímii̱ ná iñá-wajíín, ni máꞌ xuyuu̱ ma̱xíga. <verse eid="ACT 2:31" /><verse number="32" style="v" sid="ACT 2:32" />Ikhaa Jesús tsíge̱ꞌ ndiyáa̱ mbiꞌyuu̱ neꞌne Ana̱ꞌlóꞌ, jamí mbá xúgiáanꞌ ikháanꞌxo̱ꞌ ndi̱ya̱áxo̱ꞌ rúꞌkhue̱n. <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />Rí xúge̱ꞌ rá, waxúxii̱ mikhuíí jamí xtáa̱ ná ñawún mújúun Ana̱ꞌlóꞌ. A̱ꞌkhue̱n ni̱grui̱guíi̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ neꞌne Tátée̱, wámba̱ rúꞌkhue̱n ikhaa̱ nixúngua̱a̱ꞌ rí mu̱dríguíi̱ ikháanꞌxo̱ꞌ xómá rí nixuda-mine̱e̱ꞌ. Ikhaa rúꞌkhue̱n ñajuun rí ndu̱ya̱á ikháanꞌlaꞌ jamí nu̱dxawíínlaꞌ xúge̱ꞌ. <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />Numuu rí Dabíd tátsimaa̱ mikhuíí, i̱ndo̱ó máꞌ numuu rí ikhaa̱ niꞌthée̱n:</para>
  <para style="q" vid="ACT 2:34">“Táta̱ Mikhuíí niꞌthúun Tátéꞌ:</para>
  <para style="q" vid="ACT 2:34">‘Araꞌún ná ñawún mújúnꞌ ge̱jyoꞌ,<verse eid="ACT 2:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="ACT 2:35" />asndo gáskuíji̱in xa̱bo̱ sia̱nꞌ dríga̱a̱ꞌ ná agoo nakhuáaꞌ’ ”.<note caller="+" style="f"><char style="fr" closed="false">2.34-35 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 110.1.</char></note><verse eid="ACT 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36" />»Ikhaa jngó, gu̱dxawíín mújúún mbá xúgíin xa̱bo̱ Israél, rí Jesús tsíge̱ꞌ, tsí ikháanꞌ ni̱dujmaalaꞌ ná ixe̱ krúsi̱, Ana̱ꞌlóꞌ neꞌne rí ma̱nindxu̱u̱ Táta̱ jamí Krísto̱».<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />Ído̱ ni̱dxawíi̱n ajngáa rúꞌkhue̱n, a̱ꞌkhue̱n phú nitájwíin a̱kuíi̱n, jamí nitháa̱n Pédro̱ xúꞌkhue̱n máꞌ i̱ꞌwíin tsí nixúngui̱inꞌ Jesús:</para>
  <para style="p" vid="ACT 2:37">―Xa̱bo̱ buanuu a̱ngia̱nꞌxo̱ꞌ, dí jaꞌyoo mu̱ne̱xo̱ꞌ rá.<verse eid="ACT 2:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38" />A̱ꞌkhue̱n Pédro̱ niꞌthúu̱n:</para>
  <para style="p" vid="ACT 2:38">―Ga̱thanga̱a a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ, jamí mbámbáa tsí ikháanꞌlaꞌ ga̱jngúun ná awúun iya ga̱jma̱á mbiꞌyuu Jesukrísto̱, kajngó ma̱ꞌne mba̱a̱ a̱kui̱in Ana̱ꞌlóꞌ jaꞌyoo aꞌkhánlaꞌ, a̱ꞌkhue̱n mu̱dríguíilaꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ tsí naxniálóꞌ. <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />Numuu rí ikháanꞌlaꞌ jaꞌyalaꞌ rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ, jamí i̱jña̱ꞌlaꞌ, xúꞌkhue̱n máꞌ mbá xúgíin tsí júwa̱ꞌ tsíngua̱ꞌ, jamí mbá xúgíin máꞌ tsí nandoo Táta̱ Ana̱ꞌlóꞌ mandxaꞌúún.<verse eid="ACT 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40" />Xkuaꞌnii iꞌthúu̱n, jamí naꞌthán-múꞌúu̱n ga̱jma̱á mbaꞌa i̱ꞌwá ajngáa: «Gu̱ne̱-jríya̱ꞌ-mijnálaꞌ ná majñu̱ú xa̱bo̱ ra̱májíin tsí júwa̱ꞌ mbiꞌi rí juwalóꞌ».<verse eid="ACT 2:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="ACT 2:41" />Ikhaa jngó, tsí ninimbu̱únꞌ ajngáa rí niꞌthée̱n nijngúún ná awúun iya. Ikhaa máꞌ mbiꞌi rúꞌkhue̱n nijimi̱i xó mbá atsú míl (3 000) wáa xa̱bo̱ ga̱jma̱á nindxúu̱n. <verse eid="ACT 2:41" /><verse number="42" style="v" sid="ACT 2:42" />Jamí tsíni̱ꞌñáa̱ rí nusngáá tsí nixúngui̱inꞌ Jesús, xúꞌkhue̱n máꞌ rí mbá ꞌnduꞌ jambáxúu̱n, rí naꞌphi̱i̱ guma jamí rí nuthán-jáñíi̱ Ana̱ꞌlóꞌ.<verse eid="ACT 2:42" /></para>
  <para style="s">Xó nijúwa̱ꞌ tsí ginuu jayu ninimbu̱únꞌ juyáá Jesús</para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43" />A̱ꞌkhue̱n mbá xúgíin xa̱bo̱ ni̱ka̱ a̱kui̱ín, numuu rí phú mbaꞌa rí ma̱makualóꞌ jamí rí phú wáá nune̱ tsí nixúngui̱inꞌ Jesús. <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />Mbá xúgíin xa̱bo̱ tsí ninimbu̱únꞌ juyáá Jesús mbá ꞌnduꞌ júwe̱e̱ꞌ rí jambáxúu̱n, jamí mbá xúgíí rí guáꞌdáa̱, drígúu̱n mbá xúgíi̱n ñajuun ne̱. <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />Nu̱ngu̱jwe̱e̱ mbañúu̱ jamí rí guáꞌdáa̱, a̱ꞌkhue̱n nu̱xpi̱ꞌtha̱a̱ mbúkho̱o̱ ne̱ ná inúú mbá xúgíin xómá rí ndaꞌyóo mbámbáa. <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />Xúꞌkhue̱n máꞌ tsíni̱ꞌñáa̱ rí nambáxii̱n mbá ꞌnduꞌ tsitsíí ná guꞌwá dxákuun, jamí nune̱-ri̱yaa̱ꞌ rí nikueꞌtso-añuu Jesús ná guꞌwúu̱n. Gagi a̱kuíi̱n naꞌphi̱i̱ guma mbá ꞌnduꞌ, jamí tsímáá nambáxúu̱n. <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />Nune̱-mba̱a̱ Ana̱ꞌlóꞌ, xúꞌkhue̱n máꞌ mbá xúgíin xa̱bo̱ xuajen na̱ni̱gu̱ún juñúu̱. Jamí mbámbá mbiꞌi naꞌne Táta̱ rí xa̱bo̱ tsí nanimbu̱únꞌ juyáá Jesús, ma̱jimi̱i tsí na̱ka̱-rajáwíin ga̱jma̱á nindxúu̱n.<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s">Na̱gu̱ma-thanáá mbáa xa̱bo̱ tsí réngui̱i̱</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />Ni̱ka̱ Pédro̱ ga̱jma̱á Juáán ná guꞌwá dxákuun rí atsú i̱ka̱ ajwa̱nꞌ rí wakhíí, ído̱ rí nuthán-jáñíi̱ Ana̱ꞌlóꞌ. <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />Jamí mbámbá mbiꞌi na̱ꞌkha̱ jiꞌyáa ná guꞌwá dxákuun mbáa xa̱bo̱ tsí réngui̱i̱ asndo nákhí máꞌ ni̱gu̱maa. Ikhaa tsúꞌkhue̱n nu̱ꞌgíi̱ ná rawuun xkrugua rí mbiꞌyuu Mitsaan, kajngó ma̱nda̱ꞌa̱-mínu̱u̱ꞌ ná inúú tsí na̱tu̱ꞌu̱ún ikhín. <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />Ído̱ rí xa̱bo̱ tsíge̱ꞌ ndiꞌyoo rí Pédro̱ ga̱jma̱á Juáán inu júwe̱e̱ꞌ ma̱tu̱ꞌúu̱n ná guꞌwá dxákuun, a̱ꞌkhue̱n ni̱ndu̱ꞌúu̱n rí muxná-míníi̱ꞌ. <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />A̱ꞌkhue̱n rí Pédro̱, ga̱jma̱á Juáán ni̱ya̱xi̱i̱ ná inuu, jamí Pédro̱ niꞌthúu̱n: «Atiaxa̱ꞌxo̱ꞌ». <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />A̱ꞌkhue̱n rí xa̱bo̱ tsúꞌkhue̱n niyaxúu̱n, numuu ni̱ju̱mu̱u̱ rí ríga̱ rí ma̱janáa̱ gúne̱. <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />Xómáꞌ Pédro̱ niꞌthúu̱n: «Na̱nguá gúꞌdo̱ꞌ ajwa̱nꞌ miꞌxá ni máꞌ ajwa̱nꞌ mo̱jmo̱ꞌ, i̱ndo̱ó máꞌ numuu rí na̱xna̱a̱ꞌ rí gúꞌdo̱ꞌlo̱ꞌ: ga̱jma̱á majñu̱u̱ Jesukrísto̱, tsí na̱ꞌkha̱ ná Nasarét, a̱tu̱xa̱a̱ꞌ jamí a̱ngriga̱a̱ꞌ».<verse eid="ACT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 3:7" />A̱ꞌkhue̱n Pédro̱ niwatuun ñawún mújúu̱n, jamí nixúxi̱i̱. Núkho̱ máꞌ ni̱wi̱ji̱i̱ gúkúu̱ ga̱jma̱á nakhúu̱. <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />Asndo ni̱ki̱xi̱i̱ ni̱wi̱ji̱i̱ ga̱jma̱á nakhúu̱ jamí nigíꞌdu̱u̱n ningrigo̱o̱ꞌ. Ni̱to̱ꞌo̱o̱ gajmíi̱ ná guꞌwá dxákuun, ngrigo̱o̱ꞌ jamí na̱ki̱xi̱i̱, xúꞌkhue̱n máꞌ naꞌne-mba̱a̱ Ana̱ꞌlóꞌ. <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />Mbá xúgíin xa̱bo̱ ndiyáá rí ngrigo̱o̱ꞌ xúꞌkhue̱n máꞌ rí naꞌne-mba̱a̱ Ana̱ꞌlóꞌ. <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />Jamí nene̱-nuwii̱n rí ikhaa̱ ñajuu̱n tsí na̱ge̱ꞌe̱ jayu ná guꞌwá dxákuun na̱nda̱ꞌa̱-mínu̱u̱ꞌ ná rawuun xkrugua rí mbiꞌyuu Mitsaan. A̱ꞌkhue̱n phú nimakúu̱n jamí phú nimíñúu̱ ga̱jma̱á numuu rí niríga̱.<verse eid="ACT 3:10" /></para>
  <para style="s">Pédro̱ naꞌthán-ráꞌa ná agoo xka̱mixa rí neꞌne mbiꞌyuu Salomón</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />Xómáꞌ xa̱bo̱ tsí niꞌni̱i nakhúu, xa̱ꞌ katuwii̱n Pédro̱ ga̱jma̱á Juáán. A̱ꞌkhue̱n rí mbá xúgíin xa̱bo̱ ni̱ka̱ a̱kui̱ín, jamí mbá nacha̱ ni̱gi̱mbúu̱n ná wájwii̱n ikhii̱n ná agoo xka̱mixa rí neꞌne mbiꞌyuu Salomón, rí ríga̱ ná rixo̱o̱ guꞌwá dxákuun. <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />Ído̱ ndiꞌyoo Pédro̱ ríge̱ꞌ, a̱ꞌkhue̱n niꞌthúu̱n xa̱bo̱ xuajen: «Xa̱bo̱ buanuu Israél, náá numuu kajngó namakualaꞌ ga̱jma̱á numuu ríge̱ꞌ róꞌ. Náá numuu kajngó nu̱ya̱xa̱ꞌxo̱ꞌ, asndo xó rí ikháanꞌxo̱ꞌ guáꞌdááxo̱ꞌ tsiakhe̱, o ga̱jma̱á numuu rí májáanꞌxo̱ꞌ kajngó ne̱ne̱xo̱ꞌ rí ma̱ngrigo̱o̱ꞌ xa̱bo̱ tsíge̱ꞌ róꞌ. <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />Táta̱ Mikhuíí, tsí ñajuun Anu̱u̱ Abraám, Anu̱u̱ Isaák, Anu̱u̱ Jakób jamí Anu̱ú táta̱-xi̱ꞌñálóꞌ wajyúú, ikhaa̱ niꞌnii̱ rí ma̱gu̱ma-mba̱a̱ A̱dée̱ Jesús. Ikhaa tsí ikháanꞌlaꞌ ni̱xna̱xíi̱laꞌ ná inuu Piláto̱, jamí ni̱tha̱nlaꞌ rí tsíne̱-nuwii̱nlaꞌ, maske máꞌ ikhaa̱ niꞌgí-mine̱e̱ꞌ rí maniñuu̱. <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" />Xómáꞌ ikháanꞌlaꞌ ra̱khálaꞌ gúya̱á tsí Jaꞌwii jamí Jmbii. A̱ꞌkhue̱n gakon ni̱nda̱ꞌa̱laꞌ rí ma̱gu̱ma-jríya̱a̱ꞌ mbáa tsí na̱gu̱díin xa̱bo̱. <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />Jamí ni̱xíya̱a̱laꞌ Tsí Naꞌne rí nduya xa̱bo̱, xómáꞌ Ana̱ꞌlóꞌ neꞌne rí mbayáa̱ mbiꞌyuu̱, jamí ikháanꞌxo̱ꞌ ndi̱ya̱áxo̱ꞌ rúꞌkhue̱n. <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />Ga̱jma̱á numuu rí ninimbo̱o̱ꞌ xa̱bo̱ tsíge̱ꞌ jaꞌyoo Jesús, niꞌni̱i gúkuíi̱, tsí nu̱ya̱xi̱ílaꞌ jamí nu̱ne̱-nuwiin máꞌ ikháanꞌlaꞌ. Ga̱jma̱á numuu rí ninimbo̱o̱ꞌ jaꞌyoo̱ Jesús, ikhaa jngó niꞌni̱i mbá jayu a̱kuii̱n, xómá rí ndu̱ya̱á mbá xúgiáanꞌlaꞌ.<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />»Rí xúge̱ꞌ rá, a̱ngui̱nꞌ, ikhúúnꞌ nda̱yo̱o̱lo̱ꞌ rí ikháanꞌlaꞌ ni̱ñi̱ílaꞌ Jesús rúꞌkhue̱n numuu rí tsíya̱álaꞌ rí e̱ne̱laꞌ, xúꞌkhue̱n máꞌ xa̱bo̱ tsí nuthan-ñajwanlaꞌ mangiin. <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />I̱ndo̱ó máꞌ numuu rí Ana̱ꞌlóꞌ neꞌne-mbánuu xkuaꞌnii, rí wapha máꞌ niꞌthée̱n ga̱jma̱á majñu̱ú mbá xúgíin tsí ni̱rawíjnga̱a ajngóo̱, rí jaꞌyoo mamínu̱u̱ꞌ Krísto̱. <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />Ikhaa jngó, ga̱thanga̱a a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ jamí gu̱riꞌkhu̱u xóo juwalaꞌ, kajngó ma̱ngudi̱i aꞌkhánlaꞌ. A̱ꞌkhue̱n ma̱ꞌkha̱ mbiꞌi rí mbu̱ya̱a xa̱ꞌlaꞌ gáꞌne Ana̱ꞌlóꞌ, <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />jamí ikhaa̱ maxúngua̱a̱ꞌ Jesukrísto̱ ma̱ꞌkha̱ mbu̱júꞌ, tsí wapha máꞌ waꞌthánlaꞌ ga̱jma̱á numuu. <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />Gakon máꞌ rí ndaꞌyóo rí ma̱xtáa̱ ná mikhuíí asndo gága̱nú mbiꞌi rí ma̱gu̱ma-nuxi̱iꞌ mbá xúgíí rí ríga̱, xómá rí niꞌthán Ana̱ꞌlóꞌ wajyúú ga̱jma̱á majñu̱ú xa̱bii̱ tsí jaꞌwuun, tsí ni̱rawíjnga̱a ajngóo̱. <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />Numuu rí Moisés niꞌthúún táta̱-xi̱ꞌñálóꞌ:<note caller="+" style="f"><char style="fr" closed="false">3.22 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí tsíꞌthán «niꞌthúún táta̱-xi̱ꞌñálóꞌ», rí i̱ndo̱ó máꞌ «niꞌthán» iꞌthán ne̱.</char></note> “Táta̱ Ana̱ꞌlaꞌ Mikhuíí maríya̱a̱ꞌ ná majñu̱ú a̱ngia̱nꞌlaꞌ mbáa xa̱bo̱ tsí ma̱gu̱wíjnga̱a ajngóo̱, xómá rí ikhúúnꞌ. Ikháanꞌlaꞌ mu̱dxawíínlaꞌ mbá xúgíí rí maꞌthánlaꞌ ikhaa̱.<note caller="+" style="f"><char style="fr" closed="false">3.22 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yi̱i̱ꞌ ná naꞌthán-makoo xtángoo 18.15.</char></note> <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />Jamí jámba̱a̱ xa̱bo̱ tsí tsíyoo gádxawuun rí naꞌthée̱n ikhaa̱, mi̱xkriya̱a̱ꞌ mbá jayu ná majñu̱ú xa̱bo̱ xuajen”.<verse eid="ACT 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 3:24" />»Jamí mbá xúgíin xa̱bo̱ tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ wajyúú, asndo nákhí máꞌ nixtáa̱ Samuél, niguwée̱ꞌ-ruthee̱n mangii̱n ga̱jma̱á numuu mbiꞌi ríge̱ꞌ. <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />Ikháanꞌ ñajwanlaꞌ i̱ji̱ín xa̱bo̱ tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ, jamí jaꞌyalaꞌ awan rí neꞌne Ana̱ꞌlóꞌ gajmíí táta̱-xi̱ꞌñálóꞌ wajyúú, nákhí rí niꞌthúu̱n Abraám: “Ga̱jma̱á majñu̱ú xa̱bia̱aꞌ, ma̱gu̱ma-tsakun-rámii mbá xúgíin xa̱bo̱ numbaa”.<note caller="+" style="f"><char style="fr" closed="false">3.25 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ xó ni̱gi̱ꞌduun-muu 22.18.</char></note> <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />Ikhaa jngó, nákhí rí Ana̱ꞌlóꞌ neꞌne rí mbayáa mbiꞌyuu A̱dée, ginii jayu nixúngua̱a̱ꞌ ná inalaꞌ ikháanꞌlaꞌ, kajngó ma̱ꞌne-tsakun-rámáaꞌlaꞌ, jamí mbámbáa tsí ikháanꞌlaꞌ maniñuu rí ra̱máján naꞌne».<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s">Pédro̱ ga̱jma̱á Juáán júwa̱ꞌ ná inúú xa̱bo̱ buanuu ede̱</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />Awúun máꞌ rí Pédro̱ ga̱jma̱á Juáán nuthúún xóó xa̱bo̱, a̱ꞌkhue̱n niguáꞌnú dxakuun inúu̱, xúꞌkhue̱n máꞌ xa̱bo̱ tsí naꞌthán-ñájúún tsí nu̱ña̱wa̱án guꞌwá dxákuun jamí xa̱bo̱ saduséo̱. <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />Phú najiꞌníi̱ numuu rí Pédro̱ ga̱jma̱á Juáán nusngúún xa̱bo̱ jamí nuthúu̱n rí xa̱bo̱ tsí nijáñúú mbuya̱a mbiꞌñúú ga̱jma̱á numuu rí Jesús ndiyáa mbiꞌyuu. <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />A̱ꞌkhue̱n ni̱ra̱tuu̱n jamí ni̱xu̱dii̱nꞌ ná géjwa̱nꞌ asndo i̱mba̱ mbiꞌi, numuu rí wakhíí máꞌ. <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />I̱ndo̱ó máꞌ numuu rí phú mbaꞌiin xa̱bo̱ tsí ni̱dxawíín ajngáa rí nithee̱n, ninimbúu̱n juyáa̱ ne̱, jamí naꞌne máꞌ xí mbá witsu míl (5 000) wáa tsí i̱ndo̱ó xa̱bekha ñajúún.<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />I̱mba̱ mbiꞌi, ni̱ru̱wa-mijnáa ná Jerusalén xa̱bo̱ ñajun, xa̱bo̱ buanuu jamí xa̱bo̱ tsí nusngáá xtángoo. <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />Ikhín máꞌ xtáa mangaa Anás tsí jayá idxu̱ún dxakuun, xúꞌkhue̱n máꞌ Kaifás, Juáán, Alejándro̱, jamí mbá xúgíin xa̱bo̱ guꞌwúún tsí juya̱ idxu̱ún dxakuun. <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />A̱ꞌkhue̱n ni̱tsijii̱ Pédro̱ ga̱jma̱á Juáán ná ti̱kua̱pha̱a̱ inúú xa̱bo̱, jamí ni̱ra̱xúu̱n:</para>
  <para style="p" vid="ACT 4:7">―Tsáa nixnálaꞌ tsiakhe̱, o tsáa niꞌthánlaꞌ rí mu̱ne̱laꞌ ríge̱ꞌ róꞌ.<verse eid="ACT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8" />A̱ꞌkhue̱n rí Xu̱u̱ꞌ Ana̱ꞌlóꞌ xtáa ga̱jma̱á nindxu̱u̱ Pédro̱, jamí niꞌthúu̱n xa̱bo̱:</para>
  <para style="p" vid="ACT 4:8">―Xa̱bo̱ ñajun ná xuajen, jamí xa̱bo̱ buanuu ná Israél: <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />xúge̱ꞌ ikháanꞌlaꞌ nu̱ra̱xa̱ꞌxo̱ꞌ ga̱jma̱á numuu rí máján ni̱gu̱maa mbáa xa̱bo̱ tsí najáñuu, jamí xáne niꞌni̱i a̱kuii̱n. <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />Ikhaa jngó, ga̱ma̱ñalaꞌ mbá xúgiáanꞌlaꞌ jamí mbá xúgíin xa̱bo̱ xuajen Israél, rí xa̱biya̱ tsíge̱ꞌ niꞌni̱i a̱kui̱in jamí wíji̱i̱ ná inalaꞌ ga̱jma̱á ski̱yu̱u̱ꞌ Jesukrísto̱ tsí na̱ꞌkha̱ ná Nasarét, tsí ikháanꞌlaꞌ ni̱dujmaalaꞌ ná ixe̱ krúsi̱ jamí Ana̱ꞌlóꞌ neꞌne rí mbayáa̱ mbiꞌyuu̱. <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />Jesús tsíge̱ꞌ ñajuun itsí rí ra̱khálaꞌ gájmalaꞌ tsáanꞌ nu̱ne̱laꞌ guꞌwá, jamí ikhaa̱ ninindxu̱u̱ itsí mba̱a̱ rí jayá ski̱yu̱u̱ꞌ rakhóo guꞌwá. <verse eid="ACT 4:11" /><verse number="12" style="v" sid="ACT 4:12" />Jamí ndawa̱a̱ i̱mba̱a̱ꞌ tsí ma̱ꞌne-jáwíin xa̱bo̱ numbaa. Numuu rí ná numbaa ríge̱ꞌ ndawa̱a̱ i̱mba̱a̱ꞌ xa̱bo̱ tsí nixniálóꞌ Ana̱ꞌlóꞌ, tsí ma̱goo ma̱ꞌne-jríñáaꞌlóꞌ.<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />Ído̱ rí xa̱bo̱ ñajun ná xuajen ndiyáá rí Pédro̱ ga̱jma̱á Juáán tsímíñúu̱ rí muthee̱n, mangaa máꞌ ndiyáa̱ rí xa̱bo̱ tsí túne̱-gajma̱a̱ ñajúu̱n, jamí xa̱bo̱ tsí tsíyáá ñajúu̱n, phú nimakúu̱n juñúu̱. A̱ꞌkhue̱n nifruꞌúu̱n rí ningrigúu̱n ga̱jma̱á nindxu̱u̱ Jesús. <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />Xúꞌkhue̱n máꞌ nduyáa̱ rí xa̱bo̱ tsí niꞌni̱i a̱kui̱in, wéje̱ ga̱jma̱á nindxúu̱n, a̱ꞌkhue̱n ndiyáa̱ rí nda̱a̱ nitháan rí ma̱goo muthee̱n ga̱jma̱á numúú. <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />A̱ꞌkhue̱n nixna-ñajúu̱n rí ma̱ga̱jnúu̱ ná gachúún xa̱bo̱ buanuu ede̱, kajngó muthan-mijnée̱ i̱ndo̱ó máꞌ ikhii̱n rí jaꞌyoo muni̱i̱. <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />Xáꞌnii nithan-mijnée̱: «Dí gúꞌne̱lóꞌ ga̱jma̱á nindxu̱ún xa̱bo̱ tsíge̱ꞌ rá. Numuu rí gakon máꞌ, phú wáá rí niríga̱ nini̱i̱ ikhii̱n. Mbá xúgíin xa̱bo̱ tsí júwa̱ꞌ ná Jerusalén nduyáá ríge̱ꞌ, jamí ma̱xáxóo mu̱ꞌthánlóꞌ rí ra̱gákon rúꞌkhue̱n. <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />Maske máꞌ xúꞌkhue̱n niríga̱, gu̱ꞌne̱-mi̱ꞌñúu̱lóꞌ kajngó náxútháa̱n nimbáa xa̱bo̱ ga̱jma̱á numuu xa̱bo̱ tsúꞌkhue̱n, kajngó náxádróꞌoo ajngáa ríge̱ꞌ ná inúú xa̱bo̱». <verse eid="ACT 4:17" /><verse number="18" style="v" sid="ACT 4:18" />A̱ꞌkhue̱n ni̱ndxa̱ꞌwáa̱n, jamí nixna-ñajúu̱n rí náxúthee̱n mbá jayu ni máꞌ náxúsngáa̱ ga̱jma̱á numuu Jesús.<verse eid="ACT 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 4:19" />Xómáꞌ Pédro̱ ga̱jma̱á Juáán ni̱riꞌñee̱: «Gu̱ra̱jwa̱ꞌ máꞌ ikháanꞌlaꞌ xí máján ná inuu Ana̱ꞌlóꞌ rí mu̱ne̱-mbánííxo̱ꞌ rí nu̱tha̱n ikháanꞌlaꞌ, o rí mu̱ne̱-mbánííxo̱ꞌ rí naꞌthán Ana̱ꞌlóꞌ. <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />Numuu rí ma̱xáxóo mu̱ni̱ꞌñáá ru̱tha̱nxo̱ꞌ rí ndi̱ya̱áxo̱ꞌ jamí rí ni̱dxawíínxo̱ꞌ».<verse eid="ACT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 4:21" />A̱ꞌkhue̱n rí xa̱bo̱ ñajun nene̱-mi̱ꞌñúu̱ mbu̱júꞌ, jamí ni̱ni̱ꞌñúu̱ magúu̱n guꞌwúu̱n. Túxkamaa̱ xáne gúni̱i̱ rí mu̱xpa̱thúu̱n, numuu rí mbá xúgíin xa̱bo̱ xuajen nune̱-mba̱a̱ Ana̱ꞌlóꞌ ga̱jma̱á numuu rí niríga̱. <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />Numuu rí xa̱bo̱ tsí niꞌni̱i a̱kui̱in ga̱jma̱á rí phú wáá ríge̱ꞌ, nanújngoo máꞌ rí a̱jma̱ skíñú (40) tsiguu̱.<verse eid="ACT 4:22" /></para>
  <para style="s">Tsí nanimbu̱únꞌ juyáá Jesús nu̱nda̱ꞌa̱ rí ma̱ꞌne jañii a̱kui̱ín</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />Ído̱ rí Pédro̱ ga̱jma̱á Juáán ni̱gu̱ma-jáwíi̱n, a̱ꞌkhue̱n nigúu̱n ná inúú a̱nguíi̱n, jamí nithúu̱n mbá xúgíí rí waꞌthúu̱n nene̱ dxakuun tsí gíꞌdoo numúú jamí xa̱bo̱ buanuu. <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />Ído̱ wámba̱ ni̱dxawíi̱n ajngáa rúꞌkhue̱n, a̱ꞌkhue̱n ni̱xu̱xíi̱ mbá ꞌnduꞌ a̱ꞌwúu̱n ná inuu Ana̱ꞌlóꞌ jamí nithee̱n: «Táta̱, tsáánꞌ narathán-ñájwíín numbaa, ikháánꞌ ñajwaanꞌ Ana̱ꞌxo̱ꞌ<note caller="+" style="f"><char style="fr" closed="false">4.24 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «ikháánꞌ ñajwaanꞌ Ana̱ꞌxo̱ꞌ».</char></note> tsí neꞌne-ku̱maa mikhu, ju̱ba̱ꞌ jamí iya a̱pha̱, xúꞌkhue̱n máꞌ mbá xúgíí rí ríga̱ ná awúun ne̱. <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />Ikháánꞌ nirathán ga̱jma̱á majñu̱u̱ yumbiáaꞌ Dabíd:<note caller="+" style="f"><char style="fr" closed="false">4.25 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán xáꞌnii: «Ikháánꞌ nirathán ga̱jma̱á majñu̱u̱ Xa̱a̱ꞌ jamí ga̱jma̱á majñu̱u̱ táta̱-xi̱ꞌñáxo̱ꞌ Dabíd, tsí ñajuun yumbiáaꞌ».</char></note></para>
  <para style="q" vid="ACT 4:25">“Náá numuu kajngó najñaguun guéño xa̱bo̱ numbaa,</para>
  <para style="q" vid="ACT 4:25">jamí nda̱a̱ mbá jayu numuu rí nu̱ndxa̱ꞌwa̱-mijná xa̱bo̱ xuajen rí mune̱ róꞌ.<verse eid="ACT 4:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ACT 4:26" />Ni̱gímbú-mijná thúngaa tsí nuthan-ñajun ná numbaa,</para>
  <para style="q" vid="ACT 4:26">xúꞌkhue̱n máꞌ mbóó niwi̱in xa̱bo̱ buanuu ná xuajen,</para>
  <para style="q" vid="ACT 4:26">rí mune̱-gajmíi̱ Táta̱ jamí Krísto̱, tsí ikhaa̱ niraꞌwíi̱”.<note caller="+" style="f"><char style="fr" closed="false">4.26 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 2.1-2.</char></note><verse eid="ACT 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 4:27" />»Numuu rí gakon máꞌ rí ná xuajen ríge̱ꞌ ni̱ru̱wa-mina̱aꞌ Eróde̱s ga̱jma̱á Pónsio̱ Piláto̱, gajmíí xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, jamí xa̱bo̱ xuajen Israél, rí ma̱guaꞌdaa̱ sia̱nꞌ A̱ꞌdiáaꞌ Jesús tsí jaꞌwii, tsí ikháánꞌ máꞌ nitraꞌwíi rí ma̱nindxu̱u̱ thúngaa. <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />Rí xkuaꞌnii nini̱i̱, nene̱-mbáníi̱ mbá xúgíí rí wapha máꞌ nithaꞌgí-mina̱ꞌ jamí ndiyaaꞌ rí ma̱ri̱gá. <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />Jamí xúge̱ꞌ rá, Táta̱, athayáá xó rí nune̱-mi̱ꞌñáxo̱ꞌ. Ikhaa jngó, atambáyáxo̱ꞌ tsáanꞌ yumbiáaꞌ ñajwanxo̱ꞌ, rí ma̱xámíñaxo̱ꞌ mu̱tha̱n-ráꞌaxo̱ꞌ ajngáaꞌ. <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />Atasngájma ski̱ya̱a̱ꞌ ga̱jma̱á majñu̱u̱ A̱ꞌdiáaꞌ Jesús tsí jaꞌwii, kajngó ma̱gu̱ma-thanúú xa̱bo̱ jamí ma̱ri̱gá rí phú wáá, xúꞌkhue̱n máꞌ ma̱ri̱gá rí phú namakúún xa̱bo̱ eꞌne».<verse eid="ACT 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31" />Ído̱ wámbúu̱n nithán-jáñíi̱ Ana̱ꞌlóꞌ, a̱ꞌkhue̱n nixma ná gatii̱n, jamí mbá xúgíi̱n ni̱dri̱guíi̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ, jamí mbá jañii a̱kuíi̱n nuthan-raꞌee̱ ajngóo Ana̱ꞌlóꞌ.<verse eid="ACT 4:31" /></para>
  <para style="s">Mbá xúgíí rí guáꞌdáa̱ drígúu̱n mbá xúgíi̱n ñajuun ne̱</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />Jamí mbá xúgíin tsí mbaꞌiin ninimbu̱únꞌ juyáá Jesús, mbóó a̱kuíi̱n jamí mbóó máꞌ ju̱múu̱. Nimbáa tsíꞌthán xí drígo̱o̱ mbáwíi ñajuun rí gíꞌdoo, rí mbá xúgíí rí guáꞌdáa̱ drígúu̱n mbá xúgíi̱n ñajuun ne̱. <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />Xómáꞌ tsí nixúngui̱inꞌ Jesús, phú mba̱a̱ tsiakhe̱ guáꞌdáa̱ jamí nuthee̱n rí ndiyáa mbiꞌyuu Táta̱ Jesús, xúꞌkhue̱n máꞌ phú mba̱a̱ na̱gu̱ma-tsakun-rámii̱ mbá xúgíi̱n eꞌne Ana̱ꞌlóꞌ. <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />Ikhaa jngó ndawa̱a̱ nimbáa tsí ndaꞌyóo ná majñúu̱. Numuu rí mbá xúgíin tsí guáꞌdáá mbañúú o guꞌwúún, nu̱ngu̱jwe̱e̱ ne̱, jamí naguwáa̱n juñúu̱ mbúkho̱o̱ rí ni̱ngu̱jwe̱e̱. <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />Jamí nu̱xna̱xíi̱ ne̱ ná inúú tsí nixúngui̱inꞌ Jesús, kajngó ma̱wiꞌtháa ne̱ xómá rí ndaꞌyóo mbámbáa. <verse eid="ACT 4:35" /><verse number="36" style="v" sid="ACT 4:36" />Xkuaꞌnii máꞌ neꞌne mangaa mbáa xa̱bo̱ tsí jayá iꞌdiuu Lebí, tsí na̱ꞌkha̱ ná Chípre̱. Xa̱bo̱ tsúꞌkhue̱n mbiꞌyuu José, xómáꞌ tsí nixúngui̱inꞌ Jesús nixna-mbiꞌíi̱ Bernabé (rí nandoo gáꞌthán «xa̱bo̱ tsí naxnáa la tsiakhe̱»). <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />José gíꞌdoo mbá mbaa, ikhaa rúꞌkhue̱n ni̱ngu̱jwe̱e̱ jamí ni̱ꞌkhaa̱ jayóo̱ mbúkho̱o̱ ne̱, jamí nixnáxi̱i̱ ne̱ ná inúú tsí nixúngui̱inꞌ Jesús.<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s">Ananía̱s ga̱jma̱á Safíra̱</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />I̱ndo̱ó máꞌ numuu rí mbáa xa̱bo̱ tsí mbiꞌyuu Ananía̱s, ga̱jmáa̱ a̱ꞌguii̱ mbiꞌyuu Safíra̱, ikhii̱n ni̱ngu̱jwe̱e̱ mbá mbaa. <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />Jamí nimbánuu̱ ga̱jmáa̱ a̱ꞌguii̱ rí ma̱nguanúu̱ ga̱jma̱á tháan mbúkha̱a̱. A̱ꞌkhue̱n ni̱ꞌkha̱ jayóo̱ mbúkha̱a̱ rí napíduun, jamí nixnáxi̱i̱ ne̱ ná inúú tsí nixúngui̱inꞌ Jesús.<verse eid="ACT 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 5:3" />A̱ꞌkhue̱n Pédro̱ niꞌthúu̱n: «Ananía̱s, náá numuu kajngó nitatsíñá-mina̱ꞌ rí Satanás maꞌthán-ñájuun a̱kia̱anꞌ rí ma̱tha̱ne̱-nduwaa Xu̱u̱ꞌ Ana̱ꞌlóꞌ, jamí nitrígú tháan inuu mbúkho̱o̱ mbayaaꞌ róꞌ. <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />Nákhí rí xóó tsíta̱ngu̱jwa̱ ne̱, ñawáanꞌ máꞌ ikháánꞌ ríga̱ ne̱. Jamí ído̱ ni̱ta̱ngu̱jwa̱ ne̱, mbúkha̱a̱ꞌ máꞌ ikháánꞌ ñajuun ne̱. Náá numuu kajngó nithaꞌgí-mina̱ꞌ rí ma̱tha̱ne̱ rúꞌkhue̱n róꞌ. Ra̱ꞌkhá xa̱bo̱ numbaa nithane̱-nduwiin, rí Ana̱ꞌlóꞌ nithane̱-nduwaa».<verse eid="ACT 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 5:5" />Ído̱ nidxawuun Ananía̱s ajngáa rúꞌkhue̱n, a̱ꞌkhue̱n ningáxi̱i̱ jamí nijáñuu̱. Jamí mbá xúgíin tsí ni̱dxawíín rí niríga̱, maphú nimíñúu̱. <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />A̱ꞌkhue̱n niguwá jñáma, ni̱mbráꞌáá xuyuu̱ ga̱jma̱á xtíin, jamí ni̱ríya̱a̱ꞌ, nigóo̱ gúdii̱.<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />Ninújngoo xó mbá atsú kíxnuu wáa iduu ajwa̱nꞌ, a̱ꞌkhue̱n ni̱ꞌkha̱ a̱ꞌguii̱, jamí tsíꞌyoo̱ dí ñajuun niríga̱. <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />A̱ꞌkhue̱n Pédro̱ niꞌthúu̱n:</para>
  <para style="p" vid="ACT 5:8">―Arathúnꞌ, á ríge̱ꞌ ñajuun mbá xúgíí mbúkha̱a̱ rí ni̱drígúlaꞌ ga̱jma̱á numuu mbayalaꞌ rí ni̱ngu̱jwa̱laꞌ rá.</para>
  <para style="p" vid="ACT 5:8">A̱ꞌkhue̱n ikhaa̱ niriꞌñee̱:</para>
  <para style="p" vid="ACT 5:8">―Aan, mbá xúgíí máꞌ ne̱ rúꞌkhue̱n.<verse eid="ACT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9" />Jamí Pédro̱ niꞌthúu̱n:</para>
  <para style="p" vid="ACT 5:9">―Náá numuu kajngó niguaꞌdáálaꞌ awan rí mu̱jmaalaꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ kajngó mbu̱ya̱á dí gáꞌne róꞌ. Atiaxe̱ rí ná xkrugua a̱ꞌkhue̱n, inu naguáꞌnúu tsí nigóó gúdi̱i a̱jmbia̱aꞌ, jamí xúge̱ꞌ magóo̱ gúdíi̱n ikháánꞌ mangáánꞌ.<verse eid="ACT 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 5:10" />A̱ꞌkhue̱n núkho̱ máꞌ ningáxi̱i̱ Safíra̱ ná nakhúu Pédro̱ jamí nijáñuu̱. Ído̱ ni̱ta̱ꞌa̱án jñáma guꞌwáá, ndiyáa̱ rí kri̱ga̱a̱ nijáñuu̱, a̱ꞌkhue̱n ni̱ríya̱a̱ꞌ jamí nigóo̱ gúdii̱ ná níjñúu máꞌ a̱jmbaa̱. <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />Jamí mbá xúgíin tsí nanimbu̱únꞌ juyáá Jesús maphú nimíñúu̱, xúꞌkhue̱n máꞌ mbá xúgíin tsí ni̱dxawíín ríge̱ꞌ.<verse eid="ACT 5:11" /></para>
  <para style="s">Tsí nixúngui̱inꞌ Jesús nune̱-thanúú xa̱bo̱</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />Ga̱jma̱á majñu̱ú tsí nixúngui̱inꞌ Jesús na̱gu̱ma mbaꞌa rí phú wáá ná inúú xa̱bo̱ xuajen, jamí rí phú namakúún xa̱bo̱ eꞌne, ná inúú xa̱bo̱ xuajen. Jamí mbá xúgíin tsí nanimbu̱únꞌ juyáá Jesús mbá ꞌnduꞌ júwe̱e̱ꞌ ná agoo xka̱mixa rí neꞌne mbiꞌyuu Salomón, rí ríga̱ máꞌ ná rixo̱o̱ guꞌwá dxákuun. <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />Nimbáa tsí i̱ꞌwíin xa̱bo̱ tsíꞌngo̱o̱ a̱kui̱ín gámbáxu̱únꞌ ga̱jma̱á nindxúu̱n, maske máꞌ mbá xúgíin xa̱bo̱ xuajen nuthan rí máján ga̱jma̱á numúu̱. <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />Jamí tsí nanimbu̱únꞌ juyáá Táta̱ Jesús i̱tha̱án i̱ka̱-raꞌne mbaꞌii̱n, xa̱bekha jamí go̱ꞌo̱. <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />Ikhaa jngó nu̱rawíi̱n tsí najáñúú ná rawuun jamba̱a̱ ma̱jña̱ꞌ. Nu̱strigii̱n ga̱jma̱á xi̱yawúu̱n jamí ga̱jma̱á agúu̱n, kajngó ído̱ gánújngoo Pédro̱, maske máꞌ i̱ndo̱ó nákoo̱ gángájmii mbá tikhuun tsí najáñúú. <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />Jamí asndo xa̱bo̱ tsí júwa̱ꞌ ná xuajen rí triga̱ mijngi ná Jerusalén, phú mbaꞌii̱n naguwée̱ꞌ judii̱n xa̱bo̱ tsí najáñúú, xúꞌkhue̱n máꞌ xa̱bo̱ tsí na̱gu̱ma-ngíníi ene̱ gíñá ꞌguéen, jamí mbá xúgíi̱n naꞌni̱i a̱kuíi̱n.<verse eid="ACT 5:16" /></para>
  <para style="s">Na̱gu̱ma-ngínáa Pédro̱ ga̱jma̱á Juáán</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />A̱ꞌkhue̱n tsí jayá idxu̱ún dxakuun gajmíí mbá xúgíin xa̱bo̱ tsí júwa̱ꞌ ga̱jma̱á nindxu̱u̱, ikhiin tsí ñajúún xa̱bo̱ saduséo̱, phú nixígúu̱n juñúu̱ tsí nixúngui̱inꞌ Jesús. <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />A̱ꞌkhue̱n ni̱ra̱tuu̱n jamí ni̱xu̱dii̱nꞌ ná géjwa̱nꞌ. <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />I̱ndo̱ó máꞌ numuu rí mbáa ánje̱l tsí nixúngua̱a̱ꞌ Táta̱ nirmáꞌthoo mbá xúgíí xkrugoo géjwa̱nꞌ rí mbroꞌon, xúꞌkhue̱n máꞌ ni̱gu̱wíi̱n jamí niꞌthúu̱n: <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />«Gaꞌgualaꞌ ná guꞌwá dxákuun, jamí gu̱thu̱únlaꞌ xa̱bo̱ xuajen mbá xúgíí ajngáa ríge̱ꞌ, rí naꞌne rí ma̱ju̱wá xa̱bo̱». <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />Ído̱ ni̱dxawíi̱n ajngáa ríge̱ꞌ, a̱ꞌkhue̱n miꞌcha̱ ni̱tu̱ꞌúu̱n ná guꞌwá dxákuun jamí ni̱gíꞌdíi̱n nisngáa̱.</para>
  <para style="p" vid="ACT 5:21">Awúun máꞌ rúꞌkhue̱n ni̱ga̱nú tsí jayá idxu̱ún dxakuun gajmíi̱ mbá xúgíin xa̱bo̱ tsí júwa̱ꞌ ga̱jma̱á nindxu̱u̱, jamí ni̱ndxa̱ꞌwúu̱n xa̱bo̱ buanuu ede̱ jamí mbá xúgíin xa̱bo̱ buanuu tsí ñajúún i̱ji̱in Israél, kajngó muthan-mijnée̱ gajmíi̱. A̱ꞌkhue̱n ni̱xu̱ꞌmii̱ xa̱bo̱ ná géjwa̱nꞌ kajngó ma̱guwá judii̱n tsí nixúngui̱inꞌ Jesús. <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />I̱ndo̱ó máꞌ numuu rí ído̱ niguáꞌnú tsí nu̱ña̱wa̱án guꞌwá dxákuun, túxkamii̱ ná géjwa̱nꞌ. A̱ꞌkhue̱n niguwáa̱n juñúu̱ ajngáa. <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />Xáꞌnii nithee̱n: «Ído̱ niguáꞌnúxo̱ꞌ ná géjwa̱nꞌ ndi̱ya̱áxo̱ꞌ rí júgoo mújúun mbá xúgíí xkrugua, jamí tsí nu̱ña̱wa̱án wájun ná rawuun xkrugua. I̱ndo̱ó máꞌ numuu rí ído̱ ni̱rmáꞌthááxo̱ꞌ géjwa̱nꞌ, nimbáa túxkamaaxo̱ꞌ ná awúun ne̱».<verse eid="ACT 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 5:24" />Ído̱ ni̱dxawíi̱n ajngáa rúꞌkhue̱n, tsí jayá idxu̱ún dxakuun, tsí naꞌthán-ñájúún tsí nu̱ña̱wa̱án guꞌwá dxákuun jamí dxakuun tsí gíꞌdoo numúú, a̱ꞌkhue̱n rí tsiánguá neꞌne a̱kuíi̱n, jamí nu̱ra̱xe̱-mijnée̱ asndo náá ága̱nú mbá xúgíí rúꞌkhue̱n. <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />Awúun máꞌ rúꞌkhue̱n ni̱ꞌkha̱ mbáa xa̱bo̱ tsí niꞌthúu̱n: «Gu̱dxawíínlaꞌ, xa̱bo̱ tsí ni̱xu̱ꞌdíinlaꞌ géjwa̱nꞌ, ná awúun guꞌwá dxákuun traꞌii̱n jamí nusngúu̱n xa̱bo̱ xuajen».<verse eid="ACT 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 5:26" />A̱ꞌkhue̱n ni̱ka̱ tsí jayá idxu̱ún xa̱bo̱ tsí nu̱ña̱wa̱án guꞌwá dxákuun gajmíi̱ xa̱bii̱, jamí niguwá judii̱n. Táguwá judii̱n máꞌ ga̱jma̱á tsiakhe̱, numuu namíñúu̱ rí mi̱ꞌxnúu̱ ga̱jma̱á itsí gúne̱ xa̱bo̱ xuajen. <verse eid="ACT 5:26" /><verse number="27" style="v" sid="ACT 5:27" />Ído̱ niguwá judii̱n, ni̱xna̱xíi̱n ná inúú xa̱bo̱ buanuu ede̱. A̱ꞌkhue̱n tsí jayá idxu̱ún dxakuun niꞌthúu̱n:<verse eid="ACT 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 5:28" />―Ikháanꞌxo̱ꞌ ni̱xna̱-ñájwanlaꞌxo̱ꞌ rí mu̱xúsngáálaꞌ mbá jayu ga̱jma̱á numuu xa̱bo̱ tsúꞌkhue̱n. Xómáꞌ ikháanꞌlaꞌ rá, ne̱ne̱-matíílaꞌ ná Jerusalén ga̱jma̱á rí nu̱sngáálaꞌ, jamí nandalaꞌ gúrígu tsu̱da̱ꞌxo̱ꞌ rí ikháanꞌxo̱ꞌ ni̱xíya̱a̱xo̱ꞌ xa̱bo̱ tsúꞌkhue̱n.<verse eid="ACT 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29" />A̱ꞌkhue̱n niriꞌña Pédro̱ gajmíí i̱ꞌwíin tsí nixúngui̱inꞌ Jesús:</para>
  <para style="p" vid="ACT 5:29">―I̱tha̱án máꞌ gíꞌmáaꞌxo̱ꞌ rí mu̱ne̱-mbáníí rí naꞌthán Ana̱ꞌlóꞌ, xó rí mu̱ne̱-mbánííxo̱ꞌ rí nuthan xa̱bo̱ numbaa. <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />Ana̱ꞌlóꞌ tsí ñajuun Anu̱ú táta̱-xi̱ꞌñálóꞌ wajyúú neꞌne rí mbayáa mbiꞌyuu Jesús, tsí ikháanꞌlaꞌ ni̱xíya̱a̱ nákhí rí ni̱drákamaa̱laꞌ ná ixe̱ krúsi̱. <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />Ikhaa tsíge̱ꞌ, Ana̱ꞌlóꞌ neꞌne rí ma̱gi̱ꞌdoo numuu̱ jamí niꞌgíi̱ ná ñawún mújúu̱n, xúꞌkhue̱n máꞌ niꞌnii̱ rí ma̱nindxu̱u̱ xa̱bo̱ ede̱ jamí tsí naꞌne-jríñáaꞌlóꞌ, kajngó xa̱bo̱ Israél ma̱goo ma̱thanga̱a a̱kuíi̱n, jamí Ana̱ꞌlóꞌ ma̱ꞌne mba̱a̱ a̱kui̱in jaꞌyoo aꞌkhúu̱n. <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />Jamí ikháanꞌxo̱ꞌ ndi̱ya̱áxo̱ꞌ rí niríga̱ rúꞌkhue̱n, mangaa máꞌ ndaꞌyoo Xu̱u̱ꞌ Ana̱ꞌlóꞌ. Jamí Ana̱ꞌlóꞌ naxniúu̱ Xu̱u̱ꞌ tsí nune̱-mbáníí rí naꞌthée̱n.<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />Ído̱ rí ikhii̱n ni̱dxawíi̱n ajngáa rúꞌkhue̱n, phú nijiꞌníi̱ jamí asndo nandúu̱n mu̱radíi̱n. <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />A̱ꞌkhue̱n ni̱tu̱xu̱u̱ꞌ ná majñu̱ú xa̱bo̱ buanuu ede̱ mbáa xa̱bo̱ fariséo̱ mbiꞌyuu Gamaliél, tsí phú na̱ma̱ñuu naꞌsngáá xtángoo, jamí phú nitiamakuíí ene̱ mbá xúgíin xa̱bo̱ xuajen. Ikhaa̱ nixná-ñájwii̱n rí ma̱ga̱jnúú mbégo rixa̱á tsí nixúngui̱inꞌ Jesús. <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />A̱ꞌkhue̱n niꞌthúu̱n a̱nguii̱n: «Xa̱bo̱ buanuu Israél, a̱gu̱ya̱á májánlaꞌ rí mu̱ne̱laꞌ ga̱jma̱á nindxu̱ún xa̱bo̱ tsíge̱ꞌ. <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />Numuu rí nákhí neꞌne máwáa nikujmaa Téu̱da̱s, jamí niꞌthée̱n rí mbáa xa̱bo̱ tsí gíꞌdoo numuu ñajuu̱n. Ikhaa tsúꞌkhue̱n ningrigu̱ún xó mbá akho̱ siénto̱ (400) wáa xa̱bo̱ ga̱jma̱á nindxu̱u̱. I̱ndo̱ó máꞌ numuu rí ikhaa̱ nijáñuu̱ nene̱ xa̱bo̱, a̱ꞌkhue̱n mbá xúgíin tsí nigóó tsu̱du̱u̱ ni̱drúꞌúún, jamí wámba̱ri̱gii̱n. <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />Nda̱wa̱á a̱ꞌkhue̱n, nikujmaa Júda̱s tsí ni̱ꞌkha̱ ná numbaa Galiléa̱, nákhí mbiꞌi rí na̱ta̱ꞌa̱a mbiꞌñúú xa̱bo̱ ná awúun i̱yi̱i̱ꞌ, jamí phú mbaꞌiin xa̱bo̱ xuajen ningrigu̱ún ga̱jma̱á nindxu̱u̱. Nijáñuu máꞌ tsíge̱ꞌ mangaa nene̱ xa̱bo̱, jamí mbá xúgíin tsí nigóó tsu̱du̱u̱ ni̱drúꞌúún.<verse eid="ACT 5:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 5:38" />»Ikhaa jngó na̱tha̱nꞌlaꞌ xúge̱ꞌ, gu̱ne̱-janíí-mijnálaꞌ ná inúú xa̱bo̱ tsíge̱ꞌ, jamí gu̱ni̱ꞌñúu̱laꞌ. Xí ju̱ma̱ rí juye̱e̱ o ñajun rí nuni̱i̱, drígu̱ún xa̱bo̱ numbaa ñajuun ne̱, ma̱mbá-ri̱ga̱a máꞌ ne̱. <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />Jamí xí drígo̱o̱ Ana̱ꞌlóꞌ ñajuun ne̱ rá, ma̱xáꞌnga̱ꞌlaꞌ gúne̱-gámba̱a ne̱. Ra̱ꞌkhá ma̱ꞌne rí juwa na̱tsa̱ña̱ꞌ gajmiálaꞌ Ana̱ꞌlóꞌ».<verse eid="ACT 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 5:40" />A̱ꞌkhue̱n mbá xúgíi̱n niguááꞌdáa̱ mbóó ikhaa máꞌ ju̱ma̱ gajmíi̱ Gamaliél. Ikhaa jngó ni̱ndxa̱ꞌwáa̱n tsí nixúngui̱inꞌ Jesús rí ma̱ta̱ꞌa̱án ná gatii̱n. Ído̱ wámbúu̱n ni̱xpa̱thúu̱n jamí nixna-ñajúu̱n rí náxúthee̱n ga̱jma̱á numuu Jesús, a̱ꞌkhue̱n ni̱ni̱ꞌñúu̱. <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />Jamí tsí nixúngui̱inꞌ Jesús phú gagi a̱kuíi̱n nigájnáa̱ ná inúú xa̱bo̱ buanuu ede̱, numuu rí ikhii̱n jaꞌñúu̱ rí mu̱míníi̱ ga̱jma̱á numuu Jesús. <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />Jamí mbá xúgíí mbiꞌi tsíni̱ñáa̱ rusngáa̱ jamí rí nuthan-raꞌee̱ ajngáa máján ga̱jma̱á numuu Jesukrísto̱ ná guꞌwá dxákuun xúꞌkhue̱n máꞌ ná guꞌwúu̱n.<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s">Naxtaꞌwíin mbá juwiin xa̱bo̱ tsí mu̱mbáyí-jmáá</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />Nákhí mbiꞌi rí ñúꞌún, na̱ka̱-raꞌne mbaꞌiin máꞌ xúꞌkhue̱n tsí nanimbu̱únꞌ juyáá Jesús, a̱ꞌkhue̱n tsí nuthan ajngáa griégo̱ ni̱gíꞌdíi̱n nithan-ri̱ge̱e̱ ga̱jma̱á numúú tsí nuthan ajngáa ebréo̱, rí go̱ꞌóxuáꞌa drígu̱ún tsí nuthan griégo̱ na̱nguá ijanúu̱ rí nawiꞌtháa mbámbá mbiꞌi. <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />A̱ꞌkhue̱n tsí mbá gu̱wa̱ꞌ i̱jmi̱i (12) ni̱ru̱wii̱n mbá xúgíin tsí nanimbu̱únꞌ juyáá Jesús, jamí nithúu̱n: «Na̱nguá máján rí ikháanꞌxo̱ꞌ mu̱ni̱ꞌñááxo̱ꞌ rí nu̱tha̱n-ráꞌaxo̱ꞌ ajngóo Ana̱ꞌlóꞌ, kajngó mu̱strámaxo̱ꞌ xúba̱. <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />Ikhaa jngó, a̱ngui̱nꞌ, gu̱raꞌwíinlaꞌ ikháanꞌlaꞌ ná majña̱ꞌlaꞌ mbá juwiin xa̱bekha tsí ndu̱ya̱álaꞌ rí máján kri̱ga̱ ajngáa ga̱jma̱á numúú, jamí xtáa Xu̱u̱ꞌ Ana̱ꞌlóꞌ ná awúun a̱kui̱ín, xúꞌkhue̱n máꞌ nafruꞌu̱ún rí máján, kajngó mu̱ꞌxnúu̱lóꞌ ñajun ríge̱ꞌ muni̱i̱. <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />Xómáꞌ ikháanꞌxo̱ꞌ mu̱xúni̱ꞌñááxo̱ꞌ rí mu̱tha̱n-jáñííxo̱ꞌ Ana̱ꞌlóꞌ jamí rí mu̱tha̱n-ráꞌaxo̱ꞌ ajngóo̱».<verse eid="ACT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5" />A̱ꞌkhue̱n mbá xúgíi̱n ni̱ni̱gúu̱n ju̱ma̱ rúꞌkhue̱n. A̱ꞌkhue̱n ni̱ríya̱a̱ꞌ Estéba̱n, tsí phú wéje̱ a̱kui̱in ná inuu Ana̱ꞌlóꞌ jamí xtáa Xu̱u̱ꞌ Ana̱ꞌlóꞌ ná awúun a̱kui̱in. Mangaa máꞌ ni̱raꞌwíi̱n Felípe̱, Próko̱ro̱, Nikanór, Timón, Parména̱s, jamí Nikolás tsí na̱ꞌkha̱ ná Antiokía̱ jamí neꞌne-mina̱aꞌ xa̱bo̱ judío̱. <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />Ikhiin tsúꞌkhue̱n ni̱xna̱xíi̱n ná inúú tsí nixúngui̱inꞌ Jesús, xómáꞌ ikhii̱n nithán-jáñíi̱ Ana̱ꞌlóꞌ ga̱jma̱á numúú tsúꞌkhue̱n, a̱ꞌkhue̱n ni̱xkra̱mii̱ꞌ.<verse eid="ACT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7" />A̱ꞌkhue̱n rí i̱tha̱án máꞌ ni̱ka̱-ra̱dróꞌoo ajngóo Ana̱ꞌlóꞌ, jamí i̱tha̱án máꞌ ni̱ka̱-raꞌne mbaꞌiin tsí nanimbu̱únꞌ juyáá Jesús ná Jerusalén. Jamí asndo dxakuun máꞌ mangiin nanimbu̱únꞌ juyáá gisngáá ga̱jma̱á numuu Jesús.<verse eid="ACT 6:7" /></para>
  <para style="s">Nu̱rtuwii̱n Estéba̱n</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />Xómáꞌ Estéba̱n, phú mba̱a̱ na̱gu̱ma-tsakun-rámaa̱ xúꞌkhue̱n máꞌ phú gíꞌdoo̱ ski̱yu̱u̱ꞌ Ana̱ꞌlóꞌ, jamí naꞌnii̱ rí phú wáá jamí rí phú namakúún xa̱bo̱ xuajen eꞌne. <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />A̱ꞌkhue̱n ni̱tu̱xu̱ún mbá tikhuun xa̱bo̱ tsí traꞌi̱in ná guꞌwá rí na̱gi̱mbíin xa̱bo̱ judío̱ rí jayá mbiꞌyuu Tsí Nijáwíin, ná na̱gi̱mbíin xa̱bo̱ judío̱ tsí naguwá ná Siréne̱, ná Alejandría̱, ná Silísia̱ jamí ná Ásia̱, ikhiin tsúꞌkhue̱n na̱tsa̱ñúu̱ gajmíi̱ Estéba̱n. <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />I̱ndo̱ó máꞌ numuu rí tsíꞌngúu̱n gúriꞌñáa̱ rí na̱ma̱ñuu̱ ni máꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ tsí naꞌthán ga̱jma̱á majñu̱u̱ ikhaa̱. <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />A̱ꞌkhue̱n nene̱-numúu̱ mbá tikhuun xa̱bo̱ kajngó muthan rí ni̱dxawíín rí Estéba̱n naꞌthán ajngáa xkawe̱ꞌ ga̱jma̱á numuu Moisés jamí ga̱jma̱á numuu Ana̱ꞌlóꞌ. <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />Xúꞌkhue̱n máꞌ nene̱-rájíi̱n xa̱bo̱ xuajen, xa̱bo̱ buanuu jamí xa̱bo̱ tsí nusngáá xtángoo rí mu̱xu̱xíi̱ a̱ꞌwá. A̱ꞌkhue̱n ni̱dráꞌii̱n ni̱rtuwii̱n Estéba̱n, jamí nigóo̱ juya̱a̱ ná inúú xa̱bo̱ buanuu ede̱. <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />Xúꞌkhue̱n máꞌ ni̱xna̱xíi̱n xa̱bo̱ tsí na̱ka̱ma̱xu̱ún ajngáa. Ikhiin tsúꞌkhue̱n nithan: «Xa̱bo̱ tsíge̱ꞌ tsíniñuu-raꞌthán ajngáa xkawe̱ꞌ ga̱jma̱á numuu guꞌwá dxákuun rí jaꞌwu ge̱jyoꞌ, xúꞌkhue̱n máꞌ ga̱jma̱á numuu xtángawoo Moisés. <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />Jamí ni̱dxawíínxo̱ꞌ rí naꞌthée̱n rí Jesús tsí na̱ꞌkha̱ Nasarét ma̱ꞌne-gámba̱a la guꞌwá dxákuun ríge̱ꞌ, xúꞌkhue̱n máꞌ mariꞌkhuu̱ rí nu̱ꞌne̱ jayalóꞌ, rí nixnálóꞌ Moisés mu̱ꞌne̱, méꞌ».<verse eid="ACT 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 6:15" />A̱ꞌkhue̱n mbá xúgíin xa̱bo̱ tsí trigi̱in ná gachúún xa̱bo̱ buanuu ede̱, ni̱ya̱xíi̱ Estéba̱n, jamí ndiyáa̱ rí xómá jaꞌnii inuu mbáa ánje̱l jaꞌnii inuu̱.<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s">Estéba̱n naꞌthán-ráꞌa ajngóo Ana̱ꞌlóꞌ ná inúú xa̱bo̱ buanuu ede̱</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />A̱ꞌkhue̱n tsí jayá idxu̱ún dxakuun niraxu̱u̱ Estéba̱n:</para>
  <para style="p" vid="ACT 7:1">―Á gakon rí nuthee̱n ga̱jma̱á numaaꞌ rá.<verse eid="ACT 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2" />Jamí ikhaa̱ niriꞌñee̱:</para>
  <para style="p" vid="ACT 7:2">―Xa̱bo̱ buanuu a̱ngui̱nꞌ jamí xa̱bo̱ buanuu ede̱, gu̱dxawíínlaꞌ rí ma̱tha̱nꞌlaꞌ: Ana̱ꞌlóꞌ tsí xtáa ná nambiꞌi-taꞌa agu nikujmaa ná inuu táta̱-xi̱ꞌñálóꞌ Abraám, nákhí xtáa̱ ná Mesopotámia̱, jamí xóó máꞌ táꞌgee̱ ma̱xtáa̱ ná Arán. <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />Jamí waꞌtháa̱n neꞌne Ana̱ꞌlóꞌ: “Atatsíñáá mbayaaꞌ jamí a̱ngia̱anꞌ, jamí ayu ná mbaa rí ma̱snga̱jmáaꞌlo̱ꞌ ikhúúnꞌ”. <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />A̱ꞌkhue̱n nigájnuu̱ ná mbañúú xa̱bo̱ kaldéa̱ jamí ni̱ke̱e̱ gáxtáa̱ ná Arán. Ikhín nijáñuu tátée̱, a̱ꞌkhue̱n Ana̱ꞌlóꞌ ni̱ꞌkha̱ jayáa̱ ná mbaa ríge̱ꞌ, ná juwa ikháanꞌlaꞌ xúge̱ꞌ.<verse eid="ACT 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 7:5" />»Jamí táxnúu̱ nitháan ju̱ba̱ꞌ ríge̱ꞌ ma̱ꞌne mbayuu̱, ni máꞌ asndo ná matsijii̱ nakhúu̱. I̱ndo̱ó máꞌ numuu rí nixuda-mine̱e̱ꞌ rí maxnúu̱ ne̱ ma̱ꞌne mbayuu̱ ikhaa̱, jamí xa̱bo̱ ri̱jyu̱u̱ꞌ tsí ma̱gu̱mii nda̱wa̱á, maske máꞌ xóó ndawa̱a̱ a̱dée̱ mbiꞌi rúꞌkhue̱n. <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />Xáꞌnii waꞌtháa̱n neꞌne Ana̱ꞌlóꞌ: “Tsí xa̱bo̱ ri̱jya̱a̱ꞌ ma̱nindxu̱ún xa̱bo̱ tsí ma̱ju̱wá ná ra̱ꞌkháa xuajñúú, jamí ma̱nindxúu̱n yumbáá waꞌtsi̱in tsí na̱gu̱ma-ski̱ñu̱ú mu̱ñajun, xúꞌkhue̱n máꞌ ma̱gu̱ma-ngíníi̱ mi̱ndaꞌkho mbá akho̱ siénto̱ (400) tsigu”. <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />Jamí niꞌthán xóó Ana̱ꞌlóꞌ: “Xómáꞌ ikhúúnꞌ ma̱xu̱ꞌdáa awan ga̱jma̱á numúú xa̱bo̱ xuajen ná ma̱nindxúu̱n yumbáá, nda̱wa̱á a̱ꞌkhue̱n ikhii̱n ma̱ga̱jnáa̱ ikhín jamí ma̱guwáa̱n ná mbaa ríge̱ꞌ mune̱-mbúu̱n”. <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />A̱ꞌkhue̱n Ana̱ꞌlóꞌ neꞌne mbá awan ga̱jma̱á nindxu̱u̱ Abraám, rí xa̱bo̱ ri̱jyu̱u̱ꞌ mbuya̱ tsina jndi. Ikhaa jngó ído̱ ni̱gu̱maa a̱dée̱ Isaák, nixnúu̱ tsina jndi ído̱ nirámuu migiñu mbiꞌi rí ni̱gu̱maa̱. Ikhaa máꞌ neꞌne Isaák ga̱jma̱á Jakób, jamí ikhaa máꞌ neꞌne Jakób gajmíí i̱ji̱in, tsí mbá gu̱wa̱ꞌ i̱jmi̱i (12) táta̱-xi̱ꞌñú-egúún xa̱bo̱ Israél.<verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />»Táta̱ xi̱ꞌñálóꞌ tsí ñajúún i̱ji̱in Jakób, ni̱ngu̱jwa̱a̱ dxíñúu̱ José ga̱jma̱á numuu rí naxígúu̱n juyáa̱, jamí ni̱ka̱ jiꞌyáa̱ ná Ejípto̱. I̱ndo̱ó máꞌ numuu rí Ana̱ꞌlóꞌ xtáa ga̱jma̱á nindxu̱u̱, <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />jamí neꞌne-jríya̱a̱ꞌ inuu mbá xúgíí rí namínu̱u̱ꞌ, xúꞌkhue̱n máꞌ niꞌnii̱ rí Faraón, tsí ñajuun thúngaa ná Ejípto̱, ma̱ni̱gu̱u̱ꞌ jaꞌyoo̱ jamí ma̱nindxu̱u̱ xa̱bo̱ tsí na̱ma̱ñuu ná inuu̱. Ikhaa máꞌ Faraón niꞌgíi José rí ma̱nindxu̱u̱ xa̱bo̱ ñajun tsí maꞌthán-ñájuun mbá xúgíí Ejípto̱ jamí mbá xúgíí guꞌwóo̱.<verse eid="ACT 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 7:11" />»A̱ꞌkhue̱n phú gakhe̱ niríga̱ ewi ná mbá xúgíí mbayuu Ejípto̱ xúꞌkhue̱n máꞌ ná numbaa Kanaán, jamí phú gakhe̱ ni̱míni̱í xa̱bo̱. Xómáꞌ táta̱-xi̱ꞌñálóꞌ wajyúú na̱nguá guáꞌdáa̱ rí mu̱phi̱i̱. <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />Ído̱ Jakób nidxawuun rí ríga̱ ixí iña ná Ejípto̱, nixuꞌmii̱ táta̱-xi̱ꞌñálóꞌ ikhín rí timbá miꞌtsú. <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />Jamí ído̱ nigóo̱ rí riajma̱ nothon rá, José niniña-mine̱e̱ꞌ rí ma̱gu̱ma-nuwii̱n gúne̱ dxíyo̱o̱, a̱ꞌkhue̱n Faraón ndiꞌyoo náá xa̱bo̱ ñajuun José. <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />A̱ꞌkhue̱n José nixuꞌma ajngáa rí ma̱ꞌkha̱ jiꞌyáa tátée̱ gajmíí mbá xúgíin a̱nguii̱n, tsí mbá atsú skíñú gu̱wa̱ꞌ nítsiin (75) rí mbá xúgíin. <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />Xkuaꞌnii neꞌne rí ni̱ga̱taa Jakób ná Ejípto̱, jamí ikhín máꞌ nijáñuu̱, xúꞌkhue̱n máꞌ mangiin mbá xúgíin táta̱-xi̱ꞌñálóꞌ wajyúú. <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />Ikhiin tsúꞌkhue̱n ni̱ꞌkha̱ jiꞌdi̱in ná Sikém, jamí waꞌduu̱n ná iñá-wajen rí neꞌtse̱ Abraám ga̱jma̱á mbúkha̱a̱ ná inúú i̱ji̱in táta̱ Jamór ná Sikém.<verse eid="ACT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />»Ído̱ nangiyuu máꞌ mbiꞌi rí ma̱mba̱núu awan rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxu̱u̱ Abraám, a̱ꞌkhue̱n ni̱ka̱-ra̱mi̱diu̱ún xa̱bo̱ xuajñalóꞌ xúꞌkhue̱n máꞌ neꞌne mbaꞌii̱n mi̱ndaꞌkho ná Ejípto̱, <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />xkuaꞌnii asndo ni̱ga̱nú mbiꞌi rí ni̱ge̱ꞌe̱ i̱mba̱a̱ꞌ thúngaa ná Ejípto̱ tsí táꞌne-nuwiin José. <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />Thúngaa tsíge̱ꞌ, phú ni̱ma̱ñuu̱ rí ma̱ꞌne-nduwii̱n xa̱bo̱ xuajñalóꞌ, jamí niꞌnii̱ rí mu̱míni̱í táta̱-xi̱ꞌñálóꞌ. Neꞌne-ski̱ñúu̱ rí mu̱ni̱ꞌñúu̱ ma̱ja̱ñúú i̱jíi̱n tsí jñáma tsí ni̱kú ni̱gu̱mii, kajngó náxáꞌne mbaꞌii̱n. <verse eid="ACT 7:19" /><verse number="20" style="v" sid="ACT 7:20" />Ikhín máꞌ mbiꞌi rí ñúꞌún ni̱gu̱maa Moisés, tsí phú ni̱ni̱gu̱u̱ꞌ Ana̱ꞌlóꞌ jaꞌyoo, jamí ni̱gu̱ma-mbaja̱a̱ mbá atsúun go̱nꞌ neꞌne tátée̱ ga̱jma̱á nánée̱. <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />Ído̱ ni̱ni̱ꞌñáa̱ rí ma̱ja̱ñúu̱, a̱ꞌkhue̱n a̱dée Faraón tsí dxáꞌgú ndiyáa̱ jamí neꞌne-mbaja̱a̱ xómá a̱dée̱. <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />A̱ꞌkhue̱n waꞌsngáá Moisés mbá xúgíí rí máján rí na̱ma̱ñúú xa̱bo̱ Ejípto̱, xúꞌkhue̱n máꞌ phú ni̱gi̱ꞌdoo numuu ajngáa rí naꞌthée̱n, jamí rí naꞌnii̱.<verse eid="ACT 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23" />»Ído̱ nirámuu a̱jma̱ skíñú (40) tsiguu̱, a̱ꞌkhue̱n neꞌne a̱kuii̱n rí ma̱ꞌgee̱ gáꞌñúu̱ a̱nguii̱n, tsí ñajúún xa̱bo̱ Israél. <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />Jamí ído̱ ndiꞌyoo̱ rí na̱gu̱ma-ngínáa mbáa xa̱bo̱ Israél eꞌne mbáa xa̱bo̱ Ejípto̱, a̱ꞌkhue̱n ni̱ke̱e̱ gámbáyúu̱ tsí na̱gu̱ma-ngínáa. Nixnúu̱ asndo nixíya̱a̱ xa̱bo̱ Ejípto̱, kajngó ma̱ꞌne-numa̱a rí neꞌne. <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />I̱ndo̱ó máꞌ numuu rí Moisés ni̱ju̱mu̱u̱ rí a̱nguii̱n ma̱fruꞌu̱ún rí Ana̱ꞌlóꞌ ma̱ꞌne-jáwíi̱n ga̱jma̱á majñu̱u̱ ikhaa̱. Xómáꞌ ikhii̱n táfruꞌúu̱n rí xkuaꞌnii jaꞌnii. <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />Jamí i̱mba̱ mbiꞌi, Moisés nixkamii a̱jmi̱i xa̱bo̱ Israél tsí na̱tsa̱ñu̱ú, a̱ꞌkhue̱n ndiyoo̱ gáxprígúu̱n jamí niꞌthúu̱n: “Xa̱bo̱ buanuu, mbóó ikhaa máꞌ iꞌdi ñajwanlaꞌ ikháanꞌlaꞌ. Náá numuu kajngó nu̱ne̱-ñawún-mijnálaꞌ róꞌ”. <verse eid="ACT 7:26" /><verse number="27" style="v" sid="ACT 7:27" />A̱ꞌkhue̱n tsí naꞌne-ngínáa dxájuu nirmajngua̱a̱ꞌ Moisés, jamí niꞌthúu̱n: “Tsáa niꞌgíín rí ma̱nindxa̱a̱ꞌ xa̱bo̱ ñajun jamí xa̱bo̱ tsí maxúdaa awan ga̱jma̱á numaxo̱ꞌ róꞌ. <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />Á nandaaꞌ gáta̱xíñu̱ú mangúúnꞌ xómá rí nitaxíya̱a̱ xa̱bo̱ Ejípto̱ ri̱xi̱í dxe̱ꞌ”. <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />Ído̱ nidxawuun Moisés ajngáa rúꞌkhue̱n, a̱ꞌkhue̱n nigáyuu̱ jamí ni̱ke̱e̱ gáxtáa̱ ná numbaa Madián. Ikhín nixtáa̱ xómá xa̱bo̱ tsí na̱ꞌkha̱ i̱mba̱ xuajen, jamí ni̱gu̱mii a̱jmi̱i i̱jii̱n.<verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />»Ído̱ ninújngoo a̱jma̱ skíñú (40) tsigu, nikujmaa mbáa ánje̱l inuu̱ ná majñu̱u̱ ri̱ꞌyu̱u̱ aguu mbá iná tsuwan rí nakha, ná mbaa niníí drígo̱o̱ júba̱ Sinaí. <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />A̱ꞌkhue̱n Moisés niyaxu̱u̱ ne̱, jamí phú nimakuu̱ neꞌne rí ndiꞌyoo̱ inu-mbiꞌíí. Jamí ído̱ nixuꞌma-mine̱e̱ꞌ kajngó mayaxu̱u̱ mújúu̱n ne̱, a̱ꞌkhue̱n nidxawuu̱n a̱ꞌwóo Táta̱ Mikhuíí rí niꞌthán: <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />“Ikhúúnꞌ ñajunꞌ Anu̱ú táta̱-xi̱ꞌñáaꞌ wajyúú, Anu̱u̱ Abraám, Anu̱u̱ Isaák jamí Jakób”. A̱ꞌkhue̱n Moisés ni̱gi̱ꞌdu̱u̱n niguaꞌaa̱n rí namíñuu̱, jamí tsíꞌngo̱o̱ a̱kuii̱n gáyaxi̱i̱.<verse eid="ACT 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 7:33" />»Jamí waꞌtháa̱n neꞌne Táta̱ Mikhuíí: “Arawíi chádaaꞌ, numuu rí mbaa ná xtiajún a̱ꞌkhue̱n, ikhúúnꞌ jaꞌyoꞌ ne̱. <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />Nda̱yo̱o̱ mújúnꞌ máꞌ rí nu̱míni̱í xa̱bo̱ xuajñuꞌ tsí júwa̱ꞌ ná Ejípto̱, jamí ni̱dxawuun máꞌ rí nu̱ndxa̱ꞌwa̱-kháa̱n. Ikhaa jngó nigátáa rí ma̱ne̱-jáwíi̱nlo̱ꞌ. Rí xúge̱ꞌ rá, aya̱, ma̱xu̱ꞌmáá mi̱dxo̱ꞌ ná Ejípto̱”.<verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />»Ikhaa máꞌ Moisés tsíge̱ꞌ ñajuun tsí ra̱khúu̱n gúyáa̱ jamí nitháa̱n: “Tsáa niꞌgíín rí ma̱nindxa̱a̱ꞌ xa̱bo̱ ñajun jamí xa̱bo̱ tsí maxúdaa awan róꞌ”. Ikhaa máꞌ tsíge̱ꞌ ñajuun tsí nixuꞌmaa Ana̱ꞌlóꞌ rí ma̱nindxu̱u̱ xa̱bo̱ ñajun jamí tsí ma̱ꞌne-jáwíin xa̱bo̱ xuajñuu ga̱jma̱á ski̱yu̱u̱ꞌ ánje̱l tsí nikujmaa inuu̱ ná iná tsuwan. <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />Moisés ñajuun tsí ni̱gu̱wíin táta̱-xi̱ꞌñálóꞌ ná Ejípto̱, ído̱ wámbo̱o̱ niꞌnii̱ rí phú wáá jamí rí phú nimakúún xa̱bo̱ eꞌne ná mbayuu Ejípto̱. Xúꞌkhue̱n máꞌ niꞌnii̱ ná Iya A̱pha̱ Maña̱ꞌ, jamí ná mbaa niníí a̱jma̱ skíñú (40) tsigu. <verse eid="ACT 7:36" /><verse number="37" style="v" sid="ACT 7:37" />Ikhaa máꞌ Moisés tsíge̱ꞌ ñajuun tsí niꞌthúún xa̱bo̱ Israél: “Táta̱ Ana̱ꞌlaꞌ Mikhuíí maríya̱a̱ꞌ ná majñu̱ú a̱ngia̱nꞌlaꞌ mbáa xa̱bo̱ tsí ma̱gu̱wíjnga̱a ajngóo̱, xómá rí ikhúúnꞌ. Ikhaa̱ gúdxawíínlaꞌ rí maꞌthánlaꞌ”.<note caller="+" style="f"><char style="fr" closed="false">7.37 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «Ikhaa̱ gúdxawíínlaꞌ rí maꞌthánlaꞌ».</char></note> <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />Ikhaa máꞌ Moisés tsíge̱ꞌ ñajuun tsí nixtáa ná niwi̱in táta̱-xi̱ꞌñálóꞌ ná mbaa niníí, ga̱jma̱á ánje̱l tsí naꞌthúu̱n ná júba̱ Sinaí. Ikhaa̱ ni̱grui̱guíi̱ ajngáa rí naꞌne rí ma̱ju̱wá xa̱bo̱ kajngó maꞌthánlóꞌ ne̱.<verse eid="ACT 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39" />»Xómáꞌ táta̱-xi̱ꞌñálóꞌ túdri̱guíi̱ ne̱ jamí ra̱khúu̱n gánimbúu̱n juyáa̱. A̱ꞌkhue̱n gakon, ikhii̱n naꞌne a̱kuíi̱n rí ma̱thangii̱n ná Ejípto̱, <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />ído̱ nitháa̱n Aarón: “Athani̱i ‘ana̱ꞌlóꞌ’ tsí mbuya̱ ikhalóꞌ. Numuu rí Moisés tsúꞌkhue̱n, tsí ni̱gu̱wiáanꞌlóꞌ ná mbaa Ejípto̱, tsíꞌyáálóꞌ dí nigíꞌnuu̱”. <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />A̱ꞌkhue̱n nini̱i̱ xtiꞌkhuu mbáa a̱ꞌdá-xédé, jamí ni̱xna̱xíi̱n xu̱kú tsí nijáñúú ná inuu tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajuun, xúꞌkhue̱n máꞌ nijúwe̱e̱ꞌ gagi ga̱jma̱á numuu rí nene̱-ku̱maa̱ ga̱jma̱á ñawúu̱n. <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />A̱ꞌkhue̱n Ana̱ꞌlóꞌ neꞌne-níjníí-mina̱ꞌ ná inúu̱, jamí niniñúu̱ rí mu̱ne̱-mba̱a̱ rí ríga̱ ná mikhu. Xómá ka̱ma naꞌthán ná i̱ñu̱ú xa̱bo̱ tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ wajyúú:</para>
  <para style="q" vid="ACT 7:42">“Xa̱bi̱i Israél, á ikhúúnꞌ ni̱xna̱xúꞌlaꞌ xu̱kú tsí nijáñúú jamí tsi̱gi̱jña̱ꞌ,</para>
  <para style="q" vid="ACT 7:42">ná mbaa niníí awúun rí a̱jma̱ skíñú (40) tsigu dxe̱ꞌ.<verse eid="ACT 7:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="ACT 7:43" />A̱ꞌkhue̱n gakon, nikua ju̱ya̱ꞌlaꞌ guꞌwá dxákuun xtíin drígo̱o̱ Molók,</para>
  <para style="q" vid="ACT 7:43">jamí a̱ꞌgua̱án drígo̱o̱ ana̱ꞌlaꞌ Refán,</para>
  <para style="q" vid="ACT 7:43">xtiꞌkhu rí ne̱ne̱ májánlaꞌ rí mu̱ne̱-mba̱a̱laꞌ.</para>
  <para style="q" vid="ACT 7:43">Ikhaa jngó, ma̱xkriñáaꞌlaꞌ ná xuajñalaꞌ,</para>
  <para style="q" vid="ACT 7:43">ma̱xu̱ꞌmáaꞌlaꞌ mu̱ꞌgua i̱tha̱án tsíngua̱ꞌ rí ná ꞌgí Babilónia̱”.<note caller="+" style="f"><char style="fr" closed="false">7.42-43 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Amós 5.25-27.</char></note><verse eid="ACT 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />»Ná mbaa niníí niguáꞌdáá táta̱-xi̱ꞌñálóꞌ guꞌwá dxákuun xtíin rí nasngájma rí xtáa Ana̱ꞌlóꞌ, xómá nixná-ñájun Ana̱ꞌlóꞌ nákhí niꞌthúu̱n Moisés rí ma̱ꞌnii̱ ne̱ xómá jaꞌnii xkri̱doo rí ndiꞌyoo̱. <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />Ikhaa máꞌ guꞌwá-xtíin rúꞌkhue̱n, ído̱ rí táta̱-xi̱ꞌñálóꞌ ni̱dri̱guíi̱ ne̱, niguwá juñúu̱ ne̱ ge̱jyoꞌ gajmíi̱ Josué ído̱ ni̱tu̱ꞌúu̱n mu̱dríguíi̱ mbañúú xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, tsí nixkawíin Ana̱ꞌlóꞌ ná inúú táta̱-xi̱ꞌñálóꞌ. Jamí niríga̱ guꞌwá-xtíin asndo mbiꞌi rí nixtáa Dabíd.<verse eid="ACT 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="ACT 7:46" />»Ana̱ꞌlóꞌ phú ni̱ni̱gu̱u̱ꞌ jaꞌyoo̱ Dabíd, ikhaa jngó ni̱nda̱ꞌe̱e̱ rí ikhaa̱ ma̱ꞌnii̱ guꞌwá ná ma̱xtáa Táta̱ Mikhuíí, Anu̱u̱ Jakób tsí naꞌne-mba̱a̱. <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />I̱ndo̱ó máꞌ numuu rí Salomón ñajuun tsí neꞌne guꞌwóo Ana̱ꞌlóꞌ, <verse eid="ACT 7:47" /><verse number="48" style="v" sid="ACT 7:48" />maske máꞌ Ana̱ꞌlóꞌ Mikhuíí na̱nguá xtáa̱ ná awúun guꞌwá rí nune̱ mújúún xa̱bo̱ ga̱jma̱á ñawúún, xómá niꞌthán xa̱bo̱ tsí ni̱gu̱wíjnga̱a ajngóo Ana̱ꞌlóꞌ wajyúú:<verse eid="ACT 7:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="ACT 7:49" />“Mikhu ñajuun ná ꞌgúnꞌ na̱tha̱n-ñájunlo̱ꞌ,</para>
  <para style="q" vid="ACT 7:49">jamí tsu̱du̱u̱ ju̱ba̱ꞌ ñajuun ná tráma nakhúꞌ.</para>
  <para style="q" vid="ACT 7:49">Dí guꞌwáa mu̱ne̱laꞌ ná ma̱gúda̱ꞌlo̱ꞌ rá, ―iꞌthán Táta̱―.</para>
  <para style="q" vid="ACT 7:49">Náá ꞌgí xi̱yoo ná mba̱ya̱a xu̱ꞌ rá.<verse eid="ACT 7:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="ACT 7:50" />Á ra̱ꞌkhá ikhúúnꞌ ne̱ne̱-ku̱maa mbá xúgíí rúꞌkhue̱n ga̱jma̱á ñawúnꞌ dxe̱ꞌ”.<note caller="+" style="f"><char style="fr" closed="false">7.49-50 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 66.1-2.</char></note><verse eid="ACT 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />»¡Maphú najñaguáanꞌlaꞌ, gúkú a̱kia̱nꞌlaꞌ jamí tsíyalaꞌ gúdxawíínlaꞌ rí nithánlaꞌ! Ikháanꞌlaꞌ jámba̱ miꞌtsú nawajún-ꞌthi̱ínlaꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ. Xómá nene̱ táta̱-xi̱ꞌñálaꞌ wajyúú, xkuaꞌnii máꞌ e̱ne̱ mangáanꞌlaꞌ. <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />Tsáa lá tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ tsí túxkáá táta̱-xi̱ꞌñálaꞌ rá. Jamí ni̱ra̱díi̱n tsí wapha nithan rí ma̱ꞌkha̱ tsí phú májáan, ikhaa máꞌ tsí ikháanꞌlaꞌ ni̱xna̱xíi̱laꞌ xúꞌkhue̱n máꞌ ni̱xíya̱a̱laꞌ. <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />Ikháanꞌlaꞌ tsáanꞌ ni̱drígúlaꞌ xtángawoo Ana̱ꞌlóꞌ ga̱jma̱á majñu̱ú ánje̱l, tsíne̱-mbáníílaꞌ ne̱.<verse eid="ACT 7:53" /></para>
  <para style="s">Nu̱xíya̱a̱ Estéba̱n</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />Ído̱ ni̱dxawíi̱n ajngáa rúꞌkhue̱n, nijiꞌníi̱ mi̱ndaꞌkho, asndo naꞌpho̱-ꞌduu̱n iñúu̱ ga̱jma̱á numuu Estéba̱n. <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />I̱ndo̱ó máꞌ numuu rí Estéba̱n xtáa Xu̱u̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxu̱u̱, niyaxi̱i̱ mikhuíí, a̱ꞌkhue̱n ndiꞌyoo̱ rí nambiꞌi-taꞌaa Ana̱ꞌlóꞌ, jamí ndiꞌyoo̱ rí Jesús wéje̱ ná ñawún mújúun Ana̱ꞌlóꞌ. <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />A̱ꞌkhue̱n niꞌthée̱n: «Gu̱dxawíínlaꞌ, ja̱ma̱ꞌtha mikhu i̱yo̱o̱lo̱ꞌ, jamí nda̱yo̱o̱lo̱ꞌ rí A̱dée Xa̱bo̱ Numbaa wíji̱i̱ ná ñawún mújúun Ana̱ꞌlóꞌ».<verse eid="ACT 7:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57" />A̱ꞌkhue̱n ikhii̱n ni̱ndxa̱ꞌwe̱e̱ gakhe̱, ni̱ruguáa̱ ñaꞌwúu̱n, jamí mbá xúgíi̱n ni̱dráꞌii̱n rí mu̱rmajngua̱a̱ꞌ Estéba̱n. <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />A̱ꞌkhue̱n ni̱ríya̱a̱ꞌ ná rawuun xuajen, nixnáa̱ ga̱jma̱á itsí. Xómáꞌ xa̱bo̱ tsí ni̱ka̱ma̱xu̱ún ajngáa ga̱jma̱á numuu Estéba̱n ni̱strige̱e̱ xtíñúu̱ ná nakhúu mbáa dxáma tsí mbiꞌyuu Sáu̱lo̱.<verse eid="ACT 7:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="ACT 7:59" />Jamí awúun máꞌ rí ikhii̱n nuxnáa̱ ga̱jma̱á itsí, Estéba̱n niꞌthán-jáñuu Jesús xáꞌnii: «Táta̱ Jesús, a̱tri̱gúu la ními̱ꞌ». <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />A̱ꞌkhue̱n nismáti̱go̱o̱, jamí phú gakhe̱ niꞌthée̱n: «Táta̱, athane̱ mba̱a̱ a̱kia̱anꞌ xtañúu̱ ga̱jma̱á numuu aꞌkhán ríge̱ꞌ». Jamí ído̱ wámbo̱o̱ niꞌthée̱n ajngáa rúꞌkhue̱n, a̱ꞌkhue̱n nijáñuu̱.<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="s">Sáu̱lo̱ naꞌne-ngíníi tsí nanimbu̱únꞌ juyáá Jesús</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />Sáu̱lo̱ ndiꞌyoo xáne nu̱xíya̱a̱ Estéba̱n, jamí máján máꞌ nene̱ xa̱bo̱ iꞌyoo̱. Asndo nákhí máꞌ mbiꞌi rúꞌkhue̱n phú gakhe̱ ni̱gi̱ꞌdu̱u̱n ni̱gu̱ma-ngíníi tsí nanimbu̱únꞌ juyáá Jesús ná Jerusalén. Jamí mbá xúgíi̱n ni̱drúꞌúu̱n ná mbayuu Judéa̱ ga̱jma̱á Samária̱, i̱ndo̱ó máꞌ tsí nixúngui̱inꞌ Jesús tágájnúú. <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />Mbá tikhuun xa̱bo̱ tsí májáan a̱kui̱ín nigóó gúdi̱i Estéba̱n, jamí phú ni̱mbi̱ye̱e̱ꞌ ga̱jma̱á numuu̱. <verse eid="ACT 8:2" /><verse number="3" style="v" sid="ACT 8:3" />Xómáꞌ Sáu̱lo̱ naꞌne-ngíníi̱ mi̱ndaꞌkho tsí nanimbu̱únꞌ juyáá Jesús, jamí na̱to̱ꞌo̱o̱ mbámbá guꞌwá kajngó ma̱gu̱wíi̱n ga̱jma̱á tsiakhe̱ xa̱bekha jamí go̱ꞌo̱, xúꞌkhue̱n máꞌ naxudii̱n ná géjwa̱nꞌ.<verse eid="ACT 8:3" /></para>
  <para style="s">Nithán-raꞌa ajngáa máján ná numbaa Samária̱</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />Xómáꞌ tsí ni̱drúꞌúún, nuthan-raꞌee̱ ajngáa máján asndo náá máꞌ nagóo̱. <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />A̱ꞌkhue̱n Felípe̱, ni̱ga̱taa̱ ni̱ke̱e̱ ná xuajen Samária̱, jamí ikhín naꞌthán-rúꞌúu̱n xa̱bo̱ ga̱jma̱á numuu Krísto̱. <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />Mbá xúgíin xa̱bo̱ tsí nawi̱in nu̱ꞌgíi̱ ñaꞌwúu̱n kajngó mu̱dxawíi̱n ajngáa rí naꞌthán Felípe̱. Nu̱dxawíi̱n jamí nduyáa̱ rí phú wáá rí naꞌnii̱. <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />Numuu rí phú mbaꞌiin xa̱bo̱ tsí guáꞌdiin gíñá ꞌguéen, ído̱ nagájnáa̱ phú gakhe̱ nu̱ndxa̱ꞌwe̱e̱. Jamí phú mbaꞌiin xa̱bo̱ tsí nixtrigi̱in xúꞌkhue̱n máꞌ tsí réngu̱un naꞌni̱i a̱kui̱ín. <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />Ikhaa jngó phú gagi neꞌne a̱kui̱ín xa̱bo̱ tsí júwa̱ꞌ ná xuajen rúꞌkhue̱n.<verse eid="ACT 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />I̱ndo̱ó máꞌ numuu rí xtáa mbáa xa̱bo̱ tsí mbiꞌyuu Simón ná xuajen rúꞌkhue̱n, tsí nákhí ginii naꞌne xawan, jamí neꞌne-nduwiin xa̱bo̱ Samária̱, numuu rí naꞌne-mine̱e̱ꞌ mbáa xa̱bo̱ tsí gíꞌdoo numuu. <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />Mbá xúgíin xa̱bo̱ nuꞌgí idxu̱ún rí naꞌthán xa̱bo̱ tsúꞌkhue̱n, asndo tsí ngínáa jamí asndo tsí phú gíꞌdoo numuu, jamí nuthee̱n: «Xa̱bo̱ tsíge̱ꞌ ñajuun tsí nutháa̱n “ski̱yu̱u̱ꞌ Ana̱ꞌlóꞌ rí phú mba̱a̱”».<verse eid="ACT 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 8:11" />Jamí phú namakúu̱n nu̱dxawíi̱n rí naꞌthán, numuu rí wajyúú máꞌ naꞌne-nduwii̱n ga̱jma̱á xawan rí naꞌnii̱. <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />I̱ndo̱ó máꞌ numuu rí ído̱ ninimbúu̱n juyáa̱ Felípe̱, tsí naꞌthán-ráꞌa ajngáa máján rí naꞌthán rí Ana̱ꞌlóꞌ naꞌthán-ñájúún xa̱bo̱, jamí ga̱jma̱á numuu Jesukrísto̱, a̱ꞌkhue̱n waxúꞌdu-maꞌíi̱n ná awúun iya, xa̱bekha jamí go̱ꞌo̱. <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />Asndo jmína̱a̱ꞌ máꞌ Simón mangaa ninimbo̱o̱ꞌ, jamí waxúꞌdu-maꞌáa̱n ná awúun iya, a̱ꞌkhue̱n nigíꞌdu̱u̱n ningrigo̱o̱ꞌ jayu ga̱jmáa̱ Felípe̱. Jamí ído̱ ndaꞌyoo̱ rí phú wáá rí naꞌne Felípe̱, phú namakuu̱.<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />Ído̱ tsí nixúngui̱inꞌ Jesús, tsí júwa̱ꞌ ná Jerusalén, ni̱dxawíín rí xa̱bo̱ Samária̱ ni̱dri̱gú ajngóo Ana̱ꞌlóꞌ, a̱ꞌkhue̱n ni̱xu̱ꞌmii̱ magóó ikhín Pédro̱ ga̱jma̱á Juáán. <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />Ído̱ niguáꞌníi̱ ikhín, a̱ꞌkhue̱n nithán-jáñíi̱ Ana̱ꞌlóꞌ ga̱jma̱á numúú xa̱bo̱ tsúꞌkhue̱n, kajngó mu̱dri̱guíi̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ. <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />Numuu rí nimbáa tsí ikhii̱n xóó túdri̱guíi̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ, rí i̱ndo̱ó máꞌ waxúꞌdu-maꞌíi̱n ná awúun iya ga̱jma̱á mbiꞌyuu Jesús. <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />A̱ꞌkhue̱n nu̱xkra̱mii̱ꞌ, jamí nu̱dri̱guíi̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ.<verse eid="ACT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18" />Ído̱ ndiꞌyoo Simón rí ni̱tri̱guíi Xu̱u̱ꞌ Ana̱ꞌlóꞌ ído̱ rí Pédro̱ ga̱jma̱á Juáán nu̱xkrámii̱ xa̱bo̱, a̱ꞌkhue̱n ndiyoo̱ maxnúu̱ mbúkha̱a̱ tsí nixúngui̱inꞌ Jesús, <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />jamí niꞌthúu̱n:</para>
  <para style="p" vid="ACT 8:19">―Gu̱xnu̱ꞌlaꞌ mangúúnꞌ tsiakhe̱ rúꞌkhue̱n, kajngó asndo tsáa máꞌ tsí ikhúúnꞌ ma̱xkrámaa ma̱grui̱guíi̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ.<verse eid="ACT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20" />A̱ꞌkhue̱n Pédro̱ niꞌthúu̱n:</para>
  <para style="p" vid="ACT 8:20">―Ga̱ja̱ñáaꞌ ga̱jma̱a̱ꞌ mbúkha̱a̱ꞌ, numuu rí ni̱ju̱ma̱a̱ꞌ rí ga̱jma̱á mbúkha̱a̱ ma̱goo ma̱ra̱tse̱ rí naxná Ana̱ꞌlóꞌ. <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />Na̱nguá jaꞌyaaꞌ ikháánꞌ ma̱tha̱ne̱ ñajun ríge̱ꞌ, numuu rí na̱nguá jañii a̱kia̱anꞌ ná inuu Ana̱ꞌlóꞌ. <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />Ga̱thanga̱a a̱kia̱anꞌ ná inuu Ana̱ꞌlóꞌ ga̱jma̱á numuu aꞌkhán ríge̱ꞌ, jamí arathán-jáñíí Ana̱ꞌlóꞌ, á gáꞌne xí ma̱ꞌne mba̱a̱ a̱kuii̱n jaꞌyaa̱ꞌ ga̱jma̱á numuu rí nitatsaꞌwá-mina̱ꞌ xkuaꞌnii. <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />Numuu rí nda̱yo̱o̱ rí ninújngoo ríga̱ tsixígu̱ꞌ ná awúun a̱kia̱anꞌ, jamí tsíyoo gáta̱tsi̱ꞌñáá rí nathane̱ aꞌkhán.<verse eid="ACT 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24" />A̱ꞌkhue̱n niriꞌña Simón:</para>
  <para style="p" vid="ACT 8:24">―Gu̱tha̱n-jáñíí ikháanꞌlaꞌ Táta̱ ga̱jma̱á numuꞌ, kajngó ma̱xáꞌkha̱ ná inuꞌ nimbá rí nu̱thu̱nꞌlaꞌ rí ma̱gíꞌnuꞌ.<verse eid="ACT 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25" />Ído̱ rí Pédro̱ ga̱jma̱á Juáán wámbúu̱n nithee̱n rí nduyáa̱ ga̱jma̱á numuu Jesús jamí nithee̱n ajngóo Ana̱ꞌlóꞌ, a̱ꞌkhue̱n nithangii̱n ná Jerusalén. Awúun máꞌ rí nagúu̱n, nigóo̱-ranújngáa̱n mbaꞌa xuajen rí triga̱ ná numbaa Samária̱, jamí nithán-rúꞌúu̱n xa̱bo̱ ajngáa máján.<verse eid="ACT 8:25" /></para>
  <para style="s">Felípe̱ naꞌthán-mina̱ꞌ ga̱jma̱á xa̱bo̱ tsí na̱ꞌkha̱ ná Etiopía̱</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />Mbáa ánje̱l tsí nixúngua̱a̱ꞌ Ana̱ꞌlóꞌ niꞌthúun Felípe̱: «A̱tu̱xa̱a̱ꞌ mi̱dxo̱ꞌ ná giaxu̱u̱ jawáá, ná jamba̱a̱ mbaa niníí rí nagájnuu ná xuajen Jerusalén jamí na̱ga̱taa na̱ka̱ ná xuajen Gása̱». <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />A̱ꞌkhue̱n ikhaa̱ ni̱tu̱xu̱u̱ꞌ ni̱ke̱e̱. Ikhín nixkamaa̱ mbáa xa̱bo̱ ñajun tsí phú gíꞌdoo numuu, tsí na̱ꞌkha̱ ná Etiopía̱. Ikhaa tsúꞌkhue̱n ñajuun tsí na̱gu̱xi̱i mbá xúgíí mbúkho̱o̱ a̱ꞌgo̱ Kandáse̱, tsí ñajuun a̱ꞌgo̱ thúngaa ná Etiopía̱. Xa̱bo̱ tsúꞌkhue̱n ni̱ka̱ gáꞌne-mba̱a̱ Ana̱ꞌlóꞌ ná Jerusalén. <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />Jamí rí xúge̱ꞌ rá, nathangaa̱ na̱kaa̱ ná xuajñuu̱, ꞌgíi̱ ná tsu̱du̱u̱ ixe̱ xkaraꞌndii rí nu̱xma̱taa xu̱kú, jamí na̱ka̱-ra̱gu̱xnuu̱ I̱yu̱u̱ꞌ Isaía̱s, tsí ni̱gu̱wíjnga̱a ajngóo Ana̱ꞌlóꞌ wajyúú.<verse eid="ACT 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 8:29" />A̱ꞌkhue̱n rí Xu̱u̱ꞌ Ana̱ꞌlóꞌ niꞌthúun Felípe̱: «Ataxúꞌma-mina̱ꞌ mijngi ná na̱ka̱ ixe̱ xkaraꞌndii a̱ꞌkhue̱n». <verse eid="ACT 8:29" /><verse number="30" style="v" sid="ACT 8:30" />Ído̱ ni̱tu̱muu Felípe̱ mijngi, nidxawuu̱n rí xa̱bo̱ tsúꞌkhue̱n na̱gu̱xnuu I̱yu̱u̱ꞌ Isaía̱s, a̱ꞌkhue̱n niꞌthúu̱n:</para>
  <para style="p" vid="ACT 8:30">―Á nafraꞌa̱a̱ꞌ rí naraxnuu rá.<verse eid="ACT 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31" />Xómáꞌ ikhaa̱ niꞌthée̱n:</para>
  <para style="p" vid="ACT 8:31">―Xáne lá gáfroꞌo̱ꞌ, xí nimbáa na̱nguá iꞌsngéꞌ rá.</para>
  <para style="p" vid="ACT 8:31">A̱ꞌkhue̱n ikhaa̱ niꞌthán-jáñuu̱ Felípe̱ rí ma̱tsimuu jamí ma̱ge̱ꞌe̱ ga̱jma̱á nindxu̱u̱. <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />Xáꞌnii iꞌthán i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ ná na̱gu̱xnuu̱:</para>
  <para style="q" vid="ACT 8:32">«Ni̱ka̱ jiꞌyáa̱ xómá xu̱kú mogo̱ tsí na̱ka̱ jiꞌyáa rí ma̱ja̱ñúu.</para>
  <para style="q" vid="ACT 8:32">Jamí xómá a̱ꞌdá-mógó tsí na̱nguá indxaꞌwá ná inuu tsí naꞌdo̱o̱,</para>
  <para style="q" vid="ACT 8:32">xkuaꞌnii tándxaꞌwée̱ mangaa̱.<verse eid="ACT 8:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="ACT 8:33" />Nene̱-ngínáa̱, jamí túne̱-mbáníí-mújúu̱n ga̱jma̱á numuu̱.</para>
  <para style="q" vid="ACT 8:33">I̱ndo̱ó máꞌ numuu rí tsí ñajúún xa̱bo̱ ri̱jyu̱u̱ꞌ, tsáa gáꞌngo̱o̱ maꞌthán ga̱jma̱á numúu̱ rá,</para>
  <para style="q" vid="ACT 8:33">numuu rí nini̱i̱ rí ma̱mbáa mbá jayu mbiꞌyuu̱ ná numbaa ríge̱ꞌ».<note caller="+" style="f"><char style="fr" closed="false">8.33 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 53.7-8.</char></note><verse eid="ACT 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34" />A̱ꞌkhue̱n xa̱bo̱ ñajun tsí phú gíꞌdoo numuu niꞌthúun Felípe̱: «Na̱tha̱n-jáñaaꞌ rí ma̱ra̱thu̱nꞌ, tsáa ga̱jma̱á numuu iꞌthán ríge̱ꞌ xa̱bo̱ tsí ni̱gu̱wíjnga̱a ajngóo Ana̱ꞌlóꞌ róꞌ. Á naꞌthée̱n ga̱jma̱á numuu̱ máꞌ ikhaa̱, o naꞌthée̱n ga̱jma̱á numuu i̱mba̱a̱ꞌ dxe̱ꞌ». <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />A̱ꞌkhue̱n Felípe̱ nigíꞌdu̱u̱n niꞌthán-makoo̱ asndo ná ka̱ma naꞌthán ajngáa rúꞌkhue̱n, jamí niꞌthúu̱n ajngáa máján ga̱jma̱á numuu Jesús.<verse eid="ACT 8:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 8:36" />Jamí awúun máꞌ rí nagóo̱ ná jamba̱a̱, a̱ꞌkhue̱n niguáꞌníi̱ ná ríga̱ iya, jamí niꞌthán xa̱bo̱ tsí phú gíꞌdoo numuu:</para>
  <para style="p" vid="ACT 8:36">―Ge̱jyoꞌ ríga̱ iya. Dí ñajuun irikhoo rí mi̱xúꞌdu-muꞌúún ná awúun iya rá.<verse eid="ACT 8:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 8:37" />A̱ꞌkhue̱n Felípe̱ niꞌthúu̱n:</para>
  <para style="p" vid="ACT 8:37">―Xí nanimba̱a̱ꞌ ga̱jma̱á mbá jañii a̱kia̱anꞌ, ma̱goo máꞌ xúꞌkhue̱n rá.</para>
  <para style="p" vid="ACT 8:37">A̱ꞌkhue̱n ikhaa̱ niriꞌñee̱:</para>
  <para style="p" vid="ACT 8:37">―Nanimbo̱ꞌ rí Jesukrísto̱ ñajuun A̱dée Ana̱ꞌlóꞌ.<note caller="+" style="f"><char style="fr" closed="false">8.37 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa rí ríga̱ ná kíxnuu 37. </char></note><verse eid="ACT 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 8:38" />A̱ꞌkhue̱n nixná-ñájwii̱n rí ma̱we̱je̱ ixe̱ xkaraꞌndii rí nu̱xma̱taa xu̱kú, jamí mbá nájmii̱ niguátaa̱n ná ríga̱ iya. A̱ꞌkhue̱n Felípe̱ nixúꞌdu-maꞌáan xa̱bo̱ ñajun tsí phú gíꞌdoo numuu ná awúun iya. <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />Ído̱ nigájnáa̱ ná iya, a̱ꞌkhue̱n rí Xu̱u̱ꞌ Ana̱ꞌlóꞌ mbá nacha̱ ni̱ka̱ jayáa̱ Felípe̱. Jamí xa̱bo̱ ñajun tsí phú gíꞌdoo numuu, nánguá ndiꞌyoo̱ Felípe̱. A̱ꞌkhue̱n phú gagi a̱kuii̱n nigíꞌmaa̱ jambo̱o̱ ni̱ke̱e̱. <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />Xómáꞌ Felípe̱ nikujmaa̱ ná xuajen Asóto̱. Jamí ni̱ke̱e̱-raꞌthán-raꞌee̱ ajngáa máján mbá xúgíí xuajen ná ni̱ke̱e̱-ranújngoo̱, xkuaꞌnii asndo ni̱ga̱níi̱ ná xuajen Sesaréa̱.<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s">Naxtiꞌkhu̱u a̱kui̱in Sáu̱lo̱</para>
  <para style="r">(<ref loc="ACT 22:6-16">Rnw 22.6-16</ref>;<ref loc="ACT 26:12-18">26.12-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />Xómáꞌ Sáu̱lo̱, phú najiꞌnáa̱ jaꞌñúu̱ tsí nanimbu̱únꞌ juyáá Táta̱ jamí tsíniñuu̱-raꞌthée̱n rí ma̱gu̱díi̱n. Ikhaa jngó ni̱ke̱e̱ ná inuu tsí jayá idxu̱ún dxakuun. <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />Jamí ni̱ndo̱ꞌo̱o̱ i̱yi̱i̱ꞌ rí maxnáxi̱i̱ ná mbámbá guꞌwá ná na̱gi̱mbíin xa̱bo̱ judío̱ rí triga̱ ná xuajen Damásko̱, kajngó ma̱goo mbaꞌñíi̱ xa̱bekha o go̱ꞌo̱ tsí nanimbu̱únꞌ juyáá gisngáá drígo̱o̱ Jesús, jamí ma̱ꞌkha̱ jaguu̱n maxudii̱n géjwa̱nꞌ ná Jerusalén. <verse eid="ACT 9:2" /><verse number="3" style="v" sid="ACT 9:3" />A̱ꞌkhue̱n niwatuu̱n jamba̱a̱ ni̱ke̱e̱. I̱ndo̱ó máꞌ numuu rí ído̱ inu ma̱ga̱níi̱ ná Damásko̱, nda̱a̱ ajngóo nimbiꞌi-taꞌa gakhe̱ ná inuu̱ mbá agu rí na̱ꞌkha̱ mikhuíí. <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />A̱ꞌkhue̱n nixpátri̱ga̱a̱ mbayíí, jamí nidxawuu̱n mbá a̱ꞌwá rí waꞌtháa̱n neꞌne:</para>
  <para style="p" vid="ACT 9:4">―Sáu̱lo̱, Sáu̱lo̱, náá numuu kajngó nadxa̱ꞌ-raraxkoꞌ róꞌ.<verse eid="ACT 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5" />Xómáꞌ ikhaa̱ niꞌthée̱n:</para>
  <para style="p" vid="ACT 9:5">―Tsáa ñajwaanꞌ róꞌ, Táta̱.</para>
  <para style="p" vid="ACT 9:5">A̱ꞌkhue̱n waꞌtháa̱n neꞌne a̱ꞌwá:</para>
  <para style="p" vid="ACT 9:5">―Ikhúúnꞌ ñajunꞌ Jesús, tsí nadxo̱ꞌ-raraxkáá. [Phú gakhe̱ nathane̱-ñawún-mina̱ꞌ rí natapráꞌáá ajwa̱nꞌ rí júdú inuu.<verse eid="ACT 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 9:6" />Xómáꞌ ikhaa̱ naguaꞌaa̱n jamí namíñuu̱, niꞌthée̱n:</para>
  <para style="p" vid="ACT 9:6">―Táta̱, dí iyaaꞌ rí ma̱ne̱lo̱ꞌ rá.</para>
  <para style="p" vid="ACT 9:6">Xómáꞌ Táta̱ niꞌthúu̱n:]<note caller="+" style="f"><char style="fr" closed="false">9.5-6 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa rí júgua-raꞌa ga̱jma̱á [...].</char></note></para>
  <para style="p" vid="ACT 9:6">―A̱tu̱xa̱a̱ꞌ mi̱dxo̱ꞌ ná xuajen. Ikhín mi̱ꞌtháanꞌ rí jaꞌyoo ma̱tha̱ne̱.<verse eid="ACT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7" />Jamí xa̱bo̱ tsí nagóó ga̱jma̱á nindxu̱u̱ Sáu̱lo̱, ni̱ka̱ a̱kuíi̱n niwájwii̱n, numuu rí gakon máꞌ rí ni̱dxawíi̱n a̱ꞌwá i̱ndo̱ó máꞌ numuu rí na̱nguá ndiyáa̱ nimbáa. <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />A̱ꞌkhue̱n Sáu̱lo̱ ni̱tu̱xi̱i ni̱we̱je̱. Ído̱ nirmáꞌthaa̱ iduu̱, nánguá ifrigo̱o̱ꞌ. Ikhaa jngó, ni̱ra̱tuu̱n ñawúun nigóo̱ juya̱a̱ ná Damásko̱. <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />Ikhín nixtáa̱ mbá atsú mbiꞌi rí tsífrigo̱o̱ꞌ, xúꞌkhue̱n máꞌ tákuiꞌtsii̱ ni máꞌ tágáa̱n iya.<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />Nákhí mbiꞌi rúꞌkhue̱n xtáa ná Damásko̱ mbáa xa̱bo̱ tsí nanimbo̱o̱ꞌ jaꞌyoo Jesús. Ikhaa̱ mbiꞌyuu̱ Ananía̱s, jamí waꞌtháa̱n inu-mbiꞌíí neꞌne Táta̱:</para>
  <para style="p" vid="ACT 9:10">―Ananía̱s.</para>
  <para style="p" vid="ACT 9:10">Jamí ikhaa̱ niriꞌñee̱:</para>
  <para style="p" vid="ACT 9:10">―Ge̱jyoꞌ xtáá, Táta̱.<verse eid="ACT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11" />A̱ꞌkhue̱n waꞌtháa̱n neꞌne Táta̱:</para>
  <para style="p" vid="ACT 9:11">―A̱tu̱xa̱a̱ꞌ jamí ayu ná ikhoo xuajen rí mbiꞌyuu Jmbu. Athaꞌyáa ná guꞌwóo Júda̱s mbáa xa̱bo̱ tsí mbiꞌyuu Sáu̱lo̱, tsí na̱ꞌkha̱ ná Társo̱. Ikhaa̱ xtáa̱ naꞌthán-jáñuu̱ Ana̱ꞌlóꞌ xúge̱ꞌ, <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />jamí ndiꞌyoo̱ inu-mbiꞌíí mbáa xa̱bo̱ tsí mbiꞌyuu Ananía̱s, tsí na̱to̱ꞌo̱o̱ jamí naxkrámaa̱ kajngó ma̱ma̱ꞌtha̱a iduu̱.<verse eid="ACT 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13" />A̱ꞌkhue̱n Ananía̱s niriꞌña:</para>
  <para style="p" vid="ACT 9:13">―Táta̱, phú mbaꞌiin xa̱bo̱ ni̱dxawuun rí nuthan ga̱jma̱á numuu xa̱bo̱ tsúꞌkhue̱n, jamí mbá xúgíí rí ra̱máján naꞌñúu̱ xa̱bia̱aꞌ tsí nanimbu̱únꞌ juyaaꞌ ná Jerusalén. <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />Jamí xúge̱ꞌ rá, ni̱ꞌkhe̱e̱ ge̱jyoꞌ ga̱jma̱á tsiakhe̱ rí nijanáa̱ nene̱ dxakuun tsí gíꞌdoo numúú, kajngó ma̱ꞌgee̱ jaguu̱n maxudii̱n ná géjwa̱nꞌ mbá xúgíin tsí nu̱xri̱ga̱á mbiꞌyaaꞌ.<verse eid="ACT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15" />A̱ꞌkhue̱n waꞌtháa̱n neꞌne Táta̱:</para>
  <para style="p" vid="ACT 9:15">―Ayu, numuu rí xa̱bo̱ tsí ni̱ra̱ꞌwíi ma̱jmiꞌ ñajuun tsíge̱ꞌ, kajngó ma̱ꞌgee̱ maꞌthée̱n ga̱jma̱á numuꞌ ná inúú xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, ná inúú thúngaa, jamí ná inúú i̱ji̱in Israél. <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />Numuu rí ikhúúnꞌ ma̱snga̱jmúu̱ wátha̱ jaꞌyoo rí mamínu̱u̱ꞌ ga̱jma̱á numuꞌ.<verse eid="ACT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17" />A̱ꞌkhue̱n ni̱ka̱ Ananía̱s. Ído̱ ni̱ga̱níi̱, ni̱to̱ꞌo̱o̱ guꞌwáá jamí nixkrámaa̱ Sáu̱lo̱. A̱ꞌkhue̱n niꞌthúu̱n: «Dxájuꞌ Sáu̱lo̱, Táta̱ Jesús, tsí nikujmaa ná inaaꞌ nákhí nadxa̱ꞌ ná jamba̱a̱, ikhaa̱ nixuꞌmúu̱ kajngó ma̱ma̱ꞌtha̱a idaaꞌ jamí ma̱xtáa Xu̱u̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxa̱a̱ꞌ». <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />Núkho̱ nifrigu ná iduu̱ rí xómá skama jaꞌnii jamí ni̱ma̱ꞌtha̱a iduu̱. Ído̱ ni̱tu̱xii̱, a̱ꞌkhue̱n waxúꞌdu-maꞌáa̱n ná awúun iya. <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />Nda̱wa̱á a̱ꞌkhue̱n nikuiꞌtsii̱ jamí niguu̱ la tsiakhe̱. Jamí nixtáa Sáu̱lo̱ mbá wátha̱ wáa mbiꞌi gajmíí tsí nanimbu̱únꞌ juyáá Jesús tsí júwa̱ꞌ ná Damásko̱.<verse eid="ACT 9:19" /></para>
  <para style="s">Sáu̱lo̱ naꞌthán-ráꞌa ná Damásko̱</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 9:20" />A̱ꞌkhue̱n mbá nacha̱ máꞌ nigíꞌdu̱u̱n niꞌthán-raꞌee̱ ná awúun mbámbá guꞌwá rí na̱gi̱mbíin xa̱bo̱ judío̱, naꞌthée̱n rí Jesús<note caller="+" style="f"><char style="fr" closed="false">9.20 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «Krísto̱».</char></note> ñajuun A̱dée Ana̱ꞌlóꞌ. <verse eid="ACT 9:20" /><verse number="21" style="v" sid="ACT 9:21" />Jamí mbá xúgíin tsí nu̱dxawíín rí naꞌthée̱n phú namakúu̱n jamí nuthee̱n: «Á ra̱ꞌkhá xa̱bo̱ tsíge̱ꞌ ñajuun tsí naꞌne-ngíníi xa̱bo̱ tsí nu̱xri̱ga̱á mbiꞌyuu Jesús ná Jerusalén dxe̱ꞌ. Á ra̱ꞌkhá ikhaa numuu rúꞌkhue̱n ni̱ꞌkhe̱e̱ ge̱jyoꞌ, kajngó ma̱ꞌgee̱ jaguu̱n jamí maxnáxii̱n ná inúú dxakuun tsí gíꞌdoo numúú kajngó magóo̱ géjwa̱nꞌ rá».<verse eid="ACT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 9:22" />Xómáꞌ Sáu̱lo̱ i̱tha̱án máꞌ naxná-mine̱e̱ꞌ tsiakhe̱ rí maꞌthán-raꞌee̱, jamí asndo naꞌnii̱ rí ma̱ngra̱ꞌaa idxu̱ún xa̱bo̱ judío̱ tsí júwa̱ꞌ ná Damásko̱, ído̱ nasngájmúu̱ rí Jesús ñajuun Krísto̱.<verse eid="ACT 9:22" /></para>
  <para style="s">Sáu̱lo̱ najríya̱a̱ꞌ ná inúú xa̱bo̱ judío̱</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />Ído̱ ninújngoo mbaꞌa guéño máꞌ mbiꞌi, a̱ꞌkhue̱n rí xa̱bo̱ judío̱ niguáꞌdáá awan rí mu̱xíya̱a̱ Sáu̱lo̱. <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />Xómáꞌ Sáu̱lo̱ nidxawuun rí nuꞌgí-mijná xa̱bo̱ judío̱ rí muñíi̱. Jamí ikhii̱n nu̱ña̱wáa̱n xkrugoo xuajen mbiꞌi jamí mbroꞌon kajngó mu̱xíya̱a̱. <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />A̱ꞌkhue̱n tsí nanimbu̱únꞌ juyáá Jesús nigóo̱ juya̱a̱ Sáu̱lo̱ rí mbroꞌon, ni̱ra̱khuáa̱ ná awúun mbá ixtu mba̱a̱ jamí ni̱xri̱guíi̱ ná tsu̱du̱u̱ xu̱nꞌ drígo̱o̱ xuajen.<verse eid="ACT 9:25" /></para>
  <para style="s">Sáu̱lo̱ na̱ga̱nú ná Jerusalén</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />Ído̱ ni̱ga̱níi̱ ná Jerusalén, niꞌnii̱ rí ma̱mbáxu̱u̱ꞌ gajmíi̱ tsí nanimbu̱únꞌ juyáá Jesús. I̱ndo̱ó máꞌ numuu rí mbá xúgíi̱n namíñúu̱ juyáa̱, numuu rí tsínimbúu̱n rí xa̱bo̱ tsí nanimbo̱o̱ꞌ jaꞌyoo Jesús ñajuu̱n mangaa̱. <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />A̱ꞌkhue̱n Bernabé ni̱ꞌkha̱ jayáa̱ ná inúú tsí nixúngui̱inꞌ Jesús, jamí niꞌthúu̱n xáne Sáu̱lo̱ ndiꞌyoo Táta̱ ná jamba̱a̱ jamí xáne waꞌtháa̱n neꞌne Táta̱. Xúꞌkhue̱n máꞌ niꞌthúu̱n xáne támíñuu Sáu̱lo̱ rí niꞌthán-raꞌa ná Damásko̱ ga̱jma̱á numuu Jesús. <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />Ikhaa jngó ninguanúu Sáu̱lo̱ ná Jerusalén gajmíi̱ tsí nixúngui̱inꞌ Jesús. Xúꞌkhue̱n máꞌ ngrigo̱o̱ꞌ gajmíi̱ asndo náá máꞌ nagóo̱, <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />jamí tsímíñuu̱ naꞌthán-ráꞌee̱ ga̱jma̱á numuu Táta̱, xúꞌkhue̱n máꞌ na̱tsa̱ñu̱u̱ꞌ gajmíi̱ xa̱bo̱ judío̱ tsí nuthan ajngáa griégo̱. Xómáꞌ ikhii̱n nuꞌgí-mijnée̱ rí mu̱xíya̱a̱. <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />Ído̱ ni̱dxawíín ríge̱ꞌ a̱ngia̱nꞌlóꞌ, a̱ꞌkhue̱n nigóo̱ juya̱a̱ asndo ná xuajen Sesaréa̱, jamí ikhín ni̱xu̱ꞌmaa̱ ma̱ꞌgee̱ ná xuajen Társo̱.<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />A̱ꞌkhue̱n mbámbá kuthuun tsí nanimbu̱únꞌ juyáá Jesús tsí júwa̱ꞌ ná numbaa Judéa̱, ná numbaa Galiléa̱ jamí ná numbaa Samária̱, júwe̱e̱ꞌ tsímáá jamí naꞌne-gúkúu̱n ná inuu Ana̱ꞌlóꞌ. Xúꞌkhue̱n máꞌ júwe̱e̱ꞌ nduya-makuíi̱ Táta̱, jamí naꞌne mbaꞌii̱n máꞌ xúꞌkhue̱n numuu rí Xu̱u̱ꞌ Ana̱ꞌlóꞌ nambáñúu̱.<verse eid="ACT 9:31" /></para>
  <para style="s">Na̱gu̱ma-thanáá Enéa̱s</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />Ído̱ rí Pédro̱ ni̱ka̱ gáꞌñúú mbá xúgíin tsí nanimbu̱únꞌ juyáá Jesús, a̱ꞌkhue̱n ni̱ke̱e̱ gáꞌñúu̱ xa̱bi̱i Ana̱ꞌlóꞌ tsí júwa̱ꞌ ná xuajen Lída̱ mangaa. <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />Ikhín nixkamaa̱ mbáa xa̱bo̱ nixtriga̱a̱, tsí mbiꞌyuu Enéa̱s, jamí naꞌne mbá migiñu tsigu rí kri̱ga̱a̱ ná xi̱yoo. <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />A̱ꞌkhue̱n Pédro̱ niꞌthúu̱n: «Enéa̱s, Jesukrísto̱ naꞌne-thanaaꞌ. Araxu̱unꞌ, jamí atiáxi̱i xi̱yawaaꞌ». A̱ꞌkhue̱n mbá nacha̱ máꞌ ni̱tu̱xii̱. <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />Jamí mbá xúgíin xa̱bo̱ tsí júwa̱ꞌ ná xuajen Lída̱ jamí ná numbaa Sarón ndiyáá rí ni̱tu̱xii̱. A̱ꞌkhue̱n nithangii̱n ná inuu Táta̱.<verse eid="ACT 9:35" /></para>
  <para style="s">Ndayáa mbiꞌyuu Dórka̱s</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />Nákhí mbiꞌi máꞌ rúꞌkhue̱n, xtáa ná xuajen Jópe̱ mbáa a̱ꞌgo̱ tsí ninimbo̱o̱ꞌ jaꞌyoo Jesús, tsí mbiꞌyuu Tabíta̱ (rí nandoo gáꞌthán Dórka̱s). Ikhaa a̱ꞌgo̱ tsíge̱ꞌ gatíí rí máján naꞌnii̱ jamí nambáñúu̱ xa̱bo̱ tsí ngíníi. <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />Ikhaa máꞌ mbiꞌi rúꞌkhue̱n, ndiyóo̱ nandii jamí nijáñuu̱. Ído̱ wámbu̱ún xa̱bo̱ ni̱tsu̱wáa̱n, a̱ꞌkhue̱n ni̱ti̱ge̱e̱ xuyuu̱ ná awúun mbá guꞌwá rí ri̱jma̱á. <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />Xómáꞌ xuajen Lída̱ mijngi máꞌ ꞌgí ne̱ ga̱jma̱á xuajen Jópe̱. Ikhaa jngó ído̱ ni̱dxawíín tsí nanimbu̱únꞌ juyáá Jesús rí Pédro̱ xtáa ná Lída̱, a̱ꞌkhue̱n ni̱xu̱ꞌmii̱ a̱jmi̱i xa̱bo̱ magóó gúthán-jáñíi̱. Xáꞌnii nitháa̱n: «Aya̱ gátha̱ya̱ꞌxo̱ꞌ tháan ná Jópe̱ mbá nacha̱».<verse eid="ACT 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 9:39" />A̱ꞌkhue̱n mbá nacha̱ máꞌ ni̱tu̱xu̱u̱ꞌ Pédro̱ ni̱ka̱ ga̱jma̱á nindxúu̱n. Jamí ído̱ ni̱ga̱níi̱, a̱ꞌkhue̱n nigóo̱ juya̱a̱ ná guꞌwá ri̱jma̱á, ná gatiin mbá xúgíin go̱ꞌóxuáꞌa nu̱mbi̱ya̱ꞌ. Ikhiin tsúꞌkhue̱n mbá nawa̱a̱ niwájun ná inuu̱, nu̱snga̱jmáa̱ gajnú mbijwa̱ꞌ jamí i̱ꞌwá xtíin rí niꞌxmí Dórka̱s nákhí xtáa̱ ga̱jma̱á nindxúu̱n. <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />A̱ꞌkhue̱n Pédro̱ ni̱gu̱wíin mbá xúgíin xa̱bo̱ rixa̱á, jamí nismáti̱go̱o̱ niꞌthán-jáñuu̱ Ana̱ꞌlóꞌ. Nda̱wa̱á niyaxi̱i̱ ná kri̱ga̱ xuyuu tsí nijáñuu, jamí niꞌthúu̱n: «Tabíta̱, araxu̱unꞌ». Xómáꞌ ikhaa̱ nirmáꞌthaa̱ iduu̱, jamí ído̱ ndiꞌyoo̱ Pédro̱, a̱ꞌkhue̱n ni̱tu̱xii̱ ni̱gi̱ꞌi̱i̱. <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />A̱ꞌkhue̱n Pédro̱ niwatuun ñawúu̱n jamí nixúxii̱. Wámba̱ rúꞌkhue̱n, nindxaꞌwúu̱n xa̱bi̱i Ana̱ꞌlóꞌ jamí go̱ꞌóxuáꞌa, a̱ꞌkhue̱n ndaꞌya Dórka̱s nixnáxii̱ ná inúú.<verse eid="ACT 9:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 9:42" />Mbá xúgíí xuajen Jópe̱ niwán ríge̱ꞌ, jamí phú mbaꞌiin xa̱bo̱ ninimbu̱únꞌ juyáá Táta̱. <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />A̱ꞌkhue̱n Pédro̱ ninguanúu mba̱yo̱ꞌ ná xuajen Jópe̱, ná guꞌwóo mbáa xa̱bo̱ tsí mbiꞌyuu Simón, tsí nañajun ga̱jma̱á xtúún xu̱kú.<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s">Kornélio̱ nandxaꞌwóo Pédro̱</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />Nixtáa ná xuajen Sesaréa̱ mbáa xa̱bo̱ tsí mbiꞌyuu Kornélio̱, tsí naꞌthán-ñájúún tsí ku̱ra̱tuun ajwa̱nꞌ, kuthuun tsí mbiꞌñúú «tsí naguwá ná Itália̱». <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />Ikhaa xa̱bo̱ tsúꞌkhue̱n májáan a̱kuii̱n jamí naꞌne-mba̱a̱ Ana̱ꞌlóꞌ gajmíi̱ mbá xúgíin xa̱bo̱ guꞌwóo̱. Xúꞌkhue̱n máꞌ phú nambáñúu̱ xa̱bo̱ xuajen tsí ngíníi, jamí tsitsíí naꞌthán-jáñuu̱ Ana̱ꞌlóꞌ. <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />Mbá mbiꞌi, naꞌne xó mbá atsú wáa i̱ka̱ ajwa̱nꞌ rí wakhíí, xa̱bo̱ tsíge̱ꞌ ndiꞌyoo inu-mbiꞌíí rí mbáa ánje̱l tsí nixúngua̱a̱ꞌ Ana̱ꞌlóꞌ na̱to̱ꞌo̱o̱ ná gíde̱e̱ꞌ, jamí naꞌthúu̱n:</para>
  <para style="p" vid="ACT 10:3">―Kornélio̱.<verse eid="ACT 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4" />Xómáꞌ ikhaa̱, mbóó wájun iduu̱ rí nayaxu̱u̱, jamí ga̱jma̱á ngamí niraxu̱u̱:</para>
  <para style="p" vid="ACT 10:4">―Dí máꞌ iyaaꞌ rá, Táta̱.</para>
  <para style="p" vid="ACT 10:4">A̱ꞌkhue̱n niriꞌña ánje̱l:</para>
  <para style="p" vid="ACT 10:4">―Ana̱ꞌlóꞌ nidxawaa̱nꞌ máꞌ rí narathán-jáñíi̱ ga̱jma̱á numuu, jamí ni̱grui̱guíi̱ máꞌ rí xómá tsi̱gi̱jña̱ꞌ jaꞌnii, rí natambáñúú xa̱bo̱ tsí ngíníi. <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />Ikhaa jngó, ataxúꞌmii mbá tikhuun xa̱bo̱ magóó ná xuajen Jópe̱, kajngó mutháa̱n xa̱bo̱ tsí mbiꞌyuu Simón ma̱ꞌkha̱, tsí nutháa̱n Pédro̱. <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />Ikhaa̱ xtáa̱ ná guꞌwóo mbáa xa̱bo̱ tsí mbiꞌyuu Simón, tsí nañajun ga̱jma̱á xtúún xu̱kú, tsíge̱ꞌ ꞌgí guꞌwóo ná mijngi rawuun iya a̱pha̱. Ikhaa̱ maꞌtháa̱nꞌ rí ndaꞌyóo ma̱tha̱ne̱.<note caller="+" style="f"><char style="fr" closed="false">10.6 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «Ikhaa̱ maꞌtháa̱nꞌ rí ndaꞌyóo ma̱tha̱ne̱».</char></note><verse eid="ACT 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 10:7" />Ído̱ ni̱ka̱a ánje̱l tsí nandxákuun ga̱jma̱á Kornélio̱, a̱ꞌkhue̱n nindxaꞌwúu̱n a̱jmi̱i yumbée̱, jamí mbáa xa̱bo̱ tsí kuatuun ajwa̱nꞌ, tsí naꞌne-mba̱a̱ Ana̱ꞌlóꞌ jamí jmbii naꞌne-mbánuu ñajun ná inuu̱. <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />Ikhiin tsúꞌkhue̱n niꞌthúu̱n mbá xúgíí rí waꞌtháa̱n neꞌne ánje̱l, a̱ꞌkhue̱n nixuꞌmii̱ magóó ná xuajen Jópe̱.<verse eid="ACT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />I̱mba̱ mbiꞌi, awúun máꞌ rí ikhii̱n nagóo̱ ná jamba̱a̱ jamí nangiyuu máꞌ ma̱guáꞌnii̱ ná xuajen, a̱ꞌkhue̱n Pédro̱ nitsimuu ná tsu̱du̱u̱ guꞌwá kajngó maꞌthán-jáñuu̱ Ana̱ꞌlóꞌ, rí xó mbá wakha̱ꞌ niníí wáa eꞌne. <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />A̱ꞌkhue̱n ni̱gi̱ꞌma ni̱xki̱dxu̱u̱ mi̱ndaꞌkho, jamí neꞌne a̱kuii̱n ma̱kuiꞌtsii̱. I̱ndo̱ó máꞌ numuu rí awúun máꞌ rí na̱gu̱ma-mújúun rí mi̱khui̱i̱, a̱ꞌkhue̱n ni̱ꞌkha̱ inu-mbiꞌíí mbá rí ndiꞌyoo̱. <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />Ndiꞌyoo̱ rí ja̱ma̱ꞌtha mikhu, jamí na̱ga̱taa mbá rí xómá xtíin wapa jaꞌnii, xtoꞌwóo mbá nákho̱ rakhóo ne̱ rí na̱ga̱taa ne̱ asndo mbayíí. <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />Jamí ná awúun ne̱ gatiin mbá xúgíí inii xu̱kú tsí akho̱ nakhúún, xu̱kú tsí nu̱xma̱ta-mijná jamí xu̱kú xna. <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />A̱ꞌkhue̱n nidxawuu̱n mbá a̱ꞌwá rí niꞌthán:</para>
  <para style="p" vid="ACT 10:13">―Pédro̱, a̱tu̱xa̱a̱ꞌ, aradíin xu̱kú tsúꞌkhue̱n mi̱ꞌtsúún.<verse eid="ACT 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14" />A̱ꞌkhue̱n Pédro̱ niꞌthán:</para>
  <para style="p" vid="ACT 10:14">―Táta̱, ma̱xíꞌkhúu̱nlo̱ꞌ ikhúúnꞌ. Numuu rí nimbá miꞌtsú téꞌkholo̱ꞌ ganitsu rí xkawe̱ꞌ o rí ra̱jáꞌyoo me̱ꞌkholo̱ꞌ mbo̱ꞌ.<verse eid="ACT 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15" />A̱ꞌkhue̱n nidxawuu̱n mbu̱júꞌ a̱ꞌwá:</para>
  <para style="p" vid="ACT 10:15">―Rí Ana̱ꞌlóꞌ neꞌne-jaꞌwu̱u, ma̱xára̱tha̱n ikháánꞌ rí xkawe̱ꞌ ne̱.<verse eid="ACT 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 10:16" />Atsú nothon niríga̱ ríge̱ꞌ. A̱ꞌkhue̱n waꞌyáa xtíin wapa rúꞌkhue̱n ni̱ka̱a mikhuíí.<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />Awúun máꞌ rí Pédro̱ xtáa nandxaꞌwá-mina̱ꞌ dí iyoo gáꞌthán rí ndiꞌyoo̱ inu-mbiꞌíí, a̱ꞌkhue̱n niguáꞌnú ná rawuun xkrugua xa̱bo̱ tsí nixúngui̱inꞌ Kornélio̱, numuu rí naguwée̱ꞌ-ru̱ra̱xi̱i̱ náá ꞌgí guꞌwóo Simón. <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />A̱ꞌkhue̱n ni̱ndxa̱ꞌwa̱-raꞌee̱, ni̱ra̱xi̱i̱ xí ikhín xtáa mbáa xa̱bo̱ tsí mbiꞌyuu Simón, ikhaa tsí nutháa̱n Pédro̱ mangaa.<verse eid="ACT 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19" />Jamí awúun máꞌ rí Pédro̱ xóó xtáa nandxaꞌwá-mina̱ꞌ rí ndiꞌyoo inu-mbiꞌíí, a̱ꞌkhue̱n waꞌtháa̱n neꞌne Xu̱u̱ꞌ Ana̱ꞌlóꞌ: «A̱ꞌkhue̱n wájun atsúun xa̱bo̱ tsí nduꞌñáá. <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />Ikhaa jngó, a̱tu̱xa̱a̱ꞌ jamí adxutaaꞌ gátha̱ñúu̱. Jamí ma̱xáꞌne a̱jma̱ a̱kia̱anꞌ rí mi̱dxo̱ꞌ ga̱jma̱á nindxúu̱n, numuu rí ikhúúnꞌ ni̱xu̱ꞌmíi̱ ma̱guwée̱ꞌ».<verse eid="ACT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 10:21" />A̱ꞌkhue̱n Pédro̱ ni̱ga̱taa ná wájun xa̱bo̱ tsí nixúꞌmii Kornélio̱ jamí niꞌthúu̱n:</para>
  <para style="p" vid="ACT 10:21">―Ikhúúnꞌ ñajunꞌ xa̱bo̱ tsí ndu̱ꞌyáalaꞌ. Náá numuu kajngó niguwalaꞌ róꞌ.<verse eid="ACT 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22" />A̱ꞌkhue̱n ikhii̱n nithee̱n:</para>
  <para style="p" vid="ACT 10:22">―Xa̱bo̱ nikhi̱i̱ Kornélio̱ tsí naꞌthán-ñájúún tsí ku̱ra̱tuun ajwa̱nꞌ nixuꞌmáaꞌxo̱ꞌ. Ikhaa̱ ñajuu̱n mbáa xa̱bo̱ tsí jmbii jamí ndaya-makuu Ana̱ꞌlóꞌ, xúꞌkhue̱n máꞌ máján kri̱ga̱ ajngáa ga̱jma̱á numuu̱ ná xuajñúú xa̱bo̱ judío̱. Mbáa ánje̱l tsí nixúngua̱a̱ꞌ Ana̱ꞌlóꞌ waꞌtháa̱n neꞌne rí mandxaꞌwáaꞌ mi̱dxo̱ꞌ ná guꞌwóo̱ kajngó madxawuu̱n rí ma̱ra̱tháa̱n.<verse eid="ACT 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 10:23" />A̱ꞌkhue̱n Pédro̱ niꞌthúu̱n rí ma̱nújngúu̱n guꞌwáá kajngó mbuya̱a xúu̱nꞌ. Jamí i̱mba̱ mbiꞌi ni̱tu̱xu̱u̱ꞌ Pédro̱ ni̱ka̱ ga̱jma̱á nindxúu̱n, xúꞌkhue̱n máꞌ nigóó mbá tikhuun a̱ngia̱nꞌlóꞌ tsí júwa̱ꞌ ná Jópe̱ ga̱jma̱á nindxu̱u̱.<verse eid="ACT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 10:24" />Asndo i̱mba̱ mbiꞌi niguáꞌníi̱ ná xuajen Sesaréa̱. Xómáꞌ Kornélio̱ gíꞌthu̱u̱n máꞌ gajmíi̱ a̱nguii̱n tsí nindxaꞌwúu̱n ma̱guwá, xúꞌkhue̱n máꞌ iyanga̱jwee̱ tsí phú nambáxu̱u̱ꞌ gajmíi̱. <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />Ído̱ ni̱ga̱nú Pédro̱ ná guꞌwá, a̱ꞌkhue̱n nigájnuu Kornélio̱ kajngó ma̱grui̱guíi̱, jamí nismáti̱go̱o̱ ná nakhúu Pédro̱ rí ndiya-makuu̱. <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />Xómáꞌ Pédro̱ nixúxii̱, jamí niꞌthúu̱n: «Ariajún, numuu rí xa̱bo̱ numbaa máꞌ ñajunꞌ mangúúnꞌ, xómá rí ikháánꞌ». <verse eid="ACT 10:26" /><verse number="27" style="v" sid="ACT 10:27" />Awúun máꞌ rí Pédro̱ nandxákuun ga̱jmáa̱ nindxu̱u̱ Kornélio̱, ni̱to̱ꞌo̱o̱ guꞌwáá, a̱ꞌkhue̱n ndiꞌyoo̱ rí phú mbaꞌiin xa̱bo̱ ni̱gi̱mbúun.<verse eid="ACT 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 10:28" />A̱ꞌkhue̱n niꞌthúu̱n xa̱bo̱:</para>
  <para style="p" vid="ACT 10:28">―Ikháanꞌ ndu̱ya̱álaꞌ rí phú ra̱máján iꞌyoo mbáa xa̱bo̱ judío̱ rí ma̱mbáxu̱u̱ꞌ ga̱jmáa̱ mbáa xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajuun o ma̱ꞌgee̱ ná guꞌwóo mbo̱ꞌ. Xómáꞌ ikhúúnꞌ nisngájmiꞌ Ana̱ꞌlóꞌ rí asndo nimbáa xa̱bo̱ ma̱xátha̱n rí ra̱májáa̱n o rí xkawi̱i̱ꞌ mbo̱ꞌ. <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />Ikhaa jngó, ído̱ ni̱dxawuun rí nu̱ndxa̱ꞌwo̱ꞌlaꞌ, mbá nacha̱ máꞌ niꞌkhalo̱ꞌ, nimbá máꞌ ajngáa táne̱lo̱ꞌ. Ikhaa jngó na̱ra̱xa̱ꞌlaꞌ, náá numuu kajngó ni̱ndxa̱ꞌwo̱ꞌlaꞌ rí ma̱ꞌkha róꞌ.<verse eid="ACT 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30" />A̱ꞌkhue̱n Kornélio̱ niꞌthán:</para>
  <para style="p" vid="ACT 10:30">―Naꞌne máꞌ akho̱ mbiꞌi rí xúge̱ꞌ, xíríga̱a̱ máꞌ, xtáá ná guꞌwóꞌ ge̱jyoꞌ na̱ne̱-miꞌkhíi.<note caller="+" style="f"><char style="fr" closed="false">10.30 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «na̱ne̱-miꞌkhíi».</char></note> Awúun máꞌ rí xtáá na̱tha̱n-jáñuu Ana̱ꞌlóꞌ rí atsú i̱ka̱ ajwa̱nꞌ rí wakhíí, a̱ꞌkhue̱n ndi̱yo̱o̱ wéje̱ mbáa xa̱bo̱ tsí nambiꞌi-taꞌa xtíñuu ná inuꞌ. <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />Jamí niꞌthínꞌ: “Kornélio̱, nidxawuun máꞌ Ana̱ꞌlóꞌ rí narathán-jáñíi̱ ga̱jma̱á numuu, jamí ni̱grui̱guíi̱ máꞌ rí xómá tsi̱gi̱jña̱ꞌ jaꞌnii, rí natambáñúú xa̱bo̱ tsí ngíníi. <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />Ikhaa jngó, ataxúꞌmii mbá tikhuun xa̱bo̱ magóó ná xuajen Jópe̱, kajngó mutháa̱n xa̱bo̱ tsí mbiꞌyuu Simón ma̱ꞌkha̱, tsí nutháa̱n Pédro̱. Ikhaa̱ xtáa̱ ná guꞌwóo mbáa xa̱bo̱ tsí mbiꞌyuu Simón, tsí nañajun ga̱jma̱á xtúún xu̱kú, tsíge̱ꞌ ꞌgí guꞌwóo ná mijngi rawuun iya a̱pha̱. Ído̱ ma̱ga̱níi̱, ikhaa̱ maꞌtháa̱nꞌ”.<note caller="+" style="f"><char style="fr" closed="false">10.32 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «Ído̱ ma̱ga̱níi̱, ikhaa̱ maꞌtháa̱nꞌ».</char></note> <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />Ikhaa jngó mbá nacha̱ máꞌ ni̱xu̱ꞌmíi xa̱bo̱ rí magóó gúña̱áꞌ. Jamí ikháánꞌ máján máꞌ nithane̱ rí nidxa̱ꞌ. Ikhaa jngó rí xúge̱ꞌ rá, mbá xúgiáanꞌxo̱ꞌ juwaxo̱ꞌ ge̱jyoꞌ ná inuu Ana̱ꞌlóꞌ, kajngó mu̱dxawíínxo̱ꞌ mbá xúgíí rí niꞌtháanꞌ Ana̱ꞌlóꞌ ma̱ra̱tha̱nꞌxo̱ꞌ.<verse eid="ACT 10:33" /></para>
  <para style="s">Pédro̱ naꞌthán-ráꞌa ná guꞌwóo Kornélio̱</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />A̱ꞌkhue̱n Pédro̱ nigíꞌdu̱u̱n niꞌthán:</para>
  <para style="p" vid="ACT 10:34">―Asndo xúge̱ꞌ nafroꞌo̱ꞌ rí gakon rí Ana̱ꞌlóꞌ tsíraꞌwíi̱n xa̱bo̱ tsí ma̱ꞌne-nga̱júu̱n, <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />rí asndo náá máꞌ xuajen numbaa na̱ni̱gu̱u̱ꞌ jaꞌñúu̱ mbá xúgíin xa̱bo̱ tsí nune̱-mba̱a̱ jamí nune̱ rí máján. <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />Ana̱ꞌlóꞌ nixuꞌma ajngáa ná inúú i̱ji̱in Israél, niꞌthúu̱n ajngáa máján rí naꞌne rí ma̱ju̱wá tsímáá xa̱bo̱ ga̱jma̱á majñu̱u̱ Jesukrísto̱. Ikhaa tsíge̱ꞌ ñajuun tsí naꞌthán-ñájúún mbá xúgíin xa̱bo̱. <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />Ikháanꞌlaꞌ ni̱dxawíínlaꞌ máꞌ ajngáa rí waꞌthán-raꞌa ná mbá xúgíí numbaa Judéa̱, rí ni̱gi̱ꞌdu̱u̱n asndo ná numbaa Galiléa̱, nákhí Juáán wámbo̱o̱ niꞌthán-raꞌa rí mi̱xúꞌdu-maꞌíin xa̱bo̱ ná awúun iya. <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />Ni̱dxawíínlaꞌ xáne jaꞌnii rí Ana̱ꞌlóꞌ niraꞌwíi Jesús tsí na̱ꞌkha̱ ná Nasarét rí ma̱nindxu̱u̱ thúngaa, ikhaa jngó nixnúu̱ Xu̱u̱ꞌ jamí ski̱yu̱u̱ꞌ. Xúꞌkhue̱n máꞌ ni̱dxawíínlaꞌ xáne Jesús ningrigo̱o̱ꞌ-raꞌne rí máján jamí neꞌne-thanúu̱ mbá xúgíin xa̱bo̱ tsí nu̱míni̱í eꞌne gixa̱a̱, numuu rí Ana̱ꞌlóꞌ xtáa ga̱jma̱á nindxu̱u̱. <verse eid="ACT 10:38" /><verse number="39" style="v" sid="ACT 10:39" />Jamí ikháanꞌxo̱ꞌ ndi̱ya̱áxo̱ꞌ mbá xúgíí rí neꞌne Jesús ná numbaa Judéa̱ ga̱jma̱á ná xuajen Jerusalén. Xúꞌkhue̱n máꞌ ndi̱ya̱áxo̱ꞌ rí waꞌdujmaa̱ ná ixe̱ krúsi̱ nene̱ xa̱bo̱ tsí ni̱xíya̱a̱. <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />Ikhaa tsíge̱ꞌ neꞌne Ana̱ꞌlóꞌ rí mbayáa mbiꞌyuu ído̱ nirámuu atsú mbiꞌi, jamí niꞌnii̱ rí masngájma-mine̱e̱ꞌ ná inaxo̱ꞌ. <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />Tásngájma-mine̱e̱ꞌ ná inúú mbá xúgíin xa̱bo̱ xuajen, rí i̱ndo̱ó máꞌ ná inúú tsí wapha máꞌ niraꞌwíin Ana̱ꞌlóꞌ rí ma̱ꞌne inúú. Nisngájma-mine̱e̱ꞌ ná inaxo̱ꞌ ikháanꞌxo̱ꞌ, nipeꞌtsóxo̱ꞌ jamí niwánxo̱ꞌ ga̱jma̱á nindxu̱u̱ nákhí ndiyáa̱ mbiꞌyuu̱. <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />Jamí ikhaa̱ nixnángawaxo̱ꞌ rí mu̱tha̱n-ráꞌaxo̱ꞌ ná inúú xa̱bo̱ xuajen, xúꞌkhue̱n máꞌ rí mu̱tha̱nxo̱ꞌ rí ikhaa̱ ñajuun tsí Ana̱ꞌlóꞌ niꞌgíi kajngó ma̱ꞌne-mbánuu̱ ga̱jma̱á numúú tsí nduya jamí tsí nijáñúú. <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />Ga̱jma̱á numuu̱ ikhaa̱ nithan mbá xúgíin xa̱bo̱ tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ wajyúú, rí mbá xúgíin xa̱bo̱ tsí nanimbu̱únꞌ juyáa̱ ikhaa̱, ma̱ꞌne mba̱a̱ a̱kui̱in Ana̱ꞌlóꞌ jaꞌñúu̱ ga̱jma̱á numuu̱ ikhaa̱.<verse eid="ACT 10:43" /></para>
  <para style="s">Xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún nu̱dri̱guíi Xu̱u̱ꞌ Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />Awúun máꞌ rí xóó naꞌthán Pédro̱ ajngáa ríge̱ꞌ, a̱ꞌkhue̱n mbá xúgíin xa̱bo̱ tsí nu̱dxawíín ajngáa rí naꞌthée̱n, ni̱dri̱guíi̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ. <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />Xómáꞌ xa̱bo̱ judío̱ tsí nanimbu̱únꞌ juyáá Jesús, tsí niguwá ga̱jma̱á nindxu̱u̱ Pédro̱, phú nimakúu̱n rí xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún nu̱dri̱guíi Xu̱u̱ꞌ Ana̱ꞌlóꞌ mangii̱n. <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />Numuu rí nu̱dxawíi̱n rí nuthee̱n ajngáa rí tsígu̱ma-nuwiin, jamí nune̱-mba̱a̱ Ana̱ꞌlóꞌ.<verse eid="ACT 10:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="ACT 10:47" />A̱ꞌkhue̱n Pédro̱ niꞌthán: «Á ma̱ꞌngo̱o̱ mbáa xa̱bo̱ ma̱we̱je̱ꞌthu̱u̱n rí mi̱xúꞌdu-maꞌíin xa̱bo̱ tsíge̱ꞌ ná awúun iya, rí ni̱dri̱guíi̱ máꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ mangiin xómá rí ikháánꞌlóꞌ rá». <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />A̱ꞌkhue̱n nixná-ñájwii̱n rí mi̱xúꞌdu-maꞌíi̱n ná awúun iya ga̱jma̱á numuu Táta̱ Jesús. Wámba̱ rúꞌkhue̱n nithán-jáñíi̱ Pédro̱ rí ma̱nguanúu mbá wátha̱ wáa mbiꞌi ga̱jma̱á nindxúu̱n.<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s">Pédro̱ narígu̱u ajngáa ná inúú tsí nanimbu̱únꞌ juyáá Jesús ná Jerusalén</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />Ni̱dxawíín tsí nixúngui̱inꞌ Jesús jamí a̱ngia̱nꞌlóꞌ tsí júwa̱ꞌ ná numbaa Judéa̱, rí xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún ni̱dri̱gú ajngóo Ana̱ꞌlóꞌ mangiin. <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />Ído̱ nithanga̱a Pédro̱ ná Jerusalén, a̱ꞌkhue̱n xa̱bo̱ judío̱ tsí nanimbu̱únꞌ juyáá Jesús nitháa̱n rí ra̱máján niꞌnii̱:<verse eid="ACT 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 11:3" />―Náá numuu kajngó ni̱ta̱ꞌa̱a̱ꞌ guꞌwúún xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, jamí nitseꞌtso ga̱jma̱á nindxúu̱n róꞌ.<verse eid="ACT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 11:4" />A̱ꞌkhue̱n Pédro̱ nigíꞌdu̱u̱n niꞌthán-makúu̱n xáne phú niríga̱. Xáꞌnii niꞌthúu̱n:<verse eid="ACT 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 11:5" />―Nákhí xtáálo̱ꞌ ná xuajen Jópe̱ na̱tha̱n-jáñuu Ana̱ꞌlóꞌ, ndi̱yo̱o̱ inu-mbiꞌíí mbá rí xómá xtíin wapa jaꞌnii, xtoꞌwóo mbá nákho̱ rakhóo ne̱ jamí na̱ga̱taa ne̱ ná mikhuíí asndo ná inuꞌ. <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />Ído̱ ni̱ya̱xu̱u̱ mújúnꞌ ne̱ kajngó mba̱yo̱o̱ dí ñajuun gati ná awúun ne̱, a̱ꞌkhue̱n ndi̱ñu̱ú xu̱kú tsí akho̱ nakhúún, xu̱kú-xáná tsí phú namangu̱únꞌ, xu̱kú tsí nu̱xma̱ta-mijná jamí xu̱kú xna. <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />Jamí ni̱dxawuun mbá a̱ꞌwá rí niꞌthínꞌ: “Pédro̱, a̱tu̱xa̱a̱ꞌ, aradíin xu̱kú tsúꞌkhue̱n mi̱ꞌtsúún”.<verse eid="ACT 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 11:8" />»Xómáꞌ ikhúúnꞌ ni̱thu̱u̱n: “Táta̱, ma̱xíꞌkhúu̱nlo̱ꞌ ikhúúnꞌ. Numuu rí nimbá miꞌtsú téꞌkholo̱ꞌ ganitsu rí xkawe̱ꞌ o rí ra̱jáꞌyoo me̱ꞌkholo̱ꞌ mbo̱ꞌ”.<verse eid="ACT 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 11:9" />»A̱ꞌkhue̱n a̱ꞌwá rí na̱ꞌkha̱ ná mikhuíí niꞌthínꞌ rí riajma̱ nothon: “Rí Ana̱ꞌlóꞌ neꞌne-jaꞌwu̱u, ma̱xára̱tha̱n ikháánꞌ rí xkawe̱ꞌ ne̱”. <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />Atsú nothon niríga̱ rúꞌkhue̱n, a̱ꞌkhue̱n ni̱ka̱ jiꞌyáa mbá xúgíí rúꞌkhue̱n ná mikhuíí.<verse eid="ACT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 11:11" />»Awúun máꞌ rúꞌkhue̱n niguáꞌnú mbá atsúun xa̱bo̱ ná guꞌwá rí xtáálo̱ꞌ, tsí waxúꞌmii asndo ná Sesaréa̱ rí ma̱guwá gúñu̱ú. <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />Jamí Xu̱u̱ꞌ Ana̱ꞌlóꞌ niꞌthínꞌ rí ma̱ꞌgá ga̱jma̱á nindxúu̱n ga̱jma̱á mbá jañii a̱kui̱nꞌ. Mangaa máꞌ nigóó mbá majuun a̱ngia̱nꞌlóꞌ tsíge̱ꞌ ga̱jma̱á nindxu̱ꞌ, jamí ni̱ta̱ꞌa̱ꞌxo̱ꞌ ná guꞌwóo mbáa xa̱bo̱. <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />Ikhaa̱ niꞌthánxo̱ꞌ xáne ndiꞌyoo̱ mbáa ánje̱l tsí ni̱ꞌkha̱ gáwe̱je̱ ná guꞌwóo̱, jamí xáꞌnii waꞌtháa̱n neꞌne ánje̱l: “Ataxúꞌmii mbá tikhuun xa̱bo̱ magóó ná xuajen Jópe̱, kajngó mutháa̱n xa̱bo̱ tsí mbiꞌyuu Simón ma̱ꞌkha̱, tsí nutháa̱n Pédro̱. <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />Ikhaa̱ maꞌtháa̱nꞌ xáne ma̱goo ma̱jríñáaꞌ ikháánꞌ, jamí mbá xúgíin xa̱bo̱ guꞌwáaꞌ”.<verse eid="ACT 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 11:15" />»Ído̱ ni̱gíꞌdu̱u̱n ni̱thúu̱nlo̱ꞌ, a̱ꞌkhue̱n ni̱dri̱guíi̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ mangii̱n, xómá rí ni̱dríguíi̱ ikháánꞌlóꞌ nákhí ginii. <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />A̱ꞌkhue̱n ni̱rmáꞌáan a̱kui̱nꞌ rí niꞌthán Táta̱: “Gakon máꞌ rí Juáán nixúꞌdu-maꞌíin xa̱bo̱ ná awúun iya, xómáꞌ Ana̱ꞌlóꞌ ma̱ꞌne rí ikháanꞌlaꞌ mu̱dríguíilaꞌ Xu̱u̱ꞌ”. <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />Ikhaa jngó, xí Ana̱ꞌlóꞌ naxnúu̱ mangii̱n ikhaa máꞌ rí nixnálóꞌ ikháánꞌlóꞌ tsáanꞌ ninimba̱ꞌlóꞌ juꞌyáá Táta̱ Jesukrísto̱, tsáa lá ñajunꞌ ikhúúnꞌ kajngó ma̱wáju̱ꞌthu̱u̱n rí naꞌne Ana̱ꞌlóꞌ rá.<verse eid="ACT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18" />Ído̱ ni̱dxawíi̱n rúꞌkhue̱n, a̱ꞌkhue̱n neꞌne-wíyuu rawúu̱n, jamí ne̱ne̱-mba̱a̱ Ana̱ꞌlóꞌ, xúꞌkhue̱n máꞌ nithee̱n:</para>
  <para style="p" vid="ACT 11:18">―¡Áan! ¡Asndo xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún neꞌne Ana̱ꞌlóꞌ rí ma̱thanga̱a a̱kui̱ín kajngó mbuya jámuu mangiin rá jno̱ꞌ!<verse eid="ACT 11:18" /></para>
  <para style="s">Tsí nanimbu̱únꞌ juyáá Jesús ná Antiokía̱</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />Xómáꞌ tsí ni̱drúꞌúún ga̱jma̱á numuu rí na̱gu̱ma-ngíníi, rí ni̱gi̱ꞌdu̱u̱n nákhí nijáñuu Estéba̱n, niguáꞌníi̱ asndo ná Fenísia̱, ná Chípre̱, jamí ná xuajen Antiokía̱. Ikhín nithúu̱n ajngóo Ana̱ꞌlóꞌ i̱ndo̱ó máꞌ xa̱bo̱ judío̱. <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />I̱ndo̱ó máꞌ numuu rí ná majñu̱ú xa̱bo̱ tsí ni̱drúꞌúún júwa̱ꞌ mbá tikhuun xa̱bo̱ tsí naguwá ná Chípre̱ jamí xa̱bo̱ tsí naguwá ná Siréne̱. Ikhiin tsúꞌkhue̱n, ído̱ niguáꞌníi̱ ná xuajen Antiokía̱, nithúu̱n mangiin xa̱bo̱ griégo̱ ajngáa máján ga̱jma̱á numuu Táta̱ Jesús. <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />Jamí Táta̱ xtáa ga̱jma̱á nindxúu̱n, ikhaa jngó phú mbaꞌiin xa̱bo̱ ninimbu̱únꞌ jamí nithanga̱a a̱kui̱ín ná inuu Táta̱.<verse eid="ACT 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22" />Ído̱ ni̱dxawíín ajngáa ríge̱ꞌ tsí nanimbu̱únꞌ juyáá Jesús ná Jerusalén, a̱ꞌkhue̱n ni̱xu̱ꞌmaa̱ Bernabé ma̱ꞌga ná Antiokía̱. <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />Ído̱ Bernabé ni̱ga̱nú, a̱ꞌkhue̱n ndiꞌyoo̱ rí Ana̱ꞌlóꞌ neꞌne-tsakun-rámii xa̱bo̱ tsúꞌkhue̱n. A̱ꞌkhue̱n nidxu a̱kuii̱n, jamí niꞌthán-múꞌúu̱n mbá xúgíi̱n rí mbóó máꞌ gúꞌgí-mijnée̱ rí ma̱ꞌne jañii a̱kuíi̱n ná inuu Ana̱ꞌlóꞌ. <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />Numuu rí ikhaa̱ ñajuu̱n mbáa xa̱bo̱ tsí májáan a̱kui̱in, jamí xtáa Xu̱u̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxu̱u̱, xúꞌkhue̱n máꞌ phú wéje̱ a̱kuii̱n ná inuu Ana̱ꞌlóꞌ. A̱ꞌkhue̱n i̱tha̱án neꞌne mbaꞌiin xa̱bo̱ tsí nanimbu̱únꞌ juyáá Táta̱. <verse eid="ACT 11:24" /><verse number="25" style="v" sid="ACT 11:25" />Nda̱wa̱á a̱ꞌkhue̱n ni̱ka̱ Bernabé ná Társo̱, kajngó mbaꞌyáa̱ Sáu̱lo̱. Jamí ído̱ nixkamaa̱, a̱ꞌkhue̱n ni̱ꞌkhaa̱ ga̱jmáa̱ ná Antiokía̱. <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />Ikhín máꞌ nijúwe̱e̱ꞌ mbá jañii tsigu gajmíi̱ tsí nanimbu̱únꞌ juyáá Jesús, jamí phú mbaꞌiin xa̱bo̱ nisngúu̱n. Ikhín máꞌ ná Antiokía̱ a̱ꞌkhue̱n nigo̱ ginii jayu mbiꞌñúú tsí nanimbu̱únꞌ juyáá Jesús «tsí nagóó tsu̱du̱u̱ Krísto̱».<verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />Nákhí mbiꞌi rí ñúꞌún nigájnúú mbá tikhuun xa̱bo̱ tsí nu̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ ná Jerusalén, jamí niguáꞌníi̱ ná Antiokía̱. <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />A̱ꞌkhue̱n ni̱tu̱xu̱u̱ꞌ mbáa tsí ikhii̱n, tsí mbiꞌyuu Agábo̱, naꞌthée̱n ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ rí phú gakhe̱ ma̱ri̱gá ewi ná inuu mbá xúgíí numbaa ná júwa̱ꞌ xa̱bo̱. Ikhaa ewi rúꞌkhue̱n niríga̱ nákhí niꞌthán-ñájun Kláudio̱. <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />A̱ꞌkhue̱n tsí nanimbu̱únꞌ juyáá Jesús ná Antiokía̱, niguáꞌdáa̱ awan rí mu̱mbáñúu̱ a̱ngia̱nꞌlóꞌ tsí júwa̱ꞌ ná numbaa Judéa̱. Mbámbáa nixná xómá rí ni̱ꞌngo̱o̱ nixná. <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />Xkuaꞌnii nini̱i̱, jamí ni̱xu̱ꞌmaa̱ Bernabé ga̱jma̱á Sáu̱lo̱ magóó juñu̱ú ne̱ ná inúú xa̱bo̱ buanuu tsí júwa̱ꞌ ná numbaa Judéa̱.<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s">Nijáñuu Santiágo̱, xómáꞌ Pédro̱ nu̱xu̱da̱a̱ꞌ ná géjwa̱nꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />Ikhín máꞌ mbiꞌi rí ñúꞌún, thúngaa Eróde̱s nixná-ñájun rí ma̱tiin mbá tikhuun tsí nanimbu̱únꞌ juyáá Jesús, kajngó ma̱ꞌne-ngíníi̱. <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />Jamí nixná-ñájwii̱n rí ma̱ja̱ñúu ga̱jma̱á chíde̱ Santiágo̱, dxíyo̱o̱ Juáán. <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />Ído̱ ndiꞌyoo̱ rí ni̱ni̱gu̱ún xa̱bo̱ judío̱ rí niꞌnii̱ rúꞌkhue̱n, a̱ꞌkhue̱n nixná-ñájwii̱n rí ma̱khuáa Pédro̱ mangaa. Rúꞌkhue̱n niríga̱ ná awúun ndxa̱a̱ rí naꞌpho̱ xa̱bo̱ guma bopho rí na̱nguá gíꞌdoo ñu̱u̱ miga̱ꞌ. <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />Ído̱ nikhuáa Pédro̱, a̱ꞌkhue̱n nixná-ñájwii̱n rí ma̱ꞌgee̱ géjwa̱nꞌ, xúꞌkhue̱n máꞌ nixná-ñájwii̱n rí mu̱ña̱wáa̱n mbá akho̱ kuthuun rí mbámbá akhu̱un xa̱bo̱ tsí ku̱ra̱tuun ajwa̱nꞌ. Numuu rí naꞌgí-mine̱e̱ꞌ rí maxnáxi̱i̱ ná inúú xa̱bo̱ xuajen ído̱ gánújngoo ndxa̱a̱ Páskua̱. <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />Ikhaa jngó Pédro̱ kra̱ꞌaa ná géjwa̱nꞌ, jamí ni̱tia̱wáa̱n májáa̱n. Xómáꞌ tsí nanimbu̱únꞌ juyáá Jesús, nuthán-jáñíi̱ máꞌ xúꞌkhue̱n Ana̱ꞌlóꞌ ga̱jma̱á numuu Pédro̱.<verse eid="ACT 12:5" /></para>
  <para style="s">Pédro̱ najríya̱a̱ꞌ ná géjwa̱nꞌ</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />Ído̱ nangiyuu máꞌ mbiꞌi rí Eróde̱s maxná-ñájun rí ma̱ga̱jnáa Pédro̱ ná géjwa̱nꞌ, ikhaa máꞌ mbroꞌon rúꞌkhue̱n kri̱ga̱a̱ Pédro̱ naꞌgu ná majñu̱ú a̱jmi̱i xa̱bo̱ tsí ku̱ra̱tuun ajwa̱nꞌ, xtoꞌwóo̱ ga̱jma̱á a̱jma̱ ñuu ajwa̱nꞌ. Jamí mbá tikhuun tsí ku̱ra̱tuun ajwa̱nꞌ nu̱ña̱wa̱án rawuun xkrugoo géjwa̱nꞌ. <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />A̱ꞌkhue̱n nda̱a̱ ajngóo nisngájma-mina̱ꞌ mbáa ánje̱l tsí nixúngua̱a̱ꞌ Táta̱, jamí nimbiꞌi-taꞌa agu ná géjwa̱nꞌ. A̱ꞌkhue̱n ánje̱l nixkajma ná níjñúu Pédro̱ kajngó maxkaxii̱, jamí niꞌthúu̱n: «Araxu̱unꞌ mbá nacha̱». A̱ꞌkhue̱n nithon-rígú ikhaa ñuu ajwa̱nꞌ rí xtoꞌwóo ná ñawúun Pédro̱. <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />Jamí waꞌtháa̱n neꞌne ánje̱l: «Atruꞌwáa smídáaꞌ jamí atruꞌwáa chádaaꞌ». Jamí xkuaꞌnii neꞌne Pédro̱. A̱ꞌkhue̱n waꞌtháa̱n xóó neꞌne ánje̱l: «Atambráꞌa-mina̱ꞌ xtátsiaa̱nꞌ, jamí aya̱ ga̱jma̱á nindxu̱ꞌ».<verse eid="ACT 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 12:9" />A̱ꞌkhue̱n nigájnuu Pédro̱, na̱ke̱e̱ tsu̱du̱u̱ ánje̱l, i̱ndo̱ó máꞌ numuu rí tsíꞌyoo̱ xí gakon rí naꞌne ánje̱l. Ikhaa̱ ni̱ju̱mu̱u̱ rí mbá rí ndaꞌyoo̱ inu-mbiꞌíí ñajuun ne̱. <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />Ído̱ ninújngúu̱n ná wájun timbá jamí riajma̱ kuthuun xa̱bo̱ tsí ku̱ra̱tuun ajwa̱nꞌ, a̱ꞌkhue̱n niguáꞌníi̱ ná xkrugua ajwa̱nꞌ rí jayá rawuun rixa̱á. Ni̱ma̱ꞌthoo máꞌ ikhaa xkrugua rúꞌkhue̱n kajngó ma̱ga̱jnúu̱. Jamí nagóo̱ mbá ikhoo xuajen, a̱ꞌkhue̱n nda̱a̱ ajngóo nánguá nikujma náá ni̱ka̱ ánje̱l tsí na̱ka̱ ga̱jma̱á Pédro̱.<verse eid="ACT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11" />A̱ꞌkhue̱n Pédro̱ nifroꞌo̱o̱ jamí niꞌthán-mine̱e̱ꞌ: «Asndo xúge̱ꞌ nda̱yo̱o̱ rí gakon rí Táta̱ nixuꞌmaa ánje̱l drígo̱o̱ kajngó ma̱ꞌne-jríñúu̱ ná ñawúun Eróde̱s, xúꞌkhue̱n máꞌ neꞌne-jríñúu̱ inuu mbá xúgíí rí nandúún xa̱bo̱ judío̱ muñi̱ꞌ».<verse eid="ACT 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12" />Ído̱ wámbo̱o̱ niꞌthán-mine̱e̱ꞌ rúꞌkhue̱n, a̱ꞌkhue̱n ni̱ke̱e̱ ná guꞌwóo María̱, nánée Juáán, tsí nutháa̱n Márko̱s, ná phú mbaꞌiin xa̱bo̱ nimbáxi̱in nuthán-jáñíí Ana̱ꞌlóꞌ. <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />Ído̱ Pédro̱ nixnúu rawuun xkrugua rí rixa̱á, a̱ꞌkhue̱n mbáa dxáꞌgú tsí mbiꞌyuu Róde̱ ni̱ka̱ gáꞌyoo tsáa ñajuu̱n. <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />Ído̱ rí ikhaa̱ neꞌne-nuwii̱n a̱ꞌwóo Pédro̱, a̱ꞌkhue̱n phú gagi a̱kuii̱n neꞌne rí asndo tármáꞌthoo̱ xkrugua. Nigáyuu̱ ni̱kaa̱ gáꞌthée̱n rí Pédro̱ wéje̱ rixa̱á. <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />Jamí ikhii̱n nitháa̱n:</para>
  <para style="p" vid="ACT 12:15">―Najmiyaaꞌ ikháánꞌ.</para>
  <para style="p" vid="ACT 12:15">Xómáꞌ ikhaa̱ naꞌthée̱n rí gakon rí xkuaꞌnii jaꞌnii. A̱ꞌkhue̱n ikhii̱n nithee̱n:</para>
  <para style="p" vid="ACT 12:15">―Ánje̱l tsí na̱ña̱wu̱u̱n Pédro̱ ñajuu̱n.<verse eid="ACT 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16" />Xómáꞌ Pédro̱ naxnúu máꞌ xúꞌkhue̱n rawuun xkrugua. Ído̱ ni̱rmáꞌtháa̱ jamí ndiyáa̱ Pédro̱, a̱ꞌkhue̱n ni̱ka̱ a̱kuíi̱n. <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />Xómáꞌ ikhaa̱, naꞌnii̱ ñawúu̱n rí naꞌthúu̱n rí muni̱i̱ wíí, a̱ꞌkhue̱n niꞌthúu̱n xáne nigájnaa̱ ná géjwa̱nꞌ neꞌne Táta̱. Jamí niꞌthúu̱n: «Gu̱tha̱ánlaꞌ ríge̱ꞌ Santiágo̱ jamí a̱ngia̱nꞌlóꞌ mangiin». A̱ꞌkhue̱n nigájnuu̱, ni̱ke̱e̱ i̱mba̱ janíí.<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />Ído̱ ni̱mbiꞌi, xa̱bo̱ tsí ku̱ra̱tuun ajwa̱nꞌ phú wee nini̱i̱ rí namakúu̱n, numuu rí tsíyáa̱ náá ni̱ka̱ Pédro̱. <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />Xómáꞌ Eróde̱s nixná-ñájun rí mbi̱ꞌyáa Pédro̱, i̱ndo̱ó máꞌ numuu rí na̱nguá nikujmaa̱. Ikhaa jngó niraxúu̱n tsí ni̱ña̱wáa̱n, jamí nixná-ñájwii̱n rí ma̱ja̱ñúú tsúꞌkhue̱n. Nda̱wa̱á a̱ꞌkhue̱n, nigájnuu Eróde̱s ná Judéa̱ jamí ni̱ke̱e̱ gáxtáa̱ ná Sesaréa̱.<verse eid="ACT 12:19" /></para>
  <para style="s">Nijáñuu Eróde̱s</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />Eróde̱s najiꞌnáa jaꞌñúú xa̱bo̱ xuajen Tíro̱ ga̱jma̱á xa̱bo̱ xuajen Sidón. Xómáꞌ xa̱bo̱ tsúꞌkhue̱n niguáꞌdáa̱ awan rí magóo̱ gúyáa̱ Eróde̱s. Ni̱ꞌngúu̱n nene̱-rájáa̱ Blásto̱, xa̱bo̱ tsí nayaxe̱-ra̱ꞌmúu ñajun ná guꞌwóo thúngaa, rí maꞌthán ná inuu Eróde̱s rí ikhii̱n tsíñúu̱ xkujndu, numuu rí xa̱bo̱ xuajñúu̱ jayá mbiꞌñúú ga̱jma̱á rí najma̱a̱ ná xuajñuu thúngaa. <verse eid="ACT 12:20" /><verse number="21" style="v" sid="ACT 12:21" />Jamí ído̱ ni̱ga̱nú mbiꞌi rí Eróde̱s ma̱grui̱gúu̱n, a̱ꞌkhue̱n nijúwaa̱n xtíin mitsaan rí najúwuu̱n ído̱ rí naꞌthán-ñájwii̱n, jamí ni̱gi̱ꞌi̱i̱ ná xílii̱, a̱ꞌkhue̱n niꞌthán-raꞌee̱ mu̱dxawíín xa̱bo̱. <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />Xómáꞌ xa̱bo̱ xuajen ni̱gíꞌdíi̱n ni̱ndxa̱ꞌwe̱e̱ jamí nithee̱n: «¡Ana̱ꞌlóꞌ ñajuun tsí naꞌthán, ra̱ꞌkhá mbáa xa̱bo̱ numbaa iꞌthán!». <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />Núkho̱ máꞌ mbrúma rúꞌkhue̱n, Eróde̱s ndiyóo mbá nandii gakhi̱i̱ neꞌne mbáa ánje̱l tsí nixúngua̱a̱ꞌ Táta̱, numuu rí táꞌne-mba̱a̱ Ana̱ꞌlóꞌ. A̱ꞌkhue̱n wanitsíi̱ nene̱ ñu̱u̱ jamí nijáñuu̱.<verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />Xómáꞌ ajngóo Ana̱ꞌlóꞌ, na̱ka̱-ra̱dróꞌoo máꞌ ne̱ xúꞌkhue̱n, jamí nithán-raꞌa ne̱ mbá xúgíí ná júwa̱ꞌ xa̱bo̱.<verse eid="ACT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25" />Ído̱ Bernabé ga̱jma̱á Sáu̱lo̱ wámbúu̱n nene̱-mbáníi̱ ñajun rí ni̱gi̱ꞌmii̱ muni̱i̱ ná Jerusalén, a̱ꞌkhue̱n nigúu̱n ná Antiokía̱ gajmíi̱ Juáán, tsí nutháa̱n Márko̱s.<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s">Timbá miꞌtsú rí Bernabé ga̱jma̱á Sáu̱lo̱ nagájnúú juñu̱ú ajngóo Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />Ná majñu̱ú tsí nanimbu̱únꞌ juyáá Jesús ná Antiokía̱ júwa̱ꞌ xa̱bo̱ tsí nu̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ jamí tsí nusngáá. Ikhii̱n ñajúún: Bernabé, Simón (tsí nutháa̱n «Xa̱bo̱ Skunii»), Lúsio̱ tsí na̱ꞌkha̱ ná xuajen Siréne̱, Manaén tsí mbóó nigaja̱a̱ ga̱jma̱á thúngaa Eróde̱s, jamí Sáu̱lo̱ mangaa. <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />Mbá mbiꞌi rí tsúꞌkhue̱n júwa̱ꞌ nune̱-mba̱a̱ Táta̱, jamí nune̱-miꞌkhíi̱, a̱ꞌkhue̱n niꞌthán Xu̱u̱ꞌ Ana̱ꞌlóꞌ: «Gu̱ríya̱a̱ꞌlaꞌ janíí Bernabé ga̱jma̱á Sáu̱lo̱, kajngó muni̱i̱ ñajun rí ni̱ndxa̱ꞌwúu̱n muni̱i̱». <verse eid="ACT 13:2" /><verse number="3" style="v" sid="ACT 13:3" />Ído̱ wámbúu̱n nene̱-miꞌkhíi̱ jamí nithán-jáñíi̱ Ana̱ꞌlóꞌ, a̱ꞌkhue̱n ni̱xkra̱mii̱ꞌ jamí nithan-ngawúu̱n.<verse eid="ACT 13:3" /></para>
  <para style="s">Bernabé ga̱jma̱á Sáu̱lo̱ nuthan-raꞌa ná Chípre̱</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />A̱ꞌkhue̱n Bernabé ga̱jma̱á Sáu̱lo̱ waxúꞌmii̱ neꞌne Xu̱u̱ꞌ Ana̱ꞌlóꞌ ná Seléusia̱, jamí ikhín nitsimúu̱ mbá guꞌwá-rguwa rí na̱ka̱ ná Chípre̱. <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />Ído̱ niguáꞌníi̱ ná xuajen Salamína̱, a̱ꞌkhue̱n ni̱gíꞌdíi̱n nithan-raꞌee̱ ajngóo Ana̱ꞌlóꞌ ná awúun mbámbá guꞌwá rí na̱gi̱mbíin xa̱bo̱ judío̱. Na̱ka̱ Juáán mangaa ga̱jma̱á nindxúu̱n jamí nambáñúu̱.<verse eid="ACT 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6" />Nigóo̱-ranújngúu̱n mbá xúgíí mbaa rí kua̱ꞌa̱n ná awúun iya a̱pha̱, jamí niguáꞌníi̱ asndo ná xuajen Páfo̱s. Ikhín ni̱xkamaa̱ mbáa xa̱bo̱ judío̱ mbiꞌyuu Barjesús, tsí na̱ma̱ñuu naꞌne xawan, jamí na̱gu̱wíjnga̱a ajngáa rí mi̱nduwa. <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />Xa̱bo̱ xawan tsíge̱ꞌ ngrigo̱o̱ꞌ ga̱jma̱á thúngaa Sérgio̱ Páulo̱, tsí phú máján idxu̱u̱. Thúngaa tsíge̱ꞌ nindxaꞌwóo Bernabé ga̱jma̱á Sáu̱lo̱, numuu rí nandoo̱ madxawuu̱n ajngóo Ana̱ꞌlóꞌ. <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />Xómáꞌ xa̱bo̱ tsí na̱ma̱ñuu naꞌne xawan, tsí mbiꞌyuu Elíma̱s ná ajngáa griégo̱, na̱we̱je̱-ꞌthu̱u̱n Bernabé ga̱jma̱á Sáu̱lo̱, numuu rí tsíyoo̱ rí ma̱nimbo̱o̱ꞌ thúngaa jaꞌyoo Ana̱ꞌlóꞌ. <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />A̱ꞌkhue̱n Sáu̱lo̱, tsí mbiꞌyuu Páblo̱ mangaa, xtáa Xu̱u̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxu̱u̱, niraꞌe̱e̱ inuu Elíma̱s. <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />Jamí niꞌthúu̱n: «Gatíí mbá xúgíí inii rí mi̱nduwa jamí mbá xúgíí inii rí ra̱máján ná awúun a̱kia̱anꞌ. A̱dée gixa̱a̱ ñajwaanꞌ, jamí xa̱bo̱ tsí tsíyoo jaꞌyoo mbá xúgíí rí máján ñajwaanꞌ. Á ma̱xáta̱tsi̱ꞌñáá rí nathane̱-maꞌchíí jamba̱a̱ jmbu drígo̱o̱ Táta̱ dxe̱ꞌ. <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />Ikhaa jngó rí xúge̱ꞌ rá, Táta̱ ma̱ꞌne rí ma̱ta̱míni̱í. Ma̱ꞌnii̱ rí ma̱xáfriga̱a̱ꞌ jamí ma̱xátha̱ya̱á aguu a̱kha̱ꞌ mbá wátha̱ wáa mbiꞌi».</para>
  <para style="p" vid="ACT 13:11">A̱ꞌkhue̱n núkho̱ máꞌ nijúgoo iduu̱ jamí neꞌne jína inuu̱. Wíji̱i̱-ratuaꞌáa̱n, jamí ndaꞌyáa̱ tsí maguatuun ñawúu̱n kajngó mbayá ikhoo̱. <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />Ído̱ rí thúngaa ndiꞌyoo rí niríga̱, a̱ꞌkhue̱n ninimbo̱o̱ꞌ jaꞌyoo̱ Ana̱ꞌlóꞌ, jamí phú nimakuu̱ neꞌne gisngáá ga̱jma̱á numuu Táta̱.<verse eid="ACT 13:12" /></para>
  <para style="s">Páblo̱ ga̱jma̱á Bernabé nuthan-raꞌa ná Antiokía̱ ná mbayuu Pisídia̱</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />Páblo̱ jamí tsí gajmíi̱ nitsimúu̱ guꞌwá-rguwa ná Páfo̱s, niguáꞌníi̱ ná xuajen Pérje̱, mbayuu Panfília̱. Xómáꞌ Juáán niniñúu̱, nithangaa̱ ni̱kaa̱ ná xuajen Jerusalén. <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />A̱ꞌkhue̱n ikhii̱n, nigájnúu̱ ná xuajen Pérje̱, niguáꞌníi̱ ná xuajen Antiokía̱ mbayuu Pisídia̱. Mbá mbiꞌi rí nduya̱a xu̱únꞌ xa̱bo̱ ni̱tu̱ꞌúu̱n ná guꞌwá rí na̱gi̱mbíin xa̱bo̱ judío̱ jamí nitrigii̱n. <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />Nda̱wa̱á, ído̱ wámba̱ ni̱gi̱ꞌxnuu xtángoo drígo̱o̱ Moisés xúꞌkhue̱n máꞌ rí nithan tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ, a̱ꞌkhue̱n xa̱bo̱ tsí juya̱ idxu̱u̱ ná guꞌwá rí na̱gi̱mbíin xa̱bo̱ judío̱ ni̱xu̱ꞌma ajngáa rí mi̱ꞌthúu̱n: «Xa̱bo̱ buanuu a̱ngui̱nꞌ, xí guáꞌdáálaꞌ ajngáa rí mu̱tha̱n-múꞌúúnlaꞌ xa̱bo̱ xuajen, ma̱goo mu̱tha̱nlaꞌ xúge̱ꞌ».<verse eid="ACT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16" />A̱ꞌkhue̱n ni̱we̱je̱ Páblo̱, jamí niꞌnii̱ ñawúu̱n rí ma̱ꞌne-wíyuu gúne̱ xa̱bo̱, jamí niꞌthée̱n: «Xa̱bo̱ buanuu Israél, jamí tsáanꞌ nu̱ne̱-mba̱a̱laꞌ Ana̱ꞌlóꞌ, gu̱dxawíínlaꞌ. <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />Ana̱ꞌlóꞌ tsí nune̱-mba̱a̱ xa̱bo̱ xuajen Israél niraꞌwíi̱n táta̱-xi̱ꞌñálóꞌ wajyúú, jamí niꞌnii̱ rí ma̱nindxúu̱n mbá xuajen mba̱a̱ nákhí júwe̱e̱ꞌ ná ra̱ꞌkháa xuajñúu̱, ná Ejípto̱. Nda̱wa̱á ni̱gu̱wíi̱n ikhín ga̱jma̱á phú mba̱a̱ ski̱yu̱u̱ꞌ. <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />Jamí ni̱ꞌngo̱o̱ a̱kuii̱n jaꞌñúu̱ a̱jma̱ skíñú (40) tsigu ná mbaa niníí. <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />Jamí ído̱ wámbo̱o̱ Ana̱ꞌlóꞌ neꞌne-gámba̱a mbá juwan xuajen numbaa rí triga̱ ná Kanaán, a̱ꞌkhue̱n niniñuu̱ mbañúú xa̱bo̱ tsúꞌkhue̱n ná ñawúún táta̱-xi̱ꞌñálóꞌ wajyúú. <verse eid="ACT 13:19" /><verse number="20" style="v" sid="ACT 13:20" />Mbá xúgíí ríge̱ꞌ niríga̱ awúun rí xó mbá akho̱ siénto̱ a̱jma̱ skíñú gu̱wa̱ꞌ (450) wáa tsigu.</para>
  <para style="p" vid="ACT 13:20">»Nda̱wa̱á a̱ꞌkhue̱n Ana̱ꞌlóꞌ neꞌne rí ma̱ju̱wá xa̱bo̱ tsí mbuya̱ ikhúu̱n, xkuaꞌnii asndo mbiꞌi rí nixtáa Samuél tsí ni̱gu̱wíjnga̱a ajngóo Ana̱ꞌlóꞌ. <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />A̱ꞌkhue̱n ikhii̱n ni̱nda̱ꞌa̱a̱ mbáa thúngaa, jamí Ana̱ꞌlóꞌ niꞌgíi Saúl, a̱dée táta̱ Sís, tsí na̱ꞌkha̱ ná ri̱jyu̱u̱ꞌ Benjamín. A̱ꞌkhue̱n Saúl niꞌthán-ñájun a̱jma̱ skíñú (40) tsigu. <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />Ído̱ rí Ana̱ꞌlóꞌ niríya̱aꞌ Saúl, a̱ꞌkhue̱n niꞌgíi̱ Dabíd rí ma̱nindxu̱u̱ thúngaa, tsí niꞌthée̱n ríge̱ꞌ numuu: “Ni̱xkamaalo̱ꞌ ná Dabíd, a̱dée táta̱ Isaí, mbáa xa̱bo̱ tsí xómá jaꞌnii a̱kui̱nꞌ jaꞌnii a̱kuii̱n. Ikhaa̱ ma̱ꞌnii̱ mbá xúgíí rí nandoꞌ”.<verse eid="ACT 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 13:23" />»Ikhín máꞌ ná ri̱jyu̱u̱ꞌ Dabíd ni̱ꞌkha̱ Jesús tsí ma̱ꞌne-jáwíin xa̱bo̱ Israél, xómá rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ wajyúú. <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />Nákhí rí inu máꞌ ma̱ꞌkha̱ Jesús, niꞌthán-raꞌa Juáán ná inúú xa̱bo̱ xuajen Israél, rí mi̱xúꞌdu-maꞌíin xa̱bo̱ ná awúun iya kajngó ma̱kujma rí nathanga̱a a̱kuíi̱n ná inuu Ana̱ꞌlóꞌ. <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />Jamí ído̱ rí inu máꞌ na̱ka̱-rámbo̱o̱ Juáán ñajun rí naꞌne, a̱ꞌkhue̱n niꞌthée̱n: “Tsáa ñajunꞌ i̱ju̱ma̱ꞌlaꞌ rá. Ra̱ꞌkhá ikhúúnꞌ ñajunꞌ ikhaa̱. I̱ndo̱ó máꞌ numuu rí gu̱ya̱álaꞌ rí ná tsu̱du̱ꞌ na̱ꞌkha̱ mbáa tsí ni ra̱jáꞌyoꞌ rí ma̱ra̱khúu chádoo”.<verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />»Xa̱bo̱ buanuu a̱ngui̱nꞌ, tsáanꞌ ñajwanlaꞌ xa̱bo̱ ri̱jyu̱u̱ꞌ Abraám, xúꞌkhue̱n máꞌ tsáanꞌ ra̱ꞌkháa xa̱bo̱ judío̱ ñajwanlaꞌ tsí nu̱ne̱-mba̱a̱laꞌ Ana̱ꞌlóꞌ, ná inalaꞌ ikháanꞌlaꞌ ni̱ga̱nú ajngáa ríge̱ꞌ kajngó ma̱jríñáaꞌlaꞌ.<note caller="+" style="f"><char style="fr" closed="false">13.26 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán: «ná inalóꞌ ikháánꞌlóꞌ ni̱ga̱nú ajngáa ríge̱ꞌ kajngó ma̱jríñáaꞌlóꞌ».</char></note> <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />Numuu rí xa̱bo̱ tsí júwa̱ꞌ ná Jerusalén jamí xa̱bo̱ ñajun drígúu̱n, táfruꞌúu̱n tsáa ñajuun Jesús, ni máꞌ táfruꞌúu̱n ajngúún xa̱bo̱ tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ wajyúú, rí na̱gi̱ꞌxnuu inúu̱ mbámbá mbiꞌi rí nduya̱a xu̱únꞌ xa̱bo̱. I̱ndo̱ó máꞌ numuu rí ikhii̱n máꞌ nene̱-mbáníi̱ ajngúún xa̱bo̱ tsúꞌkhue̱n nákhí nixna-ñajwii̱n rí ma̱ja̱ñúu Jesús. <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />Maske máꞌ na̱nguá ni̱xkamaa̱ náá numuu kajngó asndo jaꞌyoo rí ma̱ja̱ñúu̱, ni̱nda̱ꞌáa̱ Piláto̱ maxná ajngóo rí ma̱ja̱ñúu Jesús. <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />Ído̱ wámbúu̱n nene̱-mbáníi̱ mbá xúgíí rí ka̱ma naꞌthán ga̱jma̱á numuu Jesús, a̱ꞌkhue̱n ni̱ríguíi̱ ná ixe̱ krúsi̱ jamí nidii̱. <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />I̱ndo̱ó máꞌ numuu rí Ana̱ꞌlóꞌ neꞌne rí mbayáa̱ mbiꞌyuu̱. <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />Jamí ikhaa̱ nisngájma-mine̱e̱ꞌ mbaꞌa mbiꞌi ná inúú tsí mbóó nitsimuu̱ gajmíi̱ ná Galiléa̱ asndo ná Jerusalén. Jamí xúge̱ꞌ ikhiin tsúꞌkhue̱n ñajúún tsí nuthan ná inúú xa̱bo̱ xuajen, rí ndiyáa̱ rí gakon ndiyáa mbiꞌyuu Jesús.<verse eid="ACT 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 13:32" />»Xúꞌkhue̱n máꞌ mangáanꞌxo̱ꞌ nu̱tha̱nꞌlaꞌxo̱ꞌ ajngáa máján rúꞌkhue̱n, rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ maxnúú táta̱-xi̱ꞌñálóꞌ wajyúú. <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />Ikhaa rúꞌkhue̱n neꞌne-mbánuu Ana̱ꞌlóꞌ ná inalóꞌ ikháánꞌlóꞌ, tsáanꞌ ñajwanlóꞌ i̱jíi̱n ikhii̱n, ído̱ niꞌnii̱ rí mbayáa mbiꞌyuu Jesús. Xómá ka̱ma naꞌthán ná Ajmúú rí riajma̱ mangaa:</para>
  <para style="q" vid="ACT 13:33">“Ikháánꞌ ñajwaanꞌ A̱ꞌdéꞌ.</para>
  <para style="q" vid="ACT 13:33">Ikhúúnꞌ ne̱ne̱-ku̱mááꞌ xúge̱ꞌ”.<note caller="+" style="f"><char style="fr" closed="false">13.33 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 2.7.</char></note><verse eid="ACT 13:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 13:34" />Ana̱ꞌlóꞌ neꞌne rí mbayáa mbiꞌyuu Jesús, kajngó ni miꞌtsú náxíga xuyuu̱, xómá rí niꞌthée̱n nákhí wajyúú: “Ikhúúnꞌ ma̱ne̱-tsakun-rámáaꞌlaꞌ xómá ni̱tha̱n rí jámuu ma̱ne̱-tsakun-rámaa Dabíd”.<note caller="+" style="f"><char style="fr" closed="false">13.34 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 55.3.</char></note> <verse eid="ACT 13:34" /><verse number="35" style="v" sid="ACT 13:35" />Ikhaa jngó naꞌthán ná i̱mba̱ Ajmúú mangaa: “Ma̱xáta̱tsi̱ꞌñáá rí mi̱ga xuyuu Yumbiáaꞌ tsí Jmbii”.<note caller="+" style="f"><char style="fr" closed="false">13.35 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 16.10.</char></note> <verse eid="ACT 13:35" /><verse number="36" style="v" sid="ACT 13:36" />Numuu rí gakon máꞌ rí Dabíd neꞌne-mba̱ꞌwi̱in xa̱bo̱ tsí nijúwa̱ꞌ nákhí mbiꞌi rí nixtáa, xómá rí nandoo Ana̱ꞌlóꞌ. Nda̱wa̱á nijáñuu̱, nijnguáa̱n gajmíi̱ táta̱-xi̱ꞌñúu̱ wajyúú, jamí niꞌga xuyuu̱. <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />Xómáꞌ tsí ndiyáa mbiꞌyuu neꞌne Ana̱ꞌlóꞌ, tíga xuyuu̱.<verse eid="ACT 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 13:38" />»Ikhaa jngó, xa̱bo̱ buanuu a̱ngui̱nꞌ, nandoꞌ rí ma̱fraꞌa̱ꞌlaꞌ ríge̱ꞌ: ikháanꞌlaꞌ nithánlaꞌ rí Ana̱ꞌlóꞌ naꞌne mba̱a̱ a̱kui̱in jaꞌyoo aꞌkhánlaꞌ ga̱jma̱á majñu̱u̱ Jesús. <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />Jamí Ana̱ꞌlóꞌ naꞌne mba̱a̱ a̱kui̱in jaꞌyoo aꞌkhúun jámba̱a̱ xa̱bo̱ tsí nanimbo̱o̱ꞌ jaꞌyoo Jesús. Naꞌne mba̱a̱ a̱kuii̱n jaꞌyoo̱ mbá xúgíí aꞌkhúún xa̱bo̱ rí ra̱khóo ma̱ꞌne mba̱a̱ a̱kuii̱n jaꞌyoo̱ ga̱jma̱á majñu̱u̱ xtángoo drígo̱o̱ Moisés. <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />Ikhaa jngó, gu̱ña̱wa̱n-mijnálaꞌ, ra̱ꞌkhá ma̱gíꞌníí ikháanꞌlaꞌ rí nithan xa̱bo̱ tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ wajyúú:<verse eid="ACT 13:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="ACT 13:41" />“Gu̱ya̱xe̱laꞌ, tsáanꞌ nu̱tsi̱jmúúlaꞌ,</para>
  <para style="q" vid="ACT 13:41">ga̱makualaꞌ, jamí ga̱mbáanꞌlaꞌ.</para>
  <para style="q" vid="ACT 13:41">Numuu rí ikhúúnꞌ ma̱ne̱ mbá ñajun awúun mbiꞌi rí juwalaꞌ,</para>
  <para style="q" vid="ACT 13:41">mbá ñajun rí ma̱xánimba̱ꞌlaꞌ,</para>
  <para style="q" vid="ACT 13:41">maske máꞌ mbáa xa̱bo̱ maꞌthánlaꞌ ne̱”».<note caller="+" style="f"><char style="fr" closed="false">13.41 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Abakúk 1.5.</char></note><verse eid="ACT 13:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />Ído̱ rí Páblo̱ gajmíí a̱ngui̱in nigájnáa̱ ná guꞌwá rí na̱gi̱mbíin xa̱bo̱ judío̱,<note caller="+" style="f"><char style="fr" closed="false">13.42 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «ná guꞌwá rí na̱gi̱mbíin xa̱bo̱ judío̱».</char></note> a̱ꞌkhue̱n xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún nithan-jáñúu̱ rí ma̱thangii̱n i̱mba̱ mbiꞌi rí nduya̱a xu̱únꞌ xa̱bo̱, kajngó muthúu̱n xóó ga̱jma̱á numuu rúꞌkhue̱n. <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />Jamí ído̱ nigúun xa̱bo̱ tsí ni̱gi̱mbíin, a̱ꞌkhue̱n phú mbaꞌiin xa̱bo̱ judío̱ jamí tsí ni̱rtaxe̱-mijná rí ma̱nindxu̱ún xa̱bo̱ judío̱ nigóó tsu̱du̱u̱ Páblo̱ ga̱jma̱á Bernabé. Xómáꞌ ikhii̱n nithán-múꞌúu̱n rí mu̱xúni̱ꞌñáa̱-ranimbúu̱n juyáa̱ rí máján najanúu̱ eꞌne Ana̱ꞌlóꞌ.<verse eid="ACT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />Ído̱ ni̱ga̱nú i̱mba̱ mbiꞌi rí nduya̱a xu̱únꞌ xa̱bo̱, i̱tha̱án ma̱ꞌne mbá xúgíin xa̱bo̱ xuajen ni̱gi̱mbúun kajngó mu̱dxawíín ajngóo Ana̱ꞌlóꞌ. <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />Ído̱ ndiyáá xa̱bo̱ judío̱ rí phú mbaꞌiin xa̱bo̱ ni̱gi̱mbúun, a̱ꞌkhue̱n phú nixígúu̱n, jamí ni̱gíꞌdíi̱n nuthee̱n rí ra̱gákon rí naꞌthán Páblo̱ jamí nuthan-xkawíi̱ꞌ. <verse eid="ACT 13:45" /><verse number="46" style="v" sid="ACT 13:46" />A̱ꞌkhue̱n Páblo̱ ga̱jma̱á Bernabé támíñúu̱ juñúu̱ jamí ni̱riꞌñúu̱: «Gakon máꞌ rí ikháanꞌlaꞌ ginii ndiꞌyóo rí mi̱ꞌthánlaꞌ ajngóo Ana̱ꞌlóꞌ. I̱ndo̱ó máꞌ numuu rí ikháanꞌlaꞌ tsíyalaꞌ gúdrígú ne̱, jamí na̱ju̱ma̱ꞌlaꞌ rí Ana̱ꞌlóꞌ táraꞌwáanꞌlaꞌ rí ma̱juwalaꞌ jámuu, ikhaa jngó rí xúge̱ꞌ rá, mu̱thu̱únxo̱ꞌ ne̱ xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún. <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />Numuu rí xkuaꞌnii nixná-ñájwanxo̱ꞌ Táta̱ nákhí niꞌthán:</para>
  <para style="q" vid="ACT 13:47">“Ni̱ꞌgíínlo̱ꞌ rí ma̱nindxa̱a̱ꞌ xómá agu</para>
  <para style="q" vid="ACT 13:47">rí nambiꞌñúú xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún,</para>
  <para style="q" vid="ACT 13:47">kajngó ma̱nindxa̱a̱ꞌ tsí naꞌthán rí ikhúúnꞌ ma̱ꞌne-jáwíin xa̱bo̱</para>
  <para style="q" vid="ACT 13:47">asndo ná ndámba̱-ri̱go̱o̱ rawuun numbaa”».<note caller="+" style="f"><char style="fr" closed="false">13.47 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 49.6.</char></note><verse eid="ACT 13:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />Ído̱ ni̱dxawíín ajngáa ríge̱ꞌ xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, phú gagi a̱kuíi̱n neꞌne jamí ni̱gíꞌdíi̱n nithee̱n rí máján ga̱jma̱á numuu ajngóo Táta̱. Xúꞌkhue̱n máꞌ ninimbu̱únꞌ juyáá Jesús mbá xúgíin tsí watraꞌwíin rí ma̱ju̱wá jámuu. <verse eid="ACT 13:48" /><verse number="49" style="v" sid="ACT 13:49" />Jamí nithán-raꞌa ajngóo Táta̱ ná mbá xúgíí numbaa rúꞌkhue̱n. <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />Xómáꞌ xa̱bo̱ judío̱ nithan-mijnée̱ gajmíi̱ go̱ꞌo̱ tsí májíin jamí phú nitiamakúún ene̱ xa̱bo̱, xúꞌkhue̱n máꞌ nithan-mijnée̱ gajmíi̱ tsí ñajúún xa̱bo̱ ede̱ ná xuajen. Ikhiin tsúꞌkhue̱n nene̱-rájíi̱n kajngó mune̱-ngínáa̱ Páblo̱ ga̱jma̱á Bernabé, jamí ni̱ꞌngúu̱n ni̱xkawíi̱n ná awúun mbañúu̱. <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />A̱ꞌkhue̱n ikhii̱n ni̱xprígúu̱ yujnda̱ꞌ nakhúu̱n ná inúú xa̱bo̱ xuajen kajngó mbuyáa̱ rí ra̱máján ini̱i̱. Jamí nigóo̱ ná xuajen rí mbiꞌyuu Ikónio̱. <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />Xómáꞌ tsí nanimbu̱únꞌ juyáá Jesús phú gagi a̱kuíi̱n júwe̱e̱ꞌ, jamí xtáa mbá jayu Xu̱u̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxúu̱n.<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s">Páblo̱ ga̱jma̱á Bernabé nuthan-raꞌa ajngóo Ana̱ꞌlóꞌ ná Ikónio̱</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />Ído̱ Páblo̱ ga̱jma̱á Bernabé niguáꞌníi̱ ná xuajen Ikónio̱, a̱ꞌkhue̱n ni̱tu̱ꞌúu̱n ná guꞌwá rí na̱gi̱mbíin xa̱bo̱ judío̱. Jamí phú mitsaan nithee̱n, ikhaa jngó phú mbaꞌiin xa̱bo̱ judío̱ ninimbu̱únꞌ xúꞌkhue̱n máꞌ xa̱bo̱ griégo̱. <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />Xómáꞌ xa̱bo̱ judío̱ tsí tánimbu̱únꞌ, nene̱-rájíi̱n jamí ni̱sngrúꞌúu̱n xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún kajngó ma̱jiꞌníi̱ juñúu̱ a̱ngia̱nꞌlóꞌ. <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />Maske máꞌ xúꞌkhue̱n, phú mba̱yo̱ꞌ ninguanúu Páblo̱ ga̱jma̱á Bernabé ikhín, jamí ga̱jma̱á mbá jañii a̱kuíi̱n ná inuu Táta̱ támíñúu̱ muthúu̱n xa̱bo̱ rí Ana̱ꞌlóꞌ nandoo jaꞌñúu̱. Xómáꞌ Ana̱ꞌlóꞌ ni̱ka̱-rasngájma rí gakon ajngáa rí nuthee̱n, numuu rí ikhaa̱ nixnúu̱ tsiakhe̱ rí muni̱i̱ rí phú wáá jamí rí phú namakúún xa̱bo̱ eꞌne. <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />Xómáꞌ xa̱bo̱ xuajen ni̱xpi̱ꞌtha̱-mijná: mbá tikhuun júwa̱ꞌ gajmíí xa̱bo̱ judío̱, jamí i̱ꞌwíin júwa̱ꞌ gajmíí tsí nixúngui̱inꞌ Jesús. <verse eid="ACT 14:4" /><verse number="5" style="v" sid="ACT 14:5" />A̱ꞌkhue̱n xa̱bo̱ judío̱ jamí xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, nimbáxúu̱n gajmíi̱ xa̱bo̱ ñajun, kajngó mune̱-ngíníi̱ jamí muxnúu̱ ga̱jma̱á itsí. <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />Ído̱ nidxawuun Páblo̱ ga̱jma̱á Bernabé rúꞌkhue̱n, a̱ꞌkhue̱n nigáñúu̱ nigóo̱ ná Lístra̱ ga̱jma̱á Dérbe̱, xuajen rí triga̱ ná numbaa Likaónia̱, jamí nda̱wa̱á nigóo̱ mbá xúgíí numbaa rí triga̱ mbá nawa̱a̱. <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />Jamí ikhín nuthan-raꞌee̱ ajngáa máján mangaa.<verse eid="ACT 14:7" /></para>
  <para style="s">Páblo̱ nixnáá ga̱jma̱á itsí ná Lístra̱</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />Jamí ná xuajen Lístra̱ xtáa mbáa xa̱bo̱ tsí nixtriga̱a̱, réngui̱i̱ asndo nákhí máꞌ ni̱gu̱maa̱, jamí nimbá miꞌtsú tángrigo̱o̱ ga̱jma̱á nakhúu̱. <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />Ikhaa tsúꞌkhue̱n ꞌgí nadxawuun rí naꞌthán Páblo̱. Jamí Páblo̱ niraꞌa̱ mújúun inuu̱, a̱ꞌkhue̱n ndiꞌyoo̱ rí wéje̱ a̱kuii̱n ná inuu Ana̱ꞌlóꞌ kajngó ma̱ꞌni̱i a̱kuii̱n. <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />A̱ꞌkhue̱n Páblo̱ mbá gakhe̱ niꞌthúu̱n: «Ariajún jmbu ga̱jma̱á nakhuáaꞌ». A̱ꞌkhue̱n ikhaa̱ asndo na̱ki̱xi̱i̱ ni̱tu̱xu̱u̱ꞌ, jamí nigíꞌdu̱u̱n ningrigo̱o̱ꞌ.<verse eid="ACT 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 14:11" />Ído̱ ndiyáá xa̱bo̱ rí neꞌne Páblo̱, a̱ꞌkhue̱n ni̱ndxa̱ꞌwe̱e̱ jamí nithee̱n ga̱jma̱á ajngáa rí nuthan xa̱bo̱ ná Likaónia̱: «¡Ana̱ꞌlóꞌ tsí xómá xa̱bo̱ numbaa jaꞌñúú niguátaan gúyalóꞌ!». <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />A̱ꞌkhue̱n tsí Bernabé nuxna-mbiꞌíi̱ Júpi̱te̱r, xómáꞌ Páblo̱ nuxna-mbiꞌíi̱ Merkúrio̱,<note caller="+" style="f"><char style="fr" closed="false">14.12 </char><char style="ft" closed="false">Júpi̱te̱r jamí Merkúrio̱ neꞌne mbiꞌñúú ná ajngáa latíín tsí nune̱-mbi̱in xa̱bo̱ griégo̱. Ná ajngáa griégo̱ mbiꞌñúu̱ Zeus jamí Hermes.</char></note> numuu rí ikhaa̱ ñajuu̱n tsí naꞌthúún xa̱bo̱. <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />Xómáꞌ dxakuiin Júpi̱te̱r, tsí ꞌgí guꞌwá dxákuiin ná rawuun xuajen, ni̱ꞌkha̱ jaguu̱n xede̱ jamí re̱ꞌe̱ ikhín. Ikhaa̱ gajmíi̱ xa̱bo̱ tsí mbaꞌiin, nandoo̱ maxnáxii̱n xu̱kú tsí nijáñúú ná inuu Bernabé ga̱jma̱á Páblo̱.<verse eid="ACT 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14" />Ído̱ ni̱dxawíín ríge̱ꞌ tsí nixúngui̱inꞌ Jesús, Bernabé ga̱jma̱á Páblo̱, ni̱ru̱thii̱n xtíñúu̱ numuu rí phú ra̱máján ene̱ xa̱bo̱ iyáa̱. A̱ꞌkhue̱n nigóo̱-ragáñúu̱ ná majñu̱ú xa̱bo̱ tsí mbaꞌiin jamí ni̱ndxa̱ꞌwe̱e̱: <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />«¡Xa̱bo̱ buanuu, náá numuu kajngó nu̱ne̱laꞌ rúꞌkhue̱n róꞌ! Ikháanꞌ mangáanꞌxo̱ꞌ ñajwanxo̱ꞌ xa̱bo̱ numbaa xómá ikháanꞌlaꞌ, jamí nu̱tha̱n-ráꞌalaꞌxo̱ꞌ rí gu̱ni̱ꞌñáá-ru̱ne̱laꞌ ríge̱ꞌ, rí nda̱a̱ mbá jayu numuu, jamí ga̱thanga̱ánꞌlaꞌ ná inuu Ana̱ꞌlóꞌ tsí ndaꞌya, tsí neꞌne-ku̱maa mikhu ga̱jma̱á ju̱ba̱ꞌ, iya a̱pha̱, jamí mbá xúgíí rí ríga̱ ná awúun ne̱. <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />Rí nákhí wajyúú Ana̱ꞌlóꞌ niniñúú mbá xúgíin xa̱bo̱ rí guni̱i̱ mbá xúgíí máꞌ rí nandúu̱n ikhii̱n. <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />Maske máꞌ xúꞌkhue̱n, tániñuu̱-rasngájma-mine̱e̱ꞌ ga̱jma̱á majñu̱u̱ rí máján naꞌnii̱. Naxnálóꞌ mbiꞌi rí na̱ꞌkha̱ ruꞌwa jamí naxnálóꞌ mbiꞌi rí mu̱gímbúulóꞌ rí nijma̱a̱. Xkuaꞌnii naꞌne-matíi̱ ganitsu rí mu̱ꞌpholóꞌ, jamí naꞌne-gagii̱ a̱kia̱nꞌlóꞌ». <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />Maske máꞌ nithúu̱n xa̱bo̱ mbá xúgíí rúꞌkhue̱n, ga̱jma̱á kháan niwajún-ꞌthúu̱n kajngó mu̱xúxna̱xíi̱n xu̱kú tsí nijáñúú ná inúu̱.<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />A̱ꞌkhue̱n niguáꞌnú mbá tikhuun xa̱bo̱ judío̱ tsí naguwá ná Antiokía̱ jamí ná Ikónio̱. Ikhiin tsúꞌkhue̱n nene̱-rájíi̱n xa̱bo̱ tsí mbaꞌiin rí muxnáa̱ Páblo̱ ga̱jma̱á itsí. A̱ꞌkhue̱n ni̱xma̱taa̱, ni̱ríya̱a̱ꞌ asndo ná rawuun xuajen, numuu rí ni̱ju̱múu̱ rí nijáñuu̱. <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />I̱ndo̱ó máꞌ numuu rí mbá nawa̱a̱ niwájun tsí nanimbu̱únꞌ juyáá Jesús ná kri̱ga̱a̱ Páblo̱, a̱ꞌkhue̱n ni̱tu̱xii̱ jamí ni̱ta̱ꞌaa̱ ná xuajen. Jamí i̱mba̱ mbiꞌi nigájnuu̱ ni̱ke̱e̱ ga̱jmáa̱ Bernabé ná xuajen Dérbe̱.<verse eid="ACT 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />Nithan-raꞌee̱ máꞌ ajngáa máján ná xuajen rúꞌkhue̱n mangaa, jamí phú mbaꞌiin xa̱bo̱ ninimbu̱únꞌ juyáá Jesús. Nda̱wa̱á a̱ꞌkhue̱n nithangii̱n ná xuajen Lístra̱, ná Ikónio̱ xúꞌkhue̱n máꞌ ná Antiokía̱. <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />Ikhín nixnaa̱ la tsiakhe̱ tsí nanimbu̱únꞌ juyáá Jesús, nithán-múꞌúu̱n rí mu̱xúni̱ꞌñáa̱-ranimbúu̱n juyáa̱. Jamí nithúu̱n: «Ndaꞌyóo rí ma̱nújngalóꞌ ná majñu̱u̱ mbaꞌa jamínu̱ꞌ kajngó ma̱nindxaꞌlóꞌ xa̱bo̱ tsí naꞌthán-ñájúún Ana̱ꞌlóꞌ». <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />Jamí ni̱strigii̱n xa̱bo̱ buanuu tsí mbuya̱ idxu̱u̱ mbámbá ná júwa̱ꞌ tsí nanimbu̱únꞌ juyáá Jesús. Ído̱ wámbúu̱n nithán-jáñíi̱ Ana̱ꞌlóꞌ jamí nene̱-miꞌkhíi̱, a̱ꞌkhue̱n ni̱xna̱xíi̱n ná ñawúun Táta̱ tsí ninimbúu̱n juyáa̱.<verse eid="ACT 14:23" /></para>
  <para style="s">Páblo̱ ga̱jma̱á Bernabé nathangi̱in ná Antiokía̱ mbayuu Síria̱</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24" />Ído̱ ni̱gíꞌmaa̱ jambúu̱n, a̱ꞌkhue̱n ninújngúu̱n ná mbayuu Pisídia̱, jamí niguáꞌníi̱ ná mbayuu Panfília̱. <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />Jamí ído̱ wámbúu̱n nithan-raꞌee̱ ajngóo Ana̱ꞌlóꞌ ná xuajen Pérje̱, a̱ꞌkhue̱n niguátaa̱n ná xuajen Atália̱. <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />Ikhín ni̱tu̱ꞌúu̱n ná awúun guꞌwá-rguwa jamí nigúu̱n ná Antiokía̱, ná nigájnúu̱ nákhí waxnáxii̱n ná ñawúun Ana̱ꞌlóꞌ kajngó magóo̱ gúni̱i̱ ñajun rí wámbúu̱n máꞌ nene̱-mbáníi̱ xúge̱ꞌ. <verse eid="ACT 14:26" /><verse number="27" style="v" sid="ACT 14:27" />Ído̱ niguáꞌnúu̱, a̱ꞌkhue̱n ni̱ru̱wii̱n la tsí nanimbu̱únꞌ juyáá Jesús, jamí nithúu̱n mbá xúgíí rí neꞌne Ana̱ꞌlóꞌ ga̱jma̱á nindxúu̱n ikhii̱n. Xúꞌkhue̱n máꞌ nithúu̱n rí Ana̱ꞌlóꞌ nirmáꞌthoo kajngó xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún ma̱goo ma̱nimbu̱únꞌ juyáá Ana̱ꞌlóꞌ. <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />Jamí phú mba̱yo̱ꞌ ninguanúu̱ ikhín gajmíi̱ tsí nanimbu̱únꞌ juyáá Jesús.<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s">Na̱gi̱mbíin xa̱bo̱ buanuu ede̱ ná Jerusalén</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />A̱ꞌkhue̱n mbá tikhuun xa̱bo̱ tsí naguwá ná Judéa̱ nusngúu̱n a̱ngia̱nꞌlóꞌ xáꞌnii: «Xí tsíya̱laꞌ tsina jndi xómá naꞌthán ná xtángawoo Moisés, ma̱xáxóo ma̱jríñáaꞌlaꞌ». <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />A̱ꞌkhue̱n Páblo̱ ga̱jma̱á Bernabé phú mba̱a̱ ajngáa niguáꞌdáa̱ ga̱jma̱á nindxu̱ún xa̱bo̱ tsúꞌkhue̱n. Ikhaa jngó nimbánuu rí Páblo̱ ga̱jma̱á Bernabé magóo̱ ná Jerusalén, gajmíi̱ i̱ꞌwíin tsí nanimbu̱únꞌ juyáá Jesús, magóo̱ gúñúu̱ tsí nixúngui̱inꞌ Jesús jamí xa̱bo̱ buanuu tsí juya̱ idxu̱u̱ ikhín, kajngó muthan-mijnée̱ ga̱jma̱á numuu ajngáa rúꞌkhue̱n. <verse eid="ACT 15:2" /><verse number="3" style="v" sid="ACT 15:3" />Ikhaa jngó waxúꞌmii̱ nene̱ tsí nanimbu̱únꞌ juyáá Jesús ná Antiokía̱. Ído̱ ninújngúu̱n ná numbaa Fenísia̱ ga̱jma̱á numbaa Samária̱, nithee̱n xáne nithangi̱in xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún ná inuu Ana̱ꞌlóꞌ. Jamí mbá xúgíin a̱ngia̱nꞌlóꞌ phú gagi a̱kuíi̱n neꞌne ído̱ ni̱dxawíi̱n ajngáa rúꞌkhue̱n. <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />Ído̱ niguáꞌníi̱ ná Jerusalén, a̱ꞌkhue̱n wa̱tri̱gúu̱n nene̱ tsí nanimbu̱únꞌ juyáá Jesús, xúꞌkhue̱n máꞌ tsí nixúngui̱inꞌ Jesús, jamí xa̱bo̱ buanuu tsí juya̱ idxu̱u̱. A̱ꞌkhue̱n Páblo̱ ga̱jma̱á Bernabé nithee̱n mbá xúgíí rí neꞌne Ana̱ꞌlóꞌ ga̱jma̱á majñúu̱ ikhii̱n. <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />I̱ndo̱ó máꞌ numuu rí mbá tikhuun tsí ninimbu̱únꞌ juyáá Jesús, ikhiin tsí ninindxu̱ún a̱ngui̱ín xa̱bo̱ fariséo̱, ni̱tu̱xúu̱n jamí nithee̱n: «Ndaꞌyóo rí xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, tsí nathangi̱in ná inuu Ana̱ꞌlóꞌ, mbuye̱e̱ tsina jndi jamí mi̱ꞌxná-ñájúu̱n rí mune̱-mbáníi̱ xtángawoo Moisés».<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />A̱ꞌkhue̱n nimbáxi̱in tsí nixúngui̱inꞌ Jesús gajmíí xa̱bo̱ buanuu tsí juya̱ idxu̱u̱ kajngó muthan-mijnée̱ ga̱jma̱á numuu rúꞌkhue̱n. <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />Jamí ído̱ neꞌne mba̱yo̱ꞌ guéño máꞌ rí nuthan-mijnée̱ ga̱jma̱á numuu rúꞌkhue̱n, a̱ꞌkhue̱n ni̱tu̱xu̱u̱ꞌ Pédro̱ jamí niꞌthúu̱n: «Xa̱bo̱ buanuu a̱ngui̱nꞌ, ikháanꞌlaꞌ ndu̱ya̱á máꞌ rí nákhí neꞌne máwáa, Ana̱ꞌlóꞌ niraꞌwúún kajngó ma̱thu̱ún ajngáa máján xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, kajngó ma̱nimbúu̱n juyáa̱ Ana̱ꞌlóꞌ. <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />Jamí Ana̱ꞌlóꞌ, tsí naꞌne-nuwiin a̱kui̱ín xa̱bo̱ numbaa, nisngájmee̱ rí na̱grui̱gúu̱n nákhí nixnúu̱ Xu̱u̱ꞌ xómá rí nixniálóꞌ ikháánꞌlóꞌ. <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />Jamí nda̱a̱ nimbá rí mixtiꞌkhu neꞌne Ana̱ꞌlóꞌ ga̱jma̱á numúu̱ ikhii̱n ga̱jma̱á ikháánꞌlóꞌ, numuu neꞌne-jaꞌwuu̱ a̱kui̱ín ído̱ rí ninimbúu̱n juyáa̱ ikhaa̱. <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />Ikhaa jngó xúge̱ꞌ rá, náá numuu kajngó nu̱jmaalaꞌ Ana̱ꞌlóꞌ, nu̱rígulaꞌ mbá eꞌda rí ji̱ñu̱u̱ ná tsu̱du̱ún tsí nanimbu̱únꞌ juyáá Jesús róꞌ. Asndo ni máꞌ táta̱-xi̱ꞌñálóꞌ wajyúú táꞌgu̱ún gágóó juñu̱ú rúꞌkhue̱n, ni máꞌ ikháánꞌlóꞌ táꞌnga̱ꞌlóꞌ gúꞌgua̱ juꞌyálóꞌ ne̱. <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />A̱ꞌkhue̱n gakon, ikháánꞌlóꞌ nanimba̱ꞌlóꞌ rí najríñáaꞌlóꞌ ga̱jma̱á numuu rí phú nandoo Táta̱ Jesús jaꞌyalóꞌ, xúꞌkhue̱n máꞌ ikhii̱n mangii̱n».<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />A̱ꞌkhue̱n mbá xúgíin xa̱bo̱ tsí mbaꞌiin neꞌne-wíyuu rawúún, jamí ni̱dxawíi̱n rí naꞌthán Bernabé ga̱jma̱á Páblo̱. Nuthee̱n rí phú wáá jamí nimakúún xa̱bo̱ neꞌne Ana̱ꞌlóꞌ ga̱jma̱á nindxúu̱n ikhii̱n ná majñu̱ú xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún. <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />Jamí ído̱ wámbúu̱n nithee̱n, a̱ꞌkhue̱n niꞌthán Santiágo̱:<note caller="+" style="f"><char style="fr" closed="false">15.13 </char><char style="ft" closed="false">Ná i̱yi̱i̱ꞌ griégo̱ rí wayuu naꞌthán «Jakóbo̱», rí nithán «Santiágo̱» ná ajngáa xtílo̱o̱.</char></note> «Xa̱bo̱ buanuu a̱ngui̱nꞌ, gu̱dxawíínlaꞌ rí ma̱tha̱nꞌlaꞌ. <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />Simón<note caller="+" style="f"><char style="fr" closed="false">15.14 </char><char style="ft" closed="false">Simón ñajuun i̱mba̱ mbiꞌyuu Pédro̱.</char></note> niꞌthánlóꞌ máꞌ rí asndo nákhí ginii, Ana̱ꞌlóꞌ nisngájma rí nandoo jaꞌñúú xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, jamí niraꞌwíi̱n mangii̱n kajngó ma̱nindxúu̱n xa̱bo̱ xuajñuu̱ tsí nune̱-mba̱a̱ ikhaa̱. <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />Jamí ikhaa ríge̱ꞌ naꞌkho̱-mina̱aꞌ ga̱jma̱á rí nithan xa̱bo̱ tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ wajyúú, xómá ka̱ma naꞌthán:<verse eid="ACT 15:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ACT 15:16" />“Ído̱ gánújngoo ríge̱ꞌ ma̱thangu̱únlo̱ꞌ</para>
  <para style="q" vid="ACT 15:16">jamí ma̱ne̱ rí ma̱gua̱xúun xa̱bo̱ guꞌwóo Dabíd, tsí ningáxi̱in mbayíí.</para>
  <para style="q" vid="ACT 15:16">Ma̱ni̱i guꞌwóo̱ rí ningudi-ri̱ga̱a la,</para>
  <para style="q" vid="ACT 15:16">Jamí ma̱ku̱xíi ne̱ mbu̱júꞌ.<verse eid="ACT 15:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ACT 15:17" />Ikhaa jngó tsí i̱ꞌwíin xa̱bo̱ mbuꞌyáa Táta̱,</para>
  <para style="q" vid="ACT 15:17">jamí mbá xúgíin xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún,</para>
  <para style="q" vid="ACT 15:17">tsí nu̱xri̱ga̱á mbiꞌyuꞌ.<verse eid="ACT 15:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ACT 15:18" />Xkuaꞌnii iꞌthán Táta̱, tsí nasngájma mbá xúgíí ríge̱ꞌ</para>
  <para style="q" vid="ACT 15:18">asndo nákhí máꞌ wajyúú mbiꞌi”.<note caller="+" style="f"><char style="fr" closed="false">15.18 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Amós 9.11-12.</char></note><verse eid="ACT 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />Ikhaa jngó, ikhúúnꞌ na̱tha̱nlo̱ꞌ rí mu̱xúꞌñu̱úlóꞌ ga̱jma̱á tsiakhe̱ rí mune̱-mbáníí xtángoo xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, tsí nathangi̱in ná inuu Ana̱ꞌlóꞌ. <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />I̱ndo̱ó máꞌ gu̱ꞌtháánlóꞌ mbá i̱yi̱i̱ꞌ mu̱xu̱ꞌmálóꞌ inúu̱, ná nuꞌthúu̱nlóꞌ ríge̱ꞌ: rí gune̱-janíí-mijnée̱ inuu rí waxnáxe̱ ná inúú tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún, rí mu̱xúbúu̱n gajmíi̱ xa̱bo̱ tsí túya̱a̱, rí mu̱xúphi̱i̱ xuñúú xu̱kú tsí nixngáwúun, ni máꞌ mu̱xúphi̱i̱ iꞌdi. <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />Numuu rí asndo nákhí máꞌ wajyúú mbiꞌi júwa̱ꞌ ná mbámbá xuajen tsí nusngáá xtángawoo Moisés ná awúun mbámbá guꞌwá rí na̱gi̱mbíin xa̱bo̱ judío̱, jamí na̱gi̱ꞌxnuu ne̱ mbámbá mbiꞌi rí nduya̱a xu̱únꞌ xa̱bo̱».<verse eid="ACT 15:21" /></para>
  <para style="s">I̱yi̱i̱ꞌ rí nene̱ xa̱bo̱ buanuu ná Jerusalén</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />A̱ꞌkhue̱n tsí nixúngui̱inꞌ Jesús gajmíí xa̱bo̱ buanuu, xúꞌkhue̱n máꞌ mbá xúgíin tsí nanimbu̱únꞌ juyáá Jesús, niguáꞌdáa̱ awan rí mu̱raꞌwíi̱n mbá tikhuun tsí ikhii̱n, jamí mu̱xu̱ꞌmii̱ magóo̱ ná Antiokía̱ ga̱jma̱á nindxu̱u̱ Páblo̱ jamí Bernabé. A̱ꞌkhue̱n ni̱raꞌwíi̱ Júda̱s, tsí nutháa̱n Barsabás, jamí Síla̱s, tsí phú nitiamakúún ná majñu̱ú a̱ngia̱nꞌlóꞌ. <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />Jamí nijanúu̱ mbá i̱yi̱i̱ꞌ rí mbuye̱e̱ magóo̱ rí naꞌthán xáꞌnii:</para>
  <para style="p" vid="ACT 15:23">«Ikháanꞌxo̱ꞌ, tsáanꞌ ñajwanxo̱ꞌ tsí nixúngui̱inꞌ Jesús, gajmiáxo̱ꞌ xa̱bo̱ buanuu jamí mbá xúgíin a̱ngia̱nꞌlóꞌ, nu̱xu̱ꞌmáxo̱ꞌ i̱yi̱i̱ꞌ ríge̱ꞌ inalaꞌ ikháanꞌlaꞌ, tsáanꞌ ñajwanlaꞌ a̱ngia̱nꞌxo̱ꞌ tsí ra̱ꞌkháa xa̱bo̱ judío̱ ñajúún, tsáanꞌ juwalaꞌ ná Antiokía̱, ga̱jma̱á Síria̱ jamí Silísia̱. Nu̱ra̱xáanꞌlaꞌxo̱ꞌ.<verse eid="ACT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 15:24" />»Ni̱dxawíínxo̱ꞌ rí nigájnúú mbá tikhuun xa̱bo̱ ná majña̱ꞌxo̱ꞌ ge̱jyoꞌ, tsí túxna̱-ñájúúnxo̱ꞌ rí magóó. Ikhiin tsúꞌkhue̱n nuxnalaꞌ gaꞌkho̱ ga̱jma̱á ajngáa rí nuthanlaꞌ, jamí nune̱-ngra̱ꞌáa̱nꞌlaꞌ, numuu rí nuxna-ñajwanlaꞌ rí mbu̱ya̱laꞌ tsina jndi jamí mu̱ne̱-mbáníílaꞌ rí naꞌthán xtángawoo Moisés.<note caller="+" style="f"><char style="fr" closed="false">15.24 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná tsíꞌkha̱ ajngáa ríge̱ꞌ: «numuu rí nuxna-ñajwanlaꞌ rí mbu̱ya̱laꞌ tsina jndi jamí mu̱ne̱-mbáníílaꞌ rí naꞌthán xtángawoo Moisés».</char></note> <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />Ikhaa jngó niguáꞌdááxo̱ꞌ awan, rí mu̱raꞌwíinxo̱ꞌ xa̱bo̱ buanuu jamí mu̱xu̱ꞌmíi̱xo̱ꞌ magóo̱ inalaꞌ ga̱jma̱á nindxu̱u̱ dxájwalóꞌ Bernabé jamí Páblo̱. <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />A̱ngia̱nꞌlóꞌ tsúꞌkhue̱n asndo ngamí ma̱ja̱ñúu̱ ga̱jma̱á numuu rí nuni̱i̱ ñajuun Táta̱ Jesukrísto̱. <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />Ikhaa jngó nu̱xu̱ꞌmáaxo̱ꞌ Júda̱s ga̱jma̱á Síla̱s. Ikhii̱n mangii̱n muthanlaꞌ ikhaa máꞌ rí nu̱tha̱nxo̱ꞌ ge̱jyoꞌ.<verse eid="ACT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 15:28" />»Numuu rí máján máꞌ iꞌyoo Xu̱u̱ꞌ Ana̱ꞌlóꞌ, jamí xúꞌkhue̱n máꞌ i̱ya̱á mangáanꞌxo̱ꞌ, rí mu̱xúríguxo̱ꞌ nimbá eꞌda rí ji̱ñu̱u̱ ná tsu̱da̱ꞌlaꞌ. I̱ndo̱ó máꞌ ríge̱ꞌ ñajuun rí ndaꞌyóo mu̱ne̱laꞌ: <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />gu̱ne̱-janíí-mijnálaꞌ inuu rí waxnáxe̱ ná inúú tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún, mu̱xúpholaꞌ iꞌdi, ni máꞌ mu̱xúpholaꞌ xuñúú xu̱kú tsí nixngáwúun, jamí mu̱xúba̱ꞌ gajmiálaꞌ xa̱bo̱ tsí túya̱a̱laꞌ. Xí nu̱ña̱wa̱n-mijnálaꞌ rí mu̱xúne̱laꞌ rúꞌkhue̱n, máján máꞌ e̱ne̱laꞌ xúꞌkhue̱n rá. A̱juwa májánlaꞌ».<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />Ikhaa jngó ikhiin tsí waxúngui̱inꞌ nigóó ná xuajen Antiokía̱. Jamí ído̱ niguáꞌníi̱ ni̱ru̱wii̱n tsí nambáxi̱in ikhín, a̱ꞌkhue̱n ni̱xna̱xíi̱ i̱yi̱i̱ꞌ rí juye̱e̱. <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />Ído̱ wámbu̱ún a̱ngia̱nꞌlóꞌ ni̱raxnuu ne̱, a̱ꞌkhue̱n phú gagi a̱kuíi̱n neꞌne ga̱jma̱á numuu ajngáa tsiakhe̱ rí naꞌthán ne̱.<verse eid="ACT 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 15:32" />Xómáꞌ Júda̱s ga̱jma̱á Síla̱s, nithán-múꞌúu̱n guéño a̱ngia̱nꞌlóꞌ jamí nixnaa̱ la tsiakhe̱, numuu rí xa̱bo̱ tsí nu̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ ñajúu̱n mangii̱n. <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />Jamí ído̱ neꞌne mba̱yo̱ꞌ máꞌ rí júwe̱e̱ꞌ ikhín, a̱ꞌkhue̱n waꞌthán-ngawúu̱n ga̱jma̱á gagi nene̱ a̱ngia̱nꞌlóꞌ, kajngó ma̱thangii̱n ná inúú tsí waxúguii̱nꞌ nene̱. <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />Xómáꞌ Síla̱s ndiyoo rí ma̱nguanúu ikhín.<note caller="+" style="f"><char style="fr" closed="false">15.34 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa rí na̱ꞌkha̱ ná kíxnuu 34.</char></note> <verse eid="ACT 15:34" /><verse number="35" style="v" sid="ACT 15:35" />Jamí Páblo̱ ga̱jma̱á Bernabé ninguanúu̱ ná Antiokía̱. Ikhii̱n gajmíi̱ mbaꞌiin i̱ꞌwíin a̱ngia̱nꞌlóꞌ nisngáa̱ ajngóo Táta̱ jamí nithan-raꞌee̱ ajngáa máján.<verse eid="ACT 15:35" /></para>
  <para style="s">Páblo̱ naniñuu Bernabé, jamí nagájnuu̱ rí riajma̱ miꞌtsú jayóo̱ ajngóo Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />Nda̱wa̱á ído̱ ninújngoo mbá wátha̱ wáa mbiꞌi, a̱ꞌkhue̱n Páblo̱ niꞌthúun Bernabé: «Ga̱thanga̱ánꞌlóꞌ mu̱ꞌgua̱ gúꞌñúú a̱ngia̱nꞌlóꞌ mbá xúgíí xuajen ná niꞌthán-raꞌalóꞌ ajngóo Táta̱, kajngó mbu̱ꞌyáálóꞌ xáne júwe̱e̱ꞌ». <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />Jamí Bernabé nandoo rí ma̱ꞌga Juáán ga̱jma̱á nindxúu̱n, tsí nutháa̱n Márko̱s. <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />Xómáꞌ Páblo̱ táꞌne májáan a̱kuii̱n rí ma̱ꞌga ga̱jma̱á nindxúu̱n, numuu rí Márko̱s niniñúu̱ asndo ná numbaa Panfília̱, jamí táꞌgee̱ ga̱jma̱á nindxúu̱n ná ñajun rí nuni̱i̱. <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />Jamí Páblo̱ ga̱jma̱á Bernabé ra̱khóo mbá jayu gáwaꞌdáa̱ awan, rúꞌkhue̱n neꞌne rí mu̱ni̱ꞌñá-mijnée̱. A̱ꞌkhue̱n Bernabé ni̱ka̱ ga̱jma̱á Márko̱s, nijngúu̱n ná awúun guꞌwá-rguwa, nigóo̱ ná Chípre̱. <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />Xómáꞌ Páblo̱, niraꞌwíi̱ Síla̱s kajngó ma̱ꞌga ga̱jma̱á nindxu̱u̱. A̱ꞌkhue̱n a̱ngia̱nꞌlóꞌ ni̱xna̱xíi̱n ná ñawúun Táta̱, jamí nigájnúu̱ nigóo̱. <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />A̱ꞌkhue̱n Páblo̱ ga̱jma̱á Síla̱s ninújngúu̱n ná numbaa Síria̱ ga̱jma̱á Silísia̱, jamí nuxnaa̱ la tsiakhe̱ a̱kui̱ín mbámbá kuthuun tsí nanimbu̱únꞌ juyáá Jesús.<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s">Timotéo̱ na̱ka̱ ga̱jma̱á Páblo̱ jamí Síla̱s</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />Nda̱wa̱á ni̱ga̱nú Páblo̱ ná xuajen Dérbe̱, jamí ná Lístra̱. Ikhín xtáa mbáa tsí nanimbo̱o̱ꞌ jaꞌyoo Jesús tsí mbiꞌyuu Timotéo̱, a̱dée mbáa a̱ꞌgo̱ judío̱ tsí nanimbo̱o̱ꞌ jaꞌyoo Ana̱ꞌlóꞌ, xómáꞌ anu̱u̱ ñajuun mbáa xa̱bo̱ griégo̱. <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />Jamí máján ithan a̱ngia̱nꞌlóꞌ tsí júwa̱ꞌ ná xuajen Lístra̱ jamí ná Ikónio̱ ga̱jma̱á numuu Timotéo̱. <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />Xómáꞌ Páblo̱ nandoo rí ma̱ꞌga Timotéo̱ ga̱jma̱á nindxu̱u̱, ikhaa jngó nixnúu̱ tsina jndi. Niꞌnii̱ rúꞌkhue̱n ga̱jma̱á numúú xa̱bo̱ judío̱ tsí júwa̱ꞌ ikhín, numuu rí mbá xúgíi̱n nduyáa̱ rí mbáa xa̱bo̱ griégo̱ ñajuun anu̱u̱. <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />Jamí mbá xúgíí xuajen ná nagóo̱-ranújngúu̱n, nuthúu̱n a̱ngia̱nꞌlóꞌ awan rí niguáꞌdáá tsí nixúngui̱inꞌ Jesús gajmíí xa̱bo̱ buanuu ná Jerusalén, kajngó mune̱-mbáníi̱ ne̱. <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />Ikhaa jngó, mbámbá kuthuun tsí nanimbu̱únꞌ juyáá Jesús, nduye̱e̱ tsiakhe̱ rí nanimbúu̱n juyáa̱ ikhaa̱, jamí mbámbá mbiꞌi na̱ka̱-raꞌne mbaꞌii̱n.<verse eid="ACT 16:5" /></para>
  <para style="s">Páblo̱ ndaꞌyoo inu-mbiꞌíí mbáa xa̱bo̱ Masedónia̱</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />A̱ꞌkhue̱n ninújngúu̱n ná numbaa Fríjia̱ jamí numbaa Galásia̱, numuu rí Xu̱u̱ꞌ Ana̱ꞌlóꞌ tániñúu̱ rí muthan-raꞌee̱ ajngóo Ana̱ꞌlóꞌ ná Ásia̱. <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />Jamí ído̱ niguáꞌníi̱ ná numbaa Mísia̱, a̱ꞌkhue̱n nini̱i̱ magóo̱ ná numbaa Bitínia̱, xómáꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ<note caller="+" style="f"><char style="fr" closed="false">16.7 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «Xu̱u̱ꞌ Jesús».</char></note> tániñúu̱ rí magóo̱ ikhín. <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />Ikhaa jngó ni̱ni̱ñáa̱ꞌ numbaa Mísia̱, a̱ꞌkhue̱n niguátaa̱n ná xuajen Tróa̱s. <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />Jamí mbroꞌon máꞌ rúꞌkhue̱n Páblo̱ ndiꞌyoo inu-mbiꞌíí mbáa xa̱bo̱ Masedónia̱ tsí wéje̱ naꞌthán-jáñuu̱ xáꞌnii: «Aya̱ ná Masedónia̱ jamí atambáyáxo̱ꞌ». <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />Ído̱ Páblo̱ ndiꞌyoo inu-mbiꞌíí rúꞌkhue̱n, a̱ꞌkhue̱n mbá nacha̱ máꞌ ne̱ne̱-mbánu-mijnáxo̱ꞌ kajngó mu̱ꞌguáxo̱ꞌ ná numbaa Masedónia̱, numuu naꞌne jañii a̱kia̱nꞌxo̱ꞌ rí Ana̱ꞌlóꞌ nandxaꞌwáxo̱ꞌ ikhín kajngó mu̱tha̱n-ráꞌaxo̱ꞌ ajngáa máján.<verse eid="ACT 16:10" /></para>
  <para style="s">Páblo̱ gajmíí a̱ngui̱in nagóó géjwa̱nꞌ ná Filípo̱s</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />Nitsimaxo̱ꞌ guꞌwá-rguwa rí nagájnuu ná xuajen Tróa̱s, jamí nikuá-jmbaxo̱ꞌ ná Samotrásia̱. Jamí i̱mba̱ mbiꞌi nikuáxo̱ꞌ ná xuajen Neápo̱li̱s. <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />Ikhín nigájnaxo̱ꞌ nikuáxo̱ꞌ ná xuajen Filípo̱s. Xuajen rúꞌkhue̱n phú gíꞌdoo numuu ná numbaa Masedónia̱, jamí mbá xuajñúú xa̱bo̱ Róma̱ ñajuun ne̱. Jamí nijuwaxo̱ꞌ mbá wátha̱ wáa mbiꞌi ná xuajen rúꞌkhue̱n.<verse eid="ACT 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 16:13" />Mbá mbiꞌi rí nduya̱a xu̱únꞌ xa̱bo̱, nigájnaxo̱ꞌ ná rawuun xuajen, jamí nikuáxo̱ꞌ ná rawuun matha, ná nuthán-jáñíí xa̱bo̱ Ana̱ꞌlóꞌ. A̱ꞌkhue̱n nitrigáanꞌxo̱ꞌ ni̱ndxákuun gajmiáxo̱ꞌ go̱ꞌo̱ tsí ni̱gi̱mbíin ikhín. <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />Ikhín ꞌgí nadxawuun mbáa a̱ꞌgo̱ mbiꞌyuu Lídia̱, tsí na̱ngu̱jwa̱ xtíin rí maña̱ꞌ skuni. Ikhaa̱ na̱ꞌkhe̱e̱ ná xuajen Tiatíra̱, jamí naꞌne-mba̱a̱ jayu Ana̱ꞌlóꞌ. Xómáꞌ Ana̱ꞌlóꞌ nirmáꞌthoo a̱kuii̱n kajngó maꞌgíi̱ idxu̱u̱ rí naꞌthán Páblo̱. <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />A̱ꞌkhue̱n ikhaa̱ waxúꞌdu-maꞌáa̱n ná awúun iya gajmíi̱ xa̱bo̱ guꞌwóo̱, jamí nda̱wa̱á niꞌthán-jáñaxo̱ꞌ: «Xí ikháanꞌlaꞌ na̱ju̱ma̱ꞌlaꞌ rí gakon rí nanimbo̱ꞌ ja̱yo̱o̱ Táta̱, ga̱nújngalaꞌ ná guꞌwóꞌ, jamí ga̱wajúnlaꞌ ikhín». Xkuaꞌnii ni̱ꞌngo̱o̱ neꞌne-rájáanꞌxo̱ꞌ, jamí niwajúnxo̱ꞌ ná guꞌwóo̱.<verse eid="ACT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />Mbá mbiꞌi rí nakuáxo̱ꞌ gútha̱n-jáñíí Ana̱ꞌlóꞌ, a̱ꞌkhue̱n ni̱ga̱ti̱ya̱a̱ꞌ mbáa dxáꞌgú inaxo̱ꞌ, tsí gíꞌdaa mbáa gíñá ꞌguéen tsí naꞌne rí mba̱ꞌyoo̱ dí ñajuun rí ma̱ri̱gá. Maphú mba̱a̱ mbúkha̱a̱ naꞌnii̱ rí mudaa ña̱ꞌñii̱, ga̱jma̱á numuu rí ndaꞌyoo̱ dí ñajuun rí ma̱ri̱gá. <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />Ikhaa dxáꞌgú tsúꞌkhue̱n na̱ka̱ tsu̱da̱ꞌxo̱ꞌ gajmiáxo̱ꞌ Páblo̱, jamí nandxaꞌwée̱ xáꞌnii: «Xa̱bo̱ tsíge̱ꞌ ñajúún yumbée Ana̱ꞌlóꞌ Mikhuíí, jamí nuthanlaꞌ xáne ma̱goo ma̱jríñáaꞌlaꞌ».<verse eid="ACT 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 16:18" />Jamí phú mbaꞌa mbiꞌi naꞌne dxáꞌgú rúꞌkhue̱n, asndo rí ni̱ga̱nú mbiꞌi rí nijiꞌnáa Páblo̱ iꞌnii̱. A̱ꞌkhue̱n nitangayii Páblo̱ niꞌthúun gíñá ꞌguéen tsúꞌkhue̱n: «Na̱xna̱-ñájwaanꞌ ga̱jma̱á ski̱yu̱u̱ꞌ mbiꞌyuu Jesukrísto̱ rí ma̱ta̱tsi̱ꞌñáá dxáꞌgú tsúꞌkhue̱n». Jamí núkho̱ máꞌ nigájna̱a gíñá ꞌguéen ná xuyuu dxáꞌgú.<verse eid="ACT 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19" />Ído̱ ndiyáá ña̱ꞌñii̱ rí nánguá xó mudaa̱ mbúkha̱a̱ ga̱jma̱á numuu dxáꞌgú, a̱ꞌkhue̱n ni̱rtuwii̱n Páblo̱ ga̱jma̱á Síla̱s, jamí nigóo̱ judii̱n ná inúú xa̱bo̱ ñajun, ná rixo̱o̱ xuajen. <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />Jamí ído̱ ni̱xna̱xíi̱n ná inúú xa̱bo̱ tsí nu̱xu̱da̱a̱ꞌ awan, a̱ꞌkhue̱n nithee̱n: «Tsíge̱ꞌ ñajúún xa̱bo̱ judío̱, jamí nune̱-majnga̱a̱ idxu̱ún xa̱bo̱ xuajñalóꞌ. <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />Xúꞌkhue̱n máꞌ nusngáa̱ rí ra̱gíꞌmaa mu̱drígúlóꞌ ni máꞌ ra̱jáꞌyoo rí mu̱ꞌne̱-mbáníílóꞌ, numuu rí xa̱bo̱ Róma̱ ñajwanlóꞌ».<verse eid="ACT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 16:22" />A̱ꞌkhue̱n mbá ꞌnduꞌ ni̱gímbú-mijnáa xa̱bo̱ xuajen kajngó muxnáa̱ Páblo̱ ga̱jma̱á Síla̱s. Xómáꞌ tsí ñajúún xa̱bo̱ ñajun nixna-ñajun rí mu̱thon-ri̱ya̱ꞌ xtíñúu̱, jamí rí mi̱xpáthuu̱n ga̱jma̱á xkuíya̱. <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />Ído̱ wámbúu̱n ni̱xpa̱thúu̱n mi̱ndaꞌkho, a̱ꞌkhue̱n xa̱bo̱ ñajun nixna-ñajun rí magóo̱ géjwa̱nꞌ, jamí nixná-ñájwíi̱n xa̱bo̱ tsí na̱ña̱wu̱u̱n géjwa̱nꞌ rí ma̱ña̱wúu̱n mújúu̱n. <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />Jamí ikhaa̱ ído̱ nidxawuu̱n rí xkuaꞌnii waꞌxná-ñájwíi̱n, a̱ꞌkhue̱n nixudii̱n ná géjwa̱nꞌ rí i̱tha̱án awúún, xúꞌkhue̱n máꞌ nixudaa̱ nakhúún ná iñúu ixe̱ ji̱ñu̱u̱ rí naruꞌwá-ti̱gi̱in xa̱bo̱.<verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />I̱ndo̱ó máꞌ numuu rí ído̱ neꞌne tikhuu mbroꞌon, Páblo̱ ga̱jma̱á Síla̱s nuthán-jáñíi̱ Ana̱ꞌlóꞌ, nuni̱i̱ ajmúú inuu Ana̱ꞌlóꞌ, jamí i̱ꞌwíin xa̱bo̱ tsí traꞌi̱in ná géjwa̱nꞌ nu̱dxawúu̱n. <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />A̱ꞌkhue̱n nda̱a̱ ajngóo gakhe̱ mi̱ndaꞌkho nixma, rí asndo nakhúu géjwa̱nꞌ niꞌba̱a̱n. Jamí núkho̱ ni̱ma̱ꞌthoo mbá xúgíí xkrugoo géjwa̱nꞌ, xúꞌkhue̱n máꞌ nikhúu mbá xúgíí ñuu ajwa̱nꞌ rí xtuꞌúún ga̱jma̱á xa̱bo̱. <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />Ído̱ nijwi̱i xa̱bo̱ tsí na̱ña̱wu̱u̱n géjwa̱nꞌ, jamí ndiꞌyoo̱ rí ja̱ma̱ꞌtha xkrugoo géjwa̱nꞌ, a̱ꞌkhue̱n niríye̱e̱ꞌ chídii̱ kajngó maxíya̱-mine̱e̱ꞌ, numuu na̱ju̱mu̱u̱ rí nigáñúú xa̱bo̱ tsí traꞌi̱in géjwa̱nꞌ. <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />Xómáꞌ Páblo̱ phú gakhe̱ nindxaꞌwá rí niꞌthúu̱n: «¡Ma̱xátha̱ne ñawún-mina̱ꞌ, numuu rí mbá xúgiáanꞌxo̱ꞌ máꞌ gacháanꞌxo̱ꞌ ge̱jyoꞌ!».<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />A̱ꞌkhue̱n xa̱bo̱ tsí na̱ña̱wu̱u̱n géjwa̱nꞌ ni̱nda̱ꞌa̱ agu, jamí nagáyuu̱ ni̱to̱ꞌo̱o̱ awúún, xúꞌkhue̱n máꞌ asndo naguaꞌaa̱n rí namíñuu̱ nismáti̱go̱o̱ ná nakhúu Páblo̱ ga̱jma̱á Síla̱s. <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />A̱ꞌkhue̱n ikhaa̱ ni̱gu̱wíi̱n ná géjwa̱nꞌ jamí niraxúu̱n:</para>
  <para style="p" vid="ACT 16:30">―Xa̱bo̱ buanuu, dí jaꞌyoo ma̱ne̱ kajngó ma̱jríñu̱úꞌ rá.<verse eid="ACT 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31" />Xómáꞌ ikhii̱n nitháa̱n:</para>
  <para style="p" vid="ACT 16:31">―Ga̱nimba̱a̱ꞌ xtayáá Táta̱ Jesukrísto̱, kajngó ma̱jríñáaꞌ ikháánꞌ, jamí ma̱jáwíin xa̱bo̱ guꞌwáaꞌ.<verse eid="ACT 16:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 16:32" />A̱ꞌkhue̱n ikhii̱n nitháa̱n ajngóo̱ Táta̱, ikhaa̱ gajmíi̱ mbá xúgíin xa̱bo̱ tsí júwa̱ꞌ ná guꞌwóo̱. <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />Jamí ikhaa máꞌ mbroꞌon rúꞌkhue̱n, xa̱bo̱ tsí na̱ña̱wu̱u̱n géjwa̱nꞌ niꞌjñáa̱ ná nijámbi̱yu̱u̱ꞌ Páblo̱ ga̱jma̱á Síla̱s. A̱ꞌkhue̱n mbá nacha̱ máꞌ waxúꞌdu-maꞌáa̱n ná awúun iya, ikhaa̱ jamí mbá xúgíin xa̱bo̱ guꞌwóo̱ waxúꞌdu-maꞌíin ná awúun iya. <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />A̱ꞌkhue̱n ni̱ka̱ jaguu̱n ná guꞌwóo̱, jamí nistrámee̱ rí mu̱pho̱. Jamí phú nadxu a̱kuii̱n, ikhaa̱ gajmíi̱ mbá xúgíin xa̱bo̱ guꞌwóo̱, numuu rí nanimbúu̱n juyáa̱ Ana̱ꞌlóꞌ.<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />Ído̱ ni̱mbiꞌi, a̱ꞌkhue̱n tsí ñajúún xa̱bo̱ ñajun ni̱xu̱ꞌmii̱ xa̱bo̱ magóó juñu̱ú ajngáa ríge̱ꞌ ná inuu xa̱bo̱ tsí na̱ña̱wu̱u̱n géjwa̱nꞌ: «Atatsíñúú xa̱bo̱ tsúꞌkhue̱n magúu̱n». <verse eid="ACT 16:35" /><verse number="36" style="v" sid="ACT 16:36" />A̱ꞌkhue̱n xa̱bo̱ tsí na̱ña̱wu̱u̱n géjwa̱nꞌ niꞌthúun Páblo̱ ajngáa ríge̱ꞌ:</para>
  <para style="p" vid="ACT 16:36">―Xa̱bo̱ ñajun nuxna-ñajwinꞌ rí ma̱ni̱ꞌñálaꞌ. Ikhaa jngó rí xúge̱ꞌ rá, ma̱goo máꞌ ma̱ga̱jnáaꞌlaꞌ, jamí tsímáá gúꞌgua̱aꞌlaꞌ.<verse eid="ACT 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37" />Xómáꞌ Páblo̱ niꞌthúún xa̱bo̱ tsí niguwá juñu̱ú ajngáa:</para>
  <para style="p" vid="ACT 16:37">―Ni̱xpa̱tháa̱nꞌxo̱ꞌ mi̱ndaꞌkho ná inúú xa̱bo̱, maske máꞌ túra̱jwe̱e̱ꞌ xí gakon rí guáꞌdááxo̱ꞌ aꞌkhán. Ikháanꞌxo̱ꞌ tsáanꞌ ñajwanxo̱ꞌ xa̱bo̱ Róma̱, ni̱xu̱dáa̱nꞌxo̱ꞌ géjwa̱nꞌ. Jamí xúge̱ꞌ nandúu̱n rí mu̱rawiáa̱nꞌxo̱ꞌ ngu̱ꞌwa̱ ráanꞌ. ¡Na̱nguá, ma̱xáꞌne xúꞌkhue̱n! A̱guwée̱ꞌ jmínii̱ ikhii̱n mu̱rawiáa̱nꞌxo̱ꞌ.<verse eid="ACT 16:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38" />A̱ꞌkhue̱n xa̱bo̱ tsí niguwá juñu̱ú ajngáa nigúu̱n ná inúú xa̱bo̱ ñajun, jamí nithúu̱n ajngáa rí niꞌthán Páblo̱. Ído̱ xa̱bo̱ ñajun ni̱dxawíín rí xa̱bo̱ Róma̱ ñajúu̱n, phú nimíñúu̱. <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />A̱ꞌkhue̱n nigóo̱ jmínúu̱ꞌ gúnda̱ꞌáa̱ Páblo̱ ga̱jma̱á Síla̱s rí mune̱ mba̱a̱ a̱kuíi̱n juñúu̱. Ni̱rawíi̱n ná géjwa̱nꞌ, jamí ni̱ndu̱ꞌúu̱n rí ma̱ga̱jnáa̱ ná awúun xuajen. <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />Ído̱ nigájnáa̱ ná géjwa̱nꞌ, a̱ꞌkhue̱n nigóo̱ ná guꞌwóo Lídia̱. Ikhín ndiñúu̱ a̱ngia̱nꞌlóꞌ jamí nixnaa̱ la tsiakhe̱. Nda̱wa̱á a̱ꞌkhue̱n nigájnúu̱ nigóo̱.<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s">Páblo̱ ga̱jma̱á Síla̱s naguáꞌnú ná Tesalóni̱ka̱</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />Páblo̱ ga̱jma̱á Síla̱s ninújngúu̱n ná xuajen Anfípo̱li̱s jamí Apolónia̱, a̱ꞌkhue̱n niguáꞌníi̱ ná xuajen Tesalóni̱ka̱, ná ꞌgí mbá guꞌwá rí na̱gi̱mbíin xa̱bo̱ judío̱. <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />Páblo̱ ni̱ka̱ ná guꞌwá rí na̱gi̱mbíin xa̱bo̱ judío̱, xómá rí naꞌne jayuu̱. Atsú mbiꞌi rí nduya̱a xu̱únꞌ xa̱bo̱ ni̱ke̱e̱ ikhín, jamí naꞌthán-mine̱e̱ꞌ gajmíi̱. <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />Naꞌthán-makúu̱n ga̱jma̱á majñu̱u̱ i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ, rí jaꞌyoo rí ma̱ja̱ñúu Krísto̱, jamí jaꞌyoo rí mbayáa̱ mbiꞌyuu̱. Jamí xáꞌnii iꞌthúu̱n: «Jesús tsí na̱tha̱nꞌlaꞌ ga̱jma̱á numuu, ikhaa̱ ñajuun Krísto̱». <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />Mbá tikhuun xa̱bo̱ judío̱ ninimbu̱únꞌ jamí nimbáxúu̱n gajmíi̱ Páblo̱ ga̱jma̱á Síla̱s. Mangaa máꞌ phú mbaꞌiin xa̱bo̱ griégo̱ tsí nune̱-mba̱a̱ máꞌ Ana̱ꞌlóꞌ ninimbu̱únꞌ, xúꞌkhue̱n máꞌ phú mbaꞌiin go̱ꞌo̱ tsí gíꞌdoo numúú ninimbu̱únꞌ.<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />I̱ndo̱ó máꞌ numuu rí xa̱bo̱ judío̱ tsí tsínimbu̱únꞌ, nixígúu̱n jamí ni̱gímbúu̱n mbá tikhuun xa̱bo̱ ra̱májíin tsí ngrigu̱ún na̱nguá i̱ñajun. A̱ꞌkhue̱n nini̱i̱ rí xa̱bo̱ xuajen mu̱xu̱xí a̱ꞌwá, xúꞌkhue̱n máꞌ ni̱dráꞌii̱n ga̱jma̱á tsiakhe̱ ná guꞌwóo Jasón numuu rí nduꞌyáa̱ Páblo̱ ga̱jma̱á Síla̱s, kajngó mu̱rawíi̱n jamí magóo̱ judii̱n ná inúú xa̱bo̱ xuajen. <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />I̱ndo̱ó máꞌ numuu rí na̱nguá ni̱xkamii̱, ikhaa jngó ni̱ríya̱a̱ꞌ ga̱jma̱á tsiakhe̱ Jasón jamí i̱ꞌwíin a̱ngia̱nꞌlóꞌ, nigóo̱ judii̱n ná inúú tsí ñajúún xa̱bo̱ ñajun ná xuajen. Jamí xáꞌnii nu̱ndxa̱ꞌwe̱e̱: «Ikhiin xa̱bo̱ tsíge̱ꞌ, tsí nune̱-ngra̱ꞌiin xa̱bo̱ ná mbá xúgíí numbaa, niguáꞌnú ge̱jyoꞌ mangaa. <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />Jamí Jasón ni̱grui̱gúu̱n ná guꞌwóo̱. Mbá xúgíin xa̱bo̱ tsúꞌkhue̱n tsíne̱-mbáníi̱ rí naxná-ñájun thúngaa Sésa̱r, jamí nuthee̱n rí xtáa i̱mba̱a̱ꞌ thúngaa mbiꞌyuu Jesús».<verse eid="ACT 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 17:8" />Ído̱ rí xa̱bo̱ xuajen gajmíí xa̱bo̱ ñajun ni̱dxawíín ajngáa rúꞌkhue̱n, a̱ꞌkhue̱n ni̱xu̱xíi̱ a̱ꞌwá. <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />I̱ndo̱ó máꞌ numuu rí xa̱bo̱ ñajun, ni̱ni̱ꞌñáa̱ Jasón gajmíí i̱ꞌwíin a̱ngia̱nꞌlóꞌ, ído̱ wámbúu̱n nixnee̱ mbúkha̱a̱ rí ni̱ndu̱ꞌúu̱n kajngó mu̱ni̱ꞌñúu̱.<verse eid="ACT 17:9" /></para>
  <para style="s">Páblo̱ ga̱jma̱á Síla̱s naguáꞌnú ná Beréa̱</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />A̱ꞌkhue̱n a̱ngia̱nꞌlóꞌ mbá nacha̱ máꞌ ni̱xu̱ꞌmaa̱ Páblo̱ ga̱jma̱á Síla̱s ído̱ neꞌne mbroꞌon, rí magóo̱ ná xuajen Beréa̱. Ído̱ niguáꞌníi̱ ikhín, a̱ꞌkhue̱n ni̱tu̱ꞌúu̱n ná guꞌwá rí na̱gi̱mbíin xa̱bo̱ judío̱. <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />Jamí xa̱bo̱ judío̱ tsúꞌkhue̱n i̱tha̱án máꞌ májáan a̱kuíi̱n ikhii̱n xó rí tsí júwa̱ꞌ ná Tesalóni̱ka̱, numuu rí mbá jañii a̱kuíi̱n ni̱dri̱guíi̱ ajngáa máján. Xúꞌkhue̱n máꞌ mbámbá mbiꞌi nune̱-gajma̱a̱ i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ, kajngó mbuyáa̱ xí gakon rí nithúu̱n. <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />Ikhaa jngó phú mbaꞌiin tsí ikhii̱n ninimbúu̱n juyáa̱ Jesús, jamí phú mbaꞌiin xa̱bo̱ griégo̱ ninimbu̱únꞌ mangiin, go̱ꞌo̱ tsí gíꞌdoo numúú jamí xa̱bekha. <verse eid="ACT 17:12" /><verse number="13" style="v" sid="ACT 17:13" />Ído̱ ni̱dxawíín xa̱bo̱ judío̱ tsí júwa̱ꞌ ná Tesalóni̱ka̱ rí Páblo̱ naꞌthán-ráꞌa ajngóo Ana̱ꞌlóꞌ ná Beréa̱ mangaa, a̱ꞌkhue̱n nigóo̱ ikhín, nini̱i̱ rí xa̱bo̱ tsí mbaꞌiin mu̱xu̱xí a̱ꞌwá. <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />I̱ndo̱ó máꞌ numuu rí a̱ngia̱nꞌlóꞌ mbá nacha̱ máꞌ ni̱xu̱ꞌmaa̱ Páblo̱ ma̱ꞌga ná rawuun iya a̱pha̱. Xómáꞌ Síla̱s ga̱jma̱á Timotéo̱ ninguanúu̱ ná Beréa̱. <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />Xómáꞌ xa̱bo̱ tsí nagóó ga̱jma̱á nindxu̱u̱ Páblo̱, nigóo̱ juya̱a̱ asndo ná xuajen Aténa̱s. Ído̱ nithangii̱n, juye̱e̱ ajngóo Páblo̱ niguwáa̱n, rí mutháa̱n Síla̱s ga̱jma̱á Timotéo̱ rí wapha máꞌ gúni̱i̱ rí magóo̱ gúxkamaa̱ ná Aténa̱s.<verse eid="ACT 17:15" /></para>
  <para style="s">Páblo̱ naꞌsngáá ná Aténa̱s</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />Awúun máꞌ rí Páblo̱ gíꞌthu̱u̱n ná Aténa̱s rí ma̱ga̱nú Síla̱s ga̱jma̱á Timotéo̱, phú nadaa a̱kuii̱n ído̱ ndiꞌyoo̱ rí mbá xúgíí awúun xuajen na̱gu̱ma-mbi̱in tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún. <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />Ikhaa jngó naꞌthán-mine̱e̱ꞌ gajmíi̱ xa̱bo̱ judío̱ ná guꞌwá rí na̱gi̱mbíi̱n, jamí naꞌthán-mine̱e̱ꞌ gajmíi̱ i̱ꞌwíin xa̱bo̱ tsí nune̱-mba̱a̱ Ana̱ꞌlóꞌ. Xúꞌkhue̱n máꞌ mbámbá mbiꞌi naꞌthúu̱n xa̱bo̱ tsí na̱gi̱mbíin ná xuáá. <verse eid="ACT 17:17" /><verse number="18" style="v" sid="ACT 17:18" />Ikhín máꞌ naꞌthán-mine̱e̱ꞌ gajmíi̱ mbá tikhuun xa̱bo̱ tsí nune̱-gajma̱a̱ gisngáá drígu̱ún epikúre̱o̱, jamí tsí nune̱-gajma̱a̱ gisngáá drígu̱ún estóiko̱. A̱ꞌkhue̱n mbá tikhuun tsúꞌkhue̱n nuthan: «Dí iyoo gáꞌthán xa̱bo̱ tsíge̱ꞌ, rí naꞌthán guéño rá». Jamí i̱ꞌwíin nuthan: «Asndo xó mbáa xa̱bo̱ tsí naꞌthán-ráꞌa ga̱jma̱á numúú i̱ꞌwíin tsí nithúún “ana̱ꞌlóꞌ” jaꞌnii̱». Numuu rí Páblo̱ naꞌthán-rúꞌúu̱n ajngáa máján ga̱jma̱á numuu Jesús, jamí ga̱jma̱á numuu rí mbuya̱a mbiꞌñúú xa̱bo̱. <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />A̱ꞌkhue̱n nigóo̱ juya̱a̱ ná nawi̱in xa̱bo̱ ñajun xuajen ná nutháa̱n Areópa̱go̱, jamí ni̱ra̱xíi̱: «Á ma̱goo mbu̱ya̱á mangáanꞌxo̱ꞌ dí gisngáá nuxe̱ꞌ ñajuun ríge̱ꞌ rí narathán ga̱jma̱á numuu rá. <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />Numuu rí ni miꞌtsú túdxawíínxo̱ꞌ rí narathánxo̱ꞌ, jamí nandaxo̱ꞌ mbu̱ya̱á dí iyoo gáꞌthán ajngáa rúꞌkhue̱n». <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />(Numuu rí mbá xúgíin tsí xa̱bo̱ Aténa̱s jamí xa̱bo̱ tsí naguwá i̱ꞌwá xuajen tsí júwa̱ꞌ máꞌ ikhín, nda̱a̱ máꞌ i̱mba̱ rí phú nuni̱i̱, rí i̱ndo̱ó máꞌ rí nuthee̱n numuu mbá rí nuxe̱ꞌ o nu̱dxawíi̱n mbá rí nuxe̱ꞌ niríga̱ mbo̱ꞌ.)<verse eid="ACT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />A̱ꞌkhue̱n Páblo̱ ni̱we̱je̱ ná ti̱kua̱pho̱o̱ Areópa̱go̱, jamí niꞌthúu̱n: «Xa̱bo̱ buanuu Aténa̱s, mbá xúgíí rí nda̱yo̱o̱lo̱ꞌ nasngájma rí ikháanꞌlaꞌ phú máján nu̱ne̱-mbáníílaꞌ rí nandúún tsí nu̱ne̱-mbi̱inlaꞌ. <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />Numuu rí ído̱ naka-ranújngoꞌ nda̱yo̱o̱ ná nu̱ne̱-mbi̱inlaꞌ tsí nanimba̱ꞌlaꞌ ju̱ñu̱ú, a̱ꞌkhue̱n ni̱xkamaa mangaa mbá ná ka̱ma naꞌthán ajngáa ríge̱ꞌ: “Ná nuꞌthán-jáñíílóꞌ Ana̱ꞌlóꞌ tsí tsíꞌne̱-nuwiinlóꞌ”. Ikhaa jngó, ikhúúnꞌ na̱tha̱nꞌlaꞌ ga̱jma̱á numuu Ana̱ꞌlóꞌ, tsí ikháanꞌlaꞌ nu̱ne̱-mba̱a̱laꞌ, maske máꞌ tsíne̱-nuwiinlaꞌ.<verse eid="ACT 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 17:24" />»Ikhaa Ana̱ꞌlóꞌ tsí neꞌne-ku̱maa numbaa jamí mbá xúgíí rí ríga̱ ná inuu ne̱, ikhaa̱ ñajuu̱n tsí naꞌthán-ñájuun mikhu ga̱jma̱á ju̱ba̱ꞌ. Na̱nguá xtáa̱ ná awúun guꞌwá dxákuun rí nune̱ xa̱bo̱ numbaa, <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />ni máꞌ tsíꞌyóo̱ rí mi̱tambáyíi̱ nitháan gúne̱ xa̱bo̱ numbaa ga̱jma̱á ñawúún. Numuu rí ikhaa̱ naꞌnii̱ rí mbá xúgiáanꞌlóꞌ nduꞌyalóꞌ, xúꞌkhue̱n máꞌ naxnálóꞌ gíñá, jamí naxnálóꞌ mbá xúgíí rí ndaꞌyálóꞌ. <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />Jamí ga̱jma̱á majñu̱u̱ mbáwíi xa̱bo̱ niꞌnii̱ mbá xúgíí inii xa̱bo̱, kajngó ma̱ju̱wée̱ꞌ mbá xúgíí inuu numbaa. Wapha máꞌ niꞌgí-mine̱e̱ꞌ nguáná ma̱ju̱wée̱ꞌ, jamí asndo náá jayáa mbaa rí ma̱ju̱wée̱ꞌ gáꞌne. <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />Ana̱ꞌlóꞌ neꞌne mbá xúgíí rúꞌkhue̱n kajngó mbu̱ꞌyáa̱ ikhaa̱, á gáꞌne xí awúun rí nu̱xkajngaa̱, ma̱goo mu̱xkamaa̱. Gakon máꞌ rí Ana̱ꞌlóꞌ na̱nguá xtáa tsíngua̱ꞌ inuu mbámbáa tsí ikháánꞌlóꞌ. <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />Numuu rí ga̱jma̱á numuu̱ ikhaa̱ nduꞌyalóꞌ, na̱ba̱ñáaꞌlóꞌ jamí juwalóꞌ. Xómá nithan mbá tikhuun xa̱bo̱ dxágua̱ dríga̱ꞌlaꞌ: “Xa̱bo̱ ri̱jyu̱u̱ꞌ Ana̱ꞌlóꞌ ñajwanlóꞌ”. <verse eid="ACT 17:28" /><verse number="29" style="v" sid="ACT 17:29" />Ikhaa jngó, numuu rí xa̱bo̱ ri̱jyu̱u̱ꞌ Ana̱ꞌlóꞌ ñajwanlóꞌ, na̱nguá gíꞌmaa mu̱ndxaꞌwá-mijnálóꞌ rí Ana̱ꞌlóꞌ jaꞌnii xómá ajwa̱nꞌ mo̱jmo̱ꞌ, o ajwa̱nꞌ miꞌxá, o itsí mbo̱ꞌ, rí nutháá xa̱bo̱ ma̱ꞌne xómá rí na̱ju̱múu̱ ikhii̱n. <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />Rí nákhí wajyúú Ana̱ꞌlóꞌ neꞌne mba̱a̱ a̱kui̱in jaꞌyoo ríge̱ꞌ, numuu rí júgoo inúú xa̱bo̱. I̱ndo̱ó máꞌ numuu rí xúge̱ꞌ rá, naxná-ñájúu̱n mbá xúgíin xa̱bo̱ tsí júwa̱ꞌ mbá xúgíí inuu numbaa rí ma̱thangii̱n ná inuu̱ ikhaa̱. <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />Numuu rí Ana̱ꞌlóꞌ naꞌgí mbá mbiꞌi rí maxudaa mújúun awan ga̱jma̱á numúú mbá xúgíin xa̱bo̱, ga̱jma̱á majñu̱u̱ xa̱biya̱ tsí ikhaa̱ niraꞌwíi̱. Ikhaa máꞌ Ana̱ꞌlóꞌ nasngájmúú mbá xúgíin xa̱bo̱ rí gakon rí niraꞌwíi̱ tsúꞌkhue̱n, ído̱ niꞌnii̱ rí mbayáa̱ mbiꞌyuu̱».<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />I̱ndo̱ó máꞌ numuu rí ído̱ ni̱dxawíi̱n ga̱jma̱á numuu rí mbuya̱a mbiꞌñúú wa̱jen, a̱ꞌkhue̱n mbá tikhuun nu̱tsi̱jmaa Páblo̱, jamí i̱ꞌwíin nuthan: «Nda̱wa̱á gúdxawaanꞌxo̱ꞌ ga̱jma̱á numuu rúꞌkhue̱n». <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />A̱ꞌkhue̱n Páblo̱ nigájna̱a ná majñu̱ú xa̱bo̱ tsúꞌkhue̱n. <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />I̱ndo̱ó máꞌ numuu rí mbá tikhuun xa̱bo̱ ninimbu̱únꞌ, a̱ꞌkhue̱n nimbáxúu̱n ga̱jma̱á nindxu̱u̱ Páblo̱. Mbáa tsúꞌkhue̱n mbiꞌyuu Dionísio̱, tsí jimaa gajmíí xa̱bo̱ ñajun ná Areópa̱go̱, xúꞌkhue̱n máꞌ ninimbo̱o̱ꞌ mbáa a̱ꞌgo̱ tsí mbiꞌyuu Dáma̱ri̱s, jamí i̱ꞌwíin xa̱bo̱ ga̱jma̱á nindxúu̱n.<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s">Páblo̱ na̱ka̱ ná Korínto̱</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />Nda̱wa̱á rí niríga̱ rúꞌkhue̱n, a̱ꞌkhue̱n nigájnuu Páblo̱ ná Aténa̱s, jamí ni̱ke̱e̱ ná xuajen Korínto̱. <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />Ikhín nixkamaa̱ mbáa xa̱bo̱ judío̱ mbiꞌyuu Akíla̱, tsí na̱ꞌkha̱ ná xuajen Pónto̱. Ni̱kú jayu máꞌ nigájnúu̱ ná Itália̱ ga̱jmáa̱ a̱ꞌguii̱ Prisíla̱, numuu rí thúngaa Kláudio̱ nixná-ñájun rí mbá xúgíin xa̱bo̱ judío̱ ma̱ga̱jnúú ná xuajen Róma̱. Páblo̱ ni̱ka̱ gáꞌñúu̱, <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />jamí ninguanúu̱ gajmíi̱, numuu rí ikhaa máꞌ ñajun rí naꞌne Páblo̱ nuni̱i̱ mangii̱n. Mbá ꞌnduꞌ nu̱ñajwii̱n, numuu rí xa̱bo̱ tsí nune̱ guꞌwá-xtíin ñajúu̱n. <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />Jamí mbámbá mbiꞌi rí nduya̱a xu̱únꞌ xa̱bo̱, naꞌthán-mina̱ꞌ gajmíi̱ xa̱bo̱ judío̱ ga̱jma̱á xa̱bo̱ griégo̱, ná guꞌwá rí na̱gi̱mbíin xa̱bo̱ judío̱. Naꞌnii̱ rí ma̱nimbu̱únꞌ ajngáa rí naꞌthúu̱n.<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />Ído̱ rí Síla̱s ga̱jma̱á Timotéo̱ nigájnúu̱ ná Masedónia̱ jamí niguáꞌníi̱ ná Korínto̱, Páblo̱ xtáa̱ mbá jayu naꞌthán-ráꞌa ajngóo Ana̱ꞌlóꞌ, jamí naꞌthúu̱n xa̱bo̱ judío̱ rí Jesús ñajuun Krísto̱. <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />Xómáꞌ xa̱bo̱ judío̱ nawajún-ꞌthíi̱n rí naꞌsngáá Páblo̱ jamí nuthan-xkawíi̱ꞌ. A̱ꞌkhue̱n ikhaa̱ nixprígúu̱ xtíñuu̱ jamí niꞌthúu̱n: «Aꞌkhánlaꞌ máꞌ ikháanꞌlaꞌ rí ma̱ja̱ñálaꞌ, ra̱ꞌkhá aꞌkhúnꞌ ikhúúnꞌ. Jamí asndo nákhí máꞌ xúge̱ꞌ rá ma̱tha̱n-rúꞌúúnlo̱ꞌ xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún».<verse eid="ACT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 18:7" />A̱ꞌkhue̱n Páblo̱ nigájna̱a ikhín, jamí ni̱ke̱e̱ ná guꞌwóo mbáa xa̱bo̱ tsí mbiꞌyuu Jústo̱,<note caller="+" style="f"><char style="fr" closed="false">18.7 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «Tísio̱ Jústo̱».</char></note> tsí naꞌne-mba̱a̱ Ana̱ꞌlóꞌ, jamí xtáa ná níjñúu guꞌwá rí na̱gi̱mbíin xa̱bo̱ judío̱. <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />Jamí Kríspo̱, tsí jayá idxu̱u̱ ná guꞌwá rí na̱gi̱mbíin xa̱bo̱ judío̱, ninimbo̱o̱ꞌ jaꞌyoo̱ Táta̱ xúꞌkhue̱n máꞌ mbá xúgíin xa̱bo̱ guꞌwóo̱. Mangaa máꞌ phú mbaꞌiin xa̱bo̱ Korínto̱ ninimbu̱únꞌ juyáá Táta̱ ído̱ nu̱dxawíi̱n rí naꞌthán Páblo̱ jamí waxúꞌdu-maꞌíi̱n ná awúun iya. <verse eid="ACT 18:8" /><verse number="9" style="v" sid="ACT 18:9" />A̱ꞌkhue̱n mbá mbroꞌon nisngájma-mina̱ꞌ Táta̱ ná inuu Páblo̱ ga̱jma̱á majñu̱u̱ mbá xnuꞌndaa jamí niꞌthúu̱n: «Ma̱xámíñaaꞌ ma̱ra̱thu̱ún xa̱bo̱, jamí ma̱xáta̱tsi̱ꞌñáá-rarathán, <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />numuu rí ikhúúnꞌ xtáá ga̱jma̱á nindxa̱a̱ꞌ, jamí nimbáa ma̱xáꞌngo̱o̱ ma̱ꞌne-ñawáanꞌ, numuu rí ikhúúnꞌ phú gúꞌdiin xa̱bi̱ꞌ ná xuajen ríge̱ꞌ». <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />Ikhaa jngó ninguanúu Páblo̱ mbá tsigu tikhu ná Korínto̱, niꞌsngúu̱n xa̱bo̱ ajngóo Ana̱ꞌlóꞌ.<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />I̱ndo̱ó máꞌ numuu rí nákhí Galión ñajuun thúngaa ná numbaa Akáya̱, ni̱ru̱wa-mijnáa xa̱bo̱ judío̱ tsí najiꞌníi juyáá Páblo̱, jamí nigóo̱ juya̱a̱ ná na̱ge̱ꞌe̱ Galión kajngó maxúdaa awan. <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />A̱ꞌkhue̱n nithee̱n: «Xa̱bo̱ tsíge̱ꞌ naꞌne-rájíin xa̱bo̱ rí mune̱-mba̱a̱ Ana̱ꞌlóꞌ ga̱jma̱á i̱mba̱ ju̱ma̱, ra̱ꞌkhá xómá naꞌthán xtángoo».<verse eid="ACT 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14" />Inu máꞌ nagíꞌdu̱u̱n Páblo̱ naꞌthán, a̱ꞌkhue̱n Galión niꞌthúún xa̱bo̱ judío̱: «Xí ikháanꞌlaꞌ, xa̱bo̱ judío̱, nu̱ne̱-xkundulaꞌ ga̱jma̱á numuu mbá rí ra̱máján ni̱gu̱máaꞌlaꞌ o ga̱jma̱á numuu mbá aꞌkhán mba̱a̱ mbo̱ꞌ, xtáá máꞌ ma̱dxawanlaꞌ xómá phú jaꞌyoo. <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />I̱ndo̱ó máꞌ numuu rí ajngáa jayu ñajuun ne̱, mbiꞌñúú xa̱bo̱, jamí xtángoo dríga̱ꞌlaꞌ, ikhaa jngó gu̱ne̱-mbáníí máꞌ ikháanꞌlaꞌ ne̱. Numuu rí ikhúúnꞌ tsíyoꞌ gáxu̱ꞌdá-mina̱ꞌ ga̱jma̱á numuu rúꞌkhue̱n».<verse eid="ACT 18:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 18:16" />A̱ꞌkhue̱n nixná-ñájwii̱n rí mi̱xkawíi̱n ná ꞌgíi̱ naxudaa̱ awan. <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />A̱ꞌkhue̱n mbá xúgíin xa̱bo̱ ni̱rtuwiin Sóste̱ne̱s, tsí ñajuun xa̱bo̱ ede̱ ná guꞌwá rí na̱gi̱mbíin xa̱bo̱ judío̱. A̱ꞌkhue̱n nixnáa̱ ná inuu ꞌgí thúngaa Galión, xómáꞌ ikhaa̱ táxná-gamiéjuu̱n mbá jayu ga̱jma̱á numuu rúꞌkhue̱n.<verse eid="ACT 18:17" /></para>
  <para style="s">Páblo̱ nathanga̱a ná Antiokía̱</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />Xómáꞌ Páblo̱, ninguanúu xóó mbaꞌa mbiꞌi ná Korínto̱. Nda̱wa̱á niꞌthán-ngawúu̱n a̱ngia̱nꞌlóꞌ, a̱ꞌkhue̱n ndiyée̱ ikhoo̱ ma̱ki̱daa̱ ná numbaa Síria̱. Na̱ka̱ Prisíla̱ jamí Akíla̱ ga̱jma̱á nindxu̱u̱. Ído̱ ni̱ga̱níi̱ ná xuajen Senkréa̱ niꞌda̱-ráꞌtse̱e̱ idxu̱u̱, numuu rí ríga̱ rí nixuda-mine̱e̱ꞌ ná inuu Ana̱ꞌlóꞌ, a̱ꞌkhue̱n nijngúu̱n ná awúun guꞌwá-rguwa. <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />Ído̱ niguáꞌníi̱ ná xuajen Éfe̱so̱, ikhín niniñuu̱ Prisíla̱ ga̱jma̱á Akíla̱, a̱ꞌkhue̱n ni̱to̱ꞌo̱o̱ ná guꞌwá rí na̱gi̱mbíin xa̱bo̱ judío̱ jamí niꞌthán-mine̱e̱ꞌ gajmíi̱. <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />Ikhii̱n nithán-jáñíi̱ rí ma̱nguanúu̱ xóó mbaꞌa mbiꞌi ga̱jma̱á nindxúu̱n, xómáꞌ ikhaa̱ ra̱khóo̱. <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />A̱ꞌkhue̱n niꞌthán-ngawúu̱n ga̱jma̱á ajngáa ríge̱ꞌ: «Ndaꞌyóo rí ma̱xtáá ná Jerusalén ná ma̱gu̱ma-ri̱ya̱aꞌ ndxa̱a̱ rí na̱ꞌkha̱.<note caller="+" style="f"><char style="fr" closed="false">18.21 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná tsíꞌkha̱ ajngáa ríge̱ꞌ: «Ndaꞌyóo rí ma̱xtáá ná Jerusalén ná ma̱gu̱ma-ri̱ya̱aꞌ ndxa̱a̱ rí na̱ꞌkha̱».</char></note> I̱ndo̱ó máꞌ numuu rí ma̱ꞌkha gáya̱ꞌlaꞌ mbu̱júꞌ nda̱wa̱á, xí Ana̱ꞌlóꞌ nandoo».</para>
  <para style="p" vid="ACT 18:21">A̱ꞌkhue̱n nijngúu̱n ná awúun guꞌwá-rguwa ná Éfe̱so̱, jamí nigájnuu̱ ni̱ke̱e̱. <verse eid="ACT 18:21" /><verse number="22" style="v" sid="ACT 18:22" />Ído̱ ni̱ga̱níi̱ ná xuajen Sesaréa̱, a̱ꞌkhue̱n nitsimuu̱ ni̱ke̱e̱ ná Jerusalén gáraxii̱n tsí nanimbu̱únꞌ juyáá Jesús, nda̱wa̱á nithangaa̱ ná Antiokía̱.<verse eid="ACT 18:22" /></para>
  <para style="s">Páblo̱ na̱ka̱ ná Galásia̱ ga̱jma̱á Fríjia̱</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 18:23" />Ído̱ neꞌne mba̱yo̱ꞌ máꞌ rí xtáa̱ ikhín, a̱ꞌkhue̱n nigájnuu̱ ni̱ke̱e̱ mbámbá máꞌ xúꞌkhue̱n xuajen ná mbayuu Galásia̱ ga̱jma̱á mbayuu Fríjia̱, ni̱ke̱e̱ gaxnáa̱ la tsiakhe̱ a̱kui̱ín tsí nanimbu̱únꞌ juyáá Jesús.<verse eid="ACT 18:23" /></para>
  <para style="s">Apólo̱s naꞌthán-ráꞌa ná Éfe̱so̱</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />Nákhí mbiꞌi rí ñúꞌún ni̱ga̱nú ná Éfe̱so̱ mbáa xa̱bo̱ judío̱ mbiꞌyuu Apólo̱s, tsí na̱ꞌkha̱ ná xuajen Alejandría̱. Apólo̱s phú na̱ma̱ñuu naꞌthán-ráꞌa ná inúú xa̱bo̱, jamí ndaꞌyoo̱ mújúu̱n rí naꞌthán i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ. <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />Ikhaa̱ waꞌsngáa̱ ga̱jma̱á numuu gisngáá drígo̱o̱ Táta̱. Phú gagi a̱kuii̱n naꞌthúu̱n xa̱bo̱ jamí naꞌsngúu̱n ga̱jma̱á numuu Jesús, maske máꞌ i̱ndo̱ó na̱ma̱ñuu̱ xáne Juáán nixúꞌdu-maꞌíin xa̱bo̱ ná awúun iya. <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />Jamí nigíꞌdu̱u̱n niꞌthée̱n ga̱jma̱á mbá jañii a̱kuii̱n ná guꞌwá rí na̱gi̱mbíin xa̱bo̱ judío̱. I̱ndo̱ó máꞌ numuu rí ído̱ nidxawuun Prisíla̱ ga̱jma̱á Akíla̱ rí naꞌsngáa̱, a̱ꞌkhue̱n ni̱ríya̱a̱ꞌ janíí, jamí mbá jaꞌwu nitháa̱n ga̱jma̱á numuu gisngáá drígo̱o̱ Ana̱ꞌlóꞌ. <verse eid="ACT 18:26" /><verse number="27" style="v" sid="ACT 18:27" />Ído̱ rí Apólo̱s ndiyoo ma̱ꞌga ná numbaa Akáya̱, a̱ꞌkhue̱n a̱ngia̱nꞌlóꞌ nixnáa̱ tsiakhe̱ rí ma̱ꞌgee̱, jamí nini̱i̱ mbá i̱yi̱i̱ꞌ rí ma̱ꞌga ná inúú tsí nanimbu̱únꞌ juyáá Jesús, kajngó mu̱dri̱guíi̱. Jamí ído̱ ni̱ga̱níi̱ ikhín, phú nimbáñúu̱ tsí ninimbu̱únꞌ juyáá Jesús ga̱jma̱á numuu rí phú májáan a̱kui̱in Ana̱ꞌlóꞌ. <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />Numuu rí ga̱jma̱á mba̱a̱ ski̱yu̱u̱ꞌ ajngóo̱ naꞌne wíyuu̱ rawúún xa̱bo̱ judío̱ ná inúú xa̱bo̱, nasngájmúu̱ ga̱jma̱á rí naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ rí Jesús ñajuun Krísto̱.<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s">Rí neꞌne Páblo̱ ná Éfe̱so̱</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />Awúun máꞌ rí Apólo̱s xtáa ná Korínto̱, Páblo̱ ni̱ka̱-rangroꞌoo ná xuajen rí triga̱ ná júba̱. Nda̱wa̱á a̱ꞌkhue̱n ni̱ga̱níi̱ ná Éfe̱so̱, jamí ikhín nixkamii̱ mbá tikhuun tsí nanimbu̱únꞌ juyáá Jesús. <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />Jamí niraxúu̱n:</para>
  <para style="p" vid="ACT 19:2">―Á ni̱dríguíilaꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ nákhí ninimba̱ꞌlaꞌ ju̱ya̱á Jesús rá.</para>
  <para style="p" vid="ACT 19:2">Xómáꞌ ikhii̱n ni̱riꞌñee̱:</para>
  <para style="p" vid="ACT 19:2">―Na̱nguá. Asndo ni máꞌ túdxawíínxo̱ꞌ xí xtáa Xu̱u̱ꞌ Ana̱ꞌlóꞌ.<verse eid="ACT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3" />A̱ꞌkhue̱n niraxúu̱n:</para>
  <para style="p" vid="ACT 19:3">―Náá rí gisngáá ni̱drígúlaꞌ kajngó waxúꞌdu-maꞌáa̱nꞌlaꞌ ná awúun iya xúꞌkhue̱n rá.</para>
  <para style="p" vid="ACT 19:3">Xómáꞌ ikhii̱n ni̱riꞌñee̱:</para>
  <para style="p" vid="ACT 19:3">―Gisngáá rí niꞌthán-raꞌa Juáán tsí nixúꞌdu-maꞌíin xa̱bo̱ ná awúun iya.<verse eid="ACT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4" />A̱ꞌkhue̱n Páblo̱ niꞌthúu̱n:</para>
  <para style="p" vid="ACT 19:4">―Juáán nixúꞌdu-maꞌíin xa̱bo̱ ná awúun iya tsí nathanga̱a a̱kui̱ín ná inuu Ana̱ꞌlóꞌ. I̱ndo̱ó máꞌ numuu rí niꞌthúu̱n xa̱bo̱ xuajen rí ga̱nimbúu̱n juyáa̱ tsí ma̱ꞌkha̱ tsu̱du̱u̱. Ikhaa tsúꞌkhue̱n ñajuun Jesús tsí ñajuun Krísto̱.<note caller="+" style="f"><char style="fr" closed="false">19.4 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «tsí ñajuun Krísto̱».</char></note><verse eid="ACT 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5" />Ído̱ ni̱dxawíi̱n rúꞌkhue̱n, a̱ꞌkhue̱n waxúꞌdu-maꞌíi̱n ná awúun iya ga̱jma̱á numuu Táta̱ Jesús. <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />Ído̱ rí Páblo̱ nixkrámii̱, a̱ꞌkhue̱n ni̱dri̱guíi̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ. A̱ꞌkhue̱n ni̱gíꞌdíi̱n nithee̱n ajngáa rí tsígu̱ma-nuwiin jamí nu̱rawíjngaa̱ ajngóo Ana̱ꞌlóꞌ. <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />Naꞌne xó mbá gu̱wa̱ꞌ i̱jmi̱i (12) wáa xa̱bekha tsúꞌkhue̱n rí mbá xúgíin.<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />Awúun rí mbá atsúun go̱nꞌ ni̱ka̱ Páblo̱ ná guꞌwá rí na̱gi̱mbíin xa̱bo̱ judío̱. Tsímíñuu̱ rí naꞌthán-rúꞌúu̱n xa̱bo̱, naꞌthúu̱n ga̱jma̱á numuu rí Ana̱ꞌlóꞌ ñajuun tsí naꞌthán-ñájúún xa̱bo̱, jamí naꞌnii̱ rí ma̱nimbúu̱n. <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />I̱ndo̱ó máꞌ numuu rí mbá tikhuun nene̱ gúkú a̱kui̱ín, ra̱khúu̱n gánimbúu̱n, jamí nithan-xkawi̱i̱ꞌ ga̱jma̱á numuu gisngáá drígo̱o̱ Jesús ná inúú mbaꞌiin xa̱bo̱. A̱ꞌkhue̱n Páblo̱ niríya̱ꞌ-mina̱ꞌ ná majñúu̱, jamí ni̱gu̱wíi̱n tsí nanimbu̱únꞌ juyáá Jesús, ni̱ka̱ jaguu̱n ná guꞌwá gisngáá drígo̱o̱ mbáa xa̱bo̱ tsí mbiꞌyuu Tiráno̱. Ikhín tsitsíí naꞌthúu̱n xa̱bo̱. <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />Xkuaꞌnii niꞌnii̱ awúun rí a̱jma̱ tsigu, ikhaa jngó mbá xúgíin xa̱bo̱ tsí júwa̱ꞌ ná numbaa Ásia̱, xa̱bo̱ judío̱ jamí xa̱bo̱ griégo̱, ni̱dxawíín ajngóo Táta̱ Jesús.<verse eid="ACT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />Jamí Ana̱ꞌlóꞌ naꞌne rí phú wáá mi̱ndaꞌkho ga̱jma̱á majñu̱u̱ Páblo̱, <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />rí asndo pañíto̱ o xtíin rí ningájma ná xuyuu̱ na̱ka̱ jiꞌda ná inúú tsí najáñúú, jamí naꞌnii̱ a̱kuíi̱n, xúꞌkhue̱n máꞌ nagájna̱á gíñá ꞌguéen ná xuñúu̱. <verse eid="ACT 19:12" /><verse number="13" style="v" sid="ACT 19:13" />I̱ndo̱ó máꞌ numuu rí mbá tikhuun xa̱bo̱ judío̱, tsí ngrigu̱ún nune̱ ñajun rí nu̱xkawíin gíñá ꞌguéen, nini̱i̱ mu̱xri̱gáa̱ mbiꞌyuu Táta̱ Jesús ná inúú tsí guáꞌdiin gíñá ꞌguéen. Xáꞌnii nithee̱n: «Na̱xna̱-ñájwanlaꞌ rí ma̱ga̱jnáaꞌlaꞌ ga̱jma̱á numuu Jesús, tsí naꞌthán-ráꞌa Páblo̱ ga̱jma̱á numuu».<verse eid="ACT 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 19:14" />Ikhaa rúꞌkhue̱n nune̱ mbá juwiin i̱ji̱in mbáa xa̱bo̱ judío̱ mbiꞌyuu Eséba̱, mbáa dxakuun tsí gíꞌdoo numuu. <verse eid="ACT 19:14" /><verse number="15" style="v" sid="ACT 19:15" />Xómáꞌ gíñá ꞌguéen niriꞌñúu̱: «Na̱ne̱-núwíinlo̱ꞌ Jesús, jamí nda̱yo̱o̱ tsáa ñajuun Páblo̱. Xómáꞌ ikháanꞌlaꞌ, tsíin ñajwanlaꞌ rá».<verse eid="ACT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 19:16" />A̱ꞌkhue̱n xa̱bo̱ tsí gíꞌdaa gíñá ꞌguéen ni̱ki̱xi̱i̱ ni̱ga̱ta̱ꞌmáa tsu̱dúu̱n, nirngáxii̱n ga̱jma̱á tsiakhe̱ jamí neꞌne-ñawúu̱n mi̱ndaꞌkho mbá xúgíi̱n. A̱ꞌkhue̱n tsaꞌtsii̱n jamí nijámbi̱ñúu̱ ningujwíi̱n-ragáñúu̱ ná guꞌwá rúꞌkhue̱n. <verse eid="ACT 19:16" /><verse number="17" style="v" sid="ACT 19:17" />Jamí ni̱dxawíín rúꞌkhue̱n mbá xúgíin xa̱bo̱ judío̱ jamí xa̱bo̱ griégo̱ tsí júwa̱ꞌ ná Éfe̱so̱. A̱ꞌkhue̱n mbá xúgíi̱n phú nimíñúu̱, jamí ndiya-makuíi̱ mbiꞌyuu Táta̱ Jesús.<verse eid="ACT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 19:18" />Jamí phú mbaꞌiin tsí ninimbu̱únꞌ juyáá Jesús naguwée̱ꞌ nune̱maphíi̱ a̱pha̱ mbá xúgíí rí ra̱máján nini̱i̱. <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />Xúꞌkhue̱n máꞌ phú mbaꞌiin xa̱bo̱ tsí nene̱ xawan niguwá judúu̱n i̱ñúu̱ꞌ, jamí ni̱tsi̱khe̱e̱ ne̱ ná inúú mbá xúgíin xa̱bo̱. Ído̱ ni̱ru̱waa̱ rí numuu ne̱ kajngó mbuyáa̱ wátha̱ mbúkha̱a̱ jámaa mbá xúgíí i̱yi̱i̱ꞌ rúꞌkhue̱n, a̱ꞌkhue̱n ndiyáa̱ rí a̱jma̱ skíñú gu̱wa̱ꞌ míl (50 000) mbúkha̱a̱ ajwa̱nꞌ miꞌxá jámaa ne̱. <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />Xkuaꞌnii i̱tha̱án na̱ka̱-raꞌne mbaꞌiin xa̱bo̱ tsí nanimbu̱únꞌ juyáá ajngóo Táta̱ jamí na̱ka̱-rakujma rí phú mba̱a̱ tsiakhe̱ gíꞌdoo ne̱.<verse eid="ACT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />Ído̱ ninújngoo mbá xúgíí rúꞌkhue̱n, a̱ꞌkhue̱n niꞌgí-mina̱ꞌ Páblo̱ rí ma̱ꞌga ná Jerusalén, i̱ndo̱ó máꞌ numuu rí ginii ma̱nújngoo̱ ná numbaa Masedónia̱ jamí Akáya̱. Xúꞌkhue̱n máꞌ naꞌthée̱n: «Nda̱wa̱á rí nixtáá ná Jerusalén, mba̱ꞌyóo rí ma̱ꞌgá ná Róma̱ mangaa». <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />A̱ꞌkhue̱n nixuꞌmii̱ magóó ná Masedónia̱ a̱jmi̱i tsí nu̱mbáyíi̱, Timotéo̱ ga̱jma̱á Erásto̱, awúun máꞌ rí ikhaa̱ nanguanúu̱ xóó i̱mbá wátha̱ wáa mbiꞌi ná numbaa Ásia̱.<verse eid="ACT 19:22" /></para>
  <para style="s">Xa̱bo̱ xuajen nu̱xu̱xí a̱ꞌwá ná Éfe̱so̱</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />Nákhí mbiꞌi rí ñúꞌún niríga̱ mbá xkujndu mba̱a̱ ná Éfe̱so̱ ga̱jma̱á numuu gisngáá drígo̱o̱ Jesús. <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />Xkujndu rúꞌkhue̱n nigíꞌdu̱u̱n mbáa xa̱bo̱ tsí mbiꞌyuu Demétrio̱. Xa̱bo̱ tsúꞌkhue̱n nañajun ga̱jma̱á ajwa̱nꞌ miꞌxá rí naꞌne guꞌwá lakiin, xtiꞌkhuu guꞌwá dxákuun drígo̱o̱ Diána̱,<note caller="+" style="f"><char style="fr" closed="false">19.24 </char><char style="ft" closed="false">Ikhaa máꞌ Diána̱ mbiꞌyuu «Artemísa̱» ná ajngáa griégo̱. </char></note> jamí phú mba̱a̱ mbúkha̱a̱ nudaa xa̱bo̱ tsí nune̱ ñajun rúꞌkhue̱n. <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />A̱ꞌkhue̱n Demétrio̱ ni̱ru̱wi̱in xa̱bo̱ tsí ikhaa máꞌ ñajun guáꞌdáá xómá ikhaa̱, jamí niꞌthúu̱n:</para>
  <para style="p" vid="ACT 19:25">«Xa̱bo̱ buanuu, ikháanꞌlaꞌ ndu̱ya̱álaꞌ rí ñajun rí nu̱ꞌne̱lóꞌ phú máján nuꞌdaalóꞌ mbúkha̱a̱ ga̱jma̱á numuu ne̱. <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />I̱ndo̱ó máꞌ numuu rí ikháanꞌlaꞌ ndu̱ya̱álaꞌ jamí nu̱dxawíínlaꞌ rí xa̱bo̱ tsí mbiꞌyuu Páblo̱, na̱ꞌngo̱o̱ naꞌne-rájíi̱n xa̱bo̱, ra̱ꞌkhá máꞌ i̱ndo̱ó ná Éfe̱so̱, rí asndo xó mbá xúgíí máꞌ ná numbaa Ásia̱. Naꞌthúu̱n xa̱bo̱ rí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún tsí nune̱-ku̱mii xa̱bo̱ ga̱jma̱á ñawúún. <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />Ra̱ꞌkhá máꞌ i̱ndo̱ó ngamí rí náxúya̱-makuíí xa̱bo̱ ñajun rí nu̱ꞌne̱lóꞌ, rí mangaa máꞌ ngamí rí náxúya̱-makuíí xa̱bo̱ guꞌwá dxákuiin ru̱dálóꞌ Diána̱, tsí maphú mba̱a̱, xúꞌkhue̱n máꞌ ngamí rí náxágu̱ma-mba̱a̱ gúne̱ xa̱bo̱ xómá rí na̱gu̱ma-mba̱a̱ xúge̱ꞌ ene̱ mbá xúgíin xa̱bo̱ tsí júwa̱ꞌ ná numbaa Ásia̱, jamí mbá xúgíí numbaa».<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />Ído̱ ni̱dxawíi̱n ajngáa rúꞌkhue̱n, a̱ꞌkhue̱n phú nijiꞌníi̱, jamí ni̱ndxa̱ꞌwe̱e̱ xáꞌnii: «¡Maphú mba̱a̱ Diána̱, ru̱dúún xa̱bo̱ Éfe̱so̱!». <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />Jamí mbá ni̱ngra̱ꞌaa idxu̱ún mbá xúgíin xa̱bo̱ xuajen. A̱ꞌkhue̱n nigóo̱-ragáñúu̱ ná guꞌwá rí na̱gi̱mbíin a̱pha̱ xa̱bo̱ xuajen, jamí nigóo̱-ru̱xma̱taa̱ Gáyo̱ ga̱jma̱á Aristárko̱, tsí naguwá ná numbaa Masedónia̱, tsí ngrigu̱ún gajmíí Páblo̱. <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />A̱ꞌkhue̱n Páblo̱ ndiyoo ma̱ga̱jnúu maꞌthúún xa̱bo̱ xuajen, xómáꞌ tsí nanimbu̱únꞌ juyáá Jesús túni̱ꞌñáa̱ rí ma̱ga̱jnúu̱. <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />Jamí mangaa máꞌ mbá tikhuun xa̱bo̱ ñajun tsí júwa̱ꞌ ná numbaa Ásia̱, tsí ñajúún iyanga̱jwe̱e Páblo̱, ni̱xu̱ꞌmee̱ ajngáa inuu̱, nuthán-jáñíi̱ rí ma̱xáꞌgee̱ ná guꞌwá rí na̱gi̱mbíin a̱pha̱ xa̱bo̱ xuajen. <verse eid="ACT 19:31" /><verse number="32" style="v" sid="ACT 19:32" />Mbá tikhuun xa̱bo̱ mbá xó i̱ndxa̱ꞌwa̱, jamí i̱ꞌwíin i̱mba̱ xó i̱ndxa̱ꞌwa̱. Numuu rí mbá ni̱ngra̱ꞌaa idxúu̱n, jamí tsí i̱tha̱án mbaꞌiin ni tsíyáá náá numuu kajngó niwii̱n ikhín. <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />Jamí ná majñu̱ú xa̱bo̱ tsí mbaꞌiin, xa̱bo̱ judío̱ ni̱ríya̱a̱ꞌ Alejándro̱ jamí ni̱rmajngua̱a̱ꞌ kajngó ma̱wi̱ji̱i̱ ná inúú mbá xúgíin xa̱bo̱ maꞌthée̱n. A̱ꞌkhue̱n Alejándro̱ niꞌnii̱ ñawúu̱n kajngó ma̱ꞌne-wíyuu rawúún xa̱bo̱, numuu rí nandoo̱ maꞌthán-mbáa̱ ga̱jma̱á numúú xa̱bo̱ judío̱ ná inúú xa̱bo̱ xuajen. <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />I̱ndo̱ó máꞌ numuu rí ído̱ ndiyáa̱ rí xa̱bo̱ judío̱ ñajuu̱n, a̱ꞌkhue̱n mbá xúgíin xa̱bo̱ ni̱ru̱wa̱a a̱ꞌwúún jamí ni̱ndxa̱ꞌwe̱e̱ mbóó ikhaa máꞌ ajngáa awúun rí xó a̱jma̱ wáa kíxnuu iduu ajwa̱nꞌ: «¡Maphú mba̱a̱ Diána̱, ru̱dúún xa̱bo̱ Éfe̱so̱!».<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />A̱ꞌkhue̱n xa̱bo̱ tsí naꞌne i̱yi̱i̱ꞌ ná guꞌwá-ñajun, ído̱ ni̱ꞌngo̱o̱ niꞌnii̱ rí ma̱ꞌne-wíyuu gúne̱ xa̱bo̱ tsí mbaꞌiin, a̱ꞌkhue̱n niꞌthée̱n: «Xa̱bo̱ buanuu Éfe̱so̱, mbá xúgíin nduyáá rí xa̱bo̱ xuajen Éfe̱so̱ nu̱ña̱wa̱án guꞌwá dxákuiin Diána̱ tsí maphú mba̱a̱, xúꞌkhue̱n máꞌ nu̱ña̱wáa̱n xtiꞌkhuu̱ rí ni̱ga̱taa ná Júpi̱te̱r.<note caller="+" style="f"><char style="fr" closed="false">19.35 </char><char style="ft" closed="false">Ríga̱ i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «ni̱ga̱taa ná mikhuíí».</char></note> <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />Numuu rí ndawa̱a̱ tsí maꞌthán rí na̱nguá gakon rúꞌkhue̱n, ikhaa jngó ndaꞌyóo rí mu̱ne̱laꞌ wíí, jamí gu̱ndxa̱ꞌwa̱-mijná májánlaꞌ rí mu̱ne̱laꞌ. <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />Numuu rí niguwa ju̱diinlaꞌ xa̱bo̱ tsíge̱ꞌ ge̱jyoꞌ, tsí ni máꞌ túne̱-ku̱ꞌwá ná guꞌwá dxákuiin ru̱dálaꞌ<note caller="+" style="f"><char style="fr" closed="false">19.37 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «ru̱dálóꞌ».</char></note> ni máꞌ túthee̱n xkawe̱ꞌ ga̱jma̱á numuu̱. <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />Xí Demétrio̱ jamí tsí nu̱ñajun ga̱jma̱á nindxu̱u̱ guáꞌdáá xkujndu ga̱jma̱á nindxu̱u̱ mbáa xa̱bo̱, ikhaa numuu rúꞌkhue̱n júwa̱ꞌ xa̱bo̱ ñajun tsí nu̱ra̱jwa̱ꞌ. Gagóo̱ gúríguii̱ ajngáa rí guáꞌdáa̱ ná inúu̱ ikhii̱n jamí ikhín máꞌ gúne̱-mbánu-mijnée̱. <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />Jamí xí ríga̱ i̱mba̱ rí nu̱tha̱nlaꞌ numuu rá, gu̱rígulaꞌ ne̱ ná na̱gi̱mbíin xa̱bo̱ ñajun kajngó ma̱mba̱núu numuu ne̱. <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />Numuu rí ga̱jma̱á numuu rí niríga̱ xúge̱ꞌ ngamí ma̱rigu tsu̱da̱ꞌlóꞌ rí nu̱xkaxi̱i̱lóꞌ xkujndu ná xuajen, numuu rí nda̱a̱ nimbá rí ma̱goo mu̱ꞌthánlóꞌ numuu ga̱jma̱á numuu rí niríga̱ xúge̱ꞌ». <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />Jamí ído̱ wámbo̱o̱ niꞌthée̱n ajngáa rúꞌkhue̱n, a̱ꞌkhue̱n niꞌthán-ngawúu̱n xa̱bo̱ tsí ni̱gi̱mbíin.<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s">Páblo̱ na̱ka̱ ná numbaa Masedónia̱ jamí ná Grésia̱</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />Nda̱wa̱á ído̱ neꞌne-wíyuu xkujndu rí niríga̱, a̱ꞌkhue̱n Páblo̱ nindxaꞌwúún tsí nanimbu̱únꞌ juyáá Jesús. Niꞌthán-múꞌúu̱n jamí nigo̱raꞌii̱n, a̱ꞌkhue̱n niꞌthán-ngawúu̱n jamí nigájnuu̱ rí ma̱ꞌgee̱ ná numbaa Masedónia̱. <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />A̱ꞌkhue̱n ni̱ka̱-rangroꞌoo̱ ná numbaa rúꞌkhue̱n, jamí naxnáa̱ la guéño tsiakhe̱ a̱ngia̱nꞌlóꞌ ga̱jma̱á ajngáa rí naꞌthúu̱n. Nda̱wa̱á ni̱ga̱níi̱ ná numbaa Grésia̱. <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />Ikhín nixtáa̱ mbá atsúun go̱nꞌ. Jamí inu máꞌ xtáa̱ ma̱jngúu̱n ná awúun guꞌwá-rguwa rí ma̱ꞌgee̱ ná Síria̱, ído̱ nidxawuu̱n rí xa̱bo̱ judío̱ ríga̱ rí muñíi̱ ná ma̱ꞌgee̱, a̱ꞌkhue̱n niꞌgí-mine̱e̱ꞌ rí ma̱thangaa̱ ná Masedónia̱. <verse eid="ACT 20:3" /><verse number="4" style="v" sid="ACT 20:4" />Jamí nigóó mbá tikhuun xa̱bo̱ ga̱jma̱á nindxu̱u̱ asndo ná Ásia̱: Sópa̱te̱r tsí na̱ꞌkha̱ ná Beréa̱, Aristárko̱ ga̱jma̱á Segúndo̱ tsí naguwá ná Tesalóni̱ka̱, Gáyo̱ tsí na̱ꞌkha̱ ná Dérbe̱, jamí Timotéo̱, xúꞌkhue̱n máꞌ Tíki̱ko̱ jamí Trófi̱mo̱, tsí naguwá ná numbaa Ásia̱. <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />Ikhiin xa̱bo̱ tsíge̱ꞌ nigóó ginuu jamí niguáꞌtha̱nꞌxo̱ꞌ ná xuajen Tróa̱s. <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />Xómáꞌ ikháanꞌxo̱ꞌ nijnguánxo̱ꞌ ná awúun guꞌwá-rguwa ná Filípo̱s ído̱ ninújngoo ndxa̱a̱ rí naꞌpho̱ xa̱bo̱ guma bopho rí na̱nguá gíꞌdoo ñu̱u̱ miga̱ꞌ, jamí awúun rí witsu mbiꞌi nimbáxi̱iꞌ gajmiáxo̱ꞌ ná xuajen Tróa̱s. Ikhín máꞌ ninguanáxo̱ꞌ mbá juwan mbiꞌi.<verse eid="ACT 20:6" /></para>
  <para style="s">Naꞌthángoo Páblo̱ ná Tróa̱s</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />Mbiꞌi ginii rí ndayáa semána̱ niwi̱in mbá ꞌnduꞌ<note caller="+" style="f"><char style="fr" closed="false">20.7 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «niwa̱ánꞌxo̱ꞌ mbá ꞌnduꞌ».</char></note> tsí nanimbu̱únꞌ juyáá Jesús kajngó mune̱-ri̱yaa̱ꞌ rí nikueꞌtso-añuu Jesús, jamí Páblo̱ naꞌsngúu̱n. I̱ndo̱ó máꞌ numuu rí i̱mba̱ mbiꞌi ma̱ga̱jnúu̱ ma̱ꞌgee̱, ikhaa jngó niꞌthúu̱n asndo mbá tikhuu mbroꞌon. <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />Jamí phú mbaꞌa agu tráma nakha rí nambiꞌi ná awúun guꞌwá ri̱jma̱á ná gachúu̱n. <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />Jamí mbáa dxáma mbiꞌyuu Eutíko̱ ꞌgí ná rawuun iduu guꞌwá. Xómá Páblo̱ naꞌthán-ráꞌa mba̱yo̱ꞌ, ikhaa jngó niꞌgu me̱do̱ dxáma, jamí nixpátríguíi̱ atsú ja̱rngo̱xe̱ rí tsída̱ꞌ guꞌwá. Ído̱ nigóo̱ gúxu̱xíi̱, a̱ꞌkhue̱n ndiyáa̱ rí nijáñuu̱. <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />A̱ꞌkhue̱n ni̱ga̱taa Páblo̱, ni̱mba̱tsra̱ꞌmá-mine̱e̱ꞌ ná inuu dxáma, jamí ndiyáraꞌaa̱. A̱ꞌkhue̱n niꞌthée̱n: «¡Ma̱xámíñalaꞌ, ndaꞌyee̱!». <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />Ído̱ nitsimaa̱ neꞌne-ri̱yaa̱ꞌ rí nikueꞌtso-añuu Jesús gajmíi̱ jamí nipiꞌtsii̱, nda̱wa̱á a̱ꞌkhue̱n niꞌthúu̱n xóó asndo watse. A̱ꞌkhue̱n nigájnuu̱ ni̱ke̱e̱. <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />Xómáꞌ dxáma, ndaꞌya nigúu̱n juya̱a̱ ná guꞌwóo, jamí phú mba̱a̱ niꞌni̱i a̱kuíi̱n neꞌne.<verse eid="ACT 20:12" /></para>
  <para style="s">Páblo̱ na̱ka̱ ná xuajen Miléto̱</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />A̱ꞌkhue̱n ikháanꞌxo̱ꞌ, wapha máꞌ nijnguánxo̱ꞌ ná awúun guꞌwá-rguwa rí na̱ka̱ ná xuajen Asón, numuu rí ikhín nimbánuu rí mbu̱ya̱axo̱ꞌ Páblo̱. Xkuaꞌnii nimbánaxo̱ꞌ numuu rí ikhaa̱ ndiyoo̱ ma̱ꞌgee̱ nakhúu̱ asndo ikhín. <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />Ído̱ ni̱xkama̱axo̱ꞌ Páblo̱ ná xuajen Asón, a̱ꞌkhue̱n nijngúu̱n ná awúun guꞌwá-rguwa ga̱jma̱á nindxa̱ꞌxo̱ꞌ jamí nikuáxo̱ꞌ ná xuajen Mitiléne̱. <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />Nigájnaxo̱ꞌ ikhín, i̱mba̱ mbiꞌi niguáꞌnúxo̱ꞌ ná kri̱doo Kío̱. Jamí i̱mba̱ mbiꞌi niguáꞌnúxo̱ꞌ ná Sámo̱s. Niwajúnxo̱ꞌ kajngó mbu̱ya̱a xa̱ꞌxo̱ꞌ ná Trojílio̱,<note caller="+" style="f"><char style="fr" closed="false">20.15 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «Niwajúnxo̱ꞌ kajngó mbu̱ya̱axa̱ꞌxo̱ꞌ ná Trojílio̱».</char></note> jamí i̱mba̱ mbiꞌi niguáꞌnúxo̱ꞌ ná xuajen Miléto̱. <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />Páblo̱ niꞌgí-mina̱ꞌ rí ma̱xánújngoo̱ ná xuajen Éfe̱so̱, kajngó ma̱xágajyúu̱ ná numbaa Ásia̱, numuu rí nacho̱o̱ ma̱ga̱níi̱ ná Jerusalén kajngó ma̱xtáa̱ ikhín ído̱ ma̱ꞌne ndxa̱a̱ Pentekostés, xí numuu rí na̱ꞌngo̱o̱ na̱ga̱níi̱ wapha.<verse eid="ACT 20:16" /></para>
  <para style="s">Páblo̱ naꞌthán-ngáwúún xa̱bo̱ buanuu tsí júwa̱ꞌ ná Éfe̱so̱</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />Awúun máꞌ rí xtáa Páblo̱ ná xuajen Miléto̱, nixuꞌmee̱ ajngáa ná inúú xa̱bo̱ buanuu tsí juya̱ idxu̱ún tsí nanimbu̱únꞌ juyáá Jesús ná Éfe̱so̱, nandxaꞌwúu̱n rí ma̱guwée̱ꞌ. <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />Ído̱ niguáꞌníi̱ ná inuu̱, a̱ꞌkhue̱n ikhaa̱ niꞌthúu̱n: «Ikháanꞌlaꞌ ndu̱ya̱álaꞌ xáne nixtáálo̱ꞌ ná majña̱ꞌlaꞌ mbá xúgíí mbiꞌi, asndo nákhí mbiꞌi ginii rí ni̱to̱ꞌo̱ꞌ ná numbaa Ásia̱. <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />Ni̱xrígú-mina̱ꞌ mbá jayu rí ne̱ne̱lo̱ꞌ ñajuun Táta̱, phú ni̱mbi̱ya̱ꞌlo̱ꞌ, jamí nika-ranújngoꞌ mbaꞌa inii gaꞌkho̱ rí ni̱ꞌgí-mijná xa̱bo̱ judío̱ rí muñi̱ꞌ. <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />Xúꞌkhue̱n máꞌ ndu̱ya̱álaꞌ rí táni̱ꞌñúu rí ma̱tha̱nꞌlaꞌ mbá xúgíí rí mambáyálaꞌ. Ni̱sngálaꞌ ná inúú xa̱bo̱, jamí ná guꞌwálaꞌ. <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />Na̱sngúúnlo̱ꞌ xa̱bo̱ judío̱ jamí xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún rí ma̱thangii̱n ná inuu Ana̱ꞌlóꞌ, jamí na̱sngúu̱nlo̱ꞌ rí mu̱tsijii̱ a̱kuíi̱n ná inuu Táta̱ Jesukrísto̱.<verse eid="ACT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 20:22" />»Rí xúge̱ꞌ rá, Xu̱u̱ꞌ Ana̱ꞌlóꞌ na̱tsu̱dúún rí ma̱ꞌgá ná Jerusalén, jamí ni máꞌ tsíyo̱o̱ dí ñajuun rí ma̱gíꞌnuꞌ ikhín. <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />I̱ndo̱ó máꞌ nda̱yo̱o̱ rí mbá xúgíí xuajen ná nakalo̱ꞌ, Xu̱u̱ꞌ Ana̱ꞌlóꞌ naꞌthínꞌ rí ma̱ꞌgálo̱ꞌ géjwa̱nꞌ jamí ma̱mínu̱u̱ꞌ. <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />I̱ndo̱ó máꞌ numuu rí asndo nimbá máꞌ tsíꞌgíi idxu̱ꞌlo̱ꞌ, ni máꞌ tsíndxa̱ꞌwa̱-mina̱ꞌ rí gíꞌdoo numuu mbiꞌyuꞌ. Rí phú i̱tha̱án gíꞌdoo numuu ñajuun rí ma̱mbóꞌ ma̱ne̱ ñajun rí nixníꞌ Táta̱ Jesús ma̱ne̱, rí ma̱tha̱n-ráꞌa ajngáa máján rí nasngájma rí Ana̱ꞌlóꞌ nandoo jaꞌyalóꞌ.<verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />»Jamí xúge̱ꞌ rá, nda̱yo̱o̱lo̱ꞌ rí nimbáa tsí ikháanꞌlaꞌ náxáyoꞌ, ikháanꞌlaꞌ tsáanꞌ nijuwalaꞌ ga̱jma̱á nindxu̱ꞌ awúun máꞌ rí naka-ra̱sngálaꞌ ga̱jma̱á numuu rí Ana̱ꞌlóꞌ ñajuun tsí naꞌthán-ñájúún xa̱bo̱. <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />Ikhaa jngó, ikhúúnꞌ na̱tha̱nꞌlaꞌ mbiꞌi xúge̱ꞌ rí na̱nguá gíꞌmúú aꞌkhán xí mbáa tsí ikháanꞌlaꞌ ma̱xájríya̱a̱ꞌ. <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />Numuu rí ikhúúnꞌ tárkaꞌwu nitháan rí naꞌgí-mina̱ꞌ Ana̱ꞌlóꞌ rí ma̱ꞌne, rí ni̱tha̱nꞌlaꞌ ne̱ mbá xúgíí. <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />Ikhaa jngó, gu̱ña̱wa̱n-mijná máꞌ ikháanꞌlaꞌ, jamí gu̱ña̱wu̱únlaꞌ mbá xúgíin xa̱bo̱ tsí xómá xu̱kú mogo̱ jaꞌñúú. Numuu rí Xu̱u̱ꞌ Ana̱ꞌlóꞌ niskuíjñáaꞌlaꞌ rí ma̱nindxa̱ꞌlaꞌ xómá waxtú, rí mu̱ña̱wu̱únlaꞌ xa̱bo̱ tsí nanimbu̱únꞌ juyáá Táta̱,<note caller="+" style="f"><char style="fr" closed="false">20.28 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «Ana̱ꞌlóꞌ».</char></note> tsí ikhaa̱ máꞌ niꞌtsii̱n ga̱jma̱á iꞌdiuu̱. <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />Numuu rí ikhúúnꞌ nda̱yo̱o̱ rí ído̱ ma̱ꞌgálo̱ꞌ, a̱ꞌkhue̱n ma̱tu̱ꞌu̱ún ná majña̱ꞌlaꞌ xa̱bo̱ tsí xómá i̱ña̱ꞌ tsí namangu̱únꞌ jaꞌñúú. Ikhiin tsúꞌkhue̱n mune̱ rí mune̱-gámbi̱in tsí xómá mogo̱ jaꞌñúú. <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />Jamí ná majña̱ꞌlaꞌ máꞌ ikháanꞌlaꞌ ma̱tu̱xu̱ún xa̱bo̱ tsí musngáá rí mi̱nduwa, kajngó magóó tsu̱dúu̱n tsí nanimbu̱únꞌ juyáá Jesús. <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />¡Ikhaa jngó ga̱juwalaꞌ xawi! Ga̱rmáꞌáan a̱kia̱nꞌlaꞌ rí mbá atsú tsigu ga̱jma̱á jamínu̱ꞌ, mbiꞌíí mbruꞌwíín táni̱ꞌñúu ra̱tha̱n-múꞌúun mbámbáa tsí ikháanꞌlaꞌ.<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />»Jamí xúge̱ꞌ rá, a̱ngui̱nꞌ, na̱ni̱ꞌñálaꞌ ná ñawúun Ana̱ꞌlóꞌ, jamí na̱ni̱ꞌñálaꞌ ga̱jma̱á ajngáa rí nasngájma rí Ana̱ꞌlóꞌ nandoo jaꞌyalóꞌ. Ajngáa rúꞌkhue̱n gíꞌdoo tsiakhe̱ rí ma̱ꞌne rí ma̱gajáanꞌlaꞌ, jamí maxnálaꞌ ne̱ rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ maxnúú mbá xúgíin tsí na̱gu̱ma-jaꞌwu̱un. <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />Táni̱gu̱ꞌ rí ma̱gúꞌdo̱ꞌ drígo̱o̱ nimbáa, ni máꞌ mbúkha̱a̱ ajwa̱nꞌ miꞌxá drígo̱o̱, ni máꞌ mbúkha̱a̱ ajwa̱nꞌ mo̱jmo̱ꞌ drígo̱o̱, ni máꞌ xtíñuu̱. <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />Ikháanꞌ ndu̱ya̱á májánlaꞌ rí ni̱ñajun ga̱jma̱á ñawúnꞌ kajngó mba̱ꞌyá mbá xúgíí rí ndaꞌyóꞌ ma̱xtáá ga̱jma̱á, xúꞌkhue̱n máꞌ rí ndaꞌñúú tsí gajmíꞌ. <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />Jámba̱ miꞌtsú ni̱sngálaꞌ rí xkuaꞌnii jaꞌyoo mu̱ñajunlóꞌ kajngó ma̱goo mu̱mbáñúúlóꞌ tsí ndaꞌñúú, jamí ma̱rmáꞌáan a̱kia̱nꞌlóꞌ ajngáa rí niꞌthán Táta̱ Jesús: “I̱tha̱án máꞌ gagi xtáa tsí naxná xó rí tsí na̱grui̱gú”».<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />Ído̱ wámbo̱o̱ Páblo̱ niꞌthán ajngáa rúꞌkhue̱n, a̱ꞌkhue̱n nismáti̱go̱o̱ jamí niꞌthán-jáñuu̱ Ana̱ꞌlóꞌ gajmíi̱ mbá xúgíin xa̱bo̱ buanuu tsúꞌkhue̱n. <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />A̱ꞌkhue̱n mbá xúgíi̱n phú nu̱mbi̱ye̱e̱ꞌ, xúꞌkhue̱n máꞌ nduya̱raꞌaa̱ Páblo̱, jamí nu̱raꞌníi̱ inuu. <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />Jamí phú nadaa a̱kuíi̱n ga̱jma̱á numuu ajngáa rí niꞌthán Páblo̱, rí ni miꞌtsú náxúyáa̱. A̱ꞌkhue̱n nigóo̱ ga̱jma̱á nindxu̱u̱ asndo ná nijngúu̱n awúun guꞌwá-rguwa.<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s">Páblo̱ na̱ka̱ ná Jerusalén</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />Ído̱ wámba̱ꞌxo̱ꞌ ni̱tha̱n-ngáwúún xa̱bo̱ buanuu tsúꞌkhue̱n, a̱ꞌkhue̱n nijnguánxo̱ꞌ ná awúun guꞌwá-rguwa jamí nikuá-jmbaxo̱ꞌ ná Kós. Asndo i̱mba̱ mbiꞌi nikuáxo̱ꞌ ná Róda̱s, jamí ikhín nigájnaxo̱ꞌ nikuáxo̱ꞌ ná xuajen Páta̱ra̱. <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />Ikhín ni̱xkamaaxo̱ꞌ mbá guꞌwá-rguwa rí na̱ka̱ ná numbaa Fenísia̱. Nijnguánxo̱ꞌ ná awúun ne̱ jamí nikuáxo̱ꞌ. <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />Ído̱ nakuá-ranújngaxo̱ꞌ, a̱ꞌkhue̱n ndi̱ya̱áxo̱ꞌ ná ñawún xti̱ya̱ꞌxo̱ꞌ Chípre̱, mbaa rí kua̱ꞌa̱n ná awúun iya a̱pha̱. Ni̱ni̱ꞌñááxo̱ꞌ ne̱ jamí nikuáxo̱ꞌ ná numbaa Síria̱. A̱ꞌkhue̱n niguáꞌnúxo̱ꞌ ná xuajen Tíro̱, numuu rí ikhín ma̱ga̱taa rí jago̱ guꞌwá-rguwa. <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />Ikhín ni̱xkamiixo̱ꞌ tsí nanimbu̱únꞌ juyáá Jesús, jamí ninguanáxo̱ꞌ mbá juwan mbiꞌi ga̱jma̱á nindxúu̱n. Ikhiin tsúꞌkhue̱n waꞌthán-múꞌúún neꞌne Xu̱u̱ꞌ Ana̱ꞌlóꞌ, a̱ꞌkhue̱n nitháa̱n Páblo̱ rí ma̱xáꞌga ná Jerusalén. <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />Ído̱ ninújngoo mbá juwan mbiꞌi rúꞌkhue̱n, a̱ꞌkhue̱n nigájnaxo̱ꞌ asndo ná rawuun xuajen. Nigóó mbá xúgíin a̱ngia̱nꞌlóꞌ ga̱jma̱á nindxa̱ꞌxo̱ꞌ, gajmíi̱ gu̱ꞌwíi̱n jamí i̱jíi̱n. A̱ꞌkhue̱n ni̱sma̱tíga̱ꞌxo̱ꞌ ná rawuun iya a̱pha̱ jamí ni̱tha̱n-jáñííxo̱ꞌ Ana̱ꞌlóꞌ. <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />A̱ꞌkhue̱n ni̱daraꞌa-mijnáxo̱ꞌ rí nu̱tha̱n-ngáwo-mijnáxo̱ꞌ, jamí nijnguánxo̱ꞌ ná awúun guꞌwá-rguwa, xómáꞌ ikhii̱n nithangii̱n ná guꞌwúu̱n.<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />Ikháanꞌxo̱ꞌ ni̱gíꞌma̱a jamba̱ꞌxo̱ꞌ ná xuajen Tíro̱ jamí niguáꞌnúxo̱ꞌ ná xuajen Tolemáida̱, jamí asndo ikhín wámba̱ꞌxo̱ꞌ rí nakuáxo̱ꞌ ga̱jma̱á guꞌwá-rguwa. Ikhín ni̱ra̱xi̱inxo̱ꞌ a̱ngia̱nꞌlóꞌ, jamí ninguanáxo̱ꞌ mbá mbiꞌi ga̱jma̱á nindxúu̱n. <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />Ído̱ watse rí i̱mba̱ mbiꞌi, nigájnuu Páblo̱ jamí tsáanꞌ juwaxo̱ꞌ ga̱jma̱á nindxu̱u̱,<note caller="+" style="f"><char style="fr" closed="false">21.8 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «nigájnuu Páblo̱ jamí tsáanꞌ juwaxo̱ꞌ ga̱jma̱á nindxu̱u̱».</char></note> nikuáxo̱ꞌ ná xuajen Sesaréa̱. A̱ꞌkhue̱n niguáꞌnúxo̱ꞌ ná guꞌwóo Felípe̱ tsí naꞌthán-ráꞌa ajngáa máján, mbáa máꞌ tsí mbá juwiin nu̱mbáyíjmáá. Ikhín máꞌ niwajúnxo̱ꞌ ná guꞌwóo̱. <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />Jamí ikhaa̱ gíꞌdii̱n mbá akhu̱un i̱jii̱n go̱ꞌo̱ tsí xóó túnu̱ju̱nꞌ, tsí nu̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ. <verse eid="ACT 21:9" /><verse number="10" style="v" sid="ACT 21:10" />Naꞌne máꞌ timbá wátha̱ wáa mbiꞌi rí juwaxo̱ꞌ ikhín, a̱ꞌkhue̱n ni̱ga̱nú mbáa xa̱bo̱ tsí na̱ꞌkha̱ ná numbaa Judéa̱. Ikhaa tsúꞌkhue̱n mbiꞌyuu Agábo̱, jamí na̱gu̱wíjngaa̱ ajngóo Ana̱ꞌlóꞌ. <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />Ni̱ꞌkhe̱e̱ gáꞌyaxo̱ꞌ, jamí niwatuu̱n xtá smídúu Páblo̱, a̱ꞌkhue̱n niroꞌwóo̱ nakhúu̱ jamí ñawúu̱n. A̱ꞌkhue̱n niꞌthée̱n: «Xáꞌnii iꞌthán Xu̱u̱ꞌ Ana̱ꞌlóꞌ: “Xáꞌnii ma̱xtoꞌwóo xa̱bo̱ tsí xtá smídúu ríge̱ꞌ gúne̱ xa̱bo̱ judío̱ ná Jerusalén, jamí mu̱xna̱xíi̱ ná ñawúún xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún”».<verse eid="ACT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12" />Ído̱ ni̱dxawíínxo̱ꞌ ajngáa rúꞌkhue̱n, a̱ꞌkhue̱n ikháanꞌxo̱ꞌ jamí xa̱bo̱ tsí júwa̱ꞌ ikhín, ni̱tha̱n-jáñííxo̱ꞌ Páblo̱ rí ma̱xáꞌgee̱ ná Jerusalén.<verse eid="ACT 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 21:13" />A̱ꞌkhue̱n Páblo̱ niriꞌña: «Náá numuu kajngó nu̱mbi̱ya̱ꞌlaꞌ jamí nu̱ne̱laꞌ rí ma̱ꞌdaa a̱kui̱nꞌ róꞌ. Numuu rí ikhúúnꞌ xtáá na̱ma̱ñuꞌ, ra̱ꞌkhá i̱ndo̱ó rí ma̱xtoꞌóꞌ, rí mangaa asndo ma̱ja̱ñúꞌ ná Jerusalén ga̱jma̱á numuu Táta̱ Jesús».<verse eid="ACT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 21:14" />Ikháanꞌxo̱ꞌ táꞌnga̱ꞌxo̱ꞌ gáwajúnꞌthíi̱n rí ma̱xáꞌgee̱ ná Jerusalén, a̱ꞌkhue̱n ni̱ni̱ꞌñááxo̱ꞌ-ru̱tha̱n-jáñíi̱, jamí ni̱tha̱nxo̱ꞌ: «Ga̱gu̱ma xómá rí nandoo Táta̱».<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />Ído̱ ninújngoo máꞌ mbiꞌi rúꞌkhue̱n, a̱ꞌkhue̱n ne̱ne̱-mbáníí amaxo̱ꞌ jamí nikuáxo̱ꞌ ná Jerusalén. <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />Niguwá ga̱jma̱á nindxa̱ꞌxo̱ꞌ mbá tikhuun xa̱bo̱ Sesaréa̱ tsí nanimbu̱únꞌ juyáá Jesús, jamí niguwée̱ꞌ juya̱a̱ mbáa xa̱bo̱ tsí mbiꞌyuu Mnasón tsí na̱ꞌkha̱ ná Chípre̱. Ikhaa tsúꞌkhue̱n wajyúú máꞌ nanimbo̱o̱ꞌ jaꞌyoo Jesús jamí wéje̱ rí ma̱wajúnxo̱ꞌ ná guꞌwóo.<verse eid="ACT 21:16" /></para>
  <para style="s">Páblo̱ na̱ka̱ gáꞌyoo Santiágo̱</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />Ído̱ niguáꞌnúxo̱ꞌ ná Jerusalén, phú gagi a̱kui̱ín a̱ngia̱nꞌlóꞌ ni̱dríguáa̱nꞌxo̱ꞌ. <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />Jamí i̱mba̱ mbiꞌi, nikuá gajmiáxo̱ꞌ Páblo̱ kajngó mu̱ꞌguá gúya̱áxo̱ꞌ Santiágo̱,<note caller="+" style="f"><char style="fr" closed="false">21.18 </char><char style="ft" closed="false">Ná i̱yi̱i̱ꞌ griégo̱ rí wayuu naꞌthán «Jakóbo̱», rí nithán «Santiágo̱» ná ajngáa xtílo̱o̱.</char></note> jamí ikhín gatiin mbá ꞌnduꞌ mbá xúgíin xa̱bo̱ buanuu. <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />Jamí ído̱ wámbo̱o̱ Páblo̱ niraxii̱n, a̱ꞌkhue̱n niꞌthán-makúu̱n mbámbá rí neꞌne Ana̱ꞌlóꞌ ná majñu̱ú xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún ga̱jma̱á majñu̱u̱ ñajun rí naꞌnii̱. <verse eid="ACT 21:19" /><verse number="20" style="v" sid="ACT 21:20" />Ído̱ ni̱dxawíi̱n rúꞌkhue̱n, a̱ꞌkhue̱n nene̱-mba̱a̱ Ana̱ꞌlóꞌ, jamí nitháa̱n Páblo̱: «Dxájuꞌ, nathayáá máꞌ ikháánꞌ rí mbaꞌiin mi̱ndaꞌkho xa̱bo̱ judío̱ nanimbu̱únꞌ juyáá Jesús ge̱jyoꞌ. Jamí mbá xúgíi̱n na̱ju̱múu̱ rí ndaꞌyóo rí mu̱ꞌne̱-mbáníílóꞌ rí naꞌthán xtángoo. <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />I̱ndo̱ó máꞌ numuu rí nu̱dxawíi̱n rí ikháánꞌ narasngúún mbá xúgíin xa̱bo̱ judío̱ tsí júwa̱ꞌ ná majñu̱ú xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún rí mu̱xúne̱-mbáníi̱ xtángawoo Moisés, rí mu̱xúxnúu̱ tsina jndi i̱jíi̱n, ni máꞌ mu̱xúni̱i̱ rí nu̱ꞌne̱ jayalóꞌ. <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />Dí lá gúꞌne̱lóꞌ xúꞌkhue̱n rá. Numuu rí mu̱wi̱in máꞌ tsiakhe̱ mbaꞌiin xa̱bo̱ ído̱ gúdxawíi̱n rí nidxa̱ꞌ.<note caller="+" style="f"><char style="fr" closed="false">21.22 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán xáꞌnii: «Numuu rí mu̱dxawíín máꞌ tsiakhe̱ xa̱bo̱ rí nidxa̱ꞌ».</char></note> <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />Ikhaa jngó athane̱ rí mu̱tha̱a̱nꞌxo̱ꞌ: júwa̱ꞌ mbá akhu̱un a̱ngia̱nꞌxo̱ꞌ tsí jaꞌñúú mune̱-mbáníí rí ni̱xu̱ꞌdá-mijná ná inuu Ana̱ꞌlóꞌ. <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />Ayu gajmiáaꞌ jamí athane̱-jaꞌwu-mina̱aꞌ gajmiáaꞌ, jamí athane̱-numáá ikháánꞌ kajngó mi̱ꞌda̱-ráꞌtsa̱ tsu̱u̱n idxúu̱n. Xkuaꞌnii jngó mbá xúgíin xa̱bo̱ mbuyáá rí ra̱gákon rí nu̱dxawíi̱n ga̱jma̱á numaaꞌ, rí mangáánꞌ máꞌ xtaa nathane̱-mbáníí rí naꞌthán xtángoo. <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" />Xómáꞌ xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún rá, tsí ninimbu̱únꞌ juyáá Jesús, ikháanꞌxo̱ꞌ ni̱xu̱ꞌmáxo̱ꞌ máꞌ mbá i̱yi̱i̱ꞌ inúu̱ ná nu̱thúu̱nxo̱ꞌ rí mu̱xúne̱-mbáníi̱ nimbá rúꞌkhue̱n, rí i̱ndo̱ó máꞌ<note caller="+" style="f"><char style="fr" closed="false">21.25 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «rí mu̱xúne̱-mbáníi̱ nimbá rúꞌkhue̱n, rí i̱ndo̱ó máꞌ».</char></note> rí mu̱xúphi̱i̱ rí waxnáxe̱ ná inúú tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún, rí mu̱xúphi̱i̱ iꞌdi, ni máꞌ mu̱xúphi̱i̱ xuñúú xu̱kú tsí nixngáwúun, jamí mu̱xúbúu̱n gajmíi̱ xa̱bo̱ tsí túya̱a̱».<verse eid="ACT 21:25" /></para>
  <para style="s">Nu̱rtuwii̱n Páblo̱ ná guꞌwá dxákuun</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />A̱ꞌkhue̱n Páblo̱ ni̱ka̱ gajmíí xa̱bo̱ tsúꞌkhue̱n. Jamí i̱mba̱ mbiꞌi, neꞌne-jaꞌwu-minaa̱ꞌ gajmíi̱, a̱ꞌkhue̱n ni̱to̱ꞌo̱o̱ ná guꞌwá dxákuun kajngó maꞌthée̱n nguáná ma̱ra̱ꞌmúu mbiꞌi rí nune̱-jaꞌwu-mijnáa̱, jamí nguáná jaꞌyoo rí mi̱xnáxe̱ tsi̱gi̱jña̱ꞌ ga̱jma̱á numuu mbámbáa tsí ikhii̱n.<verse eid="ACT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />I̱ndo̱ó máꞌ numuu rí ído̱ inu ma̱ra̱ꞌmúu juwan mbiꞌi, mbá tikhuun xa̱bo̱ judío̱ tsí niguwá ná Ásia̱ ndiyáá Páblo̱ ná guꞌwá dxákuun. A̱ꞌkhue̱n nini̱i̱ rí mbá xúgíin xa̱bo̱ tsí mbaꞌiin mu̱xu̱xí a̱ꞌwá, jamí ni̱rtuwii̱n Páblo̱. <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />Xáꞌnii nuthee̱n rí nu̱ndxa̱ꞌwe̱e̱: «¡Xa̱bo̱ buanuu Israél, gu̱mbáyíílaꞌ! Ikhaa xa̱bo̱ tsíge̱ꞌ ñajuun tsí ngroꞌoo mbá xúgíí numbaa naꞌsngúún xa̱bo̱ rí ra̱máján ga̱jma̱á numuu xuajñalóꞌ, ga̱jma̱á numuu xtángoo, jamí ga̱jma̱á numuu guꞌwá ríge̱ꞌ. Jamí ra̱ꞌkhá máꞌ i̱ndo̱ó rúꞌkhue̱n, rí mangaa máꞌ nixudii̱n xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún ná guꞌwá dxákuun. ¡Tsíya-makuu̱ guꞌwá ríge̱ꞌ rí jaꞌyoo Ana̱ꞌlóꞌ!».<verse eid="ACT 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 21:29" />Nuthee̱n rúꞌkhue̱n numuu rí nákhí wapha ndiyáa̱ ngrigo̱o̱ꞌ Páblo̱ ná awúun xuajen ga̱jma̱á Trófi̱mo̱, tsí na̱ꞌkha̱ ná Éfe̱so̱. Ikhii̱n ni̱ju̱múu̱ rí Páblo̱ ni̱ka̱ jayáa xa̱bo̱ tsúꞌkhue̱n ná guꞌwá dxákuun.<verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />Ikhaa jngó mbá xúgíin xa̱bo̱ xuajen ni̱xu̱xí a̱ꞌwá, jamí mbá nacha̱ ni̱gi̱mbúun mbaꞌiin xa̱bo̱. A̱ꞌkhue̱n ni̱rtuwii̱n Páblo̱ jamí ni̱xma̱taa̱ ni̱ríya̱a̱ꞌ rixa̱á, jamí mbá nacha̱ máꞌ ni̱ruguaa̱ xkrugoo guꞌwá dxákuun. <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />Jamí ído̱ rí inu máꞌ mu̱xíya̱a̱, a̱ꞌkhue̱n ni̱ka̱ ajngáa inuu xa̱bo̱ ede̱ drígu̱ún tsí ku̱ra̱tuun ajwa̱nꞌ, rí mbá xúgíin xa̱bo̱ Jerusalén mbá wee jayu ene̱. <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />A̱ꞌkhue̱n ikhaa̱ mbá nacha̱ máꞌ niguu̱n xa̱bo̱ tsí ku̱ra̱tuun ajwa̱nꞌ jamí tsí nuthan-ñajúún tsí ku̱ra̱tuun ajwa̱nꞌ, nigáyuu̱ ni̱ke̱e̱ ná gatiin xa̱bo̱ xuajen. Ído̱ rí xa̱bo̱ xuajen ndiyáá xa̱bo̱ ede̱ drígu̱ún tsí ku̱ra̱tuun ajwa̱nꞌ gajmíí máꞌ tsí ku̱ra̱tuun ajwa̱nꞌ, a̱ꞌkhue̱n ni̱ni̱ꞌñáa̱ rí nuxnáa̱ Páblo̱. <verse eid="ACT 21:32" /><verse number="33" style="v" sid="ACT 21:33" />Ído̱ ni̱ga̱nú xa̱bo̱ ede̱ drígu̱ún tsí ku̱ra̱tuun ajwa̱nꞌ, nixná-ñájúu̱n xa̱bii̱ rí mu̱rtuwii̱n Páblo̱, jamí mu̱ru̱ꞌwáa̱ ga̱jma̱á a̱jma̱ ñuu ajwa̱nꞌ. A̱ꞌkhue̱n niraxi̱i̱ tsáa ñajuu̱n jamí dí niꞌnii̱. <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />I̱ndo̱ó máꞌ numuu rí ná majñu̱ú xa̱bo̱ tsí mbaꞌiin, mbá tikhuun mbá xó i̱ndxa̱ꞌwa̱, xómá i̱ꞌwíin i̱mba̱ xó i̱ndxa̱ꞌwa̱. Ra̱ꞌkhóo madxawuu̱n rí gakon ga̱jma̱á numuu Páblo̱, numuu rí phú wee ene̱ xa̱bo̱. Ikhaa jngó nixná-ñájwii̱n rí ma̱ꞌga jiꞌyáa̱ ná guꞌwá rí gatiin xa̱bo̱ tsí ku̱ra̱tuun ajwa̱nꞌ. <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />Ído̱ niguáꞌníi̱ gajmíi̱ Páblo̱ ná adoo bibi rí natsimúú xa̱bo̱, a̱ꞌkhue̱n xa̱bo̱ tsí ku̱ra̱tuun ajwa̱nꞌ nidaa̱ Páblo̱, ga̱jma̱á numuu rí phú gakhe̱ namangu̱únꞌ xa̱bo̱ tsí mbaꞌiin. <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />Numuu rí mbá xúgíin xa̱bo̱ tsí naguwá tsu̱di̱í nu̱ndxa̱ꞌwa̱: «¡Ga̱ja̱ñúu̱!».<verse eid="ACT 21:36" /></para>
  <para style="s">Páblo̱ naꞌthúún xa̱bo̱ xuajen</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />Ído̱ rí inu máꞌ mu̱xu̱da̱a̱ꞌ ná guꞌwá rí gatiin xa̱bo̱ tsí ku̱ra̱tuun ajwa̱nꞌ, a̱ꞌkhue̱n Páblo̱ niꞌthúun xa̱bo̱ ede̱ drígúu̱n:</para>
  <para style="p" vid="ACT 21:37">―Á ma̱goo ma̱ndxákuun ga̱jma̱á nindxa̱a̱ꞌ mbégo rá.</para>
  <para style="p" vid="ACT 21:37">Jamí ikhaa̱ niꞌthée̱n:</para>
  <para style="p" vid="ACT 21:37">―Á narathán ajngáa griégo̱ dxe̱ꞌ. <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />Á ra̱ꞌkhá ikháánꞌ ñajwaanꞌ xa̱bo̱ Ejípto̱ tsí neꞌne xkujndu ná inuu xa̱bo̱ ñajun nákhí wapha, jamí ni̱ka̱ jagu̱un ná mbaa niníí mbá akho̱ míl (4 000) tsí nu̱radíin xa̱bo̱ rá.<verse eid="ACT 21:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39" />A̱ꞌkhue̱n niꞌthán Páblo̱:</para>
  <para style="p" vid="ACT 21:39">―Ikhúúnꞌ ñajunꞌ xa̱bo̱ judío̱, naꞌkha ná xuajen Társo̱, mbá xuajen rí phú gíꞌdoo numuu ná numbaa Silísia̱. I̱ndo̱ó máꞌ numuu rí na̱tha̱n-jáñaaꞌ rí ma̱ta̱tsi̱ꞌñúꞌ ma̱thu̱ún xa̱bo̱ xuajen.<verse eid="ACT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40" />Tsí naꞌthán-ñájúún tsí ku̱ra̱tuun ajwa̱nꞌ niꞌthán rí ma̱goo maꞌthée̱n. A̱ꞌkhue̱n Páblo̱ ni̱we̱je̱ ná adoo bibi rí natsimúú xa̱bo̱, jamí niꞌnii̱ ñawúu̱n rí mune̱ wíí xa̱bo̱. Ído̱ neꞌne-wíyuu rawúún xa̱bo̱, a̱ꞌkhue̱n niꞌthúu̱n ga̱jma̱á ajngáa ebréo̱:<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />«Xa̱bo̱ buanuu a̱ngui̱nꞌ jamí xa̱bo̱ buanuu ede̱, gu̱dxawíínlaꞌ rí ma̱tha̱n-mbáá ga̱jma̱á numuꞌ ná inalaꞌ».<verse eid="ACT 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 22:2" />Jamí ído̱ ni̱dxawíín xa̱bo̱ rí Páblo̱ naꞌthán ajngáa ebréo̱, a̱ꞌkhue̱n i̱tha̱án neꞌne-wíyuu rawúu̱n. A̱ꞌkhue̱n niꞌthúu̱n xóó:<verse eid="ACT 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3" />«Gakon máꞌ rí ikhúúnꞌ ñajunꞌ xa̱bo̱ judío̱, ni̱gu̱múú ná xuajen Társo̱ rí ꞌgí ná numbaa Silísia̱, i̱ndo̱ó máꞌ numuu rí niguju̱ún ná xuajen ríge̱ꞌ. Ne̱ne̱-gajma̱a̱ ná inuu táta̱ Gamaliél, xómá naꞌthán jayu xtángoo drígu̱ún táta̱-xi̱ꞌñálóꞌ wajyúú, jamí na̱ne̱-mbánuu mbá xúgíí rí nandoo Ana̱ꞌlóꞌ, xómá rí nu̱ne̱laꞌ mbá xúgiáanꞌlaꞌ xúge̱ꞌ. <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" />Ne̱ne̱-ngíníi mi̱ndaꞌkho jamí asndo ni̱gúdíin xa̱bo̱ tsí nanimbu̱únꞌ juyáá gisngáá drígo̱o̱ Jesús. Ni̱guátúun xa̱bekha jamí go̱ꞌo̱, ni̱xu̱ꞌdíi̱n ná géjwa̱nꞌ. <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />Tsí jayá idxu̱ún dxakuun, jamí mbá xúgíin xa̱bo̱ buanuu mangiin nduyáá rí xkuaꞌnii ne̱ne̱. Ikhii̱n nixniꞌ i̱yi̱i̱ꞌ rí ma̱go̱ ma̱xna̱xí ná inúú a̱ngia̱nꞌlóꞌ xa̱bo̱ judío̱ tsí júwa̱ꞌ ná Damásko̱. Nika ikhín kajngó mba̱ꞌñíi xa̱bo̱ tsúꞌkhue̱n, jamí ma̱ꞌkha ja̱guu̱n ná Jerusalén ge̱jyoꞌ, kajngó ma̱gu̱ma-ngíníi̱.<verse eid="ACT 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />»I̱ndo̱ó máꞌ numuu rí ído̱ inu ma̱gánú ná xuajen Damásko̱, xó mbá wakha̱ꞌ niníí wáa eꞌne, a̱ꞌkhue̱n nda̱a̱ ajngóo nimbiꞌi-taꞌa gakhe̱ ná inuꞌ mbá agu rí na̱ꞌkha̱ mikhuíí. <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />A̱ꞌkhue̱n nixpátri̱gu̱ún mbayíí, jamí ni̱dxawuun mbá a̱ꞌwá rí naꞌthínꞌ: “Sáu̱lo̱, Sáu̱lo̱, náá numuu kajngó nadxa̱ꞌ-raraxkoꞌ róꞌ”. <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />A̱ꞌkhue̱n ikhúúnꞌ ni̱riꞌña: “Tsáa ñajwaanꞌ róꞌ, Táta̱”. Jamí a̱ꞌwá niꞌthínꞌ: “Ikhúúnꞌ ñajunꞌ Jesús tsí na̱ꞌkha̱ ná Nasarét, tsí ikháánꞌ nadxo̱ꞌ-raraxkáá”. <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />Jamí xa̱bo̱ tsí nagóó ga̱jma̱á nindxu̱ꞌ gakon máꞌ rí ndiyáa̱ agu jamí nimíñúu̱,<note caller="+" style="f"><char style="fr" closed="false">22.9 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «jamí nimíñúu̱».</char></note> i̱ndo̱ó máꞌ numuu rí táfruꞌúu̱n a̱ꞌwóo tsí naꞌthán ga̱jma̱á nindxu̱ꞌ. <verse eid="ACT 22:9" /><verse number="10" style="v" sid="ACT 22:10" />A̱ꞌkhue̱n ni̱ra̱xu̱u̱lo̱ꞌ: “Dí jaꞌyoo ma̱ne̱ rá, Táta̱”. Jamí ikhaa̱ niꞌthínꞌ: “A̱tu̱xa̱a̱ꞌ mi̱dxo̱ꞌ ná Damásko̱. Ikhín mi̱ꞌtháanꞌ mbá xúgíí rí gíꞌmaa ma̱tha̱ne̱”.<verse eid="ACT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 22:11" />»A̱ꞌkhue̱n tsí naka gajmíꞌ ni̱ra̱tuu̱n ñawúnꞌ nigóo̱ juñúu̱ ná Damásko̱, numuu nánguá ifrigo̱ꞌ ga̱jma̱á numuu rí phú gakhi̱i̱ agu rí nimbiꞌi-taꞌa ná inuꞌ. <verse eid="ACT 22:11" /><verse number="12" style="v" sid="ACT 22:12" />Ikhín xtáa mbáa xa̱bo̱ tsí mbiꞌyuu Ananía̱s, tsí májáan a̱kui̱in xómá naꞌthán ná xtángoo, jamí máján kri̱ga̱ ajngáa ga̱jma̱á numuu̱ ná inúú mbá xúgíin xa̱bo̱ judío̱ tsí júwa̱ꞌ máꞌ ikhín. <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />Ikhaa̱ ni̱ꞌkhe̱e̱ gáꞌyeꞌ, jamí niꞌthínꞌ: “Dxájuꞌ Sáu̱lo̱, ga̱mba̱ꞌtha̱a la idaaꞌ”. A̱ꞌkhue̱n núkho̱ máꞌ ni̱ma̱ꞌtha̱a iduꞌ, jamí ndiyoo ndi̱yo̱o̱lo̱ꞌ.<verse eid="ACT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 22:14" />»Jamí ikhaa̱ niꞌthínꞌ: “Ana̱ꞌlóꞌ tsí ñajuun Anu̱ú táta̱-xi̱ꞌñálóꞌ niraꞌwíín rí ma̱tha̱ne̱-nuwiin rí nandoo̱ ma̱tha̱ne̱, xúꞌkhue̱n máꞌ rí ma̱tha̱ya̱á tsí Jmbii, jamí ma̱ta̱dxawíín ajngóo̱ rí maꞌtháa̱nꞌ máꞌ jmína̱a̱ꞌ. <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />Numuu rí ikháánꞌ ma̱ra̱tha̱n rí gakon ga̱jma̱á numuu̱ ikhaa̱ ná inúú mbá xúgíin xa̱bo̱. Ma̱ra̱tha̱n rí nithayáá jamí rí nitadxawíín. <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />Ikhaa jngó, rí xúge̱ꞌ rá, náxáraꞌthi̱ín xóó. A̱tu̱xa̱a̱ꞌ jamí gi̱xúꞌdu-maꞌáán ná awúun iya, xúꞌkhue̱n máꞌ a̱ta̱nda̱ꞌa̱á Ana̱ꞌlóꞌ rí ma̱ꞌne mba̱a̱ a̱kui̱in jaꞌyoo aꞌkháanꞌ”.<verse eid="ACT 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />»Ído̱ nithangu̱ún ná Jerusalén, awúun máꞌ rí xtáá na̱tha̱n-jáñuu Ana̱ꞌlóꞌ ná guꞌwá dxákuun, a̱ꞌkhue̱n ndi̱yo̱o̱ inu-mbiꞌíí. <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />Ndi̱yo̱o̱ Táta̱, jamí naꞌthínꞌ: “¡Nacha̱ gátha̱ne̱! A̱ga̱jnáaꞌ ná Jerusalén ge̱jyoꞌ. Numuu rí ma̱xánimbu̱únꞌ xa̱bo̱ rí ma̱ra̱thu̱ún ga̱jma̱á numuꞌ”. <verse eid="ACT 22:18" /><verse number="19" style="v" sid="ACT 22:19" />Xómáꞌ ikhúúnꞌ ni̱thu̱u̱n: “Táta̱, ikhii̱n nduyáa̱ rí ikhúúnꞌ nika-ra̱ꞌñíi ná awúun mbámbá guꞌwá rí na̱gi̱mbíin xa̱bo̱ judío̱ mbá xúgíin xa̱bo̱ tsí nanimbu̱únꞌ juyaaꞌ ikháánꞌ, kajngó ma̱xu̱ꞌdíi̱n ná géjwa̱nꞌ jamí ma̱ne̱-ngíníi̱. <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />Nákhí waꞌxnáá jamí nijáñuu Estéba̱n, tsí niꞌthúún xa̱bo̱ ga̱jma̱á numaaꞌ, mangúúnꞌ máꞌ nixtáá ikhín, jamí máján máꞌ neꞌne rí nijáñuu̱ i̱yo̱o̱, xúꞌkhue̱n máꞌ ni̱ña̱wu̱u̱n xtíñúú tsí ni̱xíya̱a̱”. <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />Xómáꞌ Táta̱ niꞌthínꞌ: “Ayu, numuu rí ikhúúnꞌ na̱xu̱ꞌmáá mi̱dxo̱ꞌ tsíngua̱ꞌ ná inúú xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún”».<verse eid="ACT 22:21" /></para>
  <para style="s">Xa̱bo̱ tsí ku̱ra̱tuun ajwa̱nꞌ nu̱ña̱wa̱án Páblo̱</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />Jamí xa̱bo̱ tsí mbaꞌiin ni̱dxawíín rí niꞌthán Páblo̱ asndo rí niꞌthée̱n ajngáa rúꞌkhue̱n. A̱ꞌkhue̱n ni̱gíꞌdíi̱n ni̱ndxa̱ꞌwe̱e̱, jamí nithee̱n: «¡Ga̱ja̱ñúu xa̱bo̱ tsúꞌkhue̱n! ¡Nda̱a̱ numuu rí ma̱xtáa̱!». <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />Numuu rí ikhii̱n nu̱ndxa̱ꞌwe̱e̱ máꞌ xúꞌkhue̱n, jamí nudataꞌée̱n xtíñúu̱ ga̱jma̱á yujnda̱ꞌ ná inuu gíñá, <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />a̱ꞌkhue̱n xa̱bo̱ ede̱ drígu̱ún tsí ku̱ra̱tuun ajwa̱nꞌ nixná-ñájun rí mu̱xu̱da̱a̱ꞌ Páblo̱ ná guꞌwá rí gachúu̱n. Xúꞌkhue̱n máꞌ nixná-ñájwii̱n rí mi̱xpáthii̱n kajngó maríye̱e̱ꞌ rawuu̱n náá numuu kajngó xkuaꞌnii nu̱ndxa̱ꞌwa̱ xa̱bo̱ xuajen ga̱jma̱á numuu̱. <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />I̱ndo̱ó máꞌ numuu rí ído̱ júwe̱e̱ꞌ nu̱ru̱ꞌwáa̱ kajngó mu̱xpa̱thíi̱n, a̱ꞌkhue̱n Páblo̱ niꞌthúun xa̱bo̱ tsí naꞌthán-ñájúún tsí ku̱ra̱tuun ajwa̱nꞌ tsí wéje̱ ikhín:</para>
  <para style="p" vid="ACT 22:25">―Á gíꞌmaa mu̱xpa̱thíinlaꞌ mbáa xa̱bo̱ Róma̱ tsí xóó tákujma aꞌkhúun rá.<verse eid="ACT 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26" />Ído̱ nidxawuun ajngáa rúꞌkhue̱n xa̱bo̱ tsí naꞌthán-ñájúún tsí ku̱ra̱tuun ajwa̱nꞌ, a̱ꞌkhue̱n ni̱ke̱e̱ gáꞌthúu̱n xa̱bo̱ ede̱ drígúu̱n: «Dí gátha̱ne̱ xúge̱ꞌ rá. Numuu rí xa̱bo̱ Róma̱ ñajuun xa̱bo̱ tsúꞌkhue̱n».<verse eid="ACT 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27" />A̱ꞌkhue̱n rí xa̱bo̱ ede̱ drígu̱ún tsí ku̱ra̱tuun ajwa̱nꞌ nixuꞌma-mina̱ꞌ jamí niraxu̱u̱ Páblo̱:</para>
  <para style="p" vid="ACT 22:27">―Arathúnꞌ, á gakon rí ikháánꞌ ñajwaanꞌ xa̱bo̱ Róma̱ dxe̱ꞌ.</para>
  <para style="p" vid="ACT 22:27">A̱ꞌkhue̱n Páblo̱ niriꞌña:</para>
  <para style="p" vid="ACT 22:27">―Aan, ikhaa ñajunꞌlo̱ꞌ.<verse eid="ACT 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28" />A̱ꞌkhue̱n niꞌthán xa̱bo̱ ede̱ drígu̱ún tsí ku̱ra̱tuun ajwa̱nꞌ:</para>
  <para style="p" vid="ACT 22:28">―Ikhúúnꞌ phú mba̱a̱ mbúkha̱a̱ niꞌkhu̱ꞌ kajngó ma̱nindxu̱ꞌ xa̱bo̱ Róma̱.</para>
  <para style="p" vid="ACT 22:28">A̱ꞌkhue̱n Páblo̱ niꞌthúu̱n:</para>
  <para style="p" vid="ACT 22:28">―Xómáꞌ ikhúúnꞌ ñajunꞌ xa̱bo̱ Róma̱ asndo nákhí ni̱gu̱múúlo̱ꞌ.<verse eid="ACT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29" />A̱ꞌkhue̱n tsí nune̱-mbáníí rí mu̱xpa̱thíin Páblo̱, nene̱-janíí-mijnée̱ ná inuu̱. Jamí asndo xa̱bo̱ ede̱ drígúu̱n máꞌ mangaa, ído̱ nidxawuu̱n rí Páblo̱ ñajuun xa̱bo̱ Róma̱, phú nimíñúu̱ numuu rí niroꞌwóo̱.<verse eid="ACT 22:29" /></para>
  <para style="s">Páblo̱ na̱ka̱ inúú xa̱bo̱ buanuu ede̱</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />I̱mba̱ mbiꞌi, xa̱bo̱ ede̱ drígu̱ún tsí ku̱ra̱tuun ajwa̱nꞌ ndiyoo mba̱ꞌyoo náá numuu kajngó xa̱bo̱ judío̱ nune̱ aꞌkhúun Páblo̱, ikhaa jngó nirakhúu̱ ñuu ajwa̱nꞌ rí xtoꞌwóo̱. A̱ꞌkhue̱n nindxaꞌwúu̱n dxakuun tsí gíꞌdoo numúú, jamí mbá xúgíin xa̱bo̱ buanuu ede̱, xúꞌkhue̱n máꞌ niríya̱a̱ꞌ Páblo̱, jamí ni̱ꞌkha̱ jayáa̱ ná inúú xa̱bo̱ tsúꞌkhue̱n.<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />A̱ꞌkhue̱n rí Páblo̱ niyaxu̱ún mbá xúgíin xa̱bo̱ buanuu ede̱, a̱ꞌkhue̱n niꞌthúu̱n: «Xa̱bo̱ buanuu a̱ngui̱nꞌ, asndo mbiꞌi máꞌ ríge̱ꞌ ikhúúnꞌ nda̱yo̱o̱ mújúnꞌ rí na̱nguá e̱ne̱ rí xkawe̱ꞌ xtáá ná inuu Ana̱ꞌlóꞌ».<verse eid="ACT 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 23:2" />A̱ꞌkhue̱n Ananía̱s, tsí jayá idxu̱ún dxakuun, nixná-ñájúu̱n tsí wájun mijngi ná inuu Páblo̱ rí muxnáa̱ rawuun. <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />A̱ꞌkhue̱n Páblo̱ niꞌthúu̱n: «¡Ana̱ꞌlóꞌ maxnáaꞌ ikháánꞌ, tsáánꞌ a̱jma̱ inaaꞌ! Ikháánꞌ xtaꞌún a̱ꞌkhue̱n kajngó ma̱ta̱xu̱ꞌdáa awan ga̱jma̱á numuꞌ xómá naꞌthán xtángoo. Jamí ikháánꞌ tsíthane̱-mbáníí xtángoo, rí naraxná-ñájun rí mi̱ꞌxnúꞌ».<verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />A̱ꞌkhue̱n xa̱bo̱ tsí wájun mijngi nitháa̱n Páblo̱:</para>
  <para style="p" vid="ACT 23:4">―Náá numuu kajngó narathán-xkawi̱íꞌ tsí jayá idxu̱ún dxakuun, tsí niꞌgíi Ana̱ꞌlóꞌ róꞌ.<verse eid="ACT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5" />A̱ꞌkhue̱n Páblo̱ niꞌthán:</para>
  <para style="p" vid="ACT 23:5">―A̱ngui̱nꞌ, na̱nguá i̱yo̱o̱ xí ikhaa̱ ñajuu̱n tsí jayá idxu̱ún dxakuun. Numuu rí xkuaꞌnii ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ: “Ma̱xára̱tha̱n-xkawi̱íꞌ xa̱bo̱ nikhi̱i̱ tsí jayá idxu̱ún xa̱bo̱ xuajñaaꞌ”.<verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />Ído̱ ndiꞌyoo Páblo̱ rí mbá tikhuun xa̱bo̱ tsúꞌkhue̱n ñajúún xa̱bo̱ saduséo̱, jamí i̱ꞌwíin ñajúún xa̱bo̱ fariséo̱, a̱ꞌkhue̱n nixúxi̱i̱ a̱ꞌwóo̱ ná inúú mbá xúgíin xa̱bo̱ buanuu ede̱ tsí gatiin ikhín: «Xa̱bo̱ buanuu a̱ngui̱nꞌ, ikhúúnꞌ ñajunꞌ xa̱bo̱ fariséo̱, jamí a̱dée mbáa xa̱bo̱ fariséo̱. Xúge̱ꞌ na̱to̱ꞌo̱o̱ awan ga̱jma̱á numuꞌ, numuu rí gúꞌthu̱u̱n ga̱jma̱á mbá jañii a̱kui̱nꞌ rí mbuya̱a mbiꞌñúú tsí nijáñúú».<verse eid="ACT 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7" />Ído̱ niꞌthán Páblo̱ ajngáa rúꞌkhue̱n, a̱ꞌkhue̱n xa̱bo̱ fariséo̱ ni̱tsa̱ñu̱ú gajmíí xa̱bo̱ saduséo̱, jamí ni̱xpi̱ꞌtha̱-mijnée̱. <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />Numuu rí xa̱bo̱ saduséo̱ nuthan rí xa̱bo̱ tsí nijáñúú na̱nguá iyaa̱ mbiꞌñúu̱, ni máꞌ ndawi̱in ánje̱l, ni máꞌ ndawi̱in tsí ñajúún xe̱ꞌ. Xómáꞌ tsí xa̱bo̱ fariséo̱ nanimbu̱únꞌ mbá xúgíí rúꞌkhue̱n. <verse eid="ACT 23:8" /><verse number="9" style="v" sid="ACT 23:9" />Jamí phú gakhe̱ ni̱xu̱xí a̱ꞌwá xa̱bo̱. A̱ꞌkhue̱n ni̱tu̱xu̱ún mbá tikhuun xa̱bo̱ tsí nusngáá xtángoo tsí júwa̱ꞌ gajmíí xa̱bo̱ fariséo̱, jamí nithee̱n: «Tsíxkamaaxo̱ꞌ nimbá rí ra̱máján rí neꞌne xa̱bo̱ tsíge̱ꞌ. Á gáꞌne xí mbáa xe̱ꞌ waꞌtháa̱n neꞌne, o mbáa ánje̱l mbo̱ꞌ. Ma̱xáwajúnꞌthi̱ínlóꞌ Ana̱ꞌlóꞌ».<note caller="+" style="f"><char style="fr" closed="false">23.9 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «Ma̱xáwajúnꞌthi̱ínlóꞌ Ana̱ꞌlóꞌ».</char></note><verse eid="ACT 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10" />Jamí i̱tha̱án na̱ka̱-ratsimuu rí na̱tsa̱ñu̱ú xa̱bo̱, a̱ꞌkhue̱n xa̱bo̱ ede̱ drígu̱ún tsí ku̱ra̱tuun ajwa̱nꞌ, nimíñuu̱ rí mi̱chíkú-makaa Páblo̱ gúne̱ xa̱bo̱. Ikhaa jngó nixná-ñájwii̱n rí ma̱wátaan xa̱bo̱ tsí ku̱ra̱tuun ajwa̱nꞌ kajngó mu̱ri̱yaa̱ꞌ ga̱jma̱á tsiakhe̱ ná majñu̱ú xa̱bo̱ tsúꞌkhue̱n, jamí magúu̱n juya̱a̱ ná guꞌwá rí gatiin xa̱bo̱ tsí ku̱ra̱tuun ajwa̱nꞌ.<verse eid="ACT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11" />Rí i̱mba̱ mbroꞌon nisngájma-mina̱ꞌ Táta̱ ná inuu Páblo̱, jamí niꞌthúu̱n: «Araxná-mina̱ꞌ tsiakhe̱, Páblo̱. Numuu rí ndaꞌyóo mi̱dxo̱ꞌ gára̱tha̱n ga̱jma̱á numuꞌ ná Róma̱, xómá rí nirathán ga̱jma̱á numuꞌ ná Jerusalén ge̱jyoꞌ».<verse eid="ACT 23:11" /></para>
  <para style="s">Naguáꞌdáá awan xa̱bo̱ rí mu̱xíya̱a̱ Páblo̱</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />Ído̱ watse rí i̱mba̱ mbiꞌi, a̱ꞌkhue̱n mbá tikhuun xa̱bo̱ judío̱ niguáꞌdáá awan rí mu̱xíya̱a̱ Páblo̱. Ni̱xu̱da̱ꞌ-mijnée̱ mbá awan rí mu̱míníi̱, nithee̱n rí mu̱xúpiꞌtsii̱ ni máꞌ mu̱xúwa̱a̱n iya asndo gúxíya̱a̱ Páblo̱. <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />Nanújngoo rí a̱jma̱ skíñúu (40) xa̱bo̱ tsí niguáꞌdáá awan rí mune̱ rúꞌkhue̱n. <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />Ikhiin tsúꞌkhue̱n nigóó ná inúú dxakuun tsí gíꞌdoo numúú gajmíí xa̱bo̱ buanuu, jamí nithúu̱n: «Ikháanꞌxo̱ꞌ ni̱xu̱ꞌdá-mijnáxo̱ꞌ rí mu̱míni̱íxo̱ꞌ, rí mu̱xúpeꞌtsoxo̱ꞌ asndo gúxíya̱a̱xo̱ꞌ Páblo̱. <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />Ikhaa jngó rí xúge̱ꞌ rá, ikháanꞌlaꞌ gajmiálaꞌ xa̱bo̱ buanuu ede̱, gu̱tha̱ánlaꞌ xa̱bo̱ ede̱ drígu̱ún tsí ku̱ra̱tuun ajwa̱nꞌ rí ma̱ꞌkha̱ jayáa̱ Páblo̱ gátsíí ná inalaꞌ. Gu̱ne̱laꞌ asndo xó rí nandalaꞌ mbu̱ya̱á i̱tha̱án xóó ga̱jma̱á numuu̱. Jamí ikháanꞌxo̱ꞌ ma̱juwa na̱ma̱ñaxo̱ꞌ rí mu̱xíya̱a̱xo̱ꞌ nákhí rí xóó tsíga̱níi̱ ge̱jyoꞌ».<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />I̱ndo̱ó máꞌ numuu rí a̱dée dxáguíi Páblo̱ nidxawuun xáne niguáꞌdáá awan xa̱bo̱ tsúꞌkhue̱n ga̱jma̱á numuu a̱muu̱. A̱ꞌkhue̱n ni̱ke̱e̱ gáꞌthúu̱n ná guꞌwá rí gatiin xa̱bo̱ tsí ku̱ra̱tuun ajwa̱nꞌ. <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />A̱ꞌkhue̱n Páblo̱ nindxaꞌwóo mbáa xa̱bo̱ tsí naꞌthán-ñájúún tsí ku̱ra̱tuun ajwa̱nꞌ, jamí niꞌthúu̱n: «Ayu-ꞌcháa dxáma tsíge̱ꞌ ná inuu xa̱bo̱ ede̱ drígu̱ún tsí ku̱ra̱tuun ajwa̱nꞌ, numuu rí gíꞌdoo̱ mbá ajngáa rí maꞌthúu̱n».<verse eid="ACT 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 23:18" />A̱ꞌkhue̱n rí xa̱bo̱ tsí naꞌthán-ñájúún tsí ku̱ra̱tuun ajwa̱nꞌ ni̱ka̱ jayáa dxáma ná inuu xa̱bo̱ ede̱ drígúu̱n, jamí niꞌthúu̱n: «Páblo̱ tsí gída̱ꞌ ná géjwa̱nꞌ nindxaꞌwéꞌ jamí niꞌthínꞌ rí ma̱ꞌkha ja̱ya̱a̱ dxáma tsíge̱ꞌ inaaꞌ, numuu rí gíꞌdoo̱ mbá rí maꞌtháa̱nꞌ».<verse eid="ACT 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19" />Xa̱bo̱ ede̱ drígu̱ún tsí ku̱ra̱tuun ajwa̱nꞌ niwatuun ñawúun dxáma jamí ni̱ka̱ jayáa̱ janíí, a̱ꞌkhue̱n niraxu̱u̱:</para>
  <para style="p" vid="ACT 23:19">―Dí ñajuun rí xtaꞌdáá ma̱ra̱thu̱nꞌ rá.<verse eid="ACT 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20" />A̱ꞌkhue̱n niꞌthán dxáma:</para>
  <para style="p" vid="ACT 23:20">―Xa̱bo̱ judío̱ niguáꞌdáá awan rí mu̱nda̱ꞌa̱a̱ꞌ rí mi̱dxo̱ꞌ-ꞌcháa Páblo̱ gátsíí ná inúú xa̱bo̱ buanuu ede̱. Muni̱i̱ asndo xó rí nandúu̱n mbuyáa̱ i̱tha̱án xóó ga̱jma̱á numuu̱. <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />I̱ndo̱ó máꞌ numuu rí ikháánꞌ ma̱xánimba̱a̱ꞌ xtañúu̱. Numuu rí nanújngoo rí a̱jma̱ skíñúu (40) xa̱bo̱ guáꞌthi̱ín ngu̱ꞌwa̱ rí mu̱xíya̱a̱, jamí asndo niguáꞌdáa̱ mbá awan rí mu̱míníi̱, rí mu̱xúpiꞌtsii̱ ni máꞌ mu̱xúwa̱a̱n iya asndo gúxíya̱a̱ Páblo̱. Jamí xúge̱ꞌ rá, júwe̱e̱ꞌ máꞌ xawi guáꞌthíi̱n rí ikháánꞌ ma̱tha̱ne̱-mbáníí rí mu̱nda̱ꞌa̱a̱ꞌ.<verse eid="ACT 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22" />A̱ꞌkhue̱n xa̱bo̱ ede̱ drígu̱ún tsí ku̱ra̱tuun ajwa̱nꞌ niꞌthán-ngawoo̱ dxáma rí ma̱ꞌgaa̱, jamí nixnángawoo̱ rí ma̱xáꞌthúu̱n asndo nimbáa xa̱bo̱ rí niꞌthúu̱n ajngáa rúꞌkhue̱n.<verse eid="ACT 23:22" /></para>
  <para style="s">Páblo̱ na̱ka̱ jiꞌyáa ná inuu xa̱bo̱ ñajun Féli̱ks</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />A̱ꞌkhue̱n nindxaꞌwúu̱n a̱jmi̱i xa̱bo̱ tsí nuthan-ñajúún tsí ku̱ra̱tuun ajwa̱nꞌ, jamí nixná-ñájúu̱n rí ga̱ju̱wá na̱ma̱ñúú mbá gu̱wa̱ꞌ skíñúu (200) xa̱bo̱ tsí ku̱ra̱tuun ajwa̱nꞌ, atsú skíñú gu̱wi̱inꞌ (70) tsí trámúú guáyo̱, jamí gu̱wa̱ꞌ skíñúu xa̱bo̱ tsí juda ajwa̱nꞌ rí júdú inuu. Kajngó ma̱ga̱jnúu̱ magóo̱ ná Sesaréa̱ ído̱ gáꞌne mijnagu̱wa̱ꞌ i̱ka̱ ajwa̱nꞌ rí mbroꞌon. <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />Xúꞌkhue̱n máꞌ nixná-ñájúu̱n rí ga̱ju̱wá na̱ma̱ñúú guáyo̱ tsí ma̱riguu Páblo̱ kajngó nda̱a̱ rí gágíꞌnuu̱, jamí gagóo̱ juya̱a̱ ná inuu xa̱bo̱ ñajun Féli̱ks. <verse eid="ACT 23:24" /><verse number="25" style="v" sid="ACT 23:25" />Jamí niꞌnii̱ mbá i̱yi̱i̱ꞌ rí naꞌthán xáꞌnii:<verse eid="ACT 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 23:26" />«Ikhúúnꞌ ñajunꞌ Kláudio̱ Lísia̱s, na̱ra̱xi̱ínlo̱ꞌ táta̱ nikhi̱i̱, xa̱bo̱ ñajun Féli̱ks. <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />Xa̱bo̱ tsíge̱ꞌ nikhuáa nene̱ xa̱bo̱ judío̱, jamí inu máꞌ júwe̱e̱ꞌ rí mu̱xíya̱a̱ ído̱ rí ikhúúnꞌ ne̱ne̱-jríya̱a̱ꞌlo̱ꞌ gajmíꞌ xa̱bo̱ tsí ku̱ra̱tuun ajwa̱nꞌ, numuu ni̱dxawuun rí xa̱bo̱ Róma̱ ñajuu̱n. <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />Ikhúúnꞌ ndiyoꞌ mba̱yo̱o̱ náá numuu kajngó nuni̱i̱ aꞌkhúun, ikhaa jngó nika ja̱ya̱a̱lo̱ꞌ ná inúú xa̱bo̱ buanuu ede̱ drígúu̱n. <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />A̱ꞌkhue̱n ndi̱yo̱o̱ rí nuni̱i̱ aꞌkhúun ga̱jma̱á numuu xtángawúu̱n ikhii̱n, i̱ndo̱ó máꞌ numuu rí táꞌnii̱ nimbá aꞌkhán rí asndo jaꞌyoo ma̱ja̱ñúu̱ ni máꞌ rí ma̱ꞌgee̱ géjwa̱nꞌ. <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />I̱ndo̱ó máꞌ numuu rí ído̱ ni̱dxawuun rí xa̱bo̱ judío̱ niguáꞌdáá awan rí mu̱xíya̱a̱ xa̱bo̱ tsíge̱ꞌ, a̱ꞌkhue̱n mbá nacha̱ máꞌ ni̱xu̱ꞌmáa̱ ná inaaꞌ ikháánꞌ. Jamí ni̱thu̱ún tsí nune̱ aꞌkhúu̱n rí ná inaaꞌ ikháánꞌ gúthee̱n rí guáꞌdáa̱ muthee̱n ga̱jma̱á numuu̱. Mba̱xíꞌlóꞌ rá».<note caller="+" style="f"><char style="fr" closed="false">23.30 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «Mba̱xíꞌlóꞌ rá».</char></note><verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />A̱ꞌkhue̱n xa̱bo̱ tsí ku̱ra̱tuun ajwa̱nꞌ nene̱-mbáníí rí waꞌxná-ñájúún, nigóo̱ juya̱a̱ Páblo̱ mbroꞌon máꞌ rúꞌkhue̱n asndo ná xuajen Antípa̱tri̱s. <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />Jamí i̱mba̱ mbiꞌi, tsí nagóó nakhúún nithangi̱in ná guꞌwá rí gatiin xa̱bo̱ tsí ku̱ra̱tuun ajwa̱nꞌ, jamí tsí trámúú guáyo̱ nigóó ga̱jma̱á nindxu̱u̱ Páblo̱. <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />Ído̱ niguáꞌníi̱ ná Sesaréa̱, a̱ꞌkhue̱n ni̱xna̱xíi̱ i̱yi̱i̱ꞌ inuu xa̱bo̱ ñajun, jamí ni̱xna̱xíi̱ Páblo̱ mangaa. <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />Ído̱ wámbo̱o̱ xa̱bo̱ ñajun ni̱gu̱xnuu i̱yi̱i̱ꞌ, a̱ꞌkhue̱n niraxu̱u̱ Páblo̱ náá xuajñuu̱. Jamí ído̱ nidxawuu̱n rí xa̱bo̱ Silísia̱ ñajuu̱n, <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />a̱ꞌkhue̱n niꞌthúu̱n: «Ma̱dxawaanꞌ ído̱ gáguáꞌnú tsí nune̱ aꞌkháanꞌ». A̱ꞌkhue̱n nixná-ñájwii̱n rí mi̱tia̱wáa̱n ná guꞌwá mba̱a̱ rí neꞌne Eróde̱s.<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s">Páblo̱ naꞌthán-mbáyú-mina̱ꞌ ná inuu Féli̱ks</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />Ído̱ ninújngoo witsu mbiꞌi, a̱ꞌkhue̱n ni̱ga̱nú Ananía̱s ná Sesaréa̱, tsí jayá idxu̱ún dxakuun, gajmíí mbá tikhuun xa̱bo̱ buanuu, jamí juya̱a̱ mbáa xa̱bo̱ tsí naꞌthán-mbáñúu̱ tsí mbiꞌyuu Tértu̱lo̱. Jamí ni̱xna̱xí-mijnée̱ ná inuu xa̱bo̱ ñajun rí muni̱i̱ aꞌkhúun Páblo̱. <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />Ído̱ rí ni̱ꞌkha̱ jiꞌyáa Páblo̱ ná inúu̱, a̱ꞌkhue̱n Tértu̱lo̱ nigíꞌdu̱u̱n neꞌne aꞌkhúu̱n xáꞌnii ná inuu xa̱bo̱ ñajun: «Táta̱ nikhi̱i̱, xa̱bo̱ ñajun Féli̱ks, ga̱jma̱á numuu rí ikháánꞌ na̱ma̱ñaaꞌ narathán-ñájun phú tsímáá juwaxo̱ꞌ, jamí phú mbaꞌa rí máján nithán-ñájwíín ná xuajen. <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />Phú núma̱aꞌ la ikháánꞌ, numuu rí tsitsíí nu̱drígúxo̱ꞌ mbá xúgíí rúꞌkhue̱n jamí asndo náá máꞌ. <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />I̱ndo̱ó máꞌ numuu rí mu̱xúne̱-gajmáaꞌxo̱ꞌ mba̱yo̱ꞌ guéño, ikhaa jngó na̱tha̱n-jáñaaꞌ rí ma̱ta̱dxawanxo̱ꞌ mbá ꞌduun ajngáa rí mu̱tha̱a̱nꞌxo̱ꞌ. <verse eid="ACT 24:4" /><verse number="5" style="v" sid="ACT 24:5" />Numuu rí ni̱xkamaaxo̱ꞌ xa̱bo̱ tsíge̱ꞌ tsí ñajuun asndo xó mbá nandii xkawe̱ꞌ, jamí ngrigo̱o̱ꞌ mbá xúgíí numbaa naꞌnii̱ rí mu̱xpi̱ꞌtha̱-mijná xa̱bo̱ judío̱, xúꞌkhue̱n máꞌ ikhaa̱ jayá idxu̱ún xa̱bo̱ mi̱nduwiin tsí mbiꞌñúú nasaréno̱. <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />Mangaa máꞌ ndiyoo̱ ma̱ꞌnii̱ rí ma̱xáya-makuu̱ guꞌwá dxákuun. Ikhaa jngó ni̱rtuwii̱nxo̱ꞌ, [jamí ndiyaxo̱ꞌ mu̱xu̱ꞌdáa awan ga̱jma̱á numuu̱ xómá naꞌthán xtángoo dríga̱ꞌxo̱ꞌ. <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />Xómáꞌ xa̱bo̱ ede̱ drígu̱ún tsí ku̱ra̱tuun ajwa̱nꞌ tsí mbiꞌyuu Lísia̱s, nixuda-mine̱e̱ꞌ ga̱jma̱á tsiakhe̱ niríya̱a̱ꞌ xa̱bo̱ tsíge̱ꞌ ná ñawánxo̱ꞌ. <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />Jamí niꞌthée̱n rí xa̱bo̱ tsí nune̱ aꞌkhúu̱n a̱guwée̱ꞌ ná inaaꞌ ikháánꞌ ge̱jyoꞌ.]<note caller="+" style="f"><char style="fr" closed="false">24.6-8 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa rí júgua-raꞌa ga̱jma̱á [...].</char></note> Ído̱ gátra̱xíi̱ ikháánꞌ, a̱ꞌkhue̱n ma̱tha̱ya̱á rí gakon mbá xúgíí rí nu̱ne̱xo̱ꞌ aꞌkhúu̱n». <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />Jamí xa̱bo̱ judío̱ mangiin nuthan rí gakon mbá xúgíí rí naꞌthán Tértu̱lo̱.<verse eid="ACT 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />Ído̱ rí xa̱bo̱ ñajun neꞌne ñawúun ná inuu Páblo̱, kajngó ma̱goo maꞌthée̱n, a̱ꞌkhue̱n niꞌthée̱n: «Numuu rí nda̱yo̱o̱ rí mbaꞌa máꞌ tsigu ñajwaanꞌ xa̱bo̱ tsí naxúdaa awan ná numbaa ríge̱ꞌ, ikhaa jngó mbá jañii a̱kui̱nꞌ na̱tha̱n-mbáá ga̱jma̱á numuꞌ ná inaaꞌ xúge̱ꞌ. <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />Naꞌne mbá gu̱wa̱ꞌ i̱jma̱ (12) mbiꞌi rí nika gáne̱-mba̱a̱ Ana̱ꞌlóꞌ ná Jerusalén, xómá rí ikháánꞌ ma̱goo ma̱tha̱ya̱á. <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />Jamí xa̱bo̱ tsí nune̱ aꞌkhúnꞌ na̱nguá ni̱xkamúu̱ rí na̱tsa̱ñu̱ꞌ ga̱jmi̱ꞌ nimbáa xa̱bo̱, ni máꞌ tásngrúꞌúún xa̱bo̱ tsí mbaꞌiin rí mu̱xu̱xí a̱ꞌwá, ni máꞌ ná guꞌwá dxákuun, ni máꞌ ná awúun mbámbá guꞌwá rí na̱gi̱mbíin xa̱bo̱ judío̱, ni máꞌ ná awúun xuajen. <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />Xa̱bo̱ tsíge̱ꞌ ni máꞌ ma̱xáꞌngúu̱n mu̱snga̱jmee̱ rí gakon mbá xúgíí rí nuni̱i̱ aꞌkhúnꞌ xúge̱ꞌ ná inaaꞌ. <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />I̱ndo̱ó máꞌ numuu rí na̱tha̱a̱nꞌ mbá jmbu ríge̱ꞌ: ikhúúnꞌ na̱ne̱-mba̱a̱ Anu̱ú táta̱-xi̱ꞌñáxo̱ꞌ ga̱jma̱á gisngáá drígo̱o̱ Jesús, rí ikhii̱n nuthee̱n rí mi̱nduwa ñajuun. Nanimbo̱ꞌ ja̱yo̱o̱ mbá xúgíí rí ka̱ma naꞌthán ná awúun i̱yi̱i̱ꞌ xtángoo, jamí rí ka̱ma naꞌthán ná awúun i̱ñu̱ú xa̱bo̱ tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ wajyúú. <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />Xúꞌkhue̱n máꞌ gúꞌthu̱u̱n ga̱jma̱á mbá jañii a̱kui̱nꞌ ná inuu Ana̱ꞌlóꞌ, xómá rí guáꞌthíi̱n ikhii̱n mangii̱n, rí mbuya̱a mbiꞌñúú xa̱bo̱ tsí nijáñúú, tsí májíin jamí tsí ra̱májíin. <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />Ikhaa numuu rúꞌkhue̱n jámba̱ miꞌtsú na̱ne̱ rí ma̱xtáá mbá jaꞌwu a̱kui̱nꞌ ná inuu Ana̱ꞌlóꞌ, jamí ná inúú xa̱bo̱.<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />»Ído̱ ninújngoo mbá wátha̱ wáa tsigu rí ningrigo̱ꞌ tsíngua̱ꞌ, a̱ꞌkhue̱n nithangu̱ún ná xuajñuꞌ kajngó ma̱xnu̱ú mbúkha̱a̱ xa̱bo̱ tsí ngíníi, jamí ma̱xna̱xí tsi̱gi̱jña̱ꞌ ná inuu Ana̱ꞌlóꞌ. <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />Xtáá na̱ne̱ rúꞌkhue̱n, ído̱ rí mbá tikhuun xa̱bo̱ judío̱ tsí naguwá ná numbaa Ásia̱ ni̱xkamúú rí wámba̱ máꞌ ne̱ne̱-jaꞌwu-mina̱aꞌ ná guꞌwá dxákuun. Na̱nguá gajmíꞌ mbaꞌiin xa̱bo̱ ni máꞌ táxu̱xí a̱ꞌwá. <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />Ikhii̱n phú jaꞌyoo ma̱ju̱wée̱ꞌ ná inaaꞌ ge̱jyoꞌ kajngó muni̱i̱ aꞌkhúnꞌ, xí ríga̱ aꞌkhúnꞌ iyáa̱. <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />O aguthan máꞌ xa̱bo̱ tsíge̱ꞌ mbo̱ꞌ, xí ni̱xkamaa̱ rí ra̱máján ne̱ne̱lo̱ꞌ, nákhí nixtáá ná inúú xa̱bo̱ buanuu ede̱. <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />Mbóó máꞌ rí ma̱goo muthee̱n, rí nákhí nixtáá ná inúú xa̱bo̱ buanuu ede̱, ni̱tha̱n gakhe̱ ajngáa ríge̱ꞌ: “Xúge̱ꞌ nu̱xu̱ꞌdáalaꞌ awan ga̱jma̱á numuꞌ, numuu rí nanimbo̱ꞌ rí mbuya̱a mbiꞌñúú tsí nijáñúú”».<verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />Ído̱ nidxawuun Féli̱ks ajngáa rúꞌkhue̱n, a̱ꞌkhue̱n nifroꞌo̱o̱ mújúu̱n rí ñajuun gisngáá drígo̱o̱ Jesús, jamí niniñuu̱ naꞌcho̱o̱ rí maxudaa̱ awan. Xáꞌnii niꞌthée̱n: «Ído̱ gáꞌkha̱ Lísia̱s, xa̱bo̱ ede̱ drígu̱ún tsí ku̱ra̱tuun ajwa̱nꞌ, a̱ꞌkhue̱n ma̱dxawuun i̱tha̱án xóó ga̱jma̱á numuu rí nu̱tha̱nlaꞌ». <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />A̱ꞌkhue̱n nixná-ñájuu̱n xa̱bo̱ tsí naꞌthán-ñájúún tsí ku̱ra̱tuun ajwa̱nꞌ rí mu̱ña̱wáa̱n Páblo̱, i̱ndo̱ó máꞌ numuu rí ma̱nguanúu̱ ma̱ngrigo̱o̱ꞌ, jamí ma̱xátrikhúún a̱nguii̱n tsí naguwá gúne̱-mba̱ꞌwi̱i̱ o naguwá gúyáa̱.<verse eid="ACT 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />Ninújngoo mbá wátha̱ wáa mbiꞌi, a̱ꞌkhue̱n ni̱ꞌkha̱a Féli̱ks ga̱jma̱á a̱ꞌgui̱i tsí mbiꞌyuu Drusíla̱, tsí ñajuun a̱ꞌgo̱ judío̱. A̱ꞌkhue̱n Féli̱ks nindxaꞌwóo Páblo̱, kajngó madxawuu̱n rí maꞌthán ga̱jma̱á numuu rí xáne ma̱nimba̱ꞌlóꞌ juꞌyáá Jesukrísto̱. <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />I̱ndo̱ó máꞌ numuu rí ído̱ Páblo̱ niꞌthán ga̱jma̱á numuu rí xa̱bo̱ jaꞌyoo ma̱xtáa̱-raꞌne rí máján, xúꞌkhue̱n máꞌ rí jaꞌyoo ma̱ꞌngo̱o̱ maꞌthán-ñájun-mine̱e̱ꞌ, jamí ma̱ga̱nú mbiꞌi rí Ana̱ꞌlóꞌ maxúdaa awan ga̱jma̱á numúú xa̱bo̱, a̱ꞌkhue̱n nimíñuu Féli̱ks jamí niꞌthúu̱n Páblo̱: «Rí xúge̱ꞌ rá, ma̱goo máꞌ mi̱dxu̱uꞌ. Ma̱ndxa̱ꞌwa̱a̱ꞌ máꞌ a̱ꞌkhue̱n ído̱ nayaphúún». <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />Mbáá máꞌ rí Féli̱ks gíꞌthu̱u̱n rí Páblo̱ maxnúu̱ mbúkha̱a̱ kajngó maniñuu̱. Ikhaa jngó phú mbaꞌa nothon nandxaꞌwóo̱ ma̱ꞌkha̱ kajngó mandxákuu̱n ga̱jmáa̱.<verse eid="ACT 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27" />Xkuaꞌnii ninújngoo a̱jma̱ tsigu, a̱ꞌkhue̱n Féli̱ks niniñuu-ranindxu̱u̱ xa̱bo̱ ñajun, jamí ni̱ta̱ꞌa̱a Pórsio̱ Fésto̱ ga̱jma̱á numuu̱. I̱ndo̱ó máꞌ numuu rí Féli̱ks nandoo̱ ma̱nguanú-mújúu̱n gajmíi̱ xa̱bo̱ judío̱, ikhaa jngó niniñuu̱ Páblo̱ ná géjwa̱nꞌ.<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s">Páblo̱ na̱ka̱ inuu Fésto̱</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />Ído̱ neꞌne atsú mbiꞌi rí ni̱ga̱nú Fésto̱ ná xuajen Sesaréa̱ kajngó ma̱grui̱guíi̱ ñajun, a̱ꞌkhue̱n nigájnuu̱ ni̱ke̱e̱ ná xuajen Jerusalén. <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />Ikhín dxakuun tsí gíꞌdoo numúú xúꞌkhue̱n máꞌ xa̱bo̱ buanuu judío̱ tsí phú gíꞌdoo numúú, ni̱xna̱xí-mijná ná inuu Fésto̱ kajngó muthee̱n aꞌkhúun Páblo̱. <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />Nu̱nda̱ꞌáa̱ rí ma̱ꞌnii̱ mbá rí máján, rí ma̱ꞌnii̱ rí ma̱ꞌkha̱ jiꞌyáa Páblo̱ ná Jerusalén. Numuu rí ikhii̱n nuꞌgí-mijnée̱ rí mu̱xíya̱a̱ ná jamba̱a̱. <verse eid="ACT 25:3" /><verse number="4" style="v" sid="ACT 25:4" />Xómáꞌ Fésto̱ niꞌthán rí Páblo̱ ni̱tia̱wa̱án májáán ná Sesaréa̱. Jamí niꞌthée̱n rí wapha máꞌ ma̱ꞌgaa̱ ikhín. <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />A̱ꞌkhue̱n niꞌthúu̱n: «Ikháanꞌlaꞌ tsáanꞌ ñajwanlaꞌ xa̱bo̱ ñajun, gaꞌgualaꞌ ga̱jma̱á nindxu̱ꞌ. Jamí xí xa̱bo̱ tsúꞌkhue̱n neꞌne mbá rí xkawe̱ꞌ, gu̱tha̱nlaꞌ aꞌkhúu̱n ñúꞌún».<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />Fésto̱ nixtáa̱ xó mbá migiñu o mbá gu̱wa̱ꞌ wáa mbiꞌi ná Jerusalén, a̱ꞌkhue̱n ni̱kaa̱ ná Sesaréa̱. Ído̱ watse rí i̱mba̱ mbiꞌi, a̱ꞌkhue̱n ni̱gi̱ꞌi̱i̱ ná xílii̱ kajngó maxudaa̱ awan, jamí nixná-ñájwii̱n rí ma̱ꞌkha̱ jiꞌyáa Páblo̱. <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />Ído̱ ni̱ga̱nú Páblo̱, a̱ꞌkhue̱n xa̱bo̱ judío̱ tsí niguwá ná Jerusalén mbá nawa̱a̱ niwájwii̱n ná inuu̱. Jamí nini̱i̱ aꞌkhúun, nithee̱n rí niꞌnii̱ mbaꞌa inii aꞌkhán rí phú gakhe̱, i̱ndo̱ó máꞌ numuu rí tsíꞌngúu̱n mu̱snga̱jmee̱ rí gakon ga̱jma̱á numuu rí nuthee̱n. <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />A̱ꞌkhue̱n Páblo̱ niꞌthán-mbáyú-mina̱ꞌ: «Ikhúúnꞌ táxu̱ꞌdá-mina̱ꞌ nimbá aꞌkhán ga̱jma̱á numuu xtángawúún xa̱bo̱ judío̱, ni máꞌ ga̱jma̱á numuu guꞌwá dxákuun, ni máꞌ ga̱jma̱á numuu thúngaa Sésa̱r».<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />Xómáꞌ Fésto̱ nandoo̱ ma̱nguanú-mújúu̱n gajmíi̱ xa̱bo̱ judío̱, ikhaa jngó niꞌthúu̱n Páblo̱:</para>
  <para style="p" vid="ACT 25:9">―Á nandaaꞌ mi̱dxo̱ꞌ ná Jerusalén, kajngó ma̱xu̱ꞌdáa awan ga̱jma̱á numaaꞌ ikhín dxe̱ꞌ.<verse eid="ACT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10" />A̱ꞌkhue̱n Páblo̱ niꞌthán:</para>
  <para style="p" vid="ACT 25:10">―Xtáá máꞌ ná inuu ꞌgí xíli̱i thúngaa Sésa̱r, ná jaꞌyoo ma̱to̱ꞌo̱o̱ awan ga̱jma̱á numuꞌ. Nathayáá máꞌ májáanꞌ ikháánꞌ rí táñu̱ú xa̱bo̱ judío̱ nimbá rí ra̱máján. <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />Xí numuu rí ríga̱ mbá rí ra̱máján ne̱ne̱ rí asndo jaꞌyoo rí ma̱ja̱ñúꞌ, tsítha̱n rí tsíyoꞌ ma̱ja̱ñúꞌ. I̱ndo̱ó máꞌ numuu rí na̱nguá gakon rí nuthan xa̱bo̱ tsíge̱ꞌ ga̱jma̱á numuꞌ, ikhaa jngó nimbáa ma̱xáxóo maxnáxu̱únꞌ ná ñawúu̱n ikhii̱n. Ikhúúnꞌ na̱nda̱ꞌa̱ rí thúngaa Sésa̱r gáxudaa awan ga̱jma̱á numuꞌ.<verse eid="ACT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12" />Fésto̱ niꞌthán-mina̱ꞌ gajmíí xa̱bo̱ buanuu ju̱ma̱ drígo̱o̱, jamí ído̱ wámbo̱o̱, a̱ꞌkhue̱n niꞌthúu̱n Páblo̱:</para>
  <para style="p" vid="ACT 25:12">―Ikháánꞌ ni̱ta̱nda̱ꞌa̱ rí thúngaa Sésa̱r maxúdaa awan ga̱jma̱á numaaꞌ, ikhaa jngó ná inuu máꞌ Sésa̱r gídxú.<verse eid="ACT 25:12" /></para>
  <para style="s">Páblo̱ na̱ka̱ ná inuu thúngaa Agrípa̱</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />Ído̱ ninújngoo mbá wátha̱ wáa mbiꞌi, a̱ꞌkhue̱n ni̱ꞌkha̱ thúngaa Agrípa̱ ga̱jma̱á Bereníse̱ ná Sesaréa̱ kajngó mu̱ra̱xii̱ Fésto̱. <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />Jamí ikhii̱n nijúwe̱e̱ꞌ mbaꞌa mbiꞌi ikhín, a̱ꞌkhue̱n Fésto̱ niꞌthúun Agrípa̱ ga̱jma̱á numuu Páblo̱:</para>
  <para style="p" vid="ACT 25:14">―Ge̱jyoꞌ xtáa mbáa xa̱bo̱ tsí Féli̱ks niniñuu ná géjwa̱nꞌ. <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />Ído̱ nika ná Jerusalén, a̱ꞌkhue̱n niguwá ná inuꞌ dxakuun tsí gíꞌdoo numúú, jamí xa̱bo̱ buanuu judío̱. Nini̱i̱ aꞌkhúun xa̱bo̱ tsúꞌkhue̱n jamí ni̱nda̱ꞌe̱ꞌ rí ma̱xna̱ ajngóꞌ rí ma̱ja̱ñúu̱. <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />A̱ꞌkhue̱n ni̱thu̱ún xa̱bo̱ tsúꞌkhue̱n rí tsíne̱ xkuaꞌnii xa̱bo̱ Róma̱, rí mu̱xna̱xíi̱ wapha xa̱bo̱ rí ma̱ja̱ñúu, xí na̱nguá wájun ná inuu̱ tsí nune̱ aꞌkhúu̱n, kajngó ma̱goo maꞌthán-mbáyú-mine̱e̱ꞌ ná inúú xa̱bo̱ tsúꞌkhue̱n. <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />Ikhaa jngó ído̱ niguáꞌníi̱ mbá ꞌnduꞌ ge̱jyoꞌ, táne̱-gajyúu máꞌ, a̱ꞌkhue̱n rí i̱mba̱ mbiꞌi niꞌgúnꞌ ná xíli̱ꞌ kajngó ma̱xu̱ꞌdáa awan, jamí ni̱xna̱-ñájun rí ma̱ꞌkha̱ jiꞌyáa xa̱bo̱ tsúꞌkhue̱n. <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />I̱ndo̱ó máꞌ numuu rí xa̱bo̱ tsí niguwá nune̱ aꞌkhúu̱n, na̱nguá máꞌ nithee̱n nimbá aꞌkhán rí phú mba̱a̱ ga̱jma̱á numuu̱, xó rí ni̱ju̱mu̱ꞌ ikhúúnꞌ rí muthee̱n. <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />I̱ndo̱ó máꞌ rí nuthee̱n ga̱jma̱á numuu̱ ñajuun xó rí nune̱-mba̱a̱ Ana̱ꞌlóꞌ ikhii̱n, jamí nuthee̱n ga̱jma̱á numuu mbáa xa̱bo̱ tsí mbiꞌyuu Jesús, tsí nijáñuu máꞌ, jamí Páblo̱ naꞌthán rí xtáa̱ ndaꞌyee̱. <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />Xómáꞌ ikhúúnꞌ rá, a̱jma̱ a̱kui̱nꞌ, tsíyo̱o̱ dí gáne̱ ga̱jma̱á numuu rí nuthee̱n, ikhaa jngó ni̱ra̱xu̱u̱ xí nandoo̱ ma̱ꞌgee̱ ná Jerusalén, kajngó ñúꞌún gáto̱ꞌo̱o̱ awan ga̱jma̱á numuu̱. <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />Xómáꞌ Páblo̱ ni̱nda̱ꞌa̱ rí thúngaa ginii Augústo̱ gáxudaa awan ga̱jma̱á numuu̱. Ikhaa jngó ni̱xna̱-ñájun rí ma̱gi̱de̱e̱ꞌ xóó ná géjwa̱nꞌ asndo gáyaphúún rí ma̱xu̱ꞌmáa̱ ná inuu thúngaa Sésa̱r.<verse eid="ACT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22" />A̱ꞌkhue̱n Agrípa̱ niꞌthúun Fésto̱:</para>
  <para style="p" vid="ACT 25:22">―Nandoꞌ ma̱dxawuun mangúúnꞌ ajngóo xa̱bo̱ tsúꞌkhue̱n.</para>
  <para style="p" vid="ACT 25:22">Xómáꞌ Fésto̱ niꞌthán:</para>
  <para style="p" vid="ACT 25:22">―Gátsíí gáta̱dxawíín ajngóo̱.<verse eid="ACT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />Ído̱ watse rí i̱mba̱ mbiꞌi, a̱ꞌkhue̱n ni̱ꞌkha̱ thúngaa Agrípa̱ ga̱jma̱á Bereníse̱, jamí phú karathoo niguáꞌníi̱ gajmíi̱ mbaꞌiin xa̱bo̱. Ni̱tu̱ꞌúu̱n ná guꞌwá-ñajun gajmíi̱ xa̱bo̱ ede̱ drígu̱ún tsí ku̱ra̱tuun ajwa̱nꞌ, jamí xa̱bo̱ buanuu tsí i̱tha̱án gíꞌdoo numúú ná xuajen. A̱ꞌkhue̱n Fésto̱ nixná-ñájun rí ma̱ꞌkha̱ jiꞌyáa Páblo̱. <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />Jamí Fésto̱ nigíꞌdu̱u̱n niꞌthán xáꞌnii: «Táta̱ thúngaa Agrípa̱, jamí mbá xúgiáanꞌlaꞌ táta̱ tsáanꞌ juwalaꞌ ge̱jyoꞌ ga̱jma̱á nindxa̱ꞌxo̱ꞌ, ge̱jyoꞌ wéje̱ xa̱bo̱ tsíge̱ꞌ ná inalaꞌ. Ikhaa tsíge̱ꞌ ñajuun tsí mbá xúgíin xa̱bo̱ judío̱ nune̱ aꞌkhúun ná inuꞌ ná Jerusalén jamí ná Sesaréa̱ ge̱jyoꞌ, nu̱ndxa̱ꞌwe̱e̱ ná inuꞌ rí jaꞌyoo ma̱ja̱ñúu̱. <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />Xómáꞌ ikhúúnꞌ na̱nguá ni̱xkamaa nimbá aꞌkhúu̱n rí asndo jaꞌyoo rí ma̱ja̱ñúu̱. I̱ndo̱ó máꞌ numuu rí ikhaa̱ ni̱nda̱ꞌe̱e̱ rí thúngaa ginii Augústo̱ gáxudaa awan ga̱jma̱á numuu̱, ikhaa jngó ni̱ꞌgí-mina̱ꞌ rí ma̱xu̱ꞌmáa̱ ná inuu̱ ikhaa̱. <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />I̱ndo̱ó máꞌ numuu rí xóó tsíyo̱o̱ dí gátháán ná inuu i̱yi̱i̱ꞌ ga̱jma̱á numuu̱, rí ma̱ꞌga ná inuu táta̱ thúngaa. Ikhaa jngó naꞌkha ja̱ya̱a̱ ná inalaꞌ, jamí i̱tha̱án máꞌ ná inaaꞌ ikháánꞌ, thúngaa Agrípa̱, kajngó ma̱tra̱xíi̱. Jamí ído̱ wámba̱a̱ꞌ nitraxíi̱, a̱ꞌkhue̱n mba̱yo̱o̱ dí ñajuun ma̱tháán ná inuu i̱yi̱i̱ꞌ ga̱jma̱á numuu̱. <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />Numuu nda̱yo̱o̱ rí nda̱a̱ numuu rí ma̱xu̱ꞌmáa mbáa xa̱bo̱ tsí kra̱ꞌaa géjwa̱nꞌ, xí ma̱xátha̱n náá rí aꞌkhúu̱n».<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s">Páblo̱ naꞌthán-mbáyú-mina̱ꞌ ná inuu Agrípa̱</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />A̱ꞌkhue̱n Agrípa̱ niꞌthúun Páblo̱: «Ma̱goo ma̱ra̱tha̱n-mbáá ga̱jma̱á numaaꞌ».</para>
  <para style="p" vid="ACT 26:1">A̱ꞌkhue̱n Páblo̱ nixúxe̱ ñawúun jamí nigíꞌdu̱u̱n niꞌthán-mbáyú-mine̱e̱ꞌ xáꞌnii: <verse eid="ACT 26:1" /><verse number="2" style="v" sid="ACT 26:2" />«Táta̱ thúngaa Agrípa̱, phú nadxu a̱kui̱nꞌ rí ma̱goo ma̱tha̱n-mbáyú-mina̱ꞌ ná inaaꞌ xúge̱ꞌ, ga̱jma̱á numuu mbá xúgíí rí nune̱ aꞌkhúnꞌ xa̱bo̱ judío̱. <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />I̱tha̱án máꞌ nadxu a̱kui̱nꞌ numuu rí ikháánꞌ nathane̱-nuwiin májáanꞌ mbá xúgíí rí nune̱ jañúú xa̱bo̱ judío̱, jamí nathane̱-nuwiin májáanꞌ rí na̱tsa̱ñúu̱ ga̱jma̱á numuu. Ikhaa jngó phú na̱tha̱n-jáñaaꞌ rí ma̱ꞌngo̱o̱ a̱kia̱anꞌ ma̱ta̱dxawunꞌ rí ma̱tha̱a̱nꞌ.<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />»Mbá xúgíin xa̱bo̱ judío̱ nduyáá xáne nixtáá ná xuajñuꞌ jamí ná Jerusalén, asndo nákhí máꞌ ada̱ ñajunꞌlo̱ꞌ. <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />Xúꞌkhue̱n máꞌ nduyáa̱ rí asndo nákhí lájúún ninindxu̱ꞌ xa̱bo̱ fariséo̱, jamí xí nandúu̱n, ma̱goo muthee̱n. Tsáanꞌ ñajwanxo̱ꞌ xa̱bo̱ fariséo̱ phú gakhi̱i̱ xtángoo dríga̱ꞌxo̱ꞌ xó rí nu̱ne̱-mba̱a̱xo̱ꞌ Ana̱ꞌlóꞌ. <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />Jamí xúge̱ꞌ rá, xtáá ná inaaꞌ ge̱jyoꞌ kajngó ma̱to̱ꞌo̱o̱ awan ga̱jma̱á numuꞌ, numuu rí gúꞌthu̱u̱n ga̱jma̱á mbá jañii a̱kui̱nꞌ rí ma̱mba̱núu awan rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxu̱ún táta̱-xi̱ꞌñáxo̱ꞌ wajyúú. <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />Ikhaa awan rúꞌkhue̱n guáꞌthíi̱n rí ma̱mba̱núu ná inúú a̱ngia̱nꞌxo̱ꞌ tsí mbá gu̱wa̱ꞌ i̱jma̱ (12) kuthuun xa̱bo̱ Israél, ikhaa jngó mbiꞌíí mbruꞌwíín nune̱-mba̱a̱ Ana̱ꞌlóꞌ. Ga̱jma̱á numuu rí mbá jañii a̱kui̱nꞌ gúꞌthu̱u̱n rí ma̱mba̱núu rúꞌkhue̱n, Táta̱ thúngaa Agrípa̱, nune̱ aꞌkhúnꞌ xa̱bo̱ judío̱. <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />Náá numuu kajngó tsínimba̱ꞌlaꞌ rí Ana̱ꞌlóꞌ ma̱ꞌne rí mbuya̱a mbiꞌñúú tsí nijáñúú róꞌ.<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />»Nákhí wapha ikhúúnꞌ mangúúnꞌ ni̱ju̱mu̱ꞌ rí mbaꞌa rí ra̱máján jaꞌyoo ma̱ñu̱ú tsí nanimbu̱únꞌ juyáá Jesús tsí na̱ꞌkha̱ ná Nasarét. <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />Ikhaa máꞌ rúꞌkhue̱n ne̱ne̱ ná Jerusalén. Ído̱ nijanúꞌ i̱yi̱i̱ꞌ tsiakhe̱ nene̱ dxakuun tsí gíꞌdoo numúú, kajngó ma̱ne̱ rúꞌkhue̱n, a̱ꞌkhue̱n ni̱xu̱ꞌdíin ná géjwa̱nꞌ mbaꞌiin xa̱bo̱ tsí nanimbu̱únꞌ juyáá Jesús. Jamí ído̱ rí nu̱radíi̱n tsúꞌkhue̱n, mangúúnꞌ máꞌ ni̱xna̱ ajngóꞌ rí ma̱ja̱ñúu̱. <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />Jamí phú mbaꞌa miꞌtsú ne̱ne̱-ngíníi̱ ná awúun mbámbá guꞌwá rí na̱gi̱mbíin xa̱bo̱ judío̱, ne̱ne̱-ski̱ñúu̱ rí muthee̱n rí na̱nguá inimbúu̱n juyáa̱ Jesús. Jamí najiꞌnúú mi̱ndaꞌkho ja̱ñúu̱, ikhaa jngó nika gáne̱-ngíníi asndo tsí júwa̱ꞌ ná i̱ꞌwá xuajen.<verse eid="ACT 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />»Ikhaa máꞌ rúꞌkhue̱n xtáá na̱ne̱ mbiꞌi rí naka ná Damásko̱, jamí ja̱go̱ i̱yi̱i̱ꞌ tsiakhe̱ kajngó ma̱ne̱ rí nixnangaweꞌ dxakuun tsí gíꞌdoo numúú. <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />Táta̱ thúngaa, ído̱ xtáá naka jamba̱a̱ mbá wakha̱ꞌ wáa eꞌne, a̱ꞌkhue̱n ndi̱yo̱o̱ mbá agu rí na̱ꞌkha̱ ná mikhuíí rí i̱tha̱án gakhi̱i̱ xó rí aguu a̱kha̱ꞌ. Ikhaa ne̱ nimbiꞌi-taꞌa ná inuꞌ, jamí ná inúú tsí nagóó ga̱jma̱á nindxu̱ꞌ. <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />A̱ꞌkhue̱n mbá xúgiáanꞌxo̱ꞌ ni̱drígáanꞌxo̱ꞌ mbayíí, jamí ikhúúnꞌ ni̱dxawuun mbá a̱ꞌwá rí naꞌthínꞌ ga̱jma̱á ajngáa ebréo̱: “Sáu̱lo̱, Sáu̱lo̱. Náá numuu kajngó nadxa̱ꞌ-raraxkoꞌ róꞌ. Phú gakhe̱ nathane̱-ñawún-mina̱ꞌ rí natapráꞌáá ajwa̱nꞌ rí júdú inuu”.<verse eid="ACT 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 26:15" />»A̱ꞌkhue̱n ikhúúnꞌ ni̱thu̱u̱n: “Tsáa ñajwaanꞌ róꞌ, Táta̱”.</para>
  <para style="p" vid="ACT 26:15">»Jamí Táta̱ niꞌthán: “Ikhúúnꞌ ñajunꞌ Jesús, tsí ikháánꞌ nadxo̱ꞌ-raraxkáá. <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />Jamí rí xúge̱ꞌ rá, ariajún. Ikhaa numuu ríge̱ꞌ ni̱snga̱jmá-mina̱ꞌ ná inaaꞌ, kajngó ma̱ꞌgíín rí ma̱tha̱ne̱ ñajunꞌ xúꞌkhue̱n máꞌ rí ma̱ra̱tha̱n mbá xúgíí rí nithayáá, jamí ma̱ra̱tha̱n mangaa rí ma̱snga̱jmáaꞌ xóó. <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />Ikhúúnꞌ ma̱xu̱ꞌmáá mi̱dxo̱ꞌ kajngó ma̱ra̱thu̱ún xa̱bo̱ judío̱ jamí xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, jamí ma̱ne̱-jríñáaꞌ ná ñawúu̱n kajngó nda̱a̱ rí gúña̱a̱ꞌ. <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />Na̱xu̱ꞌmáá mi̱dxo̱ꞌ kajngó ma̱ta̱rmáꞌtháá idúu̱n, kajngó ma̱ga̱jnáa̱ ná awúun rí mijína jamí ma̱guwáa̱n ná mbiꞌi. Na̱xu̱ꞌmáá mi̱dxo̱ꞌ kajngó ma̱ga̱jnáa̱ ná ñawúun Satanás jamí ma̱guwáa̱n ná ñawúun Ana̱ꞌlóꞌ. Jamí mangaa máꞌ rí ma̱nimbúu̱n juyeꞌ ikhúúnꞌ kajngó ma̱ꞌne mba̱a̱ a̱kui̱in Ana̱ꞌlóꞌ jaꞌñúu̱, jamí mu̱dri̱guíi̱ mangii̱n rí ma̱janúú tsí ni̱gu̱ma-jaꞌwu̱un”.<verse eid="ACT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />»Ikhaa numuu rúꞌkhue̱n, táta̱ thúngaa Agrípa̱, táꞌne-jñagúún inuu rí ni̱dxawuun inu-mbiꞌíí ná mikhuíí. <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />A̱ꞌkhue̱n gakon ginii jayu ni̱gíꞌdu̱u̱n ni̱tha̱n-ráꞌa ná inúú xa̱bo̱ tsí júwa̱ꞌ ná xuajen Damásko̱, xúꞌkhue̱n máꞌ ná Jerusalén ga̱jma̱á mbá xúgíí numbaa Judéa̱, jamí ná inúú xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún. Ni̱thu̱ún mbá xúgíin xa̱bo̱ tsúꞌkhue̱n rí ga̱thanga̱a a̱kuíi̱n ná inuu Ana̱ꞌlóꞌ jamí gu̱riꞌkhuu̱ xóo júwe̱e̱ꞌ, xúꞌkhue̱n máꞌ guni̱i̱ rí máján kajngó ma̱kujma rí nithangii̱n ná inuu Ana̱ꞌlóꞌ. <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />Ikhaa numuu rúꞌkhue̱n xa̱bo̱ judío̱ ni̱rtuwúún ná awúun guꞌwá dxákuun, jamí nini̱i̱ mu̱xíñúu̱. <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />I̱ndo̱ó máꞌ numuu rí Ana̱ꞌlóꞌ nambáyíꞌ asndo mbiꞌi xúge̱ꞌ, ikhaa jngó tsíni̱ꞌñúu na̱thu̱ún xa̱bo̱ tsí ngíníi jamí xa̱bo̱ tsí guáꞌdáá ga̱jma̱á numuu̱ ikhaa̱. Ikhúúnꞌ na̱thúu̱n mbá xúgíí rí niꞌthán máꞌ Moisés jamí rí nithan máꞌ xa̱bo̱ tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ wajyúú rí wéje̱ máꞌ rí ma̱ri̱gá: <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />rí ma̱ja̱ñúu Krísto̱, xúꞌkhue̱n máꞌ rí ikhaa̱ ma̱nindxu̱u̱ tsí ginii jayu ndayáa mbiꞌyuu, jamí rí ikhaa̱ ma̱nindxu̱u̱ agúún xa̱bo̱ judío̱ jamí xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún».<verse eid="ACT 26:23" /></para>
  <para style="s">Páblo̱ naꞌne ma̱ꞌne rí Agrípa̱ ma̱nimbo̱o̱ꞌ jaꞌyoo Krísto̱</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />Awúun máꞌ rí Páblo̱ naꞌthán-mbáyú-mina̱ꞌ ga̱jma̱á ajngáa rúꞌkhue̱n, a̱ꞌkhue̱n Fésto̱ niꞌthán gakhe̱:</para>
  <para style="p" vid="ACT 26:24">―¡Najmiyaaꞌ ikháánꞌ, Páblo̱! ¡Rí nathane̱-gajma̱a̱ guéño naꞌne rí ma̱jmiyaaꞌ!<verse eid="ACT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25" />Xómáꞌ Páblo̱ niꞌthán:</para>
  <para style="p" vid="ACT 26:25">―Ra̱ꞌkhá najmiyuꞌ, táta̱ nikhi̱i̱ Fésto̱, rí ajngáa rí gakon i̱tha̱nlo̱ꞌ jamí ajngáa rí ga̱náꞌyoo. <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />Táta̱ thúngaa Agrípa̱ ndaꞌyoo mújúun mbá xúgíí rúꞌkhue̱n, ikhaa jngó mbá jañii a̱kui̱nꞌ na̱tha̱n ná inuu̱. Tsíju̱mu̱ꞌ rí tsíꞌne-nuwii̱n nitháan rí na̱tha̱nlo̱ꞌ, numuu rí tágu̱ma ríge̱ꞌ ná ngu̱ꞌwa̱. <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />Táta̱ thúngaa Agrípa̱, ra̱ꞌkhá nanimba̱a̱ꞌ máꞌ rí nithan xa̱bo̱ tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ ráanꞌ. Ikhúúnꞌ nda̱yo̱o̱ rí nanimba̱a̱ꞌ rí nithee̱n.<verse eid="ACT 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28" />A̱ꞌkhue̱n Agrípa̱ niꞌthúun Páblo̱:</para>
  <para style="p" vid="ACT 26:28">―Phú i̱lájwíin ndiꞌyóo ma̱tha̱ne̱ rí ma̱nimbo̱ꞌ kajngó ma̱nindxu̱ꞌ xa̱bo̱ tsí na̱ka̱ tsu̱du̱u̱ Krísto̱.<verse eid="ACT 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29" />A̱ꞌkhue̱n niꞌthán Páblo̱:</para>
  <para style="p" vid="ACT 26:29">―Ga̱ꞌne phú i̱lájwíin o ga̱ꞌne mba̱yo̱ꞌ mbo̱ꞌ, Ana̱ꞌlóꞌ gágoo rí ikháánꞌ jamí mbá xúgíin tsí gachúún ge̱jyoꞌ nu̱dxawíín rí na̱tha̱n, ma̱nindxúu̱n xómá rí ikhúúnꞌ. I̱ndo̱ó máꞌ numuu rí ma̱xáꞌne rí xtuꞌúu̱n ga̱jma̱á ñuu ajwa̱nꞌ xómá rí ikhúúnꞌ.<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />Ído̱ wámbo̱o̱ Páblo̱ niꞌthán ajngáa rúꞌkhue̱n, a̱ꞌkhue̱n ni̱tu̱xu̱u̱ꞌ thúngaa Agrípa̱, ga̱jma̱á xa̱bo̱ ñajun Fésto̱, xúꞌkhue̱n máꞌ Bereníse̱, jamí mbá xúgíin xa̱bo̱ tsí nitrigi̱in ga̱jma̱á nindxúu̱n. <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />Jamí ído̱ nigóo̱ i̱mba̱ janíí, a̱ꞌkhue̱n nithan-mijnée̱ i̱ndo̱ó máꞌ ikhii̱n: «Nimbá nda̱a̱ rí neꞌne xa̱bo̱ tsíge̱ꞌ rí asndo jaꞌyoo rí ma̱ja̱ñúu, ni máꞌ rí ma̱gi̱de̱e̱ꞌ géjwa̱nꞌ».<verse eid="ACT 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 26:32" />A̱ꞌkhue̱n Agrípa̱ niꞌthúun Fésto̱: «Ma̱goo máꞌ ma̱nguanúu rí ma̱ngrigo̱o̱ꞌ xa̱bo̱ tsúꞌkhue̱n no rá, xí ra̱ꞌkhá numuu rí ikhaa̱ ni̱nda̱ꞌe̱e̱ rí Sésa̱r gáxudaa awan ga̱jma̱á numuu̱».<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s">Páblo̱ na̱ka̱ jiꞌyáa ná Róma̱</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />Ído̱ nimbánuu rí mu̱ꞌguáxo̱ꞌ ga̱jma̱á guꞌwá-rguwa ná numbaa Itália̱, a̱ꞌkhue̱n waxnáxi̱i̱ Páblo̱ ná ñawúun Júlio̱ gajmíí i̱ꞌwíin xa̱bo̱ tsí traꞌi̱in géjwa̱nꞌ. Júlio̱ ñajuun mbáa xa̱bo̱ tsí naꞌthán-ñájúún tsí ku̱ra̱tuun ajwa̱nꞌ, tsí ñajúún xa̱bi̱i Augústo̱. <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />A̱ꞌkhue̱n nijnguánxo̱ꞌ ná awúun mbá guꞌwá-rguwa rí na̱ꞌkha̱ ná Adramítio̱, rí ma̱ꞌga-ranújngoo ná xuajen rí triga̱ ná rawuun iya ná numbaa Ásia̱. A̱ꞌkhue̱n nigájnaxo̱ꞌ, jamí na̱ka̱ ga̱jma̱á nindxa̱ꞌxo̱ꞌ Aristárko̱, tsí na̱ꞌkha̱ ná xuajen Tesalóni̱ka̱ ná numbaa Masedónia̱. <verse eid="ACT 27:2" /><verse number="3" style="v" sid="ACT 27:3" />Ído̱ watse rí i̱mba̱ mbiꞌi niguáꞌnúxo̱ꞌ ná xuajen Sidón. Jamí Júlio̱ neꞌne-nga̱jo̱o̱ Páblo̱, niniñuu̱ rí ma̱ꞌgee̱ gáꞌñúu̱ iyanga̱jwee̱, kajngó ma̱janáa̱ rí ndaꞌyóo̱. <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />Ikhín máꞌ nigájnaxo̱ꞌ, jamí nikuáxo̱ꞌ ná i̱mba̱ níjñúu Chípre̱, numuu rí ná inaxo̱ꞌ wéje̱ ikhoo gíñá. <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />Ído̱ wámba̱ ninújngaxo̱ꞌ ná iya a̱pha̱ ná kri̱doo numbaa Silísia̱ ga̱jma̱á Panfília̱, a̱ꞌkhue̱n niguáꞌnúxo̱ꞌ ná xuajen Míra̱, rí ꞌgí ná numbaa Lísia̱.<verse eid="ACT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 27:6" />Ído̱ rí xa̱bo̱ tsí naꞌthán-ñájúún tsí ku̱ra̱tuun ajwa̱nꞌ nixkamaa mbá guꞌwá-rguwa rí na̱ꞌkha̱ ná Alejandría̱, a̱ꞌkhue̱n niꞌnii̱ rí ma̱jnguánxo̱ꞌ ná awúun ne̱, numuu rí inu máꞌ nagájnuu ne̱ na̱ka̱ ná Itália̱. <verse eid="ACT 27:6" /><verse number="7" style="v" sid="ACT 27:7" />Phú mbaꞌa mbiꞌi rí mañuu nikuáxo̱ꞌ ná inuu iya, jamí ga̱jma̱á kháan niguáꞌnúxo̱ꞌ ná kri̱doo xuajen Gnído̱. Numuu rí phú gakhe̱ narikhaxo̱ꞌ gíñá, ikhaa jngó ninújngaxo̱ꞌ ná kri̱doo Salmón, nikuáxo̱ꞌ ná i̱mba̱ níjñúu Kréta̱, mbaa rí kua̱ꞌa̱n ná awúun iya a̱pha̱. <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />Jamí ga̱jma̱á jamínu̱ꞌ nikuá-ranújngaxo̱ꞌ ná rawuun iya a̱pha̱, niguáꞌnúxo̱ꞌ ná mbiꞌyuu «Ná máján naguáꞌnú guꞌwá-rguwa», rí triga̱ ná mijngi xuajen Laséa̱.<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />Mbaꞌa guéño mbiꞌi ninújngoo, jamí naꞌne ngamí máꞌ rí magóó xa̱bo̱ ga̱jma̱á guꞌwá-rguwa ná inuu iya, numuu rí ninújngoo máꞌ mbiꞌi rí na̱gu̱ma-ri̱ya̱aꞌ ndxa̱a̱ rí nune̱-miꞌkhíí xa̱bo̱, ído̱ na̱gi̱ꞌdu̱u̱n go̱nꞌ rí naꞌne ngúwán, ikhaa jngó Páblo̱ niꞌthán-múꞌúún xa̱bo̱: <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />«Xa̱bo̱ buanuu, ikhúúnꞌ nda̱yo̱o̱ rí phú ngamí wáa gáꞌne ná inuu iya ná nakualóꞌ ge̱jyoꞌ. Phú mbaꞌa rí ma̱ndáti̱ga̱, ra̱ꞌkhá máꞌ i̱ndo̱ó guꞌwá-rguwa jamí rí jago̱ ne̱, rí asndo mangaa máꞌ ngamí rí ma̱ja̱ñálóꞌ ikháánꞌlóꞌ».<verse eid="ACT 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 27:11" />Xómáꞌ xa̱bo̱ tsí naꞌthán-ñájúún tsí ku̱ra̱tuun ajwa̱nꞌ, tánimbo̱o̱ꞌ rí naꞌthán Páblo̱, rí i̱tha̱án máꞌ ninimbo̱o̱ꞌ rí naꞌthán tsí na̱ka̱ jayóo guꞌwá-rguwa jamí tsí drígo̱o̱ ñajuun ne̱. <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />Numuu rí «Ná máján naguáꞌnú guꞌwá-rguwa» na̱nguá máján rí ma̱nújngaxo̱ꞌ go̱nꞌ rí naꞌne ngúwán ikhín, ikhaa jngó i̱tha̱án mbaꞌiin xa̱bo̱ nithan rí ma̱ga̱jnáxo̱ꞌ mu̱ꞌguá. Á gáꞌne xí ma̱ꞌngo̱o̱ ma̱guáꞌnúxo̱ꞌ ná Feníse̱, ná naguáꞌnú guꞌwá-rguwa ná mbayuu máꞌ Kréta̱, rí giaxu̱u̱ ná níjñú xti̱yu̱u̱ꞌ ná najngúun a̱kha̱ꞌ jamí ná níjñú mújúun ná na̱ꞌkha̱ a̱kha̱ꞌ, kajngó ma̱nújngaxo̱ꞌ go̱nꞌ rí naꞌne ngúwán ikhín.<verse eid="ACT 27:12" /></para>
  <para style="s">Naꞌne ruꞌwa ga̱jma̱á gíñá ná inuu iya a̱pha̱</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />Ído̱ ni̱gi̱ꞌdu̱u̱n na̱ꞌkha̱ waba jayu gíñá ná giaxu̱u̱ jawáá, ni̱ju̱múu̱ rí ma̱goo máꞌ ma̱ga̱jnúu̱ magóo̱. A̱ꞌkhue̱n ni̱rawíi̱ ajwa̱nꞌ mixngaa rí wájun jayóo guꞌwá-rguwa, jamí nikuáxo̱ꞌ mbá kri̱go̱o̱ rawuun iya a̱pha̱ ná mbayuu Kréta̱. <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />I̱ndo̱ó máꞌ numuu rí tágajyúu máꞌ ído̱ rí ni̱ꞌkha̱ mbá gíñá rí phú gakhi̱i̱ nixpáthun ná tsu̱du̱u̱ guꞌwá-rguwa. Gíñá rúꞌkhue̱n mbiꞌyuu Euroklidón. <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />A̱ꞌkhue̱n warmajngua̱ꞌ guꞌwá-rguwa neꞌne gíñá, numuu rí nánguá ni̱ꞌnga̱ꞌxo̱ꞌ mu̱ne̱ rí ma̱ꞌga ne̱ ná na̱ꞌkha̱ gíñá, ikhaa jngó ni̱ni̱ꞌñá-mijnáxo̱ꞌ rí ma̱ꞌga jaguáanꞌxo̱ꞌ ne̱. <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />A̱ꞌkhue̱n ninújngaxo̱ꞌ ná i̱mba̱ níjñúu mbá mbaa lájwíin rí mbiꞌyuu Kláuda̱, rí kua̱ꞌa̱n ná awúun iya a̱pha̱, numuu rí na̱nguá ixnúu guéño gíñá ná mbíꞌthóo rúꞌkhue̱n. Ga̱jma̱á kháan ni̱ꞌnga̱ꞌxo̱ꞌ ni̱xma̱tráꞌáan ixe̱-rguwa lájwíin rí na̱ꞌkha̱ xawi rí ma̱jáwíin ga̱jma̱á xa̱bo̱. <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />Jamí ído̱ wámbúu̱n ni̱xma̱tráꞌáa̱n ne̱, a̱ꞌkhue̱n ni̱ru̱ꞌwáa̱ xa̱ꞌ smídúu guꞌwá-rguwa ga̱jma̱á ñuu kajngó ma̱gi̱ꞌdoo ski̱yu̱u̱ꞌ ne̱. Ni̱xrígúu̱ xtíin rí na̱ka̱ ga̱jma̱á guꞌwá-rguwa, numuu rí namíñúu̱ rí ma̱nguaꞌán ne̱ ná awúun we̱ꞌe̱ rí mbiꞌyuu Sírte̱, jamí ni̱ni̱ꞌñá-mijnée̱ rí ma̱ꞌga jiꞌdii̱n gáꞌne gíñá. <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />Ído̱ watse rí i̱mba̱ mbiꞌi, phú gakhe̱ igíꞌníi̱ eꞌne ruꞌwa gíñá, ikhaa jngó ni̱gíꞌdíi̱n ni̱stuáꞌée̱n ná awúun iya a̱pha̱ rí jago̱ guꞌwá-rguwa kajngó ma̱ꞌne wiphi ne̱. <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />Jamí ído̱ neꞌne tiriatsú mbiꞌi, a̱ꞌkhue̱n ga̱jma̱á máꞌ ñawánxo̱ꞌ ni̱stuáꞌánxo̱ꞌ<note caller="+" style="f"><char style="fr" closed="false">27.19 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán: «ga̱jma̱á máꞌ ñawúu̱n ni̱stuáꞌée̱n».</char></note> mangaa mbá xúgíí rí najmaa ná awúun guꞌwá-rguwa. <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />Phú mbaꞌa mbiꞌi ninújngoo rí nánguá nikujmaa a̱kha̱ꞌ ni máꞌ a̱ꞌgua̱án, jamí i̱tha̱án máꞌ gakhe̱ i̱ka̱-raxnúu ruꞌwa ga̱jma̱á gíñá, ikhaa jngó nánguá máꞌ guáꞌthi̱ínxo̱ꞌ rí ma̱jríñáaꞌxo̱ꞌ.<verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />Numuu rí mbaꞌa máꞌ mbiꞌi ninújngoo rí nánguá iphóxo̱ꞌ guma, a̱ꞌkhue̱n Páblo̱ ni̱we̱je̱ ná majñu̱ú mbá xúgíin xa̱bo̱, jamí niꞌthúu̱n: «Xa̱bo̱ buanuu, i̱tha̱án máꞌ máján neꞌne xí ninimba̱ꞌlaꞌ ju̱ya̱á rí ni̱tha̱nꞌlaꞌ no rá, rí ma̱xágájnalóꞌ ná Kréta̱. I̱ndo̱ó máꞌ nigájnalóꞌ rí mu̱gíꞌníílóꞌ gakhe̱ ríge̱ꞌ jamí ma̱ndáti̱ga̱ꞌlóꞌ. <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />Xómáꞌ xúge̱ꞌ rá, na̱tha̱nꞌlaꞌ rí gu̱xna̱-míjnálaꞌ tsiakhe̱, numuu rí ma̱xájáñuu asndo nimbáa tsí ikháanꞌlaꞌ, rí i̱ndo̱ó máꞌ guꞌwá-rguwa ma̱mbáa. <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />Numuu rí nduꞌwíín nixtáa ga̱jma̱á nindxu̱ꞌ ánje̱l tsí nixúngua̱a̱ꞌ Ana̱ꞌlóꞌ tsí ñajunꞌ xa̱bi̱i jamí na̱ñajun ná inuu. <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />Xáꞌnii niꞌthínꞌ: “Páblo̱, ma̱xámíñaaꞌ, numuu ndaꞌyóo rí ma̱ta̱xna̱xí-mina̱ꞌ ná inuu Sésa̱r. Ga̱jma̱á numaaꞌ ikháánꞌ, Ana̱ꞌlóꞌ ma̱ꞌne-jáwíin mbá xúgíin xa̱bo̱ tsí nagóó ga̱jma̱á nindxa̱a̱ꞌ”. <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />Ikhaa jngó, xa̱bo̱ buanuu, ¡gu̱xna̱-míjnálaꞌ tsiakhe̱! Numuu rí ikhúúnꞌ nanimbo̱ꞌ ja̱yo̱o̱ Ana̱ꞌlóꞌ rí ma̱ꞌne xómá rí niꞌthínꞌ ánje̱l. <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />I̱ndo̱ó máꞌ numuu rí ndaꞌyóo rí mu̱ꞌgua̱ gáwajúunlóꞌ ná mbá mbaa rí kua̱ꞌa̱n ná awúun iya a̱pha̱».<verse eid="ACT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />Mbá mbroꞌon, ído̱ ninújngoo máꞌ gu̱wa̱ꞌ i̱kho̱ (14) mbiꞌi rí nakuáxo̱ꞌ ga̱jma̱á guꞌwá-rguwa, juwaxo̱ꞌ ná inuu iya a̱pha̱ rí mbiꞌyuu Adriáti̱ko̱. Xó mbá tikhu mbroꞌon wáa eꞌne, a̱ꞌkhue̱n tsí nagóó juñu̱ú guꞌwá-rguwa ni̱ju̱mu̱ú rí nangiyuu máꞌ ma̱guáꞌnúxo̱ꞌ ná ju̱ba̱ꞌ. <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />A̱ꞌkhue̱n ni̱giéwee̱n kajngó mbuyáa̱ wátha̱ me̱jno̱ꞌ iya, jamí ndiyáa̱ rí mbá skíñú (20) xtawáán me̱jno̱ꞌ ne̱. Nigóo̱ i̱tha̱án xóó, a̱ꞌkhue̱n ni̱giéwee̱n mbu̱júu̱n, jamí ndiyáa̱ rí mbá gu̱wa̱ꞌ-nítsu (15) xtawáán rí me̱jno̱ꞌ ne̱. <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />Jamí namíñúu̱ rí ma̱ga̱ta̱ꞌmáa guꞌwá-rguwa ná tsu̱du̱u̱ itsí mba̱ꞌwo̱ ná awúun iya, ikhaa jngó ná xtuun guꞌwá-rguwa ni̱stuáꞌée̱n ná awúun iya akho̱ ajwa̱nꞌ mixngaa rí ma̱wa̱jún jayóo̱ ne̱, jamí ra̱ꞌkhá ma̱ꞌne nguáná naꞌne a̱kuíi̱n rí ma̱tse. <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />Xómáꞌ xa̱bo̱ tsí nagóó juñu̱ú guꞌwá-rguwa nini̱i̱ magáñúu̱ ngu̱ꞌwa̱, ikhaa jngó ni̱gíꞌdíi̱n ni̱xríguíi̱ ixe̱-rguwa lájwíin ná inuu iya a̱pha̱, jamí nini̱i̱ xó rí nandúu̱n mu̱stuáꞌée̱n ajwa̱nꞌ mixngaa rí ma̱wa̱jún jayóo guꞌwá-rguwa ná inuu ne̱. <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />A̱ꞌkhue̱n Páblo̱ niꞌthúun xa̱bo̱ tsí naꞌthán-ñájúún tsí ku̱ra̱tuun ajwa̱nꞌ gajmíí máꞌ xa̱bii̱: «Xí xa̱bo̱ tsíge̱ꞌ na̱nguá gatiin ná awúun guꞌwá-rguwa, ikháanꞌlaꞌ ma̱xáxóo ma̱jáwiáanꞌlaꞌ». <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />A̱ꞌkhue̱n xa̱bo̱ tsí ku̱ra̱tuun ajwa̱nꞌ ni̱ru̱thii̱n ñuu rí xtoꞌwóo ga̱jma̱á ixe̱-rguwa lájwíin, jamí ni̱ni̱ꞌñáa̱ rí ma̱ráka ne̱ ná awúun iya a̱pha̱.<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />Ído̱ rí na̱ꞌkha̱-ratse máꞌ, a̱ꞌkhue̱n Páblo̱ naxnúú tsiakhe̱ mbá xúgíin xa̱bo̱ rí mu̱pho̱ guma. Xáꞌnii niꞌthúu̱n: «Xúge̱ꞌ eꞌne gu̱wa̱ꞌ i̱kho̱ (14) mbiꞌi rí juwalaꞌ naxná-gamiéjwanlaꞌ dí gáríga̱, jamí nu̱ne̱-miꞌkhíílaꞌ, tsípholaꞌ nitháan. <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />Ikhaa jngó, na̱tha̱n-jáñalaꞌ rí mu̱peꞌtsolaꞌ kajngó ma̱guaꞌdáálaꞌ tsiakhe̱ rí ma̱juwalaꞌ, numuu rí ni máꞌ tsu̱u̱n idxa̱ꞌlaꞌ ma̱xándáti̱ga̱ asndo nimbá».<verse eid="ACT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 27:35" />Jamí ído̱ wámbo̱o̱ niꞌthée̱n ajngáa rúꞌkhue̱n, a̱ꞌkhue̱n niwatuu̱n guma jamí niríguu̱ la gamaku inuu Ana̱ꞌlóꞌ ná inúú mbá xúgíin xa̱bo̱. Nixpíꞌthájngaa̱ guma jamí nigíꞌdu̱u̱n nikuiꞌtsii̱. <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />A̱ꞌkhue̱n mbá xúgíi̱n nixna-mijnáa̱ tsiakhe̱, jamí nipiꞌtsii̱ mangii̱n. <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />Rí mbá xúgiáanꞌxo̱ꞌ tsí gacháanꞌxo̱ꞌ ná awúun guꞌwá-rguwa, ñajwanxo̱ꞌ a̱jma̱ siénto̱ atsú skíñú gu̱wa̱ꞌ-nítsu i̱mba̱ (276). <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />Jamí ído̱ ni̱gi̱ꞌmúu̱ rí napiꞌtsii̱, a̱ꞌkhue̱n ni̱stuáꞌée̱n ixí iña ná awúun iya a̱pha̱ kajngó ma̱ꞌne wiphi guꞌwá-rguwa.<verse eid="ACT 27:38" /></para>
  <para style="s">Na̱rmáꞌán guꞌwá-rguwa ná awúun iya a̱pha̱</para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />Ído̱ rí watse, xa̱bo̱ tsí nagóó juñu̱ú guꞌwá-rguwa na̱nguá nene̱-nuwii̱n mbaa rúꞌkhue̱n, i̱ndo̱ó máꞌ numuu rí ndiyáa̱ mbá ñawúun ná na̱ráꞌaa iya a̱pha̱, a̱ꞌkhue̱n ni̱ꞌgí-mijnée̱ rí muni̱i̱ magóo̱ juñúu̱ guꞌwá-rguwa ikhín. <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />A̱ꞌkhue̱n ni̱ru̱thii̱n ñawiin ajwa̱nꞌ mixngaa rí nawájun jayóo guꞌwá-rguwa, ni̱ni̱ꞌñáa̱ ne̱ ná awúun iya. Mangaa máꞌ nene̱-xawáa̱ ñawiin ixe̱ lájwíin rí jayá ikhoo guꞌwá-rguwa, a̱ꞌkhue̱n ni̱xma̱tráꞌée̱n ná inuu gíñá xtíin rí na̱ka̱ ga̱jma̱á ne̱ ná inuu ne̱, xómáꞌ guꞌwá-rguwa ni̱ka̱ jmbuu ná rawuun iya. <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />I̱ndo̱ó máꞌ numuu rí ni̱ka̱ gáwi̱ji̱i ne̱ ná nawa̱a a̱jma̱ itsu̱u̱ iya, a̱ꞌkhue̱n niꞌdumaꞌán idxu̱u̱ guꞌwá-rguwa ná we̱ꞌe̱, jamí ni̱we̱je̱ xa̱ꞌ mbá jayu ne̱. Xómáꞌ xtuun ne̱ na̱ka̱-ramigu eꞌne ski̱yu̱u̱ꞌ iya a̱pha̱ rí naxpátuma ná tsu̱du̱u̱ ne̱.<verse eid="ACT 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42" />A̱ꞌkhue̱n xa̱bo̱ tsí ku̱ra̱tuun ajwa̱nꞌ niguáꞌdáá awan rí mu̱radíin xa̱bo̱ tsí na̱ka̱ jiꞌdiin géjwa̱nꞌ, kajngó nimbáa ma̱xáꞌngo̱o̱ magáyuu rí ma̱ꞌga ná inuu iya. <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />Xómáꞌ xa̱bo̱ tsí naꞌthán-ñájúún tsí ku̱ra̱tuun ajwa̱nꞌ ndiyoo̱ rí ma̱ꞌne-jríya̱a̱ꞌ Páblo̱, ikhaa jngó ni̱we̱je̱-ꞌthúu̱n rí mu̱xúni̱i̱ rúꞌkhue̱n. A̱ꞌkhue̱n nixná-ñájúu̱n tsí na̱ma̱ñúú nagóó ná inuu iya rí mu̱stuáꞌán-mijnée̱ ginuu̱, jamí magóo̱ ma̱díwíi̱n ná rawuun iya. <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />Jamí tsí i̱ꞌwíin, niꞌthée̱n rí magóó ga̱jma̱á ixe̱ xapa, o ga̱jma̱á xuíꞌthóo ixu̱u̱ guꞌwá-rguwa mbo̱ꞌ. Xkuaꞌnii neꞌne rí mbá xúgíi̱n nijáwíi̱n, ningujwíi̱n ná rawuun iya.<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s">Rí neꞌne Páblo̱ ná Málta̱</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />Ído̱ nijáwiáanꞌ mbá xúgiáanꞌxo̱ꞌ, a̱ꞌkhue̱n ni̱ma̱ñaxo̱ꞌ rí mbaa rí kua̱ꞌa̱n ná awúun iya a̱pha̱ mbiꞌyuu Málta̱. <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />Xómáꞌ xa̱bo̱ tsí júwa̱ꞌ ikhín phú máján ni̱dríguáa̱nꞌxo̱ꞌ. Numuu rí naxnúu ruꞌwa jamí phú ngúwán eꞌne mangaa, ikhaa jngó ni̱ꞌgíi̱ agu ná mu̱tsiga-mijnáaxo̱ꞌ. <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />A̱ꞌkhue̱n Páblo̱ nigímbú mbá tikhu ixe̱ rí nijndoo, nigruíye̱e̱ꞌ ne̱ ná awúun agu mi̱kha. A̱ꞌkhue̱n ni̱ga̱ti̱ya̱a̱ꞌ-ragáyuu mbáa a̱bo̱ꞌ ná inuu rí mika, jamí ni̱gi̱ꞌmee̱ niꞌkhui̱i̱ ñawúun Páblo̱. <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />Ído̱ rí xa̱bo̱ tsí júwa̱ꞌ ikhín ndiyáá rí brákamaa a̱bo̱ꞌ ná ñawúun Páblo̱, a̱ꞌkhue̱n nithan-mijnée̱: «Phú gakon rí xa̱bo̱ tsí ni̱gu̱díin xa̱bo̱ ñajuun tsíge̱ꞌ. Maske máꞌ tájáñuu̱ neꞌne iya a̱pha̱, xómáꞌ ana̱ꞌlóꞌ tsíxnúu̱ rí ma̱xtáa̱».<verse eid="ACT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 28:5" />I̱ndo̱ó máꞌ numuu rí Páblo̱ nixprígúu ñawúun ná awúun agu, a̱ꞌkhue̱n ni̱rákaa a̱bo̱ꞌ jamí nda̱a̱ máꞌ rí nigíꞌnuu̱. <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />Mbá xúgíin xa̱bo̱ ni̱ju̱mu̱ú rí mu̱ꞌwan ñawúu̱n, o nda̱a̱ ajngóo gángáxi̱i̱ ma̱ja̱ñúu̱ mbo̱ꞌ. I̱ndo̱ó máꞌ numuu rí ído̱ neꞌne mba̱yo̱ꞌ máꞌ rí niguáꞌthíi̱n, jamí ndiyáa̱ rí nda̱a̱ nimbá rí nigíꞌnuu Páblo̱, a̱ꞌkhue̱n ni̱riꞌkhuu̱ rí na̱ju̱múu̱ jamí nithee̱n rí ra̱ꞌkhá xa̱bo̱ numbaa ñajuu̱n.<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />Mijngi máꞌ ikhín ríga̱ mbayuu mbáa xa̱bo̱ tsí mbiꞌyuu Públio̱, tsí ñajuun xa̱bo̱ ede̱ ginii ná mbaa rí kua̱ꞌa̱n ná awúun iya. Ikhaa̱ phú máján ni̱grui̱guáa̱nꞌxo̱ꞌ jamí niwajúnxo̱ꞌ mbá atsú mbiꞌi ná guꞌwóo̱. <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />Jamí anu̱u̱ Públio̱ kra̱ꞌmáa ná xi̱yoo, najáñuu̱ eꞌne nandii mika jamí nandii tha̱a̱ iꞌdi. Xómáꞌ Páblo̱ ni̱to̱ꞌo̱o̱ gáꞌyoo̱, niꞌthán-jáñuu̱ Ana̱ꞌlóꞌ ga̱jma̱á numuu̱, nda̱wa̱á a̱ꞌkhue̱n nixkrámaa̱ jamí neꞌne-thanuu̱. <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />Ído̱ ni̱dxawíín xa̱bo̱ rúꞌkhue̱n, a̱ꞌkhue̱n niguwá i̱ꞌwíin tsí najáñúú tsí júwa̱ꞌ ná mbaa rúꞌkhue̱n, jamí ni̱gu̱ma-thanúu̱ mangii̱n. <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />Xa̱bo̱ tsúꞌkhue̱n phú máján ndiya-makuaxo̱ꞌ mangiin. Jamí ído̱ ni̱ga̱nú mbiꞌi rí ma̱ga̱jnáxo̱ꞌ, a̱ꞌkhue̱n nixnaxo̱ꞌ mbá xúgíí rí mba̱ꞌyáxo̱ꞌ ná nakuáxo̱ꞌ.<verse eid="ACT 28:10" /></para>
  <para style="s">Na̱ga̱nú Páblo̱ ná Róma̱</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />Ído̱ ninújngoo atsúun go̱nꞌ rí juwaxo̱ꞌ ná mbaa rúꞌkhue̱n, a̱ꞌkhue̱n nijnguánxo̱ꞌ ná awúun mbá guꞌwá-rguwa rí na̱ꞌkha̱ ná Alejandría̱ rí ni̱we̱je̱ naꞌcho̱o̱ ikhín kajngó ma̱nújngoo go̱nꞌ rí naꞌne ngúwán. Guꞌwá-rguwa rúꞌkhue̱n jayá xtiꞌkhuu Kásto̱r ga̱jma̱á Pólu̱ks. <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />Ído̱ niguáꞌnúxo̱ꞌ ná Sirakúsa̱, niwajúnxo̱ꞌ mbá atsú mbiꞌi ikhín. <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />A̱ꞌkhue̱n nigájnaxo̱ꞌ nikuáxo̱ꞌ mbá nawa̱a̱ rawuun iya jamí niguáꞌnúxo̱ꞌ ná Réjio̱. Ído̱ watse rí i̱mba̱ mbiꞌi ni̱ga̱nú gíñá rí na̱ꞌkha̱ ná giaxu̱u̱ jawáá, ikhaa jngó ndiyoo nigájnaxo̱ꞌ, jamí mbiꞌi riajmu̱u̱ niguáꞌnúxo̱ꞌ ná Puteóli̱. <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />Ikhín ni̱xkamiixo̱ꞌ a̱ngia̱nꞌlóꞌ, jamí nithan-jáñaxo̱ꞌ rí ma̱nguanáxo̱ꞌ ga̱jma̱á nindxúu̱n mbá juwan mbiꞌi. Nda̱wa̱á a̱ꞌkhue̱n nikuáxo̱ꞌ ná Róma̱. <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />Ído̱ ni̱dxawíín a̱ngia̱nꞌlóꞌ tsí júwa̱ꞌ ná Róma̱ rí nakuáxo̱ꞌ ikhín, a̱ꞌkhue̱n niguwée̱ꞌ gútsijnaxo̱ꞌ ná Xuáá drígo̱o̱ Ápio̱, jamí ná mbiꞌyuu Atsú Guꞌwá ná nawájun xa̱bo̱. Ído̱ Páblo̱ ndiꞌñúú a̱ngia̱nꞌlóꞌ, a̱ꞌkhue̱n niríguu̱ la gamaku inuu Ana̱ꞌlóꞌ jamí ndiyáa la tsiakhe̱. <verse eid="ACT 28:15" /><verse number="16" style="v" sid="ACT 28:16" />Ído̱ niguáꞌnúxo̱ꞌ ná Róma̱, a̱ꞌkhue̱n xa̱bo̱ tsí naꞌthán-ñájúún tsí ku̱ra̱tuun ajwa̱nꞌ nixnáxii̱n xa̱bo̱ tsí jaguu̱n magóó géjwa̱nꞌ ná ñawúun xa̱bo̱ tsí naꞌthán-ñájúún tsí nu̱ña̱wa̱án. Xómáꞌ<note caller="+" style="f"><char style="fr" closed="false">28.16 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí tsíꞌthán: «a̱ꞌkhue̱n xa̱bo̱ tsí naꞌthán-ñájúún tsí ku̱ra̱tuun ajwa̱nꞌ nixnáxii̱n tsí jaguu̱n magóó géjwa̱nꞌ ná ñawúun xa̱bo̱ tsí naꞌthán-ñájúún tsí nu̱ña̱wa̱án. Xómáꞌ».</char></note> Páblo̱ nijanáá rí ma̱xtáa mbá guꞌwá janíí jamí ni̱tia̱wáa̱n eꞌne mbáa xa̱bo̱ tsí jayá ajwa̱nꞌ.<verse eid="ACT 28:16" /></para>
  <para style="s">Páblo̱ naꞌthán-ráꞌa ajngóo Ana̱ꞌlóꞌ ná Róma̱</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />Ído̱ ninújngoo máꞌ atsú mbiꞌi, a̱ꞌkhue̱n Páblo̱ nindxaꞌwúún xa̱bo̱ judío̱ tsí ñajúún xa̱bo̱ ede̱, tsí júwa̱ꞌ máꞌ ikhín. Ído̱ nijúwe̱e̱ꞌ mbá ꞌnduꞌ, a̱ꞌkhue̱n niꞌthúu̱n xáꞌnii:</para>
  <para style="p" vid="ACT 28:17">―Xa̱bo̱ buanuu a̱ngui̱nꞌ, ikhúúnꞌ nda̱a̱ nitháan rí ra̱máján ni̱ñu̱úlo̱ꞌ xa̱bo̱ xuajñalóꞌ, ni máꞌ tátha̱n rí ra̱máján ga̱jma̱á numuu rí nene̱ jañúú táta̱-xi̱ꞌñálóꞌ wajyúú. Maske máꞌ xúꞌkhue̱n, asndo nákhí máꞌ ná Jerusalén ñúꞌún nikhúúnlo̱ꞌ jamí waxnáxu̱ún rí ma̱ꞌgá géjwa̱nꞌ ná ñawúún xa̱bo̱ Róma̱. <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />Ído̱ rí ikhii̱n wámbúu̱n niñi̱ꞌ mbaꞌa graxe̱, a̱ꞌkhue̱n ndiñúu̱ mune̱-jríñúu̱ꞌ, numuu rí na̱nguá ni̱xkamaa̱ nimbá aꞌkhúnꞌ rí asndo jaꞌyoo ma̱ja̱ñúꞌ. <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />Xómáꞌ xa̱bo̱ judío̱ niwajún-ꞌthíi̱n kajngó ma̱xáwaná-ti̱yo̱ꞌ, ikhaa jngó ni̱nda̱ꞌa̱lo̱ꞌ rí thúngaa Sésa̱r gáxudaa awan ga̱jma̱á numuꞌ, maske máꞌ na̱nguá gúꞌdo̱ꞌ rí ma̱ne̱ aꞌkhúún xa̱bo̱ xuajñuꞌ. <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />Ikhaa numuu ríge̱ꞌ ni̱ndxa̱ꞌwa̱ꞌlaꞌ ma̱guwalaꞌ, kajngó mba̱ya̱ꞌlaꞌ jamí ma̱tha̱nꞌlaꞌ. Nandoꞌ rí ma̱gi̱da̱ꞌ idxa̱ꞌlaꞌ rí ikhúúnꞌ xtoꞌóꞌ ga̱jma̱á ñuu ajwa̱nꞌ ríge̱ꞌ, ga̱jma̱á numuu rí guáꞌthi̱ínlóꞌ ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ tsáanꞌ ñajwanlóꞌ xa̱bo̱ Israél.<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />A̱ꞌkhue̱n ikhii̱n nitháa̱n:</para>
  <para style="p" vid="ACT 28:21">―Ikháanꞌ túdrígúxo̱ꞌ nimbá i̱yi̱i̱ꞌ rí na̱ꞌkha̱ ná Judéa̱ rí naꞌthán ga̱jma̱á numaaꞌ ikháánꞌ, ni máꞌ táꞌkha̱ nimbáa dxájwalóꞌ ñúꞌún tsí maꞌthánxo̱ꞌ rí ra̱máján ithane̱. <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />I̱ndo̱ó máꞌ numuu rí nandaxo̱ꞌ mu̱dxawíín rí natatsaꞌwá-mina̱ꞌ ikháánꞌ. Numuu nu̱dxawíínxo̱ꞌ rí asndo nguáa máꞌ nuthan xa̱bo̱ rí ra̱máján ga̱jma̱á numuu gisngáá mi̱nduwa ríge̱ꞌ.<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />A̱ꞌkhue̱n ni̱ꞌgíi̱ mbá mbiꞌi rí ma̱mba̱xíi̱n gajmíi̱ Páblo̱, jamí ído̱ ni̱ga̱nú mbiꞌi rúꞌkhue̱n rá, phú mbaꞌiin xa̱bo̱ niguáꞌnú ná guꞌwá rí xtáa̱. A̱ꞌkhue̱n asndo nákhí miꞌcha̱ jamí asndo wakhíí Páblo̱ niꞌthán-makúu̱n ga̱jma̱á numuu rí Ana̱ꞌlóꞌ ñajuun tsí naꞌthán-ñájúún xa̱bo̱. Naꞌnii̱ rí ma̱nimbúu̱n juyáa̱ Jesús ga̱jma̱á majñu̱u̱ xtángawoo Moisés jamí ga̱jma̱á majñu̱u̱ i̱ñu̱ú tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ wajyúú. <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />Mbá tikhuun ninimbu̱únꞌ ajngáa rí niꞌthán Páblo̱, xómáꞌ tsí i̱ꞌwíin ra̱khúu̱n gánimbúu̱n. <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />Jamí ra̱khóo gúwa̱a ju̱múu̱, ikhaa jngó ni̱gíꞌdíi̱n nigúu̱n. A̱ꞌkhue̱n Páblo̱ niꞌthúu̱n ajngáa ríge̱ꞌ: «Áan, phú gakon máꞌ rí niꞌthán Xu̱u̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ Isaía̱s tsí ni̱gu̱wíjnga̱a ajngóo Ana̱ꞌlóꞌ jno̱ꞌ, nákhí niꞌthúu̱n táta̱-xi̱ꞌñálóꞌ:<verse eid="ACT 28:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ACT 28:26" />“Ayu gára̱thu̱ún xa̱bo̱ ná xuajen ríge̱ꞌ:</para>
  <para style="q" vid="ACT 28:26">Maske máꞌ ikháanꞌlaꞌ nu̱dxawíínlaꞌ, ma̱xáfraꞌa̱ꞌlaꞌ.</para>
  <para style="q" vid="ACT 28:26">Maske máꞌ ikháanꞌlaꞌ nu̱ya̱xe̱laꞌ, mu̱xúya̱álaꞌ rí ríga̱.<verse eid="ACT 28:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ACT 28:27" />Numuu rí xa̱bo̱ tsíge̱ꞌ neꞌne gúkú a̱kui̱ín.</para>
  <para style="q" vid="ACT 28:27">Nijúgoo ñaꞌwúu̱n,</para>
  <para style="q" vid="ACT 28:27">xúꞌkhue̱n máꞌ nijúgoo idúu̱n.</para>
  <para style="q" vid="ACT 28:27">Kajngó mu̱xúyáa̱ ga̱jma̱á idúu̱n,</para>
  <para style="q" vid="ACT 28:27">ni máꞌ mu̱xúdxawíi̱n ga̱jma̱á ñaꞌwúu̱n,</para>
  <para style="q" vid="ACT 28:27">ni máꞌ ma̱xáfruꞌúu̱n ga̱jma̱á a̱kuíi̱n,</para>
  <para style="q" vid="ACT 28:27">ni máꞌ ma̱xáthangii̱n ná inuꞌ ikhúúnꞌ,</para>
  <para style="q" vid="ACT 28:27">kajngó ma̱xáne̱-thanúu̱lo̱ꞌ”.<note caller="+" style="f"><char style="fr" closed="false">28.26-27 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 6.9-10.</char></note><verse eid="ACT 28:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="ACT 28:28" />Ikhaa jngó gu̱ya̱álaꞌ rí ajngáa ríge̱ꞌ na̱ka̱ ná inúú xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, rí ma̱jáwíi̱n gáꞌne Ana̱ꞌlóꞌ. Jamí ikhii̱n rí mu̱dxawíi̱n ne̱». <verse eid="ACT 28:28" /><verse number="29" style="v" sid="ACT 28:29" />Jamí ído̱ wámbo̱o̱ Páblo̱ niꞌthán ajngáa rúꞌkhue̱n, a̱ꞌkhue̱n nigúun xa̱bo̱ judío̱ jamí phú mikoo nuthan-mijnée̱ awúun máꞌ rí nagúu̱n.<note caller="+" style="f"><char style="fr" closed="false">28.29 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngóo kíxnuu ríge̱ꞌ.</char></note><verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />Xómáꞌ Páblo̱ nixtáa̱ mbá jañii rí a̱jma̱ tsigu ná awúun mbá guꞌwá rí naꞌne-numuu̱, jamí na̱grui̱gúu̱n mbá xúgíin xa̱bo̱ tsí nagóó gúyáa̱. <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />Naꞌthán-ráꞌee̱ a̱pha̱ ná inúú xa̱bo̱ rí Ana̱ꞌlóꞌ ñajuun tsí naꞌthán-ñájúún xa̱bo̱, xúꞌkhue̱n máꞌ naꞌsngáa̱ ga̱jma̱á numuu Táta̱ Jesukrísto̱, jamí nimbáa tsírikhoo rí maꞌthée̱n.<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>