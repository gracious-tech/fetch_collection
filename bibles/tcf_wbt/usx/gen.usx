<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GEN" style="id">tcfU (01-Gén) - Me̱ꞌpha̱a̱ Mañúwi̱ín (Malinaltepec) Unicode version; PZM 13-dic-2005, c50/v1533</book>
  <para style="h">XÓ NI̱GI̱ꞋDU̱U̱N-MUU</para>
  <para style="toc3">Gen</para>
  <para style="toc2">XÓ NI̱GI̱ꞋDU̱U̱N-MUU</para>
  <para style="toc1">I̱yu̱u̱ꞌ xó ni̱gi̱ꞌdu̱u̱n-muu</para>
  <para style="mt">I̱yu̱u̱ꞌ xó ni̱gi̱ꞌdu̱u̱n-muu</para>
  <chapter number="1" style="c" sid="GEN 1" />
  <para style="s">Xóo ni̱gu̱maa ku̱maa numbaa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 1:1" />Nákhí rí ginii, neꞌne ku̱maa Ana̱ꞌlóꞌ mikhu ga̱jma̱á ju̱ba̱ꞌ. <verse eid="GEN 1:1" /><verse number="2" style="v" sid="GEN 1:2" />Mbá nikhuáa kri̱ga̱ ju̱ba̱ꞌ jamí kri̱ga̱ chú ne̱. I̱ndo̱ó jína kri̱ga̱ inuu iya me̱jno̱ꞌ a̱pha̱. I̱ndo̱ó Xu̱u̱ꞌ Ana̱ꞌlóꞌ ngrámuu inuu iya.<verse eid="GEN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 1:3" />Niꞌthán Ana̱ꞌlóꞌ: «Ga̱ri̱gá agu». Jngó niríga̱ agu rí nambiꞌi. <verse eid="GEN 1:3" /><verse number="4" style="v" sid="GEN 1:4" />A̱ꞌkhue̱n ndiꞌyoo Ana̱ꞌlóꞌ rí máján agu. Jamí xúꞌkhue̱n nixpíꞌtháa̱ ne̱ ga̱jma̱á rí jína. <verse eid="GEN 1:4" /><verse number="5" style="v" sid="GEN 1:5" />Rí agu, Ana̱ꞌlóꞌ nixná mbiꞌyuu «mbiꞌi», rí jína nixná mbiꞌyuu̱ «mbroꞌon». Niríga̱ mbroꞌon jamí mbiꞌi, rí neꞌne timbá mbiꞌi.<verse eid="GEN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 1:6" />A̱ꞌkhue̱n niꞌthán Ana̱ꞌlóꞌ: «Ga̱ri̱gá gaꞌchú a̱pha̱ ná ti̱kua̱pho̱o̱ iya, jngó ma̱wiꞌtháa iya». <verse eid="GEN 1:6" /><verse number="7" style="v" sid="GEN 1:7" />Xkuaꞌnii máꞌ nimbánuu. Ana̱ꞌlóꞌ neꞌne gaꞌchú a̱pha̱, ikhaa jngó nixpíꞌtháa̱ iya rí kri̱ga̱ agoo gaꞌchú ga̱jma̱á iya rí ríga̱ tsu̱du̱u̱ gaꞌchú ri̱jma̱á. <verse eid="GEN 1:7" /><verse number="8" style="v" sid="GEN 1:8" />Rí gaꞌchú a̱pha̱, Ana̱ꞌlóꞌ nixná mbiꞌyuu «mikhu». Niríga̱ mbroꞌon jamí mbiꞌi, rí mbiꞌi riajmu̱u̱.<verse eid="GEN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 1:9" />A̱ꞌkhue̱n niꞌthán Ana̱ꞌlóꞌ: «A̱gu̱waa̱ iya. I̱mbóó gáꞌni̱i̱ rí kri̱ga̱ ná agoo mikhu. Ga̱kujmaa rí mixoo». Jamí xkuaꞌnii máꞌ nimbánuu. <verse eid="GEN 1:9" /><verse number="10" style="v" sid="GEN 1:10" />Rí mixoo, Ana̱ꞌlóꞌ nixná mbiꞌyuu «ju̱ba̱ꞌ», jamí ná niwa̱a̱ iya Ana̱ꞌlóꞌ nixná mbiꞌyuu «iya a̱pha̱». A̱ꞌkhue̱n ndiꞌyoo Ana̱ꞌlóꞌ rí máján rí neꞌne.<verse eid="GEN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 1:11" />A̱ꞌkhue̱n niꞌthán Ana̱ꞌlóꞌ: «Gaxná inuu ju̱ba̱ꞌ iná ga̱jma̱á ixe̱: iná rí naxná tsíga, jamí ixe̱ rí naxná xndúu jamí tsígoo. Mbámbá inii gáríga̱». Jamí xkuaꞌnii nimbánuu. <verse eid="GEN 1:11" /><verse number="12" style="v" sid="GEN 1:12" />Nixná inuu ju̱ba̱ꞌ mbá xúgíí inii iná ga̱jma̱á ixe̱: iná rí naxná tsíga, jamí ixe̱ rí naxná xndúu jamí tsígoo. Ndiꞌyoo Ana̱ꞌlóꞌ rí máján rí neꞌne. <verse eid="GEN 1:12" /><verse number="13" style="v" sid="GEN 1:13" />A̱ꞌkhue̱n niríga̱ mbroꞌon jamí mbiꞌi, rí mbiꞌi riatsú.<verse eid="GEN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 1:14" />A̱ꞌkhue̱n niꞌthán Ana̱ꞌlóꞌ: «Ga̱ri̱gá ná mikhu agu rí ma̱mbiꞌi-ti̱ga̱, jngó ma̱goo ma̱ꞌne wájíí-mina̱ꞌ mbiꞌi ga̱jma̱á mbroꞌon. Ikhaa jngó ma̱ꞌga-rakujmaa go̱nꞌ rí ruꞌphu, go̱nꞌ rí ruꞌwa, xúꞌkhue̱n máꞌ mbiꞌi ga̱jma̱á tsigu. <verse eid="GEN 1:14" /><verse number="15" style="v" sid="GEN 1:15" />Ga̱mbiꞌii̱n mbá xúgíí mikhu, xúꞌkhue̱n máꞌ gu̱mbiꞌi-ti̱ge̱e̱ inuu ju̱ba̱ꞌ mangaa». Jamí xkuaꞌnii máꞌ nimbánuu. <verse eid="GEN 1:15" /><verse number="16" style="v" sid="GEN 1:16" />Ana̱ꞌlóꞌ neꞌne a̱jma̱ agu mba̱ꞌo̱. Agu rí i̱wa̱á mba̱a̱ maꞌthán-ñájuun mbiꞌi. Agu rí wáa tikhu mba̱a̱ maꞌthán-ñájuun mbroꞌon. Xúꞌkhue̱n máꞌ niꞌnii̱ a̱ꞌgua̱án mangiin. <verse eid="GEN 1:16" /><verse number="17" style="v" sid="GEN 1:17" />Ana̱ꞌlóꞌ nisngujmii̱ ná mikhu rí mu̱mbiꞌi-ti̱ge̱e̱ inuu ju̱ba̱ꞌ, <verse eid="GEN 1:17" /><verse number="18" style="v" sid="GEN 1:18" />xúꞌkhue̱n máꞌ muthan-ñajuíi̱n mbiꞌi ga̱jma̱á mbroꞌon, jamí ma̱ꞌne wájíí-mina̱ꞌ agu ga̱jma̱á rí jína. Ndiꞌyoo Ana̱ꞌlóꞌ rí máján rí neꞌne. <verse eid="GEN 1:18" /><verse number="19" style="v" sid="GEN 1:19" />A̱ꞌkhue̱n niríga̱ mbroꞌon jamí mbiꞌi, rí mbiꞌi riakho̱.<verse eid="GEN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 1:20" />A̱ꞌkhue̱n niꞌthán Ana̱ꞌlóꞌ: «Ga̱mi̱diu̱ún xúgíin xu̱kú iya, jamí xúꞌkhue̱n máꞌ ga̱mi̱diu̱ún ño̱ꞌo̱n tsí magóó inuu gíñá ná mikhu a̱pha̱». <verse eid="GEN 1:20" /><verse number="21" style="v" sid="GEN 1:21" />Niꞌnii Ana̱ꞌlóꞌ xu̱kú tsí maphú mba̱ꞌu̱u̱n júwa̱ꞌ ná awúun iya a̱pha̱. Niꞌnii̱ mbámbá inii tsí na̱ba̱ñi̱i̱ꞌ ná awúun iya, xúꞌkhue̱n máꞌ niꞌnii̱ mbámbá inii xu̱kú-xna. A̱ꞌkhue̱n ndiꞌyoo Ana̱ꞌlóꞌ rí máján rí neꞌne. <verse eid="GEN 1:21" /><verse number="22" style="v" sid="GEN 1:22" />A̱ꞌkhue̱n Ana̱ꞌlóꞌ neꞌne tsakun-rámii̱ ga̱jma̱á ajngáa ríge̱ꞌ: «Ga̱mi̱dia̱ꞌlaꞌ, a̱ga̱ꞌne mbaꞌáa̱nꞌlaꞌ, a̱go̱ne̱ matíí-mi̱jna̱ ná awúun iya a̱pha̱. Xúꞌkhue̱n máꞌ ga̱mi̱diu̱ún ño̱ꞌo̱n inuu numbaa». <verse eid="GEN 1:22" /><verse number="23" style="v" sid="GEN 1:23" />A̱ꞌkhue̱n niríga̱ mbroꞌon jamí mbiꞌi, rí mbiꞌi tiwitsu.<verse eid="GEN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 1:24" />A̱ꞌkhue̱n niꞌthán Ana̱ꞌlóꞌ: «A̱ga̱mi̱diúún ná inuu ju̱ba̱ꞌ mbámbá inii xu̱kú: xu̱kú kiraꞌdiin, xu̱kú-xáná, jamí xu̱kú tsí nu̱xma̱tha-mi̱jna̱». Jamí xkuaꞌnii máꞌ nimbánuu. <verse eid="GEN 1:24" /><verse number="25" style="v" sid="GEN 1:25" />Ana̱ꞌlóꞌ niꞌnii mbámbá inii xu̱kú kiraꞌdiin, mbámbá inii xu̱kú-xáná, mbámbá inii xu̱kú tsí nu̱xma̱tha-mi̱jna̱ inuu ju̱ba̱ꞌ. A̱ꞌkhue̱n ndiꞌyoo Ana̱ꞌlóꞌ rí máján rí neꞌne. <figure style="fig" alt="Animales/humanos, paisaje" file="co00601b.TIF" size="span" loc="1.24-31" ref="1.25">Ana̱ꞌlóꞌ neꞌne ku̱mii xu̱kú gajmíí máꞌ xa̱bo̱.</figure><verse eid="GEN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 1:26" />Xúꞌkhue̱n máꞌ niꞌthán Ana̱ꞌlóꞌ: «Gu̱ꞌni̱i̱lóꞌ xa̱bo̱ rá, mbá xóo ikháánlóꞌ, jamí xóo jaꞌñáálóꞌ, ikhaa jngó muthan-ñajúu̱n i̱gi̱ꞌ tsí júwa̱ꞌ ná iya a̱pha̱, jamí ño̱ꞌo̱n tsí nagóó inuu gíñá. Xúꞌkhue̱n máꞌ muthan-ñajúu̱n xu̱kú kiraꞌdiin, xu̱kú-xáná, xúꞌkhue̱n máꞌ xúgíin xu̱kú tsí nu̱xma̱tha-mi̱jna̱ ná inuu ju̱ba̱ꞌ». <verse eid="GEN 1:26" /><verse number="27" style="v" sid="GEN 1:27" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ niꞌnii xa̱bo̱ mbá xóo ikhaa̱, xómá jaꞌnii jayuu Ana̱ꞌlóꞌ niꞌnii̱. Xa̱biya̱ jamí a̱ꞌgo̱ niꞌnii̱. <verse eid="GEN 1:27" /><verse number="28" style="v" sid="GEN 1:28" />Xúꞌkhue̱n máꞌ neꞌne tsakun-rámii̱ rí niꞌthúu̱n ajngáa ríge̱ꞌ: «Ga̱mi̱dia̱ꞌlaꞌ, a̱ga̱ꞌne mbaꞌáa̱nꞌlaꞌ, a̱go̱ne̱ matíí-mi̱jna̱laꞌ ná inuu numbaa, xúꞌkhue̱n máꞌ a̱gu̱tha̱n-ñájuíín numbaa. A̱gu̱tha̱n-ñájúún i̱gi̱ꞌ tsí júwa̱ꞌ ná iya, ño̱ꞌo̱n tsí nagóó inuu gíñá, jamí mbá xúgíin xu̱kú tsí na̱ba̱ñi̱i̱ꞌ ná inuu ju̱ba̱ꞌ».<verse eid="GEN 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 1:29" />A̱ꞌkhue̱n niꞌthán Ana̱ꞌlóꞌ: «A̱gu̱yáálaꞌ rí na̱xna̱ꞌlaꞌ mbá xúgíí iná rí naxná tsíga rí ríga̱ inuu ju̱ba̱ꞌ, xúꞌkhue̱n máꞌ ixe̱ rí naxná xndúu jamí gíꞌdoo tsígoo, rí ikhaa ne̱ mo̱pholaꞌ. <verse eid="GEN 1:29" /><verse number="30" style="v" sid="GEN 1:30" />Xómáꞌ xúgíin xu̱kú tsí júwa̱ꞌ nduya, xúgíin máꞌ xu̱kú-xáná, ño̱ꞌo̱n tsí nagóó inuu gíñá, jamí xu̱kú tsí nu̱xma̱tha-mi̱jna̱, mbá xúgíí iná rí maxa ma̱ꞌne rí mu̱phi̱i̱». Jamí xkuaꞌnii máꞌ nimbánuu.<verse eid="GEN 1:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 1:31" />A̱ꞌkhue̱n ndiꞌyoo Ana̱ꞌlóꞌ mbá xúgíí rí neꞌne ku̱maa, rí phú máján mi̱ndaꞌkho jaꞌnii ne̱. A̱ꞌkhue̱n niríga̱ mbroꞌon jamí mbiꞌi, rí mbiꞌi timajuun.<verse eid="GEN 1:31" /></para>
  <para style="b" />
  <chapter eid="GEN 1" />
  <chapter number="2" style="c" sid="GEN 2" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 2:1" />Xkuaꞌnii jaꞌnii wáxe̱ mikhu ga̱jma̱á ju̱ba̱ꞌ, jamí mbá xúgíí rí ríga̱ ná numbaa. <verse eid="GEN 2:1" /><verse number="2" style="v" sid="GEN 2:2" />Mbiꞌi tijuan, wáxu̱u̱ Ana̱ꞌlóꞌ mbá xúgíí ñajun rí neꞌne, jamí ndiyáa̱ xu̱u̱ꞌ mbiꞌi rúꞌkhue̱n. <verse eid="GEN 2:2" /><verse number="3" style="v" sid="GEN 2:3" />Ana̱ꞌlóꞌ neꞌne tsakun-rámuu mbiꞌi tijuan, jamí neꞌne tsúꞌkhoo̱ ne̱, numuu rí mbiꞌi rúꞌkhue̱n ndiyáa̱ xu̱u̱ꞌ rí wáxu̱u̱ rí neꞌne ku̱maa̱ mbá xúgíí. <verse eid="GEN 2:3" /><verse number="4" style="v" sid="GEN 2:4" />Xúꞌkhue̱n jaꞌnii ni̱gi̱ꞌdu̱u̱n niríga̱ mikhu ga̱jma̱á ju̱ba̱ꞌ, nákhí rí ni̱gu̱ma-ku̱maa ne̱.</para>
  <para style="s" vid="GEN 2:4">Xóo nixtáa xa̱bo̱ ná mbaa ixe̱ mitsaan</para>
  <para style="p" vid="GEN 2:4">Mbiꞌi rí Ana̱ꞌlóꞌ Mikhuíí neꞌne ju̱ba̱ꞌ ga̱jma̱á mikhu, <verse eid="GEN 2:4" /><verse number="5" style="v" sid="GEN 2:5" />asndo nimbá ixe̱ xóó nda̱a̱ inuu ju̱ba̱ꞌ, ni máꞌ iná xóó tájráꞌán. Numuu rí Ana̱ꞌlóꞌ Mikhuíí xóó táꞌne rí ma̱ꞌne ruꞌwa inuu ju̱ba̱ꞌ, xúꞌkhue̱n máꞌ xóó ndawa̱a̱ xa̱bo̱ tsí mañajun inuu ne̱. <verse eid="GEN 2:5" /><verse number="6" style="v" sid="GEN 2:6" />I̱ndo̱ó máꞌ najráꞌáan iya rí nargíyu̱u̱ꞌ mbá xúgíí inuu mbaa. <verse eid="GEN 2:6" /><verse number="7" style="v" sid="GEN 2:7" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ Mikhuíí niꞌnii xa̱bo̱ ga̱jma̱á yujndo̱o̱ꞌ ju̱ba̱ꞌ, jamí nindiyuu̱ rakhóo rí nigíwe̱e̱nꞌ xe̱ꞌ rí ndaꞌya. Xkuaꞌnii neꞌne rí ninindxu̱u̱ xa̱bo̱ ndaꞌya ñajuu̱n.<verse eid="GEN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 2:8" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ Mikhuíí neꞌne mbá mbaa ná niꞌdii̱ ixe̱ mitsaan, ná mbaa Edén, ná na̱ꞌkha̱ a̱kha̱ꞌ. Ikhín nigíwa̱a̱nꞌ xa̱bo̱ tsí niꞌnii̱. <verse eid="GEN 2:8" /><verse number="9" style="v" sid="GEN 2:9" />Ana̱ꞌlóꞌ Mikhuíí neꞌne rí mba̱ꞌya mbá xúgíí inii ixe̱ rí phú mitsaan, rí naxná xndúu rí máján ndasko̱ꞌ me̱kho̱ xa̱bo̱. Ná ti̱kua̱pho̱o̱ mbaa ixe̱ mitsaan, niꞌnii̱ rí ma̱jráꞌán mbá ixe̱ rí naꞌne ma̱ju̱wá jámuu xa̱bo̱, jamí niꞌnii̱ rí ma̱jráꞌán mangaa ixe̱ rí naꞌne mone̱-nuwiin xa̱bo̱ rí máján jamí rí ra̱máján.<verse eid="GEN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 2:10" />Ná Edén máꞌ nagájnuu mbá mañuu rí nargíyu̱u̱ꞌ mbaa ixe̱ mitsaan, jamí ikhín máꞌ nawiꞌtháa akho̱ ñawúun ne̱. <verse eid="GEN 2:10" /><verse number="11" style="v" sid="GEN 2:11" />Rí timbá mbiꞌyuu Pisón. Ikhaa rúꞌkhue̱n nawa̱a̱ ri̱ga̱a ne̱ mbá xúgíí mbaa rí mbiꞌyuu Abíla̱, ná ríga̱ itsúu ajua̱nꞌ rí mo̱jmo̱ꞌ. <verse eid="GEN 2:11" /><verse number="12" style="v" sid="GEN 2:12" />Ajua̱nꞌ rí mo̱jmo̱ꞌ rí ríga̱ ná mbaa rúꞌkhue̱n rí phú máján. Jamí ikhín ríga̱ wájia rí phú máján mangaa, xúꞌkhue̱n máꞌ ríga̱ itsí tsíꞌtsún. <verse eid="GEN 2:12" /><verse number="13" style="v" sid="GEN 2:13" />Mañuu rí riajma̱ mbiꞌyuu Jión, jamí nawa̱a̱ ri̱ga̱a ne̱ mbá xúgíí mbaa rí mbiꞌyuu Kús. <verse eid="GEN 2:13" /><verse number="14" style="v" sid="GEN 2:14" />Mañuu rí riatsú mbiꞌyuu Idekél,<note caller="+" style="f"><char style="fr" closed="false">2.14 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, mañuu «Tígri̱s» mbiꞌyuu «Idekél».</char></note> rí na̱ka̱ ne̱ ná na̱ꞌkha̱ a̱kha̱ꞌ rawuun mbayuu Asíria̱. Jamí mañuu rí riakho̱ mbiꞌyuu Éufra̱te̱s.<verse eid="GEN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 2:15" />Ana̱ꞌlóꞌ Mikhuíí ni̱ka̱ jayáa xa̱bo̱ jamí nigíwa̱a̱nꞌ ná mbaa ixe̱ mitsaan ná Edén, rí mañajuii̱n jamí ma̱ña̱wu̱u̱n ne̱. <verse eid="GEN 2:15" /><verse number="16" style="v" sid="GEN 2:16" />Xómáꞌ Ana̱ꞌlóꞌ Mikhuíí nixná-ñájúu̱n xa̱bo̱: «Ma̱goo me̱ꞌtso mbá xúgíí xndúu ixe̱ mbaa mitsaan. <verse eid="GEN 2:16" /><verse number="17" style="v" sid="GEN 2:17" />I̱ndo̱ó xndúu ixe̱ rí ma̱tha̱ne̱-núwíin rí máján jamí rí ra̱máján, ma̱xéꞌtso-lá ne̱. Mbiꞌi rí me̱ꞌtso ne̱, gakon rí ma̱ja̱ñáaꞌ».<verse eid="GEN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 2:18" />A̱ꞌkhue̱n niꞌthán Ana̱ꞌlóꞌ Mikhuíí: «Ra̱máján ma̱xtáa xa̱biya̱ mbáwíi. Ma̱ni̱i̱ mbáa tsí phú jaꞌyoo rí mitambáyíi̱ gáꞌne». <verse eid="GEN 2:18" /><verse number="19" style="v" sid="GEN 2:19" />Ana̱ꞌlóꞌ Mikhuíí niꞌnii mbá xúgíin xu̱kú ga̱jma̱á ju̱ba̱ꞌ, xúꞌkhue̱n máꞌ xúgíin ño̱ꞌo̱n mangiin. A̱ꞌkhue̱n rí ni̱ꞌkha̱ jagu̱u̱n xúgíin xu̱kú inuu Adán ikhaa jngó mba̱ꞌyoo̱ xáne gáxnée̱ mbiꞌyuu mbámbáa. Rí mbiꞌyuu mbámbáa xu̱kú rí nixná Adán, ikhaa máꞌ ñajuun mbiꞌñúu̱. <verse eid="GEN 2:19" /><verse number="20" style="v" sid="GEN 2:20" />A̱ꞌkhue̱n rí Adán nixnúu mbiꞌyuu mbámbáa xu̱kú kiraꞌda jamí xu̱kú-xáná, xúꞌkhue̱n máꞌ ño̱ꞌo̱n mangiin. I̱ndo̱ó numuu rí na̱nguá nikujmaa tsí mitambáyíí Adán gáꞌne xóo rí phú jaꞌyoo.<verse eid="GEN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 2:21" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ Mikhuíí neꞌne rí mi̱gu me̱do̱ mi̱ndaꞌkho Adán. Awúun rí niꞌguii̱, a̱ꞌkhue̱n niríye̱e̱ꞌ mbá itso̱ xo̱xto̱o̱, xúꞌkhue̱n máꞌ nirugua̱a̱ ná niríye̱e̱ꞌ itso̱. <verse eid="GEN 2:21" /><verse number="22" style="v" sid="GEN 2:22" />Itso̱ xo̱xto̱o̱ xa̱biya̱ rí niríya̱ꞌ Ana̱ꞌlóꞌ Mikhuíí, ikhaa ne̱ niꞌnii̱ mbáa a̱ꞌgo̱, jamí ni̱ꞌkha̱ jayáa̱ inuu xa̱biya̱. <verse eid="GEN 2:22" /><verse number="23" style="v" sid="GEN 2:23" />A̱ꞌkhue̱n niꞌthán Adán: «Tsíge̱ꞌ tsí phú gakon rí ikhaa xuyu̱ꞌ ñajuun rá, jamí ikhaa máꞌ itsu̱ꞌ ñajuu̱n. Ma̱ꞌne mbiꞌyuu̱ “a̱ꞌgo̱”, numuu rí nigájnuu̱ ná xo̱xto̱o̱ xa̱biya̱».<note caller="+" style="f"><char style="fr" closed="false">2.23 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, ajngáa «a̱ꞌgo̱» nawán xó iwán wáa ajngáa «xa̱biya̱».</char></note><verse eid="GEN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 2:24" />Ikhaa jngó xa̱biya̱ naniñuu anu̱u̱ jamí ru̱dúu rí ma̱mba̱xúu̱ ga̱jmáa̱ a̱ꞌgui̱i̱, jamí naꞌni̱i̱ i̱mba̱wíi xa̱bo̱ ñajúu̱n.<verse eid="GEN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 2:25" />Xómáꞌ Adán ga̱jma̱á a̱ꞌgui̱i̱ ná-a̱jmi̱i̱ tsaꞌtsii̱n, xúꞌkhue̱n máꞌ tsíti̱ñúu̱.<verse eid="GEN 2:25" /></para>
  <chapter eid="GEN 2" />
  <chapter number="3" style="c" sid="GEN 3" />
  <para style="s">Xóo nijiaguun xa̱bo̱ inuu Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1" />Xómáꞌ a̱bo̱ꞌ rá, i̱tha̱n wiphii rí ma̱ꞌne nduwa xóo rí iꞌwíin xu̱kú-xáná tsí niꞌnii Ana̱ꞌlóꞌ Mikhuíí, ikhaa jngó niraxu̱u̱ a̱ꞌgo̱:</para>
  <para style="p" vid="GEN 3:1">―Á gakon rí Ana̱ꞌlóꞌ niꞌthánlaꞌ rí ma̱xópholaꞌ asndo nimbá xndúu ixe̱ mbaa mitsaan rá dxe̱ꞌ.<verse eid="GEN 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 3:2" />A̱ꞌkhue̱n rí a̱ꞌgo̱ niriꞌñuu a̱bo̱ꞌ:</para>
  <para style="p" vid="GEN 3:2">―Ma̱goo máꞌ mo̱phóxo̱ꞌ asndo náá máꞌ xndúu ixe̱. <verse eid="GEN 3:2" /><verse number="3" style="v" sid="GEN 3:3" />I̱ndo̱ó ixe̱ rí wéje̱ ná ti̱kua̱pho̱o̱ mbaa, Ana̱ꞌlóꞌ niꞌthán rí ma̱xóphóxo̱ꞌ ni ma̱xáru̱gua̱xo̱ꞌ xndúu ne̱, ra̱ꞌkhá ma̱ja̱ñáxo̱ꞌ.<verse eid="GEN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 3:4" />A̱ꞌkhue̱n rí a̱bo̱ꞌ niꞌthúun a̱ꞌgo̱:</para>
  <para style="p" vid="GEN 3:4">―Ra̱gákon rí ma̱ja̱ñálaꞌ gáꞌne ne̱. <verse eid="GEN 3:4" /><verse number="5" style="v" sid="GEN 3:5" />Ana̱ꞌlóꞌ phú ndaꞌyoo mújúun mbiꞌi rí mo̱pholaꞌ xndúu ixe̱ rúꞌkhue̱n ma̱ma̱ꞌthoo idalaꞌ, jamí ma̱nindxa̱ꞌlaꞌ asndo xóo Ana̱ꞌlóꞌ, numuu rí mo̱ne̱-núwíinlaꞌ rí máján jamí rí ra̱máján.<verse eid="GEN 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 3:6" />A̱ꞌkhue̱n a̱ꞌgo̱ niyaxu̱u̱ xndúu ixe̱ rí phú máján ndasko̱ꞌ rí mi̱khui̱i̱ ne̱, xúꞌkhue̱n máꞌ phú mitsaan jaꞌnii ne̱, jamí phú máján ma̱froꞌoo̱ gáꞌne ne̱ iꞌyoo̱. A̱ꞌkhue̱n rí niríguíi̱ xndúu ixe̱ niꞌkhui̱i̱, jamí nixnúu̱ a̱jmbaa̱ niꞌkho̱ mangaa. <verse eid="GEN 3:6" /><verse number="7" style="v" sid="GEN 3:7" />A̱ꞌkhue̱n rí ni̱ma̱ꞌthoo idúu̱n ndiyáa̱ ná-a̱jmi̱i̱ rí tsaꞌtsii̱n, ikhaa jngó nixmíi̱ inúu ixe̱ rí mbiꞌyuu ígo̱, rí muruguáa̱ xuñúu̱.<verse eid="GEN 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 3:8" />Ído̱ na̱ꞌkha̱-raxa rí wakhíí, xa̱biya̱ ga̱jma̱á a̱ꞌgui̱i̱ nidxawíín rí nawán na̱ka̱-ranújngoo Ana̱ꞌlóꞌ Mikhuíí awúun mbaa mitsaan. A̱ꞌkhue̱n rí ni̱rka̱ꞌo-mi̱jne̱e̱ inuu Ana̱ꞌlóꞌ ná awúun ixe̱ mbaa mitsaan. <verse eid="GEN 3:8" /><verse number="9" style="v" sid="GEN 3:9" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ Mikhuíí niꞌthúun xa̱biya̱:</para>
  <para style="p" vid="GEN 3:9">―Náá xtaa rá.<verse eid="GEN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 3:10" />A̱ꞌkhue̱n xa̱biya̱ niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 3:10">―Ni̱dxawuun rí nawán nguaꞌáanꞌ ná mbaa, jamí phú nimíñu̱ꞌ. Numuu rí tsaꞌtsúún, ikhaa jngó ni̱rka̱ꞌo-mina̱ꞌ.<verse eid="GEN 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 3:11" />A̱ꞌkhue̱n Ana̱ꞌlóꞌ niraxu̱u̱:</para>
  <para style="p" vid="GEN 3:11">―Tsáa niꞌtháanꞌ rí tsaꞌtsáán ján róꞌ. Á nitso xndúu ixe̱ rí ni̱tha̱a̱nꞌ rí ma̱xéꞌtso jngó.<verse eid="GEN 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 3:12" />Xómáꞌ xa̱biya̱ niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 3:12">―A̱ꞌgo̱ tsí niraxníꞌ ma̱ꞌne a̱ꞌgui̱ꞌ, ikhaa̱ nixníꞌ xndúu ixe̱, nikho.<verse eid="GEN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 3:13" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ Mikhuíí niraxu̱u̱ a̱ꞌgo̱:</para>
  <para style="p" vid="GEN 3:13">―Díne ñajuun rí nithane̱ ján róꞌ.</para>
  <para style="p" vid="GEN 3:13">Xómáꞌ a̱ꞌgo̱ niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 3:13">―Ikhaa a̱bo̱ꞌ neꞌne-nduwúún, ikhaa jngó nikho ne̱.<verse eid="GEN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14" />A̱ꞌkhue̱n Ana̱ꞌlóꞌ Mikhuíí niꞌthúun a̱bo̱ꞌ:</para>
  <para style="p" vid="GEN 3:14">―Numuu rí xáꞌnii nithane̱, kixná-maꞌáán inúú mbá xúgíin xu̱kú kiraꞌdiin, xu̱kú-xáná. Ikhaa jngó xúge̱ꞌ rá, awáanꞌ ma̱tha̱xma̱thá-mina̱ꞌ rí ma̱ngriga̱a̱ꞌ ga̱jma̱á, jamí yujnda̱ꞌ me̱ꞌtso mbá xúgíí mbiꞌi rí ma̱ra̱xtaa. <verse eid="GEN 3:14" /><verse number="15" style="v" sid="GEN 3:15" />Ma̱ne̱ rí ikháán ga̱jma̱a̱ꞌ a̱ꞌgo̱ mu̱ꞌgua-rajuwalaꞌ sia̱nꞌ, xúꞌkhue̱n máꞌ ri̱jia̱a̱ꞌ ga̱jma̱á ri̱jiu̱u̱ꞌ a̱ꞌgo̱. Xa̱bo̱ ri̱jiu̱u̱ꞌ a̱ꞌgo̱ ma̱ꞌne̱-jámbi̱yu̱u̱ꞌ idxa̱a̱ꞌ, xómáꞌ ikháán ma̱ki̱jmáá me̱ꞌtso xtuun nakhúu̱.<verse eid="GEN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 3:16" />Xómáꞌ a̱ꞌgo̱ niꞌthúu̱n:</para>
  <para style="p" vid="GEN 3:16">―Ma̱ne̱ rí phú ma̱tha̱míni̱í rí mi̱da-éda, jamí ga̱jma̱á gaꞌkho̱ ma̱tha̱ne̱ xuajiin. Ma̱ꞌne máꞌ a̱kia̱a̱nꞌ xtayáá a̱jmbiaaꞌ, xómáꞌ ikhaa̱ maꞌthán-ñájuaa̱nꞌ.<verse eid="GEN 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 3:17" />Xómáꞌ xa̱biya̱ niꞌthúu̱n:</para>
  <para style="p" vid="GEN 3:17">―Numuu rí ninimba̱a̱ꞌ rí niꞌtháanꞌ a̱ꞌgia̱a̱ꞌ, nitso xndúu ixe̱ rí ni̱tha̱a̱nꞌ ma̱xéꞌtso, ikhaa jngó xúge̱ꞌ rá, ga̱jma̱á numaaꞌ ma̱ꞌne kixná-maꞌáan ju̱ba̱ꞌ. Ma̱tha̱míni̱í, ma̱tiajun mi̱ndaꞌkho inuu ne̱ rí ma̱kujmaa rí me̱ꞌtso mbá xúgíí mbiꞌi rí ma̱ra̱xtaa. <verse eid="GEN 3:17" /><verse number="18" style="v" sid="GEN 3:18" />Xómáꞌ inuu ju̱ba̱ꞌ mba̱ꞌya tsuwan jamí rí gíꞌdoo máꞌ ríꞌná, xúꞌkhue̱n máꞌ me̱ꞌtso ya̱ꞌo̱ rí ríga̱ xanáá. <verse eid="GEN 3:18" /><verse number="19" style="v" sid="GEN 3:19" />Ga̱jma̱á iya gigaaꞌ ma̱tiajun rí ma̱tseꞌtso, asndo náá gáꞌni̱i̱ ju̱ba̱ꞌ ñajuaanꞌ. Numuu rí yujnda̱ꞌ ni̱gu̱máá ga̱jma̱á, jamí ikhaa máꞌ gáꞌni̱i̱ ñajuaanꞌ mbu̱jú.<verse eid="GEN 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 3:20" />A̱ꞌkhue̱n rí Adán niꞌthán rí Éba̱<note caller="+" style="f"><char style="fr" closed="false">3.20 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, mbiꞌyuu «Éba̱» naꞌthán-wíi̱ «rí ndaꞌya».</char></note> gáꞌne mbiꞌyuu a̱ꞌgui̱i̱, numuu rí ikhaa̱ ñajuun ru̱dúún mbá xúgíin xa̱bo̱ tsí nduya. <verse eid="GEN 3:20" /><verse number="21" style="v" sid="GEN 3:21" />Xómáꞌ Ana̱ꞌlóꞌ Mikhuíí neꞌne xtíñúu̱ ga̱jma̱á xtúún xu̱kú, rí majúwuun xa̱biya̱ ga̱jma̱á a̱ꞌgui̱i̱.<verse eid="GEN 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 3:22" />A̱ꞌkhue̱n niꞌthán Ana̱ꞌlóꞌ Mikhuíí: «Rí xúge̱ꞌ xa̱bo̱ numbaa nanindxu̱u̱ asndo xó rí ikháánlóꞌ, ndaꞌyoo̱ rí máján jamí rí ra̱máján. Jngó xúge̱ꞌ rá, ra̱máján rí maríguíi̱ mi̱khui̱i̱ mangaa xndúu ixe̱ rí naꞌne ma̱ju̱wá xa̱bo̱, xúꞌkhue̱n máꞌ ma̱xtáa̱ mbá jámuu». <figure style="fig" alt="Espada de flama, Adan/Eva salen" file="CO00610B.TIF" size="span" ref="3.24">Niríya̱a̱ꞌ Ana̱ꞌlóꞌ xa̱bo̱ ná mbaa mitsaan.</figure><verse eid="GEN 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 3:23" />A̱ꞌkhue̱n Ana̱ꞌlóꞌ Mikhuíí niríya̱a̱ꞌ xa̱bo̱ ná mbaa mitsaan ná Edén, jngó mañajuii̱n inuu ju̱ba̱ꞌ rí ni̱gu̱maa̱ ga̱jma̱á. <verse eid="GEN 3:23" /><verse number="24" style="v" sid="GEN 3:24" />Ído̱ waxkriya̱a̱ꞌ xa̱bo̱ rixa̱á, Ana̱ꞌlóꞌ nitsuájuun tsí mu̱ña̱wa̱án mbiꞌñúú kerubín, ná na̱ꞌkha̱ a̱kha̱ꞌ inuu mbaa ixe̱ mitsaan. Ikhín máꞌ nitsijii̱ mbá chíde̱ rí jayá aguu jamí natuaꞌán-mina̱ꞌ mbá xúgíí, rí marogoo jambo̱o̱ ixe̱ rí naꞌne ma̱ju̱wá jámuu xa̱bo̱.<verse eid="GEN 3:24" /></para>
  <chapter eid="GEN 3" />
  <chapter number="4" style="c" sid="GEN 4" />
  <para style="s">Rí neꞌne Kaín ga̱jma̱á Abél</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1" />A̱ꞌkhue̱n Adán niꞌgu ga̱jma̱á a̱ꞌgui̱i̱, jamí nigo̱-éda Éba̱. A̱ꞌkhue̱n ni̱gu̱maa a̱dée̱ tsí nixnúu̱ mbiꞌyuu Kaín,<note caller="+" style="f"><char style="fr" closed="false">4.1 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, mbiꞌyuu «Kaín» naꞌthán-wíi̱ «ni̱gúꞌdaa».</char></note> numuu rí niꞌthée̱n: «Ana̱ꞌlóꞌ nimbáyíꞌ rí gúꞌdaa mbáa a̱ꞌdéꞌ dxáma». <verse eid="GEN 4:1" /><verse number="2" style="v" sid="GEN 4:2" />Nda̱wa̱á ni̱gu̱maa Abél, ge̱ꞌthe̱e̱ máꞌ Kaín. Abél ninindxu̱u̱ waxtú xu̱kú mogo̱. Xómáꞌ Kaín niñajun inuu ju̱ba̱ꞌ ja.<verse eid="GEN 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 4:3" />Ni̱ga̱nú mbá mbiꞌi rí Kaín ni̱ꞌkha̱ gáxnáxi̱i̱ gamaku inuu Ana̱ꞌlóꞌ Mikhuíí. Jagui̱i̱ rí nijma̱a̱ ná inuu ju̱ba̱ꞌ ni̱ꞌkhe̱e̱. <verse eid="GEN 4:3" /><verse number="4" style="v" sid="GEN 4:4" />Xúꞌkhue̱n máꞌ Abél mangaa, ni̱ꞌkha̱ gáxnáxi̱i̱n mogo̱ tsí ginuu ni̱gu̱mii, tsí phú i̱tháan rangíin. A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ Mikhuíí ni̱ni̱gu̱u̱ꞌ jaꞌyoo Abél, xúꞌkhue̱n máꞌ tsí nixnáxi̱i̱n mangaa. <figure style="fig" alt="Abel y Cain, altares" file="CO00615b.tif" size="span" ref="4.4">Ana̱ꞌlóꞌ ni̱ni̱gu̱u̱ꞌ jaꞌñúú tsí nixnáxi̱i̱n Abél.</figure> <verse eid="GEN 4:4" /><verse number="5" style="v" sid="GEN 4:5" />I̱ndo̱ó numuu rí Kaín táni̱gu̱u̱ꞌ Ana̱ꞌlóꞌ jaꞌyoo, ni máꞌ rí nixnáxi̱i̱. Ikhaa jngó Kaín maphú nijiꞌnáa mi̱ndaꞌkho, asndo ná-khaa inuu̱.<verse eid="GEN 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 4:6" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ Mikhuíí niꞌthúun Kaín: «Náá numuu kajngó ijiꞌnáá guéño, jamí asndo ná-khaa inaaꞌ róꞌ. <verse eid="GEN 4:6" /><verse number="7" style="v" sid="GEN 4:7" />Xí nathane̱ rí máján, á ra̱ꞌkhá ma̱goo máꞌ mi̱tri̱guíín rá dxe̱ꞌ. Xí nathane̱ rí ra̱máján, gíꞌthu̱u̱n aꞌkhán rí magatuwíín. Xómáꞌ ikháán rá, jaꞌyaaꞌ rí ma̱ra̱tha̱n-ñájuíín ne̱».<verse eid="GEN 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 4:8" />A̱ꞌkhue̱n rí Kaín niꞌthúun dxíyo̱o̱: «Gu̱ꞌgua̱lóꞌ xanáá». Awúun máꞌ rí júwe̱e̱ꞌ ná xanáá, Kaín nigíꞌdu̱u̱n nixnúu Abél asndo nixíya̱a̱.<verse eid="GEN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 4:9" />Nda̱wa̱á Ana̱ꞌlóꞌ Mikhuíí niraxu̱u̱ Kaín:</para>
  <para style="p" vid="GEN 4:9">―Náá xtáa dxíya̱a̱ꞌ Abél rá.</para>
  <para style="p" vid="GEN 4:9">Xómáꞌ Kaín niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 4:9">―Tsíyo̱lo̱ꞌ jún. Á ikhúúnꞌ jaꞌyo̱ꞌ rí ma̱ña̱wu̱u̱n dxíyo̱ꞌ kajngó rá dxe̱ꞌ.<verse eid="GEN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 4:10" />Ana̱ꞌlóꞌ Mikhuíí niꞌthúu̱n:</para>
  <para style="p" vid="GEN 4:10">―Díne ñajuun rí nithane̱ rá. Iꞌdiuu dxíya̱a̱ꞌ rí ni̱ga̱díí ná inuu ju̱ba̱ꞌ, nandxaꞌwá-raꞌa inu̱ꞌ. <verse eid="GEN 4:10" /><verse number="11" style="v" sid="GEN 4:11" />Ikhaa jngó xúge̱ꞌ rá, kixná-maꞌáán ná inuu ju̱ba̱ꞌ, numuu rí ju̱ba̱ꞌ niꞌña̱a̱ iꞌdiuu dxíya̱a̱ꞌ rí nitaxídíí. <verse eid="GEN 4:11" /><verse number="12" style="v" sid="GEN 4:12" />Ído̱ gáthiajun inuu ju̱ba̱ꞌ, ná-xájma̱a̱ mújúun rí me̱ꞌtso. Ma̱nindxa̱a̱ꞌ xa̱bo̱ tsí ma̱ngroꞌoo máꞌ xúꞌkhue̱n ná inuu numbaa.<verse eid="GEN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 4:13" />A̱ꞌkhue̱n rí Kaín niꞌthúun Ana̱ꞌlóꞌ Mikhuíí:</para>
  <para style="p" vid="GEN 4:13">―Ma̱xáꞌngo̱ꞌ rí gakhe̱ guéño ma̱ne̱-numa̱a̱ꞌ aꞌkhúnꞌ. <verse eid="GEN 4:13" /><verse number="14" style="v" sid="GEN 4:14" />Xúge̱ꞌ rá, naraxko̱ꞌ ná inuu ju̱ba̱ꞌ, jamí ná-xáxóo ma̱xtáá inaaꞌ. Ma̱nindxu̱ꞌ xa̱bo̱ tsí ma̱ngroꞌoo máꞌ xúꞌkhue̱n ná inuu numbaa, jamí ma̱ꞌne rí asndo tsáa tsí maxkamúú maxíñu̱ú.<verse eid="GEN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 4:15" />Ana̱ꞌlóꞌ Mikhuíí niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 4:15">―Xí mbáa tsí maxíya̱a̱ Kaín, gakon rí mbá juan nothon ma̱ꞌne numa̱a̱ꞌ rí niꞌnii̱.</para>
  <para style="p" vid="GEN 4:15">A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ Mikhuíí nixnúu mbá tsina Kaín, ikhaa jngó ma̱xájáñuu̱ gáꞌne asndo tsáa tsí gíxkama̱a̱. <verse eid="GEN 4:15" /><verse number="16" style="v" sid="GEN 4:16" />A̱ꞌkhue̱n rí Kaín nigájnuu ná inuu Ana̱ꞌlóꞌ Mikhuíí, jamí ni̱ka̱ gáxtáa̱ ná mbaa Nód rí ꞌgí ná na̱ꞌkha̱ a̱kha̱ꞌ inuu Edén.<verse eid="GEN 4:16" /></para>
  <para style="s">Tsí xa̱bi̱i̱ Kaín</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17" />A̱ꞌkhue̱n rí Kaín niꞌgu ga̱jma̱á a̱ꞌgui̱i̱, jamí nigo̱-éda, xúꞌkhue̱n máꞌ ni̱gu̱maa mbáa a̱dée̱ tsí nixnúu̱ mbiꞌyuu Enók. Nda̱wa̱á Kaín niꞌgí mbá xuajen rí neꞌne mbiꞌyuu Enók xó rí mbiꞌyuu máꞌ a̱dée̱. <verse eid="GEN 4:17" /><verse number="18" style="v" sid="GEN 4:18" />Xómáꞌ Enók ni̱gu̱maa mbáa a̱dée tsí mbiꞌyuu Irád, jamí Irád ni̱gu̱maa mbáa a̱dée tsí mbiꞌyuu Meujaél, jamí Meujaél ni̱gu̱maa mbáa a̱dée tsí mbiꞌyuu Metusaél, jamí Metusaél ni̱gu̱maa mbáa a̱dée tsí mbiꞌyuu Lamék. <verse eid="GEN 4:18" /><verse number="19" style="v" sid="GEN 4:19" />Xómáꞌ Lamék nigu̱u̱n a̱jmi̱i̱ go̱ꞌo̱. Mbáa mbiꞌyuu Áda̱, xómáꞌ i̱mba̱a̱ mbiꞌyuu Síla̱. <verse eid="GEN 4:19" /><verse number="20" style="v" sid="GEN 4:20" />Áda̱ neꞌne xuajii̱n ni̱gu̱maa Jabál, tsí niꞌgí idxu̱u̱ rí ma̱ju̱wá xa̱bo̱ ná guꞌwá xtíin, xúꞌkhue̱n máꞌ rí mu̱xpi̱ꞌthi̱i̱n xu̱kú kiraꞌdiin. <verse eid="GEN 4:20" /><verse number="21" style="v" sid="GEN 4:21" />Tsí dxíyo̱o̱ Jabál, tsí mbiꞌyuu Jubál, tsúꞌkhue̱n niꞌgí idxu̱u̱ rí nidi̱í xa̱bo̱ ixe̱ rí gíꞌdoo nítúu jamí nindíi̱ talalí. <verse eid="GEN 4:21" /><verse number="22" style="v" sid="GEN 4:22" />Mangaa Síla̱ neꞌne xuajii̱n ni̱gu̱maa Tubal-kaín, tsí ni̱ma̱ñuu ni̱gu̱wíi mbá xúgíí inii ajua̱nꞌ rí na̱gu̱ma ga̱jma̱á brónse̱ ga̱jma̱á yéro̱. Jamí dxáguíi Tubal-kaín mbiꞌyuu Naáma̱.<verse eid="GEN 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 4:23" />Xómáꞌ Lamék, niꞌthúún gu̱ꞌwi̱i̱:</para>
  <para style="q" vid="GEN 4:23">«Áda̱ ga̱jma̱á Síla̱ gu̱dxawíínlaꞌ ajngóꞌ.</para>
  <para style="q" vid="GEN 4:23">Gu̱ꞌwi̱i̱ Lamék, gu̱ꞌgí ñaꞌwanlaꞌ rí ma̱tha̱n.</para>
  <para style="q" vid="GEN 4:23">Ma̱xíya̱a̱ mbáa xa̱biya̱ xí ma̱ꞌne ñawínꞌ,</para>
  <para style="q" vid="GEN 4:23">jamí mbáa dxáma xí maxníꞌ.<verse eid="GEN 4:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="GEN 4:24" />Xí tsí maxíya̱a̱ Kaín mbá juan nothon ma̱ꞌne numa̱a̱ꞌ ja,</para>
  <para style="q" vid="GEN 4:24">i̱wa̱á-lá tsí maxíya̱a̱ Lamék, atsú skíñú gu̱wa̱ꞌ-nítsu i̱jma̱ (77) nothon ma̱ꞌne numa̱a̱ꞌ».<verse eid="GEN 4:24" /></para>
  <para style="s">Xa̱bo̱ tsí riatsíi a̱dée Adán ga̱jma̱á Éba̱</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25" />A̱ꞌkhue̱n rí Adán niꞌgu mbu̱jú ga̱jma̱á a̱ꞌgui̱i̱, jamí a̱ꞌgui̱i̱ neꞌne xuajii̱n ni̱gu̱maa mbáa dxáma tsí nixnúu̱ mbiꞌyuu Sét,<note caller="+" style="f"><char style="fr" closed="false">4.25 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, mbiꞌyuu «Sét» naꞌthán-wíi «naxná».</char></note> numuu rí ikhaa̱ niꞌthée̱n: «Ana̱ꞌlóꞌ nixnáa̱ i̱mba̱a̱ a̱ꞌdéꞌ xtiꞌkhuu Abél, tsí nixíya̱a̱ Kaín». <verse eid="GEN 4:25" /><verse number="26" style="v" sid="GEN 4:26" />Xómáꞌ Sét mangaa ni̱gu̱maa mbáa a̱dée, jamí nixná mbiꞌyuu̱ Enós. Awúun máꞌ mbiꞌi rúꞌkhue̱n nigíꞌdi̱í xa̱bo̱ ni̱xri̱ga̱á mbiꞌyuu Ana̱ꞌlóꞌ Mikhuíí ído̱ rí nene̱-mba̱a̱.<verse eid="GEN 4:26" /></para>
  <chapter eid="GEN 4" />
  <chapter number="5" style="c" sid="GEN 5" />
  <para style="s">Xa̱bi̱i̱ Adán</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1" />Ríge̱ꞌ ñajuun i̱yi̱i̱ꞌ ná na̱ꞌkha̱ mbiꞌñúú xa̱bi̱i̱ Adán. Mbiꞌi rí neꞌne ku̱mii Ana̱ꞌlóꞌ xa̱bo̱, xómáꞌ jaꞌnii Ana̱ꞌlóꞌ xkuaꞌnii niꞌnii̱. <verse eid="GEN 5:1" /><verse number="2" style="v" sid="GEN 5:2" />Xa̱biya̱ jamí a̱ꞌgo̱ niꞌnii̱. Jamí asndo nákhí mbiꞌi rí ni̱gu̱mii̱ neꞌne tsakun-rámii̱, jamí niꞌthée̱n rí ma̱ꞌne mbiꞌñúu̱ «xa̱bo̱ numbaa».<verse eid="GEN 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 5:3" />Adán gíꞌdoo máꞌ mbá majuun skíñú gu̱wa̱ꞌ (130) tsiguu, ído̱ rí ni̱gu̱maa mbáa a̱dée̱ tsí phú xó rí ikhaa̱ jayuu jaꞌnii, jamí Sét neꞌne mbiꞌyuu̱. <verse eid="GEN 5:3" /><verse number="4" style="v" sid="GEN 5:4" />Rí ni̱gu̱maa máꞌ Sét, nda̱wa̱á a̱ꞌkhue̱n nixtáa xóó Adán i̱mba̱á migiñuu siénto̱ (800) tsigu, jamí ni̱gu̱mii xóó i̱ji̱i̱n xa̱bekha jamí go̱ꞌo̱. <verse eid="GEN 5:4" /><verse number="5" style="v" sid="GEN 5:5" />Mbá mijnagu̱wa̱ꞌ siénto̱ mbá skíñú gu̱wa̱ꞌ (930) tsigu nixtáa Adán, a̱ꞌkhue̱n rí nijáñuu̱.<verse eid="GEN 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 5:6" />Sét gíꞌdoo máꞌ witsu skíñú i̱ꞌkha̱a̱ mbá witsu (105) tsiguu, ído̱ rí ni̱gu̱maa mbáa a̱dée̱ tsí mbiꞌyuu Enós. <verse eid="GEN 5:6" /><verse number="7" style="v" sid="GEN 5:7" />Rí ni̱gu̱maa máꞌ Enós, nda̱wa̱á a̱ꞌkhue̱n Sét nixtáa xóó i̱mba̱á migiñuu siénto̱ juan (807) tsigu, jamí ni̱gu̱mii xóó i̱ji̱i̱n xa̱bekha jamí go̱ꞌo̱. <verse eid="GEN 5:7" /><verse number="8" style="v" sid="GEN 5:8" />Mbá mijnagu̱wa̱ꞌ siénto̱ gue̱jma̱ (912) tsigu nixtáa Sét, a̱ꞌkhue̱n rí nijáñuu̱.<verse eid="GEN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 5:9" />Enós gíꞌdoo máꞌ akho̱ skíñú gu̱wa̱ꞌ (90) tsiguu, ído̱ rí ni̱gu̱maa mbáa a̱dée̱ tsí mbiꞌyuu Kainán. <verse eid="GEN 5:9" /><verse number="10" style="v" sid="GEN 5:10" />Rí ni̱gu̱maa máꞌ Kainán, nda̱wa̱á a̱ꞌkhue̱n Enós nixtáa xóó i̱mba̱á migiñuu siénto̱ gu̱wa̱ꞌ-nítsu (815) tsigu, jamí ni̱gu̱mii xóó i̱ji̱i̱n xa̱bekha jamí go̱ꞌo̱. <verse eid="GEN 5:10" /><verse number="11" style="v" sid="GEN 5:11" />Mbá mijnagu̱wa̱ꞌ siénto̱ i̱mba̱á witsu (905) tsigu nixtáa Enós, a̱ꞌkhue̱n rí nijáñuu̱.<verse eid="GEN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 5:12" />Kainán gíꞌdoo máꞌ atsú skíñú gu̱wa̱ꞌ (70) tsiguu, ído̱ rí ni̱gu̱maa mbáa a̱dée̱ tsí mbiꞌyuu Maalaleél. <verse eid="GEN 5:12" /><verse number="13" style="v" sid="GEN 5:13" />Rí ni̱gu̱maa máꞌ Maalaleél, nda̱wa̱á a̱ꞌkhue̱n Kainán nixtáa xóó i̱mba̱á migiñuu siénto̱ i̱jma̱ skíñú (840) tsigu, jamí ni̱gu̱mii xóó i̱ji̱i̱n xa̱bekha jamí go̱ꞌo̱. <verse eid="GEN 5:13" /><verse number="14" style="v" sid="GEN 5:14" />Mbá mijnagu̱wa̱ꞌ siénto̱ gu̱wa̱ꞌ (910) tsigu nixtáa Kainán, a̱ꞌkhue̱n rí nijáñuu̱.<verse eid="GEN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 5:15" />Maalaleél gíꞌdoo máꞌ mbá atsú skíñú witsu (65) tsiguu, ído̱ rí ni̱gu̱maa mbáa a̱dée̱ tsí mbiꞌyuu Jaréd. <verse eid="GEN 5:15" /><verse number="16" style="v" sid="GEN 5:16" />Rí ni̱gu̱maa máꞌ Jaréd, nda̱wa̱á a̱ꞌkhue̱n Maalaleél nixtáa xóó i̱mba̱á migiñuu siénto̱ mbá skíñú gu̱wa̱ꞌ (830) tsigu, jamí ni̱gu̱mii xóó i̱ji̱i̱n xa̱bekha jamí go̱ꞌo̱. <verse eid="GEN 5:16" /><verse number="17" style="v" sid="GEN 5:17" />Mbá migiñuu siénto̱ akho̱ skíñú gu̱wa̱ꞌ-nítsu (895) tsigu nixtáa Maalaleél, a̱ꞌkhue̱n rí nijáñuu̱.<verse eid="GEN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 5:18" />Jaréd gíꞌdoo máꞌ mbá migiñuu skíñú i̱jma̱ (162) tsiguu, ído̱ rí ni̱gu̱maa mbáa a̱dée̱ tsí mbiꞌyuu Enók. <verse eid="GEN 5:18" /><verse number="19" style="v" sid="GEN 5:19" />Rí ni̱gu̱maa máꞌ Enók, nda̱wa̱á a̱ꞌkhue̱n Jaréd nixtáa xóó i̱mba̱á migiñuu siénto̱ (800) tsigu, jamí ni̱gu̱mii xóó i̱ji̱i̱n xa̱bekha jamí go̱ꞌo̱. <verse eid="GEN 5:19" /><verse number="20" style="v" sid="GEN 5:20" />Mbá mijnagu̱wa̱ꞌ siénto̱ atsú skíñú i̱jma̱ (962) tsigu nixtáa Jaréd, a̱ꞌkhue̱n rí nijáñuu̱.<verse eid="GEN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 5:21" />Enók gíꞌdoo máꞌ atsú skíñú witsu (65) tsiguu, ído̱ rí ni̱gu̱maa mbáa a̱dée̱ tsí mbiꞌyuu Matusalén. <verse eid="GEN 5:21" /><verse number="22" style="v" sid="GEN 5:22" />Rí ni̱gu̱maa máꞌ Matusalén, ni̱ka̱-raxtáa Enók xómáꞌ nandoo Ana̱ꞌlóꞌ i̱mba̱á atsú siénto̱ (300) tsigu, jamí ni̱gu̱mii xóó i̱ji̱i̱n xa̱bekha jamí go̱ꞌo̱. <verse eid="GEN 5:22" /><verse number="23" style="v" sid="GEN 5:23" />Mbá atsú siénto̱ e̱tso̱ skíñú witsu (365) tsigu nixtáa Enók. <verse eid="GEN 5:23" /><verse number="24" style="v" sid="GEN 5:24" />Enók nixtáa xómáꞌ nandoo Ana̱ꞌlóꞌ, a̱ꞌkhue̱n rí ná-tákujma̱a̱, numuu rí Ana̱ꞌlóꞌ ni̱ka̱ jayáa̱.<verse eid="GEN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 5:25" />Matusalén gíꞌdoo máꞌ mbá mijnagu̱wa̱ꞌ skíñú juan (187) tsiguu, ído̱ rí ni̱gu̱maa mbáa a̱dée̱ tsí mbiꞌyuu Lamék. <verse eid="GEN 5:25" /><verse number="26" style="v" sid="GEN 5:26" />Rí ni̱gu̱maa máꞌ Lamék, nda̱wa̱á a̱ꞌkhue̱n Matusalén nixtáa xóó i̱mba̱á juan siénto̱ i̱kho̱ skíñú i̱jma̱ (782) tsigu, jamí ni̱gu̱mii xóó i̱ji̱i̱n xa̱bekha jamí go̱ꞌo̱. <verse eid="GEN 5:26" /><verse number="27" style="v" sid="GEN 5:27" />Mbá mijnagu̱wa̱ꞌ siénto̱ atsú skíñú mijnagu̱wa̱ꞌ (969) tsigu nixtáa Matusalén, a̱ꞌkhue̱n rí nijáñuu̱.<verse eid="GEN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 5:28" />Lamék gíꞌdoo máꞌ mbá mijnagu̱wa̱ꞌ skíñú i̱jma̱ (182) tsiguu, ído̱ rí ni̱gu̱maa mbáa a̱dée̱. <verse eid="GEN 5:28" /><verse number="29" style="v" sid="GEN 5:29" />Tsúꞌkhue̱n nixnée̱ mbiꞌyuu Noé, jamí niꞌthée̱n: «Ada̱ tsíge̱ꞌ ma̱ꞌne rí mbu̱ꞌyáa̱ xa̱ꞌlóꞌ inuu xúgíí ñajun rí noꞌne̱lóꞌ, numuu rí kixná-maꞌáan ju̱ba̱ꞌ neꞌne Ana̱ꞌlóꞌ Mikhuíí». <verse eid="GEN 5:29" /><verse number="30" style="v" sid="GEN 5:30" />Rí ni̱gu̱maa máꞌ Noé, nda̱wa̱á a̱ꞌkhue̱n Lamék nixtáa xóó i̱mba̱á witsu siénto̱ akho̱ skíñú gu̱wa̱ꞌ-nítsu (595) tsigu, jamí ni̱gu̱mii xóó i̱ji̱i̱n xa̱bekha jamí go̱ꞌo̱. <verse eid="GEN 5:30" /><verse number="31" style="v" sid="GEN 5:31" />Mbá juan siénto̱ atsú skíñú gu̱wa̱ꞌ-nítsu i̱jma̱ (777) tsigu nixtáa Lamék, a̱ꞌkhue̱n rí nijáñuu̱.<verse eid="GEN 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 5:32" />Noé gíꞌdoo máꞌ mbá witsu siénto̱ (500) tsigu ído̱ ni̱gu̱mii i̱ji̱i̱n tsí mbiꞌñúú Sém, Kám, jamí Jafét.<verse eid="GEN 5:32" /></para>
  <chapter eid="GEN 5" />
  <chapter number="6" style="c" sid="GEN 6" />
  <para style="s">Rí ra̱máján none̱ xa̱bo̱ numbaa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1" />Ído̱ ni̱gi̱ꞌdu̱u̱n ni̱mi̱diu̱ún mi̱ndaꞌkho xa̱bo̱ ná inuu ju̱ba̱ꞌ, jamí ni̱gu̱mii i̱jíi̱n tsí go̱ꞌo̱, <verse eid="GEN 6:1" /><verse number="2" style="v" sid="GEN 6:2" />a̱ꞌkhue̱n ndiyáá i̱ji̱i̱n Ana̱ꞌlóꞌ rí phú tsiꞌíin i̱ji̱ín xa̱bo̱ numbaa. A̱ꞌkhue̱n rí majiu̱ún mbá xúgíin, niraꞌwíi̱n jamí nidii̱n tsí neꞌne a̱kuíi̱n rí ma̱ꞌne gu̱ꞌwíi̱n. <verse eid="GEN 6:2" /><verse number="3" style="v" sid="GEN 6:3" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ Mikhuíí niꞌthán: «Ma̱xáꞌngo̱o̱ jámuu a̱kui̱nꞌ góne̱ xa̱bo̱ numbaa, numuu rí xuwi ñajúu̱n. Ikhaa jngó ma̱ꞌne rí i̱ndo̱ó majuun skíñú (120) tsigu rí ma̱ju̱wá xa̱bo̱».<verse eid="GEN 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 6:4" />Mbiꞌi máꞌ rúꞌkhue̱n, xúꞌkhue̱n máꞌ nda̱wa̱á mangaa, nijúwa̱ꞌ xa̱bo̱ tsí mba̱ꞌu̱u̱n ná inuu ju̱ba̱ꞌ, numuu rí nimbáxu̱ún xa̱bi̱i̱ Ana̱ꞌlóꞌ gajmíí go̱ꞌo̱ tsí i̱ji̱ín xa̱bo̱, a̱ꞌkhue̱n ni̱gu̱mii i̱jíi̱n. Tsíge̱ꞌ tsí phú gakhe̱ a̱kui̱ín, jamí tsí phú ni̱gi̱ꞌdoo numúú ñajúu̱n asndo nákhí wajiúú mbiꞌi.<verse eid="GEN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 6:5" />Ndiꞌyoo Ana̱ꞌlóꞌ Mikhuíí rí phú mba̱a̱ rí ra̱máján rí none̱ xa̱bo̱ ná inuu numbaa, jamí mbá xúgíí rí nu̱ndxa̱ꞌwa̱-mi̱jne̱e̱, jámba̱ miꞌtsún rí ra̱máján ñajuun ne̱. <verse eid="GEN 6:5" /><verse number="6" style="v" sid="GEN 6:6" />Maphú natanga̱a̱ a̱kui̱i̱n Ana̱ꞌlóꞌ Mikhuíí rí neꞌne-ku̱mii̱ xa̱bo̱ ná inuu numbaa, xúꞌkhue̱n máꞌ rí phú nadaa a̱kui̱i̱n. <verse eid="GEN 6:6" /><verse number="7" style="v" sid="GEN 6:7" />Ikhaa jngó niꞌthán Ana̱ꞌlóꞌ Mikhuíí: «Ma̱rngudii̱nꞌ-ri̱gi̱i̱n ná inuu ju̱ba̱ꞌ xa̱bo̱ tsí ne̱ne̱-ku̱mii, jamí mangiin xúgíin xu̱kú, asndo tsí nu̱xma̱tha-mi̱jna̱ jamí ño̱ꞌo̱n. Numuu rí phú natanga̱a̱ a̱kui̱nꞌ rí ne̱ne̱-ku̱mii̱lo̱ꞌ». <verse eid="GEN 6:7" /><verse number="8" style="v" sid="GEN 6:8" />Xómáꞌ Noé ja rá, neꞌne a̱kui̱i̱n Ana̱ꞌlóꞌ Mikhuíí jaꞌyoo.<verse eid="GEN 6:8" /></para>
  <para style="s">Noé naꞌne guꞌwá rguwa mba̱a̱</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9" />Ríge̱ꞌ naꞌthán xóo nixtáa Noé gajmíí xa̱bi̱i̱. Noé ñajuun mbáa xa̱bo̱ gamakuii jamí májáan ná majiu̱ún a̱ngui̱i̱n. Xúꞌkhue̱n máꞌ nixtáa̱ xómáꞌ nandoo Ana̱ꞌlóꞌ. <verse eid="GEN 6:9" /><verse number="10" style="v" sid="GEN 6:10" />Ni̱gu̱mii mbá atsúun i̱ji̱i̱n Noé: Sém, Kám, jamí Jafét.<verse eid="GEN 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 6:11" />Ndiꞌyoo Ana̱ꞌlóꞌ rí nichú-ri̱ga̱ mbá jayuu inuu ju̱ba̱ꞌ, xúꞌkhue̱n máꞌ gatíí rí xkujndu. <verse eid="GEN 6:11" /><verse number="12" style="v" sid="GEN 6:12" />Niyaxu̱u̱ Ana̱ꞌlóꞌ ná inuu ju̱ba̱ꞌ, ndiꞌyoo̱ rí gajni̱í mi̱ndaꞌkho rí ra̱máján, numuu rí nikhíi xóo júwa̱ꞌ mbá xúgíin xa̱bo̱ ná tsu̱du̱u̱ numbaa. <verse eid="GEN 6:12" /><verse number="13" style="v" sid="GEN 6:13" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ niꞌthúun Noé: «Ni̱ꞌgí-mina̱ꞌ rí ma̱ne̱ gámbi̱i̱n xúgíin xa̱bo̱, numuu rí gajni̱í ná inuu ju̱ba̱ꞌ rí xkujndu ga̱jma̱á numúu̱ ikhii̱n. Jamí xúge̱ꞌ rá, ma̱ne̱ gámbi̱i̱n ikhii̱n xúꞌkhue̱n máꞌ ju̱ba̱ꞌ mangaa. <verse eid="GEN 6:13" /><verse number="14" style="v" sid="GEN 6:14" />Athane̱ mbá guꞌwá rguwa ixe̱ gofér rí ma̱rada̱ꞌ, jamí xúꞌkhue̱n ma̱tha̱ne̱ xtóo ne̱ ná awúún, jamí ma̱ta̱xta̱jma̱á wájia awúun jamí tsu̱du̱u̱ ne̱. <verse eid="GEN 6:14" /><verse number="15" style="v" sid="GEN 6:15" />Xáꞌnii jaꞌnii khiáwan ne̱ ma̱tha̱ne̱: rí ꞌmba̱ꞌ ma̱ꞌne mbá atsú siénto̱ (300) iduu itso̱ rí na̱gia̱wan ñawúun xa̱bo̱,<note caller="+" style="f"><char style="fr" closed="false">6.15 </char><char style="ft" closed="false">Rí 300 iduu itso̱ naꞌne mbá 140 wáa métro̱.</char></note> rí ma̱jia̱nꞌ ma̱ꞌne a̱jma̱ skíñú gu̱wa̱ꞌ (50) iduu itso̱,<note caller="+" style="f"><char style="fr" closed="false">6.15 </char><char style="ft" closed="false">Rí 50 iduu itso̱ naꞌne mbá 23 wáa métro̱.</char></note> jamí rí tsída̱ꞌ ma̱ꞌne mbá skíñú gu̱wa̱ꞌ (30) iduu itso̱.<note caller="+" style="f"><char style="fr" closed="false">6.15 </char><char style="ft" closed="false">Rí 30 iduu itso̱ naꞌne mbá 14 wáa métro̱.</char></note> <verse eid="GEN 6:15" /><verse number="16" style="v" sid="GEN 6:16" />Ná mijngi dámba̱wóo rí ri̱jma̱á, ma̱ta̱tsi̱ꞌñáá mbá iduu rguwa ja̱ma̱ꞌtha mbá iduu itso̱. Xúꞌkhue̱n máꞌ ma̱ta̱gíꞌma mbá xkrugua ná níjiúu rguwa. Athane̱ mbá atsú xtóo ne̱ rí ka̱jngro̱xe̱ ná awúun ne̱. <verse eid="GEN 6:16" /><verse number="17" style="v" sid="GEN 6:17" />Numuu rí ikhúúnꞌ ma̱xu̱ꞌmá rí ma̱ꞌne ruꞌwa a̱pha̱ ná inuu numbaa, rí ma̱ne̱ gámbi̱i̱n mbá xúgíin tsí kuaꞌdáá xe̱ꞌ rí ndaꞌya ná agoo mikhu. Mbá xúgíí rí ríga̱ ná inuu ju̱ba̱ꞌ ma̱mbáa̱. <verse eid="GEN 6:17" /><verse number="18" style="v" sid="GEN 6:18" />I̱ndo̱ó ikháán na̱xu̱ꞌdá-mina̱ꞌ mbá awan ga̱jma̱á nindxa̱a̱ꞌ, rí ma̱ta̱ꞌa̱a̱ꞌ ná awúun rguwa ikháán, gajmiáaꞌ i̱jia̱a̱nꞌ, a̱ꞌgia̱a̱ꞌ jamí gu̱ꞌgiáanꞌ. <verse eid="GEN 6:18" /><verse number="19" style="v" sid="GEN 6:19" />Jamí mbá xúgíin xu̱kú tsí nduya júwa̱ꞌ, ma̱ta̱xu̱ꞌdíi̱n ná awúun rguwa, a̱jmi̱i̱ jamí a̱jmi̱i̱ mbámbá inii, a̱jmba jamí iꞌgú gáꞌne. A̱ꞌkhue̱n rí ma̱goo ma̱jáwíi̱n ga̱jma̱á nindxa̱a̱ꞌ. <verse eid="GEN 6:19" /><verse number="20" style="v" sid="GEN 6:20" />Ma̱tu̱ꞌúún ga̱jma̱á nindxa̱a̱ꞌ mbámbá inii xu̱kú-xna, xu̱kú kiraꞌda mbámbá inii máꞌ mangaa, jamí mbámbá inii tsí nu̱xma̱tha-mi̱jna̱. A̱jmi̱i̱ jamí a̱jmi̱i̱ rí mbámbá inii gáꞌne, jngó ma̱goo ma̱jáwíi̱n. <verse eid="GEN 6:20" /><verse number="21" style="v" sid="GEN 6:21" />Xúꞌkhue̱n máꞌ araxi̱i̱ mbá xúgíí inii ganitsu, jamí athane̱ matíí ne̱, numuu rí ikhaa ne̱ mambáyáaꞌ, xúꞌkhue̱n máꞌ mangiin xu̱kú».<verse eid="GEN 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 6:22" />Mbá xkuaꞌnii neꞌne Noé, rí neꞌne-mbánuu̱ mbá xúgíí rí waꞌtháa̱n neꞌne Ana̱ꞌlóꞌ.<verse eid="GEN 6:22" /></para>
  <chapter eid="GEN 6" />
  <chapter number="7" style="c" sid="GEN 7" />
  <para style="s">Naꞌne ruꞌwa a̱pha̱</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ Mikhuíí niꞌthúun Noé: «A̱ta̱ꞌa̱a̱ꞌ ná awúun guꞌwá rguwa ikháán jamí mbá xúgíin xa̱bia̱a̱ꞌ, numuu rí i̱ndo̱ó ikháán nda̱yo̱o̱ rí gamakuíín xóo rí iꞌwíin xa̱bo̱. <verse eid="GEN 7:1" /><verse number="2" style="v" sid="GEN 7:2" />Rí mbá xúgíin xu̱kú tsí khaꞌuun, juiin jmba̱ꞌo̱ jamí juiin iꞌgú ma̱tha̱xu̱ꞌdíin, xúꞌkhue̱n máꞌ xu̱kú tsí ra̱kháꞌuun, a̱jmi̱i̱ mbámbá inii, a̱jmba jamí iꞌgú. <verse eid="GEN 7:2" /><verse number="3" style="v" sid="GEN 7:3" />Ma̱tha̱xu̱ꞌdíin mangiin ño̱ꞌo̱n, juiin jmba̱ꞌo̱ jamí juiin iꞌgú, ikhaa jngó ma̱gi̱xi̱i̱n rí ma̱ju̱wée̱ꞌ xóó inuu ju̱ba̱ꞌ. <verse eid="GEN 7:3" /><verse number="4" style="v" sid="GEN 7:4" />Numuu rí ído̱ ma̱ga̱nú juan mbiꞌi, ikhúúnꞌ ma̱ne̱ rí maxnúu ruꞌwa ná inuu ju̱ba̱ꞌ. A̱jma̱ skíñú mbiꞌi jamí mbroꞌon maxnúu ne̱. A̱ꞌkhue̱n rí ma̱rngudii̱nꞌ-ri̱gi̱i̱n ná inuu numbaa xúgíin tsí júwa̱ꞌ nduya ne̱ne̱-ku̱mii». <verse eid="GEN 7:4" /><verse number="5" style="v" sid="GEN 7:5" />Xómáꞌ Noé neꞌne-mbánuu mbá xúgíí rí ni̱gi̱ꞌmaa̱ ma̱ꞌnii̱ xóo rí waꞌtháa̱n neꞌne Ana̱ꞌlóꞌ Mikhuíí.<verse eid="GEN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 7:6" />Noé gíꞌdoo máꞌ majuun siénto̱ (600) tsiguu ído̱ rí nixnúu ruꞌwa a̱pha̱ ná inuu ju̱ba̱ꞌ. <verse eid="GEN 7:6" /><verse number="7" style="v" sid="GEN 7:7" />Ga̱jma̱á numuu ruꞌwa a̱pha̱, ni̱to̱ꞌo̱o̱ Noé ná awúun guꞌwá rguwa gajmíi̱ i̱ji̱i̱n, a̱ꞌgui̱i̱ jamí gu̱ꞌgíi̱n. <verse eid="GEN 7:7" /><verse number="8" style="v" sid="GEN 7:8" />Xkuaꞌnii máꞌ xu̱kú tsí khaꞌuun, xu̱kú tsí ra̱kháꞌuun, xúꞌkhue̱n máꞌ ño̱ꞌo̱n, jamí xúgíin tsí nu̱xma̱tha-mi̱jna̱ ná inuu ju̱ba̱ꞌ, <verse eid="GEN 7:8" /><verse number="9" style="v" sid="GEN 7:9" />a̱jmi̱i̱ jamí a̱jmi̱i̱ ni̱tu̱ꞌúu̱n gajmíi̱ Noé ná awúun rguwa, a̱jmba jamí iꞌgú, mbá xó rí ni̱gi̱ꞌmaa̱ rí ma̱ꞌne-mbánuu̱ neꞌne Ana̱ꞌlóꞌ. <verse eid="GEN 7:9" /><verse number="10" style="v" sid="GEN 7:10" />Ído̱ ni̱ga̱nú mbiꞌi tijuan, a̱ꞌkhue̱n rí ni̱gi̱ꞌdu̱u̱n ni̱ꞌkha̱ ruꞌwa a̱pha̱ ná inuu ju̱ba̱ꞌ.<verse eid="GEN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 7:11" />Nákhí timbá majuun siénto̱ (600) tsiguu Noé, go̱nꞌ rí riajmu̱u̱, rí mbiꞌi gu̱wa̱ꞌ-nítsu i̱ka̱ ñajuun go̱nꞌ, ni̱gi̱ꞌdu̱u̱n ni̱ma̱ꞌthoo iduu iya mba̱ꞌo̱ ná rí phú me̱jno̱ꞌ iya a̱pha̱. Xúꞌkhue̱n máꞌ ni̱ma̱ꞌthoo xúgíí xtangaya ná mikhu. <verse eid="GEN 7:11" /><verse number="12" style="v" sid="GEN 7:12" />A̱ꞌkhue̱n rí a̱jma̱ skíñú mbiꞌi jamí a̱jma̱ skíñú mbroꞌon nixnúu ruꞌwa ná inuu ju̱ba̱ꞌ. <verse eid="GEN 7:12" /><verse number="13" style="v" sid="GEN 7:13" />Ikhaa máꞌ mbiꞌi rúꞌkhue̱n ni̱to̱ꞌo̱o̱ Noé ná rguwa, gajmíi̱ Sém, Kám jamí Jafét tsí i̱ji̱i̱n máꞌ, ga̱jmáa̱ a̱ꞌgui̱i̱ jamí xúꞌkhue̱n máꞌ mbá ná atsúun gu̱ꞌgíi̱n. <verse eid="GEN 7:13" /><verse number="14" style="v" sid="GEN 7:14" />Mbóó máꞌ ni̱tu̱ꞌúu̱n ikhii̱n gajmíi̱ mbá xúgíí inii xu̱kú-xáná jamí xu̱kú kiraꞌda, mbá xúgíí inii xu̱kú tsí nu̱xma̱tha-mi̱jna̱ ná inuu ju̱ba̱ꞌ, xúꞌkhue̱n máꞌ mbá xúgíí inii xu̱kú-xna jamí ño̱ꞌo̱n. <verse eid="GEN 7:14" /><verse number="15" style="v" sid="GEN 7:15" />Xkuaꞌnii jaꞌnii ni̱tu̱ꞌúu̱n ná rguwa gajmíi̱ Noé, a̱jmi̱i̱ jamí a̱jmi̱i̱ mbá xúgíin xu̱kú tsí kuaꞌdáá xe̱ꞌ rí ndaꞌya. <verse eid="GEN 7:15" /><verse number="16" style="v" sid="GEN 7:16" />Jamí mbá xúgíin xu̱kú tsí niguwá, jmba̱ꞌo̱ jamí iꞌgú niguwá, mbá xóo rí waꞌxná-ñájuíín Noé neꞌne Ana̱ꞌlóꞌ. A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ Mikhuíí nirugua̱a̱ xkrugua.<verse eid="GEN 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 7:17" />A̱ꞌkhue̱n rí nixnúu ruꞌwa a̱pha̱ ná inuu ju̱ba̱ꞌ a̱jma̱ skíñú mbiꞌi. Ído̱ nijudáán-mina̱ꞌ iya, a̱ꞌkhue̱n rí ni̱tu̱xu̱u̱ jiꞌyá rguwa. <verse eid="GEN 7:17" /><verse number="18" style="v" sid="GEN 7:18" />Xómáꞌ iya na̱ka̱-rajni̱í guéño jamí najudáán-mina̱ꞌ ne̱ ná inuu ju̱ba̱ꞌ, xúꞌkhue̱n máꞌ rguwa ni̱tu̱xu̱u̱ ngrámuu ná inuu iya. <verse eid="GEN 7:18" /><verse number="19" style="v" sid="GEN 7:19" />Nijudáán-mina̱ꞌ mi̱ndaꞌkho iya ná inuu ju̱ba̱ꞌ, jamí mbá xúgíí júba̱ rí tsída̱ꞌ rí ríga̱ ná inuu numbaa nimbrámuu mbá jayu iya. <figure style="fig" alt="Personas en agua, el arca" file="GR-gn07n.tif" size="span" loc="7.15-23" ref="7.19">Nixnúu ruꞌwa ná inuu ju̱ba̱ꞌ a̱jma̱ skíñú mbiꞌi jamí a̱jma̱ skíñú mbroꞌon.</figure> <verse eid="GEN 7:19" /><verse number="20" style="v" sid="GEN 7:20" />Rí nimbrámuu máꞌ iya inuu júba̱, xóó nitsimuu ne̱ i̱mba̱á gu̱wa̱ꞌ-nítsu (15) iduu itso̱.<note caller="+" style="f"><char style="fr" closed="false">7.20 </char><char style="ft" closed="false">Rí 15 iduu itso̱ gíꞌdoo mbá 7 wáa métro̱.</char></note> <verse eid="GEN 7:20" /><verse number="21" style="v" sid="GEN 7:21" />Xkuaꞌnii nijáñúú xúgíin tsí na̱ba̱ñi̱i̱ꞌ júwa̱ꞌ ná inuu ju̱ba̱ꞌ: ño̱ꞌo̱n, xu̱kú-xáná jamí xu̱kú kiraꞌda, xúgíin tsí nu̱xma̱tha-mi̱jna̱ ná inuu ju̱ba̱ꞌ, jamí mbá xúgíin xa̱bo̱. <verse eid="GEN 7:21" /><verse number="22" style="v" sid="GEN 7:22" />Nijáñúú mbá xúgíin tsí nu̱xu̱máá xe̱ꞌ, mbá xúgíin tsí júwa̱ꞌ ná inuu ju̱ba̱ꞌ wámbi̱i̱n. <verse eid="GEN 7:22" /><verse number="23" style="v" sid="GEN 7:23" />Xúꞌkhue̱n jaꞌnii wámba̱-ri̱gi̱i̱n xúgíin tsí nijúwa̱ꞌ ná inuu ju̱ba̱ꞌ, asndo xa̱bo̱ jamí xu̱kú kiraꞌda, xúꞌkhue̱n máꞌ tsí nu̱xma̱tha-mi̱jna̱, jamí ño̱ꞌo̱n. Xkuaꞌnii wámba̱-ri̱gi̱i̱n ná inuu ju̱ba̱ꞌ. I̱mba̱wíi Noé niwanúu, gajmíí tsí gatiin ná rguwa. <verse eid="GEN 7:23" /><verse number="24" style="v" sid="GEN 7:24" />Mbá juan skíñú gu̱wa̱ꞌ (150) mbiꞌi nijni̱í iya ná inuu numbaa.<verse eid="GEN 7:24" /></para>
  <chapter eid="GEN 7" />
  <chapter number="8" style="c" sid="GEN 8" />
  <para style="s">Xóo ni̱ka̱-ragu̱uꞌ iya neꞌne Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1" />A̱ꞌkhue̱n rí ni̱rmáꞌáa̱n a̱kui̱i̱n Ana̱ꞌlóꞌ jaꞌyoo Noé, gajmíí xúgíin xu̱kú-xáná jamí xu̱kú kiraꞌdiin tsí kachúún ná rguwa. Ana̱ꞌlóꞌ neꞌne rí maxnúu gíñá ná inuu numbaa, jamí a̱ꞌkhue̱n ni̱ka̱-ragu̱uꞌ iya. <verse eid="GEN 8:1" /><verse number="2" style="v" sid="GEN 8:2" />A̱ꞌkhue̱n nijúgua̱a̱ iduu iya mba̱ꞌo̱ ná iya a̱pha̱, xúꞌkhue̱n máꞌ xúgíí xtangaya ná mikhu mangaa. Xkuaꞌnii ni̱we̱je̱ rí naxnúu ruꞌwa. <verse eid="GEN 8:2" /><verse number="3" style="v" sid="GEN 8:3" />Mañuu máꞌ xúꞌkhue̱n, ni̱ka̱-ragu̱uꞌ iya ná inuu ju̱ba̱ꞌ. Ído̱ neꞌne mbá juan skíñú gu̱wa̱ꞌ (150) mbiꞌi nigu̱uꞌ máꞌ iya. <verse eid="GEN 8:3" /><verse number="4" style="v" sid="GEN 8:4" />Rí mbiꞌi gu̱wa̱ꞌ-nítsu i̱jma̱ (17), rí go̱nꞌ tijuan, ni̱tri̱ga̱a̱ rguwa ná júba̱ rí wájun ná mbaa Ararát. <verse eid="GEN 8:4" /><verse number="5" style="v" sid="GEN 8:5" />Jamí xúꞌkhue̱n ni̱ka̱-ragu̱uꞌ iya asndo mbiꞌi timbá i̱ka̱ ñajuun go̱nꞌ rí ti̱gu̱wa̱ꞌ. A̱ꞌkhue̱n ni̱ka̱-rakujma̱a̱ inuu júba̱.<verse eid="GEN 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 8:6" />Ninújngoo máꞌ a̱jma̱ skíñú mbiꞌi, a̱ꞌkhue̱n nirmáꞌtha̱a̱ Noé iduu rguwa rí neꞌne-mújúu̱n. <verse eid="GEN 8:6" /><verse number="7" style="v" sid="GEN 8:7" />A̱ꞌkhue̱n nixuꞌmaa̱ mbáa yu̱wa̱ꞌ, tsí nigájnuu ningrigo̱o̱ máꞌ xúꞌkhue̱n asndo náá nijndo̱o̱ꞌ iya inuu ju̱ba̱ꞌ. <verse eid="GEN 8:7" /><verse number="8" style="v" sid="GEN 8:8" />Mangaa nixuꞌmaa̱ mbáa rigu, jngó mba̱ꞌyoo̱ xí nigu̱uꞌ iya ná inuu ju̱ba̱ꞌ. <verse eid="GEN 8:8" /><verse number="9" style="v" sid="GEN 8:9" />Jamí na̱nguá nixkamaa̱ ná ma̱ri̱guii̱, jngó nitanga̱a̱ ná rguwa, numuu rí iya xóó ri̱ga̱ mbá xúgíí inuu ju̱ba̱ꞌ. A̱ꞌkhue̱n Noé nitsriya̱ꞌ ñawúun rí ni̱grui̱guíi̱ rigu, ni̱ta̱ꞌa̱a̱ ná rguwa. <verse eid="GEN 8:9" /><verse number="10" style="v" sid="GEN 8:10" />Ni̱gi̱ꞌthu̱u̱n i̱mba̱á juan mbiꞌi, jamí a̱ꞌkhue̱n nixuꞌmaa̱ mbu̱jú rigu, nigájnuu ná rguwa ni̱ka̱. <verse eid="GEN 8:10" /><verse number="11" style="v" sid="GEN 8:11" />Xómáꞌ rigu nitanga̱a̱ inuu̱ wakhíí, jayée̱ mbá inúu ixe̱ olíbo̱ ná rawuu̱n. A̱ꞌkhue̱n nifroꞌo̱o̱ Noé rí nigu̱uꞌ máꞌ iya ná inuu ju̱ba̱ꞌ. <figure style="fig" alt="Noé con paloma" file="CO00633B.TIF" size="col" ref="8.11">Nitanga̱a̱ rigu inuu Noé.</figure> <verse eid="GEN 8:11" /><verse number="12" style="v" sid="GEN 8:12" />Ni̱gi̱ꞌthu̱u̱n i̱mba̱á juan mbiꞌi xóó, níkhú nixuꞌmaa̱ rigu ni̱ka̱, a̱ꞌkhue̱n rí nánguá máꞌ nitanga̱a̱.<verse eid="GEN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 8:13" />Ído̱ nirámuu majuun siénto̱ i̱mba̱ (601) tsiguu Noé, rí go̱nꞌ timbá, rí mbiꞌi timbá ñajuun go̱nꞌ, a̱ꞌkhue̱n nijndo̱o̱ꞌ-maꞌáa̱n máꞌ iya inuu ju̱ba̱ꞌ. A̱ꞌkhue̱n nirígúu̱ Noé rí jógoo ná tsu̱du̱u̱ rguwa, jamí ndiꞌyoo̱ rí nijndo̱o̱ꞌ inuu ju̱ba̱ꞌ. <verse eid="GEN 8:13" /><verse number="14" style="v" sid="GEN 8:14" />Jamí mbá skíñú juan mbiꞌi i̱ka̱ ñajuun go̱nꞌ rí riajmu̱u̱, a̱ꞌkhue̱n rí phú nijndo̱o̱ꞌ mbá jayu ju̱ba̱ꞌ rá. <verse eid="GEN 8:14" /><verse number="15" style="v" sid="GEN 8:15" />A̱ꞌkhue̱n Ana̱ꞌlóꞌ niꞌthúun Noé: <verse eid="GEN 8:15" /><verse number="16" style="v" sid="GEN 8:16" />«Adxájna̱a̱ꞌ ná awúun rguwa ikháán ga̱jma̱a̱ꞌ a̱ꞌgia̱a̱ꞌ, i̱jia̱a̱nꞌ jamí gu̱ꞌwi̱ín i̱jia̱a̱nꞌ. <verse eid="GEN 8:16" /><verse number="17" style="v" sid="GEN 8:17" />Arawíi̱n xúgíin xu̱kú tsí gatiin ga̱jma̱á nindxa̱a̱ꞌ: xúgíin ño̱ꞌo̱n jamí xu̱kú kiraꞌda jamí mbá xúgíin tsí nu̱xma̱tha-mi̱jna̱ ná inuu ju̱ba̱ꞌ. Agóo̱ mbá xúgíí inuu ju̱ba̱ꞌ, jamí a̱ga̱mi̱diúu̱n ná inuu numbaa».<verse eid="GEN 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 8:18" />A̱ꞌkhue̱n nigájna̱a̱ Noé gajmíí i̱ji̱i̱n, a̱ꞌgui̱i̱, jamí gu̱ꞌwi̱ín i̱ji̱i̱n. <verse eid="GEN 8:18" /><verse number="19" style="v" sid="GEN 8:19" />Jamí a̱ꞌkhue̱n nigájna̱á ná awúun rguwa mbá xúgíin xu̱kú, xúgíin tsí nu̱xma̱tha-mi̱jna̱ jamí xúgíin ño̱ꞌo̱n, jamí xúgíin tsí na̱ba̱ñi̱i̱ꞌ ná inuu ju̱ba̱ꞌ, xómáꞌ mbámbá inii xu̱kú. <verse eid="GEN 8:19" /><verse number="20" style="v" sid="GEN 8:20" />A̱ꞌkhue̱n rí Noé nixúxe̱ xu̱nꞌ itsí ná ma̱ꞌne-mba̱a̱ Ana̱ꞌlóꞌ Mikhuíí. A̱ꞌkhue̱n ndiyáa̱ mbáa xu̱kú tsí mbámbá inúú tsí khaꞌuun xúꞌkhue̱n máꞌ ño̱ꞌo̱n tsí khaꞌuun, nixnáxi̱i̱n mi̱khiin ikhín. <verse eid="GEN 8:20" /><verse number="21" style="v" sid="GEN 8:21" />Ído̱ ni̱grui̱gú xe̱ꞌ Ana̱ꞌlóꞌ Mikhuíí rí phú ndaa thawuun, a̱ꞌkhue̱n niꞌthán-mine̱e̱ꞌ: «Maske máꞌ asndo nákhí rí natse a̱kui̱ín xa̱bo̱, wéje̱ máꞌ rí muni̱i̱ rí ra̱máján, ná-xátangu̱ún ma̱xna̱-máꞌáan ju̱ba̱ꞌ ga̱jma̱á numúú xa̱bo̱ rá. Jamí ni̱mi̱ꞌtsu̱n ná-xáne̱ gámbi̱i̱n xúgíin tsí nduya, xó rí ne̱ne̱ xúge̱ꞌ.<verse eid="GEN 8:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="GEN 8:22" />»Awúun máꞌ rí xóó kri̱ga̱ ju̱ba̱ꞌ,</para>
  <para style="q" vid="GEN 8:22">ma̱xámba̱ rí mi̱ꞌdu jamí rí ma̱gi̱xi̱i̱ ganitsu,</para>
  <para style="q" vid="GEN 8:22">ma̱ꞌne mika jamí ngúwán,</para>
  <para style="q" vid="GEN 8:22">ma̱ꞌkha̱ go̱nꞌ rí ma̱ꞌne ruꞌwa jamí go̱nꞌ rí ma̱ꞌne ruꞌphu,</para>
  <para style="q" vid="GEN 8:22">jamí ma̱ꞌne máꞌ mbiꞌi jamí mbroꞌon».<verse eid="GEN 8:22" /></para>
  <chapter eid="GEN 8" />
  <chapter number="9" style="c" sid="GEN 9" />
  <para style="s">Awan rí na̱ge̱ꞌdoo Ana̱ꞌlóꞌ ga̱jma̱á Noé</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1" />Ana̱ꞌlóꞌ neꞌne tsakun-rámaa Noé gajmíí i̱ji̱i̱n, jamí niꞌthúu̱n: «Ga̱mi̱dia̱ꞌlaꞌ, a̱ga̱ꞌne mbaꞌáa̱nꞌlaꞌ jamí a̱go̱ne̱ matíí-mi̱jna̱laꞌ ná inuu ju̱ba̱ꞌ. <verse eid="GEN 9:1" /><verse number="2" style="v" sid="GEN 9:2" />Mbá xúgíin xu̱kú tsí júwa̱ꞌ ná inuu ju̱ba̱ꞌ ma̱mi̱ꞌñúú jamí mbuya-makualaꞌ: xúgíin ño̱ꞌo̱n, xúgíin tsí na̱ba̱ñi̱i̱ꞌ inuu ju̱ba̱ꞌ, jamí i̱gi̱ꞌ ná iya a̱pha̱. Mbá xúgíin tsúꞌkhue̱n na̱xna̱xíi̱nꞌlo̱ꞌ ná ñawánlaꞌ. <verse eid="GEN 9:2" /><verse number="3" style="v" sid="GEN 9:3" />Xúgíin xu̱kú tsí nduya na̱ba̱ñi̱i̱ꞌ, ma̱ꞌne ganitsalaꞌ, xúꞌkhue̱n máꞌ ya̱ꞌo̱ mangaa. Ikhúúnꞌ na̱xna̱ꞌlaꞌ mbá xúgíí rúꞌkhue̱n. <verse eid="GEN 9:3" /><verse number="4" style="v" sid="GEN 9:4" />I̱ndo̱ó máꞌ rí ma̱xópholaꞌ xuwi rí gíꞌdoo iꞌdiuu, numuu rí ikhaa ne̱ jayá rí ndaꞌya. <verse eid="GEN 9:4" /><verse number="5" style="v" sid="GEN 9:5" />Gakon ikhúúnꞌ ma̱nda̱ꞌa̱a̱lo̱ꞌ nguátha̱ rí neꞌne mbámbáa xa̱bo̱ jamí mbámbáa xu̱kú, ga̱jma̱á numuu iꞌdiuu mbiꞌyalaꞌ. Mbámbáa xa̱bo̱ ma̱nda̱ꞌa̱a̱lo̱ꞌ ga̱jma̱á numuu mbiꞌyuu dxájuu.<verse eid="GEN 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="GEN 9:6" />»Xí mbáa maxíya̱a̱ xa̱bo̱,</para>
  <para style="q" vid="GEN 9:6">ma̱ja̱ñúu̱ mangaa̱ gáꞌne i̱mba̱a̱ xa̱bo̱,</para>
  <para style="q" vid="GEN 9:6">numuu rí Ana̱ꞌlóꞌ niꞌnii xa̱bo̱</para>
  <para style="q" vid="GEN 9:6">xómáꞌ jaꞌnii̱ ikhaa̱.<verse eid="GEN 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 9:7" />»Xómáꞌ ikháa̱nꞌlaꞌ, ga̱mi̱dia̱ꞌlaꞌ, a̱ga̱ꞌne mbaꞌáa̱nꞌlaꞌ. Ga̱mi̱dia̱ꞌlaꞌ jamí a̱go̱ne̱ matíí-mi̱jna̱laꞌ ná inuu numbaa».<verse eid="GEN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8" />Xóó niꞌthán Ana̱ꞌlóꞌ, niꞌthúun Noé gajmíí i̱ji̱i̱n: <verse eid="GEN 9:8" /><verse number="9" style="v" sid="GEN 9:9" />«Ikhúúnꞌ na̱ꞌgí mbá awan ga̱jma̱á nindxa̱ꞌlaꞌ xúꞌkhue̱n máꞌ ga̱jma̱á nindxu̱ún xa̱bia̱ꞌlaꞌ tsí ma̱ju̱wá nda̱wa̱á, <verse eid="GEN 9:9" /><verse number="10" style="v" sid="GEN 9:10" />xúꞌkhue̱n máꞌ ga̱jma̱á nindxu̱ún mbá xúgíin tsí nduya júwa̱ꞌ ga̱jma̱á nindxa̱ꞌlaꞌ: ño̱ꞌo̱n, xu̱kú-xáná jamí xu̱kú kiraꞌdiin, mbá xúgíin tsí nigájna̱á ná awúun rguwa asndo xúgíin xu̱kú tsí júwa̱ꞌ ná ju̱ba̱ꞌ. <verse eid="GEN 9:10" /><verse number="11" style="v" sid="GEN 9:11" />Awan ríge̱ꞌ nagúꞌdo̱ꞌ ga̱jma̱á nindxa̱ꞌlaꞌ: ni̱mi̱ꞌtsu̱n ná-ma̱xáne̱ gámbi̱i̱n xa̱bo̱ ga̱jma̱á ruꞌwa a̱pha̱, ni̱mi̱ꞌtsu̱n ná-ma̱xáꞌne ruꞌwa a̱pha̱ rí ma̱ꞌne gámba̱a̱ ju̱ba̱ꞌ».<verse eid="GEN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 9:12" />A̱ꞌkhue̱n niꞌthán Ana̱ꞌlóꞌ: «Ríge̱ꞌ ñajuun tsinuu awan rí na̱gúꞌdo̱ꞌlo̱ꞌ jámuu mbiꞌi ikhúúnꞌ jamí ikháa̱nꞌlaꞌ, jamí mbá xúgíin tsí nduya júwa̱ꞌ ga̱jma̱á nindxa̱ꞌlaꞌ. <verse eid="GEN 9:12" /><verse number="13" style="v" sid="GEN 9:13" />Ni̱tsijii to̱ka̱ye̱ꞌ ná du̱u̱n, rí ma̱ꞌne tsinuu awan rí na̱gúꞌdo̱ꞌlo̱ꞌ ga̱jma̱á numbaa. <verse eid="GEN 9:13" /><verse number="14" style="v" sid="GEN 9:14" />Jamí ído̱ gáne̱ ma̱ꞌkha̱a̱ du̱u̱n ná inuu ju̱ba̱ꞌ, a̱ꞌkhue̱n rí ma̱kujmaa to̱ka̱ya̱ꞌ drígo̱ꞌ ná awúun du̱u̱n. <verse eid="GEN 9:14" /><verse number="15" style="v" sid="GEN 9:15" />A̱ꞌkhue̱n rí ma̱rmáꞌáa̱n a̱kui̱nꞌ awan rí ni̱gúꞌdo̱lo̱ꞌ ikhúúnꞌ ga̱jma̱á nindxa̱ꞌlaꞌ, jamí ga̱jma̱á máꞌ mbá xúgíin tsí nduya, xa̱bo̱ jamí xu̱kú. Ni̱mi̱ꞌtsu̱n ná-ma̱xáꞌne ruꞌwa a̱pha̱ rí ma̱ꞌne gámbi̱i̱n xa̱bo̱ jamí xu̱kú. <verse eid="GEN 9:15" /><verse number="16" style="v" sid="GEN 9:16" />Ído̱ gákujmaa to̱ka̱ya̱ꞌ ná du̱u̱n, ma̱ya̱xu̱u̱lo̱ꞌ jamí ma̱rmáꞌáa̱n a̱kui̱nꞌ awan rí gúꞌdo̱ꞌ jámuu mbiꞌi gajmíꞌ mbá xúgíin tsí nduya, xúgíin xa̱bo̱ jamí xu̱kú tsí júwa̱ꞌ ná inuu numbaa». <verse eid="GEN 9:16" /><verse number="17" style="v" sid="GEN 9:17" />Xkuaꞌnii jaꞌnii niꞌthán Ana̱ꞌlóꞌ, niꞌthúun Noé: «Ríge̱ꞌ ñajuun awan rí ni̱ꞌgílo̱ꞌ ikhúúnꞌ gajmíꞌ xúgíin xa̱bo̱ jamí xu̱kú tsí júwa̱ꞌ ná inuu numbaa».<verse eid="GEN 9:17" /></para>
  <para style="s">Xóo jaꞌnii rí neꞌne Noé gajmíí i̱ji̱i̱n</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18" />I̱ji̱i̱n Noé tsí nigájna̱á ná awúun rguwa ñajúún Sém, Kám jamí Jafét, jamí Kám ñajuun anu̱u̱ Kanaán. <verse eid="GEN 9:18" /><verse number="19" style="v" sid="GEN 9:19" />Mbá atsúun tsíge̱ꞌ ñajúún i̱ji̱i̱n Noé, jamí ikhii̱n ñajúu̱n tsí nene̱ matíí-mi̱jnaa̱ mbá xúgíí inuu numbaa.<verse eid="GEN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 9:20" />A̱ꞌkhue̱n rí Noé nigíꞌdu̱u̱ niñajun ná inuu ju̱ba̱ꞌ, jamí niꞌdii̱ mbá xaxtuu xndú úba̱. <verse eid="GEN 9:20" /><verse number="21" style="v" sid="GEN 9:21" />Ído̱ niꞌña̱a̱ iyoo xndú rí ni̱ga̱yu̱u̱ꞌ, a̱ꞌkhue̱n nijnga̱a̱ jamí kri̱ga̱a̱ tsaꞌtsaa̱ ná awúun guꞌwá xtíin rí xtáa̱. <verse eid="GEN 9:21" /><verse number="22" style="v" sid="GEN 9:22" />A̱ꞌkhue̱n ndiꞌyoo Kám, anu̱u̱ mbo̱ Kanaán, rí tsaꞌtsaa tátée̱, jamí ni̱ka̱ gáꞌthúu̱n ná-a̱jmi̱i̱ dxíyo̱o̱ tsí gatiin rixa̱á. <verse eid="GEN 9:22" /><verse number="23" style="v" sid="GEN 9:23" />A̱ꞌkhue̱n rí Sém ga̱jma̱á Jafét ndiye̱e̱ mbá xtíin, ni̱xpa̱tra̱me̱e̱ꞌ ná xpaphúu̱n, jamí niguwée̱ꞌ skidi rí ni̱mbra̱ma̱a̱ la ne̱ anúu̱. Numuu rí mbóó ná wéje̱ inúu̱ nu̱ya̱xi̱i̱, mbá xkuaꞌnii túyáa̱ rí tsaꞌtsaa anúu̱.<verse eid="GEN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 9:24" />Ído̱ niꞌni̱i̱ a̱kui̱i̱n Noé rí nijnga̱a̱, a̱ꞌkhue̱n nidxawuu̱n rí ni̱gu̱máa̱ neꞌne a̱dée̱ tsí lájuíin. <verse eid="GEN 9:24" /><verse number="25" style="v" sid="GEN 9:25" />A̱ꞌkhue̱n niꞌthée̱n:</para>
  <para style="q" vid="GEN 9:25">«Kixná-maꞌáan tsí Kanaán.</para>
  <para style="q" vid="GEN 9:25">Yumbáá tsí mingínáa i̱ndo̱ó máꞌ nayumbáá gánindxu̱u̱ inúú dxíyo̱o̱».<verse eid="GEN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 9:26" />A̱ꞌkhue̱n niꞌthée̱n xóó:</para>
  <para style="q" vid="GEN 9:26">«Anu̱ꞌ Mikhuíí gáꞌne tsakun-rámaa Sém.</para>
  <para style="q" vid="GEN 9:26">Ikhaa Kanaán gáꞌne yumbée̱.<verse eid="GEN 9:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="GEN 9:27" />Ana̱ꞌlóꞌ gáꞌne rí ma̱gi̱ꞌdoo numuu Jafét,</para>
  <para style="q" vid="GEN 9:27">ga̱xtáa̱ ná goꞌóo Sém,</para>
  <para style="q" vid="GEN 9:27">jamí Kanaán gáꞌne yumbée̱».<verse eid="GEN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 9:28" />Ído̱ rí ninújngoo máꞌ ruꞌwa a̱pha̱, Noé xóó nixtáa i̱mba̱á atsú siénto̱ i̱jma̱ skíñú gu̱wa̱ꞌ (350) tsigu. <verse eid="GEN 9:28" /><verse number="29" style="v" sid="GEN 9:29" />Mbá xúgíí mbiꞌi rí nixtáa Noé neꞌne mbá mijnagu̱wa̱ꞌ siénto̱ i̱jma̱ skíñú gu̱wa̱ꞌ (950) tsigu, a̱ꞌkhue̱n rí nijáñuu̱.<verse eid="GEN 9:29" /></para>
  <chapter eid="GEN 9" />
  <chapter number="10" style="c" sid="GEN 10" />
  <para style="s">I̱ji̱ín xa̱bi̱i̱ Noé</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1" />Ríge̱ꞌ naꞌthán mbiꞌñúú i̱ji̱i̱n Noé: Sém, Kám jamí Jafét. Mangii̱n ni̱gu̱mii i̱jíi̱n ído̱ wámba̱ rí ninújngoo máꞌ ruꞌwa a̱pha̱. <verse eid="GEN 10:1" /><verse number="2" style="v" sid="GEN 10:2" />I̱ji̱i̱n Jafét ñajúún Gomér, Magóg, Madái̱, Jabán, Tubál, Mesék jamí Tíra̱s. <verse eid="GEN 10:2" /><verse number="3" style="v" sid="GEN 10:3" />I̱ji̱i̱n Gomér ñajúún Askenás, Rifát jamí Togárma̱. <verse eid="GEN 10:3" /><verse number="4" style="v" sid="GEN 10:4" />I̱ji̱i̱n Jabán ñajúún Elísa̱, Társi̱s, Kitím jamí Dodaním. <verse eid="GEN 10:4" /><verse number="5" style="v" sid="GEN 10:5" />Tsúꞌkhue̱n ñajúún tsí ni̱dri̱ga̱a̱ xuajen ná rawuun iya mba̱a̱, mbámbá xó jaꞌnii ajngúu̱n xúꞌkhue̱n máꞌ xóo jaꞌnii inúú a̱nguíi̱n jamí xuajiúu̱n.<verse eid="GEN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 10:6" />I̱ji̱i̱n Kám ñajúún Kús, Misrái̱m, Fút jamí Kanaán. <verse eid="GEN 10:6" /><verse number="7" style="v" sid="GEN 10:7" />I̱ji̱i̱n Kús ñajúún Séba̱, Abíla̱, Sábta̱, Raáma̱ jamí Sabtéka̱. Xúꞌkhue̱n máꞌ i̱ji̱i̱n Raáma̱ ñajúún Séba̱ jamí Dedán. <verse eid="GEN 10:7" /><verse number="8" style="v" sid="GEN 10:8" />Ni̱gu̱maa mbáa a̱dée Kús mbiꞌyuu Nimród, ikhaa̱ ninindxu̱u̱ xa̱bo̱ tsí ginii neꞌne mba̱a̱ ski̱yu̱u̱ꞌ ná inuu ju̱ba̱ꞌ. <verse eid="GEN 10:8" /><verse number="9" style="v" sid="GEN 10:9" />Ana̱ꞌlóꞌ Mikhuíí niniñuu rí ma̱nindxu̱u̱ xa̱bo̱ tsí phú na̱ma̱ñuu naxnúú xu̱kú. Ikhaa jngó nuthan nguánáá xa̱bo̱ ajngáa ríge̱ꞌ: «Ikháán ñajuaanꞌ xóo Nimród, tsí Ana̱ꞌlóꞌ niniñuu rí phú ma̱ma̱ñuu maxnúú xu̱kú». <verse eid="GEN 10:9" /><verse number="10" style="v" sid="GEN 10:10" />Xuajen rí nigíꞌdu̱u̱ niꞌthán-ñájuun Nimród ñajuun Babél, Erék, Akád jamí Kálne̱, ná mbaa Sinár. <verse eid="GEN 10:10" /><verse number="11" style="v" sid="GEN 10:11" />Mbaa máꞌ rúꞌkhue̱n nigájnuu̱ ni̱ke̱e̱ ná mbaa Asíria̱ jamí ikhín nigruíge̱e̱ xuajen rí mbiꞌyuu Níni̱be̱, Reobót, Kála̱, <verse eid="GEN 10:11" /><verse number="12" style="v" sid="GEN 10:12" />jamí Resén. Ikhaa Resén ñajuun xuajen rí maphú mba̱a̱ rí ꞌgí majiu̱u̱nꞌ Níni̱be̱ ga̱jma̱á Kála̱.<verse eid="GEN 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 10:13" />Misrái̱m ninindxu̱u̱ anu̱ú mbo̱ ludím, mbo̱ anamím, mbo̱ leabím, mbo̱ naftuím, <verse eid="GEN 10:13" /><verse number="14" style="v" sid="GEN 10:14" />mbo̱ patrusím, mbo̱ kasluím, ná rí nigájnúú xa̱bo̱ filistéo̱, gajmíí máꞌ mbo̱ kaftorím.<verse eid="GEN 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 10:15" />Kanaán ninindxu̱u̱ anu̱u̱ Sidón, ada̱ tsí ginii, ga̱jma̱á Ét. <verse eid="GEN 10:15" /><verse number="16" style="v" sid="GEN 10:16" />Kanaán ñajuun anu̱ú xúgíin xa̱bo̱ mbo̱ jebuséo̱, mbo̱ amorréo̱, mbo̱ jerjeséo̱, <verse eid="GEN 10:16" /><verse number="17" style="v" sid="GEN 10:17" />mbo̱ ebéo̱, mbo̱ araséo̱, mbo̱ sinéo̱, <verse eid="GEN 10:17" /><verse number="18" style="v" sid="GEN 10:18" />mbo̱ arbadéo̱, mbo̱ semaréo̱ jamí mbo̱ amatéo̱. Nda̱wa̱á a̱ꞌkhue̱n ni̱drúꞌúún mbámbá inúú xa̱bi̱i̱ Kanaán. <verse eid="GEN 10:18" /><verse number="19" style="v" sid="GEN 10:19" />Mbañúú mbo̱ kananéo̱ jayá ná Sidón na̱ka̱ ná giaxu̱u̱ Jerár, na̱ga̱nú asndo ná Gása̱. Jamí ná giaxu̱u̱ ꞌgí Sodóma̱, na̱ka̱ ná Gomórra̱, Ádma̱ jamí Seboím, na̱ga̱nú asndo ná Lása̱. <verse eid="GEN 10:19" /><verse number="20" style="v" sid="GEN 10:20" />Xúgíin tsúꞌkhue̱n ñajúún i̱ji̱i̱n xa̱bi̱i̱ Kám, mbámbá inii a̱nguíi̱n, xúꞌkhue̱n máꞌ ajngúu̱n, xkuaꞌnii máꞌ mbañúu̱ jamí xuajiúu̱n.<verse eid="GEN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 10:21" />Sém, tsí dxájuu Jafét, ni̱gu̱mii i̱ji̱i̱n mangaa̱. Mbá xúgíin i̱ji̱i̱n Ébe̱r ñajúún i̱ji̱i̱n xa̱bi̱i̱ Sém. <verse eid="GEN 10:21" /><verse number="22" style="v" sid="GEN 10:22" />Tsí i̱ji̱i̱n Sém ninindxu̱ún Elám, Asúr, Arfaksád, Lúd jamí Arám. <verse eid="GEN 10:22" /><verse number="23" style="v" sid="GEN 10:23" />Tsí i̱ji̱i̱n Arám ninindxu̱ún Ús, Úl, Getér jamí Más. <verse eid="GEN 10:23" /><verse number="24" style="v" sid="GEN 10:24" />Ni̱gu̱maa mbáa a̱dée Arfaksád mbiꞌyuu Sála̱, jamí ni̱gu̱maa mbáa a̱dée Sála̱ mbiꞌyuu Ébe̱r. <verse eid="GEN 10:24" /><verse number="25" style="v" sid="GEN 10:25" />Xúꞌkhue̱n máꞌ Ébe̱r ni̱gu̱mii a̱jmi̱i̱ i̱ji̱i̱n. Mbáa mbiꞌyuu Pelég, numuu rí mbiꞌi rúꞌkhue̱n niwiꞌtháa mbaa, jamí dxíyo̱o̱ mbiꞌyuu Joktán. <verse eid="GEN 10:25" /><verse number="26" style="v" sid="GEN 10:26" />Jamí Joktán ninindxu̱u̱ anu̱ú Almodád, Seléf, Asár-mabét, Jéra̱, <verse eid="GEN 10:26" /><verse number="27" style="v" sid="GEN 10:27" />Adorám, Usál, Díkla̱, <verse eid="GEN 10:27" /><verse number="28" style="v" sid="GEN 10:28" />Obál, Abimaél, Séba̱, <verse eid="GEN 10:28" /><verse number="29" style="v" sid="GEN 10:29" />Ofír, Abíla̱ jamí Jobáb. Mbá xúgíin tsúꞌkhue̱n ninindxu̱ún i̱ji̱i̱n Joktán. <verse eid="GEN 10:29" /><verse number="30" style="v" sid="GEN 10:30" />Mbaa ná nijúwe̱e̱ꞌ jayá ná Mésa̱ giaxu̱u̱ Se̱fár, asndo mbaa júba̱ ná na̱ꞌkha̱ a̱kha̱ꞌ. <verse eid="GEN 10:30" /><verse number="31" style="v" sid="GEN 10:31" />Xúgíin tsúꞌkhue̱n ñajúún i̱ji̱i̱n xa̱bi̱i̱ Sém, mbámbá inii a̱nguíi̱n, xúꞌkhue̱n máꞌ ajngúu̱n, xkuaꞌnii máꞌ mbañúu̱ jamí xuajiúu̱n.<verse eid="GEN 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 10:32" />Mbá xúgíin tsúꞌkhue̱n ñajúún a̱ngui̱ín i̱ji̱i̱n Noé, rí mbámbá inii ri̱jiu̱u̱ꞌ xa̱bi̱i̱, jamí xúꞌkhue̱n máꞌ xuajiúu̱n. Jamí tsíge̱ꞌ ñajúún tsí ni̱drúꞌúún rí ni̱dri̱ga̱a̱ xuajiúún mbá xúgíí inuu numba̱a̱, ído̱ rí ninújngoo máꞌ ruꞌwa a̱pha̱.<verse eid="GEN 10:32" /></para>
  <chapter eid="GEN 10" />
  <chapter number="11" style="c" sid="GEN 11" />
  <para style="s">Ana̱ꞌlóꞌ eꞌne wájíi ajngáa ná Babél</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1" />Nákhí rí mbiꞌi rúꞌkhue̱n, mbóó ajngúún xa̱bo̱ mbá xúgíí inuu numba̱a̱, jamí mbóó máꞌ xóo nothee̱n. <verse eid="GEN 11:1" /><verse number="2" style="v" sid="GEN 11:2" />Jamí ído̱ nigájnúu̱ ná na̱ꞌkha̱ a̱kha̱ꞌ, ikhín ni̱xka̱maa̱ mbá xkua̱ ná mbayuu Sinár. Ikhín máꞌ niwanúu̱ rí ma̱ju̱wée̱ꞌ. <verse eid="GEN 11:2" /><verse number="3" style="v" sid="GEN 11:3" />A̱ꞌkhue̱n nithan-mi̱jne̱e̱: «Mo̱ꞌne̱lóꞌ ju̱ba̱ꞌ gaꞌkho̱ jamí mu̱tsikhálóꞌ ne̱ xóo tsíjui̱í». Xkuaꞌnii neꞌne rí nijmúu̱ tsíjui̱í xóo xtiꞌkhuu itsí, jamí i̱ndo̱ó mbá wájia rakha skuni nijmúu̱ rí ni̱ru̱ꞌwáa̱ ne̱. <verse eid="GEN 11:3" /><verse number="4" style="v" sid="GEN 11:4" />A̱ꞌkhue̱n nithan-mi̱jne̱e̱: «Mu̱ꞌgílóꞌ mbá xuajen jamí mu̱xu̱xílóꞌ mbá guꞌwá rí phú tsída̱ꞌ jamí ma̱jráꞌáan asndo mikhuíí. A̱ꞌkhue̱n rí ma̱bo̱o̱ꞌ ajngáa ga̱jma̱á numalóꞌ, ra̱ꞌkhá ma̱dráꞌáánlóꞌ mbá xúgíí ná inuu numba̱a̱». <figure style="fig" alt="Construcción torre Babel" file="CO00638B.TIF" size="span" ref="11.4">Ni̱xu̱xíí xa̱bo̱ mbá guꞌwá rí ma̱jráꞌáan asndoo mikhuíí.</figure><verse eid="GEN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 11:5" />A̱ꞌkhue̱n ni̱ga̱taa Ana̱ꞌlóꞌ Mikhuíí gáꞌyoo xuajen jamí guꞌwá rí phú tsída̱ꞌ rí nu̱xu̱xí máꞌ xa̱bo̱ numbaa. <verse eid="GEN 11:5" /><verse number="6" style="v" sid="GEN 11:6" />Niꞌthán Ana̱ꞌlóꞌ Mikhuíí: «Mbóó xuajen ñajúu̱n, jamí mbá xúgíi̱n mbóó ajngáa rí nothee̱n. Rí nigíꞌdíi̱ máꞌ nuñajuii̱n, asndo nimbá ma̱xáwe̱je̱-thu̱u̱n rí ma̱xúne̱ gáxíi̱ rí niꞌgí-mi̱jne̱e̱. <verse eid="GEN 11:6" /><verse number="7" style="v" sid="GEN 11:7" />Ikhaa jngó xúge̱ꞌ rá, mu̱guataalóꞌ mo̱ꞌne̱-ngra̱ꞌaalóꞌ ajngúu̱n, ikhaa jngó asndo nimbáa ma̱xáfroꞌo̱o̱ rí naꞌthán dxájuu».<verse eid="GEN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 11:8" />Xkuaꞌnii neꞌne Ana̱ꞌlóꞌ Mikhuíí rí ni̱drúꞌúu̱n mbá xúgíí inuu numba̱a̱, a̱ꞌkhue̱n ni̱ni̱ñáa̱ꞌ rí nu̱xu̱xi̱i̱ xuajen. <verse eid="GEN 11:8" /><verse number="9" style="v" sid="GEN 11:9" />Ikhaa jngó xuajen rúꞌkhue̱n neꞌne mbiꞌyuu Babél, numuu rí ikhín neꞌne-ngra̱ꞌaa Ana̱ꞌlóꞌ Mikhuíí ajngúún mbá xúgíin xa̱bo̱ numbaa, jamí ikhín niꞌnii̱ rí ma̱drúꞌúún xa̱bo̱ mbá xúgíí inuu numba̱a̱.<verse eid="GEN 11:9" /></para>
  <para style="s">Xa̱bi̱i̱ Sém</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10" />Tsíge̱ꞌ ñajúún xa̱bo̱ ri̱jiu̱u̱ꞌ Sém. Ído̱ neꞌne riajma̱ tsigu rí ninújngoo máꞌ ruꞌwa a̱pha̱, Sém gíꞌdoo mbá siénto̱ (100) tsigu, a̱ꞌkhue̱n ni̱gu̱maa a̱dée̱ tsí mbiꞌyuu Arfaksád. <verse eid="GEN 11:10" /><verse number="11" style="v" sid="GEN 11:11" />Rí ni̱gu̱maa máꞌ Arfaksád, xóó nixtáa Sém mbá witsu siénto̱ (500) tsigu, a̱ꞌkhue̱n rí ni̱gu̱mii xóó i̱ji̱i̱n xa̱bekha jamí go̱ꞌo̱.<verse eid="GEN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 11:12" />Arfaksád gíꞌdoo mbá skíñú gu̱wa̱ꞌ-nítsu (35) tsigu ído̱ rí ni̱gu̱maa a̱dée̱ tsí mbiꞌyuu Sála̱. <verse eid="GEN 11:12" /><verse number="13" style="v" sid="GEN 11:13" />Rí ni̱gu̱maa máꞌ Sála̱, xóó nixtáa Arfaksád mbá akho̱ siénto̱ e̱tso̱ (403) tsigu, a̱ꞌkhue̱n ni̱gu̱mii xóó i̱ji̱i̱n xa̱bekha jamí go̱ꞌo̱.<verse eid="GEN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 11:14" />Sála̱ gíꞌdoo mbá skíñú gu̱wa̱ꞌ (30) tsigu ído̱ rí ni̱gu̱maa a̱dée̱ tsí mbiꞌyuu Ébe̱r. <verse eid="GEN 11:14" /><verse number="15" style="v" sid="GEN 11:15" />Rí ni̱gu̱maa máꞌ Ébe̱r, xóó nixtáa Sála̱ mbá akho̱ siénto̱ e̱tso̱ (403) tsigu, a̱ꞌkhue̱n ni̱gu̱mii xóó i̱ji̱i̱n xa̱bekha jamí go̱ꞌo̱.<verse eid="GEN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 11:16" />Ébe̱r gíꞌdoo mbá skíñú gue̱kho̱ (34) tsigu ído̱ rí ni̱gu̱maa a̱dée̱ tsí mbiꞌyuu Pelég. <verse eid="GEN 11:16" /><verse number="17" style="v" sid="GEN 11:17" />Rí ni̱gu̱maa máꞌ Pelég, xóó nixtáa Ébe̱r mbá akho̱ siénto̱ mbá skíñú gu̱wa̱ꞌ (430) tsigu, a̱ꞌkhue̱n ni̱gu̱mii xóó i̱ji̱i̱n xa̱bekha jamí go̱ꞌo̱.<verse eid="GEN 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 11:18" />Pelég gíꞌdoo mbá skíñú gu̱wa̱ꞌ (30) tsigu ído̱ rí ni̱gu̱maa a̱dée̱ tsí mbiꞌyuu Réu̱. <verse eid="GEN 11:18" /><verse number="19" style="v" sid="GEN 11:19" />Rí ni̱gu̱maa máꞌ Réu̱, xóó nixtáa Pelég i̱jma̱ siénto̱ mijnagu̱wa̱ꞌ (209) tsigu, a̱ꞌkhue̱n ni̱gu̱mii xóó i̱ji̱i̱n xa̱bekha jamí go̱ꞌo̱.<verse eid="GEN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 11:20" />Réu̱ gíꞌdoo mbá skíñú gue̱jma̱ (32) tsigu ído̱ rí ni̱gu̱maa a̱dée̱ tsí mbiꞌyuu Serúg. <verse eid="GEN 11:20" /><verse number="21" style="v" sid="GEN 11:21" />Rí ni̱gu̱maa máꞌ Serúg, xóó nixtáa Réu̱ i̱jma̱ siénto̱ juan (207) tsigu, a̱ꞌkhue̱n ni̱gu̱mii xóó i̱ji̱i̱n xa̱bekha jamí go̱ꞌo̱.<verse eid="GEN 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 11:22" />Serúg gíꞌdoo mbá skíñú gu̱wa̱ꞌ (30) tsigu ído̱ rí ni̱gu̱maa a̱dée̱ tsí mbiꞌyuu Nakór. <verse eid="GEN 11:22" /><verse number="23" style="v" sid="GEN 11:23" />Rí ni̱gu̱maa máꞌ Nakór, xóó nixtáa Serúg i̱jma̱ siénto̱ (200) tsigu, a̱ꞌkhue̱n ni̱gu̱mii xóó i̱ji̱i̱n xa̱bekha jamí go̱ꞌo̱.<verse eid="GEN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 11:24" />Nakór gíꞌdoo mbá skíñú mijnagu̱wa̱ꞌ (29) tsigu ído̱ rí ni̱gu̱maa a̱dée̱ tsí mbiꞌyuu Taré. <verse eid="GEN 11:24" /><verse number="25" style="v" sid="GEN 11:25" />Rí ni̱gu̱maa máꞌ Taré, xóó nixtáa Nakór mbá witsu skíñú gu̱wa̱ꞌ-nítsu i̱kho̱ (119) tsigu, a̱ꞌkhue̱n ni̱gu̱mii xóó i̱ji̱i̱n xa̱bekha jamí go̱ꞌo̱.<verse eid="GEN 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 11:26" />Taré gíꞌdoo máꞌ mbá atsú skíñú gu̱wa̱ꞌ (70) tsigu ído̱ rí ni̱gu̱mii i̱ji̱i̱n tsí mbiꞌñúú Abrám, Nakór jamí Arán.<verse eid="GEN 11:26" /></para>
  <para style="s">Xa̱bi̱i̱ Taré</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27" />Tsíge̱ꞌ ñajúún xa̱bo̱ ri̱jiu̱u̱ꞌ Taré. Taré ni̱gu̱mii i̱ji̱i̱n tsí mbiꞌñúú Abrám, Nakór, jamí Arán. Xúꞌkhue̱n máꞌ Arán ni̱gu̱maa mbáa a̱dée̱ tsí mbiꞌyuu Lót. <verse eid="GEN 11:27" /><verse number="28" style="v" sid="GEN 11:28" />Arán nijáñuu wapha xó rí Taré, tsí ñajuun anu̱u̱. Ná xuajen rí ni̱gu̱maa̱, mbiꞌyuu Úr drígu̱ún mbo̱ kaldéo̱, ikhín máꞌ nijáñuu̱. <verse eid="GEN 11:28" /><verse number="29" style="v" sid="GEN 11:29" />Abrám ga̱jma̱á Nakór ni̱ni̱gui̱i̱nꞌ. A̱ꞌgui̱i̱ Abrám mbiꞌyuu Saraí, jamí a̱ꞌgui̱i̱ Nakór mbiꞌyuu Mílka̱. Mílka̱ ga̱jma̱á Íska̱ ñajúún i̱ji̱i̱n Arán. <verse eid="GEN 11:29" /><verse number="30" style="v" sid="GEN 11:30" />Xómáꞌ Saraí tsígu̱mii i̱ji̱i̱n ja.<verse eid="GEN 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 11:31" />Nigájnuu Taré ná Úr drígu̱ún mbo̱ kaldéo̱ rí na̱ke̱e̱ ná mbaa Kanaán. Jamí na̱ka̱ ga̱jma̱á máꞌ Abrám, mangaa Lót tsí ñajuun a̱ꞌdá-xíñii Taré, xúꞌkhue̱n máꞌ mangaa Saraí, a̱ꞌgui̱i̱ Abrám. Jamí ído̱ niguáꞌníi̱ asndo ná xuajen Arán, ikhín máꞌ niwanúu̱ nijúwe̱e̱ꞌ. <verse eid="GEN 11:31" /><verse number="32" style="v" sid="GEN 11:32" />A̱jma̱ siénto̱ witsu (205) tsigu nixtáa Taré, a̱ꞌkhue̱n nijáñuu̱ ná Arán.<verse eid="GEN 11:32" /></para>
  <chapter eid="GEN 11" />
  <chapter number="12" style="c" sid="GEN 12" />
  <para style="s">Ana̱ꞌlóꞌ nandxaꞌwá-ri̱ya̱a̱ꞌ Abrám</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1" />Wapha máꞌ Ana̱ꞌlóꞌ Mikhuíí niꞌthúun Abrám: «Atatsíñáá mbayaaꞌ, a̱ngia̱a̱nꞌ jamí goꞌóo ana̱a̱ꞌ, ayu ná mbaa rí ma̱snga̱jmáaꞌlo̱ꞌ. <verse eid="GEN 12:1" /><verse number="2" style="v" sid="GEN 12:2" />Ma̱ne̱ rí ma̱nindxa̱a̱ꞌ mbá xuajen mba̱a̱, jamí ma̱ne̱ tsakun-rámáálo̱ꞌ. Ma̱ne̱ rí phú ma̱gi̱ꞌdoo numuu mbiꞌyaaꞌ, jamí ga̱jma̱á numaaꞌ ikháán ma̱gu̱ma-tsakun-rámii iꞌwíin xa̱bo̱. <verse eid="GEN 12:2" /><verse number="3" style="v" sid="GEN 12:3" />Ma̱ne̱ tsakun-rámii tsí none̱ tsakun-rámáá, jamí tsí nuxna-maꞌáán ma̱xna̱-máꞌíinlo̱ꞌ. Ga̱jma̱á numaaꞌ ikháán ma̱gu̱ma-tsakun-rámii mbá xúgíin xa̱bo̱ numbaa».<verse eid="GEN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 12:4" />A̱ꞌkhue̱n rí ni̱ka̱ Abrám, xó rí waꞌtháa̱n neꞌne Ana̱ꞌlóꞌ Mikhuíí, jamí ni̱ka̱ Lót ga̱jma̱á nindxu̱u̱ mangaa. Mbá atsú skíñú gu̱wa̱ꞌ-nítsu (75) tsiguu Abrám nákhí rí nigájnuu̱ ná Arán. <verse eid="GEN 12:4" /><verse number="5" style="v" sid="GEN 12:5" />Jayáa̱ Saraí tsí a̱ꞌgui̱i̱, ni̱ke̱e̱, xúꞌkhue̱n máꞌ Lót, a̱dée dxíyo̱o̱. Judee̱ mbá xúgíí rí niguaꞌdáa̱, xúꞌkhue̱n máꞌ xa̱bo̱ tsí nitsii̱n ná Arán. Nigájnúu̱ nigóo̱ ná mbaa Kanaán, jamí ikhín máꞌ niguáꞌníi̱.<verse eid="GEN 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 12:6" />Abrám ni̱ka̱-ranújngoo mbaa rúꞌkhue̱n asndo ni̱ga̱níi̱ ná wéje̱ mbá ixe̱ xi̱xoo ná Moré, ná mbayuu Sikém. Nákhí mbiꞌi rúꞌkhue̱n mbo̱ kananéo̱ júwá máꞌ ná mbaa rúꞌkhue̱n. <verse eid="GEN 12:6" /><verse number="7" style="v" sid="GEN 12:7" />Ikhín nikujmaa Ana̱ꞌlóꞌ Mikhuíí inuu Abrám, jamí niꞌthúu̱n: «Ikhaa mbaa ríge̱ꞌ ma̱xnu̱úlo̱ꞌ i̱jia̱a̱nꞌ». A̱ꞌkhue̱n rí Abrám ni̱rngu̱xe̱ itsí ná ma̱ꞌne-mba̱a̱ Ana̱ꞌlóꞌ Mikhuíí, tsí nikujmaa inuu̱. <figure style="fig" alt="Abraham parado, altar alto" file="CO00645B.TIF" size="col" ref="12.7">Abrám naꞌne-mba̱a̱ Ana̱ꞌlóꞌ.</figure><verse eid="GEN 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 12:8" />A̱ꞌkhue̱n rí nigájnuu̱ ni̱ke̱e̱ ná júba̱ rí wéje̱ ná na̱ꞌkha̱ a̱kha̱ꞌ inuu xuajen Bet-él, jamí niꞌgíi̱ guꞌwá xtíin ná ma̱xtáa̱. Rí Bet-él niwanúu ná najngúun a̱kha̱ꞌ jamí xuajen Aí ꞌgí ná na̱ꞌkha̱ a̱kha̱ꞌ. A̱ꞌkhue̱n rí Abrám ni̱rngu̱xe̱ itsí ná ma̱ꞌne-mba̱a̱ Ana̱ꞌlóꞌ Mikhuíí, jamí nixrégo̱o̱ mbiꞌyuu Ana̱ꞌlóꞌ. <verse eid="GEN 12:8" /><verse number="9" style="v" sid="GEN 12:9" />Ikhín nigájnuu Abrám ni̱ka̱-rangrigo̱o̱ꞌ mañuu máꞌ xúꞌkhue̱n, asndo ná mbaa Negéb.<verse eid="GEN 12:9" /></para>
  <para style="s">Abrám ni̱ga̱taa ná Ejípto̱</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10" />Mbiꞌi rúꞌkhue̱n niríga̱ ewe ná mbaa xtáa Abrám. A̱ꞌkhue̱n rí ni̱ga̱taa̱ gáxtáa̱ ná Ejípto̱, numuu rí phú gakhe̱ eꞌne ewe. <verse eid="GEN 12:10" /><verse number="11" style="v" sid="GEN 12:11" />Rí inu máꞌ wáa ma̱ga̱níi̱ ná Ejípto̱ niꞌthúu̱n a̱ꞌgui̱i̱: «Ikhúúnꞌ nda̱yo̱o̱ rí a̱ꞌgo̱ tsí phú tsiꞌyáa ñajuaanꞌ. <verse eid="GEN 12:11" /><verse number="12" style="v" sid="GEN 12:12" />Ído̱ gúyaaꞌ xa̱bo̱ Ejípto̱ muthan: “A̱ꞌgui̱i̱ xa̱bo̱ tsúꞌkhue̱n ñajuu̱n jno̱ꞌ”. A̱ꞌkhue̱n rí ikhúúnꞌ mu̱xi̱ñúu̱, xómáꞌ ikháán ma̱jríña̱á gúni̱i̱. <verse eid="GEN 12:12" /><verse number="13" style="v" sid="GEN 12:13" />Ikhaa jngó arathúu̱n rí dxáguíꞌ ñajuaanꞌ, kajngó nga̱ju̱ún gúni̱i̱ ga̱jma̱á numaaꞌ ikháán, jamí ma̱tha̱ne̱ rí ma̱xtáá xóó».<verse eid="GEN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 12:14" />Ído̱ ni̱ga̱nú Abrám ná Ejípto̱, a̱ꞌkhue̱n rí xa̱bo̱ xuajen ndiyáá rí phú tsiꞌyáa mi̱ndaꞌkho Saraí. <verse eid="GEN 12:14" /><verse number="15" style="v" sid="GEN 12:15" />Xúꞌkhue̱n máꞌ ndiyáá xa̱bo̱ ede̱ tsí nuñajun ná inuu Faraón, ikhaa jngó máján nithee̱n ga̱jma̱á numuu Saraí. A̱ꞌkhue̱n rí ni̱ka̱ jiꞌyáa̱ ná goꞌóo Faraón.<note caller="+" style="f"><char style="fr" closed="false">12.15 </char><char style="ft" closed="false">«Faraón» nuxnáá mbiꞌyuu thúngaa mba̱a̱ ná Ejípto̱.</char></note><verse eid="GEN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 12:16" />A̱ꞌkhue̱n rí Faraón neꞌne-nga̱jo̱o̱ Abrám ga̱jma̱á numuu Saraí. Nixníi̱ mogo̱, xede̱, yumbáá xa̱bekha, yumbáá go̱ꞌo̱, xtá-ngidi jamí kaméyo̱. <verse eid="GEN 12:16" /><verse number="17" style="v" sid="GEN 12:17" />Xómáꞌ Ana̱ꞌlóꞌ Mikhuíí rá, niꞌnii̱ rí ma̱ꞌkha̱ mbaꞌa inii nandi gakhe̱ inuu Faraón jamí inúú xa̱bo̱ goꞌóo̱, ga̱jma̱á numuu a̱ꞌgui̱i̱ Abrám. <verse eid="GEN 12:17" /><verse number="18" style="v" sid="GEN 12:18" />A̱ꞌkhue̱n rí Faraón nindxaꞌwóo Abrám, jamí niꞌthúu̱n: «Náá numuu kajngó xáꞌnii nithañu̱ꞌ róꞌ. Náá rí jngó tára̱thu̱nꞌ rí a̱ꞌgia̱a̱ꞌ ñajuu̱n róꞌ. <verse eid="GEN 12:18" /><verse number="19" style="v" sid="GEN 12:19" />Náá numuu kajngó nirathán rí dxágiáaꞌ ñajuu̱n róꞌ. Rí i̱tha̱n mba̱ya̱a̱ rí ma̱ꞌne a̱ꞌgui̱ꞌ ñajuu̱n. Ikhaa jngó ge̱jioꞌ xtáa a̱ꞌgia̱a̱ꞌ. Ayáa̱ jamí ayu̱uꞌ ga̱jma̱a̱ꞌ rá». <verse eid="GEN 12:19" /><verse number="20" style="v" sid="GEN 12:20" />A̱ꞌkhue̱n rí Faraón nixná-ñájúún xa̱bi̱i̱ rí mu̱xkri̱ya̱a̱ꞌ Abrám ga̱jma̱á a̱ꞌgui̱i̱, jamí ga̱jma̱á máꞌ mbá xúgíí rí gíꞌdoo̱.<verse eid="GEN 12:20" /></para>
  <chapter eid="GEN 12" />
  <chapter number="13" style="c" sid="GEN 13" />
  <para style="s">Abraám naꞌne wájí-mina̱ꞌ ga̱jma̱á Lót</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1" />Ído̱ Abrám nigájna̱a̱ ná Ejípto̱, nitsima̱a̱ ná giaxu̱u̱ mbayuu Negéb ga̱jmáa̱ a̱ꞌgui̱i̱, ga̱jma̱á mbá xúgíí rí gíꞌdoo̱, xúꞌkhue̱n máꞌ ga̱jmáa̱ Lót mangaa. <verse eid="GEN 13:1" /><verse number="2" style="v" sid="GEN 13:2" />Abrám phú ni̱gi̱ꞌdiin mi̱ndaꞌkho xu̱kú kiraꞌdiin, jamí phú ni̱gi̱ꞌdoo̱ ajua̱nꞌ rí miꞌxá ga̱jma̱á rí mo̱jmo̱ꞌ. <verse eid="GEN 13:2" /><verse number="3" style="v" sid="GEN 13:3" />Ná rí Negéb nigájna̱a̱ Abrám, mañuu máꞌ xúꞌkhue̱n ni̱ꞌkha̱a̱-ratanga̱a asndo ni̱ga̱núu̱ ná Bet-él, ná nixtáa̱ nákhí rí ginii, ná majiu̱u̱nꞌ xuajen Bet-él ga̱jma̱á Aí. <verse eid="GEN 13:3" /><verse number="4" style="v" sid="GEN 13:4" />Ikhín máꞌ ná rí ni̱rngu̱xi̱i̱ itsí nákhí rí wapha, Abrám nixrégo̱o̱ mbiꞌyuu Ana̱ꞌlóꞌ Mikhuíí.<verse eid="GEN 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 13:5" />Xúꞌkhue̱n máꞌ Lót mangaa, rí ngrigo̱o̱ ga̱jmáa̱ Abrám, ni̱gi̱ꞌdii̱n mogo̱, xede̱, jamí ni̱gi̱ꞌdoo̱ guꞌwá xtíin. <verse eid="GEN 13:5" /><verse number="6" style="v" sid="GEN 13:6" />Ikhaa jngó ná mbaa rí júwe̱e̱ꞌ tséꞌngo̱o̱ rí ma̱ju̱wée̱ꞌ ná-a̱jmi̱i̱, numuu rí phú kuaꞌdáa̱ mi̱ndaꞌkhúún. Rúꞌkhue̱n jngó níyoo rí ma̱ju̱wée̱ꞌ mbóó, <verse eid="GEN 13:6" /><verse number="7" style="v" sid="GEN 13:7" />numuu rí kuaꞌdáá xkujndu tsí nu̱ña̱wu̱ún xu̱kuíi Abrám gajmíí tsí nu̱ña̱wu̱ún xu̱kuíi Lót. Mbáá máꞌ rí mbiꞌi rúꞌkhue̱n mbo̱ kananéo̱ gajmíí mbo̱ fereséo̱ júwá máꞌ ná mbaa rúꞌkhue̱n. <verse eid="GEN 13:7" /><verse number="8" style="v" sid="GEN 13:8" />A̱ꞌkhue̱n rí Abrám niꞌthúun Lót: «Ra̱gíꞌmaa rí mu̱tsa̱ña̱ꞌlóꞌ ikháa̱nꞌlóꞌ, ni máꞌ xa̱bo̱ tsí nu̱ña̱wu̱ún xu̱kiálóꞌ, numuu rí mijngi juꞌya-mi̱jna̱lóꞌ. <verse eid="GEN 13:8" /><verse number="9" style="v" sid="GEN 13:9" />Á ra̱ꞌkhá a̱ꞌkhue̱n kri̱ga̱ mbá xúgíí mbaa rí ma̱goo ma̱tra̱ꞌwíí rá. Athañu̱ꞌ mbá rí máján, athane̱ janíí-mina̱ꞌ. Xí rí ikháán nadxo̱ꞌ ná ñawún xti̱ya̱ꞌlóꞌ, ikhúúnꞌ ma̱ꞌgá ná ñawún májánlóꞌ, o xí ikháán nadxo̱ꞌ ná ñawún májánlóꞌ mbo̱ꞌ, ma̱ꞌgá ikhúúnꞌ ná ñawún xti̱ya̱ꞌlóꞌ xúꞌkhue̱n rá». <figure style="fig" alt="Abraham, Lot, escogen tierra" file="CO00647b.tif" size="span" loc="13.8-9" ref="13.9">Abrám ga̱jma̱á Lót nu̱ra̱ꞌwíí mbaa ná rí ma̱ju̱wée̱ꞌ.</figure><verse eid="GEN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 13:10" />A̱ꞌkhue̱n rí niyaxe̱ Lót, jamí ndiꞌyoo̱ mbá xúgíí xko̱o̱ mañuu Jordán asndo ná rí giaxu̱u̱ xuajen Soár, rí mbá xúgíí ne̱ ñajuun mbaa xtagíya̱ꞌ. Xómá mbaa ixe̱ mitsaan drígo̱o̱ Ana̱ꞌlóꞌ Mikhuíí jaꞌnii ne̱, o xómá mbayuu Ejípto̱. Xkuaꞌnii jaꞌnii ne̱ nákhí rí xóó táꞌne gámba̱a̱ Ana̱ꞌlóꞌ Mikhuíí Sodóma̱ ga̱jma̱á Gomórra̱. <verse eid="GEN 13:10" /><verse number="11" style="v" sid="GEN 13:11" />A̱ꞌkhue̱n rí Lót niraꞌwíí mbá xúgíí xko̱o̱ mañuu Jordán, jamí nigájnuu̱ ni̱ke̱e̱ ná na̱ꞌkha̱ a̱kha̱ꞌ. Xkuaꞌnii neꞌne rí nene̱ wájí-mi̱jne̱e̱. <verse eid="GEN 13:11" /><verse number="12" style="v" sid="GEN 13:12" />Kajngó Abrám niwanúu nixtáa ná mbayuu Kanaán. Xómáꞌ Lót, ni̱ka̱-raxtáa ná xuajen rí triga̱ ná xkua̱, jamí ni̱ka̱-raskuíji̱i̱ guꞌwá xtíin drígo̱o̱ asndo ná Sodóma̱. <verse eid="GEN 13:12" /><verse number="13" style="v" sid="GEN 13:13" />I̱ndo̱ó numuu rí xa̱bo̱ tsí júwa̱ꞌ ná Sodóma̱ rí phú nda̱a̱ gamakúún, jamí maphú mba̱a̱ mi̱ndaꞌkho aꞌkhán i̱xu̱da̱ꞌ-mi̱jne̱e̱ ná inuu Ana̱ꞌlóꞌ Mikhuíí.<verse eid="GEN 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14" />Nda̱wa̱á rí niríya̱ꞌ-mina̱ꞌ máꞌ Lót, a̱ꞌkhue̱n Ana̱ꞌlóꞌ Mikhuíí niꞌthúun Abrám: «Atiaxe̱ asndo ná rí xtaa máꞌ a̱ꞌkhue̱n, atiaxi̱í naꞌwáán jamí jawáá, xúꞌkhue̱n máꞌ ná na̱ꞌkha̱ a̱kha̱ꞌ jamí ná najngúun a̱kha̱ꞌ. <verse eid="GEN 13:14" /><verse number="15" style="v" sid="GEN 13:15" />Numuu rí mbá xúgíí mbaa rí natiaxi̱í, ma̱xna̱a̱ꞌlo̱ꞌ ikháán gajmiáaꞌ xa̱bia̱a̱ꞌ, mbá jámuu gáꞌne dríga̱ꞌlaꞌ. <verse eid="GEN 13:15" /><verse number="16" style="v" sid="GEN 13:16" />Jamí ma̱ne̱ rí ma̱mi̱diúún mi̱ndaꞌkho xa̱bia̱a̱ꞌ asndo xóo yujndo̱o̱ꞌ ju̱ba̱ꞌ. Xí mbáa na̱ꞌngo̱o̱ na̱gu̱xnuu iꞌñúu yujnda̱ꞌ, xkuaꞌnii máꞌ ma̱goo ma̱gi̱xnuu xa̱bia̱a̱ꞌ mangiin. <verse eid="GEN 13:16" /><verse number="17" style="v" sid="GEN 13:17" />Araxo̱n, ayu mbá xúgíí rí ꞌmba̱ꞌ mbaa ríge̱ꞌ, jamí xúgíí rí ma̱jia̱nꞌ ne̱, numuu rí ikháán na̱xna̱a̱ꞌ ne̱».<verse eid="GEN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 13:18" />A̱ꞌkhue̱n rí Abrám ndiyá-tuxi̱i̱ la guꞌwá xtíin jamí ni̱ka̱ gáxtáa̱ ná Ebrón ná kuájun ixe̱ xi̱xoo drígo̱o̱ Mámre̱. Ikhín máꞌ ni̱rngu̱xi̱i̱ itsí ná ma̱ꞌne-mba̱a̱ Ana̱ꞌlóꞌ Mikhuíí.<verse eid="GEN 13:18" /></para>
  <chapter eid="GEN 13" />
  <chapter number="14" style="c" sid="GEN 14" />
  <para style="s">Abrám naꞌne-jríya̱a̱ꞌ Lót</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1" />Nákhí máꞌ mbiꞌi rúꞌkhue̱n Amrafél naꞌthán-ñájuun ná Sinár, Ariók naꞌthán-ñájuun ná Elasár, Kedorlaomér naꞌthán-ñájuun ná Elám, jamí Tidál naꞌthán-ñájuun ná Goím. <verse eid="GEN 14:1" /><verse number="2" style="v" sid="GEN 14:2" />Ikhiin tsíge̱ꞌ nixna-mijná gajmíí Béra̱ tsí naꞌthán-ñájuun ná Sodóma̱, Bírsa̱ tsí naꞌthán-ñájuun ná Gomórra̱, Sináb tsí naꞌthán-ñájuun ná Ádma̱, Semebér tsí naꞌthán-ñájuun ná Seboím, ga̱jma̱á tsí naꞌthán-ñájun ná Béla̱ (rí mbiꞌyuu máꞌ Soár). <verse eid="GEN 14:2" /><verse number="3" style="v" sid="GEN 14:3" />Xúgíin tsí mbá witsuun ge̱e̱ ni̱ru̱wa-mi̱jna̱ ná xko̱o̱ Sidím (rí mbiꞌyuu máꞌ Ñañuu A̱pha̱ Ríná rí mbiꞌi xúge̱ꞌ). <verse eid="GEN 14:3" /><verse number="4" style="v" sid="GEN 14:4" />Numuu rí mbá gue̱jma̱ tsigu nini̱i̱ rí waꞌthán-ñájúu̱n neꞌne Kedorlaomér. Rí tsigu ti̱gue̱tso̱, a̱ꞌkhue̱n ná-ra̱khúu̱n rí mi̱ꞌthán-ñájúu̱n.<verse eid="GEN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 14:5" />Ído̱ ni̱ga̱nú tsigu ti̱gue̱kho̱, ni̱ꞌkha̱ Kedorlaomér gajmíí thúngaa tsí júwá ga̱jma̱á nindxu̱u̱. Ni̱ꞌngúu̱n nene̱ gajmíi̱ xa̱bo̱ refaíta̱ ná Astarót Karnaím, xúꞌkhue̱n máꞌ mbo̱ susíta̱ ná Ám, jamí mbo̱ emíta̱ ná Sabe-kiriataím. <verse eid="GEN 14:5" /><verse number="6" style="v" sid="GEN 14:6" />Xúꞌkhue̱n máꞌ ni̱ꞌngúu̱n nene̱ gajmíi̱ mbo̱ oréo̱ ná júba̱ Seír, asndo ná xkua̱ Parán, rí ꞌgí mijngi ná mbaa niníí. <verse eid="GEN 14:6" /><verse number="7" style="v" sid="GEN 14:7" />A̱ꞌkhue̱n rí nitangi̱i̱n niguwáa̱nꞌ ná Enmispát, rí ñajuun Káde̱s, jamí nene̱ gámba̱a̱ mbá xúgíí rí ríga̱ ná inuu mbañúú xa̱bo̱ amalesíta̱, xúꞌkhue̱n máꞌ niñúu̱ mbo̱ amorréo̱ tsí júwa̱ꞌ ná Asesón-tamár.<verse eid="GEN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 14:8" />A̱ꞌkhue̱n rí nigájnúú thúngaa: thúngaa tsí naꞌthán-ñájuun Sodóma̱, tsí naꞌthán-ñájuun Gomórra̱, tsí naꞌthán-ñájuun Ádma̱, tsí naꞌthán-ñájuun Seboím jamí mangaa tsí naꞌthán-ñájuun Béla̱ (rí mbiꞌyuu máꞌ Soár). A̱ꞌkhue̱n rí ná mbaa xkua̱ Sidím ni̱ru̱wa-mi̱jne̱e̱ mbóó rí mone̱ gajmíi̱ <verse eid="GEN 14:8" /><verse number="9" style="v" sid="GEN 14:9" />thúngaa Kedorlaomér tsí naꞌthán-ñájuun Elám, Tidál tsí naꞌthán-ñájuun Goím, Amrafél tsí naꞌthán-ñájuun Sinár, jamí Ariók tsí naꞌthán-ñájuun Elasár. Rí mbá akhu̱u̱n thúngaa tsúꞌkhue̱n nene̱ gajmíí tsí witsuun tsíge̱ꞌ. <verse eid="GEN 14:9" /><verse number="10" style="v" sid="GEN 14:10" />Ná rí xkua̱ Sidím triga̱ mi̱ndaꞌkho iñá ná nagájnuu wájia skuni, jamí ído̱ rí nigáñúú xa̱bo̱ ñajun Sodóma̱ ga̱jma̱á Gomórra̱ mbá tikhuun ni̱duáꞌíin ikhín, xómáꞌ tsí iꞌwíin ni̱ꞌngu̱ún nigáñú-tuꞌúún asndo ná júba̱. <verse eid="GEN 14:10" /><verse number="11" style="v" sid="GEN 14:11" />A̱ꞌkhue̱n rí xa̱bo̱ ñajun tsí ni̱ꞌngu̱ún, nirawíi̱ mbá xúgíí rí máján ríga̱ ná Sodóma̱ ga̱jma̱á Gomórra̱, xúꞌkhue̱n máꞌ mbá xúgíí ganitsu, a̱ꞌkhue̱n rí nigúu̱n. <verse eid="GEN 14:11" /><verse number="12" style="v" sid="GEN 14:12" />Numuu rí ná Sodóma̱ máꞌ xtáa Lót, dríxe̱e̱ Abrám, nigó juya̱a̱ mangaa ga̱jma̱á mbá xúgíí rí gíꞌdoo̱.<verse eid="GEN 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 14:13" />Jamí mbáa xa̱bo̱ tsí ni̱ꞌngo̱o̱ neꞌne-jríya̱ꞌ-mina̱ꞌ ni̱ꞌkha̱ jayóo̱ ajngáa inuu Abrám mbo̱ ebréo̱, tsí xtáa ná xi̱xoo drígo̱o̱ Mámre̱ mbo̱ amorréo̱, dxíyo̱o̱ máꞌ Eskól ga̱jma̱á Anér. Ikhii̱n nambáxúu̱n gajmíi̱ Abrám. <verse eid="GEN 14:13" /><verse number="14" style="v" sid="GEN 14:14" />Ído̱ nidxawuun Abrám rí nikhuáa dríxe̱e̱, a̱ꞌkhue̱n rí nixnúu̱ ajua̱nꞌ rí ma̱gi̱da̱ꞌ ñawúún mbá atsú siénto̱ gu̱wa̱ꞌ-nítsu e̱tso̱ (318) yumbée̱ tsí ni̱gu̱mii ná goꞌóo̱. A̱ꞌkhue̱n ni̱ka̱-raxkúu̱n mbá ná-akhu̱u̱n xa̱bo̱ ñajun asndo ná Dán. <verse eid="GEN 14:14" /><verse number="15" style="v" sid="GEN 14:15" />Abrám gajmíí xa̱bi̱i̱, nda̱a̱ ajngóo ni̱tu̱ꞌúu̱n mbroꞌon ná kachúún xa̱bo̱ ñajun, jamí nigó-ruxkúu̱n asndo ná Óba̱ rí ꞌgí ná tsu̱du̱u̱ xuajen Damásko̱. <verse eid="GEN 14:15" /><verse number="16" style="v" sid="GEN 14:16" />Xkuaꞌnii nigu̱u̱ mbá xúgíí rí máján rí ni̱dri̱gú xa̱bo̱ tsúꞌkhue̱n, xúꞌkhue̱n máꞌ neꞌne-jríya̱a̱ꞌ dríxe̱e̱ ga̱jma̱á mbá xúgíí drígo̱o̱ rí ni̱ga̱taa. Xúꞌkhue̱n máꞌ neꞌne-jáwíi̱n go̱ꞌo̱ jamí iꞌwíin xa̱bo̱.<verse eid="GEN 14:16" /></para>
  <para style="s">Melkisedék naꞌne tsakun-rámaa Abrám</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17" />Natanga̱a̱ máꞌ Abrám ído̱ rí ni̱ꞌngo̱o̱ neꞌne ga̱jmáa̱ Kedorlaomér jamí iꞌwíin thúngaa tsí júwá ga̱jma̱á nindxu̱u̱ Kedorlaomér. A̱ꞌkhue̱n rí thúngaa Sodóma̱ nigájnuu ni̱ꞌkha̱ gátsijnuu Abrám ná xkua̱ Sábe̱, ikhaa rí mbiꞌyuu Xko̱o̱ Thúngaa. <verse eid="GEN 14:17" /><verse number="18" style="v" sid="GEN 14:18" />A̱ꞌkhue̱n rí Melkisedék, tsí ñajuun thúngaa ná xuajen Salém, ni̱gu̱wíi̱ guma wopho ga̱jma̱á iyoo xndú úba̱. Ikhaa̱ ñajuu̱n dxakuun drígo̱o̱ Ana̱ꞌlóꞌ Mikhuíí, <verse eid="GEN 14:18" /><verse number="19" style="v" sid="GEN 14:19" />ikhaa jngó neꞌne tsakun-rámaa̱ Abrám ga̱jma̱á ajngáa ríge̱ꞌ:</para>
  <para style="q" vid="GEN 14:19">«Ana̱ꞌlóꞌ Tsí Xtáa Mikhuíí,</para>
  <para style="q" vid="GEN 14:19">tsí neꞌne ku̱maa mikhu ga̱jma̱á ju̱ba̱ꞌ,</para>
  <para style="q" vid="GEN 14:19">gáꞌne tsakun-rámaa Abrám.<verse eid="GEN 14:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="GEN 14:20" />Ga̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ Tsí Xtáa Mikhuíí,</para>
  <para style="q" vid="GEN 14:20">tsí nixnáxi̱i̱n xa̱bo̱ sia̱a̱nꞌ ná ñawáanꞌ».</para>
  <para style="m" vid="GEN 14:20">A̱ꞌkhue̱n rí Abrám nixnúu Melkisedék mbóó awúun rí mbámbá gu̱wa̱ꞌ rí mbá xúgíí rí nigu̱u̱.<verse eid="GEN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 14:21" />A̱ꞌkhue̱n rí thúngaa mbo̱ Sodóma̱ niꞌthúun Abrám:</para>
  <para style="p" vid="GEN 14:21">―Araxníi̱ꞌ xa̱bi̱ꞌ, jamí a̱wanúu ná ñawáanꞌ mbá xúgíí rí nida̱a̱.<verse eid="GEN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 14:22" />Xómáꞌ Abrám niriꞌña̱a̱ ajngóo thúngaa Sodóma̱:</para>
  <para style="p" vid="GEN 14:22">―Ni̱xu̱ꞌdá-mina̱ꞌ inuu Ana̱ꞌlóꞌ Tsí Xtáa Mikhuíí, tsí neꞌne ku̱maa mikhu ga̱jma̱á ju̱ba̱ꞌ, <verse eid="GEN 14:22" /><verse number="23" style="v" sid="GEN 14:23" />rí asndo ni xí lájuíin rí dríga̱a̱ꞌ ma̱xáya̱lo̱ꞌ. Nimbá gúmáaꞌ, ni máꞌ ñawiin chádaaꞌ ma̱xáya̱lo̱ꞌ, ikhaa jngó ma̱xára̱tha̱n: “Ikhúúnꞌ ne̱ne̱ rí ma̱gi̱ꞌdoo guéño Abrám”. <verse eid="GEN 14:23" /><verse number="24" style="v" sid="GEN 14:24" />Mbájndi máꞌ i̱ndo̱ó rí niꞌpho̱ xa̱bi̱ꞌ. Xómáꞌ xa̱bo̱ tsí nika gajmíꞌ rá, Anér, Eskól jamí Mámre̱, gu̱dri̱guíi̱ ikhii̱n rí jaꞌñúu̱.<verse eid="GEN 14:24" /></para>
  <chapter eid="GEN 14" />
  <chapter number="15" style="c" sid="GEN 15" />
  <para style="s">Ana̱ꞌlóꞌ naxuda-mina̱ꞌ rí ma̱gu̱maa mbáa a̱dée Abrám</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1" />Nda̱wa̱á rí ninújngoo máꞌ ríge̱ꞌ, ni̱ꞌkha̱ ajngáa rawuun Ana̱ꞌlóꞌ Mikhuíí ná inuu Abrám asndo xó xnuꞌndaa inuu mbiꞌi. Xáꞌnii waꞌtháa̱n:</para>
  <para style="p" vid="GEN 15:1">―Ma̱xámíñaaꞌ Abrám, ikhúúnꞌ ñaju̱nꞌ tsí na̱ña̱wa̱a̱nꞌ. Maphú mba̱a̱ mi̱ndaꞌkho rí mbi̱ya̱a̱ numaaꞌ.<verse eid="GEN 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 15:2" />Xómáꞌ Abrám niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 15:2">―Táta̱ Anu̱ꞌ Mikhuíí, náá-lá numuu gára̱xnu̱ꞌ guéño xí ndawi̱i̱n máꞌ i̱ji̱nꞌ rá. I̱ndo̱ó máꞌ Eliesér tsí na̱ꞌkha̱ ná Damásko̱ nayumbáá na̱ña̱wu̱u̱n mbá xúgíí rí gúꞌdo̱ꞌ. <verse eid="GEN 15:2" /><verse number="3" style="v" sid="GEN 15:3" />―Niꞌthán xóó Abrám―: Nathayáá máꞌ ikháán rí tára̱xni̱ꞌ nimbáa a̱ꞌdéꞌ, ikhaa jngó ikhaa máꞌ yumbáá, mbo̱ ni̱gu̱maa ná goꞌóꞌ, ma̱wanúu ñawúun rí gúꞌdo̱ꞌlo̱ꞌ.<verse eid="GEN 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 15:4" />A̱ꞌkhue̱n ni̱ꞌkha̱ mbu̱jú ajngóo Ana̱ꞌlóꞌ Mikhuíí inuu Abrám:</para>
  <para style="p" vid="GEN 15:4">―Ma̱xáwanúu ñawúun tsúꞌkhue̱n dríga̱a̱ꞌ, rí mbáa tsí a̱ꞌdeáaꞌ jmína̱á ma̱wanúu ñawúun ne̱.<verse eid="GEN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 15:5" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ ni̱ka̱ jayáa Abrám rixa̱á, jamí niꞌthúu̱n:</para>
  <para style="p" vid="GEN 15:5">―Atiaxi̱í mikhu, jamí araxnuu a̱ꞌgua̱án xí na̱ꞌnga̱a̱ꞌ. ―A̱ꞌkhue̱n niꞌthán Ana̱ꞌlóꞌ―: Xkuaꞌnii mbaꞌiin xa̱bia̱a̱ꞌ gáꞌne.<verse eid="GEN 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 15:6" />Ninimbo̱o̱ꞌ Abrám jaꞌyoo Ana̱ꞌlóꞌ Mikhuíí, rúꞌkhue̱n jngó Ana̱ꞌlóꞌ ndiꞌyoo rí májáan a̱kui̱i̱n. <verse eid="GEN 15:6" /><verse number="7" style="v" sid="GEN 15:7" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ niꞌthúun Abrám:</para>
  <para style="p" vid="GEN 15:7">―Ikhúúnꞌ ñaju̱nꞌ Táta̱ Mikhuíí tsí ni̱ríña̱á ná Úr xuajiúún mbo̱ kaldéo̱, rí ma̱xna̱a̱ꞌ ma̱ꞌne mbayaaꞌ mbaa ríge̱ꞌ.<verse eid="GEN 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 15:8" />A̱ꞌkhue̱n rí Abrám niraxu̱u̱ Ana̱ꞌlóꞌ:</para>
  <para style="p" vid="GEN 15:8">―Táta̱ Anu̱ꞌ Mikhuíí, xáne-lá gáyu̱u̱ rí ma̱ra̱xnu̱ꞌ ne̱ ma̱ꞌne mbayu̱ꞌ rá.<verse eid="GEN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 15:9" />Xómáꞌ Ana̱ꞌlóꞌ niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 15:9">―Aya̱ ꞌcháa mbáa xede̱ iꞌgú tsí atsú tsiguu, mbáa tso̱toon iꞌgú tsí atsú tsiguu, jamí mbáa mogo̱ tsí atsú tsiguu, mbáa gúgo̱ jamí mbáa rigu mangaa.<verse eid="GEN 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 15:10" />A̱ꞌkhue̱n rí Abrám ni̱ꞌkha̱ jagu̱u̱n xúgíin xu̱kú tsúꞌkhue̱n. Nixpíthá-ngañii̱ jamí mbéꞌtháan niskuíji̱i̱ xuéꞌthúún. Xómáꞌ ño̱ꞌo̱n táxpíꞌthá-ngañii̱. <verse eid="GEN 15:10" /><verse number="11" style="v" sid="GEN 15:11" />A̱ꞌkhue̱n naguátaan dxáꞌan ná triga̱ xuñúú xu̱kú tsí nijáñúú, xómáꞌ Abrám naxkúu̱n.<verse eid="GEN 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 15:12" />Ído̱ rí na̱tra̱ꞌmúu máꞌ a̱kha̱ꞌ, maphú me̱do̱ niꞌgu Abrám. Ra̱ꞌkhá-tháán nimíñuu̱ numuu rí nijmiyuu̱ rí neꞌne jína gakhe̱. <verse eid="GEN 15:12" /><verse number="13" style="v" sid="GEN 15:13" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ Mikhuíí niꞌthúun Abrám: «Gíꞌmaa ma̱thi̱yáá rí xa̱bia̱a̱ꞌ ma̱ju̱wá ná mbaa rí ra̱ꞌkháa mbañúu̱. Ikhín ma̱gu̱ma-ski̱ñúu̱ rí muñajuii̱n, jamí nikhuáa mi̱ndaꞌkho ma̱gu̱míi̱ mbá akho̱ siénto̱ tsigu. <verse eid="GEN 15:13" /><verse number="14" style="v" sid="GEN 15:14" />Xómáꞌ ikhúúnꞌ ma̱ne̱ rí mamínu̱u̱ꞌ xuajen ná rí ma̱gu̱míí nikhuáa xa̱bia̱a̱ꞌ. Jamí ma̱ne̱ rí ra̱ꞌkhá-tháán judee̱ rí máján, ído̱ rí ma̱ga̱jnáa̱ ikhín. <verse eid="GEN 15:14" /><verse number="15" style="v" sid="GEN 15:15" />Xómáꞌ ikháán rá, tsímáá gájáñaaꞌ jamí mi̱ꞌdíi̱n gajmiáaꞌ xa̱buanuu dríga̱a̱ꞌ ído̱ rí ma̱ꞌkhi̱ín guéñíí. <verse eid="GEN 15:15" /><verse number="16" style="v" sid="GEN 15:16" />Jamí ído̱ gánújngoo akho̱ siénto̱ tsigu<note caller="+" style="f"><char style="fr" closed="false">15.16 </char><char style="ft" closed="false">Ná ajngáa ebréo̱ a̱jma̱ ju̱ma̱ gíꞌdoo ajngáa rí naꞌthán «generación» ná xtíloo. Mbá rí naꞌthán numuu nguátha̱ tsigu eꞌne nákhí ni̱gu̱maa mbáa xa̱bo̱ asndo rí na̱gu̱maa a̱dée. I̱mba̱a̱ rí naꞌthán ikhaa máꞌ ajngáa rúꞌkhue̱n ñajuun rí nanújngoo mbaꞌa tsigu.</char></note> ma̱guwáa̱nꞌ máꞌ xa̱bia̱a̱ꞌ ge̱jioꞌ, numuu rí asndo xúge̱ꞌ xóó máꞌ tsínújngoo-rámuu aꞌkhán rí none̱ xa̱bo̱ amorréo̱».<verse eid="GEN 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 15:17" />Ído̱ rí nijngúun máꞌ a̱kha̱ꞌ jamí neꞌne jína, a̱ꞌkhue̱n nikujmaa mbá iñúu agu naꞌne gúní ga̱jma̱á mbá aguu rondo̱ ngrigo̱-ranújngoo ná majiu̱ún xu̱kú tsí niwiꞌthá-jngiin. <verse eid="GEN 15:17" /><verse number="18" style="v" sid="GEN 15:18" />Nákhí mbiꞌi rúꞌkhue̱n Ana̱ꞌlóꞌ Mikhuíí ni̱gi̱ꞌdoo mbá awan ga̱jma̱á Abrám. Xáꞌnii niꞌthúu̱n: «Ikhiin xa̱bia̱a̱ꞌ ma̱xnu̱ú mbaa ríge̱ꞌ, asndo ná mañuu Ejípto̱ asndo ná mañuu mba̱a̱ rí mbiꞌyuu Éufra̱te̱s. <verse eid="GEN 15:18" /><verse number="19" style="v" sid="GEN 15:19" />Ma̱xnúu̱ xúgíí mbañúú xa̱bo̱ senéo̱, mbo̱ seneséo̱, mbo̱ kadmonéo̱, <verse eid="GEN 15:19" /><verse number="20" style="v" sid="GEN 15:20" />mbo̱ etéo̱, mbo̱ fereséo̱, mbo̱ refaíta̱, <verse eid="GEN 15:20" /><verse number="21" style="v" sid="GEN 15:21" />mbo̱ amorréo̱, mbo̱ kananéo̱, mbo̱ jerjeséo̱ jamí mbo̱ jebuséo̱».<verse eid="GEN 15:21" /></para>
  <chapter eid="GEN 15" />
  <chapter number="16" style="c" sid="GEN 16" />
  <para style="s">Agár ga̱jma̱á Ismaél</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1" />Saraí a̱ꞌgui̱i̱ Abrám na̱nguá i̱gu̱mii i̱ji̱i̱n ga̱jmáa̱ a̱jmbaa̱. Ikhaa̱ gíꞌdaa̱ mbáa yumbáá a̱ꞌgo̱ tsí na̱ꞌkha̱ ná Ejípto̱ mbiꞌyuu Agár. <verse eid="GEN 16:1" /><verse number="2" style="v" sid="GEN 16:2" />A̱ꞌkhue̱n rí Saraí niꞌthúun Abrám: «Nathayáá máꞌ rí Ana̱ꞌlóꞌ Mikhuíí niniñi̱ꞌ rí ma̱xágúꞌdiin i̱ji̱nꞌ. Ikhaa jngó na̱tha̱n-jáñaaꞌ rí me̱no̱ꞌ ga̱jma̱a̱ꞌ yumbéꞌ. Gáꞌne xí ma̱goo ma̱gúꞌdiin i̱ji̱i̱n ikhaa̱».</para>
  <para style="p" vid="GEN 16:2">A̱ꞌkhue̱n rí Abrám neꞌne-mbánuu rí niꞌthán Saraí. <verse eid="GEN 16:2" /><verse number="3" style="v" sid="GEN 16:3" />Ído̱ naꞌne máꞌ gu̱wa̱ꞌ tsigu rí xtáa Abrám ná mbaa Kanaán, Saraí ni̱ꞌkha̱ jayáa̱ yumbée̱ tsí na̱ꞌkha̱ ná Ejípto̱, jamí nixnáxi̱i̱ inuu Abrám rí ma̱ꞌne asndo xóo a̱ꞌgui̱i̱. <verse eid="GEN 16:3" /><verse number="4" style="v" sid="GEN 16:4" />A̱ꞌkhue̱n rí Abrám niꞌgu ga̱jmáa̱, jamí nigo̱-édee̱. Ído̱ ndiꞌyoo Agár rí jago̱-éda, a̱ꞌkhue̱n rí nánguá iya-makuu̱ ña̱ꞌñii̱. <verse eid="GEN 16:4" /><verse number="5" style="v" sid="GEN 16:5" />A̱ꞌkhue̱n Saraí niꞌthúun Abrám:</para>
  <para style="p" vid="GEN 16:5">―Aꞌkháanꞌ ikháán rí tsíya-makui̱ꞌ yumbéꞌ rá. Ikhúúnꞌ máꞌ ni̱xna̱xáa̱ꞌ rí ma̱ꞌne a̱ꞌgia̱a̱ꞌ, jamí ído̱ ndiꞌyoo̱ rí jago̱-édee̱ nánguá iya-makui̱ꞌ. Ana̱ꞌlóꞌ Mikhuíí gára̱jua̱ꞌ ga̱jma̱á numalóꞌ.<verse eid="GEN 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 16:6" />Xómáꞌ Abrám niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 16:6">―Ná ñawáanꞌ xtáa yumbiáaꞌ. Athane̱ ga̱jma̱á nindxu̱u̱ xómá eꞌne a̱kia̱a̱nꞌ.</para>
  <para style="p" vid="GEN 16:6">A̱ꞌkhue̱n rí Saraí naꞌne rí mamínu̱u̱ꞌ Agár, ikhaa jngó nigáyuu̱ ni̱ke̱e̱. <verse eid="GEN 16:6" /><verse number="7" style="v" sid="GEN 16:7" />A̱ꞌkhue̱n rí Ánje̱l drígo̱o̱ Ana̱ꞌlóꞌ Mikhuíí nixkama̱a̱ ná mbaa niníí, ná mijngi ꞌgí iduu iya, ná jamba̱a̱ rí na̱ka̱ ná Súr. <verse eid="GEN 16:7" /><verse number="8" style="v" sid="GEN 16:8" />A̱ꞌkhue̱n niꞌthúu̱n:</para>
  <para style="p" vid="GEN 16:8">―Agár, tsáán ñajuaanꞌ yumbée Saraí, náá idxa̱ꞌ ikháán rá, jamí náá idxo̱ꞌ róꞌ.</para>
  <para style="p" vid="GEN 16:8">A̱ꞌkhue̱n niriꞌña̱a̱ ikhaa̱:</para>
  <para style="p" vid="GEN 16:8">―Na̱ga̱yúꞌ inuu Saraí, nána̱ tsí naꞌthán-ñájui̱nꞌ.<verse eid="GEN 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 16:9" />Xómáꞌ Ánje̱l drígo̱o̱ Ana̱ꞌlóꞌ Mikhuíí niꞌthúu̱n:</para>
  <para style="p" vid="GEN 16:9">―A̱tanga̱án ná inuu̱, jamí atatsíñá-mina̱ꞌ rí maꞌthán-ñájuaa̱nꞌ.<verse eid="GEN 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 16:10" />Jamí waꞌtháa̱n xóó neꞌne Ánje̱l:</para>
  <para style="q" vid="GEN 16:10">«Ma̱ne̱ rí ma̱mi̱diúún mi̱ndaꞌkho xa̱bia̱a̱ꞌ,</para>
  <para style="q" vid="GEN 16:10">rí asndo ma̱xáꞌngo̱o̱ ma̱gi̱xnuu̱ rí mbaꞌii̱n.<verse eid="GEN 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="GEN 16:11" />Xta-éda, ma̱tha̱ne̱ ku̱maa mbáa a̱ꞌdeáaꞌ,</para>
  <para style="q" vid="GEN 16:11">jamí ma̱ra̱xna̱ mbiꞌyuu̱ Ismaél,</para>
  <para style="q" vid="GEN 16:11">numuu rí Ana̱ꞌlóꞌ Mikhuíí niꞌdxuun rí xtaa nathamíni̱í.<verse eid="GEN 16:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="GEN 16:12" />Ikhaa̱ ma̱nindxu̱u̱ mbáa xa̱bo̱ namangu̱u̱ꞌ,</para>
  <para style="q" vid="GEN 16:12">jamí ikhaa̱ ma̱ꞌne gajmíi̱ xúgíin,</para>
  <para style="q" vid="GEN 16:12">xúꞌkhue̱n máꞌ xúgíin mone̱ gajmíi̱ ikhaa̱,</para>
  <para style="q" vid="GEN 16:12">jamí ma̱xtáa̱ janíí inúú xúgíin a̱ngui̱i̱n».<verse eid="GEN 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 16:13" />A̱ꞌkhue̱n rí Agár nixnúu̱ mbiꞌyuu Ana̱ꞌlóꞌ Mikhuíí tsí nindxákuu̱n ga̱jmáa̱ «Ikháán ñajuaanꞌ Anu̱ꞌ Mikhuíí tsí ndaꞌyoo», numuu rí niꞌthán-mine̱e̱ꞌ: «Á ra̱ꞌkhá ge̱jioꞌ ndi̱yo̱o̱ tsí ndaꞌye̱ꞌ rá». <verse eid="GEN 16:13" /><verse number="14" style="v" sid="GEN 16:14" />Ikhaa jngó iduu iya neꞌne mbiꞌyuu «Iduu iya Mbo̱ Ndaꞌya jamí Ndaꞌye̱ꞌ». Iduu iya rúꞌkhue̱n ꞌgí ná majiu̱u̱nꞌ Káde̱s ga̱jma̱á Beréd.<verse eid="GEN 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 16:15" />A̱ꞌkhue̱n rí Agár neꞌne ku̱maa̱ a̱dée Abrám. Xómáꞌ Abrám nixná mbiꞌyuu̱ Ismaél. <verse eid="GEN 16:15" /><verse number="16" style="v" sid="GEN 16:16" />Jamí Abrám gíꞌdoo akho̱ skíñú majuun (86) tsiguu̱, ído̱ rí Agár neꞌne ku̱maa Ismaél.<verse eid="GEN 16:16" /></para>
  <chapter eid="GEN 16" />
  <chapter number="17" style="c" sid="GEN 17" />
  <para style="s">Awan rí ni̱gi̱ꞌdoo Ana̱ꞌlóꞌ ga̱jma̱á Abrám</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1" />Abrám gíꞌdoo akho̱ skíñú gu̱wa̱ꞌ-nítsu i̱kho̱ (99) tsiguu̱, ído̱ nikujmaa Ana̱ꞌlóꞌ Mikhuíí inuu̱ jamí waꞌtháa̱n:</para>
  <para style="p" vid="GEN 17:1">―Ikhúúnꞌ ñaju̱nꞌ Ana̱a̱ꞌ Mikhuíí tsí Gíꞌdoo Xúgíí Tsiakhe̱. Ga̱ꞌne mbá jmbu a̱kia̱a̱nꞌ rí ma̱ra̱xtaa ná inu̱ꞌ. <verse eid="GEN 17:1" /><verse number="2" style="v" sid="GEN 17:2" />Ikhúúnꞌ ma̱gúꞌdo̱ꞌ mbá awan ga̱jma̱á nindxa̱a̱ꞌ, jamí ma̱ne̱ rí ma̱mi̱diúún guéño xa̱bia̱a̱ꞌ.<verse eid="GEN 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 17:3" />A̱ꞌkhue̱n rí Abrám nismáti̱go̱o̱ niꞌgí inuu asndo mbayíí, jamí Ana̱ꞌlóꞌ niꞌthán xóó:<verse eid="GEN 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 17:4" />―Ríge̱ꞌ ñajuun awan rí nagúꞌdo̱ꞌ ga̱jma̱á nindxa̱a̱ꞌ, rí ikháán ma̱nindxa̱a̱ꞌ anu̱ú xa̱bo̱ tsí mbaꞌa inúú. <verse eid="GEN 17:4" /><verse number="5" style="v" sid="GEN 17:5" />Jamí ná-xáꞌne mbiꞌyaaꞌ Abrám rá, rí xúge̱ꞌ ma̱ꞌne mbiꞌyaaꞌ Abraám, numuu rí ikhúúnꞌ ni̱ꞌgíín rí ma̱nindxa̱a̱ꞌ anu̱ú xa̱bo̱ tsí mbaꞌa inúú. <verse eid="GEN 17:5" /><verse number="6" style="v" sid="GEN 17:6" />Ma̱ne̱ rí ma̱mi̱diúún guéño xa̱bia̱a̱ꞌ, jamí ná majia̱a̱nꞌ máꞌ ikháán ma̱gu̱ma xuajen mba̱ꞌo̱ xúꞌkhue̱n máꞌ ma̱ga̱jnúú thúngaa mba̱ꞌu̱u̱n. <verse eid="GEN 17:6" /><verse number="7" style="v" sid="GEN 17:7" />Jamí na̱ꞌgílo̱ꞌ awan ga̱jma̱á nindxa̱a̱ꞌ ikháán, xúꞌkhue̱n máꞌ xa̱bia̱a̱ꞌ tsí ma̱guwá inaaꞌ, mangaa máꞌ xa̱bíi̱n ikhii̱n, rí jámuu ñajuun awan ríge̱ꞌ. Ikhúúnꞌ ma̱nindxu̱ꞌ Ana̱a̱ꞌ Mikhuíí, jamí xúꞌkhue̱n máꞌ Anu̱ú mangiin xa̱bia̱a̱ꞌ tsí ma̱gu̱mii nda̱wa̱á. <verse eid="GEN 17:7" /><verse number="8" style="v" sid="GEN 17:8" />Jamí ma̱xna̱a̱ꞌ ikháán, xúꞌkhue̱n máꞌ mangiin xa̱bia̱a̱ꞌ tsí ma̱guwá inaaꞌ, mbaa ná ngraꞌaaꞌ, mbá xúgíí mbayuu Kanaán, rí jámuu magóó ra̱ya̱xíi̱ ne̱, jamí ikhúúnꞌ ma̱nindxu̱ꞌ Anúu̱.<verse eid="GEN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 17:9" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ niꞌthúun mbu̱júu Abraám:</para>
  <para style="p" vid="GEN 17:9">―Xómáꞌ ikháán rá, ma̱tha̱ne̱-mbáníí awan drígo̱ꞌ, xúꞌkhue̱n máꞌ mone̱-mbáníí xa̱bia̱a̱ꞌ tsí ma̱guwá inaaꞌ, mangiin máꞌ xa̱bo̱ ri̱jiúu̱n. <verse eid="GEN 17:9" /><verse number="10" style="v" sid="GEN 17:10" />Jamí ríge̱ꞌ ñajuun awan drígo̱ꞌ rí ma̱tha̱ne̱-mbáníí ikháán, xúꞌkhue̱n máꞌ mone̱-mbáníí xa̱bia̱a̱ꞌ nda̱wa̱á: Mbá xúgíin xa̱bekha rí ikháa̱nꞌlaꞌ gíꞌmaa mu̱guaꞌdáálaꞌ tsina-jndi. <verse eid="GEN 17:10" /><verse number="11" style="v" sid="GEN 17:11" />Tsina-jndi ñajuun rí mo̱thon-rígú xtóo idxu̱u̱ xuyalaꞌ, jamí ikhaa ríge̱ꞌ ñajuun rí masngájma awan rí nawanálóꞌ. <verse eid="GEN 17:11" /><verse number="12" style="v" sid="GEN 17:12" />Mbámbáa xa̱biya̱ tsí ikháa̱nꞌlaꞌ gíꞌmaa ma̱gi̱ꞌdoo tsina-jndi ído̱ gáꞌne migiñuu mbiꞌi rí ni̱gu̱maa, xúꞌkhue̱n máꞌ mo̱ne̱laꞌ asndo jámuu mbiꞌi. Ikhaa máꞌ gágu̱máá tsí ni̱gu̱maa guꞌwáá, xúꞌkhue̱n máꞌ mangaa tsí ra̱ꞌkháa xa̱bia̱a̱ꞌ tsí niratsi̱i̱ ga̱jma̱á mbúkha̱a̱ꞌ inuu xa̱bo̱ tsí na̱ꞌkha̱ i̱mba̱ xuajen. <verse eid="GEN 17:12" /><verse number="13" style="v" sid="GEN 17:13" />Gíꞌmaa ma̱gi̱ꞌdoo tsina-jndi tsí ni̱gu̱maa ná guꞌwáaꞌ, jamí xúꞌkhue̱n máꞌ tsí waꞌtsi̱i̱ ga̱jma̱á mbúkha̱a̱. Xkuaꞌnii nawanúu awan drígo̱ꞌ ná xuyalaꞌ rí awan jámuu mbiꞌi ñajuun. <verse eid="GEN 17:13" /><verse number="14" style="v" sid="GEN 17:14" />Jamí xa̱biya̱ tsí ra̱gíꞌdoo tsina-jndi, tsí tóthon-rígú xtóo idxu̱u̱ xuyuu, ikhaa xa̱bo̱ tsúꞌkhue̱n mi̱xkriya̱a̱ꞌ awúun xuajiuun, numuu rí táꞌne-mbánuu̱ awan drígo̱ꞌ.<verse eid="GEN 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 17:15" />Ana̱ꞌlóꞌ niꞌthúun xóó Abraám:</para>
  <para style="p" vid="GEN 17:15">―Tsí a̱ꞌgia̱a̱ꞌ, ná-xáꞌne mbiꞌyuu̱ Saraí, rí Sára̱ gáꞌne mbiꞌyuu̱ xúge̱ꞌ rá. <verse eid="GEN 17:15" /><verse number="16" style="v" sid="GEN 17:16" />Ma̱ne̱ tsakun-rámaa̱, jamí ma̱ne̱ rí ikhaa̱ ma̱ꞌne ku̱maa̱ mbáa a̱ꞌdeáaꞌ. Phú gakon rí ma̱ne̱ tsakun-rámaa̱, rí asndo ikhaa̱ ma̱nindxu̱u̱ ru̱dúún xa̱bo̱ xuajen mba̱ꞌo̱, jamí ná inuu̱ ikhaa̱ ma̱ga̱jnúú thúngaa tsí mba̱ꞌu̱u̱n.<verse eid="GEN 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 17:17" />A̱ꞌkhue̱n rí Abraám nismáti̱go̱o̱ rí niꞌgí inuu asndo mbayíí, jamí ninduꞌwée̱ rí nindxaꞌwá-mine̱e̱ꞌ: «Mbáa xa̱biya̱ tsí gíꞌdoo witsu skíñú (100) tsiguu ma̱gu̱maa mbáa a̱dée ráꞌ. Jamí Sára̱, gíꞌdoo máꞌ akho̱ skíñú gu̱wa̱ꞌ (90) tsiguu, mago̱-éda ja ráꞌ». <verse eid="GEN 17:17" /><verse number="18" style="v" sid="GEN 17:18" />A̱ꞌkhue̱n Abraám niꞌthúun Ana̱ꞌlóꞌ:</para>
  <para style="p" vid="GEN 17:18">―Rí phú máján xí ma̱gaaꞌ ma̱xtáa mújúun Ismaél ná inaaꞌ no rá.<verse eid="GEN 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 17:19" />A̱ꞌkhue̱n niriꞌña̱a̱ Ana̱ꞌlóꞌ:</para>
  <para style="p" vid="GEN 17:19">―Gakon rí a̱ꞌgia̱a̱ꞌ ma̱ꞌne ku̱maa mbáa a̱ꞌdeáaꞌ, jamí ma̱ra̱xna̱ mbiꞌyuu̱ Isaák. Ikhaa̱ ma̱gúꞌdo̱ꞌ ga̱jme̱ꞌ awan, rí jámuu ma̱ri̱gá awan rúꞌkhue̱n ga̱jma̱á nindxu̱ún xa̱bi̱i̱ tsí ma̱gu̱mii nda̱wa̱á. <verse eid="GEN 17:19" /><verse number="20" style="v" sid="GEN 17:20" />Mangaa ni̱dxawuun máꞌ ajngáaꞌ ga̱jma̱á numuu Ismaél. Ikhaa jngó ma̱ne̱ tsakun-rámaa̱, jamí ma̱ne̱ rí ma̱mi̱diúún guéño xa̱bi̱i̱, xúꞌkhue̱n máꞌ ma̱ꞌne mbaꞌii̱n mi̱ndaꞌkho. Ma̱nindxu̱u̱ anu̱ú tsí mbá gue̱jmi̱i̱ xa̱bo̱ ede̱, jamí ma̱ne̱ mbá xuajen rí phú mba̱a̱ ga̱jma̱á nindxu̱u̱. <verse eid="GEN 17:20" /><verse number="21" style="v" sid="GEN 17:21" />I̱ndo̱ó máꞌ Isaák rá, tsí ma̱ꞌne ku̱maa Sára̱ xíríga̱á rí i̱mba̱ tsígu, tsúꞌkhue̱n ma̱gúꞌdo̱ꞌ awan ga̱jma̱á nindxu̱u̱.<verse eid="GEN 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 17:22" />Ído̱ rí wámbo̱o̱ Ana̱ꞌlóꞌ nindxákuun ga̱jma̱á Abraám, a̱ꞌkhue̱n rí ni̱ka̱a̱. <verse eid="GEN 17:22" /><verse number="23" style="v" sid="GEN 17:23" />A̱ꞌkhue̱n rí Abraám ndiyáa Ismaél, jamí mbá xúgíin yumbáá tsí ni̱gu̱mii ná goꞌóo̱, xúꞌkhue̱n máꞌ mbá xúgíin yumbáá tsí niꞌtsi̱i̱n ga̱jma̱á mbúkha̱a̱, mbá xúgíin máꞌ xa̱bekha tsí júwá ná goꞌóo̱, a̱ꞌkhue̱n rí nixnúu̱ tsina-jndi. Ikhaa máꞌ mbiꞌi rúꞌkhue̱n ni̱ru̱thii̱n xtóo idxu̱u̱ xuñúu̱, xómáꞌ waꞌtháa̱n neꞌne Ana̱ꞌlóꞌ. <verse eid="GEN 17:23" /><verse number="24" style="v" sid="GEN 17:24" />Akho̱ skíñú gu̱wa̱ꞌ-nítsu i̱kho̱ (99) tsiguu Abraám ído̱ rí ni̱gi̱ꞌdoo tsina-jndi. <verse eid="GEN 17:24" /><verse number="25" style="v" sid="GEN 17:25" />Xómáꞌ Ismaél gíꞌdoo mbá gue̱tso̱ (13) tsiguu, ído̱ rí ni̱gi̱ꞌdoo tsina-jndi. <verse eid="GEN 17:25" /><verse number="26" style="v" sid="GEN 17:26" />Mbóó máꞌ mbiꞌi rúꞌkhue̱n Abraám ga̱jma̱á Ismaél niguaꞌdáá tsina-jndi. <verse eid="GEN 17:26" /><verse number="27" style="v" sid="GEN 17:27" />Mbá xúgíin xa̱bekha tsí júwá ná goꞌóo̱ niguaꞌdáá tsina-jndi ga̱jma̱á nindxu̱u̱ Abraám. Ikhaa máꞌ ni̱gi̱ꞌdoo yumbáá tsí ni̱gu̱maa ná goꞌóo̱, xúꞌkhue̱n máꞌ tsí waꞌtsi̱i̱ ga̱jma̱á mbúkha̱a̱ inuu xa̱bo̱ tsí na̱ꞌkha̱ i̱mba̱ xuajen.<verse eid="GEN 17:27" /></para>
  <chapter eid="GEN 17" />
  <chapter number="18" style="c" sid="GEN 18" />
  <para style="s">Ana̱ꞌlóꞌ naxuda-mina̱ꞌ rí ma̱gu̱maa Isaák</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1" />Nda̱wa̱á nikujmaa Ana̱ꞌlóꞌ Mikhuíí ná ríga̱ xta̱maña̱ꞌ drígo̱o̱ Mámre̱. Ikhín máꞌ ꞌgí Abraám mbá wakha̱ꞌ wáa ná rawuun guꞌwá xtíin drígo̱o̱. <verse eid="GEN 18:1" /><verse number="2" style="v" sid="GEN 18:2" />A̱ꞌkhue̱n rí niyaxe̱ Abraám, jamí ndiꞌñúu̱ atsúun xa̱buanuu wájun jri̱doo ná ꞌgíi̱ꞌ ikhaa̱. Ído̱ ndiꞌñúu̱, nigájnuu̱-ragáyuu̱ gágrui̱gúu̱n, jamí nismáti̱go̱o̱ rí niꞌgíi̱ inuu̱ asndo mbayíí. <verse eid="GEN 18:2" /><verse number="3" style="v" sid="GEN 18:3" />A̱ꞌkhue̱n niꞌthúu̱n:<note caller="+" style="f"><char style="fr" closed="false">18.3 </char><char style="ft" closed="false">Abraám naꞌthúun jmína̱a̱ꞌ Ana̱ꞌlóꞌ, numuu rí ánje̱l ñajúún tsí i̱jmi̱i̱, xó iꞌthán ná 19.1.</char></note></para>
  <para style="p" vid="GEN 18:3">―Táta̱, athane̱ mba̱a̱ a̱kia̱a̱nꞌ. Na̱tha̱n-jáñaaꞌ rí ma̱xídxú xóó. <verse eid="GEN 18:3" /><verse number="4" style="v" sid="GEN 18:4" />Ma̱ꞌkha̱ jiꞌyá xúge̱ꞌ mbá lájuíin iya rí mu̱jiáa̱n nakhuálaꞌ, xúꞌkhue̱n máꞌ gu̱ya̱a̱ xa̱ꞌlaꞌ ná agoo ixe̱ ge̱e̱. <verse eid="GEN 18:4" /><verse number="5" style="v" sid="GEN 18:5" />Numuu rí nanújnga-málaꞌ mijngi ná xtáá rá, ikhaa jngó ma̱ꞌkha-ja̱yo̱ꞌ tháan rí mo̱pholaꞌ rí mbu̱ya̱a̱laꞌ tsiakhe̱. Nda̱wa̱á a̱ꞌkhue̱n gúꞌgualaꞌ.</para>
  <para style="p" vid="GEN 18:5">Xómáꞌ ikhii̱n ni̱ri̱ꞌñaa̱:</para>
  <para style="p" vid="GEN 18:5">―Máján, athane̱ máꞌ xóo rí nirathán.<verse eid="GEN 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 18:6" />A̱ꞌkhue̱n rí mbá nacha̱ ni̱ka̱ Abraám ná guꞌwá xtíin ná kra̱ꞌaa Sára̱, jamí niꞌthúu̱n: «Mbá nacha̱ gátha̱ne̱-ꞌxíí mbá atsú khiáwan arína̱ rí máján, xúꞌkhue̱n máꞌ ma̱tha̱ne̱ gumuu ne̱ ná madíí».<verse eid="GEN 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 18:7" />Xúꞌkhue̱n máꞌ mbá nacha̱ ni̱ka̱ Abraám ná gatiin xede̱, jamí nigatuwii̱n mbáa a̱ꞌdá-xédé rudii tsí májáan wáa, jamí nixnáxu̱u̱ yumbée̱ rí ma̱ꞌne májáa̱nꞌ mbá nacha̱. <verse eid="GEN 18:7" /><verse number="8" style="v" sid="GEN 18:8" />A̱ꞌkhue̱n rí ni̱ꞌkha̱ jagu̱u̱ yaꞌdú ga̱jma̱á a̱ꞌdá-xédé tsí ni̱gu̱ma-májáan máꞌ, jamí nistrámee̱ ne̱ inúú xa̱buanuu. Xómáꞌ ikhaa̱ wíji̱i̱ mijngi ná agoo ixe̱ ído̱ rí napiꞌtsii̱. <verse eid="GEN 18:8" /><verse number="9" style="v" sid="GEN 18:9" />A̱ꞌkhue̱n ni̱ra̱xíi̱ Abraám:</para>
  <para style="p" vid="GEN 18:9">―Náá xtáa a̱ꞌgia̱a̱ꞌ róꞌ.</para>
  <para style="p" vid="GEN 18:9">Xómáꞌ ikhaa̱ niriꞌñee̱:</para>
  <para style="p" vid="GEN 18:9">―Awúun máꞌ guꞌwá xtíin a̱ꞌkhue̱n kra̱ꞌaa̱.<verse eid="GEN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 18:10" />A̱ꞌkhue̱n rí mbáa tsúꞌkhue̱n niꞌthán:</para>
  <para style="p" vid="GEN 18:10">―Gakon rí ma̱tangu̱ún gáya̱a̱ꞌlo̱ꞌ xíríga̱á rí i̱mba̱-tsígu. A̱ꞌkhue̱n rí a̱ꞌgia̱a̱ꞌ gíꞌdaa máꞌ mbáa ada̱. <figure style="fig" alt="Sara oye adentro" file="CO00655B.TIF" size="span" loc="18.9-10" ref="18.10">Nadxawuun nána̱ nikhi̱i̱ Sára̱ rí ma̱gi̱ꞌdaa̱ a̱dée̱.</figure></para>
  <para style="p" vid="GEN 18:10">Xómáꞌ Sára̱ wéje̱ nadxawuun ná rawuun guꞌwá xtíin, ná tsu̱du̱u̱ mbo̱ naꞌthán. <verse eid="GEN 18:10" /><verse number="11" style="v" sid="GEN 18:11" />Abraám ga̱jma̱á Sára̱ xa̱buanuu guéño máꞌ ñajúu̱n, xúꞌkhue̱n máꞌ Sára̱ nánguá iꞌkhu̱u̱ awúu̱n xómá rí nagíꞌníí go̱ꞌo̱. <verse eid="GEN 18:11" /><verse number="12" style="v" sid="GEN 18:12" />Ikhaa jngó ninduꞌwá Sára̱ ná awúun a̱kui̱i̱n rí nindxaꞌwá-mine̱e̱ꞌ: «Á ma̱gúꞌdo̱ꞌ gagi rí nikhiu̱ún guéño, xí táta̱ nikhi̱i̱ máꞌ mangaa rá».<verse eid="GEN 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 18:13" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ Mikhuíí niꞌthúun Abraám:</para>
  <para style="p" vid="GEN 18:13">―Náá numuu jngó ninduꞌwá Sára̱ rí niꞌthée̱n: “Á gakon rí ma̱ne̱ xuajiin rí nikhiu̱ún guéño máꞌ rá”. <verse eid="GEN 18:13" /><verse number="14" style="v" sid="GEN 18:14" />Á ríga̱ rí mingíjiúu inu̱ꞌ ikhúúnꞌ rá dxe̱ꞌ. Ma̱tangu̱ún máꞌ ma̱ꞌkha gáya̱a̱ꞌlo̱ꞌ, ikhaa máꞌ mbiꞌi rí ni̱tha̱a̱nꞌ, xíríga̱á rí i̱mba̱ tsígu. Sára̱ gíꞌdaa máꞌ ada̱ xúꞌkhue̱n rá.<verse eid="GEN 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 18:15" />Numuu rí nimíñuu Sára̱, ikhaa jngó neꞌne-nduwee̱:</para>
  <para style="p" vid="GEN 18:15">―Tándu̱ꞌwa̱ jún.</para>
  <para style="p" vid="GEN 18:15">Xómáꞌ Ana̱ꞌlóꞌ niꞌthán:</para>
  <para style="p" vid="GEN 18:15">―Ra̱gákon. Nitanduꞌwá ján.<verse eid="GEN 18:15" /></para>
  <para style="s">Abraám naꞌthán-mbáá ga̱jma̱á numuu Sodóma̱</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16" />A̱ꞌkhue̱n rí xa̱buanuu niguáxo̱n rí magóó ná giaxu̱u̱ Sodóma̱. Xúꞌkhue̱n máꞌ na̱ka̱ tháan Abraám gajmíi̱ rí maꞌthán-ngawúu̱n. <verse eid="GEN 18:16" /><verse number="17" style="v" sid="GEN 18:17" />Xómáꞌ Ana̱ꞌlóꞌ Mikhuíí niꞌthán: «Á ma̱rkaꞌuu Abraám rí xtáá ma̱ne̱ rá. <verse eid="GEN 18:17" /><verse number="18" style="v" sid="GEN 18:18" />Numuu rí ikhaa Abraám ma̱nindxu̱u̱ mbá xuajen mba̱a̱ jamí gakhi̱i̱. Xúꞌkhue̱n máꞌ ná majiu̱u̱nꞌ ikhaa̱ ma̱gu̱ma-tsakun-ráma mbá xúgíí xuajen inuu numba̱a̱. <verse eid="GEN 18:18" /><verse number="19" style="v" sid="GEN 18:19" />Numuu rí ikhúúnꞌ nda̱yo̱ rí maxná-ñájuu̱n i̱ji̱i̱n jamí mbá xúgíin tsí ma̱gu̱mii nda̱wa̱á rí ma̱ju̱wée̱ꞌ ná jambo̱ꞌ ikhúúnꞌ, jamí muni̱i̱ rí máján ga̱jma̱á rí jmbu. Ikhaa jngó xkuaꞌnii ma̱ne̱-mbánuu rí ni̱xu̱ꞌdá-mina̱ꞌ ga̱jma̱á nindxu̱u̱».<verse eid="GEN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 18:20" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ Mikhuíí niꞌthúun Abraám:</para>
  <para style="p" vid="GEN 18:20">―I̱tha̱n nanújngoo-rámuu rí nawán numúú xa̱bo̱ Sodóma̱ ga̱jma̱á Gomórra̱, xúꞌkhue̱n máꞌ aꞌkhán rí na̱xu̱da̱ꞌ-mi̱jne̱e̱ rí phú neꞌne mba̱a̱ mi̱ndaꞌkho ne̱. <verse eid="GEN 18:20" /><verse number="21" style="v" sid="GEN 18:21" />Ikhaa jngó ma̱gátáá xúge̱ꞌ mba̱yo̱o̱ xí gakon rí nuni̱i̱ guéño aꞌkhán xóo rí ni̱dxawuun. Xí na̱nguá máꞌ mbo̱ꞌ, mba̱yo̱o̱ máꞌ mangaa.<verse eid="GEN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 18:22" />A̱ꞌkhue̱n nigájnúú xa̱buanuu magóó ná Sodóma̱. Xómáꞌ Abraám rá, niwanúu̱ xóó ná inuu Ana̱ꞌlóꞌ Mikhuíí. <verse eid="GEN 18:22" /><verse number="23" style="v" sid="GEN 18:23" />A̱ꞌkhue̱n rí Abraám nixuꞌma-mina̱ꞌ i̱tháan ná inuu̱, jamí niꞌthúu̱n:</para>
  <para style="p" vid="GEN 18:23">―Á ma̱tha̱ne̱ gámba̱a̱ꞌ tsí májáan ga̱jma̱á tsí ra̱májáan mangaa rá. <verse eid="GEN 18:23" /><verse number="24" style="v" sid="GEN 18:24" />Gáꞌne xí júwa̱ꞌ a̱jma̱ skíñú gu̱wi̱inꞌ (50) xa̱bo̱ tsí májíin ná awúun xuajen. Á ma̱tha̱ne̱ gámba̱a̱ꞌ ne̱ rá. Á ma̱xátha̱ne̱-lá mba̱a̱ a̱kia̱a̱nꞌ xtayáá xuajen, numuu rí nañáwíin a̱kia̱a̱nꞌ xtañúú tsí a̱jma̱ skíñú gu̱wi̱inꞌ rá. <verse eid="GEN 18:24" /><verse number="25" style="v" sid="GEN 18:25" />Ra̱jáꞌyoo rí ma̱tha̱ne̱ xkuaꞌnii, rí ma̱ja̱ñúu tsí májáan ga̱jma̱á tsí ra̱májáan, jamí ikhaa máꞌ gágu̱míi̱ ná-a̱jmi̱i̱. Ninguánáá ma̱tha̱ne̱ rí xkuaꞌnii ján. Ikháán tsáán naraꞌdáá awan numuu mbá xúgíí numba̱a̱, á ra̱ꞌkhá ma̱tra̱jua̱ꞌ jmbu ján rá dxe̱ꞌ.<verse eid="GEN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 18:26" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ Mikhuíí niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 18:26">―Xí ná xuajen Sodóma̱ ma̱xkamii a̱jma̱ skíñú gu̱wi̱inꞌ (50) tsí májíin, ma̱ne̱ mba̱a̱ a̱kui̱nꞌ ja̱yo̱o̱ mbá xúgíí xuajen, numuu rí nañáwíin a̱kui̱nꞌ ja̱ñúu̱.<verse eid="GEN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 18:27" />A̱ꞌkhue̱n Abraám niꞌthán:</para>
  <para style="p" vid="GEN 18:27">―Athane̱ mba̱a̱ a̱kia̱a̱nꞌ rí ma̱tha̱a̱nꞌ xóó, Táta̱ Mikhuíí, maske xóo yujnda̱ꞌ jamí idi-madi jaꞌñúúlo̱ꞌ. <verse eid="GEN 18:27" /><verse number="28" style="v" sid="GEN 18:28" />Gáꞌne xí mba̱ꞌñúú witsuun awúun tsí a̱jma̱ skíñú gu̱wi̱inꞌ tsí májíin rá. Á ma̱tha̱ne̱ gámba̱a̱ꞌ xúgíí xuajen ga̱jma̱á numúú tsí witsuun ndaꞌñúú rá.</para>
  <para style="p" vid="GEN 18:28">A̱ꞌkhue̱n Ana̱ꞌlóꞌ niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 18:28">―Ma̱xáne̱ gámba̱a̱ xí ma̱xkamii tsí a̱jma̱ skíñú witsuun (45).<verse eid="GEN 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 18:29" />Niꞌthán mbu̱júu Abraám:</para>
  <para style="p" vid="GEN 18:29">―Gáꞌne xí júwa̱ꞌ a̱jma̱ skíñúu̱ (40) rá.</para>
  <para style="p" vid="GEN 18:29">Xómáꞌ Ana̱ꞌlóꞌ niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 18:29">―Ma̱xáne̱ gámba̱a̱-málo̱ꞌ, numuu rí nañáwíin a̱kui̱nꞌ ja̱ñúú tsí a̱jma̱ skíñúu (40).<verse eid="GEN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 18:30" />A̱ꞌkhue̱n niꞌthán Abraám:</para>
  <para style="p" vid="GEN 18:30">―Ma̱xájiꞌnáá-lá, Táta̱ Mikhuíí, rí ma̱tha̱a̱nꞌ xóó. Gáꞌne xí júwa̱ꞌ ikhín mbá skíñú gu̱wi̱inꞌ (30) rá.</para>
  <para style="p" vid="GEN 18:30">Xómáꞌ Ana̱ꞌlóꞌ niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 18:30">―Ma̱xáne̱ gámba̱a̱-málo̱ꞌ xí ma̱xkamii tsí mbá skíñú gu̱wi̱inꞌ.<verse eid="GEN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 18:31" />Xómáꞌ Abraám niꞌthán:</para>
  <para style="p" vid="GEN 18:31">―Athane̱ mba̱a̱ a̱kia̱a̱nꞌ, Táta̱ Mikhuíí, rí ma̱tha̱a̱nꞌ xóó. Gáꞌne xí júwa̱ꞌ i̱ndo̱ó mbá skíñúu (20) rá.</para>
  <para style="p" vid="GEN 18:31">―Ma̱xáne̱ gámba̱a̱ numuu rí nañáwíin a̱kui̱nꞌ ja̱ñúú tsí mbá skíñúu ―niriꞌña̱a̱ Ana̱ꞌlóꞌ.<verse eid="GEN 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 18:32" />A̱ꞌkhue̱n niꞌthán xóó Abraám:</para>
  <para style="p" vid="GEN 18:32">―Ma̱xájiꞌnáá-lá, Táta̱ Mikhuíí, rí i̱mbo̱ó máꞌ gátha̱a̱nꞌ. Gáꞌne xí júwa̱ꞌ mbá gu̱wi̱inꞌ rá.</para>
  <para style="p" vid="GEN 18:32">―Ma̱xáne̱ gámba̱a̱ numuu rí nañáwíin a̱kui̱nꞌ ja̱ñúú tsí mbá gu̱wi̱inꞌ ―niriꞌña̱a̱ Ana̱ꞌlóꞌ.<verse eid="GEN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 18:33" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ Mikhuíí ni̱ka̱a̱, ído̱ rí wámbo̱o̱ nindxákuu̱n ga̱jmáa̱ Abraám. Xúꞌkhue̱n máꞌ Abraám nitanga̱a̱ ná xtáa.<verse eid="GEN 18:33" /></para>
  <chapter eid="GEN 18" />
  <chapter number="19" style="c" sid="GEN 19" />
  <para style="s">Ana̱ꞌlóꞌ naꞌne gámba̱a̱ Sodóma̱ ga̱jma̱á Gomórra̱</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1" />A̱ꞌkhue̱n tsí a̱jmi̱i̱ ánje̱l niguáꞌnú ná Sodóma̱ ído̱ na̱ka̱-raꞌne wakhíí. Xómáꞌ Lót ꞌgí ná na̱tu̱ꞌúún-múú xa̱bo̱ ná rawuun xuajen Sodóma̱. Ído̱ ndiꞌñúu̱ ni̱tu̱xu̱u̱ gágrui̱gúu̱n, jamí ni̱rnga̱du̱u̱n asndo mbayíí. <verse eid="GEN 19:1" /><verse number="2" style="v" sid="GEN 19:2" />A̱ꞌkhue̱n niꞌthúu̱n:</para>
  <para style="p" vid="GEN 19:2">―Táta̱, na̱nda̱ꞌa̱ꞌlaꞌ rí mu̱ꞌgua̱lóꞌ guꞌwáá, mbu̱ya̱a̱ xa̱ꞌlaꞌ jamí mu̱jiáa̱n la nakhuálaꞌ. Gátsíí miꞌcha̱ gáguaxu̱u̱nꞌlaꞌ rí mbu̱ya̱a̱ jamba̱a̱ mu̱ꞌgualaꞌ.</para>
  <para style="p" vid="GEN 19:2">Xómáꞌ ikhii̱n ni̱ri̱ꞌñaa̱:</para>
  <para style="p" vid="GEN 19:2">―Ma̱xúꞌguá-máxo̱ꞌ, ma̱waná-máxo̱ꞌ mbroꞌon ríge̱ꞌ ná rixa̱á ge̱jioꞌ.<verse eid="GEN 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 19:3" />Xómáꞌ ikhaa̱ niꞌthán-jáñúu̱ guéño, a̱ꞌkhue̱n rí nigóo̱ goꞌóo Lót. Ído̱ niguáꞌníi̱ ikhín neꞌne-mújúu̱n mbaꞌa rí máján rí mu̱phi̱i̱, xúꞌkhue̱n máꞌ nixúmbíi̱ guma rí tsíge̱xe̱, a̱ꞌkhue̱n rí nipiꞌtsii̱. <verse eid="GEN 19:3" /><verse number="4" style="v" sid="GEN 19:4" />Asndo xóó máꞌ túbúu̱n ído̱ ni̱ru̱ꞌwáá xa̱bo̱ xuajen guꞌwá. Xúgíin xa̱bekha mbo̱ Sodóma̱, rí asndo tsí jiáma jamí asndo tsí xi̱ꞌñú, mbá ꞌnduꞌ niguwée̱ꞌ. <verse eid="GEN 19:4" /><verse number="5" style="v" sid="GEN 19:5" />A̱ꞌkhue̱n rí ni̱ndxa̱ꞌwa̱-ri̱ya̱a̱ꞌ Lót jamí ni̱ra̱xíi̱:</para>
  <para style="p" vid="GEN 19:5">―Náá júwa̱ꞌ xa̱bekha tsí niguwá guꞌwáaꞌ mbroꞌon ríge̱ꞌ rá. Arawíi̱n, numuu rí mu̱ba̱ꞌ-gajmiáxo̱ꞌ.<verse eid="GEN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 19:6" />A̱ꞌkhue̱n rí Lót nigájnuu ná rawuun goꞌóo, jamí nacha̱ máꞌ nirugua̱a̱ rawuun xkrugua. <verse eid="GEN 19:6" /><verse number="7" style="v" sid="GEN 19:7" />A̱ꞌkhue̱n niꞌthúu̱n:</para>
  <para style="p" vid="GEN 19:7">―Na̱tha̱n-jáñalaꞌ, a̱ngui̱nꞌ, rí ma̱xúne̱laꞌ rúꞌkhue̱n, rí xkawe̱ꞌ guéño. <verse eid="GEN 19:7" /><verse number="8" style="v" sid="GEN 19:8" />Gúꞌdiin a̱jmi̱i̱ i̱ji̱nꞌ tsí go̱ꞌo̱ tsí xóó túno gajmíí xa̱bekha. Ma̱gúwíi̱nlo̱ꞌ inalaꞌ rí mo̱ne̱laꞌ náá rí eyalaꞌ ga̱jma̱á nindxúu̱n. I̱ndo̱ó máꞌ xa̱bekha tsíge̱ꞌ, ma̱xúñu̱úlaꞌ nimbá, numuu rí niguwée̱ꞌ mbuya̱a̱ xúu̱nꞌ ná goꞌóꞌ.<verse eid="GEN 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 19:9" />Xómáꞌ ikhii̱n ni̱ri̱ꞌñaa̱:</para>
  <para style="p" vid="GEN 19:9">―¡Araxo̱n janíí a̱ꞌkhue̱n! ―Mangaa nithee̱n xóó―: Ikháán tsáán nidxa̱ꞌ janíí rí ma̱ra̱xtaa ga̱jma̱á nindxa̱ꞌxo̱ꞌ, ma̱ra̱tha̱n-ñájuanxo̱ꞌ ján ráꞌ. Jngó xúge̱ꞌ rá, mu̱ña̱a̱ꞌxo̱ꞌ i̱tha̱n nikhuáa xóo rí xa̱bo̱ tsúꞌkhue̱n.</para>
  <para style="p" vid="GEN 19:9">A̱ꞌkhue̱n rí ni̱dráꞌii̱n inuu Lót rí muxnáa̱, jamí na̱tu̱múu̱ rí mu̱xpi̱gui̱i̱ꞌ xkrugua. <verse eid="GEN 19:9" /><verse number="10" style="v" sid="GEN 19:10" />A̱ꞌkhue̱n ni̱ka̱ ñawúún xa̱bekha, jamí ni̱xma̱ngua̱ꞌa̱a̱n Lót ná guꞌwáá, xúꞌkhue̱n máꞌ ni̱rugua̱a̱ xkrugua. <verse eid="GEN 19:10" /><verse number="11" style="v" sid="GEN 19:11" />Jamí nini̱i̱ rí ma̱mbadúún xa̱bo̱ tsí wájun ná rawuun guꞌwáá, jiáma jamí asndo tsí xi̱ꞌñú. Xkuaꞌnii neꞌne rí niskúu̱n ndiꞌyáa̱ꞌ rawuun guꞌwá. <verse eid="GEN 19:11" /><verse number="12" style="v" sid="GEN 19:12" />A̱ꞌkhue̱n rí xa̱bekha tsúꞌkhue̱n nitháán Lót:</para>
  <para style="p" vid="GEN 19:12">―Náá tsí xóó a̱ngia̱a̱nꞌ xtaꞌdiin ge̱jioꞌ rá. Tsí nigiáanꞌ, i̱jia̱a̱nꞌ xa̱bekha jamí go̱ꞌo̱ jamí xúgíin tsí xtaꞌdiin ná xuajen ríge̱ꞌ, arawíi̱n janíí, <verse eid="GEN 19:12" /><verse number="13" style="v" sid="GEN 19:13" />numuu rí mo̱ne̱ gámba̱a̱xo̱ꞌ xuajen ríge̱ꞌ. Ni̱ga̱nú ajngáa inuu Ana̱ꞌlóꞌ Mikhuíí ga̱jma̱á numúú xa̱bo̱ tsíge̱ꞌ, ikhaa jngó nixuꞌmáa̱ꞌxo̱ꞌ Ana̱ꞌlóꞌ Mikhuíí rí mo̱ne̱ gámba̱a̱xo̱ꞌ ne̱.<verse eid="GEN 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 19:14" />A̱ꞌkhue̱n rí Lót nigájnuu gáꞌthúu̱n niguíi̱n, tsí júwa̱ꞌ mu̱ni̱gu̱nꞌ gajmíí i̱ji̱i̱n: «A̱guáxo̱nlaꞌ, a̱ga̱jnálaꞌ ge̱jioꞌ, numuu rí Ana̱ꞌlóꞌ Mikhuíí ma̱ꞌne gámba̱a̱ xuajen ríge̱ꞌ». Xómáꞌ niguíi̱n, ni̱ju̱múu̱ rí ajngáa xaꞌon iꞌnii̱.<verse eid="GEN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 19:15" />Ído̱ rí na̱ka̱ ra̱mbiꞌi máꞌ, xa̱bekha mbo̱ ánje̱l nuxka nachaa̱ Lót, nitháa̱n:</para>
  <para style="p" vid="GEN 19:15">―¡Araxo̱n mi̱dxu̱ꞌ! Ayáa a̱ꞌgia̱a̱ꞌ jamí ná-a̱jmi̱i̱ máꞌ i̱jia̱a̱nꞌ tsíge̱ꞌ, ikhaa jngó ma̱xámbáa̱nꞌlaꞌ ído̱ gámínu̱u̱ꞌ xuajen.<verse eid="GEN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 19:16" />Xómáꞌ ikhaa̱ tsícho̱o̱, ikhaa jngó xa̱bekha tsúꞌkhue̱n ni̱ra̱tuun ñawúun Lót, ga̱jma̱á a̱ꞌgui̱i̱ jamí ná-a̱jmi̱i̱ i̱ji̱i̱n, numuu rí Ana̱ꞌlóꞌ Mikhuíí nañáwíin a̱kui̱i̱n jaꞌñúu̱. A̱ꞌkhue̱n rí nirawíi̱n, nigóo̱ gúni̱ñúu̱ꞌ ná rawuun xuajen. <verse eid="GEN 19:16" /><verse number="17" style="v" sid="GEN 19:17" />Ído̱ rí nigájnu-jiꞌdii̱n máꞌ, a̱ꞌkhue̱n nitháa̱n Lót:</para>
  <para style="p" vid="GEN 19:17">―Athane̱ jríya̱ꞌ-mina̱ꞌ. Ma̱xátia̱xe̱ tsu̱da̱a̱ꞌ, ni ma̱xáriajún mbá xúgíí xkua̱ ríge̱ꞌ. Atagáyaaꞌ ja ná júba̱, ra̱ꞌkhá ma̱ja̱ñáaꞌ. <figure style="fig" alt="Lot e hijas huyen de Sodoma" file="MX-19.tif" size="span" ref="19.17">Nagájnuu-ragáyuu Lót ná xuajen rí naꞌne gámba̱a̱ Ana̱ꞌlóꞌ.</figure><verse eid="GEN 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 19:18" />Xómáꞌ Lót niꞌthúu̱n:</para>
  <para style="p" vid="GEN 19:18">―Táta̱, na̱nda̱ꞌa̱ꞌlaꞌ rí ma̱xáꞌne xkuaꞌnii ja̱nꞌ. <verse eid="GEN 19:18" /><verse number="19" style="v" sid="GEN 19:19" />Xúge̱ꞌ rí ikháa̱nꞌlaꞌ nañáwíin a̱kia̱nꞌlaꞌ ju̱yo̱ꞌ, phú májáa̱nꞌlaꞌ rí no̱ne̱-jríya̱a̱ꞌlaꞌ mbiꞌyu̱ꞌ. I̱ndo̱ó ikhúúnꞌ ma̱xáꞌngo̱ꞌ ma̱ne̱ jríya̱ꞌ-mina̱ꞌ asndo ná júba̱, ra̱ꞌkhá ma̱xkama-ri̱gu̱ún rí ra̱máján, jamí ma̱ja̱ñúꞌ. <verse eid="GEN 19:19" /><verse number="20" style="v" sid="GEN 19:20" />A̱gu̱yáálaꞌ rí mijngi máꞌ ge̱jioꞌ ri̱ga̱ mbá xuajen, ná rí ma̱ga̱yú-toꞌo̱. Gu̱ni̱ꞌñúꞌ ma̱ꞌgá gáne̱ jríya̱ꞌ-mina̱ꞌ ikhín. Á ra̱ꞌkhá phú lájuíin ne̱ rá, ikhaa jngó ma̱ne̱-jríya̱a̱ꞌ mbiꞌyu̱ꞌ ikhín.<verse eid="GEN 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 19:21" />A̱ꞌkhue̱n rí mbáa ánje̱l niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 19:21">―Ni̱dxawaanꞌ máꞌ rí na̱tha̱nda̱ꞌa̱ ríge̱ꞌ, ikhaa jngó ma̱xáne̱ gámba̱a̱ xuajen rí narathán. <verse eid="GEN 19:21" /><verse number="22" style="v" sid="GEN 19:22" />Nacha̱ máꞌ gátha̱ne̱, ayu máꞌ gátha̱ne̱ jríya̱ꞌ-mina̱ꞌ ñúꞌún, numuu rí asndo nimbá ma̱xáxóo ma̱ne̱ asndo náá gádxa̱ꞌnú ikhín.</para>
  <para style="p" vid="GEN 19:22">Ikhaa jngó Soár neꞌne mbiꞌyuu xuajen rúꞌkhue̱n.<verse eid="GEN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23" />Mbá nangutaꞌáan a̱kha̱ꞌ rawuun numbaa ído̱ ni̱ga̱nú Lót ná Soár. <verse eid="GEN 19:23" /><verse number="24" style="v" sid="GEN 19:24" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ Mikhuíí neꞌne rí ma̱ri̱gú ruꞌwa agu ga̱jma̱á yoo ná inuu Sodóma̱ ga̱jma̱á Gomórra̱. <verse eid="GEN 19:24" /><verse number="25" style="v" sid="GEN 19:25" />Xkuaꞌnii neꞌne gámba̱a̱ xuajen rúꞌkhue̱n, xúꞌkhue̱n máꞌ mbá xúgíí xkua̱, mbá xúgíin máꞌ xa̱bo̱ tsí júwa̱ꞌ ná awúun xuajen, mangaa mbá xúgíí rí najma̱a̱ ná inuu ju̱ba̱ꞌ. <verse eid="GEN 19:25" /><verse number="26" style="v" sid="GEN 19:26" />Xómáꞌ a̱ꞌgui̱i̱ Lót, nitangayii̱ niyaxi̱i̱ tsu̱du̱u̱, jamí ikhín máꞌ niwanúu̱ wíji̱i̱, niꞌni̱i̱ la itsí idú xuyuu̱.<verse eid="GEN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 19:27" />A̱ꞌkhue̱n rí miꞌcha̱ máꞌ nitsima̱a̱ Abraám ná niꞌthán-mina̱ꞌ ga̱jmáa̱ Ana̱ꞌlóꞌ Mikhuíí. <verse eid="GEN 19:27" /><verse number="28" style="v" sid="GEN 19:28" />Niyaxi̱i̱ asndo ná Sodóma̱ ga̱jma̱á Gomórra̱, jamí asndo mbá xúgíí mbaa xkua̱. A̱ꞌkhue̱n ndiꞌyoo̱ rí natsimuu gúní ikhín, asndo xó mbá gúniúu iñá rí nakha-roꞌoo agu jaꞌnii ne̱.<verse eid="GEN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 19:29" />Ído̱ Ana̱ꞌlóꞌ neꞌne gámba̱a̱ xuajen ná xkua̱, a̱ꞌkhue̱n ni̱rmáꞌáa̱n a̱kui̱i̱n jaꞌyoo̱ Abraám. Ikhaa jngó niríya̱a̱ꞌ Lót ná xuajen rí neꞌne gámba̱a̱, ído̱ rí neꞌne gámbu̱u̱ ná nixtáa Lót.<verse eid="GEN 19:29" /></para>
  <para style="s">Lót gajmíí i̱ji̱i̱n</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30" />A̱ꞌkhue̱n rí nigájnuu Lót ná xuajen Soár numuu rí namíñuu̱ gáxtáa̱ xóó ikhín, ikhaa jngó ni̱ke̱e̱ gáxtáa̱ ná júba̱ gajmíi̱ ná-a̱jmi̱i̱ i̱ji̱i̱n tsí go̱ꞌo̱. Nijúwe̱e̱ꞌ mbá iñúu itsí. <verse eid="GEN 19:30" /><verse number="31" style="v" sid="GEN 19:31" />A̱ꞌkhue̱n tsí nikhi̱i̱ niꞌthúun ge̱ꞌthe̱e̱: «Nikhi̱i̱ máꞌ tátiálóꞌ, xúꞌkhue̱n máꞌ nánguíin xa̱bekha ná mbaa ríge̱ꞌ tsí mu̱ꞌdiinlóꞌ, xóo rí none̱ máꞌ xúgíin xa̱bo̱ numbaa. <verse eid="GEN 19:31" /><verse number="32" style="v" sid="GEN 19:32" />Aya̱, gu̱ꞌxnáá tátiálóꞌ iya najnga̱a̱ ma̱ga̱a̱n, xúꞌkhue̱n máꞌ mu̱ꞌbáa̱ꞌ gajmiálóꞌ, ikhaa jngó ga̱jma̱á majiu̱u̱nꞌ ikhaa̱ mu̱guaꞌdáálóꞌ ri̱jiu̱u̱ꞌ».<verse eid="GEN 19:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 19:33" />Ikhaa máꞌ mbroꞌon rúꞌkhue̱n nixnáa̱ iya najnga̱a̱ anúu̱ niꞌña̱a̱. A̱ꞌkhue̱n rí ni̱to̱ꞌo̱o̱ tsí nikhi̱i̱, jamí nibóo̱ꞌ ga̱jmáa̱ anu̱u̱. Xómáꞌ ikhaa̱ táꞌyoo̱ mbá jayu ído̱ nibóo a̱dée̱, ni máꞌ ído̱ rí ni̱tu̱xi̱i̱. <verse eid="GEN 19:33" /><verse number="34" style="v" sid="GEN 19:34" />Rí i̱mba̱ mbiꞌi, tsí nikhi̱i̱ niꞌthúun ge̱ꞌthe̱e̱: «Nathayáá ráꞌ, rí nduꞌwíín nigú ga̱jme̱ꞌ tátéꞌ. Gu̱ꞌxnáa̱lóꞌ iya najnga̱a̱ ma̱ga̱a̱n mangaa máꞌ mbroꞌon ríge̱ꞌ, a̱ꞌkhue̱n rí ma̱ta̱ꞌa̱a̱ꞌ me̱no̱ꞌ ga̱jma̱a̱ꞌ, ikhaa jngó ga̱jma̱á majiu̱u̱nꞌ ikhaa̱ mu̱guaꞌdáálóꞌ ri̱jiu̱u̱ꞌ».<verse eid="GEN 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 19:35" />Mangaa máꞌ mbroꞌon rúꞌkhue̱n nixnáa̱ iya najnga̱a̱ anúu̱ niꞌña̱a̱, a̱ꞌkhue̱n rí ni̱tu̱xu̱u̱ tsí lájuíin, jamí ni̱ke̱e̱ gábóo̱ ga̱jmáa̱ anu̱u̱. Xómáꞌ ikhaa̱ táꞌyoo̱ mbá jayu ído̱ nibóo a̱dée̱, ni máꞌ ído̱ ni̱tu̱xi̱i̱. <verse eid="GEN 19:35" /><verse number="36" style="v" sid="GEN 19:36" />A̱ꞌkhue̱n rí ná-a̱jmi̱i̱ máꞌ i̱ji̱i̱n Lót nida-éda neꞌne anúu̱. <verse eid="GEN 19:36" /><verse number="37" style="v" sid="GEN 19:37" />Xómáꞌ tsí nikhi̱i̱ neꞌne ku̱maa̱ mbáa a̱dée̱, jamí nixnúu̱ mbiꞌyuu Moáb, tsí ñajuun anu̱ú xa̱bo̱ moabíta̱ asndo xúge̱ꞌ. <verse eid="GEN 19:37" /><verse number="38" style="v" sid="GEN 19:38" />Mangaa tsí lájuíin neꞌne ku̱maa̱ mbáa a̱dée̱, jamí nixnúu̱ mbiꞌyuu Ben-ámmi̱, tsí ñajuun anu̱ú xa̱bo̱ amoníta̱ asndo xúge̱ꞌ.<verse eid="GEN 19:38" /></para>
  <chapter eid="GEN 19" />
  <chapter number="20" style="c" sid="GEN 20" />
  <para style="s">Abraám neꞌne-nduwaa Abimelék</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1" />A̱ꞌkhue̱n rí nigájnuu Abraám ni̱ka̱ ná mbaa Negéb, jamí ni̱ka̱-raxtáa̱ ná majiu̱u̱nꞌ Káde̱s ga̱jma̱á Súr, xúꞌkhue̱n máꞌ nixtáa̱ naꞌcho̱o̱ ná Jerár. <verse eid="GEN 20:1" /><verse number="2" style="v" sid="GEN 20:2" />Xómáꞌ Abraám naꞌthán ríge̱ꞌ ga̱jma̱á numuu Sára̱, tsí a̱ꞌgui̱i̱ máꞌ: «Ikhaa̱ ñajuu̱n dxáguíꞌ».</para>
  <para style="p" vid="GEN 20:2">A̱ꞌkhue̱n rí Abimelék, tsí ñajuun thúngaa ná Jerár, nixuꞌmii̱ tsí ma̱guwá juya̱a̱ Sára̱ rí ma̱ꞌne a̱ꞌgui̱i̱. <verse eid="GEN 20:2" /><verse number="3" style="v" sid="GEN 20:3" />I̱ndo̱ó ni̱ꞌkha̱ Ana̱ꞌlóꞌ awúun mbroꞌon ná xnuꞌnduu Abimelék, jamí niꞌthúu̱n:</para>
  <para style="p" vid="GEN 20:3">―Xóo tsí nijáñuu máꞌ jaꞌníí, ga̱jma̱á numuu a̱ꞌgo̱ tsí ndiyáa. Numuu rí a̱ꞌgo̱ tsúꞌkhue̱n gíꞌdaa máꞌ a̱jmbaa̱.<verse eid="GEN 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 20:4" />I̱ndo̱ó numuu rí Abimelék xóó máꞌ tíguii̱ ga̱jmáa̱ Sára̱, ikhaa jngó niꞌthée̱n:</para>
  <para style="p" vid="GEN 20:4">―Táta̱, á ma̱ta̱xíya̱a̱ mangaa tsí ra̱gíꞌdoo aꞌkhúun rá dxe̱ꞌ. <verse eid="GEN 20:4" /><verse number="5" style="v" sid="GEN 20:5" />Á ra̱ꞌkhá ikhaa̱ máꞌ niꞌthán: “Dxáguíꞌ ñajuu̱n”. Xúꞌkhue̱n máꞌ mangaa a̱ꞌgo̱ niꞌthán: “Díye̱ꞌ ñajuu̱n” rá. Mbá jañii a̱kui̱nꞌ ne̱ne̱lo̱ꞌ ríge̱ꞌ. Nda̱a̱-lá rí ra̱máján ne̱ne̱, e̱yo̱lo̱ꞌ jún.<verse eid="GEN 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 20:6" />A̱ꞌkhue̱n rí niriꞌña̱a̱ Ana̱ꞌlóꞌ ná xnuꞌnduu̱:</para>
  <para style="p" vid="GEN 20:6">―Mangúún máꞌ nda̱yo̱o̱ rí mbá jañii a̱kia̱a̱nꞌ nithane̱ ríge̱ꞌ. Xúꞌkhue̱n máꞌ mangúún ni̱wájo̱n-tha̱a̱nꞌ rí ma̱xáta̱xu̱ꞌdá-mina̱ꞌ aꞌkhán ná inu̱ꞌ, jamí xkuaꞌnii táni̱ꞌñáaꞌ rí ma̱tru̱gua̱a̱. <verse eid="GEN 20:6" /><verse number="7" style="v" sid="GEN 20:7" />Ikhaa jngó xúge̱ꞌ rá, ataxnáxi̱i̱ a̱ꞌgo̱ tsúꞌkhue̱n inuu a̱jmbaa̱. Numuu rí ikhaa̱ ñajuu̱n mbáa tsí naꞌthán-wíi̱ ajngáa rawu̱nꞌ, jamí maꞌthán-kháa̱n numaaꞌ jngó ma̱ra̱xtaa xóó. Xí tsítaxnáxi̱i̱, athayáá gúkuáaꞌ máꞌ rí ma̱ja̱ñáaꞌ ikháán, xúꞌkhue̱n máꞌ mbá guꞌwáa̱nꞌlaꞌ.<verse eid="GEN 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 20:8" />A̱ꞌkhue̱n rí phú miꞌcha̱ ni̱tu̱xi̱i Abimelék, xúꞌkhue̱n máꞌ nindxaꞌúu̱n mbá xúgíin yumbée̱, jamí niꞌthúu̱n xúgíí ajngáa ríge̱ꞌ. A̱ꞌkhue̱n rí ikhii̱n phú nimíñúu̱ mi̱ndaꞌkho. <verse eid="GEN 20:8" /><verse number="9" style="v" sid="GEN 20:9" />Nda̱wa̱á a̱ꞌkhue̱n Abimelék nindxaꞌwóo̱ Abraám, jamí niꞌthúu̱n:</para>
  <para style="p" vid="GEN 20:9">―Náá numuu jngó xáꞌnii nithaña̱ꞌxo̱ꞌ róꞌ. Náá aꞌkhán ni̱xu̱ꞌdá-mina̱ꞌ ikhúúnꞌ ná inaaꞌ, rí nidxa̱ꞌ ꞌcháa ra̱ꞌkhá-tháán mba̱a̱ aꞌkhán ná inu̱ꞌ jamí inuu xuajen rá. Nithañu̱ꞌ mbá rí ra̱gíꞌmaa ma̱tha̱ne̱.<verse eid="GEN 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 20:10" />Xúꞌkhue̱n máꞌ Abimelék niꞌthúun xóó Abraám:</para>
  <para style="p" vid="GEN 20:10">―Náá rí phú ni̱ju̱ma̱a̱ꞌ, ikhaa jngó nithane̱ ríge̱ꞌ rá.<verse eid="GEN 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 20:11" />A̱ꞌkhue̱n rí Abraám niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 20:11">―Numuu rí ni̱ndxa̱ꞌwa̱-mina̱ꞌ: “Gáꞌne xí gakon rí tsímíñúú xa̱bo̱ ge̱jioꞌ eꞌne Ana̱ꞌlóꞌ, jamí mu̱xi̱ñúu̱ ga̱jma̱á numuu a̱ꞌgui̱ꞌ”. <verse eid="GEN 20:11" /><verse number="12" style="v" sid="GEN 20:12" />Gakon mangaa rí dxáguíꞌ ñajuu̱n, a̱dée anu̱ꞌ. I̱ndo̱ó rí ra̱ꞌkháa a̱dée ru̱dúꞌ, jamí ikhúúnꞌ ndi̱ya̱a̱ rí ma̱ꞌne a̱ꞌgui̱ꞌ. <verse eid="GEN 20:12" /><verse number="13" style="v" sid="GEN 20:13" />Ído̱ rí Ana̱ꞌlóꞌ neꞌne rí ma̱ga̱jnúꞌ ná goꞌóo anu̱ꞌ rí ma̱ngroꞌo̱ꞌ, a̱ꞌkhue̱n ikhúúnꞌ ni̱thu̱u̱n a̱ꞌgui̱ꞌ: “Ríge̱ꞌ ñajuun mbá rí máján rí ma̱tha̱ñu̱ꞌ, rí asndo náá gúguáꞌnúlóꞌ xáꞌnii gára̱tha̱n tháan numu̱ꞌ: ‘Díye̱ꞌ ñajuu̱n.’ ”<verse eid="GEN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 20:14" />A̱ꞌkhue̱n rí Abimelék nixnúu Abraám mogo̱, xede̱, jamí yumbáá xa̱bekha jamí go̱ꞌo̱, mangaa máꞌ nirtanga̱a̱ Sára̱. <verse eid="GEN 20:14" /><verse number="15" style="v" sid="GEN 20:15" />A̱ꞌkhue̱n rí Abimelék niꞌthúun Abraám:</para>
  <para style="p" vid="GEN 20:15">―Atiaxi̱í ma̱thi̱yáá, a̱ꞌkhue̱n ri̱ga̱ mbá xúgíí mbayu̱ꞌ. Araxtaa asndo náá eꞌne a̱kia̱a̱nꞌ.<verse eid="GEN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 20:16" />A̱ꞌkhue̱n niꞌthúu̱n Sára̱ mangaa:</para>
  <para style="p" vid="GEN 20:16">―Ni̱xnu̱u̱ díya̱a̱ꞌ mbá míl mbúkha̱a̱ ajua̱nꞌ rí miꞌxá. Ikhaa maꞌthán-mbáá numaaꞌ inúú mbá xúgíin tsí júwa̱ꞌ ga̱jma̱á nindxa̱a̱ꞌ, jngó xúgíi̱n mbuya-makuaaꞌ.<verse eid="GEN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 20:17" />A̱ꞌkhue̱n rí Abraám niꞌthán-jáñuu Ana̱ꞌlóꞌ, jamí Ana̱ꞌlóꞌ neꞌne maꞌndáa̱ Abimelék xúꞌkhue̱n máꞌ a̱ꞌgui̱i̱ gajmíí go̱ꞌo̱ yumbáá, a̱ꞌkhue̱n rí ndiyoo niguáꞌdii̱n i̱jíi̱n. <verse eid="GEN 20:17" /><verse number="18" style="v" sid="GEN 20:18" />Numuu rí wapha máꞌ Ana̱ꞌlóꞌ Mikhuíí neꞌne rí ma̱xágu̱mii e̱je̱n ná goꞌóo Abimelék, ga̱jma̱á numuu Sára̱, a̱ꞌgui̱i̱ Abraám.<verse eid="GEN 20:18" /></para>
  <chapter eid="GEN 20" />
  <chapter number="21" style="c" sid="GEN 21" />
  <para style="s">Na̱ga̱nú mbiꞌi rí ma̱gu̱maa Isaák</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1" />Ana̱ꞌlóꞌ Mikhuíí neꞌne tsakun-rámaa Sára̱, xómáꞌ rí niꞌthée̱n, jamí niꞌñuu̱ rí nixuda-mine̱e̱ꞌ. <verse eid="GEN 21:1" /><verse number="2" style="v" sid="GEN 21:2" />Ikhaa jngó mbiꞌi rí niꞌthán Ana̱ꞌlóꞌ, nigo̱-éda Sára̱ jamí neꞌne ku̱maa̱ mbáa a̱dée Abraám, rí xi̱ꞌñú máꞌ ñajuun. <verse eid="GEN 21:2" /><verse number="3" style="v" sid="GEN 21:3" />Xómáꞌ Abraám nixnúu̱ mbiꞌyuu ada̱ tsí niꞌnii̱ ga̱jmáa̱ Sára̱. Isaák neꞌne mbiꞌyuu̱. <verse eid="GEN 21:3" /><verse number="4" style="v" sid="GEN 21:4" />A̱ꞌkhue̱n rí Abraám nixnúu̱ tsina-jndi a̱dée̱, ído̱ ni̱ga̱nú migiñuu mbiꞌi rí ni̱gu̱maa, xómá rí waꞌxná-ñájuíi̱n neꞌne Ana̱ꞌlóꞌ. <verse eid="GEN 21:4" /><verse number="5" style="v" sid="GEN 21:5" />Xómáꞌ Abraám gíꞌdoo witsu skíñú (100) tsiguu ído̱ ni̱gu̱maa Isaák.<verse eid="GEN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 21:6" />A̱ꞌkhue̱n rí Sára̱ niꞌthán: «Ana̱ꞌlóꞌ neꞌne rí ma̱ndu̱ꞌwa̱, jamí asndo tsáa tsí gáꞌdxuun ríge̱ꞌ manduꞌwá ga̱jma̱á nindxu̱ꞌ». <verse eid="GEN 21:6" /><verse number="7" style="v" sid="GEN 21:7" />Niꞌthée̱n xóó: «Nguáná-lá ni̱ju̱mu̱u̱ Abraám rí a̱ꞌgui̱i̱ maxníxúún e̱je̱n rá. Maske máꞌ xúꞌkhue̱n, ne̱ne̱-ku̱maa mbáa a̱dée̱ rí xi̱ꞌñú máꞌ ñajuu̱n».<verse eid="GEN 21:7" /></para>
  <para style="s">Agár ga̱jma̱á Ismaél nixkawíin ná goꞌóo Abraám</para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 21:8" />A̱ꞌkhue̱n rí ni̱ka̱-ragaja̱a̱ ada̱, xúꞌkhue̱n máꞌ niniñuu̱ yaꞌdú. Xómáꞌ Abraám phú mba̱a̱ ndxa̱a̱ niꞌnii̱ mbiꞌi rí niniñuu yaꞌdú Isaák. <verse eid="GEN 21:8" /><verse number="9" style="v" sid="GEN 21:9" />A̱ꞌkhue̱n ndiꞌyoo Sára̱ rí a̱dée Agár mbo̱ Ejípto̱, ada̱ tsí neꞌne ku̱maa̱ ga̱jmáa̱ Abraám, tsúꞌkhue̱n naꞌne tsi̱ndíi Isaák. <verse eid="GEN 21:9" /><verse number="10" style="v" sid="GEN 21:10" />Ikhaa jngó niꞌthúu̱n Abraám: «Araxkáá a̱ꞌgo̱ yumbáá tsúꞌkhue̱n ga̱jma̱á a̱dée, numuu rí a̱dée̱ ma̱xáre̱doo̱ ga̱jmáa̱ a̱ꞌdéꞌ Isaák».<verse eid="GEN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 21:11" />Ído̱ niꞌdxuun ajngáa ríge̱ꞌ Abraám, maphú nidaa a̱kui̱i̱n numuu rí a̱dée̱ ñajuun. <verse eid="GEN 21:11" /><verse number="12" style="v" sid="GEN 21:12" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ niꞌthúun Abraám: «Ma̱xáꞌdaa máꞌ a̱kia̱a̱nꞌ ga̱jma̱á numuu dxáma ni máꞌ numuu yumbiáaꞌ. Mbá xúgíí rí naꞌtháanꞌ Sára̱, atadxawíín rí naꞌthée̱n. Numuu rí ga̱jma̱á majiu̱u̱nꞌ máꞌ Isaák ma̱guwá xa̱bo̱ ri̱jia̱a̱ꞌ. <verse eid="GEN 21:12" /><verse number="13" style="v" sid="GEN 21:13" />Xúꞌkhue̱n máꞌ a̱dée yumbáá, ma̱ne̱ mbá xuajen mba̱a̱ ga̱jma̱á nindxu̱u̱, numuu rí a̱ꞌdeáaꞌ ñajuu̱n».<verse eid="GEN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 21:14" />A̱ꞌkhue̱n rí phú miꞌcha̱ ni̱tu̱xi̱i̱ Abraám, jamí nigui̱i̱ guma, ga̱jma̱á mbá xtá-lámbá ná gajno̱ꞌ iya. Nixnúu̱ ne̱ Agár, xúꞌkhue̱n máꞌ niríguii̱ ne̱ ná xpaphuu̱. Mangaa nixnáxi̱i̱ dxáma, a̱ꞌkhue̱n rí niꞌthán-ngawoo̱. Xómáꞌ ikhaa̱ nigájnuu̱ ni̱ke̱e̱ jamí ni̱ka̱-rangroꞌoo̱ ná mbaa niníí Beerséba̱. <verse eid="GEN 21:14" /><verse number="15" style="v" sid="GEN 21:15" />Ído̱ rí wámba̱ iya ná xtá-lámbá, ni̱ka̱ gáti̱ga̱a̱ dxáma ná agoo mbá xtaꞌdu̱u̱ iná. <verse eid="GEN 21:15" /><verse number="16" style="v" sid="GEN 21:16" />Xómáꞌ ikhaa̱ ni̱ke̱e̱ gági̱ꞌi̱i̱, mbá xóo ꞌmba̱ꞌ rí na̱ka̱ xkuíyu̱u̱ xkamídá ñawún. Numuu rí niꞌthán-mine̱e̱ꞌ: «Tsíyo̱ꞌ gáyu̱u̱ ído̱ ma̱ja̱ñúu dxáma». Ído̱ rí ikhaa̱ ni̱ka̱ gági̱ꞌi̱i̱, xómáꞌ dxáma nigíꞌdu̱u̱n ni̱mbi̱ya̱ꞌ.<verse eid="GEN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 21:17" />Ído̱ nidxawuun Ana̱ꞌlóꞌ aꞌwóo dxáma, a̱ꞌkhue̱n rí ánje̱l drígo̱o̱ Ana̱ꞌlóꞌ nindxaꞌwóo̱ Agár asndo ná mikhuíí, jamí niꞌthúu̱n: «Náá rí itagíꞌníí rá, Agár. Ma̱xámíñaaꞌ, numuu rí Ana̱ꞌlóꞌ nidxawuun aꞌwóo dxáma ná kri̱ga̱a̱ a̱ꞌkhue̱n. <verse eid="GEN 21:17" /><verse number="18" style="v" sid="GEN 21:18" />Ayu jamí ataxúxi̱i̱ dxáma, xúꞌkhue̱n máꞌ atartuwii̱n ga̱jma̱á ñawáanꞌ, numuu rí ikhúúnꞌ ma̱ne̱ mbá xuajen maphú mba̱a̱ ga̱jma̱á nindxu̱u̱». <verse eid="GEN 21:18" /><verse number="19" style="v" sid="GEN 21:19" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ nirmáꞌthoo iduu Agár, jamí ndiꞌyoo̱ mbá iduu iya. A̱ꞌkhue̱n ni̱ke̱e̱ gáxíña̱a̱ꞌ iya awúun xtá-lámbá, xúꞌkhue̱n máꞌ nixnúu̱ iya dxáma niꞌña̱a̱. <verse eid="GEN 21:19" /><verse number="20" style="v" sid="GEN 21:20" />Ana̱ꞌlóꞌ nixtáa ga̱jma̱á nindxu̱u̱ dxáma, xúꞌkhue̱n máꞌ ni̱ka̱-ragaja̱a̱. Jamí nixtáa̱ ná mbaa niníí, xúꞌkhue̱n máꞌ ni̱ma̱ñuu̱ nadee̱ ga̱jma̱á xkamídá. <verse eid="GEN 21:20" /><verse number="21" style="v" sid="GEN 21:21" />Nixtáa̱ ná mbaa niníí rí mbiꞌyuu Parán, xómáꞌ náníi̱ ndiyáa mbáa a̱ꞌgo̱ mbo̱ Ejípto̱ rí mbayáa̱.<verse eid="GEN 21:21" /></para>
  <para style="s">Awan rí na̱ge̱ꞌdoo Abraám ga̱jma̱á Abimelék</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22" />Ni̱ga̱nú mbá mbiꞌi rí ni̱ka̱ Abimelék gáꞌthúun Abraám, ni̱ka̱ ga̱jmáa̱ Fikól tsí jayá ikhúún xa̱bo̱ ajua̱nꞌ. Xáꞌnii niꞌthúu̱n:</para>
  <para style="p" vid="GEN 21:22">―Ana̱ꞌlóꞌ xtáa ga̱jma̱á nindxa̱a̱ꞌ awúun mbá xúgíí rí nathane̱. <verse eid="GEN 21:22" /><verse number="23" style="v" sid="GEN 21:23" />Ikhaa jngó xúge̱ꞌ rá, ataxúda-mina̱ꞌ inu̱ꞌ jamí inuu máꞌ Ana̱ꞌlóꞌ ge̱jioꞌ, rí ma̱xátha̱ñu̱ꞌ rí ra̱máján, ni máꞌ i̱ji̱nꞌ, ni máꞌ i̱jín-xíñi̱ꞌ. Mbá xóo gamaku rí ni̱gúꞌdo̱ꞌ ga̱jma̱á nindxa̱a̱ꞌ, xkuaꞌnii máꞌ gátha̱ne̱ ga̱jma̱á nindxu̱ꞌ mangáán, xúꞌkhue̱n máꞌ ga̱jma̱á mbaa ná rí nangraꞌaaꞌ.<verse eid="GEN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 21:24" />A̱ꞌkhue̱n niriꞌña̱a̱ Abraám:</para>
  <para style="p" vid="GEN 21:24">―Ikhúúnꞌ na̱xu̱ꞌdá-mina̱ꞌlo̱ꞌ.<verse eid="GEN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 21:25" />I̱ndo̱ó numuu rí Abraám neꞌne xkujnduu Abimelék ga̱jma̱á mbá iduu iya, numuu rí xa̱bi̱i̱ máꞌ Abimelék ni̱ri̱gú-jáꞌyíi̱ ne̱. <verse eid="GEN 21:25" /><verse number="26" style="v" sid="GEN 21:26" />A̱ꞌkhue̱n niriꞌña̱a̱ Abimelék:</para>
  <para style="p" vid="GEN 21:26">―Tsíyo̱lo̱ꞌ tsáa ñajuun neꞌne rúꞌkhue̱n, ni máꞌ ikháán táta̱gíꞌda̱ꞌ idxu̱ꞌ, ni máꞌ ikhúúnꞌ tádxawuun asndo xúge̱ꞌ.<verse eid="GEN 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 21:27" />Xómáꞌ Abraám ni̱ꞌkha̱ jagu̱u̱n mogo̱ gajmíí xede̱, jamí nixnúu̱ Abimelék. A̱ꞌkhue̱n rí niguaꞌdáa̱ awan ná-a̱jmi̱i̱. <verse eid="GEN 21:27" /><verse number="28" style="v" sid="GEN 21:28" />A̱ꞌkhue̱n rí Abraám niskuíji̱i̱n janíí mbá juiin mogo̱-iꞌgú ná inúú máꞌ tsí gíꞌdii̱n. <verse eid="GEN 21:28" /><verse number="29" style="v" sid="GEN 21:29" />Xómáꞌ Abimelék niraxu̱u̱ Abraám:</para>
  <para style="p" vid="GEN 21:29">―Náá rí iyoo gáꞌthán rí nitaskuíji̱i̱n janíí mbá juiin mogo̱-iꞌgú róꞌ.<verse eid="GEN 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 21:30" />A̱ꞌkhue̱n rí ikhaa̱ niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 21:30">―Tsí mbá juiin mogo̱ tsíge̱ꞌ ma̱tri̱gúun ná ñawúnꞌ, numuu rí rúꞌkhue̱n maꞌthán rí jmbu ikhúúnꞌ ni̱ndi iduu iya ríge̱ꞌ.<verse eid="GEN 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 21:31" />Ikhaa jngó nixnúu̱ mbiꞌyuu mbaa rúꞌkhue̱n Beerséba̱, numuu rí ikhín ni̱xu̱da̱ꞌ-mi̱jne̱e̱ awan ná-a̱jmi̱i̱. <verse eid="GEN 21:31" /><verse number="32" style="v" sid="GEN 21:32" />Xkuaꞌnii niꞌkhu̱u̱ rí niguaꞌdáa̱ awan ná Beerséba̱. A̱ꞌkhue̱n rí ni̱tu̱xu̱u̱ Abimelék ga̱jma̱á Fikól, tsí jayá ikhúún xa̱bo̱ ajua̱nꞌ, nitangi̱i̱n ná mbañúú xa̱bo̱ filistéo̱. <verse eid="GEN 21:32" /><verse number="33" style="v" sid="GEN 21:33" />A̱ꞌkhue̱n rí Abraám niꞌdu mbá ixu̱u̱ tamarísko̱ ná Beerséba̱, jamí ikhín nixrégo̱o̱ mbiꞌyuu Ana̱ꞌlóꞌ Mikhuíí tsí xtáa jámuu mbiꞌi. <verse eid="GEN 21:33" /><verse number="34" style="v" sid="GEN 21:34" />Jamí phú mba̱yo̱ꞌ nixtáa̱ ná mbañúú xa̱bo̱ filistéo̱.<verse eid="GEN 21:34" /></para>
  <chapter eid="GEN 21" />
  <chapter number="22" style="c" sid="GEN 22" />
  <para style="s">Ana̱ꞌlóꞌ naxná-ñájuun Abraám rí maxnáxi̱i̱ Isaák xóo mbá tsi̱gi̱jia̱nꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1" />Ído̱ rí ni̱ka̱-ranújngoo máꞌ rúꞌkhue̱n, a̱ꞌkhue̱n rí Ana̱ꞌlóꞌ niꞌnii̱ mba̱ꞌyoo̱ xí jmbu a̱kui̱i̱n Abraám, jamí niꞌthúu̱n:</para>
  <para style="p" vid="GEN 22:1">―Abraám.</para>
  <para style="p" vid="GEN 22:1">Xómáꞌ ikhaa̱ niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 22:1">―Ge̱jioꞌ máꞌ xtáá.<verse eid="GEN 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 22:2" />A̱ꞌkhue̱n waꞌtháa̱n:</para>
  <para style="p" vid="GEN 22:2">―Ayáa a̱ꞌdeáaꞌ Isaák xúge̱ꞌ, tsí mbáwíi máꞌ xtaꞌdaa, tsí nandaaꞌ xtayáá, xúꞌkhue̱n máꞌ ayu ná mbaa Moriá, jamí ataxnáxi̱i̱ ikhín rí mi̱khaa̱ xóo mbá tsi̱gi̱jia̱nꞌ ná inuu mbá júba̱ rí ma̱tha̱a̱nꞌ máꞌ ikhúúnꞌ.<verse eid="GEN 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 22:3" />A̱ꞌkhue̱n rí phú miꞌcha̱ ni̱tu̱xi̱i̱ Abraám, jamí nirígu̱u̱ la xíli̱i̱ xtá-ngidiuu̱ jamí nigu̱u̱n a̱jmi̱i̱ yumbée̱, mangaa máꞌ Isaák. Xúꞌkhue̱n máꞌ ni̱ru̱thii̱n ixe̱ rí ma̱jmaa ná inuu tsi̱gi̱jia̱nꞌ. A̱ꞌkhue̱n nigájnuu̱ ni̱ke̱e̱ ná waꞌtháa̱n neꞌne Ana̱ꞌlóꞌ. <verse eid="GEN 22:3" /><verse number="4" style="v" sid="GEN 22:4" />Mbiꞌi riatsú, Abraám niyaxe̱ tsíngua̱ꞌ jamí ndiꞌyoo̱ ná ma̱ga̱níi̱. <verse eid="GEN 22:4" /><verse number="5" style="v" sid="GEN 22:5" />A̱ꞌkhue̱n Abraám niꞌthúún yumbée: «A̱guaꞌthi̱ínlaꞌ ge̱jioꞌ gajmiálaꞌ xtá-ngidi. Ikhúúnꞌ jamí dxáma mu̱ꞌguáxo̱ꞌ asndo ná ñúꞌún, jamí mo̱ne̱-mba̱a̱xo̱ꞌ Ana̱ꞌlóꞌ, jamí ma̱tangáa̱nꞌ máꞌxo̱ꞌ inalaꞌ».<verse eid="GEN 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 22:6" />A̱ꞌkhue̱n rí Abraám nigo̱ ixu̱u̱ tsi̱gi̱jia̱nꞌ, xúꞌkhue̱n máꞌ niyaꞌdoo̱ ne̱ Isaák tsí a̱dée̱. Xómáꞌ ikhaa̱ ndiyée̱ agu ga̱jma̱á chílo̱. Jamí mbóó máꞌ nigóo̱ ná-a̱jmi̱i̱. <verse eid="GEN 22:6" /><verse number="7" style="v" sid="GEN 22:7" />A̱ꞌkhue̱n rí Isaák niꞌthúun anu̱u̱:</para>
  <para style="p" vid="GEN 22:7">―Táa̱.</para>
  <para style="p" vid="GEN 22:7">Xómáꞌ Abraám niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 22:7">―Dí máꞌ iyaaꞌ rá, a̱ꞌdéꞌ.</para>
  <para style="p" vid="GEN 22:7">A̱ꞌkhue̱n niꞌthán Isaák:</para>
  <para style="p" vid="GEN 22:7">―Ge̱jioꞌ ríga̱ agu ga̱jma̱á ixe̱. Náá-lá xtáa mogo̱ tsí mu̱xnáxi̱i̱lóꞌ mi̱khaa rá.<verse eid="GEN 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 22:8" />A̱ꞌkhue̱n niriꞌña̱a̱ Abraám:</para>
  <para style="p" vid="GEN 22:8">―Ana̱ꞌlóꞌ gáxjnáa mogo̱ tsí ma̱ꞌne tsi̱gi̱jia̱nꞌ, a̱ꞌdéꞌ.</para>
  <para style="p" vid="GEN 22:8">Jamí mbóó máꞌ xúꞌkhue̱n igóo̱. <verse eid="GEN 22:8" /><verse number="9" style="v" sid="GEN 22:9" />Ído̱ niguáꞌníi̱ ná rí niꞌthán Ana̱ꞌlóꞌ, ikhín nixúxe̱ Abraám xu̱nꞌ itsí, xúꞌkhue̱n máꞌ nistrámee̱ ixe̱ inuu ne̱. A̱ꞌkhue̱n niroꞌóo̱ Isaák, jamí nitámaa̱ ná inuu ixe̱. <figure style="fig" alt="Abr ofrece a Isaac, manos alzadas" file="CO00663b.tif" size="span" ref="22.9">Abraám naxnáxi̱i̱ a̱dée rí manindxu̱u̱ tsi̱gi̱jña̱ꞌ.</figure> <verse eid="GEN 22:9" /><verse number="10" style="v" sid="GEN 22:10" />A̱ꞌkhue̱n rí Abraám ndiyá chílo̱ rí ma̱ro̱thon-roꞌoo agoo a̱dée. <verse eid="GEN 22:10" /><verse number="11" style="v" sid="GEN 22:11" />A̱ꞌkhue̱n rí Ánje̱l drígo̱o̱ Ana̱ꞌlóꞌ Mikhuíí nindxaꞌwá asndo ná mikhu, niꞌthée̱n:</para>
  <para style="p" vid="GEN 22:11">―¡Abraám! ¡Abraám!</para>
  <para style="p" vid="GEN 22:11">Xómáꞌ ikhaa̱ niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 22:11">―Ge̱jioꞌ máꞌ xtáá.<verse eid="GEN 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 22:12" />A̱ꞌkhue̱n Ánje̱l niꞌthán:</para>
  <para style="p" vid="GEN 22:12">―Ma̱xátha̱xkajmaa dxáma, nimbá xátha̱níi̱. Nda̱yo̱o̱ máꞌ rí natia-makuíí Ana̱a̱ꞌ Mikhuíí, numuu rí tára̱tha̱n xí ma̱xára̱xni̱iꞌ a̱ꞌdeáaꞌ tsí mbáwíi.<verse eid="GEN 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 22:13" />A̱ꞌkhue̱n niyaxe̱ Abraám ná tsu̱du̱u̱, ndiꞌyoo̱ mbáa mogo̱ nikhráꞌaa ga̱jma̱á chi̱jiu̱u̱ꞌ ná xtaꞌdu̱u̱ iná tsuwan. A̱ꞌkhue̱n ni̱ka̱ Abraám gáyáa mogo̱, tsúꞌkhue̱n nixnáxi̱i̱ mi̱khaa xóo xtiꞌkhuu a̱dée̱. <verse eid="GEN 22:13" /><verse number="14" style="v" sid="GEN 22:14" />A̱ꞌkhue̱n rí Abraám nixná mbiꞌyuu júba̱ rúꞌkhue̱n «Ana̱ꞌlóꞌ Mikhuíí naxná rí ndaꞌyóo». Ikhaa jngó ri̱ga̱ ajngáa asndo máꞌ xúge̱ꞌ: «Ná júbu̱u̱ máꞌ Ana̱ꞌlóꞌ Mikhuíí ma̱ri̱gá rí ndaꞌyóo».<verse eid="GEN 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 22:15" />A̱ꞌkhue̱n rí Ánje̱l drígo̱o̱ Ana̱ꞌlóꞌ Mikhuíí nindxaꞌwá rí riajmu̱u̱ inuu Abraám asndo ná mikhuíí. <verse eid="GEN 22:15" /><verse number="16" style="v" sid="GEN 22:16" />Niꞌthúu̱n:</para>
  <para style="p" vid="GEN 22:16">―Ikhúúnꞌ máꞌ jmínu̱ú ni̱xu̱ꞌdá-mina̱ꞌ rí ma̱ne̱-mbánuu ―iꞌthán Ana̱ꞌlóꞌ Mikhuíí―, numuu rí xáꞌnii nithane̱ rá, tára̱tha̱n xí ma̱xára̱xni̱ꞌ a̱ꞌdeáaꞌ tsí mbáwíi. <verse eid="GEN 22:16" /><verse number="17" style="v" sid="GEN 22:17" />Ikhaa jngó phú gakon rí ma̱ne̱ tsakun-rámáá, xúꞌkhue̱n máꞌ ma̱ne̱ rí ma̱ꞌne mbaꞌiin xa̱bia̱a̱ꞌ asndo xóo a̱ꞌgua̱án, jamí asndo xóo we̱ꞌe̱ rí ri̱ga̱ rawuun iya a̱pha̱. Xómáꞌ xa̱bia̱a̱ꞌ ma̱ꞌngúún inúú xa̱bo̱ sia̱nꞌ. <verse eid="GEN 22:17" /><verse number="18" style="v" sid="GEN 22:18" />Ga̱jma̱á majiu̱ún xa̱bia̱a̱ꞌ, ma̱gu̱ma-tsakun-ráma mbá xúgíí xuajen ná numba̱a̱, numuu rí nithane̱-mbáníí ajngóꞌ.<verse eid="GEN 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 22:19" />A̱ꞌkhue̱n rí Abraám nitanga̱a̱ inúú yumbée̱, jamí ni̱tu̱xúu̱n nigúu̱n mbóó máꞌ asndo ná Beerséba̱. Ikhín máꞌ niwanúu̱ nixtáa̱.<verse eid="GEN 22:19" /></para>
  <para style="s">I̱ji̱i̱n Nakór</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20" />Ído̱ rí ni̱ka̱-ranújngoo máꞌ rúꞌkhue̱n, ni̱ꞌkha̱ ajngáa rí waꞌtháán Abraám: «Mangaa máꞌ Mílka̱ ni̱gu̱mii i̱ji̱i̱n ga̱jmáa̱ Nakór tsí dxíya̱a̱ꞌ máꞌ. <verse eid="GEN 22:20" /><verse number="21" style="v" sid="GEN 22:21" />Ús ñajuun xa̱bo̱ ginii, tsí gua̱ꞌthe̱e̱ ñajúún Bús, xúꞌkhue̱n máꞌ anu̱u̱ Arám tsí mbiꞌyuu Kemuél, <verse eid="GEN 22:21" /><verse number="22" style="v" sid="GEN 22:22" />xúꞌkhue̱n máꞌ Keséd, Áso̱, Pílda̱s, Jidláf jamí Betuél». <verse eid="GEN 22:22" /><verse number="23" style="v" sid="GEN 22:23" />Betuél ñajuun máꞌ anu̱u̱ Rebéka̱. Tsíge̱ꞌ ñajúún tsí mbá migiñuu tsí neꞌne ku̱mii Mílka̱ ga̱jma̱á Nakór, dxíyo̱o̱ máꞌ Abraám. <verse eid="GEN 22:23" /><verse number="24" style="v" sid="GEN 22:24" />Tsí músi̱i̱ Nakór mbiꞌyuu Reúma̱, jamí mangaa̱ neꞌne xuajii̱n ni̱gu̱mii i̱ji̱i̱n: Téba̱, Gaám, Táa̱s jamí Maáka̱.<verse eid="GEN 22:24" /></para>
  <chapter eid="GEN 22" />
  <chapter number="23" style="c" sid="GEN 23" />
  <para style="s">Nijáñuu Sára̱ jamí waꞌdi̱i̱</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1" />Sára̱ nixtáa mbá majuun skíñú juan (127) tsigu. <verse eid="GEN 23:1" /><verse number="2" style="v" sid="GEN 23:2" />A̱ꞌkhue̱n nijáñuu Sára̱ ná Kiriat-árba̱, rí ikhaa máꞌ ñajuun Ebrón, ná mbayuu Kanaán. Jamí Abraám nixtáa-jínúu, rí na̱mbe̱ye̱e̱ꞌ ga̱jma̱á numuu Sára̱. <verse eid="GEN 23:2" /><verse number="3" style="v" sid="GEN 23:3" />A̱ꞌkhue̱n rí ni̱tu̱xu̱u̱ Abraám ná kri̱ga̱a̱ wa̱jen a̱ꞌgui̱i̱, jamí ni̱ke̱e̱ gáꞌthúu̱n xa̱bi̱i̱ Ét:<verse eid="GEN 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 23:4" />―Ikhúúnꞌ ñaju̱nꞌ xa̱bo̱ na̱ꞌkha̱ i̱mba̱ xuajen jamí ngroꞌoo ná majia̱nꞌlaꞌ. A̱gu̱xnu̱ꞌlaꞌ tháan ma̱gúꞌdo̱ꞌ mbá mbaa ná ma̱dii̱n xa̱bi̱ꞌ, ikhaa jngó ma̱dii̱ tháan wa̱jen a̱ꞌgui̱ꞌ.<verse eid="GEN 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 23:5" />A̱ꞌkhue̱n ni̱ri̱ꞌñaa̱ xa̱bi̱i̱ Ét jamí nitháa̱n Abraám:<verse eid="GEN 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 23:6" />―Atadxawanxo̱ꞌ, táta̱. Ndu̱yááxo̱ꞌ rí ikháán ñajuaanꞌ mbáa xa̱bo̱ tsí phú gíꞌdoo numuu ná inuu Ana̱ꞌlóꞌ. Athadi̱i̱ wa̱jen a̱ꞌgia̱a̱ꞌ ná rí i̱tha̱n máján iñá-wa̱jianxo̱ꞌ. Asndo nimbáa tsí ikháa̱nꞌxo̱ꞌ ma̱nga̱jo̱o̱ꞌ iñá-wa̱jiuun, rí ma̱xátha̱dii̱ wa̱jen a̱ꞌgia̱a̱ꞌ.<verse eid="GEN 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 23:7" />A̱ꞌkhue̱n Abraám ni̱we̱je̱, jamí ni̱rnga̱du̱u̱n rí ndiyá-makúu̱n xa̱bo̱ xuajen rúꞌkhue̱n, tsí xa̱bi̱i̱ máꞌ Ét. <verse eid="GEN 23:7" /><verse number="8" style="v" sid="GEN 23:8" />A̱ꞌkhue̱n niꞌthúu̱n:</para>
  <para style="p" vid="GEN 23:8">―Xí xkuaꞌnii eꞌne a̱kia̱nꞌlaꞌ rí ma̱dii̱ wa̱jen a̱ꞌgui̱ꞌ, gu̱tha̱n-jáñíí tháan Efrón tsí a̱dée Soár ga̱jma̱á numu̱ꞌ, <verse eid="GEN 23:8" /><verse number="9" style="v" sid="GEN 23:9" />rí ma̱ngo̱jue̱ꞌ iñúu itsí ná Makpéla̱, rí ri̱ga̱ ná rawuun mbayuu̱. Gaxnée̱ ajngóo̱ nguátha̱ phú numuu ne̱, ikhaa jngó ma̱gúꞌdo̱ꞌ ná ma̱jnguáa̱n a̱ngui̱nꞌ ná majia̱nꞌlaꞌ.<verse eid="GEN 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 23:10" />Xómáꞌ ikhaa Efrón, gída̱ꞌ ná majiu̱ún máꞌ a̱ngui̱i̱n, ikhaa jngó niriꞌña̱a̱ ajngóo Abraám, ná inúú mbá xúgíin mbo̱ ñajúún máꞌ xa̱bi̱i̱ Ét, jamí inúú máꞌ tsí na̱tu̱ꞌúún ná rawuun xuajiúu̱n. Xáꞌnii niꞌthée̱n:<verse eid="GEN 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 23:11" />―Ma̱xáꞌne xkuaꞌnii, táta̱. Athane̱ mba̱a̱ a̱kia̱a̱nꞌ: ikhúúnꞌ na̱mína̱a̱ꞌ mbaa rúꞌkhue̱n, ga̱jma̱á máꞌ iñá rí ríga̱ ikhín. Ikhaa jngó naꞌne inúú mbá xúgíin xa̱bo̱ xuajiu̱nꞌ rí na̱mína̱a̱ꞌ-ne̱lo̱ꞌ. Athadi̱i̱ ja wa̱jen a̱ꞌgia̱a̱ꞌ.<verse eid="GEN 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 23:12" />A̱ꞌkhue̱n rí Abraám ni̱rnga̱du̱u̱n rí ndiyá-makúu̱n xa̱bo̱ xuajen, <verse eid="GEN 23:12" /><verse number="13" style="v" sid="GEN 23:13" />jamí inúú mbá xúgíin xa̱bo̱ xuajen niriꞌña̱a̱ ajngóo Efrón:</para>
  <para style="p" vid="GEN 23:13">―Xí nagruíguíín, na̱tha̱n-jáñaaꞌ rí ma̱ta̱dxawu̱nꞌ. Ikhúúnꞌ ma̱ne̱-númuu máꞌ mbaa rúꞌkhue̱n. A̱tri̱gúꞌ ne̱, ikhaa jngó ikhín gádi̱i̱ wa̱jen a̱ꞌgui̱ꞌ.<verse eid="GEN 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 23:14" />Xómáꞌ Efrón niriꞌña̱a̱ ajngóo Abraám:<verse eid="GEN 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 23:15" />―Táta̱, atadxawo̱nꞌ: mbaa rúꞌkhue̱n jámaa akho̱ siénto̱ mbúkha̱a̱ ajua̱nꞌ rí miꞌxá. Dí-lá ñajuun rúꞌkhue̱n ná majia̱nꞌlóꞌ rá. Athadi̱i̱ ja wa̱jen a̱ꞌgia̱a̱ꞌ.<verse eid="GEN 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 23:16" />A̱ꞌkhue̱n rí nigruígú a̱kui̱i̱n Abraám rí niꞌthán Efrón. Jamí nigiáwee̱n mbúkha̱a̱ rí mago̱ Efrón mbá xóo rí niꞌthée̱n. Inúú máꞌ mbo̱ xa̱bi̱i̱ Ét nigiáwee̱n akho̱ siénto̱ mbúkha̱a̱ ajua̱nꞌ rí miꞌxá, mbá xóo káxe̱ khiáwan ijmúú xa̱bo̱ tsí na̱ngu̱jua̱.<verse eid="GEN 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 23:17" />Xkuaꞌnii ni̱ngu̱jua̱a̱ mbayuu Efrón, rí ri̱ga̱ ná Makpéla̱ rí ꞌgí mijngi máꞌ Mámre̱, mbaa jamí iñúu itsí rí ríga̱ ikhín, xúꞌkhue̱n máꞌ mbá xúgíí máꞌ ixe̱ rí ríga̱ máꞌ ikhín. <verse eid="GEN 23:17" /><verse number="18" style="v" sid="GEN 23:18" />Mbaa rúꞌkhue̱n niꞌni̱i̱ la mbayuu Abraám. Neꞌne inúú xa̱bi̱i̱ Ét, xúꞌkhue̱n máꞌ inúú mbá xúgíin xa̱bo̱ tsí na̱tu̱ꞌúún ná rawuun xuajen, rí neꞌtse̱ Abraám mbaa rúꞌkhue̱n. <verse eid="GEN 23:18" /><verse number="19" style="v" sid="GEN 23:19" />Nda̱wa̱á a̱ꞌkhue̱n Abraám niꞌdi̱i̱ wa̱jen a̱ꞌgui̱i̱ ná iñúu itsí ná mbaa Makpéla̱ rí ꞌgí mijngi máꞌ Mámre̱, rí ikhaa máꞌ mbiꞌyuu Ebrón, ná mbayuu Kanaán. <verse eid="GEN 23:19" /><verse number="20" style="v" sid="GEN 23:20" />Xkuaꞌnii niwanúu ñawúun Abraám mbaa jamí iñúu itsí rí ríga̱ máꞌ ikhín, rí ma̱gi̱ꞌdoo̱ mbayuu̱ ná rí maꞌdii̱n a̱ngui̱i̱n, rí niꞌtsi̱i̱ ne̱ inúú xa̱bi̱i̱ Ét.<verse eid="GEN 23:20" /></para>
  <chapter eid="GEN 23" />
  <chapter number="24" style="c" sid="GEN 24" />
  <para style="s">Abraám ndaꞌyáa a̱ꞌgui̱i̱ Isaák</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1" />Abraám phú xi̱ꞌñú guéño máꞌ ñajuun, jamí Ana̱ꞌlóꞌ Mikhuíí naꞌne tsakun-rámaa̱ mbá xúgíí. <verse eid="GEN 24:1" /><verse number="2" style="v" sid="GEN 24:2" />A̱ꞌkhue̱n rí Abraám niꞌthúun mbáa yumbée, tsí i̱tha̱n mba̱a̱ tsigu nayumbáá ná goꞌóo̱, tsí naꞌthán-ñájuun mbá xúgíí rí gíꞌdoo̱:</para>
  <para style="p" vid="GEN 24:2">―Atagída̱ꞌ tháan ñawáanꞌ ná agoo sndi̱yu̱ꞌ, <verse eid="GEN 24:2" /><verse number="3" style="v" sid="GEN 24:3" />jngó ma̱ta̱xu̱ꞌdá-mina̱ꞌ inuu Ana̱ꞌlóꞌ Mikhuíí, ikhaa Ana̱ꞌlóꞌ tsí neꞌne mikhu jamí ju̱ba̱ꞌ, rí ma̱xíya̱a̱ mbáa a̱díín mbo̱ xa̱bi̱i̱ Kanaán rí ma̱ꞌne a̱ꞌgui̱i̱ a̱ꞌdéꞌ, maske máꞌ xtáá gajmíꞌ ge̱e̱. <verse eid="GEN 24:3" /><verse number="4" style="v" sid="GEN 24:4" />A̱ꞌkhue̱n gakon me̱dxo̱ꞌ ná xuajiu̱nꞌ ná inúú a̱ngui̱nꞌ, jamí ikhín mbi̱ya̱a̱ tsí ma̱ꞌne a̱ꞌgui̱i̱ a̱ꞌdéꞌ Isaák.<verse eid="GEN 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 24:5" />A̱ꞌkhue̱n niriꞌña̱a̱ yumbáá:</para>
  <para style="p" vid="GEN 24:5">―Gáꞌne xí ma̱xáxóo gáꞌkha̱ a̱ꞌgo̱ ga̱jma̱á nindxu̱ꞌ asndo ná xuajen ge̱e̱. Á ma̱ꞌgá ja̱ya̱a̱ a̱ꞌdeáaꞌ, ma̱ꞌga ná xuajen rí nidxájnaaꞌ rá.<verse eid="GEN 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 24:6" />Xómáꞌ Abraám niꞌthúu̱n:</para>
  <para style="p" vid="GEN 24:6">―A̱thia̱wa̱án-lá rí ma̱xídxú ꞌcháa a̱ꞌdéꞌ ikhín. <verse eid="GEN 24:6" /><verse number="7" style="v" sid="GEN 24:7" />Ana̱ꞌlóꞌ Mikhuíí, tsí niríñu̱ú máꞌ ná goꞌóo anu̱ꞌ jamí ná xuajiúún a̱ngui̱nꞌ, xúꞌkhue̱n máꞌ nixuda-mine̱e̱ꞌ rí niꞌthínꞌ: “Mbaa ríge̱ꞌ ma̱xnu̱úlo̱ꞌ xa̱bia̱a̱ꞌ”, ikhaa̱ máꞌ gáxuꞌmaa̱ ánje̱l drígo̱o̱ tsí mambáyáaꞌ, ikhaa jngó ñúꞌún mi̱dxa̱a̱ꞌ ꞌcháa tsí ma̱ꞌne a̱ꞌgui̱i̱ a̱ꞌdéꞌ. <verse eid="GEN 24:7" /><verse number="8" style="v" sid="GEN 24:8" />Jamí xí a̱ꞌgo̱ tsíyoo gáꞌkha̱ ga̱jma̱á nindxa̱a̱ꞌ, najríña̱á máꞌ inuu rí nataxúda-mina̱ꞌ ga̱jma̱á nindxu̱ꞌ xúꞌkhue̱n rá. I̱ndo̱ó rí ma̱xídxú ꞌcháa a̱ꞌdéꞌ ñúꞌún.<verse eid="GEN 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 24:9" />A̱ꞌkhue̱n rí yumbáá nigída̱ꞌ ñawúun ná agoo sndi̱yu̱u̱ꞌ xa̱bo̱ nikhi̱i̱ Abraám, jamí nixuda-mine̱e̱ꞌ rí ma̱ꞌne-mbánuu̱ ñajun ríge̱ꞌ. <verse eid="GEN 24:9" /><verse number="10" style="v" sid="GEN 24:10" />A̱ꞌkhue̱n rí yumbáá nigu̱u̱n mbá gu̱wi̱inꞌ xu̱kú kaméyo̱ tsí xu̱kuíi máꞌ táta̱ nikhi̱i̱, jamí niraꞌwíi̱ mbá xúgíí inii tsi̱gi̱jia̱nꞌ drígo̱o̱ máꞌ táta̱ nikhi̱i̱. A̱ꞌkhue̱n ndiyée̱ ikhoo̱, ni̱ga̱níi̱ asndo ná Mesopotámia̱ ná ꞌgí xuajiuun Nakór. <figure style="fig" alt="Caravana con 11 camellos" file="LB00040B.TIF" size="span" ref="24.10">Yumbée Abraám na̱ka̱ gánda̱ꞌa̱a̱ a̱ꞌgui̱i̱ Isaák.</figure> <verse eid="GEN 24:10" /><verse number="11" style="v" sid="GEN 24:11" />Ni̱ga̱níi̱ máꞌ ikhín ído̱ rí na̱ꞌkha̱-raꞌne wakhíí, ído̱ nagájnúú i̱jín-go̱ꞌo̱ gágúda iya. A̱ꞌkhue̱n niꞌnii̱ rí mu̱sma̱ti̱gu̱ún kaméyo̱ rí mbuya̱a̱ xu̱ún ná ꞌgí mbá iduu iya, ná rawuun máꞌ xuajen. <verse eid="GEN 24:11" /><verse number="12" style="v" sid="GEN 24:12" />A̱ꞌkhue̱n niꞌthée̱n: «Anu̱ꞌ Mikhuíí, Anu̱u̱ máꞌ xa̱bo̱ nikhi̱i̱ Abraám, na̱tha̱n-jáñaaꞌlo̱ꞌ rí ma̱gi̱ꞌdoo numuu rí na̱ne̱lo̱ꞌ xúge̱ꞌ, ikhaa jngó ma̱kujmaa rí nandaaꞌ xtayáá táta̱ Abraám. <verse eid="GEN 24:12" /><verse number="13" style="v" sid="GEN 24:13" />Ge̱jioꞌ xtáá xúge̱ꞌ rá, ná mijngi máꞌ iduu iya, jamí i̱ji̱ín xa̱bo̱ xuajen ríge̱ꞌ nagájnúú ruda iya. <verse eid="GEN 24:13" /><verse number="14" style="v" sid="GEN 24:14" />A̱ga̱ꞌne rí dxáꞌgú tsí ma̱thu̱u̱n ikhúúnꞌ: “Athañu̱ꞌ mbá rí máján, atrígú rayaaꞌ ma̱ga̱nꞌ tháan iyaaꞌ”, xómáꞌ ikhaa̱ gáriꞌña̱a̱: “Añi̱i̱, jamí mangaa ma̱xnu̱úlo̱ꞌ iya kaméya̱a̱ꞌ mu̱wa̱a̱n”, a̱ga̱ꞌne rí ikhaa tsúꞌkhue̱n ñajuun tsí nitraꞌwíi rí ma̱ꞌne a̱ꞌgui̱i̱ yumbiáaꞌ Isaák. Numuu rí xkuaꞌnii mba̱yo̱ rí nandaaꞌ xtayáá xa̱bo̱ nikhi̱i̱». <figure style="fig" alt="Siervo al pozo, señoritas" file="CO00668B.TIF" size="span" loc="24.13-14" ref="24.14">Ni̱ga̱nú yumbée Abraám ná nu̱ri̱ya̱ꞌ iya i̱jín-go̱ꞌo̱.</figure><verse eid="GEN 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 24:15" />Jamí asndo xóó máꞌ támbu̱u̱ ikhaa̱ raꞌthúu̱n Ana̱ꞌlóꞌ, ído̱ ndiꞌyoo̱ na̱ꞌkha̱ Rebéka̱, rígu raya ná xpaphuu. Ikhaa̱ ñajuun a̱dée Betuél, tsí ñajuun a̱dée Nakór ga̱jma̱á Mílka̱, dxíyo̱o̱ máꞌ Abraám. <verse eid="GEN 24:15" /><verse number="16" style="v" sid="GEN 24:16" />Xómáꞌ dxáꞌgú phú tsiꞌyáa, xúꞌkhue̱n máꞌ asndo nimbáa xa̱biya̱ tígu ga̱jmáa̱. Ikhaa̱ ni̱ga̱taa̱ ná iduu iya, a̱ꞌkhue̱n neꞌne majníi̱ rayoo̱. Inu máꞌ natanga̱a̱ <verse eid="GEN 24:16" /><verse number="17" style="v" sid="GEN 24:17" />ído̱ rí yumbáá mbá nacha̱ ni̱ke̱e̱ gáxkama̱a̱, jamí niꞌthúu̱n:</para>
  <para style="p" vid="GEN 24:17">―Na̱tha̱n-jáñaaꞌ rí ma̱ra̱xnu̱ꞌ mbá lájuíin iyaaꞌ ma̱ga̱nꞌ tháan, rí gajno̱ꞌ ná rayaaꞌ.<verse eid="GEN 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 24:18" />Xómáꞌ dxáꞌgú niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 24:18">―Añi̱i̱, Táta̱.</para>
  <para style="p" vid="GEN 24:18">Mbá nacha̱ neꞌne dxáꞌgú, nirígú rayoo ná xpaphuu, niguatuu̱n ne̱ ga̱jma̱á ñawúu̱n, jamí nixnúu̱ ma̱ga̱a̱n. <verse eid="GEN 24:18" /><verse number="19" style="v" sid="GEN 24:19" />Ído̱ rí wámbu̱u̱ máꞌ nixnée̱ iya niꞌña̱a̱ yumbáá, a̱ꞌkhue̱n niꞌthée̱n:</para>
  <para style="p" vid="GEN 24:19">―Ma̱ríya̱ꞌ iya mu̱wa̱a̱n kaméya̱a̱ꞌ mangiin, asndo náá gági̱ꞌmúú.<verse eid="GEN 24:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 24:20" />A̱ꞌkhue̱n rí mbá nacha̱ nitíjnga̱a̱ rayoo̱ ná rguwa, jamí nacha̱ máꞌ ni̱go̱ngoo̱ xóó iya, rí niwa̱a̱n mbá xúgíin kaméyo̱. <verse eid="GEN 24:20" /><verse number="21" style="v" sid="GEN 24:21" />Xómáꞌ yumbáá wíí wéje̱ nayaxu̱u̱ dxáꞌgú, ikhaa jngó mba̱ꞌyoo̱ xí Ana̱ꞌlóꞌ Mikhuíí naꞌne rí ma̱gi̱ꞌdoo numuu rí ni̱ꞌkhe̱e̱, o na̱nguá máꞌ mbo̱ꞌ.<verse eid="GEN 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 24:22" />Jamí ído̱ wámbu̱ún kaméyo̱ niwa̱a̱n iya, a̱ꞌkhue̱n rí yumbáá nixnúu̱ dxáꞌgú mbá xábí ajua̱nꞌ rí mo̱jmo̱ꞌ rí mbá tikhu síklo̱<note caller="+" style="f"><char style="fr" closed="false">24.22 </char><char style="ft" closed="false">Mbá tikhu «síklo̱» gíꞌdoo 6 grámo̱.</char></note> rí je̱ño̱ ne̱, jamí i̱jma̱ xábí aphu-ñawún rí mbá gu̱wa̱ꞌ síklo̱<note caller="+" style="f"><char style="fr" closed="false">24.22 </char><char style="ft" closed="false">Mbá gu̱wa̱ꞌ «síklo̱» gíꞌdoo 110 grámo̱.</char></note> rí je̱ño̱ ne̱. <figure style="fig" alt="Siervo, Rebecca con pulsera de oro" file="CO00669b.TIF" size="span" ref="24.22">Najanáá xábí dxáꞌgú eꞌne yumbáá.</figure> <verse eid="GEN 24:22" /><verse number="23" style="v" sid="GEN 24:23" />A̱ꞌkhue̱n niraxu̱u̱:</para>
  <para style="p" vid="GEN 24:23">―Tsáa a̱dée ñajuaanꞌ róꞌ. Arathúnꞌ tháan xí gaꞌchú goꞌóo ana̱a̱ꞌ rí mu̱wajúnxo̱ꞌ.<verse eid="GEN 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 24:24" />A̱ꞌkhue̱n niriꞌña̱a̱ ikhaa̱:</para>
  <para style="p" vid="GEN 24:24">―Ikhúúnꞌ ñaju̱nꞌ a̱dée Betuél tsí ñajuun a̱dée Nakór, tsí neꞌne ku̱maa̱ ga̱jmáa̱ Mílka̱. <verse eid="GEN 24:24" /><verse number="25" style="v" sid="GEN 24:25" />―Jamí niꞌthée̱n xóó―: Ná guꞌwáxo̱ꞌ phú ríga̱ náxne jamí ra̱xa̱, xúꞌkhue̱n máꞌ gaꞌchú ná rí mbu̱ya̱a̱ xa̱ꞌlaꞌ ikhín.<verse eid="GEN 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 24:26" />A̱ꞌkhue̱n rí yumbáá ni̱rnga̱du̱u̱n, jamí neꞌne-mba̱a̱ Ana̱ꞌlóꞌ Mikhuíí. <verse eid="GEN 24:26" /><verse number="27" style="v" sid="GEN 24:27" />Jamí niꞌthée̱n: «A̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ Mikhuíí tsí Anu̱u̱ máꞌ xa̱bo̱ nikhi̱i̱ Abraám, numuu rí támbumuu̱ rí gakon rí nandoo̱ jaꞌyoo̱ Abraám, ikhaa jngó ni̱ꞌkhe̱e̱-rasngájme̱ꞌ jambo̱o̱ guꞌúún a̱ngui̱i̱n xa̱bo̱ nikhi̱i̱».<verse eid="GEN 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 24:28" />A̱ꞌkhue̱n rí mbá nacha̱ ni̱ka̱a̱ dxáꞌgú ná goꞌóo náníi̱ gáꞌthée̱n rí xáꞌnii niríga̱. <verse eid="GEN 24:28" /><verse number="29" style="v" sid="GEN 24:29" />Xómáꞌ ikhaa̱, xtáa mbáa díye̱e̱ mbiꞌyuu Labán, tsúꞌkhue̱n mbá nacha̱ nigájnuu ni̱ka̱ gáyáa yumbáá ná iduu iya. <verse eid="GEN 24:29" /><verse number="30" style="v" sid="GEN 24:30" />Numuu rí wapha máꞌ ndiꞌyoo̱ xábí ga̱jma̱á rí traꞌa̱ ná ñawúun dxáguíi̱, jamí nidxawuu̱n rí naꞌthán dxáguíi̱: «Xkuaꞌnii-lá niꞌthínꞌ xa̱bo̱ tsúꞌkhue̱n jún». Ikhaa jngó Labán ni̱ka̱ gáꞌyoo ná wéje̱ xa̱bo̱ gajmíí kaméyo̱ ná iduu iya. <verse eid="GEN 24:30" /><verse number="31" style="v" sid="GEN 24:31" />A̱ꞌkhue̱n niꞌthúu̱n: «Aya̱, tsáán neꞌne tsakun-rámáá Ana̱ꞌlóꞌ Mikhuíí. Déjngó-lá gáwanáaꞌ ge̱e̱ rá. Numuu rí ne̱ne̱-mbánuu máꞌ guꞌwáá, jamí ná ma̱wajún xu̱kiáaꞌ».<verse eid="GEN 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 24:32" />A̱ꞌkhue̱n rí yumbáá ni̱ga̱nú asndo guꞌwáá. Xómáꞌ Labán nirakhúún xu̱kú, xúꞌkhue̱n máꞌ nixnúu̱ náxne ga̱jma̱á ra̱xa̱ rí mo̱pho̱. Mangaa máꞌ nixnée̱ iya rí ma̱gaꞌu̱u̱ nakhúu yumbáá, xúꞌkhue̱n máꞌ nakhúún xa̱bekha tsí ni̱ꞌkha̱ gajmíi̱. <verse eid="GEN 24:32" /><verse number="33" style="v" sid="GEN 24:33" />Xúꞌkhue̱n máꞌ nikuíje̱ inuu̱ rí mi̱khui̱i̱, xómáꞌ ikhaa̱ niꞌthée̱n:</para>
  <para style="p" vid="GEN 24:33">―Ma̱xákueꞌtsolo̱ꞌ asndo náá gátha̱n náá numuu jngó niꞌkha.</para>
  <para style="p" vid="GEN 24:33">Xómáꞌ Labán niꞌthán:</para>
  <para style="p" vid="GEN 24:33">―Arathán máꞌ.<verse eid="GEN 24:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 24:34" />A̱ꞌkhue̱n niꞌthée̱n:</para>
  <para style="p" vid="GEN 24:34">―Ikhúúnꞌ ñaju̱nꞌ yumbée Abraám. <verse eid="GEN 24:34" /><verse number="35" style="v" sid="GEN 24:35" />Ana̱ꞌlóꞌ Mikhuíí maphú neꞌne tsakun-rámaa táta̱ tsí naꞌthán-ñájui̱nꞌ, ikhaa jngó xtáa̱ mújúu̱n mi̱ndaꞌkho. Gíꞌdii̱n mogo̱ jamí xede̱, xúꞌkhue̱n máꞌ gíꞌdoo̱ ajua̱nꞌ miꞌxá ga̱jma̱á rí mo̱jmo̱ꞌ, gíꞌdii̱n yumbáá xa̱bekha jamí yumbáá go̱ꞌo̱, xúꞌkhue̱n máꞌ kaméyo̱ jamí xtá-ngidi. <verse eid="GEN 24:35" /><verse number="36" style="v" sid="GEN 24:36" />Xómáꞌ a̱ꞌgui̱i̱, tsí mbiꞌyuu Sára̱, neꞌne ku̱maa̱ mbáa a̱dée táta̱, rí xíñu máꞌ ñajuun. Jamí tsúꞌkhue̱n nijanáá mbá xúgíí rí gíꞌdoo anu̱u̱. <verse eid="GEN 24:36" /><verse number="37" style="v" sid="GEN 24:37" />Xúꞌkhue̱n máꞌ táta̱ nikhi̱i̱ neꞌne rí ma̱xu̱ꞌdá-mina̱ꞌ, jamí xáꞌnii niꞌthínꞌ: “Ma̱xíya̱a̱ mbáa a̱díín mbo̱ xa̱bi̱i̱ Kanaán ná rí mbañúu̱ máꞌ ge̱e̱ xtáá, rí ma̱ꞌne a̱ꞌgui̱i̱ a̱ꞌdéꞌ. <verse eid="GEN 24:37" /><verse number="38" style="v" sid="GEN 24:38" />A̱ꞌkhue̱n gakon rí me̱dxo̱ꞌ ná goꞌóo anu̱ꞌ ná júwá a̱ngui̱nꞌ, rí mbi̱ya̱a̱ mbáa tsí ma̱ꞌne a̱ꞌgui̱i̱ a̱ꞌdéꞌ”.<verse eid="GEN 24:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 24:39" />»Jamí ikhúúnꞌ ni̱thu̱u̱n: “Gáꞌne xí ma̱xáxóo a̱ꞌgo̱ gáꞌkha̱ ga̱jma̱á nindxu̱ꞌ rá”. <verse eid="GEN 24:39" /><verse number="40" style="v" sid="GEN 24:40" />A̱ꞌkhue̱n rí ikhaa̱ niriꞌñe̱ꞌ: “Ana̱ꞌlóꞌ Mikhuíí tsí naꞌkha-raxtáá inuu, ikhaa̱ gáxuꞌmaa̱ ánje̱l drígo̱o̱ ma̱ꞌga ga̱jma̱á nindxa̱a̱ꞌ, jamí ma̱ga̱jná májáanꞌ ná rí mi̱dxu̱ꞌ. Ikhaa jngó mbi̱ya̱a̱ mbáa tsí ma̱ꞌne a̱ꞌgui̱i̱ a̱ꞌdéꞌ, ná i̱ji̱ín a̱ngui̱nꞌ ná goꞌóo anu̱ꞌ. <verse eid="GEN 24:40" /><verse number="41" style="v" sid="GEN 24:41" />Mbóó máꞌ ríge̱ꞌ ma̱ꞌne rí ma̱jríña̱á rí nataxúda-mina̱ꞌ ga̱jma̱á nindxu̱ꞌ, xí rí tsíxniaa̱ꞌ máꞌ a̱ꞌgo̱ ído̱ gádxa̱ꞌnú ná júwa̱ꞌ a̱ngui̱nꞌ. A̱ꞌkhue̱n rí najríña̱á máꞌ rí nataxúda-mina̱ꞌ, xúꞌkhue̱n rá”.<verse eid="GEN 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 24:42" />»Nigánú xúge̱ꞌ ná iduu iya, jamí ni̱tha̱n: “Anu̱ꞌ Mikhuíí, Anu̱u̱ máꞌ xa̱bo̱ nikhi̱i̱ Abraám, xí rí ikháán nathane̱ rí ma̱gi̱ꞌdoo numuu ná nakalo̱ꞌ, <verse eid="GEN 24:42" /><verse number="43" style="v" sid="GEN 24:43" />xúge̱ꞌ rí nigánú máꞌlo̱ꞌ ná iduu iya ge̱e̱, a̱ga̱ꞌne rí dxáꞌgú tsí ma̱ꞌkha̱ gáyá iya, jamí ma̱thu̱u̱n: ‘Na̱tha̱n-jáñaaꞌ rí ma̱ra̱xnu̱ꞌ mbá lájuíin iyoo rayaaꞌ ma̱ga̱nꞌ tháan’, <verse eid="GEN 24:43" /><verse number="44" style="v" sid="GEN 24:44" />jamí ikhaa̱ gáriꞌña̱a̱: ‘Añi̱i̱, jamí mangaa ma̱ríya̱ꞌ iya mu̱wa̱a̱n xu̱kiáaꞌ’, ga̱ꞌne rí ikhaa a̱ꞌgo̱ tsúꞌkhue̱n ñajuun tsí nitraꞌwíi máꞌ, Anu̱ꞌ Mikhuíí, rí ma̱ꞌne a̱ꞌgui̱i̱ a̱dée xa̱bo̱ nikhi̱i̱”.<verse eid="GEN 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 24:45" />»Asndo xóó máꞌ támbu̱ꞌ-ra̱thu̱u̱n Ana̱ꞌlóꞌ ná awúun a̱kui̱nꞌ, ído̱ ndi̱yo̱o̱ na̱ꞌkha̱ Rebéka̱ jayá rayoo ná xpaphuu, ni̱ga̱taa̱ jamí niríye̱e̱ꞌ iya ná iduu iya. Xómáꞌ ikhúúnꞌ ni̱thu̱u̱n: “Na̱tha̱n-jáñaaꞌ rí ma̱ra̱xnu̱ꞌ tháan iyaaꞌ ma̱ga̱nꞌ”. <verse eid="GEN 24:45" /><verse number="46" style="v" sid="GEN 24:46" />Xómáꞌ ikhaa̱ mbá nacha̱ niríguíi̱ rayoo̱, jamí niꞌthée̱n: “Añi̱i̱, jamí mangaa ma̱xnu̱ú iya xu̱kiáaꞌ mu̱wa̱a̱n”. A̱ꞌkhue̱n rí niña̱ꞌ ne̱, xúꞌkhue̱n máꞌ niwa̱a̱n xu̱kú. <verse eid="GEN 24:46" /><verse number="47" style="v" sid="GEN 24:47" />A̱ꞌkhue̱n ni̱ra̱xu̱u̱: “Tsáa a̱dée ñajuaanꞌ róꞌ”. Xómáꞌ ikhaa̱ niriꞌña̱a̱: “A̱dée Betuél, tsí ñajuun a̱dée Nakór ga̱jma̱á Mílka̱”. A̱ꞌkhue̱n rí ni̱gída̱ꞌ xábí ná rakhóo̱ jamí ni̱skuáda̱ꞌ xábí ná aphuu ñawúu̱n. <verse eid="GEN 24:47" /><verse number="48" style="v" sid="GEN 24:48" />A̱ꞌkhue̱n ni̱rnga̱du̱u̱n rí ne̱ne̱-mba̱a̱ jamí ndi̱ya̱-makuu Ana̱ꞌlóꞌ Mikhuíí, Anu̱u̱ máꞌ xa̱bo̱ nikhi̱i̱ Abraám, numuu rí ni̱ꞌkha̱ jañúu̱ mbá jmbu jamba̱a̱ rí mba̱ya̱a̱ dxáꞌgú a̱dée dxíyo̱o̱ xa̱bo̱ nikhi̱i̱, rí mbayáa a̱dée̱. <verse eid="GEN 24:48" /><verse number="49" style="v" sid="GEN 24:49" />Ikhaa jngó xúge̱ꞌ rá, xí rí ikháa̱nꞌlaꞌ gakon rí nañáwíin a̱kia̱nꞌlaꞌ ju̱ya̱á xa̱bo̱ nikhi̱i̱, a̱gu̱tha̱n-málaꞌ. Jamí xí na̱nguá rá, a̱gu̱tha̱n-málaꞌ mangaa, ikhaa jngó mba̱yo̱ náá rí gáne̱, xúꞌkhue̱n rá.<verse eid="GEN 24:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 24:50" />A̱ꞌkhue̱n rí Labán ga̱jma̱á Betuél ni̱ri̱ꞌñaa̱:</para>
  <para style="p" vid="GEN 24:50">―Inuu Ana̱ꞌlóꞌ Mikhuíí na̱ꞌkha̱ ríge̱ꞌ. Ma̱xáxóo gútha̱a̱nꞌxo̱ꞌ xí máján ni máꞌ xí ra̱máján. <verse eid="GEN 24:50" /><verse number="51" style="v" sid="GEN 24:51" />Ge̱jioꞌ xtáa Rebéka̱ inaaꞌ. Ayáa̱ mi̱dxu̱u̱ꞌ, ikhaa jngó ma̱ꞌne a̱ꞌgui̱i̱ a̱dée xa̱bo̱ nikhi̱i̱ tsí naꞌthán-ñájuaanꞌ, xómá rí niꞌgí Ana̱ꞌlóꞌ Mikhuíí.<verse eid="GEN 24:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="GEN 24:52" />Ído̱ rí yumbée Abraám nidxawuun ajngúu̱n, nismáti̱go̱o̱ asndo mbayíí rí ndiya-makuu̱ Ana̱ꞌlóꞌ Mikhuíí. <verse eid="GEN 24:52" /><verse number="53" style="v" sid="GEN 24:53" />A̱ꞌkhue̱n rí ni̱gu̱wíi yumbáá xábí ajua̱nꞌ rí miꞌxá ga̱jma̱á rí mo̱jmo̱ꞌ, ga̱jma̱á máꞌ xtíñúú go̱ꞌo̱ jamí nixnúu̱ ne̱ Rebéka̱. Mangaa nixnúu̱ ja̱ꞌne rí mitsaan díye̱e̱ xúꞌkhue̱n máꞌ ru̱dúu. <verse eid="GEN 24:53" /><verse number="54" style="v" sid="GEN 24:54" />A̱ꞌkhue̱n rí nikuiꞌtsii̱ gajmíi̱ máꞌ xa̱bo̱ tsí niguwá ga̱jma̱á nindxu̱u̱, jamí ikhín máꞌ ninii̱ mbroꞌon rúꞌkhue̱n. Ído̱ rí ni̱gi̱xi̱i̱ miꞌcha̱, a̱ꞌkhue̱n niꞌthée̱n:</para>
  <para style="p" vid="GEN 24:54">―A̱gu̱ni̱ꞌñúꞌlaꞌ rí ma̱ꞌgáa̱ꞌ inuu xa̱bo̱ nikhi̱i̱ rá.<verse eid="GEN 24:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 24:55" />A̱ꞌkhue̱n rí niriꞌña̱a̱ díye̱e̱ ga̱jma̱á máꞌ ru̱dúu Rebéka̱:</para>
  <para style="p" vid="GEN 24:55">―Ga̱wanúu dxáꞌgú ga̱jma̱á nindxa̱ꞌxo̱ꞌ mbá gu̱wa̱ꞌ mbiꞌi wáa xóó, nda̱wa̱á a̱ꞌkhue̱n gáꞌgee̱.<verse eid="GEN 24:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 24:56" />Xómáꞌ ikhaa̱ niꞌthúu̱n:</para>
  <para style="p" vid="GEN 24:56">―Ma̱xúrekho̱ꞌlaꞌ, numuu rí Ana̱ꞌlóꞌ Mikhuíí neꞌne rí ma̱gi̱ꞌdoo numuu rí niꞌkhalo̱ꞌ. Ikhaa jngó a̱gu̱ni̱ꞌñúꞌlaꞌ rí ma̱ꞌgáa̱ꞌ inuu xa̱bo̱ nikhi̱i̱.<verse eid="GEN 24:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="GEN 24:57" />A̱ꞌkhue̱n ni̱ri̱ꞌñaa̱ ikhii̱n:</para>
  <para style="p" vid="GEN 24:57">―Mundxaꞌwáálóꞌ dxáꞌgú, jamí mu̱ra̱xíi̱lóꞌ.<verse eid="GEN 24:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="GEN 24:58" />A̱ꞌkhue̱n rí ni̱ndxa̱ꞌwáa̱ Rebéka̱, jamí nitháa̱n:</para>
  <para style="p" vid="GEN 24:58">―Á me̱dxo̱ꞌ ga̱jma̱a̱ꞌ xa̱bo̱ tsíge̱ꞌ ján rá.</para>
  <para style="p" vid="GEN 24:58">Xómáꞌ ikhaa̱ niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 24:58">―Aan, ma̱ꞌgálo̱ꞌ.<verse eid="GEN 24:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="GEN 24:59" />A̱ꞌkhue̱n rí ni̱ni̱ñáa̱ꞌ ma̱ꞌga Rebéka̱ ga̱jma̱á máꞌ nána̱ tsí nimédóo̱, xúꞌkhue̱n máꞌ ni̱ni̱ñáa̱ꞌ ma̱ꞌgaa̱ yumbée Abraám gajmíí xa̱bi̱i̱ máꞌ. <verse eid="GEN 24:59" /><verse number="60" style="v" sid="GEN 24:60" />Jamí nene̱ tsakun-rámaa̱ Rebéka̱, rí nitháa̱n:</para>
  <para style="q" vid="GEN 24:60">«Dxágiáxo̱ꞌ, ga̱nindxa̱a̱ꞌ ru̱dúún xa̱bo̱ tsí phú mbaꞌiin mi̱ndaꞌkho.</para>
  <para style="q" vid="GEN 24:60">Jamí xa̱bia̱a̱ꞌ guthan-ñajúún xuajiúún xa̱bo̱ sia̱nꞌ».<verse eid="GEN 24:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="GEN 24:61" />A̱ꞌkhue̱n rí ni̱tu̱xu̱u̱ Rebéka̱ gajmíí máꞌ i̱jín-go̱ꞌo̱ tsí nu̱mba̱yíi̱, a̱ꞌkhue̱n rí nithrámúu̱ kaméyo̱, jamí nigóo̱ tsu̱du̱u̱ xa̱bo̱. Xkuaꞌnii neꞌne yumbáá rí ni̱ka̱ gáyáa̱ Rebéka̱, jamí a̱ꞌkhue̱n ni̱ka̱a̱. <figure style="fig" alt="Rebeca se despide, en camello" file="CO00670B.TIF" size="span" ref="24.61">Naꞌthán-ngawúún a̱ngui̱i̱n Rebéka̱ rí na̱ka̱.</figure><verse eid="GEN 24:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="GEN 24:62" />Xómáꞌ Isaák, natanga̱a̱ máꞌ rí ni̱ka̱ ná iduu iya «Mbo̱ Ndaꞌya jamí Ndaꞌye̱ꞌ», numuu rí ná mbayuu Negéb xtáa̱. <verse eid="GEN 24:62" /><verse number="63" style="v" sid="GEN 24:63" />A̱ꞌkhue̱n Isaák ni̱ka̱ gándxaꞌwá-mina̱ꞌ mbá wakhíí wáa ná xanáá, jamí niyaxi̱i̱ ndiꞌyoo̱ rí naguwá kaméyo̱ ikhín. <verse eid="GEN 24:63" /><verse number="64" style="v" sid="GEN 24:64" />Xúꞌkhue̱n máꞌ Rebéka̱ mangaa niyaxe̱ jamí ndiꞌyoo̱ Isaák. A̱ꞌkhue̱n rí ni̱ga̱taa̱ tsu̱du̱u̱ kaméyo̱. <verse eid="GEN 24:64" /><verse number="65" style="v" sid="GEN 24:65" />Jamí niraxu̱u̱ yumbáá:</para>
  <para style="p" vid="GEN 24:65">―Tsáa-lá xa̱bi̱i̱ ñajuun tsí na̱ꞌkha̱ ná xanáá ñúꞌún gátsijnalóꞌ rá.</para>
  <para style="p" vid="GEN 24:65">Xómáꞌ yumbáá niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 24:65">―Ikhaa̱ ñajuu̱n xa̱bo̱ nikhi̱i̱.</para>
  <para style="p" vid="GEN 24:65">A̱ꞌkhue̱n ndiyée̱ xtíin, nirogoo̱ inuu̱.<verse eid="GEN 24:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="GEN 24:66" />A̱ꞌkhue̱n rí yumbáá niꞌthúun Isaák mbá xúgíí rí neꞌne. <verse eid="GEN 24:66" /><verse number="67" style="v" sid="GEN 24:67" />Xómáꞌ Isaák ni̱ꞌkha̱ jayáa̱ Rebéka̱ ná guꞌwá xtíin rí neꞌne drígo̱o̱ ru̱dúu̱. A̱ꞌkhue̱n rí ni̱grui̱guíi̱ rí neꞌne a̱ꞌgui̱i̱, jamí phú neꞌne a̱kui̱i̱n jaꞌyoo̱. Xkuaꞌnii niꞌni̱i̱ a̱kui̱i̱n Isaák rí nijáñuu ru̱dúu̱.<verse eid="GEN 24:67" /></para>
  <chapter eid="GEN 24" />
  <chapter number="25" style="c" sid="GEN 25" />
  <para style="s">Xa̱bo̱ ri̱jiu̱u̱ꞌ Abraám ga̱jma̱á Setúra̱</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1" />Abraám ndiyáa̱ i̱mba̱a̱ a̱ꞌgo̱, tsí mbiꞌyuu Setúra̱. <verse eid="GEN 25:1" /><verse number="2" style="v" sid="GEN 25:2" />Jamí ikhaa̱ niꞌnii̱ e̱je̱n ga̱jmáa̱ Abraám: Simrám, Joksán, Medán, Madián, Isbák jamí Súwa̱. <verse eid="GEN 25:2" /><verse number="3" style="v" sid="GEN 25:3" />Xómáꞌ Joksán ni̱gu̱mii i̱ji̱i̱n tsí ñajúún Séba̱ ga̱jma̱á Dedán. Xómáꞌ xa̱bo̱ ri̱jiu̱u̱ꞌ Dedán ñajúún xa̱bi̱i̱ Asúr, xa̱bi̱i̱ Letús jamí xa̱bi̱i̱ Leúm. <verse eid="GEN 25:3" /><verse number="4" style="v" sid="GEN 25:4" />Xómáꞌ i̱ji̱i̱n Madián ñajúún Éfa̱, Efér, Anók, Abída̱ jamí Élda̱. Xúgíin tsíge̱ꞌ ñajúún xa̱bo̱ ri̱jiu̱u̱ꞌ Setúra̱.<verse eid="GEN 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 25:5" />A̱ꞌkhue̱n rí Isaák ni̱ri̱daa̱ mbá xúgíí rí gíꞌdoo Abraám. <verse eid="GEN 25:5" /><verse number="6" style="v" sid="GEN 25:6" />Xómáꞌ i̱ji̱i̱n tsí iꞌwíin gu̱ꞌwi̱i̱ Abraám rá, mbámbá ríga̱ rí nixnúu̱. Awúun máꞌ rí xóó xtáa̱ ndaꞌyee̱, nixuꞌmii̱ nigóó tsíngua̱ꞌ ná mbaa na̱ꞌkha̱ a̱kha̱ꞌ. I̱ndo̱ó Isaák niwanúu ga̱jma̱á anu̱u̱.<verse eid="GEN 25:6" /></para>
  <para style="s">Nijáñuu Abraám jamí waꞌdi̱i̱</para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7" />Abraám nixtáa mbá migiñuu skíñú gu̱wa̱ꞌ-nítsu (175) tsigu. <verse eid="GEN 25:7" /><verse number="8" style="v" sid="GEN 25:8" />A̱ꞌkhue̱n rí ni̱ka̱ xu̱u̱ꞌ Abraám, jamí nijáñuu̱ mújúu̱n, nimbáxi̱i̱ꞌ gajmíi̱ a̱ngui̱i̱n ído̱ rí xi̱ꞌñú guéño máꞌ ñajuu̱n. <verse eid="GEN 25:8" /><verse number="9" style="v" sid="GEN 25:9" />A̱ꞌkhue̱n rí waꞌdi̱i̱ nene̱ i̱ji̱i̱n, Isaák ga̱jma̱á Ismaél, ná iñúu itsí ná máꞌ Makpéla̱ ná mbayuu Efrón mbo̱ a̱dée Soár tsí xa̱bi̱i̱ Ét, rí ꞌgí máꞌ ná mijngi Mámre̱. <verse eid="GEN 25:9" /><verse number="10" style="v" sid="GEN 25:10" />Mbaa máꞌ rúꞌkhue̱n neꞌtse̱ Abraám inúú xa̱bi̱i̱ Ét, jamí ikhín máꞌ waꞌdi̱i̱ Abraám, ná máꞌ waꞌdi̱i̱ Sára̱ tsí a̱ꞌgui̱i̱. <verse eid="GEN 25:10" /><verse number="11" style="v" sid="GEN 25:11" />Nda̱wa̱á ído̱ rí nijáñuu máꞌ Abraám, Ana̱ꞌlóꞌ neꞌne tsakun-rámaa Isaák. Jamí nixtáa̱ ná mijngi iduu iya «Mbo̱ Ndaꞌya jamí Ndaꞌye̱ꞌ».<verse eid="GEN 25:11" /></para>
  <para style="s">Tsí ñajúún xa̱bo̱ ri̱jiu̱u̱ꞌ Ismaél</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12" />Tsíge̱ꞌ ñajúún xa̱bo̱ ri̱jiu̱u̱ꞌ Ismaél, a̱dée máꞌ Abraám, tsí niꞌnii̱ ga̱jmáa̱ Agár mbo̱ Ejípto̱, yumbée máꞌ Sára̱. <verse eid="GEN 25:12" /><verse number="13" style="v" sid="GEN 25:13" />Xáꞌnii mbiꞌñúú i̱ji̱i̱n Ismaél, xómáꞌ ni̱ꞌkha̱ ra̱gu̱mii̱: xa̱bo̱ tsí ginii mbiꞌyuu Nebayót, i̱ꞌkha̱a̱ la Sedár, Adbeél, Mibsám, <verse eid="GEN 25:13" /><verse number="14" style="v" sid="GEN 25:14" />Mísma̱, Dúma̱, Mássa̱, <verse eid="GEN 25:14" /><verse number="15" style="v" sid="GEN 25:15" />Adár, Téma̱, Jetúr, Náfi̱s jamí Sedéma̱. <verse eid="GEN 25:15" /><verse number="16" style="v" sid="GEN 25:16" />Tsúꞌkhue̱n ñajúún mbá gue̱jmi̱i̱ i̱ji̱i̱n Ismaél, xómáꞌ mbiꞌyuu xuajiúu̱n jamí ná triga̱ guꞌwúu̱n. Mbámbáa iꞌthán-ñájuun mbámbá kothon inúú a̱ngui̱i̱n. <verse eid="GEN 25:16" /><verse number="17" style="v" sid="GEN 25:17" />Ismaél nixtáa mbá majuun skíñú gu̱wa̱ꞌ-nítsu i̱jma̱ (137) tsigu. A̱ꞌkhue̱n rí ni̱ka̱ xu̱u̱ꞌ jamí nijáñuu̱, ni̱ke̱e̱ gámbáxii̱ꞌ gajmíi̱ a̱ngui̱i̱n. <verse eid="GEN 25:17" /><verse number="18" style="v" sid="GEN 25:18" />A̱ꞌkhue̱n rí xa̱bi̱i̱ Ismaél nijúwá ná mbaa rí jayá asndo ná Abíla̱ asndo ná Súr, rí ꞌgí inuu Ejípto̱, ná jambo̱o̱ Asíria̱. Ismaél nijáñuu máꞌ inúú mbá xúgíin a̱ngui̱i̱n.<note caller="+" style="f"><char style="fr" closed="false">25.18 </char><char style="ft" closed="false">Ikhaa máꞌ ajngáa ebréo̱ rí wayuu naxná i̱mba̱ ju̱ma̱ rí xáꞌnii: «Ikhiin xa̱bi̱i̱ máꞌ Ismaél nene̱ tsíngua̱ꞌ-mi̱jna̱ ná inúú máꞌ xúgíin a̱ngui̱i̱n», xó rí iꞌthán ná 16.12.</char></note><verse eid="GEN 25:18" /></para>
  <para style="s">Xáne ni̱gu̱maa Jakób ga̱jma̱á Esaú</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19" />Tsíge̱ꞌ ñajúún xa̱bo̱ ri̱jiu̱u̱ꞌ Isaák. Rí ikhaa̱, a̱dée máꞌ Abraám ñajuu̱n. <verse eid="GEN 25:19" /><verse number="20" style="v" sid="GEN 25:20" />Ikhaa̱ gíꞌdoo̱ a̱jma̱ skíñú (40) tsiguu̱ ído̱ rí ndiyáa̱ Rebéka̱, a̱dée máꞌ Betuél, xa̱bo̱ Arám tsí xtáa máꞌ ná Padán-arám, dxáguíi máꞌ Labán mbo̱ Arám. <verse eid="GEN 25:20" /><verse number="21" style="v" sid="GEN 25:21" />A̱ꞌkhue̱n rí Isaák niꞌthán-jáñuu Ana̱ꞌlóꞌ Mikhuíí ga̱jma̱á numuu a̱ꞌgui̱i̱, numuu rí tsíyoo gágo̱-édoo̱. Xómáꞌ Ana̱ꞌlóꞌ Mikhuíí nidxawuun, a̱ꞌkhue̱n rí nigo̱-éda Rebéka̱. <verse eid="GEN 25:21" /><verse number="22" style="v" sid="GEN 25:22" />Xómáꞌ i̱ji̱i̱n na̱ra̱tuun-mi̱jna̱ ná awúu̱n, ikhaa jngó niꞌthée̱n: «Xí rí xkuaꞌñúú, náá-lá numuu jngó gáxtáá rá». A̱ꞌkhue̱n ni̱ke̱e̱ gáraxu̱u̱ Ana̱ꞌlóꞌ Mikhuíí. <verse eid="GEN 25:22" /><verse number="23" style="v" sid="GEN 25:23" />Xómáꞌ Ana̱ꞌlóꞌ Mikhuíí niriꞌña̱a̱:</para>
  <para style="q" vid="GEN 25:23">«A̱jma̱ xuajen mba̱ꞌo̱ ríga̱ ná awáanꞌ.</para>
  <para style="q" vid="GEN 25:23">Jamí ná awáanꞌ a̱jma̱ xuajen marakhú wájíí-mina̱ꞌ.</para>
  <para style="q" vid="GEN 25:23">Mbá xuajen ma̱ꞌne i̱tháan gakhi̱i̱ xóo rí i̱mba̱ xuajen.</para>
  <para style="q" vid="GEN 25:23">Jamí tsí nikhi̱i̱ mayumbáá-rámuu inuu tsí lájuíin».<verse eid="GEN 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 25:24" />Ído̱ rí ni̱ga̱nú mbiꞌi rí ma̱ꞌne xuajii̱n, a̱ꞌkhue̱n nikujmaa rí a̱jmi̱i̱ e̱je̱n-xpa gatiin awúu̱n. <verse eid="GEN 25:24" /><verse number="25" style="v" sid="GEN 25:25" />Tsí ni̱gu̱maa ginii xání jamí maña̱ꞌ idxu̱u̱, xúꞌkhue̱n máꞌ phú tsa̱wi̱i̱n mbá xúgíi̱ꞌ, asndo xó mbá xtá rí tsu̱u̱n jaꞌnii̱. Ikhaa̱ neꞌne mbiꞌyuu̱ Esaú. <verse eid="GEN 25:25" /><verse number="26" style="v" sid="GEN 25:26" />Nda̱wa̱á ni̱gu̱maa ge̱ꞌthe̱e̱ Esaú, tsúꞌkhue̱n kuatuun xtuun nakhúu̱ ga̱jma̱á ñawúun. Ikhaa̱ neꞌne mbiꞌyuu Jakób. Xómáꞌ Isaák gíꞌdoo atsú skíñú (60) tsiguu̱ ído̱ rí neꞌne xuajiin a̱ꞌgui̱i̱.<verse eid="GEN 25:26" /></para>
  <para style="s">Esaú na̱ngu̱jua̱ rí jaꞌyoo ma̱grui̱gú rí xa̱bo̱ ginii ñajuun</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27" />A̱ꞌkhue̱n rí ni̱ka̱-ragaꞌnuu e̱je̱n. Esaú ninindxu̱u̱ xa̱bo̱ tsí phú máján nadúún xu̱kú-xáná, jamí na̱ni̱gu̱u̱ꞌ wáa ma̱ꞌgee̱ xanáá. Xómáꞌ Jakób mbá jmbu a̱kui̱i̱n, na̱ni̱gu̱u̱ꞌ ma̱xtáa̱ ná guꞌwáá. <verse eid="GEN 25:27" /><verse number="28" style="v" sid="GEN 25:28" />Xómáꞌ Isaák nandoo̱ jaꞌyoo̱ Esaú, numuu rí naꞌkhúu̱n xu̱kú tsí naxnúú a̱dée̱. Xómáꞌ Rebéka̱ rá, nandoo̱ jaꞌyoo̱ Jakób.<verse eid="GEN 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 25:29" />Mbá mbiꞌi Jakób naꞌne-mújúun mbá ganitsu a̱wa̱n, ído̱ rí Esaú níꞌngo̱o̱ i̱ꞌkha̱a̱ ná xanáá. <verse eid="GEN 25:29" /><verse number="30" style="v" sid="GEN 25:30" />A̱ꞌkhue̱n niꞌthúu̱n Jakób:</para>
  <para style="p" vid="GEN 25:30">―Na̱tha̱n-jáñaaꞌ rí ma̱ra̱xnu̱ꞌ tháan ganitsu rí maña̱ꞌ a̱ꞌkhue̱n me̱ꞌkholo̱ꞌ, numuu rí phú níꞌngo̱ꞌ na̱xki̱dxu̱ꞌ. (Ikhaa jngó neꞌne mbiꞌyuu̱ Edóm.)<note caller="+" style="f"><char style="fr" closed="false">25.30 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, mbiꞌyuu Edóm nawán wáa xó iwán ajngáa «maña̱ꞌ». Athiyáá ná 25.25.</char></note><verse eid="GEN 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 25:31" />Xómáꞌ Jakób niriꞌña̱a̱ ajngóo̱:</para>
  <para style="p" vid="GEN 25:31">―A̱ta̱ngo̱jo̱ꞌ ginii rí jaꞌyoo ma̱tri̱gú rí xa̱bo̱ ginii ñajuaanꞌ má.<verse eid="GEN 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 25:32" />A̱ꞌkhue̱n niꞌthán Esaú:</para>
  <para style="p" vid="GEN 25:32">―Á ra̱ꞌkhá natiaxi̱í máꞌ rí nandó gájáñu̱ꞌ rí na̱xki̱dxu̱ꞌ rá. Náá-lá gíꞌdoo numuu rí xa̱bo̱ ginii ñaju̱nꞌ rá.<verse eid="GEN 25:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 25:33" />Xómáꞌ Jakób niꞌthán:</para>
  <para style="p" vid="GEN 25:33">―Ataxúda-mina̱ꞌ máꞌ xúge̱ꞌ, ná inu̱ꞌ má.</para>
  <para style="p" vid="GEN 25:33">A̱ꞌkhue̱n Esaú nixuda-mina̱ꞌ. Xkuaꞌnii ni̱ngu̱jua̱a̱ inuu Jakób rí jaꞌyoo ma̱grui̱guíi̱ rí xa̱bo̱ ginii ñajuu̱n. <verse eid="GEN 25:33" /><verse number="34" style="v" sid="GEN 25:34" />A̱ꞌkhue̱n rí Jakób nixnúu Esaú guma ga̱jma̱á yaja lentéja̱ rí a̱wa̱n. A̱ꞌkhue̱n rí nikuiꞌtsii̱, jamí ni̱tu̱xu̱u̱ ni̱ke̱e̱. Xkuaꞌnii jaꞌnii rí na̱nguá ndiyá-makuu Esaú rí xa̱bo̱ ginii ñajuun.<verse eid="GEN 25:34" /></para>
  <chapter eid="GEN 25" />
  <chapter number="26" style="c" sid="GEN 26" />
  <para style="s">Isaák na̱ka̱ ná Jerár</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1" />Nda̱wa̱á a̱ꞌkhue̱n niríga̱ ewe ná mbaa rúꞌkhue̱n, mbáá máꞌ ewe xóo rí niríga̱ nákhí mbiꞌi rí nixtáa Abraám. Ikhaa jngó ni̱ka̱ Isaák ná mbaa Jerár, ná xtáa máꞌ Abimelék, xa̱bo̱ tsí naꞌthán-ñájúún mbo̱ filistéo̱. <verse eid="GEN 26:1" /><verse number="2" style="v" sid="GEN 26:2" />Jamí ikhín nikujmaa Ana̱ꞌlóꞌ Mikhuíí inuu̱, jamí waꞌtháa̱n: «Ma̱xádxa̱taa-lá ná Ejípto̱, araxtaa máꞌ mbaa ná rí ma̱tha̱a̱nꞌlo̱ꞌ ikhúúnꞌ. <verse eid="GEN 26:2" /><verse number="3" style="v" sid="GEN 26:3" />Araxtaa máꞌ naꞌcho̱o̱ ná mbaa ríge̱ꞌ, jamí ma̱xtáá ga̱jma̱á nindxa̱a̱ꞌ, xúꞌkhue̱n máꞌ ma̱ne̱ tsakun-rámáá. Numuu rí ikháán máꞌ jamí xa̱bia̱a̱ꞌ ma̱xnu̱ú xúgíí mbaa ríge̱ꞌ, jngó xkuaꞌnii ma̱ne̱-mbánuu awan rí ni̱xu̱ꞌdá-mina̱ꞌ ga̱jme̱ꞌ ana̱a̱ꞌ Abraám. <verse eid="GEN 26:3" /><verse number="4" style="v" sid="GEN 26:4" />Ma̱ne̱ rí ma̱mi̱diúún mi̱ndaꞌkho xa̱bia̱a̱ꞌ asndo xóo a̱ꞌgua̱án mikhu, jamí ma̱xnúu̱ xúgíí mbaa ríge̱ꞌ. Xúꞌkhue̱n máꞌ ga̱jma̱á numúú xa̱bia̱a̱ꞌ ma̱gu̱ma-tsakun-ráma xúgíí xuajen inuu numba̱a̱. <verse eid="GEN 26:4" /><verse number="5" style="v" sid="GEN 26:5" />Numuu rí Abraám nidxawuu̱nꞌ rí ni̱thu̱u̱n, jamí neꞌne-mbánuu̱ rí ni̱xna̱-ñájuu̱n, xúꞌkhue̱n máꞌ neꞌne-mbánuu̱ xtángawo̱ꞌ, mangaa máꞌ rí ni̱sngóo̱».<verse eid="GEN 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 26:6" />Ikhaa jngó nixtáa Isaák ná Jerár. <verse eid="GEN 26:6" /><verse number="7" style="v" sid="GEN 26:7" />Xómáꞌ xa̱bo̱ tsí júwá máꞌ ikhín nu̱ra̱xíi̱ ga̱jma̱á numuu a̱ꞌgui̱i̱. A̱ꞌkhue̱n ikhaa̱ niꞌthúu̱n: «Dxáguíꞌ ñajuu̱n», numuu rí namíñuu̱ gáꞌthée̱n rí a̱ꞌgui̱i̱ ñajuun. Na̱ju̱mu̱u̱ rí xa̱bo̱ tsí júwá ikhín ma̱ja̱ñúu̱ góne̱ ga̱jma̱á numuu Rebéka̱, numuu rí phú tsiꞌyá wáa giaxu̱u̱. <verse eid="GEN 26:7" /><verse number="8" style="v" sid="GEN 26:8" />Nda̱wa̱á ído̱ rí ni̱ka̱-ranújngoo máꞌ mbiꞌi rí xtáa̱ ikhín, a̱ꞌkhue̱n rí Abimelék, tsí naꞌthán-ñájúún mbo̱ filistéo̱, niyaxi̱i̱ ná mbá iduu guꞌwá, ndiꞌyoo̱ rí Isaák naꞌne xkaꞌtsoo Rebéka̱. <verse eid="GEN 26:8" /><verse number="9" style="v" sid="GEN 26:9" />A̱ꞌkhue̱n rí Abimelék nindxaꞌwóo̱ Isaák, jamí niꞌthúu̱n:</para>
  <para style="p" vid="GEN 26:9">―Áa̱n, gakon máꞌ rí ikhaa̱ ñajuu̱n a̱ꞌgia̱a̱ꞌ jno̱ꞌ. Náá numuu jngó nirathán: “Dxáguíꞌ ñajuu̱n”, xúꞌkhue̱n rá.</para>
  <para style="p" vid="GEN 26:9">Xómáꞌ Isaák niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 26:9">―Numuu rí ni̱ju̱mu̱ꞌ: “Gáꞌne xí ma̱ja̱ñúꞌ ga̱jma̱á numuu̱ ikhaa̱”.<verse eid="GEN 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 26:10" />Abimelék niꞌthán:</para>
  <para style="p" vid="GEN 26:10">―Déjngó nithaña̱ꞌxo̱ꞌ ríge̱ꞌ róꞌ. Rí i̱lájuíin gáꞌne rí mi̱gu mbáa xa̱bo̱ máꞌ ge̱e̱ ga̱jma̱á a̱ꞌgia̱a̱ꞌ. A̱ꞌkhue̱n rí ikháán ma̱tha̱ne̱ rí ma̱xu̱ꞌdá-míjnáxo̱ꞌ aꞌkhán.<verse eid="GEN 26:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 26:11" />Ikhaa jngó Abimelék niꞌthúún xúgíin xa̱bo̱ xuajen: «Tsí ma̱jmaa xa̱biya̱ tsíge̱ꞌ o a̱ꞌgui̱i̱, gakon rí ma̱ja̱ñúu xa̱bo̱ tsúꞌkhue̱n gáne̱».<verse eid="GEN 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 26:12" />Xómáꞌ Isaák niꞌdu ná mbaa rúꞌkhue̱n, jamí ikhaa máꞌ tsigu rúꞌkhue̱n nigu̱u̱ mbá witsu skíñú (100) rí mbóó niꞌdii̱, numuu rí Ana̱ꞌlóꞌ Mikhuíí naꞌne tsakun-rámaa̱. <verse eid="GEN 26:12" /><verse number="13" style="v" sid="GEN 26:13" />A̱ꞌkhue̱n rí ikhaa̱ ni̱ka̱ ra̱ge̱ꞌdoo̱ mi̱ndaꞌkho, jamí ni̱ka̱-raxtáa̱ mújúu̱n guéño, asndo náá neꞌne xa̱bo̱ mba̱a̱ ñajuu̱n. <verse eid="GEN 26:13" /><verse number="14" style="v" sid="GEN 26:14" />Ni̱gi̱ꞌdii̱n mi̱ndaꞌkho mogo̱, xede̱, jamí xúꞌkhue̱n máꞌ yumbáá, ikhaa jngó nixígu̱ún mbo̱ filistéo̱ juyáa̱. <verse eid="GEN 26:14" /><verse number="15" style="v" sid="GEN 26:15" />Jamí xúgíí iduu iya rí nindi yumbée Abraám tsí anu̱u̱ máꞌ Isaák nákhí mbiꞌi rí nixtáa̱, ikhiin máꞌ mbo̱ filistéo̱ ni̱rugua̱a̱ ne̱ ga̱jma̱á ju̱ba̱ꞌ. <verse eid="GEN 26:15" /><verse number="16" style="v" sid="GEN 26:16" />A̱ꞌkhue̱n rí Abimelék niꞌthúun Isaák: «Ayu janíí ná majia̱nꞌxo̱ꞌ, numuu rí phú i̱tháan neꞌne mba̱a̱ ski̱ya̱a̱ꞌ ikháán xóo rí ikháa̱nꞌxo̱ꞌ».<verse eid="GEN 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 26:17" />Ikhaa jngó nigájna̱a̱ Isaák ikhín, jamí niskuíji̱i̱ guꞌwá xtíin ná xko̱o̱ máꞌ Jerár, jamí ikhín máꞌ nixtáa̱. <verse eid="GEN 26:17" /><verse number="18" style="v" sid="GEN 26:18" />A̱ꞌkhue̱n rí Isaák nirmáꞌtha̱a̱ mbu̱júu̱ xúgíí iduu iya rí waꞌndi máꞌ nákhí mbiꞌi rí nixtáa anu̱u̱, numuu rí mbo̱ filistéo̱ ni̱rugua̱a̱ ne̱ nákhí rí nijáñuu máꞌ Abraám. Jamí ikhaa máꞌ nixnúu̱ mbiꞌyuu mbámbá xóo rí nixná mbiꞌyuu máꞌ anu̱u̱. <verse eid="GEN 26:18" /><verse number="19" style="v" sid="GEN 26:19" />Jamí mbá mbiꞌi ído̱ nundi yumbée Isaák ná mbaa xkua̱, ikhín ni̱xka̱maa̱ mbá iduu iya rí nangútáꞌán. <verse eid="GEN 26:19" /><verse number="20" style="v" sid="GEN 26:20" />Xómáꞌ waxtú mbo̱ Jerár ni̱tsa̱ñúu̱ gajmíi̱ waxtíi Isaák, rí nithee̱n: «Iya dríga̱ꞌxo̱ꞌ ñajuun ne̱». Ikhaa jngó Isaák nixnúu mbiꞌyuu ne̱ «Xkujndu», numuu rí ni̱tsa̱ñúu̱ ga̱jma̱á numuu ne̱. <verse eid="GEN 26:20" /><verse number="21" style="v" sid="GEN 26:21" />A̱ꞌkhue̱n ni̱rma̱ꞌtháa̱ i̱mba̱ iduu iya, jamí mangaa máꞌ ne̱ niguaꞌdáa̱ xkujndu. Ikhaa jngó nixnúu̱ mbiꞌyuu ne̱ «Sia̱nꞌ». <verse eid="GEN 26:21" /><verse number="22" style="v" sid="GEN 26:22" />A̱ꞌkhue̱n rí Isaák niríya̱ꞌ-mina̱ꞌ ikhín, jamí nirmáꞌthoo̱ i̱mba̱ iduu iya. Nánguá máꞌ niríga̱ xkujndu ga̱jma̱á numuu ne̱. A̱ꞌkhue̱n nixnúu̱ mbiꞌyuu ne̱ «Mbaa ma̱jia̱nꞌ», jamí niꞌthée̱n: «Asndo xúge̱ꞌ Ana̱ꞌlóꞌ Mikhuíí naꞌne rí ma̱juwalóꞌ ná ma̱jia̱nꞌ, ikhaa jngó ma̱ge̱do̱o̱ꞌ rí mo̱ꞌne̱lóꞌ ná inuu mbaa ríge̱ꞌ».<verse eid="GEN 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 26:23" />Ikhín máꞌ nigájna̱a̱ nitsima̱a̱ asndo ná Beerséba̱. <verse eid="GEN 26:23" /><verse number="24" style="v" sid="GEN 26:24" />Ikhaa máꞌ mbroꞌon rúꞌkhue̱n nikujmaa Ana̱ꞌlóꞌ Mikhuíí inuu̱, jamí waꞌtháa̱n: «Ikhúúnꞌ ñaju̱nꞌ Anu̱u̱ máꞌ ana̱a̱ꞌ Abraám. Ma̱xámíñaaꞌ, numuu rí ikhúúnꞌ xtáá ga̱jma̱á nindxa̱a̱ꞌ, jamí ma̱ne̱ tsakun-rámáá, xúꞌkhue̱n máꞌ ma̱ne̱ rí ma̱mi̱diúún mi̱ndaꞌkho xa̱bia̱a̱ꞌ, numuu rí ra̱ꞌkhá-tháán naꞌne a̱kui̱nꞌ ja̱yo̱o̱ yumbéꞌ Abraám».<verse eid="GEN 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 26:25" />Ikhín ni̱rngu̱xi̱i̱ itsí, jamí nixrégo̱o̱ mbiꞌyuu Ana̱ꞌlóꞌ Mikhuíí. Ikhín máꞌ nitsijii̱ goꞌóo̱, xúꞌkhue̱n máꞌ nindi yumbée̱ mbá iduu iya.<verse eid="GEN 26:25" /></para>
  <para style="s">Isaák ga̱jma̱á Abimelék naguáꞌníi̱ mbá awan</para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26" />A̱ꞌkhue̱n rí Abimelék tsí xtáa ná Jerár, ni̱ꞌkha̱ gáꞌyoo Isaák, ga̱jmáa̱ Ausát xa̱bo̱ iyanga̱jua̱ drígo̱o̱, xúꞌkhue̱n máꞌ mangaa Fikól, xa̱bo̱ ginii tsí jayá ikhúún xa̱bo̱ ajua̱nꞌ. <verse eid="GEN 26:26" /><verse number="27" style="v" sid="GEN 26:27" />Xómáꞌ Isaák niꞌthúu̱n:</para>
  <para style="p" vid="GEN 26:27">―Náá rí jngó iguwalaꞌ gúyo̱ꞌ, xí phú tséꞌne máꞌ a̱kia̱nꞌlaꞌ ju̱yo̱ꞌ, jamí asndo ni̱xkriñu̱únlaꞌ ná mbayalaꞌ rá.<verse eid="GEN 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 26:28" />A̱ꞌkhue̱n ikhii̱n ni̱ri̱ꞌñaa̱:</para>
  <para style="p" vid="GEN 26:28">―Numuu rí ndu̱yááxo̱ꞌ rí Ana̱ꞌlóꞌ Mikhuíí xtáa ga̱jma̱á nindxa̱a̱ꞌ, ikhaa jngó ni̱tha̱n-míjnáxo̱ꞌ rí jaꞌyoo rí ma̱xu̱ꞌdá-míjnálóꞌ mbá awan xúge̱ꞌ, ikháán jamí ikháa̱nꞌxo̱ꞌ. <verse eid="GEN 26:28" /><verse number="29" style="v" sid="GEN 26:29" />Ma̱xátha̱ña̱ꞌxo̱ꞌ rí ra̱máján, xómáꞌ ikháa̱nꞌxo̱ꞌ túña̱a̱xo̱ꞌ nimbá rí ra̱máján. I̱ndo̱ó máꞌ rí máján ni̱ña̱a̱ꞌxo̱ꞌ, xúꞌkhue̱n máꞌ gagi ni̱tha̱n-ngáwaaꞌxo̱ꞌ. Ndu̱ya̱á-máxo̱ꞌ rí Ana̱ꞌlóꞌ Mikhuíí naꞌne tsakun-rámáá.<verse eid="GEN 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 26:30" />A̱ꞌkhue̱n rí Isaák neꞌne-mújúun rí mu̱phi̱i̱ jamí rí mu̱wa̱a̱n, niꞌnii̱ mbá ndxa̱a̱. <verse eid="GEN 26:30" /><verse number="31" style="v" sid="GEN 26:31" />Rí watse rí i̱mba̱ mbiꞌi, phú miꞌcha̱ niguáxuu̱n jngó ma̱xu̱da̱ꞌ-mi̱jne̱e̱ awan. A̱ꞌkhue̱n rí Isaák niꞌthán-ngawúu̱n, xúꞌkhue̱n máꞌ mangii̱n nithán-ngawíi̱ Isaák ga̱jma̱á gagi.<verse eid="GEN 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 26:32" />Ikhaa máꞌ mbiꞌi rúꞌkhue̱n niguáꞌnúu̱ yumbée Isaák, jamí nitháa̱n ga̱jma̱á numuu iduu iya rí ni̱rma̱ꞌtháa̱: «Ni̱xkamaa-láxo̱ꞌ iya rá».<verse eid="GEN 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 26:33" />Nixnúu̱ mbiꞌyuu ne̱ Séba̱. Ga̱jma̱á numuu ríge̱ꞌ neꞌne mbiꞌyuu xuajen rúꞌkhue̱n Beerséba̱ asndo máꞌ mbiꞌi xúge̱ꞌ.<verse eid="GEN 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34" />Xómáꞌ Esaú ja rá, ído̱ gíꞌdoo̱ a̱jma̱ skíñú tsigu, a̱ꞌkhue̱n ndiyáa̱ Judít rí ma̱ꞌne a̱ꞌgui̱i̱, a̱dée Béri̱ mbo̱ Ét. Jamí mangaa ndiyáa̱ Basemát, a̱dée Elón mbo̱ máꞌ Ét. <verse eid="GEN 26:34" /><verse number="35" style="v" sid="GEN 26:35" />A̱ꞌkhue̱n rí ikhii̱n nene̱ maꞌkhu̱u̱ a̱kui̱i̱n Isaák ga̱jma̱á Rebéka̱.<verse eid="GEN 26:35" /></para>
  <chapter eid="GEN 26" />
  <chapter number="27" style="c" sid="GEN 27" />
  <para style="s">Isaák naꞌne tsakun-rámaa Jakób</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1" />Ído̱ Isaák neꞌne xi̱ꞌñú guéño máꞌ ñajuun, jamí nánguá ifrigu̱u̱, a̱ꞌkhue̱n mbá mbiꞌi niꞌthúu̱n Esaú, a̱dée̱ tsí nikhi̱i̱:</para>
  <para style="p" vid="GEN 27:1">―A̱ꞌdéꞌ, Esaú.</para>
  <para style="p" vid="GEN 27:1">Xómáꞌ ikhaa̱ niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 27:1">―Ge̱jioꞌ máꞌ xtáá, táa̱.<verse eid="GEN 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 27:2" />A̱ꞌkhue̱n niꞌthán Isaák:</para>
  <para style="p" vid="GEN 27:2">―Nathayáá máꞌ rí xi̱ꞌñú guéño ñaju̱nꞌlo̱ꞌ, jamí tsíyo̱lo̱ꞌ náá mbiꞌi gájáñu̱ꞌ. <verse eid="GEN 27:2" /><verse number="3" style="v" sid="GEN 27:3" />Ikhaa jngó xúge̱ꞌ rá, ada xkamídáaꞌ ga̱jma̱á xkuíyu̱u̱ xkamídá. Ayu xanáá gátha̱ꞌyáa mbáa xu̱kú-xáná, jamí aya̱a̱ꞌ ꞌcháa̱ꞌ. <verse eid="GEN 27:3" /><verse number="4" style="v" sid="GEN 27:4" />Jamí athane̱ májáa̱nꞌ ganitsu xóo rí na̱ni̱gu̱ꞌ, xúꞌkhue̱n máꞌ aya̱ ꞌcháa ne̱ rí me̱ꞌkholo̱ꞌ. Ikhaa jngó ma̱ne̱ tsakun-rámáá rí xóó máꞌ tsíjáñu̱ꞌ.<verse eid="GEN 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 27:5" />Xómáꞌ Rebéka̱ nidxawuun rí Isaák nandxákuun ga̱jma̱á Esaú. A̱ꞌkhue̱n rí ni̱ka̱ Esaú xanáá gáꞌyáa xu̱kú-xáná tsí waꞌtháa̱n ma̱ꞌkha̱ jayáa̱. <verse eid="GEN 27:5" /><verse number="6" style="v" sid="GEN 27:6" />A̱ꞌkhue̱n Rebéka̱ niꞌthúun Jakób:</para>
  <para style="p" vid="GEN 27:6">―Atadxawíín rí xúge̱ꞌ, ikhúúnꞌ ni̱dxawuun rí nindxákuun ana̱a̱ꞌ ga̱jma̱á dxíya̱a̱ꞌ Esaú, rí niꞌthúu̱n xáꞌnii: <verse eid="GEN 27:6" /><verse number="7" style="v" sid="GEN 27:7" />“Ayu gátha̱ꞌyáa mbáa xu̱kú-xáná, jamí athane̱ májáa̱nꞌ mbá ganitsu rí me̱ꞌkholo̱ꞌ, a̱ꞌkhue̱n rí ma̱ne̱ tsakun-rámáá inuu Ana̱ꞌlóꞌ Mikhuíí rí xóó máꞌ tsíjáñu̱ꞌ”. <verse eid="GEN 27:7" /><verse number="8" style="v" sid="GEN 27:8" />Ikhaa jngó xúge̱ꞌ rá, a̱ꞌdéꞌ, a̱tse̱mbáníí rí ma̱tha̱a̱nꞌ, jamí rí ma̱xna̱-ñájuaanꞌ rí ma̱tha̱ne̱. <verse eid="GEN 27:8" /><verse number="9" style="v" sid="GEN 27:9" />Ayu xúge̱ꞌ ná gatiin xu̱kú, jamí aya̱ xtiin a̱jmi̱i̱ i̱jín-tsútúún tsí i̱tha̱n májíin, ikhaa jngó ma̱ne̱ májíi̱n mbá ganitsu rí me̱kho̱ ana̱a̱ꞌ, mbá xóo rí na̱ni̱gu̱u̱ꞌ jayuu̱ ikhaa̱. <verse eid="GEN 27:9" /><verse number="10" style="v" sid="GEN 27:10" />A̱ꞌkhue̱n rí ikháán mi̱dxu̱ꞌ ꞌcháa ne̱ inuu ana̱a̱ꞌ rí me̱kho̱, ikhaa jngó ma̱ꞌne tsakun-rámaa̱ rí xóó máꞌ tsíjáñuu̱.<verse eid="GEN 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 27:11" />Xómáꞌ Jakób niꞌthúun ru̱dúu:</para>
  <para style="p" vid="GEN 27:11">―Ká nathayáá máꞌ rí dxíyo̱ꞌ Esaú ñajuun mbáa xa̱bo̱ tsí phú tsa̱wi̱i̱n, xómáꞌ ikhúúnꞌ rá, mirángiu̱ún. <verse eid="GEN 27:11" /><verse number="12" style="v" sid="GEN 27:12" />Gáꞌne xí maxkajmúú anu̱ꞌ, jamí mba̱ꞌyoo̱ rí na̱ne̱-ndúwaa̱. A̱ꞌkhue̱n rí maxná-múꞌúu̱n, ra̱ꞌkhá-lá rí ma̱ꞌne tsakun-rámúu̱.<verse eid="GEN 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 27:13" />Xómáꞌ ru̱dúu̱ niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 27:13">―A̱ꞌdéꞌ, ga̱ꞌne máꞌ rí ikhúúnꞌ gágruígú rí mi̱ꞌxná-maꞌáán. I̱ndo̱ó a̱tse̱mbáníí rí na̱tha̱a̱nꞌ, ayu ja gádxídiin tsí na̱tha̱a̱nꞌ.<verse eid="GEN 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 27:14" />A̱ꞌkhue̱n rí ikhaa̱ ni̱ke̱e̱ gágu̱u̱n, jamí ni̱ꞌkha̱a̱ jagu̱u̱n inuu ru̱dúu̱. Xómáꞌ ru̱dúu̱ neꞌne-mújúu̱n ganitsu, xóo rí na̱ni̱gu̱u̱ꞌ jayuu anu̱u̱. <figure style="fig" alt="Rebeca y Jacob preparan comida" file="CO00677b.tif" size="span" ref="27.14">Na̱gu̱ma-mújúun ganitsu rí me̱kho̱ anu̱u̱ Jakób.</figure> <verse eid="GEN 27:14" /><verse number="15" style="v" sid="GEN 27:15" />Xúꞌkhue̱n máꞌ ni̱gu̱wíi̱ xtíñuu Esaú, a̱dée̱ tsí nikhi̱i̱, rí i̱tha̱n máján gíꞌdoo̱ ná guꞌwáá, jamí ikhaa ne̱ nitsuaꞌaa̱n Jakób, a̱dée̱ tsí lájuíin. <verse eid="GEN 27:15" /><verse number="16" style="v" sid="GEN 27:16" />Mangaa nirogoo̱ ga̱jma̱á xtúún i̱jín-tsútúún ná ñawúun jamí ná aphuu Jakób, ná rí nda̱a̱ tsu̱u̱n. <verse eid="GEN 27:16" /><verse number="17" style="v" sid="GEN 27:17" />A̱ꞌkhue̱n rí nixnáxu̱u̱ Jakób ganitsu ga̱jma̱á guma rí neꞌne-mújúu̱n.<verse eid="GEN 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 27:18" />Xómáꞌ ikhaa̱, ni̱ke̱e̱ jayóo̱ ne̱ inuu anu̱u̱, jamí niꞌthúu̱n:</para>
  <para style="p" vid="GEN 27:18">―Táa̱.</para>
  <para style="p" vid="GEN 27:18">Xómáꞌ Isaák niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 27:18">―Jáa̱n rá. Tsáa-lá a̱ꞌdéꞌ ñajuaanꞌ ján rá.<verse eid="GEN 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 27:19" />A̱ꞌkhue̱n rí Jakób niꞌthúun anu̱u̱:</para>
  <para style="p" vid="GEN 27:19">―Ikhúúnꞌ ñaju̱nꞌ Esaú, a̱ꞌdeáaꞌ tsí ginii. Ne̱ne̱-lá mbánuu xóo rí nirathúnꞌ rá. Na̱tha̱n-jáñaaꞌ rí ma̱raxu̱u̱nꞌ, rí ma̱raꞌún jamí me̱ꞌtso rí nika gáꞌyá xanáá, ikhaa jngó ma̱tha̱ne̱ tsakun-rámúú.<verse eid="GEN 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 27:20" />A̱ꞌkhue̱n Isaák niraxu̱u̱ a̱dée:</para>
  <para style="p" vid="GEN 27:20">―Xáne rí phú wapha nitaxkamaa̱ róꞌ, a̱ꞌdéꞌ.</para>
  <para style="p" vid="GEN 27:20">Xómáꞌ ikhaa̱ niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 27:20">―Numuu rí Ana̱ꞌlóꞌ Mikhuíí, tsí Ana̱a̱ꞌ máꞌ, niꞌnii̱ rí ma̱xkamaa̱ wapha.<verse eid="GEN 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 27:21" />A̱ꞌkhue̱n Isaák iꞌthúun Jakób:</para>
  <para style="p" vid="GEN 27:21">―Ataxúꞌma-mina̱ꞌ tháan, a̱ꞌdéꞌ, ikhaa jngó ma̱goo ma̱xkajmáá mba̱yo̱o̱ xí rí a̱ꞌdéꞌ Esaú ñajuaanꞌ, o ra̱ꞌkháa máꞌ mbo̱ꞌ.<verse eid="GEN 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 27:22" />A̱ꞌkhue̱n rí nixuꞌma-mina̱ꞌ Jakób ná inuu anu̱u̱, xómáꞌ ikhaa̱ nixkajmaa̱, jamí niꞌthée̱n:</para>
  <para style="p" vid="GEN 27:22">―Aꞌwóo Jakób ñajuun rí aꞌwóo̱, i̱ndo̱ó numuu rí ñawúu̱n, ñawúun máꞌ Esaú ñajuun ne̱.<verse eid="GEN 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 27:23" />Xkuaꞌnii táꞌne-nuwii̱n, numuu rí ñawúu̱n phú tsu̱u̱n xómá ñawúun Esaú, ikhaa jngó ndiyoo̱ máꞌ gáꞌne tsakun-rámaa̱. <verse eid="GEN 27:23" /><verse number="24" style="v" sid="GEN 27:24" />I̱ndo̱ó numuu rí niraxu̱u̱ xóó:</para>
  <para style="p" vid="GEN 27:24">―Á gakon rí a̱ꞌdéꞌ Esaú ñajuaanꞌ rá.</para>
  <para style="p" vid="GEN 27:24">Xómáꞌ Jakób niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 27:24">―Aan, ikhúúnꞌlo̱ꞌ.<verse eid="GEN 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 27:25" />A̱ꞌkhue̱n Isaák niꞌthán:</para>
  <para style="p" vid="GEN 27:25">―Aya̱ ꞌcháa ne̱ mijngi, jamí me̱ꞌkho rí nidxu̱ꞌ gátha̱ꞌyá xanáá, ikhaa jngó ma̱ne̱ tsakun-rámáálo̱ꞌ.</para>
  <para style="p" vid="GEN 27:25">A̱ꞌkhue̱n rí nixuꞌma ne̱ Jakób, jamí nikueꞌtso anu̱u̱. Mangaa ni̱ꞌkha̱ jayóo̱ iyoo úba̱ rí ni̱ga̱yu̱u̱ꞌ, jamí niꞌña̱a̱ anu̱u̱. <verse eid="GEN 27:25" /><verse number="26" style="v" sid="GEN 27:26" />A̱ꞌkhue̱n niꞌthán anu̱u̱:</para>
  <para style="p" vid="GEN 27:26">―Ataxúꞌma-mina̱ꞌ ná inu̱ꞌ a̱ꞌdéꞌ, jamí atraꞌnu̱ꞌ tháan. <figure style="fig" alt="Isaac bendice a Jacob" file="CO00679B.TIF" size="span" ref="27.27">Isaák naꞌne tsakun-rámaa Jakób.</figure><verse eid="GEN 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 27:27" />A̱ꞌkhue̱n rí Jakób nixuꞌma-mina̱ꞌ, xúꞌkhue̱n máꞌ niraꞌnuu̱ inuu anu̱u̱. Xómáꞌ Isaák ndiyá xu̱u̱ꞌ xtíñuu̱, jamí neꞌne tsakun-rámaa̱ rí niꞌthée̱n ajngáa ríge̱ꞌ:</para>
  <para style="q" vid="GEN 27:27">«Jéén-lá, ndaa thawiin a̱ꞌdéꞌ,</para>
  <para style="q" vid="GEN 27:27">asndo xóo ndaa thawuun xanáá, rí neꞌne tsakun-rámuu Ana̱ꞌlóꞌ Mikhuíí.<verse eid="GEN 27:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="GEN 27:28" />Ana̱ꞌlóꞌ gáxnáaꞌ ruꞌwa rí na̱ꞌkha̱ ná mikhu,</para>
  <para style="q" vid="GEN 27:28">xúꞌkhue̱n máꞌ mbá xúgíí rí najma̱a̱ inuu ju̱ba̱ꞌ,</para>
  <para style="q" vid="GEN 27:28">jamí gaxnáa̱ꞌ mi̱ndaꞌkho ixí iña ga̱jma̱á máꞌ iyoo úba̱.<verse eid="GEN 27:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="GEN 27:29" />Ga̱nindxu̱ún yumbiáaꞌ xa̱bo̱ mbaꞌa xuajen,</para>
  <para style="q" vid="GEN 27:29">jamí xúgíin xa̱bo̱ xuajen mba̱ꞌo̱ a̱gu̱sma̱ti̱gúún inaaꞌ.</para>
  <para style="q" vid="GEN 27:29">Arathán-ñájúún ikháán a̱ngia̱a̱nꞌ,</para>
  <para style="q" vid="GEN 27:29">jamí a̱gu̱sma̱ti̱gúún i̱ji̱i̱n ru̱dáaꞌ inaaꞌ.</para>
  <para style="q" vid="GEN 27:29">Gi̱ꞌxná-máꞌíin tsí nuxna-maꞌáán,</para>
  <para style="q" vid="GEN 27:29">jamí ga̱gu̱ma-tsakun-rámii tsí máján ithan numaaꞌ».<verse eid="GEN 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30" />Ído̱ rí inu máꞌ wámbo̱o̱ Isaák rí neꞌne tsakun-rámaa̱ Jakób, jamí níkhú jayu nigájna̱a̱ Jakób inuu anu̱u̱, a̱ꞌkhue̱n ni̱ga̱núu̱ Esaú rí ni̱ka̱ gáꞌyáa xu̱kú-xáná. <verse eid="GEN 27:30" /><verse number="31" style="v" sid="GEN 27:31" />Xúꞌkhue̱n máꞌ mangaa̱ neꞌne-mújúu̱n ganitsu, jamí ni̱ka̱ jayóo̱ ne̱ inuu anu̱u̱. A̱ꞌkhue̱n niꞌthúu̱n:</para>
  <para style="p" vid="GEN 27:31">―Araxu̱u̱nꞌ rá, táa̱, rí me̱ꞌtso rí nika gáꞌyá xanáá rá, ikhaa jngó ma̱tha̱ne̱ tsakun-rámúú.<verse eid="GEN 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 27:32" />A̱ꞌkhue̱n Isaák niraxe̱:</para>
  <para style="p" vid="GEN 27:32">―Tsáa-lá ñajuaanꞌ ján rá.</para>
  <para style="p" vid="GEN 27:32">Xómáꞌ ikhaa̱ niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 27:32">―Ikhúúnꞌ ñaju̱nꞌ Esaú, a̱ꞌdeáaꞌ tsí ginii.<verse eid="GEN 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 27:33" />A̱ꞌkhue̱n rí Isaák maphú gakhe̱ niguaꞌaa̱n jamí niꞌthée̱n:</para>
  <para style="p" vid="GEN 27:33">―Tsáa-lá ñajuun tsí ni̱ꞌkha̱ máꞌ ge̱jioꞌ, jamí ni̱ꞌkha̱ jayóo̱ ganitsu-xáná, rí nixníꞌ nikho ne̱ mbá xúgíí, rí inu máꞌ ma̱dxa̱ꞌnúu̱ꞌ ikháán rá. Xómáꞌ ikhúúnꞌ ne̱ne̱ tsakun-rámaa̱, jamí gakon rí ma̱gu̱ma-tsakun-rámaa̱.<verse eid="GEN 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 27:34" />Ído̱ rí Esaú nidxawuun ajngóo anu̱u̱, phú gakhe̱ nindxaꞌwá-skee̱ jamí ra̱ꞌkhá-tháán natájuíin a̱kui̱i̱n. A̱ꞌkhue̱n niꞌthúu̱n anu̱u̱:</para>
  <para style="p" vid="GEN 27:34">―Athane̱ tsakun-rámúú tháan mangúún, táa̱.<verse eid="GEN 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 27:35" />A̱ꞌkhue̱n Isaák niꞌthúu̱n:</para>
  <para style="p" vid="GEN 27:35">―Ni̱ꞌkha̱ dxíya̱a̱ꞌ neꞌne-nduwúún, jamí ikhaa̱ ni̱grui̱guíi̱ rí jaꞌyoo ma̱gu̱ma-tsakun-rámáá ikháán.<verse eid="GEN 27:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 27:36" />Xómáꞌ Esaú niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 27:36">―Áa̱n, ikhaa jngó neꞌne mbiꞌyuu̱ Jakób<note caller="+" style="f"><char style="fr" closed="false">27.36 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, mbiꞌyuu Jakób naꞌthán-wíi̱ «naꞌne-nduwa».</char></note> jno̱ꞌ. Tiriajma̱ máꞌ nothon rí naꞌne-nduwúu̱n. Nirígú-jáꞌyéꞌ rí xa̱bo̱ ginii ñaju̱nꞌ, jamí xúge̱ꞌ rá, narígú-jáꞌyéꞌ rí ma̱gu̱ma-tsakun-rámúú. ―A̱ꞌkhue̱n niꞌthée̱n xóó―: Á nánguá niwanúu tháan rí ma̱tha̱ne̱ tsakun-rámúú ikhúúnꞌ rá dxe̱ꞌ.<verse eid="GEN 27:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 27:37" />A̱ꞌkhue̱n Isaák niriꞌña̱a̱ ajngóo Esaú:</para>
  <para style="p" vid="GEN 27:37">―Nángí ni̱ꞌgíi̱ꞌlo̱ꞌ rí maꞌthán-ñájuaa̱nꞌ, xúꞌkhue̱n máꞌ xúgíin dxíyo̱o̱ ma̱nindxu̱ún yumbée̱, jamí mangaa ni̱tha̱n rí ma̱gi̱ꞌdoo̱ ixí iña ga̱jma̱á máꞌ iyoo úba̱. Xómáꞌ ikháán rá, a̱ꞌdéꞌ, náá-lá rí gáne̱ ga̱jma̱á nindxa̱a̱ꞌ ján rá.<verse eid="GEN 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 27:38" />A̱ꞌkhue̱n Esaú niꞌthúun xóó anu̱u̱:</para>
  <para style="p" vid="GEN 27:38">―Á phú mbóó rí xtaꞌdáá rí ma̱tha̱ne̱ tsakun-ráma jngó rá dxe̱ꞌ, táa̱. Athane̱ tsakun-rámúú tháan mangúún, táa̱.</para>
  <para style="p" vid="GEN 27:38">A̱ꞌkhue̱n rí nigíꞌdu̱u̱ Esaú ni̱mbi̱ya̱ꞌ gakhe̱. <verse eid="GEN 27:38" /><verse number="39" style="v" sid="GEN 27:39" />A̱ꞌkhue̱n Isaák niꞌthúu̱n:</para>
  <para style="q" vid="GEN 27:39">«Athayáá rí xúge̱ꞌ ma̱ra̱xtaa tsíngua̱ꞌ ná inuu ju̱ba̱ꞌ rí máján,</para>
  <para style="q" vid="GEN 27:39">xúꞌkhue̱n máꞌ ná na̱ga̱taa ruꞌwa mikhu.<verse eid="GEN 27:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="GEN 27:40" />Ga̱jma̱á chídia̱aꞌ ma̱thiambá-mina̱ꞌ,</para>
  <para style="q" vid="GEN 27:40">jamí ma̱nindxa̱a̱ꞌ yumbáá inuu dxíya̱a̱ꞌ.</para>
  <para style="q" vid="GEN 27:40">Ído̱ gága̱nú mbiꞌi rí mbi̱ya̱ ski̱ya̱a̱ꞌ,</para>
  <para style="q" vid="GEN 27:40">a̱ꞌkhue̱n ma̱trígúu̱ ná rixa̱a̱ꞌ ixu̱u̱ xkandajoo̱ rí natiumbá-rámaaꞌ».<verse eid="GEN 27:40" /></para>
  <para style="s">Jakób nagáyuu inuu Esaú</para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 27:41" />A̱ꞌkhue̱n rí Esaú níyoo gáꞌyoo Jakób ga̱jma̱á numuu rí ni̱gu̱ma-tsakun-rámaa̱ neꞌne anu̱u̱. Ikhaa jngó Esaú nindxaꞌwá-mina̱ꞌ: «Ma̱ga̱nú mbiꞌi rí ma̱ja̱ñúu anu̱ꞌ. Ído̱ ágánújngoo gaꞌkho̱, a̱ꞌkhue̱n rí ma̱xíya̱a̱ dxíyo̱ꞌ Jakób». <verse eid="GEN 27:41" /><verse number="42" style="v" sid="GEN 27:42" />Ído̱ rí waꞌtháán Rebéka̱ ajngáa rawuun Esaú, a̱dée̱ máꞌ tsí nikhi̱i̱, xómáꞌ ikhaa̱ nindxaꞌwáa̱, Jakób, a̱dée̱ tsí lájuíin, jamí niꞌthúu̱n:</para>
  <para style="p" vid="GEN 27:42">―Athadxuun-lá rá, rí dxíya̱a̱ꞌ Esaú naꞌni̱i̱ a̱kui̱i̱n, numuu rí naꞌgí-mine̱e̱ꞌ rí maxíñaa̱, méꞌ. <verse eid="GEN 27:42" /><verse number="43" style="v" sid="GEN 27:43" />Ikhaa jngó xúge̱ꞌ rá, a̱ꞌdéꞌ, a̱tse̱mbáníí rí ma̱tha̱a̱nꞌ. Atagáyaaꞌ xúge̱ꞌ jamí ayu ná goꞌóo dxáju̱ꞌ Labán, ná Arán. <verse eid="GEN 27:43" /><verse number="44" style="v" sid="GEN 27:44" />Araxtaa ga̱jma̱a̱ꞌ nguátha̱ máꞌ mbiꞌi, asndo náá gáxríguu̱ a̱kui̱i̱n dxíya̱a̱ꞌ rí najiꞌnáa. <verse eid="GEN 27:44" /><verse number="45" style="v" sid="GEN 27:45" />Asndo gágáꞌni̱i̱ máján wáa a̱kui̱i̱n jaꞌyaaꞌ, jamí ma̱mbumuu̱ wáa rí nithaníi̱, a̱ꞌkhue̱n rí ikhúúnꞌ ma̱ndxa̱ꞌwa̱a̱ꞌlo̱ꞌ rí mi̱dxa̱a̱ꞌ ge̱e̱. Déjngó-lá gándáti̱go̱ꞌ ná-a̱jmaa̱ꞌlaꞌ, rí mbóó mbiꞌi rá.<verse eid="GEN 27:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 27:46" />A̱ꞌkhue̱n rí Rebéka̱ niꞌthúun Isaák:</para>
  <para style="p" vid="GEN 27:46">―Tsigajmá ríga̱ ná awúun a̱kui̱nꞌ jún rá, ga̱jma̱á numúú go̱ꞌo̱ tsíge̱ꞌ i̱ji̱ín mbo̱ Ét. Xí Jakób gáyáa mbáa a̱ꞌgo̱ i̱ji̱ín mbo̱ Ét, mbo̱ máꞌ júwa̱ꞌ ná mbaa ríge̱ꞌ, náá-lá numuu jngó gáxtáá xóó xúꞌkhue̱n rá.<verse eid="GEN 27:46" /></para>
  <para style="b" />
  <chapter eid="GEN 27" />
  <chapter number="28" style="c" sid="GEN 28" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1" />A̱ꞌkhue̱n rí Isaák nindxaꞌwóo Jakób, jamí neꞌne tsakun-rámaa̱, xúꞌkhue̱n máꞌ niꞌthúu̱n:</para>
  <para style="p" vid="GEN 28:1">―Ma̱xíya̱a̱-lá nimbáa a̱díín mbo̱ Kanaán ge̱e̱. <verse eid="GEN 28:1" /><verse number="2" style="v" sid="GEN 28:2" />Ayu máꞌ ná Padán-arám, ná goꞌóo Betuél, anu̱u̱ máꞌ ru̱dáaꞌ, jamí ayáa mbáa a̱dée Labán, díye̱e̱ máꞌ ru̱dáaꞌ. <verse eid="GEN 28:2" /><verse number="3" style="v" sid="GEN 28:3" />Jamí Ana̱ꞌlóꞌ tsí Gíꞌdoo Xúgíí Tsiakhe̱ gáꞌne tsakun-rámáá, rí maxniáa̱ꞌ i̱jia̱a̱nꞌ rí ma̱mi̱diúún mi̱ndaꞌkho, asndo náá gáꞌne mbaꞌa xuajen ñajúu̱n. <verse eid="GEN 28:3" /><verse number="4" style="v" sid="GEN 28:4" />Ikhaa̱ gáꞌne tsakun-rámáá, xúꞌkhue̱n máꞌ xa̱bia̱a̱ꞌ, ga̱jma̱á máꞌ rí nijanáá Abraám, ikhaa jngó ma̱goo ma̱nújnga̱a̱ꞌ ná ñawáanꞌ mbaa ná xtaa naꞌcho̱o̱ xúge̱ꞌ, rí Ana̱ꞌlóꞌ nixnáxu̱u̱ máꞌ Abraám.<verse eid="GEN 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 28:5" />Xkuaꞌnii neꞌne Isaák rí nixuꞌmaa̱ Jakób rí ma̱ꞌga ná Padán-arám, ná goꞌóo Labán mbo̱ a̱dée Betuél mbo̱ Arám. Labán ñajuun díye̱e̱ máꞌ Rebéka̱ tsí ru̱dúu Jakób ga̱jma̱á Esaú.<verse eid="GEN 28:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 28:6" />Xómáꞌ Esaú, ndiꞌyoo̱ xáne ni̱gu̱ma-tsakun-rámaa Jakób neꞌne Isaák, xúꞌkhue̱n máꞌ rí waxuꞌmaa̱ ná Padán-arám, rí ma̱ꞌgee̱ gánigúu̱nꞌ ikhín. Mangaa máꞌ ndiꞌyoo̱ rí waꞌxná-ñájuíi̱n: «Ma̱xíya̱a̱-lá asndo nimbáa a̱ꞌgo̱ a̱díín mbo̱ Kanaán». <verse eid="GEN 28:6" /><verse number="7" style="v" sid="GEN 28:7" />Xúꞌkhue̱n máꞌ ndiꞌyoo̱ rí Jakób nidxawuun rí niꞌthán anu̱u̱ ga̱jma̱á máꞌ ru̱dúu̱, a̱ꞌkhue̱n rí ni̱ke̱e̱ ná Padán-arám. <verse eid="GEN 28:7" /><verse number="8" style="v" sid="GEN 28:8" />Mangaa máꞌ ndiꞌyoo Esaú rí go̱ꞌo̱ i̱ji̱ín mbo̱ Kanaán tsígruígú a̱kui̱i̱n anu̱u̱. <verse eid="GEN 28:8" /><verse number="9" style="v" sid="GEN 28:9" />A̱ꞌkhue̱n rí ni̱ka̱ Esaú ná xtáa Ismaél, jamí ndiyáa̱ i̱mba̱a̱ a̱ꞌgo̱ tsí mbiꞌyuu Maalát, a̱dée Ismaél a̱dée máꞌ Abraám, dxáguíi máꞌ Nebayót. Ndiyáa̱ tsíge̱ꞌ inúú i̱jmi̱i̱ tsí gíꞌdii̱n máꞌ ná goꞌóo̱.<verse eid="GEN 28:9" /></para>
  <para style="s">Ana̱ꞌlóꞌ nasngájma-mina̱ꞌ inuu Jakób ná Bet-él</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10" />A̱ꞌkhue̱n rí nigájnuu Jakób ná Beerséba̱, ni̱ka̱ ná Arán. <verse eid="GEN 28:10" /><verse number="11" style="v" sid="GEN 28:11" />Ni̱ga̱níi̱ mbá ná ma̱wi̱ji̱i̱ rí mi̱guii̱, numuu rí nijngúun máꞌ a̱kha̱ꞌ. Ndiyée̱ mbá itsí rí ríga̱ ikhín jamí niꞌgíi̱ ne̱ ná maꞌgíi̱ idxu̱u̱, ikhín máꞌ nibóo̱ꞌ mi̱guii̱. <verse eid="GEN 28:11" /><verse number="12" style="v" sid="GEN 28:12" />A̱ꞌkhue̱n nigundaa̱ rí jnga̱ma mbá ixe̱ biꞌbi rí ꞌgí nakhúu ne̱ inuu ju̱ba̱ꞌ, rí inuu ne̱ na̱ga̱nú asndo mikhuíí. Jamí ndiꞌñúu̱ ánje̱l drígo̱o̱ Ana̱ꞌlóꞌ rí natsimúú jamí naguátáa̱n ná inuu ne̱. <figure style="fig" alt="Jacob, sueño, ángeles" file="CO00683b.tif" size="span" ref="28.12">Nagundaa Jakób rí ndaꞌñúú ánge̱l naguátaa jamí natsima̱a mikhuíí.</figure> <verse eid="GEN 28:12" /><verse number="13" style="v" sid="GEN 28:13" />Mangaa ndiꞌyoo̱ Ana̱ꞌlóꞌ Mikhuíí wéje̱ ná inuu ne̱, jamí waꞌtháa̱n: «Ikhúúnꞌ ñaju̱nꞌ Ana̱a̱ꞌ Mikhuíí, Anu̱u̱ Abraám, jamí Anu̱u̱ máꞌ Isaák. Mbaa ná rí kri̱ga̱án ma̱xna̱a̱ꞌlo̱ꞌ ikháán jamí xa̱bia̱a̱ꞌ. <verse eid="GEN 28:13" /><verse number="14" style="v" sid="GEN 28:14" />Tsí xa̱bia̱a̱ꞌ ma̱ꞌne mbaꞌiin asndo xóo yujndo̱o̱ꞌ ju̱ba̱ꞌ, jamí ma̱drúꞌúu̱n mbá xúgíí inuu numbaa, xúꞌkhue̱n máꞌ mbá xúgíin xa̱bo̱ numba̱a̱ ma̱gu̱ma-tsakun-rámii mangiin ga̱jma̱á numaaꞌ ikháán jamí xa̱bia̱a̱ꞌ. <verse eid="GEN 28:14" /><verse number="15" style="v" sid="GEN 28:15" />Athayáá rí xúge̱ꞌ, ikhúúnꞌ xtáá ga̱jma̱á nindxa̱a̱ꞌ, jamí ma̱ña̱wa̱a̱ꞌ asndo náá máꞌ gídxú, jamí ma̱ꞌkhaa̱ꞌ ja̱ña̱á máꞌ ná mbaa ríge̱ꞌ. Numuu rí ma̱xáni̱ꞌñáaꞌ asndo náá gáne̱-mbánuu rí na̱tha̱a̱nꞌ».<verse eid="GEN 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 28:16" />Ído̱ nifuii̱ꞌ Jakób rí nigundaa̱, a̱ꞌkhue̱n niꞌthée̱n: «Rí phú gakon rí xtáa ge̱e̱ Ana̱ꞌlóꞌ Mikhuíí, jamí ikhúúnꞌ tsíyo̱lo̱ꞌ mbá jayu». <verse eid="GEN 28:16" /><verse number="17" style="v" sid="GEN 28:17" />Xúꞌkhue̱n máꞌ phú nimíñuu̱ jamí niꞌthée̱n: «Rí phú mitsúꞌkhaa jaꞌnii mbaa ríge̱ꞌ. Nda̱a̱ rí i̱mba̱, rí goꞌóo Ana̱ꞌlóꞌ ñajuun ne̱, jamí ná rawuun xkrugoo mikhuíí ñajuun ne̱».<verse eid="GEN 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 28:18" />Miꞌcha̱ máꞌ ni̱tu̱xi̱i̱ Jakób rí i̱mba̱ watse, jamí ndiyée̱ itsí rí niꞌgíi̱ ná idxu̱u̱, nitsijii̱ ne̱ mbá xóo tsina, jamí nistrámuu̱ iya rí miꞌtsín inuu ne̱. <verse eid="GEN 28:18" /><verse number="19" style="v" sid="GEN 28:19" />A̱ꞌkhue̱n rí nixnúu̱ mbiꞌyuu mbaa rúꞌkhue̱n Bet-él, maske máꞌ Lús mbiꞌyuu xuajen rúꞌkhue̱n nákhí ginii. <verse eid="GEN 28:19" /><verse number="20" style="v" sid="GEN 28:20" />A̱ꞌkhue̱n rí nixuda-mina̱ꞌ Jakób, jamí niꞌthée̱n: «Xí Ana̱ꞌlóꞌ gáꞌga ga̱jma̱á nindxu̱ꞌ jamí ma̱ña̱we̱nꞌ ná jamba̱a̱ rí nakalo̱ꞌ, jamí maxníꞌ ganitsu rí me̱ꞌkho ga̱jma̱á xtíin rí ma̱ju̱ꞌwunꞌ, <verse eid="GEN 28:20" /><verse number="21" style="v" sid="GEN 28:21" />xúꞌkhue̱n máꞌ xí ma̱tangu̱ún tsímáá ná goꞌóo anu̱ꞌ, Ana̱ꞌlóꞌ Mikhuíí gáꞌne Anu̱ꞌ ñajuun xúꞌkhue̱n rá. <verse eid="GEN 28:21" /><verse number="22" style="v" sid="GEN 28:22" />Itsí ríge̱ꞌ ni̱ꞌgílo̱ꞌ xóo tsina, ma̱nindxu̱u̱ goꞌóo Ana̱ꞌlóꞌ. Jamí mbá xúgíí rí maxníꞌ, ma̱rígú mbóó inuu rí mbámbá gu̱wa̱ꞌ rí jaꞌyoo ma̱grui̱gúu̱».<verse eid="GEN 28:22" /></para>
  <chapter eid="GEN 28" />
  <chapter number="29" style="c" sid="GEN 29" />
  <para style="s">Jakób na̱ga̱nú ná goꞌóo Labán</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1" />A̱ꞌkhue̱n rí Jakób ndiyáa̱ ikhoo̱, ni̱ke̱e̱ numbaa ná na̱ꞌkha̱ a̱kha̱ꞌ. <verse eid="GEN 29:1" /><verse number="2" style="v" sid="GEN 29:2" />A̱ꞌkhue̱n niyaxi̱i̱, ndiꞌyoo̱ mbá iduu iya ná mbaa rúꞌkhue̱n, xúꞌkhue̱n máꞌ mbá atsú kuthúún mogo̱ gatiin nduya̱a̱ xu̱ún, numuu rí ná iduu iya rúꞌkhue̱n nawa̱a̱n xu̱kú. Jamí ná rawuun iduu iya rúꞌkhue̱n rígu mbá itsí rí phú mba̱a̱. <verse eid="GEN 29:2" /><verse number="3" style="v" sid="GEN 29:3" />Jamí ído̱ none̱ ꞌnduu̱nꞌ xúgíí kuthúún xu̱kú ikhín, a̱ꞌkhue̱n rí waxtú nu̱rma̱jnguee̱ꞌ itsí rí rígu rawuun iduu iya, jamí nuxnúu̱ iya mogo̱ mu̱wa̱a̱n. Xúꞌkhue̱n máꞌ nu̱rma̱jnguaa̱ꞌ itsí ná rawuun iduu iya. <verse eid="GEN 29:3" /><verse number="4" style="v" sid="GEN 29:4" />A̱ꞌkhue̱n Jakób niraxu̱ún waxtú tsúꞌkhue̱n:</para>
  <para style="p" vid="GEN 29:4">―A̱ngui̱nꞌ, náá-lá xa̱bo̱ xuajen ñajuanlaꞌ róꞌ.</para>
  <para style="p" vid="GEN 29:4">Xómáꞌ ikhii̱n ni̱ri̱ꞌñaa̱:</para>
  <para style="p" vid="GEN 29:4">―Arán xuajianxo̱ꞌ.<verse eid="GEN 29:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 29:5" />A̱ꞌkhue̱n ikhaa̱ niꞌthúu̱n:</para>
  <para style="p" vid="GEN 29:5">―Á no̱ne̱-núwíinlaꞌ táta̱ Labán, a̱dée máꞌ Nakór rá.</para>
  <para style="p" vid="GEN 29:5">Xómáꞌ ikhii̱n ni̱ri̱ꞌñaa̱:</para>
  <para style="p" vid="GEN 29:5">―Aan, no̱ne̱-núwíi̱nxo̱ꞌ.<verse eid="GEN 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 29:6" />Jakób niraxe̱ xóó:</para>
  <para style="p" vid="GEN 29:6">―Á xtáa̱ mújúu̱n rá.</para>
  <para style="p" vid="GEN 29:6">A̱ꞌkhue̱n ni̱ri̱ꞌñaa̱:</para>
  <para style="p" vid="GEN 29:6">―Xtáa̱ mújúu̱n máꞌ. Athayáá rí a̱ꞌkhue̱n i̱ꞌkha̱a̱ Rakél tsí a̱dée̱, rí na̱ꞌkha̱a̱ máꞌ gajmíi̱ mogo̱ mangaa̱.<verse eid="GEN 29:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 29:7" />A̱ꞌkhue̱n niꞌthúu̱n:</para>
  <para style="p" vid="GEN 29:7">―Á tsíya̱álaꞌ rí xóó tsída̱ꞌ rígu a̱kha̱ꞌ rá. Xóó tsíga̱nú rí ma̱ju̱guá-raꞌi̱i̱n xu̱kú. Déjngó tsíxnu̱únlaꞌ iya mogo̱ mu̱wa̱a̱n, xúꞌkhue̱n máꞌ mu̱ꞌgua̱a̱ꞌ gajmiálaꞌ xóó xanáá róꞌ.<verse eid="GEN 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 29:8" />Xómáꞌ ikhii̱n ni̱ri̱ꞌñaa̱:</para>
  <para style="p" vid="GEN 29:8">―Ma̱xáxóo mo̱ne̱xo̱ꞌ rúꞌkhue̱n asndo náá gáꞌne ꞌnduu̱nꞌ xúgíin kuthúún mogo̱. A̱ꞌkhue̱n ma̱ga̱taa itsí rí rígu rawuun iduu iya, jamí mu̱xnúúxo̱ꞌ iya mogo̱ mu̱wa̱a̱n xúꞌkhue̱n rá.<verse eid="GEN 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 29:9" />Xóó nandxákuu̱n gajmíi̱ xa̱bo̱ tsúꞌkhue̱n ído̱ ni̱ga̱núu̱ Rakél gajmíí mogui̱i̱ anu̱u̱, numuu rí ikhaa̱ ñajuu̱n waxtú. <verse eid="GEN 29:9" /><verse number="10" style="v" sid="GEN 29:10" />Jamí ído̱ ndiꞌyoo Jakób Rakél, a̱dée Labán, díye̱e̱ máꞌ ru̱dúu̱, jamí ndiꞌñúu̱ mogui̱i̱ máꞌ, a̱ꞌkhue̱n rí ni̱ke̱e̱ gármajnguee̱ꞌ itsí rí rígu rawuun iduu iya, xúꞌkhue̱n máꞌ nixnúu̱ iya niwa̱a̱n mogui̱i̱ Labán. <verse eid="GEN 29:10" /><verse number="11" style="v" sid="GEN 29:11" />A̱ꞌkhue̱n Jakób niraꞌnuu inuu Rakél rí niraxi̱i̱, jamí nigíꞌdu̱u̱ ni̱mbi̱ye̱e̱ꞌ. <verse eid="GEN 29:11" /><verse number="12" style="v" sid="GEN 29:12" />A̱ꞌkhue̱n Jakób niꞌthúun Rakél rí ikhaa̱ ñajuu̱n dríxe̱e̱ anu̱u̱, jamí a̱dée máꞌ Rebéka̱ ñajuu̱n. A̱ꞌkhue̱n rí Rakél nigáyuu ni̱ka̱a̱ gáꞌthúun anu̱u̱ ajngáa rúꞌkhue̱n.<verse eid="GEN 29:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 29:13" />Ído̱ rí Labán nidxawuun rí xkuaꞌnii ajngóo Jakób, a̱dée dxáguíi̱, mbá nacha̱ ni̱ke̱e̱ gátsijnuu̱, ndiyá-raꞌaa̱ jamí niraꞌnuu̱ inuu rí niraxi̱i̱, xúꞌkhue̱n máꞌ ni̱ꞌkha̱a̱ jayáa̱ guꞌwáá. A̱ꞌkhue̱n Jakób niꞌthúun Labán xúgíí rí ni̱ka̱-raríga̱. <verse eid="GEN 29:13" /><verse number="14" style="v" sid="GEN 29:14" />A̱ꞌkhue̱n Labán niꞌthúu̱n: «Rí phú gakon rí itsu̱ꞌ jamí xuyu̱ꞌ ñajuaanꞌ». A̱ꞌkhue̱n rí nixtáa̱ ga̱jma̱á nindxu̱u̱ Labán mbáa go̱nꞌ.<verse eid="GEN 29:14" /></para>
  <para style="s">Jakób nañajun inuu Labán numuu Rakél ga̱jma̱á Léa̱</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 29:15" />A̱ꞌkhue̱n Labán niꞌthúun Jakób:</para>
  <para style="p" vid="GEN 29:15">―Á numuu rí dríxe̱ꞌ ñajuaanꞌ jngó ma̱tiajun xúgi̱í rá dxe̱ꞌ. Arathúnꞌ nguátha̱ iyaaꞌ rí ma̱tha̱da̱a̱ꞌ.<verse eid="GEN 29:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 29:16" />Xómáꞌ Labán, gíꞌdiin a̱jmi̱i̱ i̱ji̱i̱n tsí go̱ꞌo̱. Tsí nikhi̱i̱ mbiꞌyuu Léa̱, jamí tsí lájuíin mbiꞌyuu Rakél. <verse eid="GEN 29:16" /><verse number="17" style="v" sid="GEN 29:17" />Léa̱ waba kuitsíin wáa ja, xómáꞌ Rakél rá, phú ninújngoo tsiꞌyá giaxu̱u̱ ja. <verse eid="GEN 29:17" /><verse number="18" style="v" sid="GEN 29:18" />Xúꞌkhue̱n máꞌ Jakób na̱ni̱gu̱u̱ꞌ jaꞌyoo Rakél, ikhaa jngó niꞌthúu̱n Labán xáꞌnii:</para>
  <para style="p" vid="GEN 29:18">―Ma̱ñajun inaaꞌ mbá juan tsigu ga̱jma̱á numuu Rakél, a̱ꞌdeáaꞌ tsí lájuíin.<verse eid="GEN 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 29:19" />A̱ꞌkhue̱n Labán niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 29:19">―I̱wa̱á máján ma̱xnia̱a̱ꞌ ikháán mbi̱ya̱a̱, xóo rí ma̱xni̱i̱ i̱mba̱a̱ xa̱bo̱. Araxtaa ga̱jma̱á nindxu̱ꞌ xúꞌkhue̱n rámá.<verse eid="GEN 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 29:20" />Xkuaꞌnii neꞌne rí Jakób niyumbá-rámuu ga̱jma̱á numuu Rakél mbá juan tsigu, jamí asndo táꞌyoo̱ xóo ni̱ka̱-ranújngoo mbiꞌi, numuu rí phú nandoo̱ jaꞌyoo̱. <verse eid="GEN 29:20" /><verse number="21" style="v" sid="GEN 29:21" />A̱ꞌkhue̱n Jakób niꞌthúun Labán: «Araxníꞌ Rakél ma̱ꞌne a̱ꞌgui̱ꞌ rá, numuu rí nirámuu máꞌ mbiꞌi rí ma̱mba̱xúꞌ ga̱jme̱ꞌ».<verse eid="GEN 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 29:22" />A̱ꞌkhue̱n rí Labán nindxaꞌúu̱n mbá xúgíin xa̱bo̱ xuajen rúꞌkhue̱n, xúꞌkhue̱n máꞌ niꞌnii̱ ndxa̱a̱ tsigún. <verse eid="GEN 29:22" /><verse number="23" style="v" sid="GEN 29:23" />Jamí ído̱ neꞌne máꞌ mbroꞌon, a̱ꞌkhue̱n rí Labán ni̱ka̱ jayáa̱ Léa̱ inuu Jakób, jamí niꞌguii̱ ga̱jmáa̱. <verse eid="GEN 29:23" /><verse number="24" style="v" sid="GEN 29:24" />Jamí xúꞌkhue̱n máꞌ Labán nixnáa mbáa yumbée̱ tsí a̱ꞌgo̱ mbiꞌyuu Sílpa̱, rí ma̱ꞌne-mba̱ꞌwi̱i̱ Léa̱.<verse eid="GEN 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 29:25" />Jamí ído̱ watse rí i̱mba̱ mbiꞌi, a̱ꞌkhue̱n rí Léa̱-lá ñajuun tsí ga̱jmáa̱. Ikhaa jngó Jakób niꞌthúun Labán:</para>
  <para style="p" vid="GEN 29:25">―Náá numuu rí xáꞌnii nithañu̱ꞌ róꞌ. Á ra̱ꞌkháa ga̱jma̱á numuu Rakél ni̱yumbáá-rámu̱ꞌ jngó rá dxe̱ꞌ. Náá numuu jngó nithane̱ nduwúún rá.<verse eid="GEN 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 29:26" />Xómáꞌ Labán niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 29:26">―Ná xuajianxo̱ꞌ ge̱jioꞌ tséne̱xo̱ꞌ rí mu̱xna̱a̱xo̱ꞌ tsinújuíin ginii tsí lájuíin inuu tsí nikhi̱i̱. <verse eid="GEN 29:26" /><verse number="27" style="v" sid="GEN 29:27" />A̱rámaaꞌ máꞌ mbá migiñuu mbiꞌi rí ndxo̱o̱ tsíge̱ꞌ, jamí a̱ꞌkhue̱n mbi̱ya̱a̱ tsí i̱mba̱a̱ mangaa, ga̱jma̱á numuu rí ma̱tiajun i̱mba̱á juan tsigu ga̱jma̱á nindxu̱ꞌ.<verse eid="GEN 29:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 29:28" />Ikhaa rúꞌkhue̱n neꞌne Jakób, jamí ni̱ga̱ti̱ya̱a̱ꞌ rí mbá smána̱ rí ndxo̱o̱ Léa̱, a̱ꞌkhue̱n rí Labán nixnáxi̱i̱ Rakél rí ma̱ꞌne máꞌ a̱ꞌgui̱i̱. <verse eid="GEN 29:28" /><verse number="29" style="v" sid="GEN 29:29" />Jamí xúꞌkhue̱n máꞌ Labán nixnáa mbáa yumbée̱ tsí a̱ꞌgo̱ mbiꞌyuu Bíla̱, rí ma̱ꞌne-mba̱ꞌwi̱i̱ Rakél. <verse eid="GEN 29:29" /><verse number="30" style="v" sid="GEN 29:30" />A̱ꞌkhue̱n rí Jakób niꞌgu ga̱jma̱á Rakél mangaa, jamí i̱tháan neꞌne a̱kui̱i̱n jaꞌyoo̱ ikhaa̱ xóo rí Léa̱. A̱ꞌkhue̱n rí i̱mba̱á juan tsigu nixtáa̱ xóó niñajuii̱n inuu Labán.<verse eid="GEN 29:30" /></para>
  <para style="s">Xóo ni̱gu̱mii i̱ji̱i̱n Jakób</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31" />Ído̱ ndiꞌyoo Ana̱ꞌlóꞌ Mikhuíí rí Jakób tsíyoo jaꞌyoo Léa̱, niꞌnii̱ rí ma̱gu̱mii i̱ji̱i̱n. Xómáꞌ Rakél na̱nguá i̱gu̱mii i̱ji̱i̱n ja. <verse eid="GEN 29:31" /><verse number="32" style="v" sid="GEN 29:32" />A̱ꞌkhue̱n rí Léa̱ nigo̱-éda, jamí neꞌne xuajii̱n, ni̱gu̱maa mbáa dxáma, tsúꞌkhue̱n nixnúu̱ mbiꞌyuu Rubén.<note caller="+" style="f"><char style="fr" closed="false">29.32 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, mbiꞌyuu Rubén naꞌthán-wíi̱ «gu̱ya̱xíílaꞌ, mbáa dxáma».</char></note> Jamí niꞌthée̱n: «Ana̱ꞌlóꞌ Mikhuíí ndiꞌyoo rí na̱mínu̱u̱ꞌ, ikhaa jngó a̱jmbeꞌ ma̱goo-jaꞌye̱ꞌ xúge̱ꞌ rá». <verse eid="GEN 29:32" /><verse number="33" style="v" sid="GEN 29:33" />Nigo̱-édee̱ mbu̱jú, jamí neꞌne xuajii̱n, ni̱gu̱maa i̱mba̱a̱ a̱dée̱. Jamí niꞌthée̱n: «Numuu rí nidxawuun máꞌ Ana̱ꞌlóꞌ Mikhuíí rí tsíyoo gíꞌyo̱ꞌ, ikhaa jngó nixníꞌ tsíge̱ꞌ mangaa». Rúꞌkhue̱n jngó nixnúu̱ mbiꞌyuu Simeón.<note caller="+" style="f"><char style="fr" closed="false">29.33 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, mbiꞌyuu Simeón naꞌthán-wíi̱ «Ana̱ꞌlóꞌ nadxawuun».</char></note><verse eid="GEN 29:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 29:34" />Nigo̱-édee̱ mbu̱jú, jamí neꞌne xuajii̱n, ni̱gu̱maa i̱mba̱a̱ a̱dée̱. A̱ꞌkhue̱n niꞌthée̱n: «Xúge̱ꞌ rá, ma̱ni̱gu̱u̱ꞌ a̱jmbeꞌ ma̱xtáa ga̱jma̱á nindxu̱ꞌ, numuu rí ni̱xni̱i̱ mbá atsúun i̱ji̱i̱n». Xkuaꞌnii jngó nixnúu̱ mbiꞌyuu Lebí.<note caller="+" style="f"><char style="fr" closed="false">29.34 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, mbiꞌyuu Lebí naꞌthán-wíi̱ «xtáa̱ ga̱jma̱á nindxu̱u̱».</char></note> <verse eid="GEN 29:34" /><verse number="35" style="v" sid="GEN 29:35" />Nigo̱-édee̱ mbu̱jú, jamí neꞌne xuajii̱n, ni̱gu̱maa i̱mba̱a̱ a̱dée̱. Jamí niꞌthée̱n: «Xúge̱ꞌ rá, ma̱ne̱-mba̱a̱ Ana̱ꞌlóꞌ Mikhuíí». Ikhaa jngó nixnúu̱ mbiꞌyuu Judá.<note caller="+" style="f"><char style="fr" closed="false">29.35 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, mbiꞌyuu Judá naꞌthán-wíi̱ «na̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ».</char></note> A̱ꞌkhue̱n rí niniñuu̱ rí naꞌne xuajii̱n.<verse eid="GEN 29:35" /></para>
  <para style="b" />
  <chapter eid="GEN 29" />
  <chapter number="30" style="c" sid="GEN 30" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1" />Ído̱ ndiꞌyoo Rakél rí na̱nguá i̱gu̱mii i̱ji̱i̱n ga̱jmáa̱ Jakób, nixígu̱u̱ꞌ jaꞌyoo̱ dxuíꞌgúu̱. Ikhaa jngó niꞌthúu̱n Jakób:</para>
  <para style="p" vid="GEN 30:1">―Araxníꞌ re̱ i̱ji̱nꞌ, ra̱ꞌkhá ma̱ja̱ñúꞌ.<verse eid="GEN 30:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 30:2" />A̱ꞌkhue̱n Jakób nijiꞌnáa jaꞌyoo Rakél, jamí niꞌthúu̱n:</para>
  <para style="p" vid="GEN 30:2">―Á ikhúúnꞌ ñaju̱nꞌ Ana̱ꞌlóꞌ, tsí narekhoo rí ma̱xáraꞌdiin i̱jia̱a̱nꞌ, jngó rá dxe̱ꞌ.<verse eid="GEN 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 30:3" />A̱ꞌkhue̱n Rakél niꞌthán:</para>
  <para style="p" vid="GEN 30:3">―Athayáá rí ge̱e̱ xtáa yumbéꞌ Bíla̱. Ano ga̱jma̱a̱ꞌ ikhaa̱, ikhaa jngó ma̱gu̱mii i̱ji̱i̱n ga̱jma̱á numu̱ꞌ.<note caller="+" style="f"><char style="fr" closed="false">30.3 </char><char style="ft" closed="false">Ná ajngáa ebréo̱ naꞌthán «ma̱gu̱mii i̱ji̱i̱n ikhaa̱ ná iduu nakhúꞌ».</char></note> A̱ꞌkhue̱n rí i̱ji̱i̱n ma̱nindxúu̱n máꞌ i̱ji̱nꞌ ikhúúnꞌlo̱ꞌ.<verse eid="GEN 30:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 30:4" />A̱ꞌkhue̱n nixnáxi̱i̱ yumbée̱ rí ma̱ꞌne a̱ꞌgui̱i̱. Xómáꞌ Jakób niꞌgu ga̱jmáa̱. <verse eid="GEN 30:4" /><verse number="5" style="v" sid="GEN 30:5" />A̱ꞌkhue̱n rí nigo̱-éda Bíla̱, neꞌne xuajii̱n, ni̱gu̱maa mbáa a̱dée̱ ga̱jmáa̱ Jakób. <verse eid="GEN 30:5" /><verse number="6" style="v" sid="GEN 30:6" />A̱ꞌkhue̱n niꞌthán Rakél: «Ni̱ra̱jua̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á numu̱ꞌ, nidxawuu̱n aꞌwóꞌ jamí nixníꞌ mbáa a̱ꞌdéꞌ». Ikhaa jngó nixnúu̱ mbiꞌyuu Dán.<note caller="+" style="f"><char style="fr" closed="false">30.6 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, mbiꞌyuu Dán naꞌthán-wíi̱ «na̱ra̱jua̱ꞌ».</char></note><verse eid="GEN 30:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 30:7" />Nda̱wa̱á nigo̱-éda mbu̱jú Bíla̱, yumbée máꞌ Rakél, jamí neꞌne xuajii̱n, ni̱gu̱maa ada̱ tsí riajma̱a̱ a̱dée máꞌ Jakób. <verse eid="GEN 30:7" /><verse number="8" style="v" sid="GEN 30:8" />Xómáꞌ Rakél niꞌthán: «Phú gakhe̱ ni̱tsa̱ñu̱ꞌ ga̱jme̱ꞌ dxuíꞌgúꞌ, jamí ni̱ꞌngo̱ꞌ rá». Ikhaa jngó nixnúu̱ mbiꞌyuu Neftalí.<note caller="+" style="f"><char style="fr" closed="false">30.8 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, mbiꞌyuu Neftalí naꞌthán-wíi̱ «na̱tsa̱ño̱ꞌ».</char></note><verse eid="GEN 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 30:9" />Ído̱ ndiꞌyoo Léa̱ rí nánguá eꞌne xuajii̱n, a̱ꞌkhue̱n ndiyáa̱ Sílpa̱, tsí yumbée̱ máꞌ, jamí nixnáxi̱i̱ inuu Jakób rí ma̱ꞌne a̱ꞌgui̱i̱. <verse eid="GEN 30:9" /><verse number="10" style="v" sid="GEN 30:10" />A̱ꞌkhue̱n rí Sílpa̱ neꞌne xuajii̱n, ni̱gu̱maa mbáa a̱dée̱ ga̱jmáa̱ Jakób. <verse eid="GEN 30:10" /><verse number="11" style="v" sid="GEN 30:11" />Xómáꞌ Léa̱ niꞌthán: «Phú mbiꞌyu̱ꞌ jún». Ikhaa jngó nixnúu̱ mbiꞌyuu̱ Gád.<note caller="+" style="f"><char style="fr" closed="false">30.11 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, mbiꞌyuu Gád naꞌthán-wíi̱ «phú mbiꞌyuu».</char></note><verse eid="GEN 30:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 30:12" />Nda̱wa̱á Sílpa̱, yumbée Léa̱, neꞌne xuajii̱n, ni̱gu̱maa i̱mba̱a̱ a̱dée̱ ga̱jmáa̱ Jakób. <verse eid="GEN 30:12" /><verse number="13" style="v" sid="GEN 30:13" />A̱ꞌkhue̱n niꞌthán Léa̱: «Rí phú tsímáá xtáá jún, numuu rí mangiin máꞌ go̱ꞌo̱ muthi̱nꞌ rí phú tsímáá jayu xtáálo̱ꞌ». Ikhaa jngó nixnúu̱ mbiꞌyuu Asér.<note caller="+" style="f"><char style="fr" closed="false">30.13 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, mbiꞌyuu Asér naxná ju̱ma̱ «tsímáá xtáa̱».</char></note><verse eid="GEN 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 30:14" />Mbá mbiꞌi máꞌ rí nagájna̱a̱ ixí iña, ikhín máꞌ ni̱ka̱ Rubén jamí nixkamaa̱ xndú rí mbiꞌyuu mandrágo̱ra̱. Nigui̱i̱ ne̱ ni̱ꞌkha̱a̱ inuu Léa̱, tsí ru̱dúu̱ máꞌ. A̱ꞌkhue̱n niꞌthán Rakél, niꞌthúun Léa̱:</para>
  <para style="p" vid="GEN 30:14">―Na̱tha̱n-jáñaaꞌ rí ma̱ra̱xnu̱ꞌ mbá-a̱jma̱ xndú mandrágo̱ra̱ rí ni̱ꞌkha̱a̱ jagu̱u̱ a̱ꞌdeáaꞌ me̱ꞌkholo̱ꞌ.<verse eid="GEN 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 30:15" />Xómáꞌ ikhaa̱ niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 30:15">―Á rí phú lájuíin rí ithañu̱ꞌ ithiyáá rá dxe̱ꞌ. Nitríguíi máꞌ a̱jmbeꞌ rá. Jamí xúge̱ꞌ nandaaꞌ ma̱dríguu̱ mandrágo̱ra̱ rí ni̱ꞌkha̱a̱ jagu̱u̱ a̱ꞌdéꞌ mangaa rá dxe̱ꞌ.</para>
  <para style="p" vid="GEN 30:15">A̱ꞌkhue̱n niꞌthán Rakél:</para>
  <para style="p" vid="GEN 30:15">―Gi̱gu Jakób ga̱jma̱á nindxa̱a̱ꞌ mbroꞌon ríge̱ꞌ rámá, ga̱jma̱á numuu mandrágo̱ra̱ rí me̱ꞌkho.<verse eid="GEN 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 30:16" />Ído̱ rí na̱ꞌkha̱a̱ máꞌ Jakób ná xanáá rí wakhíí, a̱ꞌkhue̱n nigájnuu Léa̱ gátsijnuu̱, jamí niꞌthúu̱n:</para>
  <para style="p" vid="GEN 30:16">―Me̱no̱ꞌ ga̱jma̱á nindxu̱ꞌ, numuu rí gakon máꞌ ne̱ne̱-númuu rí ma̱tíꞌñáá mbroꞌon ríge̱ꞌ ga̱jma̱á numuu xndú mandrágo̱ra̱ rí ni̱ꞌkha̱a̱ jagu̱u̱ a̱ꞌdéꞌ.</para>
  <para style="p" vid="GEN 30:16">A̱ꞌkhue̱n rí mbroꞌon máꞌ rúꞌkhue̱n niꞌgu Jakób ga̱jma̱á Léa̱. <verse eid="GEN 30:16" /><verse number="17" style="v" sid="GEN 30:17" />Xúꞌkhue̱n máꞌ nidxawuun Ana̱ꞌlóꞌ rí niꞌthán Léa̱, jamí nigo̱-édee̱ mbu̱jú, neꞌne xuajii̱n ni̱gu̱maa ada̱ tiwitsii a̱dée Jakób. <verse eid="GEN 30:17" /><verse number="18" style="v" sid="GEN 30:18" />A̱ꞌkhue̱n niꞌthán Léa̱: «Ana̱ꞌlóꞌ nixnáa̱ gamaku̱ꞌ, numuu rí ikhúúnꞌ ni̱xna̱xúu a̱jmbeꞌ yumbéꞌ rí mbayáa». Ikhaa jngó nixnúu̱ mbiꞌyuu Isakár.<note caller="+" style="f"><char style="fr" closed="false">30.18 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, mbiꞌyuu Isakár naꞌthán-wíi̱ «rí gamaku».</char></note><verse eid="GEN 30:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 30:19" />Nda̱wa̱á nigo̱-éda mbu̱jú Léa̱, jamí neꞌne xuajii̱n ni̱gu̱maa ada̱ tsí timajuiin a̱dée̱ ga̱jmáa̱ Jakób. <verse eid="GEN 30:19" /><verse number="20" style="v" sid="GEN 30:20" />A̱ꞌkhue̱n niꞌthán Léa̱: «Ana̱ꞌlóꞌ phú nimínu̱ꞌ rí máján. Ikhaa jngó xúge̱ꞌ rá, a̱jmbeꞌ ma̱xtáa jayuu ga̱jma̱á nindxu̱ꞌ, numuu rí ni̱xnu̱u̱ mbá majuiin i̱ji̱i̱n». Jamí nixnúu̱ mbiꞌyuu Sabulón.<note caller="+" style="f"><char style="fr" closed="false">30.20 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, mbiꞌyuu Sabulón naꞌthán-wíi̱ «tsimínu̱ꞌ».</char></note> <verse eid="GEN 30:20" /><verse number="21" style="v" sid="GEN 30:21" />Nda̱wa̱á neꞌne xuajii̱n ni̱gu̱maa mbáa dxáꞌgú, jamí nixnúu̱ mbiꞌyuu Dína̱.<verse eid="GEN 30:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 30:22" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ ni̱rmáꞌáa̱n a̱kui̱i̱n eꞌne Rakél, jamí nidxawuu̱n máꞌ rí niꞌthán mangaa, ikhaa jngó niꞌnii̱ rí ma̱goo ma̱gi̱ꞌdii̱n i̱ji̱i̱n. <verse eid="GEN 30:22" /><verse number="23" style="v" sid="GEN 30:23" />A̱ꞌkhue̱n rí nigo̱-édoo̱ jamí neꞌne xuajii̱n ni̱gu̱maa mbáa dxáma, jamí niꞌthée̱n: «Ana̱ꞌlóꞌ nirígúu̱ rí ni̱ti̱yu̱ꞌ rí ndawi̱i̱n i̱ji̱nꞌ». <verse eid="GEN 30:23" /><verse number="24" style="v" sid="GEN 30:24" />Jamí nixnúu̱ mbiꞌyuu José,<note caller="+" style="f"><char style="fr" closed="false">30.24 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, mbiꞌyuu José naꞌthán-wíi̱ «na̱rígu xóó i̱mba̱».</char></note> numuu rí niꞌthée̱n: «Ana̱ꞌlóꞌ Mikhuíí ágáxníꞌ i̱mba̱a̱ a̱ꞌdéꞌ».<verse eid="GEN 30:24" /></para>
  <para style="s">Jakób ga̱jma̱á Labán none̱ nduwa-mi̱jna̱</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25" />Nda̱wa̱á ído̱ rí neꞌne xuajiin máꞌ Rakél rí ni̱gu̱maa José, a̱ꞌkhue̱n Jakób niꞌthúun Labán:</para>
  <para style="p" vid="GEN 30:25">―Atatsíñúꞌ rí ma̱ꞌgáa̱ꞌ ná phú mbayu̱ꞌ rá. <verse eid="GEN 30:25" /><verse number="26" style="v" sid="GEN 30:26" />Xúꞌkhue̱n máꞌ araxníi̱ꞌ gu̱ꞌwi̱ꞌ tsí nixtáá ni̱yumbáá-rámu̱ꞌ numúú ga̱jma̱á nindxa̱a̱ꞌ, xúꞌkhue̱n máꞌ araxníi̱ꞌ i̱ji̱nꞌ, jamí atatsíñúꞌ ma̱ꞌgáa̱ꞌ. Ikháán máꞌ nathayáá xóo rí nixtáá ni̱yumbáá inaaꞌ.<verse eid="GEN 30:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 30:27" />A̱ꞌkhue̱n Labán niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 30:27">―Athañu̱ꞌ mbá rí máján, a̱wanáaꞌ ga̱jma̱á nindxu̱ꞌ. Numuu rí nifroꞌo̱ꞌ máꞌ rí Ana̱ꞌlóꞌ naꞌne tsakun-rámúú ga̱jma̱á numaaꞌ ikháán. <verse eid="GEN 30:27" /><verse number="28" style="v" sid="GEN 30:28" />―Jamí niꞌthúu̱n xóó―: Arathúnꞌ máꞌ ikháán nguátha̱ iyaaꞌ rí ma̱tha̱da̱a̱ꞌ, jamí ikhúúnꞌ ma̱ne̱-númaaꞌ.<verse eid="GEN 30:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 30:29" />Xómáꞌ Jakób niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 30:29">―Ikháán máꞌ nathayáá xóo ni̱ñajun inaaꞌ, jamí xóo niꞌkha ra̱ña̱wúún xu̱kiáaꞌ. <verse eid="GEN 30:29" /><verse number="30" style="v" sid="GEN 30:30" />Numuu rí ra̱mbáꞌii̱n xtaꞌdii̱n nákhí rí nigánúlo̱ꞌ, jamí phú ni̱mi̱diúu̱n mi̱ndaꞌkho, numuu rí Ana̱ꞌlóꞌ Mikhuíí neꞌne tsakun-rámáá ído̱ rí nigánúlo̱ꞌ. Jamí xúge̱ꞌ rá, náá-lá mbiꞌi gáñajun mangúún rí ma̱gúꞌdo̱ꞌ gajmíꞌ i̱ji̱nꞌ rá.<verse eid="GEN 30:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 30:31" />A̱ꞌkhue̱n Labán niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 30:31">―Nguátha̱-lá iyaaꞌ rí ma̱ne̱-númaaꞌ xúꞌkhue̱n rá.</para>
  <para style="p" vid="GEN 30:31">Xómáꞌ Jakób niꞌthán:</para>
  <para style="p" vid="GEN 30:31">―Nimbá máꞌ ma̱xátse̱snumu̱ꞌ. Xí ma̱tha̱ñu̱ꞌ máꞌ rí ma̱tha̱a̱nꞌlo̱ꞌ, a̱ꞌkhue̱n rí ma̱ña̱wúún máꞌ xóó xu̱kiáaꞌ. <verse eid="GEN 30:31" /><verse number="32" style="v" sid="GEN 30:32" />Atatsíñúꞌ ma̱nújngo̱ꞌ xúge̱ꞌ ná majiu̱ún xúgíin xu̱kiáaꞌ, jngó ma̱skuíji̱i̱n wájíin xúgíin mogo̱ tsí mixtíin, jamí xúgíin tsí skunii, xúꞌkhue̱n máꞌ xúgíin tso̱toon tsí mixtíin. Tsúꞌkhue̱n gánindxu̱ún tsí ma̱da̱a̱ꞌ ikhúúnꞌ. <verse eid="GEN 30:32" /><verse number="33" style="v" sid="GEN 30:33" />Gátsíí, nawi̱ín, ído̱ gídxú gátia̱xi̱í rí na̱da̱a̱ꞌ, a̱ꞌkhue̱n rí ma̱goo ma̱thi̱yáá rí tsíne̱ nduwáán. Xí ma̱kujmii tso̱toon tsí na̱nguá mixtíin, jamí mogo̱ tsí ra̱skúnii kachúún ná awúun xu̱kuíꞌ, a̱ꞌkhue̱n ma̱thi̱yáá rí na̱ne̱ kúwi̱i̱nꞌ xu̱kiáaꞌ xúꞌkhue̱n rá.<verse eid="GEN 30:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 30:34" />A̱ꞌkhue̱n Labán niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 30:34">―Phú máján, a̱ga̱ꞌne xómáꞌ irathán rámá.<verse eid="GEN 30:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 30:35" />I̱ndo̱ó numuu rí núkho̱ máꞌ mbiꞌi rúꞌkhue̱n Labán niskuíji̱i̱n wájíin tso̱toon tsí jmba̱ꞌo̱ mixtíin, jamí xúgíin tso̱toon iꞌgú tsí mixtíin máꞌ, jamí xúgíin tsí kuaꞌdáá mixtí miꞌxá, xúꞌkhue̱n máꞌ xúgíin mogo̱ tsí skunii. A̱ꞌkhue̱n rí nixnáxi̱i̱n ñawúún i̱ji̱i̱n rí mu̱ña̱wúún. <verse eid="GEN 30:35" /><verse number="36" style="v" sid="GEN 30:36" />Mbá atsú mbiꞌi ni̱ke̱e̱ jagu̱u̱n tsíngua̱ꞌ inuu ná xtáa Jakób. Xómáꞌ Jakób, na̱ña̱wúún máꞌ xu̱kuíi Labán tsí niwanúú máꞌ.<verse eid="GEN 30:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 30:37" />A̱ꞌkhue̱n rí Jakób ni̱ro̱thon ñawúun ixe̱ rí maxa mbiꞌyuu ála̱mo̱, xúꞌkhue̱n máꞌ rí mbiꞌyuu abeyáno̱ jamí rí mbiꞌyuu kastáño̱, jamí ni̱ka̱-raꞌthóo̱ jndi ne̱, jngó neꞌne miꞌxá mixtiúu ná nakujmaa ixu̱u̱ ne̱. <verse eid="GEN 30:37" /><verse number="38" style="v" sid="GEN 30:38" />Jamí ni̱ka̱-ratsuaꞌee̱n xkuíya̱ rí niꞌthóo̱ jndi ná awúun riya, ná rí naguáꞌnú xu̱kú nawa̱a̱n iya. Ikhín none̱ tsíga-mi̱jne̱e̱ ído̱ rí naguwée̱ꞌ gúwa̱a̱n iya. <verse eid="GEN 30:38" /><verse number="39" style="v" sid="GEN 30:39" />Xkuaꞌnii jngó nuda-éda mogo̱ ná inuu xkuíya̱ rúꞌkhue̱n, xúꞌkhue̱n máꞌ na̱gu̱mii i̱jíi̱n tsí mbaꞌa inii mixtiúún.<verse eid="GEN 30:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 30:40" />A̱ꞌkhue̱n rí Jakób na̱gu̱wí-jngii̱n i̱jín-mógó tsí mixtíin jamí tsí skunii ná xu̱kuíi máꞌ Labán. Tsúꞌkhue̱n naskuíji̱i̱n ná xu̱kuíi̱ máꞌ ikhaa̱. Jamí xúꞌkhue̱n máꞌ naꞌnii̱ janíí jayu tsí xu̱kuíi̱, tsíndáwi̱i̱nꞌ gajmíí xu̱kuíi Labán. <verse eid="GEN 30:40" /><verse number="41" style="v" sid="GEN 30:41" />Mbámbá nothon rí nandúún tsíga mogo̱ tsí iꞌgú tsí i̱tha̱n gúkúun, a̱ꞌkhue̱n rí Jakób na̱ka̱-ratsuaꞌan xkuíya̱ ná nawa̱a̱n iya mogo̱, ikhaa jngó nuda-édee̱ inuu máꞌ xkuíya̱. <verse eid="GEN 30:41" /><verse number="42" style="v" sid="GEN 30:42" />I̱ndo̱ó ído̱ naguwá mogo̱ iꞌgú tsí ra̱gúkúun, tsítsuaꞌee̱n xkuíya̱. Xkuaꞌnii jngó tsí ra̱gúkúun nagu̱u̱n Labán, jamí tsí i̱tháan gúkúun nagu̱u̱n Jakób. <verse eid="GEN 30:42" /><verse number="43" style="v" sid="GEN 30:43" />Xkuaꞌnii neꞌne rí nixtáa mújúun mi̱ndaꞌkho Jakób, jamí ni̱gi̱ꞌdii̱n mi̱ndaꞌkho mogo̱, mangaa máꞌ yumbáá tsí go̱ꞌo̱, yumbáá xa̱bekha, xúꞌkhue̱n máꞌ xu̱kú kaméyo̱ jamí xtá-ngidi.<verse eid="GEN 30:43" /></para>
  <chapter eid="GEN 30" />
  <chapter number="31" style="c" sid="GEN 31" />
  <para style="s">Jakób naꞌgí-mina̱ꞌ rí ma̱tanga̱a̱ ná Kanaán</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1" />Jakób nadxawuun ajngúún i̱ji̱i̱n Labán, rí nuthan: «Jakób nigu̱u̱ mbá xúgíí drígo̱o̱ ana̱ꞌlóꞌ, jamí ga̱jma̱á máꞌ rí drígo̱o̱ máꞌ ana̱ꞌlóꞌ, xtáa̱ mújúu̱n mi̱ndaꞌkho». <verse eid="GEN 31:1" /><verse number="2" style="v" sid="GEN 31:2" />Mangaa máꞌ ndaꞌyoo Jakób rí nánguá máꞌ nitiaxíi̱ máján eꞌne Labán xóo nákhí rí wapha. <verse eid="GEN 31:2" /><verse number="3" style="v" sid="GEN 31:3" />Xúꞌkhue̱n máꞌ Ana̱ꞌlóꞌ Mikhuíí niꞌthúun Jakób mangaa: «A̱tanga̱án ná xuajiuun ana̱a̱ꞌ, ná júwa̱ꞌ máꞌ a̱ngia̱a̱nꞌ, jamí ikhúúnꞌ ma̱xtáá ga̱jma̱á nindxa̱a̱ꞌ».<verse eid="GEN 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 31:4" />A̱ꞌkhue̱n rí Jakób nixuꞌma ajngáa rí ma̱ꞌkha̱ Rakél ga̱jma̱á Léa̱ ná xtáa̱ xanáá gajmíi̱ mogo̱. <figure style="fig" alt="Jacob y esposas en campo" file="CO00692B.TIF" size="span" ref="31.4">Jakób naꞌthúun gu̱ꞌwi̱i̱ rí ma̱tanga̱a̱ ná xuajñuu.</figure> <verse eid="GEN 31:4" /><verse number="5" style="v" sid="GEN 31:5" />A̱ꞌkhue̱n niꞌthúu̱n:</para>
  <para style="p" vid="GEN 31:5">―Nda̱yo̱o̱lo̱ꞌ rí ana̱ꞌlaꞌ, nánguá iyaxe̱ꞌ mújúnꞌ xóo nákhí rí wapha. Maske máꞌ xúꞌkhue̱n, i̱ndo̱ó Anu̱u̱ máꞌ anu̱ꞌ xtáa ga̱jma̱á nindxu̱ꞌ. <verse eid="GEN 31:5" /><verse number="6" style="v" sid="GEN 31:6" />Jamí ikháa̱nꞌlaꞌ ndu̱yáá-málaꞌ rí ni̱ñajun inuu ana̱ꞌlaꞌ mbá xúgíí ski̱yu̱ꞌ. <verse eid="GEN 31:6" /><verse number="7" style="v" sid="GEN 31:7" />Xómáꞌ ana̱ꞌlaꞌ naꞌne-nduwúún máꞌ xúꞌkhue̱n, jamí mbá gu̱wa̱ꞌ nothon nariꞌkhu̱u̱ rí na̱da̱a̱ꞌ. I̱ndo̱ó numuu rí Ana̱ꞌlóꞌ tsíniñuu̱ rí ma̱ꞌñi̱ꞌ rí ra̱máján. <verse eid="GEN 31:7" /><verse number="8" style="v" sid="GEN 31:8" />Jamí xí ikhaa̱ iꞌthán xáꞌnii: “Tsí mixtíin ma̱ꞌne rí ma̱tha̱da̱a̱ꞌ”, a̱ꞌkhue̱n rí mbá xúgíin mogo̱ none̱ xuajiin mixtíin i̱ji̱ín. Jamí xí ikhaa̱ iꞌthán xáꞌnii: “Tsí mbijua̱ mixtiúún gáꞌne tsí ma̱tha̱da̱a̱ꞌ” rá, a̱ꞌkhue̱n rí mbá xúgíin none̱ xuajiin mbijua̱ mixtiúún i̱ji̱ín. <verse eid="GEN 31:8" /><verse number="9" style="v" sid="GEN 31:9" />Xkuaꞌnii ni̱grui̱gúu̱ Ana̱ꞌlóꞌ xu̱kuíi ana̱ꞌlaꞌ, jamí nixníꞌlo̱ꞌ ikhúúnꞌ.<verse eid="GEN 31:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 31:10" />»Mbá miꞌtsún, awúun máꞌ mbiꞌi rí nuxka-mi̱jna̱a̱ mogo̱, ni̱gúndaa ndi̱yo̱o̱ rí mbijua̱ jamí iꞌwá inii mixtiúún jmba̱ꞌo̱ tsí none̱ tsíga-mi̱jna̱ gajmíí mogo̱ iꞌgú. <verse eid="GEN 31:10" /><verse number="11" style="v" sid="GEN 31:11" />A̱ꞌkhue̱n niꞌthínꞌ Ánje̱l drígo̱o̱ Ana̱ꞌlóꞌ awúun máꞌ rí na̱gúndaa: “Jakób”. Jamí ikhúúnꞌ ni̱ri̱ꞌñaa̱: “Ge̱e̱ máꞌ xtáá”. <verse eid="GEN 31:11" /><verse number="12" style="v" sid="GEN 31:12" />A̱ꞌkhue̱n ikhaa̱ niꞌthée̱n: “Atiaxe̱ xúge̱ꞌ ma̱thi̱yáá, rí mbijua̱ jamí iꞌwá inii mixtiúún mbá xúgíin jmba̱ꞌo̱ tsí none̱ tsíga-mi̱jna̱ gajmíí mogo̱ iꞌgú. Numuu rí ikhúúnꞌ nda̱yo̱o̱ mbá xúgíí rí naꞌñaaꞌ Labán. <verse eid="GEN 31:12" /><verse number="13" style="v" sid="GEN 31:13" />Ikhúúnꞌ ñaju̱nꞌ Ana̱a̱ꞌ Mikhuíí tsí nithayáá ná Bet-él, ná rí ikháán nitastrámáá iya miꞌtsín inuu itsí, ná rí nitaxúda-mina̱ꞌ inu̱ꞌ mbá awan. Araxo̱n xúge̱ꞌ rá, adxájna̱a̱ꞌ mbaa ríge̱ꞌ, jamí ga̱tanga̱án ná mbaa rí ni̱gu̱máá”.<verse eid="GEN 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 31:14" />A̱ꞌkhue̱n rí ni̱ri̱ꞌñaa̱ Rakél ga̱jma̱á Léa̱:</para>
  <para style="p" vid="GEN 31:14">―Á kuaꞌdáá-láxo̱ꞌ xóó rí ma̱re̱daxo̱ꞌ ná goꞌóo ana̱ꞌxo̱ꞌ, ju̱ma̱a̱ꞌ ján rá. <verse eid="GEN 31:14" /><verse number="15" style="v" sid="GEN 31:15" />Á ra̱ꞌkhá naꞌñaxo̱ꞌ asndo xóo iꞌwíin go̱ꞌo̱ rá dxe̱ꞌ. Asndo nixná-ngu̱juáa̱nꞌxo̱ꞌ, jamí wámbo̱o̱ niꞌkhui̱i̱ mbá xúgíí rí nigu̱u̱ ga̱jma̱á numaxo̱ꞌ. <verse eid="GEN 31:15" /><verse number="16" style="v" sid="GEN 31:16" />Gakon máꞌ mbá xúgíí rí ni̱grui̱gúu̱ Ana̱ꞌlóꞌ Mikhuíí ná ñawúun ana̱ꞌxo̱ꞌ, dríga̱ꞌlóꞌ ñajuun ne̱ jamí drígu̱ún máꞌ i̱jia̱nꞌlóꞌ. Ikhaa jngó xúge̱ꞌ rá, athane̱ xúgíí xóo rí niꞌtháanꞌ Ana̱ꞌlóꞌ.<verse eid="GEN 31:16" /></para>
  <para style="s">Jakób nagájna̱a̱ ná Padán-arám</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 31:17" />A̱ꞌkhue̱n rí ni̱tu̱xu̱u̱ Jakób, jamí nistrámii̱ i̱ji̱i̱n jamí gu̱ꞌwi̱i̱ ná tsu̱dúún kaméyo̱. <verse eid="GEN 31:17" /><verse number="18" style="v" sid="GEN 31:18" />Jamí ndiyée̱ ikhoo̱ gajmíi̱ xúgíin xu̱kuíi̱ tsí ni̱ka̱-radaa̱ numuu̱, xúꞌkhue̱n máꞌ ga̱jma̱á mbá xúgíí nguátha̱ rí ni̱ka̱ ra̱ge̱ꞌdoo̱ ná Padán-arám. Rúꞌkhue̱n niꞌnii̱ jngó ma̱tanga̱a̱ ná mbaa Kanaán, ná xtáa máꞌ anu̱u̱. <verse eid="GEN 31:18" /><verse number="19" style="v" sid="GEN 31:19" />Xómáꞌ Labán nigájnuu ni̱ka̱ gáꞌdi̱i̱n mogui̱i̱, ikhaa jngó Rakél neꞌne-kúwi̱i̱nꞌ xándá tsí mitsúꞌkhiin tsí gíꞌdiin máꞌ anu̱u̱. <verse eid="GEN 31:19" /><verse number="20" style="v" sid="GEN 31:20" />Xkuaꞌnii neꞌne-nduwaa Jakób Labán mbo̱ araméo̱, táꞌthúu̱n xí na̱ka̱a. <verse eid="GEN 31:20" /><verse number="21" style="v" sid="GEN 31:21" />Nigáyuu̱ ga̱jma̱á mbá xúgíí rí gíꞌdoo̱, núkho̱ máꞌ ninújngoo̱ ná mañuu Éufra̱te̱s, jamí ndiyée̱ ikhoo̱ na̱ke̱e̱ ná júba̱ Galaád.<verse eid="GEN 31:21" /></para>
  <para style="s">Labán na̱ka̱-raxkoo Jakób</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22" />Mbiꞌi riatsúu waꞌtháán Labán rí nigáyuu Jakób. <verse eid="GEN 31:22" /><verse number="23" style="v" sid="GEN 31:23" />A̱ꞌkhue̱n rí nigímbúu̱n a̱ngui̱i̱n, jamí ni̱ke̱e̱ tsu̱du̱u̱ Jakób mbá juan mbiꞌi eꞌne. Ni̱ka̱ gáxkama̱a̱ ná júba̱ Galaád. <verse eid="GEN 31:23" /><verse number="24" style="v" sid="GEN 31:24" />Mbroꞌon máꞌ rúꞌkhue̱n ni̱ꞌkha̱ Ana̱ꞌlóꞌ ná awúun xnuꞌnduu Labán mbo̱ araméo̱, a̱ꞌkhue̱n waꞌtháa̱n: «A̱thia̱wa̱án-lá rí ma̱xánújngoo-rámuu rí ma̱ra̱tháán Jakób».<verse eid="GEN 31:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 31:25" />A̱ꞌkhue̱n rí Labán nixkama̱a̱ Jakób ná júba̱ Galaád, ná niskuíje̱ máꞌ guꞌwá xtíñuu Jakób. Ikhín máꞌ niskuíje̱ guꞌwá xtíñuu Labán gajmíí a̱ngui̱i̱n. <verse eid="GEN 31:25" /><verse number="26" style="v" sid="GEN 31:26" />A̱ꞌkhue̱n Labán niꞌthúun Jakób:</para>
  <para style="p" vid="GEN 31:26">―Dí ñajuun nithane̱ rá. Déjngó nithane̱ nduwúún, jamí nidxa̱ꞌ xtiin i̱ji̱nꞌ asndo xóo tsí natiin ná awúun xkujndu mba̱a̱ róꞌ. <verse eid="GEN 31:26" /><verse number="27" style="v" sid="GEN 31:27" />Déjngó nitagáyaaꞌ ngu̱ꞌwa̱aꞌ, jamí nithane̱ nduwúún. Xúꞌkhue̱n máꞌ tára̱thu̱nꞌ jngó ma̱goo ma̱tha̱n-ngáwaaꞌ ga̱jma̱á gagi, ga̱jma̱á ajmúú, jamí ga̱jma̱á tambóra̱ jamí ixe̱-táñú róꞌ. <verse eid="GEN 31:27" /><verse number="28" style="v" sid="GEN 31:28" />Ni máꞌ tátsi̱ꞌñúꞌ rí ma̱raꞌnuu wáa inúú i̱ji̱nꞌ ga̱jma̱á máꞌ i̱jín-xíñi̱ꞌ. Rí phú najmeyoo rí nithane̱ xúge̱ꞌ ján rá. <verse eid="GEN 31:28" /><verse number="29" style="v" sid="GEN 31:29" />Ríga̱ mba̱a̱ ski̱yu̱ꞌ rí ma̱ña̱ꞌlaꞌ rí ra̱máján, i̱ndo̱ó numuu rí nduꞌwíín Anu̱u̱ ana̱a̱ꞌ niꞌthínꞌ: “A̱thia̱wa̱án-lá rí ma̱xánújngoo-rámuu rí ma̱ra̱tháán Jakób”. <verse eid="GEN 31:29" /><verse number="30" style="v" sid="GEN 31:30" />Jamí xúge̱ꞌ rí nadxu̱u̱ꞌ máꞌ rá, rí natanga̱án máꞌ ná goꞌóo ana̱a̱ꞌ, náá-lá numuu jngó nithane̱ ku̱ꞌwíin xándéꞌ tsí mitsúꞌkhiin xúꞌkhue̱n rá.<verse eid="GEN 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 31:31" />A̱ꞌkhue̱n Jakób niriꞌña̱a̱ ajngóo Labán:</para>
  <para style="p" vid="GEN 31:31">―Ni̱ga̱yúꞌ numuu rí nimíñu̱ꞌ, jamí ni̱ndxa̱ꞌwa̱-mina̱ꞌ gáꞌne xí ma̱drígúu̱n-jáꞌyéꞌ ga̱jma̱á tsiakhe̱ i̱jia̱a̱nꞌ. <verse eid="GEN 31:31" /><verse number="32" style="v" sid="GEN 31:32" />―Jakób tséꞌyoo xí Rakél neꞌne-kúwi̱i̱nꞌ xándá, ikhaa jngó niꞌthée̱n xóó―: Asndo tsáa ñajuun tsí ma̱ta̱xkami̱i̱ xándiáaꞌ ñawúun, ga̱ja̱ñúu. Ná inúú mbá xúgíin a̱ngia̱nꞌlóꞌ athaꞌyáa̱ꞌ jamí athane̱-nuwi̱i̱nꞌ re̱, rí ñajuun dríga̱a̱ꞌ ná awúun drígo̱ꞌ, jamí ada̱a̱ ne̱.<verse eid="GEN 31:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 31:33" />A̱ꞌkhue̱n rí Labán ni̱to̱ꞌo̱o̱ ná guꞌwá xtíñuu Jakób, ná goꞌóo Léa̱, jamí ná guꞌúún ná-a̱jmi̱i̱ yumbáá mbo̱ go̱ꞌo̱, jamí na̱nguá nixkami̱i̱ ikhín. Ído̱ rí nigájna̱a̱ ná goꞌóo Léa̱, ni̱to̱ꞌo̱o̱ ná goꞌóo Rakél. <verse eid="GEN 31:33" /><verse number="34" style="v" sid="GEN 31:34" />Xómáꞌ Rakél nirkaꞌuu̱n xándá ná agoo xíli̱i̱ kaméyo̱, jamí ni̱gi̱ꞌi̱i̱ ikhín. Xómáꞌ Labán ndiꞌñíi̱ꞌ mbá xúgíí awúun guꞌwá xtíin, jamí na̱nguá nixkami̱i̱. <verse eid="GEN 31:34" /><verse number="35" style="v" sid="GEN 31:35" />A̱ꞌkhue̱n Rakél niꞌthúun anu̱u̱: «Ma̱xájiꞌnáá-lá, táa̱, numuu rí tsíyoo gátu̱xu̱ꞌ rí ma̱ra̱xi̱ínlo̱ꞌ. Numuu rí xtáá naꞌkhu̱u̱ awúnꞌ xóo rí nagíꞌníí máꞌ go̱ꞌo̱».</para>
  <para style="p" vid="GEN 31:35">Xómáꞌ ikhaa̱ ndiꞌñíi̱ꞌ xándá, jamí na̱nguá nixkami̱i̱. <verse eid="GEN 31:35" /><verse number="36" style="v" sid="GEN 31:36" />A̱ꞌkhue̱n rí Jakób nijiꞌnáa, jamí ni̱tsa̱ñu̱u̱ꞌ ga̱jmáa̱ Labán, jngó niꞌthúu̱n xáꞌnii:</para>
  <para style="p" vid="GEN 31:36">―Náá rí ra̱máján ne̱ne̱, ithayáá róꞌ. Náá-lá aꞌkhúnꞌ jún rá, jngó mikoo guéño idxa̱ꞌ-raraxko̱ꞌ rá. <verse eid="GEN 31:36" /><verse number="37" style="v" sid="GEN 31:37" />Nithaꞌyáa̱ꞌ máꞌ mbá xúgíí ná awúun drígo̱ꞌ. Náá rí nitaxkama̱a̱ rí ñajuun dríga̱a̱ꞌ rá. Ataskuíje̱ ne̱ ge̱e̱, ná rí inúú a̱ngui̱nꞌ jamí a̱ngia̱a̱nꞌ, ikhaa jngó ikhii̱n gára̱jue̱e̱ꞌ ga̱jma̱á numalóꞌ. <verse eid="GEN 31:37" /><verse number="38" style="v" sid="GEN 31:38" />Awúun rí mbá skíñú tsigu nixtáá ni̱ñajun ga̱jma̱á nindxa̱a̱ꞌ, nimbá miꞌtsún táfrigu̱u̱n i̱ji̱ín mogia̱a̱ꞌ ni máꞌ tso̱tiaanꞌ, ni máꞌ ikhúúnꞌ tíꞌkhuu nimbáa mogia̱a̱ꞌ. <verse eid="GEN 31:38" /><verse number="39" style="v" sid="GEN 31:39" />Nimbá miꞌtsún táꞌkha ja̱ya̱a̱ inaaꞌ xu̱kiáaꞌ tsí nixíya̱a̱ xu̱kú-xáná. Ikhúúnꞌ máꞌ e̱ne̱ núma̱a̱ꞌ rí naꞌne xu̱kú tsúꞌkhue̱n. Xúꞌkhue̱n máꞌ tsí na̱gu̱ma-kúwi̱i̱nꞌ mbiꞌi o mbroꞌon mbo̱ꞌ, ikháán na̱tru̱múú rí na̱ne̱-númi̱i̱nlo̱ꞌ. <verse eid="GEN 31:39" /><verse number="40" style="v" sid="GEN 31:40" />Rí mbiꞌi naꞌne gámbu̱ún rí mika, xúꞌkhue̱n máꞌ mbroꞌon naꞌne gámbu̱ún rí ngúwán, jamí asndo tsíyoo gígú. <verse eid="GEN 31:40" /><verse number="41" style="v" sid="GEN 31:41" />Xkuaꞌnii jamínu̱ꞌ nixtáá mbá skíñú tsigu ná guꞌwáaꞌ. Mbá gu̱wa̱ꞌ i̱kho̱ tsigu rí nixtáá ni̱yumbáá-rámu̱ꞌ ga̱jma̱á numúú ná-a̱jmi̱i̱ i̱jia̱a̱nꞌ, jamí mbá majuun tsigu rí ni̱ñajun ga̱jma̱á numúú xu̱kiáaꞌ. Xómáꞌ ikháán rá, nidxa̱ꞌ-ratriꞌkhu̱u̱ mbá gu̱wa̱ꞌ nothon xóo rí na̱da̱a̱ꞌ. <verse eid="GEN 31:41" /><verse number="42" style="v" sid="GEN 31:42" />Xí numuu rí táxtáa ga̱jma̱á nindxu̱ꞌ Ana̱ꞌlóꞌ tsí Anu̱u̱ máꞌ Abraám, tsí naꞌne máꞌ mba̱a̱ anu̱ꞌ Isaák, gakon máꞌ rí michú ñawúnꞌ gáta̱xu̱ꞌmúu̱. I̱ndo̱ó numuu rí Ana̱ꞌlóꞌ ndiꞌyoo rí na̱mínu̱u̱ꞌ ga̱jma̱á numuu ñajun rí na̱ne̱lo̱ꞌ, ikhaa jngó nixpríguáa̱ꞌ nduꞌwíín.<verse eid="GEN 31:42" /></para>
  <para style="s">Jakób ga̱jma̱á Labán none̱ mbá awan</para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43" />A̱ꞌkhue̱n niriꞌñuu Labán Jakób:</para>
  <para style="p" vid="GEN 31:43">―Go̱ꞌo̱ tsíge̱ꞌ, i̱ji̱nꞌ ikhúúnꞌ ñajúún, xúꞌkhue̱n máꞌ e̱je̱n tsíge̱ꞌ, i̱jín-xíñi̱ꞌ ikhúúnꞌ ñajúún. Jamí mogo̱, mogui̱ꞌ máꞌ ñajúún. Mbá xúgíí rí natiaxi̱í ge̱e̱, drígo̱ꞌ ñajuun ne̱. Nda̱a̱ rí gágóo ma̱ñu̱ú xúge̱ꞌ i̱ji̱nꞌ tsíge̱ꞌ, jamí e̱je̱n tsí nene̱ ku̱mii̱. <verse eid="GEN 31:43" /><verse number="44" style="v" sid="GEN 31:44" />Ikhaa jngó xúge̱ꞌ rá, u̱guáꞌnúlóꞌ mbá awan ikháán jamí ikhúúnꞌ, rí ikhaa ne̱ masngájma rí nuꞌthán-míjnálóꞌ ná-a̱jma̱álóꞌ.<verse eid="GEN 31:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 31:45" />A̱ꞌkhue̱n rí Jakób ndiyá mbá itsí, jamí nitsijii̱ ne̱ xó mbá tsina rí masngájma. <verse eid="GEN 31:45" /><verse number="46" style="v" sid="GEN 31:46" />Jakób niꞌthúún a̱ngui̱i̱n: «U̱rangoolaꞌ itsí».</para>
  <para style="p" vid="GEN 31:46">A̱ꞌkhue̱n rí ikhii̱n nirangoo̱ itsí, jamí niꞌgíi̱ ne̱ mbá ꞌnduꞌ. Ikhín máꞌ nipiꞌtsii̱ ná kuíje̱ mbá ꞌnduꞌ itsí rúꞌkhue̱n. <verse eid="GEN 31:46" /><verse number="47" style="v" sid="GEN 31:47" />Xómáꞌ Labán nixnúu mbiꞌyuu ne̱ Jegár Saadúta̱,<note caller="+" style="f"><char style="fr" closed="false">31.47 </char><char style="ft" closed="false">Ná ajngáa araméo̱, ajngáa Jegár Saadúta̱ naꞌthán-wíi̱ «rí ꞌgí ꞌnduꞌ nasngájma». </char></note> xómáꞌ Jakób nixnúu mbiꞌyuu ne̱ Galaád.<note caller="+" style="f"><char style="fr" closed="false">31.47 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, ajngáa Galaád naꞌthán-wíi̱ «rí ꞌgí ꞌnduꞌ nasngájma».</char></note> <verse eid="GEN 31:47" /><verse number="48" style="v" sid="GEN 31:48" />A̱ꞌkhue̱n Labán niꞌthán:</para>
  <para style="p" vid="GEN 31:48">―Rí mbá ꞌnduꞌ itsí ríge̱ꞌ nasngájma rí nuꞌthán-míjnálóꞌ xúge̱ꞌ ná-a̱jma̱álóꞌ.</para>
  <para style="p" vid="GEN 31:48">Ikhaa jngó neꞌne mbiꞌyuu ne̱ Galaád. <verse eid="GEN 31:48" /><verse number="49" style="v" sid="GEN 31:49" />Xúꞌkhue̱n máꞌ neꞌne mbiꞌyuu ne̱ Míspa̱ mangaa,<note caller="+" style="f"><char style="fr" closed="false">31.49 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, ajngáa Míspa̱ naꞌthán-wíi̱ «rí wéje̱ ná nitiaxe̱-ráma».</char></note> numuu rí niꞌthán Labán:</para>
  <para style="p" vid="GEN 31:49">―Ana̱ꞌlóꞌ Mikhuíí gáyaxu̱u̱ ná majia̱nꞌlóꞌ, ído̱ góꞌne̱ wajíí-mi̱jna̱lóꞌ. <verse eid="GEN 31:49" /><verse number="50" style="v" sid="GEN 31:50" />Xí ma̱tha̱ñu̱ú nikhuáa i̱ji̱nꞌ, o xí mi̱dii̱n iꞌwíin go̱ꞌo̱ rí inúú máꞌ i̱ji̱nꞌ, ndawa̱a̱ i̱mba̱a̱ tsí ndaꞌyoo ná majia̱nꞌlóꞌ. Atiaxe̱ rí Ana̱ꞌlóꞌ ñajuun tsí ndaꞌyoo ná majia̱nꞌlóꞌ ná-a̱jma̱álóꞌ. <verse eid="GEN 31:50" /><verse number="51" style="v" sid="GEN 31:51" />―Labán niꞌthúun xóó Jakób―: Atiaxi̱í rí mbá ꞌnduꞌ itsí ríge̱ꞌ, xúꞌkhue̱n máꞌ tsina ríge̱ꞌ, ni̱tsijilo̱ꞌ ná majia̱nꞌlóꞌ. <verse eid="GEN 31:51" /><verse number="52" style="v" sid="GEN 31:52" />Rí mbá ꞌnduꞌ itsí ríge̱ꞌ nasngájma, xúꞌkhue̱n máꞌ nasngájma tsina rí wéje̱ ge̱e̱, rí ni máꞌ ikhúúnꞌ ma̱xánújngo̱ꞌ inuu itsí ríge̱ꞌ, ni máꞌ ikháán ma̱xánújngaaꞌ rí mo̱ꞌne̱-míjnálóꞌ rí ra̱máján. <verse eid="GEN 31:52" /><verse number="53" style="v" sid="GEN 31:53" />Ga̱ra̱jua̱ꞌ ga̱jma̱á nindxa̱ꞌlóꞌ Ana̱ꞌlóꞌ tsí Anu̱u̱ Abraám jamí Anu̱u̱ Nakór, mbo̱ máꞌ ñajúún xi̱ꞌñálóꞌ.</para>
  <para style="p" vid="GEN 31:53">A̱ꞌkhue̱n rí Jakób nixuda-mina̱ꞌ inuu máꞌ Ana̱ꞌlóꞌ tsí naꞌne-mba̱a̱ Isaák. <verse eid="GEN 31:53" /><verse number="54" style="v" sid="GEN 31:54" />Xúꞌkhue̱n máꞌ ni̱gu̱díi̱n xu̱kú tsi̱gi̱jia̱nꞌ ná inuu júba̱, jamí nindxaꞌúu̱n a̱ngui̱i̱n rí mo̱peꞌtso. Nda̱wa̱á rí wámbúu̱n máꞌ nipiꞌtsii̱, ikhín máꞌ ninii̱ ná júba̱ mbroꞌon rúꞌkhue̱n. <verse eid="GEN 31:54" /><verse number="55" style="v" sid="GEN 31:55" />Xómáꞌ Labán miꞌcha̱ ni̱tu̱xi̱i̱ rí i̱mba̱ mbiꞌi, jamí niraꞌnuu̱ inúú i̱ji̱i̱n ga̱jma̱á máꞌ i̱jín-xíñii̱, jamí neꞌne tsakun-rámii̱. A̱ꞌkhue̱n rí nitanga̱a̱ ni̱ka̱a̱ ná xtáa̱ máꞌ.<verse eid="GEN 31:55" /></para>
  <chapter eid="GEN 31" />
  <chapter number="32" style="c" sid="GEN 32" />
  <para style="s">Jakób naꞌne-mbánuu rí ma̱xkama̱a̱ Esaú</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1" />Jakób ndiyáa̱ ekhoo ni̱ka̱ mangaa. Ikhín ni̱díwíin ánje̱l drígo̱o̱ Ana̱ꞌlóꞌ inuu̱. <verse eid="GEN 32:1" /><verse number="2" style="v" sid="GEN 32:2" />A̱ꞌkhue̱n niꞌthán Jakób ído̱ ndiꞌñúu̱: «Guꞌwá ná xtáa Ana̱ꞌlóꞌ ñajuun mbaa ríge̱ꞌ jno̱ꞌ». Ikhaa jngó nixnúu̱ mbiꞌyuu mbaa rúꞌkhue̱n Maanaím. <verse eid="GEN 32:2" /><verse number="3" style="v" sid="GEN 32:3" />A̱ꞌkhue̱n rí nixuꞌmii Jakób xa̱bo̱ magóó juñu̱ú ajngáa inuu Esaú tsí dxíyo̱o̱ máꞌ, ná mbaa Seír, mbayuu máꞌ Edóm. <verse eid="GEN 32:3" /><verse number="4" style="v" sid="GEN 32:4" />Niꞌthúu̱n: «Xáꞌnii gútha̱ánlaꞌ táta̱ xa̱bo̱ nikhi̱i̱ Esaú: “Xáꞌnii iꞌthán yumbiáaꞌ Jakób: ‘Nixtáá ga̱jme̱ꞌ Labán, mbá xúgíí mbiꞌi asndo máꞌ xúge̱ꞌ. <verse eid="GEN 32:4" /><verse number="5" style="v" sid="GEN 32:5" />Gúꞌdiin xede̱, xtá-ngidi, mogo̱, yumbáá xa̱bekha jamí yumbáá go̱ꞌo̱. Ikhaa jngó na̱xu̱ꞌmá ajngáa ríge̱ꞌ inaaꞌ, táta̱, numuu rí gúꞌthu̱u̱n rí máján a̱kia̱a̱nꞌ gátha̱yo̱ꞌ.’ ”»<verse eid="GEN 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 32:6" />Ído̱ rí niguáꞌnuu̱ꞌ xa̱bo̱ inuu Jakób tsí nigóó juñu̱ú ajngáa, nitháa̱n: «Nikuáxo̱ꞌ inuu dxíya̱a̱ꞌ Esaú, jamí jmína̱a̱ꞌ máꞌ mangaa̱ na̱ꞌkhe̱e̱ gágrui̱guíi̱n. Xúꞌkhue̱n máꞌ na̱ꞌkha̱ gajmíi̱ mbá akho̱ siénto̱ xa̱bekha».<verse eid="GEN 32:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 32:7" />A̱ꞌkhue̱n rí Jakób maphú nimíñuu, jamí nixtáa̱ gaꞌkho̱. A̱ꞌkhue̱n rí nixpíꞌthíi̱n xa̱bi̱i̱ tsí júwa̱ꞌ máꞌ ga̱jma̱á nindxu̱u̱, xúꞌkhue̱n máꞌ mogo̱, xede̱ jamí kaméyo̱, niꞌnii̱ a̱jma̱ kuthúún. <verse eid="GEN 32:7" /><verse number="8" style="v" sid="GEN 32:8" />Numuu rí nindxaꞌwá-mine̱e̱ꞌ: «Xí na̱ꞌkha̱ Esaú gáxná-mina̱ꞌ ga̱jma̱á mbá kothon, rí i̱mba̱ kothon ma̱ꞌne-jríya̱ꞌ-mina̱ꞌ xúꞌkhue̱n rá».<verse eid="GEN 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 32:9" />A̱ꞌkhue̱n niꞌthán Jakób: «Anu̱u̱ xi̱ꞌñúꞌ Abraám jamí Anu̱u̱ anu̱ꞌ Isaák, Anu̱ꞌ Mikhuíí, ikháán nirathúnꞌ: “A̱tanga̱án ná xuajiaanꞌ jamí ná inúú máꞌ a̱ngia̱a̱nꞌ, jamí ma̱ña̱a̱ꞌ rí máján”. <verse eid="GEN 32:9" /><verse number="10" style="v" sid="GEN 32:10" />Ra̱jáꞌyo̱ꞌ ni xí lájuíin inuu mbá xúgíí rí nañáwíin a̱kia̱a̱nꞌ xtayo̱ꞌ, xúꞌkhue̱n máꞌ mbá xúgíí rí gakon rí nambánuu ajngáaꞌ inuu yumbiáaꞌ tsíge̱ꞌ. Numuu rí i̱ndo̱ó ixe̱ gída̱ꞌ ñawúnꞌ ído̱ rí ni̱ki̱dúún mañuu Jordán, jamí rí xúge̱ꞌ rá, na̱tha̱n-ñájúún a̱jma̱ kuthúún xa̱bo̱. <verse eid="GEN 32:10" /><verse number="11" style="v" sid="GEN 32:11" />Athane̱-jríñu̱ú xúge̱ꞌ ná ñawúun dxíyo̱ꞌ Esaú, numuu rí namíñu̱ꞌ ja̱yo̱o̱, ra̱ꞌkhá ma̱ꞌkhe̱e̱ gáxíñáa̱ꞌxo̱ꞌ, asndo go̱ꞌo̱ gajmíí i̱ji̱ín. <verse eid="GEN 32:11" /><verse number="12" style="v" sid="GEN 32:12" />Ikháán máꞌ nirathán: “Ikhúúnꞌ ma̱ña̱a̱ꞌ rí máján, jamí xa̱bia̱a̱ꞌ ma̱nindxu̱ún asndo xóo we̱ꞌe̱ rawuun iya a̱pha̱, rí ma̱xáꞌngo̱o̱ ma̱gi̱xnuu̱ rí mbaꞌii̱n”».<verse eid="GEN 32:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 32:13" />Mbroꞌon máꞌ rúꞌkhue̱n niwanúu Jakób rí mi̱gu ikhín, xúꞌkhue̱n máꞌ niraꞌwíi̱n xu̱kú tsí gíꞌdii̱n, tsi̱gi̱jia̱nꞌ rí maxnúu̱ Esaú: <verse eid="GEN 32:13" /><verse number="14" style="v" sid="GEN 32:14" />a̱jma̱ siénto̱ tso̱toon iꞌgú jamí mbá skíñúu tso̱toon tsí jmba̱ꞌo̱, a̱jma̱ siénto̱ mogo̱ tsí iꞌgú jamí mbá skíñúu mogo̱ tsí jmba̱ꞌo̱, <verse eid="GEN 32:14" /><verse number="15" style="v" sid="GEN 32:15" />mbá skíñú gu̱wi̱inꞌ kaméyo̱ tsí gajmíí máꞌ i̱ji̱ín, a̱jma̱ skíñúu xede̱ iꞌgú jamí gu̱wi̱inꞌ xede̱ tsí jmba̱ꞌo̱, mbá skíñúu xtá-ngidi tsí iꞌgú jamí mbá gu̱wi̱inꞌ xtá-ngidi tsí jmba̱ꞌo̱. <verse eid="GEN 32:15" /><verse number="16" style="v" sid="GEN 32:16" />Jamí nixnáxi̱i̱n ñawúún yumbée̱, mbámbá máꞌ inii kuthúún xu̱kú. A̱ꞌkhue̱n niꞌthúu̱n yumbée̱ xáꞌnii: «A̱nújngalaꞌ gináa̱ꞌlaꞌ ná inu̱ꞌ, jamí a̱go̱niꞌñáálaꞌ ma̱jia̱nꞌ mbámbá kothon inúú xu̱kú».<verse eid="GEN 32:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 32:17" />A̱ꞌkhue̱n nixuꞌmaa̱ tsí ginii ma̱ꞌga, jamí niꞌthúu̱n xáꞌnii: «Xí naxkamáá dxíyo̱ꞌ Esaú, jamí naraxa̱a̱ꞌ: “Tsáa-lá xa̱bi̱i̱ ñajuaanꞌ ján róꞌ. Náá-lá idxo̱ꞌ rá. Tsáa xu̱kuíi ñajúún tsí xtiin idxo̱ꞌ róꞌ”. <verse eid="GEN 32:17" /><verse number="18" style="v" sid="GEN 32:18" />A̱ꞌkhue̱n rí ma̱ra̱tháa̱n: “Mbá tsi̱gi̱jia̱nꞌ drígo̱o̱ yumbiáaꞌ Jakób ñajuun ne̱, rí naxoꞌmee̱ inaaꞌ ikháán, táta̱ nikhi̱i̱ Esaú, xúꞌkhue̱n máꞌ mangaa̱ na̱ꞌkhe̱e̱ tsu̱da̱ꞌ-máxo̱ꞌ”».<verse eid="GEN 32:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 32:19" />Nixuꞌmaa̱ mangaa tsí riajma̱a̱, xúꞌkhue̱n máꞌ tsí riatsíi. Jamí mbá xúgíin tsí nagóó gajmíí mbámbá kuthúún xu̱kú niꞌthúu̱n: «Xkuaꞌnii máꞌ gútha̱ánlaꞌ Esaú, ído̱ gúxkamaa̱laꞌ. <verse eid="GEN 32:19" /><verse number="20" style="v" sid="GEN 32:20" />Mu̱tháa̱nlaꞌ: “Na̱ꞌkha̱ máꞌ yumbiáaꞌ Jakób ná tsu̱da̱ꞌxo̱ꞌ”».</para>
  <para style="p" vid="GEN 32:20">Numuu rí naꞌthán-mina̱ꞌ Jakób: «Ma̱xríguu̱ tháan a̱kui̱i̱n rí najiꞌnáa̱, ga̱jma̱á tsi̱gi̱jia̱nꞌ rí na̱ka̱ ginii inuu̱, jamí nda̱wa̱á gáyu̱u̱ jmína̱a̱ꞌ. Gáꞌne xí ma̱grui̱gúu̱n máján xúꞌkhue̱n rá». <verse eid="GEN 32:20" /><verse number="21" style="v" sid="GEN 32:21" />Xkuaꞌnii jngó wapha nigánújngoo tsi̱gi̱jia̱nꞌ ná inuu̱. Xómáꞌ ikhaa̱, niꞌguii̱ mbroꞌon máꞌ rúꞌkhue̱n ná ni̱wi̱ji̱i̱.<verse eid="GEN 32:21" /></para>
  <para style="s">Jakób naxná-míjná ga̱jma̱á ánje̱l ná Peniél</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 32:22" />A̱ꞌkhue̱n rí ni̱tu̱xu̱u̱ Jakób mbroꞌon máꞌ rúꞌkhue̱n, ni̱ki̱daa̱ gajmíi̱ ná-a̱jmi̱i̱ gu̱ꞌwi̱i̱, xúꞌkhue̱n máꞌ ná-a̱jmi̱i̱ yumbée̱ mbo̱ go̱ꞌo̱ jamí mangiin máꞌ i̱ji̱i̱n tsí mbá gu̱wa̱ꞌ i̱mbii̱n. Ni̱ki̱dii̱n mañuu Jabók ná mbawi-wáa iya. <verse eid="GEN 32:22" /><verse number="23" style="v" sid="GEN 32:23" />Xúꞌkhue̱n máꞌ niꞌnii̱ rí ma̱ki̱dii̱n ná mañuu ga̱jma̱á mbá xúgíí máꞌ rí gíꞌdoo̱. <verse eid="GEN 32:23" /><verse number="24" style="v" sid="GEN 32:24" />Xkuaꞌnii niwanúu i̱mba̱wíi Jakób. A̱ꞌkhue̱n nixná-míjná ga̱jmáa̱ mbáa xa̱biya̱ asndo inu máꞌ ma̱mbiꞌi-ti̱ga̱ wáa. <figure style="fig" alt="Jacob lucha con hombre" file="CO00686B.TIF" size="span" ref="32.24">Jakób naxná-míjná ga̱jma̱á mbáa xa̱biya̱.</figure> <verse eid="GEN 32:24" /><verse number="25" style="v" sid="GEN 32:25" />Ído̱ ndiꞌyoo xa̱biya̱ rí tséꞌngo̱o̱ ma̱ꞌne ga̱jma̱á Jakób, nixnúu̱ ná rí kajua̱a̱ itso̱ xuéjiuu̱n. A̱ꞌkhue̱n rí ni̱we̱ngoo nítú sndi̱yu̱u̱ꞌ Jakób, awúun rí naxná-míjná ga̱jmáa̱. <verse eid="GEN 32:25" /><verse number="26" style="v" sid="GEN 32:26" />A̱ꞌkhue̱n xa̱biya̱ niꞌthán:</para>
  <para style="p" vid="GEN 32:26">―Atatsíñúꞌ, numuu rí nangiyuu máꞌ ma̱mbiꞌi-ti̱ga̱.</para>
  <para style="p" vid="GEN 32:26">Xómáꞌ Jakób niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 32:26">―Ma̱xáni̱ꞌñáaꞌ xí tsíthane̱ tsakun-rámúú.<verse eid="GEN 32:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 32:27" />Xómáꞌ xa̱biya̱ niraxe̱:</para>
  <para style="p" vid="GEN 32:27">―Xáne mbiꞌyaaꞌ rá.</para>
  <para style="p" vid="GEN 32:27">A̱ꞌkhue̱n rí ikhaa̱ niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 32:27">―Jakób mbiꞌyu̱ꞌ.<verse eid="GEN 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 32:28" />A̱ꞌkhue̱n rí xa̱biya̱ niꞌthúu̱n:</para>
  <para style="p" vid="GEN 32:28">―Ná-xáꞌne mbiꞌyaaꞌ Jakób rá, rí Israél gáꞌne mbiꞌyaaꞌ. Numuu rí niraxná-míjná ga̱jma̱a̱ꞌ Ana̱ꞌlóꞌ, xúꞌkhue̱n máꞌ gajmiáaꞌ xa̱bo̱ numbaa, jamí ni̱ꞌnga̱a̱ꞌ.<verse eid="GEN 32:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 32:29" />A̱ꞌkhue̱n Jakób niraxu̱u̱:</para>
  <para style="p" vid="GEN 32:29">―Arathúnꞌ xúge̱ꞌ xáne mbiꞌyaaꞌ ikháán rá.</para>
  <para style="p" vid="GEN 32:29">Xómáꞌ xa̱biya̱ niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 32:29">―Déjngó-lá natraxu̱ꞌ xáne mbiꞌyu̱ꞌ jún rá.</para>
  <para style="p" vid="GEN 32:29">A̱ꞌkhue̱n rí neꞌne tsakun-rámaa̱ ikhín. <verse eid="GEN 32:29" /><verse number="30" style="v" sid="GEN 32:30" />Xómáꞌ Jakób nixnúu mbiꞌyuu mbaa rúꞌkhue̱n Peniél, numuu rí niꞌthée̱n: «Ndi̱yo̱o̱ gakon inuu Ana̱ꞌlóꞌ, jamí nijríñu̱ú rí tájáñu̱ꞌ máꞌ».<verse eid="GEN 32:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 32:31" />Ído̱ rí nigánújngoo̱ máꞌ ná Peniél, nixpátri̱ya̱a̱ꞌ a̱kha̱ꞌ. Jamí napáte̱go̱o̱ i̱ke̱e̱ numuu rí niñawúun xuéjiuu̱n. <verse eid="GEN 32:31" /><verse number="32" style="v" sid="GEN 32:32" />Ikhaa jngó asndo máꞌ mbiꞌi xúge̱ꞌ, tséꞌpho̱ xa̱bo̱ Israél nítú rí ríga̱ ná kajua̱a̱ itso̱ xuéjiúún xu̱kú, numuu rí ikhín waꞌxnáá Jakób ná nítú rúꞌkhue̱n.<verse eid="GEN 32:32" /></para>
  <chapter eid="GEN 32" />
  <chapter number="33" style="c" sid="GEN 33" />
  <para style="s">Jakób nambáxi̱i̱ ga̱jma̱á Esaú</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1" />Ído̱ niyaxe̱ Jakób ndiꞌyoo̱ rí na̱ꞌkha̱ Esaú, xúꞌkhue̱n máꞌ mbá akho̱ siénto̱ xa̱bekha tsí naguwá ga̱jma̱á nindxu̱u̱. A̱ꞌkhue̱n rí nixpíꞌthíi̱n e̱je̱n ná majiu̱ún Léa̱ ga̱jma̱á Rakél jamí ná-a̱jmi̱i̱ máꞌ yumbáá mbo̱ go̱ꞌo̱. <verse eid="GEN 33:1" /><verse number="2" style="v" sid="GEN 33:2" />Xúꞌkhue̱n máꞌ nitsuájuu̱n yumbáá gajmíí i̱ji̱ín ginuu ná inúú, i̱ꞌkha̱a̱ la Léa̱ gajmíí i̱ji̱i̱n. Tsu̱di̱í jayu ni̱we̱je̱ Rakél ga̱jma̱á José. <verse eid="GEN 33:2" /><verse number="3" style="v" sid="GEN 33:3" />A̱ꞌkhue̱n rí ikhaa̱ nigánújngoo̱ ginii̱ ná inúú, jamí ni̱ka̱-rasmáti̱go̱o̱ ná mbayíí mbá juan nothon, asndo náá ni̱ga̱níi̱ inuu dxíyo̱o̱. <verse eid="GEN 33:3" /><verse number="4" style="v" sid="GEN 33:4" />Xómáꞌ Esaú nigáyuu gáxkama̱a̱ jamí ndiyá-raꞌaa̱ xúꞌkhue̱n máꞌ niraꞌnuu̱ inuu rí niraxi̱i̱. A̱ꞌkhue̱n rí ná-a̱jmi̱i̱ ni̱mbi̱ye̱e̱ꞌ. <figure style="fig" alt="Esau y Jacob, reencuentro" file="CO00693B.TIF" size="span" ref="33.4">Nu̱xkama̱-mi̱jna̱a̱ Esaú ga̱jma̱á Jakób.</figure> <verse eid="GEN 33:4" /><verse number="5" style="v" sid="GEN 33:5" />A̱ꞌkhue̱n niyaxe̱ Esaú, ndiꞌñúu̱ go̱ꞌo̱ xúꞌkhue̱n máꞌ e̱je̱n, jamí niꞌthée̱n:</para>
  <para style="p" vid="GEN 33:5">―Tsíin ñajúún tsíge̱ꞌ róꞌ.</para>
  <para style="p" vid="GEN 33:5">Xómáꞌ Jakób niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 33:5">―E̱je̱n tsíge̱ꞌ ñajúún tsí Ana̱ꞌlóꞌ nixníꞌ, tsúún ñaju̱nꞌ yumbiáaꞌ.<verse eid="GEN 33:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 33:6" />A̱ꞌkhue̱n rí ni̱xu̱ꞌma-mi̱jna̱ yumbáá gajmíí i̱ji̱ín, jamí ni̱sma̱ti̱gúu̱n. <verse eid="GEN 33:6" /><verse number="7" style="v" sid="GEN 33:7" />A̱ꞌkhue̱n nixuꞌma-mina̱ꞌ Léa̱ gajmíí i̱ji̱i̱n, ikhaa máꞌ nini̱i̱ rí ni̱sma̱ti̱gúu̱n. Nda̱wa̱á a̱ꞌkhue̱n nixuꞌma-mina̱ꞌ José ga̱jma̱á Rakél, jamí ni̱sma̱ti̱gúu̱n máꞌ mangii̱n. <verse eid="GEN 33:7" /><verse number="8" style="v" sid="GEN 33:8" />A̱ꞌkhue̱n niraxe̱ Esaú:</para>
  <para style="p" vid="GEN 33:8">―Náá rí ithaꞌgí-mina̱ꞌ ga̱jma̱á nindxu̱u̱ mbá xúgíí kuthúún xu̱kú tsí niꞌkha ra̱xkamii róꞌ.</para>
  <para style="p" vid="GEN 33:8">Xómáꞌ Jakób niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 33:8">―Rí máján a̱kia̱a̱nꞌ gátha̱yo̱ꞌ, i̱ꞌgí-mina̱ꞌ, táta̱.<verse eid="GEN 33:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 33:9" />A̱ꞌkhue̱n niꞌthán Esaú:</para>
  <para style="p" vid="GEN 33:9">―Mbájndi máꞌ rí gúꞌdo̱ꞌ jún, dxíyo̱ꞌ. A̱ꞌne máꞌ dríga̱a̱ꞌ ikháán rí xtaꞌdáá.<verse eid="GEN 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 33:10" />A̱ꞌkhue̱n niriꞌña̱a̱ Jakób:</para>
  <para style="p" vid="GEN 33:10">―Na̱nguáa̱, ikhúúnꞌ na̱tha̱n-jáñaaꞌ. Xí xúge̱ꞌ máján a̱kia̱a̱nꞌ na̱xkamáálo̱ꞌ rá, a̱tri̱gúꞌ tsi̱gi̱jiu̱nꞌ. Rí na̱ya̱xu̱u̱ inaaꞌ, mbá xóo rí na̱ya̱xu̱u̱ inuu Ana̱ꞌlóꞌ jaꞌnii, numuu rí phú máján a̱kia̱a̱nꞌ na̱tri̱gúún. <verse eid="GEN 33:10" /><verse number="11" style="v" sid="GEN 33:11" />Na̱tha̱n-jáñaaꞌlo̱ꞌ, táta̱, rí ma̱tri̱gúꞌ tsi̱gi̱jiu̱nꞌ rí ja̱ya̱ iꞌkhalo̱ꞌ. Numuu rí Ana̱ꞌlóꞌ nixníꞌ guéño máꞌ, jamí mbá xúgíí rí ríga̱ ge̱jioꞌ drígo̱ꞌ máꞌ ñajuun ne̱.</para>
  <para style="p" vid="GEN 33:11">I̱ndo̱ó numuu rí Jakób ra̱ꞌkhá-tháán niꞌthán-jáñuu̱, a̱ꞌkhue̱n rí Esaú ni̱grui̱gú. <verse eid="GEN 33:11" /><verse number="12" style="v" sid="GEN 33:12" />A̱ꞌkhue̱n niꞌthán Esaú:</para>
  <para style="p" vid="GEN 33:12">―U̱ꞌgua̱lóꞌ rámá, jamí ikhúúnꞌ ma̱ꞌgá ginúú inaaꞌ.<verse eid="GEN 33:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 33:13" />Xómáꞌ Jakób niꞌthúu̱n:</para>
  <para style="p" vid="GEN 33:13">―Táta̱, nathayáá máꞌ rí phú ruduun e̱je̱n, jamí gúꞌdiin mogo̱ jamí xede̱ tsí nene̱ xuajiin. Xí rí magóo̱ nacha̱ guéño, awúun rí mbá mbiꞌi ma̱ja̱ñúú mbá xúgíin xu̱kú. <verse eid="GEN 33:13" /><verse number="14" style="v" sid="GEN 33:14" />A̱nújngaaꞌ me̱dxo̱ꞌ giníí, táta̱, inuu yumbiáaꞌ. Jamí ikhúúnꞌ ma̱ꞌgá mañuu awuun nakhúún xu̱kú, xúꞌkhue̱n máꞌ awuun nakhúún e̱je̱n, asndo gáguáꞌnúxo̱ꞌ rí mu̱xkama-mi̱jnalóꞌ ná Seír.<verse eid="GEN 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 33:15" />A̱ꞌkhue̱n Esaú niꞌthán:</para>
  <para style="p" vid="GEN 33:15">―Ma̱ni̱ꞌñúú ga̱jma̱á nindxa̱a̱ꞌ mbá tikhuun xa̱bo̱ tsí niꞌkha gajmíꞌ, xúꞌkhue̱n róꞌ.</para>
  <para style="p" vid="GEN 33:15">Xómáꞌ Jakób niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 33:15">―Ma̱xára̱xtaa máꞌ gaꞌkho̱. Athane̱ mba̱a̱ a̱kia̱a̱nꞌ xtayo̱ꞌ, táta̱.<verse eid="GEN 33:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 33:16" />Mbiꞌi máꞌ rúꞌkhue̱n nitanga̱a̱ ni̱ka̱a̱ Esaú ná Seír. <verse eid="GEN 33:16" /><verse number="17" style="v" sid="GEN 33:17" />Xómáꞌ Jakób ja rá, ni̱ka̱ ná Sukót, jamí ikhín máꞌ niꞌnii̱ guꞌwá ná ma̱xtáa̱. Xúꞌkhue̱n máꞌ niꞌnii̱ guꞌwá xtúgúún xu̱kuíi̱, ikhaa jngó mbaa rúꞌkhue̱n nixnúu̱ mbiꞌyuu Sukót.<note caller="+" style="f"><char style="fr" closed="false">33.17 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, mbiꞌyuu Sukót naꞌthán-wíi̱ «xtúgua».</char></note><verse eid="GEN 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 33:18" />Ído̱ rí ni̱ꞌkha̱a̱ Jakób ná Padán-arám, nda̱a̱ máꞌ rí nigíꞌnuu̱, rí ni̱ga̱núu̱ mújúu̱n ná xuajen Sikém, rí ꞌgí ná mbaa Kanaán. Jamí ikhín máꞌ nixtáa̱ ná jri̱doo xuajen rúꞌkhue̱n. <verse eid="GEN 33:18" /><verse number="19" style="v" sid="GEN 33:19" />A̱ꞌkhue̱n rí niꞌtsi̱i̱ mbá mbaa rí jámaa mbá witsu skíñú (100) mbúkha̱a̱ ajua̱nꞌ. Niꞌtsi̱i̱ ne̱ ná ñawúún i̱ji̱i̱n Amór tsí anu̱u̱ Sikém, jamí ikhín máꞌ niꞌgíi̱ guꞌwá xtíñuu̱. <verse eid="GEN 33:19" /><verse number="20" style="v" sid="GEN 33:20" />Jamí ikhín ni̱rngu̱xi̱i̱ itsí ná ma̱ꞌne-mba̱a̱ Ana̱ꞌlóꞌ, xúꞌkhue̱n máꞌ nixnúu̱ mbiꞌyuu ne̱ Él-Elóe̱-Israél.<note caller="+" style="f"><char style="fr" closed="false">33.20 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, ajngáa «Él-Elóe̱-Israél» naꞌthán-wíi̱ «Ana̱ꞌlóꞌ ñajuun Anu̱u̱ Israél».</char></note><verse eid="GEN 33:20" /></para>
  <chapter eid="GEN 33" />
  <chapter number="34" style="c" sid="GEN 34" />
  <para style="s">Ni̱gu̱ma-numa̱a̱ꞌ rí nigíꞌnuu Dína̱</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1" />Mbá miꞌtsún nigájnuu Dína̱, a̱dée máꞌ Léa̱ ga̱jma̱á Jakób, ni̱ka̱ gáꞌñúú i̱jín-go̱ꞌo̱ tsí júwa̱ꞌ ná xuajen rúꞌkhue̱n. <verse eid="GEN 34:1" /><verse number="2" style="v" sid="GEN 34:2" />A̱ꞌkhue̱n waꞌyáa̱ eꞌne Sikém, a̱dée máꞌ Amór mbo̱ ebéo̱, tsí xa̱bo̱ ekha ná mbaa rúꞌkhue̱n. A̱ꞌkhue̱n Sikém ni̱ka̱ jayáa̱, jamí nibóo̱ꞌ ga̱jmáa̱, xúꞌkhue̱n máꞌ táyá-makuu̱. <verse eid="GEN 34:2" /><verse number="3" style="v" sid="GEN 34:3" />Phú ni̱ni̱gu̱u̱ꞌ jaꞌyoo̱ Dína̱, tsí a̱dée máꞌ Léa̱, jamí naꞌne a̱kui̱i̱n rí mbayáa̱, ikhaa jngó naꞌnii̱ rí dxáꞌgú ma̱go jiꞌyáa̱ gáꞌne mangaa. <verse eid="GEN 34:3" /><verse number="4" style="v" sid="GEN 34:4" />A̱ꞌkhue̱n rí Sikém niꞌthúun anu̱u̱: «A̱ta̱nda̱ꞌa̱a̱ tháan dxáꞌgú tsíge̱ꞌ rí ma̱ꞌne a̱ꞌgui̱ꞌlo̱ꞌ».<verse eid="GEN 34:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 34:5" />Jakób nidxawuun máꞌ rí Sikém táyá-makuu Dína̱. Xómáꞌ i̱ji̱i̱n, júwa̱ꞌ xanáá gajmíí xu̱kú, ikhaa jngó táꞌthán máꞌ nimbá Jakób asndo gáguáꞌnuu̱ ikhii̱n. <verse eid="GEN 34:5" /><verse number="6" style="v" sid="GEN 34:6" />A̱ꞌkhue̱n rí Amór, anu̱u̱ máꞌ Sikém, ni̱ka̱ ga̱jmáa̱ dxáma rí mandxákuu̱n ga̱jmáa̱ Jakób. <verse eid="GEN 34:6" /><verse number="7" style="v" sid="GEN 34:7" />Ído̱ nidxawíín i̱ji̱i̱n Jakób rí niríga̱, niguwáa̱nꞌ ná júwe̱e̱ꞌ xanáá. Jamí phú natájuíin a̱kuíi̱n, xúꞌkhue̱n máꞌ phú najiꞌníi̱, numuu rí Sikém neꞌne rí ra̱máján inuu Israél rí nibóo̱ꞌ ga̱jmáa̱ a̱dée Jakób, numuu rí ra̱gíꞌmaa ma̱ꞌnii̱ ninguánáá rúꞌkhue̱n. <verse eid="GEN 34:7" /><verse number="8" style="v" sid="GEN 34:8" />A̱ꞌkhue̱n rí Amór niꞌthán-míjná gajmíi̱:</para>
  <para style="p" vid="GEN 34:8">―A̱ꞌdéꞌ Sikém rí phú na̱ni̱gu̱u̱ꞌ jaꞌyoo a̱ꞌdeálaꞌ. Na̱tha̱n-jáñalaꞌ rí mu̱xna̱a̱laꞌ rí ma̱ꞌne a̱ꞌgui̱i̱. <verse eid="GEN 34:8" /><verse number="9" style="v" sid="GEN 34:9" />A̱go̱ꞌne̱ mijngi juꞌya-mi̱jna̱lóꞌ, a̱gu̱xni̱i̱laꞌ i̱jia̱nꞌlaꞌ tsí go̱ꞌo̱, xúꞌkhue̱n máꞌ a̱gu̱diinlaꞌ i̱jia̱nꞌxo̱ꞌ. <verse eid="GEN 34:9" /><verse number="10" style="v" sid="GEN 34:10" />Ga̱juwalaꞌ ga̱jma̱á nindxa̱ꞌxo̱ꞌ, numuu rí ri̱ga̱ a̱pha̱ mbaa ná ñawánlaꞌ. Ga̱juwalaꞌ inuu ne̱, xúꞌkhue̱n máꞌ a̱go̱tse̱laꞌ, gu̱ngu̱jua̱laꞌ ge̱jioꞌ. Jamí a̱gu̱daa̱laꞌ mbaa ríge̱ꞌ.<verse eid="GEN 34:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 34:11" />Sikém niꞌthúun anu̱u̱ Dína̱, xúꞌkhue̱n máꞌ díye̱e̱ mangaa:</para>
  <para style="p" vid="GEN 34:11">―Phú na̱tha̱n-jáñalaꞌ rí mu̱drígúúnlaꞌ, jngó ma̱xna̱ꞌlaꞌ asndo náá rí i̱ndo̱ꞌo̱ꞌlaꞌ. <verse eid="GEN 34:11" /><verse number="12" style="v" sid="GEN 34:12" />Gu̱nda̱ꞌo̱ꞌlaꞌ nguátha̱ máꞌ mba̱a̱ rí naꞌne a̱kia̱nꞌlaꞌ, xúꞌkhue̱n máꞌ tsi̱gi̱jia̱nꞌ, jamí ikhúúnꞌ ma̱xna̱ꞌlaꞌ. I̱ndo̱ó numuu rí gu̱xna̱a̱laꞌ dxáꞌgú rí mba̱ya̱a̱ ma̱ꞌne a̱ꞌgui̱ꞌ.<verse eid="GEN 34:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 34:13" />A̱ꞌkhue̱n rí ni̱ri̱ꞌñaa̱ i̱ji̱i̱n Jakób rí nitháa̱n Sikém ga̱jma̱á anu̱u̱, nitháa̱n ga̱jma̱á ajngáa mi̱nduwa, numuu rí tíꞌyá-makuíí dxáguíi̱n. <verse eid="GEN 34:13" /><verse number="14" style="v" sid="GEN 34:14" />Xáꞌnii nitháa̱n:</para>
  <para style="p" vid="GEN 34:14">―Ma̱xáxóo mo̱ne̱xo̱ꞌ rúꞌkhue̱n, rí mu̱xna̱a̱xo̱ꞌ dxágiáxo̱ꞌ mbáa xa̱bo̱ tsí ra̱gíꞌdoo tsina-jndi, numuu rí mbá mate̱ꞌ mba̱a̱ ñajuun ne̱ inaxo̱ꞌ. <verse eid="GEN 34:14" /><verse number="15" style="v" sid="GEN 34:15" />Mbóó rí ma̱goo ma̱ꞌne xúꞌkhue̱n rá, rí ma̱nindxa̱ꞌlaꞌ xóo rí ikháa̱nꞌxo̱ꞌ. Mbá xúgíin xa̱bekha tsí ikháa̱nꞌlaꞌ, jaꞌyoo rí mu̱guaꞌdáá tsina-jndi. <verse eid="GEN 34:15" /><verse number="16" style="v" sid="GEN 34:16" />A̱ꞌkhue̱n rí mu̱xni̱i̱xo̱ꞌ i̱jia̱nꞌxo̱ꞌ tsí go̱ꞌo̱, jamí mu̱díinxo̱ꞌ i̱jia̱nꞌlaꞌ. A̱ꞌkhue̱n rí ma̱júwa̱ꞌxo̱ꞌ ga̱jma̱á nindxa̱ꞌlaꞌ jamí mbóó máꞌ xuajen gúꞌne̱lóꞌ xúꞌkhue̱n rá. <verse eid="GEN 34:16" /><verse number="17" style="v" sid="GEN 34:17" />I̱ndo̱ó-lá xí tsídxawíínlaꞌ rí mu̱drígúlaꞌ tsina-jndi, mbu̱ya̱a̱xo̱ꞌ dxágiáxo̱ꞌ jamí mu̱ꞌguáxo̱ꞌ.<verse eid="GEN 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 34:18" />Jamí máján máꞌ jaꞌnii ajngúu̱n ndiꞌyoo Amór ga̱jma̱á Sikém. <verse eid="GEN 34:18" /><verse number="19" style="v" sid="GEN 34:19" />Ikhaa jngó tágajiúu máꞌ neꞌne-mbánuu dxáma rí waꞌtháán, numuu rí phú na̱ni̱gu̱u̱ꞌ jaꞌyoo̱ a̱dée Jakób. Jamí Sikém i̱wa̱á nitia-makuíí ene̱ xa̱bo̱ inúú mbá xúgíin a̱ngui̱i̱n, <verse eid="GEN 34:19" /><verse number="20" style="v" sid="GEN 34:20" />ikhaa jngó ni̱ke̱e̱ ga̱jmáa̱ anu̱u̱ ná rawuun xuajen ná na̱tu̱ꞌúún-múú xa̱bo̱. A̱ꞌkhue̱n nithúu̱n xa̱bo̱ xuajen:<verse eid="GEN 34:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 34:21" />―Xa̱bekha májíin ñajúún xa̱bo̱ tsíge̱ꞌ ga̱jma̱á nindxa̱ꞌlóꞌ, ikhaa jngó ga̱ju̱wée̱ꞌ máꞌ ná xuajianlóꞌ jamí gutsi̱i̱, ga̱ngu̱juwe̱e̱ ge̱e̱. Numuu rí mbájndi ma̱jia̱nꞌ inuu mbaa ná rí ma̱ju̱wée̱ꞌ ikhii̱n. Xómáꞌ ikháánlóꞌ mu̱ꞌdiinlóꞌ i̱jíi̱n rí ma̱ꞌne gu̱ꞌya̱ꞌlóꞌ, jamí mu̱ꞌxníinlóꞌ i̱jia̱nꞌlóꞌ mangii̱n. <verse eid="GEN 34:21" /><verse number="22" style="v" sid="GEN 34:22" />Mbóó ríge̱ꞌ rí nuthan xa̱bo̱ tsíge̱ꞌ rí ma̱goo ma̱ju̱wée̱ꞌ ga̱jma̱á nindxa̱ꞌlóꞌ, jamí ma̱nindxa̱ꞌlóꞌ mbóó máꞌ xuajen: rí mbá xúgiáánlóꞌ tsáán ñajuanlóꞌ xa̱bekha mu̱guaꞌdáálóꞌ tsina-jndi, xóo rí kuaꞌdáa̱ ne̱ ikhii̱n. <verse eid="GEN 34:22" /><verse number="23" style="v" sid="GEN 34:23" />I̱ndo̱ó máꞌ rí ndaꞌyóo mo̱ꞌne̱lóꞌ rí nothee̱n ikhii̱n, a̱ꞌkhue̱n rí ma̱ju̱wée̱ꞌ ga̱jma̱á nindxa̱ꞌlóꞌ. Xúꞌkhue̱n máꞌ mbá xúgíin xu̱kuíi̱n ga̱jma̱á rí kuaꞌdáa̱, ma̱ꞌne dríga̱ꞌ-málóꞌ.<verse eid="GEN 34:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 34:24" />Mbá xúgíin xa̱bo̱ xuajen ninimbu̱ún rí niꞌthán Amór ga̱jma̱á Sikém. Xkuaꞌnii neꞌne rí mbá xúgíin xa̱bekha ná xuajen rúꞌkhue̱n ni̱dri̱gú tsina-jndi. <verse eid="GEN 34:24" /><verse number="25" style="v" sid="GEN 34:25" />Ni̱ga̱nú mbiꞌi riatsú, ído̱ rí i̱tháan naꞌkho̱ iyáá xa̱bo̱, a̱ꞌkhue̱n rí a̱jmi̱i̱ i̱ji̱i̱n Jakób, Simeón ga̱jma̱á Lebí, díye̱e̱ máꞌ Dína̱, mbámbáa ndiyá chíde̱. A̱ꞌkhue̱n rí nigóo̱ ná xuajen, ído̱ rí ra̱júwa̱ꞌ xawi xa̱bo̱, jamí niradíi̱n mbá xúgíin xa̱bekha. <verse eid="GEN 34:25" /><verse number="26" style="v" sid="GEN 34:26" />Xúꞌkhue̱n máꞌ ga̱jma̱á chíde̱ ni̱xi̱ya̱a̱ Amór ga̱jma̱á Sikém, jamí ni̱ri̱ya̱a̱ꞌ Dína̱ ná goꞌóo Sikém. A̱ꞌkhue̱n rí nigúu̱n. <verse eid="GEN 34:26" /><verse number="27" style="v" sid="GEN 34:27" />A̱ꞌkhue̱n niguáꞌnú iꞌwíin i̱ji̱i̱n Jakób ná jubúún wa̱jen. A̱ꞌkhue̱n nirawíi̱ mbá xúgíí rí ríga̱ ná xuajen, ga̱jma̱á numuu rí tíꞌyá-makuíí dxáguíi̱n. <verse eid="GEN 34:27" /><verse number="28" style="v" sid="GEN 34:28" />Nigó judii̱n mogo̱, xede̱ jamí xtá-ngidi, jamí asndo nguátha̱ rí ríga̱ ná awúun xuajen xúꞌkhue̱n máꞌ rí ríga̱ ná xanáá. <verse eid="GEN 34:28" /><verse number="29" style="v" sid="GEN 34:29" />Nigó judii̱n mbá xúgíin e̱je̱n, go̱ꞌo̱, xúꞌkhue̱n máꞌ nene̱ ku̱ꞌwée̱ mbá xúgíí rí ríga̱ ná guꞌwáá, mbá xúgíí máꞌ jayu rí kuaꞌdáa̱.<verse eid="GEN 34:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 34:30" />A̱ꞌkhue̱n rí Jakób niꞌthúun Simeón ga̱jma̱á Lebí:</para>
  <para style="p" vid="GEN 34:30">―Ni̱gíwu̱únlaꞌ awúun mbá sia̱nꞌ, rí ná-xáxúún xa̱bo̱ gúye̱ꞌ ná numbaa ríge̱ꞌ, mbo̱ kananéo̱ jamí mbo̱ fereséo̱. Jamí xí ikhii̱n gámbáxíi̱n rí ma̱guwée̱ꞌ gúxne̱ꞌ, a̱ꞌkhue̱n rí mu̱xi̱ñúu̱ jamí mbá xúgíin xa̱bi̱ꞌ, numuu rí ra̱mbaꞌiin máꞌ xa̱bi̱ꞌ ikhúúnꞌ.<verse eid="GEN 34:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 34:31" />Xómáꞌ ikhii̱n ni̱ri̱ꞌñaa̱:</para>
  <para style="p" vid="GEN 34:31">―Á máján rí niꞌñuu̱ dxáguiáxo̱ꞌ xóo na̱gu̱maa mbáa a̱ꞌgo̱ tsí na̱ngu̱jua̱-mina̱ꞌ rá dxe̱ꞌ.<verse eid="GEN 34:31" /></para>
  <chapter eid="GEN 34" />
  <chapter number="35" style="c" sid="GEN 35" />
  <para style="s">Ana̱ꞌlóꞌ naꞌne tsakun-rámaa Jakób ná Bet-él</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ niꞌthúun Jakób: «Ayu ja ná Bet-él, jamí araxtaa máꞌ ikhín. A̱ta̱rngo̱xe̱ itsí ikhín ná ma̱tha̱ne̱-mba̱a̱ Ana̱a̱ꞌ tsí nikujmaa inaaꞌ, nákhí ído̱ nitagáyaaꞌ inuu dxíya̱a̱ꞌ Esaú».<verse eid="GEN 35:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 35:2" />A̱ꞌkhue̱n rí Jakób niꞌthúún a̱ngui̱i̱n jamí mbá xúgíin tsí júwa̱ꞌ ga̱jma̱á nindxu̱u̱: «Gu̱ni̱ꞌñúúlaꞌ xándá tsí ra̱ñájúún Ana̱ꞌlóꞌ, tsí kuaꞌdiinlaꞌ a̱ꞌkhue̱n, jamí a̱go̱ne̱ khaꞌu̱u̱-mi̱jna̱a̱laꞌ, xúꞌkhue̱n máꞌ gu̱riꞌkhu̱u̱laꞌ xtíñalaꞌ. <verse eid="GEN 35:2" /><verse number="3" style="v" sid="GEN 35:3" />U̱guaxo̱nlóꞌ, jamí u̱ꞌgua̱lóꞌ ná Bet-él. Ikhín ma̱rngo̱xe̱ itsí ná ma̱ne̱-mba̱a̱ Ana̱ꞌlóꞌ tsí nimbáyíꞌ nákhí rí nixtáá gaꞌkho̱, xúꞌkhue̱n máꞌ nixtáa̱ ga̱jma̱á nindxu̱ꞌ mbá xúgíí ná ngrigo̱ꞌ».<verse eid="GEN 35:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 35:4" />Xkuaꞌnii ni̱xna̱xi̱i̱n inuu Jakób mbá xúgíin xándá tsí ra̱ñájúún Ana̱ꞌlóꞌ, tsí kuaꞌdii̱n ikhii̱n, xúꞌkhue̱n máꞌ xábí rí xpri̱gú ná ñaꞌúu̱n. Xómáꞌ Jakób niꞌdu xúgíí rúꞌkhue̱n ná xtuun mbá ixe̱ xi̱xoo rí wéje̱ mijngi máꞌ ná Sikém. <verse eid="GEN 35:4" /><verse number="5" style="v" sid="GEN 35:5" />Jamí ído̱ ikhii̱n nigájnúu̱, a̱ꞌkhue̱n Ana̱ꞌlóꞌ neꞌne rí ma̱mi̱ꞌñúú mi̱ndaꞌkho xa̱bo̱ xuajen rí kuíje̱ mijngi, ikhaa jngó tágóo̱ tsu̱dúún i̱ji̱i̱n Jakób.<verse eid="GEN 35:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 35:6" />A̱ꞌkhue̱n ni̱ga̱nú Jakób ná Lús (rí ikhaa máꞌ ñajuun Bet-él), rí ꞌgí ná mbayuu Kanaán. Ni̱ga̱níi̱ ikhaa̱ jamí mbá xúgíin xa̱bo̱ tsí júwa̱ꞌ ga̱jma̱á nindxu̱u̱. <verse eid="GEN 35:6" /><verse number="7" style="v" sid="GEN 35:7" />Ikhín ni̱rngu̱xi̱i̱ itsí ná ma̱ꞌne-mba̱a̱ Ana̱ꞌlóꞌ, jamí mbaa rúꞌkhue̱n nixnúu̱ mbiꞌyuu Él-bet-él, numuu rí ikhín nikujmaa Ana̱ꞌlóꞌ inuu̱, nákhí ído̱ rí nagáyuu̱ inuu dxíyo̱o̱. <verse eid="GEN 35:7" /><verse number="8" style="v" sid="GEN 35:8" />Jamí ikhín máꞌ nijáñuu nána̱ Débo̱ra̱, tsí nimédóo Rebéka̱. Nijnguáa̱n ná mijngi Bet-él, ná agoo mbá ixe̱ xi̱xoo. Ikhaa ne̱ nigo̱ mbiꞌyuu Alón-bakút.<verse eid="GEN 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 35:9" />Ído̱ rí nitanga̱a̱ máꞌ Jakób ná Padán-arám, nikujmaa mbu̱jú Ana̱ꞌlóꞌ inuu̱, jamí ni̱gu̱ma-tsakun-rámaa̱. <verse eid="GEN 35:9" /><verse number="10" style="v" sid="GEN 35:10" />Xáꞌnii waꞌtháa̱n neꞌne Ana̱ꞌlóꞌ: «Jakób phú mbiꞌyaaꞌ no. Ná-xáꞌne mbiꞌyaaꞌ Jakób rá, rí Israél phú gáꞌne mbiꞌyaaꞌ». Ikhaa jngó Israél máꞌ neꞌne mbiꞌyuu̱. <verse eid="GEN 35:10" /><verse number="11" style="v" sid="GEN 35:11" />Mangaa waꞌtháa̱n xóó neꞌne Ana̱ꞌlóꞌ: «Ikhúúnꞌ ñaju̱nꞌ Ana̱a̱ꞌ tsí Gíꞌdoo Xúgíí Tsiakhe̱. A̱ga̱mi̱diúún xa̱bia̱a̱ꞌ. Ná ikháán ma̱ga̱jnúu mbá xuajen mba̱a̱, xúꞌkhue̱n máꞌ mbaꞌa xuajen mba̱ꞌo̱ ma̱ꞌne. Jamí ma̱ga̱jnúú xa̱bo̱ ñajun mba̱ꞌu̱u̱n ná inúú xa̱bo̱ ri̱jia̱a̱ꞌ. <verse eid="GEN 35:11" /><verse number="12" style="v" sid="GEN 35:12" />Mbaa rí ni̱xnu̱u̱ máꞌ Abraám ga̱jma̱á Isaák, na̱xna̱a̱ꞌ ne̱ ikháán, jamí nda̱wa̱á mangiin xa̱bia̱a̱ꞌ ma̱xnu̱ú ne̱». <verse eid="GEN 35:12" /><verse number="13" style="v" sid="GEN 35:13" />A̱ꞌkhue̱n rí ni̱ka̱a̱ Ana̱ꞌlóꞌ ná rí nindxákuu̱n ga̱jma̱á Jakób.<verse eid="GEN 35:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 35:14" />Xómáꞌ Jakób nitsiji mbá tsina ná rí nindxákuu̱n ga̱jmáa̱ Ana̱ꞌlóꞌ. Mbá tsinuu itsí ñajuun ne̱, jamí nistrámuu̱ iyoo úba̱ ga̱jma̱á iya miꞌtsín ná inuu ne̱, rí neꞌne tsakun-rámuu̱. <verse eid="GEN 35:14" /><verse number="15" style="v" sid="GEN 35:15" />Xúꞌkhue̱n máꞌ nixnúu mbiꞌyuu ne̱ Bet-él ná rí nindxákuu̱n ga̱jmáa̱ Ana̱ꞌlóꞌ.<verse eid="GEN 35:15" /></para>
  <para style="s">Nijáñuu Rakél</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16" />Nda̱wa̱á nigájnúu̱ ná Bet-él. I̱lájuíin máꞌ eꞌne rí ma̱guáꞌníi̱ ná Efráta̱, ído̱ neꞌne xuajiin Rakél, jamí phú mingíjiúu neꞌne rí ma̱gu̱maa a̱dée̱. <verse eid="GEN 35:16" /><verse number="17" style="v" sid="GEN 35:17" />Awúun máꞌ rí i̱tha̱n mingíjiúu eꞌne, a̱ꞌkhue̱n iꞌthán a̱ꞌgo̱ tsí na̱grui̱gúun e̱je̱n: «Ma̱xámíñaaꞌ, numuu rí xtaꞌdaa máꞌ i̱mba̱a̱ a̱ꞌdeáaꞌ dxáma». <verse eid="GEN 35:17" /><verse number="18" style="v" sid="GEN 35:18" />Ído̱ rí inu máꞌ na̱ka̱ xu̱u̱ꞌ, nixnúu̱ mbiꞌyuu ada̱ Benóni̱,<note caller="+" style="f"><char style="fr" closed="false">35.18 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, mbiꞌyuu Benóni̱ naꞌthán-wíi̱ «ada̱ gaꞌkho̱».</char></note> a̱ꞌkhue̱n nijáñuu̱. I̱ndo̱ó numuu rí Jakób nixnúu̱ mbiꞌyuu ada̱ Benjamín.<note caller="+" style="f"><char style="fr" closed="false">35.18 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, mbiꞌyuu Benjamín naꞌthán-wíi̱ «ada̱ nga̱jua̱a̱».</char></note><verse eid="GEN 35:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 35:19" />Xkuaꞌnii nijáñuu Rakél, jamí nijnguáa̱n ná jambo̱o̱ Efráta̱, rí ikhaa máꞌ ñajuun Belén xúge̱ꞌ. <verse eid="GEN 35:19" /><verse number="20" style="v" sid="GEN 35:20" />Ná rí nijnguáa̱n, Jakób nitsiji mbá itsí. Ikhaa ne̱ isngájma ná rí nijnguáa̱n Rakél asndo máꞌ mbiꞌi xúge̱ꞌ. <verse eid="GEN 35:20" /><verse number="21" style="v" sid="GEN 35:21" />A̱ꞌkhue̱n rí Israél nigájnuu, jamí ni̱ka̱ gáskuíji̱i̱ guꞌwá xtíin i̱tháan tsíngua̱ꞌ ná inuu Migdál-edár.<verse eid="GEN 35:21" /></para>
  <para style="s">I̱ji̱i̱n Jakób</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 35:22" />Awúun máꞌ rí xtáa Israél ná mbaa rúꞌkhue̱n, xómáꞌ Rubén rá, niꞌgu ga̱jma̱á Bíla̱ tsí mbáa máꞌ gu̱ꞌwi̱i̱ anu̱u̱, jamí nidxawuun anu̱u̱ rí niꞌnii̱.</para>
  <para style="p" vid="GEN 35:22">Israél ni̱gi̱ꞌdiin mbá gue̱jmi̱i̱ i̱ji̱i̱n tsí xa̱bekha:<verse eid="GEN 35:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 35:23" />Tsí i̱ji̱i̱n Léa̱ ñajúún: Rubén xa̱bo̱ tsí ginii jayu a̱dée Jakób, Simeón, Lebí, Judá, Isakár jamí Sabulón.<verse eid="GEN 35:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 35:24" />Tsí i̱ji̱i̱n Rakél ñajúún: José jamí Benjamín.<verse eid="GEN 35:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 35:25" />Tsí i̱ji̱i̱n Bíla̱, yumbée máꞌ Rakél ñajúún: Dán jamí Neftalí.<verse eid="GEN 35:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 35:26" />Jamí tsí i̱ji̱i̱n Sílpa̱, yumbée máꞌ Léa̱ ñajúún: Gád jamí Asér.</para>
  <para style="p" vid="GEN 35:26">Tsúꞌkhue̱n ñajúún i̱ji̱i̱n Jakób, tsí ni̱gu̱mii ná Padán-arám.<verse eid="GEN 35:26" /></para>
  <para style="s">Nijáñuu Isaák</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27" />Nda̱wa̱á ni̱ka̱ Jakób ná xtáa Isaák tsí anu̱u̱ máꞌ, ná Mámre̱, ná xuajen Árba̱, rí ñajuun máꞌ Ebrón, ná rí nixtáa máꞌ Abraám ga̱jma̱á Isaák. <verse eid="GEN 35:27" /><verse number="28" style="v" sid="GEN 35:28" />Mbiꞌi rí nixtáa Isaák neꞌne mbá mijnagu̱wa̱ꞌ skíñú (180) tsigu. <verse eid="GEN 35:28" /><verse number="29" style="v" sid="GEN 35:29" />Xi̱ꞌñú guéño máꞌ ñajuu̱n ído̱ rí ni̱ka̱ xu̱u̱ꞌ nijáñuu̱, jamí nimbáxi̱i̱ꞌ gajmíi̱ a̱ngui̱i̱n. A̱ꞌkhue̱n rí Esaú ga̱jma̱á Jakób, tsí i̱ji̱i̱n máꞌ, nidi̱i̱.<verse eid="GEN 35:29" /></para>
  <chapter eid="GEN 35" />
  <chapter number="36" style="c" sid="GEN 36" />
  <para style="s">Tsí ñajúún xa̱bi̱i̱ Esaú</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1" />Tsíge̱ꞌ ñajúún xa̱bi̱i̱ Esaú, tsí ikhaa máꞌ mbiꞌyuu Edóm. <verse eid="GEN 36:1" /><verse number="2" style="v" sid="GEN 36:2" />Esaú ninigúún nigu̱u̱n go̱ꞌo̱ i̱ji̱ín xa̱bo̱ Kanaán: Áda̱, a̱dée Elón mbo̱ xa̱bi̱i̱ Ét, ga̱jma̱á Aolibáma̱, a̱dée Aná tsí a̱dée máꞌ Sibeón mbo̱ ebéo̱, <verse eid="GEN 36:2" /><verse number="3" style="v" sid="GEN 36:3" />ga̱jma̱á Basemát, a̱dée Ismaél, tsí dxáguíi máꞌ Nebayót. <verse eid="GEN 36:3" /><verse number="4" style="v" sid="GEN 36:4" />Áda̱ neꞌne ku̱maa̱ Elifás a̱dée máꞌ Esaú, jamí Basemát neꞌne ku̱maa̱ Reuél. <verse eid="GEN 36:4" /><verse number="5" style="v" sid="GEN 36:5" />Xómáꞌ Aolibáma̱ neꞌne ku̱maa Jeús, Jaalám ga̱jma̱á Koré. Tsúꞌkhue̱n ñajúún i̱ji̱i̱n Esaú tsí ni̱gu̱mii ná mbaa Kanaán.<verse eid="GEN 36:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 36:6" />A̱ꞌkhue̱n rí Esaú nigu̱u̱n gu̱ꞌwi̱i̱, i̱ji̱i̱n tsí jiáma, i̱ji̱i̱n tsí go̱ꞌo̱, jamí mbá xúgíin xa̱bo̱ ná goꞌóo̱, jamí mbá xúgíin xu̱kuíi̱, jamí mbá xúgíí rí ni̱ka̱ ra̱ge̱ꞌdoo̱ ná mbaa Kanaán, ni̱ke̱e̱ i̱mba̱ mbaa gáxtáa̱, rí neꞌne tsíngua̱ꞌ-mine̱e̱ꞌ inuu Jakób. <verse eid="GEN 36:6" /><verse number="7" style="v" sid="GEN 36:7" />Numuu rí ikhii̱n phú kuaꞌdáa̱ mi̱ndaꞌkho, jamí tsíyoo ma̱ju̱wée̱ꞌ mbóó, ni máꞌ mbaa ná rí júwe̱e̱ꞌ tséꞌngo̱o̱ ma̱peꞌtso xu̱kuíi̱n. <verse eid="GEN 36:7" /><verse number="8" style="v" sid="GEN 36:8" />Ikhaa jngó Esaú ni̱ka̱ gáxtáa ná júba̱ Seír. Edóm máꞌ mbiꞌyuu Esaú mangaa.<verse eid="GEN 36:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 36:9" />Tsíge̱ꞌ ñajúún xa̱bo̱ ri̱jiu̱u̱ꞌ Esaú, tsí ikhaa máꞌ ñajuun xi̱ꞌñúú xa̱bo̱ Edóm, tsí nijúwá ná mbaa júba̱ Seír. <verse eid="GEN 36:9" /><verse number="10" style="v" sid="GEN 36:10" />Ríge̱ꞌ ñajuun mbiꞌñúú i̱ji̱i̱n Esaú: Elifás tsí a̱dée Áda̱ a̱ꞌgui̱i̱ máꞌ Esaú, xúꞌkhue̱n máꞌ Reuél a̱dée Basemát a̱ꞌgui̱i̱ máꞌ Esaú. <verse eid="GEN 36:10" /><verse number="11" style="v" sid="GEN 36:11" />Jamí i̱ji̱i̱n Elifás ñajúún Temán, Omár, Séfo̱, Gatám jamí Senás. <verse eid="GEN 36:11" /><verse number="12" style="v" sid="GEN 36:12" />Xúꞌkhue̱n máꞌ Tímna̱ ñajuun mbáa máꞌ a̱ꞌgui̱i̱ Elifás, jamí ikhaa̱ neꞌne ku̱maa̱ Amalék. Mbá xúgíin tsúꞌkhue̱n ninindxu̱ún i̱jín-xíñii Áda̱, a̱ꞌgui̱i̱ máꞌ Esaú. <verse eid="GEN 36:12" /><verse number="13" style="v" sid="GEN 36:13" />Xómáꞌ i̱ji̱i̱n Reuél ñajúún Naát, Séra̱, Sáma̱ jamí Mísa̱. Tsúꞌkhue̱n ninindxu̱ún i̱jín-xíñii Basemát, a̱ꞌgui̱i̱ máꞌ Esaú. <verse eid="GEN 36:13" /><verse number="14" style="v" sid="GEN 36:14" />Tsíge̱ꞌ ñajúún i̱ji̱i̱n Aolibáma̱ tsí i̱mba̱a̱ máꞌ a̱ꞌgui̱i̱ Esaú, tsí a̱dée Aná mbo̱ a̱dée máꞌ Sibeón. Ikhaa̱ neꞌne ku̱maa̱ Jeús, Jaalám jamí Koré, tsí i̱ji̱i̱n máꞌ Esaú.<verse eid="GEN 36:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 36:15" />Tsíge̱ꞌ ñajúún xúgíin xa̱bo̱ ede̱ ná rí majiu̱ún i̱ji̱i̱n Esaú. I̱ji̱i̱n Elifás, a̱dée Esaú tsí xa̱bo̱ ginii, tsí ñajúún xa̱bo̱ ede̱: Temán, Omár, Séfo̱, Senás, <verse eid="GEN 36:15" /><verse number="16" style="v" sid="GEN 36:16" />Koré, Gatám jamí Amalék. Tsúꞌkhue̱n ninindxu̱ún xa̱bo̱ ede̱ ná rí ri̱jiu̱u̱ꞌ Elifás ná numbaa máꞌ Edóm, tsí i̱jín-xíñii máꞌ Áda̱. <verse eid="GEN 36:16" /><verse number="17" style="v" sid="GEN 36:17" />Jamí tsíge̱ꞌ ñajúún i̱ji̱i̱n Reuél, a̱dée máꞌ Esaú, tsí ninindxu̱ún xa̱bo̱ ede̱: Naát, Séra̱, Sáma̱ jamí Mísa̱. Tsúꞌkhue̱n ninindxu̱ún xa̱bo̱ ede̱ ná rí ri̱jiu̱u̱ꞌ Reuél ná rí numbaa máꞌ Edóm. Jamí xúgíin tsúꞌkhue̱n ninindxu̱ún i̱jín-xíñii Basemát, a̱ꞌgui̱i̱ máꞌ Esaú. <verse eid="GEN 36:17" /><verse number="18" style="v" sid="GEN 36:18" />Xómáꞌ tsíge̱ꞌ ñajúún i̱ji̱i̱n Aolibáma̱, a̱ꞌgui̱i̱ máꞌ Esaú, tsí ñajúún xa̱bo̱ ede̱: Jeús, Jaalám ga̱jma̱á Koré. Tsúꞌkhue̱n ninindxu̱ún xa̱bo̱ ede̱ ná i̱ji̱i̱n Aolibáma̱, a̱dée máꞌ Aná. <verse eid="GEN 36:18" /><verse number="19" style="v" sid="GEN 36:19" />Mbá xúgíin tsúꞌkhue̱n ninindxu̱ún i̱ji̱i̱n Esaú, xúꞌkhue̱n máꞌ xa̱bo̱ ede̱ drígúu̱n. Esaú mbiꞌyuu máꞌ Edóm.<verse eid="GEN 36:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 36:20" />Xómáꞌ tsíge̱ꞌ ñajúún i̱ji̱i̱n Seír mbo̱ oréo̱, mbo̱ júwá máꞌ ná mbaa rúꞌkhue̱n: Lotán, Sobál, Sibeón, Aná, <verse eid="GEN 36:20" /><verse number="21" style="v" sid="GEN 36:21" />Disón, Esér ga̱jma̱á Disán. Tsúꞌkhue̱n ninindxu̱ún xa̱bo̱ ede̱ drígu̱ún mbo̱ oréo̱, i̱ji̱i̱n máꞌ Seír, ná rí mbayuu Edóm. <verse eid="GEN 36:21" /><verse number="22" style="v" sid="GEN 36:22" />Tsí i̱ji̱i̱n Lotán ñajúún Óri̱ ga̱jma̱á Emám, xúꞌkhue̱n máꞌ Tímna̱ ñajuun dxáguíi Lotán. <verse eid="GEN 36:22" /><verse number="23" style="v" sid="GEN 36:23" />Tsí i̱ji̱i̱n Sobál ñajúún Albán, Manaát, Ebál, Séfo̱ ga̱jma̱á Onám. <verse eid="GEN 36:23" /><verse number="24" style="v" sid="GEN 36:24" />Tsí i̱ji̱i̱n Sibeón ñajúún Ája̱ ga̱jma̱á Aná. Aná tsíge̱ꞌ ñajuun tsí nixkamaa iduu iya ná mbaa niníí, ído̱ rí na̱ka̱ ra̱ña̱wúu̱n xtá-ngidiuu Sibeón tsí anu̱u̱ máꞌ. <verse eid="GEN 36:24" /><verse number="25" style="v" sid="GEN 36:25" />Tsí i̱ji̱i̱n Aná ñajúún Disón ga̱jma̱á mbáa a̱ꞌgo̱ mbiꞌyuu Aolibáma̱. <verse eid="GEN 36:25" /><verse number="26" style="v" sid="GEN 36:26" />Tsíge̱ꞌ ñajúún i̱ji̱i̱n Disón: Emdán, Esbán, Itrán ga̱jma̱á Kerán. <verse eid="GEN 36:26" /><verse number="27" style="v" sid="GEN 36:27" />Jamí tsíge̱ꞌ ñajúún i̱ji̱i̱n Esér: Bilán, Saabán ga̱jma̱á Akán. <verse eid="GEN 36:27" /><verse number="28" style="v" sid="GEN 36:28" />Tsíge̱ꞌ ñajúún i̱ji̱i̱n Disán: Ús ga̱jma̱á Arán. <verse eid="GEN 36:28" /><verse number="29" style="v" sid="GEN 36:29" />Ikhín máꞌ tsíge̱ꞌ ñajúún xa̱bo̱ ede̱ drígu̱ún mbo̱ oréo̱: Lotán, Sobál, Sibeón, Aná, <verse eid="GEN 36:29" /><verse number="30" style="v" sid="GEN 36:30" />Disón, Esér ga̱jma̱á Disán. Tsúꞌkhue̱n ninindxu̱ún xa̱bo̱ ede̱ tsí mbámbáa máꞌ niꞌthán-ñájuun xuajiuun ná mbaa Seír.<verse eid="GEN 36:30" /></para>
  <para style="s">Thúngaa mba̱ꞌu̱u̱n ná Edóm</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 36:31" />Nákhí rí xóó ndawa̱a̱ nimbáa thúngaa mba̱a̱ inúú xa̱bo̱ Israél, tsíge̱ꞌ ñajúún thúngaa mba̱ꞌu̱u̱n ná numbaa máꞌ Edóm: <verse eid="GEN 36:31" /><verse number="32" style="v" sid="GEN 36:32" />Béla̱ a̱dée Beór niꞌthán-ñájun ná mbayuu Edóm, jamí Dinába̱ mbiꞌyuu xuajiuu̱n. <verse eid="GEN 36:32" /><verse number="33" style="v" sid="GEN 36:33" />Ído̱ nijáñuu Béla̱, a̱ꞌkhue̱n ninújnga̱a̱ꞌ niꞌthán-ñájun Jobáb, a̱dée Séra̱ tsí na̱ꞌkha̱ ná Bósra̱. <verse eid="GEN 36:33" /><verse number="34" style="v" sid="GEN 36:34" />Ído̱ nijáñuu Jobáb, a̱ꞌkhue̱n ninújnga̱a̱ꞌ niꞌthán-ñájun Usám, tsí na̱ꞌkha̱ ná numbaa Temán. <verse eid="GEN 36:34" /><verse number="35" style="v" sid="GEN 36:35" />Ído̱ nijáñuu Usám, a̱ꞌkhue̱n ninújnga̱a̱ꞌ niꞌthán-ñájun Adád, a̱dée Bedád. Adád ni̱ꞌngo̱o̱ rí nixná-míjná ga̱jmáa̱ Madián ná mbaa Moáb, jamí Abít mbiꞌyuu xuajiuu̱n. <verse eid="GEN 36:35" /><verse number="36" style="v" sid="GEN 36:36" />Ído̱ nijáñuu Adád, a̱ꞌkhue̱n ninújnga̱a̱ꞌ niꞌthán-ñájun Sámla̱, tsí na̱ꞌkha̱ ná Masréka̱. <verse eid="GEN 36:36" /><verse number="37" style="v" sid="GEN 36:37" />Ído̱ nijáñuu Sámla̱, a̱ꞌkhue̱n ninújnga̱a̱ꞌ niꞌthán-ñájun Saúl, tsí na̱ꞌkha̱ ná Reobót rí ꞌgí ná rawuun mañuu Éufra̱te̱s. <verse eid="GEN 36:37" /><verse number="38" style="v" sid="GEN 36:38" />Ído̱ nijáñuu Saúl, a̱ꞌkhue̱n ninújnga̱a̱ꞌ niꞌthán-ñájun Baál-anán, a̱dée Akbór. <verse eid="GEN 36:38" /><verse number="39" style="v" sid="GEN 36:39" />Ído̱ nijáñuu Baál-anán a̱dée Akbór, a̱ꞌkhue̱n ninújnga̱a̱ꞌ niꞌthán-ñájun Adár. Páu̱ mbiꞌyuu xuajiuu̱n, xómáꞌ a̱ꞌgui̱i̱ mbiꞌyuu Meetabél, tsí a̱dée nána̱ Matréd, a̱ꞌdá-xíñii máꞌ Mesaáb.<verse eid="GEN 36:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 36:40" />Ríge̱ꞌ ñajuun mbiꞌñúú xa̱bo̱ ede̱ ná rí xa̱bi̱i̱ máꞌ Esaú, mbámbá inii ri̱jiúu̱n, mbámbá inii xuajiúu̱n: Tímna̱, Álba̱, Jetét, <verse eid="GEN 36:40" /><verse number="41" style="v" sid="GEN 36:41" />Aolibáma̱, Éla̱, Pinón, <verse eid="GEN 36:41" /><verse number="42" style="v" sid="GEN 36:42" />Senás, Temán, Mibsár, <verse eid="GEN 36:42" /><verse number="43" style="v" sid="GEN 36:43" />Magdiél ga̱jma̱á Irám. Tsúꞌkhue̱n ninindxu̱ún xa̱bo̱ ede̱ ná xa̱bi̱i̱ Edóm, mbámbá máꞌ mbaa rí kuaꞌdáa̱ ná rí júwe̱e̱ꞌ. Edóm ñajuun máꞌ Esaú, xi̱ꞌñúú xa̱bo̱ Edóm.<verse eid="GEN 36:43" /></para>
  <chapter eid="GEN 36" />
  <chapter number="37" style="c" sid="GEN 37" />
  <para style="s">Rí nigundaa José</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1" />Jakób nixtáa ná mbaa Kanaán, ná máꞌ nixtáa anu̱u̱. <verse eid="GEN 37:1" /><verse number="2" style="v" sid="GEN 37:2" />Ríge̱ꞌ ñajuun rí naꞌthán xóo nijúwá i̱ji̱i̱n Jakób: Ído̱ rí José gíꞌdoo mbá gu̱wa̱ꞌ-nítsu i̱jma̱ tsiguu̱, na̱ka̱ ra̱ña̱wúu̱n mogo̱ gajmíi̱ dxíyo̱o̱. Xómáꞌ ikhaa̱ xtáa̱ gajmíi̱ i̱ji̱i̱n Bíla̱ jamí i̱ji̱i̱n Sílpa̱, tsí gu̱ꞌwi̱i̱ máꞌ anu̱u̱. Xúꞌkhue̱n máꞌ naꞌthúu̱n anu̱u̱ rí xóo kri̱ga̱ ajngáa rí ra̱máján rí none̱ dxíyo̱o̱.<verse eid="GEN 37:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 37:3" />Xómáꞌ Israél ja rá, phú nando-jaꞌyoo̱ i̱tháan José xó rí mbá xúgíin i̱ji̱i̱n, numuu rí ni̱gi̱ꞌdaa̱ ído̱ rí xi̱ꞌñú máꞌ ñajuu̱n. Ikhaa jngó niꞌnii̱ mbá xtíñuu rí phú mitsaan rí mbaꞌa mixtiúu. <verse eid="GEN 37:3" /><verse number="4" style="v" sid="GEN 37:4" />Jamí ído̱ ndiyáá dxíyo̱o̱ rí i̱tháan nando-jiꞌyáa̱ ikhaa̱ eꞌne anu̱u̱ xóo rí mbá xúgíi̱n ikhii̱n, a̱ꞌkhue̱n rí najiꞌníi̱ juyáa̱, jamí nánguá itháa̱n ga̱jma̱á ajngáa máján wáa.<verse eid="GEN 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 37:5" />A̱ꞌkhue̱n rí mbá mbiꞌi nigundaa José, jamí ni̱gu̱wí-jnga̱a̱ xnuꞌndaa inúú dxíyo̱o̱. Xómáꞌ ikhii̱n i̱tháan najiꞌníi̱ juyáa̱ xóó, <verse eid="GEN 37:5" /><verse number="6" style="v" sid="GEN 37:6" />numuu rí niꞌthúu̱n:</para>
  <para style="p" vid="GEN 37:6">―Gu̱dxawíínlaꞌ xúge̱ꞌ rí ni̱gúndaa jún rá. <verse eid="GEN 37:6" /><verse number="7" style="v" sid="GEN 37:7" />Ná xanáá kacháánlóꞌ nuruꞌwáálóꞌ xtaꞌdu̱u̱ ra̱xo̱o̱ ixí iña. A̱ꞌkhue̱n rí xtaꞌdu̱u̱ drígo̱ꞌ ni̱we̱je̱ jmbu ne̱, xómáꞌ xtaꞌdu̱u̱ dríga̱ꞌlaꞌ ni̱ge̱ꞌe̱ jndi ná inuu drígo̱ꞌ jamí ndiya-makuíi̱ ne̱.<verse eid="GEN 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 37:8" />A̱ꞌkhue̱n ni̱ri̱ꞌñaa̱ dxíyo̱o̱:</para>
  <para style="p" vid="GEN 37:8">―Ikháán ma̱ra̱tha̱n-ñájuanxo̱ꞌ ráꞌ, jamí ma̱nimba̱ꞌxo̱ꞌ ju̱ya̱a̱ꞌ ráꞌ.</para>
  <para style="p" vid="GEN 37:8">A̱ꞌkhue̱n rí i̱tháan najiꞌníi̱ juyáa̱ xóó ga̱jma̱á numuu xnuꞌndaa, xúꞌkhue̱n máꞌ ajngáa xóo rí naꞌthúu̱n.<verse eid="GEN 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 37:9" />Nigundaa̱ xóó i̱mba̱ xnuꞌndaa, jamí ni̱gu̱wí-jnga̱a̱ ne̱ inúú dxíyo̱o̱:</para>
  <para style="p" vid="GEN 37:9">―Xúge̱ꞌ ni̱gúndaa-lá i̱mba̱ mbu̱jú rá. Ndi̱yo̱o̱ a̱kha̱ꞌ ga̱jma̱á go̱nꞌ xúꞌkhue̱n máꞌ mbá gue̱mba̱ a̱ꞌgua̱án rí nduya̱-makui̱ꞌ-lá méꞌ.<verse eid="GEN 37:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 37:10" />Jamí ni̱gu̱wí-jnga̱a̱ ne̱ inuu anu̱u̱ xúꞌkhue̱n máꞌ inúú dxíyo̱o̱. A̱ꞌkhue̱n waxpríguíi̱ neꞌne anu̱u̱ jamí waꞌtháa̱n:</para>
  <para style="p" vid="GEN 37:10">―Dí-lá iꞌthán xnuꞌndaa ríge̱ꞌ rí nitanuꞌndaa ján rá. Á ma̱gu̱ma rí ikhúúnꞌ, ru̱dáaꞌ jamí dxíya̱a̱ꞌ ma̱gúwa̱ꞌxo̱ꞌ mu̱sma̱tíga̱ꞌxo̱ꞌ inaaꞌ asndo mbayíí rá dxe̱ꞌ.<verse eid="GEN 37:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 37:11" />Tsí dxíyo̱o̱ naxígu̱ún juyáa̱, xómáꞌ anu̱u̱ nandxaꞌwá-mina̱ꞌ ga̱jma̱á numuu rúꞌkhue̱n.<verse eid="GEN 37:11" /></para>
  <para style="s">Rí nigíꞌnuu José nene̱ a̱ngui̱i̱n</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12" />Nda̱wa̱á nigóó dxíyo̱o̱ ná Sikém, judii̱n mogui̱i̱ anúu̱ rí mu̱ña̱wúu̱n ikhín. <verse eid="GEN 37:12" /><verse number="13" style="v" sid="GEN 37:13" />A̱ꞌkhue̱n Israél niꞌthúun José:</para>
  <para style="p" vid="GEN 37:13">―A̱ngia̱a̱nꞌ gatiin nu̱ña̱wu̱ún mogo̱ ná Sikém. Nando̱ꞌ rí mi̱dxu̱ꞌ ná kachúu̱n.</para>
  <para style="p" vid="GEN 37:13">Xómáꞌ ikhaa̱ niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 37:13">―Xtáá ma̱ꞌgálo̱ꞌ.<verse eid="GEN 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 37:14" />A̱ꞌkhue̱n Israél niꞌthúu̱n:</para>
  <para style="p" vid="GEN 37:14">―Ayu xúge̱ꞌ, athayáá xóo júwa̱ꞌ dxíya̱a̱ꞌ, xóo júwa̱ꞌ mogo̱, jamí aya̱a̱ꞌ máꞌ ꞌcháa ajngáa ma̱dxawuunlo̱ꞌ.</para>
  <para style="p" vid="GEN 37:14">A̱ꞌkhue̱n rí Israél nixuꞌmaa José ni̱ka̱. Nigájnuu̱ ná xkua̱ Ebrón, a̱ꞌkhue̱n ni̱ga̱níi̱ asndo ná Sikém. <verse eid="GEN 37:14" /><verse number="15" style="v" sid="GEN 37:15" />Jamí ikhín waxkamaa̱ eꞌne mbáa xa̱bo̱ rí ni̱ngra̱ꞌaa̱ ná xanáá. A̱ꞌkhue̱n watraxíi̱ eꞌne xa̱bo̱ tsúꞌkhue̱n:</para>
  <para style="p" vid="GEN 37:15">―Díne ithaꞌyáa̱ꞌ rá.<verse eid="GEN 37:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 37:16" />Xómáꞌ José niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 37:16">―Nda̱ꞌñíi̱ꞌlo̱ꞌ dxíyo̱ꞌ. Arathúnꞌ tháan náá katii̱n nu̱ña̱wúu̱n xu̱kú ithayáá ján.<verse eid="GEN 37:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 37:17" />Xómáꞌ xa̱bo̱ tsúꞌkhue̱n niꞌthán:</para>
  <para style="p" vid="GEN 37:17">―Nigóo̱ máꞌ ná ge̱e̱ ikhii̱n. I̱ndo̱ó ni̱dxawuun rí nithee̱n: “U̱ꞌgua̱lóꞌ ná Dotán rá”.</para>
  <para style="p" vid="GEN 37:17">A̱ꞌkhue̱n rí José ni̱ka̱ ná nigóó dxíyo̱o̱, jamí ni̱ka̱ gáxkami̱i̱ ná Dotán. <verse eid="GEN 37:17" /><verse number="18" style="v" sid="GEN 37:18" />Jamí ído̱ ndiyáa̱ rí na̱ꞌkha̱ tsíngua̱ꞌ José, rí xóó máꞌ tága̱níi̱ mijngi ná rí kachúu̱n, a̱ꞌkhue̱n nithan-mi̱jne̱e̱ xáne rí mu̱xi̱ya̱a̱. <figure style="fig" alt="José encuentra hermanos, borregos" file="co00703b.tif" size="span" ref="37.18">José na̱ga̱nú ná gatiin dxíyo̱o̱ nu̱ña̱wúún mogo̱.</figure> <verse eid="GEN 37:18" /><verse number="19" style="v" sid="GEN 37:19" />Xáꞌnii nithee̱n:</para>
  <para style="p" vid="GEN 37:19">―A̱gu̱ya̱xíí-lálaꞌ rí a̱ꞌkhue̱n i̱ꞌkha̱ xa̱bo̱ xnuꞌndaa rá. <verse eid="GEN 37:19" /><verse number="20" style="v" sid="GEN 37:20" />Xúge̱ꞌ rí ni̱ga̱nú mbiꞌi rá. Awalaꞌ mu̱xíya̱a̱lóꞌ jamí gu̱xpa̱tuáꞌáa̱nlóꞌ ná awúun mbá iñá drígo̱o̱ iya. A̱ꞌkhue̱n mu̱ꞌthánlóꞌ: “Mbáa xu̱kú-xáná wanitsíi̱ neꞌne”. A̱ꞌkhue̱n mbu̱ꞌyáá dí gáꞌne xnuꞌnduu̱ xúꞌkhue̱n rá.<verse eid="GEN 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 37:21" />Ído̱ niꞌdxuun Rubén rí xúꞌkhue̱n ithee̱n, niꞌnii̱ rí ma̱ꞌne-jríya̱a̱ꞌ ná ñawúún dxíyo̱o̱, jamí niꞌthúu̱n xáꞌnii:</para>
  <para style="p" vid="GEN 37:21">―Ma̱xúxíya̱a̱-málóꞌ. <verse eid="GEN 37:21" /><verse number="22" style="v" sid="GEN 37:22" />―Jamí niꞌthúu̱n xóó―: Ma̱xúxi̱díílaꞌ iꞌdi. I̱wa̱á máján gu̱xpa̱tuáꞌáa̱nlaꞌ ná iñá drígo̱o̱ iya rí ꞌgí ná mbaa niníí ge̱e̱, jamí ma̱xúne̱ ngínáa̱laꞌ.</para>
  <para style="p" vid="GEN 37:22">Niꞌthée̱n rúꞌkhue̱n numuu rí ma̱goo ma̱ꞌne-jríya̱a̱ꞌ José ná ñawúún dxíyo̱o̱, jngó xúꞌkhue̱n ma̱xuꞌma̱a̱ inuu anu̱u̱, i̱ju̱mu̱u̱.<verse eid="GEN 37:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 37:23" />Jamí ído̱ ni̱ga̱nú José ná gatiin dxíyo̱o̱, a̱ꞌkhue̱n ikhii̱n ni̱ri̱ye̱e̱ꞌ xtíin rí júwuu̱n rí mbaꞌa mixtiúu. <verse eid="GEN 37:23" /><verse number="24" style="v" sid="GEN 37:24" />A̱ꞌkhue̱n ni̱xpa̱tua̱ꞌa̱a̱n ná iñá drígo̱o̱ iya, i̱ndo̱ó numuu rí iñúu iya ri̱ga̱ mixoo, nda̱a̱ máꞌ iya ikhín. <verse eid="GEN 37:24" /><verse number="25" style="v" sid="GEN 37:25" />Nda̱wa̱á a̱ꞌkhue̱n nikuíji̱i̱n nipiꞌtsii̱. Jamí a̱ꞌkhue̱n ni̱ya̱xi̱i̱, ndiyáa̱ rí naguwá mbaꞌiin xa̱bo̱ ismaelíta̱ tsí naguwá ná Galaád. Naguwée̱ꞌ gajmíi̱ kaméyo̱ judee̱ iya ndaa thawuun, wájia thana ndaa thawuun ga̱jma̱á wájioo ixu̱u̱ mírra̱, rí ná Ejípto̱ igóo̱ judúu̱n ne̱.<verse eid="GEN 37:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 37:26" />A̱ꞌkhue̱n Judá niꞌthúún dxíyo̱o̱: «Náá-lá rí máján gámbáyálóꞌ rí mu̱xíya̱a̱lóꞌ dxíya̱ꞌlóꞌ, xúꞌkhue̱n máꞌ rí mu̱rkaꞌwíílóꞌ rí nijáñuu̱ rá. <verse eid="GEN 37:26" /><verse number="27" style="v" sid="GEN 37:27" />I̱wa̱á máján rí gu̱ngu̱jua̱a̱lóꞌ inúú mbo̱ ismaelíta̱ xóo rí mo̱ꞌne̱ ngínáa̱lóꞌ. Numuu rí dxíya̱ꞌ-málóꞌ jamí iꞌdia-málóꞌ ñajuu̱n». Xkuaꞌnii jngó nigruígúun dxíyo̱o̱ rí niꞌthée̱n. <verse eid="GEN 37:27" /><verse number="28" style="v" sid="GEN 37:28" />Jamí ído̱ nigánújngúún mbo̱ madianíta̱<note caller="+" style="f"><char style="fr" closed="false">37.28 </char><char style="ft" closed="false">Tsí «mbo̱ madianíta̱», ikhiin máꞌ ñajúún «mbo̱ ismaelíta̱», xó máꞌ naꞌthán ná kíxnuu 25 ga̱jma̱á 27.</char></note> tsí nagóó ra̱ngu̱jua̱, a̱ꞌkhue̱n ni̱ri̱ya̱a̱ꞌ José ná iñá, jamí ni̱ngu̱jua̱a̱ inúú xa̱bo̱ tsúꞌkhue̱n. Mbá skíñú mbúkha̱a̱ ajua̱nꞌ miꞌxá jámaa̱ rí ni̱ngu̱jua̱a̱. Xkuaꞌnii neꞌne rí nigó juya̱a̱ José ná Ejípto̱. <figure style="fig" alt="Venden a José, madianitas" file="CO00709B.TIF" size="span" ref="37.28">Wa̱ta̱ngu̱jua̱a̱ José nene̱ dxíyo̱o̱.</figure><verse eid="GEN 37:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 37:29" />Nda̱wa̱á nitanga̱a̱ Rubén ni̱ka̱ gáꞌyoo iñá, jamí nánguá-lá kua̱ꞌa̱a̱n José ikhín ndiꞌyoo̱. A̱ꞌkhue̱n ni̱ru̱thii̱n xtíñuu̱ rí natájuíin a̱kui̱i̱n. <verse eid="GEN 37:29" /><verse number="30" style="v" sid="GEN 37:30" />A̱ꞌkhue̱n rí nitanga̱a̱ ná kachúún a̱ngui̱i̱n, jamí niꞌthúu̱n: «Nánguá-lá kua̱ꞌa̱a̱n dxáma ná iñá ndi̱yo̱o̱. Xómáꞌ ikhúúnꞌ, náá rí gáne̱ xúge̱ꞌ rá».<verse eid="GEN 37:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 37:31" />A̱ꞌkhue̱n ni̱ro̱tho̱n-raꞌáa̱ agoo mbáa a̱ꞌdá-tsútúún, xúꞌkhue̱n máꞌ ni̱xta̱jmáa̱ iꞌdi rúꞌkhue̱n xtíñuu José. <verse eid="GEN 37:31" /><verse number="32" style="v" sid="GEN 37:32" />A̱ꞌkhue̱n nigúu̱n juya̱a̱ xtíin rí mbaꞌa mixtiúu inuu anúu̱, jamí nitháa̱n:</para>
  <para style="p" vid="GEN 37:32">―Ni̱xkama̱a̱xo̱ꞌ ríge̱ꞌ. Á ra̱ꞌkháa-lá xtíñuu a̱ꞌdeáaꞌ ñajuun ríge̱ꞌ ithayáá ján.<verse eid="GEN 37:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 37:33" />Xómáꞌ ikhaa̱ neꞌne-nuwi̱i̱nꞌ ne̱, jamí niꞌthée̱n:</para>
  <para style="p" vid="GEN 37:33">―Xtíñuu a̱ꞌdéꞌ ñajuun ne̱. Mbáa xu̱kú-xáná wanitsíi̱ neꞌne, jamí wachíko-ri̱ga̱a̱ José.<verse eid="GEN 37:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 37:34" />A̱ꞌkhue̱n rí Jakób ni̱ro̱thon xtíñuu, jamí nijúwuu̱nꞌ xtíin rí xíni, numuu rí natájuíin a̱kui̱i̱n. Xúꞌkhue̱n máꞌ mba̱a̱ mbiꞌi nixtáa̱-jínúu̱ ga̱jma̱á numuu a̱dée̱. <verse eid="GEN 37:34" /><verse number="35" style="v" sid="GEN 37:35" />A̱ꞌkhue̱n rí mbá xúgíin i̱ji̱i̱n tsí xa̱bekha jamí go̱ꞌo̱ niguwá rí muxna̱a̱ la tsiakhe̱ anúu̱. I̱ndo̱ó numuu rí ikhaa̱ ra̱khóo̱ gáxná-mina̱a̱ꞌ tsiakhe̱, jamí niꞌthée̱n: «Ma̱xtáá máꞌ jínúꞌ asndo náá gájnguaa̱nꞌ iñá-wa̱jíín ga̱jme̱ꞌ a̱ꞌdéꞌ». Jamí ni̱mbi̱ya̱ꞌ-jmaa̱ máꞌ xúꞌkhue̱n a̱dée̱.<verse eid="GEN 37:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 37:36" />Xómáꞌ mbo̱ madianíta̱<note caller="+" style="f"><char style="fr" closed="false">37.36 </char><char style="ft" closed="false">Tsí «mbo̱ madianíta̱», ikhiin máꞌ ñajúún «mbo̱ ismaelíta̱», xó máꞌ naꞌthán ná kíxnuu 25 ga̱jma̱á 27.</char></note> ni̱ngu̱jua̱a̱ José ná Ejípto̱ inuu mbáa xa̱bi̱i̱ Faraón<note caller="+" style="f"><char style="fr" closed="false">37.36 </char><char style="ft" closed="false">«Faraón» nuxnáá mbiꞌyuu thúngaa mba̱a̱ ná Ejípto̱.</char></note> tsí mbiꞌyuu Potifár, xa̱bo̱ tsí naꞌthán-ñájúún mbo̱ ku̱ra̱tuun ajua̱nꞌ, tsí nu̱ña̱wa̱án máꞌ.<verse eid="GEN 37:36" /></para>
  <chapter eid="GEN 37" />
  <chapter number="38" style="c" sid="GEN 38" />
  <para style="s">Judá ga̱jma̱á Tamár</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1" />Mbiꞌi máꞌ rúꞌkhue̱n, nigájnuu Judá níjiúún a̱ngui̱i̱n, jamí ni̱ke̱e̱ gáxtáa̱ inuu mbáa xa̱bo̱ mbo̱ adulamíta̱, tsí mbiꞌyuu Íra̱. <verse eid="GEN 38:1" /><verse number="2" style="v" sid="GEN 38:2" />Jamí ikhín ndiꞌyoo̱ mbáa a̱ꞌgo̱, a̱dée mbáa xa̱bo̱ mbo̱ kananéo̱ mbiꞌyuu Súwa̱. A̱ꞌkhue̱n ndiyáa̱, jamí niꞌgu ga̱jmáa̱. <verse eid="GEN 38:2" /><verse number="3" style="v" sid="GEN 38:3" />Xómáꞌ ikhaa̱ nigo̱-édee̱, jamí ni̱gu̱maa mbáa a̱dée̱ dxáma, tsí nixnúu̱ mbiꞌyuu Ér. <verse eid="GEN 38:3" /><verse number="4" style="v" sid="GEN 38:4" />Nigo̱-édee̱ mbu̱jú, jamí ni̱gu̱maa i̱mba̱a̱ a̱dée̱ dxáma, tsí nixnúu̱ mbiꞌyuu Onán. <verse eid="GEN 38:4" /><verse number="5" style="v" sid="GEN 38:5" />Nigo̱-édee̱ xóó jamí ni̱gu̱maa i̱mba̱a̱ a̱dée̱ dxáma, tsí nixnúu̱ mbiꞌyuu Séla̱. Jamí ná Kesíb xtáa̱ ído̱ rí ni̱gu̱maa tsúꞌkhue̱n.<verse eid="GEN 38:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 38:6" />Nda̱wa̱á a̱ꞌkhue̱n, Judá ndiꞌyáa mbáa a̱ꞌgo̱ tsí ma̱ꞌne a̱ꞌgui̱i̱ Ér, a̱dée̱ tsí ginii, jamí a̱ꞌgo̱ mbiꞌyuu Tamár. <verse eid="GEN 38:6" /><verse number="7" style="v" sid="GEN 38:7" />Xómáꞌ Ér ja rá, ra̱máján a̱kui̱i̱n inuu Ana̱ꞌlóꞌ Mikhuíí. A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ Mikhuíí nirígúu̱ la mbiꞌyuu̱. <verse eid="GEN 38:7" /><verse number="8" style="v" sid="GEN 38:8" />A̱ꞌkhue̱n rí Judá niꞌthúun Onán: «Ayáa̱ a̱ꞌgui̱i̱ dxíya̱a̱ꞌ, xó rí jaꞌyoo máꞌ, ikhaa jngó ma̱gu̱maa mbáa tsí ma̱nindxu̱u̱ ri̱jiu̱u̱ꞌ dxíya̱a̱ꞌ». <verse eid="GEN 38:8" /><verse number="9" style="v" sid="GEN 38:9" />Xómáꞌ Onán ndaꞌyoo máꞌ rí ma̱xánindxu̱u̱ a̱dée̱ tsí ma̱gu̱maa. Ikhaa jngó mbámbá rí naꞌguii̱ ga̱jmáa̱ a̱ꞌgui̱i̱ dxíyo̱o̱, naxídíi̱ iya tsígoo̱ mbayíí, numuu rí xúꞌkhue̱n ma̱xágu̱maa a̱dée dxíyo̱o̱. <verse eid="GEN 38:9" /><verse number="10" style="v" sid="GEN 38:10" />Ana̱ꞌlóꞌ Mikhuíí táni̱gu̱u̱ꞌ jaꞌyoo rí naꞌnii̱, ikhaa jngó nirígúu̱ la mbiꞌyuu mangaa. <verse eid="GEN 38:10" /><verse number="11" style="v" sid="GEN 38:11" />A̱ꞌkhue̱n Judá niꞌthúun gu̱ꞌgíin: «A̱wanáaꞌ máꞌ rí a̱ꞌgó-xuáꞌa ñajuaanꞌ ná goꞌóo ana̱a̱ꞌ, asndo gáꞌkhi̱i̱ a̱ꞌdéꞌ Séla̱ mbi̱ya̱a̱». Numuu rí ni̱ju̱mu̱u̱: «Ra̱ꞌkhá ma̱ja̱ñúu̱ mangaa̱ xóo rí nijáñúú dxíyo̱o̱». A̱ꞌkhue̱n rí ni̱ka̱a̱ Tamár gáxtáa goꞌóo anu̱u̱.<verse eid="GEN 38:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 38:12" />Nigánújngoo guéño máꞌ mbiꞌi, a̱ꞌkhue̱n rí nijáñuu a̱ꞌgui̱i̱ Judá tsí a̱dée máꞌ Súwa̱. Nda̱wa̱á ído̱ nigánújngoo máꞌ rí natájuíin a̱kui̱i̱n, a̱ꞌkhue̱n ni̱ke̱e̱ ná Timnát ná júwa̱ꞌ xa̱bo̱ tsí nudi̱i̱n mogui̱i̱. Ni̱ka̱ ga̱jmáa̱ xa̱bo̱ iyanga̱jue̱e̱ tsí mbiꞌyuu Íra̱, mbo̱ adulamíta̱. <verse eid="GEN 38:12" /><verse number="13" style="v" sid="GEN 38:13" />A̱ꞌkhue̱n waꞌtháán Tamár ajngáa ríge̱ꞌ: «Á nathayáá rí jmégia̱a̱ꞌ na̱ka̱ ná Timnát gáꞌdi̱i̱n mogui̱i̱ rá». <verse eid="GEN 38:13" /><verse number="14" style="v" sid="GEN 38:14" />A̱ꞌkhue̱n rí ikhaa̱ niríya̱a̱ꞌ xtíñuu̱ rí júwuu̱n rí a̱ꞌgó-xuáꞌa ñajuu̱n, jamí nirogoo̱ inuu̱ ga̱jma̱á mbá xtíin mbawi. Xúꞌkhue̱n máꞌ nimbraꞌa-mine̱e̱ꞌ ni̱gi̱ꞌi̱i̱ ná rawuun xuajen Enaím, ná nagánújngoo máꞌ jambo̱o̱ Timnát. Numuu rí ndiꞌyoo̱ máꞌ rí wáxi̱i̱ Séla̱, jamí na̱nguá xóó ijanaxi̱i̱ rí manújuíi̱nꞌ ga̱jmáa̱.<verse eid="GEN 38:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 38:15" />Ído̱ Judá ndiꞌyoo̱, ni̱ju̱mu̱u̱ rí mbáa a̱ꞌgo̱ tsí na̱ngu̱jua̱-mina̱ꞌ ñajuu̱n, numuu rí ikhaa̱ nirogoo̱ inuu̱. <verse eid="GEN 38:15" /><verse number="16" style="v" sid="GEN 38:16" />A̱ꞌkhue̱n niniñuu̱ jambo̱o̱ ná na̱ke̱e̱, jamí ni̱ke̱e̱ gáꞌthúu̱n:</para>
  <para style="p" vid="GEN 38:16">―Araxnúꞌ tháan rí ma̱bo̱ꞌ ga̱jma̱á nindxa̱a̱ꞌ.</para>
  <para style="p" vid="GEN 38:16">Numuu rí tséꞌyoo̱ xí gu̱ꞌgíi̱n ñajuun. Xómáꞌ ikhaa̱ niꞌthée̱n:</para>
  <para style="p" vid="GEN 38:16">―Díne-lá gára̱xnu̱ꞌ rí ma̱tha̱ba̱a̱ꞌ ga̱jma̱á nindxu̱ꞌ rá.<verse eid="GEN 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 38:17" />A̱ꞌkhue̱n Judá niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 38:17">―Ikhúúnꞌ ma̱xu̱ꞌdú-jma̱a̱ mbáa a̱ꞌdáꞌ-tsútínꞌ, mbi̱ya̱a̱.</para>
  <para style="p" vid="GEN 38:17">Xómáꞌ a̱ꞌgo̱ niꞌthán:</para>
  <para style="p" vid="GEN 38:17">―Máján máꞌ. I̱ndo̱ó atatsíñáá rí ñajuun ꞌcháa, asndo gáta̱xu̱ꞌdú-jma̱a̱ xúꞌkhue̱n rámá.<verse eid="GEN 38:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 38:18" />A̱ꞌkhue̱n niꞌthán Judá:</para>
  <para style="p" vid="GEN 38:18">―Dí-lá gáxna̱a̱ꞌ naꞌcho̱o̱ rá.</para>
  <para style="p" vid="GEN 38:18">Xómáꞌ ikhaa̱ niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 38:18">―Tsinuu dríga̱a̱ꞌ ga̱jma̱á máꞌ ñawiin ne̱, xúꞌkhue̱n máꞌ ixe̱ rí gída̱ꞌ ñawáanꞌ a̱ꞌkhue̱n.</para>
  <para style="p" vid="GEN 38:18">Jamí ikhaa̱ nixnáxu̱u̱ ne̱, a̱ꞌkhue̱n rí nibóo̱ꞌ ga̱jmáa̱. Xómáꞌ a̱ꞌgo̱ nigo̱-éda niꞌnii̱. <verse eid="GEN 38:18" /><verse number="19" style="v" sid="GEN 38:19" />A̱ꞌkhue̱n rí ni̱tu̱xi̱i a̱ꞌgo̱ ni̱ka̱a̱. Jamí nirígúu̱ xtíin rí nirogoo̱ inuu̱, xúꞌkhue̱n máꞌ nijúwa̱a̱nꞌ xtíin rí a̱ꞌgó-xuáꞌa ñajuu̱n.<verse eid="GEN 38:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 38:20" />Nda̱wa̱á wáa nixuꞌdu-jma̱a̱ Judá a̱ꞌdá-tsútúún ná ñawúun xa̱bo̱ iyanga̱jue̱e̱ mbo̱ adulamíta̱, ikhaa jngó magu̱u̱ drígo̱o̱ rí niniñuu̱ naꞌcho̱o̱ ná ñawúun a̱ꞌgo̱. I̱ndo̱ó numuu rí na̱nguá nixkama̱a̱. <verse eid="GEN 38:20" /><verse number="21" style="v" sid="GEN 38:21" />A̱ꞌkhue̱n rí niraxúu̱n xa̱bo̱ xuajen rúꞌkhue̱n:</para>
  <para style="p" vid="GEN 38:21">―Náá xtáa a̱ꞌgo̱ mbo̱ Enaím tsí na̱ngu̱jua̱-mina̱ꞌ, tsí na̱ge̱ꞌe̱ ná rawuun jamba̱á, i̱yáálaꞌ jánlaꞌ.</para>
  <para style="p" vid="GEN 38:21">Xómáꞌ xa̱bo̱ tsúꞌkhue̱n niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 38:21">―Táxtáa ge̱e̱ nimbáa a̱ꞌgo̱ tsí na̱ngu̱jua̱-mina̱ꞌ.<verse eid="GEN 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 38:22" />A̱ꞌkhue̱n rí xa̱bo̱ i̱ya̱nga̱jue̱e̱ Judá nitanga̱a̱ inuu̱, jamí waꞌtháa̱n:</para>
  <para style="p" vid="GEN 38:22">―Táxkama̱a̱ a̱ꞌgo̱. Jamí xúꞌkhue̱n máꞌ xa̱bo̱ tsí júwa̱ꞌ ikhín nithan: “Nimbá miꞌtsún táxtáa ge̱e̱ mbáa a̱ꞌgo̱ tsí na̱ngu̱jua̱-mina̱ꞌ”.<verse eid="GEN 38:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 38:23" />A̱ꞌkhue̱n niꞌthán Judá:</para>
  <para style="p" vid="GEN 38:23">―A̱wanúu máꞌ ga̱jmáa̱ ne̱, ra̱ꞌkhá muthan tsi̱ndiánlóꞌ xa̱bo̱. Inaaꞌ neꞌne rí gakon ikhúúnꞌ ni̱xu̱ꞌdú-jmaa̱ a̱ꞌdá-tsútúún tsíge̱ꞌ, jamí ikháán táta̱xkama̱a̱.<verse eid="GEN 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 38:24" />Ído̱ neꞌne mbá atsúun go̱nꞌ wáa, waꞌtháán Judá:</para>
  <para style="p" vid="GEN 38:24">―Gu̱ꞌgiáanꞌ Tamár niꞌgu ga̱jma̱á mbáa xa̱bo̱, jamí nigo̱-édee̱ numuu rí niꞌnii̱.</para>
  <para style="p" vid="GEN 38:24">A̱ꞌkhue̱n niꞌthán Judá:</para>
  <para style="p" vid="GEN 38:24">―Gu̱ríya̱a̱ꞌlaꞌ, jamí gu̱tsi̱khaa̱laꞌ.<verse eid="GEN 38:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 38:25" />Ído̱ nu̱ri̱ya̱a̱ máꞌ rixa̱á, a̱ꞌkhue̱n ikhaa̱ nixuꞌmee̱ ajngáa ríge̱ꞌ inuu jmégue̱e̱: «Xa̱biya̱ tsí drígo̱o̱ ja̱ꞌne ríge̱ꞌ, tsúꞌkhue̱n neꞌne rí ja̱go̱-éda xúge̱ꞌ. ―Mangaa niꞌthúu̱n―: Athayáá tháan tsáa drígo̱o̱ ja̱ꞌne ríge̱ꞌ: tsina ga̱jma̱á máꞌ ñawiin ne̱, xúꞌkhue̱n máꞌ ixe̱ ñawún». <verse eid="GEN 38:25" /><verse number="26" style="v" sid="GEN 38:26" />A̱ꞌkhue̱n rí Judá neꞌne-nuwi̱i̱nꞌ ne̱, jamí niꞌthée̱n: «I̱wa̱á jmbii̱ ikhaa̱ xóo rí ikhúúnꞌ, numuu rí ikhúúnꞌ táxni̱i̱ a̱ꞌdéꞌ Séla̱ rí ma̱ꞌne a̱jmbaa̱». Jamí ni̱mi̱ꞌtsu̱n ná-tábóo̱ ga̱jmáa̱.<verse eid="GEN 38:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 38:27" />Ído̱ ni̱ga̱nú mbiꞌi rí ma̱ꞌne xuajii̱n, nikujmaa rí e̱je̱n-xpa gatiin awúu̱n. <verse eid="GEN 38:27" /><verse number="28" style="v" sid="GEN 38:28" />Jamí awúun máꞌ rí naꞌne xuajii̱n, niríya̱ꞌ ñawúun mbáa. Xómáꞌ a̱ꞌgo̱ tsí na̱grui̱gúun e̱je̱n niguatuu̱n ñawúun jamí niroꞌóo̱ mbá gúmá maña̱ꞌ. A̱ꞌkhue̱n niꞌthée̱n: «Tsíge̱ꞌ nigájnuu ginii». <verse eid="GEN 38:28" /><verse number="29" style="v" sid="GEN 38:29" />Xómáꞌ ada̱ nixmá-ngua̱ꞌa̱a̱n ñawúun, a̱ꞌkhue̱n ni̱gu̱maa i̱mba̱a̱ dxíyo̱o̱. A̱ꞌkhue̱n niꞌthán a̱ꞌgo̱: «Xáne rí nitarmáꞌtháá jamba̱a̱ ján róꞌ». Ikhaa jngó ada̱ tsúꞌkhue̱n nixnúu̱ mbiꞌyuu Fáre̱s.<note caller="+" style="f"><char style="fr" closed="false">38.29 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, mbiꞌyuu Fáre̱s naꞌthán-wíi̱ «ná ja̱ma̱ꞌtha».</char></note> <verse eid="GEN 38:29" /><verse number="30" style="v" sid="GEN 38:30" />Nda̱wa̱á ni̱gu̱maa dxíyo̱o̱ tsí xtoꞌwóo gúmá maña̱ꞌ ñawúun, jamí nixnúu̱ mbiꞌyuu Sára̱.<verse eid="GEN 38:30" /></para>
  <chapter eid="GEN 38" />
  <chapter number="39" style="c" sid="GEN 39" />
  <para style="s">José ga̱jma̱á a̱ꞌgui̱i̱ Potifár</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1" />Ído̱ nigóó xa̱bo̱ mbo̱ ismaelíta̱ juya̱a̱ José ná Ejípto̱, ni̱ngu̱jua̱a̱ inuu Potifár xa̱bi̱i̱ máꞌ Faraón, tsí naꞌthán-ñájúún mbo̱ ku̱ra̱tuun ajua̱nꞌ, tsí nu̱ña̱wa̱án máꞌ. <verse eid="GEN 39:1" /><verse number="2" style="v" sid="GEN 39:2" />I̱ndo̱ó numuu rí Ana̱ꞌlóꞌ Mikhuíí xtáa ga̱jma̱á nindxu̱u̱ José, xúꞌkhue̱n máꞌ na̱ga̱ti̱ya̱a̱ꞌ mújúun rí naꞌnii̱ ná xtáa̱ goꞌóo ña̱ꞌñii̱ mbo̱ Ejípto̱. <verse eid="GEN 39:2" /><verse number="3" style="v" sid="GEN 39:3" />A̱ꞌkhue̱n ndiꞌyoo ña̱ꞌñii̱ rí Ana̱ꞌlóꞌ Mikhuíí xtáa ga̱jma̱á nindxu̱u̱, jamí mbá xúgíí rí naꞌnii̱, Ana̱ꞌlóꞌ Mikhuíí naꞌne rí na̱ga̱ti̱ya̱a̱ꞌ mújúun ne̱. <verse eid="GEN 39:3" /><verse number="4" style="v" sid="GEN 39:4" />Xkuaꞌnii neꞌne rí máján niyaxu̱u̱ José. Ikhaa jngó niꞌnii̱ rí ma̱nindxu̱u̱ yumbée̱ tsí phú ginii jayu, jamí xúꞌkhue̱n máꞌ niꞌnii̱ rí ikhaa gáru̱thuun mbá xúgíí ñajun ná goꞌóo̱. Ikhaa jngó nixnáxu̱u̱ mbá xúgíí rí gíꞌdoo̱. <verse eid="GEN 39:4" /><verse number="5" style="v" sid="GEN 39:5" />Asndo nákhí rí nixnáxu̱u̱ José rí maꞌthán-ñájuun goꞌóo̱ jamí mbá xúgíí rí gíꞌdoo̱, Ana̱ꞌlóꞌ Mikhuíí naꞌne tsakun-rámuu goꞌóo mbo̱ Ejípto̱ ga̱jma̱á numuu José. Xúꞌkhue̱n máꞌ Ana̱ꞌlóꞌ Mikhuíí neꞌne tsakun-rámuu mbá xúgíí rí gíꞌdoo̱, ná goꞌóo̱, xúꞌkhue̱n máꞌ ná mbaa gidu. <verse eid="GEN 39:5" /><verse number="6" style="v" sid="GEN 39:6" />Ikhaa jngó Potifár niniñuu mbá xúgíí rí gíꞌdoo̱ ná ñawúun José, jamí tsíꞌthán a̱kui̱i̱n nimbá rí nixnáxu̱u̱, i̱ndo̱ó máꞌ rí mi̱khui̱i̱ iꞌthán a̱kui̱i̱n.</para>
  <para style="p" vid="GEN 39:6">Xómáꞌ José ja rá, tsiꞌyá jamí gúkú wáa giaxu̱u̱. <verse eid="GEN 39:6" /><verse number="7" style="v" sid="GEN 39:7" />Nda̱wa̱á wáa a̱ꞌkhue̱n a̱ꞌgui̱i̱ ña̱ꞌñii̱ ni̱ka̱ iduu inuu José, jamí niꞌthúu̱n xáꞌnii:</para>
  <para style="p" vid="GEN 39:7">―Athabáaꞌ ga̱jma̱á-ni̱ndxu̱ꞌ.<verse eid="GEN 39:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 39:8" />Xómáꞌ ikhaa̱ ra̱khóo̱, jamí niꞌthúu̱n:</para>
  <para style="p" vid="GEN 39:8">―Nathayáá máꞌ rí ña̱ꞌñiꞌ tsíꞌthán a̱kui̱i̱n mbá jayuu eꞌne rí ríga̱ ná goꞌóo̱, numuu rí ikhaa̱ niniñuu̱ ná ñawúnꞌ mbá xúgíí rí gíꞌdoo̱. <verse eid="GEN 39:8" /><verse number="9" style="v" sid="GEN 39:9" />Ndawa̱a̱ i̱mba̱a̱ tsí gíꞌdoo numuu xóo rí ikhúúnꞌ ná guꞌwá ríge̱ꞌ. Ña̱ꞌñiꞌ tárekho̱ꞌ asndo nimbá rí ma̱xúgúgua̱, i̱ndo̱ó máꞌ ikháán, numuu rí a̱ꞌgui̱i̱ ñajuaanꞌ. Xáne-lá gáne̱ ikhúúnꞌ rí ma̱xu̱ꞌdá-mina̱ꞌ mba̱a̱ rí ra̱máján rá, xúꞌkhue̱n máꞌ ma̱xu̱ꞌdá-mina̱ꞌ aꞌkhán inuu Ana̱ꞌlóꞌ rá.<verse eid="GEN 39:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 39:10" />Xómáꞌ a̱ꞌgo̱ mbámbá mbiꞌi naꞌthúun José, jamí ikhaa̱ tséꞌne-di̱i̱ rí ma̱bo̱o̱ꞌ ga̱jmáa̱, ni máꞌ rí ma̱xtáa̱ mijngi ga̱jmáa̱. <verse eid="GEN 39:10" /><verse number="11" style="v" sid="GEN 39:11" />Mbá mbiꞌi, ni̱to̱ꞌo̱o̱ José awúun guꞌwá rí ma̱ꞌnii̱ ñajun rí naꞌnii̱ jayuu̱, jamí ndawi̱i̱n nimbíin xa̱bo̱ tsí nuñajun ikhín. <verse eid="GEN 39:11" /><verse number="12" style="v" sid="GEN 39:12" />A̱ꞌkhue̱n rí a̱ꞌgo̱ niguatuun xtíñuu̱ jamí niꞌthúu̱n: «Athabáaꞌ ga̱jma̱á nindxu̱ꞌ re̱». A̱ꞌkhue̱n ikhaa̱ nigájnuu̱-ragáyuu̱, i̱ndo̱ó xtíñuu niwanúu ná ñawúun a̱ꞌgo̱.<verse eid="GEN 39:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 39:13" />Ído̱ ndiꞌyoo a̱ꞌgo̱ rí niwanúu xtíñuu José ná ñawúu̱n jamí xúꞌkhue̱n máꞌ nigáyuu̱ rixa̱á, <verse eid="GEN 39:13" /><verse number="14" style="v" sid="GEN 39:14" />a̱ꞌkhue̱n nindxaꞌúu̱n tsí nuñajun ná guꞌwáá jamí niꞌthúu̱n: «Gu̱ya̱álaꞌ rí mbo̱ ebréo̱ tsí ni̱ꞌkha̱ jayáa a̱jmbeꞌ nandoo gáꞌne tsi̱ndiáánlóꞌ. Ni̱to̱ꞌo̱o̱ rí ma̱bo̱o̱ꞌ ga̱jma̱á nindxu̱ꞌ, i̱ndo̱ó ikhúúnꞌ ni̱ndxa̱ꞌwa̱-ská gakhe̱. <verse eid="GEN 39:14" /><verse number="15" style="v" sid="GEN 39:15" />Jamí ído̱ ndiꞌyoo̱ rí ikhúúnꞌ na̱ndxa̱ꞌwa̱-ská, asndo niniña-támee̱ xtíñuu̱ ge̱e̱, jamí nigájnuu̱-ragáyuu̱».<verse eid="GEN 39:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 39:16" />Xómáꞌ ikhaa̱ niyáxi̱i̱ xtíñuu José asndo ni̱ga̱núu̱ xa̱bo̱ nikhi̱i̱ guꞌwáá. <verse eid="GEN 39:16" /><verse number="17" style="v" sid="GEN 39:17" />A̱ꞌkhue̱n rí a̱ꞌgo̱ niꞌthúu̱n ikhaa máꞌ ajngáa a̱jmbaa̱: «Yumbáá mbo̱ ebréo̱ tsí nidxa̱ꞌ ꞌcháa, ni̱ꞌkha̱ gáréye̱e̱ꞌ gamaku̱ꞌ. <verse eid="GEN 39:17" /><verse number="18" style="v" sid="GEN 39:18" />Jamí ído̱ ikhúúnꞌ ni̱ndxa̱ꞌwa̱-ská, xómáꞌ ikhaa̱ asndo niniña-támee̱ xtíñuu̱ ge̱e̱, jamí nigáyuu̱ rixa̱á».<verse eid="GEN 39:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 39:19" />Ído̱ nidxawuun xa̱bo̱ nikhi̱i̱ rí xóo ni̱gu̱máá a̱ꞌgui̱i̱ neꞌne José, a̱ꞌkhue̱n rí phú nijiꞌnáa̱. <verse eid="GEN 39:19" /><verse number="20" style="v" sid="GEN 39:20" />A̱ꞌkhue̱n rí ña̱ꞌñii José niꞌthán rí ma̱ꞌgee̱ guéjua̱nꞌ, ná katiin máꞌ xa̱bo̱ tsí naxúdiin thúngaa mba̱a̱, jamí ikhín máꞌ ni̱gi̱de̱e̱ꞌ. <figure style="fig" alt="Meten a José en la prisión" file="CO00718B.TIF" size="span" ref="39.20">Na̱ka̱ guéjua̱nꞌ José eꞌne ña̱ꞌñii.</figure> <verse eid="GEN 39:20" /><verse number="21" style="v" sid="GEN 39:21" />Xómáꞌ Ana̱ꞌlóꞌ Mikhuíí xtáa ga̱jma̱á nindxu̱u̱ José, xúꞌkhue̱n máꞌ nañáwíin a̱kui̱i̱n jaꞌyoo̱. Ikhaa jngó niꞌnii̱ rí xa̱bo̱ tsí na̱ña̱wu̱u̱n guéjua̱nꞌ máján gáyaxu̱u̱ José. <verse eid="GEN 39:21" /><verse number="22" style="v" sid="GEN 39:22" />Jamí ikhaa xa̱bo̱ tsúꞌkhue̱n niꞌgíi José rí mbayá-ngawiin mbá xúgíin xa̱bo̱ tsí gatiin ná guéjua̱nꞌ rúꞌkhue̱n. Ikhaa̱ máꞌ iyaxu̱u̱ mbá xúgíí ñajun rí na̱gu̱ma ikhín. <verse eid="GEN 39:22" /><verse number="23" style="v" sid="GEN 39:23" />Jamí tséꞌyóo máꞌ rí mbayá-ngawii̱ asndo nimbá máꞌ rí nixnáxu̱u̱ ñawúun José. Numuu rí Ana̱ꞌlóꞌ Mikhuíí xtáa ga̱jma̱á nindxu̱u̱, xúꞌkhue̱n máꞌ mbá xúgíí rí naꞌnii̱, Ana̱ꞌlóꞌ Mikhuíí naꞌne rí nagájnuu mújúun ne̱.<verse eid="GEN 39:23" /></para>
  <chapter eid="GEN 39" />
  <chapter number="40" style="c" sid="GEN 40" />
  <para style="s">José naꞌthán-wíi̱ a̱jma̱ xnuꞌndaa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1" />Nda̱wa̱á rí ninújngoo máꞌ rúꞌkhue̱n, xa̱bi̱i̱ thúngaa mba̱a̱ mbo̱ Ejípto̱, mbo̱ máꞌ naxíña̱ꞌ rí naꞌña̱a̱, jamí mangaa xa̱bo̱ tsí naꞌne-mújúun ganitsu, nini̱i̱ rí táni̱gu̱u̱ꞌ xa̱bo̱ nikhi̱i̱, thúngaa mba̱a̱. <verse eid="GEN 40:1" /><verse number="2" style="v" sid="GEN 40:2" />A̱ꞌkhue̱n rí nijiꞌnáa Faraón<note caller="+" style="f"><char style="fr" closed="false">40.2 </char><char style="ft" closed="false">«Faraón» nuxnáá mbiꞌyuu thúngaa mba̱a̱ ná Ejípto̱.</char></note> jaꞌñúú ná-a̱jmi̱i̱ xa̱bo̱ ede̱ tsíge̱ꞌ, tsí naꞌthán-ñájúún mbo̱ nu̱xi̱ña̱ꞌ rí naꞌña̱a̱ ga̱jma̱á xa̱bo̱ tsí naꞌthán-ñájúún mbo̱ none̱ mújúún guma wopho. <verse eid="GEN 40:2" /><verse number="3" style="v" sid="GEN 40:3" />Jamí niskuádi̱i̱nꞌ guéjua̱nꞌ ná goꞌóo máꞌ xa̱bo̱ tsí naꞌthán-ñájúún mbo̱ nu̱ña̱wa̱án, ná guéjua̱nꞌ rí kra̱ꞌaa máꞌ José. <verse eid="GEN 40:3" /><verse number="4" style="v" sid="GEN 40:4" />Xómáꞌ xa̱bo̱ tsí naꞌthán-ñájúún mbo̱ nu̱ña̱wa̱án máꞌ, niniñúu̱ xa̱bo̱ tsíge̱ꞌ ñawúun José, jamí ikhaa̱ ndaya-ngawii̱n. Xúꞌkhue̱n máꞌ mba̱a̱ mbiꞌi nijúwe̱e̱ꞌ ná guéjua̱nꞌ.<verse eid="GEN 40:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 40:5" />Mbá mbroꞌon ná-a̱jmi̱i̱ xa̱bo̱, mbo̱ naxíña̱ꞌ rí naꞌña̱a̱ thúngaa Ejípto̱ ga̱jma̱á mbo̱ naꞌne-mújúun guma wopho, ni̱nu̱ꞌndaa̱ mbámbíi̱n ná katii̱n guéjua̱nꞌ, xúꞌkhue̱n máꞌ mbámbá xóo rí naꞌthán xnuꞌndúu̱n. <verse eid="GEN 40:5" /><verse number="6" style="v" sid="GEN 40:6" />A̱ꞌkhue̱n rí José ni̱ka̱ gáꞌñúu̱ rí i̱mba̱ mbiꞌi, jamí ndiꞌñúu̱ rí phú jíná a̱kuíi̱n. <verse eid="GEN 40:6" /><verse number="7" style="v" sid="GEN 40:7" />A̱ꞌkhue̱n ikhaa̱ niraxúu̱n xa̱bi̱i̱ Faraón, mbo̱ tsí xtáa̱ máꞌ gajmíi̱ ná guéjua̱nꞌ ná goꞌóo máꞌ xa̱bo̱ nikhi̱i̱:</para>
  <para style="p" vid="GEN 40:7">―Déjngó rí xúge̱ꞌ phú jíná guéño inalaꞌ róꞌ.<verse eid="GEN 40:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 40:8" />Xómáꞌ ikhii̱n nitháa̱n:</para>
  <para style="p" vid="GEN 40:8">―Ríga̱ rí ni̱nu̱ꞌndaaxo̱ꞌ, jamí ndawa̱a̱ tsí maꞌthán-wíi̱ ne̱ rá.</para>
  <para style="p" vid="GEN 40:8">A̱ꞌkhue̱n rí José niꞌthúu̱n:</para>
  <para style="p" vid="GEN 40:8">―Á ra̱ꞌkháa máꞌ Ana̱ꞌlóꞌ ñajuun tsí maꞌthán-wíi̱ ne̱ rá dxe̱ꞌ. A̱gu̱thu̱nꞌlaꞌ ne̱ xúge̱ꞌ mba̱yo̱.<verse eid="GEN 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 40:9" />A̱ꞌkhue̱n rí xa̱bo̱ mbo̱ naꞌthán-ñájúún tsí nu̱xi̱ña̱ꞌ iya niꞌthúun José xnuꞌnduu: <figure style="fig" alt="Un prisionero le cuenta su sueño a Jose" file="CO00725B.TIF" size="span" copy="Está bien mover a: 40.16, si cabe mejor" ref="40.9">Mbáa xa̱bo̱ naꞌthúun José rí nigundaa ná guéjua̱nꞌ.</figure></para>
  <para style="p" vid="GEN 40:9">―Ikhúúnꞌ ni̱gúndaa rí nda̱yo̱o̱ mbá ajmu̱u̱ xndú úba̱, wéje̱ ne̱ ná inu̱ꞌ, <verse eid="GEN 40:9" /><verse number="10" style="v" sid="GEN 40:10" />jamí ríga̱ mbá atsú ñawúun ne̱. Ído̱ rí narudu-ráma̱a̱ꞌ ne̱, naxná ri̱ꞌyu̱u̱ ne̱, jamí na̱ka̱-raꞌgo̱o̱ juáyúu xndú úba̱. <verse eid="GEN 40:10" /><verse number="11" style="v" sid="GEN 40:11" />Xómáꞌ ikhúúnꞌ gída̱ꞌ ñawúnꞌ xu̱wá-ndiyuu Faraón, jamí na̱gruígú xndú úba̱ xúꞌkhue̱n máꞌ na̱duun ne̱ ná xu̱wá-ndiyuu̱. A̱ꞌkhue̱n rí na̱xna̱a̱ ne̱ naꞌña̱a̱ ndi̱yo̱o̱.<verse eid="GEN 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 40:12" />A̱ꞌkhue̱n José niꞌthúu̱n:</para>
  <para style="p" vid="GEN 40:12">―Ríge̱ꞌ ñajuun rí naꞌthán xnuꞌndaaꞌ: rí atsú ñawúun ajma̱a̱ ñajuun atsú mbiꞌi. <verse eid="GEN 40:12" /><verse number="13" style="v" sid="GEN 40:13" />Ído̱ rí ma̱ꞌne atsú mbiꞌi maꞌthán Faraón numaaꞌ, jamí maꞌgíi̱nꞌ máꞌ ñajun rí nathane̱, xúꞌkhue̱n máꞌ ma̱ra̱xna̱a xu̱wá-ndiyuu Faraón ná ñawúun, xómáꞌ nathane̱ jayu nákhí rí naraxná rí naꞌña̱a̱. <verse eid="GEN 40:13" /><verse number="14" style="v" sid="GEN 40:14" />A̱ga̱rmáꞌáa̱n-lá a̱kia̱a̱nꞌ ga̱jma̱á nindxu̱ꞌ ído̱ gátánga̱án ma̱ra̱xtaa májáanꞌ mbu̱jú, jamí na̱tha̱n-jáñaaꞌ rí ma̱ñáwíin a̱kia̱a̱nꞌ xtayo̱ꞌ. Arathán tháan numu̱ꞌ inuu Faraón, rí maríñúu̱nꞌ awúun guéjua̱nꞌ ríge̱ꞌ. <verse eid="GEN 40:14" /><verse number="15" style="v" sid="GEN 40:15" />Numuu rí ni̱gu̱ma-kúwu̱ún ná mbañúú mbo̱ ebréo̱, xúꞌkhue̱n máꞌ nimbá nda̱a̱ rí ne̱ne̱ ge̱jioꞌ, xí ma̱gúda̱ꞌlo̱ꞌ guéjua̱nꞌ.<verse eid="GEN 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 40:16" />Ído̱ ndiꞌyoo xa̱bo̱ tsí naꞌthán-ñájúún mbo̱ none̱ mújúún guma wopho rí máján niꞌthán-wíi̱ José, a̱ꞌkhue̱n niꞌthúu̱n mangaa̱:</para>
  <para style="p" vid="GEN 40:16">―Ikhúúnꞌ mangúún ni̱gúndaa rí nda̱yo̱o̱ atsú ixtuu guma wopho rí miꞌxá tráma ná idxu̱ꞌ. <verse eid="GEN 40:16" /><verse number="17" style="v" sid="GEN 40:17" />Ixtu rí rígu inúú gati mbaꞌa inii guma wopho rí thawuun rí me̱kho̱ Faraón. I̱ndo̱ó ndi̱yo̱o̱ rí ño̱ꞌo̱n naꞌpho̱ rí gati ná ixtu rí rígu ná idxu̱ꞌ.<verse eid="GEN 40:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 40:18" />A̱ꞌkhue̱n niriꞌña̱a̱ José:</para>
  <para style="p" vid="GEN 40:18">―Ríge̱ꞌ ñajuun rí naꞌthán xnuꞌndaaꞌ: rí atsú ixtu, ikhaa ñajuun atsú mbiꞌi. <verse eid="GEN 40:18" /><verse number="19" style="v" sid="GEN 40:19" />Ído̱ rí ma̱ꞌne atsú mbiꞌi Faraón marígú idxa̱a̱ꞌ, jamí ma̱ꞌnii̱ rí ma̱bra̱káán ná ixe̱, xúꞌkhue̱n máꞌ mo̱pho̱ ño̱ꞌo̱n xuyaaꞌ.<verse eid="GEN 40:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 40:20" />Ído̱ ni̱ga̱nú mbiꞌi riatsú niráma̱a̱ꞌ tsiguu Faraón, jamí niꞌnii̱ mbá ndxa̱a̱ inúú mbá xúgíin xa̱bi̱i̱. A̱ꞌkhue̱n rí inúú máꞌ xa̱bi̱i̱, niríya̱a̱ꞌ ná guéjua̱nꞌ xa̱bo̱ tsí naꞌthán-ñájúún mbo̱ nu̱xi̱ña̱ꞌ iya, ga̱jma̱á máꞌ xa̱bo̱ tsí naꞌthán-ñájúún mbo̱ none̱ guma wopho. <verse eid="GEN 40:20" /><verse number="21" style="v" sid="GEN 40:21" />Xúꞌkhue̱n máꞌ niꞌnii̱ rí ma̱tanga̱a̱ ná ñajun drígo̱o̱ xa̱bo̱ tsí naꞌthán-ñájúún mbo̱ nu̱xi̱ña̱ꞌ iya, jamí ikhaa̱ maxnáa̱ la xu̱wá-ndiyuu Faraón ná ñawúun rí ma̱ga̱a̱n. <verse eid="GEN 40:21" /><verse number="22" style="v" sid="GEN 40:22" />I̱ndo̱ó xa̱bo̱ tsí naꞌthán-ñájúún mbo̱ none̱ mújúún guma wopho wandráka-maa̱, mbá xóo niꞌthán-wíi̱ xnuꞌndaa José. <verse eid="GEN 40:22" /><verse number="23" style="v" sid="GEN 40:23" />Xómáꞌ xa̱bo̱ tsí naꞌthán-ñájúún mbo̱ nu̱xi̱ña̱ꞌ iya ná-tármáꞌáa̱n a̱kui̱i̱n jaꞌyoo̱ José, rí nimbumuu̱ mbá jayu.<verse eid="GEN 40:23" /></para>
  <chapter eid="GEN 40" />
  <chapter number="41" style="c" sid="GEN 41" />
  <para style="s">Rí nigundaa Faraón</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1" />Ído̱ rí ninújngoo máꞌ a̱jma̱ tsigu, a̱ꞌkhue̱n nigundaa Faraón. Ndiꞌyoo̱ rí wíji̱i̱ ná rawuun mañuu Nílo̱. <verse eid="GEN 41:1" /><verse number="2" style="v" sid="GEN 41:2" />Xúꞌkhue̱n máꞌ ndiꞌyoo̱ rí ná rawuun mañuu natsimúú mbá juiin xede̱ iꞌgú tsí phú tsiꞌíin, xúꞌkhue̱n máꞌ phú rangíin, jamí napiꞌtsii̱ ná maxa ra̱xa̱. <verse eid="GEN 41:2" /><verse number="3" style="v" sid="GEN 41:3" />Jamí ná tsu̱dúún máꞌ xede̱ tsúꞌkhue̱n nitsimúú i̱mba̱á juiin xede̱ iꞌgú tsí phú xkawi̱i̱nꞌ jamí tsa̱jui̱i̱nꞌ, xúꞌkhue̱n máꞌ niwájuii̱n ná inúú xede̱ tsí tsiꞌíin tsí kachúún ná rawuun mañuu. <verse eid="GEN 41:3" /><verse number="4" style="v" sid="GEN 41:4" />A̱ꞌkhue̱n rí xede̱ tsí xkawi̱i̱nꞌ tsa̱jui̱i̱nꞌ niꞌphu̱ún xede̱ tsí mbá juiin tsí tsiꞌíin jamí rangíin ndiꞌyoo̱. A̱ꞌkhue̱n nifuii̱ꞌ Faraón.<verse eid="GEN 41:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 41:5" />Niꞌgu̱u̱ mbu̱jú, jamí nigundaa̱ rí riajmu̱u̱. Ndiꞌyoo̱ mbá juan iñuu ixí ra̱xa̱ mba̱ꞌo̱ jamí phú mitsaan ne̱, rí nangujuíi mbóó máꞌ ná diyuu ne̱. <verse eid="GEN 41:5" /><verse number="6" style="v" sid="GEN 41:6" />Jamí nda̱wa̱á a̱ꞌkhue̱n ni̱díwíi i̱mba̱á juan iña rí ngíná nijndoo xtá neꞌne gíñá-xoo. <verse eid="GEN 41:6" /><verse number="7" style="v" sid="GEN 41:7" />Xúꞌkhue̱n máꞌ rí mbá juan iña rí ngíná niꞌkho̱ mbá juan iña rí máján mba̱ꞌo̱. A̱ꞌkhue̱n nifuii̱ꞌ Faraón, ndiꞌyoo̱ rí xnuꞌndaa ñajuun ne̱.<verse eid="GEN 41:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 41:8" />Ído̱ rí watse rá, phú naꞌthúun a̱kui̱i̱n nifuii̱ꞌ, a̱ꞌkhue̱n nindxaꞌúu̱n mbá xúgíin xa̱bo̱ tsí na̱ma̱ñúú xawan tsí júwá ná Ejípto̱, jamí mbá xúgíin máꞌ xa̱bo̱ tsí nduyáá. A̱ꞌkhue̱n niꞌthúu̱n rí nigundaa̱, i̱ndo̱ó numuu rí nimbáa tséꞌngo̱o̱ rí maꞌthán-wíi̱ ne̱ inuu Faraón.<verse eid="GEN 41:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 41:9" />A̱ꞌkhue̱n rí xa̱bo̱ tsí naꞌthán-ñájúún mbo̱ nu̱xi̱ña̱ꞌ iya niꞌthúun Faraón: «Na̱rmáꞌáa̱n a̱kui̱nꞌ xúge̱ꞌ rí ra̱máján ne̱ne̱lo̱ꞌ. <verse eid="GEN 41:9" /><verse number="10" style="v" sid="GEN 41:10" />Ído̱ nijiꞌnáá xtayaxo̱ꞌ tsáa̱nꞌ yumbiáaꞌ ñajuanxo̱ꞌ, nitaskuádáa̱nꞌxo̱ꞌ guéjua̱nꞌ ná goꞌóo máꞌ xa̱bo̱ tsí naꞌthán-ñájúún mbo̱ nu̱ña̱wa̱án, ikhúúnꞌ ga̱jme̱ꞌ xa̱bo̱ tsí naꞌthán-ñájúún mbo̱ none̱ mújúún guma wopho. <verse eid="GEN 41:10" /><verse number="11" style="v" sid="GEN 41:11" />Ikhaa̱ jamí ikhúúnꞌ ni̱nu̱ꞌndaaxo̱ꞌ mbóó mbroꞌon. Jamí mbámbá xóo rí naꞌthán xnuꞌndaxo̱ꞌ. <verse eid="GEN 41:11" /><verse number="12" style="v" sid="GEN 41:12" />Ikhín gída̱ꞌ mbáa dxáma mbo̱ ebréo̱ ga̱jma̱á nindxa̱ꞌxo̱ꞌ, yumbée máꞌ xa̱bo̱ tsí naꞌthán-ñájúún mbo̱ nu̱ña̱wa̱án máꞌ. Jamí ni̱tháa̱nxo̱ꞌ xnuꞌndaxo̱ꞌ, xúꞌkhue̱n máꞌ ikhaa̱ niꞌthán-wíi̱ ne̱, mbámbá xó rí ni̱nu̱ꞌndaaxo̱ꞌ. <verse eid="GEN 41:12" /><verse number="13" style="v" sid="GEN 41:13" />Xómáꞌ rí niꞌthán-wíi̱ ne̱ ikhaa̱, xkuaꞌnii máꞌ neꞌne. Ikhúúnꞌ nitangu̱ún ni̱ni̱i̱ máꞌ ñaju̱nꞌ, xómáꞌ tsí i̱mba̱a̱ wandráka-maa̱ ja».<verse eid="GEN 41:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 41:14" />A̱ꞌkhue̱n rí Faraón nixná-ñájun rí ma̱ꞌkha̱ José, jamí mbá nacha̱ máꞌ ni̱ri̱ya̱a̱ꞌ ná guéjua̱nꞌ. Xómáꞌ José niꞌda̱a̱ tsu̱u̱n inuu, xúꞌkhue̱n máꞌ niriꞌkhu̱u̱ la xtíñuu̱, a̱ꞌkhue̱n ni̱ꞌkhe̱e̱ inuu Faraón. <figure style="fig" alt="José ante el Faraón" file="co00727b.TIF" size="span" ref="41.14">Na̱ga̱nú José inuu thúngaa mba̱a̱ ná Ejípto̱.</figure> <verse eid="GEN 41:14" /><verse number="15" style="v" sid="GEN 41:15" />A̱ꞌkhue̱n Faraón niꞌthúun José:</para>
  <para style="p" vid="GEN 41:15">―Ikhúúnꞌ ni̱gúndaa, jamí ndawa̱a̱ nimbáa tsí maꞌthán-wíi̱ wáa ne̱. I̱ndo̱ó na̱dxawuun ga̱jma̱á numaaꞌ ikháán, rí natadxawíín xnuꞌndaa jamí xúꞌkhue̱n máꞌ na̱ma̱ñaaꞌ narathán-wíi̱ ne̱.<verse eid="GEN 41:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 41:16" />A̱ꞌkhue̱n niriꞌña̱a̱ José ajngóo Faraón:</para>
  <para style="p" vid="GEN 41:16">―Ra̱jáꞌyo̱ꞌ ikhúúnꞌ ma̱tha̱a̱nꞌlo̱ꞌ, rí Ana̱ꞌlóꞌ ñajuun tsí phú maꞌthán-wíi̱ mújúun inuu Faraón.<verse eid="GEN 41:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 41:17" />A̱ꞌkhue̱n rí Faraón niꞌthúun José:</para>
  <para style="p" vid="GEN 41:17">―Ni̱gúndaa ndi̱yo̱o̱ rí ná rawuun mañuu Nílo̱ kuájo̱n. <verse eid="GEN 41:17" /><verse number="18" style="v" sid="GEN 41:18" />Jamí ná rawuun mañuu natsimúú mbá juiin xede̱ iꞌgú rangíin jamí phú tsiꞌíin, xúꞌkhue̱n máꞌ napiꞌtsii̱ ná maxa ra̱xa̱. <verse eid="GEN 41:18" /><verse number="19" style="v" sid="GEN 41:19" />Jamí ná rí tsu̱dúún máꞌ xede̱ tsúꞌkhue̱n nitsimúú i̱mba̱á juiin xede̱ tsí phú tsa̱jui̱i̱nꞌ jamí phú xkawe̱ꞌ jaꞌñúú. Ra̱ꞌkhá-tháán mingíníi̱, rí asndo nimbá miꞌtsún táñu̱ú xede̱ tsí phú xkawi̱i̱nꞌ xóo tsúꞌkhue̱n mbá xúgíí mbaa ná Ejípto̱. <verse eid="GEN 41:19" /><verse number="20" style="v" sid="GEN 41:20" />Xómáꞌ xede̱ tsí tsa̱jui̱i̱nꞌ jamí xkawi̱i̱nꞌ niꞌphu̱ún tsí mbá juiin xede̱ tsí rangíin. <verse eid="GEN 41:20" /><verse number="21" style="v" sid="GEN 41:21" />Nda̱wa̱á ído̱ rí wámba̱ niꞌphúu̱n, na̱nguá-lá nikujmii̱ mbá jayu xí niꞌphúu̱n, ikhaa máꞌ jaꞌñúu̱ rí tsa̱jui̱i̱nꞌ xómáꞌ rí wapha. A̱ꞌkhue̱n rí nifuii̱ꞌlo̱ꞌ.<verse eid="GEN 41:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 41:22" />»Jamí mangaa ndi̱yo̱o̱ rí na̱gúndaa i̱mba̱, mbá juan iñuu ixí ra̱xa̱ mba̱ꞌo̱ jamí phú mitsaan ne̱ rí nangujuíi mbóó máꞌ diyuu ne̱. <verse eid="GEN 41:22" /><verse number="23" style="v" sid="GEN 41:23" />Nda̱wa̱á nijráꞌán i̱mba̱á juan iña ngíná nijndoo xtá neꞌne gíñá-xoo. <verse eid="GEN 41:23" /><verse number="24" style="v" sid="GEN 41:24" />Iña rí ngíná a̱ꞌkhue̱n niꞌpho̱ rí mbá juan iña rí mitsaan. Xómáꞌ ikhúúnꞌ ni̱thu̱ún xúgíí rúꞌkhue̱n xa̱bo̱ tsí nduyáá xawan, jamí nimbáa tséꞌngo̱o̱ maꞌthán-wíi̱ ne̱ inu̱ꞌ.<verse eid="GEN 41:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 41:25" />A̱ꞌkhue̱n rí José niriꞌña̱a̱ ajngóo Faraón:</para>
  <para style="p" vid="GEN 41:25">―Xnuꞌnduu Faraón mbóó máꞌ ñajuun ne̱. Ana̱ꞌlóꞌ nasngájma rí wéje̱ ma̱ꞌne. <verse eid="GEN 41:25" /><verse number="26" style="v" sid="GEN 41:26" />Tsí mbá juiin xede̱ tsí tsiꞌíin, juan tsigu ñajuun ne̱, xúꞌkhue̱n máꞌ rí mbá juan iña rí mitsaan, juan tsigu ñajuun ne̱. Mbóó máꞌ ñajuun rí naꞌthán xnuꞌndaa. <verse eid="GEN 41:26" /><verse number="27" style="v" sid="GEN 41:27" />Xúꞌkhue̱n máꞌ tsí mbá juiin xede̱ tsí tsa̱jui̱i̱nꞌ jamí xkawi̱i̱nꞌ tsí nitsimúú nda̱wa̱á, juan tsigu ñajuun ne̱. Xúꞌkhue̱n máꞌ rí mbá juan iña ngíná rí nijndoo xtá neꞌne gíñá-xoo, ikhaa máꞌ ñajuun mbá juan tsigu rí ma̱ri̱gá ewe. <verse eid="GEN 41:27" /><verse number="28" style="v" sid="GEN 41:28" />Rúꞌkhue̱n ñajuun rí na̱tha̱a̱nꞌ, xa̱bo̱ nikhi̱i̱. Rí Ana̱ꞌlóꞌ wéje̱ ma̱ꞌne, ikhaa ñajuun rí nasngájmaa̱ꞌ. <verse eid="GEN 41:28" /><verse number="29" style="v" sid="GEN 41:29" />Ma̱ꞌkha mbá juan tsigu rí ma̱jma̱a̱ guéño ganitsu mbá xúgíí mbaa ná Ejípto̱. <verse eid="GEN 41:29" /><verse number="30" style="v" sid="GEN 41:30" />Nda̱wa̱á a̱ꞌkhue̱n ma̱ꞌkha̱ mbá juan tsigu rí ma̱ꞌne ewe, jamí ma̱mbumúú mbá xúgíí xa̱bo̱ rí nijma̱a̱ guéño ná mbaa Ejípto̱, jamí ewe ma̱ꞌne gámba̱a̱ xuajen. <verse eid="GEN 41:30" /><verse number="31" style="v" sid="GEN 41:31" />Jamí rí nijma̱a̱ guéño ná-xármáꞌáa̱n a̱kuíi̱n juyáa̱, ga̱jma̱á numuu ewe rí ma̱ꞌkha̱, rí phú gakhe̱ gáꞌne. <verse eid="GEN 41:31" /><verse number="32" style="v" sid="GEN 41:32" />Rí a̱jma̱ nothon rí nitanuꞌndaa, xa̱bo̱ nikhi̱i̱, rúꞌkhue̱n naꞌthán rí Ana̱ꞌlóꞌ naꞌgí-mina̱ꞌ rí ma̱ꞌne-mbánuu, jamí phú wapha naꞌgí-mine̱e̱ꞌ rí ma̱ꞌne-mbánuu̱ ne̱.<verse eid="GEN 41:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 41:33" />»Ikhaa jngó xúge̱ꞌ rá, máján xí ma̱tha̱ꞌyáa mbáa xa̱biya̱ tsí wiphii jamí nafroꞌo̱o̱, xúꞌkhue̱n máꞌ ma̱thaꞌgíi̱ꞌ rí maꞌthán-nájuu̱n mbaa Ejípto̱. <verse eid="GEN 41:33" /><verse number="34" style="v" sid="GEN 41:34" />Athane̱ ríge̱ꞌ, xa̱bo̱ nikhi̱i̱: ataskuíji̱i̱n xa̱bo̱ ñajun inuu xuajen tsí ma̱tsu̱daa rí ma̱gi̱xi̱i̱ mbóó awúun rí mbámbá witsu rí ma̱jma̱a̱ inuu mbayuu Ejípto̱, awúun rí mbá juan tsigu rí ma̱jma̱a̱ guéño. <verse eid="GEN 41:34" /><verse number="35" style="v" sid="GEN 41:35" />Jamí a̱gi̱mbóo̱ mbá xúgíí rí ma̱jma̱a̱ mbá jañii tsigui̱i̱ rí máján na̱ꞌkha̱ ge̱e̱. A̱gi̱xi̱i̱ ixí iña ná ñawáanꞌ máꞌ rí mambáñúú-múú xa̱bo̱ xuajen. <verse eid="GEN 41:35" /><verse number="36" style="v" sid="GEN 41:36" />Ikhaa jngó ma̱ti mújúun ganitsu rúꞌkhue̱n ná xtagaꞌo, rí mambáñúú xa̱bo̱ xuajen ído̱ rí ma̱ꞌne ewe mbá juan tsigu ná mbaa Ejípto̱. A̱ꞌkhue̱n rí ma̱xájáñúú xa̱bo̱ rí ma̱khéñúú.<verse eid="GEN 41:36" /></para>
  <para style="s">José naꞌthán-ñájun ná Ejípto̱</para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37" />A̱ꞌkhue̱n rí Faraón gajmíí máꞌ xa̱bi̱i̱ ndiyáa̱ rí máján ju̱ma̱ rúꞌkhue̱n. <verse eid="GEN 41:37" /><verse number="38" style="v" sid="GEN 41:38" />A̱ꞌkhue̱n Faraón niꞌthúún xa̱bi̱i̱: «Á mu̱xkamaalóꞌ i̱mba̱a̱ xa̱bo̱ tsí xóo tsíge̱ꞌ, tsí gíꞌdoo xu̱u̱ꞌ Ana̱ꞌlóꞌ rá».<verse eid="GEN 41:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 41:39" />A̱ꞌkhue̱n Faraón niꞌthúun José: «Numuu rí Ana̱ꞌlóꞌ naꞌne rí nandoo nathiyáá xúgíí ríge̱ꞌ, ndawa̱a̱ nimbáa tsí nafroꞌo̱o̱ jamí tsí phú ju̱ma̱a̱ xóo rí ikháán. <verse eid="GEN 41:39" /><verse number="40" style="v" sid="GEN 41:40" />Ikháán ma̱ra̱tha̱n-ñájuíín guꞌwá ñajun drígo̱ꞌ, jamí mbá xúgíin xa̱bo̱ xuajiu̱nꞌ mone̱-mbáníí rí ma̱ra̱tha̱n. I̱ndo̱ó ikhúúnꞌ rí ꞌgúnꞌ ge̱e̱, i̱tha̱n ginúú xó rí ikháán. <verse eid="GEN 41:40" /><verse number="41" style="v" sid="GEN 41:41" />―Faraón niꞌthúun xóó José―: Athayáá rí xúge̱ꞌ ikhúúnꞌ na̱ꞌgíínlo̱ꞌ rí ma̱ra̱tha̱n-ñájuíín mbá xúgíí mbaa Ejípto̱».<verse eid="GEN 41:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 41:42" />A̱ꞌkhue̱n rí Faraón niríya̱ꞌ ajua̱nꞌ tsina rí gída̱ꞌ ná a̱dée ñawúu̱n, jamí nigíde̱e̱ꞌ ne̱ ná ñawúun José. Xúꞌkhue̱n máꞌ niꞌnii̱ rí majúwuu̱n xtíin rí máján waba jamí nundu, xúꞌkhue̱n máꞌ nigíwe̱e̱nꞌ mbá xábí rí ajua̱nꞌ mo̱jmo̱ꞌ ná aphuu. <verse eid="GEN 41:42" /><verse number="43" style="v" sid="GEN 41:43" />Mangaa niꞌnii̱ rí ma̱tsimuu̱ ixe̱ rí kixmáthaa nagáyuu rí drígo̱o̱ jayuu xa̱bo̱ ñajun tsí riajma̱a̱, xúꞌkhue̱n máꞌ nithan-raꞌa xa̱bo̱ ná inuu̱: «¡A̱gu̱sma̱tíga̱ꞌlaꞌ!» Xkuaꞌnii niꞌgíi̱ José rí maꞌthán-ñájun mbá xúgíí inuu mbaa Ejípto̱.<verse eid="GEN 41:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="GEN 41:44" />A̱ꞌkhue̱n Faraón niꞌthúun José: «Maske máꞌ ikhúúnꞌ ñaju̱nꞌ Faraón, nimbáa xa̱bo̱ mbá xúgíí ná Ejípto̱ ma̱xáxóo ma̱ꞌmba̱a̱n ñawúun ni máꞌ nakhúu xí tsírathán ikháán».<verse eid="GEN 41:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 41:45" />A̱ꞌkhue̱n rí Faraón niꞌthán rí Safnát-panéa̱ ma̱ꞌne mbiꞌyuu José, xúꞌkhue̱n máꞌ nixnáa̱ a̱ꞌgo̱ tsí ma̱ꞌne a̱ꞌgui̱i̱ mbiꞌyuu Asenát, tsí a̱dée máꞌ Potífe̱ra̱ mbo̱ dxakuun ná Ón. A̱ꞌkhue̱n rí nigájnuu José ni̱ka̱ mbá xúgíí mbaa Ejípto̱. <verse eid="GEN 41:45" /><verse number="46" style="v" sid="GEN 41:46" />José gíꞌdoo mbá skíñú gu̱wa̱ꞌ tsiguu̱ ído̱ rí waxnáxi̱i̱ inuu Faraón, thúngaa mba̱a̱ ná Ejípto̱. A̱ꞌkhue̱n rí José nigájnuu inuu Faraón, jamí ni̱ka̱-raꞌyoo̱ mbá xúgíí mbaa Ejípto̱.<verse eid="GEN 41:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="GEN 41:47" />Awúun rí mbá juan tsigu rúꞌkhue̱n, gatíí mi̱ndaꞌkho rí nijma̱a̱ ná inuu ju̱ba̱ꞌ. <verse eid="GEN 41:47" /><verse number="48" style="v" sid="GEN 41:48" />Xómáꞌ José ni̱ka̱-ragímbóo̱ mbá xúgíí ganitsu rí nijma̱a̱ mi̱ndaꞌkho ná Ejípto̱ awúun rí juan tsigu, jamí ni̱ka̱ ra̱gu̱xi̱i̱ ne̱ ná xuajen. Rí nijma̱a̱ ná rawuun mbámbá xuajen, ikhín máꞌ ni̱gu̱xi̱i̱. <verse eid="GEN 41:48" /><verse number="49" style="v" sid="GEN 41:49" />Nigímbóo̱ José ixí iña asndo xóo we̱ꞌe̱ rawuun iya a̱pha̱. Ra̱ꞌkhá-tháán mba̱a̱ mi̱ndaꞌkho rí nigímbóo̱, asndo ná-táꞌngo̱o̱ rí ma̱gia̱wan ne̱, numuu rí nánguá xóo rí ma̱gi̱xnuu ne̱.<verse eid="GEN 41:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 41:50" />A̱ꞌkhue̱n ni̱gu̱mii a̱jmi̱i̱ i̱ji̱i̱n José rí xóó táꞌkha̱ nimbá tsigu rí ewe. E̱je̱n tsúꞌkhue̱n neꞌne ku̱mii Asenát, tsí a̱dée máꞌ Potífe̱ra̱ dxakuun ná Ón. <verse eid="GEN 41:50" /><verse number="51" style="v" sid="GEN 41:51" />A̱ꞌkhue̱n rí José nixnúu̱ mbiꞌyuu a̱dée̱ tsí ginii, Manasés,<note caller="+" style="f"><char style="fr" closed="false">41.51 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, mbiꞌyuu Manasés naꞌthán-wíi̱ «nambumuu».</char></note> numuu rí niꞌthée̱n: «Ana̱ꞌlóꞌ neꞌne rí ma̱mbumu̱ꞌ mbá xúgíí ñaju̱nꞌ, xúꞌkhue̱n máꞌ mbá xúgíin a̱ngui̱nꞌ ná goꞌóo anu̱ꞌ». <verse eid="GEN 41:51" /><verse number="52" style="v" sid="GEN 41:52" />Xómáꞌ tsí riajma̱a̱ nixnúu̱ mbiꞌyuu Efraín,<note caller="+" style="f"><char style="fr" closed="false">41.52 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, mbiꞌyuu Efraín naꞌthán-wíi̱ «phú na̱gu̱mii e̱je̱n».</char></note> numuu rí niꞌthée̱n: «Ana̱ꞌlóꞌ neꞌne rí ma̱gu̱mii i̱ji̱nꞌ ná numbaa rí nimínu̱u̱ꞌ».<verse eid="GEN 41:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="GEN 41:53" />Xkuaꞌnii nirámuu rí mbá juan tsigu rí nijma̱a̱ mi̱ndaꞌkho ganitsu ná mbaa Ejípto̱. <verse eid="GEN 41:53" /><verse number="54" style="v" sid="GEN 41:54" />A̱ꞌkhue̱n rí ni̱gi̱ꞌdu̱u̱n ni̱ꞌkha̱ mbá juan tsigu ewe, xómáꞌ niꞌthán José. Jamí niríga̱ ewe mbá xúgíí xuajen, i̱ndo̱ó mbá xúgíí mbaa Ejípto̱ ríga̱ ganitsu. <verse eid="GEN 41:54" /><verse number="55" style="v" sid="GEN 41:55" />Jamí ído̱ nijuꞌdu-ti̱ga̱ gakhe̱ ewe mbá xúgíí mbaa Ejípto̱, a̱ꞌkhue̱n rí xuajen nindxaꞌwá-raꞌa inuu Faraón ga̱jma̱á numuu ganitsu. Xómáꞌ Faraón niꞌthúún mbá xúgíin xa̱bo̱ Ejípto̱: «Gaꞌgualaꞌ inuu José, jamí a̱go̱ne̱-mbáníílaꞌ rí maꞌthánlaꞌ ikhaa̱». <verse eid="GEN 41:55" /><verse number="56" style="v" sid="GEN 41:56" />Jamí mbá a̱pha̱ ri̱ga̱ ewe mbá xúgíí xuajen rúꞌkhue̱n. A̱ꞌkhue̱n rí José nirmbáꞌthoo mbá xúgíí xtagaꞌo ná ríga̱ ganitsu, jamí na̱ngo̱jue̱e̱ ne̱ nuda xa̱bo̱ Ejípto̱, numuu rí phú mba̱a̱ ewe i̱ꞌkha̱-raríga̱ ná numbaa rúꞌkhue̱n. <verse eid="GEN 41:56" /><verse number="57" style="v" sid="GEN 41:57" />Jamí mbá xúgíí numba̱a̱ naguwá xa̱bo̱ ná Ejípto̱ rí mutsi̱i̱ inuu José, numuu rí mbá xúgíí numba̱a̱ phú mba̱a̱ ewe i̱ꞌkha̱-raríga̱.<verse eid="GEN 41:57" /></para>
  <chapter eid="GEN 41" />
  <chapter number="42" style="c" sid="GEN 42" />
  <para style="s">Nagóó a̱ngui̱i̱n José ná Ejípto̱</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1" />Xómáꞌ Jakób nidxawuun rí ná Ejípto̱ ríga̱ ganitsu, a̱ꞌkhue̱n iꞌthúu̱n i̱ji̱i̱n: «Náá rí e̱ne̱laꞌ rí i̱ndo̱ó nu̱ya̱xe̱-míjnálaꞌ kuajúnlaꞌ róꞌ. <verse eid="GEN 42:1" /><verse number="2" style="v" sid="GEN 42:2" />Ni̱dxawuunlo̱ꞌ rí ná Ejípto̱ ríga̱ ganitsu. Aꞌgualaꞌ ñúꞌún, jamí a̱go̱tse̱laꞌ ikhín rí ma̱goo ma̱juwalóꞌ ga̱jma̱á, jngó ma̱xájáñalóꞌ».<verse eid="GEN 42:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 42:3" />A̱ꞌkhue̱n rí nigóó mbá gu̱wi̱inꞌ dxíyo̱o̱ José ná Ejípto̱ gágótse̱ ixí iña. <verse eid="GEN 42:3" /><verse number="4" style="v" sid="GEN 42:4" />Xómáꞌ Jakób táxuꞌmaa̱ Benjamín, mbo̱ ge̱ꞌthe̱e̱ máꞌ José, ma̱ꞌga gajmíí a̱ngui̱i̱n, numuu rí niꞌthée̱n: «Ra̱ꞌkhá ma̱gíꞌnuu̱ mbá gamíjun».<verse eid="GEN 42:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 42:5" />Xkuaꞌnii nigóó i̱ji̱i̱n Israél gágótse̱ gajmíí máꞌ iꞌwíin xa̱bo̱, numuu rí mbá xúgíí ná mbaa Kanaán ri̱ga̱ ewe. <verse eid="GEN 42:5" /><verse number="6" style="v" sid="GEN 42:6" />Jamí José ñajuun tsí naꞌthán-ñájuun numbaa rúꞌkhue̱n, jamí ikhaa̱ máꞌ na̱ngu̱júu̱n ganitsu mbá xúgíin xa̱bo̱ xuajen. A̱ꞌkhue̱n niguáꞌnú dxíyo̱o̱ José, jamí xúꞌkhue̱n máꞌ ni̱sma̱ti̱gúu̱n inuu, asndo mbayíí niꞌgíi̱ inúu̱. <figure style="fig" alt="Los hermanos hacen reverencia ante José" file="CO00730B.TIF" size="span" ref="42.6">Nitiamakuíí José ene̱ a̱ngui̱i̱n.</figure> <verse eid="GEN 42:6" /><verse number="7" style="v" sid="GEN 42:7" />Ído̱ José ndiꞌñúú a̱ngui̱i̱n, núkho̱ máꞌ neꞌne-nuwuu̱nꞌ-la. Xómáꞌ ikhaa̱ naꞌnii̱ rí tséꞌne-nuwuu̱nꞌ jamí mbá mikoo iꞌthúu̱n:</para>
  <para style="p" vid="GEN 42:7">―Náá iguwalaꞌ jánlaꞌ róꞌ.</para>
  <para style="p" vid="GEN 42:7">A̱ꞌkhue̱n ikhii̱n niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 42:7">―Ná mbaa Kanaán igúwa̱ꞌxo̱ꞌ rí mo̱tse̱xo̱ꞌ tháan ganitsu.<verse eid="GEN 42:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 42:8" />Maske máꞌ José neꞌne-nuwuu̱nꞌ dxíyo̱o̱, xómáꞌ ikhii̱n túne̱-nuwi̱i̱nꞌ. <verse eid="GEN 42:8" /><verse number="9" style="v" sid="GEN 42:9" />A̱ꞌkhue̱n rí ni̱rmáꞌáa̱n a̱kui̱i̱n José rí nigunda-jmíi̱ a̱ngui̱i̱n, jamí niꞌthúu̱n:</para>
  <para style="p" vid="GEN 42:9">―Xa̱bo̱ tsí nu̱ña̱ma ngu̱ꞌwa̱ ñajuanlaꞌ jánlaꞌ. Naguwalaꞌ gágúya̱álaꞌ xóo kri̱ga̱ numbaa ríge̱ꞌ.<verse eid="GEN 42:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 42:10" />A̱ꞌkhue̱n ikhii̱n niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 42:10">―Ra̱ꞌkhá, táta̱. I̱ndo̱ó máꞌ ganitsu iguwá yumbiáaꞌ gágótse̱. <verse eid="GEN 42:10" /><verse number="11" style="v" sid="GEN 42:11" />Mbá xúgiáa̱nꞌ-máxo̱ꞌ mbáwíi ana̱ꞌxo̱ꞌ. Xúꞌkhue̱n máꞌ xa̱bo̱ gamakuun ñajuanxo̱ꞌ. Nimbá miꞌtsún tánindxu̱ún yumbiáaꞌ xa̱bo̱ tsí nu̱ña̱ma ngu̱ꞌwa̱.<verse eid="GEN 42:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 42:12" />Xómáꞌ José niꞌthúu̱n:</para>
  <para style="p" vid="GEN 42:12">―Ra̱gákon rúꞌkhue̱n, naguwalaꞌ gágúya̱álaꞌ xóo phú kri̱ga̱ numbaa ríge̱ꞌ.<verse eid="GEN 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 42:13" />A̱ꞌkhue̱n ikhii̱n niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 42:13">―Yumbiáaꞌ ñajuanxo̱ꞌ mbá gu̱wa̱ꞌ i̱jmáa̱ꞌxo̱ꞌ, i̱ji̱i̱n mbáwíi xa̱bo̱ nikhi̱i̱ tsí xtáa ná mbaa Kanaán. Tsí lájuíin xtáa ga̱jma̱á ana̱ꞌxo̱ꞌ xúge̱ꞌ, jamí tsí i̱mba̱a̱ tsíkujma̱a̱.<verse eid="GEN 42:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 42:14" />A̱ꞌkhue̱n José niꞌthúu̱n:</para>
  <para style="p" vid="GEN 42:14">―Xómáꞌ rí na̱tha̱nꞌlaꞌ, gakon rí xa̱bo̱ tsí nu̱ña̱ma ngu̱ꞌwa̱ ñajuanlaꞌ. <verse eid="GEN 42:14" /><verse number="15" style="v" sid="GEN 42:15" />Ge̱e̱ gákujmaa xí phú gakon rí nu̱tha̱nlaꞌ: Ndaꞌyoo máꞌ Faraón rí ma̱xágájna̱a̱ꞌlaꞌ ge̱jioꞌ asndo gáꞌkha̱ dxíya̱ꞌlaꞌ tsí lájuíin. <verse eid="GEN 42:15" /><verse number="16" style="v" sid="GEN 42:16" />A̱gu̱xu̱ꞌmáa mbáa dxájualaꞌ jamí ga̱ꞌkha̱ jayáa̱ ge̱ꞌthia̱ꞌlaꞌ, xómáꞌ ikháa̱nꞌlaꞌ a̱wanálaꞌ ná guéjua̱nꞌ. A̱ꞌkhue̱n mbu̱ꞌyáálóꞌ xí phú nu̱tha̱nlaꞌ rí gakon. Jamí xí na̱nguá, ndaꞌyoo máꞌ Faraón rí ikháa̱nꞌlaꞌ ñajuanlaꞌ xa̱bo̱ tsí nu̱ña̱ma ngu̱ꞌwa̱.<verse eid="GEN 42:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 42:17" />A̱ꞌkhue̱n rí José nixúdii̱n mbá xúgíi̱n ná guéjua̱nꞌ mbá atsú mbiꞌi. <verse eid="GEN 42:17" /><verse number="18" style="v" sid="GEN 42:18" />Ído̱ neꞌne atsú mbiꞌi José niꞌthúu̱n:</para>
  <para style="p" vid="GEN 42:18">―Ikhúúnꞌ nda̱ya̱-makuu Ana̱ꞌlóꞌ. A̱go̱ne̱laꞌ ríge̱ꞌ, ikhaa jngó mbu̱ya̱a̱ mbiꞌyalaꞌ. <verse eid="GEN 42:18" /><verse number="19" style="v" sid="GEN 42:19" />Xí gakon rí xa̱bo̱ gamakuun ñajuanlaꞌ, a̱wanúu mbáa dxájualaꞌ ná guéjua̱nꞌ, jamí aꞌgua̱a̱ꞌlaꞌ tikhuáa̱nꞌlaꞌ ju̱dalaꞌ ganitsu rí mo̱pho̱ a̱ngia̱nꞌlaꞌ ná guꞌwáá. <verse eid="GEN 42:19" /><verse number="20" style="v" sid="GEN 42:20" />I̱ndo̱ó a̱guwa̱a̱ꞌlaꞌ ju̱ya̱a̱ dxíya̱ꞌlaꞌ tsí lájuíin. A̱ꞌkhue̱n rí ma̱kujmaa rí gakon rí nu̱tha̱nlaꞌ, ikhaa jngó ma̱xájáñalaꞌ.</para>
  <para style="p" vid="GEN 42:20">A̱ꞌkhue̱n ndiyáa̱ rí nda̱a̱ i̱mba̱ rí muni̱i̱. <verse eid="GEN 42:20" /><verse number="21" style="v" sid="GEN 42:21" />Ikhaa jngó nithan-mi̱jne̱e̱: «Rí phú gakon rí ni̱xu̱ꞌdá-míjnálóꞌ aꞌkhán ga̱jma̱á numuu ge̱ꞌtia̱ꞌlóꞌ. Ído̱ ndiꞌyáálóꞌ rí namínu̱u̱ꞌ xúꞌkhue̱n máꞌ rí naꞌthán-jáñalóꞌ, xómáꞌ ikháánlóꞌ túdxawíi̱nlóꞌ. Ikhaa jngó namíni̱ilóꞌ ikháánlóꞌ xúge̱ꞌ ge̱e̱ rá».<verse eid="GEN 42:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 42:22" />A̱ꞌkhue̱n niꞌthán Rubén: «Á tátha̱nꞌlaꞌ ikhúúnꞌ rá: “Ma̱xáxu̱ꞌdá-míjnálaꞌ aꞌkhán ga̱jma̱á numuu dxáma”, rá dxe̱ꞌ. Xómáꞌ ikháa̱nꞌlaꞌ túdxawuu̱nꞌlaꞌ. Ikhaa jngó xúge̱ꞌ noꞌne̱-numa̱a̱ꞌlóꞌ iꞌdiuu̱ rá».<verse eid="GEN 42:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 42:23" />Xómáꞌ ikhii̱n tsíyáa̱ xí nadxawuun José rí nothee̱n, numuu rí xtáa mbáa tsí naꞌthán-wíi̱ ajngúu̱n. <verse eid="GEN 42:23" /><verse number="24" style="v" sid="GEN 42:24" />A̱ꞌkhue̱n rí José niríya̱ꞌ-mina̱ꞌ janíí, jamí ni̱mbi̱ye̱e̱ꞌ. Nda̱wa̱á a̱ꞌkhue̱n ni̱ꞌkha̱a̱, nindxákuu̱n gajmíi̱. A̱ꞌkhue̱n rí wartuwiin Simeón inúu̱ máꞌ ikhii̱n, jamí nixtoꞌwóo̱.<verse eid="GEN 42:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 42:25" />Nda̱wa̱á a̱ꞌkhue̱n nixná-ñájun José rí ma̱ti ixí iña ná xkudiúu̱n, xúꞌkhue̱n máꞌ mi̱rtanga̱a̱ la mbúkho̱o̱ mbámbáa, ma̱gi̱wa̱a̱ꞌ ne̱ ná xkudiúu̱n. Jamí niꞌthée̱n rí ma̱janúú rí mo̱pho̱ ná jamba̱á. Xkuaꞌnii máꞌ nene̱-mbáníi̱. <verse eid="GEN 42:25" /><verse number="26" style="v" sid="GEN 42:26" />Xómáꞌ ikhii̱n niyaꞌdúu̱n ganitsu xtá-ngidi, jamí nigájnáa̱ nigúu̱n.<verse eid="GEN 42:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 42:27" />Jamí ído̱ niguáꞌníi̱ ná rí mbuya̱a̱ xúu̱nꞌ, a̱ꞌkhue̱n nirmáꞌthoo mbáa rawuun xkudiuu rí maxnúu̱ rí me̱kho̱ xtá-ngidiuu̱. A̱ꞌkhue̱n ndiꞌyoo̱ rí ná awúun xkudiuu̱ kua̱ꞌa̱n mbúkho̱o̱. <figure style="fig" alt="La sorpresa de un hermano, dinero en la carga" file="CO00737b.tif" size="span" ref="42.27">Namakuu mbáa dxíyo̱o̱ José rí wartanga̱a̱ mbúkho̱o̱.</figure> <verse eid="GEN 42:27" /><verse number="28" style="v" sid="GEN 42:28" />A̱ꞌkhue̱n iꞌthúu̱n a̱ngui̱i̱n: «Ji-lá mbúkho̱ꞌ wartanga̱a̱ jún. Á ra̱ꞌkhá ne̱ kua̱ꞌa̱n ge̱e̱ ná rawuun xkudio̱ꞌ».</para>
  <para style="p" vid="GEN 42:28">A̱ꞌkhue̱n ni̱ka̱ a̱kuíi̱n, nimíñúu̱ jamí nithan-mi̱jne̱e̱: «Náá-lá rí ñajuun ríge̱ꞌ rí naꞌñalóꞌ Ana̱ꞌlóꞌ rá».<verse eid="GEN 42:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 42:29" />Ído̱ niguáꞌnúu̱ inuu anúu̱ ná mbaa Kanaán, a̱ꞌkhue̱n nitháa̱n mbá xúgíí xóo rí nigíꞌníi̱: <verse eid="GEN 42:29" /><verse number="30" style="v" sid="GEN 42:30" />«Ikhaa xa̱biya̱ tsúꞌkhue̱n, tsí naꞌthán-ñájuun mbaa rúꞌkhue̱n, niꞌthánxo̱ꞌ mbá mikoo, xúꞌkhue̱n máꞌ niꞌñaxo̱ꞌ asndo xóo xa̱bo̱ tsí nu̱ya̱ma ngu̱ꞌwa̱á xuajen jaꞌñáa̱ꞌxo̱ꞌ. <verse eid="GEN 42:30" /><verse number="31" style="v" sid="GEN 42:31" />Xómáꞌ ikháa̱nꞌxo̱ꞌ ni̱tháa̱nxo̱ꞌ: “Xa̱bo̱ gamakuun ñajuanxo̱ꞌ, nimbá miꞌtsún tánindxa̱ꞌxo̱ꞌ xa̱bo̱ tsí nu̱ya̱ma ngu̱ꞌwa̱. <verse eid="GEN 42:31" /><verse number="32" style="v" sid="GEN 42:32" />Mbá gu̱wa̱ꞌ i̱jmi̱i̱ dxíya̱ꞌxo̱ꞌ rí mbáwíi máꞌ ana̱ꞌxo̱ꞌ. Mbáa tsí tsíkujma̱a̱, jamí tsí lájuíin xtáa xúge̱ꞌ ga̱jma̱á ana̱ꞌxo̱ꞌ ná mbaa Kanaán”.<verse eid="GEN 42:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 42:33" />»A̱ꞌkhue̱n rí xa̱biya̱ tsúꞌkhue̱n, tsí naꞌthán-ñájuun máꞌ mbaa rúꞌkhue̱n, niꞌthánxo̱ꞌ: “Ga̱jma̱á ríge̱ꞌ mba̱yo̱o̱ xí phú gakon rí xa̱bo̱ gamakuun ñajuanlaꞌ. Gu̱ni̱ꞌñáálaꞌ mbáa dxíya̱ꞌlaꞌ ga̱jma̱á nindxu̱ꞌ, jamí aꞌgua̱a̱ꞌlaꞌ guꞌwálaꞌ ju̱da rí mo̱pho̱ a̱ngia̱nꞌlaꞌ. <verse eid="GEN 42:33" /><verse number="34" style="v" sid="GEN 42:34" />Xúꞌkhue̱n máꞌ a̱guwa̱a̱ꞌlaꞌ ju̱ya̱a̱ ge̱ꞌthia̱ꞌlaꞌ, ikhaa jngó mba̱yo̱o̱ rí ra̱ñájuanlaꞌ xa̱bo̱ tsí nu̱ya̱ma ngu̱ꞌwa̱, jngó mba̱yo̱o̱ máꞌ rí xa̱bo̱ gamakuun ñajuanlaꞌ. A̱ꞌkhue̱n rí ma̱xna̱xíi̱lo̱ꞌ dxíya̱ꞌlaꞌ, xúꞌkhue̱n máꞌ ma̱goo ma̱ngriga̱ꞌlaꞌ ná numbaa ríge̱ꞌ”».<verse eid="GEN 42:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 42:35" />Ído̱ rí ni̱rti̱jngaa̱ xkudiúu̱n, a̱ꞌkhue̱n nikujma̱a̱ mbúkhúu̱n katúxna̱a̱ ná xkudiuu máꞌ mbámbáa. Ído̱ rí ikhii̱n gajmíi̱ anúu̱ ndiyáa̱ mbúkhúu̱n, a̱ꞌkhue̱n phú nimíñúu̱. <verse eid="GEN 42:35" /><verse number="36" style="v" sid="GEN 42:36" />A̱ꞌkhue̱n rí waꞌthúu̱n neꞌne Jakób:</para>
  <para style="p" vid="GEN 42:36">―Ikháa̱nꞌlaꞌ no̱ne̱ gámbia̱ꞌlaꞌ i̱ji̱nꞌ. Tsíkujma̱a̱ José, ni máꞌ Simeón, jamí mu̱ꞌgua ju̱ya̱a̱ꞌlaꞌ Benjamín mangaa. Jamí ikhúúnꞌ na̱gruígúlo̱ꞌ xúgíí gaꞌkho̱ rúꞌkhue̱n.<verse eid="GEN 42:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 42:37" />A̱ꞌkhue̱n Rubén niꞌthúun anu̱u̱:</para>
  <para style="p" vid="GEN 42:37">―Ataxnáxi̱i̱ ja ge̱ꞌthe̱ꞌ ná ñawúnꞌ ikhúúnꞌlo̱ꞌ, jamí ikhúúnꞌ máꞌ gáꞌkha̱a̱ꞌ ja̱ya̱a̱lo̱ꞌ inaaꞌ. I̱ndo̱ó-lá xí tsíꞌkha̱a̱ꞌ ja̱ya̱a̱lo̱ꞌ inaaꞌ, a̱ꞌkhue̱n ma̱goo ma̱radíin ná-a̱jmi̱i̱ máꞌ i̱ji̱nꞌ. <figure style="fig" alt="Jacob abraza a Benjamín" file="CO00743B.TIF" size="span" ref="42.38">Tsíyuu Jakób rí ma̱ꞌga Benjamín ná Ejípto̱.</figure><verse eid="GEN 42:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 42:38" />A̱ꞌkhue̱n Jakób niꞌthán:</para>
  <para style="p" vid="GEN 42:38">―Ma̱xáꞌga a̱ꞌdéꞌ ga̱jma̱á nindxa̱ꞌlaꞌ, numuu rí nijáñuu máꞌ dxíyo̱o̱, jamí i̱mba̱wíi̱ ikhaa̱ iwanúu. Gáꞌne xí magíꞌnuu̱ mbá gamíjun ná jamba̱á ná nakualaꞌ, a̱ꞌkhue̱n rí mo̱ne̱laꞌ rí xi̱ꞌñú tsíge̱ꞌ ma̱ꞌgaa̱ ná iñá wa̱jíín ga̱jma̱á gaꞌkho̱.<verse eid="GEN 42:38" /></para>
  <chapter eid="GEN 42" />
  <chapter number="43" style="c" sid="GEN 43" />
  <para style="s">Natangi̱i̱n a̱ngui̱i̱n José ná Ejípto̱ gajmíí Benjamín</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1" />Phú i̱tha̱n gakhe̱ eꞌne ewe ná numbaa rúꞌkhue̱n. <verse eid="GEN 43:1" /><verse number="2" style="v" sid="GEN 43:2" />Ído̱ ni̱ga̱nú mbiꞌi rí wámbúu̱n ixí iña rí nigóo̱ gúdee̱ ná Ejípto̱, a̱ꞌkhue̱n rí niꞌthán anúu̱:</para>
  <para style="p" vid="GEN 43:2">―Ga̱tangáa̱nꞌlaꞌ, ma̱gótse̱laꞌ i̱mba̱á chímbaꞌa ganitsu rí mo̱ꞌpholóꞌ.<verse eid="GEN 43:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 43:3" />A̱ꞌkhue̱n Judá niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 43:3">―Ikhaa xa̱biya̱ tsúꞌkhue̱n khaꞌu niꞌthánxo̱ꞌ: “Ma̱xúyu̱ꞌlaꞌ xí tsíguwa̱a̱ꞌlaꞌ ju̱ya̱a̱ ge̱ꞌthia̱ꞌlaꞌ”. <verse eid="GEN 43:3" /><verse number="4" style="v" sid="GEN 43:4" />Xí ma̱ta̱xu̱ꞌmáa ge̱ꞌthia̱ꞌxo̱ꞌ ma̱ꞌga ga̱jma̱á nindxa̱ꞌxo̱ꞌ, mu̱ꞌguáxo̱ꞌ gútse̱xo̱ꞌ ganitsu xúꞌkhue̱n rá. <verse eid="GEN 43:4" /><verse number="5" style="v" sid="GEN 43:5" />I̱ndo̱ó-lá xí tsítatsíñáá rí ma̱ꞌgee̱, ma̱xúꞌguá-máxo̱ꞌ. Numuu rí ikhaa xa̱biya̱ tsúꞌkhue̱n niꞌthánxo̱ꞌ: “Ma̱xúyu̱ꞌlaꞌ xí tsíguwa̱a̱ꞌlaꞌ ju̱ya̱a̱ ge̱ꞌthia̱ꞌlaꞌ”.<verse eid="GEN 43:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 43:6" />A̱ꞌkhue̱n niꞌthán Israél:</para>
  <para style="p" vid="GEN 43:6">―Náá rí jngó ra̱ꞌkhá-tháán nu̱ñu̱ꞌlaꞌ rí ra̱máján róꞌ, rí ni̱tháánlaꞌ xa̱biya̱ tsúꞌkhue̱n rí kuaꞌdaalaꞌ i̱mba̱a̱ ge̱ꞌthia̱ꞌlaꞌ róꞌ.<verse eid="GEN 43:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 43:7" />Xómáꞌ ikhii̱n ni̱ri̱ꞌñaa̱:</para>
  <para style="p" vid="GEN 43:7">―Ikhaa xa̱biya̱ tsúꞌkhue̱n niraxa̱ꞌxo̱ꞌ makoo xóo júwa̱ꞌxo̱ꞌ xúꞌkhue̱n máꞌ numúú a̱ngia̱nꞌxo̱ꞌ: “Á xtáa xóó ana̱ꞌlaꞌ rá. Á xtáa i̱mba̱a̱ ge̱ꞌthia̱ꞌlaꞌ rá dxe̱ꞌ”. A̱ꞌkhue̱n ni̱tháa̱nxo̱ꞌ xómá rí niraxa̱ꞌxo̱ꞌ. Xáne-lá gúya̱áxo̱ꞌ rí maꞌthánxo̱ꞌ: “A̱guwalaꞌ ju̱ya̱a̱ ge̱ꞌthia̱ꞌlaꞌ,” rá.<verse eid="GEN 43:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 43:8" />A̱ꞌkhue̱n rí Judá niꞌthúun anu̱u̱:</para>
  <para style="p" vid="GEN 43:8">―Ataxuꞌmaa dxáma ma̱ꞌga ga̱jma̱á nindxu̱ꞌ, a̱ꞌkhue̱n rí mu̱ꞌguá-máxo̱ꞌ, jngó ma̱goo ma̱juwalóꞌ rí ma̱xájáñalóꞌ, ikháa̱nꞌxo̱ꞌ, ni ikháán, ni máꞌ i̱jia̱nꞌxo̱ꞌ. <verse eid="GEN 43:8" /><verse number="9" style="v" sid="GEN 43:9" />Ikhúúnꞌ gári̱ꞌñuu ga̱jma̱á numuu dxáma, jamí ikhúúnꞌ máꞌ gáta̱nda̱ꞌa̱a̱ náá rí nigíꞌnuu̱. Xí ikhúúnꞌ tsíꞌkha̱ ja̱ya̱a̱ rí ma̱xna̱xíi̱ inaaꞌ, ikhúúnꞌ gúꞌdo̱ꞌ aꞌkhán inaaꞌ mbá jámuu mbiꞌi xúꞌkhue̱n rá. <verse eid="GEN 43:9" /><verse number="10" style="v" sid="GEN 43:10" />Xí numuu rí tágajiáxo̱ꞌ rá, gakon máꞌ timbá riajma̱ nothon itangáa̱nꞌxo̱ꞌ.<verse eid="GEN 43:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 43:11" />A̱ꞌkhue̱n niriꞌña̱a̱ anúu̱:</para>
  <para style="p" vid="GEN 43:11">―Nda̱a̱ rí ma̱ꞌne rámá. A̱go̱ne̱-málaꞌ xáꞌnii. A̱gu̱da ná awúun xkudialaꞌ rí i̱tha̱n máján rí najma̱a̱ ná mbaa ríge̱ꞌ, a̱gu̱dalaꞌ ne̱ asndo xóo mbá gamaku inuu xa̱biya̱ tsúꞌkhue̱n: mbá lájuíin wájia thana ndaa thawuun, mbá lájuíin yáá, mbá lájuíin iya rí ndaa thawuun, wájioo ixu̱u̱ mírra̱, xúꞌkhue̱n máꞌ tsída̱a̱n ga̱jma̱á alméndra̱. <verse eid="GEN 43:11" /><verse number="12" style="v" sid="GEN 43:12" />Mangaa a̱gu̱ya̱a̱-málaꞌ rí a̱jma̱ kíxnuu mbúkha̱a̱, numuu rí ma̱ꞌgaa̱ rí wartanga̱a̱ ná awúun xkudialaꞌ. Gáꞌne xí ni̱ngra̱ꞌaa tsí neꞌne ne̱. <verse eid="GEN 43:12" /><verse number="13" style="v" sid="GEN 43:13" />Aꞌgualaꞌ gajmiálaꞌ ge̱ꞌthia̱ꞌlaꞌ mangaa, jamí ga̱tangáa̱nꞌlaꞌ inuu xa̱bo̱ tsúꞌkhue̱n. <verse eid="GEN 43:13" /><verse number="14" style="v" sid="GEN 43:14" />Jamí Ana̱ꞌlóꞌ tsí Gíꞌdoo Xúgíí Tsiakhe̱ gáꞌne rí xa̱bo̱ tsúꞌkhue̱n ma̱ñáwíin a̱kui̱i̱n jaꞌyalaꞌ jamí maniñuu̱ꞌ i̱mba̱a̱ dxíya̱ꞌlaꞌ, xúꞌkhue̱n máꞌ Benjamín. Xí ikhúúnꞌ jaꞌyoo rí ma̱ndáti̱gi̱i̱n i̱ji̱nꞌ, ga̱ꞌne máꞌ xúꞌkhue̱n.<verse eid="GEN 43:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 43:15" />A̱ꞌkhue̱n rí ikhii̱n nidee̱ gamaku, ga̱jma̱á máꞌ a̱jma̱ kíxnuu mbúkha̱a̱, xúꞌkhue̱n máꞌ juya̱a̱ Benjamín mangaa. A̱ꞌkhue̱n rí niguáxi̱i̱n nigóo̱ ná Ejípto̱, jamí ni̱xna̱xe̱-mi̱jne̱e̱ inuu José. <figure style="fig" alt="Los hermanos regresan a Egipto" file="CO00740B.TIF" size="span" ref="43.15">Natangi̱i̱n i̱ji̱i̱n Jakób nagúu̱n ná Ejípto̱.</figure> <verse eid="GEN 43:15" /><verse number="16" style="v" sid="GEN 43:16" />Ído̱ ndiꞌyoo José rí ni̱ꞌkha̱ Benjamín gajmíí a̱ngui̱i̱n, a̱ꞌkhue̱n niꞌthúu̱n xa̱bo̱ tsí na̱ru̱thuun ñajun ná goꞌóo̱: «Ayu xtiin tháan xa̱bekha tsíge̱ꞌ ná guꞌwáá, jamí ataxíya̱a̱ mbáa xede̱ xúꞌkhue̱n máꞌ athane̱ májáa̱nꞌ. Numuu rí xa̱bekha tsíge̱ꞌ ma̱kueꞌtsolo̱ꞌ wakho̱ꞌ gajmíꞌ». <verse eid="GEN 43:16" /><verse number="17" style="v" sid="GEN 43:17" />Xómáꞌ yumbáá tsúꞌkhue̱n neꞌne-mbánuu mbá xóo waꞌtháán, ni̱ka̱ jagu̱u̱n xa̱bekha tsúꞌkhue̱n ná goꞌóo máꞌ José.<verse eid="GEN 43:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 43:18" />A̱ꞌkhue̱n rí ikhii̱n nimíñúu̱ ído̱ ni̱ka̱ jiꞌdii̱n ná goꞌóo José, xúꞌkhue̱n máꞌ nithee̱n: «Ga̱jma̱á numuu mbúkha̱a̱ rí wartanga̱a̱ ná awúun xkudialóꞌ nákhí rí ginii, ikhaa ñajuun rí na̱ꞌkha̱ jiꞌdáánlóꞌ ge̱jioꞌ rá. Ikhaa jngó ma̱goo mu̱rugua-raꞌáa̱nꞌlóꞌ jamí mu̱rtuwáa̱nꞌlóꞌ rí ma̱nindxa̱ꞌlóꞌ yumbáá, xúꞌkhue̱n máꞌ xtá-ngidialóꞌ». <verse eid="GEN 43:18" /><verse number="19" style="v" sid="GEN 43:19" />A̱ꞌkhue̱n rí ni̱xu̱ꞌma-mi̱jne̱e̱ inuu xa̱bo̱ tsí na̱ru̱thuun ñajun ná goꞌóo José, jamí xáꞌnii nitháa̱n rí inuu máꞌ ma̱nújngúu̱n ná rawuun guꞌwáá:<verse eid="GEN 43:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 43:20" />―Athane̱ mba̱a̱ a̱kia̱a̱nꞌ, táta̱. Ikháa̱nꞌxo̱ꞌ phú gakon máꞌ rí ni̱gúwa̱ꞌ-máxo̱ꞌ wapha rí mo̱tse̱xo̱ꞌ ganitsu. <verse eid="GEN 43:20" /><verse number="21" style="v" sid="GEN 43:21" />Ído̱ natangáa̱nꞌ-máxo̱ꞌ rá, niguáꞌnúxo̱ꞌ ná rí mbu̱ya̱a̱ xa̱ꞌxo̱ꞌ, ni̱rmáꞌthááxo̱ꞌ xkudiaxo̱ꞌ. A̱ꞌkhue̱n ndi̱ya̱áxo̱ꞌ rí kua̱ꞌa̱n mbúkho̱o̱ mbámbáa ná awúun xkudiuu, mbá xóo rí kíxnuu máꞌ ne̱. Ikhaa jngó ju̱ya̱xo̱ꞌ ne̱ igúwa̱a̱ꞌxo̱ꞌ xúge̱ꞌ. <verse eid="GEN 43:21" /><verse number="22" style="v" sid="GEN 43:22" />Xúꞌkhue̱n máꞌ mangaa ju̱ya̱-máxo̱ꞌ mbúkha̱a̱ rí mo̱tse̱xo̱ꞌ xóó ganitsu. Jamí tsíya̱áxo̱ꞌ tsáa ñajuun tsí nirtanga̱a̱ mbúkha̱a̱ ná awúun xkudiaxo̱ꞌ.<verse eid="GEN 43:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 43:23" />Xómáꞌ ikhaa̱ niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 43:23">―Ma̱xáꞌthúun máꞌ a̱kia̱nꞌlaꞌ, ni máꞌ ma̱xámíñalaꞌ. Ana̱ꞌlaꞌ ikháa̱nꞌlaꞌ, tsí Anu̱u̱ máꞌ ana̱ꞌlaꞌ, nigíwa̱a̱nꞌ mbúkha̱a̱ ná awúun xkudialaꞌ. Jmínu̱ú máꞌ ni̱gruígú mbúkha̱ꞌlaꞌ rí ne̱ne̱-númáá.</para>
  <para style="p" vid="GEN 43:23">A̱ꞌkhue̱n rí niríya̱a̱ꞌ Simeón jamí nixnáxi̱i̱ máꞌ ná inúu̱. <verse eid="GEN 43:23" /><verse number="24" style="v" sid="GEN 43:24" />A̱ꞌkhue̱n rí ikhaa̱ niꞌthúu̱n rí ma̱nújngúu̱n ná goꞌóo José, jamí nixnúu̱ iya rí mujiáa̱n nakhúu̱n, xúꞌkhue̱n máꞌ nijanúú rí mo̱pho̱ xtá-ngidi mangiin. <verse eid="GEN 43:24" /><verse number="25" style="v" sid="GEN 43:25" />Xómáꞌ ikhii̱n none̱-mbáníi̱ gamaku rí judee̱, awúun máꞌ rí ma̱ga̱núu̱ José wakha̱ꞌ, numuu rí nidxawíi̱n rí ikhín máꞌ gúpiꞌtsii̱.<verse eid="GEN 43:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 43:26" />Jamí ído̱ ni̱ga̱núu̱ José ná guꞌwáá, xómáꞌ ikhii̱n niguwá judúu̱n gamaku rí judee̱ jamí ni̱xna̱xi̱i̱ ne̱, xúꞌkhue̱n máꞌ ni̱sma̱ti̱gúu̱n ná inuu, rí niꞌgíi̱ inúu̱ asndo mbayíí. <verse eid="GEN 43:26" /><verse number="27" style="v" sid="GEN 43:27" />A̱ꞌkhue̱n rí José niraxúu̱n xáne júwe̱e̱ꞌ, mangaa niraxi̱i̱:</para>
  <para style="p" vid="GEN 43:27">―Ana̱ꞌlaꞌ tsí xi̱ꞌñú mbo̱ ni̱tha̱nlaꞌ numuu, á xtáa̱ mújúu̱n rá. Á xtáa̱ xóó rá.<verse eid="GEN 43:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 43:28" />Xómáꞌ ikhii̱n ni̱ri̱ꞌñaa̱:</para>
  <para style="p" vid="GEN 43:28">―Xtáa mújúun máꞌ yumbiáaꞌ tsí ana̱ꞌxo̱ꞌ, xóó máꞌ xtáa̱.</para>
  <para style="p" vid="GEN 43:28">A̱ꞌkhue̱n rí ni̱rnga̱du̱u̱n rí ndiya-makuíi̱. <verse eid="GEN 43:28" /><verse number="29" style="v" sid="GEN 43:29" />A̱ꞌkhue̱n niyaxe̱ José ndiꞌyoo Benjamín, tsí ge̱ꞌthe̱e̱, a̱dée máꞌ ru̱dúu̱, jamí niꞌthúu̱n:</para>
  <para style="p" vid="GEN 43:29">―Á tsíge̱ꞌ ñajuun dxíya̱ꞌlaꞌ tsí lájuíin, mbo̱ ni̱thu̱nꞌlaꞌ rá dxe̱ꞌ. ―A̱ꞌkhue̱n niꞌthúu̱n Benjamín―: Ana̱ꞌlóꞌ gáꞌne tsakun-rámáá, táa̱.<verse eid="GEN 43:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 43:30" />A̱ꞌkhue̱n rí José maphú gagi eꞌne xo̱xto̱o̱ ga̱jma̱á numuu rí ndaꞌyoo̱ dxíyo̱o̱, ikhaa jngó mbá nacha̱ ni̱ke̱e̱, ndiꞌyée̱ꞌ ná ma̱mbi̱ye̱e̱ꞌ. Ni̱ta̱ꞌa̱a̱ ná naꞌguii̱ jamí ikhín máꞌ ni̱mbi̱ye̱e̱ꞌ. <verse eid="GEN 43:30" /><verse number="31" style="v" sid="GEN 43:31" />Nda̱wa̱á ído̱ neꞌne gakhe̱-mine̱e̱ꞌ wáa, a̱ꞌkhue̱n niꞌjiáa̱n inuu̱, jamí nigájna̱a̱, xúꞌkhue̱n máꞌ niꞌthée̱n: «Ga̱khuáa máꞌ ganitsu rá».<verse eid="GEN 43:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 43:32" />A̱ꞌkhue̱n rí ni̱stra̱mee̱ꞌ mbá kiajuun rí me̱kho̱ José ja, xúꞌkhue̱n máꞌ mbá kiajuun rí mo̱pho̱ dxíyo̱o̱, jamí i̱mba̱ jayuu kiajuun rí mo̱pho̱ mbo̱ Ejípto̱ tsí napeꞌtso máꞌ ga̱jma̱á nindxu̱u̱ José. Numuu rí mbo̱ Ejípto̱ tsíyoo ma̱peꞌtso gajmíí mbo̱ ebréo̱, numuu rí mbá mate̱ꞌ mba̱a̱ iyáa̱ ikhii̱n. <verse eid="GEN 43:32" /><verse number="33" style="v" sid="GEN 43:33" />A̱ꞌkhue̱n rí waskuíji̱i̱n ná inuu máꞌ ꞌgí José. Ginii mbo̱ nikhi̱i̱, xómá i̱ꞌkha̱ tsigúu̱n nikuíji̱i̱n asndo tsí lájuíin jayu. Jamí ído̱ ndiyáa̱ rúꞌkhue̱n, phú namakúu̱n, i̱ndo̱ó nu̱ya̱xe̱-mi̱jne̱e̱. <verse eid="GEN 43:33" /><verse number="34" style="v" sid="GEN 43:34" />A̱ꞌkhue̱n rí José nixpíꞌthá-raꞌa ganitsu rí tráma máꞌ ná inuu̱ rí mu̱phi̱i̱. Xómáꞌ rí me̱kho̱ Benjamín ja rá, mbá witsu i̱tha̱n mba̱a̱ nikhuáa xóo rí nikhuáa inúú iꞌwíin. Xúꞌkhue̱n máꞌ niwa̱a̱n, jamí nijúwe̱e̱ꞌ gagi ga̱jma̱á nindxu̱u̱ José.<verse eid="GEN 43:34" /></para>
  <chapter eid="GEN 43" />
  <chapter number="44" style="c" sid="GEN 44" />
  <para style="s">Xu̱wá-ndiyuu José</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1" />A̱ꞌkhue̱n rí José nixná-ñájuun yumbáá tsí na̱ru̱thuun ñajun ná goꞌóo̱: «Athane̱ matíí la xkudiúún xa̱bekha tsíge̱ꞌ, mbá xóo rí na̱ꞌngúu̱n nudee̱, xúꞌkhue̱n máꞌ atagíwa̱a̱nꞌ mbúkho̱o̱ mbámbáa ná awúun xkudiuu. <verse eid="GEN 44:1" /><verse number="2" style="v" sid="GEN 44:2" />Jamí ma̱ta̱gíwa̱nꞌ xu̱wá-ndiyu̱ꞌ, ikhaa rí ajua̱nꞌ miꞌxá, ná awúun xkudiuu tsí lájuíin, ga̱jma̱á máꞌ mbúkho̱o̱ rí neꞌne numuu̱ ixí iña». Xómáꞌ yumbáá neꞌne-mbánuu̱ xóo rí niꞌthán José.<verse eid="GEN 44:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 44:3" />Ído̱ rí watse rí i̱mba̱ mbiꞌi, waꞌthán-ngawúún a̱ngui̱i̱n José rí magúu̱n gajmíi̱ xtá-ngidi. <verse eid="GEN 44:3" /><verse number="4" style="v" sid="GEN 44:4" />Ído̱ rí nigájnaa̱ máꞌ ikhii̱n ná awúun xuajen, asndo xóó máꞌ táꞌne tsínguu̱nꞌ, a̱ꞌkhue̱n José niꞌthúun yumbáá mbo̱ na̱ru̱thuun ñajun: «Ayu jamí araxka-nakhúún xa̱bo̱ tsúꞌkhue̱n. Ído̱ gáta̱xkami̱i̱, xáꞌnii gára̱thúu̱n: “Déjngó i̱rtanga̱a̱laꞌ rí ra̱máján ga̱jma̱á numuu rí máján róꞌ. Déjngó ne̱ne̱ ku̱ꞌwálaꞌ xu̱wá-ndiyuu táta̱ nikhi̱i̱ rí ajua̱nꞌ miꞌxá róꞌ. <figure style="fig" alt="Oficial en carro, sigue a hermanos" file="CO00745B.TIF" size="span" ref="44.4">Yumbáá ginii ni̱ka̱-raxka nakhúún a̱ngui̱i̱n José.</figure> <verse eid="GEN 44:4" /><verse number="5" style="v" sid="GEN 44:5" />Á ra̱ꞌkháa ikhaa ne̱ ñajuun rí najmuu táta̱ rí naꞌña̱a̱-muu̱ iya, xúꞌkhue̱n máꞌ rí naroꞌo̱o̱-muu̱ rá. Rí phú ra̱máján rí xkuaꞌnii ne̱ne̱laꞌ”».<verse eid="GEN 44:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 44:6" />Ído̱ ikhaa̱ nixkami̱i̱, a̱ꞌkhue̱n niꞌthúu̱n ikhaa máꞌ ajngáa rúꞌkhue̱n. <verse eid="GEN 44:6" /><verse number="7" style="v" sid="GEN 44:7" />Xómáꞌ ikhii̱n ni̱ri̱ꞌñaa̱:</para>
  <para style="p" vid="GEN 44:7">―Díjun jngó xkuaꞌnii irathánxo̱ꞌ róꞌ, xa̱bo̱ nikhi̱i̱. Ninguánáá ma̱xúne̱ rúꞌkhue̱n yumbiáaꞌ, táta̱. <verse eid="GEN 44:7" /><verse number="8" style="v" sid="GEN 44:8" />Á ra̱ꞌkhá nathayáá máꞌ rí mbúkha̱a̱ rí ni̱xkama̱a̱xo̱ꞌ ná awúun xkudiaxo̱ꞌ, ni̱gúwa̱ꞌxo̱ꞌ ju̱ya̱a̱xo̱ꞌ ne̱ inaaꞌ asndo ná mbaa Kanaán. Xáne-lá jngó mo̱ne̱ kúwa̱xo̱ꞌ ajua̱nꞌ rí miꞌxá jamí rí mo̱jmo̱ꞌ ná goꞌóo táta̱ nikhi̱i̱ rá. <verse eid="GEN 44:8" /><verse number="9" style="v" sid="GEN 44:9" />Ikhaa yumbiáaꞌ tsí ma̱kujma̱a̱ xu̱wá-ndiya ñawúun, ga̱ja̱ñúu. Xúꞌkhue̱n máꞌ mbá xúgiáa̱nꞌxo̱ꞌ ga̱nindxa̱ꞌxo̱ꞌ yumbée xa̱bo̱ nikhi̱i̱.<verse eid="GEN 44:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 44:10" />Xómáꞌ ikhaa̱ niꞌthúu̱n:</para>
  <para style="p" vid="GEN 44:10">―Xómáꞌ nu̱tha̱nlaꞌ gáꞌne rámá. I̱ndo̱ó tsí ma̱kujma̱a̱ ne̱ ñawúun, tsúꞌkhue̱n tsí ma̱nindxu̱u̱ yumbéꞌ. Xómáꞌ ikháa̱nꞌlaꞌ, nda̱a̱ máꞌ aꞌkhánlaꞌ.<verse eid="GEN 44:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 44:11" />A̱ꞌkhue̱n rí ikhii̱n mbá nacha̱ máꞌ ni̱stri̱guíi̱ xkudiúu̱n mbayíí. Xúꞌkhue̱n máꞌ mbámbáa nirmáꞌthoo xkudiuu. <verse eid="GEN 44:11" /><verse number="12" style="v" sid="GEN 44:12" />A̱ꞌkhue̱n rí nigíꞌdu̱u̱ ndiꞌyáa̱ꞌ ne̱ ginii ná xkudiuu tsí nikhi̱i̱, jamí wámbo̱o̱ ga̱jma̱á xkudiuu mbo̱ lájuíin. A̱ꞌkhue̱n rí nikujma̱a̱ xu̱wá-ndiya ná xkudiuu Benjamín. <figure style="fig" alt="La copa en costal de Benjamín" file="CO00749B.TIF" size="span" ref="44.12">Nakujma̱a̱ xu̱wá-ndiyuu José ná xkudiuu Benjamín.</figure> <verse eid="GEN 44:12" /><verse number="13" style="v" sid="GEN 44:13" />A̱ꞌkhue̱n rí ikhii̱n ni̱ru̱thii̱n xtíñúu̱ rí natájuíin a̱kuíi̱n, xúꞌkhue̱n máꞌ mbámbáa niyaꞌda̱a̱ xtá-ngidiuu jamí nitangi̱i̱n ná xuajen.<verse eid="GEN 44:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 44:14" />A̱ꞌkhue̱n ni̱ꞌkha̱a̱ Judá gajmíí dxíyo̱o̱ ná goꞌóo José, rí xóó máꞌ xtáa̱ ikhín. A̱ꞌkhue̱n ni̱sma̱ti̱gúu̱n ná inuu rí niꞌgíi̱ inúu̱ asndo mbayíí. <verse eid="GEN 44:14" /><verse number="15" style="v" sid="GEN 44:15" />A̱ꞌkhue̱n José niꞌthúu̱n:</para>
  <para style="p" vid="GEN 44:15">―Dí ñajuun ríge̱ꞌ rí ne̱ne̱laꞌ róꞌ. Á tsíya̱álaꞌ rí mbáa xa̱biya̱ xóo rí ikhúúnꞌ, na̱ma̱ñuu rí naroꞌo̱o̱ rá dxe̱ꞌ.<verse eid="GEN 44:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 44:16" />A̱ꞌkhue̱n niꞌthán Judá:</para>
  <para style="p" vid="GEN 44:16">―Dí-lá gútha̱a̱nꞌxo̱ꞌ rá, táta̱. Xóo-lá gásnga̱jmá-mi̱jna̱xo̱ꞌ rí nda̱a̱ aꞌkhánxo̱ꞌ rá. Ana̱ꞌlóꞌ nixkamaa aꞌkhúún yumbiáaꞌ. Ikhaa jngó, yumbiáaꞌ máꞌ ñajuanxo̱ꞌ rá, táta̱, ikháa̱nꞌxo̱ꞌ, jamí mangaa máꞌ tsí nikujma̱a̱ xu̱wá-ndiya ñawúun.<verse eid="GEN 44:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 44:17" />A̱ꞌkhue̱n José niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 44:17">―Ninguánáá ma̱xáne̱ rúꞌkhue̱n. I̱ndo̱ó máꞌ tsí nikujma̱a̱ xu̱wá-ndiya ñawúun, tsúꞌkhue̱n ma̱nindxu̱u̱ yumbéꞌ. Xómáꞌ ikháa̱nꞌlaꞌ, gaꞌgua̱a̱ꞌlaꞌ tsímáá ná inuu ana̱ꞌlaꞌ.<verse eid="GEN 44:17" /></para>
  <para style="s">Judá iꞌthán-kháan numuu Benjamín</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18" />A̱ꞌkhue̱n rí Judá nixuꞌma-mina̱ꞌ ná inuu José, jamí niꞌthúu̱n:</para>
  <para style="p" vid="GEN 44:18">―Táta̱, athane̱ mba̱a̱ a̱kia̱a̱nꞌ xtayo̱ꞌ. Na̱tha̱n-jáñaaꞌ rí ma̱ta̱dxawu̱nꞌ rí ma̱tha̱a̱nꞌ mbáꞌduun ajngáa. Ma̱xájiꞌnáá-lá ga̱jma̱á nindxu̱u̱ yumbiáaꞌ, numuu rí ikháán ñajuaanꞌ xómá Faraón.<verse eid="GEN 44:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 44:19" />»Ikháán máꞌ, táta̱, nitraxu̱ún yumbiáaꞌ: “Á xtáa ana̱ꞌlaꞌ o mbáa ge̱ꞌthia̱ꞌlaꞌ rá”. <verse eid="GEN 44:19" /><verse number="20" style="v" sid="GEN 44:20" />Xómáꞌ ikháa̱nꞌxo̱ꞌ ni̱ri̱ꞌñaa̱xo̱ꞌ rí nitraxa̱ꞌxo̱ꞌ, táta̱: “Xtáa ana̱ꞌxo̱ꞌ jamí xi̱ꞌñú guéño máꞌ ñajuu̱n, xúꞌkhue̱n máꞌ xtáa mbáa ge̱ꞌthia̱ꞌxo̱ꞌ tsí lájuíin xóó, tsí ni̱gi̱ꞌdaa̱ rí xi̱ꞌñíi̱ máꞌ. Xúꞌkhue̱n máꞌ mbáa dxájuu̱ nijáñuu, i̱mba̱wíi̱ ikhaa̱ iwanúu tsí i̱ji̱i̱n mbáwíi ru̱dúu̱, xómáꞌ anu̱u̱ phú nandoo jaꞌyoo̱”. <verse eid="GEN 44:20" /><verse number="21" style="v" sid="GEN 44:21" />Ikháán máꞌ nirathúún yumbiáaꞌ: “A̱guwalaꞌ ju̱ya̱a̱ jngó ma̱ne̱-núwíi̱nlo̱ꞌ”. <verse eid="GEN 44:21" /><verse number="22" style="v" sid="GEN 44:22" />Xómáꞌ ikháa̱nꞌxo̱ꞌ ni̱tha̱a̱nꞌxo̱ꞌ, táta̱: “Ma̱xáxóo maniñuu dxáma anu̱u̱. Xí maniñuu̱ꞌ, ma̱ja̱ñúu̱ gáꞌne”. <verse eid="GEN 44:22" /><verse number="23" style="v" sid="GEN 44:23" />A̱ꞌkhue̱n nirathúún yumbiáaꞌ: “Xí tsíꞌkha̱ ge̱ꞌthia̱ꞌlaꞌ ga̱jma̱á nindxa̱ꞌlaꞌ, nánguá máꞌ ma̱goo ma̱gruíguáa̱nꞌlaꞌ xúꞌkhue̱n rá”.<verse eid="GEN 44:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 44:24" />»Ído̱ niguáꞌnúu̱ꞌxo̱ꞌ inuu ana̱ꞌxo̱ꞌ tsí yumbiáaꞌ máꞌ, ni̱tháa̱nxo̱ꞌ xúgíí ajngáa xómáꞌ rí nirathánxo̱ꞌ, táta̱. <verse eid="GEN 44:24" /><verse number="25" style="v" sid="GEN 44:25" />Nda̱wa̱á niꞌthán ana̱ꞌxo̱ꞌ: “A̱tangáa̱nꞌlaꞌ mbu̱jú mo̱tse̱laꞌ i̱mba̱á chímbaꞌa ganitsu”. <verse eid="GEN 44:25" /><verse number="26" style="v" sid="GEN 44:26" />Xómáꞌ ikháa̱nꞌxo̱ꞌ ni̱ri̱ꞌñaa̱xo̱ꞌ ajngóo̱: “Ma̱xáxóo mu̱ꞌguáxo̱ꞌ. I̱ndo̱ó-lá xí ge̱ꞌthia̱ꞌxo̱ꞌ na̱ka̱ ga̱jma̱á nindxa̱ꞌxo̱ꞌ, mu̱ꞌguá-máxo̱ꞌ xúꞌkhue̱n rá. Numuu rí ma̱xáxóo gágrui̱guáa̱nꞌxo̱ꞌ xa̱biya̱ tsúꞌkhue̱n xí tsíka̱ ga̱jma̱á nindxa̱ꞌxo̱ꞌ ge̱ꞌthia̱ꞌxo̱ꞌ”.<verse eid="GEN 44:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 44:27" />»A̱ꞌkhue̱n rí ana̱ꞌxo̱ꞌ tsí yumbiáaꞌ máꞌ niꞌthánxo̱ꞌ: “Ikháa̱nꞌlaꞌ ndu̱yáá-málaꞌ rí a̱jmi̱i̱ i̱ji̱nꞌ ni̱gi̱ꞌdiin a̱ꞌgui̱ꞌ. <verse eid="GEN 44:27" /><verse number="28" style="v" sid="GEN 44:28" />Xómáꞌ mbáa a̱ꞌdéꞌ, nigájnuu ná inu̱ꞌ ni̱ka̱. Na̱ju̱mu̱ꞌ rí gakon máꞌ wachíku-makaa̱ neꞌne xu̱kú-xáná, jamí asndo mbiꞌi xúge̱ꞌ na̱nguá eꞌne mba̱yo̱o̱lo̱ꞌ. <verse eid="GEN 44:28" /><verse number="29" style="v" sid="GEN 44:29" />Xí a̱ꞌdéꞌ tsíge̱ꞌ mu̱ꞌgua ju̱ya̱a̱ꞌlaꞌ mangaa, jamí xí mbá gamíjun gágíꞌnuu̱, a̱ꞌkhue̱n rí mo̱ne̱laꞌ rí xi̱ꞌñú tsíge̱ꞌ ma̱ja̱ñúu gaꞌkhu̱u̱”.<verse eid="GEN 44:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 44:30" />»Ikhaa jngó xúge̱ꞌ rá, ído̱ gátangu̱ún inuu anu̱ꞌ, xí mba̱ꞌyoo̱ rí tsíꞌkha̱a̱ dxáma ga̱jma̱á nindxu̱ꞌ, <verse eid="GEN 44:30" /><verse number="31" style="v" sid="GEN 44:31" />ma̱ja̱ñúu̱ numuu rí gíꞌdaa̱ dxáma asndo xóo ními̱i̱. A̱ꞌkhue̱n rí yumbiáaꞌ gíꞌmii aꞌkhán rí xi̱ꞌñú ana̱ꞌxo̱ꞌ ma̱ja̱ñúu ga̱jma̱á gaꞌkhu̱u̱. <verse eid="GEN 44:31" /><verse number="32" style="v" sid="GEN 44:32" />Ikhúúnꞌ ni̱ri̱ꞌñuu ga̱jma̱á numuu dxáma ná inuu anu̱ꞌ, rí ni̱thu̱u̱n xáꞌnii: “Xí tsíꞌkha̱a̱ꞌ ja̱ya̱a̱ dxáma inaaꞌ, táa̱, a̱ꞌkhue̱n rí ikhúúnꞌ gúꞌdo̱ꞌ aꞌkhúnꞌ ná inaaꞌ mbá jámuu mbiꞌi xúꞌkhue̱n rá”.<verse eid="GEN 44:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 44:33" />»Ikhaa jngó na̱tha̱n-jáñaaꞌlo̱ꞌ rí ma̱wanúꞌ ñajun inuu dxáma, rí ma̱nindxu̱ꞌ yumbiáaꞌ, táta̱. Xómáꞌ dxáma ma̱ꞌgaa̱ gajmíí a̱ngui̱i̱n ja. <verse eid="GEN 44:33" /><verse number="34" style="v" sid="GEN 44:34" />Xáne-lá gátangu̱ún ná inuu anu̱ꞌ rí tsíꞌkha̱a̱ dxáma ga̱jma̱á nindxu̱ꞌ rá. Ma̱xáꞌngo̱o̱ a̱kui̱nꞌ mba̱yo̱o̱ rí ma̱gíꞌnuu anu̱ꞌ rí ra̱máján.<verse eid="GEN 44:34" /></para>
  <chapter eid="GEN 44" />
  <chapter number="45" style="c" sid="GEN 45" />
  <para style="s">José iꞌthán tsáa phú ñajuun</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1" />A̱ꞌkhue̱n rí José ná-táꞌngo̱o̱ gáꞌne gakhe̱ a̱kui̱i̱n inúú mbá xúgíin xa̱bo̱ tsí nuñajun inuu̱. A̱ꞌkhue̱n mbá gakhe̱ niꞌthée̱n: «A̱ga̱jnúú mbá xúgíin xa̱bo̱ tsí kachúún ge̱e̱». A̱ꞌkhue̱n rí nimbáa máꞌ yumbáá ná-táwanúu inuu̱ ído̱ rí ikhaa̱ niꞌnii̱ rí ma̱gu̱ma-nuwii̱n inúú a̱ngui̱i̱n. <verse eid="GEN 45:1" /><verse number="2" style="v" sid="GEN 45:2" />A̱ꞌkhue̱n rí phú gakhe̱ ni̱mbi̱ye̱e̱ꞌ, rí asndo nidxawíín mbo̱ Ejípto̱, xúꞌkhue̱n máꞌ ni̱ga̱nú ajngáa asndo ná goꞌóo Faraón<note caller="+" style="f"><char style="fr" closed="false">45.2 </char><char style="ft" closed="false">«Faraón» nuxnáá mbiꞌyuu thúngaa mba̱a̱ ná Ejípto̱.</char></note> mangaa. <verse eid="GEN 45:2" /><verse number="3" style="v" sid="GEN 45:3" />A̱ꞌkhue̱n José niꞌthúún dxíyo̱o̱:</para>
  <para style="p" vid="GEN 45:3">―Ikhúúnꞌ ñaju̱nꞌ José. Á xtáa xóó anu̱ꞌ rá dxe̱ꞌ.</para>
  <para style="p" vid="GEN 45:3">Xómáꞌ dxíyo̱o̱ táma̱ñúú rí mu̱riꞌña̱a̱, numuu rí ni̱ka̱ a̱kuíi̱n inuu José. <verse eid="GEN 45:3" /><verse number="4" style="v" sid="GEN 45:4" />A̱ꞌkhue̱n José niꞌthúu̱n:</para>
  <para style="p" vid="GEN 45:4">―A̱gu̱xu̱ꞌma-mi̱jna̱laꞌ tháan ná inu̱ꞌ ge̱e̱.</para>
  <para style="p" vid="GEN 45:4">Xómáꞌ ikhii̱n ni̱xu̱ꞌma-mi̱jne̱e̱. A̱ꞌkhue̱n ikhaa̱ niꞌthúu̱n:</para>
  <para style="p" vid="GEN 45:4">―Ikhúúnꞌ ñaju̱nꞌ José, ge̱ꞌthia̱ꞌlaꞌ tsí ni̱ngu̱jua̱a̱laꞌ ma̱ꞌga Ejípto̱. <figure style="fig" alt="José, Benjamín- 2 hermanos" file="CO00751B.TIF" size="span" ref="45.4">José iꞌthúún dxíyo̱o̱: «Ikhúúnꞌ ñaju̱nꞌ ge̱ꞌthia̱ꞌlaꞌ».</figure> <verse eid="GEN 45:4" /><verse number="5" style="v" sid="GEN 45:5" />Ikhaa jngó xúge̱ꞌ rá, ma̱xájuwalaꞌ gaꞌkho̱, ni máꞌ ma̱xájiꞌná ju̱ya̱-mi̱jna̱laꞌ rí ni̱ngu̱júúnlaꞌ rí ma̱ꞌkha ge̱jioꞌ. Numuu rí Ana̱ꞌ-málóꞌ nixuꞌmúú wapha ginúú ná inalaꞌ, jngó ma̱goo ma̱jáwíin xa̱bo̱. <verse eid="GEN 45:5" /><verse number="6" style="v" sid="GEN 45:6" />Tiriajma̱ máꞌ tsigu eꞌne rí ri̱ga̱ ewe inuu numbaa, jamí xóó ndaꞌyóo i̱mba̱á witsu tsigu rí ma̱xáríga̱ gidu ni máꞌ rí ma̱gi̱xi̱i̱. <verse eid="GEN 45:6" /><verse number="7" style="v" sid="GEN 45:7" />Ikhaa jngó Ana̱ꞌlóꞌ nixuꞌmúú wapha máꞌ ginúú ná inalaꞌ, rí ma̱xámba̱a̱ ri̱jia̱ꞌlaꞌ ná inuu numbaa, jamí ma̱jáwia̱nꞌlaꞌ ga̱jma̱á rí wáá rí naꞌne Ana̱ꞌlóꞌ. <verse eid="GEN 45:7" /><verse number="8" style="v" sid="GEN 45:8" />Rúꞌkhue̱n jngó Ana̱ꞌlóꞌ ñajuun tsí nixuꞌmúú rí ma̱ꞌkhalo̱ꞌ ge̱jioꞌ, ra̱ꞌkhá ikháa̱nꞌlaꞌ ne̱ne̱. Ikhaa̱ niꞌgiúu̱n rí ma̱nindxu̱ꞌ asndo xóo anu̱u̱ Faraón, jamí tsí na̱ru̱thuun xúgíí ñajun ná goꞌóo̱, xúꞌkhue̱n máꞌ niꞌgiúu̱n rí ma̱nindxu̱ꞌ thúngaa mbá xúgíí ná mbayuu Ejípto̱.<verse eid="GEN 45:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 45:9" />»Mbá nacha̱ máꞌ góne̱laꞌ, jamí aꞌgua̱a̱ꞌlaꞌ ná xtáa anu̱ꞌ, xúꞌkhue̱n máꞌ a̱gu̱tháa̱nlaꞌ: “Xáꞌnii iꞌthán a̱ꞌdeáaꞌ José: ‘Ana̱ꞌlóꞌ niꞌgiúún rí ma̱nindxu̱ꞌ thúngaa ná Ejípto̱. Aya̱ gátha̱yo̱ꞌ, ma̱xátha̱ne̱ gajíí-mina̱ꞌ-lá. <verse eid="GEN 45:9" /><verse number="10" style="v" sid="GEN 45:10" />A̱ꞌkhue̱n rí ma̱ra̱xtaa ná mbaa Gosén, mijngi máꞌ ná inu̱ꞌ gára̱xtaa. Mi̱dxa̱ꞌ ikháán jamí i̱jia̱a̱nꞌ, jamí i̱jín-xíñaaꞌ máꞌ, xúꞌkhue̱n máꞌ xu̱kiáaꞌ tsí xtaꞌdiin, jamí xúgíí rí xtaꞌdáá. <verse eid="GEN 45:10" /><verse number="11" style="v" sid="GEN 45:11" />Jamí ikhúúnꞌ máꞌ gáxna̱a̱ꞌ rí me̱ꞌtso, numuu rí xóó ma̱ri̱gá ewe i̱mba̱á witsu tsigu. Ikhaa jngó ma̱xámbáa̱nꞌlaꞌ awúun tsingíná ikháán jamí xa̱bia̱a̱ꞌ, xúꞌkhue̱n máꞌ mbá xúgíí rí xtaꞌdáá.’ ” <verse eid="GEN 45:11" /><verse number="12" style="v" sid="GEN 45:12" />Rí xúge̱ꞌ rá, inalaꞌ eꞌne jamí inuu máꞌ ge̱ꞌthe̱ꞌ Benjamín, rí ajngáa rawu̱nꞌ jmínu̱ú ñajuun rí na̱tha̱nꞌlaꞌ. <verse eid="GEN 45:12" /><verse number="13" style="v" sid="GEN 45:13" />A̱gu̱tháánlaꞌ anu̱ꞌ mbá xúgíí xóo i̱tha̱n-nájun ikhúúnꞌ ná numbaa Ejípto̱, jamí mbá xúgíí rí ndi̱ya̱álaꞌ. Mbá nacha̱ máꞌ gágúne̱laꞌ, jamí a̱guwalaꞌ ju̱ya̱a̱ anu̱ꞌ ge̱jioꞌ.<verse eid="GEN 45:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 45:14" />A̱ꞌkhue̱n rí José ndiyá-raꞌaa̱ ge̱ꞌthe̱e̱, jamí ni̱mbi̱ye̱e̱ꞌ. Ikhaa máꞌ neꞌne Benjamín, jamí ni̱mbi̱ye̱e̱ꞌ ga̱jmáa̱. <verse eid="GEN 45:14" /><verse number="15" style="v" sid="GEN 45:15" />Mangaa máꞌ niraꞌnuu̱ inúú mbá xúgíin a̱ngui̱i̱n, jamí ni̱mbi̱ye̱e̱ꞌ gajmíi̱. Asndo a̱ꞌkhue̱n rí nithan wáa a̱ngui̱i̱n ga̱jma̱á nindxu̱u̱.<verse eid="GEN 45:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 45:16" />A̱ꞌkhue̱n ni̱ga̱nú ajngáa ríge̱ꞌ asndo ná goꞌóo Faraón rí niguáꞌnú a̱ngui̱i̱n José. Nidxuun a̱kui̱i̱n Faraón jamí xúꞌkhue̱n máꞌ mangiin xa̱bo̱ ñajun drígo̱o̱. <verse eid="GEN 45:16" /><verse number="17" style="v" sid="GEN 45:17" />A̱ꞌkhue̱n Faraón niꞌthúun José: «Arathúún dxíya̱a̱ꞌ: “A̱go̱ne̱laꞌ ríge̱ꞌ, a̱gu̱yaꞌdúúnlaꞌ xu̱kiálaꞌ, jamí a̱tangáa̱nꞌlaꞌ mu̱ꞌguaa̱ꞌlaꞌ ná mbaa Kanaán. <verse eid="GEN 45:17" /><verse number="18" style="v" sid="GEN 45:18" />A̱guwa-ju̱ya̱a̱ ana̱ꞌlaꞌ jamí xúꞌkhue̱n máꞌ xa̱bia̱ꞌlaꞌ, a̱guwalaꞌ ge̱jioꞌ. Numuu rí ikhúúnꞌ ma̱xna̱ꞌlaꞌ mbaa rí i̱tha̱n máján rí ríga̱ ná numbaa Ejípto̱, jamí mo̱pholaꞌ mbá xúgíí rí najma̱a̱ máꞌ ná inuu mbaa ge̱e̱”.<verse eid="GEN 45:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 45:19" />»Jamí araxná-ñájúu̱n dxíya̱a̱ꞌ: “A̱go̱ne̱laꞌ ríge̱ꞌ, aꞌgua-ju̱ya̱ꞌlaꞌ ixe̱ rí naxmáthaa guáyo̱ rí ríga̱ ná Ejípto̱, jngó ma̱guwá i̱jia̱nꞌlaꞌ awúun ne̱, xúꞌkhue̱n gu̱ꞌya̱ꞌlaꞌ. Xúꞌkhue̱n máꞌ a̱guwa-ju̱ya̱a̱ ana̱ꞌlaꞌ mangaa. <verse eid="GEN 45:19" /><verse number="20" style="v" sid="GEN 45:20" />Ma̱xáꞌthúun a̱kia̱nꞌlaꞌ numuu dríga̱ꞌlaꞌ, numuu rí xúgíí rí i̱tha̱n máján rí ríga̱ ná mbaa Ejípto̱ ma̱ꞌne máꞌ dríga̱ꞌlaꞌ”».<verse eid="GEN 45:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 45:21" />Xkuaꞌnii nene̱ i̱ji̱i̱n Israél. Xómáꞌ José nixnúu̱ ixe̱ rí nu̱xma̱thaa guáyo̱, xómá nixná-ñájun Faraón, xúꞌkhue̱n máꞌ nixnúu̱ ganitsu rí mu̱phi̱i̱ ná jamba̱á mangaa. <verse eid="GEN 45:21" /><verse number="22" style="v" sid="GEN 45:22" />Mbámbáa̱ rí mbá xúgíi̱n nixnúu̱ mbámbá xa̱bi̱i̱ xtíin, xómáꞌ Benjamín nixnúu̱ mbá atsú siénto̱ mbúkha̱a̱ ajua̱nꞌ rí miꞌxá, jamí mbá witsu xa̱bi̱i̱ xtíin. <verse eid="GEN 45:22" /><verse number="23" style="v" sid="GEN 45:23" />Xómáꞌ inuu anu̱u̱ nixuꞌmee̱ ríge̱ꞌ: mbá gu̱wi̱inꞌ xtá-ngidi tsí jmba̱ꞌo̱ juda rí i̱tha̱n máján rí ríga̱ ná Ejípto̱, jamí mbá gu̱wi̱inꞌ xtá-ngidi tsí iꞌgú juda ixí iña, xúꞌkhue̱n máꞌ wopho jamí iꞌwá inii ganitsu rí me̱kho̱ anu̱u̱ ná jamba̱á. <verse eid="GEN 45:23" /><verse number="24" style="v" sid="GEN 45:24" />A̱ꞌkhue̱n rí José niꞌthán-ngawúún a̱ngui̱i̱n, jamí niꞌthúu̱n: «Ma̱xúꞌgua̱a̱ꞌ-lálaꞌ ra̱tsa̱ña̱ꞌlaꞌ ná jamba̱á».<verse eid="GEN 45:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 45:25" />A̱ꞌkhue̱n rí nigájnáa̱ ná Ejípto̱, jamí niguáꞌnúu̱ ná mbaa Kanaán, ná xtáa máꞌ anúu̱. <verse eid="GEN 45:25" /><verse number="26" style="v" sid="GEN 45:26" />A̱ꞌkhue̱n nitháa̱n ajngáa nuxe̱ꞌ: «Xtáa-lá xóó José ndaꞌya. Ikhaa̱ iꞌthán-nájuun mbá xúgíí mbaa Ejípto̱». Xómáꞌ Jakób mbá ni̱ka̱ a̱kui̱i̱n, numuu rí tsínembo̱o̱ꞌ rí nitháa̱n. <verse eid="GEN 45:26" /><verse number="27" style="v" sid="GEN 45:27" />Xómáꞌ ikhii̱n nitháa̱n mbá xúgíí ajngáa rí xóo niꞌthán José. Jamí ído̱ ndiꞌyoo Jakób ixe̱ rí kixmáthaa rí nixuꞌma José rí ma̱ꞌgee̱ ga̱jma̱á, a̱ꞌkhue̱n phú neꞌne gagi̱i̱ a̱kui̱i̱n. <verse eid="GEN 45:27" /><verse number="28" style="v" sid="GEN 45:28" />A̱ꞌkhue̱n niꞌthán Israél: «¡Máján, naꞌne jañii a̱kui̱nꞌ máꞌ! ¡A̱ꞌdéꞌ José xtáa ndaꞌya xóó! Ma̱ꞌgá gáyu̱u̱lo̱ꞌ rí inu máꞌ ma̱ja̱ñúꞌ».<verse eid="GEN 45:28" /></para>
  <chapter eid="GEN 45" />
  <chapter number="46" style="c" sid="GEN 46" />
  <para style="s">Jakób na̱ka̱ ná Ejípto̱</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1" />A̱ꞌkhue̱n rí nigájnuu Israél ga̱jma̱á mbá xúgíí rí gíꞌdoo̱, jamí ni̱ga̱níi̱ ná Beerséba̱. Ikhín nixnáxi̱i̱n xu̱kú tsi̱gi̱jia̱nꞌ inuu Ana̱ꞌlóꞌ tsí neꞌne-mba̱a̱ Isaák, mbo̱ anu̱u̱ máꞌ. <verse eid="GEN 46:1" /><verse number="2" style="v" sid="GEN 46:2" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ nindxákuun ga̱jma̱á Israél awúun xnuꞌndaa, jamí niꞌthúu̱n xáꞌnii:</para>
  <para style="p" vid="GEN 46:2">―Jakób, Jakób.</para>
  <para style="p" vid="GEN 46:2">Xómáꞌ ikhaa̱ niriꞌñee̱:</para>
  <para style="p" vid="GEN 46:2">―Ge̱e̱ xtáá na̱dxawaanꞌ.<verse eid="GEN 46:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 46:3" />A̱ꞌkhue̱n niꞌthúu̱n:</para>
  <para style="p" vid="GEN 46:3">―Ikhúúnꞌ ñaju̱nꞌ Táta̱ Mikhu, Anu̱u̱ ana̱a̱ꞌ. Ma̱xámíñaaꞌ rí mi̱dxu̱ꞌ ná Ejípto̱, numuu rí ikhín ma̱ne̱ rí ma̱nindxu̱ún xa̱bia̱a̱ꞌ mbá xuajen rí maphú mba̱a̱. <verse eid="GEN 46:3" /><verse number="4" style="v" sid="GEN 46:4" />Ikhúúnꞌ máꞌ ma̱ꞌgá ga̱jma̱á nindxa̱a̱ꞌ ná Ejípto̱, jamí ikhúúnꞌ máꞌ ma̱ne̱ rí ma̱tanga̱án mangaa, xúꞌkhue̱n máꞌ José ma̱rugua̱a̱ la idaaꞌ ído̱ gájáñaaꞌ.<verse eid="GEN 46:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 46:5" />A̱ꞌkhue̱n rí nigájnuu Jakób ná Beerséba̱. Xómáꞌ i̱ji̱i̱n nini̱i̱ rí ma̱tsimuu anúu̱ gajmíí máꞌ i̱jíi̱n, xúꞌkhue̱n máꞌ gu̱ꞌwíi̱n, ná ixe̱ rí kixmáthaa rí nixuꞌma Faraón rí magóo̱ ga̱jma̱á. <verse eid="GEN 46:5" /><verse number="6" style="v" sid="GEN 46:6" />Xúꞌkhue̱n máꞌ judii̱n xu̱kuíi̱n, jamí mbá xúgíí rí niguaꞌdáa̱ ná mbaa Kanaán. Xkuaꞌnii neꞌne rí Jakób gajmíí mbá xúgíin xa̱bi̱i̱ nigóó ná Ejípto̱. <figure style="fig" alt="Caravana grande, palmeras" file="CO00760B.TIF" size="span" ref="46.6">Na̱ka̱ Jakób gajmíí xúgíin xa̱bi̱i̱ ná Ejípto̱.</figure> <verse eid="GEN 46:6" /><verse number="7" style="v" sid="GEN 46:7" />Ni̱ka̱ jagu̱u̱n i̱ji̱i̱n ga̱jma̱á i̱jín-xíñii̱, xa̱bekha jamí go̱ꞌo̱, mbá xúgíin máꞌ tsí ni̱gu̱mii ná goꞌóo̱ ni̱ka̱ jagu̱u̱n ná Ejípto̱.<verse eid="GEN 46:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 46:8" />Ríge̱ꞌ ñajuun mbiꞌñúú i̱ji̱i̱n xa̱bo̱ Israél tsí ni̱tu̱ꞌúún ná Ejípto̱, tsí ñajuun máꞌ Jakób gajmíí i̱ji̱i̱n:</para>
  <para style="p" vid="GEN 46:8">Rubén ñajuun xa̱bo̱ ginii a̱dée Jakób. <verse eid="GEN 46:8" /><verse number="9" style="v" sid="GEN 46:9" />Tsí i̱ji̱i̱n Rubén: Anók, Falú, Esrón jamí Kármi̱.<verse eid="GEN 46:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 46:10" />Tsí i̱ji̱i̱n Simeón: Jemuél, Jamín, Oád, Jakín, Soár jamí Saúl, a̱dée nána̱ Kanaán.<verse eid="GEN 46:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 46:11" />Tsí i̱ji̱i̱n Lebí: Jersón, Koát jamí Merári̱.<verse eid="GEN 46:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 46:12" />Tsí i̱ji̱i̱n Judá: Ér, Onán, Séla̱, Fáre̱s jamí Sára̱. (I̱ndo̱ó tsí Ér ga̱jma̱á Onán nijáñúú ná mbaa Kanaán.) Jamí i̱ji̱i̱n Fáre̱s ñajúún Esrón jamí Amúl.<verse eid="GEN 46:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 46:13" />Tsí i̱ji̱i̱n Isakár: Tóla̱, Fúa̱, Jób jamí Simrón.<verse eid="GEN 46:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 46:14" />Tsí i̱ji̱i̱n Sabulón: Seréd, Elón jamí Jaleél.<verse eid="GEN 46:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 46:15" />Tsúꞌkhue̱n neꞌne ñajúún i̱ji̱i̱n Léa̱, tsí ni̱gi̱ꞌdii̱n ga̱jmáa̱ Jakób ná Padán-arám. Rí asndo a̱díi̱n Dína̱ tsí dxáꞌgú, naꞌne mbá skíñú gue̱tso̱ (33) i̱ji̱i̱n.<verse eid="GEN 46:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 46:16" />Tsí i̱ji̱i̱n Gád: Sifión, Ági̱, Esbón, Súni̱, Éri̱, Aródi̱ jamí Aréli̱.<verse eid="GEN 46:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 46:17" />Tsí i̱ji̱i̱n Asér: Ímna̱, Isúwa̱, Isúwi̱, Beríya̱ jamí Séra̱, tsí dxáguíi̱n máꞌ ikhii̱n. Tsí i̱ji̱i̱n Beríya̱: Ébe̱r jamí Malkiél.<verse eid="GEN 46:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 46:18" />Tsúꞌkhue̱n neꞌne ñajúún i̱ji̱i̱n Sílpa̱, yumbée máꞌ Léa̱ tsí nijanáa̱ neꞌne Labán. Rí mbá xúgíin i̱ji̱i̱n ga̱jmáa̱ Jakób naꞌne mbá gu̱wa̱ꞌ-nítsu i̱mbii̱n xa̱bo̱.<verse eid="GEN 46:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 46:19" />Tsí i̱ji̱i̱n Rakél, a̱ꞌgui̱i̱ máꞌ Jakób: José jamí Benjamín.<verse eid="GEN 46:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 46:20" />Ni̱gu̱mii i̱ji̱i̱n José ná mbaa Ejípto̱: Manasés ga̱jma̱á Efraín, tsí neꞌne ku̱mii Asenát, a̱dée Potífe̱ra̱, dxakuun mbo̱ Ón.<verse eid="GEN 46:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 46:21" />Tsí i̱ji̱i̱n Benjamín: Béla̱, Bekér, Asbél, Jéra̱, Naamán, Éi̱, Rós, Mupím, Upím jamí Árd.<verse eid="GEN 46:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 46:22" />Tsúꞌkhue̱n neꞌne ñajúún i̱ji̱i̱n Rakél, tsí ni̱gi̱ꞌdii̱n ga̱jmáa̱ Jakób, rí mbá xúgíi̱n mbá gue̱kho̱ xa̱bo̱.<verse eid="GEN 46:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 46:23" />Tsí a̱dée Dán: Usím.<verse eid="GEN 46:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 46:24" />Tsí i̱ji̱i̱n Neftalí: Jaseél, Gúni̱, Jesér jamí Silém.<verse eid="GEN 46:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 46:25" />Tsúꞌkhue̱n neꞌne ñajúún i̱ji̱i̱n Bíla̱, yumbée máꞌ Rakél tsí nijanáa̱ neꞌne Labán. Rí mbá xúgíin i̱ji̱i̱n ga̱jmáa̱ Jakób naꞌne mbá juiin xa̱bo̱.<verse eid="GEN 46:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 46:26" />Rí mbá xúgíin xa̱bo̱ tsí niguwá ga̱jma̱á nindxu̱u̱ Jakób ná Ejípto̱, tsí ri̱jiu̱u̱ꞌ máꞌ ikhaa̱, mbá atsú skíñú majuun (66) xa̱bo̱ ñajúu̱n, rí tsígi̱xnuu máꞌ gu̱ꞌwi̱ín i̱ji̱i̱n Jakób. <verse eid="GEN 46:26" /><verse number="27" style="v" sid="GEN 46:27" />Xómáꞌ i̱ji̱i̱n José, tsí ni̱gu̱mii ná Ejípto̱ a̱jmi̱i̱ xa̱bo̱ ñajúu̱n. Rí mbá xúgíin xa̱bo̱ ná goꞌóo Jakób, tsí ni̱tu̱ꞌúún ná Ejípto̱, mbá atsú skíñú gu̱wi̱inꞌ (70) ñajúu̱n.<verse eid="GEN 46:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28" />A̱ꞌkhue̱n rí Jakób nixuꞌmaa̱ ginii Judá ma̱ꞌga gáꞌthúun José rí ma̱ꞌgee̱ gágrui̱guíi̱ anu̱u̱ ná Gosén. A̱ꞌkhue̱n niguáꞌníi̱ máꞌ ná mbaa Gosén. <verse eid="GEN 46:28" /><verse number="29" style="v" sid="GEN 46:29" />Xómáꞌ José niꞌthán rí ma̱gu̱ma-mbáníí ixe̱ rí kixmáthaa rí ma̱ꞌgee̱ gágrui̱guíi̱ Israél ná mbaa Gosén. Ído̱ ndiꞌyoo̱ anu̱u̱, ndiyá-raꞌaa̱ jamí mba̱yo̱ꞌ ni̱mbi̱ye̱e̱ꞌ-rámuu̱ ná aphuu anu̱u̱. <figure style="fig" alt="José abraza a su padre" file="CO00753B.TIF" size="col" ref="46.29">José naxkama̱a̱ anu̱u̱.</figure> <verse eid="GEN 46:29" /><verse number="30" style="v" sid="GEN 46:30" />A̱ꞌkhue̱n rí Israél niꞌthúun José:</para>
  <para style="p" vid="GEN 46:30">―Ma̱goo máꞌ ma̱ja̱ñúꞌ xúge̱ꞌ rá, numuu rí nda̱yo̱o̱ máꞌ inaaꞌ, jamí nda̱yo̱o̱ rí xóó xtaa nathaya.<verse eid="GEN 46:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 46:31" />A̱ꞌkhue̱n rí José niꞌthúún dxíyo̱o̱, xúꞌkhue̱n máꞌ xa̱bo̱ goꞌóo anu̱u̱:</para>
  <para style="p" vid="GEN 46:31">―Ma̱ꞌgá gáthu̱u̱n Faraón: “Dxíyo̱ꞌ jamí xa̱bo̱ goꞌóo anu̱ꞌ, tsí nijúwa̱ꞌ ná mbaa Kanaán, niguáꞌníi̱ máꞌ rá. <verse eid="GEN 46:31" /><verse number="32" style="v" sid="GEN 46:32" />Ikhii̱n ñajúún waxtú tsí nu̱ña̱wu̱ún xu̱kú, xúꞌkhue̱n máꞌ judii̱n moguíi̱n jamí xedíi̱n, ga̱jma̱á mbá xúgíí rí kuaꞌdáa̱”. <verse eid="GEN 46:32" /><verse number="33" style="v" sid="GEN 46:33" />Jamí ído̱ Faraón mandxaꞌwálaꞌ rí maraxa̱ꞌlaꞌ: “Náá rí ñajun rí no̱ne̱laꞌ róꞌ”, <verse eid="GEN 46:33" /><verse number="34" style="v" sid="GEN 46:34" />a̱ꞌkhue̱n mu̱tháa̱nlaꞌ: “Xa̱bo̱ tsí nu̱ña̱wu̱ún xu̱kú ñajúún yumbiáaꞌ asndo nákhí makáa̱nꞌxo̱ꞌ jamí asndo máꞌ xúge̱ꞌ, xúꞌkhue̱n máꞌ ninindxu̱ún xíña-xi̱ꞌñáxo̱ꞌ mangiin”. A̱ꞌkhue̱n rí ma̱goo ma̱wanálaꞌ rí ma̱juwalaꞌ ná mbaa Gosén, numuu rí xa̱bo̱ Ejípto̱, tsíñúú-gúñúú mbá jayu mbo̱ waxtú.<verse eid="GEN 46:34" /></para>
  <chapter eid="GEN 46" />
  <chapter number="47" style="c" sid="GEN 47" />
  <para style="s">Jakób na̱ka̱ inuu Faraón</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 47:1" />A̱ꞌkhue̱n rí ni̱ka̱ José gágáꞌthúun Faraón:</para>
  <para style="p" vid="GEN 47:1">―Anu̱ꞌ jamí dxíyo̱ꞌ xúꞌkhue̱n máꞌ gajmíi̱ moguíi̱n jamí xedíi̱n, ga̱jma̱á mbá xúgíí rí kuaꞌdáa̱, niguwée̱ꞌ asndo ná mbaa Kanaán. Jamí niguáꞌníi̱ máꞌ xúge̱ꞌ ná mbaa Gosén rá.<verse eid="GEN 47:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 47:2" />Wapha máꞌ niraꞌwíi̱n mbá witsuun dxíyo̱o̱, ikhaa jngó tsúꞌkhue̱n ni̱ka̱ jagu̱u̱n inuu Faraón. <verse eid="GEN 47:2" /><verse number="3" style="v" sid="GEN 47:3" />A̱ꞌkhue̱n rí Faraón niraxúu̱n:</para>
  <para style="p" vid="GEN 47:3">―Náá rí ñajun rí no̱ne̱laꞌ róꞌ.</para>
  <para style="p" vid="GEN 47:3">Xómáꞌ ikhii̱n ni̱ri̱ꞌñaa̱:</para>
  <para style="p" vid="GEN 47:3">―Waxtú mogo̱ ñajúún yumbiáaꞌ, táta̱, xómáꞌ rí ninindxu̱ún xíña-xi̱ꞌñáxo̱ꞌ manguiin. <verse eid="GEN 47:3" /><verse number="4" style="v" sid="GEN 47:4" />―Nitháa̱n xóó Faraón―: Nagúwa̱ꞌxo̱ꞌ rí ma̱juwaxo̱ꞌ ná mbaa ríge̱ꞌ, numuu rí nda̱a̱ ni xí tháan ra̱xa̱ rí mo̱pho̱ xu̱kuíín yumbiáaꞌ, xúꞌkhue̱n máꞌ ewe rí phú gakhe̱ ri̱ga̱ ná mbaa Kanaán. Ikhaa jngó, phú nu̱tha̱n-jáñaaꞌxo̱ꞌ xúge̱ꞌ rí ma̱ta̱tsi̱ꞌñúú yumbiáaꞌ ma̱ju̱wá ná mbaa Gosén.<verse eid="GEN 47:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 47:5" />A̱ꞌkhue̱n Faraón niꞌthúun José:</para>
  <para style="p" vid="GEN 47:5">―Ana̱a̱ꞌ jamí a̱ngia̱a̱nꞌ niguwá ná xtaa xúge̱ꞌ, <verse eid="GEN 47:5" /><verse number="6" style="v" sid="GEN 47:6" />ikhaa jngó mbaa Ejípto̱ ri̱ga̱ máꞌ ná ñawáanꞌ ikháán. Ná rí i̱tha̱n máján, ikhín gátha̱ne̱ rí ma̱xtáa ana̱a̱ꞌ jamí a̱ngia̱a̱nꞌ. Ga̱ju̱wée̱ꞌ máꞌ ná mbaa Gosén rámá. Jamí xí nathayáá rí júwá xa̱bo̱ tsí na̱ma̱ñúú none̱ ñajun, ataskuíji̱i̱n rí mu̱ña̱wúu̱n tháan xu̱kuíꞌ mangúún.<verse eid="GEN 47:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 47:7" />Xúꞌkhue̱n máꞌ mangaa, José ni̱ka̱ jayáa̱ anu̱u̱ inuu Faraón. Xómáꞌ Jakób niraxi̱i̱ ga̱jma̱á gamaku. <figure style="fig" alt="Jacob, Jose ante Faraón" file="CO00757B.TIF" size="span" ref="47.7">José na̱ka̱ jayáa anu̱u̱ ná inuu Faraón.</figure> <verse eid="GEN 47:7" /><verse number="8" style="v" sid="GEN 47:8" />A̱ꞌkhue̱n Faraón niraxu̱u̱ Jakób:</para>
  <para style="p" vid="GEN 47:8">―Nguátha̱ tsiguaaꞌ róꞌ, táta̱.<verse eid="GEN 47:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 47:9" />A̱ꞌkhue̱n Jakób niriꞌña̱a̱ ajngóo Faraón:</para>
  <para style="p" vid="GEN 47:9">―Tsigu rí xtáá-rangroꞌo̱ꞌ ñajuun mbá majuun skíñú gu̱wa̱ꞌ (130) tsigu. Phú ra̱mbáa jamí ra̱máján wáa mbiꞌi rí nixtáá, jamí xóó tséꞌngo̱ꞌ ma̱jrúꞌúún tsigu rí xóo nigóó-rajúwa̱ꞌ xi̱ꞌñúꞌ wajiúú.<verse eid="GEN 47:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 47:10" />Nda̱wa̱á a̱ꞌkhue̱n Jakób niꞌthán-ngawoo Faraón ga̱jma̱á gamaku, a̱ꞌkhue̱n nigájna̱a̱ ni̱ka̱a̱. <verse eid="GEN 47:10" /><verse number="11" style="v" sid="GEN 47:11" />Xkuaꞌnii jngó José neꞌne rí ma̱ri̱gá ná ma̱xtáa anu̱u̱ jamí a̱ngui̱i̱n. Nixnúu̱ máꞌ mbaa rí ma̱ꞌne mbañúu̱ ná rí ma̱ju̱wée̱ꞌ ná Ejípto̱, rí i̱tha̱n máján ná Ramesés, xómáꞌ nixná-ñájun Faraón. <verse eid="GEN 47:11" /><verse number="12" style="v" sid="GEN 47:12" />Xómáꞌ José naxnúu ganitsu anu̱u̱ jamí a̱ngui̱i̱n, mbá xúgíin máꞌ xa̱bo̱ ná goꞌóo anu̱u̱, mbá xóo rí kíxnuu máꞌ i̱jíi̱n.<verse eid="GEN 47:12" /></para>
  <para style="s">José i̱ngu̱jua̱ rí mo̱pho̱ xa̱bo̱</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13" />Nda̱a̱ xí tháan ganitsu mbá xúgíí numbaa rúꞌkhue̱n, jamí ewe phú gakhe̱ ri̱ga̱. Ná Ejípto̱ ga̱jma̱á mbaa Kanaán phú níꞌngu̱ún xa̱bo̱ rí na̱xki̱dxu̱ún. <verse eid="GEN 47:13" /><verse number="14" style="v" sid="GEN 47:14" />Xómáꞌ José neꞌne ꞌnduu̱ꞌ mbá xúgíí mbúkha̱a̱ rí ríga̱ ná mbaa Ejípto̱ jamí Kanaán, ga̱jma̱á numuu ganitsu rí nune̱-numáa̱. A̱ꞌkhue̱n ni̱gu̱xi̱i̱ mbúkha̱a̱ rúꞌkhue̱n ná goꞌóo Faraón. <verse eid="GEN 47:14" /><verse number="15" style="v" sid="GEN 47:15" />Ído̱ wámba̱ mbúkha̱a̱ ná mbaa Ejípto̱ jamí Kanaán rá, a̱ꞌkhue̱n niguwá mbá xúgíin xa̱bo̱ Ejípto̱ inuu José, jamí nitháa̱n:</para>
  <para style="p" vid="GEN 47:15">―Araxnáxo̱ꞌ tháan rí mo̱phóxo̱ꞌ. Á numuu rí nánguá mbúkha̱ꞌxo̱ꞌ jngó ma̱tha̱tsi̱ꞌñáxo̱ꞌ rí ma̱ja̱ñáxo̱ꞌ rá dxe̱ꞌ.<verse eid="GEN 47:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 47:16" />A̱ꞌkhue̱n niriꞌña̱a̱ José ajngúu̱n:</para>
  <para style="p" vid="GEN 47:16">―Xí wámba̱ mbúkha̱ꞌlaꞌ, gu̱xni̱i̱laꞌ xu̱kiálaꞌ. Xómáꞌ ikhúúnꞌ ma̱riꞌkhu-raꞌa ganitsu ga̱jma̱á numúu̱.<verse eid="GEN 47:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 47:17" />A̱ꞌkhue̱n niguwée̱ꞌ judii̱n xu̱kuíi̱n inuu José. Xómáꞌ José niriꞌkhu-raꞌa ganitsu ga̱jma̱á numúú guáyo̱, mogo̱, xede̱ ga̱jma̱á xtá-ngidi. Xkuaꞌnii neꞌne José rí nixnúu̱ rí mo̱pho̱ xa̱bo̱ jañii tsigu rúꞌkhue̱n ga̱jma̱á numúú xu̱kuíi̱n. <verse eid="GEN 47:17" /><verse number="18" style="v" sid="GEN 47:18" />Ído̱ ninújngoo tsigu rúꞌkhue̱n, niguwée̱ꞌ gútháa̱n José tsigu rí riajmu̱u̱:</para>
  <para style="p" vid="GEN 47:18">―Tsírkaꞌwííxo̱ꞌ inaaꞌ, táta̱. Wámba̱ mbúkha̱ꞌxo̱ꞌ, jamí xúgíin tsí ñajúún xu̱kiáxo̱ꞌ júwa̱ꞌ máꞌ ná ñawáanꞌ ikháán. Ná-nda̱a̱ nitháan rí mu̱xna̱a̱ꞌxo̱ꞌ rá, táta̱, i̱ndo̱ó mbá xóo rí ikháa̱nꞌxo̱ꞌ jamí mbayaxo̱ꞌ. <verse eid="GEN 47:18" /><verse number="19" style="v" sid="GEN 47:19" />Nda̱a̱-lá numuu jngó ma̱ta̱tsi̱ꞌñáá rí ma̱ja̱ñáxo̱ꞌ jamí ma̱ꞌne chúu mbayaxo̱ꞌ rá. Aratsiáa̱nꞌxo̱ꞌ xúꞌkhue̱n máꞌ mbayaxo̱ꞌ, ga̱jma̱á numuu rí ma̱ra̱xna̱ꞌxo̱ꞌ ganitsu. A̱ꞌkhue̱n rí ma̱nindxa̱ꞌxo̱ꞌ yumbée Faraón xúꞌkhue̱n máꞌ mbayaxo̱ꞌ. Araxnáxo̱ꞌ rí mu̱dúu̱xo̱ꞌ, ikhaa jngó ma̱xájáñaxo̱ꞌ, ni máꞌ ma̱xáwanúu chúu mbayaxo̱ꞌ.<verse eid="GEN 47:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 47:20" />A̱ꞌkhue̱n rí José neꞌtse̱ mbá xúgíí mbaa ná Ejípto̱, rí ma̱ꞌne mbayuu Faraón. Mbámbáa máꞌ xa̱bo̱ Ejípto̱ ni̱ngu̱jua̱ mbayuu, numuu rí ewe phú gakhe̱ iꞌñúu̱. Xkuaꞌnii neꞌne jngó mbañúu̱ ninújnga̱a̱ꞌ ñawúun Faraón. <verse eid="GEN 47:20" /><verse number="21" style="v" sid="GEN 47:21" />A̱ꞌkhue̱n rí mbá jndi rawuun numbaa Ejípto̱ wa̱tsu̱diin xa̱bo̱ rí ma̱guwáa̱nꞌ ná xuajen mba̱ꞌo̱.<note caller="+" style="f"><char style="fr" closed="false">47.21 </char><char style="ft" closed="false">Ríga̱ iꞌwá i̱yi̱i̱ꞌ ebréo̱ rí wayuu ná naꞌthán «mbá xúgíin xa̱bo̱ ninindxu̱ún yumbáá».</char></note> <verse eid="GEN 47:21" /><verse number="22" style="v" sid="GEN 47:22" />I̱ndo̱ó mbañúú dxakuun táꞌtsi̱i̱. Numuu rí tsí dxakuun najanúú máꞌ rí naꞌpho̱ eꞌne Faraón, ikhaa jngó táꞌñúu̱ rí ma̱ngo̱jue̱e̱ mbañúu̱.<verse eid="GEN 47:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 47:23" />A̱ꞌkhue̱n rí José niꞌthúún xa̱bo̱ xuajen:</para>
  <para style="p" vid="GEN 47:23">―Ndu̱yáá-málaꞌ xúge̱ꞌ rá, ni̱tsiáa̱nꞌlaꞌ ikháa̱nꞌlaꞌ jamí mbayalaꞌ, rí ma̱nindxa̱ꞌlaꞌ drígo̱o̱ Faraón. Ge̱jioꞌ ríga̱ tsíga rá. A̱gu̱duu̱laꞌ ne̱ inuu ju̱ba̱ꞌ. <verse eid="GEN 47:23" /><verse number="24" style="v" sid="GEN 47:24" />Ído̱ gájma̱a̱ rí mu̱dulaꞌ, mu̱xna̱xíi̱laꞌ magu̱u̱ Faraón mbóó awúun rí mbámbá witsu rí najma̱a̱. Rí i̱mba̱á akho̱ ma̱ꞌne rí mi̱ꞌduu̱ inuu ju̱ba̱ꞌ, jamí rí mo̱pholaꞌ ikháa̱nꞌlaꞌ, jamí xa̱bia̱ꞌlaꞌ, xúꞌkhue̱n máꞌ i̱jia̱nꞌlaꞌ.<verse eid="GEN 47:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 47:25" />A̱ꞌkhue̱n rí ikhii̱n ni̱ri̱ꞌñaa̱:</para>
  <para style="p" vid="GEN 47:25">―Phú máján a̱kia̱a̱nꞌ rí nithane̱-jáwiáa̱nꞌxo̱ꞌ, táta̱. Ga̱nindxa̱ꞌ máxo̱ꞌ yumbée Faraón rámá.<verse eid="GEN 47:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 47:26" />A̱ꞌkhue̱n rí José niꞌgí nakhúu xtángoo rí ri̱ga̱ máꞌ asndo xúge̱ꞌ ná mbaa Ejípto̱, rí naꞌthée̱n rí ma̱grui̱gúu̱ Faraón mbóó awúun rí mbámbá witsu rí najma̱a̱. I̱ndo̱ó ná mbañúú dxakuun tsígrui̱gúu̱ ne̱, numuu rí táꞌne máꞌ mbayuu Faraón.<verse eid="GEN 47:26" /></para>
  <para style="s">Jakób na̱nda̱ꞌa̱ rí ma̱xíꞌdi̱i ná Ejípto̱</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27" />A̱ꞌkhue̱n rí xa̱bo̱ Israél nijúwá máꞌ ná mbayuu Ejípto̱, ná mbaa Gosén. Ikhín máꞌ neꞌne mbañúu̱, xúꞌkhue̱n máꞌ phú ni̱mi̱diúu̱n neꞌne mbaꞌii̱n mi̱ndaꞌkho. <verse eid="GEN 47:27" /><verse number="28" style="v" sid="GEN 47:28" />Jakób nixtáa ná mbaa Ejípto̱ mbá gu̱wa̱ꞌ-nítsu i̱jma̱ tsigu. Jamí xúgíí tsigu rí nixtáa Jakób neꞌne mbá juan skíñú i̱jua̱n (147) tsigu. <verse eid="GEN 47:28" /><verse number="29" style="v" sid="GEN 47:29" />Jamí ído̱ nangiyuu máꞌ mbiꞌi rí ma̱ja̱ñúu Israél, a̱ꞌkhue̱n nindxaꞌwóo̱ José, jamí niꞌthúu̱n:</para>
  <para style="p" vid="GEN 47:29">―Xí rí phú naꞌne a̱kia̱a̱nꞌ xtayo̱ꞌ, na̱tha̱n-jáñaaꞌ rí ma̱tha̱gída̱ꞌ tháan ñawáanꞌ ná agoo sndi̱yu̱ꞌ ge̱e̱, jamí ma̱ta̱xu̱ꞌdá-mina̱ꞌ rí ma̱tha̱ne̱ rí ma̱tha̱a̱nꞌ. Phú na̱nda̱ꞌa̱a̱ꞌ rí ma̱xátha̱dúu̱n ná Ejípto̱. <verse eid="GEN 47:29" /><verse number="30" style="v" sid="GEN 47:30" />Ído̱ ma̱ja̱ñúꞌlo̱ꞌ rí ma̱mba̱xíi̱ꞌ gajmíꞌ wa̱jen a̱ngui̱nꞌ, ma̱tríñu̱ú ná Ejípto̱, jamí ma̱tha̱dúu̱n ná iñá-wa̱jiúu̱n máꞌ ikhii̱n.</para>
  <para style="p" vid="GEN 47:30">A̱ꞌkhue̱n niriꞌña̱a̱ José:</para>
  <para style="p" vid="GEN 47:30">―Ma̱ne̱ mbá xóo rí narathán máꞌ, táa̱.<verse eid="GEN 47:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 47:31" />A̱ꞌkhue̱n rí Israél niꞌthán:</para>
  <para style="p" vid="GEN 47:31">―Ataxúda-mina̱ꞌ.</para>
  <para style="p" vid="GEN 47:31">Xómáꞌ José nixuda-mina̱ꞌ. A̱ꞌkhue̱n rí Israél ni̱rnga̱du̱u̱n ná idxu̱u̱ xi̱yawoo̱, rí neꞌne-mba̱a̱ Ana̱ꞌlóꞌ.<verse eid="GEN 47:31" /></para>
  <chapter eid="GEN 47" />
  <chapter number="48" style="c" sid="GEN 48" />
  <para style="s">Jakób naꞌne tsakun-rámii i̱ji̱i̱n José</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1" />Nda̱wa̱á rí ninújngoo máꞌ mbiꞌi rúꞌkhue̱n waꞌtháán José: «Najáñuu ana̱a̱ꞌ». A̱ꞌkhue̱n rí ni̱ke̱e̱ gáꞌyoo̱ anu̱u̱ gajmíi̱ ná-a̱jmi̱i̱ i̱ji̱i̱n, Manasés ga̱jma̱á Efraín. <verse eid="GEN 48:1" /><verse number="2" style="v" sid="GEN 48:2" />A̱ꞌkhue̱n waꞌtháán Jakób: «Na̱ꞌkha̱ a̱ꞌdeáaꞌ José gáꞌyaaꞌ». A̱ꞌkhue̱n rí Israél neꞌne tsiakhe̱-mina̱ꞌ rí ma̱ge̱ꞌe̱ ná xi̱yawoo̱. <verse eid="GEN 48:2" /><verse number="3" style="v" sid="GEN 48:3" />A̱ꞌkhue̱n waꞌtháán José neꞌne anu̱u̱:</para>
  <para style="p" vid="GEN 48:3">―Ana̱ꞌlóꞌ tsí Gíꞌdoo Xúgíí Tsiakhe̱ nikujmaa inu̱ꞌ ná xuajen Lús ná mbaa Kanaán, jamí neꞌne tsakun-rámúu̱. <verse eid="GEN 48:3" /><verse number="4" style="v" sid="GEN 48:4" />Xúꞌkhue̱n máꞌ nixuda-mine̱e̱ꞌ rí niꞌthínꞌ xáꞌnii: “Rí xúge̱ꞌ rá, ma̱ne̱ rí ma̱ꞌne mbaꞌiin i̱jia̱a̱nꞌ jamí ma̱ne̱ rí ma̱mi̱diúún mi̱ndaꞌkho xa̱bia̱a̱ꞌ, jamí ma̱nindxa̱a̱ꞌ idxu̱ún mbaꞌa xuajen mba̱ꞌo̱. Xúꞌkhue̱n máꞌ ma̱xnúú mbaa ríge̱ꞌ i̱jia̱a̱nꞌ tsí ma̱guwá nda̱wa̱á, ma̱ꞌne drígúu̱n ne̱ mbá jámuu mbiꞌi”. <verse eid="GEN 48:4" /><verse number="5" style="v" sid="GEN 48:5" />Ikhaa jngó xúge̱ꞌ rá, i̱jia̱a̱nꞌ tsí a̱jmi̱i̱ tsí ni̱gu̱mii ge̱e̱, nákhí xóó táꞌkha gáya̱a̱ꞌ ná Ejípto̱, Efraín ga̱jma̱á Manasés, ma̱nindxúu̱n máꞌ i̱ji̱nꞌ ikhúúnꞌ rá, xómá rí i̱ji̱nꞌ Rubén ga̱jma̱á Simeón. <verse eid="GEN 48:5" /><verse number="6" style="v" sid="GEN 48:6" />Xómáꞌ i̱jia̱a̱nꞌ tsí ma̱ra̱ꞌdiin nda̱wa̱á, tsúꞌkhue̱n ma̱ꞌnii̱ i̱jia̱a̱nꞌ jmína̱á ikháán. I̱ndo̱ó ga̱jma̱á numúú máꞌ dxájúu̱n ma̱ri̱dúu̱n mbaa mangii̱n. <verse eid="GEN 48:6" /><verse number="7" style="v" sid="GEN 48:7" />Numuu rí nákhí nigájna̱a̱ꞌ ná Padán-arám, nijáñu-jáꞌyéꞌ ru̱dáaꞌ Rakél ná jamba̱á ná mbayuu máꞌ Kanaán, ná mijngi ꞌgí Efráta̱. Ikhín máꞌ ni̱dii̱ ná rawuun jambo̱o̱ Efráta̱, rí mbiꞌyuu Belén.<verse eid="GEN 48:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 48:8" />Ído̱ rí Israél ndiꞌñúú i̱ji̱i̱n José, a̱ꞌkhue̱n niraxi̱i̱:</para>
  <para style="p" vid="GEN 48:8">―Tsíin e̱je̱n ñajúún tsíge̱ꞌ róꞌ.<verse eid="GEN 48:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 48:9" />A̱ꞌkhue̱n José niriꞌña̱a̱ ajngóo anu̱u̱:</para>
  <para style="p" vid="GEN 48:9">―I̱ji̱nꞌ ikhúúnꞌ ñajúu̱n, tsí nixníꞌ Ana̱ꞌlóꞌ ná ge̱e̱.</para>
  <para style="p" vid="GEN 48:9">A̱ꞌkhue̱n rí Israél niꞌthán:</para>
  <para style="p" vid="GEN 48:9">―Ataxúꞌmii̱ tháan ná inu̱ꞌ ge̱e̱, jngó ma̱ne̱ tsakun-rámii̱lo̱ꞌ.<verse eid="GEN 48:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 48:10" />Numuu rí xi̱ꞌñú guéño máꞌ ñajuun Israél, aguu iduu̱ níꞌngo̱o̱ rí mayaxi̱i̱. Ikhaa jngó José nixuꞌmii i̱ji̱i̱n mijngi ná inuu anu̱u̱, xómáꞌ ikhaa̱ niraꞌnuu̱ inúú jamí nigo̱-raꞌii̱n. <verse eid="GEN 48:10" /><verse number="11" style="v" sid="GEN 48:11" />Xómáꞌ Israél niꞌthúun José:</para>
  <para style="p" vid="GEN 48:11">―Táju̱mu̱ꞌ xí xóó mba̱yo̱o̱ inaaꞌ, jamí xúge̱ꞌ rá, Ana̱ꞌlóꞌ naꞌne rí mba̱ñúú asndo mangiin i̱jia̱a̱nꞌ.<verse eid="GEN 48:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 48:12" />A̱ꞌkhue̱n rí José ni̱gu̱wíi̱n i̱ji̱i̱n ná iduu nakhúu anu̱u̱, jamí nismáti̱go̱o̱ rí niꞌgíi̱ inuu̱ asndo mbayíí. <verse eid="GEN 48:12" /><verse number="13" style="v" sid="GEN 48:13" />A̱ꞌkhue̱n rí José nigu̱u̱n ná-a̱jmi̱i̱ máꞌ i̱ji̱i̱n, Efraín ná ñawún mújúu̱n, rí ma̱we̱je̱ ná ñawún xti̱yu̱u̱ꞌ Israél, jamí Manasés ñawún xti̱yu̱u̱ꞌ, rí ma̱we̱je̱ ná ñawún mújúun Israél. A̱ꞌkhue̱n rí nixuꞌmii̱ inuu anu̱u̱. <verse eid="GEN 48:13" /><verse number="14" style="v" sid="GEN 48:14" />Xómáꞌ Israél ja rá, nitsriya̱ꞌ ñawún mújúun, jamí nirígui̱ ná idxu̱u̱ Efraín, tsí lájuíin. Jamí ñawún xti̱yu̱u̱ꞌ nirígui̱ ná idxu̱u̱ Manasés. Xkuaꞌnii nikriꞌkhuíi̱n ñawúu̱n, maske máꞌ Manasés ñajuun xa̱bo̱ ginii. <verse eid="GEN 48:14" /><verse number="15" style="v" sid="GEN 48:15" />A̱ꞌkhue̱n rí neꞌne tsakun-rámaa̱ José rí niꞌthée̱n ajngáa ríge̱ꞌ:</para>
  <para style="q" vid="GEN 48:15">«Ikhaa Ana̱ꞌlóꞌ tsí ningrigo̱o̱ ga̱jma̱á xi̱ꞌñúꞌ Abraám,</para>
  <para style="q" vid="GEN 48:15">xúꞌkhue̱n máꞌ ga̱jma̱á anu̱ꞌ Isaák,</para>
  <para style="q" vid="GEN 48:15">ikhaa máꞌ tsí ni̱ña̱wi̱nꞌ,</para>
  <para style="q" vid="GEN 48:15">asndo nákhí rí ni̱gu̱múú asndo máꞌ mbiꞌi xúge̱ꞌ,<verse eid="GEN 48:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="GEN 48:16" />ikhaa máꞌ Ánje̱l tsí naꞌne-jríñu̱ú mbá xúgíí rí ra̱máján,</para>
  <para style="q" vid="GEN 48:16">Ana̱ꞌlóꞌ tsúꞌkhue̱n gáꞌne tsakun-rámii jiáma tsíge̱ꞌ.</para>
  <para style="q" vid="GEN 48:16">Ga̱jma̱á nindxúu̱n ikhii̱n ma̱xándáti̱ga̱ jámuu mbiꞌyu̱ꞌ,</para>
  <para style="q" vid="GEN 48:16">ni máꞌ mbiꞌyuu anu̱ꞌ Abraám jamí Isaák.</para>
  <para style="q" vid="GEN 48:16">A̱gu̱mii mi̱ndaꞌkho i̱jíi̱n, jamí ga̱ju̱wée̱ꞌ ná inuu numbaa».<verse eid="GEN 48:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 48:17" />Ído̱ ndiꞌyoo José rí anu̱u̱ nirígu ñawún mújúun ná idxu̱u̱ Efraín, táni̱gu̱u̱ꞌ rúꞌkhue̱n. Jngó niguatuu̱n ñawúun anu̱u̱ ná idxu̱u̱ Efraín rí marígu̱u̱ ná idxu̱u̱ Manasés. <verse eid="GEN 48:17" /><verse number="18" style="v" sid="GEN 48:18" />A̱ꞌkhue̱n iꞌthúu̱n anu̱u̱:</para>
  <para style="p" vid="GEN 48:18">―Ra̱ꞌkhá xkuaꞌnii, táa̱. Atrígu ñawún májáanꞌ ná idxu̱u̱ tsíge̱ꞌ. Ikhaa̱ ñajuun phú xa̱bo̱ ginii.<verse eid="GEN 48:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 48:19" />Xómáꞌ anu̱u̱ ra̱khóo, jamí niꞌthée̱n:</para>
  <para style="p" vid="GEN 48:19">―Nda̱yo̱o̱-málo̱ꞌ, táa̱. Nda̱yo̱o̱ máꞌ rí mangaa̱ ma̱nindxu̱u̱ mbá xuajen rí phú ma̱gi̱ꞌdoo numuu. I̱ndo̱ó numuu rí ge̱ꞌthe̱e̱ i̱tha̱n ma̱gi̱ꞌdoo numuu xóo rí ikhaa̱, jamí xa̱bi̱i̱ mone̱-mi̱jna̱ mbaꞌa xuajen mba̱ꞌo̱.<verse eid="GEN 48:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 48:20" />A̱ꞌkhue̱n rí ikhaa máꞌ mbiꞌi rúꞌkhue̱n Israél neꞌne tsakun-rámii̱, rí niꞌthée̱n ajngáa ríge̱ꞌ: «Ga̱jma̱á mbiꞌyalaꞌ mone̱ tsakun-ráma-mi̱jna̱ i̱ji̱i̱n Israél. Xáꞌnii góthée̱n: “Ana̱ꞌlóꞌ gáꞌne tsakun-rámáá xóo rí niꞌñúu̱ Efraín ga̱jma̱á Manasés”». Xkuaꞌnii nitsijii̱ Efraín ginii inuu Manasés.<verse eid="GEN 48:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 48:21" />A̱ꞌkhue̱n Israél niꞌthúun José:</para>
  <para style="p" vid="GEN 48:21">―Ikhúúnꞌ xtáá rí ma̱ja̱ñúꞌ xúge̱ꞌ rá. I̱ndo̱ó máꞌ Ana̱ꞌlóꞌ ma̱xtáa ga̱jma̱á nindxa̱ꞌlaꞌ, jamí ma̱ꞌnii̱ rí ma̱tangáa̱nꞌlaꞌ ná mbañúú xi̱ꞌñálaꞌ. <verse eid="GEN 48:21" /><verse number="22" style="v" sid="GEN 48:22" />Jamí ikhúúnꞌ na̱xna̱a̱ꞌ i̱tháan mba̱a̱ xó rí ni̱dri̱gú dxíya̱a̱ꞌ, ikhaa bríjniúu júba̱<note caller="+" style="f"><char style="fr" closed="false">48.22 </char><char style="ft" closed="false">Ná ajngáa ebréo̱, ajngáa rí «sikém» naxná ju̱ma̱ rí «i̱tháan mba̱a̱», jamí xúꞌkhue̱n máꞌ naxná ju̱ma̱ rí «bríjniúu júba̱» mangaa.</char></note> rí ni̱rígúlo̱ꞌ ná ñawúún mbo̱ amorréo̱ ga̱jma̱á chídiu̱ꞌ jamí ga̱jma̱á xkamídúꞌ.<verse eid="GEN 48:22" /></para>
  <chapter eid="GEN 48" />
  <chapter number="49" style="c" sid="GEN 49" />
  <para style="s">Jakób naꞌthúún i̱ji̱i̱n rí ma̱ri̱gá ga̱jma̱á numúú</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1" />A̱ꞌkhue̱n rí Jakób nindxaꞌúún i̱ji̱i̱n, jamí niꞌthúu̱n: «A̱ru̱wa-mi̱jna̱a̱laꞌ, jamí ma̱tha̱nꞌlaꞌ rí ma̱ri̱gá ga̱jma̱á numalaꞌ mbiꞌi rí inúú ge̱e̱.<verse eid="GEN 49:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="GEN 49:2" />»A̱ru̱wa-mi̱jna̱a̱laꞌ rí mu̱dxawíínlaꞌ, i̱ji̱i̱n Jakób.</para>
  <para style="q" vid="GEN 49:2">A̱gu̱dxawíínlaꞌ rí maꞌthán ana̱ꞌlaꞌ Israél.<verse eid="GEN 49:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="GEN 49:3" />»Rubén, ikháán ñajuaanꞌ a̱ꞌdéꞌ tsí phú ginii,</para>
  <para style="q" vid="GEN 49:3">ski̱yu̱ꞌ rí ginii jayu ñajuaanꞌ,</para>
  <para style="q" vid="GEN 49:3">gamaku jamí tsiakhe̱ ginii ñajuaanꞌ.<verse eid="GEN 49:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="GEN 49:4" />Phú nacha̱a̱ꞌ xóo iya-mbo̱o̱ꞌ,</para>
  <para style="q" vid="GEN 49:4">ikhaa jngó ná-xánindxa̱a̱ꞌ xa̱bo̱ ginii rá.</para>
  <para style="q" vid="GEN 49:4">Numuu rí nitatsimaaꞌ ná xi̱yawoo ana̱a̱ꞌ,</para>
  <para style="q" vid="GEN 49:4">jamí nithane̱ rí xkawe̱ꞌ ído̱ nitabáaꞌ ná xi̱yawo̱ꞌ.<verse eid="GEN 49:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="GEN 49:5" />»Simeón ga̱jma̱á Lebí mba̱wí-ikhúúnꞌ ñajúún,</para>
  <para style="q" vid="GEN 49:5">ajua̱nꞌ rí naꞌne gamíjun ñajuun chídíi̱n.<verse eid="GEN 49:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="GEN 49:6" />Ma̱xáxtáá ná awúun rí nuthan-mi̱jne̱e̱,</para>
  <para style="q" vid="GEN 49:6">ni máꞌ ma̱xámbáxu̱ꞌ gajmíꞌ.</para>
  <para style="q" vid="GEN 49:6">Numuu rí awúun rí najiꞌníi̱ niradíi̱n xa̱bo̱,</para>
  <para style="q" vid="GEN 49:6">jamí támíñúu̱ rí ni̱ru̱thii̱n nítú ruꞌúún xede̱.<verse eid="GEN 49:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="GEN 49:7" />Mbóó ra̱máján rí najiꞌníi̱ guéño,</para>
  <para style="q" vid="GEN 49:7">jamí rí namanguu̱nꞌ gakhe̱.</para>
  <para style="q" vid="GEN 49:7">Ikhúúnꞌ ma̱ra̱khún-wájíi̱n inuu mbayuu Jakób,</para>
  <para style="q" vid="GEN 49:7">jamí ma̱ne̱ rí ma̱drúꞌúu̱n inúú xa̱bi̱i̱ Israél.<verse eid="GEN 49:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="GEN 49:8" />»Ikháán, Judá, muthan máján numaaꞌ a̱ngia̱a̱nꞌ.</para>
  <para style="q" vid="GEN 49:8">Numuu rí na̱ꞌnga̱a̱ꞌ inúú xa̱bo̱ sia̱a̱nꞌ,</para>
  <para style="q" vid="GEN 49:8">ikhaa jngó i̱ji̱i̱n ana̱a̱ꞌ mu̱sma̱ti̱gu̱ún inaaꞌ.<verse eid="GEN 49:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="GEN 49:9" />Xóo a̱ꞌdá-i̱ndi̱í jaꞌnii a̱ꞌdéꞌ Judá ja.</para>
  <para style="q" vid="GEN 49:9">Wámbo̱o̱ niꞌkhu̱u̱ xu̱kú tsí nirtuwii̱n,</para>
  <para style="q" vid="GEN 49:9">ni̱rnga̱du̱ꞌ-mine̱e̱ꞌ, nibóo̱ꞌ asndo xóo i̱ndi̱í,</para>
  <para style="q" vid="GEN 49:9">asndo xóo jaꞌnii eꞌne i̱ndi̱í e̱jmba̱a̱.</para>
  <para style="q" vid="GEN 49:9">Tsáa-lá gáꞌne gajmúu̱ ja rá.<verse eid="GEN 49:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="GEN 49:10" />Ma̱xága̱taa̱ ixe̱-mixú ñawúun Judá,</para>
  <para style="q" vid="GEN 49:10">ni máꞌ ma̱xágájnuu ne̱ ná nakhúu̱,</para>
  <para style="q" vid="GEN 49:10">asndo gáꞌkha̱ tsí phú drígo̱o̱ ne̱,</para>
  <para style="q" vid="GEN 49:10">ikhaa tsí ma̱nimbu̱ún xa̱bo̱ xuajen juyáá.<verse eid="GEN 49:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="GEN 49:11" />Ná ajmu̱u̱ úba̱ iroꞌóo Judá xtá-ngidiuu,</para>
  <para style="q" vid="GEN 49:11">xúꞌkhue̱n máꞌ naroꞌóo̱ a̱dée xtá-ngidi ná nakhúu ixu̱u̱ úba̱.</para>
  <para style="q" vid="GEN 49:11">Naꞌjiáa̱n xtíñuu̱ ga̱jma̱á iyoo úba̱,</para>
  <para style="q" vid="GEN 49:11">xúꞌkhue̱n máꞌ naꞌjiáa̱n xtátso̱n aphu ná iꞌdiuu xndú úba̱.<verse eid="GEN 49:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="GEN 49:12" />Rí iduu̱, maña̱ꞌ skuni xóo iyoo xndú úba̱,</para>
  <para style="q" vid="GEN 49:12">xúꞌkhue̱n máꞌ iñuu̱, miꞌxá asndo xóo yaꞌdú.<verse eid="GEN 49:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="GEN 49:13" />»Sabulón ma̱xtáa ná rawuun iya a̱pha̱,</para>
  <para style="q" vid="GEN 49:13">jamí ná rí ma̱guáꞌnú rguwa rí na̱ka̱ inuu iya,</para>
  <para style="q" vid="GEN 49:13">xúꞌkhue̱n máꞌ ndawoo̱ ma̱ꞌne asndo ná Sidón.<verse eid="GEN 49:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="GEN 49:14" />»Isakár, ñajuun xóo mbáa xtá-ngidi gúkuíi,</para>
  <para style="q" vid="GEN 49:14">tsí na̱ka̱-rabóo ná na̱gi̱mbúun xu̱kú.<verse eid="GEN 49:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="GEN 49:15" />Mba̱ꞌyoo̱ rí máján rí mbayáa̱ xu̱u̱ꞌ,</para>
  <para style="q" vid="GEN 49:15">xúꞌkhue̱n máꞌ mba̱ꞌyoo̱ rí phú mitsaan mbaa.</para>
  <para style="q" vid="GEN 49:15">Ma̱rnga̱du̱u̱nꞌ rí magui̱i̱ eꞌda rí je̱ño̱,</para>
  <para style="q" vid="GEN 49:15">xúꞌkhue̱n máꞌ ma̱nindxu̱u̱ mbáa yumbáá.<verse eid="GEN 49:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="GEN 49:16" />»Dán maxudaa awan numúú xa̱bo̱ xuajiuun máꞌ,</para>
  <para style="q" vid="GEN 49:16">numuu rí ikhaa̱ ñajuun mbá máꞌ kuthúún xa̱bi̱i̱ Israél.<verse eid="GEN 49:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="GEN 49:17" />Ga̱nindxu̱u̱ Dán wiphii asndo xóo mbáa a̱bo̱ꞌ</para>
  <para style="q" vid="GEN 49:17">tsí na̱ge̱ꞌe̱ ná rawuun jamba̱á.</para>
  <para style="q" vid="GEN 49:17">Ga̱ki̱jmaa̱ mi̱khui̱i̱ nakhúu guáyo̱,</para>
  <para style="q" vid="GEN 49:17">xúꞌkhue̱n máꞌ ma̱ꞌnii̱ rí ma̱rákaa skidi xa̱bo̱ sia̱nꞌ tsí rígu ikhín.<verse eid="GEN 49:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="GEN 49:18" />»Gúꞌthu̱u̱n máꞌ rí ma̱tha̱ne̱ jríñu̱ú, Anu̱ꞌ Mikhuíí.<verse eid="GEN 49:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="GEN 49:19" />»Xómáꞌ Gád, ma̱dráꞌiin xa̱bo̱ sia̱nꞌ inuu̱,</para>
  <para style="q" vid="GEN 49:19">nda̱wa̱á ikhaa̱ ma̱ki̱jmaa̱ ngu̱ꞌwa̱ rí ma̱ꞌne gajmíi̱.<verse eid="GEN 49:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="GEN 49:20" />»Asér ma̱gi̱ꞌdoo mbaꞌa mi̱ndaꞌkho ganitsu,</para>
  <para style="q" vid="GEN 49:20">jamí ikhaa̱ maxnúu̱ ganitsu rí ndasko̱ꞌ rí me̱kho̱ thúngaa mba̱a̱.<verse eid="GEN 49:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="GEN 49:21" />»Neftalí ñajuun xóo mbáa a̱ña̱ꞌ tsí ngrigo̱o̱ ikhaa.</para>
  <para style="q" vid="GEN 49:21">Rí ajngóo̱ rí phú mitsaan asndo xóo jaꞌñúú i̱jín-áñá.<verse eid="GEN 49:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="GEN 49:22" />»José ñajuun xóo mbá ñawúun ixe̱,</para>
  <para style="q" vid="GEN 49:22">wéje̱ ne̱ ná rawuun iya, jamí phú najma̱a̱ xndúu ne̱.</para>
  <para style="q" vid="GEN 49:22">Xómáꞌ ñawúun ne̱ rí narudu-ri̱ya̱ꞌ, na̱ka̱-ratsimuu ne̱ ná xu̱nꞌ.<verse eid="GEN 49:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="GEN 49:23" />Mbo̱ nu̱xi̱díí xkuíyu̱u̱ xkamídá nini̱i̱ ma̱ꞌkhu̱u̱n a̱kui̱i̱n,</para>
  <para style="q" vid="GEN 49:23">ni̱xi̱dí-jmaa̱ xkuíyu̱u̱ ne̱,</para>
  <para style="q" vid="GEN 49:23">jamí nene̱ gajmáa̱ xa̱bo̱ tsúꞌkhue̱n.<verse eid="GEN 49:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="GEN 49:24" />I̱ndo̱ó ikhaa̱, ni̱we̱je̱ gúkú xkamídúu̱,</para>
  <para style="q" vid="GEN 49:24">numuu rí ñawúu̱n ni̱gi̱ꞌdoo tsiakhe̱.</para>
  <para style="q" vid="GEN 49:24">Nitambáyíi̱ eꞌne tsí Gakhi̱i̱, tsí xtáa jma̱á Jakób,</para>
  <para style="q" vid="GEN 49:24">ikhaa máꞌ tsí ñajuun Waxtú, jamí Itsí Ski̱yu̱u̱ꞌ Israél ñajuu̱n.<verse eid="GEN 49:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="GEN 49:25" />Núma̱a̱ꞌ Anu̱u̱ ana̱a̱ꞌ rí nambáyáaꞌ,</para>
  <para style="q" vid="GEN 49:25">núma̱a̱ꞌ máꞌ Ana̱ꞌ-málóꞌ tsí Gíꞌdoo Xúgíí Tsiakhe̱ rí ma̱ꞌne tsakun-rámáá.</para>
  <para style="q" vid="GEN 49:25">Ikhaa̱ gáꞌne tsakun-rámaa̱ ga̱jma̱á rí na̱ꞌkha̱ ná mikhu,</para>
  <para style="q" vid="GEN 49:25">a̱ga̱ꞌne tsakun-rámaa̱ ga̱jma̱á rí na̱ꞌkha̱ ná me̱jno̱ꞌ mbayíí,</para>
  <para style="q" vid="GEN 49:25">a̱ga̱ꞌne tsakun-rámaa̱ ga̱jma̱á máꞌ rí na̱ꞌkha̱ ná yaꞌdúún jamí awúún go̱ꞌo̱.<verse eid="GEN 49:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="GEN 49:26" />Ana̱a̱ꞌ naꞌne tsakun-rámáá i̱tha̱n mba̱a̱</para>
  <para style="q" vid="GEN 49:26">xóo rí ni̱gu̱ma-tsakun-rámúú nene̱ wa̱jen xíñu xi̱ꞌñúꞌ.</para>
  <para style="q" vid="GEN 49:26">Asndo xóo rí mbá jámuu wájun júba̱,</para>
  <para style="q" vid="GEN 49:26">jámuu máꞌ gágu̱ma-tsakun-rámaa José ja,</para>
  <para style="q" vid="GEN 49:26">ikhaa máꞌ tsí waxtaꞌwí-ri̱ya̱a̱ꞌ ná majiu̱ún a̱ngui̱i̱n.<verse eid="GEN 49:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="GEN 49:27" />»Benjamín ñajuun xóo mbáa i̱ña̱ꞌ tsí minuꞌwaan.</para>
  <para style="q" vid="GEN 49:27">Rí miꞌcha̱ naꞌkhu̱u̱ tsí nigatuwii̱n,</para>
  <para style="q" vid="GEN 49:27">jamí xúꞌkhue̱n máꞌ rí wakhíí naxpiꞌtháa̱ rí napíduun».<verse eid="GEN 49:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="GEN 49:28" />Mbá xúgíin tsúꞌkhue̱n ñajúún tsí mbá gu̱wa̱ꞌ i̱jmi̱i̱ kuthiin i̱ji̱i̱n Israél, jamí ajngáa rúꞌkhue̱n ñajuun rí niꞌthúu̱n i̱ji̱i̱n ído̱ rí neꞌne tsakun-rámii̱. Mbámbáa máꞌ neꞌne tsakun-rámaa̱ xóo rí jaꞌyoo.<verse eid="GEN 49:28" /></para>
  <para style="s">Nijáñuu Jakób jamí waꞌdi̱i̱</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29" />A̱ꞌkhue̱n rí Jakób nixná-ñájúún i̱ji̱i̱n: «Xtáá máꞌ rí ma̱ja̱ñúꞌ jún rá. A̱gu̱dúu̱nlaꞌ tháan gajmíꞌ wa̱jen xi̱ꞌñúꞌ ná iñá rí ꞌgí ná mbayuu Efrón mbo̱ Ét. <verse eid="GEN 49:29" /><verse number="30" style="v" sid="GEN 49:30" />Ikhaa máꞌ iñá rí ꞌgí ná mbaa Makpéla̱, rí ꞌgí ná na̱ꞌkha̱ a̱kha̱ꞌ ná rawuun Mámre̱, ná mbayuu máꞌ Kanaán, ikhaa rí neꞌtse̱ Abraám ga̱jma̱á máꞌ mbayuu Efrón mbo̱ Ét, numuu rí ikhaa ne̱ gáꞌne iñá-wa̱jiúu̱n. <verse eid="GEN 49:30" /><verse number="31" style="v" sid="GEN 49:31" />Ikhín máꞌ waꞌdi̱i̱ Abraám ga̱jma̱á Sára̱, ikhín máꞌ waꞌdi̱i̱ Isaák ga̱jma̱á Rebéka̱ jamí rí ikhín máꞌ ni̱dii̱ Léa̱ mangúún. <verse eid="GEN 49:31" /><verse number="32" style="v" sid="GEN 49:32" />Waꞌtse̱ máꞌ mbaa jamí iñá rí ríga̱ ikhín inúú i̱ji̱i̱n xa̱bo̱ Ét».<verse eid="GEN 49:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 49:33" />Ído̱ rí Jakób wámbo̱o̱ nixná-ñájúu̱n i̱ji̱i̱n, nibáa̱ꞌ inuu xi̱yoo. A̱ꞌkhue̱n ni̱ka̱ xu̱u̱ꞌ, jamí nijáñuu̱.<verse eid="GEN 49:33" /></para>
  <para style="b" />
  <chapter eid="GEN 49" />
  <chapter number="50" style="c" sid="GEN 50" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1" />A̱ꞌkhue̱n rí José ndiyá-raꞌaa̱ anu̱u̱, jamí ni̱mbi̱ye̱e̱ꞌ-jmaa̱, xúꞌkhue̱n máꞌ niraꞌnuu̱ inuu. <verse eid="GEN 50:1" /><verse number="2" style="v" sid="GEN 50:2" />Nda̱wa̱á a̱ꞌkhue̱n nixná-ñájúu̱n xa̱bo̱ thana tsí nitimbáyí-jmáa̱ rí mone̱ thanáá xuyuu anu̱u̱ rí ma̱xíga wapha. Xómáꞌ xa̱bo̱ tsúꞌkhue̱n nene̱ thanáá Israél. <verse eid="GEN 50:2" /><verse number="3" style="v" sid="GEN 50:3" />A̱ꞌkhue̱n nene̱ gáxíi̱ a̱jma̱ skíñú (40) mbiꞌi, numuu rí xkuaꞌnii na̱ga̱nú mbiꞌi rí nuni̱i̱ thanúu̱ wa̱jen. Xómáꞌ xa̱bo̱ Ejípto̱ ni̱mbi̱ya̱ꞌ-jmaa Jakób mbá atsú skíñú gu̱wa̱ꞌ (70) mbiꞌi.<verse eid="GEN 50:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 50:4" />Ído̱ rí ninújngoo máꞌ mbiꞌi rí nu̱mbi̱ya̱ꞌ-jmaa̱, a̱ꞌkhue̱n rí José niꞌthúún xa̱bi̱i̱ Faraón:</para>
  <para style="p" vid="GEN 50:4">―A̱gu̱ñu̱ꞌlaꞌ tháan mbá rí máján, a̱gu̱tháánlaꞌ tháan Faraón: <verse eid="GEN 50:4" /><verse number="5" style="v" sid="GEN 50:5" />“Anu̱ꞌ niꞌñu̱ꞌ rí ma̱xu̱ꞌdá-mina̱ꞌ, rí niꞌthínꞌ xáꞌnii: ‘Atiaxi̱í rí ikhúúnꞌ, xtáá ma̱ja̱ñúꞌlo̱ꞌ. Ná iñá wa̱jen rí ni̱ndilo̱ꞌ ná mbaa Kanaán, ikhín gátha̱du̱ún tháan.’ Ikhaa jngó xúge̱ꞌ rá, na̱tha̱n-jáñaaꞌ rí ma̱ꞌgá gádi̱i̱ tháan anu̱ꞌ, jamí ma̱tangu̱ún-málo̱ꞌ”.<verse eid="GEN 50:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 50:6" />Xómáꞌ Faraón niꞌthán:</para>
  <para style="p" vid="GEN 50:6">―Ayu máꞌ gátha̱dii̱ ana̱a̱ꞌ, xóo rí niꞌñaa̱ꞌ rí ma̱ta̱xu̱ꞌdá-mina̱ꞌ.<verse eid="GEN 50:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 50:7" />A̱ꞌkhue̱n rí José ni̱ka̱ jayáa wa̱jen anu̱u̱ rí ma̱ꞌdii̱, xúꞌkhue̱n máꞌ nigóó mbá xúgíin xa̱bi̱i̱ Faraón ga̱jma̱á nindxu̱u̱, mbá xúgíin máꞌ xa̱buanuu tsí ná goꞌóo̱, jamí mbá xúgíin xa̱buanuu ná mbaa Ejípto̱, <verse eid="GEN 50:7" /><verse number="8" style="v" sid="GEN 50:8" />jamí mbá xúgíin xa̱bo̱ tsí a̱ngui̱i̱n goꞌóo José, xúꞌkhue̱n máꞌ dxíyo̱o̱, mbá xúgíin máꞌ xa̱bo̱ goꞌóo anu̱u̱. I̱ndo̱ó e̱je̱n ni̱ni̱ñúu̱ꞌ ná mbaa Gosén, xúꞌkhue̱n máꞌ moguíi̱n, xedíi̱n. <verse eid="GEN 50:8" /><verse number="9" style="v" sid="GEN 50:9" />Mangaa nigóó ga̱jma̱á nindxu̱u̱ ixe̱ rí nu̱xma̱thaa guáyo̱, xúꞌkhue̱n máꞌ xa̱bo̱ tsí tramúú guáyo̱, jamí phú mba̱a̱ kuthúún xa̱bo̱ neꞌne rí nigóó. <verse eid="GEN 50:9" /><verse number="10" style="v" sid="GEN 50:10" />A̱ꞌkhue̱n rí niguáꞌníi̱ asndo ná Atád, ná rí ni̱tro̱tse̱ ixí iña, rí ꞌgí i̱mba̱ mbéꞌthóo mañuu Jordán. Ikhín nimbáxíi̱nꞌ rí phú mba̱a̱ nidaa a̱kuíi̱n rí ni̱mbi̱ye̱e̱ꞌ jínee̱. Xómáꞌ José mbá juan mbiꞌi nixtáa̱ rí nidaa a̱kui̱i̱n ga̱jma̱á numuu anu̱u̱. <verse eid="GEN 50:10" /><verse number="11" style="v" sid="GEN 50:11" />Ído̱ ndiyáá xa̱bo̱ Kanaán tsí júwá ná mbaa rúꞌkhue̱n rí nu̱mbi̱ye̱e̱ꞌ ná Atád, nithee̱n: «Ríge̱ꞌ ñajuun rí phú mba̱a̱ xta̱mbi̱ñúú xa̱bo̱ Ejípto̱». Ikhaa jngó ikhín neꞌne mbiꞌyuu ne̱ Abél-misráim, rí ꞌgí i̱mba̱ mbéꞌthóo mañuu Jordán.<verse eid="GEN 50:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 50:12" />Xómáꞌ i̱ji̱i̱n Jakób nene̱-mbáníí xómá nixná-ñájun anúu̱ rí muni̱i̱. <verse eid="GEN 50:12" /><verse number="13" style="v" sid="GEN 50:13" />Nigó juya̱a̱ ná mbaa Kanaán. Nidi̱i̱ ná iñá ná mbaa Makpéla̱, rí ꞌgí ná na̱ꞌkha̱ a̱kha̱ꞌ ná rawuun Mámre̱, iñá rí neꞌtse̱ máꞌ Abraám ga̱jma̱á máꞌ mbayuu, ná ñawúun Efrón mbo̱ Ét, numuu rí ikhaa ne̱ gáꞌne iñá-wa̱jiúu̱n. <verse eid="GEN 50:13" /><verse number="14" style="v" sid="GEN 50:14" />Nda̱wa̱á ído̱ wámba̱ niꞌdi̱i̱ anu̱u̱ José, a̱ꞌkhue̱n nitanga̱a̱ ná Ejípto̱ gajmíi̱ dxíyo̱o̱, xúꞌkhue̱n máꞌ mbá xúgíin tsí nigóó ga̱jma̱á nindxu̱u̱.<verse eid="GEN 50:14" /></para>
  <para style="s">José naꞌne maꞌndáa̱ a̱kui̱ín dxíyo̱o̱</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15" />Numuu rí nijáñuu máꞌ Jakób rá, a̱ꞌkhue̱n rí nithan dxíyo̱o̱ José: «Gáꞌne xí José ná-xáxóo gáꞌyalóꞌ rá, jamí ma̱ꞌnii̱ rí mo̱ꞌne̱-núma̱a̱ꞌlóꞌ mbá xúgíí rí ra̱máján rí niꞌnii̱lóꞌ». <verse eid="GEN 50:15" /><verse number="16" style="v" sid="GEN 50:16" />A̱ꞌkhue̱n ni̱xo̱ꞌmee̱ ajngáa inuu José, rí nitháa̱n xáꞌnii: «Ana̱a̱ꞌ niniñuu ajngáa rí inu máꞌ ma̱ja̱ñúu̱ rí mu̱tha̱a̱nꞌxo̱ꞌ: <verse eid="GEN 50:16" /><verse number="17" style="v" sid="GEN 50:17" />“Xáꞌnii gútha̱ánlaꞌ José: ‘Na̱tha̱n-jáñaaꞌ rí xúge̱ꞌ ma̱tha̱ne̱ mba̱a̱ a̱kia̱a̱nꞌ xtayáá aꞌkhúún dxíya̱a̱ꞌ, numuu rí phú ra̱máján rí niña̱a̱ꞌ.’ ” Ikhaa jngó xúge̱ꞌ rá, phú nu̱tha̱n-jáñaaꞌxo̱ꞌ rí ma̱tha̱ne̱ mba̱a̱ a̱kia̱a̱nꞌ xtañúú yumbée Anu̱u̱ ana̱a̱ꞌ rí ra̱máján ni̱ña̱a̱ꞌxo̱ꞌ». Awúun máꞌ rí nutháa̱n rúꞌkhue̱n, ni̱mbi̱ya̱ꞌ José.<verse eid="GEN 50:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 50:18" />A̱ꞌkhue̱n rí niguáꞌnú máꞌ dxíyo̱o̱, jamí ni̱sma̱ti̱gúu̱n inuu̱ rí nitháa̱n:</para>
  <para style="p" vid="GEN 50:18">―Ge̱e̱ máꞌ júwa̱ꞌxo̱ꞌ rá, táta̱. Yumbiáaꞌ máꞌ ñajuanxo̱ꞌ.<verse eid="GEN 50:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 50:19" />Xómáꞌ José niriꞌña̱a̱:</para>
  <para style="p" vid="GEN 50:19">―Ma̱xáꞌthúun máꞌ a̱kia̱nꞌlaꞌ. Ma̱xáxóo ma̱ne̱-mina̱ꞌlo̱ꞌ xóo Ana̱ꞌlóꞌ jún. <verse eid="GEN 50:19" /><verse number="20" style="v" sid="GEN 50:20" />Ikháa̱nꞌlaꞌ ni̱ju̱ma̱ꞌlaꞌ rí mu̱ñu̱ꞌlaꞌ rí ra̱máján, xómáꞌ Ana̱ꞌlóꞌ niꞌni̱i̱ ne̱ rí máján. Ikhaa ne̱ ñajuun rí nduꞌyáálóꞌ xúge̱ꞌ rá, rí ndiya̱a̱ mbiꞌñúú mbaꞌiin xa̱bo̱. <verse eid="GEN 50:20" /><verse number="21" style="v" sid="GEN 50:21" />Ikhaa jngó xúge̱ꞌ rá, ma̱xámíña-málaꞌ. Ikhúúnꞌ máꞌ gáxna̱ꞌlaꞌ rí mo̱pholaꞌ, xúꞌkhue̱n máꞌ i̱jia̱nꞌlaꞌ.</para>
  <para style="p" vid="GEN 50:21">Xkuaꞌnii neꞌne maꞌndáa̱ a̱kui̱ín a̱ngui̱i̱n, rí niꞌthúu̱n ga̱jma̱á ajngáa waba.<verse eid="GEN 50:21" /></para>
  <para style="s">Nijáñuu José</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22" />A̱ꞌkhue̱n rí ni̱ka̱-raxtáa José ná Ejípto̱, xúꞌkhue̱n máꞌ xa̱bo̱ goꞌóo anu̱u̱. Mbá witsu skíñú gu̱wa̱ꞌ (110) tsiguu José neꞌne. <verse eid="GEN 50:22" /><verse number="23" style="v" sid="GEN 50:23" />A̱ꞌkhue̱n ndiꞌyoo̱ ni̱gu̱mii i̱jín-xíñii-egoo Efraín. Ndiꞌñúu̱ mangiin i̱ji̱i̱n Makír tsí a̱dée máꞌ Manasés, tsí ninindxúu̱n máꞌ asndo xómáꞌ i̱ji̱i̱n<note caller="+" style="f"><char style="fr" closed="false">50.23 </char><char style="ft" closed="false">Ná ajngáa ebréo̱ naꞌthán «nigaꞌnuu̱ ná iduu nakhúu̱».</char></note> ikhaa José.<verse eid="GEN 50:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 50:24" />A̱ꞌkhue̱n rí José niꞌthúún dxíyo̱o̱: «Ikhúúnꞌ ma̱ja̱ñúꞌlo̱ꞌ. I̱ndo̱ó máꞌ rí Ana̱ꞌlóꞌ phú gakon ma̱ꞌkha̱ gámbáyálaꞌ, jamí ma̱ꞌnii̱ rí ma̱ga̱jnáa̱ꞌlaꞌ ná mbaa ríge̱ꞌ, rí mu̱ꞌguaa̱ꞌlaꞌ ná mbaa rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ rí maxnúu̱ Abraám, ga̱jma̱á Isaák jamí Jakób». <verse eid="GEN 50:24" /><verse number="25" style="v" sid="GEN 50:25" />José neꞌne rí mu̱xu̱da̱ꞌ-mi̱jna̱ i̱ji̱i̱n Israél, rí niꞌthúu̱n xáꞌnii: «Phú gakon rí ma̱ꞌkha̱ gámbáyálaꞌ Ana̱ꞌlóꞌ, a̱ꞌkhue̱n rí mu̱ri̱ya̱a̱ꞌlaꞌ tháan itsu̱ꞌ ná ge̱e̱, jamí mu̱ꞌgua ju̱ya̱ꞌlaꞌ ne̱».<verse eid="GEN 50:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 50:26" />Mbá witsu skíñú gu̱wa̱ꞌ (110) tsiguu José ído̱ rí nijáñuu. A̱ꞌkhue̱n rí nene̱ thanáa̱ xuyuu̱ rí ma̱xíga wapha, xúꞌkhue̱n máꞌ ni̱gi̱wa̱a̱nꞌ awúun mbá e̱jna̱ ná Ejípto̱.<verse eid="GEN 50:26" /></para>
  <chapter eid="GEN 50" />
</usx>