<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2CO" style="id">tcfU (48-2Cor) - Me̱ꞌpha̱a̱ Mañúwi̱ín (Malinaltepec) (sfm NVI); c13/v257</book>
  <para style="h">2 Xa̱bo̱ Korínto̱</para>
  <para style="toc3">2 Co</para>
  <para style="toc2">2 Xa̱bo̱ Korínto̱</para>
  <para style="toc1">Riajma̱ i̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inúú xa̱bo̱ Korínto̱</para>
  <para style="mt2">Riajma̱ i̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inúú</para>
  <para style="mt1">Xa̱bo̱ Korínto̱</para>
  <chapter number="1" style="c" sid="2CO 1" />
  <para style="s">Páblo̱ naraxi̱in tsí nanimbu̱únꞌ juyáá Jesús ná xuajen Korínto̱</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 1:1" />Ikhúúnꞌ ñajunꞌ Páblo̱, tsí waxúngua̱a̱ꞌ neꞌne Jesukrísto̱ numuu rí xkuaꞌnii ndiyoo Ana̱ꞌlóꞌ. Ga̱jmi̱ꞌ dxájwalóꞌ Timotéo̱.</para>
  <para style="b" vid="2CO 1:1" />
  <para style="p" vid="2CO 1:1">Nu̱xu̱ꞌmáxo̱ꞌ i̱yi̱i̱ꞌ ríge̱ꞌ inúú tsí nanimbu̱únꞌ juyáá Ana̱ꞌlóꞌ ná xuajen Korínto̱, jamí mbá xúgíin xa̱bi̱i Ana̱ꞌlóꞌ tsí júwa̱ꞌ mbá xúgíí numbaa Akáya̱.<verse eid="2CO 1:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="2CO 1:2" />Ana̱ꞌlóꞌ Mikhuíí jamí Táta̱ Jesukrísto̱ gúne̱-tsakun-rámáaꞌlaꞌ jamí ikhii̱n máꞌ gúni̱i̱ rí ma̱juwalaꞌ tsímáá.<verse eid="2CO 1:2" /></para>
  <para style="s">Ana̱ꞌlóꞌ naxnáa la ski̱yu̱u̱ꞌ a̱kia̱nꞌlóꞌ</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 1:3" />A̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ, Anu̱u̱ máꞌ Tátiálóꞌ Jesukrísto̱. Numuu rí Ana̱ꞌlóꞌ nañáwíin a̱kuii̱n jaꞌyalóꞌ jamí jámba̱ miꞌtsú naxnáa la tsiakhe̱ a̱kia̱nꞌlóꞌ. <verse eid="2CO 1:3" /><verse number="4" style="v" sid="2CO 1:4" />Ana̱ꞌlóꞌ naxnáa la tsiakhe̱ a̱kia̱nꞌlóꞌ ído̱ rí juwalóꞌ ná awúun mbá xúgíí inii jamínu̱ꞌ, kajngó mangáanꞌlóꞌ ma̱goo mu̱ꞌxnáalóꞌ tsiakhe̱ a̱kui̱ín tsí júwa̱ꞌ ná awúun jamínu̱ꞌ, xómá rí naꞌne jayu Ana̱ꞌlóꞌ rí naxnáa la tsiakhe̱ a̱kia̱nꞌlóꞌ ikháánꞌlóꞌ. <verse eid="2CO 1:4" /><verse number="5" style="v" sid="2CO 1:5" />Numuu rí xómá rí phú mba̱a̱ nu̱míni̱ílóꞌ ga̱jma̱á numuu Krísto̱, xkuaꞌnii máꞌ phú mba̱a̱ naxnáa la Ana̱ꞌlóꞌ tsiakhe̱ a̱kia̱nꞌlóꞌ ga̱jma̱á majñu̱u̱ Krísto̱. <verse eid="2CO 1:5" /><verse number="6" style="v" sid="2CO 1:6" />Ído̱ rí ikháanꞌxo̱ꞌ nu̱míni̱íxo̱ꞌ, ikháanꞌlaꞌ mbayáa tsiakhe̱ a̱kia̱nꞌlaꞌ jamí ma̱jríñáaꞌlaꞌ. Ído̱ rí ikháanꞌxo̱ꞌ ndayáa tsiakhe̱ a̱kia̱nꞌxo̱ꞌ eꞌne Ana̱ꞌlóꞌ, ikháanꞌlaꞌ mbayáa tsiakhe̱ a̱kia̱nꞌlaꞌ jamí ma̱jríñáaꞌlaꞌ, kajngó ma̱ꞌngo̱o̱ a̱kia̱nꞌlaꞌ rí mu̱míni̱ílaꞌ xómá rí nu̱míni̱í ikháanꞌxo̱ꞌ. <verse eid="2CO 1:6" /><verse number="7" style="v" sid="2CO 1:7" />Numuu rí ikháanꞌxo̱ꞌ mbá jañii a̱kia̱nꞌxo̱ꞌ ju̱ya̱ꞌlaꞌ, jamí ndu̱ya̱áxo̱ꞌ rí xómá rí a̱ngia̱nꞌxo̱ꞌ ñajwanlaꞌ ná awúun jamínu̱ꞌ, xkuaꞌnii máꞌ a̱ngia̱nꞌxo̱ꞌ ñajwanlaꞌ ná awúun rí Ana̱ꞌlóꞌ naxnáa la tsiakhe̱ a̱kia̱nꞌlaꞌ mangaa.<verse eid="2CO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 1:8" />A̱ngui̱nꞌ, nandoꞌ rí ma̱gi̱da̱ꞌ idxa̱ꞌlaꞌ wátha̱ mba̱a̱ ni̱míni̱íxo̱ꞌ ná numbaa Ásia̱. Numuu rí ninújngoo gakhe̱ ni̱gíꞌnííxo̱ꞌ ikhín, rí asndo wámba̱ ski̱ya̱ꞌxo̱ꞌ, jamí asndo ni̱ju̱ma̱ꞌxo̱ꞌ rí ma̱ja̱ñáxo̱ꞌ máꞌ. <verse eid="2CO 1:8" /><verse number="9" style="v" sid="2CO 1:9" />Ni̱ndxa̱ꞌwa̱-mijnáxo̱ꞌ rí waꞌxná-máꞌáanꞌxo̱ꞌ máꞌ rí ma̱ja̱ñáxo̱ꞌ. Xómáꞌ jamínu̱ꞌ rúꞌkhue̱n nimbáyáxo̱ꞌ ne̱ rí ma̱xáwe̱je̱ a̱kia̱nꞌxo̱ꞌ ju̱ya̱-mijná máꞌ ikháanꞌxo̱ꞌ, rí ma̱we̱je̱ a̱kia̱nꞌxo̱ꞌ ná inuu Ana̱ꞌlóꞌ tsí naꞌne rí mbuya̱a mbiꞌñúú tsí nijáñúú. <verse eid="2CO 1:9" /><verse number="10" style="v" sid="2CO 1:10" />Ana̱ꞌlóꞌ neꞌne-jríñáa̱ꞌxo̱ꞌ ná awúun ngamí rí ma̱ja̱ñáxo̱ꞌ, jamí naꞌne-jríñáa̱ꞌxo̱ꞌ máꞌ xúge̱ꞌ. Ná ñawúun Ana̱ꞌlóꞌ ni̱ra̱khuá-mijnáxo̱ꞌ, jamí guáꞌthi̱ínxo̱ꞌ rí ma̱ꞌne-jríñáa̱ꞌxo̱ꞌ máꞌ xóó nda̱wa̱á, <verse eid="2CO 1:10" /><verse number="11" style="v" sid="2CO 1:11" />numuu rí ikháanꞌlaꞌ nu̱tha̱n-jáñíílaꞌ Ana̱ꞌlóꞌ ga̱jma̱á numaxo̱ꞌ. A̱ꞌkhue̱n rí phú mbaꞌiin xa̱bo̱ muthán-jáñíí Ana̱ꞌlóꞌ ga̱jma̱á numaxo̱ꞌ, jamí phú mbaꞌiin xa̱bo̱ mu̱rígu̱u gamaku inuu Ana̱ꞌlóꞌ, numuu rí niriꞌña Ana̱ꞌlóꞌ rí ni̱nda̱ꞌe̱e̱ ga̱jma̱á numaxo̱ꞌ.<verse eid="2CO 1:11" /></para>
  <para style="s">Naxtiꞌkhu̱u rí naꞌgí-mina̱ꞌ Páblo̱ ma̱ꞌne</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 1:12" />Ma̱goo mu̱tha̱nxo̱ꞌ ga̱jma̱á mbá jañii a̱kia̱nꞌxo̱ꞌ rí ni miꞌtsú túne̱-nduwaxo̱ꞌ, jamí jaꞌwu a̱kia̱nꞌxo̱ꞌ nijuwaxo̱ꞌ ná inúú xa̱bo̱, jamí i̱wa̱á máꞌ rí ga̱jma̱á nindxa̱ꞌlaꞌ ikháanꞌlaꞌ, jamí ikhaa máꞌ rúꞌkhue̱n naꞌthán-máꞌánxo̱ꞌ a̱kia̱nꞌxo̱ꞌ mangaa. Ana̱ꞌlóꞌ nimbáyáxo̱ꞌ rí ma̱juwaxo̱ꞌ xkuaꞌnii ga̱jma̱á majñu̱u̱ rí máján nixnáxo̱ꞌ, ra̱ꞌkhá ga̱jma̱á majñu̱u̱ rí na̱ma̱ñaxo̱ꞌ ikháanꞌxo̱ꞌ. <verse eid="2CO 1:12" /><verse number="13" style="v" sid="2CO 1:13" />Ikhaa máꞌ rí nu̱raxnuulaꞌ jamí nafraꞌa̱ꞌlaꞌ ná inuu i̱ya̱ꞌxo̱ꞌ, ikhaa máꞌ rúꞌkhue̱n ñajuun rí nu̱tha̱nꞌlaꞌxo̱ꞌ, numuu rí nda̱a̱ nitháan rí kri̱ga̱ ngu̱ꞌwo̱o̱ ná inuu i̱ya̱ꞌxo̱ꞌ. Jamí ikhúúnꞌ gúꞌthu̱u̱n rí mbá mbiꞌi ma̱fraꞌa̱ꞌlaꞌ mbá xúgíí rí nu̱tha̱nxo̱ꞌ, <verse eid="2CO 1:13" /><verse number="14" style="v" sid="2CO 1:14" />maske máꞌ xúge̱ꞌ tsífraꞌa̱ꞌlaꞌ mbá xúgíí. Xkuaꞌnii kajngó ído̱ rí ma̱ꞌkha̱a Táta̱ Jesús, ikháanꞌlaꞌ ma̱juwalaꞌ gagi ga̱jma̱á numaxo̱ꞌ, xómá rí ikháanꞌxo̱ꞌ ma̱juwaxo̱ꞌ gagi ga̱jma̱á numalaꞌ ikháanꞌlaꞌ.<verse eid="2CO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 1:15" />Numuu rí mbá jañii máꞌ a̱kui̱nꞌ rí nafraꞌa̱ꞌlaꞌ, ikhaa jngó ni̱ꞌgí-mina̱ꞌ rí ma̱ꞌgá gáya̱ꞌlaꞌ ikháanꞌlaꞌ ginii jayu, kajngó ma̱juwalaꞌ gagi a̱jma̱ nothon rí mu̱drígúúnlaꞌ. <verse eid="2CO 1:15" /><verse number="16" style="v" sid="2CO 1:16" />Ikhúúnꞌ ni̱ꞌgí-mina̱ꞌ rí ginii ma̱ꞌgá gáya̱ꞌlaꞌ ído̱ rí ma̱ꞌgálo̱ꞌ ná numbaa Masedónia̱, jamí ído̱ rí ma̱ꞌkha̱aꞌ ná Masedónia̱, ma̱nújnga̱aꞌlo̱ꞌ ná juwalaꞌ. Nda̱wa̱á a̱ꞌkhue̱n rí mu̱mbáyúꞌlaꞌ rí mba̱ya̱a ikhoꞌ ma̱ꞌgá ná numbaa Judéa̱. <verse eid="2CO 1:16" /><verse number="17" style="v" sid="2CO 1:17" />Nákhí ni̱ꞌgí-mina̱ꞌ rí ma̱ne̱ ríge̱ꞌ, á na̱ju̱ma̱ꞌlaꞌ rí tsíndxa̱ꞌwa̱-mína̱ꞌ mújúnꞌ rí ma̱ne̱ dxe̱ꞌ, o na̱ju̱ma̱ꞌlaꞌ rí ikhúúnꞌ mangúúnꞌ jaꞌñúú xómá jaꞌñúú xa̱bo̱ numbaa dxe̱ꞌ, rí ginii nuthee̱n «ma̱ne̱» jamí nda̱wa̱á nuthee̱n «ma̱xáne̱».<verse eid="2CO 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CO 1:18" />Ana̱ꞌlóꞌ ndaꞌyoo̱ mújúu̱n rí ikháanꞌxo̱ꞌ tsítha̱nꞌlaꞌxo̱ꞌ «ma̱ne̱» jamí «ma̱xáne̱» mangaa. <verse eid="2CO 1:18" /><verse number="19" style="v" sid="2CO 1:19" />Numuu rí Jesukrísto̱, tsí ñajuun A̱dée Ana̱ꞌlóꞌ, ra̱ꞌkhá ginii naꞌthée̱n «ma̱ne̱» jamí nda̱wa̱á naꞌthée̱n «ma̱xáne̱». Ikhúúnꞌ ga̱jmi̱ꞌ Silbáno̱ jamí Timotéo̱ ni̱tha̱n-ráꞌaxo̱ꞌ ga̱jma̱á numuu̱ máꞌ ikhaa̱ ná inalaꞌ, rí mbóó máꞌ ajngóo̱, rí ma̱ꞌne-mbánuu̱ rí naꞌthée̱n ma̱ꞌnii̱. <verse eid="2CO 1:19" /><verse number="20" style="v" sid="2CO 1:20" />Numuu rí ga̱jma̱á majñu̱u̱ Krísto̱ «na̱gu̱ma-mbáníí» mbá xúgíí rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ. Ikhaa jngó, ído̱ rí nu̱ꞌne̱-mba̱a̱lóꞌ Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ Krísto̱, nuꞌthánlóꞌ «xkuaꞌnii gáꞌne». <verse eid="2CO 1:20" /><verse number="21" style="v" sid="2CO 1:21" />Xómáꞌ Ana̱ꞌlóꞌ naꞌnii̱ rí ma̱wajún-gúkuálóꞌ ga̱jma̱á majñu̱u̱ Krísto̱, jamí niraꞌwáa̱nꞌlóꞌ rí mu̱ꞌne̱lóꞌ ñajuu̱n. <verse eid="2CO 1:21" /><verse number="22" style="v" sid="2CO 1:22" />Xúꞌkhue̱n máꞌ nixnálóꞌ tsinuu̱ rí nasngájma rí xa̱bii̱ ñajwanlóꞌ. Tsina tsúꞌkhue̱n ñajuun Xu̱u̱ꞌ Ana̱ꞌlóꞌ tsí xtáa ná awúun a̱kia̱nꞌlóꞌ, rí nasngájma rí Ana̱ꞌlóꞌ maxnálóꞌ mbá xúgíí rí nixuda-mine̱e̱ꞌ.<verse eid="2CO 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 1:23" />Ana̱ꞌlóꞌ ndaꞌyoo rí gakon rí na̱tha̱nꞌlaꞌ jamí ikhaa̱ gáꞌnii̱ rí ma̱ja̱ñúꞌ xí na̱ne̱-nduwalo̱ꞌ, xóó máꞌ táthangu̱únꞌlo̱ꞌ ná Korínto̱ a̱ꞌkhue̱n, numuu rí tsíyoꞌ máꞌ rí ma̱ríyálaꞌ mbu̱júꞌ. <verse eid="2CO 1:23" /><verse number="24" style="v" sid="2CO 1:24" />Ra̱ꞌkhá máꞌ numuu nandaxo̱ꞌ rí mu̱xna̱-ñájwanlaꞌ xáne gíꞌmaa ma̱juwalaꞌ ga̱jma̱á numuu rí wéje̱ a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ, numuu rí ikháanꞌlaꞌ kuajún-gúkuálaꞌ máꞌ ná tsu̱du̱u̱ rí wéje̱ a̱kia̱nꞌlaꞌ ju̱ya̱á. I̱ndo̱ó máꞌ numuu rí nandaxo̱ꞌ mu̱ñajunxo̱ꞌ ga̱jma̱á nindxa̱ꞌlaꞌ kajngó ma̱juwalaꞌ i̱tha̱án máꞌ gagi.<verse eid="2CO 1:24" /></para>
  <chapter eid="2CO 1" />
  <chapter number="2" style="c" sid="2CO 2" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 2:1" />Ikhaa jngó ni̱ꞌgí-mina̱ꞌ rí ma̱xáꞌgá gáya̱ꞌlaꞌ mbu̱júꞌ rí ma̱ne̱ rí ma̱juwa-jínálaꞌ. <verse eid="2CO 2:1" /><verse number="2" style="v" sid="2CO 2:2" />Xí ikhúúnꞌ na̱ne̱ rí ma̱juwa-jínálaꞌ, tsáa gáꞌne-gagi̱i a̱kui̱nꞌ ikhúúnꞌ rá, rí i̱ndo̱ó máꞌ ikháanꞌlaꞌ tsáanꞌ ne̱ne̱ rí ma̱juwa-jínálaꞌ. <verse eid="2CO 2:2" /><verse number="3" style="v" sid="2CO 2:3" />Ikhaa numuu rúꞌkhue̱n ni̱tháánlo̱ꞌ ajngáa gakhe̱ ma̱ꞌga inalaꞌ, kajngó mu̱xúne̱laꞌ rí ma̱xtáá-jínúꞌlo̱ꞌ ído̱ rí ma̱gánú a̱ꞌkhue̱n, rí i̱tha̱án máꞌ máján rí mu̱ne̱-gagi̱ilaꞌ a̱kui̱nꞌ. Ikhúúnꞌ nda̱yo̱o̱ mújúnꞌ rí ikháanꞌlaꞌ ma̱ꞌdxu a̱kia̱nꞌlaꞌ ga̱jma̱á nindxu̱ꞌ. <verse eid="2CO 2:3" /><verse number="4" style="v" sid="2CO 2:4" />Numuu rí nákhí ni̱tháánlo̱ꞌ i̱yi̱i̱ꞌ rúꞌkhue̱n, phú naxná-gamiéjunꞌ jamí najmúu a̱kui̱nꞌ e̱ne̱laꞌ, rí asndo na̱mbi̱ya̱ꞌlo̱ꞌ. Xómáꞌ ikhúúnꞌ tátháán ne̱ kajngó ma̱ne̱ rí ma̱juwa-jínálaꞌ, rí nandoꞌ rí mbu̱ya̱álaꞌ rí maphú mba̱a̱ nandoꞌ ja̱ya̱ꞌlaꞌ.<verse eid="2CO 2:4" /></para>
  <para style="s">Gu̱ꞌne̱ mba̱a̱ a̱kia̱nꞌlóꞌ juꞌyáá tsí neꞌne aꞌkhán</para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 2:5" />Xí mbáa neꞌne rí ma̱xtáá-jínúꞌlo̱ꞌ, ra̱ꞌkhá máꞌ i̱ndo̱ó ikhúúnꞌ niꞌnii̱ rí ma̱xtáá-jínúꞌlo̱ꞌ, rí asndo mbá xúgiáanꞌlaꞌ máꞌ niꞌnii̱ rí ma̱juwa-jínálaꞌ, jamí ra̱ꞌkhá máꞌ nanújngo-rámuꞌ rí na̱tha̱nꞌlaꞌ ríge̱ꞌ. <verse eid="2CO 2:5" /><verse number="6" style="v" sid="2CO 2:6" />Mbájndi máꞌ jamínu̱ꞌ rí ni̱ꞌgílaꞌ mbaꞌáanꞌlaꞌ ná inuu xa̱bo̱ tsúꞌkhue̱n. <verse eid="2CO 2:6" /><verse number="7" style="v" sid="2CO 2:7" />Rí xúge̱ꞌ rá, ikháanꞌlaꞌ jaꞌyoo rí mu̱ne̱ mba̱a̱ a̱kia̱nꞌlaꞌ ju̱yáa̱ jamí rí mu̱xna̱alaꞌ tsiakhe̱ a̱kuii̱n, ra̱ꞌkhá ma̱mbáa̱ gáꞌne rí xtáa̱-jínúu̱ guéño. <verse eid="2CO 2:7" /><verse number="8" style="v" sid="2CO 2:8" />Ikhaa jngó rí xúge̱ꞌ rá, na̱tha̱n-jáñalaꞌ rí mu̱snga̱jmáa̱ mbu̱jwálaꞌ rí nandalaꞌ ju̱yáa̱. <verse eid="2CO 2:8" /><verse number="9" style="v" sid="2CO 2:9" />Ikhaa máꞌ numuu rúꞌkhue̱n mangaa ni̱xu̱ꞌmá i̱yi̱i̱ꞌ inalaꞌ nákhí wapha, kajngó mba̱yo̱o̱ xí juwalaꞌ rí mu̱ne̱-mbáníílaꞌ mbá xúgíí rí na̱tha̱nꞌlaꞌ. <verse eid="2CO 2:9" /><verse number="10" style="v" sid="2CO 2:10" />Ikhaa jngó, xí ikháanꞌlaꞌ nu̱ne̱ mba̱a̱ a̱kia̱nꞌlaꞌ ju̱yáa̱, ikhúúnꞌ mangúúnꞌ na̱ne̱ mba̱a̱ a̱kui̱nꞌ ja̱yo̱o̱. Xí ndaꞌyóo rí ma̱ne̱ mba̱a̱ a̱kui̱nꞌ, na̱ne̱ mba̱a̱ a̱kui̱nꞌlo̱ꞌ ga̱jma̱á numalaꞌ ikháanꞌlaꞌ ná inuu Krísto̱. <verse eid="2CO 2:10" /><verse number="11" style="v" sid="2CO 2:11" />Xkuaꞌnii kajngó ma̱xáꞌngo̱o̱ Satanás gáꞌne-nduwáanꞌlóꞌ, numuu rí nduꞌyáá máꞌ májánlóꞌ rí naꞌgí-mine̱e̱ꞌ ma̱ꞌnii̱ rí ra̱máján.<verse eid="2CO 2:11" /></para>
  <para style="s">Yumbáá tsí nu̱ñajun ga̱jma̱á numuu awan nuxe̱ꞌ</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 2:12" />Nákhí nigánú rí ma̱tha̱n-ráꞌa ajngáa máján ga̱jma̱á numuu Krísto̱ ná xuajen Tróa̱s, a̱ꞌkhue̱n ndi̱yo̱o̱ rí ni̱ma̱ꞌthoo kajngó ma̱goo ma̱ñajunlo̱ꞌ ga̱jma̱á numuu Táta̱. <verse eid="2CO 2:12" /><verse number="13" style="v" sid="2CO 2:13" />Maske máꞌ xkuaꞌnii, táꞌne májáan a̱kui̱nꞌ, numuu rí na̱nguá ni̱xkamaa dxájwalóꞌ Títo̱ ikhín. Ikhaa jngó ni̱tha̱n-ngáwúún xa̱bo̱ jamí nika ná numbaa Masedónia̱.<verse eid="2CO 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 2:14" />I̱ndo̱ó máꞌ numuu rí núma̱aꞌ la Ana̱ꞌlóꞌ, numuu rí jámba̱ miꞌtsú naꞌnii̱ rí ma̱ꞌnga̱ꞌlóꞌ ga̱jma̱á nindxu̱u̱ Krísto̱, jamí naꞌnii̱ rí ga̱jma̱á majña̱ꞌ ikháánꞌlóꞌ ma̱dróꞌoo mbá xúgíí numbaa gisngáá drígo̱o̱ Krísto̱ xómá xu̱u̱ꞌ iya ndaa thawuun. <verse eid="2CO 2:14" /><verse number="15" style="v" sid="2CO 2:15" />Numuu rí ná inuu Ana̱ꞌlóꞌ ikháánꞌlóꞌ ñajwanlóꞌ xu̱u̱ꞌ rí ndaa thawiin Krísto̱, rí na̱dróꞌoo ná majñu̱ú tsí najáwíin jamí tsí nandáti̱gi̱in. <verse eid="2CO 2:15" /><verse number="16" style="v" sid="2CO 2:16" />Ná inúú xa̱bo̱ tsí nandáti̱gi̱in, ikháánꞌlóꞌ juꞌyálóꞌ xu̱u̱ꞌ xa̱bo̱ tsí nijáñuu, numuu rí wéje̱ máꞌ rí ma̱ja̱ñúu̱ rí ikhii̱n. Xómáꞌ ná inúú xa̱bo̱ tsí najáwíin rá, ikháánꞌlóꞌ juꞌyálóꞌ xu̱u̱ꞌ xa̱bo̱ tsí ndaꞌya, numuu rí wéje̱ máꞌ rí mbuyee̱ jámuu rí ikhii̱n. Ndawa̱a̱ asndo nimbáa tsí ma̱ꞌngo̱o̱ ma̱ꞌne ríge̱ꞌ ga̱jma̱á ski̱yu̱u̱ꞌ máꞌ ikhaa. <verse eid="2CO 2:16" /><verse number="17" style="v" sid="2CO 2:17" />Xómáꞌ ikháanꞌxo̱ꞌ tsíngu̱jwa̱xo̱ꞌ ajngáa rawuun Ana̱ꞌlóꞌ rí ma̱piꞌtsaxo̱ꞌ, xómá nune̱ mbaꞌiin tsí na̱ka̱ma̱xu̱ún ajngóo̱. A̱ꞌkhue̱n gakon, Ana̱ꞌlóꞌ ndaꞌyoo rí gakon rí nu̱tha̱nxo̱ꞌ ga̱jma̱á majñu̱u̱ ski̱yu̱u̱ꞌ Krísto̱ numuu rí xa̱bo̱ tsí nixúngui̱inꞌ Ana̱ꞌlóꞌ ñajwanxo̱ꞌ.<verse eid="2CO 2:17" /></para>
  <chapter eid="2CO 2" />
  <chapter number="3" style="c" sid="2CO 3" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 3:1" />Á nu̱gíꞌdi̱ín mbu̱jwáxo̱ꞌ nu̱tha̱n rí máján ga̱jma̱á numa máꞌ ikháanꞌxo̱ꞌ dxe̱ꞌ. O ndaꞌyóo rí mu̱xna̱xíxo̱ꞌ ná inalaꞌ i̱yi̱i̱ꞌ rí naꞌthán rí máján ga̱jma̱á numaxo̱ꞌ dxe̱ꞌ. O mu̱nda̱ꞌa̱ꞌlaꞌxo̱ꞌ ikháanꞌlaꞌ rí mu̱tha̱nlaꞌ rí máján ga̱jma̱á numaxo̱ꞌ, xómá nune̱ mbá tikhuun dxe̱ꞌ. <verse eid="2CO 3:1" /><verse number="2" style="v" sid="2CO 3:2" />Jmína̱áꞌ máꞌ ikháanꞌlaꞌ ñajwanlaꞌ xómá i̱yi̱i̱ꞌ rí naꞌthán rí máján ga̱jma̱á numaxo̱ꞌ, rí waꞌtháán ná awúun a̱kia̱nꞌxo̱ꞌ, rí na̱gu̱ma-nuwiin jamí nu̱raxnuu mbá xúgíin xa̱bo̱. <verse eid="2CO 3:2" /><verse number="3" style="v" sid="2CO 3:3" />Nakujma nguáná máꞌ rí ikháanꞌlaꞌ ñajwanlaꞌ xómá i̱yi̱i̱ꞌ rí niꞌtháán Krísto̱, rí ni̱xna̱xí ikháanꞌxo̱ꞌ. I̱yi̱i̱ꞌ rúꞌkhue̱n táwaꞌtháán ne̱ ga̱jma̱á ñaꞌñúú, rí waꞌtháán ne̱ ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ tsí ndaꞌya. Ni máꞌ táwaꞌtháán ne̱ ná tsu̱du̱u̱ xapa itsí, rí waꞌtháán ne̱ ná awúun a̱kui̱ín xa̱bo̱ numbaa.<verse eid="2CO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 3:4" />Ikhaa numuu rúꞌkhue̱n, naꞌne mbá jañii a̱kia̱nꞌxo̱ꞌ ná inuu Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ Krísto̱. <verse eid="2CO 3:4" /><verse number="5" style="v" sid="2CO 3:5" />Ra̱ꞌkhá máꞌ ikháanꞌxo̱ꞌ phú na̱ꞌnga̱ꞌxo̱ꞌ rí mu̱ne̱xo̱ꞌ mbá ñajun ga̱jma̱á máꞌ ski̱ya̱ꞌxo̱ꞌ, kajngó mu̱ndxa̱ꞌwa̱-mijnáxo̱ꞌ rí ikháanꞌxo̱ꞌ phú na̱ꞌnga̱ꞌxo̱ꞌ. A̱ꞌkhue̱n gakon, Ana̱ꞌlóꞌ ñajuun tsí naꞌne rí ma̱ꞌnga̱ꞌxo̱ꞌ mu̱ne̱ mbá xúgíí rí nu̱ne̱xo̱ꞌ. <verse eid="2CO 3:5" /><verse number="6" style="v" sid="2CO 3:6" />Ana̱ꞌlóꞌ neꞌne rí ma̱nindxa̱ꞌxo̱ꞌ yumbáá tsí najmii nu̱ñajun ga̱jma̱á numuu mbá awan nuxe̱ꞌ. Ra̱ꞌkhá rí mu̱ꞌne̱-mbáníílóꞌ mbá xtángoo rí waꞌtháán, rí mu̱ꞌne̱-mbáníílóꞌ rí naꞌthán Xu̱u̱ꞌ Ana̱ꞌlóꞌ, numuu rí xtángoo rí waꞌtháán naꞌne ne̱ rí ma̱ja̱ñúú xa̱bo̱, xómáꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ naꞌnii̱ rí mbuya xa̱bo̱.<verse eid="2CO 3:6" /></para>
  <para style="s">I̱tha̱án máꞌ gíꞌdoo numuu awan nuxe̱ꞌ</para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 3:7" />Awan wayuu rí naꞌne rí ma̱ja̱ñúú xa̱bo̱, rí waꞌtháán xtángawoo ná tsu̱du̱u̱ xapa itsí, phú wáá jaꞌnii ne̱ nákhí ni̱gi̱ꞌdu̱u̱n ne̱, rí asndo xa̱bo̱ Israél tsíyoo rí mu̱ra̱ꞌe̱e̱ inuu Moisés numuu rí phú nambiꞌi-taꞌa ne̱, maske máꞌ na̱ka̱-rayámba̱ rí nambiꞌi-taꞌa ne̱. <verse eid="2CO 3:7" /><verse number="8" style="v" sid="2CO 3:8" />Xí xkuaꞌnii neꞌne ga̱jma̱á nindxu̱u̱ awan wayuu rúꞌkhue̱n, á ra̱ꞌkhá i̱tha̱án máꞌ wáá jaꞌnii awan nuxe̱ꞌ rí na̱ꞌkha̱ jayóo Xu̱u̱ꞌ Ana̱ꞌlóꞌ rá. <verse eid="2CO 3:8" /><verse number="9" style="v" sid="2CO 3:9" />Xí phú wáá ninindxu̱u̱ awan wayuu rí naxná-máꞌíin xa̱bo̱ rí ma̱ja̱ñúú, ¡phú i̱tha̱án máꞌ wáá jaꞌnii awan rí naꞌne rí Ana̱ꞌlóꞌ maꞌthán rí nánda̱a̱ aꞌkhánlóꞌ! <verse eid="2CO 3:9" /><verse number="10" style="v" sid="2CO 3:10" />Numuu rí phú wáá ninindxu̱u̱ nákhí wajyúú, na̱nguá máꞌ wáá guéño ne̱, xí na̱giewan ne̱ ga̱jma̱á awan nuxe̱ꞌ, rí phú i̱tha̱án wáá jaꞌnii. <verse eid="2CO 3:10" /><verse number="11" style="v" sid="2CO 3:11" />Ikhaa jngó, xí phú wáá ninindxu̱u̱ awan rí wéje̱ máꞌ rí ma̱mbáa, phú i̱tha̱án máꞌ wáá jaꞌnii awan rí ríga̱ jámuu.<verse eid="2CO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 3:12" />Ikhaa numuu rúꞌkhue̱n, ikháanꞌxo̱ꞌ ga̱jma̱á mbá jañii a̱kia̱nꞌxo̱ꞌ guáꞌthi̱ínxo̱ꞌ ná inuu Ana̱ꞌlóꞌ, jamí tsímíñaxo̱ꞌ rí mu̱tha̱nxo̱ꞌ. <verse eid="2CO 3:12" /><verse number="13" style="v" sid="2CO 3:13" />Tsíne̱xo̱ꞌ xómá neꞌne Moisés, rí nirugoo̱ inuu̱ ga̱jma̱á mbá xtíin kajngó mu̱xúyáá xa̱bo̱ Israél xáne na̱ka̱-rayámba̱a rí wéje̱ máꞌ rí ma̱mbáa. <verse eid="2CO 3:13" /><verse number="14" style="v" sid="2CO 3:14" />Xómáꞌ xa̱bo̱ Israél táfruꞌúu̱n, ni máꞌ tsífruꞌúu̱n asndo xúge̱ꞌ. Ído̱ rí nu̱raxnuu̱ xtángoo drígo̱o̱ awan wayuu, tsífruꞌúu̱n ne̱, numuu rí júgoo inúu̱ eꞌne ikhaa máꞌ xtíin. I̱ndo̱ó máꞌ ga̱jma̱á majñu̱u̱ Krísto̱ ma̱goo ma̱ma̱ꞌthoo inúu̱. <verse eid="2CO 3:14" /><verse number="15" style="v" sid="2CO 3:15" />Asndo mbiꞌi xúge̱ꞌ, ído̱ rí nu̱raxnuu̱ i̱yi̱i̱ꞌ rí niꞌtháán Moisés, tsífruꞌúu̱n ne̱ numuu rí júgoo a̱kuíi̱n eꞌne xtíin. <verse eid="2CO 3:15" /><verse number="16" style="v" sid="2CO 3:16" />I̱ndo̱ó máꞌ numuu rí ído̱ rí ma̱thanga̱a a̱kuíi̱n ná inuu Táta̱, a̱ꞌkhue̱n rí ma̱ma̱ꞌthoo inúu̱. <verse eid="2CO 3:16" /><verse number="17" style="v" sid="2CO 3:17" />Numuu rí Táta̱ ñajuun Xe̱ꞌ, jamí ná xtáa̱ Xu̱u̱ꞌ Táta̱, ikhín nijáwíin máꞌ xa̱bo̱. <verse eid="2CO 3:17" /><verse number="18" style="v" sid="2CO 3:18" />Ikhaa jngó, mbá xúgiáanꞌ ikháánꞌlóꞌ tsáanꞌ ni̱ma̱ꞌthoo máꞌ inalóꞌ, ñajwanlóꞌ xómá iyaniwan ná nakujma rí nambiꞌi-taꞌaa Táta̱, jamí mbámbá mbiꞌi na̱ka̱-raxtiꞌkhuáanꞌlóꞌ kajngó ma̱nindxa̱ꞌlóꞌ i̱tha̱án xómá jaꞌnii̱ ikhaa̱. Ríge̱ꞌ ñajuun rí naꞌne Xu̱u̱ꞌ Táta̱.<verse eid="2CO 3:18" /></para>
  <chapter eid="2CO 3" />
  <chapter number="4" style="c" sid="2CO 4" />
  <para style="s">Rí phú gíꞌdoo numuu kua̱ꞌa̱n ne̱ ná awúun daan ju̱ba̱ꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 4:1" />Ikhaa jngó, tsíne̱-waba-mijnáxo̱ꞌ, numuu rí ga̱jma̱á majñu̱u̱ rí nañáwíin a̱kui̱in Ana̱ꞌlóꞌ jaꞌyaxo̱ꞌ, nixnángawaxo̱ꞌ rí mu̱ne̱xo̱ꞌ ñajun ríge̱ꞌ. <verse eid="2CO 4:1" /><verse number="2" style="v" sid="2CO 4:2" />Tsíne̱xo̱ꞌ nimbá ná ngu̱ꞌwa̱ ni máꞌ rí mate̱ꞌ. Na̱nguá e̱ne̱-ku̱maaxo̱ꞌ ajngáa kajngó mu̱ne̱-nduwiinxo̱ꞌ xa̱bo̱, ni máꞌ tsíriꞌkhuííxo̱ꞌ ajngáa rawuun Ana̱ꞌlóꞌ. A̱ꞌkhue̱n gakon, nu̱tha̱nxo̱ꞌ rí gakon, jamí ndaꞌyoo Ana̱ꞌlóꞌ rí xkuaꞌnii máꞌ nu̱xna̱xí-mijnáxo̱ꞌ ná inúú mbá xúgíin xa̱bo̱. <verse eid="2CO 4:2" /><verse number="3" style="v" sid="2CO 4:3" />Maske máꞌ xkuaꞌnii, xí xóó máꞌ júgoo ajngáa máján rí nu̱tha̱n-ráꞌaxo̱ꞌ, i̱ndo̱ó máꞌ júgoo ne̱ ná inúú tsí nandáti̱gi̱in. <verse eid="2CO 4:3" /><verse number="4" style="v" sid="2CO 4:4" />Numuu rí gixa̱a̱, tsí naꞌthán-ñájun ná numbaa ríge̱ꞌ, nirugoo̱ inúú xa̱bo̱ tsí tsínimbu̱únꞌ kajngó ma̱xáfruꞌúu̱n, ni máꞌ ma̱xámbiꞌñúu̱ gáꞌne aguu ajngáa máján rí phú wáá drígo̱o̱ Krísto̱, tsí jaꞌnii xómá jaꞌnii jayu Ana̱ꞌlóꞌ. <verse eid="2CO 4:4" /><verse number="5" style="v" sid="2CO 4:5" />Ído̱ rí nu̱tha̱n-ráꞌaxo̱ꞌ, tsítha̱n-ráꞌaxo̱ꞌ ga̱jma̱á máꞌ numa ikháanꞌxo̱ꞌ, rí nu̱tha̱n-ráꞌaxo̱ꞌ rí Jesukrísto̱ ñajuun Táta̱. Jamí ikháanꞌxo̱ꞌ ñajwanxo̱ꞌ yumbáá tsí nune̱-mba̱ꞌwáanꞌlaꞌ, ga̱jma̱á numuu Jesús. <verse eid="2CO 4:5" /><verse number="6" style="v" sid="2CO 4:6" />Numuu rí jmína̱a̱ꞌ máꞌ Ana̱ꞌlóꞌ tsí nixná-ñájun nákhí wajyúú rí ga̱ri̱gá agu ná mijína, niꞌnii̱ rí ma̱mbiꞌi aguu̱ ná awúun a̱kia̱nꞌlóꞌ, kajngó ma̱goo mbu̱ꞌyáálóꞌ rí phú wáá rí jaꞌnii Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ rí nduꞌyáálóꞌ inuu Jesukrísto̱.<verse eid="2CO 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 4:7" />Xómáꞌ Ana̱ꞌlóꞌ nirakhuáa̱ agu rúꞌkhue̱n, rí phú gíꞌdoo numuu, ná awúun daan ju̱ba̱ꞌ, rí ñajwanxo̱ꞌ ikháanꞌxo̱ꞌ. Kajngó ma̱kujma rí Ana̱ꞌlóꞌ ñajuun tsí phú mba̱a̱ ski̱yu̱u̱ꞌ, ra̱ꞌkhá ikháanꞌxo̱ꞌ. <verse eid="2CO 4:7" /><verse number="8" style="v" sid="2CO 4:8" />Ikhaa jngó, maske máꞌ na̱ꞌkha̱ mbá xúgíí inii gaꞌkho̱ inaxo̱ꞌ, na̱nguá máꞌ eꞌne ma̱mbá ski̱ya̱ꞌxo̱ꞌ. Maske máꞌ phú najmáxo̱ꞌ, na̱nguá máꞌ eꞌne ma̱wabáanꞌxo̱ꞌ. <verse eid="2CO 4:8" /><verse number="9" style="v" sid="2CO 4:9" />Maske máꞌ nuxkaxo̱ꞌ xa̱bo̱, na̱nguá máꞌ iniñaxo̱ꞌ Ana̱ꞌlóꞌ. Maske máꞌ nangáxáanꞌxo̱ꞌ ene̱ xa̱bo̱, tsíꞌngúu̱n máꞌ gúne̱-gámbáa̱nꞌxo̱ꞌ. <verse eid="2CO 4:9" /><verse number="10" style="v" sid="2CO 4:10" />Asndo náá máꞌ nakuáxo̱ꞌ, jámba̱ miꞌtsú ngamí ma̱ja̱ñáxo̱ꞌ xómá rí nijáñuu Jesús numuu rí nu̱míni̱íxo̱ꞌ xómá rí nimínu̱u̱ꞌ ikhaa̱, kajngó ma̱kujma mangaa rí Jesús xtáa ndaꞌya ga̱jma̱á majña̱ꞌ ikháanꞌxo̱ꞌ. <verse eid="2CO 4:10" /><verse number="11" style="v" sid="2CO 4:11" />Numuu rí ikháanꞌxo̱ꞌ tsáanꞌ ndu̱ya̱xo̱ꞌ, jámba̱ miꞌtsú ngamí ma̱ja̱ñáxo̱ꞌ ga̱jma̱á numuu Jesús, kajngó ma̱kujma mangaa rí Jesús xtáa̱ ga̱jma̱á majñu̱u̱ xuyaxo̱ꞌ rí wéje̱ máꞌ rí ma̱ja̱ñúu. <verse eid="2CO 4:11" /><verse number="12" style="v" sid="2CO 4:12" />Ikhaa jngó, ikháanꞌxo̱ꞌ ngamí ma̱ja̱ñáxo̱ꞌ, jamí rúꞌkhue̱n naꞌne rí ikháanꞌlaꞌ ma̱juwalaꞌ jámuu.<verse eid="2CO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 4:13" />Ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ: «Ninimbo̱ꞌ, ikhaa jngó ni̱tha̱nlo̱ꞌ».<note caller="+" style="f"><char style="fr" closed="false">4.13 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 116.10.</char></note> Xkuaꞌnii máꞌ mangáanꞌxo̱ꞌ, wéje̱ a̱kia̱nꞌxo̱ꞌ ná inuu Ana̱ꞌlóꞌ, ikhaa jngó nanimba̱ꞌxo̱ꞌ jamí nu̱tha̱nxo̱ꞌ. <verse eid="2CO 4:13" /><verse number="14" style="v" sid="2CO 4:14" />Numuu rí ndu̱ya̱áxo̱ꞌ rí Ana̱ꞌlóꞌ neꞌne rí mbayáa mbiꞌyuu Táta̱ Jesús, jamí ikhaa̱ máꞌ ma̱ꞌnii̱ rí mbu̱ya̱a mbiꞌyaxo̱ꞌ ikháanꞌxo̱ꞌ mangaa ga̱jma̱á nindxu̱u̱ Jesús, a̱ꞌkhue̱n ma̱ꞌga jaguáa̱nꞌxo̱ꞌ ná inuu̱ máꞌ ikhaa̱ ga̱jma̱á nindxa̱ꞌlaꞌ ikháanꞌlaꞌ. <verse eid="2CO 4:14" /><verse number="15" style="v" sid="2CO 4:15" />Mbá xúgíí ríge̱ꞌ nu̱gíꞌnííxo̱ꞌ ga̱jma̱á numuu rí mambáyálaꞌ ikháanꞌlaꞌ, kajngó xómá rí na̱ka̱-raꞌne mbaꞌiin tsí na̱gu̱ma-tsakun-rámii eꞌne Ana̱ꞌlóꞌ, xkuaꞌnii máꞌ ma̱ꞌga-raꞌne mbaꞌiin tsí mu̱rígu̱u la gamaku inuu̱, kajngó ma̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ.<verse eid="2CO 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 4:16" />Ikhaa numuu rúꞌkhue̱n, tsíꞌne níꞌnga̱ꞌxo̱ꞌ. Maske na̱ka̱-raꞌne wayuu máꞌ xúꞌkhue̱n xuyaxo̱ꞌ, xómáꞌ a̱kia̱nꞌxo̱ꞌ mbámbá mbiꞌi na̱ka̱-raꞌne nuxi̱iꞌ ne̱. <verse eid="2CO 4:16" /><verse number="17" style="v" sid="2CO 4:17" />Numuu rí na̱nguá máꞌ gakhe̱ rí nu̱míni̱íxo̱ꞌ ná numbaa ríge̱ꞌ, mbá nanújngoo máꞌ ne̱. I̱ndo̱ó máꞌ numuu rí ikhaa ne̱ ma̱ꞌne rí phú mba̱a̱ jamí jámuu ma̱gi̱ꞌdoo numaxo̱ꞌ nda̱wa̱á. <verse eid="2CO 4:17" /><verse number="18" style="v" sid="2CO 4:18" />Ikhaa jngó, ikháanꞌxo̱ꞌ tsíya̱xi̱íxo̱ꞌ rí nakujma xúge̱ꞌ, rí nu̱ya̱xi̱íxo̱ꞌ rí tsíkujma. Numuu rí nandoo nduꞌyáálóꞌ, mbégo máꞌ ríga̱ ne̱, xómáꞌ rí tsíkujma mbu̱ꞌyáálóꞌ rá, jámuu ríga̱ ne̱.<verse eid="2CO 4:18" /></para>
  <chapter eid="2CO 4" />
  <chapter number="5" style="c" sid="2CO 5" />
  <para style="s">Guꞌwálóꞌ rí ríga̱ ná mikhuíí</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 5:1" />Numuu rí nduꞌyáálóꞌ máꞌ rí ído̱ gángudi-ri̱ga̱a guꞌwá-xtíin dríga̱ꞌlóꞌ ríge̱ꞌ, rí ñajuun xuyalóꞌ, Ana̱ꞌlóꞌ gíꞌdoo mbá guꞌwá rí maxnálóꞌ ná mikhuíí, rí jámuu ríga̱. Ra̱ꞌkhá ga̱jma̱á ñawúún xa̱bo̱ numbaa ni̱gu̱ma guꞌwá rúꞌkhue̱n. <verse eid="2CO 5:1" /><verse number="2" style="v" sid="2CO 5:2" />Gakon máꞌ rí phú nu̱guwanlóꞌ awúun mbiꞌi rí juwalóꞌ ná awúun xuyalóꞌ, jamí naꞌne máꞌ a̱kia̱nꞌlóꞌ rí ma̱ta̱ꞌa̱lóꞌ ná awúun guꞌwálóꞌ rí ríga̱ ná mikhuíí. <verse eid="2CO 5:2" /><verse number="3" style="v" sid="2CO 5:3" />Xkuaꞌnii kajngó ma̱ju̱ꞌwáanꞌlóꞌ xtíñalóꞌ rí nuxe̱ꞌ, jamí ma̱xákujma rí tsaꞌtsáánlóꞌ. <verse eid="2CO 5:3" /><verse number="4" style="v" sid="2CO 5:4" />Awúun mbiꞌi rí juwalóꞌ ná awúun guꞌwá-xtíin ríge̱ꞌ, rí ñajuun xuyalóꞌ, phú nu̱guwanlóꞌ jamí najmálóꞌ. Ra̱ꞌkhá máꞌ numuu nandalóꞌ rí ma̱ga̱jnáaꞌlóꞌ ná awúun xuyalóꞌ rí wayuu, rí phú naꞌne a̱kia̱nꞌlóꞌ ñajuun rí ma̱ta̱ꞌa̱aꞌlóꞌ ná awúun xuyalóꞌ rí nuxe̱ꞌ, kajngó xuyalóꞌ rí najáñuu ma̱ga̱n-roꞌoo ne̱ xuyalóꞌ rí ndaꞌya. <verse eid="2CO 5:4" /><verse number="5" style="v" sid="2CO 5:5" />Ana̱ꞌlóꞌ neꞌne-ku̱máa̱ꞌlóꞌ rí ma̱ꞌnii̱ xkuaꞌnii ga̱jma̱á nindxa̱ꞌlóꞌ, jamí nixniálóꞌ Xu̱u̱ꞌ tsí nasngájma rí ma̱ꞌne-mbánuu̱ rí nixuda-mine̱e̱ꞌ ma̱ꞌnii̱.<verse eid="2CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 5:6" />Ikhaa jngó, jámba̱ miꞌtsú mbá jañii a̱kia̱nꞌlóꞌ juwalóꞌ, maske máꞌ nduꞌyáálóꞌ rí awúun mbiꞌi rí juwalóꞌ ná awúun xuyalóꞌ ríge̱ꞌ, tsíngua̱ꞌ juwalóꞌ ná inuu Táta̱. <verse eid="2CO 5:6" /><verse number="7" style="v" sid="2CO 5:7" />Numuu rí na̱nguá máꞌ juwalóꞌ ga̱jma̱á numuu rí nduꞌyáálóꞌ, rí juwalóꞌ ga̱jma̱á numuu rí wéje̱ a̱kia̱nꞌlóꞌ ná inuu Ana̱ꞌlóꞌ. <verse eid="2CO 5:7" /><verse number="8" style="v" sid="2CO 5:8" />Ikhaa numuu rúꞌkhue̱n mbá jañii a̱kia̱nꞌlóꞌ, jamí i̱tha̱án máꞌ naꞌne a̱kia̱nꞌlóꞌ rí náxájuwalóꞌ ná awúun xuyalóꞌ ríge̱ꞌ, kajngó ma̱juwalóꞌ ga̱jma̱á nindxu̱u̱ Táta̱. <verse eid="2CO 5:8" /><verse number="9" style="v" sid="2CO 5:9" />Ikhaa jngó nuꞌxná-mijnálóꞌ tsiakhe̱ rí mu̱ꞌne̱lóꞌ rí na̱ni̱gu̱u̱ꞌ Ana̱ꞌlóꞌ, ga̱ꞌne máꞌ xí juwalóꞌ ná awúun xuyalóꞌ o nijáñalóꞌ máꞌ mbo̱ꞌ. <verse eid="2CO 5:9" /><verse number="10" style="v" sid="2CO 5:10" />Numuu rí mbá xúgiáanꞌlóꞌ ndaꞌyóo rí mu̱xna̱xí-mijnálóꞌ ná inuu Krísto̱, kajngó maxúꞌdaa̱ awan ga̱jma̱á numalóꞌ. A̱ꞌkhue̱n rí mbámbáa ma̱grui̱gúu rí jaꞌyoo mbayáa ga̱jma̱á numuu rí máján o rí ra̱máján neꞌne nákhí nixtáa̱ ná awúun xuyuu.<verse eid="2CO 5:10" /></para>
  <para style="s">Ana̱ꞌlóꞌ naꞌgí-mina̱ꞌ rí tsímáá gámbáxii̱ gajmíi̱ xa̱bo̱ numbaa</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 5:11" />Numuu rí ikháanꞌxo̱ꞌ ndu̱ya̱áxo̱ꞌ rí jaꞌyoo rí mi̱tiamakuíí Táta̱, ikhaa numuu rúꞌkhue̱n nu̱xna̱-mijnáxo̱ꞌ tsiakhe̱ rí i̱ꞌwíin xa̱bo̱ ma̱nimbu̱únꞌ juyáa̱. Xómáꞌ Ana̱ꞌlóꞌ naꞌne-nuwáanꞌxo̱ꞌ máꞌ, jamí gúꞌthu̱u̱n rí ikháanꞌ mangáanꞌlaꞌ nu̱ne̱-nuwáanꞌxo̱ꞌ máꞌ. <verse eid="2CO 5:11" /><verse number="12" style="v" sid="2CO 5:12" />Ra̱ꞌkhá máꞌ nu̱tha̱nxo̱ꞌ rí máján ga̱jma̱á numa máꞌ ikháanꞌxo̱ꞌ mbu̱júꞌ ná inalaꞌ. I̱ndo̱ó máꞌ nandaxo̱ꞌ rí mbu̱ya̱álaꞌ náá numuu gíꞌmaa rí ma̱ꞌdxu a̱kia̱nꞌlaꞌ ju̱ya̱ꞌxo̱ꞌ, kajngó ma̱ma̱ñalaꞌ rí mu̱riꞌñúúlaꞌ xa̱bo̱ tsí nu̱xu̱xí-mijná ga̱jma̱á numuu rí nakujma ná inuu xa̱bo̱, jamí ra̱ꞌkhá ga̱jma̱á numuu rí ríga̱ ná awúun a̱kui̱in xa̱bo̱. <verse eid="2CO 5:12" /><verse number="13" style="v" sid="2CO 5:13" />Ikhaa jngó, xí xó najmiyaxo̱ꞌ jaꞌnii i̱ya̱álaꞌ, ga̱jma̱á numuu máꞌ Ana̱ꞌlóꞌ rí xkuaꞌnii jaꞌñáaꞌxo̱ꞌ. Jamí xí tsíjmiyaxo̱ꞌ rá, ga̱jma̱á numuu rí mambáyálaꞌ máꞌ ikháanꞌlaꞌ. <verse eid="2CO 5:13" /><verse number="14" style="v" sid="2CO 5:14" />Ga̱jma̱á numuu rí Krísto̱ nandoo jaꞌyalóꞌ, na̱tsu̱dáanꞌxo̱ꞌ rí mu̱ndxa̱ꞌwa̱-mijnáxo̱ꞌ ríge̱ꞌ: rí mbáwíi máꞌ Krísto̱ nijáñuu ga̱jma̱á numúú mbá xúgíin xa̱bo̱, jamí rúꞌkhue̱n iꞌthán rí mbá xúgiáanꞌlóꞌ nijáñalóꞌ. <verse eid="2CO 5:14" /><verse number="15" style="v" sid="2CO 5:15" />Krísto̱ nijáñuu ga̱jma̱á numúú mbá xúgíin xa̱bo̱, kajngó tsí nduya náxájúwe̱e̱ꞌ rí muni̱i̱ rí nandúu̱n ikhii̱n, rí ga̱ju̱wée̱ꞌ rí muni̱i̱ rí nandoo Krísto̱, tsí nijáñuu jamí ndiyáa mbiꞌyuu ga̱jma̱á numúu̱ ikhii̱n.<verse eid="2CO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 5:16" />Ga̱jma̱á numuu rúꞌkhue̱n, ikháanꞌxo̱ꞌ nánguá máꞌ i̱ndxa̱ꞌwa̱-mijnáxo̱ꞌ ga̱jma̱á numuu nimbáa xa̱bo̱ xómá ene̱ jayu xa̱bo̱ ná numbaa ríge̱ꞌ. Maske máꞌ nákhí wajyúú ne̱ne̱-nuwiinxo̱ꞌ Krísto̱ xómá ene̱ jayu xa̱bo̱ ná numbaa ríge̱ꞌ, nánguá máꞌ i̱ya̱áxo̱ꞌ xkuaꞌnii rí xúge̱ꞌ rá. <verse eid="2CO 5:16" /><verse number="17" style="v" sid="2CO 5:17" />Ikhaa jngó, xí mbáa xa̱bo̱ xtáa̱ ga̱jma̱á nindxu̱u̱ Krísto̱, mbáa xa̱bo̱ tsí ni̱gu̱ma-nuxi̱iꞌ ñajuu̱n. Wámba̱ máꞌ mbá xúgíí rí wayuu, jamí mbá xúgíí neꞌne-nuxi̱iꞌ rí xúge̱ꞌ rá. <verse eid="2CO 5:17" /><verse number="18" style="v" sid="2CO 5:18" />Mbá xúgíí rí nuxe̱ꞌ na̱ꞌkha̱ ná inuu Ana̱ꞌlóꞌ, tsí neꞌne rí tsímáá gámbáxi̱iꞌxo̱ꞌ ga̱jma̱á nindxu̱u̱ máꞌ ikhaa̱ ga̱jma̱á majñu̱u̱ Krísto̱. Xúꞌkhue̱n máꞌ nixnángawalóꞌ rí mu̱ꞌthánlóꞌ rí Ana̱ꞌlóꞌ nandoo rí tsímáá gámbáxii̱ gajmíi̱ xa̱bo̱. <verse eid="2CO 5:18" /><verse number="19" style="v" sid="2CO 5:19" />Rúꞌkhue̱n iꞌthán rí jmína̱a̱ꞌ máꞌ Ana̱ꞌlóꞌ naꞌne rí tsímáá gámbáxi̱in xa̱bo̱ numbaa ga̱jma̱á nindxu̱u̱. Ga̱jma̱á majñu̱u̱ Krísto̱ naꞌgí-mine̱e̱ꞌ rí ma̱ꞌne mba̱a̱ a̱kuii̱n jaꞌyoo̱ aꞌkhúún xa̱bo̱. Jamí ikháanꞌxo̱ꞌ nixnángawaxo̱ꞌ Ana̱ꞌlóꞌ rí mu̱thu̱únxo̱ꞌ xa̱bo̱ ajngáa rúꞌkhue̱n. <verse eid="2CO 5:19" /><verse number="20" style="v" sid="2CO 5:20" />Ikhaa jngó, ikháanꞌxo̱ꞌ nixúnguáanꞌxo̱ꞌ Krísto̱ rí mu̱tha̱nxo̱ꞌ ajngóo̱, asndo xó rí jmína̱a̱ꞌ máꞌ Ana̱ꞌlóꞌ naꞌthán-jáñalaꞌ ga̱jma̱á majña̱ꞌ ikháanꞌxo̱ꞌ jaꞌnii. Nu̱tha̱n-jáñalaꞌxo̱ꞌ ga̱jma̱á majñu̱u̱ Krísto̱, rí tsímáá gámbáxi̱iꞌlaꞌ ga̱jma̱á nindxu̱u̱ Ana̱ꞌlóꞌ. <verse eid="2CO 5:20" /><verse number="21" style="v" sid="2CO 5:21" />Krísto̱ táꞌne nimbá aꞌkhán, xómáꞌ Ana̱ꞌlóꞌ neꞌne rí ikhaa̱ mamínu̱u̱ꞌ ga̱jma̱á numuu aꞌkhánlóꞌ, kajngó ikháánꞌlóꞌ ma̱nindxa̱ꞌlóꞌ xa̱bo̱ tsí nánda̱a̱ aꞌkhúún ga̱jma̱á majñu̱u̱ Krísto̱.<verse eid="2CO 5:21" /></para>
  <chapter eid="2CO 5" />
  <chapter number="6" style="c" sid="2CO 6" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 6:1" />Ikhaa jngó, ikháanꞌxo̱ꞌ tsáanꞌ ñajwanxo̱ꞌ máꞌ yumbée Ana̱ꞌlóꞌ, nu̱tha̱n-jáñalaꞌxo̱ꞌ rí ma̱xáꞌne rí ni̱drígúlaꞌ xúgi̱íꞌ rí nixnálaꞌ Ana̱ꞌlóꞌ. <verse eid="2CO 6:1" /><verse number="2" style="v" sid="2CO 6:2" />Numuu rí Ana̱ꞌlóꞌ naꞌthán:</para>
  <para style="b" vid="2CO 6:2" />
  <para style="q" vid="2CO 6:2">«Ído̱ ni̱ga̱nú mbiꞌi rí ma̱dxawaanꞌ, ni̱dxawaanꞌlo̱ꞌ.</para>
  <para style="q" vid="2CO 6:2">Jamí ído̱ ni̱ga̱nú mbiꞌi rí ma̱ne̱-jríñáaꞌ, ni̱mbáyáaꞌlo̱ꞌ».<note caller="+" style="f"><char style="fr" closed="false">6.2 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 49.8.</char></note></para>
  <para style="b" vid="2CO 6:2" />
  <para style="m" vid="2CO 6:2">Ikhaa mbiꞌi rí madxawaanꞌ Ana̱ꞌlóꞌ ñajuun xúge̱ꞌ. Jamí ikhaa mbiꞌi rí ma̱ꞌne-jríñáaꞌ Ana̱ꞌlóꞌ ñajuun xúge̱ꞌ.<verse eid="2CO 6:2" /></para>
  <para style="s">Namínu̱u̱ꞌ jamí naxpígaa a̱kui̱in Páblo̱</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 6:3" />Tsíne̱xo̱ꞌ nimbá rí ma̱ꞌne-ñawúún xa̱bo̱, kajngó mu̱xúthan xkawe̱ꞌ xa̱bo̱ ga̱jma̱á numuu ñajun rí nu̱ne̱xo̱ꞌ. <verse eid="2CO 6:3" /><verse number="4" style="v" sid="2CO 6:4" />A̱ꞌkhue̱n gakon, ga̱jma̱á majñu̱u̱ mbá xúgíí rí nu̱ne̱xo̱ꞌ nu̱snga̱jmáxo̱ꞌ rí yumbée Ana̱ꞌlóꞌ ñajwanxo̱ꞌ. Na̱ꞌngo̱o̱ a̱kia̱nꞌxo̱ꞌ rí mu̱míni̱íxo̱ꞌ, rí ma̱nújngaxo̱ꞌ awúun jamínu̱ꞌ, jamí phú mbaꞌa inii rí nu̱xpígaa a̱kia̱nꞌxo̱ꞌ ju̱ya̱á. <verse eid="2CO 6:4" /><verse number="5" style="v" sid="2CO 6:5" />Nuxnaxo̱ꞌ xa̱bo̱ jamí nu̱xu̱dáa̱nꞌxo̱ꞌ géjwa̱nꞌ. Nu̱xkamiixo̱ꞌ xa̱bo̱ tsí wee jayu i̱ndxa̱ꞌwa̱ rí najiꞌníi juyaxo̱ꞌ. Phú gakhe̱ i̱ñajunxo̱ꞌ, jamí ríga̱ mbiꞌi rí tsínu̱ꞌxo̱ꞌ ni máꞌ tsípeꞌtsoxo̱ꞌ. <verse eid="2CO 6:5" /><verse number="6" style="v" sid="2CO 6:6" />Nu̱snga̱jmáxo̱ꞌ rí yumbée Ana̱ꞌlóꞌ ñajwanxo̱ꞌ ga̱jma̱á majñu̱u̱ rí jaꞌwu juwaxo̱ꞌ, rí nafraꞌa̱ꞌxo̱ꞌ rí gakon, rí na̱ꞌngo̱o̱ a̱kia̱nꞌxo̱ꞌ jamí rí májáan a̱kia̱nꞌxo̱ꞌ. Mbá xúgíí ríge̱ꞌ nu̱ne̱xo̱ꞌ ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ, jamí ga̱jma̱á numuu rí gakon nandaxo̱ꞌ ju̱ñu̱ú xa̱bo̱. <verse eid="2CO 6:6" /><verse number="7" style="v" sid="2CO 6:7" />Nu̱tha̱n-ráꞌaxo̱ꞌ ajngáa rí gakon ga̱jma̱á tsiakhe̱ rí naxnáxo̱ꞌ Ana̱ꞌlóꞌ, jamí nu̱ne̱xo̱ꞌ rí máján. Ikhaa rúꞌkhue̱n ñajuun ski̱ya̱ꞌxo̱ꞌ rí gída̱ꞌ ná ñawún májánxo̱ꞌ jamí ná ñawún xti̱ya̱ꞌxo̱ꞌ. <verse eid="2CO 6:7" /><verse number="8" style="v" sid="2CO 6:8" />Ído̱ nguáná nduya̱-makuaxo̱ꞌ xa̱bo̱, jamí ído̱ nguáná tsíya̱-makuaxo̱ꞌ. Ído̱ nguáná nuthee̱n rí máján ga̱jma̱á numaxo̱ꞌ, jamí ído̱ nguáná nuthan-xkawia̱ꞌxo̱ꞌ. Ído̱ nguáná nuthan xa̱bo̱ rí mixtutáanꞌxo̱ꞌ, jamí ído̱ nguáná nuthee̱n rí kuwáanꞌxo̱ꞌ. <verse eid="2CO 6:8" /><verse number="9" style="v" sid="2CO 6:9" />Ído̱ nguáná nune̱ xa̱bo̱ asndo xó rí tsíne̱-nuwáanꞌxo̱ꞌ, maske máꞌ na̱gu̱ma-nuwáanꞌ májánxo̱ꞌ. Ído̱ nguáná na̱ju̱mu̱ú xa̱bo̱ rí nijáñaxo̱ꞌ máꞌ, xómáꞌ ikháanꞌxo̱ꞌ jaꞌnii máꞌ xóó juwaxo̱ꞌ. Nu̱xpa̱tháanꞌxo̱ꞌ xa̱bo̱, i̱ndo̱ó máꞌ numuu rí ikhii̱n tsíꞌngúu̱n gúradiáa̱nꞌxo̱ꞌ. <verse eid="2CO 6:9" /><verse number="10" style="v" sid="2CO 6:10" />Maske máꞌ nakujma rí juwa-jínáxo̱ꞌ, jámba̱ miꞌtsú nadxu a̱kia̱nꞌxo̱ꞌ. Maske máꞌ nakujma rí mingínáaꞌxo̱ꞌ, xómáꞌ ikháanꞌxo̱ꞌ phú mbaꞌiin xa̱bo̱ nu̱ne̱xo̱ꞌ rí ma̱nindxu̱ún xa̱bo̱ tsí phú guáꞌdáá. Maske máꞌ nakujma rí nda̱a̱ nitháan rí guáꞌdááxo̱ꞌ, xómáꞌ ikháanꞌxo̱ꞌ mbá xúgíí máꞌ guáꞌdááxo̱ꞌ.<verse eid="2CO 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 6:11" />A̱ngui̱nꞌ, xa̱bo̱ Korínto̱, jaꞌwu máꞌ ni̱tha̱nꞌlaꞌxo̱ꞌ mbá xúgíí rí nu̱ndxa̱ꞌwa̱-mijnáxo̱ꞌ. Ni̱rmáꞌtháá mbá jayu a̱kia̱nꞌxo̱ꞌ ná inalaꞌ. <verse eid="2CO 6:11" /><verse number="12" style="v" sid="2CO 6:12" />Ikháanꞌxo̱ꞌ jámba̱ miꞌtsú nandaxo̱ꞌ ju̱ya̱ꞌlaꞌ, i̱ndo̱ó máꞌ ikháanꞌlaꞌ tsíyalaꞌ ju̱ya̱ꞌxo̱ꞌ jámba̱ miꞌtsú. <verse eid="2CO 6:12" /><verse number="13" style="v" sid="2CO 6:13" />Ikhaa jngó, na̱tha̱n-jáñalaꞌ xómá rí mbáa xa̱bo̱ naꞌthán-jáñúú i̱ji̱in, rí ga̱galaꞌ ju̱ya̱ꞌxo̱ꞌ xómá rí ikháanꞌxo̱ꞌ nandaxo̱ꞌ ju̱ya̱ꞌlaꞌ.<verse eid="2CO 6:13" /></para>
  <para style="s">Ma̱xámbáxa̱ꞌ gajmiálaꞌ xa̱bo̱ tsí tsínimbu̱únꞌ juyáá Krísto̱</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 6:14" />Ikháanꞌlaꞌ na̱nguá mbríguáanꞌ gajmiálaꞌ xa̱bo̱ tsí tsínimbu̱únꞌ juyáá Krísto̱, ikhaa jngó mu̱xúda-mijná gajmiálaꞌ. Xáne lá gágoo mu̱wa̱a rí máján ga̱jma̱á rí xkawe̱ꞌ rá. O xáne lá gágoo rí ma̱mbáxu̱u̱ꞌ rí mbiꞌi ga̱jma̱á rí mijína rá. <verse eid="2CO 6:14" /><verse number="15" style="v" sid="2CO 6:15" />Xáne lá gágoo rí ma̱mbáxu̱u̱ꞌ Krísto̱ ga̱jma̱á gixa̱a̱ rá. O xáne lá gágoo rí ma̱mbáxu̱u̱ꞌ tsí nanimbo̱o̱ꞌ jaꞌyoo Krísto̱ ga̱jma̱á tsí tsínimbo̱o̱ꞌ rá. <verse eid="2CO 6:15" /><verse number="16" style="v" sid="2CO 6:16" />Xáne lá gágoo rí ma̱mbáxu̱u̱ꞌ guꞌwá dxákuiin Ana̱ꞌlóꞌ ga̱jma̱á nindxu̱ún tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún rá. Numuu rí ikháanꞌ ñajwanlaꞌ<note caller="+" style="f"><char style="fr" closed="false">6.16 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «ikháánꞌlóꞌ ñajwanlóꞌ».</char></note> guꞌwá dxákuiin Ana̱ꞌlóꞌ tsí xtáa ndaꞌya, xómá rí jmína̱a̱ꞌ máꞌ Ana̱ꞌlóꞌ niꞌthán:</para>
  <para style="q" vid="2CO 6:16">«Ma̱xtáá ná majñúu̱ ikhii̱n jamí ma̱ngrigo̱ꞌ ga̱jma̱á nindxúu̱n.</para>
  <para style="q" vid="2CO 6:16">Ikhúúnꞌ ma̱nindxu̱ꞌ Anúu̱ jamí ikhii̱n ma̱nindxúu̱n xa̱bo̱ xuajñuꞌ.<note caller="+" style="f"><char style="fr" closed="false">6.16 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yi̱i̱ꞌ rí naꞌthán ga̱jma̱á numúú xa̱bi̱i Lebí 26.12, ná I̱yu̱u̱ꞌ Jeremía̱s 32.38, jamí ná I̱yu̱u̱ꞌ Esekiél 37.27.</char></note><verse eid="2CO 6:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="2CO 6:17" />Ikhaa jngó naꞌthán Táta̱ mangaa:</para>
  <para style="q" vid="2CO 6:17">A̱ga̱jnálaꞌ ná majñu̱ú xa̱bo̱ tsúꞌkhue̱n, gu̱ne̱-janíí-mijnálaꞌ.</para>
  <para style="q" vid="2CO 6:17">Mu̱xúru̱gua̱laꞌ rí xkawe̱ꞌ.</para>
  <para style="q" vid="2CO 6:17">A̱ꞌkhue̱n rí ikhúúnꞌ ma̱gruíguáanꞌlaꞌ.<note caller="+" style="f"><char style="fr" closed="false">6.17 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 52.11, jamí ná I̱yu̱u̱ꞌ Esekiél 20.34, 41.</char></note><verse eid="2CO 6:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="2CO 6:18" />Jamí ikhúúnꞌ ma̱nindxu̱ꞌ Ana̱ꞌlaꞌ,</para>
  <para style="q" vid="2CO 6:18">xómáꞌ ikháanꞌlaꞌ ma̱nindxa̱ꞌlaꞌ i̱ji̱nꞌ.</para>
  <para style="q" vid="2CO 6:18">Xkuaꞌnii iꞌthán Táta̱ tsí gíꞌdoo mbá xúgíí tsiakhe̱».<note caller="+" style="f"><char style="fr" closed="false">6.18 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná riajma̱ I̱yu̱u̱ꞌ Samuél 7.8, 14.</char></note><verse eid="2CO 6:18" /></para>
  <para style="b" />
  <chapter eid="2CO 6" />
  <chapter number="7" style="c" sid="2CO 7" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 7:1" />A̱ngui̱nꞌ, tsáanꞌ phú nandoꞌ ja̱ya̱ꞌlaꞌ, ikhaa rúꞌkhue̱n ñajuun rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á numalóꞌ. Ikhaa jngó, gu̱ꞌne̱-jaꞌwu-mijnáalóꞌ jamí gu̱ꞌne̱-janíí-mijnálóꞌ inuu mbá xúgíí rí naꞌne-maꞌchúu xuyalóꞌ jamí nímia̱ꞌlóꞌ. Ga̱juwalóꞌ jaꞌwu mbá jayu ná inuu Ana̱ꞌlóꞌ, numuu rí nduꞌya-makuíi̱lóꞌ.<verse eid="2CO 7:1" /></para>
  <para style="s">Phú nadxu a̱kui̱in Páblo̱ ene̱ xa̱bo̱ Korínto̱</para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 7:2" />Gu̱dríguáanꞌlaꞌxo̱ꞌ ná awúun a̱kia̱nꞌlaꞌ. Asndo nimbáa túñi̱íxo̱ꞌ rí ra̱ꞌkhíin, ni máꞌ nimbáa túne̱-maꞌchíixo̱ꞌ, ni máꞌ nimbáa túrígúxo̱ꞌ mbúkho̱o̱ ga̱jma̱á majñu̱u̱ mi̱nduwa. <verse eid="2CO 7:2" /><verse number="3" style="v" sid="2CO 7:3" />Na̱tha̱nꞌlaꞌ ríge̱ꞌ, ra̱ꞌkhá máꞌ numuu rí ra̱máján e̱ne̱laꞌ, numuu rí ni̱tha̱nꞌlaꞌ máꞌ rí ikháanꞌlaꞌ juwalaꞌ ná awúun a̱kui̱nꞌ, kajngó ma̱juwalóꞌ jamí ma̱ja̱ñálóꞌ mbá ꞌnduꞌ. <verse eid="2CO 7:3" /><verse number="4" style="v" sid="2CO 7:4" />Ikhúúnꞌ phú khiamuꞌ gúꞌdáanꞌlaꞌ jamí phú nadxu a̱kui̱nꞌ ja̱ya̱ꞌlaꞌ. Maske máꞌ phú nu̱míni̱íxo̱ꞌ, phú mba̱a̱ tsiakhe̱ ndayáa la a̱kui̱nꞌ e̱ne̱laꞌ jamí gajni̱í rí gagi ná awúun a̱kui̱nꞌ.<verse eid="2CO 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 7:5" />Asndo nákhí máꞌ niguáꞌnúxo̱ꞌ ná numbaa Masedónia̱, na̱nguá ndi̱ya̱a xa̱ꞌxo̱ꞌ nitháan. A̱ꞌkhue̱n gakon, asndo náá máꞌ nakuáxo̱ꞌ nu̱xkamaaxo̱ꞌ gaꞌkho̱, ne̱ne̱ gajmiáxo̱ꞌ xa̱bo̱ sia̱nꞌ tsí júwa̱ꞌ rixa̱á jamí ga̱jma̱á máꞌ ngamí rí ríga̱ ná awúun a̱kia̱nꞌxo̱ꞌ. <verse eid="2CO 7:5" /><verse number="6" style="v" sid="2CO 7:6" />Xómáꞌ Ana̱ꞌlóꞌ, tsí naꞌne rí mbuya̱a xu̱únꞌ xa̱bo̱ tsí niwabaa a̱kui̱ín, niꞌnii̱ rí mbayáa xu̱u̱ꞌ a̱kia̱nꞌxo̱ꞌ ído̱ rí ni̱ga̱nú Títo̱. <verse eid="2CO 7:6" /><verse number="7" style="v" sid="2CO 7:7" />Ra̱ꞌkhá máꞌ i̱ndo̱ó numuu rí ni̱ga̱níi̱, rí mangaa ga̱jma̱á numuu rí phú nadxu a̱kuii̱n ga̱jma̱á numalaꞌ, numuu rí ikháanꞌlaꞌ phú ni̱xnáa̱laꞌ tsiakhe̱. Ikhaa̱ niꞌthánxo̱ꞌ rí ikháanꞌlaꞌ phú naꞌne a̱kia̱nꞌlaꞌ rí mbu̱ya̱ꞌxo̱ꞌ, xúꞌkhue̱n máꞌ niꞌthánxo̱ꞌ rí phú najmálaꞌ ga̱jma̱á numuu rí niríga̱, jamí rí phú naxná-gamiéjwanlaꞌ ga̱jma̱á numuꞌ ikhúúnꞌ. Rúꞌkhue̱n phú i̱tha̱án neꞌne gagi a̱kui̱nꞌ.<verse eid="2CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 7:8" />Maske máꞌ phú nijuwa-jínálaꞌ neꞌne i̱yi̱i̱ꞌ rí ni̱xu̱ꞌmá inalaꞌ, tsíthanga̱a a̱kui̱nꞌlo̱ꞌ. Gakon máꞌ rí nithanga̱a a̱kui̱nꞌ rí ni̱tháán i̱yi̱i̱ꞌ rúꞌkhue̱n nákhí ginii, numuu ndi̱yo̱o̱ rí neꞌne ne̱ rí ma̱juwa-jínálaꞌ mbégo. <verse eid="2CO 7:8" /><verse number="9" style="v" sid="2CO 7:9" />Rí xúge̱ꞌ rá, phú nadxu a̱kui̱nꞌ, ra̱ꞌkhá numuu ne̱ne̱ rí ma̱juwa-jínálaꞌ, rí ga̱jma̱á numuu rí rúꞌkhue̱n neꞌne rí ma̱thanga̱a a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ. Ikháanꞌlaꞌ nijuwa-jínálaꞌ xómá rí nandoo Ana̱ꞌlóꞌ. Ikhaa jngó, ikháanꞌxo̱ꞌ túña̱ꞌlaꞌxo̱ꞌ nimbá rí ra̱máján. <verse eid="2CO 7:9" /><verse number="10" style="v" sid="2CO 7:10" />Numuu rí jíná rí na̱ꞌkha̱ xómá rí nandoo Ana̱ꞌlóꞌ naꞌne ne̱ rí ma̱thanga̱a a̱kia̱nꞌlóꞌ ná inuu̱ jamí ma̱jríñáaꞌlóꞌ. Ikhaa jngó, ra̱gíꞌmaa rí ma̱tájwíin a̱kia̱nꞌlóꞌ ga̱jma̱á numuu rúꞌkhue̱n. Xómáꞌ jíná rí na̱ꞌkha̱ ná numbaa ríge̱ꞌ naꞌne ne̱ rí ma̱ja̱ñúú xa̱bo̱. <verse eid="2CO 7:10" /><verse number="11" style="v" sid="2CO 7:11" />A̱gu̱ya̱álaꞌ rí Ana̱ꞌlóꞌ neꞌne rí ma̱juwa-jínálaꞌ. Rúꞌkhue̱n neꞌne rí ma̱xná-gamiéjwanlaꞌ ga̱jma̱á numuu rí ni̱tha̱nꞌlaꞌ, neꞌne rí mu̱ndo̱ꞌo̱ꞌlaꞌ rí ma̱ne̱ mba̱a̱ a̱kui̱nꞌ, neꞌne rí ma̱jiꞌnáaꞌlaꞌ ju̱ya̱á rí ra̱máján, jamí neꞌne rí ma̱mi̱ꞌñálaꞌ. Nda̱wa̱á neꞌne a̱kia̱nꞌlaꞌ rí mbu̱yo̱ꞌlaꞌ jamí ne̱ne̱laꞌ rí mamínu̱u̱ꞌ tsí neꞌne rí ra̱ꞌkhíin. Ga̱jma̱á majñu̱u̱ mbá xúgíí rúꞌkhue̱n, ikháanꞌlaꞌ ni̱snga̱jmálaꞌ rí nda̱a̱ aꞌkhánlaꞌ. <verse eid="2CO 7:11" /><verse number="12" style="v" sid="2CO 7:12" />Ikhaa jngó, nákhí rí ni̱tháán i̱yi̱i̱ꞌ rúꞌkhue̱n, tándxa̱ꞌwa̱-mína̱ꞌ ga̱jma̱á numuu tsí neꞌne rí ra̱ꞌkhíin, ni máꞌ tándxa̱ꞌwa̱-mína̱ꞌ ga̱jma̱á numuu tsí nigíꞌnuu rí ra̱ꞌkhíin, rí ni̱tháán i̱yi̱i̱ꞌ rúꞌkhue̱n kajngó mbu̱ya̱álaꞌ rí ikháanꞌxo̱ꞌ phú nandaxo̱ꞌ ju̱ya̱ꞌlaꞌ<note caller="+" style="f"><char style="fr" closed="false">7.12 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán: «mbu̱ya̱álaꞌ rí ikháanꞌlaꞌ phú nandalaꞌ ju̱ya̱ꞌxo̱ꞌ».</char></note> ná inuu Ana̱ꞌlóꞌ. <verse eid="2CO 7:12" /><verse number="13" style="v" sid="2CO 7:13" />Mbá xúgíí rúꞌkhue̱n naꞌne rí mbayáa la tsiakhe̱ a̱kia̱nꞌxo̱ꞌ.</para>
  <para style="p" vid="2CO 7:13">Mbáá máꞌ rí ndiyáa la tsiakhe̱ a̱kia̱nꞌxo̱ꞌ ga̱jma̱á numuu rúꞌkhue̱n, phú i̱tha̱án máꞌ nidxu a̱kia̱nꞌxo̱ꞌ ído̱ ndi̱ya̱áxo̱ꞌ rí phú gagi a̱kui̱in Títo̱, numuu rí mbá xúgiáanꞌ ikháanꞌlaꞌ ni̱mbáyíi̱laꞌ rí ma̱xáxná-gamiéjuu̱n gáꞌne nimbá. <verse eid="2CO 7:13" /><verse number="14" style="v" sid="2CO 7:14" />Numuu rí tágájnuu gamakuꞌ ído̱ ni̱thu̱u̱nlo̱ꞌ Títo̱ rí phú nadxu a̱kui̱nꞌ ja̱ya̱ꞌlaꞌ ikháanꞌlaꞌ. A̱ꞌkhue̱n gakon, xómá rí gakon mbá xúgíí rí ni̱tha̱nꞌlaꞌxo̱ꞌ, xkuaꞌnii máꞌ nikujma rí gakon rí ni̱tha̱ánxo̱ꞌ Títo̱ mangaa, rí phú nadxu a̱kia̱nꞌxo̱ꞌ ju̱ya̱ꞌlaꞌ. <verse eid="2CO 7:14" /><verse number="15" style="v" sid="2CO 7:15" />Jamí Títo̱ i̱tha̱án máꞌ nandoo̱ jaꞌyalaꞌ ído̱ na̱rmáꞌáan a̱kuii̱n rí ne̱ne̱-mbáníílaꞌ rí niꞌthánlaꞌ, jamí ni̱dríguíi̱laꞌ ga̱jma̱á gamaku jamí ngamí. <verse eid="2CO 7:15" /><verse number="16" style="v" sid="2CO 7:16" />Nadxu a̱kui̱nꞌ rí phú khiamuꞌ mbá jayu gúꞌdáanꞌlaꞌ.<verse eid="2CO 7:16" /></para>
  <chapter eid="2CO 7" />
  <chapter number="8" style="c" sid="2CO 8" />
  <para style="s">Mbúkha̱a̱ rí mambáñúú xa̱bi̱i Ana̱ꞌlóꞌ tsí júwa̱ꞌ ná Jerusalén</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 8:1" />A̱ngui̱nꞌ, rí xúge̱ꞌ rá, nandaxo̱ꞌ rí ma̱gi̱da̱ꞌ idxa̱ꞌlaꞌ rí mitsaan naꞌne Ana̱ꞌlóꞌ ga̱jma̱á majñu̱ú mbámbá kuthuun tsí nanimbu̱únꞌ juyáá Jesús ná numbaa Masedónia̱. <verse eid="2CO 8:1" /><verse number="2" style="v" sid="2CO 8:2" />Xa̱bi̱i Ana̱ꞌlóꞌ tsúꞌkhue̱n, phú mbaꞌa inii jamínu̱ꞌ nagóo̱-ranújngúu̱n jamí phú mingíníi̱. Maske máꞌ xúꞌkhue̱n, gajni̱í rí gagi ná awúun a̱kuíi̱n jamí phú mba̱a̱ mbúkha̱a̱ xúwán nuxnee̱. <verse eid="2CO 8:2" /><verse number="3" style="v" sid="2CO 8:3" />Numuu rí ikhúúnꞌ neꞌne inuꞌ rí ikhii̱n máꞌ ndiye̱e̱ idxúu̱n rí muxnee̱ mbá xúgíí rí na̱ꞌngúu̱n, jamí asndo i̱tha̱án máꞌ mba̱a̱ xó rí na̱ꞌngúu̱n. <verse eid="2CO 8:3" /><verse number="4" style="v" sid="2CO 8:4" />Phú mbaꞌa nothon nithan-jáñaxo̱ꞌ rí mu̱ni̱ꞌñúu̱xo̱ꞌ muxnee̱ mangii̱n rí mambáñúú xa̱bi̱i Ana̱ꞌlóꞌ tsí júwa̱ꞌ ná Jerusalén. <verse eid="2CO 8:4" /><verse number="5" style="v" sid="2CO 8:5" />Ikhii̱n nixnee̱ i̱tha̱án máꞌ mba̱a̱ xó rí ikháanꞌxo̱ꞌ ni̱ju̱ma̱ꞌxo̱ꞌ, numuu rí ginii máꞌ ni̱xna̱xí-mijnée̱ ná ñawúun Táta̱ jamí nda̱wa̱á ni̱xna̱xí-mijnée̱ ga̱jma̱á nindxa̱ꞌ ikháanꞌxo̱ꞌ, xómá rí nandoo Ana̱ꞌlóꞌ. <verse eid="2CO 8:5" /><verse number="6" style="v" sid="2CO 8:6" />Ikhaa jngó, ni̱tha̱n-jáñííxo̱ꞌ Títo̱ rí magíꞌmaa̱ ma̱grui̱guíi̱ mbúkha̱a̱ rí nu̱xna̱laꞌ rí mambáñúú xa̱bi̱i Ana̱ꞌlóꞌ, numuu rí ikhaa̱ nigíꞌdu̱u̱n ni̱grui̱guíi̱ ne̱. <verse eid="2CO 8:6" /><verse number="7" style="v" sid="2CO 8:7" />Numuu rí ikháanꞌlaꞌ phú i̱tha̱án guáꞌdáálaꞌ mbá xúgíí: wéje̱ a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ, na̱ma̱ñalaꞌ nu̱tha̱nlaꞌ, nu̱ne̱-nuwiinlaꞌ, na̱ni̱gua̱ꞌlaꞌ rí mu̱mbáñúúlaꞌ xa̱bo̱, jamí nandalaꞌ ju̱ya̱ꞌxo̱ꞌ. Ikhaa jngó, xkuaꞌnii máꞌ guáꞌthi̱ínxo̱ꞌ rí mba̱a̱ gúxna̱laꞌ rí mambáñúú xa̱bi̱i Ana̱ꞌlóꞌ mangaa.<verse eid="2CO 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 8:8" />Ra̱ꞌkhá máꞌ numuu na̱xna̱-ñájwanlaꞌ rí xkuaꞌnii gúne̱laꞌ. I̱ndo̱ó máꞌ nandoꞌ rí ma̱gi̱da̱ꞌ idxa̱ꞌlaꞌ rí júwa̱ꞌ i̱ꞌwíin tsí phú na̱ni̱gúu̱nꞌ rí mu̱mbáyíi̱, kajngó ma̱kujma rí gakon rí nandalaꞌ ju̱ñu̱ú xa̱bo̱ mangáanꞌlaꞌ. <verse eid="2CO 8:8" /><verse number="9" style="v" sid="2CO 8:9" />Numuu rí ndu̱ya̱álaꞌ máꞌ xáne jaꞌnii Tátiálóꞌ Jesukrísto̱. Maske máꞌ ikhaa̱ ñajuu̱n xa̱bo̱ tsí phú gíꞌdoo, neꞌne-mine̱e̱ꞌ xa̱bo̱ ngínáa ga̱jma̱á numuu rí nandoo̱ jaꞌyalaꞌ, kajngó ikháanꞌlaꞌ ma̱nindxa̱ꞌlaꞌ xa̱bo̱ tsí phú guáꞌdáá ga̱jma̱á majñu̱u̱ rí ngínáa̱ ikhaa̱.<verse eid="2CO 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 8:10" />Asndo nákhí máꞌ timbá tsigu, ikháanꞌ gináaꞌlaꞌ jayu ndiyalaꞌ rí mu̱xna̱laꞌ, jamí ikháanꞌ gináaꞌlaꞌ jayu ni̱gíꞌdi̱ínlaꞌ ni̱xna̱laꞌ. Ikhaa jngó, ma̱tha̱nꞌlaꞌ rí na̱ju̱mu̱ꞌ rí jaꞌyoo mu̱ne̱laꞌ: <verse eid="2CO 8:10" /><verse number="11" style="v" sid="2CO 8:11" />phú máján rí mu̱ne̱-gáxi̱ílaꞌ xúge̱ꞌ rí ni̱ni̱ꞌñáálaꞌ mixndu asndo nákhí timbá tsigu, jamí gu̱xna̱laꞌ xómá rí guáꞌdáálaꞌ. Xkuaꞌnii kajngó ma̱kujma rí gakon rí na̱ni̱gua̱ꞌlaꞌ mu̱mbáyíílaꞌ. <verse eid="2CO 8:11" /><verse number="12" style="v" sid="2CO 8:12" />Xí mbáa xa̱bo̱ jayáa a̱kui̱in rí maxná, Ana̱ꞌlóꞌ ma̱grui̱gú rí naxnée̱ xómá rí na̱ꞌngo̱o̱. Numuu rí Ana̱ꞌlóꞌ tsínda̱ꞌe̱e̱ máꞌ rí ra̱gíꞌdoo xa̱bo̱.<verse eid="2CO 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 8:13" />Ra̱ꞌkhá máꞌ rí mu̱xna̱laꞌ kajngó asndo ma̱pi̱ꞌdúun gúne̱ tsí i̱ꞌwíin, xómáꞌ ikháanꞌlaꞌ nda̱a̱ rí mu̱pholaꞌ gáꞌne. I̱ndo̱ó máꞌ na̱tha̱nlo̱ꞌ rí mbéꞌtháán gáꞌne.<note caller="+" style="f"><char style="fr" closed="false">8.13 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ ná rí ajngáa ríge̱ꞌ na̱ꞌkha̱ ná na̱gi̱ꞌdu̱u̱n kíxnuu 14: «I̱ndo̱ó máꞌ na̱tha̱nlo̱ꞌ rí mbéꞌtháán gáꞌne».</char></note> <verse eid="2CO 8:13" /><verse number="14" style="v" sid="2CO 8:14" />Xúge̱ꞌ ikháanꞌlaꞌ guáꞌdáálaꞌ rí mu̱xna̱laꞌ rí ndaꞌñúu̱ ikhii̱n. Nda̱wa̱á ma̱guáꞌdáa̱ ikhii̱n muxnee̱ rí ndaꞌyálaꞌ ikháanꞌlaꞌ. Xkuaꞌnii kajngó mbéꞌtháán gáꞌne. <verse eid="2CO 8:14" /><verse number="15" style="v" sid="2CO 8:15" />Xómá ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ: «Na̱nguá máꞌ nipíduun eꞌne tsí phú mba̱a̱ ni̱gu̱xi̱i, ni máꞌ na̱nguá ndiꞌyóo eꞌne tsí lájwíin ni̱gu̱xi̱i».<note caller="+" style="f"><char style="fr" closed="false">8.15 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ xó nigájna̱á xa̱bo̱ 16.18.</char></note><verse eid="2CO 8:15" /></para>
  <para style="s">Nixúngua̱a̱ꞌ Títo̱ ma̱ꞌga ná Korínto̱</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 8:16" />Núma̱aꞌ la Ana̱ꞌlóꞌ, numuu niꞌnii̱ rí Títo̱ ma̱xná-gamiéjuu̱n gúne̱laꞌ xómá rí naxná-gamiéjunꞌ ikhúúnꞌ e̱ne̱laꞌ. <verse eid="2CO 8:16" /><verse number="17" style="v" sid="2CO 8:17" />Ikhúúnꞌ ni̱ndo̱ꞌo̱o̱ rí ma̱thangaa̱ gáꞌyalaꞌ, xómáꞌ ikhaa̱ phú nadxu a̱kuii̱n niriꞌñee̱ rí ma̱ꞌgee̱, numuu rí mangaa̱ máꞌ phú naxná-gamiéjuu̱n e̱ne̱laꞌ. <verse eid="2CO 8:17" /><verse number="18" style="v" sid="2CO 8:18" />Nu̱xu̱ꞌmáaxo̱ꞌ ga̱jma̱á nindxu̱u̱ Títo̱ mbáa dxájwalóꞌ tsí máján kri̱ga̱ ajngáa numuu ná mbá xúgíí kuthuun tsí nanimbu̱únꞌ juyáá Jesús, ga̱jma̱á numuu rí naꞌthán-ráꞌee̱ ajngáa máján. <verse eid="2CO 8:18" /><verse number="19" style="v" sid="2CO 8:19" />Jamí ra̱ꞌkhá i̱ndo̱ó rúꞌkhue̱n, rí ikhaa̱ máꞌ watraꞌwíi̱ nene̱ mbámbá kuthuun tsí nanimbu̱únꞌ juyáá Jesús, rí ma̱ꞌgee̱ ga̱jma̱á nindxa̱ꞌxo̱ꞌ ído̱ rí mu̱ꞌguá ju̱ya̱ꞌxo̱ꞌ rí mambáñúú xa̱bi̱i Ana̱ꞌlóꞌ ná Jerusalén. Ikháanꞌxo̱ꞌ nu̱gímbúxo̱ꞌ tsi̱gi̱jña̱ꞌ rúꞌkhue̱n kajngó ma̱gu̱ma-mba̱a̱ Táta̱, jamí ma̱kujma rí ikháanꞌlaꞌ phú na̱ni̱gua̱ꞌlaꞌ mu̱mbáyíí.<note caller="+" style="f"><char style="fr" closed="false">8.19 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán: «jamí ma̱kujma rí ikháanꞌxo̱ꞌ phú na̱ni̱gua̱ꞌxo̱ꞌ mu̱mbáyíí».</char></note> <verse eid="2CO 8:19" /><verse number="20" style="v" sid="2CO 8:20" />Xkuaꞌnii kajngó mu̱xúthan xa̱bo̱ numaxo̱ꞌ ga̱jma̱á numuu xó rí nakua ju̱ya̱ꞌxo̱ꞌ mbúkha̱a̱ xúwán rí phú mba̱a̱ nu̱drígúxo̱ꞌ. <verse eid="2CO 8:20" /><verse number="21" style="v" sid="2CO 8:21" />Numuu nandaxo̱ꞌ rí mu̱ne̱xo̱ꞌ ná pa̱jnu mbá xúgíí rí nu̱ne̱xo̱ꞌ, ra̱ꞌkhá máꞌ i̱ndo̱ó ná inuu Táta̱, rí ná inúú máꞌ xa̱bo̱ mangaa.<verse eid="2CO 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CO 8:22" />Nu̱xu̱ꞌmáaꞌxo̱ꞌ i̱mba̱a̱ꞌ dxájwaxo̱ꞌ rí ma̱ꞌga ga̱jma̱á nindxúu̱n mangaa, tsí phú mbaꞌa miꞌtsú ndi̱ya̱áxo̱ꞌ rí máján eꞌne ga̱jma̱á majñu̱u̱ mbaꞌa ñajun rí ni̱xna̱-ñájuu̱n ma̱ꞌnii̱. Jamí xúge̱ꞌ rá, i̱wa̱á máꞌ máján nañajwii̱n, numuu rí mbá jañii a̱kuii̱n jaꞌyalaꞌ. <verse eid="2CO 8:22" /><verse number="23" style="v" sid="2CO 8:23" />Xí mbáa naraxe̱ numuu Títo̱, gu̱tháa̱nlaꞌ rí dxájuꞌ ikhúúnꞌ ñajuu̱n, jamí ikhaa̱ nambáyíꞌ rí mu̱ñajunxo̱ꞌ ga̱jma̱á numalaꞌ ikháanꞌlaꞌ. Xómáꞌ tsí i̱mbá a̱jmi̱i a̱ngia̱nꞌlóꞌ tsí nagóó ga̱jma̱á nindxu̱u̱ Títo̱ rá, ikhii̱n waxúnguii̱nꞌ nene̱ mbámbá kuthuun tsí nanimbu̱únꞌ juyáá Jesús, jamí nduya-makuíi̱ máꞌ Krísto̱ mangii̱n. <verse eid="2CO 8:23" /><verse number="24" style="v" sid="2CO 8:24" />Ikhaa jngó, gu̱snga̱jmálaꞌ rí nandalaꞌ ju̱ñu̱úlaꞌ a̱ngia̱nꞌlóꞌ tsúꞌkhue̱n, kajngó mbuyáá mbámbá kuthuun tsí nanimbu̱únꞌ juyáá Jesús rí numuu rúꞌkhue̱n phú nadxu a̱kia̱nꞌxo̱ꞌ e̱ne̱laꞌ.<verse eid="2CO 8:24" /></para>
  <chapter eid="2CO 8" />
  <chapter number="9" style="c" sid="2CO 9" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 9:1" />Xómáꞌ rí mu̱mbáñúúlaꞌ xa̱bi̱i Ana̱ꞌlóꞌ tsí júwa̱ꞌ ná Jerusalén rá, ni tsíꞌyóo máꞌ rí ma̱tháán ná i̱yi̱i̱ꞌ ríge̱ꞌ ga̱jma̱á numuu rúꞌkhue̱n. <verse eid="2CO 9:1" /><verse number="2" style="v" sid="2CO 9:2" />Numuu nda̱yo̱o̱ mújúnꞌ máꞌ rí ju̱ya̱a̱ a̱kia̱nꞌlaꞌ rí mu̱mbáyíílaꞌ, Jamí phú na̱ku̱xí-mina̱ꞌ ga̱jma̱á numalaꞌ ná inúú a̱ngia̱nꞌlóꞌ tsí júwa̱ꞌ ná numbaa Masedónia̱ ge̱jyoꞌ. Ni̱thúu̱nlo̱ꞌ rí ikháanꞌlaꞌ tsáanꞌ juwalaꞌ ná numbaa Akáya̱ a̱ꞌkhue̱n, rí asndo nákhí máꞌ timbá tsigu juwa-na̱ma̱ñalaꞌ rí mu̱mbáyíílaꞌ. Ído̱ ni̱dxawíi̱n rí xkuaꞌnii, i̱tha̱án máꞌ mbaꞌii̱n na̱wa̱ꞌa̱ a̱kuíi̱n rí mu̱mbáyíi̱ mangii̱n. <verse eid="2CO 9:2" /><verse number="3" style="v" sid="2CO 9:3" />Ikhaa jngó, na̱xu̱ꞌmíilo̱ꞌ a̱ngia̱nꞌlóꞌ tsíge̱ꞌ, kajngó ma̱juwalaꞌ xawi xómá rí ni̱tha̱nlo̱ꞌ ga̱jma̱á numalaꞌ, jamí ma̱xágájnuu gamakuꞌ rí ni̱tha̱n rí máján ga̱jma̱á numalaꞌ. <verse eid="2CO 9:3" /><verse number="4" style="v" sid="2CO 9:4" />Ra̱ꞌkhá magóó mbá tikhuun xa̱bo̱ numbaa Masedónia̱ ga̱jma̱á nindxu̱ꞌ a̱ꞌkhue̱n, jamí mbuyáa̱ rí na̱nguá juwalaꞌ xawi gáꞌne. A̱ꞌkhue̱n rí phú ma̱ti̱yu̱ꞌ rí ni̱tha̱n rí máján ga̱jma̱á numalaꞌ, jamí xúꞌkhue̱n máꞌ phú ma̱ti̱ya̱ꞌlaꞌ mangáanꞌlaꞌ gáꞌne. <verse eid="2CO 9:4" /><verse number="5" style="v" sid="2CO 9:5" />Ikhaa jngó, ikhúúnꞌ ni̱ju̱mu̱ꞌ rí ginii jayu ndaꞌyóo rí ma̱xu̱ꞌmíi a̱ngia̱nꞌlóꞌ tsíge̱ꞌ rí magóo̱ gúyalaꞌ, kajngó mu̱mbáyálaꞌ rí mu̱wa̱a rí ni̱xu̱ꞌdá-mijnálaꞌ máꞌ rí mu̱xna̱laꞌ. Xkuaꞌnii kajngó, ma̱ri̱gá máꞌ xawi rí ju̱ya̱a̱ a̱kia̱nꞌlaꞌ rí mu̱xna̱laꞌ, jamí ra̱ꞌkhá máꞌ numuu rí ikháanꞌxo̱ꞌ nu̱tsu̱dáanꞌlaꞌxo̱ꞌ gáꞌne.<verse eid="2CO 9:5" /></para>
  <para style="s">Tsí naꞌdu mba̱a̱, mba̱a̱ máꞌ gáguu̱ mangaa</para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 9:6" />Ga̱rmáꞌáan a̱kia̱nꞌlaꞌ ríge̱ꞌ: Tsí na̱nguá máꞌ mba̱a̱ iꞌdu, na̱nguá máꞌ mba̱a̱ rí maguu̱ mangaa. Xómáꞌ tsí naꞌdu mba̱a̱, mba̱a̱ máꞌ rí maguu̱ mangaa. <verse eid="2CO 9:6" /><verse number="7" style="v" sid="2CO 9:7" />Mbámbáa gáxná xómá niꞌgí-mina̱ꞌ ná awúun a̱kui̱in rí maxná. Ma̱xáxnée̱ ga̱jma̱á sia̱nꞌ, ni máꞌ ga̱jma̱á tsiakhe̱, numuu rí Ana̱ꞌlóꞌ phú nandoo̱ jaꞌyoo̱ xa̱bo̱ tsí gagi a̱kui̱in naxná. <verse eid="2CO 9:7" /><verse number="8" style="v" sid="2CO 9:8" />Jamí Ana̱ꞌlóꞌ gíꞌdoo̱ tsiakhe̱ rí ma̱ꞌnii̱ rí jámba̱ miꞌtsú ma̱nújngo-rámuu ma̱ri̱gá mbá xúgíí inii rí ndaꞌyálaꞌ. A̱ꞌkhue̱n rí ma̱xáꞌyálaꞌ nitháan rí ma̱juwamalaꞌ, jamí asndo ma̱pi̱ꞌdúun gúne̱laꞌ kajngó ma̱goo mu̱mbáñúúlaꞌ i̱ꞌwíin xa̱bo̱. <verse eid="2CO 9:8" /><verse number="9" style="v" sid="2CO 9:9" />Xómá ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="b" vid="2CO 9:9" />
  <para style="q" vid="2CO 9:9">«Phú mba̱a̱ rí gíꞌdoo̱ nixpíꞌtháa̱ nixnúu̱ tsí ngíníi,</para>
  <para style="q" vid="2CO 9:9">jamí jámba̱ miꞌtsú naꞌnii̱ rí máján».<note caller="+" style="f"><char style="fr" closed="false">9.9 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 112.9.</char></note><verse eid="2CO 9:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="2CO 9:10" />Ana̱ꞌlóꞌ naxnúu tsíga xa̱bo̱ tsí naꞌdu, jamí naꞌnii̱ rí ma̱ri̱gá guma kajngó ma̱kuiꞌtsii̱. Ikhaa̱ máꞌ maxnálaꞌ mbá xúgíí tsíga rí ndaꞌyóo mu̱dulaꞌ mangáanꞌlaꞌ, xúꞌkhue̱n máꞌ ma̱ꞌnii̱ rí mba̱ꞌya ne̱, kajngó phú ma̱jma̱a̱ rí máján gúne̱laꞌ. <verse eid="2CO 9:10" /><verse number="11" style="v" sid="2CO 9:11" />Xkuaꞌnii kajngó ma̱guaꞌdáálaꞌ mbá xúgíí inii rí máján, kajngó ma̱goo mu̱xna̱laꞌ mba̱a̱ rí guáꞌdáálaꞌ. Ído̱ rí ikháanꞌxo̱ꞌ mu̱ꞌguá ju̱ya̱ꞌxo̱ꞌ mbúkha̱a̱ rí mu̱wa̱a gúne̱laꞌ, phú mbaꞌiin a̱ngia̱nꞌlóꞌ mu̱rígu̱u gamaku inuu Ana̱ꞌlóꞌ.<verse eid="2CO 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 9:12" />Numuu rí ga̱jma̱á majñu̱u̱ xtambáyú ríge̱ꞌ, ra̱ꞌkhá máꞌ i̱ndo̱ó nu̱xna̱laꞌ rí ndaꞌñúú xa̱bi̱i Ana̱ꞌlóꞌ, rí rúꞌkhue̱n ma̱ꞌne rí phú mbaꞌii̱n mu̱rígu̱u gamaku inuu Ana̱ꞌlóꞌ. <verse eid="2CO 9:12" /><verse number="13" style="v" sid="2CO 9:13" />Ikhii̱n phú mune̱-mba̱a̱ Ana̱ꞌlóꞌ, numuu rí ga̱jma̱á majñu̱u̱ xtambáyú ríge̱ꞌ, rí phú mba̱a̱ mambáñúu̱ ikhii̱n jamí tsí i̱ꞌwíin xa̱bo̱ mangaa. Mbuyáa̱ rí ikháanꞌlaꞌ nu̱ne̱-mbáníílaꞌ rí naꞌthán ajngáa máján ga̱jma̱á numuu Krísto̱. <verse eid="2CO 9:13" /><verse number="14" style="v" sid="2CO 9:14" />Xúꞌkhue̱n máꞌ ikhii̱n muthán-jáñíi̱ Ana̱ꞌlóꞌ ga̱jma̱á numalaꞌ, tsáanꞌ phú nandúu̱n juyalaꞌ ga̱jma̱á numuu rí ra̱ꞌkhá tháán mba̱a̱ rí máján nixnálaꞌ Ana̱ꞌlóꞌ. <verse eid="2CO 9:14" /><verse number="15" style="v" sid="2CO 9:15" />Núma̱aꞌ la Ana̱ꞌlóꞌ ga̱jma̱á numuu rí nixnálóꞌ, rí tsíꞌngo̱o̱ ajngálóꞌ mu̱ꞌthánlóꞌ xáne jaꞌnii.<verse eid="2CO 9:15" /></para>
  <chapter eid="2CO 9" />
  <chapter number="10" style="c" sid="2CO 10" />
  <para style="s">Páblo̱ naꞌthán-mbáá ga̱jma̱á numuu ñajun rí naꞌne</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 10:1" />Ikhúúnꞌ Páblo̱, tsúún nu̱tha̱nlaꞌ numuꞌ rí phú wabúúnꞌ ído̱ rí xtáá ga̱jma̱á nindxa̱ꞌlaꞌ, jamí phú namangu̱ꞌ ído̱ rí xtáá tsíngua̱ꞌ, na̱tha̱n-jáñalaꞌ ga̱jma̱á majñu̱u̱ rí tsímangu̱u̱ꞌ jamí naꞌne-yádalóꞌ Krísto̱. <verse eid="2CO 10:1" /><verse number="2" style="v" sid="2CO 10:2" />Ikhaa jngó, na̱tha̱n-jáñalaꞌ rí ído̱ ma̱ꞌgá gáya̱ꞌlaꞌ, mu̱xúꞌñúúlaꞌ rí ma̱mangu̱ꞌ ná inalaꞌ, xómá na̱ꞌgí-mina̱ꞌ rí ma̱ne̱lo̱ꞌ ná inúú tsí nuthan rí ikháanꞌxo̱ꞌ nu̱ne̱xo̱ꞌ xómá rí nune̱ jañúú xa̱bo̱ numbaa. <verse eid="2CO 10:2" /><verse number="3" style="v" sid="2CO 10:3" />Gakon máꞌ rí xa̱bo̱ numbaa ñajwanxo̱ꞌ, i̱ndo̱ó máꞌ numuu rí tsítsa̱ña̱ꞌ gajmiáxo̱ꞌ xa̱bo̱ sia̱nꞌ xómá rí nune̱ jañúú xa̱bo̱ numbaa. <verse eid="2CO 10:3" /><verse number="4" style="v" sid="2CO 10:4" />Numuu rí ikháanꞌxo̱ꞌ najmaxo̱ꞌ ski̱yu̱u̱ꞌ Ana̱ꞌlóꞌ, ra̱ꞌkhá ski̱ñu̱ú xa̱bo̱ numbaa, rí mu̱rngudi-ri̱ga̱axo̱ꞌ ski̱yu̱u̱ꞌ xa̱bo̱ sia̱nꞌ. <verse eid="2CO 10:4" /><verse number="5" style="v" sid="2CO 10:5" />Xúꞌkhue̱n máꞌ nu̱ne̱-gámba̱ꞌxo̱ꞌ ju̱ma̱ tsixuxtaa jamí mbá xúgíí inii rí nuthan tsiꞌyá xa̱bo̱, rí na̱we̱je̱-ꞌthu̱u̱n rí i̱ꞌwíin xa̱bo̱ mune̱-nuwiin Ana̱ꞌlóꞌ. Nu̱xna̱xíxo̱ꞌ mbá xúgíí ju̱mu̱ú xa̱bo̱ numbaa ná inuu Krísto̱, kajngó mune̱-mbáníi̱ rí naꞌthée̱n ikhaa̱. <verse eid="2CO 10:5" /><verse number="6" style="v" sid="2CO 10:6" />Jamí juwa máꞌ na̱ma̱ñaxo̱ꞌ rí mu̱ne̱xo̱ꞌ rí ma̱ꞌne-numa̱a aꞌkhúun jámba̱a̱ tsí najñaguii, ído̱ gúya̱áxo̱ꞌ rí ikháanꞌlaꞌ nu̱ne̱-mbáníílaꞌ máꞌ mbá xúgíí.<verse eid="2CO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 10:7" />Ikhúúnꞌ nda̱yo̱o̱ rí ikháanꞌlaꞌ nu̱ya̱xi̱ílaꞌ i̱ndo̱ó máꞌ rí nakujma ná inalaꞌ. Xí mbáa ndaꞌyoo gúkúu rí xa̱bi̱i Krísto̱ ñajuun, gíꞌmaa máꞌ mba̱ꞌyoo̱ rí ikháanꞌ mangáanꞌxo̱ꞌ ñajwanxo̱ꞌ xa̱bi̱i Krísto̱. <verse eid="2CO 10:7" /><verse number="8" style="v" sid="2CO 10:8" />Maske máꞌ asndo xó rí na̱ku̱xí-mina̱ꞌ guéño ga̱jma̱á numuu tsiakhe̱ rí guáꞌdááxo̱ꞌ jaꞌnii, na̱nguá máꞌ i̱ti̱yu̱ꞌ. Numuu rí Táta̱ nixnáxo̱ꞌ tsiakhe̱ rúꞌkhue̱n kajngó mu̱ne̱xo̱ꞌ rí ma̱gajáanꞌlaꞌ, ra̱ꞌkhá rí mu̱ne̱-gámbáanꞌlaꞌxo̱ꞌ. <verse eid="2CO 10:8" /><verse number="9" style="v" sid="2CO 10:9" />Na̱tha̱nꞌlaꞌ ríge̱ꞌ kajngó ma̱xáju̱ma̱ꞌlaꞌ rí nandoꞌ gáne̱-mi̱ꞌñálaꞌ ga̱jma̱á majñu̱u̱ i̱yi̱i̱ꞌ rí na̱ne̱lo̱ꞌ. <verse eid="2CO 10:9" /><verse number="10" style="v" sid="2CO 10:10" />Numuu rí mbá tikhuun nuthan: «Phú namangu̱u̱ꞌ jamí gakhe̱ iꞌthán tsí Páblo̱ ga̱jma̱á majñu̱u̱ i̱yi̱i̱ꞌ rí naꞌtháán. Xómáꞌ ído̱ rí wíji̱i̱ ná inúú xa̱bo̱, phú namíñuu̱ jamí nda̱a̱ numuu rí naꞌthée̱n». <verse eid="2CO 10:10" /><verse number="11" style="v" sid="2CO 10:11" />Xa̱bo̱ tsí nuthan rúꞌkhue̱n, jaꞌyoo ma̱fruꞌúu̱n rí xómá jaꞌnii ajngáxo̱ꞌ ga̱jma̱á majñu̱u̱ i̱yi̱i̱ꞌ rí nu̱ne̱xo̱ꞌ ído̱ rí juwaxo̱ꞌ tsíngua̱ꞌ, xkuaꞌnii máꞌ jaꞌñáaꞌxo̱ꞌ ído̱ rí juwaxo̱ꞌ ga̱jma̱á nindxa̱ꞌlaꞌ mangaa.<verse eid="2CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 10:12" />Numuu rí ikháanꞌxo̱ꞌ, na̱nguá máꞌ i̱ꞌngo̱o̱ a̱kia̱nꞌxo̱ꞌ rí mu̱ne̱-mbrígu-mijnáxo̱ꞌ ni máꞌ rí mu̱giéwan-mijná gajmiáxo̱ꞌ mbá tikhuun tsí nuthan rí máján ga̱jma̱á numúú máꞌ ikhiin. Ído̱ rí nu̱giéwan-mijnée̱, jamí nune̱-mbrígu-mijnée̱ ga̱jma̱á awan rí ni̱ꞌgíi̱ máꞌ ikhii̱n, nu̱snga̱jmee̱ rí tsífruꞌúu̱n mbá jayu. <verse eid="2CO 10:12" /><verse number="13" style="v" sid="2CO 10:13" />Xómáꞌ ikháanꞌxo̱ꞌ, mu̱xúne̱-mba̱a̱-mijnáxo̱ꞌ ga̱jma̱á numuu rí na̱nguá máꞌ jaꞌyaxo̱ꞌ. Ana̱ꞌlóꞌ ñajuun tsí nasngájma asndo náá jayáa rí ma̱goo mu̱ñajunxo̱ꞌ, jamí ikhaa̱ máꞌ niꞌnii̱ rí ma̱guáꞌnúxo̱ꞌ asndo ná juwa ikháanꞌlaꞌ. <verse eid="2CO 10:13" /><verse number="14" style="v" sid="2CO 10:14" />Ikhaa jngó, tága̱táꞌáanꞌxo̱ꞌ máꞌ ná jayáa ndawaa. Xí numuu rí ni miꞌtsú xóó túꞌguáxo̱ꞌ ná juwalaꞌ, a̱ꞌkhue̱n rí ma̱goo mu̱ꞌthánlóꞌ rí ni̱ga̱táꞌáanꞌxo̱ꞌ ná jayáa ndawaa. Numuu rí ikháanꞌ gináaꞌxo̱ꞌ jayu niguáꞌnú ju̱ya̱ꞌxo̱ꞌ ajngáa máján ga̱jma̱á numuu Krísto̱ ná juwalaꞌ. <verse eid="2CO 10:14" /><verse number="15" style="v" sid="2CO 10:15" />Jamí tsítha̱n-tsiꞌyáxo̱ꞌ máꞌ ga̱jma̱á numuu ñajun rí nene̱ i̱ꞌwíin. A̱ꞌkhue̱n gakon, guáꞌthi̱ínxo̱ꞌ rí ma̱ꞌga-ragaja̱a̱ máꞌ xúꞌkhue̱n rí wéje̱ a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ, kajngó ma̱goo ma̱ꞌga-raꞌne mba̱a̱ máꞌ xúꞌkhue̱n ñajun rí nu̱ne̱xo̱ꞌ ga̱jma̱á nindxa̱ꞌlaꞌ. <verse eid="2CO 10:15" /><verse number="16" style="v" sid="2CO 10:16" />Xúꞌkhue̱n máꞌ guáꞌthi̱ínxo̱ꞌ rí mu̱ꞌguá gútha̱n-ráꞌaxo̱ꞌ ajngáa máján ná xuajen rí triga̱ i̱tha̱án tsíngua̱ꞌ ná juwa ikháanꞌlaꞌ, i̱ndo̱ó máꞌ numuu rí mu̱xúne̱-tsiꞌyáxo̱ꞌ ga̱jma̱á numuu ñajun rí nene̱ i̱ꞌwíin. <verse eid="2CO 10:16" /><verse number="17" style="v" sid="2CO 10:17" />A̱ꞌkhue̱n gakon, tsí nandoo gákúxe̱-mina̱ꞌ, gakúxe̱-mine̱e̱ꞌ ga̱jma̱á numuu rí naꞌne Táta̱. <verse eid="2CO 10:17" /><verse number="18" style="v" sid="2CO 10:18" />Numuu ído̱ rí mbáa xa̱bo̱ naꞌthán rí máján ga̱jma̱á numuu máꞌ ikhaa, nda̱a̱ máꞌ rí gíꞌdoo numuu rúꞌkhue̱n. Rí phú i̱tha̱án gíꞌdoo numuu ñajuun rí Ana̱ꞌlóꞌ maꞌthán rí máján ga̱jma̱á numuu xa̱bo̱.<verse eid="2CO 10:18" /></para>
  <chapter eid="2CO 10" />
  <chapter number="11" style="c" sid="2CO 11" />
  <para style="s">Tsí nune̱-nduwa rí Jesukrísto̱ nixúngui̱inꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 11:1" />Gúꞌthu̱u̱n rí mu̱ne̱ mba̱a̱ a̱kia̱nꞌlaꞌ ju̱yo̱ꞌ, maske máꞌ asndo xó rí najágu̱nꞌ jaꞌnii. Gu̱ñu̱ꞌlaꞌ mbá rí máján, gu̱ne̱ mba̱a̱ a̱kia̱nꞌlaꞌ ju̱yo̱ꞌ ga̱jma̱á numuu rí ma̱tha̱nꞌlaꞌ. <verse eid="2CO 11:1" /><verse number="2" style="v" sid="2CO 11:2" />Numuu rí phú naxná-gamiéjunꞌ e̱ne̱laꞌ xómá rí naxná-gamiéjuun Ana̱ꞌlóꞌ e̱ne̱laꞌ. Ikhúúnꞌ gúꞌdáanꞌ nga̱jwáanꞌlaꞌ kajngó mbu̱ya̱a̱laꞌ i̱ndo̱ó máꞌ Krísto̱ rí ma̱ꞌne a̱jmbialaꞌ, jamí ma̱xna̱xáanꞌlaꞌ ná inuu̱ ikhaa̱ xómá mbáa dxáꞌgú tsí xóó máꞌ tábóo ga̱jma̱á nimbáa xa̱bo̱. <verse eid="2CO 11:2" /><verse number="3" style="v" sid="2CO 11:3" />Xómáꞌ ikhúúnꞌ namíñuꞌ rí ma̱gu̱ma-nduwáanꞌlaꞌ, xómá rí ni̱gu̱ma-nduwaa Éba̱ neꞌne a̱bo̱ꞌ ga̱jma̱á numuu rí phú wiphii̱ rí ma̱ꞌne-nduwee̱. A̱ꞌkhue̱n rí ma̱ꞌkhiáanꞌlaꞌ jamí mu̱ni̱ꞌñáálaꞌ rí mbá jaꞌwu a̱kia̱nꞌlaꞌ nu̱ndxa̱ꞌwa̱-mijnálaꞌ ju̱ya̱á i̱ndo̱ó máꞌ Krísto̱. <verse eid="2CO 11:3" /><verse number="4" style="v" sid="2CO 11:4" />Numuu rí ikháanꞌlaꞌ phú gagi máꞌ a̱kia̱nꞌlaꞌ nu̱dríguíilaꞌ asndo tsáa máꞌ tsí naꞌthán-ráꞌalaꞌ ga̱jma̱á numuu i̱mba̱a̱ꞌ Jesús, tsí kriꞌkhuii xó rí ikháanꞌxo̱ꞌ ni̱sngálaꞌ. Phú nadxu máꞌ a̱kia̱nꞌlaꞌ xí mbáa naꞌthánlaꞌ rí mu̱dríguíilaꞌ i̱mba̱a̱ꞌ tsí kriꞌkhuii xó rí Xu̱u̱ꞌ Ana̱ꞌlóꞌ tsí ni̱dríguíilaꞌ máꞌ. Jamí phú gagi máꞌ a̱kia̱nꞌlaꞌ nu̱drígúlaꞌ i̱mba̱ ajngáa máján, rí kriꞌkhu xó rí ni̱drígúlaꞌ máꞌ. <verse eid="2CO 11:4" /><verse number="5" style="v" sid="2CO 11:5" />Xómáꞌ ikhúúnꞌ tsíju̱mu̱ꞌ rí i̱tha̱án gíꞌdoo numúu̱ ikhii̱n xó rí ikhúúnꞌ, «tsí waxúngui̱inꞌ mbo̱ na̱ma̱ñúú mi̱ndaꞌkho» kuaꞌdiinlaꞌ a̱ꞌkhue̱n. <verse eid="2CO 11:5" /><verse number="6" style="v" sid="2CO 11:6" />Maske máꞌ gakon rí tsíma̱ñuꞌ gátha̱n mújúnꞌ ná inúú xa̱bo̱, ra̱ꞌkhá máꞌ rúꞌkhue̱n iꞌthán rí nda̱a̱ rí i̱ma̱ñuꞌ mangaa. Jamí ikháanꞌlaꞌ ndu̱ya̱á májánlaꞌ mbá xúgíí rúꞌkhue̱n, ga̱jma̱á majñu̱u̱ mbá xúgíí rí ne̱ne̱xo̱ꞌ ná inalaꞌ.<verse eid="2CO 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 11:7" />Náá rí ra̱máján ne̱ne̱ róꞌ. Ikhúúnꞌ táru̱máaꞌlaꞌ nitháan nákhí ni̱tha̱n-ráꞌalaꞌ ajngáa máján drígo̱o̱ Ana̱ꞌlóꞌ. Ni̱xrígú-mina̱ꞌ kajngó ma̱gi̱ꞌdoo numalaꞌ ikháanꞌlaꞌ. <verse eid="2CO 11:7" /><verse number="8" style="v" sid="2CO 11:8" />Ni̱rígú-jáꞌñúú mbúkha̱a̱ i̱ꞌwíin kuthuun tsí nanimbu̱únꞌ juyáá Jesús, numuu rí ni̱gruígú rí nune̱ numuꞌ kajngó ma̱xtáá rí ma̱ne̱-mba̱ꞌwáanꞌlaꞌ ikháanꞌlaꞌ. <verse eid="2CO 11:8" /><verse number="9" style="v" sid="2CO 11:9" />Maske máꞌ ndiꞌyóꞌ rí ma̱xtáá-muꞌ nákhí rí nixtáá ga̱jma̱á nindxa̱ꞌlaꞌ, táne̱-gajmúu asndo nimbáa rí maxníꞌ ne̱. Numuu rí a̱ngia̱nꞌlóꞌ tsí niguwá ná numbaa Masedónia̱ nixniꞌ rí ndiꞌyóꞌ. Ni̱ꞌgí-mina̱ꞌ rí ma̱xáne̱-gajmálaꞌ asndo nitháan, jamí xkuaꞌnii máꞌ na̱ꞌgí-mina̱ꞌ asndo xúge̱ꞌ. <verse eid="2CO 11:9" /><verse number="10" style="v" sid="2CO 11:10" />Xómá gakon rí ríga̱ ajngóo Krísto̱ ná awúun a̱kui̱nꞌ, xkuaꞌnii máꞌ gakon i̱tha̱nꞌlaꞌ rí asndo nimbáa tsí xtáa ná numbaa Akáya̱ ma̱xárígú-jáꞌyúꞌ gagi ríge̱ꞌ rí gúꞌdo̱ꞌ ga̱jma̱á numuu rí na̱ne̱lo̱ꞌ. <verse eid="2CO 11:10" /><verse number="11" style="v" sid="2CO 11:11" />Náá numuu kajngó xkuaꞌnii i̱tha̱n róꞌ. Numuu rí tsíyoꞌ ja̱ya̱ꞌlaꞌ ráanꞌ. Ndaꞌyoo Ana̱ꞌlóꞌ rí nandoꞌ ja̱ya̱ꞌlaꞌ.<verse eid="2CO 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 11:12" />Xómáꞌ ikhúúnꞌ ma̱ne̱ máꞌ xómá rí na̱ne̱ asndo xúge̱ꞌ, kajngó ma̱xágoo rí mune̱-tsiꞌyá xa̱bo̱ tsúꞌkhue̱n, ni máꞌ mu̱xúne̱ mbrígu-mijnée̱ ga̱jma̱á nindxa̱ꞌxo̱ꞌ. <verse eid="2CO 11:12" /><verse number="13" style="v" sid="2CO 11:13" />Numuu rí xa̱bo̱ tsúꞌkhue̱n nune̱-nduwee̱ rí waxúnguii̱nꞌ neꞌne Krísto̱. Yumbáá tsí nu̱drígú-jáꞌñúú xa̱bo̱ ga̱jma̱á majñu̱u̱ rí mi̱nduwa ñajúu̱n, tsí na̱ka̱ma̱xu̱ún rí waxúngui̱inꞌ neꞌne Krísto̱. <verse eid="2CO 11:13" /><verse number="14" style="v" sid="2CO 11:14" />Jamí na̱nguá máꞌ gíꞌmaa rí ma̱makualóꞌ gáꞌne rúꞌkhue̱n, numuu rí jmína̱a̱ꞌ máꞌ Satanás naꞌne-mine̱e̱ꞌ xómá ánje̱l tsí nambiꞌi-taꞌaa mangaa̱. <verse eid="2CO 11:14" /><verse number="15" style="v" sid="2CO 11:15" />Ikhaa jngó, na̱nguá máꞌ gíꞌmaa rí ma̱makualóꞌ xí yumbée̱ nune̱-máján-mijnée̱ mangii̱n xómá xa̱bo̱ tsí nune̱ rí máján. Xómáꞌ ikhii̱n mu̱dríguíi̱ jamínu̱ꞌ xómá jaꞌyoo rí nini̱i̱.<verse eid="2CO 11:15" /></para>
  <para style="s">Rí gakhe̱ ni̱ka̱-ranújngoo Páblo̱</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 11:16" />Na̱tha̱nꞌlaꞌ mbu̱júꞌ: Asndo nimbáa ma̱xáju̱mu̱u̱ rí najmiyuꞌ. I̱ndo̱ó máꞌ xí na̱ju̱ma̱ꞌlaꞌ rí gakon rí najmiyuꞌ rá mbo̱ꞌ, gu̱ni̱ꞌñúꞌlaꞌ rí ma̱tha̱nꞌlaꞌ xómá xa̱bo̱ tsí najmiyuu xúꞌkhue̱n rá, kajngó ma̱ku̱xí-mina̱ꞌ mbá lájwíin wáa mangúúnꞌ. <verse eid="2CO 11:16" /><verse number="17" style="v" sid="2CO 11:17" />Ído̱ na̱tha̱nlo̱ꞌ rí phú ríga̱ rí ma̱ku̱xí-mina̱ꞌ ga̱jma̱á numuu mangúúnꞌ, tsítha̱nlo̱ꞌ xómá rí nandoo Táta̱, rí na̱tha̱n xómá mbáa xa̱bo̱ tsí najmiyuu. <verse eid="2CO 11:17" /><verse number="18" style="v" sid="2CO 11:18" />Numuu rí phú mbaꞌiin xa̱bo̱ na̱ni̱gu̱ún rí mune̱-tsiꞌyá ga̱jma̱á numuu rí nune̱ ná numbaa, ikhaa jngó ma̱goo máꞌ ma̱ne̱-tsiꞌyá mangúúnꞌ. <verse eid="2CO 11:18" /><verse number="19" style="v" sid="2CO 11:19" />Numuu rí ikháanꞌlaꞌ ñajwanlaꞌ xa̱bo̱ tsí phú na̱ma̱ñúú mi̱ndaꞌkho, ikhaa jngó phú gagi a̱kia̱nꞌlaꞌ nu̱drígúunlaꞌ xa̱bo̱ tsí najmiñúú. <verse eid="2CO 11:19" /><verse number="20" style="v" sid="2CO 11:20" />Na̱ꞌngo̱o̱ guéño máꞌ a̱kia̱nꞌlaꞌ ju̱ñu̱ú tsí nuxna-ñajwanlaꞌ asndo xómá rí yumbáá tsí waꞌtsi̱in ñajwanlaꞌ, tsí naꞌpho̱-jaꞌyálaꞌ, tsí nune̱-ku̱ꞌwálaꞌ ga̱jma̱á majñu̱u̱ mi̱nduwa, tsí nu̱xu̱xí-mijná ná inalaꞌ, jamí tsí nu̱xpa̱thún inalaꞌ. <verse eid="2CO 11:20" /><verse number="21" style="v" sid="2CO 11:21" />Phú mate̱ꞌ inuꞌ na̱tha̱nꞌlaꞌ rí ikháanꞌxo̱ꞌ táꞌngo̱o̱ a̱kia̱nꞌxo̱ꞌ rí mu̱ña̱ꞌlaꞌ xkuaꞌnii, numuu rí phú wabáanꞌxo̱ꞌ.</para>
  <para style="p" vid="2CO 11:21">Xí i̱ꞌwíin tsíti̱ñu̱ú rí mune̱-mba̱a̱-mijná, ma̱goo máꞌ ma̱ne̱-mba̱a̱-mina̱ꞌ mangúúnꞌ, maske máꞌ na̱tha̱n xómá xa̱bo̱ tsí najmiyuu. <verse eid="2CO 11:21" /><verse number="22" style="v" sid="2CO 11:22" />Á xa̱bo̱ ebréo̱ ñajúu̱n ikhii̱n dxe̱ꞌ. Ikhaa máꞌ ñajunꞌ mangúúnꞌ. Á xa̱bi̱i Israél ñajúu̱n ikhii̱n dxe̱ꞌ. Ikhaa máꞌ ñajunꞌ mangúúnꞌ. Á xa̱bo̱ ri̱jyu̱u̱ꞌ Abraám ñajúu̱n ikhii̱n dxe̱ꞌ. Ikhaa máꞌ ñajunꞌ mangúúnꞌ. <verse eid="2CO 11:22" /><verse number="23" style="v" sid="2CO 11:23" />Á yumbée Krísto̱ ñajúu̱n ikhii̱n dxe̱ꞌ. I̱tha̱án máꞌ yumbée Krísto̱ ñajunꞌ ikhúúnꞌ xó rí ikhii̱n, maske máꞌ xómá eꞌne xa̱bo̱ tsí najmiyuu e̱ne̱ rí na̱tha̱n ríge̱ꞌ. Numuu rí i̱tha̱án máꞌ ni̱ñajun ikhúúnꞌ xó rí ikhii̱n, i̱tha̱án máꞌ mbaꞌa nothon waxpáthúún ikhúúnꞌ, i̱tha̱án máꞌ mbaꞌa nothon nikalo̱ꞌ géjwa̱nꞌ ikhúúnꞌ, jamí phú mbaꞌa nothon inu ma̱ja̱ñúꞌlo̱ꞌ. <verse eid="2CO 11:23" /><verse number="24" style="v" sid="2CO 11:24" />Witsu nothon ni̱xpa̱thúún mi̱ndaꞌkho xa̱bo̱ judío̱, rí mbá skíñú gu̱wa̱ꞌ-nítsu i̱kho̱ (39) ni̱xpa̱thii̱n tsu̱du̱ꞌ mbámbá miꞌtsú. <verse eid="2CO 11:24" /><verse number="25" style="v" sid="2CO 11:25" />Atsú nothon nixniꞌ ga̱jma̱á ixe̱. Mbá miꞌtsú waꞌxnúꞌ ga̱jma̱á itsí asndo ma̱ja̱ñúꞌ. Atsú nothon ni̱rmáꞌán jagu̱ún guꞌwá-rguwa. Mbá miꞌtsú nindáti̱gu̱ún mbá mbiꞌi jamí mbá mbroꞌon ná awúun iya a̱pha̱. <verse eid="2CO 11:25" /><verse number="26" style="v" sid="2CO 11:26" />Phú ningrigo̱ꞌ, ge̱e̱ ñúꞌún nikalo̱ꞌ. Ninújngoꞌ ná ngamí ma̱ꞌga jañúú mañuu, jamí ná ngamí ma̱ngujwíin ku̱ꞌwá inuꞌ. Nixtáá ngamí rí ma̱ja̱ñúꞌ gúne̱ xa̱bo̱ judío̱, jamí xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún. Xúꞌkhue̱n máꞌ nixtáá ngamí rí ma̱ja̱ñúꞌ ná xuajen, ná xanáá, ná awúun iya a̱pha̱, jamí ído̱ rí nixtáá ná majñu̱ú xa̱bo̱ tsí mi̱nduwiin rí xa̱bi̱i Ana̱ꞌlóꞌ ñajúún. <verse eid="2CO 11:26" /><verse number="27" style="v" sid="2CO 11:27" />Phú gakhe̱ ni̱ñajunlo̱ꞌ jamí phú gakhe̱ nika-ranújngoꞌlo̱ꞌ. Phú mbaꞌa mbroꞌon ni̱xpígaalo̱ꞌ ninu. Phú mbaꞌa nothon ni̱xki̱dxu̱ꞌ jamí nijándawoꞌ. Phú mbaꞌa miꞌtsú tákuéꞌtsólo̱ꞌ, jamí nijrámu̱ꞌ numuu rí nda̱a̱ xtíin ma̱ju̱wúnꞌlo̱ꞌ. <verse eid="2CO 11:27" /><verse number="28" style="v" sid="2CO 11:28" />Mbáá máꞌ rí nika-ranújngoꞌ mbá xúgíí rúꞌkhue̱n, i̱mba̱ rí naka-ranújngoꞌ xúge̱ꞌ, tsitsíí naxná-gamiéjunꞌ eꞌne mbá xúgíí kuthuun tsí nanimbu̱únꞌ juyáá Jesús. <verse eid="2CO 11:28" /><verse number="29" style="v" sid="2CO 11:29" />Xí mbáa najáñuu, asndo xó rí ikhúúnꞌ máꞌ najáñuꞌ. Xí mbáa naꞌne rí ma̱ꞌne aꞌkhán dxájuu, phú na̱ti̱yu̱ꞌ jamí phú najiꞌnúú.<verse eid="2CO 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2CO 11:30" />Xí ndaꞌyóo rí ma̱ku̱xí-mina̱ꞌ, ma̱ku̱xí-mina̱ꞌ ga̱jma̱á numuu rí wabúúnlo̱ꞌ. <verse eid="2CO 11:30" /><verse number="31" style="v" sid="2CO 11:31" />Ana̱ꞌlóꞌ ndaꞌyoo rí tsíne̱-ndúwalo̱ꞌ. Ikhaa̱ ñajuu̱n Anu̱u̱ Tátiálóꞌ Jesukrísto̱, tsí jámuu mbiꞌi jaꞌyoo rí ma̱gu̱ma-mba̱a̱. <verse eid="2CO 11:31" /><verse number="32" style="v" sid="2CO 11:32" />Nákhí nika ná Damásko̱, xa̱bo̱ ñajun tsí nithán-ñájwíín eꞌne thúngaa Aréta̱s, nixná-ñájwii̱n rí ma̱wa̱jún xa̱bo̱ tsí juda ajwa̱nꞌ ná xkrugua rawuun xuajen, kajngó ma̱goo mu̱rtuwúu̱n. <verse eid="2CO 11:32" /><verse number="33" style="v" sid="2CO 11:33" />I̱ndo̱ó máꞌ numuu rí mbá tikhuun xa̱bo̱ ni̱ra̱khúu̱n ná awúun mbá extu, jamí ni̱xrígúu̱n ná iduu xu̱nꞌ rí narugua-maꞌáan xuajen. Xkuaꞌnii nijríñu̱ú ná ñawúun xa̱bo̱ ñajun.<verse eid="2CO 11:33" /></para>
  <chapter eid="2CO 11" />
  <chapter number="12" style="c" sid="2CO 12" />
  <para style="s">Rí ndiꞌyoo jamí wasngájmáá Páblo̱</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 12:1" />Ikhúúnꞌ nda̱yo̱o̱ mújúnꞌ rí nda̱a̱ máꞌ numuu rí ma̱tha̱n rí máján ga̱jma̱á numuꞌ máꞌ ikhúúnꞌ. I̱ndo̱ó máꞌ numuu rí ndaꞌyóo rí ma̱tha̱nꞌlaꞌ ga̱jma̱á numuu rí ndi̱yo̱o̱ jamí nisngájmiꞌ Táta̱. <verse eid="2CO 12:1" /><verse number="2" style="v" sid="2CO 12:2" />Na̱ne̱-núwíin mbáa xa̱bo̱ tsí na̱ka̱ tsu̱du̱u̱ Krísto̱, tsí nákhí timbá gu̱wa̱ꞌ i̱kho̱ (14) tsigu eꞌne mbá nacha̱ ni̱ka̱ jiꞌyáa̱ asndo ná riatsú awúun mikhuíí. I̱ndo̱ó máꞌ numuu rí tsíyo̱o̱ xí ni̱ka̱ jiꞌyáa̱ ga̱jma̱á máꞌ xuyuu̱ o i̱ndo̱ó máꞌ xu̱u̱ꞌ mbo̱ꞌ, i̱ndo̱ó máꞌ Ana̱ꞌlóꞌ ndaꞌyoo. <verse eid="2CO 12:2" /><verse number="3" style="v" sid="2CO 12:3" />Gakon, i̱ndo̱ó máꞌ Ana̱ꞌlóꞌ ndaꞌyoo xí ni̱ka̱ jiꞌyáa̱ ga̱jma̱á xuyuu̱ o i̱ndo̱ó máꞌ ga̱jma̱á xu̱u̱ꞌ mbo̱ꞌ. I̱ndo̱ó máꞌ numuu rí nda̱yo̱o̱ <verse eid="2CO 12:3" /><verse number="4" style="v" sid="2CO 12:4" />rí mbá nacha̱ ni̱ka̱ jiꞌyáa̱ ná mikhu mitsaan jamí ikhín nidxawuu̱n rí tsíyoo mi̱ꞌthán ga̱jma̱á ajngáa, rí tsíjanáá maꞌthán asndo nimbáa xa̱bo̱ numbaa. <verse eid="2CO 12:4" /><verse number="5" style="v" sid="2CO 12:5" />Ma̱goo ma̱ku̱xí-mina̱ꞌ ikhúúnꞌ ga̱jma̱á numuu xa̱bo̱ tsúꞌkhue̱n, xí numuu rí nandoꞌ, i̱ndo̱ó máꞌ numuu rí ma̱xáne̱. Xómáꞌ ikhúúnꞌ ma̱ku̱xí-mina̱ꞌ i̱ndo̱ó máꞌ ga̱jma̱á numuu rí wabúúnꞌ. <verse eid="2CO 12:5" /><verse number="6" style="v" sid="2CO 12:6" />Xí nandoꞌ rí ma̱ku̱xí-mina̱ꞌ ga̱jma̱á numuu rúꞌkhue̱n, ma̱goo ma̱ne̱lo̱ꞌ, ra̱ꞌkhá máꞌ najmiyuꞌ, numuu rí gakon máꞌ rí na̱tha̱nlo̱ꞌ. I̱ndo̱ó máꞌ numuu rí ma̱xáku̱xí-mina̱ꞌ, kajngó nimbáa ma̱xáju̱mu̱u̱ rí i̱tha̱án máꞌ na̱ma̱ñuꞌ ikhúúnꞌ xó rí ndaꞌyoo̱ na̱ne̱ o xó rí nadxawuu̱n na̱tha̱n mbo̱ꞌ.<verse eid="2CO 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 12:7" />Ikhaa máꞌ numuu rúꞌkhue̱n, rí ma̱xáku̱xí-mina̱ꞌ guéño ga̱jma̱á numuu rí phú wáá rí wasngájmuꞌlo̱ꞌ, ni̱ꞌkha̱ mbá gajmá inuꞌ rí asndo xómá tsuwan jaꞌnii bráꞌa ná xuyuꞌ. Gajmá rúꞌkhue̱n ni̱ꞌkha̱ neꞌne Satanás, kajngó ma̱ꞌnii̱ rí ma̱mínu̱u̱ꞌ, jamí ma̱xánújngo-rámuu guéño rí ma̱ku̱xí-mina̱ꞌlo̱ꞌ. <verse eid="2CO 12:7" /><verse number="8" style="v" sid="2CO 12:8" />Atsú nothon ni̱tha̱n-jáñuu Táta̱ rí marígúu̱ gajmá rúꞌkhue̱n ná xuyuꞌ. <verse eid="2CO 12:8" /><verse number="9" style="v" sid="2CO 12:9" />Xómáꞌ Ana̱ꞌlóꞌ niꞌthínꞌ: «Mbájndi máꞌ rí na̱ne̱-tsakun-rámááꞌ, numuu ído̱ rí ikháánꞌ wabáánꞌ, i̱tha̱án máꞌ nakujma ski̱yu̱ꞌ ikhúúnꞌ». Ikhaa jngó, nadxu a̱kui̱nꞌ na̱tha̱n rí wabúúnꞌ, kajngó ma̱kujma ski̱yu̱u̱ꞌ Krísto̱ ga̱jma̱á nindxu̱ꞌ ikhúúnꞌ. <verse eid="2CO 12:9" /><verse number="10" style="v" sid="2CO 12:10" />Ikhaa numuu rúꞌkhue̱n nadxu a̱kui̱nꞌ rí wabúúnꞌ, rí nuthan-xkawi̱ꞌ xa̱bo̱, rí xtáá ná awúun tsingíná, rí tsíñúú xa̱bo̱ gúyeꞌ, jamí rí na̱mínu̱u̱ꞌ ga̱jma̱á numuu Krísto̱. Numuu ído̱ nda̱yo̱o̱ rí wabúúnꞌ, a̱ꞌkhue̱n rí phú gúꞌdo̱ꞌ tsiakhe̱.<verse eid="2CO 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 12:11" />Xómá eꞌne mbáa xa̱bo̱ tsí najmiyuu e̱ne̱ rí na̱ku̱xí-mina̱ꞌ ná inalaꞌ, xómáꞌ ikhúúnꞌ na̱ne̱ rúꞌkhue̱n numuu rí ikháanꞌlaꞌ ni̱tsu̱dúúnlaꞌ. Ikháanꞌlaꞌ jaꞌyoo mu̱tha̱nlaꞌ rí máján ga̱jma̱á numuꞌ. Maske máꞌ gakon rí nda̱a̱ rí ñajunꞌ, ra̱ꞌkhá máꞌ rúꞌkhue̱n iꞌthán rí i̱tha̱án gíꞌdoo numúu̱ ikhii̱n xó rí ikhúúnꞌ, «tsí waxúngui̱inꞌ mbo̱ na̱ma̱ñúú mi̱ndaꞌkho» kuaꞌdiinlaꞌ a̱ꞌkhue̱n. <verse eid="2CO 12:11" /><verse number="12" style="v" sid="2CO 12:12" />Nákhí nixtáá ga̱jma̱á nindxa̱ꞌlaꞌ ni̱snga̱jmálaꞌ rí ikhúúnꞌ ñajunꞌ mbáa tsí waxúngua̱a̱ꞌ neꞌne Jesukrísto̱. Ni̱snga̱jmálaꞌ rúꞌkhue̱n ga̱jma̱á majñu̱u̱ rí phú mba̱a̱ a̱kui̱nꞌ ne̱ne̱ ná inalaꞌ, xúꞌkhue̱n máꞌ ga̱jma̱á majñu̱u̱ rí phú wáá rí ne̱ne̱ jamí rí phú nimakúún xa̱bo̱ eꞌne. <verse eid="2CO 12:12" /><verse number="13" style="v" sid="2CO 12:13" />Gakon máꞌ rí táne̱ ga̱jma̱á nindxa̱ꞌlaꞌ ikháanꞌlaꞌ xómá rí ne̱ne̱ ga̱jma̱á nindxu̱ún i̱ꞌwíin kuthuun tsí nanimbu̱únꞌ juyáá Jesús: táne̱-gajmálaꞌ rí mu̱xnu̱ꞌlaꞌ rí ndaꞌyóꞌ. Gu̱ne̱ mba̱a̱ a̱kia̱nꞌlaꞌ ju̱yo̱ꞌ xí ne̱ne̱-ñawánlaꞌ ga̱jma̱á numuu rúꞌkhue̱n.<verse eid="2CO 12:13" /></para>
  <para style="s">Páblo̱ naꞌthán rí ma̱ꞌga rí riatsú nothon gáꞌñúú xa̱bi̱i Ana̱ꞌlóꞌ ná Korínto̱</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 12:14" />Rí xúge̱ꞌ rá, xtáá máꞌ na̱ma̱ñuꞌ rí ma̱ꞌgá gáya̱ꞌlaꞌ rí riatsú nothon, jamí ma̱xáne̱-gajmálaꞌ máꞌ rí mu̱xnu̱ꞌlaꞌ rí ndaꞌyóꞌ. Numuu ra̱ꞌkhá rí guáꞌdáálaꞌ i̱ꞌyálo̱ꞌ, rí jmína̱áꞌ máꞌ ikháanꞌlaꞌ naxná-gamiéjunꞌ e̱ne̱laꞌ. Mbáá máꞌ rí ra̱ꞌkhá tsí ñajúún e̱je̱n jaꞌñúu̱ mu̱gímbíi̱ rí ndaꞌñúú anúu̱, rí anúu̱ jaꞌñúú mu̱gímbú rí ndaꞌñúu̱ ikhii̱n. <verse eid="2CO 12:14" /><verse number="15" style="v" sid="2CO 12:15" />Xómáꞌ ikhúúnꞌ phú nadxu a̱kui̱nꞌ rí ma̱jmuꞌ rí gúꞌdo̱ꞌ, xúꞌkhue̱n máꞌ rí ma̱ne̱-gámba̱-mina̱ꞌ ga̱jma̱á numalaꞌ numuu rí nandoꞌ ja̱ya̱ꞌlaꞌ, maske<note caller="+" style="f"><char style="fr" closed="false">12.15 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná naꞌthán xáꞌnii: «Xí ikhúúnꞌ phú nandoꞌ ja̱ya̱ꞌlaꞌ, náá numuu kajngó ikháanꞌlaꞌ mbá lájwíin nandalaꞌ ju̱yo̱ꞌ róꞌ».</char></note> máꞌ ído̱ rí i̱tha̱án nandoꞌ ja̱ya̱ꞌlaꞌ, ikháanꞌlaꞌ mbá lájwíin nandalaꞌ ju̱yo̱ꞌ. <verse eid="2CO 12:15" /><verse number="16" style="v" sid="2CO 12:16" />Ikháanꞌlaꞌ ndu̱ya̱á májánlaꞌ rí táne̱-gajmálaꞌ rí mu̱xnu̱ꞌlaꞌ rí ndaꞌyóꞌ. Maske máꞌ xkuaꞌnii, mbá tikhuun tsí ikháanꞌlaꞌ nuthan rí phú wiphiúún rí ma̱gúwíi mbúkha̱ꞌlaꞌ ga̱jma̱á majñu̱u̱ mi̱nduwa. <verse eid="2CO 12:16" /><verse number="17" style="v" sid="2CO 12:17" />Á ne̱ne̱-ndúwáanꞌlaꞌ ga̱jma̱á majñu̱ú mbá tikhuun xa̱bo̱ tsí ni̱xu̱ꞌmíi rí magóó gúyalaꞌ dxe̱ꞌ. <verse eid="2CO 12:17" /><verse number="18" style="v" sid="2CO 12:18" />Ikhúúnꞌ ni̱tha̱n-jáñuu Títo̱ rí ma̱ꞌga gáꞌyalaꞌ, jamí ni̱xu̱ꞌmáa i̱mba̱a̱ꞌ dxájwalóꞌ ma̱ꞌga ga̱jma̱á nindxu̱u̱. Á neꞌne-nduwáanꞌlaꞌ Títo̱ dxe̱ꞌ. Á ra̱ꞌkhá mbóó máꞌ a̱kia̱nꞌxo̱ꞌ ju̱ya̱ꞌlaꞌ jamí mbóó máꞌ xó e̱ne̱xo̱ꞌ ga̱jma̱á nindxa̱ꞌlaꞌ dxe̱ꞌ.<verse eid="2CO 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CO 12:19" />A̱ngui̱nꞌ, tsáanꞌ phú nandoꞌ ja̱ya̱ꞌlaꞌ, á xóó na̱ju̱ma̱ꞌlaꞌ ikháanꞌlaꞌ rí ikháanꞌxo̱ꞌ nu̱tha̱n-mbáá numaxo̱ꞌ ná inalaꞌ dxe̱ꞌ. I̱ndo̱ó máꞌ numuu rí ra̱ꞌkhá xkuaꞌnii jaꞌnii. A̱ꞌkhue̱n gakon, Ana̱ꞌlóꞌ ndaꞌyoo rí nu̱tha̱nxo̱ꞌ ríge̱ꞌ ga̱jma̱á numuu Krísto̱. Mbá xúgíí ríge̱ꞌ nu̱tha̱nxo̱ꞌ kajngó ma̱ꞌkhiáanꞌlaꞌ ná inuu Ana̱ꞌlóꞌ. <verse eid="2CO 12:19" /><verse number="20" style="v" sid="2CO 12:20" />I̱ndo̱ó máꞌ numuu rí namíñuꞌ rí ma̱xáxkamáaꞌlaꞌ xómá rí naꞌne a̱kui̱nꞌ ído̱ rí ma̱ꞌgá gáya̱ꞌlaꞌ, ni máꞌ ikháanꞌlaꞌ mu̱xúxkamúúlaꞌ xómá rí naꞌne a̱kia̱nꞌlaꞌ. Namíñuꞌ rí ma̱xkamáaꞌlaꞌ na̱tsa̱ña̱ꞌlaꞌ, naxígua̱ꞌlaꞌ, najiꞌnáaꞌlaꞌ ju̱ya̱-mijnálaꞌ, nu̱xpíꞌthá-mijnálaꞌ, nu̱ne̱-xuxtaalaꞌ, nu̱tha̱n numa-mijnálaꞌ, nu̱ku̱xí-mijnálaꞌ jamí nu̱xkaxi̱ilaꞌ xkujndu ná xuajen a̱ꞌkhue̱n. <verse eid="2CO 12:20" /><verse number="21" style="v" sid="2CO 12:21" />Xúꞌkhue̱n máꞌ mangaa namíñuꞌ rí ído̱ ma̱ꞌgá gáya̱ꞌlaꞌ mbu̱júꞌ, Ana̱ꞌlóꞌ ma̱ꞌne rí ma̱ga̱jnúu gamakuꞌ ga̱jma̱á numalaꞌ, jamí rí ma̱mbi̱ya̱ꞌ ga̱jma̱á numúú mbaꞌiin tsí ikháanꞌlaꞌ, tsí wajyúú máꞌ ene̱ aꞌkhán, jamí na̱nguá i̱ni̱ꞌñáa̱ rí nune̱-maꞌchú-mijnée̱, rí nubúu̱n gajmíi̱ xa̱bo̱ tsí túya̱a̱, jamí na̱nguá máꞌ i̱ni̱ꞌñáa̱ rí phú mate̱ꞌ nuni̱i̱.<verse eid="2CO 12:21" /></para>
  <chapter eid="2CO 12" />
  <chapter number="13" style="c" sid="2CO 13" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 13:1" />Ríge̱ꞌ eꞌne riatsú nothon rí ma̱ꞌgá gáya̱ꞌlaꞌ. «Mbámbá rí ma̱gu̱ma-mbáníí numuu, jaꞌyoo rí ma̱ju̱wá a̱jmi̱i o atsúun xa̱bo̱ tsí ndiyáá rí niríga̱». <verse eid="2CO 13:1" /><verse number="2" style="v" sid="2CO 13:2" />Nákhí nika gáya̱ꞌlaꞌ rí riajma̱ nothon, ni̱thu̱ún tsí nune̱ aꞌkhán jamí mbá xúgíin tsí i̱ꞌwíin: «Xí i̱mba̱ miꞌtsú rí ma̱ꞌgá gáya̱ꞌlaꞌ xkuaꞌnii máꞌ xóó e̱ne̱laꞌ, ma̱xáne̱ mba̱a̱ a̱kui̱nꞌ ja̱ya̱ꞌlaꞌ». Ikhaa jngó rí xúge̱ꞌ rá, rí na̱nguá xtáá a̱ꞌkhue̱n, ikhaa máꞌ nathangu̱ún na̱thúu̱n ga̱jma̱á majñu̱u̱ i̱yi̱i̱ꞌ rí na̱xu̱ꞌmá ná inalaꞌ. <verse eid="2CO 13:2" /><verse number="3" style="v" sid="2CO 13:3" />Numuu rí ikháanꞌlaꞌ máꞌ nu̱nda̱ꞌa̱laꞌ rí mbu̱ya̱álaꞌ xí gakon rí Krísto̱ naꞌthán ga̱jma̱á majñu̱ꞌ ikhúúnꞌ. Jamí Krísto̱ na̱nguá wabaa̱ ga̱jma̱á nindxa̱ꞌlaꞌ, rí nasngájmee̱ mbá xúgíí ski̱yu̱u̱ꞌ ga̱jma̱á nindxa̱ꞌlaꞌ. <verse eid="2CO 13:3" /><verse number="4" style="v" sid="2CO 13:4" />Gakon máꞌ rí wabaa̱ nákhí waꞌdujmaa̱ ná ixe̱ krúsi̱. I̱ndo̱ó máꞌ numuu rí xúge̱ꞌ, xtáa̱ ndaꞌyee̱ ga̱jma̱á majñu̱u̱ ski̱yu̱u̱ꞌ Ana̱ꞌlóꞌ. Xkuaꞌnii máꞌ mangáanꞌxo̱ꞌ, wabáanꞌxo̱ꞌ ga̱jma̱á nindxu̱u̱, i̱ndo̱ó máꞌ numuu rí ga̱jma̱á numalaꞌ ikháanꞌlaꞌ ma̱juwaxo̱ꞌ ga̱jma̱á majñu̱u̱ ski̱yu̱u̱ꞌ Ana̱ꞌlóꞌ.<verse eid="2CO 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 13:5" />Gu̱ya̱xe̱-mijnálaꞌ máꞌ ikháanꞌlaꞌ, kajngó mbu̱ya̱álaꞌ xí nanimba̱ꞌlaꞌ ju̱ya̱á gisngáá ga̱jma̱á numuu Jesús. Gu̱ya̱xe̱-mijnálaꞌ kajngó mbu̱ya̱álaꞌ rí Krísto̱ xtáa̱ ga̱jma̱á nindxa̱ꞌlaꞌ. O i̱ndo̱ó máꞌ xí na̱nguá inimba̱ꞌlaꞌ ju̱yáa̱ rá mbo̱ꞌ. <verse eid="2CO 13:5" /><verse number="6" style="v" sid="2CO 13:6" />Xómáꞌ ikhúúnꞌ na̱ju̱mu̱ꞌ rí mbu̱ya̱álaꞌ máꞌ rí xa̱bi̱i Krísto̱ ñajwanxo̱ꞌ. <verse eid="2CO 13:6" /><verse number="7" style="v" sid="2CO 13:7" />Jamí nu̱tha̱n-jáñííxo̱ꞌ Ana̱ꞌlóꞌ kajngó mu̱xúne̱laꞌ nimbá rí ra̱máján. Nu̱nda̱ꞌa̱xo̱ꞌ rúꞌkhue̱n, ra̱ꞌkhá máꞌ numuu ma̱kujma rí ikháanꞌxo̱ꞌ nu̱tha̱nxo̱ꞌ rí gakon, rí i̱ndo̱ó máꞌ numuu rí mu̱ne̱laꞌ rí máján. Ma̱xáꞌñuu máꞌ xí nakujma rí ikháanꞌxo̱ꞌ ni̱ngra̱ꞌáanꞌxo̱ꞌ. <verse eid="2CO 13:7" /><verse number="8" style="v" sid="2CO 13:8" />Numuu rí ikháanꞌxo̱ꞌ ma̱xáꞌnga̱ꞌxo̱ꞌ ma̱wajún-ꞌthi̱ín rí gakon, rí i̱ndo̱ó máꞌ nu̱tha̱n-mbááxo̱ꞌ numuu rí gakon. <verse eid="2CO 13:8" /><verse number="9" style="v" sid="2CO 13:9" />Ikhaa jngó, nadxu a̱kia̱nꞌxo̱ꞌ ído̱ rí wabáanꞌxo̱ꞌ, jamí ikháanꞌlaꞌ gúkuáanꞌlaꞌ. Jamí jaꞌnii máꞌ xóó nu̱tha̱n-jáñííxo̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á numalaꞌ, kajngó ma̱ꞌne káxáanꞌlaꞌ. <verse eid="2CO 13:9" /><verse number="10" style="v" sid="2CO 13:10" />Ikhaa numuu rúꞌkhue̱n, wapha máꞌ i̱xu̱ꞌmá i̱yi̱i̱ꞌ ríge̱ꞌ inalaꞌ, ído̱ rí xóó tsíka gáya̱ꞌlaꞌ, kajngó ma̱xáríyáꞌlaꞌ mi̱ndaꞌkho ga̱jma̱á tsiakhe̱ rí nixníꞌ Táta̱ ído̱ rí ma̱gánúlo̱ꞌ. Numuu rí Táta̱ nixníꞌ tsiakhe̱ rí ma̱mbáyálaꞌ ma̱gajáanꞌlaꞌ, ra̱ꞌkhá rí ma̱ne̱-gámbáanꞌlaꞌ.<verse eid="2CO 13:10" /></para>
  <para style="s">Naꞌthángoo Páblo̱</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 13:11" />A̱ngui̱nꞌ, na̱tha̱n-ngáwalaꞌ ga̱jma̱á ajngáa ríge̱ꞌ: ga̱juwalaꞌ gagi. A̱gajáanꞌlaꞌ asndo rí ma̱ꞌne káxáanꞌlaꞌ. Gu̱xna̱alaꞌ tsiakhe̱ a̱kia̱nꞌlaꞌ. Mbóó ju̱ma̱ꞌlaꞌ gáꞌne rí mu̱ñajunlaꞌ. Jamí tsímáá gájuwalaꞌ. Xkuaꞌnii kajngó Ana̱ꞌlóꞌ tsí nandoo jaꞌyalóꞌ jamí tsí naꞌne rí ma̱juwalóꞌ tsímáá ma̱xtáa ga̱jma̱á nindxa̱ꞌlaꞌ.<verse eid="2CO 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 13:12" />Gu̱ra̱xi̱-mijnáalaꞌ mbá xúgiáanꞌlaꞌ ga̱jma̱á gamaku. <verse eid="2CO 13:12" /><verse number="13" style="v" sid="2CO 13:13" />Nu̱ra̱xáa̱nꞌlaꞌ mbá xúgíin xa̱bi̱i Ana̱ꞌlóꞌ tsí júwa̱ꞌ ge̱jyoꞌ.<note caller="+" style="f"><char style="fr" closed="false">13.13 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ rí na̱ru̱wa̱a kíxnuu 12 jamí 13.</char></note><verse eid="2CO 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 13:14" />Táta̱ Jesukrísto̱ gáꞌne-tsakun-rámáaꞌlaꞌ. Ana̱ꞌlóꞌ mikhuíí gásngájma rí nandoo jaꞌyalaꞌ, jamí Xu̱u̱ꞌ Ana̱ꞌlóꞌ gáxtáa ga̱jma̱á nindxa̱ꞌlaꞌ mbá xúgiáanꞌlaꞌ. Xkuaꞌnii gáꞌne.<note caller="+" style="f"><char style="fr" closed="false">13.14 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa «Xkuaꞌnii gáꞌne».</char></note><verse eid="2CO 13:14" /></para>
  <chapter eid="2CO 13" />
</usx>