<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">tcfU (65-3Juan) - Me̱ꞌpha̱a̱ Mañúwi̱ín (Malinaltepec), c1/v15</book>
  <para style="h">3 Juáán</para>
  <para style="toc3">3 Jn</para>
  <para style="toc2">3 Juáán</para>
  <para style="toc1">Riatsú i̱yi̱i̱ꞌ rí niꞌtháán Juáán</para>
  <para style="mt2">Riatsú i̱yi̱i̱ꞌ rí niꞌtháán</para>
  <para style="mt1">Juáán</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="s">Juáán naraxi̱i Gáyo̱</para>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />Ikhúúnꞌ, tsúún xa̱bo̱ nikhi̱i̱ ñajunꞌ, na̱tháán i̱yi̱i̱ꞌ ríge̱ꞌ ma̱ꞌga inaaꞌ ikháánꞌ, dxájuꞌ Gáyo̱, tsáán phú gakon rí nandoꞌ ja̱ya̱a̱ꞌ.<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />Dxájuꞌ, na̱tha̱n-jáñuu Ana̱ꞌlóꞌ rí ma̱ga̱jnúu mújúun mbá xúgíí ñajun rí nathane̱, jamí rí ma̱xáyáaꞌ nandii, xómá rí wéje̱ mújúun a̱kia̱anꞌ ná inuu Ana̱ꞌlóꞌ.<verse eid="3JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="3JN 1:3" />Maphú nidxu a̱kui̱nꞌ ído̱ niguwá mbá tikhuun a̱ngia̱nꞌlóꞌ jamí nithinꞌ rí mbóó wéje̱ a̱kia̱anꞌ ná inuu rí gakon, xúꞌkhue̱n máꞌ rí xtaa nathane̱-mbáníí ne̱. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />Nda̱a̱ máꞌ i̱mba̱ rí naꞌne rí phú ma̱xtáá gagi, rí i̱ndo̱ó máꞌ ma̱dxawuun rí i̱ji̱nꞌ júwa̱ꞌ nune̱-mbáníí rí gakon.<verse eid="3JN 1:4" /></para>
  <para style="s">Juáán naꞌthán rí máján ga̱jma̱á numuu Gáyo̱</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />Dxájuꞌ, tsáán phú nandoꞌ ja̱ya̱a̱ꞌ, maphú máján ithane̱ rí natambáñúú a̱ngia̱nꞌlóꞌ tsí naguwá i̱mba̱ janíí, maske máꞌ tsíthane̱-ꞌnuu̱. <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />Ikhii̱n máján nuthee̱n ga̱jma̱á numaaꞌ ná inúú tsí nanimbu̱únꞌ juyáá Jesús, rí ikháánꞌ natasngájma rí nandaaꞌ xtañúu̱. Ikhaa jngó athane̱ mbá rí máján, atambáñúu̱ ga̱jma̱á rí ndaꞌñúu̱, xómá ga̱náꞌyoo rí mi̱tambáñúú tsí nune̱ ñajuun Ana̱ꞌlóꞌ, kajngó muꞌgíi̱ la nakhúu̱n magóo̱ jambúu̱n. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />Numuu rí ikhii̱n nigájnúu̱ kajngó muni̱i̱ ñajuun Jesukrísto̱, jamí túdri̱guíi̱ nitháan ná ñawúún tsí tsínimbu̱únꞌ juyáá Ana̱ꞌlóꞌ. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />Ikhaa numuu rúꞌkhue̱n, ikháánlóꞌ jaꞌyoo rí mu̱ꞌxnúúlóꞌ xa̱bo̱ tsúꞌkhue̱n rí ndaꞌñúú, kajngó mu̱mbáñúu̱lóꞌ rí muthan-raꞌee̱ ajngáa rí gakon.<verse eid="3JN 1:8" /></para>
  <para style="s">Juáán naꞌthán rí ra̱máján naꞌne Diótre̱fe̱s</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />Ikhúúnꞌ ni̱tháán i̱yi̱i̱ꞌ rí ma̱ꞌga inúú a̱ngia̱nꞌlóꞌ tsí nanimbu̱únꞌ juyáá Jesús. Xómáꞌ Diótre̱fe̱s tsínimbo̱o̱ꞌ rí nu̱tha̱nxo̱ꞌ, numuu rí ikhaa̱ phú na̱ni̱gu̱u̱ꞌ rí maꞌthán-ñájúu̱n mbá xúgíin a̱ngia̱nꞌlóꞌ. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />Ikhaa jngó, ído̱ gáꞌgá ma̱xprígúu̱lo̱ꞌ ga̱jma̱á numuu rí ra̱máján naꞌnii̱, rí ngrigo̱o̱ꞌ naꞌthée̱n ajngáa xkawe̱ꞌ ga̱jma̱á numaxo̱ꞌ. Ra̱ꞌkhá máꞌ i̱ndo̱ó rúꞌkhue̱n iꞌnii̱, rí mangaa máꞌ tsígrui̱gúu̱n a̱ngia̱nꞌlóꞌ tsí naguáꞌnú, jamí a̱ngia̱nꞌlóꞌ tsí nandúún rí mu̱dri̱gúu̱n ná guꞌwúún, tsíniñúu̱ rí mune̱ rúꞌkhue̱n, jamí naxkawíi̱n ná majñu̱ú tsí nanimbu̱únꞌ juyáá Jesús.<verse eid="3JN 1:10" /></para>
  <para style="s">Juáán naꞌthán rí máján eꞌne Demétrio̱</para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />Dxájuꞌ, tsáán phú nandoꞌ ja̱ya̱a̱ꞌ, ma̱xíya̱ri̱dáá rí ra̱máján nune̱ xa̱bo̱, rí ayári̱dáá rí máján nune̱ xa̱bo̱. Tsí naꞌne rí máján, tsúꞌkhue̱n ñajuun a̱dée Ana̱ꞌlóꞌ. Xómáꞌ tsí naꞌne rí ra̱máján, tsíꞌne-nuwiin Ana̱ꞌlóꞌ. <verse eid="3JN 1:11" /><verse number="12" style="v" sid="3JN 1:12" />Mbá xúgíin xa̱bo̱ nuthan rí máján eꞌne Demétrio̱, jamí xó rí xtáa̱ nasngájma rí gakon rí nuthee̱n. Ikháanꞌ mangáanꞌxo̱ꞌ nu̱tha̱nxo̱ꞌ rí máján iꞌnii̱, jamí ikháánꞌ nathayáá májáanꞌ rí gakon rí nu̱tha̱nxo̱ꞌ numuu̱.<verse eid="3JN 1:12" /></para>
  <para style="s">Naꞌthángoo Juáán</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />Gúꞌdo̱ꞌ mbaꞌa guéño rí nandoꞌ ma̱tha̱a̱nꞌ, i̱ndo̱ó máꞌ numuu rí tsíyoꞌ gátháán ne̱ ná inuu i̱yi̱i̱ꞌ ríge̱ꞌ, <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />numuu rí gúꞌthu̱u̱n rí mba̱ya̱a̱ꞌ máꞌ wapha, jamí mu̱ꞌthán-mijnálóꞌ ná inalóꞌ.<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />Dxájuꞌ, Ana̱ꞌlóꞌ gáꞌne rí ma̱ra̱xtaa tsímáá. Nu̱ra̱xi̱ín iyanga̱jwa̱ tsí júwa̱ꞌ ge̱jyoꞌ. Aratháán tháan mbámbáa iyanga̱jwa̱ tsí xtáa a̱ꞌkhue̱n rí na̱ra̱xi̱ilo̱ꞌ.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>