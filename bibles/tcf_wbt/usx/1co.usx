<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">tcfU (47-1Cor) - Me̱ꞌpha̱a̱ Mañúwi̱ín (Malinaltepec) base-NVI; ECZ 1a-Borr jul-dic_2006; c16/v437;</book>
  <para style="h">1 Xa̱bo̱ Korínto̱</para>
  <para style="toc3">1 Co</para>
  <para style="toc2">1 Xa̱bo̱ Korínto̱</para>
  <para style="toc1">Timbá i̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inúú xa̱bo̱ Korínto̱</para>
  <para style="mt2">Timbá i̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inúú</para>
  <para style="mt1">Xa̱bo̱ Korínto̱</para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="s">Páblo̱ naraxi̱in tsí nanimbu̱únꞌ juyáá Jesús ná xuajen Korínto̱</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />Ikhúúnꞌ ñajunꞌ Páblo̱. Watsaꞌwóꞌ rí ma̱nindxu̱ꞌ mbáa xa̱bo̱ tsí waxúngua̱a̱ꞌ neꞌne Jesukrísto̱ numuu rí xkuaꞌnii ndiyoo Ana̱ꞌlóꞌ. Ga̱jmi̱ꞌ dxájwalóꞌ Sóste̱ne̱s. <verse eid="1CO 1:1" /><verse number="2" style="v" sid="1CO 1:2" />Nu̱ra̱xi̱inxo̱ꞌ tsí nanimbu̱únꞌ juyáá Ana̱ꞌlóꞌ ná xuajen Korínto̱, ikháanꞌlaꞌ tsáanꞌ ni̱gu̱ma-jaꞌwáanꞌlaꞌ neꞌne Krísto̱ Jesús. Watsaꞌwálaꞌ rí ma̱nindxa̱ꞌlaꞌ xa̱bo̱ xuajñuu Ana̱ꞌlóꞌ gajmiálaꞌ mbá xúgíin tsí asndo náá máꞌ numbaa nu̱xri̱ga̱á mbiꞌyuu Tátiálóꞌ Jesukrísto̱, Táta̱ tsí naꞌthán-ñájúu̱n ikhii̱n jamí ikháánꞌlóꞌ.<verse eid="1CO 1:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3" />Ana̱ꞌlóꞌ Mikhuíí jamí Táta̱ Jesukrísto̱ gúne̱-tsakun-rámáaꞌlaꞌ jamí ikhii̱n máꞌ gúni̱i̱ rí ma̱juwalaꞌ tsímáá.<verse eid="1CO 1:3" /></para>
  <para style="s">Páblo̱ narígu̱u la gamaku inuu Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />Jámba̱ miꞌtsú na̱rígu̱ulo̱ꞌ gamaku inuu Anu̱ꞌ Mikhuíí ga̱jma̱á numalaꞌ, numuu rí maphú mba̱a̱ rí máján nixnálaꞌ Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ Krísto̱ Jesús. <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />Ga̱jma̱á majñu̱u̱ ikhaa̱ nijanálaꞌ mi̱ndaꞌkho mbá xúgíí inii rí guáꞌdáálaꞌ, ga̱nindxu̱u̱ ne̱ mbá xúgíí inii rí nu̱tha̱nlaꞌ jamí mbá xúgíí inii rí nu̱ne̱-nuwiinlaꞌ. <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />Xkuaꞌnii nikujma rí ni̱ga̱nú ajngóo Krísto̱ ga̱jma̱á nindxa̱ꞌlaꞌ. <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />Ikhaa jngó nánguá máꞌ iꞌyálaꞌ nimbá rí naxná Ana̱ꞌlóꞌ kajngó mu̱ne̱-mba̱a̱laꞌ, awúun máꞌ rí guáꞌthi̱ínlaꞌ rí ma̱ꞌkha̱a Tátiálóꞌ Jesukrísto̱. <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />Ikhaa̱ máꞌ ma̱ꞌnii̱ rí ma̱wajún-gúkuálaꞌ asndo mbiꞌi rí ndámba̱wóo, kajngó ma̱xáríga̱ nimbá rí ra̱máján mi̱ꞌthán ga̱jma̱á numalaꞌ ído̱ rí ma̱ꞌkha̱a Tátiálóꞌ Jesukrísto̱. <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />Numuu rí maphú jmbii Ana̱ꞌlóꞌ, tsí nindxaꞌwálaꞌ rí ma̱mbáxa̱ꞌlaꞌ gajmiálaꞌ A̱dée, ikhaa máꞌ tsí ñajuun Tátiálóꞌ Jesukrísto̱.<verse eid="1CO 1:9" /></para>
  <para style="s">Nu̱xpi̱ꞌtha̱-mijná tsí nanimbu̱únꞌ juyáá Jesús ná Korínto̱</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />A̱ngui̱nꞌ, na̱tha̱n-jáñalaꞌ ríge̱ꞌ ga̱jma̱á numuu Tátiálóꞌ Jesukrísto̱: rí mbóó awan gáwaꞌdáálaꞌ mbá xúgiáanꞌlaꞌ, jamí mu̱xúxpíꞌthá-mijnálaꞌ. Mbá ꞌnduꞌ gájuwalaꞌ ga̱jma̱á numuu mbóó ju̱ma̱, jamí mbóó máꞌ numuu rí gájuwalaꞌ. <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />Na̱tha̱nꞌlaꞌ ríge̱ꞌ a̱ngui̱nꞌ, numuu rí mbá tikhuun xa̱bi̱i Kloé nithinꞌlo̱ꞌ rí na̱tsa̱ña̱ꞌlaꞌ. <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" />Mbá tikhuun tsí ikháanꞌlaꞌ nuthan: «Ikhúúnꞌ ñajunꞌ xa̱bi̱i Páblo̱». I̱ꞌwíin nuthan: «Ikhúúnꞌ ñajunꞌ xa̱bi̱i Apólo̱s». I̱ꞌwíin nuthan: «Ikhúúnꞌ ñajunꞌ xa̱bi̱i Pédro̱».<note caller="+" style="f"><char style="fr" closed="false">1.12 </char><char style="ft" closed="false">«Pedro» ñajuun ajngáa griégo̱ jamí «Cefas» ñajuun ajngáa araméo̱.</char></note> I̱ꞌwíin nuthan: «Ikhúúnꞌ ñajunꞌ xa̱bi̱i Krísto̱».<verse eid="1CO 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 1:13" />Á nixpíꞌthá-mina̱ꞌ Krísto̱ dxe̱ꞌ. Á waꞌdujmaa Páblo̱ ná ixe̱ krúsi̱ ma̱ja̱ñúu ga̱jma̱á numalaꞌ dxe̱ꞌ. Á waxúꞌdu-maꞌáanꞌlaꞌ ná awúun iya rí ma̱nindxa̱ꞌlaꞌ xa̱bi̱i Páblo̱ dxe̱ꞌ. <verse eid="1CO 1:13" /><verse number="14" style="v" sid="1CO 1:14" />Núma̱aꞌ la Ana̱ꞌlóꞌ rí nimbáa tsí ikháanꞌlaꞌ táxu̱ꞌdú-máꞌáanlo̱ꞌ ná awúun iya, rí i̱ndo̱ó máꞌ Kríspo̱ ga̱jma̱á Gáyo̱. <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />Kajngó nimbáa ma̱xáꞌthán rí waxúꞌdu-maꞌáan ná awúun iya rí ma̱nindxu̱u̱ xa̱bi̱ꞌ. <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" />Xúꞌkhue̱n máꞌ ni̱xu̱ꞌdú-máꞌíin ná awúun iya xa̱bi̱i Estéfa̱na̱s. Xómáꞌ tsí i̱ꞌwíin rá, na̱nguá gíwa̱a̱n a̱kui̱nꞌ xí ni̱xu̱ꞌdú-máꞌáan ná awúun iya i̱mba̱a̱ꞌ. <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />Numuu rí táxungu̱únꞌ Krísto̱ rí ma̱xu̱ꞌdú-máꞌíin xa̱bo̱ ná awúun iya, rí nixúngúu̱nꞌ ma̱tha̱n-ráꞌa ajngáa máján. Jamí ra̱ꞌkhá ga̱jma̱á ajngúún xa̱bo̱ tsí na̱ma̱ñúú guéño ná numbaa ríge̱ꞌ, ra̱ꞌkhá ma̱ꞌne rí nda̱a̱ mbá jayu numuu nijáñuu Krísto̱ ná ixe̱ krúsi̱.<verse eid="1CO 1:17" /></para>
  <para style="s">Ra̱mbéꞌtháán rí na̱ma̱ñuu Ana̱ꞌlóꞌ ga̱jma̱á rí na̱ma̱ñúú xa̱bo̱ numbaa</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />Xa̱bo̱ tsí nandáti̱gi̱in nduyáa̱ rí ajngáa tsiskágu̱nꞌ ñajuun gisngáá ga̱jma̱á numuu Krísto̱ tsí nijáñuu ná ixe̱ krúsi̱. Xómáꞌ ikháánꞌlóꞌ rá, tsáanꞌ na̱ka̱-rajáwiáanꞌlóꞌ, nduꞌyáálóꞌ rí ski̱yu̱u̱ꞌ Ana̱ꞌlóꞌ ñajuun ajngáa rúꞌkhue̱n. <verse eid="1CO 1:18" /><verse number="19" style="v" sid="1CO 1:19" />Xómá ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="b" vid="1CO 1:19" />
  <para style="q" vid="1CO 1:19">«Ma̱snga̱jmá rí xa̱bo̱ tsí na̱ju̱mu̱ú rí na̱ma̱ñúú guéñúú, nda̱a̱ rí i̱ma̱ñúu̱,</para>
  <para style="q" vid="1CO 1:19">Jamí ma̱ne̱ rí ma̱kujma rí xa̱bo̱ tsí na̱ju̱mu̱ú rí máján guéño idxu̱ún, nda̱a̱ rí ifruꞌúu̱n».<note caller="+" style="f"><char style="fr" closed="false">1.19 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 29.4. </char></note><verse eid="1CO 1:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="1CO 1:20" />Náá inguanúu xa̱bo̱ tsí phú na̱ma̱ñuu rá. Náá inguanúu xa̱bo̱ tsí naꞌsngáá xtángoo rá. Náá inguanúu xa̱bo̱ tsí phú na̱ma̱ñuu naꞌthán ná numbaa ríge̱ꞌ rá. Ana̱ꞌlóꞌ nisngájma rí tsiskágu̱nꞌ ñajuun mbá xúgíí rí na̱ma̱ñúú xa̱bo̱ numbaa. <verse eid="1CO 1:20" /><verse number="21" style="v" sid="1CO 1:21" />Numuu rí ga̱jma̱á majñu̱u̱ rí na̱ma̱ñuu Ana̱ꞌlóꞌ, niꞌnii̱ rí mu̱xúne̱-nuwii̱n xa̱bo̱ numbaa ga̱jma̱á majñu̱u̱ rí na̱ma̱ñúu̱ ikhii̱n. I̱wa̱á máꞌ neꞌne a̱kui̱in Ana̱ꞌlóꞌ rí ma̱ꞌne-jáwíi̱n tsí nanimbu̱únꞌ juyáa̱ ga̱jma̱á majñu̱u̱ ajngáa rí nu̱tha̱n-ráꞌaxo̱ꞌ, ikhaa rí xómá tsiskágu̱nꞌ jaꞌnii.<verse eid="1CO 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 1:22" />Tsí xa̱bo̱ judío̱ nandúu̱n mbuyáa̱ rí phú wáá, jamí xa̱bo̱ griégo̱ nandúu̱n rí ma̱ma̱ñúu̱ i̱tha̱án xóó. <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />Xómáꞌ ikháanꞌxo̱ꞌ, nu̱tha̱n-ráꞌaxo̱ꞌ ga̱jma̱á numuu Krísto̱ tsí waꞌdujmaa ná ixe̱ krúsi̱ ma̱ja̱ñúu. Maphú mate̱ꞌ gisngáá ríge̱ꞌ iyáá tsí xa̱bo̱ judío̱, jamí ajngáa tsiskágu̱nꞌ ñajuun ne̱ iyáá xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún. <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />Xómáꞌ tsí nindxaꞌwúún Ana̱ꞌlóꞌ rá, xa̱bo̱ judío̱ jamí xa̱bo̱ griégo̱, nduyáa̱ rí Krísto̱ nasngájma ski̱yu̱u̱ꞌ Ana̱ꞌlóꞌ, jamí ikhaa̱ nasngájmee̱ rí phú na̱ma̱ñuu Ana̱ꞌlóꞌ. <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />Numuu rí ikhaa rí xómá naskágu̱u̱nꞌ Ana̱ꞌlóꞌ jaꞌnii ná inúú xa̱bo̱, ikhaa rúꞌkhue̱n nasngájma rí phú i̱tha̱án na̱ma̱ñuu̱ ikhaa̱ xó rí xa̱bo̱ numbaa. Jamí ikhaa rí xómá wabaa Ana̱ꞌlóꞌ jaꞌnii ná inúú xa̱bo̱, ikhaa rúꞌkhue̱n nasngájma rí i̱wa̱á mba̱a̱ ski̱yu̱u̱ꞌ ikhaa̱ xó rí xa̱bo̱ numbaa.<verse eid="1CO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />Ikhaa jngó a̱ngui̱nꞌ, gu̱ya̱á májánlaꞌ rí Ana̱ꞌlóꞌ nindxaꞌwálaꞌ, maske máꞌ ra̱mbáꞌáanꞌlaꞌ na̱ma̱ñalaꞌ xómá na̱ma̱ñúú i̱ꞌwíin xa̱bo̱, ni máꞌ ra̱mbáꞌáanꞌlaꞌ guáꞌdáálaꞌ tsiakhe̱ rí mu̱tha̱n-ñájunlaꞌ, ni máꞌ ra̱mbáꞌáanꞌlaꞌ ni̱gu̱máaꞌlaꞌ ná majñu̱ú xa̱bo̱ tsí gíꞌdoo numúú. <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />Ikhiin tsí na̱nguá gíꞌdoo numúú ná numbaa ríge̱ꞌ niraꞌwíin Ana̱ꞌlóꞌ, kajngó ma̱ꞌne-matii̱nꞌ tsí na̱ma̱ñúú. Ikhiin tsí wabiin ná numbaa ríge̱ꞌ niraꞌwíin Ana̱ꞌlóꞌ, kajngó ma̱ꞌne-matii̱nꞌ tsí guáꞌdáá tsiakhe̱ rí muthan-ñajun. <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />Ikhiin tsí tsíjmii jayu, tsí ndawa̱a̱ tsí iya-makúún, jamí tsí nda̱a̱ nitháan numúú, tsúꞌkhue̱n niraꞌwíin Ana̱ꞌlóꞌ kajngó ma̱ꞌne-matii̱nꞌ tsí gíꞌdoo numúú. <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />Ikhaa jngó nimbáa ma̱xákúxe̱-mina̱ꞌ ná inuu Ana̱ꞌlóꞌ. <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />Xómáꞌ ikhaa̱ niꞌnii̱ rí ma̱juwalaꞌ ga̱jma̱á nindxu̱u̱ Krísto̱ Jesús, tsí ninindxu̱u̱ rí na̱ma̱ñalóꞌ neꞌne Ana̱ꞌlóꞌ. Xúꞌkhue̱n máꞌ ga̱jma̱á numuu Krísto̱ niꞌthán Ana̱ꞌlóꞌ rí nánda̱a̱ aꞌkhánlóꞌ, ni̱gu̱ma-jaꞌwáanꞌlóꞌ, jamí waꞌtse̱-ri̱ñáaꞌlóꞌ. <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />Ikhaa jngó, xómá ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ: «Xí mbáa nandoo makúxe̱-mina̱ꞌ, gakúxe̱-mine̱e̱ꞌ ga̱jma̱á numuu Táta̱».<note caller="+" style="f"><char style="fr" closed="false">1.31 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Jeremía̱s 9.24. </char></note><verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="s">Ajngáa ga̱jma̱á numuu Krísto̱ tsí waꞌdujmaa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />Ikhaa jngó a̱ngui̱nꞌ, nákhí nika gátha̱nꞌlaꞌ awan drígo̱o̱ Ana̱ꞌlóꞌ rí i̱ndo̱ó máꞌ ikhaa̱ ni̱gi̱da̱ꞌ idxu̱u̱ nákhí wajyúú, tájmulo̱ꞌ ajngáa rí ma̱makualaꞌ gáꞌne o ga̱jma̱á ajngúún xa̱bo̱ tsí na̱ma̱ñúú guéño ná numbaa mbo̱ꞌ. <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />Numuu ni̱ꞌgí-mina̱ꞌlo̱ꞌ rí awúun mbiꞌi rí xtáá ga̱jma̱á nindxa̱ꞌlaꞌ, ma̱xátha̱nꞌlaꞌ numuu i̱mba̱, rí i̱ndo̱ó máꞌ ga̱jma̱á numuu Jesukrísto̱ tsí waꞌdujmaa ná ixe̱ krúsi̱ ma̱ja̱ñúu. <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" />Xkuaꞌnii wabúún nixtáá ga̱jma̱á nindxa̱ꞌlaꞌ, asndo naguꞌwúún rí namíñuꞌlo̱ꞌ. <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />Ído̱ ni̱tha̱nꞌlaꞌ jamí ni̱tha̱n-ráꞌalaꞌ, táne̱ rí ma̱ne̱-rájáanꞌlaꞌ ga̱jma̱á ajngóꞌ xómá ene̱ xa̱bo̱ numbaa, rí i̱ndo̱ó máꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ nisngájma ga̱jma̱á ski̱yu̱u̱ꞌ rí gakon rí na̱tha̱nlo̱ꞌ. <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />Xkuaꞌnii kajngó ma̱we̱je̱ a̱kia̱nꞌlaꞌ ná tsu̱du̱u̱ ski̱yu̱u̱ꞌ Ana̱ꞌlóꞌ, ra̱ꞌkhá ná tsu̱du̱u̱ rí na̱ma̱ñúú xa̱bo̱ numbaa.<verse eid="1CO 2:5" /></para>
  <para style="s">Ana̱ꞌlóꞌ nasngájma awan drígo̱o̱ ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />Gakon máꞌ rí nu̱tha̱nxo̱ꞌ xómá xa̱bo̱ tsí na̱ma̱ñúú ná inúú tsí nikhi̱in máꞌ ná inuu Ana̱ꞌlóꞌ. I̱ndo̱ó máꞌ numuu rí ra̱ꞌkhá xómá rí na̱ma̱ñúú xa̱bo̱ ná numbaa ríge̱ꞌ, o xómá rí na̱ma̱ñúú xa̱bo̱ ñajun tsí na̱ka̱-rayámba̱ ski̱ñu̱ú mbo̱ꞌ. <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />Xómáꞌ ikháanꞌxo̱ꞌ, nu̱tha̱nxo̱ꞌ rí na̱ma̱ñuu Ana̱ꞌlóꞌ, awan drígo̱o̱ rí i̱ndo̱ó máꞌ ikhaa̱ ni̱gi̱da̱ꞌ idxu̱u̱ asndo nákhí máꞌ xóó nda̱a̱ numbaa. Ga̱jma̱á majñu̱u̱ rí na̱ma̱ñuu Ana̱ꞌlóꞌ niꞌgí-mine̱e̱ꞌ ma̱ꞌnii̱ rí maphú ma̱gi̱ꞌdoo numalóꞌ. <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />Nimbáa xa̱bo̱ ñajun tsí nixtáa ná numbaa ríge̱ꞌ táfroꞌo̱o̱ rí na̱ma̱ñuu Ana̱ꞌlóꞌ. Xí numuu rí nifruꞌúu̱n ne̱, ni miꞌtsú túdujmaa̱ ná ixe̱ krúsi̱ Táta̱ tsí ninújngoo gíꞌdoo numuu. <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />A̱ꞌkhue̱n gakon, xómá ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="b" vid="1CO 2:9" />
  <para style="q" vid="1CO 2:9">«Ana̱ꞌlóꞌ neꞌne-mújúun rí maxnúú tsí nandúún juyáa̱,</para>
  <para style="q" vid="1CO 2:9">rí táꞌyoo nimbáa xa̱bo̱ ga̱jma̱á iduu,</para>
  <para style="q" vid="1CO 2:9">ni máꞌ tádxawuun ga̱jma̱á ñaꞌwuun, ni máꞌ táju̱mu̱u̱ mbá jayu».<note caller="+" style="f"><char style="fr" closed="false">2.9 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 64.4. </char></note><verse eid="1CO 2:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="1CO 2:10" />Xómáꞌ Ana̱ꞌlóꞌ neꞌne rí mu̱ꞌne̱-nuwiin ikháánꞌlóꞌ rúꞌkhue̱n ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ. Numuu rí Xu̱u̱ꞌ ndaꞌyoo mbá xúgíí, asndo rí ríga̱ ngu̱ꞌwo̱o̱ ná awúun a̱kui̱in Ana̱ꞌlóꞌ. <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />Tsáa xa̱bi̱i̱ tsí ndaꞌyoo rí ríga̱ ná awúun a̱kui̱in i̱mba̱a̱ꞌ xa̱bo̱ rá. Nimbáa, rí i̱ndo̱ó máꞌ a̱kuii̱n ndaꞌyoo. Xkuaꞌnii máꞌ nimbáa tsíꞌyoo rí ríga̱ ná awúun a̱kui̱in Ana̱ꞌlóꞌ, rí i̱ndo̱ó máꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ ndaꞌyoo. <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />Jamí ikháánꞌlóꞌ túdrígúlóꞌ rí na̱ju̱mu̱ú xa̱bo̱ numbaa, rí ni̱dríguíilóꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ, kajngó ma̱goo ma̱fraꞌa̱ꞌlóꞌ rí nixnálóꞌ Ana̱ꞌlóꞌ. <verse eid="1CO 2:12" /><verse number="13" style="v" sid="1CO 2:13" />Ído̱ rí nu̱tha̱nxo̱ꞌ numuu rúꞌkhue̱n, tsítha̱nxo̱ꞌ ga̱jma̱á ajngáa gisngáá rí na̱ma̱ñúú xa̱bo̱ numbaa, rí ga̱jma̱á ajngáa rí naꞌsngáá Xu̱u̱ꞌ Ana̱ꞌlóꞌ. Nu̱tha̱n-makaxo̱ꞌ rí naꞌsngáá Xu̱u̱ꞌ Ana̱ꞌlóꞌ ná inúú tsí xtáa máꞌ Xu̱u̱ꞌ ikhaa̱ ga̱jma̱á nindxu̱ún. <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />Xa̱bo̱ tsí na̱nguá xtáa Xu̱u̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxu̱u̱ tsígrui̱guíi̱ rí naꞌsngáá Xu̱u̱ꞌ Ana̱ꞌlóꞌ, numuu rí tsiskágu̱nꞌ ñajuun ne̱ iꞌyoo̱ rí ikhaa̱. Jamí tsíꞌngo̱o̱ gáfroꞌo̱o̱ ne̱, numuu ndaꞌyóo rí ma̱froꞌo̱o̱ ne̱ ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ. <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />Xómáꞌ xa̱bo̱ tsí xtáa Xu̱u̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxu̱u̱ rá, mbá xúgíí nandoo na̱ra̱jwe̱e̱ꞌ rí ikhaa̱, jamí nimbáa xa̱bo̱ tsíꞌngo̱o̱ gára̱jwa̱ꞌ ga̱jma̱á numuu̱ ikhaa̱. <verse eid="1CO 2:15" /><verse number="16" style="v" sid="1CO 2:16" />Numuu rí xkuaꞌnii ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="b" vid="1CO 2:16" />
  <para style="q" vid="1CO 2:16">«Tsáa ndaꞌyoo rí nandxaꞌwá-mina̱ꞌ Táta̱ róꞌ,</para>
  <para style="q" vid="1CO 2:16">Tsáa ma̱ꞌngo̱o̱ maꞌsngóo̱ róꞌ».<note caller="+" style="f"><char style="fr" closed="false">2.16 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 40.13. </char></note></para>
  <para style="b" vid="1CO 2:16" />
  <para style="m" vid="1CO 2:16">Xómáꞌ ikháánꞌlóꞌ, nu̱ndxa̱ꞌwa̱-mijnálóꞌ xómá nandxaꞌwá-mina̱ꞌ Krísto̱.<verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s">Xa̱bo̱ tsí nu̱ñajun ná inuu Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />A̱ngui̱nꞌ, nákhí xúꞌkhue̱n ra̱khóo rí ma̱tha̱nꞌlaꞌ xómá xa̱bo̱ tsí xtáa Xu̱u̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxu̱ún, rí ni̱tha̱nꞌlaꞌ xómá xa̱bo̱ tsí nune̱ rí nandúún máꞌ ikhiin, asndo xómá e̱je̱n ná inuu Krísto̱. <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" />Ni̱xna̱ꞌlaꞌ gisngáá rí na̱nguá mingíjyúu, ikhaa rí xómá yaꞌdú jaꞌnii. Ra̱ꞌkhá gisngáá rí mingíjyúu ni̱xna̱ꞌlaꞌ, ikhaa rí xómá guma jaꞌnii, numuu rí xóó máꞌ tsíjmáaꞌlaꞌ gúpholaꞌ ne̱, ni máꞌ xóó tsíjmáaꞌlaꞌ xúge̱ꞌ. <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />Numuu rí xóó máꞌ nu̱ne̱laꞌ rí nune̱ xa̱bo̱ ná numbaa ríge̱ꞌ: naxígua̱ꞌlaꞌ, na̱tsa̱ña̱ꞌlaꞌ jamí nu̱xna̱-mijnálaꞌ. Á ra̱ꞌkhá nu̱ne̱laꞌ rí nune̱ xa̱bo̱ ná numbaa ríge̱ꞌ, jamí juwalaꞌ xómá júwa̱ꞌ i̱ꞌwíin xa̱bo̱ numbaa rí xkuaꞌnii rá. <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" />Ído̱ rí mbáa naꞌthán: «Ikhúúnꞌ ñajunꞌ xa̱bi̱i Páblo̱», jamí i̱mba̱a̱ꞌ naꞌthán: «Ikhúúnꞌ ñajunꞌ xa̱bi̱i Apólo̱s», rúꞌkhue̱n iꞌthán rí xa̱bo̱ tsí nune̱ xómá nune̱ xa̱bo̱ ná numbaa ríge̱ꞌ ñajwanlaꞌ.<verse eid="1CO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5" />Ikhaa jngó, tsáa ñajuun Páblo̱ jamí Apólo̱s rá. I̱ndo̱ó máꞌ yumbée Ana̱ꞌlóꞌ ñajwanxo̱ꞌ, tsí ni̱mbáyálaꞌ rí ma̱nimba̱ꞌlaꞌ ju̱ya̱á Krísto̱. Jamí mbámbáa tsí ikháanꞌxo̱ꞌ neꞌne-mbánuu ñajun rí nijanáá ma̱ꞌne neꞌne Táta̱. <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" />Ikhúúnꞌ ni̱dulo̱ꞌ, jamí Apólo̱s ni̱rmu̱juun, xómáꞌ Ana̱ꞌlóꞌ neꞌne rí ma̱gaja̱a̱. <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />Ikhaa jngó, nda̱a̱ máꞌ rí ñajuun tsí naꞌdu, ni máꞌ tsí na̱rmu̱juun. I̱ndo̱ó máꞌ Ana̱ꞌlóꞌ, tsí naꞌne rí ma̱gaja̱a̱, tsúꞌkhue̱n tsí phú gíꞌdoo numuu. <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />Mbéꞌtháán máꞌ gíꞌdoo numuu tsí naꞌdu ga̱jma̱á tsí na̱rmu̱juun, i̱ndo̱ó máꞌ numuu rí mbámbáa ma̱grui̱gúu gamaku xómá jaꞌyoo ñajun rí niꞌnii̱. <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />Numuu rí ikháanꞌxo̱ꞌ nu̱ñajunxo̱ꞌ ná inuu Ana̱ꞌlóꞌ, jamí ikháanꞌlaꞌ ñajwanlaꞌ xómá mbaa rí naꞌdu Ana̱ꞌlóꞌ, jamí xómá guꞌwá rí naꞌne Ana̱ꞌlóꞌ.<verse eid="1CO 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 3:10" />Ikhúúnꞌ ni̱ꞌgí nakhúu guꞌwá rúꞌkhue̱n, ga̱jma̱á numuu rí phú májáan a̱kui̱in Ana̱ꞌlóꞌ ga̱jma̱á nindxu̱ꞌ, niꞌnii̱ rí ikhúúnꞌ ma̱nindxu̱ꞌ xómá xa̱bo̱ tsí phú na̱ma̱ñuu naꞌne guꞌwá, jamí i̱mba̱a̱ꞌ na̱ka̱-rakúxe̱ ná tsu̱du̱u̱ ne̱. I̱ndo̱ó máꞌ numuu rí mbámbáa gáꞌyoo xáne i̱ka̱-rakúxe̱ ná tsu̱du̱u̱ ne̱. <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />Numuu rí nimbáa ma̱xáxóo maꞌgí i̱mba̱ nakhúu, mixtiꞌkhu xó rí ꞌgí máꞌ. Nakhúu rí ꞌgí máꞌ ñajuun Jesukrísto̱. <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />Mbáa ma̱goo makúxe̱ ná tsu̱du̱u̱ nakhúu ríge̱ꞌ ga̱jma̱á ajwa̱nꞌ mo̱jmo̱ꞌ, ajwa̱nꞌ miꞌxá jamí itsí mitsaan, o ga̱jma̱á ixe̱, ra̱xa̱, o xto̱o̱ ska mbo̱ꞌ. <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />Ma̱kujma máꞌ xáne jaꞌnii ñajun rí neꞌne mbámbáa ído̱ gága̱nú mbiꞌi rí ma̱mba̱núu numuu ne̱ ga̱jma̱á agu. A̱ꞌkhue̱n ma̱kujma xáne jaꞌnii ñajun rí neꞌne mbámbáa, numuu rí ma̱nújngoo ne̱ ná awúun agu. <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />Xí tsíkha ñajun rí neꞌne mbáa tsí ni̱ka̱-rakúxe̱, a̱ꞌkhue̱n ma̱grui̱gúu̱ gamaku. <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />Jamí xí nakha ñajun rí neꞌne mbáa gáꞌne agu rá, phú mba̱a̱ ma̱ndáti̱go̱o̱. I̱ndo̱ó máꞌ ikhaa̱ ma̱jríya̱a̱ꞌ, xómá xa̱bo̱ tsí ga̱jma̱á kháan najríya̱a̱ꞌ ná awúun agu.<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />Ndu̱ya̱á májánlaꞌ máꞌ rí ikháanꞌlaꞌ ñajwanlaꞌ xómá guꞌwóo Ana̱ꞌlóꞌ, jamí Xu̱u̱ꞌ Ana̱ꞌlóꞌ xtáa ga̱jma̱á nindxa̱ꞌlaꞌ. <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />Xí mbáa naꞌne-gámba̱a la guꞌwóo Ana̱ꞌlóꞌ, Ana̱ꞌlóꞌ ma̱ꞌne-gámba̱a̱ tsúꞌkhue̱n. Numuu rí guꞌwóo Ana̱ꞌlóꞌ, rí ñajwanlaꞌ ikháanꞌlaꞌ, i̱ndo̱ó máꞌ Ana̱ꞌlóꞌ jaꞌyoo ne̱.<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />Nimbáa ma̱xáꞌne-nduwa-mina̱ꞌ. Xí mbáa na̱ju̱mu̱u̱ rí phú na̱ma̱ñuu ná numbaa ríge̱ꞌ, ga̱ꞌne-mine̱e̱ꞌ xómá xa̱bo̱ tsí tsíma̱ñuu mbá jayu, kajngó ma̱nindxu̱u̱ xa̱bo̱ tsí phú gakon rí na̱ma̱ñuu. <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />Numuu rí xa̱bo̱ tsí na̱ju̱mu̱ú rí phú na̱ma̱ñúú ná numbaa ríge̱ꞌ, najmiñúú tsúꞌkhue̱n ná inuu Ana̱ꞌlóꞌ. Xómá ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ: «Ana̱ꞌlóꞌ naguatuun xa̱bo̱ tsí na̱ju̱mu̱ú rí phú na̱ma̱ñúú ga̱jma̱á majñu̱u̱ rí na̱ma̱ñúu̱ máꞌ ikhii̱n».<note caller="+" style="f"><char style="fr" closed="false">3.19 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Jób 5.13. </char></note> <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />Jamí xáꞌnii ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ mangaa: «Táta̱ ndaꞌyoo rí nda̱a̱ mbá jayu numuu rí nu̱ndxa̱ꞌwa̱-mijná xa̱bo̱ tsí na̱ju̱mu̱ú rí phú na̱ma̱ñúú».<note caller="+" style="f"><char style="fr" closed="false">3.20 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 94.11. </char></note> <verse eid="1CO 3:20" /><verse number="21" style="v" sid="1CO 3:21" />Ikhaa jngó, nimbáa ma̱xákúxe̱-mina̱ꞌ ga̱jma̱á numúú xa̱bo̱ numbaa tsí nusngáá. Numuu rí ikháanꞌlaꞌ máꞌ jaꞌyalaꞌ mbá xúgíí: <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />ga̱nindxu̱u̱ Páblo̱, Apólo̱s, Pédro̱.<note caller="+" style="f"><char style="fr" closed="false">3.22 </char><char style="ft" closed="false">«Pedro» ñajuun ajngáa griégo̱ jamí «Cefas» ñajuun ajngáa araméo̱. </char></note> Ga̱nindxu̱u̱ numbaa, ga̱ꞌne rí juwalaꞌ ndu̱ya̱laꞌ, ga̱ꞌne rí ma̱ja̱ñálaꞌ, ga̱ꞌne rí ríga̱ xúge̱ꞌ, ga̱ꞌne rí ni̱kú máꞌ ma̱ri̱gá, mbá xúgíí jaꞌyalaꞌ ikháanꞌlaꞌ. <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />Jamí ikháanꞌlaꞌ ñajwanlaꞌ xa̱bi̱i Krísto̱, jamí Krísto̱ ñajuun xa̱bi̱i Ana̱ꞌlóꞌ.<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s">Ñajun rí nune̱ tsí waxúngui̱inꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />Ikhaa jngó, gu̱ya̱á májánlaꞌ rí yumbée Krísto̱ ñajwanxo̱ꞌ. Ni̱ge̱ꞌe̱ inaxo̱ꞌ rí mu̱sngááxo̱ꞌ awan drígo̱o̱ Ana̱ꞌlóꞌ rí i̱ndo̱ó máꞌ ikhaa̱ ni̱gi̱da̱ꞌ idxu̱u̱ nákhí wajyúú. <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />Jamí ndaꞌyóo rí xa̱bo̱ tsí waꞌxná-ngawúún mune̱ ñajun, ma̱nindxúu̱n xa̱bo̱ tsí jmbiin. <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />Xómáꞌ ikhúúnꞌ, tsíxná-gamiéjunꞌ guéño máꞌ xáne i̱ra̱jwa̱ꞌlaꞌ ga̱jma̱á numuꞌ, o xáne i̱ra̱jwa̱ꞌ numuꞌ xa̱bo̱ ñajun mbo̱ꞌ. Numuu rí ni máꞌ ikhúúnꞌ tsíra̱jwa̱ꞌ numuꞌ. <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />Maske máꞌ na̱nguá gíwa̱a̱n a̱kui̱nꞌ xí ne̱ne̱ rí ra̱máján, ra̱ꞌkhá máꞌ rúꞌkhue̱n iꞌthán rí nda̱a̱ aꞌkhúnꞌ. Tsí naxúdaa awan ga̱jma̱á numuꞌ ñajuun Táta̱ tsí naꞌthán-ñájun. <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />Ikhaa jngó, mu̱xúra̱jwa̱ꞌlaꞌ nacha̱ guéño ga̱jma̱á numuu nimbáa. Aguaꞌthi̱ínlaꞌ asndo ma̱ꞌkha̱a Táta̱. Ikhaa̱ ma̱gu̱wíi̱ ná pa̱jnu rí ríga̱ ngu̱ꞌwo̱o̱ ná mijína, jamí masngájmee̱ rí nandxaꞌwá-mina̱ꞌ mbámbáa xa̱bo̱. A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ maꞌthán xáne jaꞌnii ñajun rí neꞌne mbámbáa.<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />A̱ngui̱nꞌ, na̱tha̱nꞌlaꞌ ríge̱ꞌ ga̱jma̱á numuꞌ ikhúúnꞌ jamí Apólo̱s numuu rí nandoꞌ ja̱ya̱ꞌlaꞌ. Kajngó ga̱jma̱á majña̱ꞌ ikháanꞌxo̱ꞌ gáma̱ñalaꞌ ríge̱ꞌ: «Mu̱xúndxa̱ꞌwa̱-mijnálaꞌ i̱tha̱án ñúꞌún ga̱jma̱á numuu rí ka̱ma naꞌthán». Ra̱ꞌkhá mu̱xu̱xí-mijnálaꞌ ga̱jma̱á numuu mbáa, jamí tsíyalaꞌ gúya̱á i̱mba̱a̱ꞌ gáꞌne. <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />Tsáa iꞌthán rí i̱wa̱á gíꞌdoo numalaꞌ ikháanꞌlaꞌ róꞌ. Dí guáꞌdáálaꞌ rí tájanálaꞌ róꞌ. Xí mbá xúgíí rí guáꞌdáálaꞌ, nijanálaꞌ ne̱, náá numuu kajngó nu̱xu̱xí-mijnálaꞌ asndo xómá rí tájanálaꞌ ne̱ xúꞌkhue̱n róꞌ.<verse eid="1CO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8" />Ni̱gi̱ꞌmalaꞌ máꞌ rá. Guáꞌdáálaꞌ mi̱ndaꞌkho máꞌ rá. Ninindxa̱ꞌlaꞌ máꞌ thúngaa rá, jamí táꞌyálaꞌ máꞌ rí mu̱mbáyálaꞌxo̱ꞌ. ¡Phú máján lá xí gakon rí thúngaa ñajwanlaꞌ, kajngó ma̱trigáanꞌxo̱ꞌ mu̱tha̱n-ñájunxo̱ꞌ ga̱jma̱á nindxa̱ꞌlaꞌ! <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />Xómáꞌ ikhúúnꞌ na̱ndxa̱ꞌwa̱-mína̱ꞌ rí tsáanꞌ waxúnguáanꞌxo̱ꞌ, asndo xómá tsu̱di̱í jayu niniñaxo̱ꞌ Ana̱ꞌlóꞌ jaꞌnii, xómá xa̱bo̱ tsí waꞌxná-máꞌíin máꞌ rí ma̱ja̱ñúú jaꞌnii. Numuu rí ninindxa̱ꞌxo̱ꞌ xa̱bo̱ tsí nitamindúún eꞌne numbaa, tsí nitanduꞌwájmii ene̱ ánje̱l jamí xa̱bo̱. <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />Ga̱jma̱á numuu Krísto̱, ikháanꞌxo̱ꞌ ñajwanxo̱ꞌ xa̱bo̱ tsí júgoo mbá jayu inúú, xómáꞌ ikháanꞌlaꞌ ñajwanlaꞌ xa̱bo̱ tsí na̱ma̱ñúú mi̱ndaꞌkho. Ikháanꞌxo̱ꞌ wabáanꞌxo̱ꞌ, xómáꞌ ikháanꞌlaꞌ guáꞌdáálaꞌ tsiakhe̱. Ikháanꞌlaꞌ na̱gu̱ma-mbáanꞌlaꞌ, xómáꞌ ikháanꞌxo̱ꞌ ndawa̱a̱ tsí iya-makuaxo̱ꞌ. <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />Asndo mbiꞌi ríge̱ꞌ mingínáaꞌxo̱ꞌ na̱xki̱dxa̱ꞌxo̱ꞌ, najándawaxo̱ꞌ, nda̱a̱ xtíñaxo̱ꞌ, na̱gu̱ma-ngínáaꞌxo̱ꞌ, jamí nda̱a̱ guꞌwá ná ma̱juwaxo̱ꞌ. <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" />Jamí phú níꞌnga̱ꞌxo̱ꞌ numuu rí nu̱ñajunxo̱ꞌ mi̱ndaꞌkho ga̱jma̱á ñawánxo̱ꞌ. Nuthan-xkawia̱ꞌxo̱ꞌ xa̱bo̱, jamí ikháanꞌxo̱ꞌ nu̱ne̱-tsakun-rámii̱xo̱ꞌ. Nuxkaxo̱ꞌ xa̱bo̱, jamí ikháanꞌxo̱ꞌ na̱ꞌngo̱o̱ a̱kia̱nꞌxo̱ꞌ. <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />Ído̱ nune̱-xuxtaa xa̱bo̱ ga̱jma̱á numaxo̱ꞌ, ikháanꞌxo̱ꞌ nu̱tha̱nxo̱ꞌ rí máján ga̱jma̱á numúu̱. Asndo mbiꞌi ríge̱ꞌ nuña̱ꞌxo̱ꞌ xómá rí tsíjmaa mbá jayu ná numbaa, xómá náskúún xa̱bo̱ jaꞌñáaꞌxo̱ꞌ.<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />Ma̱xáju̱ma̱ꞌlaꞌ rí na̱tháán ríge̱ꞌ numuu rí nandoꞌ gáne̱-matiáanꞌlaꞌ, rí nandoꞌ gáxpríguálaꞌ xómá i̱ji̱nꞌ tsí phú nandoꞌ ja̱ñu̱ú. <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />Maske máꞌ phú mbaꞌiin mi̱ndaꞌkho xa̱bo̱ tsí nusngálaꞌ ajngóo Krísto̱, mbáwúún ikhúúnꞌ ñajunꞌ ana̱ꞌlaꞌ. Numuu rí nákhí ni̱tha̱nꞌlaꞌ ajngáa máján ga̱jma̱á numuu Krísto̱, mbiꞌi rúꞌkhue̱n ninindxu̱ꞌ ana̱ꞌlaꞌ. <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" />Ikhaa jngó, na̱tha̱n-jáñalaꞌ rí gu̱ya̱ri̱dalaꞌ xkri̱doo rí na̱ne̱lo̱ꞌ. <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />Ikhaa máꞌ numuu rúꞌkhue̱n ni̱xu̱ꞌmáalo̱ꞌ Timotéo̱ rí ma̱ꞌga gáꞌyalaꞌ. Timotéo̱ jaꞌnii xómá a̱ꞌdéꞌ, tsí phú nandoꞌ ja̱yo̱o̱ jamí jmbii ná inuu Táta̱. Ikhaa̱ ma̱ꞌnii̱ rí ma̱rmáꞌáan a̱kia̱nꞌlaꞌ xáne i̱sngáálo̱ꞌ numuu Krísto̱ mbá xúgíí ná nakalo̱ꞌ jamí ná mbá xúgíí kuthuun tsí nanimbu̱únꞌ juyáá Jesús.<verse eid="1CO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18" />Mbá tikhuun tsí ikháanꞌlaꞌ maphú nu̱xu̱xí-mijná, asndo xómá rí ni miꞌtsú náxáꞌgá gáya̱ꞌlaꞌ jaꞌnii. <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />Xómáꞌ ikhúúnꞌ na̱ꞌgí-mina̱ꞌ rí ma̱ꞌgá máꞌ wapha gáya̱ꞌlaꞌ, xí Táta̱ nandoo. A̱ꞌkhue̱n mba̱yo̱o̱ dí na̱ꞌngu̱ún guéño nune̱ tsí nu̱xu̱xí-mijná a̱ꞌkhue̱n, ra̱ꞌkhá i̱ndo̱ó rí nuthee̱n. <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />Numuu rí xa̱bo̱ tsí nithán-ñájwíín eꞌne Ana̱ꞌlóꞌ, ra̱ꞌkhá i̱ndo̱ó naꞌthée̱n, rí naꞌnii̱ rí naꞌthée̱n ga̱jma̱á ski̱yu̱u̱ꞌ Ana̱ꞌlóꞌ. <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />Xáne iyalaꞌ xúꞌkhue̱n rá. Ma̱ꞌgá gáya̱ꞌlaꞌ ga̱jma̱á xkuíya̱ ráanꞌ, o ma̱ꞌgá ga̱jma̱á ajngáa waba jamí ma̱ꞌgá gáne̱-xkáꞌtsalaꞌ dxe̱ꞌ.<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s">Xa̱bo̱ tsí nabóo ga̱jma̱á ru̱dúsko̱jo̱o̱</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />Phú mbaꞌiin xa̱bo̱ nuthan rí mbáa tsí ikháanꞌlaꞌ nabóo ga̱jma̱á ru̱dúsko̱jo̱o̱ asndo xómá a̱ꞌgui̱i. Mi̱ndaꞌkho xkawe̱ꞌ rúꞌkhue̱n, rí asndo ná majñu̱ú xa̱bo̱ tsí tsíne̱-nuwiin Ana̱ꞌlóꞌ tsíríga̱ rí xkuaꞌnii. <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />Á ikhaa numuu rúꞌkhue̱n rí nu̱xu̱xí-mijnálaꞌ guéño ga̱jma̱á numuu rá. Nagui̱i̱ꞌ xí ma̱ti̱ya̱ꞌlaꞌ rí ná majña̱ꞌlaꞌ a̱ꞌkhue̱n xtáa̱ tsí xkuaꞌnii eꞌne, jamí nagui̱i̱ꞌ xí mu̱xkriya̱a̱ꞌlaꞌ. <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />Maske máꞌ ndawu̱ún ikhúúnꞌ a̱ꞌkhue̱n ga̱jma̱á nindxa̱ꞌlaꞌ, mbóó máꞌ a̱kui̱nꞌ ga̱jma̱á nindxa̱ꞌlaꞌ. Ikhaa jngó, ikhúúnꞌ ni̱ra̱jwa̱ꞌ máꞌ ga̱jma̱á numuu xa̱bo̱ tsí xkuaꞌnii eꞌne, asndo xómá rí xtáá máꞌ a̱ꞌkhue̱n jaꞌnii. <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />Ikhaa jngó ído̱ rí nu̱ru̱wa-mijnáalaꞌ ga̱jma̱á numuu Tátiálóꞌ Jesukrísto̱, ikhúúnꞌ mangúúnꞌ xtáá ga̱jma̱á nindxa̱ꞌlaꞌ. A̱ꞌkhue̱n rí ga̱jma̱á ski̱yu̱u̱ꞌ Tátiálóꞌ Jesukrísto̱, <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />gu̱xna̱xíilaꞌ xa̱bo̱ tsúꞌkhue̱n ná ñawúun Satanás kajngó ma̱ja̱ñúu rí nandoo xuyuu̱, xómáꞌ nímii̱ ma̱jríya̱a̱ꞌ ído̱ gáꞌkha̱a Táta̱ Jesús.<verse eid="1CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />Ra̱máján e̱ne̱laꞌ rí nu̱xu̱xí-mijnálaꞌ. Ndu̱ya̱álaꞌ máꞌ rí «mbá lájwíin ñu̱u̱ miga̱ꞌ naꞌne ne̱ rí ma̱ga̱yu̱u̱ꞌ mbá xúgíí ñu̱u̱ rí máján». <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />Ikhaa jngó, gu̱ni̱ꞌñáálaꞌ janíí ñu̱u̱ miga̱ꞌ wayuu rí naꞌne-maꞌcháanꞌlaꞌ, kajngó ma̱nindxa̱ꞌlaꞌ xómá ñu̱u̱ nuxe̱ꞌ, rí na̱nguá gíꞌdoo ñu̱u̱ miga̱ꞌ. Ikháanꞌlaꞌ ñajwanlaꞌ xómá guma bopho rí naꞌpho̱ xa̱bo̱ ído̱ naríga̱ ndxa̱a̱ Páskua̱, jamí Krísto̱ ñajuun A̱ꞌdá-mógó tsí nijáñuu ga̱jma̱á numalóꞌ. <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />Ikhaa numuu rúꞌkhue̱n gu̱ꞌne̱-ri̱ya̱aꞌlóꞌ ndxa̱a̱ Páskua̱, ra̱ꞌkhá ga̱jma̱á ñu̱u̱ miga̱ꞌ rí niꞌchúu, ni máꞌ ra̱ꞌkhá ga̱jma̱á rí xkawe̱ꞌ jamí rí mi̱nduwa, rí gu̱ꞌne̱-ri̱ya̱aꞌlóꞌ ne̱ ga̱jma̱á guma bopho rí na̱nguá gíꞌdoo ñu̱u̱ miga̱ꞌ, ikhaa rí gakon jamí rí máján.<verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />Ni̱tha̱nꞌlaꞌ máꞌ ga̱jma̱á majñu̱u̱ mbá i̱yi̱i̱ꞌ rí ni̱xu̱ꞌmá inalaꞌ, rí ma̱xámbáxa̱ꞌlaꞌ gajmiálaꞌ xa̱bo̱ tsí nubúún gajmíí xa̱bo̱ tsí túya̱a̱. <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />Tsítha̱nꞌlaꞌ rí ma̱xámbáxa̱ꞌlaꞌ mbá jayu gajmiálaꞌ xa̱bo̱ tsí nune̱ aꞌkhán ná numbaa ríge̱ꞌ: tsí nubúún gajmíí xa̱bo̱ tsí túya̱a̱, o tsí na̱ni̱gu̱ún mu̱guaꞌdáá mi̱ndaꞌkho, o tsí nune̱-ku̱ꞌwá, o tsí nune̱-mbi̱in tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún mbo̱ꞌ. Xí rúꞌkhue̱n iyoꞌ gátha̱nꞌlaꞌ, ma̱nda̱ꞌa̱ꞌlaꞌ rí ma̱ga̱jnáaꞌlaꞌ mbá jayu ná numbaa xúꞌkhue̱n rá. <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />Rí phú nandoꞌ gátha̱nꞌlaꞌ ñajuun rí ma̱xámbáxa̱ꞌlaꞌ gajmiálaꞌ nimbáa tsí naꞌthán rí dxájwalóꞌ ñajuun, jamí nabóo ga̱jma̱á a̱ꞌgo̱ tsí táyáa, o na̱ni̱gu̱u̱ꞌ ma̱gi̱ꞌdoo mi̱ndaꞌkho, o naꞌne-mbi̱in tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún, o naꞌthán xkawe̱ꞌ, o najnga̱a̱, o naꞌne-kúwa̱ꞌ mbo̱ꞌ. Ni ma̱xátrigáanꞌlaꞌ rí mu̱peꞌtso gajmiálaꞌ xa̱bo̱ tsí naꞌne rúꞌkhue̱n. <verse eid="1CO 5:11" /><verse number="12" style="v" sid="1CO 5:12" />Numuu rí na̱nguá máꞌ jaꞌyoꞌ ikhúúnꞌ rí ma̱ra̱jwa̱ꞌ numúú tsí gachúún rixa̱á. Xómáꞌ ikháanꞌlaꞌ jaꞌyalaꞌ rí mu̱ra̱jwa̱ꞌlaꞌ numúú tsí gatiin awúún. <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />Jamí Ana̱ꞌlóꞌ jaꞌyoo rí ma̱ra̱jwa̱ꞌ numúú tsí gachúún rixa̱á. Ikhaa jngó, gu̱xkriya̱a̱ꞌlaꞌ xa̱bo̱ aꞌkhán tsúꞌkhue̱n ná majña̱ꞌlaꞌ.<verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s">Mu̱xúꞌgua̱ ju̱ꞌda-mijnálóꞌ ná inúú xa̱bo̱ ñajun</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />Ído̱ rí mbáa tsí ikháanꞌlaꞌ gíꞌdoo xkujndu ga̱jma̱á i̱mba̱a̱ꞌ, á tsíti̱yu̱u̱ꞌ rí nanújngoo̱ ná inúú xa̱bo̱ ñajun tsí tsíne̱-nuwiin Ana̱ꞌlóꞌ rá dxe̱ꞌ. Náá numuu kajngó tsíka̱ jayóo̱ xkujndu ríge̱ꞌ ná inúú xa̱bi̱i Ana̱ꞌlóꞌ róꞌ. <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />Á tsíya̱álaꞌ rí xa̱bi̱i Ana̱ꞌlóꞌ wéje̱ rí mu̱ra̱jwa̱ꞌ numúú xa̱bo̱ tsí júwa̱ꞌ ná numbaa rá dxe̱ꞌ. Xí ikháanꞌlaꞌ wéje̱ rí mu̱ra̱jwa̱ꞌlaꞌ numúú xa̱bo̱ tsí júwa̱ꞌ ná numbaa, na̱nguá máꞌ mingíjyúu rí mu̱ra̱jwa̱ꞌlaꞌ numuu xkujndu rí maka xúꞌkhue̱n rá. <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />Ndu̱ya̱á májánlaꞌ máꞌ rí ikháánꞌlóꞌ mu̱ra̱jwa̱ꞌlóꞌ numúú asndo ánje̱l. I̱wa̱á lá xkujndu rí ríga̱ ná numbaa ríge̱ꞌ mu̱xúra̱jwa̱ꞌlóꞌ numuu. <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />Ikhaa jngó, xí guáꞌdáálaꞌ xkujndu ga̱jma̱á numuu rí ríga̱ tsitsíí ná numbaa ríge̱ꞌ, mu̱xúraꞌwíinlaꞌ xa̱bo̱ tsí na̱nguá gíꞌdoo numúú ná inúú tsí nanimbu̱únꞌ juyáá Jesús rí mu̱ra̱jwa̱ꞌ numalaꞌ. <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />Na̱tha̱nꞌlaꞌ ríge̱ꞌ kajngó ma̱ti̱ya̱ꞌlaꞌ. Á ndawa̱a̱ asndo nimbáa tsí na̱ma̱ñuu ma̱ra̱jwa̱ꞌ numúú a̱ngui̱in ná majña̱ꞌlaꞌ kajngó dxe̱ꞌ. <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />Maphú mate̱ꞌ rí mbáa dxájwalóꞌ na̱tsa̱ñu̱u̱ꞌ ga̱jma̱á i̱mba̱a̱ꞌ dxájwalóꞌ ná inúú xa̱bo̱ ñajun tsí tsíne̱-nuwiin Ana̱ꞌlóꞌ.<verse eid="1CO 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7" />Mbáá máꞌ rí phú xkawe̱ꞌ ikujma rí mbáko máꞌ ikháanꞌlaꞌ na̱tsa̱ña̱ꞌlaꞌ. Náá numuu kajngó tsíne̱ mba̱a̱ a̱kia̱nꞌlaꞌ ído̱ rí na̱gu̱máaꞌlaꞌ rí ra̱máján róꞌ. Náá numuu kajngó tsíni̱ꞌñá-mijnálaꞌ rí ma̱gu̱ma-kúwa̱ꞌlaꞌ róꞌ. <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />Xómáꞌ ikháanꞌlaꞌ nu̱ne̱laꞌ rí ra̱máján jamí nu̱ne̱-ku̱ꞌwúúnlaꞌ asndo a̱ngia̱nꞌlaꞌ máꞌ.<verse eid="1CO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 6:9" />Ndu̱ya̱á máꞌ májánlaꞌ rí xa̱bo̱ tsí nune̱ rí xkawe̱ꞌ, nda̱a̱ rí gájanúu̱ ná naꞌthán-ñájun Ana̱ꞌlóꞌ. Mu̱xúne̱-nduwa-mijnálaꞌ. Ni máꞌ tsí nubúún gajmíí a̱ꞌgo̱ tsí túya̱a̱, ni máꞌ tsí nune̱-mbi̱in tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún, ni máꞌ tsí nubúún gajmíí a̱ꞌgui̱i i̱mba̱a̱ꞌ xa̱bo̱, ni máꞌ xa̱bekha tsí nune̱-mijná go̱ꞌo̱, ni máꞌ xa̱bekha tsí nubúún gajmíí xa̱bekha, <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />ni máꞌ tsí nune̱-ku̱ꞌwá, ni máꞌ tsí na̱ni̱gu̱ún mu̱guaꞌdáá mi̱ndaꞌkho, ni máꞌ tsí najngi̱in, ni máꞌ tsí nuxna-maꞌán, ni máꞌ tsí nu̱drígú-jáꞌñúú xa̱bo̱ ga̱jma̱á mi̱nduwa, nda̱a̱ rí gájanúu̱ ná naꞌthán-ñájun Ana̱ꞌlóꞌ. <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />Ikhaa ríge̱ꞌ ninindxu̱ún mbá tikhuun tsí ikháanꞌlaꞌ. Xómáꞌ Ana̱ꞌlóꞌ neꞌne mba̱a̱ a̱kuii̱n máꞌ jaꞌyalaꞌ, neꞌne-jaꞌwáa̱nꞌlaꞌ máꞌ, jamí nánda̱a̱ máꞌ aꞌkhánlaꞌ ga̱jma̱á numuu Táta̱ Jesukrísto̱,<note caller="+" style="f"><char style="fr" closed="false">6.11 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «Táta̱ Jesús».</char></note> jamí ga̱jma̱á numuu Xu̱u̱ꞌ Ana̱ꞌlóꞌ.<verse eid="1CO 6:11" /></para>
  <para style="s">Gu̱ꞌne̱-mba̱a̱lóꞌ Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ xuyalóꞌ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />Mbá tikhuun xa̱bo̱ nuthan: «Mbá xúgíí rí nandoꞌ, ma̱goo ma̱ne̱lo̱ꞌ», i̱ndo̱ó máꞌ numuu rí ra̱ꞌkhá mbá xúgíí nafriya̱ꞌ. «Mbá xúgíí rí nandoꞌ, ma̱goo ma̱ne̱lo̱ꞌ», i̱ndo̱ó máꞌ numuu rí ikhúúnꞌ ma̱xáni̱ꞌñá-mina̱ꞌ rí maxná-ñájwinꞌ asndo nimbá. <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />I̱ꞌwíin xa̱bo̱ nuthan: «Rí ganitsu ni̱gu̱ma-ku̱maa ne̱ rí ma̱ti ne̱ ná awúun xa̱bo̱, jamí xa̱bo̱ gíꞌdoo awúun kajngó ma̱ti ganitsu». I̱ndo̱ó máꞌ numuu rí Ana̱ꞌlóꞌ ma̱ꞌne-gámbo̱o̱ mbá nájma̱ rúꞌkhue̱n. Xómáꞌ xuyalóꞌ, tágu̱ma-ku̱maa ne̱ kajngó mu̱ꞌbálóꞌ gajmiálóꞌ xa̱bo̱ tsí túꞌyáalóꞌ, rí xuyalóꞌ ni̱gu̱ma-ku̱maa ne̱ kajngó mu̱ꞌne̱-mba̱a̱lóꞌ Táta̱, jamí Táta̱ xtáa̱ rí ma̱ña̱wu̱u̱n xuyalóꞌ. <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />Xómá rí Ana̱ꞌlóꞌ neꞌne rí mbayáa mbiꞌyuu Táta̱, xkuaꞌnii máꞌ ma̱ꞌnii̱ rí mbu̱ꞌyáa mbiꞌyalóꞌ mangáanꞌlóꞌ ga̱jma̱á ski̱yu̱u̱ꞌ. <verse eid="1CO 6:14" /><verse number="15" style="v" sid="1CO 6:15" />Ndu̱ya̱á májánlaꞌ máꞌ rí mbámbáa tsí ikháanꞌlaꞌ jimaa ná xuyuu Krísto̱. Ra̱máján rí mba̱ya̱lo̱ꞌ mbá dxájuu xuyuu Krísto̱ jamí ma̱ne̱ rí mago̱-mina̱ꞌ ne̱ ga̱jma̱á mbáa a̱ꞌgo̱ tsí na̱ngu̱jwa̱-mina̱ꞌ. <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />Á tsíya̱álaꞌ rí xa̱bo̱ tsí nabóo ga̱jma̱á a̱ꞌgo̱ tsí na̱ngu̱jwa̱-mina̱ꞌ, nanindxu̱u̱ i̱mba̱wíi xa̱bo̱ ga̱jmáa̱ rá dxe̱ꞌ. Numuu rí xkuaꞌnii ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ: «Nájmii̱ ma̱nindxúu̱n i̱mba̱wíi xa̱bo̱».<note caller="+" style="f"><char style="fr" closed="false">6.16 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ xó ni̱gi̱ꞌdu̱u̱n-muu 2.24. </char></note> <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />Xómáꞌ tsí na̱ru̱wa-mina̱ꞌ ga̱jma̱á Táta̱ rá, naꞌni̱i la i̱mbo̱ó nímii̱ ga̱jma̱á nindxu̱u̱.<verse eid="1CO 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18" />Mu̱xúba̱ꞌlaꞌ gajmiálaꞌ xa̱bo̱ tsí túya̱a̱laꞌ. Asndo náá máꞌ rí i̱mba̱ aꞌkhán rí naꞌne xa̱bo̱, tsíꞌne-ñawúu̱n máꞌ xuyuu̱. Xómáꞌ tsí nabóo ga̱jma̱á xa̱bo̱ tsí táyáa rá, naꞌnii̱ aꞌkhán ga̱jma̱á numuu xuyuu̱. <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" />Á tsíya̱álaꞌ rí ikháanꞌlaꞌ ñajwanlaꞌ xómá guꞌwóo Xu̱u̱ꞌ Ana̱ꞌlóꞌ rá dxe̱ꞌ. Xu̱u̱ꞌ Ana̱ꞌlóꞌ xtáa ná awúun a̱kia̱nꞌlaꞌ, jamí na̱nguá jaꞌyalaꞌ ikháanꞌlaꞌ xuyalaꞌ. <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />Numuu rí Ana̱ꞌlóꞌ niꞌtsiáanꞌlaꞌ. Ikhaa jngó, gu̱ne̱-mba̱a̱laꞌ Ana̱ꞌlóꞌ ga̱jma̱á xuyalaꞌ jamí ga̱jma̱á xa̱ꞌlaꞌ, numuu rí ikhaa rúꞌkhue̱n jaꞌyoo Ana̱ꞌlóꞌ.<note caller="+" style="f"><char style="fr" closed="false">6.20 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «jamí ga̱jma̱á xa̱ꞌlaꞌ, numuu rí ikhaa rúꞌkhue̱n jaꞌyoo Ana̱ꞌlóꞌ». </char></note><verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s">Rí nithúún xa̱bekha jamí go̱ꞌo̱ tsí nida-mijná</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />Xúge̱ꞌ rí ma̱riꞌña̱a graxe̱ rí ni̱ñu̱ꞌlaꞌ ga̱jma̱á majñu̱u̱ i̱yi̱i̱ꞌ rá. Máján máꞌ xí tsínigúún xa̱biya̱. <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />I̱ndo̱ó máꞌ numuu rí phú nubúún xa̱bo̱ gajmíí tsí na̱nguá ndiya̱a̱, ikhaa jngó mbámbáa xa̱biya̱ gági̱ꞌdaa a̱ꞌgui̱i, jamí mbámbáa a̱ꞌgo̱ gági̱ꞌdaa a̱jmbe̱e. <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />Tsí xa̱biya̱ ga̱ꞌne-mbánuu̱ rí nandoo a̱ꞌguii̱, xúꞌkhue̱n máꞌ a̱ꞌgo̱ mangaa, ga̱ꞌne-mbánuu̱ rí nandoo a̱jmbee̱. <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />Numuu rí a̱ꞌgo̱ tsí ninújún ra̱jáꞌyoo̱ ikhaa̱ xuyuu̱, rí a̱jmbee̱ jaꞌyoo ne̱. Ni máꞌ xa̱biya̱ tsí ninigúún ra̱jáꞌyoo̱ ikhaa̱ xuyuu̱, rí a̱ꞌguii̱ jaꞌyoo ne̱. <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />Ikhaa jngó, ma̱xánga̱jwa̱ꞌlaꞌ rí mu̱ne̱-mbánu-mijnálaꞌ rí nandoo xuyalaꞌ, o i̱ndo̱ó máꞌ xí nu̱tha̱n-mijnálaꞌ rí mu̱xúne̱laꞌ rí nandoo xuyalaꞌ mbá wátha̱ wáa mbiꞌi kajngó mu̱tha̱n-jáñíílaꞌ Ana̱ꞌlóꞌ rá mbo̱ꞌ. Gu̱ru̱wa-mijnáalaꞌ mbu̱júꞌ xí ninújngoo máꞌ mbiꞌi rúꞌkhue̱n, ra̱ꞌkhá ma̱ꞌne-rájáanꞌlaꞌ Satanás rí mu̱ne̱laꞌ aꞌkhán ga̱jma̱á numuu rí tsíꞌnga̱ꞌlaꞌ mu̱waꞌthi̱ínlaꞌ mba̱yo̱ꞌ. <verse eid="1CO 7:5" /><verse number="6" style="v" sid="1CO 7:6" />Mbá ju̱ma̱ jayu ñajuun rí na̱tha̱nlo̱ꞌ, ra̱ꞌkhá máꞌ mbá xtángoo. <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />Rí phú naꞌne a̱kui̱nꞌ ikhúúnꞌ ñajuun rí mbá xúgíin xa̱bekha gánindxu̱ún xómá ikhúúnꞌ. I̱ndo̱ó máꞌ numuu rí mbámbáa nijanáá xómá rí ma̱xtáa̱ neꞌne Ana̱ꞌlóꞌ. Mbá xó nijanáá mbáa, jamí i̱mba̱ xó nijanáá i̱mba̱a̱ꞌ.<verse eid="1CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8" />Xómáꞌ xa̱bo̱ tsí xóó máꞌ tsíni̱gu̱nꞌ jamí go̱ꞌóxuáꞌa rá, na̱thúu̱nlo̱ꞌ ríge̱ꞌ: Maphú máján máꞌ rí ma̱nguanúu̱ xómá ikhúúnꞌ. <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />I̱ndo̱ó máꞌ numuu rí, xí tsíꞌngúu̱n rí mu̱xúbúu̱n gajmíi̱ xa̱bo̱ rá, gu̱ni̱gui̱i̱nꞌ jamí gu̱nu̱jwíi̱n máꞌ xúꞌkhue̱n rá. Numuu rí i̱tha̱án máꞌ máján rí manigúún o manújún xa̱bo̱ xó rí ma̱xáꞌngo̱o̱ gáꞌnii̱ gakhe̱ a̱kuii̱n.<verse eid="1CO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10" />Xómáꞌ tsí nida-mijná máꞌ rá, na̱thúu̱nlo̱ꞌ ríge̱ꞌ, (ra̱ꞌkhá máꞌ ikhúúnꞌ i̱tha̱nlo̱ꞌ, rí jmína̱a̱ꞌ máꞌ Táta̱ niꞌthán): Ma̱xániña̱a a̱jmbe̱e a̱ꞌgo̱. <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />Jamí xí naniñaa̱ a̱jmbaa̱ rá, náxánújwíi̱n, o i̱ndo̱ó máꞌ xí nambáxii̱ mbu̱júꞌ ga̱jmáa̱ a̱jmbaa̱ mbo̱ꞌ. Xúꞌkhue̱n máꞌ xa̱biya̱, ma̱xániñaa̱ a̱ꞌguii̱.<verse eid="1CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12" />Xómáꞌ tsí i̱ꞌwíin rá, na̱thúu̱n ríge̱ꞌ (ra̱ꞌkhá máꞌ Táta̱ iꞌthán): Xí mbáa dxájwalóꞌ ꞌgí ga̱jma̱á mbáa a̱ꞌgo̱ tsí tsínimbo̱o̱ꞌ jaꞌyoo Jesukrísto̱, jamí nandoo máꞌ a̱ꞌgo̱ gáxtáa ga̱jma̱á nindxu̱u̱ rá, ma̱xániñaa̱ máꞌ a̱ꞌguii̱. <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />Jamí xí mbáa dxájwalóꞌ a̱ꞌgo̱ ꞌgí ga̱jma̱á mbáa xa̱biya̱ tsí tsínimbo̱o̱ꞌ jaꞌyoo Jesukrísto̱, jamí nandoo máꞌ xa̱biya̱ gáxtáa ga̱jma̱á nindxu̱u̱ rá, ma̱xániñaa̱ máꞌ a̱jmbaa̱. <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />Numuu rí xa̱biya̱ tsí tsínimbo̱o̱ꞌ jaꞌyoo Jesukrísto̱, na̱gu̱ma-tsakun-rámaa̱ ga̱jma̱á numuu a̱ꞌguii̱. Jamí a̱ꞌgo̱ tsí tsínimbo̱o̱ꞌ jaꞌyoo Jesukrísto̱, na̱gu̱ma-tsakun-rámaa̱ ga̱jma̱á numuu a̱jmbaa̱. Xí ra̱ꞌkhá xkuaꞌnii, na̱nguá máꞌ jaꞌwuun i̱jña̱ꞌlaꞌ mangiin xúꞌkhue̱n rá. I̱ndo̱ó máꞌ numuu phú gakon rí Ana̱ꞌlóꞌ gíꞌdii̱n xómá xa̱bii̱.<verse eid="1CO 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 7:15" />I̱ndo̱ó máꞌ numuu rí, xí xa̱biya̱ o a̱ꞌgo̱ tsí tsínimbo̱o̱ꞌ jaꞌyoo Jesukrísto̱ nandoo gáꞌne-wájí-mina̱ꞌ rá mbo̱ꞌ, ma̱goo máꞌ ma̱ꞌnii̱. A̱ꞌkhue̱n rí nánguá máꞌ iꞌyóo rí ga̱jma̱á tsiakhe̱ ma̱nguanúu dxájwalóꞌ ga̱jma̱á nindxu̱u̱ xúꞌkhue̱n rá, numuu rí Ana̱ꞌlóꞌ nindxaꞌwálóꞌ rí ma̱juwalóꞌ tsímáá. <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />Numuu rí tsiánguá xí ra̱ꞌkhá ga̱jma̱á numaaꞌ ikháánꞌ, nána̱, ma̱jríya̱a̱ꞌ a̱jmba̱aꞌ. Ni máꞌ tsiánguá xí ra̱ꞌkhá ga̱jma̱á numaaꞌ ikháánꞌ, táta̱, ma̱jríya̱a̱ꞌ a̱ꞌgia̱aꞌ.<verse eid="1CO 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />Mbámbáa gáxtáa xómá nijanáá rí ma̱xtáa neꞌne Táta̱, jamí ga̱xtáa̱ xómá jaꞌnii̱ nákhí rí watsaꞌwáa̱ neꞌne Ana̱ꞌlóꞌ. Xkuaꞌnii máꞌ i̱tha̱nlo̱ꞌ rí ma̱gu̱ma ná mbá xúgíí kuthuun tsí nanimbu̱únꞌ juyáá Jesús. <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />Xí mbáa jayá máꞌ tsina jndi nákhí rí watsaꞌwáá, a̱nguanúu̱ máꞌ xkuaꞌnii. Xí mbáa na̱nguá máꞌ xóó jayá tsina jndi nákhí rí watsaꞌwáá, ma̱xáyée̱ máꞌ tsina jndi. <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />Na̱nguá máꞌ gíꞌdoo numuu rí mbayá o ma̱xáyá xa̱bo̱ tsina jndi. Rí phú i̱tha̱án gíꞌdoo numuu ñajuun rí ma̱ꞌne-mbánuu̱ ajngóo Ana̱ꞌlóꞌ. <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />Mbámbáa ánguanúu xómá jaꞌnii nákhí rí watsaꞌwáá neꞌne Ana̱ꞌlóꞌ. <verse eid="1CO 7:20" /><verse number="21" style="v" sid="1CO 7:21" />Xí yumbáá tsí waꞌtsi̱i̱ ñajwaanꞌ nákhí rí watsaꞌwáaꞌ, ma̱xáxná-gamiéjwaanꞌ. Jamí xí ni̱ga̱nú mbiꞌi rí nandoo ma̱jríñáaꞌ rá, a̱ga̱jnáaꞌ máꞌ. <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />Tsí watsaꞌwáá neꞌne Táta̱ nákhí rí yumbáá tsí waꞌtsi̱i̱ ñajuun, Táta̱ neꞌne-jríya̱a̱ꞌ rí ma̱nindxu̱u̱ xa̱bii̱. Xúꞌkhue̱n máꞌ xa̱bo̱ tsí naꞌthán-ñájun-mina̱ꞌ máꞌ ikhaa nákhí rí watsaꞌwáá, yumbáá tsí waꞌtsi̱i̱ neꞌne Krísto̱ ñajuu̱n rí xúge̱ꞌ rá. <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />Phú tsída̱ꞌ neꞌne-numuu Ana̱ꞌlóꞌ ga̱jma̱á numalaꞌ. Ikhaa jngó, mu̱xúni̱ꞌñá-mijnálaꞌ rí ma̱nindxa̱ꞌlaꞌ yumbáá waꞌtsi̱in drígu̱ún xa̱bo̱ numbaa. <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />A̱ngui̱nꞌ, mbámbáa gáxtáa ná inuu Ana̱ꞌlóꞌ, xómá jaꞌnii̱ nákhí rí watsaꞌwáa̱.<verse eid="1CO 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />Xómáꞌ i̱jín-go̱ꞌo̱ tsí xóó máꞌ túbúún gajmíí xa̱bo̱ rá, nda̱a̱ máꞌ rí nixnángaweꞌ Táta̱ rí ma̱thúu̱nlo̱ꞌ. Xómáꞌ ikhúúnꞌ ma̱tha̱n rí na̱ju̱mu̱ꞌlo̱ꞌ, ga̱jma̱á numuu rí nañáwíin a̱kui̱in Táta̱ e̱ne̱lo̱ꞌ, naꞌnii̱ rí ma̱nindxu̱ꞌ xa̱bo̱ tsí kuwiin. <verse eid="1CO 7:25" /><verse number="26" style="v" sid="1CO 7:26" />Xáꞌnii i̱ju̱mu̱ꞌ ikhúúnꞌ: Máján máꞌ gáꞌne mbámbáa xí ma̱nguanúu xómá jaꞌnii xúge̱ꞌ, numuu rí phú gakhe̱ ma̱juwalóꞌ rí mbiꞌi xúge̱ꞌ. <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />Xí xa̱bo̱ tsí gíꞌdaa máꞌ a̱ꞌgui̱i ñajwaanꞌ, ma̱xátha̱ꞌgí-mina̱ꞌ máꞌ rí ma̱ta̱tsi̱ꞌñáa a̱ꞌgia̱aꞌ. Xí xa̱bo̱ tsí na̱nguá máꞌ xóó ninigúún ñajwaanꞌ, ma̱xátha̱ꞌgí-mina̱ꞌ máꞌ rí ma̱ta̱tsi̱ꞌgúún. <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />Jamí xí natatsigúún rá, ra̱ꞌkhá máꞌ aꞌkhán ithane̱. Jamí xí nanújún dxáꞌgú rá, ra̱ꞌkhá máꞌ aꞌkhán iꞌnii̱. I̱ndo̱ó máꞌ numuu rí xa̱bo̱ tsí nuda-mijná nune̱-gajmá-mijná guéñúu̱, jamí ikhúúnꞌ tsíyoꞌ rí mu̱gíꞌníílaꞌ rúꞌkhue̱n.<verse eid="1CO 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29" />A̱ngui̱nꞌ, rí phú nandoꞌ gátha̱nꞌlaꞌ ñajuun ríge̱ꞌ: na̱nguá guáꞌdáálóꞌ mbaꞌa mbiꞌi. Ikhaa jngó, tsí ni̱ni̱gu̱nꞌ máꞌ guni̱i̱ ñajuun Táta̱ asndo xómá rí na̱nguá guáꞌdaa̱ a̱ꞌguíi̱n. <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />Tsí nu̱mbi̱ya̱ꞌ, guni̱i̱ ñajuun Táta̱ asndo xómá rí tsímbi̱ye̱e̱ꞌ. Tsí nadxu a̱kui̱ín, guni̱i̱ ñajuun Táta̱ asndo xómá rí tsídxu a̱kuíi̱n. Tsí nutse̱, guni̱i̱ ñajuun Táta̱ asndo xómá rí nda̱a̱ rí guáꞌdáa̱. <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />Jamí tsí nune̱-gagi a̱kui̱ín ga̱jma̱á rí ríga̱ ná tsu̱du̱u̱ numbaa ríge̱ꞌ, guni̱i̱ ñajuun Táta̱ asndo xómá rí nda̱a̱ numuu ne̱. Numuu rí xómá jaꞌnii numbaa xúge̱ꞌ, ma̱mbáa ne̱.<verse eid="1CO 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32" />Ikhaa jngó, ikhúúnꞌ nandoꞌ rí mu̱xúxna̱-mijnálaꞌ gaꞌkho̱. Tsí xóó máꞌ tsínigúún naxná-gamiéjuu̱n rí ma̱ꞌnii̱ ñajuun Táta̱, kajngó ma̱ni̱gu̱u̱ꞌ Táta̱ gáꞌnii̱. <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />Xómáꞌ tsí ninigúún máꞌ rá, naxná-gamiéjuu̱n rí ma̱ꞌnii̱ ñajuun numbaa, jamí xáne gáꞌnii̱ rí ma̱ni̱gu̱u̱ꞌ a̱ꞌguii̱ jaꞌyoo̱. <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />Xkuaꞌnii máꞌ mangaa, kriꞌkhu rí naxná-gamiéjuun a̱ꞌgo̱ tsí ninújún máꞌ ga̱jma̱á dxáꞌgú tsí xóó máꞌ tsínújún. Dxáꞌgú tsí xóó máꞌ tsínújún naxná-gamiéjuu̱n rí ma̱ꞌnii̱ ñajuun Táta̱, jamí rí maxnáxe̱-mine̱e̱ꞌ mbá jayu ná ñawúun Ana̱ꞌlóꞌ. Xómáꞌ a̱ꞌgo̱ tsí ninújún máꞌ rá, naxná-gamiéjuu̱n rí ma̱ꞌnii̱ ñajuun numbaa, jamí xáne gáꞌnii̱ rí ma̱ni̱gu̱u̱ꞌ a̱jmbaa̱ jaꞌyoo̱. <verse eid="1CO 7:34" /><verse number="35" style="v" sid="1CO 7:35" />Ra̱ꞌkhá numuu nandoꞌ gárikhalaꞌ kajngó na̱tha̱nꞌlaꞌ ríge̱ꞌ, rí numuu nandoꞌ ma̱mbáyálaꞌ rí ma̱juwalaꞌ mu̱ne̱ ñajuun Táta̱, jamí nda̱a̱ nitháan rí gáwe̱je̱-ꞌthu̱u̱n rí mu̱ne̱laꞌ rí nandoo̱.<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />Xí mbáa na̱ju̱mu̱u̱ rí jaꞌyoo máꞌ rí ma̱ꞌne-mbánuu mbayáa dxáꞌgú tsí nimbánuu máꞌ rí mbayáa numuu rí nikhi̱i̱ máꞌ rá, ga̱ꞌnii̱ xómá na̱ju̱mu̱u̱ rí ma̱ꞌnii̱. Numuu rí ra̱ꞌkhá máꞌ aꞌkhán ini̱i̱ rí muda-mijnée̱. <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />Jamí xí i̱mba̱a̱ꞌ naꞌne mbá jañii a̱kui̱in, jamí mbáko máꞌ naꞌgí-mina̱ꞌ rí ma̱xáyáa dxáꞌgú tsí wéje̱ máꞌ rí mbayáa, numuu rí na̱ꞌngo̱o̱ máꞌ naꞌnii̱ gakhe̱ a̱kuii̱n, jamí ikhaa̱ máꞌ naꞌthán-ñájun-mine̱e̱ꞌ rá, máján máꞌ eꞌne tsúꞌkhue̱n mangaa. <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />Ikhaa jngó, máján máꞌ eꞌne tsí ndayáa dxáꞌgú tsí wéje̱ máꞌ rí mbayáa, jamí i̱tha̱án máꞌ máján eꞌne tsí na̱nguá iyáa̱.<verse eid="1CO 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39" />A̱ꞌgo̱ tsí ninújún, xtáa̱ xtoꞌwóo̱ ná inuu xtángoo ga̱jmáa̱ a̱jmbaa̱ awúun mbiꞌi rí xtáa ndaꞌya. Jamí xí nijáñuu a̱jmbaa̱ rá, ma̱goo manújúu̱n ga̱jmáa̱ tsí nandoo̱ máꞌ ikhaa̱, i̱ndo̱ó máꞌ numuu rí ndaꞌyóo rí xa̱bo̱ tsúꞌkhue̱n ma̱nindxu̱u̱ xa̱bi̱i Táta̱ mangaa. <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />Ikhúúnꞌ na̱ju̱mu̱ꞌ rí i̱tha̱án máꞌ gagi gáxtáa̱ xí tsínújúu̱n mbu̱júꞌ. Na̱tha̱nꞌlaꞌ ríge̱ꞌ numuu na̱ju̱mu̱ꞌ rí Xu̱u̱ꞌ Ana̱ꞌlóꞌ jayá ikhoꞌ mangúúnꞌ.<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s">Tsi̱gi̱jña̱ꞌ rí kixnáxe̱ inúú tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />Xúge̱ꞌ rí nandoꞌ ma̱tha̱nꞌlaꞌ ga̱jma̱á numuu tsi̱gi̱jña̱ꞌ rí kixnáxe̱ inúú tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún. Gakon máꞌ rí «mbá xúgiáanꞌlóꞌ na̱ma̱ñalóꞌ ga̱jma̱á numuu rúꞌkhue̱n». Rí na̱ma̱ñalóꞌ naꞌne rí mu̱xu̱xí-mijnálóꞌ, xómáꞌ rí nandalóꞌ juꞌñúú a̱ngia̱nꞌlóꞌ rá, naꞌne rí ma̱gajii̱n. <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />Xí mbáa na̱ju̱mu̱u̱ rí na̱ma̱ñuu guéño, asndo xóó máꞌ tsíma̱ñuu̱ nitháan rí jaꞌyoo ma̱ma̱ñuu̱. <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />Xí mbáa nandoo jaꞌyoo Ana̱ꞌlóꞌ, na̱gu̱ma-nuwii̱n máꞌ eꞌne Ana̱ꞌlóꞌ.<verse eid="1CO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4" />Ikhaa jngó, á ma̱goo mu̱ꞌpholóꞌ rí kixnáxe̱ ná inúú tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún rá. Nduꞌyáálóꞌ máꞌ rí nda̱a̱ rí gíꞌdoo numúú tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún ná numbaa ríge̱ꞌ, jamí mbáwíi máꞌ tsí ñajuun Ana̱ꞌlóꞌ xtáa. <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />Maske máꞌ júwa̱ꞌ mbaꞌiin tsí nithúún «ana̱ꞌlóꞌ» o «táta̱» ene̱ xa̱bo̱ ná mikhuíí jamí ná numbaa ríge̱ꞌ, <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />xómáꞌ ikháánꞌlóꞌ nduꞌyáálóꞌ rí mbáwíi máꞌ Ana̱ꞌlóꞌ Mikhuíí xtáa̱. Ikhaa̱ neꞌne-ku̱maa̱ mbá xúgíí rí ríga̱, jamí ikháánꞌlóꞌ juwalóꞌ rí mu̱ꞌne̱lóꞌ ñajuu̱n. Xúꞌkhue̱n máꞌ mbáwíi tsí ñajuun Táta̱ xtáa̱, ikhaa ñajuun Jesukrísto̱. Ga̱jma̱á majñu̱u̱ ikhaa̱ ni̱gu̱ma-ku̱maa mbá xúgíí rí ríga̱, jamí ga̱jma̱á numuu̱ máꞌ ikhaa̱ juwalóꞌ.<verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />I̱ndo̱ó máꞌ numuu rí ra̱ꞌkhá mbá xúgíin nduyáá rí xkuaꞌnii. Nákhí rí ginii mbá tikhuáanꞌlaꞌ naguꞌwanlaꞌ máꞌ rí nu̱ne̱-mbi̱inlaꞌ tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún, ikhaa jngó ído̱ rí napholaꞌ xuwi rúꞌkhue̱n, na̱ju̱ma̱ꞌlaꞌ rí ra̱máján e̱ne̱laꞌ ga̱jma̱á numuu rí a̱jma̱ a̱kia̱nꞌlaꞌ. <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />Ra̱ꞌkhá rí napholóꞌ naꞌne rí ma̱ni̱gu̱u̱ꞌ Ana̱ꞌlóꞌ jaꞌyalóꞌ. Ra̱ꞌkhá numuu rí napholóꞌ i̱tha̱án májáanꞌlóꞌ, o numuu rí tsípholóꞌ i̱tha̱án ra̱májáanꞌlóꞌ mbo̱ꞌ.<verse eid="1CO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9" />Gia̱wa̱n gúne̱laꞌ, ra̱ꞌkhá rí máján nandoo mu̱ne̱ ikháanꞌlaꞌ ma̱ꞌne-ñawúún i̱ꞌwíin tsí tsíma̱ñúú mújúún xóó. <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />Xí mbáa tsí a̱jma̱ a̱kui̱in ndaꞌyaaꞌ ikháánꞌ, tsáánꞌ na̱ma̱ñaaꞌ májáanꞌ, rí natseꞌtso ná na̱gu̱ma-mbi̱in tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún, ngamí ma̱wa̱ꞌa̱ a̱kuii̱n mi̱khui̱i̱ mangaa̱ rí waxnáxe̱ ná inúú tsúꞌkhue̱n, maske máꞌ na̱ju̱mu̱u̱ rí ra̱máján mi̱khui̱i̱ ne̱. <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />A̱ꞌkhue̱n ga̱jma̱á numuu rí na̱ma̱ñaaꞌ ikháánꞌ, ma̱ngra̱ꞌaa dxájwalóꞌ tsí tsíma̱ñuu mújúun, maske máꞌ nijáñuu Krísto̱ ga̱jma̱á numuu̱. <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />Ído̱ nathane̱ rí ma̱ꞌne aꞌkhán dxájwaaꞌ tsí na̱nguá xóó jañii a̱kui̱in, numuu nathane̱ rí ma̱ꞌnii̱ rí ra̱máján iꞌyoo̱ ikhaa̱, nataxúda-mina̱ꞌ aꞌkhán ná inuu Krísto̱. <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />Ikhaa jngó, xí ga̱jma̱á numuu rí nakholo̱ꞌ ma̱ꞌne a̱jma̱ a̱kui̱in dxájuꞌ, ni miꞌtsú náxéꞌkholo̱ꞌ xuwi, ra̱ꞌkhá ma̱ꞌnii̱ aꞌkhán gáne̱lo̱ꞌ.<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s">Rí jaꞌyoo mbáa tsí waxúngua̱a̱ꞌ neꞌne Jesús</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />Tsáa lá irikheꞌ rí ma̱ne̱ rí nandoꞌ rá. Ikhúúnꞌ ñajunꞌ mbáa tsí waxúngua̱a̱ꞌ, ndi̱yo̱o̱lo̱ꞌ Tátiálóꞌ Jesús, jamí ikháanꞌlaꞌ nanimba̱ꞌlaꞌ ju̱ya̱á Táta̱ ga̱jma̱á numuꞌ ikhúúnꞌ. <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />Maske máꞌ ra̱ꞌkháa tsí waxúngua̱a̱ꞌ ñajunꞌ iyáá tsí i̱ꞌwíin, xómáꞌ ikháanꞌlaꞌ ndu̱ya̱álaꞌ rí ikhaa ñajunꞌlo̱ꞌ. Numuu rí ikháanꞌlaꞌ juwalaꞌ ga̱jma̱á nindxu̱u̱ Táta̱, rúꞌkhue̱n isngájma rí mbáa tsí waxúngua̱a̱ꞌ ñajunꞌlo̱ꞌ.<verse eid="1CO 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3" />Xáꞌnii i̱riꞌñúúlo̱ꞌ tsí nuthan numuꞌlo̱ꞌ: <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />Á ra̱jáꞌyaxo̱ꞌ mu̱peꞌtsoxo̱ꞌ jamí mu̱wánxo̱ꞌ iya ikháanꞌxo̱ꞌ rá dxe̱ꞌ. <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />Á ra̱jáꞌyaxo̱ꞌ rí ma̱ngriga̱ꞌ gajmiáxo̱ꞌ dxájwalóꞌ tsí a̱ꞌgia̱ꞌxo̱ꞌ mangáanꞌxo̱ꞌ xómá ngrigu̱ún i̱ꞌwíin tsí waxúngui̱inꞌ rá dxe̱ꞌ, xómá ngrigu̱ún dxíyo̱o̱ Táta̱ jamí Pédro̱.<note caller="+" style="f"><char style="fr" closed="false">9.5 </char><char style="ft" closed="false">«Pedro» ñajuun ajngáa griégo̱ jamí «Cefas» ñajuun ajngáa araméo̱.</char></note> <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />Á i̱ndo̱ó máꞌ ikhúúnꞌ ga̱jmi̱ꞌ Bernabé jaꞌyaxo̱ꞌ rí mu̱ñajunxo̱ꞌ rí mbu̱ꞌyá mbiꞌyaxo̱ꞌ rá dxe̱ꞌ.<verse eid="1CO 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 9:7" />Nimbáa xa̱bo̱ tsí kuatuun ajwa̱nꞌ tsíꞌne-numa-mine̱e̱ꞌ máꞌ ikhaa̱. Xómáꞌ tsí naꞌdu ajmu̱u̱ úba̱ ná mbayuu, naꞌkhui̱i̱ xndúu ne̱ ído̱ najma̱a̱. Xúꞌkhue̱n máꞌ tsí na̱ña̱wu̱ún xu̱kú, naꞌña̱a̱ yaꞌdú ído̱ naríye̱e̱ꞌ ne̱. <verse eid="1CO 9:7" /><verse number="8" style="v" sid="1CO 9:8" />Ma̱xáju̱ma̱ꞌlaꞌ rí i̱ndo̱ó máꞌ ju̱mu̱ú xa̱bo̱ numbaa ñajuun ríge̱ꞌ. Á ra̱ꞌkhá xkuaꞌnii máꞌ iꞌthán xtángawoo Moisés mangaa rá dxe̱ꞌ. <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" />Xáꞌnii ka̱ma naꞌthán ná xtángoo drígo̱o̱ Moisés: «Ma̱xáta̱xu̱ꞌdáa ama rawuun xede̱ tsí nañajun».<note caller="+" style="f"><char style="fr" closed="false">9.9 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yi̱i̱ꞌ rí naꞌthán ikhaa máꞌ xtángoo 25.4.</char></note> Á rúꞌkhue̱n iꞌthán rí naxná-gamiéjuun Ana̱ꞌlóꞌ ene̱ xede̱ rá dxe̱ꞌ. Na̱nguá, <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />ikháánꞌlóꞌ naxná-gamiéjuu̱n e̱ꞌne̱lóꞌ. Ga̱jma̱á numalóꞌ ikháánꞌlóꞌ waꞌtháán ríge̱ꞌ. Tsí nañajuun ju̱ba̱ꞌ jamí tsí naꞌne-jaꞌwu̱u rí nijma̱a̱, ga̱jma̱á mbá jañii a̱kuíi̱n guáꞌthíi̱n rí ma̱janúu̱ tháan mangii̱n rí nijma̱a̱. <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" />Xí ikháanꞌxo̱ꞌ ni̱dúxo̱ꞌ ajngóo Ana̱ꞌlóꞌ ná awúun a̱kia̱nꞌlaꞌ, á phú ra̱jáꞌyoo rí mu̱drígúxo̱ꞌ tháan rí guáꞌdáálaꞌ ma̱juwaxo̱ꞌ ga̱jma̱á rá dxe̱ꞌ. <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />Xí jaꞌñúú tsí i̱ꞌwíin rí mu̱drígú rí guáꞌdáálaꞌ, á ra̱ꞌkhá i̱tha̱án jaꞌyaxo̱ꞌ ikháanꞌxo̱ꞌ rá dxe̱ꞌ.</para>
  <para style="p" vid="1CO 9:12">Xómáꞌ ikháanꞌxo̱ꞌ túnda̱ꞌa̱xo̱ꞌ rí ikháanꞌlaꞌ mu̱xna̱ꞌxo̱ꞌ rí jaꞌyaxo̱ꞌ, maske máꞌ phú jaꞌyaxo̱ꞌ ne̱. Mbá xúgíí máꞌ nu̱xpígaa a̱kia̱nꞌxo̱ꞌ kajngó nda̱a̱ rí gáwe̱je̱-ꞌthu̱u̱n rí mi̱ꞌthán-raꞌa ajngáa máján ga̱jma̱á numuu Krísto̱. <verse eid="1CO 9:12" /><verse number="13" style="v" sid="1CO 9:13" />Ndu̱ya̱álaꞌ máꞌ rí xa̱bo̱ tsí nu̱ñajun ná guꞌwá dxákuun, ikhín máꞌ napiꞌtsii̱, jamí tsí nu̱ñajun ná nakha-ráma tsi̱gi̱jña̱ꞌ, ikhaa máꞌ xuwi tsi̱gi̱jña̱ꞌ rúꞌkhue̱n naꞌphi̱i̱ mangii̱n. <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" />Xkuaꞌnii máꞌ nixná-ñájun Táta̱ ga̱jma̱á numúú tsí nuthan-raꞌa ajngáa máján mangaa, rí mbuye̱e̱ mbiꞌñúu̱ máꞌ ga̱jma̱á numuu ajngáa máján.<verse eid="1CO 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15" />Xómáꞌ ikhúúnꞌ, nimbá rí jaꞌyoꞌ tánda̱ꞌa̱ ná inalaꞌ, ni máꞌ tsítháánlo̱ꞌ ríge̱ꞌ kajngó mu̱xnu̱ꞌlaꞌ rí jaꞌyalaꞌ mu̱xnu̱ꞌlaꞌ. I̱wa̱á máꞌ máján xí ma̱ja̱ñúꞌ xó rí mbáa marígú-jáꞌyúꞌ rí nadxu a̱kui̱nꞌ e̱ne̱lo̱ꞌ numuu rí tsíru̱malo̱ꞌ. <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />Ído̱ na̱tha̱n-ráꞌalo̱ꞌ ajngáa máján, nda̱a̱ numuu rí ma̱ku̱xí-mina̱ꞌlo̱ꞌ, numuu rí wéje̱ inuꞌ rí ma̱ne̱lo̱ꞌ ñajun rúꞌkhue̱n. ¡Á tháán mingínúú xí tsítha̱n-ráꞌalo̱ꞌ ajngáa máján! <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />Ikhaa jngó, ra̱gúꞌthu̱u̱n rí ma̱da̱a̱ꞌ numuꞌ ga̱jma̱á numuu ñajun rí na̱ne̱lo̱ꞌ, numuu rí ra̱ꞌkhá ikhúúnꞌ ni̱ꞌgí-mina̱ꞌ rí ma̱ne̱ ne̱, rí ni̱ge̱ꞌe̱ inuꞌ rí ma̱ne̱lo̱ꞌ ne̱. <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />Dí lá gájanúꞌ rí na̱ne̱ ñajun ríge̱ꞌ xúꞌkhue̱n rá. Najanúꞌ rí gagi a̱kui̱nꞌ ga̱jma̱á numuu rí tsíru̱malo̱ꞌ nitháan ído̱ na̱tha̱n-ráꞌalo̱ꞌ ajngáa máján ga̱jma̱á numuu Krísto̱, ni máꞌ tsígruígúlo̱ꞌ nitháan rí jaꞌyoꞌ ma̱gruígúlo̱ꞌ ga̱jma̱á numuu ajngáa máján.<verse eid="1CO 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />Maske máꞌ nimbáa xa̱bo̱ tsíxná-ñájwinꞌ rí ma̱ne̱lo̱ꞌ rí nandoo, ikhúúnꞌ ne̱ne̱-mina̱ꞌlo̱ꞌ yumbáá drígu̱ún mbá xúgíin xa̱bo̱ kajngó ma̱goo ma̱mbáñúu̱ mbaꞌii̱n rí ma̱jáwíi̱n. <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />Ído̱ xtáá ga̱jma̱á nindxu̱ún xa̱bo̱ judío̱, na̱ne̱-mina̱ꞌ xómá xa̱bo̱ judío̱, kajngó ma̱mbáñúu̱ rí ma̱jáwíi̱n. Ído̱ xtáá ga̱jma̱á nindxu̱ún tsí nune̱-mbáníí xtángawoo Moisés, na̱ne̱-mbánuu xtángoo mangúúnꞌ kajngó ma̱mbáñúu̱ rí ma̱jáwíi̱n, maske máꞌ ra̱wéje̱ inuꞌ rí ma̱ne̱-mbánuulo̱ꞌ xtángoo. <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />Ído̱ xtáá ga̱jma̱á nindxu̱ún xa̱bo̱ tsí tsíꞌyóo máꞌ rí mune̱-mbáníí xtángoo, na̱ne̱-mina̱ꞌ asndo xómá rí tsíꞌyóo máꞌ rí ma̱ne̱-mbánuu xtángoo mangúúnꞌ kajngó ma̱mbáñúu̱ rí ma̱jáwíi̱n. I̱ndo̱ó máꞌ numuu rí na̱ne̱-mbánuu máꞌ rí xtángawoo Ana̱ꞌlóꞌ, numuu rí wéje̱ inuꞌ rí ma̱ne̱-mbánuu xtángawoo Krísto̱. <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />Ne̱ne̱-waba-mina̱ꞌ ná inúú tsí wabiin kajngó ma̱mbáñúu̱ rí ma̱jáwíi̱n. Mbá xúgíí ne̱ne̱-mina̱ꞌlo̱ꞌ ná inúú mbá xúgíin xa̱bo̱, kajngó ma̱mbáñúu̱ rí ma̱jáwíi̱n maske asndo mbá tikhuun. <verse eid="1CO 9:22" /><verse number="23" style="v" sid="1CO 9:23" />Mbá xúgíí ríge̱ꞌ na̱ne̱lo̱ꞌ ga̱jma̱á numuu ajngáa máján, kajngó ma̱gruígúu tháan mangúúnꞌ rí máján najma̱a̱ eꞌne ne̱.<verse eid="1CO 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 9:24" />Ndu̱ya̱álaꞌ máꞌ rí xa̱bo̱ tsí nune̱ gitsín rí nagáñúú xa̱bo̱, mbá xúgíi̱n nagáñúu̱ rí ma̱ꞌngúu̱n, i̱ndo̱ó máꞌ numuu rí mbáwíi tsí na̱ꞌngo̱o̱ na̱grui̱gú gamaku. Ikhaa jngó, u̱ga̱yálaꞌ rí ma̱ꞌnga̱ꞌlaꞌ kajngó mu̱drígúlaꞌ rí jaꞌyoo ma̱janálaꞌ. <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />Jámba̱a̱ xa̱bo̱ tsí naꞌtsín naꞌnii̱ gakhe̱ a̱kuii̱n inuu mbá xúgíí. Ikhii̱n nune̱-ngíná-mijnée̱ rí mu̱dríguíi̱ mbá rí tsígajyúu. Xómáꞌ ikháánꞌlóꞌ nu̱ꞌne̱-ngíná-mijnálóꞌ rí mu̱drígúlóꞌ mbá rí nagajyúu jámuu. <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />Ikhaa jngó, ikhúúnꞌ na̱ga̱yúꞌ xáꞌnii, ra̱ꞌkhá xómá xa̱bo̱ tsí tsíꞌyoo náá numuu igáyuu. Ikhúúnꞌ na̱xna̱-mína̱ꞌ xáꞌnii, tsíxi̱díí ski̱yu̱ꞌ ná inuu gíñá. <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />A̱ꞌkhue̱n gakon, na̱ne̱-ngínáa xuyuꞌ jamí na̱xu̱ꞌdáa ne̱ rí mañajun ne̱, ra̱ꞌkhá ma̱ꞌne rí jmínu̱úꞌ máꞌ ikhúúnꞌ, tsúún ni̱tha̱n-múꞌúún i̱ꞌwíin xa̱bo̱, ma̱xáꞌngo̱ꞌ gáꞌne.<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s">Xkri̱doo rí nigíꞌníí xa̱bo̱ Israél</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />A̱ngui̱nꞌ, nandoꞌ rí ma̱rmáꞌáan a̱kia̱nꞌlaꞌ rí mbá xúgíin táta̱-xi̱ꞌñáxo̱ꞌ wajyúú ningrigúu̱n ná agoo xka̱mixoo du̱u̱n, jamí mbá xúgíi̱n ninújngúu̱n ná awúun iya a̱pha̱. <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />Mbá xúgíi̱n waxúꞌdu-maꞌíi̱n ná awúun du̱u̱n jamí ná awúun iya a̱pha̱ kajngó magóo̱ tsu̱du̱u̱ Moisés. <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />Mbá xúgíi̱n niꞌphi̱i̱ mbóó ikhaa máꞌ ganitsu rí nixnúu̱ Ana̱ꞌlóꞌ, <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />jamí mbá xúgíi̱n niꞌwa̱a̱n mbóó ikhaa máꞌ iya rí nixnúu̱ Ana̱ꞌlóꞌ. Numuu rí niꞌwa̱a̱n iyoo pátsí rí na̱ꞌkha̱ ga̱jma̱á nindxúu̱n, jamí pátsí rúꞌkhue̱n ñajuun Krísto̱. <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />I̱ndo̱ó máꞌ numuu rí phú mbaꞌii̱n ikhii̱n táni̱gu̱u̱ꞌ Ana̱ꞌlóꞌ nini̱i̱, ikhaa jngó nijáñúu̱ jamí ninguanúu̱ xuñúu̱ ná mbaa niníí.<verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />Mbá xúgíí rúꞌkhue̱n niríga̱ kajngó ma̱ꞌne mbá xkri̱da mbu̱ꞌyáálóꞌ, kajngó ma̱xáni̱gua̱ꞌlóꞌ mu̱ꞌne̱lóꞌ rí ra̱máján, xómá rí ni̱ni̱gúu̱n muni̱i̱ ne̱ ikhii̱n. <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />Ni máꞌ ma̱xánindxa̱ꞌlóꞌ xa̱bo̱ tsí nune̱-mbi̱in tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún, xómá nini̱i̱ mbá tikhuu̱n. Numuu rí xáꞌnii ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ: «Nitrigi̱in xa̱bo̱ mu̱peꞌtso jamí nijngii̱n, wámba̱ rúꞌkhue̱n nini̱i̱ rí nandoo xuñúu̱».<note caller="+" style="f"><char style="fr" closed="false">10.7 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ xó nigájna̱á xa̱bo̱ 32.6. </char></note> <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />Ni máꞌ mu̱xúꞌbálóꞌ gajmiálóꞌ xa̱bo̱ tsí túꞌyáalóꞌ, xómá nini̱i̱ mbá tikhuu̱n. Ikhaa jngó, mbóó mbiꞌi nijáñúú mbá skíñú i̱tsu̱ míl (23 000) xa̱bo̱. <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />Ni máꞌ mu̱xúꞌjmaalóꞌ Táta̱ kajngó mbu̱ꞌyáálóꞌ xí mba̱a̱ a̱kuii̱n, xómá nene̱ mbá tikhuun tsí ikhii̱n, ikhaa jngó wanitsúu̱n nene̱ a̱bo̱ꞌ jamí nijáñúu̱. <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />Ni máꞌ mu̱xúꞌne̱-gajmálóꞌ, xómá nini̱i̱ mbá tikhuu̱n, ikhaa jngó nijáñúu̱ neꞌne ánje̱l tsí na̱gu̱díin xa̱bo̱.<verse eid="1CO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11" />Mbá xúgíí ríge̱ꞌ nigíꞌníí táta̱-xi̱ꞌñáxo̱ꞌ wajyúú kajngó ma̱ꞌne xkri̱da mbu̱ꞌyáálóꞌ, jamí waꞌtháán ne̱ ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ kajngó maxpríguálóꞌ ne̱, tsáanꞌ juwalóꞌ ná awúun mbiꞌi rí inu ma̱mbá numbaa. <verse eid="1CO 10:11" /><verse number="12" style="v" sid="1CO 10:12" />Ikhaa jngó, tsí na̱ju̱mu̱u̱ rí wéje̱-gúkúu, ga̱ꞌyoo̱ lá ra̱ꞌkhá ma̱xpátri̱ga̱a̱ mbayíí. <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />Tsirájá rí na̱ꞌkha̱ inalaꞌ, ikhaa máꞌ rúꞌkhue̱n na̱ꞌkha̱ inúú mbá xúgíin xa̱bo̱ numbaa. Xómáꞌ Ana̱ꞌlóꞌ phú jmbii, ikhaa jngó ma̱xániñuu̱ rí ma̱gu̱ma-rájáanꞌlaꞌ i̱tha̱án gakhe̱ xó rí ma̱ꞌnga̱ꞌlaꞌ ma̱wajún-ꞌthi̱ín. A̱ꞌkhue̱n gakon, ído̱ rí ma̱ꞌkha̱ tsirájá inalaꞌ, marmáꞌthoo̱ mbá xkrugua ná ma̱ga̱jnálaꞌ kajngó ma̱ꞌnga̱ꞌlaꞌ ma̱wajún-ꞌthi̱ín ne̱.<verse eid="1CO 10:13" /></para>
  <para style="s">Mu̱xúꞌne̱-mbi̱inlóꞌ tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún</para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />Ikhaa jngó, a̱ngui̱nꞌ, tsáanꞌ phú nandoꞌ ja̱ya̱ꞌlaꞌ, mu̱xúne̱-mbi̱inlaꞌ tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún. <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />Xúꞌkhue̱n i̱tha̱nꞌlaꞌ numuu rí xa̱bo̱ tsí nafruꞌu̱ún ñajwanlaꞌ. Gu̱ra̱jwa̱ꞌlaꞌ máꞌ ikháanꞌlaꞌ rí na̱tha̱nꞌlaꞌ. <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" />Ído̱ nawanlóꞌ iyoo rgúxi̱ jamí nu̱rígu̱ulóꞌ gamaku inuu Ana̱ꞌlóꞌ, mbá xúgiáanꞌlóꞌ mbéꞌtháán nduꞌya-makuíílóꞌ iꞌdiuu Krísto̱. Xúꞌkhue̱n máꞌ ído̱ nu̱xpíꞌtháalóꞌ guma, mbá xúgiáanꞌlóꞌ mbéꞌtháán nduꞌya-makuíílóꞌ xuyuu Krísto̱. <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />Mbóó máꞌ guma rí napholóꞌ mbá xúgiáanꞌlóꞌ, ikhaa jngó mbáwíi máꞌ xa̱bo̱ ñajwanlóꞌ mbá xúgiáanꞌlóꞌ, maske máꞌ phú mbaꞌáanꞌlóꞌ.<verse eid="1CO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18" />Gu̱ya̱xi̱ílaꞌ xómá ene̱ xa̱bo̱ Israél: tsí naꞌpho̱ xuwi tsi̱gi̱jña̱ꞌ, jambáxúu̱n naꞌphi̱i̱ xuwi tsi̱gi̱jña̱ꞌ rí nakha-ráma. <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />Dí lá iyoꞌ gátha̱nꞌlaꞌ ga̱jma̱á numuu xkri̱da ríge̱ꞌ rá. Tsítha̱n rí gíꞌdoo numúú tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún, ni máꞌ rí gíꞌdoo numuu xuwi rí kixnáxe̱ ná inúu̱. <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />Na̱tha̱nꞌlaꞌ rí ído̱ nu̱xna̱xí tsi̱gi̱jña̱ꞌ xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, ná inúú gíñá ꞌguéen nu̱xna̱xíi̱ ne̱, ra̱ꞌkhá ná inuu Ana̱ꞌlóꞌ. Ikhaa jngó, tsíyoꞌ rí mu̱peꞌtsolaꞌ gajmiálaꞌ gíñá ꞌguéen mangáanꞌlaꞌ. <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />Ma̱xáxóo mu̱wanlaꞌ iya ga̱jma̱á numuu Táta̱, jamí mu̱wanlaꞌ iya ga̱jma̱á numúú gíñá ꞌguéen mangaa. Xúꞌkhue̱n máꞌ ma̱xáxóo rí ma̱trigáanꞌlaꞌ mu̱peꞌtsolaꞌ gajmiálaꞌ Táta̱, jamí ma̱trigáanꞌlaꞌ mu̱peꞌtsolaꞌ gajmiálaꞌ gíñá ꞌguéen mangiin. <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />Á nandalóꞌ rí ma̱jiꞌnáa Táta̱ dxe̱ꞌ. Á i̱wa̱á mba̱a̱ ski̱ya̱ꞌlóꞌ ikháánꞌlóꞌ xó rí ikhaa̱ dxe̱ꞌ.<verse eid="1CO 10:22" /></para>
  <para style="s">Gu̱ꞌne̱-mba̱a̱lóꞌ Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ mbá xúgíí rí nu̱ꞌne̱lóꞌ</para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />Mbá tikhuun tsí ikháanꞌlaꞌ nuthan: «Mbá xúgíí rí nandoꞌ, ma̱goo ma̱ne̱lo̱ꞌ», i̱ndo̱ó máꞌ numuu rí ra̱ꞌkhá mbá xúgíí nafriya̱ꞌ. «Mbá xúgíí rí nandoꞌ, ma̱goo ma̱ne̱lo̱ꞌ», i̱ndo̱ó máꞌ numuu rí ra̱ꞌkhá mbá xúgíí nambáyálóꞌ. <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />Nimbáa ma̱xáꞌne i̱ndo̱ó máꞌ rí ma̱xtáa mújúun ikhaa, rí gandxaꞌwá-mine̱e̱ꞌ ga̱jma̱á numúú i̱ꞌwíin mangaa.<verse eid="1CO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25" />Apholaꞌ mbá xúgíí inii xuwi rí nitangu̱jo̱o̱ ná xuáá, jamí mu̱xúra̱xe̱laꞌ nimbá, ra̱ꞌkhá mu̱ndxa̱ꞌwa̱-mijnálaꞌ rí ra̱máján e̱ne̱laꞌ rí napholaꞌ ne̱. <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />Numuu rí «drígo̱o̱ Táta̱ ñajuun mbá xúgíí ju̱ba̱ꞌ jamí mbá xúgíí rí ríga̱ ná inuu ne̱».<verse eid="1CO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27" />Xí mbáa xa̱bo̱ tsí tsíꞌne-nuwiin Ana̱ꞌlóꞌ nandxaꞌwálaꞌ mu̱peꞌtsolaꞌ, jamí ikháanꞌlaꞌ nandalaꞌ gúꞌgualaꞌ, apholaꞌ mbá xúgíí rí nastrámee̱ inalaꞌ, ni mu̱xúra̱xe̱-mijnálaꞌ xí ma̱goo o ma̱xáxóo mu̱pholaꞌ ne̱. <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />I̱ndo̱ó máꞌ xí mbáa gáꞌthánlaꞌ: «Xuwi ríge̱ꞌ waxnáxe̱ inúú tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún», ma̱xúpholaꞌ ne̱ xúꞌkhue̱n rá. Ga̱jma̱á numuu tsí niꞌthánlaꞌ ríge̱ꞌ, jamí rí ma̱xáꞌne a̱jma̱ a̱kui̱in tsúꞌkhue̱n, ma̱xúpholaꞌ ne̱. <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />Tsítha̱nlo̱ꞌ rí ikháanꞌlaꞌ ma̱xáꞌne a̱jma̱ a̱kia̱nꞌlaꞌ, rí i̱mba̱a̱ꞌ ma̱xáꞌne a̱jma̱ a̱kui̱in.</para>
  <para style="p" vid="1CO 10:29">Ra̱máján ma̱ne̱lo̱ꞌ mbá rí nandoo máꞌ ma̱ne̱ xí ra̱máján iꞌyoo i̱mba̱a̱ꞌ rí ma̱ne̱ rúꞌkhue̱n. <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />Xí gakon rí ikhúúnꞌ na̱rígu̱u gamaku inuu Ana̱ꞌlóꞌ ga̱jma̱á numuu rí nakholo̱ꞌ, nda̱a̱ numuu rí i̱mba̱a̱ꞌ maꞌthán rí ra̱máján e̱ne̱lo̱ꞌ ga̱jma̱á numuu rí nakholo̱ꞌ.<verse eid="1CO 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31" />Ikhaa jngó, xí napeꞌtsolaꞌ, o xí nawanlaꞌ iya, o asndo náá máꞌ rí e̱ne̱laꞌ mbo̱ꞌ, gu̱ne̱laꞌ rí ma̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ ga̱jma̱á numuu mbá xúgíí rí nu̱ne̱laꞌ. <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />Mu̱xúne̱laꞌ rí ma̱ꞌne a̱jma̱ a̱kui̱in nimbáa xa̱bo̱, ni máꞌ xa̱bo̱ judío̱, ni máꞌ xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, ni máꞌ tsí nanimbu̱únꞌ juyáá Ana̱ꞌlóꞌ. <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />Gu̱ne̱laꞌ xómá e̱ne̱ ikhúúnꞌ, na̱ne̱ rí ma̱ni̱gu̱únꞌ mbá xúgíin xa̱bo̱ juyeꞌ. Tsíꞌyálo̱ꞌ i̱ndo̱ó máꞌ rí ndaꞌyóꞌ ikhúúnꞌ, rí nda̱ꞌyá rí mambáñúú tsí i̱ꞌwíin mangiin, kajngó ma̱jáwíi̱n.<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1" />Gu̱ya̱ri̱dáálaꞌ rí na̱ne̱ ikhúúnꞌ, xómá rí ikhúúnꞌ nda̱ya̱ri̱doꞌ rí naꞌne Krísto̱.<verse eid="1CO 11:1" /></para>
  <para style="s">Xáne jaꞌyoo rí mune̱ go̱ꞌo̱ ído̱ rí nuthán-jáñíí Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />A̱ngui̱nꞌ, maphú nadxu a̱kui̱nꞌ e̱ne̱laꞌ, numuu rí tsímbumalaꞌ ju̱yo̱ꞌ, jamí gíwa̱a̱n a̱kia̱nꞌlaꞌ mbá xúgíí xómá rí ni̱sngálaꞌ.<verse eid="1CO 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 11:3" />Xómáꞌ xúge̱ꞌ nandoꞌ rí mbu̱ya̱álaꞌ rí Krísto̱ ñajuun idxu̱u̱ jámba̱a̱ xa̱biya̱, xómáꞌ xa̱biya̱ ñajuu̱n idxu̱u̱ a̱ꞌguii̱, jamí Ana̱ꞌlóꞌ ñajuun idxu̱u̱ Krísto̱. <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />Xí mbáa xa̱biya̱ narugoo idxu̱u̱ ído̱ rí naꞌthán-jáñuu Ana̱ꞌlóꞌ o ído̱ na̱gu̱wíjnga̱a ajngóo Ana̱ꞌlóꞌ mbo̱ꞌ, tsíya-makuu̱ tsí ñajuun idxu̱u̱. <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />Jamí xí mbáa a̱ꞌgo̱ tsírugoo idxu̱u̱ ído̱ rí naꞌthán-jáñuu Ana̱ꞌlóꞌ o ído̱ na̱gu̱wíjnga̱a ajngóo Ana̱ꞌlóꞌ mbo̱ꞌ, tsíya-makuu̱ tsí ñajuun idxu̱u̱. Numuu rí ikhaa máꞌ jaꞌnii xí maꞌde̱e̱ ráꞌtsa̱ꞌ idxu̱u̱. <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />Ikhaa jngó, xí tsírugoo idxu̱u̱ a̱ꞌgo̱, ga̱ru̱thii̱n tsu̱u̱n idxu̱u̱ mangaa. Jamí xí mate̱ꞌ iꞌyoo a̱ꞌgo̱ rí ma̱ro̱thon tsu̱u̱n idxu̱u̱ o maꞌde̱e̱ ráꞌtsa̱ꞌ idxu̱u̱ rá, garugoo̱ idxu̱u̱ xúꞌkhue̱n rá. <verse eid="1CO 11:6" /><verse number="7" style="v" sid="1CO 11:7" />Tsí xa̱biya̱ ra̱gíꞌmaa marugoo̱ idxu̱u̱, numuu rí ikhaa̱ jaꞌnii̱ xómá jaꞌnii Ana̱ꞌlóꞌ jamí nasngájmee̱ rí mba̱a̱ Ana̱ꞌlóꞌ. Xómáꞌ a̱ꞌgo̱ nasngájmee̱ rí mba̱a̱ xa̱biya̱. <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />Numuu rí ra̱ꞌkhá xa̱biya̱ ni̱gu̱ma-ku̱maa ga̱jma̱á majñu̱u̱ a̱ꞌgo̱, rí a̱ꞌgo̱ ni̱gu̱ma-ku̱maa ga̱jma̱á majñu̱u̱ xa̱biya̱. <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />Ni máꞌ ra̱ꞌkhá xa̱biya̱ ni̱gu̱ma-ku̱maa ga̱jma̱á numuu a̱ꞌgo̱, rí a̱ꞌgo̱ ni̱gu̱ma-ku̱maa ga̱jma̱á numuu xa̱biya̱. <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />Ikhaa numuu rúꞌkhue̱n, jamí ga̱jma̱á numúú ánje̱l, gíꞌmaa rí marugoo idxu̱u̱ a̱ꞌgo̱ kajngó ma̱kujma rí ndaya-makuu̱ tsí ñajuun idxu̱u̱.<verse eid="1CO 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 11:11" />Xómáꞌ ikháánꞌlóꞌ ná inuu Táta̱, ni máꞌ xa̱biya̱ ma̱xáxtáa xí ra̱ꞌkhá ga̱jma̱á numuu a̱ꞌgo̱, ni máꞌ a̱ꞌgo̱ ma̱xáxtáa xí ra̱ꞌkhá ga̱jma̱á numuu xa̱biya̱. <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />Xómá rí a̱ꞌgo̱ ni̱gu̱ma-ku̱maa ga̱jma̱á majñu̱u̱ xa̱biya̱, xkuaꞌnii máꞌ xa̱biya̱ mangaa na̱gu̱maa̱ eꞌne a̱ꞌgo̱, jamí mbá xúgíí ni̱gu̱ma-ku̱maa neꞌne Ana̱ꞌlóꞌ. <verse eid="1CO 11:12" /><verse number="13" style="v" sid="1CO 11:13" />Gu̱ra̱jwa̱ꞌ máꞌ ikháanꞌlaꞌ xí máján rí ma̱xárugoo idxu̱u̱ a̱ꞌgo̱ ído̱ rí naꞌthán-jáñuu Ana̱ꞌlóꞌ. <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />Nakujma nguáná máꞌ rí kriꞌkhuáanꞌlóꞌ, rúꞌkhue̱n isngájma rí mate̱ꞌ xí ma̱xáꞌda̱ idxu̱u̱ xa̱biya̱. <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />Jamí xí a̱ꞌgo̱ naniñuu rí mba̱ꞌya tsu̱u̱n idxu̱u̱, naꞌne tsiꞌyáa̱ eꞌne ne̱. Ikhaa numuu rúꞌkhue̱n nijanáa̱ rí marugoo̱ ga̱jma̱á idxu̱u̱. <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />I̱ndo̱ó máꞌ xí mbáa tsí gíꞌdoo i̱mba̱ ju̱ma̱ nandoo gáꞌthán xóó ga̱jma̱á numuu ríge̱ꞌ rá mbo̱ꞌ, ga̱ꞌyoo̱ rí ni máꞌ ikháanꞌxo̱ꞌ, ni máꞌ mbámbá kuthuun tsí nanimbu̱únꞌ juyáá Ana̱ꞌlóꞌ, na̱nguá guáꞌdááxo̱ꞌ i̱mba̱ nakhúu rí nu̱ne̱ jayaxo̱ꞌ.<verse eid="1CO 11:16" /></para>
  <para style="s">Xáne jaꞌyoo rí ma̱gu̱ma-ri̱ya̱aꞌ rí nikueꞌtso-añuu Jesús</para>
  <para style="r">(<ref loc="MAT 26:26-29">Mt 26.26-29</ref>; <ref loc="MRK 14:22-25">Mc 14.22-25</ref>; <ref loc="LUK 22:14-20">Lc 22.14-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />Xúge̱ꞌ ma̱tha̱nꞌlaꞌ mbá rí nu̱ne̱laꞌ rí naꞌne rí ma̱xáꞌdxu a̱kui̱nꞌ gúne̱laꞌ. Numuu ído̱ rí na̱gi̱mbáanꞌlaꞌ ra̱ꞌkhá rí nambáyálaꞌ ñajuun ne̱, rí mbá rí naꞌne-ñawánlaꞌ ñajuun ne̱. <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />Rí phú ginii jayu, na̱dxawuunlo̱ꞌ rí ído̱ na̱gi̱mbáanꞌlaꞌ tsáanꞌ nanimba̱ꞌlaꞌ ju̱ya̱á Jesús, nu̱xpíꞌthá-mijnálaꞌ, jamí tháan máꞌ nanimbo̱ꞌ rí xkuaꞌnii e̱ne̱laꞌ. <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />Numuu ndaꞌyóo máꞌ gakon rí mu̱xpíꞌthá-mijnálaꞌ, kajngó ma̱kujmii tsí gakon rí xa̱bi̱i Ana̱ꞌlóꞌ ñajúún. <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />Ikhaa jngó, ído̱ rí na̱gi̱mbáanꞌlaꞌ, ra̱ꞌkhá na̱gi̱mbáanꞌlaꞌ rí mu̱ne̱-ri̱ya̱aꞌlaꞌ rí nikueꞌtso-añuu Táta̱. <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />Numuu ído̱ rí napeꞌtsolaꞌ, mbámbáa nacha̱ máꞌ naꞌkho̱-añuu rí jayá ni̱ꞌkha̱ jamí tsíxnée̱ ne̱ mu̱pho̱ i̱ꞌwíin. A̱ꞌkhue̱n rí mbá tikhuun na̱xki̱dxu̱ún, jamí i̱ꞌwíin najngi̱in eꞌne. <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />Á nda̱a̱ guꞌwálaꞌ ná mu̱peꞌtsolaꞌ jamí mu̱wanlaꞌ iya rá dxe̱ꞌ. Náá numuu kajngó tsíya̱-makúúnlaꞌ tsí nanimbu̱únꞌ juyáá Ana̱ꞌlóꞌ jamí nu̱ne̱-mati̱inꞌlaꞌ tsí nda̱a̱ nitháan rí guáꞌdáá róꞌ. Dí iyalaꞌ rí ma̱tha̱nꞌlaꞌ róꞌ. Á na̱ju̱ma̱ꞌlaꞌ rí phú nadxu a̱kui̱nꞌ e̱ne̱laꞌ dxe̱ꞌ. Tsídxu mbá jayu a̱kui̱nꞌ e̱ne̱laꞌ.<verse eid="1CO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23" />Numuu rí ikhúúnꞌ ni̱sngálaꞌ ikhaa máꞌ rí niꞌsngéꞌlo̱ꞌ Táta̱: Rí mbroꞌon rí waxnáxi̱i̱ Táta̱ Jesús, niwatuu̱n mbá guma bopho. <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />Ído̱ wámbo̱o̱ niríguu̱ la gamaku inuu Ana̱ꞌlóꞌ, a̱ꞌkhue̱n nixpíꞌthángaa̱ ne̱, jamí niꞌthée̱n: «Gu̱drígúlaꞌ jamí apholaꞌ.<note caller="+" style="f"><char style="fr" closed="false">11.24 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «Gu̱drígúlaꞌ jamí apholaꞌ».</char></note> Guma ríge̱ꞌ ñajuun xuyuꞌ rí kixnáxe̱ ga̱jma̱á numalaꞌ. Gu̱ne̱-ri̱ya̱aꞌlaꞌ ríge̱ꞌ kajngó ma̱rmáꞌáan a̱kia̱nꞌlaꞌ ju̱yo̱ꞌ». <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />Xúꞌkhue̱n máꞌ mangaa, ído̱ wámbo̱o̱ nikueꞌtso-añuu̱, a̱ꞌkhue̱n niwatuu̱n rgúxi̱ rí gajno̱ꞌ iyoo úba̱ rí ni̱ga̱yu̱u̱ꞌ, jamí niꞌthée̱n: «Ikhaa iyoo úba̱ rí ni̱ga̱yu̱u̱ꞌ ríge̱ꞌ ñajuun awan nuxe̱ꞌ rí na̱gu̱ma ga̱jma̱á iꞌdiuꞌ. Gu̱ne̱-ri̱ya̱aꞌlaꞌ ríge̱ꞌ, jamí mbámbá rí nawanlaꞌ iyoo úba̱ rí ni̱ga̱yu̱u̱ꞌ, ga̱rmáꞌáan a̱kia̱nꞌlaꞌ ju̱yo̱ꞌ». <verse eid="1CO 11:25" /><verse number="26" style="v" sid="1CO 11:26" />Ikhaa jngó, jámba̱ miꞌtsú rí napholaꞌ guma ríge̱ꞌ, jamí nawanlaꞌ iyoo rgúxi̱ ríge̱ꞌ, nu̱tha̱nlaꞌ rí nijáñuu Táta̱ ga̱jma̱á numalaꞌ, asndo mbiꞌi rí ikhaa̱ ma̱ꞌkhaa̱.<verse eid="1CO 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 11:27" />Ikhaa numuu rúꞌkhue̱n, asndo tsáa máꞌ tsí naꞌkho̱ guma o naꞌña̱a̱ ná rgúxi̱i Táta̱, jamí tsíꞌnii̱ ga̱jma̱á gamaku, naxuda-mine̱e̱ꞌ aꞌkhán ga̱jma̱á numuu xuyuu jamí iꞌdiuu Táta̱. <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />Ikhaa jngó, wapha gáyaxe̱-mina̱ꞌ mbámbáa kajngó mba̱ꞌyoo xí máján o ra̱máján eꞌne. A̱ꞌkhue̱n rí ma̱goo mi̱khui̱i̱ guma, jamí ma̱goo ma̱ga̱a̱n iyoo rgúxi̱. <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />Tsí naꞌkho̱ guma jamí naꞌña̱a̱ iyoo rgúxi̱, jamí tsífroꞌo̱o̱ rí xa̱bo̱ tsí nawi̱in ñajúún xuyuu Táta̱, ikhaa̱ máꞌ iꞌyée̱ rí mbayée̱ xkuíya̱ gáꞌne Ana̱ꞌlóꞌ. <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />Ikhaa numuu rúꞌkhue̱n júwa̱ꞌ mbaꞌiin tsí najáñúú jamí wabiin ga̱jma̱á nindxa̱ꞌlaꞌ, jamí mbaꞌiin tsí nijáñúú máꞌ. <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />Xí numuu rí nu̱ya̱xe̱-mijnálóꞌ máꞌ ikháánꞌlóꞌ, ndawa̱a̱ tsí gára̱jwa̱ꞌ numalóꞌ xúꞌkhue̱n rá. <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />Xómáꞌ Táta̱ ído̱ rí na̱ra̱jwe̱e̱ꞌ numalóꞌ, naxpríguálóꞌ kajngó ma̱ma̱ñalóꞌ jamí mu̱xúmíni̱ílóꞌ gajmiálóꞌ xa̱bo̱ tsí júwa̱ꞌ ná numbaa.<verse eid="1CO 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33" />Ikhaa jngó a̱ngui̱nꞌ, ído̱ rí na̱gi̱mbáanꞌlaꞌ rí mu̱peꞌtsolaꞌ, gawaꞌthu̱únlaꞌ tsí i̱ꞌwíin. <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />Xí mbáa ndaꞌyoo rí na̱xki̱dxu̱u̱, ga̱kuiꞌtsii̱ ná guꞌwóo̱, kajngó ma̱xáꞌne rí ma̱gi̱mbáanꞌlaꞌ rí mbu̱ya̱laꞌ xkuíya̱ gáꞌne Ana̱ꞌlóꞌ.</para>
  <para style="p" vid="1CO 11:34">Ído̱ ma̱ꞌgá gáya̱ꞌlaꞌ, a̱ꞌkhue̱n ma̱ne̱-mbánuu i̱ꞌwá rí ndaꞌyóo.<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s">Ñajun rí nijanáá ma̱ꞌne mbámbáa neꞌne Xu̱u̱ꞌ Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />A̱ngui̱nꞌ, nandoꞌ rí ma̱ma̱ñalaꞌ ga̱jma̱á numuu ñajun rí naxnálóꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ. <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />Ndu̱ya̱álaꞌ máꞌ rí nákhí xóó na̱nguá wéje̱ a̱kia̱nꞌlaꞌ ná inuu Jesús, ni̱ni̱ꞌñá-mijnálaꞌ rí ma̱ꞌga jiꞌdáanꞌlaꞌ ná tsu̱du̱ún tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún, tsí na̱nguá ithan. <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />Ikhaa jngó, na̱tha̱nꞌlaꞌ rí asndo nimbáa tsí naꞌthán ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ, ma̱xáxóo maxná-máꞌáa̱n Jesús. Jamí asndo nimbáa ma̱xáxóo maꞌthán «Jesús ñajuun Táta̱» xí ra̱ꞌkhá ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ.<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />Ríga̱ mbaꞌa inii ñajun rí ma̱goo mu̱ꞌne̱lóꞌ kajngó mu̱ꞌne̱-mba̱a̱lóꞌ Ana̱ꞌlóꞌ, i̱ndo̱ó máꞌ numuu rí Xu̱u̱ꞌ Ana̱ꞌlóꞌ tsí naxná ne̱, ikhaa̱ máꞌ ñajuu̱n. <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />Xúꞌkhue̱n máꞌ ríga̱ mbaꞌa inii ñajuun Táta̱ rí ma̱goo mu̱ꞌne̱lóꞌ, i̱ndo̱ó máꞌ numuu rí Táta̱, ikhaa̱ máꞌ ñajuu̱n. <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />Jamí ríga̱ mbaꞌa inii ñajun rí ma̱goo mu̱ꞌne̱lóꞌ, i̱ndo̱ó máꞌ numuu rí Ana̱ꞌlóꞌ tsí naꞌne mbá xúgíí ná majña̱ꞌlóꞌ mbá xúgiáanꞌlóꞌ, ikhaa̱ máꞌ ñajuu̱n.<verse eid="1CO 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 12:7" />Xu̱u̱ꞌ Ana̱ꞌlóꞌ nasngájmuu mbámbáa rí ma̱ꞌne, kajngó mambáñúu̱ tsí i̱ꞌwíin. <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />Mbá tikhuun najanúú rí ma̱ma̱ñúú mu̱ndxákuun eꞌne Xu̱u̱ꞌ Ana̱ꞌlóꞌ. I̱ꞌwíin najanúú muthan rí nafruꞌu̱ún eꞌne ikhaa máꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ. <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />I̱ꞌwíin najanúú rí ma̱we̱je̱ guéño a̱kui̱ín ná inuu Ana̱ꞌlóꞌ eꞌne ikhaa máꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ. I̱ꞌwíin najanúú rí mune̱-thanúú xa̱bo̱ eꞌne ikhaa máꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ. <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />I̱ꞌwíin najanúú rí mune̱ ma̱kujma rí phú wáá. I̱ꞌwíin najanúú rí mu̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ. I̱ꞌwíin najanúú rí mbuyáá xí gakon rí ajngóo Ana̱ꞌlóꞌ naꞌthán i̱mba̱a̱ꞌ. I̱ꞌwíin najanúú rí muthan ajngáa rí tsígu̱ma-nuwiin. I̱ꞌwíin najanúú rí muthan-wíi ajngáa rí tsígu̱ma-nuwiin. <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />Mbá xúgíí ríge̱ꞌ naꞌne mbáwíi ikhaa máꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ, jamí ikhaa̱ naxnúu̱ mbámbáa rí ma̱ꞌne, xómá naꞌne a̱kuii̱n ikhaa̱.<verse eid="1CO 12:11" /></para>
  <para style="s">Tsí nanimbu̱únꞌ juyáá Jesús jaꞌñúú xómá xuyuu mbáwíi xa̱bo̱</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />Tsí xa̱bo̱ numbaa, maphú mbaꞌa dxájuu xuyuu̱, jamí mbá xúgíí rúꞌkhue̱n kuatun-mina̱ꞌ rí naꞌne mbáwíi xa̱bo̱ ñajuu̱n. Xkuaꞌnii máꞌ jaꞌnii xuyuu Krísto̱ mangaa. <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />Mbá xúgiáanꞌlóꞌ ni̱dríguíilóꞌ ikhaa máꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ, kajngó ma̱nindxa̱ꞌlóꞌ mbáwíi xa̱bo̱. Ga̱nindxa̱ꞌlóꞌ xa̱bo̱ judío̱ o ra̱ꞌkháa xa̱bo̱ judío̱ mbo̱ꞌ, ga̱nindxa̱ꞌlóꞌ yumbáá waꞌtsi̱in o xa̱bo̱ tsí nuthan-ñajun-mijná máꞌ ikhiin mbo̱ꞌ. Mbá xúgiáanꞌlóꞌ nijanálóꞌ mbáwíi ikhaa máꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ.<verse eid="1CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14" />Rí mbáa xa̱bo̱, ra̱ꞌkhá mbóó rí ñajuun mbá xúgíí xuyuu̱, rí mbaꞌa dxájuu ne̱ kuatun-mina̱ꞌ. <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />Á gáꞌne xí nakhú maꞌthán: «Numuu rí ra̱ꞌkhá ñawún ñajunꞌ, ra̱ꞌkháa xuyuu xa̱bo̱ ñajunꞌ». Á rúꞌkhue̱n iꞌthán rí ra̱ꞌkhá xuyuu xa̱bo̱ ñajuun ne̱ rá dxe̱ꞌ. <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />Á gáꞌne xí ñaꞌwun maꞌthán: «Numuu rí ra̱ꞌkhá idu ñajunꞌ, ra̱ꞌkháa dxájuu xuyuu xa̱bo̱ ñajunꞌ». Á rúꞌkhue̱n iꞌthán rí ra̱ꞌkhá xuyuu xa̱bo̱ ñajuun ne̱ rá dxe̱ꞌ. <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />Xí mbá xúgíi xa̱bo̱ ñajuun idu, ma̱xáxóo madxawuu̱n. Xí mbá xúgíi xa̱bo̱ ñajuun ñaꞌwun, ma̱xáxóo manijñuu̱. <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />Xómáꞌ Ana̱ꞌlóꞌ nigíꞌma mbámbá dxájuu xuyuu xa̱bo̱ ná neꞌne a̱kuii̱n ikhaa̱. <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />Xí mbóó rí ñajuun mbá xúgíi xa̱bo̱, nda̱a̱ máꞌ dxájuu xuyuu xa̱bo̱ rí kuatun-mina̱ꞌ xúꞌkhue̱n rá. <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />Ikhaa jngó, phú mbaꞌa dxájuu xuyuu xa̱bo̱ nawa̱a̱ rí naꞌne mbáa xa̱bo̱ ñajuu̱n.<verse eid="1CO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21" />Rí idu ra̱jáꞌyoo maꞌthúun ñawún: «Tsíꞌyóꞌ máꞌ rí ma̱ta̱mbáyúꞌ». Ni máꞌ ede̱ ra̱jáꞌyoo maꞌthúun nakhú: «Tsíꞌyóꞌ máꞌ rí mu̱mbáyúꞌlaꞌ». <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />A̱ꞌkhue̱n gakon, ikhaa dxájuu xuyuu xa̱bo̱ rí phú nda̱a̱ ski̱yu̱u̱ꞌ jaꞌnii, ikhaa ne̱ phú i̱tha̱án ndaꞌyóo. <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />Jamí ikhaa dxájuu xuyuu xa̱bo̱ rí nda̱a̱ guéño máꞌ numuu jaꞌnii, ikhaa ne̱ phú i̱tha̱án máján i̱ña̱wa̱ánlóꞌ. Ikhaa rí ra̱jáꞌyoo ma̱kujma jaꞌnii, ikhaa ne̱ phú i̱tha̱án gíꞌdoo numuu e̱ꞌne̱lóꞌ. <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />Numuu rí tsíꞌyóo máꞌ mu̱ña̱wa̱án guéñalóꞌ dxájuu xuyalóꞌ rí mitsaan máꞌ ikujma. Xkuaꞌnii neꞌne-mújúun Ana̱ꞌlóꞌ xuyalóꞌ, niꞌnii̱ rí i̱tha̱án ma̱xná-gamiéjwanlóꞌ gáꞌne rí nda̱a̱ guéño máꞌ numuu jaꞌnii. <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />A̱ꞌkhue̱n rí ma̱xáxpíꞌthá-mina̱ꞌ xuyuu xa̱bo̱, rí mbá xúgíí dxájuu xuyuu̱ ma̱gi̱ꞌdoo tsiakhe̱ rí mambáyú-mina̱ꞌ. <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />Ikhaa jngó, xí mbá dxájuu xuyuu xa̱bo̱ naꞌkho̱, mbá xúgíi xa̱bo̱ namínu̱u̱ꞌ. Jamí xí mbá dxájuu xuyuu xa̱bo̱ nitiamakuíí, mbá xúgíi xa̱bo̱ nadxu a̱kui̱in.<verse eid="1CO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27" />Ikhaa jngó, mbá xúgiáanꞌlaꞌ ñajwanlaꞌ mbá xa̱bi̱i̱ xuyuu Krísto̱, jamí mbámbáa tsí ikháanꞌlaꞌ ñajuun mbáa dxájuu xuyuu̱. <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" />Tsíge̱ꞌ ñajúún tsí niꞌgíin Ana̱ꞌlóꞌ ná majñu̱ú tsí nanimbu̱únꞌ juyáá Jesús: Ginii jayu júwa̱ꞌ tsí waxúngui̱inꞌ, rí riajmu̱u̱ tsí nu̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ, rí riatsú tsí nusngáá, nda̱wa̱á tsí nune̱ rí phú wáá, nda̱wa̱á tsí nune̱-thanúú xa̱bo̱, tsí nu̱mbáyíí, tsí nduya̱ ikhoo ñajun, jamí tsí nuthan ajngáa rí tsígu̱ma-nuwiin. <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />Ra̱ꞌkhá xúgíin ñajúún tsí waxúngui̱inꞌ, ni máꞌ ra̱ꞌkhá xúgíin ñajúún tsí nu̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ, ni máꞌ ra̱ꞌkhá xúgíin ñajúún tsí nusngáá, ni máꞌ ra̱ꞌkhá xúgíin ene̱ rí phú wáá. <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />Ni máꞌ ra̱ꞌkhá xúgíin guáꞌdáá ñajun rí mune̱-thanúú xa̱bo̱, ni máꞌ ra̱ꞌkhá xúgíin nuthan ajngáa rí tsígu̱ma-nuwiin, ni máꞌ ra̱ꞌkhá xúgíin nuthan-ri̱ya̱aꞌ ajngáa rí tsígu̱ma-nuwiin. <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />Ikhaa jngó, gu̱xna̱-míjnálaꞌ tsiakhe̱ rí ma̱janálaꞌ ñajun rí phú i̱tha̱án gíꞌdoo numuu.</para>
  <para style="s" vid="1CO 12:31">Tsí nandoo jaꞌñúú xa̱bo̱</para>
  <para style="p" vid="1CO 12:31">Xómáꞌ ikhúúnꞌ ma̱snga̱jmálaꞌ rí phú i̱tha̱án gíꞌdoo numuu.<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />Xí na̱ma̱ñuꞌ na̱tha̱n mbaꞌa inii ajngúún xa̱bo̱ numbaa o ajngúún ánje̱l mbo̱ꞌ, jamí tsíyoꞌ ja̱ñu̱ú xa̱bo̱, ma̱nindxu̱ꞌ xómá ajwa̱nꞌ rí naꞌne wee jayu o xómá ajwa̱nꞌ jndi rí nawán ído̱ nudi̱í xa̱bo̱ mbo̱ꞌ. <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" />Xí na̱ma̱ñuꞌ na̱gúwíjnga̱a ajngóo Ana̱ꞌlóꞌ, xí na̱ne̱-núwíin mbá xúgíí awan drígo̱o̱ Ana̱ꞌlóꞌ rí i̱ndo̱ó máꞌ ikhaa̱ ni̱gi̱da̱ꞌ idxu̱u̱ nákhí wajyúú, jamí na̱ma̱ñuꞌ mbá xúgíí rí ríga̱ ná tsu̱du̱u̱ numbaa, xúꞌkhue̱n máꞌ xí phú wéje̱ a̱kui̱nꞌ ná inuu Ana̱ꞌlóꞌ rí asndo ma̱goo ma̱ne̱-maꞌba̱a̱n mbá júba̱, jamí tsíyoꞌ ja̱ñu̱ú xa̱bo̱, nda̱a̱ nitháan numuꞌ xúꞌkhue̱n rá. <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />Maske máꞌ ma̱xnu̱ú mbá xúgíí rí gúꞌdo̱ꞌ tsí ngíníi, o ma̱xna̱xí-mina̱ꞌ rí mi̱khúún mbo̱ꞌ, jamí tsíyoꞌ ja̱ñu̱ú xa̱bo̱, nda̱a̱ nitháan rí gíꞌdoo numuꞌ xúꞌkhue̱n rá.<verse eid="1CO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4" />Tsí nandoo jaꞌñúú xa̱bo̱ phú mba̱a̱ a̱kuii̱n, jamí phú májáan a̱kuii̱n. Tsí nandoo jaꞌñúú xa̱bo̱, tsíxígu̱u̱ꞌ, tsíꞌne-tsiꞌyée̱ ni máꞌ tsíkúxe̱-mine̱e̱ꞌ. <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />Tsí nandoo jaꞌñúú xa̱bo̱, tsíꞌnii̱ nimbá rí nda̱a̱ gamakuu, tsíndxaꞌwá-mine̱e̱ꞌ i̱ndo̱ó máꞌ ga̱jma̱á numuu̱ ikhaa̱, tsíjiꞌnáa̱, tsíka̱ jayóo̱ sia̱nꞌ. <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />Tsídxu a̱kuii̱n eꞌne rí ra̱máján, rí nadxu a̱kuii̱n eꞌne rí gakon. <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />Tsí nandoo jaꞌñúú xa̱bo̱, mbá xúgíí naꞌne mba̱a̱ a̱kuii̱n jaꞌyoo̱, mbá xúgíí nanimbo̱o̱ꞌ, mbá xúgíí na̱gi̱ꞌthu̱u̱n, mbá xúgíí na̱ꞌngo̱o̱ a̱kuii̱n.<verse eid="1CO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8" />Jámuu ndaꞌyóo rí ma̱xtáa̱ tsí nandoo jaꞌñúú xa̱bo̱. Xómáꞌ tsí nu̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ náxáꞌyóo rí ma̱ju̱wée̱ꞌ, jamí náxájúwa̱ꞌ tsí nuthan ajngáa rí tsígu̱ma-nuwiin, xúꞌkhue̱n máꞌ ma̱mbáa mbá xúgíí rí na̱ma̱ñúú xa̱bo̱ ná tsu̱du̱u̱ numbaa. <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />Numuu rí xúge̱ꞌ na̱nguá káxe̱ e̱ꞌne̱-nuwiinlóꞌ jamí na̱nguá káxe̱ nu̱rawíjnga̱alóꞌ ajngóo Ana̱ꞌlóꞌ. <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />Ído̱ ága̱nú rí jañii, a̱ꞌkhue̱n ma̱mbáa rí na̱nguá káxe̱. <verse eid="1CO 13:10" /><verse number="11" style="v" sid="1CO 13:11" />Ikhúúnꞌ, nákhí ninindxu̱ꞌ ada̱, ni̱tha̱n xómá naꞌthán ada̱, ni̱ndxa̱ꞌwa̱-mína̱ꞌ xómá nandxaꞌwá-mina̱ꞌ ada̱, xúꞌkhue̱n máꞌ ni̱froꞌo̱ꞌ xómá nafroꞌo̱o̱ ada̱. Jamí ído̱ ninindxu̱ꞌ xa̱bo̱ nikhi̱i̱ rá, ni̱ni̱ꞌñúu-ra̱ne̱ rí naꞌne ada̱. <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />Rí xúge̱ꞌ mbá ngidi jayu iꞌyááꞌlóꞌ, xómá tsí nayaxu̱u̱ inuu ná iyaniwan rí miꞌsmba jaꞌnii. Jamí ído̱ ága̱nú rí jañii, a̱ꞌkhue̱n rí ma̱ma̱ꞌthoo inalóꞌ jamí mbu̱ꞌyáá májánlóꞌ. Rí xúge̱ꞌ na̱nguá káxe̱ e̱ne̱-núwíinlo̱ꞌ, jamí ído̱ gága̱nú mbiꞌi rúꞌkhue̱n, a̱ꞌkhue̱n rí mba̱yo̱o̱ asndo xómá jaꞌnii naꞌne-nuwúún Ana̱ꞌlóꞌ.<verse eid="1CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13" />Rí xúge̱ꞌ ríga̱ jámuu atsú ríge̱ꞌ: rí ma̱we̱je̱ a̱kia̱nꞌlóꞌ ná inuu Ana̱ꞌlóꞌ, rí ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ mu̱waꞌthi̱ínlóꞌ ná inuu Ana̱ꞌlóꞌ jamí rí ma̱galóꞌ juꞌñúú xa̱bo̱. Xómáꞌ rí phú i̱tha̱án gíꞌdoo numuu ñajuun rí ma̱galóꞌ juꞌñúú xa̱bo̱.<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s">Rí naxná Xu̱u̱ꞌ Ana̱ꞌlóꞌ kajngó mu̱mbáñúúlóꞌ tsí nanimbu̱únꞌ juyáá Jesús</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />Ga̱galaꞌ máꞌ xúꞌkhue̱n ju̱ñu̱ú xa̱bo̱. Xúꞌkhue̱n máꞌ gu̱ꞌyálaꞌ ñajun rí naxná Xu̱u̱ꞌ Ana̱ꞌlóꞌ kajngó mu̱ne̱-mba̱a̱laꞌ. I̱ndo̱ó máꞌ numuu rí i̱tha̱án máꞌ gu̱ꞌyálaꞌ rí mu̱rawíjnga̱alaꞌ ajngóo Ana̱ꞌlóꞌ. <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />Numuu rí xa̱bo̱ tsí naꞌthán ajngáa rí tsígu̱ma-nuwiin, naꞌthán-mine̱e̱ꞌ máꞌ ikhaa̱ ga̱jmáa̱ i̱ndo̱ó máꞌ Ana̱ꞌlóꞌ, ra̱ꞌkhá i̱ꞌwíin xa̱bo̱ iꞌthúu̱n. Ndawa̱a̱ tsí ifroꞌo̱o̱ rí naꞌthée̱n, maske máꞌ ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ naꞌthée̱n awan drígo̱o̱ Ana̱ꞌlóꞌ rí i̱ndo̱ó máꞌ ikhaa̱ ni̱gi̱da̱ꞌ idxu̱u̱ nákhí wajyúú. <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />Xómáꞌ xa̱bo̱ tsí na̱gu̱wíjnga̱a ajngóo Ana̱ꞌlóꞌ, naꞌthúu̱n xa̱bo̱ ajngáa rí nambáñúu̱ ma̱gajii̱n, rí naxnúu̱ tsiakhe̱ jamí naꞌne rí ma̱ꞌni̱i a̱kuíi̱n. <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />Tsí naꞌthán ajngáa rí tsígu̱ma-nuwiin, ikhaa̱ máꞌ imbáyú-mine̱e̱ꞌ rí ma̱gaja̱a̱. Xómáꞌ tsí na̱gu̱wíjnga̱a ajngóo Ana̱ꞌlóꞌ rá, nambáyúu̱ rí ma̱gaji̱in tsí nanimbu̱únꞌ juyáá Jesús. <verse eid="1CO 14:4" /><verse number="5" style="v" sid="1CO 14:5" />Ikhúúnꞌ naꞌne a̱kui̱nꞌ rí mbá xúgiáanꞌlaꞌ gútha̱nlaꞌ ajngáa rí tsígu̱ma-nuwiin, i̱ndo̱ó máꞌ numuu rí phú i̱tha̱án naꞌne a̱kui̱nꞌ rí mbá xúgiáanꞌlaꞌ gúrawíjnga̱alaꞌ ajngóo Ana̱ꞌlóꞌ. Numuu rí phú i̱tha̱án máꞌ gíꞌdoo numuu xa̱bo̱ tsí na̱gu̱wíjnga̱a ajngóo Ana̱ꞌlóꞌ xó rí xa̱bo̱ tsí naꞌthán ajngáa rí tsígu̱ma-nuwiin. O i̱ndo̱ó máꞌ xí tsí naꞌthán ajngáa rí tsígu̱ma-nuwiin, naꞌthán-wíi̱ ne̱ mangaa rá mbo̱ꞌ, kajngó rúꞌkhue̱n mambáyúu rí ma̱gaji̱in tsí nanimbu̱únꞌ juyáá Jesús.<verse eid="1CO 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 14:6" />A̱ngui̱nꞌ, xí ikhúúnꞌ ma̱ꞌgá gáya̱ꞌlaꞌ jamí ma̱tha̱nꞌlaꞌ ga̱jma̱á ajngáa rí tsígu̱ma-nuwiin, náá lá rí gámbáyálaꞌ rúꞌkhue̱n rá. I̱ndo̱ó máꞌ xí ma̱tha̱nꞌlaꞌ mbá rí wasngájmuꞌ, o mbá rí na̱ma̱ñuꞌ, o ma̱gúwíjnga̱a ajngóo Ana̱ꞌlóꞌ, o mbá gisngáá mbo̱ꞌ, rúꞌkhue̱n rí mambáyálaꞌ. <verse eid="1CO 14:6" /><verse number="7" style="v" sid="1CO 14:7" />Xí na̱nguá jaꞌwu iwán ixe̱ rí naríya̱ꞌ ajmúú, xómá talalí o xi̱tha mbo̱ꞌ, nda̱a̱ xó mbu̱ꞌyáálóꞌ náá rí ajmúú nagájnuu ga̱jma̱á talalí jamí xi̱tha. <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />Xúꞌkhue̱n máꞌ xí na̱nguá jaꞌwu iwán ajwa̱nꞌ e̱ꞌmbi, ndawa̱a̱ tsí gáꞌne-mbánu-mina̱ꞌ rí ma̱ꞌga ná ríga̱ xkujndu. <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />Xkuaꞌnii máꞌ eꞌne ga̱jma̱á nindxa̱ꞌlaꞌ mangáanꞌlaꞌ. Xí tsíthu̱únlaꞌ xa̱bo̱ ga̱jma̱á ajngáa rí nafruꞌu̱ún, ndawa̱a̱ tsí gáfroꞌo̱o̱ rí nu̱tha̱nlaꞌ. Numuu rí asndo xómá ná inuu máꞌ gíñá i̱tha̱nlaꞌ rí xkuaꞌnii. <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />Ná numbaa ríge̱ꞌ maphú mbaꞌa inii ajngáa rí nuthan xa̱bo̱ ríga̱, jamí mbá xúgíí ne̱ gíꞌdoo xó mi̱ꞌthán rí ndaꞌyóo ma̱fruꞌu̱ún xa̱bo̱. <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />Xí ikhúúnꞌ tsífroꞌo̱ꞌ ajngáa rí naꞌthán mbáa xa̱bo̱, ikhúúnꞌ ma̱nindxu̱ꞌ xómá xa̱bo̱ tsí na̱ꞌkha̱ i̱mba̱ xuajen ná inuu tsí naꞌthán, jamí ikhaa máꞌ ma̱nindxu̱u̱ ikhaa̱ ná inuꞌ ikhúúnꞌ xí tsífroꞌo̱o̱ rí na̱tha̱nlo̱ꞌ. <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />Ikhaa jngó ikháanꞌlaꞌ, tsáanꞌ na̱ni̱gua̱ꞌlaꞌ guéño ñajun rí naxná Xu̱u̱ꞌ Ana̱ꞌlóꞌ, gu̱ꞌyálaꞌ rí ma̱janálaꞌ mbaꞌa rí nambáyúu rí ma̱gaji̱in tsí nanimbu̱únꞌ juyáá Jesús.<verse eid="1CO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13" />Ikhaa numuu rúꞌkhue̱n, tsí naꞌthán ajngáa rí tsígu̱ma-nuwiin, gaꞌthán-jáñuu̱ Ana̱ꞌlóꞌ rí ma̱ꞌngo̱o̱ maꞌthán-wíi̱ ne̱ mangaa. <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />Xí ikhúúnꞌ na̱tha̱n-jáñuu Ana̱ꞌlóꞌ ga̱jma̱á ajngáa rí tsígu̱ma-nuwiin, a̱kui̱nꞌ naꞌthúun Ana̱ꞌlóꞌ, i̱ndo̱ó máꞌ numuu rí tsíga̱nú ná idxu̱ꞌ rí na̱tha̱nlo̱ꞌ. <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />Dí gáne̱ xúꞌkhue̱n rá. Ma̱tha̱n-jáñuu Ana̱ꞌlóꞌ ga̱jma̱á a̱kui̱nꞌ, jamí ga̱jma̱á máꞌ idxu̱ꞌ ma̱ne̱ rí ma̱froꞌo̱ꞌ mangaa. Ma̱sian rawunꞌ ga̱jma̱á a̱kui̱nꞌ, jamí ga̱jma̱á máꞌ idxu̱ꞌ ma̱ne̱ rí ma̱froꞌo̱ꞌ mangaa. <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />Xí ikháánꞌ nathane̱-mba̱a̱ Ana̱ꞌlóꞌ ga̱jma̱á i̱ndo̱ó máꞌ a̱kia̱anꞌ, nda̱a̱ rí gáfroꞌo̱o̱ tsí tsíma̱ñuu, jamí ma̱xáxóo maꞌthée̱n «xkuaꞌnii gáꞌne» ga̱jma̱á nindxa̱a̱ꞌ, numuu rí táfroꞌo̱o̱ rí nirathán. <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />Á gáꞌne xí phú mitsaan nitrígu̱u la gamaku inuu Ana̱ꞌlóꞌ, i̱ndo̱ó máꞌ numuu rí nda̱a̱ rí gámbáñúú ne̱ tsí i̱ꞌwíin.<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />Núma̱aꞌ la Ana̱ꞌlóꞌ rí ikhúúnꞌ i̱wa̱á máꞌ na̱tha̱nlo̱ꞌ ajngáa rí tsígu̱ma-nuwiin xó rí mbá xúgiáanꞌlaꞌ ikháanꞌlaꞌ. <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />Xómáꞌ ná majñu̱ú tsí nanimbu̱únꞌ juyáá Jesús i̱wa̱á máꞌ naꞌne a̱kui̱nꞌ rí ma̱tha̱nlo̱ꞌ witsu ajngáa rí nafroꞌo̱ꞌ, kajngó mambáñúú tsí i̱ꞌwíin mangiin, xó rí ma̱tha̱n mbaꞌa guéño ajngáa rí tsígu̱ma-nuwiin.<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />A̱ngui̱nꞌ, mu̱xúndxa̱ꞌwa̱-mijnálaꞌ xómá e̱je̱n. Ga̱nindxa̱ꞌlaꞌ xómá e̱je̱n rí tsíne̱laꞌ rí xkawe̱ꞌ, xómáꞌ rí nafraꞌa̱ꞌlaꞌ rá, ga̱nindxa̱ꞌlaꞌ xómá xa̱bo̱ tsí buanuu. <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" />Ná xtángoo ka̱ma naꞌthán:</para>
  <para style="b" vid="1CO 14:21" />
  <para style="q" vid="1CO 14:21">«Ma̱thu̱ún xa̱bo̱ tsíge̱ꞌ ga̱jma̱á majñu̱u̱ ajngáa rí tsíne̱-nuwiin,</para>
  <para style="q" vid="1CO 14:21">jamí ga̱jma̱á majñu̱ú xa̱bo̱ tsí naguwá i̱ꞌwá xuajen.</para>
  <para style="q" vid="1CO 14:21">Maske máꞌ xúꞌkhue̱n gáne̱, mu̱xúdxawunꞌ rí ma̱thúu̱n, xkuaꞌnii iꞌthán Táta̱».<note caller="+" style="f"><char style="fr" closed="false">14.21 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 28.11-12.</char></note><verse eid="1CO 14:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22" />Ikhaa jngó, ído̱ nithán ajngáa rí tsígu̱ma-nuwiin, mbá rí mbuyáá xa̱bo̱ tsí tsínimbu̱únꞌ juyáá Ana̱ꞌlóꞌ ñajuun ne̱, ra̱ꞌkhá rí mu̱dxawíín tsí nanimbu̱únꞌ. Xómáꞌ rí nagájnanga̱a ajngóo Ana̱ꞌlóꞌ rá, mbá rí mbuyáá tsí nanimbu̱únꞌ ñajuun ne̱, ra̱ꞌkhá rí ma̱fruꞌu̱ún tsí tsínimbu̱únꞌ. <verse eid="1CO 14:22" /><verse number="23" style="v" sid="1CO 14:23" />Ga̱ju̱ma̱ꞌlaꞌ rí mbá xúgíin tsí nanimbu̱únꞌ juyáá Jesús na̱gi̱mbíin jamí mbá xúgíi̱n nuthee̱n ajngáa rí tsígu̱ma-nuwiin, a̱ꞌkhue̱n na̱tu̱ꞌu̱ún mbá tikhuun xa̱bo̱ tsí tsíma̱ñúú o tsínimbu̱únꞌ mbo̱ꞌ, muthee̱n rí mbá xúgiáanꞌlaꞌ najmiyalaꞌ. <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />I̱ndo̱ó máꞌ numuu rí, xí mbá xúgíin nu̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ, jamí na̱to̱ꞌo̱o̱ mbáa tsí tsíma̱ñuu o tsínimbo̱o̱ꞌ mbo̱ꞌ, a̱ꞌkhue̱n mayaxe̱-mine̱e̱ꞌ jamí mbá xúgiáanꞌlaꞌ mu̱ne̱laꞌ rí mba̱ꞌyoo̱ rí xa̱bo̱ aꞌkhán ñajuu̱n. <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />Mbá xúgíí rí ríga̱ ngu̱ꞌwo̱o̱ ná awúun a̱kuii̱n ma̱kujma. A̱ꞌkhue̱n masmáti̱go̱o̱ jamí maꞌgíi̱ inuu̱ asndo mbayíí rí ma̱ꞌne-mba̱a̱ Ana̱ꞌlóꞌ, jamí maꞌthée̱n: «Gakon rí Ana̱ꞌlóꞌ xtáa ga̱jma̱á nindxa̱ꞌlaꞌ».<verse eid="1CO 14:25" /></para>
  <para style="s">Xáne gíꞌmaa rí ma̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />Ikhaa jngó a̱ngui̱nꞌ, ído̱ rí na̱gi̱mbáanꞌlaꞌ, mbáa gáꞌsian rawuun ajmúú, i̱mba̱a̱ꞌ gáꞌsngáá, i̱mba̱a̱ꞌ gáꞌthán rí Ana̱ꞌlóꞌ nisngájmuu, i̱mba̱a̱ꞌ gáꞌthán ajngáa rí tsígu̱ma-nuwiin, i̱mba̱a̱ꞌ gáꞌthán-wíi ajngáa. I̱ndo̱ó máꞌ numuu rí mbá xúgíí gágu̱ma rí mambáyúu ma̱gaji̱in xa̱bi̱i Ana̱ꞌlóꞌ. <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />Xí mbá tikhuun nuthan ajngáa rí tsígu̱ma-nuwiin, guthee̱n a̱jmii̱, o asndo atsúu̱n mbo̱ꞌ. Mbámbáa gáꞌthán ído̱ rí najanáá maꞌthán, jamí mbáa gáꞌthán-wíi rí naꞌthán mbámbáa. <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />Xí ndawa̱a̱ tsí maꞌthán-wíi, ga̱ꞌne-wíyuu rawúu̱n ná inúú tsí nanimbu̱únꞌ juyáá Jesús, jamí guthan-mijnée̱ máꞌ i̱ndo̱ó ikhii̱n gajmíi̱ Ana̱ꞌlóꞌ.<verse eid="1CO 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 14:29" />Xúꞌkhue̱n máꞌ tsí nu̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ, guthee̱n a̱jmii̱ o atsúu̱n mbo̱ꞌ. Xómáꞌ tsí i̱ꞌwíin gu̱ra̱jwe̱e̱ꞌ xí gakon rí nuthee̱n. <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />Jamí xí mbáa tsí ꞌgí ikhín wasngájmáá mbá rí maꞌthán eꞌne Ana̱ꞌlóꞌ, ga̱ꞌne-wíyuu rawuun tsí ginii naꞌthán máꞌ. <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />Xkuaꞌnii kajngó mbá xúgiáanꞌlaꞌ ma̱goo mu̱rawíjnga̱alaꞌ ajngóo Ana̱ꞌlóꞌ, i̱ndo̱ó máꞌ numuu rí mbámbáa gáꞌthán, kajngó mbá xúgíin gáma̱ñúú jamí muda̱a tsiakhe̱. <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />Xa̱bo̱ tsí nu̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ, nduyáa̱ máꞌ ikhii̱n nguáná jaꞌyoo rí muthee̱n. <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />Numuu rí Ana̱ꞌlóꞌ tsíꞌne rí ma̱ju̱wá nikhuáa xa̱bo̱, rí naꞌnii̱ rí ma̱ju̱wá tsímáá xa̱bo̱.</para>
  <para style="p" vid="1CO 14:33">Xkuaꞌnii máꞌ jaꞌnii ná mbá xúgíí kuthuun tsí jaꞌwuun nanimbu̱únꞌ juyáá Jesús, <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />na̱tha̱n rí wíí gáꞌne rawúún go̱ꞌo̱ ná na̱gi̱mbáanꞌlaꞌ, numuu rí ra̱jáꞌñúu̱ muthee̱n, rí i̱ndo̱ó máꞌ jaꞌyoo rí mune̱-mbáníi̱ rí nithúu̱n, xómá ka̱ma naꞌthán ná xtángoo mangaa. <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />Xí ríga̱ mbá rí nandúu̱n ma̱ma̱ñúu̱, gu̱ra̱xúu̱n a̱jmbáa̱n ná guꞌwúu̱n, numuu rí na̱nguá mitsaan ikujma ído̱ rí mbáa a̱ꞌgo̱ naꞌthán ná na̱gi̱mbáanꞌlaꞌ.<verse eid="1CO 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36" />A̱gu̱ya̱álaꞌ rí ra̱ꞌkhá ná majña̱ꞌlaꞌ ikháanꞌlaꞌ nigájnuu ajngáa rawuun Ana̱ꞌlóꞌ, ni máꞌ ra̱ꞌkhá i̱ndo̱ó ikháanꞌlaꞌ ni̱drígúlaꞌ ne̱. <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />Xí mbáa na̱ju̱mu̱u̱ rí xa̱bo̱ tsí na̱gu̱wíjnga̱a ajngóo Ana̱ꞌlóꞌ ñajuun, o xtáa xómá nandoo Xu̱u̱ꞌ Ana̱ꞌlóꞌ mbo̱ꞌ, ga̱ꞌyoo̱ rí ajngáa rí naxná-ñájun Táta̱ ñajuun ríge̱ꞌ, rí na̱tháán ma̱ꞌga inalaꞌ. <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />Xómáꞌ xa̱bo̱ tsí tsíyoo gádxawuun ajngáa ríge̱ꞌ rá, ndawa̱a̱ máꞌ tsí gádxawuun rí naꞌthée̱n mangaa̱.<verse eid="1CO 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39" />Ikhaa jngó, a̱ngui̱nꞌ, gu̱xna̱-míjnálaꞌ tsiakhe̱ rí mu̱rawíjnga̱alaꞌ ajngóo Ana̱ꞌlóꞌ, jamí mu̱xúrikháálaꞌ rí mi̱ꞌthán ajngáa rí tsígu̱ma-nuwiin. <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />I̱ndo̱ó máꞌ numuu rí ga̱gu̱ma mbá xúgíí ga̱jma̱á gamaku jamí ra̱ꞌkhá nikhuáa jayu.<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s">Ndiyáa mbiꞌyuu Krísto̱</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />Rí xúge̱ꞌ rá, a̱ngui̱nꞌ, nandoꞌ rí ma̱rmáꞌáan a̱kia̱nꞌlaꞌ ju̱ya̱á ajngáa máján rí ni̱sngálaꞌ, ikhaa rí ni̱drígúlaꞌ jamí tsíni̱ꞌñáá-ranimba̱ꞌlaꞌ ju̱ya̱á. <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />Ga̱jma̱á majñu̱u̱ ajngáa ríge̱ꞌ ma̱jáwiáanꞌlaꞌ, xí tsíni̱ꞌñáálaꞌ jamí tsímbumalaꞌ rí ni̱sngálaꞌ. I̱ndo̱ó máꞌ numuu rí, xí nu̱ni̱ꞌñáálaꞌ ne̱, nda̱a̱ máꞌ numuu rí ninimba̱ꞌlaꞌ ne̱ xúꞌkhue̱n rá.<verse eid="1CO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3" />Numuu rí ginii jayu ni̱sngálaꞌ ikhaa máꞌ rí waꞌsngóꞌ ikhúúnꞌ: Rí Krísto̱ nijáñuu ga̱jma̱á numuu aꞌkhánlóꞌ, xómá ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ. <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" />Xúꞌkhue̱n máꞌ waꞌdii̱, jamí ndiyáa̱ mbiꞌyuu̱ nákhí nirámuu atsú mbiꞌi, xómá ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ. <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" />Nikujmaa̱ inuu Pédro̱,<note caller="+" style="f"><char style="fr" closed="false">15.5 </char><char style="ft" closed="false">«Pedro» ñajuun ajngáa griégo̱ jamí «Cefas» ñajuun ajngáa araméo̱.</char></note> jamí nda̱wa̱á nikujmaa̱ inúú tsí mbá gu̱wa̱ꞌ i̱jmi̱i (12) niꞌsngúu̱n. <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />Nda̱wa̱á nanújngoo rí mbá witsu siénto̱ (500) a̱ngia̱nꞌlóꞌ nikujmaa̱ inúú mbóó miꞌtsú. Mbá tikhuun tsúꞌkhue̱n xóó júwa̱ꞌ nduya xúge̱ꞌ, jamí i̱ꞌwíin nijáñúú máꞌ. <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />Nda̱wa̱á nikujmaa̱ inuu Santiágo̱.<note caller="+" style="f"><char style="fr" closed="false">15.7 </char><char style="ft" closed="false">Ná i̱yi̱i̱ꞌ griégo̱ rí wayuu naꞌthán «Jakóbo̱», rí nithán «Santiágo̱» ná ajngáa xtílo̱o̱.</char></note> I̱tha̱n nda̱wa̱á nikujmaa̱ inúú mbá xúgíin tsí ikhaa̱ nixúnguii̱nꞌ. <verse eid="1CO 15:7" /><verse number="8" style="v" sid="1CO 15:8" />Jamí nda̱wa̱á jayu nikujmaa̱ inuꞌ ikhúúnꞌ, tsúún ñajunꞌ xómá ada̱ tsí tágu̱maa awúun mbiꞌi rí jaꞌyoo ma̱gu̱maa.<verse eid="1CO 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 15:9" />Ikhúúnꞌ ñajunꞌ tsí phú i̱tha̱án na̱nguá gíꞌdoo numuu rí mbá xúgíin tsí waxúngui̱inꞌ, ni máꞌ ra̱jáꞌyoꞌ rí ma̱nindxu̱ꞌ mbáa tsí waxúngua̱a̱ꞌ, numuu rí phú ne̱ne̱-ngíníilo̱ꞌ tsí nanimbu̱únꞌ juyáá Ana̱ꞌlóꞌ. <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />I̱ndo̱ó máꞌ numuu rí phú májáan a̱kui̱in Ana̱ꞌlóꞌ jaꞌyeꞌ, ikhaa jngó ninindxu̱ꞌ rí ñajunꞌ xúge̱ꞌ. Jamí táꞌne díí ga̱jma̱á nindxu̱ꞌ rí nixníꞌ Ana̱ꞌlóꞌ, a̱ꞌkhue̱n gakon, ikhúúnꞌ phú i̱tha̱án ni̱ñajun xó rí mbá xúgíin tsí waxúngui̱inꞌ. Ra̱ꞌkhá ski̱yu̱ꞌ ikhúúnꞌ naꞌne rí na̱ꞌngo̱ꞌ na̱ñajunlo̱ꞌ, rí ga̱jma̱á numuu rí Ana̱ꞌlóꞌ xtáa ga̱jma̱á nindxu̱ꞌ. <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />Ikhaa jngó, ga̱nindxu̱ꞌ ikhúúnꞌ o ga̱nindxúu̱n ikhii̱n, ikhaa máꞌ i̱sngááxo̱ꞌ, jamí ikhaa máꞌ rúꞌkhue̱n ñajuun rí ninimba̱ꞌlaꞌ.<verse eid="1CO 15:11" /></para>
  <para style="s">Mbuya̱a mbiꞌñúú tsí nijáñúú</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />Xí ikháanꞌxo̱ꞌ nu̱tha̱n-ráꞌaxo̱ꞌ rí Krísto̱ ndiyáa mbiꞌyuu, náá numuu kajngó mbá tikhuun tsí ikháanꞌlaꞌ nuthan rí ma̱xúya̱a mbiꞌñúú tsí nijáñúú róꞌ. <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />Xí ma̱xúya̱a mbiꞌñúú tsí nijáñúú, táyáa máꞌ mbiꞌyuu Krísto̱ mangaa xúꞌkhue̱n rá. <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />Jamí xí Krísto̱ táyáa mbiꞌyuu, nda̱a̱ máꞌ numuu rí nu̱tha̱n-ráꞌaxo̱ꞌ xúꞌkhue̱n rá, jamí nda̱a̱ máꞌ numuu rí wéje̱ a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ mangaa. <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />Xí gakon rí ma̱xúya̱a mbiꞌñúú tsí nijáñúú, ikháanꞌxo̱ꞌ ñajwanxo̱ꞌ xa̱bi̱i Ana̱ꞌlóꞌ tsí mi̱nduwiin xúꞌkhue̱n rá, numuu rí ikháanꞌxo̱ꞌ ni̱tha̱nxo̱ꞌ rí ikhaa̱ niꞌnii̱ rí mbayáa mbiꞌyuu Krísto̱. <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />Xí ma̱xúya̱a mbiꞌñúú tsí nijáñúú, táyáa máꞌ mbiꞌyuu Krísto̱ mangaa xúꞌkhue̱n rá. <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />Jamí xí táyáa mbiꞌyuu Krísto̱, nda̱a̱ máꞌ numuu rí wéje̱ a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ, jamí xóó máꞌ táꞌne mba̱a̱ a̱kui̱in Ana̱ꞌlóꞌ jaꞌyoo aꞌkhánlaꞌ xúꞌkhue̱n rá. <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />Xí xkuaꞌnii jaꞌnii, tsí nijáñúú nanimbu̱únꞌ juyáá Krísto̱, nindáti̱gii̱n máꞌ mangii̱n xúꞌkhue̱n rá. <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />Xí i̱ndo̱ó máꞌ jayu ná numbaa ríge̱ꞌ mbá jañii a̱kia̱nꞌlóꞌ guáꞌthi̱ínlóꞌ rí mambáyálóꞌ Krísto̱, ikháánꞌlóꞌ ñajwanlóꞌ tsí phú i̱tha̱án mingíníi inúú mbá xúgíin xa̱bo̱ xúꞌkhue̱n rá.<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />I̱ndo̱ó máꞌ numuu rí phú gakon rí ndiyáa mbiꞌyuu Krísto̱. Ikhaa̱ ñajuu̱n tsí ginii jayu ndiyáa mbiꞌyuu ná inúú tsí nijáñúú. <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />Xómá rí ga̱jma̱á majñu̱u̱ mbáwíi xa̱bo̱ nijáñúú mbá xúgíin xa̱bo̱, xkuaꞌnii máꞌ mangaa ga̱jma̱á majñu̱u̱ mbáwíi xa̱bo̱ mbuya̱a mbiꞌñúú tsí nijáñúú. <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />Xómá rí najáñúú mbá xúgíin xa̱bo̱ tsí na̱gu̱mii ga̱jma̱á majñu̱u̱ Adán, xkuaꞌnii máꞌ mangaa mbuya̱a mbiꞌñúú mbá xúgíin xa̱bo̱ tsí na̱gu̱mii ga̱jma̱á majñu̱u̱ Krísto̱. <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />I̱ndo̱ó máꞌ numuu rí mbámbáa gátu̱xi̱i ído̱ gága̱nú mbiꞌi: Krísto̱ ñajuun tsí ginii jayu. Nda̱wa̱á, ído̱ ma̱ꞌkhaa̱ mbuya̱a mbiꞌñúú tsí ñajúún xa̱bii̱. <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />A̱ꞌkhue̱n rí ma̱mbá numbaa, ído̱ rí Krísto̱ maxnáxii̱ rí niꞌthán-ñájuu̱n ná ñawúun Ana̱ꞌlóꞌ Mikhuíí, ído̱ gáꞌne gámbo̱o̱ ski̱ñu̱ú mbá xúgíin gíñá ꞌguéen, xúgíin xa̱bo̱ ñajun jamí xúgíin thúngaa. <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />Numuu ndaꞌyóo rí Krísto̱ maꞌthán-ñájun asndo náá gáꞌngo̱o̱ inúú mbá xúgíin tsí sia̱nꞌ gajmíi̱. <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />Jamí asndo nda̱wa̱á jayu ma̱ꞌne-gámbo̱o̱ tsiakhe̱ sia̱nꞌ rí naꞌne rí ma̱ja̱ñúú xa̱bo̱. <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />Numuu rí «mbá xúgíí niꞌgí Ana̱ꞌlóꞌ inuu̱ rí maꞌthán-ñájuu̱n».<note caller="+" style="f"><char style="fr" closed="false">15.27 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 8.6.</char></note> Ído̱ nithán rí «mbá xúgíí» ni̱ge̱ꞌe̱ inuu̱ rí maꞌthán-ñájuu̱n, nakujma nguáná máꞌ rí Krísto̱ tsíꞌthán-ñájuu̱n asndo Ana̱ꞌlóꞌ, numuu rí jmína̱a̱ꞌ máꞌ Ana̱ꞌlóꞌ ñajuun tsí niꞌgíi̱ rí maꞌthán-ñájuu̱n mbá xúgíí. <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />Jamí ído̱ rí mbá xúgíí máꞌ ni̱to̱ꞌo̱o̱ ñawúu̱n rí maꞌthán-ñájuu̱n, a̱ꞌkhue̱n rí jmína̱a̱ꞌ máꞌ Krísto̱ mangaa, tsí A̱dée Ana̱ꞌlóꞌ, maniña-mine̱e̱ꞌ rí mi̱ꞌthán-ñájwíi̱n gáꞌne tsí niꞌgíi̱ rí maꞌthán-ñájuu̱n mbá xúgíí. A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ maꞌthán-ñájuun mbá xúgíí jamí mbá xúgíin xa̱bo̱.<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />Xí ra̱ꞌkhá xkuaꞌnii, dí lá gámbáñúú tsí nu̱xu̱ꞌdú-maꞌán-mijná ná awúun iya ga̱jma̱á numúú tsí nijáñúú rá. Xí ni miꞌtsú ma̱xúya̱a mbiꞌñúú tsí nijáñúú, náá numuu kajngó nu̱xu̱ꞌdú-maꞌán-mijnée̱ ná awúun iya ga̱jma̱á numúú tsí nijáñúú róꞌ. <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />Jamí ikháanꞌxo̱ꞌ, náá numuu kajngó juwaxo̱ꞌ ná awúun ngamí rí ma̱ja̱ñáxo̱ꞌ mbámbá mbiꞌi róꞌ. <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />A̱ngui̱nꞌ, na̱tha̱nꞌ-jmbalaꞌ rí mbámbá mbiꞌi rí xtáálo̱ꞌ, ngamí ma̱ja̱ñúꞌ. Phú gakon rúꞌkhue̱n, xómá phú gakon rí nadxu a̱kui̱nꞌ ja̱ya̱ꞌlaꞌ numuu rí nanimba̱ꞌlaꞌ ju̱ya̱á Tátiálóꞌ Jesukrísto̱. <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />Xí i̱ndo̱ó máꞌ ná numbaa ríge̱ꞌ juwalóꞌ, dí ñajuun ni̱ꞌngo̱ꞌ rí ni̱tsa̱ñu̱ꞌ gajmíꞌ xa̱bo̱ tsí xómá i̱ndi̱í jaꞌñúú ná xuajen Éfe̱so̱ xúꞌkhue̱n rá. Xí ma̱xúya̱a mbiꞌñúú tsí nijáñúú, i̱wa̱á máján: «Gu̱peꞌtsolóꞌ jamí gu̱ꞌwa̱a̱nlóꞌ iya, numuu rí gátsíí ma̱ja̱ñálóꞌ».<verse eid="1CO 15:32" /></para>
  <para style="b" />
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33" />Mu̱xúni̱ꞌñá-mijnálaꞌ rí ma̱gu̱ma-nduwáanꞌlaꞌ. Xáꞌnii iꞌthán mbá ajngáa: «Xa̱bo̱ tsí naguꞌwúún máꞌ nune̱ rí ra̱máján, mune̱-maꞌkhíi̱n xa̱bo̱ tsí naguꞌwúún máꞌ nune̱ rí máján». <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />¡Ga̱jwi̱iꞌlaꞌ! Gu̱ndxa̱ꞌwa̱-mijná májánlaꞌ rí mu̱ne̱laꞌ, jamí náxúne̱laꞌ aꞌkhán. Numuu rí mbá tikhuáanꞌlaꞌ tsíne̱-nuwiinlaꞌ Ana̱ꞌlóꞌ. Na̱tha̱nꞌlaꞌ ríge̱ꞌ kajngó ma̱ti̱ya̱ꞌlaꞌ.<verse eid="1CO 15:34" /></para>
  <para style="s">Xáne jaꞌnii xuñúú tsí nijáñúú gáꞌne ído̱ rí mbuya̱a mbiꞌñúú</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />Á gáꞌne xí mbáa maraxe̱: «Xáne gúya̱a mbiꞌñúú tsí nijáñúú róꞌ. Xáne jaꞌnii xuñúu̱ gáꞌne ído̱ rí ma̱ga̱jnáa̱ ná iñá-wajen róꞌ». <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />¡Maphú júgoo inaaꞌ! Ído̱ rí ikháánꞌ nathadu mbá tsíga, ndaꞌyóo rí ma̱ja̱ñúu ne̱ ginii kajngó ma̱jráꞌán ne̱. <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />Ra̱ꞌkhá inúu ne̱ rí ma̱jráꞌán ná inuu ju̱ba̱ꞌ ithadu, rí i̱ndo̱ó máꞌ tsíga ithadu, ga̱nindxu̱u̱ ne̱ ixí o i̱mba̱ inii tsíga mbo̱ꞌ. <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />Xómáꞌ Ana̱ꞌlóꞌ naxnúu̱ xuyuu ne̱ xómá naꞌne a̱kuii̱n ikhaa̱, jamí mbámbá tsíga kriꞌkhu xuyuu ne̱. <verse eid="1CO 15:38" /><verse number="39" style="v" sid="1CO 15:39" />Ra̱ꞌkhá mbóó inii xuwi ñajuun mbá xúgíí xuwi rí ríga̱, rí mbá inii xuwi ñajúún xa̱bo̱, i̱mba̱ inii xuwi ñajúún xu̱kú-xáná, i̱mba̱ inii rí ñajúún i̱gi̱ꞌ, jamí i̱mba̱ inii rí ñajúún xu̱kú xna. <verse eid="1CO 15:39" /><verse number="40" style="v" sid="1CO 15:40" />Mbá xó jaꞌnii xuyuu mbaꞌa rí ríga̱ mikhuíí, jamí i̱mba̱ xó jaꞌnii xuyuu mbaꞌa rí ríga̱ mbayíí. I̱ndo̱ó máꞌ numuu rí mbá xó tsiꞌyá mbaꞌa rí ríga̱ mikhuíí, jamí i̱mba̱ xó tsiꞌyá mbaꞌa rí ríga̱ mbayíí. <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />Mbá xó tsiꞌyáa a̱kha̱ꞌ, i̱mba̱ xó tsiꞌyáa go̱nꞌ, jamí i̱mba̱ xó tsiꞌñíi a̱ꞌgua̱án, numuu rí mbámbáa a̱ꞌgua̱án kriꞌkhu tsiꞌyáa̱.<verse eid="1CO 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42" />Xkuaꞌnii máꞌ gáꞌne ído̱ rí mbuya̱a mbiꞌñúú tsí nijáñúú mangaa. Rí nidu ná awúun ju̱ba̱ꞌ naꞌga ne̱, jamí ído̱ rí mba̱ꞌya̱a ne̱ náxíga ne̱. <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />Rí nidu, xkawe̱ꞌ giaxu̱u̱ ne̱, jamí rí mba̱ꞌya̱a mitsaan giaxu̱u̱ ne̱. Rí nidu wabaa ne̱, jamí rí mba̱ꞌya̱a gakhi̱i̱ ne̱, náxájáñuu ne̱. <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />Rí nidu ñajuun xuwi ná numbaa ríge̱ꞌ, jamí rí mba̱ꞌya̱a, ñajuun xuwi rí nithán-ñájwíín eꞌne xe̱ꞌ. Xómá rí ríga̱ xuwi ná numbaa ríge̱ꞌ, xkuaꞌnii máꞌ ríga̱ xuwi rí nithán-ñájwíín eꞌne xe̱ꞌ mangaa.<verse eid="1CO 15:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="1CO 15:45" />Xkuaꞌnii ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ: «Adán, xa̱biya̱ tsí ginii jayu, ninindxu̱u̱ mbáa xa̱bo̱ tsí ndaꞌya».<note caller="+" style="f"><char style="fr" closed="false">15.45 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ xó ni̱gi̱ꞌdu̱u̱n-muu 2.7.</char></note> Xómáꞌ Adán tsí nda̱wa̱á jayu, ninindxu̱u̱ xe̱ꞌ tsí naꞌne rí mbuya xa̱bo̱. <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />Ginii niríga̱ xuyuu xa̱bo̱ rí ni̱gu̱ma-ku̱maa ga̱jma̱á ju̱ba̱ꞌ, nda̱wa̱á ma̱ri̱gá xuyuu̱ rí mi̱ꞌthán-ñájwíín gáꞌne xe̱ꞌ. <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />Xa̱biya̱ tsí ginii, ni̱gu̱ma-ku̱maa̱ ga̱jma̱á ju̱ba̱ꞌ, jamí ná mbayíí ni̱ꞌkhe̱e̱. Xómáꞌ xa̱biya̱ tsí riajma̱a̱ tsí ñajuun Táta̱ tsí naꞌthán-ñájun,<note caller="+" style="f"><char style="fr" closed="false">15.47 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «tsí ñajuun Táta̱ tsí naꞌthán-ñájun».</char></note> ná mikhuíí ni̱ꞌkhe̱e̱. <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />Xómá jaꞌnii xa̱bo̱ tsí ni̱ꞌkha̱ ná mbayíí, xkuaꞌnii máꞌ jaꞌñúú xa̱bo̱ tsí júwa̱ꞌ ná numbaa ríge̱ꞌ mangaa. Jamí xómá jaꞌnii xa̱bo̱ tsí ni̱ꞌkha̱ ná mikhuíí, xkuaꞌnii máꞌ jaꞌñúú xa̱bo̱ tsí júwa̱ꞌ ná mikhuíí mangaa. <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />Xómá rí ninindxa̱ꞌlóꞌ xómá jaꞌnii xa̱bo̱ tsí ni̱gu̱ma-ku̱maa ga̱jma̱á ju̱ba̱ꞌ, xkuaꞌnii máꞌ ma̱nindxa̱ꞌlóꞌ xómá jaꞌnii xa̱bo̱ tsí ni̱ꞌkha̱ ná mikhuíí mangaa.<verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />A̱ngui̱nꞌ, nandoꞌ gátha̱nꞌlaꞌ ríge̱ꞌ: Rí xómá jaꞌnii xuyalóꞌ xúge̱ꞌ, nda̱a̱ rí ma̱goo ma̱janálóꞌ ná naꞌthán-ñájun Ana̱ꞌlóꞌ, numuu rí xuyalóꞌ rí naꞌchúu ma̱xáxóo ma̱ri̱gá ne̱ ná ríga̱ rí tsíꞌchúu.<verse eid="1CO 15:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="1CO 15:51" />Gu̱dxawíín májánlaꞌ, numuu rí ma̱tha̱nꞌlaꞌ awan drígo̱o̱ Ana̱ꞌlóꞌ rí i̱ndo̱ó máꞌ ikhaa̱ ni̱gi̱da̱ꞌ idxu̱u̱ nákhí wajyúú: Ra̱ꞌkhá mbá xúgiáanꞌlóꞌ ma̱ja̱ñálóꞌ, i̱ndo̱ó máꞌ numuu rí mbá xúgiáanꞌlóꞌ ma̱xtiꞌkhuáanꞌlóꞌ mbá jayu. <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />Mbá nacha̱ jayu gáꞌne, xómá rí naxpáduu xa̱bo̱, ído̱ gáwán rí nda̱wa̱á jayu ajwa̱nꞌ e̱ꞌmbi. Numuu rí ma̱wán e̱ꞌmbi, jamí tsí nijáñúú mbuyaa̱ mbiꞌñúu̱ rí ma̱ju̱wée̱ꞌ jámuu, xómáꞌ ikháánꞌlóꞌ ma̱xtiꞌkhuáanꞌlóꞌ mbá jayu. <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />Numuu ndaꞌyóo rí ma̱xtiꞌkhu̱u xuyalóꞌ rí naꞌga, ma̱ꞌni̱i ne̱ rí tsíꞌga, jamí ikhaa máꞌ xuyalóꞌ rí najáñuu ma̱ꞌni̱i ne̱ rí tsíjáñuu. <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" />Ído̱ gáxtiꞌkhu̱u rí naꞌga ma̱ꞌni̱i ne̱ rí tsíꞌga, jamí ikhaa máꞌ rí najáñuu ma̱ꞌni̱i ne̱ rí tsíjáñuu, a̱ꞌkhue̱n ma̱mba̱núu rí ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="q" vid="1CO 15:54">«Ni̱ꞌngo̱o̱ ni̱gu̱ma-gámba̱a mbá jayu tsiakhe̱ rí naꞌne rí ma̱ja̱ñúú xa̱bo̱».<note caller="+" style="f"><char style="fr" closed="false">15.54 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 25.8.</char></note><verse eid="1CO 15:54" /></para>
  <para style="b" />
  <para style="q">
    <verse number="55" style="v" sid="1CO 15:55" />«Ikháánꞌ, tsiakhe̱ rí naꞌne rí ma̱ja̱ñúú xa̱bo̱, náá ni̱ka̱ rí ni̱ꞌnga̱a̱ꞌ rá.</para>
  <para style="q" vid="1CO 15:55">Ikháánꞌ, tsiakhe̱ rí naꞌne rí ma̱ja̱ñúú xa̱bo̱, náá ni̱ka̱ ski̱ya̱a̱ꞌ rá».<note caller="+" style="f"><char style="fr" closed="false">15.55 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Oséa̱s 13.14.</char></note><verse eid="1CO 15:55" /></para>
  <para style="b" />
  <para style="p">
    <verse number="56" style="v" sid="1CO 15:56" />Rí naꞌne rí ma̱ja̱ñálóꞌ ñajuun aꞌkhánlóꞌ. Rí nasngájma aꞌkhánlóꞌ ñajuun xtángawoo Moisés, jamí naxnúu ne̱ tsiakhe̱ aꞌkhánlóꞌ rí ma̱gu̱diáanꞌlóꞌ. <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />I̱ndo̱ó máꞌ numuu rí núma̱aꞌ la Ana̱ꞌlóꞌ rí naꞌnii̱ rí ma̱ꞌnga̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ Tátiálóꞌ Jesukrísto̱.<verse eid="1CO 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58" />Ikhaa jngó a̱ngui̱nꞌ, tsáanꞌ phú nandoꞌ ja̱ya̱ꞌlaꞌ, ga̱wajún-gúkuálaꞌ jamí ma̱xáꞌne níꞌnga̱ꞌlaꞌ. Gu̱ne̱laꞌ jámba̱ miꞌtsú ñajuun Táta̱, numuu rí ndu̱ya̱álaꞌ máꞌ rí jámuu gíꞌdoo numuu ñajun rí nu̱ne̱laꞌ ná inuu Táta̱.<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s">Mbúkha̱a̱ rí mi̱tambáñúú ga̱jma̱á xa̱bi̱i Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />Xúge̱ꞌ rí nandoꞌ ma̱tha̱nꞌlaꞌ ga̱jma̱á numuu mbúkha̱a̱ rí mi̱tambáñúú ga̱jma̱á xa̱bi̱i Ana̱ꞌlóꞌ. Gu̱ne̱ máꞌ mangáanꞌlaꞌ xómá ni̱thu̱ún mbámbá kuthuun tsí nanimbu̱únꞌ juyáá Jesús ná numbaa Galásia̱. <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />Mbámbá mbiꞌi ginii rí ndayáa semána̱, mbámbáa gíꞌmaa maríya̱ꞌ jamí mayáxi̱i janíí tháan mbúkha̱a̱ rí maxná, xómá nidaa̱ awúun rí majun mbiꞌi rí ninújngoo máꞌ. Ikhaa jngó ma̱xáꞌne rí ni̱kú ma̱gi̱xi̱i mbúkha̱a̱ ído̱ rí ma̱gánúlo̱ꞌ. <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />Ído̱ gágánú, a̱ꞌkhue̱n ma̱xnu̱ú i̱yi̱i̱ꞌ rí mu̱xna̱xí-mijná ga̱jma̱á tsí ni̱raꞌwíinlaꞌ, jamí ma̱xu̱ꞌmíi̱ꞌ magóo̱ juñúu̱ ná Jerusalén mbúkha̱a̱ rí niwa̱a. <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />Jamí xí ndaꞌyóo rí ma̱ꞌgá mangúúnꞌ rá, magóo̱ ga̱jma̱á nindxu̱ꞌ.<verse eid="1CO 16:4" /></para>
  <para style="s">Rí naꞌgí-mina̱ꞌ Páblo̱ ma̱ꞌne</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />Ído̱ rí ma̱ꞌgá gáya̱ꞌlaꞌ, ndaꞌyóo rí ma̱nújngoꞌ ná numbaa Masedónia̱ ginii, nda̱wa̱á a̱ꞌkhue̱n ma̱gánú ná Korínto̱. <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />Á gáꞌne xí ma̱xtáá mbá wátha̱ wáa mbiꞌi ga̱jma̱á nindxa̱ꞌlaꞌ, o á gáꞌne xí mbá jañii go̱nꞌ rí naꞌne ngúwán mbo̱ꞌ, kajngó mu̱xnu̱ꞌlaꞌ rí ndaꞌyóo ma̱ꞌgá-muꞌ asndo náá máꞌ gáꞌgálo̱ꞌ rí nda̱wa̱á. <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />Numuu tsíyoꞌ rí i̱ndo̱ó máꞌ ma̱nújngoꞌ-ra̱ya̱ꞌlaꞌ, rí nandoꞌ ma̱xtáá mba̱ꞌyo̱ꞌ máwáa ga̱jma̱á nindxa̱ꞌlaꞌ, xí numuu rí nandoo Táta̱. <verse eid="1CO 16:7" /><verse number="8" style="v" sid="1CO 16:8" />I̱ndo̱ó máꞌ numuu rí ma̱xtáá ná xuajen Éfe̱so̱ asndo ndxa̱a̱ Pentekostés. <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />Numuu rí ni̱ma̱ꞌthoo mbá xkrugua mba̱a̱ rí ma̱ne̱ mbá ñajun rí phú na̱gi̱do̱o̱ꞌ, maske máꞌ phú mbaꞌiin tsí nawajún-ꞌthi̱ín.<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />Ído̱ ága̱nú Timotéo̱, a̱gu̱ya̱álaꞌ rí ma̱xtáa̱ mújúu̱n ga̱jma̱á nindxa̱ꞌlaꞌ, numuu rí ikhaa̱ naꞌnii̱ ñajuun Táta̱ xómá rí na̱ne̱ ikhúúnꞌ. <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />Ikhaa jngó, nimbáa ma̱xáꞌñuu̱ asndo xómá rí nda̱a̱ numuu̱. Jamí ído̱ gáꞌkhaa̱, gu̱xnáa̱laꞌ rí mba̱ꞌyóo̱ ná jamba̱a̱ kajngó ma̱ga̱núu̱ mújúu̱n ná xtáá ge̱jyoꞌ, numuu rí gúꞌthu̱u̱nlo̱ꞌ gajmíꞌ i̱ꞌwíin a̱ngia̱nꞌlóꞌ.<verse eid="1CO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12" />Xómáꞌ dxájwalóꞌ Apólo̱s, maphú ni̱tha̱n-jáñuu̱ rí ma̱ꞌgee̱ gáꞌyalaꞌ gajmíi̱ i̱ꞌwíin a̱ngia̱nꞌlóꞌ. Maske máꞌ asndo xúge̱ꞌ ra̱khóo̱ gáꞌgee̱, ma̱ꞌgee̱ nda̱wa̱á ído̱ gáyaphaa̱.<verse eid="1CO 16:12" /></para>
  <para style="s">Rí nithúún mune̱ xa̱bi̱i Ana̱ꞌlóꞌ ná Korínto̱</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />Ga̱juwalaꞌ xawi. Ga̱wajún-gúkuálaꞌ ná tsu̱du̱u̱ rí nanimba̱ꞌlóꞌ juꞌyáá. Nimbáa ma̱xáꞌne-míñalaꞌ, jamí gu̱xna̱-míjnálaꞌ tsiakhe̱. <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />Gu̱snga̱jmálaꞌ rí nandalaꞌ ju̱ñu̱ú xa̱bo̱ ga̱jma̱á majñu̱u̱ mbá xúgíí rí nu̱ne̱laꞌ.<verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15" />A̱ngui̱nꞌ, ikháanꞌlaꞌ ndu̱ya̱álaꞌ rí mbá guꞌwíin xa̱bi̱i Estéfa̱na̱s ñajúún tsí ginii jayu ninimbu̱únꞌ juyáá Jesús ná numbaa Akáya̱, jamí ikhii̱n ni̱xna̱xí-mijnée̱ rí mune̱-mba̱ꞌwii̱n xa̱bi̱i Ana̱ꞌlóꞌ. <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />Na̱tha̱n-jáñalaꞌ rí gu̱dxawíínlaꞌ rí nuthan xa̱bo̱ tsí jaꞌñúú xómá ikhii̱n, xúꞌkhue̱n máꞌ gu̱ne̱-mbáníílaꞌ rí nuthan xúgíin tsí nu̱mbáñúu̱ jamí nu̱ñajun ga̱jma̱á nindxúu̱n. <verse eid="1CO 16:16" /><verse number="17" style="v" sid="1CO 16:17" />Maphú nadxu a̱kui̱nꞌ rí ni̱ꞌkha̱ gáꞌyeꞌ Estéfa̱na̱s ga̱jma̱á Fortunáto̱ jamí Akáiko̱. Ikhii̱n nixniꞌ rí tsíyoo mu̱xnu̱ꞌlaꞌ ikháanꞌlaꞌ. <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />Numuu rí ikhii̱n nene̱-gagii̱ a̱kui̱nꞌ, xómá nuni̱i̱ ga̱jma̱á nindxa̱ꞌlaꞌ ikháanꞌlaꞌ. Ikhaa jngó, gu̱ya̱-makúúnlaꞌ xa̱bo̱ tsí jaꞌñúú xómá ikhii̱n.<verse eid="1CO 16:18" /></para>
  <para style="s">Tsí na̱gi̱mbíin ná i̱ꞌwá xuajen nu̱ra̱xi̱in tsí na̱gi̱mbíin ná Korínto̱</para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />Nu̱ra̱xáa̱nꞌlaꞌ mbámbá kuthuun tsí nanimbu̱únꞌ juyáá Jesús ná numbaa Ásia̱. Xúꞌkhue̱n máꞌ Akíla̱s ga̱jma̱á Prisíla̱, gajmíi̱ tsí nanimbu̱únꞌ juyáá Jesús tsí na̱gi̱mbíin ná guꞌwúu̱n, maphú nu̱ra̱xáa̱nꞌlaꞌ ga̱jma̱á numuu Táta̱. <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />Nu̱ra̱xáa̱nꞌlaꞌ mbá xúgíin a̱ngia̱nꞌlóꞌ. Gu̱ra̱xi̱-mijnáalaꞌ mbá xúgiáanꞌlaꞌ ga̱jma̱á gamaku.<verse eid="1CO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21" />Jmínu̱úꞌ ikhúúnꞌ, Páblo̱, na̱tháán ga̱jma̱á ñawúnꞌ rí na̱ra̱xáanꞌlaꞌ.<verse eid="1CO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22" />Xí mbáa tsíyoo jaꞌyoo Táta̱ Jesukrísto̱, gi̱ꞌxná-máꞌáa̱n. Xómáꞌ ikhúúnꞌ na̱tha̱nlo̱ꞌ: «¡Aya̱, Tátiáxo̱ꞌ!».<note caller="+" style="f"><char style="fr" closed="false">16.22 </char><char style="ft" closed="false">Ná i̱yi̱i̱ꞌ griégo̱ rí wayuu tima a̱jma̱ ajngáa araméo̱: «Marana tha» rí jayá ju̱ma̱ «Tátiáxo̱ꞌ, aya̱».</char></note><verse eid="1CO 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23" />Táta̱ Jesukrísto̱ gáꞌne-tsakun-rámáaꞌlaꞌ. <verse eid="1CO 16:23" /><verse number="24" style="v" sid="1CO 16:24" />Ikhúúnꞌ nandoꞌ ja̱ya̱ꞌlaꞌ mbá xúgiáanꞌlaꞌ ga̱jma̱á majñu̱u̱ Krísto̱ Jesús. Xkuaꞌnii gáꞌne.<note caller="+" style="f"><char style="fr" closed="false">16.24 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa «Xkuaꞌnii gáꞌne».</char></note><verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>