<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="REV" style="id">tcfU (67-Apoc) - Me̱ꞌpha̱a̱ Mañúwi̱ín (Malinaltepec) (sfm NVI) c22/v404</book>
  <para style="h">Rí wasngájma</para>
  <para style="toc3">Ap</para>
  <para style="toc2">Rí wasngájma</para>
  <para style="toc1">I̱yi̱i̱ꞌ rí naꞌthán rí wasngájmáá Juáán</para>
  <para style="mt1">I̱yi̱i̱ꞌ rí naꞌthán rí wasngájmáá</para>
  <para style="mt2">Juáán</para>
  <chapter number="1" style="c" sid="REV 1" />
  <para style="s">Phú gagi xtáa tsí na̱gu̱xnuu i̱yi̱i̱ꞌ ríge̱ꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1" />Ríge̱ꞌ ñajuun rí Ana̱ꞌlóꞌ nisngájmuu Jesukrísto̱, kajngó ikhaa̱ masngájmúu̱ yumbée̱ rí inu máꞌ ma̱ri̱gá. Jesukrísto̱ nixúngua̱a̱ꞌ ánje̱l drígo̱o̱ kajngó masngájmuu̱ ne̱ yumbée̱ tsí mbiꞌyuu Juáán. <verse eid="REV 1:1" /><verse number="2" style="v" sid="REV 1:2" />Xómáꞌ ikhaa̱ naꞌthée̱n rí gakon mbá xúgíí rí ndiꞌyoo̱ ga̱jma̱á numuu ajngóo Ana̱ꞌlóꞌ, jamí ga̱jma̱á numuu máꞌ Jesukrísto̱. <verse eid="REV 1:2" /><verse number="3" style="v" sid="REV 1:3" />Phú gagi xtáa tsí na̱gu̱xnuu ná inúú xa̱bo̱ ajngáa ríge̱ꞌ, rí niꞌthán Ana̱ꞌlóꞌ rí ma̱ri̱gá, jamí phú gagi máꞌ júwa̱ꞌ tsí nu̱dxawíín ne̱, xúꞌkhue̱n máꞌ nune̱-mbáníí rí ka̱ma waꞌtháán ge̱jyoꞌ, numuu rí nangiyuu máꞌ mbiꞌi rí ma̱mba̱núu ne̱.<verse eid="REV 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 1:4" />Ikhúúnꞌ ñajunꞌ Juáán, na̱ra̱xáanꞌlaꞌ mbá juwan kutháanꞌlaꞌ tsáanꞌ nanimba̱ꞌlaꞌ ju̱ya̱á Jesús ná numbaa Ásia̱.</para>
  <para style="p" vid="REV 1:4">Ana̱ꞌlóꞌ gáꞌne-tsakun-rámáaꞌlaꞌ jamí ga̱ꞌnii̱ rí ma̱juwalaꞌ tsímáá. Ikhaa̱ xtáa̱ máꞌ jayu, xtáa̱ máꞌ asndo nákhí wajyúú mbiꞌi, jamí wéje̱ máꞌ rí ma̱ꞌkhe̱e̱. Jamí ikhaa máꞌ gúne̱ mbá juwiin xe̱ꞌ mangiin, tsí júwa̱ꞌ ná inuu ꞌgí xíli̱i Ana̱ꞌlóꞌ. <verse eid="REV 1:4" /><verse number="5" style="v" sid="REV 1:5" />Xúꞌkhue̱n máꞌ gáꞌne Jesukrísto̱ mangaa, tsí nasngájma rí gakon, tsí ginii jayu ndiyáa mbiꞌyuu, jamí tsí naꞌthán-ñájúún mbá xúgíin thúngaa ná numbaa ríge̱ꞌ. Jesukrísto̱ nandoo jaꞌyalóꞌ jamí neꞌne-jríñáa̱ꞌlóꞌ ná awúun aꞌkhánlóꞌ ga̱jma̱á majñu̱u̱ iꞌdiuu̱ rí ni̱ga̱díí nákhí nijáñuu̱. <verse eid="REV 1:5" /><verse number="6" style="v" sid="REV 1:6" />Xúꞌkhue̱n máꞌ niꞌnii̱ rí ma̱nindxa̱ꞌlóꞌ thúngaa jamí rí ma̱nindxa̱ꞌlóꞌ dxakuun tsí nu̱ñajun ná inuu Ana̱ꞌlóꞌ, tsí ñajuun máꞌ Anu̱u̱ ikhaa̱. A̱gu̱ma-mba̱a̱ i̱ndo̱ó máꞌ Jesukrísto̱ jamí a̱gi̱ꞌdoo̱ mbá xúgíí tsiakhe̱ jámuu mbiꞌi. Xkuaꞌnii gáꞌne.<verse eid="REV 1:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="REV 1:7" />¡Gu̱ya̱xe̱laꞌ, ná inuu du̱u̱n na̱ꞌkha̱ Krísto̱!</para>
  <para style="q" vid="REV 1:7">Mbá xúgíin xa̱bo̱ numbaa mbuyáa̱,</para>
  <para style="q" vid="REV 1:7">asndo tsí ni̱ru̱wa̱nꞌ xuyuu̱ mangiin.</para>
  <para style="q" vid="REV 1:7">Mbá xúgíí xuajen numbaa mu̱mbi̱ya̱ꞌ-jínúú xa̱bo̱ jamí ma̱tájwíin a̱kuíi̱n ga̱jma̱á numuu̱.</para>
  <para style="q" vid="REV 1:7">Phú gakon rí xkuaꞌnii ma̱ri̱gá. Xkuaꞌnii gáꞌne.<verse eid="REV 1:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8" />Xáꞌnii iꞌthán Táta̱ Ana̱ꞌlóꞌ: «Ikhúúnꞌ ñajunꞌ xómá tsina Álfa̱ jamí xómá tsina Oméga̱, tsí na̱gi̱ꞌdu̱u̱n-muu jamí tsí ndámba̱wóo.<note caller="+" style="f"><char style="fr" closed="false">1.8 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «tsí na̱gi̱ꞌdu̱u̱n-muu jamí tsí ndámba̱wóo».</char></note> Ikhúúnꞌ ñajunꞌ tsí xtáa̱ máꞌ jayu, tsí xtáa̱ máꞌ asndo nákhí wajyúú mbiꞌi, jamí wéje̱ máꞌ rí ma̱ꞌkha. Ikhúúnꞌ gúꞌdo̱ꞌ mbá xúgíí tsiakhe̱».<verse eid="REV 1:8" /></para>
  <para style="s">Juáán ndaꞌyoo mbáa tsí xómá A̱dée Xa̱bo̱ Numbaa jaꞌnii</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9" />Ikhúúnꞌ ñajunꞌ dxájwalaꞌ Juáán jamí ikháanꞌ ñajwanlaꞌ a̱ngui̱nꞌ ná majñu̱u̱ jamínu̱ꞌ, xúꞌkhue̱n máꞌ ñajwanlóꞌ xa̱bo̱ tsí naꞌthán-ñájúún Ana̱ꞌlóꞌ jamí mbéꞌtháán guáꞌdáálóꞌ ski̱yu̱u̱ꞌ Jesukrísto̱ kajngó ma̱ꞌnga̱ꞌlóꞌ inuu jamínu̱ꞌ. Ga̱jma̱á numuu rí na̱tha̱n-ráꞌalo̱ꞌ ajngáa rawuun Ana̱ꞌlóꞌ jamí ga̱jma̱á numuu Jesukrísto̱, xtáálo̱ꞌ ná Pátmo̱s, mbaa rí kua̱ꞌa̱n ná awúun iya a̱pha̱. <verse eid="REV 1:9" /><verse number="10" style="v" sid="REV 1:10" />Mbá mbiꞌi rí jaꞌyoo Táta̱, Xu̱u̱ꞌ Ana̱ꞌlóꞌ neꞌne asndo xó rí ndi̱yo̱o̱ inu-mbiꞌíí wáa jaꞌnii, a̱ꞌkhue̱n ni̱dxawuun ná tsu̱du̱ꞌ mbá a̱ꞌwá rí phú gakhe̱ niwán, asndo xómá a̱ꞌwóo ajwa̱nꞌ e̱ꞌmbi jaꞌnii. <verse eid="REV 1:10" /><verse number="11" style="v" sid="REV 1:11" />Xáꞌnii niꞌthínꞌ a̱ꞌwá rúꞌkhue̱n: «Ikhúúnꞌ ñajunꞌ xómá tsina Álfa̱ jamí xómá tsina Oméga̱, tsí ginii jayu jamí tsí nda̱wa̱á jayu.<note caller="+" style="f"><char style="fr" closed="false">1.11 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «Ikhúúnꞌ ñajunꞌ xómá tsina Álfa̱ jamí xómá tsina Oméga̱, tsí ginii jayu jamí tsí nda̱wa̱á jayu».</char></note> Aratháán ná inuu i̱yi̱i̱ꞌ rí nathayáá, jamí ataxúꞌma ne̱ ná inúú mbá juwan kuthuun tsí nanimbu̱únꞌ juyeꞌ ná numbaa Ásia̱, mbá juwan xuajen: Éfe̱so̱, Esmírna̱, Pérga̱mo̱, Tiatíra̱, Sárdi̱s, Filadélfia̱ jamí Laodiséa̱».<verse eid="REV 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12" />Ído̱ nituꞌúúnlo̱ꞌ kajngó mba̱yo̱o̱ tsáa ñajuun tsí naꞌthínꞌlo̱ꞌ, a̱ꞌkhue̱n ndi̱yo̱o̱ wájun mbá juwan ajwa̱nꞌ mo̱jmo̱ꞌ ná natráma agu. <verse eid="REV 1:12" /><verse number="13" style="v" sid="REV 1:13" />Ná majñu̱u̱ wájun ajwa̱nꞌ rí natráma agu, ikhín ndi̱yo̱o̱ wéje̱ mbáa tsí xómá A̱dée Xa̱bo̱ Numbaa jaꞌnii. Júwuu̱n mbá xtíin mbijwa̱ꞌ rí na̱ga̱nú asndo ná aphuu nakhúu̱ jamí ja̱rnga̱xto̱o̱ mbá xtíin rí giaxu̱u̱ ajwa̱nꞌ mo̱jmo̱ꞌ ná xo̱xto̱o̱. <verse eid="REV 1:13" /><verse number="14" style="v" sid="REV 1:14" />Rí tsu̱u̱n idxu̱u̱ miꞌxá mbá jayu xómá mogo̱, o xómá idi ngúwán rí na̱ga̱taa ná inuu júba̱ mbo̱ꞌ. Rí iduu̱ nambiꞌi-taꞌa mi̱ndaꞌkho xómá ri̱ꞌyu̱u̱ agu. <verse eid="REV 1:14" /><verse number="15" style="v" sid="REV 1:15" />Rí nakhúu̱, maña̱ꞌ mbá jayu xómá ajwa̱nꞌ rí ni̱kú nigájna̱a ná awúun agu. Rí a̱ꞌwóo̱ gakhe̱ mi̱ndaꞌkho iwán xómá iwán mbaꞌa xtangaya mba̱ꞌwo̱. <verse eid="REV 1:15" /><verse number="16" style="v" sid="REV 1:16" />Ná ñawún mújúu̱n jaguu̱n mbá juwiin a̱ꞌgua̱án, jamí ná rawuu̱n nagájnuu mbá chíde̱ xíni rí a̱jma̱ rawuun. Rí inuu̱, mambiꞌi-taꞌa xómá nambiꞌi-taꞌaa a̱kha̱ꞌ ído̱ rí wakha̱ꞌ niníí jayu.<verse eid="REV 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 1:17" />Ído̱ ndi̱yo̱o̱lo̱ꞌ, ni̱xpa̱tríga̱-mina̱ꞌ mbayíí ná wíji̱i̱, asndo xó rí nijáñuꞌ máꞌ jaꞌnii. Xómáꞌ ikhaa̱ nixkrámúu̱ ga̱jma̱á ñawún mújúu̱n jamí niꞌthínꞌ: «Ma̱xámíñaaꞌ. Ikhúúnꞌ ñajunꞌ tsí ginii jayu jamí tsí nda̱wa̱á jayu. <verse eid="REV 1:17" /><verse number="18" style="v" sid="REV 1:18" />Ikhúúnꞌ ñajunꞌ tsí xtáá nda̱ya̱ jayu. Ikhúúnꞌ ñajunꞌ tsí nijáñuu, xómáꞌ xúge̱ꞌ rá xtáá nda̱ya̱lo̱ꞌ jámuu. Xkuaꞌnii gáꞌne.<note caller="+" style="f"><char style="fr" closed="false">1.18 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí na̱nguá iꞌthán «Xkuaꞌnii gáꞌne».</char></note> Jamí gúꞌdo̱ꞌlo̱ꞌ tsiakhe̱ inuu tsiakhe̱ rí na̱gu̱díin xa̱bo̱ jamí inuu iñá-wajíín.<verse eid="REV 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 1:19" />»Aratháán rí nithayáá: ikhaa rí naríga̱ xúge̱ꞌ jamí rí ma̱ri̱gá nda̱wa̱á. <verse eid="REV 1:19" /><verse number="20" style="v" sid="REV 1:20" />Ikhúúnꞌ ma̱tha̱a̱nꞌ dí ñajuun iyoo gáꞌthán rí ríga̱ ngu̱ꞌwo̱o̱ nithayáá: Mbá juwiin a̱ꞌgua̱án tsí nithañúú ná ñawún mújúnꞌ, ikhiin tsúꞌkhue̱n ñajúún mbá juwiin ánje̱l tsí nu̱ña̱wu̱ún mbá juwan kuthuun tsí nanimbu̱únꞌ juyeꞌ. Jamí mbá juwan ajwa̱nꞌ mo̱jmo̱ꞌ ná natráma agu rí nithayáá, ikhaa rúꞌkhue̱n ñajúún mbá juwan kuthuun tsí nanimbu̱únꞌ juyeꞌ.<verse eid="REV 1:20" /></para>
  <chapter eid="REV 1" />
  <chapter number="2" style="c" sid="REV 2" />
  <para style="s">Ajngáa rí na̱ka̱ ná inúú tsí nanimbu̱únꞌ juyáá Jesús ná xuajen Éfe̱so̱</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1" />»Aratháán ajngáa ríge̱ꞌ ná inuu i̱yi̱i̱ꞌ ma̱ꞌga inuu ánje̱l tsí na̱ña̱wu̱ún tsí nanimbu̱únꞌ juyeꞌ ná xuajen Éfe̱so̱. Xáꞌnii iꞌthán tsí gíꞌdiin mbá juwiin a̱ꞌgua̱án ná ñawún mújúun jamí ngroꞌoo ná majñu̱u̱ mbá juwan ajwa̱nꞌ mo̱jmo̱ꞌ ná natráma agu: <verse eid="REV 2:1" /><verse number="2" style="v" sid="REV 2:2" />Ikhúúnꞌ na̱ne̱-núwíinlo̱ꞌ ñajun rí nathane̱, rí natiajun mi̱ndaꞌkho jamí tsíꞌne níꞌnga̱a̱ꞌ. Nda̱yo̱o̱ máꞌ rí tsíꞌkho̱ a̱kia̱anꞌ ene̱ tsí ra̱májíin. Xúꞌkhue̱n máꞌ ni̱tra̱jwa̱ꞌ numúú tsí nuthan rí xa̱bo̱ tsí waxúngui̱inꞌ neꞌne Ana̱ꞌlóꞌ ñajúún, jamí nithayáá rí mi̱nduwii̱n. <verse eid="REV 2:2" /><verse number="3" style="v" sid="REV 2:3" />Phú nitamíni̱í jamí phú mba̱a̱ a̱kia̱anꞌ neꞌne, xúꞌkhue̱n máꞌ phú nitiajun<note caller="+" style="f"><char style="fr" closed="false">2.3 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «xúꞌkhue̱n máꞌ phú nitiajun».</char></note> numuu rí nandaaꞌ xtayoꞌ jamí tsíꞌne wabaa a̱kia̱anꞌ.<verse eid="REV 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 2:4" />»I̱ndo̱ó máꞌ numuu rí ríga̱ mbóó rí tsíni̱gu̱ꞌ ithane̱: rí nánguá iyalaꞌ ju̱ya̱-mijnálaꞌ xómá nákhí rí ginii. <verse eid="REV 2:4" /><verse number="5" style="v" sid="REV 2:5" />Ikhaa jngó, ¡ga̱rmáꞌáan a̱kia̱anꞌ dí ñajuun rí nitatsíñáá-rathane̱! A̱thanga̱a a̱kia̱anꞌ jamí atagíꞌma̱a ma̱tha̱ne̱ rí nithane̱ nákhí ginii. Xí na̱nguá ithanga̱a a̱kia̱anꞌ rá, a̱ꞌkhue̱n rí ma̱ꞌgá máꞌ nacha̱ gáxpa̱thíínlo̱ꞌ jamí ma̱rígúulo̱ꞌ ajwa̱nꞌ dríga̱a̱ꞌ ná na̱rigu agu. <verse eid="REV 2:5" /><verse number="6" style="v" sid="REV 2:6" />Xúꞌkhue̱n máꞌ ríga̱ mbá rí na̱ni̱gu̱ꞌ ithane̱: rí tsíyaaꞌ xtayáá rí nune̱ xa̱bi̱i Nikolás, ikhaa máꞌ rí tsíyoꞌ ja̱yo̱o̱ mangúúnꞌ.<verse eid="REV 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 2:7" />»Tsí gíꞌdoo ñaꞌwuun, gadxawuu̱n rí naꞌthán Xu̱u̱ꞌ Ana̱ꞌlóꞌ, rí naꞌthúu̱n mbámbá kuthuun tsí nanimbu̱únꞌ juyáá Jesús. Tsí ma̱ꞌngo̱o̱, ma̱xnu̱u̱ mi̱khui̱i̱ xndúu ixe̱ rí naꞌne rí ma̱ju̱wá jámuu xa̱bo̱, ikhaa rí wéje̱ ná ti̱kua̱pho̱o̱ mbayuu Ana̱ꞌlóꞌ rí phú mitsaan.<verse eid="REV 2:7" /></para>
  <para style="s">Ajngáa rí na̱ka̱ inúú tsí nanimbu̱únꞌ juyáá Jesús ná xuajen Esmírna̱</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8" />»Aratháán ajngáa ríge̱ꞌ ná inuu i̱yi̱i̱ꞌ ma̱ꞌga inuu ánje̱l tsí na̱ña̱wu̱ún tsí nanimbu̱únꞌ juyeꞌ ná xuajen Esmírna̱. Xáꞌnii iꞌthán tsí ginii jayu jamí nda̱wa̱á jayu, tsí nijáñuu jamí ndiyáa mbiꞌyuu: <verse eid="REV 2:8" /><verse number="9" style="v" sid="REV 2:9" />Ikhúúnꞌ na̱ne̱-núwíinlo̱ꞌ ñajun rí nathane̱, jamí nda̱yo̱o̱lo̱ꞌ rí natamíni̱í xúge̱ꞌ, xúꞌkhue̱n máꞌ nda̱yo̱o̱lo̱ꞌ rí mingínááꞌ, maske máꞌ ná awúun a̱kia̱anꞌ gatíí rí máján. Nda̱yo̱o̱ máꞌ rí nuthan xkawe̱ꞌ numaaꞌ tsí na̱ju̱mu̱ú rí xa̱bo̱ judío̱ ñajúún, maske máꞌ ra̱ꞌkhá ikhaa ñajúu̱n, rí xa̱bo̱ tsí na̱gi̱mbíin ga̱jma̱á numuu Satanás ñajúu̱n. <verse eid="REV 2:9" /><verse number="10" style="v" sid="REV 2:10" />Ma̱xámíñaaꞌ nitháan gáꞌne rí inu ma̱ꞌkha̱ ma̱ta̱míni̱í. Wapha máꞌ i̱tha̱a̱nꞌlo̱ꞌ rí mbá tikhuun tsí ikháanꞌlaꞌ magóó géjwa̱nꞌ gáꞌne gixa̱a̱, kajngó mba̱ꞌyoo̱ xí gakon rí nanimba̱ꞌlaꞌ ju̱yo̱ꞌ, jamí phú mu̱míni̱ílaꞌ awúun rí mbá gu̱wa̱ꞌ mbiꞌi. Ga̱ꞌne jañii a̱kia̱anꞌ xtayoꞌ asndo rí ma̱ja̱ñáaꞌ ga̱jma̱á numuꞌ, jamí ikhúúnꞌ ma̱xna̱a̱ꞌ ma̱ra̱xtaa jámuu.<verse eid="REV 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 2:11" />»Tsí gíꞌdoo ñaꞌwuun, gadxawuu̱n rí naꞌthán Xu̱u̱ꞌ Ana̱ꞌlóꞌ, rí naꞌthúu̱n mbámbá kuthuun tsí nanimbu̱únꞌ juyáá Jesús. Tsí ma̱ꞌngu̱ún, nda̱a̱ nitháan rí ma̱gíꞌníi̱ gáꞌne tsiakhe̱ rí na̱gu̱díin xa̱bo̱ rí riajma̱ nothon.<verse eid="REV 2:11" /></para>
  <para style="s">Ajngáa rí na̱ka̱ inúú tsí nanimbu̱únꞌ juyáá Jesús ná xuajen Pérga̱mo̱</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12" />»Aratháán ajngáa ríge̱ꞌ ná i̱yi̱i̱ꞌ ma̱ꞌga inuu ánje̱l tsí na̱ña̱wu̱ún tsí nanimbu̱únꞌ juyeꞌ ná xuajen Pérga̱mo̱. Xáꞌnii iꞌthán tsí gíꞌdoo chíde̱ xíni rí a̱jma̱ rawuun: <verse eid="REV 2:12" /><verse number="13" style="v" sid="REV 2:13" />Ikhúúnꞌ na̱ne̱-núwíinlo̱ꞌ ñajun rí nathane̱, jamí nda̱yo̱o̱lo̱ꞌ rí ikháánꞌ xtaa ná naꞌthán-ñájun Satanás. Maske máꞌ xkuaꞌnii rá, jaꞌnii máꞌ nanimba̱a̱ꞌ xtayoꞌ, ni máꞌ tára̱tha̱n rí tsíthane̱-nuwúún nákhí ni̱xi̱ya̱a̱ Antípa̱s, tsí mbá jañii a̱kui̱in ninimbo̱o̱ꞌ jaꞌyeꞌ ná xuajen rí xtáa̱ Satanás. <verse eid="REV 2:13" /><verse number="14" style="v" sid="REV 2:14" />I̱ndo̱ó máꞌ numuu rí ríga̱ mbá tikhu rí tsíni̱gu̱ꞌ ithane̱: rí nitatsíñáá rí ma̱ju̱wá ná xtaa a̱ꞌkhue̱n tsí tsíñúú gúni̱ꞌñáá gisngáá drígo̱o̱ Baláám, tsí nisngróꞌoo Balák rí ma̱ꞌne rí mune̱ aꞌkhán i̱ji̱in Israél. Balák niꞌthúún i̱ji̱in Israél rí ma̱goo mu̱phi̱i̱ ganitsu rí kixnáxe̱ ná inúú tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún jamí rí mubúu̱n gajmíi̱ xa̱bo̱ tsí túya̱a̱. <verse eid="REV 2:14" /><verse number="15" style="v" sid="REV 2:15" />Xúꞌkhue̱n máꞌ mangaa, xtaꞌdiin ná xtaa a̱ꞌkhue̱n tsí tsíñúú gúni̱ꞌñáá gisngáá drígu̱ún xa̱bi̱i Nikolás, gisngáá rí ikhúúnꞌ naxúwu̱nꞌ eꞌne.<note caller="+" style="f"><char style="fr" closed="false">2.15 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «gisngáá rí ikhúúnꞌ naxúwu̱nꞌ eꞌne».</char></note> <verse eid="REV 2:15" /><verse number="16" style="v" sid="REV 2:16" />Ikhaa jngó, a̱thanga̱a a̱kia̱anꞌ. Jamí xí na̱nguá rá, ma̱ꞌkha máꞌ nacha̱ ná xtaa kajngó ma̱ne̱ gajmíꞌ xa̱bi̱i Nikolás ga̱jma̱á ski̱yu̱u̱ꞌ ajngáa rí nagájnuu ná rawunꞌ, rí xómá chíde̱ jaꞌnii.<verse eid="REV 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 2:17" />»Tsí gíꞌdoo ñaꞌwuun, gadxawuu̱n rí naꞌthán Xu̱u̱ꞌ Ana̱ꞌlóꞌ, rí naꞌthúu̱n mbámbá kuthuun tsí nanimbu̱únꞌ juyáá Jesús. Tsí ma̱ꞌngo̱o̱, ma̱xnu̱u̱ ganitsu rí mbiꞌyuu maná mi̱khui̱i̱, rí gúꞌdo̱ꞌ ná ngu̱ꞌwa̱. Xúꞌkhue̱n máꞌ ma̱xnu̱u̱ mbá itsí miꞌxá lájwíin ná waꞌtháán mbá mbiꞌyuu rí nuxe̱ꞌ, rí ndawa̱a̱ tsí eꞌne-nuwiin, rí i̱ndo̱ó máꞌ tsí na̱grui̱gú ne̱.<verse eid="REV 2:17" /></para>
  <para style="s">Ajngáa rí na̱ka̱ inúú tsí nanimbu̱únꞌ juyáá Jesús ná xuajen Tiatíra̱</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18" />»Aratháán ajngáa ríge̱ꞌ ná i̱yi̱i̱ꞌ ma̱ꞌga inuu ánje̱l tsí na̱ña̱wu̱ún tsí nanimbu̱únꞌ juyeꞌ ná xuajen Tiatíra̱. Xáꞌnii iꞌthán A̱dée Ana̱ꞌlóꞌ, tsí nambiꞌi-taꞌa mi̱ndaꞌkho iduu xómá ri̱ꞌyu̱u̱ agu jamí nambiꞌi-taꞌa nakhúu xómá ajwa̱nꞌ rí ni̱gu̱ma-tsaꞌtsa inuu: <verse eid="REV 2:18" /><verse number="19" style="v" sid="REV 2:19" />Ikhúúnꞌ na̱ne̱-núwíinlo̱ꞌ ñajun rí nathane̱. Nda̱yo̱o̱ mújúnꞌ máꞌ rí nandaaꞌ xtañúú a̱ngia̱anꞌ jamí táta̱tsi̱ꞌñáá rí nanimba̱a̱ꞌ xtayoꞌ, xúꞌkhue̱n máꞌ tsítatsíñáá rí nathane̱-mbi̱in i̱ꞌwíin jamí na̱ꞌnga̱a̱ꞌ inuu jamínu̱ꞌ. Nda̱yo̱o̱ máꞌ mangaa rí i̱tha̱án máꞌ mbaꞌa rí nathane̱ xúge̱ꞌ xó rí nákhí ginii.<verse eid="REV 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 2:20" />»I̱ndo̱ó máꞌ numuu rí ríga̱ mbá tikhu<note caller="+" style="f"><char style="fr" closed="false">2.20 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa «mbá tikhu».</char></note> rí tsíni̱gu̱ꞌ ithane̱: natatsíñáá rí Jesabél, a̱ꞌgo̱ tsí naꞌthán rí na̱gu̱wíjnga̱a ajngóo Ana̱ꞌlóꞌ, maꞌsngúún yumbéꞌ. Ga̱jma̱á majñu̱u̱ rí naꞌsngáa̱ naꞌne-rájíi̱n yumbéꞌ rí mubúu̱n gajmíi̱ xa̱bo̱ tsí túya̱a̱, jamí naꞌthúu̱n rí mu̱phi̱i̱ ganitsu rí kixnáxe̱ ná inúú tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún. <verse eid="REV 2:20" /><verse number="21" style="v" sid="REV 2:21" />Ikhúúnꞌ ni̱xnu̱u̱ máꞌ mbiꞌi rí ma̱thanga̱a a̱kuii̱n, xómáꞌ ikhaa̱ tsíyoo̱ gáthanga̱a a̱kuii̱n jamí tsíyoo̱ gániñuu̱ rí nabóo̱ gajmíi̱ mbaꞌiin xa̱bo̱. <verse eid="REV 2:21" /><verse number="22" style="v" sid="REV 2:22" />Ikhaa jngó, ikhúúnꞌ ma̱ne̱ rí mbayóo̱ mbá nandii rí gakhi̱i̱ mi̱ndaꞌkho. Jamí tsí nubúún ga̱jma̱á nindxu̱u̱ ikhaa̱, ma̱ne̱ rí mu̱míníi̱ mi̱ndaꞌkho, xí tsíni̱ñáa̱ rí ni̱ma̱ñúu̱ neꞌne a̱ꞌgo̱ tsúꞌkhue̱n. <verse eid="REV 2:22" /><verse number="23" style="v" sid="REV 2:23" />Xómáꞌ i̱jii̱n, ma̱ne̱ rí mbañúu̱ mbá nandii rí ma̱gu̱díi̱n. A̱ꞌkhue̱n mbá xúgíí kuthuun tsí nanimbu̱únꞌ juyáá Jesús mbuyáá rí ikhúúnꞌ na̱ne̱-núwíin rí na̱ju̱mu̱u̱ jamí nda̱yo̱o̱ rí nandoo gáꞌne mbámbáa xa̱bo̱, xúꞌkhue̱n máꞌ ma̱xnu̱u̱ mbámbáa xómá jaꞌyoo ñajun rí neꞌne.<verse eid="REV 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 2:24" />»Xómáꞌ i̱ꞌwáanꞌlaꞌ tsáanꞌ juwalaꞌ ná xuajen Tiatíra̱, ra̱guáꞌdáálaꞌ gisngáá drígo̱o̱ a̱ꞌgo̱ tsúꞌkhue̱n. Ni máꞌ túne̱-nuwiinlaꞌ rí mbá tikhuun nuxna mbiꞌíí “rí me̱jno̱ꞌ na̱ma̱ñuu Satanás”. Ikhaa jngó náxáxna̱-ngáwalaꞌ máꞌ i̱mba̱ rí mu̱ne̱laꞌ. <verse eid="REV 2:24" /><verse number="25" style="v" sid="REV 2:25" />I̱ndo̱ó máꞌ na̱tha̱nꞌlaꞌ rí mu̱xúni̱ꞌñáálaꞌ rí guáꞌdáálaꞌ xúge̱ꞌ, asndo mbiꞌi rí ma̱ꞌkhalo̱ꞌ.<verse eid="REV 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="REV 2:26" />»Tsí ma̱ꞌngo̱o̱ jamí ma̱ꞌne-mbánuu rí nandoꞌ ikhúúnꞌ asndo rí ma̱mbá numbaa, ma̱xnu̱u̱ tsiakhe̱ rí maꞌthán-ñájúu̱n xa̱bo̱ ná mbá xúgíí numbaa. <verse eid="REV 2:26" /><verse number="27" style="v" sid="REV 2:27" />Jamí “maꞌthán-ñájúu̱n ga̱jma̱á nixí ajwa̱nꞌ. Maxpígu-makii̱n xómá daan ju̱ba̱ꞌ”. Xómá rí ikhúúnꞌ mangúúnꞌ ni̱gruígú tsiakhe̱ neꞌne Tátéꞌ. <verse eid="REV 2:27" /><verse number="28" style="v" sid="REV 2:28" />Xúꞌkhue̱n máꞌ ma̱xnii̱lo̱ꞌ a̱ꞌgua̱án tsí na̱ꞌkha̱ miꞌcha̱.<verse eid="REV 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="REV 2:29" />»Tsí gíꞌdoo ñaꞌwuun, gadxawuu̱n rí naꞌthán Xu̱u̱ꞌ Ana̱ꞌlóꞌ, rí naꞌthúu̱n mbámbá kuthuun tsí nanimbu̱únꞌ juyáá Jesús.<verse eid="REV 2:29" /></para>
  <chapter eid="REV 2" />
  <chapter number="3" style="c" sid="REV 3" />
  <para style="s">Ajngáa rí na̱ka̱ inúú tsí nanimbu̱únꞌ juyáá Jesús ná xuajen Sárdi̱s</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1" />»Aratháán ajngáa ríge̱ꞌ ná i̱yi̱i̱ꞌ ma̱ꞌga inuu ánje̱l tsí na̱ña̱wu̱ún tsí nanimbu̱únꞌ juyeꞌ ná xuajen Sárdi̱s. Xáꞌnii iꞌthán tsí gíꞌdiin mbá juwiin xe̱ꞌ drígo̱o̱ Ana̱ꞌlóꞌ jamí juwiin a̱ꞌgua̱án: Ikhúúnꞌ na̱ne̱-núwíinlo̱ꞌ ñajun rí nathane̱. Maske máꞌ phú mbaꞌiin xa̱bo̱ nuthan rí xtaa nathaya, xómáꞌ ikhúúnꞌ nda̱yo̱o̱lo̱ꞌ rí asndo xó rí nijáñaaꞌ máꞌ jaꞌnii. <verse eid="REV 3:1" /><verse number="2" style="v" sid="REV 3:2" />Araxu̱unꞌ jamí araxná-mina̱aꞌ tsiakhe̱ rí ma̱tha̱ne̱-májáan wáa ñajun rí inu máꞌ xtaa rí ma̱ta̱tsi̱ꞌñáá-rathane̱, numuu nda̱yo̱o̱ rí na̱nguá xóó káxe̱ ñajun rí nathane̱ ná inuu Ana̱ꞌlóꞌ. <verse eid="REV 3:2" /><verse number="3" style="v" sid="REV 3:3" />Ikhaa jngó, ga̱rmáꞌáan a̱kia̱anꞌ dí ñajuun rí ni̱tri̱gú jamí nitadxawíín. Athane̱-mbáníí ne̱ jamí ga̱thanga̱a a̱kia̱anꞌ. Xí tsíraxu̱unꞌ, ma̱ꞌkha gáxpríguáaꞌ, jamí asndo ni ma̱xátha̱ya̱á ído̱ gáꞌkha xómá eꞌne mbáa ku̱ꞌwá rí nda̱a̱ ajngóo i̱ꞌkha̱.<verse eid="REV 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 3:4" />»Maske máꞌ xúꞌkhue̱n, júwa̱ꞌ ná xuajen Sárdi̱s a̱ꞌkhue̱n mbá tikhuun xa̱bo̱ tsí túne̱-maꞌchíí xtíñúú. Ikhiin tsúꞌkhue̱n jaꞌñúú rí ma̱júwúún xtíin miꞌxá jamí ma̱ngrigúu̱n ga̱jma̱á nindxu̱ꞌ ikhúúnꞌ. <verse eid="REV 3:4" /><verse number="5" style="v" sid="REV 3:5" />Tsí ma̱ꞌngo̱o̱, majúwuu̱n xtíin miꞌxá. Ni miꞌtsú ma̱xárngudi̱i mbiꞌyuu̱ ná i̱yi̱i̱ꞌ rí tima mbiꞌñúú tsí nduya jámuu, xúꞌkhue̱n máꞌ ma̱tha̱n ná inuu Tátéꞌ rí xa̱bi̱ꞌ ñajuu̱n jamí ma̱tha̱n rúꞌkhue̱n ná inúú ánje̱l drígo̱o̱ Tátéꞌ mangaa.<verse eid="REV 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 3:6" />»Tsí gíꞌdoo ñaꞌwuun, gadxawuu̱n rí naꞌthán Xu̱u̱ꞌ Ana̱ꞌlóꞌ, rí naꞌthúu̱n mbámbá kuthuun tsí nanimbu̱únꞌ juyáá Jesús.<verse eid="REV 3:6" /></para>
  <para style="s">Ajngáa rí na̱ka̱ inúú tsí nanimbu̱únꞌ juyáá Jesús ná xuajen Filadélfia̱</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7" />»Aratháán ajngáa ríge̱ꞌ ná i̱yi̱i̱ꞌ ma̱ꞌga inuu ánje̱l tsí na̱ña̱wu̱ún tsí nanimbu̱únꞌ juyeꞌ ná xuajen Filadélfia̱. Xáꞌnii iꞌthán Tsí Jaꞌwii, Tsí Kuwiin, tsí jayá ñawúun guꞌwóo thúngaa Dabíd. Ído̱ rí ikhaa̱ narmáꞌthoo̱ nimbáa tsíꞌngo̱o̱ gárugoo, jamí ído̱ rí narugoo̱ nimbáa tsíꞌngo̱o̱ gármáꞌthoo: <verse eid="REV 3:7" /><verse number="8" style="v" sid="REV 3:8" />Ikhúúnꞌ na̱ne̱-núwíinlo̱ꞌ ñajun rí nathane̱. Ikhaa jngó, athayáá rí ná inaaꞌ a̱ꞌkhue̱n ni̱ni̱ꞌñúu ja̱ma̱ꞌtha mbá xkrugua rí nimbáa ma̱xáꞌngo̱o̱ gárugua̱a. Nda̱yo̱o̱ máꞌ rí maske máꞌ na̱nguá mba̱a̱ tsiakhe̱ xtaꞌdáá, nathane̱-mbáníí rí na̱tha̱a̱nꞌ jamí nirathán ná inúú xa̱bo̱ rí xa̱bi̱ꞌ ñajwaanꞌ. <verse eid="REV 3:8" /><verse number="9" style="v" sid="REV 3:9" />Atiaxe̱ lá rí ma̱ñu̱ú tsí nune̱-nduwa rí xa̱bo̱ judío̱ ñajúún, tsí na̱gi̱mbíin ga̱jma̱á numuu Satanás. Ikhúúnꞌ ma̱ne̱ rí ma̱guwée̱ mu̱sma̱ti̱gúu̱n inaaꞌ kajngó mbuyáa̱ rí phú nandoꞌ ja̱ya̱a̱ꞌ.<verse eid="REV 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 3:10" />»Ga̱jma̱á numuu rí ikháánꞌ nithane̱-mbáníí ajngóꞌ rí ni̱tha̱a̱nꞌ, rí ma̱riajún gúkuáaꞌ, ikhaa jngó ikhúúnꞌ mangúúnꞌ ma̱ña̱wa̱a̱nꞌ ído̱ ma̱ga̱nú mbiꞌi rí ma̱ꞌkha̱ jamínu̱ꞌ inúú mbá xúgíin xa̱bo̱ numbaa. Jamínu̱ꞌ rúꞌkhue̱n masngájmii tsí gakon rí nanimbu̱únꞌ juyeꞌ. <verse eid="REV 3:10" /><verse number="11" style="v" sid="REV 3:11" />Ma̱ꞌkha máꞌ wapha, ikhaa jngó na̱tha̱a̱nꞌ rí a̱ra̱tuun xa̱ꞌ rí xtaꞌdáá máꞌ. A̱ꞌkhue̱n rí nimbáa ma̱xárígú-jáꞌyáaꞌ rí jaꞌyoo ma̱tri̱gú numuu rí ni̱ꞌnga̱a̱ꞌ. <verse eid="REV 3:11" /><verse number="12" style="v" sid="REV 3:12" />Tsí ma̱ꞌngo̱o̱, ikhúúnꞌ ma̱ne̱ rí ikhaa̱ ma̱nindxu̱u̱ xómá xi̱gu̱u̱ guꞌwá dxákuiin Anu̱ꞌ, jamí ni miꞌtsú ma̱xágájnaa̱ ikhín. Jamí ma̱tháánlo̱ꞌ mbiꞌyuu Anu̱ꞌ jamí mbiꞌyuu máꞌ xuajñuu Anu̱ꞌ ná jédoo xa̱bo̱ tsúꞌkhue̱n. Xuajen rúꞌkhue̱n ñajuun Jerusalén rí nuxe̱ꞌ, rí na̱ga̱taa ná mikhu drígo̱o̱ Anu̱ꞌ. Xúꞌkhue̱n máꞌ ma̱tháán mbiꞌyuꞌ rí nuxe̱ꞌ ná jédoo̱, kajngó ma̱kujma rí xa̱bi̱ꞌ ñajuu̱n.<verse eid="REV 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 3:13" />»Tsí gíꞌdoo ñaꞌwuun, gadxawuu̱n rí naꞌthán Xu̱u̱ꞌ Ana̱ꞌlóꞌ, rí naꞌthúu̱n mbámbá kuthuun tsí nanimbu̱únꞌ juyáá Jesús.<verse eid="REV 3:13" /></para>
  <para style="s">Ajngáa rí na̱ka̱ inúú tsí nanimbu̱únꞌ juyáá Jesús ná xuajen Laodiséa̱</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14" />»Aratháán ajngáa ríge̱ꞌ ná i̱yi̱i̱ꞌ ma̱ꞌga inuu ánje̱l tsí na̱ña̱wu̱ún tsí nanimbu̱únꞌ juyeꞌ ná xuajen Laodiséa̱. Xáꞌnii iꞌthán tsí ñajuun Xkuaꞌnii gáꞌne, tsí ndiꞌyoo jamí jmbii, xúꞌkhue̱n máꞌ naꞌthán rí gakon, tsí ga̱jma̱á majñu̱u̱ ikhaa neꞌne-ku̱maa Ana̱ꞌlóꞌ mbá xúgíí rí ríga̱: <verse eid="REV 3:14" /><verse number="15" style="v" sid="REV 3:15" />Ikhúúnꞌ na̱ne̱-núwíinlo̱ꞌ ñajun rí nathane̱, jamí nda̱yo̱o̱lo̱ꞌ rí na̱nguá mika a̱kia̱anꞌ xtayoꞌ ni máꞌ na̱nguá nguíꞌtsín ne̱. I̱tha̱án máꞌ máján xí numuu rí mika a̱kia̱anꞌ o mbáko máꞌ xí nguíꞌtsín ne̱ mbo̱ꞌ. <verse eid="REV 3:15" /><verse number="16" style="v" sid="REV 3:16" />I̱ndo̱ó máꞌ numuu rí na̱nguá mika ni máꞌ na̱nguá nguíꞌtsín a̱kia̱anꞌ xtayoꞌ, rí wáa jayu mika ne̱, ikhaa numuu rúꞌkhue̱n ma̱xe̱ꞌ-ri̱ñáaꞌlo̱ꞌ ná rawunꞌ. <verse eid="REV 3:16" /><verse number="17" style="v" sid="REV 3:17" />Ikháánꞌ narathán: “Ikhúúnꞌ ñajunꞌ xa̱bo̱ tsí phú gíꞌdoo, mbá xúgíí gúꞌdo̱ꞌlo̱ꞌ jamí nda̱a̱ rí iꞌyóꞌlo̱ꞌ”. Tsíthayáá rí na̱nguá xtaa gagi, rí mingínááꞌ, rí nda̱a̱ rí xtaꞌdáá, rí tsífriga̱a̱ꞌ jamí tsaꞌtsáán nda̱a̱ xtíñaaꞌ. <verse eid="REV 3:17" /><verse number="18" style="v" sid="REV 3:18" />Ikhaa jngó na̱tha̱a̱nꞌlo̱ꞌ rí ma̱ra̱tse̱ ná inuꞌ ikhúúnꞌ mbá atsú ríge̱ꞌ: ajwa̱nꞌ mo̱jmo̱ꞌ rí ni̱gu̱ma-jaꞌwu̱u ná awúun agu kajngó ma̱nindxa̱a̱ꞌ xa̱bo̱ tsí phú gíꞌdoo, xtíin miꞌxá rí ma̱thu̱ꞌwáanꞌ kajngó ma̱truguáá mate̱ꞌ dríga̱a̱ꞌ, jamí thana rí ma̱ta̱xta̱jmáá idaaꞌ kajngó ma̱friga̱a̱ꞌ.<verse eid="REV 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 3:19" />»Ikhúúnꞌ na̱xprígúún jamí na̱ríñúú mbá xúgíin tsí nandoꞌ ja̱ñu̱ú. Ikhaa jngó, mbá jañii a̱kia̱anꞌ gátha̱ne̱ ñajun rí nathane̱ jamí ga̱thanga̱a a̱kia̱anꞌ. <verse eid="REV 3:19" /><verse number="20" style="v" sid="REV 3:20" />Atadxawíín, ikhúúnꞌ wáju̱nlo̱ꞌ ná xkrugua jamí na̱tha̱n-ráꞌalo̱ꞌ. Xí mbáa nadxawuun a̱ꞌwóꞌ jamí narmáꞌthoo̱ xkrugua, a̱ꞌkhue̱n rí ma̱to̱ꞌo̱ꞌ jamí ma̱kuéꞌtsó-añuꞌlo̱ꞌ ga̱jma̱á nindxu̱u̱.<verse eid="REV 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 3:21" />»Tsí ma̱ꞌngo̱o̱, ma̱xnu̱u̱lo̱ꞌ rí ma̱gi̱ꞌi̱i̱ maꞌthán-ñájwii̱n ga̱jma̱á nindxu̱ꞌ, xómá rí ikhúúnꞌ ni̱ꞌngo̱ꞌlo̱ꞌ jamí niꞌgúnꞌ rí ma̱tha̱n-ñájunlo̱ꞌ ga̱jma̱á nindxu̱u̱ Tátéꞌ.<verse eid="REV 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 3:22" />»Tsí gíꞌdoo ñaꞌwuun, gadxawuu̱n rí naꞌthán Xu̱u̱ꞌ Ana̱ꞌlóꞌ, rí naꞌthúu̱n mbámbá kuthuun tsí nanimbu̱únꞌ juyáá Jesús».<verse eid="REV 3:22" /></para>
  <chapter eid="REV 3" />
  <chapter number="4" style="c" sid="REV 4" />
  <para style="s">Xíli̱i Ana̱ꞌlóꞌ rí ꞌgí ná mikhuíí</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1" />Nda̱wa̱á a̱ꞌkhue̱n ni̱ya̱xe̱lo̱ꞌ mikhuíí, ikhín ndi̱yo̱o̱ ja̱ma̱ꞌtha mbá xkrugua. A̱ꞌkhue̱n ni̱dxawuun mbu̱júꞌ a̱ꞌwá rí ni̱dxawuun máꞌ ginii, ikhaa rí phú gakhe̱ niwán asndo xómá ajwa̱nꞌ e̱ꞌmbi. Ikhaa a̱ꞌwá rúꞌkhue̱n niꞌthínꞌ: «A̱tsimaaꞌ ge̱jyoꞌ kajngó ma̱snga̱jmáaꞌ rí ma̱ri̱gá nda̱wa̱á». <verse eid="REV 4:1" /><verse number="2" style="v" sid="REV 4:2" />Mbrúma máꞌ rúꞌkhue̱n Xu̱u̱ꞌ Ana̱ꞌlóꞌ neꞌne asndo xó rí ndi̱yo̱o̱ inu-mbiꞌíí wáa jaꞌnii, a̱ꞌkhue̱n ndi̱yo̱o̱ wéje̱ mbá xíli̱i thúngaa ná mikhuíí. Jamí ná inuu xíle̱ rúꞌkhue̱n ꞌgí mbáa <verse eid="REV 4:2" /><verse number="3" style="v" sid="REV 4:3" />tsí nambiꞌi-taꞌaa xómá itsí maxa rí mbiꞌyuu jáspe̱ jamí xómá itsí maña̱ꞌ rí mbiꞌyuu kornalína̱. Mbá tuaꞌáan ná wéje̱ xíli̱i thúngaa wéje̱ mbáa tu̱ka̱ya̱ꞌ, tsí nambiꞌi-taꞌaa xómá itsí maxa rí mbiꞌyuu esmerálda̱. <verse eid="REV 4:3" /><verse number="4" style="v" sid="REV 4:4" />Mbá tuaꞌáan ná wéje̱ xíli̱i thúngaa wájun i̱mbá skíñú akho̱ (24) xíli̱ín thúngaa, ná trigi̱in mbá skíñú akhu̱un xa̱bo̱ buanuu tsí júwúún xtíin miꞌxá, jamí rígu ná idxúu̱n mbá ajwa̱nꞌ gamaku rí jndi, rí ajwa̱nꞌ mo̱jmo̱ꞌ ñajuun. <verse eid="REV 4:4" /><verse number="5" style="v" sid="REV 4:5" />Ná tikhuíí wéje̱ xíli̱i thúngaa nangujwíi mbaꞌa nothon aguu rí naxpíbi, jamí phú wee nawán mbaꞌa nothon. Xúꞌkhue̱n máꞌ ná inuu wéje̱ xíli̱i thúngaa nakha mbá juwan agu, rí xómá aguu rondo̱ jaꞌnii, jamí ikhaa rúꞌkhue̱n ñajuun mbá juwiin xu̱u̱ꞌ Ana̱ꞌlóꞌ. <verse eid="REV 4:5" /><verse number="6" style="v" sid="REV 4:6" />Ikhín máꞌ ná inuu xíli̱i thúngaa ndi̱yo̱o̱ xó mbá iya a̱pha̱ rí xómá tsíꞌtsún miꞌxá jaꞌnii, nambiꞌi-taꞌa ne̱ xómá iyaniwan.</para>
  <para style="p" vid="REV 4:6">Ná tikhuíí jamí mbá nawa̱a̱ ná wéje̱ xíli̱i thúngaa ndi̱ñu̱ú mbá akhu̱un tsí nduya, tsí mbá xúgíí jayu xuñúú guáꞌdáá idúún, ná inúu̱ jamí ná tsu̱dúu̱n. <verse eid="REV 4:6" /><verse number="7" style="v" sid="REV 4:7" />Tsí ginii xómá i̱ndi̱í phuu jaꞌnii̱, tsí riajma̱a̱ xómá xede̱ jaꞌnii̱, tsí riatsíi xómá inuu xa̱bo̱ jaꞌnii inuu̱, jamí tsí riakhui̱i̱ xómá bi̱yú tsí na̱ka̱ inuu gíñá jaꞌnii̱. <verse eid="REV 4:7" /><verse number="8" style="v" sid="REV 4:8" />Mbámbáa tsí mbá akhu̱un tsí nduya guáꞌdáa̱ mbá majun xpípíi̱n. Ná tsu̱du̱u̱ jamí ná agoo xpípíi̱n guáꞌdáa̱ idúu̱n. Xúꞌkhue̱n máꞌ mbiꞌíí mbruꞌwíín nuthee̱n:</para>
  <para style="b" vid="REV 4:8" />
  <para style="q" vid="REV 4:8">«Tsí Jaꞌwii, tsí jaꞌwii, tsí jaꞌwii ñajuun Táta̱,</para>
  <para style="q" vid="REV 4:8">Ana̱ꞌlóꞌ tsí gíꞌdoo mbá xúgíí tsiakhe̱,</para>
  <para style="q" vid="REV 4:8">tsí xtáa̱ máꞌ jayu, tsí nixtáa̱ máꞌ asndo nákhí wajyúú mbiꞌi, jamí wéje̱ máꞌ rí ma̱ꞌkha̱».<verse eid="REV 4:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="REV 4:9" />Jámba̱ miꞌtsú rí mbá nákhu̱un tsí nduya, nune̱-mba̱a̱, nduya-makuíi̱ jamí nuxnaa̱ la núma̱aꞌ tsí ꞌgí ná xíli̱i thúngaa, tsí xtáa̱ jámuu, <verse eid="REV 4:9" /><verse number="10" style="v" sid="REV 4:10" />a̱ꞌkhue̱n tsí mbá skíñú akhu̱un (24) xa̱bo̱ buanuu, nu̱sma̱ti̱gúu̱n inuu tsí ꞌgí ná xíli̱i thúngaa, nune̱-mba̱a̱ tsí xtáa̱ jámuu, jamí nu̱stri̱ge̱e̱ ajwa̱nꞌ gamaku rí jndi drígúu̱n ná inuu thúngaa. A̱ꞌkhue̱n nuthee̱n:<verse eid="REV 4:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="REV 4:11" />«Ikháánꞌ Táta̱,<note caller="+" style="f"><char style="fr" closed="false">4.11 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán xóó: «tsáánꞌ Ana̱ꞌxo̱ꞌ ñajwaanꞌ».</char></note> jaꞌyaaꞌ rí ma̱gu̱ma-mba̱ánꞌ,</para>
  <para style="q" vid="REV 4:11">ma̱tri̱gú gamaku jamí ma̱tri̱gú tsiakhe̱.</para>
  <para style="q" vid="REV 4:11">Numuu rí ikháánꞌ nithane̱-ku̱maa mbá xúgíí rí ríga̱ ná numbaa.</para>
  <para style="q" vid="REV 4:11">Ni̱gu̱ma-ku̱maa ne̱ jamí ríga̱ ne̱ ga̱jma̱á numuu rí ikháánꞌ nandaaꞌ».<verse eid="REV 4:11" /></para>
  <chapter eid="REV 4" />
  <chapter number="5" style="c" sid="REV 5" />
  <para style="s">A̱ꞌdá-mógó na̱grui̱gú i̱yi̱i̱ꞌ rí jambúxu̱u̱ꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1" />A̱ꞌkhue̱n ndi̱yo̱o̱ rí ná ñawún mújúun tsí ꞌgí ná xíli̱i thúngaa jayée̱ mbá i̱yi̱i̱ꞌ jambúxu̱u̱ꞌ rí waꞌtháán inuu jamí tsu̱du̱u̱, xúꞌkhue̱n máꞌ phú xa̱ꞌ xtoꞌwóo ne̱ ga̱jma̱á mbá juwan tsina. <verse eid="REV 5:1" /><verse number="2" style="v" sid="REV 5:2" />Jamí ndi̱yo̱o̱ mbáa ánje̱l tsí phú mba̱a̱ ski̱yu̱u̱ꞌ, tsí phú gakhe̱ indxaꞌwá ído̱ rí naraxe̱: «Tsáa jaꞌyoo marakhúu tsinuu ne̱ jamí marmáꞌthoo i̱yi̱i̱ꞌ jambúxu̱u̱ꞌ rá». <verse eid="REV 5:2" /><verse number="3" style="v" sid="REV 5:3" />Jamí tákujmaa asndo nimbáa ná mikhuíí ni máꞌ ná numbaa ni máꞌ ná agoo ju̱ba̱ꞌ, tsí ma̱goo marmáꞌthoo jamí ma̱gu̱xnuu i̱yi̱i̱ꞌ jambúxu̱u̱ꞌ. <verse eid="REV 5:3" /><verse number="4" style="v" sid="REV 5:4" />Xómáꞌ ikhúúnꞌ phú na̱mbi̱ya̱ꞌlo̱ꞌ numuu rí tákujmaa asndo nimbáa tsí jaꞌyoo marmáꞌthoo jamí ma̱gu̱xnuu i̱yi̱i̱ꞌ jambúxu̱u̱ꞌ. <verse eid="REV 5:4" /><verse number="5" style="v" sid="REV 5:5" />A̱ꞌkhue̱n niꞌthínꞌ mbáa máꞌ tsí xa̱bo̱ nikhi̱i̱: «Náxáta̱mbi̱ya̱ꞌ rá. Numuu rí a̱ꞌdá-ri̱jyu̱u̱ꞌ thúngaa Dabíd, tsí nutháa̱n i̱ndi̱í phuu drígu̱ún xa̱bi̱i Judá, ni̱ꞌngo̱o̱ jamí jaꞌyoo̱ marakhúu̱ rí mbá juwan tsinuu i̱yi̱i̱ꞌ jambúxu̱u̱ꞌ jamí marakhúu̱ ne̱».<verse eid="REV 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6" />A̱ꞌkhue̱n ndi̱yo̱o̱ wéje̱ mbáa A̱ꞌdá-mógó ná ti̱kua̱pha̱a̱ inuu xíli̱i thúngaa, jamí ná majñu̱ú mbá nákhu̱un tsí nduya, xúꞌkhue̱n ná majñu̱ú xa̱bo̱ buanuu. Asndo nakujma tsínu̱u̱ꞌ rí waꞌxnáa̱ ma̱ja̱ñúu̱ kajngó ma̱nindxu̱u̱ tsi̱gi̱jña̱ꞌ. Gíꞌdoo̱ mbá juwan chi̱jyu̱u̱ꞌ, jamí gíꞌdoo̱ mbá juwan iduu̱ rí ñajuun mbá juwiin xu̱u̱ꞌ Ana̱ꞌlóꞌ tsí waxúꞌmii ná tsu̱du̱u̱ mbá xúgíí numbaa. <verse eid="REV 5:6" /><verse number="7" style="v" sid="REV 5:7" />A̱ꞌkhue̱n nixuꞌma-mina̱ꞌ A̱ꞌdá-mógó jamí ni̱grui̱guíi̱ i̱yi̱i̱ꞌ jambúxu̱u̱ꞌ rí gída̱ꞌ ná ñawún mújúun tsí ꞌgí ná xíli̱i thúngaa. <verse eid="REV 5:7" /><verse number="8" style="v" sid="REV 5:8" />Ído̱ ni̱grui̱guíi̱ ne̱, a̱ꞌkhue̱n mbá nákhu̱un tsí nduya, gajmíi̱ tsí mbá skíñú akhu̱un (24) xa̱bo̱ buanuu, ni̱smáti̱gúu̱n inuu A̱ꞌdá-mógó. Mbámbáa̱ jayá mbá ixe̱ nidi̱í rí gíꞌdoo nítúu, jamí mbá xúba̱ me̱jno̱ꞌ ajwa̱nꞌ mo̱jmo̱ꞌ gajni̱í wájya ndaa thawuun, rí ikhaa rúꞌkhue̱n ñajuun tsakuun rí nune̱ xa̱bi̱i Ana̱ꞌlóꞌ. <verse eid="REV 5:8" /><verse number="9" style="v" sid="REV 5:9" />Jamí nusiee̱n ajmúú nuxe̱ꞌ ríge̱ꞌ:</para>
  <para style="b" vid="REV 5:9" />
  <para style="q" vid="REV 5:9">«Ikháánꞌ jaꞌyaaꞌ rí ma̱tri̱gú i̱yi̱i̱ꞌ jambúxu̱u̱ꞌ jamí ma̱tra̱khuíí tsinuu ne̱.</para>
  <para style="q" vid="REV 5:9">Numuu rí ikháánꞌ waxnáaꞌ rí ma̱ja̱ñáaꞌ,</para>
  <para style="q" vid="REV 5:9">jamí ga̱jma̱á iꞌdiaaꞌ niratse̱wíin mbá xúgíí inii xa̱bo̱,</para>
  <para style="q" vid="REV 5:9">tsí júwa̱ꞌ mbá xúgíí xuajen jamí nuthan mbá xúgíí ajngáa ná mbá xúgíí numbaa, rí ma̱nindxúu̱n xa̱bi̱i Ana̱ꞌlóꞌ.<verse eid="REV 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="REV 5:10" />Ikháánꞌ nithane̱ rí ma̱nindxúu̱n thúngaa,</para>
  <para style="q" vid="REV 5:10">Nithane̱ rí ma̱nindxúu̱n dxakuun tsí mu̱ñajun ná inuu Ana̱ꞌlóꞌ.</para>
  <para style="q" vid="REV 5:10">Ikhii̱n muthan-ñajwíi̱n numbaa».<verse eid="REV 5:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11" />Ído̱ ni̱ya̱xe̱, a̱ꞌkhue̱n ni̱dxawuun a̱ꞌwúún mbaꞌiin mi̱ndaꞌkho ánje̱l tsí wájun mbá tuaꞌáan ná wéje̱ xíli̱i thúngaa, ná wájun tsí nduya jamí ná trigi̱in xa̱bo̱ buanuu. Ninújngoo mbaꞌiin mi̱ndaꞌkho ánje̱l, ndawa̱a̱ tsí gáꞌngo̱o̱ ma̱gu̱xnuu̱. <verse eid="REV 5:11" /><verse number="12" style="v" sid="REV 5:12" />Jamí phú gakhe̱ nu̱ndxa̱ꞌwe̱e̱. Xáꞌnii nithee̱n:</para>
  <para style="b" vid="REV 5:12" />
  <para style="q" vid="REV 5:12">«A̱ꞌdá-mógó tsí waꞌxnáá rí ma̱ja̱ñúu jaꞌyoo̱ rí maꞌthán-ñájwii̱n,</para>
  <para style="q" vid="REV 5:12">jaꞌyoo̱ rí ma̱janáa̱ mbá xúgíí rí máján ríga̱ jamí mi̱ꞌthán rí phú na̱ma̱ñuu̱.</para>
  <para style="q" vid="REV 5:12">Jaꞌyoo̱ rí ma̱janáa̱ mba̱a̱ tsiakhe̱ jamí mi̱tiamakuíi̱,</para>
  <para style="q" vid="REV 5:12">xúꞌkhue̱n máꞌ rí ma̱gu̱ma-mba̱a̱ jamí mi̱ꞌthán rí máján numuu̱».<verse eid="REV 5:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="REV 5:13" />Xúꞌkhue̱n máꞌ ni̱dxawuun a̱ꞌwúún mbá xúgíin tsí neꞌne-ku̱mii Ana̱ꞌlóꞌ: tsí júwa̱ꞌ mikhuíí, tsí júwa̱ꞌ ná inuu ju̱ba̱ꞌ, tsí júwa̱ꞌ ná awúun ju̱ba̱ꞌ, jamí tsí júwa̱ꞌ ná awúun iya a̱pha̱. Xáꞌnii ni̱dxawuun rí nithee̱n:</para>
  <para style="b" vid="REV 5:13" />
  <para style="q" vid="REV 5:13">«Tsí ꞌgí ná xíli̱i thúngaa jamí A̱ꞌdá-mógó,</para>
  <para style="q" vid="REV 5:13">a̱gi̱ꞌthán rí máján ga̱jma̱á numúu̱ ikhii̱n jamí a̱gu̱ma-makúu̱n.</para>
  <para style="q" vid="REV 5:13">A̱gu̱ma-mbii̱n jamí guthan-ñajwii̱n ikhii̱n jámuu mbiꞌi».<verse eid="REV 5:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="REV 5:14" />Wámba̱ rúꞌkhue̱n, mbá nákhu̱un tsí nduya nuthan: «¡Xkuaꞌnii gáꞌne!». Jamí tsí mbá skíñú akhu̱un xa̱bo̱ buanuu, ni̱smáti̱gúu̱n xúꞌkhue̱n máꞌ nene̱-mba̱a̱ tsí xtáa ndaꞌya jámuu.<note caller="+" style="f"><char style="fr" closed="false">5.14 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «tsí xtáa ndaꞌya jámuu».</char></note><verse eid="REV 5:14" /></para>
  <chapter eid="REV 5" />
  <chapter number="6" style="c" sid="REV 6" />
  <para style="s">A̱ꞌdá-mógó narakhúu akho̱ tsinuu i̱yi̱i̱ꞌ jambúxu̱u̱ꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1" />Ído̱ ndi̱yo̱o̱ rí A̱ꞌdá-mógó nirakhúu timbá tsinuu i̱yi̱i̱ꞌ, a̱ꞌkhue̱n ni̱dxawuun rí nandxaꞌwá mbáa tsí akhu̱un mbo̱ nduya. Phú gakhe̱ indxaꞌwée̱, xómá nawán ído̱ rí naxpíbi. Xáꞌnii niꞌthée̱n: «¡Aya̱ jamí atiaxe̱!».<note caller="+" style="f"><char style="fr" closed="false">6.1 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán i̱ndo̱ó máꞌ «Aya̱». Jamí xkuaꞌnii máꞌ ka̱ma ná kíxnuu 3, 5, jamí 7 mangaa.</char></note> <verse eid="REV 6:1" /><verse number="2" style="v" sid="REV 6:2" />A̱ꞌkhue̱n ni̱ya̱xe̱lo̱ꞌ, ndi̱yo̱o̱ mbáa guáyo̱ miꞌxáa, jamí xa̱bo̱ tsí ríguu̱ jayá mbá xkamídá. Nijanáa̱ mbá ajwa̱nꞌ gamaku rí jndi kajngó maꞌthán-ñájwii̱n, numuu rí ni̱ꞌngo̱o̱ inúú tsí neꞌne gajmíi̱, jamí nigájnuu̱ rí ma̱ꞌngo̱o̱ xóó.<verse eid="REV 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3" />Ído̱ rí A̱ꞌdá-mógó nirakhúu̱ riajma̱ tsinuu i̱yi̱i̱ꞌ, a̱ꞌkhue̱n ni̱dxawuun rí nandxaꞌwá i̱mba̱a̱ꞌ tsí ndaꞌya, ikhaa tsí riajma̱a̱. Xáꞌnii iꞌthée̱n: «¡Aya̱ jamí atiaxe̱!». <verse eid="REV 6:3" /><verse number="4" style="v" sid="REV 6:4" />A̱ꞌkhue̱n nigájnuu i̱mba̱a̱ꞌ guáyo̱, ikhaa tsí maña̱a̱ꞌ. Xómáꞌ xa̱bo̱ tsí ríguu̱ nijanáá mbá chíde̱ rí phú mba̱a̱, jamí nijanáa̱ tsiakhe̱ kajngó ma̱ꞌnii̱ rí ma̱ri̱gá xkujndu ná numbaa, jamí rí mu̱radí-mijná xa̱bo̱.<verse eid="REV 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5" />Ído̱ rí A̱ꞌdá-mógó nirakhúu̱ riatsú tsinuu i̱yi̱i̱ꞌ, a̱ꞌkhue̱n ni̱dxawuun rí nandxaꞌwá i̱mba̱a̱ꞌ tsí ndaꞌya, ikhaa tsí riatsíi. Xáꞌnii iꞌthée̱n: «¡Aya̱ jamí atiaxe̱!». Ni̱ya̱xe̱lo̱ꞌ, jamí ndi̱yo̱o̱ mbáa guáyo̱ skunii. Xómáꞌ xa̱bo̱ tsí ríguu̱ jayá mbá ajwa̱nꞌ rí na̱giewan-muu rí ji̱ñu̱u̱. <verse eid="REV 6:5" /><verse number="6" style="v" sid="REV 6:6" />A̱ꞌkhue̱n ni̱dxawuunlo̱ꞌ mbá a̱ꞌwá ná majñu̱ú mbá nákhu̱un tsí nduya. Xáꞌnii niꞌthán a̱ꞌwá rúꞌkhue̱n: «I̱ndo̱ó máꞌ mbá xu̱wa̱á ixí iña ma̱ꞌne numuu mbá mbúkha̱a̱ ajwa̱nꞌ, jamí i̱ndo̱ó máꞌ atsú xu̱wa̱á ixí ma̱ꞌne numuu mbá mbúkha̱a̱ ajwa̱nꞌ,<note caller="+" style="f"><char style="fr" closed="false">6.6 </char><char style="ft" closed="false">Mbúkha̱a̱ ajwa̱nꞌ rúꞌkhue̱n mbiꞌyuu «denário̱» ná ajngáa griégo̱. Mbá mbúkha̱a̱ rúꞌkhue̱n nadaa numuu xa̱bo̱ rí nañajun mbá mbiꞌi.</char></note> i̱ndo̱ó máꞌ numuu rí ma̱xáta̱xu̱xí numuu yatsi̱i xndú olíbo̱ ni máꞌ iyoo úba̱ rí ni̱ga̱yu̱u̱ꞌ».<verse eid="REV 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7" />Ído̱ rí A̱ꞌdá-mógó nirakhúu̱ riakho̱ tsinuu i̱yi̱i̱ꞌ, a̱ꞌkhue̱n ni̱dxawuun a̱ꞌwóo i̱mba̱a̱ꞌ tsí ndaꞌya, ikhaa tsí riakhui̱i̱. Xáꞌnii iꞌthée̱n: «¡Aya̱ jamí atiaxe̱!». <verse eid="REV 6:7" /><verse number="8" style="v" sid="REV 6:8" />A̱ꞌkhue̱n ni̱ya̱xe̱lo̱ꞌ, jamí ndi̱yo̱o̱ mbáa guáyo̱ waba mu̱jmi̱i̱ꞌ. Xómáꞌ tsí rígu tsu̱du̱u̱ mbiꞌyuu «Tsiakhe̱ rí na̱gu̱díin xa̱bo̱», jamí tsí na̱ꞌkha̱ ga̱jmáa̱ mbiꞌyuu «Iñá-wajíín». Nijanúu̱ tsiakhe̱ rí mu̱radíi̱n mbóó rí akho̱ kuthuun xa̱bo̱ tsí júwa̱ꞌ ná numbaa, mu̱radíi̱n ga̱jma̱á xkujndu, ga̱jma̱á ewi, ga̱jma̱á nandii jamí gajmíí xu̱kú-xáná tsí phú namangu̱únꞌ.<verse eid="REV 6:8" /></para>
  <para style="s">Tiwitsu jamí timajun tsinuu i̱yi̱i̱ꞌ</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9" />Ído̱ rí A̱ꞌdá-mógó nirakhúu̱ tiwitsu tsinuu i̱yi̱i̱ꞌ, a̱ꞌkhue̱n ni̱ya̱xe̱lo̱ꞌ ná agoo natráma rí nakha inuu Ana̱ꞌlóꞌ, jamí ndi̱yo̱o̱lo̱ꞌ ními̱í tsí nijáñúú nene̱ xa̱bo̱ ga̱jma̱á numuu ajngáa rawuun Ana̱ꞌlóꞌ jamí ga̱jma̱á numuu nuthee̱n rí nanimbúu̱n juyáa̱. <verse eid="REV 6:9" /><verse number="10" style="v" sid="REV 6:10" />Jamí phú gakhe̱ nu̱ndxa̱ꞌwe̱e̱ rí nuthee̱n: «Táta̱, tsáánꞌ xtaꞌdáá mbá xúgíí tsiakhe̱, tsáánꞌ jaꞌwíín jamí phú kuwíín, asndo nguáná gáta̱xu̱ꞌdáa awan ga̱jma̱á numúú xa̱bo̱ numbaa, jamí ma̱tha̱ne̱ rí mudaa̱ jamínu̱ꞌ ga̱jma̱á numuu rí ni̱radiáanꞌxo̱ꞌ róꞌ». <verse eid="REV 6:10" /><verse number="11" style="v" sid="REV 6:11" />A̱ꞌkhue̱n nijanúu̱ xtíin miꞌxá majúwúu̱n, jamí waꞌthúu̱n rí mu̱waꞌthíi̱n i̱mbá lájwíin xóó, numuu rí ndaꞌyóo xóó ma̱ja̱ñúú a̱nguíi̱n, yumbáá gajmíi̱ tsí wéje̱ máꞌ rí ma̱ja̱ñúú xómá nijáñúu̱ ikhii̱n.<verse eid="REV 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12" />Ído̱ rí A̱ꞌdá-mógó nirakhúu̱ timajun tsinuu i̱yi̱i̱ꞌ, a̱ꞌkhue̱n ni̱ya̱xe̱lo̱ꞌ jamí phú gakhe̱ nixma. Neꞌne jína inuu a̱kha̱ꞌ asndo xómá xtíñúú tsí júwa̱ꞌ jínúú jaꞌnii, jamí go̱nꞌ neꞌne maña̱a̱ꞌ asndo xómá iꞌdi. <verse eid="REV 6:12" /><verse number="13" style="v" sid="REV 6:13" />Xómáꞌ a̱ꞌgua̱án tsí timii mikhuíí, nifriguu̱n mbayíí, xómá rí nafrigu ruduu xndúu ixe̱ ígo̱ ído̱ rí naꞌne gakhe̱ gíñá. <verse eid="REV 6:13" /><verse number="14" style="v" sid="REV 6:14" />Xómáꞌ mikhu ningudi̱i ne̱ mbá jayu, nánguá nikujma ne̱ xómá agú rí wambúxi̱i jamí ni̱gi̱xi̱i. Mbá xúgíí júba̱ nixtiꞌkhu̱u ná wájun ne̱, xúꞌkhue̱n máꞌ mbaa rí tuaꞌán ná awúun iya a̱pha̱ nixtiꞌkhu̱u ná triga̱ ne̱.<verse eid="REV 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 6:15" />A̱ꞌkhue̱n mbá xúgíin xa̱bo̱ tsí júwa̱ꞌ ná numbaa ni̱rkaꞌu-mijnée̱ ná iñúu ju̱ba̱ꞌ jamí ná iñúu pátsí rí ríga̱ ná júba̱: thúngaa, xa̱bo̱ ñajun, xa̱bo̱ tsí nuthan-ñajúún tsí ku̱ra̱tuun ajwa̱nꞌ, xa̱bo̱ tsí phú guáꞌdáá mbúkha̱a̱, xa̱bo̱ tsí guáꞌdáá tsiakhe̱, xa̱bo̱ tsí nithán-ñájúún jamí xa̱bo̱ tsí nuthan-ñajun-mijná máꞌ ikhiin. <verse eid="REV 6:15" /><verse number="16" style="v" sid="REV 6:16" />Mbá xúgíi̱n nu̱nda̱ꞌáa̱ júba̱ jamí pátsí: «Ga̱friguáanꞌlaꞌ ná tsu̱da̱ꞌxo̱ꞌ, jamí gu̱rkaꞌwáanꞌxo̱ꞌ inuu tsí ꞌgí ná xíli̱i thúngaa jamí inuu rí najiꞌnáa A̱ꞌdá-mógó, <verse eid="REV 6:16" /><verse number="17" style="v" sid="REV 6:17" />numuu rí ni̱ga̱nú máꞌ mbiꞌi rí phú mba̱a̱ najiꞌníi̱, jamí nimbáa ma̱xáꞌngo̱o̱ ma̱we̱je̱-gúkúu ná inúu̱».<verse eid="REV 6:17" /></para>
  <chapter eid="REV 6" />
  <chapter number="7" style="c" sid="REV 7" />
  <para style="s">Mbá 144 000 xa̱bo̱ Israél tsí nuda tsina</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1" />Nda̱wa̱á a̱ꞌkhue̱n ndi̱yo̱o̱ wájun akhu̱un ánje̱l ná mbá nákho̱ rakhóo numbaa. Nijanúu̱ tsiakhe̱ rí ma̱wajún-ꞌthíi̱n mbá xúgíí gíñá kajngó ma̱xáxnúu ne̱ ná inuu numbaa, ni máꞌ ná inuu iya a̱pha̱, ni máꞌ ná inuu ixe̱. <verse eid="REV 7:1" /><verse number="2" style="v" sid="REV 7:2" />Xúꞌkhue̱n máꞌ ndi̱yo̱o̱ i̱mba̱a̱ꞌ ánje̱l tsí nagájnuu ná na̱ꞌkha̱ a̱kha̱ꞌ, jamí jayée̱ tsinuu Ana̱ꞌlóꞌ tsí ndaꞌya. A̱ꞌkhue̱n phú gakhe̱ nindxaꞌwée̱ inúú mbá nákhu̱un ánje̱l tsí nijanúú tsiakhe̱ rí mune̱-ñawíín numbaa jamí iya a̱pha̱. <verse eid="REV 7:2" /><verse number="3" style="v" sid="REV 7:3" />Xáꞌnii niꞌthúu̱n: Mu̱xúne̱-ñawíínlaꞌ xóó ju̱ba̱ꞌ, iya a̱pha̱, ni máꞌ ixe̱, asndo gámba̱ꞌxo̱ꞌ rí mu̱gíꞌmaxo̱ꞌ tsina ná jédúún yumbée Ana̱ꞌlóꞌ. <verse eid="REV 7:3" /><verse number="4" style="v" sid="REV 7:4" />Jamí ni̱dxawuunlo̱ꞌ wáthi̱in tsí nida tsina: mbá 144 000 rí mbá xúgíin kuthuun xa̱bi̱i i̱ji̱in Israél.<verse eid="REV 7:4" /></para>
  <para style="b" />
  <para style="li">
    <verse number="5" style="v" sid="REV 7:5" />Mbá 12 000 tsí xa̱bi̱i Judá nida tsina,</para>
  <para style="li" vid="REV 7:5">mbá 12 000 tsí xa̱bi̱i Rubén,</para>
  <para style="li" vid="REV 7:5">mbá 12 000 tsí xa̱bi̱i Gád,<verse eid="REV 7:5" /></para>
  <para style="li">
    <verse number="6" style="v" sid="REV 7:6" />mbá 12 000 tsí xa̱bi̱i Asér,</para>
  <para style="li" vid="REV 7:6">mbá 12 000 tsí xa̱bi̱i Neftalí,</para>
  <para style="li" vid="REV 7:6">mbá 12 000 tsí xa̱bi̱i Manasés,<verse eid="REV 7:6" /></para>
  <para style="li">
    <verse number="7" style="v" sid="REV 7:7" />mbá 12 000 tsí xa̱bi̱i Simeón,</para>
  <para style="li" vid="REV 7:7">mbá 12 000 tsí xa̱bi̱i Lebí,</para>
  <para style="li" vid="REV 7:7">mbá 12 000 tsí xa̱bi̱i Isakár,<verse eid="REV 7:7" /></para>
  <para style="li">
    <verse number="8" style="v" sid="REV 7:8" />mbá 12 000 tsí xa̱bi̱i Sabulón,</para>
  <para style="li" vid="REV 7:8">mbá 12 000 tsí xa̱bi̱i José,</para>
  <para style="li" vid="REV 7:8">mbá 12 000 tsí xa̱bi̱i Benjamín nida tsina.<verse eid="REV 7:8" /></para>
  <para style="s">Phú mbaꞌiin xa̱bo̱ tsí júwúún xtíin miꞌxá</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9" />Nda̱wa̱á a̱ꞌkhue̱n ni̱ya̱xe̱lo̱ꞌ, jamí ndi̱ñu̱ú mbaꞌiin mi̱ndaꞌkho xa̱bo̱ tsí naguwá mbá xúgíí numbaa, mbá xúgíí inii xa̱bo̱, mbá xúgíí ajngáa rí nuthan xa̱bo̱, jamí mbá xúgíí xuajen, jamí ndawa̱a̱ tsí na̱ꞌngo̱o̱ ma̱gu̱xnii̱. Wájwii̱n ná inuu wéje̱ xíli̱i thúngaa jamí ná inuu A̱ꞌdá-mógó, júwúu̱n xtíin miꞌxá jamí traꞌa̱ iná ida ñawúu̱n. <verse eid="REV 7:9" /><verse number="10" style="v" sid="REV 7:10" />Phú gakhe̱ nu̱ndxa̱ꞌwe̱e̱ rí nuthee̱n:</para>
  <para style="b" vid="REV 7:10" />
  <para style="q" vid="REV 7:10">«Ana̱ꞌlóꞌ tsí ꞌgí ná xíli̱i thúngaa,</para>
  <para style="q" vid="REV 7:10">jamí A̱ꞌdá-mógó nene̱-jríñáaꞌlóꞌ».<verse eid="REV 7:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="REV 7:11" />Mbá xúgíin ánje̱l wájun mbá tuaꞌáan ná wéje̱ xíli̱i thúngaa, mbá tuaꞌáan ná trigi̱in xa̱bo̱ buanuu, jamí mbá tuaꞌáan ná wájun akhu̱un tsí nduya. A̱ꞌkhue̱n ni̱smáti̱gu̱ún ánje̱l xúꞌkhue̱n máꞌ ni̱ꞌgíi̱ inúu̱ asndo mbayíí, jamí nene̱-mba̱a̱ Ana̱ꞌlóꞌ. <verse eid="REV 7:11" /><verse number="12" style="v" sid="REV 7:12" />Jamí nithee̱n:</para>
  <para style="b" vid="REV 7:12" />
  <para style="q" vid="REV 7:12">«¡Xkuaꞌnii gáꞌne!</para>
  <para style="q" vid="REV 7:12">Tsí jaꞌyoo mi̱ꞌthán rí máján ga̱jma̱á numuu jamí ma̱gu̱ma-mba̱a̱,</para>
  <para style="q" vid="REV 7:12">tsí jaꞌyoo rí ma̱ma̱ñuu jamí ma̱grui̱gúu la gamaku,</para>
  <para style="q" vid="REV 7:12">tsí jaꞌyoo rí mi̱tiamakuíí, jamí maꞌthán-ñájun,</para>
  <para style="q" vid="REV 7:12">xúꞌkhue̱n máꞌ jaꞌyoo rí ma̱gi̱ꞌdoo tsiakhe̱ jámuu mbiꞌi,</para>
  <para style="q" vid="REV 7:12">ikhaa ñajuun Ana̱ꞌlóꞌ.</para>
  <para style="q" vid="REV 7:12">¡Xkuaꞌnii gáꞌne!».<verse eid="REV 7:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13" />A̱ꞌkhue̱n mbáa tsí xa̱bo̱ nikhi̱i̱ niraxi̱ꞌ:</para>
  <para style="p" vid="REV 7:13">―Tsíin ñajúún jamí náá niguwá xa̱bo̱ tsíge̱ꞌ, tsí júwúún xtíin miꞌxá róꞌ.<verse eid="REV 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14" />Xómáꞌ ikhúúnꞌ ni̱riꞌñuu̱lo̱ꞌ:</para>
  <para style="p" vid="REV 7:14">―Táta̱, ikháánꞌ nathayáá tsíin ñajúu̱n jamí náá niguwée̱ꞌ.</para>
  <para style="p" vid="REV 7:14">A̱ꞌkhue̱n ikhaa̱ niꞌthínꞌlo̱ꞌ:</para>
  <para style="p" vid="REV 7:14">―Tsíge̱ꞌ ñajúún tsí ni̱ꞌngu̱ún ninújngúún ná awúun jamínu̱ꞌ rí mba̱a̱ mi̱ndaꞌkho. Nijñáa̱ xtíñúu̱ jamí nene̱-miꞌxáa̱ ne̱ ga̱jma̱á iꞌdiuu A̱ꞌdá-mógó.<verse eid="REV 7:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="REV 7:15" />»Ikhaa numuu rúꞌkhue̱n wájwii̱n ná inuu ꞌgí xíli̱i Ana̱ꞌlóꞌ.</para>
  <para style="q" vid="REV 7:15">Mbiꞌíí mbruꞌwíín traꞌii̱n nune̱-mba̱a̱ ná guꞌwá dxákuii̱n.</para>
  <para style="q" vid="REV 7:15">Xómáꞌ tsí ꞌgí ná xíli̱i thúngaa,</para>
  <para style="q" vid="REV 7:15">ma̱xtáa ga̱jma̱á nindxúu̱n jamí ma̱ña̱wúu̱n.<verse eid="REV 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="REV 7:16" />Nánguá mu̱míníi̱ rí ma̱xki̱dxúu̱n, ni máꞌ náxájándawúu̱n.</para>
  <para style="q" vid="REV 7:16">Nánguá mbuyáa̱ rí mika, ni máꞌ a̱kha̱ꞌ náxátsikhíi̱n.<verse eid="REV 7:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="REV 7:17" />Numuu rí A̱ꞌdá-mógó tsí wéje̱ ná majñu̱u̱ ꞌgí xíli̱i thúngaa ma̱ña̱wúu̱n xómá eꞌne waxtú,</para>
  <para style="q" vid="REV 7:17">jamí ma̱ꞌgee̱ jaguu̱n ná ríga̱ iya rí naꞌne rí mbuyee̱ jámuu.</para>
  <para style="q" vid="REV 7:17">Xómáꞌ Ana̱ꞌlóꞌ maxúdíi mbá xúgíí iyoo idúu̱n.<verse eid="REV 7:17" /></para>
  <chapter eid="REV 7" />
  <chapter number="8" style="c" sid="REV 8" />
  <para style="s">A̱ꞌdá-mógó narakhúu tijwan tsinuu i̱yi̱i̱ꞌ jambúxu̱u̱ꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1" />Ído̱ rí A̱ꞌdá-mógó nirakhúu tijwan tsinuu i̱yi̱i̱ꞌ, a̱ꞌkhue̱n wíí neꞌne ná mikhuíí xómá mbá skíñú gu̱wa̱ꞌ (30) wáa kíxnuu-makoo ajwa̱nꞌ. <verse eid="REV 8:1" /><verse number="2" style="v" sid="REV 8:2" />Nda̱wa̱á a̱ꞌkhue̱n ndi̱ñu̱ú mbá juwiin ánje̱l tsí wájun ná inuu Ana̱ꞌlóꞌ, jamí mbámbáa̱ nijanáá mbá ajwa̱nꞌ e̱ꞌmbi rí mandiyuu̱.<verse eid="REV 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3" />A̱ꞌkhue̱n ni̱ꞌkha̱ i̱mba̱a̱ꞌ ánje̱l tsí jayá mbá xúba̱ ajwa̱nꞌ mo̱jmo̱ꞌ rí najmaa mi̱kha wájya, ni̱wi̱ji̱i̱ ná wéje̱ ajwa̱nꞌ mo̱jmo̱ꞌ ná nakha wájya, rí wéje̱ ná mijngi ꞌgí xíli̱i thúngaa. Phú mba̱a̱ wájya ndaa thawuun nijanáá ánje̱l tsúꞌkhue̱n rí maxnáxi̱i̱ ga̱jma̱á máꞌ ajngáa rí nithán-jáñíí Ana̱ꞌlóꞌ ene̱ mbá xúgíin xa̱bii̱. <verse eid="REV 8:3" /><verse number="4" style="v" sid="REV 8:4" />A̱ꞌkhue̱n ná xúba̱ ajwa̱nꞌ mo̱jmo̱ꞌ rí jayá ánje̱l ná ñawúun nigájnuu gúní ndaa thawuun ga̱jma̱á ajngáa rí nithán-jáñíí Ana̱ꞌlóꞌ ene̱ xa̱bii̱, nitsimuu ne̱ asndo ná inuu Ana̱ꞌlóꞌ. <verse eid="REV 8:4" /><verse number="5" style="v" sid="REV 8:5" />A̱ꞌkhue̱n rí ánje̱l tsúꞌkhue̱n niwatuu̱n xúba̱ rí na̱gu̱ma gúní jamí nigruíye̱e̱ꞌ xa̱mbo̱ꞌ awúun ne̱, rí tráma inuu ajwa̱nꞌ mo̱jmo̱ꞌ ná nakha wájya, jamí nidee̱ ne̱ ná inuu ju̱ba̱ꞌ. A̱ꞌkhue̱n nixpíbi mbaꞌa nothon, phú wee niwán mbaꞌa nothon jamí nixma mangaa.<verse eid="REV 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6" />Jamí ánje̱l tsí mbá juwiin nijanúú ajwa̱nꞌ e̱ꞌmbi, nene̱-mbánu-mijnée̱ rí mu̱ndiyíi̱ ne̱.<verse eid="REV 8:6" /></para>
  <para style="s">Mbá akhu̱un ánje̱l tsí ginuu nu̱ndiyíí ajwa̱nꞌ e̱ꞌmbi</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7" />Nindiyuu ajwa̱nꞌ e̱ꞌmbi ánje̱l tsí ginii, a̱ꞌkhue̱n nifrigu iꞌtsí jamí agu ja̱nda̱wa̱ꞌ ga̱jma̱á iꞌdi, rí waꞌda ná inuu ju̱ba̱ꞌ. Nikha mbóó rí atsú kuthiin ju̱ba̱ꞌ, xúꞌkhue̱n máꞌ nikha mbá xúgíí ixe̱ jamí mbá xúgíí iná maxa rí ríga̱ ná awúun mbóó rí atsú kuthiin ju̱ba̱ꞌ.<verse eid="REV 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8" />Nindiyuu ajwa̱nꞌ e̱ꞌmbi ánje̱l tsí riajma̱a̱, a̱ꞌkhue̱n nixpátrígú ná awúun iya a̱pha̱ mbá rí xómá júba̱ mba̱a̱ mi̱ndaꞌkho jago̱ aguu jaꞌnii. A̱ꞌkhue̱n rí iya a̱pha̱ niꞌni̱i iꞌdi mbóó rí atsú kuthiin ne̱. <verse eid="REV 8:8" /><verse number="9" style="v" sid="REV 8:9" />Nijáñúú mbóó rí atsú kuthuun mbá xúgíin tsí nduya ná awúun iya a̱pha̱. Xúꞌkhue̱n máꞌ wámba̱a mbóó rí atsú kuthiin guꞌwá-rguwa mangaa.<verse eid="REV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10" />Nindiyuu ajwa̱nꞌ e̱ꞌmbi ánje̱l tsí riatsíi, a̱ꞌkhue̱n nixpátríguíi ná mikhuíí mbáa a̱ꞌgua̱án tsí phú mba̱a̱ jamí nakhaa xómá aguu rondo̱. Nixpátuáꞌáa̱n ná awúun mbóó rí atsú kuthiin rí mbá xúgíí matha jamí iduu iya. <verse eid="REV 8:10" /><verse number="11" style="v" sid="REV 8:11" />A̱ꞌgua̱án tsúꞌkhue̱n mbiꞌyuu «Rí Miꞌkhu̱u̱n». A̱ꞌkhue̱n neꞌne miꞌkhu̱u̱n mbóó rí atsú kuthiin iya. Jamí phú mbaꞌiin xa̱bo̱ nijáñúú neꞌne iya rúꞌkhue̱n, numuu rí neꞌne miꞌkhu̱u̱n ne̱.<verse eid="REV 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12" />Nindiyuu ajwa̱nꞌ e̱ꞌmbi ánje̱l tsí riakhui̱i̱, a̱ꞌkhue̱n nijámbi̱yu̱u̱ꞌ mbóó rí atsú kuthiin a̱kha̱ꞌ, mbóó rí atsú kuthiin go̱nꞌ, jamí mbóó rí atsú kuthiin a̱ꞌgua̱án, kajngó ma̱ꞌne mijína mbóó rí atsú kuthiin ná inúu̱. Xkuaꞌnii neꞌne mijína mbóó rí atsú kuthiin mbiꞌi jamí xúꞌkhue̱n máꞌ mbroꞌon mangaa.<verse eid="REV 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13" />Nda̱wa̱á a̱ꞌkhue̱n ndi̱yo̱o̱ rí ngrigo̱o̱ꞌ mbáa ánje̱l<note caller="+" style="f"><char style="fr" closed="false">8.13 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «mbáa bi̱yú».</char></note> ná mikhuíí, jamí ni̱dxawuun rí phú gakhe̱ indxaꞌwée̱: «¡Wáái̱i̱, wáái̱i̱, wáái̱i̱! Á tháán mingíníi xa̱bo̱ tsí júwa̱ꞌ ná numbaa ído̱ gúndiyíí e̱ꞌmbi i̱mbá atsúun ánje̱l tsí júwa̱ꞌ máꞌ na̱ma̱ñúú rí mu̱ndiyíí ne̱ rá».<verse eid="REV 8:13" /></para>
  <chapter eid="REV 8" />
  <chapter number="9" style="c" sid="REV 9" />
  <para style="s">Nandiyuu ajwa̱nꞌ e̱ꞌmbi ánje̱l tsí tiwitsii</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1" />Nindiyuu ajwa̱nꞌ e̱ꞌmbi ánje̱l tsí tiwitsii, a̱ꞌkhue̱n ndi̱yo̱o̱ nixpátríguíi mbáa a̱ꞌgua̱án mikhuíí ná inuu ju̱ba̱ꞌ. Ikhaa̱ nijanáa̱ rí marmáꞌthoo̱ ga̱jma̱á iñá rí me̱jno̱ꞌ. <verse eid="REV 9:1" /><verse number="2" style="v" sid="REV 9:2" />Ído̱ rí a̱ꞌgua̱án nirmáꞌthoo iñá rí me̱jno̱ꞌ, a̱ꞌkhue̱n nigájnuu gúní ikhín asndo xó mbá iñá mba̱a̱ rí nakha-roꞌoo mi̱ndaꞌkho jaꞌnii. A̱ꞌkhue̱n neꞌne jína inuu a̱kha̱ꞌ jamí inuu gíñá. <verse eid="REV 9:2" /><verse number="3" style="v" sid="REV 9:3" />Ná majñu̱u̱ gúní nigájnúú tsíꞌbu tsí niguátaan ná inuu ju̱ba̱ꞌ, jamí nijanúu̱ tsiakhe̱ rí mu̱phúu̱n xa̱bo̱, xómá tsiakhe̱ rí guáꞌdáá xi̱yú. <verse eid="REV 9:3" /><verse number="4" style="v" sid="REV 9:4" />Jamí waꞌxná-ñájúu̱n rí mu̱xúphi̱i̱ nimbá ra̱xa̱, ni máꞌ iná maxa rí ríga̱ ná tsu̱du̱u̱ ju̱ba̱ꞌ, ni máꞌ nimbá inúu ixe̱, rí i̱ndo̱ó máꞌ mu̱phúu̱n xa̱bo̱ tsí ra̱júda tsinuu Ana̱ꞌlóꞌ ná jédúún. <verse eid="REV 9:4" /><verse number="5" style="v" sid="REV 9:5" />Xúꞌkhue̱n máꞌ waꞌxná-ñájúu̱n rí mu̱xúradíi̱n xa̱bo̱, rí i̱ndo̱ó máꞌ muni̱i̱ rí mu̱míni̱í mi̱ndaꞌkho xa̱bo̱ mbá witsuun go̱nꞌ. Numuu rí naꞌkho̱ mi̱ndaꞌkho ná naꞌphi̱i̱, xómá naꞌkho̱ eꞌne xi̱yú. <verse eid="REV 9:5" /><verse number="6" style="v" sid="REV 9:6" />Awúun mbiꞌi rúꞌkhue̱n mbuꞌyá xa̱bo̱ rí ma̱ja̱ñúú, jamí mu̱xúxkamaa̱ xó rí ma̱ja̱ñúu̱. Maphú ma̱ꞌne a̱kuíi̱n rí ma̱ja̱ñúu̱, jamí ma̱xáxóo gája̱ñúu̱.<verse eid="REV 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7" />Tsí tsíꞌbu asndo xómá guáyo̱ tsí júwa̱ꞌ máꞌ na̱ma̱ñúú rí magóó ná ríga̱ xkujndu jaꞌñúu̱. Ná idxúu̱n tráma rí xómá ajwa̱nꞌ gamaku rí jndi jaꞌnii, rí ajwa̱nꞌ mo̱jmo̱ꞌ ñajuun. Rí inúu̱, xómá inúú xa̱bo̱ jaꞌnii ne̱. <verse eid="REV 9:7" /><verse number="8" style="v" sid="REV 9:8" />Rí tsu̱u̱n idxúu̱n xómá tsu̱u̱n idxu̱u̱ a̱ꞌgo̱ jaꞌnii ne̱. Rí iñúu̱ xómá iñuu i̱ndi̱í phuu jaꞌnii ne̱. <verse eid="REV 9:8" /><verse number="9" style="v" sid="REV 9:9" />Xómáꞌ ná xo̱xtúu̱n kathama rí xómá ajwa̱nꞌ jaꞌnii nambáñúu̱. Rí xpípíi̱n, wee jayu eꞌne ne̱ xómá wee eꞌne ído̱ rí phú mbaꞌa nakhúu ixe̱ i̱xu̱máá guáyo̱ tsí na̱tu̱ꞌu̱ún ná ríga̱ xkujndu. <verse eid="REV 9:9" /><verse number="10" style="v" sid="REV 9:10" />Rí tsilúu̱n, xómá tsilúún xi̱yú jaꞌnii ne̱, jamí ná tsilúu̱n guáꞌdáa̱ iyandáwúu̱n. Nuni̱i̱ rí mu̱míni̱í xa̱bo̱ awúun rí mbá witsuun go̱nꞌ ga̱jma̱á iyandáwúu̱n. <verse eid="REV 9:10" /><verse number="11" style="v" sid="REV 9:11" />Thúngaa tsí naꞌthán-ñájúún tsíꞌbu ñajuun ánje̱l tsí naꞌthán-ñájun ná iñá rí me̱jno̱ꞌ. Abadón mbiꞌyuu ánje̱l tsúꞌkhue̱n rí ajngáa ebréo̱, jamí Apolión mbiꞌyuu̱ rí ajngáa griégo̱.<verse eid="REV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12" />Xkuaꞌnii ninújngoo timbá «wáái̱i̱» rí nindxaꞌwá bi̱yú, jamí xóó máꞌ ndaꞌyóo ma̱ꞌkha̱ ne̱ i̱jma̱.<verse eid="REV 9:12" /></para>
  <para style="s">Nandiyuu ajwa̱nꞌ e̱ꞌmbi ánje̱l tsí timajwiin</para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13" />Nindiyuu ajwa̱nꞌ e̱ꞌmbi ánje̱l tsí timajwiin, a̱ꞌkhue̱n ni̱dxawuun mbá a̱ꞌwá rí nagájnuu ná majñu̱u̱ mbá nákho̱ chi̱jyu̱u̱ꞌ ajwa̱nꞌ mo̱jmo̱ꞌ ná nakha wájya, rí wéje̱ ná inuu Ana̱ꞌlóꞌ. <verse eid="REV 9:13" /><verse number="14" style="v" sid="REV 9:14" />A̱ꞌwá rúꞌkhue̱n niꞌthúun ánje̱l tsí timajwiin nindiyuu ajwa̱nꞌ e̱ꞌmbi: «Atrakhúún mbá nákhu̱un ánje̱l tsí xtuꞌwúún ná rawuun matha mba̱a̱ rí mbiꞌyuu Éu̱fra̱te̱s». <verse eid="REV 9:14" /><verse number="15" style="v" sid="REV 9:15" />A̱ꞌkhue̱n watrakhúún mbá nákhu̱un ánje̱l tsí júwa̱ꞌ kiajúún máꞌ rí mu̱radíin mbóó rí atsú kuthuun xa̱bo̱ numbaa. Numuu rí guáꞌthíi̱n máꞌ rí ma̱ga̱nú tsigu, go̱nꞌ, mbiꞌi jamí mbrúma rúꞌkhue̱n, rí mu̱radíi̱n xa̱bo̱. <verse eid="REV 9:15" /><verse number="16" style="v" sid="REV 9:16" />Jamí ni̱dxawuun wáthi̱in xa̱bo̱ tsí juda ajwa̱nꞌ trámúú guáyo̱ naguwá, ni̱dxawuun rí mbá a̱jma̱ siénto̱ miyón (200 000 000) ñajúu̱n.<verse eid="REV 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 9:17" />Xáꞌnii jaꞌñúú guáyo̱ jamí xa̱bo̱ tsí trámúu̱ ndi̱yo̱o̱lo̱ꞌ inuu mbiꞌíí: Ná xo̱xtu̱ún xa̱bo̱ kathama ajwa̱nꞌ maña̱ꞌ rí xómá agu jaꞌnii rí nambáñúu̱, miꞌñuu xómá safíro̱ jamí mo̱jmo̱ꞌ xómá asúfre̱. Rí idxu̱ún guáyo̱ xómá idxu̱u̱ i̱ndi̱í phuu jaꞌnii ne̱, jamí ná rawúu̱n nangujwíi agu, gúní jamí asúfre̱. <verse eid="REV 9:17" /><verse number="18" style="v" sid="REV 9:18" />Ga̱jma̱á numuu atsú inii jamínu̱ꞌ ríge̱ꞌ, nijáñúú mbóó rí atsú kuthuun xa̱bo̱ ná numbaa. Ikhaa ga̱jma̱á numuu agu, gúní jamí asúfre̱ rí nangujwíi ná rawúún guáyo̱. <verse eid="REV 9:18" /><verse number="19" style="v" sid="REV 9:19" />Numuu rí ná rawúún guáyo̱ guáꞌdáá tsiakhe̱ jamí ná tsilúu̱n. Rí tsilúu̱n gíꞌdoo idxu̱u̱ xómá a̱bo̱ꞌ, jamí ga̱jma̱á tsilúu̱n nune̱-jámbi̱ñúu̱ꞌ xa̱bo̱.<verse eid="REV 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20" />Xómáꞌ i̱ꞌwíin xa̱bo̱ tsí tájáñúú ga̱jma̱á jamínu̱ꞌ rúꞌkhue̱n rá, túni̱ꞌñáa̱ rí nuni̱i̱ rí xkawe̱ꞌ, ni máꞌ túni̱ꞌñáa̱ rí nune̱-mbii̱n gíñá ꞌguéen, ni máꞌ túni̱ꞌñáa̱ rí nune̱-mbii̱n tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún, tsí ninii̱ ga̱jma̱á ajwa̱nꞌ mo̱jmo̱ꞌ, ajwa̱nꞌ miꞌxá, ajwa̱nꞌ brónse̱, itsí jamí ga̱jma̱á ixe̱. Mbá xúgíin tsúꞌkhue̱n, tsí nene̱-ku̱mii xa̱bo̱ ga̱jma̱á ñawúún, na̱nguá i̱ya̱xi̱i̱ ni máꞌ tsídxawíi̱n ni máꞌ tsíngrigúu̱n ga̱jma̱á nakhúu̱n. <verse eid="REV 9:20" /><verse number="21" style="v" sid="REV 9:21" />Xúꞌkhue̱n máꞌ táthanga̱a a̱kuíi̱n rí nu̱radíi̱n xa̱bo̱, ni máꞌ rí nuni̱i̱ xawan, ni máꞌ rí nubúu̱n gajmíi̱ xa̱bo̱ tsí túya̱a̱, ni máꞌ rí nune̱-ku̱ꞌwée̱.<verse eid="REV 9:21" /></para>
  <chapter eid="REV 9" />
  <chapter number="10" style="c" sid="REV 10" />
  <para style="s">Ánje̱l tsí jayá mbá i̱yi̱i̱ꞌ lájwíin</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1" />Nda̱wa̱á a̱ꞌkhue̱n ndi̱yo̱o̱ rí na̱ga̱taa ná mikhuíí mbáa ánje̱l tsí phú mba̱a̱ ski̱yu̱u̱ꞌ, jambráꞌaa̱ ná awúun du̱u̱n. Wéje̱ tu̱ka̱ya̱ꞌ ná idxu̱u̱, rí inuu̱ nambiꞌi-taꞌa xómá a̱kha̱ꞌ, jamí mbá jañii rí mbijwa̱ꞌ nakhúu̱ maña̱ꞌ jayu xómá ri̱ꞌyu̱u̱ agu. <verse eid="REV 10:1" /><verse number="2" style="v" sid="REV 10:2" />Jayée̱ mbá i̱yi̱i̱ꞌ lájwíin rí ja̱ma̱ꞌtha ná ñawúu̱n. Nitsijii̱ nakhú mújúu̱n ná inuu iya a̱pha̱, jamí nakhú xti̱yu̱u̱ꞌ nitsijii̱ ná inuu ju̱ba̱ꞌ. <verse eid="REV 10:2" /><verse number="3" style="v" sid="REV 10:3" />A̱ꞌkhue̱n phú gakhe̱ nindxaꞌwée̱, xómá indxaꞌwá mbáa i̱ndi̱í phuu, jamí núkho̱ máꞌ niwán nixpíbi mbá juwan nothon. <verse eid="REV 10:3" /><verse number="4" style="v" sid="REV 10:4" />Ído̱ wámba̱ nixpíbi rí mbá juwan nothon, ni̱ꞌgí-mina̱ꞌ rí ma̱tháán. A̱ꞌkhue̱n ni̱dxawuun mbá a̱ꞌwá ná mikhuíí rí niꞌthínꞌ: «Ma̱xáta̱snga̱jmá rí nithan a̱ꞌwá rí nixpíbi mbá juwan nothon, ni máꞌ ma̱xára̱tháán ne̱».<verse eid="REV 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5" />A̱ꞌkhue̱n rí ánje̱l tsí ndi̱yo̱o̱ nitsiji nakhúu ná inuu iya a̱pha̱ jamí ná inuu ju̱ba̱ꞌ, nixúxi̱i̱ ñawúu̱n<note caller="+" style="f"><char style="fr" closed="false">10.5 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «ñawún mújúu̱n».</char></note> ná mikhuíí <verse eid="REV 10:5" /><verse number="6" style="v" sid="REV 10:6" />jamí nixuda-mine̱e̱ꞌ rí maꞌthée̱n rí gakon ga̱jma̱á numuu tsí xtáa̱ ndaꞌya jámuu, ikhaa tsí neꞌne-ku̱maa mikhu, ju̱ba̱ꞌ, iya a̱pha̱, jamí ga̱jma̱á máꞌ mbá xúgíí rí ríga̱ ná inuu ne̱ jamí ná awúun ne̱. Xáꞌnii niꞌthée̱n: «Nánguá mba̱yo̱ꞌ mbiꞌi rá. <verse eid="REV 10:6" /><verse number="7" style="v" sid="REV 10:7" />Ído̱ rí ánje̱l tsí tijwaan mandiyuu ajwa̱nꞌ e̱ꞌmbi, a̱ꞌkhue̱n rí ma̱mba̱núu mbá xúgíí awan drígo̱o̱ Ana̱ꞌlóꞌ rí i̱ndo̱ó máꞌ ikhaa̱ ni̱gi̱da̱ꞌ idxu̱u̱ nákhí wajyúú. Ma̱ri̱gá xómá rí ikhaa̱ niꞌthúu̱n yumbée̱ tsí ni̱rawíjnga̱a ajngóo̱ wajyúú».<verse eid="REV 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8" />A̱ꞌkhue̱n a̱ꞌwá rí ni̱dxawuun ná mikhuíí niꞌthínꞌ mbu̱júꞌ: «Ayu gátri̱gú i̱yi̱i̱ꞌ lájwíin rí ja̱ma̱ꞌtha ná ñawúun ánje̱l tsí wéje̱ ná inuu iya a̱pha̱ jamí ná inuu ju̱ba̱ꞌ».<verse eid="REV 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9" />A̱ꞌkhue̱n nikalo̱ꞌ ná wéje̱ ánje̱l jamí ni̱ndo̱ꞌo̱o̱ rí maxníꞌ i̱yi̱i̱ꞌ lájwíin. Jamí ikhaa̱ niꞌthínꞌ: «Ayá ne̱ jamí atso ne̱. Ná rawaanꞌ ma̱ꞌne thawuun ne̱ xómá yáá, jamí ná awáanꞌ ma̱ꞌne miꞌkhu̱u̱n ne̱». <verse eid="REV 10:9" /><verse number="10" style="v" sid="REV 10:10" />A̱ꞌkhue̱n ni̱gruígúlo̱ꞌ i̱yi̱i̱ꞌ lájwíin ná ñawúun ánje̱l jamí nikho ne̱. Phú máján thawuun ne̱ ná rawunꞌ xómá yáá, jamí ná awúnꞌ phú miꞌkhu̱u̱n ne̱ ndi̱yo̱o̱. <verse eid="REV 10:10" /><verse number="11" style="v" sid="REV 10:11" />A̱ꞌkhue̱n waꞌthúnꞌ: «Mba̱ꞌyóo rí ma̱rawíjnga̱a mbu̱jwáaꞌ rí naꞌthán Ana̱ꞌlóꞌ rí ma̱gíꞌnuu mbaꞌa xuajen, mbaꞌa numbaa, mbaꞌa ajngáa jamí rí ma̱gíꞌníí mbaꞌiin thúngaa».<verse eid="REV 10:11" /></para>
  <chapter eid="REV 10" />
  <chapter number="11" style="c" sid="REV 11" />
  <para style="s">Ná xuajen Jerusalén nakujmii a̱jmi̱i xa̱bo̱ tsí nuthan rí ndiyáá</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1" />Nda̱wa̱á a̱ꞌkhue̱n nijanúꞌ mbá e̱ꞌe̱n rí xómá ixe̱ na̱giewan-muu jaꞌnii, jamí waꞌthúnꞌ: «Ayu gáta̱giéwan guꞌwá dxákuiin Ana̱ꞌlóꞌ, atagiéwan ná natráma tsi̱gi̱jña̱ꞌ jamí araxnii xa̱bo̱ tsí nune̱-mba̱a̱ Ana̱ꞌlóꞌ ikhín. <verse eid="REV 11:1" /><verse number="2" style="v" sid="REV 11:2" />I̱ndo̱ó máꞌ numuu rí ma̱xáta̱giéwan rixo̱o̱ guꞌwá dxákuun, numuu rí ikhín nijanúú ma̱chúún xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún. Ikhii̱n mu̱sngu̱ti̱gúu̱n xuajen Jerusalén mbá atsú tsigu i̱tikhu.<note caller="+" style="f"><char style="fr" closed="false">11.2 </char><char style="ft" closed="false">Ná i̱yi̱i̱ꞌ griégo̱ naꞌthán «a̱jma̱ skíñú i̱jmi̱i go̱nꞌ (42)».</char></note> <verse eid="REV 11:2" /><verse number="3" style="v" sid="REV 11:3" />Jamí ikhúúnꞌ ma̱xu̱ꞌmíi a̱jmi̱i xa̱bi̱ꞌ tsí muthan ga̱jma̱á numuꞌ, kajngó mu̱rawíjngaa̱ ajngóꞌ mbá atsú tsigu i̱tikhu.<note caller="+" style="f"><char style="fr" closed="false">11.3 </char><char style="ft" closed="false">Ná i̱yi̱i̱ꞌ griégo̱ naꞌthán «mbá míl a̱jma̱ siénto̱ atsú skíñú (1 260) mbiꞌi».</char></note> Ma̱ju̱wá-jínúu̱ jamí majúwúu̱n xtíin xíni rí naꞌtsu̱-raꞌa.<verse eid="REV 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4" />Tsíge̱ꞌ ñajúún nájma̱ ixe̱ olíbo̱ jamí nájma̱ ajwa̱nꞌ ná natráma agu rí wájun ná inuu Ana̱ꞌlóꞌ<note caller="+" style="f"><char style="fr" closed="false">11.4 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «inuu Táta̱».</char></note> tsí naꞌthán-ñájuun mbá xúgíí numbaa. <verse eid="REV 11:4" /><verse number="5" style="v" sid="REV 11:5" />Xí mbáa xa̱bo̱ nandoo gáꞌne-jámbi̱ñúu̱ꞌ, nangujwíi agu ná rawúu̱n rí matsikhíin mbá jayu tsí xa̱bo̱ sia̱nꞌ drígúu̱n. Xkuaꞌnii jaꞌyoo rí ma̱ja̱ñúu asndo tsáa máꞌ tsí nandoo gáꞌne-jámbi̱ñúu̱ꞌ. <verse eid="REV 11:5" /><verse number="6" style="v" sid="REV 11:6" />Guáꞌdáa̱ tsiakhe̱ rí mu̱ruguáa̱ mikhu kajngó ma̱xáxnúu ruꞌwa mbá xúgíí mbiꞌi rí mu̱rawíjngaa̱ ajngóo Ana̱ꞌlóꞌ. Xúꞌkhue̱n máꞌ guáꞌdáa̱ tsiakhe̱ rí mu̱rtaxii̱ iya ma̱ꞌni̱i iꞌdi, jamí rí mune̱-jámbi̱yíi̱ꞌ ju̱ba̱ꞌ ga̱jma̱á mbá xúgíí inii nandii ꞌguéen, asndo wátha̱ máꞌ nothon rí nandúu̱n ikhii̱n.<verse eid="REV 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7" />Ído̱ gámbúu̱n muthee̱n ajngáa rí nixnángawúu̱n Ana̱ꞌlóꞌ, a̱ꞌkhue̱n rí xu̱kú xkawi̱i̱ꞌ tsí nagájnuu ná iñá rí me̱jno̱ꞌ ma̱tsa̱ñu̱u̱ꞌ gajmíi̱. Ikhaa tsúꞌkhue̱n ma̱ꞌngo̱o̱ inúu̱ jamí ma̱gu̱díi̱n. <verse eid="REV 11:7" /><verse number="8" style="v" sid="REV 11:8" />Mabóo xuñúu̱ ná jamba̱a̱ ma̱jña̱ꞌ ná ti̱kua̱pho̱o̱ xuajen mba̱a̱ rí naꞌne xtiꞌkhuu Sodóma̱ jamí Egípto̱, ikhín máꞌ ná waꞌdujmaa Tátiálóꞌ ná ixe̱ krúsi̱ mangaa. <verse eid="REV 11:8" /><verse number="9" style="v" sid="REV 11:9" />Mbá xúgíí xuajen, mbá xúgíí inii xa̱bo̱, mbá xúgíí ajngáa rí nuthan xa̱bo̱ jamí mbá xúgíí numbaa mbuyáá xa̱bo̱ xuñúu̱ awúun rí atsú mbiꞌi i̱tikhu, jamí mu̱xúni̱ꞌñáa̱ rí mi̱ꞌdu̱u xuñúu̱. <verse eid="REV 11:9" /><verse number="10" style="v" sid="REV 11:10" />Mbá xúgíí inuu numbaa phú ma̱ꞌdxu a̱kui̱ín xa̱bo̱ rí nijáñúu̱. Asndo muni̱i̱ ndxa̱a̱ jamí muxna-mijnée̱ tsi̱gi̱jña̱ꞌ, numuu rí phú ni̱mínii̱ nene̱ a̱jmi̱i tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ.<verse eid="REV 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 11:11" />I̱ndo̱ó máꞌ numuu rí ído̱ ninújngoo mbá atsú mbiꞌi i̱tikhu, a̱ꞌkhue̱n neꞌne Ana̱ꞌlóꞌ rí ma̱ꞌkha̱a xúu̱nꞌ kajngó mbuyaa̱, jamí niwájuu̱n nakhúu̱n. Xómáꞌ xa̱bo̱ tsí ndiñúu̱, mbá xúgíi̱n nimíñúu̱ mi̱ndaꞌkho. <verse eid="REV 11:11" /><verse number="12" style="v" sid="REV 11:12" />A̱ꞌkhue̱n tsí a̱jmi̱i nu̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ ni̱dxawíi̱n mbá a̱ꞌwá rí phú gakhe̱ niwán ná mikhuíí, rí waꞌthúu̱n neꞌne: «A̱tsima̱aꞌlaꞌ ge̱jyoꞌ». A̱ꞌkhue̱n nigúu̱n mikhuíí ná majñu̱u̱ du̱u̱n, jamí mbá xúgíin xa̱bo̱ sia̱nꞌ gajmíi̱ ndiyáá rí nigúu̱n.<verse eid="REV 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 11:13" />Ikhín máꞌ awúun mbrúma rúꞌkhue̱n phú gakhe̱ nixma jamí ningudi-ri̱ga̱a mbóó rí mbámbá gu̱wa̱ꞌ guꞌwá ná awúun xuajen, jamí nijáñúú mbá juwan míl (7 000) xa̱bo̱. Xómáꞌ xa̱bo̱ tsí tájáñúú phú nimíñúu̱ jamí nene̱-mba̱a̱ Ana̱ꞌlóꞌ Mikhuíí.<verse eid="REV 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14" />Xkuaꞌnii ninújngoo riajma̱ «¡wáái̱i̱!» Jamí inu máꞌ ma̱ꞌkha̱ rí riatsú.<verse eid="REV 11:14" /></para>
  <para style="s">Nandiyuu ajwa̱nꞌ e̱ꞌmbi ánje̱l tsí tijwaan</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15" />Ánje̱l tsí tijwaan nindiyuu ajwa̱nꞌ e̱ꞌmbi, a̱ꞌkhue̱n phú gakhe̱ niwán mbaꞌa a̱ꞌwá ná mikhuíí. Xáꞌnii nithee̱n:</para>
  <para style="b" vid="REV 11:15" />
  <para style="q" vid="REV 11:15">«Rí xúge̱ꞌ rá, mbá xúgíí rí nithán-ñájwíín ná numbaa nanújnga̱a ná ñawúun Táta̱ rí maꞌthán-ñájuun,</para>
  <para style="q" vid="REV 11:15">xúꞌkhue̱n máꞌ ná ñawúun Krísto̱ tsí ikhaa̱ nixúngua̱a̱ꞌ.</para>
  <para style="q" vid="REV 11:15">Ikhaa̱ maꞌthán-ñájwii̱n jámuu mbiꞌi».<verse eid="REV 11:15" /></para>
  <para style="b" />
  <para style="m">
    <verse number="16" style="v" sid="REV 11:16" />Jamí xa̱bo̱ buanuu tsí mbá skíñú akhu̱un (24) tsí trigi̱in ná inuu Ana̱ꞌlóꞌ, ni̱smáti̱gúu̱n, ni̱tsrige̱e̱ inúu̱ asndo mbayíí jamí nene̱-mba̱a̱ Ana̱ꞌlóꞌ, <verse eid="REV 11:16" /><verse number="17" style="v" sid="REV 11:17" />jamí nithee̱n:</para>
  <para style="b" vid="REV 11:17" />
  <para style="q" vid="REV 11:17">«Táta̱ Ana̱ꞌxo̱ꞌ, tsáánꞌ xtaꞌdáá mbá xúgíí tsiakhe̱,</para>
  <para style="q" vid="REV 11:17">ikháánꞌ ñajwaanꞌ tsí xtaa máꞌ jayu, tsí niraxtaa máꞌ asndo nákhí wajyúú mbiꞌi, jamí tsí wéje̱ máꞌ rí mi̱dxa̱ꞌ.<note caller="+" style="f"><char style="fr" closed="false">11.17 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «jamí tsí wéje̱ máꞌ rí mi̱dxa̱ꞌ».</char></note></para>
  <para style="q" vid="REV 11:17">Núma̱aꞌ la numuu rí nitagíꞌdi̱ín najmaaꞌ ski̱ya̱a̱ꞌ rí phú mba̱a̱,</para>
  <para style="q" vid="REV 11:17">jamí nitagíꞌdi̱ín narathán-ñájun.<verse eid="REV 11:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="REV 11:18" />Nijiꞌníi juyaaꞌ xa̱bo̱ xuajñuu mbá xúgíí numbaa.</para>
  <para style="q" vid="REV 11:18">Jamí ikháánꞌ mangáánꞌ najiꞌnáá xtañúu̱.</para>
  <para style="q" vid="REV 11:18">Ni̱ga̱nú máꞌ mbiꞌi rí ma̱tra̱jwa̱ꞌ numúú tsí nijáñúú,</para>
  <para style="q" vid="REV 11:18">xúꞌkhue̱n máꞌ rí ma̱tha̱ne̱ rí mu̱drígú gamaku yumbiáaꞌ tsí ni̱rawíjnga̱a ajngáaꞌ,</para>
  <para style="q" vid="REV 11:18">gajmíí máꞌ xa̱bo̱ xuajñaaꞌ jamí mbá xúgíin tsí nduya-makuaaꞌ, xa̱bo̱ tsí makiin jamí xa̱bo̱ tsí mba̱ꞌwu̱un.</para>
  <para style="q" vid="REV 11:18">Jamí ni̱ga̱nú máꞌ mbiꞌi rí ma̱tha̱ne̱ gámbi̱in tsí nune̱-gámba̱a ju̱ba̱ꞌ».<verse eid="REV 11:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19" />A̱ꞌkhue̱n ni̱ma̱ꞌthoo guꞌwá dxákuiin Ana̱ꞌlóꞌ ná mikhuíí, jamí ikhín nikujma e̱jnu̱u̱ awan rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ. Xúꞌkhue̱n máꞌ nixpíbi mbaꞌa nothon, phú wee niwán mbaꞌa nothon, nixma jamí phú nixnúu ruꞌwa iꞌtsí.<verse eid="REV 11:19" /></para>
  <chapter eid="REV 11" />
  <chapter number="12" style="c" sid="REV 12" />
  <para style="s">A̱ꞌgo̱ ga̱jma̱á a̱bo̱ꞌ maña̱a̱ꞌ tsí phú mba̱a̱</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1" />A̱ꞌkhue̱n nikujma mbá rí phú wáá ná mikhuíí: mbáa a̱ꞌgo̱ júwuun xtíin rí nambiꞌi-taꞌa xómá a̱kha̱ꞌ, ná agoo nakhúu̱ ka̱maa go̱nꞌ, jamí ná idxu̱u̱ rígu mbá ajwa̱nꞌ gamaku rí jndi, rí timii gu̱wa̱ꞌ i̱jmi̱i (12) a̱ꞌgua̱án. <verse eid="REV 12:1" /><verse number="2" style="v" sid="REV 12:2" />Jago̱-édee̱ jamí nandxaꞌwée̱ rí naꞌkho̱ awúu̱n, numuu rí inu máꞌ ma̱ꞌne-xuajii̱n.<verse eid="REV 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 12:3" />A̱ꞌkhue̱n nikujma i̱mba̱ rí phú wáá ná mikhuíí: mbáa a̱bo̱ꞌ xkawi̱i̱ꞌ tsí phú mba̱a̱ jamí maña̱a̱ꞌ, tsí gíꞌdoo juwan idxu̱u̱ jamí gu̱wa̱ꞌ chi̱jyu̱u̱ꞌ, xúꞌkhue̱n máꞌ mbámbá idxu̱u̱ rígu mbá ajwa̱nꞌ gamaku lájwíin rí jndi. <verse eid="REV 12:3" /><verse number="4" style="v" sid="REV 12:4" />Ga̱jma̱á tsiluu̱ nixmátii̱n mbóó rí atsú kuthiin a̱ꞌgua̱án tsí timii ná mikhuíí jamí nixídíi̱n ná inuu ju̱ba̱ꞌ. Jamí ído̱ rí phú nangiyuu máꞌ rí ma̱ꞌne-xuajen a̱ꞌgo̱, a̱ꞌkhue̱n ni̱ka̱ a̱bo̱ꞌ xkawi̱i̱ꞌ tsí phú mba̱a̱ jamí maña̱a̱ꞌ ná mijngi kri̱ga̱a̱ a̱ꞌgo̱, kajngó mi̱khu̱u̱ a̱dée ído̱ gágu̱maa. <verse eid="REV 12:4" /><verse number="5" style="v" sid="REV 12:5" />Jamí a̱ꞌgo̱ niꞌnii mbáa dxáma tsí maꞌthán-ñájúún mbá xúgíin inii xa̱bo̱ tsí júwa̱ꞌ ná numbaa, maꞌthán-ñájúu̱n ga̱jma̱á xkuíya̱ ajwa̱nꞌ rí phú gúkú. I̱ndo̱ó máꞌ numuu rí mbá nacha̱ ni̱ka̱ jiꞌyáa a̱dée a̱ꞌgo̱ ná inuu Ana̱ꞌlóꞌ jamí ná ꞌgí xílii̱. <verse eid="REV 12:5" /><verse number="6" style="v" sid="REV 12:6" />Xómáꞌ a̱ꞌgo̱ nigáyuu̱ ni̱ke̱e̱ ná mbaa niníí, ná neꞌne-mújúun Ana̱ꞌlóꞌ rí mi̱tia̱wáa̱n jamí ma̱janáa̱ rí mi̱khui̱i̱ mbá atsú tsigu i̱tikhu.<note caller="+" style="f"><char style="fr" closed="false">12.6 </char><char style="ft" closed="false">Ná i̱yi̱i̱ꞌ griégo̱ naꞌthán «mbá míl a̱jma̱ siénto̱ atsú skíñú (1 260) mbiꞌi».</char></note><verse eid="REV 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7" />Nda̱wa̱á a̱ꞌkhue̱n ni̱gi̱ꞌdu̱u̱n mbá xkujndu mba̱a̱ ná mikhuíí. Ánje̱l tsí phú mba̱a̱ ski̱yu̱u̱ꞌ, tsí mbiꞌyuu Migéél gajmíi̱ ánje̱l tsí gíꞌdii̱n ni̱tsa̱ñúu̱ gajmíi̱ a̱bo̱ꞌ xkawi̱i̱ꞌ, gajmíí máꞌ ánje̱l drígo̱o̱ a̱bo̱ꞌ mangaa. <verse eid="REV 12:7" /><verse number="8" style="v" sid="REV 12:8" />Nindáti̱go̱o̱ a̱bo̱ꞌ gajmíí ánje̱l tsí gíꞌdiin, jamí nánguá nijanúu̱ rí ma̱ju̱wée̱ꞌ ná mikhuíí. <verse eid="REV 12:8" /><verse number="9" style="v" sid="REV 12:9" />Xkuaꞌnii waꞌda-maꞌáan a̱bo̱ꞌ maña̱a̱ꞌ tsí phú mba̱a̱, tsí xtáa̱ wajyúú mbiꞌi, tsí mbiꞌyuu gixa̱a̱ jamí Satanás, tsí naꞌne-nduwiin xa̱bo̱ mbá xúgíí inuu numbaa. Waxkriya̱a̱ꞌ ná mikhuíí rí ma̱ꞌgee̱ ná inuu ju̱ba̱ꞌ gajmíi̱ máꞌ ánje̱l tsí gíꞌdii̱n.<verse eid="REV 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10" />A̱ꞌkhue̱n ni̱dxawuun mbá a̱ꞌwá rí phú gakhe̱ niꞌthán ná mikhuíí:</para>
  <para style="b" vid="REV 12:10" />
  <para style="q" vid="REV 12:10">«Ni̱ga̱nú mbiꞌi rí Ana̱ꞌlóꞌ ma̱ꞌne-jáwíin xa̱bi̱i rá,</para>
  <para style="q" vid="REV 12:10">ni̱ga̱nú mbiꞌi rí ma̱kujma ski̱yu̱u̱ꞌ, jamí rí maꞌthán-ñájwii̱n ikhaa̱.</para>
  <para style="q" vid="REV 12:10">Xúꞌkhue̱n máꞌ ni̱ga̱nú mbiꞌi rí maꞌthán-ñájun Krísto̱ drígo̱o̱.</para>
  <para style="q" vid="REV 12:10">Numuu rí waxkriya̱a̱ꞌ tsí naꞌne-xtutaa ga̱jma̱á numúú a̱ngia̱nꞌlóꞌ,</para>
  <para style="q" vid="REV 12:10">tsí naꞌne aꞌkhúu̱n mbiꞌíí mbruꞌwíín ná inuu Ana̱ꞌlóꞌ.<verse eid="REV 12:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="REV 12:11" />Ikhii̱n ni̱ꞌngúu̱n inuu gixa̱a̱ ga̱jma̱á ski̱yu̱u̱ꞌ iꞌdiuu A̱ꞌdá-mógó</para>
  <para style="q" vid="REV 12:11">jamí ga̱jma̱á máꞌ ajngáa rí nithan-raꞌee̱.</para>
  <para style="q" vid="REV 12:11">Numuu támíñúu̱ rí ma̱mbá mbiꞌñúu̱, rí nijúwe̱e̱ꞌ na̱ma̱ñúu̱ máꞌ asndo rí ma̱ja̱ñúu̱.<verse eid="REV 12:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="REV 12:12" />Ikhaa numuu rúꞌkhue̱n, ¡ga̱ꞌdxu a̱kui̱in mikhu,</para>
  <para style="q" vid="REV 12:12">jamí ga̱ꞌdxu a̱kui̱ín tsí júwa̱ꞌ ná inuu ne̱!</para>
  <para style="q" vid="REV 12:12">¡Xómáꞌ ikháanꞌlaꞌ tsáanꞌ juwalaꞌ ná inuu ju̱ba̱ꞌ,</para>
  <para style="q" vid="REV 12:12">jamí ná iya a̱pha̱, phú gakhe̱ mu̱míni̱ílaꞌ!</para>
  <para style="q" vid="REV 12:12">Numuu rí gixa̱a̱ ni̱ga̱taa̱ ná juwalaꞌ</para>
  <para style="q" vid="REV 12:12">jamí phú najiꞌnáa̱ numuu ndaꞌyoo̱ rí nánguá mbaꞌa mbiꞌi ma̱xtáa̱».<verse eid="REV 12:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13" />Ído̱ ndiꞌyoo a̱bo̱ꞌ xkawi̱i̱ꞌ tsí phú mba̱a̱ jamí maña̱a̱ꞌ rí waꞌda-maꞌáa̱n ná inuu ju̱ba̱ꞌ, a̱ꞌkhue̱n ni̱ka̱-raxkoo̱ a̱ꞌgo̱ tsí niꞌnii dxáma. <verse eid="REV 12:13" /><verse number="14" style="v" sid="REV 12:14" />Xómáꞌ a̱ꞌgo̱ nijanáa̱ nájma̱ xpípíi bi̱yú tsí phú mba̱a̱ kajngó ma̱ꞌngo̱o̱ ma̱ki̱xi̱i̱ ma̱ꞌgee̱ ná mbaa niníí, tsíngua̱ꞌ ná inuu a̱bo̱ꞌ xkawi̱i̱, ná ni̱gu̱ma-mújúun rí mi̱tia̱wáa̱n jamí ma̱janáa̱ rí mi̱khui̱i̱ mbá atsú tsigu i̱tikhu. <verse eid="REV 12:14" /><verse number="15" style="v" sid="REV 12:15" />A̱ꞌkhue̱n rí a̱bo̱ꞌ xkawi̱i̱ꞌ, phú mba̱je̱ꞌ iya nixídíi̱ ga̱jma̱á rawuu̱n ná tsu̱du̱u̱ a̱ꞌgo̱, asndo xómá iyoo mbá matha, kajngó ma̱gu̱ꞌwi̱i̱ a̱ꞌgo̱ gáꞌne iya. <verse eid="REV 12:15" /><verse number="16" style="v" sid="REV 12:16" />Xómáꞌ ju̱ba̱ꞌ nimbáyúu a̱ꞌgo̱, numuu rí ni̱wa̱ja̱n ne̱ jamí niꞌña̱a̱ ne̱ iya rí ningujwíi ná rawuun a̱bo̱ꞌ xkawi̱i̱ꞌ tsí maña̱a̱ꞌ. <verse eid="REV 12:16" /><verse number="17" style="v" sid="REV 12:17" />A̱ꞌkhue̱n rí phú nijiꞌnáa a̱bo̱ꞌ xkawi̱i̱ꞌ tsí phú mba̱a̱ jaꞌyoo a̱ꞌgo̱, jamí ni̱ke̱e̱ gáꞌñúu̱ xkujndu i̱ꞌwíin i̱ji̱in a̱ꞌgo̱, ikhiin tsí nune̱-mbáníí ajngóo Ana̱ꞌlóꞌ jamí tsíni̱ꞌñáá gisngáá rí niꞌthán-ráꞌa Jesukrísto̱.<verse eid="REV 12:17" /></para>
  <chapter eid="REV 12" />
  <chapter number="13" style="c" sid="REV 13" />
  <para style="s">Xu̱kú xkawi̱i̱ꞌ tsí nagájnuu ná awúun iya a̱pha̱</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1" />Wáju̱nlo̱ꞌ<note caller="+" style="f"><char style="fr" closed="false">13.1 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «Ni̱wi̱ji̱i̱».</char></note> ná rawuun iya a̱pha̱,<note caller="+" style="f"><char style="fr" closed="false">13.1 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ ná mbá xúgíí ajngáa ríge̱ꞌ na̱ꞌkha̱ ná kíxnuu 12.18.</char></note> a̱ꞌkhue̱n ndi̱yo̱o̱ rí ná awúun iya a̱pha̱ nagájnuu mbáa xu̱kú xkawi̱i̱ꞌ, tsí gíꞌdoo juwan idxu̱u̱ jamí gu̱wa̱ꞌ chi̱jyu̱u̱ꞌ. Mbámbá chi̱jyu̱u̱ꞌ rígu mbá ajwa̱nꞌ gamaku lájwíin rí jndi, jamí mbámbá idxu̱u̱ ka̱ma mbá mbiꞌyuu rí naꞌthán-xkawiu̱u̱ꞌ Ana̱ꞌlóꞌ. <verse eid="REV 13:1" /><verse number="2" style="v" sid="REV 13:2" />Xu̱kú xkawi̱i̱ꞌ tsíge̱ꞌ xómá i̱ndi̱í mixtíi xáníi jaꞌnii̱, rí nakhúu̱ xómá nakhúu xu̱kú óso̱ jaꞌnii ne̱, jamí rawuu̱n xómá rawuun i̱ndi̱í phuu jaꞌnii ne̱. Xómáꞌ a̱bo̱ꞌ xkawi̱i̱ꞌ nixnúu̱ ski̱yu̱u̱ꞌ, xúꞌkhue̱n máꞌ nixnúu̱ xílii̱ kajngó ma̱gi̱ꞌi̱i̱ maꞌthán-ñájwii̱n.<verse eid="REV 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 13:3" />Ndi̱yo̱o̱ rí mbá idxu̱u̱ xu̱kú xkawi̱i̱ꞌ nakujma rí phú gakhe̱ nijámbi̱yu̱u̱ꞌ rí nijáñuu̱, i̱ndo̱ó máꞌ numuu rí niꞌni̱i máꞌ ne̱. Mbá xúgíin xa̱bo̱ tsí júwa̱ꞌ ná numbaa nimakúu̱n rí xkuaꞌnii jamí nigóo̱ tsu̱du̱u̱ xu̱kú xkawi̱i̱ꞌ. <verse eid="REV 13:3" /><verse number="4" style="v" sid="REV 13:4" />A̱ꞌkhue̱n rí mbá xúgíin xa̱bo̱ nene̱-mba̱a̱ a̱bo̱ꞌ xkawi̱i̱ꞌ numuu rí nixnúu̱ ski̱yu̱u̱ꞌ xu̱kú xkawi̱i̱ꞌ. Xúꞌkhue̱n máꞌ nene̱-mba̱a̱ xu̱kú xkawi̱i̱ꞌ mangaa, jamí xáꞌnii nithee̱n: «Tsáa i̱mba̱a̱ꞌ tsí phú mba̱a̱ ski̱yu̱u̱ꞌ xómá xu̱kú xkawi̱i̱ꞌ tsíge̱ꞌ rá. Tsáa gáꞌngo̱o̱ ma̱ꞌne ga̱jma̱á nindxu̱u̱ rá».<verse eid="REV 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5" />Tsí xu̱kú xkawi̱i̱ꞌ nijanáa̱ rí ma̱ꞌne-tsiꞌyée̱ jamí maꞌthán-xkawi̱i̱ꞌ ga̱jma̱á numuu Ana̱ꞌlóꞌ. Xúꞌkhue̱n máꞌ nijanáa̱ tsiakhe̱ rí ma̱ꞌnii̱ asndo wátha̱ máꞌ rí nandoo̱ ikhaa̱ mbá atsú tsigu i̱tikhu.<note caller="+" style="f"><char style="fr" closed="false">13.5 </char><char style="ft" closed="false">Ná i̱yi̱i̱ꞌ griégo̱ naꞌthán «a̱jma̱ skíñú a̱jmi̱i (42) go̱nꞌ».</char></note> <verse eid="REV 13:5" /><verse number="6" style="v" sid="REV 13:6" />A̱ꞌkhue̱n nigíꞌdu̱u̱n xu̱kú xkawi̱i̱ꞌ niꞌthán xkawe̱ꞌ ga̱jma̱á numuu Ana̱ꞌlóꞌ. Niꞌthán-xkawi̱i̱ꞌ numuu mbiꞌyuu Ana̱ꞌlóꞌ, numuu guꞌwóo̱, jamí ga̱jma̱á numúú tsí júwa̱ꞌ ná mikhuíí. <verse eid="REV 13:6" /><verse number="7" style="v" sid="REV 13:7" />Xúꞌkhue̱n máꞌ nijanáa̱ tsiakhe̱ rí ma̱ꞌnii̱ xkujndu gajmíi̱ xa̱bi̱i Ana̱ꞌlóꞌ jamí rí ma̱ꞌngo̱o̱ inúú. Mangaa máꞌ nijanáa̱ tsiakhe̱ rí maꞌthán-ñájúu̱n mbá xúgíí inii xa̱bo̱, mbá xúgíí xuajen, mbá xúgíí ajngáa rí nuthan xa̱bo̱ jamí mbá xúgíin xa̱bo̱ tsí júwa̱ꞌ ná numbaa. <verse eid="REV 13:7" /><verse number="8" style="v" sid="REV 13:8" />Ma̱gu̱ma-mba̱a̱ xu̱kú xkawi̱i̱ꞌ gúne̱ mbá xúgíin xa̱bo̱ tsí júwa̱ꞌ ná numbaa, ikhiin tsí na̱nguá ka̱ma mbiꞌñúú ná i̱yu̱u̱ꞌ A̱ꞌdá-mógó tsí nijáñuu. I̱yi̱i̱ꞌ rúꞌkhue̱n ni̱gu̱ma nákhí ni̱gu̱ma-ku̱maa numbaa, jamí ikhín ríga̱ mbiꞌñúú tsí mbuya jámuu.<verse eid="REV 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9" />Tsí gíꞌdoo ñaꞌwuun, gadxawuu̱n ríge̱ꞌ:<verse eid="REV 13:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="REV 13:10" />«Tsí nawatuun xa̱bo̱ rí ma̱ꞌga jagu̱un ná géjwa̱nꞌ,<note caller="+" style="f"><char style="fr" closed="false">13.10 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán: «Tsí wéje̱ máꞌ rí ma̱khuáa ma̱ꞌga géjwa̱nꞌ».</char></note> ma̱ꞌgee̱ máꞌ géjwa̱nꞌ.</para>
  <para style="q" vid="REV 13:10">Tsí na̱gu̱díin xa̱bo̱ ga̱jma̱á chíde̱,<note caller="+" style="f"><char style="fr" closed="false">13.10 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán: «Tsí wéje̱ máꞌ rí ma̱ja̱ñúu ga̱jma̱á chíde̱».</char></note> ma̱ja̱ñúu̱ máꞌ ga̱jma̱á chíde̱».</para>
  <para style="b" vid="REV 13:10" />
  <para style="m" vid="REV 13:10">Ge̱jyoꞌ ma̱kujmii xa̱bi̱i Ana̱ꞌlóꞌ, tsí na̱ꞌngo̱o̱ a̱kui̱ín rí mu̱míni̱í jamí rí wéje̱ a̱kui̱ín ná inuu Ana̱ꞌlóꞌ.<verse eid="REV 13:10" /></para>
  <para style="s">Xu̱kú xkawi̱i̱ꞌ tsí nagájnuu ná awúun ju̱ba̱ꞌ</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11" />Nda̱wa̱á a̱ꞌkhue̱n ndi̱yo̱o̱ i̱mba̱a̱ꞌ xu̱kú xkawi̱i̱ꞌ, tsí nagájnuu ná awúun ju̱ba̱ꞌ. Gíꞌdoo̱ a̱jma̱ chi̱jyu̱u̱ꞌ xómá chi̱jyu̱u̱ꞌ xu̱kú mogo̱, i̱ndo̱ó máꞌ numuu rí naꞌthée̱n xómá a̱bo̱ꞌ xkawi̱i̱ꞌ tsí phú mba̱a̱ jamí maña̱a̱ꞌ. <verse eid="REV 13:11" /><verse number="12" style="v" sid="REV 13:12" />Jamí ni̱grui̱guíi̱ mbá xúgíí ski̱yu̱u̱ꞌ xu̱kú xkawi̱i̱ꞌ tsí ginii, kajngó ma̱jmuu̱ ne̱ inuu máꞌ ikhaa tsúꞌkhue̱n. Naꞌne-ski̱ñúu̱ xa̱bo̱ tsí júwa̱ꞌ ná tsu̱du̱u̱ numbaa rí mune̱-mba̱a̱ xu̱kú xkawi̱i̱ꞌ tsí ginii, tsí niꞌni̱i máꞌ ná phú gakhe̱ nijámbi̱yu̱u̱ꞌ rí nijáñuu. <verse eid="REV 13:12" /><verse number="13" style="v" sid="REV 13:13" />Mangaa máꞌ naꞌnii̱ rí wáá rí phú namakúún xa̱bo̱ eꞌne. Asndo naꞌnii̱ rí ná inúú mbá xúgíin xa̱bo̱ ma̱ga̱taa agu mikhuíí, ma̱ꞌkha̱ ne̱ ná inuu numbaa. <verse eid="REV 13:13" /><verse number="14" style="v" sid="REV 13:14" />Ga̱jma̱á rí phú wáá rí naꞌnii̱ ga̱jma̱á ski̱yu̱u̱ꞌ xu̱kú xkawi̱i̱ꞌ tsí ginii, neꞌne-nduwii̱n xa̱bo̱ tsí júwa̱ꞌ ná numbaa. Nixná-ñájúu̱n xa̱bo̱ rí mune̱ mbá xtiꞌkhuu xu̱kú xkawi̱i̱ꞌ tsí ginii, tsí nijámbi̱yu̱u̱ꞌ ga̱jma̱á chíde̱ jamí tájáñuu. <verse eid="REV 13:14" /><verse number="15" style="v" sid="REV 13:15" />Mangaa máꞌ nijanáá xu̱kú xkawi̱i̱ꞌ tsí riajma̱a̱ tsiakhe̱ rí ma̱ꞌnii̱ rí mba̱ꞌya xtiꞌkhuu xu̱kú xkawi̱i̱ꞌ tsí ginii, kajngó ma̱goo maꞌthán ne̱ jamí ma̱ꞌne ne̱ rí ma̱ja̱ñúú mbá xúgíin xa̱bo̱ tsí tsíne̱-mba̱a̱ ne̱. <verse eid="REV 13:15" /><verse number="16" style="v" sid="REV 13:16" />Xúꞌkhue̱n máꞌ mangaa, xu̱kú xkawi̱i̱ꞌ tsí riajma̱a̱ naꞌne-ski̱ñúu̱ mbá xúgíin xa̱bo̱, xa̱bo̱ tsí makiin jamí xa̱bo̱ tsí mba̱ꞌwu̱un, tsí ngíníi jamí tsí guáꞌdáá mi̱ndaꞌkho, xa̱bo̱ tsí nuthan-ñajun-mijná máꞌ ikhiin jamí yumbáá waꞌtsi̱in, rí ma̱gi̱ꞌma mbá tsina ná ñawún mújúu̱n o ná jédúu̱n mbo̱ꞌ. <verse eid="REV 13:16" /><verse number="17" style="v" sid="REV 13:17" />Asndo nimbáa tsíyoo rí maꞌtse̱ o ma̱ngu̱jwa̱ mbo̱ꞌ, rí i̱ndo̱ó máꞌ tsí guáꞌdáá tsinuu xu̱kú xkawi̱i̱ꞌ, ikhaa rí ñajuun mbiꞌyuu̱ o kíxnuu mbiꞌyuu̱ mbo̱ꞌ.<verse eid="REV 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18" />Ge̱jyoꞌ ndaꞌyóo rí phú ma̱ma̱ñalóꞌ. Tsí nafroꞌo̱o̱, a̱gu̱xnuu̱ kíxnuu drígo̱o̱ xu̱kú xkawi̱i̱ꞌ, numuu rí kíxnuu máꞌ drígo̱o̱ xa̱bo̱ numbaa ñajuun ne̱. Ikhaa kíxnuu rúꞌkhue̱n ñajuun majun siénto̱ atsú skíñú majun (666).<verse eid="REV 13:18" /></para>
  <chapter eid="REV 13" />
  <chapter number="14" style="c" sid="REV 14" />
  <para style="s">A̱ꞌdá-mógó gajmíí tsí mbá 144 000</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1" />Nda̱wa̱á a̱ꞌkhue̱n ni̱ya̱xe̱, jamí ndi̱yo̱o̱ rí wéje̱ A̱ꞌdá-mógó ná inuu júba̱ Sióón, gajmíi̱ tsí mbá 144 000 xa̱bo̱, tsí ka̱ma mbiꞌyuu A̱ꞌdá-mógó jamí mbiꞌyuu Anu̱u̱ ná jédúún. <verse eid="REV 14:1" /><verse number="2" style="v" sid="REV 14:2" />A̱ꞌkhue̱n ni̱dxawuun mbá a̱ꞌwá ná mikhuíí xómá a̱ꞌwóo mbá xtangaya rí phú mba̱a̱, jamí xómá a̱ꞌwóo rí gakhe̱ naxpíbi. Asndo xó rí phú mbaꞌiin xa̱bo̱ tsí nudi̱í ixe̱ rí gíꞌdoo nítúu jaꞌnii. <verse eid="REV 14:2" /><verse number="3" style="v" sid="REV 14:3" />Jamí nusiee̱n mbá ajmúú nuxe̱ꞌ ná inuu ꞌgí xíli̱i thúngaa, ná inúú mbá nákhu̱un tsí nduya, jamí ná inúú xa̱bo̱ buanuu. Nimbáa tsíꞌngo̱o̱ gáma̱ñuu ajmúú rí nuni̱i̱, rí i̱ndo̱ó máꞌ tsí mbá 144 000 tsí waꞌtse̱-ri̱ñi̱iꞌ ná inuu numbaa. <verse eid="REV 14:3" /><verse number="4" style="v" sid="REV 14:4" />Tsíge̱ꞌ nimbá miꞌtsú túbúu̱n gajmíi̱ go̱ꞌo̱, numuu rí túni̱gui̱i̱nꞌ, jamí nagóo̱ tsu̱du̱u̱ A̱ꞌdá-mógó asndo náá máꞌ i̱ka̱. Ikhii̱n waꞌtse̱-ri̱ñii̱ꞌ ná inuu numbaa kajngó ma̱nindxúu̱n mbá tsi̱gi̱jña̱ꞌ rí ginii jayu ma̱grui̱gú Ana̱ꞌlóꞌ jamí A̱ꞌdá-mógó. <verse eid="REV 14:4" /><verse number="5" style="v" sid="REV 14:5" />Jamí ni miꞌtsú tágájnuu ajngáa rí mi̱nduwa ná rawúu̱n, numuu rí nda̱a̱ nimbá rí ma̱goo mi̱ꞌthán ga̱jma̱á numúu̱ ikhii̱n ná inuu ꞌgí xíli̱i Ana̱ꞌlóꞌ.<note caller="+" style="f"><char style="fr" closed="false">14.5 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «ná inuu ꞌgí xíli̱i Ana̱ꞌlóꞌ».</char></note><verse eid="REV 14:5" /></para>
  <para style="s">Ajngáa rí nithan atsúun ánje̱l</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6" />Nda̱wa̱á a̱ꞌkhue̱n ndi̱yo̱o̱ ngrigo̱o̱ꞌ ná inuu gíñá i̱mba̱a̱ꞌ ánje̱l ná mikhuíí. Jayée̱ ajngáa máján rí ríga̱ jámuu kajngó maꞌthán-rúꞌúu̱n ne̱ mbá xúgíin xa̱bo̱ tsí júwa̱ꞌ ná numbaa, mbá xúgíí inii xa̱bo̱, mbá xúgíí ajngáa rí nuthan xa̱bo̱ jamí mbá xúgíí xuajen. <verse eid="REV 14:6" /><verse number="7" style="v" sid="REV 14:7" />Jamí phú gakhe̱ indxaꞌwée̱: «Ga̱mi̱ꞌñálaꞌ gáꞌne Ana̱ꞌlóꞌ, jamí gu̱tha̱nlaꞌ rí máján ga̱jma̱á numuu̱, numuu rí ni̱ga̱nú máꞌ mbiꞌi rí maxudaa̱ awan ga̱jma̱á numúú xa̱bo̱. Gu̱ne̱-mba̱a̱laꞌ tsí neꞌne-ku̱maa mikhu jamí numbaa, xúꞌkhue̱n máꞌ iya a̱pha̱ jamí mbá xúgíí iduu iya».<verse eid="REV 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8" />A̱ꞌkhue̱n ni̱ꞌkha̱ i̱mba̱a̱ꞌ ánje̱l tsí niꞌthán: «¡Wámba̱a̱ rá! ¡Wámba̱a xuajen mba̱a̱ Babilónia̱ rá! Numuu rí xómá a̱ꞌgo̱ tsí na̱ngu̱jwa̱-mina̱ꞌ jaꞌnii̱, jamí niꞌnii̱ rí mbá xúgíí xuajen numbaa ma̱ꞌne aꞌkhán ga̱jma̱á majñu̱u̱ tsirájá rí naxná-raꞌee̱».<verse eid="REV 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9" />A̱ꞌkhue̱n ni̱ꞌkha̱ ánje̱l tsí riatsíi, tsí phú gakhe̱ niꞌthán: «Xí mbáa naꞌne-mba̱a̱ xu̱kú xkawi̱i̱ꞌ o xtiꞌkhuu̱ mbo̱ꞌ, jamí na̱grui̱gú tsinuu̱ ná jédoo o ná ñawúu̱n mbo̱ꞌ, <verse eid="REV 14:9" /><verse number="10" style="v" sid="REV 14:10" />tsúꞌkhue̱n ma̱ga̱a̱n iya miꞌkhu̱u̱n rí najiꞌnáa Ana̱ꞌlóꞌ, rí nijno̱ꞌ ga̱jma̱á mbáa jañii xu̱u̱ꞌ ná rgúxi̱ drígo̱o̱ rí najiꞌnáa Ana̱ꞌlóꞌ. Jamí tsúꞌkhue̱n mamínu̱u̱ꞌ mi̱ndaꞌkho ga̱jma̱á agu jamí asúfre̱ ná inúú ánje̱l drígo̱o̱ Ana̱ꞌlóꞌ jamí ná inuu máꞌ A̱ꞌdá-mógó mangaa. <verse eid="REV 14:10" /><verse number="11" style="v" sid="REV 14:11" />Mbá jámuu mbiꞌi natsimuu gúniúu jamínu̱ꞌ rí nakhiin tsúꞌkhue̱n. Na̱nguá mbuya̱a xu̱únꞌ mbiꞌíí mbruꞌwíín tsí nune̱-mba̱a̱ xu̱kú xkawi̱i̱ꞌ jamí nune̱-mba̱a̱ xtiꞌkhuu̱, xúꞌkhue̱n máꞌ tsí nu̱drígú tsinuu̱».<verse eid="REV 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 14:12" />Ge̱jyoꞌ ma̱kujmii tsí ñajúún xa̱bi̱i Ana̱ꞌlóꞌ, tsí na̱ꞌngo̱o̱ a̱kui̱ín rí mu̱míni̱í, nune̱-mbáníí ajngóo Ana̱ꞌlóꞌ jamí wéje̱ a̱kui̱ín ná inuu Jesús.<verse eid="REV 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13" />A̱ꞌkhue̱n ni̱dxawuun mbá a̱ꞌwá ná mikhuíí rí niꞌthínꞌ: «Aratháán ríge̱ꞌ: Phú gagi júwa̱ꞌ tsí ma̱ja̱ñúú ga̱jma̱á numuu Táta̱, asndo nákhí máꞌ xúge̱ꞌ jamí mbiꞌi rí ma̱ꞌkha̱. Jamí Xu̱u̱ꞌ Ana̱ꞌlóꞌ naꞌthán: “Gakon máꞌ rí xkuaꞌnii jaꞌnii, numuu rí ikhii̱n mbuyaa̱ xúu̱nꞌ rí ni̱ñajwii̱n gakhe̱, jamí ríga̱ mújúun ñajun rí nini̱i̱ ga̱jma̱á nindxúu̱n”».<verse eid="REV 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14" />Nda̱wa̱á a̱ꞌkhue̱n ndi̱yo̱o̱ mbá du̱u̱n miꞌxá, jamí ná tsu̱du̱u̱ ne̱ ꞌgí mbáa tsí xómá A̱dée Xa̱bo̱ Numbaa jaꞌnii. Ná idxu̱u̱ rígu mbá ajwa̱nꞌ gamaku rí jndi jamí mo̱jmo̱ꞌ, jamí ná ñawúu̱n jayée̱ mbá chíde̱ xngaa rí xíni mi̱ndaꞌkho. <verse eid="REV 14:14" /><verse number="15" style="v" sid="REV 14:15" />A̱ꞌkhue̱n nigájnuu i̱mba̱a̱ꞌ ánje̱l ná guꞌwá dxákuiin Ana̱ꞌlóꞌ, jamí phú gakhe̱ niꞌthée̱n kajngó madxawuun tsí ꞌgí ná inuu du̱u̱n: «Ada̱a ga̱jma̱á chíde̱ xngaa dríga̱a̱ꞌ rí nijma̱a̱. Numuu rí nikhi̱i̱ máꞌ rí nijma̱a̱ ná numbaa, jamí ni̱ga̱nú máꞌ mbiꞌi rí ma̱gi̱xi̱i ne̱». <verse eid="REV 14:15" /><verse number="16" style="v" sid="REV 14:16" />Ikhaa jngó tsí ꞌgí ná inuu du̱u̱n nixudaa̱ chíde̱ xngaa drígo̱o̱ ná inuu numbaa, a̱ꞌkhue̱n ni̱gi̱xi̱i rí nijma̱a̱ ná numbaa.<verse eid="REV 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17" />A̱ꞌkhue̱n nigájnuu i̱mba̱a̱ꞌ ánje̱l ná guꞌwá dxákuiin Ana̱ꞌlóꞌ rí ꞌgí ná mikhuíí, jamí jayée̱ mbá chíde̱ xngaa rí xíni mi̱ndaꞌkho mangaa̱. <verse eid="REV 14:17" /><verse number="18" style="v" sid="REV 14:18" />Xúꞌkhue̱n máꞌ nigájnuu i̱mba̱a̱ꞌ ánje̱l ná wéje̱ ajwa̱nꞌ mo̱jmo̱ꞌ ná nakha wájya, ánje̱l tsí jayángawii agu rí nakha ikhín, jamí phú gakhe̱ niꞌthée̱n kajngó madxawuun ánje̱l tsí jayá chíde̱ xngaa rí xíni mi̱ndaꞌkho: «A̱tro̱thon jwáyúu úba̱ rí nijma̱a̱ ná tsu̱du̱u̱ numbaa ga̱jma̱á chíde̱ xngaa dríga̱a̱ꞌ, numuu rí niꞌgo̱o̱ máꞌ ne̱». <verse eid="REV 14:18" /><verse number="19" style="v" sid="REV 14:19" />A̱ꞌkhue̱n rí ánje̱l nijmuu̱ chíde̱ xngaa drígo̱o̱ rí ma̱ru̱thii̱n úba̱ rí nijma̱a̱ ná tsu̱du̱u̱ numbaa. Niguu̱ ne̱ jamí nigruíye̱e̱ꞌ ne̱ ná awúun itsí mba̱a̱, ná nixúꞌduun ne̱, rí naꞌne xtiꞌkhuu rí najiꞌnáa Ana̱ꞌlóꞌ. <verse eid="REV 14:19" /><verse number="20" style="v" sid="REV 14:20" />Waxúꞌduun úba̱ rúꞌkhue̱n ná awúun itsí mba̱a̱ rí ꞌgí rixa̱á, ra̱ꞌkhá ná awúun xuajen, jamí ikhín nigájnuu mbá mañuu iꞌdi me̱jno̱ꞌ. Nijráꞌáan mañuu iꞌdi rúꞌkhue̱n asndo xó mbá tsída̱ꞌ wáa rawúún guáyo̱ jamí ni̱ga̱nú ne̱ tsíngua̱ꞌ asndo xó mbá atsú siénto̱ (300) kilóme̱tro̱ wáa.<note caller="+" style="f"><char style="fr" closed="false">14.20 </char><char style="ft" closed="false">Ná i̱yi̱i̱ꞌ griégo̱ rí wayuu naꞌthán «mbá míl majun siénto̱ (1 600) estádio̱».</char></note><verse eid="REV 14:20" /></para>
  <chapter eid="REV 14" />
  <chapter number="15" style="c" sid="REV 15" />
  <para style="s">Jwan jamínu̱ꞌ rí ma̱ꞌkha̱ nda̱wa̱á jayu</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1" />A̱ꞌkhue̱n ndi̱yo̱o̱ i̱mba̱ rí phú wáá mi̱ndaꞌkho ná mikhuíí jamí phú namakúún xa̱bo̱ eꞌne ne̱: mbá juwiin ánje̱l tsí juda mbá juwan inii jamínu̱ꞌ rí ma̱ꞌkha̱ nda̱wa̱á jayu. Ga̱jma̱á jamínu̱ꞌ rúꞌkhue̱n ma̱ga̱tíya̱a̱ꞌ-wóo rí najiꞌnáa Ana̱ꞌlóꞌ. <verse eid="REV 15:1" /><verse number="2" style="v" sid="REV 15:2" />Ndi̱yo̱o̱ mbá iya a̱pha̱ mangaa, rí xómá iyaniwan ja̱nda̱wa̱ꞌ ga̱jma̱á agu jaꞌnii. Ná rawuun iya a̱pha̱ wájun tsí ni̱ꞌngu̱ún inuu xu̱kú xkawi̱i̱ꞌ jamí túne̱-mba̱a̱ xtiꞌkhuu̱, xúꞌkhue̱n máꞌ túdri̱guíi̱ tsinuu̱ ni máꞌ<note caller="+" style="f"><char style="fr" closed="false">15.2 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa «tsinuu̱ ni máꞌ».</char></note> kíxnuu mbiꞌyuu̱. Judee̱ ixe̱ nidi̱í rí gíꞌdoo nítúu, rí nijanúu̱ neꞌne Ana̱ꞌlóꞌ. <verse eid="REV 15:2" /><verse number="3" style="v" sid="REV 15:3" />Jamí nusiee̱n ajmúú drígo̱o̱ Moisés, yumbée Ana̱ꞌlóꞌ, jamí ajmúú drígo̱o̱ A̱ꞌdá-mógó:</para>
  <para style="b" vid="REV 15:3" />
  <para style="q" vid="REV 15:3">«Táta̱, ikháánꞌ ñajwaanꞌ Ana̱ꞌxo̱ꞌ tsí gíꞌdoo mbá xúgíí tsiakhe̱.</para>
  <para style="q" vid="REV 15:3">Phú mba̱a̱ jamí phú wáá mbá xúgíí rí nathane̱.</para>
  <para style="q" vid="REV 15:3">Thúngaa tsí naꞌthán-ñájúún tsí jaꞌwuun ñajwaanꞌ,<note caller="+" style="f"><char style="fr" closed="false">15.3 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán: «Thúngaa tsí naꞌthán-ñájuun mbá xúgíí xuajñuu numbaa ñajwaanꞌ».</char></note></para>
  <para style="q" vid="REV 15:3">jamí mbá xúgíí rí nathane̱ máján jamí jmbu.<verse eid="REV 15:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="REV 15:4" />Táta̱, tsáa tsí ma̱xámíñuu gátha̱ne̱, jamí ma̱xáꞌne-mba̱ánꞌ rá.</para>
  <para style="q" vid="REV 15:4">Numuu rí i̱ndo̱ó máꞌ ikháánꞌ ñajwaanꞌ tsí jaꞌwii.</para>
  <para style="q" vid="REV 15:4">Mbá xúgíí numbaa ma̱guwá xa̱bo̱ ná inaaꞌ jamí mune̱-mbáa̱nꞌ,</para>
  <para style="q" vid="REV 15:4">numuu nduyáa̱ rí phú máján rí nathane̱».<verse eid="REV 15:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5" />Nda̱wa̱á a̱ꞌkhue̱n ni̱ya̱xe̱ mikhuíí jamí ndi̱yo̱o̱ ni̱ma̱ꞌthoo guꞌwá rí phú i̱tha̱án tsúꞌkhaa ná xtáa Ana̱ꞌlóꞌ. <verse eid="REV 15:5" /><verse number="6" style="v" sid="REV 15:6" />Ikhín nigájnúú ánje̱l tsí mbá juwiin tsí juda mbá juwan inii jamínu̱ꞌ. Júwúu̱n xtíin máján rí mbiꞌyuu líno̱, jaꞌwu ne̱ jamí nambiꞌi-taꞌa ne̱, xúꞌkhue̱n máꞌ ja̱rnga̱xtúu̱n mbá xtíin rí giaxu̱u̱ ajwa̱nꞌ mo̱jmo̱ꞌ ná xo̱xtúu̱n. <verse eid="REV 15:6" /><verse number="7" style="v" sid="REV 15:7" />A̱ꞌkhue̱n mbáa tsí akhu̱un mbo̱ nduya nixnúu̱ mbámbá xúba̱ me̱jno̱ꞌ ajwa̱nꞌ mo̱jmo̱ꞌ mbámbáa ánje̱l. Ná awúun xúba̱ gajni̱í rí najiꞌnáa Ana̱ꞌlóꞌ, tsí xtáa̱ ndaꞌya jámuu. <verse eid="REV 15:7" /><verse number="8" style="v" sid="REV 15:8" />A̱ꞌkhue̱n nijni̱í gúní ná awúun guꞌwá dxákuun, ga̱jma̱á numuu rí nambiꞌi-taꞌaa Ana̱ꞌlóꞌ jamí ga̱jma̱á numuu ski̱yu̱u̱ꞌ. Nimbáa tsíyoo ma̱to̱ꞌo̱o̱ ná guꞌwá dxákuun asndo gámbánuu mbá juwan jamínu̱ꞌ rí juda mbá juwiin ánje̱l.<verse eid="REV 15:8" /></para>
  <chapter eid="REV 15" />
  <chapter number="16" style="c" sid="REV 16" />
  <para style="s">Juwan xúba̱ gajni̱í rí najiꞌnáa Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1" />A̱ꞌkhue̱n ni̱dxawuun nigájnuu ná awúun guꞌwá dxákuun mbá a̱ꞌwá rí phú gakhe̱ niwán, rí naꞌthúún ánje̱l tsí mbá juwiin: «Aꞌgua gúxi̱dí-rámáálaꞌ ná tsu̱du̱u̱ numbaa rí gajno̱ꞌ ná awúun mbá juwan xúba̱ me̱jno̱ꞌ ríge̱ꞌ, rí gajni̱í rí najiꞌnáa Ana̱ꞌlóꞌ».<verse eid="REV 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2" />Nigájnuu ni̱ka̱ ánje̱l tsí ginii, jamí nixídí-rámuu̱ ná tsu̱du̱u̱ numbaa rí gajno̱ꞌ ná awúun xúba̱ me̱jno̱ꞌ. A̱ꞌkhue̱n mbá xúgíin xa̱bo̱ tsí juda tsinuu xu̱kú xkawi̱i̱ꞌ jamí nune̱-mba̱a̱ xtiꞌkhuu̱, nidee̱ ska rí phú xkawe̱ꞌ giaxu̱u̱ jamí phú naꞌkho̱ eꞌne ne̱.<verse eid="REV 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3" />Xómáꞌ ánje̱l tsí riajma̱a̱ nixídí-múꞌúu̱n ná awúun iya a̱pha̱ rí gajno̱ꞌ ná awúun xúba̱ me̱jno̱ꞌ. A̱ꞌkhue̱n niꞌni̱i iꞌdi iya a̱pha̱ xómá iꞌdiuu xa̱bo̱ tsí nijáñuu jaꞌnii, jamí nijáñúú mbá xúgíin xu̱kú tsí gachúún ná awúun ne̱.<verse eid="REV 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4" />Jamí ánje̱l tsí riatsíi nixídí-múꞌúu̱n ná awúun matha jamí ná iduu iya rí gajno̱ꞌ ná awúun xúba̱ me̱jno̱ꞌ, jamí niꞌni̱i iꞌdi iyoo ne̱. <verse eid="REV 16:4" /><verse number="5" style="v" sid="REV 16:5" />A̱ꞌkhue̱n ni̱dxawuun niꞌthán ánje̱l tsí jayángawii iya:</para>
  <para style="b" vid="REV 16:5" />
  <para style="q" vid="REV 16:5">«Táta̱,<note caller="+" style="f"><char style="fr" closed="false">16.5 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí tsíꞌthán «Táta̱».</char></note> tsí Jaꞌwii, tsí xtaa máꞌ jayu, jamí niraxtaa máꞌ asndo nákhí wajyúú mbiꞌi,</para>
  <para style="q" vid="REV 16:5">phú máján ithane̱ rí xkuaꞌnii nataxúꞌdaa awan ga̱jma̱á numúú xa̱bo̱.<verse eid="REV 16:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="REV 16:6" />Numuu rí ikhii̱n ni̱radíi̱n xa̱bo̱ tsí jaꞌwuun jamí tsí ni̱rawíjnga̱a ajngáaꞌ.</para>
  <para style="q" vid="REV 16:6">Ikhaa jngó ikháánꞌ mangáánꞌ naraxnúu̱ iꞌdi mu̱wa̱a̱n,</para>
  <para style="q" vid="REV 16:6">numuu rí ikhaa máꞌ rúꞌkhue̱n jaꞌñúu̱».<verse eid="REV 16:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="REV 16:7" />Xúꞌkhue̱n máꞌ ni̱dxawuun i̱mba̱ a̱ꞌwá rí nagájnuu ná wéje̱ ajwa̱nꞌ mo̱jmo̱ꞌ ná nakha wájya:</para>
  <para style="b" vid="REV 16:7" />
  <para style="q" vid="REV 16:7">«Gakon máꞌ, Táta̱ Ana̱ꞌxo̱ꞌ, tsáánꞌ xtaꞌdáá mbá xúgíí tsiakhe̱,</para>
  <para style="q" vid="REV 16:7">ikháánꞌ nataxúꞌdaa májáanꞌ awan jamí jmbu ga̱jma̱á numúú xa̱bo̱».<verse eid="REV 16:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8" />Ánje̱l tsí riakhui̱i̱ nixídí-rámuu ná inuu a̱kha̱ꞌ rí gajno̱ꞌ ná awúun xúba̱ me̱jno̱ꞌ, a̱ꞌkhue̱n rí a̱kha̱ꞌ ni̱grui̱guíi̱ tsiakhe̱ rí matsikhíi̱n xa̱bo̱ ga̱jma̱á agu. <verse eid="REV 16:8" /><verse number="9" style="v" sid="REV 16:9" />Jamí nikhiin mi̱ndaꞌkho xa̱bo̱ neꞌne rí mika. Xómáꞌ ikhii̱n ra̱khúu̱n gúne̱-mba̱a̱ Ana̱ꞌlóꞌ, maske máꞌ ikhaa̱ gíꞌdoo̱ tsiakhe̱ inuu jamínu̱ꞌ ríge̱ꞌ, ni máꞌ táthanga̱a a̱kuíi̱n, a̱ꞌkhue̱n gakon nithan-xkawíi̱ꞌ Ana̱ꞌlóꞌ.<verse eid="REV 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10" />Ánje̱l tsí tiwitsii nixídí-rámuu ná ꞌgí naꞌthán-ñájun xu̱kú xkawi̱i̱ꞌ rí gajno̱ꞌ ná awúun xúba̱ me̱jno̱ꞌ, a̱ꞌkhue̱n neꞌne jína mbá xúgíí ná naꞌthán-ñájwii̱n. Asndo naꞌpho̱ ra̱ju̱ún xa̱bo̱ rí naꞌkho̱ mi̱ndaꞌkho iyáa̱. <verse eid="REV 16:10" /><verse number="11" style="v" sid="REV 16:11" />Jamí nithán-xkawíi̱ꞌ Ana̱ꞌlóꞌ Mikhuíí ga̱jma̱á numuu rí naꞌkho̱ iyáa̱ jamí ga̱jma̱á numuu ska rí judee̱. Maske máꞌ xkuaꞌnii, túni̱ꞌñáa̱ rí nuni̱i̱ rí xkawe̱ꞌ.<verse eid="REV 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12" />Xómáꞌ ánje̱l tsí timajwiin nixídí-rámuu ná awúun matha mba̱a̱ Éu̱fra̱te̱s rí gajno̱ꞌ ná awúun xúba̱ me̱jno̱ꞌ, a̱ꞌkhue̱n nijndoo matha rúꞌkhue̱n. Xkuaꞌnii ni̱ma̱ꞌthoo jamba̱a̱ rí ma̱nújngúún thúngaa tsí naguwá ná numbaa na̱ꞌkha̱ a̱kha̱ꞌ. <verse eid="REV 16:12" /><verse number="13" style="v" sid="REV 16:13" />Xúꞌkhue̱n máꞌ ndi̱ñu̱ú atsúun gíñá ꞌguéen tsí xómá smajya jaꞌñúú. Mbáa̱ nigájnuu ná rawuun a̱bo̱ꞌ xkawi̱i̱ꞌ tsí phú mba̱a̱ jamí maña̱a̱ꞌ, i̱mba̱a̱ꞌ nigájnuu ná rawuun xu̱kú xkawi̱i̱ꞌ, jamí i̱mba̱a̱ꞌ nigájnuu ná rawuun tsí na̱gu̱wíjnga̱a ajngáa mi̱nduwa. <verse eid="REV 16:13" /><verse number="14" style="v" sid="REV 16:14" />Tsíge̱ꞌ ñajúún gíñá ꞌguéen tsí nune̱ rí phú wáá. Jamí nagájnúu̱ rí mu̱ru̱wii̱n mbá xúgíin thúngaa numbaa kajngó ma̱tsa̱ñúu̱ gajmíi̱ Ana̱ꞌlóꞌ tsí gíꞌdoo mbá xúgíí tsiakhe̱, ído̱ gága̱nú mbiꞌi rí phú mba̱a̱ rí niꞌgí Ana̱ꞌlóꞌ. <verse eid="REV 16:14" /><verse number="15" style="v" sid="REV 16:15" />(«A̱gu̱ya̱álaꞌ rí ikhúúnꞌ nda̱a̱ ajngóo gáꞌkha xómá na̱ꞌkha̱ mbáa ku̱ꞌwá. Phú gagi inuu tsí xtáa̱ máꞌ na̱ma̱ñuu jamí júwuun máꞌ xtíñuu, kajngó ma̱xángrigo̱o̱ꞌ tsaꞌtsaa̱, jamí ma̱xáti̱yu̱u̱ꞌ».) <verse eid="REV 16:15" /><verse number="16" style="v" sid="REV 16:16" />A̱ꞌkhue̱n rí gíñá ꞌguéen ni̱ru̱wi̱in mbá xúgíin thúngaa numbaa ná xkua̱ rí mbiꞌyuu «Armajedón» ná ajngáa ebréo̱.<verse eid="REV 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17" />Ánje̱l tsí juwaan nixídí-raꞌee̱ ná inuu gíñá rí gajno̱ꞌ ná awúun xúba̱ me̱jno̱ꞌ, a̱ꞌkhue̱n nigájnuu mbá a̱ꞌwá gakhe̱ ná ꞌgí xíli̱i thúngaa, rí ꞌgí ná awúun guꞌwá dxákuun ná mikhuíí. Xáꞌnii niꞌthán a̱ꞌwá rúꞌkhue̱n: «Wámba̱ mbá xúgíí rá». <verse eid="REV 16:17" /><verse number="18" style="v" sid="REV 16:18" />Nda̱wa̱á a̱ꞌkhue̱n, nixpíbi mbaꞌa nothon, phú wee niwán mbaꞌa nothon jamí nixma mi̱ndaꞌkho ná numbaa. Asndo nákhí máꞌ júwa̱ꞌ xa̱bo̱ ná numbaa, ni miꞌtsú túyáa̱ rí naxma xkuaꞌnii gakhe̱ guéño. <verse eid="REV 16:18" /><verse number="19" style="v" sid="REV 16:19" />A̱ꞌkhue̱n niwiꞌthángaa atsú kuthiin xuajen rí phú mba̱a̱ mbiꞌyuu Babilónia̱, jamí wámba̱-ri̱ga̱a mbaꞌa xuajen rí ríga̱ ná tsu̱du̱u̱ numbaa. Xkuaꞌnii támbumuu Ana̱ꞌlóꞌ jaꞌyoo xuajen mba̱a̱ Babilónia̱, kajngó niꞌnii̱ rí mu̱drígú jamínu̱ꞌ xa̱bo̱ xuajen rí mu̱wa̱a̱n iya miꞌkhu̱u̱n rí najiꞌnáa Ana̱ꞌlóꞌ. <verse eid="REV 16:19" /><verse number="20" style="v" sid="REV 16:20" />Rí xkuaꞌnii nixma, mbá xúgíí ju̱ba̱ꞌ rí tuaꞌán ná awúun iya a̱pha̱ ninguaꞌán ne̱ ná awúun iya, xúꞌkhue̱n máꞌ mbá xúgíí júba̱ ningudi-ri̱ga̱a ne̱. <verse eid="REV 16:20" /><verse number="21" style="v" sid="REV 16:21" />Jamí nifrigu iꞌtsí rí mba̱ꞌwo̱ mi̱ndaꞌkho<note caller="+" style="f"><char style="fr" closed="false">16.21 </char><char style="ft" closed="false">Ná ajngáa griégo̱ naꞌthán rí mbámbá iꞌtsí rúꞌkhue̱n ji̱ñu̱u̱ xó mbá «talanton» wáa, xó mbá a̱jma̱ skíñú (40) kílo̱ wáa.</char></note> ná mikhuíí, nixnúu idxu̱ún xa̱bo̱. Xómáꞌ xa̱bo̱ nithan-xkawíi̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á numuu iꞌtsí rúꞌkhue̱n, numuu rí mbá jamínu̱ꞌ rí gakhe̱ mi̱ndaꞌkho ñajuun ne̱.<verse eid="REV 16:21" /></para>
  <chapter eid="REV 16" />
  <chapter number="17" style="c" sid="REV 17" />
  <para style="s">A̱ꞌgo̱ tsí rígu tsu̱du̱u̱ xu̱kú xkawi̱i̱ꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1" />Nda̱wa̱á a̱ꞌkhue̱n ni̱ꞌkha̱ mbáa ánje̱l ná inuꞌ, mbáa máꞌ tsí mbá juwiin tsí juda mbá juwan xúba̱ me̱jno̱ꞌ, jamí niꞌthínꞌ: «Aya̱ ge̱jyoꞌ, ma̱snga̱jmáaꞌ jamínu̱ꞌ rí ma̱grui̱gú a̱ꞌgo̱ tsí na̱ngu̱jwa̱-mina̱ꞌ mi̱ndaꞌkho, tsí ꞌgí ná rawuun matha mba̱ꞌwo̱. <verse eid="REV 17:1" /><verse number="2" style="v" sid="REV 17:2" />Ga̱jma̱á nindxu̱u̱ ikhaa̱ nibúún thúngaa numbaa, jamí asndo xó rí neꞌne-majngii̱n xa̱bo̱ tsí júwa̱ꞌ ná numbaa jaꞌnii rí nene̱ aꞌkhán ga̱jma̱á nindxu̱u̱».<verse eid="REV 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3" />Nda̱wa̱á a̱ꞌkhue̱n ánje̱l tsúꞌkhue̱n ni̱ka̱ jañúú ná mbaa niníí, ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ. Ikhín ndi̱yo̱o̱ mbáa a̱ꞌgo̱ rígu tsu̱du̱u̱ mbáa xu̱kú xkawi̱i̱ꞌ maña̱a̱ꞌ, tsí juwan idxu̱u̱ jamí gu̱wa̱ꞌ chi̱jyu̱u̱ꞌ. Mbá xúgíí xtóo xu̱kú xkawi̱i̱ꞌ tsíge̱ꞌ tima mbiꞌyuu rí naꞌthán-xkawiu̱u̱ꞌ Ana̱ꞌlóꞌ. <verse eid="REV 17:3" /><verse number="4" style="v" sid="REV 17:4" />Xómáꞌ a̱ꞌgo̱ júwuu̱n xtíin rí miꞌñuu jamí rí maña̱ꞌ giaxu̱u̱, xúꞌkhue̱n máꞌ neꞌne karatha-mine̱e̱ꞌ ga̱jma̱á ajwa̱nꞌ mo̱jmo̱ꞌ, itsí mitsaan jamí ga̱jma̱á itsí rí mbiꞌyuu pérla̱. Ná ñawúu̱n jayée̱ mbá rgúxi̱ ajwa̱nꞌ mo̱jmo̱ꞌ, rí gajni̱í rí xkawe̱ꞌ mi̱ndaꞌkho naꞌnii̱ gajmíi̱ xa̱bekha tsí nabóo̱ gajmíi̱. <verse eid="REV 17:4" /><verse number="5" style="v" sid="REV 17:5" />Ná jédoo̱ ka̱ma mbiꞌyuu̱ rí kri̱ga̱ ngu̱ꞌwo̱o̱ rí nandoo gáꞌthán: «Xuajen mba̱a̱ Babilónia̱, ru̱dúún mbá xúgíin go̱ꞌo̱ tsí nu̱ngu̱jwa̱-mijná, xúꞌkhue̱n máꞌ ru̱dúu mbá xúgíí inii rí xkawe̱ꞌ na̱gu̱ma ná numbaa». <verse eid="REV 17:5" /><verse number="6" style="v" sid="REV 17:6" />A̱ꞌkhue̱n ndi̱yo̱o̱ rí najnga̱a̱ a̱ꞌgo̱ tsúꞌkhue̱n, numuu rí niꞌña̱a̱ iꞌdiúún xa̱bi̱i Ana̱ꞌlóꞌ jamí iꞌdiúún tsí nijáñúú ga̱jma̱á numuu Jesús.</para>
  <para style="p" vid="REV 17:6">Ído̱ ndi̱yo̱o̱ a̱ꞌgo̱ tsíge̱ꞌ, maphú nimakuꞌ. <verse eid="REV 17:6" /><verse number="7" style="v" sid="REV 17:7" />A̱ꞌkhue̱n niraxi̱ꞌlo̱ꞌ ánje̱l: «Náá numuu kajngó namakuaaꞌ róꞌ. Ikhúúnꞌ ma̱tha̱a̱nꞌ rí ríga̱ ngu̱ꞌwo̱o̱ ga̱jma̱á numuu a̱ꞌgo̱ tsíge̱ꞌ, jamí ma̱tha̱a̱nꞌ rí ríga̱ ngu̱ꞌwo̱o̱ ga̱jma̱á numuu xu̱kú xkawi̱i̱ꞌ tsí juwan idxu̱u̱ jamí gu̱wa̱ꞌ chi̱jyu̱u̱ꞌ tsí ríguu a̱ꞌgo̱. <verse eid="REV 17:7" /><verse number="8" style="v" sid="REV 17:8" />Xu̱kú xkawi̱i̱ꞌ tsí nithayáá, nixtáa̱ nákhí wapha, jamí nándawa̱a̱ máꞌ. I̱ndo̱ó máꞌ numuu rí inu máꞌ ma̱ga̱jnúu̱ ná iñá rí me̱jno̱ꞌ kajngó ma̱mbáa̱ mbá jayu. Xómáꞌ xa̱bo̱ tsí júwa̱ꞌ ná numbaa, tsí asndo nákhí ni̱gu̱ma-ku̱maa numbaa na̱nguá ka̱ma mbiꞌñúú ná awúun i̱yi̱i̱ꞌ rí ka̱ma mbiꞌñúú tsí nduya jámuu, phú ma̱makúu̱n ído̱ mbuyáa̱ xu̱kú xkawi̱i̱ꞌ tsí nixtáa̱ nákhí wapha jamí nándawa̱a̱ máꞌ, jamí inu máꞌ ma̱ꞌkhe̱e̱ mbu̱júꞌ.<verse eid="REV 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 17:9" />»Phú ndaꞌyóo rí ma̱ma̱ñuu xa̱bo̱ kajngó ma̱froꞌo̱o̱ ríge̱ꞌ: Mbá juwan idxu̱u̱ xu̱kú xkawi̱i̱ꞌ rí nithayáá, ikhaa naꞌne xtiꞌkhuu mbá juwan júba̱ ná ꞌgí a̱ꞌgo̱. <verse eid="REV 17:9" /><verse number="10" style="v" sid="REV 17:10" />Jamí ikhaa máꞌ ne̱ naꞌne xtiꞌkhúún mbá juwiin thúngaa mangaa. Nijáñúú máꞌ witsuun thúngaa tsúꞌkhue̱n, mbáa naꞌthán-ñájun máꞌ xúge̱ꞌ, jamí i̱mba̱a̱ꞌ xóó máꞌ tsíꞌthán-ñájwii̱n. Jamí ído̱ gáꞌthán-ñájwii̱n, ma̱xáꞌthán-ñájwii̱n máꞌ mba̱yo̱ꞌ. <verse eid="REV 17:10" /><verse number="11" style="v" sid="REV 17:11" />Xu̱kú xkawi̱i̱ꞌ tsí nixtáa̱ nákhí wapha, jamí nándawa̱a̱ máꞌ, ñajuu̱n thúngaa tsí migiñii. Jamí ikhaa̱ máꞌ ñajuu̱n mbáa thúngaa tsí juwiin mangaa, tsí nijúwa̱ꞌ ginuu, jamí ma̱mbáa̱ mbá jayu máꞌ mangaa̱.<verse eid="REV 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12" />»Mbá gu̱wa̱ꞌ che̱je̱ꞌ rí nithayáá, ikhaa naꞌne xtiꞌkhúún mbá gu̱wi̱inꞌ thúngaa tsí xóó tsígíꞌdi̱ín muthan-ñajun. Xómáꞌ thúngaa tsíge̱ꞌ mu̱dri̱guíi̱ tsiakhe̱ rí muthan-ñajwii̱n mbégo jayu máꞌ gajmíi̱ xu̱kú xkawi̱i̱ꞌ. <verse eid="REV 17:12" /><verse number="13" style="v" sid="REV 17:13" />Mbá xúgíin thúngaa tsíge̱ꞌ, ikhiin tsí gu̱wi̱inꞌ, mbóó máꞌ numuu rí júwe̱e̱ꞌ: rí mu̱xna̱xíi̱ ná ñawúun xu̱kú xkawi̱i̱ꞌ mbá xúgíí ski̱ñúu̱ rí nuthan-ñajwii̱n ga̱jma̱á. <verse eid="REV 17:13" /><verse number="14" style="v" sid="REV 17:14" />Mu̱ru̱waa̱ ski̱ñúu̱ rí ma̱tsa̱ñúu̱ gajmíi̱ A̱ꞌdá-mógó, xómáꞌ A̱ꞌdá-mógó ma̱ꞌngo̱o̱ inúu̱ numuu rí ikhaa̱ ñajuu̱n Xa̱bo̱ Ede̱ tsí jayá ikhúún mbá xúgíin xa̱bo̱ ede̱, jamí ikhaa̱ ñajuu̱n Thúngaa tsí naꞌthán-ñájúún mbá xúgíin thúngaa. Mangaa máꞌ gajmíí A̱ꞌdá-mógó tsí nindxaꞌwúún jamí niraꞌwíin Ana̱ꞌlóꞌ, jamí jmbiin ná inuu̱».<verse eid="REV 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15" />A̱ꞌkhue̱n niꞌthínꞌ xóó ánje̱l: «Matha mba̱ꞌwo̱ rí nithayáá ná ꞌgí a̱ꞌgo̱ tsí na̱ngu̱jwa̱-mina̱ꞌ, naꞌne xtiꞌkhuu mbaꞌa xuajen, mbaꞌa inii xa̱bo̱, mbaꞌa numbaa, jamí mbaꞌa ajngáa rí nuthan xa̱bo̱. <verse eid="REV 17:15" /><verse number="16" style="v" sid="REV 17:16" />Jamí gu̱wa̱ꞌ che̱je̱ꞌ rí nithayáá ná idxu̱u̱ xu̱kú xkawi̱i̱ꞌ, ma̱xáxúu̱n gúyáa̱ a̱ꞌgo̱ tsí na̱ngu̱jwa̱-mina̱ꞌ. Mu̱dri̱guíi̱ mbá xúgíí rí gíꞌdoo a̱ꞌgo̱ asndo ma̱ꞌne tsaꞌtsaa gúni̱i̱, mu̱phi̱i̱ xuyuu jamí mune̱-gámba̱a̱ ga̱jma̱á agu. <verse eid="REV 17:16" /><verse number="17" style="v" sid="REV 17:17" />Numuu rí Ana̱ꞌlóꞌ neꞌne rí ma̱mba̱xúu̱n kajngó muni̱i̱ rí nandoo Ana̱ꞌlóꞌ. Ikhaa numuu rúꞌkhue̱n, niguáꞌdáa̱ awan rí mu̱xna̱xíi̱ ná ñawúun xu̱kú xkawi̱i̱ꞌ mbá xúgíí ski̱ñúu̱, asndo gámbánuu mbá xúgíí ajngóo Ana̱ꞌlóꞌ. <verse eid="REV 17:17" /><verse number="18" style="v" sid="REV 17:18" />Jamí a̱ꞌgo̱ tsí nithayáá, naꞌne xtiꞌkhuu xuajen mba̱a̱ rí naꞌthán-ñájúún mbá xúgíin thúngaa ná numbaa».<verse eid="REV 17:18" /></para>
  <chapter eid="REV 17" />
  <chapter number="18" style="c" sid="REV 18" />
  <para style="s">Wámba̱a xuajen Babilónia̱</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1" />Nda̱wa̱á a̱ꞌkhue̱n ndi̱yo̱o̱ na̱ga̱taa i̱mba̱a̱ꞌ ánje̱l ná mikhuíí. Phú mba̱a̱ ski̱yu̱u̱ꞌ jamí phú gakhe̱ nimbiꞌi-taꞌa ná numbaa neꞌne aguu̱. <verse eid="REV 18:1" /><verse number="2" style="v" sid="REV 18:2" />Xúꞌkhue̱n máꞌ phú gakhe̱ nindxaꞌwée̱:</para>
  <para style="b" vid="REV 18:2" />
  <para style="q" vid="REV 18:2">«¡Ni̱ka̱tixa̱ ne̱ rá! ¡Wámba̱a xuajen mba̱a̱ Babilónia̱ rá!</para>
  <para style="q" vid="REV 18:2">Niꞌni̱i ne̱ guꞌwúún gíñá ꞌguéen, jamí ná nduya̱a xu̱únꞌ mbá xúgíí inii gíñá xkawi̱inꞌ.</para>
  <para style="q" vid="REV 18:2">Niꞌni̱i ne̱ ná nune̱ xáñúú mbá xúgíí inii xu̱kú xna tsí naꞌpho̱ xuwi niꞌga jamí xkawi̱inꞌ mi̱ndaꞌkho.<verse eid="REV 18:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="REV 18:3" />Numuu rí xuajen Babilónia̱ neꞌne rí mbá xúgíin xa̱bo̱ numbaa mune̱ aꞌkhán ga̱jma̱á nindxu̱u̱.</para>
  <para style="q" vid="REV 18:3">Ga̱jma̱á nindxu̱u̱ ikhaa̱ nibúún mbá xúgíin thúngaa numbaa,</para>
  <para style="q" vid="REV 18:3">xómáꞌ xa̱bo̱ tsí nu̱ngu̱jwa̱, niꞌnii̱ rí phú ma̱guáꞌdáa̱ mbúkha̱a̱,</para>
  <para style="q" vid="REV 18:3">ga̱jma̱á numuu rí phú na̱ni̱gu̱u̱ꞌ ma̱xtáa̱ naꞌnii̱ rí nandoo xuyuu̱».<verse eid="REV 18:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4" />A̱ꞌkhue̱n ni̱dxawuun i̱mba̱ a̱ꞌwá ná mikhuíí:</para>
  <para style="b" vid="REV 18:4" />
  <para style="q" vid="REV 18:4">«A̱ga̱jnáaꞌlaꞌ ná xuajen rúꞌkhue̱n, ikháanꞌlaꞌ tsáanꞌ xa̱bi̱ꞌ ñajwanlaꞌ,</para>
  <para style="q" vid="REV 18:4">ra̱ꞌkhá mu̱ne̱ mangáanꞌlaꞌ aꞌkhán rí naꞌnii̱ ikhaa̱,</para>
  <para style="q" vid="REV 18:4">jamí mu̱drígú mangáanꞌlaꞌ jamínu̱ꞌ rí ma̱grui̱guíi̱ ikhaa̱ gáꞌne.<verse eid="REV 18:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="REV 18:5" />Numuu rí nitíí aꞌkhúu̱n asndo mikhuíí,</para>
  <para style="q" vid="REV 18:5">jamí tsímbumuu Ana̱ꞌlóꞌ jaꞌyoo mbá xúgíí rí xkawe̱ꞌ niꞌnii̱.<verse eid="REV 18:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="REV 18:6" />Gu̱ñíi̱laꞌ xómá rí ikhaa̱ niꞌñúu̱ tsí i̱ꞌwíin xa̱bo̱.</para>
  <para style="q" vid="REV 18:6">Gu̱ne̱-numaa̱laꞌ a̱jma̱ nothon xómá rí niꞌnii̱,</para>
  <para style="q" vid="REV 18:6">gu̱xnáa̱laꞌ mamínu̱u̱ꞌ a̱jma̱ nothon gakhe̱ xómá rí ikhaa̱ niꞌnii̱ rí mu̱míni̱í i̱ꞌwíin.<verse eid="REV 18:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="REV 18:7" />Ikhaa̱ phú nikúxe̱-mine̱e̱ꞌ jamí ni̱gi̱ꞌdoo̱ mbá xúgíí inii rí na̱ni̱gu̱u̱ꞌ,</para>
  <para style="q" vid="REV 18:7">ikhaa jngó xkuaꞌnii máꞌ mba̱a̱ gúxnáa̱laꞌ rí mamínu̱u̱ꞌ rí xúge̱ꞌ rá.</para>
  <para style="q" vid="REV 18:7">Numuu rí niꞌthán-mine̱e̱ꞌ:</para>
  <para style="q" vid="REV 18:7">“Ge̱jyoꞌ ꞌgúnꞌlo̱ꞌ xómá ꞌgí a̱ꞌgo̱ thúngaa.</para>
  <para style="q" vid="REV 18:7">Ra̱ꞌkhá a̱ꞌgóxuáꞌa ñajunlo̱ꞌ,</para>
  <para style="q" vid="REV 18:7">jamí ni miꞌtsú ma̱xága̱nú jamínu̱ꞌ ná inuꞌ”.<verse eid="REV 18:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="REV 18:8" />Numuu rí xkuaꞌnii nakúxe̱-mina̱ꞌ xuajen Babilónia̱,</para>
  <para style="q" vid="REV 18:8">mbóó mbiꞌi ma̱grui̱guíi̱ atsú jamínu̱ꞌ ríge̱ꞌ:</para>
  <para style="q" vid="REV 18:8">mbayée̱ nandii rí ma̱ja̱ñúu̱, ma̱mbi̱ye̱e̱ꞌ jamí ma̱xki̱dxu̱u̱.</para>
  <para style="q" vid="REV 18:8">Xúꞌkhue̱n máꞌ ma̱mbá-ri̱ga̱a xuajen ga̱jma̱á agu,</para>
  <para style="q" vid="REV 18:8">numuu rí phú mba̱a̱ ski̱yu̱u̱ꞌ Ana̱ꞌlóꞌ Mikhuíí tsí naxúdaa awan ga̱jma̱á numuu̱».<verse eid="REV 18:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9" />Xómáꞌ thúngaa numbaa tsí nibúún jamí nijúwa̱ꞌ mújúún ga̱jma̱á nindxu̱u̱, phú mu̱mbi̱ye̱e̱ꞌ jamí ma̱tájwíin a̱kuíi̱n ído̱ gúyáa̱ gúniúu rí nakhaa̱. <verse eid="REV 18:9" /><verse number="10" style="v" sid="REV 18:10" />Phú ma̱mi̱ꞌñúu̱ gáꞌne jamínu̱ꞌ rúꞌkhue̱n, jamí asndo tsíngua̱ꞌ ma̱wa̱jwíi̱n rí muthee̱n:</para>
  <para style="b" vid="REV 18:10" />
  <para style="q" vid="REV 18:10">«¡Wáái̱i̱ lá xuajen mba̱a̱, phú mingínááꞌ xuajen Babilónia̱, xuajen rí phú mba̱a̱ ski̱yu̱u̱ꞌ!</para>
  <para style="q" vid="REV 18:10">Numuu rí mbégo xúge̱ꞌ ni̱ga̱nú jamínu̱ꞌ inaaꞌ».<verse eid="REV 18:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11" />Xúꞌkhue̱n máꞌ xa̱bo̱ tsí nu̱ngu̱jwa̱ inuu mbá xúgíí numbaa, phú mu̱mbi̱ye̱e̱ꞌ jamí ma̱tájwíin a̱kuíi̱n numuu xuajen rúꞌkhue̱n, numuu rí nimbáa xa̱bo̱ náxáꞌtse̱ rí nu̱ngu̱jwe̱e̱. <verse eid="REV 18:11" /><verse number="12" style="v" sid="REV 18:12" />Rí nu̱ngu̱jwe̱e̱ ñajuun ajwa̱nꞌ mo̱jmo̱ꞌ, ajwa̱nꞌ miꞌxá, itsí mitsaan jamí itsí rí mbiꞌyuu pérla̱, xúꞌkhue̱n máꞌ xtíin máján rí ni̱gu̱ma ga̱jma̱á gúmá líno̱ jamí séda̱, xtíin rí miꞌñuu jamí rí maña̱ꞌ giaxu̱u̱. Mangaa máꞌ mbá xúgíí inii ixe̱ rí ndaa thawuun, mbá xúgíí inii ja̱ꞌne rí na̱gu̱ma ga̱jma̱á itso̱ iñúú xu̱kú, ixe̱ máján, ajwa̱nꞌ brónse̱, yérro̱ jamí itsí rí mbiꞌyuu mármo̱l. <verse eid="REV 18:12" /><verse number="13" style="v" sid="REV 18:13" />Xúꞌkhue̱n máꞌ nu̱ngu̱jwe̱e̱ xtáyoo kanéla̱, iná ndaa thawuun, wájya ndaa thawuun, wájya rí mbiꞌyuu míra̱, iya ndaa thawuun, jamí mangaa máꞌ iyoo úba̱ rí ni̱ga̱yu̱u̱ꞌ, yatsi̱i xndú olíbo̱, jndo̱o̱ꞌ ixí iña rí i̱tha̱án máján, ixí iña, gajmíí máꞌ xede̱, xu̱kú mogo̱, guáyo̱, ixe̱ kixmátaa, jamí yumbáá waꞌtsi̱in. <verse eid="REV 18:13" /><verse number="14" style="v" sid="REV 18:14" />Jamí xa̱bo̱ muthan, mutháa̱n xuajen Babilónia̱:</para>
  <para style="q" vid="REV 18:14">«Nánguá xtaꞌdáá nimbá rí phú na̱ni̱gua̱a̱ꞌ ma̱raꞌdáá rá.</para>
  <para style="q" vid="REV 18:14">Nindáti̱ga̱a̱ꞌ mbá jayu xúgíí rí mitsaan niraꞌdáá,</para>
  <para style="q" vid="REV 18:14">jamí ni miꞌtsú náxáraꞌdáá ne̱».<verse eid="REV 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 18:15" />Xa̱bo̱ tsí ni̱ngu̱jwa̱ xúgíí ríge̱ꞌ jamí phú niguáꞌdáá mbúkha̱a̱ ga̱jma̱á numuu xuajen, ma̱wa̱jwíi̱n tsíngua̱ꞌ inuu Babilónia̱ rí mu̱mbi̱ye̱e̱ꞌ, numuu rí phú ma̱mi̱ꞌñúu̱ rí mu̱dri̱guíi̱ ikhaa máꞌ jamínu̱ꞌ. Xúꞌkhue̱n máꞌ natájwíin a̱kuíi̱n, <verse eid="REV 18:15" /><verse number="16" style="v" sid="REV 18:16" />jamí muthee̱n:</para>
  <para style="q" vid="REV 18:16">«¡Wáái̱i̱ lá xuajen, ngínáa xuajen mba̱a̱!</para>
  <para style="q" vid="REV 18:16">Ikhaa̱ nijúwuu̱n xtíin máján rí ni̱gu̱ma ga̱jma̱á gúmá líno̱, rí miꞌñuu jamí rí maña̱ꞌ giaxu̱u̱,</para>
  <para style="q" vid="REV 18:16">jamí neꞌne-karatha-mine̱e̱ꞌ ga̱jma̱á ajwa̱nꞌ mo̱jmo̱ꞌ,</para>
  <para style="q" vid="REV 18:16">ga̱jma̱á máꞌ itsí mitsaan jamí itsí rí mbiꞌyuu pérla̱.<verse eid="REV 18:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="REV 18:17" />Numuu rí mbégo xúge̱ꞌ wámba̱a mbá xúgíí rí ni̱gi̱ꞌdoo̱ mi̱ndaꞌkho».</para>
  <para style="b" vid="REV 18:17" />
  <para style="p" vid="REV 18:17">Mbá xúgíin xa̱bo̱ tsí nagóó juñu̱ú guꞌwá-rguwa, xa̱bo̱ tsí nune̱-numa rí nagóó ná awúun ne̱, xa̱bo̱ tsí nu̱ñajun ná awúun ne̱ mangaa, jamí xa̱bo̱ tsí jayá mbiꞌñúú ga̱jma̱á rí ríga̱ ná awúun iya a̱pha̱, mbá xúgíin tsúꞌkhue̱n niwájwii̱n tsíngua̱ꞌ. <verse eid="REV 18:17" /><verse number="18" style="v" sid="REV 18:18" />Jamí ído̱ ndiyáa̱ gúní jamí ri̱ꞌyu̱u̱ agu rí nakha xuajen, nithee̱n: «Ni miꞌtsú táríga̱ mbá xuajen rí phú mba̱a̱ ski̱yu̱u̱ꞌ xómá Babilónia̱». <verse eid="REV 18:18" /><verse number="19" style="v" sid="REV 18:19" />A̱ꞌkhue̱n ni̱strámáa̱ yujnda̱ꞌ idxúu̱n numuu rí natájwíin a̱kuíi̱n, jamí nu̱mbi̱ye̱e̱ꞌ rí nuthee̱n:</para>
  <para style="b" vid="REV 18:19" />
  <para style="q" vid="REV 18:19">«¡Wáái̱i̱ lá xuajen mba̱a̱!</para>
  <para style="q" vid="REV 18:19">Ikhaa̱ niꞌnii̱ rí mbá xúgíin xa̱bo̱ tsí guáꞌdáá guꞌwá-rguwa ná awúun iya a̱pha̱,</para>
  <para style="q" vid="REV 18:19">mu̱guaꞌdáá guéño mbúkha̱a̱,</para>
  <para style="q" vid="REV 18:19">jamí mbégo xúge̱ꞌ wámba̱-ri̱ga̱a mbá xúgíí rí gíꞌdoo̱».<verse eid="REV 18:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="REV 18:20" />Ga̱ꞌdxu a̱kia̱nꞌlaꞌ, tsáanꞌ juwalaꞌ mikhuíí,</para>
  <para style="q" vid="REV 18:20">tsáanꞌ ñajwanlaꞌ xa̱bi̱i Ana̱ꞌlóꞌ.</para>
  <para style="q" vid="REV 18:20">Ga̱ꞌdxu a̱kia̱nꞌlaꞌ tsáanꞌ ñajwanlaꞌ tsí waxúngui̱inꞌ</para>
  <para style="q" vid="REV 18:20">jamí tsáanꞌ ni̱rawíjnga̱alaꞌ ajngóo Ana̱ꞌlóꞌ,</para>
  <para style="q" vid="REV 18:20">numuu rí Ana̱ꞌlóꞌ niꞌnii̱ rí Babilónia̱ ma̱grui̱gú jamínu̱ꞌ</para>
  <para style="q" vid="REV 18:20">ga̱jma̱á numuu rí niña̱ꞌlaꞌ xa̱bo̱ xuajen rúꞌkhue̱n.<verse eid="REV 18:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21" />A̱ꞌkhue̱n ni̱ꞌkha̱ mbáa ánje̱l tsí phú mba̱a̱ ski̱yu̱u̱ꞌ, niwatuu̱n mbá itsí rí mba̱a̱ mi̱ndaꞌkho, rí xómá tse̱no̱ jaꞌnii, nixpátuáꞌée̱n ne̱ ná awúun iya a̱pha̱ jamí niꞌthúu̱n xuajen:</para>
  <para style="b" vid="REV 18:21" />
  <para style="q" vid="REV 18:21">«Xkuaꞌnii máꞌ mi̱dxo̱ꞌ mbayíí mangáánꞌ,</para>
  <para style="q" vid="REV 18:21">Babilónia̱, xuajen mba̱a̱,</para>
  <para style="q" vid="REV 18:21">jamí ma̱mbá-ri̱gáanꞌ mbá jayu.<verse eid="REV 18:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="REV 18:22" />Ni miꞌtsú náxáwán ná awúun xuajñaaꞌ</para>
  <para style="q" vid="REV 18:22">ajmúú rí nawán ga̱jma̱á ixe̱ nidi̱í rí gíꞌdoo nítúu, e̱ꞌe̱n, ni máꞌ ga̱jma̱á ajwa̱nꞌ e̱ꞌmbi.</para>
  <para style="q" vid="REV 18:22">Ni miꞌtsú náxákujmii ikhín</para>
  <para style="q" vid="REV 18:22">xa̱bo̱ tsí na̱ma̱ñúú nune̱ asndo náá máꞌ ñajun.</para>
  <para style="q" vid="REV 18:22">Ni miꞌtsú náxáwán rí nuno̱ xa̱bo̱</para>
  <para style="q" vid="REV 18:22">ga̱jma̱á tse̱no̱ ná xuajñaaꞌ.<verse eid="REV 18:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="REV 18:23" />Ni miꞌtsú náxámbiꞌi nimbá agu ná nijúwa̱ꞌ xa̱bo̱.</para>
  <para style="q" vid="REV 18:23">Ni miꞌtsú náxáríga̱ ndxa̱a̱ rí nuda-mijná xa̱bo̱ mangaa.</para>
  <para style="q" vid="REV 18:23">Numuu rí xa̱bia̱aꞌ tsí nu̱ngu̱jwa̱, phú mba̱a̱ tsiakhe̱ niguáꞌdáa̱ ná numbaa,</para>
  <para style="q" vid="REV 18:23">xúꞌkhue̱n máꞌ nithane̱-nduwaa mbá xúgíí numbaa ga̱jma̱á tsirájá dríga̱a̱ꞌ.<verse eid="REV 18:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="REV 18:24" />Ikháánꞌ xuajen Babilónia̱, gíꞌmáá aꞌkhán rí niradíin tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ, xúꞌkhue̱n máꞌ tsí ñajúún xa̱bi̱i Ana̱ꞌlóꞌ,</para>
  <para style="q" vid="REV 18:24">jamí gíꞌmáá aꞌkhán ga̱jma̱á numúú mbá xúgíin tsí nijáñúú nene̱ xa̱bo̱ ná inuu mbá xúgíí numbaa».<verse eid="REV 18:24" /></para>
  <chapter eid="REV 18" />
  <chapter number="19" style="c" sid="REV 19" />
  <para style="s">Ajmúú rí na̱gu̱ma ná mikhuíí</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1" />Nda̱wa̱á a̱ꞌkhue̱n ni̱dxawuun ná mikhuíí, asndo xómá a̱ꞌwúún xa̱bo̱ tsí phú mbaꞌiin mi̱ndaꞌkho jaꞌnii, tsí nuthan ajngáa ríge̱ꞌ:</para>
  <para style="b" vid="REV 19:1" />
  <para style="q" vid="REV 19:1">«¡A̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ!</para>
  <para style="q" vid="REV 19:1">Ikhaa̱ neꞌne-jríñáa̱ꞌlóꞌ,</para>
  <para style="q" vid="REV 19:1">ikhaa̱ jaꞌyoo̱ rí ma̱grui̱guíi̱ gamaku, naꞌnii̱ rí phú wáá,</para>
  <para style="q" vid="REV 19:1">jamí ikhaa̱ phú gíꞌdoo̱ tsiakhe̱.<verse eid="REV 19:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="REV 19:2" />Numuu rí Ana̱ꞌlóꞌ naxudaa mújúun awan jamí jmbu ga̱jma̱á numúú xa̱bo̱.</para>
  <para style="q" vid="REV 19:2">Ikhaa̱ niꞌnii̱ rí ma̱grui̱gú jamínu̱ꞌ a̱ꞌgo̱ tsí na̱ngu̱jwa̱-mina̱ꞌ mi̱ndaꞌkho,</para>
  <para style="q" vid="REV 19:2">tsí nibóo gajmíí mbaꞌiin xa̱bo̱ jamí neꞌne-maꞌkhíi numbaa.</para>
  <para style="q" vid="REV 19:2">Ana̱ꞌlóꞌ neꞌne rí mamínu̱u̱ꞌ a̱ꞌgo̱ tsúꞌkhue̱n,</para>
  <para style="q" vid="REV 19:2">kajngó ma̱ꞌne-numaa̱ rí ni̱gu̱díi̱n yumbée Ana̱ꞌlóꞌ».<verse eid="REV 19:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="REV 19:3" />A̱ꞌkhue̱n nithee̱n mbu̱júꞌ:</para>
  <para style="b" vid="REV 19:3" />
  <para style="q" vid="REV 19:3">«¡A̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ!</para>
  <para style="q" vid="REV 19:3">Numuu rí jámuu ma̱we̱je̱ gúniúu rí nakhaa a̱ꞌgo̱ tsúꞌkhue̱n».<verse eid="REV 19:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="REV 19:4" />A̱ꞌkhue̱n rí xa̱bo̱ buanuu tsí mbá skíñú akhu̱un (24) jamí mbá akhu̱un máꞌ tsí nduya, ni̱smáti̱gúu̱n rí mune̱-mba̱a̱ Ana̱ꞌlóꞌ, tsí ꞌgí ná xíli̱i thúngaa, jamí nithee̱n:</para>
  <para style="b" vid="REV 19:4" />
  <para style="q" vid="REV 19:4">«¡Xkuaꞌnii gáꞌne! ¡A̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ!».<verse eid="REV 19:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5" />A̱ꞌkhue̱n nigájnuu mbá a̱ꞌwá ná ꞌgí xíli̱i thúngaa, rí niꞌthán:</para>
  <para style="b" vid="REV 19:5" />
  <para style="q" vid="REV 19:5">«¡Gu̱ne̱-mba̱a̱laꞌ Ana̱ꞌlóꞌ mbá xúgiáanꞌ ikháanꞌlaꞌ, tsáanꞌ ñajwanlaꞌ yumbée̱,</para>
  <para style="q" vid="REV 19:5">mbá xúgiáanꞌ ikháanꞌlaꞌ tsáanꞌ ndu̱ya̱-makuíi̱laꞌ,</para>
  <para style="q" vid="REV 19:5">xa̱bo̱ tsí makiin jamí xa̱bo̱ tsí mba̱ꞌwu̱un!».<verse eid="REV 19:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="REV 19:6" />A̱ꞌkhue̱n ni̱dxawuun mbaꞌa a̱ꞌwá, xómá a̱ꞌwúún xa̱bo̱ tsí mbaꞌiin mi̱ndaꞌkho jaꞌnii, xómá a̱ꞌwóo mbá xtangaya rí phú mba̱a̱ jaꞌnii, jamí xómá gakhe̱ nawán ído̱ rí naxpíbi mikhuíí jaꞌnii. Xáꞌnii iꞌthán a̱ꞌwá:</para>
  <para style="b" vid="REV 19:6" />
  <para style="q" vid="REV 19:6">«¡A̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ!</para>
  <para style="q" vid="REV 19:6">Numuu rí naꞌthán-ñájun máꞌ Táta̱, Ana̱ꞌlóꞌ tsí gíꞌdoo mbá xúgíí tsiakhe̱.<verse eid="REV 19:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="REV 19:7" />Ga̱ꞌdxu a̱kia̱nꞌlóꞌ, ga̱juwalóꞌ gagi</para>
  <para style="q" vid="REV 19:7">jamí gu̱ꞌne̱-mba̱a̱lóꞌ Ana̱ꞌlóꞌ.</para>
  <para style="q" vid="REV 19:7">Numuu rí ni̱ga̱nú máꞌ mbiꞌi rí manigúún A̱ꞌdá-mógó,</para>
  <para style="q" vid="REV 19:7">jamí xtáa̱ máꞌ na̱ma̱ñuu tsí ma̱ꞌne a̱ꞌguii̱.<verse eid="REV 19:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="REV 19:8" />Jamí nijanáa̱ majúwuu̱n xtíin máján rí ni̱gu̱ma ga̱jma̱á gúmá líno̱,</para>
  <para style="q" vid="REV 19:8">rí jaꞌwu jamí nambiꞌi-taꞌa».</para>
  <para style="q" vid="REV 19:8">Numuu rí xtíin máján rí ni̱gu̱ma ga̱jma̱á gúmá líno̱, naꞌne xtiꞌkhuu rí máján nune̱ xa̱bi̱i Ana̱ꞌlóꞌ.<verse eid="REV 19:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9" />A̱ꞌkhue̱n niꞌthínꞌlo̱ꞌ ánje̱l: «Aratháán ríge̱ꞌ: “Gagi júwa̱ꞌ xa̱bo̱ tsí watsaꞌwúún rí mu̱peꞌtso-añúú ná manigúún A̱ꞌdá-mógó”». Jamí niꞌthínꞌ xóó: «Ajngáa rawuun Ana̱ꞌlóꞌ rí phú gakon ñajuun ríge̱ꞌ».<verse eid="REV 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10" />A̱ꞌkhue̱n ni̱smáti̱go̱ꞌ ná nakhúu ánje̱l kajngó ma̱ne̱-mba̱a̱lo̱ꞌ, xómáꞌ ikhaa̱ niꞌthínꞌ: «¡Ma̱xátha̱ne̱ rúꞌkhue̱n! Athane̱-mba̱a̱ i̱ndo̱ó máꞌ Ana̱ꞌlóꞌ, numuu rí yumbáá máꞌ ñajunꞌ mangúúnꞌ, xómá rí ikháánꞌ jamí xómá a̱ngia̱anꞌ tsí tsíni̱ꞌñáá gisngáá drígo̱o̱ Jesús. Tsí nuthan-raꞌa ajngóo Jesús, guáꞌdáa̱ xu̱únꞌ tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ».<verse eid="REV 19:10" /></para>
  <para style="s">Xa̱bo̱ tsí ríguu guáyo̱ miꞌxáa</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11" />Nda̱wa̱á a̱ꞌkhue̱n ndi̱yo̱o̱ rí ja̱ma̱ꞌtha mikhu, jamí nikujmaa mbáa guáyo̱ miꞌxáa. Xómáꞌ xa̱bo̱ tsí ríguu guáyo̱ mbiꞌyuu̱ «Tsí Jmbii jamí Kuwiin», numuu rí phú jmbii̱ ído̱ rí na̱ra̱jwe̱e̱ꞌ jamí ído̱ rí naꞌnii̱ xkujndu. <verse eid="REV 19:11" /><verse number="12" style="v" sid="REV 19:12" />Rí iduu̱ nambiꞌi-taꞌa xómá ri̱ꞌyu̱u̱ agu, jamí tráma mbaꞌa ajwa̱nꞌ gamaku rí jndi ná idxu̱u̱. Ka̱ma waꞌtháán mbiꞌyuu̱ rí tsíꞌne-nuwiin nimbáa, rí i̱ndo̱ó máꞌ ikhaa̱ iꞌyoo̱. <verse eid="REV 19:12" /><verse number="13" style="v" sid="REV 19:13" />Xómáꞌ xtíin rí júwuu̱n niꞌña̱to̱ꞌoo iꞌdi, jamí rí mbiꞌyuu̱ ñajuun: «Ajngóo Ana̱ꞌlóꞌ». <verse eid="REV 19:13" /><verse number="14" style="v" sid="REV 19:14" />Naguwá ga̱jma̱á nindxu̱u̱ mbaꞌiin mi̱ndaꞌkho xa̱bo̱ tsí ku̱ra̱tuun ajwa̱nꞌ, tsí júwa̱ꞌ ná mikhuíí. Trámúu̱ guáyo̱ miꞌxíin mangii̱n jamí júwúu̱n xtíin líno̱ rí phú máján, rí miꞌxá jamí jaꞌwu. <verse eid="REV 19:14" /><verse number="15" style="v" sid="REV 19:15" />Ná rawuu̱n nagájnuu mbá chíde̱ xíni kajngó ma̱ꞌne-jámbi̱yu̱u̱ꞌ mbá xúgíí xuajen numbaa. Maꞌthán-ñájuu̱n ne̱ ga̱jmáa̱ nixí ajwa̱nꞌ rí gúkú mi̱ndaꞌkho, jamí jmína̱a̱ꞌ máꞌ ikhaa̱ maxúꞌduu̱n xndú úba̱ ga̱jma̱á nakhúu̱ kajngó ma̱ga̱jnúu iyoo ne̱. Rí iyoo úba̱ naꞌne xtiꞌkhuu rí najiꞌnáa Ana̱ꞌlóꞌ tsí gíꞌdoo mbá xúgíí tsiakhe̱. <verse eid="REV 19:15" /><verse number="16" style="v" sid="REV 19:16" />Ná xtíñuu̱ jamí ná sndi̱yu̱u̱ꞌ ka̱ma waꞌtháán mbiꞌyuu ríge̱ꞌ: «Thúngaa tsí naꞌthán-ñájúún mbá xúgíin thúngaa jamí Xa̱bo̱ Ede̱ tsí jayá ikhúún mbá xúgíin xa̱bo̱ ede̱».<verse eid="REV 19:16" /></para>
  <para style="s">Nakhuáa xu̱kú xkawi̱i̱ꞌ</para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17" />Nda̱wa̱á a̱ꞌkhue̱n ndi̱yo̱o̱ wéje̱ mbáa ánje̱l ná inuu a̱kha̱ꞌ, nindxaꞌwée̱ inúú mbá xúgíin xu̱kú xna tsí ngrigu̱ún ná inuu gíñá: «A̱guwalaꞌ, gu̱ru̱wa-mijnáalaꞌ kajngó mu̱peꞌtso-añalaꞌ ná ndxa̱a̱ mba̱a̱ rí neꞌne-mújúun Ana̱ꞌlóꞌ. <verse eid="REV 19:17" /><verse number="18" style="v" sid="REV 19:18" />A̱guwalaꞌ mu̱pholaꞌ xuñúú thúngaa, xuñúú xa̱bo̱ tsí nuthan-ñajúún tsí ku̱ra̱tuun ajwa̱nꞌ, xuñúú xa̱bo̱ tsí gakhe̱ a̱kui̱ín. Xúꞌkhue̱n máꞌ mu̱pholaꞌ xuñúú guáyo̱ jamí xa̱bo̱ tsí trámii tsu̱dúu̱n, xuñúú mbá xúgíí inii xa̱bo̱, xa̱bo̱ tsí nuthan-ñajun-mijná máꞌ ikhiin jamí yumbáá waꞌtsi̱in, xa̱bo̱ tsí makiin jamí xa̱bo̱ tsí mba̱ꞌwu̱un».<verse eid="REV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19" />A̱ꞌkhue̱n ndi̱yo̱o̱ xu̱kú xkawi̱i̱ꞌ jamí ndi̱ñu̱ú thúngaa tsí nuthan-ñajun ná numbaa, gajmíi̱ xa̱bíi̱n tsí ku̱ra̱tuun ajwa̱nꞌ. Ni̱ru̱wa-mijnáa̱ rí muni̱i̱ xkujndu gajmíi̱ tsí ríguu guáyo̱ miꞌxáa jamí gajmíi̱ xa̱bii̱ tsí ku̱ra̱tuun ajwa̱nꞌ. <verse eid="REV 19:19" /><verse number="20" style="v" sid="REV 19:20" />Tsí xu̱kú xkawi̱i̱ꞌ nikhuáa̱ ga̱jmáa̱ tsí na̱gu̱wíjnga̱a ajngáa mi̱nduwa. Ikhaa tsíge̱ꞌ ñajuun tsí neꞌne rí phú wáá ná inuu xu̱kú xkawi̱i̱ꞌ, jamí ga̱jma̱á majñu̱u̱ rúꞌkhue̱n neꞌne-nduwii̱n tsí ni̱dri̱gú tsinuu xu̱kú xkawi̱i̱ꞌ jamí nene̱-mba̱a̱ xtiꞌkhuu̱. Nájmi̱i tsíge̱ꞌ waxúꞌdu-maꞌíi̱n ná awúun agu a̱pha̱ rí nakha ga̱jma̱á asúfre̱. <verse eid="REV 19:20" /><verse number="21" style="v" sid="REV 19:21" />Xómáꞌ tsí i̱ꞌwíin, nijáñúu̱ ga̱jma̱á chíde̱ rí nagájnuu ná rawuun tsí ríguu guáyo̱ miꞌxáa, jamí mbá xúgíin xu̱kú xna niꞌphi̱i̱ asndo ni̱gi̱ꞌmúu̱ xuñúú xa̱bo̱ tsí nijáñúú.<verse eid="REV 19:21" /></para>
  <chapter eid="REV 19" />
  <chapter number="20" style="c" sid="REV 20" />
  <para style="s">Naxtoꞌwóo gixa̱a̱ mbá míl tsigu</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1" />A̱ꞌkhue̱n ndi̱yo̱o̱ rí na̱ga̱taa mbáa ánje̱l ná mikhuíí, jayée̱ rí marmáꞌthoo̱ xkrugoo iñá rí me̱jno̱ꞌ, jamí jayée̱ mbá ñuu ajwa̱nꞌ mba̱a̱. <verse eid="REV 20:1" /><verse number="2" style="v" sid="REV 20:2" />Nigatuwii̱n a̱bo̱ꞌ maña̱a̱ꞌ tsí phú mba̱a̱, tsí xtáa̱ wajyúú mbiꞌi, ikhaa máꞌ tsí ñajuun gixa̱a̱ jamí Satanás, niroꞌwóo̱ mbá míl (1 000) tsigu. <verse eid="REV 20:2" /><verse number="3" style="v" sid="REV 20:3" />A̱ꞌkhue̱n nida-maꞌáa̱n ná awúun iñá rí me̱jno̱ꞌ. Ikhín nirugua-raꞌaa̱ jamí niruguaa̱ xa̱ꞌ rawuun iñá, kajngó náxágájnuu̱ ná inuu numbaa rí ma̱ꞌne-nduwii̱n xa̱bo̱ awúun rí mbá míl tsigu. Ído̱ gájráꞌáan rí mbá míl tsigu, a̱ꞌkhue̱n mi̱ꞌkhuíí gixa̱a̱, kajngó ma̱ngrigo̱o̱ꞌ mbá wátha̱ wáa mbiꞌi.<verse eid="REV 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4" />A̱ꞌkhue̱n ndi̱yo̱o̱ xíli̱ín xa̱bo̱ ñajun, ikhín nitrigi̱in tsí nijanúú tsiakhe̱ rí mu̱xu̱da̱a̱ꞌ awan. Xúꞌkhue̱n máꞌ ndi̱yo̱o̱ ními̱í tsí ni̱ga̱taa idxu̱ún nene̱ xa̱bo̱, numuu nithee̱n rí nune̱-nuwii̱n Jesús, jamí ga̱jma̱á numuu ajngáa rawuun Ana̱ꞌlóꞌ. Tsíge̱ꞌ ñajúún tsí túne̱-mba̱a̱ xu̱kú xkawi̱i̱ꞌ ni máꞌ túne̱-mba̱a̱ xtiꞌkhuu̱, ni máꞌ túni̱ꞌñá-mijnée̱ rí ma̱gi̱ꞌma tsinuu̱ ná jédúu̱n ni máꞌ ná ñawúu̱n. Ndiyaa̱ mbiꞌñúu̱ jamí nithan-ñajwii̱n gajmíi̱ Krísto̱ mbá míl tsigu. <verse eid="REV 20:4" /><verse number="5" style="v" sid="REV 20:5" />Ríge̱ꞌ ñajuun timbá rí nduya̱a mbiꞌñúú tsí nijáñúú. Xómáꞌ i̱ꞌwíin tsí nijáñúú, na̱nguá ndiyaa̱ mbiꞌñúu̱ asndo gájráꞌáan rí mbá míl tsigu. <verse eid="REV 20:5" /><verse number="6" style="v" sid="REV 20:6" />Phú gagi júwa̱ꞌ xa̱bi̱i Ana̱ꞌlóꞌ tsí mbuya̱a mbiꞌñúú timbá miꞌtsú rí ma̱wa̱xúun tsí nijáñúú. Náxájáñúu̱ rí riajma̱ nothon, numuu rí ikhii̱n ma̱nindxúu̱n dxakuiin Ana̱ꞌlóꞌ jamí dxakuiin Krísto̱, xúꞌkhue̱n máꞌ muthan-ñajwii̱n ga̱jma̱á nindxu̱u̱ mbá míl tsigu.<verse eid="REV 20:6" /></para>
  <para style="s">Gixa̱a̱ mamínu̱u̱ꞌ ná awúun agu rí nakha jámuu</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7" />Ído̱ gájráꞌáan rí mbá míl (1 000) tsigu, a̱ꞌkhue̱n mi̱ꞌkhuíi Satanás ná rí júgua-raꞌaa, <verse eid="REV 20:7" /><verse number="8" style="v" sid="REV 20:8" />jamí ma̱ꞌgee̱ gáꞌne-nduwii̱n xa̱bo̱ tsí júwa̱ꞌ ná mbá nákho̱ rakhóo numbaa, ikhaa rí ñajuun numbaa Góg jamí Magóg. A̱ꞌkhue̱n ma̱ru̱wii̱n xa̱bo̱ tsí juda ajwa̱nꞌ mune̱ xkujndu, jamí ma̱ꞌne mbaꞌii̱n mi̱ndaꞌkho xómá we̱ꞌe̱ rí ríga̱ ná rawuun iya a̱pha̱. <verse eid="REV 20:8" /><verse number="9" style="v" sid="REV 20:9" />Mbá xúgíí numbaa ma̱guwá xa̱bi̱i gixa̱a̱. Mu̱xu̱ꞌma-mijnée̱ jamí mu̱rugua-maꞌáa̱n ná gachúún xa̱bi̱i Ana̱ꞌlóꞌ, ná xuajen rí nandoo jaꞌyoo Ana̱ꞌlóꞌ. Xómáꞌ Ana̱ꞌlóꞌ ma̱ꞌne rí ma̱ga̱taa agu mikhuíí rí matsikhíi̱n mbá jayu. <verse eid="REV 20:9" /><verse number="10" style="v" sid="REV 20:10" />Xómáꞌ gixa̱a̱, tsí neꞌne-nduwiin xa̱bo̱ tsúꞌkhue̱n, mi̱ꞌdaa̱ ná awúun agu a̱pha̱ rí nakha ga̱jma̱á asúfre̱, ná waꞌdaa máꞌ xu̱kú xkawi̱i̱ꞌ ga̱jma̱á tsí na̱gu̱wíjnga̱a ajngáa rí mi̱nduwa mangaa. Ikhín mu̱míníi̱ mbiꞌíí mbruꞌwíín jamí jámuu mbiꞌi.<verse eid="REV 20:10" /></para>
  <para style="s">Na̱to̱ꞌo̱o̱ awan ga̱jma̱á numúú tsí nijáñúú</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11" />Nda̱wa̱á a̱ꞌkhue̱n ndi̱yo̱o̱ mbá xíle̱ mba̱a̱ miꞌxá ná na̱ge̱ꞌe̱ thúngaa, jamí mbáa tsí ꞌgí ná inuu ne̱. Xómáꞌ mikhu ga̱jma̱á ju̱ba̱ꞌ nindánti̱ga̱ ne̱ ná inuu̱, jamí nánguá nikujma náá ni̱ka̱ ne̱. <verse eid="REV 20:11" /><verse number="12" style="v" sid="REV 20:12" />Jamí ndi̱ñu̱ú tsí nijáñúú, wájwii̱n ná inuu ꞌgí xíli̱i Ana̱ꞌlóꞌ, xa̱bo̱ mba̱ꞌwu̱un jamí xa̱bo̱ tsí makiin. A̱ꞌkhue̱n ni̱ma̱ꞌthoo mbá tikhu i̱yi̱i̱ꞌ, xúꞌkhue̱n máꞌ ni̱ma̱ꞌthoo i̱mba̱ i̱yi̱i̱ꞌ mangaa, ná tima mbiꞌñúú tsí nduya jámuu. A̱ꞌkhue̱n ni̱to̱ꞌo̱o̱ awan ga̱jma̱á numúú tsí nijáñúú xómá jaꞌyoo rí neꞌne mbámbáa, jamí xómá waꞌtháán ná awúun i̱yi̱i̱ꞌ rúꞌkhue̱n. <verse eid="REV 20:12" /><verse number="13" style="v" sid="REV 20:13" />Xómáꞌ iya a̱pha̱ nixnáxii̱n xa̱bo̱ tsí nijáñúú ná awúu̱n, xúꞌkhue̱n máꞌ neꞌne tsiakhe̱ rí na̱gu̱díin xa̱bo̱ jamí iñá-wajíín mangaa, nixnáxii̱n tsí gachúún ikhín. Mbá xúgíi̱n tsí nijáñúú ni̱to̱ꞌo̱o̱ awan ga̱jma̱á numúu̱, xómá jaꞌyoo rí neꞌne mbámbáa. <verse eid="REV 20:13" /><verse number="14" style="v" sid="REV 20:14" />A̱ꞌkhue̱n tsiakhe̱ rí na̱gu̱díin xa̱bo̱ jamí iñá-wajíín, nájma̱ ne̱ waꞌda-maꞌán ná awúun agu a̱pha̱. Ríge̱ꞌ ñajuun rí ma̱ja̱ñúú xa̱bo̱ rí riajma̱ nothon. <verse eid="REV 20:14" /><verse number="15" style="v" sid="REV 20:15" />Jamí jámba̱a̱ xa̱bo̱ tsí tákujma̱a mbiꞌyuu ná awúun i̱yi̱i̱ꞌ rí ka̱ma mbiꞌñúú tsí nduya jámuu, waꞌda-maꞌáa̱n ná awúun agu a̱pha̱.<verse eid="REV 20:15" /></para>
  <chapter eid="REV 20" />
  <chapter number="21" style="c" sid="REV 21" />
  <para style="s">Xuajen Jerusalén rí nuxe̱ꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1" />Nda̱wa̱á a̱ꞌkhue̱n ndi̱yo̱o̱ mbá mikhu nuxe̱ꞌ jamí mbá ju̱ba̱ꞌ nuxe̱ꞌ, numuu rí mikhu jamí ju̱ba̱ꞌ rí ginii nánda̱a̱ ne̱. Nánda̱a̱ máꞌ iya a̱pha̱ mangaa. <verse eid="REV 21:1" /><verse number="2" style="v" sid="REV 21:2" />Jamí ikhúúnꞌ Juáán<note caller="+" style="f"><char style="fr" closed="false">21.2 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí tsíꞌthán «ikhúúnꞌ Juáán».</char></note> ndi̱yo̱o̱ xuajñuu Ana̱ꞌlóꞌ mangaa, xuajen Jerusalén rí nuxe̱ꞌ, rí na̱ga̱taa mikhuíí ná xtáa Ana̱ꞌlóꞌ, asndo xó mbáa dxáꞌgú tsí neꞌne-karatha-mina̱aꞌ rí mbayáa a̱jmbe̱e jaꞌnii ne̱. <verse eid="REV 21:2" /><verse number="3" style="v" sid="REV 21:3" />A̱ꞌkhue̱n ni̱dxawuun mbá a̱ꞌwá rí phú gakhe̱ naꞌthán ná mikhuíí:<note caller="+" style="f"><char style="fr" closed="false">21.3 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «ná ꞌgí xíli̱i thúngaa».</char></note> «A̱gu̱ya̱álaꞌ rí ná majñu̱ú xa̱bo̱ numbaa ꞌgí guꞌwóo Ana̱ꞌlóꞌ rí xúge̱ꞌ rá, jamí ikhaa̱ ma̱xtáa̱ gajmíi̱. Xómáꞌ ikhii̱n ma̱nindxúu̱n xa̱bo̱ xuajñuu̱, jamí jmína̱a̱ꞌ máꞌ Ana̱ꞌlóꞌ ma̱nindxu̱u̱ Anúu̱. <verse eid="REV 21:3" /><verse number="4" style="v" sid="REV 21:4" />Ana̱ꞌlóꞌ maxúdíi mbá jayu iyoo idúu̱n. A̱ꞌkhue̱n rí nánguá ma̱ja̱ñúu̱, ni máꞌ nánguá mu̱mbi̱ye̱e̱ꞌ, ni máꞌ nánguá mu̱míníi̱, ni máꞌ nánguá me̱kho̱ xuñúu̱, numuu rí wámba̱ máꞌ rí ni̱ꞌkha̱-raríga̱ nákhí wapha».<verse eid="REV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5" />Xómáꞌ tsí ꞌgí ná xíli̱i thúngaa niꞌthán: «Ikhúúnꞌ na̱ne̱ nuxe̱ꞌ mbá xúgíí». Jamí niꞌthée̱n mangaa: «Aratháán, numuu rí ajngáa rí gakon ñajuun ríge̱ꞌ, jamí jaꞌyoo rí ma̱nimbu̱únꞌ ne̱ xa̱bo̱».<verse eid="REV 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 21:6" />Nda̱wa̱á niꞌthínꞌ: «¡Mbá xúgíí máꞌ ni̱gu̱ma rá! Ikhúúnꞌ ñajunꞌ xómá tsina Álfa̱ jamí xómá tsina Oméga̱, tsí na̱gi̱ꞌdu̱u̱n-muu jamí tsí ndámba̱wóo. Tsí najándawoo, ma̱xnu̱u̱ ma̱ga̱a̱n yaꞌsi iduu iya rí nangujwíi inuu ju̱ba̱ꞌ. Jamí ma̱xáru̱maa̱ máꞌ ga̱jma̱á numuu iya rúꞌkhue̱n, rí naꞌne rí ma̱ju̱wá jámuu xa̱bo̱. <verse eid="REV 21:6" /><verse number="7" style="v" sid="REV 21:7" />Mbá xúgíí ríge̱ꞌ ma̱xnu̱u̱ tsí ma̱ꞌngo̱o̱, xómáꞌ ikhúúnꞌ ma̱nindxu̱ꞌ Anu̱u̱ jamí ikhaa̱ ma̱nindxu̱u̱ a̱ꞌdéꞌ. <verse eid="REV 21:7" /><verse number="8" style="v" sid="REV 21:8" />Xómáꞌ tsí namíñúú rá, tsí tsínimbu̱únꞌ, tsí nune̱ rí xkawe̱ꞌ, tsí nu̱radíin xa̱bo̱, tsí nubúún gajmíí xa̱bo̱ tsí túya̱a̱, tsí nune̱ xawan, tsí nune̱-mbi̱in tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún, jamí mbá xúgíin tsí nune̱-nduwa, xúgíin tsúꞌkhue̱n magóo̱ ná awúun agu a̱pha̱ rí nakha ga̱jma̱á asúfre̱. Ríge̱ꞌ ñajuun rí ma̱ja̱ñúú xa̱bo̱ rí riajma̱ nothon».<verse eid="REV 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9" />Nda̱wa̱á a̱ꞌkhue̱n ni̱ꞌkha̱ mbáa ánje̱l ná inuꞌ, mbáa máꞌ tsí juwiin juda juwan xúba̱ me̱jno̱ꞌ rí gajni̱í jamínu̱ꞌ rí ma̱ꞌkha̱ nda̱wa̱á jayu, jamí niꞌthínꞌ: «Aya̱ ge̱jyoꞌ. Ma̱snga̱jmáaꞌ dxáꞌgú tsí ma̱ꞌne a̱ꞌgui̱i A̱ꞌdá-mógó». <verse eid="REV 21:9" /><verse number="10" style="v" sid="REV 21:10" />A̱ꞌkhue̱n rí ánje̱l ni̱ka̱ jañúú ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ ná inuu mbá júba̱ mba̱a̱ jamí tsída̱ꞌ. Ikhín nisngájmiꞌ xuajñuu Ana̱ꞌlóꞌ, ikhaa xuajen mba̱a̱ Jerusalén, rí na̱ga̱taa mikhuíí ná inuu Ana̱ꞌlóꞌ. <verse eid="REV 21:10" /><verse number="11" style="v" sid="REV 21:11" />Nambiꞌi-taꞌa aguu Ana̱ꞌlóꞌ ná xuajen ído̱ na̱ka̱-ra̱ga̱taa. Nambiꞌi-taꞌa ne̱ xómá itsí rí mitsaan mi̱ndaꞌkho, xómá itsí rí mbiꞌyuu jáspe̱ rí nafraꞌa̱ xómá iyaniwan. <verse eid="REV 21:11" /><verse number="12" style="v" sid="REV 21:12" />Mbá tuaꞌáan júgua-maꞌáan ne̱ ga̱jma̱á mbá xu̱nꞌ me̱do̱ jamí tsída̱ꞌ rí gíꞌdoo gu̱wa̱ꞌ i̱jma̱ (12) xkrugua. Mbámbá xkrugua rúꞌkhue̱n ka̱ma mbiꞌñúú tsí mbá gu̱wa̱ꞌ i̱jmi̱i i̱ji̱in Israél, jamí mbámbá xkrugua ni̱tia̱wa̱án eꞌne mbáa ánje̱l. <verse eid="REV 21:12" /><verse number="13" style="v" sid="REV 21:13" />Atsú xkrugua tima ná giaxu̱u̱ na̱ꞌkha̱ a̱kha̱ꞌ, atsú ne̱ tima ná giaxu̱u̱ naꞌwáán, atsú ne̱ tima ná giaxu̱u̱ jawáá jamí atsú ne̱ tima ná giaxu̱u̱ najngúun a̱kha̱ꞌ. <verse eid="REV 21:13" /><verse number="14" style="v" sid="REV 21:14" />Rí xu̱nꞌ ni̱tu̱xu̱u̱ꞌ ne̱ tsu̱du̱u̱ mbá gu̱wa̱ꞌ i̱jma̱ (12) itsí mba̱ꞌwo̱, jamí ná tsu̱du̱u̱ mbámbá itsí rúꞌkhue̱n waꞌtháán mbiꞌyuu mbámbáa tsí mbá gu̱wa̱ꞌ i̱jmi̱i nixúngui̱inꞌ A̱ꞌdá-mógó.<verse eid="REV 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 21:15" />Ánje̱l tsí naꞌthán ga̱jma̱á nindxu̱ꞌ, jayée̱ mbá xkuíya̱ awan rí ajwa̱nꞌ mo̱jmo̱ꞌ ñajuun kajngó magiéwee̱n xuajen, xkrugoo ne̱ jamí xu̱nꞌ drígo̱o̱ ne̱. <verse eid="REV 21:15" /><verse number="16" style="v" sid="REV 21:16" />A̱ꞌkhue̱n rí ánje̱l nigiéwee̱n xuajen ga̱jma̱á xkuíya̱ awan rí jayée̱. Mbéꞌtháán mbá nákho̱ níjñúu ne̱, naꞌne xí 2 200 kilóme̱tro̱<note caller="+" style="f"><char style="fr" closed="false">21.16 </char><char style="ft" closed="false">Ná i̱yi̱i̱ꞌ griégo̱ rí wayuu naꞌthán «gu̱wa̱ꞌ i̱jma̱ míl (12 000) estádio̱», rí gíꞌdoo mbá 185 métro̱ rí mbámbá.</char></note> wáa rí mba̱ꞌ ne̱, xúꞌkhue̱n máꞌ rí ma̱jña̱ꞌ ne̱ jamí rí tsída̱ꞌ ne̱. <verse eid="REV 21:16" /><verse number="17" style="v" sid="REV 21:17" />Nigiéwan ánje̱l xu̱nꞌ drígo̱o̱ ne̱ mangaa, mbá 144<note caller="+" style="f"><char style="fr" closed="false">21.17 </char><char style="ft" closed="false">Rí mbá 144 itso̱ ñawúun xa̱bo̱ gíꞌdoo mbá 65 métro̱ wáa.</char></note> itso̱ ñawúun xa̱bo̱ rí tsída̱ꞌ ne̱. Awan rí nune̱-nuwiin máꞌ xa̱bo̱ ñajuun rí nijmuu ánje̱l. <verse eid="REV 21:17" /><verse number="18" style="v" sid="REV 21:18" />Rí xu̱nꞌ ni̱gu̱ma ne̱ ga̱jma̱á itsí mitsaan rí mbiꞌyuu jáspe̱. Xómáꞌ xuajen mbáko máꞌ i̱ndo̱ó ajwa̱nꞌ mo̱jmo̱ꞌ ñajuun ne̱, nambiꞌi-taꞌa ne̱ xómá iyaniwan rí jaꞌwu. <verse eid="REV 21:18" /><verse number="19" style="v" sid="REV 21:19" />Mbámbá itsí mba̱a̱ rí ꞌgí ná nakhúu xu̱nꞌ ni̱gu̱ma-karatháá ne̱ ga̱jma̱á mbá xúgíí inii itsí rí mitsaan jamí phú numuu. Nakhúu ne̱ rí ginii jayu ni̱gu̱ma-karatháá ga̱jma̱á itsí jáspe̱, rí riajmu̱u̱ ga̱jma̱á safíro̱, rí riatsú ga̱jma̱á ága̱ta̱, rí riakho̱ ga̱jma̱á esmerálda̱, <verse eid="REV 21:19" /><verse number="20" style="v" sid="REV 21:20" />rí tiwitsu ni̱gu̱ma-karatháá ga̱jma̱á óni̱se̱, rí timajun ga̱jma̱á kornalína̱, rí tijwan ga̱jma̱á krisóli̱to̱, rí timigiñu ga̱jma̱á berílo̱, rí timijna-gu̱wa̱ꞌ ga̱jma̱á topásio̱, rí tigu̱wa̱ꞌ ga̱jma̱á krisoprása̱, rí tigu̱wa̱ꞌ i̱mba̱ ga̱jma̱á jasínto̱, jamí rí tigu̱wa̱ꞌ i̱jma̱ ni̱gu̱ma-karatháá ga̱jma̱á amatísta̱. <verse eid="REV 21:20" /><verse number="21" style="v" sid="REV 21:21" />Mbá gu̱wa̱ꞌ i̱jma̱ (12) xkrugoo xu̱nꞌ ñajuun mbá gu̱wa̱ꞌ i̱jma̱ máꞌ itsí mitsaan rí mbiꞌyuu pérla̱. Xómáꞌ jamba̱a̱ ma̱jña̱ꞌ rí kri̱ga̱ ná awúun xuajen rá, mbáko máꞌ i̱ndo̱ó ajwa̱nꞌ mo̱jmo̱ꞌ ñajuun ne̱, nambiꞌi-taꞌa ne̱ xómá iyaniwan.<verse eid="REV 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22" />Táyo̱o̱ nimbá guꞌwá dxákuun ná awúun xuajen rúꞌkhue̱n. Numuu rí Táta̱ Ana̱ꞌlóꞌ tsí gíꞌdoo mbá xúgíí tsiakhe̱ jamí A̱ꞌdá-mógó, ikhii̱n máꞌ ñajúu̱n guꞌwá dxákuun. <verse eid="REV 21:22" /><verse number="23" style="v" sid="REV 21:23" />Na̱nguá máꞌ iꞌyóo rí ma̱ri̱ya̱a̱ꞌ a̱kha̱ꞌ ni máꞌ go̱nꞌ ná xuajen, numuu rí nambiꞌi-taꞌaa máꞌ Ana̱ꞌlóꞌ ná inuu ne̱, jamí A̱ꞌdá-mógó máꞌ mangaa ñajuun aguu ne̱. <verse eid="REV 21:23" /><verse number="24" style="v" sid="REV 21:24" />Jamí xa̱bo̱ xuajen tsí júwa̱ꞌ mbá xúgíí numbaa, tsí ni̱gu̱ma-jáwíin,<note caller="+" style="f"><char style="fr" closed="false">21.24 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí tsíꞌthán «tsí ni̱gu̱ma-jáwíin».</char></note> ma̱mbiꞌñúú ga̱jma̱á aguu ne̱. Jamí thúngaa numbaa ma̱guwá ná xuajen rúꞌkhue̱n, ma̱guwée̱ꞌ-judúu̱n rí mitsaan guáꞌdáa̱ jamí mu̱xna̱xíi̱ gamakúu̱n ikhín. <verse eid="REV 21:24" /><verse number="25" style="v" sid="REV 21:25" />Ni miꞌtsú tsíjúgua̱a xkrugoo xuajen rí mbá jañii mbiꞌi, numuu rí nda̱a̱ máꞌ mbroꞌon rí ikhín. <verse eid="REV 21:25" /><verse number="26" style="v" sid="REV 21:26" />Ikhín magóó judúún xa̱bo̱ mbá xúgíí rí phú mitsaan jamí mbá xúgíí gamaku rí ríga̱ ná tsu̱du̱u̱ mbá xúgíí numbaa. <verse eid="REV 21:26" /><verse number="27" style="v" sid="REV 21:27" />I̱ndo̱ó máꞌ numuu rí ma̱xáto̱ꞌo̱o̱ nimbá rí xkawe̱ꞌ ná xuajen rúꞌkhue̱n, ni máꞌ nimbáa tsí naꞌne-mbi̱in tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún o tsí naꞌne-nduwa mbo̱ꞌ. Rí i̱ndo̱ó máꞌ tsí ka̱ma mbiꞌñúú ná awúun i̱yu̱u̱ꞌ A̱ꞌdá-mógó, ma̱tu̱ꞌu̱ún rí mbuya jámuu ikhín.<verse eid="REV 21:27" /></para>
  <chapter eid="REV 21" />
  <chapter number="22" style="c" sid="REV 22" />
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1" />Nda̱wa̱á nisngájmiꞌ ánje̱l mbá matha rí naꞌne rí mbuya jámuu xa̱bo̱. Nambiꞌi-taꞌa ne̱ xómá iyaniwan, jamí nagájnuu ne̱ ná ꞌgí xíli̱i Ana̱ꞌlóꞌ ga̱jma̱á máꞌ A̱ꞌdá-mógó. <verse eid="REV 22:1" /><verse number="2" style="v" sid="REV 22:2" />Nagáyuu ne̱ ná ti̱kua̱pho̱o̱ jamba̱a̱ ma̱jña̱ꞌ rí kri̱ga̱ ná awúun xuajen. Mbámbá kri̱doo matha wéje̱ ixe̱ rí naꞌne rí ma̱ju̱wá jámuu xa̱bo̱, rí naxná xndúu mbámbáa go̱nꞌ, mbá gu̱wa̱ꞌ i̱jma̱ (12) nothon rí mbá tsigu. Xómáꞌ inúu ne̱ ñajuun thana rí ma̱ꞌni̱i a̱kui̱ín xa̱bo̱ tsí júwa̱ꞌ ná numbaa. <verse eid="REV 22:2" /><verse number="3" style="v" sid="REV 22:3" />Náxáríga̱ rí mi̱ꞌxná-máꞌíin xa̱bo̱ ná awúun xuajen rúꞌkhue̱n. Ikhín ma̱ge̱ꞌe̱ xíli̱i Ana̱ꞌlóꞌ ga̱jma̱á máꞌ A̱ꞌdá-mógó, jamí tsí ñajúún yumbée̱ mune̱-mba̱ꞌwi̱i̱. <verse eid="REV 22:3" /><verse number="4" style="v" sid="REV 22:4" />Mbá xúgíi̱n mbuyáa̱ jmína̱a̱ꞌ Ana̱ꞌlóꞌ, jamí ma̱gi̱ꞌma mbiꞌyuu̱ ná jédúu̱n. <verse eid="REV 22:4" /><verse number="5" style="v" sid="REV 22:5" />Náxáríga̱ mbroꞌon ikhín. Jamí tsí ma̱ju̱wá ikhín ma̱xáꞌyóo rí ma̱mbiꞌñúu̱ agu, ni máꞌ ma̱xáꞌyóo aguu a̱kha̱ꞌ, numuu rí ma̱mbiꞌñúu̱ máꞌ ga̱jma̱á aguu Ana̱ꞌlóꞌ Mikhuíí, jamí ikhii̱n muthan-ñajwii̱n jámuu mbiꞌi.<verse eid="REV 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6" />A̱ꞌkhue̱n niꞌthínꞌ ánje̱l: «Ajngáa rí gakon ñajuun ríge̱ꞌ jamí ndaꞌyóo rí ma̱nimbu̱únꞌ ne̱ xa̱bo̱. Xómáꞌ Táta̱, Ana̱ꞌlóꞌ tsí naxnúú Xu̱u̱ꞌ tsí nu̱rawíjnga̱a ajngóo̱, nixúngua̱a̱ꞌ ánje̱l drígo̱o̱, kajngó masngájmúu̱ yumbée̱ rí inu máꞌ ma̱ri̱gá».<verse eid="REV 22:6" /></para>
  <para style="s">Inu máꞌ ma̱ꞌkha̱a Jesús</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7" />«¡Gu̱dxawíínlaꞌ, ma̱ꞌkha máꞌ wapha! Phú gagi xtáa̱ tsí naꞌne-mbánuu ajngáa rí nigájnanga̱a ná awúun i̱yi̱i̱ꞌ ríge̱ꞌ».<verse eid="REV 22:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8" />Ikhúúnꞌ ñajunꞌ Juáán, tsí ndiꞌyoo jamí nidxawuun mbá xúgíí ríge̱ꞌ. Ído̱ wámbo̱ꞌ ndi̱yo̱o̱ ne̱ jamí ni̱dxawuun ne̱, a̱ꞌkhue̱n ni̱smáti̱go̱ꞌ inuu ánje̱l tsí nisngájmiꞌ mbá xúgíí rúꞌkhue̱n, kajngó ma̱ne̱-mba̱a̱lo̱ꞌ. <verse eid="REV 22:8" /><verse number="9" style="v" sid="REV 22:9" />Xómáꞌ ikhaa̱ niꞌthínꞌ: «¡Ma̱xátha̱ne̱ rúꞌkhue̱n! Numuu rí yumbée máꞌ Ana̱ꞌlóꞌ ñajunꞌ mangúúnꞌ xómá ikháánꞌ, xómá a̱ngia̱anꞌ tsí nu̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ, jamí xómá rí mbá xúgíin tsí nune̱-mbáníí ajngáa rí naꞌthán ná awúun i̱yi̱i̱ꞌ ríge̱ꞌ. Athane̱-mba̱a̱ i̱ndo̱ó máꞌ Ana̱ꞌlóꞌ».<verse eid="REV 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 22:10" />Jamí niꞌthínꞌ xóó ánje̱l: «Ma̱xáta̱rkaꞌu ajngáa rí nigájnanga̱a ná awúun i̱yi̱i̱ꞌ ríge̱ꞌ, numuu rí nangiyuu máꞌ mbiꞌi rí ma̱mba̱núu ne̱. <verse eid="REV 22:10" /><verse number="11" style="v" sid="REV 22:11" />Ikhaa jngó, tsí naꞌne rí xkawe̱ꞌ, ga̱ꞌnii̱ máꞌ xóó rí xkawe̱ꞌ. Jamí tsí naꞌne-maꞌchú-mina̱ꞌ rá, ga̱ꞌne-maꞌchú-mine̱e̱ꞌ máꞌ xóó. Xúꞌkhue̱n máꞌ tsí naꞌne rí máján, ga̱ꞌnii̱ máꞌ xóó rí máján. Jamí tsí xa̱bi̱i Ana̱ꞌlóꞌ ñajuun, ga̱nindxu̱u̱ máꞌ xóó xa̱bi̱i Ana̱ꞌlóꞌ».<verse eid="REV 22:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12" />«¡Gu̱dxawíínlaꞌ! ¡Ma̱ꞌkha máꞌ wapha! Jamí ja̱ya̱ máꞌ gamaku rí ma̱grui̱gúu mbámbáa xómá jaꞌyoo ñajun rí niꞌnii̱. <verse eid="REV 22:12" /><verse number="13" style="v" sid="REV 22:13" />Ikhúúnꞌ ñajunꞌ xómá tsina Álfa̱ jamí xómá tsina Oméga̱, tsí na̱gi̱ꞌdu̱u̱n-muu jamí tsí ndámba̱wóo, tsí ginii jayu jamí tsí nda̱wa̱á jayu».<verse eid="REV 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 22:14" />Phú gagi júwa̱ꞌ xa̱bo̱ tsí nujñáa xtíñúú. Ikhiin tsúꞌkhue̱n tsí ma̱goo ma̱tu̱ꞌu̱ún ná xuajen jamí ma̱goo mu̱pho̱ xndúu ixe̱ rí naꞌne rí ma̱ju̱wá jámuu xa̱bo̱. <verse eid="REV 22:14" /><verse number="15" style="v" sid="REV 22:15" />Xómáꞌ tsí xu̱wánꞌ ma̱nguanúu̱ rixa̱á. Ikhiin tsúꞌkhue̱n ñajúún tsí nune̱ xawan, tsí nubúún gajmíí xa̱bo̱ tsí túya̱a̱, tsí nu̱radíin xa̱bo̱, tsí nune̱-mbi̱in tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún, jamí mbá xúgíin tsí na̱ni̱gu̱ún jamí nune̱-ku̱maa tsixuxtaa.<verse eid="REV 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16" />«Ikhúúnꞌ ñajunꞌ Jesús, ni̱xu̱ꞌmáalo̱ꞌ ánje̱l drígo̱ꞌ kajngó maꞌthánlaꞌ mbá xúgíí ríge̱ꞌ ná mbámbá kutháanꞌlaꞌ tsáanꞌ nanimba̱ꞌlaꞌ ju̱yo̱ꞌ. Ikhúúnꞌ ñajunꞌ xa̱bo̱ guꞌwóo jamí xa̱bo̱ ri̱jyu̱u̱ꞌ thúngaa Dabíd, xúꞌkhue̱n máꞌ ikhúúnꞌ ñajunꞌ a̱ꞌgua̱án natse tsí phú gakhi̱i̱ aguu».<verse eid="REV 22:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17" />Xómáꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ jamí a̱ꞌgui̱i A̱ꞌdá-mógó nuthee̱n: «¡Aya̱ máꞌ, Táta̱!». Jamí tsí nadxawuun, gaꞌthée̱n: «¡Aya̱ máꞌ, Táta̱!». Tsí najándawoo, ga̱ꞌkhe̱e̱. Tsí nandoo gágáan iya, ga̱ga̱a̱n iya rí naꞌne rí ma̱ju̱wá jámuu xa̱bo̱, kixná jayu máꞌ ne̱.<verse eid="REV 22:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18" />Jámba̱a̱ tsí nadxawuun ajngáa rí nigájnanga̱a ná awúun i̱yi̱i̱ꞌ ríge̱ꞌ, ikhúúnꞌ na̱thu̱u̱n ríge̱ꞌ: Xí mbáa naꞌne-ra̱ꞌmáa rí naꞌthán i̱yi̱i̱ꞌ ríge̱ꞌ, Ana̱ꞌlóꞌ ma̱ꞌne-ra̱ꞌmáa ná tsu̱du̱u̱ xa̱bo̱ tsúꞌkhue̱n jamínu̱ꞌ rí naꞌthán ná awúun i̱yi̱i̱ꞌ ríge̱ꞌ. <verse eid="REV 22:18" /><verse number="19" style="v" sid="REV 22:19" />Xí mbáa narígúu tháan ajngáa rí nigájnanga̱a ná awúun i̱yi̱i̱ꞌ ríge̱ꞌ, Ana̱ꞌlóꞌ marígúu rí jaꞌyoo̱ ná i̱yi̱i̱ꞌ ná tima mbiꞌñúú tsí nduya jámuu,<note caller="+" style="f"><char style="fr" closed="false">22.19 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán: «ná ixe̱ rí naꞌne rí ma̱ju̱wá jámuu xa̱bo̱».</char></note> xúꞌkhue̱n máꞌ ma̱gata̱a rí jaꞌyoo̱ ná xuajñuu Ana̱ꞌlóꞌ, xómá rí naꞌthán ná awúun i̱yi̱i̱ꞌ ríge̱ꞌ.<verse eid="REV 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20" />Tsí naꞌthán mbá xúgíí ríge̱ꞌ, naꞌthán: «Gakon i̱tha̱nꞌlaꞌ rí ma̱ꞌkhalo̱ꞌ máꞌ wapha».</para>
  <para style="p" vid="REV 22:20">Xkuaꞌnii gáꞌne. ¡Aya̱ máꞌ, Táta̱ Jesús!<verse eid="REV 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21" />Táta̱ Jesukrísto̱ gáꞌne-tsakun-rámáaꞌlaꞌ mbá xúgiáanꞌlaꞌ. Xkuaꞌnii gáꞌne.<note caller="+" style="f"><char style="fr" closed="false">22.21 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «Xkuaꞌnii gáꞌne».</char></note><verse eid="REV 22:21" /></para>
  <chapter eid="REV 22" />
</usx>