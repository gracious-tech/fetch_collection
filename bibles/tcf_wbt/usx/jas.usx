<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JAS" style="id">tcfU (60-Stgo) - Me̱ꞌpha̱a̱ Mañúwi̱ín (Malinaltepec) (sfm NVI - ECZ, c5/v108</book>
  <para style="h">Santiágo̱</para>
  <para style="toc3">St</para>
  <para style="toc2">Santiágo̱</para>
  <para style="toc1">I̱yi̱i̱ꞌ rí niꞌtháán Santiágo̱</para>
  <para style="mt2">I̱yi̱i̱ꞌ rí niꞌtháán</para>
  <para style="mt1">Santiágo̱</para>
  <chapter number="1" style="c" sid="JAS 1" />
  <para style="s">Santiágo̱ naraxi̱in xa̱bi̱i Ana̱ꞌlóꞌ tsí ni̱drúꞌúún</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1" />Ikhúúnꞌ ñajunꞌ Santiágo̱, tsí naꞌne ñajuun Ana̱ꞌlóꞌ jamí Táta̱ Jesukrísto̱.</para>
  <para style="b" vid="JAS 1:1" />
  <para style="p" vid="JAS 1:1">Na̱xu̱ꞌmá i̱yi̱i̱ꞌ ríge̱ꞌ inalaꞌ ikháanꞌlaꞌ tsáanꞌ ñajwanlaꞌ xa̱bo̱ judío̱ tsí nanimbu̱únꞌ juyáá Jesús, tsí ni̱drúꞌúún mbá xúgíí inuu numbaa.</para>
  <para style="b" vid="JAS 1:1" />
  <para style="p" vid="JAS 1:1">Na̱ra̱xáanꞌlaꞌ.<verse eid="JAS 1:1" /></para>
  <para style="s">Gajmá rí na̱ꞌkha̱ ná inalóꞌ naꞌne rí ma̱gajáanꞌlóꞌ</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2" />A̱ngui̱nꞌ, ído̱ rí nanújngalaꞌ awúun mbaꞌa inii gajmá, ga̱ju̱ma̱ꞌlaꞌ rí phú gagi juwalaꞌ. <verse eid="JAS 1:2" /><verse number="3" style="v" sid="JAS 1:3" />Numuu rí ndu̱ya̱álaꞌ máꞌ rí ído̱ na̱ꞌkha̱ gajmá inalaꞌ numuu rí wéje̱ a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ, rúꞌkhue̱n naꞌne rí ma̱ꞌngo̱o̱ a̱kia̱nꞌlaꞌ. <verse eid="JAS 1:3" /><verse number="4" style="v" sid="JAS 1:4" />I̱ndo̱ó máꞌ numuu rí ndaꞌyóo rí ma̱ꞌngo̱o̱ a̱kia̱nꞌlaꞌ inuu mbá xúgíí, kajngó ma̱ꞌne káxáanꞌlaꞌ jamí ma̱ꞌne jañii a̱kia̱nꞌlaꞌ, asndo náxáꞌyóo nitháan rí jaꞌyoo ma̱nindxa̱ꞌlaꞌ.<verse eid="JAS 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 1:5" />Xí mbáa tsí ikháanꞌlaꞌ tsíma̱ñuu gáraꞌwíí rí máján, gaꞌthán-jáñuu̱ Ana̱ꞌlóꞌ, jamí Ana̱ꞌlóꞌ ma̱ꞌne rí ma̱ma̱ñuu̱ maraꞌwíi ne̱. Numuu rí Ana̱ꞌlóꞌ naxnúú mba̱a̱ mi̱ndaꞌkho mbá xúgíin tsí nu̱nda̱ꞌáa̱, jamí tsíꞌthée̱n máꞌ numuu ne̱. <verse eid="JAS 1:5" /><verse number="6" style="v" sid="JAS 1:6" />I̱ndo̱ó máꞌ numuu rí ído̱ na̱nda̱ꞌe̱e̱, ga̱we̱je̱ a̱kuii̱n ná inuu Ana̱ꞌlóꞌ, ma̱xáꞌne a̱jma̱ a̱kuii̱n nitháan. Numuu rí xa̱bo̱ tsí a̱jma̱ a̱kui̱in, asndo xómá iya rí nambúxu̱u̱ꞌ ná inuu iya a̱pha̱ jaꞌnii̱, rí ge̱e̱ ñúꞌún ixpátraꞌa eꞌne gíñá. <verse eid="JAS 1:6" /><verse number="7" style="v" sid="JAS 1:7" />Xa̱bo̱ tsí xkuaꞌnii jaꞌnii, ma̱xáju̱mu̱u̱ rí ma̱janáa̱ tháan rí na̱nda̱ꞌe̱e̱ gáꞌne Táta̱. <verse eid="JAS 1:7" /><verse number="8" style="v" sid="JAS 1:8" />Numuu rí xa̱bo̱ tsí a̱jma̱ a̱kui̱in, nariꞌkhuu̱ máꞌ xúꞌkhue̱n mbá xúgíí rí naꞌnii̱.<verse eid="JAS 1:8" /></para>
  <para style="s">Xa̱bo̱ tsí ngíníi jamí tsí phú guáꞌdáá</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9" />Dxájwalóꞌ tsí ngínáa, ma̱xáti̱yu̱u̱ꞌ, numuu rí phú gíꞌdoo numuu̱ ná inuu Ana̱ꞌlóꞌ. <verse eid="JAS 1:9" /><verse number="10" style="v" sid="JAS 1:10" />Xómáꞌ xa̱bo̱ tsí phú gíꞌdoo rá, ma̱xáti̱yu̱u̱ꞌ ído̱ rí Ana̱ꞌlóꞌ maxríguíi̱. Numuu rí xa̱bo̱ tsí phú gíꞌdoo, na̱nguá mba̱yo̱ꞌ xtáa̱, xómá re̱ꞌe̱ rí ríga̱ ná xanáá. <verse eid="JAS 1:10" /><verse number="11" style="v" sid="JAS 1:11" />Ído̱ rí natsimuu a̱kha̱ꞌ, phú mika eꞌne, jamí nojndoo iná. A̱ꞌkhue̱n nafrigu re̱ꞌe̱ jamí nánguá mitsaan giaxu̱u̱ ne̱. Xkuaꞌnii máꞌ ma̱mbáa xa̱bo̱ tsí phú gíꞌdoo jamí ma̱mbá-ri̱ga̱a mbá xúgíí rí gíꞌdoo̱ mangaa.<verse eid="JAS 1:11" /></para>
  <para style="s">Phú gagi xtáa tsí na̱ꞌngo̱o̱ inuu tsirájá</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12" />Phú gagi xtáa xa̱bo̱ tsí na̱nguá eꞌne rí xkawe̱ꞌ ído̱ rí na̱gu̱ma-rájáa, numuu ído̱ rí ni̱ꞌngo̱o̱ inuu tsirájá, a̱ꞌkhue̱n mbayáa̱ gamaku rí ma̱xtáa̱ jámuu, rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ maxnúú tsí nandúún juyáa̱. <verse eid="JAS 1:12" /><verse number="13" style="v" sid="JAS 1:13" />Ído̱ rí mbáa tsí ikháanꞌlaꞌ na̱gu̱ma-rájáa ma̱ꞌne rí xkawe̱ꞌ, ma̱xáꞌthée̱n rí Ana̱ꞌlóꞌ naꞌne-rájáa̱. Numuu rí Ana̱ꞌlóꞌ tsíyoo rí ma̱gu̱ma-rájáa̱ ma̱ꞌnii̱ rí xkawe̱ꞌ, ni máꞌ ikhaa̱ tsíꞌne-rájáa̱ nimbáa. <verse eid="JAS 1:13" /><verse number="14" style="v" sid="JAS 1:14" />A̱ꞌkhue̱n gakon, mbámbáa na̱gu̱ma-rájáa ído̱ rí nixmángua̱ꞌa̱a̱n eꞌne rí xkawe̱ꞌ nandxaꞌwá-mina̱ꞌ ma̱ꞌne. <verse eid="JAS 1:14" /><verse number="15" style="v" sid="JAS 1:15" />Ído̱ rí ni̱to̱ꞌo̱o̱ máꞌ ju̱ma̱ rí xkawe̱ꞌ ná idxu̱u̱ xa̱bo̱ rá, ma̱ga̱nú mbiꞌi rí ma̱ꞌnii̱ aꞌkhán gáꞌne ne̱. Jamí ído̱ rí nigaja̱a̱ máꞌ aꞌkhán rá, ma̱ja̱ñúu xa̱bo̱ gáꞌne ne̱.<verse eid="JAS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16" />A̱ngui̱nꞌ, tsáanꞌ phú nandoꞌ ja̱ya̱ꞌlaꞌ, mu̱xúne̱-nduwa-mijnálaꞌ. <verse eid="JAS 1:16" /><verse number="17" style="v" sid="JAS 1:17" />Mbá xúgíí kixná rí máján mi̱ndaꞌkho rí nu̱drígúlóꞌ, na̱ꞌkha̱ ne̱ ná mikhuíí, naxná ne̱ Ana̱ꞌlóꞌ tsí neꞌne-ku̱maa mbá xúgíí agu rí nambiꞌi-taꞌa ná mikhuíí. Tsí Ana̱ꞌlóꞌ, ni miꞌtsú tsíxtiꞌkhuu xómá rí jaꞌnii̱ ni máꞌ tsíba̱ñi̱i̱ꞌ xómá eꞌne nákua. <verse eid="JAS 1:17" /><verse number="18" style="v" sid="JAS 1:18" />Ana̱ꞌlóꞌ neꞌne rí ma̱gu̱máaꞌlóꞌ mbu̱júꞌ ga̱jma̱á majñu̱u̱ ajngáa rí gakon, numuu rí xkuaꞌnii ndiyoo̱ ikhaa̱, kajngó ma̱nindxa̱ꞌlóꞌ i̱jii̱n tsí ginuu jayu naꞌne-nuxii̱nꞌ.<verse eid="JAS 1:18" /></para>
  <para style="s">Gu̱ꞌne̱-mbáníílóꞌ ajngáa rawuun Ana̱ꞌlóꞌ rí nu̱dxawíínlóꞌ</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19" />Ikhaa numuu rúꞌkhue̱n, a̱ngui̱nꞌ tsáanꞌ phú nandoꞌ ja̱ya̱ꞌlaꞌ, mbá xúgiáanꞌlaꞌ gíꞌmaa rí mu̱ꞌgíi ñaꞌwanlaꞌ kajngó mu̱dxawíínlaꞌ rí nithánlaꞌ. Ma̱xáꞌcha̱ꞌlaꞌ guéño rí mu̱tha̱nlaꞌ, jamí ma̱xájiꞌnáaꞌlaꞌ nacha̱ guéño. <verse eid="JAS 1:19" /><verse number="20" style="v" sid="JAS 1:20" />Numuu rí xa̱bo̱ tsí najiꞌnáa guéño, tsíꞌnii̱ rí máján xómá rí nandoo Ana̱ꞌlóꞌ. <verse eid="JAS 1:20" /><verse number="21" style="v" sid="JAS 1:21" />Ikhaa jngó, gu̱ni̱ꞌñáá-ru̱ne̱laꞌ mbá xúgíí inii rí xkawe̱ꞌ, jamí mbá xúgíí rí ra̱máján. Jamí gu̱ne̱-waba-mijnálaꞌ kajngó ma̱goo mu̱drígúlaꞌ ajngáa rawuun Ana̱ꞌlóꞌ rí waꞌdu máꞌ ná xo̱xta̱ꞌlaꞌ, rí gíꞌdoo tsiakhe̱ rí ma̱ꞌne-jríñáaꞌlaꞌ.<verse eid="JAS 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22" />I̱ndo̱ó máꞌ numuu rí gu̱ne̱-mbáníílaꞌ ajngóo Ana̱ꞌlóꞌ, ra̱ꞌkhá mbájndi máꞌ rí i̱ndo̱ó mu̱dxawíínlaꞌ ne̱. Xí i̱ndo̱ó máꞌ nu̱dxawíínlaꞌ ne̱ jamí tsíne̱-mbáníílaꞌ ne̱, nu̱ne̱-nduwa-mijnálaꞌ máꞌ ikháanꞌlaꞌ. <verse eid="JAS 1:22" /><verse number="23" style="v" sid="JAS 1:23" />Numuu rí xa̱bo̱ tsí i̱ndo̱ó máꞌ nadxawuun ajngóo Ana̱ꞌlóꞌ jamí tsíꞌne-mbánuu̱ ne̱, ikhaa̱ jaꞌnii̱ xómá xa̱bo̱ tsí i̱ndo̱ó máꞌ nayaxu̱u̱ inuu ná iyaniwan, <verse eid="JAS 1:23" /><verse number="24" style="v" sid="JAS 1:24" />jamí ído̱ wámbo̱o̱ niyaxe̱-mine̱e̱ꞌ, a̱ꞌkhue̱n na̱ke̱e̱ máꞌ jamí mbá nacha̱ máꞌ nambumuu̱ xáne jaꞌnii inuu̱. <verse eid="JAS 1:24" /><verse number="25" style="v" sid="JAS 1:25" />Xómáꞌ tsí naꞌgíi idxu̱u̱ rí madxawuun mújúun ajngóo Ana̱ꞌlóꞌ rí phú máján, rí naꞌne-jríñáaꞌlóꞌ rá, phú gagi ma̱xtáa̱ asndo náá máꞌ rí naꞌnii̱, xí tsímbumuu̱ rí naꞌthán ne̱, jamí naꞌne-mbánuu̱ máꞌ xúꞌkhue̱n rí nadxawuu̱n.<verse eid="JAS 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26" />Xí mbáa na̱ju̱mu̱u̱ rí phú máján naꞌne-mbánuu rí nandoo Ana̱ꞌlóꞌ jamí tsíña̱wu̱u̱n rawuu̱n, naꞌne-nduwa-mine̱e̱ꞌ máꞌ ikhaa̱, a̱ꞌkhue̱n nakujma rí tsíꞌne-mbánuu̱ rí nandoo Ana̱ꞌlóꞌ. <verse eid="JAS 1:26" /><verse number="27" style="v" sid="JAS 1:27" />Tsí gakon rí phú máján naꞌne-mbánuu rí nandoo Ana̱ꞌlóꞌ Mikhuíí ñajuun tsíge̱ꞌ: tsí nambáñúú i̱jín-dxuáꞌa jamí go̱ꞌóxuáꞌa ído̱ rí júwe̱e̱ꞌ ndaꞌñúu̱. Xúꞌkhue̱n máꞌ rí na̱ña̱wa̱n-míne̱e̱ꞌ rí ma̱xáꞌnii̱ rí xkawe̱ꞌ rí nune̱ xa̱bo̱ ná numbaa ríge̱ꞌ.<verse eid="JAS 1:27" /></para>
  <chapter eid="JAS 1" />
  <chapter number="2" style="c" sid="JAS 2" />
  <para style="s">Mu̱xúraꞌwíinlaꞌ xa̱bo̱ tsí mu̱ne̱-nga̱ju̱únlaꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1" />A̱ngui̱nꞌ, tsáanꞌ wéje̱ a̱kia̱nꞌlaꞌ ná inuu Tátiálóꞌ Jesukrísto̱, tsí maphú gíꞌdoo numuu, ra̱gíꞌmaa rí mu̱raꞌwíinlaꞌ xa̱bo̱ tsí mu̱ne̱-nga̱ju̱únlaꞌ. <verse eid="JAS 2:1" /><verse number="2" style="v" sid="JAS 2:2" />Ga̱ju̱ma̱ꞌlaꞌ rí ná na̱gi̱mbáanꞌlaꞌ a̱ꞌkhue̱n na̱ga̱nú mbáa xa̱bo̱ tsí phú gíꞌdoo, traꞌa̱ xábí ajwa̱nꞌ mo̱jmo̱ꞌ ná i̱ji̱in ñawúu̱n jamí phú mitsaan xtíñuu̱. Awúun máꞌ rúꞌkhue̱n na̱ga̱nú mbáa xa̱bo̱ tsí ngínáa mangaa, júwuu̱n xtíin ska rí wayuu mi̱ndaꞌkho. <verse eid="JAS 2:2" /><verse number="3" style="v" sid="JAS 2:3" />Jamí ga̱ju̱ma̱ꞌlaꞌ rí phú máján nu̱ne̱-nga̱jwa̱álaꞌ tsí mitsaan xtíñuu jamí nu̱tháa̱nlaꞌ: «Táta̱, araꞌún ná xíle̱ rí máján wáa ge̱jyoꞌ». Xómáꞌ tsí ngínáa nu̱tha̱ánlaꞌ: «Ikháánꞌ, ariajún máꞌ a̱ꞌkhue̱n o araꞌún mbayíí ge̱jyoꞌ mbo̱ꞌ». <verse eid="JAS 2:3" /><verse number="4" style="v" sid="JAS 2:4" />Xí xkuaꞌnii e̱ne̱laꞌ, nu̱raꞌwíinlaꞌ xa̱bo̱ tsí mu̱ne̱-nga̱ju̱únlaꞌ, jamí nu̱ne̱-mijnálaꞌ xómá xa̱bo̱ ñajun tsí tsíra̱jwa̱ꞌ mújúún ga̱jma̱á numúú xa̱bo̱.<verse eid="JAS 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5" />A̱ngui̱nꞌ, tsáanꞌ phú nandoꞌ ja̱ya̱ꞌlaꞌ, gu̱dxawíínlaꞌ ríge̱ꞌ: Ana̱ꞌlóꞌ niraꞌwíin xa̱bo̱ tsí ngíníi ná numbaa ríge̱ꞌ, kajngó ma̱nindxúu̱n xa̱bo̱ tsí phú wéje̱ a̱kui̱ín ná inuu̱, jamí rí ma̱nindxúu̱n xa̱bo̱ tsí naꞌthán-ñájúún Ana̱ꞌlóꞌ, rí nixuda-mine̱e̱ꞌ máꞌ ga̱jma̱á numúú tsí nandúún juyáa̱. <verse eid="JAS 2:5" /><verse number="6" style="v" sid="JAS 2:6" />Xómáꞌ ikháanꞌlaꞌ, nu̱ñu̱úlaꞌ tsí ngíníi asndo xómá rí nda̱a̱ mbá jayu numúu̱. Á ra̱ꞌkhá xa̱bo̱ tsí phú guáꞌdáá ñajúún tsí nune̱-ngínáaꞌlaꞌ jamí nagóo̱ judáa̱nꞌlaꞌ ga̱jma̱á tsiakhe̱ ná guꞌwá-ñajun rá dxe̱ꞌ. <verse eid="JAS 2:6" /><verse number="7" style="v" sid="JAS 2:7" />Á ra̱ꞌkhá ikhii̱n ñajúu̱n tsí nuthan-xkawi̱i̱ꞌ ga̱jma̱á numuu Jesús tsí ñajuun ña̱ꞌñalaꞌ rá dxe̱ꞌ.<verse eid="JAS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8" />Phú máján máꞌ e̱ne̱laꞌ xí gakon rí nu̱ne̱-mbáníílaꞌ xtángoo rí phú i̱tha̱án gíꞌdoo numuu, xómá ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ: «Ga̱gaaꞌ xtayáá xa̱bo̱ numbaa ga̱jma̱a̱ꞌ xómá rí nandaaꞌ xtaya-mina̱ꞌ ikháánꞌ». <verse eid="JAS 2:8" /><verse number="9" style="v" sid="JAS 2:9" />I̱ndo̱ó máꞌ numuu rí, xí nu̱raꞌwíinlaꞌ xa̱bo̱ tsí mu̱ne̱-nga̱ju̱únlaꞌ rá, gíꞌmáaꞌlaꞌ aꞌkhán ná inuu Ana̱ꞌlóꞌ, numuu rí tsíne̱-mbáníílaꞌ xtángoo rúꞌkhue̱n. <verse eid="JAS 2:9" /><verse number="10" style="v" sid="JAS 2:10" />Numuu rí xa̱bo̱ tsí na̱ju̱mu̱u̱ rí naꞌne-mbánuu mbá xúgíí xtángawoo Ana̱ꞌlóꞌ jamí tsíꞌne-mbánuu̱ maske asndo mbóó rí naꞌthán ne̱, gíꞌmaa̱ aꞌkhán rí tsíꞌne-mbánuu̱ ne̱ mbá xúgíí. <verse eid="JAS 2:10" /><verse number="11" style="v" sid="JAS 2:11" />Numuu rí Ana̱ꞌlóꞌ niꞌthán: «Ma̱xátha̱ba̱a̱ꞌ ga̱jma̱a̱ꞌ xa̱bo̱ tsí tíya̱a̱», jamí ikhaa̱ máꞌ niꞌthée̱n mangaa: «Ma̱xáta̱xíya̱a̱ xa̱bo̱». Ikhaa jngó, xí tsíthabáaꞌ ga̱jma̱a̱ꞌ xa̱bo̱ tsí tíya̱a̱, jamí nataxíya̱a̱ xa̱bo̱ rá, gíꞌmáá aꞌkhán rí tsíthane̱-mbáníí xtángawoo Ana̱ꞌlóꞌ.<verse eid="JAS 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 2:12" />Ikhaa jngó, gu̱tha̱nlaꞌ jamí ga̱juwalaꞌ xómá gíꞌmaa rí ma̱ju̱wá xa̱bo̱ tsí ma̱gu̱ma-mbáníí numúú ga̱jma̱á mbá xtángoo rí naꞌne-jáwíin xa̱bo̱ ná awúun aꞌkhán. <verse eid="JAS 2:12" /><verse number="13" style="v" sid="JAS 2:13" />Numuu ído̱ rí Ana̱ꞌlóꞌ ma̱ꞌne-mbánuu ga̱jma̱á numúú xa̱bo̱, ma̱xáñáwíin a̱kuii̱n jaꞌyoo̱ xa̱bo̱ tsí táñáwíin a̱kui̱in jaꞌñúú xa̱bo̱. Tsí nañáwíin a̱kui̱in jaꞌñúú xa̱bo̱, ma̱ꞌngo̱o̱ ído̱ rí ma̱gu̱ma-mbáníí numuu̱.<verse eid="JAS 2:13" /></para>
  <para style="s">Tsí gakon rí wéje̱ a̱kui̱in ná inuu Ana̱ꞌlóꞌ naꞌnii̱ rí máján</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14" />A̱ngui̱nꞌ, xí mbáa naꞌthán: «Ikhúúnꞌ wéje̱ a̱kui̱nꞌ ná inuu Ana̱ꞌlóꞌ», jamí nda̱a̱ nitháan rí máján iꞌnii̱, nda̱a̱ mbá jayu rí gámbáyúu̱ rúꞌkhue̱n. Rí xkuaꞌnii wéje̱ a̱kuii̱n ná inuu Ana̱ꞌlóꞌ, ma̱xáꞌngo̱o̱ rúꞌkhue̱n ma̱ꞌne-jríya̱a̱ꞌ. <verse eid="JAS 2:14" /><verse number="15" style="v" sid="JAS 2:15" />Ga̱ju̱ma̱ꞌlaꞌ rí mbáa dxájwalóꞌ, xa̱biya̱ o a̱ꞌgo̱, nda̱a̱ xtíñuu̱ jamí nda̱a̱ rí mi̱khui̱i̱, <verse eid="JAS 2:15" /><verse number="16" style="v" sid="JAS 2:16" />jamí mbáa tsí ikháanꞌlaꞌ naꞌthúu̱n: «Ana̱ꞌlóꞌ gáꞌne-tsakun-rámááꞌ ná mi̱dxu̱uꞌ. Athúwaanꞌ xtíñaaꞌ rí mika jamí atseꞌtso ma̱gi̱ꞌmaaꞌ». Nda̱a̱ rí gámbáyúu̱ ajngáa rúꞌkhue̱n, xí tsíxnúu̱ rí ndaꞌyóo̱. <verse eid="JAS 2:16" /><verse number="17" style="v" sid="JAS 2:17" />Xkuaꞌnii máꞌ mangaa xa̱bo̱ tsí i̱ndo̱ó máꞌ naꞌthán rí wéje̱ a̱kui̱in ná inuu Ana̱ꞌlóꞌ, jamí tsíꞌnii̱ nimbá rí máján, nda̱a̱ mbá jayu numuu naꞌthée̱n rí wéje̱ a̱kuii̱n ná inuu Ana̱ꞌlóꞌ.<verse eid="JAS 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18" />Á gáꞌne xí mbáa maꞌthán: «Tikhuun wéje̱ a̱kui̱ín ná inuu Ana̱ꞌlóꞌ, xómáꞌ i̱ꞌwíin nune̱ rí máján». Xómáꞌ ikhúúnꞌ na̱thu̱u̱n xa̱bo̱ tsúꞌkhue̱n: «Ikháánꞌ ma̱xáxóo ma̱ta̱snga̱jmúꞌ rí wéje̱ a̱kia̱anꞌ ná inuu Ana̱ꞌlóꞌ xí na̱nguá ríga̱ rí máján nathane̱. Xómáꞌ ikhúúnꞌ ma̱goo ma̱snga̱jmáaꞌ rí wéje̱ a̱kui̱nꞌ ná inuu Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ rí máján na̱ne̱lo̱ꞌ».<verse eid="JAS 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 2:19" />Ikháánꞌ nanimba̱a̱ꞌ rí mbáwíi máꞌ tsí ñajuun Ana̱ꞌlóꞌ xtáa. ¡Phú máján máꞌ ithane̱ rí xkuaꞌnii! I̱ndo̱ó máꞌ numuu rí asndo gíñá ꞌguéen máꞌ nanimbu̱únꞌ rí xkuaꞌnii mangiin, jamí asndo naguaꞌii̱n rí namíñúu̱. <verse eid="JAS 2:19" /><verse number="20" style="v" sid="JAS 2:20" />Ma̱xánindxa̱a̱ꞌ xa̱bo̱ tsí júgoo mbá jayu inuu. Á nandaaꞌ ma̱snga̱jmáaꞌ rí xa̱bo̱ tsí nda̱a̱ rí máján eꞌne, na̱nguá gíꞌdoo numuu rí wéje̱ a̱kuii̱n ná inuu Ana̱ꞌlóꞌ dxe̱ꞌ. <verse eid="JAS 2:20" /><verse number="21" style="v" sid="JAS 2:21" />Ana̱ꞌlóꞌ niꞌthán rí xa̱bo̱ tsí nánda̱a̱ aꞌkhúun ñajuun táta̱-xi̱ꞌñálóꞌ Abraám ga̱jma̱á majñu̱u̱ rí niꞌnii̱, nákhí nixnáxi̱i̱ a̱dée̱ Isaák ma̱ja̱ñúu ná tsu̱du̱u̱ itsí ja̱rngo̱xe̱ ná nakha-ráma tsi̱gi̱jña̱ꞌ. <verse eid="JAS 2:21" /><verse number="22" style="v" sid="JAS 2:22" />Nakujma nguáná máꞌ rí Abraám wéje̱ a̱kuii̱n ná inuu Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ rí niꞌnii̱. Jamí ga̱jma̱á majñu̱u̱ rí niꞌnii̱, nigaja̱a̱ asndo neꞌne káxe̱ rí wéje̱ a̱kuii̱n ná inuu Ana̱ꞌlóꞌ. <verse eid="JAS 2:22" /><verse number="23" style="v" sid="JAS 2:23" />Xkuaꞌnii nimbánuu rí ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ: «Ninimbo̱o̱ꞌ Abraám jaꞌyoo Ana̱ꞌlóꞌ, ikhaa jngó Ana̱ꞌlóꞌ niꞌthán rí nánda̱a̱ aꞌkhúu̱n».<note caller="+" style="f"><char style="fr" closed="false">2.23 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ xó ni̱gi̱ꞌdu̱u̱n-muu 15.6.</char></note> Jamí neꞌne mbiꞌyuu̱ «Iyanga̱jwe̱e Ana̱ꞌlóꞌ». <verse eid="JAS 2:23" /><verse number="24" style="v" sid="JAS 2:24" />Ikhaa jngó ga̱fraꞌa̱ꞌ májánlaꞌ ríge̱ꞌ: Ana̱ꞌlóꞌ naꞌthán rí nánda̱a̱ aꞌkhúun xa̱bo̱ ga̱jma̱á majñu̱u̱ rí máján naꞌnii̱, jamí ra̱ꞌkhá máꞌ i̱ndo̱ó ga̱jma̱á majñu̱u̱ rí wéje̱ a̱kuii̱n ná inuu Ana̱ꞌlóꞌ.<verse eid="JAS 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25" />Xkuaꞌnii máꞌ Raáb mangaa, a̱ꞌgo̱ tsí na̱ngu̱jwa̱-mína̱ꞌ nákhí wajyúú, Ana̱ꞌlóꞌ niꞌthán rí nánda̱a̱ aꞌkhúu̱n ga̱jma̱á majñu̱u̱ rí máján niꞌnii̱: Ni̱grui̱gúu̱n ná guꞌwóo̱ xa̱bo̱ tsí nigóó gúña̱maa mbaa, jamí nimbáñúu̱ rí ma̱ga̱jnáa̱ ngu̱ꞌwa̱ ga̱jma̱á i̱mba̱ jamba̱a̱. <verse eid="JAS 2:25" /><verse number="26" style="v" sid="JAS 2:26" />Xómá jaꞌnii xuyuu xa̱bo̱ tsí nijáñuu, nánda̱a̱ xu̱u̱ꞌ ne̱, xkuaꞌnii máꞌ jaꞌnii rí wéje̱ a̱kui̱in xa̱bo̱ ná inuu Ana̱ꞌlóꞌ mangaa, nijáñuu ne̱, xí nda̱a̱ rí máján iꞌnii̱.<verse eid="JAS 2:26" /></para>
  <chapter eid="JAS 2" />
  <chapter number="3" style="c" sid="JAS 3" />
  <para style="s">Gíꞌmaa rí mu̱ña̱wa̱án rawanlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1" />A̱ngui̱nꞌ, ma̱xánindxa̱ꞌlaꞌ mbá xúgiáanꞌlaꞌ xa̱bo̱ tsí nusngáá, numuu rí ndu̱ya̱álaꞌ máꞌ rí phú i̱tha̱án gakhe̱ maxúdaa awan Ana̱ꞌlóꞌ ga̱jma̱á numa ikháanꞌxo̱ꞌ. <verse eid="JAS 3:1" /><verse number="2" style="v" sid="JAS 3:2" />Numuu rí mbá xúgiáanꞌlóꞌ na̱ngra̱ꞌáanꞌlóꞌ mbaꞌa miꞌtsú. Xí xtáa mbáa tsí na̱nguá i̱ngra̱ꞌaa ído̱ rí naꞌthán, xa̱bo̱ tsí májáan mbá jayu máꞌ ñajuun tsúꞌkhue̱n, jamí na̱ꞌngo̱o̱ máꞌ rí naꞌthán-ñájun-mine̱e̱ꞌ mbá xúgíi̱ jayu mangaa.<verse eid="JAS 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JAS 3:3" />Ído̱ rí nu̱xu̱ꞌdáalóꞌ ajwa̱nꞌ ná rawuun guáyo̱, na̱ꞌnga̱ꞌlóꞌ nu̱xu̱ꞌmáa̱ ma̱ꞌgee̱ ná nandalóꞌ rí ma̱ꞌgee̱, jamí na̱ꞌnga̱ꞌlóꞌ nu̱xma̱trígaa̱ mbá xúgíi̱. <verse eid="JAS 3:3" /><verse number="4" style="v" sid="JAS 3:4" />Gu̱ya̱xi̱ílaꞌ guꞌwá-rguwa mangaa. Mbá ixe̱ lájwíin jayá ikhoo ne̱ rí na̱ka̱ ne̱ ná nandoo xa̱bo̱ tsí na̱ka̱ jayóo ne̱, maske máꞌ phú gakhe̱ narmajngua̱ꞌ ne̱ gíñá. <verse eid="JAS 3:4" /><verse number="5" style="v" sid="JAS 3:5" />Xúꞌkhue̱n máꞌ jaꞌnii rí ra̱jwa̱nꞌlóꞌ mangaa, mbá xuwi lájwíin ñajuun ne̱, jamí phú mba̱a̱ rí na̱ꞌngo̱o̱ ne̱ naꞌne. ¡Ra̱ꞌkhá tháán mba̱a̱ júba̱ nakha eꞌne mbá lájwíin ri̱ꞌyu̱u̱ agu rí nakhati̱yo̱o̱ꞌ! <verse eid="JAS 3:5" /><verse number="6" style="v" sid="JAS 3:6" />Rí ra̱jwa̱nꞌlóꞌ jaꞌnii xómá ri̱ꞌyu̱u̱ agu. Ka̱ma ne̱ ná xuyalóꞌ, jamí phú gíꞌdoo ne̱ tsiakhe̱ rí ma̱ꞌne ne̱ mbaꞌa inii rí ra̱máján, xúꞌkhue̱n máꞌ naꞌne-maꞌchúu ne̱ mbá xúgíí xuyalóꞌ. Ndayá ski̱yu̱u̱ꞌ ne̱ ná awúun agu rí nakha jámuu, jamí naꞌne-maꞌchúu ne̱ mbá xúgíí mbiꞌi rí juwalóꞌ.<verse eid="JAS 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 3:7" />Tsí xa̱bo̱ numbaa na̱ꞌngo̱o̱ naꞌne másuu̱n jamí naxná-ñájúu̱n mbá xúgíin inii xu̱kú-xáná tsí namangu̱únꞌ, xu̱kú xna, xu̱kú tsí nu̱xma̱ta-mijná jamí xu̱kú tsí gatiin ná awúun iya a̱pha̱. <verse eid="JAS 3:7" /><verse number="8" style="v" sid="JAS 3:8" />Xómáꞌ rí ra̱jwa̱nꞌlóꞌ rá, nimbáa tsíꞌngo̱o̱ gáꞌthán-ñájuun ne̱. Mbá rí xkawe̱ꞌ rí nda̱a̱ xó ma̱wajún-ꞌthi̱ínlóꞌ ñajuun ne̱, jamí gajni̱í thana rí na̱gu̱díin xa̱bo̱ ná awúun ajngáa rí nagájnuu eꞌne ne̱.<verse eid="JAS 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 3:9" />Ga̱jma̱á ra̱jwa̱nꞌlóꞌ nagájnuu ajngáa ná rawanlóꞌ rí nu̱ꞌne̱-mba̱a̱lóꞌ Ana̱ꞌlóꞌ Mikhuíí, xúꞌkhue̱n máꞌ rí nu̱ꞌxná-máꞌíinlóꞌ xa̱bo̱ tsí ni̱gu̱ma-ku̱mii xómá jaꞌnii Ana̱ꞌlóꞌ. <verse eid="JAS 3:9" /><verse number="10" style="v" sid="JAS 3:10" />Mbóó máꞌ ná rawanlóꞌ nagájnuu ajngáa rí nu̱ꞌne̱-tsakun-rámiilóꞌ xa̱bo̱ jamí ajngáa rí nu̱ꞌxná-máꞌíinlóꞌ xa̱bo̱. A̱ngui̱nꞌ, ra̱gíꞌmaa ma̱ꞌne rí xkuaꞌnii. <verse eid="JAS 3:10" /><verse number="11" style="v" sid="JAS 3:11" />Á ma̱goo ma̱ga̱jnúu iya ríná ná iduu iya rí thawuun dxe̱ꞌ. Ma̱xáxóo. <verse eid="JAS 3:11" /><verse number="12" style="v" sid="JAS 3:12" />Á ma̱goo maxná xndú rí mbiꞌyuu aseitúna̱ mbá ixu̱u̱ ígo̱ dxe̱ꞌ. Ma̱xáxóo. Á ma̱goo maxná xndú ígo̱ mbá ajmu̱u̱ úba̱ dxe̱ꞌ. Ma̱xáxóo a̱ngui̱nꞌ. Xkuaꞌnii máꞌ mangaa, ma̱xáxóo ma̱ga̱jnúu iya ríná ná iduu iya rí thawuun.<verse eid="JAS 3:12" /></para>
  <para style="s">A̱jma̱ inii ná na̱ꞌkha̱ rí na̱ma̱ñúú xa̱bo̱</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13" />Á xtáa mbáa tsí gakon rí na̱ma̱ñuu jamí nafroꞌo̱o̱ náá rí máján ma̱ꞌne ná majña̱ꞌlaꞌ dxe̱ꞌ. Gasngájmee̱ ne̱ ga̱jma̱á majñu̱u̱ rí gamakuii̱ jamí rí tsíkúxe̱-mine̱e̱ꞌ ído̱ naꞌnii̱ rí máján. <verse eid="JAS 3:13" /><verse number="14" style="v" sid="JAS 3:14" />I̱ndo̱ó máꞌ numuu rí, xí ríga̱ tsixígu̱ꞌ jamí sia̱nꞌ ná awúun a̱kia̱nꞌlaꞌ rá, mu̱xútha̱n tsiꞌyálaꞌ rí na̱ma̱ñalaꞌ jamí mu̱xúne̱-nduwalaꞌ rí nu̱ne̱-nuwiinlaꞌ rí gakon. <verse eid="JAS 3:14" /><verse number="15" style="v" sid="JAS 3:15" />Numuu rí xa̱bo̱ tsí na̱ma̱ñúú xkuaꞌnii, ra̱ꞌkhá ná inuu Ana̱ꞌlóꞌ na̱ꞌkha̱ rí na̱ma̱ñúu̱, rí ná numbaa ríge̱ꞌ na̱ꞌkha̱ ne̱, ná ju̱mu̱ú máꞌ xa̱bo̱ numbaa, jamí ná inuu gixa̱a̱. <verse eid="JAS 3:15" /><verse number="16" style="v" sid="JAS 3:16" />Ikhaa jngó, ná ríga̱ tsixígu̱ꞌ jamí sia̱nꞌ, ikhín máꞌ ríga̱ xkujndu jamí mbá xúgíí inii rí xkawe̱ꞌ mangaa.<verse eid="JAS 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 3:17" />Xómáꞌ xa̱bo̱ tsí na̱ma̱ñúú jamí nafruꞌu̱ún rí na̱ꞌkha̱ ná inuu Ana̱ꞌlóꞌ rá, rí ginii jayu tsíni̱i̱ rí xkawe̱ꞌ, tsítsa̱ñúu̱ꞌ gajmíi̱ xa̱bo̱, gamakuu̱n, májáan a̱kuíi̱n, phú nañáwíin a̱kuíi̱n juñúu̱ tsí ngíníi, gatíí rí máján nuni̱i̱, tsíraꞌwíi̱n xa̱bo̱ tsí mune̱-nga̱júu̱n jamí na̱nguá a̱jma̱ inúu̱. <verse eid="JAS 3:17" /><verse number="18" style="v" sid="JAS 3:18" />Tsí nandúún rí ma̱ju̱wá tsímáá xa̱bo̱, nu̱mbáyíi̱ rí ma̱xátsa̱ñúu̱. Asndo xómá rí nudii̱ tsígoo rí máján jaꞌnii, kajngó mune̱ xa̱bo̱ rí nandoo Ana̱ꞌlóꞌ.<verse eid="JAS 3:18" /></para>
  <chapter eid="JAS 3" />
  <chapter number="4" style="c" sid="JAS 4" />
  <para style="s">Gu̱ni̱ꞌñá-mijnálaꞌ rí maꞌthán-ñájwanlaꞌ Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1" />Náá lá i̱ꞌkha̱ xkujndu jamí sia̱nꞌ rí guáꞌdáálaꞌ rá. Na̱ꞌkha̱ ne̱ ná awúun máꞌ a̱kia̱nꞌlaꞌ jamí ná awúun máꞌ rí phú na̱ni̱gua̱ꞌlaꞌ ma̱guaꞌdáálaꞌ. <verse eid="JAS 4:1" /><verse number="2" style="v" sid="JAS 4:2" />Phú na̱ni̱gua̱ꞌlaꞌ rí ma̱guaꞌdáálaꞌ rí ríga̱ ná tsu̱du̱u̱ numbaa jamí tsíguaꞌdáálaꞌ ne̱. Ra̱ꞌkhá tháán naxígua̱ꞌlaꞌ rí asndo nu̱radíinlaꞌ xa̱bo̱, ni máꞌ xúꞌkhue̱n tsíguaꞌdáálaꞌ rí nandalaꞌ. Nu̱ne̱-xkujndulaꞌ jamí na̱tsa̱ña̱ꞌlaꞌ. Ra̱guáꞌdáálaꞌ numuu rí tsínda̱ꞌa̱álaꞌ Ana̱ꞌlóꞌ. <verse eid="JAS 4:2" /><verse number="3" style="v" sid="JAS 4:3" />Jamí ído̱ rí nu̱nda̱ꞌa̱laꞌ, tsídrígúlaꞌ rí nandalaꞌ numuu rí tsínda̱ꞌa̱laꞌ ne̱ rí ma̱jmaa ná ndaꞌyóo, rí nu̱nda̱ꞌa̱laꞌ ne̱ mu̱tsi̱jmálaꞌ ná rí na̱ni̱gua̱ꞌlaꞌ ikháanꞌlaꞌ.<verse eid="JAS 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JAS 4:4" />¡Ra̱ꞌkhá xa̱bo̱ tsí nandúún juyáá i̱ndo̱ó máꞌ Ana̱ꞌlóꞌ ñajwanlaꞌ ikháanꞌlaꞌ! Á tsíya̱álaꞌ rí xa̱bo̱ tsí nandoo guéño jaꞌyoo rí ríga̱ ná numbaa, tsíyoo rí ma̱mbáxu̱u̱ꞌ ga̱jma̱á nindxu̱u̱ Ana̱ꞌlóꞌ rá dxe̱ꞌ. Ikhaa jngó, asndo tsáa máꞌ tsí nandoo guéño jaꞌyoo rí ríga̱ ná numbaa, naꞌne-mine̱e̱ꞌ xa̱bo̱ sia̱nꞌ ga̱jma̱á nindxu̱u̱ Ana̱ꞌlóꞌ. <verse eid="JAS 4:4" /><verse number="5" style="v" sid="JAS 4:5" />O na̱ju̱ma̱ꞌlaꞌ rí nda̱a̱ numuu rí naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ dxe̱ꞌ. Rí phú nandoo Xu̱u̱ꞌ Ana̱ꞌlóꞌ jaꞌyalóꞌ, tsí Ana̱ꞌlóꞌ máꞌ nigíwa̱a̱nꞌ ná xo̱xta̱ꞌlóꞌ, jamí mbáwíi̱ máꞌ ikhaa̱ nandoo̱ rí ma̱galóꞌ juꞌyáa̱. <verse eid="JAS 4:5" /><verse number="6" style="v" sid="JAS 4:6" />Xómáꞌ ikhaa̱ phú mba̱a̱ nambáyálóꞌ ga̱jma̱á rí máján. Ikhaa jngó ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="q" vid="JAS 4:6">«Ana̱ꞌlóꞌ na̱we̱je̱-ꞌthu̱ún xa̱bo̱ tsí nu̱xu̱xí-mijná,</para>
  <para style="q" vid="JAS 4:6">xómáꞌ tsí nu̱xrígú-mijná rá, nambáñúu̱ ga̱jma̱á rí máján».<note caller="+" style="f"><char style="fr" closed="false">4.6 </char><char style="ft" closed="false">Ju̱ma̱ ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajngáa ju̱ma̱ 3.34.</char></note><verse eid="JAS 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7" />Ikhaa jngó, gu̱ni̱ꞌñá-mijnálaꞌ rí maꞌthán-ñájwanlaꞌ Ana̱ꞌlóꞌ. Ga̱wajún-ꞌthi̱ínlaꞌ gixa̱a̱, a̱ꞌkhue̱n rí ikhaa̱ magáyuu̱ ma̱ꞌgee̱ i̱mba̱ janíí. <verse eid="JAS 4:7" /><verse number="8" style="v" sid="JAS 4:8" />Gu̱xu̱ꞌmá-mijnálaꞌ ná inuu Ana̱ꞌlóꞌ, jamí ikhaa̱ maxuꞌma-mine̱e̱ꞌ ná inalaꞌ. Xa̱bo̱ aꞌkhán, gu̱ni̱ꞌñáá-ru̱ne̱laꞌ aꞌkhán. Tsáanꞌ a̱jma̱ a̱kia̱nꞌlaꞌ, ga̱ꞌne jañii a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ. <verse eid="JAS 4:8" /><verse number="9" style="v" sid="JAS 4:9" />Ga̱juwalaꞌ gaꞌkho̱ ga̱jma̱á numuu aꞌkhánlaꞌ, gu̱mbi̱ya̱ꞌlaꞌ jamí ga̱tájwíin a̱kia̱nꞌlaꞌ. Gu̱ni̱ꞌñáá rí nu̱ndu̱ꞌwa̱laꞌ jamí rí juwalaꞌ gagi, gu̱mbi̱ya̱ꞌlaꞌ jamí ga̱juwa-jínálaꞌ. <verse eid="JAS 4:9" /><verse number="10" style="v" sid="JAS 4:10" />Gu̱xrígú-mijnálaꞌ ná inuu Ana̱ꞌlóꞌ, jamí ikhaa̱ ma̱ꞌnii̱ rí ma̱gi̱ꞌdoo numalaꞌ.<verse eid="JAS 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11" />A̱ngui̱nꞌ, mu̱xútha̱n-ri̱ga̱laꞌ ga̱jma̱á numa-mijnálaꞌ máꞌ ikháanꞌlaꞌ. Tsí naꞌthán-ri̱ga̱ numuu mbáa xa̱bo̱ o naꞌthée̱n rí ra̱máján iꞌnii̱ mbo̱ꞌ, naꞌthán-ri̱ge̱e̱ numuu xtángawoo Ana̱ꞌlóꞌ jamí tsíya-makuu̱ ne̱. Xí ikháánꞌ tsíthaya-makuíí xtángawoo Ana̱ꞌlóꞌ, tsíthane̱-mbáníí rí naꞌthán ne̱, rí nathane̱-mina̱ꞌ tsí naxúdaa awan ga̱jma̱á numuu ne̱. <verse eid="JAS 4:11" /><verse number="12" style="v" sid="JAS 4:12" />I̱ndo̱ó máꞌ mbáwíi tsí nixná xtángoo ma̱goo ma̱ꞌne-jáwíi̱n o ma̱ꞌnii̱ rí mbuyamíni̱í xa̱bo̱. Xómáꞌ ikháánꞌ rá, tsáa i̱ju̱ma̱a̱ꞌ rí ñajwaanꞌ kajngó na̱tra̱jwa̱ꞌ ga̱jma̱á numuu xa̱bo̱ róꞌ.<verse eid="JAS 4:12" /></para>
  <para style="s">Mu̱xúxu̱xí-mijnálaꞌ ga̱jma̱á numuu mbiꞌi rí gátsíí</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13" />Gu̱dxawíínlaꞌ ríge̱ꞌ, tsáanꞌ nu̱tha̱nlaꞌ: «Xúge̱ꞌ o gátsíí mu̱ꞌgua̱lóꞌ xuajen rúꞌkhue̱n o ríge̱ꞌ, ma̱juwalóꞌ mbá tsigu ikhín, mu̱ngu̱jwa̱ngaalóꞌ jamí mu̱ꞌdaalóꞌ mbúkha̱a̱». <verse eid="JAS 4:13" /><verse number="14" style="v" sid="JAS 4:14" />Jamí ni tsíya̱álaꞌ dí gáríga̱ gátsíí, ni máꞌ tsíya̱álaꞌ xí xóó juwalaꞌ. Dí lá ñajuun mbiꞌyalaꞌ rá. Xómá ru̱jmba̱aꞌ rí nakujma mbégo jamí i̱mbrúma nánda̱a̱ ne̱, xkuaꞌnii jaꞌñáaꞌlaꞌ. <verse eid="JAS 4:14" /><verse number="15" style="v" sid="JAS 4:15" />I̱wa̱á máján rí xáꞌnii gútha̱nlaꞌ: «Xí Ana̱ꞌlóꞌ nandoo, ma̱juwalóꞌ jamí mu̱ꞌne̱lóꞌ ríge̱ꞌ o mu̱ꞌne̱lóꞌ rí ñúꞌún». <verse eid="JAS 4:15" /><verse number="16" style="v" sid="JAS 4:16" />Xómáꞌ ikháanꞌlaꞌ phú na̱ni̱gua̱ꞌlaꞌ rí mu̱tha̱n-tsiꞌyálaꞌ, asndo xómá rí ikháanꞌlaꞌ nu̱tha̱n-ñájwíínlaꞌ mbiꞌyalaꞌ jaꞌnii. Ra̱máján e̱ne̱laꞌ rí nu̱ne̱-tsiꞌyálaꞌ xkuaꞌnii. <verse eid="JAS 4:16" /><verse number="17" style="v" sid="JAS 4:17" />Ikhaa jngó, tsí ndaꞌyoo máꞌ náá rí máján ma̱ꞌne, jamí tsíꞌnii̱ ne̱, aꞌkhán iꞌnii̱.<verse eid="JAS 4:17" /></para>
  <chapter eid="JAS 4" />
  <chapter number="5" style="c" sid="JAS 5" />
  <para style="s">Rí nithúún tsí phú guáꞌdáá</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1" />Gu̱dxawíínlaꞌ ríge̱ꞌ, tsáanꞌ phú guáꞌdáálaꞌ: gu̱mbi̱ya̱ꞌlaꞌ jamí gu̱ndxa̱ꞌwa̱-jínálaꞌ ga̱jma̱á numuu rí na̱ꞌkha̱ mu̱gíꞌníílaꞌ. <verse eid="JAS 5:1" /><verse number="2" style="v" sid="JAS 5:2" />Naꞌga máꞌ mbá xúgíí rí mitsaan guáꞌdáálaꞌ, jamí naꞌpho̱ máꞌ ñu̱u̱ ruxi xtíñalaꞌ rí phú kuitsúun. <verse eid="JAS 5:2" /><verse number="3" style="v" sid="JAS 5:3" />Na̱ꞌkha̱a máꞌ iyoo mbúkha̱a̱ ajwa̱nꞌ mo̱jmo̱ꞌ jamí mbúkha̱a̱ ajwa̱nꞌ miꞌxá rí phú guáꞌdáálaꞌ. Rúꞌkhue̱n maꞌthán rí ra̱máján ne̱ne̱laꞌ ído̱ gára̱jwa̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á numalaꞌ, jamí matsikháanꞌlaꞌ ne̱. Ne̱ne̱-matíílaꞌ rí ma̱guaꞌdáálaꞌ awúun mbiꞌi rí inu máꞌ ma̱mbá numbaa. <verse eid="JAS 5:3" /><verse number="4" style="v" sid="JAS 5:4" />Ikhaa jngó, gu̱dxawíínlaꞌ, ikháanꞌlaꞌ tsí ra̱khálaꞌ gúne̱-numi̱ilaꞌ xa̱bo̱ ngíníi tsí ni̱ñajun ná mbayalaꞌ. Numuu rí mbúkha̱a̱ rúꞌkhue̱n nandxaꞌwá-raꞌa ná inuu Ana̱ꞌlóꞌ tsí gíꞌdoo mbá xúgíí tsiakhe̱, jamí ikhaa̱ nidxawuu̱n máꞌ a̱ꞌwúún yumbáá tsúꞌkhue̱n. <verse eid="JAS 5:4" /><verse number="5" style="v" sid="JAS 5:5" />Ikháanꞌlaꞌ phú nijuwa-májánlaꞌ ná numbaa ríge̱ꞌ. Nitháan nda̱a̱ rí ndiꞌyálaꞌ, jamí ne̱ne̱laꞌ mbá xúgíí rí na̱ni̱gua̱ꞌlaꞌ. Ne̱ne̱-maꞌnga-mijnálaꞌ xómá xu̱kú tsí mu̱xíya̱a̱ xa̱bo̱ mbiꞌi rí ma̱ꞌne ndxa̱a̱. <verse eid="JAS 5:5" /><verse number="6" style="v" sid="JAS 5:6" />Ni̱rígulaꞌ ajngáa waꞌa tsu̱du̱ún xa̱bo̱ tsí nda̱a̱ aꞌkhúún jamí ni̱radíi̱nlaꞌ, xómáꞌ ikhii̱n túxu̱da̱a̱ꞌ ñawúu̱n rí mu̱mbáyú-mijnée̱.<verse eid="JAS 5:6" /></para>
  <para style="s">Gu̱ne̱ gakhe̱ a̱kia̱nꞌlaꞌ ído̱ rí juwalaꞌ ná awúun jamínu̱ꞌ</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7" />Ikhaa jngó, a̱ngui̱nꞌ, ga̱ꞌngo̱o̱ a̱kia̱nꞌlaꞌ asndo mbiꞌi rí ma̱ꞌkha̱a Táta̱. Gu̱ya̱xe̱laꞌ xómá eꞌne xa̱bo̱ tsí nañajun xanáá, gíꞌthu̱u̱n máꞌ xúꞌkhue̱n rí maguu̱ rí mitsaan ma̱jma̱a̱ ná tsu̱du̱u̱ ju̱ba̱ꞌ rí niꞌdii̱, jamí gíꞌthu̱u̱n máꞌ xúꞌkhue̱n rí ma̱ga̱nú mbiꞌi rí naxnúu ruꞌwa. <verse eid="JAS 5:7" /><verse number="8" style="v" sid="JAS 5:8" />Xkuaꞌnii máꞌ gúne̱ mangáanꞌlaꞌ, gu̱ne̱ gakhe̱ a̱kia̱nꞌlaꞌ jamí ma̱xáꞌne níꞌnga̱ꞌlaꞌ rí mu̱waꞌthi̱ínlaꞌ, numuu rí inu máꞌ ma̱ꞌkha̱a Táta̱. <verse eid="JAS 5:8" /><verse number="9" style="v" sid="JAS 5:9" />A̱ngui̱nꞌ, mu̱xúne̱ xkujndu numa-mijnálaꞌ, kajngó ma̱xáxúdaa awan Ana̱ꞌlóꞌ ga̱jma̱á numuu aꞌkhánlaꞌ. Gu̱ya̱álaꞌ rí inu máꞌ maxúdaa awan tsí ma̱ra̱jwa̱ꞌ numalaꞌ.<verse eid="JAS 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JAS 5:10" />A̱ngui̱nꞌ, gu̱ya̱xi̱ílaꞌ xkri̱da xómá rí ni̱míni̱í jamí xómá rí ni̱ꞌngo̱o̱ a̱kui̱ín xa̱bo̱ tsí ni̱rawíjnga̱a ajngóo Táta̱ wajyúú. <verse eid="JAS 5:10" /><verse number="11" style="v" sid="JAS 5:11" />Ikháánꞌlóꞌ na̱ju̱ma̱ꞌlóꞌ rí phú gagi júwa̱ꞌ xa̱bo̱ tsí na̱ꞌngo̱o̱ a̱kui̱ín rí mu̱míni̱í. Ikháanꞌlaꞌ ni̱dxawíínlaꞌ xáne ni̱ꞌngo̱o̱ a̱kui̱in Jób rí mamínu̱u̱ꞌ mi̱ndaꞌkho, jamí ndu̱ya̱álaꞌ máꞌ rí phú mba̱a̱ rí máján nijanáa̱ nda̱wa̱á neꞌne Táta̱. Numuu rí Táta̱ phú nañáwíin a̱kuii̱n jamí phú mba̱a̱ a̱kuii̱n.<verse eid="JAS 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12" />A̱ngui̱nꞌ, rí phú i̱tha̱án na̱tha̱nꞌlaꞌ ñajuun ríge̱ꞌ: mu̱xúxu̱ꞌdá-mijnálaꞌ ga̱jma̱á numuu mikhu, ni máꞌ ga̱jma̱á numuu ju̱ba̱ꞌ, ni máꞌ mu̱xúxu̱ꞌdá-mijnálaꞌ ga̱jma̱á numuu asndo nimbá rí ríga̱ ná numbaa. Xí nu̱tha̱nlaꞌ «ma̱ne̱», gu̱ne̱laꞌ, jamí xí nu̱tha̱nlaꞌ «ma̱xáne̱», mu̱xúne̱laꞌ, kajngó ma̱xáxná-máꞌáanꞌlaꞌ Ana̱ꞌlóꞌ.<verse eid="JAS 5:12" /></para>
  <para style="s">Phú gíꞌdoo tsiakhe̱ rí mu̱ꞌthán-jáñíílóꞌ Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13" />Xí xtáa mbáa tsí gíꞌdoo gajmá ná majña̱ꞌlaꞌ, gaꞌthán-jáñuu̱ Ana̱ꞌlóꞌ. Xí xtáa mbáa tsí nadxu a̱kui̱in, ga̱ꞌsiee̱n ajmúú ná inuu Ana̱ꞌlóꞌ. <verse eid="JAS 5:13" /><verse number="14" style="v" sid="JAS 5:14" />Xí xtáa mbáa tsí najáñuu ná majña̱ꞌlaꞌ, gandxaꞌwúu̱n xa̱bo̱ buanuu tsí juya̱ idxu̱ún tsí nanimbu̱únꞌ juyáá Jesús. Tsúꞌkhue̱n muthán-jáñíí Ana̱ꞌlóꞌ ga̱jma̱á numuu̱, jamí mu̱tsuaꞌaa̱n yatsi̱i xndú olíbo̱ ga̱jma̱á numuu Táta̱. <verse eid="JAS 5:14" /><verse number="15" style="v" sid="JAS 5:15" />Xí wéje̱ a̱kuíi̱n ná inuu Ana̱ꞌlóꞌ ído̱ rí nuthán-jáñíi̱, ma̱ꞌni̱i a̱kui̱in tsí najáñuu, jamí Ana̱ꞌlóꞌ ma̱ꞌne rí ma̱tu̱xii̱. Jamí xí niꞌnii̱ aꞌkhán rá, Ana̱ꞌlóꞌ ma̱ꞌne mba̱a̱ a̱kui̱in jaꞌyoo̱. <verse eid="JAS 5:15" /><verse number="16" style="v" sid="JAS 5:16" />Ikhaa numuu rúꞌkhue̱n, gu̱ne̱-maphú-mijnálaꞌ aꞌkhánlaꞌ, jamí mbámbáa gáꞌthán-jáñuu Ana̱ꞌlóꞌ ga̱jma̱á numuu i̱mba̱a̱ꞌ, kajngó ma̱ꞌni̱i a̱kia̱nꞌlaꞌ. Phú gíꞌdoo tsiakhe̱ rí naꞌthán-jáñuu Ana̱ꞌlóꞌ mbáa xa̱bo̱ tsí jmbu a̱kui̱in.<verse eid="JAS 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 5:17" />Ga̱rmáꞌáan a̱kia̱nꞌlaꞌ ju̱ya̱á Elía̱s, tsí ni̱gu̱wíjnga̱a ajngóo Ana̱ꞌlóꞌ wajyúú, rí ikhaa̱ ninindxu̱u̱ mbáa xa̱bo̱ numbaa xómá ikháánꞌlóꞌ jayu. Jamí ído̱ niꞌthán-jáñuu̱ Ana̱ꞌlóꞌ ga̱jma̱á mbá jañii a̱kuii̱n rí ma̱xáxnúu ruꞌwa, táxnúu ruꞌwa ná tsu̱du̱u̱ ju̱ba̱ꞌ atsú tsigu i̱tikhu. <verse eid="JAS 5:17" /><verse number="18" style="v" sid="JAS 5:18" />Nda̱wa̱á a̱ꞌkhue̱n niꞌthán-jáñuu̱ mbu̱júu̱ Ana̱ꞌlóꞌ rí maxnúu ruꞌwa, a̱ꞌkhue̱n nixnúu ruꞌwa neꞌne Ana̱ꞌlóꞌ, jamí nijma̱a̱ xndúu mbá xúgíí inii rí ndaꞌya ná inuu ju̱ba̱ꞌ.<verse eid="JAS 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19" />A̱ngui̱nꞌ, xí mbáa tsí ikháanꞌlaꞌ niniñuu jamba̱a̱ rí gakon, jamí i̱mba̱a̱ꞌ naꞌne rí ma̱thangaa̱, <verse eid="JAS 5:19" /><verse number="20" style="v" sid="JAS 5:20" />gu̱ya̱álaꞌ rí xa̱bo̱ tsí nambáyúu xa̱bo̱ aꞌkhán rí ma̱thanga̱a a̱kui̱in jamí maniñuu rí naꞌne aꞌkhán, naꞌnii̱ rí ma̱jríya̱a̱ꞌ rí ma̱ja̱ñúu̱ jamí naꞌnii̱ rí Ana̱ꞌlóꞌ ma̱ꞌne mba̱a̱ a̱kui̱in jaꞌyoo mbaꞌa aꞌkhán rí niꞌnii̱.<verse eid="JAS 5:20" /></para>
  <chapter eid="JAS 5" />
</usx>