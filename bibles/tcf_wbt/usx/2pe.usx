<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2PE" style="id">tcfU (62-2Ped) - Me̱ꞌpha̱a̱ Mañúwi̱ín (Malinaltepec) (sfm NVI). 1er trazo ECZ, 7nov’11-1dic’11; c3/v61</book>
  <para style="h">2 Pédro̱</para>
  <para style="toc3">2 P</para>
  <para style="toc2">2 Pédro̱</para>
  <para style="toc1">Riajma̱ i̱yi̱i̱ꞌ rí niꞌtháán Pédro̱</para>
  <para style="mt2">Riajma̱ i̱yi̱i̱ꞌ rí niꞌtháán</para>
  <para style="mt1">Pédro̱</para>
  <chapter number="1" style="c" sid="2PE 1" />
  <para style="s">Pédro̱ naraxi̱in tsí nanimbu̱únꞌ juyáá Jesús</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1" />Ikhúúnꞌ ñajunꞌ Simón Pédro̱, yumbée Jesukrísto̱, jamí mangaa máꞌ ñajunꞌ mbáa xa̱bo̱ tsí waxúngua̱a̱ꞌ niꞌnii̱ ikhaa̱. Na̱ra̱xáanꞌlaꞌ tsáanꞌ nijanálaꞌ rí phú mitsaan ma̱we̱je̱ a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ, xómá jaꞌnii rí nijaná ikháanꞌxo̱ꞌ. Nijanálaꞌ rúꞌkhue̱n ga̱jma̱á numuu rí phú jmbii Ana̱ꞌlóꞌ jamí Jesukrísto̱ tsí naꞌne-jríñáaꞌlóꞌ.<verse eid="2PE 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2" />Naꞌne a̱kui̱nꞌ rí phú mba̱a̱ gágu̱ma-tsakun-rámáaꞌlaꞌ jamí phú tsímáá gájuwalaꞌ ga̱jma̱á majñu̱u̱ rí nu̱ne̱-nuwiinlaꞌ Ana̱ꞌlóꞌ jamí Tátiálóꞌ Jesús.<verse eid="2PE 1:2" /></para>
  <para style="s">Ana̱ꞌlóꞌ nindxaꞌwálaꞌ jamí niraꞌwiáanꞌlaꞌ</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3" />Ana̱ꞌlóꞌ najmuu ski̱yu̱u̱ꞌ rí maxnálóꞌ mbá xúgíí rí ndaꞌyálóꞌ, kajngó ma̱juwalóꞌ xómá rí nandoo̱ ikhaa̱. Naxnálóꞌ mbá xúgíí rúꞌkhue̱n numuu rí nu̱ꞌne̱-nuwiinlóꞌ Jesukrísto̱, tsí nindxaꞌwálóꞌ ga̱jma̱á numuu rí phú gíꞌdoo numuu̱ jamí ninújngoo máján rí naꞌnii̱. <verse eid="2PE 1:3" /><verse number="4" style="v" sid="2PE 1:4" />Ga̱jma̱á majñu̱u̱ rúꞌkhue̱n, phú mitsaan jamí phú mba̱a̱ rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxa̱ꞌlóꞌ, kajngó ma̱nindxa̱ꞌlaꞌ xómá jaꞌnii Ana̱ꞌlóꞌ, numuu rí ni̱ꞌnga̱ꞌlaꞌ máꞌ ni̱ga̱yálaꞌ inuu numbaa rí na̱ka̱-raꞌchúu máꞌ xúꞌkhue̱n ga̱jma̱á numuu aꞌkhán rí na̱wa̱ꞌa̱ a̱kui̱ín xa̱bo̱ mune̱.<verse eid="2PE 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2PE 1:5" />Ikhaa numuu rúꞌkhue̱n, ra̱ꞌkhá máꞌ i̱ndo̱ó rí ma̱we̱je̱ a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ rí gu̱xna̱-míjnálaꞌ mbá xúgíí tsiakhe̱ rí ma̱nindxa̱ꞌlaꞌ mbáa xa̱bo̱ tsí naꞌne máꞌ xúꞌkhue̱n rí máján mangaa. Xúꞌkhue̱n máꞌ gu̱xna̱-míjnálaꞌ mbá xúgíí tsiakhe̱ rí mu̱ne̱-nuwiinlaꞌ i̱tha̱án xóó Ana̱ꞌlóꞌ mangaa. <verse eid="2PE 1:5" /><verse number="6" style="v" sid="2PE 1:6" />Xúꞌkhue̱n máꞌ gu̱xna̱-míjnálaꞌ mbá xúgíí tsiakhe̱ rí ma̱ꞌnga̱ꞌlaꞌ mu̱tha̱n-ñájun-mijnálaꞌ mangaa. Mangaa máꞌ gu̱xna̱-míjnálaꞌ mbá xúgíí tsiakhe̱ rí ma̱ꞌngo̱o̱ a̱kia̱nꞌlaꞌ. Xúꞌkhue̱n máꞌ gu̱xna̱-míjnálaꞌ mbá xúgíí tsiakhe̱ rí mu̱ne̱laꞌ mbá xúgíí rí nandoo Ana̱ꞌlóꞌ mangaa. <verse eid="2PE 1:6" /><verse number="7" style="v" sid="2PE 1:7" />Xúꞌkhue̱n máꞌ gu̱xna̱-míjnálaꞌ mbá xúgíí tsiakhe̱ rí ma̱galaꞌ ju̱ñu̱ú a̱ngia̱nꞌlaꞌ mangaa. Jamí gu̱xna̱-míjnálaꞌ mbá xúgíí tsiakhe̱ rí ma̱galaꞌ ju̱ñu̱ú mbá xúgíin xa̱bo̱ mangaa. <verse eid="2PE 1:7" /><verse number="8" style="v" sid="2PE 1:8" />Xí ikháanꞌlaꞌ nu̱xna̱-míjnálaꞌ tsiakhe̱ rí mu̱ne̱laꞌ mbá xúgíí rúꞌkhue̱n jamí nagaja̱a̱ rí nu̱ne̱laꞌ, phú gíꞌdoo numuu rí juwalaꞌ xúꞌkhue̱n rá, xúꞌkhue̱n máꞌ phú ni̱gi̱ꞌdoo numuu rí ne̱ne̱-nuwiinlaꞌ Tátiálóꞌ Jesukrísto̱. <verse eid="2PE 1:8" /><verse number="9" style="v" sid="2PE 1:9" />Xómáꞌ xa̱bo̱ tsí na̱nguá eꞌne rúꞌkhue̱n rá, ikhaa̱ ñajuu̱n mbáa xa̱bo̱ tsí tsíꞌngo̱o̱ gáyaxe̱ tsíngua̱ꞌ, numuu rí tsífrigo̱o̱ꞌ. Asndo nimbumuu̱ máꞌ rí Ana̱ꞌlóꞌ neꞌne mba̱a̱ a̱kui̱in jaꞌyoo aꞌkhúu̱n rí niꞌnii̱ wajyúú. <verse eid="2PE 1:9" /><verse number="10" style="v" sid="2PE 1:10" />Ikhaa numuu rúꞌkhue̱n, a̱ngui̱nꞌ, gu̱xna̱-míjnálaꞌ i̱tha̱án xóó tsiakhe̱ rí ma̱kujma rí Ana̱ꞌlóꞌ nindxaꞌwálaꞌ jamí niraꞌwiáanꞌlaꞌ. Xí ikháanꞌlaꞌ nu̱ne̱laꞌ rúꞌkhue̱n, ni miꞌtsú mu̱xúne̱-tsíngua̱ꞌ-mijnálaꞌ inuu Ana̱ꞌlóꞌ. <verse eid="2PE 1:10" /><verse number="11" style="v" sid="2PE 1:11" />A̱ꞌkhue̱n rí phú nadxu a̱kui̱in Ana̱ꞌlóꞌ marmáꞌthoo̱ xkrugua ma̱ta̱ꞌa̱ꞌlaꞌ ná jámuu naꞌthán-ñájun Tátiálóꞌ Jesukrísto̱, tsí naꞌne-jríñáaꞌlóꞌ.<verse eid="2PE 1:11" /></para>
  <para style="s">Phú gakon rí naꞌthán ná ajngáa rawuun Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12" />Ikhaa jngó, ikhúúnꞌ ma̱ne̱ rí ma̱rmáꞌáan a̱kia̱nꞌlaꞌ jámba̱ miꞌtsú mbá xúgíí ríge̱ꞌ, maske máꞌ na̱ma̱ñalaꞌ ne̱, jamí kuajún-gúkuálaꞌ ná tsu̱du̱u̱ rí gakon rí waꞌsngálaꞌ. <verse eid="2PE 1:12" /><verse number="13" style="v" sid="2PE 1:13" />Ikhúúnꞌ na̱ju̱mu̱ꞌ rí awúun mbiꞌi rí xóó xtáá nda̱ya̱lo̱ꞌ, gíꞌmúú ma̱ne̱ rí ma̱rmáꞌáan a̱kia̱nꞌlaꞌ mbá xúgíí ríge̱ꞌ. <verse eid="2PE 1:13" /><verse number="14" style="v" sid="2PE 1:14" />Numuu rí jmína̱a̱ꞌ máꞌ Tátiálóꞌ Jesukrísto̱ niꞌnii̱ rí mba̱yo̱o̱ rí inu máꞌ ma̱ni̱ꞌñúu numbaa ríge̱ꞌ. <verse eid="2PE 1:14" /><verse number="15" style="v" sid="2PE 1:15" />Xómáꞌ ikhúúnꞌ ma̱xna̱-mína̱ꞌ tsiakhe̱ rí ikháanꞌlaꞌ ma̱xámbumalaꞌ nimbá mbiꞌi gisngáá ríge̱ꞌ, maske máꞌ ikhúúnꞌ nándawu̱ún ná numbaa ríge̱ꞌ.<verse eid="2PE 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16" />Nákhí ni̱sngááxo̱ꞌ ná inalaꞌ rí ma̱thanga̱a Tátiálóꞌ Jesukrísto̱ ga̱jma̱á mbá xúgíí ski̱yu̱u̱ꞌ, túne̱-ku̱maaxo̱ꞌ nimbá ajngáa kajngó mu̱ne̱xo̱ꞌ rí nacha̱ ma̱nimba̱ꞌlaꞌ, rí ni̱tha̱nꞌlaꞌxo̱ꞌ ga̱jma̱á numuu ski̱yu̱u̱ꞌ rí ndi̱ya̱áxo̱ꞌ ga̱jma̱á idaxo̱ꞌ. <verse eid="2PE 1:16" /><verse number="17" style="v" sid="2PE 1:17" />Ikháanꞌxo̱ꞌ ndi̱yáa̱xo̱ꞌ nákhí rí ikhaa̱ ni̱grui̱gíi̱ tsiakhe̱ jamí nitiamakuíi̱ neꞌne Ana̱ꞌlóꞌ, tsí Anu̱u̱ máꞌ ikhaa̱. Nákhí mbiꞌi rúꞌkhue̱n, ni̱ga̱taa ná inuu̱ mbá a̱ꞌwá rí phú wáá niwán ná mikhuíí rí niꞌthán: «Tsíge̱ꞌ ñajuun A̱ꞌdéꞌ tsí phú nandoꞌ ja̱yo̱o̱, tsí phú nadxu a̱kui̱nꞌ eꞌne». <verse eid="2PE 1:17" /><verse number="18" style="v" sid="2PE 1:18" />Jamí ikháanꞌxo̱ꞌ ni̱dxawíínxo̱ꞌ a̱ꞌwá rúꞌkhue̱n rí ni̱ꞌkha̱ mikhuíí, nákhí trámáaꞌxo̱ꞌ ná júbo̱o̱ Ana̱ꞌlóꞌ ga̱jma̱á nindxu̱u̱.<verse eid="2PE 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19" />Rúꞌkhue̱n nasngájmalóꞌ rí maphú gakon rí nithan tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ wajyúú. Phú máján máꞌ e̱ne̱ ikháanꞌlaꞌ rí nu̱ꞌgíi idxa̱ꞌlaꞌ rí mu̱dxawíínlaꞌ ajngáa rúꞌkhue̱n, numuu rí ikhaa ne̱ ñajuun xómá agu rí nambiꞌyalóꞌ ná mijína, asndo gámbiꞌi jamí ma̱kujmaa A̱ꞌgua̱án Natse ma̱ꞌne rí ma̱mbiꞌyalaꞌ. <verse eid="2PE 1:19" /><verse number="20" style="v" sid="2PE 1:20" />I̱ndo̱ó máꞌ gíꞌmaa rí ma̱fraꞌa̱ꞌlaꞌ ginii ríge̱ꞌ: nimbá ajngáa rawuun Ana̱ꞌlóꞌ rí nithan tsí ni̱rawíjnga̱a ne̱, ma̱goo mi̱ꞌthán-ri̱ya̱aꞌ xómá rí naꞌne a̱kui̱in mbámbáa. <verse eid="2PE 1:20" /><verse number="21" style="v" sid="2PE 1:21" />Numuu rí nimbáa tsí ni̱gu̱wíjnga̱a táyá idxu̱u̱ ikhaa rí maꞌthán, a̱ꞌkhue̱n gakon, nithee̱n ajngóo Ana̱ꞌlóꞌ, xómá rí Xu̱u̱ꞌ Ana̱ꞌlóꞌ niꞌthán-múꞌúu̱n.<verse eid="2PE 1:21" /></para>
  <chapter eid="2PE 1" />
  <chapter number="2" style="c" sid="2PE 2" />
  <para style="s">Xáne ma̱mbíin xa̱bo̱ tsí nusngáá rí mi̱nduwa</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1" />I̱ndo̱ó máꞌ numuu rí nijúwa̱ꞌ xa̱bo̱ tsí ni̱rawíjnga̱a ajngáa mi̱nduwa ná xuajen Israél wajyúú mangaa, jamí xkuaꞌnii máꞌ ma̱ju̱wá ná majña̱ꞌlaꞌ xa̱bo̱ tsí musngáá rí mi̱nduwa mangaa. Ikháanꞌlaꞌ asndo ni mu̱xúya̱álaꞌ xáne gúxu̱da̱a̱ꞌ ná majña̱ꞌlaꞌ gisngáá mi̱nduwa ga̱jma̱á numuu Ana̱ꞌlóꞌ, jamí asndo muthee̱n rí ra̱ꞌkháa Táta̱ ñajuun tsí neꞌne-numuu rí ma̱jáwíi̱n. Rúꞌkhue̱n ma̱ꞌne rí asndo nda̱a̱ ajngóo rí ma̱mbíi̱n. <verse eid="2PE 2:1" /><verse number="2" style="v" sid="2PE 2:2" />Phú mbaꞌiin xa̱bo̱ mbuya̱-ri̱dúún rí phú mate̱ꞌ nune̱ xa̱bo̱ tsí nusngáá rí mi̱nduwa. Ga̱jma̱á numúu̱ ikhii̱n muthan xkawe̱ꞌ xa̱bo̱ ga̱jma̱á numuu rí gakon nanimba̱ꞌlóꞌ. <verse eid="2PE 2:2" /><verse number="3" style="v" sid="2PE 2:3" />Ga̱jma̱á numuu rí na̱ni̱gúu̱nꞌ ma̱guáꞌdáa̱ mi̱ndaꞌkho, mu̱rígú-jáꞌyálaꞌ mbúkha̱ꞌlaꞌ ga̱jma̱á majñu̱u̱ gisngáá rí mi̱nduwa. Xómáꞌ ikhii̱n, waꞌxná-máꞌíi̱n máꞌ rí mu̱míníi̱, numuu rí nixudaa máꞌ awan Ana̱ꞌlóꞌ numúu̱ asndo nákhí wajyúú, jamí ma̱xájáwíi̱n rí mu̱dri̱guíi̱ jamínu̱ꞌ.<verse eid="2PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4" />Ana̱ꞌlóꞌ táꞌne mba̱a̱ a̱kui̱in jaꞌñúú ánje̱l tsí nene̱ aꞌkhán wajyúú, a̱ꞌkhue̱n gakon, nistuáꞌíi̱n ná awúun agu rí nakha jámuu jamí nirugua-raꞌii̱n ná iñá rí mijína. Ikhín ni̱gi̱xii̱n májíi̱n asndo mbiꞌi rí ma̱to̱ꞌo̱o̱ awan ga̱jma̱á numúú mbá xúgíin xa̱bo̱. <verse eid="2PE 2:4" /><verse number="5" style="v" sid="2PE 2:5" />Ni máꞌ táꞌne mba̱a̱ a̱kui̱in Ana̱ꞌlóꞌ jaꞌñúú xa̱bo̱ ra̱májíin tsí nijúwa̱ꞌ wajyúú, nákhí rí nixungue̱e̱ꞌ ruꞌwa a̱pha̱ ma̱ꞌne-gámbi̱in xa̱bo̱ tsúꞌkhue̱n. I̱ndo̱ó máꞌ Noé, tsí niꞌsngáá rí ma̱ju̱wá xa̱bo̱ xómá rí nandoo Ana̱ꞌlóꞌ, nijríya̱a̱ꞌ gajmíi̱ mbá juwiin xa̱bo̱. <verse eid="2PE 2:5" /><verse number="6" style="v" sid="2PE 2:6" />Xúꞌkhue̱n máꞌ mangaa Ana̱ꞌlóꞌ neꞌne-gámbi̱in xa̱bo̱ tsí nijúwa̱ꞌ ná xuajen Sodóma̱ ga̱jma̱á Gomóra̱, nikhii̱n asndo niꞌni̱i idi mbá jayu ñajúu̱n. Rí xkuaꞌnii neꞌne Ana̱ꞌlóꞌ, niꞌgíi̱ mbá xkri̱da rí ma̱gíꞌníí xa̱bo̱ ra̱májíin tsí ma̱ju̱wá nda̱wa̱á. <verse eid="2PE 2:6" /><verse number="7" style="v" sid="2PE 2:7" />Xómáꞌ Ana̱ꞌlóꞌ neꞌne-jríya̱a̱ꞌ Lót, mbáa xa̱bo̱ májáan tsí níꞌngo̱o̱ a̱kuii̱n ga̱jma̱á numuu rí phú mate̱ꞌ nune̱ xa̱bo̱ tsúꞌkhue̱n. <verse eid="2PE 2:7" /><verse number="8" style="v" sid="2PE 2:8" />Lót nixtáa ná majñu̱ú xa̱bo̱ tsúꞌkhue̱n, jamí mbámbá mbiꞌi maphú mingíná a̱kuii̱n ído̱ ndaꞌyoo̱ jamí nadxawuu̱n rí xkawe̱ꞌ nune̱ xa̱bo̱, numuu rí ikhaa̱ máján nixtáa̱ ná inuu Ana̱ꞌlóꞌ. <verse eid="2PE 2:8" /><verse number="9" style="v" sid="2PE 2:9" />Rúꞌkhue̱n nasngájmalóꞌ rí Táta̱ gíꞌdoo̱ tsiakhe̱ rí ma̱ꞌne-jáwíi̱n ná awúun gaꞌkho̱ tsí júwa̱ꞌ xómá rí nandoo̱, jamí rí ma̱gu̱xii̱n mújúu̱n tsí nune̱ rí xkawe̱ꞌ kajngó mu̱dri̱guíi̱ jamínu̱ꞌ ído̱ gága̱nú mbiꞌi rí ma̱to̱ꞌo̱o̱ awan ga̱jma̱á numúú mbá xúgíin xa̱bo̱. <verse eid="2PE 2:9" /><verse number="10" style="v" sid="2PE 2:10" />Ikhaa rúꞌkhue̱n ma̱gíꞌníí tsí nune̱ rí phú xkawe̱ꞌ nandoo xuñúú, jamí tsíya̱-makuíi̱ rí nithán-ñájúu̱n eꞌne Ana̱ꞌlóꞌ.</para>
  <para style="p" vid="2PE 2:10">Phú nu̱xu̱xí-mijnée̱ jamí najñaguu̱n, jamí tsímíñúu̱ rí muthan-xkawi̱i̱ꞌ ga̱jma̱á numúú tsiakhe̱ ꞌguéen tsí phú mba̱a̱ ski̱ñu̱úꞌ. <verse eid="2PE 2:10" /><verse number="11" style="v" sid="2PE 2:11" />Xómáꞌ tsí ánje̱l, maske máꞌ i̱tha̱án mba̱a̱ tsiakhe̱ guáꞌdáa̱ xó rí xa̱bo̱ tsí nusngáá rí mi̱nduwa, asndo ni tsíꞌngo̱o̱ a̱kuíi̱n gúthan-xkawi̱i̱ꞌ ga̱jma̱á numúú tsiakhe̱ ꞌguéen tsúꞌkhue̱n ná inuu Táta̱. <verse eid="2PE 2:11" /><verse number="12" style="v" sid="2PE 2:12" />Xómáꞌ xa̱bo̱ tsí nusngáá rí mi̱nduwa, ikhii̱n nuthee̱n xkawe̱ꞌ numuu rí tsífruꞌúu̱n. Xómá xu̱kú jaꞌñúu̱, rí tsíndxa̱ꞌwa̱-mijnée̱ rí muni̱i̱. Ikhii̱n ni̱gu̱mii̱ rí ma̱tii̱n ma̱ja̱ñúu̱ jamí ma̱mbíi̱n xómá xu̱kú. <verse eid="2PE 2:12" /><verse number="13" style="v" sid="2PE 2:13" />Mu̱dri̱guíi̱ jamínu̱ꞌ rí jaꞌñúu̱ ga̱jma̱á numuu rí ra̱máján niñuu̱ i̱ꞌwíin xa̱bo̱, jamí phú nadxúu̱n rí muni̱i̱ aꞌkhán ga̱jma̱á xuñúu̱ ná pa̱jnu inuu mbiꞌíí. Phú mate̱ꞌ rí ñajúu̱n jamí i̱ndii̱n, numuu ído̱ rí napiꞌtsii̱ ga̱jma̱á nindxa̱ꞌlaꞌ nadxu a̱kuíi̱n ga̱jma̱á numuu rí mi̱nduwa nuni̱i̱. <verse eid="2PE 2:13" /><verse number="14" style="v" sid="2PE 2:14" />Mbámbá rí nduyáa̱ mbáa a̱ꞌgo̱, naꞌne a̱kuíi̱n rí mubúu̱n ga̱jma̱á nindxu̱u̱. Tsígi̱ꞌmúu̱ rí muni̱i̱ aꞌkhán jamí rí mune̱-rájíi̱n tsí wabiin mune̱ aꞌkhán. Phú naguꞌúu̱n máꞌ rí na̱ni̱gúu̱nꞌ ma̱guáꞌdáa̱ rí na̱nguá guáꞌdáa̱, jamí xa̱bo̱ tsí waꞌxná-máꞌíin ñajúu̱n. <verse eid="2PE 2:14" /><verse number="15" style="v" sid="2PE 2:15" />Ni̱ni̱ꞌñáa̱ jamba̱a̱ rí máján, jamí nene̱-mbáti̱ga̱-mijnée̱ rí magóo̱ ná jambo̱o̱ Baláám, a̱dée táta̱ Beór, tsí ni̱ni̱gu̱u̱ꞌ madaa mbúkha̱a̱ ga̱jma̱á numuu rí ma̱ꞌne rí xkawe̱ꞌ. <verse eid="2PE 2:15" /><verse number="16" style="v" sid="2PE 2:16" />Jamí watríyíí Baláám ga̱jma̱á numuu aꞌkhúun. Ana̱ꞌlóꞌ neꞌne rí mbáa xtángidi maꞌthúu̱n ga̱jma̱á a̱ꞌwóo xa̱bo̱ numbaa, jamí xkuaꞌnii watrikháa̱ kajngó ma̱xáꞌnii̱ rí tsiskágu̱nꞌ mbá jayu.<verse eid="2PE 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17" />Xa̱bo̱ tsúꞌkhue̱n ñajúún xómá iduu iya rí nijndoo, xómá du̱u̱n rí na̱ka̱ jiꞌyá eꞌne gíñá rí phú gakhe̱ ixnúu. Ikhiin tsúꞌkhue̱n ni̱gu̱ma-mújúun ná magóó jámuu,<note caller="+" style="f"><char style="fr" closed="false">2.17 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa «jámuu».</char></note> ná mijína mi̱ndaꞌkho. <verse eid="2PE 2:17" /><verse number="18" style="v" sid="2PE 2:18" />Ído̱ nusngáa̱ nu̱xu̱xí-mijnée̱ jamí nda̱a̱ mbá jayu numuu ajngáa rí nuthee̱n. A̱ꞌkhue̱n nu̱xkaxii̱ rí xkawe̱ꞌ nandoo xuñúú jamí rí na̱ni̱gu̱ún mune̱ tsí ni̱kú máꞌ ni̱gíꞌdi̱ín nene̱-janíí-mijná inúú tsí na̱nguá júwa̱ꞌ xómá rí nandoo Ana̱ꞌlóꞌ. <verse eid="2PE 2:18" /><verse number="19" style="v" sid="2PE 2:19" />Nu̱xu̱da̱ꞌ-mijnée̱ ná inúú xa̱bo̱ rí ma̱jáwíin ná inuu rí nithán-ñájúún eꞌne, i̱ndo̱ó máꞌ numuu rí jmínii̱ máꞌ ñajúu̱n yumbáá waꞌtsi̱in drígo̱o̱ rí ninújngoo xkawe̱ꞌ. Numuu rí mbámbáa xa̱bo̱ nanindxu̱u̱ yumbáá waꞌtsi̱i̱ ná inuu rí tsíꞌngo̱o̱ gáꞌne ga̱jmáa̱. <verse eid="2PE 2:19" /><verse number="20" style="v" sid="2PE 2:20" />Numuu rí xa̱bo̱ tsí nene̱-nuwiin máꞌ Táta̱ Jesukrísto̱, tsí naꞌne-jríñáaꞌlóꞌ, ni̱ni̱ꞌñáa̱ máꞌ rí nuni̱i̱ rí xkawe̱ꞌ rí ríga̱ ná numbaa ríge̱ꞌ. Jamí xí nathangii̱n nu̱mbráꞌa-mijnée̱ mbu̱júꞌ ná awúun aꞌkhán jamí nánguá iyoo gúni̱ꞌñáa̱ rí muni̱i̱ ne̱, a̱ꞌkhue̱n naꞌne i̱tha̱án gúkú a̱kuíi̱n xúge̱ꞌ xó rí nákhí ginii. <verse eid="2PE 2:20" /><verse number="21" style="v" sid="2PE 2:21" />I̱tha̱án máꞌ ni̱gi̱ꞌdoo numuu xí ni miꞌtsú túne̱-nuwii̱n rí gakon ga̱jma̱á numuu Ana̱ꞌlóꞌ, xó rí mune̱-nuwii̱n xtángoo drígo̱o̱ Ana̱ꞌlóꞌ jamí nda̱wa̱á mu̱ni̱ꞌñáa̱ ne̱. <verse eid="2PE 2:21" /><verse number="22" style="v" sid="2PE 2:22" />Ga̱jma̱á nindxu̱ún xa̱bo̱ tsúꞌkhue̱n nambánuu ajngáa ríge̱ꞌ: «Tsí xu̱wánꞌ, nathanga̱a me̱kho̱ rí nixi». Jamí ajngáa ríge̱ꞌ: «A̱ga tsí ni̱gu̱ma-jaꞌwi̱i, nathanga̱a ma̱ꞌne-ju̱ba̱ꞌ-mina̱ꞌ mbu̱júꞌ ná ju̱ba̱ꞌ xtiꞌthi».<verse eid="2PE 2:22" /></para>
  <chapter eid="2PE 2" />
  <chapter number="3" style="c" sid="2PE 3" />
  <para style="s">Jesukrísto̱ ma̱ꞌkha̱a asndo náá máꞌ mbiꞌi</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1" />A̱ngui̱nꞌ, tsáanꞌ phú nandoꞌ ja̱ya̱ꞌlaꞌ, ríge̱ꞌ eꞌne riajma̱ nothon rí na̱xu̱ꞌmá i̱yi̱i̱ꞌ ná inalaꞌ. Ni̱xna̱-mína̱ꞌ tsiakhe̱ rí ma̱tha̱n-máꞌánlaꞌ ga̱jma̱á majñu̱u̱ mbá nájma̱ i̱yi̱i̱ꞌ, kajngó máján gúndxa̱ꞌwa̱-mijnálaꞌ. <verse eid="2PE 3:1" /><verse number="2" style="v" sid="2PE 3:2" />Nandoꞌ rí ma̱rmáꞌáan a̱kia̱nꞌlaꞌ rí nithan xa̱bo̱ jaꞌwuun tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ wajyúú, jamí ma̱rmáꞌáan a̱kia̱nꞌlaꞌ xtángoo rí niniñuu Táta̱ tsí naꞌne-jríñáaꞌlóꞌ, rí nisngálaꞌ tsí waxúngui̱inꞌ.<verse eid="2PE 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 3:3" />I̱tha̱án máꞌ gíꞌmaa rí ma̱ma̱ñalaꞌ ríge̱ꞌ: rí awúun mbiꞌi rí na̱ka̱-rayámba̱ numbaa ma̱ju̱wá xa̱bo̱ tsí na̱ni̱gu̱ún muthan-tsi̱ndíi rí gakon, jamí nune̱ máꞌ xúꞌkhue̱n rí xkawe̱ꞌ xómá rí nandoo xuñúú. <verse eid="2PE 3:3" /><verse number="4" style="v" sid="2PE 3:4" />Xáꞌnii gúthee̱n: «Náá xtáa̱ Jesús, tsí nixuda-mina̱ꞌ rí ma̱ꞌkha̱a rá. Numuu rí asndo nákhí máꞌ nijáñúú táta̱-xi̱ꞌñálóꞌ, mbá xúgíí ikhaa máꞌ jaꞌnii kri̱ga̱, xómá jaꞌnii numbaa asndo nákhí rí neꞌne-ku̱maa ne̱ Ana̱ꞌlóꞌ». <verse eid="2PE 3:4" /><verse number="5" style="v" sid="2PE 3:5" />I̱ndo̱ó máꞌ numuu rí xa̱bo̱ tsúꞌkhue̱n nuni̱i̱ ñajúu̱n rí na̱nguá iyáa̱, rí asndo nákhí máꞌ wajyúú ni̱gu̱ma-ku̱maa mbá xúgíí mikhu ga̱jma̱á majñu̱u̱ ajngáa rawuun Ana̱ꞌlóꞌ. Xúꞌkhue̱n máꞌ ju̱ba̱ꞌ mangaa, rí nijráꞌán ná awúun iya ga̱jma̱á majñu̱u̱ máꞌ ajngóo Ana̱ꞌlóꞌ, jamí ná inuu máꞌ iya kra̱ꞌmá ne̱. <verse eid="2PE 3:5" /><verse number="6" style="v" sid="2PE 3:6" />Mangaa máꞌ ga̱jma̱á majñu̱u̱ iya wámba̱a numbaa wajyúú, nákhí nijni̱í iya ná inuu ne̱. <verse eid="2PE 3:6" /><verse number="7" style="v" sid="2PE 3:7" />Xómáꞌ mbá xúgíí mikhu jamí ju̱ba̱ꞌ rí ríga̱ xúge̱ꞌ rá, na̱gi̱xi̱i mújúun ne̱ ga̱jma̱á majñu̱u̱ ikhaa máꞌ ajngóo Ana̱ꞌlóꞌ, asndo gíkha ne̱ ga̱jma̱á agu ído̱ gága̱nú mbiꞌi rí Ana̱ꞌlóꞌ maxúdaa awan ga̱jma̱á numúú mbá xúgíin xa̱bo̱. Ikhaa máꞌ mbiꞌi rúꞌkhue̱n ma̱mbíin xa̱bo̱ tsí ra̱májíin.<verse eid="2PE 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8" />A̱ngui̱nꞌ, tsáanꞌ phú nandoꞌ ja̱ya̱ꞌlaꞌ, ma̱xámbumalaꞌ rí ná inuu Ana̱ꞌlóꞌ, mbá mbiꞌi jaꞌnii xómá mbá míl (1 000) tsigu, jamí rí mbá míl tsigu jaꞌnii xómá mbá mbiꞌi. <verse eid="2PE 3:8" /><verse number="9" style="v" sid="2PE 3:9" />Ra̱ꞌkhá máꞌ numuu rí naꞌne-gajyúu Táta̱ rí ma̱ꞌne-mbánuu rí nixuda-mina̱ꞌ, xómá rí nu̱ndxa̱ꞌwa̱-mijná mbá tikhuun xa̱bo̱, rí i̱ndo̱ó máꞌ numuu rí phú mba̱a̱ a̱kuii̱n gíꞌdáa̱nꞌlaꞌ. Tsíyoo Ana̱ꞌlóꞌ rí ma̱ja̱ñúu nimbáa xa̱bo̱, rí nandoo̱ rí mbá xúgíin xa̱bo̱ ma̱thanga̱a a̱kui̱ín ná inuu̱ ikhaa̱. <verse eid="2PE 3:9" /><verse number="10" style="v" sid="2PE 3:10" />Xómáꞌ Táta̱ ma̱ꞌkhaa̱ mbá mbiꞌi rí ndawa̱a̱ tsí i̱ju̱mu̱u̱, xómá na̱ꞌkha̱ mbáa ku̱ꞌwá awúun mbroꞌon.<note caller="+" style="f"><char style="fr" closed="false">3.10 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa «awúun mbroꞌon».</char></note> Ído̱ gága̱nú mbiꞌi rúꞌkhue̱n, phú gakhe̱ ma̱wán namídá rí ma̱mbáa mbá xúgíí mikhu, jamí mbá xúgíí rí ríga̱ ná inuu ne̱ ma̱ꞌni̱i idi mbá jayu gáꞌne agu. Xúꞌkhue̱n máꞌ ju̱ba̱ꞌ mangaa, mbá xúgíí rí ni̱gu̱ma ná inuu ne̱ mi̱kha.<note caller="+" style="f"><char style="fr" closed="false">3.10 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa «mi̱kha», rí «ma̱kujma xó phú jaꞌnii» iꞌthán ne̱.</char></note><verse eid="2PE 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2PE 3:11" />Xkuaꞌnii ma̱mbáa mbá xúgíí rí ríga̱. Ikhaa numuu rúꞌkhue̱n, ikháanꞌlaꞌ jaꞌyoo rí ma̱juwalaꞌ xómá rí nandoo Ana̱ꞌlóꞌ jamí rí mu̱xna̱xí-mijnálaꞌ mbá jayu ná ñawúu̱n, <verse eid="2PE 3:11" /><verse number="12" style="v" sid="2PE 3:12" />awúun máꞌ rí guáꞌthi̱ínlaꞌ jamí rí juwalaꞌ xawi rí ma̱ga̱nú mbiꞌi rí Ana̱ꞌlóꞌ maxúdaa awan ga̱jma̱á numúú xa̱bo̱. Mbiꞌi máꞌ rúꞌkhue̱n mi̱kha mbá xúgíí mikhu jamí ma̱mbáa ne̱, xúꞌkhue̱n máꞌ rí ríga̱ ná inuu ju̱ba̱ꞌ ma̱ꞌne-iya̱a ne̱ mbá jayu gáꞌne agu. <verse eid="2PE 3:12" /><verse number="13" style="v" sid="2PE 3:13" />Xómáꞌ ikháánꞌlóꞌ guáꞌthi̱ínlóꞌ mbá mikhu nuxe̱ꞌ jamí mbá ju̱ba̱ꞌ nuxe̱ꞌ, xómá rí Ana̱ꞌlóꞌ nixuda-mina̱ꞌ rí ma̱ꞌne ku̱maa, ná mbá xúgíin xa̱bo̱ mune̱ i̱ndo̱ó máꞌ rí nandoo̱ ikhaa̱.<verse eid="2PE 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14" />Ikhaa jngó, a̱ngui̱nꞌ, tsáanꞌ phú nandoꞌ ja̱ya̱ꞌlaꞌ, awúun máꞌ rí guáꞌthi̱ínlaꞌ rí ma̱ri̱gá mbá xúgíí rúꞌkhue̱n, gu̱xna̱-míjnálaꞌ tsiakhe̱ rí maxkamáaꞌlaꞌ Jesús ná awúun rí nu̱ne̱laꞌ rí máján, jamí rí ma̱xáxkamaa̱ nimbá rí ra̱máján nu̱ne̱laꞌ, xúꞌkhue̱n máꞌ rí tsímáá juwalaꞌ. <verse eid="2PE 3:14" /><verse number="15" style="v" sid="2PE 3:15" />Jamí gu̱ya̱á májánlaꞌ rí Táta̱ Jesús nagajyúu̱ kajngó ma̱goo ma̱jríñáaꞌlóꞌ. Ikhaa máꞌ rúꞌkhue̱n ñajuun rí naꞌthánlaꞌ dxájwalóꞌ Páblo̱ mangaa ná awúun i̱yi̱i̱ꞌ rí nixungue̱e̱ꞌ inalaꞌ, xómá rí Ana̱ꞌlóꞌ naꞌne rí ma̱froꞌo̱o̱. <verse eid="2PE 3:15" /><verse number="16" style="v" sid="2PE 3:16" />Mbá xúgíí máꞌ i̱yi̱i̱ꞌ rí naꞌnii̱ naꞌthée̱n ga̱jma̱á numuu ríge̱ꞌ, maske máꞌ ríga̱ mbá tikhu rí phú mingíjyúu rí ma̱fraꞌa̱ꞌlóꞌ ná awúun ne̱. Ikhaa jngó, xa̱bo̱ tsí júgoo inúú jamí tsí na̱nguá jañii a̱kui̱ín ná inuu Ana̱ꞌlóꞌ nu̱riꞌkhuíi̱ rí naꞌthán ne̱, xómá nuni̱i̱ ga̱jma̱á i̱ꞌwá i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ. Rí xkuaꞌnii ini̱i̱, mune̱-gámba̱-mijnée̱ máꞌ ikhii̱n.<verse eid="2PE 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 3:17" />Ikhaa jngó, a̱ngui̱nꞌ, tsáanꞌ phú nandoꞌ ja̱ya̱ꞌlaꞌ, numuu rí wapha máꞌ ndu̱ya̱álaꞌ mbá xúgíí ríge̱ꞌ, ga̱juwa-na̱ma̱ñalaꞌ, ra̱ꞌkhá ma̱gu̱ma-nduwáanꞌlaꞌ gúne̱ xa̱bo̱ tsí ra̱májíin, a̱ꞌkhue̱n mu̱ni̱ꞌñáá-ranimba̱laꞌ rí mbá jañii a̱kia̱nꞌlaꞌ ninimba̱ꞌlaꞌ ju̱ya̱á. <verse eid="2PE 3:17" /><verse number="18" style="v" sid="2PE 3:18" />A̱ꞌkhue̱n gakon, a̱gajáanꞌlaꞌ rí nu̱ne̱-nuwiinlaꞌ Tátiálóꞌ Jesukrísto̱ tsí naꞌne-jríñáaꞌlóꞌ jamí a̱gajáanꞌlaꞌ ga̱jma̱á majñu̱u̱ rí nandoo̱ jaꞌyalaꞌ. A̱gu̱ma-mba̱a̱ ikhaa̱, xúge̱ꞌ jamí jámuu mbiꞌi. Xkuaꞌnii gáꞌne.<verse eid="2PE 3:18" /></para>
  <chapter eid="2PE 3" />
</usx>