<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JUD" style="id">tcfU (66-Judas) - Me̱ꞌpha̱a̱ Mañúwi̱ín (Malinaltepec) (sfm NVI): (ECZ) 1er Borr 1-4 sept. 2009; 1ra. rev y lect 19-sep-2009; c1/v25</book>
  <para style="h">JÚDA̱S</para>
  <para style="toc3">Jds</para>
  <para style="toc2">Júda̱s</para>
  <para style="toc1">I̱yi̱i̱ꞌ rí niꞌtháán Júda̱s</para>
  <para style="mt2">I̱yi̱i̱ꞌ rí niꞌtháán</para>
  <para style="mt1">Júda̱s</para>
  <chapter number="1" style="c" sid="JUD 1" />
  <para style="s">Júda̱s naraxi̱in tsí nanimbu̱únꞌ juyáá Jesús</para>
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1" />Ikhúúnꞌ ñajunꞌ Júda̱s, tsí naꞌne ñajuun Jesukrísto̱, jamí dxíyo̱ꞌ ñajuun Santiágo̱.<note caller="+" style="f"><char style="fr" closed="false">1.1 </char><char style="ft" closed="false">Ná i̱yi̱i̱ꞌ griégo̱ rí wayuu naꞌthán «Jakóbo̱», rí nithán «Santiágo̱» ná ajngáa xtílo̱o̱. </char></note></para>
  <para style="b" vid="JUD 1:1" />
  <para style="p" vid="JUD 1:1">Na̱xu̱ꞌmá i̱yi̱i̱ꞌ ríge̱ꞌ inúú tsí nandoo Ana̱ꞌlóꞌ jaꞌñúú, ikháanꞌlaꞌ máꞌ tsí watraꞌwiáanꞌlaꞌ rí ma̱jáwiáanꞌlaꞌ jamí mi̱tia̱wa̱nꞌlaꞌ gáꞌne Jesukrísto̱.<verse eid="JUD 1:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="JUD 1:2" />Naꞌne a̱kui̱nꞌ rí Ana̱ꞌlóꞌ phú ma̱ñáwíin a̱kui̱in jaꞌyalaꞌ, xúꞌkhue̱n máꞌ ga̱ꞌnii̱ rí ma̱juwalaꞌ tsímáá guéño jamí phú ma̱goo̱ jaꞌyalaꞌ.<verse eid="JUD 1:2" /></para>
  <para style="s">Xáne mu̱míni̱í xa̱bo̱ tsí mi̱nduwiin</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3" />A̱ngui̱nꞌ, phú nandoꞌ ja̱ya̱ꞌlaꞌ. Maphú neꞌne a̱kui̱nꞌ rí ma̱ne̱ mbá i̱yi̱i̱ꞌ ma̱ꞌga inalaꞌ rí naꞌthán xáne nijáwiáanꞌlóꞌ neꞌne Ana̱ꞌlóꞌ. Xómáꞌ xúge̱ꞌ rá, phú i̱tha̱án ndaꞌyóo rí ma̱tha̱nꞌlaꞌ rí mu̱ña̱wa̱án májánlaꞌ gisngáá rí nanimba̱ꞌlóꞌ juꞌyáá, rí mbóó miꞌtsú nijanálóꞌ, tsáanꞌ ñajwanlóꞌ xa̱bi̱i Ana̱ꞌlóꞌ. <verse eid="JUD 1:3" /><verse number="4" style="v" sid="JUD 1:4" />Numuu rí ga̱jma̱á mi̱nduwa ni̱tu̱ꞌu̱ún mbá tikhuun xa̱bo̱ ná majña̱ꞌlaꞌ a̱ꞌkhue̱n, tsí asndo nákhí wajyúú máꞌ watraꞌwíin rí mi̱ꞌxná-máꞌíin. Xa̱bo̱ tsíge̱ꞌ tsíñúu̱ juyáa̱ Ana̱ꞌlóꞌ. Na̱ju̱múu̱ rí ma̱goo muni̱i̱ mbá xúgíí rí naꞌne a̱kuíi̱n, numuu rí phú nandoo Ana̱ꞌlóꞌ jaꞌyalóꞌ. Xúꞌkhue̱n máꞌ tsíya-makuíi̱ Jesukrísto̱, Thúngaa tsí mbáwíi naꞌthán-ñájwanlóꞌ jamí gíꞌdáanꞌlóꞌ.<verse eid="JUD 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5" />Nandoꞌ rí ma̱rmáꞌáan a̱kia̱nꞌlaꞌ rí na̱ma̱ñalaꞌ máꞌ: nákhí rí Ana̱ꞌlóꞌ ni̱gu̱wíi̱n xa̱bo̱ Israél ná Egípto̱, ído̱ wámbo̱o̱, a̱ꞌkhue̱n neꞌne-gámbii̱n tsí tánimbu̱únꞌ juyáa̱. <verse eid="JUD 1:5" /><verse number="6" style="v" sid="JUD 1:6" />Xúꞌkhue̱n máꞌ ánje̱l tsí túya̱-makuíí ñajun gamaku rí nijanúu̱ muni̱i̱ jamí nigájnúu̱ ná jaꞌñúu̱ rí ma̱ju̱wée̱ꞌ, Ana̱ꞌlóꞌ nirugua-raꞌii̱n mbá jámuu ná mijína asndo gága̱nú mbiꞌi mba̱a̱ rí maxudaa̱ awan numúu̱. <verse eid="JUD 1:6" /><verse number="7" style="v" sid="JUD 1:7" />Xkuaꞌnii máꞌ nigíꞌníí xa̱bo̱ tsí nijúwa̱ꞌ ná xuajen Sodóma̱ ga̱jma̱á Gomóra̱ jamí xuajen rí triga̱ mijngi. Ni̱dri̱guíi̱ jamínu̱ꞌ rí mu̱míníi̱ jámuu ná nakha agu, numuu nini̱i̱ aꞌkhán rí nibúu̱n gajmíi̱ xa̱bo̱ tsí túya̱a̱ jamí nene̱-maꞌchú-mijnée̱ mbá jayu xómá nene̱ ánje̱l. Rí nigíꞌníi̱ ñajuun mbá xkri̱da rí ma̱mi̱ꞌñálóꞌ.<verse eid="JUD 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8" />Xkuaꞌnii máꞌ xa̱bo̱ tsíge̱ꞌ tsí na̱ju̱mu̱ú rí nithúún inu-mbiꞌíí eꞌne Ana̱ꞌlóꞌ, nune̱-maꞌchíi̱ xuñúu̱, tsíñúu̱ rí mi̱ꞌthán-ñájúu̱n jamí nuthan-xkawiúu̱nꞌ ánje̱l tsí phú i̱tha̱án guáꞌdáá tsiakhe̱. <verse eid="JUD 1:8" /><verse number="9" style="v" sid="JUD 1:9" />Asndo ni máꞌ ánje̱l tsí phú mba̱a̱ ski̱yu̱u̱ꞌ, tsí mbiꞌyuu Migéél, nákhí ni̱tsa̱ñu̱u̱ꞌ ga̱jmáa̱ gixa̱a̱ ga̱jma̱á numuu xuyuu Moisés, ra̱khóo̱ gájmuu̱ ski̱yu̱u̱ꞌ rí maxná-máꞌáa̱n gixa̱a̱ ga̱jma̱á ajngáa xkawe̱ꞌ. A̱ꞌkhue̱n gakon niꞌthúu̱n: «Ana̱ꞌlóꞌ gáxpríguáaꞌ». <verse eid="JUD 1:9" /><verse number="10" style="v" sid="JUD 1:10" />Xómáꞌ xa̱bo̱ tsíge̱ꞌ, nuthan-xkawíi̱ꞌ mbá xúgíí rí tsífruꞌúu̱n. Jamí rí na̱ꞌngúu̱n nafruꞌúu̱n rá, nune̱-maꞌchú-mijnée̱ ga̱jma̱á ne̱, xómá ene̱ xu̱kú ini̱i̱ rí tsíndxa̱ꞌwa̱-mijnée̱.<verse eid="JUD 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JUD 1:11" />¡Phú mingíníi xa̱bo̱ tsíge̱ꞌ! numuu rí nuni̱i̱ xómá neꞌne Kaín. Ga̱jma̱á numuu rí nandúu̱n mudaa̱ mbúkha̱a̱, nagóo̱ tsu̱du̱u̱ rí mi̱nduwa xómá neꞌne Baláám, jamí numuu rí phú najñaguu̱n, ma̱ja̱ñúu̱ xómá nijáñuu Koré.<verse eid="JUD 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JUD 1:12" />Ído̱ rí nambáxi̱iꞌlaꞌ mu̱ne̱laꞌ ndxa̱a̱ numuu rí nandalaꞌ ju̱ya̱-mijnálaꞌ, nitsíti̱ñu̱ú xa̱bo̱ tsúꞌkhue̱n rí i̱ndo̱ó máꞌ naguwée̱ꞌ rí mu̱piꞌtsii̱ jamí rí mune̱-maꞌchíi̱ ndxa̱a̱ rí nu̱ne̱laꞌ. Xómá du̱u̱n rí tsíꞌne ruꞌwa rí ge̱e̱ ñúꞌún na̱ka̱ jayóo gíñá jaꞌñúu̱, jamí xómá ixe̱ rí tsíxná xndúu. Nijáñúu̱ mbá jayu xómá ixe̱ rí watrubu asndo ajmu̱u̱. <verse eid="JUD 1:12" /><verse number="13" style="v" sid="JUD 1:13" />Phú xkujnduu̱n jamí phú xkawe̱ꞌ rí nuni̱i̱, xómá xngaꞌá smba rí na̱ga̱núu ná rawuun iya a̱pha̱ ído̱ rí namangu̱u̱ꞌ jaꞌñúu̱. Xómá a̱ꞌgua̱án tsí nindáti̱gi̱in jaꞌñúu̱, tsí ninguanúú máꞌ rí ma̱ngrigu̱ún jámuu ná phú gakhe̱ mijína.<verse eid="JUD 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14" />Mangaa máꞌ Enók, tsí tijwan kuthuun xa̱bo̱ tsí nigóó-rajúwa̱ꞌ asndo nákhí Adán, niꞌthán xáꞌnii ga̱jma̱á numúú xa̱bo̱ tsúꞌkhue̱n: «Je̱én lá, phú mbaꞌiin ánje̱l drígo̱o̱ Ana̱ꞌlóꞌ i̱ꞌkha̱ gajmíí, <verse eid="JUD 1:14" /><verse number="15" style="v" sid="JUD 1:15" />kajngó maxudaa̱ awan ga̱jma̱á numúú mbá xúgíin xa̱bo̱. Ma̱ꞌne Ana̱ꞌlóꞌ rí mu̱míni̱í mbá xúgíin tsí nene̱ rí ra̱máján jamí nithan mbá xúgíí inii rí xkawe̱ꞌ ga̱jma̱á numuu̱ ikhaa̱». <verse eid="JUD 1:15" /><verse number="16" style="v" sid="JUD 1:16" />Xa̱bo̱ tsíge̱ꞌ nune̱-xkujndii̱ ga̱jma̱á numuu mbá xúgíí jamí mbá xúgíí rí nune̱ tsí i̱ꞌwíin, ra̱máján iyáa̱. Xómáꞌ ikhii̱n nuni̱i̱ mbá xúgíí inii rí naꞌne a̱kuíi̱n. Ído̱ rí nuthee̱n, mbáko máꞌ nu̱xu̱xí-mijnée̱, jamí ído̱ nuthee̱n rí máján numuu i̱mba̱a̱ꞌ, nandúu̱n rí ma̱ꞌngúu̱n mune̱-rájáa̱.<verse eid="JUD 1:16" /></para>
  <para style="s">Ga̱wajún-gúkuálaꞌ ná inuu Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17" />Xómáꞌ ikháanꞌlaꞌ a̱ngui̱nꞌ, tsáanꞌ phú nandoꞌ ja̱ya̱ꞌlaꞌ, ga̱rmáꞌáan a̱kia̱nꞌlaꞌ ju̱ya̱á ajngáa rí nithanlaꞌ nákhí wapha xa̱bo̱ tsí waxúngui̱inꞌ neꞌne Tátiálóꞌ Jesukrísto̱. <verse eid="JUD 1:17" /><verse number="18" style="v" sid="JUD 1:18" />Ikhii̱n nithanlaꞌ rí ma̱ga̱nú mbiꞌi rí ma̱ju̱wá xa̱bo̱ tsí na̱ni̱gu̱ún rí mune̱-mati̱inꞌ i̱ꞌwíin xa̱bo̱, tsí ma̱ju̱wá rí mune̱ rí xkawe̱ꞌ xómá naꞌne a̱kui̱ín ikhiin. <verse eid="JUD 1:18" /><verse number="19" style="v" sid="JUD 1:19" />Tsíge̱ꞌ ñajúún tsí nune̱ rí mu̱xpi̱ꞌtha̱-mijná xa̱bo̱, jamí júwe̱e̱ꞌ xómá rí nandoo xuñúu̱ numuu rí na̱nguá xtáa Xu̱u̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxúu̱n.<verse eid="JUD 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JUD 1:20" />Xómáꞌ ikháanꞌlaꞌ a̱ngui̱nꞌ, tsáanꞌ phú nandoꞌ ja̱ya̱ꞌlaꞌ, ga̱wajún-gúkuálaꞌ ná tsu̱du̱u̱ rí phú mitsaan nanimba̱ꞌlaꞌ ju̱ya̱á. Gu̱tha̱n-jáñíílaꞌ Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ. <verse eid="JUD 1:20" /><verse number="21" style="v" sid="JUD 1:21" />Ga̱nimba̱ꞌlaꞌ máꞌ xúꞌkhue̱n rí Ana̱ꞌlóꞌ nandoo jaꞌyalaꞌ, awúun rí guáꞌthi̱ínlaꞌ ma̱ga̱nú mbiꞌi rí Ana̱ꞌlóꞌ Jesukrísto̱ ma̱ꞌne rí ma̱juwalóꞌ jámuu, ga̱jma̱á numuu rí phú nañáwíin a̱kuii̱n e̱ꞌne̱lóꞌ.<verse eid="JUD 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22" />Gu̱mbáñúúlaꞌ rí ma̱fruꞌu̱ún tsí a̱jma̱ a̱kui̱ín. <verse eid="JUD 1:22" /><verse number="23" style="v" sid="JUD 1:23" />Xómáꞌ tsí i̱ꞌwíin rá, gu̱ne̱-jáwíi̱nlaꞌ ná awúun agu rí nakha jámuu. Jamí ga̱ñáwíin a̱kia̱nꞌlaꞌ ju̱ñu̱ú tsí ndaꞌyóo rí ma̱ñáwíin a̱kia̱nꞌlaꞌ ju̱ñu̱ú. I̱ndo̱ó máꞌ numuu rí ga̱xu̱ꞌwánlaꞌ gáꞌne asndo xtíñúu̱ rí nene̱-maꞌchíi̱ ga̱jma̱á aꞌkhúu̱n.<verse eid="JUD 1:23" /></para>
  <para style="s">A̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24" />Ana̱ꞌlóꞌ phú gíꞌdoo̱ tsiakhe̱ rí ma̱ña̱wa̱nꞌlóꞌ kajngó ma̱xárákáanꞌlóꞌ ná rí ra̱máján, xúꞌkhue̱n máꞌ rí ma̱ꞌnii̱ rí nda̱a̱ aꞌkhánlóꞌ jamí rí phú gagi a̱kia̱nꞌlóꞌ ído̱ rí ma̱tu̱malóꞌ ná inuu̱. <verse eid="JUD 1:24" /><verse number="25" style="v" sid="JUD 1:25" />Mbáwíi máꞌ tsí ñajuun Ana̱ꞌlóꞌ, tsí naꞌne-jríñáa̱ꞌlóꞌ. Ikhaa jngó a̱gu̱ma-mba̱a̱ i̱ndo̱ó máꞌ Ana̱ꞌlóꞌ, a̱gu̱ma-makuíi̱, a̱grui̱guíi̱ tsiakhe̱ jamí gaꞌthán-ñájwii̱n i̱ndo̱ó máꞌ ikhaa̱,<note caller="+" style="f"><char style="fr" closed="false">1.25 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán xóó: «ga̱jma̱á majñu̱u̱ Tátiálóꞌ Jesukrísto̱».</char></note> asndo nákhí xúge̱ꞌ máꞌ<note caller="+" style="f"><char style="fr" closed="false">1.25 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán: «asndo nákhí wajyúú mbiꞌi, xúge̱ꞌ máꞌ... ». </char></note> jamí asndo jámuu mbiꞌi. Xkuaꞌnii gáꞌne.<verse eid="JUD 1:25" /></para>
  <chapter eid="JUD 1" />
</usx>