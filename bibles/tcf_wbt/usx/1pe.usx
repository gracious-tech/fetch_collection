<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1PE" style="id">tcfU (61-1Ped) - Me̱ꞌpha̱a̱ Mañúwi̱ín (Malinaltepec) 1er trazo ECZ 8-23sep2009, c5/v105</book>
  <para style="h">1 Pédro̱</para>
  <para style="toc3">1 P</para>
  <para style="toc2">1 Pédro̱</para>
  <para style="toc1">Timbá i̱yi̱i̱ꞌ rí niꞌtháán Pédro̱</para>
  <para style="mt2">Timbá i̱yi̱i̱ꞌ rí niꞌtháán</para>
  <para style="mt1">Pédro̱</para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="s">Pédro̱ naraxi̱in tsí nanimbu̱únꞌ juyáá Jesús</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1" />Ikhúúnꞌ ñajunꞌ Pédro̱, mbáa xa̱bo̱ tsí waxúngua̱a̱ꞌ neꞌne Jesukrísto̱.</para>
  <para style="b" vid="1PE 1:1" />
  <para style="p" vid="1PE 1:1">Na̱xu̱ꞌmá i̱yi̱i̱ꞌ ríge̱ꞌ inúú xa̱bo̱ tsí na̱nguá júwa̱ꞌ ná xuajñúú, ikhiin máꞌ tsí júwa̱ꞌ mbá xúgíí numbaa Pónto̱, Galásia̱, Kapadósia̱, Ásia̱ jamí Bitínia̱. <verse eid="1PE 1:1" /><verse number="2" style="v" sid="1PE 1:2" />Ga̱jma̱á numuu rí niꞌgí-mina̱ꞌ máꞌ Ana̱ꞌlóꞌ ma̱ꞌne, ikhaa̱ wapha máꞌ niraꞌwáa̱nꞌlaꞌ jamí ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ naꞌnii̱ rí ma̱nindxa̱ꞌlaꞌ xa̱bii̱, kajngó mu̱ne̱-mbáníílaꞌ rí naꞌthán Jesukrísto̱ jamí ma̱gu̱ma-jaꞌwáanꞌlaꞌ ga̱jma̱á iꞌdiuu̱.</para>
  <para style="b" vid="1PE 1:2" />
  <para style="p" vid="1PE 1:2">Phú a̱gu̱ma-tsakun-rámáaꞌlaꞌ gáꞌne Ana̱ꞌlóꞌ jamí ga̱juwalaꞌ tsímáá mi̱ndaꞌkho.<verse eid="1PE 1:2" /></para>
  <para style="s">A̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ numuu rí ríga̱ mújúun rí mu̱drígúulóꞌ</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3" />A̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ, Anu̱u̱ máꞌ Tátiálóꞌ Jesukrísto̱, numuu rí phú mba̱a̱ niñáwíin a̱kuii̱n jaꞌyalóꞌ jamí niꞌnii̱ rí ma̱gu̱ma-nuxáanꞌlóꞌ ga̱jma̱á majñu̱u̱ rí ndiyáa mbiꞌyuu Jesukrísto̱. Rúꞌkhue̱n naꞌne rí ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ mu̱waꞌthi̱ínlóꞌ <verse eid="1PE 1:3" /><verse number="4" style="v" sid="1PE 1:4" />rí mu̱drígúulóꞌ rí gíꞌdoo̱ mújúu̱n maxnálóꞌ ná mikhuíí. Rí maxnálóꞌ tsíguu, ni máꞌ tsíꞌchúu, ni máꞌ tsíyámba̱ ne̱. <verse eid="1PE 1:4" /><verse number="5" style="v" sid="1PE 1:5" />Ga̱jma̱á numuu rí wéje̱ a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ, ikhaa̱ na̱ña̱wa̱nꞌlaꞌ ga̱jma̱á ski̱yu̱u̱ꞌ, kajngó ma̱goo ma̱jáwiáanꞌlaꞌ ído̱ gága̱nú mbiꞌi rí ndámba̱wóo.<verse eid="1PE 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 1:6" />Rúꞌkhue̱n naꞌne rí phú ma̱ꞌdxu a̱kia̱nꞌlaꞌ rí xúge̱ꞌ, maske máꞌ ndaꞌyóo rí ma̱nújngalaꞌ ná awúun mbaꞌa inii jamínu̱ꞌ mbá wátha̱ wáa mbiꞌi. <verse eid="1PE 1:6" /><verse number="7" style="v" sid="1PE 1:7" />Rí ajwa̱nꞌ mo̱jmo̱ꞌ, nanújngoo ne̱ ná awúun agu kajngó ma̱gu̱ma-jaꞌwu̱u ne̱, maske máꞌ ma̱ga̱nú mbiꞌi rí ma̱mbáa ne̱. Xkuaꞌnii máꞌ rí wéje̱ a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ mangaa, rí phú i̱tha̱án gíꞌdoo numuu xó rí ajwa̱nꞌ mo̱jmo̱ꞌ, nanújngoo ne̱ ná awúun jamínu̱ꞌ kajngó mi̱ꞌthán rí máján ga̱jma̱á numuu ne̱, ma̱gu̱ma-mba̱a̱ ne̱ jamí mbi̱ꞌya-makuíí ne̱ ído̱ rí ma̱ꞌkha̱a Jesukrísto̱.<verse eid="1PE 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 1:8" />Ikháanꞌlaꞌ nandalaꞌ ju̱ya̱á Jesukrísto̱ maske máꞌ ni miꞌtsú túyáa̱laꞌ. Rí xúge̱ꞌ rá, nanimba̱ꞌlaꞌ ju̱yáa̱ maske máꞌ na̱nguá i̱yáa̱laꞌ, jamí asndo ni tsíꞌngo̱o̱ ajngáa rí mi̱ꞌthán ga̱jma̱á numuu gagi rí phú mba̱a̱ jamí mitsaan rí guáꞌdáálaꞌ. <verse eid="1PE 1:8" /><verse number="9" style="v" sid="1PE 1:9" />Ikháanꞌlaꞌ phú nadxalaꞌ numuu rí najríñáaꞌlaꞌ máꞌ. Ikhaa rúꞌkhue̱n jaꞌyoo ma̱janálaꞌ ga̱jma̱á numuu rí wéje̱ a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ.<verse eid="1PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10" />Ga̱jma̱á máꞌ numuu rí ma̱jáwiáanꞌlaꞌ, nene̱-gajma̱a̱ mújúún jamí ni̱ra̱xe̱-makúún tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ wajyúú, jamí nithee̱n ga̱jma̱á numuu rí naꞌgí-mina̱ꞌ Ana̱ꞌlóꞌ rí maxnálaꞌ. <verse eid="1PE 1:10" /><verse number="11" style="v" sid="1PE 1:11" />Xu̱u̱ꞌ Krísto̱ tsí xtáa̱ ná awúun a̱kui̱ín xa̱bo̱ tsúꞌkhue̱n, niꞌthán-múꞌúu̱n rí phú mamínu̱u̱ꞌ Krísto̱ rí ginii jamí nda̱wa̱á a̱ꞌkhue̱n ma̱ꞌkha̱ rí phú tsímáá, ikhaa jngó nune̱-gajma̱a̱ mújúu̱n kajngó mbuyáa̱ tsáa xa̱bi̱i̱ nithán numuu jamí nguáná gáríga̱ rúꞌkhue̱n. <verse eid="1PE 1:11" /><verse number="12" style="v" sid="1PE 1:12" />A̱ꞌkhue̱n ni̱ma̱ꞌthoo inúu̱ neꞌne Ana̱ꞌlóꞌ kajngó ma̱fruꞌúu̱n rí ra̱ꞌkhá ga̱jma̱á numúu̱ ikhii̱n nuni̱i̱ rí nuthee̱n, rí ga̱jma̱á numalaꞌ ikháanꞌlaꞌ. Rí nithan tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ wajyúú, ikhaa máꞌ rúꞌkhue̱n ñajuun rí nisngálaꞌ xa̱bo̱ tsí nithanlaꞌ ajngáa máján ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ tsí ni̱ꞌkha̱ mikhuíí. Mbá xúgíí rúꞌkhue̱n, asndo ánje̱l naꞌne a̱kuíi̱n rí mbuyáá mangiin. <verse eid="1PE 1:12" /><verse number="13" style="v" sid="1PE 1:13" />Ikhaa numuu rúꞌkhue̱n, ga̱juwalaꞌ xawi kajngó mu̱ne̱laꞌ rí nafraꞌa̱ꞌlaꞌ. Gu̱ndxa̱ꞌwa̱-mijná májánlaꞌ rí mu̱ne̱laꞌ. Mbá jañii a̱kia̱nꞌlaꞌ gáwaꞌthi̱ínlaꞌ rí maxnálaꞌ Ana̱ꞌlóꞌ ído̱ rí ma̱ꞌkha̱a Jesukrísto̱.<verse eid="1PE 1:13" /></para>
  <para style="s">Ga̱kujma rí jaꞌwu a̱kia̱nꞌlaꞌ</para>
  <para style="p">
    <verse number="14" style="v" sid="1PE 1:14" />Nákhí rí júgoo inalaꞌ, ikháanꞌlaꞌ ne̱ne̱laꞌ mbá xúgíí inii rí xkawe̱ꞌ na̱ni̱gua̱ꞌlaꞌ rí mu̱ne̱laꞌ. Ikhaa jngó rí xúge̱ꞌ rá, gu̱ne̱laꞌ rí nandoo Ana̱ꞌlóꞌ, xómá ene̱ e̱je̱n tsí nune̱-mbáníí rí nithúún. <verse eid="1PE 1:14" /><verse number="15" style="v" sid="1PE 1:15" />Ga̱kujma rí jaꞌwu a̱kia̱nꞌlaꞌ ga̱jma̱á majñu̱u̱ mbá xúgíí rí nu̱ne̱laꞌ, xómá rí jaꞌwu a̱kui̱in Ana̱ꞌlóꞌ tsí nindxaꞌwálaꞌ. <verse eid="1PE 1:15" /><verse number="16" style="v" sid="1PE 1:16" />Numuu rí xkuaꞌnii ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ: «Ga̱nindxa̱ꞌlaꞌ xa̱bo̱ tsí jaꞌwu a̱kui̱ín, numuu rí ikhúúnꞌ jaꞌwu a̱kui̱nꞌ».<note caller="+" style="f"><char style="fr" closed="false">1.16 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yi̱i̱ꞌ xa̱bi̱i Lebí 11.44-45, 19.2 jamí ná 20.7.</char></note><verse eid="1PE 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 1:17" />Xí nu̱tha̱nlaꞌ rí Tátiálaꞌ ñajuun tsí na̱nguá iraꞌwíin xa̱bo̱ tsí ma̱ꞌne-nga̱ju̱ún ído̱ rí naxudaa̱ awan ga̱jma̱á numuu rí neꞌne mbámbáa, ga̱mi̱ꞌñálaꞌ ju̱ya̱á Ana̱ꞌlóꞌ awúun mbá xúgíí mbiꞌi rí juwalaꞌ mbégo ná tsu̱du̱u̱ numbaa ríge̱ꞌ. <verse eid="1PE 1:17" /><verse number="18" style="v" sid="1PE 1:18" />Numuu rí ndu̱ya̱á máꞌ májánlaꞌ rí Ana̱ꞌlóꞌ neꞌtse̱-ri̱ñáaꞌlaꞌ ná awúun rí nda̱a̱ mbá jayu numuu nijuwalaꞌ, rí ni̱drígúulaꞌ ná ñawúún táta̱-xi̱ꞌñálaꞌ wajyúú. Jamí tágu̱ma-numáá rí me̱ꞌtse̱-ri̱ñáaꞌlaꞌ ga̱jma̱á mbá rí naꞌchúu, xómá ajwa̱nꞌ mo̱jmo̱ꞌ o ajwa̱nꞌ miꞌxá mbo̱ꞌ, <verse eid="1PE 1:18" /><verse number="19" style="v" sid="1PE 1:19" />rí ni̱gu̱ma-numáá ne̱ ga̱jma̱á mbá rí phú i̱tha̱án gíꞌdoo numuu, iꞌdiuu Krísto̱, tsí ninindxu̱u̱ xómá a̱ꞌdá-mógó tsí phú mitsiꞌyáa jamí nda̱a̱ aꞌkhúun. <verse eid="1PE 1:19" /><verse number="20" style="v" sid="1PE 1:20" />Ana̱ꞌlóꞌ niraꞌwíi Krísto̱ asndo nákhí xóó máꞌ táꞌne-ku̱maa̱ numbaa. Xómáꞌ xúge̱ꞌ rá, ná awúun mbiꞌi rí na̱ka̱-rayámba̱ numbaa, nikujmaa̱ ga̱jma̱á numalaꞌ ikháanꞌlaꞌ. <verse eid="1PE 1:20" /><verse number="21" style="v" sid="1PE 1:21" />Ga̱jma̱á majñu̱u̱ máꞌ Krísto̱, ikháanꞌlaꞌ nanimba̱ꞌlaꞌ ju̱ya̱á Ana̱ꞌlóꞌ. Ana̱ꞌlóꞌ neꞌne rí mbayáa mbiꞌyuu Krísto̱ jamí niꞌnii̱ rí phú ma̱gi̱ꞌdoo numuu̱, kajngó ma̱we̱je̱ a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ jamí ga̱jma̱á mbá jañii a̱kia̱nꞌlaꞌ mu̱waꞌthi̱ínlaꞌ ná inuu̱.<verse eid="1PE 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22" />Nákhí rí ikháanꞌlaꞌ ni̱drígúlaꞌ ajngáa rí gakon ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ,<note caller="+" style="f"><char style="fr" closed="false">1.22 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ».</char></note> a̱ꞌkhue̱n neꞌne-jaꞌwu̱u a̱kia̱nꞌlaꞌ kajngó ma̱ꞌne gakon rí nandalaꞌ ju̱ñu̱ú a̱ngia̱nꞌlaꞌ. Ikhaa jngó, ga̱galaꞌ ju̱ya̱-mijnálaꞌ ga̱jma̱á mbá jañii a̱kia̱nꞌlaꞌ. <verse eid="1PE 1:22" /><verse number="23" style="v" sid="1PE 1:23" />Numuu rí ikháanꞌlaꞌ ni̱gu̱ma-nuxáanꞌlaꞌ, ra̱ꞌkhá ga̱jma̱á majñu̱u̱ ri̱jyu̱u̱ꞌ xa̱bo̱ numbaa rí wéje̱ ma̱mbáa, rí ga̱jma̱á majñu̱u̱ ajngáa rawuun Ana̱ꞌlóꞌ tsí ndaꞌya jamí xtáa jámuu. <verse eid="1PE 1:23" /><verse number="24" style="v" sid="1PE 1:24" />Numuu rí xkuaꞌnii ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="b" vid="1PE 1:24" />
  <para style="q" vid="1PE 1:24">«Jámba̱a̱ xa̱bo̱ numbaa xómá iná jaꞌnii̱,</para>
  <para style="q" vid="1PE 1:24">jamí mbá xúgíí rí gíꞌdoo numuu̱ xómá ri̱ꞌyu̱u̱ iná jaꞌnii ne̱.</para>
  <para style="q" vid="1PE 1:24">Rí iná nojndoo ne̱, jamí rí ri̱ꞌyu̱u̱ iná na̱ráka ne̱,<verse eid="1PE 1:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="1PE 1:25" />xómáꞌ rí ajngáa rawuun Táta̱ rá, jámuu ríga̱ ne̱».<note caller="+" style="f"><char style="fr" closed="false">1.25 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 40.6-8.</char></note></para>
  <para style="b" vid="1PE 1:25" />
  <para style="m" vid="1PE 1:25">Jamí ikhaa máꞌ ajngáa rúꞌkhue̱n ñajuun ajngáa máján rí waꞌthánlaꞌ.<verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="s">Krísto̱ ñajuun xómá itsí rí na̱ge̱ꞌe̱ ná nakhúu guꞌwá</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />Ikhaa jngó, gu̱ni̱ꞌñáá-ru̱ne̱laꞌ mbá xúgíí inii rí xkawe̱ꞌ, mbá xúgíí inii rí mi̱nduwa. Ma̱xáꞌne a̱jma̱ inalaꞌ, ma̱xáxígua̱ꞌlaꞌ ni máꞌ mu̱xúne̱-xtutaalaꞌ ga̱jma̱á numúú xa̱bo̱. <verse eid="1PE 2:1" /><verse number="2" style="v" sid="1PE 2:2" />Gu̱smijnálaꞌ mi̱ndaꞌkho xómá ene̱ e̱je̱n cháña̱ꞌ, rí mu̱wanlaꞌ yaꞌdú jaꞌwu, rí ñajuun ajngóo Ana̱ꞌlóꞌ. Kajngó ga̱jma̱á majñu̱u̱ ne̱ ikhaa ma̱gajáanꞌlaꞌ, jamí ma̱jríñáaꞌlaꞌ. <verse eid="1PE 2:2" /><verse number="3" style="v" sid="1PE 2:3" />Numuu rí ndu̱ya̱álaꞌ máꞌ rí phú májáan a̱kui̱in Táta̱.<verse eid="1PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 2:4" />Gu̱xu̱ꞌmá-mijnálaꞌ ná inuu Krísto̱, numuu rí ikhaa̱ ñajuu̱n xómá itsí ndaꞌya rí támakúún xa̱bo̱ numbaa juyáá, xómáꞌ Ana̱ꞌlóꞌ niraꞌwíi̱ rí ma̱nindxu̱u̱ xómá itsí rí phú gíꞌdoo numuu. <verse eid="1PE 2:4" /><verse number="5" style="v" sid="1PE 2:5" />Jamí ikháanꞌ mangáanꞌlaꞌ ñajwanlaꞌ xómá itsí ndaꞌya rí na̱gu̱ma ga̱jma̱á guꞌwóo Ana̱ꞌlóꞌ. Xkuaꞌnii kajngó ma̱nindxa̱ꞌlaꞌ dxakuun jaꞌwuun tsí nu̱xna̱xí tsi̱gi̱jña̱ꞌ rí na̱ni̱gu̱u̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ Jesukrísto̱. <verse eid="1PE 2:5" /><verse number="6" style="v" sid="1PE 2:6" />Ikhaa numuu rúꞌkhue̱n naꞌthán i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ mangaa:</para>
  <para style="b" vid="1PE 2:6" />
  <para style="q" vid="1PE 2:6">«A̱gu̱ya̱álaꞌ rí na̱ꞌgí ná xuajen Sióón itsí ginii rí na̱ge̱ꞌe̱ ná nakhúu guꞌwá,</para>
  <para style="q" vid="1PE 2:6">rí watraꞌwíí jamí phú gíꞌdoo numuu.</para>
  <para style="q" vid="1PE 2:6">Tsí ma̱nimbo̱o̱ꞌ jaꞌyoo̱ ikhaa̱, ma̱xáthájwíin a̱kuii̱n».<note caller="+" style="f"><char style="fr" closed="false">2.6 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 28.16.</char></note><verse eid="1PE 2:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="1PE 2:7" />Xómáꞌ ikháanꞌlaꞌ, tsáanꞌ nanimba̱ꞌlaꞌ ju̱yáa̱, ndu̱ya̱álaꞌ rí ikhaa̱ phú gíꞌdoo numuu̱. Xómáꞌ tsí tsínimbu̱únꞌ juyáa̱ rá, ikhaa̱ ñajuu̱n xómá:</para>
  <para style="b" vid="1PE 2:7" />
  <para style="q" vid="1PE 2:7">«Itsí rí ni̱ni̱ꞌñá-ti̱ga̱ xa̱bo̱ tsí nune̱ guꞌwá,</para>
  <para style="q" vid="1PE 2:7">ikhaa ne̱ ninindxu̱u̱ itsí mba̱a̱ rí jayá ski̱yu̱u̱ꞌ rakhóo guꞌwá».<note caller="+" style="f"><char style="fr" closed="false">2.7 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 118.22.</char></note><verse eid="1PE 2:7" /></para>
  <para style="b" />
  <para style="m">
    <verse number="8" style="v" sid="1PE 2:8" />Jamí xáꞌnii ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ mangaa:</para>
  <para style="b" vid="1PE 2:8" />
  <para style="q" vid="1PE 2:8">«Mbá itsí rí ma̱ngráꞌiin jamí ma̱ꞌne rí ma̱xpátri̱gi̱in xa̱bo̱ gáꞌne».<note caller="+" style="f"><char style="fr" closed="false">2.8 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 8.14.</char></note></para>
  <para style="b" vid="1PE 2:8" />
  <para style="m" vid="1PE 2:8">Nu̱xi̱ꞌnée̱ ído̱ tsíñúu̱ gúdxawíi̱n ajngóo Ana̱ꞌlóꞌ. Ikhaa máꞌ rúꞌkhue̱n ñajuun rí niꞌgí-mina̱ꞌ Ana̱ꞌlóꞌ rí ma̱gíꞌníi̱.<verse eid="1PE 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9" />Xómáꞌ ikháanꞌlaꞌ ñajwanlaꞌ xa̱bo̱ tsí niraꞌwíin Ana̱ꞌlóꞌ, dxakuun tsí nu̱ñajun ná inuu Thúngaa Mikhuíí, mbá numbaa ná júwa̱ꞌ xa̱bo̱ tsí jaꞌwuun, jamí xa̱bo̱ xuajñuu Ana̱ꞌlóꞌ ñajwanlaꞌ. Ana̱ꞌlóꞌ nindxaꞌwálaꞌ rí ma̱ga̱jnáaꞌlaꞌ ná mijína kajngó ma̱mbiꞌyalaꞌ aguu̱ rí phú mitsaan, jamí mu̱tha̱nlaꞌ rí phú wáá naꞌnii̱. <verse eid="1PE 2:9" /><verse number="10" style="v" sid="1PE 2:10" />Rí nákhí wajyúú, tánindxa̱ꞌlaꞌ xa̱bo̱ xuajñuu Ana̱ꞌlóꞌ, xómáꞌ xúge̱ꞌ rá, xa̱bo̱ xuajñuu Ana̱ꞌlóꞌ ñajwanlaꞌ. Rí nákhí wajyúú, ndawa̱a̱ tsí niñáwíin a̱kui̱in jaꞌyalaꞌ, xómáꞌ xúge̱ꞌ rá, niñáwíin a̱kui̱in Ana̱ꞌlóꞌ jaꞌyalaꞌ.<verse eid="1PE 2:10" /></para>
  <para style="s">Ga̱nindxa̱ꞌlaꞌ mbá xkri̱da rí máján mbuyáá xa̱bo̱</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11" />A̱ngui̱nꞌ, tsáanꞌ phú nandoꞌ ja̱ya̱ꞌlaꞌ, na̱tha̱n-jáñalaꞌ xómá xa̱bo̱ tsí ra̱ꞌkhá xuajñúú ñajuun numbaa ríge̱ꞌ jamí xa̱bo̱ tsí nagóó-ranújngúún, rí mu̱xúne̱laꞌ rí nandoo xuyalaꞌ, numuu rí rúꞌkhue̱n na̱tsa̱ñu̱u̱ꞌ ga̱jma̱á nímia̱ꞌlaꞌ. <verse eid="1PE 2:11" /><verse number="12" style="v" sid="1PE 2:12" />Máján gájuwalaꞌ ná majñu̱ú xa̱bo̱ tsí tsíne̱-nuwiin Ana̱ꞌlóꞌ. Xkuaꞌnii kajngó mbuyáa̱ rí máján nu̱ne̱laꞌ jamí mune̱-mba̱a̱ Ana̱ꞌlóꞌ ído̱ rí maxúꞌdaa̱ awan ga̱jma̱á numúú mbá xúgíin xa̱bo̱, maske máꞌ ikhii̱n nuthee̱n rí xkawe̱ꞌ e̱ne̱laꞌ rí xúge̱ꞌ.<verse eid="1PE 2:12" /></para>
  <para style="s">Gu̱ne̱-mbáníílaꞌ rí nuthan xa̱bo̱ ñajun</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13" />Ga̱jma̱á numuu rí ndu̱ya̱-makuíílaꞌ Táta̱, gu̱ni̱ꞌñá-mijnálaꞌ rí muxna-ñajwanlaꞌ mbá xúgíin xa̱bo̱ ñajun: thúngaa, numuu rí ikhaa̱ jayée̱ idxu̱u̱ xuajen, <verse eid="1PE 2:13" /><verse number="14" style="v" sid="1PE 2:14" />xa̱bo̱ ñajun tsí niskuíji̱in thúngaa, numuu rí ikhii̱n júwe̱e̱ꞌ kajngó mu̱drígú jamínu̱ꞌ xa̱bo̱ tsí nune̱ rí xkawe̱ꞌ jamí muthee̱n rí máján ga̱jma̱á numúú tsí nune̱ rí máján. <verse eid="1PE 2:14" /><verse number="15" style="v" sid="1PE 2:15" />Numuu rí Ana̱ꞌlóꞌ nandoo rí mu̱ne̱laꞌ rí máján kajngó ma̱ꞌne-wíyuu rawúún tsí tsífruꞌu̱ún jamí júgoo inúú. <verse eid="1PE 2:15" /><verse number="16" style="v" sid="1PE 2:16" />Ga̱juwalaꞌ xómá xa̱bo̱ tsí na̱nguá nithán-ñájúún, i̱ndo̱ó máꞌ numuu rí mu̱xúne̱-tsu̱di̱ílaꞌ rí ndawa̱a̱ tsí iꞌthán-ñajwanlaꞌ kajngó ma̱goo mu̱ne̱laꞌ rí xkawe̱ꞌ, rí ga̱juwalaꞌ xómá yumbée Ana̱ꞌlóꞌ. <verse eid="1PE 2:16" /><verse number="17" style="v" sid="1PE 2:17" />Gu̱ya̱-makúúnlaꞌ mbá xúgíin xa̱bo̱. Ga̱galaꞌ ju̱ñu̱ú xa̱bi̱i Ana̱ꞌlóꞌ. Ga̱mi̱ꞌñálaꞌ ju̱ya̱á Ana̱ꞌlóꞌ. Gu̱ya̱-makuíílaꞌ thúngaa.<verse eid="1PE 2:17" /></para>
  <para style="s">Rí jaꞌyoo mune̱ yumbáá tsí nu̱ñajun guꞌwáá</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18" />Ikháanꞌlaꞌ, yumbáá tsí nu̱ñajunlaꞌ guꞌwáá, gu̱ya̱-makúúnlaꞌ tsí ñajúún ña̱ꞌñalaꞌ. Gu̱ya̱-makúu̱nlaꞌ, ra̱ꞌkhá máꞌ i̱ndo̱ó tsí májáan a̱kui̱ín jamí gamakuun, rí asndo tsí xkawi̱i̱ꞌ máꞌ a̱kui̱ín mangaa. <verse eid="1PE 2:18" /><verse number="19" style="v" sid="1PE 2:19" />Numuu rí mbá rí máján ñajuun ná inuu Ana̱ꞌlóꞌ xí mbáa tsí nda̱a̱ aꞌkhúun na̱ꞌngo̱o̱ a̱kui̱in namínu̱u̱ꞌ, maske máꞌ ndaꞌyoo̱ mújúu̱n rí naꞌnii̱ rí nandoo Ana̱ꞌlóꞌ. <verse eid="1PE 2:19" /><verse number="20" style="v" sid="1PE 2:20" />Xí mbáa na̱ꞌngo̱o̱ a̱kui̱in mamínu̱u̱ꞌ ga̱jma̱á numuu rí ra̱máján neꞌne, náá lá rí phú wáá rúꞌkhue̱n rá. Jamí xí mbáa na̱ꞌngo̱o̱ a̱kui̱in mamínu̱u̱ꞌ ga̱jma̱á numuu rí naꞌne rí máján rá, rúꞌkhue̱n rí máján ná inuu Ana̱ꞌlóꞌ. <verse eid="1PE 2:20" /><verse number="21" style="v" sid="1PE 2:21" />Ikhaa máꞌ numuu rúꞌkhue̱n nindxaꞌwálaꞌ Ana̱ꞌlóꞌ, numuu rí nimínu̱u̱ꞌ máꞌ Krísto̱ mangaa ga̱jma̱á numalaꞌ. Xkuaꞌnii niꞌgíi̱ mbá xkri̱da rí mbu̱ya̱-ri̱dáálaꞌ kajngó xkuaꞌnii máꞌ gúne̱ mangáanꞌlaꞌ.<verse eid="1PE 2:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="1PE 2:22" />«Ikhaa̱ táꞌnii̱ nimbá aꞌkhán,</para>
  <para style="q" vid="1PE 2:22">jamí ni miꞌtsú táꞌthée̱n rí mi̱nduwa».<note caller="+" style="f"><char style="fr" closed="false">2.22 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 53.9.</char></note><verse eid="1PE 2:22" /></para>
  <para style="b" />
  <para style="m">
    <verse number="23" style="v" sid="1PE 2:23" />Nákhí rí Krísto̱ nithán-xkawíi̱ꞌ ene̱ xa̱bo̱, ikhaa̱ táriꞌñúu̱ ga̱jma̱á ajngáa xkawe̱ꞌ. Nákhí rí xtáa̱ namínu̱u̱ꞌ, tsíꞌne-míñúu̱ xa̱bo̱ rí mu̱míníi̱ ga̱jma̱á numuu rí nuñíi̱, a̱ꞌkhue̱n gakon niniña-mine̱e̱ꞌ ná ñawúun Ana̱ꞌlóꞌ tsí naxudaa mújúun awan ga̱jma̱á numúú xa̱bo̱. <verse eid="1PE 2:23" /><verse number="24" style="v" sid="1PE 2:24" />Jmína̱a̱ꞌ máꞌ Krísto̱ ni̱ka̱ jagu̱u̱ aꞌkhánlóꞌ ná inuu ixe̱ krúsi̱, kajngó náxájuwalóꞌ rí mu̱ꞌne̱lóꞌ aꞌkhán, rí ma̱juwalóꞌ rí mu̱ꞌne̱lóꞌ rí máján. Krísto̱ ni̱gu̱ma-jámbi̱yíi̱ꞌ kajngó ikháanꞌlaꞌ ma̱ꞌni̱i a̱kia̱nꞌlaꞌ. <verse eid="1PE 2:24" /><verse number="25" style="v" sid="1PE 2:25" />Numuu rí ikháanꞌlaꞌ ninindxa̱ꞌlaꞌ xómá xu̱kú mogo̱ tsí ni̱ngra̱ꞌiin jamba̱a̱. Xómáꞌ xúge̱ꞌ rá, niguwa̱aꞌlaꞌ inuu tsí na̱ña̱wa̱nꞌlaꞌ, ikhaa máꞌ tsí nayaxe̱-ra̱ꞌmúu mbiꞌyalaꞌ.<verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="s">Rí jaꞌyoo mune̱ xa̱bo̱ tsí nida-mijná</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1" />Xúꞌkhue̱n máꞌ ikháanꞌlaꞌ nána̱, tsáanꞌ ni̱nújúnlaꞌ, gu̱ni̱ꞌñá-mijnálaꞌ rí muthan-ñajwanlaꞌ a̱jmbiaꞌlaꞌ. Kajngó xí xtaa mbáa xa̱biya̱ tsí tsínimbo̱o̱ꞌ jaꞌyoo ajngóo Ana̱ꞌlóꞌ, ma̱nimbo̱o̱ꞌ ga̱jma̱á majñu̱u̱ xómá naꞌne a̱ꞌguii̱, maske máꞌ a̱ꞌguii̱ ma̱xáꞌthán nimbá ajngáa, <verse eid="1PE 3:1" /><verse number="2" style="v" sid="1PE 3:2" />numuu mba̱ꞌyoo̱ rí mitsaan xtáa a̱ꞌguii̱ jamí gamakuii̱. <verse eid="1PE 3:2" /><verse number="3" style="v" sid="1PE 3:3" />Ma̱xáxná-gamiéjwanlaꞌ rí mu̱ne̱-ratha-mijnálaꞌ guéño ga̱jma̱á xtíin rí phú numuu, ni máꞌ xábí ajwa̱nꞌ mo̱jmo̱ꞌ, ni máꞌ rí mu̱ne̱-ratháálaꞌ guéño xó rí nu̱xtígúu idxa̱ꞌlaꞌ. <verse eid="1PE 3:3" /><verse number="4" style="v" sid="1PE 3:4" />I̱wa̱á máján rí ga̱ri̱gá rí mitsaan ná awúun a̱kia̱nꞌlaꞌ, rí ma̱xámangua̱ꞌlaꞌ jamí rí ma̱ꞌne gamakuáanꞌlaꞌ. Rúꞌkhue̱n rí phú i̱tha̱án gíꞌdoo numuu ná inuu Ana̱ꞌlóꞌ. <verse eid="1PE 3:4" /><verse number="5" style="v" sid="1PE 3:5" />Numuu rí xkuaꞌnii máꞌ nene̱-karatha-mijná go̱ꞌo̱ tsí ninindxu̱ún xa̱bi̱i Ana̱ꞌlóꞌ wajyúú mbiꞌi mangaa. Ni̱we̱je̱ a̱kuíi̱n ná inuu Ana̱ꞌlóꞌ, ikhaa jngó ni̱ni̱ꞌñá-mijnée̱ rí mi̱ꞌthán-ñájúu̱n gúne̱ a̱jmbíi̱n. <verse eid="1PE 3:5" /><verse number="6" style="v" sid="1PE 3:6" />Xkuaꞌnii neꞌne Sára̱, neꞌne-mbánuu̱ rí niꞌthán Abraám, jamí asndo niꞌthúu̱n «táta̱». Ikháanꞌlaꞌ nanindxa̱ꞌlaꞌ i̱ji̱in Sára̱, xí nu̱ne̱laꞌ rí máján jamí tsímíñuu a̱kia̱nꞌlaꞌ eꞌne nimbá.<verse eid="1PE 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7" />Xúꞌkhue̱n máꞌ mangáanꞌlaꞌ táta̱, tsáanꞌ ni̱ni̱ꞌgúúnlaꞌ, ga̱ma̱ñalaꞌ rí ma̱juwalaꞌ gajmiálaꞌ gu̱ꞌwia̱ꞌlaꞌ. Gu̱ya̱-makúu̱nlaꞌ xómá rí jaꞌyoo. Ga̱fraꞌa̱ꞌlaꞌ rí na̱nguá gúkúu̱n xómá ikháanꞌlaꞌ jamí rí Ana̱ꞌlóꞌ nixuda-mina̱ꞌ ga̱jma̱á nindxúu̱n mangii̱n, rí ma̱ju̱wée̱ꞌ jámuu xómá rí ikháanꞌlaꞌ. Xkuaꞌnii gúne̱laꞌ kajngó nda̱a̱ rí gáwe̱je̱-ꞌthu̱u̱n rí mu̱tha̱n-jáñíílaꞌ Ana̱ꞌlóꞌ.<verse eid="1PE 3:7" /></para>
  <para style="s">Xáne gíꞌmaa rí ma̱ju̱wá xa̱bi̱i Ana̱ꞌlóꞌ ná numbaa</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />Rí nda̱wa̱á jayu rá, mbá xúgiáanꞌlaꞌ gu̱ru̱wa̱a ju̱ma̱ꞌlaꞌ. Gu̱mbáñúúlaꞌ tsí guáꞌdáá gajmá. Ga̱galaꞌ ju̱ya̱-mijnálaꞌ xómá nandúún juya-mijná mbá guꞌwíin xa̱bo̱. Ga̱ñáwíin a̱kia̱nꞌlaꞌ ju̱ya̱-mijnálaꞌ jamí gu̱xrígú-mijnálaꞌ. <verse eid="1PE 3:8" /><verse number="9" style="v" sid="1PE 3:9" />Mu̱xúrthanga̱alaꞌ rí xkawe̱ꞌ ná inuu xa̱bo̱ tsí naꞌñalaꞌ rí xkawe̱ꞌ, ni máꞌ ma̱xáthangáanꞌlaꞌ rí mu̱tha̱n-xkawi̱íꞌlaꞌ xa̱bo̱ tsí naꞌthán-xkawia̱ꞌlaꞌ. A̱ꞌkhue̱n gakon, gu̱nda̱ꞌa̱álaꞌ Ana̱ꞌlóꞌ rí ma̱ꞌne-tsakun-rámii xa̱bo̱, numuu rí ikhaa máꞌ numuu rúꞌkhue̱n nindxaꞌwálaꞌ Ana̱ꞌlóꞌ, kajngó ma̱gu̱ma-tsakun-rámáaꞌlaꞌ. <verse eid="1PE 3:9" /><verse number="10" style="v" sid="1PE 3:10" />Numuu rí xáꞌnii ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="b" vid="1PE 3:10" />
  <para style="q" vid="1PE 3:10">«Tsí nandoo mba̱ꞌyoo mbiꞌi rí máján jamí ma̱xtáa̱ tsímáá,</para>
  <para style="q" vid="1PE 3:10">ga̱ña̱wu̱u̱n rawuu̱n rí ma̱xáꞌthée̱n ajngáa xkawe̱ꞌ jamí ma̱xáꞌne-nduwee̱.<verse eid="1PE 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="1PE 3:11" />Ganiñuu̱-raꞌnii̱ rí xkawe̱ꞌ, jamí ga̱ꞌnii̱ rí máján.</para>
  <para style="q" vid="1PE 3:11">Gaxná-mine̱e̱ꞌ tsiakhe̱ rí ma̱ju̱wá tsímáá xa̱bo̱ jamí ga̱xtáa̱ tsímáá gajmíi̱ xa̱bo̱.<verse eid="1PE 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="1PE 3:12" />Numuu rí Ana̱ꞌlóꞌ na̱ña̱wúun xa̱bo̱ tsí nune̱ rí máján,</para>
  <para style="q" vid="1PE 3:12">jamí nadxawuu̱n rí nithán-jáñíi̱ ene̱ tsúꞌkhue̱n.</para>
  <para style="q" vid="1PE 3:12">Xómáꞌ tsí nune̱ rí xkawe̱ꞌ rá, Ana̱ꞌlóꞌ na̱we̱je̱-ꞌthúu̱n».<note caller="+" style="f"><char style="fr" closed="false">3.10-12 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 34.12-16.</char></note><verse eid="1PE 3:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13" />Xí ikháanꞌlaꞌ nu̱ne̱laꞌ i̱ndo̱ó máꞌ rí máján, tsáa lá gáꞌñalaꞌ mi̱ndaꞌkho xúꞌkhue̱n rá. <verse eid="1PE 3:13" /><verse number="14" style="v" sid="1PE 3:14" />Jamí xí nu̱míni̱ílaꞌ ga̱jma̱á numuu rí nu̱ne̱laꞌ rí máján rá, phú gagi juwalaꞌ xúꞌkhue̱n rá. Ikhaa jngó ma̱xámíñalaꞌ gúne̱ xa̱bo̱ ni máꞌ ma̱xáxná-gamiéjwanlaꞌ gúni̱i̱. <verse eid="1PE 3:14" /><verse number="15" style="v" sid="1PE 3:15" />A̱ꞌkhue̱n gakon, gu̱ne̱-mba̱a̱laꞌ Táta̱ Jesukrísto̱ ná awúun a̱kia̱nꞌlaꞌ. Ga̱juwalaꞌ xawi jámba̱ miꞌtsú rí mu̱riꞌñáálaꞌ asndo tsáa máꞌ tsí naraxa̱ꞌlaꞌ náá numuu kajngó rí ga̱jma̱á mbá jañii a̱kia̱nꞌlaꞌ guáꞌthi̱ínlaꞌ ná inuu Krísto̱. I̱ndo̱ó máꞌ numuu rí gu̱riꞌñáa̱ꞌlaꞌ ga̱jma̱á gamaku jamí gu̱xrígú-mijnálaꞌ. <verse eid="1PE 3:15" /><verse number="16" style="v" sid="1PE 3:16" />Xkuaꞌnii kajngó mbu̱ya̱á májánlaꞌ rí túne̱laꞌ aꞌkhán jamí ma̱ti̱ñu̱úꞌ tsí nuthan rí xkawe̱ꞌ ga̱jma̱á numuu rí máján nu̱ne̱laꞌ, rí xa̱bi̱i Krísto̱ ñajwanlaꞌ. <verse eid="1PE 3:16" /><verse number="17" style="v" sid="1PE 3:17" />I̱tha̱án máꞌ máján rí mu̱míni̱ílaꞌ ga̱jma̱á numuu rí nu̱ne̱laꞌ rí máján xí numuu rí xkuaꞌnii awuun Ana̱ꞌlóꞌ, xó rí mu̱míni̱ílaꞌ ga̱jma̱á numuu rí nu̱ne̱laꞌ rí xkawe̱ꞌ.<verse eid="1PE 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 3:18" />Numuu rí jmína̱a̱ꞌ máꞌ Krísto̱ nijáñuu mbóó miꞌtsú jamí asndo jámuu ga̱jma̱á numuu aꞌkhánlóꞌ mangaa. Tsí nda̱a̱ aꞌkhúun nijáñuu ga̱jma̱á numúú xa̱bo̱ aꞌkhán, kajngó ma̱ꞌga jaguáa̱nꞌlóꞌ ná inuu Ana̱ꞌlóꞌ. Xuyuu̱ ñajuun rí nijáñuu, xómáꞌ xu̱u̱ꞌ neꞌne rí mbayáa̱ mbiꞌyuu̱. <verse eid="1PE 3:18" /><verse number="19" style="v" sid="1PE 3:19" />Jamí ga̱jma̱á majñu̱u̱ máꞌ xu̱u̱ꞌ ni̱ke̱e̱ gáꞌthán-raꞌee̱ inuu xu̱únꞌ xa̱bo̱ tsí júgua-raꞌiin ná géjwa̱nꞌ. <verse eid="1PE 3:19" /><verse number="20" style="v" sid="1PE 3:20" />Ikhiin máꞌ xa̱bo̱ tsúꞌkhue̱n ñajúún tsí ra̱khúún gánimbu̱únꞌ juyáá Ana̱ꞌlóꞌ nákhí mbiꞌi rí nixtáa Noé. Phú mba̱yo̱ꞌ ni̱gi̱ꞌthu̱u̱n Ana̱ꞌlóꞌ rí ma̱thanga̱a a̱kuíi̱n, awúun mbiꞌi rí Noé xtáa naꞌne-mújúun guꞌwá-rguwa ná nijáwíin i̱ndo̱ó máꞌ mbá migiñuu xa̱bo̱ ga̱jma̱á majñu̱u̱ iya. <verse eid="1PE 3:20" /><verse number="21" style="v" sid="1PE 3:21" />Iya rúꞌkhue̱n naꞌne xtiꞌkhuu iya ná nixúdu-maꞌáanꞌlóꞌ rí xúge̱ꞌ, rí naꞌne-jríñáaꞌlóꞌ ga̱jma̱á numuu rí ndiyáa mbiꞌyuu Jesukrísto̱. Nixúdu-maꞌáanꞌlóꞌ ná awúun iya, ra̱ꞌkhá numuu rí ndaꞌyóo ma̱gata̱a smboo xuyalóꞌ, rí numuu ndaꞌyóo rí ma̱ꞌne-jaꞌwu̱u a̱kia̱nꞌlóꞌ ná inuu Ana̱ꞌlóꞌ. <verse eid="1PE 3:21" /><verse number="22" style="v" sid="1PE 3:22" />Numuu rí Jesukrísto̱ ni̱ka̱a mikhuíí jamí ni̱gi̱ꞌi̱i̱ ná ñawún mújúun Ana̱ꞌlóꞌ. Ikhaa̱ naꞌthán-ñájúu̱n mbá xúgíin ánje̱l, mbá xúgíí inii tsiakhe̱ jamí mbá xúgíí inii gíñá ꞌguéen.<verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />Numuu rí Krísto̱ nimínu̱u̱ꞌ ná xuyuu ga̱jma̱á numalóꞌ.<note caller="+" style="f"><char style="fr" closed="false">4.1 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná tsíꞌkha̱ ajngáa ríge̱ꞌ: «ga̱jma̱á numalóꞌ».</char></note> Ikhaa jngó, ga̱juwa-na̱ma̱ñalaꞌ rí mu̱míni̱í mangáanꞌlaꞌ xómá rí nimínu̱u̱ꞌ Krísto̱. Numuu rí xa̱bo̱ tsí namínu̱u̱ꞌ, niniñuu̱ máꞌ janíí aꞌkhán mangaa. <verse eid="1PE 4:1" /><verse number="2" style="v" sid="1PE 4:2" />Kajngó náxáꞌnii̱ rí nandoo xuyuu̱ awúun mbiꞌi rí xóó xtáa̱ ná tsu̱du̱u̱ numbaa, xómá rí nune̱ jayu xa̱bo̱, rí ma̱ꞌnii̱ i̱ndo̱ó máꞌ rí nandoo Ana̱ꞌlóꞌ. <verse eid="1PE 4:2" /><verse number="3" style="v" sid="1PE 4:3" />Numuu rí mbájndi máꞌ mbiꞌi rí ninújngoo rí ne̱ne̱laꞌ rí nandúún xa̱bo̱ tsí tsíne̱-nuwiin Ana̱ꞌlóꞌ. Ne̱ne̱laꞌ rí xkawe̱ꞌ nu̱ndxa̱ꞌwa̱-mijnálaꞌ, rí xkawe̱ꞌ na̱ni̱gu̱u̱ꞌ xuyalaꞌ. Nijngáanꞌlaꞌ, ninújngo-rámuu ne̱ne̱laꞌ rí nandoo xuyalaꞌ, ninújngo-rámuu nijngáanꞌlaꞌ ná ndxa̱a̱, jamí ne̱ne̱-mbi̱inlaꞌ tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún. <verse eid="1PE 4:3" /><verse number="4" style="v" sid="1PE 4:4" />Ikhaa jngó, namakúún xa̱bo̱ tsí tsíne̱-nuwiin Ana̱ꞌlóꞌ e̱ne̱laꞌ rí xúge̱ꞌ, numuu rí nánguá máꞌ e̱ne̱laꞌ rí xkawe̱ꞌ xómá rí nuni̱i̱ ikhii̱n, jamí nuthan-xkawia̱ꞌlaꞌ. <verse eid="1PE 4:4" /><verse number="5" style="v" sid="1PE 4:5" />Xómáꞌ ikhii̱n mu̱riꞌñee̱ ga̱jma̱á numuu rí nini̱i̱ ná inuu tsí xtáa na̱ma̱ñuu rí ma̱ꞌne-mbánuu numúú xa̱bo̱ tsí nduya jamí tsí nijáñúú máꞌ. <verse eid="1PE 4:5" /><verse number="6" style="v" sid="1PE 4:6" />Numuu rí ikhaa máꞌ numuu rúꞌkhue̱n waꞌthán-rúꞌúún ajngáa máján xa̱bo̱ tsí nijáñúú máꞌ xúge̱ꞌ, kajngó mbuyee̱ ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ, maske máꞌ xa̱bo̱ ná numbaa ríge̱ꞌ ni̱ra̱jwe̱e̱ꞌ rí gíꞌmii̱ aꞌkhán.<verse eid="1PE 4:6" /></para>
  <para style="s">Ga̱jmalaꞌ rí nixnálaꞌ Ana̱ꞌlóꞌ rí mu̱ne̱-mba̱ꞌwu̱unlaꞌ xa̱bo̱</para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7" />Inu máꞌ ma̱ga̱nú mbiꞌi rí ma̱mbá mbá xúgíí rí ríga̱ ná inuu numbaa. Ikhaa jngó, gu̱ndxa̱ꞌwa̱-mijná májánlaꞌ rí mu̱ne̱laꞌ, kajngó mu̱xúni̱ꞌñáálaꞌ rí nu̱tha̱n-jáñíílaꞌ Ana̱ꞌlóꞌ. <verse eid="1PE 4:7" /><verse number="8" style="v" sid="1PE 4:8" />Phú i̱tha̱án máꞌ gíꞌdoo numuu rí ma̱galaꞌ ju̱ya̱-mijnálaꞌ. Numuu rí phú mbaꞌa aꞌkhán najúgoo xí nandalóꞌ juꞌya-mijnálóꞌ. <verse eid="1PE 4:8" /><verse number="9" style="v" sid="1PE 4:9" />Gagi a̱kia̱nꞌlaꞌ gúdrígú-mijnálaꞌ ná guꞌwálaꞌ. <verse eid="1PE 4:9" /><verse number="10" style="v" sid="1PE 4:10" />Mbámbáa gáꞌne-mba̱ꞌwu̱un i̱ꞌwíin xa̱bo̱ ga̱jma̱á majñu̱u̱ rí nijanáá neꞌne Ana̱ꞌlóꞌ. Xkuaꞌnii kajngó ma̱nindxa̱ꞌlaꞌ xa̱bo̱ tsí najmúú mújúún jamí nu̱ña̱wa̱án mbaꞌa inii rí naxná Ana̱ꞌlóꞌ. <verse eid="1PE 4:10" /><verse number="11" style="v" sid="1PE 4:11" />Xí mbáa nijanáá rí maꞌthán, gaꞌthée̱n xómá rí nijanáa̱ maꞌthée̱n neꞌne Ana̱ꞌlóꞌ. Xí mbáa naꞌne-mba̱ꞌwu̱un xa̱bo̱, ga̱ꞌne-mba̱ꞌwii̱n ga̱jma̱á tsiakhe̱ rí naxná Ana̱ꞌlóꞌ, kajngó mbá xúgíí rí na̱gu̱ma ma̱ꞌne-mba̱a̱ Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ Jesukrísto̱. Ikhaa̱ jaꞌyoo rí ma̱gu̱ma-mba̱a̱ jamí maꞌthán-ñájwii̱n jámuu mbiꞌi. Xkuaꞌnii gáꞌne.<verse eid="1PE 4:11" /></para>
  <para style="s">Ga̱ꞌdxu a̱kia̱nꞌlaꞌ numuu rí nu̱míni̱ílaꞌ ga̱jma̱á nindxu̱u̱ Krísto̱</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />A̱ngui̱nꞌ, ma̱xámakualaꞌ gáꞌne gaꞌkho̱ rí na̱ꞌkha̱ inalaꞌ kajngó ma̱kujma xí ma̱ꞌnga̱ꞌlaꞌ, numuu rí ra̱ꞌkhá máꞌ i̱ndo̱ó ikháanꞌlaꞌ nu̱gíꞌníílaꞌ rúꞌkhue̱n. <verse eid="1PE 4:12" /><verse number="13" style="v" sid="1PE 4:13" />A̱ꞌkhue̱n gakon, ga̱ꞌdxu a̱kia̱nꞌlaꞌ numuu rí nu̱míni̱ílaꞌ ga̱jma̱á nindxu̱u̱ Krísto̱, kajngó phú ma̱ꞌdxu a̱kia̱nꞌlaꞌ mangáanꞌlaꞌ ído̱ rí ma̱ꞌkhaa̱ ga̱jma̱á mbá xúgíí ski̱yu̱u̱ꞌ ná numbaa. <verse eid="1PE 4:13" /><verse number="14" style="v" sid="1PE 4:14" />Phú gagi juwalaꞌ xí nuthan-xkawia̱ꞌlaꞌ xa̱bo̱ ga̱jma̱á numuu Krísto̱, numuu rí Xu̱u̱ꞌ Ana̱ꞌlóꞌ tsí phú wáá xtáa̱ ná awúun a̱kia̱nꞌlaꞌ. Gakon máꞌ rí ikhii̱n nuthan-xkawíi̱ꞌ Ana̱ꞌlóꞌ, xómáꞌ ikháanꞌlaꞌ ndu̱ya̱-makuíi̱laꞌ.<note caller="+" style="f"><char style="fr" closed="false">4.14 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «Gakon máꞌ rí ikhii̱n nuthan-xkawíi̱ꞌ Ana̱ꞌlóꞌ, xómáꞌ ikháanꞌlaꞌ ndu̱ya̱makuíi̱laꞌ».</char></note> <verse eid="1PE 4:14" /><verse number="15" style="v" sid="1PE 4:15" />Ikhaa jngó, nimbáa tsí ikháanꞌlaꞌ ra̱jáꞌyoo rí mamínu̱u̱ꞌ ga̱jma̱á numuu rí nixíya̱a̱ xa̱bo̱, o neꞌne-kúwa̱ꞌ, o naꞌne rí ra̱máján, o numuu rí naxúda-mina̱ꞌ ná na̱nguá jaꞌyoo mbo̱ꞌ. <verse eid="1PE 4:15" /><verse number="16" style="v" sid="1PE 4:16" />I̱ndo̱ó máꞌ numuu rí, xí mbáa namínu̱u̱ꞌ ga̱jma̱á numuu rí ninindxu̱u̱ꞌ tsí na̱ka̱ tsu̱du̱u̱ Krísto̱ rá, ma̱xáti̱yu̱u̱ꞌ, rí ga̱ꞌne-mba̱a̱ Ana̱ꞌlóꞌ numuu rí jayée̱ mbiꞌyuu Krísto̱. <verse eid="1PE 4:16" /><verse number="17" style="v" sid="1PE 4:17" />Numuu rí ni̱ga̱nú máꞌ mbiꞌi rí magíꞌdu̱u̱n ma̱ra̱jwa̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á numúú tsí ñajúún xa̱bii̱. Jamí xí xkuaꞌnii nagíꞌdu̱u̱n na̱ra̱jwe̱e̱ꞌ ga̱jma̱á numalóꞌ ikháánꞌlóꞌ ginii jayu, dí lá gágíꞌníí xa̱bo̱ tsí tsíñúú gánimbu̱únꞌ ajngáa máján drígo̱o̱ Ana̱ꞌlóꞌ rá. <verse eid="1PE 4:17" /><verse number="18" style="v" sid="1PE 4:18" />Xúꞌkhue̱n máꞌ mangaa,</para>
  <para style="q" vid="1PE 4:18">«Xí ga̱jma̱á kháan najríya̱a̱ꞌ xa̱bo̱ tsí naꞌne rí máján,</para>
  <para style="q" vid="1PE 4:18">dí lá gágíꞌnuu xa̱bo̱ tsí na̱nguá eꞌne-mba̱a̱ Ana̱ꞌlóꞌ jamí xa̱bo̱ aꞌkhán rá».<verse eid="1PE 4:18" /></para>
  <para style="b" />
  <para style="m">
    <verse number="19" style="v" sid="1PE 4:19" />Ikhaa jngó, tsí nu̱míni̱í ga̱jma̱á numuu rí xkuaꞌnii nandoo Ana̱ꞌlóꞌ, guni̱i̱ rí máján, jamí gu̱ni̱ꞌñá-mijnée̱ ná ñawúun Ana̱ꞌlóꞌ tsí neꞌne-ku̱mii̱, numuu rí ikhaa̱ phú jmbii̱.<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="s">Rí nithúún xa̱bo̱ buanuu tsí juya̱ idxu̱u̱</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />Nandoꞌ rí ma̱thu̱ún mbá ajngáa xa̱bo̱ buanuu tsí juya̱ ikhalaꞌ, tsí júwa̱ꞌ ga̱jma̱á nindxa̱ꞌlaꞌ. Numuu rí ikhúúnꞌ máꞌ mangúúnꞌ ñajunꞌ xa̱bo̱ nikhi̱i̱ tsí jayá ikha xómá ikhii̱n, jamí ndi̱yo̱o̱lo̱ꞌ xáne nimínu̱u̱ꞌ Krísto̱. Jamí mangúúnꞌ máꞌ ma̱nindxu̱ꞌ xómá jaꞌnii̱ ikhaa̱ ído̱ rí ma̱ꞌkhaa̱ ná numbaa. Xáꞌnii i̱thu̱únlo̱ꞌ xa̱bo̱ buanuu tsúꞌkhue̱n: <verse eid="1PE 5:1" /><verse number="2" style="v" sid="1PE 5:2" />Gu̱ña̱wu̱únlaꞌ xa̱bi̱i Ana̱ꞌlóꞌ tsí júwa̱ꞌ ná ñawánlaꞌ, xómá ene̱ xa̱bo̱ tsí nu̱ña̱wu̱ún xu̱kú mogo̱. Gu̱ña̱wúu̱n májánlaꞌ ga̱jma̱á mbá jañii a̱kia̱nꞌlaꞌ,<note caller="+" style="f"><char style="fr" closed="false">5.2 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán xáꞌnii: «Gu̱ña̱wúu̱n májánlaꞌ ga̱jma̱á mbá jañii a̱kia̱nꞌlaꞌ, xómá rí nandoo Ana̱ꞌlóꞌ».</char></note> ra̱ꞌkhá ga̱jma̱á tsiakhe̱, ni máꞌ ra̱ꞌkhá ga̱jma̱á numuu rí nandalaꞌ mu̱da̱a̱ꞌ mbúkha̱a̱, rí ga̱jma̱á numuu rí nandalaꞌ mu̱ne̱-mba̱ꞌwi̱inlaꞌ xa̱bi̱i Ana̱ꞌlóꞌ. <verse eid="1PE 5:2" /><verse number="3" style="v" sid="1PE 5:3" />Mu̱xúñu̱úlaꞌ mi̱ndaꞌkho tsí nijaniálaꞌ rí mu̱ña̱wu̱únlaꞌ asndo xó rí ikháanꞌlaꞌ ñajwanlaꞌ ña̱ꞌñíi̱, rí ga̱nindxa̱ꞌlaꞌ mbá xkri̱da mbuyáa̱. <verse eid="1PE 5:3" /><verse number="4" style="v" sid="1PE 5:4" />Xkuaꞌnii kajngó ído̱ rí ma̱ꞌkha̱a Krísto̱, xa̱bo̱ tsí phú ginii na̱ña̱wa̱nꞌlóꞌ, mu̱drígúulaꞌ gamaku rí phú tsímáá, rí jámuu ríga̱.<verse eid="1PE 5:4" /></para>
  <para style="s">Rí nithúún mbá xúgíin tsí nanimbu̱únꞌ juyáá Jesús</para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5" />Xúꞌkhue̱n máꞌ ikháanꞌlaꞌ, xa̱bo̱ tikhu, gu̱ne̱-mbáníílaꞌ rí nuthan xa̱bo̱ buanuu. Mbá xúgiáanꞌlaꞌ gu̱xrígú-mijnálaꞌ jamí gu̱ni̱ꞌñá-mijnálaꞌ rí mu̱xna̱-ñájun-mijnálaꞌ, numuu rí:</para>
  <para style="b" vid="1PE 5:5" />
  <para style="q" vid="1PE 5:5">«Ana̱ꞌlóꞌ na̱we̱je̱-ꞌthúu̱n xa̱bo̱ tsí nu̱xu̱xí-mijná,</para>
  <para style="q" vid="1PE 5:5">xómáꞌ tsí nu̱xrígú-mijná rá, nambáñúu̱ ga̱jma̱á rí máján».<verse eid="1PE 5:5" /></para>
  <para style="b" />
  <para style="m">
    <verse number="6" style="v" sid="1PE 5:6" />Ikhaa jngó, gu̱xrígú-mijnálaꞌ ná inuu Ana̱ꞌlóꞌ tsí gíꞌdoo mbá xúgíí tsiakhe̱, kajngó ikhaa̱ ma̱ꞌnii̱ rí phú ma̱gi̱ꞌdoo numalaꞌ ído̱ gága̱nú mbiꞌi. <verse eid="1PE 5:6" /><verse number="7" style="v" sid="1PE 5:7" />Gu̱ni̱ꞌñáálaꞌ mbá xúgíí gajmá rí guáꞌdáálaꞌ ná ñawúun Ana̱ꞌlóꞌ, numuu rí ikhaa̱ na̱ña̱wa̱nꞌlaꞌ.<verse eid="1PE 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8" />Gu̱ndxa̱ꞌwa̱-mijná májánlaꞌ rí mu̱ne̱laꞌ, jamí ga̱juwalaꞌ xawi. Numuu rí gixa̱a̱ tsí gíꞌdáanꞌlaꞌ sia̱nꞌ, ngrigo̱o̱ꞌ-randxaꞌwée̱ xómá i̱ndi̱í phuu tsí ndaꞌyáa tsí mi̱khu̱u̱. <verse eid="1PE 5:8" /><verse number="9" style="v" sid="1PE 5:9" />Ga̱wajún-ꞌthi̱ínlaꞌ gixa̱a̱ ga̱jma̱á majñu̱u̱ rí wéje̱-gúkúu a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ, numuu rí ndu̱ya̱álaꞌ máꞌ rí mbá xúgíí inuu numbaa júwa̱ꞌ a̱ngia̱nꞌlaꞌ tsí nu̱míni̱í xómá rí nu̱míni̱í ikháanꞌlaꞌ.<verse eid="1PE 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 5:10" />Jamí ído̱ rí wámba̱ máꞌ ni̱míni̱ílaꞌ mbá wátha̱ wáa mbiꞌi, a̱ꞌkhue̱n rí jmína̱a̱ꞌ máꞌ Ana̱ꞌlóꞌ tsí nindxaꞌwálaꞌ rí ma̱nindxa̱ꞌlaꞌ xómá jaꞌnii̱ ikhaa̱ ga̱jma̱á majñu̱u̱ Jesukrísto̱,<note caller="+" style="f"><char style="fr" closed="false">5.10 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «Krísto̱».</char></note> ma̱ꞌnii̱ rí ma̱ꞌne káxáanꞌlaꞌ, ma̱wajún-gúkuálaꞌ, ma̱ꞌne gúkuáanꞌlaꞌ, jamí rí ma̱ꞌne jañii a̱kia̱nꞌlaꞌ ju̱yáa̱. <verse eid="1PE 5:10" /><verse number="11" style="v" sid="1PE 5:11" />A̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ jamí gaꞌthán-ñájwii̱n i̱ndo̱ó máꞌ ikhaa̱ jámuu mbiꞌi. Xkuaꞌnii gáꞌne.<verse eid="1PE 5:11" /></para>
  <para style="s">Naꞌthángoo Pédro̱</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />Ga̱jma̱á majñu̱u̱ Silbáno̱, dxájwalóꞌ tsí nda̱yo̱o̱ rí phú jmbii, ni̱tháán mbá lájwíin i̱yi̱i̱ꞌ ríge̱ꞌ ma̱ꞌga inalaꞌ. Ga̱jma̱á majñu̱u̱ i̱yi̱i̱ꞌ ríge̱ꞌ na̱xna̱ꞌlaꞌ tsiakhe̱ jamí na̱tha̱nꞌlaꞌ rí phú na̱ni̱gu̱u̱ꞌ Ana̱ꞌlóꞌ e̱ne̱laꞌ. Ga̱wajún-gúkuálaꞌ ga̱jma̱á numuu rúꞌkhue̱n.<verse eid="1PE 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13" />Nu̱ra̱xáa̱nꞌlaꞌ tsí nanimbu̱únꞌ juyáá Jesús ná xuajen Babilónia̱. Ikhii̱n mangii̱n watraꞌwíi̱n xómá rí ikháanꞌlaꞌ. Xúꞌkhue̱n máꞌ naraxáanꞌlaꞌ a̱ꞌdéꞌ Márko̱s. <verse eid="1PE 5:13" /><verse number="14" style="v" sid="1PE 5:14" />Gu̱ra̱xi̱-mijnáalaꞌ ga̱jma̱á gamaku xómá rí nune̱ xa̱bo̱ tsí nandúún juya-mijná.</para>
  <para style="p" vid="1PE 5:14">Ga̱juwalaꞌ tsímáá mbá xúgiáanꞌ ikháanꞌlaꞌ, tsáanꞌ ñajwanlaꞌ xa̱bi̱i Jesukrísto̱.<note caller="+" style="f"><char style="fr" closed="false">5.14 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «Krísto̱».</char></note> Xkuaꞌnii gáꞌne.<note caller="+" style="f"><char style="fr" closed="false">5.14 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa «Xkuaꞌnii gáꞌne».</char></note><verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>