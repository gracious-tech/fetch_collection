<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">tcfU (59-Heb) - Me̱ꞌpha̱a̱ Mañúwi̱ín (Malinaltepec) sfm-NIV, c13/v303</book>
  <para style="h">Xa̱bo̱ ebréo̱</para>
  <para style="toc3">Hb</para>
  <para style="toc2">Xa̱bo̱ ebréo̱</para>
  <para style="toc1">I̱yi̱i̱ꞌ rí ni̱ka̱ inúú xa̱bo̱ ebréo̱</para>
  <para style="mt2">I̱yi̱i̱ꞌ rí ni̱ka̱ inúú</para>
  <para style="mt1">Xa̱bo̱ ebréo̱</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s">Ana̱ꞌlóꞌ naꞌthán-máꞌánlóꞌ ga̱jma̱á majñu̱u̱ A̱dée̱</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />Maphú mbaꞌa miꞌtsú jamí mbaꞌa inii xáne rí Ana̱ꞌlóꞌ niꞌthán-múꞌúún táta̱-xi̱ꞌñálóꞌ wajyúú mbiꞌi ga̱jma̱á majñu̱ú tsí ni̱rawíjnga̱a ajngóo̱. <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />Xómáꞌ xúge̱ꞌ rá, rí inu máꞌ na̱ka̱-rayámba̱ numbaa, naꞌthán-máꞌánlóꞌ Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ A̱dée̱, tsí niꞌgíi̱ rí magu̱u mbá xúgíí rí ríga̱, jamí ga̱jma̱á majñu̱u̱ máꞌ ikhaa̱ neꞌne-ku̱maa̱ numbaa. <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />Ikhaa̱ nasngájmee̱ rí phú wáá rí ñajuun Ana̱ꞌlóꞌ, jamí xómá jaꞌnii jayu Ana̱ꞌlóꞌ xkuaꞌnii máꞌ jaꞌnii A̱dée̱ mangaa. Ikhaa̱ máꞌ naxnúu̱ rí ndaꞌyóo mbá xúgíí rí ríga̱ ná numbaa ga̱jma̱á ski̱yu̱u̱ꞌ ajngóo̱. Nákhí wámbo̱o̱ neꞌne-jaꞌwáa̱nꞌlóꞌ ga̱jma̱á iꞌdiuu̱, ni̱kaa̱ mikhuíí gági̱ꞌi̱i̱ ná ñawún mújúun Ana̱ꞌlóꞌ. <verse eid="HEB 1:3" /><verse number="4" style="v" sid="HEB 1:4" />Ikhaa jngó, i̱tha̱án máꞌ mba̱a̱ A̱dée Ana̱ꞌlóꞌ inúú ánje̱l, numuu rí ikhaa̱ nijanáa̱ rí ma̱nindxu̱u̱ tsí phú i̱tha̱án gíꞌdoo numuu xó rí mbá xúgíi̱n ikhii̱n.<verse eid="HEB 1:4" /></para>
  <para style="s">I̱tha̱án máꞌ mba̱a̱ A̱dée Ana̱ꞌlóꞌ inúú ánje̱l</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 1:5" />Numuu rí Ana̱ꞌlóꞌ nimbá miꞌtsú táꞌthúun nimbáa ánje̱l:</para>
  <para style="b" vid="HEB 1:5" />
  <para style="q" vid="HEB 1:5">«Ikháánꞌ ñajwaanꞌ A̱ꞌdéꞌ.</para>
  <para style="q" vid="HEB 1:5">Ikhúúnꞌ nanindxu̱ꞌ Ana̱a̱ꞌ asndo nákhí mbiꞌi ríge̱ꞌ».<note caller="+" style="f"><char style="fr" closed="false">1.5 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 2.7.</char></note></para>
  <para style="b" vid="HEB 1:5" />
  <para style="m" vid="HEB 1:5">Ni máꞌ táꞌthée̱n ga̱jma̱á numuu nimbáa ánje̱l ríge̱ꞌ:</para>
  <para style="b" vid="HEB 1:5" />
  <para style="q" vid="HEB 1:5">«Ikhúúnꞌ ma̱nindxu̱ꞌ Anu̱u̱,</para>
  <para style="q" vid="HEB 1:5">jamí ikhaa̱ ma̱nindxu̱u̱ A̱ꞌdéꞌ».<note caller="+" style="f"><char style="fr" closed="false">1.5 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná Riajma̱ i̱yu̱u̱ꞌ Samuél 7.14.</char></note><verse eid="HEB 1:5" /></para>
  <para style="b" />
  <para style="m">
    <verse number="6" style="v" sid="HEB 1:6" />Jamí i̱mba̱ miꞌtsú niꞌthán Ana̱ꞌlóꞌ, nákhí rí nixúngua̱a̱ꞌ A̱dée̱ tsí ginii ná inuu numbaa:</para>
  <para style="b" vid="HEB 1:6" />
  <para style="q" vid="HEB 1:6">«Gune̱-mba̱a̱ mbá xúgíin ánje̱l drígo̱o̱ Ana̱ꞌlóꞌ».<note caller="+" style="f"><char style="fr" closed="false">1.6 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yi̱i̱ꞌ rí naꞌthán ikhaa máꞌ xtángoo 32.43, jamí ná I̱yu̱u̱ꞌ ajmúú 97.7. </char></note><verse eid="HEB 1:6" /></para>
  <para style="b" />
  <para style="m">
    <verse number="7" style="v" sid="HEB 1:7" />Xáꞌnii iꞌthán Ana̱ꞌlóꞌ ga̱jma̱á numúú tsí ánje̱l:</para>
  <para style="b" vid="HEB 1:7" />
  <para style="q" vid="HEB 1:7">«Ikhaa̱ naꞌnii̱ rí ánje̱l drígo̱o̱ ma̱nindxu̱ún gíñá,</para>
  <para style="q" vid="HEB 1:7">naꞌnii̱ rí tsí nune̱ ñajuu̱n ma̱nindxu̱ún ri̱ꞌyu̱u̱ agu».<note caller="+" style="f"><char style="fr" closed="false">1.7 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 104.4.</char></note><verse eid="HEB 1:7" /></para>
  <para style="b" />
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />Xómáꞌ tsí A̱dée̱ xáꞌnii iꞌthúu̱n:</para>
  <para style="b" vid="HEB 1:8" />
  <para style="q" vid="HEB 1:8">«Táta̱ Mikhuíí, jámuu xtaꞌún narathán-ñájun,</para>
  <para style="q" vid="HEB 1:8">jámuu nataxúꞌdaa májáanꞌ awan ga̱jma̱á nixí rí gída̱ꞌ ná ñawáanꞌ.<verse eid="HEB 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HEB 1:9" />Na̱ni̱gua̱a̱ꞌ eꞌne rí máján jamí tsíni̱gua̱a̱ꞌ eꞌne rí xkawe̱ꞌ,</para>
  <para style="q" vid="HEB 1:9">Ikhaa jngó Ana̱ꞌlóꞌ, tsí ñajuun máꞌ Ana̱a̱ꞌ ikháánꞌ, niraꞌwíi̱n rí ma̱nindxa̱a̱ꞌ Thúngaa,</para>
  <para style="q" vid="HEB 1:9">jamí niꞌnii̱ rí ma̱ra̱xtaa i̱tha̱án gagi ikháánꞌ xó rí a̱ngia̱anꞌ».<note caller="+" style="f"><char style="fr" closed="false">1.9 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 45.6-7.</char></note><verse eid="HEB 1:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10" />Jamí xáꞌnii ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ mangaa:</para>
  <para style="b" vid="HEB 1:10" />
  <para style="q" vid="HEB 1:10">«Táta̱, nákhí rí ginii, ikháánꞌ nithane̱-ku̱maa ju̱ba̱ꞌ,</para>
  <para style="q" vid="HEB 1:10">jamí ñawáanꞌ neꞌne-ku̱maa mbá xúgíí mikhu.<verse eid="HEB 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HEB 1:11" />Mbá xúgíí rúꞌkhue̱n ma̱mbáa, xómáꞌ ikháánꞌ rá, jámuu xtaa.</para>
  <para style="q" vid="HEB 1:11">Mbá xúgíí rúꞌkhue̱n ma̱ꞌne wayuu xómá xtíin.<verse eid="HEB 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HEB 1:12" />Ma̱ta̱smi̱ga̱a ne̱ xómá xtíin,</para>
  <para style="q" vid="HEB 1:12">jamí ma̱xtiꞌkhu̱u ne̱ xómá naxtiꞌkhu̱u xtíin.</para>
  <para style="q" vid="HEB 1:12">Xómáꞌ ikháánꞌ rá, na̱nguá eꞌne wayaaꞌ,</para>
  <para style="q" vid="HEB 1:12">jamí ni miꞌtsú ma̱xámba̱ mbiꞌyaaꞌ».<note caller="+" style="f"><char style="fr" closed="false">1.10-12 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 102.25-27.</char></note><verse eid="HEB 1:12" /></para>
  <para style="b" />
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />Ana̱ꞌlóꞌ nimbá miꞌtsú táꞌthúun nimbáa ánje̱l:</para>
  <para style="b" vid="HEB 1:13" />
  <para style="q" vid="HEB 1:13">«Araꞌún ná ñawún mújúnꞌ ge̱jyoꞌ,</para>
  <para style="q" vid="HEB 1:13">asndo gáskuíji̱in xa̱bo̱ sia̱nꞌ dríga̱a̱ꞌ ná agoo nakhuáaꞌ».<note caller="+" style="f"><char style="fr" closed="false">1.13 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 110.1.</char></note><verse eid="HEB 1:13" /></para>
  <para style="b" />
  <para style="m">
    <verse number="14" style="v" sid="HEB 1:14" />Numuu rí mbá xúgíin ánje̱l ñajúún xe̱ꞌ tsí nune̱ ñajuun Ana̱ꞌlóꞌ, waxúnguii̱nꞌ rí mu̱mbáñúu̱ tsí na̱ka̱-rajáwíin eꞌne Ana̱ꞌlóꞌ.<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s">Phú jaꞌyoo rí ma̱nimba̱ꞌlóꞌ juꞌyáá ajngáa rawuun Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />Ikhaa jngó, ndaꞌyóo rí i̱tha̱án máꞌ mu̱ꞌgíi idxa̱ꞌlóꞌ kajngó mu̱dxawíín májánlóꞌ ajngáa rí ni̱dxawíínlóꞌ máꞌ, ra̱ꞌkhá ma̱ngra̱ꞌáanꞌlóꞌ jamba̱a̱ gáꞌne. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />Ga̱rmáꞌáan a̱kia̱nꞌlóꞌ rí ajngáa rawuun Ana̱ꞌlóꞌ rí nithan ánje̱l nákhí wajyúú phú ni̱gi̱ꞌdoo numuu ne̱, jamí mbá xúgíin tsí tánimbu̱únꞌ jamí túne̱-mbáníí ne̱, ni̱dri̱guíi̱ jamínu̱ꞌ xómá phú jaꞌyoo. <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />Xí xkuaꞌnii, xáne lá gájríñáaꞌlóꞌ ikháánꞌlóꞌ ná inuu jamínu̱ꞌ, xí tsímakualóꞌ juꞌyáá rí phú mba̱a̱ naꞌne-jríñáaꞌlóꞌ Ana̱ꞌlóꞌ rá. Jmína̱a̱ꞌ máꞌ Táta̱ niꞌthán-ráꞌa ginii ga̱jma̱á numuu ríge̱ꞌ, jamí xkuaꞌnii máꞌ nithanlóꞌ nda̱wa̱á tsí ni̱dxawíín ne̱. <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />Mangaa máꞌ Ana̱ꞌlóꞌ niꞌthán ga̱jma̱á nindxúu̱n ikhii̱n rí gakon rúꞌkhue̱n, ikhaa jngó niꞌnii̱ mbaꞌa inii rí ndiyáá jamí nimakúún xa̱bo̱ eꞌne, jamí mangaa máꞌ mbaꞌa inii rí phú wáá ndiyáa̱. Xúꞌkhue̱n máꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ nixnúu̱ mbámbáa xa̱bo̱ ñajun rí ma̱ꞌne kajngó ma̱ꞌne-mba̱a̱ Ana̱ꞌlóꞌ, xómá rí neꞌne a̱kui̱in Xu̱u̱ꞌ Ana̱ꞌlóꞌ.<verse eid="HEB 2:4" /></para>
  <para style="s">Jesús ninindxu̱u̱ xómá jaꞌñúú xa̱bo̱ numbaa</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />Numuu rí Ana̱ꞌlóꞌ táskuíjii̱n ánje̱l muthan-ñajwíín numbaa rí ma̱ꞌkha̱, rí nuꞌthánlóꞌ numuu. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />Xómá ka̱ma niꞌthán mbáa xa̱bo̱ ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="b" vid="HEB 2:6" />
  <para style="q" vid="HEB 2:6">«Dí lá ñajuun guéño xa̱bo̱ numbaa kajngó phú gíwa̱a̱nꞌ a̱kia̱anꞌ eꞌne rá.</para>
  <para style="q" vid="HEB 2:6">Jamí dí lá ñajuun a̱dée xa̱bo̱ numbaa kajngó phú naxná-gamiéjwaanꞌ eꞌne rá.<verse eid="HEB 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HEB 2:7" />Nithane̱ rí wáa lájwíi̱n gáꞌne ná inúú ánje̱l,</para>
  <para style="q" vid="HEB 2:7">nithane̱ rí ma̱gi̱ꞌdoo guéño numuu̱ jamí rí mi̱tiamakuíi̱.</para>
  <para style="q" vid="HEB 2:7">Nitatsíñáa̱ rí maꞌthán-ñájuu̱n mbá xúgíí rí neꞌne-ku̱maa ñawáanꞌ.<verse eid="HEB 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HEB 2:8" />Mbá xúgíí nithaꞌgí inuu̱ rí maꞌthán-ñájuu̱n».<note caller="+" style="f"><char style="fr" closed="false">2.6-8 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 8.4-6.</char></note></para>
  <para style="b" vid="HEB 2:8" />
  <para style="m" vid="HEB 2:8">Xí «mbá xúgíí» nixúꞌdaa Ana̱ꞌlóꞌ ñawúu̱n rí maꞌthán-ñájuu̱n, rúꞌkhue̱n iꞌthán rí mbá xúgíí máꞌ iꞌthán-ñájuu̱n. Xómáꞌ xúge̱ꞌ, na̱nguá ikujma xóó xí ikhaa̱ iꞌthán-ñájuu̱n mbá xúgíí. <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />I̱ndo̱ó máꞌ nduꞌyáálóꞌ rí Jesús, tsí wáa lájwíin neꞌne ná inúú ánje̱l mbá wátha̱ wáa mbiꞌi, phú na̱gu̱ma-mba̱a̱ jamí nitiamakuíi̱ numuu rí phú nimínu̱u̱ꞌ jamí nijáñuu̱. Ana̱ꞌlóꞌ phú nandoo jaꞌñúú xa̱bo̱ kajngó niꞌnii̱ rí Jesús ma̱ja̱ñúu ga̱jma̱á numúu̱ mbá xúgíi̱n.<verse eid="HEB 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 2:10" />Ana̱ꞌlóꞌ, tsí ga̱jma̱á numuu máꞌ ikhaa neꞌne-ku̱maa mbá xúgíí jamí ga̱jma̱á ski̱yu̱u̱ꞌ ríga̱ ne̱, nandoo̱ rí ma̱xtáa̱ gajmíi̱ mbaꞌiin i̱jii̱n ná mikhuíí. I̱ndo̱ó máꞌ numuu rí ndiꞌyóo rí ginii ma̱ꞌne káxi̱i̱ Jesús ga̱jma̱á majñu̱u̱ jamínu̱ꞌ, numuu rí ikhaa̱ ma̱ꞌne-jáwíi̱n. <verse eid="HEB 2:10" /><verse number="11" style="v" sid="HEB 2:11" />Tsí na̱ka̱-raꞌne-jaꞌwu̱un xa̱bo̱ jamí tsí na̱gu̱ma-jaꞌwu̱un, mbáwíi máꞌ Anúu̱. Ikhaa jngó, tsíti̱yu̱u̱ꞌ Jesús naꞌthán rí ikhaa̱ ñajuu̱n dxájúún tsúꞌkhue̱n. <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />Xáꞌnii ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="b" vid="HEB 2:12" />
  <para style="q" vid="HEB 2:12">«Ma̱thu̱ún a̱ngui̱nꞌ ga̱jma̱á numaaꞌ.</para>
  <para style="q" vid="HEB 2:12">Ná majñu̱ú tsí na̱gi̱mbíin ma̱ne̱-mba̱ánꞌlo̱ꞌ».<note caller="+" style="f"><char style="fr" closed="false">2.12 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 22.22.</char></note><verse eid="HEB 2:12" /></para>
  <para style="b" />
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />Jamí xáꞌnii iꞌthán ne̱ mangaa:</para>
  <para style="b" vid="HEB 2:13" />
  <para style="q" vid="HEB 2:13">«Ikhúúnꞌ ma̱nimbo̱ꞌ ja̱yo̱o̱ ikhaa̱».<note caller="+" style="f"><char style="fr" closed="false">2.13 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 8.17.</char></note></para>
  <para style="b" vid="HEB 2:13" />
  <para style="m" vid="HEB 2:13">Jamí naꞌthán ne̱ xóó:</para>
  <para style="b" vid="HEB 2:13" />
  <para style="q" vid="HEB 2:13">«Ge̱jyoꞌ xtáá, gajmíꞌ e̱je̱n tsí nixníꞌ Ana̱ꞌlóꞌ».<note caller="+" style="f"><char style="fr" closed="false">2.13 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 8.18. </char></note><verse eid="HEB 2:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />Ikhaa jngó, Jesús mangaa ninindxu̱u̱ xa̱bo̱ numbaa, numuu rí e̱je̱n tsúꞌkhue̱n ñajúún xa̱bo̱ numbaa. Xkuaꞌnii kajngó ndiyoo nijáñuu̱ jamí ga̱jma̱á majñu̱u̱ rí nijáñuu̱ ndiyoo neꞌne-gámbo̱o̱ ski̱yu̱u̱ꞌ gixa̱a̱, tsí nijanáá tsiakhe̱ rí ma̱gu̱díin xa̱bo̱. <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />Xúꞌkhue̱n máꞌ Jesús neꞌne-jáwíin mbá xúgíin tsí ga̱jma̱á numuu rí namíñúú rí ma̱ja̱ñúú, júwa̱ꞌ nune̱-mba̱ꞌwi̱i̱ gixa̱a̱. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />Numuu táꞌkhe̱e̱ rí mambáñúu̱ ánje̱l, rí ni̱ꞌkhe̱e̱ mambáñúu̱ i̱ji̱in Abraám. <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />Ikhaa numuu rúꞌkhue̱n, ndiꞌyóo rí mbá xúgíi̱ jayu ma̱nindxu̱u̱ xómá jaꞌñúú a̱nguii̱n, kajngó ma̱goo ma̱nindxu̱u̱ tsí jayá idxu̱ún dxakuun, tsí jmbii jamí nañáwíin a̱kui̱in rí maxnáxe̱ tsi̱gi̱jña̱ꞌ ná inuu Ana̱ꞌlóꞌ. Xkuaꞌnii kajngó ma̱ꞌne mba̱a̱ a̱kui̱in Ana̱ꞌlóꞌ jaꞌyoo aꞌkhúún xa̱bo̱. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />Jamí gíꞌdoo̱ tsiakhe̱ rí mambáñúu̱ tsí na̱gu̱ma-rájíin, numuu rí jmína̱a̱ꞌ máꞌ mangaa̱ nimínu̱u̱ꞌ jamí ndiyoo gixa̱a̱ gáꞌne-rájáa̱.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s">I̱tha̱án máꞌ gíꞌdoo numuu Jesús xó rí Moisés</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />Ikhaa jngó, a̱ngui̱nꞌ tsí jaꞌwuun, tsáanꞌ nindxaꞌwálaꞌ Ana̱ꞌlóꞌ rí ma̱nindxa̱ꞌlaꞌ xa̱bo̱ xuajñuu̱, gu̱ya̱á májánlaꞌ tsáa phú ñajuun Jesús. Ikhaa̱ ñajuu̱n tsí waxúngua̱a̱ꞌ jamí ikhaa̱ ñajuu̱n tsí jayá idxu̱ún dxakuun ga̱jma̱á numuu mbá xúgíí rí nanimba̱ꞌlóꞌ juꞌyáá Ana̱ꞌlóꞌ. <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />Ikhaa̱ neꞌne-mbánuu̱ rí ni̱ge̱ꞌe̱ inuu̱ rí ma̱ꞌnii̱ neꞌne Ana̱ꞌlóꞌ, xómá neꞌne-mbánuu Moisés mangaa ná majñu̱ú mbá xúgíin xa̱bo̱ guꞌwóo Ana̱ꞌlóꞌ. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />I̱ndo̱ó máꞌ numuu rí i̱tha̱án gíꞌdoo numuu Jesús xó rí Moisés, xómá rí i̱tha̱án gíꞌdoo numuu xa̱bo̱ tsí naꞌne guꞌwá inuu guꞌwá rí niꞌnii̱. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />Numuu rí xtáa mbáa tsí neꞌne-ku̱maa mbámbá guꞌwá, xómáꞌ tsí neꞌne-ku̱maa mbá xúgíí rí ríga̱ ñajuun Ana̱ꞌlóꞌ. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />Gakon máꞌ rí Moisés ninindxu̱u̱ yumbáá tsí jmbii ná majñu̱ú mbá xúgíin xa̱bo̱ guꞌwóo Ana̱ꞌlóꞌ. Ikhaa̱ niꞌthúu̱n xa̱bo̱ rí wéje̱ rí maꞌthán Ana̱ꞌlóꞌ nda̱wa̱á. <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />Xómáꞌ Krísto̱ rá, Ada̱ guꞌwá tsí jmbii ná guꞌwóo máꞌ Ana̱ꞌlóꞌ ñajuu̱n. Jamí ikháánꞌlóꞌ ñajwanlóꞌ mbá guꞌwíin xa̱bo̱ ná guꞌwá rúꞌkhue̱n, i̱ndo̱ó máꞌ numuu rí ndaꞌyóo rí ma̱we̱je̱ gúkúu a̱kia̱nꞌlóꞌ jamí ma̱xáti̱ya̱ꞌlóꞌ ga̱jma̱á numuu rí mbá jañii a̱kia̱nꞌlóꞌ guáꞌthi̱ínlóꞌ.<verse eid="HEB 3:6" /></para>
  <para style="s">Xkri̱da ga̱jma̱á numúú xa̱bo̱ Israél tsí nigájna̱á ná Ejípto̱</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />Ikhaa jngó, naꞌthán Xu̱u̱ꞌ Ana̱ꞌlóꞌ:</para>
  <para style="b" vid="HEB 3:7" />
  <para style="q" vid="HEB 3:7">«Xí nu̱dxawíínlaꞌ a̱ꞌwóo Ana̱ꞌlóꞌ xúge̱ꞌ,<verse eid="HEB 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HEB 3:8" />mu̱xúne̱ gúkú a̱kia̱nꞌlaꞌ,</para>
  <para style="q" vid="HEB 3:8">xómá nene̱ tsí nijñaguun,</para>
  <para style="q" vid="HEB 3:8">nákhí mbiꞌi rí ni̱jmaa̱ Ana̱ꞌlóꞌ ná mbaa niníí.<verse eid="HEB 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HEB 3:9" />Ikhín ni̱jmúú táta̱-xi̱ꞌñálaꞌ wajyúú, nini̱i̱ rí mbuyáa̱ xí mba̱a̱ a̱kui̱nꞌ,</para>
  <para style="q" vid="HEB 3:9">maske máꞌ ndiyáa̱ a̱jma̱ skíñú (40) tsigu rí phú wáá ne̱ne̱lo̱ꞌ ná inúu̱.<verse eid="HEB 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HEB 3:10" />Ikhaa numuu rúꞌkhue̱n nijiꞌnúú ja̱ñu̱ú mbá xúgíin xa̱bo̱ tsúꞌkhue̱n,</para>
  <para style="q" vid="HEB 3:10">jamí ni̱tha̱nlo̱ꞌ: “Mbá xúgíí mbiꞌi nikhuáa máꞌ jamba̱a̱ ngrigúu̱n,</para>
  <para style="q" vid="HEB 3:10">jamí tsíñúu̱ gúdxawíi̱n rí na̱thúu̱n”.<verse eid="HEB 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HEB 3:11" />Ikhaa jngó, nákhí rí najiꞌnúú ni̱xu̱ꞌdá-mina̱ꞌ ríge̱ꞌ:</para>
  <para style="q" vid="HEB 3:11">“Ni miꞌtsú ma̱xátu̱ꞌúu̱n rí mbuyaa̱ xúu̱nꞌ ga̱jma̱á nindxu̱ꞌ”».<note caller="+" style="f"><char style="fr" closed="false">3.11 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 95.7-11.</char></note><verse eid="HEB 3:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />A̱ngui̱nꞌ, a̱gu̱ya̱álaꞌ xí ndawa̱a̱ nimbáa tsí xkawi̱i̱ꞌ a̱kui̱in jamí tsínimbo̱o̱ꞌ ná majña̱ꞌlaꞌ rí ma̱ꞌne-tsíngua̱ꞌ-mina̱ꞌ ná inuu Ana̱ꞌlóꞌ tsí xtáa jámuu. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />I̱tha̱án máján rí gu̱tha̱n-máꞌán-mijnálaꞌ tsitsíí, awúun rí xóó ríga̱ mbiꞌi «xúge̱ꞌ», kajngó nimbáa ma̱xáꞌne gúkú a̱kui̱in ga̱jma̱á numuu rí ni̱gu̱ma-nduwaa eꞌne aꞌkhán. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />Numuu rí ikháánꞌlóꞌ nanindxa̱ꞌlóꞌ xa̱bi̱i Krísto̱, i̱ndo̱ó máꞌ numuu rí ndaꞌyóo rí ma̱wajún-gúkuálóꞌ ná tsu̱du̱u̱ rí ninimba̱ꞌlóꞌ asndo nákhí ginii. <verse eid="HEB 3:14" /><verse number="15" style="v" sid="HEB 3:15" />Ikhaa numuu rúꞌkhue̱n naꞌthán ajngáa rawuun Ana̱ꞌlóꞌ:</para>
  <para style="b" vid="HEB 3:15" />
  <para style="q" vid="HEB 3:15">«Xí nu̱dxawíínlaꞌ a̱ꞌwóo Ana̱ꞌlóꞌ xúge̱ꞌ,</para>
  <para style="q" vid="HEB 3:15">mu̱xúne̱ gúkú a̱kia̱nꞌlaꞌ,</para>
  <para style="q" vid="HEB 3:15">xómá nene̱ tsí nijñaguun».<note caller="+" style="f"><char style="fr" closed="false">3.15 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 95.7-8.</char></note><verse eid="HEB 3:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />Tsíin ñajúún tsí ni̱dxawíín ajngóo Ana̱ꞌlóꞌ jamí nijñaguun róꞌ. Á ra̱ꞌkhá mbá xúgíin tsí nigájna̱á ná numbaa Ejípto̱ gajmíí Moisés rá. <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />Jamí tsíin ñajúún tsí nijiꞌnáa Ana̱ꞌlóꞌ jaꞌñúú a̱jma̱ skíñú (40) tsigu róꞌ. Á ra̱ꞌkhíin tsí nene̱ aꞌkhán jamí nijáñúú ná mbaa niníí rá. <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />Jamí tsíin ñajúún tsí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxu̱ún rí ma̱xátu̱ꞌu̱ún mbuya̱a xu̱únꞌ ga̱jma̱á nindxu̱u̱ rá. Ikhiin máꞌ tsí túne̱-mbáníí rí niꞌthúu̱n. <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />Jamí nduꞌyáálóꞌ rí ra̱khóo gátu̱ꞌúu̱n mbuyaa̱ xúu̱nꞌ ga̱jma̱á numuu rí tánimbúu̱nꞌ juyáa̱ ajngóo Ana̱ꞌlóꞌ rí ni̱dxawíi̱n.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="s">Mbiꞌi rí mbuya̱a xu̱únꞌ xa̱bo̱ xuajñuu Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />Ikhaa jngó, gia̱wa̱n gúꞌne̱lóꞌ, awúun rí xóó ríga̱ mbiꞌi rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ maxnálóꞌ rí mbu̱ꞌyáa xa̱ꞌlóꞌ ga̱jma̱á nindxu̱u̱ ikhaa̱, ra̱ꞌkhá mbáa tsí ikháanꞌlaꞌ ma̱xájanáá mbayáa xu̱u̱ꞌ ga̱jma̱á nindxu̱u̱ Ana̱ꞌlóꞌ gáꞌne. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />Numuu rí mangáánꞌlóꞌ waꞌthánlóꞌ ajngáa máján xómá ikhii̱n, i̱ndo̱ó máꞌ numuu rí ikhii̱n támbáñúu̱ ne̱, numuu rí táwe̱je̱ a̱kuíi̱n ná inuu Ana̱ꞌlóꞌ xómá nene̱ tsí ninimbu̱únꞌ ajngáa rúꞌkhue̱n. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />Xómáꞌ ikháánꞌlóꞌ tsáanꞌ ninimba̱ꞌlóꞌ, ma̱ta̱ꞌa̱ꞌlóꞌ mbu̱ꞌyáa xa̱ꞌlóꞌ ga̱jma̱á nindxu̱u̱ Ana̱ꞌlóꞌ. Xómáꞌ tsí tánimbu̱únꞌ niꞌthúu̱n:</para>
  <para style="b" vid="HEB 4:3" />
  <para style="q" vid="HEB 4:3">«Ikhaa jngó, nákhí rí najiꞌnúú ni̱xu̱ꞌdá-mina̱ꞌ ríge̱ꞌ:</para>
  <para style="q" vid="HEB 4:3">“Ni miꞌtsú ma̱xátu̱ꞌúu̱n rí mbuyaa̱ xúu̱nꞌ ga̱jma̱á nindxu̱ꞌ”».<note caller="+" style="f"><char style="fr" closed="false">4.3 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 95.11.</char></note></para>
  <para style="b" vid="HEB 4:3" />
  <para style="m" vid="HEB 4:3">Ana̱ꞌlóꞌ niꞌthán rúꞌkhue̱n, maske máꞌ wáxu̱u̱ mbá xúgíí ñajuu̱n asndo nákhí máꞌ neꞌne-ku̱maa̱ numbaa. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />Numuu rí ríga̱ mbá ná naꞌthán xáꞌnii ga̱jma̱á numuu mbiꞌi tijwan ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="q" vid="HEB 4:4">«Ndiyáa xu̱u̱ꞌ Ana̱ꞌlóꞌ mbiꞌi tijwan, numuu rí neꞌne-gáxu̱u̱ mbá xúgíí ñajuu̱n».<note caller="+" style="f"><char style="fr" closed="false">4.4 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ xó ni̱gi̱ꞌdu̱u̱n-muu 2.2.</char></note><verse eid="HEB 4:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="HEB 4:5" />Jamí naꞌthán ne̱ mbu̱júꞌ:</para>
  <para style="q" vid="HEB 4:5">«Ni miꞌtsú ma̱xátu̱ꞌúu̱n rí mbuyaa̱ xúu̱nꞌ ga̱jma̱á nindxu̱ꞌ».<note caller="+" style="f"><char style="fr" closed="false">4.5 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 95.11.</char></note><verse eid="HEB 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6" />Ikhaa jngó, ndaꞌyóo xóó rí ma̱tu̱ꞌu̱ún mbá tikhuun mbuya̱a xu̱únꞌ ga̱jma̱á nindxu̱u̱ Ana̱ꞌlóꞌ, numuu rí xa̱bo̱ tsí ginuu waꞌthúún ajngáa máján, tátu̱ꞌúu̱n ga̱jma̱á numuu rí túne̱-mbáníi̱ rí waꞌthúu̱n. <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />Ikhaa numuu rúꞌkhue̱n Ana̱ꞌlóꞌ niꞌgí i̱mba̱ mbiꞌi rí ñajuun «xúge̱ꞌ», jamí niꞌthée̱n ga̱jma̱á numuu mbiꞌi rúꞌkhue̱n nda̱wa̱á guéño ga̱jma̱á majñu̱u̱ Dabíd:</para>
  <para style="b" vid="HEB 4:7" />
  <para style="q" vid="HEB 4:7">«Xí nu̱dxawíínlaꞌ a̱ꞌwóo Ana̱ꞌlóꞌ xúge̱ꞌ,</para>
  <para style="q" vid="HEB 4:7">mu̱xúne̱ gúkú a̱kia̱nꞌlaꞌ».<note caller="+" style="f"><char style="fr" closed="false">4.7 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 95.7-8.</char></note><verse eid="HEB 4:7" /></para>
  <para style="b" />
  <para style="m">
    <verse number="8" style="v" sid="HEB 4:8" />Xí numuu rí Josué nixnúu̱ ná mbuyaa̱ xúu̱nꞌ, ma̱xáꞌthán Ana̱ꞌlóꞌ nda̱wa̱á ga̱jma̱á numuu i̱mba̱ mbiꞌi. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />Rúꞌkhue̱n iꞌthán rí xóó ríga̱ i̱mba̱ mbiꞌi rí mbuya̱a xu̱únꞌ xa̱bo̱ xuajñuu Ana̱ꞌlóꞌ. <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />Tsí ndayáa máꞌ xu̱u̱ꞌ, ndayáa̱ xu̱u̱ꞌ inuu mbá xúgíí ñajuu̱n, xómá rí Ana̱ꞌlóꞌ ndiyáa xu̱u̱ꞌ inuu mbá xúgíí ñajuun mangaa. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />Ikhaa jngó, gu̱ꞌne̱-jáñíílóꞌ rí ma̱ta̱ꞌa̱ꞌlóꞌ mbu̱ꞌyáa xa̱ꞌlóꞌ ikhín, kajngó nimbáa ma̱xáyá-ri̱doo xkri̱dúún xa̱bo̱ tsí tánimbu̱únꞌ.<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />Rí ajngáa rawuun Ana̱ꞌlóꞌ ndaꞌya ne̱ jamí gíꞌdoo ne̱ tsiakhe̱, jamí i̱tha̱án xíni ne̱ inuu asndo nguáa máꞌ chíde̱ rí a̱jma̱ rawuun. Najngúun ne̱ asndo awúún jamí na̱ro̱thongaa ne̱ ními̱i jamí a̱kui̱in xa̱bo̱, mangaa máꞌ na̱ro̱thongaa ne̱ nítú rí na̱ru̱wa̱a itsu̱u̱ xa̱bo̱ jamí ngáñúu itsu̱u̱. Xúꞌkhue̱n máꞌ ndaꞌyoo ne̱ rí nandxaꞌwá-mina̱ꞌ jamí nandoo gáꞌne xa̱bo̱. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />Numuu rí nda̱a̱ nitháan rí neꞌne-ku̱maa Ana̱ꞌlóꞌ rí tsíkujma ná inuu̱. Mbá xúgíí nakujma jamí ja̱ma̱ꞌtha iꞌyoo tsí wéje̱ rí mu̱guáꞌnúuꞌlóꞌ inuu kajngó mu̱ꞌtháa̱nlóꞌ rí ne̱ꞌne̱lóꞌ.<verse eid="HEB 4:13" /></para>
  <para style="s">Jesús ñajuun tsí jayá idxu̱ún dxakuun</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />Kuaꞌdaalóꞌ mbáa tsí jayá idxu̱ún dxakuun tsí maphú ikhaa, Jesús, tsí ñajuun A̱dée Ana̱ꞌlóꞌ, jamí ni̱to̱ꞌo̱o̱ asndo mikhuíí. Ikhaa numuu rúꞌkhue̱n, mu̱xúni̱ꞌñáá-ranimba̱ꞌlóꞌ mbá xúgíí rí nanimba̱ꞌlóꞌ ga̱jma̱á numuu Ana̱ꞌlóꞌ. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />Numuu rí na̱nguá guaꞌdaalóꞌ mbáa tsí jayá idxu̱ún dxakuun tsí tsíꞌngo̱o̱ gáñáwíin a̱kui̱in jaꞌyalóꞌ rí wabáánꞌlóꞌ, rí guaꞌdaalóꞌ mbáa tsí ndiyoo gixa̱a̱ gáꞌne-rájáa mbá xúgíí jayu xómá rí nugíꞌníí ikháánꞌlóꞌ, i̱ndo̱ó máꞌ numuu rí ikhaa̱ ni miꞌtsú táꞌnii̱ aꞌkhán. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />Ikhaa jngó, a̱guáꞌnúlóꞌ ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ ná inuu Ana̱ꞌlóꞌ, kajngó ma̱ñáwíin a̱kuii̱n jaꞌyalóꞌ jamí ma̱ni̱gu̱u̱ꞌ mambáyálóꞌ ído̱ rí phú ndaꞌyálóꞌ.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />Jámba̱a̱ tsí jayá idxu̱ún dxakuun nitraꞌwíi̱ ná majñu̱ú xa̱bo̱. Na̱gi̱ꞌi̱i̱ rí mañajwii̱n ná inuu Ana̱ꞌlóꞌ ga̱jma̱á numúú xa̱bo̱ xuajñuu̱, kajngó maxnáxi̱i̱ tsi̱gi̱jña̱ꞌ jamí maxnáxii̱n xu̱kú tsí nijáñúú kajngó Ana̱ꞌlóꞌ ma̱ꞌne mba̱a̱ a̱kui̱in jaꞌyoo aꞌkhán. <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />Nandoo nañáwíin a̱kuii̱n jaꞌñúu̱ tsí júgoo inúú jamí nune̱ aꞌkhán, numuu rí phú wabaa̱ máꞌ mangaa̱. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />Ikhaa numuu rúꞌkhue̱n, gíꞌmaa rí maxnáxi̱i̱ tsi̱gi̱jña̱ꞌ ga̱jma̱á numuu aꞌkhúu̱n ikhaa̱, jamí ga̱jma̱á numuu aꞌkhúún xa̱bo̱ xuajen.<verse eid="HEB 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 5:4" />Nimbáa tsíꞌgí-mina̱ꞌ máꞌ ikhaa rí ma̱ꞌne ñajun máján ríge̱ꞌ, rí i̱ndo̱ó máꞌ tsí watraꞌwíi neꞌne Ana̱ꞌlóꞌ, xómá watraꞌwíi Aarón nákhí wajyúú. <verse eid="HEB 5:4" /><verse number="5" style="v" sid="HEB 5:5" />Xkuaꞌnii máꞌ Krísto̱ mangaa, táꞌgí-mine̱e̱ꞌ máꞌ ikhaa̱ rí ma̱nindxu̱u̱ tsí jayá idxu̱ún dxakuun, rí jmína̱a̱ꞌ máꞌ Ana̱ꞌlóꞌ niꞌthúu̱n:</para>
  <para style="b" vid="HEB 5:5" />
  <para style="q" vid="HEB 5:5">«Ikháánꞌ ñajwaanꞌ A̱ꞌdéꞌ.</para>
  <para style="q" vid="HEB 5:5">Ikhúúnꞌ nanindxu̱ꞌ Ana̱a̱ꞌ asndo nákhí mbiꞌi ríge̱ꞌ».<note caller="+" style="f"><char style="fr" closed="false">5.5 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 2.7.</char></note><verse eid="HEB 5:5" /></para>
  <para style="b" />
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />Jamí i̱mba̱ miꞌtsú niꞌthán Ana̱ꞌlóꞌ:</para>
  <para style="b" vid="HEB 5:6" />
  <para style="q" vid="HEB 5:6">«Ikháánꞌ jámuu ñajwaanꞌ dxakuun,</para>
  <para style="q" vid="HEB 5:6">xómá ninindxu̱u̱ Melkisedék».<note caller="+" style="f"><char style="fr" closed="false">5.6 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 110.4.</char></note><verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />Nákhí Krísto̱ nixtáa ná numbaa ríge̱ꞌ, niꞌthán-kháa̱n jamí niꞌthán-jáñuu̱ Ana̱ꞌlóꞌ ga̱jma̱á yaꞌduu̱ numuu rí ma̱ꞌne-jríya̱a̱ꞌ rí ma̱xájáñúu̱. Nidxawuun Ana̱ꞌlóꞌ ajngóo̱ ga̱jma̱á numuu rí gamakuii̱ jamí naꞌne-mbánuu̱ rí nitháa̱n. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />Maske máꞌ A̱dée Ana̱ꞌlóꞌ ñajuu̱n, ga̱jma̱á majñu̱u̱ rí nimínu̱u̱ꞌ ni̱ma̱ñuu̱ ma̱ꞌnii̱ rí nandoo Anu̱u̱. <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />Ído̱ wámba̱ ni̱gu̱ma-káxi̱i̱, a̱ꞌkhue̱n ninindxu̱u̱ tsí ma̱ꞌne-jáwíin jámuu mbá xúgíin tsí nune̱-mbáníí rí naꞌthúu̱n ikhaa̱. <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />A̱ꞌkhue̱n niꞌthán Ana̱ꞌlóꞌ rí ikhaa̱ ñajuu̱n tsí jayá idxu̱ún dxakuun xómá ninindxu̱u̱ Melkisedék.<verse eid="HEB 5:10" /></para>
  <para style="s">Nithán-máꞌánlóꞌ rí ma̱xáthangáanꞌlóꞌ tsu̱di̱í</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />Phú ríga̱ mbaꞌa xóó rí ma̱tha̱nꞌlaꞌ ga̱jma̱á numuu ríge̱ꞌ, jamí mingíjyúu rí ma̱tha̱n-makalaꞌ ne̱, numuu rí tsíꞌgíi idxa̱ꞌlaꞌ rí mu̱dxawíínlaꞌ rí nithánlaꞌ. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />Nixtáa máꞌ rí ma̱nindxa̱ꞌlaꞌ tsí nusngáá numuu rí phú wajyúú máꞌ nu̱dxawíínlaꞌ ajngóo Ana̱ꞌlóꞌ. Xómáꞌ ikháanꞌlaꞌ nandalaꞌ rí mbáa maꞌthánlaꞌ mbu̱júꞌ gisngáá rí ginii jayu. Xómá e̱je̱n cháña̱ꞌ jaꞌñáaꞌlaꞌ rí ndaꞌyálaꞌ yaꞌdú, numuu rí xóó máꞌ tsíꞌnga̱ꞌlaꞌ gúpholaꞌ ganitsu rí gakhi̱i̱. <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />Jámba̱a̱ tsí naꞌxúu, xóó tsíjmaa̱ gáraꞌwíi̱ ajngáa rí máján, numuu rí cháña̱ꞌ ñajuu̱n. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />Xómáꞌ ganitsu rí gakhi̱i̱ rá, naꞌpho̱ ne̱ xa̱bo̱ tsí nigaꞌnuu máꞌ, tsí na̱ma̱ñúú máꞌ nu̱ra̱ꞌwíí rí máján inuu rí ra̱máján, numuu rí tsitsíí máꞌ nuxna-mijnée̱ tsiakhe̱ rí muni̱i̱ xkuaꞌnii.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />Ikhaa jngó, gu̱ni̱ꞌñáálóꞌ janíí gisngáá rí ginii jayu ni̱drígúlóꞌ ga̱jma̱á numuu Krísto̱, ga̱ma̱ñalóꞌ gisngáá rí i̱tha̱án tsída̱ꞌ ga̱jma̱á numuu̱ kajngó ma̱ꞌkhiáanꞌlóꞌ asndo ma̱ꞌne káxáanꞌlóꞌ. Ma̱xáthangáanꞌlóꞌ mu̱ꞌne̱-gajma̱a̱ mbu̱jwálóꞌ nakhúu rí ne̱ꞌne̱-gajma̱a̱lóꞌ máꞌ: rí ma̱thanga̱a a̱kia̱nꞌlóꞌ rí nu̱ꞌne̱lóꞌ rí na̱nguá gíꞌdoo numuu, jamí rí ma̱we̱je̱ a̱kia̱nꞌlóꞌ ná inuu Ana̱ꞌlóꞌ. <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />Nánguá máꞌ iꞌyóo rí mu̱ꞌne̱-gajma̱a̱lóꞌ gisngáá numuu rí mi̱xúꞌdu maꞌáanꞌlóꞌ ná awúun iya, numuu rí mu̱xkráma xa̱bo̱ ná idxa̱ꞌlóꞌ rí mune̱-tsakun-rámáa̱ꞌlóꞌ, numuu rí mbuya̱a mbiꞌñúú tsí nijáñúú, ni máꞌ numuu rí mbuyamíni̱í jámuu xa̱bo̱. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />Ikhaa jngó, xí Ana̱ꞌlóꞌ nandoo, ma̱ma̱ñalóꞌ gisngáá rí i̱tha̱án tsída̱ꞌ ga̱jma̱á numuu Krísto̱.<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />Numuu rí xa̱bo̱ tsí mbóó miꞌtsú máꞌ nimbiꞌñúú neꞌne aguu Ana̱ꞌlóꞌ, nene̱-nuwii̱n máꞌ rí naxná Ana̱ꞌlóꞌ, jamí ni̱dri̱guíi̱ máꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ. <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />Xúꞌkhue̱n máꞌ, ndiyáa̱ máꞌ rí ndasko̱ꞌ ajngáa rawuun Ana̱ꞌlóꞌ, nene̱-nuwii̱n máꞌ ski̱yu̱u̱ꞌ numbaa rí ni̱kú ma̱ꞌkha̱. <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />Xí nda̱wa̱á nune̱-tsíngua̱ꞌ-mijnée̱ ná inuu Ana̱ꞌlóꞌ, náxáxóo rí ma̱thanga̱a a̱kuíi̱n ná inuu Ana̱ꞌlóꞌ jamí ma̱gu̱ma-nuxii̱nꞌ mbu̱júꞌ, numuu rí asndo xómá rí nudujmaa̱ mbu̱júꞌ A̱dée Ana̱ꞌlóꞌ ná ixe̱ krúsi̱ jaꞌnii rí xkuaꞌnii, jamí nune̱-mati̱i̱ꞌ mbu̱júꞌ ná inúú xa̱bo̱.<verse eid="HEB 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7" />Numuu rí ju̱ba̱ꞌ rí naꞌña̱a̱ iyoo ruꞌwa rí mbaꞌa nothon naxnúu, jamí najma̱a̱ rí mu̱pho̱ xa̱bo̱ tsí nu̱ñajun ná tsu̱du̱u̱ ne̱, Ana̱ꞌlóꞌ naꞌne-tsakun-rámaa ju̱ba̱ꞌ rúꞌkhue̱n. <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />Xómáꞌ ju̱ba̱ꞌ rí i̱ndo̱ó máꞌ iná tsuwan jamí iná ríꞌná najma̱a̱ ná inuu rá, nda̱a̱ numuu ríga̱ ne̱. Ana̱ꞌlóꞌ naxná-máꞌáan ne̱ jamí i̱ndo̱ó máꞌ gíꞌthu̱u̱n ne̱ rí mi̱kha ne̱.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />A̱ngui̱nꞌ, tsáanꞌ phú nandoꞌ ja̱ya̱ꞌlaꞌ, maske máꞌ phú gakhe̱ i̱tha̱nxo̱ꞌ rá, naꞌne jañii a̱kia̱nꞌxo̱ꞌ rí i̱tha̱án máꞌ máján rí gíꞌtha̱nꞌlaꞌ ikháanꞌlaꞌ, rí Ana̱ꞌlóꞌ ma̱ꞌne-jríñáaꞌlaꞌ. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />Numuu rí ra̱ꞌkhá xa̱bo̱ tsí xkawi̱i̱ꞌ a̱kui̱in ñajuun Ana̱ꞌlóꞌ kajngó ma̱mbumuu̱ rí nu̱ne̱laꞌ. Na̱rmáꞌáan a̱kuii̱n rí ni̱snga̱jmálaꞌ rí nandalaꞌ ju̱yáa̱ nákhí rí ne̱ne̱-mba̱ꞌwi̱inlaꞌ xa̱bii̱, jamí nu̱ne̱-mba̱ꞌwii̱nlaꞌ máꞌ asndo xúge̱ꞌ. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />I̱ndo̱ó máꞌ numuu rí nandaxo̱ꞌ rí mbámbáa tsí ikháanꞌlaꞌ gáꞌne ga̱jma̱á mbá jañii a̱kui̱in rí naꞌne, asndo mbiꞌi rí ndámba̱wóo, kajngó ma̱mba̱núu mbá xúgíí rí ga̱jma̱á mbá jañii a̱kia̱nꞌlaꞌ guáꞌthi̱ínlaꞌ. <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />Numuu nandaxo̱ꞌ rí ma̱xáꞌskalaꞌ, rí gu̱ya̱ri̱dáálaꞌ rí nune̱ xa̱bo̱ tsí wéje̱ a̱kui̱ín ná inuu Ana̱ꞌlóꞌ jamí mba̱a̱ a̱kui̱ín, ikhaa jngó nu̱dri̱guíi̱ rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ.<verse eid="HEB 6:12" /></para>
  <para style="s">Ana̱ꞌlóꞌ naꞌne-mbánuu rí naxuda-mina̱ꞌ</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />Nákhí rí Ana̱ꞌlóꞌ nixuda-mina̱ꞌ ga̱jma̱á nindxu̱u̱ Abraám, ndawa̱a̱ i̱mba̱a̱ꞌ tsí phú i̱tha̱án gíꞌdoo numuu ma̱ꞌne inuu rí naxuda-mine̱e̱ꞌ, kajngó nixuda-mine̱e̱ꞌ ga̱jma̱á numuu̱ máꞌ ikhaa̱. <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />Xáꞌnii niꞌthúu̱n Abraám: Na̱tha̱n-jmbaaꞌ rí maphú ma̱ne̱-tsakun-rámááꞌ jamí ma̱ne̱ rí maphú ma̱ꞌne mbaꞌiin xa̱bia̱aꞌ. <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />Jamí Abraám táꞌne níꞌngo̱o̱ rí ma̱gi̱ꞌthu̱u̱n, a̱ꞌkhue̱n ni̱grui̱guíi̱ rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ.<verse eid="HEB 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 6:16" />Ído̱ rí mbáa xa̱bo̱ numbaa naxuda-mina̱ꞌ rí ma̱ꞌne, naxuda-mine̱e̱ꞌ ná inuu i̱mba̱a̱ꞌ xa̱bo̱ tsí i̱wa̱á gíꞌdoo numuu xó rí ikhaa̱, kajngó ma̱gi̱ꞌdoo numuu ajngóo̱ jamí ma̱xáríga̱ xkujndu nda̱wa̱á. <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />Xkuaꞌnii máꞌ mangaa, ído̱ rí Ana̱ꞌlóꞌ ndiyoo rí masngájmúú tsí mu̱drígú rí nixuda-mine̱e̱ꞌ, rí ma̱xáriꞌkhuu̱ rí niꞌthée̱n ma̱ꞌnii̱, nixuda-mine̱e̱ꞌ ga̱jma̱á numuu̱ máꞌ ikhaa̱. <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />Ikhaa jngó ríga̱ a̱jma̱ rí tsíyoo ma̱xtiꞌkhuu jamí nimbá miꞌtsú ma̱xáꞌne-nduwa Ana̱ꞌlóꞌ ga̱jma̱á numuu rúꞌkhue̱n, rí niꞌthée̱n ma̱ꞌnii̱ jamí rí nixuda-mine̱e̱ꞌ ma̱ꞌnii̱. Ikhaa rúꞌkhue̱n phú mba̱a̱ tsiakhe̱ naxnálóꞌ tsáanꞌ na̱mbu̱jmalóꞌ ná inuu Ana̱ꞌlóꞌ jamí ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ guáꞌthi̱ínlóꞌ rí maxnálóꞌ rí niꞌthée̱n. <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />Rí ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ guáꞌthi̱ínlóꞌ naꞌne rí ma̱we̱je̱ gúkúu jamí ma̱we̱je̱ xa̱ꞌ nímia̱ꞌlóꞌ, xómá eꞌne ajwa̱nꞌ mixngaa rí ma̱we̱je̱ jayóo guꞌwá-rguwa ná iya a̱pha̱. Xúꞌkhue̱n máꞌ mangaa, rí ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ guáꞌthi̱ínlóꞌ na̱to̱ꞌo̱o̱ ne̱ asndo ná awúun guꞌwá dxákuun rí ꞌgí ná mikhuíí. <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />Ikhín máꞌ ni̱to̱ꞌo̱o̱ Jesús ginii jayu ga̱jma̱á numalóꞌ, numuu rí ikhaa̱ jámuu ninindxu̱u̱ tsí jayá idxu̱ún dxakuun, xómá ninindxu̱u̱ Melkisedék.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s">Rí nithán ga̱jma̱á numuu Melkisedék</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />Melkisedék ninindxu̱u̱ thúngaa ná xuajen Salém, jamí dxakuiin máꞌ Ana̱ꞌlóꞌ Mikhuíí ñajuu̱n. Ni̱ꞌkhe̱e̱ gátsijnuu̱ Abraám nákhí rí na̱ꞌkha̱a ni̱ꞌngo̱o̱ ni̱tsa̱ñu̱u̱ꞌ gajmíí thúngaa, jamí neꞌne-tsakun-rámaa̱. <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />Jamí Abraám nixnúu Melkisedék mbóó rí mbámbá gu̱wa̱ꞌ kíxnuu rí mbá xúgíí rí ni̱grui̱gú-jáꞌñúu̱ thúngaa. Rí mbiꞌyuu Melkisedék phú ginii jayu nandoo gáꞌthán ne̱, «Thúngaa tsí májáan», jamí xúꞌkhue̱n máꞌ mangaa «Thúngaa drígo̱o̱ Salém». Rúꞌkhue̱n nandoo gáꞌthán «Thúngaa tsí naꞌne rí ma̱ju̱wá tsímáá xa̱bo̱». <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />Nimbáa tsíꞌyoo tsáa ñajuun tátée̱ ni máꞌ tsáa ñajuun nánée̱ ni máꞌ tsíin ñajúún táta̱-xi̱ꞌñúu̱ wajyúú. Ni tsiánguá nguáná ni̱gu̱maa̱ ni máꞌ na̱nguá nikujma xí nijáñuu̱. Kajngó asndo xómá A̱dée Ana̱ꞌlóꞌ jaꞌnii̱ rí jámuu ñajuu̱n dxakuun.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />A̱gu̱ya̱álaꞌ rí maphú gíꞌdoo numuu xa̱bo̱ tsíge̱ꞌ, rí asndo jmína̱a̱ꞌ máꞌ táta̱-xi̱ꞌñálóꞌ Abraám nixnúu̱ mbóó rí mbámbá gu̱wa̱ꞌ kíxnuu rí ni̱grui̱gú-jáꞌñúu̱ xa̱bo̱ sia̱nꞌ. <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />Gakon máꞌ rí i̱ji̱in Lebí, tsí ñajúún dxakuun, guáꞌdáa̱ xtángoo rí mu̱dri̱guíi̱ mbóó rí mbámbá gu̱wa̱ꞌ kíxnuu rí gíꞌdoo mbámbáa xa̱bo̱ xuajen, tsí a̱nguíi̱n máꞌ, maske máꞌ i̱ji̱in Abraám ñajúún tsíge̱ꞌ mangiin. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />Xómáꞌ Melkisedék, maske máꞌ ra̱ꞌkháa xa̱bo̱ ri̱jyu̱u̱ꞌ Lebí ñajuu̱n, ni̱grui̱gíi̱ tsiakhe̱ mbóó rí mbámbá gu̱wa̱ꞌ kíxnuu rí nixná Abraám. A̱ꞌkhue̱n neꞌne-tsakun-rámaa̱ tsí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxu̱u̱. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />Mbá xúgiáanꞌlóꞌ nduꞌyáá rí xa̱bo̱ tsí i̱tha̱án gíꞌdoo numuu naꞌne-tsakun-rámaa̱ xa̱bo̱ tsí na̱nguá gíꞌdoo guéño numuu. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />Gakon máꞌ rí xúge̱ꞌ nu̱drígú mbóó rí mbámbá gu̱wa̱ꞌ kíxnuu xa̱bi̱i Lebí, xa̱bo̱ numbaa tsí wéje̱ rí ma̱ja̱ñúú. Xómáꞌ nákhí xúꞌkhue̱n, ni̱grui̱gú ne̱ Melkisedék, tsí nithán numuu rí xtáa ndaꞌya asndo xúge̱ꞌ. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />Maske máꞌ xa̱bi̱i Lebí nu̱drígú mbóó rí mbámbá gu̱wa̱ꞌ kíxnuu rí xúge̱ꞌ, ma̱goo mu̱ꞌthánlóꞌ rí mangii̱n máꞌ nixnáa̱ Melkisedék mbóó rí mbámbá gu̱wa̱ꞌ kíxnuu ga̱jma̱á majñu̱u̱ Abraám. <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />Numuu rí júwe̱e̱ꞌ máꞌ ná awúun ri̱jyu̱u̱ꞌ táta̱-xi̱ꞌñúu̱ nákhí rí Melkisedék ni̱ꞌkha̱ gátsijnuu Abraám.<verse eid="HEB 7:10" /></para>
  <para style="s">Mbríguii Jesús ga̱jma̱á Melkisedék</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />Ana̱ꞌlóꞌ nixnúú xtángoo xa̱bo̱ Israél. Jamí ná xtángoo naꞌthán rí xa̱bo̱ tsí juya̱ iꞌdiuu Lebí ma̱nindxúu̱n dxakuun, xómáꞌ ikhii̱n táꞌngúu̱n gúni̱i̱ rí ma̱ꞌne káxi̱in xa̱bo̱. Ikhaa jngó ndiꞌyóo rí ma̱ꞌkha̱ i̱mba̱a̱ꞌ dxakuun tsí na̱nguá mbríguii ga̱jma̱á Aarón, rí mbáa tsí mbríguii ga̱jma̱á Melkisedék. <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />Xí i̱mba̱ inii dxakuun ñajuun tsíge̱ꞌ, ndaꞌyóo rí ma̱xtiꞌkhu̱u xtángoo mangaa xúꞌkhue̱n rá. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />Jamí tsí nithán numuu ríge̱ꞌ, ná i̱mba̱ guꞌwíin xa̱bo̱ ni̱ꞌkhe̱e̱, ná tájanáá nimbáa maxnáxe̱ tsi̱gi̱jña̱ꞌ ná ja̱rngo̱xe̱ itsí. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />Numuu rí nduꞌyáá máꞌ májánlóꞌ rí Tátiálóꞌ Jesús ni̱ꞌkha̱ ná mbá guꞌwíin xa̱bi̱i Judá, jamí nda̱a̱ nitháan rí niꞌthán Moisés ga̱jma̱á numúú dxakuun ná ri̱jyu̱u̱ꞌ xa̱bo̱ tsíge̱ꞌ.<verse eid="HEB 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15" />Jamí i̱wa̱á máꞌ nduꞌyáá gúkuálóꞌ rí i̱mba̱ inii dxakuun ñajuun Jesús, xí xómá Melkisedék jaꞌnii̱. <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />Numuu rí ikhaa̱ tági̱ꞌi̱i̱ ga̱jma̱á majñu̱u̱ xtángoo rí naꞌthán rí i̱ji̱in Lebí ma̱nindxu̱ún dxakuun, rí ni̱gi̱ꞌi̱i̱ ga̱jma̱á majñu̱u̱ ski̱yu̱u̱ꞌ mbiꞌyuu̱ rí xtáa̱ jámuu. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />Ga̱jma̱á numuu̱ ikhaa̱ naꞌthán ajngáa rawuun Ana̱ꞌlóꞌ ríge̱ꞌ:</para>
  <para style="q" vid="HEB 7:17">«Ikháánꞌ jámuu ñajwaanꞌ dxakuun,</para>
  <para style="q" vid="HEB 7:17">xómá ninindxu̱u̱ Melkisedék».<note caller="+" style="f"><char style="fr" closed="false">7.17 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 110.4.</char></note><verse eid="HEB 7:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="HEB 7:18" />Ikhaa jngó, nánguá máꞌ gíꞌdoo numuu xtángoo rí ginii, numuu rí nda̱a̱ ski̱yu̱u̱ꞌ ne̱ ni máꞌ tsíꞌngo̱o̱ ne̱, <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />numuu rí nitháan táꞌngo̱o̱ ne̱ gáꞌne-káxi̱in xa̱bo̱. Ikhaa jngó ríga̱ i̱mba̱ rí i̱tha̱án máján guáꞌthi̱ín ikháánꞌlóꞌ ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ, ga̱jma̱á majñu̱u̱ rúꞌkhue̱n nu̱xu̱ꞌmá-mijnálóꞌ ná inuu Ana̱ꞌlóꞌ.<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />Jamí Ana̱ꞌlóꞌ nixuda-mina̱ꞌ ga̱jma̱á numuu ríge̱ꞌ mangaa. <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />Numuu rí tsí i̱ꞌwíin, tánindxúu̱n dxakuun ga̱jma̱á majñu̱u̱ rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ. Xómáꞌ tsíge̱ꞌ ninindxu̱u̱ dxakuun ga̱jma̱á majñu̱u̱ ajngáa ríge̱ꞌ:</para>
  <para style="q" vid="HEB 7:21">«Nixuda-mina̱ꞌ Táta̱,</para>
  <para style="q" vid="HEB 7:21">jamí ma̱xáthanga̱a a̱kuii̱n:</para>
  <para style="q" vid="HEB 7:21">“Ikháánꞌ jámuu ñajwaanꞌ dxakuun,</para>
  <para style="q" vid="HEB 7:21">xómá ninindxu̱u̱ Melkisedék”».<note caller="+" style="f"><char style="fr" closed="false">7.21 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «xómá ninindxu̱u̱ Melkisedék». Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 110.4.</char></note><verse eid="HEB 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />Ikhaa jngó, Jesús ninindxu̱u̱ tsí ma̱ꞌne-mbánuu mbá awan rí i̱tha̱án máján.<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />Tsí i̱ꞌwíin dxakuun maphú mbaꞌii̱n ni̱ka̱-raꞌne, numuu rí nimbáa tsí ikhii̱n na̱nguá xtáa jámuu. <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />Xómáꞌ Jesús jámuu xtáa̱, ikhaa jngó tsíyoo rí ma̱xtiꞌkhuii̱, numuu rí ikhaa̱ jámuu ñajuu̱n dxakuun. <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />Jamí gíꞌdoo̱ tsiakhe̱ mangaa rí ma̱ꞌne-jáwíi̱n jámuu tsí nu̱xu̱ꞌmá-mijná ná inuu Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ ikhaa̱, numuu rí ndaꞌyee̱ jámuu kajngó maꞌthán-jáñuu̱ Ana̱ꞌlóꞌ ga̱jma̱á numúú tsúꞌkhue̱n.<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />Numuu rí Jesús ñajuun tsí jayá idxu̱ún dxakuun tsí phú ndaꞌyálóꞌ. Ikhaa̱ jaꞌwii̱, nda̱a̱ aꞌkhúu̱n, nda̱a̱ rí xkawe̱ꞌ ná a̱kuii̱n, tsíꞌnii̱ rí nune̱ xa̱bo̱ tsí nune̱ aꞌkhán, jamí i̱tha̱án tsída̱ꞌ xtáa̱ ná inuu mbá xúgíí mikhu. <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />Jamí tsíꞌyóo̱ rí tsitsíí maxnáxii̱n xu̱kú tsí nijáñúú ga̱jma̱á numuu aꞌkhúu̱n ikhaa̱ ginii, jamí nda̱wa̱á ga̱jma̱á numuu aꞌkhúún xa̱bo̱ xuajen, xómá ene̱ i̱ꞌwíin tsí juya̱ idxu̱ún dxakuun. Numuu rí Jesús mbóó miꞌtsú nixnáxi̱i̱ tsi̱gi̱jña̱ꞌ jamí jámuu gíꞌdoo numuu ne̱ numuu rí jmína̱a̱ꞌ máꞌ nixnáxe̱-mine̱e̱ꞌ. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />Numuu rí xtángoo drígo̱o̱ Moisés naskuíji̱in xa̱bo̱ numbaa tsí na̱nguá káxi̱in rí ma̱nindxu̱ún tsí juya̱ idxu̱ún dxakuun, xómáꞌ ajngáa rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ rá, rí ni̱ꞌkha̱ nda̱wa̱á, niꞌgíi̱ A̱dée Ana̱ꞌlóꞌ tsí jámuu ni̱gu̱ma-káxi̱i̱ rí ma̱nindxu̱u̱ tsí jayá idxu̱ún dxakuun.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s">Tsí naꞌthán-mbáá numalóꞌ ná inuu Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ mbá awan nuxe̱ꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />Rí mbá xúgíí rí naguwa ruꞌthánlóꞌ ñajuun ríge̱ꞌ: rí guaꞌdaalóꞌ mbáa tsí jayá idxu̱ún dxakuun tsí xkuaꞌnii, jamí ni̱gi̱ꞌi̱i̱ ná ñawún mújúun Ana̱ꞌlóꞌ ná mikhuíí. <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />Ikhaa̱ ñajuu̱n dxakuun ná awúun guꞌwá dxákuun drígo̱o̱ Ana̱ꞌlóꞌ rí phú ikhaa, rí tágu̱ma ga̱jma̱á ñawúún xa̱bo̱ numbaa, rí jmína̱a̱ꞌ máꞌ Ana̱ꞌlóꞌ nikúxe̱ ne̱.<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />Jámba̱a̱ tsí jayá idxu̱ún dxakuun ná numbaa ríge̱ꞌ, na̱gi̱ꞌi̱i̱ rí maxnáxi̱i̱ tsi̱gi̱jña̱ꞌ jamí xu̱kú tsí ma̱ja̱ñúú ná inuu Ana̱ꞌlóꞌ. Ikhaa jngó ndaꞌyóo rí Jesukrísto̱ ma̱gi̱ꞌdoo̱ tháan rí maxnáxi̱i̱ mangaa̱. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />Xí ná numbaa ríge̱ꞌ xtáa̱ mangaa̱, ni ra̱ꞌkháa máꞌ dxakuun ñajuu̱n xúꞌkhue̱n rá, numuu rí júwa̱ꞌ máꞌ ná numbaa ríge̱ꞌ dxakuun tsí nu̱xna̱xí tsi̱gi̱jña̱ꞌ xómá naꞌthán xtángoo drígo̱o̱ Moisés. <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />Dxakuun tsí júwa̱ꞌ ná numbaa ríge̱ꞌ nu̱ñajun ná awúun xtiꞌkhuu jamí nákoo rí ríga̱ ná mikhuíí. Ga̱jma̱á numuu rúꞌkhue̱n waꞌtháán Moisés nákhí rí inu magíꞌdu̱u̱n ma̱ꞌnii̱ guꞌwá dxákuun xtíin: «A̱tia̱wa̱án lá rí ma̱tha̱ne̱ ne̱ xómá jaꞌnii xkri̱doo rí wasngájmaaꞌ ná inuu júba̱».<note caller="+" style="f"><char style="fr" closed="false">8.5 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ xó nigájna̱á xa̱bo̱ 25.40.</char></note> <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />Ikhaa jngó, i̱tha̱án máján ñajuun dxakuun rí naꞌne Jesús, xúꞌkhue̱n máꞌ naꞌthán-mbáa̱ numalóꞌ ná inuu Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ mbá awan rí i̱tha̱án máján, numuu rí gíꞌdoo nakhúu ne̱ ná tsu̱du̱u̱ rí i̱tha̱án máján nixuda-mina̱ꞌ Ana̱ꞌlóꞌ.<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />Xí numuu rí káxe̱ máꞌ awan rí nixná Ana̱ꞌlóꞌ nákhí rí ginii, ma̱xáꞌyóo máꞌ ma̱ꞌkha̱ i̱mba̱ awan xúꞌkhue̱n rá. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />I̱ndo̱ó máꞌ numuu rí nákhí rí Ana̱ꞌlóꞌ niríñúú xa̱bo̱ Israél, xáꞌnii niꞌthúu̱n:</para>
  <para style="q" vid="HEB 8:8">«Xáꞌnii iꞌthán Táta̱: Ma̱ga̱nú mbiꞌi</para>
  <para style="q" vid="HEB 8:8">rí ma̱gúꞌdo̱ꞌ mbá awan nuxe̱ꞌ gajmíꞌ xa̱bi̱i Israél jamí xa̱bi̱i Judá.<verse eid="HEB 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HEB 8:9" />Náxáꞌne xómá awan rí nigúꞌdo̱ꞌ gajmíꞌ táta̱-xi̱ꞌñálaꞌ wajyúú,</para>
  <para style="q" vid="HEB 8:9">nákhí nimbáñúu̱ rí ma̱ga̱jnáa̱ ná Ejípto̱.</para>
  <para style="q" vid="HEB 8:9">Numuu rí táta̱-xi̱ꞌñálaꞌ túne̱-mbáníi̱ awan rí nigúꞌdo̱ꞌ gajmíꞌ,</para>
  <para style="q" vid="HEB 8:9">ikhaa jngó nánguá máꞌ nimakuꞌ mangúúnꞌ rí ma̱mbáñúu̱, xkuaꞌnii iꞌthán Táta̱.<verse eid="HEB 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HEB 8:10" />Ikhaa numuu rúꞌkhue̱n, awan ríge̱ꞌ ma̱gúꞌdo̱ꞌ gajmíꞌ xa̱bi̱i Israél,</para>
  <para style="q" vid="HEB 8:10">ído̱ gága̱nú mbiꞌi rúꞌkhue̱n, xkuaꞌnii iꞌthán Táta̱:</para>
  <para style="q" vid="HEB 8:10">Ma̱gíwa̱nꞌ xtángoo drígo̱ꞌ ná awúun ju̱múu̱,</para>
  <para style="q" vid="HEB 8:10">jamí ma̱tháán ne̱ ná awúun a̱kuíi̱n.</para>
  <para style="q" vid="HEB 8:10">Ikhúúnꞌ ma̱nindxu̱ꞌ Anúu̱,</para>
  <para style="q" vid="HEB 8:10">jamí ikhii̱n ma̱nindxúu̱n xa̱bo̱ xuajñuꞌ.<verse eid="HEB 8:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HEB 8:11" />Jamí nimbáa náxáꞌsngóo dxájuu,</para>
  <para style="q" vid="HEB 8:11">ni máꞌ nimbáa náxáꞌthúun dxíyo̱o̱: “Athane̱-nuwiin Táta̱”.</para>
  <para style="q" vid="HEB 8:11">Numuu rí mbá xúgíi̱n máꞌ mune̱-nuwúu̱n,</para>
  <para style="q" vid="HEB 8:11">mbá xúgíin e̱je̱n jamí mbá xúgíin xa̱bo̱ buanuu.<verse eid="HEB 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HEB 8:12" />Numuu rí ma̱ne̱ mba̱a̱ a̱kui̱nꞌ ja̱yo̱o̱ rí ra̱máján nini̱i̱,</para>
  <para style="q" vid="HEB 8:12">jamí ni miꞌtsú náxármáꞌáan a̱kui̱nꞌ ja̱yo̱o̱ aꞌkhúu̱n ni máꞌ rí xkawe̱ꞌ nini̱i̱».<note caller="+" style="f"><char style="fr" closed="false">8.8-12 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «ni máꞌ rí xkawe̱ꞌ nini̱i̱». Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Jeremía̱s 31.31-34.</char></note><verse eid="HEB 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13" />Ído̱ naꞌthán Ana̱ꞌlóꞌ rí «awan nuxe̱ꞌ» ñajuun ríge̱ꞌ, naꞌthée̱n rí neꞌne wayuu máꞌ rí ginii. Xí neꞌne wayuu jamí níjmaa máꞌ rí ginii, inu máꞌ ma̱mbáa ne̱ xúꞌkhue̱n rá.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s">Xáne kixnáxe̱ tsi̱gi̱jña̱ꞌ ná guꞌwá dxákuun xtíin rí neꞌne Moisés wajyúú</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />Nákhí rí Ana̱ꞌlóꞌ neꞌne awan rí ginii, nixnée̱ xtángoo xáne ma̱gu̱ma guꞌwá ná ma̱gu̱ma-mba̱a̱ mbayíí ge̱jyoꞌ. <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />Xáꞌnii niwiꞌtháa guꞌwá dxákuun xtíin rúꞌkhue̱n nákhí ni̱gu̱ma: awúun ne̱ rí ginii jayu mbiꞌyuu Ná rí Tsúꞌkhaa. Ikhín ni̱we̱je̱ ajwa̱nꞌ ná na̱rigu agu ma̱ꞌne mbiꞌi, jamí ni̱we̱je̱ mbá xapa nakhú ná nitráma guma rí kixnáxe̱ ná inuu Ana̱ꞌlóꞌ. <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />Ná tsu̱du̱u̱ xtíin rí riajma̱ kra̱jngaa, ikhín neꞌne mbiꞌyuu Ná rí I̱tha̱án Tsúꞌkhaa. <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />Ikhín ni̱gi̱ꞌda̱ꞌ ixe̱ rí nigu̱u̱ ajwa̱nꞌ mo̱jmo̱ꞌ tsu̱du̱u̱ ná na̱gu̱ma gúní wájya jamí mangaa máꞌ ni̱gi̱da̱ꞌ e̱jnu̱u̱ awan rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ, rí nigu̱u̱ ajwa̱nꞌ mo̱jmo̱ꞌ tsu̱du̱u̱ jamí awúun. Ná e̱jna̱ ni̱gi̱wa̱nꞌ mbá raya ajwa̱nꞌ mo̱jmo̱ꞌ rí gati ganitsu rí mbiꞌyuu maná. Ikhín máꞌ gíwa̱nꞌ ixe̱ rí ni̱gi̱da̱ꞌ ñawúun Aarón rí nirudu-ráma̱a, jamí xapa itsí ná ka̱ma xtángoo awan rí neꞌne Ana̱ꞌlóꞌ. <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />Ná tsu̱du̱u̱ e̱jna̱ rúꞌkhue̱n nitráma xtiꞌkhúún ánje̱l tsí mbiꞌñúú kerubíín, tsí nu̱snga̱jma rí ikhín xtáa Ana̱ꞌlóꞌ, jamí nu̱rugua-rámáa̱ ga̱jma̱á xpípíi̱n rawuun e̱jna̱ ná naꞌne mba̱a̱ a̱kui̱in Ana̱ꞌlóꞌ jaꞌyoo aꞌkhán. I̱ndo̱ó máꞌ numuu rí ma̱xáxóo mu̱ꞌthán-makalóꞌ ga̱jma̱á numuu rúꞌkhue̱n rí xúge̱ꞌ.<verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />Xkuaꞌnii jaꞌnii nitriga̱ mbá xúgíí rúꞌkhue̱n ná awúun guꞌwá dxákuun xtíin wajyúú. Ná rí Tsúꞌkhaa na̱tu̱ꞌu̱ún dxakuun tsitsíí rí mune̱-mba̱a̱ Ana̱ꞌlóꞌ. <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />Xómáꞌ Ná rí I̱tha̱án Tsúꞌkhaa rá, i̱ndo̱ó máꞌ tsí jayá idxu̱ún dxakuun na̱to̱ꞌo̱o̱ ikhín mbóó miꞌtsú mbá tsigu. Gíꞌmaa rí mbayée̱ iꞌdiúún xu̱kú maxnáxi̱i̱ ná inuu Ana̱ꞌlóꞌ kajngó marngudi̱i aꞌkhúu̱n jamí aꞌkhúún xa̱bo̱ xuajen rí túyáa̱ nini̱i̱. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />Ga̱jma̱á majñu̱u̱ ríge̱ꞌ naꞌsngálóꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ awúun máꞌ rí xóó ꞌgí Ná rí Tsúꞌkhaa awúun guꞌwá dxákuun xtíin, xóó máꞌ táma̱ꞌthoo jamba̱a̱ Ná rí I̱tha̱án Tsúꞌkhaa. <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />Mbá xúgíí rúꞌkhue̱n naꞌsngálóꞌ rí mbiꞌi xúge̱ꞌ, rí tsi̱gi̱jña̱ꞌ jamí xuñúú xu̱kú tsí nijáñúú rí kixnáxe̱ ikhín, na̱nguá gíꞌdoo ne̱ tsiakhe̱ rí ma̱ꞌne káxe̱ ne̱ a̱kui̱ín xa̱bo̱ tsí nune̱-mba̱a̱ Ana̱ꞌlóꞌ xkuaꞌnii. <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />Numuu rí xúgíí rúꞌkhue̱n naꞌthán i̱ndo̱ó máꞌ numuu ganitsu, numuu iya, jamí numuu mbaꞌa inii xómá rí ma̱ꞌne-jaꞌwu-mina̱aꞌ xa̱bo̱. Xtángoo rúꞌkhue̱n gíꞌdoo numuu ne̱ asndo mbiꞌi rí Ana̱ꞌlóꞌ mariꞌkhu̱u ne̱.<verse eid="HEB 9:10" /></para>
  <para style="s">I̱tha̱án gíꞌdoo numuu iꞌdiuu Krísto̱ xó rí iꞌdiúún xu̱kú</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />Xómáꞌ Krísto̱ ni̱ꞌkhe̱e̱ máꞌ, jamí ikhaa̱ ñajuu̱n tsí jayá idxu̱ún dxakuun ga̱jma̱á numuu mbá xúgíí rí máján guáꞌdáálóꞌ xúge̱ꞌ. Ikhaa̱ ni̱to̱ꞌo̱o̱ ná awúun guꞌwá dxákuun rí i̱tha̱án máján jamí i̱tha̱án káxe̱, rí túne̱-ku̱maa xa̱bo̱ numbaa. Rúꞌkhue̱n iꞌthán rí ra̱ꞌkhá ná numbaa ríge̱ꞌ ríga̱ ne̱. <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />Krísto̱ ni̱to̱ꞌo̱o̱ mbóó miꞌtsú Ná rí I̱tha̱án Tsúꞌkhaa, jamí jámuu gíꞌdoo numuu rí nixnáxi̱i̱ ikhín. Ni̱to̱ꞌo̱o̱ gáxnáxi̱i̱ iꞌdiuu̱ máꞌ ikhaa̱, ra̱ꞌkhá iꞌdiúún tso̱toon jamí iꞌdiúún i̱jín-xédé. Xkuaꞌnii neꞌtse̱-ri̱ñáa̱ꞌlóꞌ jámuu. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />Gakon máꞌ rí iꞌdiúún xede̱, tso̱toon, jamí idiuu a̱ꞌdá-xédé gu̱mba tsí nakha-rámaa, ído̱ rí na̱díngaa ne̱ ná tsu̱du̱ún xa̱bo̱ tsí ra̱jáꞌwuun, gíꞌdoo ne̱ tsiakhe̱ rí ma̱ꞌne-jaꞌwu̱u xuñúu̱. <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />I̱ndo̱ó máꞌ numuu rí i̱tha̱án máꞌ gíꞌdoo tsiakhe̱ iꞌdiuu Krísto̱, tsí nda̱a̱ nitháan aꞌkhúun, jamí nixnáxe̱-mina̱ꞌ ná inuu Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ, tsí ndaꞌya jámuu. Ga̱jma̱á majñu̱u̱ iꞌdiuu Krísto̱ na̱gu̱ma-jaꞌwu̱u a̱kia̱nꞌlóꞌ ná inuu aꞌkhánlóꞌ rí na̱ka̱ jaguáanꞌlóꞌ ná ma̱ja̱ñálóꞌ, kajngó ma̱goo mu̱ꞌne̱-mba̱a̱lóꞌ Ana̱ꞌlóꞌ tsí xtáa ndaꞌya jámuu.<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />Ikhaa jngó, Krísto̱ ñajuun tsí naꞌthán-mbáá numalóꞌ ná inuu Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ mbá awan nuxe̱ꞌ. Jamí ga̱jma̱á majñu̱u̱ rí nijáñuu̱, naꞌne mba̱a̱ a̱kui̱in Ana̱ꞌlóꞌ jaꞌyoo aꞌkhánlóꞌ rí ni̱xu̱ꞌdá-mijnálóꞌ ga̱jma̱á numuu awan rí ginii, kajngó tsáanꞌ watraꞌwiáanꞌlóꞌ mu̱drígúlóꞌ jámuu rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ.<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />Ído̱ rí ríga̱ mbá i̱yi̱i̱ꞌ rí naꞌthán xáne ma̱wiꞌtháa drígo̱o̱ mbáa xa̱bo̱, ndaꞌyóo rí ma̱ja̱ñúu̱ ginii kajngó ma̱gi̱ꞌdoo numuu i̱yi̱i̱ꞌ rúꞌkhue̱n. <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />Numuu rí i̱yi̱i̱ꞌ rí naꞌthán xáne ma̱wiꞌtháa drígo̱o̱ mbáa xa̱bo̱, gíꞌdoo numuu ne̱ xí nijáñuu̱ máꞌ. Jamí ra̱gíꞌdoo numuu ne̱ xí xóó xtáa̱ ndaꞌyee̱. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />Ikhaa numuu rúꞌkhue̱n, nákhí rí ni̱gi̱ꞌdu̱u̱n ni̱gi̱ꞌdoo numuu awan rí ginii, ni̱ga̱dí-rámuu iꞌdi mangaa. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />Ído̱ wámbo̱o̱ Moisés niꞌthán-rúꞌúún xa̱bo̱ Israél mbá xúgíí rí naꞌthán xtángoo, a̱ꞌkhue̱n nigánda̱wo̱o̱ꞌ iꞌdiúún xede̱ jamí iꞌdiúún tso̱toon ga̱jma̱á yaꞌsi. A̱ꞌkhue̱n nijmuu̱ mogo̱ maña̱ꞌ jamí xkuíyo̱o̱ iná isópo̱ rí mastíngaa̱ ne̱ ná tsu̱du̱u̱ i̱yi̱i̱ꞌ xtángoo jamí ná tsu̱du̱ún mbá xúgíin xa̱bo̱ xuajen. <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />Jamí niꞌthúu̱n xa̱bo̱: «Ríge̱ꞌ ñajuun iꞌdiuu awan rí nandoo Ana̱ꞌlóꞌ rí mu̱ne̱-mbáníílaꞌ».<note caller="+" style="f"><char style="fr" closed="false">9.20 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ xó nigájna̱á xa̱bo̱ 24.8.</char></note> <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />Xúꞌkhue̱n máꞌ mangaa, ni̱rmu̱juu̱n ga̱jma̱á iꞌdi guꞌwá dxákuun xtíin jamí mbá xúgíí rí najmaa ná awúun ne̱. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />Ná awúun xtángoo naꞌthán rí asndo xómá rí mbá xúgíí jayu ndaꞌyóo rí ma̱gu̱ma-jaꞌwu̱u ga̱jma̱á iꞌdi. Ikhaa jngó xí tsíga̱dí-rámuu iꞌdi, tsíꞌne mba̱a̱ a̱kui̱in Ana̱ꞌlóꞌ jaꞌyoo aꞌkhán.<verse eid="HEB 9:22" /></para>
  <para style="s">Ana̱ꞌlóꞌ narngudi̱i aꞌkhánlóꞌ numuu rí nijáñuu Krísto̱</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />Ikhaa jngó ndiꞌyóo rí xkuaꞌnii gágu̱ma-jaꞌwu̱u guꞌwá-xtíin ná ni̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ, numuu rí mbá xúgíí rúꞌkhue̱n ñajuun xtiꞌkhuu rí ríga̱ ná mikhuíí. Xómáꞌ rí ríga̱ ná mikhuíí rá, i̱tha̱án máꞌ máján tsi̱gi̱jña̱ꞌ ndaꞌyóo rí ma̱gu̱ma-jaꞌwu̱u ga̱jma̱á ne̱ ikhaa. <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />Numuu rí táto̱ꞌo̱o̱ Krísto̱ ná awúun guꞌwá-xtíin ná na̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ rí nene̱ xa̱bo̱ numbaa, rí ni̱to̱ꞌo̱o̱ ná awúun rí phú gakon. Mbáko máꞌ ni̱to̱ꞌo̱o̱ Krísto̱ asndo mikhuíí kajngó maxnáxe̱-mine̱e̱ꞌ ná inuu Ana̱ꞌlóꞌ ga̱jma̱á numalóꞌ, jamí ikhín xtáa̱ xúge̱ꞌ. <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />Jamí táto̱ꞌo̱o̱ rí maxnáxe̱-mine̱e̱ꞌ mbámbá tsigu ga̱jma̱á iꞌdiuu i̱mba̱a̱ꞌ, xómá eꞌne tsí jayá idxu̱ún dxakuun Ná rí I̱tha̱án Tsúꞌkhaa rí ꞌgí ná numbaa ríge̱ꞌ. <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />Xí xkuaꞌnii máꞌ ndaꞌyóo rí ma̱ꞌne Krísto̱ mangaa, mba̱ꞌyóo rí ma̱ja̱ñúu̱ mbaꞌa nothon asndo nákhí neꞌne-ku̱maa Ana̱ꞌlóꞌ numbaa xúꞌkhue̱n rá. Xómáꞌ xúge̱ꞌ rá, awúun mbiꞌi rí inu máꞌ na̱ka̱-rayámba̱ numbaa ríge̱ꞌ, ni̱ꞌkha̱ Krísto̱ rí maxnáxe̱-mina̱ꞌ ma̱ja̱ñúu mbóó miꞌtsú asndo jámuu ga̱jma̱á numuu aꞌkhánlóꞌ. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />Xómá rí mbóó miꞌtsú wéje̱ rí ma̱ja̱ñúu xa̱bo̱ numbaa, jamí nda̱wa̱á a̱ꞌkhue̱n ma̱to̱ꞌo̱o̱ awan ga̱jma̱á numuu̱, <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />xkuaꞌnii máꞌ mangaa mbóó miꞌtsú nixnáxe̱-mina̱ꞌ Krísto̱ rí ma̱ja̱ñúu kajngó Ana̱ꞌlóꞌ ma̱ꞌne mba̱a̱ a̱kui̱in jaꞌyoo aꞌkhúún mbaꞌiin xa̱bo̱. Jamí ma̱ꞌkhe̱e̱ mbu̱júꞌ, nákha rí ma̱ja̱ñúu̱ numuu aꞌkhánlóꞌ, rí ma̱ꞌkhe̱e̱ ma̱ꞌne-jáwíi̱n tsí guáꞌthíi̱n.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="s">Mbóó miꞌtsú nijáñuu Krísto̱ ga̱jma̱á numuu aꞌkhán</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />Rí xtángoo drígo̱o̱ Moisés, xómá mbá nákoo rí máján ma̱ꞌkha̱ nda̱wa̱á ñajuun ne̱, ra̱ꞌkháa máꞌ rí phú gakon. Ikhaa jngó, tsíꞌngo̱o̱ ne̱ gáꞌne-káxi̱in xa̱bo̱ tsí naguwá ná inuu Ana̱ꞌlóꞌ mbámbá tsigu rí mu̱xna̱xíi̱ mbámbá miꞌtsú ikhaa máꞌ xuñúú xu̱kú tsí nijáñúú. <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />Xí numuu rí tsi̱gi̱jña̱ꞌ rúꞌkhue̱n naꞌne-káxi̱in xa̱bo̱, náxármáꞌáan máꞌ a̱kuíi̱n rí gíꞌmii̱ aꞌkhán, jamí mu̱ni̱ꞌñáa̱ ru̱xna̱xíi̱ tsi̱gi̱jña̱ꞌ ná inuu Ana̱ꞌlóꞌ xúꞌkhue̱n rá. <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />I̱ndo̱ó máꞌ numuu rí xu̱kú tsí nijáñúú, tsúꞌkhue̱n naꞌne rí mbámbá tsigu ma̱rmáꞌáan a̱kuíi̱n rí gíꞌmii̱ aꞌkhán ná inuu Ana̱ꞌlóꞌ. <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />Numuu rí iꞌdiúún xede̱ jamí tso̱toon tsíꞌngo̱o̱ ne̱ gárngudi̱i aꞌkhán.<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />Ikhaa jngó, nákhí ni̱ꞌkha̱ Krísto̱ ná numbaa ríge̱ꞌ, niꞌthúu̱n Ana̱ꞌlóꞌ:</para>
  <para style="q" vid="HEB 10:5">«Tsíyaaꞌ rí mi̱xnáxi̱in xu̱kú tsí nijáñúú ni máꞌ tsi̱gi̱jña̱ꞌ ná inaaꞌ.</para>
  <para style="q" vid="HEB 10:5">Ikhaa jngó, nithane̱-ku̱maa xuyuꞌ.<verse eid="HEB 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HEB 10:6" />Tsíni̱gua̱a̱ꞌ máꞌ rí mi̱kha-rámii xu̱kú tsí nijáñúú ná inaaꞌ,</para>
  <para style="q" vid="HEB 10:6">ni máꞌ tsíni̱gua̱a̱ꞌ tsi̱gi̱jña̱ꞌ ga̱jma̱á numuu aꞌkhán.<verse eid="HEB 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HEB 10:7" />Ikhaa jngó ni̱tha̱nlo̱ꞌ: “Táta̱ Mikhuíí, ge̱jyoꞌ xtáá,</para>
  <para style="q" vid="HEB 10:7">kajngó ma̱ne̱ rí naꞌne a̱kia̱anꞌ.</para>
  <para style="q" vid="HEB 10:7">Xómá ka̱ma naꞌthán ná i̱yi̱i̱ꞌ rí jambúxu̱u̱ꞌ ga̱jma̱á numuꞌ”».<note caller="+" style="f"><char style="fr" closed="false">10.5-7 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 40.6-8.</char></note><verse eid="HEB 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 10:8" />Ginii niꞌthée̱n: «Tsíyaaꞌ rí mi̱xnáxi̱in xu̱kú tsí nijáñúú ni máꞌ tsi̱gi̱jña̱ꞌ ná inaaꞌ, xúꞌkhue̱n máꞌ tsíni̱gua̱a̱ꞌ rí mi̱kha-rámii xu̱kú tsí nijáñúú ná inaaꞌ, ni máꞌ tsi̱gi̱jña̱ꞌ ga̱jma̱á numuu aꞌkhán», maske máꞌ xtángoo naꞌthán rí mi̱xnáxe̱ mbá xúgíí rúꞌkhue̱n. <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />A̱ꞌkhue̱n niꞌthée̱n xóó: «Táta̱ Mikhuíí, ge̱jyoꞌ xtáá, kajngó ma̱ne̱ rí naꞌne a̱kia̱anꞌ». Xkuaꞌnii kajngó Ana̱ꞌlóꞌ nirígúu awan rí wayuu, a̱ꞌkhue̱n niꞌgíi̱ awan rí nuxe̱ꞌ. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />Ikhaa jngó na̱ka̱-ra̱gu̱ma-jaꞌwáanꞌlóꞌ, numuu rí Krísto̱ niꞌnii̱ rí nandoo Ana̱ꞌlóꞌ nákhí nixnáxe̱-mine̱e̱ꞌ rí ma̱ja̱ñúu̱. Mbóó miꞌtsú nijáñuu̱ jamí jámuu gíꞌdoo numuu ne̱.<verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />Jamí gakon máꞌ rí jámba̱a̱ dxakuun tsitsíí wéje̱ inuu̱ rí maxnáxi̱i̱ mbaꞌa miꞌtsú ikhaa máꞌ xuñúú xu̱kú tsí nijáñúú, rí ni miꞌtsú tsíꞌngo̱o̱ gárngudi̱i aꞌkhán. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />Xómáꞌ Krísto̱ rá, mbóó miꞌtsú nixnáxi̱i̱ mbóó tsi̱gi̱jña̱ꞌ ga̱jma̱á numuu aꞌkhán jamí jámuu gíꞌdoo numuu ne̱. Nda̱wa̱á a̱ꞌkhue̱n ni̱gi̱ꞌi̱i̱ ná ñawún mújúun Ana̱ꞌlóꞌ. <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />Jamí ikhín máꞌ ꞌgíi̱ gíꞌthu̱u̱n, asndo ma̱ga̱nú mbiꞌi rí Ana̱ꞌlóꞌ maskuíji̱in xa̱bo̱ sia̱nꞌ drígo̱o̱ ná agoo nakhúu̱. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />Numuu rí ga̱jma̱á majñu̱u̱ mbóó tsi̱gi̱jña̱ꞌ neꞌne-káxii̱n jámuu tsí ikhaa̱ na̱ka̱-raꞌne-jaꞌwuu̱n. <verse eid="HEB 10:14" /><verse number="15" style="v" sid="HEB 10:15" />Jamí ikhaa máꞌ rúꞌkhue̱n naꞌthánlóꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ mangaa, ído̱ naꞌthán:<verse eid="HEB 10:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HEB 10:16" />«Awan ríge̱ꞌ ma̱gúꞌdo̱ꞌ gajmíꞌ</para>
  <para style="q" vid="HEB 10:16">ído̱ gága̱nú mbiꞌi rúꞌkhue̱n, xkuaꞌnii iꞌthán Táta̱:</para>
  <para style="q" vid="HEB 10:16">Ma̱gíwa̱nꞌ xtángoo drígo̱ꞌ ná awúun a̱kuíi̱n,</para>
  <para style="q" vid="HEB 10:16">jamí ma̱tháán ne̱ ná awúun ju̱múu̱».<note caller="+" style="f"><char style="fr" closed="false">10.16 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Jeremía̱s 31.33.</char></note></para>
  <para style="m" vid="HEB 10:16">Jamí naꞌthée̱n xóó:<verse eid="HEB 10:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="HEB 10:17" />«Ni miꞌtsú ma̱xármáꞌáan a̱kui̱nꞌ ja̱yo̱o̱ aꞌkhúu̱n ni máꞌ rí ra̱máján nini̱i̱».<note caller="+" style="f"><char style="fr" closed="false">10.17 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Jeremía̱s 31.34. </char></note><verse eid="HEB 10:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="HEB 10:18" />Numuu ído̱ rí neꞌne mba̱a̱ a̱kui̱in máꞌ Ana̱ꞌlóꞌ jaꞌyoo aꞌkhánlóꞌ, nánguá máꞌ iꞌyóo rí mi̱xnáxe̱ i̱mba̱ tsi̱gi̱jña̱ꞌ ga̱jma̱á numuu aꞌkhán.<verse eid="HEB 10:18" /></para>
  <para style="s">Ndaꞌyóo rí ma̱wajún-gúkuálóꞌ</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />Ikhaa numuu rúꞌkhue̱n, a̱ngui̱nꞌ, xúge̱ꞌ rí ma̱goo ma̱ta̱ꞌa̱ꞌlóꞌ ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ Ná rí I̱tha̱án Tsúꞌkhaa rá, ga̱jma̱á numuu iꞌdiuu Jesús rí ni̱ga̱díí nákhí nijáñuu̱. <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />Ikhaa̱ nirmáꞌthoo̱ mbá jamba̱a̱ nuxe̱ꞌ jamí rí ndaꞌya rí mbayá ikhalóꞌ, rí nanújngoo ná majñu̱u̱ xtíin rí kra̱jngaa, numuu rí xtíin rúꞌkhue̱n naꞌne xtiꞌkhuu xuyuu̱. <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />Ikháánꞌlóꞌ, tsáanꞌ xa̱bo̱ guꞌwóo Ana̱ꞌlóꞌ ñajwanlóꞌ, guaꞌdaalóꞌ mbáa tsí jayá idxu̱ún dxakuun tsí maphú gíꞌdoo numuu. <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />Ikhaa jngó, mbá jañii a̱kia̱nꞌlóꞌ gúxu̱ꞌmá-mijnálóꞌ ná inuu̱, jamí mbá jañii a̱kia̱nꞌlóꞌ gánimba̱ꞌlóꞌ juꞌyáa̱. Numuu rí ni̱gu̱ma-jaꞌwu̱u máꞌ a̱kia̱nꞌlóꞌ nákhí rí ni̱gata̱a mbá xúgíí rí xkawe̱ꞌ, jamí rí nigaꞌwu̱u máꞌ xuyalóꞌ ga̱jma̱á iya jaꞌwu. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />Ga̱wajún-gúkuálóꞌ jamí ma̱xáꞌne a̱jma̱ a̱kia̱nꞌlóꞌ inuu mbá xúgíí rí nanimba̱ꞌlóꞌ ga̱jma̱á numuu Ana̱ꞌlóꞌ, ná ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ guáꞌthi̱ínlóꞌ, numuu rí phú jmbii tsí nixuda-mina̱ꞌ. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />Ga̱xná-gamiéjwanlóꞌ rí mu̱mbáyú-mijnálóꞌ kajngó ma̱wa̱ꞌa̱ a̱kia̱nꞌlóꞌ rí ma̱galóꞌ juꞌñúú xa̱bo̱ jamí rí mu̱ꞌne̱lóꞌ rí máján. <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />Mu̱xúꞌyá-ri̱dúúnlóꞌ mbá tikhuun tsí naguꞌwúún máꞌ rí nánguá igóó ná na̱gi̱mbíin a̱ngia̱nꞌlóꞌ, rí a̱gi̱mbáanꞌlóꞌ gajmiálóꞌ a̱ngia̱nꞌlóꞌ kajngó mu̱xprígú-mijnálóꞌ, i̱wa̱á máꞌ xúge̱ꞌ rí nduꞌyáálóꞌ rí nangiyuu máꞌ mbiꞌi rí Ana̱ꞌlóꞌ maxúdaa awan ga̱jma̱á numúú xa̱bo̱.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />Xí nu̱ꞌne̱-ñajwanlóꞌ máꞌ xúꞌkhue̱n aꞌkhán tsáanꞌ ne̱ꞌne̱-nuwiinlóꞌ máꞌ rí gakon, nánda̱a̱ tsi̱gi̱jña̱ꞌ rí ma̱goo mi̱xnáxe̱ ga̱jma̱á numuu aꞌkhánlóꞌ. <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />Rí i̱ndo̱ó máꞌ ga̱jma̱á ngamí mu̱waꞌthi̱ínlóꞌ rí ma̱to̱ꞌo̱o̱ awan ga̱jma̱á numalóꞌ, mbiꞌi rí mi̱khiin ga̱jma̱á agu xa̱bo̱ sia̱nꞌ drígo̱o̱ Ana̱ꞌlóꞌ. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />Xí a̱jmi̱i o atsúun xa̱bo̱ ndiyáá rí mbáa xa̱bo̱ na̱nguá ndiyoo gáꞌne-mbánuu xtángawoo Moisés, xa̱bo̱ tsí nu̱xu̱da̱a̱ꞌ awan na̱nguá iñáwíin a̱kuíi̱n rí mu̱xna̱xíi̱ xa̱bo̱ tsúꞌkhue̱n rí ma̱ja̱ñúu. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />Á ra̱ꞌkhá i̱tha̱án mba̱a̱ jamínu̱ꞌ ma̱grui̱gú xa̱bo̱ tsí natsíjmaa A̱dée Ana̱ꞌlóꞌ, tsíya-makuu rí nijáñuu̱, jamí naꞌne-ñawúu̱n Xu̱u̱ꞌ Ana̱ꞌlóꞌ tsí nandoo jaꞌyoo̱, i̱ju̱ma̱ꞌlaꞌ rá. Numuu rí ga̱jma̱á majñu̱u̱ iꞌdiuu Krísto̱ ni̱gu̱ma-jaꞌwii̱ rí ma̱ꞌnii̱ ñajuun Ana̱ꞌlóꞌ jamí ni̱gu̱ma-mbáníí awan nuxe̱ꞌ. <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />Numuu rí nduꞌyáálóꞌ máꞌ rí Ana̱ꞌlóꞌ niꞌthán: «Ikhúúnꞌ ma̱rthanga̱alo̱ꞌ rí nune̱ xa̱bo̱. Ikhúúnꞌ máꞌ ma̱ne̱-numa̱alo̱ꞌ mbámbáa».<note caller="+" style="f"><char style="fr" closed="false">10.30 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yi̱i̱ꞌ rí naꞌthán ikhaa máꞌ xtángoo 32.35.</char></note> Jamí niꞌthée̱n mangaa: «Ikhúúnꞌ ma̱xu̱ꞌdáa awan ga̱jma̱á numúú xa̱bo̱ xuajñuꞌ».<note caller="+" style="f"><char style="fr" closed="false">10.30 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yi̱i̱ꞌ rí naꞌthán ikhaa máꞌ xtángoo 32.36.</char></note> <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />¡Á tháán mingínáaꞌlóꞌ xí magatuwáanꞌlóꞌ rí maxpátháanꞌlóꞌ Ana̱ꞌlóꞌ, tsí xtáa ndaꞌya jámuu rá!<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />Ga̱rmáꞌáan a̱kia̱nꞌlaꞌ ju̱ya̱á mbiꞌi rí ninújngoo máꞌ, nákhí rí ni̱kú máꞌ nimbiꞌyalaꞌ. Maske máꞌ mbaꞌa inii jamínu̱ꞌ ni̱ꞌkha̱ ná inalaꞌ, ni̱ꞌngo̱o̱ a̱kia̱nꞌlaꞌ ni̱míni̱ílaꞌ jamí niwajúnlaꞌ xa̱ꞌ. <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />Mbá tikhuun tsí ikháanꞌlaꞌ waꞌthán-xkawiu̱únꞌ jamí ni̱gu̱ma-ngíníi ná inúú xa̱bo̱, jamí tsí i̱ꞌwíin nene̱-mijná a̱ngui̱ín tsí na̱gu̱ma-ngíníi xkuaꞌnii. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />Xúꞌkhue̱n máꞌ mangaa, niñáwíin a̱kia̱nꞌlaꞌ ju̱ñu̱ú tsí traꞌi̱in géjwa̱nꞌ, jamí gagi a̱kia̱nꞌlaꞌ ni̱ni̱ꞌñá-mijnálaꞌ rí ma̱ga̱taa dríga̱ꞌlaꞌ, numuu ndu̱ya̱álaꞌ rí i̱tha̱án máján jamí jámuu ríga̱ rí mu̱drígúulaꞌ ná mikhuíí.<verse eid="HEB 10:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="HEB 10:35" />Ikhaa jngó, mu̱xúni̱ꞌñáálaꞌ-raꞌne jañii a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ, numuu rí ikhaa rúꞌkhue̱n ma̱ꞌne rí phú mba̱a̱ rí máján ma̱janálaꞌ. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />I̱ndo̱ó máꞌ ndaꞌyóo rí ma̱ꞌngo̱o̱ a̱kia̱nꞌlaꞌ, kajngó ído̱ rí wámba̱ꞌlaꞌ ne̱ne̱laꞌ rí nandoo Ana̱ꞌlóꞌ, a̱ꞌkhue̱n rí mbu̱ya̱alaꞌ rí nixuda-mine̱e̱ꞌ. <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />Numuu rí naꞌthán ná ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="q" vid="HEB 10:37">«I̱mbá lájwíin máꞌ iꞌyóo</para>
  <para style="q" vid="HEB 10:37">rí ma̱ꞌkha̱ tsí wéje̱ máꞌ rí ma̱ꞌkha̱.</para>
  <para style="q" vid="HEB 10:37">Náxágajyúu̱ máꞌ.<verse eid="HEB 10:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="HEB 10:38" />Xómáꞌ xa̱bo̱ tsí nánda̱a̱ aꞌkhúun,</para>
  <para style="q" vid="HEB 10:38">ma̱xtáa̱ jámuu ga̱jma̱á numuu rí wéje̱ a̱kuii̱n ná inuu Ana̱ꞌlóꞌ.</para>
  <para style="q" vid="HEB 10:38">I̱ndo̱ó máꞌ numuu rí, xí nathangaa̱ rá,</para>
  <para style="q" vid="HEB 10:38">ma̱xáni̱gu̱ꞌ gáꞌnii̱».<note caller="+" style="f"><char style="fr" closed="false">10.38 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Abakúk 2.3-4.</char></note><verse eid="HEB 10:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />Xómáꞌ ikháánꞌlóꞌ rá, ra̱ꞌkhá xa̱bo̱ tsí nathangi̱in jamí nune̱-mbáti̱ga̱-mijná ñajwanlóꞌ, rí xa̱bo̱ tsí wéje̱ a̱kui̱ín ná inuu Ana̱ꞌlóꞌ jamí najáwíin jámuu ñajwanlóꞌ.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s">Xa̱bo̱ tsí ni̱we̱je̱ a̱kui̱ín ná inuu Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />Xa̱bo̱ tsí wéje̱ a̱kui̱in ná inuu Ana̱ꞌlóꞌ, mbá jañii a̱kuii̱n nanimbo̱o̱ꞌ rí ma̱grui̱guíi̱ rí gíꞌthu̱u̱n, xúꞌkhue̱n máꞌ ndaꞌyoo̱ mújúu̱n rí ríga̱ rí tsíkujma mba̱ꞌyoo̱ ga̱jma̱á iduu̱. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />Ga̱jma̱á numuu rí xkuaꞌnii ni̱we̱je̱ a̱kui̱ín táta̱-xi̱ꞌñálóꞌ wajyúú, phú ni̱ni̱gu̱u̱ꞌ Ana̱ꞌlóꞌ jaꞌñúu̱. <verse eid="HEB 11:2" /><verse number="3" style="v" sid="HEB 11:3" />Ga̱jma̱á numuu rí wéje̱ a̱kia̱nꞌlóꞌ ná inuu Ana̱ꞌlóꞌ, nduꞌyáálóꞌ rí ikhaa̱ neꞌne-ku̱maa̱ mbá xúgíí rí ríga̱ ná tsu̱du̱u̱ numbaa ga̱jma̱á majñu̱u̱ ajngóo̱. Ikhaa jngó, rí nandoo nduꞌyáálóꞌ xúge̱ꞌ, ni̱gu̱ma-ku̱maa ne̱ ga̱jma̱á majñu̱u̱ rí tsíkujma nákhí wapha.<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />Ga̱jma̱á numuu rí ni̱we̱je̱ a̱kui̱in Abél ná inuu Ana̱ꞌlóꞌ, i̱tha̱án máꞌ máján tsi̱gi̱jña̱ꞌ nixnáxi̱i̱ ikhaa̱ xó rí Kaín. Ikhaa jngó niꞌthán Ana̱ꞌlóꞌ rí nda̱a̱ aꞌkhúu̱n jamí ni̱grui̱gíi̱ tsi̱gi̱jñu̱u̱ꞌ. Maske máꞌ wajyúú nijáñuu Abél, xóó máꞌ naꞌthánlóꞌ ga̱jma̱á majñu̱u̱ rí ni̱we̱je̱ a̱kuii̱n ná inuu Ana̱ꞌlóꞌ.<verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />Ga̱jma̱á numuu rí ni̱we̱je̱ a̱kui̱in Enók ná inuu Ana̱ꞌlóꞌ, ndaꞌyee̱ ni̱ka̱ jiꞌyáa̱ mikhuíí, jamí nánguá nikujmaa̱ ná numbaa ríge̱ꞌ, numuu rí Ana̱ꞌlóꞌ ni̱ka̱a jayáa̱. Ná i̱yi̱i̱ꞌ ajngáa rawuun Ana̱ꞌlóꞌ naꞌthán rí nákhí xóó táꞌga jiꞌyáa Enók, ni̱ni̱gu̱u̱ꞌ Ana̱ꞌlóꞌ jaꞌyoo̱. <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />Numuu rí ma̱xáxóo rí ma̱ni̱gu̱u̱ꞌ Ana̱ꞌlóꞌ jaꞌyoo xa̱bo̱ tsí na̱nguá wéje̱ a̱kui̱in ná inuu̱. Xí mbáa nandoo rí maxuꞌma-mina̱ꞌ ná inuu Ana̱ꞌlóꞌ, ginii gíꞌmaa ma̱nimbo̱o̱ꞌ rí xtáa Ana̱ꞌlóꞌ, jamí rí naxnúu̱ rí máján tsí nduꞌyáa̱.<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />Ga̱jma̱á numuu rí ni̱we̱je̱ a̱kui̱in Noé ná inuu Ana̱ꞌlóꞌ, nákhí waꞌtháa̱n rí ma̱ri̱gá mbá rí ni miꞌtsú xóó táríga̱, ndiya-makuu̱ Ana̱ꞌlóꞌ jamí ga̱jma̱á ngamí niꞌnii̱ mbá guꞌwá-rguwa ná ma̱jáwíin xa̱bii̱. Ga̱jma̱á numuu rí ni̱we̱je̱ a̱kuii̱n ná inuu Ana̱ꞌlóꞌ, ni̱dri̱gú jamínu̱ꞌ xa̱bo̱ numbaa, jamí ninindxu̱u̱ xa̱bo̱ tsí nánda̱a̱ aꞌkhúun ga̱jma̱á majñu̱u̱ rí ni̱we̱je̱ a̱kuii̱n ná inuu Ana̱ꞌlóꞌ.<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />Ga̱jma̱á numuu rí ni̱we̱je̱ a̱kui̱in Abraám ná inuu Ana̱ꞌlóꞌ, neꞌne-mbánuu̱ nákhí waꞌtháa̱n neꞌne Ana̱ꞌlóꞌ rí ma̱ꞌgee̱ ná ꞌgí mbaa rí ma̱grui̱gúu̱ nda̱wa̱á. Jamí nigájnuu̱ ni̱ke̱e̱, maske máꞌ tsíꞌyoo̱ náá i̱ke̱e̱. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />Ga̱jma̱á numuu rí ni̱we̱je̱ a̱kuii̱n ná inuu Ana̱ꞌlóꞌ, nixtáa̱ xómá xa̱bo̱ tsí na̱ꞌkha̱ i̱mba̱ xuajen ná mbaa rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ rí ma̱janáa̱, asndo xómá rí mbayuu i̱mba̱a̱ꞌ xa̱bo̱. Nixtáa̱ ná awúun guꞌwá-xtíin, xómá rí Isaák ga̱jma̱á Jakób mangiin, tsí ikhaa máꞌ rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxu̱ún. <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />Xkuaꞌnii nixtáa Abraám, numuu rí ni̱gi̱ꞌthu̱u̱n mba̱ꞌyoo̱ xuajen rí ꞌgí jámuu, rí jmína̱a̱ꞌ máꞌ Ana̱ꞌlóꞌ niríya̱ꞌ xkri̱doo jamí neꞌne-mújúun.<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />Ga̱jma̱á numuu rí ni̱we̱je̱ a̱kui̱in Sára̱ mangaa ná inuu Ana̱ꞌlóꞌ, nijanáa̱ tsiakhe̱ rí mago̱-édee̱. Jamí neꞌne-xuajii̱n, maske máꞌ a̱ꞌgo̱ tsí tsíꞌne-xuajen jamí nána̱-xíñu guéño máꞌ ñajuu̱n, numuu rí ninimbo̱o̱ꞌ rí kuwiin tsí nixuda-mina̱ꞌ ga̱jma̱á nindxu̱u̱. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />Ikhaa jngó, maske máꞌ phú nikhi̱i̱ Abraám, jamí inu máꞌ ma̱ja̱ñúu̱, maphú mbaꞌiin mi̱ndaꞌkho xa̱bo̱ ri̱jyu̱u̱ꞌ ni̱gu̱mii, xómá a̱ꞌgua̱án jamí xómá we̱ꞌe̱ rí ríga̱ ná rawuun iya a̱pha̱, rí nimbáa tsíꞌngo̱o̱ gágu̱xnuu.<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />Mbá xúgíin xa̱bo̱ tsíge̱ꞌ ni̱we̱je̱ a̱kuíi̱n ná inuu Ana̱ꞌlóꞌ, jamí xkuaꞌnii asndo nijáñúu̱, jamí túdri̱guíi̱ rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ rí ma̱janúu̱. I̱ndo̱ó máꞌ numuu rí ni̱we̱je̱ a̱kuíi̱n ná inuu Ana̱ꞌlóꞌ ikhaa jngó asndo nákhí máꞌ tsíngua̱ꞌ ndiyáa̱ ne̱ jamí ni̱ya̱xíi̱ ne̱. A̱ꞌkhue̱n nithee̱n rí ra̱ꞌkhá xuajñúu̱ ñajuun numbaa ríge̱ꞌ, rí xa̱bo̱ tsí nagóó-ranújngúún ñajúu̱n. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />Rí xkuaꞌnii nithee̱n, jaꞌwu máꞌ ni̱snga̱jmee̱ rí ngrigúu̱n nduꞌyée̱ numbaa ná ma̱ꞌne xuajñúu̱. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />Xí numuu rí ni̱ndxa̱ꞌwa̱-mijnée̱ rí xuajñúu̱ ñajuun numbaa ná nigájnúu̱, asndo wapha máꞌ nithangii̱n ikhín. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />Xómáꞌ ikhii̱n ndiñúu̱ mbá xuajen rí i̱tha̱án mitsaan, rí ꞌgí ná mikhuíí. Ikhaa numuu rúꞌkhue̱n, tsíti̱yu̱u̱ꞌ Ana̱ꞌlóꞌ rí ma̱nindxu̱u̱ Anúu̱, numuu rí neꞌne-mújúu̱n xuajñúú tsúꞌkhue̱n ná mikhuíí.<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />Ga̱jma̱á numuu rí ni̱we̱je̱ a̱kui̱in Abraám ná inuu Ana̱ꞌlóꞌ, nixnáxi̱i̱ Isaák xómá tsi̱gi̱jña̱ꞌ, nákhí rí Ana̱ꞌlóꞌ ndiyoo mba̱ꞌyoo xí jañii a̱kuii̱n. Inu máꞌ xtáa̱ rí maxnáxi̱i̱ a̱dée̱ tsí mbátsíi, maske máꞌ nixuda-mina̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxu̱u̱, <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />jamí wapha máꞌ waꞌtháa̱n neꞌne Ana̱ꞌlóꞌ: «Ga̱jma̱á majñu̱u̱ Isaák ma̱gu̱mii xa̱bia̱aꞌ».<note caller="+" style="f"><char style="fr" closed="false">11.18 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ xó ni̱gi̱ꞌdu̱u̱n-muu 21.12.</char></note> <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />Numuu ni̱ju̱mu̱u̱ Abraám rí Ana̱ꞌlóꞌ gíꞌdoo tsiakhe̱ rí ma̱ꞌne rí mbuya̱a mbiꞌñúú asndo tsí nijáñúú. Jamí gakon máꞌ rí asndo xómá rí nijáñuu máꞌ a̱dée̱ jamí ndiyáa̱ mbu̱júꞌ jaꞌnii.<verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />Ga̱jma̱á numuu rí ni̱we̱je̱ a̱kui̱in Isaák ná inuu Ana̱ꞌlóꞌ, wapha máꞌ niꞌthée̱n rí Jakób ga̱jma̱á Esaú ma̱gu̱ma-tsakun-rámii̱ nda̱wa̱á.<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />Ga̱jma̱á numuu rí ni̱we̱je̱ a̱kui̱in Jakób ná inuu Ana̱ꞌlóꞌ, neꞌne-tsakun-rámaa̱ mbámbáa a̱dée José, nákhí rí inu máꞌ ma̱ja̱ñúu̱. A̱ꞌkhue̱n ni̱rnga̱du̱u̱n niríguii̱ idxu̱u̱ ná inuu ixe̱ rí gída̱ꞌ ñawúu̱n, kajngó ma̱ꞌne-mba̱a̱ Ana̱ꞌlóꞌ.<verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />Ga̱jma̱á numuu rí ni̱we̱je̱ a̱kui̱in José ná inuu Ana̱ꞌlóꞌ, nákhí rí inu máꞌ ma̱ja̱ñúu̱ niꞌthée̱n rí ma̱ga̱jnáa i̱ji̱in Israél ná numbaa Ejípto̱, jamí nixná-ñájwii̱n rí ma̱ꞌga̱a itsu̱u̱ mangaa.<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />Ga̱jma̱á numuu rí tátée jamí nánée Moisés ni̱we̱je̱ a̱kuíi̱n ná inuu Ana̱ꞌlóꞌ, nákhí rí ni̱gu̱maa Moisés, ni̱rkaꞌwii̱ atsúun go̱nꞌ. Numuu rí kuitsíin cháña̱ꞌ ndiyáa̱, jamí támíñúu̱ eꞌne xtángoo drígo̱o̱ thúngaa.<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />Ga̱jma̱á numuu rí ni̱we̱je̱ a̱kui̱in Moisés ná inuu Ana̱ꞌlóꞌ, ído̱ rí nikhi̱i̱ máꞌ, nánguá ndiyoo̱ rí muthan xa̱bo̱ rí nánée̱ ñajuun a̱dée Faraón. <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />Rí i̱wa̱á máꞌ ni̱ni̱gu̱u̱ꞌ rí ma̱gu̱ma-ngínáa̱ gajmíi̱ xa̱bo̱ xuajñuu Ana̱ꞌlóꞌ, xó rí ma̱xtáa̱ tsímáá guéño mbégo jayu ná awúun aꞌkhán. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />Numuu ndiꞌyoo̱ rí i̱tha̱án máꞌ gíꞌdoo numuu rí mi̱ꞌthán-xkawíi̱ꞌ ga̱jma̱á numuu Krísto̱ xó rí ma̱gi̱ꞌdoo̱ mbá xúgíí rí gíꞌdoo guéño numuu guáꞌdáá xa̱bo̱ Ejípto̱. Numuu rí nitsijii̱ iduu̱ ná ríga̱ rí máján ma̱grui̱gúu̱ nda̱wa̱á gáꞌne Ana̱ꞌlóꞌ. <verse eid="HEB 11:26" /><verse number="27" style="v" sid="HEB 11:27" />Ga̱jma̱á numuu rí ni̱we̱je̱ a̱kuii̱n ná inuu Ana̱ꞌlóꞌ, nigájnuu̱ ná numbaa Ejípto̱, jamí támíñuu̱ xí ma̱jiꞌnáa thúngaa. Numuu rí ni̱we̱je̱ gúkúu̱, asndo xómá rí ndaꞌyoo̱ máꞌ Ana̱ꞌlóꞌ tsí tsíkujmaa jaꞌnii.<verse eid="HEB 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 11:28" />Ga̱jma̱á numuu rí ni̱we̱je̱ a̱kui̱in Moisés ná inuu Ana̱ꞌlóꞌ, niꞌnii̱ ndxa̱a̱ Páskua̱ jamí nixná-ñájwii̱n rí magu̱u̱ iꞌdi ná rawuun xkrugua, kajngó tsí na̱gu̱díin e̱je̱n tsí ginuu ma̱xáxkajmii̱ i̱ji̱ín xa̱bo̱ Israél.<verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />Ga̱jma̱á numuu rí ni̱we̱je̱ a̱kui̱ín xa̱bo̱ Israél ná inuu Ana̱ꞌlóꞌ, ninújngúu̱n Iya A̱pha̱ Maña̱ꞌ asndo xómá inuu ju̱ba̱ꞌ mixoo. Ído̱ rí nene̱ ma̱nújngúún xa̱bo̱ Ejípto̱ mangiin, ikhín nixmátu̱ꞌúu̱n jamí nijáñúu̱.<verse eid="HEB 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30" />Ga̱jma̱á numuu rí ni̱we̱je̱ a̱kui̱ín xa̱bo̱ Israél ná inuu Ana̱ꞌlóꞌ, ningáxe̱ xu̱nꞌ rí narugua-maꞌáan xuajen Jerikó, ído̱ rí wámbúu̱n nigótuaꞌée̱n mbá juwan mbiꞌi níjñúu ne̱.<verse eid="HEB 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="HEB 11:31" />Ga̱jma̱á numuu rí ni̱we̱je̱ a̱kui̱in Raáb ná inuu Ana̱ꞌlóꞌ, a̱ꞌgo̱ tsí na̱ngu̱jwa̱-mína̱ꞌ nákhí wajyúú, tájáñuu̱ gajmíi̱ xa̱bo̱ Jerikó tsí tánimbu̱únꞌ juyáá Ana̱ꞌlóꞌ, numuu rí tsímáá ni̱grui̱gúu̱n ná guꞌwóo̱ xa̱bo̱ Israél tsí nigóó gúña̱maa mbaa.<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />Dí lá xóó gátha̱nꞌlaꞌ rá. Ma̱xáꞌngo̱o̱ mbiꞌi xí ma̱tha̱nꞌlaꞌ ga̱jma̱á numuu Jedeón, Barák, Sansón, Jefté, Dabíd, Samuél jamí tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ wajyúú. <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />Ga̱jma̱á numuu rí ni̱we̱je̱ a̱kuíi̱n ná inuu Ana̱ꞌlóꞌ, ni̱ꞌngúu̱n ni̱dríguíi̱ xuajñúú xa̱bo̱ jamí nithan-ñajwii̱n, ni̱xu̱da̱a̱ꞌ mújúun awan, nijanúu̱ rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ, jamí ni̱ruguáa̱ rawúún i̱ndi̱í phuu. <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />Ga̱jma̱á numuu rí ni̱we̱je̱ a̱kuíi̱n ná inuu Ana̱ꞌlóꞌ, ni̱sndui̱ꞌíi̱ agu rí gakhi̱i̱ mi̱ndaꞌkho, jamí nijáwíi̱n ná inuu chíde̱. Ído̱ rí phú níꞌngúu̱n, nixna-mijnée̱ tsiakhe̱, maphú gakhii̱n neꞌne ná niríga̱ xkujndu, jamí ni̱ꞌngúu̱n nini̱i̱ rí magáñúú xa̱bo̱ sia̱nꞌ. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />Xúꞌkhue̱n máꞌ nijúwa̱ꞌ go̱ꞌo̱ tsí ni̱dri̱gúun xa̱bi̱ín tsí nijáñúú ído̱ ndiya̱a mbiꞌñúú.</para>
  <para style="p" vid="HEB 11:35">Xómáꞌ i̱ꞌwíin, nijáñúu̱ ná ni̱gu̱ma-ngíníi̱, jamí ra̱khúu̱n rí ma̱gu̱ma-jáwíi̱n, numuu ndiyáa̱ rí i̱tha̱án máꞌ máján gájúwe̱e̱ꞌ ído̱ rí mbuyaa̱ mbiꞌñúu̱. <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />Nijúwa̱ꞌ i̱ꞌwíin tsí waꞌthán-xkawiu̱únꞌ, waxpáthuun, waxtuꞌwúún ga̱jma̱á ñuu ajwa̱nꞌ jamí nigóo̱ géjwa̱nꞌ. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />I̱ꞌwíin nijáñúú ga̱jma̱á itsí, i̱ꞌwíin nithon-ri̱gi̱in ti̱kua̱pha̱a̱ ga̱jma̱á ajwa̱nꞌ rí na̱ro̱thon ixe̱, jamí i̱ꞌwíin nijáñúú ga̱jma̱á chíde̱. Mbá tikhuu̱n ge̱e̱ ñúꞌún nigóo̱-rajúwe̱e̱ꞌ, rí xtíñúu̱ neꞌne xtúún xu̱kú mogo̱ jamí xtúún tso̱toon. Mingíníi̱, nijúwe̱e̱ꞌ ná awúun jamínu̱ꞌ, jamí nikhuáa ni̱gu̱mii̱ nene̱ xa̱bo̱. <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />Ná numbaa ríge̱ꞌ ra̱jáꞌyoo rí ma̱ju̱wá xa̱bo̱ tsí xkuaꞌnii májáan a̱kui̱ín. Ge̱e̱ ñúꞌún nigóo̱-rajúwe̱e̱ꞌ ná mbaa niníí, ná inuu júba̱, ná iñúu itsí jamí ná iñúu ju̱ba̱ꞌ.<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />Mbá xúgíin xa̱bo̱ tsúꞌkhue̱n, túdri̱guíi̱ rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ, maske máꞌ phú ni̱ni̱gu̱u̱ꞌ Ana̱ꞌlóꞌ nini̱i̱ ga̱jma̱á numuu rí ni̱we̱je̱ a̱kuíi̱n ná inuu̱. <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />Numuu rí Ana̱ꞌlóꞌ niꞌgí-mina̱ꞌ mbá rí i̱tha̱án máján ga̱jma̱á numalóꞌ ikháánꞌlóꞌ, kajngó mbéꞌtháán gágu̱ma-káxáanꞌlóꞌ ga̱jma̱á nindxúu̱n ikhii̱n.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s">Gu̱ya̱xi̱ílóꞌ Jesús</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />Ikháánꞌ mangáánꞌlóꞌ, ra̱ꞌkhá tháán mbaꞌiin xa̱bo̱ tsí ni̱we̱je̱ a̱kui̱ín ná inuu Ana̱ꞌlóꞌ wájun ná níjñálóꞌ nduyalóꞌ. Ikhaa numuu rúꞌkhue̱n, gu̱ni̱ꞌñáálóꞌ janíí mbá xúgíí inii rí na̱we̱je̱-ꞌtha̱nꞌlóꞌ, jamí mbá xúgíí inii aꞌkhán rí naxngróꞌoo nakhuálóꞌ, kajngó ma̱ꞌnga̱ꞌlóꞌ mu̱ga̱yálóꞌ máꞌ xúꞌkhue̱n ná inuu jamba̱a̱ rí kri̱ga̱ ná inalóꞌ. <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />Gu̱ya̱xi̱ílóꞌ Jesús, tsí nigíꞌdu̱u̱n jamí ma̱ꞌne-gáxu̱u̱ rí wéje̱ a̱kia̱nꞌlóꞌ ná inuu Ana̱ꞌlóꞌ. Jesús ni̱ꞌngo̱o̱ a̱kuii̱n nimínu̱u̱ꞌ rí ma̱ja̱ñúu̱ ná ixe̱ krúsi̱, táxná-gamiéjuu̱n rí nigájnuu gamakuu̱, numuu ndiꞌyoo̱ rí nda̱wa̱á ma̱xtáa̱ gagi. Jamí xúge̱ꞌ ꞌgíi̱ naꞌthán-ñájwii̱n ná ñawún mújúun Ana̱ꞌlóꞌ.<verse eid="HEB 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3" />Ikhaa jngó, gu̱ya̱xi̱í májánlaꞌ xkri̱doo Jesús, tsí ra̱ꞌkhá tháán gakhe̱ nimínu̱u̱ꞌ nene̱ xa̱bo̱ tsí nune̱ aꞌkhán, kajngó ma̱xáꞌne níꞌnga̱ꞌlaꞌ ni máꞌ mu̱xúne̱-waba-mijnálaꞌ. <verse eid="HEB 12:3" /><verse number="4" style="v" sid="HEB 12:4" />Numuu rí xóó máꞌ túne̱ gakhe̱ a̱kia̱nꞌlaꞌ, rí asndo ma̱ja̱ñálaꞌ ná awúun rí na̱tsa̱ña̱ꞌlaꞌ ga̱jma̱á aꞌkhán. <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />Jamí wámba̱ máꞌ nimbumalaꞌ ajngáa rí naꞌthán-máꞌánlaꞌ Ana̱ꞌlóꞌ tsáanꞌ i̱jii̱n ñajwanlaꞌ:</para>
  <para style="q" vid="HEB 12:5">«Táa̱, ma̱xátha̱da̱ꞌ lá nikhuáa ajngáa tsixprígú rí naꞌtháanꞌ Táta̱,</para>
  <para style="q" vid="HEB 12:5">ni máꞌ ma̱xáwabaa a̱kia̱anꞌ ído̱ rí naríyáa̱ꞌ.<verse eid="HEB 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HEB 12:6" />Numuu rí Táta̱ naxprígúu̱ tsí nandoo̱ jaꞌyoo̱,</para>
  <para style="q" vid="HEB 12:6">jamí naxpáthii̱n jámba̱a̱ tsí na̱grui̱guíi̱ ma̱ꞌne a̱dée̱».<note caller="+" style="f"><char style="fr" closed="false">12.6 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajngáa ju̱ma̱ 3.11-12.</char></note><verse eid="HEB 12:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 12:7" />Ga̱ꞌngo̱o̱ a̱kia̱nꞌlaꞌ rí naxpríguálaꞌ Ana̱ꞌlóꞌ, numuu rí ikhaa̱ naꞌñalaꞌ xómá i̱jii̱n. Tsáa lá ada̱a̱ tsí na̱nguá nixpríguíí eꞌne tátée rá. <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />Xí tsíxpríguálaꞌ Ana̱ꞌlóꞌ xómá naxprígúu̱n xúgíin i̱jii̱n, ra̱ꞌkhá i̱jii̱n ñajwanlaꞌ xúꞌkhue̱n rá, rí e̱je̱n-xáná ñajwanlaꞌ. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />Mbáá máꞌ rí nákhí makáanꞌlóꞌ nixpríguálóꞌ tátiálóꞌ ga̱jma̱á nániálóꞌ ná numbaa ríge̱ꞌ, jamí ndiꞌya-makúu̱nlóꞌ. Á ra̱ꞌkhá i̱tha̱án máján rí mu̱ꞌne̱-mbáníílóꞌ rí naꞌthán Ana̱ꞌlóꞌ Mikhuíí kajngó mbu̱ꞌyalóꞌ jámuu rá. <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />Jamí tsí ñajuun tátiálóꞌ ga̱jma̱á nániálóꞌ ná numbaa ríge̱ꞌ, mbá wátha̱ máꞌ tsigu ni̱xpríguálóꞌ, xómá nifruꞌúu̱n ikhii̱n. Xómáꞌ Ana̱ꞌlóꞌ rá, naxpríguálóꞌ kajngó phú i̱tha̱án máján gágájnalóꞌ jamí ma̱ꞌne-jaꞌwáanꞌlóꞌ xómá ikhaa̱. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />Gakon máꞌ rí xúge̱ꞌ nimbá tsixprígú tsíꞌne ne̱ rí ma̱xtáa gagi tsí na̱grui̱gú ne̱, rí naꞌne ne̱ rí ma̱xtáa̱-jínúu̱. I̱ndo̱ó máꞌ numuu rí nda̱wa̱á rí ni̱ꞌngo̱o̱ máꞌ a̱kui̱ín tsí waxprígúún, nakujma rí xa̱bo̱ tsúꞌkhue̱n júwe̱e̱ꞌ tsímáá jamí nuni̱i̱ rí máján.<verse eid="HEB 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />Ikhaa jngó, ikháanꞌlaꞌ tsáanꞌ níꞌnga̱ꞌlaꞌ, gu̱ne̱-nuxi̱iꞌlaꞌ ski̱yu̱u̱ꞌ ñawánlaꞌ rí níꞌngo̱o̱ jamí iduu nakhuálaꞌ rí neꞌne xa̱ꞌ. <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />Jamí gu̱ꞌyálaꞌ mbá jamba̱a̱ rí jmbu mu̱ꞌgualaꞌ, kajngó ma̱ꞌni̱i nakhuálaꞌ, ra̱ꞌkhá ma̱wi̱ngoo-wóo rí ni̱wi̱ngoo máꞌ.<verse eid="HEB 12:13" /></para>
  <para style="s">Rí nithúún tsí tsíyamakuíí Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />Gu̱xna̱-míjnálaꞌ tsiakhe̱ rí ma̱juwalaꞌ tsímáá gajmiálaꞌ mbá xúgíin xa̱bo̱, jamí jaꞌwu gájuwalaꞌ ná inuu Ana̱ꞌlóꞌ. Numuu rí nimbáa tsí na̱nguá jaꞌwu xtáa, ma̱xáꞌyoo̱ Táta̱. <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />Phú gu̱ña̱wa̱n-mijnálaꞌ, kajngó nimbáa ma̱xáꞌne tsíngua̱ꞌ-mina̱ꞌ inuu rí májáan a̱kui̱in Ana̱ꞌlóꞌ jaꞌyalóꞌ, a̱ꞌkhue̱n ma̱nindxu̱u̱ xómá mbá ajmu̱u̱ iná miꞌkhu̱u̱n rí ma̱ꞌne-maꞌchíin mbaꞌiin tsí ikháanꞌlaꞌ. <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />Ma̱xáxtáa nimbáa tsí nabóo ga̱jma̱á xa̱bo̱ tsí táyáa ná majña̱ꞌlaꞌ, ni máꞌ ma̱xáxtáa nimbáa tsí tsíya-makuu Ana̱ꞌlóꞌ xómá neꞌne Esaú, rí ni̱ngu̱jwe̱e̱ rí jaꞌyoo̱ rí ada̱ ginii ñajuu̱n ga̱jma̱á numuu mbá xúba̱ ganitsu. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />Numuu rí ndu̱ya̱álaꞌ máꞌ rí nda̱wa̱á ndiyoo̱ ma̱gu̱ma-tsakun-rámaa̱ gáꞌne tátée̱, jamí táwatri̱guíi̱. Maske máꞌ phú ni̱mbi̱ye̱e̱ꞌ, nánguá ndiyoo rí ma̱thanga̱a a̱kuii̱n rí niꞌnii̱.<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />Numuu rí ikháanꞌlaꞌ, túxu̱ꞌmá-mijnálaꞌ ná júba̱ rí nandoo mu̱xkajmalóꞌ, rí nakha, rí mijína jamí rí naxpíbi ná inuu. <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />Ni máꞌ túdxawíínlaꞌ a̱ꞌwóo che̱je̱ꞌ, ni máꞌ túdxawíínlaꞌ a̱ꞌwóo Ana̱ꞌlóꞌ xómá ni̱dxawíín xa̱bo̱ Israél wajyúú. Tsí ni̱dxawíín a̱ꞌwá rúꞌkhue̱n, nithan-kháa̱n rí náxíꞌthúu̱n. <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />Numuu ndiyáa̱ rí ma̱xáꞌgúu̱n gúne̱-mbáníi̱ rí waꞌxná-ñájúu̱n: «Jámba̱a̱ xa̱bo̱ o xu̱kú tsí nangájmaa júba̱ rúꞌkhue̱n, gíꞌmaa mi̱ꞌxnáa̱ ga̱jma̱á itsí ma̱ja̱ñúu̱ o ga̱jma̱á ixu̱u̱ xkamídá mbo̱ꞌ».<note caller="+" style="f"><char style="fr" closed="false">12.20 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá iꞌthán: «o ga̱jma̱á ixu̱u̱ xkamídá mbo̱ꞌ».</char></note> <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />Maphú ngamí nikujma ná júba̱ rúꞌkhue̱n ndiyáa̱, kajngó niꞌthán Moisés: «Asndo naguꞌwúún rí namíñuꞌ».<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />Xómáꞌ ikháanꞌlaꞌ rá, ni̱xu̱ꞌmá-mijnálaꞌ ná júba̱ «Sióón», ná xuajñuu Ana̱ꞌlóꞌ tsí xtáa ndaꞌya, ná Jerusalén rí ꞌgí mikhuíí, ná ni̱gi̱mbíin ga̱jma̱á gagi mbaꞌiin mi̱ndaꞌkho ánje̱l rí mune̱-mba̱a̱ Ana̱ꞌlóꞌ. <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />Ni̱xu̱ꞌmá-mijnálaꞌ ná nu̱ru̱wa-mijnáa i̱ji̱in Ana̱ꞌlóꞌ tsí ginuu ni̱gi̱ꞌma mbiꞌñúú ná mikhuíí. Xúꞌkhue̱n máꞌ ni̱xu̱ꞌmá-mijnálaꞌ ná inuu Ana̱ꞌlóꞌ, tsí naxuda awan ga̱jma̱á numúú mbá xúgíin xa̱bo̱. Jamí ni̱xu̱ꞌmá-mijnálaꞌ ná ríga̱ xu̱únꞌ xa̱bo̱ tsí májíin tsí neꞌne-káxi̱in máꞌ Ana̱ꞌlóꞌ. <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />Ni̱xu̱ꞌmá-mijnálaꞌ ná inuu Jesús tsí naꞌthán-mbáá numalóꞌ ná inuu Ana̱ꞌlóꞌ ga̱jma̱á mbá awan nuxe̱ꞌ, jamí ná ríga̱ iꞌdi rí neꞌne-jaꞌwáanꞌlóꞌ, rí i̱tha̱án máꞌ máján iꞌthán xó rí iꞌdiuu Abél.<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />Ikhaa jngó, gu̱dxawíínlaꞌ ajngóo tsí naꞌthánlaꞌ. Numuu rí tájáwíin rí mu̱drígú jamínu̱ꞌ tsí túdxawíín ajngóo tsí nixprígúu̱n ná numbaa ríge̱ꞌ. I̱wa̱á máꞌ ma̱jáxáwiáanꞌlóꞌ ikháánꞌlóꞌ, xí tsídxawíínlóꞌ ajngóo tsí naxpríguálóꞌ asndo ná mikhuíí. <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />Nákhí mbiꞌi rí ñúꞌún, niꞌba̱a̱n ju̱ba̱ꞌ neꞌne a̱ꞌwóo Ana̱ꞌlóꞌ, xómáꞌ xúge̱ꞌ naxuda-mine̱e̱ꞌ: «Ma̱ne̱-maꞌba̱a̱n xóó i̱mbo̱ó miꞌtsú, ra̱ꞌkhá i̱ndo̱ó ju̱ba̱ꞌ, rí asndo mikhu mangaa».<note caller="+" style="f"><char style="fr" closed="false">12.26 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Ajéo̱ 2.6.</char></note> <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />Ído̱ naꞌthée̱n: «Ma̱ne̱-maꞌba̱a̱n xóó i̱mbo̱ó miꞌtsú», rúꞌkhue̱n iꞌthán rí magruígúu̱ rí nandoo naꞌba̱a̱n, rí ni̱gu̱ma-ku̱maa, kajngó ma̱nguanúu i̱ndo̱ó máꞌ rí ríga̱ jámuu.<verse eid="HEB 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28" />Ana̱ꞌlóꞌ naxnálóꞌ tsiakhe̱ rí mu̱ꞌthán-ñájunlóꞌ jámuu. Ikhaa jngó, gu̱rígu̱ulóꞌ gamaku inuu̱. Gu̱ꞌne̱-mba̱a̱lóꞌ xómá rí na̱ni̱gu̱u̱ꞌ ikhaa̱, ga̱jma̱á ngamí jamí gamaku, <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />numuu rí Ana̱ꞌlóꞌ ñajuun xómá agu rí naꞌne-gámbo̱o̱ mbá xúgíí.<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s">Xáne gíꞌmaa rí ma̱ju̱wá tsí nanimbu̱únꞌ juyáá Krísto̱</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />Ga̱galaꞌ máꞌ xúꞌkhue̱n ju̱ya̱-mijnálaꞌ xómá ene̱ mbá guꞌwíin xa̱bo̱. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />Jamí ma̱xámbumalaꞌ rí mu̱drígúunlaꞌ ná guꞌwálaꞌ xa̱bo̱ tsí naguwá i̱mba̱ janíí. Numuu rí xkuaꞌnii máꞌ nene̱ mbá tikhuun xa̱bo̱ nákhí wajyúú, ni máꞌ túyáa̱ rí ni̱drígúu̱n ánje̱l ná guꞌwúu̱n. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />Ga̱rmáꞌáan a̱kia̱nꞌlaꞌ ju̱ñu̱ú tsí traꞌi̱in géjwa̱nꞌ, asndo xómá rí ikháanꞌ mangáanꞌlaꞌ traꞌáanꞌlaꞌ géjwa̱nꞌ gajmiálaꞌ. Xúꞌkhue̱n máꞌ ga̱rmáꞌáan a̱kia̱nꞌlaꞌ ju̱ñu̱ú tsí na̱gu̱ma-ngíníi, asndo xómá rí ikháanꞌ mangáanꞌlaꞌ na̱gu̱ma-ngínáaꞌlaꞌ ga̱jma̱á nindxúu̱n.<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />Xúgíin xa̱bo̱ tsí nida-mijná, guya-makuíi̱ xa̱bo̱ tsí ndiya̱a̱, jamí nimbáa ma̱xábóo ga̱jma̱á xa̱bo̱ tsí táyáa. Xómáꞌ tsí nubúún gajmíí xa̱bo̱ tsí túya̱a̱ rá, Ana̱ꞌlóꞌ maxúꞌdaa awan ga̱jma̱á numúu̱.<verse eid="HEB 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5" />Ma̱xáni̱gua̱ꞌlaꞌ rí ma̱guaꞌdáálaꞌ mi̱ndaꞌkho. Ga̱juwalaꞌ gagi ga̱jma̱á rí guáꞌdáálaꞌ máꞌ, numuu rí jmína̱a̱ꞌ máꞌ Ana̱ꞌlóꞌ niꞌthán: «Ni miꞌtsú ma̱xáni̱ꞌñáaꞌ, ni máꞌ ma̱xáni̱ꞌñá-ti̱ga̱án».<note caller="+" style="f"><char style="fr" closed="false">13.5 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yi̱i̱ꞌ rí naꞌthán ikhaa máꞌ xtángoo 31.6, 8.</char></note> <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />Ikhaa jngó, ma̱goo mu̱ꞌthánlóꞌ ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ:</para>
  <para style="q" vid="HEB 13:6">«Táta̱ ñajuun tsí nambáyíꞌ,</para>
  <para style="q" vid="HEB 13:6">ikhaa jngó ma̱xámíñuꞌ.</para>
  <para style="q" vid="HEB 13:6">Nda̱a̱ nitháan rí ma̱ꞌngo̱o̱ ma̱ꞌñiꞌ nimbáa xa̱bo̱ numbaa».<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />Ga̱rmáꞌáan a̱kia̱nꞌlaꞌ ju̱ñu̱ú xa̱bo̱ ede̱ tsí ndiya̱ ikhalaꞌ, tsí nithanlaꞌ ajngáa rawuun Ana̱ꞌlóꞌ. Gu̱ya̱xi̱ílaꞌ xáne nijúwe̱e̱ꞌ, jamí gu̱ya̱ri̱dáálaꞌ rí nini̱i̱ numuu rí ni̱we̱je̱ a̱kuíi̱n ná inuu Ana̱ꞌlóꞌ. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />Ikhaa máꞌ rí ninindxu̱u̱ Jesukrísto̱ ri̱xi̱í, ikhaa máꞌ ñajuu̱n xúge̱ꞌ, jamí ikhaa máꞌ gánindxu̱u̱ jámuu.<verse eid="HEB 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 13:9" />Mu̱xúni̱ꞌñá-mijnálaꞌ rí ma̱gu̱ma-nduwáanꞌlaꞌ gáꞌne nimbá gisngáá rí ra̱ꞌkhá ajngóo Ana̱ꞌlóꞌ ñajuun. Numuu rí i̱wa̱á máꞌ máján rí a̱kia̱nꞌlóꞌ ma̱grui̱gú tsiakhe̱ ga̱jma̱á rí máján naxná Ana̱ꞌlóꞌ, xó rí mu̱ꞌne̱-mbáníílóꞌ xtángoo rí naꞌthán ga̱jma̱á numuu ganitsu, numuu rí xtángoo rúꞌkhue̱n ni miꞌtsú támbáñúú ne̱ tsí nu̱ne̱-mbáníí ne̱. <verse eid="HEB 13:9" /><verse number="10" style="v" sid="HEB 13:10" />Waxnáxe̱ mbá tsi̱gi̱jña̱ꞌ ga̱jma̱á numalóꞌ ikháánꞌlóꞌ, jamí dxakuun tsí nu̱ñajun ná awúun guꞌwá dxákuun xtíin ra̱jáꞌñúú mu̱pho̱ tsi̱gi̱jña̱ꞌ rúꞌkhue̱n. <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />Numuu rí tsí jayá idxu̱ún dxakuun, na̱to̱ꞌo̱o̱ jayóo̱ iꞌdiúún xu̱kú ga̱jma̱á numuu aꞌkhán Ná rí I̱tha̱án Tsúꞌkhaa. Xómáꞌ xuñúú xu̱kú tsúꞌkhue̱n nakha ne̱ rixa̱á, ná na̱nguá júwa̱ꞌ xa̱bo̱. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />Xkuaꞌnii máꞌ Jesús mangaa, nijáñuu̱ rixa̱á, ná rawuun xuajen, kajngó ma̱ꞌne-jaꞌwuu̱n xa̱bo̱ xuajen ga̱jma̱á iꞌdiuu̱. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />Ikhaa jngó, gu̱ꞌgua̱lóꞌ mangáánꞌlóꞌ rixa̱á ñúꞌún gúxkama̱alóꞌ Jesús. Jamí ga̱ꞌngo̱o̱ a̱kia̱nꞌlóꞌ rí ma̱gu̱ma-matiáanꞌlóꞌ xómá rí ni̱gu̱ma-mati̱i̱ꞌ ikhaa̱. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />Numuu rí ra̱ꞌkhá jámuu ꞌgí xuajen numbaa ná juwalóꞌ xúge̱ꞌ, ikhaa jngó guáꞌthi̱ínlóꞌ xuajen rí ni̱kú ma̱ri̱gá.<verse eid="HEB 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 13:15" />Ikhaa jngó, jámba̱ miꞌtsú gu̱xna̱xílóꞌ tsi̱gi̱jña̱ꞌ ná inuu Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ Jesús. Tsi̱gi̱jña̱ꞌ rúꞌkhue̱n ñajuun rí mu̱ꞌne̱-mba̱a̱lóꞌ ga̱jma̱á ajngáa rí nagájnuu ná rawanlóꞌ, jamí rí mu̱ꞌthánlóꞌ rí máján ga̱jma̱á numuu̱. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />Ma̱xámbumalaꞌ rí mu̱ne̱laꞌ rí máján ni máꞌ rí mu̱mbáyú-mijnálaꞌ. Numuu rí tsi̱gi̱jña̱ꞌ rúꞌkhue̱n ñajuun rí na̱ni̱gu̱u̱ꞌ Ana̱ꞌlóꞌ.<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />Gu̱ne̱-mbáníílaꞌ rí nuthan xa̱bo̱ ede̱ tsí juya̱ ikhalaꞌ, jamí gu̱ni̱ꞌñá-mijnálaꞌ rí muxna-ñajwanlaꞌ. Numuu rí ikhii̱n tsíyaa̱ xúu̱nꞌ rí nu̱ña̱wa̱nꞌlaꞌ jamí wéje̱ inúu̱ rí mu̱xna̱xíi̱ ñajun rí nini̱i̱ ná inuu Ana̱ꞌlóꞌ. Ga̱nimba̱ꞌlaꞌ ju̱ñúu̱ kajngó gagi a̱kuíi̱n gúni̱i̱ ñajúu̱n, jamí mu̱xúni̱i̱ xkujndu, numuu rí nda̱a̱ rí gámbáyálaꞌ rúꞌkhue̱n.<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />Gu̱tha̱n-jáñíílaꞌ Ana̱ꞌlóꞌ ga̱jma̱á numaxo̱ꞌ, numuu rí ndu̱ya̱á májánxo̱ꞌ rí na̱nguá e̱ne̱xo̱ꞌ rí xkawe̱ꞌ, jamí nandaxo̱ꞌ rí ma̱juwa májánxo̱ꞌ ná inuu mbá xúgíí. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />I̱wa̱á máꞌ na̱nda̱ꞌa̱ꞌlaꞌ rí mu̱tha̱n-jáñíílaꞌ Ana̱ꞌlóꞌ rí ma̱ꞌnii̱ rí ma̱ꞌgá gáya̱ꞌlaꞌ wapha.<verse eid="HEB 13:19" /></para>
  <para style="s">Ajngáa rí kithángoo</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />Ana̱ꞌlóꞌ ñajuun tsí naꞌne rí ma̱juwalóꞌ tsímáá. Ikhaa̱ niꞌnii̱ rí mbayáa mbiꞌyuu Tátiálóꞌ Jesukrísto̱, waxtú mba̱a̱ tsí na̱ña̱wa̱nꞌlóꞌ tsáanꞌ xómá xu̱kú mogo̱ jaꞌñáaꞌlóꞌ, tsí ga̱jma̱á majñu̱u̱ iꞌdiuu neꞌne mbá awan jámuu ga̱jma̱á numalóꞌ. <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />Ana̱ꞌlóꞌ gáꞌne rí ma̱ma̱ñalaꞌ mu̱ne̱laꞌ mbá xúgíí inii rí máján, kajngó mu̱ne̱laꞌ rí nandoo̱. Xúꞌkhue̱n máꞌ ga̱ꞌnii̱ rí na̱ni̱gu̱u̱ꞌ ga̱jma̱á nindxa̱ꞌlaꞌ ga̱jma̱á majñu̱u̱ Jesukrísto̱, tsí jaꞌyoo rí ma̱gu̱ma-mba̱a̱ jámuu mbiꞌi. Xkuaꞌnii gáꞌne.<verse eid="HEB 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />A̱ngui̱nꞌ, na̱tha̱n-jáñalaꞌ rí mu̱ne̱ gakhe̱ a̱kia̱nꞌlaꞌ rí mu̱drígúlaꞌ mbá lájwíin ajngáa tsixprígú ríge̱ꞌ rí ni̱tháán ma̱ꞌga ná inalaꞌ. <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />Nandoꞌ rí ma̱gi̱da̱ꞌ idxa̱ꞌlaꞌ rí dxájwalóꞌ Timotéo̱ nigájnaa̱ máꞌ géjwa̱nꞌ. Xí wapha máꞌ ni̱ꞌkhe̱e̱, ma̱ꞌgá gáya̱ꞌlaꞌ ga̱jmi̱ꞌ.<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />Gu̱ra̱xi̱inlaꞌ mbá xúgíin xa̱bo̱ ede̱ tsí juya̱ ikhalaꞌ, jamí mbá xúgíin xa̱bi̱i Ana̱ꞌlóꞌ. Tsí júwa̱ꞌ ná Itália̱ nu̱ra̱xáanꞌlaꞌ.<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />Ana̱ꞌlóꞌ gáꞌne-tsakun-rámáaꞌlaꞌ mbá xúgiáanꞌlaꞌ. Xkuaꞌnii gáꞌne.<note caller="+" style="f"><char style="fr" closed="false">13.25 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «Xkuaꞌnii gáꞌne».</char></note><verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>