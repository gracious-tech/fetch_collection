<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TI" style="id">tcfU (55-1Tim) - Me̱ꞌpha̱a̱ Mañúwi̱ín (Malinaltepec) (NVI&gt;) Ne’ne PZM oct2007, c6/v113</book>
  <para style="h">1 Timotéo̱</para>
  <para style="toc3">1 Tm</para>
  <para style="toc2">1 Timotéo̱</para>
  <para style="toc1">Timbá i̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inuu Timotéo̱</para>
  <para style="mt2">Timbá i̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inuu</para>
  <para style="mt1">Timotéo̱</para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="s">Páblo̱ naraxi̱i Timotéo̱</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />Ikhúúnꞌ ñajunꞌ Páblo̱, xa̱bo̱ tsí waxúngua̱a̱ꞌ neꞌne Jesukrísto̱, numuu rí xkuaꞌnii niꞌthán-ñájun Ana̱ꞌlóꞌ tsí naꞌne-jríñáaꞌlóꞌ jamí Táta̱ Jesukrísto̱ tsí guáꞌthi̱ínlóꞌ ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ ná inuu.<verse eid="1TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TI 1:2" />Na̱xu̱ꞌmá i̱yi̱i̱ꞌ ríge̱ꞌ inaaꞌ, Timotéo̱, tsáán gakon rí xómá a̱ꞌdéꞌ ñajwaanꞌ numuu rí mbóó xó rí nanimba̱ꞌlóꞌ juꞌyáá Ana̱ꞌlóꞌ. Ikhúúnꞌ na̱ndo̱ꞌo̱o̱ Ana̱ꞌlóꞌ Mikhuíí jamí Tátiálóꞌ Jesukrísto̱ rí mune̱-tsakun-rámáa̱, ma̱ñáwíin a̱kuíi̱n juyaa̱ꞌ, jamí muni̱i̱ rí ma̱ra̱xtaa tsímáá.<verse eid="1TI 1:2" /></para>
  <para style="b" />
  <para style="s">Xawi gúꞌne̱lóꞌ ga̱jma̱á numuu gisngáá rí mi̱nduwa</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />Nákhí nigájnuꞌ nika ná numbaa Masedónia̱, ni̱tha̱n-jáñaaꞌ rí ma̱nguanáaꞌ ná xuajen Éfe̱so̱, kajngó ma̱ra̱xna̱-ñájúún xa̱bo̱ tsí nusngáá rí mi̱nduwa rí náxúsngáa̱ rúꞌkhue̱n, <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />xúꞌkhue̱n máꞌ rí náxúꞌgíi̱ idxúu̱n ajngáa xkáꞌtsa rí ra̱gákon, ni máꞌ ajngáa rí tsíyámuu rí nuthee̱n ga̱jma̱á numúú táta̱-xi̱ꞌñúu̱. Ajngáa rúꞌkhue̱n i̱ndo̱ó máꞌ najmaa ne̱ rí ma̱tsa̱ñúu̱ numuu, jamí tsímbáñúu̱ ne̱ rí mune̱-nuwii̱n rí nandoo Ana̱ꞌlóꞌ. Rí nambáyálóꞌ ñajuun rí ma̱nimba̱ꞌlóꞌ juꞌyáá Ana̱ꞌlóꞌ.<verse eid="1TI 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1TI 1:5" />Ni̱tha̱a̱nꞌ rí ma̱ra̱xna̱-ñájun rúꞌkhue̱n kajngó mbá xúgiáanꞌlóꞌ ma̱ga̱jnúu ná awúun a̱kia̱nꞌlóꞌ jaꞌwu rí ma̱galóꞌ juꞌya-mijnálóꞌ, xúꞌkhue̱n máꞌ ma̱ꞌne jañii a̱kia̱nꞌlóꞌ rí tsíꞌne̱lóꞌ rí xkawe̱ꞌ, jamí gakon rí wéje̱ a̱kia̱nꞌlóꞌ ná Ana̱ꞌlóꞌ. <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />Mbá tikhuun xa̱bo̱ ni̱ni̱ꞌñáá rí nune̱ rúꞌkhue̱n, jamí nune̱-ngra̱ꞌa-mijnée̱ ga̱jma̱á ajngáa rí nda̱a̱ mbá jayu numuu. <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />Nandúu̱n gánindxúu̱n tsí phú na̱ma̱ñúú nusngáá xtángawoo Ana̱ꞌlóꞌ, i̱ndo̱ó numuu rí tsífruꞌúu̱n rí nuthee̱n, ni máꞌ tsíyáa̱ mújúu̱n rí nusngáa̱, maske máꞌ na̱ju̱múu̱ ikhii̱n rí phú gakon ne̱.<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />Mbá xúgiáanꞌlóꞌ nduꞌyáá rí máján xtángoo, xí numuu rí najmalóꞌ ne̱ xó phú gíꞌmaa ma̱jmalóꞌ. <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />Mangaa máꞌ nduꞌyáálóꞌ ríge̱ꞌ, rí xtángoo tágu̱ma ne̱ ga̱jma̱á numúú tsí nune̱ rí máján. Ni̱gu̱ma ne̱ ga̱jma̱á numúú tsí tsíne̱-mbáníí ne̱ jamí tsí najñaguun, ga̱jma̱á numúú tsí ra̱májíin jamí xa̱bo̱ aꞌkhán, ga̱jma̱á numúú tsí nda̱a̱ gamakúún jamí tsí na̱nguá iya-makuíí Ana̱ꞌlóꞌ, ga̱jma̱á numúú tsí nu̱radíin anu̱ú jamí tsí nu̱radíin ru̱dúún, xúꞌkhue̱n máꞌ ga̱jma̱á numúú tsí nu̱radíin xa̱bo̱. <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />Ni̱gu̱ma ne̱ mangaa ga̱jma̱á numúú tsí nubúún gajmíí xa̱bo̱ tsí túya̱a̱, ga̱jma̱á numúú xa̱bekha tsí nubúún gajmíí xa̱bekha, ga̱jma̱á numúú tsí nune̱-ku̱ꞌwíin xa̱bo̱, ga̱jma̱á numúú tsí mixtutiin jamí tsí tsíne̱-mbáníí rí nu̱xu̱da̱ꞌ-mijná, xúꞌkhue̱n máꞌ ga̱jma̱á numuu jámba̱a̱ xa̱bo̱ tsí na̱we̱je̱-ꞌthu̱u̱n gisngáá rí máján. <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />Gisngáá rúꞌkhue̱n na̱ꞌkho̱-mina̱aꞌ ne̱ ga̱jma̱á rí phú wáá ñajuun ajngáa máján drígo̱o̱ Ana̱ꞌlóꞌ tsí phú májáan. Ikhaa ajngáa máján rúꞌkhue̱n waꞌxnángawoꞌ ikhúúnꞌ rí ma̱tha̱n-ráꞌalo̱ꞌ ne̱.<verse eid="1TI 1:11" /></para>
  <para style="s">Páblo̱ narígu̱u gamaku ná inuu Krísto̱ Jesús</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />Na̱rígu̱u gamaku ná inuu Tátiálóꞌ Krísto̱ Jesús, tsí nixníꞌ tsiakhe̱. Numuu rí ikhaa̱ nikhiamúu̱ rí ma̱ne̱-mbánuu ñajuu̱n, rúꞌkhue̱n kajngó niꞌgiúu̱n rí ma̱ne̱ ne̱. <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" />Numuu rí nákhí wapha ikhúúnꞌ ni̱tha̱n-xkawiu̱u̱ꞌ Jesús, xúꞌkhue̱n máꞌ ni̱xkúún jamí nikhuáa ni̱ñu̱ú tsí nanimbu̱únꞌ juyáa̱. Maske máꞌ xkuaꞌnii jaꞌñúú nákhí xúꞌkhue̱n, Ana̱ꞌlóꞌ niñáwíin a̱kuii̱n jaꞌyeꞌ, numuu rí ne̱ne̱ rúꞌkhue̱n nákhí xóó júgoo inuꞌ jamí xóó tsínimbo̱ꞌ ja̱yo̱o̱. <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />Ninújngoo mba̱a̱ rí máján rí ra̱jáꞌyoꞌ nixníꞌ Tátiálóꞌ, numuu niꞌnii̱ rí ma̱we̱je̱ a̱kui̱nꞌ ná inuu Ana̱ꞌlóꞌ jamí rí ma̱goꞌ ja̱ñu̱ú xa̱bo̱ numuu rí xtáa Krísto̱ Jesús ga̱jma̱á nindxu̱ꞌ.<verse eid="1TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 1:15" />Ajngáa rí gakon ñajuun ríge̱ꞌ jamí ga̱náꞌyoo ma̱nimbu̱únꞌ ne̱ mbá xúgíin xa̱bo̱: Krísto̱ Jesús ni̱ꞌkha̱ ná numbaa rí ma̱ꞌne-jáwíin xa̱bo̱ aꞌkhán. Rí mbá xúgíin xa̱bo̱ aꞌkhán, ikhúúnꞌ ñajun tsí i̱tha̱án xa̱bo̱ aꞌkhán ñajunꞌ. <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />I̱ndo̱ó máꞌ numuu rí ikhaa numuu rúꞌkhue̱n Ana̱ꞌlóꞌ niñáwíin a̱kui̱in jaꞌyeꞌ, kajngó Jesukrísto̱ masngájma ga̱jma̱á nindxu̱ꞌ ginúú wátha̱ mba̱a̱ a̱kuii̱n. Ikhúúnꞌ nanindxu̱ꞌ xkri̱da rí mbuyáá xa̱bo̱ tsí ma̱nimbu̱únꞌ juyáá Ana̱ꞌlóꞌ kajngó ma̱goo ma̱ju̱wée̱ꞌ mbá jámuu. <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />Ikhaa jngó, a̱gu̱ma-mba̱a̱ mbá jámuu jamí gi̱tia-makuíí Thúngaa tsí naꞌthán-ñájun mbá jámuu. Mbáwíi̱ ikhaa̱ ñajuu̱n Ana̱ꞌlóꞌ tsí nimiꞌtsú tsíjáñuu, tsí tsíkujmaa mbu̱ꞌyáálóꞌ, jamí tsí phú ju̱ma̱a̱ ñajuu̱n. Xkuaꞌnii gáꞌne.<verse eid="1TI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />A̱ꞌdéꞌ Timotéo̱, ikhaa ñajun ríge̱ꞌ na̱xna̱ngáwaaꞌ ikháánꞌ, ikhaa jngó araxná-mina̱ꞌ tsiakhe̱ rí ma̱ꞌnga̱a̱ꞌ inuu rí ra̱máján, xómá nithan tsí ni̱rawíjnga̱a ajngáa ga̱jma̱á numaaꞌ ikháánꞌ nákhí wapha. <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />Ma̱xáta̱tsi̱ꞌñáá-ranimba̱a̱ꞌ rí nanimba̱ꞌlóꞌ, xúꞌkhue̱n máꞌ ma̱xáta̱tsi̱ꞌñáá rí nathane̱ rí máján. Numuu rí júwa̱ꞌ mbá tikhuun tsí ni̱ni̱ꞌñáá-rune̱ rí máján, ikhaa jngó ni̱ni̱ꞌñáa̱-ranimbúu̱n rí nanimba̱ꞌlóꞌ. <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />Mbáa tsí neꞌne rúꞌkhue̱n ñajuun Imenéo̱, jamí i̱mba̱a̱ꞌ ñajuun Alejándro̱. Ikhúúnꞌ ni̱xna̱xíin tsúꞌkhue̱n ná inuu Satanás kajngó ma̱ma̱ñúu̱ rí mu̱xúthan xkawíi̱ꞌ Ana̱ꞌlóꞌ.<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="s">Xáne gíꞌmaa mi̱ꞌthán-jáñíí Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />Rí phú ginii na̱tha̱nꞌlaꞌ ñajuun rí mu̱tha̱n-jáñíílaꞌ Ana̱ꞌlóꞌ numúú mbá xúgíin xa̱bo̱. Gu̱nda̱ꞌa̱laꞌ, gu̱tha̱n-kháanlaꞌ jamí gu̱rígu̱ulaꞌ gamaku ná inuu Ana̱ꞌlóꞌ ga̱jma̱á numúu̱. <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />Gu̱nda̱ꞌa̱laꞌ ga̱jma̱á numúú thúngaa xúꞌkhue̱n máꞌ ga̱jma̱á numúú mbá xúgíin xa̱bo̱ ñajun, kajngó ma̱juwalóꞌ tsímáá jamí nda̱a̱ gajmá inalóꞌ gáꞌne, awúun rí juwalóꞌ nu̱ꞌne̱ jámba̱ rí nandoo Ana̱ꞌlóꞌ jamí nambáxa̱ꞌlóꞌ ga̱jma̱á gamaku. <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />Rúꞌkhue̱n rí máján jamí rí na̱ni̱gu̱u̱ꞌ Ana̱ꞌlóꞌ eꞌne, tsí naꞌne-jríñáaꞌlóꞌ. <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />Ikhaa̱ nandoo̱ rí mbá xúgíin xa̱bo̱ ma̱jáwíin jamí rí mune̱-nuwii̱n mújúu̱n rí gakon. <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />Numuu rí mbáwíi tsí ñajuun Ana̱ꞌlóꞌ xtáa, xúꞌkhue̱n máꞌ xtáa mbáwíi tsí naꞌne rí tsímáá gámbáxi̱in xa̱bo̱ ga̱jma̱á nindxu̱u̱ Ana̱ꞌlóꞌ. Ikhaa tsúꞌkhue̱n ñajuun Jesukrísto̱, tsí ninindxu̱u̱ xa̱bo̱ numbaa. <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />Ikhaa̱ nixnáxe̱-mine̱e̱ꞌ rí ma̱ja̱ñúu̱ rí ma̱ꞌne-jáwíi̱n mbá xúgíin xa̱bo̱, numuu rí niꞌnii̱ rúꞌkhue̱n nákhí ni̱ga̱nú mbiꞌi rí niꞌgí Ana̱ꞌlóꞌ. <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" />Ikhaa numuu rúꞌkhue̱n nixúngu̱únꞌ Ana̱ꞌlóꞌ rí ma̱tha̱n-ráꞌa ajngóo̱. (Ndaꞌyoo Krísto̱ rí<note caller="+" style="f"><char style="fr" closed="false">2.7 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «Ndaꞌyoo Krísto̱ rí».</char></note> gakon i̱tha̱nlo̱ꞌ, jamí tsíne̱-ndúwalo̱ꞌ). Xúꞌkhue̱n máꞌ niꞌgiúún Ana̱ꞌlóꞌ rí ma̱sngúún xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñájúún xáne ma̱nimbúu̱n juyáa̱ Ana̱ꞌlóꞌ jamí ma̱sngúu̱n rí gakon.<verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />Nandoꞌ rí xa̱bekha muthán-jáñíí Ana̱ꞌlóꞌ, mbá xúgíí máꞌ ná júwe̱e̱ꞌ. Gu̱xu̱xíi̱ ñawúu̱n ná inuu Ana̱ꞌlóꞌ ga̱jma̱á a̱kuíi̱n rí jaꞌwu, xúꞌkhue̱n máꞌ ma̱xájiꞌníi̱ juñúu̱ xa̱bo̱ ni máꞌ mu̱xúni̱i̱ ajngáa gajmíi̱.<verse eid="1TI 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 2:9" />Xúꞌkhue̱n máꞌ go̱ꞌo̱ gune̱-karatha-mijnée̱ ga̱jma̱á rí gamakuu̱n, gajúwúu̱n xtíin rí narugoo mbá jayu xuñúu̱ jamí mbayíí máꞌ numuu. Mu̱xúne̱-karatháa̱ guéño tsu̱u̱n idxúu̱n, xúꞌkhue̱n máꞌ ma̱xájmúu̱ xábí ajwa̱nꞌ mo̱jmo̱ꞌ, ni itsí kuitsúun rí mbiꞌyuu pérla̱, ni máꞌ ma̱xájúwúu̱n xtíin rí numuu mi̱ndaꞌkho. <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />I̱wa̱á máján rí gune̱-tsiꞌyá-mijnée̱ ga̱jma̱á majñu̱u̱ rí máján nuni̱i̱, xómá ga̱náꞌyoo rí mune̱ go̱ꞌo̱ tsí nuthan rí nune̱ rí nandoo Ana̱ꞌlóꞌ.<verse eid="1TI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 2:11" />Ga̱ꞌne-wíyuu rawúún go̱ꞌo̱ ído̱ rí nune̱-gajma̱a̱ jamí gune̱-mbáníi̱ mbá xúgíí rí nithúu̱n. <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />Numuu rí tsíxnu̱u̱ a̱ꞌgo̱ rí maꞌsngúún xa̱bekha, ni máꞌ rí maꞌthán-ñájúu̱n. Rí gíꞌmaa ma̱ꞌne a̱ꞌgo̱ ñajuun rí ma̱xtáa̱ wíyuu̱. <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />Numuu rí Ana̱ꞌlóꞌ ginii Adán neꞌne-ku̱maa̱, jamí nda̱wa̱á neꞌne-ku̱maa̱ Éba̱. <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />Mbáá máꞌ rí ra̱ꞌkhá Adán ñajuun tsí ni̱gu̱ma-nduwaa, rí a̱ꞌgo̱ ni̱gu̱ma-nduwaa. Jamí ído̱ wámba̱ ni̱gu̱ma-nduwaa̱, a̱ꞌkhue̱n nixuda-mine̱e̱ꞌ aꞌkhán. <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />I̱ndo̱ó má numuu rí ma̱jáwíin go̱ꞌo̱ ído̱ rí ma̱gu̱mii i̱jíi̱n, xí wéje̱ a̱kuíi̱n ná inuu Ana̱ꞌlóꞌ, xí nandúu̱n juñúu̱ xa̱bo̱, jamí jaꞌwu júwe̱e̱ꞌ ná inuu Ana̱ꞌlóꞌ ga̱jma̱á gamaku.<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="s">Xa̱bo̱ tsí ma̱goo mbuya̱ ikhúún tsí nanimbu̱únꞌ juyáá Jesús</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />Ajngáa rí gakon ñajuun ríge̱ꞌ: xí mbáa nandoo ma̱nindxu̱u̱ xa̱bo̱ tsí jayá ikhúún tsí nanimbu̱únꞌ juyáá Jesús, mbá ñajun rí máján nandoo̱ gáꞌnii̱. <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" />Ikhaa jngó tsí ñajuun xa̱bo̱ ede̱, jaꞌyoo rí ma̱nindxu̱u̱ mbáa xa̱bo̱ tsí nda̱a̱ rí ra̱máján mi̱ꞌthán numuu̱. Gíꞌmaa rí ma̱nindxu̱u̱ xa̱bo̱ tsí mbáwíi a̱ꞌgui̱i, xúꞌkhue̱n máꞌ nandxaꞌwá-mina̱ꞌ mújúun rí ma̱ꞌne, tsianii̱, gamakuii̱, na̱grui̱gúu̱n xa̱bo̱ ná guꞌwóo̱ jamí na̱ma̱ñuu̱ naꞌsngáa̱ mújúu̱n. <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />Ra̱jáꞌyoo ma̱nindxu̱u̱ mbá xa̱bo̱ najnga̱a̱, ni máꞌ ma̱xáꞌne mika idxu̱u̱, xúꞌkhue̱n máꞌ ma̱xáni̱gu̱u̱ꞌ madaa̱ mbúkha̱a̱ ga̱jma̱á majñu̱u̱ rí mi̱nduwa.<note caller="+" style="f"><char style="fr" closed="false">3.3 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «xúꞌkhue̱n máꞌ ma̱xáni̱gu̱u̱ꞌ madaa̱ mbúkha̱a̱ ga̱jma̱á majñu̱u̱ rí mi̱nduwa».</char></note> A̱ꞌkhue̱n gakon ga̱nindxu̱u̱ xa̱bo̱ tsí májáan a̱kui̱in jamí mba̱a̱ xo̱xto̱o̱, xúꞌkhue̱n máꞌ ma̱xáríguii̱ a̱kuii̱n ná inuu mbúkha̱a̱. <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />Ga̱nindxu̱u̱ xa̱bo̱ tsí máján naꞌthán-ñájúún xa̱bo̱ guꞌwóo, numuu rí nune̱-mbáníí i̱jii̱n rí naꞌthúu̱n jamí máján nduya̱-makuíi̱ anúu̱. <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />Tsí tsíma̱ñuu gáꞌthán-ñájúún xa̱bo̱ guꞌwóo, xáne lá gáma̱ñuu̱ rí mbayée̱ ikhúún tsí nanimbu̱únꞌ juyáá Ana̱ꞌlóꞌ xúꞌkhue̱n rá. <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />Ikhaa jngó ra̱jáꞌyoo ma̱grui̱gú ñajun ríge̱ꞌ mbáa xa̱bo̱ tsí níkhú jayu ninimbo̱o̱ꞌ jaꞌyoo Ana̱ꞌlóꞌ, ra̱ꞌkhá makúxe̱-mine̱e̱ꞌ guéño jamí ma̱xpátuáꞌáa̱n ná ma̱ꞌne-numaa̱ aꞌkhúu̱n xómá rí ma̱gíꞌnuu gixa̱a̱. <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />Mangaa máꞌ ndaꞌyóo rí xa̱bo̱ tsí tsínimbu̱únꞌ juyáá Jesús máján gúthan ga̱jma̱á numuu̱, kajngó nda̱a̱ rí ra̱máján mi̱ꞌthán ga̱jma̱á numuu̱, jamí ma̱xárákaa̱ ná katsáꞌkhán rí naꞌgí gixa̱a̱.<verse eid="1TI 3:7" /></para>
  <para style="s">Xa̱bo̱ tsí ma̱goo mu̱mbáyí-jmáá ná ñajuun Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />Xúꞌkhue̱n máꞌ xa̱bo̱ tsí nu̱mbáyí-jmáá ná ñajuun Ana̱ꞌlóꞌ: ga̱nindxúu̱n xa̱bo̱ tsí nitiamakúún, ma̱xáꞌne a̱jma̱ ajngúu̱n, ma̱xájngii̱n, ni máꞌ ma̱xáni̱gúu̱nꞌ rí mudaa̱ mbúkha̱a̱ ga̱jma̱á majñu̱u̱ rí mi̱nduwa. <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />Gíꞌmaa rí mune̱-mbáníi̱ gisngáá rí nanimba̱ꞌlóꞌ, awan drígo̱o̱ Ana̱ꞌlóꞌ rí i̱ndo̱ó máꞌ ikhaa̱ ni̱gi̱da̱ꞌ idxu̱u̱ nákhí wajyúú, xúꞌkhue̱n máꞌ mu̱xúni̱i̱ rí xkawe̱ꞌ. <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />Jamí ikhiin tsíge̱ꞌ, jaꞌyoo rí mbi̱ꞌyáá ginii xí máján ini̱i̱. Nda̱wa̱á, xí waꞌyáá rí nda̱a̱ rí ra̱máján mi̱ꞌthán numúu̱, a̱ꞌkhue̱n rí ma̱goo mu̱mbáyí-jmáa̱ ná ñajuun Ana̱ꞌlóꞌ. <verse eid="1TI 3:10" /><verse number="11" style="v" sid="1TI 3:11" />Xúꞌkhue̱n máꞌ go̱ꞌo̱ mangiin, ga̱nindxúu̱n xa̱bo̱ tsí nitiamakúún, mu̱xúthee̱n ajngáa tsixtutaa ga̱jma̱á numúú xa̱bo̱, rí gu̱ndxa̱ꞌwa̱-mi̱jnée̱ mújúu̱n rí muni̱i̱ jamí ga̱nindxúu̱n go̱ꞌo̱ tsí nune̱-mbáníí mbá xúgíí. <verse eid="1TI 3:11" /><verse number="12" style="v" sid="1TI 3:12" />Tsí nu̱mbáyí-jmáá ná ñajuun Ana̱ꞌlóꞌ gíꞌmaa rí ma̱nindxúu̱n xa̱bo̱ tsí mbáwíi a̱ꞌgui̱i, xúꞌkhue̱n máꞌ nuthan-ñajúu̱n mújúu̱n i̱jíi̱n jamí xa̱bo̱ guꞌwúu̱n. <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />Numuu rí xa̱bo̱ tsí máján nu̱mbáyí-jmáá ná ñajuun Ana̱ꞌlóꞌ, ma̱goo mi̱tiamakúu̱n gúne̱ xa̱bo̱ jamí ma̱goo muthee̱n ga̱jma̱á mbá jañii a̱kuíi̱n rí nanimba̱ꞌlóꞌ juꞌyáá ga̱jma̱á numuu Krísto̱ Jesús.<verse eid="1TI 3:13" /></para>
  <para style="s">Maphú mba̱a̱ rí gakon nisngájma Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />Timotéo̱, na̱tháán i̱yi̱i̱ꞌ ríge̱ꞌ ma̱ꞌga inaaꞌ, maske máꞌ gúꞌthu̱u̱n rí ma̱ꞌgá máꞌ wapha gáya̱a̱ꞌlo̱ꞌ. <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />Xí nagajyúꞌ xóó rá, i̱yi̱i̱ꞌ ríge̱ꞌ mambáyúu rí ma̱tha̱ya̱á xáne jaꞌyoo ma̱juwalóꞌ ná majñu̱ú xa̱bo̱ guꞌwóo Ana̱ꞌlóꞌ. Ikháanꞌlóꞌ tsáanꞌ nanimba̱ꞌlóꞌ juꞌyáá Jesús ñajwanlóꞌ xa̱bi̱i Ana̱ꞌlóꞌ tsí xtáa ndaꞌya, ñajwanlóꞌ xó mbá xe̱go̱ rí gído̱o̱ꞌ rí gakon jamí nu̱ña̱wa̱ánlóꞌ ne̱. <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />Gakon máꞌ rí maphú mba̱a̱ rí nisngájmalóꞌ Ana̱ꞌlóꞌ rí ma̱nimba̱ꞌlóꞌ juꞌyáá:</para>
  <para style="b" vid="1TI 3:16" />
  <para style="q" vid="1TI 3:16">Ana̱ꞌlóꞌ nisngájma-mina̱ꞌ xómá mbáa xa̱bo̱ numbaa jayu.</para>
  <para style="q" vid="1TI 3:16">Xu̱u̱ꞌ máꞌ ikhaa̱ niꞌthán rí kuwii̱n,</para>
  <para style="q" vid="1TI 3:16">jamí ndiyáá ánje̱l rí ikhaa̱.</para>
  <para style="q" vid="1TI 3:16">Waꞌthán-raꞌa ajngóo̱ ná inúú xa̱bo̱ tsí ra̱ꞌkhá judío̱ ñajúún,</para>
  <para style="q" vid="1TI 3:16">jamí xa̱bo̱ ninimbu̱únꞌ juyáa̱ ná numbaa.</para>
  <para style="q" vid="1TI 3:16">Ni̱ka̱ jiꞌyáa̱ mikhuíí ga̱jma̱á gamaku.<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="s">Rí nusngáá xa̱bo̱ tsí nu̱ni̱ꞌñáá rí nanimba̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />Mbá jaꞌwu máꞌ iꞌthán Xu̱u̱ꞌ Ana̱ꞌlóꞌ rí awúun mbiꞌi rí na̱ka̱-rayámba̱ numbaa, mbá tikhuun xa̱bo̱ mu̱ni̱ꞌñáá-ranimbu̱únꞌ rí nanimba̱ꞌlóꞌ juꞌyáá, numuu rí mu̱ꞌgíi̱ idxúu̱n rí mi̱nduwa nuthan gíñá xkawi̱inꞌ jamí ma̱nimbúu̱n rí nusngáá xa̱bi̱i gixa̱a̱. <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />Mu̱ꞌgíi̱ idxúu̱n rí nuthan xa̱bo̱ tsí a̱jma̱ inúú jamí mixtutiin, xúꞌkhue̱n máꞌ nánguá ene̱-nuwii̱n mbá jayu rí mate̱ꞌ. <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />Ikhiin xa̱bo̱ tsúꞌkhue̱n nuthan rí ra̱gíꞌmaa muda-mijná xa̱bo̱, jamí ra̱gíꞌmaa mu̱ꞌpholóꞌ mbá tikhu ganitsu. Rúꞌkhue̱n neꞌne-ku̱maa Ana̱ꞌlóꞌ, kajngó ma̱goo mu̱drígúlóꞌ ne̱ tsáanꞌ nanimba̱ꞌlóꞌ juꞌyáa̱ jamí nu̱ꞌne̱-nuwiinlóꞌ rí gakon. Xúꞌkhue̱n máꞌ nu̱rígu̱ulóꞌ gamaku inuu Ana̱ꞌló ga̱jma̱á numuu ne̱. <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />Numuu rí máján mbá xúgíí rí neꞌne-ku̱maa Ana̱ꞌlóꞌ, jamí ra̱jáꞌyalóꞌ mu̱ni̱ꞌñáá nimbá, xí nu̱rígu̱ulóꞌ gamaku inuu Ana̱ꞌlóꞌ ga̱jma̱á numuu ne̱. <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />Na̱gu̱ma-tsakun-rámáá ne̱ ga̱jma̱á majñu̱u̱ ajngáa rawuun Ana̱ꞌlóꞌ jamí ga̱jma̱á majñu̱u̱ rí nu̱rígu̱ulóꞌ gamaku inuu Ana̱ꞌlóꞌ.<verse eid="1TI 4:5" /></para>
  <para style="s">Páblo̱ naꞌthán-múꞌúun Timotéo̱</para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />Xí ikháánꞌ narasngúún a̱ngia̱nꞌlóꞌ rí gakon rí na̱tha̱a̱nꞌ ge̱jyoꞌ, a̱ꞌkhue̱n ma̱nindxa̱a̱ꞌ mbáa yumbáá tsí phú máján eꞌne ñajuun Jesukrísto̱. Xúꞌkhue̱n máꞌ nataxníꞌtsu-mina̱ꞌ ga̱jma̱á ajngáa rí gakon rí nanimba̱ꞌlóꞌ juꞌyáá, jamí ga̱jma̱á gisngáá máján rí nanimba̱a̱ꞌ máꞌ. <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />Ma̱xátha̱ꞌgíi idxa̱a̱ꞌ rí ma̱ta̱dxawíín ajngáa xkáꞌtsa rí nda̱a̱ gamakuu jamí mi̱nduwa rí nuthan xa̱bo̱. I̱wa̱á máján, araxná-mina̱ꞌ tsiakhe̱ rí ma̱tha̱ne̱ rí nandoo Ana̱ꞌlóꞌ. <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />Maske máꞌ lájwíin nambáyúu ná xuyalóꞌ rí nu̱ꞌne̱-tsiakhe̱-mijnálóꞌ rí nuꞌtsínlóꞌ, i̱tha̱án máꞌ nambáyálóꞌ mbá xúgíí rí nu̱ꞌne̱lóꞌ rí nandoo Ana̱ꞌlóꞌ. Numuu rí rúꞌkhue̱n nambáyálóꞌ awúun mbiꞌi rí juwalóꞌ xúge̱ꞌ jamí mangaa máꞌ awúun mbiꞌi rí ma̱ꞌkha̱ nda̱wa̱á. <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />Ajngáa rí gakon ñajuun rúꞌkhue̱n, jamí ga̱náꞌyoo rí ma̱nimbu̱únꞌ ne̱ mbá xúgíin xa̱bo̱. <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />Ikhaa máꞌ numuu rúꞌkhue̱n nu̱ñajunlóꞌ jamí nu̱míni̱ílóꞌ, numuu rí wéje̱ máꞌ a̱kia̱nꞌlóꞌ juꞌyáá Ana̱ꞌlóꞌ tsí xtáa ndaꞌya. Ikhaa̱ ñajuu̱n tsí naꞌne-jáwíi̱n mbá xúgíin xa̱bo̱ numbaa, jamí i̱wa̱á máꞌ tsí nanimbu̱únꞌ juyáa̱.<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />Arasngúún mbá xúgíí rúꞌkhue̱n a̱ngia̱nꞌlóꞌ jamí arathúu̱n rí mune̱-mbáníi̱ ne̱. <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />Nimbáa ma̱xándxaꞌwá-mina̱ꞌ rí nda̱a̱ numaaꞌ numuu rí xóó dxáma ñajwaanꞌ. A̱ꞌkhue̱n gakon, araxná-mina̱ꞌ tsiakhe̱ rí ma̱nindxa̱a̱ꞌ mbá xkri̱da mbuyáá i̱ꞌwíin tsí nanimbu̱únꞌ juyáá Ana̱ꞌlóꞌ. Máján gáꞌne mbá xúgíí xó rí na̱tsi̱ndxákuun, xó rí nathane̱, xó rí nandaaꞌ xtañúú xa̱bo̱, xó rí wéje̱ a̱kia̱anꞌ ná inuu Ana̱ꞌlóꞌ, xúꞌkhue̱n máꞌ xó rí jaꞌwu xtaa. <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />Awúun máꞌ rí xóó tsíka gáya̱a̱ꞌ a̱ꞌkhue̱n, ma̱xáta̱tsi̱ꞌñáá rí naraxnuu ajngáa rawuun Ana̱ꞌlóꞌ ná inúú a̱ngia̱nꞌlóꞌ, xúꞌkhue̱n máꞌ arathán-múꞌúu̱n jamí arasngúu̱n. <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />Ma̱xáta̱tsi̱ꞌñáá rí nathane̱ ñajun rí nijanáaꞌ ma̱tha̱ne̱, ikhaa rí nijanáaꞌ nákhí nitadxawíín ajngáa rí ni̱rawíjnga̱a xa̱bo̱ buanuu ede̱ jamí ni̱xkra̱me̱e̱ꞌ idxa̱a̱ꞌ.<verse eid="1TI 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 4:15" />Athaꞌgíi a̱kia̱anꞌ rí ma̱tha̱ne̱ mbá xúgíí rí na̱tha̱a̱nꞌ ge̱jyoꞌ, jamí ma̱xáta̱tsi̱ꞌñáá rí nathane̱ ne̱, kajngó mbá xúgíin mbuyáá rí na̱gi̱do̱o̱ꞌ ñajun rí nathane̱. <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />A̱tia̱wa̱án xtaya-mina̱ꞌ máꞌ ikháánꞌ jamí a̱tia̱wa̱án xó rí narasngúún xa̱bo̱. Ariajún xa̱ꞌ ná ajngóo Ana̱ꞌlóꞌ, numuu rí ído̱ nathane̱ rúꞌkhue̱n, ma̱tha̱ne̱-jríya̱ꞌ-mina̱ꞌ máꞌ ikháánꞌ jamí ma̱jáwíin tsí nu̱dxawíín rí narathán mangaa.<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="s">Xáne gíꞌmaa ma̱xtáa Timotéo̱ gajmíí xa̱bi̱i Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />Ma̱xáta̱xpríguíí mbáa táta̱-xi̱ꞌñú, a̱ꞌkhue̱n gakon, arathán-máꞌáa̱n asndo xómá ana̱a̱ꞌ. Xómáꞌ tsí jñáma rá, athañúu̱ asndo xómá dxíya̱a̱ꞌ. <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />Xúꞌkhue̱n máꞌ gáthañu̱ú tsí nána̱-xíñu asndo xómá ru̱dáaꞌ. Xómáꞌ tsí i̱jín-go̱ꞌo̱ rá, atiamakúu̱n asndo xómá jñágiáaꞌ, ga̱ꞌne jaꞌwu a̱kia̱anꞌ ga̱jma̱á nindxúu̱n.<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />Atambáñúú go̱ꞌóxuáꞌa tsí gakon rí ndawi̱in a̱ngui̱ín. <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />I̱ndo̱ó máꞌ numuu rí, xí mbáa a̱ꞌgóxuáꞌa gíꞌdiin i̱ji̱in o i̱jín-xíñii mbo̱ꞌ, ginuu̱ ikhii̱n jaꞌñúu̱ rí muxnáa̱ rí ndaꞌyóo̱. Gu̱mbáñúu̱ xa̱bo̱ guꞌwúu̱n, kajngó xkuaꞌnii gúra̱khuáa̱ ñawúún anúu̱ rí watambáñúu̱ mangii̱n. Numuu rí rúꞌkhue̱n máján jamí na̱ni̱gu̱u̱ꞌ Ana̱ꞌlóꞌ rí ma̱gu̱ma. <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />Mbáa tsí gakon rí a̱ꞌgóxuáꞌa ñajuun jamí ninguanúu mbáwíi, gíꞌthu̱u̱n rí mi̱tambáyíi̱ gáꞌne Ana̱ꞌlóꞌ, xúꞌkhue̱n máꞌ mbiꞌíí mbruꞌwíín naꞌthán-jáñuu̱ jamí na̱ndo̱ꞌo̱o̱ rí mambáyúu̱. <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />Xómáꞌ a̱ꞌgóxuáꞌa tsí naꞌne i̱ndo̱ó máꞌ rí na̱ni̱gu̱u̱ꞌ xuyuu, asndo xó nijáñuu̱ máꞌ jaꞌnii, maske máꞌ xtáa̱ ndaꞌyee̱ xóó. <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />Ikhaa jngó, arathán-ñájúu̱n mbá xúgíí rí na̱tha̱a̱nꞌ ge̱jyoꞌ, kajngó ma̱nindxúu̱n xa̱bo̱ tsí nda̱a̱ rí ra̱máján mi̱ꞌthán ga̱jma̱á numúú. <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />Xí mbáa tsíxná-gamiéjuun rí mambáñúú xa̱bo̱ tsí mijngi jaꞌñúú, jamí i̱tha̱án máꞌ tsí ñajúún xa̱bo̱ guꞌwóo̱, xa̱bo̱ tsúꞌkhue̱n niniñuu-ranimbo̱o̱ꞌ rí nanimba̱ꞌlóꞌ juꞌyáá, jamí i̱tha̱án máꞌ ra̱máján naꞌnii̱ ikhaa̱ xó rí mbáa tsí tsínimbo̱o̱ꞌ jaꞌyoo Ana̱ꞌlóꞌ.<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />A̱gi̱ꞌma mbiꞌyuu rí mi̱tambáyíí i̱ndo̱ó máꞌ a̱ꞌgóxuáꞌa tsí gíꞌdoo máꞌ atsú skíñú (60) tsiguu, tsí mbáwíi má a̱jmba̱a ni̱gi̱ꞌdaa. <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />Xúꞌkhue̱n nuthan xa̱bo̱ rí niꞌnii̱ rí máján: neꞌne-mbajii̱n mújúu̱n i̱jii̱n, máján ni̱grui̱gúu̱n ná guꞌwóo̱ xa̱bo̱ tsí naguwá i̱mba̱ janíí, nixrígú-mine̱e̱ꞌ rí nimbáñúu̱ xa̱bi̱i Ana̱ꞌlóꞌ, jamí nimbáñúu̱ tsí júwa̱ꞌ awúun gaꞌkho̱. Xí mbá xúgíí rúꞌkhue̱n máján niꞌnii̱, jaꞌyoo̱ rí ma̱gi̱ꞌma mbiꞌyuu̱ rí mi̱tambáyíi̱.<verse eid="1TI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11" />Xómáꞌ go̱ꞌóxuáꞌa tsí xóó máꞌ nána̱ tikhu ñajúún, ma̱xíya̱ máꞌ mbiꞌñúu̱ ikhii̱n. Numuu rí ído̱ na̱ni̱gúu̱nꞌ muni̱i̱ rí na̱nda̱ꞌa̱ xuñúu̱, a̱ꞌkhue̱n nandúu̱n mu̱nu̱jwíi̱n mbu̱júꞌ, jamí nune̱-tsíngua̱ꞌ-mijnée̱ inuu Krísto̱. <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />Rí xkuaꞌnii ini̱i̱, mbuye̱e̱ xkuíya̱ gáꞌne Ana̱ꞌlóꞌ, numuu rí tsíne̱-mbáníi̱ rí ginii ni̱xu̱da̱ꞌ-mi̱jnée̱ rí muni̱i̱. <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />Mangaa máꞌ naguꞌúu̱n rí ma̱nindxúu̱n go̱ꞌo̱ tsí naskúún, jamí nagóo̱-rangruꞌúu̱n mbámbá guꞌwúún xa̱bo̱. Jamí ra̱ꞌkhá máꞌ i̱ndo̱ó naskúu̱n, rí mangaa máꞌ nangrigúu̱n judúu̱n tsixuxtaa ga̱jma̱á numúú xa̱bo̱. Xúꞌkhue̱n máꞌ nu̱xu̱da̱ꞌ-mi̱jne̱e̱ ná ra̱jáꞌñúu̱ jamí nuthee̱n rí ra̱gíꞌmaa muthee̱n. <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />Ikhaa numuu rúꞌkhue̱n, nandoꞌ rí mu̱nu̱ju̱nꞌ go̱ꞌóxuáꞌa tsí xóó nána̱ tikhu ñajúún. Gune̱-mbajii̱n i̱jíi̱n, xúꞌkhue̱n máꞌ gune̱-mba̱ꞌwuu̱n xa̱bo̱ guꞌwúu̱n. A̱ꞌkhue̱n rí tsí gíꞌdáanꞌlóꞌ sia̱nꞌ ma̱xáxóo maꞌthée̱n nimbá rí xkawe̱ꞌ ga̱jma̱á numalóꞌ. <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />Numuu rí mbá tikhuun go̱ꞌóxuáꞌa ni̱ni̱ñáa̱ máꞌ rí nanimbúu̱n juyáa̱ Ana̱ꞌlóꞌ jamí nagóo̱ máꞌ tsu̱du̱u̱ Satanás.<verse eid="1TI 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TI 5:16" />Xí mbáa tsí nanimbo̱o̱ꞌ jaꞌyoo Jesús júwa̱ꞌ go̱ꞌóxuáꞌa ná guꞌwóo̱, ikhaa̱ máꞌ gíꞌmaa rí mambáñúu̱. A̱ꞌkhue̱n ma̱xáꞌyóo máꞌ rí mi̱tambáñúu̱ gúne̱ tsí nanimbu̱únꞌ juyáá Jesús, xkuaꞌnii kajngó ma̱ri̱gá rí mi̱tambáñúú ga̱jma̱á tsí gakon rí go̱ꞌóxuáꞌa ñajúún.<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />Xómáꞌ xa̱bo̱ buanuu tsí máján nune̱-mbáníí ñajun drígu̱ún, jaꞌyoo rí mi̱tiamakúu̱n i̱tha̱án xóó. Jamí i̱tha̱án máꞌ tsí nuthan-raꞌa jamí nusngáá. <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" />Numuu rí ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ ka̱ma naꞌthán: «Ma̱xáta̱xu̱ꞌdáa ama rawuun xede̱ ído̱ rí nathrígú ixí iña».<note caller="+" style="f"><char style="fr" closed="false">5.18 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yi̱i̱ꞌ rí naꞌthán ikhaa máꞌ xtángoo 25.4.</char></note> Jamí ka̱ma naꞌthán mangaa: «Xa̱bo̱ tsí nañajun jaꞌyoo rí madaa̱ numuu̱».<note caller="+" style="f"><char style="fr" closed="false">5.18 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Lúka̱s 10.7.</char></note><verse eid="1TI 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1TI 5:19" />Ma̱xánimba̱a̱ꞌ ído̱ rí nuni̱i̱ aꞌkhúun mbáa xa̱bo̱ nikhi̱i̱ ede̱. I̱ndo̱ó máꞌ xí júwa̱ꞌ a̱jmi̱i atsúun tsí naꞌne inúú rí niꞌnii̱, a̱ꞌkhue̱n rí ma̱nimba̱a̱ꞌ. <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />Xómáꞌ tsí tsíni̱ꞌñáá rí nune̱ aꞌkhán, ataxprígúu̱n inúú mbá xúgíin tsí nanimbu̱únꞌ juyáá Jesús, kajngó tsí i̱ꞌwíin ma̱mi̱ꞌñúú mangiin.<verse eid="1TI 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1TI 5:21" />Ná inuu Ana̱ꞌlóꞌ xúꞌkhue̱n máꞌ ná inuu Tátiálóꞌ Jesukrísto̱, jamí ná inúú ánje̱l tsí niraꞌwíin Ana̱ꞌlóꞌ, phú na̱xna̱ngáwaaꞌ rí ma̱tha̱ne̱-mbáníí rí na̱tha̱a̱nꞌ ge̱jyoꞌ. Ma̱xátraꞌwíi nimbáa tsí ma̱tha̱ñi̱í rí májáan, jamí mbéꞌtháán awan gájmaaꞌ ga̱jma̱á numúu̱ mbá xúgíi̱n. <verse eid="1TI 5:21" /><verse number="22" style="v" sid="1TI 5:22" />Ma̱xáꞌcha̱a̱ꞌ guéño rí ma̱ta̱xkráma idxu̱u̱ asndo nimbáa rí ma̱nindxu̱u̱ xa̱bo̱ ede̱, ni máꞌ ma̱xátha̱ne̱ mangáánꞌ aꞌkhán rí nune̱ i̱ꞌwíin. I̱wa̱á máján rí ga̱ꞌne máꞌ xúꞌkhue̱n jaꞌwu a̱kia̱anꞌ.<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />Ga̱jma̱á numuu rí phú wa̱yi̱í ndayóo nandii awáanꞌ, náxígíin i̱ndo̱ó máꞌ yaꞌsi. Añi̱i̱ tháan iyoo úba̱ rí ni̱ga̱yu̱u̱ꞌ mangaa kajngó mambáyúu ne̱ awáanꞌ.<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />Júwa̱ꞌ mbá tikhuun xa̱bo̱ tsí wapha máꞌ nakujma aꞌkhúún, maske máꞌ asndo xóó tsígu̱ma-mbáníí ga̱jma̱á numúu̱. Xómáꞌ i̱ꞌwíin xa̱bo̱ asndo nda̱wa̱á na̱ma̱ꞌtha-ri̱ya̱ꞌ aꞌkhúu̱n. <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />Xúꞌkhue̱n máꞌ mangaa, nakujma jaꞌwu rí máján nune̱ xa̱bo̱. Jamí rí máján nune̱ xa̱bo̱ rí tsíkujma rá, ma̱ga̱nú tsiakhe̱ mbiꞌi rí ma̱kujma ne̱.<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />Mbá xúgíin tsí ñajúún yumbáá tsí waꞌtsi̱in, jámba̱ miꞌtsú jaꞌñúu̱ rí mbuya̱-makúu̱n ña̱ꞌñíi̱, kajngó ma̱xíꞌthán xkawe̱ꞌ ga̱jma̱á numuu Ana̱ꞌlóꞌ ni máꞌ gisngáá drígo̱o̱. <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />Jamí yumbáá waꞌtsi̱in tsí guáꞌdiin ña̱ꞌñíí tsí nanimbu̱únꞌ juyáá Jesús, mu̱xúni̱ꞌñáa̱ rí nduya-makúu̱n. A̱ꞌkhue̱n gakon i̱wa̱á máján jaꞌyoo rí mune̱-mba̱ꞌwuu̱n, numuu rí xa̱bo̱ máꞌ tsí phú nandúu̱n juñúu̱ nune̱-mba̱ꞌwuu̱n, jamí xa̱bo̱ tsúꞌkhue̱n nanimbúu̱n máꞌ juyáa̱ Jesús mangii̱n. Ikhaa rúꞌkhue̱n gára̱sngúu̱n jamí arathán-múꞌúu̱n rí mune̱-mbáníi̱ ne̱.<verse eid="1TI 6:2" /></para>
  <para style="s">Dí jaꞌnii gisngáá rí mi̱nduwa</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3" />Xí mbáa xa̱bo̱ naꞌsngáá rí mbrúthun jayu, xúꞌkhue̱n máꞌ ra̱jáꞌnii ne̱ xómá rí gakon niꞌsngáá Tátiálóꞌ Jesukrísto̱, jamí tsíꞌsngálóꞌ ne̱ xáne ma̱juwalóꞌ rí mu̱ꞌne̱ rí nandoo Ana̱ꞌlóꞌ, <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />ikhaa xa̱bo̱ tsúꞌkhue̱n nakúxe̱-mina̱ꞌ jamí tsíma̱ñuu̱ nitháan. Na̱ni̱gu̱u̱ꞌ ma̱tsa̱ñu̱u̱ꞌ ga̱jma̱á numuu ajngáa rí nda̱a̱ numuu, rí i̱ndo̱ó máꞌ naꞌne ne̱ rí ma̱jma̱a̱ xkujndu. Jamí ikhín ríga̱ tsixígu̱, xkujndu, ajngáa xkawe̱ꞌ, tsíya̱-maku-mijná xa̱bo̱, <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />jamí tsíni̱ꞌñáa̱ rí na̱tsa̱ñúu̱ꞌ. Xa̱bo̱ tsúꞌkhue̱n guáꞌdáá ju̱ma̱ rí xkawe̱ꞌ jamí tsíne̱-nuwii̱n rí gakon, xúꞌkhue̱n máꞌ na̱ju̱múu̱ rí mudaa̱ mbúkha̱a̱ ga̱jma̱á majñu̱u̱ rí na̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ. Athane̱-níjníí-mina̱ꞌ inúú xa̱bo̱ tsí xkuaꞌnii jaꞌñúú.<note caller="+" style="f"><char style="fr" closed="false">6.5 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «Athane̱-níjníí-mina̱ꞌ inúú xa̱bo̱ tsí xkuaꞌnii jaꞌñúú».</char></note> <verse eid="1TI 6:5" /><verse number="6" style="v" sid="1TI 6:6" />Gakon máꞌ rí phú mba̱a̱ mambáyálóꞌ rí mu̱ꞌne̱lóꞌ rí nandoo Ana̱ꞌlóꞌ, xí numuu rí gagi a̱kia̱nꞌlóꞌ ga̱jma̱á numuu rí guáꞌdáálóꞌ. <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />Numuu rí nda̱a̱ mbá jayu rí juꞌyálóꞌ nákhí ni̱gu̱máálóꞌ ná numbaa ríge̱ꞌ, xúꞌkhue̱n máꞌ nda̱a̱ rí ma̱goo mbu̱ꞌyálóꞌ mu̱ꞌgua̱aꞌlóꞌ ído̱ rí ma̱ja̱ñálóꞌ. <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />Ikhaa jngó, xí guaꞌdáálóꞌ rí napholóꞌ jamí guaꞌdáálóꞌ xtíin rí nu̱ju̱ꞌwánlóꞌ, gu̱ꞌyáálóꞌ rí mbájndi máꞌ rúꞌkhue̱n. <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />Xómáꞌ xa̱bo̱ tsí phú nandúún rí mu̱guaꞌdáá, na̱rákii̱n ná awúun katsáꞌkhúun rí tsirájá. A̱ꞌkhue̱n na̱wa̱ꞌa̱ mi̱ndaꞌkho a̱kuíi̱n rí mu̱guaꞌdáa̱ rí nda̱a̱ numuu jamí rí ma̱ꞌne-ngíníi̱. Ikhaa rúꞌkhue̱n naꞌne-gámbi̱in jamí naꞌne-mbáti̱gi̱in xa̱bo̱. <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />Numuu ído̱ rí xa̱bo̱ nandoo jaꞌyoo mbúkha̱a̱, ikhín na̱ꞌkha̱ mbá xúgíí inii rí ra̱máján. Júwa̱ꞌ mbá tikhuun xa̱bo̱ tsí nandúún mune̱-matíí mbúkha̱a̱, ikhiin tsúꞌkhue̱n ni̱ni̱ꞌñáá-ranimbu̱únꞌ rí nanimba̱ꞌlóꞌ, jamí nagíꞌníi̱ mbaꞌa inii gaꞌkho̱.<verse eid="1TI 6:10" /></para>
  <para style="s">Páblo̱ naxnángawoo Timotéo̱ rí ma̱ꞌne mbánuu ñajuun Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />Xómáꞌ ikháánꞌ rá, Timotéo̱, tsáán xa̱bi̱i Ana̱ꞌlóꞌ ñajwaanꞌ, athane̱-tsíngua̱ꞌ-mina̱ꞌ inuu mbá xúgíí tsirájá rúꞌkhue̱n. Araxná-mina̱ꞌ tsiakhe̱ ma̱tha̱ne̱ rí máján, athane̱ rí nandoo Ana̱ꞌlóꞌ, jamí ma̱xáta̱tsi̱ꞌñáá-ranimba̱a̱ꞌ rí nanimba̱ꞌlóꞌ. Ga̱gaaꞌ xtañúú xa̱bo̱, ga̱ꞌngo̱o̱ a̱kia̱anꞌ jamí gamakuíín gáꞌne. <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />Araxná-mina̱ꞌ tsiakhe̱ rí ma̱tia̱wa̱án gisngáá rí nanimba̱ꞌlóꞌ juꞌyáá, kajngó ma̱janáaꞌ rí ma̱ra̱xtaa jámuu. Ikhaa numuu rúꞌkhue̱n nindxaꞌwáaꞌ Ana̱ꞌlóꞌ, nákhí nirathán mbá jaꞌwu ná inúú mbaꞌiin xa̱bo̱ rí nanimba̱a̱ꞌ xtayáa̱. <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" />Ná inuu Ana̱ꞌlóꞌ tsí neꞌne-ku̱maa mbá xúgíí rí ríga̱, jamí ná inuu Jesukrísto̱, tsí mbá jaꞌwu niꞌthán ná inuu Pónsio̱ Piláto̱, na̱xna̱-ñájwaanꞌ ríge̱ꞌ. <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />Athane̱-mbáníí mbá xúgíí rí na̱tha̱a̱nꞌ ge̱jyoꞌ, kajngó nda̱a̱ nimbá rí ra̱máján mi̱ꞌthán ga̱jma̱á numaaꞌ. Athane̱ rúꞌkhue̱n asndo gáꞌkha̱a Tátiálóꞌ Jesukrísto̱. <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />I̱ndo̱ó Ana̱ꞌlóꞌ ma̱ꞌne rí ma̱ga̱nú mbiꞌi tsímáá rúꞌkhue̱n. Ana̱ꞌlóꞌ ñajuun tsí naꞌthán-ñájuun mbá xúgíí numbaa, mangaa máꞌ ñajuu̱n Thúngaa tsí naꞌthán-ñájúún mbá xúgíin thúngaa, jamí Xa̱bo̱ Ede̱ tsí naꞌthán-ñájúún mbá xúgíin xa̱bo̱ ede̱. <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />Mbáwíi máꞌ Ana̱ꞌlóꞌ xtáa mbá jámuu, jamí xtáa̱ ná rí nambiꞌi-taꞌa gakhe̱ agu, rí narikhoo ma̱tu̱malóꞌ ikhín. Nimbáa xa̱bo̱ táꞌyoo inuu̱, ni máꞌ ma̱xáꞌngo̱o̱ mba̱ꞌyoo̱. I̱ndo̱ó máꞌ ikhaa̱ jaꞌyoo rí mi̱tiamakuíi̱, jamí mbáwíi̱ máꞌ ikhaa̱ phú gíꞌdoo̱ tsiakhe̱ asndo jámuu mbiꞌi. Xkuaꞌnii gáꞌne.<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />Arathúún xa̱bo̱ tsí guáꞌdáá guéño ná numbaa ríge̱ꞌ, rí mu̱xúxu̱xí-mijnée̱ ni máꞌ mu̱xútsijii̱ a̱kuíi̱n ná inuu rí guáꞌdáa̱ guéño, numuu rí tsígajyúu ne̱. A̱ꞌkhue̱n gakon, gu̱tsijii̱ a̱kuíi̱n ná inuu Ana̱ꞌlóꞌ tsí nanújngo-rámuu naxnálóꞌ mbá xúgíí rí ndaꞌyálóꞌ kajngó ma̱ꞌdxu a̱kia̱nꞌlóꞌ ga̱jma̱á numuu ne̱. <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />Arathúu̱n rí muni̱i̱ rí máján mbámbá mbiꞌi, kajngó ma̱tíí rí máján nuni̱i̱. Gagi a̱kuíi̱n gúxnee̱ rí guáꞌdáa̱, xúꞌkhue̱n máꞌ gagi a̱kuíi̱n gúxpi̱ꞌtha̱a̱ ne̱. <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />Xkuaꞌnii gúni̱i̱ kajngó mu̱ꞌgíi̱ nakhúu rí mu̱guaꞌdáa̱ ná mbiꞌi rí ma̱ꞌkha̱ nda̱wa̱á, jamí ma̱janúu̱ rí ma̱ju̱wée̱ꞌ jámuu.<verse eid="1TI 6:19" /></para>
  <para style="s">I̱mbo̱ó rí Páblo̱ naxnángawoo Timotéo̱</para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />Ikháánꞌ Timotéo̱, athane̱-mbáníí rí waꞌxnángawaaꞌ ma̱tha̱ne̱. Ma̱xátha̱ꞌgíi idxa̱a̱ꞌ ma̱ta̱dxawíín ajngáa nda̱a̱ gamakuu rí nda̱a̱ nitháan numuu, ni máꞌ ma̱xátha̱ꞌgíi idxa̱a̱ꞌ ma̱ta̱dxawíín ajngáa rí nuthan xa̱bo̱ tsí na̱ju̱mu̱ú rí na̱ma̱ñúú guéño. <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />Numuu rí júwa̱ꞌ mbá tikhuun tsí nu̱ꞌgíi idxu̱ún ajngáa rúꞌkhue̱n, ikhaa jngó ni̱ni̱ꞌñáa̱-ranimbúu̱n rí nanimba̱ꞌlóꞌ.</para>
  <para style="p" vid="1TI 6:21">Ana̱ꞌlóꞌ gáꞌne-tsakun-rámááꞌ.<note caller="+" style="f"><char style="fr" closed="false">6.21 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «gáꞌne-tsakun-rámáaꞌlaꞌ».</char></note> Xkuaꞌnii gáꞌne.<note caller="+" style="f"><char style="fr" closed="false">6.21 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «Xkuaꞌnii gáꞌne».</char></note><verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>