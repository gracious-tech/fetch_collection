<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="TIT" style="id">tcfU (57-Tito) - Me̱ꞌpha̱a̱ Mañúwi̱ín (Malinaltepec) (sfm NVI). Traz-ini de ECZ, 16-may a 02-jun2012; c3/v46</book>
  <para style="h">Títo̱</para>
  <para style="toc3">Tt</para>
  <para style="toc2">Títo̱</para>
  <para style="toc1">I̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inuu Títo̱</para>
  <para style="mt2">I̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inuu</para>
  <para style="mt1">Títo̱</para>
  <chapter number="1" style="c" sid="TIT 1" />
  <para style="s">Páblo̱ naraxi̱i Títo̱</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1" />Ikhúúnꞌ ñajunꞌ Páblo̱, yumbée Ana̱ꞌlóꞌ jamí mangaa máꞌ ñajunꞌ mbáa xa̱bo̱ tsí waxúngua̱a̱ꞌ neꞌne Jesukrísto̱. Ikhaa̱ nixúngúu̱nꞌ kajngó xa̱bo̱ tsí niraꞌwíin Ana̱ꞌlóꞌ ma̱we̱je̱ a̱kuíi̱n inuu Ana̱ꞌlóꞌ, jamí mune̱-nuwii̱n rí gakon xáne gíꞌmaa muni̱i̱ rí nandoo Ana̱ꞌlóꞌ. <verse eid="TIT 1:1" /><verse number="2" style="v" sid="TIT 1:2" />A̱ꞌkhue̱n rí ga̱jma̱á mbá jañii a̱kuíi̱n mu̱waꞌthíi̱n rí ma̱ju̱wée̱ꞌ mbá jámuu. Ana̱ꞌlóꞌ, tsí na̱nguá eꞌne-nduwa, nixuda-mine̱e̱ꞌ máꞌ ga̱jma̱á numuu ríge̱ꞌ, asndo nákhí máꞌ xóó táꞌne-ku̱maa̱ numbaa. <verse eid="TIT 1:2" /><verse number="3" style="v" sid="TIT 1:3" />Jamí ído̱ ni̱ga̱nú máꞌ mbiꞌi rá, nisngájmalóꞌ ajngóo̱ ga̱jma̱á majñu̱u̱ rí na̱tha̱n-ráꞌalo̱ꞌ, numuu rí xkuaꞌnii nixnángaweꞌ Ana̱ꞌlóꞌ tsí naꞌne-jríñáaꞌlóꞌ.<verse eid="TIT 1:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="TIT 1:4" />Na̱xu̱ꞌmá i̱yi̱i̱ꞌ ríge̱ꞌ inaaꞌ ikháánꞌ Títo̱, tsáánꞌ phú gakon rí a̱ꞌdéꞌ ñajwaanꞌ ga̱jma̱á numuu rí mbóó ná wéje̱ a̱kia̱nꞌlóꞌ.</para>
  <para style="b" vid="TIT 1:4" />
  <para style="p" vid="TIT 1:4">Ana̱ꞌlóꞌ Mikhuíí jamí Táta̱ Jesukrísto̱ tsí naꞌne-jríñáaꞌlóꞌ gúne̱-tsakun-rámááꞌ, gáñáwíin a̱kuíi̱n juyaa̱ꞌ<note caller="+" style="f"><char style="fr" closed="false">1.4 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «gáñáwíin a̱kuíi̱n juyaa̱ꞌ».</char></note> jamí ikhii̱n máꞌ gúni̱i̱ rí ma̱ra̱xtaa tsímáá.<verse eid="TIT 1:4" /></para>
  <para style="s">Ñajun rí ni̱ge̱ꞌe̱ inuu Títo̱ ma̱ꞌne ná Kréta̱</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5" />Ikhaa numuu rúꞌkhue̱n ni̱ni̱ꞌñáaꞌlo̱ꞌ ná Kréta̱, kajngó ma̱tha̱ne̱-gáxi̱í ñajun rí ninguanúu mixndu, rí ma̱ta̱skuíji̱in xa̱bo̱ buanuu tsí mbuya̱ ikhúún a̱ngia̱nꞌlóꞌ ná mbámbá xuajen, xómá rí ni̱tha̱a̱nꞌlo̱ꞌ nákhí wapha. <verse eid="TIT 1:5" /><verse number="6" style="v" sid="TIT 1:6" />Mbámbáa xa̱bo̱ nikhi̱i̱ tsúꞌkhue̱n jaꞌyoo rí ma̱nindxu̱u̱ mbáa xa̱bo̱ tsí nda̱a̱ nitháan rí ra̱máján mi̱ꞌthán ga̱jma̱á numuu, jamí tsí mbáwíi a̱ꞌgui̱i. Xúꞌkhue̱n máꞌ i̱jii̱n, jaꞌyoo rí ma̱nindxúu̱n tsí nanimbu̱únꞌ juyáá Jesukrísto̱, jamí ndawa̱a̱ tsí naꞌne tsu̱dúu̱n rí ra̱máján ini̱i̱ o najñaguu̱n mbo̱ꞌ. <verse eid="TIT 1:6" /><verse number="7" style="v" sid="TIT 1:7" />Numuu rí tsí ñajuun xa̱bo̱ ede̱, jayée̱ ikhoo ñajun ná guꞌwóo Ana̱ꞌlóꞌ. Ikhaa jngó, ndaꞌyóo rí ma̱nindxu̱u̱ xa̱bo̱ tsí nda̱a̱ nitháan rí ra̱máján mi̱ꞌthán ga̱jma̱á numuu: rí ma̱xánindxu̱u̱ xa̱bo̱ tsí nakúxe̱-mina̱ꞌ, rí ma̱xánindxu̱u̱ xa̱bo̱ tsí i̱ndo̱ó máꞌ najiꞌnáa, rí ma̱xánindxu̱u̱ xa̱bo̱ tsí i̱ndo̱ó máꞌ najnga̱a̱, rí ma̱xánindxu̱u̱ xa̱bo̱ tsí na̱tsa̱ñu̱u̱ꞌ gajmíí xa̱bo̱, ni máꞌ rí ma̱xánindxu̱u̱ xa̱bo̱ tsí na̱ni̱gu̱u̱ꞌ madaa mbúkha̱a̱ ga̱jma̱á majñu̱u̱ rí mi̱nduwa. <verse eid="TIT 1:7" /><verse number="8" style="v" sid="TIT 1:8" />A̱ꞌkhue̱n gakon, ndaꞌyóo rí ma̱grui̱gúu̱n xa̱bo̱ ná guꞌwóo̱, jamí rí ma̱ꞌnii̱ rí máján. Xúꞌkhue̱n máꞌ nandxaꞌwá-mine̱e̱ꞌ mújúu̱n rí ma̱ꞌnii̱, májáan a̱kuii̱n, jaꞌwu xtáa̱, jamí na̱ꞌngo̱o̱ máꞌ naꞌthán-ñájuu̱n xuyuu̱. <verse eid="TIT 1:8" /><verse number="9" style="v" sid="TIT 1:9" />Xúꞌkhue̱n máꞌ mangaa, ndaꞌyóo rí ma̱nindxu̱u̱ mbáa xa̱bo̱ tsí na̱gu̱xi̱i mújúun ajngáa rawuun Ana̱ꞌlóꞌ, xómá phú waꞌsngáa̱, kajngó ma̱goo maꞌthán-múꞌúu̱n i̱ꞌwíin xa̱bo̱ ga̱jma̱á gisngáá rí gakon jamí ma̱ꞌnii̱ rí ma̱nimbu̱únꞌ tsí nawajún-ꞌthi̱ín gisngáá rúꞌkhue̱n.<verse eid="TIT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10" />Numuu rí phú júwa̱ꞌ xa̱bo̱ tsí najñaguun, tsí nune̱-nduwiin xa̱bo̱ ga̱jma̱á gisngáá rí nda̱a̱ mbá jayu numuu. Ikhúúnꞌ na̱tha̱n ga̱jma̱á numúú xa̱bo̱ tsí nuthan rí ndaꞌyóo mbu̱ya̱laꞌ tsina jndi. <verse eid="TIT 1:10" /><verse number="11" style="v" sid="TIT 1:11" />Ikhiin tsúꞌkhue̱n ndaꞌyóo rí ma̱ju̱góo rawúún, numuu rí nune̱-ngra̱ꞌii̱n mbá jañii guꞌwíin xa̱bo̱, jamí ga̱jma̱á numuu rí na̱ni̱gúu̱nꞌ mudaa̱ mbúkha̱a̱, nusngáa̱ rí ra̱jáꞌyoo. <verse eid="TIT 1:11" /><verse number="12" style="v" sid="TIT 1:12" />Asndo mbáa máꞌ tsí ikhii̱n, tsí ni̱gu̱wíjnga̱a ajngáa, niꞌthán: «Tsí xa̱bo̱ Kréta̱, jámba̱ miꞌtsú rí xa̱bo̱ tsí mi̱nduwiin ñajúu̱n. Xu̱kú-xáná jamí xa̱bo̱ i̱ꞌska tsí napeꞌtso mi̱ndaꞌkho ñajúu̱n». <verse eid="TIT 1:12" /><verse number="13" style="v" sid="TIT 1:13" />Phú gakon rí niꞌthán xa̱bo̱ tsúꞌkhue̱n. Ikhaa jngó, ataxprígúu̱n gakhe̱, kajngó ma̱ꞌne gúkúu̱n jamí mu̱xúni̱ꞌñáa̱ rí waꞌsngúu̱n ga̱jma̱á numuu Jesukrísto̱. <verse eid="TIT 1:13" /><verse number="14" style="v" sid="TIT 1:14" />Atambáñúu̱ rí mu̱xúꞌgíi̱ idxúu̱n ajngáa mi̱nduwa rí ni̱ka̱ma̱xu̱ún xa̱bo̱ judío̱, ni máꞌ xtángoo rí nene̱-ku̱maa xa̱bo̱ tsí nune̱-tsíngua̱ꞌ-mijná inuu rí gakon.<verse eid="TIT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 1:15" />Xa̱bo̱ tsí jaꞌwuun, mbá xúgíí máꞌ jaꞌwu iyáa̱ rí ikhii̱n. Xómáꞌ tsí niꞌchíin jamí tsínimbu̱únꞌ juyáá Ana̱ꞌlóꞌ rá, mbá xúgíí máꞌ na̱nguá jaꞌwu iyáa̱ rí ikhii̱n, numuu rí asndo ju̱múu̱ jamí asndo a̱kuíi̱n máꞌ niꞌchúu. <verse eid="TIT 1:15" /><verse number="16" style="v" sid="TIT 1:16" />Nuthee̱n rí nune̱-nuwii̱n Ana̱ꞌlóꞌ, xómáꞌ rí nuni̱i̱ naꞌthán rí tsíne̱-nuwii̱n. Rí xkuaꞌnii jaꞌñúu̱, phú tsíyoo gíꞌñúu̱ ene̱ xa̱bo̱, phú najñaguu̱n jamí tsíyoo muni̱i̱ asndo nimbá rí máján.<verse eid="TIT 1:16" /></para>
  <chapter eid="TIT 1" />
  <chapter number="2" style="c" sid="TIT 2" />
  <para style="s">Rí nitháán ma̱ꞌne mbámbáa xa̱bi̱i Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1" />Xómáꞌ ikháánꞌ rá, Títo̱, arathán-múꞌúún xa̱bi̱i Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ gisngáá rí gakon. <verse eid="TIT 2:1" /><verse number="2" style="v" sid="TIT 2:2" />Tsí ñajúún táta̱-xi̱ꞌñú jaꞌyoo rí ma̱nindxúu̱n xa̱bo̱ tsí nu̱ndxa̱ꞌwa̱-mijná mújúún rí mune̱, tsí tsianuu júwa̱ꞌ, tsí wéje̱ gúkúu a̱kui̱ín ná inuu Ana̱ꞌlóꞌ, tsí nandúún juñúú xa̱bo̱ jamí phú mba̱a̱ a̱kui̱ín.<verse eid="TIT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="TIT 2:3" />Xúꞌkhue̱n máꞌ nána̱-xíñu mangaa, ga̱ju̱wée̱ꞌ xómá xa̱bo̱ tsí nduya-makuíí Ana̱ꞌlóꞌ. Ma̱xánindxúu̱n go̱ꞌo̱ tsí ngrigu̱ún judúún tsixtutaa, ni máꞌ ma̱xájngii̱n. Ga̱nindxúu̱n mbá xkri̱da rí máján, <verse eid="TIT 2:3" /><verse number="4" style="v" sid="TIT 2:4" />jamí gusngúu̱n go̱ꞌo̱ tsí na̱nguá nikhi̱in xóó rí ma̱gúu̱n juñúu̱ a̱jmbíi̱n jamí i̱jíi̱n. <verse eid="TIT 2:4" /><verse number="5" style="v" sid="TIT 2:5" />Xúꞌkhue̱n máꞌ gusngúu̱n rí mu̱ndxa̱ꞌwa̱-mijnée̱ mújúu̱n rí muni̱i̱, rí jaꞌwu a̱kuíi̱n gáꞌne, rí mune̱-mba̱ꞌwii̱n mújúu̱n xa̱bo̱ guꞌwúu̱n, jamí rí mune̱-mbáníi̱ rí naꞌthán a̱jmbíi̱n, kajngó mu̱xúthan xkawe̱ꞌ xa̱bo̱ ga̱jma̱á numuu ajngáa rawuun Ana̱ꞌlóꞌ.<verse eid="TIT 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6" />Xúꞌkhue̱n máꞌ mangaa, arathán-múꞌúún jñáma rí mu̱ndxa̱ꞌwa̱-mijná mújúu̱n rí muni̱i̱. <verse eid="TIT 2:6" /><verse number="7" style="v" sid="TIT 2:7" />Jmína̱áꞌ máꞌ ikháánꞌ jaꞌyoo rí ma̱nindxa̱a̱ꞌ mbá xkri̱da rí máján mbuyáa̱ ga̱jma̱á majñu̱u̱ mbá xúgíí rí nathane̱. Atasngájma rí kuwíín jamí gamakuíín ído̱ rí narasngáá. <verse eid="TIT 2:7" /><verse number="8" style="v" sid="TIT 2:8" />Arathán rí máján jámba̱ miꞌtsú, kajngó nimbáa xa̱bo̱ ma̱xáꞌthán rí ra̱máján ga̱jma̱á numaaꞌ. A̱ꞌkhue̱n rí xa̱bo̱ tsí tsíñúú gúyalóꞌ ma̱ti̱ñúu̱ꞌ jamí ma̱xáxóo muthee̱n rí xkawe̱ꞌ ga̱jma̱á numalóꞌ.<verse eid="TIT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9" />Arathán-múꞌúún yumbáá tsí waꞌtsi̱in rí gune̱-mbáníi̱ mbá xúgíí rí nuthan ña̱ꞌñíi̱, rí ga̱ꞌne gamakuii̱n jamí mu̱xúriꞌñee̱ nikhuáa. <verse eid="TIT 2:9" /><verse number="10" style="v" sid="TIT 2:10" />Na̱nguá gíꞌmaa rí mune̱-ku̱ꞌwúu̱n ña̱ꞌñíi̱, rí ga̱nindxúu̱n xa̱bo̱ tsí jmbiin ga̱jma̱á majñu̱u̱ mbá xúgíí rí nuni̱i̱, kajngó mbá xúgíin xa̱bo̱ gúyáá rí phú mitsaan gisngáá drígo̱o̱ Ana̱ꞌlóꞌ tsí naꞌne-jríñáaꞌlóꞌ.<verse eid="TIT 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11" />Numuu rí nisngájma máꞌ Ana̱ꞌlóꞌ rí phú na̱ni̱gu̱u̱ꞌ jaꞌñúu̱ xa̱bo̱, kajngó ma̱goo ma̱jáwíin mbá xúgíin xa̱bo̱. <verse eid="TIT 2:11" /><verse number="12" style="v" sid="TIT 2:12" />Ikhaa rí phú na̱ni̱gu̱u̱ꞌ Ana̱ꞌlóꞌ jaꞌyalóꞌ naꞌsngálóꞌ rí mu̱ni̱ꞌñáálóꞌ rí xkawe̱ꞌ, jamí rí na̱ni̱gu̱ún xa̱bo̱ ná numbaa ríge̱ꞌ, kajngó mu̱ndxa̱ꞌwa̱-mijná májánlóꞌ rí mu̱ꞌne̱lóꞌ awúun mbiꞌi rí juwalóꞌ ná numbaa. Xúꞌkhue̱n máꞌ rí mu̱ꞌne̱lóꞌ rí máján jamí ma̱juwalóꞌ xómá rí nandoo Ana̱ꞌlóꞌ, <verse eid="TIT 2:12" /><verse number="13" style="v" sid="TIT 2:13" />awúun rí ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ guáꞌthi̱ínlóꞌ ma̱ga̱nú mbiꞌi rí phú wáá ído̱ rí ma̱ꞌkha̱a Ana̱ꞌlóꞌ Jesukrísto̱, tsí phú mba̱a̱ jamí tsí naꞌne-jríñáaꞌlóꞌ. <verse eid="TIT 2:13" /><verse number="14" style="v" sid="TIT 2:14" />Jesukrísto̱ nixnáxe̱-mine̱e̱ꞌ rí ma̱ja̱ñúu̱ ga̱jma̱á numalóꞌ, kajngó maꞌtse̱-ri̱ñáa̱ꞌlóꞌ inuu mbá xúgíí rí xkawe̱ꞌ jamí ma̱ꞌne-jaꞌwáa̱nꞌlóꞌ rí ma̱nindxa̱ꞌlóꞌ xa̱bo̱ xuajñuu̱, tsí nune̱ i̱ndo̱ó máꞌ rí máján.<verse eid="TIT 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15" />Mbá xúgíí rúꞌkhue̱n jaꞌyoo rí ma̱ra̱sngúún xa̱bo̱. Arathán-múꞌúu̱n jamí ataxprígúu̱n ga̱jma̱á mbá xúgíí ski̱yu̱u̱ꞌ ajngóo Ana̱ꞌlóꞌ. Ma̱xára̱xna̱á asndo nimbáa xa̱bo̱ rí ma̱ꞌñaaꞌ asndo xó rí nda̱a̱ numaaꞌ.<verse eid="TIT 2:15" /></para>
  <chapter eid="TIT 2" />
  <chapter number="3" style="c" sid="TIT 3" />
  <para style="s">Xó jaꞌyoo rí ma̱ju̱wá tsí wéje̱ a̱kui̱ín ná inuu Jesukrísto̱</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1" />Arathúu̱n mbá xúgíi̱n rí ma̱xámbumúu̱ rí mu̱ni̱ꞌñá-mijnée̱ rí mi̱ꞌthán-ñájúu̱n gúne̱ thúngaa jamí xa̱bo̱ ñajun. Xúꞌkhue̱n máꞌ rí gune̱-mbáníi̱ rí nithúu̱n, jamí ga̱ju̱wée̱ꞌ xawi rí muni̱i̱ mbá xúgíí inii rí máján. <verse eid="TIT 3:1" /><verse number="2" style="v" sid="TIT 3:2" />Mu̱xúthee̱n rí xkawe̱ꞌ ga̱jma̱á numuu nimbáa, ni máꞌ ma̱xátsa̱ñúu̱ gajmíi̱ xa̱bo̱. A̱ꞌkhue̱n gakon, gíꞌmaa rí ma̱ꞌne gamakuu̱n jamí mu̱xrígú-mijnée̱ ná inúú mbá xúgíin xa̱bo̱.<verse eid="TIT 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="TIT 3:3" />Numuu rí ikháanꞌ mangáanꞌlóꞌ ninindxa̱ꞌlóꞌ xa̱bo̱ tsí júgoo inúú nákhí wajyúú. Nijñaguáanꞌlóꞌ jamí nindáti̱gáanꞌlóꞌ xómá yumbáá waꞌtsi̱in kajngó mune̱ rí nandoo xuñúú jamí mbá xúgíí inii rí xkawe̱ꞌ. Nijuwalóꞌ awúun rí xkawe̱ꞌ jamí rí tsixígu̱ꞌ, xúꞌkhue̱n máꞌ najiꞌníi xa̱bo̱ e̱ꞌne̱lóꞌ jamí najiꞌnáaꞌlóꞌ juꞌya-mijnálóꞌ. <verse eid="TIT 3:3" /><verse number="4" style="v" sid="TIT 3:4" />Xómáꞌ Ana̱ꞌlóꞌ tsí naꞌne-jríñáaꞌlóꞌ, nisngájmee̱ rí májáan a̱kuii̱n, jamí rí nandoo̱ jaꞌñúu̱ xa̱bo̱ numbaa. <verse eid="TIT 3:4" /><verse number="5" style="v" sid="TIT 3:5" />Neꞌne-jríñáa̱ꞌlóꞌ, ra̱ꞌkhá ga̱jma̱á numuu rí máján ne̱ꞌne̱lóꞌ, rí ga̱jma̱á numuu rí niñáwíin a̱kuii̱n jaꞌyalóꞌ. Neꞌne-jríñáa̱ꞌlóꞌ ga̱jma̱á numuu rí neꞌne mba̱a̱ a̱kuii̱n jaꞌyoo̱ aꞌkhánlóꞌ. Xkuaꞌnii neꞌne Ana̱ꞌlóꞌ rí ma̱gu̱ma-nuxáanꞌlóꞌ jamí rí ma̱nindxa̱ꞌlóꞌ xa̱bo̱ nuxi̱inꞌ ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ. <verse eid="TIT 3:5" /><verse number="6" style="v" sid="TIT 3:6" />Ana̱ꞌlóꞌ naꞌne rí ma̱nújngoo rámuu rí mu̱dríguíilóꞌ Xu̱u̱ꞌ ga̱jma̱á majñu̱u̱ Jesukrísto̱, tsí naꞌne-jríñáaꞌlóꞌ. <verse eid="TIT 3:6" /><verse number="7" style="v" sid="TIT 3:7" />Niꞌnii̱ rúꞌkhue̱n numuu rí maphú nandoo̱ jaꞌyalóꞌ, ikhaa jngó maꞌthán Ana̱ꞌlóꞌ rí nánda̱a̱ aꞌkhánlóꞌ, jamí a̱ꞌkhue̱n rí ma̱goo ma̱juwalóꞌ mbá jámuu, xómá rí guáꞌthi̱ínlóꞌ ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ. <verse eid="TIT 3:7" /><verse number="8" style="v" sid="TIT 3:8" />Maphú gakon ajngáa rí na̱tha̱a̱nꞌ ge̱jyoꞌ, ikhaa jngó nandoꞌ rí ma̱xáta̱tsi̱ꞌñáá rí narasngúu̱n ríge̱ꞌ, kajngó tsí nanimbu̱únꞌ juyáá Ana̱ꞌlóꞌ muxna-mijnée̱ tsiakhe̱ rí muni̱i̱ rí máján. Gisngáá ríge̱ꞌ rí phú máján jamí nambáñúú ne̱ mbá xúgíin xa̱bo̱.<verse eid="TIT 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 3:9" />I̱ndo̱ó máꞌ ma̱xáta̱xu̱ꞌdá-mina̱ꞌ ga̱jma̱á numuu gisngáá tsiskágu̱nꞌ, ná nusngáá xa̱bo̱ ga̱jma̱á numuu mbiꞌñúú táta̱-xi̱ꞌñálóꞌ wajyúú, ná najiꞌníi jamí na̱tsa̱ñu̱ú xa̱bo̱ ga̱jma̱á numuu xtángoo drígo̱o̱ Moisés. Numuu rí nda̱a̱ mbá jayu rí gíꞌdoo numuu rúꞌkhue̱n ni máꞌ tsímbáyúu̱ ne̱. <verse eid="TIT 3:9" /><verse number="10" style="v" sid="TIT 3:10" />Xí mbáa naꞌne rí mu̱xpi̱ꞌtha̱-mijná xa̱bi̱i Ana̱ꞌlóꞌ, ataxpríguíi̱ mbóó o a̱jma̱ nothon. Xí tsídxawuu̱n, ataxkriya̱a̱ꞌ rixa̱á. <verse eid="TIT 3:10" /><verse number="11" style="v" sid="TIT 3:11" />Numuu nathayáá máꞌ rí mbáa xa̱bo̱ tsí xkuaꞌnii, niniñuu̱ máꞌ gisngáá rí gakon jamí aꞌkhúu̱n máꞌ ikhaa̱ ñajuun rí naxná-máꞌáa̱n.<verse eid="TIT 3:11" /></para>
  <para style="s">Rí nitháán Títo̱ ma̱ꞌne</para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12" />Ído̱ gáxu̱ꞌmáa Artéma̱s rí ma̱ꞌga gáꞌyaaꞌ o Tíki̱ko̱ mbo̱ꞌ, mbá nacha̱ máꞌ gátha̱ne̱ rí mi̱dxa̱ꞌ gátha̱yo̱ꞌ ná xuajen Nikópo̱li̱s, numuu rí ikhín ni̱ꞌgí-mina̱ꞌ rí ma̱xtáá mbá xúgíí go̱nꞌ rí naꞌne ngúwán. <verse eid="TIT 3:12" /><verse number="13" style="v" sid="TIT 3:13" />Athane̱ mbá xúgíí rí na̱ꞌnga̱a̱ꞌ rí ma̱ta̱mbáyíí Séna̱s tsí naꞌthán-makoo rí naꞌthán xtángoo, ga̱jma̱á Apólo̱s, kajngó nda̱a̱ nitháan rí gáꞌñúu̱ ná magóo̱ jamba̱a̱. <verse eid="TIT 3:13" /><verse number="14" style="v" sid="TIT 3:14" />Xkuaꞌnii kajngó ma̱ma̱ñúú a̱ngia̱nꞌlóꞌ mangiin mune̱ rí máján, jamí mu̱mbáñúu̱ tsí ndaꞌñúú, kajngó ma̱xáꞌne rí nda̱a̱ mbá jayu numuu rí júwe̱e̱ꞌ.<verse eid="TIT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15" />Nu̱ra̱xi̱ín mbá xúgíin tsí xtáá gajmíꞌ ge̱jyoꞌ. Na̱ra̱xi̱in mangúúnꞌ a̱ngia̱nꞌlóꞌ a̱ꞌkhue̱n tsí nandúún juyalóꞌ.</para>
  <para style="p" vid="TIT 3:15">Ana̱ꞌlóꞌ gáꞌne-tsakun-rámáaꞌlaꞌ mbá xúgiáanꞌlaꞌ. Xkuaꞌnii gáꞌne.<note caller="+" style="f"><char style="fr" closed="false">3.15 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «Xkuaꞌnii gáꞌne».</char></note><verse eid="TIT 3:15" /></para>
  <chapter eid="TIT 3" />
</usx>