<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id">tcfU (49-Gal) - Me̱ꞌpha̱a̱ Mañúwi̱ín (Malinaltepec) sfm NVI, c6/v149</book>
  <para style="h">Xa̱bo̱ Galásia̱</para>
  <para style="toc3">Ga</para>
  <para style="toc2">Xa̱bo̱ Galásia̱</para>
  <para style="toc1">I̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inúú xa̱bo̱ Galásia̱</para>
  <para style="mt2">I̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inúú</para>
  <para style="mt1">Xa̱bo̱ Galásia̱</para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="s">Páblo̱ naraxi̱in tsí nanimbu̱únꞌ juyáá Jesús ná numbaa Galásia̱</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />Ikhúúnꞌ ñajunꞌ Páblo̱, mbáa xa̱bo̱ tsí waxúngua̱a̱ꞌ. Ra̱ꞌkhá xa̱bo̱ numbaa nixniꞌ jamí ni̱ꞌgiúún rí ma̱ne̱ ñajun ríge̱ꞌ, rí jmína̱a̱ꞌ máꞌ Jesukrísto̱ nixúꞌmúú, jamí mangaa máꞌ Ana̱ꞌlóꞌ tsí neꞌne rí mbayáa mbiꞌyuu Jesús. <verse eid="GAL 1:1" /><verse number="2" style="v" sid="GAL 1:2" />Ikhúúnꞌ jamí mbá xúgíin a̱ngia̱nꞌlóꞌ tsí gajmíꞌ ge̱jyoꞌ, nu̱ra̱xi̱inxo̱ꞌ mbámbá kuthuun tsí nanimbu̱únꞌ juyáá Jesús ná numbaa Galásia̱.<verse eid="GAL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3" />Ana̱ꞌlóꞌ Mikhuíí jamí Tátiálóꞌ Jesukrísto̱ gúne̱-tsakun-rámáaꞌlaꞌ jamí ikhii̱n máꞌ gúni̱i̱ rí ma̱juwalaꞌ tsímáá. <verse eid="GAL 1:3" /><verse number="4" style="v" sid="GAL 1:4" />Jesukrísto̱ nixnáxe̱-mina̱ꞌ rí ma̱ja̱ñúu ga̱jma̱á numuu aꞌkhánlóꞌ. Xkuaꞌnii neꞌne-jríñáa̱ꞌlóꞌ ná inuu numbaa xkawe̱ꞌ rí juwalóꞌ, xómá rí nandoo Tátiálóꞌ Mikhuíí. <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />¡A̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ mbá jámuu mbiꞌi! Xkuaꞌnii gáꞌne.<verse eid="GAL 1:5" /></para>
  <para style="s">Nda̱a̱ i̱mba̱ ajngáa máján rí ma̱ꞌne-jáwíin xa̱bo̱</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />Maphú namakuꞌ rí nacha̱ guéño ne̱ne̱-tsíngua̱ꞌ-mijnálaꞌ inuu Ana̱ꞌlóꞌ tsí nindxaꞌwálaꞌ ga̱jma̱á numuu rí phú nandoo jaꞌyalaꞌ Krísto̱, jamí mbá nacha̱ máꞌ nikualaꞌ tsu̱du̱u̱ i̱mba̱ inii gisngáá. <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />Ra̱ꞌkhá máꞌ numuu gakon rí ríga̱ i̱mba̱ inii ajngáa máján, rí júwa̱ꞌ mbá tikhuun xa̱bo̱ tsí nandúún gúne̱-ngra̱ꞌáanꞌlaꞌ jamí nandúu̱n gúne̱-maꞌchíi̱ ajngáa máján ga̱jma̱á numuu Krísto̱. <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />Maske máꞌ mbáa tsí ikháanꞌxo̱ꞌ o mbáa ánje̱l tsí na̱ꞌkha̱ mikhuíí mbo̱ꞌ, asndo tsáa máꞌ tsí naꞌsngálaꞌ i̱mba̱ ajngáa máján kriꞌkhu xó rí ni̱sngááxo̱ꞌ ná inalaꞌ, gamínu̱u̱ꞌ tsúꞌkhue̱n gáꞌne Ana̱ꞌlóꞌ. <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />Xómá ni̱tha̱nxo̱ꞌ nákhí wapha, nathangu̱ún na̱tha̱nꞌlaꞌ mbu̱júꞌ: xí mbáa naꞌsngálaꞌ i̱mba̱ ajngáa máján kriꞌkhu xó rí ni̱drígúlaꞌ máꞌ, gamínu̱u̱ꞌ tsúꞌkhue̱n gáꞌne Ana̱ꞌlóꞌ.<verse eid="GAL 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10" />Á na̱ju̱ma̱ꞌlaꞌ rí naxná-gamiéjunꞌ rí muthan máján xa̱bo̱ ga̱jma̱á numuꞌ dxe̱ꞌ. Á na̱ne̱ rí ma̱ni̱gu̱ún xa̱bo̱ juyeꞌ, i̱ju̱ma̱ꞌlaꞌ dxe̱ꞌ. Á ra̱ꞌkhá Ana̱ꞌlóꞌ ñajuun tsí phú nandoꞌ rí maꞌthán máján numuꞌ rá. Xí xóó na̱ne̱ rí muthan máján xa̱bo̱ ga̱jma̱á numuꞌ, ra̱ꞌkhá máꞌ yumbée Krísto̱ ñajunꞌ xúꞌkhue̱n rá.<verse eid="GAL 1:10" /></para>
  <para style="s">Xó watsaꞌwáá Páblo̱ neꞌne Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />A̱ngui̱nꞌ, nandoꞌ rí ma̱gi̱da̱ꞌ mújúun idxa̱ꞌlaꞌ ríge̱ꞌ: ajngáa máján rí na̱sngáálo̱ꞌ, ra̱ꞌkhá xa̱bo̱ numbaa nene̱-ku̱maa ne̱. <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />Tágruígú ne̱, ni máꞌ táma̱ñuꞌ ne̱ ga̱jma̱á majñu̱u̱ nimbáa xa̱bo̱ numbaa, rí jmína̱a̱ꞌ máꞌ Jesukrísto̱ nirmáꞌthoo inuꞌ kajngó ma̱ne̱-núwíin ne̱.<verse eid="GAL 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13" />Ni̱dxawíínlaꞌ máꞌ xáne jaꞌñúú ikhúúnꞌ nákhí rí na̱ne̱-mbánuulo̱ꞌ rí nanimba̱ꞌxo̱ꞌ tsáanꞌ ñajwanxo̱ꞌ xa̱bo̱ judío̱, rí ne̱ne̱-ngíníi mi̱ndaꞌkho tsí nanimbu̱únꞌ juyáá Jesús, jamí ni̱ꞌgí-mina̱ꞌ rí ma̱ne̱-gámbii̱nlo̱ꞌ. <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" />Ná majñu̱ú a̱ngui̱nꞌ xa̱bo̱ judío̱ tsí mbéꞌthúún gajmíꞌ ná xuajñuꞌ, ikhúúnꞌ ñajunꞌ tsí phú i̱tha̱án na̱ni̱gu̱u̱ꞌ rí ma̱ꞌne-mbánuu gisngáá rí ni̱ꞌgí táta̱-xi̱ꞌñúꞌ wajyúú. <verse eid="GAL 1:14" /><verse number="15" style="v" sid="GAL 1:15" />I̱ndo̱ó máꞌ numuu rí Ana̱ꞌlóꞌ niraꞌwúún jamí nindxaꞌwéꞌ asndo nákhí máꞌ xóó tágu̱múúlo̱ꞌ ga̱jma̱á numuu rí maphú nandoo̱ jaꞌyeꞌ. Ído̱ rí neꞌne a̱kuii̱n ikhaa̱, <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />niꞌnii̱ rí ma̱ne̱-núwíinlo̱ꞌ A̱dée̱, kajngó ma̱tha̱n-ráꞌalo̱ꞌ ga̱jma̱á numuu̱ ikhaa̱ ná inúú xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún. Xómáꞌ ikhúúnꞌ tára̱xu̱u̱lo̱ꞌ mbá nacha̱ nimbáa xa̱bo̱ numbaa, <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />ni máꞌ táꞌgálo̱ꞌ gáñu̱ú ná Jerusalén tsí wapha máꞌ ninindxu̱ún mbo̱ waxúngui̱inꞌ neꞌne Jesús xó rí ikhúúnꞌ. A̱ꞌkhue̱n gakon, mbá nacha̱ máꞌ nikalo̱ꞌ ná numbaa Arábia̱, jamí nda̱wa̱á a̱ꞌkhue̱n niꞌkha̱aꞌ mbu̱júꞌ ná xuajen Damásko̱.<verse eid="GAL 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 1:18" />Asndo nirámuu atsú tsigu, a̱ꞌkhue̱n nika gáyo̱o̱ Pédro̱<note caller="+" style="f"><char style="fr" closed="false">1.18 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «Cefas» ga̱jma̱á ajngáa araméo̱. Ná ajngáa griégo̱ «Pedro» ñajuun mbiꞌyuu̱.</char></note> ná Jerusalén, jamí nixtáá ga̱jma̱á nindxu̱u̱ mbá gu̱wa̱ꞌ-nítsu (15) mbiꞌi. <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />I̱ndo̱ó máꞌ numuu rí táñu̱ú i̱ꞌwíin tsí waxúngui̱inꞌ neꞌne Jesús, rí i̱ndo̱ó máꞌ Santiágo̱<note caller="+" style="f"><char style="fr" closed="false">1.19 </char><char style="ft" closed="false">Ná i̱yi̱i̱ꞌ griégo̱ rí wayuu naꞌthán «Jakóbo̱», rí nithán «Santiágo̱» ná xtílo̱o̱.</char></note> ndi̱yo̱o̱, dxíyo̱o̱ Táta̱. <verse eid="GAL 1:19" /><verse number="20" style="v" sid="GAL 1:20" />Mbá xúgíí rí na̱tha̱nꞌlaꞌ ge̱jyoꞌ, ndaꞌyoo Ana̱ꞌlóꞌ rí tsíne̱-ndúwalo̱ꞌ. <verse eid="GAL 1:20" /><verse number="21" style="v" sid="GAL 1:21" />Nda̱wa̱á a̱ꞌkhue̱n nika ná numbaa Síria̱ jamí ná numbaa Silísia̱. <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />Xómáꞌ mbámbá kuthuun tsí nanimbu̱únꞌ juyáá Krísto̱ ná numbaa Judéa̱, ni máꞌ na̱nguá ene̱-nuwúu̱n nákhí xúꞌkhue̱n. <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />I̱ndo̱ó máꞌ xáꞌnii i̱dxawíi̱n ga̱jma̱á numuꞌ: «Xa̱bo̱ tsí neꞌne-ngínáálóꞌ mi̱ndaꞌkho nákhí xúꞌkhue̱n, naꞌthán-ráꞌa ajngáa máján rí xúge̱ꞌ rá, ikhaa máꞌ rí niꞌgí-mine̱e̱ꞌ rí ma̱ꞌne-gámbo̱o̱». <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />Jamí nune̱-mba̱a̱ Ana̱ꞌlóꞌ ga̱jma̱á numuꞌ.<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s">Tsí waxúꞌmii nu̱dri̱guíi Páblo̱</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />Asndo ído̱ ninújngoo gu̱wa̱ꞌ i̱kho̱ (14) tsigu, a̱ꞌkhue̱n nika mbu̱júꞌ ná Jerusalén ga̱jmi̱ꞌ Bernabé. Ni̱ka̱ máꞌ Títo̱ mangaa ga̱jma̱á nindxa̱ꞌxo̱ꞌ. <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />Nikalo̱ꞌ numuu rí Ana̱ꞌlóꞌ nisngájmiꞌ rí jaꞌyoo ma̱ꞌgálo̱ꞌ. Ído̱ nigánú ná Jerusalén, ni̱ru̱wa-mina̱aꞌ gajmíꞌ i̱ndo̱ó máꞌ tsí na̱gu̱ma-nuwiin rí xa̱bo̱ ede̱ ñajúún. Ni̱tha̱n-makúu̱nlo̱ꞌ ajngáa máján rí na̱sngáálo̱ꞌ ná majña̱ꞌlaꞌ tsáanꞌ ra̱ꞌkháa xa̱bo̱ judío̱ ñajwanlaꞌ, kajngó ma̱xáꞌne rí ni̱ñajunlo̱ꞌ xúgi̱í jayu, ni máꞌ rí ma̱xági̱ꞌdoo numuu ñajun rí na̱ne̱lo̱ꞌ. <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />Xómáꞌ ikhii̱n máján máꞌ rí na̱sngáálo̱ꞌ ndiyáa̱, ikhaa jngó túne̱-tsu̱daa̱ máꞌ rí ma̱gu̱maa tsina jndi Títo̱, tsí ni̱ka̱ ga̱jma̱á nindxu̱ꞌ, maske máꞌ xa̱bo̱ griégo̱ ñajuu̱n. <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />Numuu rí ni̱tu̱ꞌu̱ún ngu̱ꞌwa̱ tikhuun tsí mi̱nduwa rí a̱ngia̱nꞌlóꞌ ñajúún. Ndiñúu̱ mu̱ña̱mee̱ kajngó mbuyáa̱ xáne juwalóꞌ numuu rí Krísto̱ Jesús neꞌne-jríñáa̱ꞌlóꞌ, kajngó mune̱-tsu̱dáa̱nꞌlóꞌ rí mu̱ꞌne̱-mbáníílóꞌ xtángoo. <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />Ni xí lájwíin tu̱ni̱ꞌñá-mijnáxo̱ꞌ rí muthan-ñajwanxo̱ꞌ, kajngó mu̱xúriꞌkhuííxo̱ꞌ ajngáa máján rí gakon rí nanimba̱ꞌlaꞌ máꞌ ju̱ya̱á.<verse eid="GAL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6" />Xómáꞌ tsí na̱gu̱ma-nuwiin rí xa̱bo̱ ede̱ ñajúún rá, na̱nguá máꞌ nithinꞌlo̱ꞌ i̱mba̱ rí nuxe̱ꞌ. (Ikhúúnꞌ tsíxná-gamiéjunꞌ xí phú gakon rí gíꞌdoo guéño numúu̱, numuu rí Ana̱ꞌlóꞌ tsíraꞌwíi̱n xa̱bo̱ tsí ma̱ꞌne-nga̱júu̱n.) <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />A̱ꞌkhue̱n gakon, nifruꞌúu̱n rí ikhúúnꞌ waꞌxnángawoꞌ rí ma̱tha̱n-rúꞌúúnlo̱ꞌ ajngáa máján xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, xómá rí Pédro̱ waꞌxnángawíí rí maꞌthán-rúꞌúún ne̱ xa̱bo̱ judío̱. <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />Jmína̱a̱ꞌ máꞌ Ana̱ꞌlóꞌ neꞌne rí Pédro̱ ma̱nindxu̱u̱ tsí waxúngua̱a̱ꞌ ná majñu̱ú xa̱bo̱ judío̱, ikhaa̱ máꞌ niꞌnii̱ rí ikhúúnꞌ ma̱nindxu̱ꞌ tsí waxúngua̱a̱ꞌ ná majñu̱ú xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún mangaa. <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />Ikhaa jngó Santiágo̱,<note caller="+" style="f"><char style="fr" closed="false">2.9 </char><char style="ft" closed="false">Ná i̱yi̱i̱ꞌ griégo̱ rí wayuu naꞌthán «Jakóbo̱», rí nithán «Santiágo̱» ná xtílo̱o̱.</char></note> Pédro̱<note caller="+" style="f"><char style="fr" closed="false">2.9 </char><char style="ft" closed="false">«Pédro̱» ñajuun ajngáa griégo̱ jamí «Séfa̱s» ñajuun ajngáa araméo̱. Xkuaꞌnii máꞌ ná kíxnuu 11 jamí 14 mangaa.</char></note> jamí Juáán, xa̱bo̱ ede̱ tsí phú i̱tha̱án gíꞌdoo numúú, ndiyáa̱ rí Ana̱ꞌlóꞌ nixnángaweꞌ rí ma̱ne̱ ñajun rúꞌkhue̱n, a̱ꞌkhue̱n ni̱ra̱tuu̱n ñawún májánxo̱ꞌ. Xkuaꞌnii ni̱snga̱jmee̱ rí a̱ngia̱nꞌxo̱ꞌ ñajúu̱n, kajngó ikhúúnꞌ ga̱jmi̱ꞌ Bernabé mu̱tha̱n-ráꞌaxo̱ꞌ ná majñu̱ú xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, xómáꞌ ikhii̱n muthan-raꞌee̱ ná majñu̱ú xa̱bo̱ judío̱. <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />I̱ndo̱ó máꞌ ni̱nda̱ꞌa̱ꞌxo̱ꞌ rí mu̱mbáñúúxo̱ꞌ xa̱bo̱ tsí ngíníi. Jamí ikhaa máꞌ rúꞌkhue̱n ñajuun rí na̱xna̱-mína̱ꞌ tsiakhe̱ rí ma̱ne̱ asndo xúge̱ꞌ.<verse eid="GAL 2:10" /></para>
  <para style="s">Páblo̱ naꞌthán rí ra̱ꞌkhíin eꞌne Pédro̱</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />Nda̱wa̱á ído̱ ni̱ꞌkha̱ Pédro̱ ná xuajen Antiokía̱, ni̱thu̱u̱nlo̱ꞌ ná inuu̱ rí ra̱máján iꞌnii̱. <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />Numuu rí nákhí xóó táguáꞌnú mbá tikhuun xa̱bo̱ judío̱ tsí nixúꞌmii Santiágo̱, nakuiꞌtsii̱ gajmíi̱ a̱ngia̱nꞌlóꞌ tsí ra̱ꞌkháa xa̱bo̱ judío̱ ñajúún. Jamí nda̱wa̱á ído̱ rí niguáꞌníi̱, neꞌne-níjníí-mine̱e̱ꞌ, numuu rí namíñuu̱ ene̱ tsí phú nu̱tsu̱da rí muda tsina jndi xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún. <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />Ído̱ ndiyáá tsí i̱ꞌwíin a̱ngia̱nꞌlóꞌ xa̱bo̱ judío̱ rí a̱jma̱ inuu Pédro̱, nene̱-níjníí-mi̱jnée̱ mangii̱n, jamí asndo Bernabé máꞌ mangaa neꞌne a̱jma̱ inuu numuu rí a̱jma̱ inúu̱ ikhii̱n. <verse eid="GAL 2:13" /><verse number="14" style="v" sid="GAL 2:14" />Ikhaa jngó, ído̱ ndi̱yo̱o̱ rí tsíni̱i̱ xómá jaꞌyoo ajngáa máján rí gakon, a̱ꞌkhue̱n ni̱thu̱u̱nlo̱ꞌ Pédro̱ ná inúu̱ mbá xúgíi̱n: «Xí ikháánꞌ tsáánꞌ ñajwaanꞌ xa̱bo̱ judío̱, nathane̱ xómá xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, náá numuu kajngó nathane̱-ski̱ñu̱ú tsí ra̱ꞌkháa judío̱ ñajúún rí mune̱ xómá xa̱bo̱ judío̱ xúꞌkhue̱n róꞌ».<verse eid="GAL 2:14" /></para>
  <para style="s">Ana̱ꞌlóꞌ naꞌthán rí nánda̱a̱ aꞌkhánlóꞌ ga̱jma̱á majñu̱u̱ rí wéje̱ a̱kia̱nꞌlóꞌ ná inuu Jesukrísto̱</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15" />Ikháanꞌ ñajwanxo̱ꞌ xa̱bo̱ judío̱ asndo nákhí rí ni̱gu̱máaꞌxo̱ꞌ, jamí ra̱ꞌkháa xa̱bo̱ tsí nune̱ aꞌkhán xómá rí nune̱ xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún. <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" />Maske máꞌ xúꞌkhue̱n, nduꞌyáá májánlóꞌ rí Ana̱ꞌlóꞌ ma̱xáꞌthán rí nánda̱a̱ aꞌkhúun nimbáa xa̱bo̱ ga̱jma̱á majñu̱u̱ rí naꞌne-mbánuu xtángoo, rí ga̱jma̱á majñu̱u̱ rí wéje̱ a̱kuii̱n ná inuu Jesukrísto̱. Ikháanꞌ mangáanꞌxo̱ꞌ nanimba̱ꞌxo̱ꞌ ju̱ya̱á Jesukrísto̱ kajngó maꞌthán Ana̱ꞌlóꞌ rí nánda̱a̱ aꞌkhánxo̱ꞌ ga̱jma̱á majñu̱u̱ ikhaa̱, ra̱ꞌkhá ga̱jma̱á majñu̱u̱ rí nu̱ne̱-mbánííxo̱ꞌ xtángoo. Numuu rí Ana̱ꞌlóꞌ ma̱xáꞌthán rí nánda̱a̱ aꞌkhúun nimbáa xa̱bo̱ ga̱jma̱á numuu rí naꞌne-mbánuu̱ xtángoo.<verse eid="GAL 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 2:17" />Ikháanꞌ ndu̱ꞌyáxo̱ꞌ rí Ana̱ꞌlóꞌ maꞌthán rí nánda̱a̱ aꞌkhánxo̱ꞌ ga̱jma̱á majñu̱u̱ Krísto̱, numuu rí xa̱bo̱ tsí nune̱ máꞌ aꞌkhán ñajwan mangáanꞌxo̱ꞌ. Á rúꞌkhue̱n iꞌthán rí Krísto̱ naꞌne rí ma̱nindxa̱ꞌlóꞌ xa̱bo̱ tsí nune̱ aꞌkhán rá dxe̱ꞌ. ¡Na̱nguá mbá jayu! <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />Xí ikhúúnꞌ naka gáya̱a mbu̱júꞌ xtángoo rí ni̱ni̱ꞌñá-ti̱ga̱ máꞌ, na̱ne̱-mina̱ꞌ xa̱bo̱ aꞌkhán ná inuu Ana̱ꞌlóꞌ xúꞌkhue̱n rá. <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />Numuu rí ga̱jma̱á majñu̱u̱ xtángoo ikhúúnꞌ nijáñuꞌ máꞌ ná inuu xtángoo. Kajngó rí xúge̱ꞌ rá, ma̱xtáá ma̱ne̱ rí nandoo Ana̱ꞌlóꞌ. <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />Ikhúúnꞌ waꞌdujmúú ná ixe̱ krúsi̱ ma̱ja̱ñúꞌ ga̱jma̱á nindxu̱u̱ Krísto̱. Nánguá máꞌ xtáá nda̱ya̱ ikhúúnꞌ, rí Krísto̱ xtáa ndaꞌya ná awúun a̱kui̱nꞌ. Rí xúge̱ꞌ rá, xtáá nda̱ya̱ ga̱jma̱á numuu rí wéje̱ a̱kui̱nꞌ ná inuu A̱dée Ana̱ꞌlóꞌ, tsí ndiyoo jaꞌyeꞌ jamí nixnáxe̱-mina̱ꞌ rí ma̱ja̱ñúu ga̱jma̱á numuꞌ. <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />Ikhaa jngó, tsíyoꞌ gáni̱ꞌñúu rí phú máján naxná Ana̱ꞌlóꞌ. Xí ga̱jma̱á numuu xtángoo maꞌthán Ana̱ꞌlóꞌ rí nánda̱a̱ aꞌkhúún xa̱bo̱, nda̱a̱ máꞌ numuu rí nijáñuu Krísto̱ xúꞌkhue̱n rá.<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s">Ni̱dríguíilóꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á numuu rí wéje̱ a̱kia̱nꞌlóꞌ ná inuu Jesukrísto̱</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />¡Phú tsíndxa̱ꞌwa̱á idxa̱ꞌlaꞌ, xa̱bo̱ Galásia̱! Xáne kajngó ni̱ni̱ꞌñá-mijnálaꞌ rí ma̱gu̱ma-nduwáanꞌlaꞌ róꞌ, xí jmínu̱úꞌ máꞌ ikhúúnꞌ ni̱tha̱n-makalaꞌ rí Jesukrísto̱ waꞌdujmaa ná ixe̱ krúsi̱ rá. <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />Nandoꞌ rí mu̱riñuꞌlaꞌ mbóó graxe̱ ríge̱ꞌ: Á ni̱dríguíilaꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á numuu rí ne̱ne̱-mbáníílaꞌ xtángoo o ga̱jma̱á numuu rí ni̱dxawíínlaꞌ ajngáa máján jamí ninimba̱ꞌlaꞌ ne̱ dxe̱ꞌ. <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />Á phú júgoo inalaꞌ rá dxe̱ꞌ. Ni̱gíꞌdi̱ínlaꞌ máꞌ ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ, jamí xúge̱ꞌ nandalaꞌ gúne̱-gáxi̱í ga̱jma̱á majñu̱u̱ ski̱ya̱ꞌlaꞌ ráanꞌ. <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />Á phú nda̱a̱ mbá jayu numuu mbá xúgíí rí nikua-ramíni̱ílaꞌ rá dxe̱ꞌ. Ikhúúnꞌ na̱ju̱mu̱ꞌ rí gíꞌdoo numuu mbá xúgíí rúꞌkhue̱n. <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />Ana̱ꞌlóꞌ naxnálaꞌ Xu̱u̱ꞌ jamí naꞌnii̱ rí phú wáá ná majña̱ꞌlaꞌ, ga̱jma̱á numuu rí ninimba̱ꞌlaꞌ ju̱ya̱á ajngáa rí ni̱dxawíínlaꞌ, ra̱ꞌkhá ga̱jma̱á numuu rí nu̱ne̱-mbáníílaꞌ xtángoo.<verse eid="GAL 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6" />Xkuaꞌnii máꞌ mangaa Abraám, «ninimbo̱o̱ꞌ jaꞌyoo̱ Ana̱ꞌlóꞌ, rúꞌkhue̱n kajngó niꞌthán Ana̱ꞌlóꞌ rí xa̱bo̱ tsí májáan ñajuu̱n». <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" />Ikhaa jngó, gu̱ya̱á májánlaꞌ ríge̱ꞌ: Tsí nanimbu̱únꞌ juyáá Ana̱ꞌlóꞌ, tsúꞌkhue̱n tsí gakon rí i̱ji̱in Abraám ñajúún. <verse eid="GAL 3:7" /><verse number="8" style="v" sid="GAL 3:8" />Ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ nakujma rí wapha máꞌ niꞌgí-mina̱ꞌ Ana̱ꞌlóꞌ rí maꞌthée̱n rí nánda̱a̱ aꞌkhúún xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún ga̱jma̱á majñu̱u̱ rí nanimbúu̱n juyáa̱. Ikhaa jngó, nákhí xúꞌkhue̱n Ana̱ꞌlóꞌ niꞌthúun Abraám ajngáa máján ríge̱ꞌ: «Ga̱jma̱á majña̱a̱ꞌ ikháánꞌ ma̱ne̱-tsakun-rámii mbá xúgíin xa̱bo̱ numbaa».<note caller="+" style="f"><char style="fr" closed="false">3.8 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ xó ni̱gi̱ꞌdu̱u̱n-muu 12.3. </char></note> <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />Ikhaa jngó, tsí nanimbu̱únꞌ juyáá Ana̱ꞌlóꞌ, na̱gu̱ma-tsakun-rámii̱ mangii̱n ga̱jma̱á nindxu̱u̱ Abraám tsí ninimbo̱o̱ꞌ jaꞌyoo Ana̱ꞌlóꞌ wajyúú.<verse eid="GAL 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10" />Mbá xúgíin tsí nandúún rí ma̱ju̱wá mújúún ná inuu Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ rí nune̱-mbáníí rí naꞌthán xtángoo, waꞌxná-máꞌíi̱n, numuu rí xkuaꞌnii ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ: «Waꞌxná-máꞌáan jámba̱a̱ tsí na̱nguá eꞌne-mbánuu mbá xúgíí rí naꞌthán ná i̱yi̱i̱ꞌ xtángoo».<note caller="+" style="f"><char style="fr" closed="false">3.10 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yi̱i̱ꞌ rí naꞌthán ikhaa máꞌ xtángoo 27.26. </char></note> <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" />Gakon máꞌ rí Ana̱ꞌlóꞌ ma̱xáꞌthán rí nánda̱a̱ aꞌkhúun nimbáa xa̱bo̱ ga̱jma̱á numuu xtángoo. Numuu rí «xa̱bo̱ tsí nánda̱a̱ aꞌkhúun, ma̱xtáa̱ jámuu ga̱jma̱á numuu rí wéje̱ a̱kuii̱n ná inuu Ana̱ꞌlóꞌ». <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" />Ra̱ꞌkhá ikhaa máꞌ ñajuun rí mu̱ꞌne̱-mbáníílóꞌ rí naꞌthán xtángoo ga̱jma̱á rí ma̱we̱je̱ a̱kia̱nꞌlóꞌ ná inuu Ana̱ꞌlóꞌ, numuu rí naꞌthán xtángoo: «Tsí naꞌne-mbánuu rí naꞌthán xtángoo, ma̱xtáa̱ ga̱jma̱á numuu ne̱».<note caller="+" style="f"><char style="fr" closed="false">3.12 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yi̱i̱ꞌ rí naꞌthán ga̱jma̱á numúú xa̱bi̱i Lebí 18.5. </char></note> <verse eid="GAL 3:12" /><verse number="13" style="v" sid="GAL 3:13" />Xómáꞌ Krísto̱ neꞌne-jríñáa̱ꞌlóꞌ ná inuu rí naxná-máꞌáanꞌlóꞌ xtángoo, nákhí rí waꞌxná-máꞌáa̱n ga̱jma̱á numalóꞌ, numuu rí xkuaꞌnii ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ: «Jámba̱a̱ tsí brákamaa ná ixe̱, waꞌxná-máꞌáa̱n».<note caller="+" style="f"><char style="fr" closed="false">3.13 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yi̱i̱ꞌ ná Nithán Makoo Xtángoo 21.23. </char></note> <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />Xkuaꞌnii niríga̱ kajngó ga̱jma̱á majñu̱u̱ Krísto̱ Jesús ma̱gu̱ma-tsakun-rámii xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, xómá rí ni̱gu̱ma-tsakun-rámaa Abraám. Jamí mu̱dríguíilóꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ, tsí nixuda-mine̱e̱ꞌ máꞌ rí maxniálóꞌ ga̱jma̱á numuu rí wéje̱ a̱kia̱nꞌlóꞌ ná inuu Jesús.<verse eid="GAL 3:14" /></para>
  <para style="s">Tángudi̱i rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ ído̱ rí ni̱ꞌkha̱ xtángawoo Moisés</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />A̱ngui̱nꞌ, ma̱tha̱nꞌlaꞌ mbá xkri̱da: Xí mbáa xa̱bo̱ naꞌne mbá awan ga̱jma̱á i̱mba̱a̱ꞌ xa̱bo̱, nimbáa tsíyoo rí marngudi̱i rí nixuda-mine̱e̱ꞌ, ni máꞌ rí ma̱ꞌne-ra̱ꞌmáa ne̱, xí nixnée̱ máꞌ ajngóo̱. <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />Gu̱dxawíínlaꞌ, Ana̱ꞌlóꞌ nixuda-mina̱ꞌ ga̱jma̱á nindxu̱u̱ Abraám jamí ga̱jma̱á nindxu̱u̱ xa̱bo̱ ri̱jyu̱u̱ꞌ. Ná i̱yi̱i̱ꞌ ajngáa rawuun Ana̱ꞌlóꞌ tsíꞌthán: «jamí ga̱jma̱á nindxu̱ún xa̱bo̱ ri̱jyu̱u̱ꞌ», kajngó ma̱xáfraꞌa̱ꞌlóꞌ rí mbaꞌii̱n, rí xáꞌnii iꞌthán ne̱: «jamí ga̱jma̱á nindxu̱u̱ xa̱bo̱ ri̱jyu̱u̱ꞌ», kajngó ma̱fraꞌa̱ꞌlóꞌ rí mbáwíi̱. Ikhaa̱ ñajuun Krísto̱. <verse eid="GAL 3:16" /><verse number="17" style="v" sid="GAL 3:17" />Rí phú nandoꞌ gátha̱nꞌlaꞌ ñajuun ríge̱ꞌ: Ana̱ꞌlóꞌ neꞌne mbá awan ga̱jma̱á nindxu̱u̱ Abraám asndo nákhí wajyúú, jamí nixuda-mine̱e̱ꞌ rí ma̱ꞌne-mbánuu̱ ne̱ ga̱jma̱á majñu̱u̱ Krísto̱.<note caller="+" style="f"><char style="fr" closed="false">3.17 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «ga̱jma̱á majñu̱u̱ Krísto̱».</char></note> Asndo nda̱wa̱á guéño ni̱ꞌkha̱ xtángoo rí ni̱grui̱gú Moisés, ído̱ rí ninújngoo máꞌ mbá akho̱ siénto̱ i̱ꞌkha̱a la mbá skíñú gu̱wa̱ꞌ (430) tsigu. Jamí xtángoo rúꞌkhue̱n tsírngudi̱i ne̱ awan rí ni̱gu̱ma nákhí wapha ni máꞌ tsíꞌne ne̱ rí náxági̱ꞌdoo numuu rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ rí ma̱ꞌne. <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" />Xí ga̱jma̱á numuu rí nu̱ꞌne̱-mbáníílóꞌ xtángoo najanálóꞌ rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ, nákha máꞌ ga̱jma̱á numuu rí nixuda-mine̱e̱ꞌ maxnálóꞌ ne̱ xúꞌkhue̱n rá. Xómáꞌ Ana̱ꞌlóꞌ, nixuda-mine̱e̱ꞌ rí maxnúu̱ ne̱ Abraám xkuaꞌnii jayu máꞌ.<verse eid="GAL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19" />Náá numuu ni̱ꞌkha̱ xtángoo xúꞌkhue̱n rá. Ni̱ꞌkha̱ ne̱ nda̱wa̱á kajngó ma̱kujma rí tsíne̱-mbáníí xa̱bo̱ rí nandoo Ana̱ꞌlóꞌ, asndo ága̱nú mbiꞌi rí ma̱ꞌkha̱ xa̱bo̱ ri̱jyu̱u̱ꞌ Abraám, tsí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxu̱u̱. Moisés ni̱grui̱gú xtángoo ga̱jma̱á majñu̱ú ánje̱l kajngó ikhaa̱ ma̱gu̱wíjngaa̱ ne̱ ná inúú xa̱bo̱. <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />Mbáwíi máꞌ Ana̱ꞌlóꞌ nixuda-mina̱ꞌ ná inuu Abraám, i̱ndo̱ó máꞌ numuu rí táꞌyóo rí mbáa xa̱bo̱ maꞌthán ga̱jma̱á numuu̱, numuu rí mbáwíi̱ máꞌ rí ikhaa̱.<verse eid="GAL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21" />Á rúꞌkhue̱n iꞌthán rí narikhoo xtángoo rí ma̱ꞌne-mbánuu Ana̱ꞌlóꞌ rí nixuda-mina̱ꞌ rá dxe̱ꞌ. ¡Na̱nguá mbá jayu! Xí numuu rí na̱ꞌngo̱o̱ máꞌ xtángoo ma̱ꞌne rí ma̱juwalóꞌ jámuu, a̱ꞌkhue̱n rí Ana̱ꞌlóꞌ maꞌthán rí nánda̱a̱ máꞌ aꞌkhánlóꞌ ga̱jma̱á numuu rí nu̱ꞌne̱-mbáníílóꞌ xtángoo. <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />Xómáꞌ i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ naꞌthán rí mbá xúgíin xa̱bo̱ júgua-raꞌiin ná awúun aꞌkhán, kajngó tsí nanimbu̱únꞌ juyáá Jesukrísto̱ mu̱dri̱guíi̱ rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ.<verse eid="GAL 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23" />Nákhí rí xóó tága̱nú mbiꞌi rí ma̱we̱je̱ a̱kia̱nꞌxo̱ꞌ ná inuu Jesús, rí xtángoo ninindxu̱u̱ xómá géjwa̱nꞌ ná nijúgua-raꞌáanꞌxo̱ꞌ, asndo ni̱ga̱nú mbiꞌi rí Ana̱ꞌlóꞌ nisngájma rí jaꞌyoo ma̱we̱je̱ a̱kia̱nꞌxo̱ꞌ ná inuu A̱dée̱. <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />Ikhaa jngó, rí xtángoo ninindxu̱u̱ xómá yumbáá tsí na̱ña̱wu̱ún e̱je̱n, rí mbayá ikhaxo̱ꞌ kajngó ma̱we̱je̱ a̱kia̱nꞌxo̱ꞌ ná inuu Krísto̱, a̱ꞌkhue̱n maꞌthán Ana̱ꞌlóꞌ rí nánda̱a̱ aꞌkhánxo̱ꞌ ga̱jma̱á numuu rí wéje̱ a̱kia̱nꞌxo̱ꞌ ná inuu̱. <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />Jamí xúge̱ꞌ rá, rí ni̱ga̱nú máꞌ mbiꞌi rí ma̱we̱je̱ a̱kia̱nꞌxo̱ꞌ ná inuu Krísto̱, nánguá máꞌ iꞌthán-ñájwanxo̱ꞌ xtángoo rí ninindxu̱u̱ xómá yumbáá tsí na̱ña̱wu̱ún e̱je̱n.<verse eid="GAL 3:25" /></para>
  <para style="s">Ikháanꞌlaꞌ ñajwanlaꞌ i̱ji̱in Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26" />Mbá xúgiáanꞌ ikháanꞌlaꞌ ñajwanlaꞌ i̱ji̱in Ana̱ꞌlóꞌ ga̱jma̱á numuu rí wéje̱ a̱kia̱nꞌlaꞌ ná inuu Krísto̱ Jesús. <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />Nákhí rí waxúꞌdu-maꞌáanꞌlaꞌ ná awúun iya numuu rí nanimba̱ꞌlaꞌ ju̱ya̱á Krísto̱, ikháanꞌlaꞌ ninindxa̱ꞌlaꞌ xómá jaꞌnii Krísto̱, xómá tsí nijúwuun xtíin rí nuxe̱ꞌ. <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />Nánguá máꞌ iꞌyoo xí xa̱bo̱ judío̱ o xa̱bo̱ griégo̱ ñajwanlóꞌ, yumbáá tsí waꞌtsi̱i̱ o xa̱bo̱ tsí naꞌthán-ñájun-mina̱ꞌ máꞌ ikhaa mbo̱ꞌ, xí xa̱biya̱ o xí a̱ꞌgo̱ ñajwanlóꞌ mbo̱ꞌ. Numuu rí mbá xúgiáanꞌ ikháanꞌlaꞌ ñajwanlaꞌ mbáwíi máꞌ xa̱bo̱ ga̱jma̱á nindxu̱u̱ Krísto̱ Jesús. <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" />Jamí xí xa̱bi̱i Krísto̱ ñajwanlaꞌ, gakon máꞌ rí i̱ji̱in Abraám ñajwanlaꞌ, jamí mu̱drígúlaꞌ rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ.<verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />Ma̱tha̱nꞌlaꞌ i̱mba̱ xkri̱da: Ído̱ rí lájwíin xóó ada̱ tsí ma̱grui̱gúu rí gíꞌdoo tátée, mbéꞌtháa̱n máꞌ ga̱jmáa̱ yumbáá waꞌtsi̱i̱ tsí nañajun ná guꞌwóo̱, maske máꞌ ñawúu̱n ikhaa̱ ríga̱ mbá xúgíí. <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />Numuu ído̱ rí xóó lájwíi̱n, nithán-ñájwíi̱n ene̱ tsí nusngáa̱ jamí tsí nu̱ña̱wáa̱n asndo mbiꞌi rí maꞌthán tátée̱. <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />Xkuaꞌnii máꞌ mangáanꞌlóꞌ, nákhí rí ninindxa̱ꞌlóꞌ xómá jaꞌñúú e̱je̱n, waꞌxná-ñájwanlóꞌ neꞌne tsiakhe̱ rí ríga̱ ná tsu̱du̱u̱ numbaa ríge̱ꞌ. <verse eid="GAL 4:3" /><verse number="4" style="v" sid="GAL 4:4" />Jamí ído̱ ni̱ga̱nú mbiꞌi rí niꞌgí Ana̱ꞌlóꞌ rá, a̱ꞌkhue̱n nixuꞌmaa̱ A̱dée̱ ná numbaa ríge̱ꞌ. Ni̱gu̱maa̱ neꞌne mbáa a̱ꞌgo̱, jamí nixtáa̱ xómá rí naꞌthán xtángoo. <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" />Ikhaa jngó, ndiyoo neꞌtse̱-ri̱ñáaꞌlóꞌ tsáanꞌ nijuwa-ru̱ꞌne̱-mbáníílóꞌ xtángoo, kajngó maguáanꞌlóꞌ Ana̱ꞌlóꞌ rí ma̱nindxa̱ꞌlóꞌ i̱jii̱n. <verse eid="GAL 4:5" /><verse number="6" style="v" sid="GAL 4:6" />Rí xúge̱ꞌ rá, i̱ji̱in Ana̱ꞌlóꞌ ñajwanlóꞌ, jamí ikhaa̱ nixuꞌmaa̱ Xu̱u̱ꞌ A̱dée̱ rí ma̱xtáa ná awúun a̱kia̱nꞌlóꞌ. Xe̱ꞌ tsúꞌkhue̱n naꞌne rí mu̱ꞌtháánlóꞌ Ana̱ꞌlóꞌ: «¡Táa, ikháánꞌ ñajwaanꞌ Ana̱ꞌxo̱ꞌ!». <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />Ikhaa jngó, nákha máꞌ yumbáá tsí waꞌtsi̱in ñajwanlaꞌ rí xúge̱ꞌ rá, rí i̱ji̱in Ana̱ꞌlóꞌ ñajwanlaꞌ, jamí mangaa máꞌ tsí mu̱drígúu rí gíꞌdoo Ana̱ꞌlóꞌ ñajwanlaꞌ ga̱jma̱á majñu̱u̱ Krísto̱.<note caller="+" style="f"><char style="fr" closed="false">4.7 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «ga̱jma̱á majñu̱u̱ Krísto̱».</char></note><verse eid="GAL 4:7" /></para>
  <para style="s">Páblo̱ naxná-gamiéjuun ene̱ xa̱bo̱ Galásia̱</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />Nákhí wajyúú rí xóó tsíne̱-nuwiinlaꞌ Ana̱ꞌlóꞌ, ninindxa̱ꞌlaꞌ xómá yumbáá waꞌtsi̱in drígu̱ún tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún. <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />Xómáꞌ xúge̱ꞌ rá, nu̱ne̱-nuwiinlaꞌ máꞌ Ana̱ꞌlóꞌ, o i̱tha̱án máján mu̱ꞌthánlóꞌ rí ikhaa̱ naꞌne-nuwáa̱nꞌlaꞌ. Náá numuu kajngó nathangáanꞌlaꞌ mbu̱júꞌ ná inuu tsiakhe̱ rí tsíjmaa jamí nda̱a̱ mbá jayu numuu róꞌ. Á nandalaꞌ gánindxa̱ꞌlaꞌ mbu̱júꞌ yumbáá tsí waꞌtsi̱in ná ñawúun ne̱ dxe̱ꞌ. <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />Ikháanꞌlaꞌ nu̱ne̱laꞌ máꞌ xúꞌkhue̱n ndxa̱a̱ rí nagájnuu mbámbá mbiꞌi, mbámbáa go̱nꞌ jamí mbámbá tsigu. <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />Maphú naxná-gamiéjunꞌ e̱ne̱laꞌ, xí tági̱ꞌdoo mbá jayu numuu ñajun rí ne̱ne̱lo̱ꞌ ga̱jma̱á numalaꞌ.<verse eid="GAL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12" />A̱ngui̱nꞌ, na̱tha̱n-jáñalaꞌ rí gu̱ne̱-mijnálaꞌ xómá jaꞌñúú ikhúúnꞌ, numuu rí ikhúúnꞌ mangúúnꞌ ne̱ne̱-mina̱ꞌlo̱ꞌ xómá jaꞌñáaꞌ ikháanꞌlaꞌ. Túñu̱ꞌlaꞌ máꞌ nimbá rí ra̱máján. <verse eid="GAL 4:12" /><verse number="13" style="v" sid="GAL 4:13" />Ga̱rmáꞌáan a̱kia̱nꞌlaꞌ rí nákhí ginii, ni̱tha̱n-ráꞌalaꞌ ajngáa máján awúun máꞌ rí naꞌñiꞌ mbá nandii. <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />Maske máꞌ phú mba̱a̱ gajmá ni̱xna̱ꞌlaꞌ ga̱jma̱á nandiuꞌ, túni̱ꞌñúꞌlaꞌ ni máꞌ táxúwa̱nꞌlaꞌ ne̱ne̱lo̱ꞌ. A̱ꞌkhue̱n gakon, ni̱drígúúnlaꞌ asndo xómá mbáa ánje̱l tsí nixúngua̱a̱ꞌ Ana̱ꞌlóꞌ, asndo xó rí jmína̱a̱ꞌ máꞌ Krísto̱ Jesús. <verse eid="GAL 4:14" /><verse number="15" style="v" sid="GAL 4:15" />Ikhaa jngó na̱ra̱xa̱ꞌlaꞌ, náá ni̱ka̱ gagi rí guáꞌdáálaꞌ nákhí xúꞌkhue̱n rá. Numuu rí ikhúúnꞌ ndi̱yo̱o̱ mújúnꞌ rí ikháanꞌlaꞌ ni̱rawíilaꞌ asndo idalaꞌ mu̱xnu̱ꞌlaꞌ, xí numuu rí ndiyoo. <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />Á niꞌni̱i xa̱bo̱ sia̱nꞌ gajmiálaꞌ ñajunꞌ rí xúge̱ꞌ, numuu na̱tha̱nꞌlaꞌ rí gakon rá dxe̱ꞌ.<verse eid="GAL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17" />Maphú naxná-gamiéjúún xa̱bo̱ tsúꞌkhue̱n e̱ne̱laꞌ rí xúge̱ꞌ, i̱ndo̱ó máꞌ numuu rí rígu-jnuu rí nuni̱i̱. Nandúu̱n rí ma̱mbumalaꞌ ju̱yo̱ꞌ ikhúúnꞌ jamí rí ma̱xná-gamiéjwanlaꞌ gúni̱i̱ i̱ndo̱ó máꞌ ikhii̱n. <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />Máján máꞌ rí naxná-gamiéjúún xa̱bo̱ e̱ne̱laꞌ, xí numuu nduꞌyée̱ rí ma̱juwa-májánlaꞌ jamí naxná-gamiéjúu̱n jámba̱ miꞌtsú mangaa, ra̱ꞌkhá i̱ndo̱ó ído̱ rí xtáá ikhúúnꞌ ga̱jma̱á nindxa̱ꞌlaꞌ. <verse eid="GAL 4:18" /><verse number="19" style="v" sid="GAL 4:19" />I̱ji̱nꞌ, phú nandoꞌ ja̱ya̱ꞌlaꞌ. Ga̱jma̱á numalaꞌ ikháanꞌ na̱mínu̱u̱ꞌ mbu̱júꞌ xómá a̱ꞌgo̱ tsí inu ma̱ꞌne-xuajen. Xkuaꞌnii ma̱ꞌgá-ra̱mínu̱u̱ꞌ asndo mbiꞌi rí ma̱nindxa̱ꞌlaꞌ xómá jaꞌnii Krísto̱. <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />Maphú naꞌne a̱kui̱nꞌ rí ma̱xtáá ga̱jma̱á nindxa̱ꞌlaꞌ núkho̱ máꞌ xúge̱ꞌ kajngó ma̱riꞌkhuu wáa xó rí na̱tha̱nꞌlaꞌ, numuu rí nánguá i̱yo̱o̱ dí gáne̱ ga̱jma̱á nindxa̱ꞌlaꞌ.<verse eid="GAL 4:20" /></para>
  <para style="s">Agáár ga̱jma̱á Sára̱</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />Gu̱riꞌñuꞌlaꞌ ríge̱ꞌ, ikháanꞌlaꞌ tsáanꞌ nandalaꞌ gúne̱-mbáníí xtángawoo Moisés: Á gakon rí nafraꞌa̱ꞌlaꞌ rí naꞌthán ne̱ rá. <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />Ikhín ka̱ma naꞌthán rí Abraám ni̱gi̱ꞌdiin a̱jmi̱i e̱je̱n. Mbáa̱ niꞌnii a̱ꞌgo̱ yumbáá tsí waꞌtsi̱i̱, jamí i̱mba̱a̱ꞌ niꞌnii a̱ꞌgo̱ tsí naꞌthán-ñájun-mina̱ꞌ máꞌ ikhaa. <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />A̱dée a̱ꞌgo̱ yumbáá tsí waꞌtsi̱i̱, ni̱gu̱maa̱ xómá na̱gu̱mii jañúú xa̱bo̱ numbaa. Xómáꞌ a̱dée a̱ꞌgo̱ tsí naꞌthán-ñájun-mina̱ꞌ máꞌ ikhaa rá, ni̱gu̱maa̱ ga̱jma̱á numuu rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ ma̱ꞌne.<verse eid="GAL 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 4:24" />Mbá xkri̱da ñajuun rí na̱tha̱nꞌlaꞌ ge̱jyoꞌ: A̱jmi̱i go̱ꞌo̱ tsíge̱ꞌ ñajúún asndo xó xtiꞌkhuu a̱jma̱ awan rí niꞌgí Ana̱ꞌlóꞌ. Mbá ne̱ ñajuun rí niꞌgí Ana̱ꞌlóꞌ ná júba̱ Sinaí. Ikhaa naꞌne xkri̱doo Agáár, tsí naꞌnii e̱je̱n tsí ma̱nindxu̱ún yumbáá waꞌtsi̱in. <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />Agáár naꞌne xkri̱doo júba̱ Sinaí rí ꞌgí ná numbaa Arábia̱, jamí ikhaa̱ máꞌ naꞌne xtiꞌkhuu xuajen Jerusalén rí ꞌgí xúge̱ꞌ, numuu rí xúge̱ꞌ ikhaa̱ gajmíi̱ i̱jii̱n ñajúu̱n yumbáá waꞌtsi̱in drígo̱o̱ xtángoo. <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />Xómáꞌ Jerusalén rí ríga̱ mikhuíí rá, tsí ñajuun xómá nániálóꞌ, ra̱ꞌkhá yumbáá tsí waꞌtsi̱in ñajúún i̱jii̱n ikhaa̱. <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />Numuu rí xkuaꞌnii ka̱ma naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="b" vid="GAL 4:27" />
  <para style="q" vid="GAL 4:27">«Ikháánꞌ nána̱, tsáánꞌ na̱nguá iyoo ma̱tha̱ni̱i e̱je̱n,</para>
  <para style="q" vid="GAL 4:27">ga̱ꞌdxu a̱kia̱anꞌ.</para>
  <para style="q" vid="GAL 4:27">Ikháánꞌ, tsáánꞌ ni miꞌtsú tátha̱ne̱ xuajen,</para>
  <para style="q" vid="GAL 4:27">atandxaꞌwá numuu rí gagi xtaa.</para>
  <para style="q" vid="GAL 4:27">Numuu rí i̱tha̱án mbaꞌiin e̱je̱n ma̱gi̱ꞌdiin a̱ꞌgo̱ tsí ninguaná-ti̱go̱o̱</para>
  <para style="q" vid="GAL 4:27">xó rí a̱ꞌgo̱ tsí ninújún».<note caller="+" style="f"><char style="fr" closed="false">4.27 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ Isaía̱s 54.1.</char></note><verse eid="GAL 4:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28" />A̱ngui̱nꞌ, ikháánꞌlóꞌ<note caller="+" style="f"><char style="fr" closed="false">4.28 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «ikháanꞌlaꞌ».</char></note> ni̱gu̱máaꞌlóꞌ xómá ni̱gu̱maa Isaák. Ni̱gu̱máaꞌlóꞌ ga̱jma̱á numuu rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxu̱u̱ Abraám. <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />Jamí xúge̱ꞌ naríga̱ xómá niríga̱ nákhí wajyúú, rí ada̱ tsí ni̱gu̱maa xómá na̱gu̱mii jañúú xa̱bo̱ numbaa, naꞌne-ngínáa̱ tsí ni̱gu̱maa ga̱jma̱á ski̱yu̱u̱ꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ. <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />Xómáꞌ i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ, dí iꞌthán ne̱ ga̱jma̱á numuu rúꞌkhue̱n rá. Xáꞌnii iꞌthán ne̱: «Ataxkriya̱a̱ꞌ a̱ꞌgo̱ yumbáá tsí waꞌtsi̱i̱ ma̱ꞌga janíí ga̱jma̱á a̱dée. Numuu rí ra̱jáꞌyoo a̱dée̱ rí ma̱janáá mangaa rí jaꞌyoo i̱ndo̱ó máꞌ a̱dée a̱ꞌgo̱ tsí naꞌthán-ñájun-mina̱ꞌ máꞌ ikhaa». <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />Ikhaa jngó, a̱ngui̱nꞌ, ra̱ꞌkhá i̱ji̱in a̱ꞌgo̱ yumbáá tsí waꞌtsi̱i̱ ñajwanlóꞌ ikháánꞌlóꞌ, rí i̱ji̱in a̱ꞌgo̱ tsí naꞌthán-ñájun-mina̱ꞌ máꞌ ikhaa ñajwanlóꞌ.<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="s">Krísto̱ neꞌne-jáwiáanꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />Krísto̱ neꞌne-jáwiáanꞌlóꞌ kajngó náxánindxa̱ꞌlóꞌ yumbáá tsí waꞌtsi̱in. Ikhaa jngó, ga̱wajún-gúkuálaꞌ jamí mu̱xúni̱ꞌñá-mijnálaꞌ rí ma̱nindxa̱ꞌlaꞌ mbu̱júꞌ yumbáá tsí ni̱tsu̱mii rí mune̱-mbáníí rí naꞌthán xtángoo.<verse eid="GAL 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2" />Gu̱dxawíín májánlaꞌ rí ma̱tha̱nꞌlaꞌ jmínu̱úꞌ ikhúúnꞌ, Páblo̱. Xí nu̱ni̱ꞌñá-mijnálaꞌ rí mbu̱ya̱laꞌ tsina jndi kajngó ma̱juwa-májánlaꞌ ná inuu Ana̱ꞌlóꞌ, nda̱a̱ nitháan rí gámbáyálaꞌ rí neꞌne Krísto̱. <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />Nathangu̱ún na̱tha̱nꞌlaꞌ mbu̱júꞌ, asndo tsáa máꞌ tsí naniña-mina̱ꞌ rí ma̱gu̱maa tsina jndi, wéje̱ inuu̱ rí ma̱ꞌne-mbánuu̱ mbá xúgíí rí naꞌthán xtángoo. <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />Tsí nandúún gúne̱-mbáníí xtángoo kajngó maꞌthán Ana̱ꞌlóꞌ rí nánda̱a̱ aꞌkhúu̱n, ni̱rawí-mijnée̱ máꞌ ná ñawúun Krísto̱, jamí nánguá iya-makuíi̱ rí naxná Ana̱ꞌlóꞌ. <verse eid="GAL 5:4" /><verse number="5" style="v" sid="GAL 5:5" />Xómáꞌ ikháánꞌlóꞌ rá, ga̱jma̱á numuu Xu̱u̱ꞌ Ana̱ꞌlóꞌ mbá jañii a̱kia̱nꞌlóꞌ guáꞌthi̱ínlóꞌ rí maꞌthán Ana̱ꞌlóꞌ rí nánda̱a̱ aꞌkhánlóꞌ, numuu rí wéje̱ a̱kia̱nꞌlóꞌ ná inuu Krísto̱. <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />Numuu rí ná inuu Krísto̱ Jesús, tsíꞌyoo máꞌ xí juꞌyálóꞌ tsina jndi o na̱nguá mbo̱ꞌ. Rí phú i̱tha̱án gíꞌdoo numuu ñajuun rí wéje̱ a̱kia̱nꞌlóꞌ ná inuu Krísto̱, jamí rúꞌkhue̱n naꞌne rí ma̱galóꞌ juꞌñúú xa̱bo̱.<verse eid="GAL 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7" />Phú máján máꞌ ni̱ra̱tuunlaꞌ jamba̱a̱ ríge̱ꞌ rí ginii. Tsáa ni̱we̱je̱-ꞌtha̱nꞌlaꞌ kajngó mu̱ni̱ꞌñáá-ranimba̱ꞌlaꞌ ajngáa máján rí gakon róꞌ. <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />Ra̱ꞌkhá Ana̱ꞌlóꞌ ñajuun tsí ni̱we̱je̱-ꞌtha̱nꞌlaꞌ, numuu rí ikhaa̱ ñajuu̱n tsí nindxaꞌwálaꞌ. <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" />Numuu rí «mbá lájwíin ñu̱u̱ miga̱ꞌ naꞌne rí ma̱ga̱yu̱u̱ꞌ mbá xúgíí ñu̱u̱ rí máján». <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />Xómáꞌ ikhúúnꞌ, mbá jañii a̱kui̱nꞌ ná inuu Táta̱ rí ikhaa máꞌ i̱ndxa̱ꞌwa̱-mijná mangáanꞌlaꞌ. Jamí tsí naꞌne-ngra̱ꞌáanꞌlaꞌ, mbayée̱ xkuíya̱ gáꞌne Ana̱ꞌlóꞌ, asndo tsáa máꞌ ñajuu̱n.<verse eid="GAL 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11" />A̱ngui̱nꞌ, xí gakon rí ikhúúnꞌ na̱sngáálo̱ꞌ xóó rí ndaꞌyóo mbuya̱ xa̱bo̱ tsina jndi, náá numuu kajngó nune̱-ngínúú xa̱bo̱ judío̱ xúꞌkhue̱n róꞌ. Xí gakon rí rúꞌkhue̱n i̱sngáálo̱ꞌ, ma̱xájiꞌníi̱ máꞌ gáꞌne rí na̱sngáálo̱ꞌ ga̱jma̱á numuu Krísto̱, tsí nijáñuu ná ixe̱ krúsi̱ xúꞌkhue̱n róꞌ. <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />Phú naꞌne a̱kui̱nꞌ rí xa̱bo̱ tsí nune̱-ngra̱ꞌáanꞌlaꞌ a̱ꞌkhue̱n, ¡mbáko máꞌ gúru̱thun-ríguíi̱ mbá jayu xuñúu̱!<verse eid="GAL 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13" />Xómáꞌ ikháanꞌlaꞌ rá, a̱ngui̱nꞌ, tándxaꞌwálaꞌ Ana̱ꞌlóꞌ rí mi̱ꞌthán-ñájwanlaꞌ gáꞌne xtángoo. Ra̱ꞌkhá rúꞌkhue̱n iꞌthán rí ma̱goo mu̱ne̱laꞌ asndo wátha̱ inii rí xkawe̱ꞌ rí nandoo gáꞌne xuyalaꞌ. A̱ꞌkhue̱n gakon, gu̱ne̱-mba̱a̱-mijnálaꞌ kajngó ma̱kujma rí nandalaꞌ ju̱ya̱-mijnálaꞌ. <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />Numuu rí mbá xúgíí xtángoo na̱gu̱ma-mbáníí ne̱ ga̱jma̱á numuu mbóó xtángoo ríge̱ꞌ: «Ga̱gaaꞌ xtayáá xa̱bo̱ numbaa ga̱jma̱a̱ꞌ xómá rí nandaaꞌ xtaya-mina̱ꞌ ikháánꞌ».<note caller="+" style="f"><char style="fr" closed="false">5.14 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ xó kixnáxe̱ tsi̱gi̱jña̱ꞌ 19.18.</char></note> <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />Jamí xí i̱ndo̱ó máꞌ na̱tsa̱ña̱ꞌlaꞌ jamí napho-mijnálaꞌ rá, ¡xawi lá gúne̱laꞌ, ra̱ꞌkhá mu̱ne̱-gámba̱-mijnálaꞌ!<verse eid="GAL 5:15" /></para>
  <para style="s">Ga̱juwalaꞌ rí mu̱ne̱laꞌ rí nandoo Xu̱u̱ꞌ Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />Ikhaa jngó xáꞌnii i̱tha̱nꞌlaꞌ: Ga̱juwalaꞌ rí mu̱ne̱laꞌ rí nandoo Xu̱u̱ꞌ Ana̱ꞌlóꞌ, kajngó mu̱xúne̱laꞌ rí xkawe̱ꞌ nandoo xuyalaꞌ. <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" />Numuu rí xuyalóꞌ na̱tsa̱ñu̱u̱ꞌ ga̱jmáa̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ. Xúꞌkhue̱n máꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ na̱tsa̱ñu̱u̱ꞌ ga̱jmáa̱ xuyalóꞌ. Mbá nájmii̱ nawajún-ꞌthu̱n-mijnée̱, kajngó mu̱xúne̱laꞌ rí nandalaꞌ. <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />I̱ndo̱ó máꞌ xí nu̱ne̱-mbáníílaꞌ rí nandoo Xu̱u̱ꞌ Ana̱ꞌlóꞌ, na̱nguá máꞌ wéje̱ inalaꞌ rí mu̱ne̱-mbáníílaꞌ xtángoo xúꞌkhue̱n rá.<verse eid="GAL 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19" />Nakujma nguáná máꞌ mbu̱ꞌyáálóꞌ tsáa ñajuun tsí naꞌne rí nandoo xuyuu: tsí nabóo ga̱jma̱á xa̱bo̱ tsí táyáa, tsí nanújngoo-rámuu naꞌne rí xkawe̱ꞌ, tsí maphú mate̱ꞌ rí naꞌne, <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />tsí naꞌne-mbi̱in tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún, tsí naꞌne xawan, tsí gíꞌdiin sia̱nꞌ xa̱bo̱, tsí nakúxe̱ a̱ꞌwá, tsí naxíyu̱u̱ꞌ, tsí najiꞌnáa ga̱jma̱á numuu mbá xúgíí, tsí najiꞌnáa jaꞌñúú xa̱bo̱, tsí na̱tsa̱ñu̱u̱ꞌ gajmíí xa̱bo̱, tsí naꞌne rí mu̱xpi̱ꞌtha̱-mijná xa̱bo̱, <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />tsí naxígu̱u̱ꞌ, tsí na̱gu̱díin xa̱bo̱, tsí najnga̱a̱, tsí naꞌne ndxa̱a̱ numuu rí ma̱ꞌne rí xkawe̱ꞌ na̱nda̱ꞌa̱ xuyuu, jamí i̱ꞌwá rí xkuaꞌnii máꞌ xkawe̱ꞌ. Na̱tha̱nꞌlaꞌ mbu̱júꞌ, xómá ni̱tha̱nꞌlaꞌ nákhí xúꞌkhue̱n, tsí nune̱ máꞌ xúꞌkhue̱n rí xkawe̱ꞌ, nda̱a̱ rí gájanúu̱ ná naꞌthán-ñájun Ana̱ꞌlóꞌ.<verse eid="GAL 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22" />Xómáꞌ tsí Xu̱u̱ꞌ Ana̱ꞌlóꞌ rá, naꞌnii̱ rí ma̱galóꞌ juꞌñúú xa̱bo̱, rí ma̱ꞌdxu a̱kia̱nꞌlóꞌ, rí ma̱juwalóꞌ tsímáá, rí ma̱ꞌngo̱o̱ a̱kia̱nꞌlóꞌ, rí ma̱ꞌne gamakuáanꞌlóꞌ, rí ma̱ꞌne májáan a̱kia̱nꞌlóꞌ, rí mu̱ꞌne̱-mbáníílóꞌ rí nuꞌthánlóꞌ, <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />rí mu̱xrígú-mijnálóꞌ, jamí rí mu̱xúꞌne̱lóꞌ rí xkawe̱ꞌ nandoo xuyalóꞌ. Nda̱a̱ nimbá xtángoo rí naꞌthán rí ra̱máján rí mu̱ꞌne̱lóꞌ mbá xúgíí rúꞌkhue̱n. <verse eid="GAL 5:23" /><verse number="24" style="v" sid="GAL 5:24" />Jamí tsí ñajúún xa̱bi̱i Krísto̱,<note caller="+" style="f"><char style="fr" closed="false">5.24 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «Krísto̱ Jesús».</char></note> nini̱i̱ máꞌ rí ma̱ja̱ñúu ná ixe̱ krúsi̱ mbá xúgíí inii rí xkawe̱ꞌ rí nandoo gáꞌne xuñúu̱. <verse eid="GAL 5:24" /><verse number="25" style="v" sid="GAL 5:25" />Numuu rí ga̱jma̱á numuu Xu̱u̱ꞌ Ana̱ꞌlóꞌ juwalóꞌ rí xúge̱ꞌ, ikhaa jngó jaꞌyoo rí mu̱ꞌgua̱-ru̱ꞌne̱lóꞌ rí nandoo Xu̱u̱ꞌ Ana̱ꞌlóꞌ mangaa. <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />Ma̱xáju̱ma̱ꞌlóꞌ rí ikháánꞌlóꞌ phú i̱tha̱án gíꞌdoo numalóꞌ xó rí i̱ꞌwíin, mu̱xúꞌne̱lóꞌ rí ma̱jiꞌnáaꞌlóꞌ juꞌya-mijnálóꞌ, ni máꞌ ma̱xáxígua̱ꞌlóꞌ juꞌya-mijnálóꞌ.<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="s">Mbaꞌa inii rí máján ma̱goo mu̱ꞌne̱lóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />A̱ngui̱nꞌ, xí ndi̱ya̱álaꞌ rí mbáa ni̱rákaa ná aꞌkhán, tsáanꞌ juwalaꞌ xómá rí nandoo Xu̱u̱ꞌ Ana̱ꞌlóꞌ, gu̱mbáyíi̱laꞌ kajngó ma̱ꞌkhaa̱ ná inuu Jesús. I̱ndo̱ó máꞌ numuu rí gu̱xrígú-mijnálaꞌ ído̱ rí nu̱mbáyíi̱laꞌ, jamí gu̱ña̱wa̱n-míjná máꞌ ikháanꞌlaꞌ, ra̱ꞌkhá ma̱rákáanꞌlaꞌ mangáanꞌlaꞌ gáꞌne. <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />Gu̱mbáyú-mijnálaꞌ ído̱ rí guáꞌdáálaꞌ gaꞌkho̱ rí phú gakhe̱, numuu rí xkuaꞌnii mu̱ne̱-mbáníílaꞌ rí niꞌsngáá Krísto̱. <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />Xí mbáa na̱ju̱mu̱u̱ rí phú gíꞌdoo numuu, jamí nda̱a̱ nitháan rí ñajuu̱n, naꞌne-nduwa-mine̱e̱ꞌ máꞌ ikhaa̱. <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />Mbámbáa gáyaxu̱u̱ mújúun rí naꞌne, jamí xí ríga̱ rí ma̱goo ma̱kúxe̱-mine̱e̱ꞌ ga̱jma̱á, gakúxe̱-mine̱e̱ꞌ máꞌ ná inuu̱ ikhaa̱, jamí ma̱xágiéwan-mine̱e̱ꞌ ga̱jma̱á rí nune̱ i̱ꞌwíin. <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />Numuu rí mbámbáa jaꞌyoo mariꞌña ná inuu Ana̱ꞌlóꞌ ga̱jma̱á numuu rí neꞌne.<verse eid="GAL 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6" />Tsí nisngáá ajngáa rawuun Ana̱ꞌlóꞌ, gíꞌmaa̱ rí maxnúu̱ tháan tsí nisngáa̱ eꞌne mbá xúgíí inii rí máján gíꞌdoo̱.<verse eid="GAL 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7" />Mu̱xúne̱-nduwa-mijnálaꞌ: ma̱xáju̱ma̱ꞌlaꞌ rí ma̱goo mu̱tsi̱jmáalaꞌ tsí Ana̱ꞌlóꞌ. Mbá xúgíí máꞌ rí naꞌdu xa̱bo̱, ikhaa máꞌ rúꞌkhue̱n ñajuun rí maguu̱. <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />Numuu rí xa̱bo̱ tsí naꞌne máꞌ xúꞌkhue̱n rí nandoo xuyuu, ikhaa máꞌ rúꞌkhue̱n ma̱ꞌne rí ma̱ja̱ñúu̱. Xómáꞌ tsí naꞌne máꞌ xúꞌkhue̱n rí nandoo Xu̱u̱ꞌ Ana̱ꞌlóꞌ rá, Xu̱u̱ꞌ Ana̱ꞌlóꞌ ma̱ꞌne rí ma̱xtáa̱ jámuu. <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />Ma̱xáꞌne níꞌnga̱ꞌlóꞌ rí mu̱ꞌne̱lóꞌ rí máján. Numuu rí ído̱ ága̱nú mbiꞌi, mbu̱ꞌyáálóꞌ rí máján, xí tsíꞌne níꞌnga̱ꞌlóꞌ. <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />Ikhaa jngó, jámba̱ miꞌtsú rí ma̱goo mu̱ꞌne̱lóꞌ, gu̱ꞌñu̱úlóꞌ rí máján mbá xúgíin xa̱bo̱, jamí i̱tha̱án máꞌ gu̱ꞌñu̱úlóꞌ rí máján a̱ngia̱nꞌlóꞌ tsí nanimba̱ꞌ gajmiálóꞌ juꞌyáá Jesús.<verse eid="GAL 6:10" /></para>
  <para style="s">Phú i̱tha̱án gíꞌdoo numuu rí ni̱gu̱ma-nuxáanꞌlóꞌ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />Jmínu̱úꞌ ikhúúnꞌ na̱tháán ríge̱ꞌ, jamí gu̱ya̱xe̱laꞌ rí phú mba̱ꞌwo̱ tsina e̱ne̱lo̱ꞌ ga̱jma̱á ñawúnꞌ.<verse eid="GAL 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 6:12" />Tsí nandúún gúne̱ ski̱ya̱ꞌlaꞌ rí mbu̱ya̱laꞌ tsina jndi, i̱ndo̱ó máꞌ nuni̱i̱ rúꞌkhue̱n numuu rí nandúu̱n rí mi̱ꞌtiamakúu̱n gúne̱ xa̱bo̱. Tsíñúu̱ rí ma̱gu̱ma-ngíníi̱ gúne̱ xa̱bo̱ ga̱jma̱á numuu Krísto̱, tsí nijáñuu ná ixe̱ krúsi̱. <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />Numuu rí ni máꞌ ikhii̱n, tsí juya̱ tsina jndi, na̱nguá ene̱-mbáníi̱ rí naꞌthán xtángoo. Xómáꞌ ikhii̱n nandúu̱n rí ikháanꞌlaꞌ mbu̱ya̱laꞌ tsina jndi, kajngó ma̱goo mune̱-tsiꞌyée̱ rí ni̱ꞌngúu̱n nene̱-rájáanꞌlaꞌ rí mbu̱ya̱laꞌ tsina rúꞌkhue̱n ná xuyalaꞌ. <verse eid="GAL 6:13" /><verse number="14" style="v" sid="GAL 6:14" />Xómáꞌ ikhúúnꞌ rá, tsíyoꞌ gáne̱-tsiꞌyá ga̱jma̱á numuu i̱mba̱, rí i̱ndo̱ó máꞌ ga̱jma̱á numuu rí nijáñuu Tátiálóꞌ Jesukrísto̱ ná ixe̱ krúsi̱. Numuu rí ga̱jma̱á numuu Krísto̱, nijáñuu máꞌ numbaa ná inuꞌ ikhúúnꞌ, jamí ikhúúnꞌ nijáñuꞌ máꞌ ná inuu numbaa. <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />Numuu rí ná inuu Krísto̱ Jesús,<note caller="+" style="f"><char style="fr" closed="false">6.15 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «ná inuu Krísto̱ Jesús».</char></note> tsíꞌyoo máꞌ xí juꞌyálóꞌ tsina jndi o na̱nguá mbo̱ꞌ. Rí phú i̱tha̱án gíꞌdoo numuu ñajuun rí ni̱gu̱máaꞌlóꞌ nuxe̱ꞌ. <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />Ana̱ꞌlóꞌ gáꞌne rí ma̱ju̱wá tsímáá mbá xúgíin tsí nune̱-mbáníí awan ríge̱ꞌ, jamí ga̱ñáwíin a̱kui̱in Ana̱ꞌlóꞌ jaꞌñúu̱. Ikhii̱n ñajúu̱n xa̱bo̱ Israél tsí gakon rí xa̱bi̱i Ana̱ꞌlóꞌ ñajúún.<verse eid="GAL 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17" />Rí xúge̱ꞌ rá, níyoꞌ rí ma̱ꞌñiꞌ xkujndu asndo nimbáa xa̱bo̱, numuu rí ikhúúnꞌ ja̱go̱ ná xuyuꞌ tsínu̱u̱ꞌ rí nijámbi̱yu̱ꞌ ga̱jma̱á numuu Táta̱ Jesús.<verse eid="GAL 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18" />A̱ngui̱nꞌ, Tátiálóꞌ Jesukrísto̱ gáꞌne-tsakun-rámaa mbámbáa tsí ikháanꞌlaꞌ. Xkuaꞌnii gáꞌne.<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>