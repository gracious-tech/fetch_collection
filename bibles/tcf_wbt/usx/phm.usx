<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">tcfU (58-Filem) - Me̱ꞌpha̱a̱ Mañúwi̱ín (Malinaltepec); ago-2007 Traz inic de PZM, c1/v25</book>
  <para style="h">Filemón</para>
  <para style="toc3">Flm</para>
  <para style="toc2">Filemón</para>
  <para style="toc1">I̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inuu Filemón</para>
  <para style="mt2">I̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inuu</para>
  <para style="mt1">Filemón</para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="s">Páblo̱ naraxi̱i Filemón</para>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />Ikhúúnꞌ ñajunꞌ Páblo̱, kru̱ꞌúúnlo̱ꞌ géjwa̱nꞌ ga̱jma̱á numuu rí na̱ne̱lo̱ꞌ ñajuun Jesukrísto̱. Ga̱jmi̱ꞌ dxájwalóꞌ Timotéo̱, nu̱ra̱xi̱ínxo̱ꞌ, dxájuꞌ Filemón, tsáán natiajun ga̱jma̱á nindxa̱ꞌxo̱ꞌ. <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />Nu̱ra̱xi̱ixo̱ꞌ dxájwalóꞌ Ápia̱, jamí Arkípo̱ tsí nañajun ga̱jma̱á nindxa̱ꞌlóꞌ. Xúꞌkhue̱n máꞌ nu̱ra̱xi̱inxo̱ꞌ tsí nanimbu̱únꞌ juyáá Jesús tsí na̱gi̱mbíin ná guꞌwáaꞌ. <verse eid="PHM 1:2" /><verse number="3" style="v" sid="PHM 1:3" />Ana̱ꞌlóꞌ Mikhuíí jamí Táta̱ Jesukrísto̱ gúne̱-tsakun-rámáaꞌlaꞌ jamí ikhii̱n máꞌ gúni̱i̱ rí ma̱juwalaꞌ tsímáá.<verse eid="PHM 1:3" /></para>
  <para style="s">Páblo̱ narígu̱u gamaku inuu Ana̱ꞌlóꞌ ga̱jma̱á numuu Filemón</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />Mbámbá ído̱ rí na̱tha̱n-jáñuu Anu̱ꞌ Mikhuíí, na̱rmáꞌáan a̱kui̱nꞌ ja̱ya̱a̱, dxájuꞌ Filemón, jamí phú na̱rígu̱u gamaku inuu̱ ga̱jma̱á numaaꞌ. <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />Numuu rí na̱dxawuunlo̱ꞌ rí wéje̱ a̱kia̱anꞌ ná inuu Táta̱ Jesús jamí rí phú nandaaꞌ xtayáa̱. Xúꞌkhue̱n máꞌ na̱dxawuunlo̱ꞌ rí phú nandaaꞌ xtañúú mbá xúgíin xa̱bi̱i Ana̱ꞌlóꞌ. <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />Phú na̱ndo̱ꞌo̱o̱ Ana̱ꞌlóꞌ ga̱jma̱á numaaꞌ kajngó ma̱tha̱ne̱ xómá nu̱ꞌne̱lóꞌ tsáanꞌ nanimba̱ꞌlóꞌ juꞌyáa̱, numuu rí nadxo̱ꞌ-rathane̱-nuwiin máꞌ mbá xúgíí rí máján, rí nijaná-málóꞌ neꞌne Krísto̱ Jesús. <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />Maphú nadxu a̱kui̱nꞌ, jamí ndayáa xu̱u̱ꞌ ními̱ꞌ ithane̱, dxájuꞌ, numuu rí nandaaꞌ xtañúú a̱ngia̱nꞌlóꞌ, jamí numuu rí ga̱jma̱á majña̱a̱ꞌ ikháánꞌ nudaa̱ ski̱ñúu̱.<verse eid="PHM 1:7" /></para>
  <para style="s">Páblo̱ na̱ndo̱ꞌo̱o̱ Filemón rí ma̱grui̱guíi̱ Onési̱mo̱</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />Dxájuꞌ Filemón, maske máꞌ phú gúꞌdo̱ꞌ tsiakhe̱ eꞌne Krísto̱ rí ma̱xna̱-ñájwaanꞌ rí gíꞌmaa ma̱tha̱ne̱ no rá, <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />i̱wa̱á máján rí ma̱tha̱n-jáñaaꞌ ga̱jma̱á numuu rí nandalóꞌ juꞌya-mijnálóꞌ. Rí xúge̱ꞌ rá, ikhúúnꞌ Páblo̱, táta̱-xi̱ꞌñú máꞌ ñajunꞌlo̱ꞌ, jamí kru̱ꞌúúnlo̱ꞌ géjwa̱nꞌ ga̱jma̱á numuu rí na̱ne̱lo̱ꞌ ñajuun Jesukrísto̱. <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />Ikhaa jngó phú na̱tha̱n-jáñaaꞌlo̱ꞌ ga̱jma̱á numuu Onési̱mo̱, tsí ninindxu̱u̱ asndo xóo mbáa a̱ꞌdéꞌ ná awúun mbiꞌi rí kru̱ꞌúún géjwa̱nꞌ ge̱jyoꞌ. <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />Rí nákhí xúꞌkhue̱n, Onési̱mo̱ tsíge̱ꞌ ñajuun mbáa yumbáá waꞌtsi̱i̱ tsí nda̱a̱ jayu numuu ná rí inaaꞌ. Rí xúge̱ꞌ rá, phú najmaa̱ rí mambáyálóꞌ, ikháánꞌ jamí ikhúúnꞌ. <verse eid="PHM 1:11" /><verse number="12" style="v" sid="PHM 1:12" />Ikhaa jngó na̱rthangaa̱lo̱ꞌ ma̱ꞌgaa̱ ná inaaꞌ. A̱tri̱guíi̱ tháan asndo xómá rí ikhúúnꞌ máꞌ.<note caller="+" style="f"><char style="fr" closed="false">1.12 </char><char style="ft" closed="false">Ná i̱yi̱i̱ꞌ griégo̱ rí wayuu naꞌthán «xó rí ními̱ꞌ ñajuu̱n».</char></note> <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />Phú nandoꞌ lá rí ma̱nguanúu̱ ga̱jma̱á nindxu̱ꞌ ikhúúnꞌ no rá, kajngó ma̱ꞌnii̱ ñajwaanꞌ rí jaꞌyaaꞌ ikháánꞌ ma̱tha̱ne̱, rí ma̱tha̱ne̱-mba̱ꞌwu̱ún awúun mbiꞌi rí kru̱ꞌúúnlo̱ꞌ géjwa̱nꞌ ga̱jma̱á numuu ajngáa máján. <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />Xómáꞌ ikhúúnꞌ, ra̱khóꞌ gáya̱ idxu̱ꞌ mbáwúún rí ma̱ne̱, xí ra̱ꞌkhá awaanꞌ mangáánꞌ. Kajngó ma̱xáꞌne rí na̱tsu̱dáánꞌ rí ma̱tha̱ñu̱ꞌ tháan rí máján, rí numuu rí xkuaꞌnii ꞌcháa a̱kia̱anꞌ mangáánꞌ.<verse eid="PHM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15" />Á gáꞌne xí numuu rúꞌkhue̱n kajngó neꞌne-tsíngua̱ꞌ-mina̱ꞌ Onési̱mo̱ ná inaaꞌ mbá wátha̱ wáa mbiꞌi, kajngó ma̱goo ma̱tri̱guíi̱ mbá jámuu rí xúge̱ꞌ rá. <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />Nákha rí ma̱raꞌdaa̱ xómá mbáa yumbáá waꞌtsi̱i̱, rí ma̱raꞌdaa̱ asndo xómá mbáa tsí phú i̱tha̱án gíꞌdoo numuu: xómá mbáa dxíya̱a̱ꞌ tsí phú nandaaꞌ xtayáá. Ikhúúnꞌ phú nandoꞌ ja̱yo̱o̱lo̱ꞌ, xúꞌkhue̱n máꞌ ikháánꞌ phú i̱tha̱án jaꞌyoo rí ma̱gaaꞌ xtayáa̱, ra̱ꞌkhá i̱ndo̱ó numuu rí xa̱bo̱ ñajuu̱n, rí ga̱jma̱á numuu rí dxájwalóꞌ ñajuu̱n ná inuu Táta̱.<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />Ikhaa jngó, xí nathayáá máꞌ rí dxájwaaꞌ ñajunꞌlo̱ꞌ, a̱tri̱guíi tháan Onési̱mo̱ ná guꞌwáaꞌ, asndo xó rí ikhúúnꞌ máꞌ. <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />Xí niꞌñaa̱ꞌ mbá rí ra̱máján, o xí gíꞌmaa̱ inaaꞌ mbo̱ꞌ, a̱tru̱múú ikhúúnꞌ ga̱jma̱á numuu̱. <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />Ikhúúnꞌ jmínu̱úꞌ Páblo̱ na̱tháán ríge̱ꞌ ga̱jma̱á ñawúnꞌ. Na̱xu̱ꞌdá-mina̱ꞌlo̱ꞌ rí ma̱ne̱-numa̱a gidxáwóo̱. A̱tru̱múú máꞌ ikhúúnꞌ, maske máꞌ tsíyoꞌ gátha̱a̱nꞌ rí ikháánꞌ mangáánꞌ gíꞌmáá inuꞌ rí xtaa nathaya. <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />Ikhaa jngó, dxájuꞌ Filemón, athañu̱ꞌ tháan mbá rí máján ríge̱ꞌ ga̱jma̱á numuu rí nandaaꞌ xtayáá Ana̱ꞌlóꞌ. Athane̱ rí ma̱ꞌni̱i a̱kui̱nꞌ numuu rí xa̱bi̱i Krísto̱ ñajwanlóꞌ.<verse eid="PHM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21" />Na̱ne̱ i̱yi̱i̱ꞌ ríge̱ꞌ ma̱ꞌga inaaꞌ numuu rí nda̱yo̱o̱ máꞌ rí ma̱tha̱ne̱-mbáníí, jamí ma̱tha̱ne̱ asndo xóó i̱tha̱án xó rí na̱nda̱ꞌa̱a̱ꞌ xúge̱ꞌ. <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />Xúꞌkhue̱n máꞌ araꞌdáá na̱ma̱ñaaꞌ ná mba̱ya̱a̱ xu̱ꞌlo̱ꞌ, numuu rí gúꞌthu̱u̱nlo̱ꞌ rí Ana̱ꞌlóꞌ madxawuun rí nu̱nda̱ꞌáa̱laꞌ ga̱jma̱á numuꞌ, kajngó ma̱goo ma̱ꞌgá gáya̱ꞌlaꞌ.<verse eid="PHM 1:22" /></para>
  <para style="s">Páblo̱ naꞌthángoo</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />Naraxi̱ín Epáfra̱s, dxájuꞌ tsí kru̱ꞌúún ga̱jmi̱ꞌ ná géjwa̱nꞌ numuu rí nu̱ne̱xo̱ꞌ ñajuun Krísto̱ Jesús. <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />Naraxi̱ín Márko̱s, Aristárko̱, Déma̱s jamí Lúka̱s mangaa, a̱ngui̱nꞌ tsí na̱ñajun gajmíꞌ.<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />Tátiálóꞌ Jesukrísto̱ gáꞌne-tsakun-rámáaꞌlaꞌ. Xkuaꞌnii gáꞌne.<note caller="+" style="f"><char style="fr" closed="false">1.25 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «Xkuaꞌnii gáꞌne».</char></note><verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>