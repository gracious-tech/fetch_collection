<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id">tcfU (50-Efe) - Me̱ꞌpha̱a̱ Mañúwi̱ín (Malinaltepec) (sfm NVI), c6/v155</book>
  <para style="h">Xa̱bo̱ Éfe̱so̱</para>
  <para style="toc3">Ef</para>
  <para style="toc2">Xa̱bo̱ Éfe̱so̱</para>
  <para style="toc1">I̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inúú xa̱bo̱ Éfe̱so̱</para>
  <para style="mt2">I̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inúú</para>
  <para style="mt1">Xa̱bo̱ Éfe̱so̱</para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="s">Páblo̱ naraxi̱in tsí nanimbu̱únꞌ juyáá Jesús ná xuajen Éfe̱so̱</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />Ikhúúnꞌ ñajunꞌ Páblo̱, xa̱bo̱ tsí waxúngua̱a̱ꞌ neꞌne Jesukrísto̱ numuu rí xkuaꞌnii ndiyoo Ana̱ꞌlóꞌ.</para>
  <para style="p" vid="EPH 1:1">Na̱xu̱ꞌmá i̱yi̱i̱ꞌ ríge̱ꞌ ma̱ꞌga inúú xa̱bi̱i Ana̱ꞌlóꞌ tsí mbá jañii a̱kui̱ín nanimbu̱únꞌ juyáá Krísto̱ Jesús, tsí júwa̱ꞌ ná xuajen Éfe̱so̱.<verse eid="EPH 1:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2" />Ana̱ꞌlóꞌ Mikhuíí jamí Táta̱ Jesukrísto̱ gúne̱-tsakun-rámáaꞌlaꞌ jamí ikhii̱n máꞌ gúni̱i̱ rí ma̱juwalaꞌ tsímáá.<verse eid="EPH 1:2" /></para>
  <para style="s">Ga̱jma̱á majñu̱u̱ Krísto̱ ni̱gu̱ma-tsakun-rámáaꞌlóꞌ ná mikhuíí</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />A̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ, Anu̱u̱ Tátiálóꞌ Jesukrísto̱, numuu rí phú mbaꞌa inii rí máján na̱ꞌkha̱ mikhuíí nixnálóꞌ ga̱jma̱á majñu̱u̱ Krísto̱. <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />Ana̱ꞌlóꞌ niraꞌwáanꞌlóꞌ ga̱jma̱á majñu̱u̱ Krísto̱ asndo nákhí máꞌ xóó táꞌne-ku̱maa̱ numbaa, kajngó ma̱nindxa̱ꞌlóꞌ tsí jaꞌwuun jamí tsí nda̱a̱ aꞌkhúún ná inuu̱. Numuu rí phú nandoo̱ jaꞌyalóꞌ,<note caller="+" style="f"><char style="fr" closed="false">1.4 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ rí nagíꞌma ju̱ma̱ ríge̱ꞌ ná na̱gi̱ꞌdu̱u̱n kíxnuu 5.</char></note> <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />kajngó wapha máꞌ niꞌgí-mine̱e̱ꞌ rí ma̱ga̱nú mbiꞌi rí ma̱nindxa̱ꞌlóꞌ i̱jii̱n tsí niguu̱n ga̱jma̱á majñu̱u̱ Jesukrísto̱, i̱ndo̱ó máꞌ ga̱jma̱á numuu rí xkuaꞌnii ndiyoo̱ ikhaa̱. <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />Xkuaꞌnii neꞌne Ana̱ꞌlóꞌ, kajngó ma̱goo mi̱ꞌthán rí phú mba̱a̱ rí májáan a̱kuii̱n jaꞌyalóꞌ ga̱jma̱á majñu̱u̱ A̱dée̱ tsí phú nandoo̱ jaꞌyoo̱. <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" />Ga̱jma̱á numuu rí nijáñuu Krísto̱ ná ixe̱ krúsi̱, waꞌtse̱-ri̱ñáaꞌlóꞌ ná awúun jamínu̱ꞌ rí jaꞌyoo mu̱drígúlóꞌ jamí neꞌne mba̱a̱ a̱kui̱in Ana̱ꞌlóꞌ jaꞌyoo aꞌkhánlóꞌ. Xkuaꞌnii neꞌne Ana̱ꞌlóꞌ ga̱jma̱á nindxa̱ꞌlóꞌ numuu rí ra̱ꞌkhá tháán májáan a̱kuii̱n jaꞌyalóꞌ. <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />Ninújngoo-rámuu rí májáan a̱kui̱in Ana̱ꞌlóꞌ jaꞌyaló numuu rí phú na̱ma̱ñuu̱ jamí ndaꞌyoo̱ mújúu̱n rí naꞌnii̱. <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />Ikhaa̱ niꞌnii̱ rí mu̱ꞌne̱-nuwiinlóꞌ awan drígo̱o̱ rí i̱ndo̱ó máꞌ ikhaa̱ ni̱gi̱da̱ꞌ idxu̱u̱ nákhí wajyúú, rí niꞌgí-mine̱e̱ꞌ rí ma̱ꞌne-mbánuu̱ ga̱jma̱á majñu̱u̱ Krísto̱. <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />Ído̱ ága̱nú mbiꞌi rí ma̱ꞌne-mbánuu Ana̱ꞌlóꞌ awan drígo̱o̱, maꞌgíi̱ Krísto̱ maꞌthán-ñájuun mbá xúgíí rí ríga̱ mikhuíí jamí rí ríga̱ ná numbaa.<verse eid="EPH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11" />Xúꞌkhue̱n máꞌ mangaa, wapha máꞌ niraꞌwáanꞌlóꞌ Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ Krísto̱ rí mu̱drígúlóꞌ rí gíꞌdoo̱ maxnálóꞌ, numuu rí ikhaa̱ naꞌnii̱ rí ma̱mba̱núu mbá xúgíí xómá rí niꞌgí-mine̱e̱ꞌ ikhaa̱. <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />Ana̱ꞌlóꞌ ndiyoo rí ikháanꞌ gináaꞌxo̱ꞌ ma̱ꞌne jañii a̱kia̱nꞌxo̱ꞌ ju̱ya̱á Krísto̱, kajngó mu̱tha̱nxo̱ꞌ rí máján ga̱jma̱á numuu̱, numuu rí maphú mba̱a̱ ski̱yu̱u̱ꞌ.<verse eid="EPH 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 1:13" />Xúꞌkhue̱n máꞌ mangáanꞌlaꞌ, nákhí rí ni̱dxawíínlaꞌ ajngáa rí gakon, ajngáa máján rí ni̱ꞌkha̱ gáꞌne-jríñáaꞌlaꞌ, ninimba̱ꞌlaꞌ ju̱ya̱á Krísto̱. A̱ꞌkhue̱n ni̱drígúlaꞌ tsinuu Ana̱ꞌlóꞌ tsí ñajuun Xu̱u̱ꞌ, tsí nixuda-mine̱e̱ꞌ máꞌ rí maxniálaꞌ. <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />Wapha máꞌ ni̱dríguíilóꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ, numuu rí rúꞌkhue̱n nasngájma rí phú gakon rí mu̱drígúlóꞌ mbá xúgíí rí naxuda-mine̱e̱ꞌ maxnálóꞌ ído̱ gájríñáaꞌlóꞌ mbá jayu, kajngó ma̱kujma rí phú mba̱a̱ ski̱yu̱u̱ꞌ.<verse eid="EPH 1:14" /></para>
  <para style="s">Páblo̱ naꞌthán-jáñuu Ana̱ꞌlóꞌ ga̱jma̱á numúú tsí nanimbu̱únꞌ juyáá Jesús ná Éfe̱so̱</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />Ikhaa numuu rúꞌkhue̱n, ído̱ ni̱dxawuun rí nanimba̱ꞌlaꞌ ju̱ya̱á Táta̱ Jesús, jamí rí nandalaꞌ ju̱ñu̱ú mbá xúgíin tsí ñajúún xa̱bi̱i Ana̱ꞌlóꞌ, <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />tsíni̱ꞌñúu rí na̱rígu̱u gamaku inuu Ana̱ꞌlóꞌ ga̱jma̱á numalaꞌ, jamí na̱rmáꞌáan a̱kui̱nꞌ ja̱ya̱ꞌlaꞌ ído̱ rí na̱tha̱n-jáñuu Ana̱ꞌlóꞌ. <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />Na̱ndo̱ꞌo̱o̱ Anu̱u̱ Tátiálóꞌ Jesukrísto̱, Ana̱ꞌlóꞌ tsí phú mba̱a̱, rí ikhaa̱ gáꞌnii̱ rí ma̱ma̱ñalaꞌ ma̱juwalaꞌ, jamí gasngájma-mine̱e̱ꞌ inalaꞌ kajngó mu̱ne̱-nuwii̱n májánlaꞌ. <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />Na̱tha̱n-jáñuu Ana̱ꞌlóꞌ mangaa rí marmáꞌthoo̱ idalaꞌ, kajngó ma̱fraꞌa̱ꞌlaꞌ jamí mbu̱ya̱álaꞌ dí ñajuun rí ga̱jma̱á mbá jañii a̱kia̱nꞌlaꞌ mu̱waꞌthi̱ínlaꞌ rí ma̱janálaꞌ tsáanꞌ nindxaꞌwálaꞌ, jamí rí mbu̱ya̱álaꞌ wátha̱ mbaꞌa jamí mba̱a̱ gíꞌdoo numuu xúgíí rí naxnúu̱ tsí ñajúún xa̱bii̱. <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />Na̱nda̱ꞌa̱ mangaa rí ma̱goo mbu̱ya̱álaꞌ rí ninújngoo mba̱a̱ jamí phú gakhi̱i̱ ski̱yu̱u̱ꞌ Ana̱ꞌlóꞌ, rí nambáyálóꞌ ga̱jma̱á ikháánꞌlóꞌ tsáanꞌ ninimba̱ꞌlóꞌ juꞌyáa̱. Ikhaa máꞌ tsiakhe̱ ríge̱ꞌ ñajuun rí nijmuu Ana̱ꞌlóꞌ <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />nákhí niꞌnii̱ rí mbayáa mbiꞌyuu Krísto̱ ná majñu̱ú wa̱jen jamí niꞌnii̱ rí Krísto̱ ma̱ge̱ꞌe̱ ná ñawún mújúu̱n ná mikhuíí. <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />I̱tha̱án mba̱a̱ tsiakhe̱ gíꞌdoo Krísto̱ inúú mbá xúgíin gíñá ꞌguéen jamí tsí mba̱a̱ ski̱ñu̱ú, inúú xúgíin thúngaa jamí xa̱bo̱ ñajun. I̱tha̱án mba̱a̱ ski̱yu̱u̱ꞌ Krísto̱ inuu mbá xúgíí rí gíꞌdoo tsiakhe̱ ná numbaa ríge̱ꞌ jamí ná numbaa rí ni̱kú ma̱ꞌkha̱. <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />Ana̱ꞌlóꞌ nixúdaa mbá xúgíí ná ñawúun Krísto̱ kajngó maꞌthán-ñájuu̱n ne̱, jamí niꞌgíi̱ rí ma̱nindxu̱u̱ xa̱bo̱ idxu̱ún tsí nanimbu̱únꞌ juyáa̱, <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />tsí ñajúún xómá xuyuu̱. Ga̱jma̱á majñu̱u̱ Krísto̱ naꞌne-káxi̱in mbá xúgíin tsí nanimbu̱únꞌ juyáa̱, xúꞌkhue̱n máꞌ mbá xúgíí rí ríga̱.<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s">Nijríñáaꞌlóꞌ numuu nijanálóꞌ rí ra̱jáꞌyalóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />Nákhí rí ikháanꞌlaꞌ nijuwalaꞌ ná awúun aꞌkhánlaꞌ, asndo xó rí nijáñalaꞌ máꞌ jaꞌnii, numuu rí nijuwalaꞌ tsíngua̱ꞌ ná inuu Ana̱ꞌlóꞌ. <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />Nákhí wajyúú ne̱ne̱ mangáanꞌlaꞌ rí xkawe̱ꞌ nune̱ xa̱bo̱ tsí júwa̱ꞌ ná numbaa ríge̱ꞌ. Ne̱ne̱laꞌ rí nandoo tsiakhe̱ ꞌguéen tsí naꞌthán-ñájúún i̱ꞌwíin gíñá ꞌguéen ná inuu gíñá ri̱jma̱á. Ikhaa máꞌ tsiakhe̱ ꞌguéen rúꞌkhue̱n naꞌthán-ñájúún xa̱bo̱ tsí najñaguun ná inuu Ana̱ꞌlóꞌ. <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />Mbá xúgiáanꞌ ikháánꞌlóꞌ, xkuaꞌnii nijuwalóꞌ nákhí wajyúú. Ningriga̱ꞌlóꞌ nu̱ꞌne̱ rí na̱ni̱gua̱ꞌlóꞌ, ne̱ꞌne̱lóꞌ aꞌkhán rí nandoo xuyalóꞌ jamí mbá xúgíí rí xkawe̱ꞌ ni̱ju̱ma̱ꞌlóꞌ. Ga̱jma̱á numuu rúꞌkhue̱n, phú jaꞌyoo rí mu̱drígúlóꞌ jamínu̱ꞌ gáꞌne Ana̱ꞌlóꞌ, xómá jaꞌyoo rí mu̱dri̱gú ne̱ tsí i̱ꞌwíin. <verse eid="EPH 2:3" /><verse number="4" style="v" sid="EPH 2:4" />Xómáꞌ Ana̱ꞌlóꞌ, maphú mba̱a̱ niñáwíin a̱kuii̱n jaꞌyalóꞌ, numuu rí phú nandoo̱ jaꞌyalóꞌ. <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />Niꞌnii̱ rí mbu̱ꞌyáa mbiꞌyalóꞌ ga̱jma̱á nindxu̱u̱ Krísto̱, maske máꞌ asndo xó rí juwa nijáñalóꞌ inuu̱ ga̱jma̱á numuu aꞌkhánlóꞌ. ¡Nijríñáaꞌlaꞌ ga̱jma̱á numuu rí Ana̱ꞌlóꞌ nixnálaꞌ rí máján rí ra̱jáꞌyalaꞌ! <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />Nákhí rí Ana̱ꞌlóꞌ neꞌne rí mbayáa mbiꞌyuu Krísto̱ Jesús, niꞌnii̱ rí mbu̱ꞌyáa mbiꞌyalóꞌ mangáanꞌlóꞌ jamí rí ma̱trigáanꞌlóꞌ ga̱jma̱á nindxu̱u̱ ná mikhuíí. <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />Xkuaꞌnii neꞌne Ana̱ꞌlóꞌ kajngó masngájmee̱ ná mbiꞌi rí ni̱kú ma̱ꞌkha̱, rí ra̱ꞌkhá tháán mba̱a̱ rí máján rí ra̱jáꞌyalóꞌ nixnálóꞌ, jamí ra̱ꞌkhá tháán nandoo̱ jaꞌyalóꞌ ga̱jma̱á majñu̱u̱ Krísto̱ Jesús. <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />Ikháanꞌ nijríñáaꞌlaꞌ numuu rí nijanálaꞌ rí máján rí ra̱jáꞌyalaꞌ ga̱jma̱á majñu̱u̱ rí wéje̱ a̱kia̱nꞌlaꞌ ná inuu Jesús. Ra̱ꞌkhá ikháanꞌlaꞌ ni̱ꞌnga̱ꞌlaꞌ ne̱ne̱-jríya̱ꞌ-mijnálaꞌ, rí Ana̱ꞌlóꞌ neꞌne-jríñáaꞌlaꞌ. <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />Tájríñáaꞌlaꞌ ga̱jma̱á numuu rí nu̱ne̱laꞌ rí máján, kajngó nimbáa ma̱xákúxe̱-mina̱ꞌ inuu Ana̱ꞌlóꞌ. <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />Numuu rí Ana̱ꞌlóꞌ neꞌne-ku̱máaꞌlóꞌ ga̱jma̱á majñu̱u̱ Krísto̱ Jesús, kajngó mu̱ꞌne̱lóꞌ rí máján, ikhaa rí wapha máꞌ ni̱ru̱thuun Ana̱ꞌlóꞌ rí mu̱ꞌne̱lóꞌ.<verse eid="EPH 2:10" /></para>
  <para style="s">Nimbáxi̱iꞌlóꞌ ga̱jma̱á numuu rí nijáñuu Krísto̱</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />Ikhaa numuu rúꞌkhue̱n, ga̱rmáꞌáan a̱kia̱nꞌlaꞌ rí nákhí wajyúú, tsáanꞌ ra̱ꞌkháa xa̱bo̱ judío̱ ñajwanlaꞌ, neꞌne mbiꞌyalaꞌ «tsí ra̱júda tsina jndi» nene̱ xa̱bo̱ judío̱. Xómáꞌ ikhii̱n nixna-mbiꞌi-mijnée̱ «tsí juda tsina jndi», tsina rí na̱gu̱ma ga̱jma̱á ñawúún xa̱bo̱ numbaa. <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />Ga̱rmáꞌáan a̱kia̱nꞌlaꞌ rí nákhí wajyúú, tájuwalaꞌ ga̱jma̱á nindxu̱u̱ Krísto̱, ni máꞌ na̱nguá jiꞌyá mbiꞌyalaꞌ ga̱jma̱á nindxu̱ún xa̱bo̱ numbaa Israél, ni máꞌ na̱nguá jaꞌyalaꞌ rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxúu̱n ikhii̱n. Mingíná nijuwalaꞌ ná numbaa ríge̱ꞌ: tájuwalaꞌ ga̱jma̱á nindxu̱u̱ Ana̱ꞌlóꞌ ni máꞌ nda̱a̱ rí ga̱jma̱á mbá jañii a̱kia̱nꞌlaꞌ guáꞌthi̱ínlaꞌ rí ma̱janálaꞌ. <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />Xómáꞌ xúge̱ꞌ juwalaꞌ ga̱jma̱á nindxu̱u̱ Krísto̱ Jesús. Ikháanꞌlaꞌ tsáanꞌ nijuwalaꞌ tsíngua̱ꞌ inuu Ana̱ꞌlóꞌ nákhí wajyúú, ni̱ꞌkha̱ jiꞌdáanꞌlaꞌ mijngi ga̱jma̱á numuu rí nijáñuu Krísto̱.<verse eid="EPH 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 2:14" />Krísto̱ neꞌne rí ma̱mba̱xíiꞌlóꞌ jamí ni̱ru̱wáanꞌlóꞌ kajngó ma̱ꞌni̱i i̱mbo̱ó xuajen ñajwanlóꞌ. Nákhí rí wajyúú tsí xa̱bo̱ judío̱ jamí tsí ra̱ꞌkháa judío̱ ñajúún, tsíyoo gúya-mijnée̱, asndo xó rí mbá xu̱nꞌ neꞌne-wájíi̱n jaꞌnii. Xómáꞌ Krísto̱, nákhí rí nijáñuu̱, nirngáxi̱i̱ xu̱nꞌ sia̱nꞌ rúꞌkhue̱n. <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />Ikhaa̱ niꞌnii̱ rí náxági̱ꞌdoo tsiakhe̱ rí naꞌthán xtángoo, kajngó ma̱ru̱waa̱ nájma̱ xuajen, ma̱ꞌni̱i i̱mbo̱ó xuajen nuxe̱ꞌ ga̱jma̱á nindxu̱u̱ ikhaa̱. Xkuaꞌnii niꞌnii̱ kajngó náxátsa̱ña̱ꞌlóꞌ. <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />Nákhí rí Jesukrísto̱ nijáñuu ná ixe̱ krúsi̱, neꞌne-gámbo̱o̱ sia̱nꞌ, niꞌnii̱ rí nájma̱ inúú xa̱bo̱ ma̱mba̱xíin ga̱jma̱á nindxu̱u̱ Ana̱ꞌlóꞌ, kajngó ma̱ꞌni̱i i̱mba̱wíi xa̱bo̱ ñajúu̱n. <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />Ikhaa̱ ni̱ꞌkhe̱e̱ gáꞌthán-raꞌee̱ ajngáa máján rí naꞌne rí ma̱ju̱wá tsímáá xa̱bo̱, ikháanꞌlaꞌ tsáanꞌ nijuwalaꞌ tsíngua̱ꞌ inuu Ana̱ꞌlóꞌ, jamí ikháanꞌxo̱ꞌ tsáanꞌ nijuwaxo̱ꞌ mijngi inuu̱. <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />Ga̱jma̱á numuu rí neꞌne Krísto̱, mbá xúgiáanꞌlóꞌ ma̱goo mu̱xu̱ꞌmá-mijnálóꞌ inuu Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ mbóó ikhaa máꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ.<verse eid="EPH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />Ikhaa jngó, nákha máꞌ xa̱bo̱ tsí naguwá tsíngua̱ꞌ ni máꞌ tsí tsígu̱ma-nuwiin ñajwanlaꞌ rí xúge̱ꞌ rá, rí xa̱bo̱ xuajñuu jamí xa̱bo̱ guꞌwóo Ana̱ꞌlóꞌ ñajwanlaꞌ. <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />Ikháanꞌ ñajwanlaꞌ xómá mbá guꞌwá rí na̱tu̱xu̱u̱ ná tsu̱du̱ún tsí waxúngui̱inꞌ jamí tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ. Jamí jmína̱a̱ꞌ máꞌ Jesukrísto̱ ñajuun xómá itsí mba̱a̱ rí na̱ge̱ꞌe̱ ná nakhúu guꞌwá. <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />Ga̱jma̱á ski̱yu̱u̱ꞌ ikhaa̱ naxtoꞌwóo mújúun jamí na̱tu̱xu̱u̱ asndo ndáxe̱ mbá xúgíí guꞌwá, kajngó ma̱nindxu̱u̱ ne̱ guꞌwá kiajuun drígo̱o̱ Táta̱. <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />Ga̱jma̱á máꞌ ski̱yu̱u̱ꞌ ikhaa̱ ikháanꞌlaꞌ nawáanꞌlaꞌ gajmiálaꞌ xa̱bo̱ judío̱ mangaa, xómá mbá guꞌwá, kajngó ma̱nindxa̱ꞌlaꞌ xómá mbá guꞌwá ná xtáa Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ.<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s">Ñajun rí waꞌxnángáwíí Páblo̱ ma̱ꞌne</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />Ikhaa numuu rúꞌkhue̱n, ikhúúnꞌ Páblo̱, kru̱ꞌúún géjwa̱nꞌ ga̱jma̱á numuu rí na̱ne̱lo̱ꞌ ñajuun Krísto̱ Jesús ga̱jma̱á numa ikháanꞌlaꞌ, tsáanꞌ ra̱ꞌkháa xa̱bo̱ judío̱ ñajwanlaꞌ. <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />Na̱ju̱mu̱ꞌ rí gída̱ꞌ máꞌ idxa̱ꞌlaꞌ rí phú májáan a̱kui̱in Ana̱ꞌlóꞌ, ikhaa jngó nixnángaweꞌ rí ma̱mbáyálaꞌ rí mu̱ne̱-nuwiinlaꞌ rí phú májáan a̱kuii̱n. <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />Ana̱ꞌlóꞌ neꞌne rí ma̱ne̱-núwíinlo̱ꞌ awan drígo̱o̱ rí i̱ndo̱ó máꞌ ikhaa̱ ni̱gi̱da̱ꞌ idxu̱u̱ nákhí wajyúú. Ikhaa ñajuun rí inu máꞌ wámbo̱ꞌ ni̱tháán mbá lájwíin ná inuu i̱yi̱i̱ꞌ ríge̱ꞌ. <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />Ído̱ gúraxnuulaꞌ ne̱, a̱ꞌkhue̱n mbu̱ya̱álaꞌ rí nafroꞌo̱ꞌ awan drígo̱o̱ Krísto̱ rí i̱ndo̱ó máꞌ ikhaa̱ ni̱gi̱da̱ꞌ idxu̱u̱ nákhí wajyúú. <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />Awan ríge̱ꞌ, rí i̱ndo̱ó máꞌ Ana̱ꞌlóꞌ ni̱gi̱da̱ꞌ idxu̱u̱ nákhí wajyúú, tájanúú xa̱bo̱ tsí nijúwa̱ꞌ wajyúú mbiꞌi rí mune̱-nuwiin ne̱. Xómáꞌ xúge̱ꞌ rá, Ana̱ꞌlóꞌ naꞌne rí ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ mune̱-nuwiin ne̱ xa̱bii̱ tsí jaꞌwuun, ikhiin tsí waxúngui̱inꞌ jamí tsí nu̱rawíjnga̱a ajngóo̱. <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />Ríge̱ꞌ ñajuun awan drígo̱o̱ Ana̱ꞌlóꞌ rí i̱ndo̱ó máꞌ ikhaa̱ ni̱gi̱da̱ꞌ idxu̱u̱: Mbá xúgíin xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún mu̱dri̱guíi̱ mangii̱n rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ Krísto̱ Jesús, rí ma̱nindxúu̱n mbóó xuajen, asndo xó rí mbáwíi xa̱bo̱ gajmíi̱ xuajen Israél ga̱jma̱á majñu̱u̱ ajngáa máján.<verse eid="EPH 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7" />Ga̱jma̱á numuu rí phú májáan a̱kui̱in Ana̱ꞌlóꞌ jaꞌyeꞌ, nijanúꞌ rí ma̱nindxu̱ꞌ yumbáá tsí naꞌthán-ráꞌa ajngáa máján ríge̱ꞌ, ga̱jma̱á numuu ski̱yu̱u̱ꞌ Ana̱ꞌlóꞌ rí ni̱gruígúlo̱ꞌ. <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />Ikhúúnꞌ ñajunꞌ xa̱bo̱ tsí phú i̱tha̱án na̱nguá gíꞌdoo numuu inúú mbá xúgíin xa̱bi̱i Ana̱ꞌlóꞌ, xómáꞌ Ana̱ꞌlóꞌ phú nga̱ju̱ún niꞌnii̱ rí nixnángaweꞌ rí ma̱thu̱ún ajngáa máján xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún. Ná ajngáa máján rúꞌkhue̱n nakujma rí ninújngoo gíꞌdoo numuu Krísto̱. <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />Xúꞌkhue̱n máꞌ mangaa, waꞌxnángawoꞌ ma̱ne̱ rí ma̱ma̱ñúú mbá xúgíin xa̱bo̱ awan drígo̱o̱ Ana̱ꞌlóꞌ rí i̱ndo̱ó máꞌ ikhaa̱ ni̱gi̱da̱ꞌ idxu̱u̱ nákhí wajyúú. Ana̱ꞌlóꞌ neꞌne-ku̱maa mbá xúgíí rí ríga̱, jamí asndo nákhí máꞌ wajyúú mbiꞌi niꞌnii̱ awan rúꞌkhue̱n. <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />Xkuaꞌnii kajngó rí xúge̱ꞌ rá, mbá xúgíin gíñá ꞌguéen jamí xúgíí tsiakhe̱ rí ríga̱ ná mikhuíí, mune̱-nuwii̱n mbá xúgíí inii xó rí na̱ma̱ñuu Ana̱ꞌlóꞌ, ga̱jma̱á majñu̱ú tsí nanimbu̱únꞌ juyáá Jesús. <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />Xómá niꞌgí-mina̱ꞌ Ana̱ꞌlóꞌ rí ma̱ꞌne asndo nákhí wajyúú mbiꞌi ga̱jma̱á majñu̱u̱ Tátiálóꞌ Krísto̱ Jesús, xkuaꞌnii máꞌ neꞌne-mbánuu̱. <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />Ga̱jma̱á numuu rí wéje̱ a̱kia̱nꞌlóꞌ ná inuu Krísto̱, ja̱ma̱ꞌtha rí mu̱xu̱ꞌmá-mijnálóꞌ ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ ná inuu Ana̱ꞌlóꞌ. <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />Ikhaa jngó na̱nda̱ꞌa̱ꞌlaꞌ rí mu̱xúne̱-waba-mijnálaꞌ xí ndu̱ya̱álaꞌ rí na̱mínu̱u̱ꞌ ga̱jma̱á numalaꞌ, numuu rí ikhaa rúꞌkhue̱n ñajuun rí nambáyálaꞌ.<verse eid="EPH 3:13" /></para>
  <para style="s">Rí na̱nda̱ꞌa̱ Páblo̱ ga̱jma̱á numúú tsí nanimbu̱únꞌ juyáá Jesús ná Éfe̱so̱.</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />Ikhaa numuu rúꞌkhue̱n na̱sma̱tígo̱ꞌ inuu Anu̱u̱ Tátiálóꞌ Jesukrísto̱,<note caller="+" style="f"><char style="fr" closed="false">3.14 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «Anu̱u̱ Tátiálóꞌ Jesukrísto̱».</char></note> <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />tsí naxná mbiꞌñúú mbá xúgíin xa̱bo̱ tsí júwa̱ꞌ ná mikhuíí jamí ná numbaa. <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />Na̱ndo̱ꞌo̱o̱ Ana̱ꞌlóꞌ rí ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ jamí ga̱jma̱á majñu̱u̱ ski̱yu̱u̱ꞌ rí phú wáá mi̱ndaꞌkho, gaxnálaꞌ tsiakhe̱ rí ma̱ꞌne jañii a̱kia̱nꞌlaꞌ ju̱yáa̱. <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />Na̱ndo̱ꞌo̱o̱ Ana̱ꞌlóꞌ rí ma̱we̱je̱ a̱kia̱nꞌlaꞌ ná inuu Krísto̱ kajngó ma̱xtáa̱ mbá jayu ná awúun a̱kia̱nꞌlaꞌ. Xkuaꞌnii kajngó ma̱wajún-gúkuálaꞌ mbá jayu ga̱jma̱á numuu rí nandoo Ana̱ꞌlóꞌ jaꞌyalaꞌ. <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />Mangaa máꞌ na̱nda̱ꞌa̱ rí ma̱goo ma̱fraꞌa̱ꞌlaꞌ gajmiálaꞌ mbá xúgíin xa̱bi̱i Ana̱ꞌlóꞌ wátha̱ ma̱jña̱ꞌ, wátha̱ mba̱ꞌ, wátha̱ tsída̱ꞌ jamí wátha̱ me̱jno̱ꞌ rí nandoo Krísto̱ jaꞌyalóꞌ. <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />Na̱nda̱ꞌa̱ rí mu̱ne̱-nuwiinlaꞌ wátha̱ mba̱a̱ rí nandoo̱ jaꞌyalóꞌ, maske máꞌ ninújngoo mba̱a̱ ne̱ inuu mbá xúgíí rí nu̱ꞌne̱-nuwiinlóꞌ, kajngó ma̱nindxa̱ꞌlaꞌ xómá jayu nandoo Ana̱ꞌlóꞌ rí ma̱nindxa̱ꞌlaꞌ.<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />Ana̱ꞌlóꞌ gíꞌdoo̱ tsiakhe̱ rí ma̱ꞌnii̱ i̱tha̱án mba̱a̱ mbá xúgíí xó rí nu̱nda̱ꞌáa̱lóꞌ o rí na̱ju̱ma̱ꞌlóꞌ ma̱ꞌnii̱. Ikhaa̱ naꞌnii̱ rúꞌkhue̱n ga̱jma̱á majñu̱u̱ ski̱yu̱u̱ꞌ rí kua̱ꞌa̱n ná awúun a̱kia̱nꞌlóꞌ. <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />Ikhaa jngó a̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ ga̱jma̱á majñu̱ú tsí nanimbu̱únꞌ juyáá Jesús jamí ga̱jma̱á majñu̱u̱ Krísto̱ Jesús, mbá xúgíí mbiꞌi jamí mbá jámuu jayu. Xkuaꞌnii gáꞌne.<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s">Mbáwíi xa̱bo̱ ñajwanlóꞌ mbá xúgiáanꞌlóꞌ ga̱jma̱á numuu Krísto̱</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />Ikhaa numuu rúꞌkhue̱n, ikhúúnꞌ tsúún kru̱ꞌúúnlo̱ꞌ géjwa̱nꞌ ga̱jma̱á numuu Táta̱, na̱tha̱n-jáñalaꞌ rí ga̱juwalaꞌ xómá gíꞌmaa rí ma̱juwalaꞌ tsáanꞌ nindxaꞌwálaꞌ Ana̱ꞌlóꞌ. <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />Gu̱xrígú-mijnálaꞌ jamí gamakuáanꞌlaꞌ gáꞌne. Ga̱ꞌngo̱o̱ a̱kia̱nꞌlaꞌ ju̱ya̱-mijnálaꞌ numuu rí nandalaꞌ ju̱ya̱-mijnálaꞌ. <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />Gu̱xna̱-míjnálaꞌ tsiakhe̱ rí ma̱juwalaꞌ mbá ꞌnduꞌ, xómá tsímáá rí ni̱ru̱wáanꞌlaꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ. <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />Asndo xó rí mbáwíi xa̱bo̱ ñajwanlóꞌ mbá xúgiáanꞌlóꞌ, jamí mbáwíi máꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ tsí xtáa ná awúun a̱kia̱nꞌlóꞌ, xómá rí mbóó rí watsaꞌwálóꞌ rí ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ mu̱waꞌthi̱ínlóꞌ ma̱mba̱núu mangaa. <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />Mbáwíi máꞌ tsí ñajuun Táta̱, mbóó máꞌ xó rí nanimba̱ꞌlóꞌ juꞌyáá Ana̱ꞌlóꞌ, jamí mbóó máꞌ numuu rí waxúꞌdu-maꞌáanꞌlóꞌ ná awúun iya. <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />Mbáwíi máꞌ tsí ñajuun Ana̱ꞌlóꞌ, tsí ñajuun Tátiálóꞌ mbá xúgiáanꞌlóꞌ, tsí naꞌthán-ñájwanlóꞌ mbá xúgiáanꞌlóꞌ. Ikhaa̱ nañajwii̱n ná majña̱ꞌlóꞌ mbá xúgiáanꞌlóꞌ, jamí xtáa̱ ná awúun a̱kia̱nꞌlóꞌ mbá xúgiáanꞌlóꞌ.<verse eid="EPH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7" />I̱ndo̱ó máꞌ numuu rí mbámbáa tsí ikháánꞌlóꞌ nijanáá rí ma̱ma̱ñuu mañajun, xómá neꞌne a̱kui̱in Krísto̱. <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />Ikhaa jngó naꞌthán ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ:</para>
  <para style="b" vid="EPH 4:8" />
  <para style="q" vid="EPH 4:8">«Ído̱ nitsimuu̱ tsída̱ꞌ, jaguu̱n mbaꞌiin tsí traꞌi̱in géjwa̱nꞌ ni̱ke̱e̱,</para>
  <para style="q" vid="EPH 4:8">jamí nixnúu̱ ñajun xa̱bo̱ kajngó mune̱-mba̱a̱ Ana̱ꞌlóꞌ».<note caller="+" style="f"><char style="fr" closed="false">4.8 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ ajmúú 68.18.</char></note><verse eid="EPH 4:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="EPH 4:9" />Dí ñajuun iꞌthán rí «nitsimuu̱» róꞌ. Naꞌthán ne̱ rí ginii ni̱ga̱taa̱ asndo ná i̱tha̱án me̱jno̱ꞌ ná awúun ju̱ba̱ꞌ. <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />Tsí ni̱ga̱taa, ikhaa máꞌ tsúꞌkhue̱n ñajuun tsí nitsimuu i̱tha̱án tsída̱ꞌ inuu mbá xúgíí mikhu, kajngó ikhaa̱ maꞌthán-ñájuu̱n mbá xúgíí. <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />Ikhaa̱ nixnée̱ ñajun rí mbá tikhuun ma̱nindxu̱ún tsí waxúngui̱inꞌ, i̱ꞌwíin ma̱nindxu̱ún tsí nu̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ, i̱ꞌwíin ma̱nindxu̱ún tsí nuthan-raꞌa ajngáa máján, i̱ꞌwíin ma̱nindxu̱ún tsí nu̱ña̱wu̱ún xa̱bi̱i Ana̱ꞌlóꞌ jamí tsí nusngáá. <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />Xkuaꞌnii niꞌnii̱ kajngó musngúu̱n xa̱bi̱i Ana̱ꞌlóꞌ. A̱ꞌkhue̱n rí xa̱bi̱i Ana̱ꞌlóꞌ ma̱ma̱ñúu̱ muni̱i̱ ñajun rí nijanúu̱ muni̱i̱, kajngó ma̱gaji̱in tsí mbá xa̱bi̱i̱ ñajúún ga̱jma̱á nindxu̱u̱ Krísto̱. <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />Xkuaꞌnii asndo ma̱ga̱nú mbiꞌi rí mbá xúgiáanꞌlóꞌ mbóó máꞌ xó rí nanimba̱ꞌlóꞌ juꞌyáá Ana̱ꞌlóꞌ gáꞌne jamí mbéꞌtháán gúꞌne̱-nuwiinlóꞌ A̱dée̱ mangaa. A̱ꞌkhue̱n rí ma̱nindxa̱ꞌlóꞌ mbáa xa̱bo̱ káxi̱i̱, tsí jaꞌnii xómá jaꞌnii jayu Krísto̱.<verse eid="EPH 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 4:14" />Xkuaꞌnii kajngó náxánindxa̱ꞌlóꞌ xómá jaꞌñúú e̱je̱n, tsí nángí eꞌne i̱riꞌkhuíí rí nanimbu̱únꞌ jamí ge̱e̱ ñúꞌún i̱ka̱-jiꞌdiin eꞌne xúgíí inii gisngáá rí nu̱dxawíín, jamí asndo nitsíyáá xáne i̱gu̱ma-nduwiin ene̱ xa̱bo̱ tsí phú wiphiin rí mune̱-nduwa. <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />A̱ꞌkhue̱n gakon, ga̱jma̱á numuu rí nandalóꞌ juꞌñúú xa̱bo̱, gu̱ꞌthánlóꞌ rí gakon, kajngó ma̱gajáanꞌlóꞌ inuu mbá xúgíí jamí ma̱nindxa̱ꞌlóꞌ xómá jaꞌnii jayu Krísto̱, tsí ñajuun xa̱bo̱ idxa̱ꞌlóꞌ. <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />Krísto̱ naꞌne rí mbá xúgiáanꞌlóꞌ ma̱gajáanꞌlóꞌ ga̱jma̱á majñu̱u̱ rí nu̱ru̱wa-mijnáa májánlóꞌ, jamí mbá ꞌnduꞌ nu̱mbáyú-mijnálóꞌ. Ñajun rí naꞌne mbámbáa naꞌne rí ma̱gajáanꞌlóꞌ mbá xúgiáanꞌlóꞌ numuu rí nandalóꞌ juꞌya-mijnálóꞌ.<verse eid="EPH 4:16" /></para>
  <para style="s">Xáne gíꞌmaa rí ma̱juwalaꞌ xúge̱ꞌ</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />Ikhaa jngó na̱tha̱nꞌlaꞌ jamí na̱nda̱ꞌa̱ꞌlaꞌ ríge̱ꞌ ga̱jma̱á numuu Táta̱ tsí naꞌthán-ñájwanlóꞌ: rí náxájuwalaꞌ ga̱jma̱á ju̱ma̱ rí tsíjmaa, xómá júwa̱ꞌ xa̱bo̱ tsí tsíne̱-nuwiin Ana̱ꞌlóꞌ. <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />Ikhii̱n júgoo inúu̱ jamí ma̱xájúwe̱e̱ꞌ jámuu gáꞌne Ana̱ꞌlóꞌ, ga̱jma̱á numuu rí nda̱a̱ rí i̱ma̱ñúu̱ jamí nini̱i̱ gúkú a̱kuíi̱n. <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />Ikhaa jngó nánguá xí i̱ti̱ñúu̱ wáa rí nuni̱i̱ rí xkawe̱ꞌ, ni̱xna̱xí-mijnée̱ mbá jayu rí muni̱i̱ rí na̱nda̱ꞌa̱ xuñúu̱, jamí tsíꞌne níꞌngúu̱n rí nuni̱i̱ xúgíí inii rí xkawe̱ꞌ.<verse eid="EPH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20" />Xómáꞌ ikháanꞌlaꞌ rá, ra̱ꞌkhá xkuaꞌnii ni̱ma̱ñalaꞌ rí nixtáa Krísto̱. <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />Ikhúúnꞌ nda̱yo̱o̱ mújúnꞌ rí ikháanꞌlaꞌ ni̱dxawíínlaꞌ ajngóo Jesús, jamí ni̱ma̱ñalaꞌ rí ma̱juwalaꞌ ga̱jma̱á rí gakon rí waꞌsngálaꞌ ga̱jma̱á numuu̱ ikhaa̱. <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />Waꞌsngálaꞌ rí mu̱ni̱ꞌñáálaꞌ janíí rí ne̱ne̱laꞌ wajyúú, nákhí rí ninindxa̱ꞌlaꞌ xa̱bo̱ aꞌkhán tsí niꞌkhíi mbá jayu ga̱jma̱á numuu rí na̱gu̱ma-nduwaa eꞌne rí na̱wa̱ꞌa̱ a̱kui̱in ma̱ꞌne. <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />Waꞌsngálaꞌ rí mu̱ne̱-nuxi̱iꞌlaꞌ mbá jayu rí nu̱ndxa̱ꞌwa̱-mijnálaꞌ, <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />jamí rí mu̱gíꞌdi̱ín ma̱juwalaꞌ xómá jaꞌyoo xa̱bo̱ tsí nuxi̱i̱ꞌ, tsí ni̱gu̱ma-ku̱maa neꞌne Ana̱ꞌlóꞌ rí ma̱nindxu̱u̱ xómá ikhaa̱, kajngó ma̱ꞌnii̱ rí máján jamí ma̱ꞌne-jaꞌwii̱ ga̱jma̱á majñu̱u̱ rí gakon.<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />Ikhaa numuu rúꞌkhue̱n, náxúne̱-nduwalaꞌ, rí mbámbáa gáꞌthúun dxájuu i̱ndo̱ó máꞌ rí gakon, numuu rí mbá xúgiáanꞌlóꞌ ñajwanlóꞌ mbáwíi ikhaa máꞌ xa̱bo̱. <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />Xí najiꞌnáaꞌlaꞌ, ma̱xáꞌne rí asndo mu̱ne̱laꞌ aꞌkhán. Ma̱xájiꞌnáaꞌlaꞌ asndo rí nijngúun máꞌ a̱kha̱ꞌ, <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />kajngó mu̱xúxna̱álaꞌ gixa̱a̱ rí ma̱ꞌngo̱o̱ inalaꞌ. <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />Tsí ninindxu̱u̱ ku̱ꞌwá, náxáꞌne-kúwe̱e̱ꞌ rá, rí gañajwii̱n ga̱jma̱á ñawúu̱n kajngó ma̱gi̱ꞌdoo̱ rí maxnúu̱ tsí ndaꞌñúú.<verse eid="EPH 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EPH 4:29" />Nimbá ajngáa xkawe̱ꞌ ma̱xágájnuu ná rawanlaꞌ, rí i̱ndo̱ó máꞌ ajngáa rí máján gútha̱nlaꞌ, rí nambáyúu rí ma̱gaji̱in tsí nu̱dxawanlaꞌ. <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />Mu̱xúne̱laꞌ rí ma̱xtáa-jínúu Xu̱u̱ꞌ Ana̱ꞌlóꞌ, numuu rí ikhaa̱ ñajuu̱n tsina tsí masngájma rí xa̱bi̱i Ana̱ꞌlóꞌ ñajwanlaꞌ ído̱ gága̱nú mbiꞌi rí ma̱jríñáaꞌlaꞌ mbá jayu. <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />Gu̱ni̱ꞌñáálaꞌ mbá xúgíí inii sia̱nꞌ, náxájiꞌnáaꞌlaꞌ, náxámangua̱ꞌlaꞌ, náxúndxa̱ꞌwa̱laꞌ, náxútha̱n-xkawiu̱únlaꞌ xa̱bo̱, jamí náxúne̱laꞌ nimbá rí ra̱máján. <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />A̱ꞌkhue̱n gakon, ga̱nindxa̱ꞌlaꞌ xa̱bo̱ tsí májáan a̱kui̱ín jamí nañáwíin a̱kui̱ín juya-mijná. Gu̱ne̱ mba̱a̱ a̱kia̱nꞌlaꞌ ju̱ya̱-mijnálaꞌ, xómá rí neꞌne mba̱a̱ a̱kui̱in Ana̱ꞌlóꞌ jaꞌyalaꞌ ga̱jma̱á majñu̱u̱ Krísto̱.<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />Ikhaa numuu rúꞌkhue̱n, gu̱ya̱ri̱dáálaꞌ rí naꞌne Ana̱ꞌlóꞌ, numuu rí ikháanꞌ ñajwanlaꞌ i̱jii̱n tsí phú nandoo̱ jaꞌñúu̱. <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />Ga̱galaꞌ ju̱ñu̱ú mbá xúgíin xa̱bo̱, xómá rí Krísto̱ ndiyoo jaꞌyalóꞌ mangaa. Ikhaa̱ nixnáxe̱-mine̱e̱ꞌ rí ma̱ja̱ñúu̱ ga̱jma̱á numalóꞌ, xómá mbá tsi̱gi̱jña̱ꞌ rí ndaa thawuun xu̱u̱ꞌ i̱ga̱nú ná inuu Ana̱ꞌlóꞌ.<verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />Xómáꞌ ikháanꞌlaꞌ, ga̱juwalaꞌ xómá jaꞌyoo rí ma̱ju̱wá xa̱bi̱i Ana̱ꞌlóꞌ. Mu̱xúba̱ꞌ gajmiálaꞌ xa̱bo̱ tsí túya̱a̱laꞌ, ni máꞌ mu̱xúne̱laꞌ nimbá rí xkawe̱ꞌ, ni máꞌ ma̱xáni̱gua̱ꞌlaꞌ rí mu̱guaꞌdáálaꞌ mi̱ndaꞌkho. <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />Mu̱xútha̱nlaꞌ ajngáa xkawe̱ꞌ, ni máꞌ ajngáa rí nuthan tsí júgoo inúú, ni máꞌ ajngáa xiaꞌwun rí tsíjmaa, numuu rí nda̱a̱ rí gámbáyálaꞌ rúꞌkhue̱n. I̱wa̱á máján rí gu̱rígu̱ulaꞌ gamaku inuu Ana̱ꞌlóꞌ. <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />Numuu rí ndu̱ya̱álaꞌ máꞌ rí asndo nimbáa tsí nabóo ga̱jma̱á xa̱bo̱ tsí táyáa, nda̱a̱ rí gájanáa̱ ná náꞌthán-ñájun Krísto̱ jamí Ana̱ꞌlóꞌ, ni máꞌ tsí naꞌne rí xkawe̱ꞌ, ni máꞌ tsí na̱ni̱gu̱u̱ꞌ ma̱gi̱ꞌdoo mi̱ndaꞌkho, numuu rí asndo xó ikhaa máꞌ rúꞌkhue̱n naꞌne-mba̱a̱ jaꞌnii. <verse eid="EPH 5:5" /><verse number="6" style="v" sid="EPH 5:6" />Nimbáa ma̱xáꞌne-nduwáanꞌlaꞌ ga̱jma̱á ajngáa rí mitsaan iwán jamí nda̱a̱ mbá jayu numuu, numuu rí ga̱jma̱á numuu rúꞌkhue̱n Ana̱ꞌlóꞌ naꞌne rí ma̱ꞌkha̱ jamínu̱ꞌ inúú xa̱bo̱ tsí najñaguun juyáa̱. <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />Ikhaa jngó, ma̱xámbáxa̱ꞌ gajmiálaꞌ rí mu̱ne̱laꞌ rí nuni̱i̱.<verse eid="EPH 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EPH 5:8" />Ikháanꞌlaꞌ nijuwalaꞌ ná mijína nákhí wajyúú. Rí xúge̱ꞌ rá, juwalaꞌ ná mbiꞌi, numuu rí nimbiꞌyalaꞌ aguu Táta̱. Ikhaa jngó, ga̱juwalaꞌ xómá gíꞌmaa rí ma̱ju̱wá tsí nambiꞌñúú eꞌne Ana̱ꞌlóꞌ. <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />Numuu rí Xu̱u̱ꞌ Ana̱ꞌlóꞌ<note caller="+" style="f"><char style="fr" closed="false">5.9 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí tsíꞌthán «Xu̱u̱ꞌ Ana̱ꞌlóꞌ», rí «agu rí nambiꞌyalóꞌ» iꞌthán ne̱.</char></note> naꞌne rí ma̱nindxa̱ꞌlóꞌ xa̱bo̱ tsí májáan a̱kui̱ín, rí mu̱ꞌne̱lóꞌ rí máján jamí rí ma̱ꞌne kuwáanꞌlóꞌ. <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />Gu̱ya̱á májánlaꞌ náá rí na̱ni̱gu̱u̱ꞌ Táta̱ rí mu̱ne̱laꞌ. <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />Mu̱xúne̱laꞌ rí nune̱ xa̱bo̱ tsí júwa̱ꞌ ná mijína, numuu rí na̱nguá gíꞌdoo numuu rí nuni̱i̱. I̱wa̱á máján gu̱tha̱nlaꞌ rí ra̱máján nuni̱i̱. <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />Numuu rí asndo mate̱ꞌ máꞌ rí mu̱ꞌthánlóꞌ rí nune̱ xa̱bo̱ tsúꞌkhue̱n ná ngu̱ꞌwa̱. <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />I̱ndo̱ó máꞌ numuu rí ído̱ nagájnuu mbá xúgíí ná pa̱jnu, nakujma ne̱, numuu rí agu naꞌne rí ma̱kujma xáne phú jaꞌnii xúgíí. <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />Ikhaa numuu rúꞌkhue̱n nuthan xa̱bo̱:</para>
  <para style="b" vid="EPH 5:14" />
  <para style="q" vid="EPH 5:14">«Ga̱jwi̱iꞌlaꞌ rá, ikháánꞌ tsáánꞌ nanu.</para>
  <para style="q" vid="EPH 5:14">Araxu̱unꞌ ná majñu̱ú wa̱jen,</para>
  <para style="q" vid="EPH 5:14">jamí ma̱mbiꞌyaaꞌ gáꞌne Krísto̱».<verse eid="EPH 5:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />Ikhaa numuu rúꞌkhue̱n, gu̱ya̱xi̱ílaꞌ xáne juwalaꞌ. Ma̱xájuwalaꞌ xómá júwa̱ꞌ xa̱bo̱ tsí júgoo inúú, rí ga̱juwalaꞌ xómá xa̱bo̱ tsí na̱ma̱ñúú najúwa̱ꞌ. <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />Mu̱xúne̱-mbáti̱ga̱laꞌ mbiꞌi ríge̱ꞌ, numuu rí gatíí rí xkawe̱ꞌ ná awúun mbiꞌi rí juwalóꞌ. <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />Ikhaa jngó, ma̱xánindxa̱ꞌlaꞌ xa̱bo̱ tsí júgoo inúú, rí ga̱fraꞌa̱ꞌlaꞌ náá rí nandoo Táta̱ rí mu̱ne̱laꞌ. <verse eid="EPH 5:17" /><verse number="18" style="v" sid="EPH 5:18" />Ma̱xájngáanꞌlaꞌ, numuu rí xí najngáanꞌlaꞌ rúꞌkhue̱n ma̱ꞌne rí nikhuáa mbá jayu gájuwalaꞌ. I̱wa̱á máján gu̱ni̱ꞌñá-mijnálaꞌ rí maꞌthán-ñájwanlaꞌ mbá jayu Xu̱u̱ꞌ Ana̱ꞌlóꞌ. <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />Gu̱tha̱n-míjnálaꞌ ga̱jma̱á ajmúú rí na̱ꞌkha̱ ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ, xúꞌkhue̱n máꞌ ga̱jma̱á ajmúú rí naꞌne-mba̱a̱ Ana̱ꞌlóꞌ jamí ajmúú rí mambáyúu nímia̱ꞌlaꞌ. Gu̱sianlaꞌ ajmúú, jamí gu̱ne̱-mba̱a̱laꞌ Táta̱ ga̱jma̱á mbá jañii a̱kia̱nꞌlaꞌ. <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />Jámba̱ miꞌtsú gu̱rígu̱ulaꞌ gamaku ná inuu Ana̱ꞌlóꞌ Mikhuíí ga̱jma̱á numuu mbá xúgíí, ga̱jma̱á majñu̱u̱ Tátiálóꞌ Jesukrísto̱.<verse eid="EPH 5:20" /></para>
  <para style="s">Xáne gíꞌmaa ma̱ju̱wá xa̱bo̱ tsí nida-mijná</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21" />Gu̱ni̱ꞌñá-mijnálaꞌ rí mu̱tha̱n-ñájun-mijnálaꞌ, ga̱jma̱á numuu rí ndu̱ya̱-makuíílaꞌ Krísto̱. <verse eid="EPH 5:21" /><verse number="22" style="v" sid="EPH 5:22" />Go̱ꞌo̱ tsí ni̱nújún, gíꞌmaa rí mune̱-mbáníi̱ rí nuthan a̱jmbíi̱n, xómá nu̱ne̱-mbáníi̱ rí naꞌthán Táta̱. <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />Numuu rí xa̱biya̱ tsí ninigúún, ikhaa̱ ñajuu̱n xómá idxu̱u̱ a̱ꞌguii̱, xómá rí Krísto̱ ñajuun xómá idxu̱ún tsí nanimbu̱únꞌ juyáa̱, tsí ñajúún xómá xuyuu̱, jamí ikhaa̱ máꞌ naꞌne-jáwíi̱n. <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />Ikhaa jngó, xómá rí xa̱bo̱ tsí nanimbu̱únꞌ juyáá Krísto̱ nu̱ni̱ꞌñá-mijnée̱ rí mi̱ꞌthán-ñájúu̱n gáꞌnii̱ ikhaa̱, xkuaꞌnii máꞌ go̱ꞌo̱ tsí ni̱nújún mangaa gíꞌmaa rí mu̱ni̱ꞌñá-mijnée̱ rí mi̱ꞌthán-ñájúu̱n gáꞌne a̱jmbíi̱n mangaa.<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25" />Xa̱bekha, tsáanꞌ ni̱ni̱ꞌgúúnlaꞌ, ga̱galaꞌ ju̱ñu̱ú gu̱ꞌwia̱ꞌlaꞌ, xómá rí Krísto̱ ndiyoo jaꞌñúú tsí nanimbu̱únꞌ juyáa̱ jamí nixnáxe̱-mine̱e̱ꞌ rí ma̱ja̱ñúu̱ ga̱jma̱á numúu̱, <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />kajngó ma̱nindxúu̱n i̱ndo̱ó máꞌ xa̱bii̱ ikhaa̱. Ikhaa̱ neꞌne-jaꞌwii̱n ga̱jma̱á ajngóo̱, rí xómá iya jaꞌnii, <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />kajngó ma̱ꞌne tsiꞌñíi mi̱ndaꞌkho tsí nanimbu̱únꞌ juyáa̱ rí maxnáxii̱n ná inuu̱ máꞌ ikhaa̱. Ma̱ꞌne nda̱a̱ nitháan rí ra̱máján rí mi̱ꞌthán ga̱jma̱á numúu̱ ni máꞌ nda̱a̱ aꞌkhúu̱n ni máꞌ nda̱a̱ rí tsíjmaa ná a̱kuíi̱n, rí jaꞌwuu̱n jamí tsiꞌñíi̱ mi̱ndaꞌkho gáꞌne. <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />Xkuaꞌnii máꞌ xa̱bekha tsí ni̱ni̱ꞌgúún mangaa, gíꞌmaa rí ma̱gúu̱n juñúu̱ gu̱ꞌwíi̱n, xómá rí nandúu̱n juya-mijnée̱ ikhii̱n. Tsí nandoo jaꞌyoo a̱ꞌgui̱i, ikhaa̱ máꞌ nandoo̱ jaꞌya-mine̱e̱ꞌ. <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />Numuu rí asndo nimbáa xa̱bo̱ tsíꞌne-mina̱ꞌ mi̱ndaꞌkho rí ikhaa̱. A̱ꞌkhue̱n gakon, naxná-mine̱e̱ꞌ rí ndaꞌyóo̱ jamí na̱ña̱wa̱n-míne̱e̱ꞌ, xómá rí naꞌne Krísto̱ mangaa ga̱jma̱á numúú tsí nanimbu̱únꞌ juyáa̱, <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />numuu rí mbá xúgiáanꞌ ikháánꞌlóꞌ ñajwanlóꞌ mbá xa̱bi̱i̱ xuyuu Krísto̱. <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" />«Ikhaa numuu rúꞌkhue̱n xa̱biya̱ maniñuu tátée jamí nánée, rí ma̱mba̱xúu̱ ga̱jmáa̱ a̱ꞌguii̱, jamí nájmii̱ ma̱nindxúu̱n i̱mba̱wíi xa̱bo̱». <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />Maphú mba̱a̱ awan drígo̱o̱ Ana̱ꞌlóꞌ ríge̱ꞌ, rí i̱ndo̱ó máꞌ ikhaa̱ ni̱gi̱da̱ꞌ idxu̱u̱ nákhí wajyúú. Xómáꞌ ikhúúnꞌ na̱tha̱n ga̱jma̱á numuu Krísto̱ jamí ga̱jma̱á numúú tsí nanimbu̱únꞌ juyáa̱. <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />Ikhaa jngó, mbámbáa tsí ikháanꞌlaꞌ ga̱goo jaꞌyoo a̱ꞌgui̱i mangaa, xómá rí nandoo jaꞌya-mina̱ꞌ mbámbáa tsí ikháanꞌlaꞌ. Xúꞌkhue̱n máꞌ a̱ꞌgo̱ tsí ninújún mangaa, gaya-makuu̱ a̱jmbaa̱.<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s">Rí jaꞌyoo mune̱ e̱je̱n jamí anúu̱</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />E̱je̱n, gu̱ne̱-mbáníílaꞌ rí naꞌthán tátiálaꞌ ga̱jma̱á nániálaꞌ xómá rí nandoo Táta̱, numuu rí rúꞌkhue̱n gíꞌmaa rí mu̱ne̱laꞌ. <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />Numuu ríge̱ꞌ ñajuun timbá xtángoo rí na̱ꞌkha̱ ga̱jma̱á mbá rí nixuda-mina̱ꞌ Ana̱ꞌlóꞌ: «Atiamakuíí ana̱a̱ꞌ jamí ru̱dáaꞌ, <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />kajngó ma̱ra̱xtaa májáanꞌ jamí ma̱ra̱xtaa mba̱yo̱ꞌ ná numbaa».<note caller="+" style="f"><char style="fr" closed="false">6.3 </char><char style="ft" closed="false">Ajngáa ríge̱ꞌ na̱ꞌkha̱ ná I̱yu̱u̱ꞌ xó nigájna̱á xa̱bo̱ 20.12, jamí ná I̱yi̱i̱ꞌ rí naꞌthán ikhaa máꞌ xtángoo 5.16.</char></note><verse eid="EPH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4" />Jamí ikháanꞌlaꞌ tsáanꞌ ñajwanlaꞌ anu̱ú e̱je̱n, mu̱xúne̱laꞌ rí ma̱jiꞌníi i̱jña̱ꞌlaꞌ, rí gu̱xprígúu̱nlaꞌ jamí gu̱sngúu̱nlaꞌ xómá rí nandoo Táta̱.<verse eid="EPH 6:4" /></para>
  <para style="s">Rí jaꞌyoo mune̱ yumbáá tsí waꞌtsi̱in jamí tsí ñajúún ña̱ꞌñíi̱</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />Ikháanꞌlaꞌ, yumbáá tsí waꞌtsi̱in, gu̱ne̱-mbáníílaꞌ ga̱jma̱á gamaku jamí ngamí rí nuthan ña̱ꞌñalaꞌ tsí xa̱bo̱ numbaa ñajúún. Mbá jañii a̱kia̱nꞌlaꞌ gúne̱ rí nuthee̱n, asndo xó rí Krísto̱ máꞌ e̱ne̱-mba̱a̱laꞌ. <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />Xkuaꞌnii gúne̱laꞌ tsitsíí, ra̱ꞌkhá i̱ndo̱ó máꞌ ído̱ rí júwe̱e̱ꞌ mu̱ya̱xa̱ꞌlaꞌ. Ga̱ju̱ma̱ꞌlaꞌ rí Krísto̱ ñajuun ña̱ꞌñalaꞌ, kajngó mbá jañii a̱kia̱nꞌlaꞌ gúne̱ rí nandoo Ana̱ꞌlóꞌ. <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />Gagi a̱kia̱nꞌlaꞌ gúne̱laꞌ ñajun rí nixná-ñájwanlaꞌ mu̱ne̱laꞌ, asndo xó rí Táta̱ máꞌ e̱ne̱-mba̱a̱laꞌ, ra̱ꞌkhá xa̱bo̱ numbaa. <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />Numuu rí ndu̱ya̱álaꞌ máꞌ rí Táta̱ ma̱ꞌne rí ma̱grui̱gúu gamaku mbámbáa ga̱jma̱á numuu rí máján neꞌne, tsíꞌyoo máꞌ xí yumbáá tsí waꞌtsi̱i̱ o xa̱bo̱ tsí naꞌthán-ñájun-mina̱ꞌ máꞌ ikhaa ñajuu̱n.<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />Jamí ikháanꞌlaꞌ, ña̱ꞌñu, xúꞌkhue̱n máꞌ gu̱ya̱-makúún mangáanꞌlaꞌ tsí nu̱ñajun inalaꞌ, jamí mu̱xúne̱-mi̱ꞌñúu̱laꞌ. Ga̱rmáꞌáan a̱kia̱nꞌlaꞌ rí Táta̱ tsí naꞌthán-ñájúu̱n ikhii̱n jamí tsí naꞌthán-ñájwanlaꞌ ikháanꞌlaꞌ ná mikhuíí xtáa̱, jamí ikhaa̱ tsíraꞌwíi̱n xa̱bo̱ tsí ma̱ꞌne-nga̱júu̱n.<verse eid="EPH 6:9" /></para>
  <para style="s">Tsiakhe̱ rí naxná Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />Rí nda̱wa̱á jayu rá, a̱ngui̱nꞌ, ga̱wajún-gúkuálaꞌ ga̱jma̱á ski̱yu̱u̱ꞌ Táta̱ rí tsíyámba̱. <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />Ga̱jmalaꞌ mbá xúgíí ski̱yu̱u̱ꞌ Ana̱ꞌlóꞌ, rí xómá xtíin ajwa̱nꞌ jaꞌnii, kajngó ma̱wajún-gúkuálaꞌ inuu rí mi̱nduwa drígo̱o̱ gixa̱a̱. <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />Numuu rí ra̱ꞌkhá xa̱bo̱ numbaa guáꞌdáá gajmiálóꞌ xkujndu, rí guáꞌdáálóꞌ xkujndu ga̱jma̱á nindxu̱u̱ gíñá xkawe̱ꞌ, ga̱jma̱á nindxu̱ún tsiakhe̱ ꞌguéen, gajmíí tsí nuthan-ñajun ná mijína, jamí gajmíí gíñá xkawi̱inꞌ tsí ngrigu̱ún ri̱jma̱á ná inuu ju̱ba̱ꞌ. <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />Ikhaa jngó, ga̱jmalaꞌ mbá xúgíí ski̱yu̱u̱ꞌ Ana̱ꞌlóꞌ, rí xómá xtíin ajwa̱nꞌ jaꞌnii, kajngó ma̱ꞌnga̱ꞌlaꞌ mu̱ne̱-gajmiálaꞌ tsí ra̱májáan ído̱ ága̱nú mbiꞌi xkawe̱ꞌ rúꞌkhue̱n. Jamí ído̱ wámba̱ꞌlaꞌ ne̱ne̱-gajmiálaꞌ, xóó máꞌ kuajún-gúkuálaꞌ gáꞌne.<verse eid="EPH 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 6:14" />Ga̱wajún-gúkuálaꞌ ga̱jma̱á rí gakon, rí ñajuun xómá xtá smídálaꞌ, jamí rí máján rí nu̱ne̱laꞌ, ga̱ꞌne xómá ajwa̱nꞌ rí kathamuu ná xo̱xta̱ꞌlaꞌ jamí ná tsu̱da̱ꞌlaꞌ. <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />Jámba̱ miꞌtsú ga̱juwa-na̱ma̱ñalaꞌ xómá mbá xa̱bo̱ tsí traꞌa̱ máꞌ cháda nakhúu, rí ma̱ga̱jnálaꞌ mu̱tha̱n-ráꞌalaꞌ ajngáa máján rí naꞌne rí ma̱ju̱wá tsímáá xa̱bo̱. <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />Ga̱we̱je̱ máꞌ xúꞌkhue̱n a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ, numuu rí rúꞌkhue̱n ñajuun xómá ajwa̱nꞌ paska rí mu̱sndui̱ꞌyíílaꞌ ga̱jma̱á aguu xkuíyo̱o̱ xkamídá rí nada tsí ra̱májáan. <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />Ga̱rmáꞌáan a̱kia̱nꞌlaꞌ rí Ana̱ꞌlóꞌ neꞌne-jríñáaꞌlaꞌ, numuu rí rúꞌkhue̱n ñajuun xómá xtéde̱ ajwa̱nꞌ. Ga̱jmalaꞌ ajngáa rawuun Ana̱ꞌlóꞌ mangaa, rí ñajuun xómá chídi̱i Xu̱u̱ꞌ Ana̱ꞌlóꞌ. <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />Mu̱xúni̱ꞌñáálaꞌ rí mu̱tha̱n-jáñíílaꞌ Ana̱ꞌlóꞌ. Gu̱nda̱ꞌa̱laꞌ jamí gu̱tha̱n-kháanlaꞌ ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ Ana̱ꞌlóꞌ. Ga̱juwalaꞌ xawi máꞌ xúꞌkhue̱n jamí ma̱xáꞌne níꞌnga̱ꞌlaꞌ rí mu̱tha̱n-jáñíílaꞌ Ana̱ꞌlóꞌ, jamí gu̱nda̱ꞌa̱laꞌ ga̱jma̱á numúú mbá xúgíin xa̱bi̱i Ana̱ꞌlóꞌ. <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />Gu̱tha̱n-jáñíílaꞌ Ana̱ꞌlóꞌ ga̱jma̱á numuꞌ mangúúnꞌ, kajngó ma̱janúꞌ ajngáa rí ma̱tha̱n jamí ma̱xámíñuꞌ ma̱thu̱ún xa̱bo̱ awan drígo̱o̱ Ana̱ꞌlóꞌ rí i̱ndo̱ó máꞌ ikhaa̱ ni̱gi̱da̱ꞌ idxu̱u̱ nákhí wajyúú ga̱jma̱á numuu ajngáa máján. <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />Ikhaa numuu rúꞌkhue̱n ñajunꞌ xa̱bo̱ waxúngua̱a̱ꞌ tsí kra̱ꞌaa géjwa̱nꞌ. Gu̱tha̱n-jáñíílaꞌ Ana̱ꞌlóꞌ kajngó ma̱xámíñuꞌ rí ma̱tha̱n-ráꞌa ajngáa máján, xómá jaꞌyoo rí ma̱ne̱.<verse eid="EPH 6:20" /></para>
  <para style="s">Naꞌthángoo Páblo̱</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />Na̱xu̱ꞌmáa dxájwalóꞌ Tíki̱ko̱ rí ma̱ꞌga gáꞌyalaꞌ. Ikhúúnꞌ phú nandoꞌ ja̱yo̱o̱ jamí mbá jañii a̱kuii̱n naꞌnii̱ ñajuun Táta̱. Ikhaa̱ maꞌthánlaꞌ mbá xúgíí xáne xtáá jamí dí e̱ne̱lo̱ꞌ ge̱jyoꞌ. <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />Ikhaa numuu rúꞌkhue̱n na̱xu̱ꞌmáa, kajngó mu̱dxawíínlaꞌ xáne juwaxo̱ꞌ ge̱jyoꞌ jamí ma̱ꞌni̱i wáa a̱kia̱nꞌlaꞌ mangaa.<verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />A̱ngui̱nꞌ, Ana̱ꞌlóꞌ Mikhuíí jamí Táta̱ Jesukrísto̱ gúne̱ rí ma̱juwalaꞌ tsímáá, rí ma̱galaꞌ ju̱ya̱-mijnálaꞌ jamí rí ma̱we̱je̱ a̱kia̱nꞌlaꞌ ju̱ñúu̱ ikhii̱n. <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />Ana̱ꞌlóꞌ gáꞌne-tsakun-rámii tsí na̱nguá i̱ni̱ꞌñáá rí nandúún juyáá Tátiálóꞌ Jesukrísto̱. Xkuaꞌnii gáꞌne.<note caller="+" style="f"><char style="fr" closed="false">6.24 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «Xkuaꞌnii gáꞌne».</char></note><verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>