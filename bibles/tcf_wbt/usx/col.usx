<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="COL" style="id">tcfU (52-Col) - Me̱ꞌpha̱a̱ Mañúwi̱ín (Malinaltepec) (NVI&gt;), c4/v95</book>
  <para style="h">Xa̱bo̱ Kolósa̱s</para>
  <para style="toc3">Col</para>
  <para style="toc2">Xa̱bo̱ Kolósa̱s</para>
  <para style="toc1">I̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inúú xa̱bo̱ Kolósa̱s</para>
  <para style="mt2">I̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inúú</para>
  <para style="mt1">Xa̱bo̱ Kolósa̱s</para>
  <chapter number="1" style="c" sid="COL 1" />
  <para style="s">Páblo̱ naraxi̱in tsí nanimbu̱únꞌ juyáá Jesús ná xuajen Kolósa̱s</para>
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1" />Ikhúúnꞌ ñajunꞌ Páblo̱, mbáa xa̱bo̱ tsí waxúngua̱a̱ꞌ neꞌne Jesukrísto̱ numuu rí xkuaꞌnii ndiyoo Ana̱ꞌlóꞌ. Ga̱jmi̱ꞌ dxájwalóꞌ Timotéo̱.<verse eid="COL 1:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="COL 1:2" />Na̱xu̱ꞌmá i̱yi̱i̱ꞌ ríge̱ꞌ ma̱ꞌga inúú xa̱bi̱i Ana̱ꞌlóꞌ tsí nanimbu̱únꞌ juyáá Krísto̱ ná xuajen Kolósa̱s.</para>
  <para style="b" vid="COL 1:2" />
  <para style="p" vid="COL 1:2">Ana̱ꞌlóꞌ Mikhuíí jamí Tátiálóꞌ Jesukrísto̱<note caller="+" style="f"><char style="fr" closed="false">1.2 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «jamí Tátiálóꞌ Jesukrísto̱».</char></note> gúne̱-tsakun-rámáaꞌlaꞌ jamí ikhii̱n máꞌ gúni̱i̱ rí ma̱juwalaꞌ tsímáá.<verse eid="COL 1:2" /></para>
  <para style="s">Páblo̱ naꞌthán-jáñuu Ana̱ꞌlóꞌ ga̱jma̱á numúú tsí nanimbu̱únꞌ juyáá Jesús ná Kolósa̱s</para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3" />Mbámbá rí nu̱tha̱n-jáñííxo̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á numalaꞌ, nu̱rígu̱uxo̱ꞌ gamaku inuu̱, Anu̱u̱ máꞌ Tátiálóꞌ Jesukrísto̱. <verse eid="COL 1:3" /><verse number="4" style="v" sid="COL 1:4" />Numuu ni̱dxawíínxo̱ꞌ rí wéje̱ a̱kia̱nꞌlaꞌ ná inuu Krísto̱ Jesús, jamí rí nandalaꞌ ju̱ñu̱ú mbá xúgíin xa̱bi̱i Ana̱ꞌlóꞌ. <verse eid="COL 1:4" /><verse number="5" style="v" sid="COL 1:5" />Rúꞌkhue̱n nu̱ne̱laꞌ numuu rí ga̱jma̱á mbá jañii a̱kia̱nꞌlaꞌ guáꞌthi̱ínlaꞌ rí mu̱drígúlaꞌ rí niyáxi̱i Ana̱ꞌlóꞌ maxnálaꞌ ná mikhuíí. Ikháanꞌlaꞌ ni̱dxawíínlaꞌ máꞌ rúꞌkhue̱n ga̱jma̱á majñu̱u̱ ajngáa gakon rí na̱ꞌkha̱ ná ajngáa máján, <verse eid="COL 1:5" /><verse number="6" style="v" sid="COL 1:6" />rí ni̱ga̱nú asndo ná awúun a̱kia̱nꞌlaꞌ. Ikhaa ajngáa máján ríge̱ꞌ nagaja̱a̱ ne̱ jamí naꞌne ne̱ rí máján ná inuu mbá xúgíí numbaa. Xkuaꞌnii máꞌ eꞌne ne̱ ga̱jma̱á nindxa̱ꞌlaꞌ ikháanꞌlaꞌ asndo nákhí mbiꞌi rí ni̱dxawíínlaꞌ rí phú nandoo Ana̱ꞌlóꞌ jaꞌyalaꞌ jamí nifraꞌa̱ꞌlaꞌ rí gakon rúꞌkhue̱n. <verse eid="COL 1:6" /><verse number="7" style="v" sid="COL 1:7" />Xkuaꞌnii ni̱ma̱ñalaꞌ ga̱jma̱á nindxu̱u̱ Epáfra̱s, yumbáá gajmiáxo̱ꞌ tsí phú nandaxo̱ꞌ ju̱ya̱á, mangaa máꞌ phú jmbii̱ rí ma̱ꞌnii̱ ñajuun Krísto̱ ga̱jma̱á numalaꞌ. <verse eid="COL 1:7" /><verse number="8" style="v" sid="COL 1:8" />Ikhaa̱ niꞌthánxo̱ꞌ rí nandalaꞌ ju̱ñu̱ú xa̱bo̱ ga̱jma̱á numuu Xu̱u̱ꞌ Ana̱ꞌlóꞌ.<verse eid="COL 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9" />Ikhaa jngó, asndo nákhí máꞌ mbiꞌi rí ni̱dxawíínxo̱ꞌ rúꞌkhue̱n, tsíni̱ꞌñááxo̱ꞌ rí nu̱tha̱n-jáñííxo̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á numalaꞌ. Nu̱nda̱ꞌáa̱xo̱ꞌ rí mu̱ne̱-nuwiinlaꞌ mbá xúgíí rí naꞌne a̱kuii̱n rí ma̱gu̱ma. Xúꞌkhue̱n máꞌ rí ma̱ma̱ñalaꞌ jamí ma̱fraꞌa̱ꞌlaꞌ rí nasngájma Xu̱u̱ꞌ Ana̱ꞌlóꞌ. <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />Xkuaꞌnii kajngó ma̱juwalaꞌ xómá rí nandoo Táta̱, ma̱ni̱gu̱u̱ꞌ gáꞌne mbá xúgíí rí nu̱ne̱laꞌ, ma̱ri̱gá mbá xúgíí inii rí máján gúne̱laꞌ jamí ma̱gaja̱a̱ rí nu̱ne̱-nuwiin májánlaꞌ Ana̱ꞌlóꞌ. <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" />Xúꞌkhue̱n máꞌ nu̱nda̱ꞌáa̱xo̱ꞌ rí ma̱ꞌne gúkuáanꞌlaꞌ ga̱jma̱á mbá xúgíí ski̱yu̱u̱ꞌ Ana̱ꞌlóꞌ rí phú wáá, kajngó ma̱ꞌngo̱o̱ a̱kia̱nꞌlaꞌ jamí ma̱wajún-gúkuálaꞌ inuu mbá xúgíí gaꞌkho̱. <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />Xkuaꞌnii kajngó gagi a̱kia̱nꞌlaꞌ gúrígu̱ulaꞌ gamaku inuu Ana̱ꞌlóꞌ, numuu rí ikhaa̱ niꞌnii̱ rí ma̱goo mu̱drígú mangáanꞌlaꞌ rí maxnúu̱ xa̱bii̱ tsí júwa̱ꞌ ga̱jma̱á aguu rí gakon. <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />Ana̱ꞌlóꞌ ni̱gu̱wiáanꞌlóꞌ ná ñawúun tsí ra̱májáan, jamí ni̱kaa̱ jaguáa̱nꞌlóꞌ rí maꞌthán-ñájwanlóꞌ A̱dée̱ tsí phú nandoo̱ jaꞌyoo̱. <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" />Ga̱jma̱á numuu̱ ikhaa̱ waꞌtse̱-ri̱ñáaꞌlóꞌ numuu rí nijáñuu̱,<note caller="+" style="f"><char style="fr" closed="false">1.14 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «numuu rí nijáñuu̱».</char></note> xkuaꞌnii neꞌne mba̱a̱ a̱kui̱in Ana̱ꞌlóꞌ jaꞌyoo aꞌkhánlóꞌ.<verse eid="COL 1:14" /></para>
  <para style="s">I̱wa̱á gíꞌdoo numuu Krísto̱ inuu mbá xúgíí</para>
  <para style="q">
    <verse number="15" style="v" sid="COL 1:15" />Ga̱jma̱á majñu̱u̱ Krísto̱ nakujma xómá jaꞌnii jayu Ana̱ꞌlóꞌ, tsí na̱nguá iyoo mbu̱ꞌyáálóꞌ ga̱jma̱á idalóꞌ.</para>
  <para style="q" vid="COL 1:15">Ikhaa̱ xtáa̱ máꞌ nákhí xóó tágu̱ma-ku̱maa numbaa.<verse eid="COL 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="COL 1:16" />Ga̱jma̱á majñu̱u̱ ikhaa̱ ni̱gu̱ma-ku̱maa mbá xúgíí rí ríga̱,</para>
  <para style="q" vid="COL 1:16">ná mikhuíí jamí ná numbaa,</para>
  <para style="q" vid="COL 1:16">rí nakujma jamí rí tsíkujma mbu̱ꞌyáálóꞌ.</para>
  <para style="q" vid="COL 1:16">Ga̱nindxúu̱n thúngaa, xa̱bo̱ ñajun, xa̱bo̱ ede̱ o xe̱ꞌ tsí nuthan-ñajun mbo̱ꞌ.</para>
  <para style="q" vid="COL 1:16">Mbá xúgíí ni̱gu̱ma-ku̱maa ga̱jma̱á ski̱yu̱u̱ꞌ,</para>
  <para style="q" vid="COL 1:16">jamí drígo̱o̱ máꞌ ikhaa̱ ñajuun ne̱.<verse eid="COL 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="COL 1:17" />Xtáa̱ máꞌ ikhaa̱ nákhí rí ni̱gu̱ma-ku̱maa numbaa,</para>
  <para style="q" vid="COL 1:17">jamí ga̱jma̱á ski̱yu̱u̱ꞌ ikhaa̱ mbá xúgíí ne̱ ríga̱ mújúun.<verse eid="COL 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="COL 1:18" />Xúꞌkhue̱n máꞌ ikhaa̱ ñajuu̱n xa̱bo̱ idxu̱ún tsí nanimbu̱únꞌ juyáa̱, tsí ñajúún xómá xuyuu̱.</para>
  <para style="q" vid="COL 1:18">Krísto̱ ñajuun tsí ginii jayu inuu mbá xúgíí,</para>
  <para style="q" vid="COL 1:18">jamí ikhaa̱ máꞌ ñajuu̱n tsí ginii jayu ndiyáa̱ mbiꞌyuu̱ nákhí kua̱ꞌa̱a̱n nijáñuu̱.</para>
  <para style="q" vid="COL 1:18">Ikhaa jngó ikhaa̱ ñajuu̱n tsí phú i̱tha̱án gíꞌdoo numuu̱ inuu mbá xúgíí.<verse eid="COL 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="COL 1:19" />Numuu rí Ana̱ꞌlóꞌ ndiyoo rí Krísto̱ ma̱nindxu̱u̱ mbá xúgíi jayu rí ñajuu̱n ikhaa̱.<verse eid="COL 1:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="COL 1:20" />Jamí ga̱jma̱á majñu̱u̱ Krísto̱ tsímáá nimbáxi̱iꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxu̱u̱ mbá xúgíí,</para>
  <para style="q" vid="COL 1:20">rí ríga̱ mikhuíí jamí rí ríga̱ ná numbaa.</para>
  <para style="q" vid="COL 1:20">Niꞌnii̱ rí ma̱juwalóꞌ tsímáá ga̱jma̱á majñu̱u̱ rí nijáñuu̱ ná ixe̱ krúsi̱.<verse eid="COL 1:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="COL 1:21" />Xúꞌkhue̱n máꞌ mangáanꞌlaꞌ, tsáanꞌ nijuwalaꞌ tsíngua̱ꞌ jamí ninindxa̱ꞌlaꞌ xa̱bo̱ sia̱nꞌ ná inuu Ana̱ꞌlóꞌ nákhí wajyúú, ga̱jma̱á numuu rí na̱ju̱ma̱ꞌlaꞌ jamí nu̱ne̱laꞌ rí xkawe̱ꞌ, Krísto̱ neꞌne rí tsímáá gámbáxi̱iꞌlaꞌ ga̱jma̱á nindxu̱u̱ Ana̱ꞌlóꞌ. <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />Rúꞌkhue̱n niꞌnii̱ nákhí ninindxu̱u̱ xa̱bo̱ numbaa jamí nijáñuu̱, kajngó ma̱ꞌne-jaꞌwáanꞌlaꞌ rí maxnáxáa̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ jamí ma̱xáríga̱ nimbá rí ra̱máján mi̱ꞌthán ga̱jma̱á numalaꞌ. <verse eid="COL 1:22" /><verse number="23" style="v" sid="COL 1:23" />I̱ndo̱ó máꞌ numuu rí gíꞌmaa rí ma̱wajún-gúkuálaꞌ jamí xa̱ꞌ ná tsu̱du̱u̱ rí nanimba̱ꞌlaꞌ ju̱ya̱á. Xúꞌkhue̱n máꞌ gíꞌmaa rí ga̱jma̱á mbá jañii a̱kia̱nꞌlaꞌ mu̱waꞌthi̱ínlaꞌ ma̱mba̱núu rí ni̱dxawíínlaꞌ máꞌ ga̱jma̱á numuu ajngáa máján. Ikhaa máꞌ ajngáa máján rúꞌkhue̱n nithán-raꞌa inuu mbá xúgíí numbaa, jamí ikhúúnꞌ, Páblo̱, ninindxu̱ꞌ xa̱bo̱ tsí naꞌthán-ráꞌa ne̱.<verse eid="COL 1:23" /></para>
  <para style="s">Ñajun rí naꞌne Páblo̱ ga̱jma̱á numúú tsí nanimbu̱únꞌ juyáá Jesús</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24" />Rí xúge̱ꞌ rá, phú nadxuꞌ rí na̱mínu̱u̱ꞌ ga̱jma̱á numalaꞌ, numuu rí xkuaꞌnii naka-ra̱ne̱-gáxu̱u̱ ná xuyuꞌ rí ndaꞌyóo mamínu̱u̱ꞌ Krísto̱ ga̱jma̱á numúú tsí ñajúún xómá xuyuu̱, ikhiin tsí nanimbu̱únꞌ juyáa̱. <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />Ana̱ꞌlóꞌ ndiyoo rí ikhúúnꞌ ma̱nindxu̱ꞌ tsí nayumbáá ga̱jma̱á numúú tsí nanimbu̱únꞌ juyáá Jesús, jamí nixnángaweꞌ rí ma̱tha̱n-ráꞌalaꞌ mbá xúgíí jayu ajngóo̱. <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />Awan drígo̱o̱ Ana̱ꞌlóꞌ ríge̱ꞌ, rí i̱ndo̱ó máꞌ ikhaa̱ ni̱gi̱da̱ꞌ idxu̱u̱, ni̱gi̱ꞌdoo̱ ngu̱ꞌwo̱o̱ ne̱ asndo nákhí máꞌ wajyúú mbiꞌi. Xómáꞌ xúge̱ꞌ rá, nasngájmee̱ ne̱ kajngó mbuyáá ne̱ xa̱bii̱. <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />Ikhiin tsíge̱ꞌ ñajúún tsí niꞌgí-mina̱ꞌ Ana̱ꞌlóꞌ rí masngájmúú rí phú wáá rí ñajuun awan drígo̱o̱ rí i̱ndo̱ó máꞌ ikhaa̱ ni̱gi̱da̱ꞌ idxu̱u̱ nákhí wajyúú, rí maxnúu̱ xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún. Ikhaa awan rúꞌkhue̱n ñajuun ríge̱ꞌ: rí ma̱xtáa Krísto̱ ná awúun a̱kia̱nꞌlaꞌ, jamí rí ga̱jma̱á mbá jañii a̱kia̱nꞌlaꞌ mu̱waꞌthi̱ínlaꞌ rí ma̱juwalaꞌ ná tsímáá xtáa Ana̱ꞌlóꞌ.<verse eid="COL 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="COL 1:28" />Ikháanꞌxo̱ꞌ nu̱tha̱n-ráꞌaxo̱ꞌ ga̱jma̱á numuu Krísto̱ ído̱ rí nu̱tha̱n-múꞌúúnxo̱ꞌ mbá xúgíin xa̱bo̱ jamí nu̱sngúu̱nxo̱ꞌ ga̱jma̱á mbá xúgíí rí na̱ma̱ñaxo̱ꞌ eꞌne Ana̱ꞌlóꞌ. Nu̱ne̱xo̱ꞌ rúꞌkhue̱n kajngó mbá xúgíi̱n gánindxúu̱n xómá jaꞌnii jayu Krísto̱ ído̱ rí mu̱xna̱xíi̱nxo̱ꞌ inuu Ana̱ꞌlóꞌ. <verse eid="COL 1:28" /><verse number="29" style="v" sid="COL 1:29" />Ikhaa numuu rúꞌkhue̱n phú gakhe̱ na̱ñajunlo̱ꞌ, kajngó ma̱kujma rí Krísto̱ xtáa̱ ga̱jma̱á nindxu̱ꞌ ga̱jma̱á majñu̱u̱ mbá xúgíí ski̱yu̱u̱ꞌ.<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1" />Nandoꞌ rí ma̱gi̱da̱ꞌ idxa̱ꞌlaꞌ ríge̱ꞌ: phú gakhe̱ na̱ñajunlo̱ꞌ ga̱jma̱á numalaꞌ jamí ga̱jma̱á numúú tsí júwa̱ꞌ ná xuajen Laodiséa̱, xúꞌkhue̱n máꞌ ga̱jma̱á numúú i̱ꞌwíin tsí tsíne̱-nuwúúnlo̱ꞌ. <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />Na̱ñajun kajngó mbayáa la tsiakhe̱ a̱kia̱nꞌlaꞌ, xúꞌkhue̱n máꞌ ma̱juwalaꞌ mbá ꞌnduꞌ numuu rí nandalaꞌ ju̱ya̱-mijnálaꞌ, jamí asndo ma̱fraꞌa̱ꞌ májánlaꞌ mbá xúgíí rí ndaꞌyóo ma̱ma̱ñalaꞌ. Xkuaꞌnii kajngó mu̱ne̱-nuwiinlaꞌ awan drígo̱o̱ Ana̱ꞌlóꞌ rí i̱ndo̱ó máꞌ ikhaa̱ ni̱gi̱da̱ꞌ idxu̱u̱ nákhí wajyúú, tsí ñajuun máꞌ jmína̱a̱ꞌ Krísto̱. <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />Numuu rí mbá xúgíí rí gíꞌdoo guéño numuu rí ma̱ma̱ñalaꞌ jamí mbu̱ya̱álaꞌ, ríga̱ ngu̱ꞌwo̱o̱ ne̱ ga̱jma̱á nindxu̱u̱ Krísto̱. <verse eid="COL 2:3" /><verse number="4" style="v" sid="COL 2:4" />Na̱tha̱nꞌlaꞌ ríge̱ꞌ kajngó nimbáa ma̱xáꞌne-nduwáanꞌlaꞌ ga̱jma̱á ajngáa mi̱nduwa rí mitsaan iwán. <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />Maske máꞌ na̱nguá xtáá a̱ꞌkhue̱n ga̱jma̱á nindxa̱ꞌlaꞌ, xtáá ga̱jma̱á majñu̱u̱ a̱kui̱nꞌ, jamí phú nadxu a̱kui̱nꞌ ído̱ na̱dxawuun rí mitsaan juwalaꞌ jamí rí wéje̱-gúkúu a̱kia̱nꞌlaꞌ ná inuu Krísto̱.<verse eid="COL 2:5" /></para>
  <para style="s">Krísto̱ neꞌne-jáwiáanꞌlóꞌ</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />Ikháanꞌlaꞌ ni̱dríguíilaꞌ máꞌ Táta̱ Jesukrísto̱, ikhaa numuu rúꞌkhue̱n, ga̱juwalaꞌ xómá rí nandoo̱ ikhaa̱. <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />Ga̱wajún-gúkuálaꞌ jamí a̱gajáanꞌlaꞌ máꞌ xúꞌkhue̱n, xúꞌkhue̱n máꞌ mu̱xúni̱ꞌñáá-ranimba̱ꞌlaꞌ ju̱ya̱á rí niꞌsngáá Krísto̱ xómáꞌ rí waꞌsngálaꞌ. Gu̱rígu̱ulaꞌ máꞌ xúꞌkhue̱n gamaku inuu Ana̱ꞌlóꞌ.<verse eid="COL 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 2:8" />Gu̱ña̱wa̱n-míjnálaꞌ inúú xa̱bo̱ tsí nandúún gúne̱-nduwáanꞌlaꞌ ga̱jma̱á ju̱mu̱ú xa̱bo̱ jamí ga̱jma̱á ajngáa michú rí mitsaan iwán. Numuu rí ikhii̱n nusngáa̱ rí mu̱ꞌne̱lóꞌ xómá rí nune̱ jayu xa̱bo̱ numbaa jamí gíñá ꞌguéen tsí nuthan-ñajun ná numbaa, jamí tsísngáa̱ rí mu̱ꞌne̱lóꞌ rí niꞌsngáá Krísto̱.<verse eid="COL 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 2:9" />Numuu rí Krísto̱ ñajuun mbá xúgíí jayu rí ñajuun Ana̱ꞌlóꞌ. <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />Xómáꞌ ikháanꞌlaꞌ, káxáanꞌlaꞌ máꞌ ga̱jma̱á nindxu̱u̱ Krísto̱, numuu rí ikhaa̱ naꞌthán-ñájúu̱n mbá xúgíin xe̱ꞌ tsí nuthan-ñajun jamí mbá xúgíí tsiakhe̱. <verse eid="COL 2:10" /><verse number="11" style="v" sid="COL 2:11" />Xúꞌkhue̱n máꞌ mangaa, ga̱jma̱á majñu̱u̱ ikhaa̱ ndi̱ya̱laꞌ tsina jndi. Ra̱ꞌkhá tsina jndi rí na̱gu̱ma ná xuyuu xa̱bo̱ ñajuun ríge̱ꞌ, rí tsina jndi ná ni̱ga̱taa rí na̱wa̱ꞌa̱ a̱kia̱nꞌlóꞌ rí mu̱ꞌne̱lóꞌ aꞌkhán ñajuun ne̱, jamí jmína̱a̱ꞌ máꞌ Krísto̱ nixnálaꞌ ne̱. <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" />Ikháanꞌlaꞌ asndo xó rí waꞌdiáanꞌlaꞌ jaꞌnii nákhí rí waxúꞌdu-maꞌáanꞌlaꞌ ná awúun iya ga̱jma̱á numuu rí nanimba̱ꞌlaꞌ ju̱ya̱á Krísto̱. Xúꞌkhue̱n máꞌ mangaa, ndi̱ya̱a mbiꞌyalaꞌ ga̱jma̱á nindxu̱u̱ numuu rí ninimba̱ꞌlaꞌ ju̱ya̱á ski̱yu̱u̱ꞌ Ana̱ꞌlóꞌ, tsí neꞌne rí mbayáa̱ mbiꞌyuu̱.<verse eid="COL 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="COL 2:13" />Nákhí rí xóó túya̱laꞌ tsina jndi rúꞌkhue̱n, ikháanꞌlaꞌ asndo xó rí nijáñalaꞌ jaꞌnii ná inuu Ana̱ꞌlóꞌ ga̱jma̱á numuu aꞌkhánlaꞌ. Xómáꞌ xúge̱ꞌ rá, Ana̱ꞌlóꞌ neꞌne rí mbu̱ꞌyalóꞌ ga̱jma̱á nindxu̱u̱ Krísto̱ nákhí neꞌne mba̱a̱ a̱kuii̱n jaꞌyoo̱ mbá xúgíí aꞌkhánlóꞌ. <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" />Numuu rí Ana̱ꞌlóꞌ nirngudi̱i i̱yi̱i̱ꞌ xtángoo rí naꞌne tsu̱da̱ꞌlóꞌ, rí naꞌthán rí gíꞌmáálóꞌ gidxóó. Ana̱ꞌlóꞌ nirngudi̱i gidxáwálóꞌ nákhí nindrákee̱ i̱yi̱i̱ꞌ gidxóó rúꞌkhue̱n ná ixe̱ krúsi̱. <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />Ana̱ꞌlóꞌ nirígúu ski̱ñu̱ú gíñá ꞌguéen jamí tsiakhe̱ ꞌguéen ga̱jma̱á majñu̱u̱ Krísto̱. Niríye̱e̱ꞌ gamakúún ná inúú xa̱bo̱ nákhí ni̱ꞌngo̱o̱ inúú ná ixe̱ krúsi̱.<verse eid="COL 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16" />Ikhaa jngó, ma̱xánimba̱ꞌlaꞌ xí mbáa xa̱bo̱ naꞌthánlaꞌ rí ra̱ꞌkhíin e̱ne̱laꞌ ga̱jma̱á numuu rí napholaꞌ o rí nawanlaꞌ, o numuu rí tsíne̱-ri̱ya̱aꞌlaꞌ ndxo̱o̱ go̱nꞌ nuxi̱i̱ꞌ o numuu rí tsíya̱-makuíílaꞌ mbiꞌi rí nduya̱a xu̱únꞌ xa̱bo̱ judío̱ mbo̱ꞌ. <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />Mbá xúgíí rúꞌkhue̱n ninindxu̱u̱ xtiꞌkhuu rí ni̱ꞌkha̱ nda̱wa̱á. Xómáꞌ tsí xtáa ñajuun Krísto̱. <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />Mu̱xúni̱ꞌñá-mijnálaꞌ rí muxna-maꞌáanꞌlaꞌ tsí nune̱ máꞌ ene̱ rí nu̱xrígú-mijná jamí nune̱-mbi̱in ánje̱l. Numuu rí ikhii̱n nuthee̱n ga̱jma̱á numuu rí ndiyáa̱ inu-mbiꞌíí, jamí nda̱a̱ jayu numuu rí nu̱xu̱xí-mijnée̱ ga̱jma̱á ju̱mu̱ú xa̱bo̱ numbaa. <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" />Na̱nguá ku̱ra̱tun-mijnée̱ ga̱jma̱á nindxu̱u̱ Krísto̱, tsí ñajuun xa̱bo̱ Ede̱, tsí naxníꞌtsuu jamí naꞌne rí mu̱wa̱a mújúun mbá xúgíi xa̱bo̱, jamí naꞌnii̱ rí ma̱gaja̱a̱ xómá rí nandoo Ana̱ꞌlóꞌ.<verse eid="COL 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20" />Ikháanꞌlaꞌ nijáñalaꞌ ga̱jma̱á nindxu̱u̱ Krísto̱ jamí nijáwiáanꞌlaꞌ inúú mbá xúgíin tsiakhe̱ tsí nuthan-ñajun ná numbaa. Náá numuu kajngó rí xóó nu̱ni̱ꞌñá-mijnálaꞌ rí mi̱ꞌthán-ñájwanlaꞌ gáꞌne xtángoo ríge̱ꞌ róꞌ: <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />«Ma̱xátru̱gua̱ ríge̱ꞌ. Ma̱xéꞌtso rúꞌkhue̱n. Ma̱xáta̱xkajma rí ñúꞌún». <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />Gisngáá jamí xtángoo drígu̱ún xa̱bo̱ numbaa ñajuun rúꞌkhue̱n, jamí naꞌthán ne̱ ga̱jma̱á numuu rí ndámba̱ ído̱ rí najmaa. <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />Gakon máꞌ rí phú na̱ma̱ñúú xa̱bo̱ tsúꞌkhue̱n jaꞌnii ga̱jma̱á numuu xó rí nune̱-mba̱a̱ Ana̱ꞌlóꞌ, numuu rí nu̱xrígú-mijnée̱ jamí nuñíi̱ mi̱ndaꞌkho xuñúu̱. I̱ndo̱ó máꞌ numuu rí nda̱a̱ nitháan ski̱ñúu̱ꞌ rí ma̱wajún-ꞌthíi̱n aꞌkhán rí na̱ni̱gúu̱nꞌ muni̱i̱.<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="s">Xáne gíꞌmaa ma̱juwalóꞌ gajmiálóꞌ Krísto̱</para>
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1" />Numuu rí ndi̱ya̱a máꞌ mbiꞌyalaꞌ ga̱jma̱á nindxu̱u̱ Krísto̱, gu̱ꞌyálaꞌ rí ríga̱ ná mikhuíí, ná ꞌgí Krísto̱ ná ñawún mújúun Ana̱ꞌlóꞌ. <verse eid="COL 3:1" /><verse number="2" style="v" sid="COL 3:2" />Gu̱ndxa̱ꞌwa̱-mijnálaꞌ ga̱jma̱á numuu rí ríga̱ ná mikhuíí, ra̱ꞌkhá rí ríga̱ ná numbaa ríge̱ꞌ. <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />Numuu rí ikháanꞌlaꞌ nijáñalaꞌ máꞌ, ikhaa jngó nánguá máꞌ juwalaꞌ rí mu̱ne̱laꞌ rí nandoo xuyalaꞌ, jamí Ana̱ꞌlóꞌ gíꞌdoo mújúún mbiꞌyalaꞌ ga̱jma̱á nindxu̱u̱ Krísto̱ ná mikhuíí. <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />Ído̱ gáꞌkha̱a Krísto̱, tsí jayá mbiꞌyalaꞌ, a̱ꞌkhue̱n ma̱kujmáaꞌ mangáanꞌlaꞌ ga̱jma̱á nindxu̱u̱ jamí ma̱juwalaꞌ ná phú wáá xtáa̱ ikhaa̱.<verse eid="COL 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5" />Ikhaa jngó, gu̱ne̱laꞌ rí ma̱ja̱ñúu mbá xúgíí rí xkawe̱ꞌ rí na̱wa̱ꞌa̱ a̱kia̱nꞌlaꞌ mu̱ne̱laꞌ: nimbáa ma̱xábóo ga̱jma̱á xa̱bo̱ tsí táyáa, ma̱xáꞌne nimbá rí xkawe̱ꞌ ga̱jma̱á xuyuu, ma̱xáꞌne nimbá rí ra̱jáꞌyoo ga̱jma̱á xuyuu, ma̱xáwa̱ꞌa̱ a̱kui̱in ma̱ꞌne rí xkawe̱ꞌ. Nimbáa ma̱xáni̱gu̱u̱ꞌ rí ma̱gi̱ꞌdoo mi̱ndaꞌkho, numuu rí asndo xó rí ikhaa máꞌ rúꞌkhue̱n eꞌne-mba̱a̱ jaꞌnii. <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />Ga̱jma̱á numuu mbá xúgíí rúꞌkhue̱n na̱ꞌkha̱ jamínu̱ꞌ eꞌne Ana̱ꞌlóꞌ ná inúú tsí najñaguun juyáa̱.<note caller="+" style="f"><char style="fr" closed="false">3.6 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «ná inúú tsí najñaguun juyáa̱».</char></note> <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />Ne̱ne̱ mangáanꞌlaꞌ mbá xúgíí rúꞌkhue̱n nákhí wapha, nákhí rí nijuwalaꞌ ná awúun ne̱. <verse eid="COL 3:7" /><verse number="8" style="v" sid="COL 3:8" />Xómáꞌ xúge̱ꞌ rá, gu̱ni̱ꞌñáálaꞌ mbá xúgíí ríge̱ꞌ: ma̱xágigoo idxa̱ꞌlaꞌ, ma̱xájiꞌnáaꞌlaꞌ, mu̱xúne̱laꞌ rí xkawe̱ꞌ, mu̱xútha̱n-xkawiu̱únlaꞌ xa̱bo̱, ni máꞌ ma̱xágájnuu nimbá ajngáa xkawe̱ꞌ ná rawanlaꞌ. <verse eid="COL 3:8" /><verse number="9" style="v" sid="COL 3:9" />Mu̱xúne̱-nduwa-mijnálaꞌ, numuu rí ikháanꞌlaꞌ ni̱ni̱ꞌñáálaꞌ máꞌ janíí xa̱bo̱ aꞌkhán tsí ninindxa̱ꞌlaꞌ nákhí wajyúú ga̱jma̱á mbá xúgíí rí xkawe̱ꞌ ne̱ne̱laꞌ. <verse eid="COL 3:9" /><verse number="10" style="v" sid="COL 3:10" />Jamí ni̱gíꞌdi̱ínlaꞌ máꞌ nijuwalaꞌ xómá jaꞌyoo xa̱bo̱ tsí nuxi̱i̱ꞌ, jamí na̱ka̱-raꞌne nuxáanꞌlaꞌ máꞌ xúꞌkhue̱n kajngó ma̱nindxa̱ꞌlaꞌ xómá jaꞌnii Ana̱ꞌlóꞌ tsí neꞌne-ku̱máaꞌlaꞌ, asndo rí mu̱ne̱-nuwii̱n májánlaꞌ. <verse eid="COL 3:10" /><verse number="11" style="v" sid="COL 3:11" />Ikhaa jngó rí xúge̱ꞌ rá, tsíꞌyoo máꞌ xí xa̱bo̱ griégo̱ o xa̱bo̱ judío̱ ñajwanlóꞌ, xí juꞌyálóꞌ tsina jndi o na̱nguá mbo̱ꞌ, xí phú nduꞌyáálóꞌ o na̱nguá, xí yumbáá tsí waꞌtsi̱i̱ ñajwanlóꞌ o na̱nguá mbo̱ꞌ. Krísto̱ ñajuun tsí phú i̱tha̱án gíꞌdoo numuu inuu mbá xúgíí, jamí xtáa̱ ga̱jma̱á nindxa̱ꞌlóꞌ mbá xúgiáanꞌlóꞌ.<verse eid="COL 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12" />Maphú nandoo Ana̱ꞌlóꞌ jaꞌyalaꞌ, rí asndo niraꞌwáa̱nꞌlaꞌ rí ma̱nindxa̱ꞌlaꞌ xa̱bii̱. Ikhaa jngó jámba̱ miꞌtsú ga̱ñáwíin a̱kia̱nꞌlaꞌ, ga̱ꞌne májáan a̱kia̱nꞌlaꞌ, gu̱xrígú-mijnálaꞌ, ga̱ꞌne gamakuáanꞌlaꞌ, jamí ma̱xájiꞌnáaꞌlaꞌ nacha̱ guéño. <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" />Xúꞌkhue̱n máꞌ ga̱ꞌngo̱o̱ a̱kia̱nꞌlaꞌ ju̱ya̱-mijnálaꞌ, jamí gu̱ne̱ mba̱a̱ a̱kia̱nꞌlaꞌ ju̱ya̱-mijnálaꞌ xí mbáa gíꞌdoo xkujndu ga̱jma̱á i̱mba̱a̱ꞌ. Gu̱ne̱ mba̱a̱ a̱kia̱nꞌlaꞌ xómá rí Krísto̱ neꞌne mba̱a̱ a̱kui̱in jaꞌyalaꞌ mangáanꞌlaꞌ. <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />Rí phú i̱tha̱án gíꞌdoo numuu ñajuun rí ma̱galaꞌ ju̱ya̱-mijnálaꞌ, numuu rí ikhaa rúꞌkhue̱n ma̱ꞌne rí mbóó idxa̱ꞌlaꞌ gáꞌne.<verse eid="COL 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="COL 3:15" />Ga̱ri̱gá máꞌ xúꞌkhue̱n tsímáá rí naxná Ana̱ꞌlóꞌ<note caller="+" style="f"><char style="fr" closed="false">3.15 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán «Krísto̱».</char></note> ga̱jma̱á nindxa̱ꞌlaꞌ. Numuu rí ikháanꞌlaꞌ watsaꞌwálaꞌ rí ma̱nindxa̱ꞌlaꞌ asndo xó rí mbáwíi xa̱bo̱. Jamí gu̱rígu̱ulaꞌ gamaku inuu Ana̱ꞌlóꞌ. <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" />Gatíí ajngóo Krísto̱ ná awúun a̱kia̱nꞌlaꞌ gáꞌne. Ga̱ma̱ña májánlaꞌ rí mu̱sngáá-mijnálaꞌ jamí rí mu̱xprígú-mijnálaꞌ. Gu̱sianlaꞌ inuu Táta̱ ajmúú rí na̱ꞌkha̱ ná i̱yi̱i̱ꞌ ajngóo Ana̱ꞌlóꞌ, ajmúú rí naꞌne-mba̱a̱ Ana̱ꞌlóꞌ jamí ajmúú rí nambáyúu nímia̱ꞌlaꞌ. <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />Mbá xúgíí rí nu̱ne̱laꞌ, ga̱nindxu̱u̱ ne̱ rí nu̱tha̱nlaꞌ o mbá ñajun rí nu̱ne̱laꞌ mbo̱ꞌ, gu̱ne̱laꞌ ne̱ ga̱jma̱á numuu Táta̱ Jesús, jamí gu̱rígu̱ulaꞌ gamaku inuu Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ máꞌ ikhaa̱.<verse eid="COL 3:17" /></para>
  <para style="s">Xáne gíꞌmaa rí ma̱ju̱wá tsí nagóó tsu̱du̱u̱ Krísto̱</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18" />Ikháanꞌlaꞌ nána̱ tsáanꞌ ni̱nújúnlaꞌ, gu̱ne̱-mbáníílaꞌ rí nuthanlaꞌ a̱jmbialaꞌ, numuu rí rúꞌkhue̱n jaꞌyoo rí mu̱ne̱laꞌ tsáanꞌ nanimba̱ꞌlaꞌ ju̱ya̱á Táta̱.<verse eid="COL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="COL 3:19" />Ikháanꞌlaꞌ táta̱ tsáanꞌ ni̱ni̱ꞌgúúnlaꞌ, ga̱galaꞌ ju̱ñu̱ú gu̱ꞌwia̱ꞌlaꞌ, jamí mu̱xúñúu̱laꞌ mi̱ndaꞌkho.<verse eid="COL 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 3:20" />Ikháanꞌlaꞌ e̱je̱n, gu̱ne̱-mbáníílaꞌ mbá xúgíí rí naꞌthán tátiálaꞌ ga̱jma̱á nániálaꞌ, numuu rí rúꞌkhue̱n ñajuun rí na̱ni̱gu̱u̱ꞌ Táta̱.<verse eid="COL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 3:21" />Ikháanꞌlaꞌ tsáanꞌ anu̱ú e̱je̱n ñajwanlaꞌ, mu̱xúne̱laꞌ rí ma̱jiꞌníi i̱jña̱ꞌlaꞌ, kajngó ma̱xáwabaa a̱kuíi̱n.<verse eid="COL 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="COL 3:22" />Ikháanꞌlaꞌ yumbáá tsí waꞌtsi̱in, gu̱ne̱-mbáníílaꞌ mbá xúgíí rí nuthanlaꞌ xa̱bo̱ numbaa tsí ñajúún ña̱ꞌñalaꞌ. Mu̱xúne̱-mbáníílaꞌ i̱ndo̱ó máꞌ ído̱ rí júwe̱e̱ꞌ mu̱ya̱xa̱ꞌlaꞌ kajngó muthee̱n rí máján ga̱jma̱á numalaꞌ, rí gu̱ñajunlaꞌ ga̱jma̱á mbá jañii a̱kia̱nꞌlaꞌ ga̱jma̱á numuu rí ndu̱ya̱-makuíílaꞌ Ana̱ꞌlóꞌ. <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />Mbá jañii a̱kia̱nꞌlaꞌ gúne̱laꞌ mbá xúgíí ñajun rí nu̱ne̱laꞌ. Gu̱ne̱laꞌ asndo xó rí Táta̱ máꞌ e̱ne̱-mba̱a̱laꞌ, ra̱ꞌkhíin xa̱bo̱ numbaa. <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />Numuu rí ndu̱ya̱álaꞌ máꞌ rí Táta̱ ma̱ꞌne rí mu̱drígúlaꞌ gamaku ído̱ gáxnálaꞌ rí nixuda-mine̱e̱ꞌ maxnúu̱ tsí ñajúún xa̱bii̱. Numuu rí ikháanꞌlaꞌ nu̱ne̱-mba̱ꞌwi̱i̱laꞌ Krísto̱, tsí ñajuun Táta̱. <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" />Xómáꞌ tsí naꞌne rí ra̱máján rá, ma̱grui̱guíi̱ jamínu̱ꞌ ga̱jma̱á numuu rí niꞌnii̱, numuu rí Ana̱ꞌlóꞌ tsíraꞌwíi̱n xa̱bo̱ tsí ma̱ꞌne-nga̱júu̱n.<verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1" />Xómáꞌ ikháanꞌlaꞌ tsáanꞌ kuaꞌdiinlaꞌ yumbáá tsí waꞌtsi̱in, ga̱nindxa̱ꞌlaꞌ xa̱bo̱ tsí májíin jamí gu̱ne̱laꞌ ga̱jma̱á nindxúu̱n xómá phú jaꞌyoo. Ga̱rmáꞌáan a̱kia̱nꞌlaꞌ rí xtáa mbáa tsí ñajuun ña̱ꞌñalaꞌ mangáanꞌlaꞌ ná mikhuíí.<verse eid="COL 4:1" /></para>
  <para style="s">Mbaꞌa inii rí naꞌthán-máꞌán Páblo̱</para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />Mu̱xúni̱ꞌñáálaꞌ rí nu̱tha̱n-jáñíílaꞌ Ana̱ꞌlóꞌ. Ga̱juwalaꞌ xawi máꞌ xúꞌkhue̱n jamí gu̱rígu̱ulaꞌ gamaku inuu Ana̱ꞌlóꞌ ído̱ rí nu̱tha̱n-jáñíi̱laꞌ. <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />Gu̱tha̱n-jáñíílaꞌ Táta̱ ga̱jma̱á numa mangáanꞌxo̱ꞌ, kajngó marmáꞌthoo̱ ná ma̱goo mu̱tha̱n-ráꞌaxo̱ꞌ ajngóo̱. A̱ꞌkhue̱n rí ma̱goo mu̱thu̱únxo̱ꞌ xa̱bo̱ awan drígo̱o̱ Krísto̱ rí i̱ndo̱ó máꞌ ikhaa̱ ni̱gi̱da̱ꞌ idxu̱u̱ nákhí wajyúú. Ikhaa máꞌ numuu rúꞌkhue̱n kru̱ꞌúúnlo̱ꞌ géjwa̱nꞌ xúge̱ꞌ. <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />Gu̱tha̱n-jáñíílaꞌ Ana̱ꞌlóꞌ kajngó ma̱goo ma̱thu̱ún mújúnꞌ xa̱bo̱ ga̱jma̱á numuu awan rúꞌkhue̱n, xómá phú jaꞌyoo rí ma̱ne̱. <verse eid="COL 4:4" /><verse number="5" style="v" sid="COL 4:5" />Ga̱ma̱ña májánlaꞌ rí ma̱juwalaꞌ ná majñu̱ú xa̱bo̱ tsí tsínimbu̱únꞌ juyáá Krísto̱, jamí mu̱xúne̱-mbáti̱ga̱laꞌ nimbá mbiꞌi rí juwalaꞌ. <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />Ído̱ rí nu̱ndxákuunlaꞌ, ga̱ꞌne gamaku jamí mitsaan ajngálaꞌ jámba̱ miꞌtsú. Xkuaꞌnii kajngó ma̱ma̱ñalaꞌ rí mu̱riꞌñáálaꞌ mbámbáa tsí naraxa̱ꞌlaꞌ.<verse eid="COL 4:6" /></para>
  <para style="s">Páblo̱ naraxi̱in mbaꞌiin xa̱bo̱</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />Mbá xúgíí rí na̱ka̱-raríga̱ ga̱jma̱á numuꞌ ikhúúnꞌ, maꞌthánlaꞌ Tíki̱ko̱. Ikhaa̱ ñajuu̱n dxájwalóꞌ tsí phú nandalóꞌ juꞌyáá jamí phú jmbii rí ma̱ne̱ ga̱jmi̱ꞌ ñajuun Táta̱. <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />Na̱xu̱ꞌmáa̱lo̱ꞌ rí ma̱ꞌgee̱ gáꞌyalaꞌ kajngó mu̱dxawíínlaꞌ xáne juwaxo̱ꞌ jamí maxnálaꞌ tsiakhe̱. <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" />Na̱ke̱e̱ ga̱jmáa̱ Onési̱mo̱, dxájwalóꞌ tsí phú nandalóꞌ juꞌyáá jamí phú jmbii, jamí xa̱bo̱ xuajñalaꞌ máꞌ ñajuu̱n. Ikhii̱n muthanlaꞌ mbá xúgíí rí naríga̱ ge̱jyoꞌ.<verse eid="COL 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="COL 4:10" />Naraxáa̱nꞌlaꞌ Aristárko̱, dxájuꞌ tsí kru̱ꞌúún ga̱jmi̱ꞌ ná géjwa̱nꞌ, xúꞌkhue̱n máꞌ Márko̱s, a̱ꞌdá-rixa̱ ga̱jma̱á Bernabé. Ni̱xna̱ngáwalaꞌ máꞌ ga̱jma̱á numuu Márko̱s, rí mu̱dríguíi̱ májánlaꞌ xí na̱ke̱e̱ gáꞌyalaꞌ. <verse eid="COL 4:10" /><verse number="11" style="v" sid="COL 4:11" />Naraxáa̱nꞌlaꞌ Jesús mangaa, tsí nitháán Jústo̱. I̱ndo̱ó máꞌ atsúun xa̱bo̱ judío̱ tsíge̱ꞌ ñajúún tsí na̱ñajun gajmíꞌ kajngó i̱ꞌwíin xa̱bo̱ mi̱ꞌthán-ñájúún gáꞌne Ana̱ꞌlóꞌ, jamí ikhii̱n phú nuxniꞌ tsiakhe̱. <verse eid="COL 4:11" /><verse number="12" style="v" sid="COL 4:12" />Naraxáa̱nꞌlaꞌ Epáfra̱s, xa̱bo̱ xuajñalaꞌ máꞌ. Yumbée Krísto̱ tsíge̱ꞌ jámba̱ miꞌtsú naꞌthán-jáñuu Ana̱ꞌlóꞌ ga̱jma̱á numalaꞌ, kajngó ma̱wajún-gúkuálaꞌ, ma̱ꞌne káxáanꞌlaꞌ jamí ma̱fraꞌa̱ꞌ májánlaꞌ mbá xúgíí rí nandoo Ana̱ꞌlóꞌ rí mu̱ne̱laꞌ. <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />Ikhúúnꞌ nda̱yo̱o̱ mújúnꞌ rí maphú naxná-gamiéjuun Epáfra̱s e̱ne̱laꞌ. Xúꞌkhue̱n máꞌ phú naxná-gamiéjuu̱n ga̱jma̱á numúú a̱ngia̱nꞌlóꞌ tsí júwa̱ꞌ ná Laodiséa̱ jamí ná Yerápo̱li̱s. <verse eid="COL 4:13" /><verse number="14" style="v" sid="COL 4:14" />Naraxáa̱nꞌlaꞌ Lúka̱s, xa̱bo̱ thana tsí phú nandaxo̱ꞌ ju̱ya̱á. Xúꞌkhue̱n máꞌ Déma̱s mangaa. <verse eid="COL 4:14" /><verse number="15" style="v" sid="COL 4:15" />Nu̱ra̱xi̱inxo̱ꞌ a̱ngia̱nꞌlóꞌ tsí júwa̱ꞌ ná Laodiséa̱, jamí nu̱ra̱xi̱ixo̱ꞌ Nínfa̱s gajmíí tsí nanimbu̱únꞌ juyáá Jesús tsí na̱gi̱mbíin ná guꞌwóo̱ mangaa.<verse eid="COL 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 4:16" />Ído̱ wámba̱ꞌlaꞌ ni̱raxnuu i̱yi̱i̱ꞌ ríge̱ꞌ, gu̱xu̱ꞌmálaꞌ ne̱ ma̱ꞌga inúú tsí nanimbu̱únꞌ juyáá Jesús ná Laodiséa̱ kajngó mu̱raxnuu̱ ne̱ mangii̱n. Jamí ikháanꞌlaꞌ gu̱raxnuulaꞌ i̱yi̱i̱ꞌ rí ni̱xu̱ꞌmá inúu̱ ikhii̱n.<verse eid="COL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="COL 4:17" />Gu̱tha̱ánlaꞌ Arkípo̱ ríge̱ꞌ: «Athane̱-mbáníí lá ñajun rí nixnángawaaꞌ Táta̱ rí ma̱tha̱ne̱».<verse eid="COL 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18" />Jmínu̱úꞌ ikhúúnꞌ, Páblo̱, na̱tháán ga̱jma̱á ñawúnꞌ rí na̱ra̱xáanꞌlaꞌ. Ma̱xámbumalaꞌ rí kru̱ꞌúún géjwa̱nꞌ. Ana̱ꞌlóꞌ gáꞌne-tsakun-rámáaꞌlaꞌ. Xkuaꞌnii gáꞌne.<note caller="+" style="f"><char style="fr" closed="false">4.18 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «Xkuaꞌnii gáꞌne».</char></note><verse eid="COL 4:18" /></para>
  <chapter eid="COL 4" />
</usx>