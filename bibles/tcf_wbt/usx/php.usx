<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id">tcfU (51-Filip) - Me̱ꞌpha̱a̱ Mañúwi̱ín (Malinaltepec) - - PZM Ne̱ne̱ ñajun: 25May2005; c4/v104</book>
  <para style="h">Xa̱bo̱ Filípo̱s</para>
  <para style="toc3">Flp</para>
  <para style="toc2">Xa̱bo̱ Filípo̱s</para>
  <para style="toc1">I̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inúú xa̱bo̱ Filípo̱s</para>
  <para style="mt2">I̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inúú</para>
  <para style="mt1">Xa̱bo̱ Filípo̱s</para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="s">Páblo̱ naraxi̱in tsí nanimbu̱únꞌ juyáá Jesús ná xuajen Filípo̱s</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />Ikhúúnꞌ Páblo̱, ga̱jmi̱ꞌ Timotéo̱, tsáanꞌ ñajwanxo̱ꞌ yumbée Jesukrísto̱, nu̱ra̱xáanꞌlaꞌxo̱ꞌ mbá xúgiáanꞌlaꞌ tsáanꞌ ñajwanlaꞌ xa̱bi̱i Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ Krísto̱ Jesús, tsáanꞌ juwalaꞌ ná Filípo̱s. Nu̱ra̱xi̱inxo̱ꞌ mangiin xa̱bo̱ buanuu tsí nu̱ya̱xe̱-ra̱ꞌmáá jamí tsí nu̱mba̱yí-jmáá a̱ꞌkhue̱n.<verse eid="PHP 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 1:2" />Ana̱ꞌlóꞌ Mikhuíí jamí Tátiálóꞌ Jesukrísto̱ gúne̱-tsakun-rámáaꞌlaꞌ jamí ikhii̱n máꞌ gúni̱i̱ rí ma̱juwalaꞌ tsímáá.<verse eid="PHP 1:2" /></para>
  <para style="s">Páblo̱ naꞌthán-jáñuu Ana̱ꞌlóꞌ ga̱jma̱á numúú tsí na̱gi̱mbíin ná Filípo̱s</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />Mbámbá rí na̱rmáꞌáan a̱kui̱nꞌ ja̱ya̱ꞌlaꞌ, na̱rígu̱u gamaku ná inuu Anu̱ꞌ Mikhuíí ga̱jma̱á numalaꞌ. <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />Jámba̱ miꞌtsú rí na̱thu̱u̱nlo̱ꞌ, phú gagi a̱kui̱nꞌ na̱tha̱n-jáñuu̱lo̱ꞌ ga̱jma̱á numalaꞌ mbá xúgiáanꞌlaꞌ. <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />Numuu rí ikháanꞌlaꞌ ni̱mbáyúꞌlaꞌ rí ma̱tha̱n-ráꞌalo̱ꞌ ajngáa máján, asndo nákhí máꞌ mbiꞌi rí ginii asndo xúge̱ꞌ. <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />Ikhúúnꞌ nda̱yo̱o̱ mújúnꞌ máꞌ rí Ana̱ꞌlóꞌ, tsí nigíꞌdu̱u̱n naꞌne mbá ñajun rí máján ga̱jma̱á nindxa̱ꞌlaꞌ, ikhaa̱ ma̱ꞌga-raꞌne gáxu̱u̱ ne̱ asndo mbiꞌi rí ma̱ꞌkha̱a Jesukrísto̱. <verse eid="PHP 1:6" /><verse number="7" style="v" sid="PHP 1:7" />Phú ndaꞌyóo rí ma̱ju̱mu̱ꞌ xkuaꞌnii ga̱jma̱á numalaꞌ mbá xúgiáanꞌlaꞌ, numuu rí phú gúꞌdáanꞌlaꞌ ná ními̱ꞌ. Juwalaꞌ ga̱jma̱á nindxu̱ꞌ awúun ikhaa máꞌ rí na̱gu̱ma-tsakun-rámúú eꞌne Ana̱ꞌlóꞌ. Mbóó máꞌ juwalaꞌ ga̱jma̱á nindxu̱ꞌ, maske máꞌ xtáá ná géjwa̱nꞌ, o xtáá na̱tha̱n-mbáá numuu ajngáa máján kajngó ma̱kujma rí gakon ñajuun ne̱. <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />Ndaꞌyoo Ana̱ꞌlóꞌ rí gakon rí na̱tha̱nꞌlaꞌ: maphú nandoꞌ ja̱ya̱ꞌlaꞌ mbá xúgiáanꞌlaꞌ, asndo xómáꞌ a̱kui̱in Jesukrísto̱ jaꞌnii.<verse eid="PHP 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 1:9" />Ríge̱ꞌ ñajuun rí na̱ndo̱ꞌo̱o̱ Ana̱ꞌlóꞌ ga̱jma̱á numalaꞌ: rí ma̱ꞌga-ragaja̱a̱ máꞌ xúꞌkhue̱n rí nandalaꞌ ju̱ya̱-mijnálaꞌ. Xúꞌkhue̱n máꞌ na̱ndo̱ꞌo̱o̱ rí ma̱ma̱ñalaꞌ jamí ma̱fraꞌa̱ꞌ májánlaꞌ mbá xúgíí, <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />ikhaa jngó ma̱goo mu̱ra̱ꞌwíílaꞌ rí i̱tha̱án máján. Xkuaꞌnii ma̱ꞌne jaꞌwu a̱kia̱nꞌlaꞌ jamí ma̱xáríga̱ nimbá rí ra̱máján mi̱ꞌthán ga̱jma̱á numalaꞌ ído̱ rí ma̱ꞌkha̱a Krísto̱. <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />Numuu rí ga̱jma̱á majñu̱u̱ Jesukrísto̱ gatíí rí máján nu̱ne̱laꞌ, kajngó ma̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ jamí mi̱ꞌthán rí máján ga̱jma̱á numuu̱.<verse eid="PHP 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />A̱ngui̱nꞌ, nandoꞌ rí ma̱gi̱da̱ꞌ idxa̱ꞌlaꞌ ríge̱ꞌ: mbá xúgíí rí nigíꞌnuꞌ, i̱tha̱án máꞌ nimbáyúu ne̱ rí ma̱gu̱ma-nuwiin xóó ajngáa máján. <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" />Numuu rí mbá xúgíin máꞌ xa̱bo̱ tsí ku̱ra̱tuun ajwa̱nꞌ ná guꞌwá-ñajun jamí i̱ꞌwíin xa̱bo̱, nduyáa̱ mújúu̱n máꞌ rí kru̱ꞌúún géjwa̱nꞌ numuu na̱sngáá ga̱jma̱á numuu Krísto̱. <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />Xúꞌkhue̱n máꞌ mbaꞌiin a̱ngia̱nꞌlóꞌ mangiin, ído̱ nduyáa̱ rí kru̱ꞌúún géjwa̱nꞌ, i̱tha̱án nduye̱e̱ tsiakhe̱ inuu Táta̱ Jesús. Ikhaa jngó nánguá i̱ti̱ñúu̱ ni máꞌ tsímíñúu̱ rí nuthan-raꞌee̱ ajngóo Ana̱ꞌlóꞌ.<verse eid="PHP 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15" />Gakon máꞌ rí mbá tikhuun nune̱ rúꞌkhue̱n ga̱jma̱á numuu rí naxígúu̱n juyeꞌ, kajngó mbuyáa̱ tsáa i̱tha̱án naꞌne. Xómáꞌ tsí mbá jmbu a̱kui̱ín ene̱ rá, nuthan-raꞌee̱ ajngóo Krísto̱ ga̱jma̱á mbá jañii a̱kuíi̱n. <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />Tsí nandúún mbuyáá tsáa i̱tha̱án naꞌne rá, tsíthan-raꞌee̱ ajngóo Krísto̱ numuu rí gakon nanimbúu̱n juyáa̱, rí nuthan-raꞌee̱ ne̱ numuu rí nandúu̱n gúxneꞌ xóó gaꞌkho̱ ná awúun géjwa̱nꞌ.<note caller="+" style="f"><char style="fr" closed="false">1.16 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná nixtiꞌkhu-roꞌoo ajngáa rí naꞌthán ná kíxnuu (16) ga̱jma̱á rí naꞌthán ná kíxnuu (17).</char></note> <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />Xómáꞌ tsí i̱ꞌwíin rá, nuthan-raꞌee̱ numuu rí nandúu̱n juyáa̱ Krísto̱, jamí nduyáa̱ rí gúda̱ꞌ ná géjwa̱nꞌ kajngó ma̱tha̱n-mbáá numuu ajngáa máján. <verse eid="PHP 1:17" /><verse number="18" style="v" sid="PHP 1:18" />Dí lá gáꞌñuu xúꞌkhue̱n rá. Nithán-raꞌa máꞌ tsiakhe̱ ga̱jma̱á numuu Krísto̱, maske máꞌ mbá tikhuun tsíne̱ ga̱jma̱á mbá jañii a̱kui̱ín, jamí i̱ꞌwíin nune̱ ga̱jma̱á mbá jañii a̱kui̱ín. Ga̱jma̱á numuu rúꞌkhue̱n ikhúúnꞌ nadxu a̱kui̱nꞌ, jamí ma̱ꞌdxu a̱kui̱nꞌ i̱tha̱án xóó.<verse eid="PHP 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 1:19" />Nda̱yo̱o̱lo̱ꞌ máꞌ rí Xu̱u̱ꞌ Jesukrísto̱ mambáyíꞌ rí ma̱ga̱jnáaꞌlo̱ꞌ ná géjwa̱nꞌ, jamí xúꞌkhue̱n máꞌ mambáyúu rí nu̱tha̱n-jáñíílaꞌ Ana̱ꞌlóꞌ ga̱jma̱á numuꞌ. <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />Phú naꞌne a̱kui̱nꞌ, jamí gúꞌthu̱u̱n ga̱jma̱á mbá jañii a̱kui̱nꞌ ná inuu Ana̱ꞌlóꞌ rí ma̱xágájnuu nitháan gamakuꞌ. Numuu rí phú naꞌne jañii a̱kui̱nꞌ rí mbá xúgíí mbiꞌi mi̱ꞌthán rí máján numuu Krísto̱ ga̱jma̱á nindxu̱ꞌ. Ikhaa máꞌ gáꞌyoo xí xóó xtáá nda̱ya̱ o xí ma̱ja̱ñúꞌ mbo̱ꞌ. <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />Numuu rí ikhúúnꞌ xtáá ma̱ne̱ rí nandoo Krísto̱, jamí xí nijáñuꞌ rá, i̱tha̱án máꞌ máján ikhaa. <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />I̱ndo̱ó máꞌ numuu rí tsíyo̱o̱ dí ñajuun gára̱ꞌwíílo̱ꞌ, numuu rí xí xtáá nda̱ya̱lo̱ꞌ ná xuwi ríge̱ꞌ, nagaja̱a̱ ñajuun Krísto̱ rí na̱ne̱lo̱ꞌ. <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />Ikhaa jngó nájma̱ máꞌ mingíjyúu rí ma̱ra̱ꞌwíílo̱ꞌ. Naꞌne máꞌ a̱kui̱nꞌ rí ma̱ja̱ñúꞌ kajngó ma̱ꞌgáaꞌ ma̱xtáá ga̱jmi̱ꞌ Krísto̱, numuu rí phú i̱tha̱án máján rúꞌkhue̱n. <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />I̱ndo̱ó máꞌ numuu rí phú i̱tha̱án ndaꞌyóo rí ma̱xtáálo̱ꞌ xóó ga̱jma̱á numalaꞌ. <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />Phú nda̱yo̱o̱ mújúnꞌ máꞌ rí ma̱xájáñuꞌ xóó, jamí ma̱xtáá xóó ga̱jma̱á nindxa̱ꞌlaꞌ mbá xúgiáanꞌlaꞌ, ikhaa jngó ma̱gaja̱a̱ rí nanimba̱laꞌ ju̱ya̱á Ana̱ꞌlóꞌ jamí ma̱juwalaꞌ gagi. <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />Ikhaa jngó, ído̱ gáthangu̱únꞌ ma̱xtáá ga̱jma̱á nindxa̱ꞌlaꞌ mbu̱júꞌ, a̱ꞌkhue̱n rí phú i̱tha̱án ma̱guaꞌdáálaꞌ rí mu̱ne̱-mba̱a̱laꞌ Jesukrísto̱ ga̱jma̱á numuꞌ.<verse eid="PHP 1:26" /></para>
  <para style="s">Ga̱juwalóꞌ xómá naꞌthán ajngáa rawuun Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27" />I̱ndo̱ó máꞌ na̱nda̱ꞌa̱ꞌlaꞌ, a̱ngui̱nꞌ, rí ga̱juwalaꞌ xómá jaꞌyoo ajngáa máján drígo̱o̱ Krísto̱. Ikhaa jngó xí naka gáya̱ꞌlaꞌ o tsíka mbo̱ꞌ, ma̱dxawuun rí kuajún-gúkuálaꞌ ga̱jma̱á mbóó a̱kia̱nꞌlaꞌ, jamí mbá ꞌnduꞌ nu̱ñajunlaꞌ ga̱jma̱á numuu rí nanimba̱ꞌlóꞌ juꞌyáá Ana̱ꞌlóꞌ xómá naꞌthán ajngáa máján. <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />Mu̱xúni̱ꞌñá-mijnálaꞌ rí mune̱-mi̱ꞌñálaꞌ xa̱bo̱ tsí tsíꞌkho̱ a̱kui̱ín juyalaꞌ. Rí xkuaꞌnii e̱ne̱laꞌ, rúꞌkhue̱n nasngájma jaꞌwu rí ikhii̱n ma̱mbá-ri̱gii̱n, xómáꞌ ikháanꞌlaꞌ nasngájma ne̱ rí ma̱jáwiáanꞌlaꞌ gáꞌne Ana̱ꞌlóꞌ. <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />Numuu rí ikháanꞌlaꞌ nijanálaꞌ rí ma̱nimba̱ꞌlaꞌ ju̱ya̱á Krísto̱, xúꞌkhue̱n máꞌ mangaa nijanálaꞌ rí mu̱míni̱ílaꞌ ga̱jma̱á numuu̱. <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" />Ikhaa máꞌ gajmá guáꞌdáá ikháanꞌlaꞌ xómá ndi̱ya̱álaꞌ rí nigúꞌdo̱ꞌ ikhúúnꞌ, jamí nu̱dxawíínlaꞌ rí ikhaa máꞌ gajmá naka-ragúꞌdo̱ꞌ xóó.<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />Ikhaa jngó xúge̱ꞌ rá, xí Krísto̱ naxnáa la tsiakhe̱ a̱kia̱nꞌlaꞌ, xí naꞌni̱i a̱kia̱nꞌlaꞌ numuu rí nandoo̱ jaꞌyalaꞌ, xí ikhaa máꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ xtáa ga̱jma̱á nindxa̱ꞌlaꞌ mbá xúgiáanꞌlaꞌ, xí phú nandalaꞌ ju̱ya̱-mijnálaꞌ, jamí xí nañáwíin a̱kia̱nꞌlaꞌ ju̱ya̱-mijnálaꞌ, <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />gu̱ne̱-gagi̱ilaꞌ mbá jayu a̱kui̱nꞌ xúꞌkhue̱n rá, ga̱jma̱á rí naꞌne mbóó rí nu̱ndxa̱ꞌwa̱-mijnálaꞌ mbá xúgiáanꞌlaꞌ, mbóó máꞌ xó rí nandalaꞌ ju̱ya̱-mijnálaꞌ, jamí mbóó máꞌ rí nu̱ꞌgí-mijnálaꞌ rí mu̱ne̱. <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />Asndo náá rí nu̱ne̱laꞌ, ma̱xátsa̱ña̱ꞌlaꞌ ni máꞌ mu̱xúxu̱xí-mijnálaꞌ. A̱ꞌkhue̱n gakon gu̱ne̱-waba-mijnálaꞌ, jamí mbámbáa gáju̱mu̱u̱ rí i̱tha̱án gíꞌdoo numuu dxájuu xó rí ikhaa. <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />Mu̱xúꞌyálaꞌ i̱ndo̱ó máꞌ rí ndaꞌyálaꞌ ikháanꞌlaꞌ, rí ga̱xná-gamiéjwanlaꞌ rí ndaꞌñúú i̱ꞌwíin mangaa.<verse eid="PHP 2:4" /></para>
  <para style="s">Nixrígú-mina̱ꞌ Krísto̱ jamí waxúxi̱i̱ neꞌne Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 2:5" />Ikhaa jngó, ga̱ꞌne xúꞌkhue̱n a̱kia̱nꞌlaꞌ, xómá rí neꞌne a̱kui̱in Krísto̱ Jesús mangaa:<verse eid="PHP 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PHP 2:6" />Maske máꞌ ikhaa̱ ñajuun Ana̱ꞌlóꞌ,</para>
  <para style="q" vid="PHP 2:6">tándxaꞌwá-mine̱e̱ꞌ rí numuu rí mbéꞌtháa̱n ga̱jmáa̱ Ana̱ꞌlóꞌ, rúꞌkhue̱n ñajuun mbá rí ra̱jáꞌyoo̱ maniñuu̱.<verse eid="PHP 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PHP 2:7" />A̱ꞌkhue̱n gakon niniñuu̱ janíí mbá xúgíí rí ñajuu̱n,</para>
  <para style="q" vid="PHP 2:7">neꞌne-mine̱e̱ꞌ asndo xó mbáa yumbáá waꞌtsi̱i̱.</para>
  <para style="q" vid="PHP 2:7">Jamí neꞌne-mine̱e̱ꞌ xómáꞌ jaꞌñúú xa̱bo̱ numbaa.<verse eid="PHP 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PHP 2:8" />Jamí ído̱ rí ninindxu̱u̱ máꞌ xa̱bo̱ numbaa rá,</para>
  <para style="q" vid="PHP 2:8">nixrígú-mine̱e̱ꞌ máꞌ ikhaa̱,</para>
  <para style="q" vid="PHP 2:8">xúꞌkhue̱n máꞌ ninindxu̱u̱ xa̱bo̱ tsí naꞌne-mbánuu rí nitháán, asndo niniña-mine̱e̱ꞌ rí ma̱ja̱ñúu̱,</para>
  <para style="q" vid="PHP 2:8">jamí nijáñuu̱ ná ixe̱ krúsi̱.<verse eid="PHP 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PHP 2:9" />Ikhaa numuu rúꞌkhue̱n Ana̱ꞌlóꞌ mangaa nixúxi̱i̱ rí maphú ma̱gi̱ꞌdoo numuu̱,</para>
  <para style="q" vid="PHP 2:9">jamí nixná-mbiꞌyuu̱ rí ma̱nújngoo-rámuu inuu mbiꞌñúú mbá xúgíin xa̱bo̱.<verse eid="PHP 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PHP 2:10" />Ikhaa jngó ná inuu Jesús, tsí mba̱a̱ mbiꞌyuu,</para>
  <para style="q" vid="PHP 2:10">mu̱sma̱ti̱gu̱ún mbá xúgíin xa̱bo̱,</para>
  <para style="q" vid="PHP 2:10">tsí júwa̱ꞌ ná mikhuíí, jamí ná inuu numbaa, xúꞌkhue̱n máꞌ tsí júwa̱ꞌ ná agoo ju̱ba̱ꞌ.<verse eid="PHP 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PHP 2:11" />A̱ꞌkhue̱n rí jámbi̱in xa̱bo̱ muthan rí Jesukrísto̱ ñajuun Táta̱ Ana̱ꞌlóꞌ,</para>
  <para style="q" vid="PHP 2:11">kajngó xúꞌkhue̱n ma̱gu̱ma-mba̱a̱ Ana̱ꞌlóꞌ Mikhuíí.<verse eid="PHP 2:11" /></para>
  <para style="s">Ga̱nindxa̱ꞌlóꞌ xó mbá agu rí nambiꞌi ná inuu numbaa</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />Ikhaa jngó xúge̱ꞌ rá, a̱ngui̱nꞌ tsáanꞌ nandoꞌ ja̱ya̱ꞌlaꞌ, xómá rí nu̱ne̱-mbáníílaꞌ rí na̱tha̱n ído̱ rí xtáá ná majña̱ꞌlaꞌ, xkuaꞌnii máꞌ gúne̱-mbáníí ído̱ rí ndawu̱ún mangaa. Gu̱snga̱jmálaꞌ rí nijáwiáanꞌlaꞌ ga̱jma̱á majñu̱u̱ xó rí juwalaꞌ, ga̱jma̱á ngamí jamí ga̱ꞌne gamakuáanꞌlaꞌ ná inuu Ana̱ꞌlóꞌ. <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />Numuu rí Ana̱ꞌlóꞌ nagíwa̱nꞌ ná awúun a̱kia̱nꞌlaꞌ rí mu̱ne̱laꞌ rí máján rí nandoo̱ ikhaa̱, jamí ikhaa̱ máꞌ nambáyálaꞌ rí ma̱ꞌnga̱ꞌlaꞌ mu̱ne̱ rúꞌkhue̱n.<verse eid="PHP 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 2:14" />Mbá xúgíí rí nu̱ne̱laꞌ, mu̱xútha̱nlaꞌ rí ra̱máján ga̱jma̱á numuu nimbáa ni máꞌ ma̱xátsa̱ña̱ꞌlaꞌ. <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />A̱ꞌkhue̱n rí ma̱xáríga̱ nimbá rí ra̱máján mi̱ꞌthán ga̱jma̱á numalaꞌ, jamí nda̱a̱ máꞌ aꞌkhánlaꞌ gáꞌne. Ma̱nindxa̱ꞌlaꞌ i̱ji̱in Ana̱ꞌlóꞌ tsí jaꞌwuun júwa̱ꞌ ná majñu̱ú xa̱bo̱ tsí ra̱májíin mbá jayu. Jamí ná majñu̱ú xa̱bo̱ tsúꞌkhue̱n ma̱nindxa̱ꞌlaꞌ agu mba̱ꞌwo̱ rí nambiꞌi-taꞌa ná numbaa. <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />Ninguáná mu̱xúni̱ꞌñáálaꞌ ajngáa rí jayá mbiꞌyalóꞌ, kajngó ído̱ ma̱ꞌkha̱a Krísto̱, phú gagi ma̱xtáá ga̱jma̱á numalaꞌ rí tángrigo̱ꞌ xúgi̱í, jamí táñajun máꞌ xúgi̱í jayu. <verse eid="PHP 2:16" /><verse number="17" style="v" sid="PHP 2:17" />Maske máꞌ ma̱ja̱ñúꞌ kajngó mu̱wa̱a iꞌdiuꞌ ga̱jma̱á tsi̱gi̱jña̱ꞌ rí nu̱xna̱xílaꞌ ná inuu Ana̱ꞌlóꞌ numuu rí nanimba̱ꞌlaꞌ ju̱yáa̱, ikhúúnꞌ nadxu a̱kui̱nꞌ, jamí nandoꞌ rí mbá xúgiáanꞌlaꞌ ma̱ꞌdxu a̱kia̱nꞌlaꞌ ga̱jma̱á nindxu̱ꞌ. <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />Xómáꞌ rí nadxuꞌ ikhúúnꞌ, xúꞌkhue̱n máꞌ jaꞌyoo rí ma̱ꞌdxalaꞌ mangáanꞌlaꞌ.<verse eid="PHP 2:18" /></para>
  <para style="s">Páblo̱ naꞌthán ga̱jma̱á numuu Timotéo̱</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />Gúꞌthu̱u̱n rí Táta̱ Jesús gáꞌne rí ma̱goo ma̱xu̱ꞌmáa wapha máꞌ Timotéo̱ ma̱ꞌga gáꞌyalaꞌ, kajngó ído̱ gádxawuun xáne juwalaꞌ, ma̱ꞌdxu a̱kui̱nꞌ xúꞌkhue̱n rá. <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />Numuu rí ra̱gúꞌdaa i̱mba̱a̱ꞌ xómá Timotéo̱, tsí mbéꞌtháán a̱kui̱in ga̱jmi̱ꞌ, jamí mbá jañii a̱kuii̱n naxná-gamiéjuu̱n rí ma̱juwa-májánlaꞌ. <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />Numuu rí mbá xúgíin nduꞌyá rí nandúún ikhiin, jamí tsíꞌyée̱ rí nandoo Krísto̱ Jesús. <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />Xómáꞌ ikháanꞌlaꞌ ndu̱ya̱álaꞌ máꞌ xáne phú jaꞌnii a̱kuii̱n, jamí ndu̱ya̱álaꞌ rí xómá naꞌne mbáa ada̱ ga̱jma̱á anu̱u̱, xkuaꞌnii niñajwii̱n ga̱jma̱á nindxu̱ꞌ rí ma̱tha̱n-ráꞌa ajngáa máján. <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />Ikhaa jngó gúꞌthu̱u̱n rí ma̱xu̱ꞌmáa̱ inalaꞌ, awúun máꞌ rí nda̱yo̱o̱ xáne na̱ka̱-rambánuu ga̱jma̱á numuꞌ ge̱jyoꞌ. <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />Gúꞌthu̱u̱n ga̱jma̱á mbá jañii a̱kui̱nꞌ rí Táta̱ mambáyíꞌ, kajngó jmínu̱úꞌ máꞌ ma̱ꞌgá gáya̱ꞌlaꞌ wapha.<verse eid="PHP 2:24" /></para>
  <para style="s">Páblo̱ naꞌthán ga̱jma̱á numuu Epafrodíto̱</para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25" />Rí xúge̱ꞌ rá, na̱ju̱mu̱ꞌ rí ndaꞌyóo ma̱xu̱ꞌmáa ma̱ꞌga̱a ga̱jma̱á nindxa̱ꞌlaꞌ Epafrodíto̱, tsí ikháanꞌlaꞌ máꞌ ni̱xu̱ꞌmáa ni̱ꞌkha̱ rí mambáyíꞌ ná rí ndaꞌyóꞌ. Ikhaa̱ ñajuu̱n mbáa dxájuꞌ tsí phú nambáyíꞌ ná awúun ñajun, jamí xa̱ꞌ wíji̱i̱ ga̱jma̱á nindxu̱ꞌ ga̱jma̱á numuu ajngáa máján. <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />Numuu rí ikhaa̱ ra̱ꞌkhá tháán ndaꞌñáaꞌlaꞌ mbá xúgiáanꞌlaꞌ, jamí phú xtáa̱ gaꞌkho̱ numuu rí ni̱dxawíínlaꞌ rí ndiyóo̱ nandii. <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />Gakon máꞌ rí ndiyóo̱ nandii, rí asndo inu ma̱ja̱ñúu̱. I̱ndo̱ó máꞌ numuu rí Ana̱ꞌlóꞌ niñáwíin a̱kui̱in jaꞌyoo̱, jamí asndo mangúúnꞌ máꞌ niñáwíin a̱kuii̱n jaꞌyeꞌ, kajngó ma̱xárigu i̱mba̱ jíná inuu rí jíná máꞌ xtáá. <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />Ikhaa jngó ma̱xu̱ꞌmáa̱ ma̱ꞌgaa̱ mbá nacha̱ jayu ga̱jma̱á nindxa̱ꞌlaꞌ, kajngó ído̱ gúyáa̱laꞌ mbu̱júꞌ, ma̱ꞌdxu a̱kia̱nꞌlaꞌ, xúꞌkhue̱n máꞌ mangúúnꞌ náxáxtáá gaꞌkho̱ guéño. <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />Ikhaa jngó mbá gagi gúdríguíi̱laꞌ numuu rí xa̱bi̱i Ana̱ꞌlóꞌ ñajuu̱n, xúꞌkhue̱n máꞌ gu̱ya̱-makúúnlaꞌ tsí jaꞌñúú xómá ikhaa̱. <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />Numuu rí ga̱jma̱á numuu ñajuun Krísto̱ nixtáa̱ máꞌ rí ma̱ja̱ñúu̱. Maske máꞌ ngamí rí ma̱ja̱ñúu̱, nixná-tíꞌña-mine̱e̱ꞌ rí ma̱ꞌnii̱ ñajun rí tsíꞌngo̱o̱ mu̱ne̱ ikháanꞌlaꞌ ga̱jma̱á numuꞌ.<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s">I̱tha̱án máꞌ gíꞌdoo numuu rí mu̱ꞌne̱-nuwiinlóꞌ Krísto̱</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />Rí i̱mba̱ rí na̱tha̱nꞌlaꞌ, a̱ngui̱nꞌ, ga̱ꞌdxalaꞌ rí mbóó juwalaꞌ gajmiálaꞌ Táta̱ Jesús. Ra̱ꞌkhá gajmá ñajuun ná inuꞌ ikhúúnꞌ rí ma̱tháán ikhaa máꞌ ajngáa mbu̱júꞌ, jamí mbá rí mambáyálaꞌ ñajuun ne̱.<verse eid="PHP 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 3:2" />Gu̱ña̱wa̱n-mijnálaꞌ ná inúú xa̱bo̱ tsí xómá xu̱wánꞌ jaꞌñúú, ikhiin máꞌ tsí ra̱máján ene̱ ñajuun Ana̱ꞌlóꞌ, jamí i̱ndo̱ó nandúu̱n gúru̱thii̱n xuñúú xa̱bo̱. <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />Numuu rí ikháánꞌlóꞌ guaꞌdáálóꞌ máꞌ tsina jndi rí phú gakon, numuu rí nu̱ꞌne̱-mba̱ꞌwi̱i̱lóꞌ Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ Xu̱u̱ꞌ máꞌ ikhaa̱. Ikhaa jngó wéje̱ a̱kia̱nꞌlóꞌ ná inuu Krísto̱ Jesús, jamí nánguá máꞌ wéje̱ a̱kia̱nꞌlóꞌ ná inuu rí na̱ꞌnga̱ꞌlóꞌ nu̱ꞌne̱. <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />Maske máꞌ ikhúúnꞌ mangúúnꞌ ríga̱ numuu rí ma̱we̱je̱ a̱kui̱nꞌ ná inuu mbá xúgíí rúꞌkhue̱n. Xí mbáa na̱ju̱mu̱u̱ rí ríga̱ numuu rí ma̱we̱je̱ a̱kui̱in ná inuu mbá xúgíí rúꞌkhue̱n, i̱wa̱á máꞌ ga̱náꞌyoo rí xkuaꞌnii gáju̱mu̱ꞌ ikhúúnꞌ. <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" />Numuu rí ikhúúnꞌ ni̱gruígú tsina jndi ído̱ nirámuu migiñu mbiꞌi rí ni̱gu̱múú, xúꞌkhue̱n máꞌ xa̱bi̱i Israél ñajunꞌ. Ná rí ri̱jyu̱u̱ꞌ Benjamín ni̱gu̱múú, jamí phú iꞌdiúún i̱ji̱ín xa̱bo̱ ebréo̱ ñajunꞌ. Xómáꞌ rí ga̱jma̱á numuu xtángoo rá, ne̱ne̱-mbánuu ne̱ mbá xúgíí numuu rí xa̱bo̱ fariséo̱ ñajunꞌ. <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" />Phú ninújngoo gíꞌdoo numuu xtángoo i̱yo̱o̱lo̱ꞌ, rí asndo ne̱ne̱-ngíníi tsí nanimbu̱únꞌ juyáá Jesús, jamí asndo nimbáa táꞌthán ga̱jma̱á numuꞌ xí táne̱ rí máján xómáꞌ phú naꞌthán xtángoo.<verse eid="PHP 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 3:7" />I̱ndo̱ó máꞌ numuu rí mbá xúgíí ríge̱ꞌ rí phú ni̱gi̱ꞌdoo numuu ndi̱yo̱o̱lo̱ꞌ, rí xúge̱ꞌ rá, Krísto̱ naꞌne rí mba̱yo̱o̱ rí nda̱a̱ mbá jayu numuu ne̱. <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />Jamí phú gakon máꞌ, mbá xúgíí rúꞌkhue̱n nda̱yo̱o̱lo̱ꞌ rí nda̱a̱ nitháan numuu ne̱, jamí tsíyoo ma̱ꞌne mbéꞌtháán ne̱ ga̱jma̱á rí ma̱ne̱-núwíinlo̱ꞌ i̱tha̱án Krísto̱ Jesús, tsí naꞌthán-ñájwinꞌ. Ga̱jma̱á numuu̱ ikhaa̱ ni̱ni̱ꞌñúu mbá xúgíí rúꞌkhue̱n, jamí na̱ya̱xu̱u̱ ne̱ xómá náska, kajngó ma̱xtáá ga̱jmi̱ꞌ Krísto̱. <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />A̱ꞌkhue̱n rí ma̱xtáá mbóó ga̱jma̱á nindxu̱u̱. Ra̱ꞌkhá numuu rí ikhúúnꞌ ne̱ne̱-mbánuu xtángoo kajngó nánda̱a̱ aꞌkhúnꞌ ná inuu Ana̱ꞌlóꞌ, rí ga̱jma̱á numuu rí nanimbo̱ꞌ ja̱yo̱o̱ Krísto̱. Numuu rí nánda̱a̱ máꞌ aꞌkhánlóꞌ iꞌyoo Ana̱ꞌlóꞌ ga̱jma̱á numuu rí nanimba̱ꞌlóꞌ juꞌyáá Krísto̱. <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />Ni̱ni̱ꞌñúu máꞌ mbá xúgíí rúꞌkhue̱n kajngó ma̱goo ma̱ne̱-núwíinlo̱ꞌ i̱tha̱án Krísto̱, jamí mba̱yo̱o̱ ski̱yu̱u̱ꞌ rí ndiꞌyaa̱ ga̱jma̱á, xúꞌkhue̱n máꞌ ma̱mínu̱u̱ꞌ xómá rí nimínu̱u̱ꞌ ikhaa̱, jamí asndo ma̱goo ma̱ja̱ñúꞌ xómá rí nijáñuu̱ ikhaa̱. <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />Xkuaꞌnii máꞌ gúꞌthu̱u̱n rí mba̱ya̱a mbiꞌyuꞌ mangúúnꞌ.<verse eid="PHP 3:11" /></para>
  <para style="s">Xóó tsíguáꞌnúlóꞌ ná phú jaꞌyoo mu̱guáꞌnúlóꞌ</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />Tsíyoꞌ gátha̱n rí nijrúꞌúún máꞌ inuu mbá xúgíí ni máꞌ na̱nguá káxu̱ún xóó. I̱ndo̱ó máꞌ numuu rí naka máꞌ xúꞌkhue̱n i̱tha̱án inúú numuu rí gúꞌthu̱u̱n rí ma̱xkamaa rí nandoo Ana̱ꞌlóꞌ rí ma̱nindxu̱ꞌ. Numuu rúꞌkhue̱n nixkamúú Krísto̱ Jesús mangaa. <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />A̱ngui̱nꞌ, ni máꞌ ikhúúnꞌ tsítha̱n rí ni̱ꞌngo̱ꞌ máꞌ. I̱ndo̱ó máꞌ numuu rí mbóó rí na̱ne̱lo̱ꞌ: nambumuꞌ ja̱yo̱o̱ mbá xúgíí rí ninguanúu tsu̱di̱í, jamí na̱xna̱-mína̱ꞌ tsiakhe̱ rí ma̱xkamaa rí wéje̱ i̱tha̱án inúú. <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />Naka máꞌ xúꞌkhue̱n kajngó ma̱gánú ná rí jaꞌyoo ma̱gánúlo̱ꞌ, xúꞌkhue̱n máꞌ ma̱goo ma̱gruígú rí maxníꞌ Ana̱ꞌlóꞌ ná mikhuíí. Ikhaa numuu rúꞌkhue̱n nindxaꞌwálóꞌ ga̱jma̱á majñu̱u̱ Krísto̱ Jesús.<verse eid="PHP 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 3:15" />Ikhaa jngó, mbá xúgiáanꞌlóꞌ tsáánꞌ nikhiáanꞌlóꞌ máꞌ ná rí nanimba̱ꞌlóꞌ, xkuaꞌnii gíꞌmaa rí ma̱ju̱ma̱ꞌlóꞌ jayu. Jamí xí mbrúthun i̱ju̱ma̱ꞌlaꞌ rá, Ana̱ꞌlóꞌ masngájma rí ma̱fraꞌa̱ꞌlaꞌ rúꞌkhue̱n mangaa. <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />Rí phú i̱tha̱án gíꞌdoo numuu ñajuun rí mu̱xúni̱ꞌñáá-ru̱ꞌne̱lóꞌ rí ni̱ma̱ñalóꞌ máꞌ.<verse eid="PHP 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17" />A̱ngui̱nꞌ, gu̱ya̱ri̱dáálaꞌ rí na̱ne̱ ikhúúnꞌ, xúꞌkhue̱n máꞌ gu̱ya̱álaꞌ xáne ene̱ tsí nduya̱ri̱dáá máꞌ rí ndu̱ya̱álaꞌ rí nu̱ne̱ ikháanꞌxo̱ꞌ. <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />Numuu rí maphú mbaꞌiin xa̱bo̱ tsí tsíya̱-makuíí rí nijáñuu Krísto̱ ná ixe̱ krúsi̱. Mbaꞌa máꞌ nothon rí xkuaꞌnii ni̱tha̱nꞌlaꞌ, jamí ikhaa máꞌ na̱tha̱nꞌlaꞌ mbu̱júꞌ xúge̱ꞌ, asndo na̱mbi̱ya̱ꞌ rí na̱tha̱nꞌlaꞌ. <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />Ikhiin xa̱bo̱ tsúꞌkhue̱n wéje̱ rí ma̱mbá-ri̱gi̱in. Rí na̱wa̱ꞌa̱ jayu xuñúu̱, rúꞌkhue̱n rí phú nune̱-mba̱a̱, jamí nu̱xu̱xí-mijnée̱ ga̱jma̱á numuu rí jaꞌyoo ma̱ti̱ñúu̱ꞌ gáꞌne. I̱ndo̱ó máꞌ rí ríga̱ ná numbaa ríge̱ꞌ nu̱ndxa̱ꞌwa̱-mijnée̱ ga̱jma̱á numuu. <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />Xómáꞌ ikháánꞌlóꞌ, xa̱bo̱ mikhuíí ñajwanlóꞌ, ná rí guáꞌthi̱ínlóꞌ rí ma̱ꞌkha̱a Táta̱ Jesukrísto̱ tsí naꞌne-jríñáaꞌlóꞌ. <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />Ikhaa̱ mariꞌkhu-ri̱yaa̱ꞌ la xuyalóꞌ rí phú ngíná ge̱jyoꞌ, kajngó ma̱nindxu̱u̱ ne̱ xómá jaꞌnii xuyuu̱ ikhaa̱ rí maphú wáá. Ma̱ꞌnii̱ rúꞌkhue̱n ga̱jma̱á máꞌ tsiakhe̱ rí naꞌthán-ñájuu̱n mbá xúgíí jayu rí ríga̱.<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />Ikhaa jngó xúge̱ꞌ rá a̱ngui̱nꞌ, tsáanꞌ phú nandoꞌ ja̱ya̱ꞌlaꞌ, ra̱ꞌkhá tháán naꞌne a̱kui̱nꞌ rí mba̱ya̱ꞌlaꞌ. Ikháanꞌ nu̱ne̱-gagi̱ilaꞌ xo̱xto̱ꞌ jamí nu̱ne̱laꞌ rí ma̱gi̱xi̱i gamakuꞌ. Ikhaa jngó na̱tha̱nꞌlaꞌ rí ga̱wajún-gúkuálaꞌ ná inuu Táta̱.<verse eid="PHP 4:1" /></para>
  <para style="s">Xáne jaꞌyoo rí ma̱juwalóꞌ</para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />Na̱tha̱n-jáñuu Ebódia̱ ga̱jma̱á Sínti̱ke̱, rí mbóó a̱kuíi̱n gúni̱i̱ ná inuu Ana̱ꞌlóꞌ. <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />Xúꞌkhue̱n máꞌ na̱tha̱n-jáñaaꞌ ikháánꞌ mangáánꞌ, dxájuꞌ tsí jmbii, tsáánꞌ natiajun ga̱jma̱á nindxu̱ꞌ, rí ma̱ta̱mbáñúú nána̱ a̱ngia̱nꞌlóꞌ tsúꞌkhue̱n. Numuu rí ikhii̱n ni̱mbáyíꞌ rí ni̱tha̱n-ráꞌa ajngáa máján, ga̱jma̱á máꞌ Kleménte̱ mangaa jamí i̱ꞌwíin tsí ni̱mbáyíꞌ. Mbá xúgíin tsúꞌkhue̱n ka̱ma máꞌ mbiꞌñúú ná inuu i̱yi̱i̱ꞌ rí ka̱ma mbiꞌñúú xa̱bo̱ tsí ma̱ju̱wá mbá jámuu.<verse eid="PHP 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4" />Ga̱ꞌdxalaꞌ jámba̱ miꞌtsú rí mbóó juwalaꞌ gajmiálaꞌ Táta̱ Jesús. Na̱tha̱nꞌlaꞌ mbu̱júꞌ: ¡Ga̱ꞌdxalaꞌ! <verse eid="PHP 4:4" /><verse number="5" style="v" sid="PHP 4:5" />Májáanꞌlaꞌ jamí gamakuáanꞌlaꞌ gáꞌne ná inúú mbá xúgíin xa̱bo̱, numuu rí inu máꞌ ma̱ꞌkha̱a Táta̱ Jesús.<verse eid="PHP 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PHP 4:6" />Ma̱xáxná-gamiéjwanlaꞌ mbá jayu gáꞌne rí ma̱ri̱gá, a̱ꞌkhue̱n gakon, i̱ndo̱ó máꞌ Ana̱ꞌlóꞌ gútha̱n-jáñíílaꞌ numuu mbá xúgíí rí ndaꞌyálaꞌ, jamí gu̱rígu̱ulaꞌ gamaku ná inuu Ana̱ꞌlóꞌ mangaa. <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />Jamí Ana̱ꞌlóꞌ gáꞌne rí ma̱ꞌne tsímáá a̱kia̱nꞌlaꞌ. Ikhaa tsímáá rí nanújngoo-rámuu rí nafroꞌo̱o̱ xa̱bo̱ numbaa, ikhaa rúꞌkhue̱n gáña̱wu̱u̱n nímia̱ꞌlaꞌ jamí ju̱ma̱ꞌlaꞌ numuu rí mbóó juwalaꞌ gajmiálaꞌ Krísto̱ Jesús.<verse eid="PHP 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8" />I̱mbo̱ó máꞌ rí phú na̱tha̱nꞌlaꞌ rá, a̱ngui̱nꞌ, ikhaa ríge̱ꞌ phú jaꞌyoo rí mu̱ndxa̱ꞌwa̱-mijnálaꞌ numuu: mbá xúgíí rí gakon, mbá xúgíí rí nitiamakuíí, mbá xúgíí rí jmbu, mbá xúgíí rí jaꞌwu, mbá xúgíí rí mitsaan, mbá xúgíí rí máján kri̱ga̱ ajngóo. Gu̱ndxa̱ꞌwa̱-mijnálaꞌ máꞌ xúꞌkhue̱n ga̱jma̱á numuu rí máján jamí mangaa máꞌ rí jaꞌyoo rí mi̱ꞌthán rí máján numuu. <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />Mbá xúgíí rí ni̱sngálaꞌ, jamí rí ni̱ma̱ñalaꞌ, xúꞌkhue̱n máꞌ rí ni̱dxawíínlaꞌ jamí rí ndi̱ya̱álaꞌ rí na̱ne̱ ikhúúnꞌ, ikhaa rúꞌkhue̱n gúne̱laꞌ. Jamí Ana̱ꞌlóꞌ, tsí naꞌne rí ma̱juwalóꞌ tsímáá, ma̱xtáa ga̱jma̱á nindxa̱ꞌlaꞌ.<verse eid="PHP 4:9" /></para>
  <para style="s">Tsi̱gi̱jña̱ꞌ rí nixna xa̱bi̱i Ana̱ꞌlóꞌ tsí júwa̱ꞌ ná xuajen Filípo̱s</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />Ga̱jma̱á numuu Táta̱ maphú nadxu a̱kui̱nꞌ rí ni̱rmáꞌáa̱n a̱kia̱nꞌlaꞌ ju̱yo̱ꞌ mbu̱júꞌ. Na̱ju̱mu̱ꞌ máꞌ rí támbumalaꞌ ju̱yo̱ꞌ nákhí wapha, i̱ndo̱ó numuu rí táxnálaꞌ mbiꞌi rí mu̱mbáyúꞌlaꞌ. <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />Tsítha̱nlo̱ꞌ xí ndaꞌyóꞌ guéño, numuu rí ikhúúnꞌ na̱ma̱ñuꞌ máꞌ naxtáá gagi ga̱jma̱á rí gúꞌdo̱ꞌ, asndo náá máꞌ rí ríga̱. <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />Nda̱yo̱o̱ máꞌ naxtáá awúun rí tsingíná, jamí nda̱yo̱o̱ máꞌ naxtáá awúun rí ríga̱ guéño. Awúun mbá xúgíí rúꞌkhue̱n nika-ra̱ma̱ñuꞌ, rí ma̱kuéꞌtsó asndo ma̱gi̱ꞌmuꞌ jamí rí ma̱xki̱dxu̱ꞌ mangaa. Xúꞌkhue̱n máꞌ ni̱ma̱ñuꞌ rí ma̱gúꞌdo̱ꞌ guéño, jamí mangaa máꞌ rí mba̱ꞌyóꞌ. <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />Mbá xúgíí máꞌ na̱ꞌngo̱ꞌ numuu rí Krísto̱ naxníꞌ tsiakhe̱.<verse eid="PHP 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14" />Xómáꞌ ikháanꞌlaꞌ rá, máján máꞌ ne̱ne̱laꞌ rí ni̱mbáyú-jmáálaꞌ ga̱jma̱á nindxu̱ꞌ ná rí na̱mínu̱u̱ꞌlo̱ꞌ. <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />Jamí ndu̱ya̱á máꞌ mangáanꞌlaꞌ, a̱ngui̱nꞌ xa̱bo̱ Filípo̱s, rí nákhí ni̱gíꞌdu̱u̱n ni̱tha̱n-ráꞌa ajngáa máján, ído̱ rí nigájnuꞌ ná Masedónia̱, nimbá kuthuun tsí nanimbu̱únꞌ juyáá Jesús túmbáyí-jmáá ga̱jma̱á nindxu̱ꞌ, rí i̱ndo̱ó máꞌ ikháanꞌlaꞌ ni̱mbáyúꞌlaꞌ. <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" />Numuu rí asndo nákhí máꞌ xtáálo̱ꞌ ná Tesalóni̱ka̱, mbaꞌa nothon ni̱xu̱ꞌmálaꞌ rí ndaꞌyóꞌ. <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />Tsítha̱n rúꞌkhue̱n kajngó mu̱xnu̱ꞌlaꞌ i̱tha̱án xóó, rí nandoꞌ ñajuun rí ikháanꞌlaꞌ ma̱guaꞌdáálaꞌ i̱tha̱án xóó ná inuu Ana̱ꞌlóꞌ. <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />Ni̱gruígú máꞌ mbá xúgíí rí ndaꞌyóꞌ jamí asndo napíduun e̱ne̱ rí xúge̱ꞌ rá. Gatíí e̱ne̱ numuu ni̱gruígú rí ni̱xu̱ꞌmálaꞌ ga̱jma̱á nindxu̱u̱ Epafrodíto̱. Rí ni̱xu̱ꞌmálaꞌ ñajuun xómá mbá tsi̱gi̱jña̱ꞌ rí phú ndaa thawuun jamí phú na̱ni̱gu̱u̱ꞌ Ana̱ꞌlóꞌ ma̱grui̱gú. <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />Ikhaa jngó mbá xúgíí rí ndaꞌyálaꞌ, Anu̱ꞌ Mikhuíí maxnálaꞌ ne̱ ga̱jma̱á majñu̱u̱ rí phú mitsaan rí gíꞌdoo guéño Krísto̱ Jesús. <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />A̱gu̱ma-mba̱a̱ mbá jámuu mbiꞌi Táta̱ Ana̱ꞌlóꞌ. Xkuaꞌnii gáꞌne.<verse eid="PHP 4:20" /></para>
  <para style="s">Naꞌthángoo Páblo̱</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />Gu̱ra̱xi̱inlaꞌ mbá xúgíin xa̱bi̱i Ana̱ꞌlóꞌ ga̱jma̱á numuu Krísto̱ Jesús. Jamí a̱ngia̱nꞌlóꞌ tsí júwa̱ꞌ ga̱jma̱á nindxu̱ꞌ ge̱jyoꞌ, nu̱ra̱xáa̱nꞌlaꞌ mangii̱n. <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />Xúꞌkhue̱n máꞌ mbá xúgíin xa̱bi̱i Ana̱ꞌlóꞌ nu̱ra̱xáa̱nꞌlaꞌ, i̱wa̱á máꞌ phú nu̱ra̱xáa̱nꞌlaꞌ tsí júwa̱ꞌ ná guꞌwóo Sésa̱r.<verse eid="PHP 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23" />Tátiálóꞌ Jesukrísto̱ gáꞌne-tsakun-rámáaꞌlaꞌ mbá xúgiáanꞌlaꞌ. Xkuaꞌnii gáꞌne.<note caller="+" style="f"><char style="fr" closed="false">4.23 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «Xkuaꞌnii gáꞌne».</char></note><verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>