<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">tcfU (64-2Juan) - Me̱ꞌpha̱a̱ Mañúwi̱ín (Malinaltepec), c1/v13</book>
  <para style="h">2 Juáán</para>
  <para style="toc3">2 Jn</para>
  <para style="toc2">2 Juáán</para>
  <para style="toc1">Riajma̱ i̱yi̱i̱ꞌ rí niꞌtháán Juáán</para>
  <para style="mt2">Riajma̱ i̱yi̱i̱ꞌ rí niꞌtháán</para>
  <para style="mt1">Juáán</para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="s">Juáán naraxi̱in tsí nanimbu̱únꞌ juyáá Jesús</para>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />Ikhúúnꞌ tsúún xa̱bo̱ nikhi̱i̱ ñajunꞌ na̱tháán i̱yi̱i̱ꞌ ríge̱ꞌ ma̱ꞌga inuu nána̱ tsí watraꞌwíi gajmíí i̱ji̱in. Phú gakon rí nandoꞌ ja̱ya̱ꞌlaꞌ. Jamí ra̱ꞌkhá máꞌ i̱ndo̱ó ikhúúnꞌ nandoꞌ ja̱ya̱ꞌlaꞌ, rí mbá xúgíin máꞌ tsí nune̱-nuwiin rí gakon nandúún juyalaꞌ. <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />Nandoꞌ ja̱ya̱ꞌlaꞌ ga̱jma̱á numuu ajngáa gakon rí ríga̱ jayu ga̱jma̱á nindxa̱ꞌlóꞌ xúge̱ꞌ, jamí ma̱ri̱gá ne̱ ga̱jma̱á nindxa̱ꞌlóꞌ asndo mbá jámuu.<verse eid="2JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3" />Ana̱ꞌlóꞌ Mikhuíí ga̱jma̱á Jesukrísto̱, tsí A̱dée̱ máꞌ, gúne̱-tsakun-rámáaꞌlaꞌ, xúꞌkhue̱n máꞌ gáñáwíin a̱kuíi̱n juyalaꞌ jamí guxnalaꞌ rí tsímáá, numuu rí gakon rí nandúu̱n juyalaꞌ.<verse eid="2JN 1:3" /></para>
  <para style="s">Ga̱juwalóꞌ xómá rí niꞌsngáá Krísto̱</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />Maphú nidxu a̱kui̱nꞌ rí ni̱xkamii mbá tikhuun i̱jña̱aꞌ jamí ndi̱yo̱o̱ rí júwe̱e̱ꞌ ná awúun rí gakon, xómá rí niꞌthán-ñájwanlóꞌ Ana̱ꞌlóꞌ Mikhuíí. <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />Rí xúge̱ꞌ rá, phú na̱tha̱n-jáñaaꞌ, nána̱, rí ma̱ga juꞌya-mijnálóꞌ mbá xúguiáánlóꞌ. Ra̱ꞌkhá máꞌ mbá xtángoo rí nuxe̱ꞌ ñajuun rúꞌkhue̱n, rí ikhaa máꞌ rí waꞌthánlóꞌ asndo nákhí ginii jayu. <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />Jamí ríge̱ꞌ ñajuun rí ma̱galóꞌ juꞌya-mijnálóꞌ: rí ma̱juwalóꞌ xómá naꞌthán xtángawoo Ana̱ꞌlóꞌ. Ríge̱ꞌ ñajuun xtángoo: rí ma̱galaꞌ ju̱ya̱-mijnálaꞌ, xómá rí ni̱dxawíínlaꞌ asndo nákhí ginii jayu.<verse eid="2JN 1:6" /></para>
  <para style="s">Mu̱xúdrígúunlóꞌ xa̱bo̱ tsí nune̱-nduwa</para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7" />Numuu rí phú mbaꞌiin xa̱bo̱ tsí nune̱-nduwa ngrigu̱ún ná inuu numbaa, tsí nuthan rí Jesukrísto̱ tánindxu̱u̱ xa̱bo̱ numbaa. Xa̱bo̱ mi̱nduwaa ñajuun tsí naꞌthán rúꞌkhue̱n, xúꞌkhue̱n máꞌ xa̱bo̱ tsí sia̱nꞌ ga̱jma̱á Krísto̱ ñajuu̱n. <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />Gu̱ña̱wa̱n-míjnálaꞌ inúú xa̱bo̱ tsúꞌkhue̱n, ra̱ꞌkhá ma̱ndáti̱ga̱ꞌlaꞌ rí ni̱ñajunlaꞌ ga̱jma̱á numuu, kajngó mbu̱ya̱alaꞌ mbá káxe̱ gamaku rí jaꞌyoo mbu̱ya̱alaꞌ. <verse eid="2JN 1:8" /><verse number="9" style="v" sid="2JN 1:9" />Asndo tsáa tsí na̱ngra̱ꞌaa, jamí na̱nguá xtáa jayu xómá rí niꞌsngáá Krísto̱, ndawa̱a̱ Ana̱ꞌlóꞌ ga̱jma̱á nindxu̱u̱ xa̱bo̱ tsúꞌkhue̱n. Xómáꞌ tsí xtáa jayu xómá rí niꞌsngáá Krísto̱, tsúꞌkhue̱n xtáa Ana̱ꞌlóꞌ jamí A̱dée máꞌ Ana̱ꞌlóꞌ ga̱jma̱á nindxu̱u̱. <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />Xí mbáa na̱ꞌkha̱ gáꞌyalaꞌ, jamí na̱nguá jayá gisngáá drígo̱o̱ Krísto̱, mu̱xúdríguíi̱laꞌ ná guꞌwálaꞌ, ni máꞌ mu̱xútháa̱nꞌlaꞌ: «¡A̱nújngaaꞌ guꞌwáá!». <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />Numuu rí xa̱bo̱ tsí na̱grui̱guíi tsúꞌkhue̱n, mangaa̱ máꞌ naꞌnii̱ rí ra̱máján, xómá rí naꞌne xa̱bo̱ tsúꞌkhue̱n.<verse eid="2JN 1:11" /></para>
  <para style="s">Naꞌthángoo Juáán</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />Gúꞌdo̱ꞌ mbaꞌa guéño rí nandoꞌ ma̱tha̱nꞌlaꞌ, i̱ndo̱ó máꞌ numuu rí tsíyoꞌ gátháán ne̱ ná inuu i̱yi̱i̱ꞌ ríge̱ꞌ. Numuu rí gúꞌthu̱u̱n rí ma̱ꞌgá gáya̱ꞌlaꞌ a̱ꞌkhue̱n, jamí mu̱ꞌthán-mijnálóꞌ ná inalóꞌ, kajngó ma̱ꞌne káxe̱ rí gagi a̱kia̱nꞌlóꞌ.<verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />Nu̱ra̱xi̱ín i̱ji̱in dxuíꞌguáaꞌ, tsí watraꞌwíi. Xkuaꞌnii gáꞌne.<note caller="+" style="f"><char style="fr" closed="false">1.13 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «Xkuaꞌnii gáꞌne».</char></note><verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>