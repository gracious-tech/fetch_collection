  <para style="h">Ephesians</para>
  <para style="toc1">iphiSiNaH patraM</para>
  <para style="toc2">iphiSiNaH</para>
  <para style="toc3">iphiSiNaH</para>
  <para style="mt1">iphiSiNaH patraM</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>IzvarasyEcchayA yIzukhrISTasya prEritaH paula iphiSanagarasthAn pavitrAn khrISTayIzau vizvAsinO lOkAn prati patraM likhati|</para>
  <para style="p">
    <verse number="2" style="v"/>asmAkaM tAtasyEzvarasya prabhO ryIzukhrISTasya cAnugrahaH zAntizca yuSmAsu varttatAM|</para>
  <para style="p">
    <verse number="3" style="v"/>asmAkaM prabhO ryIzOH khrISTasya tAta IzvarO dhanyO bhavatu; yataH sa khrISTEnAsmabhyaM sarvvam AdhyAtmikaM svargIyavaraM dattavAn|</para>
  <para style="p">
    <verse number="4" style="v"/>vayaM yat tasya samakSaM prEmnA pavitrA niSkalagkAzca bhavAmastadarthaM sa jagataH sRSTE pUrvvaM tEnAsmAn abhirOcitavAn, nijAbhilaSitAnurOdhAcca</para>
  <para style="p">
    <verse number="5" style="v"/>yIzunA khrISTEna svasya nimittaM putratvapadE'smAn svakIyAnugrahasya mahattvasya prazaMsArthaM pUrvvaM niyuktavAn|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmAd anugrahAt sa yEna priyatamEna putrENAsmAn anugRhItavAn,</para>
  <para style="p">
    <verse number="7" style="v"/>vayaM tasya zONitEna muktim arthataH pApakSamAM labdhavantaH|</para>
  <para style="p">
    <verse number="8" style="v"/>tasya ya IdRzO'nugrahanidhistasmAt sO'smabhyaM sarvvavidhaM jnjAnaM buddhinjca bAhulyarUpENa vitaritavAn|</para>
  <para style="p">
    <verse number="9" style="v"/>svargapRthivyO ryadyad vidyatE tatsarvvaM sa khrISTE saMgrahISyatIti hitaiSiNA</para>
  <para style="p">
    <verse number="10" style="v"/>tEna kRtO yO manOrathaH sampUrNatAM gatavatsu samayESu sAdhayitavyastamadhi sa svakIyAbhilASasya nigUPhaM bhAvam asmAn jnjApitavAn|</para>
  <para style="p">
    <verse number="11" style="v"/>pUrvvaM khrISTE vizvAsinO yE vayam asmattO yat tasya mahimnaH prazaMsA jAyatE,</para>
  <para style="p">
    <verse number="12" style="v"/>tadarthaM yaH svakIyEcchAyAH mantraNAtaH sarvvANi sAdhayati tasya manOrathAd vayaM khrISTEna pUrvvaM nirUpitAH santO'dhikAriNO jAtAH|</para>
  <para style="p">
    <verse number="13" style="v"/>yUyamapi satyaM vAkyam arthatO yuSmatparitrANasya susaMvAdaM nizamya tasminnEva khrISTE vizvasitavantaH pratijnjAtEna pavitrENAtmanA mudrayEvAgkitAzca|</para>
  <para style="p">
    <verse number="14" style="v"/>yatastasya mahimnaH prakAzAya tEna krItAnAM lOkAnAM mukti ryAvanna bhaviSyati tAvat sa AtmAsmAkam adhikAritvasya satyagkArasya paNasvarUpO bhavati|</para>
  <para style="p">
    <verse number="15" style="v"/>prabhau yIzau yuSmAkaM vizvAsaH sarvvESu pavitralOkESu prEma cAsta iti vArttAM zrutvAhamapi</para>
  <para style="p">
    <verse number="16" style="v"/>yuSmAnadhi nirantaram IzvaraM dhanyaM vadan prArthanAsamayE ca yuSmAn smaran varamimaM yAcAmi|</para>
  <para style="p">
    <verse number="17" style="v"/>asmAkaM prabhO ryIzukhrISTasya tAtO yaH prabhAvAkara IzvaraH sa svakIyatattvajnjAnAya yuSmabhyaM jnjAnajanakam prakAzitavAkyabOdhakanjcAtmAnaM dEyAt|</para>
  <para style="p">
    <verse number="18" style="v"/>yuSmAkaM jnjAnacakSUMSi ca dIptiyuktAni kRtvA tasyAhvAnaM kIdRzyA pratyAzayA sambalitaM pavitralOkAnAM madhyE tEna dattO'dhikAraH kIdRzaH prabhAvanidhi rvizvAsiSu cAsmAsu prakAzamAnasya</para>
  <para style="p">
    <verse number="19" style="v"/>tadIyamahAparAkramasya mahatvaM kIdRg anupamaM tat sarvvaM yuSmAn jnjApayatu|</para>
  <para style="p">
    <verse number="20" style="v"/>yataH sa yasyAH zaktEH prabalatAM khrISTE prakAzayan mRtagaNamadhyAt tam utthApitavAn,</para>
  <para style="p">
    <verse number="21" style="v"/>adhipatitvapadaM zAsanapadaM parAkramO rAjatvanjcEtinAmAni yAvanti padAnIha lOkE paralOkE ca vidyantE tESAM sarvvESAm UrddhvE svargE nijadakSiNapArzvE tam upavEzitavAn,</para>
  <para style="p">
    <verse number="22" style="v"/>sarvvANi tasya caraNayOradhO nihitavAn yA samitistasya zarIraM sarvvatra sarvvESAM pUrayituH pUrakanjca bhavati taM tasyA mUrddhAnaM kRtvA</para>
  <para style="p">
    <verse number="23" style="v"/>sarvvESAm uparyyupari niyuktavAMzca saiva zaktirasmAsvapi tEna prakAzyatE|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>purA yUyam aparAdhaiH pApaizca mRtAH santastAnyAcaranta ihalOkasya saMsArAnusArENAkAzarAjyasyAdhipatim</para>
  <para style="p">
    <verse number="2" style="v"/>arthataH sAmpratam AjnjAlagghivaMzESu karmmakAriNam AtmAnam anvavrajata|</para>
  <para style="p">
    <verse number="3" style="v"/>tESAM madhyE sarvvE vayamapi pUrvvaM zarIrasya manaskAmanAyAnjcEhAM sAdhayantaH svazarIrasyAbhilASAn AcarAma sarvvE'nya iva ca svabhAvataH krOdhabhajanAnyabhavAma|</para>
  <para style="p">
    <verse number="4" style="v"/>kintu karuNAnidhirIzvarO yEna mahAprEmnAsmAn dayitavAn</para>
  <para style="p">
    <verse number="5" style="v"/>tasya svaprEmnO bAhulyAd aparAdhai rmRtAnapyasmAn khrISTEna saha jIvitavAn yatO'nugrahAd yUyaM paritrANaM prAptAH|</para>
  <para style="p">
    <verse number="6" style="v"/>sa ca khrISTEna yIzunAsmAn tEna sArddham utthApitavAn svarga upavEzitavAMzca|</para>
  <para style="p">
    <verse number="7" style="v"/>itthaM sa khrISTEna yIzunAsmAn prati svahitaiSitayA bhAviyugESu svakIyAnugrahasyAnupamaM nidhiM prakAzayitum icchati|</para>
  <para style="p">
    <verse number="8" style="v"/>yUyam anugrahAd vizvAsEna paritrANaM prAptAH, tacca yuSmanmUlakaM nahi kintvIzvarasyaiva dAnaM,</para>
  <para style="p">
    <verse number="9" style="v"/>tat karmmaNAM phalam api nahi, ataH kEnApi na zlAghitavyaM|</para>
  <para style="p">
    <verse number="10" style="v"/>yatO vayaM tasya kAryyaM prAg IzvarENa nirUpitAbhiH satkriyAbhiH kAlayApanAya khrISTE yIzau tEna mRSTAzca|</para>
  <para style="p">
    <verse number="11" style="v"/>purA janmanA bhinnajAtIyA hastakRtaM tvakchEdaM prAptai rlOkaizcAcchinnatvaca itinAmnA khyAtA yE yUyaM tai ryuSmAbhiridaM smarttavyaM</para>
  <para style="p">
    <verse number="12" style="v"/>yat tasmin samayE yUyaM khrISTAd bhinnA isrAyElalOkAnAM sahavAsAd dUrasthAH pratijnjAsambalitaniyamAnAM bahiH sthitAH santO nirAzA nirIzvarAzca jagatyAdhvam iti|</para>
  <para style="p">
    <verse number="13" style="v"/>kintvadhunA khrISTE yIzAvAzrayaM prApya purA dUravarttinO yUyaM khrISTasya zONitEna nikaTavarttinO'bhavata|</para>
  <para style="p">
    <verse number="14" style="v"/>yataH sa EvAsmAkaM sandhiH sa dvayam EkIkRtavAn zatrutArUpiNIM madhyavarttinIM prabhEdakabhittiM bhagnavAn daNPAjnjAyuktaM vidhizAstraM svazarIrENa luptavAMzca|</para>
  <para style="p">
    <verse number="15" style="v"/>yataH sa sandhiM vidhAya tau dvau svasmin EkaM nutanaM mAnavaM karttuM</para>
  <para style="p">
    <verse number="16" style="v"/>svakIyakruzE zatrutAM nihatya tEnaivaikasmin zarIrE tayO rdvayOrIzvarENa sandhiM kArayituM nizcatavAn|</para>
  <para style="p">
    <verse number="17" style="v"/>sa cAgatya dUravarttinO yuSmAn nikaTavarttinO 'smAMzca sandhE rmaggalavArttAM jnjApitavAn|</para>
  <para style="p">
    <verse number="18" style="v"/>yatastasmAd ubhayapakSIyA vayam EkEnAtmanA pituH samIpaM gamanAya sAmarthyaM prAptavantaH|</para>
  <para style="p">
    <verse number="19" style="v"/>ata idAnIM yUyam asamparkIyA vidEzinazca na tiSThanataH pavitralOkaiH sahavAsina Izvarasya vEzmavAsinazcAdhvE|</para>
  <para style="p">
    <verse number="20" style="v"/>aparaM prEritA bhaviSyadvAdinazca yatra bhittimUlasvarUpAstatra yUyaM tasmin mUlE nicIyadhvE tatra ca svayaM yIzuH khrISTaH pradhAnaH kONasthaprastaraH|</para>
  <para style="p">
    <verse number="21" style="v"/>tEna kRtsnA nirmmitiH saMgrathyamAnA prabhOH pavitraM mandiraM bhavituM varddhatE|</para>
  <para style="p">
    <verse number="22" style="v"/>yUyamapi tatra saMgrathyamAnA AtmanEzvarasya vAsasthAnaM bhavatha|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atO hEtO rbhinnajAtIyAnAM yuSmAkaM nimittaM yIzukhrISTasya bandI yaH sO'haM paulO bravImi|</para>
  <para style="p">
    <verse number="2" style="v"/>yuSmadartham IzvarENa mahyaM dattasya varasya niyamaH kIdRzastad yuSmAbhirazrAvIti manyE|</para>
  <para style="p">
    <verse number="3" style="v"/>arthataH pUrvvaM mayA saMkSEpENa yathA likhitaM tathAhaM prakAzitavAkyEnEzvarasya nigUPhaM bhAvaM jnjApitO'bhavaM|</para>
  <para style="p">
    <verse number="4" style="v"/>atO yuSmAbhistat paThitvA khrISTamadhi tasminnigUPhE bhAvE mama jnjAnaM kIdRzaM tad bhOtsyatE|</para>
  <para style="p">
    <verse number="5" style="v"/>pUrvvayugESu mAnavasantAnAstaM jnjApitA nAsan kintvadhunA sa bhAvastasya pavitrAn prEritAn bhaviSyadvAdinazca pratyAtmanA prakAzitO'bhavat;</para>
  <para style="p">
    <verse number="6" style="v"/>arthata Izvarasya zaktEH prakAzAt tasyAnugrahENa yO varO mahyam adAyi tEnAhaM yasya susaMvAdasya paricArakO'bhavaM,</para>
  <para style="p">
    <verse number="7" style="v"/>tadvArA khrISTEna bhinnajAtIyA anyaiH sArddham EkAdhikArA EkazarIrA EkasyAH pratijnjAyA aMzinazca bhaviSyantIti|</para>
  <para style="p">
    <verse number="8" style="v"/>sarvvESAM pavitralOkAnAM kSudratamAya mahyaM varO'yam adAyi yad bhinnajAtIyAnAM madhyE bOdhAgayasya guNanidhEH khrISTasya maggalavArttAM pracArayAmi,</para>
  <para style="p">
    <verse number="9" style="v"/>kAlAvasthAtaH pUrvvasmAcca yO nigUPhabhAva IzvarE gupta AsIt tadIyaniyamaM sarvvAn jnjApayAmi|</para>
  <para style="p">
    <verse number="10" style="v"/>yata Izvarasya nAnArUpaM jnjAnaM yat sAmprataM samityA svargE prAdhAnyaparAkramayuktAnAM dUtAnAM nikaTE prakAzyatE tadarthaM sa yIzunA khrISTEna sarvvANi sRSTavAn|</para>
  <para style="p">
    <verse number="11" style="v"/>yatO vayaM yasmin vizvasya dRPhabhaktyA nirbhayatAm Izvarasya samAgamE sAmarthyanjca</para>
  <para style="p">
    <verse number="12" style="v"/>prAptavantastamasmAkaM prabhuM yIzuM khrISTamadhi sa kAlAvasthAyAH pUrvvaM taM manOrathaM kRtavAn|</para>
  <para style="p">
    <verse number="13" style="v"/>atO'haM yuSmannimittaM duHkhabhOgEna klAntiM yanna gacchAmIti prArthayE yatastadEva yuSmAkaM gauravaM|</para>
  <para style="p">
    <verse number="14" style="v"/>atO hEtOH svargapRthivyOH sthitaH kRtsnO vaMzO yasya nAmnA vikhyAtastam</para>
  <para style="p">
    <verse number="15" style="v"/>asmatprabhO ryIzukhrISTasya pitaramuddizyAhaM jAnunI pAtayitvA tasya prabhAvanidhitO varamimaM prArthayE|</para>
  <para style="p">
    <verse number="16" style="v"/>tasyAtmanA yuSmAkam AntarikapuruSasya zaktE rvRddhiH kriyatAM|</para>
  <para style="p">
    <verse number="17" style="v"/>khrISTastu vizvAsEna yuSmAkaM hRdayESu nivasatu| prEmaNi yuSmAkaM baddhamUlatvaM susthiratvanjca bhavatu|</para>
  <para style="p">
    <verse number="18" style="v"/>itthaM prasthatAyA dIrghatAyA gabhIratAyA uccatAyAzca bOdhAya sarvvaiH pavitralOkaiH prApyaM sAmarthyaM yuSmAbhi rlabhyatAM,</para>
  <para style="p">
    <verse number="19" style="v"/>jnjAnAtiriktaM khrISTasya prEma jnjAyatAm Izvarasya sampUrNavRddhiparyyantaM yuSmAkaM vRddhi rbhavatu ca|</para>
  <para style="p">
    <verse number="20" style="v"/>asmAkam antarE yA zaktiH prakAzatE tayA sarvvAtiriktaM karmma kurvvan asmAkaM prArthanAM kalpanAnjcAtikramituM yaH zaknOti</para>
  <para style="p">
    <verse number="21" style="v"/>khrISTayIzunA samitE rmadhyE sarvvESu yugESu tasya dhanyavAdO bhavatu| iti|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atO bandirahaM prabhO rnAmnA yuSmAn vinayE yUyaM yEnAhvAnEnAhUtAstadupayuktarUpENa</para>
  <para style="p">
    <verse number="2" style="v"/>sarvvathA namratAM mRdutAM titikSAM parasparaM pramnA sahiSNutAnjcAcarata|</para>
  <para style="p">
    <verse number="3" style="v"/>praNayabandhanEna cAtmana EैkyaM rakSituM yatadhvaM|</para>
  <para style="p">
    <verse number="4" style="v"/>yUyam EkazarIrA EkAtmAnazca tadvad AhvAnEna yUyam EkapratyAzAprAptayE samAhUtAH|</para>
  <para style="p">
    <verse number="5" style="v"/>yuSmAkam EkaH prabhurEkO vizvAsa EkaM majjanaM, sarvvESAM tAtaH</para>
  <para style="p">
    <verse number="6" style="v"/>sarvvOparisthaH sarvvavyApI sarvvESAM yuSmAkaM madhyavarttI caika Izvara AstE|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu khrISTasya dAnaparimANAnusArAd asmAkam Ekaikasmai vizESO varO'dAyi|</para>
  <para style="p">
    <verse number="8" style="v"/>yathA likhitam AstE, "Urddhvam Aruhya jEtRn sa vijitya bandinO'karOt| tataH sa manujEbhyO'pi svIyAn vyazrANayad varAn||"</para>
  <para style="p">
    <verse number="9" style="v"/>Urddhvam AruhyEtivAkyasyAyamarthaH sa pUrvvaM pRthivIrUpaM sarvvAdhaHsthitaM sthAnam avatIrNavAn;</para>
  <para style="p">
    <verse number="10" style="v"/>yazcAvatIrNavAn sa Eva svargANAm uparyyuparyyArUPhavAn yataH sarvvANi tEna pUrayitavyAni|</para>
  <para style="p">
    <verse number="11" style="v"/>sa Eva ca kAMzcana prEritAn aparAn bhaviSyadvAdinO'parAn susaMvAdapracArakAn aparAn pAlakAn upadEzakAMzca niyuktavAn|</para>
  <para style="p">
    <verse number="12" style="v"/>yAvad vayaM sarvvE vizvAsasyEzvaraputraviSayakasya tattvajnjAnasya caikyaM sampUrNaM puruSarthanjcArthataH khrISTasya sampUrNaparimANasya samaM parimANaM na prApnumastAvat</para>
  <para style="p">
    <verse number="13" style="v"/>sa paricaryyAkarmmasAdhanAya khrISTasya zarIrasya niSThAyai ca pavitralOkAnAM siddhatAyAstAdRzam upAyaM nizcitavAn|</para>
  <para style="p">
    <verse number="14" style="v"/>ataEva mAnuSANAM cAturItO bhramakadhUrttatAyAzchalAcca jAtEna sarvvENa zikSAvAyunA vayaM yad bAlakA iva dOlAyamAnA na bhrAmyAma ityasmAbhi ryatitavyaM,</para>
  <para style="p">
    <verse number="15" style="v"/>prEmnA satyatAm AcaradbhiH sarvvaviSayE khrISTam uddizya varddhitavyanjca, yataH sa mUrddhA,</para>
  <para style="p">
    <verse number="16" style="v"/>tasmAccaikaikasyAggasya svasvaparimANAnusArENa sAhAyyakaraNAd upakArakaiH sarvvaiH sandhibhiH kRtsnasya zarIrasya saMyOgE sammilanE ca jAtE prEmnA niSThAM labhamAnaM kRtsnaM zarIraM vRddhiM prApnOti|</para>
  <para style="p">
    <verse number="17" style="v"/>yuSmAn ahaM prabhunEdaM bravImyAdizAmi ca, anyE bhinnajAtIyA iva yUyaM pUna rmAcarata|</para>
  <para style="p">
    <verse number="18" style="v"/>yatastE svamanOmAyAm AcarantyAntarikAjnjAnAt mAnasikakAThinyAcca timirAvRtabuddhaya IzvarIyajIvanasya bagIrbhUtAzca bhavanti,</para>
  <para style="p">
    <verse number="19" style="v"/>svAn caitanyazUnyAn kRtvA ca lObhEna sarvvavidhAzaucAcaraNAya lampaTatAyAM svAn samarpitavantaH|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu yUyaM khrISTaM na tAdRzaM paricitavantaH,</para>
  <para style="p">
    <verse number="21" style="v"/>yatO yUyaM taM zrutavantO yA satyA zikSA yIzutO labhyA tadanusArAt tadIyOpadEzaM prAptavantazcEti manyE|</para>
  <para style="p">
    <verse number="22" style="v"/>tasmAt pUrvvakAlikAcArakArI yaH purAtanapuruSO mAyAbhilASai rnazyati taM tyaktvA yuSmAbhi rmAnasikabhAvO nUtanIkarttavyaH,</para>
  <para style="p">
    <verse number="23" style="v"/>yO navapuruSa IzvarAnurUpENa puNyEna satyatAsahitEna</para>
  <para style="p">
    <verse number="24" style="v"/>dhArmmikatvEna ca sRSTaH sa Eva paridhAtavyazca|</para>
  <para style="p">
    <verse number="25" style="v"/>atO yUyaM sarvvE mithyAkathanaM parityajya samIpavAsibhiH saha satyAlApaM kuruta yatO vayaM parasparam aggapratyaggA bhavAmaH|</para>
  <para style="p">
    <verse number="26" style="v"/>aparaM krOdhE jAtE pApaM mA kurudhvam, azAntE yuSmAkaM rOSEsUryyO'staM na gacchatu|</para>
  <para style="p">
    <verse number="27" style="v"/>aparaM zayatAnE sthAnaM mA datta|</para>
  <para style="p">
    <verse number="28" style="v"/>cOraH punazcairyyaM na karOtu kintu dInAya dAnE sAmarthyaM yajjAyatE tadarthaM svakarAbhyAM sadvRttyA parizramaM karOtu|</para>
  <para style="p">
    <verse number="29" style="v"/>aparaM yuSmAkaM vadanEbhyaH kO'pi kadAlApO na nirgacchatu, kintu yEna zrOturupakArO jAyatE tAdRzaH prayOjanIyaniSThAyai phaladAyaka AlApO yuSmAkaM bhavatu|</para>
  <para style="p">
    <verse number="30" style="v"/>aparanjca yUyaM muktidinaparyyantam Izvarasya yEna pavitrENAtmanA mudrayAgkitA abhavata taM zOkAnvitaM mA kuruta|</para>
  <para style="p">
    <verse number="31" style="v"/>aparaM kaTuvAkyaM rOSaH kOSaH kalahO nindA sarvvavidhadvESazcaitAni yuSmAkaM madhyAd dUrIbhavantu|</para>
  <para style="p">
    <verse number="32" style="v"/>yUyaM parasparaM hitaiSiNaH kOmalAntaHkaraNAzca bhavata| aparam IzvaraH khrISTEna yadvad yuSmAkaM dOSAn kSamitavAn tadvad yUyamapi parasparaM kSamadhvaM|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atO yUyaM priyabAlakA ivEzvarasyAnukAriNO bhavata,</para>
  <para style="p">
    <verse number="2" style="v"/>khrISTa iva prEmAcAraM kuruta ca, yataH sO'smAsu prEma kRtavAn asmAkaM vinimayEna cAtmanivEdanaM kRtvA grAhyasugandhArthakam upahAraM balinjcEzvarAca dattavAn|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu vEzyAgamanaM sarvvavidhAzaucakriyA lObhazcaitESAm uccAraNamapi yuSmAkaM madhyE na bhavatu, EtadEva pavitralOkAnAm ucitaM|</para>
  <para style="p">
    <verse number="4" style="v"/>aparaM kutsitAlApaH pralApaH zlESOktizca na bhavatu yata EtAnyanucitAni kintvIzvarasya dhanyavAdO bhavatu|</para>
  <para style="p">
    <verse number="5" style="v"/>vEzyAgAmyazaucAcArI dEvapUjaka iva gaNyO lObhI caitESAM kOSi khrISTasya rAjyE'rthata Izvarasya rAjyE kamapyadhikAraM na prApsyatIti yuSmAbhiH samyak jnjAyatAM|</para>
  <para style="p">
    <verse number="6" style="v"/>anarthakavAkyEna kO'pi yuSmAn na vanjcayatu yatastAdRgAcArahEtOranAjnjAgrAhiSu lOkESvIzvarasya kOpO varttatE|</para>
  <para style="p">
    <verse number="7" style="v"/>tasmAd yUyaM taiH sahabhAginO na bhavata|</para>
  <para style="p">
    <verse number="8" style="v"/>pUrvvaM yUyam andhakArasvarUpA AdhvaM kintvidAnIM prabhunA dIptisvarUpA bhavatha tasmAd dIptEH santAnA iva samAcarata|</para>
  <para style="p">
    <verse number="9" style="v"/>dIptE ryat phalaM tat sarvvavidhahitaiSitAyAM dharmmE satyAlApE ca prakAzatE|</para>
  <para style="p">
    <verse number="10" style="v"/>prabhavE yad rOcatE tat parIkSadhvaM|</para>
  <para style="p">
    <verse number="11" style="v"/>yUyaM timirasya viphalakarmmaNAm aMzinO na bhUtvA tESAM dOSitvaM prakAzayata|</para>
  <para style="p">
    <verse number="12" style="v"/>yatastE lOkA rahami yad yad Acaranti taduccAraNam api lajjAjanakaM|</para>
  <para style="p">
    <verse number="13" style="v"/>yatO dIptyA yad yat prakAzyatE tat tayA cakAsyatE yacca cakAsti tad dIptisvarUpaM bhavati|</para>
  <para style="p">
    <verse number="14" style="v"/>EtatkAraNAd uktam AstE, "hE nidrita prabudhyasva mRtEbhyazcOtthitiM kuru| tatkRtE sUryyavat khrISTaH svayaM tvAM dyOtayiSyati|"</para>
  <para style="p">
    <verse number="15" style="v"/>ataH sAvadhAnA bhavata, ajnjAnA iva mAcarata kintu jnjAnina iva satarkam Acarata|</para>
  <para style="p">
    <verse number="16" style="v"/>samayaM bahumUlyaM gaNayadhvaM yataH kAlA abhadrAH|</para>
  <para style="p">
    <verse number="17" style="v"/>tasmAd yUyam ajnjAnA na bhavata kintu prabhOrabhimataM kiM tadavagatA bhavata|</para>
  <para style="p">
    <verse number="18" style="v"/>sarvvanAzajanakEna surApAnEna mattA mA bhavata kintvAtmanA pUryyadhvaM|</para>
  <para style="p">
    <verse number="19" style="v"/>aparaM gItai rgAnaiH pAramArthikakIrttanaizca parasparam AlapantO manasA sArddhaM prabhum uddizya gAyata vAdayata ca|</para>
  <para style="p">
    <verse number="20" style="v"/>sarvvadA sarvvaviSayE'smatprabhO yIzOH khrISTasya nAmnA tAtam IzvaraM dhanyaM vadata|</para>
  <para style="p">
    <verse number="21" style="v"/>yUyam IzvarAd bhItAH santa anyE'parESAM vazIbhUtA bhavata|</para>
  <para style="p">
    <verse number="22" style="v"/>hE yOSitaH, yUyaM yathA prabhOstathA svasvasvAminO vazaggatA bhavata|</para>
  <para style="p">
    <verse number="23" style="v"/>yataH khrISTO yadvat samitE rmUrddhA zarIrasya trAtA ca bhavati tadvat svAmI yOSitO mUrddhA|</para>
  <para style="p">
    <verse number="24" style="v"/>ataH samiti ryadvat khrISTasya vazIbhUtA tadvad yOSidbhirapi svasvasvAminO vazatA svIkarttavyA|</para>
  <para style="p">
    <verse number="25" style="v"/>aparanjca hE puruSAH, yUyaM khrISTa iva svasvayOSitsu prIyadhvaM|</para>
  <para style="p">
    <verse number="26" style="v"/>sa khrISTO'pi samitau prItavAn tasyAH kRtE ca svaprANAn tyaktavAn yataH sa vAkyE jalamajjanEna tAM pariSkRtya pAvayitum</para>
  <para style="p">
    <verse number="27" style="v"/>aparaM tilakavalyAdivihInAM pavitrAM niSkalagkAnjca tAM samitiM tEjasvinIM kRtvA svahastE samarpayitunjcAbhilaSitavAn|</para>
  <para style="p">
    <verse number="28" style="v"/>tasmAt svatanuvat svayOSiti prEmakaraNaM puruSasyOcitaM, yEna svayOSiti prEma kriyatE tEnAtmaprEma kriyatE|</para>
  <para style="p">
    <verse number="29" style="v"/>kO'pi kadApi na svakIyAM tanum RtIyitavAn kintu sarvvE tAM vibhrati puSNanti ca| khrISTO'pi samitiM prati tadEva karOti,</para>
  <para style="p">
    <verse number="30" style="v"/>yatO vayaM tasya zarIrasyAggAni mAMsAsthIni ca bhavAmaH|</para>
  <para style="p">
    <verse number="31" style="v"/>EtadarthaM mAnavaH svamAtApitarOै parityajya svabhAryyAyAm AsaMkSyati tau dvau janAvEkAggau bhaviSyataH|</para>
  <para style="p">
    <verse number="32" style="v"/>EtannigUPhavAkyaM gurutaraM mayA ca khrISTasamitI adhi tad ucyatE|</para>
  <para style="p">
    <verse number="33" style="v"/>ataEva yuSmAkam EkaikO jana Atmavat svayOSiti prIyatAM bhAryyApi svAminaM samAdarttuM yatatAM|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>hE bAlakAH, yUyaM prabhum uddizya pitrOrAjnjAgrAhiNO bhavata yatastat nyAyyaM|</para>
  <para style="p">
    <verse number="2" style="v"/>tvaM nijapitaraM mAtaranjca sammanyasvEti yO vidhiH sa pratijnjAyuktaH prathamO vidhiH</para>
  <para style="p">
    <verse number="3" style="v"/>phalatastasmAt tava kalyANaM dEzE ca dIrghakAlam Ayu rbhaviSyatIti|</para>
  <para style="p">
    <verse number="4" style="v"/>aparaM hE pitaraH, yUyaM svabAlakAn mA rOSayata kintu prabhO rvinItyAdEzAbhyAM tAn vinayata|</para>
  <para style="p">
    <verse number="5" style="v"/>hE dAsAH, yUyaM khrISTam uddizya sabhayAH kampAnvitAzca bhUtvA saralAntaHkaraNairaihikaprabhUnAm AjnjAgrAhiNO bhavata|</para>
  <para style="p">
    <verse number="6" style="v"/>dRSTigOcarIyaparicaryyayA mAnuSEbhyO rOcituM mA yatadhvaM kintu khrISTasya dAsA iva niviSTamanObhirIzcarasyEcchAM sAdhayata|</para>
  <para style="p">
    <verse number="7" style="v"/>mAnavAn anuddizya prabhumEvOddizya sadbhAvEna dAsyakarmma kurudhvaM|</para>
  <para style="p">
    <verse number="8" style="v"/>dAsamuktayO ryEna yat satkarmma kriyatE tEna tasya phalaM prabhutO lapsyata iti jAnIta ca|</para>
  <para style="p">
    <verse number="9" style="v"/>aparaM hE prabhavaH, yuSmAbhi rbhartsanaM vihAya tAn prati nyAyyAcaraNaM kriyatAM yazca kasyApi pakSapAtaM na karOti yuSmAkamapi tAdRza EkaH prabhuH svargE vidyata iti jnjAyatAM|</para>
  <para style="p">
    <verse number="10" style="v"/>adhikantu hE bhrAtaraH, yUyaM prabhunA tasya vikramayuktazaktyA ca balavantO bhavata|</para>
  <para style="p">
    <verse number="11" style="v"/>yUyaM yat zayatAnazchalAni nivArayituM zaknutha tadartham IzvarIyasusajjAM paridhaddhvaM|</para>
  <para style="p">
    <verse number="12" style="v"/>yataH kEvalaM raktamAMsAbhyAm iti nahi kintu kartRtvaparAkramayuktaistimirarAjyasyEhalOkasyAdhipatibhiH svargOdbhavai rduSTAtmabhirEva sArddham asmAbhi ryuddhaM kriyatE|</para>
  <para style="p">
    <verse number="13" style="v"/>atO hEtO ryUyaM yayA saMkuेlE dinE'vasthAtuM sarvvANi parAjitya dRPhAH sthAtunjca zakSyatha tAm IzvarIyasusajjAM gRhlIta|</para>
  <para style="p">
    <verse number="14" style="v"/>vastutastu satyatvEna zRgkhalEna kaTiM baddhvA puNyEna varmmaNA vakSa AcchAdya</para>
  <para style="p">
    <verse number="15" style="v"/>zAntEH suvArttayA jAtam utsAhaM pAdukAyugalaM padE samarpya tiSThata|</para>
  <para style="p">
    <verse number="16" style="v"/>yEna ca duSTAtmanO'gnibANAn sarvvAn nirvvApayituM zakSyatha tAdRzaM sarvvAcchAdakaM phalakaM vizvAsaM dhArayata|</para>
  <para style="p">
    <verse number="17" style="v"/>zirastraM paritrANam AtmanaH khagganjcEzvarasya vAkyaM dhArayata|</para>
  <para style="p">
    <verse number="18" style="v"/>sarvvasamayE sarvvayAcanEna sarvvaprArthanEna cAtmanA prArthanAM kurudhvaM tadarthaM dRPhAkAgkSayA jAgrataH sarvvESAM pavitralOkAnAM kRtE sadA prArthanAM kurudhvaM|</para>
  <para style="p">
    <verse number="19" style="v"/>ahanjca yasya susaMvAdasya zRgkhalabaddhaH pracArakadUtO'smi tam upayuktEnOtsAhEna pracArayituM yathA zaknuyAM</para>
  <para style="p">
    <verse number="20" style="v"/>tathA nirbhayEna svarENOtsAhEna ca susaMvAdasya nigUPhavAkyapracArAya vaktRाtA yat mahyaM dIyatE tadarthaM mamApi kRtE prArthanAM kurudhvaM|</para>
  <para style="p">
    <verse number="21" style="v"/>aparaM mama yAvasthAsti yacca mayA kriyatE tat sarvvaM yad yuSmAbhi rjnjAyatE tadarthaM prabhunA priyabhrAtA vizvAsyaH paricArakazca tukhikO yuSmAn tat jnjApayiSyati|</para>
  <para style="p">
    <verse number="22" style="v"/>yUyaM yad asmAkam avasthAM jAnItha yuSmAkaM manAMsi ca yat sAntvanAM labhantE tadarthamEvAhaM yuSmAkaM sannidhiM taM prESitavAna|</para>
  <para style="p">
    <verse number="23" style="v"/>aparam IzvaraH prabhu ryIzukhrISTazca sarvvEbhyO bhrAtRbhyaH zAntiM vizvAsasahitaM prEma ca dEyAt|</para>
  <para style="p">
    <verse number="24" style="v"/>yE kEcit prabhau yIzukhrISTE'kSayaM prEma kurvvanti tAn prati prasAdO bhUyAt| tathAstu|</para>
</usx>
