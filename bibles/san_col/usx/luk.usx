  <para style="h">Luke</para>
  <para style="toc1">lUkalikhitaH susaMvAdaH</para>
  <para style="toc2">lUkaH</para>
  <para style="toc3">lUkaH</para>
  <para style="mt1">lUkalikhitaH susaMvAdaH</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>prathamatO yE sAkSiNO vAkyapracArakAzcAsan tE'smAkaM madhyE yadyat sapramANaM vAkyamarpayanti sma</para>
  <para style="p">
    <verse number="2" style="v"/>tadanusAratO'nyEpi bahavastadvRttAntaM racayituM pravRttAH|</para>
  <para style="p">
    <verse number="3" style="v"/>ataEva hE mahAmahimathiyaphil tvaM yA yAH kathA azikSyathAstAsAM dRPhapramANAni yathA prApnOSi</para>
  <para style="p">
    <verse number="4" style="v"/>tadarthaM prathamamArabhya tAni sarvvANi jnjAtvAhamapi anukramAt sarvvavRttAntAn tubhyaM lEkhituM matimakArSam|</para>
  <para style="p">
    <verse number="5" style="v"/>yihUdAdEzIyahErOdnAmakE rAjatvaM kurvvati abIyayAjakasya paryyAyAdhikArI sikhariyanAmaka EkO yAjakO hArONavaMzOdbhavA ilIzEvAkhyA</para>
  <para style="p">
    <verse number="6" style="v"/>tasya jAyA dvAvimau nirdOSau prabhOH sarvvAjnjA vyavasthAzca saMmanya IzvaradRSTau dhArmmikAvAstAm|</para>
  <para style="p">
    <verse number="7" style="v"/>tayOH santAna EkOpi nAsIt, yata ilIzEvA bandhyA tau dvAvEva vRddhAvabhavatAm|</para>
  <para style="p">
    <verse number="8" style="v"/>yadA svaparyyAnukramENa sikhariya IzvAsya samakSaM yAjakIyaM karmma karOti</para>
  <para style="p">
    <verse number="9" style="v"/>tadA yajnjasya dinaparipAyyA paramEzvarasya mandirE pravEzakAlE dhUpajvAlanaM karmma tasya karaNIyamAsIt|</para>
  <para style="p">
    <verse number="10" style="v"/>taddhUpajvAlanakAlE lOkanivahE prArthanAM kartuM bahistiSThati</para>
  <para style="p">
    <verse number="11" style="v"/>sati sikhariyO yasyAM vEdyAM dhUpaM jvAlayati taddakSiNapArzvE paramEzvarasya dUta Eka upasthitO darzanaM dadau|</para>
  <para style="p">
    <verse number="12" style="v"/>taM dRSTvA sikhariya udvivijE zazagkE ca|</para>
  <para style="p">
    <verse number="13" style="v"/>tadA sa dUtastaM babhASE hE sikhariya mA bhaistava prArthanA grAhyA jAtA tava bhAryyA ilIzEvA putraM prasOSyatE tasya nAma yOेhan iti kariSyasi|</para>
  <para style="p">
    <verse number="14" style="v"/>kinjca tvaM sAnandaH saharSazca bhaviSyasi tasya janmani bahava AnandiSyanti ca|</para>
  <para style="p">
    <verse number="15" style="v"/>yatO hEtOH sa paramEzvarasya gOcarE mahAn bhaviSyati tathA drAkSArasaM surAM vA kimapi na pAsyati, aparaM janmArabhya pavitrENAtmanA paripUrNaH</para>
  <para style="p">
    <verse number="16" style="v"/>san isrAyElvaMzIyAn anEkAn prabhOH paramEzvarasya mArgamAnESyati|</para>
  <para style="p">
    <verse number="17" style="v"/>santAnAn prati pitRNAM manAMsi dharmmajnjAnaM pratyanAjnjAgrAhiNazca parAvarttayituM, prabhOH paramEzvarasya sEvArtham EkAM sajjitajAtiM vidhAtunjca sa EliyarUpAtmazaktiprAptastasyAgrE gamiSyati|</para>
  <para style="p">
    <verse number="18" style="v"/>tadA sikhariyO dUtamavAdIt kathamEtad vEtsyAmi? yatOhaM vRddhO mama bhAryyA ca vRddhA|</para>
  <para style="p">
    <verse number="19" style="v"/>tatO dUtaH pratyuvAca pazyEzvarasya sAkSAdvarttI jibrAyElnAmA dUtOhaM tvayA saha kathAM gadituM tubhyamimAM zubhavArttAM dAtunjca prESitaH|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu madIyaM vAkyaM kAlE phaliSyati tat tvayA na pratItam ataH kAraNAd yAvadEva tAni na sEtsyanti tAvat tvaM vaktuMmazaktO mUkO bhava|</para>
  <para style="p">
    <verse number="21" style="v"/>tadAnIM yE yE lOkAH sikhariyamapaikSanta tE madhyEmandiraM tasya bahuvilambAd AzcaryyaM mEnirE|</para>
  <para style="p">
    <verse number="22" style="v"/>sa bahirAgatO yadA kimapi vAkyaM vaktumazaktaH sagkEtaM kRtvA niHzabdastasyau tadA madhyEmandiraM kasyacid darzanaM tEna prAptam iti sarvvE bubudhirE|</para>
  <para style="p">
    <verse number="23" style="v"/>anantaraM tasya sEvanaparyyAyE sampUrNE sati sa nijagEhaM jagAma|</para>
  <para style="p">
    <verse number="24" style="v"/>katipayadinESu gatESu tasya bhAryyA ilIzEvA garbbhavatI babhUva</para>
  <para style="p">
    <verse number="25" style="v"/>pazcAt sA panjcamAsAn saMgOpyAkathayat lOkAnAM samakSaM mamApamAnaM khaNPayituM paramEzvarO mayi dRSTiM pAtayitvA karmmEdRzaM kRtavAn|</para>
  <para style="p">
    <verse number="26" style="v"/>aparanjca tasyA garbbhasya SaSThE mAsE jAtE gAlIlpradEzIyanAsaratpurE</para>
  <para style="p">
    <verse number="27" style="v"/>dAyUdO vaMzIyAya yUSaphnAmnE puruSAya yA mariyamnAmakumArI vAgdattAsIt tasyAH samIpaM jibrAyEl dUta IzvarENa prahitaH|</para>
  <para style="p">
    <verse number="28" style="v"/>sa gatvA jagAda hE IzvarAnugRhItakanyE tava zubhaM bhUyAt prabhuH paramEzvarastava sahAyOsti nArINAM madhyE tvamEva dhanyA|</para>
  <para style="p">
    <verse number="29" style="v"/>tadAnIM sA taM dRSTvA tasya vAkyata udvijya kIdRzaM bhASaNamidam iti manasA cintayAmAsa|</para>
  <para style="p">
    <verse number="30" style="v"/>tatO dUtO'vadat hE mariyam bhayaM mAkArSIH, tvayi paramEzvarasyAnugrahOsti|</para>
  <para style="p">
    <verse number="31" style="v"/>pazya tvaM garbbhaM dhRtvA putraM prasOSyasE tasya nAma yIzuriti kariSyasi|</para>
  <para style="p">
    <verse number="32" style="v"/>sa mahAn bhaviSyati tathA sarvvEbhyaH zrESThasya putra iti khyAsyati; aparaM prabhuH paramEzvarastasya piturdAyUdaH siMhAsanaM tasmai dAsyati;</para>
  <para style="p">
    <verse number="33" style="v"/>tathA sa yAkUbO vaMzOpari sarvvadA rAjatvaM kariSyati, tasya rAjatvasyAntO na bhaviSyati|</para>
  <para style="p">
    <verse number="34" style="v"/>tadA mariyam taM dUtaM babhASE nAhaM puruSasaggaM karOmi tarhi kathamEtat sambhaviSyati?</para>
  <para style="p">
    <verse number="35" style="v"/>tatO dUtO'kathayat pavitra AtmA tvAmAzrAyiSyati tathA sarvvazrESThasya zaktistavOpari chAyAM kariSyati tatO hEtOstava garbbhAd yaH pavitrabAlakO janiSyatE sa Izvaraputra iti khyAtiM prApsyati|</para>
  <para style="p">
    <verse number="36" style="v"/>aparanjca pazya tava jnjAtirilIzEvA yAM sarvvE bandhyAmavadan idAnIM sA vArddhakyE santAnamEkaM garbbhE'dhArayat tasya SaSThamAsObhUt|</para>
  <para style="p">
    <verse number="37" style="v"/>kimapi karmma nAsAdhyam Izvarasya|</para>
  <para style="p">
    <verse number="38" style="v"/>tadA mariyam jagAda, pazya prabhErahaM dAsI mahyaM tava vAkyAnusArENa sarvvamEtad ghaTatAm; ananataraM dUtastasyAH samIpAt pratasthE|</para>
  <para style="p">
    <verse number="39" style="v"/>atha katipayadinAt paraM mariyam tasmAt parvvatamayapradEzIyayihUdAyA nagaramEkaM zIghraM gatvA</para>
  <para style="p">
    <verse number="40" style="v"/>sikhariyayAjakasya gRhaM pravizya tasya jAyAm ilIzEvAM sambOdhyAvadat|</para>
  <para style="p">
    <verse number="41" style="v"/>tatO mariyamaH sambOdhanavAkyE ilIzEvAyAH karNayOH praviSTamAtrE sati tasyA garbbhasthabAlakO nanartta| tata ilIzEvA pavitrENAtmanA paripUrNA satI</para>
  <para style="p">
    <verse number="42" style="v"/>prOccairgaditumArEbhE, yOSitAM madhyE tvamEva dhanyA, tava garbbhasthaH zizuzca dhanyaH|</para>
  <para style="p">
    <verse number="43" style="v"/>tvaM prabhOrmAtA, mama nivEzanE tvayA caraNAvarpitau, mamAdya saubhAgyamEtat|</para>
  <para style="p">
    <verse number="44" style="v"/>pazya tava vAkyE mama karNayOH praviSTamAtrE sati mamOdarasthaH zizurAnandAn nanartta|</para>
  <para style="p">
    <verse number="45" style="v"/>yA strI vyazvasIt sA dhanyA, yatO hEtOstAM prati paramEzvarOktaM vAkyaM sarvvaM siddhaM bhaviSyati|</para>
  <para style="p">
    <verse number="46" style="v"/>tadAnIM mariyam jagAda| dhanyavAdaM parEzasya karOti mAmakaM manaH|</para>
  <para style="p">
    <verse number="47" style="v"/>mamAtmA tArakEzE ca samullAsaM pragacchati|</para>
  <para style="p">
    <verse number="48" style="v"/>akarOt sa prabhu rduSTiM svadAsyA durgatiM prati| pazyAdyArabhya mAM dhanyAM vakSyanti puruSAH sadA|</para>
  <para style="p">
    <verse number="49" style="v"/>yaH sarvvazaktimAn yasya nAmApi ca pavitrakaM| sa Eva sumahatkarmma kRtavAn mannimittakaM|</para>
  <para style="p">
    <verse number="50" style="v"/>yE bibhyati janAstasmAt tESAM santAnapaMktiSu| anukampA tadIyA ca sarvvadaiva sutiSThati|</para>
  <para style="p">
    <verse number="51" style="v"/>svabAhubalatastEna prAkAzyata parAkramaH| manaHkumantraNAsArddhaM vikIryyantE'bhimAninaH|</para>
  <para style="p">
    <verse number="52" style="v"/>siMhAsanagatAllOkAn balinazcAvarOhya saH| padESUccESu lOkAMstu kSudrAn saMsthApayatyapi|</para>
  <para style="p">
    <verse number="53" style="v"/>kSudhitAn mAnavAn dravyairuttamaiH paritarpya saH| sakalAn dhaninO lOkAn visRjEd riktahastakAn|</para>
  <para style="p">
    <verse number="54" style="v"/>ibrAhImi ca tadvaMzE yA dayAsti sadaiva tAM| smRtvA purA pitRNAM nO yathA sAkSAt pratizrutaM|</para>
  <para style="p">
    <verse number="55" style="v"/>isrAyElsEvakastEna tathOpakriyatE svayaM||</para>
  <para style="p">
    <verse number="56" style="v"/>anantaraM mariyam prAyENa mAsatrayam ilIzEvayA sahOSitvA vyAghuyya nijanivEzanaM yayau|</para>
  <para style="p">
    <verse number="57" style="v"/>tadanantaram ilIzEvAyAH prasavakAla upasthitE sati sA putraM prAsOSTa|</para>
  <para style="p">
    <verse number="58" style="v"/>tataH paramEzvarastasyAM mahAnugrahaM kRtavAn Etat zrutvA samIpavAsinaH kuTumbAzcAgatya tayA saha mumudirE|</para>
  <para style="p">
    <verse number="59" style="v"/>tathASTamE dinE tE bAlakasya tvacaM chEttum Etya tasya pitRnAmAnurUpaM tannAma sikhariya iti karttumISuH|</para>
  <para style="p">
    <verse number="60" style="v"/>kintu tasya mAtAkathayat tanna, nAmAsya yOhan iti karttavyam|</para>
  <para style="p">
    <verse number="61" style="v"/>tadA tE vyAharan tava vaMzamadhyE nAmEdRzaM kasyApi nAsti|</para>
  <para style="p">
    <verse number="62" style="v"/>tataH paraM tasya pitaraM sikhariyaM prati sagkEtya papracchuH zizOH kiM nAma kAriSyatE?</para>
  <para style="p">
    <verse number="63" style="v"/>tataH sa phalakamEkaM yAcitvA lilEkha tasya nAma yOhan bhaviSyati| tasmAt sarvvE AzcaryyaM mEnirE|</para>
  <para style="p">
    <verse number="64" style="v"/>tatkSaNaM sikhariyasya jihvAjAPyE'pagatE sa mukhaM vyAdAya spaSTavarNamuccAryya Izvarasya guNAnuvAdaM cakAra|</para>
  <para style="p">
    <verse number="65" style="v"/>tasmAccaturdiksthAH samIpavAsilOkA bhItA EvamEtAH sarvvAH kathA yihUdAyAH parvvatamayapradEzasya sarvvatra pracAritAH|</para>
  <para style="p">
    <verse number="66" style="v"/>tasmAt zrOtArO manaHsu sthApayitvA kathayAmbabhUvuH kIdRzOyaM bAlO bhaviSyati? atha paramEzvarastasya sahAyObhUt|</para>
  <para style="p">
    <verse number="67" style="v"/>tadA yOhanaH pitA sikhariyaH pavitrENAtmanA paripUrNaH san EtAdRzaM bhaviSyadvAkyaM kathayAmAsa|</para>
  <para style="p">
    <verse number="68" style="v"/>isrAyElaH prabhu ryastu sa dhanyaH paramEzvaraH| anugRhya nijAllOkAn sa Eva parimOcayEt|</para>
  <para style="p">
    <verse number="69" style="v"/>vipakSajanahastEbhyO yathA mOcyAmahE vayaM| yAvajjIvanjca dharmmENa sAralyEna ca nirbhayAH|</para>
  <para style="p">
    <verse number="70" style="v"/>sEvAmahai tamEvaikam EtatkAraNamEva ca| svakIyaM supavitranjca saMsmRtya niyamaM sadA|</para>
  <para style="p">
    <verse number="71" style="v"/>kRpayA puruSAn pUrvvAn nikaSArthAttu naH pituH| ibrAhImaH samIpE yaM zapathaM kRtavAn purA|</para>
  <para style="p">
    <verse number="72" style="v"/>tamEva saphalaM karttaM tathA zatrugaNasya ca| RृtIyAkAriNazcaiva karEbhyO rakSaNAya naH|</para>
  <para style="p">
    <verse number="73" style="v"/>sRSTEH prathamataH svIyaiH pavitrai rbhAvivAdibhiH|</para>
  <para style="p">
    <verse number="74" style="v"/>yathOktavAn tathA svasya dAyUdaH sEvakasya tu|</para>
  <para style="p">
    <verse number="75" style="v"/>vaMzE trAtAramEkaM sa samutpAditavAn svayam|</para>
  <para style="p">
    <verse number="76" style="v"/>atO hE bAlaka tvantu sarvvEbhyaH zrESTha Eva yaH| tasyaiva bhAvivAdIti pravikhyAtO bhaviSyasi| asmAkaM caraNAn kSEmE mArgE cAlayituM sadA| EvaM dhvAntE'rthatO mRtyOzchAyAyAM yE tu mAnavAH|</para>
  <para style="p">
    <verse number="77" style="v"/>upaviSTAstu tAnEva prakAzayitumEva hi| kRtvA mahAnukampAM hi yAmEva paramEzvaraH|</para>
  <para style="p">
    <verse number="78" style="v"/>UrdvvAt sUryyamudAyyaivAsmabhyaM prAdAttu darzanaM| tayAnukampayA svasya lOkAnAM pApamOcanE|</para>
  <para style="p">
    <verse number="79" style="v"/>paritrANasya tEbhyO hi jnjAnavizrANanAya ca| prabhO rmArgaM pariSkarttuM tasyAgrAyI bhaviSyasi||</para>
  <para style="p">
    <verse number="80" style="v"/>atha bAlakaH zarIrENa buddhyA ca varddhitumArEbhE; aparanjca sa isrAyElO vaMzIyalOkAnAM samIpE yAvanna prakaTIbhUtastAstAvat prAntarE nyavasat|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparanjca tasmin kAlE rAjyasya sarvvESAM lOkAnAM nAmAni lEkhayitum agastakaisara AjnjApayAmAsa|</para>
  <para style="p">
    <verse number="2" style="v"/>tadanusArENa kurINiyanAmani suriyAdEzasya zAsakE sati nAmalEkhanaM prArEbhE|</para>
  <para style="p">
    <verse number="3" style="v"/>atO hEtO rnAma lEkhituM sarvvE janAH svIyaM svIyaM nagaraM jagmuH|</para>
  <para style="p">
    <verse number="4" style="v"/>tadAnIM yUSaph nAma lEkhituM vAgdattayA svabhAryyayA garbbhavatyA mariyamA saha svayaM dAyUdaH sajAtivaMza iti kAraNAd gAlIlpradEzasya nAsaratnagarAd</para>
  <para style="p">
    <verse number="5" style="v"/>yihUdApradEzasya baitlEhamAkhyaM dAyUdnagaraM jagAma|</para>
  <para style="p">
    <verse number="6" style="v"/>anyacca tatra sthAnE tayOstiSThatOH satO rmariyamaH prasUtikAla upasthitE</para>
  <para style="p">
    <verse number="7" style="v"/>sA taM prathamasutaM prAsOSTa kintu tasmin vAsagRhE sthAnAbhAvAd bAlakaM vastrENa vESTayitvA gOzAlAyAM sthApayAmAsa|</para>
  <para style="p">
    <verse number="8" style="v"/>anantaraM yE kiyantO mESapAlakAH svamESavrajarakSAyai tatpradEzE sthitvA rajanyAM prAntarE prahariNaH karmma kurvvanti,</para>
  <para style="p">
    <verse number="9" style="v"/>tESAM samIpaM paramEzvarasya dUta AgatyOpatasthau; tadA catuSpArzvE paramEzvarasya tEjasaH prakAzitatvAt tE'tizazagkirE|</para>
  <para style="p">
    <verse number="10" style="v"/>tadA sa dUta uvAca mA bhaiSTa pazyatAdya dAyUdaH purE yuSmannimittaM trAtA prabhuH khrISTO'janiSTa,</para>
  <para style="p">
    <verse number="11" style="v"/>sarvvESAM lOkAnAM mahAnandajanakam imaM maggalavRttAntaM yuSmAn jnjApayAmi|</para>
  <para style="p">
    <verse number="12" style="v"/>yUyaM (tatsthAnaM gatvA) vastravESTitaM taM bAlakaM gOzAlAyAM zayanaM drakSyatha yuSmAn pratIdaM cihnaM bhaviSyati|</para>
  <para style="p">
    <verse number="13" style="v"/>dUta imAM kathAM kathitavati tatrAkasmAt svargIyAH pRtanA Agatya kathAm imAM kathayitvEzvarasya guNAnanvavAdiSuH, yathA,</para>
  <para style="p">
    <verse number="14" style="v"/>sarvvOrdvvasthairIzvarasya mahimA samprakAzyatAM| zAntirbhUyAt pRthivyAstu santOSazca narAn prati||</para>
  <para style="p">
    <verse number="15" style="v"/>tataH paraM tESAM sannidhE rdUtagaNE svargaM gatE mESapAlakAH parasparam avEcan Agacchata prabhuH paramEzvarO yAM ghaTanAM jnjApitavAn tasyA yAtharyaM jnjAtuM vayamadhunA baitlEhampuraM yAmaH|</para>
  <para style="p">
    <verse number="16" style="v"/>pazcAt tE tUrNaM vrajitvA mariyamaM yUSaphaM gOzAlAyAM zayanaM bAlakanjca dadRzuH|</para>
  <para style="p">
    <verse number="17" style="v"/>itthaM dRSTvA bAlakasyArthE prOktAM sarvvakathAM tE prAcArayAnjcakruH|</para>
  <para style="p">
    <verse number="18" style="v"/>tatO yE lOkA mESarakSakANAM vadanEbhyastAM vArttAM zuzruvustE mahAzcaryyaM mEnirE|</para>
  <para style="p">
    <verse number="19" style="v"/>kintu mariyam EtatsarvvaghaTanAnAM tAtparyyaM vivicya manasi sthApayAmAsa|</para>
  <para style="p">
    <verse number="20" style="v"/>tatpazcAd dUtavijnjaptAnurUpaM zrutvA dRSTvA ca mESapAlakA Izvarasya guNAnuvAdaM dhanyavAdanjca kurvvANAH parAvRtya yayuH|</para>
  <para style="p">
    <verse number="21" style="v"/>atha bAlakasya tvakchEdanakAlE'STamadivasE samupasthitE tasya garbbhasthitEH purvvaM svargIyadUtO yathAjnjApayat tadanurUpaM tE tannAmadhEyaM yIzuriti cakrirE|</para>
  <para style="p">
    <verse number="22" style="v"/>tataH paraM mUsAlikhitavyavasthAyA anusArENa mariyamaH zucitvakAla upasthitE,</para>
  <para style="p">
    <verse number="23" style="v"/>"prathamajaH sarvvaH puruSasantAnaH paramEzvarE samarpyatAM," iti paramEzvarasya vyavasthayA</para>
  <para style="p">
    <verse number="24" style="v"/>yIzuM paramEzvarE samarpayitum zAstrIyavidhyuktaM kapOtadvayaM pArAvatazAvakadvayaM vA baliM dAtuM tE taM gRhItvA yirUzAlamam AyayuH|</para>
  <para style="p">
    <verse number="25" style="v"/>yirUzAlampuranivAsI zimiyOnnAmA dhArmmika Eka AsIt sa isrAyElaH sAntvanAmapEkSya tasthau kinjca pavitra AtmA tasminnAvirbhUtaH|</para>
  <para style="p">
    <verse number="26" style="v"/>aparaM prabhuNA paramEzvarENAbhiSiktE trAtari tvayA na dRSTE tvaM na mariSyasIti vAkyaM pavitrENa AtmanA tasma prAkathyata|</para>
  <para style="p">
    <verse number="27" style="v"/>aparanjca yadA yIzOH pitA mAtA ca tadarthaM vyavasthAnurUpaM karmma karttuM taM mandiram AninyatustadA</para>
  <para style="p">
    <verse number="28" style="v"/>zimiyOn Atmana AkarSaNEna mandiramAgatya taM krOPE nidhAya Izvarasya dhanyavAdaM kRtvA kathayAmAsa, yathA,</para>
  <para style="p">
    <verse number="29" style="v"/>hE prabhO tava dAsOyaM nijavAkyAnusArataH| idAnIntu sakalyANO bhavatA saMvisRjyatAm|</para>
  <para style="p">
    <verse number="30" style="v"/>yataH sakaladEzasya dIptayE dIptirUpakaM|</para>
  <para style="p">
    <verse number="31" style="v"/>isrAyElIyalOkasya mahAgauravarUpakaM|</para>
  <para style="p">
    <verse number="32" style="v"/>yaM trAyakaM janAnAntu sammukhE tvamajIjanaH| saEva vidyatE'smAkaM dhravaM nayananagOcarE||</para>
  <para style="p">
    <verse number="33" style="v"/>tadAnIM tEnOktA EtAH sakalAH kathAH zrutvA tasya mAtA yUSaph ca vismayaM mEnAtE|</para>
  <para style="p">
    <verse number="34" style="v"/>tataH paraM zimiyOn tEbhya AziSaM dattvA tanmAtaraM mariyamam uvAca, pazya isrAyElO vaMzamadhyE bahUnAM pAtanAyOtthApanAya ca tathA virOdhapAtraM bhavituM, bahUnAM guptamanOgatAnAM prakaTIkaraNAya bAlakOyaM niyuktOsti|</para>
  <para style="p">
    <verse number="35" style="v"/>tasmAt tavApi prANAH zUlEna vyatsyantE|</para>
  <para style="p">
    <verse number="36" style="v"/>aparanjca AzErasya vaMzIyaphinUyElO duhitA hannAkhyA atijaratI bhaviSyadvAdinyEkA yA vivAhAt paraM sapta vatsarAn patyA saha nyavasat tatO vidhavA bhUtvA caturazItivarSavayaHparyyanataM</para>
  <para style="p">
    <verse number="37" style="v"/>mandirE sthitvA prArthanOpavAsairdivAnizam Izvaram asEvata sApi strI tasmin samayE mandiramAgatya</para>
  <para style="p">
    <verse number="38" style="v"/>paramEzvarasya dhanyavAdaM cakAra, yirUzAlampuravAsinO yAvantO lOkA muktimapEkSya sthitAstAn yIzOrvRttAntaM jnjApayAmAsa|</para>
  <para style="p">
    <verse number="39" style="v"/>itthaM paramEzvarasya vyavasthAnusArENa sarvvESu karmmasu kRtESu tau punazca gAlIlO nAsaratnAmakaM nijanagaraM pratasthAtE|</para>
  <para style="p">
    <verse number="40" style="v"/>tatpazcAd bAlakaH zarIrENa vRddhimEtya jnjAnEna paripUrNa AtmanA zaktimAMzca bhavitumArEbhE tathA tasmin IzvarAnugrahO babhUva|</para>
  <para style="p">
    <verse number="41" style="v"/>tasya pitA mAtA ca prativarSaM nistArOtsavasamayE yirUzAlamam agacchatAm|</para>
  <para style="p">
    <verse number="42" style="v"/>aparanjca yIzau dvAdazavarSavayaskE sati tau parvvasamayasya rItyanusArENa yirUzAlamaM gatvA</para>
  <para style="p">
    <verse number="43" style="v"/>pArvvaNaM sampAdya punarapi vyAghuyya yAtaH kintu yIzurbAlakO yirUzAlami tiSThati| yUSaph tanmAtA ca tad aviditvA</para>
  <para style="p">
    <verse number="44" style="v"/>sa saggibhiH saha vidyata Etacca budvvA dinaikagamyamArgaM jagmatuH| kintu zESE jnjAtibandhUnAM samIpE mRgayitvA taduddEेzamaprApya</para>
  <para style="p">
    <verse number="45" style="v"/>tau punarapi yirUzAlamam parAvRtyAgatya taM mRgayAnjcakratuH|</para>
  <para style="p">
    <verse number="46" style="v"/>atha dinatrayAt paraM paNPitAnAM madhyE tESAM kathAH zRNvan tattvaM pRcchaMzca mandirE samupaviSTaH sa tAbhyAM dRSTaH|</para>
  <para style="p">
    <verse number="47" style="v"/>tadA tasya buddhyA pratyuttaraizca sarvvE zrOtArO vismayamApadyantE|</para>
  <para style="p">
    <verse number="48" style="v"/>tAdRzaM dRSTvA tasya janakO jananI ca camaccakratuH kinjca tasya mAtA tamavadat, hE putra, kathamAvAM pratItthaM samAcarastvam? pazya tava pitAhanjca zOkAkulau santau tvAmanvicchAvaH sma|</para>
  <para style="p">
    <verse number="49" style="v"/>tataH sOvadat kutO mAm anvaicchataM? piturgRhE mayA sthAtavyam Etat kiM yuvAbhyAM na jnjAyatE?</para>
  <para style="p">
    <verse number="50" style="v"/>kintu tau tasyaitadvAkyasya tAtparyyaM bOddhuM nAzaknutAM|</para>
  <para style="p">
    <verse number="51" style="v"/>tataH paraM sa tAbhyAM saha nAsarataM gatvA tayOrvazIbhUtastasthau kintu sarvvA EtAH kathAstasya mAtA manasi sthApayAmAsa|</para>
  <para style="p">
    <verse number="52" style="v"/>atha yIzO rbuddhiH zarIranjca tathA tasmin Izvarasya mAnavAnAnjcAnugrahO varddhitum ArEbhE|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM tibiriyakaisarasya rAjatvasya panjcadazE vatsarE sati yadA pantIyapIlAtO yihUdAdEzAdhipati rhErOd tu gAlIlpradEzasya rAjA philipanAmA tasya bhrAtA tu yitUriyAyAstrAkhOnItiyApradEzasya ca rAjAsIt luSAnIyanAmA avilInIdEzasya rAjAsIt</para>
  <para style="p">
    <verse number="2" style="v"/>hAnan kiyaphAzcEmau pradhAnayAjAkAvAstAM tadAnIM sikhariyasya putrAya yOhanE madhyEprAntaram Izvarasya vAkyE prakAzitE sati</para>
  <para style="p">
    <verse number="3" style="v"/>sa yarddana ubhayataTapradEzAn samEtya pApamOcanArthaM manaHparAvarttanasya cihnarUpaM yanmajjanaM tadIyAH kathAH sarvvatra pracArayitumArEbhE|</para>
  <para style="p">
    <verse number="4" style="v"/>yizayiyabhaviSyadvaktRgranthE yAdRzI lipirAstE yathA, paramEzasya panthAnaM pariSkuruta sarvvataH| tasya rAjapathanjcaiva samAnaM kurutAdhunA|</para>
  <para style="p">
    <verse number="5" style="v"/>kAriSyantE samucchrAyAH sakalA nimnabhUmayaH| kAriSyantE natAH sarvvE parvvatAzcOpaparvvatAH| kAriSyantE ca yA vakrAstAH sarvvAH saralA bhuvaH| kAriSyantE samAnAstA yA uccanIcabhUmayaH|</para>
  <para style="p">
    <verse number="6" style="v"/>IzvarENa kRtaM trANaM drakSyanti sarvvamAnavAH| ityEtat prAntarE vAkyaM vadataH kasyacid ravaH||</para>
  <para style="p">
    <verse number="7" style="v"/>yE yE lOkA majjanArthaM bahirAyayustAn sOvadat rE rE sarpavaMzA AgAminaH kOpAt palAyituM yuSmAn kazcEtayAmAsa?</para>
  <para style="p">
    <verse number="8" style="v"/>tasmAd ibrAhIm asmAkaM pitA kathAmIdRzIM manObhi rna kathayitvA yUyaM manaHparivarttanayOgyaM phalaM phalata; yuSmAnahaM yathArthaM vadAmi pASANEbhya EtEbhya Izvara ibrAhImaH santAnOtpAdanE samarthaH|</para>
  <para style="p">
    <verse number="9" style="v"/>aparanjca tarumUlE'dhunApi parazuH saMlagnOsti yastaruruttamaM phalaM na phalati sa chidyatE'gnau nikSipyatE ca|</para>
  <para style="p">
    <verse number="10" style="v"/>tadAnIM lOkAstaM papracchustarhi kiM karttavyamasmAbhiH?</para>
  <para style="p">
    <verse number="11" style="v"/>tataH sOvAdIt yasya dvE vasanE vidyEtE sa vastrahInAyaikaM vitaratu kiMnjca yasya khAdyadravyaM vidyatE sOpi tathaiva karOtu|</para>
  <para style="p">
    <verse number="12" style="v"/>tataH paraM karasanjcAyinO majjanArtham Agatya papracchuH hE gurO kiM karttavyamasmAbhiH?</para>
  <para style="p">
    <verse number="13" style="v"/>tataH sOkathayat nirUpitAdadhikaM na gRhlita|</para>
  <para style="p">
    <verse number="14" style="v"/>anantaraM sEnAgaNa Etya papraccha kimasmAbhi rvA karttavyam? tataH sObhidadhE kasya kAmapi hAniM mA kArSTa tathA mRSApavAdaM mA kuruta nijavEtanEna ca santuSya tiSThata|</para>
  <para style="p">
    <verse number="15" style="v"/>aparanjca lOkA apEkSayA sthitvA sarvvEpIti manObhi rvitarkayAnjcakruH, yOhanayam abhiSiktastrAtA na vEti?</para>
  <para style="p">
    <verse number="16" style="v"/>tadA yOhan sarvvAn vyAjahAra, jalE'haM yuSmAn majjayAmi satyaM kintu yasya pAdukAbandhanaM mOcayitumapi na yOgyOsmi tAdRza EkO mattO gurutaraH pumAn Eti, sa yuSmAn vahnirUpE pavitra Atmani majjayiSyati|</para>
  <para style="p">
    <verse number="17" style="v"/>aparanjca tasya hastE zUrpa AstE sa svazasyAni zuddharUpaM prasphOTya gOdhUmAn sarvvAn bhANPAgArE saMgrahISyati kintu bUSANi sarvvANyanirvvANavahninA dAhayiSyati|</para>
  <para style="p">
    <verse number="18" style="v"/>yOhan upadEzEnEtthaM nAnAkathA lOkAnAM samakSaM pracArayAmAsa|</para>
  <para style="p">
    <verse number="19" style="v"/>aparanjca hErOd rAjA philipnAmnaH sahOdarasya bhAryyAM hErOdiyAmadhi tathAnyAni yAni yAni kukarmmANi kRtavAn tadadhi ca</para>
  <para style="p">
    <verse number="20" style="v"/>yOhanA tiraskRtO bhUtvA kArAgArE tasya bandhanAd aparamapi kukarmma cakAra|</para>
  <para style="p">
    <verse number="21" style="v"/>itaH pUrvvaM yasmin samayE sarvvE yOhanA majjitAstadAnIM yIzurapyAgatya majjitaH|</para>
  <para style="p">
    <verse number="22" style="v"/>tadanantaraM tEna prArthitE mEghadvAraM muktaM tasmAcca pavitra AtmA mUrttimAn bhUtvA kapOtavat taduparyyavarurOha; tadA tvaM mama priyaH putrastvayi mama paramaH santOSa ityAkAzavANI babhUva|</para>
  <para style="p">
    <verse number="23" style="v"/>tadAnIM yIzuH prAyENa triMzadvarSavayaska AsIt| laukikajnjAnE tu sa yUSaphaH putraH,</para>
  <para style="p">
    <verse number="24" style="v"/>yUSaph ElEH putraH, ElirmattataH putraH, mattat lEvEH putraH, lEvi rmalkEH putraH, malkiryAnnasya putraH; yAnnO yUSaphaH putraH|</para>
  <para style="p">
    <verse number="25" style="v"/>yUSaph mattathiyasya putraH, mattathiya AmOsaH putraH, AmOs nahUmaH putraH, nahUm iSlEH putraH iSlirnagEH putraH|</para>
  <para style="p">
    <verse number="26" style="v"/>nagirmATaH putraH, mAT mattathiyasya putraH, mattathiyaH zimiyEH putraH, zimiyiryUSaphaH putraH, yUSaph yihUdAH putraH|</para>
  <para style="p">
    <verse number="27" style="v"/>yihUdA yOhAnAH putraH, yOhAnA rISAH putraH, rISAH sirubbAbilaH putraH, sirubbAbil zaltIyElaH putraH, zaltIyEl nErEH putraH|</para>
  <para style="p">
    <verse number="28" style="v"/>nErirmalkEH putraH, malkiH adyaH putraH, addI kOSamaH putraH, kOSam ilmOdadaH putraH, ilmOdad EraH putraH|</para>
  <para style="p">
    <verse number="29" style="v"/>Er yOzEH putraH, yOziH ilIyESaraH putraH, ilIyESar yOrImaH putraH, yOrIm mattataH putraH, mattata lEvEH putraH|</para>
  <para style="p">
    <verse number="30" style="v"/>lEviH zimiyOnaH putraH, zimiyOn yihUdAH putraH, yihUdA yUSuphaH putraH, yUSuph yOnanaH putraH, yAnan ilIyAkImaH putraH|</para>
  <para style="p">
    <verse number="31" style="v"/>iliyAkImH milEyAH putraH, milEyA mainanaH putraH, mainan mattattasya putraH, mattattO nAthanaH putraH, nAthan dAyUdaH putraH|</para>
  <para style="p">
    <verse number="32" style="v"/>dAyUd yizayaH putraH, yizaya ObEdaH putra, ObEd bOyasaH putraH, bOyas salmOnaH putraH, salmOn nahazOnaH putraH|</para>
  <para style="p">
    <verse number="33" style="v"/>nahazOn ammInAdabaH putraH, ammInAdab arAmaH putraH, arAm hiSrONaH putraH, hiSrON pErasaH putraH, pEras yihUdAH putraH|</para>
  <para style="p">
    <verse number="34" style="v"/>yihUdA yAkUbaH putraH, yAkUb ishAkaH putraH, ishAk ibrAhImaH putraH, ibrAhIm tErahaH putraH, tErah nAhOraH putraH|</para>
  <para style="p">
    <verse number="35" style="v"/>nAhOr sirugaH putraH, sirug riyvaH putraH, riyUH pElagaH putraH, pElag EvaraH putraH, Evar zElahaH putraH|</para>
  <para style="p">
    <verse number="36" style="v"/>zElah kainanaH putraH, kainan arphakSadaH putraH, arphakSad zAmaH putraH, zAm nOhaH putraH, nOhO lEmakaH putraH|</para>
  <para style="p">
    <verse number="37" style="v"/>lEmak mithUzElahaH putraH, mithUzElah hanOkaH putraH, hanOk yEradaH putraH, yErad mahalalElaH putraH, mahalalEl kainanaH putraH|</para>
  <para style="p">
    <verse number="38" style="v"/>kainan inOzaH putraH, inOz zEtaH putraH, zEt AdamaH putra, Adam Izvarasya putraH|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataH paraM yIzuH pavitrENAtmanA pUrNaH san yarddananadyAH parAvRtyAtmanA prAntaraM nItaH san catvAriMzaddinAni yAvat zaitAnA parIkSitO'bhUt,</para>
  <para style="p">
    <verse number="2" style="v"/>kinjca tAni sarvvadinAni bhOjanaM vinA sthitatvAt kAlE pUrNE sa kSudhitavAn|</para>
  <para style="p">
    <verse number="3" style="v"/>tataH zaitAnAgatya tamavadat tvaM cEdIzvarasya putrastarhi prastarAnEtAn AjnjayA pUpAn kuru|</para>
  <para style="p">
    <verse number="4" style="v"/>tadA yIzuruvAca, lipirIdRzI vidyatE manujaH kEvalEna pUpEna na jIvati kintvIzvarasya sarvvAbhirAjnjAbhi rjIvati|</para>
  <para style="p">
    <verse number="5" style="v"/>tadA zaitAn tamuccaM parvvataM nItvA nimiSaikamadhyE jagataH sarvvarAjyAni darzitavAn|</para>
  <para style="p">
    <verse number="6" style="v"/>pazcAt tamavAdIt sarvvam Etad vibhavaM pratApanjca tubhyaM dAsyAmi tan mayi samarpitamAstE yaM prati mamEcchA jAyatE tasmai dAtuM zaknOmi,</para>
  <para style="p">
    <verse number="7" style="v"/>tvaM cEnmAM bhajasE tarhi sarvvamEtat tavaiva bhaviSyati|</para>
  <para style="p">
    <verse number="8" style="v"/>tadA yIzustaM pratyuktavAn dUrI bhava zaitAn lipirAstE, nijaM prabhuM paramEzvaraM bhajasva kEvalaM tamEva sEvasva ca|</para>
  <para style="p">
    <verse number="9" style="v"/>atha zaitAn taM yirUzAlamaM nItvA mandirasya cUPAyA upari samupavEzya jagAda tvaM cEdIzvarasya putrastarhi sthAnAditO lamphitvAdhaH</para>
  <para style="p">
    <verse number="10" style="v"/>pata yatO lipirAstE, AjnjApayiSyati svIyAn dUtAn sa paramEzvaraH|</para>
  <para style="p">
    <verse number="11" style="v"/>rakSituM sarvvamArgE tvAM tEna tvaccaraNE yathA| na lagEt prastarAghAtastvAM dhariSyanti tE tathA|</para>
  <para style="p">
    <verse number="12" style="v"/>tadA yIzunA pratyuktam idamapyuktamasti tvaM svaprabhuM parEzaM mA parIkSasva|</para>
  <para style="p">
    <verse number="13" style="v"/>pazcAt zaitAn sarvvaparIkSAM samApya kSaNAttaM tyaktvA yayau|</para>
  <para style="p">
    <verse number="14" style="v"/>tadA yIzurAtmaprabhAvAt punargAlIlpradEzaM gatastadA tatsukhyAtizcaturdizaM vyAnazE|</para>
  <para style="p">
    <verse number="15" style="v"/>sa tESAM bhajanagRhESu upadizya sarvvaiH prazaMsitO babhUva|</para>
  <para style="p">
    <verse number="16" style="v"/>atha sa svapAlanasthAnaM nAsaratpuramEtya vizrAmavArE svAcArAd bhajanagEhaM pravizya paThitumuttasthau|</para>
  <para style="p">
    <verse number="17" style="v"/>tatO yizayiyabhaviSyadvAdinaH pustakE tasya karadattE sati sa tat pustakaM vistAryya yatra vakSyamANAni vacanAni santi tat sthAnaM prApya papATha|</para>
  <para style="p">
    <verse number="18" style="v"/>AtmA tu paramEzasya madIyOpari vidyatE| daridrESu susaMvAdaM vaktuM mAM sObhiSiktavAn| bhagnAntaH karaNAllOkAn susvasthAn karttumEva ca| bandIkRtESu lOkESu muktE rghOSayituM vacaH| nEtrANi dAtumandhEbhyastrAtuM baddhajanAnapi|</para>
  <para style="p">
    <verse number="19" style="v"/>parEzAnugrahE kAlaM pracArayitumEva ca| sarvvaitatkaraNArthAya mAmEva prahiNOti saH||</para>
  <para style="p">
    <verse number="20" style="v"/>tataH pustakaM badvvA paricArakasya hastE samarpya cAsanE samupaviSTaH, tatO bhajanagRhE yAvantO lOkA Asan tE sarvvE'nanyadRSTyA taM vilulOkirE|</para>
  <para style="p">
    <verse number="21" style="v"/>anantaram adyaitAni sarvvANi likhitavacanAni yuSmAkaM madhyE siddhAni sa imAM kathAM tEbhyaH kathayitumArEbhE|</para>
  <para style="p">
    <verse number="22" style="v"/>tataH sarvvE tasmin anvarajyanta, kinjca tasya mukhAnnirgatAbhiranugrahasya kathAbhizcamatkRtya kathayAmAsuH kimayaM yUSaphaH putrO na?</para>
  <para style="p">
    <verse number="23" style="v"/>tadA sO'vAdId hE cikitsaka svamEva svasthaM kuru kapharnAhUmi yadyat kRtavAn tadazrauSma tAH sarvAH kriyA atra svadEzE kuru kathAmEtAM yUyamEvAvazyaM mAM vadiSyatha|</para>
  <para style="p">
    <verse number="24" style="v"/>punaH sOvAdId yuSmAnahaM yathArthaM vadAmi, kOpi bhaviSyadvAdI svadEzE satkAraM na prApnOti|</para>
  <para style="p">
    <verse number="25" style="v"/>aparanjca yathArthaM vacmi, Eliyasya jIvanakAlE yadA sArddhatritayavarSANi yAvat jaladapratibandhAt sarvvasmin dEzE mahAdurbhikSam ajaniSTa tadAnIm isrAyElO dEzasya madhyE bahvyO vidhavA Asan,</para>
  <para style="p">
    <verse number="26" style="v"/>kintu sIdOnpradEzIyasAriphatpuranivAsinIm EkAM vidhavAM vinA kasyAzcidapi samIpE EliyaH prEritO nAbhUt|</para>
  <para style="p">
    <verse number="27" style="v"/>aparanjca ilIzAyabhaviSyadvAdividyamAnatAkAlE isrAyEldEzE bahavaH kuSThina Asan kintu surIyadEzIyaM nAmAnkuSThinaM vinA kOpyanyaH pariSkRtO nAbhUt|</para>
  <para style="p">
    <verse number="28" style="v"/>imAM kathAM zrutvA bhajanagEhasthitA lOkAH sakrOdham utthAya</para>
  <para style="p">
    <verse number="29" style="v"/>nagarAttaM bahiSkRtya yasya zikhariNa upari tESAM nagaraM sthApitamAstE tasmAnnikSEptuM tasya zikharaM taM ninyuH</para>
  <para style="p">
    <verse number="30" style="v"/>kintu sa tESAM madhyAdapasRtya sthAnAntaraM jagAma|</para>
  <para style="p">
    <verse number="31" style="v"/>tataH paraM yIzurgAlIlpradEzIyakapharnAhUmnagara upasthAya vizrAmavArE lOkAnupadESTum ArabdhavAn|</para>
  <para style="p">
    <verse number="32" style="v"/>tadupadEzAt sarvvE camaccakru ryatastasya kathA gurutarA Asan|</para>
  <para style="p">
    <verse number="33" style="v"/>tadAnIM tadbhajanagEhasthitO'mEdhyabhUtagrasta EkO jana uccaiH kathayAmAsa,</para>
  <para style="p">
    <verse number="34" style="v"/>hE nAsaratIyayIzO'smAn tyaja, tvayA sahAsmAkaM kaH sambandhaH? kimasmAn vinAzayitumAyAsi? tvamIzvarasya pavitrO jana EtadahaM jAnAmi|</para>
  <para style="p">
    <verse number="35" style="v"/>tadA yIzustaM tarjayitvAvadat maunI bhava itO bahirbhava; tataH sOmEdhyabhUtastaM madhyasthAnE pAtayitvA kinjcidapyahiMsitvA tasmAd bahirgatavAn|</para>
  <para style="p">
    <verse number="36" style="v"/>tataH sarvvE lOkAzcamatkRtya parasparaM vaktumArEbhirE kOyaM camatkAraH| ESa prabhAvENa parAkramENa cAmEdhyabhUtAn AjnjApayati tEnaiva tE bahirgacchanti|</para>
  <para style="p">
    <verse number="37" style="v"/>anantaraM caturdiksthadEzAn tasya sukhyAtirvyApnOt|</para>
  <para style="p">
    <verse number="38" style="v"/>tadanantaraM sa bhajanagEhAd bahirAgatya zimOnO nivEzanaM pravivEza tadA tasya zvazrUrjvarENAtyantaM pIPitAsIt ziSyAstadarthaM tasmin vinayaM cakruH|</para>
  <para style="p">
    <verse number="39" style="v"/>tataH sa tasyAH samIpE sthitvA jvaraM tarjayAmAsa tEnaiva tAM jvarO'tyAkSIt tataH sA tatkSaNam utthAya tAn siSEvE|</para>
  <para style="p">
    <verse number="40" style="v"/>atha sUryyAstakAlE svESAM yE yE janA nAnArOgaiH pIPitA Asan lOkAstAn yIzOH samIpam AninyuH, tadA sa Ekaikasya gAtrE karamarpayitvA tAnarOgAn cakAra|</para>
  <para style="p">
    <verse number="41" style="v"/>tatO bhUtA bahubhyO nirgatya cItzabdaM kRtvA ca babhASirE tvamIzvarasya putrO'bhiSiktatrAtA; kintu sObhiSiktatrAtEti tE vividurEtasmAt kAraNAt tAn tarjayitvA tadvaktuM niSiSEdha|</para>
  <para style="p">
    <verse number="42" style="v"/>aparanjca prabhAtE sati sa vijanasthAnaM pratasthE pazcAt janAstamanvicchantastannikaTaM gatvA sthAnAntaragamanArthaM tamanvarundhan|</para>
  <para style="p">
    <verse number="43" style="v"/>kintu sa tAn jagAda, IzvarIyarAjyasya susaMvAdaM pracArayitum anyAni purANyapi mayA yAtavyAni yatastadarthamEva prEritOhaM|</para>
  <para style="p">
    <verse number="44" style="v"/>atha gAlIlO bhajanagEhESu sa upadidEza|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM yIzurEkadA ginESarathdasya tIra uttiSThati, tadA lOkA IzvarIyakathAM zrOtuM tadupari prapatitAH|</para>
  <para style="p">
    <verse number="2" style="v"/>tadAnIM sa hdasya tIrasamIpE naudvayaM dadarza kinjca matsyOpajIvinO nAvaM vihAya jAlaM prakSAlayanti|</para>
  <para style="p">
    <verse number="3" style="v"/>tatastayOrdvayO rmadhyE zimOnO nAvamAruhya tIrAt kinjciddUraM yAtuM tasmin vinayaM kRtvA naukAyAmupavizya lOkAn prOpadiSTavAn|</para>
  <para style="p">
    <verse number="4" style="v"/>pazcAt taM prastAvaM samApya sa zimOnaM vyAjahAra, gabhIraM jalaM gatvA matsyAn dharttuM jAlaM nikSipa|</para>
  <para style="p">
    <verse number="5" style="v"/>tataH zimOna babhASE, hE gurO yadyapi vayaM kRtsnAM yAminIM parizramya matsyaikamapi na prAptAstathApi bhavatO nidEzatO jAlaM kSipAmaH|</para>
  <para style="p">
    <verse number="6" style="v"/>atha jAlE kSiptE bahumatsyapatanAd AnAyaH pracchinnaH|</para>
  <para style="p">
    <verse number="7" style="v"/>tasmAd upakarttum anyanausthAn saggina AyAtum iggitEna samAhvayan tatasta Agatya matsyai rnaudvayaM prapUrayAmAsu ryai rnaudvayaM pramagnam|</para>
  <para style="p">
    <verse number="8" style="v"/>tadA zimOnpitarastad vilOkya yIzOzcaraNayOH patitvA, hE prabhOhaM pApI narO mama nikaTAd bhavAn yAtu, iti kathitavAn|</para>
  <para style="p">
    <verse number="9" style="v"/>yatO jAlE patitAnAM matsyAnAM yUthAt zimOn tatsagginazca camatkRtavantaH; zimOnaH sahakAriNau sivadEH putrau yAkUb yOhan cEmau tAdRzau babhUvatuH|</para>
  <para style="p">
    <verse number="10" style="v"/>tadA yIzuH zimOnaM jagAda mA bhaiSIradyArabhya tvaM manuSyadharO bhaviSyasi|</para>
  <para style="p">
    <verse number="11" style="v"/>anantaraM sarvvAsu nausu tIram AnItAsu tE sarvvAn parityajya tasya pazcAdgAminO babhUvuH|</para>
  <para style="p">
    <verse number="12" style="v"/>tataH paraM yIzau kasmiMzcit purE tiSThati jana EkaH sarvvAggakuSThastaM vilOkya tasya samIpE nyubjaH patitvA savinayaM vaktumArEbhE, hE prabhO yadi bhavAnicchati tarhi mAM pariSkarttuM zaknOti|</para>
  <para style="p">
    <verse number="13" style="v"/>tadAnIM sa pANiM prasAryya tadaggaM spRzan babhASE tvaM pariSkriyasvEti mamEcchAsti tatastatkSaNaM sa kuSThAt muktaH|</para>
  <para style="p">
    <verse number="14" style="v"/>pazcAt sa tamAjnjApayAmAsa kathAmimAM kasmaicid akathayitvA yAjakasya samIpanjca gatvA svaM darzaya, lOkEbhyO nijapariSkRtatvasya pramANadAnAya mUsAjnjAnusArENa dravyamutmRjasva ca|</para>
  <para style="p">
    <verse number="15" style="v"/>tathApi yIzOH sukhyAti rbahu vyAptumArEbhE kinjca tasya kathAM zrOtuM svIyarOgEbhyO mOktunjca lOkA AjagmuH|</para>
  <para style="p">
    <verse number="16" style="v"/>atha sa prAntaraM gatvA prArthayAnjcakrE|</para>
  <para style="p">
    <verse number="17" style="v"/>aparanjca EkadA yIzurupadizati, Etarhi gAlIlyihUdApradEzayOH sarvvanagarEbhyO yirUzAlamazca kiyantaH phirUzilOkA vyavasthApakAzca samAgatya tadantikE samupavivizuH, tasmin kAlE lOkAnAmArOgyakAraNAt prabhOH prabhAvaH pracakAzE|</para>
  <para style="p">
    <verse number="18" style="v"/>pazcAt kiyantO lOkA EkaM pakSAghAtinaM khaTvAyAM nidhAya yIzOH samIpamAnEtuM sammukhE sthApayitunjca vyApriyanta|</para>
  <para style="p">
    <verse number="19" style="v"/>kintu bahujananivahasamvAdhAt na zaknuvantO gRhOpari gatvA gRhapRSThaM khanitvA taM pakSAghAtinaM sakhaTvaM gRhamadhyE yIzOH sammukhE 'varOhayAmAsuH|</para>
  <para style="p">
    <verse number="20" style="v"/>tadA yIzustESAm IdRzaM vizvAsaM vilOkya taM pakSAghAtinaM vyAjahAra, hE mAnava tava pApamakSamyata|</para>
  <para style="p">
    <verse number="21" style="v"/>tasmAd adhyApakAH phirUzinazca cittairitthaM pracintitavantaH, ESa jana IzvaraM nindati kOyaM? kEvalamIzvaraM vinA pApaM kSantuM kaH zaknOti?</para>
  <para style="p">
    <verse number="22" style="v"/>tadA yIzustESAm itthaM cintanaM viditvA tEbhyOkathayad yUyaM manObhiH kutO vitarkayatha?</para>
  <para style="p">
    <verse number="23" style="v"/>tava pApakSamA jAtA yadvA tvamutthAya vraja EtayO rmadhyE kA kathA sukathyA?</para>
  <para style="p">
    <verse number="24" style="v"/>kintu pRthivyAM pApaM kSantuM mAnavasutasya sAmarthyamastIti yathA yUyaM jnjAtuM zaknutha tadarthaM (sa taM pakSAghAtinaM jagAda) uttiSTha svazayyAM gRhItvA gRhaM yAhIti tvAmAdizAmi|</para>
  <para style="p">
    <verse number="25" style="v"/>tasmAt sa tatkSaNam utthAya sarvvESAM sAkSAt nijazayanIyaM gRhItvA IzvaraM dhanyaM vadan nijanivEzanaM yayau|</para>
  <para style="p">
    <verse number="26" style="v"/>tasmAt sarvvE vismaya prAptA manaHsu bhItAzca vayamadyAsambhavakAryyANyadarzAma ityuktvA paramEzvaraM dhanyaM prOditAH|</para>
  <para style="p">
    <verse number="27" style="v"/>tataH paraM bahirgacchan karasanjcayasthAnE lEvinAmAnaM karasanjcAyakaM dRSTvA yIzustamabhidadhE mama pazcAdEhi|</para>
  <para style="p">
    <verse number="28" style="v"/>tasmAt sa tatkSaNAt sarvvaM parityajya tasya pazcAdiyAya|</para>
  <para style="p">
    <verse number="29" style="v"/>anantaraM lEvi rnijagRhE tadarthaM mahAbhOjyaM cakAra, tadA taiH sahAnEkE karasanjcAyinastadanyalOkAzca bhOktumupavivizuH|</para>
  <para style="p">
    <verse number="30" style="v"/>tasmAt kAraNAt caNPAlAnAM pApilOkAnAnjca saggE yUyaM kutO bhaMgdhvE pivatha cEti kathAM kathayitvA phirUzinO'dhyApakAzca tasya ziSyaiH saha vAgyuddhaM karttumArEbhirE|</para>
  <para style="p">
    <verse number="31" style="v"/>tasmAd yIzustAn pratyavOcad arOgalOkAnAM cikitsakEna prayOjanaM nAsti kintu sarOgANAmEva|</para>
  <para style="p">
    <verse number="32" style="v"/>ahaM dhArmmikAn AhvAtuM nAgatOsmi kintu manaH parAvarttayituM pApina Eva|</para>
  <para style="p">
    <verse number="33" style="v"/>tatastE prOcuH, yOhanaH phirUzinAnjca ziSyA vAraMvAram upavasanti prArthayantE ca kintu tava ziSyAH kutO bhunjjatE pivanti ca?</para>
  <para style="p">
    <verse number="34" style="v"/>tadA sa tAnAcakhyau varE saggE tiSThati varasya sakhigaNaM kimupavAsayituM zaknutha?</para>
  <para style="p">
    <verse number="35" style="v"/>kintu yadA tESAM nikaTAd varO nESyatE tadA tE samupavatsyanti|</para>
  <para style="p">
    <verse number="36" style="v"/>sOparamapi dRSTAntaM kathayAmbabhUva purAtanavastrE kOpi nutanavastraM na sIvyati yatastEna sEvanEna jIrNavastraM chidyatE, nUtanapurAtanavastrayO rmElanjca na bhavati|</para>
  <para style="p">
    <verse number="37" style="v"/>purAtanyAM kutvAM kOpi nutanaM drAkSArasaM na nidadhAti, yatO navInadrAkSArasasya tEjasA purAtanI kutU rvidIryyatE tatO drAkSArasaH patati kutUzca nazyati|</para>
  <para style="p">
    <verse number="38" style="v"/>tatO hEtO rnUtanyAM kutvAM navInadrAkSArasaH nidhAtavyastEnObhayasya rakSA bhavati|</para>
  <para style="p">
    <verse number="39" style="v"/>aparanjca purAtanaM drAkSArasaM pItvA kOpi nUtanaM na vAnjchati, yataH sa vakti nUtanAt purAtanam prazastam|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>acaranjca parvvaNO dvitIyadinAt paraM prathamavizrAmavArE zasyakSEtrENa yIzOrgamanakAlE tasya ziSyAH kaNizaM chittvA karESu marddayitvA khAditumArEbhirE|</para>
  <para style="p">
    <verse number="2" style="v"/>tasmAt kiyantaH phirUzinastAnavadan vizrAmavArE yat karmma na karttavyaM tat kutaH kurutha?</para>
  <para style="p">
    <verse number="3" style="v"/>yIzuH pratyuvAca dAyUd tasya sagginazca kSudhArttAH kiM cakruH sa katham Izvarasya mandiraM pravizya</para>
  <para style="p">
    <verse number="4" style="v"/>yE darzanIyAH pUpA yAjakAn vinAnyasya kasyApyabhOjanIyAstAnAnIya svayaM bubhajE saggibhyOpi dadau tat kiM yuSmAbhiH kadApi nApAThi?</para>
  <para style="p">
    <verse number="5" style="v"/>pazcAt sa tAnavadat manujasutO vizrAmavArasyApi prabhu rbhavati|</para>
  <para style="p">
    <verse number="6" style="v"/>anantaram anyavizrAmavArE sa bhajanagEhaM pravizya samupadizati| tadA tatsthAnE zuSkadakSiNakara EkaH pumAn upatasthivAn|</para>
  <para style="p">
    <verse number="7" style="v"/>tasmAd adhyApakAH phirUzinazca tasmin dOSamArOpayituM sa vizrAmavArE tasya svAsthyaM karOti navEti pratIkSitumArEbhirE|</para>
  <para style="p">
    <verse number="8" style="v"/>tadA yIzustESAM cintAM viditvA taM zuSkakaraM pumAMsaM prOvAca, tvamutthAya madhyasthAnE tiSTha|</para>
  <para style="p">
    <verse number="9" style="v"/>tasmAt tasmin utthitavati yIzustAn vyAjahAra, yuSmAn imAM kathAM pRcchAmi, vizrAmavArE hitam ahitaM vA, prANarakSaNaM prANanAzanaM vA, EtESAM kiM karmmakaraNIyam?</para>
  <para style="p">
    <verse number="10" style="v"/>pazcAt caturdikSu sarvvAn vilOkya taM mAnavaM babhASE, nijakaraM prasAraya; tatastEna tathA kRta itarakaravat tasya hastaH svasthObhavat|</para>
  <para style="p">
    <verse number="11" style="v"/>tasmAt tE pracaNPakOpAnvitA yIzuM kiM kariSyantIti parasparaM pramantritAH|</para>
  <para style="p">
    <verse number="12" style="v"/>tataH paraM sa parvvatamAruhyEzvaramuddizya prArthayamAnaH kRtsnAM rAtriM yApitavAn|</para>
  <para style="p">
    <verse number="13" style="v"/>atha dinE sati sa sarvvAn ziSyAn AhUtavAn tESAM madhyE</para>
  <para style="p">
    <verse number="14" style="v"/>pitaranAmnA khyAtaH zimOn tasya bhrAtA Andriyazca yAkUb yOhan ca philip barthalamayazca</para>
  <para style="p">
    <verse number="15" style="v"/>mathiH thOmA AlphIyasya putrO yAkUb jvalantanAmnA khyAtaH zimOn</para>
  <para style="p">
    <verse number="16" style="v"/>ca yAkUbO bhrAtA yihUdAzca taM yaH parakarESu samarpayiSyati sa ISkarIyOtIyayihUdAzcaitAn dvAdaza janAn manOnItAn kRtvA sa jagrAha tathA prErita iti tESAM nAma cakAra|</para>
  <para style="p">
    <verse number="17" style="v"/>tataH paraM sa taiH saha parvvatAdavaruhya upatyakAyAM tasthau tatastasya ziSyasagghO yihUdAdEzAd yirUzAlamazca sOraH sIdOnazca jaladhE rOdhasO jananihAzca Etya tasya kathAzravaNArthaM rOgamuktyarthanjca tasya samIpE tasthuH|</para>
  <para style="p">
    <verse number="18" style="v"/>amEdhyabhUtagrastAzca tannikaTamAgatya svAsthyaM prApuH|</para>
  <para style="p">
    <verse number="19" style="v"/>sarvvESAM svAsthyakaraNaprabhAvasya prakAzitatvAt sarvvE lOkA Etya taM spraSTuM yEtirE|</para>
  <para style="p">
    <verse number="20" style="v"/>pazcAt sa ziSyAn prati dRSTiM kutvA jagAda, hE daridrA yUyaM dhanyA yata IzvarIyE rAjyE vO'dhikArOsti|</para>
  <para style="p">
    <verse number="21" style="v"/>hE adhunA kSudhitalOkA yUyaM dhanyA yatO yUyaM tarpsyatha; hE iha rOdinO janA yUyaM dhanyA yatO yUyaM hasiSyatha|</para>
  <para style="p">
    <verse number="22" style="v"/>yadA lOkA manuSyasUnO rnAmahEtO ryuSmAn RृtIyiSyantE pRthak kRtvA nindiSyanti, adhamAniva yuSmAn svasamIpAd dUrIkariSyanti ca tadA yUyaM dhanyAH|</para>
  <para style="p">
    <verse number="23" style="v"/>svargE yuSmAkaM yathESTaM phalaM bhaviSyati, EtadarthaM tasmin dinE prOllasata AnandEna nRtyata ca, tESAM pUrvvapuruSAzca bhaviSyadvAdinaH prati tathaiva vyavAharan|</para>
  <para style="p">
    <verse number="24" style="v"/>kintu hA hA dhanavantO yUyaM sukhaM prApnuta| hanta paritRptA yUyaM kSudhitA bhaviSyatha;</para>
  <para style="p">
    <verse number="25" style="v"/>iha hasantO yUyaM vata yuSmAbhiH zOcitavyaM rOditavyanjca|</para>
  <para style="p">
    <verse number="26" style="v"/>sarvvailAkai ryuSmAkaM sukhyAtau kRtAyAM yuSmAkaM durgati rbhaviSyati yuSmAkaM pUrvvapuruSA mRSAbhaviSyadvAdinaH prati tadvat kRtavantaH|</para>
  <para style="p">
    <verse number="27" style="v"/>hE zrOtArO yuSmabhyamahaM kathayAmi, yUyaM zatruSu prIyadhvaM yE ca yuSmAn dviSanti tESAmapi hitaM kuruta|</para>
  <para style="p">
    <verse number="28" style="v"/>yE ca yuSmAn zapanti tEbhya AziSaM datta yE ca yuSmAn avamanyantE tESAM maggalaM prArthayadhvaM|</para>
  <para style="p">
    <verse number="29" style="v"/>yadi kazcit tava kapOlE capETAghAtaM karOti tarhi taM prati kapOlam anyaM parAvarttya sammukhIkuru punazca yadi kazcit tava gAtrIyavastraM harati tarhi taM paridhEyavastram api grahItuM mA vAraya|</para>
  <para style="p">
    <verse number="30" style="v"/>yastvAM yAcatE tasmai dEhi, yazca tava sampattiM harati taM mA yAcasva|</para>
  <para style="p">
    <verse number="31" style="v"/>parEbhyaH svAn prati yathAcaraNam apEkSadhvE parAn prati yUyamapi tathAcarata|</para>
  <para style="p">
    <verse number="32" style="v"/>yE janA yuSmAsu prIyantE kEvalaM tESu prIyamANESu yuSmAkaM kiM phalaM? pApilOkA api svESu prIyamANESu prIyantE|</para>
  <para style="p">
    <verse number="33" style="v"/>yadi hitakAriNa Eva hitaM kurutha tarhi yuSmAkaM kiM phalaM? pApilOkA api tathA kurvvanti|</para>
  <para style="p">
    <verse number="34" style="v"/>yEbhya RNaparizOdhasya prAptipratyAzAstE kEvalaM tESu RNE samarpitE yuSmAkaM kiM phalaM? punaH prAptyAzayA pApIlOkA api pApijanESu RNam arpayanti|</para>
  <para style="p">
    <verse number="35" style="v"/>atO yUyaM ripuSvapi prIyadhvaM, parahitaM kuruta ca; punaH prAptyAzAM tyaktvA RNamarpayata, tathA kRtE yuSmAkaM mahAphalaM bhaviSyati, yUyanjca sarvvapradhAnasya santAnA iti khyAtiM prApsyatha, yatO yuSmAkaM pitA kRtaghnAnAM durvTattAnAnjca hitamAcarati|</para>
  <para style="p">
    <verse number="36" style="v"/>ata Eva sa yathA dayAlu ryUyamapi tAdRzA dayAlavO bhavata|</para>
  <para style="p">
    <verse number="37" style="v"/>aparanjca parAn dOSiNO mA kuruta tasmAd yUyaM dOSIkRtA na bhaviSyatha; adaNPyAn mA daNPayata tasmAd yUyamapi daNPaM na prApsyatha; parESAM dOSAn kSamadhvaM tasmAd yuSmAkamapi dOSAH kSamiSyantE|</para>
  <para style="p">
    <verse number="38" style="v"/>dAnAnidatta tasmAd yUyaM dAnAni prApsyatha, varanjca lOkAH parimANapAtraM pradalayya sanjcAlya prOnjcAlya paripUryya yuSmAkaM krOPESu samarpayiSyanti; yUyaM yEna parimANEna parimAtha tEnaiva parimANEna yuSmatkRtE parimAsyatE|</para>
  <para style="p">
    <verse number="39" style="v"/>atha sa tEbhyO dRSTAntakathAmakathayat, andhO janaH kimandhaM panthAnaM darzayituM zaknOti? tasmAd ubhAvapi kiM garttE na patiSyataH?</para>
  <para style="p">
    <verse number="40" style="v"/>gurOH ziSyO na zrESThaH kintu ziSyE siddhE sati sa gurutulyO bhavituM zaknOti|</para>
  <para style="p">
    <verse number="41" style="v"/>aparanjca tvaM svacakSuुSi nAsAm adRSTvA tava bhrAtuzcakSuSi yattRNamasti tadEva kutaH pazyami?</para>
  <para style="p">
    <verse number="42" style="v"/>svacakSuSi yA nAsA vidyatE tAm ajnjAtvA, bhrAtastava nEtrAt tRNaM bahiH karOmIti vAkyaM bhrAtaraM kathaM vaktuM zaknOSi? hE kapaTin pUrvvaM svanayanAt nAsAM bahiH kuru tatO bhrAtuzcakSuSastRNaM bahiH karttuM sudRSTiM prApsyasi|</para>
  <para style="p">
    <verse number="43" style="v"/>anyanjca uttamastaruH kadApi phalamanuttamaM na phalati, anuttamataruzca phalamuttamaM na phalati kAraNAdataH phalaistaravO jnjAyantE|</para>
  <para style="p">
    <verse number="44" style="v"/>kaNTakipAdapAt kOpi uPumbaraphalAni na pAtayati tathA zRgAlakOlivRkSAdapi kOpi drAkSAphalaM na pAtayati|</para>
  <para style="p">
    <verse number="45" style="v"/>tadvat sAdhulOkO'ntaHkaraNarUpAt subhANPAgArAd uttamAni dravyANi bahiH karOti, duSTO lOkazcAntaHkaraNarUpAt kubhANPAgArAt kutsitAni dravyANi nirgamayati yatO'ntaHkaraNAnAM pUrNabhAvAnurUpANi vacAMsi mukhAnnirgacchanti|</para>
  <para style="p">
    <verse number="46" style="v"/>aparanjca mamAjnjAnurUpaM nAcaritvA kutO mAM prabhO prabhO iti vadatha?</para>
  <para style="p">
    <verse number="47" style="v"/>yaH kazcin mama nikaTam Agatya mama kathA nizamya tadanurUpaM karmma karOti sa kasya sadRzO bhavati tadahaM yuSmAn jnjAाpayAmi|</para>
  <para style="p">
    <verse number="48" style="v"/>yO janO gabhIraM khanitvA pASANasthalE bhittiM nirmmAya svagRhaM racayati tEna saha tasyOpamA bhavati; yata AplAvijalamEtya tasya mUlE vEgEna vahadapi tadgEhaM lAPayituM na zaknOti yatastasya bhittiH pASANOpari tiSThati|</para>
  <para style="p">
    <verse number="49" style="v"/>kintu yaH kazcin mama kathAH zrutvA tadanurUpaM nAcarati sa bhittiM vinA mRृdupari gRhanirmmAtrA samAnO bhavati; yata AplAvijalamAgatya vEgEna yadA vahati tadA tadgRhaM patati tasya mahat patanaM jAyatE|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataH paraM sa lOkAnAM karNagOcarE tAn sarvvAn upadEzAn samApya yadA kapharnAhUmpuraM pravizati</para>
  <para style="p">
    <verse number="2" style="v"/>tadA zatasEnApatEH priyadAsa EkO mRtakalpaH pIPita AsIt|</para>
  <para style="p">
    <verse number="3" style="v"/>ataH sEnApati ryIzO rvArttAM nizamya dAsasyArOgyakaraNAya tasyAgamanArthaM vinayakaraNAya yihUdIyAn kiyataH prAcaH prESayAmAsa|</para>
  <para style="p">
    <verse number="4" style="v"/>tE yIzOrantikaM gatvA vinayAtizayaM vaktumArEbhirE, sa sEnApati rbhavatOnugrahaM prAptum arhati|</para>
  <para style="p">
    <verse number="5" style="v"/>yataH sOsmajjAtIyESu lOkESu prIyatE tathAsmatkRtE bhajanagEhaM nirmmitavAn|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmAd yIzustaiH saha gatvA nivEzanasya samIpaM prApa, tadA sa zatasEnApati rvakSyamANavAkyaM taM vaktuM bandhUn prAhiNOt| hE prabhO svayaM zramO na karttavyO yad bhavatA madgEhamadhyE pAdArpaNaM kriyEta tadapyahaM nArhAmi,</para>
  <para style="p">
    <verse number="7" style="v"/>kinjcAhaM bhavatsamIpaM yAtumapi nAtmAnaM yOgyaM buddhavAn, tatO bhavAn vAkyamAtraM vadatu tEnaiva mama dAsaH svasthO bhaviSyati|</para>
  <para style="p">
    <verse number="8" style="v"/>yasmAd ahaM parAdhInOpi mamAdhInA yAH sEnAH santi tAsAm EkajanaM prati yAhIti mayA prOktE sa yAti; tadanyaM prati AyAhIti prOktE sa AyAti; tathA nijadAsaM prati Etat kurvviti prOktE sa tadEva karOti|</para>
  <para style="p">
    <verse number="9" style="v"/>yIzuridaM vAkyaM zrutvA vismayaM yayau, mukhaM parAvartya pazcAdvarttinO lOkAn babhASE ca, yuSmAnahaM vadAmi isrAyElO vaMzamadhyEpi vizvAsamIdRzaM na prApnavaM|</para>
  <para style="p">
    <verse number="10" style="v"/>tatastE prESitA gRhaM gatvA taM pIPitaM dAsaM svasthaM dadRzuH|</para>
  <para style="p">
    <verse number="11" style="v"/>parE'hani sa nAyInAkhyaM nagaraM jagAma tasyAnEkE ziSyA anyE ca lOkAstEna sArddhaM yayuH|</para>
  <para style="p">
    <verse number="12" style="v"/>tESu tannagarasya dvArasannidhiM prAptESu kiyantO lOkA EkaM mRtamanujaM vahantO nagarasya bahiryAnti, sa tanmAturEkaputrastanmAtA ca vidhavA; tayA sArddhaM tannagarIyA bahavO lOkA Asan|</para>
  <para style="p">
    <verse number="13" style="v"/>prabhustAM vilOkya sAnukampaH kathayAmAsa, mA rOdIH| sa samIpamitvA khaTvAM pasparza tasmAd vAhakAH sthagitAstamyuH;</para>
  <para style="p">
    <verse number="14" style="v"/>tadA sa uvAca hE yuvamanuSya tvamuttiSTha, tvAmaham AjnjApayAmi|</para>
  <para style="p">
    <verse number="15" style="v"/>tasmAt sa mRtO janastatkSaNamutthAya kathAM prakathitaH; tatO yIzustasya mAtari taM samarpayAmAsa|</para>
  <para style="p">
    <verse number="16" style="v"/>tasmAt sarvvE lOkAH zazagkirE; EkO mahAbhaviSyadvAdI madhyE'smAkam samudait, Izvarazca svalOkAnanvagRhlAt kathAmimAM kathayitvA IzvaraM dhanyaM jagaduH|</para>
  <para style="p">
    <verse number="17" style="v"/>tataH paraM samastaM yihUdAdEzaM tasya caturdiksthadEzanjca tasyaitatkIrtti rvyAnazE|</para>
  <para style="p">
    <verse number="18" style="v"/>tataH paraM yOhanaH ziSyESu taM tadvRttAntaM jnjApitavatsu</para>
  <para style="p">
    <verse number="19" style="v"/>sa svaziSyANAM dvau janAvAhUya yIzuM prati vakSyamANaM vAkyaM vaktuM prESayAmAsa, yasyAgamanam apEkSya tiSThAmO vayaM kiM sa Eva janastvaM? kiM vayamanyamapEkSya sthAsyAmaH?</para>
  <para style="p">
    <verse number="20" style="v"/>pazcAttau mAnavau gatvA kathayAmAsatuH, yasyAgamanam apEkSya tiSThAmO vayaM, kiM saEva janastvaM? kiM vayamanyamapEkSya sthAsyAmaH? kathAmimAM tubhyaM kathayituM yOhan majjaka AvAM prESitavAn|</para>
  <para style="p">
    <verse number="21" style="v"/>tasmin daNPE yIzUrOgiNO mahAvyAdhimatO duSTabhUtagrastAMzca bahUn svasthAn kRtvA, anEkAndhEbhyazcakSuMSi dattvA pratyuvAca,</para>
  <para style="p">
    <verse number="22" style="v"/>yuvAM vrajatam andhA nEtrANi khanjjAzcaraNAni ca prApnuvanti, kuSThinaH pariSkriyantE, badhirAH zravaNAni mRtAzca jIvanAni prApnuvanti, daridrANAM samIpESu susaMvAdaH pracAryyatE, yaM prati vighnasvarUpOhaM na bhavAmi sa dhanyaH,</para>
  <para style="p">
    <verse number="23" style="v"/>EtAni yAni pazyathaH zRNuthazca tAni yOhanaM jnjApayatam|</para>
  <para style="p">
    <verse number="24" style="v"/>tayO rdUtayO rgatayOH satO ryOhani sa lOkAn vaktumupacakramE, yUyaM madhyEprAntaraM kiM draSTuM niragamata? kiM vAyunA kampitaM naPaM?</para>
  <para style="p">
    <verse number="25" style="v"/>yUyaM kiM draSTuM niragamata? kiM sUkSmavastraparidhAyinaM kamapi naraM? kintu yE sUkSmamRduvastrANi paridadhati sUttamAni dravyANi bhunjjatE ca tE rAjadhAnISu tiSThanti|</para>
  <para style="p">
    <verse number="26" style="v"/>tarhi yUyaM kiM draSTuM niragamata? kimEkaM bhaviSyadvAdinaM? tadEva satyaM kintu sa pumAn bhaviSyadvAdinOpi zrESTha ityahaM yuSmAn vadAmi;</para>
  <para style="p">
    <verse number="27" style="v"/>pazya svakIyadUtantu tavAgra prESayAmyahaM| gatvA tvadIyamArgantu sa hi pariSkariSyati| yadarthE lipiriyam AstE sa Eva yOhan|</para>
  <para style="p">
    <verse number="28" style="v"/>atO yuSmAnahaM vadAmi striyA garbbhajAtAnAM bhaviSyadvAdinAM madhyE yOhanO majjakAt zrESThaH kOpi nAsti, tatrApi Izvarasya rAjyE yaH sarvvasmAt kSudraH sa yOhanOpi zrESThaH|</para>
  <para style="p">
    <verse number="29" style="v"/>aparanjca sarvvE lOkAH karamanjcAyinazca tasya vAkyAni zrutvA yOhanA majjanEna majjitAH paramEzvaraM nirdOSaM mEnirE|</para>
  <para style="p">
    <verse number="30" style="v"/>kintu phirUzinO vyavasthApakAzca tEna na majjitAH svAn pratIzvarasyOpadEzaM niSphalam akurvvan|</para>
  <para style="p">
    <verse number="31" style="v"/>atha prabhuH kathayAmAsa, idAnIntanajanAn kEnOpamAmi? tE kasya sadRzAH?</para>
  <para style="p">
    <verse number="32" style="v"/>yE bAlakA vipaNyAm upavizya parasparam AhUya vAkyamidaM vadanti, vayaM yuSmAkaM nikaTE vaMzIravAdiSma, kintu yUyaM nAnarttiSTa, vayaM yuSmAkaM nikaTa arOdiSma, kintu yuyaM na vyalapiSTa, bAlakairEtAdRzaistESAm upamA bhavati|</para>
  <para style="p">
    <verse number="33" style="v"/>yatO yOhan majjaka Agatya pUpaM nAkhAdat drAkSArasanjca nApivat tasmAd yUyaM vadatha, bhUtagrastOyam|</para>
  <para style="p">
    <verse number="34" style="v"/>tataH paraM mAnavasuta AgatyAkhAdadapivanjca tasmAd yUyaM vadatha, khAdakaH surApazcANPAlapApinAM bandhurEkO janO dRzyatAm|</para>
  <para style="p">
    <verse number="35" style="v"/>kintu jnjAninO jnjAnaM nirdOSaM viduH|</para>
  <para style="p">
    <verse number="36" style="v"/>pazcAdEkaH phirUzI yIzuM bhOjanAya nyamantrayat tataH sa tasya gRhaM gatvA bhOktumupaviSTaH|</para>
  <para style="p">
    <verse number="37" style="v"/>Etarhi tatphirUzinO gRhE yIzu rbhEktum upAvEkSIt tacchrutvA tannagaravAsinI kApi duSTA nArI pANParaprastarasya sampuTakE sugandhitailam AnIya</para>
  <para style="p">
    <verse number="38" style="v"/>tasya pazcAt pAdayOH sannidhau tasyau rudatI ca nEtrAmbubhistasya caraNau prakSAlya nijakacairamArkSIt, tatastasya caraNau cumbitvA tEna sugandhitailEna mamarda|</para>
  <para style="p">
    <verse number="39" style="v"/>tasmAt sa nimantrayitA phirUzI manasA cintayAmAsa, yadyayaM bhaviSyadvAdI bhavEt tarhi EnaM spRzati yA strI sA kA kIdRzI cEti jnjAtuM zaknuyAt yataH sA duSTA|</para>
  <para style="p">
    <verse number="40" style="v"/>tadA yAzustaM jagAda, hE zimOn tvAM prati mama kinjcid vaktavyamasti; tasmAt sa babhASE, hE gurO tad vadatu|</para>
  <para style="p">
    <verse number="41" style="v"/>EkOttamarNasya dvAvadhamarNAvAstAM, tayOrEkaH panjcazatAni mudrApAdAn aparazca panjcAzat mudrApAdAn dhArayAmAsa|</para>
  <para style="p">
    <verse number="42" style="v"/>tadanantaraM tayOH zOdhyAbhAvAt sa uttamarNastayO rRNE cakSamE; tasmAt tayOrdvayOH kastasmin prESyatE bahu? tad brUhi|</para>
  <para style="p">
    <verse number="43" style="v"/>zimOn pratyuvAca, mayA budhyatE yasyAdhikam RNaM cakSamE sa iti; tatO yIzustaM vyAjahAra, tvaM yathArthaM vyacArayaH|</para>
  <para style="p">
    <verse number="44" style="v"/>atha tAM nArIM prati vyAghuThya zimOnamavOcat, strImimAM pazyasi? tava gRhE mayyAgatE tvaM pAdaprakSAlanArthaM jalaM nAdAH kintu yOSidESA nayanajalai rmama pAdau prakSAlya kEzairamArkSIt|</para>
  <para style="p">
    <verse number="45" style="v"/>tvaM mAM nAcumbIH kintu yOSidESA svIyAgamanAdArabhya madIyapAdau cumbituM na vyaraMsta|</para>
  <para style="p">
    <verse number="46" style="v"/>tvanjca madIyOttamAggE kinjcidapi tailaM nAmardIH kintu yOSidESA mama caraNau sugandhitailEnAmarddIt|</para>
  <para style="p">
    <verse number="47" style="v"/>atastvAM vyAharAmi, EtasyA bahu pApamakSamyata tatO bahu prIyatE kintu yasyAlpapApaM kSamyatE sOlpaM prIyatE|</para>
  <para style="p">
    <verse number="48" style="v"/>tataH paraM sa tAM babhASE, tvadIyaM pApamakSamyata|</para>
  <para style="p">
    <verse number="49" style="v"/>tadA tEna sArddhaM yE bhOktum upavivizustE parasparaM vaktumArEbhirE, ayaM pApaM kSamatE ka ESaH?</para>
  <para style="p">
    <verse number="50" style="v"/>kintu sa tAM nArIM jagAda, tava vizvAsastvAM paryyatrAsta tvaM kSEmENa vraja|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparanjca yIzu rdvAdazabhiH ziSyaiH sArddhaM nAnAnagarESu nAnAgrAmESu ca gacchan izvarIyarAjatvasya susaMvAdaM pracArayituM prArEbhE|</para>
  <para style="p">
    <verse number="2" style="v"/>tadA yasyAH sapta bhUtA niragacchan sA magdalInIti vikhyAtA mariyam hErOdrAjasya gRhAdhipatEH hOSE rbhAryyA yOhanA zUzAnA</para>
  <para style="p">
    <verse number="3" style="v"/>prabhRtayO yA bahvyaH striyaH duSTabhUtEbhyO rOgEbhyazca muktAH satyO nijavibhUtI rvyayitvA tamasEvanta, tAH sarvvAstEna sArddham Asan|</para>
  <para style="p">
    <verse number="4" style="v"/>anantaraM nAnAnagarEbhyO bahavO lOkA Agatya tasya samIpE'milan, tadA sa tEbhya EkAM dRSTAntakathAM kathayAmAsa| EkaH kRSIbalO bIjAni vaptuM bahirjagAma,</para>
  <para style="p">
    <verse number="5" style="v"/>tatO vapanakAlE katipayAni bIjAni mArgapArzvE pEtuH, tatastAni padatalai rdalitAni pakSibhi rbhakSitAni ca|</para>
  <para style="p">
    <verse number="6" style="v"/>katipayAni bIjAni pASANasthalE patitAni yadyapi tAnyagkuritAni tathApi rasAbhAvAt zuzuSuH|</para>
  <para style="p">
    <verse number="7" style="v"/>katipayAni bIjAni kaNTakivanamadhyE patitAni tataH kaNTakivanAni saMvRddhya tAni jagrasuH|</para>
  <para style="p">
    <verse number="8" style="v"/>tadanyAni katipayabIjAni ca bhUmyAmuttamAyAM pEtustatastAnyagkurayitvA zataguNAni phalAni phEluH| sa imA kathAM kathayitvA prOccaiH prOvAca, yasya zrOtuM zrOtrE staH sa zRNOtu|</para>
  <para style="p">
    <verse number="9" style="v"/>tataH paraM ziSyAstaM papracchurasya dRSTAntasya kiM tAtparyyaM?</para>
  <para style="p">
    <verse number="10" style="v"/>tataH sa vyAjahAra, IzvarIyarAjyasya guhyAni jnjAtuM yuSmabhyamadhikArO dIyatE kintvanyE yathA dRSTvApi na pazyanti zrutvApi ma budhyantE ca tadarthaM tESAM purastAt tAH sarvvAH kathA dRSTAntEna kathyantE|</para>
  <para style="p">
    <verse number="11" style="v"/>dRSTAntasyAsyAbhiprAyaH, IzvarIyakathA bIjasvarUpA|</para>
  <para style="p">
    <verse number="12" style="v"/>yE kathAmAtraM zRNvanti kintu pazcAd vizvasya yathA paritrANaM na prApnuvanti tadAzayEna zaitAnEtya hRdayAtR tAM kathAm apaharati ta Eva mArgapArzvasthabhUmisvarUpAH|</para>
  <para style="p">
    <verse number="13" style="v"/>yE kathaM zrutvA sAnandaM gRhlanti kintvabaddhamUlatvAt svalpakAlamAtraM pratItya parIkSAkAlE bhrazyanti taEva pASANabhUmisvarUpAH|</para>
  <para style="p">
    <verse number="14" style="v"/>yE kathAM zrutvA yAnti viSayacintAyAM dhanalObhEna EेhikasukhE ca majjanta upayuktaphalAni na phalanti ta EvOptabIjakaNTakibhUsvarUpAH|</para>
  <para style="p">
    <verse number="15" style="v"/>kintu yE zrutvA saralaiH zuddhaizcAntaHkaraNaiH kathAM gRhlanti dhairyyam avalambya phalAnyutpAdayanti ca ta EvOttamamRtsvarUpAH|</para>
  <para style="p">
    <verse number="16" style="v"/>aparanjca pradIpaM prajvAlya kOpi pAtrENa nAcchAdayati tathA khaTvAdhOpi na sthApayati, kintu dIpAdhArOparyyEva sthApayati, tasmAt pravEzakA dIptiM pazyanti|</para>
  <para style="p">
    <verse number="17" style="v"/>yanna prakAzayiSyatE tAdRg aprakAzitaM vastu kimapi nAsti yacca na suvyaktaM pracArayiSyatE tAdRg gRptaM vastu kimapi nAsti|</para>
  <para style="p">
    <verse number="18" style="v"/>atO yUyaM kEna prakArENa zRNutha tatra sAvadhAnA bhavata, yasya samIpE barddhatE tasmai punardAsyatE kintu yasyAzrayE na barddhatE tasya yadyadasti tadapi tasmAt nESyatE|</para>
  <para style="p">
    <verse number="19" style="v"/>aparanjca yIzO rmAtA bhrAtarazca tasya samIpaM jigamiSavaH</para>
  <para style="p">
    <verse number="20" style="v"/>kintu janatAsambAdhAt tatsannidhiM prAptuM na zEkuH| tatpazcAt tava mAtA bhrAtarazca tvAM sAkSAt cikIrSantO bahistiSThanatIti vArttAyAM tasmai kathitAyAM</para>
  <para style="p">
    <verse number="21" style="v"/>sa pratyuvAca; yE janA Izvarasya kathAM zrutvA tadanurUpamAcaranti taEva mama mAtA bhrAtarazca|</para>
  <para style="p">
    <verse number="22" style="v"/>anantaraM EkadA yIzuH ziSyaiH sArddhaM nAvamAruhya jagAda, AyAta vayaM hradasya pAraM yAmaH, tatastE jagmuH|</para>
  <para style="p">
    <verse number="23" style="v"/>tESu naukAM vAhayatsu sa nidadrau;</para>
  <para style="p">
    <verse number="24" style="v"/>athAkasmAt prabalajhanjbhzagamAd hradE naukAyAM taraggairAcchannAyAM vipat tAn jagrAsa|tasmAd yIzOrantikaM gatvA hE gurO hE gurO prANA nO yAntIti gaditvA taM jAgarayAmbabhUvuH|tadA sa utthAya vAyuM taraggAMzca tarjayAmAsa tasmAdubhau nivRtya sthirau babhUvatuH|</para>
  <para style="p">
    <verse number="25" style="v"/>sa tAn babhASE yuSmAkaM vizvAsaH ka? tasmAttE bhItA vismitAzca parasparaM jagaduH, ahO kIdRgayaM manujaH pavanaM pAnIyanjcAdizati tadubhayaM tadAdEzaM vahati|</para>
  <para style="p">
    <verse number="26" style="v"/>tataH paraM gAlIlpradEzasya sammukhasthagidErIyapradEzE naukAyAM lagantyAM taTE'varOhamAvAd</para>
  <para style="p">
    <verse number="27" style="v"/>bahutithakAlaM bhUtagrasta EkO mAnuSaH purAdAgatya taM sAkSAccakAra| sa manuSO vAsO na paridadhat gRhE ca na vasan kEvalaM zmazAnam adhyuvAsa|</para>
  <para style="p">
    <verse number="28" style="v"/>sa yIzuM dRSTvaiva cIcchabdaM cakAra tasya sammukhE patitvA prOccairjagAda ca, hE sarvvapradhAnEzvarasya putra, mayA saha tava kaH sambandhaH? tvayi vinayaM karOmi mAM mA yAtaya|</para>
  <para style="p">
    <verse number="29" style="v"/>yataH sa taM mAnuSaM tyaktvA yAtum amEdhyabhUtam AdidEza; sa bhUtastaM mAnuSam asakRd dadhAra tasmAllOkAH zRgkhalEna nigaPEna ca babandhuH; sa tad bhaMktvA bhUtavazatvAt madhyEprAntaraM yayau|</para>
  <para style="p">
    <verse number="30" style="v"/>anantaraM yIzustaM papraccha tava kinnAma? sa uvAca, mama nAma bAhinO yatO bahavO bhUtAstamAzizriyuH|</para>
  <para style="p">
    <verse number="31" style="v"/>atha bhUtA vinayEna jagaduH, gabhIraM garttaM gantuM mAjnjApayAsmAn|</para>
  <para style="p">
    <verse number="32" style="v"/>tadA parvvatOpari varAhavrajazcarati tasmAd bhUtA vinayEna prOcuH, amuM varAhavrajam Azrayitum asmAn anujAnIhi; tataH sOnujajnjau|</para>
  <para style="p">
    <verse number="33" style="v"/>tataH paraM bhUtAstaM mAnuSaM vihAya varAhavrajam AzizriyuH varAhavrajAzca tatkSaNAt kaTakEna dhAvantO hradE prANAn vijRhuH|</para>
  <para style="p">
    <verse number="34" style="v"/>tad dRSTvA zUkararakSakAH palAyamAnA nagaraM grAmanjca gatvA tatsarvvavRttAntaM kathayAmAsuH|</para>
  <para style="p">
    <verse number="35" style="v"/>tataH kiM vRttam EtaddarzanArthaM lOkA nirgatya yIzOH samIpaM yayuH, taM mAnuSaM tyaktabhUtaM parihitavastraM svasthamAnuSavad yIzOzcaraNasannidhau sUpavizantaM vilOkya bibhyuH|</para>
  <para style="p">
    <verse number="36" style="v"/>yE lOkAstasya bhUtagrastasya svAsthyakaraNaM dadRzustE tEbhyaH sarvvavRttAntaM kathayAmAsuH|</para>
  <para style="p">
    <verse number="37" style="v"/>tadanantaraM tasya gidErIyapradEzasya caturdiksthA bahavO janA atitrastA vinayEna taM jagaduH, bhavAn asmAkaM nikaTAd vrajatu tasmAt sa nAvamAruhya tatO vyAghuTya jagAma|</para>
  <para style="p">
    <verse number="38" style="v"/>tadAnIM tyaktabhUtamanujastEna saha sthAtuM prArthayAnjcakrE</para>
  <para style="p">
    <verse number="39" style="v"/>kintu tadartham IzvaraH kIdRgmahAkarmma kRtavAn iti nivEzanaM gatvA vijnjApaya, yIzuH kathAmEtAM kathayitvA taM visasarja| tataH sa vrajitvA yIzustadarthaM yanmahAkarmma cakAra tat purasya sarvvatra prakAzayituM prArEbhE|</para>
  <para style="p">
    <verse number="40" style="v"/>atha yIzau parAvRtyAgatE lOkAstaM AdarENa jagRhu ryasmAttE sarvvE tamapEkSAnjcakrirE|</para>
  <para style="p">
    <verse number="41" style="v"/>tadanantaraM yAyIrnAmnO bhajanagEhasyaikOdhipa Agatya yIzOzcaraNayOH patitvA svanivEzanAgamanArthaM tasmin vinayaM cakAra,</para>
  <para style="p">
    <verse number="42" style="v"/>yatastasya dvAdazavarSavayaskA kanyaikAsIt sA mRtakalpAbhavat| tatastasya gamanakAlE mArgE lOkAnAM mahAn samAgamO babhUva|</para>
  <para style="p">
    <verse number="43" style="v"/>dvAdazavarSANi pradararOgagrastA nAnA vaidyaizcikitsitA sarvvasvaM vyayitvApi svAsthyaM na prAptA yA yOSit sA yIzOH pazcAdAgatya tasya vastragranthiM pasparza|</para>
  <para style="p">
    <verse number="44" style="v"/>tasmAt tatkSaNAt tasyA raktasrAvO ruddhaH|</para>
  <para style="p">
    <verse number="45" style="v"/>tadAnIM yIzuravadat kEnAhaM spRSTaH? tatO'nEkairanaggIkRtE pitarastasya sagginazcAvadan, hE gurO lOkA nikaTasthAH santastava dEhE gharSayanti, tathApi kEnAhaM spRSTa_iti bhavAn kutaH pRcchati?</para>
  <para style="p">
    <verse number="46" style="v"/>yIzuH kathayAmAsa, kEnApyahaM spRSTO, yatO mattaH zakti rnirgatEti mayA nizcitamajnjAyi|</para>
  <para style="p">
    <verse number="47" style="v"/>tadA sA nArI svayaM na guptEti viditvA kampamAnA satI tasya sammukhE papAta; yEna nimittEna taM pasparza sparzamAtrAcca yEna prakArENa svasthAbhavat tat sarvvaM tasya sAkSAdAcakhyau|</para>
  <para style="p">
    <verse number="48" style="v"/>tataH sa tAM jagAda hE kanyE susthirA bhava, tava vizvAsastvAM svasthAm akArSIt tvaM kSEmENa yAhi|</para>
  <para style="p">
    <verse number="49" style="v"/>yIzOrEtadvAkyavadanakAlE tasyAdhipatE rnivEzanAt kazcillOka Agatya taM babhASE, tava kanyA mRtA guruM mA klizAna|</para>
  <para style="p">
    <verse number="50" style="v"/>kintu yIzustadAkarNyAdhipatiM vyAjahAra, mA bhaiSIH kEvalaM vizvasihi tasmAt sA jIviSyati|</para>
  <para style="p">
    <verse number="51" style="v"/>atha tasya nivEzanE prAptE sa pitaraM yOhanaM yAkUbanjca kanyAyA mAtaraM pitaranjca vinA, anyaM kanjcana pravESTuM vArayAmAsa|</para>
  <para style="p">
    <verse number="52" style="v"/>aparanjca yE rudanti vilapanti ca tAn sarvvAn janAn uvAca, yUyaM mA rOdiSTa kanyA na mRtA nidrAti|</para>
  <para style="p">
    <verse number="53" style="v"/>kintu sA nizcitaM mRtEti jnjAtvA tE tamupajahasuH|</para>
  <para style="p">
    <verse number="54" style="v"/>pazcAt sa sarvvAn bahiH kRtvA kanyAyAH karau dhRtvAjuhuvE, hE kanyE tvamuttiSTha,</para>
  <para style="p">
    <verse number="55" style="v"/>tasmAt tasyAH prANESu punarAgatESu sA tatkSaNAd uttasyau| tadAnIM tasyai kinjcid bhakSyaM dAtum AdidEza|</para>
  <para style="p">
    <verse number="56" style="v"/>tatastasyAH pitarau vismayaM gatau kintu sa tAvAdidEza ghaTanAyA EtasyAH kathAM kasmaicidapi mA kathayataM|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataH paraM sa dvAdazaziSyAnAhUya bhUtAn tyAjayituM rOgAn pratikarttunjca tEbhyaH zaktimAdhipatyanjca dadau|</para>
  <para style="p">
    <verse number="2" style="v"/>aparanjca IzvarIyarAjyasya susaMvAdaM prakAzayitum rOgiNAmArOgyaM karttunjca prEraNakAlE tAn jagAda|</para>
  <para style="p">
    <verse number="3" style="v"/>yAtrArthaM yaSTi rvastrapuTakaM bhakSyaM mudrA dvitIyavastram, ESAM kimapi mA gRhlIta|</para>
  <para style="p">
    <verse number="4" style="v"/>yUyanjca yannivEzanaM pravizatha nagaratyAgaparyyanataM tannivEzanE tiSThata|</para>
  <para style="p">
    <verse number="5" style="v"/>tatra yadi kasyacit purasya lOkA yuSmAkamAtithyaM na kurvvanti tarhi tasmAnnagarAd gamanakAlE tESAM viruddhaM sAkSyArthaM yuSmAkaM padadhUlIH sampAtayata|</para>
  <para style="p">
    <verse number="6" style="v"/>atha tE prasthAya sarvvatra susaMvAdaM pracArayituM pIPitAn svasthAn karttunjca grAmESu bhramituM prArEbhirE|</para>
  <para style="p">
    <verse number="7" style="v"/>Etarhi hErOd rAjA yIzOH sarvvakarmmaNAM vArttAM zrutvA bhRzamudvivijE</para>
  <para style="p">
    <verse number="8" style="v"/>yataH kEcidUcuryOhan zmazAnAdudatiSThat| kEcidUcuH, EliyO darzanaM dattavAn; EvamanyalOkA UcuH pUrvvIyaH kazcid bhaviSyadvAdI samutthitaH|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu hErOduvAca yOhanaH zirO'hamachinadam idAnIM yasyEdRkkarmmaNAM vArttAM prApnOmi sa kaH? atha sa taM draSTum aicchat|</para>
  <para style="p">
    <verse number="10" style="v"/>anantaraM prEritAH pratyAgatya yAni yAni karmmANi cakrustAni yIzavE kathayAmAsuH tataH sa tAn baitsaidAnAmakanagarasya vijanaM sthAnaM nItvA guptaM jagAma|</para>
  <para style="p">
    <verse number="11" style="v"/>pazcAl lOkAstad viditvA tasya pazcAd yayuH; tataH sa tAn nayan IzvarIyarAjyasya prasaggamuktavAn, yESAM cikitsayA prayOjanam AsIt tAn svasthAn cakAra ca|</para>
  <para style="p">
    <verse number="12" style="v"/>aparanjca divAvasannE sati dvAdazaziSyA yIzOrantikam Etya kathayAmAsuH, vayamatra prAntarasthAnE tiSThAmaH, tatO nagarANi grAmANi gatvA vAsasthAnAni prApya bhakSyadravyANi krEtuM jananivahaM bhavAn visRjatu|</para>
  <para style="p">
    <verse number="13" style="v"/>tadA sa uvAca, yUyamEva tAn bhEjayadhvaM; tatastE prOcurasmAkaM nikaTE kEvalaM panjca pUpA dvau matsyau ca vidyantE, ataEva sthAnAntaram itvA nimittamEtESAM bhakSyadravyESu na krItESu na bhavati|</para>
  <para style="p">
    <verse number="14" style="v"/>tatra prAyENa panjcasahasrANi puruSA Asan|</para>
  <para style="p">
    <verse number="15" style="v"/>tadA sa ziSyAn jagAda panjcAzat panjcAzajjanaiH paMktIkRtya tAnupavEzayata, tasmAt tE tadanusArENa sarvvalOkAnupavEzayApAsuH|</para>
  <para style="p">
    <verse number="16" style="v"/>tataH sa tAn panjca pUpAn mInadvayanjca gRhItvA svargaM vilOkyEzvaraguNAn kIrttayAnjcakrE bhagktA ca lOkEbhyaH parivESaNArthaM ziSyESu samarpayAmbabhUva|</para>
  <para style="p">
    <verse number="17" style="v"/>tataH sarvvE bhuktvA tRptiM gatA avaziSTAnAnjca dvAdaza PallakAn saMjagRhuH|</para>
  <para style="p">
    <verse number="18" style="v"/>athaikadA nirjanE ziSyaiH saha prArthanAkAlE tAn papraccha, lOkA mAM kaM vadanti?</para>
  <para style="p">
    <verse number="19" style="v"/>tatastE prAcuH, tvAM yOhanmajjakaM vadanti; kEcit tvAm EliyaM vadanti, pUrvvakAlikaH kazcid bhaviSyadvAdI zmazAnAd udatiSThad ityapi kEcid vadanti|</para>
  <para style="p">
    <verse number="20" style="v"/>tadA sa uvAca, yUyaM mAM kaM vadatha? tataH pitara uktavAn tvam IzvarAbhiSiktaH puruSaH|</para>
  <para style="p">
    <verse number="21" style="v"/>tadA sa tAn dRPhamAdidEza, kathAmEtAM kasmaicidapi mA kathayata|</para>
  <para style="p">
    <verse number="22" style="v"/>sa punaruvAca, manuSyaputrENa vahuyAtanA bhOktavyAH prAcInalOkaiH pradhAnayAjakairadhyApakaizca sOvajnjAya hantavyaH kintu tRtIyadivasE zmazAnAt tEnOtthAtavyam|</para>
  <para style="p">
    <verse number="23" style="v"/>aparaM sa sarvvAnuvAca, kazcid yadi mama pazcAd gantuM vAnjchati tarhi sa svaM dAmyatu, dinE dinE kruzaM gRhItvA ca mama pazcAdAgacchatu|</para>
  <para style="p">
    <verse number="24" style="v"/>yatO yaH kazcit svaprANAn rirakSiSati sa tAn hArayiSyati, yaH kazcin madarthaM prANAn hArayiSyati sa tAn rakSiSyati|</para>
  <para style="p">
    <verse number="25" style="v"/>kazcid yadi sarvvaM jagat prApnOti kintu svaprANAn hArayati svayaM vinazyati ca tarhi tasya kO lAbhaH?</para>
  <para style="p">
    <verse number="26" style="v"/>puna ryaH kazcin mAM mama vAkyaM vA lajjAspadaM jAnAti manuSyaputrO yadA svasya pituzca pavitrANAM dUtAnAnjca tEjObhiH parivESTita AgamiSyati tadA sOpi taM lajjAspadaM jnjAsyati|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu yuSmAnahaM yathArthaM vadAmi, IzvarIyarAjatvaM na dRSTavA mRtyuM nAsvAdiSyantE, EtAdRzAH kiyantO lOkA atra sthanE'pi daNPAyamAnAH santi|</para>
  <para style="p">
    <verse number="28" style="v"/>EtadAkhyAnakathanAt paraM prAyENASTasu dinESu gatESu sa pitaraM yOhanaM yAkUbanjca gRhItvA prArthayituM parvvatamEkaM samArurOha|</para>
  <para style="p">
    <verse number="29" style="v"/>atha tasya prArthanakAlE tasya mukhAkRtiranyarUpA jAtA, tadIyaM vastramujjvalazuklaM jAtaM|</para>
  <para style="p">
    <verse number="30" style="v"/>aparanjca mUsA EliyazcObhau tEjasvinau dRSTau</para>
  <para style="p">
    <verse number="31" style="v"/>tau tEna yirUzAlampurE yO mRtyuH sAdhiSyatE tadIyAM kathAM tEna sArddhaM kathayitum ArEbhAtE|</para>
  <para style="p">
    <verse number="32" style="v"/>tadA pitarAdayaH svasya sagginO nidrayAkRSTA Asan kintu jAgaritvA tasya tEjastEna sArddham uttiSThantau janau ca dadRzuH|</para>
  <para style="p">
    <verse number="33" style="v"/>atha tayOrubhayO rgamanakAlE pitarO yIzuM babhASE, hE gurO'smAkaM sthAnE'smin sthitiH zubhA, tata EkA tvadarthA, EkA mUsArthA, EkA EliyArthA, iti tisraH kuTyOsmAbhi rnirmmIyantAM, imAM kathAM sa na vivicya kathayAmAsa|</para>
  <para style="p">
    <verse number="34" style="v"/>aparanjca tadvAkyavadanakAlE payOda Eka Agatya tESAmupari chAyAM cakAra, tatastanmadhyE tayOH pravEzAt tE zazagkirE|</para>
  <para style="p">
    <verse number="35" style="v"/>tadA tasmAt payOdAd iyamAkAzIyA vANI nirjagAma, mamAyaM priyaH putra Etasya kathAyAM manO nidhatta|</para>
  <para style="p">
    <verse number="36" style="v"/>iti zabdE jAtE tE yIzumEkAkinaM dadRzuH kintu tE tadAnIM tasya darzanasya vAcamEkAmapi nOktvA manaHsu sthApayAmAsuH|</para>
  <para style="p">
    <verse number="37" style="v"/>parE'hani tESu tasmAcchailAd avarUPhESu taM sAkSAt karttuM bahavO lOkA AjagmuH|</para>
  <para style="p">
    <verse number="38" style="v"/>tESAM madhyAd EkO jana uccairuvAca, hE gurO ahaM vinayaM karOmi mama putraM prati kRpAdRSTiM karOtu, mama sa EvaikaH putraH|</para>
  <para style="p">
    <verse number="39" style="v"/>bhUtEna dhRtaH san saM prasabhaM cIcchabdaM karOti tanmukhAt phENA nirgacchanti ca, bhUta itthaM vidAryya kliSTvA prAyazastaM na tyajati|</para>
  <para style="p">
    <verse number="40" style="v"/>tasmAt taM bhUtaM tyAjayituM tava ziSyasamIpE nyavEdayaM kintu tE na zEkuH|</para>
  <para style="p">
    <verse number="41" style="v"/>tadA yIzuravAdIt, rE AvizvAsin vipathagAmin vaMza katikAlAn yuSmAbhiH saha sthAsyAmyahaM yuSmAkam AcaraNAni ca sahiSyE? tava putramihAnaya|</para>
  <para style="p">
    <verse number="42" style="v"/>tatastasminnAgatamAtrE bhUtastaM bhUmau pAtayitvA vidadAra; tadA yIzustamamEdhyaM bhUtaM tarjayitvA bAlakaM svasthaM kRtvA tasya pitari samarpayAmAsa|</para>
  <para style="p">
    <verse number="43" style="v"/>Izvarasya mahAzaktim imAM vilOkya sarvvE camaccakruH; itthaM yIzOH sarvvAbhiH kriyAbhiH sarvvairlOkairAzcaryyE manyamAnE sati sa ziSyAn babhASE,</para>
  <para style="p">
    <verse number="44" style="v"/>kathEyaM yuSmAkaM karNESu pravizatu, manuSyaputrO manuSyANAM karESu samarpayiSyatE|</para>
  <para style="p">
    <verse number="45" style="v"/>kintu tE tAM kathAM na bubudhirE, spaSTatvAbhAvAt tasyA abhiprAyastESAM bOdhagamyO na babhUva; tasyA AzayaH ka ityapi tE bhayAt praSTuM na zEkuH|</para>
  <para style="p">
    <verse number="46" style="v"/>tadanantaraM tESAM madhyE kaH zrESThaH kathAmEtAM gRhItvA tE mithO vivAdaM cakruH|</para>
  <para style="p">
    <verse number="47" style="v"/>tatO yIzustESAM manObhiprAyaM viditvA bAlakamEkaM gRhItvA svasya nikaTE sthApayitvA tAn jagAda,</para>
  <para style="p">
    <verse number="48" style="v"/>yO janO mama nAmnAsya bAlAsyAtithyaM vidadhAti sa mamAtithyaM vidadhAti, yazca mamAtithyaM vidadhAti sa mama prErakasyAtithyaM vidadhAti, yuSmAkaM madhyEyaH svaM sarvvasmAt kSudraM jAnItE sa Eva zrESThO bhaviSyati|</para>
  <para style="p">
    <verse number="49" style="v"/>aparanjca yOhan vyAjahAra hE prabhEा tava nAmnA bhUtAn tyAjayantaM mAnuSam EkaM dRSTavantO vayaM, kintvasmAkam apazcAd gAmitvAt taM nyaSEdhAm| tadAnIM yIzuruvAca,</para>
  <para style="p">
    <verse number="50" style="v"/>taM mA niSEdhata, yatO yO janOsmAkaM na vipakSaH sa EvAsmAkaM sapakSO bhavati|</para>
  <para style="p">
    <verse number="51" style="v"/>anantaraM tasyArOhaNasamaya upasthitE sa sthiracEtA yirUzAlamaM prati yAtrAM karttuM nizcityAgrE dUtAn prESayAmAsa|</para>
  <para style="p">
    <verse number="52" style="v"/>tasmAt tE gatvA tasya prayOjanIyadravyANi saMgrahItuM zOmirONIyAnAM grAmaM pravivizuH|</para>
  <para style="p">
    <verse number="53" style="v"/>kintu sa yirUzAlamaM nagaraM yAti tatO hEtO rlOkAstasyAtithyaM na cakruH|</para>
  <para style="p">
    <verse number="54" style="v"/>ataEva yAkUbyOhanau tasya ziSyau tad dRSTvA jagadatuH, hE prabhO EliyO yathA cakAra tathA vayamapi kiM gagaNAd Agantum EtAn bhasmIkarttunjca vahnimAjnjApayAmaH? bhavAn kimicchati?</para>
  <para style="p">
    <verse number="55" style="v"/>kintu sa mukhaM parAvartya tAn tarjayitvA gaditavAn yuSmAkaM manObhAvaH kaH, iti yUyaM na jAnItha|</para>
  <para style="p">
    <verse number="56" style="v"/>manujasutO manujAnAM prANAn nAzayituM nAgacchat, kintu rakSitum Agacchat| pazcAd itaragrAmaM tE yayuH|</para>
  <para style="p">
    <verse number="57" style="v"/>tadanantaraM pathi gamanakAlE jana EkastaM babhASE, hE prabhO bhavAn yatra yAti bhavatA sahAhamapi tatra yAsyAmi|</para>
  <para style="p">
    <verse number="58" style="v"/>tadAnIM yIzustamuvAca, gOmAyUnAM garttA AsatE, vihAyasIyavihagAाnAM nIPAni ca santi, kintu mAnavatanayasya ziraH sthApayituM sthAnaM nAsti|</para>
  <para style="p">
    <verse number="59" style="v"/>tataH paraM sa itarajanaM jagAda, tvaM mama pazcAd Ehi; tataH sa uvAca, hE prabhO pUrvvaM pitaraM zmazAnE sthApayituM mAmAdizatu|</para>
  <para style="p">
    <verse number="60" style="v"/>tadA yIzuruvAca, mRtA mRtAn zmazAnE sthApayantu kintu tvaM gatvEzvarIyarAjyasya kathAM pracAraya|</para>
  <para style="p">
    <verse number="61" style="v"/>tatOnyaH kathayAmAsa, hE prabhO mayApi bhavataH pazcAd gaMsyatE, kintu pUrvvaM mama nivEzanasya parijanAnAm anumatiM grahItum ahamAdizyai bhavatA|</para>
  <para style="p">
    <verse number="62" style="v"/>tadAnIM yIzustaM prOktavAn, yO janO lAggalE karamarpayitvA pazcAt pazyati sa IzvarIyarAjyaM nArhati|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataH paraM prabhuraparAn saptatiziSyAn niyujya svayaM yAni nagarANi yAni sthAnAni ca gamiSyati tAni nagarANi tAni sthAnAni ca prati dvau dvau janau prahitavAn|</para>
  <para style="p">
    <verse number="2" style="v"/>tEbhyaH kathayAmAsa ca zasyAni bahUnIti satyaM kintu chEdakA alpE; tasmAddhEtOH zasyakSEtrE chEdakAn aparAnapi prESayituM kSEtrasvAminaM prArthayadhvaM|</para>
  <para style="p">
    <verse number="3" style="v"/>yUyaM yAta, pazyata, vRkANAM madhyE mESazAvakAniva yuSmAn prahiNOmi|</para>
  <para style="p">
    <verse number="4" style="v"/>yUyaM kSudraM mahad vA vasanasampuTakaM pAdukAzca mA gRhlIta, mArgamadhyE kamapi mA namata ca|</para>
  <para style="p">
    <verse number="5" style="v"/>aparanjca yUyaM yad yat nivEzanaM pravizatha tatra nivEzanasyAsya maggalaM bhUyAditi vAkyaM prathamaM vadata|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmAt tasmin nivEzanE yadi maggalapAtraM sthAsyati tarhi tanmaggalaM tasya bhaviSyati, nOcEt yuSmAn prati parAvarttiSyatE|</para>
  <para style="p">
    <verse number="7" style="v"/>aparanjca tE yatkinjcid dAsyanti tadEva bhuktvA pItvA tasminnivEzanE sthAsyatha; yataH karmmakArI janO bhRtim arhati; gRhAd gRhaM mA yAsyatha|</para>
  <para style="p">
    <verse number="8" style="v"/>anyacca yuSmAsu kimapi nagaraM praviSTESu lOkA yadi yuSmAkam AtithyaM kariSyanti, tarhi yat khAdyam upasthAsyanti tadEva khAdiSyatha|</para>
  <para style="p">
    <verse number="9" style="v"/>tannagarasthAn rOgiNaH svasthAn kariSyatha, IzvarIyaM rAjyaM yuSmAkam antikam Agamat kathAmEtAnjca pracArayiSyatha|</para>
  <para style="p">
    <verse number="10" style="v"/>kintu kimapi puraM yuSmAsu praviSTESu lOkA yadi yuSmAkam AtithyaM na kariSyanti, tarhi tasya nagarasya panthAnaM gatvA kathAmEtAM vadiSyatha,</para>
  <para style="p">
    <verse number="11" style="v"/>yuSmAkaM nagarIyA yA dhUlyO'smAsu samalagan tA api yuSmAkaM prAtikUlyEna sAkSyArthaM sampAtayAmaH; tathApIzvararAjyaM yuSmAkaM samIpam Agatam iti nizcitaM jAnIta|</para>
  <para style="p">
    <verse number="12" style="v"/>ahaM yuSmabhyaM yathArthaM kathayAmi, vicAradinE tasya nagarasya dazAtaH sidOmO dazA sahyA bhaviSyati|</para>
  <para style="p">
    <verse number="13" style="v"/>hA hA kOrAsIn nagara, hA hA baitsaidAnagara yuvayOrmadhyE yAdRzAni AzcaryyANi karmmANyakriyanta, tAni karmmANi yadi sOrasIdOnO rnagarayOrakAriSyanta, tadA itO bahudinapUrvvaM tannivAsinaH zaNavastrANi paridhAya gAtrESu bhasma vilipya samupavizya samakhEtsyanta|</para>
  <para style="p">
    <verse number="14" style="v"/>atO vicAradivasE yuSmAkaM dazAtaH sOrasIdOnnivAsinAM dazA sahyA bhaviSyati|</para>
  <para style="p">
    <verse number="15" style="v"/>hE kapharnAhUm, tvaM svargaM yAvad unnatA kintu narakaM yAvat nyagbhaviSyasi|</para>
  <para style="p">
    <verse number="16" style="v"/>yO janO yuSmAkaM vAkyaM gRhlAti sa mamaiva vAkyaM gRhlAti; kinjca yO janO yuSmAkam avajnjAM karOti sa mamaivAvajnjAM karOti; yO janO mamAvajnjAM karOti ca sa matprErakasyaivAvajnjAM karOti|</para>
  <para style="p">
    <verse number="17" style="v"/>atha tE saptatiziSyA AnandEna pratyAgatya kathayAmAsuH, hE prabhO bhavatO nAmnA bhUtA apyasmAkaM vazIbhavanti|</para>
  <para style="p">
    <verse number="18" style="v"/>tadAnIM sa tAn jagAda, vidyutamiva svargAt patantaM zaitAnam adarzam|</para>
  <para style="p">
    <verse number="19" style="v"/>pazyata sarpAn vRzcikAn ripOH sarvvaparAkramAMzca padatalai rdalayituM yuSmabhyaM zaktiM dadAmi tasmAd yuSmAkaM kApi hAni rna bhaviSyati|</para>
  <para style="p">
    <verse number="20" style="v"/>bhUtA yuSmAkaM vazIbhavanti, Etannimittat mA samullasata, svargE yuSmAkaM nAmAni likhitAni santIti nimittaM samullasata|</para>
  <para style="p">
    <verse number="21" style="v"/>tadghaTikAyAM yIzu rmanasi jAtAhlAdaH kathayAmAsa hE svargapRthivyOrEkAdhipatE pitastvaM jnjAnavatAM viduSAnjca lOkAnAM purastAt sarvvamEtad aprakAzya bAlakAnAM purastAt prAkAzaya EtasmAddhEtOstvAM dhanyaM vadAmi, hE pitaritthaM bhavatu yad EtadEva tava gOcara uttamam|</para>
  <para style="p">
    <verse number="22" style="v"/>pitrA sarvvANi mayi samarpitAni pitaraM vinA kOpi putraM na jAnAti kinjca putraM vinA yasmai janAya putrastaM prakAzitavAn tanjca vinA kOpi pitaraM na jAnAti|</para>
  <para style="p">
    <verse number="23" style="v"/>tapaH paraM sa ziSyAn prati parAvRtya guptaM jagAda, yUyamEtAni sarvvANi pazyatha tatO yuSmAkaM cakSUMSi dhanyAni|</para>
  <para style="p">
    <verse number="24" style="v"/>yuSmAnahaM vadAmi, yUyaM yAni sarvvANi pazyatha tAni bahavO bhaviSyadvAdinO bhUpatayazca draSTumicchantOpi draSTuM na prApnuvan, yuSmAbhi ryA yAH kathAzca zrUyantE tAH zrOtumicchantOpi zrOtuM nAlabhanta|</para>
  <para style="p">
    <verse number="25" style="v"/>anantaram EkO vyavasthApaka utthAya taM parIkSituM papraccha, hE upadEzaka anantAyuSaH prAptayE mayA kiM karaNIyaM?</para>
  <para style="p">
    <verse number="26" style="v"/>yIzuH pratyuvAca, atrArthE vyavasthAyAM kiM likhitamasti? tvaM kIdRk paThasi?</para>
  <para style="p">
    <verse number="27" style="v"/>tataH sOvadat, tvaM sarvvAntaHkaraNaiH sarvvaprANaiH sarvvazaktibhiH sarvvacittaizca prabhau paramEzvarE prEma kuru, samIpavAsini svavat prEma kuru ca|</para>
  <para style="p">
    <verse number="28" style="v"/>tadA sa kathayAmAsa, tvaM yathArthaM pratyavOcaH, ittham Acara tEnaiva jIviSyasi|</para>
  <para style="p">
    <verse number="29" style="v"/>kintu sa janaH svaM nirddOSaM jnjApayituM yIzuM papraccha, mama samIpavAsI kaH? tatO yIzuH pratyuvAca,</para>
  <para style="p">
    <verse number="30" style="v"/>EkO janO yirUzAlampurAd yirIhOpuraM yAti, Etarhi dasyUnAM karESu patitE tE tasya vastrAdikaM hRtavantaH tamAhatya mRtaprAyaM kRtvA tyaktvA yayuH|</para>
  <para style="p">
    <verse number="31" style="v"/>akasmAd EkO yAjakastEna mArgENa gacchan taM dRSTvA mArgAnyapArzvEna jagAma|</para>
  <para style="p">
    <verse number="32" style="v"/>ittham EkO lEvIyastatsthAnaM prApya tasyAntikaM gatvA taM vilOkyAnyEna pArzvEna jagAma|</para>
  <para style="p">
    <verse number="33" style="v"/>kintvEkaH zOmirONIyO gacchan tatsthAnaM prApya taM dRSTvAdayata|</para>
  <para style="p">
    <verse number="34" style="v"/>tasyAntikaM gatvA tasya kSatESu tailaM drAkSArasanjca prakSipya kSatAni baddhvA nijavAhanOpari tamupavEzya pravAsIyagRham AnIya taM siSEvE|</para>
  <para style="p">
    <verse number="35" style="v"/>parasmin divasE nijagamanakAlE dvau mudrApAdau tadgRhasvAminE dattvAvadat janamEnaM sEvasva tatra yO'dhikO vyayO bhaviSyati tamahaM punarAgamanakAlE parizOtsyAmi|</para>
  <para style="p">
    <verse number="36" style="v"/>ESAM trayANAM madhyE tasya dasyuhastapatitasya janasya samIpavAsI kaH? tvayA kiM budhyatE?</para>
  <para style="p">
    <verse number="37" style="v"/>tataH sa vyavasthApakaH kathayAmAsa yastasmin dayAM cakAra| tadA yIzuH kathayAmAsa tvamapi gatvA tathAcara|</para>
  <para style="p">
    <verse number="38" style="v"/>tataH paraM tE gacchanta EkaM grAmaM pravivizuH; tadA marthAnAmA strI svagRhE tasyAtithyaM cakAra|</para>
  <para style="p">
    <verse number="39" style="v"/>tasmAt mariyam nAmadhEyA tasyA bhaginI yIzOH padasamIpa uvavizya tasyOpadEzakathAM zrOtumArEbhE|</para>
  <para style="p">
    <verse number="40" style="v"/>kintu marthA nAnAparicaryyAyAM vyagrA babhUva tasmAddhEtOstasya samIpamAgatya babhASE; hE prabhO mama bhaginI kEvalaM mamOpari sarvvakarmmaNAM bhAram arpitavatI tatra bhavatA kinjcidapi na manO nidhIyatE kim? mama sAhAyyaM karttuM bhavAn tAmAdizatu|</para>
  <para style="p">
    <verse number="41" style="v"/>tatO yIzuH pratyuvAca hE marthE hE marthE, tvaM nAnAkAryyESu cintitavatI vyagrA cAsi,</para>
  <para style="p">
    <verse number="42" style="v"/>kintu prayOjanIyam EkamAtram AstE| aparanjca yamuttamaM bhAgaM kOpi harttuM na zaknOti saEva mariyamA vRtaH|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM sa kasmiMzcit sthAnE prArthayata tatsamAptau satyAM tasyaikaH ziSyastaM jagAda hE prabhO yOhan yathA svaziSyAn prArthayitum upadiSTavAn tathA bhavAnapyasmAn upadizatu|</para>
  <para style="p">
    <verse number="2" style="v"/>tasmAt sa kathayAmAsa, prArthanakAlE yUyam itthaM kathayadhvaM, hE asmAkaM svargasthapitastava nAma pUjyaM bhavatu; tava rAjatvaM bhavatu; svargE yathA tathA pRthivyAmapi tavEcchayA sarvvaM bhavatu|</para>
  <para style="p">
    <verse number="3" style="v"/>pratyaham asmAkaM prayOjanIyaM bhOjyaM dEhi|</para>
  <para style="p">
    <verse number="4" style="v"/>yathA vayaM sarvvAn aparAdhinaH kSamAmahE tathA tvamapi pApAnyasmAkaM kSamasva| asmAn parIkSAM mAnaya kintu pApAtmanO rakSa|</para>
  <para style="p">
    <verse number="5" style="v"/>pazcAt sOparamapi kathitavAn yadi yuSmAkaM kasyacid bandhustiSThati nizIthE ca tasya samIpaM sa gatvA vadati,</para>
  <para style="p">
    <verse number="6" style="v"/>hE bandhO pathika EkO bandhu rmama nivEzanam AyAtaH kintu tasyAtithyaM karttuM mamAntikE kimapi nAsti, ataEva pUpatrayaM mahyam RNaM dEhi;</para>
  <para style="p">
    <verse number="7" style="v"/>tadA sa yadi gRhamadhyAt prativadati mAM mA klizAna, idAnIM dvAraM ruddhaM zayanE mayA saha bAlakAzca tiSThanti tubhyaM dAtum utthAtuM na zaknOmi,</para>
  <para style="p">
    <verse number="8" style="v"/>tarhi yuSmAnahaM vadAmi, sa yadi mitratayA tasmai kimapi dAtuM nOttiSThati tathApi vAraM vAraM prArthanAta utthApitaH san yasmin tasya prayOjanaM tadEva dAsyati|</para>
  <para style="p">
    <verse number="9" style="v"/>ataH kAraNAt kathayAmi, yAcadhvaM tatO yuSmabhyaM dAsyatE, mRgayadhvaM tata uddEzaM prApsyatha, dvAram Ahata tatO yuSmabhyaM dvAraM mOkSyatE|</para>
  <para style="p">
    <verse number="10" style="v"/>yO yAcatE sa prApnOti, yO mRgayatE sa EvOddEzaM prApnOti, yO dvAram Ahanti tadarthaM dvAraM mOcyatE|</para>
  <para style="p">
    <verse number="11" style="v"/>putrENa pUpE yAcitE tasmai pASANaM dadAti vA matsyE yAcitE tasmai sarpaM dadAti</para>
  <para style="p">
    <verse number="12" style="v"/>vA aNPE yAcitE tasmai vRzcikaM dadAti yuSmAkaM madhyE ka EtAdRzaH pitAstE?</para>
  <para style="p">
    <verse number="13" style="v"/>tasmAdEva yUyamabhadrA api yadi svasvabAlakEbhya uttamAni dravyANi dAtuM jAnItha tarhyasmAkaM svargasthaH pitA nijayAcakEbhyaH kiM pavitram AtmAnaM na dAsyati?</para>
  <para style="p">
    <verse number="14" style="v"/>anantaraM yIzunA kasmAccid Ekasmin mUkabhUtE tyAjitE sati sa bhUtatyaktO mAnuSO vAkyaM vaktum ArEbhE; tatO lOkAH sakalA AzcaryyaM mEnirE|</para>
  <para style="p">
    <verse number="15" style="v"/>kintu tESAM kEcidUcu rjanOyaM bAlasibUbA arthAd bhUtarAjEna bhUtAn tyAjayati|</para>
  <para style="p">
    <verse number="16" style="v"/>taM parIkSituM kEcid AkAzIyam EkaM cihnaM darzayituM taM prArthayAnjcakrirE|</para>
  <para style="p">
    <verse number="17" style="v"/>tadA sa tESAM manaHkalpanAM jnjAtvA kathayAmAsa, kasyacid rAjyasya lOkA yadi parasparaM virundhanti tarhi tad rAjyam nazyati; kEcid gRhasthA yadi parasparaM virundhanti tarhi tEpi nazyanti|</para>
  <para style="p">
    <verse number="18" style="v"/>tathaiva zaitAnapi svalOkAn yadi viruNaddhi tadA tasya rAjyaM kathaM sthAsyati? bAlasibUbAhaM bhUtAn tyAjayAmi yUyamiti vadatha|</para>
  <para style="p">
    <verse number="19" style="v"/>yadyahaM bAlasibUbA bhUtAn tyAjayAmi tarhi yuSmAkaM santAnAH kEna tyAjayanti? tasmAt taEva kathAyA EtasyA vicArayitArO bhaviSyanti|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu yadyaham Izvarasya parAkramENa bhUtAn tyAjayAmi tarhi yuSmAkaM nikaTam Izvarasya rAjyamavazyam upatiSThati|</para>
  <para style="p">
    <verse number="21" style="v"/>balavAn pumAn susajjamAnO yatikAlaM nijATTAlikAM rakSati tatikAlaM tasya dravyaM nirupadravaM tiSThati|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu tasmAd adhikabalaH kazcidAgatya yadi taM jayati tarhi yESu zastrAstrESu tasya vizvAsa AsIt tAni sarvvANi hRtvA tasya dravyANi gRhlAti|</para>
  <para style="p">
    <verse number="23" style="v"/>ataH kAraNAd yO mama sapakSO na sa vipakSaH, yO mayA saha na saMgRhlAti sa vikirati|</para>
  <para style="p">
    <verse number="24" style="v"/>aparanjca amEdhyabhUtO mAnuSasyAntarnirgatya zuSkasthAnE bhrAntvA vizrAmaM mRgayatE kintu na prApya vadati mama yasmAd gRhAd AgatOhaM punastad gRhaM parAvRtya yAmi|</para>
  <para style="p">
    <verse number="25" style="v"/>tatO gatvA tad gRhaM mArjitaM zObhitanjca dRSTvA</para>
  <para style="p">
    <verse number="26" style="v"/>tatkSaNam apagatya svasmAdapi durmmatIn aparAn saptabhUtAn sahAnayati tE ca tadgRhaM pavizya nivasanti| tasmAt tasya manuSyasya prathamadazAtaH zESadazA duHkhatarA bhavati|</para>
  <para style="p">
    <verse number="27" style="v"/>asyAH kathAyAH kathanakAlE janatAmadhyasthA kAcinnArI tamuccaiHsvaraM prOvAca, yA yOSit tvAM garbbhE'dhArayat stanyamapAyayacca saiva dhanyA|</para>
  <para style="p">
    <verse number="28" style="v"/>kintu sOkathayat yE paramEzvarasya kathAM zrutvA tadanurUpam Acaranti taEva dhanyAH|</para>
  <para style="p">
    <verse number="29" style="v"/>tataH paraM tasyAntikE bahulOkAnAM samAgamE jAtE sa vaktumArEbhE, AdhunikA duSTalOkAzcihnaM draSTumicchanti kintu yUnasbhaviSyadvAdinazcihnaM vinAnyat kinjciccihnaM tAn na darzayiSyatE|</para>
  <para style="p">
    <verse number="30" style="v"/>yUnas tu yathA nInivIyalOkAnAM samIpE cihnarUpObhavat tathA vidyamAnalOkAnAm ESAM samIpE manuSyaputrOpi cihnarUpO bhaviSyati|</para>
  <para style="p">
    <verse number="31" style="v"/>vicArasamayE idAnIntanalOkAnAM prAtikUlyEna dakSiNadEzIyA rAjnjI prOtthAya tAn dOSiNaH kariSyati, yataH sA rAjnjI sulEmAna upadEzakathAM zrOtuM pRthivyAH sImAta Agacchat kintu pazyata sulEmAnOpi gurutara EkO janO'smin sthAnE vidyatE|</para>
  <para style="p">
    <verse number="32" style="v"/>aparanjca vicArasamayE nInivIyalOkA api varttamAnakAlikAnAM lOkAnAM vaiparItyEna prOtthAya tAn dOSiNaH kariSyanti, yatO hEtOstE yUnasO vAkyAt cittAni parivarttayAmAsuH kintu pazyata yUnasOtigurutara EkO janO'smin sthAnE vidyatE|</para>
  <para style="p">
    <verse number="33" style="v"/>pradIpaM prajvAlya drONasyAdhaH kutrApi guptasthAnE vA kOpi na sthApayati kintu gRhapravEzibhyO dIptiM dAtaM dIpAdhArOparyyEva sthApayati|</para>
  <para style="p">
    <verse number="34" style="v"/>dEhasya pradIpazcakSustasmAdEva cakSu ryadi prasannaM bhavati tarhi tava sarvvazarIraM dIptimad bhaviSyati kintu cakSu ryadi malImasaM tiSThati tarhi sarvvazarIraM sAndhakAraM sthAsyati|</para>
  <para style="p">
    <verse number="35" style="v"/>asmAt kAraNAt tavAntaHsthaM jyOti ryathAndhakAramayaM na bhavati tadarthE sAvadhAnO bhava|</para>
  <para style="p">
    <verse number="36" style="v"/>yataH zarIrasya kutrApyaMzE sAndhakArE na jAtE sarvvaM yadi dIptimat tiSThati tarhi tubhyaM dIptidAyiprOjjvalan pradIpa iva tava savarvazarIraM dIptimad bhaviSyati|</para>
  <para style="p">
    <verse number="37" style="v"/>EtatkathAyAH kathanakAlE phiruzyEkO bhEjanAya taM nimantrayAmAsa, tataH sa gatvA bhOktum upavivEza|</para>
  <para style="p">
    <verse number="38" style="v"/>kintu bhOjanAt pUrvvaM nAmAgkSIt Etad dRSTvA sa phiruzyAzcaryyaM mEnE|</para>
  <para style="p">
    <verse number="39" style="v"/>tadA prabhustaM prOvAca yUyaM phirUzilOkAH pAnapAtrANAM bhOjanapAtrANAnjca bahiH pariSkurutha kintu yuSmAkamanta rdaurAtmyai rduSkriyAbhizca paripUrNaM tiSThati|</para>
  <para style="p">
    <verse number="40" style="v"/>hE sarvvE nirbOdhA yO bahiH sasarja sa Eva kimanta rna sasarja?</para>
  <para style="p">
    <verse number="41" style="v"/>tata Eva yuSmAbhirantaHkaraNaM (IzvarAya) nivEdyatAM tasmin kRtE yuSmAkaM sarvvANi zucitAM yAsyanti|</para>
  <para style="p">
    <verse number="42" style="v"/>kintu hanta phirUzigaNA yUyaM nyAyam IzvarE prEma ca parityajya pOdinAyA arudAdInAM sarvvESAM zAkAnAnjca dazamAMzAn dattha kintu prathamaM pAlayitvA zESasyAlagghanaM yuSmAkam ucitamAsIt|</para>
  <para style="p">
    <verse number="43" style="v"/>hA hA phirUzinO yUyaM bhajanagEhE prOccAsanE ApaNESu ca namaskArESu prIyadhvE|</para>
  <para style="p">
    <verse number="44" style="v"/>vata kapaTinO'dhyApakAH phirUzinazca lOkAyat zmazAnam anupalabhya tadupari gacchanti yUyam tAdRgaprakAzitazmazAnavAd bhavatha|</para>
  <para style="p">
    <verse number="45" style="v"/>tadAnIM vyavasthApakAnAm EkA yIzumavadat, hE upadEzaka vAkyEnEdRzEnAsmAsvapi dOSam ArOpayasi|</para>
  <para style="p">
    <verse number="46" style="v"/>tataH sa uvAca, hA hA vyavasthApakA yUyam mAnuSANAm upari duHsahyAn bhArAn nyasyatha kintu svayam EkAgguुlyApi tAn bhArAn na spRzatha|</para>
  <para style="p">
    <verse number="47" style="v"/>hanta yuSmAkaM pUrvvapuruSA yAn bhaviSyadvAdinO'vadhiSustESAM zmazAnAni yUyaM nirmmAtha|</para>
  <para style="p">
    <verse number="48" style="v"/>tEnaiva yUyaM svapUrvvapuruSANAM karmmANi saMmanyadhvE tadEva sapramANaM kurutha ca, yatastE tAnavadhiSuH yUyaM tESAM zmazAnAni nirmmAtha|</para>
  <para style="p">
    <verse number="49" style="v"/>ataEva Izvarasya zAstrE prOktamasti tESAmantikE bhaviSyadvAdinaH prEritAMzca prESayiSyAmi tatastE tESAM kAMzcana haniSyanti kAMzcana tAPazSyinti|</para>
  <para style="p">
    <verse number="50" style="v"/>EtasmAt kAraNAt hAbilaH zONitapAtamArabhya mandirayajnjavEdyO rmadhyE hatasya sikhariyasya raktapAtaparyyantaM</para>
  <para style="p">
    <verse number="51" style="v"/>jagataH sRSTimArabhya pRthivyAM bhaviSyadvAdinAM yatiraktapAtA jAtAstatInAm aparAdhadaNPA ESAM varttamAnalOkAnAM bhaviSyanti, yuSmAnahaM nizcitaM vadAmi sarvvE daNPA vaMzasyAsya bhaviSyanti|</para>
  <para style="p">
    <verse number="52" style="v"/>hA hA vyavasthapakA yUyaM jnjAnasya kunjcikAM hRtvA svayaM na praviSTA yE pravESTunjca prayAsinastAnapi pravESTuM vAritavantaH|</para>
  <para style="p">
    <verse number="53" style="v"/>itthaM kathAkathanAd adhyApakAH phirUzinazca satarkAH</para>
  <para style="p">
    <verse number="54" style="v"/>santastamapavadituM tasya kathAyA dOSaM dharttamicchantO nAnAkhyAnakathanAya taM pravarttayituM kOpayitunjca prArEbhirE|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadAnIM lOkAH sahasraM sahasram Agatya samupasthitAstata EkaikO 'nyESAmupari patitum upacakramE; tadA yIzuH ziSyAn babhASE, yUyaM phirUzinAM kiNvarUpakApaTyE vizESENa sAvadhAnAstiSThata|</para>
  <para style="p">
    <verse number="2" style="v"/>yatO yanna prakAzayiSyatE tadAcchannaM vastu kimapi nAsti; tathA yanna jnjAsyatE tad guptaM vastu kimapi nAsti|</para>
  <para style="p">
    <verse number="3" style="v"/>andhakArE tiSThanatO yAH kathA akathayata tAH sarvvAH kathA dIptau zrOSyantE nirjanE karNE ca yadakathayata gRhapRSThAt tat pracArayiSyatE|</para>
  <para style="p">
    <verse number="4" style="v"/>hE bandhavO yuSmAnahaM vadAmi, yE zarIrasya nAzaM vinA kimapyaparaM karttuM na zakruvanti tEbhyO mA bhaiSTa|</para>
  <para style="p">
    <verse number="5" style="v"/>tarhi kasmAd bhEtavyam ityahaM vadAmi, yaH zarIraM nAzayitvA narakaM nikSEptuM zaknOti tasmAdEva bhayaM kuruta, punarapi vadAmi tasmAdEva bhayaM kuruta|</para>
  <para style="p">
    <verse number="6" style="v"/>panjca caTakapakSiNaH kiM dvAbhyAM tAmrakhaNPAbhyAM na vikrIyantE? tathApIzvarastESAm Ekamapi na vismarati|</para>
  <para style="p">
    <verse number="7" style="v"/>yuSmAkaM ziraHkEzA api gaNitAH santi tasmAt mA vibhIta bahucaTakapakSibhyOpi yUyaM bahumUlyAH|</para>
  <para style="p">
    <verse number="8" style="v"/>aparaM yuSmabhyaM kathayAmi yaH kazcin mAnuSANAM sAkSAn mAM svIkarOti manuSyaputra IzvaradUtAnAM sAkSAt taM svIkariSyati|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu yaH kazcinmAnuSANAM sAkSAnmAm asvIkarOti tam Izvarasya dUtAnAM sAkSAd aham asvIkariSyAmi|</para>
  <para style="p">
    <verse number="10" style="v"/>anyacca yaH kazcin manujasutasya nindAbhAvEna kAnjcit kathAM kathayati tasya tatpApasya mOcanaM bhaviSyati kintu yadi kazcit pavitram AtmAnaM nindati tarhi tasya tatpApasya mOcanaM na bhaviSyati|</para>
  <para style="p">
    <verse number="11" style="v"/>yadA lOkA yuSmAn bhajanagEhaM vicArakartRrAjyakartRNAM sammukhanjca nESyanti tadA kEna prakArENa kimuttaraM vadiSyatha kiM kathayiSyatha cEtyatra mA cintayata;</para>
  <para style="p">
    <verse number="12" style="v"/>yatO yuSmAbhiryad yad vaktavyaM tat tasmin samayaEva pavitra AtmA yuSmAn zikSayiSyati|</para>
  <para style="p">
    <verse number="13" style="v"/>tataH paraM janatAmadhyasthaH kazcijjanastaM jagAda hE gurO mayA saha paitRkaM dhanaM vibhaktuM mama bhrAtaramAjnjApayatu bhavAn|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu sa tamavadat hE manuSya yuvayO rvicAraM vibhAganjca karttuM mAM kO niyuktavAn?</para>
  <para style="p">
    <verse number="15" style="v"/>anantaraM sa lOkAnavadat lObhE sAvadhAnAH satarkAzca tiSThata, yatO bahusampattiprAptyA manuSyasyAyu rna bhavati|</para>
  <para style="p">
    <verse number="16" style="v"/>pazcAd dRSTAntakathAmutthApya kathayAmAsa, Ekasya dhaninO bhUmau bahUni zasyAni jAtAni|</para>
  <para style="p">
    <verse number="17" style="v"/>tataH sa manasA cintayitvA kathayAmbabhUva mamaitAni samutpannAni dravyANi sthApayituM sthAnaM nAsti kiM kariSyAmi?</para>
  <para style="p">
    <verse number="18" style="v"/>tatOvadad itthaM kariSyAmi, mama sarvvabhANPAgArANi bhagktvA bRhadbhANPAgArANi nirmmAya tanmadhyE sarvvaphalAni dravyANi ca sthApayiSyAmi|</para>
  <para style="p">
    <verse number="19" style="v"/>aparaM nijamanO vadiSyAmi, hE manO bahuvatsarArthaM nAnAdravyANi sanjcitAni santi vizrAmaM kuru bhuktvA pItvA kautukanjca kuru| kintvIzvarastam avadat,</para>
  <para style="p">
    <verse number="20" style="v"/>rE nirbOdha adya rAtrau tava prANAstvattO nESyantE tata EtAni yAni dravyANi tvayAsAditAni tAni kasya bhaviSyanti?</para>
  <para style="p">
    <verse number="21" style="v"/>ataEva yaH kazcid Izvarasya samIpE dhanasanjcayamakRtvA kEvalaM svanikaTE sanjcayaM karOti sOpi tAdRzaH|</para>
  <para style="p">
    <verse number="22" style="v"/>atha sa ziSyEbhyaH kathayAmAsa, yuSmAnahaM vadAmi, kiM khAdiSyAmaH? kiM paridhAsyAmaH? ityuktvA jIvanasya zarIrasya cArthaM cintAM mA kArSTa|</para>
  <para style="p">
    <verse number="23" style="v"/>bhakSyAjjIvanaM bhUSaNAccharIranjca zrESThaM bhavati|</para>
  <para style="p">
    <verse number="24" style="v"/>kAkapakSiNAM kAryyaM vicArayata, tE na vapanti zasyAni ca na chindanti, tESAM bhANPAgArANi na santi kOSAzca na santi, tathApIzvarastEbhyO bhakSyANi dadAti, yUyaM pakSibhyaH zrESThatarA na kiM?</para>
  <para style="p">
    <verse number="25" style="v"/>aparanjca bhAvayitvA nijAyuSaH kSaNamAtraM varddhayituM zaknOti, EtAdRzO lAkO yuSmAkaM madhyE kOsti?</para>
  <para style="p">
    <verse number="26" style="v"/>ataEva kSudraM kAryyaM sAdhayitum asamarthA yUyam anyasmin kAryyE kutO bhAvayatha?</para>
  <para style="p">
    <verse number="27" style="v"/>anyacca kAmpilapuSpaM kathaM varddhatE tadApi vicArayata, tat kanjcana zramaM na karOti tantUMzca na janayati kintu yuSmabhyaM yathArthaM kathayAmi sulEmAn bahvaizvaryyAnvitOpi puSpasyAsya sadRzO vibhUSitO nAsIt|</para>
  <para style="p">
    <verse number="28" style="v"/>adya kSEtrE varttamAnaM zvazcUllyAM kSEpsyamAnaM yat tRNaM, tasmai yadIzvara itthaM bhUSayati tarhi hE alpapratyayinO yuSmAna kiM na paridhApayiSyati?</para>
  <para style="p">
    <verse number="29" style="v"/>ataEva kiM khAdiSyAmaH? kiM paridhAsyAmaH? EtadarthaM mA cESTadhvaM mA saMdigdhvanjca|</para>
  <para style="p">
    <verse number="30" style="v"/>jagatO dEvArccakA EtAni sarvvANi cESTanatE; ESu vastuSu yuSmAkaM prayOjanamAstE iti yuSmAkaM pitA jAnAti|</para>
  <para style="p">
    <verse number="31" style="v"/>ataEvEzvarasya rAjyArthaM sacESTA bhavata tathA kRtE sarvvANyEtAni dravyANi yuSmabhyaM pradAyiSyantE|</para>
  <para style="p">
    <verse number="32" style="v"/>hE kSudramESavraja yUyaM mA bhaiSTa yuSmabhyaM rAjyaM dAtuM yuSmAkaM pituH sammatirasti|</para>
  <para style="p">
    <verse number="33" style="v"/>ataEva yuSmAkaM yA yA sampattirasti tAM tAM vikrIya vitarata, yat sthAnaM caurA nAgacchanti, kITAzca na kSAyayanti tAdRzE svargE nijArtham ajarE sampuTakE 'kSayaM dhanaM sanjcinuta ca;</para>
  <para style="p">
    <verse number="34" style="v"/>yatO yatra yuSmAkaM dhanaM varttatE tatrEva yuSmAkaM manaH|</para>
  <para style="p">
    <verse number="35" style="v"/>aparanjca yUyaM pradIpaM jvAlayitvA baddhakaTayastiSThata;</para>
  <para style="p">
    <verse number="36" style="v"/>prabhu rvivAhAdAgatya yadaiva dvAramAhanti tadaiva dvAraM mOcayituM yathA bhRtyA apEkSya tiSThanti tathA yUyamapi tiSThata|</para>
  <para style="p">
    <verse number="37" style="v"/>yataH prabhurAgatya yAn dAsAn sacEtanAn tiSThatO drakSyati taEva dhanyAH; ahaM yuSmAn yathArthaM vadAmi prabhustAn bhOjanArtham upavEzya svayaM baddhakaTiH samIpamEtya parivESayiSyati|</para>
  <para style="p">
    <verse number="38" style="v"/>yadi dvitIyE tRtIyE vA praharE samAgatya tathaiva pazyati, tarhi taEva dAsA dhanyAH|</para>
  <para style="p">
    <verse number="39" style="v"/>aparanjca kasmin kSaNE caurA AgamiSyanti iti yadi gRhapati rjnjAtuM zaknOti tadAvazyaM jAgran nijagRhE sandhiM karttayituM vArayati yUyamEtad vitta|</para>
  <para style="p">
    <verse number="40" style="v"/>ataEva yUyamapi sajjamAnAstiSThata yatO yasmin kSaNE taM nAprEkSadhvE tasminnEva kSaNE manuSyaputra AgamiSyati|</para>
  <para style="p">
    <verse number="41" style="v"/>tadA pitaraH papraccha, hE prabhO bhavAn kimasmAn uddizya kiM sarvvAn uddizya dRSTAntakathAmimAM vadati?</para>
  <para style="p">
    <verse number="42" style="v"/>tataH prabhuH prOvAca, prabhuH samucitakAlE nijaparivArArthaM bhOjyaparivESaNAya yaM tatpadE niyOkSyati tAdRzO vizvAsyO bOddhA karmmAdhIzaH kOsti?</para>
  <para style="p">
    <verse number="43" style="v"/>prabhurAgatya yam EtAdRzE karmmaNi pravRttaM drakSyati saEva dAsO dhanyaH|</para>
  <para style="p">
    <verse number="44" style="v"/>ahaM yuSmAn yathArthaM vadAmi sa taM nijasarvvasvasyAdhipatiM kariSyati|</para>
  <para style="p">
    <verse number="45" style="v"/>kintu prabhurvilambEnAgamiSyati, iti vicintya sa dAsO yadi tadanyadAsIdAsAn praharttum bhOktuM pAtuM maditunjca prArabhatE,</para>
  <para style="p">
    <verse number="46" style="v"/>tarhi yadA prabhuM nApEkSiSyatE yasmin kSaNE sO'cEtanazca sthAsyati tasminnEva kSaNE tasya prabhurAgatya taM padabhraSTaM kRtvA vizvAsahInaiH saha tasya aMzaM nirUpayiSyati|</para>
  <para style="p">
    <verse number="47" style="v"/>yO dAsaH prabhEाrAjnjAM jnjAtvApi sajjitO na tiSThati tadAjnjAnusArENa ca kAryyaM na karOti sOnEkAn prahArAn prApsyati;</para>
  <para style="p">
    <verse number="48" style="v"/>kintu yO janO'jnjAtvA prahArArhaM karmma karOti sOlpaprahArAn prApsyati| yatO yasmai bAhulyEna dattaM tasmAdEva bAhulyEna grahISyatE, mAnuSA yasya nikaTE bahu samarpayanti tasmAd bahu yAcantE|</para>
  <para style="p">
    <verse number="49" style="v"/>ahaM pRthivyAm anaikyarUpaM vahni nikSEptum AgatOsmi, sa cEd idAnImEva prajvalati tatra mama kA cintA?</para>
  <para style="p">
    <verse number="50" style="v"/>kintu yEna majjanEnAhaM magnO bhaviSyAmi yAvatkAlaM tasya siddhi rna bhaviSyati tAvadahaM katikaSTaM prApsyAmi|</para>
  <para style="p">
    <verse number="51" style="v"/>mElanaM karttuM jagad AgatOsmi yUyaM kimitthaM bOdhadhvE? yuSmAn vadAmi na tathA, kintvahaM mElanAbhAvaM karttuMm AgatOsmi|</para>
  <para style="p">
    <verse number="52" style="v"/>yasmAdEtatkAlamArabhya EkatrasthaparijanAnAM madhyE panjcajanAH pRthag bhUtvA trayO janA dvayOrjanayOH pratikUlA dvau janau ca trayANAM janAnAM pratikUlau bhaviSyanti|</para>
  <para style="p">
    <verse number="53" style="v"/>pitA putrasya vipakSaH putrazca pitu rvipakSO bhaviSyati mAtA kanyAyA vipakSA kanyA ca mAtu rvipakSA bhaviSyati, tathA zvazrUrbadhvA vipakSA badhUzca zvazrvA vipakSA bhaviSyati|</para>
  <para style="p">
    <verse number="54" style="v"/>sa lOkEbhyOparamapi kathayAmAsa, pazcimadizi mEghOdgamaM dRSTvA yUyaM haThAd vadatha vRSTi rbhaviSyati tatastathaiva jAyatE|</para>
  <para style="p">
    <verse number="55" style="v"/>aparaM dakSiNatO vAyau vAti sati vadatha nidAghO bhaviSyati tataH sOpi jAyatE|</para>
  <para style="p">
    <verse number="56" style="v"/>rE rE kapaTina AkAzasya bhUmyAzca lakSaNaM bOddhuM zaknutha,</para>
  <para style="p">
    <verse number="57" style="v"/>kintu kAlasyAsya lakSaNaM kutO bOddhuM na zaknutha? yUyanjca svayaM kutO na nyASyaM vicArayatha?</para>
  <para style="p">
    <verse number="58" style="v"/>aparanjca vivAdinA sArddhaM vicArayituH samIpaM gacchan pathi tasmAduddhAraM prAptuM yatasva nOcEt sa tvAM dhRtvA vicArayituH samIpaM nayati| vicArayitA yadi tvAM praharttuH samIpaM samarpayati praharttA tvAM kArAyAM badhnAti</para>
  <para style="p">
    <verse number="59" style="v"/>tarhi tvAmahaM vadAmi tvayA niHzESaM kapardakESu na parizOdhitESu tvaM tatO muktiM prAptuM na zakSyasi|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparanjca pIlAtO yESAM gAlIlIyAnAM raktAni balInAM raktaiH sahAmizrayat tESAM gAlIlIyAnAM vRttAntaM katipayajanA upasthApya yIzavE kathayAmAsuH|</para>
  <para style="p">
    <verse number="2" style="v"/>tataH sa pratyuvAca tESAM lOkAnAm EtAdRzI durgati rghaTitA tatkAraNAd yUyaM kimanyEbhyO gAlIlIyEbhyOpyadhikapApinastAn bOdhadhvE?</para>
  <para style="p">
    <verse number="3" style="v"/>yuSmAnahaM vadAmi tathA na kintu manaHsu na parAvarttitESu yUyamapi tathA naMkSyatha|</para>
  <para style="p">
    <verse number="4" style="v"/>aparanjca zIlOhanAmna uccagRhasya patanAd yE'STAdazajanA mRtAstE yirUzAlami nivAsisarvvalOkEbhyO'dhikAparAdhinaH kiM yUyamityaM bOdhadhvE?</para>
  <para style="p">
    <verse number="5" style="v"/>yuSmAnahaM vadAmi tathA na kintu manaHsu na parivarttitESu yUyamapi tathA naMkSyatha|</para>
  <para style="p">
    <verse number="6" style="v"/>anantaraM sa imAM dRSTAntakathAmakathayad EkO janO drAkSAkSEtramadhya EkamuPumbaravRkSaM rOpitavAn| pazcAt sa Agatya tasmin phalAni gavESayAmAsa,</para>
  <para style="p">
    <verse number="7" style="v"/>kintu phalAprAptEH kAraNAd udyAnakAraM bhRtyaM jagAda, pazya vatsaratrayaM yAvadAgatya EtasminnuPumbaratarau kSalAnyanvicchAmi, kintu naikamapi prapnOmi tarurayaM kutO vRthA sthAnaM vyApya tiSThati? EnaM chindhi|</para>
  <para style="p">
    <verse number="8" style="v"/>tatO bhRtyaH pratyuvAca, hE prabhO punarvarSamEkaM sthAtum Adiza; Etasya mUlasya caturdikSu khanitvAham AlavAlaM sthApayAmi|</para>
  <para style="p">
    <verse number="9" style="v"/>tataH phalituM zaknOti yadi na phalati tarhi pazcAt chEtsyasi|</para>
  <para style="p">
    <verse number="10" style="v"/>atha vizrAmavArE bhajanagEhE yIzurupadizati</para>
  <para style="p">
    <verse number="11" style="v"/>tasmit samayE bhUtagrastatvAt kubjIbhUyASTAdazavarSANi yAvat kEnApyupAyEna Rju rbhavituM na zaknOti yA durbbalA strI,</para>
  <para style="p">
    <verse number="12" style="v"/>tAM tatrOpasthitAM vilOkya yIzustAmAhUya kathitavAn hE nAri tava daurbbalyAt tvaM muktA bhava|</para>
  <para style="p">
    <verse number="13" style="v"/>tataH paraM tasyA gAtrE hastArpaNamAtrAt sA RjurbhUtvEzvarasya dhanyavAdaM karttumArEbhE|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu vizrAmavArE yIzunA tasyAH svAsthyakaraNAd bhajanagEhasyAdhipatiH prakupya lOkAn uvAca, SaTsu dinESu lOkaiH karmma karttavyaM tasmAddhEtOH svAsthyArthaM tESu dinESu Agacchata, vizrAmavArE mAgacchata|</para>
  <para style="p">
    <verse number="15" style="v"/>tadA pabhuH pratyuvAca rE kapaTinO yuSmAkam EkaikO janO vizrAmavArE svIyaM svIyaM vRSabhaM gardabhaM vA bandhanAnmOcayitvA jalaM pAyayituM kiM na nayati?</para>
  <para style="p">
    <verse number="16" style="v"/>tarhyASTAdazavatsarAn yAvat zaitAnA baddhA ibrAhImaH santatiriyaM nArI kiM vizrAmavArE na mOcayitavyA?</para>
  <para style="p">
    <verse number="17" style="v"/>ESu vAkyESu kathitESu tasya vipakSAH salajjA jAtAH kintu tEna kRtasarvvamahAkarmmakAraNAt lOkanivahaH sAnandO'bhavat|</para>
  <para style="p">
    <verse number="18" style="v"/>anantaraM sOvadad Izvarasya rAjyaM kasya sadRzaM? kEna tadupamAsyAmi?</para>
  <para style="p">
    <verse number="19" style="v"/>yat sarSapabIjaM gRhItvA kazcijjana udyAna uptavAn tad bIjamagkuritaM sat mahAvRkSO'jAyata, tatastasya zAkhAsu vihAyasIyavihagA Agatya nyUSuH, tadrAjyaM tAdRzEna sarSapabIjEna tulyaM|</para>
  <para style="p">
    <verse number="20" style="v"/>punaH kathayAmAsa, Izvarasya rAjyaM kasya sadRzaM vadiSyAmi? yat kiNvaM kAcit strI gRhItvA drONatrayaparimitagOdhUmacUrNESu sthApayAmAsa,</para>
  <para style="p">
    <verse number="21" style="v"/>tataH kramENa tat sarvvagOdhUmacUrNaM vyApnOti, tasya kiNvasya tulyam Izvarasya rAjyaM|</para>
  <para style="p">
    <verse number="22" style="v"/>tataH sa yirUzAlamnagaraM prati yAtrAM kRtvA nagarE nagarE grAmE grAmE samupadizan jagAma|</para>
  <para style="p">
    <verse number="23" style="v"/>tadA kazcijjanastaM papraccha, hE prabhO kiM kEvalam alpE lOkAH paritrAsyantE?</para>
  <para style="p">
    <verse number="24" style="v"/>tataH sa lOkAn uvAca, saMkIrNadvArENa pravESTuM yataghvaM, yatOhaM yuSmAn vadAmi, bahavaH pravESTuM cESTiSyantE kintu na zakSyanti|</para>
  <para style="p">
    <verse number="25" style="v"/>gRhapatinOtthAya dvArE ruddhE sati yadi yUyaM bahiH sthitvA dvAramAhatya vadatha, hE prabhO hE prabhO asmatkAraNAd dvAraM mOcayatu, tataH sa iti prativakSyati, yUyaM kutratyA lOkA ityahaM na jAnAmi|</para>
  <para style="p">
    <verse number="26" style="v"/>tadA yUyaM vadiSyatha, tava sAkSAd vayaM bhEाjanaM pAnanjca kRtavantaH, tvanjcAsmAkaM nagarasya pathi samupadiSTavAn|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu sa vakSyati, yuSmAnahaM vadAmi, yUyaM kutratyA lOkA ityahaM na jAnAmi; hE durAcAriNO yUyaM mattO dUrIbhavata|</para>
  <para style="p">
    <verse number="28" style="v"/>tadA ibrAhImaM ishAkaM yAkUbanjca sarvvabhaviSyadvAdinazca Izvarasya rAjyaM prAptAn svAMzca bahiSkRtAn dRSTvA yUyaM rOdanaM dantairdantagharSaNanjca kariSyatha|</para>
  <para style="p">
    <verse number="29" style="v"/>aparanjca pUrvvapazcimadakSiNOttaradigbhyO lOkA Agatya Izvarasya rAjyE nivatsyanti|</para>
  <para style="p">
    <verse number="30" style="v"/>pazyatEtthaM zESIyA lOkA agrA bhaviSyanti, agrIyA lOkAzca zESA bhaviSyanti|</para>
  <para style="p">
    <verse number="31" style="v"/>aparanjca tasmin dinE kiyantaH phirUzina Agatya yIzuM prOcuH, bahirgaccha, sthAnAdasmAt prasthAnaM kuru, hErOd tvAM jighAMsati|</para>
  <para style="p">
    <verse number="32" style="v"/>tataH sa pratyavOcat pazyatAdya zvazca bhUtAn vihApya rOgiNO'rOgiNaH kRtvA tRtIyEhni sEtsyAmi, kathAmEtAM yUyamitvA taM bhUrimAyaM vadata|</para>
  <para style="p">
    <verse number="33" style="v"/>tatrApyadya zvaH parazvazca mayA gamanAgamanE karttavyE, yatO hEtO ryirUzAlamO bahiH kutrApi kOpi bhaviSyadvAdI na ghAniSyatE|</para>
  <para style="p">
    <verse number="34" style="v"/>hE yirUzAlam hE yirUzAlam tvaM bhaviSyadvAdinO haMsi tavAntikE prEritAn prastarairmArayasi ca, yathA kukkuTI nijapakSAdhaH svazAvakAn saMgRhlAti, tathAhamapi tava zizUn saMgrahItuM kativArAn aicchaM kintu tvaM naicchaH|</para>
  <para style="p">
    <verse number="35" style="v"/>pazyata yuSmAkaM vAsasthAnAni prOcchidyamAnAni parityaktAni ca bhaviSyanti; yuSmAnahaM yathArthaM vadAmi, yaH prabhO rnAmnAgacchati sa dhanya iti vAcaM yAvatkAlaM na vadiSyatha, tAvatkAlaM yUyaM mAM na drakSyatha|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraM vizrAmavArE yIzau pradhAnasya phirUzinO gRhE bhOktuM gatavati tE taM vIkSitum ArEbhirE|</para>
  <para style="p">
    <verse number="2" style="v"/>tadA jalOdarI tasya sammukhE sthitaH|</para>
  <para style="p">
    <verse number="3" style="v"/>tataH sa vyavasthApakAn phirUzinazca papraccha, vizrAmavArE svAsthyaM karttavyaM na vA? tatastE kimapi na pratyUcuH|</para>
  <para style="p">
    <verse number="4" style="v"/>tadA sa taM rOgiNaM svasthaM kRtvA visasarja;</para>
  <para style="p">
    <verse number="5" style="v"/>tAnuvAca ca yuSmAkaM kasyacid garddabhO vRSabhO vA cEd garttE patati tarhi vizrAmavArE tatkSaNaM sa kiM taM nOtthApayiSyati?</para>
  <para style="p">
    <verse number="6" style="v"/>tatastE kathAyA EtasyAH kimapi prativaktuM na zEkuH|</para>
  <para style="p">
    <verse number="7" style="v"/>aparanjca pradhAnasthAnamanOnItatvakaraNaM vilOkya sa nimantritAn EtadupadEzakathAM jagAda,</para>
  <para style="p">
    <verse number="8" style="v"/>tvaM vivAhAdibhOjyESu nimantritaH san pradhAnasthAnE mOpAvEkSIH| tvattO gauravAnvitanimantritajana AyAtE</para>
  <para style="p">
    <verse number="9" style="v"/>nimantrayitAgatya manuSyAyaitasmai sthAnaM dEhIti vAkyaM cEd vakSyati tarhi tvaM sagkucitO bhUtvA sthAna itarasmin upavESTum udyaMsyasi|</para>
  <para style="p">
    <verse number="10" style="v"/>asmAt kAraNAdEva tvaM nimantritO gatvA'pradhAnasthAna upaviza, tatO nimantrayitAgatya vadiSyati, hE bandhO prOccasthAnaM gatvOpaviza, tathA sati bhOjanOpaviSTAnAM sakalAnAM sAkSAt tvaM mAnyO bhaviSyasi|</para>
  <para style="p">
    <verse number="11" style="v"/>yaH kazcit svamunnamayati sa namayiSyatE, kintu yaH kazcit svaM namayati sa unnamayiSyatE|</para>
  <para style="p">
    <verse number="12" style="v"/>tadA sa nimantrayitAraM janamapi jagAda, madhyAhnE rAtrau vA bhOjyE kRtE nijabandhugaNO vA bhrAtRृgaNO vA jnjAtigaNO vA dhanigaNO vA samIpavAsigaNO vA EtAn na nimantraya, tathA kRtE cEt tE tvAM nimantrayiSyanti, tarhi parizOdhO bhaviSyati|</para>
  <para style="p">
    <verse number="13" style="v"/>kintu yadA bhEjyaM karOSi tadA daridrazuSkakarakhanjjAndhAn nimantraya,</para>
  <para style="p">
    <verse number="14" style="v"/>tata AziSaM lapsyasE, tESu parizOdhaM karttumazaknuvatsu zmazAnAddhArmmikAnAmutthAnakAlE tvaM phalAM lapsyasE|</para>
  <para style="p">
    <verse number="15" style="v"/>anantaraM tAM kathAM nizamya bhOjanOpaviSTaH kazcit kathayAmAsa, yO jana Izvarasya rAjyE bhOktuM lapsyatE saEva dhanyaH|</para>
  <para style="p">
    <verse number="16" style="v"/>tataH sa uvAca, kazcit janO rAtrau bhEाjyaM kRtvA bahUn nimantrayAmAsa|</para>
  <para style="p">
    <verse number="17" style="v"/>tatO bhOjanasamayE nimantritalOkAn AhvAtuM dAsadvArA kathayAmAsa, khadyadravyANi sarvvANi samAsAditAni santi, yUyamAgacchata|</para>
  <para style="p">
    <verse number="18" style="v"/>kintu tE sarvva EkaikaM chalaM kRtvA kSamAM prArthayAnjcakrirE| prathamO janaH kathayAmAsa, kSEtramEkaM krItavAnahaM tadEva draSTuM mayA gantavyam, ataEva mAM kSantuM taM nivEdaya|</para>
  <para style="p">
    <verse number="19" style="v"/>anyO janaH kathayAmAsa, dazavRSAnahaM krItavAn tAn parIkSituM yAmi tasmAdEva mAM kSantuM taM nivEdaya|</para>
  <para style="p">
    <verse number="20" style="v"/>aparaH kathayAmAsa, vyUPhavAnahaM tasmAt kAraNAd yAtuM na zaknOmi|</para>
  <para style="p">
    <verse number="21" style="v"/>pazcAt sa dAsO gatvA nijaprabhOH sAkSAt sarvvavRttAntaM nivEdayAmAsa, tatOsau gRhapatiH kupitvA svadAsaM vyAjahAra, tvaM satvaraM nagarasya sannivEzAn mArgAMzca gatvA daridrazuSkakarakhanjjAndhAn atrAnaya|</para>
  <para style="p">
    <verse number="22" style="v"/>tatO dAsO'vadat, hE prabhO bhavata AjnjAnusArENAkriyata tathApi sthAnamasti|</para>
  <para style="p">
    <verse number="23" style="v"/>tadA prabhuH puna rdAsAyAkathayat, rAjapathAn vRkSamUlAni ca yAtvA madIyagRhapUraNArthaM lOkAnAgantuM pravarttaya|</para>
  <para style="p">
    <verse number="24" style="v"/>ahaM yuSmabhyaM kathayAmi, pUrvvanimantritAnamEkOpi mamAsya rAtribhOjyasyAsvAdaM na prApsyati|</para>
  <para style="p">
    <verse number="25" style="v"/>anantaraM bahuSu lOkESu yIzOH pazcAd vrajitESu satsu sa vyAghuTya tEbhyaH kathayAmAsa,</para>
  <para style="p">
    <verse number="26" style="v"/>yaH kazcin mama samIpam Agatya svasya mAtA pitA patnI santAnA bhrAtarO bhagimyO nijaprANAzca, EtEbhyaH sarvvEbhyO mayyadhikaM prEma na karOti, sa mama ziSyO bhavituM na zakSyati|</para>
  <para style="p">
    <verse number="27" style="v"/>yaH kazcit svIyaM kruzaM vahan mama pazcAnna gacchati, sOpi mama ziSyO bhavituM na zakSyati|</para>
  <para style="p">
    <verse number="28" style="v"/>durganirmmANE kativyayO bhaviSyati, tathA tasya samAptikaraNArthaM sampattirasti na vA, prathamamupavizya Etanna gaNayati, yuSmAkaM madhya EtAdRzaH kOsti?</para>
  <para style="p">
    <verse number="29" style="v"/>nOcEd bhittiM kRtvA zESE yadi samApayituM na zakSyati,</para>
  <para style="p">
    <verse number="30" style="v"/>tarhi mAnuSOyaM nicEtum Arabhata samApayituM nAzaknOt, iti vyAhRtya sarvvE tamupahasiSyanti|</para>
  <para style="p">
    <verse number="31" style="v"/>aparanjca bhinnabhUpatinA saha yuddhaM karttum udyamya dazasahasrANi sainyAni gRhItvA viMzatisahasrEH sainyaiH sahitasya samIpavAsinaH sammukhaM yAtuM zakSyAmi na vEti prathamaM upavizya na vicArayati EtAdRzO bhUmipatiH kaH?</para>
  <para style="p">
    <verse number="32" style="v"/>yadi na zaknOti tarhi ripAvatidUrE tiSThati sati nijadUtaM prESya sandhiM karttuM prArthayEta|</para>
  <para style="p">
    <verse number="33" style="v"/>tadvad yuSmAkaM madhyE yaH kazcin madarthaM sarvvasvaM hAtuM na zaknOti sa mama ziSyO bhavituM na zakSyati|</para>
  <para style="p">
    <verse number="34" style="v"/>lavaNam uttamam iti satyaM, kintu yadi lavaNasya lavaNatvam apagacchati tarhi tat kathaM svAduyuktaM bhaviSyati?</para>
  <para style="p">
    <verse number="35" style="v"/>tada bhUmyartham AlavAlarAzyarthamapi bhadraM na bhavati; lOkAstad bahiH kSipanti|yasya zrOtuM zrOtrE staH sa zRNOtu|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadA karasanjcAyinaH pApinazca lOkA upadEzkathAM zrOtuM yIzOH samIpam Agacchan|</para>
  <para style="p">
    <verse number="2" style="v"/>tataH phirUzina upAdhyAyAzca vivadamAnAH kathayAmAsuH ESa mAnuSaH pApibhiH saha praNayaM kRtvA taiH sArddhaM bhuMktE|</para>
  <para style="p">
    <verse number="3" style="v"/>tadA sa tEbhya imAM dRSTAntakathAM kathitavAn,</para>
  <para style="p">
    <verse number="4" style="v"/>kasyacit zatamESESu tiSThatmu tESAmEkaM sa yadi hArayati tarhi madhyEprAntaram EkOnazatamESAn vihAya hAritamESasya uddEzaprAptiparyyanataM na gavESayati, EtAdRzO lOkO yuSmAkaM madhyE ka AstE?</para>
  <para style="p">
    <verse number="5" style="v"/>tasyOddEzaM prApya hRSTamanAstaM skandhE nidhAya svasthAnam AnIya bandhubAndhavasamIpavAsina AhUya vakti,</para>
  <para style="p">
    <verse number="6" style="v"/>hAritaM mESaM prAptOham atO hEtO rmayA sArddham Anandata|</para>
  <para style="p">
    <verse number="7" style="v"/>tadvadahaM yuSmAn vadAmi, yESAM manaHparAvarttanasya prayOjanaM nAsti, tAdRzaikOnazatadhArmmikakAraNAd ya AnandastasmAd Ekasya manaHparivarttinaH pApinaH kAraNAt svargE 'dhikAnandO jAyatE|</para>
  <para style="p">
    <verse number="8" style="v"/>aparanjca dazAnAM rUpyakhaNPAnAm EkakhaNPE hAritE pradIpaM prajvAlya gRhaM sammArjya tasya prAptiM yAvad yatnEna na gavESayati, EtAdRzI yOSit kAstE?</para>
  <para style="p">
    <verse number="9" style="v"/>prAptE sati bandhubAndhavasamIpavAsinIrAhUya kathayati, hAritaM rUpyakhaNPaM prAptAhaM tasmAdEva mayA sArddham Anandata|</para>
  <para style="p">
    <verse number="10" style="v"/>tadvadahaM yuSmAn vyAharAmi, EkEna pApinA manasi parivarttitE, Izvarasya dUtAnAM madhyEpyAnandO jAyatE|</para>
  <para style="p">
    <verse number="11" style="v"/>aparanjca sa kathayAmAsa, kasyacid dvau putrAvAstAM,</para>
  <para style="p">
    <verse number="12" style="v"/>tayOH kaniSThaH putraH pitrE kathayAmAsa, hE pitastava sampattyA yamaMzaM prApsyAmyahaM vibhajya taM dEhi, tataH pitA nijAM sampattiM vibhajya tAbhyAM dadau|</para>
  <para style="p">
    <verse number="13" style="v"/>katipayAt kAlAt paraM sa kaniSThaputraH samastaM dhanaM saMgRhya dUradEzaM gatvA duSTAcaraNEna sarvvAM sampattiM nAzayAmAsa|</para>
  <para style="p">
    <verse number="14" style="v"/>tasya sarvvadhanE vyayaM gatE taddEzE mahAdurbhikSaM babhUva, tatastasya dainyadazA bhavitum ArEbhE|</para>
  <para style="p">
    <verse number="15" style="v"/>tataH paraM sa gatvA taddEzIyaM gRhasthamEkam Azrayata; tataH sataM zUkaravrajaM cArayituM prAntaraM prESayAmAsa|</para>
  <para style="p">
    <verse number="16" style="v"/>kEnApi tasmai bhakSyAdAnAt sa zUkaraphalavalkalEna piciNPapUraNAM vavAnjcha|</para>
  <para style="p">
    <verse number="17" style="v"/>zESE sa manasi cEtanAM prApya kathayAmAsa, hA mama pituH samIpE kati kati vEtanabhujO dAsA yathESTaM tatOdhikanjca bhakSyaM prApnuvanti kintvahaM kSudhA mumUrSuH|</para>
  <para style="p">
    <verse number="18" style="v"/>ahamutthAya pituH samIpaM gatvA kathAmEtAM vadiSyAmi, hE pitar Izvarasya tava ca viruddhaM pApamakaravam</para>
  <para style="p">
    <verse number="19" style="v"/>tava putra_iti vikhyAtO bhavituM na yOgyOsmi ca, mAM tava vaitanikaM dAsaM kRtvA sthApaya|</para>
  <para style="p">
    <verse number="20" style="v"/>pazcAt sa utthAya pituH samIpaM jagAma; tatastasya pitAtidUrE taM nirIkSya dayAnjcakrE, dhAvitvA tasya kaNThaM gRhItvA taM cucumba ca|</para>
  <para style="p">
    <verse number="21" style="v"/>tadA putra uvAca, hE pitar Izvarasya tava ca viruddhaM pApamakaravaM, tava putra_iti vikhyAtO bhavituM na yOgyOsmi ca|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu tasya pitA nijadAsAn AdidEza, sarvvOttamavastrANyAnIya paridhApayatainaM hastE cAggurIyakam arpayata pAdayOzcOpAnahau samarpayata;</para>
  <para style="p">
    <verse number="23" style="v"/>puSTaM gOvatsam AnIya mArayata ca taM bhuktvA vayam AnandAma|</para>
  <para style="p">
    <verse number="24" style="v"/>yatO mama putrOyam amriyata punarajIvId hAritazca labdhObhUt tatasta Ananditum ArEbhirE|</para>
  <para style="p">
    <verse number="25" style="v"/>tatkAlE tasya jyESThaH putraH kSEtra AsIt| atha sa nivEzanasya nikaTaM Agacchan nRtyAnAM vAdyAnAnjca zabdaM zrutvA</para>
  <para style="p">
    <verse number="26" style="v"/>dAsAnAm Ekam AhUya papraccha, kiM kAraNamasya?</para>
  <para style="p">
    <verse number="27" style="v"/>tataH sOvAdIt, tava bhrAtAgamat, tava tAtazca taM suzarIraM prApya puSTaM gOvatsaM mAritavAn|</para>
  <para style="p">
    <verse number="28" style="v"/>tataH sa prakupya nivEzanAntaH pravESTuM na sammEnE; tatastasya pitA bahirAgatya taM sAdhayAmAsa|</para>
  <para style="p">
    <verse number="29" style="v"/>tataH sa pitaraM pratyuvAca, pazya tava kAnjcidapyAjnjAM na vilaMghya bahUn vatsarAn ahaM tvAM sEvE tathApi mitraiH sArddham utsavaM karttuM kadApi chAgamEkamapi mahyaM nAdadAH;</para>
  <para style="p">
    <verse number="30" style="v"/>kintu tava yaH putrO vEzyAgamanAdibhistava sampattim apavyayitavAn tasminnAgatamAtrE tasyaiva nimittaM puSTaM gOvatsaM mAritavAn|</para>
  <para style="p">
    <verse number="31" style="v"/>tadA tasya pitAvOcat, hE putra tvaM sarvvadA mayA sahAsi tasmAn mama yadyadAstE tatsarvvaM tava|</para>
  <para style="p">
    <verse number="32" style="v"/>kintu tavAyaM bhrAtA mRtaH punarajIvId hAritazca bhUtvA prAptObhUt, EtasmAt kAraNAd utsavAnandau karttum ucitamasmAkam|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparanjca yIzuH ziSyEbhyOnyAmEkAM kathAM kathayAmAsa kasyacid dhanavatO manuSyasya gRhakAryyAdhIzE sampattErapavyayE'pavAditE sati</para>
  <para style="p">
    <verse number="2" style="v"/>tasya prabhustam AhUya jagAda, tvayi yAmimAM kathAM zRNOmi sA kIdRzI? tvaM gRhakAryyAdhIzakarmmaNO gaNanAM darzaya gRhakAryyAdhIzapadE tvaM na sthAsyasi|</para>
  <para style="p">
    <verse number="3" style="v"/>tadA sa gRhakAryyAdhIzO manasA cintayAmAsa, prabhu ryadi mAM gRhakAryyAdhIzapadAd bhraMzayati tarhi kiM kariSyE'haM? mRdaM khanituM mama zakti rnAsti bhikSitunjca lajjiSyE'haM|</para>
  <para style="p">
    <verse number="4" style="v"/>ataEva mayi gRhakAryyAdhIzapadAt cyutE sati yathA lOkA mahyam AzrayaM dAsyanti tadarthaM yatkarmma mayA karaNIyaM tan nirNIyatE|</para>
  <para style="p">
    <verse number="5" style="v"/>pazcAt sa svaprabhOrEkaikam adhamarNam AhUya prathamaM papraccha, tvattO mE prabhuNA kati prApyam?</para>
  <para style="p">
    <verse number="6" style="v"/>tataH sa uvAca, EkazatAPhakatailAni; tadA gRhakAryyAdhIzaH prOvAca, tava patramAnIya zIghramupavizya tatra panjcAzataM likha|</para>
  <para style="p">
    <verse number="7" style="v"/>pazcAdanyamEkaM papraccha, tvattO mE prabhuNA kati prApyam? tataH sOvAdId EkazatAPhakagOdhUmAH; tadA sa kathayAmAsa, tava patramAnIya azItiM likha|</para>
  <para style="p">
    <verse number="8" style="v"/>tEnaiva prabhustamayathArthakRtam adhIzaM tadbuddhinaipuNyAt prazazaMsa; itthaM dIptirUpasantAnEbhya EtatsaMsArasya santAnA varttamAnakAlE'dhikabuddhimantO bhavanti|</para>
  <para style="p">
    <verse number="9" style="v"/>atO vadAmi yUyamapyayathArthEna dhanEna mitrANi labhadhvaM tatO yuSmAsu padabhraSTESvapi tAni cirakAlam AzrayaM dAsyanti|</para>
  <para style="p">
    <verse number="10" style="v"/>yaH kazcit kSudrE kAryyE vizvAsyO bhavati sa mahati kAryyEpi vizvAsyO bhavati, kintu yaH kazcit kSudrE kAryyE'vizvAsyO bhavati sa mahati kAryyEpyavizvAsyO bhavati|</para>
  <para style="p">
    <verse number="11" style="v"/>ataEva ayathArthEna dhanEna yadi yUyamavizvAsyA jAtAstarhi satyaM dhanaM yuSmAkaM karESu kaH samarpayiSyati?</para>
  <para style="p">
    <verse number="12" style="v"/>yadi ca paradhanEna yUyam avizvAsyA bhavatha tarhi yuSmAkaM svakIyadhanaM yuSmabhyaM kO dAsyati?</para>
  <para style="p">
    <verse number="13" style="v"/>kOpi dAsa ubhau prabhU sEvituM na zaknOti, yata Ekasmin prIyamANO'nyasminnaprIyatE yadvA EkaM janaM samAdRtya tadanyaM tucchIkarOti tadvad yUyamapi dhanEzvarau sEvituM na zaknutha|</para>
  <para style="p">
    <verse number="14" style="v"/>tadaitAH sarvvAH kathAH zrutvA lObhiphirUzinastamupajahasuH|</para>
  <para style="p">
    <verse number="15" style="v"/>tataH sa uvAca, yUyaM manuSyANAM nikaTE svAn nirdOSAn darzayatha kintu yuSmAkam antaHkaraNAnIzvarO jAnAti, yat manuSyANAm ati prazaMsyaM tad Izvarasya ghRNyaM|</para>
  <para style="p">
    <verse number="16" style="v"/>yOhana AgamanaparyyanataM yuSmAkaM samIpE vyavasthAbhaviSyadvAdinAM lEkhanAni cAsan tataH prabhRti IzvararAjyasya susaMvAdaH pracarati, EkaikO lOkastanmadhyaM yatnEna pravizati ca|</para>
  <para style="p">
    <verse number="17" style="v"/>varaM nabhasaH pRthivyAzca lOpO bhaviSyati tathApi vyavasthAyA EkabindOrapi lOpO na bhaviSyati|</para>
  <para style="p">
    <verse number="18" style="v"/>yaH kazcit svIyAM bhAryyAM vihAya striyamanyAM vivahati sa paradArAn gacchati, yazca tA tyaktAM nArIM vivahati sOpi paradArAna gacchati|</para>
  <para style="p">
    <verse number="19" style="v"/>EkO dhanI manuSyaH zuklAni sUkSmANi vastrANi paryyadadhAt pratidinaM paritOSarUpENAbhuMktApivacca|</para>
  <para style="p">
    <verse number="20" style="v"/>sarvvAggE kSatayukta iliyAsaranAmA kazcid daridrastasya dhanavatO bhOjanapAtrAt patitam ucchiSTaM bhOktuM vAnjchan tasya dvArE patitvAtiSThat;</para>
  <para style="p">
    <verse number="21" style="v"/>atha zvAna Agatya tasya kSatAnyalihan|</para>
  <para style="p">
    <verse number="22" style="v"/>kiyatkAlAtparaM sa daridraH prANAn jahau; tataH svargIyadUtAstaM nItvA ibrAhImaH krOPa upavEzayAmAsuH|</para>
  <para style="p">
    <verse number="23" style="v"/>pazcAt sa dhanavAnapi mamAra, taM zmazAnE sthApayAmAsuzca; kintu paralOkE sa vEdanAkulaH san UrddhvAM nirIkSya bahudUrAd ibrAhImaM tatkrOPa iliyAsaranjca vilOkya ruvannuvAca;</para>
  <para style="p">
    <verse number="24" style="v"/>hE pitar ibrAhIm anugRhya aggulyagrabhAgaM jalE majjayitvA mama jihvAM zItalAM karttum iliyAsaraM prEraya, yatO vahnizikhAtOhaM vyathitOsmi|</para>
  <para style="p">
    <verse number="25" style="v"/>tadA ibrAhIm babhASE, hE putra tvaM jIvan sampadaM prAptavAn iliyAsarastu vipadaM prAptavAn Etat smara, kintu samprati tasya sukhaM tava ca duHkhaM bhavati|</para>
  <para style="p">
    <verse number="26" style="v"/>aparamapi yuSmAkam asmAkanjca sthAnayO rmadhyE mahadvicchEdO'sti tata EtatsthAnasya lOkAstat sthAnaM yAtuM yadvA tatsthAnasya lOkA Etat sthAnamAyAtuM na zaknuvanti|</para>
  <para style="p">
    <verse number="27" style="v"/>tadA sa uktavAn, hE pitastarhi tvAM nivEdayAmi mama pitu rgEhE yE mama panjca bhrAtaraH santi</para>
  <para style="p">
    <verse number="28" style="v"/>tE yathaitad yAtanAsthAnaM nAyAsyanti tathA mantraNAM dAtuM tESAM samIpam iliyAsaraM prEraya|</para>
  <para style="p">
    <verse number="29" style="v"/>tata ibrAhIm uvAca, mUsAbhaviSyadvAdinAnjca pustakAni tESAM nikaTE santi tE tadvacanAni manyantAM|</para>
  <para style="p">
    <verse number="30" style="v"/>tadA sa nivEdayAmAsa, hE pitar ibrAhIm na tathA, kintu yadi mRtalOkAnAM kazcit tESAM samIpaM yAti tarhi tE manAMsi vyAghOTayiSyanti|</para>
  <para style="p">
    <verse number="31" style="v"/>tata ibrAhIm jagAda, tE yadi mUsAbhaviSyadvAdinAnjca vacanAni na manyantE tarhi mRtalOkAnAM kasmiMzcid utthitEpi tE tasya mantraNAM na maMsyantE|</para>
  <chapter number="17" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>itaH paraM yIzuH ziSyAn uvAca, vighnairavazyam AgantavyaM kintu vighnA yEna ghaTiSyantE tasya durgati rbhaviSyati|</para>
  <para style="p">
    <verse number="2" style="v"/>EtESAM kSudraprANinAm EkasyApi vighnajananAt kaNThabaddhapESaNIkasya tasya sAgarAgAdhajalE majjanaM bhadraM|</para>
  <para style="p">
    <verse number="3" style="v"/>yUyaM svESu sAvadhAnAstiSThata; tava bhrAtA yadi tava kinjcid aparAdhyati tarhi taM tarjaya, tEna yadi manaH parivarttayati tarhi taM kSamasva|</para>
  <para style="p">
    <verse number="4" style="v"/>punarEkadinamadhyE yadi sa tava saptakRtvO'parAdhyati kintu saptakRtva Agatya manaH parivartya mayAparAddham iti vadati tarhi taM kSamasva|</para>
  <para style="p">
    <verse number="5" style="v"/>tadA prEritAH prabhum avadan asmAkaM vizvAsaM varddhaya|</para>
  <para style="p">
    <verse number="6" style="v"/>prabhuruvAca, yadi yuSmAkaM sarSapaikapramANO vizvAsOsti tarhi tvaM samUlamutpATitO bhUtvA samudrE rOpitO bhava kathAyAm EtasyAm EtaduPumbarAya kathitAyAM sa yuSmAkamAjnjAvahO bhaviSyati|</para>
  <para style="p">
    <verse number="7" style="v"/>aparaM svadAsE halaM vAhayitvA vA pazUn cArayitvA kSEtrAd AgatE sati taM vadati, Ehi bhOktumupaviza, yuSmAkam EtAdRzaH kOsti?</para>
  <para style="p">
    <verse number="8" style="v"/>varanjca pUrvvaM mama khAdyamAsAdya yAvad bhunjjE pivAmi ca tAvad baddhakaTiH paricara pazcAt tvamapi bhOkSyasE pAsyasi ca kathAmIdRzIM kiM na vakSyati?</para>
  <para style="p">
    <verse number="9" style="v"/>tEna dAsEna prabhOrAjnjAnurUpE karmmaNi kRtE prabhuH kiM tasmin bAdhitO jAtaH? nEtthaM budhyatE mayA|</para>
  <para style="p">
    <verse number="10" style="v"/>itthaM nirUpitESu sarvvakarmmasu kRtESu satmu yUyamapIdaM vAkyaM vadatha, vayam anupakAriNO dAsA asmAbhiryadyatkarttavyaM tanmAtramEva kRtaM|</para>
  <para style="p">
    <verse number="11" style="v"/>sa yirUzAlami yAtrAM kurvvan zOmirONgAlIlpradEzamadhyEna gacchati,</para>
  <para style="p">
    <verse number="12" style="v"/>Etarhi kutracid grAmE pravEzamAtrE dazakuSThinastaM sAkSAt kRtvA</para>
  <para style="p">
    <verse number="13" style="v"/>dUrE tiSThanata uccai rvaktumArEbhirE, hE prabhO yIzO dayasvAsmAn|</para>
  <para style="p">
    <verse number="14" style="v"/>tataH sa tAn dRSTvA jagAda, yUyaM yAjakAnAM samIpE svAn darzayata, tatastE gacchantO rOgAt pariSkRtAH|</para>
  <para style="p">
    <verse number="15" style="v"/>tadA tESAmEkaH svaM svasthaM dRSTvA prOccairIzvaraM dhanyaM vadan vyAghuTyAyAtO yIzO rguNAnanuvadan taccaraNAdhObhUmau papAta;</para>
  <para style="p">
    <verse number="16" style="v"/>sa cAsIt zOmirONI|</para>
  <para style="p">
    <verse number="17" style="v"/>tadA yIzuravadat, dazajanAH kiM na pariSkRtAH? tahyanyE navajanAH kutra?</para>
  <para style="p">
    <verse number="18" style="v"/>IzvaraM dhanyaM vadantam EnaM vidEzinaM vinA kOpyanyO na prApyata|</para>
  <para style="p">
    <verse number="19" style="v"/>tadA sa tamuvAca, tvamutthAya yAhi vizvAsastE tvAM svasthaM kRtavAn|</para>
  <para style="p">
    <verse number="20" style="v"/>atha kadEzvarasya rAjatvaM bhaviSyatIti phirUzibhiH pRSTE sa pratyuvAca, Izvarasya rAjatvam aizvaryyadarzanEna na bhaviSyati|</para>
  <para style="p">
    <verse number="21" style="v"/>ata Etasmin pazya tasmin vA pazya, iti vAkyaM lOkA vaktuM na zakSyanti, Izvarasya rAjatvaM yuSmAkam antarEvAstE|</para>
  <para style="p">
    <verse number="22" style="v"/>tataH sa ziSyAn jagAda, yadA yuSmAbhi rmanujasutasya dinamEkaM draSTum vAnjchiSyatE kintu na darziSyatE, IdRkkAla AyAti|</para>
  <para style="p">
    <verse number="23" style="v"/>tadAtra pazya vA tatra pazyEti vAkyaM lOkA vakSyanti, kintu tESAM pazcAt mA yAta, mAnugacchata ca|</para>
  <para style="p">
    <verse number="24" style="v"/>yatastaPid yathAkAzaikadizyudiya tadanyAmapi dizaM vyApya prakAzatE tadvat nijadinE manujasUnuH prakAziSyatE|</para>
  <para style="p">
    <verse number="25" style="v"/>kintu tatpUrvvaM tEnAnEkAni duHkhAni bhOktavyAnyEtadvarttamAnalOkaizca sO'vajnjAtavyaH|</para>
  <para style="p">
    <verse number="26" style="v"/>nOhasya vidyamAnakAlE yathAbhavat manuSyasUnOH kAlEpi tathA bhaviSyati|</para>
  <para style="p">
    <verse number="27" style="v"/>yAvatkAlaM nOhO mahApOtaM nArOhad AplAvivAryyEtya sarvvaM nAnAzayacca tAvatkAlaM yathA lOkA abhunjjatApivan vyavahan vyavAhayaMzca;</para>
  <para style="p">
    <verse number="28" style="v"/>itthaM lOTO varttamAnakAlEpi yathA lOkA bhOjanapAnakrayavikrayarOpaNagRhanirmmANakarmmasu prAvarttanta,</para>
  <para style="p">
    <verse number="29" style="v"/>kintu yadA lOT sidOmO nirjagAma tadA nabhasaH sagandhakAgnivRSTi rbhUtvA sarvvaM vyanAzayat</para>
  <para style="p">
    <verse number="30" style="v"/>tadvan mAnavaputraprakAzadinEpi bhaviSyati|</para>
  <para style="p">
    <verse number="31" style="v"/>tadA yadi kazcid gRhOpari tiSThati tarhi sa gRhamadhyAt kimapi dravyamAnEtum avaruhya naitu; yazca kSEtrE tiSThati sOpi vyAghuTya nAyAtu|</para>
  <para style="p">
    <verse number="32" style="v"/>lOTaH patnIM smarata|</para>
  <para style="p">
    <verse number="33" style="v"/>yaH prANAn rakSituM cESTiSyatE sa prANAn hArayiSyati yastu prANAn hArayiSyati saEva prANAn rakSiSyati|</para>
  <para style="p">
    <verse number="34" style="v"/>yuSmAnahaM vacmi tasyAM rAtrau zayyaikagatayO rlOkayOrEkO dhAriSyatE parastyakSyatE|</para>
  <para style="p">
    <verse number="35" style="v"/>striyau yugapat pESaNIM vyAvarttayiSyatastayOrEkA dhAriSyatE parAtyakSyatE|</para>
  <para style="p">
    <verse number="36" style="v"/>puruSau kSEtrE sthAsyatastayOrEkO dhAriSyatE parastyakSyatE|</para>
  <para style="p">
    <verse number="37" style="v"/>tadA tE papracchuH, hE prabhO kutrEtthaM bhaviSyati? tataH sa uvAca, yatra zavastiSThati tatra gRdhrA milanti|</para>
  <chapter number="18" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparanjca lOkairaklAntai rnirantaraM prArthayitavyam ityAzayEna yIzunA dRSTAnta EkaH kathitaH|</para>
  <para style="p">
    <verse number="2" style="v"/>kutracinnagarE kazcit prAPvivAka AsIt sa IzvarAnnAbibhEt mAnuSAMzca nAmanyata|</para>
  <para style="p">
    <verse number="3" style="v"/>atha tatpuravAsinI kAcidvidhavA tatsamIpamEtya vivAdinA saha mama vivAdaM pariSkurvviti nivEdayAmAsa|</para>
  <para style="p">
    <verse number="4" style="v"/>tataH sa prAPvivAkaH kiyaddinAni na tadaggIkRtavAn pazcAccittE cintayAmAsa, yadyapIzvarAnna bibhEmi manuSyAnapi na manyE</para>
  <para style="p">
    <verse number="5" style="v"/>tathApyESA vidhavA mAM kliznAti tasmAdasyA vivAdaM pariSkariSyAmi nOcEt sA sadAgatya mAM vyagraM kariSyati|</para>
  <para style="p">
    <verse number="6" style="v"/>pazcAt prabhuravadad asAvanyAyaprAPvivAkO yadAha tatra manO nidhadhvaM|</para>
  <para style="p">
    <verse number="7" style="v"/>Izvarasya yE 'bhirucitalOkA divAnizaM prArthayantE sa bahudinAni vilambyApi tESAM vivAdAn kiM na pariSkariSyati?</para>
  <para style="p">
    <verse number="8" style="v"/>yuSmAnahaM vadAmi tvarayA pariSkariSyati, kintu yadA manuSyaputra AgamiSyati tadA pRthivyAM kimIdRzaM vizvAsaM prApsyati?</para>
  <para style="p">
    <verse number="9" style="v"/>yE svAn dhArmmikAn jnjAtvA parAn tucchIkurvvanti EtAdRgbhyaH, kiyadbhya imaM dRSTAntaM kathayAmAsa|</para>
  <para style="p">
    <verse number="10" style="v"/>EkaH phirUzyaparaH karasanjcAyI dvAvimau prArthayituM mandiraM gatau|</para>
  <para style="p">
    <verse number="11" style="v"/>tatO'sau phirUzyEkapArzvE tiSThan hE Izvara ahamanyalOkavat lOThayitAnyAyI pAradArikazca na bhavAmi asya karasanjcAyinastulyazca na, tasmAttvAM dhanyaM vadAmi|</para>
  <para style="p">
    <verse number="12" style="v"/>saptasu dinESu dinadvayamupavasAmi sarvvasampattE rdazamAMzaM dadAmi ca, EtatkathAM kathayan prArthayAmAsa|</para>
  <para style="p">
    <verse number="13" style="v"/>kintu sa karasanjcAyi dUrE tiSThan svargaM draSTuM nEcchan vakSasi karAghAtaM kurvvan hE Izvara pApiSThaM mAM dayasva, itthaM prArthayAmAsa|</para>
  <para style="p">
    <verse number="14" style="v"/>yuSmAnahaM vadAmi, tayOrdvayO rmadhyE kEvalaH karasanjcAyI puNyavattvEna gaNitO nijagRhaM jagAma, yatO yaH kazcit svamunnamayati sa nAmayiSyatE kintu yaH kazcit svaM namayati sa unnamayiSyatE|</para>
  <para style="p">
    <verse number="15" style="v"/>atha zizUnAM gAtrasparzArthaM lOkAstAn tasya samIpamAninyuH ziSyAstad dRSTvAnEtRn tarjayAmAsuH,</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yIzustAnAhUya jagAda, mannikaTam AgantuM zizUn anujAnIdhvaM tAMzca mA vArayata; yata IzvararAjyAdhikAriNa ESAM sadRzAH|</para>
  <para style="p">
    <verse number="17" style="v"/>ahaM yuSmAn yathArthaM vadAmi, yO janaH zizOH sadRzO bhUtvA IzvararAjyaM na gRhlAti sa kEnApi prakArENa tat pravESTuM na zaknOti|</para>
  <para style="p">
    <verse number="18" style="v"/>aparam EkOdhipatistaM papraccha, hE paramagurO, anantAyuSaH prAptayE mayA kiM karttavyaM?</para>
  <para style="p">
    <verse number="19" style="v"/>yIzuruvAca, mAM kutaH paramaM vadasi? IzvaraM vinA kOpi paramO na bhavati|</para>
  <para style="p">
    <verse number="20" style="v"/>paradArAn mA gaccha, naraM mA jahi, mA cOraya, mithyAsAkSyaM mA dEhi, mAtaraM pitaranjca saMmanyasva, EtA yA AjnjAH santi tAstvaM jAnAsi|</para>
  <para style="p">
    <verse number="21" style="v"/>tadA sa uvAca, bAlyakAlAt sarvvA EtA AcarAmi|</para>
  <para style="p">
    <verse number="22" style="v"/>iti kathAM zrutvA yIzustamavadat, tathApi tavaikaM karmma nyUnamAstE, nijaM sarvvasvaM vikrIya daridrEbhyO vitara, tasmAt svargE dhanaM prApsyasi; tata Agatya mamAnugAmI bhava|</para>
  <para style="p">
    <verse number="23" style="v"/>kintvEtAM kathAM zrutvA sOdhipatiH zuzOca, yatastasya bahudhanamAsIt|</para>
  <para style="p">
    <verse number="24" style="v"/>tadA yIzustamatizOkAnvitaM dRSTvA jagAda, dhanavatAm IzvararAjyapravEzaH kIdRg duSkaraH|</para>
  <para style="p">
    <verse number="25" style="v"/>IzvararAjyE dhaninaH pravEzAt sUcEzchidrENa mahAggasya gamanAgamanE sukarE|</para>
  <para style="p">
    <verse number="26" style="v"/>zrOtAraH papracchustarhi kEna paritrANaM prApsyatE?</para>
  <para style="p">
    <verse number="27" style="v"/>sa uktavAn, yan mAnuSENAzakyaM tad IzvarENa zakyaM|</para>
  <para style="p">
    <verse number="28" style="v"/>tadA pitara uvAca, pazya vayaM sarvvasvaM parityajya tava pazcAdgAminO'bhavAma|</para>
  <para style="p">
    <verse number="29" style="v"/>tataH sa uvAca, yuSmAnahaM yathArthaM vadAmi, IzvararAjyArthaM gRhaM pitarau bhrAtRgaNaM jAyAM santAnAMzca tyaktavA</para>
  <para style="p">
    <verse number="30" style="v"/>iha kAlE tatO'dhikaM parakAlE 'nantAyuzca na prApsyati lOka IdRzaH kOpi nAsti|</para>
  <para style="p">
    <verse number="31" style="v"/>anantaraM sa dvAdazaziSyAnAhUya babhASE, pazyata vayaM yirUzAlamnagaraM yAmaH, tasmAt manuSyaputrE bhaviSyadvAdibhiruktaM yadasti tadanurUpaM taM prati ghaTiSyatE;</para>
  <para style="p">
    <verse number="32" style="v"/>vastutastu sO'nyadEzIyAnAM hastESu samarpayiSyatE, tE tamupahasiSyanti, anyAyamAcariSyanti tadvapuSi niSThIvaM nikSEpsyanti, kazAbhiH prahRtya taM haniSyanti ca,</para>
  <para style="p">
    <verse number="33" style="v"/>kintu tRtIyadinE sa zmazAnAd utthAsyati|</para>
  <para style="p">
    <verse number="34" style="v"/>EtasyAH kathAyA abhiprAyaM kinjcidapi tE bOddhuM na zEkuH tESAM nikaTE'spaSTatavAt tasyaitAsAM kathAnAm AzayaM tE jnjAtuM na zEkuzca|</para>
  <para style="p">
    <verse number="35" style="v"/>atha tasmin yirIhOH purasyAntikaM prAptE kazcidandhaH pathaH pArzva upavizya bhikSAm akarOt</para>
  <para style="p">
    <verse number="36" style="v"/>sa lOkasamUhasya gamanazabdaM zrutvA tatkAraNaM pRSTavAn|</para>
  <para style="p">
    <verse number="37" style="v"/>nAsaratIyayIzuryAtIti lOkairuktE sa uccairvaktumArEbhE,</para>
  <para style="p">
    <verse number="38" style="v"/>hE dAyUdaH santAna yIzO mAM dayasva|</para>
  <para style="p">
    <verse number="39" style="v"/>tatOgragAminastaM maunI tiSThEti tarjayAmAsuH kintu sa punAruvan uvAca, hE dAyUdaH santAna mAM dayasva|</para>
  <para style="p">
    <verse number="40" style="v"/>tadA yIzuH sthagitO bhUtvA svAntikE tamAnEtum AdidEza|</para>
  <para style="p">
    <verse number="41" style="v"/>tataH sa tasyAntikam Agamat, tadA sa taM papraccha, tvaM kimicchasi? tvadarthamahaM kiM kariSyAmi? sa uktavAn, hE prabhO'haM draSTuM labhai|</para>
  <para style="p">
    <verse number="42" style="v"/>tadA yIzuruvAca, dRSTizaktiM gRhANa tava pratyayastvAM svasthaM kRtavAn|</para>
  <para style="p">
    <verse number="43" style="v"/>tatastatkSaNAt tasya cakSuSI prasannE; tasmAt sa IzvaraM dhanyaM vadan tatpazcAd yayau, tadAlOkya sarvvE lOkA IzvaraM prazaMsitum ArEbhirE|</para>
  <chapter number="19" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yadA yIzu ryirIhOpuraM pravizya tanmadhyEna gacchaMstadA</para>
  <para style="p">
    <verse number="2" style="v"/>sakkEyanAmA karasanjcAyinAM pradhAnO dhanavAnEkO</para>
  <para style="p">
    <verse number="3" style="v"/>yIzuH kIdRgiti draSTuM cESTitavAn kintu kharvvatvAllOkasaMghamadhyE taddarzanamaprApya</para>
  <para style="p">
    <verse number="4" style="v"/>yEna pathA sa yAsyati tatpathE'grE dhAvitvA taM draSTum uPumbaratarumArurOha|</para>
  <para style="p">
    <verse number="5" style="v"/>pazcAd yIzustatsthAnam itvA UrddhvaM vilOkya taM dRSTvAvAdIt, hE sakkEya tvaM zIghramavarOha mayAdya tvadgEhE vastavyaM|</para>
  <para style="p">
    <verse number="6" style="v"/>tataH sa zIghramavaruhya sAhlAdaM taM jagrAha|</para>
  <para style="p">
    <verse number="7" style="v"/>tad dRSTvA sarvvE vivadamAnA vaktumArEbhirE, sOtithitvEna duSTalOkagRhaM gacchati|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu sakkEyO daNPAyamAnO vaktumArEbhE, hE prabhO pazya mama yA sampattirasti tadarddhaM daridrEbhyO dadE, aparam anyAyaM kRtvA kasmAdapi yadi kadApi kinjcit mayA gRhItaM tarhi taccaturguNaM dadAmi|</para>
  <para style="p">
    <verse number="9" style="v"/>tadA yIzustamuktavAn ayamapi ibrAhImaH santAnO'taH kAraNAd adyAsya gRhE trANamupasthitaM|</para>
  <para style="p">
    <verse number="10" style="v"/>yad hAritaM tat mRgayituM rakSitunjca manuSyaputra AgatavAn|</para>
  <para style="p">
    <verse number="11" style="v"/>atha sa yirUzAlamaH samIpa upAtiSThad IzvararAjatvasyAnuSThAnaM tadaiva bhaviSyatIti lOkairanvabhUyata, tasmAt sa zrOtRbhyaH punardRSTAntakathAm utthApya kathayAmAsa|</para>
  <para style="p">
    <verse number="12" style="v"/>kOpi mahAllOkO nijArthaM rAjatvapadaM gRhItvA punarAgantuM dUradEzaM jagAma|</para>
  <para style="p">
    <verse number="13" style="v"/>yAtrAkAlE nijAn dazadAsAn AhUya dazasvarNamudrA dattvA mamAgamanaparyyantaM vANijyaM kurutEtyAdidEza|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu tasya prajAstamavajnjAya manuSyamEnam asmAkamupari rAjatvaM na kArayivyAma imAM vArttAM tannikaTE prErayAmAsuH|</para>
  <para style="p">
    <verse number="15" style="v"/>atha sa rAjatvapadaM prApyAgatavAn EkaikO janO bANijyEna kiM labdhavAn iti jnjAtuM yESu dAsESu mudrA arpayat tAn AhUyAnEtum AdidEza|</para>
  <para style="p">
    <verse number="16" style="v"/>tadA prathama Agatya kathitavAn, hE prabhO tava tayaikayA mudrayA dazamudrA labdhAH|</para>
  <para style="p">
    <verse number="17" style="v"/>tataH sa uvAca tvamuttamO dAsaH svalpEna vizvAsyO jAta itaH kAraNAt tvaM dazanagarANAm adhipO bhava|</para>
  <para style="p">
    <verse number="18" style="v"/>dvitIya Agatya kathitavAn, hE prabhO tavaikayA mudrayA panjcamudrA labdhAH|</para>
  <para style="p">
    <verse number="19" style="v"/>tataH sa uvAca, tvaM panjcAnAM nagarANAmadhipati rbhava|</para>
  <para style="p">
    <verse number="20" style="v"/>tatOnya Agatya kathayAmAsa, hE prabhO pazya tava yA mudrA ahaM vastrE baddhvAsthApayaM sEyaM|</para>
  <para style="p">
    <verse number="21" style="v"/>tvaM kRpaNO yannAsthApayastadapi gRhlAsi, yannAvapastadEva ca chinatsi tatOhaM tvattO bhItaH|</para>
  <para style="p">
    <verse number="22" style="v"/>tadA sa jagAda, rE duSTadAsa tava vAkyEna tvAM dOSiNaM kariSyAmi, yadahaM nAsthApayaM tadEva gRhlAmi, yadahaM nAvapanjca tadEva chinadmi, EtAdRzaH kRpaNOhamiti yadi tvaM jAnAsi,</para>
  <para style="p">
    <verse number="23" style="v"/>tarhi mama mudrA baNijAM nikaTE kutO nAsthApayaH? tayA kRtE'ham Agatya kusIdEna sArddhaM nijamudrA aprApsyam|</para>
  <para style="p">
    <verse number="24" style="v"/>pazcAt sa samIpasthAn janAn AjnjApayat asmAt mudrA AnIya yasya dazamudrAH santi tasmai datta|</para>
  <para style="p">
    <verse number="25" style="v"/>tE prOcuH prabhO'sya dazamudrAH santi|</para>
  <para style="p">
    <verse number="26" style="v"/>yuSmAnahaM vadAmi yasyAzrayE vaddhatE 'dhikaM tasmai dAyiSyatE, kintu yasyAzrayE na varddhatE tasya yadyadasti tadapi tasmAn nAyiSyatE|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu mamAdhipatitvasya vazatvE sthAtum asammanyamAnA yE mama ripavastAnAnIya mama samakSaM saMharata|</para>
  <para style="p">
    <verse number="28" style="v"/>ityupadEzakathAM kathayitvA sOgragaH san yirUzAlamapuraM yayau|</para>
  <para style="p">
    <verse number="29" style="v"/>tatO baitphagIbaithanIyAgrAmayOH samIpE jaitunAdrErantikam itvA ziSyadvayam ityuktvA prESayAmAsa,</para>
  <para style="p">
    <verse number="30" style="v"/>yuvAmamuM sammukhasthagrAmaM pravizyaiva yaM kOpi mAnuSaH kadApi nArOhat taM garddabhazAvakaM baddhaM drakSyathastaM mOcayitvAnayataM|</para>
  <para style="p">
    <verse number="31" style="v"/>tatra kutO mOcayathaH? iti cEt kOpi vakSyati tarhi vakSyathaH prabhEाratra prayOjanam AstE|</para>
  <para style="p">
    <verse number="32" style="v"/>tadA tau praritau gatvA tatkathAाnusArENa sarvvaM prAptau|</para>
  <para style="p">
    <verse number="33" style="v"/>gardabhazAvakamOcanakAlE tatvAmina UcuH, gardabhazAvakaM kutO mOcayathaH?</para>
  <para style="p">
    <verse number="34" style="v"/>tAvUcatuH prabhOratra prayOjanam AstE|</para>
  <para style="p">
    <verse number="35" style="v"/>pazcAt tau taM gardabhazAvakaM yIzOrantikamAnIya tatpRSThE nijavasanAni pAtayitvA tadupari yIzumArOhayAmAsatuH|</para>
  <para style="p">
    <verse number="36" style="v"/>atha yAtrAkAlE lOkAH pathi svavastrANi pAtayitum ArEbhirE|</para>
  <para style="p">
    <verse number="37" style="v"/>aparaM jaitunAdrErupatyakAm itvA ziSyasaMghaH pUrvvadRSTAni mahAkarmmANi smRtvA,</para>
  <para style="p">
    <verse number="38" style="v"/>yO rAjA prabhO rnAmnAyAti sa dhanyaH svargE kuzalaM sarvvOccE jayadhvani rbhavatu, kathAmEtAM kathayitvA sAnandam ucairIzvaraM dhanyaM vaktumArEbhE|</para>
  <para style="p">
    <verse number="39" style="v"/>tadA lOkAraNyamadhyasthAH kiyantaH phirUzinastat zrutvA yIzuM prOcuH, hE upadEzaka svaziSyAn tarjaya|</para>
  <para style="p">
    <verse number="40" style="v"/>sa uvAca, yuSmAnahaM vadAmi yadyamI nIravAstiSThanti tarhi pASANA ucaiH kathAH kathayiSyanti|</para>
  <para style="p">
    <verse number="41" style="v"/>pazcAt tatpurAntikamEtya tadavalOkya sAzrupAtaM jagAda,</para>
  <para style="p">
    <verse number="42" style="v"/>hA hA cEt tvamagrE'jnjAsyathAH, tavAsminnEva dinE vA yadi svamaggalam upAlapsyathAH, tarhyuttamam abhaviSyat, kintu kSaNEsmin tattava dRSTEragOcaram bhavati|</para>
  <para style="p">
    <verse number="43" style="v"/>tvaM svatrANakAlE na manO nyadhatthA iti hEtO ryatkAlE tava ripavastvAM caturdikSu prAcIrENa vESTayitvA rOtsyanti</para>
  <para style="p">
    <verse number="44" style="v"/>bAlakaiH sArddhaM bhUmisAt kariSyanti ca tvanmadhyE pASANaikOpi pASANOpari na sthAsyati ca, kAla IdRza upasthAsyati|</para>
  <para style="p">
    <verse number="45" style="v"/>atha madhyEmandiraM pravizya tatratyAn krayivikrayiNO bahiSkurvvan</para>
  <para style="p">
    <verse number="46" style="v"/>avadat madgRhaM prArthanAgRhamiti lipirAstE kintu yUyaM tadEva cairANAM gahvaraM kurutha|</para>
  <para style="p">
    <verse number="47" style="v"/>pazcAt sa pratyahaM madhyEmandiram upadidEza; tataH pradhAnayAjakA adhyApakAH prAcInAzca taM nAzayituM cicESTirE;</para>
  <para style="p">
    <verse number="48" style="v"/>kintu tadupadEzE sarvvE lOkA niviSTacittAH sthitAstasmAt tE tatkarttuM nAvakAzaM prApuH|</para>
  <chapter number="20" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>athaikadA yIzu rmanidarE susaMvAdaM pracArayan lOkAnupadizati, Etarhi pradhAnayAjakA adhyApakAH prAnjcazca tannikaTamAgatya papracchuH</para>
  <para style="p">
    <verse number="2" style="v"/>kayAjnjayA tvaM karmmANyEtAni karOSi? kO vA tvAmAjnjApayat? tadasmAn vada|</para>
  <para style="p">
    <verse number="3" style="v"/>sa pratyuvAca, tarhi yuSmAnapi kathAmEkAM pRcchAmi tasyOttaraM vadata|</para>
  <para style="p">
    <verse number="4" style="v"/>yOhanO majjanam Izvarasya mAnuSANAM vAjnjAtO jAtaM?</para>
  <para style="p">
    <verse number="5" style="v"/>tatastE mithO vivicya jagaduH, yadIzvarasya vadAmastarhi taM kutO na pratyaita sa iti vakSyati|</para>
  <para style="p">
    <verse number="6" style="v"/>yadi manuSyasyEti vadAmastarhi sarvvE lOkA asmAn pASANai rhaniSyanti yatO yOhan bhaviSyadvAdIti sarvvE dRPhaM jAnanti|</para>
  <para style="p">
    <verse number="7" style="v"/>ataEva tE pratyUcuH kasyAjnjayA jAtam iti vaktuM na zaknumaH|</para>
  <para style="p">
    <verse number="8" style="v"/>tadA yIzuravadat tarhi kayAjnjayA karmmANyEtAti karOmIti ca yuSmAn na vakSyAmi|</para>
  <para style="p">
    <verse number="9" style="v"/>atha lOkAnAM sAkSAt sa imAM dRSTAntakathAM vaktumArEbhE, kazcid drAkSAkSEtraM kRtvA tat kSEtraM kRSIvalAnAM hastESu samarpya bahukAlArthaM dUradEzaM jagAma|</para>
  <para style="p">
    <verse number="10" style="v"/>atha phalakAlE phalAni grahItu kRSIvalAnAM samIpE dAsaM prAhiNOt kintu kRSIvalAstaM prahRtya riktahastaM visasarjuH|</para>
  <para style="p">
    <verse number="11" style="v"/>tataH sOdhipatiH punaranyaM dAsaM prESayAmAsa, tE tamapi prahRtya kuvyavahRtya riktahastaM visasRjuH|</para>
  <para style="p">
    <verse number="12" style="v"/>tataH sa tRtIyavAram anyaM prAhiNOt tE tamapi kSatAggaM kRtvA bahi rnicikSipuH|</para>
  <para style="p">
    <verse number="13" style="v"/>tadA kSEtrapati rvicArayAmAsa, mamEdAnIM kiM karttavyaM? mama priyE putrE prahitE tE tamavazyaM dRSTvA samAdariSyantE|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu kRSIvalAstaM nirIkSya parasparaM vivicya prOcuH, ayamuttarAdhikArI AgacchatainaM hanmastatOdhikArOsmAkaM bhaviSyati|</para>
  <para style="p">
    <verse number="15" style="v"/>tatastE taM kSEtrAd bahi rnipAtya jaghnustasmAt sa kSEtrapatistAn prati kiM kariSyati?</para>
  <para style="p">
    <verse number="16" style="v"/>sa Agatya tAn kRSIvalAn hatvA parESAM hastESu tatkSEtraM samarpayiSyati; iti kathAM zrutvA tE 'vadan EtAdRzI ghaTanA na bhavatu|</para>
  <para style="p">
    <verse number="17" style="v"/>kintu yIzustAnavalOkya jagAda, tarhi, sthapatayaH kariSyanti grAvANaM yantu tucchakaM| pradhAnaprastaraH kONE sa Eva hi bhaviSyati| Etasya zAstrIyavacanasya kiM tAtparyyaM?</para>
  <para style="p">
    <verse number="18" style="v"/>aparaM tatpASANOpari yaH patiSyati sa bhaMkSyatE kintu yasyOpari sa pASANaH patiSyati sa tEna dhUlivac cUrNIbhaviSyati|</para>
  <para style="p">
    <verse number="19" style="v"/>sOsmAkaM viruddhaM dRSTAntamimaM kathitavAn iti jnjAtvA pradhAnayAjakA adhyApakAzca tadaiva taM dhartuM vavAnjchuH kintu lOkEbhyO bibhyuH|</para>
  <para style="p">
    <verse number="20" style="v"/>ataEva taM prati satarkAH santaH kathaM tadvAkyadOSaM dhRtvA taM dEzAdhipasya sAdhuvEzadhAriNazcarAn tasya samIpE prESayAmAsuH|</para>
  <para style="p">
    <verse number="21" style="v"/>tadA tE taM papracchuH, hE upadEzaka bhavAn yathArthaM kathayan upadizati, kamapyanapEkSya satyatvEnaizvaraM mArgamupadizati, vayamEtajjAnImaH|</para>
  <para style="p">
    <verse number="22" style="v"/>kaisararAjAya karOsmAbhi rdEyO na vA?</para>
  <para style="p">
    <verse number="23" style="v"/>sa tESAM vanjcanaM jnjAtvAvadat kutO mAM parIkSadhvE? mAM mudrAmEkaM darzayata|</para>
  <para style="p">
    <verse number="24" style="v"/>iha likhitA mUrtiriyaM nAma ca kasya? tE'vadan kaisarasya|</para>
  <para style="p">
    <verse number="25" style="v"/>tadA sa uvAca, tarhi kaisarasya dravyaM kaisarAya datta; Izvarasya tu dravyamIzvarAya datta|</para>
  <para style="p">
    <verse number="26" style="v"/>tasmAllOkAnAM sAkSAt tatkathAyAH kamapi dOSaM dhartumaprApya tE tasyOttarAd AzcaryyaM manyamAnA mauninastasthuH|</para>
  <para style="p">
    <verse number="27" style="v"/>aparanjca zmazAnAdutthAnAnaggIkAriNAM sidUkinAM kiyantO janA Agatya taM papracchuH,</para>
  <para style="p">
    <verse number="28" style="v"/>hE upadEzaka zAstrE mUsA asmAn pratIti lilEkha yasya bhrAtA bhAryyAyAM satyAM niHsantAnO mriyatE sa tajjAyAM vivahya tadvaMzam utpAdayiSyati|</para>
  <para style="p">
    <verse number="29" style="v"/>tathAca kEcit sapta bhrAtara Asan tESAM jyESThO bhrAtA vivahya nirapatyaH prANAn jahau|</para>
  <para style="p">
    <verse number="30" style="v"/>atha dvitIyastasya jAyAM vivahya nirapatyaH san mamAra| tRtIyazca tAmEva vyuvAha;</para>
  <para style="p">
    <verse number="31" style="v"/>itthaM sapta bhrAtarastAmEva vivahya nirapatyAH santO mamruH|</para>
  <para style="p">
    <verse number="32" style="v"/>zESE sA strI ca mamAra|</para>
  <para style="p">
    <verse number="33" style="v"/>ataEva zmazAnAdutthAnakAlE tESAM saptajanAnAM kasya sA bhAryyA bhaviSyati? yataH sA tESAM saptAnAmEva bhAryyAsIt|</para>
  <para style="p">
    <verse number="34" style="v"/>tadA yIzuH pratyuvAca, Etasya jagatO lOkA vivahanti vAgdattAzca bhavanti</para>
  <para style="p">
    <verse number="35" style="v"/>kintu yE tajjagatprAptiyOgyatvEna gaNitAM bhaviSyanti zmazAnAccOtthAsyanti tE na vivahanti vAgdattAzca na bhavanti,</para>
  <para style="p">
    <verse number="36" style="v"/>tE puna rna mriyantE kintu zmazAnAdutthApitAH santa Izvarasya santAnAH svargIyadUtAnAM sadRzAzca bhavanti|</para>
  <para style="p">
    <verse number="37" style="v"/>adhikantu mUsAH stambOpAkhyAnE paramEzvara IbrAhIma Izvara ishAka IzvarO yAkUbazcEzvara ityuktvA mRtAnAM zmazAnAd utthAnasya pramANaM lilEkha|</para>
  <para style="p">
    <verse number="38" style="v"/>ataEva ya IzvaraH sa mRtAnAM prabhu rna kintu jIvatAmEva prabhuH, tannikaTE sarvvE jIvantaH santi|</para>
  <para style="p">
    <verse number="39" style="v"/>iti zrutvA kiyantOdhyApakA UcuH, hE upadEzaka bhavAn bhadraM pratyuktavAn|</para>
  <para style="p">
    <verse number="40" style="v"/>itaH paraM taM kimapi praSTaM tESAM pragalbhatA nAbhUt|</para>
  <para style="p">
    <verse number="41" style="v"/>pazcAt sa tAn uvAca, yaH khrISTaH sa dAyUdaH santAna EtAM kathAM lOkAH kathaM kathayanti?</para>
  <para style="p">
    <verse number="42" style="v"/>yataH mama prabhumidaM vAkyamavadat paramEzvaraH| tava zatrUnahaM yAvat pAdapIThaM karOmi na| tAvat kAlaM madIyE tvaM dakSapArzva upAviza|</para>
  <para style="p">
    <verse number="43" style="v"/>iti kathAM dAyUd svayaM gItagranthE'vadat|</para>
  <para style="p">
    <verse number="44" style="v"/>ataEva yadi dAyUd taM prabhuM vadati, tarhi sa kathaM tasya santAnO bhavati?</para>
  <para style="p">
    <verse number="45" style="v"/>pazcAd yIzuH sarvvajanAnAM karNagOcarE ziSyAnuvAca,</para>
  <para style="p">
    <verse number="46" style="v"/>yE'dhyApakA dIrghaparicchadaM paridhAya bhramanti, haTTApaNayO rnamaskArE bhajanagEhasya prOccAsanE bhOjanagRhasya pradhAnasthAnE ca prIyantE</para>
  <para style="p">
    <verse number="47" style="v"/>vidhavAnAM sarvvasvaM grasitvA chalEna dIrghakAlaM prArthayantE ca tESu sAvadhAnA bhavata, tESAmugradaNPO bhaviSyati|</para>
  <chapter number="21" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha dhanilOkA bhANPAgArE dhanaM nikSipanti sa tadEva pazyati,</para>
  <para style="p">
    <verse number="2" style="v"/>Etarhi kAciddInA vidhavA paNadvayaM nikSipati tad dadarza|</para>
  <para style="p">
    <verse number="3" style="v"/>tatO yIzuruvAca yuSmAnahaM yathArthaM vadAmi, daridrEyaM vidhavA sarvvEbhyOdhikaM nyakSEpsIt,</para>
  <para style="p">
    <verse number="4" style="v"/>yatOnyE svaprAjyadhanEbhya IzvarAya kinjcit nyakSEpsuH, kintu daridrEyaM vidhavA dinayApanArthaM svasya yat kinjcit sthitaM tat sarvvaM nyakSEpsIt|</para>
  <para style="p">
    <verse number="5" style="v"/>aparanjca uttamaprastarairutsRSTavyaizca mandiraM suzObhatEtarAM kaizcidityuktE sa pratyuvAca</para>
  <para style="p">
    <verse number="6" style="v"/>yUyaM yadidaM nicayanaM pazyatha, asya pASANaikOpyanyapASANOpari na sthAsyati, sarvvE bhUsAdbhaviSyanti kAlOyamAyAti|</para>
  <para style="p">
    <verse number="7" style="v"/>tadA tE papracchuH, hE gurO ghaTanEdRzI kadA bhaviSyati? ghaTanAyA EtasyasazcihnaM vA kiM bhaviSyati?</para>
  <para style="p">
    <verse number="8" style="v"/>tadA sa jagAda, sAvadhAnA bhavata yathA yuSmAkaM bhramaM kOpi na janayati, khISTOhamityuktvA mama nAmrA bahava upasthAsyanti sa kAlaH prAyENOpasthitaH, tESAM pazcAnmA gacchata|</para>
  <para style="p">
    <verse number="9" style="v"/>yuddhasyOpaplavasya ca vArttAM zrutvA mA zagkadhvaM, yataH prathamam EtA ghaTanA avazyaM bhaviSyanti kintu nApAtE yugAntO bhaviSyati|</para>
  <para style="p">
    <verse number="10" style="v"/>aparanjca kathayAmAsa, tadA dEzasya vipakSatvEna dEzO rAjyasya vipakSatvEna rAjyam utthAsyati,</para>
  <para style="p">
    <verse number="11" style="v"/>nAnAsthAnESu mahAbhUkampO durbhikSaM mArI ca bhaviSyanti, tathA vyOmamaNPalasya bhayagkaradarzanAnyazcaryyalakSaNAni ca prakAzayiSyantE|</para>
  <para style="p">
    <verse number="12" style="v"/>kintu sarvvAsAmEtAsAM ghaTanAnAM pUrvvaM lOkA yuSmAn dhRtvA tAPayiSyanti, bhajanAlayE kArAyAnjca samarpayiSyanti mama nAmakAraNAd yuSmAn bhUpAnAM zAsakAnAnjca sammukhaM nESyanti ca|</para>
  <para style="p">
    <verse number="13" style="v"/>sAkSyArtham EtAni yuSmAn prati ghaTiSyantE|</para>
  <para style="p">
    <verse number="14" style="v"/>tadA kimuttaraM vaktavyam Etat na cintayiSyAma iti manaHsu nizcitanuta|</para>
  <para style="p">
    <verse number="15" style="v"/>vipakSA yasmAt kimapyuttaram Apattinjca karttuM na zakSyanti tAdRzaM vAkpaTutvaM jnjAnanjca yuSmabhyaM dAsyAmi|</para>
  <para style="p">
    <verse number="16" style="v"/>kinjca yUyaM pitrA mAtrA bhrAtrA bandhunA jnjAtyA kuTumbEna ca parakarESu samarpayiSyadhvE; tatastE yuSmAkaM kanjcana kanjcana ghAtayiSyanti|</para>
  <para style="p">
    <verse number="17" style="v"/>mama nAmnaH kAraNAt sarvvai rmanuSyai ryUyam RtIyiSyadhvE|</para>
  <para style="p">
    <verse number="18" style="v"/>kintu yuSmAkaM ziraHkEzaikOpi na vinaMkSyati,</para>
  <para style="p">
    <verse number="19" style="v"/>tasmAdEva dhairyyamavalambya svasvaprANAn rakSata|</para>
  <para style="p">
    <verse number="20" style="v"/>aparanjca yirUzAlampuraM sainyavESTitaM vilOkya tasyOcchinnatAyAH samayaH samIpa ityavagamiSyatha|</para>
  <para style="p">
    <verse number="21" style="v"/>tadA yihUdAdEzasthA lOkAH parvvataM palAyantAM, yE ca nagarE tiSThanti tE dEzAntaraM palAyantA, yE ca grAmE tiSThanti tE nagaraM na pravizantu,</para>
  <para style="p">
    <verse number="22" style="v"/>yatastadA samucitadaNPanAya dharmmapustakE yAni sarvvANi likhitAni tAni saphalAni bhaviSyanti|</para>
  <para style="p">
    <verse number="23" style="v"/>kintu yA yAstadA garbhavatyaH stanyadAvyazca tAmAM durgati rbhaviSyati, yata EtAllOkAn prati kOpO dEzE ca viSamadurgati rghaTiSyatE|</para>
  <para style="p">
    <verse number="24" style="v"/>vastutastu tE khaggadhAraparivvaggaM lapsyantE baddhAH santaH sarvvadEzESu nAyiSyantE ca kinjcAnyadEzIyAnAM samayOpasthitiparyyantaM yirUzAlampuraM taiH padatalai rdalayiSyatE|</para>
  <para style="p">
    <verse number="25" style="v"/>sUryyacandranakSatrESu lakSaNAdi bhaviSyanti, bhuvi sarvvadEzIyAnAM duHkhaM cintA ca sindhau vIcInAM tarjanaM garjananjca bhaviSyanti|</para>
  <para style="p">
    <verse number="26" style="v"/>bhUbhau bhAvighaTanAM cintayitvA manujA bhiyAmRtakalpA bhaviSyanti, yatO vyOmamaNPalE tEjasvinO dOlAyamAnA bhaviSyanti|</para>
  <para style="p">
    <verse number="27" style="v"/>tadA parAkramENA mahAtEjasA ca mEghArUPhaM manuSyaputram AyAntaM drakSyanti|</para>
  <para style="p">
    <verse number="28" style="v"/>kintvEtAsAM ghaTanAnAmArambhE sati yUyaM mastakAnyuttOlya UrdadhvaM drakSyatha, yatO yuSmAkaM muktEH kAlaH savidhO bhaviSyati|</para>
  <para style="p">
    <verse number="29" style="v"/>tatastEnaitadRSTAntakathA kathitA, pazyata uPumbarAdivRkSANAM</para>
  <para style="p">
    <verse number="30" style="v"/>navInapatrANi jAtAnIti dRSTvA nidAvakAla upasthita iti yathA yUyaM jnjAtuM zaknutha,</para>
  <para style="p">
    <verse number="31" style="v"/>tathA sarvvAsAmAsAM ghaTanAnAm ArambhE dRSTE satIzvarasya rAjatvaM nikaTam ityapi jnjAsyatha|</para>
  <para style="p">
    <verse number="32" style="v"/>yuSmAnahaM yathArthaM vadAmi, vidyamAnalOkAnAmESAM gamanAt pUrvvam EtAni ghaTiSyantE|</para>
  <para style="p">
    <verse number="33" style="v"/>nabhObhuvOrlOpO bhaviSyati mama vAk tu kadApi luptA na bhaviSyati|</para>
  <para style="p">
    <verse number="34" style="v"/>ataEva viSamAzanEna pAnEna ca sAMmArikacintAbhizca yuSmAkaM cittESu mattESu taddinam akasmAd yuSmAn prati yathA nOpatiSThati tadarthaM svESu sAvadhAnAstiSThata|</para>
  <para style="p">
    <verse number="35" style="v"/>pRthivIsthasarvvalOkAn prati taddinam unmAtha iva upasthAsyati|</para>
  <para style="p">
    <verse number="36" style="v"/>yathA yUyam EtadbhAvighaTanA uttarttuM manujasutasya sammukhE saMsthAtunjca yOgyA bhavatha kAraNAdasmAt sAvadhAnAH santO nirantaraM prArthayadhvaM|</para>
  <para style="p">
    <verse number="37" style="v"/>aparanjca sa divA mandira upadizya rAcai jaitunAdriM gatvAtiSThat|</para>
  <para style="p">
    <verse number="38" style="v"/>tataH pratyUSE lAkAstatkathAM zrOtuM mandirE tadantikam Agacchan|</para>
  <chapter number="22" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparanjca kiNvazUnyapUpOtsavasya kAla upasthitE</para>
  <para style="p">
    <verse number="2" style="v"/>pradhAnayAjakA adhyAyakAzca yathA taM hantuM zaknuvanti tathOpAyAm acESTanta kintu lOkEbhyO bibhyuH|</para>
  <para style="p">
    <verse number="3" style="v"/>Etastin samayE dvAdazaziSyESu gaNita ISkariyOtIyarUPhimAn yO yihUdAstasyAntaHkaraNaM zaitAnAzritatvAt</para>
  <para style="p">
    <verse number="4" style="v"/>sa gatvA yathA yIzuM tESAM karESu samarpayituM zaknOti tathA mantraNAM pradhAnayAjakaiH sEnApatibhizca saha cakAra|</para>
  <para style="p">
    <verse number="5" style="v"/>tEna tE tuSTAstasmai mudrAM dAtuM paNaM cakruH|</para>
  <para style="p">
    <verse number="6" style="v"/>tataH sOggIkRtya yathA lOkAnAmagOcarE taM parakarESu samarpayituM zaknOti tathAvakAzaM cESTitumArEbhE|</para>
  <para style="p">
    <verse number="7" style="v"/>atha kiNvazUnyapUpOtmavadinE, arthAt yasmin dinE nistArOtsavasya mESO hantavyastasmin dinE</para>
  <para style="p">
    <verse number="8" style="v"/>yIzuH pitaraM yOhananjcAhUya jagAda, yuvAM gatvAsmAkaM bhOjanArthaM nistArOtsavasya dravyANyAsAdayataM|</para>
  <para style="p">
    <verse number="9" style="v"/>tadA tau papracchatuH kucAsAdayAvO bhavataH kEcchA?</para>
  <para style="p">
    <verse number="10" style="v"/>tadA sOvAdIt, nagarE praviSTE kazcijjalakumbhamAdAya yuvAM sAkSAt kariSyati sa yannivEzanaM pravizati yuvAmapi tannivEzanaM tatpazcAditvA nivEzanapatim iti vAkyaM vadataM,</para>
  <para style="p">
    <verse number="11" style="v"/>yatrAhaM nistArOtsavasya bhOjyaM ziSyaiH sArddhaM bhOktuM zaknOmi sAtithizAlAा kutra? kathAmimAM prabhustvAM pRcchati|</para>
  <para style="p">
    <verse number="12" style="v"/>tataH sa janO dvitIyaprakOSThIyam EkaM zastaM kOSThaM darzayiSyati tatra bhOjyamAsAdayataM|</para>
  <para style="p">
    <verse number="13" style="v"/>tatastau gatvA tadvAkyAnusArENa sarvvaM dRSdvA tatra nistArOtsavIyaM bhOjyamAsAdayAmAsatuH|</para>
  <para style="p">
    <verse number="14" style="v"/>atha kAla upasthitE yIzu rdvAdazabhiH prEritaiH saha bhOktumupavizya kathitavAn</para>
  <para style="p">
    <verse number="15" style="v"/>mama duHkhabhOgAt pUrvvaM yubhAbhiH saha nistArOtsavasyaitasya bhOjyaM bhOktuM mayAtivAnjchA kRtA|</para>
  <para style="p">
    <verse number="16" style="v"/>yuSmAn vadAmi, yAvatkAlam IzvararAjyE bhOjanaM na kariSyE tAvatkAlam idaM na bhOkSyE|</para>
  <para style="p">
    <verse number="17" style="v"/>tadA sa pAnapAtramAdAya Izvarasya guNAn kIrttayitvA tEbhyO datvAvadat, idaM gRhlIta yUyaM vibhajya pivata|</para>
  <para style="p">
    <verse number="18" style="v"/>yuSmAn vadAmi yAvatkAlam IzvararAjatvasya saMsthApanaM na bhavati tAvad drAkSAphalarasaM na pAsyAmi|</para>
  <para style="p">
    <verse number="19" style="v"/>tataH pUpaM gRhItvA IzvaraguNAn kIrttayitvA bhagktA tEbhyO datvAvadat, yuSmadarthaM samarpitaM yanmama vapustadidaM, Etat karmma mama smaraNArthaM kurudhvaM|</para>
  <para style="p">
    <verse number="20" style="v"/>atha bhOjanAntE tAdRzaM pAtraM gRhItvAvadat, yuSmatkRtE pAtitaM yanmama raktaM tEna nirNItanavaniyamarUpaM pAnapAtramidaM|</para>
  <para style="p">
    <verse number="21" style="v"/>pazyata yO mAM parakarESu samarpayiSyati sa mayA saha bhOjanAsana upavizati|</para>
  <para style="p">
    <verse number="22" style="v"/>yathA nirUpitamAstE tadanusArENA manuSyapuुtrasya gati rbhaviSyati kintu yastaM parakarESu samarpayiSyati tasya santApO bhaviSyati|</para>
  <para style="p">
    <verse number="23" style="v"/>tadA tESAM kO jana Etat karmma kariSyati tat tE parasparaM praSTumArEbhirE|</para>
  <para style="p">
    <verse number="24" style="v"/>aparaM tESAM kO janaH zrESThatvEna gaNayiSyatE, atrArthE tESAM vivAdObhavat|</para>
  <para style="p">
    <verse number="25" style="v"/>asmAt kAraNAt sOvadat, anyadEzIyAnAM rAjAnaH prajAnAmupari prabhutvaM kurvvanti dAruNazAsanaM kRtvApi tE bhUpatitvEna vikhyAtA bhavanti ca|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu yuSmAkaM tathA na bhaviSyati, yO yuSmAkaM zrESThO bhaviSyati sa kaniSThavad bhavatu, yazca mukhyO bhaviSyati sa sEvakavadbhavatu|</para>
  <para style="p">
    <verse number="27" style="v"/>bhOjanOpaviSTaparicArakayOH kaH zrESThaH? yO bhOjanAyOpavizati sa kiM zrESThO na bhavati? kintu yuSmAkaM madhyE'haM paricAraka_ivAsmi|</para>
  <para style="p">
    <verse number="28" style="v"/>aparanjca yuyaM mama parIkSAkAlE prathamamArabhya mayA saha sthitA</para>
  <para style="p">
    <verse number="29" style="v"/>EtatkAraNAt pitrA yathA madarthaM rAjyamEkaM nirUpitaM tathAhamapi yuSmadarthaM rAjyaM nirUpayAmi|</para>
  <para style="p">
    <verse number="30" style="v"/>tasmAn mama rAjyE bhOjanAsanE ca bhOjanapAnE kariSyadhvE siMhAsanESUpavizya cEsrAyElIyAnAM dvAdazavaMzAnAM vicAraM kariSyadhvE|</para>
  <para style="p">
    <verse number="31" style="v"/>aparaM prabhuruvAca, hE zimOn pazya tita_unA dhAnyAnIva yuSmAn zaitAn cAlayitum aicchat,</para>
  <para style="p">
    <verse number="32" style="v"/>kintu tava vizvAsasya lOpO yathA na bhavati Etat tvadarthaM prArthitaM mayA, tvanmanasi parivarttitE ca bhrAtRNAM manAMsi sthirIkuru|</para>
  <para style="p">
    <verse number="33" style="v"/>tadA sOvadat, hE prabhOhaM tvayA sArddhaM kArAM mRtinjca yAtuM majjitOsmi|</para>
  <para style="p">
    <verse number="34" style="v"/>tataH sa uvAca, hE pitara tvAM vadAmi, adya kukkuTaravAt pUrvvaM tvaM matparicayaM vAratrayam apahvOSyasE|</para>
  <para style="p">
    <verse number="35" style="v"/>aparaM sa papraccha, yadA mudrAsampuTaM khAdyapAtraM pAdukAnjca vinA yuSmAn prAhiNavaM tadA yuSmAkaM kasyApi nyUnatAsIt? tE prOcuH kasyApi na|</para>
  <para style="p">
    <verse number="36" style="v"/>tadA sOvadat kintvidAnIM mudrAsampuTaM khAdyapAtraM vA yasyAsti tEna tadgrahItavyaM, yasya ca kRpANOे nAsti tEna svavastraM vikrIya sa krEtavyaH|</para>
  <para style="p">
    <verse number="37" style="v"/>yatO yuSmAnahaM vadAmi, aparAdhijanaiH sArddhaM gaNitaH sa bhaviSyati| idaM yacchAstrIyaM vacanaM likhitamasti tanmayi phaliSyati yatO mama sambandhIyaM sarvvaM sEtsyati|</para>
  <para style="p">
    <verse number="38" style="v"/>tadA tE prOcuH prabhO pazya imau kRpANau| tataH sOvadad Etau yathESTau|</para>
  <para style="p">
    <verse number="39" style="v"/>atha sa tasmAdvahi rgatvA svAcArAnusArENa jaitunanAmAdriM jagAma ziSyAzca tatpazcAd yayuH|</para>
  <para style="p">
    <verse number="40" style="v"/>tatrOpasthAya sa tAnuvAca, yathA parIkSAyAM na patatha tadarthaM prArthayadhvaM|</para>
  <para style="p">
    <verse number="41" style="v"/>pazcAt sa tasmAd EkazarakSEpAd bahi rgatvA jAnunI pAtayitvA Etat prArthayAnjcakrE,</para>
  <para style="p">
    <verse number="42" style="v"/>hE pita ryadi bhavAn sammanyatE tarhi kaMsamEnaM mamAntikAd dUraya kintu madicchAnurUpaM na tvadicchAnurUpaM bhavatu|</para>
  <para style="p">
    <verse number="43" style="v"/>tadA tasmai zaktiM dAtuM svargIyadUtO darzanaM dadau|</para>
  <para style="p">
    <verse number="44" style="v"/>pazcAt sOtyantaM yAtanayA vyAkulO bhUtvA punardRPhaM prArthayAnjcakrE, tasmAd bRhacchONitabindava iva tasya svEdabindavaH pRthivyAM patitumArEbhirE|</para>
  <para style="p">
    <verse number="45" style="v"/>atha prArthanAta utthAya ziSyANAM samIpamEtya tAn manOduHkhinO nidritAn dRSTvAvadat</para>
  <para style="p">
    <verse number="46" style="v"/>kutO nidrAtha? parIkSAyAm apatanArthaM prarthayadhvaM|</para>
  <para style="p">
    <verse number="47" style="v"/>EtatkathAyAH kathanakAlE dvAdazaziSyANAM madhyE gaNitO yihUdAnAmA janatAsahitastESAm agrE calitvA yIzOzcumbanArthaM tadantikam Ayayau|</para>
  <para style="p">
    <verse number="48" style="v"/>tadA yIzuruvAca, hE yihUdA kiM cumbanEna manuSyaputraM parakarESu samarpayasi?</para>
  <para style="p">
    <verse number="49" style="v"/>tadA yadyad ghaTiSyatE tadanumAya saggibhiruktaM, hE prabhO vayaM ki khaggEna ghAtayiSyAmaH?</para>
  <para style="p">
    <verse number="50" style="v"/>tata EkaH karavAlEnAhatya pradhAnayAjakasya dAsasya dakSiNaM karNaM cicchEda|</para>
  <para style="p">
    <verse number="51" style="v"/>adhUnA nivarttasva ityuktvA yIzustasya zrutiM spRSTvA svasyaM cakAra|</para>
  <para style="p">
    <verse number="52" style="v"/>pazcAd yIzuH samIpasthAn pradhAnayAjakAn mandirasya sEnApatIn prAcInAMzca jagAda, yUyaM kRpANAn yaSTIMzca gRhItvA mAM kiM cOraM dharttumAyAtAH?</para>
  <para style="p">
    <verse number="53" style="v"/>yadAhaM yuSmAbhiH saha pratidinaM mandirE'tiSThaM tadA mAM dharttaM na pravRttAH, kintvidAnIM yuSmAkaM samayOndhakArasya cAdhipatyamasti|</para>
  <para style="p">
    <verse number="54" style="v"/>atha tE taM dhRtvA mahAyAjakasya nivEzanaM ninyuH| tataH pitarO dUrE dUrE pazcAditvA</para>
  <para style="p">
    <verse number="55" style="v"/>bRhatkOSThasya madhyE yatrAgniM jvAlayitvA lOkAH samEtyOpaviSTAstatra taiH sArddham upavivEza|</para>
  <para style="p">
    <verse number="56" style="v"/>atha vahnisannidhau samupavEzakAlE kAciddAsI manO nivizya taM nirIkSyAvadat pumAnayaM tasya saggE'sthAt|</para>
  <para style="p">
    <verse number="57" style="v"/>kintu sa tad apahnutyAvAdIt hE nAri tamahaM na paricinOmi|</para>
  <para style="p">
    <verse number="58" style="v"/>kSaNAntarE'nyajanastaM dRSTvAbravIt tvamapi tESAM nikarasyaikajanOsi| pitaraH pratyuvAca hE nara nAhamasmi|</para>
  <para style="p">
    <verse number="59" style="v"/>tataH sArddhadaNPadvayAt paraM punaranyO janO nizcitya babhASE, ESa tasya saggIti satyaM yatOyaM gAlIlIyO lOkaH|</para>
  <para style="p">
    <verse number="60" style="v"/>tadA pitara uvAca hE nara tvaM yad vadami tadahaM bOddhuM na zaknOmi, iti vAkyE kathitamAtrE kukkuTO rurAva|</para>
  <para style="p">
    <verse number="61" style="v"/>tadA prabhuNA vyAdhuTya pitarE nirIkSitE kRkavAkuravAt pUrvvaM mAM trirapahnOSyasE iti pUrvvOktaM tasya vAkyaM pitaraH smRtvA</para>
  <para style="p">
    <verse number="62" style="v"/>bahirgatvA mahAkhEdEna cakranda|</para>
  <para style="p">
    <verse number="63" style="v"/>tadA yai ryIzurdhRtastE tamupahasya praharttumArEbhirE|</para>
  <para style="p">
    <verse number="64" style="v"/>vastrENa tasya dRzau baddhvA kapOlE capETAghAtaM kRtvA papracchuH, kastE kapOlE capETAghAtaM kRtavAna? gaNayitvA tad vada|</para>
  <para style="p">
    <verse number="65" style="v"/>tadanyat tadviruddhaM bahunindAvAkyaM vaktumArEbhirE|</para>
  <para style="p">
    <verse number="66" style="v"/>atha prabhAtE sati lOkaprAnjcaH pradhAnayAjakA adhyApakAzca sabhAM kRtvA madhyEsabhaM yIzumAnIya papracchuH, tvam abhiSikatOsi na vAsmAn vada|</para>
  <para style="p">
    <verse number="67" style="v"/>sa pratyuvAca, mayA tasminnuktE'pi yUyaM na vizvasiSyatha|</para>
  <para style="p">
    <verse number="68" style="v"/>kasmiMzcidvAkyE yuSmAn pRSTE'pi mAM na taduttaraM vakSyatha na mAM tyakSyatha ca|</para>
  <para style="p">
    <verse number="69" style="v"/>kintvitaH paraM manujasutaH sarvvazaktimata Izvarasya dakSiNE pArzvE samupavEkSyati|</para>
  <para style="p">
    <verse number="70" style="v"/>tatastE papracchuH, rtiha tvamIzvarasya putraH? sa kathayAmAsa, yUyaM yathArthaM vadatha sa EvAhaM|</para>
  <para style="p">
    <verse number="71" style="v"/>tadA tE sarvvE kathayAmAsuH, rtiha sAkSyE'nsasmin asmAkaM kiM prayOjanaM? asya svamukhAdEva sAkSyaM prAptam|</para>
  <chapter number="23" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataH sabhAsthAH sarvvalOkA utthAya taM pIlAtasammukhaM nItvAprOdya vaktumArEbhirE,</para>
  <para style="p">
    <verse number="2" style="v"/>svamabhiSiktaM rAjAnaM vadantaM kaimararAjAya karadAnaM niSEdhantaM rAjyaviparyyayaM kurttuM pravarttamAnam Ena prAptA vayaM|</para>
  <para style="p">
    <verse number="3" style="v"/>tadA pIlAtastaM pRSTavAn tvaM kiM yihUdIyAnAM rAjA? sa pratyuvAca tvaM satyamuktavAn|</para>
  <para style="p">
    <verse number="4" style="v"/>tadA pIlAtaH pradhAnayAjakAdilOkAn jagAd, ahamEtasya kamapyaparAdhaM nAptavAn|</para>
  <para style="p">
    <verse number="5" style="v"/>tatastE punaH sAhaminO bhUtvAvadan, ESa gAlIla EtatsthAnaparyyantE sarvvasmin yihUdAdEzE sarvvAllOkAnupadizya kupravRttiM grAhItavAn|</para>
  <para style="p">
    <verse number="6" style="v"/>tadA pIlAtO gAlIlapradEzasya nAma zrutvA papraccha, kimayaM gAlIlIyO lOkaH?</para>
  <para style="p">
    <verse number="7" style="v"/>tataH sa gAlIlpradEzIyahErOdrAjasya tadA sthitEstasya samIpE yIzuM prESayAmAsa|</para>
  <para style="p">
    <verse number="8" style="v"/>tadA hErOd yIzuM vilOkya santutOSa, yataH sa tasya bahuvRttAntazravaNAt tasya kinji्cadAzcaryyakarmma pazyati ityAzAM kRtvA bahukAlamArabhya taM draSTuM prayAsaM kRtavAn|</para>
  <para style="p">
    <verse number="9" style="v"/>tasmAt taM bahukathAH papraccha kintu sa tasya kasyApi vAkyasya pratyuttaraM nOvAca|</para>
  <para style="p">
    <verse number="10" style="v"/>atha pradhAnayAjakA adhyApakAzca prOttiSThantaH sAhasEna tamapavadituM prArEbhirE|</para>
  <para style="p">
    <verse number="11" style="v"/>hErOd tasya sEnAgaNazca tamavajnjAya upahAsatvEna rAjavastraM paridhApya punaH pIlAtaM prati taM prAhiNOt|</para>
  <para style="p">
    <verse number="12" style="v"/>pUrvvaM hErOdpIlAtayOH parasparaM vairabhAva AsIt kintu taddinE dvayO rmElanaM jAtam|</para>
  <para style="p">
    <verse number="13" style="v"/>pazcAt pIlAtaH pradhAnayAjakAn zAsakAn lOkAMzca yugapadAhUya babhASE,</para>
  <para style="p">
    <verse number="14" style="v"/>rAjyaviparyyayakArakOyam ityuktvA manuSyamEnaM mama nikaTamAnaiSTa kintu pazyata yuSmAkaM samakSam asya vicAraM kRtvApi prOktApavAdAnurUpENAsya kOpyaparAdhaH sapramANO na jAtaH,</para>
  <para style="p">
    <verse number="15" style="v"/>yUyanjca hErOdaH sannidhau prESitA mayA tatrAsya kOpyaparAdhastEnApi na prAptaH|pazyatAnEna vadhahEेtukaM kimapi nAparAddhaM|</para>
  <para style="p">
    <verse number="16" style="v"/>tasmAdEnaM tAPayitvA vihAsyAmi|</para>
  <para style="p">
    <verse number="17" style="v"/>tatrOtsavE tESAmEkO mOcayitavyaH|</para>
  <para style="p">
    <verse number="18" style="v"/>iti hEtOstE prOccairEkadA prOcuH, EnaM dUrIkRtya barabbAnAmAnaM mOcaya|</para>
  <para style="p">
    <verse number="19" style="v"/>sa barabbA nagara upaplavavadhAparAdhAbhyAM kArAyAM baddha AsIt|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu pIlAtO yIzuM mOcayituM vAnjchan punastAnuvAca|</para>
  <para style="p">
    <verse number="21" style="v"/>tathApyEnaM kruzE vyadha kruzE vyadhEti vadantastE ruruvuH|</para>
  <para style="p">
    <verse number="22" style="v"/>tataH sa tRtIyavAraM jagAda kutaH? sa kiM karmma kRtavAn? nAhamasya kamapi vadhAparAdhaM prAptaH kEvalaM tAPayitvAmuM tyajAmi|</para>
  <para style="p">
    <verse number="23" style="v"/>tathApi tE punarEnaM kruzE vyadha ityuktvA prOccairdRPhaM prArthayAnjcakrirE;</para>
  <para style="p">
    <verse number="24" style="v"/>tataH pradhAnayAjakAdInAM kalaravE prabalE sati tESAM prArthanArUpaM karttuM pIlAta AdidEza|</para>
  <para style="p">
    <verse number="25" style="v"/>rAjadrOhavadhayOraparAdhEna kArAsthaM yaM janaM tE yayAcirE taM mOcayitvA yIzuM tESAmicchAyAM samArpayat|</para>
  <para style="p">
    <verse number="26" style="v"/>atha tE yIzuM gRhItvA yAnti, Etarhi grAmAdAgataM zimOnanAmAnaM kurINIyaM janaM dhRtvA yIzOH pazcAnnEtuM tasya skandhE kruzamarpayAmAsuH|</para>
  <para style="p">
    <verse number="27" style="v"/>tatO lOाkAraNyamadhyE bahustriyO rudatyO vilapantyazca yIzOH pazcAd yayuH|</para>
  <para style="p">
    <verse number="28" style="v"/>kintu sa vyAghuTya tA uvAca, hE yirUzAlamO nAryyO yuyaM madarthaM na ruditvA svArthaM svApatyArthanjca ruditi;</para>
  <para style="p">
    <verse number="29" style="v"/>pazyata yaH kadApi garbhavatyO nAbhavan stanyanjca nApAyayan tAdRzI rvandhyA yadA dhanyA vakSyanti sa kAla AyAti|</para>
  <para style="p">
    <verse number="30" style="v"/>tadA hE zailA asmAkamupari patata, hE upazailA asmAnAcchAdayata kathAmIdRzIM lOkA vakSyanti|</para>
  <para style="p">
    <verse number="31" style="v"/>yataH satEjasi zAkhini cEdEtad ghaTatE tarhi zuSkazAkhini kiM na ghaTiSyatE?</para>
  <para style="p">
    <verse number="32" style="v"/>tadA tE hantuM dvAvaparAdhinau tEna sArddhaM ninyuH|</para>
  <para style="p">
    <verse number="33" style="v"/>aparaM ziraHkapAlanAmakasthAnaM prApya taM kruzE vividhuH; taddvayOraparAdhinOrEkaM tasya dakSiNO tadanyaM vAmE kruzE vividhuH|</para>
  <para style="p">
    <verse number="34" style="v"/>tadA yIzurakathayat, hE pitarEtAn kSamasva yata EtE yat karmma kurvvanti tan na viduH; pazcAttE guTikApAtaM kRtvA tasya vastrANi vibhajya jagRhuH|</para>
  <para style="p">
    <verse number="35" style="v"/>tatra lOkasaMghastiSThan dadarza; tE tESAM zAsakAzca tamupahasya jagaduH, ESa itarAn rakSitavAn yadIzvarENAbhirucitO 'bhiSiktastrAtA bhavati tarhi svamadhunA rakSatu|</para>
  <para style="p">
    <verse number="36" style="v"/>tadanyaH sEnAgaNA Etya tasmai amlarasaM datvA parihasya prOvAca,</para>
  <para style="p">
    <verse number="37" style="v"/>cEttvaM yihUdIyAnAM rAjAsi tarhi svaM rakSa|</para>
  <para style="p">
    <verse number="38" style="v"/>yihUdIyAnAM rAjEti vAkyaM yUnAnIyarOmIyEbrIyAkSarai rlikhitaM tacchirasa UrddhvE'sthApyata|</para>
  <para style="p">
    <verse number="39" style="v"/>tadObhayapArzvayO rviddhau yAvaparAdhinau tayOrEkastaM vinindya babhASE, cEttvam abhiSiktOsi tarhi svamAvAnjca rakSa|</para>
  <para style="p">
    <verse number="40" style="v"/>kintvanyastaM tarjayitvAvadat, IzvarAttava kinjcidapi bhayaM nAsti kiM? tvamapi samAnadaNPOsi,</para>
  <para style="p">
    <verse number="41" style="v"/>yOgyapAtrE AvAM svasvakarmmaNAM samucitaphalaM prApnuvaH kintvanEna kimapi nAparAddhaM|</para>
  <para style="p">
    <verse number="42" style="v"/>atha sa yIzuM jagAda hE prabhE bhavAn svarAjyapravEzakAlE mAM smaratu|</para>
  <para style="p">
    <verse number="43" style="v"/>tadA yIzuH kathitavAn tvAM yathArthaM vadAmi tvamadyaiva mayA sArddhaM paralOkasya sukhasthAnaM prApsyasi|</para>
  <para style="p">
    <verse number="44" style="v"/>aparanjca dvitIyayAmAt tRtIyayAmaparyyantaM ravEstEjasOntarhitatvAt sarvvadEzO'ndhakArENAvRtO</para>
  <para style="p">
    <verse number="45" style="v"/>mandirasya yavanikA ca chidyamAnA dvidhA babhUva|</para>
  <para style="p">
    <verse number="46" style="v"/>tatO yIzuruccairuvAca, hE pita rmamAtmAnaM tava karE samarpayE, ityuktvA sa prANAn jahau|</para>
  <para style="p">
    <verse number="47" style="v"/>tadaitA ghaTanA dRSTvA zatasEnApatirIzvaraM dhanyamuktvA kathitavAn ayaM nitAntaM sAdhumanuSya AsIt|</para>
  <para style="p">
    <verse number="48" style="v"/>atha yAvantO lOkA draSTum AgatAstE tA ghaTanA dRSTvA vakSaHsu karAghAtaM kRtvA vyAcuTya gatAH|</para>
  <para style="p">
    <verse number="49" style="v"/>yIzO rjnjAtayO yA yA yOSitazca gAlIlastEna sArddhamAyAtAstA api dUrE sthitvA tat sarvvaM dadRzuH|</para>
  <para style="p">
    <verse number="50" style="v"/>tadA yihUdIyAnAM mantraNAM kriyAnjcAsammanyamAna Izvarasya rAjatvam apEkSamANO</para>
  <para style="p">
    <verse number="51" style="v"/>yihUdidEzIyO 'rimathIyanagarIyO yUSaphnAmA mantrI bhadrO dhArmmikazca pumAn</para>
  <para style="p">
    <verse number="52" style="v"/>pIlAtAntikaM gatvA yIzO rdEhaM yayAcE|</para>
  <para style="p">
    <verse number="53" style="v"/>pazcAd vapuravarOhya vAsasA saMvESTya yatra kOpi mAnuSO nAsthApyata tasmin zailE svAtE zmazAnE tadasthApayat|</para>
  <para style="p">
    <verse number="54" style="v"/>taddinamAyOjanIyaM dinaM vizrAmavArazca samIpaH|</para>
  <para style="p">
    <verse number="55" style="v"/>aparaM yIzunA sArddhaM gAlIla AgatA yOSitaH pazcAditvA zmazAnE tatra yathA vapuH sthApitaM tacca dRSTvA</para>
  <para style="p">
    <verse number="56" style="v"/>vyAghuTya sugandhidravyatailAni kRtvA vidhivad vizrAmavArE vizrAmaM cakruH|</para>
  <chapter number="24" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha saptAhaprathamadinE'tipratyUSE tA yOSitaH sampAditaM sugandhidravyaM gRhItvA tadanyAbhiH kiyatIbhiH strIbhiH saha zmazAnaM yayuH|</para>
  <para style="p">
    <verse number="2" style="v"/>kintu zmazAnadvArAt pASANamapasAritaM dRSTvA</para>
  <para style="p">
    <verse number="3" style="v"/>tAH pravizya prabhO rdEhamaprApya</para>
  <para style="p">
    <verse number="4" style="v"/>vyAkulA bhavanti Etarhi tEjOmayavastrAnvitau dvau puruSau tAsAM samIpE samupasthitau</para>
  <para style="p">
    <verse number="5" style="v"/>tasmAttAH zagkAyuktA bhUmAvadhOmukhyasyasthuH| tadA tau tA Ucatu rmRtAnAM madhyE jIvantaM kutO mRgayatha?</para>
  <para style="p">
    <verse number="6" style="v"/>sOtra nAsti sa udasthAt|</para>
  <para style="p">
    <verse number="7" style="v"/>pApinAM karESu samarpitEna kruzE hatEna ca manuSyaputrENa tRtIyadivasE zmazAnAdutthAtavyam iti kathAM sa galIli tiSThan yuSmabhyaM kathitavAn tAM smarata|</para>
  <para style="p">
    <verse number="8" style="v"/>tadA tasya sA kathA tAsAM manaHsu jAtA|</para>
  <para style="p">
    <verse number="9" style="v"/>anantaraM zmazAnAd gatvA tA EkAdazaziSyAdibhyaH sarvvEbhyastAM vArttAM kathayAmAsuH|</para>
  <para style="p">
    <verse number="10" style="v"/>magdalInImariyam, yOhanA, yAkUbO mAtA mariyam tadanyAH sagginyO yOSitazca prEritEbhya EtAH sarvvA vArttAH kathayAmAsuH</para>
  <para style="p">
    <verse number="11" style="v"/>kintu tAsAM kathAm anarthakAkhyAnamAtraM buddhvA kOpi na pratyait|</para>
  <para style="p">
    <verse number="12" style="v"/>tadA pitara utthAya zmazAnAntikaM dadhAva, tatra ca prahvO bhUtvA pArzvaikasthApitaM kEvalaM vastraM dadarza; tasmAdAzcaryyaM manyamAnO yadaghaTata tanmanasi vicArayan pratasthE|</para>
  <para style="p">
    <verse number="13" style="v"/>tasminnEva dinE dvau ziyyau yirUzAlamazcatuSkrOzAntaritam immAyugrAmaM gacchantau</para>
  <para style="p">
    <verse number="14" style="v"/>tAsAM ghaTanAnAM kathAmakathayatAM</para>
  <para style="p">
    <verse number="15" style="v"/>tayOrAlApavicArayOH kAlE yIzurAgatya tAbhyAM saha jagAma</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yathA tau taM na paricinutastadarthaM tayO rdRSTiH saMruddhA|</para>
  <para style="p">
    <verse number="17" style="v"/>sa tau pRSTavAn yuvAM viSaNNau kiM vicArayantau gacchathaH?</para>
  <para style="p">
    <verse number="18" style="v"/>tatastayOH kliyapAnAmA pratyuvAca yirUzAlamapurE'dhunA yAnyaghaTanta tvaM kEvalavidEzI kiM tadvRttAntaM na jAnAsi?</para>
  <para style="p">
    <verse number="19" style="v"/>sa papraccha kA ghaTanAH? tadA tau vaktumArEbhAtE yIzunAmA yO nAsaratIyO bhaviSyadvAdI Izvarasya mAnuSANAnjca sAkSAt vAkyE karmmaNi ca zaktimAnAsIt</para>
  <para style="p">
    <verse number="20" style="v"/>tam asmAkaM pradhAnayAjakA vicArakAzca kEnApi prakArENa kruzE viddhvA tasya prANAnanAzayan tadIyA ghaTanAH;</para>
  <para style="p">
    <verse number="21" style="v"/>kintu ya isrAyElIyalOkAn uddhArayiSyati sa EvAyam ityAzAsmAbhiH kRtA|tadyathA tathAstu tasyA ghaTanAyA adya dinatrayaM gataM|</para>
  <para style="p">
    <verse number="22" style="v"/>adhikantvasmAkaM sagginInAM kiyatstrINAM mukhEbhyO'sambhavavAkyamidaM zrutaM;</para>
  <para style="p">
    <verse number="23" style="v"/>tAH pratyUSE zmazAnaM gatvA tatra tasya dEham aprApya vyAghuTyEtvA prOktavatyaH svargIsadUtau dRSTAvasmAbhistau cAvAdiSTAM sa jIvitavAn|</para>
  <para style="p">
    <verse number="24" style="v"/>tatOsmAkaM kaizcit zmazAnamagamyata tE'pi strINAM vAkyAnurUpaM dRSTavantaH kintu taM nApazyan|</para>
  <para style="p">
    <verse number="25" style="v"/>tadA sa tAvuvAca, hE abOdhau hE bhaviSyadvAdibhiruktavAkyaM pratyEtuM vilambamAnau;</para>
  <para style="p">
    <verse number="26" style="v"/>EtatsarvvaduHkhaM bhuktvA svabhUtiprAptiH kiM khrISTasya na nyAyyA?</para>
  <para style="p">
    <verse number="27" style="v"/>tataH sa mUsAgranthamArabhya sarvvabhaviSyadvAdinAM sarvvazAstrE svasmin likhitAkhyAnAbhiprAyaM bOdhayAmAsa|</para>
  <para style="p">
    <verse number="28" style="v"/>atha gamyagrAmAbhyarNaM prApya tEnAgrE gamanalakSaNE darzitE</para>
  <para style="p">
    <verse number="29" style="v"/>tau sAdhayitvAvadatAM sahAvAbhyAM tiSTha dinE gatE sati rAtrirabhUt; tataH sa tAbhyAM sArddhaM sthAtuM gRhaM yayau|</para>
  <para style="p">
    <verse number="30" style="v"/>pazcAdbhOjanOpavEzakAlE sa pUpaM gRhItvA IzvaraguNAn jagAda tanjca bhaMktvA tAbhyAM dadau|</para>
  <para style="p">
    <verse number="31" style="v"/>tadA tayO rdRSTau prasannAyAM taM pratyabhijnjatuH kintu sa tayOH sAkSAdantardadhE|</para>
  <para style="p">
    <verse number="32" style="v"/>tatastau mithObhidhAtum Arabdhavantau gamanakAlE yadA kathAmakathayat zAstrArthanjcabOdhayat tadAvayO rbuddhiH kiM na prAjvalat?</para>
  <para style="p">
    <verse number="33" style="v"/>tau tatkSaNAdutthAya yirUzAlamapuraM pratyAyayatuH, tatsthAnE ziSyANAm EkAdazAnAM sagginAnjca darzanaM jAtaM|</para>
  <para style="p">
    <verse number="34" style="v"/>tE prOcuH prabhurudatiSThad iti satyaM zimOnE darzanamadAcca|</para>
  <para style="p">
    <verse number="35" style="v"/>tataH pathaH sarvvaghaTanAyAH pUpabhanjjanEna tatparicayasya ca sarvvavRttAntaM tau vaktumArEbhAtE|</para>
  <para style="p">
    <verse number="36" style="v"/>itthaM tE parasparaM vadanti tatkAlE yIzuH svayaM tESAM madhya prOtthaya yuSmAkaM kalyANaM bhUyAd ityuvAca,</para>
  <para style="p">
    <verse number="37" style="v"/>kintu bhUtaM pazyAma ityanumAya tE samudvivijirE trESuzca|</para>
  <para style="p">
    <verse number="38" style="v"/>sa uvAca, kutO duHkhitA bhavatha? yuSmAkaM manaHsu sandEha udEti ca kutaH?</para>
  <para style="p">
    <verse number="39" style="v"/>ESOhaM, mama karau pazyata varaM spRSTvA pazyata, mama yAdRzAni pazyatha tAdRzAni bhUtasya mAMsAsthIni na santi|</para>
  <para style="p">
    <verse number="40" style="v"/>ityuktvA sa hastapAdAn darzayAmAsa|</para>
  <para style="p">
    <verse number="41" style="v"/>tE'sambhavaM jnjAtvA sAnandA na pratyayan| tataH sa tAn papraccha, atra yuSmAkaM samIpE khAdyaM kinjcidasti?</para>
  <para style="p">
    <verse number="42" style="v"/>tatastE kiyaddagdhamatsyaM madhu ca daduH</para>
  <para style="p">
    <verse number="43" style="v"/>sa tadAdAya tESAM sAkSAd bubhujE</para>
  <para style="p">
    <verse number="44" style="v"/>kathayAmAsa ca mUsAvyavasthAyAM bhaviSyadvAdinAM granthESu gItapustakE ca mayi yAni sarvvANi vacanAni likhitAni tadanurUpANi ghaTiSyantE yuSmAbhiH sArddhaM sthitvAhaM yadEtadvAkyam avadaM tadidAnIM pratyakSamabhUt|</para>
  <para style="p">
    <verse number="45" style="v"/>atha tEbhyaH zAstrabOdhAdhikAraM datvAvadat,</para>
  <para style="p">
    <verse number="46" style="v"/>khrISTEnEtthaM mRtiyAtanA bhOktavyA tRtIyadinE ca zmazAnAdutthAtavyanjcEti lipirasti;</para>
  <para style="p">
    <verse number="47" style="v"/>tannAmnA yirUzAlamamArabhya sarvvadEzE manaHparAvarttanasya pApamOcanasya ca susaMvAdaH pracArayitavyaH,</para>
  <para style="p">
    <verse number="48" style="v"/>ESu sarvvESu yUyaM sAkSiNaH|</para>
  <para style="p">
    <verse number="49" style="v"/>aparanjca pazyata pitrA yat pratijnjAtaM tat prESayiSyAmi, ataEva yAvatkAlaM yUyaM svargIyAM zaktiM na prApsyatha tAvatkAlaM yirUzAlamnagarE tiSThata|</para>
  <para style="p">
    <verse number="50" style="v"/>atha sa tAn baithanIyAparyyantaM nItvA hastAvuttOlya AziSa vaktumArEbhE</para>
  <para style="p">
    <verse number="51" style="v"/>AziSaM vadannEva ca tEbhyaH pRthag bhUtvA svargAya nItO'bhavat|</para>
  <para style="p">
    <verse number="52" style="v"/>tadA tE taM bhajamAnA mahAnandEna yirUzAlamaM pratyAjagmuH|</para>
  <para style="p">
    <verse number="53" style="v"/>tatO nirantaraM mandirE tiSThanta Izvarasya prazaMsAM dhanyavAdanjca karttam ArEbhirE| iti||</para>
</usx>
