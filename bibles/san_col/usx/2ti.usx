  <para style="h">2 Timothy</para>
  <para style="toc1">2 tImathiyaM patraM</para>
  <para style="toc2">2 tImathiyaH</para>
  <para style="toc3">2 tImathiyaH</para>
  <para style="mt1">2 tImathiyaM patraM</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>khrISTEna yIzunA yA jIvanasya pratijnjA tAmadhIzvarasyEcchayA yIzOH khrISTasyaikaH prEritaH paulO'haM svakIyaM priyaM dharmmaputraM tImathiyaM prati patraM likhAmi|</para>
  <para style="p">
    <verse number="2" style="v"/>tAta IzvarO'smAkaM prabhu ryIzukhrISTazca tvayi prasAdaM dayAM zAntinjca kriyAstAM|</para>
  <para style="p">
    <verse number="3" style="v"/>aham A pUrvvapuruSAt yam IzvaraM pavitramanasA sEvE taM dhanyaM vadanaM kathayAmi, aham ahOrAtraM prArthanAsamayE tvAM nirantaraM smarAmi|</para>
  <para style="p">
    <verse number="4" style="v"/>yazca vizvAsaH prathamE lOyInAmikAyAM tava mAtAmahyAm unIkInAmikAyAM mAtari cAtiSThat tavAntarE'pi tiSThatIti manyE</para>
  <para style="p">
    <verse number="5" style="v"/>tava taM niSkapaTaM vizvAsaM manasi kurvvan tavAzrupAtaM smaran yathAnandEna praphallO bhavEyaM tadarthaM tava darzanam AkAgkSE|</para>
  <para style="p">
    <verse number="6" style="v"/>atO hEtO rmama hastArpaNEna labdhO ya Izvarasya varastvayi vidyatE tam ujjvAlayituM tvAM smArayAmi|</para>
  <para style="p">
    <verse number="7" style="v"/>yata IzvarO'smabhyaM bhayajanakam AtmAnam adattvA zaktiprEmasatarkatAnAm Akaram AtmAnaM dattavAn|</para>
  <para style="p">
    <verse number="8" style="v"/>ataEvAsmAkaM prabhumadhi tasya vandidAsaM mAmadhi ca pramANaM dAtuM na trapasva kintvIzvarIyazaktyA susaMvAdasya kRtE duHkhasya sahabhAgI bhava|</para>
  <para style="p">
    <verse number="9" style="v"/>sO'smAn paritrANapAtrANi kRtavAn pavitrENAhvAnEnAhUtavAMzca; asmatkarmmahEtunEti nahi svIyanirUpANasya prasAdasya ca kRtE tat kRtavAn| sa prasAdaH sRSTEH pUrvvakAlE khrISTEna yIzunAsmabhyam adAyi,</para>
  <para style="p">
    <verse number="10" style="v"/>kintvadhunAsmAkaM paritrAtu ryIzOH khrISTasyAgamanEna prAkAzata| khrISTO mRtyuM parAjitavAn susaMvAdEna ca jIvanam amaratAnjca prakAzitavAn|</para>
  <para style="p">
    <verse number="11" style="v"/>tasya ghOSayitA dUtazcAnyajAtIyAnAM zikSakazcAhaM niyuktO'smi|</para>
  <para style="p">
    <verse number="12" style="v"/>tasmAt kAraNAt mamAyaM klEzO bhavati tEna mama lajjA na jAyatE yatO'haM yasmin vizvasitavAn tamavagatO'smi mahAdinaM yAvat mamOpanidhE rgOpanasya zaktistasya vidyata iti nizcitaM jAnAmi|</para>
  <para style="p">
    <verse number="13" style="v"/>hitadAyakAnAM vAkyAnAm AdarzarUpENa mattaH zrutAH khrISTE yIzau vizvAsaprEmnOH kathA dhAraya|</para>
  <para style="p">
    <verse number="14" style="v"/>aparam asmadantarvAsinA pavitrENAtmanA tAmuttamAm upanidhiM gOpaya|</para>
  <para style="p">
    <verse number="15" style="v"/>AziyAdEzIyAH sarvvE mAM tyaktavanta iti tvaM jAnAsi tESAM madhyE phUgillO harmmaginizca vidyEtE|</para>
  <para style="p">
    <verse number="16" style="v"/>prabhuranISipharasya parivArAn prati kRpAM vidadhAtu yataH sa punaH puna rmAm ApyAyitavAn</para>
  <para style="p">
    <verse number="17" style="v"/>mama zRgkhalEna na trapitvA rOmAnagarE upasthitisamayE yatnEna mAM mRgayitvA mamOddEzaM prAptavAn|</para>
  <para style="p">
    <verse number="18" style="v"/>atO vicAradinE sa yathA prabhOH kRpAbhAjanaM bhavEt tAdRzaM varaM prabhustasmai dEyAt| iphiSanagarE'pi sa kati prakArai rmAm upakRtavAn tat tvaM samyag vEtsi|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>hE mama putra, khrISTayIzutO yO'nugrahastasya balEna tvaM balavAn bhava|</para>
  <para style="p">
    <verse number="2" style="v"/>aparaM bahubhiH sAkSibhiH pramANIkRtAM yAM zikSAM zrutavAnasi tAM vizvAsyESu parasmai zikSAdAnE nipuNESu ca lOkESu samarpaya|</para>
  <para style="p">
    <verse number="3" style="v"/>tvaM yIzukhrISTasyOttamO yOddhEva klEzaM sahasva|</para>
  <para style="p">
    <verse number="4" style="v"/>yO yuddhaM karOti sa sAMsArikE vyApArE magnO na bhavati kintu svaniyOjayitrE rOcituM cESTatE|</para>
  <para style="p">
    <verse number="5" style="v"/>aparaM yO mallai ryudhyati sa yadi niyamAnusArENa na yuddhyati tarhi kirITaM na lapsyatE|</para>
  <para style="p">
    <verse number="6" style="v"/>aparaM yaH kRSIvalaH karmma karOti tEna prathamEna phalabhAginA bhavitavyaM|</para>
  <para style="p">
    <verse number="7" style="v"/>mayA yaducyatE tat tvayA budhyatAM yataH prabhustubhyaM sarvvatra buddhiM dAsyati|</para>
  <para style="p">
    <verse number="8" style="v"/>mama susaMvAdasya vacanAnusArAd dAyUdvaMzIyaM mRtagaNamadhyAd utthApitanjca yIzuM khrISTaM smara|</para>
  <para style="p">
    <verse number="9" style="v"/>tatsusaMvAdakAraNAd ahaM duSkarmmEva bandhanadazAparyyantaM klEzaM bhunjjE kintvIzvarasya vAkyam abaddhaM tiSThati|</para>
  <para style="p">
    <verse number="10" style="v"/>khrISTEna yIzunA yad anantagauravasahitaM paritrANaM jAyatE tadabhirucitai rlOkairapi yat labhyEta tadarthamahaM tESAM nimittaM sarvvANyEtAni sahE|</para>
  <para style="p">
    <verse number="11" style="v"/>aparam ESA bhAratI satyA yadi vayaM tEna sArddhaM mriyAmahE tarhi tEna sArddhaM jIvivyAmaH, yadi ca klEzaM sahAmahE tarhi tEna sArddhaM rAjatvamapi kariSyAmahE|</para>
  <para style="p">
    <verse number="12" style="v"/>yadi vayaM tam anaggIkurmmastarhi sO 'smAnapyanaggIkariSyati|</para>
  <para style="p">
    <verse number="13" style="v"/>yadi vayaM na vizvAsAmastarhi sa vizvAsyastiSThati yataH svam apahnOtuM na zaknOti|</para>
  <para style="p">
    <verse number="14" style="v"/>tvamEtAni smArayan tE yathA niSphalaM zrOtRNAM bhraMzajanakaM vAgyuddhaM na kuryyastathA prabhOH samakSaM dRPhaM vinIyAdiza|</para>
  <para style="p">
    <verse number="15" style="v"/>aparaM tvam Izvarasya sAkSAt svaM parIkSitam anindanIyakarmmakAriNanjca satyamatasya vAkyAnAM sadvibhajanE nipuNanjca darzayituM yatasva|</para>
  <para style="p">
    <verse number="16" style="v"/>kintvapavitrA anarthakakathA dUrIkuru yatastadAlambina uttarOttaram adharmmE varddhiSyantE,</para>
  <para style="p">
    <verse number="17" style="v"/>tESAnjca vAkyaM galitakSatavat kSayavarddhakO bhaviSyati tESAM madhyE huminAyaH philItazcEtinAmAnau dvau janau satyamatAd bhraSTau jAtau,</para>
  <para style="p">
    <verse number="18" style="v"/>mRtAnAM punarutthiti rvyatItEti vadantau kESAnjcid vizvAsam utpATayatazca|</para>
  <para style="p">
    <verse number="19" style="v"/>tathApIzvarasya bhittimUlam acalaM tiSThati tasmiMzcEyaM lipi rmudrAgkitA vidyatE| yathA, jAnAti paramEzastu svakIyAn sarvvamAnavAn| apagacchEd adharmmAcca yaH kazcit khrISTanAmakRt||</para>
  <para style="p">
    <verse number="20" style="v"/>kintu bRhannikEtanE kEvala suvarNamayAni raupyamayANi ca bhAjanAni vidyanta iti tarhi kASThamayAni mRNmayAnyapi vidyantE tESAnjca kiyanti sammAnAya kiyantapamAnAya ca bhavanti|</para>
  <para style="p">
    <verse number="21" style="v"/>atO yadi kazcid EtAdRzEbhyaH svaM pariSkarOti tarhi sa pAvitaM prabhOH kAryyayOgyaM sarvvasatkAryyAyOpayuktaM sammAnArthakanjca bhAjanaM bhaviSyati|</para>
  <para style="p">
    <verse number="22" style="v"/>yauvanAvasthAyA abhilASAstvayA parityajyantAM dharmmO vizvAsaH prEma yE ca zucimanObhiH prabhum uddizya prArthanAM kurvvatE taiH sArddham aikyabhAvazcaitESu tvayA yatnO vidhIyatAM|</para>
  <para style="p">
    <verse number="23" style="v"/>aparaM tvam anarthakAn ajnjAnAMzca praznAn vAgyuddhOtpAdakAn jnjAtvA dUrIkuru|</para>
  <para style="p">
    <verse number="24" style="v"/>yataH prabhO rdAsEna yuddham akarttavyaM kintu sarvvAn prati zAntEna zikSAdAnEcchukEna sahiSNunA ca bhavitavyaM, vipakSAzca tEna namratvEna cEtitavyAH|</para>
  <para style="p">
    <verse number="25" style="v"/>tathA kRtE yadIzvaraH satyamatasya jnjAnArthaM tEbhyO manaHparivarttanarUpaM varaM dadyAt,</para>
  <para style="p">
    <verse number="26" style="v"/>tarhi tE yEna zayatAnEna nijAbhilASasAdhanAya dhRtAstasya jAlAt cEtanAM prApyOddhAraM labdhuM zakSyanti|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>caramadinESu klEzajanakAH samayA upasthAsyantIti jAnIhi|</para>
  <para style="p">
    <verse number="2" style="v"/>yatastAtkAlikA lOkA AtmaprEmiNO 'rthaprEmiNa AtmazlAghinO 'bhimAninO nindakAH pitrOranAjnjAgrAhiNaH kRtaghnA apavitrAH</para>
  <para style="p">
    <verse number="3" style="v"/>prItivarjitA asandhEyA mRSApavAdinO 'jitEndriyAH pracaNPA bhadradvESiNO</para>
  <para style="p">
    <verse number="4" style="v"/>vizvAsaghAtakA duHsAhasinO darpadhmAtA IzvarAprEmiNaH kintu sukhaprEmiNO</para>
  <para style="p">
    <verse number="5" style="v"/>bhaktavEzAH kintvasvIkRtabhaktiguNA bhaviSyanti; EtAdRzAnAM lOkAnAM saMmargaM parityaja|</para>
  <para style="p">
    <verse number="6" style="v"/>yatO yE janAH pracchannaM gEhAn pravizanti pApai rbhAragrastA nAnAvidhAbhilASaizcAlitA yAH kAminyO</para>
  <para style="p">
    <verse number="7" style="v"/>nityaM zikSantE kintu satyamatasya tattvajnjAnaM prAptuM kadAcit na zaknuvanti tA dAsIvad vazIkurvvatE ca tE tAdRzA lOkAH|</para>
  <para style="p">
    <verse number="8" style="v"/>yAnni ryAmbrizca yathA mUsamaM prati vipakSatvam akurutAM tathaiva bhraSTamanasO vizvAsaviSayE 'grAhyAzcaitE lOkA api satyamataM prati vipakSatAM kurvvanti|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu tE bahudUram agrasarA na bhaviSyanti yatastayO rmUPhatA yadvat tadvad EtESAmapi mUPhatA sarvvadRzyA bhaviSyati|</para>
  <para style="p">
    <verse number="10" style="v"/>mamOpadEzaH ziSTatAbhiprAyO vizvAsO rdharyyaM prEma sahiSNutOpadravaH klEzA</para>
  <para style="p">
    <verse number="11" style="v"/>AntiyakhiyAyAm ikaniyE lUstrAyAnjca mAM prati yadyad aghaTata yAMzcOpadravAn aham asahE sarvvamEtat tvam avagatO'si kintu tatsarvvataH prabhu rmAm uddhRtavAn|</para>
  <para style="p">
    <verse number="12" style="v"/>parantu yAvantO lOkAH khrISTEna yIzunEzvarabhaktim Acaritum icchanti tESAM sarvvESAm upadravO bhaviSyati|</para>
  <para style="p">
    <verse number="13" style="v"/>aparaM pApiSThAH khalAzca lOkA bhrAmyantO bhramayantazcOttarOttaraM duSTatvEna varddhiSyantE|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu tvaM yad yad azikSathAH, yacca tvayi samarpitam abhUt tasmin avatiSTha, yataH kasmAt zikSAM prAptO'si tad vEtsi;</para>
  <para style="p">
    <verse number="15" style="v"/>yAni ca dharmmazAstrANi khrISTE yIzau vizvAsEna paritrANaprAptayE tvAM jnjAninaM karttuM zaknuvanti tAni tvaM zaizavakAlAd avagatO'si|</para>
  <para style="p">
    <verse number="16" style="v"/>tat sarvvaM zAstram IzvarasyAtmanA dattaM zikSAyai dOSabOdhAya zOdhanAya dharmmavinayAya ca phalayUktaM bhavati</para>
  <para style="p">
    <verse number="17" style="v"/>tEna cEzvarasya lOkO nipuNaH sarvvasmai satkarmmaNE susajjazca bhavati|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>Izvarasya gOcarE yazca yIzuH khrISTaH svIyAgamanakAlE svarAjatvEna jIvatAM mRtAnAnjca lOkAnAM vicAraM kariSyati tasya gOcarE 'haM tvAm idaM dRPham AjnjApayAmi|</para>
  <para style="p">
    <verse number="2" style="v"/>tvaM vAkyaM ghOSaya kAlE'kAlE cOtsukO bhava pUrNayA sahiSNutayA zikSayA ca lOkAn prabOdhaya bhartsaya vinayasva ca|</para>
  <para style="p">
    <verse number="3" style="v"/>yata EtAdRzaH samaya AyAti yasmin lOkA yathArtham upadEzam asahyamAnAH karNakaNPUyanaviziSTA bhUtvA nijAbhilASAt zikSakAn saMgrahISyanti</para>
  <para style="p">
    <verse number="4" style="v"/>satyamatAcca zrOtrANi nivarttya vipathagAminO bhUtvOpAkhyAnESu pravarttiSyantE;</para>
  <para style="p">
    <verse number="5" style="v"/>kintu tvaM sarvvaviSayE prabuddhO bhava duHkhabhOgaM svIkuru susaMvAdapracArakasya karmma sAdhaya nijaparicaryyAM pUrNatvEna kuru ca|</para>
  <para style="p">
    <verse number="6" style="v"/>mama prANAnAm utsargO bhavati mama prasthAnakAlazcOpAtiSThat|</para>
  <para style="p">
    <verse number="7" style="v"/>aham uttamayuddhaM kRtavAn gantavyamArgasyAntaM yAvad dhAvitavAn vizvAsanjca rakSitavAn|</para>
  <para style="p">
    <verse number="8" style="v"/>zESaM puNyamukuTaM madarthaM rakSitaM vidyatE tacca tasmin mahAdinE yathArthavicArakENa prabhunA mahyaM dAyiSyatE kEvalaM mahyam iti nahi kintu yAvantO lOkAstasyAgamanam AkAgkSantE tEbhyaH sarvvEbhyO 'pi dAyiSyatE|</para>
  <para style="p">
    <verse number="9" style="v"/>tvaM tvarayA matsamIpam AgantuM yatasva,</para>
  <para style="p">
    <verse number="10" style="v"/>yatO dImA aihikasaMsAram IhamAnO mAM parityajya thiSalanIkIM gatavAn tathA krISki rgAlAtiyAM gatavAn tItazca dAlmAtiyAM gatavAn|</para>
  <para style="p">
    <verse number="11" style="v"/>kEvalO lUkO mayA sArddhaM vidyatE| tvaM mArkaM sagginaM kRtvAgaccha yataH sa paricaryyayA mamOpakArI bhaviSyati,</para>
  <para style="p">
    <verse number="12" style="v"/>tukhikanjcAham iphiSanagaraM prESitavAn|</para>
  <para style="p">
    <verse number="13" style="v"/>yad AcchAdanavastraM trOyAnagarE kArpasya sannidhau mayA nikSiptaM tvamAgamanasamayE tat pustakAni ca vizESatazcarmmagranthAn Anaya|</para>
  <para style="p">
    <verse number="14" style="v"/>kAMsyakAraH sikandarO mama bahvaniSTaM kRtavAn prabhustasya karmmaNAM samucitaphalaM dadAtu|</para>
  <para style="p">
    <verse number="15" style="v"/>tvamapi tasmAt sAvadhAnAstiSTha yataH sO'smAkaM vAkyAnAm atIva vipakSO jAtaH|</para>
  <para style="p">
    <verse number="16" style="v"/>mama prathamapratyuttarasamayE kO'pi mama sahAyO nAbhavat sarvvE mAM paryyatyajan tAn prati tasya dOSasya gaNanA na bhUyAt;</para>
  <para style="p">
    <verse number="17" style="v"/>kintu prabhu rmama sahAyO 'bhavat yathA ca mayA ghOSaNA sAdhyEta bhinnajAtIyAzca sarvvE susaMvAdaM zRNuyustathA mahyaM zaktim adadAt tatO 'haM siMhasya mukhAd uddhRtaH|</para>
  <para style="p">
    <verse number="18" style="v"/>aparaM sarvvasmAd duSkarmmataH prabhu rmAm uddhariSyati nijasvargIyarAjyaM nEtuM mAM tArayiSyati ca| tasya dhanyavAdaH sadAkAlaM bhUyAt| AmEn|</para>
  <para style="p">
    <verse number="19" style="v"/>tvaM priSkAm Akkilam anISipharasya parijanAMzca namaskuru|</para>
  <para style="p">
    <verse number="20" style="v"/>irAstaH karinthanagarE 'tiSThat traphimazca pIPitatvAt milItanagarE mayA vyahIyata|</para>
  <para style="p">
    <verse number="21" style="v"/>tvaM hEmantakAlAt pUrvvam AgantuM yatasva| ubUlaH pUdi rlInaH klaudiyA sarvvE bhrAtarazca tvAM namaskurvvatE|</para>
  <para style="p">
    <verse number="22" style="v"/>prabhu ryIzuH khrISTastavAtmanA saha bhUyAt| yuSmAsvanugrahO bhUyAt| AmEn|</para>
</usx>
