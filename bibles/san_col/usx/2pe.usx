  <para style="h">2 Peter</para>
  <para style="toc1">2 pitarasya patraM</para>
  <para style="toc2">2 pitaraH</para>
  <para style="toc3">2 pitaraH</para>
  <para style="mt1">2 pitarasya patraM</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yE janA asmAbhiH sArddham astadIzvarE trAtari yIzukhrISTE ca puNyasambalitavizvAsadhanasya samAnAMzitvaM prAptAstAn prati yIzukhrISTasya dAsaH prEritazca zimOn pitaraH patraM likhati|</para>
  <para style="p">
    <verse number="2" style="v"/>IzvarasyAsmAkaM prabhO ryIzOzca tatvajnjAnEna yuSmAsvanugrahazAntyO rbAhulyaM varttatAM|</para>
  <para style="p">
    <verse number="3" style="v"/>jIvanArtham Izvarabhaktyarthanjca yadyad AvazyakaM tat sarvvaM gauravasadguNAbhyAm asmadAhvAnakAriNastattvajnjAnadvArA tasyEzvarIyazaktirasmabhyaM dattavatI|</para>
  <para style="p">
    <verse number="4" style="v"/>tatsarvvENa cAsmabhyaM tAdRzA bahumUlyA mahApratijnjA dattA yAbhi ryUyaM saMsAravyAptAt kutsitAbhilASamUlAt sarvvanAzAd rakSAM prApyEzvarIyasvabhAvasyAMzinO bhavituM zaknutha|</para>
  <para style="p">
    <verse number="5" style="v"/>tatO hEtO ryUyaM sampUrNaM yatnaM vidhAya vizvAsE saujanyaM saujanyE jnjAnaM</para>
  <para style="p">
    <verse number="6" style="v"/>jnjAna AyatEndriyatAm AyatEndriyatAyAM dhairyyaM dhairyya Izvarabhaktim</para>
  <para style="p">
    <verse number="7" style="v"/>Izvarabhaktau bhrAtRsnEhE ca prEma yugkta|</para>
  <para style="p">
    <verse number="8" style="v"/>EtAni yadi yuSmAsu vidyantEे varddhantE ca tarhyasmatprabhO ryIzukhrISTasya tattvajnjAnE yuSmAn alasAn niSphalAMzca na sthApayiSyanti|</para>
  <para style="p">
    <verse number="9" style="v"/>kintvEtAni yasya na vidyantE sO 'ndhO mudritalOcanaH svakIyapUrvvapApAnAM mArjjanasya vismRtiM gatazca|</para>
  <para style="p">
    <verse number="10" style="v"/>tasmAd hE bhrAtaraH, yUyaM svakIyAhvAnavaraNayO rdRPhakaraNE bahu yatadhvaM, tat kRtvA kadAca na skhaliSyatha|</para>
  <para style="p">
    <verse number="11" style="v"/>yatO 'nEna prakArENAsmAkaM prabhOstrAtR ryIzukhrISTasyAnantarAjyasya pravEzEna yUyaM sukalEna yOjayiSyadhvE|</para>
  <para style="p">
    <verse number="12" style="v"/>yadyapi yUyam Etat sarvvaM jAnItha varttamAnE satyamatE susthirA bhavatha ca tathApi yuSmAn sarvvadA tat smArayitum aham ayatnavAn na bhaviSyAmi|</para>
  <para style="p">
    <verse number="13" style="v"/>yAvad Etasmin dUSyE tiSThAmi tAvad yuSmAn smArayan prabOdhayituM vihitaM manyE|</para>
  <para style="p">
    <verse number="14" style="v"/>yatO 'smAkaM prabhu ryIzukhrISTO mAM yat jnjApitavAn tadanusArAd dUSyamEtat mayA zIghraM tyaktavyam iti jAnAmi|</para>
  <para style="p">
    <verse number="15" style="v"/>mama paralOkagamanAt paramapi yUyaM yadEtAni smarttuM zakSyatha tasmin sarvvathA yatiSyE|</para>
  <para style="p">
    <verse number="16" style="v"/>yatO 'smAkaM prabhO ryIzukhrISTasya parAkramaM punarAgamananjca yuSmAn jnjApayantO vayaM kalpitAnyupAkhyAnAnyanvagacchAmEti nahi kintu tasya mahimnaH pratyakSasAkSiNO bhUtvA bhASitavantaH|</para>
  <para style="p">
    <verse number="17" style="v"/>yataH sa piturIzvarAd gauravaM prazaMsAnjca prAptavAn vizESatO mahimayuktatEjOmadhyAd EtAdRzI vANI taM prati nirgatavatI, yathA, ESa mama priyaputra Etasmin mama paramasantOSaH|</para>
  <para style="p">
    <verse number="18" style="v"/>svargAt nirgatEyaM vANI pavitraparvvatE tEna sArddhaM vidyamAnairasmAbhirazrAvi|</para>
  <para style="p">
    <verse number="19" style="v"/>aparam asmatsamIpE dRPhataraM bhaviSyadvAkyaM vidyatE yUyanjca yadi dinArambhaM yuSmanmanaHsu prabhAtIyanakSatrasyOdayanjca yAvat timiramayE sthAnE jvalantaM pradIpamiva tad vAkyaM sammanyadhvE tarhi bhadraM kariSyatha|</para>
  <para style="p">
    <verse number="20" style="v"/>zAstrIyaM kimapi bhaviSyadvAkyaM manuSyasya svakIyabhAvabOdhakaM nahi, Etad yuSmAbhiH samyak jnjAyatAM|</para>
  <para style="p">
    <verse number="21" style="v"/>yatO bhaviSyadvAkyaM purA mAnuSANAm icchAtO nOtpannaM kintvIzvarasya pavitralOkAH pavitrENAtmanA pravarttitAH santO vAkyam abhASanta|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparaM pUrvvakAlE yathA lOkAnAM madhyE mithyAbhaviSyadvAdina upAtiSThan tathA yuSmAkaM madhyE'pi mithyAzikSakA upasthAsyanti, tE svESAM krEtAraM prabhum anaggIkRtya satvaraM vinAzaM svESu varttayanti vinAzakavaidharmmyaM guptaM yuSmanmadhyam AnESyanti|</para>
  <para style="p">
    <verse number="2" style="v"/>tatO 'nEkESu tESAM vinAzakamArgaM gatESu tEbhyaH satyamArgasya nindA sambhaviSyati|</para>
  <para style="p">
    <verse number="3" style="v"/>aparanjca tE lObhAt kApaTyavAkyai ryuSmattO lAbhaM kariSyantE kintu tESAM purAtanadaNPAjnjA na vilambatE tESAM vinAzazca na nidrAti|</para>
  <para style="p">
    <verse number="4" style="v"/>IzvaraH kRtapApAn dUtAn na kSamitvA timirazRgkhalaiH pAtAlE ruddhvA vicArArthaM samarpitavAn|</para>
  <para style="p">
    <verse number="5" style="v"/>purAtanaM saMsAramapi na kSamitvA taM duSTAnAM saMsAraM jalAplAvanEna majjayitvA saptajanaiH sahitaM dharmmapracArakaM nOhaM rakSitavAn|</para>
  <para style="p">
    <verse number="6" style="v"/>sidOmam amOrA cEtinAmakE nagarE bhaviSyatAM duSTAnAM dRSTAntaM vidhAya bhasmIkRtya vinAzEna daNPitavAn;</para>
  <para style="p">
    <verse number="7" style="v"/>kintu taiH kutsitavyabhicAribhi rduSTAtmabhiH kliSTaM dhArmmikaM lOTaM rakSitavAn|</para>
  <para style="p">
    <verse number="8" style="v"/>sa dhArmmikO janastESAM madhyE nivasan svIyadRSTizrOtragOcarEbhyastESAm adharmmAcArEbhyaH svakIyadhArmmikamanasi dinE dinE taptavAn|</para>
  <para style="p">
    <verse number="9" style="v"/>prabhu rbhaktAn parIkSAd uddharttuM vicAradinanjca yAvad daNPyAmAnAn adhArmmikAn rOddhuM pArayati,</para>
  <para style="p">
    <verse number="10" style="v"/>vizESatO yE 'mEdhyAbhilASAt zArIrikasukham anugacchanti kartRtvapadAni cAvajAnanti tAnEva (rOddhuM pArayati|) tE duHsAhasinaH pragalbhAzca|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaM balagauravAbhyAM zrESThA divyadUtAH prabhOH sannidhau yESAM vaiparItyEna nindAsUcakaM vicAraM na kurvvanti tESAm uccapadasthAnAM nindanAd imE na bhItAH|</para>
  <para style="p">
    <verse number="12" style="v"/>kintu yE buddhihInAH prakRtA jantavO dharttavyatAyai vinAzyatAyai ca jAyantE tatsadRzA imE yanna budhyantE tat nindantaH svakIyavinAzyatayA vinaMkSyanti svIyAdharmmasya phalaM prApsyanti ca|</para>
  <para style="p">
    <verse number="13" style="v"/>tE divA prakRSTabhOjanaM sukhaM manyantE nijachalaiH sukhabhOginaH santO yuSmAbhiH sArddhaM bhOjanaM kurvvantaH kalagkinO dOSiNazca bhavanti|</para>
  <para style="p">
    <verse number="14" style="v"/>tESAM lOcanAni paradArAkAgkSINi pApE cAzrAntAni tE canjcalAni manAMsi mOhayanti lObhE tatparamanasaH santi ca|</para>
  <para style="p">
    <verse number="15" style="v"/>tE zApagrastA vaMzAH saralamArgaM vihAya biyOraputrasya biliyamasya vipathEna vrajantO bhrAntA abhavan| sa biliyamO 'pyadharmmAt prApyE pAritOSikE'prIyata,</para>
  <para style="p">
    <verse number="16" style="v"/>kintu nijAparAdhAd bhartsanAm alabhata yatO vacanazaktihInaM vAhanaM mAnuSikagiram uccAryya bhaviSyadvAdina unmattatAm abAdhata|</para>
  <para style="p">
    <verse number="17" style="v"/>imE nirjalAni prasravaNAni pracaNPavAyunA cAlitA mEghAzca tESAM kRtE nityasthAyI ghOratarAndhakAraH sanjcitO 'sti|</para>
  <para style="p">
    <verse number="18" style="v"/>yE ca janA bhrAntyAcArigaNAt kRcchrENOddhRtAstAn imE 'parimitadarpakathA bhASamANAH zArIrikasukhAbhilASaiH kAmakrIPAbhizca mOhayanti|</para>
  <para style="p">
    <verse number="19" style="v"/>tEbhyaH svAdhInatAM pratijnjAya svayaM vinAzyatAyA dAsA bhavanti, yataH, yO yEnaiva parAjigyE sa jAtastasya kigkaraH|</para>
  <para style="p">
    <verse number="20" style="v"/>trAtuH prabhO ryIzukhrISTasya jnjAnEna saMsArasya malEbhya uddhRtA yE punastESu nimajjya parAjIyantE tESAM prathamadazAtaH zESadazA kutsitA bhavati|</para>
  <para style="p">
    <verse number="21" style="v"/>tESAM pakSE dharmmapathasya jnjAnAprApti rvaraM na ca nirddiSTAt pavitravidhimArgAt jnjAnaprAptAnAM parAvarttanaM|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu yEyaM satyA dRSTAntakathA saiva tESu phalitavatI, yathA, kukkuraH svIyavAntAya vyAvarttatE punaH punaH| luThituM karddamE tadvat kSAlitazcaiva zUkaraH||</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>hE priyatamAH, yUyaM yathA pavitrabhaviSyadvaktRbhiH pUrvvOktAni vAkyAni trAtrA prabhunA prEritAnAm asmAkam AdEzanjca sAratha tathA yuSmAn smArayitvA</para>
  <para style="p">
    <verse number="2" style="v"/>yuSmAkaM saralabhAvaM prabOdhayitum ahaM dvitIyam idaM patraM likhAmi|</para>
  <para style="p">
    <verse number="3" style="v"/>prathamaM yuSmAbhiridaM jnjAyatAM yat zESE kAlE svEcchAcAriNO nindakA upasthAya</para>
  <para style="p">
    <verse number="4" style="v"/>vadiSyanti prabhOrAgamanasya pratijnjA kutra? yataH pitRlOkAnAM mahAnidrAgamanAt paraM sarvvANi sRSTErArambhakAlE yathA tathaivAvatiSThantE|</para>
  <para style="p">
    <verse number="5" style="v"/>pUrvvam Izvarasya vAkyEnAkAzamaNPalaM jalAd utpannA jalE santiSThamAnA ca pRthivyavidyataitad anicchukatAtastE na jAnAnti,</para>
  <para style="p">
    <verse number="6" style="v"/>tatastAtkAlikasaMsArO jalEnAplAvitO vinAzaM gataH|</para>
  <para style="p">
    <verse number="7" style="v"/>kintvadhunA varttamAnE AkAzabhUmaNPalE tEnaiva vAkyEna vahnyarthaM guptE vicAradinaM duSTamAnavAnAM vinAzanjca yAvad rakSyatE|</para>
  <para style="p">
    <verse number="8" style="v"/>hE priyatamAH, yUyam EtadEkaM vAkyam anavagatA mA bhavata yat prabhOH sAkSAd dinamEkaM varSasahasravad varSasahasranjca dinaikavat|</para>
  <para style="p">
    <verse number="9" style="v"/>kEcid yathA vilambaM manyantE tathA prabhuH svapratijnjAyAM vilambatE tannahi kintu kO'pi yanna vinazyEt sarvvaM Eva manaHparAvarttanaM gacchEyurityabhilaSan sO 'smAn prati dIrghasahiSNutAM vidadhAti|</para>
  <para style="p">
    <verse number="10" style="v"/>kintu kSapAyAM caura iva prabhO rdinam AgamiSyati tasmin mahAzabdEna gaganamaNPalaM lOpsyatE mUlavastUni ca tApEna galiSyantE pRthivI tanmadhyasthitAni karmmANi ca dhakSyantE|</para>
  <para style="p">
    <verse number="11" style="v"/>ataH sarvvairEtai rvikArE gantavyE sati yasmin AkAzamaNPalaM dAhEna vikAriSyatE mUlavastUni ca tApEna galiSyantE</para>
  <para style="p">
    <verse number="12" style="v"/>tasyEzvaradinasyAgamanaM pratIkSamANairAkAgkSamANaizca yUSmAbhi rdharmmAcArEzvarabhaktibhyAM kIdRzai rlOkai rbhavitavyaM?</para>
  <para style="p">
    <verse number="13" style="v"/>tathApi vayaM tasya pratijnjAnusArENa dharmmasya vAsasthAnaM nUtanam AkAzamaNPalaM nUtanaM bhUmaNPalanjca pratIkSAmahE|</para>
  <para style="p">
    <verse number="14" style="v"/>ataEva hE priyatamAH, tAni pratIkSamANA yUyaM niSkalagkA aninditAzca bhUtvA yat zAntyAzritAstiSThathaitasmin yatadhvaM|</para>
  <para style="p">
    <verse number="15" style="v"/>asmAkaM prabhO rdIrghasahiSNutAnjca paritrANajanikAM manyadhvaM| asmAkaM priyabhrAtrE paulAya yat jnjAnam adAyi tadanusArENa sO'pi patrE yuSmAn prati tadEvAlikhat|</para>
  <para style="p">
    <verse number="16" style="v"/>svakIyasarvvapatrESu caitAnyadhi prastutya tadEva gadati| tESu patrESu katipayAni durUhyANi vAkyAni vidyantE yE ca lOkA ajnjAnAzcanjcalAzca tE nijavinAzArtham anyazAstrIyavacanAnIva tAnyapi vikArayanti|</para>
  <para style="p">
    <verse number="17" style="v"/>tasmAd hE priyatamAH, yUyaM pUrvvaM buddhvA sAvadhAnAstiSThata, adhArmmikANAM bhrAntisrOtasApahRtAH svakIyasusthiratvAt mA bhrazyata|</para>
  <para style="p">
    <verse number="18" style="v"/>kintvasmAkaM prabhOstrAtu ryIzukhrISTasyAnugrahE jnjAnE ca varddhadhvaM| tasya gauravam idAnIM sadAkAlanjca bhUyAt| AmEn|</para>
</usx>
