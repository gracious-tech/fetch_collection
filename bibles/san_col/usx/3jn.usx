  <para style="h">3 John</para>
  <para style="toc1">3 yOhanaH patraM</para>
  <para style="toc2">3 yOhanaH</para>
  <para style="toc3">3 yOhanaH</para>
  <para style="mt1">3 yOhanaH patraM</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>prAcInO 'haM satyamatAd yasmin prIyE taM priyatamaM gAyaM prati patraM likhAmi|</para>
  <para style="p">
    <verse number="2" style="v"/>hE priya, tavAtmA yAdRk zubhAnvitastAdRk sarvvaviSayE tava zubhaM svAsthyanjca bhUyAt|</para>
  <para style="p">
    <verse number="3" style="v"/>bhrAtRbhirAgatya tava satyamatasyArthatastvaM kIdRk satyamatamAcarasyEtasya sAkSyE dattE mama mahAnandO jAtaH|</para>
  <para style="p">
    <verse number="4" style="v"/>mama santAnAH satyamatamAcarantItivArttAtO mama ya AnandO jAyatE tatO mahattarO nAsti|</para>
  <para style="p">
    <verse number="5" style="v"/>hE priya, bhrAtRn prati vizESatastAn vidEzinO bhRाtRn prati tvayA yadyat kRtaM tat sarvvaM vizvAsinO yOgyaM|</para>
  <para style="p">
    <verse number="6" style="v"/>tE ca samitEH sAkSAt tava pramnaH pramANaM dattavantaH, aparam IzvarayOgyarUpENa tAn prasthApayatA tvayA satkarmma kAriSyatE|</para>
  <para style="p">
    <verse number="7" style="v"/>yatastE tasya nAmnA yAtrAM vidhAya bhinnajAtIyEbhyaH kimapi na gRhItavantaH|</para>
  <para style="p">
    <verse number="8" style="v"/>tasmAd vayaM yat satyamatasya sahAyA bhavEma tadarthamEtAdRzA lOkA asmAbhiranugrahItavyAH|</para>
  <para style="p">
    <verse number="9" style="v"/>samitiM pratyahaM patraM likhitavAn kintu tESAM madhyE yO diyatriphiH pradhAnAyatE sO 'smAn na gRhlAti|</para>
  <para style="p">
    <verse number="10" style="v"/>atO 'haM yadOpasthAsyAmi tadA tEna yadyat kriyatE tat sarvvaM taM smArayiSyAmi, yataH sa durvvAkyairasmAn apavadati, tEnApi tRptiM na gatvA svayamapi bhrAtRn nAnugRhlAti yE cAnugrahItumicchanti tAn samititO 'pi bahiSkarOti|</para>
  <para style="p">
    <verse number="11" style="v"/>hE priya, tvayA duSkarmma nAnukriyatAM kintu satkarmmaiva| yaH satkarmmAcArI sa IzvarAt jAtaH, yO duSkarmmAcArI sa IzvaraM na dRSTavAn|</para>
  <para style="p">
    <verse number="12" style="v"/>dImItriyasya pakSE sarvvaiH sAkSyam adAyi vizESataH satyamatEnApi, vayamapi tatpakSE sAkSyaM dadmaH, asmAkanjca sAkSyaM satyamEvEti yUyaM jAnItha|</para>
  <para style="p">
    <verse number="13" style="v"/>tvAM prati mayA bahUni lEkhitavyAni kintu masIlEkhanIbhyAM lEkhituM nEcchAmi|</para>
  <para style="p">
    <verse number="14" style="v"/>acirENa tvAM drakSyAmIti mama pratyAzAstE tadAvAM sammukhIbhUya parasparaM sambhASiSyAvahE|</para>
  <para style="p">
    <verse number="15" style="v"/>tava zAnti rbhUyAt| asmAkaM mitrANi tvAM namaskAraM jnjApayanti tvamapyEkaikasya nAma prOcya mitrEbhyO namaskuru| iti|</para>
</usx>
