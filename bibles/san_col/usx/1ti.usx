  <para style="h">1 Timothy</para>
  <para style="toc1">1 tImathiyaM patraM</para>
  <para style="toc2">1 tImathiyaH</para>
  <para style="toc3">1 tImathiyaH</para>
  <para style="mt1">1 tImathiyaM patraM</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>asmAkaM trANakartturIzvarasyAsmAkaM pratyAzAbhUmEH prabhO ryIzukhrISTasya cAjnjAnusAratO yIzukhrISTasya prEritaH paulaH svakIyaM satyaM dharmmaputraM tImathiyaM prati patraM likhati|</para>
  <para style="p">
    <verse number="2" style="v"/>asmAkaM tAta IzvarO'smAkaM prabhu ryIzukhrISTazca tvayi anugrahaM dayAM zAntinjca kuryyAstAM|</para>
  <para style="p">
    <verse number="3" style="v"/>mAkidaniyAdEzE mama gamanakAlE tvam iphiSanagarE tiSThan itarazikSA na grahItavyA, anantESUpAkhyAnESu vaMzAvaliSu ca yuSmAbhi rmanO na nivEzitavyam</para>
  <para style="p">
    <verse number="4" style="v"/>iti kAMzcit lOkAn yad upadizErEtat mayAdiSTO'bhavaH, yataH sarvvairEtai rvizvAsayuktEzvarIyaniSThA na jAyatE kintu vivAdO jAyatE|</para>
  <para style="p">
    <verse number="5" style="v"/>upadEzasya tvabhiprEtaM phalaM nirmmalAntaHkaraNEna satsaMvEdEna niSkapaTavizvAsEna ca yuktaM prEma|</para>
  <para style="p">
    <verse number="6" style="v"/>kEcit janAzca sarvvANyEtAni vihAya nirarthakakathAnAm anugamanEna vipathagAminO'bhavan,</para>
  <para style="p">
    <verse number="7" style="v"/>yad bhASantE yacca nizcinvanti tanna budhyamAnA vyavasthOpadESTArO bhavitum icchanti|</para>
  <para style="p">
    <verse number="8" style="v"/>sA vyavasthA yadi yOgyarUpENa gRhyatE tarhyuttamA bhavatIti vayaM jAnImaH|</para>
  <para style="p">
    <verse number="9" style="v"/>aparaM sA vyavasthA dhArmmikasya viruddhA na bhavati kintvadhArmmikO 'vAdhyO duSTaH pApiSThO 'pavitrO 'zuciH pitRhantA mAtRhantA narahantA</para>
  <para style="p">
    <verse number="10" style="v"/>vEzyAgAmI puMmaithunI manuSyavikrEtA mithyAvAdI mithyAzapathakArI ca sarvvESAmEtESAM viruddhA,</para>
  <para style="p">
    <verse number="11" style="v"/>tathA saccidAnandEzvarasya yO vibhavayuktaH susaMvAdO mayi samarpitastadanuyAyihitOpadEzasya viparItaM yat kinjcid bhavati tadviruddhA sA vyavasthEti tadgrAhiNA jnjAtavyaM|</para>
  <para style="p">
    <verse number="12" style="v"/>mahyaM zaktidAtA yO'smAkaM prabhuH khrISTayIzustamahaM dhanyaM vadAmi|</para>
  <para style="p">
    <verse number="13" style="v"/>yataH purA nindaka upadrAvI hiMsakazca bhUtvApyahaM tEna vizvAsyO 'manyE paricArakatvE nyayujyE ca| tad avizvAsAcaraNam ajnjAnEna mayA kRtamiti hEtOrahaM tEnAnukampitO'bhavaM|</para>
  <para style="p">
    <verse number="14" style="v"/>aparaM khrISTE yIzau vizvAsaprEmabhyAM sahitO'smatprabhOranugrahO 'tIva pracurO'bhat|</para>
  <para style="p">
    <verse number="15" style="v"/>pApinaH paritrAtuM khrISTO yIzu rjagati samavatIrNO'bhavat, ESA kathA vizvAsanIyA sarvvai grahaNIyA ca|</para>
  <para style="p">
    <verse number="16" style="v"/>tESAM pApinAM madhyE'haM prathama AsaM kintu yE mAnavA anantajIvanaprAptyarthaM tasmin vizvasiSyanti tESAM dRSTAntE mayi prathamE yIzunA khrISTEna svakIyA kRtsnA cirasahiSNutA yat prakAzyatE tadarthamEvAham anukampAM prAptavAn|</para>
  <para style="p">
    <verse number="17" style="v"/>anAdirakSayO'dRzyO rAjA yO'dvitIyaH sarvvajnja Izvarastasya gauravaM mahimA cAnantakAlaM yAvad bhUyAt| AmEn|</para>
  <para style="p">
    <verse number="18" style="v"/>hE putra tImathiya tvayi yAni bhaviSyadvAkyAni purA kathitAni tadanusArAd aham EnamAdEzaM tvayi samarpayAmi, tasyAbhiprAyO'yaM yattvaM tai rvAkyairuttamayuddhaM karOSi</para>
  <para style="p">
    <verse number="19" style="v"/>vizvAsaM satsaMvEdanjca dhArayasi ca| anayOH parityAgAt kESAnjcid vizvAsatarI bhagnAbhavat|</para>
  <para style="p">
    <verse number="20" style="v"/>huminAyasikandarau tESAM yau dvau janau, tau yad dharmmanindAM puna rna karttuM zikSEtE tadarthaM mayA zayatAnasya karE samarpitau|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>mama prathama AdEzO'yaM, prArthanAvinayanivEdanadhanyavAdAH karttavyAH,</para>
  <para style="p">
    <verse number="2" style="v"/>sarvvESAM mAnavAnAM kRtE vizESatO vayaM yat zAntatvEna nirvvirOdhatvEna cEzcarabhaktiM vinItatvanjcAcarantaH kAlaM yApayAmastadarthaM nRpatInAm uccapadasthAnAnjca kRtE tE karttavyAH|</para>
  <para style="p">
    <verse number="3" style="v"/>yatO'smAkaM tArakasyEzvarasya sAkSAt tadEvOttamaM grAhyanjca bhavati,</para>
  <para style="p">
    <verse number="4" style="v"/>sa sarvvESAM mAnavAnAM paritrANaM satyajnjAnaprAptinjcEcchati|</para>
  <para style="p">
    <verse number="5" style="v"/>yata EkO'dvitIya IzvarO vidyatE kinjcEzvarE mAnavESu caikO 'dvitIyO madhyasthaH</para>
  <para style="p">
    <verse number="6" style="v"/>sa narAvatAraH khrISTO yIzu rvidyatE yaH sarvvESAM muktE rmUlyam AtmadAnaM kRtavAn| EtEna yEna pramANEnOpayuktE samayE prakAzitavyaM,</para>
  <para style="p">
    <verse number="7" style="v"/>tadghOSayitA dUtO vizvAsE satyadharmmE ca bhinnajAtIyAnAm upadEzakazcAhaM nyayUjyE, EtadahaM khrISTasya nAmnA yathAtathyaM vadAmi nAnRtaM kathayAmi|</para>
  <para style="p">
    <verse number="8" style="v"/>atO mamAbhimatamidaM puruSaiH krOdhasandEhau vinA pavitrakarAn uttOlya sarvvasmin sthAnE prArthanA kriyatAM|</para>
  <para style="p">
    <verse number="9" style="v"/>tadvat nAryyO'pi salajjAH saMyatamanasazca satyO yOgyamAcchAdanaM paridadhatu kinjca kEzasaMskAraiH kaNakamuktAbhi rmahArghyaparicchadaizcAtmabhUSaNaM na kurvvatyaH</para>
  <para style="p">
    <verse number="10" style="v"/>svIkRtEzvarabhaktInAM yOSitAM yOgyaiH satyarmmabhiH svabhUSaNaM kurvvatAM|</para>
  <para style="p">
    <verse number="11" style="v"/>nArI sampUrNavinItatvEna nirvirOdhaM zikSatAM|</para>
  <para style="p">
    <verse number="12" style="v"/>nAryyAH zikSAdAnaM puruSAyAjnjAdAnaM vAhaM nAnujAnAmi tayA nirvvirOेdhatvam AcaritavyaM|</para>
  <para style="p">
    <verse number="13" style="v"/>yataH prathamam AdamastataH paraM havAyAH sRSTi rbabhUva|</para>
  <para style="p">
    <verse number="14" style="v"/>kinjcAdam bhrAntiyuktO nAbhavat yOSidEva bhrAntiyuktA bhUtvAtyAcAriNI babhUva|</para>
  <para style="p">
    <verse number="15" style="v"/>tathApi nArIgaNO yadi vizvAsE prEmni pavitratAyAM saMyatamanasi ca tiSThati tarhyapatyaprasavavartmanA paritrANaM prApsyati|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yadi kazcid adhyakSapadam AkAgkSatE tarhi sa uttamaM karmma lipsata iti satyaM|</para>
  <para style="p">
    <verse number="2" style="v"/>atO'dhyakSENAninditEnaikasyA yOSitO bhartrA parimitabhOgEna saMyatamanasA sabhyEnAtithisEvakEna zikSaNE nipuNEna</para>
  <para style="p">
    <verse number="3" style="v"/>na madyapEna na prahArakENa kintu mRdubhAvEna nirvvivAdEna nirlObhEna</para>
  <para style="p">
    <verse number="4" style="v"/>svaparivArANAm uttamazAsakEna pUrNavinItatvAd vazyAnAM santAnAnAM niyantrA ca bhavitavyaM|</para>
  <para style="p">
    <verse number="5" style="v"/>yata AtmaparivArAn zAsituM yO na zaknOti tEnEzvarasya samitEstattvAvadhAraNaM kathaM kAriSyatE?</para>
  <para style="p">
    <verse number="6" style="v"/>aparaM sa garvvitO bhUtvA yat zayatAna iva daNPayOgyO na bhavEt tadarthaM tEna navaziSyENa na bhavitavyaM|</para>
  <para style="p">
    <verse number="7" style="v"/>yacca nindAyAM zayatAnasya jAlE ca na patEt tadarthaM tEna bahiHsthalOkAnAmapi madhyE sukhyAtiyuktEna bhavitavyaM|</para>
  <para style="p">
    <verse number="8" style="v"/>tadvat paricArakairapi vinItai rdvividhavAkyarahitai rbahumadyapAnE 'nAsaktai rnirlObhaizca bhavitavyaM,</para>
  <para style="p">
    <verse number="9" style="v"/>nirmmalasaMvEdEna ca vizvAsasya nigUPhavAkyaM dhAtivyanjca|</para>
  <para style="p">
    <verse number="10" style="v"/>agrE tESAM parIkSA kriyatAM tataH param aninditA bhUtvA tE paricaryyAM kurvvantu|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaM yOSidbhirapi vinItAbhiranapavAdikAbhiH satarkAbhiH sarvvatra vizvAsyAbhizca bhavitavyaM|</para>
  <para style="p">
    <verse number="12" style="v"/>paricArakA EkaikayOSitO bharttArO bhavEyuH, nijasantAnAnAM parijanAnAnjca suzAsanaM kuryyuzca|</para>
  <para style="p">
    <verse number="13" style="v"/>yataH sA paricaryyA yai rbhadrarUpENa sAdhyatE tE zrESThapadaM prApnuvanti khrISTE yIzau vizvAsEna mahOtsukA bhavanti ca|</para>
  <para style="p">
    <verse number="14" style="v"/>tvAM pratyEtatpatralEkhanasamayE zIghraM tvatsamIpagamanasya pratyAzA mama vidyatE|</para>
  <para style="p">
    <verse number="15" style="v"/>yadi vA vilambEya tarhIzvarasya gRhE 'rthataH satyadharmmasya stambhabhittimUlasvarUpAyAm amarEzvarasya samitau tvayA kIdRza AcAraH karttavyastat jnjAtuM zakSyatE|</para>
  <para style="p">
    <verse number="16" style="v"/>aparaM yasya mahattvaM sarvvasvIkRtam IzvarabhaktEstat nigUPhavAkyamidam IzvarO mAnavadEhE prakAzita AtmanA sapuNyIkRtO dUtaiH sandRSTaH sarvvajAtIyAnAM nikaTE ghOSitO jagatO vizvAsapAtrIbhUtastEjaHprAptayE svargaM nItazcEti|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>pavitra AtmA spaSTam idaM vAkyaM vadati caramakAlE katipayalOkA vahninAgkitatvAt</para>
  <para style="p">
    <verse number="2" style="v"/>kaThOramanasAM kApaTyAd anRtavAdinAM vivAhaniSEdhakAnAM bhakSyavizESaniSEdhakAnAnjca</para>
  <para style="p">
    <verse number="3" style="v"/>bhUtasvarUpANAM zikSAyAM bhramakAtmanAM vAkyESu ca manAMsi nivEzya dharmmAd bhraMziSyantE| tAni tu bhakSyANi vizvAsinAM svIkRtasatyadharmmANAnjca dhanyavAdasahitAya bhOgAyEzvarENa sasRjirE|</para>
  <para style="p">
    <verse number="4" style="v"/>yata IzvarENa yadyat sRSTaM tat sarvvam uttamaM yadi ca dhanyavAdEna bhujyatE tarhi tasya kimapi nAgrAhyaM bhavati,</para>
  <para style="p">
    <verse number="5" style="v"/>yata Izvarasya vAkyEna prArthanayA ca tat pavitrIbhavati|</para>
  <para style="p">
    <verse number="6" style="v"/>EtAni vAkyAni yadi tvaM bhrAtRn jnjApayEstarhi yIzukhrISTasyOttamH paricArakO bhaviSyasi yO vizvAsO hitOpadEzazca tvayA gRhItastadIyavAkyairApyAyiSyasE ca|</para>
  <para style="p">
    <verse number="7" style="v"/>yAnyupAkhyAnAni durbhAvAni vRddhayOSitAmEva yOgyAni ca tAni tvayA visRjyantAm IzvarabhaktayE yatnaH kriyatAnjca|</para>
  <para style="p">
    <verse number="8" style="v"/>yataH zArIrikO yatnaH svalpaphaladO bhavati kintvIzvarabhaktiraihikapAratrikajIvanayOH pratijnjAyuktA satI sarvvatra phaladA bhavati|</para>
  <para style="p">
    <verse number="9" style="v"/>vAkyamEtad vizvasanIyaM sarvvai rgrahaNIyanjca vayanjca tadarthamEva zrAmyAmO nindAM bhuMjmahE ca|</para>
  <para style="p">
    <verse number="10" style="v"/>yatO hEtOH sarvvamAnavAnAM vizESatO vizvAsinAM trAtA yO'mara Izvarastasmin vayaM vizvasAmaH|</para>
  <para style="p">
    <verse number="11" style="v"/>tvam EtAni vAkyAni pracAraya samupadiza ca|</para>
  <para style="p">
    <verse number="12" style="v"/>alpavayaSkatvAt kEnApyavajnjEyO na bhava kintvAlApEnAcaraNEna prEmnA sadAtmatvEna vizvAsEna zucitvEna ca vizvAsinAm AdarzO bhava|</para>
  <para style="p">
    <verse number="13" style="v"/>yAvannAham AgamiSyAmi tAvat tva pAThE cEtayanE upadEzE ca manO nidhatsva|</para>
  <para style="p">
    <verse number="14" style="v"/>prAcInagaNahastArpaNasahitEna bhaviSyadvAkyEna yaddAnaM tubhyaM vizrANitaM tavAntaHsthE tasmin dAnE zithilamanA mA bhava|</para>
  <para style="p">
    <verse number="15" style="v"/>EtESu manO nivEzaya, EtESu varttasva, itthanjca sarvvaviSayE tava guNavRddhiH prakAzatAM|</para>
  <para style="p">
    <verse number="16" style="v"/>svasmin upadEzE ca sAvadhAnO bhUtvAvatiSThasva tat kRtvA tvayAtmaparitrANaM zrOtRNAnjca paritrANaM sAdhayiSyatE|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tvaM prAcInaM na bhartsaya kintu taM pitaramiva yUnazca bhrAtRniva</para>
  <para style="p">
    <verse number="2" style="v"/>vRddhAH striyazca mAtRniva yuvatIzca pUrNazucitvEna bhaginIriva vinayasva|</para>
  <para style="p">
    <verse number="3" style="v"/>aparaM satyavidhavAH sammanyasva|</para>
  <para style="p">
    <verse number="4" style="v"/>kasyAzcid vidhavAyA yadi putrAH pautrA vA vidyantE tarhi tE prathamataH svIyaparijanAn sEvituM pitrOH pratyupakarttunjca zikSantAM yatastadEvEzvarasya sAkSAd uttamaM grAhyanjca karmma|</para>
  <para style="p">
    <verse number="5" style="v"/>aparaM yA nArI satyavidhavA nAthahInA cAsti sA IzvarasyAzrayE tiSThantI divAnizaM nivEdanaprArthanAbhyAM kAlaM yApayati|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu yA vidhavA sukhabhOgAsaktA sA jIvatyapi mRtA bhavati|</para>
  <para style="p">
    <verse number="7" style="v"/>ataEva tA yad aninditA bhavEyUstadartham EtAni tvayA nidizyantAM|</para>
  <para style="p">
    <verse number="8" style="v"/>yadi kazcit svajAtIyAn lOkAn vizESataH svIyaparijanAn na pAlayati tarhi sa vizvAsAd bhraSTO 'pyadhamazca bhavati|</para>
  <para style="p">
    <verse number="9" style="v"/>vidhavAvargE yasyA gaNanA bhavati tayA SaSTivatsarEbhyO nyUnavayaskayA na bhavitavyaM; aparaM pUrvvam EkasvAmikA bhUtvA</para>
  <para style="p">
    <verse number="10" style="v"/>sA yat zizupOSaNEnAtithisEvanEna pavitralOkAnAM caraNaprakSAlanEna kliSTAnAm upakArENa sarvvavidhasatkarmmAcaraNEna ca satkarmmakaraNAt sukhyAtiprAptA bhavEt tadapyAvazyakaM|</para>
  <para style="p">
    <verse number="11" style="v"/>kintu yuvatI rvidhavA na gRhANa yataH khrISTasya vaiparItyEna tAsAM darpE jAtE tA vivAham icchanti|</para>
  <para style="p">
    <verse number="12" style="v"/>tasmAcca pUrvvadharmmaM parityajya daNPanIyA bhavanti|</para>
  <para style="p">
    <verse number="13" style="v"/>anantaraM tA gRhAd gRhaM paryyaTantya AlasyaM zikSantE kEvalamAlasyaM nahi kintvanarthakAlApaM parAdhikAracarccAnjcApi zikSamANA anucitAni vAkyAni bhASantE|</para>
  <para style="p">
    <verse number="14" style="v"/>atO mamEcchEyaM yuvatyO vidhavA vivAhaM kurvvatAm apatyavatyO bhavantu gRhakarmma kurvvatAnjcEtthaM vipakSAya kimapi nindAdvAraM na dadatu|</para>
  <para style="p">
    <verse number="15" style="v"/>yata itaH pUrvvam api kAzcit zayatAnasya pazcAdgAminyO jAtAH|</para>
  <para style="p">
    <verse number="16" style="v"/>aparaM vizvAsinyA vizvAsinO vA kasyApi parivArANAM madhyE yadi vidhavA vidyantE tarhi sa tAH pratipAlayatu tasmAt samitau bhArE 'nArOpitE satyavidhavAnAM pratipAlanaM karttuM tayA zakyatE|</para>
  <para style="p">
    <verse number="17" style="v"/>yE prAnjcaH samitiM samyag adhitiSThanti vizESata IzvaravAkyEnOpadEzEna ca yE yatnaM vidadhatE tE dviguNasyAdarasya yOgyA mAnyantAM|</para>
  <para style="p">
    <verse number="18" style="v"/>yasmAt zAstrE likhitamidamAstE, tvaM zasyamarddakavRSasyAsyaM mA badhAnEti, aparamapi kAryyakRd vEtanasya yOgyO bhavatIti|</para>
  <para style="p">
    <verse number="19" style="v"/>dvau trIn vA sAkSiNO vinA kasyAcit prAcInasya viruddham abhiyOgastvayA na gRhyatAM|</para>
  <para style="p">
    <verse number="20" style="v"/>aparaM yE pApamAcaranti tAn sarvvESAM samakSaM bhartsayasva tEnAparESAmapi bhIti rjaniSyatE|</para>
  <para style="p">
    <verse number="21" style="v"/>aham Izvarasya prabhO ryIzukhrISTasya manOnItadivyadUtAnAnjca gOcarE tvAm idam AjnjApayAmi tvaM kasyApyanurOdhEna kimapi na kurvvana vinApakSapAtam EtAna vidhIn pAlaya|</para>
  <para style="p">
    <verse number="22" style="v"/>kasyApi mUrddhi hastAparNaM tvarayA mAkArSIH| parapApAnAnjcAMzI mA bhava| svaM zuciM rakSa|</para>
  <para style="p">
    <verse number="23" style="v"/>aparaM tavOdarapIPAyAH punaH puna durbbalatAyAzca nimittaM kEvalaM tOyaM na pivan kinjcin madyaM piva|</para>
  <para style="p">
    <verse number="24" style="v"/>kESAnjcit mAnavAnAM pApAni vicArAt pUrvvaM kESAnjcit pazcAt prakAzantE|</para>
  <para style="p">
    <verse number="25" style="v"/>tathaiva satkarmmANyapi prakAzantE tadanyathA sati pracchannAni sthAtuM na zaknuvanti|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yAvantO lOkA yugadhAriNO dAsAH santi tE svasvasvAminaM pUrNasamAdarayOgyaM manyantAM nO cEd Izvarasya nAmna upadEzasya ca nindA sambhaviSyati|</para>
  <para style="p">
    <verse number="2" style="v"/>yESAnjca svAminO vizvAsinaH bhavanti taistE bhrAtRtvAt nAvajnjEyAH kintu tE karmmaphalabhOginO vizvAsinaH priyAzca bhavantIti hEtOH sEvanIyA Eva, tvam EtAni zikSaya samupadiza ca|</para>
  <para style="p">
    <verse number="3" style="v"/>yaH kazcid itarazikSAM karOti, asmAkaM prabhO ryIzukhrISTasya hitavAkyAnIzvarabhaktE ryOgyAM zikSAnjca na svIkarOti</para>
  <para style="p">
    <verse number="4" style="v"/>sa darpadhmAtaH sarvvathA jnjAnahInazca vivAdai rvAgyuddhaizca rOgayuktazca bhavati|</para>
  <para style="p">
    <verse number="5" style="v"/>tAdRzAd bhAvAd IrSyAvirOdhApavAdaduSTAsUyA bhraSTamanasAM satyajnjAnahInAnAm IzvarabhaktiM lAbhOpAyam iva manyamAnAnAM lOkAnAM vivAdAzca jAyantE tAdRzEbhyO lOkEbhyastvaM pRthak tiSTha|</para>
  <para style="p">
    <verse number="6" style="v"/>saMyatEcchayA yuktA yEzvarabhaktiH sA mahAlAbhOpAyO bhavatIti satyaM|</para>
  <para style="p">
    <verse number="7" style="v"/>EtajjagatpravEzanakAlE'smAbhiH kimapi nAnAyi tattayajanakAlE'pi kimapi nEtuM na zakSyata iti nizcitaM|</para>
  <para style="p">
    <verse number="8" style="v"/>ataEva khAdyAnyAcchAdanAni ca prApyAsmAbhiH santuSTai rbhavitavyaM|</para>
  <para style="p">
    <verse number="9" style="v"/>yE tu dhaninO bhavituM cESTantE tE parIkSAyAm unmAthE patanti yE cAbhilASA mAnavAn vinAzE narakE ca majjayanti tAdRzESvajnjAnAhitAbhilASESvapi patanti|</para>
  <para style="p">
    <verse number="10" style="v"/>yatO'rthaspRhA sarvvESAM duritAnAM mUlaM bhavati tAmavalambya kEcid vizvAsAd abhraMzanta nAnAklEzaizca svAn avidhyan|</para>
  <para style="p">
    <verse number="11" style="v"/>hE Izvarasya lOka tvam EtEbhyaH palAyya dharmma Izvarabhakti rvizvAsaH prEma sahiSNutA kSAntizcaitAnyAcara|</para>
  <para style="p">
    <verse number="12" style="v"/>vizvAsarUpam uttamayuddhaM kuru, anantajIvanam Alambasva yatastadarthaM tvam AhUtO 'bhavaH, bahusAkSiNAM samakSanjcOttamAM pratijnjAM svIkRtavAn|</para>
  <para style="p">
    <verse number="13" style="v"/>aparaM sarvvESAM jIvayiturIzvarasya sAkSAd yazca khrISTO yIzuH pantIyapIlAtasya samakSam uttamAM pratijnjAM svIkRtavAn tasya sAkSAd ahaM tvAm idam AjnjApayAmi|</para>
  <para style="p">
    <verse number="14" style="v"/>IzvarENa svasamayE prakAzitavyam asmAkaM prabhO ryIzukhrISTasyAgamanaM yAvat tvayA niSkalagkatvEna nirddOSatvEna ca vidhI rakSyatAM|</para>
  <para style="p">
    <verse number="15" style="v"/>sa IzvaraH saccidAnandaH, advitIyasamrAT, rAjnjAM rAjA, prabhUnAM prabhuH,</para>
  <para style="p">
    <verse number="16" style="v"/>amaratAyA advitIya AkaraH, agamyatEjOnivAsI, marttyAnAM kEnApi na dRSTaH kEnApi na dRzyazca| tasya gauravaparAkramau sadAtanau bhUyAstAM| AmEn|</para>
  <para style="p">
    <verse number="17" style="v"/>ihalOkE yE dhaninastE cittasamunnatiM capalE dhanE vizvAsanjca na kurvvatAM kintu bhOgArtham asmabhyaM pracuratvEna sarvvadAtA</para>
  <para style="p">
    <verse number="18" style="v"/>yO'mara Izvarastasmin vizvasantu sadAcAraM kurvvantu satkarmmadhanEna dhaninO sukalA dAtArazca bhavantu,</para>
  <para style="p">
    <verse number="19" style="v"/>yathA ca satyaM jIvanaM pApnuyustathA pAratrikAm uttamasampadaM sanjcinvantvEti tvayAdizyantAM|</para>
  <para style="p">
    <verse number="20" style="v"/>hE tImathiya, tvam upanidhiM gOpaya kAlpanikavidyAyA apavitraM pralApaM virOdhOktinjca tyaja ca,</para>
  <para style="p">
    <verse number="21" style="v"/>yataH katipayA lOkAstAM vidyAmavalambya vizvAsAd bhraSTA abhavana| prasAdastava sahAyO bhUyAt| AmEn|</para>
</usx>
