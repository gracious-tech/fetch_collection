  <para style="h">Philemon</para>
  <para style="toc1">philOmOnaM patraM</para>
  <para style="toc2">philOmOnaH</para>
  <para style="toc3">philOmOnaH</para>
  <para style="mt1">philOmOnaM patraM</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>khrISTasya yIzO rbandidAsaH paulastIthiyanAmA bhrAtA ca priyaM sahakAriNaM philImOnaM</para>
  <para style="p">
    <verse number="2" style="v"/>priyAm AppiyAM sahasEnAm ArkhippaM philImOnasya gRhE sthitAM samitinjca prati patraM likhataH|</para>
  <para style="p">
    <verse number="3" style="v"/>asmAkaM tAta IzvaraH prabhu ryIzukhrISTazca yuSmAn prati zAntim anugrahanjca kriyAstAM|</para>
  <para style="p">
    <verse number="4" style="v"/>prabhuM yIzuM prati sarvvAn pavitralOkAn prati ca tava prEmavizvAsayO rvRttAntaM nizamyAhaM</para>
  <para style="p">
    <verse number="5" style="v"/>prArthanAsamayE tava nAmOccArayan nirantaraM mamEzvaraM dhanyaM vadAmi|</para>
  <para style="p">
    <verse number="6" style="v"/>asmAsu yadyat saujanyaM vidyatE tat sarvvaM khrISTaM yIzuM yat prati bhavatIti jnjAnAya tava vizvAsamUlikA dAnazIlatA yat saphalA bhavEt tadaham icchAmi|</para>
  <para style="p">
    <verse number="7" style="v"/>hE bhrAtaH, tvayA pavitralOkAnAM prANa ApyAyitA abhavan EtasmAt tava prEmnAsmAkaM mahAn AnandaH sAntvanA ca jAtaH|</para>
  <para style="p">
    <verse number="8" style="v"/>tvayA yat karttavyaM tat tvAm AjnjApayituM yadyapyahaM khrISTEnAtIvOtsukO bhavEyaM tathApi vRddha</para>
  <para style="p">
    <verse number="9" style="v"/>idAnIM yIzukhrISTasya bandidAsazcaivambhUtO yaH paulaH sO'haM tvAM vinEtuM varaM manyE|</para>
  <para style="p">
    <verse number="10" style="v"/>ataH zRgkhalabaddhO'haM yamajanayaM taM madIyatanayam OnISimam adhi tvAM vinayE|</para>
  <para style="p">
    <verse number="11" style="v"/>sa pUrvvaM tavAnupakAraka AsIt kintvidAnIM tava mama cOpakArI bhavati|</para>
  <para style="p">
    <verse number="12" style="v"/>tamEvAhaM tava samIpaM prESayAmi, atO madIyaprANasvarUpaH sa tvayAnugRhyatAM|</para>
  <para style="p">
    <verse number="13" style="v"/>susaMvAdasya kRtE zRgkhalabaddhO'haM paricArakamiva taM svasannidhau varttayitum aicchaM|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu tava saujanyaM yad balEna na bhUtvA svEcchAyAH phalaM bhavEt tadarthaM tava sammatiM vinA kimapi karttavyaM nAmanyE|</para>
  <para style="p">
    <verse number="15" style="v"/>kO jAnAti kSaNakAlArthaM tvattastasya vicchEdO'bhavad EtasyAyam abhiprAyO yat tvam anantakAlArthaM taM lapsyasE</para>
  <para style="p">
    <verse number="16" style="v"/>puna rdAsamiva lapsyasE tannahi kintu dAsAt zrESThaM mama priyaM tava ca zArIrikasambandhAt prabhusambandhAcca tatO'dhikaM priyaM bhrAtaramiva|</para>
  <para style="p">
    <verse number="17" style="v"/>atO hEtO ryadi mAM sahabhAginaM jAnAsi tarhi mAmiva tamanugRhANa|</para>
  <para style="p">
    <verse number="18" style="v"/>tEna yadi tava kimapyaparAddhaM tubhyaM kimapi dhAryyatE vA tarhi tat mamEti viditvA gaNaya|</para>
  <para style="p">
    <verse number="19" style="v"/>ahaM tat parizOtsyAmi, Etat paulO'haM svahastEna likhAmi, yatastvaM svaprANAn api mahyaM dhArayasi tad vaktuM nEcchAmi|</para>
  <para style="p">
    <verse number="20" style="v"/>bhO bhrAtaH, prabhOH kRtE mama vAnjchAM pUraya khrISTasya kRtE mama prANAn ApyAyaya|</para>
  <para style="p">
    <verse number="21" style="v"/>tavAjnjAgrAhitvE vizvasya mayA Etat likhyatE mayA yaducyatE tatO'dhikaM tvayA kAriSyata iti jAnAmi|</para>
  <para style="p">
    <verse number="22" style="v"/>tatkaraNasamayE madarthamapi vAsagRhaM tvayA sajjIkriyatAM yatO yuSmAkaM prArthanAnAM phalarUpO vara ivAhaM yuSmabhyaM dAyiSyE mamEti pratyAzA jAyatE|</para>
  <para style="p">
    <verse number="23" style="v"/>khrISTasya yIzAH kRtE mayA saha bandiripAphrA</para>
  <para style="p">
    <verse number="24" style="v"/>mama sahakAriNO mArka AriSTArkhO dImA lUkazca tvAM namaskAraM vEdayanti|</para>
  <para style="p">
    <verse number="25" style="v"/>asmAkaM prabhO ryIzukhrISTasyAnugrahO yuSmAkam AtmanA saha bhUyAt| AmEn|</para>
</usx>
