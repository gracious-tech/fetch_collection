<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Holiya</book>
  <para style="h">फिलेमोन</para>
  <para style="toc3">फिलेमोन</para>
  <para style="toc2">फिलेमोन</para>
  <para style="toc1">फिलेमोन उन हेसुर पौलुस प्रेरित उन चिट्ठी</para>
  <para style="mt2">फिलेमोन के नाम पौलुस प्रेरित की पत्री</para>
  <para style="mt1">फिलेमोन उन हेसुर पौलुस प्रेरित उन चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">फिलेमोन उन स्यांळ्द किताब प्रेरित पौलुस द्वारा लिख्सकु आगीत. <char style="xt"><ref loc="PHM 1:1">१:१</ref></char> पौलुस जयल दा ईरोन, जब कि आव लिखसीदुन, यदुर मतलब आद कि आव शायद रोम टु ईऊक लिखसोन. अगर आव रोम दा ईरोन रा ईद मसीह अन जनम इन ६१ साल इन बाद्दा लिखसीदान, जो अदा समय हुन याग आव कुलुस्सियों लिखसोन.</para>
  <para style="ip">आव ईद चिट्ठी इक फिलेमोन हेसुर इनव मंळसा अक लिखसीदुन. फिलेमोन मंडली इन सदस्य अदिक मालिक भी ईरोन. पौलुस आऊन से केळदुन कि आव तान दास ओनेसिमुस उक दंडित माळतीदील जो फिलेमोन टु ओळेगीदुन. रोमन कानून द्वारा फिलेमोन अदिक ओनेसिमुस उक मृत्यु साटी ईटोद अधिकार ईरोद. पौलुस फिलेमोन उक ऊंद मसीह वार्ट उन रूप दा ओनेसिमुस उक स्वीकार माळोर साटी प्रोत्साहित माळोर साटी प्रेरित तर्कगोळ्द इस्तेमाल माळतान अदिक ईद भी सलाह कोळतान कि ओनेसिमुस उक पौलुस <char style="xt"><ref loc="PHM 1:13-14">१:१३-१४</ref></char> उन सांगुळ स्यावा माळोद इजाजत कोटकु आदीत.</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. पौलुस फिलेमोन उक नमस्कार कोळतान <char style="ior"><ref loc="PHM 1:1-3">१:१-३</ref></char></para>
  <para style="io1">२. आग पौलुस ओनेसिमुस उन दी टु केळतान कि फिलेमोन आऊक ऊंद मसीह वार्ट उन रूप दा स्वीकार माळ्यान <char style="ior"><ref loc="PHM 1:4-21">१:४-२१</ref></char></para>
  <para style="io1">३. पौलुस यात्रा माळली अदिक बधाई कळोद तान ईरादा अन घोषणा माळकु चिट्ठी खतम माळतान <char style="ior"><ref loc="PHM 1:22-25">१:२२-२५</ref></char></para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />पौलुस उन दी टु जो मसीह यीशु उन कैदी आन, अदिक वार्ट तीमुथियुस उन दी टु नाम प्रिय सहकर्मी फिलेमोन, <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" /><note caller="+" style="x"><char style="xo" closed="false">१:२ </char><char style="xt" closed="false"><ref loc="COL 4:17">कुलुस्सिगोळ ४:१७</ref></char></note>अदिक आकतींग अफफिया, अदिक नाम संगी योद्धा अरखिप्पुस अदिक फिलेमोन उन मान्ना अन्द मंडली नव हेसुर:<verse eid="PHM 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3" />नाम आप्प परमेश्वर अदिक प्रभु यीशु मसीह अन्द दी टु अनुग्रह अदिक शांती नीमी सिक्त ईरूल.<verse eid="PHM 1:3" /></para>
  <para style="s">फिलेमोन उन प्यार अदिक विश्वास</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />वार्ट फिलेमोन, ना हमेशा परमेश्वर उन धन्यवाद माळतीन, अदिक तान प्रार्थनागोळ दा भी नीनी याद माळतीन, <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />यतिकी ना नीन आ प्यार अदिक विश्वास इन चर्चा केळतीन, जो सप्पा परमेश्वर उन पवित्र लॉकुर सांगुळ अदिक प्रभु यीशु मा आद. <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />ना प्रार्थना माळतीन कि खुद विश्वास दा नीन सहभागी आगोद, नीम सप्पा भलाई इन पयचान दा, मसीह अन्द साटी प्रभावशाली ईरूल. <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />यतिकी हे वार्ट, नानी नीन प्यार देल हापाळ खुशी अदिक शांती सिक्याद, इदुरसाटी कि नीन द्वारा परमेश्वर उन पवित्र लॉकुर्द मन वळ्लेव आगेग्याव.<verse eid="PHM 1:7" /></para>
  <para style="s">उनेसिमुस उन साटी निवेदन</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />इदुरसाटी अगर नानी मसीह दा हापाळ साहस आद कि जो मात ठीक आद, अदुर आग्या नीनी कोळाईन. <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />तरी भी ना बाट्ट पौलुस उक जो ईग मसीह यीशु उन साटी कैदी आईन, ईद मात्‍त वळ्लीद जान्सकु आत कि प्यार देल विनती माळाईन. <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" /><note caller="+" style="x"><char style="xo" closed="false">१:१० </char><char style="xt" closed="false"><ref loc="COL 4:9">कुलुस्सिगोळ ४:९</ref></char></note>ना तान चिग्द उनेसिमुस उन साटी, जो नान देल नान बंधन दा पैदा आग्यान, नीन से विनती माळतीन. <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />आव रा पयले नीन येनु क्याल्सा नव ईला ईरोन, लेकीन ईग नीन अदिक नान येढ्ढु मुंदुर्द हापाळ क्याल्सा नव आन.<verse eid="PHM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12" />आऊका मतलब जो नान दिल इन तुकळा हुन, ना नीन हात्‍ती वापस माळ बुटीन. <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />आऊक ना तान हात्‍ती इच ईटोद चाहासीन कि आव नीन दी टु ई बंधन दा जो खुशखबरी इन कारण आन, नान स्यावा माळुल. <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />लेकीन ना नीन इच्छा अन्द बगेर येनु भी माळोद चाहासीदिल, कि नीन ईद कृपा दबाव देल ईला लेकीन इच्छा देल आगुल<verse eid="PHM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15" />यतिकी शायद आव नीन से थ्वाळासा दिन साटी ईदा कारण अलग आदुन कि हमेशा नीन हात्‍ती ईरूल. <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />लेकीन ईगी टु दास उन घाई ईला उलटा दास से भी वळ्लेव प्रिय वार्ट उन घाई, मतलब ना रा आऊन से प्यार माळतीन, लेकीन नीव आऊक मंळसा अन नाता देल अदिक प्रभु उन नाता देल नान से यक्कुल प्यार माळी.<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />इदुरसाटी अगर नी नानी तान सहभागी सम्सत्या, रा आऊक ईत्‍ता प्रकार देल ग्रहण माळ ह्यांग नानी माळत्या. <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />अगर आव नीन येनारा नुकसान माळ्यान, या आऊन मा नांद येनारा कर्ज बरतद, रा नान हेसुर मा लिख्स कोम. <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />ना पौलुस तान कय देल लिख्सतीन कि ना खुद तुम कोळाईन; अदिक ईद अनोद येनु जरवत हैलेच कि नान कर्जा जो नीन मा आद आव नी अच हुय. <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />हे वार्ट, ईद खुशी नानी प्रभु दा नीन दी टु सिक्याद. मसीह दा नान जीव इक हिरवा-गार माळ बुळ.<verse eid="PHM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21" />ना नीन आग्याकारी आगोद भरोसा ईटकु नीनी लिख्सतीन, अदिक ईद जान्सतीन कि जो येनारा ना अनतीन, नी नान से यक्कुल माळ्या. <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />अदिक ईद भी कि नान साटी ठहरूसोद जागा तयार ईट. नानी आशा आद कि नीम प्रार्थनागोळ द्वारा ना नीमी कोटकु आगेगाईन.<verse eid="PHM 1:22" /></para>
  <para style="s">आखरी अभिवादन</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:२३ </char>
      <char style="xt" closed="false">
        <ref loc="COL 1:7">कुलुस्सिगोळ १:७</ref>; <ref loc="COL 4:12">४:१२</ref></char>
    </note>इपफ्रास, जो मसीह यीशु दा नान सांगुळ कैदी आन, <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" /><note caller="+" style="x"><char style="xo" closed="false">१:२४ </char><char style="xt" closed="false"><ref loc="ACT 12:12">प्रेरितगोळ १२:१२</ref>,<ref loc="ACT 12:25">२५</ref>; <ref loc="ACT 13:13">१३:१३</ref>; <ref loc="ACT 15:37-39">१५:३७-३९</ref>; <ref loc="COL 4:10">कुलुस्सिगोळ ४:१०</ref>; </char><char style="xt" closed="false"><ref loc="ACT 19:29">प्रेरितगोळ १९:२९</ref>; <ref loc="ACT 27:2">२७:२</ref>; <ref loc="COL 4:10">कुलुस्सिगोळ ४:१०</ref>; </char><char style="xt" closed="false"><ref loc="COL 4:14">कुलुस्सिगोळ ४:१४</ref>; <ref loc="2TI 4:10">२ तीमुथियुस ४:१०</ref>; </char><char style="xt" closed="false"><ref loc="COL 4:14">कुलुस्सिगोळ ४:१४</ref>; <ref loc="2TI 4:11">२ तीमुथियुस ४:११</ref></char></note>अदिक मरकुस अदिक अरिस्तर्खुस अदिक देमास अदिक लूका जो नान सहकर्मी आर, ईंदुर्द नीनी नमस्कार.<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />नाम प्रभु यीशु मसीह अन्द अनुग्रह नीम आत्मा मा आगतेला ईरूल. आमीन.<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>