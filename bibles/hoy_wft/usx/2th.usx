<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TH" style="id">- Holiya</book>
  <para style="h">२ थिस्सलुनीकि</para>
  <para style="toc3">२ थिस्सलुनीकि</para>
  <para style="toc2">२ थिस्सलुनीकि</para>
  <para style="toc1">थिस्सलुनीकिगोळ हेसुर पौलुस प्रेरित उन दुसरा चिट्ठी</para>
  <para style="mt2">थिस्सलुनीकियों के नाम पौलुस प्रेरित की दूसरी पत्री</para>
  <para style="mt1">थिस्सलुनीकिगोळ हेसुर पौलुस प्रेरित उन दुसरा चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">ईद थिस्सलुनीकिगोळ्द लिख्सद पौलुस उन दुसरा चिट्ठी <char style="xt"><ref loc="2TH 1:1">१:१</ref></char> पयला चिट्ठी लिख्सदुर बाद्दा ईद चिट्ठी लगभग मसीह अन्द जनम इन ५१ साल इन बाद्दा लिख्सदुन. याग आव ईद चिट्ठी लिख्सदुन आग आव कुरिन्थि नगर दा ईरोन ईद चिट्ठी जो थिस्सलुनीकिगोळ्द मंडली इक लिख्सकु आगीत, ईद पौलुस तान दुसरा मिशनरी यात्रा अन न्याड्या दा स्थापित माळदुन <char style="xt"><ref loc="ACT 17:1-10">प्रेरितगोळ १७:१-१०</ref></char> ईद मंडली यहूदी अदिक गैरयहूदीगोळ्द बन्सकु ईरोद.</para>
  <para style="ip">ई मंडली इन लॉकुर आखरी समय इन बारा दा अदिक प्रभु अन दुसरा आगमन ईद बारा दा इन बारा दा जानसोर साटी हापाळ उत्सुक ईरोर, इदुरसाटी पौलुस तांद येढ्ढु चिट्ठी दा ई मातगोळ्द जिकर माळतोगोन. ईद दुसरा थिस्सलुनीकिगोळ्द चिट्ठी हुन आर्धा से यक्कुल हिस्सा आखरी समय इन बारा दा आद जो आलसी आर आंदुर बारा दा भी जिकर माळतान. अदिक ईद अनतान कि हर ऊंद मंळसा तान जीवन निर्वाह माळोर साटी क्याल्सा माळुल <char style="xt"><ref loc="2TH 3:6-10">३:६-१०</ref></char></para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. पौलुस खुद इन अदिक तान संगीगोळ्द परिचय कोळतान <char style="ior"><ref loc="2TH 1:1-2">१:१-२</ref></char></para>
  <para style="io1">२. पौलुस परमेश्वर उन थिस्सलुनीकिगोळ्द मंडली इक धन्यवाद माळतान, अदिक आंदुर साटी प्रार्थना माळतान<char style="ior"><ref loc="2TH 1:3-12">१:३-१२</ref></char></para>
  <para style="io1">३. आखरी समय इन बारा दा चर्चा <char style="ior"><ref loc="2TH 2">२</ref></char></para>
  <para style="io1">४. आलस इन विरोध दा अदिक मयनत इन जरवत इन बारा दा पौलुस उन शिक्षा <char style="ior"><ref loc="2TH 3:1-15">३:१-१५</ref></char></para>
  <para style="io1">५. पौलुस उन मंडली इक दुबारा नमस्कार <char style="ior"><ref loc="2TH 3:16-18">३:१६-१८</ref></char></para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:१ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 17:1">प्रेरितगोळ १७:१</ref>
      </char>
    </note>पौलुस अदिक सिलवानुस अदिक तीमुथियुस इन सांगुळ नाम आप्प परमेश्वर अदिक प्रभु यीशु मसीह अन लॉकुरी चिट्ठी लिख्सतीन, थिस्सलुनीकेगोळ मंडली दा आद: <verse eid="2TH 1:1" /><verse number="2" style="v" sid="2TH 1:2" />नाम आप्प परमेश्वर अदिक प्रभु यीशु मसीह अन दी टु नीमी अनुग्रह अदिक शांती सिकतेला ईरूल.<verse eid="2TH 1:2" /></para>
  <para style="s">न्याय इन दिन</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />हे वार्टुरा अदिक आकतींगेरा, नीम बारा दा नामी हर समय परमेश्वर उन धन्यवाद माळ पायजे, अदिक ईद उचित भी आद, इदुरसाटी कि नीम विश्वास हापाळ वाळुसीग्याद, अदिक नीम सप्पा मुंदुर्द प्यार आपस दा हापाळ अच वाळुसतेला होगेत्याद. <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />ईल ताका कि नाव खुद परमेश्वर उन मंडली दा नीम बारा दा घमण्ड माळतेव कि यास उपद्रव अदिक क्लेश नीव सहन माळतीर, आ सब दा नीम धीरज अदिक विश्वास प्रगट आगतद.<verse eid="2TH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5" />ईद परमेश्वर उन खरा न्याय इन स्पष्ट प्रमाण हुन कि नीव परमेश्वर उन राज्य अन योग्य ठहरूसी, यदुर साटी नीव दुख भी नेगुतीर. <verse eid="2TH 1:5" /><verse number="6" style="v" sid="2TH 1:6" />यतिकी परमेश्वर उन हात्‍ती ईद न्याय आद कि जो नीमी क्लेश कोळतार, आंदरी बदला दा क्लेश कोळुल <verse eid="2TH 1:6" /><verse number="7" style="v" sid="2TH 1:7" />अदिक नीमी, जो क्लेश पाऊसतीर, नाम सांगुळ चैन कोळुल; आ समय याग कि प्रभु यीशु तान सामर्थी स्वर्गदूतगोळ सांगुळ, धधकुसतेला बेक्‍की दा स्वर्ग टु प्रगट आदान, <verse eid="2TH 1:7" /><verse number="8" style="v" sid="2TH 1:8" />अदिक जो परमेश्वर उक अरालुर अदिक नाम प्रभु यीशु उन खुशखबरी इक मानसालुर आंदुर से बदला ताकोंडान. <verse eid="2TH 1:8" /><verse number="9" style="v" sid="2TH 1:9" />आंदुर प्रभु उन मुंदु टु अदिक आऊन ताकत इन तेज देल दुर आगकु अनन्त विनाश इन दण्ड ताकोंडार. <verse eid="2TH 1:9" /><verse number="10" style="v" sid="2TH 1:10" />ईद आ दिशी आदीत, याग आव तान पवित्र लॉकुर दा महिमा ताकोमोर अदिक सब विश्वास माळावाळेर दा आश्चर्य अन कारण आगोर साटी बंदान; ईंदुर दा नीव भी सहभागी आईर यतिकी नीव नाम गवाही मा विश्वास माळदीर. <verse eid="2TH 1:10" /><verse number="11" style="v" sid="2TH 1:11" />इदुरसाटी नाव हमेशा नीम साटी प्रार्थना भी माळतेव कि नाम परमेश्वर नीमी आ जीवन इन योग्य समसुल, अदिक भलाई इन हर ऊंद इच्छा अदिक विश्वास इन हर ऊंद क्याल्सा अक सामर्थ्य सहित पुरा माळुल, <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" />ताकी नाम परमेश्वर अदिक प्रभु यीशु मसीह इन अनुग्रह अन अनुसार नाम प्रभु यीशु उन हेसुर इक महिमा सिकुल, अदिक नीमी भी.<verse eid="2TH 1:12" /></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="s">दुष्ट मंळसा</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२:१ </char>
      <char style="xt" closed="false">
        <ref loc="1TH 4:15-17">१ थिस्सलुनीकि ४:१५-१७</ref>
      </char>
    </note>हे वार्टुरा अदिक आकतींगेरा, ईग नाव तान प्रभु यीशु मसीह अन बरोद, अदिक आऊन हात्‍ती तान जमा आगोद बारा दा नीम से विनती माळतेव. <verse eid="2TH 2:1" /><verse number="2" style="v" sid="2TH 2:2" />कि परमेश्वर उन दी टु बरावाळा बातणी, या वचन, या चिट्ठी इन द्वारा, जो कि नाम चिट्ठी इन द्वारा नीमी ईतीदाद, ईद सम्सकु कि प्रभु उन दिन होट बंदाद, नीम मन अचानक असंची आगबाळुल अदिक नीव दुखी आगबाळी. <verse eid="2TH 2:2" /><verse number="3" style="v" sid="2TH 2:3" />यातारा रीति देल यारदारा ध्वाका दा बरबाळेतीर, यतिकी प्रभु उन दिन आगासताका बरतीदील यागासताका परमेश्वर उन खिलाप आखरी विद्रोह सुरू आगतीदील, अदिक आव पाप इन मंळसा मतलब दुष्ट मंळसा प्रगट आगतीदील जो नरक दा नष्ट माळकु आदान. <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" />आव दुष्ट मंळसा विरोध माळतान, अदिक हर ऊंद से जो ईश्वर उन या पुजा अन वस्तुगोळ्द विरोध माळतान, तान तान इक अदुर से धोळ्द ठहरूस्तान, ईल ताका कि आव परमेश्वर उन मंदिर दा कुर्तकु तान तान इक ईश्वर कहलुस्तान. <verse eid="2TH 2:4" /><verse number="5" style="v" sid="2TH 2:5" />येन नीमी याद हैलेच कि याग ना नीम सांगुळ ईरीन, रा नीम से ईव मातगोळ अनतोगिन? <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />नीव आ मात इक जान्सतीर, जो आऊक ईग प्रगट आगली रोक्सेत्याद. अदिक आव दुष्ट मंळसा सही समय मा बंदान. <verse eid="2TH 2:6" /><verse number="7" style="v" sid="2TH 2:7" />यतिकी होच्द दुष्ट शक्तिगोळ ईग भी क्याल्सा माळ्त होगताव, लेकीन ईगल्या ऊंद रोकसावाळा आन, अदिक यागासताका अद दुर आगेगाल आव रोक्सकु ईत्‍तान. <verse eid="2TH 2:7" /><verse number="8" style="v" sid="2TH 2:8" />आग आव दुष्ट मंळसा प्रगट आदान, लेकीन याग प्रभु यीशु मसीह बंदान अदिक आ दुष्ट मंळसा अक तान बाय इन फुक देल कोंद बुट्टान, अदिक तान आगमन इन तेज देल भसम माळ्यान. <verse eid="2TH 2:8" /><verse number="9" style="v" sid="2TH 2:9" /><note caller="+" style="x"><char style="xo" closed="false">२:९ </char><char style="xt" closed="false"><ref loc="MAT 24:24">मत्ती २४:२४</ref></char></note>आ दुष्ट मंळसा अन बरोद शैतान उन सामर्थ्य देल आदीत सब प्रकार इन ख्वाटा सामर्थ्य, अदिक चमत्कार, अदिक अदभुत क्याल्सागोळ सांगुळ आदीत, <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />अदिक नाश आगावाळेर साटी सप्पा प्रकार इन दुष्टता देल फसुस्यान. यतिकी आ लॉकुर्द नाश आदीत यार आ सत्य से प्यार ईटीदिल. <verse eid="2TH 2:10" /><verse number="11" style="v" sid="2TH 2:11" />ईदा कारण परमेश्वर आंदुर्दा ऊंद जो भटकुसतद आ सामर्थ्य अक कळ्यान कि आंदुर ख्वाटा अन विश्वास माळुल, <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />ताकी यास लॉकुर सत्य अन विश्वास माळालुर, उलटा अन्याय देल प्रसन्न आगतार, आंदरी सप्पा मुंदुरी दण्ड सिकुल.<verse eid="2TH 2:12" /></para>
  <para style="s">मजबूत बन्सकु ईरी</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />हे वार्टुरा अदिक आकतींगेरा, अदिक प्रभु उन प्रिय लॉकुरा, आगली होना कि नाव नीम बारा दा हमेशा परमेश्वर उन धन्यवाद माळतेला ईत्‍तेव, यतिकी परमेश्वर पयले टु नीमी नीवळुस्यान कि पवित्र आत्मा अन सामर्थ्य अन्द द्वारा पवित्र आगकु, अदिक सत्य अन विश्वास माळकु उद्धार ताकोमी, <verse eid="2TH 2:13" /><verse number="14" style="v" sid="2TH 2:14" />यदुर साटी नाव जो खुशखबरी नीमी केळ्सदेव, कि नीव नाम प्रभु यीशु मसीह अन महिमा दा सहभागी आगी. <verse eid="2TH 2:14" /><verse number="15" style="v" sid="2TH 2:15" />इदुरसाटी हे वार्टुरा अदिक आकतींगेरा, संची ईरी; अदिक जो जो मातगोळ नीव उपदेश या चिट्ठी इन द्वारा नीमी कोटेव, अवरी हुळकु ईटी.<verse eid="2TH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16" />नाम प्रभु यीशु मसीह खुद अच, अदिक नाम आप्प परमेश्वर, याव नाम से प्यार ईटदुन अदिक अनुग्रह देल प्रोत्साहन शांती अदिक वळ्लीद आशा नामी कोटान, <verse eid="2TH 2:16" /><verse number="17" style="v" sid="2TH 2:17" />नीम मनगोळ दा प्रोत्साहन कोळुल अदिक नीमी हर ऊंद वळ्लीद क्याल्सा अदिक वचन दा मजबूत माळुल.<verse eid="2TH 2:17" /></para>
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="s">नाम साटी प्रार्थना</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />अन्त दा, हे वार्टुरा अदिक आकतींगेरा, नाम साटी प्रार्थना माळतोगी कि प्रभु उन वचन हिंग राटनेरी फैलुसुल अदिक महिमा आगुल, ह्यांग नीम दा आत, <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />अदिक नाव तेळा अदिक दुष्ट मंळसागोळ देल उळ्दकु ईरूल यतिकी हर मंळसा वचन मा विश्वास माळालुन.<verse eid="2TH 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 3:3" />प्रभु विश्वासयोग्य आन; आव नीमी मजबूती देल संची माळ्यान अदिक आ शैतान उन से सुरक्षित ईट्यान. <verse eid="2TH 3:3" /><verse number="4" style="v" sid="2TH 3:4" />नामी प्रभु नीम बारा दा भरोसा कोळतान कि जो-जो आग्या नाव नीमी कोळतेव, अवरी नीव मान्सतिर, अदिक मान्सतेला भी ईत्‍तीर. <verse eid="2TH 3:4" /><verse number="5" style="v" sid="2TH 3:5" />परमेश्वर उन प्यार अदिक मसीह दा हिम्मत ईला बिळोद अदिक प्रभु नीम मन इन अगुवाई माळुल.<verse eid="2TH 3:5" /></para>
  <para style="s">कार्य माळोद उत्‍तरदायित्व</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />हे वार्टुरा अदिक आकतींगेरा, नाव नीमी तान प्रभु यीशु मसीह अन हेसुर देल आग्या कोळतेव कि नीव हर ऊंद ईत्‍ता विश्वासी से ब्यार्र ईरी जो अनुचित चाल नळुतान अदिक जो शिक्षा आव नाम से ताकोंडान अदुर अनुसार माळालुन. <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />यतिकी नीव खुद अच जान्सतीर कि याता रीति देल नाम घाई चाल नळु पायजे, यतिकी नाव नीम न्याड्या दा ईरेव आग आलसी ईला ईरेव, <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />अदिक यारदु रोट्टी फुकट दा तंदिदील; लेकीन मयनत अदिक कष्ट देल ईळ्लक हागुल क्याल्सा धंदा माळतोगेव कि नीम दा टु यारदु मा भार बरबाळुल. <verse eid="2TH 3:8" /><verse number="9" style="v" sid="2TH 3:9" />हिंग ईला कि नामी नीम से मदत बेळोद अधिकार हैलेच, लेकीन इदुरसाटी कि तान तान इक नीम साटी आदर्श ठहरूसदेव कि नीव नाम घाई चाल नळी. <verse eid="2TH 3:9" /><verse number="10" style="v" sid="2TH 3:10" />यतिकी याग नाव नीम मान्या ईरेव, आग भी ईद आग्या नीमी कोळ तोगेव कि “अगर यावारा क्याल्सा ईला माळोद चाहसतिदान रा ऊम भी बाळुल. <verse eid="2TH 3:10" /><verse number="11" style="v" sid="2TH 3:11" />नाव केळतेव कि थ्वाळासा लॉकुर नीम न्याड्या दा आलसी आर अदिक येनु क्याल्सा धंदा माळालुर, लेकीन दुसरा अन क्याल्सा दा कय हाकतोगतार. <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />ईत्‍ता मंळसागोळी नाव प्रभु यीशु मसीह दा आग्या कोळतेव अदिक समझुसतेव कि वळ्लीद रीति देल क्याल्सा माळकु तांद अच रोट्टी तिनुल.<verse eid="2TH 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 3:13" />“नीव, हे वार्टुरा अदिक आकतींगेरा, भलाई माळदुर दा हिम्मत बिळबाळी. <verse eid="2TH 3:13" /><verse number="14" style="v" sid="2TH 3:14" />अगर यावारा नाम ई चिट्ठी इन मात इक मान्सालुन रा आऊन मा नजर ईटी, अदिक आऊन संगत माळबाळी, यदुर देल आव लज्जित आगुल. <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />तरी भी आऊक दुश्मन सम्सबाळी, लेकीन सप्पा मुंदुरी विश्वासी जान्सकु समझुसी.”<verse eid="2TH 3:15" /></para>
  <para style="s">आखरी शब्द</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />ईग प्रभु जो शांती नव सोता हुन खुद अच नीमी हमेशा अदिक हर प्रकार देल शांती कोळुल. प्रभु नीम सप्पा मुंदुर सांगुळ हमेशा ईरूल.<verse eid="2TH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17" />ना, पौलुस, तान कय देल नमस्कार लिख्सतीन. हर चिट्ठी इक ना हिंग खतम माळतीन; ना ईदा प्रकार देल लिख्सतीन अदिक हर ऊंद चिट्ठी दा ना हिंगा हस्ताक्षर माळतीन. <verse eid="2TH 3:17" /><verse number="18" style="v" sid="2TH 3:18" />नाम प्रभु यीशु मसीह अन्द अनुग्रह नीम सब मा आगतेला ईरूल.<verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>