<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="REV" style="id">- Holiya</book>
  <para style="h">प्रकाशितवाक्य</para>
  <para style="toc3">प्रकाशितवाक्य</para>
  <para style="toc2">प्रकाशितवाक्य</para>
  <para style="toc1">प्रकाशितवाक्य यूहन्ना अन्द द्वारा</para>
  <para style="mt2">प्रकाशितवाक्य यूहन्ना के द्वारा</para>
  <para style="mt1">प्रकाशितवाक्य यूहन्ना अन्द द्वारा</para>
  <para style="imt">परिचय</para>
  <para style="ip">प्रकाशितवाक्य अन ई किताब व्हाशोद नियम इन आखरी किताब हुन अदिक अद आखरी दा लिख्सकु आग्याद प्रेरित यूहन्ना यीशु उन जनम इन बाद्दा इसवी सन ९५ इन हात्‍तीपास लिख्सकु आग्याद. <char style="xt"><ref loc="REV 1:1">१:१</ref></char> अदिक आवा यूहन्ना रचित खुशखबरी अदिक यूहन्ना अन्द किताब १, २, ३ लिखस्यान. ईवा यूहन्ना अक लॉकुर यार मा यीशु उन प्यार ईरोद हिंग माताळकु अरू तोगोर <char style="xt"><ref loc="JHN 13:23">यूहन्ना १३:२३</ref></char> यीशु मसीह अन खुशखबरी इन पातमा हेसुर इन टापू मा याग सजा कडोन आग आव ईद किताब लिखस्यान. <char style="xt"><ref loc="REV 1:9">प्रकाशितवाक्य १:९</ref> </char></para>
  <para style="ip">ईद किताब लिखसोद हींद यूहन्ना अन्द ईद उद्देश ईरोद की नानोर वाचुसावाळेर इक यीशु उन सांगुळ विश्वास दा ईरोरसाटी हिम्मत कोळोद अदिक यीशु उन मात्‍त वापस बरोद हात्‍ती ईरोद इदुरसाटी आऊंदा आशा निर्माण माळी. <char style="xt"><ref loc="REV 1:3">१:३</ref></char> <char style="xt"><ref loc="REV 22:7">२२:७</ref></char> आव सप्पा विश्वासीगोळ इक ईद चिट्ठी लिख्सदुन विशेष माळकु येळ मंडली इक लिख्सदुन यऊर्द उल्लेख अध्याय <char style="xt"><ref loc="REV 2">२</ref></char> <char style="xt"><ref loc="REV 3">३</ref></char> दा सीकतद, यूहन्ना खुद इन लिखावट इक परमेश्वर उन दी टु बंदाद बातणी, भविष्यवाणी हिंग हेळतद. अदिक जो मातगोळ इक आव खुद नोळदुन आ मातगोळ्द वर्णन अद अलंकारी शब्द देल मीलुसतद ईद जो किताब आद ईद हाळोद नियम इन भागगोळ देल मीलता जुलता आद. विशेष माळकु <char style="xt"><ref loc="ZEC 6:1-8">जकर्याह ६:१-८</ref></char> आयातगोळ से अदुर्द समानता आद हांग अच येळ तुतारी अदिक येळ कटोरा ईव परमेश्वर मिस्त्र दा तंदुन आ दुखगोळ घाई आव. <char style="xt"><ref loc="EXO 7:9">निर्गमन ७:९</ref></char> प्रकाशितवाक्य आखरी दिनगोळ्द वर्णन माळतद. आखरी दा यीशु विजयी ह्यांग आदान अदिक आऊन मा विश्वास ईटावाळेर आऊन सांगुळ अनन्त काल ताका ह्यांग जीवीत ईत्‍तार हिंग आव हेळतान ईद किताब इन द्वारा नीमी शक्ति सिकुल अदिक यीशु उन दुबारा बरोर साटी नीमी आशा सिकुल.</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. यूहन्ना सुरूवात दा खुद इन पयचान माळकु आऊक भविष्यवाणी ह्यांग हासिल आत ईद हेळकु सुरूवात माळतान प्रकाशितवाक्य <char style="ior"><ref loc="REV 1:1-20">१:१-२०</ref></char></para>
  <para style="io1">२. यीशु उन दी टु येळ मंडली इक मुंद सिक्द बातणी यूहन्ना कोळतान. <char style="ior"><ref loc="REV 1:1-3:22">प्रकाशितवाक्य १:१–३:२२</ref></char></para>
  <para style="io1">३. बाक आव येळ सिक्‍कागोळ्द बारा दा हेळतान <char style="ior"><ref loc="REV 4:1-8:5">प्रकाशितवाक्य ४:१–८:५</ref></char> अदिक येळ तुतारीगोळ्द वर्णन माळतान. <char style="ior"><ref loc="REV 8:6-11:19">८:६–११:१९</ref></char></para>
  <para style="io1">४. ईदुर बाद्दा यूहन्ना ऊंद स्याण पार येळ ताल्लावाळा हाव सांगुळ ह्यांग लळाई माळतान ईद हेळतान. <char style="ior"><ref loc="REV 12:1-14:20">१२:१–१४:२०</ref></char></para>
  <para style="io1">५. ईदुर बाद्दा यूहन्ना सिट्ट इन कटोरा अन बारा दा लिख्सतान <char style="ior"><ref loc="REV 15:1-16:18">१५:१–१६:१८</ref></char></para>
  <para style="io1">६. ईदुर बाद्दा परमेश्वर आऊन आकाश दाकळोर दुश्मनगोळ मा ह्यांग विजय हासिल माळतान ईद हेळतान. <char style="ior"><ref loc="REV 17:1-20:15">प्रकाशितवाक्य १७:१–२०:१५</ref></char></para>
  <para style="io1">७. जो व्हाशोद स्वर्ग अदिक व्हाशोद पृथ्वी आखरी दा बंदीत अदुर्द वर्णन माळतान. <char style="ior"><ref loc="REV 21:1-22:21">प्रकाशितवाक्य २१:१–२२:२१</ref></char></para>
  <chapter number="1" style="c" sid="REV 1"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1"/>यीशु मसीह अन्द प्रकाशितवाक्य, जो आऊक परमेश्वर इदुरसाटी कोटान कि तान दासगोळी आ मातगोळ, यऊर्द राटनेरी आगोद जरूरी आद, तोरसुल; अदिक आव तान स्वर्गदूतगोळ इक कळुकु आऊन द्वारा तान दास यूहन्ना अक हेळदुन, <verse eid="REV 1:1"/><verse number="2" style="v" sid="REV 1:2"/>यूहन्ना परमेश्वर उन वचन अदिक यीशु मसीह अन्द गवाही, मतलब जो येनारा आव नोळीदुन अदुर्द गवाही कोट्टुन. <verse eid="REV 1:2"/><verse number="3" style="v" sid="REV 1:3"/>धन्य आन आव जो ई भविष्यवाणी इन वचन इक वाचुसतान, अदिक आंदुर जो केळतार अदिक इदुर दा लिख्सद मातगोळी मान्सतार; यतिकी समय हात्‍ती आद.<verse eid="REV 1:3"/></para>
  <para style="s">येळु मंडलीगोळ्द अभिवादन</para>
  <para style="p">
    <verse number="4" style="v" sid="REV 1:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१:४ </char>
      <char style="xt" closed="false">
        <ref loc="REV 4:5">प्रकाशितवाक्य ४:५</ref>
      </char>
    </note>यूहन्ना अन्द दी टु आसिया अन्द येळ मंडलीगोळ्द हेसुर:</para>
  <para style="p" vid="REV 1:4">आऊन दी टु जो आन अदिक जो ईरोन अदिक जो बरावाळा आन; अदिक आ येळ आत्मागोळ दी टु जो आऊन सिंहासन इन मुंद आन, <verse eid="REV 1:4"/><verse number="5" style="v" sid="REV 1:5"/>अदिक यीशु मसीह दी टु जो विश्वासयोग्य गवाह अदिक सोत्‍तुर दा टु जीत्‍ता आगावाळेर दा पयला अदिक पृथ्वी इन राजागोळव न्यायाधीश हुन, नीमी अनुग्रह अदिक शांती सिकतेला ईरूल.</para>
  <para style="p" vid="REV 1:5">आव नाम से प्यार ईटतान, अदिक आव तान रक्ता अन द्वारा नामी पापगोळ देल बिळसुस्यान, <verse eid="REV 1:5"/><verse number="6" style="v" sid="REV 1:6"/><note caller="+" style="x"><char style="xo" closed="false">१:६ </char><char style="xt" closed="false"><ref loc="REV 5:10">प्रकाशितवाक्य ५:१०</ref></char></note>अदिक नामी ऊंद राज्य अदिक तान आप्प परमेश्वर उन साटी याजक भी माळ बुट्टुन; आऊंदा महिमा अदिक पराक्रम हमेशा ईरूल. आमीन.<verse eid="REV 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 1:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१:७ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:30">मत्ती २४:३०</ref>; <ref loc="MRK 13:26">मरकुस १३:२६</ref>; <ref loc="LUK 21:27">लूका २१:२७</ref>; <ref loc="1TH 4:17">१ थिस्सलुनीकि ४:१७</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="JHN 19:34">यूहन्ना १९:३४</ref>,<ref loc="JHN 19:37">३७</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:30">मत्ती २४:३०</ref>
      </char>
    </note>नोळी, आव बादलगोळ सांगुळ बरावाळा आन, अदिक हर ऊंद कण्ण आऊक नोळीत, उलटा यार आऊक छेद केळदीदुर आंदुर भी आऊक नोळ्यार, अदिक पृथ्वी इन सप्पा जाती आऊन कारण याद्दा बळदार. हव. आमीन.<verse eid="REV 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१:८ </char>
      <char style="xt" closed="false">
        <ref loc="REV 22:13">प्रकाशितवाक्य २२:१३</ref>
      </char>
    </note>प्रभु परमेश्वर, जो आन अदिक जो ईरोन अदिक जो बरावाळा आन, जो सर्वशक्तिमान आन, ईद अनतान, “ना अच पयला अदिक आखरी हुईन.”<verse eid="REV 1:8"/></para>
  <para style="s">यूहन्ना अक मसीह अन्द दर्शन</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9"/>ना यूहन्ना, जो नीम वार्ट अदिक यीशु उन क्लेश अदिक राज्य अदिक धीरज दा नीम सहभागी आईन, परमेश्वर उन वचन अदिक यीशु उन गवाही इन कारण पतमुस हेसुर इन टापू दा ईरीन. <verse eid="REV 1:9"/><verse number="10" style="v" sid="REV 1:10"/>ना प्रभु उन दिन आत्मा दा होटबंदीन, अदिक तान हिंद तुरही घाई धोळ्द शब्द ईद अनतेला केळदीन, <verse eid="REV 1:10"/><verse number="11" style="v" sid="REV 1:11"/>“जो येनारा नी नोळत्या अदरी किताब दा लिख्सकु येळु मंडलीगोळ्द हात्‍ती कळुबुळ, मतलब इफिसुस, स्मुरना, पिरगमुन, थुआतीरा, सरदीस, फिलदिलफिया, अदिक लौदीकिया अक.” <figure style="fig" alt="Map of seven churches in Asia" file="hk00378c.tif" size="span" copy="Horace Knowles ©" ref="१:११">एशिया अन्द येळ मंडलीगोळ्द नक्शा</figure><verse eid="REV 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12"/>आग ना आऊक, जो नान से माताळोन, नोळोर साटी तान मार्रा तिर्गुसदीन; अदिक हिंद तिर्गकु ना व्हान्ना अन्द येळ दिंग्या ईटोद जागा ऊंद जागा नोळदीन, <verse eid="REV 1:12"/><verse number="13" style="v" sid="REV 1:13"/>अदिक आ दिंग्या ईटोद जागा अन्द न्याड्या दा मंळसा अन पार उन घाई ऊंद आरी इक नोळदीन, जो काल ताका फळक्या हाक्‍कु, अदिक याद्दा मा व्हान्ना अन्द पट्टा कटकु ईरोन. <verse eid="REV 1:13"/><verse number="14" style="v" sid="REV 1:14"/>आऊन ताल्ला अदिक चुट्टी बिळेव ऊन बल्‍की पाला अन घाई चमकदार ईरव, अदिक आऊन कण्णगोळ बेक्‍की इन ज्वाला अन्द घाई ईरव. <verse eid="REV 1:14"/><verse number="15" style="v" sid="REV 1:15"/>आऊन कालगोळ वळ्लीद पीतळा अन घाई ईरव जसा हिंग हतव कि भट्टी दा सेक्सकु आग्याव, अदिक आऊन शब्द हापाळ नीर इन आवाज इन घाई ईरोद. <verse eid="REV 1:15"/><verse number="16" style="v" sid="REV 1:16"/>आव तान ऊम्मा कय दा येळ तारा हुळकु ईरोन, अदिक आऊन बाय देल तेज येढ्ढ धार इन तलवार होळतोगोद. आऊन मार्रा हिंग प्रज्वलित ईरोद, ह्यांग सुर्य भर बिसुल इन समय चमकुसतद. <verse eid="REV 1:16"/><verse number="17" style="v" sid="REV 1:17"/><note caller="+" style="x"><char style="xo" closed="false">१:१७ </char><char style="xt" closed="false"><ref loc="REV 2:8">प्रकाशितवाक्य २:८</ref>; <ref loc="REV 22:13">२२:१३</ref></char></note>याग ना आऊक नोळदीन रा आऊन कालगोळ मा मुर्दा घाई बिदोदीन. आव नान मा तान ऊम्मा कय ईटकु अंदुन, “अंजबाळ; ना पयला अदिक आखरी अदिक जीवता हुईन; <verse eid="REV 1:17"/><verse number="18" style="v" sid="REV 1:18"/>ना सोतोगीदीन, अदिक ईग नोळ ना हमेशा हमेशा जित्‍ता आईन; अदिक मृत्यु अदिक अधोलोक इन चाबीगोळ नान दा हात्‍ती आव. <verse eid="REV 1:18"/><verse number="19" style="v" sid="REV 1:19"/>इदुरसाटी जो मातगोळ नी नोळ्या अदिक जो मातगोळ आगेत्याव अदिक जो मातगोळ ईदुर बाद्दा आगव आव, अव सप्पा मातगोळी लिख्स कोम. <verse eid="REV 1:19"/><verse number="20" style="v" sid="REV 1:20"/>मतलब आ येळ तारागोळ्द भेद नी अवरी नान ऊम्मा कय दा नोळीद, अदिक आ येळ व्हान्ना अन्द दिंग्या ईटोद जागा अन्द भेद: अव येळ तारा येळु मंडलीगोळव स्वर्गदूत हुव, अदिक अव येळ दिंग्या ईटव जागा येळ मंडलीगोळ हुव.<verse eid="REV 1:20"/></para>
  <chapter eid="REV 1"/>
  <chapter number="2" style="c" sid="REV 2"/>
  <para style="s">इफिसुस उक बातणी</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1"/>“इफिसुस उन मंडली इन स्वर्गदूत उक ईद लिख्स:</para>
  <para style="p" vid="REV 2:1">“जो येळु तारा तान ऊम्मा कय दा हुळकु आन, अदिक व्हान्ना अन्द येळु दिंग्या ईटोद जागा अन्द न्याड्या दा टेटतद, अद ईद अनतद कि <verse eid="REV 2:1"/><verse number="2" style="v" sid="REV 2:2"/>ना नीन क्याल्सा, नीन मयनत, अदिक नीन धीरज इक जान्सतीन; अदिक ईद भी कि नी बेकार लॉकुरी नोळ सकाल, अदिक जो तान तान इक प्रेरित अनतार, अदिक आल्लच, आंदरी नी परखुस्कु ख्वाटा माळ्द. <verse eid="REV 2:2"/><verse number="3" style="v" sid="REV 2:3"/>नी धीरज हुडुत्या, अदिक नान हेसुर इन साटी दुख नेगुत नेगुत थक्सीदील. <verse eid="REV 2:3"/><verse number="4" style="v" sid="REV 2:4"/>लेकीन नानी नीन खिलाप ईद अनोद आद कि नी तान पयला अन्द घाई प्यार बिटबुट्या. <verse eid="REV 2:4"/><verse number="5" style="v" sid="REV 2:5"/>इदुरसाटी याद माळ कि नी यल टु बिद्या, अदिक मन तिर्गुस अदिक पयला अन्द घाई क्याल्सा माळ. अगर नी मन तिर्गुसतिदिल, रा ना नीन हात्‍ती बंदकु नीन दिंग्या ईटोद जागा अक अदुर जागा दा टु सरकुस बुळाईन. <verse eid="REV 2:5"/><verse number="6" style="v" sid="REV 2:6"/>लेकीन हव, नीन दा ईद मात रा आद कि नी नीकुलइयोगोळ्द क्याल्सागोळ देल घृणा माळत्या, आंदुर देल ना भी नफरत माळतीन.<verse eid="REV 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 2:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">२:७ </char>
      <char style="xt" closed="false">
        <ref loc="REV 22:2">प्रकाशितवाक्य २२:२</ref>
      </char>
    </note>“यार किव ईतीदाव आव केळ कोमुल कि आत्मा मंडलीगोळ से येन अनतद. जो विजय हासिल माळतान, ना आऊक आ जीवन इन मार्र दा टु जो परमेश्वर उन स्वर्गलोक दा आद, काय तिनली कोळाईन.”<verse eid="REV 2:7"/></para>
  <para style="s">स्मुरना अक बातणी</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">२:८ </char>
      <char style="xt" closed="false">
        <ref loc="REV 1:17">प्रकाशितवाक्य १:१७</ref>; <ref loc="REV 22:13">२२:१३</ref></char>
    </note>“स्मुरना अन्द मंडली इन स्वर्गदूत उक ईद लिख्स:</para>
  <para style="p" vid="REV 2:8">“जो पयला अदिक आखरी आन, जो सोतोगीदुन अदिक ईग जित्‍ता आगेग्यान, आव ईद अनतान कि <verse eid="REV 2:8"/><verse number="9" style="v" sid="REV 2:9"/>ना नीन क्लेश अदिक गरीबी इक जान्सतीन लेकीन नी धनी आय, अदिक जो लॉकुर तान तान इक यहूदी अनतार अदिक आल्लच, लेकीन शैतान उन सभा उर, आंदुर अपमान इक भी जान्सतीन. <verse eid="REV 2:9"/><verse number="10" style="v" sid="REV 2:10"/>जो दुख नीनी झेलसोद बिद्दीत, अऊर देल अंजबाळ. यतिकी नोळी, शैतान नीम दा टु काईक मुंदुरी जेलखाना दा हाकावाळा आन ताकी नीम परख आग सकुल; अदिक नीमी हत्‍त दिन ताका क्लेश नेगोद बिद्दीत. जीव कोळासताका विश्वासी ईर, रा ना नीनी जीवन इन मुकुट कोळाईन.<verse eid="REV 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 2:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">२:११ </char>
      <char style="xt" closed="false">
        <ref loc="REV 20:14">प्रकाशितवाक्य २०:१४</ref>; <ref loc="REV 21:8">२१:८</ref></char>
    </note>“यार किव ईतीदाव आव केळ कोमुल कि आत्मा मंडलीगोळ से येन अनतद. जो विजय हासिल माळतान, आऊक दुसरा मृत्यु देल नुकसान आगतीदील.”<verse eid="REV 2:11"/></para>
  <para style="s">पिरगमुन उक बातणी</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12"/>“पिरगमुन उन मंडली इन स्वर्गदूत उक ईद लिख्स:</para>
  <para style="p" vid="REV 2:12">“यार हात्‍ती येढ्ढ धार इंद अदिक तेज तलवार आद, आव ईद अनतान कि <verse eid="REV 2:12"/><verse number="13" style="v" sid="REV 2:13"/>ना ईद जान्सतीन कि नी अल ईरत्या यल शैतान उन सिंहासन आद; नी नान हेसुर मा स्थिर ईरत्या, अदिक नान मा विश्वास माळदुर देल आ दिनगोळ दा भी हिंद हटसीदिल यदुर दा नान विश्वासयोग्य गवाह अन्तिपास, नीम न्याड्या आ जागा मा घात माळकु आदुन यल शैतान ईरतद. <verse eid="REV 2:13"/><verse number="14" style="v" sid="REV 2:14"/>लेकीन नानी नीन खिलाप येनारा मातगोळ माताळोव आव, यतिकी नीन अल काईक मुंदुर हिंग आर, जो बिलाम इन शिक्षा अक मान्सतार, याव बालाक उक इस्त्राएलीगोळ्द मुंद ठोकर इन कारण ईटोद कल्सदुन कि आंदुर मूर्तीगोळ मा येर्सद चीजगोळ तिनुल अदिक व्यभिचार माळुल. <verse eid="REV 2:14"/><verse number="15" style="v" sid="REV 2:15"/>हांगा नीन अल काईक हिंग आर, जो नीकुलइयो अन्द शिक्षा अक मान्सतार. <verse eid="REV 2:15"/><verse number="16" style="v" sid="REV 2:16"/>इदुरसाटी मन तिर्गुस, ईलारा ना नीन हात्‍ती राटनेरी बंदकु तान बाय इन तलवार देल आंदुर सांगुळ लळाई माळाईन.<verse eid="REV 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 2:17"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">२:१७ </char>
      <char style="xt" closed="false">
        <ref loc="JHN 6:48-50">यूहन्ना ६:४८-५०</ref>
      </char>
    </note>“यार किव ईतीदाव आव केळ कोमुल कि आत्मा मंडलीगोळ से येन अनतद. जो विजय हासिल माळतान, आऊक ना गुप्त मन्ना दा टु कोळाईन, अदिक आऊक ऊंद बिळीद कल्ल भी कोळाईन; अदिक आ कल्ल मा ऊंद हेसुर लिख्सकु ईत्‍तीत, अदरी हासिल माळावाळेर्द अलावा अदिक याऊ अदरी अरूतीदील.”<verse eid="REV 2:17"/></para>
  <para style="s">थुआतीरा अक बातणी</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18"/>“थुआतीरा अन्द मंडली इन स्वर्गदूत उक ईद लिख्स:</para>
  <para style="p" vid="REV 2:18">“परमेश्वर उन पार यारव कण्णगोळ बेक्‍की इन ज्वाला घाई, अदिक यारव कालगोळ वळ्लीद पीतळा अन्द घाई आव, आव ईद अनतान कि <verse eid="REV 2:18"/><verse number="19" style="v" sid="REV 2:19"/>ना नीन क्याल्सागोळ, नीन प्यार अदिक विश्वास अदिक स्यावा अदिक धीरज, इक जान्सतीन अदिक ईद भी कि नीनव हिंदळोव क्याल्सा पयले से वळ्लेव आव. <verse eid="REV 2:19"/><verse number="20" style="v" sid="REV 2:20"/>लेकीन नानी नीन खिलाप ईद अनोद आद कि नी आ आर्त इजेबेल इक ईरगोळत्या जो तान तान इक भविष्यवक्ता अनतार, अदिक नान दासगोळी व्यभिचार माळली अदिक मूर्तीगोळ मा येर्सद चीजगोळी तिनोद कल्सकु भरमुसतार. <verse eid="REV 2:20"/><verse number="21" style="v" sid="REV 2:21"/>ना आकिक मन तिर्गुसोर साटी मवका कोट्टीन, लेकीन आक तान व्यभिचार देल मन तिर्गुसोद चाहासालुर. <verse eid="REV 2:21"/><verse number="22" style="v" sid="REV 2:22"/>नोळ, ना आकिक व्हर्स मा हाकतीन यल आक रोगशैय्या मा ईरोर; अदिक जो आकिन सांगुळ व्यभिचार माळतार अगर आंदुर भी आकिन घाई क्याल्सागोळ देल मन तिर्गुसतिदिल रा ना आंदरी धोळ्द क्लेश दा हाकाईन. <verse eid="REV 2:22"/><verse number="23" style="v" sid="REV 2:23"/>ना आकिन चिकोर इक कोंद बुळाईन; आग सप्पा मंडली जान्स कोंडीत कि दिल अदिक मन इक अरावाळा ना अच हुईन, अदिक ना नीम दा टु हर ऊंद मंळसा अक आऊन क्याल्सा अन्द अनुसार बदला कोळाईन. <verse eid="REV 2:23"/><verse number="24" style="v" sid="REV 2:24"/>लेकीन नीव थुआतीरा अन्द बाकी लॉकुर से, यास ई शिक्षा अक मान्सालुर अदिक आ मातगोळी यवरी शैतान उन गयरा मातगोळ अनतार जान्सालीर, ईद अनतीन कि ना नीम मा मात्‍त ओझा हाकतिदिल. <verse eid="REV 2:24"/><verse number="25" style="v" sid="REV 2:25"/>लेकीन हव, जो नीम हात्‍ती आद अदरी नान बरासताका ताका रोक्सकु ईटी.<verse eid="REV 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="REV 2:26"/>“जो विजय हासिल माळुल अदिक नान क्याल्सागोळ्द अनुसार आखरी ताका माळ्त ईरूल, ना आऊक गैर यहूदी लॉकुर मा अधिकार कोळाईन, <verse eid="REV 2:26"/><verse number="27" style="v" sid="REV 2:27"/>अदिक आव लोवा अन्द छळी हुडुकु आंदुर मा राज्य माळ्यान, याता प्रकार गळग्या माळावाळा नव मुण्ण इन बर्तन चकनाचुर आगेगताव: नानी भी हिंगा अधिकार तान आप्प उन हात्‍ती टु सिक्याद; <verse eid="REV 2:27"/><verse number="28" style="v" sid="REV 2:28"/>अदिक ना आऊक व्हातुर इंद तारा कोळाईन. <verse eid="REV 2:28"/><verse number="29" style="v" sid="REV 2:29"/>यार किव ईतीदाव आव केळ कोमुल कि आत्मा मंडलीगोळ से येन अनतद.”<verse eid="REV 2:29"/></para>
  <chapter eid="REV 2"/>
  <chapter number="3" style="c" sid="REV 3"/>
  <para style="s">सरदीस उक बातणी</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1"/>सरदीस उन मंडली इन स्वर्गदूत उक ईद लिख्स:</para>
  <para style="p" vid="REV 3:1">“यार हात्‍ती परमेश्वर उन येळ आत्मागोळ अदिक येळ तारा आव, आव ईद अनतान कि ना नीन क्याल्सागोळी जान्सतीन: नीनी जित्‍ता रा अंदकु आगतद, लेकीन आय नी सोतकु <verse eid="REV 3:1"/><verse number="2" style="v" sid="REV 3:2"/>जागृत आग, अदिक आ चीजगोळी जो मिक्‍केग्याव अदिक अऊर नाश आगली आद, अवरी मजबूत माळ; यतिकी ना नीन यातोदु क्याल्सा अक तान परमेश्वर उन हात्‍ती पुरा आग्त नोळीदील. <verse eid="REV 3:2"/><verse number="3" style="v" sid="REV 3:3"/><note caller="+" style="x"><char style="xo" closed="false">३:३ </char><char style="xt" closed="false"><ref loc="MAT 24:43">मत्ती २४:४३</ref>,<ref loc="MAT 24:44">४४</ref>; <ref loc="LUK 12:39">लूका १२:३९</ref>,<ref loc="LUK 12:40">४०</ref>; <ref loc="REV 16:15">प्रकाशितवाक्य १६:१५</ref></char></note>इदुरसाटी याद माळ कि नी ह्यांग शिक्षा प्राप्त माळीद अदिक केळीद, अदिक अदुर दा बन्सकु ईर अदिक मन तिर्गुस. अगर नी जागृत ईरतीदील रा नी यागलु जान्स सकतीदिल कि ना याता समय नीन मा बंदकु बिळाईन. <verse eid="REV 3:3"/><verse number="4" style="v" sid="REV 3:4"/>लेकीन हव, सरदीस दा नीन अल काईक हिंग लॉकुर आर यार तान तान फळक्यागोळ अशुध्द माळीदिल, आंदुर बिळेव फळक्या हाक्‍कु नान सांगुळ टेट्यार, यतिकी आंदुर ईदुर लायक आर.”<verse eid="REV 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 3:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">३:५ </char>
      <char style="xt" closed="false">
        <ref loc="REV 20:12">प्रकाशितवाक्य २०:१२</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:32">मत्ती १०:३२</ref>; <ref loc="LUK 12:8">लूका १२:८</ref></char>
    </note>जो विजय हासिल माळ्यान आऊक हिंगा बिळेव फळक्या हाकसुसकु आदीत, अदिक ना आऊन हेसुर जीवन इन किताब दा टु यातोदु रीति देल कडुतिदिल; लेकीन आऊन हेसुर तान आप्प अदिक आऊन स्वर्गदूतगोळ मुंद मान्स कोमाईन. <verse eid="REV 3:5"/><verse number="6" style="v" sid="REV 3:6"/>यार किव ईतीदाव आव केळ कोमुल कि आत्मा मंडलीगोळ से येन अनतद.<verse eid="REV 3:6"/></para>
  <para style="s">फिलदिलफिया अक बातणी</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7"/>“फिलदिलफिया अन्द मंडली इन स्वर्गदूत उक ईद लिख्स:</para>
  <para style="p" vid="REV 3:7">“जो पवित्र अदिक सही आन, अदिक जो दाऊद उन चाबी ईटतान, यार्द तेरदुर बाद्दा याऊ बंद माळ सकालुन अदिक बंद माळदुर बाद्दा याऊ तेरू सकालुन, आव अनतान कि <verse eid="REV 3:7"/><verse number="8" style="v" sid="REV 3:8"/>ना नीन क्याल्सागोळी जान्सतीन; नोळ, ना नीन मुंद ऊंद दरवाजा तेरूकु ईटीन, यदरी याऊ बंद माळ सकालुन; नीन सामर्थ्य थ्वाळासा रा आद, तरी भी नी नान वचन इन पालन माळ्द अदिक नान हेसुर इन इनकार माळीदिल. <verse eid="REV 3:8"/><verse number="9" style="v" sid="REV 3:9"/>नोळ, ना शैतान उन आ सभावाळेर इक नीन वश दा माळ बुळाईन जो यहूदी बन्सकु कुरतोग्यार, लेकीन आल्लच उलटा ख्वाटा माताळतार-नोळ, ना हिंग माळाईन कि आंदुर बंदकु नीनी प्रणाम माळ्यार, अदिक ईद जान्स कोंडार कि ना नीन से प्यार ईटीन. <verse eid="REV 3:9"/><verse number="10" style="v" sid="REV 3:10"/>नी नांद धीरज इन वचन इक हुळद्या, इदुरसाटी ना भी नीनी परीक्षा अन्द आ समय ऊळ्सकु ईटाईन जो पृथ्वी मा ईरावाळेर्द परख माळोर साटी दुनिया मा बरावाळा आद. <verse eid="REV 3:10"/><verse number="11" style="v" sid="REV 3:11"/>ना राटनेरी इच बरावाळा आईन; जो येनारा नीन हात्‍ती आद अदरी हुडुकु ईर कि याऊ नीन मुकुट कसुबाळुल. <verse eid="REV 3:11"/><verse number="12" style="v" sid="REV 3:12"/><note caller="+" style="x"><char style="xo" closed="false">३:१२ </char><char style="xt" closed="false"><ref loc="REV 21:2">प्रकाशितवाक्य २१:२</ref></char></note>जो विजय हासिल माळ्यान आऊक ना तान परमेश्वर उन मंदिर दा ऊंद खंबा माळाईन, अदिक आव बाक यागलु व्हार्या होळतीदिल; अदिक ना तान परमेश्वर उन हेसुर अदिक तान परमेश्वर उन नगर मतलब व्हाशोद यरूशलेम इन हेसुर, जो नान परमेश्वर उन हात्‍ती टु स्वर्ग मा टु ईळोद आद, अदिक तान व्हाशोद हेसुर अदुर मा लिख्साईन. <verse eid="REV 3:12"/><verse number="13" style="v" sid="REV 3:13"/>यार किव ईतीदाव आव केळ कोमुल कि आत्मा मंडलीगोळ से येन अनतद.<verse eid="REV 3:13"/></para>
  <para style="s">लौदीकिया अक बातणी</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14"/>“लौदीकिया अन्द मंडली इन स्वर्गदूत उक ईद लिख्स:</para>
  <para style="p" vid="REV 3:14">“जो आमीन अदिक विश्वासयोग्य अदिक खरा गवाह आन, अदिक परमेश्वर उन दुनिया अन मुल कारण हुन, आव अनतान कि <verse eid="REV 3:14"/><verse number="15" style="v" sid="REV 3:15"/>ना नीन क्याल्सागोळी जान्सतीन कि नी रा ना ठंडा आय अदिक ना बिसक्यांड: वळ्लीद आगाईत कि नी ठंडा या बिसक्यांड ईराईद. <verse eid="REV 3:15"/><verse number="16" style="v" sid="REV 3:16"/>इदुरसाटी कि नी क्वामा-क्वामा आय, अदिक ना ठंडा आय ना बिसक्यांड, अनकु ना नीनी तान बाय दा टु तेगदुर मा आईन. <verse eid="REV 3:16"/><verse number="17" style="v" sid="REV 3:17"/>नी अनत्या कि ना धनी आईन अदिक धनवान आगेगिन अदिक नानी यातोदु चीज इन कमी हैलेच; अदिक ईद जान्साल कि नी अभागा अदिक तुच्छ अदिक भिखारी अदिक कुढ्ढ अदिक ऊगळा आय. <verse eid="REV 3:17"/><verse number="18" style="v" sid="REV 3:18"/>इदुरसाटी ना नीनी सम्मती कोळतीन कि बेक्‍की देल शुद्ध माळ्द व्हान्ना नान से कोम कि नी धनी आगेग, अदिक बिळेव फळक्या कोंड कोम कि हाक्‍कु नीनी तान ऊगळापन इंद शरम हतबाळुल, अदिक तान कण्णगोळी हचोर साटी सुरमा कोंडकु रगळुस कि नी नोळली हत्‍तेग. <verse eid="REV 3:18"/><verse number="19" style="v" sid="REV 3:19"/><note caller="+" style="x"><char style="xo" closed="false">३:१९ </char><char style="xt" closed="false"><ref loc="HEB 12:6">इब्रानिगोळ १२:६</ref></char></note>ना यार यार से प्यार माळतीन, आ सप्पा मुंदुरी उलाहना अदिक शिक्षा कोळतीन; इदुरसाटी आस्था ईट अदिक मन तिर्गुस. <verse eid="REV 3:19"/><verse number="20" style="v" sid="REV 3:20"/>नोळ, ना दरवाजा मा निदुरकु ठोक्सतिन; अगर यावारा नान शब्द केळकु दरवाजा तेरदान, रा ना आऊन हात्‍ती बुळ्क बंदकु आऊन सांगुळ ऊमाईन अदिक आव नान सांगुळ.<verse eid="REV 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 3:21"/>“जो विजय हासिल माळ्यान ना आऊक तान सांगुळ तान सिंहासन मा कुरसाईन, ह्यांग ना भी विजय हासिल माळकु तान आप्प उन सांगुळ आऊन सिंहासन मा कुर्तोदिन. <verse eid="REV 3:21"/><verse number="22" style="v" sid="REV 3:22"/>यार किव ईतीदाव आव केळ कोमुल कि आत्मा मंडलीगोळ से येन अनतद.”<verse eid="REV 3:22"/></para>
  <chapter eid="REV 3"/>
  <chapter number="4" style="c" sid="REV 4"/>
  <para style="s">स्वर्ग दा आराधना</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1"/>ई मातगोळ बाद्दा जो ना दृष्टी माळदीन रा येन नोळतीन कि स्वर्ग दा ऊंद दरवाजा तेरकु आद, अदिक यारी ना पयले तुरही इन घाई शब्द देल तान सांगुळ माताळ्त केळीदीन, आवा अनतान, “ईल म्याकुच होटबर; अदिक ना आ मातगोळ नीनी तोरसाईन, यऊर्द ई मातगोळ बाद्दा पुरा आगोद जरूरी आद.” <verse eid="REV 4:1"/><verse number="2" style="v" sid="REV 4:2"/>तुरन्त ना आत्मा दा होटबंदीन; अदिक येन नोळतीन कि ऊंद सिंहासन स्वर्ग दा ईटकु आद, अदिक आ सिंहासन मा यावारा कुर्तकु आन. <verse eid="REV 4:2"/><verse number="3" style="v" sid="REV 4:3"/>जो अदुर मा कुर्तकु आन आव यशब अदिक माणिक्य घाई कांळ्सदुर दा बरतान, अदिक आ सिंहासन इन नाकु दी मरकत घाई ऊंद मेघधनुष कांळ्सतद. <verse eid="REV 4:3"/><verse number="4" style="v" sid="REV 4:4"/>आ सिंहासन इन नाकु दी ईप्पतनाक सिंहासन आव; अदिक ई सिंहासनगोळ मा ईप्पतनाक स्याणा लॉकुर बिळी फळक्या हाक्‍कु कुर्तकु आर, अदिक आंदुर ताल्लागोळ मा व्हान्ना नव मुकुट आव. <verse eid="REV 4:4"/><verse number="5" style="v" sid="REV 4:5"/><note caller="+" style="x"><char style="xo" closed="false">४:५ </char><char style="xt" closed="false"><ref loc="REV 8:5">प्रकाशितवाक्य ८:५</ref>; <ref loc="REV 11:19">११:१९</ref>; <ref loc="REV 16:18">१६:१८</ref>; </char><char style="xt" closed="false"><ref loc="REV 1:4">प्रकाशितवाक्य १:४</ref></char></note>आ सिंहासन दा टु बिजली अदिक गर्जन गुमरान होळतद अदिक सिंहासन इन मुंद बेक्‍की इन येळ दिंग्या होतेत्याव, अव परमेश्वर उन येळ आत्मागोळ हुव, <verse eid="REV 4:5"/><verse number="6" style="v" sid="REV 4:6"/>अदिक आ सिंहासन इन मुंद मान्सी जसा बिल्लौर घाई काँच इन समुद्र आद.</para>
  <para style="p" vid="REV 4:6">सिंहासन इन न्याड्या दा अदिक सिंहासन इन नाकु दी नाक प्राणी आव, यऊर्द हिंद मुंद कण्ण अच कण्ण आव. <verse eid="REV 4:6"/><verse number="7" style="v" sid="REV 4:7"/>पयला प्राणी हुल्ल इन घाई आद, अदिक दुसरा प्राणी गोसी इन पाड्डा घाई आद, तिसरा प्राणी इन बाय मंळसा अन्द घाई आद, अदिक चौथा प्राणी ऊळुसतेला गीधाळ इन घाई आद. <verse eid="REV 4:7"/><verse number="8" style="v" sid="REV 4:8"/>नाकु प्राणीगोळव आर: पिक्का आव, अदिक नाकु दी अदिक बुळ्क कण्ण अच कण्ण आव; अदिक अव ईळ्लक हागुल बिना आराम ताकोम्त ईद अनतेला ईरताव,</para>
  <para style="q1" vid="REV 4:8">“पवित्र, पवित्र, पवित्र प्रभु परमेश्वर, सर्वशक्तिमान,</para>
  <para style="q2" vid="REV 4:8">जो ईरोन अदिक जो आन अदिक जो बरावाळा आन.”<verse eid="REV 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 4:9"/>याग अव प्राणी आऊन जो सिंहासन मा कुर्तकु आन, अदिक जो हमेशा हमेशा जित्‍ता आन, महिमा अदिक आदर अदिक धन्यवाद माळ्याव; <verse eid="REV 4:9"/><verse number="10" style="v" sid="REV 4:10"/>आग ईप्पतनाक इन ईप्पतनाक स्याणा लॉकुर सिंहासन मा कुरावाळेर मुंद बिदोदार; अदिक अदुर्द पुजा माळतार, जो हमेशा हमेशा जीविता आर प्रणाम माळ्यार. अदिक आंदुर तान-तान मुकुट सिंहासन इन मुंद ईद अनतेला हाक्‍क बुट्टार,<verse eid="REV 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11"/>“हे नाम प्रभु अदिक परमेश्वर, नी अच महिमा</para>
  <para style="q2" vid="REV 4:11">अदिक आदर अदिक सामर्थ्य अन्द लायक आय;</para>
  <para style="q1" vid="REV 4:11">यतिकी नी अच सप्पा चीजगोळी निर्माण माळ्या</para>
  <para style="q2" vid="REV 4:11">अदिक अव अपमान अच इच्छा देल ईरव अदिक अस्तित्व दा बंदव.”<verse eid="REV 4:11"/></para>
  <chapter eid="REV 4"/>
  <chapter number="5" style="c" sid="REV 5"/>
  <para style="s">मोहरबन्द किताब अदिक म्यांडा अन्द पाड्डा</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1"/>जो सिंहासन मा कुर्तकु ईरोन, ना आऊन ऊम्मा कय दा ऊंद किताब नोळदीन जो बुळ्क अदिक व्हार्या टु लिख्सकु ईरोद, अदिक अद येळ मोहर हचकु बंद माळकु आगीत. <verse eid="REV 5:1"/><verse number="2" style="v" sid="REV 5:2"/>बाक ना ऊंद ताकतवर स्वर्गदूत उक नोळदीन जो धोळ शब्द देल ईद प्रचार माळतोगोन, “ई किताब इक तेरोद अदिक अदुर्द मोहर मुरोद लायक याव आन?” <verse eid="REV 5:2"/><verse number="3" style="v" sid="REV 5:3"/>लेकीन ना स्वर्ग दा, ना पृथ्वी मा, ना पृथ्वी इन ल्यालमा यावारा आ किताब इक तेरोद या अदुर मा दृष्टी हाक्कोद लायक होट्टुन. <verse eid="REV 5:3"/><verse number="4" style="v" sid="REV 5:4"/>आग ना हुदक्या कोट कोटकु वर्ली हतदीन, यतिकी आ किताब इक तेरोद या अदुर मा दृष्टी हाक्‍कोद लायक याऊ सिकिदील. <verse eid="REV 5:4"/><verse number="5" style="v" sid="REV 5:5"/>ईदुर मा आ स्याणागोळ दा टु ऊंद नान से अंदुन, “वर्लबाळ; नोळ, यहूदा अन्द गोत्र नव अद हुल्ल जो दाऊद उन मुल आद, आ किताब इक तेरोद अदिक अदुर्द येळु मोहरगोळ मुरोद साटी जयवन्त आग्याद.”<verse eid="REV 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6"/>आग ना आ सिंहासन अदिक नाकु प्राणीगोळ अदिक आ स्याणागोळ्द न्याड्या दा, मतलब ऊंद बली कोळ्द म्यांडा अन्द पाड्डा नीदुरकु नोळदीन. अदुर येळ गॉट्टा अदिक येळ कण्णगोळ ईरव; ईव परमेश्वर उन येळु आत्मागोळ हुव, जो सप्पा धरती मा कळुकु आग्याव. <verse eid="REV 5:6"/><verse number="7" style="v" sid="REV 5:7"/>आव बंदकु आऊन ऊम्मा कय देल जो सिंहासन मा कुर्तकु ईरोन, आ किताब हुळ्द कोंडुन. <verse eid="REV 5:7"/><verse number="8" style="v" sid="REV 5:8"/>याग आव किताब हुळ्द कोंडुन, रा अव नाकु प्राणी अदिक ईप्पतनाक इन ईप्पतनाक स्याणा लॉकुर आ म्यांडा अन्द पाड्डा अन्द मुंद बिदोदुर. आंदुर दा टु हर ऊंद जन उन कय दा वीणा अदिक ऊदबत्‍ती, जो पवित्र लॉकुर्द प्रार्थनागोळ हुव, देल तुमकु व्हान्ना नव कटोरा ईरव. <verse eid="REV 5:8"/><verse number="9" style="v" sid="REV 5:9"/>आंदुर ईद व्हाशोद हाळ हाळली कुरतुर,</para>
  <para style="q1" vid="REV 5:9">“नी ई किताब इक हुडोद, अदिक ईदुर्द मोहरगोळ</para>
  <para style="q2" vid="REV 5:9">तेरोद लायक आय;</para>
  <para style="q1" vid="REV 5:9">यतिकी नी बली आगकु तान रक्ता देल</para>
  <para style="q2" vid="REV 5:9">हर ऊंद कुल अदिक भाषा अदिक लॉकुर अदिक</para>
  <para style="q1" vid="REV 5:9">जाती दा टु</para>
  <para style="q2" vid="REV 5:9">परमेश्वर उन साटी लॉकुरी कोंड्या, <verse eid="REV 5:9"/><verse number="10" style="v" sid="REV 5:10"/><note caller="+" style="x"><char style="xo" closed="false">५:१० </char><char style="xt" closed="false"><ref loc="REV 1:6">प्रकाशितवाक्य १:६</ref></char></note>अदिक आंदरी नाम परमेश्वर उन साटी ऊंद</para>
  <para style="q1" vid="REV 5:10">राज्य अदिक याजक माळ्द;</para>
  <para style="q2" vid="REV 5:10">अदिक आंदुर धरती मा राज्य माळतार.”<verse eid="REV 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11"/>याग ना नोळदीन, रा आ सिंहासन अदिक आ प्राणीगोळ अदिक आ स्याणागोळ नाकु दी हापाळ सा स्वर्गदूतगोळ्द शब्द केळदीन, यार गिनती लाखों अदिक करोळो अन्द ईरोद, <verse eid="REV 5:11"/><verse number="12" style="v" sid="REV 5:12"/>अदिक आंदुर धोळ शब्द देल अनतोगोर,</para>
  <para style="q1" vid="REV 5:12">“बली कोळ्द म्यांडा अन्द पाड्डा अच</para>
  <para style="q2" vid="REV 5:12">सामर्थ्य अदिक धन अदिक ग्यान अदिक ताकत अदिक आदर</para>
  <para style="q2" vid="REV 5:12">अदिक महिमा अदिक धन्यवाद इन लायक आद!”<verse eid="REV 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 5:13"/>बाक ना स्वर्ग दा अदिक धरती मा अदिक धरती इन ल्यालमा अदिक समुद्र अन्द सप्पा माळ्द वस्तुगोळी,</para>
  <para style="q1" vid="REV 5:13">अदिक सप्पा येनारा जो अऊर दा आव, ईद अनतेला केळदीन,</para>
  <para style="q2" vid="REV 5:13">“जो सिंहासन मा कुर्तकु आन आऊन अदिक म्यांडा अन्द पाड्डा अन्द धन्यवाद</para>
  <para style="q2" vid="REV 5:13">अदिक आदर अदिक महिमा अदिक राज्य हमेशा ईरूल!”<verse eid="REV 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 5:14"/>अदिक नाकु प्राणीगोळ आमीन अंदव, अदिक स्याणागोळ बांगकु दण्डवत माळदुर.<verse eid="REV 5:14"/></para>
  <chapter eid="REV 5"/>
  <chapter number="6" style="c" sid="REV 6"/>
  <para style="s">येळ मोहरगोळ्द तेरूकु आगोद</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1"/>बाक ना नोळदीन कि म्यांडा अन्द पाड्डा आ येळ मोहरगोळ दा टु ऊंद मोहर इक तेरूत; अदिक आ नाकु प्राणीगोळ दा टु ऊंद प्राणी इंद गर्जन घाई शब्द केळदीन, “बर!” <verse eid="REV 6:1"/><verse number="2" style="v" sid="REV 6:2"/>ना दृष्टी माळदीन, अदिक नोळी, ऊंद बिळी घ्वाळा आद, अदिक अदुर सवारी माळावाळा बाण हुडुकु आन; अदिक आऊक ऊंद मुकुट कोटकु आत, अदिक आव जय जयकार माळ्त होट्टुन कि मात्‍त यक्कुल जय हासिल माळुल.<verse eid="REV 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3"/>याग अद दुसरा मोहर तेरूत, रा ना दुसरा प्राणी इक ईद अनतेला केळदीन, “बर!” <verse eid="REV 6:3"/><verse number="4" style="v" sid="REV 6:4"/>बाक मात्‍त ऊंद घ्वाळा होळ्त जो क्याचांद रंग इन ईरोद; अदुर सवारी माळावाळा अक ईद अधिकार कोटकु आत कि धरती मा टु मेल मिलाप नेग्द बुळ, ताकी लॉकुर आबुर दाबुर इक कोनुल; अदिक आऊक ऊंद धोळ्द तलवार कोटकु आत.<verse eid="REV 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5"/>याग अद तिसरा मोहर तेरूत, रा ना तिसरा प्राणी इक ईद अनतेला केळदीन, “बर!” ना दृष्टी माळदीन, अदिक नोळी, ऊंद करीद घ्वाळा आद, अदिक अदुर सवारी माळावाळा अन्द कय दा ऊंद तराजू आद; <verse eid="REV 6:5"/><verse number="6" style="v" sid="REV 6:6"/>अदिक ना आ नाकु प्राणीगोळ न्याड्या दा टु ऊंद शब्द ईद अनतेला केळदीन, “दीनार इन सेर तीम गोदी, अदिक दीनार इन मुर सेर जऊस, लेकीन याण्णा अदिक अंगुर इन रास्सा अन्द नुकसान माळबाळेतीर.”<verse eid="REV 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7"/>याग अद चौथा मोहर तेरूत, रा ना चौथा प्राणी इन शब्द ईद अनतेला केळदीन, “बर!” <verse eid="REV 6:7"/><verse number="8" style="v" sid="REV 6:8"/>ना दृष्टी माळदीन, अदिक नोळी, ऊंद पिवळा रंग घाई घ्वाळा आद; अदिक अदुर मा सवारी माळावाळा अन्द हेसुर मृत्यु आद, अदिक अधोलोक आऊन हिंद हिंद आद; अदिक आंदरी धरती इन ऊंद चौथाई भाग मा ईद अधिकार कोटकु आत कि तलवार, अदिक अकाल, अदिक मरी, अदिक धरती इन आळी दाकळव पशुगोळ द्वारा लॉकुरी कोंदबुळुल.<verse eid="REV 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9"/>याग अद पाचवा मोहर तेरूत, रा ना वेदी इन ल्यालमा आंदुर जीवगोळी नोळदीन जो परमेश्वर उन वचन इन कारण अदिक आ गवाही इन कारण जो आंदुर कोटीदुर बली येर्सकु आगीदव. <verse eid="REV 6:9"/><verse number="10" style="v" sid="REV 6:10"/>आंदुर धोळ शब्द दा कारूकु अंदुर, “हे स्वामी, हे पवित्र अदिक सत्य; नी यागासताका न्याय माळ्या? अदिक धरती मा ईरावाळेर से नाम रक्ता अन बदला यागासताका ताकोंड्या?” <verse eid="REV 6:10"/><verse number="11" style="v" sid="REV 6:11"/>आंदुर दा टु हर ऊंद जन उक बिळी फळक्या कोटकु आत, अदिक आंदुर से अंदकु आत कि मात्‍त घळी तिम आराम माळी, यागासताका कि नीम संगी दास अदिक वार्टुर जो नीम घाई बली येर्सकु आगावाळेर आर आंदुर भी गिनती पुरा आगेगाल.<verse eid="REV 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">६:१२ </char>
      <char style="xt" closed="false">
        <ref loc="REV 11:13">प्रकाशितवाक्य ११:१३</ref>; <ref loc="REV 16:18">१६:१८</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:29">मत्ती २४:२९</ref>; <ref loc="MRK 13:24">मरकुस १३:२४</ref>,<ref loc="MRK 13:25">२५</ref>; <ref loc="LUK 21:25">लूका २१:२५</ref></char>
    </note>याग अद सहावा मोहर तेरूत, रा ना नोळदीन कि ऊंद धोळ्द भूकम्प आत, अदिक सुर्य धुसा घाई करीद अदिक पुरा बेळदिंग रक्ता अन घाई आगेत. <verse eid="REV 6:12"/><verse number="13" style="v" sid="REV 6:13"/>आकाश इन तारागोळ धरती मा हिंग बिद्दव जसा धोळ्द आंधी देल आळगाळकु अंजीर इन मार्र मा टु कच्चा काय झळ्सताव. <verse eid="REV 6:13"/><verse number="14" style="v" sid="REV 6:14"/><note caller="+" style="x"><char style="xo" closed="false">६:१४ </char><char style="xt" closed="false"><ref loc="REV 16:20">प्रकाशितवाक्य १६:२०</ref></char></note>आकाश हिंग सरकुसेत जसा चिट्टी गुंळ्सदुर देल सरकुसेगतद; अदिक हर ऊंद पहाळी, अदिक टापू तान तान जागा मा टु सरकुसेदव. <verse eid="REV 6:14"/><verse number="15" style="v" sid="REV 6:15"/>आग धरती इन राजा, अदिक प्रधान, अदिक सरदार, अदिक धनवान अदिक सामर्थी लॉकुर, अदिक हर ऊंद दास अदिक हर ऊंद स्वतंत्र पहाळीगोळ्द गुफागोळ दा अदिक चट्टानगोळ दा होगकु होचकोंडव, <verse eid="REV 6:15"/><verse number="16" style="v" sid="REV 6:16"/><note caller="+" style="x"><char style="xo" closed="false">६:१६ </char><char style="xt" closed="false"><ref loc="LUK 23:30">लूका २३:३०</ref></char></note>अदिक पहाळीगोळ अदिक चट्टानगोळ देल अनली हतदव, “नाम मा बिळी; अदिक नामी आऊन बाय देल जो सिंहासन मा कुर्तकु आन, अदिक म्यांडा अन्द पाड्डा अन्द प्रकोप देल होच्सकोम बुळी. <verse eid="REV 6:16"/><verse number="17" style="v" sid="REV 6:17"/>यतिकी आंदुर प्रकोप इन भयानक दिन होट बंदाव, ईग याव ऊंजेर सकतान?”<verse eid="REV 6:17"/></para>
  <chapter eid="REV 6"/>
  <chapter number="7" style="c" sid="REV 7"/>
  <para style="s">इस्त्राएल इन 1,44000 लॉकुर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1"/>इदुर बाद्दा ना पृथ्वी इन नाकु क्वाना मा नाक स्वर्गदूत नीदुरकु नोळदीन. आंदुर पृथ्वी इन नाकु हवा अक रोक्सकु ईरोर ताकी पृथ्वी या समुद्र या यातोदु मार्र मा हवा नळु बाळुल. <verse eid="REV 7:1"/><verse number="2" style="v" sid="REV 7:2"/>बाक ना मात्‍त ऊंद स्वर्गदूत उक जित्‍ता परमेश्वर उन मोहर हुडुकु पूर्व टु म्याकुच बर्त नोळदीन; आव आ नाकु स्वर्गदूतगोळ देल यवरी पृथ्वी अदिक समुद्र अन्द नुकसान माळोद अधिकार कोटकु आगीत, धोळ शब्द देल कारूकु अंदुन, <verse eid="REV 7:2"/><verse number="3" style="v" sid="REV 7:3"/>“यागासताका नाव तान परमेश्वर उन दासगोळ ह्याणा मा मोहर हच कोमालेव, आगासताका पृथ्वी अदिक समुद्र अदिक मार्रगोळी नुकसान पोहचुस बाळेतीर.” <verse eid="REV 7:3"/><verse number="4" style="v" sid="REV 7:4"/>यार मा मोहर कोटकु आत ना आंदुर गिनती केळदीन, मतलब इस्त्राएल इन औलादगोळ्द सप्पा गोत्र दा टु ऊंद लाख चौवालीस हजार मा मोहर कोटकु आत: <verse eid="REV 7:4"/><verse number="5" style="v" sid="REV 7:5"/>यहूदा अन्द गोत्र दा टु हन्नेळ हजार मा मोहर कोटकु आत; रूबेने अन्द गोत्र दा टु हन्नेळ हजार मा, गाद इन गोत्र दा टु हन्नेळ हजार मा. <verse eid="REV 7:5"/><verse number="6" style="v" sid="REV 7:6"/>आशेर इन गोत्र दा टु हन्नेळ हजार मा, नप्ताली इन गोत्र दा टु हन्नेळ हजार मा, मनश्शिह अन्द गोत्र दा टु हन्नेळ हजार मा, <verse eid="REV 7:6"/><verse number="7" style="v" sid="REV 7:7"/>शमौन उन गोत्र दा टु हन्नेळ हजार मा, लेवी इन गोत्र दा टु हन्नेळ हजार मा, इस्साकार इन गोत्र दा टु हन्नेळ हजार मा, <verse eid="REV 7:7"/><verse number="8" style="v" sid="REV 7:8"/>जबूलून उन गोत्र दा टु हन्नेळ हजार मा, यूसुफ उन गोत्र दा टु हन्नेळ हजार मा, अदिक बिन्यामीन उन गोत्र दा टु हन्नेळ हजार मा मोहर कोटकु आत.<verse eid="REV 7:8"/></para>
  <para style="s">ऊंद धोळ्द भीळ</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9"/>इदुर बाद्दा ना नजर तिर्गुसदिन, अदिक नोळी, हर ऊंद जाती अदिक कुल अदिक लॉकुर अदिक भाषा दा टु ऊंद हिंग धोळ्द भीळ, यदरी याऊ आळु ईला सकोन, बिळी फळक्या हाक्‍कु अदिक तान कयगोळ दा खजुर इन डगालगोळ हुडुकु सिंहासन इन मुंद अदिक म्यांडा अन्द पाड्डा अन्द मुंद निदुरकु आद, <verse eid="REV 7:9"/><verse number="10" style="v" sid="REV 7:10"/>अदिक धोळ्द शब्द देल कारूकु अनतद, “उद्धार इन साटी नाम परमेश्वर उन, जो सिंहासन मा कुर्तकु आन, अदिक म्यांडा अन्द पाड्डा अन्द जय-जयकार आगुल!” <verse eid="REV 7:10"/><verse number="11" style="v" sid="REV 7:11"/>अदिक सप्पा स्वर्गदूत आ सिंहासन अदिक स्याणागोळ अदिक नाकु प्राणीगोळ नाकु दी निदुरकु आर; बाक आंदुर सिंहासन इन मुंद बाय इन भार देल बिदोदुर अदिक परमेश्वर उक दण्डवत माळकु अंदुर, <verse eid="REV 7:11"/><verse number="12" style="v" sid="REV 7:12"/>“आमीन! नाम परमेश्वर उन स्तुति अदिक महिमा अदिक ग्यान अदिक धन्यवाद अदिक आदर अदिक सामर्थ्य अदिक ताकत हमेशा हमेशा बन्सकु ईरूल. आमीन!”<verse eid="REV 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13"/>इदुर मा स्याणागोळ दा टु ऊंद नान से अंदुन, “ई बिळी फळक्यागोळ हाक्‍कु यार उर? अदिक यल टु बंदार?”<verse eid="REV 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">७:१४ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:21">मत्ती २४:२१</ref>; <ref loc="MRK 13:19">मरकुस १३:१९</ref></char>
    </note>ना आंदुर से अंदीन, “हे स्वामी, नी अच जान्सत्या.”</para>
  <para style="p" vid="REV 7:14">आव नान से अंदुन, “ईंदुर आंदुर उर, जो आ महाक्लेश दा टु होटकु बंदार; इंदुर तान-तान फळक्या म्यांडा अन्द पाड्डा अन्द रक्ता दा तोळकु बिळेव माळ्यार. <verse eid="REV 7:14"/><verse number="15" style="v" sid="REV 7:15"/>ईदा कारण आंदुर परमेश्वर उन सिंहासन इन मुंद आर, अदिक आऊन मंदिर दा ईळ्लक-हागुल आऊन स्यावा माळतार, अदिक जो सिंहासन मा कुर्तकु आन, आव आंदुर म्याकुच तान तम्बू तानस्यान. <verse eid="REV 7:15"/><verse number="16" style="v" sid="REV 7:16"/>आंदुर बाक उपासा अदिक नीरअळ्क देल ईरतीदील; अदिक ना आंदुर मा यागल्यारा बिसुल बिद्दीत. <verse eid="REV 7:16"/><verse number="17" style="v" sid="REV 7:17"/>यतिकी म्यांडा अन्द पाड्डा जो सिंहासन इन न्याड्या दा आद आंदुर जागनी माळीत, अदिक आंदरी जीवन रूपी नीर इन डोबन इन हात्‍ती ओतीत; अदिक परमेश्वर आंदुर कण्णगोळी बाक यागलु वर्लगोळतिदिल.<verse eid="REV 7:17"/></para>
  <chapter eid="REV 7"/>
  <chapter number="8" style="c" sid="REV 8"/>
  <para style="s">सातवा मोहर अदिक व्हान्ना अन्द ऊदबत्‍ती दान</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1"/>“याग आव सातवा मोहर तेरदुन, रा स्वर्ग दा आर्धा घंटा ताका सन्नाटा आगेत. <verse eid="REV 8:1"/><verse number="2" style="v" sid="REV 8:2"/>आग ना आ येळु स्वर्गदूतगोळ इक नोळदीन जो परमेश्वर उन मुंद निदुरकु ईरतार, अदिक आंदरी येळ तुरहीगोळ कोटकु आत.”<verse eid="REV 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3"/>बाक मात्‍त ऊंद स्वर्गदूत व्हान्नोद ऊदबत्‍ती दान हुडुकु बंदुन, अदिक वेदी इन हात्‍ती निदुरदुन; अदिक आऊक हापाळ ऊदबत्‍ती कोटकु आत कि सप्पा पवित्र लॉकुर्द प्रार्थनागोळ सांगुळ व्हान्ना अन्द आ वेदी मा, जो सिंहासन इन मुंद आद येर्सुल. <verse eid="REV 8:3"/><verse number="4" style="v" sid="REV 8:4"/>आ ऊदबत्‍ती इन धुंगा पवित्र लॉकुर्द प्रार्थना सहित स्वर्गदूत उन कय दा टु परमेश्वर उन मुंद पोहचुसेत. <verse eid="REV 8:4"/><verse number="5" style="v" sid="REV 8:5"/><note caller="+" style="x"><char style="xo" closed="false">८:५ </char><char style="xt" closed="false"><ref loc="REV 11:19">प्रकाशितवाक्य ११:१९</ref>; <ref loc="REV 16:18">१६:१८</ref></char></note>आग स्वर्गदूत ऊदबत्‍ती दान हुडुकु अदुर दा वेदी इन बेक्‍की तुमदुन अदिक धरती मा हाक बुट्टुन; अदिक गर्जन अदिक शब्द अदिक बिजलीगोळ अदिक भूकम्प आगली कुरतव.<verse eid="REV 8:5"/></para>
  <para style="s">येळ तुरहीगोळ</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6"/>आग आ येळु स्वर्गदूत यार हात्‍ती येळ तुरहीगोळ ईरव अवरी ऊरूली तयार आदुर.<verse eid="REV 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7"/>पयला स्वर्गदूत तुरही ऊरूदुन, अदिक रक्ता देल मिलुसकु क्यांडागोळ अदिक बेक्‍की तयार आत, अदिक धरती मा हाक्‍कु आत; अदिक धरती इन ऊंद तिहाई भाग होत्‍तेत, अदिक मार्रगोळ्द ऊंद तिहाई भाग होत्‍तेत, अदिक सप्पा हिवरा काड्डा भी होत्‍तेत.<verse eid="REV 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8"/>दुसरा स्वर्गदूत तुरही ऊरदुन, रा बेक्‍की घाई होत्‍ततेला ऊंद धोळ्द पहाळी समुद्र दा हाक्‍कु आत; अदिक समुद्र अन्द ऊंद तिहाई भाग रक्ता आगेत, <verse eid="REV 8:8"/><verse number="9" style="v" sid="REV 8:9"/>अदिक समुद्र अन्द ऊंद तिहाई जीव सोतोदव, अदिक ऊंद तिहाई जहाज नाश आगेदव.<verse eid="REV 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10"/>तिसरा स्वर्गदूत तुरही ऊरदुन, अदिक ऊंद धोळ तारा जो मशाल घाई होत्‍तोगोद स्वर्ग दा टु मुरूत, अदिक गांगागोळ्द ऊंद तिहाई मा अदिक नीर इन डोबनगोळ मा बंदकु बित्‍त. <verse eid="REV 8:10"/><verse number="11" style="v" sid="REV 8:11"/>आ तारा अन्द हेसुर नागदौना आद; अदिक ऊंद तिहाई नीर नागदौना घाई केय आगेत, अदिक हापाळ सा मंळसागोळ आ नीर इन केय आगदुर देल सोतोदुर.<verse eid="REV 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12"/>चौथा स्वर्गदूत तुरही ऊरदुन, अदिक सुर्य अन्द ऊंद तिहाई भाग, अदिक बेळदिंग्या अन्द ऊंद तिहाई अदिक तारागोळ्द ऊंद तिहाई भाग मा आपत्ति बत्‍त, ईल ताका कि अऊर्द ऊंद तिहाई भाग अंधार आगेत अदिक दिन इन ऊंद तिहाई भाग दा ऊजुळ ईतीदील, अदिक हांगा ईळ्लक दा भी.<verse eid="REV 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13"/>याग ना मात्‍त नोळदीन, रा आकाश इन न्याड्या दा गीधाळ इक ऊळुसतेला अदिक धोळ शब्द दा ईद अनतेला केळदीन, “आ मुर स्वर्गदूतगोळ्द तुरही इन शब्दगोळ कारण, यार्द ऊरोद ईगल्या मिक्‍कु आद, धरती नोर ईरावाळेर मा हाय, हाय, हाय!”<verse eid="REV 8:13"/></para>
  <chapter eid="REV 8"/>
  <chapter number="9" style="c" sid="REV 9"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1"/>याग पाचवा स्वर्गदूत तुरही ऊरदुन, रा ना स्वर्ग टु पृथ्वी मा ऊंद तारा बिळतेला नोळदीन, अदिक अदरी अथाह अधोलोक इंद चाबी कोटकु आत. <verse eid="REV 9:1"/><verse number="2" style="v" sid="REV 9:2"/>अद अथाह अधोलोक इक तेरूत, अदिक कुंड दा टु धोळ्द भट्टी घाई धुंगा येळ्त, अदिक कुंड इन धुंगा देल सुर्य अदिक वायु अंधारकाय आगेदव. <verse eid="REV 9:2"/><verse number="3" style="v" sid="REV 9:3"/>आ धुंगा दा टु पृथ्वी मा हत्‍तीफाफा होट्टव, अदिक अवरी पृथ्वी इन चेळगोळ घाई शक्ति कोटकु आत. <verse eid="REV 9:3"/><verse number="4" style="v" sid="REV 9:4"/>अऊर से अंदकु आत कि ना पृथ्वी इन काड्डा अक, ना यातोदारा हरयाली इक, ना यातोदारा मार्र इक नुकसान पोहचुसेत, सिर्फ आ मंळसागोळी नुकसान पोहचुसेत यार ह्याणा मा परमेश्वर उन मोहर हैलेच. <verse eid="REV 9:4"/><verse number="5" style="v" sid="REV 9:5"/>अवरी लॉकुरी कोंद बुळोद रा ईला लेकीन अईद तिंगुळ ताका पीळा कोळोद अधिकार कोटकु आत: अदिक आंदुर पीळा हिंग ईरोद ह्यांग चेळ उन डंक होळदुर देल मंळसा अक आगतद. <verse eid="REV 9:5"/><verse number="6" style="v" sid="REV 9:6"/>आ दिनगोळ दा मंळसागोळ मृत्यु उक ढुंढस्यार अदिक आंदरी मृत्यु सिकतीदील; अदिक सायोद लालसा माळ्यार, अदिक मृत्यु आंदुर से दुर ओळीत.<verse eid="REV 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7"/>आ हत्‍तीफाफागोळ्द आकार लळाई इन साटी तयार माळ्द घ्वाळागोळ घाई ईरव, अदिक अऊर ताल्लागोळ मा व्हान्ना अन्द मुकुट ईरव; अदिक अऊर मार्रगोळ मंळसागोळ घाई ईरव. <verse eid="REV 9:7"/><verse number="8" style="v" sid="REV 9:8"/>अऊर चुटगोळ आर्तेर चुटगोळ घाई अदिक हल्ल हुल्ल इन हल्लगोळ घाई ईरव. <verse eid="REV 9:8"/><verse number="9" style="v" sid="REV 9:9"/>अव लोवा घाई झिलम हाक्‍कु ईरव; अदिक अऊर पिक्‍कागोळ्द शब्द हिंग ईरोद जसा रथ अदिक हापाळ सा घ्वाळागोळ्द जो लळाई दा ओळताव. <verse eid="REV 9:9"/><verse number="10" style="v" sid="REV 9:10"/>अऊर्द पुसटी चेळगोळ घाई ईरव अदिक अऊर दा डंक ईरव, अदिक अवरी अईद तिंगुळ ताका मंळसागोळी दुख पोहचुसोद जो शक्ति सिकीत, अद अऊर्द पुसटीगोळ दा ईरोद. <verse eid="REV 9:10"/><verse number="11" style="v" sid="REV 9:11"/>अथाह अधोलोक इन स्वर्गदूत अऊर मा राजा ईरोन; आऊन हेसुर इब्रानी दा अबद्दोन, अदिक यूनानी दा अपुल्लयोन आद.<verse eid="REV 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12"/>पयला विपत्‍ती नष्ट आगेत, नोळी, ईग इदुर बाद्दा येढ्ढ परेशानीगोळ मात्‍त बरव आव.<verse eid="REV 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13"/>याग सहावा स्वर्गदूत तुरही ऊरूदुन रा व्हान्ना अन्द वेदी जो परमेश्वर उन मुंद आद अदुर गॉट्टागोळ दा टु ना हिंग शब्द केळदीन, <verse eid="REV 9:13"/><verse number="14" style="v" sid="REV 9:14"/>मतलब यावारा सहावा स्वर्गदूत से, यार हात्‍ती तुरही ईरोद, अनेत्यान, “आ नाकु स्वर्गदूतगोळ इक जो धोळ गांगा फुरात इन हात्‍ती कटकु आर, खोल्स बुळ.” <verse eid="REV 9:14"/><verse number="15" style="v" sid="REV 9:15"/>आ नाकु स्वर्गदूत खोल्सकु आदुर जो आ समय, अदिक दिन, अदिक तिंगुळ, अदिक साल इन साटी मंळसागोळ्द ऊंद तिहाई भाग इक कोंद बुळली तयार माळकु आगिदुर. <verse eid="REV 9:15"/><verse number="16" style="v" sid="REV 9:16"/>अऊर्द फौज इन सवारगोळ्द गिनती ईप्पत करोळ ईरोद; ना अऊर्द गिनती केळदीन. <verse eid="REV 9:16"/><verse number="17" style="v" sid="REV 9:17"/>नानी ई दर्शन दा घ्वाळागोळ अदिक अऊर्द हिंग सवार कांळ्सदुर यार झिलमगोळ बेक्‍की, अदिक धूम्रकान्त, अदिक गन्धक घाई ईरोद, अदिक आ घ्वाळागोळ्द ताल्ला हुल्ल इन ताल्ला घाई ईरव; अदिक अऊर बाय दा टु बेक्‍की, धुंगा अदिक गन्धक होळतोगोद. <verse eid="REV 9:17"/><verse number="18" style="v" sid="REV 9:18"/>ई मुरू महामारीगोळ्द मतलब बेक्‍की अदिक धुंगा अदिक गन्धक देल, जो अऊर बाय दा टु होळतोगोद मंळसागोळ्द ऊंद तिहाई कोंदकु आत. <verse eid="REV 9:18"/><verse number="19" style="v" sid="REV 9:19"/>यतिकी आ घ्वाळागोळ्द सामर्थ्य अऊर बाय अदिक पुसटीगोळ दा ईरोद; इदुरसाटी कि अऊर पुसटीगोळ हावगोळ घाई ईरव, अदिक आ पुसटीगोळ्द ताल्ला भी ईरव अदिक ईऊर देला अव दुख पोहचुसतोगव.<verse eid="REV 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20"/>मिग्द मंळसागोळ जो आ मरी देल सायली ईरोर, तान कयगोळ्द क्याल्सा देल, मन तिर्गुसदुर, कि दुष्टआत्मागोळ्द, अदिक व्हान्ना अदिक बेळ्ली अदिक पीतळा अदिक कल्ल अदिक हुळ्ली इन मूर्तीगोळ्द पुजा माळबाळुल जो ना नोळ सकताव, ना केळ सकताव, ना नळु सकताव; <verse eid="REV 9:20"/><verse number="21" style="v" sid="REV 9:21"/>अदिक जो रक्ता, अदिक जादू टोना, अदिक व्यभिचार, अदिक काळ्लपनी आंदुर माळीदुर, अदुर देल मन तिर्गुसिदिल.<verse eid="REV 9:21"/></para>
  <chapter eid="REV 9"/>
  <chapter number="10" style="c" sid="REV 10"/>
  <para style="s">स्वर्गदूत अदिक स्यांळ्द किताब</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1"/>बाक ना मात्‍त ऊंद ताकतवर स्वर्गदूत उक आकाश होच्त स्वर्ग टु ईळुत नोळदीन. आऊन ताल्ला मा मेघधनुष ईरोद. आऊन बाय सुर्य अन्द घाई अदिक आऊन कालगोळ बेक्‍की इन खंबा घाई ईरव. <verse eid="REV 10:1"/><verse number="2" style="v" sid="REV 10:2"/>आऊन कय दा ऊंद स्यांळ्दतुसा किताब तेरूकु ईरोद. आव तान ऊम्मा काल समुद्र मा अदिक डाक्या काल पृथ्वी मा ईटदुन, <verse eid="REV 10:2"/><verse number="3" style="v" sid="REV 10:3"/>अदिक हिंग धोळ्द शब्द देल चिल्ळासदुन, ह्यांग हुल्ल गरजुसतद; अदिक याग आव चिल्ळासदुन रा गर्जन इन सांगुळ शब्द केळ बंदव. <verse eid="REV 10:3"/><verse number="4" style="v" sid="REV 10:4"/>याग येळु गर्जन इनव शब्द केळकु आगेदव, रा ना लिख्सदुर मा ईरीन, लेकीन ना स्वर्ग टु ईद शब्द केळदीन, “जो मातगोळ गर्जन इन आ येळ शब्दगोळ से केळ्या अवरी गुप्त ईट, अदिक लिख्सबाळ.”<verse eid="REV 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5"/>याता स्वर्गदूत उक ना समुद्र अदिक पृथ्वी मा निदुर्त नोळीदिन, आव तान ऊम्मा कय स्वर्ग दी नेगदुन, <verse eid="REV 10:5"/><verse number="6" style="v" sid="REV 10:6"/>अदिक जो हमेशा हमेशा जित्‍ता आन, अदिक याव स्वर्ग इक अदिक जो येनारा अदुर दा आद, अदिक पृथ्वी इक अदिक जो येनारा अदुर दा आद, अदिक समुद्र अक अदिक जो येनारा अदुर दा आद सजुस्कु, अऊर्दा किर्‍या तिनकु अंदुन, “ईग रा मात्‍त समय आगतीदील. <verse eid="REV 10:6"/><verse number="7" style="v" sid="REV 10:7"/>बल्‍की सातवा स्वर्गदूत उन तुरही ऊरदुर मा जो आगव आव शब्द इन दिनगोळ दा परमेश्वर उन गुप्त मनोरथ आ खुशखबरी इन अनुसार जो आव तान दास भविष्यवक्तागोळी कोट्टुन, पुरा आदीत.”<verse eid="REV 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8"/>याता शब्द अक ना स्वर्ग टु माताळ्त केळीदीन, अद मात्‍त नान सांगुळ मात हेळली कुर्त, “होग, जो स्वर्गदूत समुद्र अदिक पृथ्वी मा निदुरकु आन, आऊन कय दाकळोद अद किताब हुडु कोम जो तेरकु आद.”<verse eid="REV 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9"/>ना स्वर्गदूत उन हात्‍ती होगकु अंदीन, “ईद स्यांळ्द किताब नानी कोळ.” आव नान से अंदुन, “हुडु, इदरी तिन कोम; ईद नीन व्हाट्टा केय रा माळीत, लेकीन नीन बाय दा सयद घाई सय हत्‍तीत.”<verse eid="REV 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 10:10"/>अत: ना अद स्यांळ्द किताब आ स्वर्गदूत उन कय दा टु हुडुकु तिंद बुटीन. अद नान बाय दा सयद घाई सय रा हत, लेकीन याग ना अदरी नुंग बुट्टीन, रा नान व्हाट्टा केयजोर आगेत. <verse eid="REV 10:10"/><verse number="11" style="v" sid="REV 10:11"/>आग नान से ईद अंदकु आत, “नीनी हापाळ सा लॉकुर, अदिक जातीगोळ, अदिक भाषागोळ अदिक राजागोळ्द बारा दा मात्‍त भविष्यवाणी माळोद बिद्दीत.”<verse eid="REV 10:11"/></para>
  <chapter eid="REV 10"/>
  <chapter number="11" style="c" sid="REV 11"/>
  <para style="s">येढ्ढ गवाह</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1"/>बाक नानी आळोर साटी ऊंद सरकंडा कोटकु आत, अदिक यारारा अंदुर, “येळ, परमेश्वर उन मंदिर अदिक वेदी, अदिक अदुर दा उपासना माळावाळेर इक आळ्द कोम. <verse eid="REV 11:1"/><verse number="2" style="v" sid="REV 11:2"/><note caller="+" style="x"><char style="xo" closed="false">११:२ </char><char style="xt" closed="false"><ref loc="LUK 21:24">लूका २१:२४</ref></char></note>लेकीन मंदिर इन व्हार्या अन्द आंगुळ बिट बुळ; अदरी आळुबाळ यतिकी अद गैरयहूदी इक कोटकु आग्याद, अदिक आंदुर पवित्र नगर इक ब्यालीस दिन ताका काल दिशी मेट्ट्यार. <verse eid="REV 11:2"/><verse number="3" style="v" sid="REV 11:3"/>ना तान येढ्ढ गवाहगोळी ईद अधिकार कोळाईन कि टाट होदुकु ऊंद हजार येढ्ढ सौ साठ दिन ताका भविष्यवाणी माळुल.<verse eid="REV 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4"/>“ईव अवा जैतुन इन येढ्ढ मार्र अदिक येढ्ढ दिंग्या ईटव जागा हुव, जो पृथ्वी इन प्रभु उन मुंद निदुरकु ईतार. <verse eid="REV 11:4"/><verse number="5" style="v" sid="REV 11:5"/>अगर यावारा आंदरी नुकसान पोहचुसोद चाहासतान, रा आंदुर बाय दा टु बेक्‍की होटकु आंदुर दुश्मनगोळी भसम माळतद; अदिक अगर यावारा आंदरी नुकसान पोहचुसोद चाहास्यान, रा जरूर ईत्‍ता रीति देल कोन्सुसकु आदान. <verse eid="REV 11:5"/><verse number="6" style="v" sid="REV 11:6"/>आंदरी अधिकार आद कि आकाश इक बंद माळुल, कि आंदुर्द भविष्यवाणी इन दिनगोळ दा सयद बरसुसबाळुल; अदिक आंदरी सप्पा नीरनळी मा अधिकार आद कि अदरी रक्ता माळुल, अदिक याग याग चाहास्यार आग आग पृथ्वी मा हर प्रकार इंद विपत्‍ती तरूल.”<verse eid="REV 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">११:७ </char>
      <char style="xt" closed="false">
        <ref loc="REV 13:5-7">प्रकाशितवाक्य १३:५-७</ref>; <ref loc="REV 17:8">१७:८</ref></char>
    </note>याग आंदुर्द गवाही कोटकु आगेदीत, रा अद पशु जो अथाह अधोलोक दा टु होट्टीत, आंदुर से लळाई माळकु अवरी जीतुसित अदिक आंदरी कोंद बुट्टीत. <verse eid="REV 11:7"/><verse number="8" style="v" sid="REV 11:8"/>आंदुर लाश आ धोळ्द नगर इन चौक दा बिदकु ईत्‍ताव, यदरी आत्मिक रूप देल सदोम अदिक मिस्त्र अंदकु आगतद, यल आंदुर प्रभु भी क्रूस मा येर्सकु आगिदुन. <verse eid="REV 11:8"/><verse number="9" style="v" sid="REV 11:9"/>सप्पा लॉकुर अदिक कुलगोळ अदिक भाषागोळ अदिक जातीगोळ्द लॉकुर आंदुर मुर्दागोळी इक साढ़े मुर दिन ताका नोळतेला ईत्‍तार, अदिक आंदुर मुर्दागोळ इक कब्र दा ईट कोळतीदील. <verse eid="REV 11:9"/><verse number="10" style="v" sid="REV 11:10"/>धरती मा ईरावाळेर आंदुर सोत्‍तुर देल खुश अदिक मग्न आदार, अदिक आबुर दाबुर हात्‍ती भेंट कळ्यार, यतिकी ई दिनगोळ दा भविष्यवक्तागोळ धरती मा ईरावाळेर इक सतुस्यार. <verse eid="REV 11:10"/><verse number="11" style="v" sid="REV 11:11"/>लेकीन साढ़े मुर दिन इन बाद्दा परमेश्वर उन दी टु जीवन इन श्वास आंदुर दा होक्त, अदिक आंदुर तान कालगोळ ताकत देल निदरेदुर, अदिक आंदुर नोळावाळेर मा धोळ्द अंज्क तुम्मेत. <verse eid="REV 11:11"/><verse number="12" style="v" sid="REV 11:12"/>आग आंदरी स्वर्ग टु ऊंद धोळ्द शब्द केळ बत्‍त, “ईल म्याकुच बरी!” ईद केळकु आंदुर बादल मा सवार आगकु तान दुश्मनगोळ नोळतेला अच स्वर्ग मा येरेदुर. <verse eid="REV 11:12"/><verse number="13" style="v" sid="REV 11:13"/><note caller="+" style="x"><char style="xo" closed="false">११:१३ </char><char style="xt" closed="false"><ref loc="REV 6:12">प्रकाशितवाक्य ६:१२</ref>; <ref loc="REV 16:18">१६:१८</ref></char></note>बाक आ घळी ऊंद धोळ्द भूकम्प आत, अदिक नगर इन दहावा भाग बिदोत; अदिक आ भूकम्प देल येळ हजार मंळसागोळ सोतोदुर, अदिक बाकी नोर जो ऊळ्दकु ईरोर आंदुर अंजेदुर अदिक स्वर्ग इन परमेश्वर उन महिमा माळली कुरतुर.<verse eid="REV 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14"/>दुसरा परेशानी बितसेत; नोळी, तिसरा परेशानी जल्दी बरावाळा आद.<verse eid="REV 11:14"/></para>
  <para style="s">सातवा दूत उन द्वारा तुरही ऊरकु आत</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15"/>याग सातवा स्वर्गदूत तुरही ऊरदुन, रा स्वर्ग दा ई बारा दा धोड्डेव-धोड्डेव शब्द आगली कुरतव: “दुनिया अन राज्य नामव प्रभु उन अदिक आऊन मसीह अन्द आगेत, अदिक आव हमेशा हमेशा राज्य माळ्यान.” <verse eid="REV 11:15"/><verse number="16" style="v" sid="REV 11:16"/>आग चौबीसा स्याणा लॉकुर जो परमेश्वर उन मुंद तान तान सिंहासन मा कुर्तकु ईरोर, बाय इन भार देल बिदकु परमेश्वर उक प्रणाम माळकु <verse eid="REV 11:16"/><verse number="17" style="v" sid="REV 11:17"/>ईद अनली कुरतुर,</para>
  <para style="q1" vid="REV 11:17">“हे सर्वशक्तिमान प्रभु परमेश्वर, जो आन अदिक जो ईरोन,</para>
  <para style="q1" vid="REV 11:17">नाव नीन धन्यवाद माळतेव कि नी तान धोळ्द सामर्थ्य</para>
  <para style="q2" vid="REV 11:17">इक क्याल्सा दा तनकु राज्य माळ्या.<verse eid="REV 11:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18"/>अन्य जातीगोळ सिट्ट दा तुमकु ईरोर,</para>
  <para style="q2" vid="REV 11:18">लेकीन नींद प्रकोप बंदकु बित्‍त,</para>
  <para style="q2" vid="REV 11:18">अदिक अद समय बंदाद कि जो सोत्‍तुर आंदुर्द न्याय माळकु आगुल,</para>
  <para style="q1" vid="REV 11:18">अदिक नीनोर दास परमेश्वर उन बातणी केळसावाळेर</para>
  <para style="q2" vid="REV 11:18">अदिक पवित्र लॉकुरी अदिक आ स्याण धोड्डेर इक जो नींद हेसुर देल अंजतार</para>
  <para style="q2" vid="REV 11:18">बदलुस्कु आगुल,</para>
  <para style="q1" vid="REV 11:18">अदिक पृथ्वी इक बिगळुसा वाळेर इक नष्ट माळकु आगुल.”<verse eid="REV 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">११:१९ </char>
      <char style="xt" closed="false">
        <ref loc="REV 8:5">प्रकाशितवाक्य ८:५</ref>; <ref loc="REV 16:18">१६:१८</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="REV 16:21">प्रकाशितवाक्य १६:२१</ref>
      </char>
    </note>आग परमेश्वर उन जो मंदिर स्वर्ग दा आद अद तेरकु आत, अदिक आऊन मंदिर दा आऊंदा वाचा अन्द संदुक कांळ्सत; अदिक बिजलीगोळ अदिक शब्द अदिक गर्जन अदिक भूकम्प आदव अदिक धोड्डेव ओला बिद्दव.<verse eid="REV 11:19"/></para>
  <chapter eid="REV 11"/>
  <chapter number="12" style="c" sid="REV 12"/>
  <para style="s">आर्त अदिक अजगर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1"/>बाक स्वर्ग दा ऊंद धोळ्द चिन्ह कांळ्सत, मतलब ऊंद आर्त जो सुर्य होदुकु ईरोर, अदिक बेळदिंग आकिन काल दिशी ईरोद, अदिक आकिन ताल्ला मा हन्नेळ तारागोळ्द मुकुट ईरोद. <verse eid="REV 12:1"/><verse number="2" style="v" sid="REV 12:2"/>आक व्हाट्या दी आदुर, अदिक किटरोर, यतिकी आक प्रसव इन दुख दा ईरोर.<verse eid="REV 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 12:3"/>ऊंद अदिक चिन्ह स्वर्ग दा कांळ्सत; अदिक नोळी, ऊंद धोळ्द क्याचांद अजगर ईरोद, अदरी येळ ताल्ला अदिक हत्‍त गॉट्टा ईरव, अदिक अदुर्द ताल्ला मा येळ राजमुकुट ईरव. <verse eid="REV 12:3"/><verse number="4" style="v" sid="REV 12:4"/>अदुर पुसटी आकाश इन तारा अन्द ऊंद तिहाई इक जेडुकु पृथ्वी मा हाक कोम्त. अद अजगर येनारा ईरोर आ आर्त इन मुंद ईरोद, निदुर्त कि याग आक चिग्द हाळदार रा आ चिग्द उक नुंग कोमुल. <verse eid="REV 12:4"/><verse number="5" style="v" sid="REV 12:5"/>आक पार हाळदुर जो लोवा अन्द छळी इक ताकोमकु सप्पा जातीगोळ मा राज्य अन्द साटी बंदीदुन, अदिक आव पार एकाएक परमेश्वर उन हात्‍ती अदिक आऊन सिंहासन इन हात्‍ती नेगुकु पोहचुस्कु आदुन; <verse eid="REV 12:5"/><verse number="6" style="v" sid="REV 12:6"/>अदिक आ आर्त आ आळी दा ओळतेला होदुर यल परमेश्वर उन दी टु आकिन साटी ऊंद जागा तयार माळकु आगीत कि अल आक ऊंद हजार येढ्ढ सौ साठ दिन ताका सालकु आगुल.<verse eid="REV 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१२:७ </char>
      <char style="xt" closed="false">
        <ref loc="JUD 1:9">यहूदा १:९</ref>
      </char>
    </note>बाक स्वर्ग दा लळाई आत, मीकाईल अदिक आऊन स्वर्गदूत अजगर इन सांगुळ लळाई माळली होट्टुर; अदिक अजगर अदिक अदुर दूत आऊन सांगुळ लळुसदव. <verse eid="REV 12:7"/><verse number="8" style="v" sid="REV 12:8"/>लेकीन प्रबल आगीदील, अदिक स्वर्ग दा आंदुर साटी बाक जागा ईतीदील. <verse eid="REV 12:8"/><verse number="9" style="v" sid="REV 12:9"/><note caller="+" style="x"><char style="xo" closed="false">१२:९ </char><char style="xt" closed="false"><ref loc="LUK 10:18">लूका १०:१८</ref></char></note>आग अद धोळ्द अजगर, मतलब अदा हाळोद हाव जो इब्लीस अदिक शैतान कहलुसतद अदिक पुरा दुनिया अक भरमुसावाळा हुन, पृथ्वी मा केळसुस्कु आत, अदिक अदुर दूत अदुर सांगुळ केळसुस्कु आदव. <verse eid="REV 12:9"/><verse number="10" style="v" sid="REV 12:10"/>बाक ना स्वर्ग टु ईद धोळ्द शब्द बरतेला केळदीन,</para>
  <para style="q2" vid="REV 12:10">“ईग नाम परमेश्वर उन उद्धार अदिक सामर्थ्य</para>
  <para style="q2" vid="REV 12:10">अदिक राज्य</para>
  <para style="q1" vid="REV 12:10">अदिक आऊन मसीह अन्द अधिकार प्रगट आग्याद,</para>
  <para style="q2" vid="REV 12:10">यतिकी नाम वार्टुर मा दोष हचावाळा,</para>
  <para style="q1" vid="REV 12:10">जो ईळ्लक हागुल नाम परमेश्वर उन मुंद</para>
  <para style="q2" vid="REV 12:10">आंदुर मा दोष हचतोगोन केळसुस्कु आदुन.”<verse eid="REV 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 12:11"/>“आंदुर म्यांडा अन्द पाड्डा अन कारण</para>
  <para style="q2" vid="REV 12:11">अदिक तान गवाही इन वचन इन कारण</para>
  <para style="q1" vid="REV 12:11">आऊन मा जयवन्त आदुर,</para>
  <para style="q2" vid="REV 12:11">अदिक आंदुर तान जीव इक प्रिय जानसीदिल,</para>
  <para style="q2" vid="REV 12:11">ईल ताका कि मृत्यु भी सहन माळ कोंडुर.”<verse eid="REV 12:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="REV 12:12"/>“ई कारण हे स्वर्गगोळा अदिक अदुर्दा ईरावाळेरा,</para>
  <para style="q2" vid="REV 12:12">मग्न ईरी; हे पृथ्वी, अदिक समुद्र, नीम मा हाय!</para>
  <para style="q1" vid="REV 12:12">यतिकी शैतान बळा सिट्ट इन सांगुळ नीम हात्‍ती ईळुकु बंदुन,</para>
  <para style="q2" vid="REV 12:12">यतिकी जान्सत्या कि थ्वाळासा अच समय अदिक बाकी आद.”<verse eid="REV 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13"/>याग अजगर नोळ्त कि ना पृथ्वी मा केडुकु आगेदीन, रा आ आर्त इक जो पार हाळीदुर, सतुस्त. <verse eid="REV 12:13"/><verse number="14" style="v" sid="REV 12:14"/>लेकीन आ आर्त इक धोळ गीधाळ इन येढ्ढ पिक्‍का कोटकु आगीदव कि हाव उन मुंद टु ऊळुसकु आळी दा आ जागा दा होटोगुल, यल अद ऊंद समय अदिक समयगोळ, अदिक आर्धा समय ताका पालस्कु आगुल. <verse eid="REV 12:14"/><verse number="15" style="v" sid="REV 12:15"/>अदिक हाव आ आर्त इन हिंद तान बाय देल गांगा अन्द घाई नीर वाहुस्त कि आकी ई गांगा देल वाहुस बुळुल. <verse eid="REV 12:15"/><verse number="16" style="v" sid="REV 12:16"/>लेकीन पृथ्वी आ आर्त इन सहायता माळ्त, अदिक तान बाय खोल्सकु आ गांगा अक जो अजगर तान बाय देल वाहुसीदुन कळुत. <verse eid="REV 12:16"/><verse number="17" style="v" sid="REV 12:17"/>आग अजगर आर्त मा गुस्सा आत्त, अदिक आकिन बाकी नव चिकोर देल, जो परमेश्वर उन आग्यागोळ इक मानसोर अदिक यीशु उन गवाही कोळदुर मा स्थिर आर, लळाई माळली होत्त. <verse eid="REV 12:17"/><verse number="18" style="v" sid="REV 12:18"/>अदिक अद समुद्र अन्द धुळा मा होगकु नीदुरकु ईत्त.<verse eid="REV 12:18"/></para>
  <chapter eid="REV 12"/>
  <chapter number="13" style="c" sid="REV 13"/>
  <para style="s">येढ्ढ पशु</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१३:१ </char>
      <char style="xt" closed="false">
        <ref loc="REV 17:3">प्रकाशितवाक्य १७:३</ref>,<ref loc="REV 17:7-12">७-१२</ref></char>
    </note>आग ना ऊंद पशु उक समुद्र दा टु होळ्त नोळदीन, यदुर्द हत्‍त गॉट्टा अदिक येळ ताल्ला ईरव. अदुर गॉट्टागोळ मा हत्‍त राजमुकुट अदिक अदुर ताल्लागोळ मा परमेश्वर उन निन्दा नव हेसुर लिख्सकु ईरव. <verse eid="REV 13:1"/><verse number="2" style="v" sid="REV 13:2"/>जो पशु ना नोळदीन अद चिता अन्द घाई ईरोद; अदिक अदुर कालगोळ भालू घाई, अदिक बाय हुल्ली इन घाई ईरोद. अद अजगर तान सामर्थ्य अदिक तान सिंहासन अदिक धोळ्द अधिकार अदरी कोट बुळ्त. <verse eid="REV 13:2"/><verse number="3" style="v" sid="REV 13:3"/>ना अऊर्द ताल्लागोळ दा टु ऊंद मा हिंग भयंकर घाव हतकु नोळदीन कि हिंग हतुल कि अद सायदुर मा आद, बाक अदुर्द प्राणघातक घाव वळ्लीद आगेत, अदिक सप्पा धरती इन लॉकुर आ पशु उन हिंद-हिंद अचम्भा माळतेला नळदुर. <verse eid="REV 13:3"/><verse number="4" style="v" sid="REV 13:4"/>लॉकुर अजगर इन पुजा माळदुर, यतिकी अद पशु उक तान अधिकार कोट बुटीत, अदिक ईद अनकु पशु उन पुजा माळदुर, “ई पशु उन घाई याव आन? याव ईदुर से लळाई माळ सकतान?”<verse eid="REV 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5"/>बळा बोल माताळली अदिक अपमान माळोर साटी अदरी ऊंद बाय कोटकु आग्याद, अदिक अदरी ब्यालीस तिंगुळ ताका क्याल्सा माळोद अधिकार कोटकु आग्याद. <verse eid="REV 13:5"/><verse number="6" style="v" sid="REV 13:6"/>आव परमेश्वर उन अपमान माळोर साटी बाय तेरदुन कि आऊन हेसुर अदिक आऊन तम्बू मतलब स्वर्ग इन ईरावाळेर इन अपमान माळुल. <verse eid="REV 13:6"/><verse number="7" style="v" sid="REV 13:7"/>आऊक ईद भी अधिकार कोटकु आग्याद कि पवित्र लॉकुर सांगुळ लळाई माळुल अदिक आंदुर मा जय सिकुल, अदिक आऊक हर ऊंद कुल अदिक लॉकुर अदिक भाषा अदिक जाती मा अधिकार कोटकु आग्याद. <verse eid="REV 13:7"/><verse number="8" style="v" sid="REV 13:8"/>धरती मा ईरावाळेर आंदुर सप्पा, यार हेसुर आ म्यांडा अन्द पाड्डा अन्द जीवन इन किताब दा लिख्सकु आगीदील जो दुनिया अन उत्पत्ति इन समय टु घात आग्याद, आ पशु उन पुजा माळ्यार.<verse eid="REV 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9"/>यार किव आव आव केळुल. <verse eid="REV 13:9"/><verse number="10" style="v" sid="REV 13:10"/>यारी कैद दा बिळोद आद, आव कैद दा बिद्दान; जो तलवार देल कोंदान, जरूरी आद कि आव तलवार देल कोंदकु आदान. पवित्र लॉकुर्द धीरज अदिक विश्वास ईदुर दा आद.<verse eid="REV 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11"/>बाक ना ऊंद अदिक पशु उक पृथ्वी दा टु होळतेला नोळदिन, अदुर्द म्यांडा अन्द पाड्डा अन्द घाई येढ्ढ गॉट्टा ईरव, अदिक अद अजगर इन घाई माताळोद. <verse eid="REV 13:11"/><verse number="12" style="v" sid="REV 13:12"/>अद आ पयला पशु उन पुरा अधिकार अदुर मुंद क्याल्सा दा तरोद; अदिक पृथ्वी अदिक अदुर्द ईरावाळेर देल आ पयला पशु उन, यदुर्द जीव घातक घाव वळ्लीद आगेगीत, पुजा माळसुसोद. <verse eid="REV 13:12"/><verse number="13" style="v" sid="REV 13:13"/>अद धोळ-धोळ चिन्ह तोर्सोन, ईल ताका कि मंळसागोळ्द मुंद स्वर्ग टु पृथ्वी मा बेक्‍की बरसुस बुळोन. <verse eid="REV 13:13"/><verse number="14" style="v" sid="REV 13:14"/>आ चिन्हगोळ्द कारण, यारी आ पशु उन मुंद तोरसोद अधिकार अदरी कोटकु आगीत, अद पृथ्वी इन ईरावाळेर इक भरमुसोद अदिक पृथ्वी इन ईरावाळेर देल अनोद कि या पशु उक तलवार हतीत अद जित्‍ता आग्याद, अदुर्द मूर्ति माळी. <verse eid="REV 13:14"/><verse number="15" style="v" sid="REV 13:15"/>अदरी आ पशु उन मूर्ति दा जीव हाक्कोद अधिकार कोटकु आग्याद कि पशु उन मूर्ति माताळली हतुल, अदिक यास लॉकुर आ पशु उन मूर्ति इन पुजा माळतीदील, आंदरी कोन्सुस बुळुल. <verse eid="REV 13:15"/><verse number="16" style="v" sid="REV 13:16"/>आव स्यांळ्द-धोळ, धनी-कंगाल, स्वतंत्र-दास सप्पा मुंदुर ऊम्मा कय दी या आंदुर मस्तक मा ऊंद ऊंद छाप माळ बुट्टुन, <verse eid="REV 13:16"/><verse number="17" style="v" sid="REV 13:17"/>कि अदरी बिटकु याऊन मा छाप मतलब आ पशु उन हेसुर या अदुर हेसुर इन अंक ईरूल, दुसरा यावारा लेन-देन माळ ईला सकुल.<verse eid="REV 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18"/>ग्यान ईदुर दा आद: यारी बुद्धी आद आव ई पशु उन अंक जोळ्स कोमुल, यतिकी अद मंळसा अन्द अंक हुन, अदिक अदुर अंक आर सौ छैसठ आद.<verse eid="REV 13:18"/></para>
  <chapter eid="REV 13"/>
  <chapter number="14" style="c" sid="REV 14"/>
  <para style="s">मेमना अदिक अदुर लॉकुर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१४:१ </char>
      <char style="xt" closed="false">
        <ref loc="REV 7:3">प्रकाशितवाक्य ७:३</ref>
      </char>
    </note>बाक ना नजर माळदीन, अदिक नोळी, आ म्यांडा अन्द पाड्डा सिय्योन पहाळ मा नीदुरकु आद, अदिक अदुर सांगुळ ऊंद लाख चौवालीस हजार मुंदुर आर, यार ह्याणा मा आऊन अदिक आऊन आप्प उन हेसुर लिख्सकु आद. <verse eid="REV 14:1"/><verse number="2" style="v" sid="REV 14:2"/>अदिक स्वर्ग टु नानी ऊंद हिंग शब्द केळ बत्‍त जो नीर इन हापाळ धारागोळ अदिक बळा गर्जन इन शब्द ईरोद, अदिक जो शब्द ना केळदीन अद हिंग ईरोद मान्सी वीणा मुरसावाळेर वीणा मुरसेत्यार. <verse eid="REV 14:2"/><verse number="3" style="v" sid="REV 14:3"/>आंदुर सिंहासन इन मुंद अदिक नाकु प्राणीगोळ अदिक स्याणागोळ्द मुंद ऊंद व्हाशोद हाळ हाळोर. आ ऊंद लाख चौवालीस हजार लॉकुरी बिटकु, जो पृथ्वी मा टु कोंडकु आगीदुर, यारू आ हाळ इक कलु ईला सकोर. <verse eid="REV 14:3"/><verse number="4" style="v" sid="REV 14:4"/>इंदुर आंदुर उर जो आर्तेर सांगुळ अशुध्द आगीदील, पर कुवारा आर; इंदुर आंदुरा उर कि येल्यारा म्यांडा अन्द पाड्डा होगतद, अऊर आऊन हिंद आगेगतार; इंदुर रा परमेश्वर उन निमित्त पयला फल आगोर साटी मंळसागोळ दा टु कोंडकु आग्यार. <verse eid="REV 14:4"/><verse number="5" style="v" sid="REV 14:5"/>आंदुर बाय दा टु यागलु ख्वाटा मात होटीदिल, आंदुर निर्दोष आर.<verse eid="REV 14:5"/></para>
  <para style="s">मुर स्वर्गदूत</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6"/>बाक ना ऊंद अदिक स्वर्गदूत उक आकाश इन न्याड्या दा उळुसतेला नोळदीन, यार हात्‍ती पृथ्वी माकळोर ईरावाळेर्द हर ऊंद जाती, अदिक कुल, अदिक भाषा, अदिक लॉकुरी केळसोर साटी अनन्त खुशखबरी ईरव. <verse eid="REV 14:6"/><verse number="7" style="v" sid="REV 14:7"/>स्वर्गदूत धोळ शब्द देल अंदुन, “परमेश्वर से अंजी, अदिक आऊन महिमा माळी, यतिकी आऊन न्याय माळोद समय होट बंदाद; अदिक आऊन भजन माळी, याव स्वर्ग अदिक पृथ्वी अदिक समुद्र अदिक नीर इन झरना माळ्यान.”<verse eid="REV 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१४:८ </char>
      <char style="xt" closed="false">
        <ref loc="REV 18:2">प्रकाशितवाक्य १८:२</ref>
      </char>
    </note>बाक इदुर बाद्दा ऊंद मात्‍त, दुसरा, स्वर्गदूत ईद अनतेला बंदुन, “बित्त, आ धोळ बेबीलोन बित्त, यार तान व्यभिचार इन कोपमय सारा पुरा जातीगोळी इक कुळस्याद.”<verse eid="REV 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9"/>बाक इंदुर बाद्दा ऊंद मात्‍त, तीसरा, स्वर्गदूत धोळ शब्द देल ईद अनतेला बंदुन, “जो यावारा आ पशु अदिक अदुर्द मूर्ति इन पुजा माळुल, अदिक तान ह्याणा या तान कय मा अदुर्द छाप ताकोमुल <verse eid="REV 14:9"/><verse number="10" style="v" sid="REV 14:10"/>अद परमेश्वर उन प्रकोप इन निरी सारा, जो आऊन सिट्ट इन कटोरा दा हाक्‍कु आग्याद, कुळदान अदिक पवित्र स्वर्गदूतगोळ्द मुंद अदिक म्यांडा अन्द पाड्डा अन्द मुंद बेक्‍की अदिक गन्धक इन पीळा दा बिद्दान. <verse eid="REV 14:10"/><verse number="11" style="v" sid="REV 14:11"/>आदुर्द पीळा अन्द धुंगा हमेशा हमेशा येळतेला ईत्‍तीत, अदिक जो आ पशु अदिक अदुर्द मूर्ति इन पुजा माळतार, अदिक जो अदुर हेसुर इन छाप ताकोमतार, आंदरी ईळ्लक हागुल चैन सिकतीदील.”<verse eid="REV 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 14:12"/>पवित्र लॉकुर्द धीरज इदुर दा आद, जो परमेश्वर उन आग्यागोळ इक मान्सतार अदिक यीशु मा विश्वास ईटतार.<verse eid="REV 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13"/>बाक ना स्वर्ग टु ईद शब्द केळदीन, “कि लिख्स: जो मुर्दा प्रभु दा सायतान, आंदुर ईग टु धन्य आर.”</para>
  <para style="p" vid="REV 14:13">आत्मा अनतद, “हव, यतिकी आंदुर तान पुरा मेहनत देल आराम ताकोंडार, अदिक आंदुर कार्य आंदुर सांगुळ ईत्‍ताव.”<verse eid="REV 14:13"/></para>
  <para style="s">कटाई</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14"/>ना दृष्टी माळदीन, अदिक नोळी, नान मुंद ऊंद बिळीद ढग आद, अदिक आ ढग मा मंळसा अन पार उन घाई यावारा कुर्तकु आन, आऊन ताल्ला मा व्हान्ना अन्द मुकुट अदिक कय दा पन्यार कुळगुल आद. <verse eid="REV 14:14"/><verse number="15" style="v" sid="REV 14:15"/>बाक ऊंद अदिक स्वर्गदूत मंदिर दा टु होटकु आऊन से, जो ढग मा कुर्तकु ईरोन, धोळ शब्द देल कारूकु अंदुन, “तान कुळगुल हचकु कटाई माळ, यतिकी कटाई इन समय होट बंदान, इदुरसाटी कि पृथ्वी इन केई इन फसल हण्ण आगेग्याद.” <verse eid="REV 14:15"/><verse number="16" style="v" sid="REV 14:16"/>इदुरसाटी जो ढग मा कुर्तकु ईरोन आव पृथ्वी मा तान कुळगुल हचदुन, अदिक पृथ्वी इन केई इन कटाई माळदुन.<verse eid="REV 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17"/>बाक ऊंद अदिक स्वर्गदूत आ मंदिर दा टु होट्टुन जो स्वर्ग दा आन, अदिक आऊन हात्‍ती भी पन्यार कुळगुल ईरोद.<verse eid="REV 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 14:18"/>बाक ऊंद अदिक स्वर्गदूत, यारी बेक्‍की मा अधिकार ईरोद, वेदी दा टु होट्टुन, अदिक यार हात्‍ती पन्यार कुळगुल ईरोद आऊन से धोळ शब्द देल अंदुन, “तान पन्यार कुळगुल हचकु पृथ्वी इन अंगुर इन केई इन काय इन गुच्छा कडुकोम, यतिकी अद अंगुर इन काय हण्ण आगेग्याद.” <verse eid="REV 14:18"/><verse number="19" style="v" sid="REV 14:19"/>आग आ स्वर्गदूत पृथ्वी मा तान कुळगुल हचदुन अदिक पृथ्वी इन अंगुर इन गुच्छा अन्द काय कडुकु तान परमेश्वर उन प्रकोप इन धोळ रसकुण्ड दा हाक्‍क बुट्टुन; <verse eid="REV 14:19"/><verse number="20" style="v" sid="REV 14:20"/><note caller="+" style="x"><char style="xo" closed="false">१४:२० </char><char style="xt" closed="false"><ref loc="REV 19:15">प्रकाशितवाक्य १९:१५</ref></char></note>अदिक नगर इन व्हार्या आ रसकुण्ड दा अंगुर मेटकु आदव, अदिक रसकुण्ड दा टु ईट रक्ता होळ्त कि घ्वाळा अन्द लगामगोळ ताका पहुचुस्त, अदिक मुर सौ किलोमीटर ताका वाहुसेत.<verse eid="REV 14:20"/></para>
  <chapter eid="REV 14"/>
  <chapter number="15" style="c" sid="REV 15"/>
  <para style="s">आखरी परेशानीगोळ सांगुळ स्वर्गदूत</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1"/>बाक ना स्वर्ग दा ऊंद अदिक धोळ अदिक अदभुत चिन्ह नोळदीन, मतलब येळ स्वर्गदूत यार हात्‍ती येळु आखरी परेशानीगोळ ईरव, यतिकी अदुर खतम आगदुर मा परमेश्वर उन प्रकोप इन अन्त आद.<verse eid="REV 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 15:2"/>आग ना बेक्‍की दा मिलुसकु काँच इन घाई ऊंद समुद्र नोळदीन; अदिक जो लॉकुर आ पशु मा अदिक अदुर्द मूर्ति मा अदिक अदुर हेसुर इन अंक मा जयवन्त आगीदुर, आंदरी आ काँच इन समुद्र अन्द हात्‍ती परमेश्वर उन वीणागोळ इक हुळकु नीदुरकु नोळदुर. <verse eid="REV 15:2"/><verse number="3" style="v" sid="REV 15:3"/>आंदुर परमेश्वर उन दास मूसा अन्द हाळ, अदिक म्यांडा अन्द पाड्डा अन्द हाळ, हाळ हाळकु अनतोगोर,</para>
  <para style="q1" vid="REV 15:3">“हे सर्वशक्तिमान प्रभु परमेश्वर,</para>
  <para style="q2" vid="REV 15:3">नीन कार्य महान अदिक अदभुत आव;</para>
  <para style="q1" vid="REV 15:3">हे युगयुग इन राजा,</para>
  <para style="q2" vid="REV 15:3">नीन चाल वळ्लीद अदिक खरा आद.”<verse eid="REV 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4"/>“हे प्रभु, याव नीन से अंजतीदील</para>
  <para style="q2" vid="REV 15:4">अदिक नीन हेसुर इन महिमा माळतीदील?</para>
  <para style="q2" vid="REV 15:4">यतिकी सिर्फ नी आबना अच पवित्र आय.</para>
  <para style="q1" vid="REV 15:4">पुरा द्याश इन लॉकुर बंदकु</para>
  <para style="q2" vid="REV 15:4">नीन मुंद दण्डवत माळ्यार,</para>
  <para style="q2" vid="REV 15:4">यतिकी नीन न्याय इन क्याल्सा प्रगट आगेग्याव.”<verse eid="REV 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5"/>इदुर बाद्दा ना नोळदीन कि स्वर्ग दा गवाही इन तम्बू उन मंदिर खोल्सकु आग्याद; <verse eid="REV 15:5"/><verse number="6" style="v" sid="REV 15:6"/>अदिक आंदुर येळु स्वर्गदूत यार हात्‍ती येळु परेशानीगोळ ईरव, मलमल इन शुद्ध अदिक चमकदार कपळा हाक्‍कु अदिक याद्दा मा व्हान्ना अन्द पट्टागोळ कटकु मंदिर टु होट्टुर. <verse eid="REV 15:6"/><verse number="7" style="v" sid="REV 15:7"/>आग आ नाकु प्राणीगोळ दा टु ऊंद आ येळ स्वर्गदूतगोळी परमेश्वर, जो हमेशा हमेशा जित्‍ता आन, आऊन प्रकोप देल तुमकु व्हान्ना अन्द येळ कटोरा कोट्टुर; <verse eid="REV 15:7"/><verse number="8" style="v" sid="REV 15:8"/>अदिक परमेश्वर उन महिमा अदिक आऊन सामर्थ्य अन कारण मंदिर धुंगा देल तुम्मेत, अदिक यागासताका आ येळु स्वर्गदूतगोळ्द येळु परेशानीगोळ खतम आगीदील आगासताका याऊ मंदिर दा होग सकिदील.<verse eid="REV 15:8"/></para>
  <chapter eid="REV 15"/>
  <chapter number="16" style="c" sid="REV 16"/>
  <para style="s">परमेश्वर उन प्रकोप इन येळ कटोरा</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1"/>बाक ना मंदिर दा यारीकारा ऊँचा शब्द देल आ येळु स्वर्गदूतगोळ देल ईद अनतेला केळदिन, “होगी, परमेश्वर उन प्रकोप इन येळु कटोरागोळ इक पृथ्वी मा पलटुस बुळी.”<verse eid="REV 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2"/>इदुरसाटी पयले स्वर्गदूत होगकु तान कटोरा पृथ्वी मा पलटुस बुट्टुन. आग आ मंळसागोळ्द, यार मा पशु उन छाप ईरव अदिक जो अदुर्द मूर्ति इन पुजा माळोर, ऊंद प्रकार इन बुरा अदिक दुखदाई फ्वाळा होळ्त.<verse eid="REV 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3"/>दुसरा स्वर्गदूत तान कटोरा समुद्र मा उलटुस बुट्टुन, अदिक आव सोतकु मंळसा अन्द रक्ता घाई बन्सेदुन, अदिक समुद्र दाकळव हर ऊंद जीवधारी सोतोदव.<verse eid="REV 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4"/>तीसरा स्वर्गदूत तान कटोरा गांगागोळ अदिक नीर इन झरनागोळ मा पलटुस बुट्टुन, अदिक आंदुर रक्ता बन्सदुर. <verse eid="REV 16:4"/><verse number="5" style="v" sid="REV 16:5"/>आग ना नीर इन स्वर्गदूत उक ईद अनतेला केळदीन, “हे पवित्र, जो आद अदिक जो ईरोद, नी न्यायी आय अदिक नी ईद न्याय माळ्द. <verse eid="REV 16:5"/><verse number="6" style="v" sid="REV 16:6"/>यतिकी आंदुर पवित्र लॉकुर अदिक भविष्यवक्तागोळ्द रक्ता वाहुसीदुर, अदिक नी आंदरी रक्ता कुळ्सद; यतिकी आंदुर ईदा योग्य आर.” <verse eid="REV 16:6"/><verse number="7" style="v" sid="REV 16:7"/>बाक ना वेदी टु ईद शब्द केळदीन, “हव, हे सर्वशक्तिमान प्रभु परमेश्वर, नीन निर्णय वळ्लीद अदिक खरा आद.”<verse eid="REV 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8"/>चौथा स्वर्गदूत तान कटोरा सुर्य मा उलटुस बुट्टुन, अदिक आऊक मंळसागोळ इक बेक्‍की देल झुलसुसोद अधिकार कोटकु आत. <verse eid="REV 16:8"/><verse number="9" style="v" sid="REV 16:9"/>मंळसा हापाळ बिसुल देल झुलसुसदुर, अदिक परमेश्वर उन हेसुर इन यारी ई परेशानीगोळ मा अधिकार आद, अपमान माळदुन लेकीन आऊन महिमा माळोर साटी मन तिर्गुसिदील. आऊन महानता अन्द प्रशंसा माळतार.<verse eid="REV 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10"/>पाचवा स्वर्गदूत तान कटोरा आ पशु उन सिंहासन मा पलटुस बुट्टुन, अदिक आऊन राज्य मा अंधार छासेत. लॉकुर दुख इन मारा तान तान ल्यालग्या कचली हतदुर, <verse eid="REV 16:10"/><verse number="11" style="v" sid="REV 16:11"/>अदिक तान पीळागोळ अदिक फ्वाळागोळ्द कारण स्वर्ग इन परमेश्वर उन अपमान माळदुर; लेकीन तान तान क्याल्सागोळ देल मन तिर्गुसिदील.<verse eid="REV 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12"/>सहावा स्वर्गदूत तान कटोरा महागांगा फुरात मा पलटुस बुट्टुन, अदिक अदुर्द नीर वंळगेत कि पूर्व दिशा अन्द राजागोळ्द साटी हादी तयार आगेगुल. <verse eid="REV 16:12"/><verse number="13" style="v" sid="REV 16:13"/>बाक ना आ अजगर इन बाय देल, अदिक आ पशु उन बाय देल अदिक आ ख्वाटा भविष्यवक्ता अन्द बाय देल मुर अशुध्द आत्मागोळ इक भ्याबकागोळ्द रूप दा होळतेला नोळदिन. <verse eid="REV 16:13"/><verse number="14" style="v" sid="REV 16:14"/>ईव चिन्ह तोर्सावाळेर दुष्टआत्मागोळ हुव, जो पुरा दुनिया अन राजागोळ्द हात्‍ती होटकु इदुरसाटी होगताव कि आंदरी सर्वशक्तिमान परमेश्वर उन आ धोळ दिन इन लळाई इन साटी जमा माळुल.<verse eid="REV 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 16:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१६:१५ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:43">मत्ती २४:४३</ref>,<ref loc="MAT 24:44">४४</ref>; <ref loc="LUK 12:39">लूका १२:३९</ref>,<ref loc="LUK 12:40">४०</ref>; <ref loc="REV 3:3">प्रकाशितवाक्य ३:३</ref></char>
    </note>“नोळ, ना काळ्ल उन घाई बरतीन; धन्य आव आन जो जागस्तेला ईरतान, अदिक तान कपळागोळ्द सावधानी माळतान कि ऊगळा वयाळबाळुल, अदिक लॉकुर आऊन ऊगळापन नोळबाळुल.”<verse eid="REV 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16"/>अदिक आंदुर आंदरी आ जागा दा जमा माळदुर जो इब्रानी दा हर-मगिदोन कहलुसतद.<verse eid="REV 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17"/>सातवा स्वर्गदूत तान कटोरा हवा मा उलटुसदुन, अदिक मंदिर इन सिंहासन टु ईद धोळ शब्द आत, “आगेग्याद!” <verse eid="REV 16:17"/><verse number="18" style="v" sid="REV 16:18"/><note caller="+" style="x"><char style="xo" closed="false">१६:१८ </char><char style="xt" closed="false"><ref loc="REV 8:5">प्रकाशितवाक्य ८:५</ref>; <ref loc="REV 11:13">११:१३</ref>,<ref loc="REV 11:19">१९</ref></char></note>बाक बिजलीगोळ चमकुसदव, अदिक शब्द अदिक गर्जन आत, अदिक ऊंद हिंग धोळ भूकम्प बत्‍त कि यागी टु मंळसा अन्द उत्पत्ति पृथ्वी मा आत, आगी टु हिंग धोळ भूकम्प यागलु बंदिदील. <verse eid="REV 16:18"/><verse number="19" style="v" sid="REV 16:19"/>इदुर देल आ धोळ नगर इन मुर तुकळा आगेदव, अदिक गैर यहूदीगोळव नगर बिद्दव; अदिक धोळ बेबीलोन इन याद परमेश्वर उन अल आत कि आव तान सिट्ट इन जलजलाहट इन सारा आऊक कुळसुल. <verse eid="REV 16:19"/><verse number="20" style="v" sid="REV 16:20"/><note caller="+" style="x"><char style="xo" closed="false">१६:२० </char><char style="xt" closed="false"><ref loc="REV 6:14">प्रकाशितवाक्य ६:१४</ref></char></note>अदिक हर ऊंद टापू तान जागा टु टलुसेत, अदिक पहाळगोळ्द पता हतीदील. <verse eid="REV 16:20"/><verse number="21" style="v" sid="REV 16:21"/><note caller="+" style="x"><char style="xo" closed="false">१६:२१ </char><char style="xt" closed="false"><ref loc="REV 11:19">प्रकाशितवाक्य ११:१९</ref></char></note>आकाश टु मंळसागोळ मा मन-मन तुमकु धोळ गारगोटी बिद्दव, अदिक इदुरसाटी कि ईद विपत्‍ती हापाळ अच भारी ईरोद, लॉकुर गारगोटी इन विपत्‍ती इन कारण परमेश्वर उन अपमान माळदुर.<verse eid="REV 16:21"/></para>
  <chapter eid="REV 16"/>
  <chapter number="17" style="c" sid="REV 17"/>
  <para style="s">धोळ वेश्या</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1"/>या येळ स्वर्गदूतगोळ्द हात्‍ती अव येळ कटोरा ईरव, आंदुर दा टु ऊंद बंदकु नान से ईद अंदुन, “ईल बर, ना नीनी आ धोळ वेश्या अन्द दण्ड तोर्साईन, जो हापाळ सा नीर मा कुर्तकु आर, <verse eid="REV 17:1"/><verse number="2" style="v" sid="REV 17:2"/>यार सांगुळ पृथ्वी इन राजागोळ व्यभिचार माळदुर; अदिक पृथ्वी इन ईरावाळेर आऊन व्यभिचार इन सारा देल मतवाला आगेगीदुर.”<verse eid="REV 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१७:३ </char>
      <char style="xt" closed="false">
        <ref loc="REV 13:1">प्रकाशितवाक्य १३:१</ref>
      </char>
    </note>आग आव नानी आत्मा दा आळी दी ओतुन, अदिक ना क्याचांद पशु मा, जो अपमान इन हेसुरगोळ देल तुमकु ईरोद अदिक यार येळ ताल्ला अदिक हत्‍त गॉट्टा ईरव, ऊंद आर्त इक कुर्तकु नोळदिन. <verse eid="REV 17:3"/><verse number="4" style="v" sid="REV 17:4"/>ई आर्त जाभळा रंग इन अदिक क्याचांद रंग इन कपळा हाक्‍कु ईरोर, अदिक व्हान्ना अदिक किमती मणिगोळ अदिक मोतिगोळ देल सजुस्कु ईरोर, अदिक आकिन कय दा ऊंद व्हान्ना अन्द कटोरा ईरोद जो बेकार वस्तुगोळ देल अदिक आकिन व्यभिचार इन अशुध्द वस्तुगोळ देल तुमकु ईरोद. <verse eid="REV 17:4"/><verse number="5" style="v" sid="REV 17:5"/>आकिन ह्याणा मा ई हेसुर लिख्सकु ईरोद, “भेद-धोळ बेबीलोन पृथ्वी इन वेश्यागोळ अदिक बेकार वस्तुगोळ्द मोय.” <verse eid="REV 17:5"/><verse number="6" style="v" sid="REV 17:6"/>ना आ आर्त इक पवित्र लॉकुर्द रक्ता अदिक यीशु उन गवाहगोळ्द रक्ता कुळदुर देल मतवाला नोळदीन;</para>
  <para style="p" vid="REV 17:6">आकी नोळकु ना चकित आगेदीन. <verse eid="REV 17:6"/><verse number="7" style="v" sid="REV 17:7"/>आग आ स्वर्गदूत नान से अंदुन, “नी येती चकित आद? ना ई आर्त अदिक आ पशु उक, यदुर मा आक सवार आर अदिक यार येळ ताल्ला अदिक हत्‍त गॉट्टा आव, नीनी भेद हेळतीन.<verse eid="REV 17:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 17:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१७:८ </char>
      <char style="xt" closed="false">
        <ref loc="REV 11:7">प्रकाशितवाक्य ११:७</ref>
      </char>
    </note>“जो पशु नी नोळया, अद पयला रा ईरोद पर ईग ईल्लच, अदिक अथाह अधोलोक दा टु होटकु विनाश दा बिद्दीत; अदिक पृथ्वी इन ईरावाळेर यार हेसुर दुनिया अन उत्पत्ति इन समय टु जीवन इन किताब दा लिख्सकु आगीदील, ई पशु उन ईद दशा नोळकु कि पयला ईरोद अदिक ईग ईल्लच अदिक बाक होट बंदीत, अचम्भा माळ्यार. <verse eid="REV 17:8"/><verse number="9" style="v" sid="REV 17:9"/>आ बुद्धी इन साटी यारदा ग्यान आद, ईदा मवका आद: अव येळु ताल्ला येळ पहाळ हुव यार मा आ आर्त कुर्तकु आर. आंदुर येळ राजा भी उर. <verse eid="REV 17:9"/><verse number="10" style="v" sid="REV 17:10"/>अव येळ राजा भी हुव, अईद रा आगेग्याव, अदिक ऊंद ईग आन, अदिक ऊंद ईग ताका बरली आन, अदिक याग बंदान रा येनारा समय ताका अदुर्द ईरोद भी जरूरी आद. <verse eid="REV 17:10"/><verse number="11" style="v" sid="REV 17:11"/>जो पशु पयला ईरोन, अदिक ईग ईल्लच, आव खुद आठवा हुन अदिक आ येळु दा टु पैदा आदुन, अदिक विनाश दा बिद्दान. <verse eid="REV 17:11"/><verse number="12" style="v" sid="REV 17:12"/>जो हत्‍त गॉट्टा नी नोळ्द अव हत्‍त राजा हुव यारी ईग ताका राज्य सिक्‍कीदील, पर आ पशु उन सांगुळ घळी तीमोर साटी राजागोळ घाई अधिकार सिक्‍कीत. <verse eid="REV 17:12"/><verse number="13" style="v" sid="REV 17:13"/>ईव सप्पा ऊंद मन आदार, अदिक अव तान तान सामर्थ्य अदिक अधिकार आ पशु उक कोट्टार. <verse eid="REV 17:13"/><verse number="14" style="v" sid="REV 17:14"/>अव मेमनागोळ देल लळाई माळ्याव, अदिक म्यांडा अन्द पाड्डा अऊर मा जय पाऊस्याव, यतिकी आव प्रभुगोळ प्रभु अदिक राजागोळ राजा हुव, अदिक जो कारूकु आग्याव अदिक निवळुस्कु आग्याव अदिक विश्वासी आव अव आऊन सांगुळ आव; आंदुर भी जय पाऊस्याव.”<verse eid="REV 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15"/>बाक आव नान से अंदुन, “जो नीर नी नोळ्द, यदुर मा वेश्या कुर्तकु आर, आंदुर रा लॉकुर अदिक भीळ अदिक जातीगोळ अदिक भाषागोळ हुव. <verse eid="REV 17:15"/><verse number="16" style="v" sid="REV 17:16"/>जो हत्‍त गॉट्टा नी नोळ्द, अव अदिक पशु आ वेश्या देल दुश्मनी ईट्याव, अदिक आकी लाचार अदिक नंगा माळ बुट्टाव, अदिक आकिन मास तीन बुट्टाव, अदिक आकी बेक्‍की दा होताक बुट्टाव. <verse eid="REV 17:16"/><verse number="17" style="v" sid="REV 17:17"/>यतिकी परमेश्वर आंदुर मन दा ईद हाक्यान कि आंदुर आऊन मनसा पुरा माळुल, अदिक यागासताका परमेश्वर उन वचन पुरा आगाल्द आगासताका ऊंद मन आगकु तान तान राज्य पशु उक कोटबुळी. <verse eid="REV 17:17"/><verse number="18" style="v" sid="REV 17:18"/>आ आर्त, यारी नी नोळ्द, अद धोळ नगर हुन जो पृथ्वी इन राजागोळ मा राज्य माळतद.”<verse eid="REV 17:18"/></para>
  <chapter eid="REV 17"/>
  <chapter number="18" style="c" sid="REV 18"/>
  <para style="s">बेबीलोन इन पतन</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1"/>इदुर बाद्दा ना ऊंद स्वर्गदूत उक स्वर्ग टु ईळुतेला नोळदीन, यारी धोळ अधिकार प्राप्त ईरोद; अदिक पृथ्वी आऊन तेज देल चमकुसकु येळ्त. <verse eid="REV 18:1"/><verse number="2" style="v" sid="REV 18:2"/><note caller="+" style="x"><char style="xo" closed="false">१८:२ </char><char style="xt" closed="false"><ref loc="REV 14:8">प्रकाशितवाक्य १४:८</ref></char></note>आव धोळ शब्द देल कारूकु अंदुन, “बिद्दोत, धोळ बेबीलोन बिद्दोत! अद दुष्टआत्मागोळ्द निवास, अदिक हर ऊंद अशुध्द आत्मा अन्द हड्डा, अदिक हर ऊंद अशुध्द अदिक बेकार पक्षी इन हड्डा आगेत. <verse eid="REV 18:2"/><verse number="3" style="v" sid="REV 18:3"/>यतिकी आऊन व्यभिचार इन भयानक सारा अन्द कारण सब जातीगोळ बिदव, अदिक पृथ्वी इन राजागोळ आऊन सांगुळ व्यभिचार माळदुर, अदिक पृथ्वी इन व्यापारी आऊन सुख-विलास इन बहुतायत इन कारण धनवान आदुर.”<verse eid="REV 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4"/>बाक ना स्वर्ग टु ऊंद अदिक शब्द केळदीन, “हे नान लॉकुरा, आऊन दा टु होटबुळी कि नीव आऊन पापगोळ दा भागी आगबाळी, अदिक आऊन वित्तिगोळ दा टु याऊ नीम मा बरबाळुल. <verse eid="REV 18:4"/><verse number="5" style="v" sid="REV 18:5"/>यतिकी आऊन पापगोळ्द ढेर स्वर्ग ताका पहुचुसेत, अदिक आऊन अपराध परमेश्वर उक याद होट बंदाव. <verse eid="REV 18:5"/><verse number="6" style="v" sid="REV 18:6"/>ह्यांग आव नीमी कोट्टुन हांग अच आऊक कोळी, अदिक आऊन क्याल्सागोळ्द अनुसार आऊक येढ्ढ गुणा ज्यादा कोळी; या कटोरा दा आव तुमकु कोटीदुन अदुर दा आऊन साटी येढ्ढ गुणा तुमकु कोळी.” <verse eid="REV 18:6"/><verse number="7" style="v" sid="REV 18:7"/>याट आव तान बळाई माळदुन अदिक सुखविलास माळदुन, आट आऊक दुख अदिक शोक कोळी; यतिकी अद तान मन दा अनतद, “ना रानी आगकु कुर्तीन, रांड्यागीत ईला; अदिक शोक दा यागलु बिळतीदील.” <verse eid="REV 18:7"/><verse number="8" style="v" sid="REV 18:8"/>ई कारण ऊंद अच दिन दा आकी मा परेशानीगोळ होट बंदाव, मतलब सायोद, अदिक शोक, अदिक अकाल, अदिक आक बेक्‍की दा भसम माळकु आदार, यतिकी आकिन न्यायी प्रभु परमेश्वर शक्तिमान आन.<verse eid="REV 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9"/>“पृथ्वी इन राजा यार आऊन सांगुळ व्यभिचार अदिक सुख-विलास माळदुन, याग आऊन होत्‍तोद धुंगा नोळ्यार, रा आऊन साटी वर्लेयार अदिक याद्दा पीटस्यार.” <verse eid="REV 18:9"/><verse number="10" style="v" sid="REV 18:10"/>आऊन पीळा अन्द अंज्क इन मारा आंदुर बळा दुर नीदुरकु अंदार, “हे धोळ नगर, बेबीलोन! हे मजबूत नगर, हाय! हाय! घळीतीम दा अच नीनी दण्ड सिकेग्याद.”<verse eid="REV 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11"/>“पृथ्वी इन व्यापारी आऊन साटी वर्लेयार अदिक कलपुस्यार, यतिकी ईग याऊ आंदुर माल कोम सकालुन; <verse eid="REV 18:11"/><verse number="12" style="v" sid="REV 18:12"/>मतलब व्हान्ना, बेळ्ली, रत्न, मोती, अदिक मलमल, अदिक जांभळा, रेशमी, अदिक क्याचांद रंग इन कपळा, अदिक हर प्रकार इन सुगन्धित हुळ्ली अदिक हत्ती इन हल्ल इन हर प्रकार इन वस्तुगोळ, अदिक किमती काठ अदिक पीतळा अदिक लोवा अदिक संगमरमर इन सब प्रकार इन वस्तुगोळ, <verse eid="REV 18:12"/><verse number="13" style="v" sid="REV 18:13"/>अदिक ब्याळा चाकरा, मसाला, धूप, अत्‍तर, लुबान, सारा, जैतुन इन याण्णा, मैदा, गोदी, गोसी-वस्ता, म्यांडा-आळगोळ, घ्वाळा रथ, अदिक दास, अदिक मंळसागोळ्द जीव. <verse eid="REV 18:13"/><verse number="14" style="v" sid="REV 18:14"/>ईग नीन मन भाऊसावाळा काय नीन हात्‍ती टु होगतेला ईत्‍तव, अदिक स्वादिष्ट अदिक भळकीला वस्तुगोळ नीन से दुर आगेग्याव, अदिक अव बाक यागलु सिकतीदील.” <verse eid="REV 18:14"/><verse number="15" style="v" sid="REV 18:15"/>ई वस्तुगोळ व्यापारी जो आऊन द्वारा धनवान आगीदुर, आऊन पीळा अन्द अंज्क इन मारा दुर नीदुरकु ईत्‍तार, अदिक वर्लतेला अदिक कलपुस्तेला अंदार, <verse eid="REV 18:15"/><verse number="16" style="v" sid="REV 18:16"/>“हाय! हाय! ईद धोळ नगर जो मलमल, अदिक जाभळा रंग इन अदिक क्याचांद रंग इन कपळा हाक्‍कु ईरोन, अदिक व्हान्ना अदिक रत्नगोळ अदिक मोतिगोळ देल सजुस्कु ईरोन; <verse eid="REV 18:16"/><verse number="17" style="v" sid="REV 18:17"/>घळीतीम दा अच आऊन हिंग भारी धन नाश आगेत.” हर ऊंद माँझी अदिक यात्री अदिक मल्लाह, अदिक याट समुद्र टु कमुसतार, सब दुर नीदुरदुर, <verse eid="REV 18:17"/><verse number="18" style="v" sid="REV 18:18"/>अदिक आऊन होत्‍तोद धुंगा नोळकु कारूकु अंदार, “यातोद नगर ई धोळ नगर इन घाई आद?” <verse eid="REV 18:18"/><verse number="19" style="v" sid="REV 18:19"/>अदिक तान तान ताल्लागोळ मा धुळा हाक्यार, अदिक वर्लतेला अदिक कलपुस्तेला चिल्लास चिळ्‍लासकु अंदार, “हाय! हाय! ईद धोळ नगर यदुर्द सम्पत्ति इन द्वारा समुद्र अन्द सब जहाजवाळेर धनी आगेगीदुर, घळीतीम दा अच ऊजळुसेत.”<verse eid="REV 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 18:20"/>हे स्वर्ग, अदिक हे पवित्र लॉकुरा, अदिक प्रेरितगोळा, भविष्यवक्तागोळ, आऊन मा आनन्द माळी, यतिकी परमेश्वर न्याय माळकु आऊन से नीम्द बदला ताकोंडुन!<verse eid="REV 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21"/>बाक ऊंद बलवान स्वर्गदूत बळा चक्‍की इन पट्टा अन्द घाई ऊंद कल्ल नेगदुन, अदिक ईद अनकु समुद्र दा भीट बुट्टुन, धोळ नगर बेबीलोन हिंग अच धोळ ताकत देल केडुकु आदीत, अदिक बाक यागलु अदुर पता हततिदील. <verse eid="REV 18:21"/><verse number="22" style="v" sid="REV 18:22"/>वीणा मुरसावाळेर, अदिक गायकगोळा, अदिक कोळ्ल मुरसावाळेरा, अदिक तुरही ऊयावाळेर्द शब्द बाक यागलु नीन दा केळ बरतीदील; अदिक यावारा उद्घम उन यावारा कारीगर भी बाक यागलु नीन दा मिलुसतीदील; अदिक जाता अन्द नळोद आवाज बाक यागलु नीन दा केळ बरतीदील; <verse eid="REV 18:22"/><verse number="23" style="v" sid="REV 18:23"/>अदिक दिंग्या अन्द ऊजुळ बाक यागलु नीन दा चमकुसतीदील, अदिक मंळगार अदिक मंळगीत इन शब्द बाक यागलु नीन दा केळ बरतीदील; यतिकी नीन व्यापारी पृथ्वी इन प्रधान ईरोर, अदिक नीन टोना देल सब जातीगोळ भरमुसकु आगीदव.<verse eid="REV 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 18:24"/>भविष्यवक्तागोळ अदिक पवित्र लॉकुर, अदिक पृथ्वी मा सब घात माळकु आदुर आंदुर्द रक्ता आऊन दा सिक्याद.<verse eid="REV 18:24"/></para>
  <chapter eid="REV 18"/>
  <chapter number="19" style="c" sid="REV 19"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1"/>इदुर बाद्दा ना स्वर्ग दा मान्सी धोळ भीळ इक ऊँचा शब्द देल ईद अनतेला केळदीन, “हल्लिलूय्याह! उद्धार अदिक महिमा अदिक सामर्थ्य नाम्द परमेश्वर उन अच हुन. <verse eid="REV 19:1"/><verse number="2" style="v" sid="REV 19:2"/>यतिकी आऊन निर्णय खरा अदिक ठीक आव. आव आ धोळ वेश्या अन्द, जो तान व्यभिचार देल पृथ्वी इक भ्रष्ट माळोर, न्याय माळदुन अदिक आकिन से तान दासगोळ्द रक्ता अन बदला ताकोंडुन.” <verse eid="REV 19:2"/><verse number="3" style="v" sid="REV 19:3"/>बाक दुसरा बार आंदुर अंदुर, “हल्लिलूय्याह! आऊन होत्‍तोद धुंगा हमेशा हमेशा येळतेला ईत्‍तीत.” <verse eid="REV 19:3"/><verse number="4" style="v" sid="REV 19:4"/>आग चोवीस स्याणागोळ अदिक नाक प्राणीगोळ बिदकु परमेश्वर उक प्रणाम माळदुर, जो सिंहासन मा कुर्तकु ईरोन, अदिक अंदुन, “आमीन! हल्लिलूय्याह!”<verse eid="REV 19:4"/></para>
  <para style="s">मेमना अन्द मदा</para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5"/>आग सिंहासन दा टु ऊंद शब्द होळ्त, “हे नामव परमेश्वर देल सब अंजावाळेर दासगोळा, येन स्याणेव, येन धोड्डेव; नीव सब आऊन स्तुति माळी.” <verse eid="REV 19:5"/><verse number="6" style="v" sid="REV 19:6"/>बाक ना धोळ भीळ इन घाई अदिक हापाळ नीर इन घाई शब्द, अदिक गर्जन इन घाई धोळ शब्द केळदीन: “हल्लिलूय्याह! यतिकी प्रभु नाम्द परमेश्वर सर्वशक्तिमान राज्य माळतान. <verse eid="REV 19:6"/><verse number="7" style="v" sid="REV 19:7"/>बरी, नाव आनन्दित अदिक मग्न आगाता, अदिक आऊन स्तुति माळाता, यतिकी म्यांडा अन्द पाड्डा अन्द मदा होट बंदाद, अदिक आऊन मंळगीत तान तान इक तयार माळ कोंडुर. <verse eid="REV 19:7"/><verse number="8" style="v" sid="REV 19:8"/>आऊक शुद्ध अदिक चमकदार महीन मलमल हाक्‍कोद अधिकार कोटकु आग्याद.” यतिकी आ साफ मलमल इन मतलब पवित्र लॉकुर्द न्याय इन क्याल्सा आद.<verse eid="REV 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१९:९ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 22:2">मत्ती २२:२</ref>,<ref loc="MAT 22:3">३</ref></char>
    </note>आग स्वर्गदूत नान से अंदुन, “ईद लिख्स कि धन्य आंदुर आर, जो म्यांडा अन्द पाड्डा अन्द मदा अन्द भोज दा कारूकु आग्यार.” बाक आव नान से अंदुन, “ई वचन परमेश्वर उन सत्य वचन हुन.”<verse eid="REV 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10"/>आग ना आऊक प्रणाम माळोर साटी आऊन कालगोळ मा बिद्दीन. आव नान से अंदुन, “नोळ, हिंग माळबाळ, ना अपमान अदिक नीन वार्टुरगोळ्द संगी दास हुईन जो यीशु उन गवाही कोळदुर मा स्थिर आन. परमेश्वर उक अच प्रणाम माळ.” यतिकी यीशु उन गवाही भविष्यवाणी इन आत्मा हुन.<verse eid="REV 19:10"/></para>
  <para style="s">बिळीद घ्वाळा मा कुरावाळा</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11"/>बाक ना स्वर्ग इक तेरूकु नोळदीन, अदिक नोळतीन कि ऊंद बिळीद घ्वाळा आद; अदिक अदुर मा ऊंद सवार आन, जो विश्वासयोग्य अदिक सत्य कहलुस्तान; अदिक आव न्याय इन सांगुळ न्याय अदिक लळाई माळतान. <verse eid="REV 19:11"/><verse number="12" style="v" sid="REV 19:12"/>आऊन कण्णगोळ बेक्‍की इन ज्वाला आव, अदिक आऊन ताल्ला मा हापाळ सा राजमुकुट आव. आऊन मा ऊंद हेसुर लिख्सकु आद, यारी आऊक बिटकु अदिक याऊ जान्सालुन. <verse eid="REV 19:12"/><verse number="13" style="v" sid="REV 19:13"/>आव रक्ता सिप्सकु कपळा हाक्‍कु आन, अदिक आऊन हेसुर परमेश्वर उन वचन हुन. <verse eid="REV 19:13"/><verse number="14" style="v" sid="REV 19:14"/>स्वर्ग इन सेना बिळीद घ्वाळागोळ मा सवार अदिक बिळीद अदिक शुद्ध मलमल कपळा हाक्‍कु आऊन हिंद हिंद आर. <verse eid="REV 19:14"/><verse number="15" style="v" sid="REV 19:15"/><note caller="+" style="x"><char style="xo" closed="false">१९:१५ </char><char style="xt" closed="false"><ref loc="REV 14:20">प्रकाशितवाक्य १४:२०</ref></char></note>जाती जाती इक बडोर साटी आऊन बाय देल ऊंद तेज धार इन तलवार होळतद. आव लोवा अन्द छळी हुळकु आंदुर मा राज्य माळ्यान, अदिक सर्वशक्तिमान परमेश्वर उन भयानक प्रकोप इन जलजलाहट इन सारा अन्द कुंड दा अंगुर मेट्यान. <verse eid="REV 19:15"/><verse number="16" style="v" sid="REV 19:16"/>आऊन कपळा अदिक जांघ मा ईद हेसुर लिख्सकु आद: “राजागोळ राजा अदिक प्रभुगोळ प्रभु.”<verse eid="REV 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17"/>बाक ना ऊंद स्वर्गदूत उक सुर्य मा नीदुरकु नोळदीन. आव धोळ शब्द देल कारूकु आकाश इन न्याड्या दा टु ऊळुसावाळेर सब पक्षीगोळ देल अंदुन, “बरी, परमेश्वर उन धोळ भोज इन साटी जमा आगेगी, <verse eid="REV 19:17"/><verse number="18" style="v" sid="REV 19:18"/>यदुर देल नीव राजागोळ्द मास, अदिक सरदारगोळ्द मास, अदिक शक्तिमान गंळ्सगोळ्द मास, अदिक घ्वाळागोळ्द अदिक अऊर मा सवार आगतार आंदुर मास, अदिक येन स्वतंत्र येन दास, येन स्याणेव येन धोड्डेव, सब लॉकुर्द मास तिनी.”<verse eid="REV 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19"/>बाक ना आ पशु, अदिक पृथ्वी इन राजागोळ इक अदिक आंदुर्द सेनागोळ इक आ घ्वाळा अन्द सवार अदिक आऊन सेना से लळाई माळोर साटी जमा नोळदीन. <verse eid="REV 19:19"/><verse number="20" style="v" sid="REV 19:20"/><note caller="+" style="x"><char style="xo" closed="false">१९:२० </char><char style="xt" closed="false"><ref loc="REV 13:1-18">प्रकाशितवाक्य १३:१-१८</ref></char></note>अद पशु, अदिक अदुर सांगुळ आव ख्वाटा भविष्यवक्ता हुळकु आदुन याव आऊन मुंद हिंग चिन्ह तोर्सीदुन यदुर द्वारा आव आंदरी भरमुसदुन यदुर मा आ पशु उन छाप ईरोद अदिक जो अदुर मूर्ति इन पुजा माळतोगोर. ईव येढ्ढु जित्‍ता जीव आ बेक्‍की इन झील दा, जो गन्धक देल होततद, हाक्‍कु आदुर. <verse eid="REV 19:20"/><verse number="21" style="v" sid="REV 19:21"/>बाकी नोर लॉकुर आ घ्वाळा अन्द सवार इन तलवार देल, जो अदुर बाय देल होळतोगोद, कोंदकु आदुर; अदिक सब पक्षी आंदुर मास देल संतुष्ट आगेदुर.<verse eid="REV 19:21"/></para>
  <chapter eid="REV 19"/>
  <chapter number="20" style="c" sid="REV 20"/>
  <para style="s">हजार वर्ष इन राज्य</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1"/>बाक ना ऊंद स्वर्गदूत उक स्वर्ग टु ईळुतेला नोळदीन, याऊन कय दा अथाह-अधोलोक इन कुंजी अदिक ऊंद धोळ शंकली ईरोद. <verse eid="REV 20:1"/><verse number="2" style="v" sid="REV 20:2"/>आव आ अजगर, मतलब हाळोद हाव इक, जो इब्लीस अदिक शैतान आन, हुडुकु हजार वर्ष इन साटी कट बुट्टुन, <verse eid="REV 20:2"/><verse number="3" style="v" sid="REV 20:3"/>अदिक अदरी अथाह-अधोलोक दा हाक्‍कु बंद माळ बुट्टुन अदिक अदुर मा मोहर हच बुट्टुन कि अद हजार वर्ष इन पुरा आगासताका गैर यहूदी लॉकुरी बाक भरमुस बाळुल. इदुर बाद्दा जरूरी आद कि अद घळी तीम साटी बाक खोल्सकु आगुल.<verse eid="REV 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4"/>बाक ना सिंहासन नोळदीन, अदिक अऊर मा लॉकुर कुरतुर, अदिक आंदरी न्याय माळोद अधिकार कोटकु आत. ना आंदुर आत्मागोळ इक भी नोळदीन, यार ताल्ला यीशु उन गवाही कोळोद अदिक परमेश्वर उन वचन इन कारण कडुकु आगीदव, अदिक यार ना आ पशु उन, अदिक ना अदुर मूर्ति इन पुजा माळीदुर, अदिक ना अदुर छाप तान ह्याणा अदिक कयगोळ मा ताकोंडीदुर. आंदुर जित्‍ता आगकु मसीह अन्द सांगुळ हजार वर्ष ताका राज्य माळतेला ईरूल. <verse eid="REV 20:4"/><verse number="5" style="v" sid="REV 20:5"/>यागासताका ईव हजार वर्ष पुरा आगीदील आगासताका बाकी नोर सोतकु मंळसा जित्‍ता आगीदील. ईद रा पयला पुनरूत्थान हुन. <verse eid="REV 20:5"/><verse number="6" style="v" sid="REV 20:6"/>धन्य अदिक पवित्र आव आन, जो ई पयला पुनरूत्थान इन भागी आर. हिंगुर मा दुसरा मृत्यु उन यातोदु अधिकार हैलेच, पर आंदुर परमेश्वर अदिक मसीह अन्द याजक आदार अदिक आऊन सांगुळ हजार साल ताका राज्य माळ्यार.<verse eid="REV 20:6"/></para>
  <para style="s">शैतान उन विनाश</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7"/>याग हजार साल पुरा आगेदव रा शैतान कैद टु बिळसुस्कु आगेदान. <verse eid="REV 20:7"/><verse number="8" style="v" sid="REV 20:8"/>अद आ जातीगोळी जो धरती इन नाकु दी ईत्‍तीत, मतलब गोग अदिक मागोग इक यऊर्द गिनती समुद्र अन्द गागरा अन्द बराबर ईत्‍तीत, भरमुसकु लळाई इन साटी जमा माळली होट्टीत. <verse eid="REV 20:8"/><verse number="9" style="v" sid="REV 20:9"/>अव सप्पा धरती मा फैलुसकु पवित्र लॉकुर्द छावनी अदिक प्रिय नगर इक घेर्स बुट्टाव; अदिक बेक्‍की स्वर्ग टु ईळुकु आंदरी भसम माळीत. <verse eid="REV 20:9"/><verse number="10" style="v" sid="REV 20:10"/>आंदुर्द भरमुसावाळा शैतान बेक्‍की अदिक गन्धक इन आ झील दा, यदुर दा आ पशु अदिक ख्वाटा भविष्यवक्ता भी ईत्‍तान, हाकसुसकु आदार; अदिक आंदुर ईळ्लक हागुल हमेशा हमेशा दुख दा तळपुळस्त ईत्‍तार.<verse eid="REV 20:10"/></para>
  <para style="s">आखरी न्याय</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11"/>बाक ना ऊंद धोळ बिळीद सिंहासन अदिक आऊक, जो अदुर मा कुर्तकु आन, नोळदीन; आऊन मुंद टु पृथ्वी अदिक आकाश ओळेदव, अदिक आंदुर साटी जागा सिकिदील. <verse eid="REV 20:11"/><verse number="12" style="v" sid="REV 20:12"/>बाक ना स्याणेर धोड्डेर सब सोतकु मंळसागोळ इक सिंहासन इन मुंद नीदुरकु नोळदीन, अदिक किताबगोळ खोल्सकु आदव; अदिक बाक ऊंद मात्‍त किताब खोल्सकु आत, मतलब जीवन इन किताब; अदिक ह्यांग आ किताबगोळ दा लिख्सकु ईरोद, हांग अच आंदुर क्याल्सागोळ्द अनुसार सोतकु मंळसागोळ्द न्याय माळकु आत. <verse eid="REV 20:12"/><verse number="13" style="v" sid="REV 20:13"/>समुद्र आ सोतकु मंळसागोळ इक जो अदुर दा ईरव कोट बुळ्त, अदिक मृत्यु अदिक अधोलोक आ सोतकु मंळसागोळ इक जो अदुर दा ईरव कोट बुळ्त; अदिक आंदुर दा टु हर ऊंद मंळसा अक आंदुर क्याल्सागोळ अन्द अनुसार आंदुर न्याय माळकु आत. <verse eid="REV 20:13"/><verse number="14" style="v" sid="REV 20:14"/>मृत्यु अदिक अधोलोक बेक्‍की इन झील दा हाक्‍कु आदव. ईद बेक्‍की इन झील दुसरा मृत्यु हुन; <verse eid="REV 20:14"/><verse number="15" style="v" sid="REV 20:15"/>अदिक यारदारा हेसुर जीवन इन किताब दा लिख्सकु सिकतीदील, आव बेक्‍की इन झील दा हाक्‍कु आदुन.<verse eid="REV 20:15"/></para>
  <chapter eid="REV 20"/>
  <chapter number="21" style="c" sid="REV 21"/>
  <para style="s">व्हाशोद आकाश अदिक व्हाशोद पृथ्वी</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">२१:१ </char>
      <char style="xt" closed="false">
        <ref loc="2PE 3:13">२ पतरस ३:१३</ref>
      </char>
    </note>बाक ना व्हाशोद आकाश अदिक व्हाशोद पृथ्वी इक नोळदीन, यतिकी पयला आकाश अदिक पयला पृथ्वी होगतेला ईरोद, अदिक समुद्र भी ईतीदील. <verse eid="REV 21:1"/><verse number="2" style="v" sid="REV 21:2"/><note caller="+" style="x"><char style="xo" closed="false">२१:२ </char><char style="xt" closed="false"><ref loc="REV 3:12">प्रकाशितवाक्य ३:१२</ref></char></note>बाक ना पवित्र नगर व्हाशोद यरूशलेम इक स्वर्ग टु परमेश्वर उन हात्‍ती टु ईळुतेला नोळदीन. अद आ मंळगीत इन घाई ईरोद जो तान गांड्ड उन साटी सिंगार माळकु आर. <verse eid="REV 21:2"/><verse number="3" style="v" sid="REV 21:3"/>बाक ना सिंहासन दा टु यावारा अक धोळ शब्द देल ईद अनतेला केळदीन, “नोळ, परमेश्वर उन ड्यारा मंळसागोळ्द न्याड्या दा आद. आव आंदुर सांगुळ ड्यारा माळ्यान, अदिक आंदुर आऊन लॉकुर आदार, अदिक परमेश्वर खुद आंदुर सांगुळ ईत्‍तान अदिक आंदुर परमेश्वर आदान. <verse eid="REV 21:3"/><verse number="4" style="v" sid="REV 21:4"/>आव आंदुर कण्णगोळ देल सप्पा नीर सिट्ट कोंडान; अदिक इदुर बाद्दा मृत्यु ईला ईत्‍तीत, अदिक न शोक, न विलाप, न पीळा ईत्‍तीत; पयला मातगोळ होगतेला ईत्‍तव.”<verse eid="REV 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5"/>जो सिंहासन मा कुर्तकु ईरोन, आव अंदुन, “नोळ, ना सब येनारा व्हाशोद माळकु कोळतीन.” बाक आव अंदुन, “लिख्स कोम, यतिकी ईव वचन विश्वास इन योग्य अदिक सत्य आव.” <verse eid="REV 21:5"/><verse number="6" style="v" sid="REV 21:6"/>बाक आव नान से अंदुन, “ईव मातगोळ पुरा आगेग्याव. ना अल्फा अदिक ओमेगा, पयला अदिक आखरी हुईन. ना प्यासा अक जीवन इन नीर इन झरना दा टु फुकट दा कुडोद अधिकार कोळाईन. <verse eid="REV 21:6"/><verse number="7" style="v" sid="REV 21:7"/>जो विजय आदान आवा ई वस्तुगोळ्द वारीस आदान, अदिक ना आऊन परमेश्वर आगाईन अदिक आव नान पार आदान. <verse eid="REV 21:7"/><verse number="8" style="v" sid="REV 21:8"/>लेकीन डरपोकगोळा, अदिक अविश्वासीगोळा, अदिक नीच हरकत माळावाळेरा, अदिक हत्या माळावाळेरा अदिक व्यभिचारीगोळा, अदिक जादू टोना माळावाळेरा, अदिक मूर्ति इन पुजा माळावाळेरा, अदिक सब ख्वाटा मातगोळ्द भाग आ झील दा सिक्‍कीत जो बेक्‍की अदिक गन्धक देल होततेला ईरतद: ईद दुसरा मृत्यु हुन.”<verse eid="REV 21:8"/></para>
  <para style="s">व्हाशोद यरूशलेम</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9"/>बाक आ येळ स्वर्गदूतगोळ हात्‍ती येळ आखरी परेशानी देल तुमकु येळ कटोरागोळ ईरव, आंदुर दा टु ऊंद नान हात्‍ती बंदुन, अदिक नान सांगुळ मातगोळ माळकु अंदुन, “ईल बर, ना नीनी मंळगीत मतलब म्यांडा अन्द पाड्डा अन्द हिंग्स तोर्साईन.” <verse eid="REV 21:9"/><verse number="10" style="v" sid="REV 21:10"/>आग आव नानी आत्मा दा ऊंद धोळ अदिक ऊँचा पहाळ मा ओतुन, अदिक पवित्र नगर यरूशलेम इक स्वर्ग टु परमेश्वर उन हात्‍ती टु ईळुतेला तोर्सदुन. <verse eid="REV 21:10"/><verse number="11" style="v" sid="REV 21:11"/>परमेश्वर उन महिमा आंदुर्दा ईरोद, अदिक आऊन ज्योति हापाळ अच किमती कल्ल, मतलब बिल्लौर इन घाई यशब उन घाई स्वच्छ ईरोद. <verse eid="REV 21:11"/><verse number="12" style="v" sid="REV 21:12"/>आऊन दिवार शयरपनाह धोळ ऊँचा ईरोद, अदिक आऊन हन्नेळ फाटक अदिक फाटकगोळ मा हन्नेळ स्वर्गदूत ईरोर; अदिक आ फाटकगोळ मा इस्त्राएलीगोळ्द हन्नेळ गोत्रगोळ्द हेसुर लिख्सकु ईरव. <verse eid="REV 21:12"/><verse number="13" style="v" sid="REV 21:13"/>पूर्व दिशा अन दी मुर फाटक, उत्‍तर दिशा अन दी मुर फाटक, दक्षिण दिशा अन दी मुर फाटक, अदिक पश्चिम दिशा अन दी मुर फाटक ईरव. <verse eid="REV 21:13"/><verse number="14" style="v" sid="REV 21:14"/>नगर इन दिवार इन शयरपनाह अन्द हन्नेळ नींवगोळ ईरव, अदिक अदुर मा म्यांडा अन्द पाड्डा अन्द हन्नेळ प्रेरितगोळ्द हन्नेळ हेसुर लिख्सकु ईरव. <verse eid="REV 21:14"/><verse number="15" style="v" sid="REV 21:15"/>जो नान सांगुळ मातगोळ माळोन आऊन हात्‍ती नगर अदिक आऊन फाटकगोळ अदिक आऊन शयरपनाह अक आळोर साटी ऊंद व्हान्ना अन्द गज ईरोद. <verse eid="REV 21:15"/><verse number="16" style="v" sid="REV 21:16"/>अद नगर वर्गाकार बसुस्कु ईरोद अदिक अदुर्द लंबाई, चौळाई इन बराबर ईरोद; अदिक आव आ गज देल नगर इक आळदुन, रा साढ़े येळ सौ कोस इन होळ्त: अदुर्द लंबाई अदिक चौळाई अदिक ऊँचाई बराबर ईरोद. <verse eid="REV 21:16"/><verse number="17" style="v" sid="REV 21:17"/>आव आऊन शयरपनाह अक मंळसा अन्द मतलब स्वर्गदूत उन नाप देल आळदुन, रा ऊंद सौ चौवालीस कय होळ्त. <verse eid="REV 21:17"/><verse number="18" style="v" sid="REV 21:18"/>आऊन शयरपनाह यशब इन बन्सकु ईरोद, अदिक नगर हिंग शुद्ध व्हान्ना अन्द ईरोद जो स्वच्छ काँच इन घाई ईरूल. <verse eid="REV 21:18"/><verse number="19" style="v" sid="REV 21:19"/>आ नगर इन नींवगोळ हर प्रकार इन किमती कल्लगोळ देल सवारस्कु ईरोद; पयला पायवा यशब देल, दुसरा नीलमणी देल, तीसरा लालळी देल, चौथा मरकत देल, <verse eid="REV 21:19"/><verse number="20" style="v" sid="REV 21:20"/>पाचवा गोमेदक देल, सहावा माणिक्य देल, सातवा पीतमणी देल, आठवा पेरोज देल, नववा पुखराज देल, दसवा लहसनिए देल, ग्यारवा धूम्रकान्त देल, अदिक बारवा चन्द्रकाँत मणी देल बन्सकु ईरोद. <verse eid="REV 21:20"/><verse number="21" style="v" sid="REV 21:21"/>हन्नेळु फाटक हन्नेळ मोतीगोळ्द ईरव; ऊंद ऊंद फाटक ऊंद ऊंद मोती इन माळकु ईरोद. नगर इन सळक स्वच्छ काँच इन घाई शुद्ध व्हान्ना अन्द ईरोद.<verse eid="REV 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22"/>ना अदुर्दा यातोदु मंदिर नोळीदील, यतिकी सर्वशक्तिमान प्रभु परमेश्वर अदिक म्यांडा अन्द पाड्डा अदुर्द मंदिर आद. <verse eid="REV 21:22"/><verse number="23" style="v" sid="REV 21:23"/>आ नगर दा सुर्य अदिक चंद्रमा अन्द ऊजुळ इन जरवत हैलेच, यतिकी परमेश्वर उन तेज देल अदुर्दा ऊजुळ आगेत्याद, अदिक म्यांडा अन्द पाड्डा आऊन दिंग्या हुन. <verse eid="REV 21:23"/><verse number="24" style="v" sid="REV 21:24"/>जाती-जाती इन लॉकुर आऊन ज्योति दा नळुकु वयाळ्यार, अदिक पृथ्वी इन राजा तान तान तेज इन सामाईन अदुर दा तंदार. <verse eid="REV 21:24"/><verse number="25" style="v" sid="REV 21:25"/>आऊन फाटक हागुल इक यागलु बंद आगतीदील, अदिक ईळ्लक अल आगतीदील. <verse eid="REV 21:25"/><verse number="26" style="v" sid="REV 21:26"/>लॉकुर जाती जाती इन तेज अदिक वैभव इन सामाईन अदुर दा तंदार. <verse eid="REV 21:26"/><verse number="27" style="v" sid="REV 21:27"/>लेकीन अदुर्दा यातोदु अपवित्र वस्तु या बेकार क्याल्सा माळावाळा, या ख्वाटा मात्‍तगोळ गढुसावाळा यातोदु रीति देल प्रवेश माळ सकालुन, पर सिर्फ आ लॉकुर यार हेसुर म्यांडा अन्द पाड्डा अन्द जीवन इन किताब दा लिख्सकु आव.<verse eid="REV 21:27"/></para>
  <chapter eid="REV 21"/>
  <chapter number="22" style="c" sid="REV 22"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1"/>बाक आव नानी बिल्लौर इन घाई झलकुसतेला, जीवन इन नीर इन गांगा तोर्सदुन, जो परमेश्वर अदिक म्यांडा अन्द पाड्डा अन्द सिंहासन टु होटकु <verse eid="REV 22:1"/><verse number="2" style="v" sid="REV 22:2"/>आ नगर इन सळक इन न्याड्या वाहुसोद. गांगा अन ईप्पाटी अदिक आप्पाटी जीवन इन मार्र ईरोद; अदुर्दा हन्नेळ प्रकार इन काय हत्तव, अदिक अदरी हर तिंगुळ काय हत्तव; अदिक आ मार्र इन याल्लागोळ देल गैर यहूदी लॉकुर चंगा आगतोगोर.<verse eid="REV 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 22:3"/>बाक श्राप आगतीदील, अदिक परमेश्वर अदिक म्यांडा अन्द पाड्डा अन्द सिंहासन आ नगर दा ईत्‍तीत अदिक आऊन दास आऊन स्यावा माळ्यार. <verse eid="REV 22:3"/><verse number="4" style="v" sid="REV 22:4"/>आंदुर आऊन बाय नोळ्यार, अदिक आऊन हेसुर आंदुर ह्याणागोळ मा लिख्सकु ईत्‍तीत. <verse eid="REV 22:4"/><verse number="5" style="v" sid="REV 22:5"/>बाक ईळ्लक आगतीदील, अदिक आंदरी दिंग्या अदिक सुर्य अन्द ऊजुळ इन जरवत बिळतीदील, यतिकी प्रभु परमेश्वर आंदरी ऊजुळ कोट्टान, अदिक आंदुर हमेशा हमेशा राज्य माळ्यार.<verse eid="REV 22:5"/></para>
  <para style="s">यीशु उन दुबारा बरोद</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6"/>बाक आव नान से अंदुन, “ईव मातगोळ विश्वास इन योग्य अदिक सही आव. प्रभु, जो भविष्यवक्तागोळ आत्मागोळ्द परमेश्वर हुन, तान स्वर्गदूत उक इदुरसाटी कळुदुन कि तान दासगोळी अव मातगोळ, यदुर राटनेरी पुरा आगोद जरूरी आद, तोरस्यार.”<verse eid="REV 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7"/>“नोळ, ना राटनेरी बरावाळा आईन! धन्य आन आव, जो ई किताब इन भविष्यवाणी इन मातगोळ मान्सतान.”<verse eid="REV 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8"/>ना आवा यूहन्ना हुईन, जो ईव मातगोळ केळीन अदिक नोळतोगीन. याग ना केळदीन अदिक नोळदीन, रा जो स्वर्गदूत नानी ईव मातगोळ तोर्सतोगोन, ना आऊन कालगोळ मा प्रणाम माळोर साटी बिद्दीन. <verse eid="REV 22:8"/><verse number="9" style="v" sid="REV 22:9"/>लेकीन आव नान से अंदुन, “नोळ, हिंग माळबाळ; यतिकी ना नीन, अदिक नीन वार्ट भविष्यवक्तागोळ, अदिक ई किताब इन मातगोळ इक मान्सावाळेर्द संगी दास हुईन. परमेश्वर उक अच प्रणाम माळ.” <verse eid="REV 22:9"/><verse number="10" style="v" sid="REV 22:10"/>बाक आव नान से अंदुन, ई किताब इन भविष्यवाणी इन मातगोळी बंद माळबाळ; यतिकी समय हात्‍ती आद. <verse eid="REV 22:10"/><verse number="11" style="v" sid="REV 22:11"/>जो अन्याय माळतान, आव अन्याय अच माळतेला ईरूल; अदिक जो मलिन आन, आव मलिन बन्सकु ईरूल; अदिक जो न्यायी आन, आव न्यायी बन्सकु ईरूल; अदिक जो पवित्र आन; आव पवित्र बन्सकु ईरूल.<verse eid="REV 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12"/>“नोळ, ना राटनेरी बरावाळा आईन; अदिक हर ऊंद मंळसा अन्द क्याल्सा अन्द अनुसार मोहबदला कोळोर साटी प्रतिफल नान हात्‍ती आद. <verse eid="REV 22:12"/><verse number="13" style="v" sid="REV 22:13"/><note caller="+" style="x"><char style="xo" closed="false">२२:१३ </char><char style="xt" closed="false"><ref loc="REV 1:8">प्रकाशितवाक्य १:८</ref>; </char><char style="xt" closed="false"><ref loc="REV 1:17">प्रकाशितवाक्य १:१७</ref>; <ref loc="REV 2:8">२:८</ref></char></note>ना अल्फा अदिक ओमेगा, पयला अदिक आखरी, पयले टु अदिक अन्त हुईन.<verse eid="REV 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 22:14"/>“धन्य आंदुर आर, जो तान कपळा ओगु कोमतार, यतिकी आंदरी जीवन इन मार्र इन हात्‍ती बरोद अधिकार सिक्‍कीत, अदिक आंदुर फाटकगोळ देल आगकु नगर दा प्रवेश माळ्यार. <verse eid="REV 22:14"/><verse number="15" style="v" sid="REV 22:15"/>लेकीन नायगोळ, अदिक टोना माळावाळेर, अदिक व्यभिचारी, अदिक खुनीगोळ अदिक मूर्ति इन पुजा माळावाळा, अदिक हर ऊंद ख्वाटपन इक चाहसावाळा अदिक घळुसावाळा व्हार्या ईत्‍तान.<verse eid="REV 22:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16"/>“नानी यीशु तान स्वर्गदूत उक इदुरसाटी कळुदुन कि नीम मुंद मंडलीगोळ्द बारा दा ई मातगोळ्द गवाही कोळुल. ना दाऊद उन मुल अदिक वंश, अदिक व्हातुर इन चमकुसतेला तारा हुईन.”<verse eid="REV 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17"/>आत्मा अदिक मंळगीत येढ्ढु अंतार, “बर!”</para>
  <para style="p" vid="REV 22:17">अदिक केळावाळा भी अंदान, “बर!”</para>
  <para style="p" vid="REV 22:17">जो नीरळ्कु ईतीदान आव बरूल, अदिक जो यावारा चाहासतान आव जीवन इन नीर फुकट दा ताकोमुल.<verse eid="REV 22:17"/></para>
  <para style="s">समापन</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18"/>ना हर ऊंद मंळसा अक, जो ई किताब इन भविष्यवाणी इन मातगोळ केळतान, गवाही कोळतीन: अगर यावारा मंळसा ई मातगोळ दा येनारा वाळुस्यान रा परमेश्वर आ परेशानीगोळ इक, जो ई किताब दा लिख्सकु आव, आऊन मा वाळुस्यान. <verse eid="REV 22:18"/><verse number="19" style="v" sid="REV 22:19"/>अगर यावारा ई भविष्यवाणी इन किताब इन मातगोळ दा टु येनारा तेगु कोंडान, रा परमेश्वर आ जीवन इन मार्र अदिक पवित्र नगर दा टु, यदुर्द वर्णन ई किताब दा आद, अदुर भाग तेगु कोंडान.<verse eid="REV 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20"/>जो ईव मातगोळ्द गवाही कोळतान आव ईद अनतान, “हव, ना जल्दी बरावाळा आईन.” आमीन.</para>
  <para style="p" vid="REV 22:20">हे प्रभु यीशु बर!<verse eid="REV 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21"/>प्रभु यीशु उन अनुग्रह पवित्र लॉकुर्द सांगुळ ईरूल. आमीन.<verse eid="REV 22:21"/></para>
  <chapter eid="REV 22"/>
</usx>
