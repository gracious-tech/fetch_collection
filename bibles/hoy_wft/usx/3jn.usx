<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Holiya</book>
  <para style="h">३ यूहन्ना</para>
  <para style="toc3">३ यूहन्ना</para>
  <para style="toc2">३ यूहन्ना</para>
  <para style="toc1">यूहन्ना अन्द तिसरा चिट्ठी</para>
  <para style="mt2">यूहन्ना की तिसरी पत्री</para>
  <para style="mt1">यूहन्ना अन्द तिसरा चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">३ यूहन्ना अन्द चिट्ठी यूहन्ना अन्द द्वारा मसीह अन्द जनम इन ५० से १०० साल इन न्याड्या दा लिख्सकु आगीत. यूहन्ना खुद इक लेखक इन रूप दा अरालुन, बल्‍की ईदुर बजाय खुद इक स्याणा <char style="xt"><ref loc="3JN 1:1">१:१</ref></char> अनतान. आव <char style="xt"><ref loc="2JN 1:1">२ यूहन्ना १:१</ref></char> दा भी अदा अनतान. हिंग मान्सकु आगतद कि यूहन्ना ३ यूहन्ना अन्द चिट्ठी इन अनुसार खुशखबरी लिखसीदुन अदिक इफिसुस दा ईरतेला मुर चिट्ठी १ यूहन्ना, २ यूहन्ना अदिक ३ यूहन्ना ईरव.</para>
  <para style="ip">यूहन्ना ई चिट्ठी इक गोयास हेसुर इनव ऊंद आस्तिक उक लिखसीदुन. आव गोयास उक ऊंद संगी इन रूप दा संबोधित माळतान अदिक आऊक आ क्षेत्र अन्द माध्यम देल जो यात्रा माळेत्यार आ इसाई वार्टुर साटी पाऊना नियोजित आगोद निर्देश कोळतान.</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. यूहन्ना तान चिट्ठी प्रस्तुत माळतान. <char style="ior"><ref loc="3JN 1:1">१:१</ref></char></para>
  <para style="io1">२. अदुर बाद्दा आव गोयास उक प्रोत्साहित माळतान अदिक वार्टुर इक पाऊना तोरसोर साटी निर्देश कोळतान. <char style="ior"><ref loc="3JN 1:2-8">१:२-८</ref></char></para>
  <para style="io1">३. ईदुर बाद्दा, आव दुसरा येढ्ढ मंळसागोळ, दियुत्रिफेस अदिक दिमेत्रियुस उन मात माळतान. <char style="ior"><ref loc="3JN 1:9-12">१:९-१२</ref></char></para>
  <para style="io1">४. आखरी दा आव तान चिट्ठी खतम माळतान. <char style="ior"><ref loc="3JN 1:13-14">१:१३-१४</ref></char></para>
  <chapter number="1" style="c" sid="3JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१:१ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:29">प्रेरितगोळ १९:२९</ref>; <ref loc="ROM 16:23">रोमियों १६:२३</ref>; <ref loc="1CO 1:14">१ कुरिन्थि १:१४</ref></char>
    </note>नान स्याणा अन दी टु प्रिय गयुस उन हेसुर, यार से ना सही प्यार ईटतीन.<verse eid="3JN 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2"/>हे प्रिय, नान ईद प्रार्थना आद कि ह्यांग नी आत्मिक उन्नती माळेत्या, हांग अच नी सप्पा मातगोळ दा उन्नती माळ अदिक भला चंगा ईर. <verse eid="3JN 1:2"/><verse number="3" style="v" sid="3JN 1:3"/>यतिकी याग वार्टुर बंदकु नीन आ सच्चाई इन गवाही कोट्टुर, यदुर मा खराखुरा नळुत्या, रा ना हापाळ खुश आदीन. <verse eid="3JN 1:3"/><verse number="4" style="v" sid="3JN 1:4"/>नानी इदुर से यक्कुल मात्‍त यातोदु खुशी इन जरवत हैलेच यदरी ना केळाईन, कि नान चिकोर सच्चाई मा नळुतार.<verse eid="3JN 1:4"/></para>
  <para style="s">गयुस उन प्रशंसा</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5"/>हे प्रिय, जो येनारा नी आ वार्टुर सांगुळ माळत्या, जो परदेशी आद, अदरी सच्चाई देल माळत्या. <verse eid="3JN 1:5"/><verse number="6" style="v" sid="3JN 1:6"/>आंदुर मंडली इन मुंद नीन प्यार इन गवाही कोटार. अगर नी आंदरी आ प्रकार देल विदा माळ्या यात्‍ता प्रकार देल परमेश्वर उन लॉकुर साटी उचित आद रा वळ्लीद माळ्या. <verse eid="3JN 1:6"/><verse number="7" style="v" sid="3JN 1:7"/>यतिकी आंदुर आ हेसुर साटी होटार, अदिक दुसरा जाती नोर लॉकुर से येनु ताकोमालुर. <verse eid="3JN 1:7"/><verse number="8" style="v" sid="3JN 1:8"/>इदुरसाटी नाव मसीह लॉकुरी हिंग लॉकुर्द स्वागत माळ पायजे, यदुर देल नाव भी सच्चाई अन्द पक्ष दा आंदुर सहकर्मी आदेव.<verse eid="3JN 1:8"/></para>
  <para style="s">दियुत्रिफेस अदिक दिमेत्रियुस</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9"/>ना मंडली इक येनारा लिखसीदिन, लेकीन दियुत्रिफेस जो आंदुर दा धोड्डेव आगोद चाहासतान, नामी ग्रहण माळालुन. <verse eid="3JN 1:9"/><verse number="10" style="v" sid="3JN 1:10"/>इदुरसाटी याग ना बराईन रा आऊन क्याल्सागोळ्द जो आव माळेत्यान, सुधी तोरसाईन, कि आव नाम बारा दा बेकार-बेकार मातगोळ माताळतान; अदिक इदुर मा भी संतोष ईला आगकु खुद अच वार्टुर इक ग्रहण माळालुन, अदिक आंदरी जो ग्रहण माळोद चाहासतार मना माळतान अदिक मंडली दा टु तेग्द बुळतान.<verse eid="3JN 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11"/>हे प्रिय, बुराई इन ईला लेकीन भलाई इन अनुयायी आगी. जो भलाई माळतान, आव परमेश्वर उन दी टु हुन; लेकीन जो बुराई माळतान, आव परमेश्वर उक नोळीदील.<verse eid="3JN 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12"/>देमेत्रियुस उन बारा दा सप्पा मुंदुर, उलटा सच्चाई भी खुद अच गवाही कोळ्त; अदिक नाव भी गवाही कोळतेव, अदिक नी जान्सत्या कि नाम गवाही सही आद.<verse eid="3JN 1:12"/></para>
  <para style="s">आखरी अभिवादन</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13"/>नानी नीनी हापाळ येनारा लिखसोद रा ईरोद, लेकीन स्याही अदिक कलम देल लिखसोद चाहासालीन. <verse eid="3JN 1:13"/><verse number="14" style="v" sid="3JN 1:14"/>लेकीन नानी आशा आद कि नीन से राटनेरी मुलाकात माळाईन, आग नाव आमने-सामने मातकात हेळाता.<verse eid="3JN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15"/>नीनी शांती सिक्त ईरूल.</para>
  <para style="p" vid="3JN 1:15">ईलेर संगी नीनी नमस्कार माळतार. अलेर संगीगोळ हेसुर ताकोम ताकोमकु नमस्कार माळ कोमेत.<verse eid="3JN 1:15"/></para>
  <chapter eid="3JN 1"/>
</usx>
