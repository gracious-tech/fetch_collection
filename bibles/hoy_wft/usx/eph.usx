<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Holiya</book>
  <para style="h">इफिसिगोळ</para>
  <para style="toc3">इफिसिगोळ</para>
  <para style="toc2">इफिसिगोळ</para>
  <para style="toc1">इफिसिगोळ हेसुर पौलुस प्रेरित उन चिट्ठी</para>
  <para style="mt2">इफिसियों के नाम पौलुस प्रेरित की पत्री</para>
  <para style="mt1">इफिसिगोळ हेसुर पौलुस प्रेरित उन चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">मसीह अन जनम इन साठ वर्ष पयले इफिसिगोळ चिट्ठी अदिक कुलुस्सिगोळ चिट्ठी लगभग सांगुळ लिख्सकु आगीत.</para>
  <para style="ip">प्रेरित पौलुस ईद सुचित माळतान कि आवा चिट्ठी इन लेखक हुन <char style="xt"><ref loc="EPH 1:1">१:१</ref></char> कुलुस्सिगोळ चिट्ठी इन घाई ईद चिट्ठी दा व्यक्तित्व शुभेच्छा नोळकु आगाल. तरी भी ज्यादा तर विधवानगोळ ईद मान्सतार कि पौलुस अच ईद चिट्ठी लिखसीदान. ईदा कारण प्रांत इन अलग अलग मंडली दा ईद चिट्ठी तिर्गुसकु वाचुसकु आगुल हिंग पौलुस उन ईरादा आग सकतद, याग आव ईद चिट्ठी लिख्सदुन आग पौलुस ईद हेळतान कि आव कैद दा ईरोन, <char style="xt"><ref loc="EPH 3:1">३:१</ref>; <ref loc="EPH 4:1">४:१</ref></char> अदिक <char style="xt"><ref loc="EPH 6:20">६:२०</ref></char> याग तिकिकुस इफिसिगोळ मंडली इक सिकली इफिसियों होगोन आग पौलुस ईद चिट्ठी आऊन कय दा कळुदुन <char style="xt"><ref loc="EPH 6:21-22">६:२१-२२</ref></char></para>
  <para style="ip">इफिसियों ऊंद हापाळ धोळ्द शयर ईरोद, आ समय एशिया माइनर प्रांत इन अद राजधानी ईरोद. शयर दा अर्तमिस हेसुर ईनव ग्रीक द्याव उन ऊंद धोळ्द मंदिर ईरोद यदुर कारण देल इफिसियों अक हापाळ प्रसिद्धी सिक्त, <char style="xt"><ref loc="ACT 19:23-31">प्रेरितगोळ १९:२३-३१</ref></char> ईद इफिसिगोळ मंडली सुरूवात वळ्लीद आत लेकीन बाद्दा कमजोर भी कांळ्सत <char style="xt"><ref loc="REV 2:1-7">प्रकाशितवाक्य २:१-७</ref></char> परमेश्वर तान लॉकुरी निवळुस्कु यीशु मसीह अन द्वारा ह्यांग आंदुरव पापगोळ से छुटकारा कोट्टुन ईद मात पौलुस उन चिट्ठी इन पयला भाग स्पष्ट माळतद, आव मंडली इन तुलना आ शरीर इन सांगुळ माळतान कि यार्द मस्तक मसीह अच हुन अदिक आव अद क्वाना अन्द कल्ल आ इमारत देल यार्द क्वाना अन्द कल्ल मसीह हुन किताब इन दुसरा भाग दा मसीह जीवन ह्यांग जीऊस पायजे ईदुर बारा दा हेळतान.</para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">१. पौलुस खुद इन परिचय कोटकु इफिसियों अक शुभेच्छा कोळतान. अध्याय <char style="ior"><ref loc="EPH 1:1-2">१:१-२</ref></char></para>
  <para style="io1">२. बाद्दा आ मंडली इन मसीह अन सांगुळ ह्यांग रिश्ता ईर पायजे <char style="ior"><ref loc="EPH 1:3-3:21">१:३–३:२१</ref></char></para>
  <para style="io1">३. बाद्दा पौलुस मसीह जीवन ह्यांग जीऊस पायजे ईदुर बारा दा हेळतान <char style="ior"><ref loc="EPH 4:1-6:20">४:१–६:२०</ref></char></para>
  <para style="io1">४. पौलुस आखरी शब्द दा चिट्ठी लिख्सकु खतम माळतान <char style="ior"><ref loc="EPH 6:21-24">६:२१-२४</ref></char></para>
  <chapter number="1" style="c" sid="EPH 1"/>
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१:१ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:19-21">प्रेरितगोळ १८:१९-२१</ref>; <ref loc="ACT 19:1">१९:१</ref></char>
    </note>नान पौलुस उन दी टु जो परमेश्वर उन इच्छा देल यीशु मसीह अन प्रेरित आन,</para>
  <para style="p" vid="EPH 1:1">आ पवित्र अदिक मसीह यीशु दा विश्वासी लॉकुर्द हेसुर जो इफिसुस दा आद:<verse eid="EPH 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2"/>नाम्द आप्प परमेश्वर अदिक प्रभु यीशु मसीह अन्द दी टु नीमी अनुग्रह अदिक शांती सिकतेला ईरूल.<verse eid="EPH 1:2"/></para>
  <para style="s">मसीह दा आत्मिक आशीषगोळ</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3"/>नाम्द प्रभु यीशु मसीह अन्द परमेश्वर अदिक आप्प उन धन्यवाद आगुल कि आव नामी मसीह दा स्वर्गीय जागागोळ दा सब प्रकार इन आत्मिक आशीष कोट्टुन. <verse eid="EPH 1:3"/><verse number="4" style="v" sid="EPH 1:4"/>ह्यांग आव नामी दुनिया अन उत्पत्ति टु पयला अदुर्दा नीवळुस कोंडान</para>
  <para style="p" vid="EPH 1:4">कि नाव आऊन हात्‍ती प्यार दा पवित्र अदिक निर्दोष आगुल. <verse eid="EPH 1:4"/><verse number="5" style="v" sid="EPH 1:5"/>अदिक तान इच्छा अन्द भला अभिप्राय इन अनुसार नामी तान साटी पयला टु ठहरूसदुन कि यीशु मसीह अन्द द्वारा नाव आऊन गोद पार आगुल, <verse eid="EPH 1:5"/><verse number="6" style="v" sid="EPH 1:6"/>कि आऊन आ अनुग्रह अन्द महिमा अन्द स्तुति आगुल, यारी आव नामी आ प्रिय दा सेंत-मेंत कोट्टुन. <verse eid="EPH 1:6"/><verse number="7" style="v" sid="EPH 1:7"/><note caller="+" style="x"><char style="xo" closed="false">१:७ </char><char style="xt" closed="false"><ref loc="COL 1:14">कुलुस्सिगोळ १:१४</ref></char></note>नामी अदुर्दा आऊन रक्ता अन द्वारा छुटकारा, मतलब अपराधगोळ्द माफी, आऊन आ अनुग्रह अन्द धन इन अनुसार सिक्याद, <verse eid="EPH 1:7"/><verse number="8" style="v" sid="EPH 1:8"/>यारी आव पुरा ग्यान अदिक समझ सहित</para>
  <para style="p" vid="EPH 1:8">नाम मा बहुतायत देल माळदुन. <verse eid="EPH 1:8"/><verse number="9" style="v" sid="EPH 1:9"/>यतिकी आव तान इच्छा अन्द भेद आ भला अभिप्राय इन अनुसार नामी हेळदुन, यारी आव खुद तान दा ठान्स कोंडीदुन <verse eid="EPH 1:9"/><verse number="10" style="v" sid="EPH 1:10"/>कि समयगोळ्द पुरा आगोद हिंग प्रबन्ध आगुल कि जो येनारा स्वर्ग दा आद अदिक जो येनारा पृथ्वी मा आद, सप्पा येनारा अद मसीह दा जमा माळुल.<verse eid="EPH 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11"/>अदुर्दा यदुर्दा नाव भी आऊन मनसा देल जो तान इच्छा अन्द मत इन अनुसार सप्पा येनारा माळतान, पयला टु ठहरूसकु आगकु मीरास बनसुल <verse eid="EPH 1:11"/><verse number="12" style="v" sid="EPH 1:12"/>कि नाव, यार पयला टु मसीह मा आशा ईटीदेव, आऊन महिमा अन्द स्तुति इन कारण आगुल.<verse eid="EPH 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 1:13"/>अदिक अदुर्दा नीम मा भी, याग नीव सच्चाई इन वचन केळदीर जो नीम्द उद्धार इन खुशखबरी आद अदिक यदुर मा नीव विश्वास माळदीर, वादा माळकु आत पवित्र आत्मा अन्द छाप हत्‍त. <verse eid="EPH 1:13"/><verse number="14" style="v" sid="EPH 1:14"/>परमेश्वर उन साटी पैस्या देल कोंडकु आग्यार आंदुर्द छुटकारा अन्द साटी नाम्द मीरास इन बयाना हुन, कि आऊन महिमा अन्द स्तुति आगुल.<verse eid="EPH 1:14"/></para>
  <para style="s">पौलुस उन प्रार्थना</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15"/>ई कारण, ना भी आ विश्वास इन बातणी केळकु जो नीम लॉकुर दा प्रभु यीशु मा आन अदिक सप्पा पवित्र लॉकुर मा प्यार प्रगट आद, <verse eid="EPH 1:15"/><verse number="16" style="v" sid="EPH 1:16"/>नीम साटी धन्यवाद माळोद बिळालीन, अदिक तान प्रार्थनागोळ दा नीमी याद माळतेला ईरतीन <verse eid="EPH 1:16"/><verse number="17" style="v" sid="EPH 1:17"/>कि नाम्द प्रभु यीशु मसीह अन्द परमेश्वर जो महिमा अन्द आप्प हुन, नीमी तान पहचान दा ग्यान अदिक प्रकाश इन आत्मा कोळुल, <verse eid="EPH 1:17"/><verse number="18" style="v" sid="EPH 1:18"/>अदिक नीम्द मन इन कण्णगोळ ज्योतिर्मय आगुल कि नीव जान्स कोमी कि आऊन बुलाहट इन आशा येन आद, अदिक पवित्र लॉकुर दा आऊन मीरास इन महिमा अन्द धन ह्यांग आद, <verse eid="EPH 1:18"/><verse number="19" style="v" sid="EPH 1:19"/>अदिक आऊन सामर्थ्य नाम दा जो विश्वास माळतार, याट महान आद, आऊन शक्ति इन प्रभाव इन आ कार्य अन्द अनुसार <verse eid="EPH 1:19"/><verse number="20" style="v" sid="EPH 1:20"/>जो आव मसीह दा माळदुन कि आऊक सोत्‍तुर दा टु जित्‍ता माळकु स्वर्गीय जागागोळ दा तान ऊम्मा कय दी कुर्सदुन <verse eid="EPH 1:20"/><verse number="21" style="v" sid="EPH 1:21"/>ताकी सब प्रकार इन प्रधानता, अदिक अधिकार, अदिक सामर्थ्य, अदिक प्रभुता अन्द, अदिक हर ऊंद हेसुर इन म्याकुच, जो ना सिर्फ ई दुनिया दा पर बरावाळा दुनिया दा भी ताकोमकु आदीन, कुर्सदुन; <verse eid="EPH 1:21"/><verse number="22" style="v" sid="EPH 1:22"/><note caller="+" style="x"><char style="xo" closed="false">१:२२ </char><char style="xt" closed="false"><ref loc="COL 1:18">कुलुस्सिगोळ १:१८</ref></char></note>अदिक सप्पा येनारा आऊन कालगोळ ल्यालमा माळ बुट्टुन; अदिक आऊक सब वस्तुगोळ मा श्रेष्ट ठहरूसकु मंडली इक कोट बुट्टुन, <verse eid="EPH 1:22"/><verse number="23" style="v" sid="EPH 1:23"/>ईद आऊन मय हुन, अदिक आऊन परिपुर्णता आद जो सब दा सब येनारा पुरा माळतान.<verse eid="EPH 1:23"/></para>
  <chapter eid="EPH 1"/>
  <chapter number="2" style="c" sid="EPH 2"/>
  <para style="s">मृत्यु टु जीवन दी</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">२:१ </char>
      <char style="xt" closed="false">
        <ref loc="COL 2:13">कुलुस्सिगोळ २:१३</ref>
      </char>
    </note>आव नीमी भी जित्‍ता माळदुन, जो तान अपराधगोळ अदिक पापगोळ्द कारण सोतकु ईरोर <verse eid="EPH 2:1"/><verse number="2" style="v" sid="EPH 2:2"/>यदुर मा नीव पयला ई दुनिया अन रीति मा, अदिक आकाश इन अधिकार इन शासक मतलब आ आत्मा अन्द अनुसार नळीर, जो ईग भी आग्या ईला मान्सावाळेर्द कार्य माळतान. <verse eid="EPH 2:2"/><verse number="3" style="v" sid="EPH 2:3"/>इंदुर दा नाव भी सप्पा अच मुंदुर पयला तान मय इन लालसागोळ दा दिन बितुसेव, अदिक मय अदिक मन इन इच्छागोळी पुरा माळेव, अदिक अन्य लॉकुर घाई स्वभाव देल सिट्ट इन औलाद ईरेव.<verse eid="EPH 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 2:4"/>लेकीन परमेश्वर जो दया अन्द धनी आन, तान आ धोळ प्यार इन कारण यार देल आव नाम से प्यार माळदुन, <verse eid="EPH 2:4"/><verse number="5" style="v" sid="EPH 2:5"/>याग नाव अपराधगोळ्द कारण सोतकु ईरेव रा नामी मसीह अन्द सांगुळ जित्‍ता माळदुन अनुग्रह देल अच नीम्द उद्धार आत, <verse eid="EPH 2:5"/><verse number="6" style="v" sid="EPH 2:6"/>अदिक मसीह यीशु दा आऊन सांगुळ नेगदुन, अदिक स्वर्गीय जागा दा आऊन सांगुळ कुर्सदुन <verse eid="EPH 2:6"/><verse number="7" style="v" sid="EPH 2:7"/>कि आव तान आ कृपा देल जो मसीह यीशु दा नाम मा आद, बरावाळा समय इन दुनिया दा तान अनुग्रह अन्द असीम धन तोर्सदुन. <verse eid="EPH 2:7"/><verse number="8" style="v" sid="EPH 2:8"/>यतिकी विश्वास इन भेंट इन द्वारा अनुग्रह देल अच नीम्द उद्धार आत, अदिक ईद नीम्द दी टु ईला, बल्‍की परमेश्वर उन दान हुन, <verse eid="EPH 2:8"/><verse number="9" style="v" sid="EPH 2:9"/>अदिक ना कर्मगोळ्द कारण, हिंग आगबाळुल कि यावारा घमण्ड माळुल. <verse eid="EPH 2:9"/><verse number="10" style="v" sid="EPH 2:10"/>यतिकी आव नामी माळ्यान, अदिक मसीह यीशु दा आ वळ्लीद क्याल्सागोळ्द साटी माळकु आगीर यारी परमेश्वर पयला टु नामी माळोर साटी तयार माळदुन.<verse eid="EPH 2:10"/></para>
  <para style="s">मसीह दा ऊंद</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11"/>ई कारण याद माळी कि नीव जो शारीरिक रीति देल गैरयहूदी आईर अदिक जो लॉकुर मय दा कय इन माळकु खतना देल खतनावाळेर कहलुस्तार, आंदुर नीम इक खतनारहित अनतार, <verse eid="EPH 2:11"/><verse number="12" style="v" sid="EPH 2:12"/>नीव लॉकुर आ समय मसीह टु अलग, अदिक इस्त्राएल इन प्रजा अन्द पद देल अलग माळकु आदीर, अदिक वादा अन्द वाचागोळ्द भागी ईला ईरोर, अदिक आशाहीन अदिक दुनिया दा मय रहित ईरोर. <verse eid="EPH 2:12"/><verse number="13" style="v" sid="EPH 2:13"/>लेकीन ईग मसीह यीशु दा नीव जो पयला दुर ईरीर, मसीह अन्द रक्ता अन द्वारा हात्‍ती आगेगीर. <verse eid="EPH 2:13"/><verse number="14" style="v" sid="EPH 2:14"/>यतिकी आवा नाम्द मेल हुन जो येढ्ढु मुंदरी ऊंद माळ कोंडुन अदिक अलग माळावाळा दिवार इक जो बीच दा ईरोद केडु बुट्टुन, <verse eid="EPH 2:14"/><verse number="15" style="v" sid="EPH 2:15"/><note caller="+" style="x"><char style="xo" closed="false">२:१५ </char><char style="xt" closed="false"><ref loc="COL 2:14">कुलुस्सिगोळ २:१४</ref></char></note>अदिक तान मय दा दुश्मनी मतलब अद व्यवस्था यदुर्द आग्यागोळ विधीगोळ्द रीति मा ईरव, मिटकुस बुट्टुन कि येढ्ढु देल तान दा ऊंद व्हाशोद मंळसा पैदा माळकु मेल माळसुस बुळुल, <verse eid="EPH 2:15"/><verse number="16" style="v" sid="EPH 2:16"/><note caller="+" style="x"><char style="xo" closed="false">२:१६ </char><char style="xt" closed="false"><ref loc="COL 1:20">कुलुस्सिगोळ १:२०</ref></char></note>अदिक क्रूस मा दुश्मनी इक नाश माळकु इदुर द्वारा येढ्ढु मुंदरी ऊंद मय माळकु परमेश्वर देल भेंट माळसुस्यान. <verse eid="EPH 2:16"/><verse number="17" style="v" sid="EPH 2:17"/>आव बंदकु नीमी जो दुर ईरीर अदिक आंदरी जो हात्‍ती ईरोर, येढ्ढु मुंदरी मेल मिलाप इन खुशखबरी केळ्सदुन. <verse eid="EPH 2:17"/><verse number="18" style="v" sid="EPH 2:18"/>यतिकी आऊन द्वारा नाव येढ्ढु मुंदुर्द ऊंद आत्मा दा आप्प उन हात्‍ती प्रवेश आगतद.<verse eid="EPH 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19"/>इदुरसाटी नीव ईग परदेशी अदिक मुसाफिर ईतीदील, लेकीन पवित्र लॉकुर्द संगी स्वदेशी अदिक परमेश्वर उन घराना दोर आगेदीर. <verse eid="EPH 2:19"/><verse number="20" style="v" sid="EPH 2:20"/>अदिक प्रेरितगोळ अदिक भविष्यवक्तागोळ्द पायवा मा, यार्द क्वाना अन्द कल्ल मसीह यीशु खुद अच आन, माळकु आगीर. <verse eid="EPH 2:20"/><verse number="21" style="v" sid="EPH 2:21"/>यदुर्दा पुरा रचना ऊंद सांगुळ मिलुसकु प्रभु दा ऊंद पवित्र मंदिर बन्सतेला होगतद, <verse eid="EPH 2:21"/><verse number="22" style="v" sid="EPH 2:22"/>यदुर्दा नीव भी आत्मा अन्द द्वारा परमेश्वर उन निवास स्थान आगोर साटी ऊंद सांगुळ माळकु आगतीर.<verse eid="EPH 2:22"/></para>
  <chapter eid="EPH 2"/>
  <chapter number="3" style="c" sid="EPH 3"/>
  <para style="s">गैरयहूदीगोळ दा पौलुस उन स्यावा</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1"/>ईदा कारण ना पौलुस जो नीव गैरयहूदीगोळ्द साटी मसीह यीशु दा बंदीन. <verse eid="EPH 3:1"/><verse number="2" style="v" sid="EPH 3:2"/>अगर नीव परमेश्वर उन आ अनुग्रह अन्द प्रबन्ध इन समाचार केळीदीर, जो नीम्द साटी नानी कोटकु आग्याद, <verse eid="EPH 3:2"/><verse number="3" style="v" sid="EPH 3:3"/>मतलब ईद कि अद भेद नान मा प्रकाशन इन द्वारा प्रगट आत, ह्यांग ना पयला अच थ्वाळासा दा लिख्सदीन, <verse eid="EPH 3:3"/><verse number="4" style="v" sid="EPH 3:4"/><note caller="+" style="x"><char style="xo" closed="false">३:४ </char><char style="xt" closed="false"><ref loc="COL 1:26">कुलुस्सिगोळ १:२६</ref>,<ref loc="COL 1:27">२७</ref></char></note>यारी नीव वाचुसकु जान्स सकतीर कि ना मसीह अन्द अद भेद यल ताका सम्सतीन. <verse eid="EPH 3:4"/><verse number="5" style="v" sid="EPH 3:5"/>जो अन्य समयगोळ दा मंळसागोळ्द औलादगोळ इक हिंग ईला हेळकु आगीत, ह्यांग कि आत्मा अन्द द्वारा ईग आऊन पवित्र प्रेरितगोळ अदिक भविष्यवक्तागोळ मा प्रगट माळकु आग्याद. <verse eid="EPH 3:5"/><verse number="6" style="v" sid="EPH 3:6"/>मतलब ईद कि मसीह यीशु दा खुशखबरी इन द्वारा गैरयहूदी लॉकुर मीरास दा हिस्सेदार, अदिक ऊंद अच मय इन अदिक वादा अन्द भागी आर.<verse eid="EPH 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7"/>ना परमेश्वर उन अनुग्रह अन्द आ दान इन अनुसार, जो आऊन सामर्थ्य अन्द प्रभाव इन अनुसार नानी कोटकु आग्याद, आ खुशखबरी इन सेवक बन्सदीन, <verse eid="EPH 3:7"/><verse number="8" style="v" sid="EPH 3:8"/>नान मा जो सप्पा पवित्र लॉकुर दा टु स्याणेर दा टु भी स्याणेव आईन, ईद अनुग्रह आत कि ना गैरयहूदीगोळ इक मसीह अन्द अगम्य धन इन खुशखबरी केळ्साईन, <verse eid="EPH 3:8"/><verse number="9" style="v" sid="EPH 3:9"/>अदिक सब मा ईद मात प्रकाशित माळुल कि आ भेद इन प्रबन्ध येन आद, जो सप्पा मुंदुर सृजनहार परमेश्वर दा सुरूवात टु गुप्त ईरोद. <verse eid="EPH 3:9"/><verse number="10" style="v" sid="EPH 3:10"/>ताकी ईग मंडली इन द्वारा, परमेश्वर उन अलग अलग प्रकार इन ग्यान आ प्रधानगोळी अदिक अधिकारीगोळ मा जो स्वर्गीय जागा दा आर, प्रगट माळकु आगुल. <verse eid="EPH 3:10"/><verse number="11" style="v" sid="EPH 3:11"/>आ अनन्त मंळसा अन्द अनुसार जो आव नाम प्रभु मसीह यीशु दा माळीदुन. <verse eid="EPH 3:11"/><verse number="12" style="v" sid="EPH 3:12"/>यदुर दा नामी आऊन मा विश्वास माळदुर देल साहस अदिक भरोसा अन्द सांगुळ परमेश्वर उन हात्‍ती बरोद अधिकार आद. <verse eid="EPH 3:12"/><verse number="13" style="v" sid="EPH 3:13"/>इदुरसाटी ना विनती माळतीन कि जो क्लेश नीम साटी नानी आगेत्याद, अदुर कारण साहस बिळबाळी, यतिकी अदुर दा नीम्द महिमा आद.<verse eid="EPH 3:13"/></para>
  <para style="s">मसीह अन्द प्यार</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14"/>ना ईदा कारण आ पृथ्वी मा आप्प उन मुंद ट्वांगरा टेक्सतीन, <verse eid="EPH 3:14"/><verse number="15" style="v" sid="EPH 3:15"/>यदुर देल स्वर्ग अदिक पृथ्वी मा, हर ऊंद घराना अन्द हेसुर ईटकु आगतद, <verse eid="EPH 3:15"/><verse number="16" style="v" sid="EPH 3:16"/>कि आव तान महिमा अन्द धन इन अनुसार नीमी ईद दान कोळुल कि नीव आऊन आत्मा देल तान बुळ्क इन मंळसातत्व दा सामर्थ्य हासिल माळकु बलवन्त आगतेला होगी; <verse eid="EPH 3:16"/><verse number="17" style="v" sid="EPH 3:17"/>अदिक विश्वास इन द्वारा मसीह नीम्द दिल दा कुरूल कि नीव प्यार दा जळ हुळकु अदिक पायवा हाक्‍कु, <verse eid="EPH 3:17"/><verse number="18" style="v" sid="EPH 3:18"/>सप्पा पवित्र लॉकुर्द सांगुळ भला-भाति समसोद शक्ति सिकुल कि आऊन चौळाई, अदिक लंबाई, अदिक ऊँचाई, अदिक गहराई याट आद, <verse eid="EPH 3:18"/><verse number="19" style="v" sid="EPH 3:19"/>अदिक मसीह अन्द आ प्यार इक जान्स सकी जो ग्यान देल अनजान आर कि नीव परमेश्वर उन पुरा भरपुरी ताका परिपुर्ण आगेगी.<verse eid="EPH 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20"/>ईग जो हिंग सामर्थी आन कि नाम्द विनती अदिक समझ देल मात्‍त यक्कुल क्याल्सा माळ सकतान, आ सामर्थ्य अन्द अनुसार जो नाम दा कार्य माळतान, <verse eid="EPH 3:20"/><verse number="21" style="v" sid="EPH 3:21"/>मंडली दा अदिक मसीह यीशु दा आऊन महिमा पीढ़ी टु पीढ़ी ताका हमेशा हमेशा आगतेला ईरूल. आमीन.<verse eid="EPH 3:21"/></para>
  <chapter eid="EPH 3"/>
  <chapter number="4" style="c" sid="EPH 4"/>
  <para style="s">मसीह अन मय दा एकता</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1"/>इदुरसाटी ना जो प्रभु दा बंदीन नीम से विनती माळतीन कि या बुलाहट देल नीव कारूकु आगीदीर, अदुर लायक व्यवहार माळी, <verse eid="EPH 4:1"/><verse number="2" style="v" sid="EPH 4:2"/><note caller="+" style="x"><char style="xo" closed="false">४:२ </char><char style="xt" closed="false"><ref loc="COL 3:12">कुलुस्सिगोळ ३:१२</ref>,<ref loc="COL 3:13">१३</ref></char></note>मतलब पुरा दीनता अदिक नम्रता सहित, अदिक धीरज हुळकु प्यार देल आबुर दाबुर्द सहन माळी; <verse eid="EPH 4:2"/><verse number="3" style="v" sid="EPH 4:3"/>अदिक मेल इन बंधन दा आत्मा अन्द एकता ईटोद यत्न माळी. <verse eid="EPH 4:3"/><verse number="4" style="v" sid="EPH 4:4"/>ऊंद अच मय आद अदिक ऊंद अच आत्मा; ह्यांग नीमी जो कारूकु आगीदीर तान कारूकु आगोर देल ऊंद अच आशा आद. <verse eid="EPH 4:4"/><verse number="5" style="v" sid="EPH 4:5"/>ऊंद अच प्रभु आन, ऊंद अच विश्वास ऊंद अच बपतिस्मा, <verse eid="EPH 4:5"/><verse number="6" style="v" sid="EPH 4:6"/>अदिक सब मुंदुरव ऊंद अच परमेश्वर अदिक आप्प आन, जो सप्पा मुंदुर म्याकुच अदिक सप्पा मुंदुर बीच दा अदिक सब मुंदुर दा आन.<verse eid="EPH 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7"/>लेकीन नाम दा टु हर ऊंद मंळसा अक मसीह अन्द दान इन परिमाण इन अनुसार अनुग्रह सिक्याद. <verse eid="EPH 4:7"/><verse number="8" style="v" sid="EPH 4:8"/>इदुरसाटी आव अनतान:</para>
  <para style="q1" vid="EPH 4:8">“आव ऊँचाई मा येरदुन</para>
  <para style="q2" vid="EPH 4:8">अदिक बंदीगोळ इक कटकु ओतुन,</para>
  <para style="q2" vid="EPH 4:8">अदिक मंळसागोळ इक दान कोट्टुन.”<verse eid="EPH 4:8"/></para>
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9"/>आऊन येरदुर देल, अदिक येन सिकतद सिर्फ ईद कि अद पृथ्वी इन ल्यालमा जागागोळ्द दा ईळसी भी दुन. <verse eid="EPH 4:9"/><verse number="10" style="v" sid="EPH 4:10"/>अदिक जो ईळदुन ईव आवा हुन जो पुरा आकाश टु म्याकुच येरे भी दुन कि सब येनारा परिपुर्ण माळुल. <verse eid="EPH 4:10"/><verse number="11" style="v" sid="EPH 4:11"/>आव थ्वाळासा लॉकुरी प्रेरित नियुक्त माळकु, अदिक थ्वाळासा लॉकुरी भविष्यवक्ता नियुक्त माळकु, अदिक थ्वाळासा लॉकुरी खुशखबरी केळावाळेर नियुक्त माळकु, अदिक थ्वाळासा लॉकुरी रखवाला अदिक उपदेशक नियुक्त माळकु कोट बुट्टुन, <verse eid="EPH 4:11"/><verse number="12" style="v" sid="EPH 4:12"/>यदुर देल पवित्र लॉकुर सिद्ध आगेगुल अदिक स्यावा अन्द क्याल्सा माळकु आगुल अदिक मसीह अन्द मय इक उन्नती सिक्‍कुल, <verse eid="EPH 4:12"/><verse number="13" style="v" sid="EPH 4:13"/>यागासताका कि नाव सब इन सब विश्वास अदिक परमेश्वर उन पार उन पहचान दा ऊंद आगबाळुल, अदिक ऊंद सिद्ध मंळसा आगबाळुल अदिक मसीह अन्द पुरा डील-डौल ताका ना वाळुसुल. <verse eid="EPH 4:13"/><verse number="14" style="v" sid="EPH 4:14"/>ताकी नाव मुंदु टु चिकोर ईरतीदील जो मंळसागोळ्द ठग-विद्या अदिक चतुराई देल, आंदुर भ्रम इन युक्तिगोळ्द अदिक उपदेश इन हर ऊंद ध्वाका देल उछलस्कु अदिक ईल अल तिर्गुसकु आगताव. <verse eid="EPH 4:14"/><verse number="15" style="v" sid="EPH 4:15"/>बल्‍की प्यार दा सच्चाई देल माताळतेला सब मातगोळ दा अदुर्दा जो ताल्ला आद, मतलब मसीह दा वाळुसतेला होगुल, <verse eid="EPH 4:15"/><verse number="16" style="v" sid="EPH 4:16"/><note caller="+" style="x"><char style="xo" closed="false">४:१६ </char><char style="xt" closed="false"><ref loc="COL 2:19">कुलुस्सिगोळ २:१९</ref></char></note>यदुर देल पुरा मय, हर ऊंद जोळ इन सहायता देल ऊंद सांगुळ मिलुसकु अदिक ऊंद सामर्थ्य सांगुळ गठुस्कु, आ प्रभाव उन अनुसार जो हर ऊंद अंग इन ठीक-ठीक कार्य माळोर द्वारा आऊन दा आगतद, तान तान इक वाळुसतद कि आव प्यार दा उन्नती माळतेला होगुल.<verse eid="EPH 4:16"/></para>
  <para style="s">मसीह दा व्हाशोद जीवन</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17"/>इदुरसाटी ना ईद अनतीन अदिक प्रभु दा आग्रह माळतीन कि ह्यांग गैरयहूदी लॉकुर तान मन इन अनर्थ रीति मा नळुतार, नीव ईगी टु बाक हिंग व्यवहार माळबाळेतीर. <verse eid="EPH 4:17"/><verse number="18" style="v" sid="EPH 4:18"/>यतिकी आंदुर बुद्धी भ्रष्ट आगेग्याद, अदिक आ अग्यानता अन्द कारण जो आंदुर दा आद अदिक आंदुर मन इन कठोरता अन्द कारण आंदुर परमेश्वर उन जीवन टु अलग माळकु आदुर; <verse eid="EPH 4:18"/><verse number="19" style="v" sid="EPH 4:19"/>अदिक आंदुर सुन्न आगकु लुचपन दा हतेदुर कि सब प्रकार इन खराब क्याल्सा लालसा देल माळुल.<verse eid="EPH 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20"/>पर नीव मसीह अन्द हिंग शिक्षा ताकोंडीदील. <verse eid="EPH 4:20"/><verse number="21" style="v" sid="EPH 4:21"/>बल्‍की नीव खराखुरा आऊंदा केळदीर अदिक, ह्यांग यीशु दा सच्चाई आद, अदुर दा कल्सकु भी आग्यार <verse eid="EPH 4:21"/><verse number="22" style="v" sid="EPH 4:22"/><note caller="+" style="x"><char style="xo" closed="false">४:२२ </char><char style="xt" closed="false"><ref loc="COL 3:9">कुलुस्सिगोळ ३:९</ref></char></note>कि नीव पिछला चाल चलन इक हाळोद मंळसातत्व अक जो भरमुसावळ्त अभिलाषागोळ्द अनुसार भ्रष्ट आगेगतद, ईळु बुळी <verse eid="EPH 4:22"/><verse number="23" style="v" sid="EPH 4:23"/>अदिक तान मन इन आत्मिक स्वभाव दा व्हाशोद बन्सतेला होगी, <verse eid="EPH 4:23"/><verse number="24" style="v" sid="EPH 4:24"/><note caller="+" style="x"><char style="xo" closed="false">४:२४ </char><char style="xt" closed="false"><ref loc="COL 3:10">कुलुस्सिगोळ ३:१०</ref></char></note>अदिक व्हाशोद मंळसातत्व अक हाक्‍क कोमी जो परमेश्वर उन अनुरूप सच्चाई इन न्यायीपन अदिक पवित्रता दा सजुस्कु आग्याद.<verse eid="EPH 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25"/>ई कारण ख्वाटा माताळोद बिटकु हर ऊंद मंळसा तान मान्ना हातळोर से सही माताळुल, यतिकी नाव आपस दा आबुर दाबुर अंग हुयेव. <verse eid="EPH 4:25"/><verse number="26" style="v" sid="EPH 4:26"/>सिट्ट रा माळी, पर पाप माळबाळी; सुर्य मुळका ताका नीम्द गुस्सा ईरबाळुल, <verse eid="EPH 4:26"/><verse number="27" style="v" sid="EPH 4:27"/>अदिक ना शैतान उक मवका कोळी. <verse eid="EPH 4:27"/><verse number="28" style="v" sid="EPH 4:28"/>काळताना माळावाळा बाक काळताना माळबाळुल, बल्‍की वळ्लीद क्याल्सा माळोर साटी तान कयगोळ देल मेहनत माळुल, इदुरसाटी कि यारी प्रयोजन आद आऊक कोळली आऊन हात्‍ती येनारा ईरूल. <verse eid="EPH 4:28"/><verse number="29" style="v" sid="EPH 4:29"/>यातोदु सही मात नीम्द बाय देल होळबाळुल, पर जरवत इन अनुसार अदा होळुल जो उन्नती इन साटी वळ्लीद ईरूल, ताकी आऊन से केळावाळेर मा अनुग्रह ईरूल. <verse eid="EPH 4:29"/><verse number="30" style="v" sid="EPH 4:30"/>परमेश्वर उन पवित्र आत्मा अक दुख माळबाळी, यदुर देल नीम मा छुटकारा अन्द दिन इन साटी छाप कोटकु आग्याद. <verse eid="EPH 4:30"/><verse number="31" style="v" sid="EPH 4:31"/>सब प्रकार इन कळवाहट, अदिक प्रकोप अदिक सिट्ट, अदिक कलह, अदिक अपमान, सप्पा बैरभाव समेत नीम से दुर माळकु आगुल. <verse eid="EPH 4:31"/><verse number="32" style="v" sid="EPH 4:32"/><note caller="+" style="x"><char style="xo" closed="false">४:३२ </char><char style="xt" closed="false"><ref loc="COL 3:13">कुलुस्सिगोळ ३:१३</ref></char></note>आबुर दाबुर मा कृपा माळी अदिक मेहरबान आगी, अदिक ह्यांग परमेश्वर मसीह दा नीम्द अपराध माफ माळदुन, हांग अच नीव भी आबुर दाबुर्द अपराध माफ माळी.<verse eid="EPH 4:32"/></para>
  <chapter eid="EPH 4"/>
  <chapter number="5" style="c" sid="EPH 5"/>
  <para style="s">ऊजुळ दा ईरोद</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1"/>इदुरसाटी प्रिय चिकोरगोळ घाई परमेश्वर उन अनुकरण माळी, <verse eid="EPH 5:1"/><verse number="2" style="v" sid="EPH 5:2"/>अदिक प्यार दा नळी ह्यांग मसीह भी नीम से प्यार माळदुन, अदिक नाम साटी तान तान इक सुखदायक सुगन्ध इन साटी परमेश्वर उन मुंद भेंट माळकु बलिदान माळ बुट्टुर.<verse eid="EPH 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3"/>ह्यांग पवित्र लॉकुर्द लायक आद. हांग नीम दा व्यभिचार अदिक यातोदु प्रकार इन अशुध्द क्याल्सा या लोभ इन मात भी आगबाळुल; <verse eid="EPH 5:3"/><verse number="4" style="v" sid="EPH 5:4"/>अदिक ना निर्लज्जता, ना मूढ़ता अन्द मातचीत माळदेव, ना मज्याक माळदेव; यतिकी ईव मातगोळ शोभा कोळालव, बल्‍की धन्यवाद अच केळकु आगुल. <verse eid="EPH 5:4"/><verse number="5" style="v" sid="EPH 5:5"/>यतिकी नीव ईद जान्सतीर कि यावारा व्यभिचारी, या अशुध्द जन, या लोभी मंळसा अन्द, जो मूर्ति इन पुजा माळावाळा अन बराबर आन, मसीह अदिक परमेश्वर उन राज्य दा मीरास ईल्लच.<verse eid="EPH 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6"/>यावारा नीमी व्यर्थ मातगोळ देल ध्वाका कोळबाळुल, यतिकी ईवा क्याल्सागोळ्द कारण परमेश्वर उन सिट्ट आग्या ईला मान्सावाळेर मा भळकुसतद. <verse eid="EPH 5:6"/><verse number="7" style="v" sid="EPH 5:7"/>इदुरसाटी नीव आंदुर सहभागी ईरबाळी. <verse eid="EPH 5:7"/><verse number="8" style="v" sid="EPH 5:8"/>यतिकी नीव रा पयला अंधकार ईरीर लेकीन ईग प्रभु दा ज्योति आईर, इदुरसाटी ज्योति इन औलाद इन घाई नळी <verse eid="EPH 5:8"/><verse number="9" style="v" sid="EPH 5:9"/>यतिकी ज्योति इन फल सब प्रकार इन भलाई, अदिक न्यायीपन, अदिक सच्चाई आद, <verse eid="EPH 5:9"/><verse number="10" style="v" sid="EPH 5:10"/>अदिक ईद परखुसी कि प्रभु उक येन भाऊसतद. <verse eid="EPH 5:10"/><verse number="11" style="v" sid="EPH 5:11"/>अंधकार इन निष्फल क्याल्सागोळ दा सहभागी ईरबाळी, बल्‍की अदुर मा उलाहना कोळी. <verse eid="EPH 5:11"/><verse number="12" style="v" sid="EPH 5:12"/>यतिकी आंदुर गुप्त क्याल्सागोळ्द चर्चा भी शरम इन मात आद. <verse eid="EPH 5:12"/><verse number="13" style="v" sid="EPH 5:13"/>पर यास क्याल्सागोळ मा उलाहना कोटकु आगतद अव सप्पा ज्योति टु प्रगट आगतद, यतिकी जो सप्पा येनारा अक प्रगट माळतद अद ज्योति हुन. <verse eid="EPH 5:13"/><verse number="14" style="v" sid="EPH 5:14"/>ई कारण आव अनतान,</para>
  <para style="q1" vid="EPH 5:14">“हे मिंगावाळा,</para>
  <para style="q2" vid="EPH 5:14">जाग्स अदिक मुर्दागोळ दा टु जित्‍ता येळ;</para>
  <para style="q1" vid="EPH 5:14">रा मसीह अन्द ज्योति नीन मा चमकुसीत.”<verse eid="EPH 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15"/>इदुरसाटी ध्यान देल नोळी, कि ह्यांग चाल नळुतीर: निर्बुद्धीगोळ्द घाई ईला पर बुद्धिमानगोळ्द घाई नळी. <verse eid="EPH 5:15"/><verse number="16" style="v" sid="EPH 5:16"/><note caller="+" style="x"><char style="xo" closed="false">५:१६ </char><char style="xt" closed="false"><ref loc="COL 4:5">कुलुस्सिगोळ ४:५</ref></char></note>मवका अक बार्र सम्सी, यतिकी दिन बुरा आव. <verse eid="EPH 5:16"/><verse number="17" style="v" sid="EPH 5:17"/>ई कारण निर्बुद्धी ईरबाळी, पर ध्यान देल सम्सी कि प्रभु उन इच्छा येन आद.<verse eid="EPH 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 5:18"/>अंगुर इन रास्सा टु मतवाला बन्सबाळी, यतिकी इदुर देल लुचपन आगतद, पर आत्मा देल परिपुर्ण आगतेला होगी, <verse eid="EPH 5:18"/><verse number="19" style="v" sid="EPH 5:19"/><note caller="+" style="x"><char style="xo" closed="false">५:१९ </char><char style="xt" closed="false"><ref loc="COL 3:16">कुलुस्सिगोळ ३:१६</ref>,<ref loc="COL 3:17">१७</ref></char></note>अदिक आपस दा भजन अदिक स्तुति हाळ अदिक आत्मिक हाळगोळ हाळतोगी, अदिक तान तान मन दा प्रभु उन मुंद हाळतेला अदिक कीर्तन माळतेला ईरी. <verse eid="EPH 5:19"/><verse number="20" style="v" sid="EPH 5:20"/>अदिक हमेशा सब मातगोळ्द साटी नाम्द प्रभु यीशु मसीह अन्द हेसुर देल परमेश्वर आप्प उन धन्यवाद माळतेला ईरी.<verse eid="EPH 5:20"/></para>
  <para style="s">गांड्ड अदिक हिंग्स</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21"/>मसीह अन्द अंज्क देल आबुर दाबुर्द हात्‍ती ईरी.<verse eid="EPH 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">५:२२ </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:18">कुलुस्सिगोळ ३:१८</ref>; <ref loc="1PE 3:1">१ पतरस ३:१</ref></char>
    </note>हे हिंग्सुरा, तान तान गांड्ड उन हिंग हात्‍ती ईरी जसा प्रभु उन. <verse eid="EPH 5:22"/><verse number="23" style="v" sid="EPH 5:23"/>यतिकी गांड्ड हिंग्स उन ताल्ला हुन ह्यांग कि मसीह मंडली इन ताल्ला आन अदिक खुद अच मय इन उद्धारकर्ता आन. <verse eid="EPH 5:23"/><verse number="24" style="v" sid="EPH 5:24"/>पर ह्यांग मंडली मसीह अन्द हात्‍ती आद, हांग अच हिंग्सुर भी हर मात दा तान तान गांड्ड उन हात्‍ती ईरूल.<verse eid="EPH 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">५:२५ </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:19">कुलुस्सिगोळ ३:१९</ref>; <ref loc="1PE 3:7">१ पतरस ३:७</ref></char>
    </note>हे गांड्डुरा, तान तान हिंग्सुर से प्यार ईटी ह्यांग मसीह भी मंडली से प्यार माळकु तान तान इक अदुर साटी कोट बुट्टुन <verse eid="EPH 5:25"/><verse number="26" style="v" sid="EPH 5:26"/>कि आऊक वचन इन द्वारा नीर इन मयतोळदुर देल शुद्ध माळकु पवित्र माळी, <verse eid="EPH 5:26"/><verse number="27" style="v" sid="EPH 5:27"/>अदिक आऊक ऊंद हिंग तेजस्वी मंडली माळकु तान हात्‍ती निदुर्सुल, यदुर दा ना कलंक, ना झुर्री, ना यातोदारा अदिक हिंग वस्तु ईरूल बल्‍की पवित्र अदिक निर्दोष ईरूल. <verse eid="EPH 5:27"/><verse number="28" style="v" sid="EPH 5:28"/>ईदा प्रकार उचित आद कि गांड्ड तान तान हिंग्सुर से तान मय इन घाई प्यार ईटली पायजे. जो तान हिंग्स उन से प्यार ईटतान, आव तान तान से प्यार ईटतान. <verse eid="EPH 5:28"/><verse number="29" style="v" sid="EPH 5:29"/>यतिकी याऊ यागलु तान मय देल दुश्मनी ईटीदिल बल्‍की अदुर्द पालन-पोषण माळतान, जसा मसीह भी मंडली इन सांगुळ माळतान. <verse eid="EPH 5:29"/><verse number="30" style="v" sid="EPH 5:30"/>इदुरसाटी कि नाव आऊन मय इन अंग हुयेव. <verse eid="EPH 5:30"/><verse number="31" style="v" sid="EPH 5:31"/>“ई कारण मंळसा तान मोय-आप्प उक बिटकु तान हिंग्स उन सांगुळ ईत्‍तान, अदिक आंदुर येढ्ढु ऊंद तन आदार.” <verse eid="EPH 5:31"/><verse number="32" style="v" sid="EPH 5:32"/>ईद भेद रा धोळ आद, पर ना ईल मसीह अदिक मंडली इन बारा दा अनतीन. <verse eid="EPH 5:32"/><verse number="33" style="v" sid="EPH 5:33"/>पर नीम दा टु हर ऊंद तान हिंग्स उन से तान घाई प्यार ईटुल, अदिक हिंग्स भी तान गांड्ड उन आदर माळुल.<verse eid="EPH 5:33"/></para>
  <chapter eid="EPH 5"/>
  <chapter number="6" style="c" sid="EPH 6"/>
  <para style="s">मोय-आप्प अदिक चिकोर</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">६:१ </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:20">कुलुस्सिगोळ ३:२०</ref>
      </char>
    </note>हे चिकोरगोळा, प्रभु दा तान मोय-आप्प उन आग्याकारी बन्सी, यतिकी ईद उचित आद. <verse eid="EPH 6:1"/><verse number="2" style="v" sid="EPH 6:2"/>“तान मोय अदिक आप्प उन आदर माळ ईद पयला आग्या हुन यदुर सांगुळ वादा भी आद. <verse eid="EPH 6:2"/><verse number="3" style="v" sid="EPH 6:3"/>कि अपमान भला आगुल, अदिक नी पृथ्वी मा हापाळ दिन ताका जित्‍ता ईर.” <verse eid="EPH 6:3"/><verse number="4" style="v" sid="EPH 6:4"/><note caller="+" style="x"><char style="xo" closed="false">६:४ </char><char style="xt" closed="false"><ref loc="COL 3:21">कुलुस्सिगोळ ३:२१</ref></char></note>हे चिकोरवाळेरा, तान चिकोर इक गुस्सा तरगोळबाळी लेकीन प्रभु उन शिक्षा अदिक चेतावनी कोळतेला आंदुर्द पालन-पोषण माळी.<verse eid="EPH 6:4"/></para>
  <para style="s">स्वामी अदिक दास</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">६:५ </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:22-25">कुलुस्सिगोळ ३:२२-२५</ref>
      </char>
    </note>हे दासगोळा, जो लॉकुर ई दुनिया दा नीम स्वामी आर, तान मन इंद सही देल अंज्क अदिक नळ्गतेला, ह्यांग मसीह अन्द हांगा आंदुर्द भी आग्या मान्सी. <verse eid="EPH 6:5"/><verse number="6" style="v" sid="EPH 6:6"/>मंळसागोळी खुश माळावाळेर घाई तोरसोर साटी स्यावा माळबाळी, लेकीन मसीह अन्द दासगोळ घाई अंतर आत्मा देल परमेश्वर उन इच्छा मा नळी, <verse eid="EPH 6:6"/><verse number="7" style="v" sid="EPH 6:7"/>अदिक आ स्यावा अक मंळसागोळ्द ईला लेकीन प्रभु उन स्यावा जान्सकु खरा मन देल माळी. <verse eid="EPH 6:7"/><verse number="8" style="v" sid="EPH 6:8"/>यतिकी नीव जान्सतीर कि हर मंळसा ह्यांगारा वळ्लीद क्याल्सा माळ्यान, या रा दास ईरूल या रा स्वतंत्र, प्रभु से हांगा हासिल माळ्यान. <verse eid="EPH 6:8"/><verse number="9" style="v" sid="EPH 6:9"/><note caller="+" style="x"><char style="xo" closed="false">६:९ </char><char style="xt" closed="false"><ref loc="COL 4:1">कुलुस्सिगोळ ४:१</ref>; </char><char style="xt" closed="false"><ref loc="COL 3:25">कुलुस्सिगोळ ३:२५</ref></char></note>हे स्वामीगोळा, नीव भी धमकीगोळ कोळव बिटकु आंदुर सांगुळ हांग अच व्यवहार माळी; यतिकी नीव जान्सतीर कि आंदुर अदिक नीम येढ्ढु मुंदुरव स्वामी स्वर्ग दा आन, अदिक आव यारदु पक्षपात माळालुन.<verse eid="EPH 6:9"/></para>
  <para style="s">आत्मिक लळाई इन औजार</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10"/>इदुरसाटी प्रभु दा अदिक आऊन शक्ति इन प्रभाव दा ताकतवर बन्सी. <verse eid="EPH 6:10"/><verse number="11" style="v" sid="EPH 6:11"/>परमेश्वर उन सप्पा हथियार हाक्‍क बुळी कि नीव शैतान उन युक्तिगोळ मुंद निदुरकु ईर सकीर. <verse eid="EPH 6:11"/><verse number="12" style="v" sid="EPH 6:12"/>यतिकी नाम्द ईद मल्लयुद्ध रक्ता अदिक मास देल ईला लेकीन प्रधानगोळ देल, अदिक अधिकारीगोळ देल, अदिक ई दुनिया अन अंधकार इन शासकगोळ देल अदिक आ दुष्टता अन्द आत्मिक सेनागोळ देल आद जो आकाश दा आव. <verse eid="EPH 6:12"/><verse number="13" style="v" sid="EPH 6:13"/>इदुरसाटी परमेश्वर उन पुरा हथियार कट कोमी कि नीव बुरा दिन दा सामना माळ सकी, अदिक सप्पा येनारा पुरा माळकु संची ईर सकी. <figure style="fig" alt="Roman soldier" file="lb00196c.tif" size="col" copy="Horace Knowles ©" ref="६:१०">रोमन सैनिक</figure><verse eid="EPH 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 6:14"/>इदुरसाटी सच्चाई देल तान नेळु कसुसकु, अदिक न्यायीपन इन कवच हाक्‍कु, <verse eid="EPH 6:14"/><verse number="15" style="v" sid="EPH 6:15"/>अदिक कालगोळ दा मेल इन खुशखबरी इन तयारी इन जुता हाक्‍कु; <verse eid="EPH 6:15"/><verse number="16" style="v" sid="EPH 6:16"/>अदिक ई सब मुंदुर सांगुळ विश्वास इन ढाल हुडुकु स्थिर ईरी यदुर देल नीव आ दुष्ट इन सब होततेला तीरगोळ इक नुनाक सकी. <verse eid="EPH 6:16"/><verse number="17" style="v" sid="EPH 6:17"/>अदिक उद्धार इन टोप, अदिक आत्मा अन्द तलवार, जो परमेश्वर उन वचन हुन, ग्रहण माळकोमी. <verse eid="EPH 6:17"/><verse number="18" style="v" sid="EPH 6:18"/>हर समय अदिक हर प्रकार देल आत्मा दा प्रार्थना, अदिक विनती माळतेला ईरी, अदिक इदुरसाटी जाग्सतेला ईरी कि सब पवित्र लॉकुर्द साटी लगातार विनती माळतेला ईरी, <verse eid="EPH 6:18"/><verse number="19" style="v" sid="EPH 6:19"/>अदिक नान साटी भी कि नानी माताळोद समय हिंग प्रबल वचन कोटकु आगुल कि ना साहस इन सांगुळ खुशखबरी इन भेद खोलसोद कार्य माळ सकाईन, <verse eid="EPH 6:19"/><verse number="20" style="v" sid="EPH 6:20"/>ई खुशखबरी इन खातिर ना शंकली देल जकळुसकु राजस्वर्गदूत हुईन; हालाकि ईग ना जयल दा आईन. प्रार्थना माळी कि ना खुशखबरी इन बारा दा माताळली साहसी आग सकतीन ईद जरूरी आद जसा कि ना आईन.<verse eid="EPH 6:20"/></para>
  <para style="s">आखरी अभिवादन</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">६:२१ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 20:4">प्रेरितगोळ २०:४</ref>; <ref loc="2TI 4:12">२ तीमुथियुस ४:१२</ref></char>
    </note>
    <note caller="+" style="x">
      <char style="xo" closed="false">६:२१ </char>
      <char style="xt" closed="false">
        <ref loc="COL 4:7">कुलुस्सिगोळ ४:७</ref>,<ref loc="COL 4:8">८</ref></char>
    </note>तुखिकुस, जो प्रिय वार्ट अदिक प्रभु दा विश्वासयोग्य सेवक आन, नीमी सब मातगोळ हेळ्यान कि नीव भी नान दशा जान्सी कि ना ह्यांग ईरतीन. <verse eid="EPH 6:21"/><verse number="22" style="v" sid="EPH 6:22"/>आऊक ना नीम्द हात्‍ती इदुरसाटी कळुदीन कि नीव नाम्द दशा अक जान्सी, अदिक आव नीम्द मनगोळ इक शांती कोळुल.<verse eid="EPH 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23"/>परमेश्वर आप्प अदिक प्रभु यीशु मसीह अन्द दी टु वार्टुरी शांती अदिक विश्वास सहित प्यार सिकुल. <verse eid="EPH 6:23"/><verse number="24" style="v" sid="EPH 6:24"/>जो नाम्द प्रभु यीशु मसीह टु खरा प्यार ईटतार, आ सब मा अनुग्रह आगतेला ईरूल.<verse eid="EPH 6:24"/></para>
  <chapter eid="EPH 6"/>
</usx>
