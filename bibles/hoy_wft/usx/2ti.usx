<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Holiya</book>
  <para style="h">२ तीमुथियुस</para>
  <para style="toc3">२ तीमुथियुस</para>
  <para style="toc2">२ तीमुथियुस</para>
  <para style="toc1">तीमुथियुस उन हेसुर पौलुस प्रेरित उन दुसरा चिट्ठी</para>
  <para style="mt2">तीमुथियुस के नाम पौलुस प्रेरित की दूसरी पत्री</para>
  <para style="mt1">तीमुथियुस उन हेसुर पौलुस प्रेरित उन दुसरा चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">दुसरा तीमुथियुस उन किताब प्रेरित पौलुस उन दुसरा चेला तीमुथियुस उन साटी दुसरा चिट्ठी हुन. दुसरा तीमुथियुस पौलुस उन जीवन इन आखरी दा लिख्सकु आगीत. ई समय रोम दा आऊक कैद माळकु आगीत <char style="xt"><ref loc="2TI 1:16">१:१६</ref></char> पौलुस तीमुथियुस उन सांगुळ घनिष्ठ संबंध ईटदुन अदिक आऊक पार उन रूप दा संदर्भित माळदुन. <char style="xt"><ref loc="PHP 2:22">फिलिप्पिगोळ २:२२</ref>,</char> <char style="xt"><ref loc="1TI 1:2">१ तीमुथियुस १:२</ref>; <ref loc="1TI 1:18">१:१८</ref></char></para>
  <para style="ip">ईद पौलुस उन नाक चिट्ठी दा टु ऊंद हुन याऊक मंडली इन बजाय यातारा मंळसा अक संबोधित माळकु आगतद. अन्य हिंग मुर चिट्ठी गोळ आव ह्यांग कि पयला तीमुथियुस, तीतुस अदिक फिलिप्पी. आ समय इन दौरान येढ्ढ तीमुथियुस लिख्सकु आगीदव, रोमन साम्राज्य देल मसीहगोळी सतुस्कु आगोद. शायद ईदा कारण ईरोद कि पौलुस जयल दा ईरोन अदिक तीमुथियुस उक कठिनाई इंद सामना माळोद निर्देश कोळोन. पयला तीमुथियुस दा, पौलुस तीमुथियुस उक ख्वाटा गुरुगोळ बारा दा हापाळ चेतावनीगोळ कोट्टुन <char style="xt"><ref loc="1TI 1:16-18">१ तीमुथियुस १:१६-१८</ref></char> आव तीमुथियुस उक भी हेळतान कि मुंद कठिन समय ईत्‍तव <char style="xt"><ref loc="2TI 3:1">३:१</ref></char></para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. पौलुस तीमुथियुस उक बधाई कोळतान अदिक बाक आऊक प्रोत्साहित माळतान <char style="ior"><ref loc="2TI 1:1-18">१:१-१८</ref></char></para>
  <para style="io1">२. आग आव तीमुथियुस उक मुंद वाळुसोर साटी चुनौती कोळतान <char style="ior"><ref loc="2TI 2:1-13">२:१-१३</ref></char></para>
  <para style="io1">३. ईदुर बाद्दा आव आंदरी थ्वाळासा साधारण निर्देश कोळतान <char style="ior"><ref loc="2TI 2:14-26">२:१४-२६</ref></char></para>
  <para style="io1">४. बाक आव भविष्य अन घटनागोळ अदिक जवाब कोळोद सही तरीका अन बारा दा चेतावनी कोळतान <char style="ior"><ref loc="2TI 3:1">३:१</ref>; <ref loc="2TI 4:8">४:८</ref></char></para>
  <para style="io1">५. पौलुस तीमुथियुस उन साटी येनारा व्यक्तिगत टिप्पणिगोळ सांगुळ चिट्ठी खतम माळतान <char style="ior"><ref loc="2TI 4:9-22">४:९-२२</ref></char></para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />पौलुस इन दी टु जो परमेश्वर उन इच्छा देल मसीह यीशु उन प्रेरित आन, अदिक यारी यीशु मसीह दा ऊंद आगोर साटी वादा अन प्रचार माळोर साटी कळ्यान,<verse eid="2TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TI 1:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:२ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 16:1">प्रेरितगोळ १६:१</ref>
      </char>
    </note>प्रिय पार तीमुथियुस उन हेसुर:</para>
  <para style="p" vid="2TI 1:2">परमेश्वर आप्प अदिक नामव प्रभु मसीह यीशु उन दी टु नीनी अनुग्रह अदिक दया अदिक शांती सिकतेला ईरूल.<verse eid="2TI 1:2" /></para>
  <para style="s">धन्यवाद अदिक प्रोत्साहन</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />याता परमेश्वर उन स्यावा ना तान आप्प दादागोळ रीति मा शुद्ध विवेक देल माळतीन, आऊन धन्यवाद आगुल अदिक ईळ्लक हागुल याग ना प्रार्थनागोळ दा नीमी हमेशा याद माळतीन, अदिक आऊक धन्यवाद माळतीन. <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />अदिक नीन कण्ण दाकळव नीर इन याद माळ माळकु दिल देल नीनी भेंट माळोद लालच ईटतीन कि खुशी देल तुमेगाईन. <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" /><note caller="+" style="x"><char style="xo" closed="false">१:५ </char><char style="xt" closed="false"><ref loc="ACT 16:1">प्रेरितगोळ १६:१</ref></char></note>ना नींद आ खरा विश्वास इक याद माळतीन, जो पयले नीन आजी लोईस अदिक नीन मोय यूनीके दा ईरोद, अदिक नानी पुरा यकीन आद कि अदा विश्वास नीन दा भी आद. <verse eid="2TI 1:5" /><verse number="6" style="v" sid="2TI 1:6" />ईदा कारण ना नीनी याद कोळतीन कि नी आ वरदान इक जित्‍ता ईट जो नीन म्याकुच नांद कय ईटदुर द्वारा परमेश्वर नीनी कोटान. <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />यतिकी परमेश्वर नामी अंज्क इन ईला लेकीन सामर्थ्य अदिक प्यार अदिक संयम इन आत्मा कोटान.<verse eid="2TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8" />इदुरसाटी नामव प्रभु उन गवाही देल, अदिक नान देल जो मसीह अन कैदी आईन, लज्जित आगबाळ, लेकीन आ सामर्थ्य जो परमेश्वर नीनी कोटान अदुर अनुसार खुशखबरी साटी नान सांगुळ दुख नेगु <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />याव नामी ऊळस्यान अदिक पवित्र जीवन जीऊसोर साटी नामी कारदुन, अदिक ईद नाम क्याल्सा अन अनुसार ईला लेकीन आऊन उद्देश अदिक अनुग्रह अन अनुसार आद. आव ईद अनुग्रह नाम मा माळ्यान मतलब प्रभु यीशु मसीह अन द्वारा काल इन सुरूवात देल नाम मा आग्याद, <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />लेकीन ईग नाम उद्धार माळावाळा मसीह यीशु उन प्रगट आगोद द्वारा प्रगटीत आत, याव मृत्यु उन सामर्थ्य अन नाश माळदुन अदिक जीवन इक खुशखबरी इन द्वारा प्रगट माळदुन.<verse eid="2TI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:११ </char>
      <char style="xt" closed="false">
        <ref loc="1TI 2:7">१ तीमुथियुस २:७</ref>
      </char>
    </note>यार साटी परमेश्वर नानी प्रेरित, अदिक शिक्षा कोळावाळा नियुक्त माळदुन, ताकी ना खुशखबरी इन प्रचार माळाईन. <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />ई कारण ना ई दुखगोळी भी नेगुतीन, लेकीन नाचालीन, यतिकी ना आऊक यार मा ना विश्वास माळदीन, अरूतीन; अदिक नानी विश्वास आद कि आव नांद धरोवर इंद आ दिन ताका रखवाली माळ सकतान. <verse eid="2TI 1:12" /><verse number="13" style="v" sid="2TI 1:13" />जो सही मातगोळ नी नान बाय देल केळ्या अवरी आ विश्वास अदिक प्यार इन सांगुळ, जो मसीह यीशु दा आद, तान आदर्श माळकु ईट, <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />अदिक पवित्र आत्मा अन द्वारा जो नाम दा समुस्कु आद, ई वळ्लीद मातगोळ रखवाली माळ.<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />नी जान्सत्या कि आसिया नगर वाळेर सप्पा मुंदुर नान से तिर्गेग्यार, यारदा फूगिलुस अदिक हिरमुगिनेस आर. <verse eid="2TI 1:15" /><verse number="16" style="v" sid="2TI 1:16" />उनेसिफुरूस उन घराना मा प्रभु दया माळुल, यतिकी आव हापाळ अनली नानी सुख पोहचुस्यान, अदिक आव नान शंकलीगोळ दा ईत्‍तुर देल नाचीदिल. <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />लेकीन याग आव रोम दा बंदुन, रा यागासताका ना सिकिदील आगासताका आव नानी ढुंढ्सतेला ईत्‍तुन, अदिक नान से मुलाकात माळदुन <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />प्रभु माळुल कि आ दिशी आऊन मा प्रभु उन दया आगुल अदिक जो जो स्यावा आव इफिसुस दा माळ्यान अवरी भी नी वळ्लीद देल जान्सत्या.<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="s">मसीह यीशु उन स्वामीभक्त सैनिक</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />इदुरसाटी हे नान पारा, नी आ अनुग्रह देल जो मसीह यीशु दा आद, बलवन्त आगेग, <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />अदिक जो शिक्षागोळ नी हापाळ सा गवाहगोळ मुंद नान से केळ्या, अवरी विश्वासी मंळसागोळी सौप्स बुळ; जो दुसरा अक भी कलसोद लायक ईरूल.<verse eid="2TI 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3" />मसीह यीशु उन वळ्लीद योद्धा अन घाई नान सांगुळ दुख नेगु. <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />याग यावारा योद्धा लळाई मा होगतान, रा इदुरसाटी कि आऊक जो भरती माळ्यार आंदरी खुश माळुल, आव तान तान इक दुनिया अन क्याल्सागोळ दा फसुसालुन. <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />बाक अखाळा दा लळुसावाळा अगर नियम इन अनुसार लळुसालुन रा ईनाम सीक सकाल. <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />जो मयनती किसान मयनत माळतान, रा काय इन अंश पयले आऊक सीक पायजे. <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />जो ना अनतीन ई सप्पा मातगोळ मा ध्यान कोळ, अदिक प्रभु नीनी सप्पा मातगोळ्द समझ कोळुल.<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />यीशु मसीह अक याद ईट, जो दाऊद उन वंश देल आग्यान अदिक सोत्‍तुर दा टु जित्‍ता आदुन, अदिक ईद नान खुशखबरी इन अनुसार आद. <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />यार साटी ना कुकर्मी इन घाई दुख नेगुतीन, ईल ताका कि बंधन भी आईन; लेकीन परमेश्वर उन वचन कैद हैलेच. <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />ई कारण ना निवळुस्द लॉकुर साटी सप्पा येनारा सहन माळतीन, कि आंदरी भी आ उद्धार जो मसीह यीशु दा आद अनन्त महिमा अन्द सांगुळ सिकुल. <verse eid="2TI 2:10" /><verse number="11" style="v" sid="2TI 2:11" />ईद मात खरा आद,</para>
  <para style="q1" vid="2TI 2:11">कि अगर नाव आऊन सांगुळ सोतोगेव,</para>
  <para style="q2" vid="2TI 2:11">रा आऊन सांगुळ जित्‍ता भी आदेव;<verse eid="2TI 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2TI 2:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२:१२ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:33">मत्ती १०:३३</ref>; <ref loc="LUK 12:9">लूका १२:९</ref></char>
    </note>अगर नाव धीरज देल सहन माळ्त ईत्‍तेव,</para>
  <para style="q2" vid="2TI 2:12">रा आऊन सांगुळ राज्य भी माळेव;</para>
  <para style="q1" vid="2TI 2:12">अगर नाव आऊन इनकार माळेव,</para>
  <para style="q2" vid="2TI 2:12">रा आव भी नाम इनकार माळ्यान;<verse eid="2TI 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 2:13" />अगर नाव अविश्वासी भी आयेव,</para>
  <para style="q2" vid="2TI 2:13">तरी भी आव विश्वासयोग्य बन्सकु ईरतान,</para>
  <para style="q2" vid="2TI 2:13">यतिकी आव खुद तान इनकार माळ सकालुन.<verse eid="2TI 2:13" /></para>
  <para style="s">वळ्लीद कारीगर</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />ई मातगोळ्द याद आंदरी तोर्स अदिक प्रभु उन मुंद विश्वास देल हेळ कि शब्दगोळ मा तर्क-वितर्क माळतोग बाळुल, यऊर देल येनु फायदा आगाल उलटा केळावाळेर्द नाश आगेगतद. <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />तान तान इक परमेश्वर उन ग्रहण माळा लायक अदिक हिंग क्याल्सा माळावाळा ठहरूसोद कोशिश माळ, जो नाच्क ईला पायजे, अदिक जो सच्चाई इन वचन इक बराबर रीति देल क्याल्सा दा तरतोगुल. <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />लेकीन बेकार मातगोळ देल ऊळ्दकु ईर, यतिकी हिंग लॉकुर मात्‍त यक्कुल अभक्ति दा वाळुस्त ईत्‍तार, <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />अदिक आंदुर वचन हुळ्तकु दुख घाई फैलुस्त होदित. हुमिनयुस अदिक फिलेतुस आंदुर दा टु आर, <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />जो ईद अंदकु कि पुनरूत्थान आगेग्याद सच्चाई इन हादी टु काळदोग्यार, अदिक यास मुंदुर्द विश्वास इक नाश माळ बुळतार. <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" />तरी भी परमेश्वर उन पक्‍का पायवा बन्सकु ईरतद, अदिक आऊन मा ईद छाप हतकु आद: “प्रभु तान लॉकुरी अरूतान,” अदिक “जो यावारा प्रभु उन हेसुर ताकोमतान, आव अन्याय देल ऊळ्दकु ईरूल.”<verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />धोळ मान्या सिर्फ व्हान्ना-बेळ्ली इंद अच ईला, लेकीन हुळ्ली अदिक मुण्ण इन भी गळग्या ईरताव; यातारा-यातारा आदर, अदिक यातारा-यातारा अनादर इन साटी. <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />अगर यावारा तान तान इक ईऊर देल शुद्ध माळ्यान, रा अद आदर इन गळग्या मात्‍त पवित्र ठहरूसीत; अदिक स्वामी इन क्याल्सी बंदीत, अदिक सप्पा वळ्लीद क्याल्सा साटी तयार आदीत. <verse eid="2TI 2:21" /><verse number="22" style="v" sid="2TI 2:22" />हारोदपन इन मोहमाया देल ओळ, अदिक जो शुद्ध मन देल प्रभु उन हेसुर ताकोमतार आंदुर सांगुळ न्याय, अदिक विश्वास, अदिक प्यार, अदिक मेल मिलाप इन हिंद हत. <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />लेकीन मूर्खपन अदिक अविद्या अन्द विवादगोळ देल अलग ईर, यतिकी नी जान्सत्या कि ईऊर देल झगळा निर्माण आगताव. <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />प्रभु उन दास उक झगळेलु ईला ईर पायजे, लेकीन आव सप्पा मुंदुर सांगुळ मुलायम अदिक शिक्षा दा निपुण अदिक सहन माळावाळा ईरूल. <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />आव विरोध माळावाळेर इक नम्रता देल समझुसुल, येन मालूम परमेश्वर आंदरी मन तिर्गुसोद मन कोळुल कि आंदुर भी सच्चाई इक अरूल, <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />अदिक आंदुर सचेत आगकु शैतान उन फासा दा टु बिट्टोगुल. याव आंदरी आंदुर्द इच्छा पुरा माळोर साटी बंदी माळदुन.<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s">आखरी दिन</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />लेकीन ईद याद ईट कि आखरी दिनगोळ दा कठिन समय बंदव. <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />यतिकी मंळसा मतलबी, धन इन लालची, घमण्ड माळावाळेर, अभिमानी, अपमान माळावाळेर, मोय-आप्पुर्द आग्या कडावाळेर, एहसान मारावाळेर, अपवित्र, <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />प्यार ईला माळावाळेर, माफ ईला माळावाळेर, अपमान माळावाळेर, असंयमी, कठोर, भलाई इन दुश्मन, <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />विश्वासघात माळावाळेर, लापरवाह, घमण्ड माळावाळेर, अदिक परमेश्वर उन ईला उलटा सुखविलास इक चाहासावाळेर ईत्‍तार. <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />आंदुर भक्ति इन भेष रा माळ्यार, लेकीन अदुर्द ताकत इक मान्सतिदिल; हिंग लॉकुर से दुर ईरेत. <verse eid="2TI 3:5" /><verse number="6" style="v" sid="2TI 3:6" />ईंदुर दा टु अच आ लॉकुर आर जो मान्नागोळ दा वत्‍त काल देल होक्‍कोमतार, अदिक आ दुर्बल आर्तेर इक वश दा माळ कोमतार जो पापगोळ देल वोतकु अदिक सप्पा प्रकार इंद अभिलाषागोळ्द वश दा आर, <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />अदिक ईत्‍ता आर्तेर हमेशा कलुतेला रा ईरतार लेकीन सच्चाई इक जान्स सकालुर. <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />ह्यांग यन्नेस अदिक यम्ब्रेस मूसा अन्द विरोध माळीदुर, हांग अच ईंदुर भी सच्चाई इन विरोध माळतार; ईंदुर हिंग मंळसा आर, यार्द दिमाक भ्रष्ट आगेग्याद अदिक ईंदुर विश्वास दा असफल आर. <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />लेकीन ई लॉकुर ईदुर से मुंद वाळुस सकालुर, यतिकी सप्पा लॉकुर नोळ्यार कि आंदुर याट मूर्ख आर. हांग अच ह्यांग यन्नेस अदिक यम्ब्रेस उन सांगुळ आत.<verse eid="2TI 3:9" /></para>
  <para style="s">तीमुथियुस उक विशेष निर्देश</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />लेकीन नी नान शिक्षा, नान जीवन इन आचरण, उद्देश विश्वास, धीरज, प्यार, सहनशीलता ई सप्पा मातगोळी वळ्लीद रीति देल जान्सत्या; <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" /><note caller="+" style="x"><char style="xo" closed="false">३:११ </char><char style="xt" closed="false"><ref loc="ACT 13:14-52">प्रेरितगोळ १३:१४-५२</ref>; </char><char style="xt" closed="false"><ref loc="ACT 14:1-7">प्रेरितगोळ १४:१-७</ref>; </char><char style="xt" closed="false"><ref loc="ACT 14:8-20">प्रेरितगोळ १४:८-२०</ref></char></note>नांद सताव अदिक नानव दुख, अदिक अन्ताकिया अदिक इकुनियुम अदिक लुस्त्रा दा जो भयंकर यातनागोळ नानी कोटकु आगीदव अदिक यदरी ना सहन माळदीन, ईद नी जान्सत्या, तरी भी प्रभु नानी ईव सप्पा दुखगोळ से बीळ्सदुन. <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />लेकीन यास मसीह यीशु दा भक्ति इन सांगुळ जिन्दगी बितुसोद चाहासतार आंदुर सप्पा मुंदुर सतुस्कु आदार; <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />लेकीन दुष्ट अदिक बयकुसावाळेर ध्वाका कोळतेला अदिक ध्वाका तिनतेला, बिगळुस्त होटोदार. <verse eid="2TI 3:13" /><verse number="14" style="v" sid="2TI 3:14" />लेकीन नी आ सच्चाई इन मातगोळ मा जो नी कलत्या अदिक विश्वास माळ्या, ईद जान्सकु मजबूत बन्सकु ईर कि नी अवरी याता लॉकुर से कलत्या, <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />अदिक स्याणपन टु पवित्रशास्त्र अपमान अर्तकु आद, जो नीनी यीशु मसीह मा विश्वास माळदुर देल उद्धार हासिल माळोर साटी हुश्यार माळ सकतद. <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />सम्पुर्ण पवित्रशास्त्र परमेश्वर उन प्रेरणा देल रचुसकु आग्याद अदिक उपदेश, अदिक समजुसोद, अदिक सुधारन माळोद, अदिक न्यायीपन इन शिक्षा साटी फायदेमंद आद, <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />ताकी परमेश्वर उन जन सिद्ध आगुल, अदिक हर ऊंद वळ्लीद क्याल्सा साटी तयार आगेगुल.<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />ना परमेश्वर अदिक मसीह यीशु उन मुंद जो जित्‍ता अदिक सोतकु मंळसागोळ्द न्याय माळ्यान, अदिक राजा आगकु शासन माळोर साटी बंदान, आंदरी गवाह मान्सकु ना विनती माळतीन, <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />कि नी वचन इन प्रचार माळ, समय बेसमय तयार ईर, सप्पा प्रकार इन सहनशीलता अदिक शिक्षा अन्द सांगुळ निर्देश कोळ, दनकुस अदिक समजुस. <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />यतिकी हिंग समय बंदीत याग लॉकुर सच्चाई इन शिक्षा केळतीदिल, लेकीन आंदुर खुद इक समाधान सीकुल ईत्‍ता मातगोळ केळोर साटी तान अभिलाषागोळ्द अनुसार तान साटी हापाळ सा शिक्षा कोळावाळेर जमा माळ कोंडार, <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />अदिक तान किव सच्चाई इन हादी दी टु तिर्गुसकु काल्पनिक कात्‍तागोळ मा हच्यार. <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />लेकीन नी सप्पा मातगोळ दा नियंत्रण ईट, दुख नेगु, खुशखबरी प्रचार इन क्याल्सा माळ, अदिक तान स्यावा अक पुरा माळ.<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />यतिकी ईग नांद अर्पण इन घळी होट बंदाद, अदिक नान ईद जीवन इक त्यागसोद समय होट बंदाद. <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />ना वळ्लीद कुस्ती आळ कोंडीन, ना तान दवळ पुरा माळ कोंडीन, ना विश्वास इन रखवाली माळीन. <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />भविष्य दा नान साटी विजयी ईनाम इन मुकुट ईटकु आद, यदरी प्रभु, जो आसान हादी देल नळसावाळा हुन, नानी आ दिशी कोट्टान, अदिक नानी इच ईला उलटा आ सप्पा मुंदुर इक भी जो आऊन प्रगट आगोद प्रिय जान्सतार<verse eid="2TI 4:8" /></para>
  <para style="s">व्यक्तिगत वचन</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />नान हात्‍ती राटनेरी बरोद कोशिश माळ. <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" /><note caller="+" style="x"><char style="xo" closed="false">४:१० </char><char style="xt" closed="false"><ref loc="COL 4:14">कुलुस्सिगोळ ४:१४</ref>; <ref loc="PHM 1:24">फिलेमोन १:२४</ref>; </char><char style="xt" closed="false"><ref loc="2CO 8:23">२ कुरिन्थि ८:२३</ref>; <ref loc="GAL 2:3">गलातिगोळ २:३</ref>; <ref loc="TIT 1:4">तीतुस १:४</ref></char></note>यतिकी देमास ई दुनिया अक प्रिय जान्सकु नानी बिट बुटान अदिक थिस्सलुनीके अक होटोग्यान. क्रेसकेंस गलातिया अक अदिक तीतुस दलमतिया अक होटोग्यान. <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" /><note caller="+" style="x"><char style="xo" closed="false">४:११ </char><char style="xt" closed="false"><ref loc="COL 4:14">कुलुस्सिगोळ ४:१४</ref>; <ref loc="PHM 1:24">फिलेमोन १:२४</ref>; </char><char style="xt" closed="false"><ref loc="ACT 12:12">प्रेरितगोळ १२:१२</ref>,<ref loc="ACT 12:25">२५</ref>; <ref loc="ACT 13:13">१३:१३</ref>; <ref loc="ACT 15:37-39">१५:३७-३९</ref>; <ref loc="COL 4:10">कुलुस्सिगोळ ४:१०</ref>; <ref loc="PHM 1:24">फिलेमोन १:२४</ref></char></note>सिर्फ लूका नान सांगुळ आन. मरकुस उक हुडुकु होटबर; यतिकी स्यावा अन्द साटी आव हापाळ उपयोगी आन. <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" /><note caller="+" style="x"><char style="xo" closed="false">४:१२ </char><char style="xt" closed="false"><ref loc="ACT 20:4">प्रेरितगोळ २०:४</ref>; <ref loc="EPH 6:21">इफिसिगोळ ६:२१</ref>,<ref loc="EPH 6:22">२२</ref>; <ref loc="COL 4:7">कुलुस्सिगोळ ४:७</ref>,<ref loc="COL 4:8">८</ref></char></note>तुखिकुस उक ना इफिसुस कळीन. <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" /><note caller="+" style="x"><char style="xo" closed="false">४:१३ </char><char style="xt" closed="false"><ref loc="ACT 20:6">प्रेरितगोळ २०:६</ref></char></note>याग नी बंद्या रा झागा अक यदरी ना त्रोआस दा करपुस उन मान्या बिटकु बंदिदीन तरेत; अदिक नानव किताबगोळ विशेष माळकु तोगुल इन चिट्ठी गोळी हुडुत बरेत. <figure style="fig" alt="Scrolls standing by ink well" file="hk00153c.tif" size="col" copy="Horace Knowles ©" ref="४:१३">वळ्लीद तरीका देल स्याही अन द्वारा निदुरकु गुंळ्सद चिट्टी</figure><verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:१४ </char>
      <char style="xt" closed="false">
        <ref loc="1TI 1:20">१ तीमुथियुस १:२०</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="ROM 2:6">रोमियों २:६</ref>
      </char>
    </note>धातु उन क्याल्सा माळावाळा सिकन्दर नानी हापाळ नुकसान पोहचुस्यान; प्रभु आऊक आऊन क्याल्सागोळ अनुसार बदला कोट्टान. <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />नी भी आऊन से सावधान ईर, यतिकी आव नाम उपदेशगोळ्द हापाळ अच विरोध माळ्यान.<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />नान पयले पक्ष इन समय याऊ भी नान साथ कोटीदील, उलटा सप्पा मुंदुर नानी बिट बुटीदुर. <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />लेकीन प्रभु नान सांगुळ नीदुरकु ईत्‍तुन अदिक नानी सामर्थ्य कोट्टुन, ताकी नान द्वारा पुरा पुरा प्रचार आगुल अदिक सप्पा गैरयहूदी लॉकुर केळ कोमुल. ना हुल्ल इन बाय देल बिळ्सकु आगीन. <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />अदिक प्रभु नानी हर ऊंद बुरा क्याल्सा देल बिळस्यान, अदिक तान स्वर्गीय राज्य दा उद्धार माळकु पोहचुस्यान. आऊन महिमा हमेशा हमेशा आगतेला ईरूल. आमीन.<verse eid="2TI 4:18" /></para>
  <para style="s">आखरी अभिवादन</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:१९ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:2">प्रेरितगोळ १८:२</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="2TI 1:16">२ तीमुथियुस १:१६</ref>,<ref loc="2TI 1:17">१७</ref></char>
    </note>प्रिस्का अदिक अक्विला अक अदिक उनेसिफुरूस इन घराना अक नमस्कार. <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" /><note caller="+" style="x"><char style="xo" closed="false">४:२० </char><char style="xt" closed="false"><ref loc="ACT 19:22">प्रेरितगोळ १९:२२</ref>; <ref loc="ROM 16:23">रोमियों १६:२३</ref>; </char><char style="xt" closed="false"><ref loc="ACT 20:4">प्रेरितगोळ २०:४</ref>; <ref loc="ACT 21:29">२१:२९</ref></char></note>इरास्तुस कुरिन्थुस दा ईतोदुन, अदिक त्रुफिमुस उक ना मिलेतुस दा बिमार आगा कारण बिटीन. <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />सोळीन दिन से पयले बरोद कोशिश माळ. यूबूलुस, अदिक पूदेस, अदिक लीनुस अदिक क्लौदिया, अदिक सप्पा विश्वासी वार्टुर्द नीनी नमस्कार.<verse eid="2TI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22" />प्रभु नीन आत्मा अन सांगुळ ईरूल.</para>
  <para style="p" vid="2TI 4:22">नीम मा अनुग्रह आगतेला ईरूल.<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>