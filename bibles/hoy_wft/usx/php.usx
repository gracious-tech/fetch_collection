<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- Holiya</book>
  <para style="h">फिलिप्पिगोळ</para>
  <para style="toc3">फिलिप्पिगोळ</para>
  <para style="toc2">फिलिप्पिगोळ</para>
  <para style="toc1">फिलिप्पिगोळ हेसुर पौलुस प्रेरित उन चिट्ठी</para>
  <para style="mt2">फिलिप्पी के नाम पौलुस प्रेरित की चिट्ठी</para>
  <para style="mt1">फिलिप्पिगोळ हेसुर पौलुस प्रेरित उन चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">पौलुस फिलिप्पी दा विश्वासीगोळ इक यीशु उन जनम इन लगभग ६१ वर्ष इन बाद्दा चिट्ठी लिख्सदुन. आव बंदीगृह दा <char style="xt"><ref loc="PHP 1:13">१:१३</ref></char> ईरतेला लिख्सदुन, शायद रोम दा. ईद चिट्ठी फिलिप्पी नगर दा स्थित मंडली इक लिख्सकु आगीत. नाव फिलिप्पी इन बारा दा अधिनियमगोळ्द किताब देल थ्वाळासा कलु सकतेव. फिलिप्पी मकिदुनिया प्रांत इन ऊंद राजधानी ईरोद. ईद पयला मंडली ईरोद यदरी मकिदुनिया दा स्थापित माळकु आगीत. पौलुस अदिक सिलास ऊंद सांगुळ मंडली इन सुरूवात माळदुर अदिक ईल ताका कि ऊंद ईळ्लक इन साटी बंदीगृह दा हाक्‍कु आत, याग आंदुर अल ईरोर <char style="xt"><ref loc="ACT 16">प्रेरितगोळ १६</ref></char> ईद चिट्ठी इक लिखसोर दा पौलुस उन कई उद्देश ईर सकताव. आंदुर ईद मवका अन उपयोग मंडली इक आंदुर द्वारा कळुकु आग्याव उपहार इन साटी धन्यवाद कोळोर साटी माळदुर याग आंदुर केळदुर कि आव बंदीगृह दा आन <char style="xt"><ref loc="PHP 4:10-19">४:१०-१९</ref></char> आंदुर बंदीगृह दा आंदुर्द स्थिती मा आंदरी अध्ययन भी माळदुर अदिक मंडली इक तीमुथियुस अदिक एपाफ्रिदितुस उन सिफारीश माळदुर <char style="xt"><ref loc="PHP 2:19-30">२:१९-३०</ref></char> ताकी आंदुर आंदुर्द स्वागत माळुल अदिक आंदुर्द नेतृत्व अन्द सम्मान माळुल.</para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">१. फिलिप्प फिलिप्पी दा मंडली इक नमस्कार माळकु चिट्ठी सुरू माळतान. <char style="ior"><ref loc="PHP 1:1-2">१:१-२</ref></char></para>
  <para style="io1">२. मुंद आव तान स्थिती इन बारा दा थ्वाळासा जानकारी साझा माळतान अदिक थ्वाळासा चिंतागोळ जो आऊन हात्‍ती आव <char style="ior"><ref loc="PHP 1:3-2:30">१:३–२:३०</ref></char></para>
  <para style="io1">३. बाक आव ईसाई जीवन जीऊसोर साटी हापाळ व्यावहारिक निर्देश कोळतान <char style="ior"><ref loc="PHP 3:1-4:9">३:१–४:९</ref></char></para>
  <para style="io1">४. पौलुस फिलिप्पीया अन्द मंडली इक आंदुर्द उपहार इन साटी धन्यवाद कोटकु अदिक आंदुर्द अभिवादन कळुकु चिट्टी खतम माळतान <char style="ior"><ref loc="PHP 4:10-23">४:१०-२३</ref></char></para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:१ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 16:12">प्रेरितगोळ १६:१२</ref>
      </char>
    </note>मसीह यीशु उन दास पौलुस अदिक तीमुथियुस उन दी टु, सप्पा पवित्र लॉकुर हेसुर जो यीशु मसीह दा आगकु फिलिप्पी दा, अध्यक्षगोळ अदिक सेवकगोळ सांगुळ ईरतार. <figure style="fig" alt="City of Philippi" file="hk00363c.tif" size="span" copy="Horace Knowles ©" ref="१:१">फिलिप्पी इन शयर</figure><verse eid="PHP 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 1:2" />नामव आप्प परमेश्वर अदिक प्रभु यीशु मसीह अन दी टु नीमी अनुग्रह अदिक शांती सिकतेला ईरूल.<verse eid="PHP 1:2" /></para>
  <para style="s">पौलुस उन प्रार्थना अदिक धन्यवाद</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />ना याग याग नीमी याद माळतीन, आग आग तान परमेश्वर उन धन्यवाद माळतीन; <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />अदिक याग यागलु नीम सप्पा अन साटी विनती माळतीन, रा हमेशा खुशी इन सांगुळ विनती माळतीन. <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />इदुरसाटी कि नीव पयला दिन टु हुडुकु ईंद ताका खुशखबरी बगरूसदुर दा नान सहभागी ईतीर. <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />नानी ई मात इन भरोसा आद कि याव नीम दा वळ्लीद क्याल्सा सुरू माळ्यान, आवा अदरी यीशु मसीह अन्द दिन ताका पुरा माळ्यान. <verse eid="PHP 1:6" /><verse number="7" style="v" sid="PHP 1:7" />उचित आद कि ना नीम सप्पा मुंदुर साटी हिंग अच विचार माळाईन, यतिकी नीव नान मन दा बंदकु बसुसेगीर, अदिक ना शंकलीगोळ देल कैद दा अदिक खुशखबरी इन साटी उत्‍तर अदिक प्रमाण कोळदुर दा नीव सप्पा मुंदुर नान सांगुळ अनुग्रह दा सहभागी आगी. <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />इदुर दा परमेश्वर नान गवाह आन कि ना मसीह यीशु उन घाई प्यार माळकु नीम सप्पा मुंदुर्द लालसा माळतीन. <verse eid="PHP 1:8" /><verse number="9" style="v" sid="PHP 1:9" />ना तरी भी ईद प्रार्थना माळतीन कि नीम प्यार ग्यान अदिक हर प्रकार इन विवेक सांगुळ अदिक यक्कुल वाळुस्त होगुल, <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />ईल ताका कि नीव वळ्लीद से वळ्लीद मातगोळ्द जाच माळी, अदिक मसीह अन्द दिन ताका खरा बन्सकु ईरी, अदिक ठोकर तिनबाळी; <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />अदिक आ न्यायीपन इन काय देल जो यीशु मसीह अन्द द्वारा आगताव, यक्कुल आग्त होगी यदुर देल परमेश्वर उन महिमा अदिक स्तुति आग्त ईरूल.<verse eid="PHP 1:11" /></para>
  <para style="s">पौलुस उन कैद टु खुशखबरी इन उन्नती</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />हे वार्टुरा, ना चाहासतीन कि नीव ईद जान्स कोमी कि नान मा जो घळुस्याद, अदुर देल खुशखबरी वाळुसतेला होग्याद. <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" /><note caller="+" style="x"><char style="xo" closed="false">१:१३ </char><char style="xt" closed="false"><ref loc="ACT 28:30">प्रेरितगोळ २८:३०</ref></char></note>ईल ताका कि कैसर उन राजभवन इन सप्पा पलटन अदिक मिग्द सप्पा लॉकुर मा ईद प्रगट आगेग्याद कि ना मसीह अन्द साटी शंकलीगोळ देल कैद दा आईन; <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />अदिक प्रभु दा जो वार्टुर आर, आंदुर दा टु यक्कुल मुंदुर नान शंकलीगोळ देल कैद आगदुर कारण, भरोसा माळकु परमेश्वर उन वचन बेधळक केळसोद मात्‍त यक्कुल हिम्मत माळतार.<verse eid="PHP 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15" />थ्वाळासा रा जलन अदिक झगळा अन्द कारण मसीह अन्द प्रचार माळतार अदिक थ्वाळासा भला इच्छा देल. <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />हापाळ पुरा रा ईद जान्सकु कि ना खुशखबरी इन साटी उत्‍तर कोळली ठहरूस्कु आगीन, प्यार देल प्रचार माळतार. <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />अदिक हापाळ मुंदुर रा सरका ईला लेकीन मतलब देल मसीह अन्द कात्‍ता केळ्सतार, ईद विचार माळकु कि ना शंकलीगोळ देल कैद दा आईन नान साटी क्लेश पैदा माळुल. <verse eid="PHP 1:17" /><verse number="18" style="v" sid="PHP 1:18" />रा येन आत? सिर्फ ईद कि हर प्रकार देल, या बहाना देल या सच्चाई देल, मसीह अन्द कात्‍ता केळ्सकु आगतद, अदिक ना ईदुर देल खुश आईन अदिक खुश भी ईराइन. <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />यतिकी ना जान्सतीन कि नीम विनती इन द्वारा, अदिक यीशु मसीह अन्द आत्मा अन्द दान इन द्वारा, इदुर्द प्रतिफल नान उद्धार आदीत. <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />ना रा ईदा हापाळ लालसा अदिक आशा ईटतीन कि ना यातोदु मात दा लज्जित आगतीदील, लेकीन ह्यांग नान प्रबल हिम्मत इन कारण मसीह अन्द बळाई नान मय इन द्वारा हमेशा आग्त ईताद, हांग अच ईग भी आगुल, चाहे ना जित्‍ता ईराइन या सोतोगाईन. <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />यतिकी नान साटी जित्‍ता ईरोद मसीह हुन, अदिक सोतोगोद फायदा हुन. <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />लेकीन अगर मय दा जित्‍ता ईरोद अच नान क्याल्सा साटी फायदा मंद आद रा ना जान्सालीन कि यदुर्द चुनाव माळाईन. <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />यतिकी ना येढ्ढु चीज इन न्याड्या अधर दा हिलगुसकु आईन; जीव रा चाहासतद कि होगकु मसीह अन्द हात्‍ती ईराइन, यतिकी ईद रा हापाळ वळ्लीद आद, <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />लेकीन मय दा ईरोद नीम कारण मात्‍त यक्कुल जरूरी आद. <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />इदुरसाटी कि नानी इदुर्द भरोसा आद इदुरसाटी ना जान्सतीन कि ना जित्‍ता ईराइन, उलटा नीम सप्पा मुंदुर सांगुळ ईराइन यदुर देल नीव विश्वास दा मजबूत आग्त होगी अदिक अदुर दा खुश ईरी; <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />अदिक जो घमण्ड नीव नान बारा दा माळतीर, अद नांद मात्‍त नीम हात्‍ती बंदुर देल मसीह यीशु दा यक्कुल वाळुसेगुल.<verse eid="PHP 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27" />सिर्फ ईट माळी कि नीम चाल-चलन मसीह अन्द खुशखबरी इन लायक ईरूल कि चाहे रा ना बंदकु नीमी नोळाईन, चाहे रा बर भी तिदिल, नीम बारा दा नानी ईदा केळ सिकुल कि नीव ऊंद अच अंतरात्मा दा जित्‍ता आईर, अदिक ऊंद मन आगकु खुशखबरी इन विश्वास इन साटी मयनत माळ्त ईरतीर. <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />अदिक यातोदारा मात दा विरोध माळावाळेर से अंज्क तुमालीर. ईद आंदुर साटी विनाश इन स्पष्ट चमत्कार हुन, लेकीन नीम साटी उद्धार इन अदिक ईद परमेश्वर उन दी टु आद. <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />यतिकी मसीह अन्द कारण नीम मा ईद अनुग्रह आत कि ना सिर्फ आऊन साटी भरोसा कोळी लेकीन आऊन साटी दुख भी नेगी; <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" /><note caller="+" style="x"><char style="xo" closed="false">१:३० </char><char style="xt" closed="false"><ref loc="ACT 16:19-40">प्रेरितगोळ १६:१९-४०</ref></char></note>अदिक नीमी हांग अच मयनत माळोद आद, ह्यांग नीव नानी माळतेला नोळीर, अदिक ईग भी केळतीर कि ना हांग अच माळतीन.<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="s">मसीह अन्द दीनता अदिक महानता</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />इदुरसाटी अगर मसीह दा थ्वाळासा शांती, अदिक प्यार देल हिम्मत, अदिक आत्मा अन्द प्रोत्साहन, अदिक थ्वाळासा करूणा अदिक संगती आद, <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />रा नान ईद खुशी पुरा माळी कि ऊंद मन आगकु ईरी, अदिक ऊंद अच प्यार, ऊंद अच चित्त, अदिक ऊंद अच मनसा ईटी. <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />मतलब देल या ख्वाटा बळाई साटी येनु माळबाळी, लेकीन दीनता देल आबुर दाबुर इक तान से वळ्लेर समसी. <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />हर ऊंद तान हित इन ईला, उलटा दुसरा अन्द हित इन भी चिन्ता माळुल. <verse eid="PHP 2:4" /><verse number="5" style="v" sid="PHP 2:5" />ह्यांग मसीह यीशु उन विचार ईरव हांग अच नीम भी विचार ईरूल;<verse eid="PHP 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PHP 2:6" />याव परमेश्वर उन स्वरूप दा ईतकु भी</para>
  <para style="q2" vid="PHP 2:6">परमेश्वर उन तुल्य आगली तान वश दा ईटोद वस्तु समसीदील.<verse eid="PHP 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 2:7" />उलटा तान तान इक हिंग शुन्य माळ बुट्टुन,</para>
  <para style="q2" vid="PHP 2:7">अदिक दास उन रूप धारण माळदुन,</para>
  <para style="q1" vid="PHP 2:7">अदिक मंळसा अन्द समानता दा आगेदुन.<verse eid="PHP 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 2:8" />अदिक मंळसा अन्द रूप दा प्रगट आगकु तान तान इक दीन माळदुन,</para>
  <para style="q2" vid="PHP 2:8">अदिक ईल ताका आग्याकारी ईत्‍तुन कि मृत्यु, हव, क्रूस इन मृत्यु भी सहन माळदुन.<verse eid="PHP 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 2:9" />ई कारण परमेश्वर आऊक हापाळ महान भी माळदुन,</para>
  <para style="q2" vid="PHP 2:9">अदिक आऊक अद हेसुर कोट्टुन जो सप्पा हेसुरगोळ से श्रेष्ट आद,<verse eid="PHP 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 2:10" />कि जो स्वर्ग दा अदिक पृथ्वी मा अदिक पृथ्वी इन ल्यालमा आद,</para>
  <para style="q2" vid="PHP 2:10">अव सप्पा यीशु उन हेसुर मा ट्वांगरा टेकसुल;<verse eid="PHP 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PHP 2:11" />अदिक परमेश्वर आप्प उन महिमा साटी हर ऊंद ल्यालग्या अंगीकार माळ कोमुल</para>
  <para style="q2" vid="PHP 2:11">कि यीशु मसीह अच प्रभु हुन.<verse eid="PHP 2:11" /></para>
  <para style="s">दुनिया दा ज्योति इन घाई चमकुसी</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />इदुरसाटी हे नान प्रियगोळा, ह्यांग नीव हमेशा टु आग्या मान्सतेला बंदीर, हांग अच ईग भी ना सिर्फ नान सांगुळ ईरा होती लेकीन जरूर माळकु ईग नान दुर ईत्‍तुर मा भी अंज्क अदिक नळ्गतेला तान तान उद्धार इन क्याल्सा पुरा माळ्त होगी; <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />यतिकी परमेश्वर अच हुन याव तान खुद इन इच्छा अन्द कारण नीम मन दा इच्छा अदिक क्याल्सा, येढ्ढु मातगोळ्द माळोद प्रभाव हाक्यान.<verse eid="PHP 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 2:14" />सप्पा क्याल्सा बिना बळबळ अदिक बिन बाय कय मुर्सद माळतोगी, <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />कि नीव निर्दोष अदिक भोला आगकु वाकळा अदिक जिद्दी लॉकुर न्याड्या परमेश्वर उन निष्कलंक औलाद बन्सकु ईरी, यार न्याड्या दा नीव जीवन इन वचन हुडुकु दुनिया दा होतकु दिंग्यागोळ घाई कांळ्सतीर, <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />कि मसीह अन्द दिशी नान हात्‍ती कारण ईरूल कि ना नान जित्‍ता इरोद अदिक ना नांद घमण्ड माळोद बेकार आत. <verse eid="PHP 2:16" /><verse number="17" style="v" sid="PHP 2:17" />अगर नानी नीम विश्वास रूपी बलिदान अदिक स्यावा अन्द सांगुळ तान रक्ता भी वाहुसोद बिळुल, तरी भी ना खुश आईन अदिक नीम सप्पा मुंदुर सांगुळ खुशी माळतीन. <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />हांग अच नीव भी खुश ईरी अदिक नान सांगुळ खुशी माळी.<verse eid="PHP 2:18" /></para>
  <para style="s">तीमुथियुस अदिक इपफ्रुदीतुस</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />नानी प्रभु यीशु दा आशा आद कि ना तीमुथियुस उक नीम हात्‍ती तुरन्त कळाईन, ताकी नीम दशा केळकु नानी खुशी सिकुल. <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />यतिकी नान हात्‍ती हिंग स्वभाव इनव याऊ हैलेच जो शुद्ध मन देल नीम चिन्ता माळुल. <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />यतिकी सप्पा मुंदुर तान स्वार्थ इन खोज दा ईरतार, ना कि यीशु मसीह अन्द. <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />लेकीन आऊक रा नीव परकुसदीर अदिक जान्स भी कोंडीर कि ह्यांग पार आप्प उन सांगुळ माळतान, हांग अच आव खुशखबरी इक फैलुसदुर दा नान सांगुळ स्यावा माळदुन. <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />इदुरसाटी नानी आशा आद कि ह्यांग नानी समझ दा बंदीत कि नान येन दशा आदीन, हांग अच ना आऊक तुरन्त कळु बुळाईन. <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />अदिक नानी प्रभु दा भरोसा आद कि ना खुद भी राटनेरी बराईन.<verse eid="PHP 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25" />लेकीन ना इपफ्रुदीतुस उक जो नान वार्ट अदिक सहकर्मी अदिक संगी योद्धा अदिक नीम स्वर्गदूत, अदिक जरूरी मातगोळ दा नान स्यावा टहल माळावाळा हुन, नीम हात्‍ती कळोद जरूरी सम्सदीन. <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />यतिकी आऊन लालसा नीम सप्पा मुंदुर दा हतकु ईरोद, ई कारण आव व्याकुल ईरतोगोन यतिकी नीव आऊन बिमारी इन बारा दा केळीदीर. <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />निश्चय आव बिमार रा आगेगिदुन ईल ताका कि सायोर मा ईरोन, लेकीन परमेश्वर आऊन मा दया माळदुन, अदिक सिर्फ आऊन मा अच ईला लेकीन नान मा भी कि नानी शोक मा शोक सिकबाळुल. <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />इदुरसाटी ना आऊक कळोद मात्‍त यक्कुल कोशिश माळदीन कि नीव आऊक मात्‍त नोळकु खुश आगेगी अदिक नान भी दुख गोर्त आगेगुल. <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />इदुरसाटी नीव प्रभु दा आऊन से हापाळ खुशी इन सांगुळ मुलाकात माळेतीर, अदिक ईत्‍तोर्द आदर माळतोगेतीर. <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />यतिकी आव मसीह अन्द क्याल्सा साटी तान जीव इक जोखिम दा हाक्‍कु मृत्यु उन हात्‍ती होट बंदीदुन ताकी जो कमी नीम दी टु नान स्यावा दा आत अदरी पुरा माळुल.<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s">सही न्यायीपन</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />इदुरसाटी हे नान वार्टुरा, प्रभु दा खुश ईरी. अव अच मातगोळ नीमी घळी घळी लिख्सली नानी रा येनु तकलीफ आगाल, अदिक ईदुर दा नीम कुशलता आद, <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />नायगोळ से सावधान ईरी, आ बेकार क्याल्सा माळावाळेर से सावधान ईरी, आ काट कूट माळावाळेर से सावधान ईरी. <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />यतिकी खतनावाळेर रा नाव अच हुयेव जो परमेश्वर उन आत्मा अन्द अगुवाई देल उपासना माळतेव, अदिक मसीह यीशु मा घमण्ड माळतेव, अदिक मय मा भरोसा ईटालेव. <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />लेकीन ना रा मय मा भी भरोसा ईट सकतीन. अगर यारारा दुसरा अक मय मा भरोसा ईटोद विचार आगुल, रा ना आऊन से यक्कुल ईट सकतीन. <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" /><note caller="+" style="x"><char style="xo" closed="false">३:५ </char><char style="xt" closed="false"><ref loc="ROM 11:1">रोमियों ११:१</ref>; </char><char style="xt" closed="false"><ref loc="ACT 23:6">प्रेरितगोळ २३:६</ref>; <ref loc="ACT 26:5">२६:५</ref></char></note>आठवा दिशी नान खतना आत, इस्त्राएल इन वंश अदिक बिन्यामीन इन गोत्र नव हुईन; इब्रानिगोळव इब्रानी हुईन; व्यवस्था अन्द बारा दा अगर अंदीर रा फरीसी हुईन. <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" /><note caller="+" style="x"><char style="xo" closed="false">३:६ </char><char style="xt" closed="false"><ref loc="ACT 8:3">प्रेरितगोळ ८:३</ref>; <ref loc="ACT 22:4">२२:४</ref>; <ref loc="ACT 26:9-11">२६:९-११</ref></char></note>उत्साह अन्द बारा दा अगर अंदीर रा मंडली इन सतुसावाळा; अदिक व्यवस्था अन्द न्यायीपन इन बारा दा अगर अंदीर रा निर्दोष ईरीन. <verse eid="PHP 3:6" /><verse number="7" style="v" sid="PHP 3:7" />लेकीन जो जो मातगोळ नान फायदा नव ईरव, अवरीका ना मसीह अन्द कारण नुकसान सम्स कोंडीन. <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />उलटा ना तान प्रभु यीशु मसीह अन्द पयचान इन उत्‍तमता अन्द कारण सप्पा मातगोळी नुकसान सम्सतीन. यदुर कारण ना सप्पा वस्तुगोळ्द नुकसान नेगदीन, अदिक अवरी काळी कचरा सम्सतीन, यदुर से ना मसीह अक हासिल माळाईन <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />अदिक अदुर दा ना सिक्कु आगुल; ना कि तान अद न्यायीपन इन सांगुळ, जो व्यवस्था देल आद, उलटा आ न्यायीपन इन सांगुळ जो मसीह मा विश्वास माळदुर कारण आद अदिक परमेश्वर दी टु विश्वास माळदुर मा सिकतद; <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />ताकी ना अदरी अदिक अदुर्द मृत्युंजय इन सामर्थ्य अक, अदिक अदुर सांगुळ दुखगोळ दा सहभागी आगोद मर्म इक जान्साईन, अदिक आऊन मृत्यु उन समानता अक हासिल माळाईन. <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />कि ना यातोदारा भी रीति देल सोत्‍तुर दा टु जित्‍ता आगोद पद ताका पोहचुसाईन.<verse eid="PHP 3:11" /></para>
  <para style="s">निशाना दी ओळोद</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />ईद मतलब हैलेच कि ना ईग हासिल माळ कोंडीन, या सिद्ध आगेगिन; लेकीन आ पदार्थ अक हुडोर साटी ओळ्त होगतीन, यदुर साटी मसीह यीशु नानी हुळदिदुन. <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />हे वार्टुरा, नान ईद भावना हैलेच कि ना हासिल माळ कोंडीन; लेकीन सिर्फ ऊंद क्याल्सा माळतीन कि जो मातगोळ हिंद ईतोग्याव अवरी मारूकु, मुंदळव मातगोळ दी वाळुसतेला, <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />निशाना दी ओळ्त होगतीन, ताकी अद ईनाम हासिल माळाईन यदुर साटी परमेश्वर नानी मसीह यीशु दा म्याकुच कारदान. <verse eid="PHP 3:14" /><verse number="15" style="v" sid="PHP 3:15" />नाम दा टु यास सिद्ध आर, ईदा विचार ईटुल, अदिक अगर यातोदारा मात दा नीम दुसरा अच विचार ईरूल रा परमेश्वर अदरी भी नीम मा प्रगट माळ बुट्टान. <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />इदुरसाटी यल ताका नाव पोहचुसेव, अदुर्दा अनुसार नळदेव. <verse eid="PHP 3:16" /><verse number="17" style="v" sid="PHP 3:17" /><note caller="+" style="x"><char style="xo" closed="false">३:१७ </char><char style="xt" closed="false"><ref loc="1CO 4:16">१ कुरिन्थि ४:१६</ref>; <ref loc="1CO 11:1">११:१</ref></char></note>हे वार्टुरा, नीव सप्पा मुंदुर मिलुसकु नान घाई व्यवहार माळी, अदिक आंदरी पयचान दा ईटी जो ई रीति मा नळुतार यदुर उदाहरण नीव नाम दा नोळतीर; <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />यतिकी हापाळ सा हिंग व्यवहार माळतार, यार्द चर्चा ना नीम से घळी घळी माळीन, अदिक ईग भी वर्ल वर्लकु अनतीन कि आंदुर तान चाल-चलन देल मसीह अन्द क्रूस देल दुश्मनी माळावाळेर उर. <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />आंदुर अन्त विनाश आद, आंदुर मय व्हाट्टा हुन, आंदुर तान शरम इन मातगोळ मा विचार माळतार अदिक पृथ्वी इन वस्तुगोळ मा महिमा हचकु ईरतार. <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />लेकीन नाम स्वदेश स्वर्ग मा आद; अदिक नाव ऊंद उद्धारकर्ता प्रभु यीशु मसीह अन्द अल टु बरोद हादी कायेतेव. <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />आव तान शक्ति इन आ प्रभाव इन अनुसार यदुर द्वारा आव सप्पा वस्तुगोळी तान वश दा माळ सकतान, नाम दीन-हीन मय इन रूप बदलुसकु, तान महिमा अन्द मय इन अनुकूल माळ बुट्टान.<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="s">निर्देश</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />इदुरसाटी हे नान प्रिय वार्टुरा, यदुर दा नान जीव हतकु ईरतद, जो नान खुशी अदिक मुकुट हुईर, हे प्रिय वार्टुरा, प्रभु दा हिंगा हादी कायतेला स्थिर ईरी.<verse eid="PHP 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />ना यूओदिया अक भी विनती माळतीन अदिक सुन्तुखे अक भी, कि आंदुर प्रभु दा ऊंद विचार आगकु ईरूल. <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />हे खरा सहकर्मी, ना नीन से भी विनती माळतीन कि नी आ आर्तेर मदत माळ, यतिकी आंदुर नान सांगुळ खुशखबरी प्रचार माळदुर दा, क्लेमेंस अदिक नान दुसरा सहकर्मीगोळ सांगुळ मयनत माळदुर, यार्द हेसुर जीवन इन किताब दा लिख्सकु आव. <verse eid="PHP 4:3" /><verse number="4" style="v" sid="PHP 4:4" />प्रभु दा हमेशा खुश ईरी; ना मात्‍त अनतीन, खुश ईरी. <verse eid="PHP 4:4" /><verse number="5" style="v" sid="PHP 4:5" />नीम कोमलता सप्पा मंळसागोळ मा प्रगट आगुल. प्रभु हात्‍ती आन. <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />यातोदु मात इन चिन्ता माळबाळी; लेकीन हर ऊंद मात दा नीम निवेदन, प्रार्थना अदिक विनती इन द्वारा धन्यवाद इन सांगुळ परमेश्वर उन मुंद उपस्थित माळकु आगुल. <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />आग परमेश्वर उन शांती, जो सप्पा मुंदुर समझ इन व्हार्या आद, नीम मन अदिक नीम विचारगोळी मसीह यीशु दा सुरक्षित ईट्टीत. <verse eid="PHP 4:7" /><verse number="8" style="v" sid="PHP 4:8" />इदुरसाटी हे वार्टुरा, जो जो मातगोळ सच्चाई आव, अदिक जो जो मातगोळ आदरणीय आव, अदिक जो जो मातगोळ उचित आव, अदिक जो जो मातगोळ पवित्र आव, अदिक जो जो मातगोळ सुहावनी आव, अदिक जो जो मातगोळ मनभावनी आव, मतलब जो भी सदगुण अदिक प्रशंसा अन्द मातगोळ आव अऊर मा ध्यान हचतोगी. <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />जो मातगोळ नीव नान हात्‍ती टु कलतीर, अदिक ग्रहण माळदीर, अदिक केळदीर, अदिक नांदुर्दा नोळदीर, अऊर्दा पालन माळतोगी, आग परमेश्वर जो शांती नव सोता आन नीम सांगुळ ईत्‍तान.<verse eid="PHP 4:9" /></para>
  <para style="s">दान इन साटी धन्यवाद</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />ना प्रभु दा हापाळ खुश आईन कि ईग ईस दिनगोळ बाद्दा नीम चिन्ता नान बारा दा मात्‍त जागृत आग्याद; निश्चय नीमी सुरूवात दा भी इदुर्द विचार ईरोद, लेकीन नीमी मवका सिकिदील. <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />ईद ईला कि ना तान कमी इन कारण ईद अनतीन यतिकी ना ईद कलतीन कि याता दशा दा आईन; अदा दशा दा संतुष्ट ईराइन. <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />ना दीन आगोद भी जान्सतीन अदिक वाळुसोद भी जान्सतीन; हर ऊंद मात अदिक सप्पा दशागोळ दा ना संतुष्ट आगोद, उपास ईरोद, अदिक वाळुसोद-घटुसोद कलतीन. <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />जो नानी सामर्थ्य कोळतद अदुर दा ना सप्पा येनारा माळ सकतीन.<verse eid="PHP 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14" />तरी भी नीव वळ्लीद माळदीर कि नान क्लेश दा नान सहभागी आदीर. <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />हे फिलिप्पिगोळा, नीव खुद भी जान्सतीर कि खुशखबरी प्रचार इन सुरूवात दा, याग ना मकिदुनिया टु विदा आदीन, आग नीमी बिटकु मात्‍त यातोदु मंडली लेन देन इन बारा दा नान सहायता माळीदिल. <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" /><note caller="+" style="x"><char style="xo" closed="false">४:१६ </char><char style="xt" closed="false"><ref loc="ACT 17:1">प्रेरितगोळ १७:१</ref></char></note><note caller="+" style="x"><char style="xo" closed="false">४:१६ </char><char style="xt" closed="false"><ref loc="2CO 11:9">२ कुरिन्थि ११:९</ref></char></note>ईदा प्रकार याग ना थिस्सलुनीके दा ईरीन, आग भी नीव नान कमी पुरा माळोर साटी ऊंद घन येन उलटा येढ्ढ घन येनारा कळीदिर. <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />ईद ईला कि ना दान बेळोद चाहासतीन लेकीन ना हिंग काय चाहासतीन जो नीम फायदा साटी वाळुस्त होगुल. <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />नान हात्‍ती सप्पा येनारा आद, उलटा हापाळ पुरा भी आद; जो वस्तुगोळ नीव इपफ्रुदीतुस उन कय देल कळीदिर अवरी प्राप्त माळकु ना संतुष्ट आगेगिन, अद रा सुखदायक सुगन्ध, ग्रहण माळा लायक बलिदान आद, जो परमेश्वर उक वळ्लीद हततद. <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />नान परमेश्वर भी तान आ धन इन अनुसार जो महिमा सांगुळ मसीह यीशु दा आद, नीम हर ऊंद कमी इक पुरा माळीत. <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />नाम परमेश्वर अदिक आप्प उन महिमा हमेशा हमेशा आगतेला ईरूल. आमीन.<verse eid="PHP 4:20" /></para>
  <para style="s">आखरी नमस्कार</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />हर ऊंद पवित्र जन उक, जो यीशु मसीह दा आन नमस्कार अनी. जो वार्ट नान सांगुळ आन, नीमी नमस्कार अनतार. <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />सप्पा पवित्र लॉकुर, विशेष माळकु जो कैसर उन घराना नोर उर, नीमी नमस्कार अनतार.<verse eid="PHP 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23" />नाम प्रभु यीशु मसीह अन्द अनुग्रह नीम आत्मा अन्द सांगुळ ईरूल.<verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>