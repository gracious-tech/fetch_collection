<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TH" style="id">- Holiya</book>
  <para style="h">१ थिस्सलुनीकि</para>
  <para style="toc3">१ थिस्सलुनीकि</para>
  <para style="toc2">१ थिस्सलुनीकि</para>
  <para style="toc1">थिस्सलुनीकिगोळ हेसुर पौलुस प्रेरित उन पयला चिट्ठी</para>
  <para style="mt2">थिस्सलुनीकियों के नाम पौलुस प्रेरित की पहली पत्री</para>
  <para style="mt1">थिस्सलुनीकिगोळ हेसुर पौलुस प्रेरित उन पयला चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">थिस्सलुनीकिगोळ्द पयला चिट्ठी पौलुस <char style="xt"><ref loc="1TH 1:1">१:१</ref></char> लिखसीदुन पयले पवित्रशास्त्र अन भाग बन्सत अदिक मसीह अन जनम इन ५१ साल इन बाद्दा लिख्सकु आगीत, याग पौलुस चिट्ठी लिख्सदुन आग आव कुरिन्थि नगर दा ईरोन थिस्सलुनीकिगोळ्द मंडली यारी आव चिट्ठी लिख्सदुन दुसरा मिशनरी यात्रा अन न्याड्या दा स्थापित माळकु आगीत <char style="xt"><ref loc="ACT 17:1-10">प्रेरितगोळ १७:१-१०</ref></char> प्रेरितगोळ क्याल्सागोळ्द किताबगोळ दा हिंग हेळकु आग्याद कि ईद मंडली यहूदीगोळ्द अदिक ग्रीकगोळ्द बन्सकु ईरोद.</para>
  <para style="ip">ई मंडली इन स्थापना माळदुर बाद्दा पौलुस थिस्सलुनीकियों दा यक्कुल दिन ताका रूक्सीदिल. इदुरसाटी आव ई चिट्ठी इक प्रोत्साहन कोळोर साटी लिख्सदुन, ई चिट्ठी दा हापाळ विषयगोळ्द चर्चा माळकु आग्याद, जसा कि मसीहगोळ ह्यांग ईरली पायजे. पौलुस मसीह अन दुसरा आगमन इन ताका लिख्सतान सायद इदुरसाटी कि थिस्सलुनीकिगोळ्द मंडलीगोळ दा ईरावाळेर विश्वासीगोळी केळ्सदुर दा हापाळ उत्साह ईरोद, पौलुस ई बारा दा चिट्ठी इन द्वारा यीशु उन दुसरा आगमन इक लिख्सकु हिंग जीवन व्यतीत माळली प्रोत्साहित माळतान यदुर देल परमेश्वर संतुष्ट आन <char style="xt"><ref loc="1TH 5:6-8">५:६-८</ref></char></para>
  <para style="iot">रूप-रेखा:</para>
  <para style="io1">१. मंडली इक नमस्कार अदिक परमेश्वर उन धन्यवाद <char style="ior"><ref loc="1TH 1">१</ref></char></para>
  <para style="io1">२. पौलुस तान कार्य अन बारा दा अदिक तीमुथियुस जो समाचार इन साटी ईरोन आऊन बारा दा चर्चा माळदुन <char style="ior"><ref loc="1TH 2-3">२–३</ref></char></para>
  <para style="io1">३. यीशु उन दुसरा आगमन इन तयारी माळोर साटी मसीह दा ह्यांग जीवन व्यतीत माळ पायजे <char style="ior"><ref loc="1TH 4:1-5:15">४:१–५:१५</ref></char></para>
  <para style="io1">४. पौलुस उन मंडली इक नमस्कार अदिक सप्पा मुंदुर आऊन चिट्ठी वाचुस पायजे ईदुर बारा दा सुचना <char style="ior"><ref loc="1TH 5:16-28">५:१६-२८</ref></char></para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:१ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 17:1">प्रेरितगोळ १७:१</ref>
      </char>
    </note>पौलुस अदिक सिलवानुस अदिक तीमुथियुस उन दी टु थिस्सलुनीकेगोळ मंडली नव हेसुर जो परमेश्वर आप्प अदिक प्रभु यीशु मसीह अन लॉकुर आर अनुग्रह अदिक शांती नीमी सिकतेला ईरूल.<verse eid="1TH 1:1" /></para>
  <para style="s">थिस्सलुनीकिगोळ्द जीवन अदिक विश्वास</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />नाव तान प्रार्थनागोळ दा नीमी हमेशा याद माळतेव अदिक हमेशा नीम सप्पा अन बारा दा परमेश्वर उन धन्यवाद माळतेव. <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />अदिक तान परमेश्वर अदिक आप्प उन मुंद नीमव विश्वास इन क्याल्सा अदिक प्यार इन मेहनत अदिक नाम प्रभु यीशु मसीह दा धीरज देल हुळकु आशा अक लगातार याद माळतेव. <verse eid="1TH 1:3" /><verse number="4" style="v" sid="1TH 1:4" />नामोर वार्टुरा अदिक आकतींगेरा, नाव जान्सतेव कि परमेश्वर नीम से प्यार माळतान आव नीमी नीवळुस्यान. <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />यतिकी नाव नीम हात्‍ती नाम्द खुशखबरी सिर्फ शब्दगोळ देल अच ईला लेकीन सामर्थ्य देल, अदिक पवित्र आत्मा अन्द पुरा सच्चाई इन निश्चिता देल तंदान; ह्यांग नीव जान्सतीर कि नाव नीम सांगुळ ईरेव, रा नाव ह्यांग ईत्‍तेव ईद नीम भलाई इन साटी ईरोद. <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" /><note caller="+" style="x"><char style="xo" closed="false">१:६ </char><char style="xt" closed="false"><ref loc="ACT 17:5-9">प्रेरितगोळ १७:५-९</ref></char></note>नीव धोळ्द क्लेशगोळ बावजुद. पवित्र आत्मा देल सिक्द खुशी इन सांगुळ, वचन इक ग्रहण माळदुर अदिक नाम्द अदिक प्रभु उन अनुकरण माळली हतदुर. <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />इदुरसाटी हिंग माळदुर देल मकिदुनिया अदिक अखाया द्याश इन सप्पा विश्वासीगोळ साटी नीव आदर्श बन्सेदिर. <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />यतिकी नीम हात्‍ती टु प्रभु उन वचन सिर्फ मकिदुनिया अदिक अखाया दा अच केळ्सकु आत हिंग अच ईला, लेकीन नीम विश्वास इन जो परमेश्वर मा आद, हर जागा दा अदुर चर्चा फैलुसेत कि ईदुर बारा दा नामी येनु अनोद जरवत अच हैलेच. <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />यतिकी आ लॉकुर नाम बारा दा हेळतार कि नीम्द हात्‍ती नाम्द स्वागत ह्यांग आत; अदिक नीव ह्यांग मूर्तीगोळ देल परमेश्वर उन दी तिर्गदिर ताकी जित्‍ता अदिक खरा परमेश्वर उन स्यावा माळी, <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />अदिक आऊन पार उन स्वर्ग मा टु बरोद हादी कायतेला ईरी यारी आव सोत्‍तुर दा टु जित्‍ता माळ्यान, अर्थात यीशु उन, जो नामी परमेश्वर उन बरोद आद प्रकोप देल उळस्तान.<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="s">थिस्सलुनीकियों दा पौलुस उन कार्य</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />हे वार्टुरा अदिक आकतींगेरा, नीव खुद अच जान्सतीर कि नाम नीम हात्‍ती बरोद बेकार आगीदील <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" /><note caller="+" style="x"><char style="xo" closed="false">२:२ </char><char style="xt" closed="false"><ref loc="ACT 16:19-24">प्रेरितगोळ १६:१९-२४</ref>; </char><char style="xt" closed="false"><ref loc="ACT 17:1-9">प्रेरितगोळ १७:१-९</ref></char></note>लेकीन नीव खुद अच जान्सतीर नीम हात्‍ती बरोर से पयले फिलिप्पी दा दुख नेगुली अदिक अपमान सहन माळदुर मा भी नाम परमेश्वर नामी ईत्‍ता साहस कोट्टुन, कि नाव परमेश्वर उन खुशखबरी भारी विरोधगोळ ईरतेला भी नीमी केळसेव. <verse eid="1TH 2:2" /><verse number="3" style="v" sid="1TH 2:3" />यतिकी नाम्द उपदेश गलतीगोळ से हैलेच अदिक अशुध्द विचार देल, अदिक चालाकी इन सांगुळ हैलेच; <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />लेकीन ह्यांग परमेश्वर नामी योग्य ठहरूस्कु खुशखबरी सौप्सदुन, नाव हांग अच हेळतेव, अदिक इदुर दा मंळसागोळी इक ईला, लेकीन परमेश्वर उक, जो नाम मन इन उद्देशगोळी जाच तान, प्रसन्न माळतेव. <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />यतिकी नीव जान्सतीर, नाव ना रा यागलु चापलुसी माळेव अदिक ना पैस्या अन लालच इन साटी येनारा बहाना माळेव परमेश्वर नाम गवाह आन <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />अदिक नाव ना मंळसागोळ देल, ना दुसरा से, अदिक ना खुद देल प्रशंसा चाहसदेव. <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" />यीशु मसीह अन प्रेरित आगा नाता देल नाम नीम मा बोझ हाक सकेव. लेकीन याता प्रकार मोय तान चिकोर्द पालन पोषण माळतार हांग अच नाव भी नीम न्याड्या दा ईतकु धोळ्द कोमलता तोर्सदेव; <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />अदिक हांग अच नाव नीमी हापाळ प्यार माळतेला, नाव खुशी इन सांगुळ परमेश्वर उन खुशखबरी दा नाम जीवन इन द्वारा पुरा तरीका देल सामर्थ्य देल नीम्द मदत माळली तयार ईरेव, इदुरसाटी कि नीव नाम प्रिय आगेगीदीर.<verse eid="1TH 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 2:9" />यतिकी, हे वार्टुरा अदिक आकतींगेरा, निश्चित अच नीव नाम मेहनत अदिक कष्ट इक याद ईटतीर; नाव इदुरसाटी ईळ्लक हागुल क्याल्सा धंदा माळतेला नीम दा परमेश्वर उन खुशखबरी प्रचार माळदेव कि नीम दा टु यारदु मा भार आगबाळुल. <verse eid="1TH 2:9" /><verse number="10" style="v" sid="1TH 2:10" />नीव ई मात इन गवाह हुईर, अदिक हांग अच परमेश्वर भी आन, कि नाव नीम विश्वासीगोळ सांगुळ पवित्रता, लायकत अदिक निर्दोषता अन व्यवहार माळेव. <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />नीव जान्सतीर कि नाव नीम सांगुळ हांग अच व्यवहार माळतेव ह्यांग आप्प तान चिकोरगोळ सांगुळ व्यवहार माळतान. <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />कि नाव नीमी प्रोत्साहित माळदेव दिलासा कोट्टेव नाव नीमी विनती माळतेला ईत्‍तेव कि तान जीवन हिंग बितुसी कि परमेश्वर खुश आगुल, याव नीमी तान महिमा अदिक राज्य दा सहभागी आगोर साटी कारदान. <verse eid="1TH 2:12" /><verse number="13" style="v" sid="1TH 2:13" />इदुरसाटी नाव भी परमेश्वर उन धन्यवाद लगातार माळतेव कि याग नाम द्वारा परमेश्वर उन खुशखबरी इन वचन नीम हात्‍ती पोहचुस्त, रा नीव अदरी मंळसागोळ्द ईला लेकीन परमेश्वर उन वचन सम्सकु ग्रहण माळदीर; अदिक सही दा ईद हिंग अच आद; अदिक अद नीम विश्वासीगोळ दा जो विश्वास ईटतीर, प्रभावशाली आद. <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" /><note caller="+" style="x"><char style="xo" closed="false">२:१४ </char><char style="xt" closed="false"><ref loc="ACT 17:5">प्रेरितगोळ १७:५</ref></char></note>इदुरसाटी हे वार्टुरा अदिक आकतींगेरा, नीम सांगुळ भी अदा मात आगतद ह्यांग मसीह यीशु दा परमेश्वर उन आ मंडलीगोळ्द यहूदिया दा आद, यतिकी नीव तान लॉकुर से हांग अच छल सहन माळतीर, ह्यांग आंदुर भी यहूदीगोळ द्वारा सहन माळीदुर, <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" /><note caller="+" style="x"><char style="xo" closed="false">२:१५ </char><char style="xt" closed="false"><ref loc="ACT 9:23">प्रेरितगोळ ९:२३</ref>,<ref loc="ACT 9:29">२९</ref>; <ref loc="ACT 13:45">१३:४५</ref>,<ref loc="ACT 13:50">५०</ref>; <ref loc="ACT 14:2">१४:२</ref>,<ref loc="ACT 14:5">५</ref>,<ref loc="ACT 14:19">१९</ref>; <ref loc="ACT 17:5">१७:५</ref>,<ref loc="ACT 17:13">१३</ref>; <ref loc="ACT 18:12">१८:१२</ref></char></note>यार प्रभु यीशु उक अदिक भविष्यवक्तागोळी भी कोंद कोंडुर अदिक नाम सांगुळ छल माळदुर, अदिक परमेश्वर आंदुर से प्रसन्न हैलेच, अदिक आंदुर सप्पा मंळसागोळ्द विरोध माळतार, <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />अदिक आंदुर गैरयहूदीगोळी आंदुर उद्धार इन साटी परमेश्वर उन खुशखबरी हेळोर साटी नामी रोक्सतार कि हमेशा तान पाप इन घळा तुमतेला ईरूल; लेकीन आंदुर मा परमेश्वर उन भयानक प्रकोप होट बंदाद.<verse eid="1TH 2:16" /></para>
  <para style="s">पौलुस उन दुबारा थिसलिनीकिगोळी सिकोद अभिलाषा</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />हे वार्टुरा अदिक आकतींगेरा, याग नाव थ्वाळासा समय इन साटी, मन दा ईला लेकीन मय देल, नीम से अलग आगेगीदेव, रा नाव हापाळ कोशिशगोळ सांगुळ नीमी नोळोर साटी हापाळ कोशिश माळदेव. <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />इदुरसाटी नाव ऊंद धन ईला लेकीन घळी-घळी नीम हात्‍ती बरोद चाहसदेव, लेकीन शैतान नामी रोक्सकु ईटदुन. <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />भला नाम आशा या आनन्द या बळाई इन मुकुट येन आद? येन नाम प्रभु यीशु उन मुंद आऊन बरोद समय नीम अच ईरतीदील? <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />नाम बळाई अदिक खुशी नीव अच हुईर.<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="s">तीमुथियुस उन मुलाकात</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">३:१ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 17:15">प्रेरितगोळ १७:१५</ref>
      </char>
    </note>इदुरसाटी याग नाम से अदिक ईतकु आगीदील, रा नाव ईद ठहरूसदेव कि एथेंस नगर दा आबना ईतोगुल, <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />अदिक नाव तीमुथियुस उक, जो मसीह अन खुशखबरी दा नामव वार्ट अदिक परमेश्वर उन भी सेवक आन, इदुरसाटी कळ्यान कि आव नीमी संची माळुल अदिक नीम विश्वास इन बारा दा नीमी समझुसुल.<verse eid="1TH 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TH 3:3" />कि नीम दा टु यावारा भी इव क्लेशगोळ कारण डगमगुस बाळुल. यतिकी नीव खुद अच जान्सतीर कि ईद सताप नाम साटी परमेश्वर उन इच्छा अन भाग हुन. <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />यतिकी पयला अच, याग नाव नीम सांगुळ ईर तोगेव रा नीम से अन तोगेव कि नामी क्लेश नेगव बिद्दव, अदिक हिंग अच आग्याद, ह्यांग कि नीव जान्सतीर भी. <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />ईद कारण याग नान से अदिक ईतकु आगीदील, रा नीम्द विश्वास इन बारा दा जानसोर साटी कळुदीन, कि यागलु हिंग आगबाळुल कि परीक्षा माळावाळेर शैतान नीम परीक्षा माळीदार, अदिक नाम मेहनत बेकार आगीदाद.<verse eid="1TH 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">३:६ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:5">प्रेरितगोळ १८:५</ref>
      </char>
    </note>लेकीन ईगल्या तीमुथियुस, जो नीम हात्‍ती टु नाम हात्‍ती बंदान, नीम्द वळ्लीद विश्वास अदिक प्यार इन बातणी केळ्सदुन अदिक ईद मात इक भी केळ्सदुन कि नीव हमेशा प्यार इन सांगुळ नामी याद माळतीर, अदिक ह्यांग नाव नीमी नोळोर साटी लालच ईटतेव हांगा नीव भी ईटतीर. <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />इदुरसाटी हे वार्टुरा अदिक आकतींगेरा, तान सप्पा दुख अदिक क्लेश दा नीम विश्वास इन कारण नामी नीम बारा दा प्रोत्साहन सिक्त. <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />यतिकी ईग अगर नीव प्रभु दा संची ईरी रा नाव जित्‍ता आयेव. <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />यतिकी नाव नीम साटी परमेश्वर उन धन्यवाद माळ सकतेव. जो खुशी नामी परमेश्वर उन उपस्थिती दा सिकतद, इदुरसाटी परमेश्वर उन धन्यवाद माळतेव. <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />नाव ईळ्लक हागुल हापाळ अच प्रार्थना माळतेला ईरतेव कि नीमी मुंद नोळेव, अदिक नीम विश्वास इन कमी पुरा माळेव.<verse eid="1TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />ईग नामव परमेश्वर अदिक आप्प खुद अच अदिक नाम प्रभु यीशु, नीम हात्‍ती बरोर साटी नाम हादी तेरूल; <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />अदिक प्रभु हिंग माळुल कि ह्यांग नाव नीम से प्यार ईटतेव, हांग अच नीम प्यार भी आपस दा अदिक सप्पा मंळसागोळ सांगुळ वाळुसुल, अदिक उन्नती माळतेला होगुल, <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />ताकी आव नीम मनगोळी हिंग संची माळुल कि याग नामव प्रभु यीशु तान सप्पा पवित्र लॉकुर सांगुळ बरूल, रा खुद नाम परमेश्वर आप्प उन उपस्थिती निर्दोष ठहरूसुल.<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="s">जीवन जो परमेश्वर उक खुश माळुल</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />इदुरसाटी हे वार्टुरा अदिक आकतींगेरा, नाव नीम से विनती माळतेव अदिक नीमी प्रभु यीशु मसीह दा समझुसतेव कि ह्यांग नीव नाम से योग्य चाल नळोद अदिक परमेश्वर उक खुश माळोद कलतीर, अदिक ह्यांग नीव नळुतीर भी, हांग अच अदिक भी वाळुस्तेला होगी. <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />यतिकी नीव जान्सतीर कि नाव प्रभु यीशु उन अधिकार देल नीमी याता-याता शिक्षागोळ कोटेव. <verse eid="1TH 4:2" /><verse number="3" style="v" sid="1TH 4:3" />परमेश्वर उन इच्छा ईद आद कि नीव पवित्र बन्सी: अर्थात व्यभिचार देल उळ्दकु ईरी, <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />अदिक नीम दा टु हर ऊंद मंळसा अक ईद जान्स पायजे कि तान-तान हिंग्स उन सांगुळ पवित्रता अदिक आदर इन सांगुळ व्यवहार माळोद आद ईद नीमी कलु पायजे, <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />अदिक ईद क्याल्सा अभिलाषा देल ईला, अदिक ना आ गैरयहूदीगोळ घाई जो परमेश्वर उक जान्सालुर, <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />कि ईद मात दा याऊ तान सहकर्मी वार्ट उक ठगुसबाळुल, अदिक आऊन फायदा नेगुबाळी, यतिकी प्रभु ईव सप्पा मातगोळ बदला ताकोमावाळा आन; ह्यांग कि नाव पयले अच नीम से अंदेव अदिक चितुस देव भी. <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />यतिकी परमेश्वर नामी अशुध्द दा ईरोरसाटी ईला, लेकीन पवित्र आगोर साटी कारदान. <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />ईद कारण जो ईद शिक्षा अक नकार्सतान, आव मंळसा अक ईला लेकीन परमेश्वर उक नकार्सतान, जो तान पवित्र आत्मा नीमी कोळतान.<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />लेकीन भाईचारा अन प्यार इन बारा दा ईद जरूरी हैलेच कि ना नीम हात्‍ती येनारा लिख्साईन, यतिकी आपस दा प्यार ईटोद नीव खुद अच परमेश्वर देल कलतीर; <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />अदिक पुरा मकिदुनिया नोर सप्पा वार्टुर आकतींगेर सांगुळ हिंग प्यार माळतीर. लेकीन हे वार्टुरा अदिक आकतींगेरा, नाव नीमी समझुसतेव कि यक्कुल अच वाळुस्तेला होगी, <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />अदिक ह्यांग नाव नीमी आग्या कोटेव, हांग अच शांती देल जीवन जीऊसोद अदिक तान-तान क्याल्सा माळली अदिक तान-तान कय देल कमुसोद कोशिश माळी; <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />ताकी व्हार्यावाळेर से आदर प्राप्त माळी, अदिक नीमी यातोदु वस्तु उन कमी आगबाळुल.<verse eid="1TH 4:12" /></para>
  <para style="s">प्रभु उन दुबारा बरोद</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />हे वार्टुरा अदिक आकतींगेरा, नाव चाहसालेव कि नीव आंदुर बारा दा जो सोतकु आर, अग्यानी ईरी; हिंग आगबाळुल कि नीव दुसरा अन घाई शोक माळी यारी आशा हैलेच. <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />यतिकी अगर नाव विश्वास माळतेव कि यीशु सोत्‍तुन अदिक जित्‍ता भी आदुन, रा हांग अच परमेश्वर आंदरी भी जो यीशु मा विश्वास माळतेला सोत्‍तुर, यीशु उन सांगुळ जित्‍ता माळ्यान. <verse eid="1TH 4:14" /><verse number="15" style="v" sid="1TH 4:15" /><note caller="+" style="x"><char style="xo" closed="false">४:१५ </char><char style="xt" closed="false"><ref loc="1CO 15:51">१ कुरिन्थि १५:५१</ref>,<ref loc="1CO 15:52">५२</ref></char></note>यतिकी जो प्रभु नामी कलस्यान नाव प्रभु उन वचन इन अनुसार नीम से ईद अनतेव कि नाव जो जित्‍ता आयेव अदिक प्रभु उन बरासताका ताका उळ्दकु ईत्‍तेव, सोत्तुर देल मुंद वाळुसतीदिल. <verse eid="1TH 4:15" /><verse number="16" style="v" sid="1TH 4:16" />यतिकी प्रभु खुद अच स्वर्ग टु ईळदान; आ समय ललकार, अदिक प्रधान स्वर्गदूत उन शब्द केळ बंदीत, अदिक परमेश्वर उन तुरही उदकु आदीत; अदिक जो मसीह दा विश्वास माळतेला सोतार, आंदुर पयले जित्‍ता माळकु आदार. <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />आग नाव जो जित्‍ता अदिक उळ्दकु ईत्‍तेव आंदुर सांगुळ बादलगोळ मा नेगुकु आदेव कि हवा दा प्रभु उन सांगुळ सिकुल; अदिक ईद रीति देल नाव हमेशा प्रभु उन सांगुळ ईत्‍तेव. <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />ईद प्रकार इव मातगोळ देल आबुर दाबुरी प्रोत्साहित माळतोगी.<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="s">प्रभु उन बरोद साटी तयार ईरी</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />लेकीन हे वार्टुरा अदिक आकतींगेरा, समय अदिक कालगोळ बारा दा नीमी येनु लिखसोद जरवत हैलेच. <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" /><note caller="+" style="x"><char style="xo" closed="false">५:२ </char><char style="xt" closed="false"><ref loc="MAT 24:43">मत्ती २४:४३</ref>; <ref loc="LUK 12:39">लूका १२:३९</ref>; <ref loc="2PE 3:10">२ पतरस ३:१०</ref></char></note>यतिकी नीव खुद अच जान्सतीर कि ह्यांग ईळ्लक इक काळ्ल बरतान, हांग अच प्रभु उन दिन बरोद आद. <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />याग लॉकुर अनतेला ईत्‍तार, “कुशल आद, अदिक येनु अंज्क हैलेच,” रा आंदुर मा अचानक विनाश बंदीत, याता प्रकार व्हाट्या दी आर्त इक दुख; अदिक आंदुर यातोदु रीति देल ऊळुतीदील. <verse eid="1TH 5:3" /><verse number="4" style="v" sid="1TH 5:4" />लेकीन हे वार्टुरा अदिक आकतींगेरा, नीव रा अंधकार दा हैलेच कि अद दिन नीम मा काळ्ल उन घाई बंदकु बिळुल. <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />यतिकी नीव सब ज्योति अदिक हागुल इन चिकोर हुईर; नाव ना ईळ्लक इन आयेव, ना अंधकार इन आयेव. <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />इदुरसाटी नाव दुसरा अन घाई मिंगकु ईरतीदील, लेकीन जागस्तेला अदिक सावधान ईत्‍तेव. <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />यतिकी जो मींगतार आंदुर ईळ्लकी इच मींगतार, अदिक जो मतवाला ईरतार आंदुर ईळ्लकी इच मतवाला ईरतार. <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" /><note caller="+" style="x"><char style="xo" closed="false">५:८ </char><char style="xt" closed="false"><ref loc="EPH 6:13-17">इफिसिगोळ ६:१३-१७</ref></char></note>लेकीन नाव जो हागुल इनोर हुयेव, विश्वास अदिक प्यार इन कवच हाक्‍कु अदिक उद्धार इन आशा अन टोप हाक्‍कु सावधान ईत्तेव. <verse eid="1TH 5:8" /><verse number="9" style="v" sid="1TH 5:9" />यतिकी परमेश्वर नामी सिट्ट इन साटी ईला, लेकीन इदुरसाटी ठहरूस्यान कि नाव तान प्रभु यीशु मसीह अन द्वारा उद्धार प्राप्त माळेव. <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />यीशु नाम साटी ईद कारण सोत्‍तुन कि नाव जित्‍ता ईरूल या सोतकु ईरूल, याग आव बंदान आग सप्पा मीलुस्कु आऊंदा सांगुळ जीऊसेव. <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />ईद कारण आबुर दाबुरी दिलासा कोळी अदिक आबुर दाबुर इन मदत इन कारण बन्सी, ह्यांग कि नीव माळतीर भी.<verse eid="1TH 5:11" /></para>
  <para style="s">आखरी शिक्षा</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />हे वार्टुरा अदिक आकतींगेरा, नाव नीम से विनती माळतेव कि जो नीम दा मेहनत माळतार, अदिक नीम मसीह जीवन दा नीमोर अगुवे आर, अदिक नीमी शिक्षा कोळतार, आंदुर्द सम्मान माळी. <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />अदिक आंदुर क्याल्सा अन कारण प्यार इन सांगुळ आंदरी हापाळ अच आदर इन योग्य समसी. आपस दा मेल मिलाप देल ईरी. <verse eid="1TH 5:13" /><verse number="14" style="v" sid="1TH 5:14" />हे वार्टुरा अदिक आकतींगेरा, नाव नीमी समझुसतेव कि जो ठीक चाल नळालुर आंदरी समझुसी, कायरगोळी हिम्मत कोळी, निर्बलगोळी सभांळसी, सप्पा दी सहनशीलता तोर्सी. <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />सावधान. याऊ यारदु से बुराई इन बदला बुराई माळबाळुल; लेकीन हमेशा वळ्लीद माळदुर मा तत्पर ईरी, आपस दा अदिक सप्पा मुंदुर से भी भलाई माळी. <verse eid="1TH 5:15" /><verse number="16" style="v" sid="1TH 5:16" />हमेशा खुश ईरी. <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />हमेशा प्रार्थना दा हतकु ईरी. <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />हर मात दा धन्यवाद माळी; यतिकी नीम मसीह यीशु दा परमेश्वर उन ईदा इच्छा आद. <verse eid="1TH 5:18" /><verse number="19" style="v" sid="1TH 5:19" />आत्मा अक नुनाक बाळी. <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />परमेश्वर उन दी टु बरावाळा बातणी इन धिक्कार माळबाळी. <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />सप्पा मातगोळी परखुसी; जो वळ्लेव आव अवरी हुळकु ईटी. <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />सप्पा प्रकार इन बुराई देल उळ्दकु ईरी.<verse eid="1TH 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />शांती नव परमेश्वर खुद अच नीमी पुरा रीति देल पवित्र माळुल; अदिक नीम्द आत्मा अदिक जीव अदिक शरीर नाम प्रभु यीशु मसीह अन बरोद ताका पुरा-पुरा अदिक निर्दोष सुरक्षित ईरूल. <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />नीमव कारावाळा विश्वासलायक आन, अदिक आव हिंग अच माळ्यान.<verse eid="1TH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />हे वार्टुरा अदिक आकतींगेरा, नाम साटी प्रार्थना माळी.<verse eid="1TH 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26" />सप्पा विश्वासी वार्टुरी परमेश्वर उन पवित्र प्यार दा नमस्कार.<verse eid="1TH 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1TH 5:27" />ना नीमी प्रभु उन अधिकार देल नीमी विनती माळतीन कि ईद चिट्ठी सप्पा विश्वासी वार्टुरी वाचुसकु केळ्सकु आगुल.<verse eid="1TH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28" />नाम प्रभु यीशु मसीह अन्द अनुग्रह नीम मा आगतेला ईरूल.<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>