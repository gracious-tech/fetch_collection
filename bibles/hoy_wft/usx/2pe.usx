<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2PE" style="id">- Holiya</book>
  <para style="h">२ पतरस</para>
  <para style="toc3">२ पतरस</para>
  <para style="toc2">२ पतरस</para>
  <para style="toc1">पतरस उन दुसरा चिट्ठी</para>
  <para style="mt2">पतरस की दूसरी पत्री</para>
  <para style="mt1">पतरस उन दुसरा चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">२ पतरस उन चिट्ठी दा अंदकु आग्याद कि ईद प्रेरित पतरस उन द्वारा लिख्सकु आगीत, लेकीन ईंदीनोर हापाळ विधवानगोळी हताल कि ईद सही आद. ईद संभव आद कि यावारा दुसरा ई चिट्ठी इक पतरस उन दी टु लिख्सीदान. लेखक अनतान कि आव यीशु उन जीवन अदिक विशेष रूप दा रूपान्तरण <char style="xt"><ref loc="2PE 1:17-18">१:१७-१८</ref></char> इन साटी ऊंद प्रत्यक्षदर्शी ईरोन, अगर पतरस चिट्ठी लिखसीदुन रा संभव आद कि आव रोम नगर दा ६५ टु ६९ साल इन बाद्दा अदिक मसीह अन्द जनम इन बाद्दा लिख्सीदान. पतरस १ पतरस इन चिट्ठी इन बाद्दा लेखन इन तारीख ईटकु तान दुसरा चिट्ठी <char style="xt"><ref loc="2PE 3:1">३:१</ref></char> भी लिख्सदुन. आव सप्पा इसाईगोळी चिट्ठी संबोधित माळदुन.</para>
  <para style="ip">पतरस ई चिट्ठी इक वळ्लीद जीवन जीऊसोर साटी प्रोत्साहित माळली अदिक ख्वाटा गुरुगोळ्द <char style="xt"><ref loc="2PE 2">२</ref></char> पालन ईला माळोर साटी चेतावनी कोळोर साटी लिखसीदुन. आव आंदरी आ लॉकुरी अनदेखा माळोर साटी प्रोत्साहित माळदुन जो अनेत्यार कि यीशु वापस बरली हापाळ लंबा समय ताकोमेत्यान. ईदुर उलटा आव आंदरी इंगित माळदुन कि परमेश्वर धीरा हैलेच बल्‍की सप्पा मुंदुरी ऊळसोद चाहासतान <char style="xt"><ref loc="2PE 3:8-9">२ पतरस ३:८-९</ref></char> ईद वळ्लीद जीवन जीऊसोद ऊंद कारण आद <char style="xt"><ref loc="2PE 3:14">३:१४</ref></char>.</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. पतरस खुद इक पेश माळतान अदिक तान पाठकगोळी संबोधित माळतान. <char style="ior"><ref loc="2PE 1:1-2">१:१-२</ref></char></para>
  <para style="io1">२. आव आंदरी वळ्लीद जीवन जीऊसोद याद तोर्सतान यतिकी परमेश्वर नामी सक्षम माळ्यान. <char style="ior"><ref loc="2PE 1:3-21">१:३-२१</ref></char></para>
  <para style="io1">३. आव ख्वाटा गुरुगोळ्द खिलाप चेतावनी कोळतान अदिक अनतान कि आखरी दा ख्वाटा गुरुगोळ सांगुळ येन आदीत. <char style="ior"><ref loc="2PE 2:1-22">२:१-२२</ref></char></para>
  <para style="io1">४. पतरस यीशु उन बरोर साटी तयार आगोर साटी वळ्लीद जीवन जीऊसोद साटी विश्वासीगोळी प्रोत्साहित माळतान. <char style="ior"><ref loc="2PE 3:1-17">३:१-१७</ref></char></para>
  <chapter number="1" style="c" sid="2PE 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1"/>शमौन पतरस उन दी टु, जो यीशु मसीह अन्द दास अदिक प्रेरित आर,</para>
  <para style="p" vid="2PE 1:1">आ लॉकुर हेसुर यार नामव परमेश्वर अदिक उद्धारकर्ता यीशु मसीह अन्द न्याय इन द्वारा नाम घाई किमती विश्वास प्राप्त माळ्यार.<verse eid="2PE 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2"/>परमेश्वर उन अदिक नाम प्रभु यीशु उन पयचान इन द्वारा अनुग्रह अदिक शांती नीम दा बहुतायत देल वाळुस्त होगुल.<verse eid="2PE 1:2"/></para>
  <para style="s">ईश्वरीय बुलाहट अदिक चुनाव</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3"/>यतिकी परमेश्वर उन ईश्वरीय सामर्थ्य सप्पा येनारा जो भक्तिमय जीवन हततद, नामी अदुर्दा पयचान इन द्वारा कोटान, याव नामी तान अच महिमा अदिक सदगुण इन अनुसार कारदान. <verse eid="2PE 1:3"/><verse number="4" style="v" sid="2PE 1:4"/>यऊर द्वारा आव नामी किमती अदिक हापाळ अच धोळ्द वादा कोटुन: कि इऊर द्वारा नीव आ भ्रष्टता देल बीळस्कु, जो दुनिया दा बेकार अभिलाषागोळ देल आगतद, ईश्वरीय स्वभाव इन सहभागी आगेगी. <verse eid="2PE 1:4"/><verse number="5" style="v" sid="2PE 1:5"/>ईदा कारण सप्पा प्रकार इन कोशिश माळकु तान विश्वास दा भक्तिभाव इक जोळसी; अदिक भक्तिभाव दा ग्यान इक, <verse eid="2PE 1:5"/><verse number="6" style="v" sid="2PE 1:6"/>अदिक तान ग्यान दा आत्मसंयम इक जोळ्स, अदिक आत्मसंयम दा धीरज इक जोळसी, अदिक धीरज दा परमेश्वर उन भक्ति इक, <verse eid="2PE 1:6"/><verse number="7" style="v" sid="2PE 1:7"/>अदिक नीम्द परमेश्वर उन भक्ति दा मसीह भाईचारा अक; अदिक मसीह भाईचारा दा प्यार इक जोळ्सी. <verse eid="2PE 1:7"/><verse number="8" style="v" sid="2PE 1:8"/>यतिकी ईव पुरा गुणगोळ्द जरवत आद, अदिक अगर ईव मातगोळ नीम दा बहुतायत देल आव रा ईद नीमी नाम्द प्रभु यीशु मसीह अन ग्यान दा क्रियाशील अदिक प्रभावशाली माळ्याव. <verse eid="2PE 1:8"/><verse number="9" style="v" sid="2PE 1:9"/>लेकीन अगर नीम दा ईव मातगोळ ईलच, रा नीम इक दुर दृष्टी ईला नीव कुढ्ढ आईर तथा मारतोगीर कि नीम्द पयला अन पाप तोळकु आगेग्याव.<verse eid="2PE 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10"/>ईदा कारण हे वार्टुरा, तान कारूकु आगोद, अदिक निवळुस्द आगोद इक सिद्ध माळोर साटी वळ्लीद रीति देल कोशिश माळतोगी, यतिकी अगर हिंग माळीर रा यागलु ठोकर तिनतीदील; <verse eid="2PE 1:10"/><verse number="11" style="v" sid="2PE 1:11"/>बल्‍की ई रीति देल नीव नाम्द प्रभु अदिक उद्धारकर्ता यीशु मसीह अन्द अनन्त राज्य दा धोळ्द आदर इन सांगुळ प्रवेश माळ सकीर.<verse eid="2PE 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12"/>इदुरसाटी अगर नीव ईव मातगोळी जान्सतीर, अदिक जो सच्चाई इन वचन नीमी सिक्याद अदुर दा बन्सकु ईरतीर, तरी ना नीमी ईव मातगोळ्द याद तोरसोर साटी हमेशा तयार ईराइन. <verse eid="2PE 1:12"/><verse number="13" style="v" sid="2PE 1:13"/>ना ईद तान साटी सही सम्सतीन कि यागासताका ना ईद मय दा जित्‍ता आईन, आगासताका ना नीमी याद तोर्सतेला ईराइन. <verse eid="2PE 1:13"/><verse number="14" style="v" sid="2PE 1:14"/>यतिकी ना जान्सतीन कि ना तान नाशवन्त मय बिळावाळा आईन, ह्यांग कि नामव प्रभु यीशु मसीह नानी ईद हेळीदुन. <verse eid="2PE 1:14"/><verse number="15" style="v" sid="2PE 1:15"/>इदुरसाटी ना तान दी टु पुरा कोशिश माळाईन कि नान सोत्‍तुर बाद्दा भी नीव लॉकुर ईव सप्पा मातगोळ इक हमेशा याद माळ सकीर.<verse eid="2PE 1:15"/></para>
  <para style="s">मसीह अन महिमा अन कण्णगोळ नोळ्द गवाह</para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16"/>यतिकी याग नाव नीमी तान प्रभु यीशु मसीह अन सामर्थ्य इन अदिक आगमन इन समाचार कोटीदेव, रा अद चतुराई देल नटकु कात्‍तागोळ्द अनुकरण ईला ईरोद बल्‍की नाव खुद अच आऊन महानता अक नोळीदेव. <verse eid="2PE 1:16"/><verse number="17" style="v" sid="2PE 1:17"/><note caller="+" style="x"><char style="xo" closed="false">१:१७ </char><char style="xt" closed="false"><ref loc="MAT 17:1-5">मत्ती १७:१-५</ref>; <ref loc="MRK 9:2-7">मरकुस ९:२-७</ref>; <ref loc="LUK 9:28-35">लूका ९:२८-३५</ref></char></note>यतिकी याग आऊक परमेश्वर आप्प से आदर अदिक प्रशंसा सिक्त अदिक आ प्रतापमय महिमा दा टु ईद वाणी बत्‍त, “ईव नान प्रिय पार हुन, यार देल ना खुश आईन.” <verse eid="2PE 1:17"/><verse number="18" style="v" sid="2PE 1:18"/>याग नाव आऊन सांगुळ पवित्र पहाळी मा ईरेव अदिक आकाश टु ईद वाणी बर्त केळदेव.<verse eid="2PE 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19"/>नाम हात्‍ती जो भविष्यवक्तागोळ वचन आद, अद ई घटना देल मजबूत ठहरूस्त. नीव ईद वळ्लीद माळतीर जो ईद सम्सकु आऊन मा ध्यान माळतीर कि आव ऊंद दिंग्या हुन, जो अंधार जागा दा आ समय ताका उजुळ कोळतेला ईरतद यागासताका कि व्हातुर आगाल अदिक व्हातुर इन तारा नीम्द मन दा चमकुसाल्द. <verse eid="2PE 1:19"/><verse number="20" style="v" sid="2PE 1:20"/>सब से धोळ मात ईद आद कि नीमी ईद जान्स कोम पायजे कि शास्त्र अन यातोदारा भी भविष्यवाणी यातोदु भविष्यवक्ता अन नीजी विचारगोळ्द आधार मा कोळ्द स्पष्टीकरण आल्लच. <verse eid="2PE 1:20"/><verse number="21" style="v" sid="2PE 1:21"/>यतिकी यातोदारा भी भविष्यवाणी मंळसा अन इच्छा देल यागलु आगीदील, लेकीन भक्त जन प्रभावित आगकु पवित्र आत्मा अन द्वारा परमेश्वर उन दी टु माताळतोगोर.<verse eid="2PE 1:21"/></para>
  <chapter eid="2PE 1"/>
  <chapter number="2" style="c" sid="2PE 2"/>
  <para style="s">ख्वाटा गुरु</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1"/>ह्यांग पूर्वकाल दा लॉकुर्द न्याड्या दा ख्वाटा भविष्यवक्ता प्रगट आगीदुर, अदा प्रकार नीम्द न्याड्या दा भी ख्वाटा गुरु प्रगट आदार. आंदुर भटकुसावाळा सच्चाई सिद्धांतगोळ इक तंदार, अदिक आ स्वामी इन इनकार माळ्यार याव आंदरी कोंड कोंडान, अदिक हिंग माळकु आंदुर तान जल्दी विनाश इक निमंत्रण कोट्टार. <verse eid="2PE 2:1"/><verse number="2" style="v" sid="2PE 2:2"/>तरी भी हापाळ पुरा लॉकुर आंदुर्द अनैतिक हादीगोळ मा नळदार; यतिकी जो आंदुर माळतार, आदुर वजह देल दुसरा मुंदुर अपमान सच्चाई अन्द बदला माळ्यार. <verse eid="2PE 2:2"/><verse number="3" style="v" sid="2PE 2:3"/>आंदुर लोभ दा बंदकु ख्वाटा मातगोळी माळ्यार अदिक नीम से अनुचित लाभ नेगदार. दण्ड इन आग्या रा आंदुर मा पयले टु अच आगेग्याद, अदिक आंदुर्द विनाश इन निर्णय आगेग्याद.<verse eid="2PE 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4"/>यतिकी याग परमेश्वर आ स्वर्गदूतगोळ इक यार पाप माळदुर आंदरी बिटीदिल, लेकीन नरक दा कळुकु अंधार दा हाक्‍क बुट्टुर ताकी न्याय इन दिन ताका शंकलीगोळ दा दुख सहन माळुल; <verse eid="2PE 2:4"/><verse number="5" style="v" sid="2PE 2:5"/>अदिक स्याणा लॉकुर युग इन दुनिया अक भी बिटीदिल बल्‍की भक्तिहीन दुनिया मा महा जल प्रलय कळुदुन, लेकीन न्याय इन प्रचार माळावाळा नूह अदिक येळ मंळसागोळी ऊळ्स बुट्टुन; <verse eid="2PE 2:5"/><verse number="6" style="v" sid="2PE 2:6"/>अदिक सदोम अदिक गमोरा अन नगरगोळ इक दोषी ठहरूस्कु दण्ड कोट्टुन अदिक आंदरी बेक्‍की देल भसम माळदुन ताकी आंदुर बरावाळेर भक्तिहीन लॉकुर्द शिक्षा अन साटी उदाहरण बनसुल, <verse eid="2PE 2:6"/><verse number="7" style="v" sid="2PE 2:7"/>अदिक न्यायी लूत इक जो अन्यायीगोळ्द अनैतिक चाल चलन देल हापाळ दुखी ईरोन छुटकारा कोट्टुन. <verse eid="2PE 2:7"/><verse number="8" style="v" sid="2PE 2:8"/>यतिकी आव न्यायी आंदुर बीच दा ईरतेला अदिक आंदुर अन्याय इन क्याल्सागोळ इक नोळ नोळकु अदिक केळ केळकु, हर दिन दुख देल तळपुस तोगोन. <verse eid="2PE 2:8"/><verse number="9" style="v" sid="2PE 2:9"/>रा प्रभु भक्तगोळ इक परीक्षा दा टु तेगोद अदिक अन्यायीगोळ इक न्याय इन दिन ताका दण्ड इन दशा दा ईटोद भी जानस्तान, <verse eid="2PE 2:9"/><verse number="10" style="v" sid="2PE 2:10"/>विशेष माळकु आंदरी जो कलंकीत अभिलाषागोळ हिंद मय इन अनुसार नळुतार अदिक प्रभु अक तुच्छ जानस्तार.</para>
  <para style="p" vid="2PE 2:10">आंदुर ढीठ, अदिक जिद्दी आर, अदिक धोळ पदवाळेर इक भला बुरा माताळली अंजालुर, <verse eid="2PE 2:10"/><verse number="11" style="v" sid="2PE 2:11"/>तरी भी स्वर्गदूतगोळ जो न्याय अदिक सामर्थ्य दा ख्वाटा गुरुगोळ देल धोड्डेर आर, प्रभु उन मुंद आंदरी बुरा भला अनकु दोष हचालुर. <verse eid="2PE 2:11"/><verse number="12" style="v" sid="2PE 2:12"/>लेकीन ई लॉकुर निर्बुद्धी पशुगोळ्द अच तुल्य आर, जो हुळकु आगोर साटी अदिक नाश आगोर साटी पैदा आग्यार; अदिक या मातगोळ इक जानसालुर अच अदुर बारा दा दुसरा अक भला बुरा अनतार, आंदुर आळी दाकळोद पशुगोळ्द घाई नाश माळकु आदार. <verse eid="2PE 2:12"/><verse number="13" style="v" sid="2PE 2:13"/>दुसरा अन बुरा माळोद बदला आंदुर दा बुरा आदीत. आंदरी ईळ्लक हागुल भोग विलास माळोद भला हततद. हिंग लॉकुर कलंकीत अदिक दोषी आर; याग आंदुर नीम सांगुळ तिनतार अदिक कुडुतार, रा आंदुर ध्वाका धळी देल भोज माळकु भोग विलास माळतार. <verse eid="2PE 2:13"/><verse number="14" style="v" sid="2PE 2:14"/>आंदुर कण्णगोळ दा व्यभिचार कुर्तकु आद, अदिक आंदुर पाप माळदुर बिना रूक्स सकालुर. आंदुर कमजोर लॉकुरी जाल दा फसुस कोमतार. आंदुर मन इक लोभ माळोद अभ्यास आगेग्याद; परमेश्वर उन शराप आंदुर मा आद. <verse eid="2PE 2:14"/><verse number="15" style="v" sid="2PE 2:15"/>आंदुर सीदा हादी अक बिटकु भटकुसेग्यार, अदिक बओर उन पार बिलाम उन हादी मा आगेग्यार, याव अन्याय इन मजदूरी इक प्रिय जान्सदुर; <verse eid="2PE 2:15"/><verse number="16" style="v" sid="2PE 2:16"/>अदिक आऊक आऊन पाप इन बारा दा फटकार सिक्त, ईल ताका कि अबोल गधा मंळसा अन बोली देल आ भविष्यवक्ता अक आऊन बावलापन देल रोक्सत.<verse eid="2PE 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17"/>ई लॉकुर वंळगींद भायगोळ, अदिक आंधी इन हार्स्द बादल उर; परमेश्वर आंदुर साटी अनन्त खोल अंधकार ठहरूस्यान. <verse eid="2PE 2:17"/><verse number="18" style="v" sid="2PE 2:18"/>आंदुर बेकार घमण्ड इन मातगोळी माळ माळकु अनैतिक क्याल्सागोळ द्वारा, आ लॉकुरी शारीरिक अभिलाषागोळ दा फसुस बुळतार जो भटकुसकु दा टु होळोद सुरूवात ईगल्या अच माळेत्यार. <verse eid="2PE 2:18"/><verse number="19" style="v" sid="2PE 2:19"/>आंदुर आंदरी स्वतंत्र माळोद प्रतिग्या रा माळतार, लेकीन खुद अच भ्रष्टता अन दास आर; यतिकी जो मंळसा यार देल हारूसेग्यान, आव आऊन दास बनसेगतान. <verse eid="2PE 2:19"/><verse number="20" style="v" sid="2PE 2:20"/>याग आंदुर प्रभु अदिक उद्धारकर्ता यीशु मसीह अन पयचान इन द्वारा दुनिया अन नाना प्रकार इन कलंक देल उळ्दकु होट्टुर, अदिक मात्‍त आंदुर दा फसुसकु हारूसेदूर, रा आंदुर्द पिछला दशा पयले टु भी बेकार आगेग्याद. <verse eid="2PE 2:20"/><verse number="21" style="v" sid="2PE 2:21"/>यतिकी न्याय इन हादी इन ईला जानसोद अच आऊन साटी इदुर से भला आगाईत कि अदरी जान्सकु, आ पवित्र आग्या देल बदलुसेगायदुर जो आंदरी कोटकु आगीत. <verse eid="2PE 2:21"/><verse number="22" style="v" sid="2PE 2:22"/>आंदुर मा ईद कहावत सही कुरतद, कि नाय तान माळ्स इन दी अदिक मय कय तोळ्द हंदी केसुर दा गळबळ्या होडोर साटी मात्‍त ओळेगतद.<verse eid="2PE 2:22"/></para>
  <chapter eid="2PE 2"/>
  <chapter number="3" style="c" sid="2PE 3"/>
  <para style="s">प्रभु उन मात्‍त बरोद वाचा</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1"/>हे प्रिय संगीगोळा, ईग ना नीमी ईद दुसरा चिट्ठी लिख्सतीन, अदिक येढ्ढु दा याद कोळसुस्कु नीम्द शुद्ध मन इक जागृत माळोद विचार माळतीन, <verse eid="2PE 3:1"/><verse number="2" style="v" sid="2PE 3:2"/>कि नीव आ मातगोळ इक जो पवित्र भविष्यवक्ता पयले टु अंदार, अदिक प्रभु अदिक उद्धारकर्ता अन आ आग्या अक याद माळी जो नीम्द प्रेरितगोळ उन द्वारा कोटकु आगीत. <verse eid="2PE 3:2"/><verse number="3" style="v" sid="2PE 3:3"/><note caller="+" style="x"><char style="xo" closed="false">३:३ </char><char style="xt" closed="false"><ref loc="JUD 1:18">यहूदा १:१८</ref></char></note>सब से पयले ईद जान्स कोमी कि आखरी दिनगोळ दा नीम्द मज्याक हार्सावाळेर बंदार जो तान अच अभिलाषागोळ्द अनुसार नळदार <verse eid="2PE 3:3"/><verse number="4" style="v" sid="2PE 3:4"/>अदिक केळ्यार, “आव बरोद प्रतिग्या माळीदुन, येन आव माळीदिल? आव येल आन? नाम पुर्वज रा पयला टु अच सोतोग्यार लेकीन यागी टु दुनिया बनस्याद सप्पा मातगोळ हांग अच नळुतेला बरेत्याव.” <verse eid="2PE 3:4"/><verse number="5" style="v" sid="2PE 3:5"/>आंदुर रा जान बुझुस्कु ईद मारतोदुर कि परमेश्वर उन कोळ्द आग्या देल आकाश अदिक पृथ्वी माळकु आग्याद अदिक पृथ्वी नीर दा टु बन्सत अदिक नीर दा संची आद, <verse eid="2PE 3:5"/><verse number="6" style="v" sid="2PE 3:6"/>इदुर्दा कारण आ दुनिया अन दुनिया नीर दा मुळ्ककु नाश आगेत. <verse eid="2PE 3:6"/><verse number="7" style="v" sid="2PE 3:7"/>लेकीन ईद आकाश अदिक पृथ्वी ईंद अस्तित्व दा आद, आऊंदा आदेश इन द्वारा बेक्‍की देल नाश आगोर साटी सुरक्षित आद; इंदरी आ दिन इन साटी ईटकु आगेत्याद याग अन्यायी लॉकुर्द न्याय आदीन अदिक आंदुर नाश माळकु आदार.<verse eid="2PE 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8"/>हे प्रिय संगीगोळा, ईद ऊंद मात इक मारूबाळी कि प्रभु उन नजर दा ऊंद दिन अदिक ऊंद हजार साल दा येनु फरक हैलेच; आऊन साटी ईव येढ्ढु बराबर आव. <verse eid="2PE 3:8"/><verse number="9" style="v" sid="2PE 3:9"/>प्रभु तान प्रतिग्या अन बारा दा समय माळालुन, ह्यांग समय थ्वाळासा लॉकुर सम्सतार; लेकीन नीम्द बारा दा संयम हुडुतान, अदिक चाहासालुन कि यावारा नाश आगुल, बल्‍की ईद कि सप्पा मुंदरी मन फिराव इन मवका सिकुल.<verse eid="2PE 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">३:१० </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:43">मत्ती २४:४३</ref>; <ref loc="LUK 12:39">लूका १२:३९</ref>; <ref loc="1TH 5:2">१ थिस्सलुनीकि ५:२</ref>; <ref loc="REV 16:15">प्रकाशितवाक्य १६:१५</ref></char>
    </note>लेकीन प्रभु उन दिन काळ्ल उन घाई होट बंदीत, आ दिशी आकाश हापाळ गर्जना अन सांगुळ अदृश्य आगेदीत, अदिक आकाश इन पुरा चिजगोळ होतकु नाश आगेदव अदिक पृथ्वी अदिक अदुर दाकळव सप्पा मातगोळ गायब आगेदव. <verse eid="2PE 3:10"/><verse number="11" style="v" sid="2PE 3:11"/>जब कि ईव सप्पा वस्तुगोळ ई रीति देल नाश आगावाळा आव, रा नीमी याता प्रकार इन लॉकुर आग पायजे? नीम्द जीवन पवित्र अदिक परमेश्वर उन दी समर्पित आगली पायजे, <verse eid="2PE 3:11"/><verse number="12" style="v" sid="2PE 3:12"/>अदिक परमेश्वर उन आ दिशी इन हादी याता रीति देल काय पायजे अदिक आऊन जल्दी बरोद साटी ह्यांग कोशिश माळ पायजे, यदुर कारण आकाश बेक्‍की देल नाश माळकु आदीत, अदिक आकाश इन पुरा वस्तुगोळ गरमी देल पिघलुसेव. <verse eid="2PE 3:12"/><verse number="13" style="v" sid="2PE 3:13"/><note caller="+" style="x"><char style="xo" closed="false">३:१३ </char><char style="xt" closed="false"><ref loc="REV 21:1">प्रकाशितवाक्य २१:१</ref></char></note>लेकीन आऊन वादा अन अनुसार नाव ऊंद व्हाशोद आकाश अदिक व्हाशोद पृथ्वी इन आस नोळतेव यदुर दा न्याय वास माळीत.<verse eid="2PE 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14"/>इदुरसाटी, हे प्रिय संगीगोळा, ह्यांग नीव आ दिन इन हादी कायेतीर, रा तान दी टु पुरा कोशिश माळी कि नीव शांती देल परमेश्वर उन नजर दा आलोचना रहित अदिक निष्कलंक ठहरूसी, <verse eid="2PE 3:14"/><verse number="15" style="v" sid="2PE 3:15"/>नाम्द प्रभु उन धीरज इक जो आव नामी कोटान उद्धार इन संधी सम्सी, ह्यांग नाम प्रिय संगी पौलुस भी आ ग्यान देल जो परमेश्वर वार्ट उक कोटीदुन अदुर्द इस्तेमाल माळकु लिख्सदुन. <verse eid="2PE 3:15"/><verse number="16" style="v" sid="2PE 3:16"/>हांग अच आव तान सप्पा चिट्ठी गोळ दा भी ईव मातगोळ इक लिख्सदुन, यारदा येनारा मातगोळ हिंग आव यवरी समसोद कठिन आद, अदिक अनपढ़ अदिक चंचल लॉकुर अदुर अर्थगोळी इक भी शास्त्र अन अन्य मातगोळ घाई जेडुकु तांद अच नाश इन कारण माळतार.<verse eid="2PE 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 3:17"/>इदुरसाटी हे प्रिय संगीगोळा, नीव लॉकुर पयला टु उच ईव मातगोळी जान्सकु सावधान ईरी, ताकी न्यायविरूद्ध लॉकुर्द गलतीगोळ्द द्वारा तान स्थिरता अक येल्यारा कय देल काळुकोमी. <verse eid="2PE 3:17"/><verse number="18" style="v" sid="2PE 3:18"/>लेकीन नामव प्रभु अदिक उद्धारकर्ता यीशु मसीह अन अनुग्रह अदिक ग्यान दा वाळुसतेला होगी. आऊन दा प्रशंसा सही मायना दा आगुल, अदिक हमेशा आगतेला ईरूल. आमीन.<verse eid="2PE 3:18"/></para>
  <chapter eid="2PE 3"/>
</usx>
