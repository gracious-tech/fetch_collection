<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1PE" style="id">- Holiya</book>
  <para style="h">१ पतरस</para>
  <para style="toc3">१ पतरस</para>
  <para style="toc2">१ पतरस</para>
  <para style="toc1">पतरस उन पयला चिट्ठी</para>
  <para style="mt2">पतरस की पहली पत्री</para>
  <para style="mt1">पतरस उन पयला चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">१ पतरस उन चिट्ठी प्रेरित पतरस उन द्वारा लिख्सकु आगीत. पतरस ईद अंदकु तान चिट्ठी इन सुरूवात माळदुन कि आव याव ईरोन अदिक यार साटी आव लिखसोन. आव आ सप्पा इसाईगोळी चिट्ठी संबोधित माळदुन यारी आव “अजनबीगोळ” <char style="xt"><ref loc="1PE 1:1">१:१</ref>; <ref loc="1PE 1:17">१:१७</ref></char> <char style="xt"><ref loc="1PE 2:11">२:११</ref></char> अंदुन. अदिक आव तान पाठकगोळी ईत्‍ता प्रकार देल हापाळ अनली संदर्भित माळदुन यतिकी आंदुर ब्यार्र-ब्यार्र द्याशगोळ दा बगरूसेगीदुर. यतिकी ईद चिट्ठी थ्वाळासा तरीका देल इफिसीगोळी पौलुस उन चिट्ठी घाई कांळ्सतद, हापाळ लॉकुर मान्सतार कि मसीह अन जनम इन ६५ साल इन बाद्दा इफिसीगोळी पयला पतरस लिख्सकु आगीत. पतरस रोम नगर टु ईद चिट्ठी लिखसीदुन यदरी बेबीलोन अनतार <char style="xt"><ref loc="1PE 5:13">५:१३</ref></char>.</para>
  <para style="ip">पतरस अनतान कि ई चिट्ठी इक “नीमी प्रोत्साहित माळली अदिक ईद प्रमाणित माळोद उद्देश देल लिख्सीन कि ईद परमेश्वर उन खरा कृपा हुन” <char style="xt"><ref loc="1PE 5:12">५:१२</ref></char>. <char style="xt"><ref loc="1PE 2:11-3:7">१ पतरस २:११–३:७</ref></char>, <char style="xt"><ref loc="EPH 5:18-6:9">इफिसिगोळ ५:१८–६:९</ref></char> अदिक <char style="xt"><ref loc="COL 3:18-4:6">कुलुस्सिगोळ ३:१८–४:६</ref></char> अन्द न्याड्या दा हापाळ समानता आव. ई मुरू किताबगोळ दा पारिवारिक रिश्तागोळ अदिक अधिकारगोळ्द पालन माळोद बारा दा निर्देश सिकतद. अद दुखी लॉकुरी दुखी आगदुर मा मजबूती देल प्रोत्साहित माळतद यतिकी अन्त हात्‍ती आद. <char style="xt"><ref loc="1PE 4:1">४:१</ref></char></para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. पतरस खुद इक पेश माळतान अदिक तान पाठकगोळी संबोधित माळतान. <char style="ior"><ref loc="1PE 1:1-2">१:१-२</ref></char></para>
  <para style="io1">२. बाक आव छुटकारा साटी परमेश्वर उन धन्यवाद माळतान कि आंदुर सप्पा मुंदुर साझा माळतार अदिक ईदुर मतलब आंदुर जीवन इन साटी येन आद <char style="ior"><ref loc="1PE 1:3-2:10">१:३–२:१०</ref></char></para>
  <para style="io1">३. आव विश्वासीगोळी निर्देश कोळतान कि ह्यांग दुनिया दा वळ्लीद रीति देल ईरोद आद अदिक गांड्ड अदिक हिंग्स अदिक दास अदिक गुरु उन न्याड्या दा अलग रिश्तागोळी संबोधित माळोद हुन. <char style="ior"><ref loc="1PE 2:11-4:11">२:११–४:११</ref></char></para>
  <para style="io1">४. पतरस दुखी लॉकुरी मजबूती देल प्रोत्साहित माळतान अदिक तान चिट्ठी बंद माळतान. <char style="ior"><ref loc="1PE 4:12-5:11">४:१२–५:११</ref></char></para>
  <para style="io1">५. आग आव तान चिट्ठी लिखसोद बंद माळतान. <char style="ior"><ref loc="1PE 5:12-14">५:१२-१४</ref> </char></para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1" />पतरस उन दी टु जो यीशु मसीह अन प्रेरित आन,</para>
  <para style="p" vid="1PE 1:1">आ निवळुस्कु आदुर परमेश्वर उन लॉकुर्द हेसुर जो तितर बितर आगकु पुन्तुस, गलातिया, कप्पदूकिया, आसिया अदिक बितूनिया दा ईरतार,<verse eid="1PE 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1PE 1:2" />नीव परमेश्वर आप्प उन पूर्व उद्देश इन अनुसार निवळुस्कु आगीर अदिक आऊन आत्मा अन्द क्याल्सा द्वारा पवित्र लॉकुर ठहरूस्कु आगीर, इदुरसाटी कि यीशु मसीह अन आग्या मानसुल अदिक आऊन रक्ता अन द्वारा शुद्ध आगेगुल. नीमी अनुग्रह अदिक शांती बहुतायत देल सिकतेला ईरूल.<verse eid="1PE 1:2" /></para>
  <para style="s">ऊंद जित्‍ता आशा</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3" />नाम प्रभु यीशु मसीह अन परमेश्वर अदिक आप्प उन धन्यवाद आगुल, याव यीशु मसीह अन सोत्‍तुर दा टु जित्‍ता आगोर द्वारा, तान हापाळ प्यार देल नामी जित्‍ता आशा कोळोर साटी व्हाशोद जनम कोट्टुन, <verse eid="1PE 1:3" /><verse number="4" style="v" sid="1PE 1:4" />मतलब ऊंद अविनाशी, अदिक निर्मल, अदिक अजर विरासत इन साटी जो नीम साटी स्वर्ग दा ईटकु आद; <verse eid="1PE 1:4" /><verse number="5" style="v" sid="1PE 1:5" />जो विश्वास इन द्वारा सुरक्षित आर, परमेश्वर उन सामर्थ्य अन द्वारा आ उद्धार इन साटी जो आखरी समय दा प्रगट आगोर साटी तयार आद.<verse eid="1PE 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 1:6" />ई कारण नीव हापाळ खुश ईरी, लेकीन येनारा थ्वाळासा समय इन साटी अलग अलग परीक्षागोळ दा बिदकु दुख नेगोद बिद्दीत; <verse eid="1PE 1:6" /><verse number="7" style="v" sid="1PE 1:7" />अदिक ईद इदुरसाटी आद कि नीम्द विश्वास परखुसकु आगुल, शुद्ध होळी अदिक स्थिर ईरी, जो नाशवान व्हान्ना आद यदरी बेक्‍की दा परखुस्कु आगतद अदुर देल भी हापाळ यक्कुल बार्र आद, आ दिन याग यीशु मसीह प्रगट आदान आग नीमी प्रशंसा अदिक महिमा अदिक आदर प्राप्त आदीत. <verse eid="1PE 1:7" /><verse number="8" style="v" sid="1PE 1:8" />नीव आऊन से प्यार माळतीर जब कि नीव आऊक नोळीदील, अदिक नीव आऊन मा विश्वास माळतीर जब कि नीव आऊक ईगल्या नोळीदील. रा नीव हापाळ महिमामय खुशी देल खुश आईर जो शब्दगोळ देल बयान माळकु आगसकाल; <verse eid="1PE 1:8" /><verse number="9" style="v" sid="1PE 1:9" />नीम्द आत्मागोळ उद्धार ईद जो नीम्द विश्वास इन उद्देश नीव अदुर्दा प्राप्त माळतीर.<verse eid="1PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10" />ईदा उद्धार इन बारा दा आ भविष्यवक्तागोळ ध्यान देल खोजबीन अदिक जाँच पळताल माळदुर, यार आ अनुग्रह अन बारा दा जो नीम मा आगली ईरोद, भविष्यवाणी माळीदुर. <verse eid="1PE 1:10" /><verse number="11" style="v" sid="1PE 1:11" />आ भविष्यवक्तागोळ मसीह मा बरावाळा दुखगोळ्द समय अदिक अद महिमा जो ई दुखगोळ्द बाद्दा प्रगट आदव इदुर्द खोज मसीह अन्द आत्मा अन द्वारा माळदुन जो आंदुर दा ईरोद. <verse eid="1PE 1:11" /><verse number="12" style="v" sid="1PE 1:12" />परमेश्वर आ भविष्यवक्तागोळ मा प्रगट माळदुन कि आंदुर तान ईला बल्‍की नीम्द स्यावा अन साटी ईव मातगोळ अनतोगोर, यार्द जानकारी ईग नीमी आंदुर्द द्वारा सिक्त यार पवित्र आत्मा अन द्वारा, जो स्वर्ग टु कळुकु आग्याद, नीमी खुशखबरी केळ्सदुन; अदिक ई मातगोळ इक स्वर्गदूत भी ध्यान देल नोळोद लालसा ईटतार.<verse eid="1PE 1:12" /></para>
  <para style="s">पवित्र जीवन जगुसोद बुलाहट</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13" />ई कारण तान तान नेळु कटकु सावधान ईरी, खुद नियंत्रित ईरी, याग यीशु मसीह प्रगट आदान आग जो आशीष नीमी सिकोद आद, अदुर मा तान आशा पुरा रीति देल हचकु ईटी. <verse eid="1PE 1:13" /><verse number="14" style="v" sid="1PE 1:14" />आग्या मानसावाळेर चिकोरगोळ घाई, आ समय इन बेकार इच्छागोळ्द अनुसार तान तान इक ढाल्सबाळी जो नीम दा पयले ईरोद, याग नीव अग्यानी ईरीर. <verse eid="1PE 1:14" /><verse number="15" style="v" sid="1PE 1:15" />लेकीन ह्यांग नीम कारावाळा पवित्र आन, हांग अच नीव भी तान सप्पा चाल चलन दा पवित्र बन्सी. <verse eid="1PE 1:15" /><verse number="16" style="v" sid="1PE 1:16" />यतिकी शास्त्र दा लिख्सकु आद, “पवित्र बन्सी, यतिकी ना पवित्र आईन.”<verse eid="1PE 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 1:17" />अदिक याग कि नीव “हे आप्प” अनकु आऊन से प्रार्थना माळतीर, जो बिना पक्षपात हर ऊंद उन क्याल्सा अन आचरण इन अनुसार न्याय माळतान, इदुरसाटी तान परदेशी आगोद समय अंज्क देल बितुसी. <verse eid="1PE 1:17" /><verse number="18" style="v" sid="1PE 1:18" />यतिकी नीव जान्सतीर कि नीम्द निकम्मा चाल चलन तरीका जो आप्प दादागोळ हाती टु नळुतेला बरेत्याद, अदुर देल नीम्द छुटकारा व्हान्ना बेळ्ली मतलब नाशवान चिजगोळ द्वारा आगीदील; <verse eid="1PE 1:18" /><verse number="19" style="v" sid="1PE 1:19" />बल्‍की किमती मसीह अन्द अर्पण इन द्वारा जो ऊंद निर्दोष अदिक कलंक रहित म्यांडा अन पाड्डा अन रक्ता अन घाई ईरोन. <verse eid="1PE 1:19" /><verse number="20" style="v" sid="1PE 1:20" />दुनिया अन निर्माण इन पयले परमेश्वर उन द्वारा मसीह अक चुनुस्कु आगीत, लेकीन नीम साटी ईव आखरी दिनगोळ दा आऊक प्रगट माळकु आत. <verse eid="1PE 1:20" /><verse number="21" style="v" sid="1PE 1:21" />आ मसीह अन द्वारा नीव आ परमेश्वर मा विश्वास माळतीर, यारी परमेश्वर आऊक सोत्‍तुर दा टु जित्‍ता माळदुन अदिक महिमा कोट्टुन ताकी नीम्द विश्वास अदिक आशा परमेश्वर मा पक्‍का आगुल.<verse eid="1PE 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22" />ईग याग नीव सच्चाई इन पालन माळतेला खरा भाईचारा अन प्यार इक प्रदर्शित माळोर साटी तान आत्मागोळ इक शुद्ध माळ कोंडीर, रा पुरा मन इन सांगुळ आबुर दाबुर से प्यार माळी. <verse eid="1PE 1:22" /><verse number="23" style="v" sid="1PE 1:23" />यतिकी नीमी नाशवान ईला लेकीन अविनाशी बींजा देल, परमेश्वर उन जित्‍ता अदिक हमेशा ठहरूसावाळा वचन इन द्वारा व्हाशोद जनम सिक्याद. <verse eid="1PE 1:23" /><verse number="24" style="v" sid="1PE 1:24" />यतिकी पवित्रशास्त्र दा लिख्सकु आद:</para>
  <para style="q1" vid="1PE 1:24">“हर ऊंद मंळसा प्राणी काड्डा अन घाई आन,</para>
  <para style="q2" vid="1PE 1:24">अदिक आऊंद सप्पा शोभा आळी दाकळोद फूला अन घाई आव.</para>
  <para style="q1" vid="1PE 1:24">अदिक काड्डा वंळ्गेगतद, अदिक फूला झळसेगताव,<verse eid="1PE 1:24" /></para>
  <para style="q2">
    <verse number="25" style="v" sid="1PE 1:25" />लेकीन प्रभु उन वचन हमेशा हमेशा संची ईरतद.”</para>
  <para style="m" vid="1PE 1:25">अदिक ईदा खुशखबरी इन वचन आद जो नीमी घोषित माळकु आगीत.<verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="s">जित्‍ता कल्ल अदिक पवित्र प्रजा</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />इदुरसाटी सप्पा प्रकार इन बुराईगोळ अदिक पाखंड अदिक पुरा ख्वाटा मातगोळ या होत्‍तोद या अपमानीत माळोर भाषा देल तान तान इक ऊळस्कु ईटी. <verse eid="1PE 2:1" /><verse number="2" style="v" sid="1PE 2:2" />व्हासा पैदा आगा चिकोर इन घाई हमेशा निर्मल आत्मिक हाल इन लालच ईटी, इदुरसाटी इदरी कुडोद द्वारा नीम्द विकास अदिक उद्धार आगुल. <verse eid="1PE 2:2" /><verse number="3" style="v" sid="1PE 2:3" />जसा कि पवित्रशास्त्र दा लिख्सकु आद, “नीव तान तान इन साटी जान्स कोंडीर कि प्रभु याट भला आन.”<verse eid="1PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 2:4" />प्रभु उन हात्‍ती बरी, अद सजीव कल्ल जो लॉकुर द्वारा बेकार सम्सकु नकार्सकु आगीदुन लेकीन आव परमेश्वर साटी किमती आन जो परमेश्वर उन द्वारा निवळुस्कु आगीदुन. <verse eid="1PE 2:4" /><verse number="5" style="v" sid="1PE 2:5" />नीव भी खुद जित्‍ता कल्लगोळ घाई ऊंद आध्यात्मिक मंदिर इन रूप दा माळकु आगेतीर, ताकी ऊंद हिंग पवित्र याजक मंडल इन रूप दा स्यावा माळ सकी यदुर्द कर्तव्य हिंग आत्मिक बलिदान समर्पित माळोद आद जो यीशु मसीह अन द्वारा परमेश्वर उक ग्रहण लायक आगुल. <verse eid="1PE 2:5" /><verse number="6" style="v" sid="1PE 2:6" />ईद कारण पवित्रशास्त्र दा भी लिख्सकु आद:</para>
  <para style="q1" vid="1PE 2:6">“ना ऊंद किमती कल्ल निवळुस्कु</para>
  <para style="q2" vid="1PE 2:6">यारी ना सिय्योन इन क्वाना अन्द कल्ल माळकु ईटेतीन:</para>
  <para style="q2" vid="1PE 2:6">अदिक जो यावारा आऊन मा विश्वास माळ्यान, आव यातोदारा रीति देल निराश आगतीदील.”<verse eid="1PE 2:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="1PE 2:7" />नीव विश्वासीगोळ साटी ईद कल्ल हापाळ किमती आद; लेकीन जो विश्वास माळालुर आंदुर साटी</para>
  <para style="q1" vid="1PE 2:7">“अद कल्ल यारी राजमिस्त्रीगोळ बेकार सम्सकु इनकार माळीदुर,</para>
  <para style="q2" vid="1PE 2:7">अदा कल्ल सप्पा मुंदुर साटी महत्वपुर्ण क्वाना अन कल्ल बनसेत,”<verse eid="1PE 2:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="1PE 2:8" />अदिक शास्त्र दा ईद भी लिख्सकु आद,</para>
  <para style="q1" vid="1PE 2:8">“ईद अद कल्ल हुन जो अपराधी लॉकुरी ठेस पहुचुसोद कारण बनसीत,</para>
  <para style="q2" vid="1PE 2:8">ईद चट्टान लॉकुरी ठोकर हचकु केळदित.” आंदुर ठोकर तिंदार यतिकी आंदुर परमेश्वर उन वचन मा विश्वास माळालुर</para>
  <para style="m" vid="1PE 2:8">अदिक ईदा आंदुर साटी परमेश्वर उन इच्छा ईरोद.<verse eid="1PE 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२:९ </char>
      <char style="xt" closed="false">
        <ref loc="TIT 2:14">तीतुस २:१४</ref>
      </char>
    </note>लेकीन नीव ऊंद निवळुस्कु वंश, राज-पदधारी याजकगोळ्द समाज, पवित्र जाती, अदिक परमेश्वर उन खुद इन लॉकुर आईर, इदुरसाटी कि याव नीमी अंधकार दा टु तान अदभुत ज्योति दा कार्सदुन, आऊन महान कार्य अन्द घोषणा माळी. <verse eid="1PE 2:9" /><verse number="10" style="v" sid="1PE 2:10" />ऊंद समय दा नीव परमेश्वर उन लॉकुर ईला ईरीर, लेकीन ईग नीव आऊन लॉकुर हुईर; ऊंद समय ईरोद याग नीम मा परमेश्वर उन दया ईला आगीत, लेकीन ईग नीम मा आऊन दया आग्याद.<verse eid="1PE 2:10" /></para>
  <para style="s">परमेश्वर उन दास</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11" />हे प्रिय संगीगोळा, ना नीम से, जो ई दुनिया दा अजनबीगोळ रूप दा आईर, निवेदन माळतीन कि आ शारीरिक इच्छागोळ देल दुर ईरी जो नीम्द आत्मा से लळुस्तेला ईरतद. <verse eid="1PE 2:11" /><verse number="12" style="v" sid="1PE 2:12" />दुसरा जातीगोळ न्याड्या तान चाल चलन हिंग वळ्लीद माळकु ईटी कि चाहे आंदुर अपराधीगोळ्द रूप दा नीम्द आलोचना माळ्यार लेकीन नीम्द वळ्लीद कर्मगोळ्द परिणाम स्वरूप आऊन बरव दिन आंदुर परमेश्वर उक महिमा प्रदान माळुल.<verse eid="1PE 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13" />प्रभु उन साटी तान तान इक हर मानव अधिकार इन हात्‍ती ईरी: राजा अन हात्‍ती इदुरसाटी कि आव सब मा शासन माळतान, <verse eid="1PE 2:13" /><verse number="14" style="v" sid="1PE 2:14" />अदिक शासकगोळ्द, यतिकी आंदुर बुरा लॉकुरी दण्ड कोळोद अदिक वळ्लेव लॉकुर्द प्रशंसा अन साटी आऊन द्वारा कळुकु आग्यार. <verse eid="1PE 2:14" /><verse number="15" style="v" sid="1PE 2:15" />यतिकी परमेश्वर उन नीम से ईद इच्छा आद कि नीव तान भलाई इन क्याल्सागोळ देल मूर्ख लॉकुर्द अग्यान देल तुमकु मातगोळ इक सुंगा माळबुळी. <verse eid="1PE 2:15" /><verse number="16" style="v" sid="1PE 2:16" />स्वतंत्र मंळसा अन घाई जीवन बीतुसी, लेकीन तान स्वतंत्रता अन्द इस्तेमाल बुरा मातगोळ इक होच्चोर साटी माळबाळी; लेकीन परमेश्वर उन सेवकगोळ्द घाई जित्‍ता ईरी. <verse eid="1PE 2:16" /><verse number="17" style="v" sid="1PE 2:17" />सप्पा मुंदुर्द आदर माळी, तान दुसरा विश्वासी वार्टुर से प्यार ईटी, परमेश्वर उन आदर इन सांगुळ अंज्क मान्सी, राजा अन सम्मान माळी.<verse eid="1PE 2:17" /></para>
  <para style="s">मसीह अन्द तकलीफ इन उदाहरण</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18" />हे सेवकगोळा, तान तान इक तान स्वामीगोळ्द हात्‍ती ईटी, अदिक आंदरी पुरा रीति देल आदर कोळी, ना सिर्फ आंदरी जो वळ्लेर आर अदिक दुसरा अन भलाई माळतार बल्‍की आंदरी भी जो कठोर आर. <verse eid="1PE 2:18" /><verse number="19" style="v" sid="1PE 2:19" />यतिकी अगर यावारा परमेश्वर उन विचार माळकु अन्याय देल दुख नेगुतेला क्लेश सहन माळतान रा ईद वळ्लीद आद. <verse eid="1PE 2:19" /><verse number="20" style="v" sid="1PE 2:20" />यतिकी अगर नीव अपराध माळकु बुक्‍की तिंदीर अदिक धीरज हुळदीर, रा ईदुर दा येन बळाई इन मात आद? लेकीन अगर भलाई इन क्याल्सा माळकु दुख नेगुतीर अदिक धीरज हुडुतीर, रा ईद परमेश्वर उक भाऊसतद. <verse eid="1PE 2:20" /><verse number="21" style="v" sid="1PE 2:21" />लेकीन नीमी परमेश्वर इदुरसाटी कारदुन, यतिकी मसीह नीम साटी दुख नेगदुन अदिक हिंग माळकु नाम्द साटी ऊंद उदाहरण बिट्टुन ताकी नीव भी आऊन पद-चमत्कारगोळ मा नळु सकीर. <verse eid="1PE 2:21" /><verse number="22" style="v" sid="1PE 2:22" />आव येनु पापगोळ माळीदिल अदिक यावारा यागल्यारा भी आऊन बाय देल ख्वाटा मातगोळ केळीदील. <verse eid="1PE 2:22" /><verse number="23" style="v" sid="1PE 2:23" />याग आव अपमानीत आदुन आग आव याऊकु अपमानीत माळकु प्रती उत्‍तर माळीदील, याग आव दुख झेल्सदुन आग आव यारूकु धमकी कोटीदील, बल्‍की आ खरा न्याय माळावाळा न्यायी परमेश्वर दा तान आशा अक ईटदुन. <verse eid="1PE 2:23" /><verse number="24" style="v" sid="1PE 2:24" />मसीह खुद अच नामव पापगोळ तान मय मा ताकोमकु क्रूस मा येरेदुन, ताकी नाव तान पापगोळ्द प्रती नाम मृत्यु आगेगुल अदिक न्यायीपन इन साटी जीवन बितुसेव: ईद आऊन आ बलिदान इन कारण अच आत यऊर देल नीव चंगा माळकु आगीर. <verse eid="1PE 2:24" /><verse number="25" style="v" sid="1PE 2:25" />यतिकी नीव पयले भटकुसकु म्यांडा अन घाई ईरीर, लेकीन ईग तान जीवगोळ रखवाला अदिक अध्यक्ष अन हात्‍ती बंदीर.<verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="s">गांड्ड अदिक हिंग्स</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">३:१ </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:22">इफिसिगोळ ५:२२</ref>; <ref loc="COL 3:18">कुलुस्सिगोळ ३:१८</ref></char>
    </note>ईदा रीति देल हे हिंग्सुरा, नीव भी तान गांड्ड उन हात्‍ती ईरी, ताकी याव परमेश्वर उन वचन मा विश्वास माळालुर रा तान चाल चलन देल अच नीव आऊक विश्वास देल जीत सकतीर. इदुरसाटी नीमी आऊन से मातचीत माळोद भी जरवत हैलेच. <verse eid="1PE 3:1" /><verse number="2" style="v" sid="1PE 3:2" />यतिकी आंदुर नोळ्यार नीम्द चाल चलन ह्यांग पवित्र अदिक भक्तिपुर्ण आद. <verse eid="1PE 3:2" /><verse number="3" style="v" sid="1PE 3:3" /><note caller="+" style="x"><char style="xo" closed="false">३:३ </char><char style="xt" closed="false"><ref loc="1TI 2:9">१ तीमुथियुस २:९</ref></char></note>तान तान इक सुंदर माळोर साटी व्हार्या अन साझ श्रृंगार इन इस्तेमाल माळबाळी, जसा कि चुट्टी गुथसोर साटी, या बाक व्हान्ना अन बांगळागोळ, या वळ्लेव-वळ्लेव कपळा हाक्‍कोर साटी, <verse eid="1PE 3:3" /><verse number="4" style="v" sid="1PE 3:4" />बल्‍की नीमी सुंदर नीम्द भितरी व्यक्तित्व माळतद, मुलायम मन अदिक शांत आत्मा अन्द अविनाशी सुंदरता देल युक्त आगी, परमेश्वर उन नजर दा जो किमती आईर. <verse eid="1PE 3:4" /><verse number="5" style="v" sid="1PE 3:5" />पूर्वकाल दा भक्ति माळावाळेर आर्तेर भी, जो परमेश्वर मा पवित्र आशा ईटतोगोर, तान तान इक ईदा रीति देल सवार्सतोगोर अदिक तान तान गांड्ड उन हात्‍ती ईरतोगोर. <verse eid="1PE 3:5" /><verse number="6" style="v" sid="1PE 3:6" />जसा सारा तान गांड्ड अब्राहम उन आग्या मान्सोर अदिक आऊक तान स्वामी अनतोगोर. ईदा प्रकार नीव भी अगर भलाई माळीर अदिक यातोदारा प्रकार इन अंज्क देल अंजतीदील, रा प्रभु पोरगोळ ठहरूसीर.<verse eid="1PE 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">३:७ </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:25">इफिसिगोळ ५:२५</ref>; <ref loc="COL 3:19">कुलुस्सिगोळ ३:१९</ref></char>
    </note>हांग अच हे गांड्ड उरा, नीव तान हिंग्सुर सांगुळ समझदारी देल ईरी, अदिक आंदरी कमजोर आर्त जान्सकु आंदुर्द आदर माळी, परमेश्वर उन जीवन इन वरदान दा आंदरी तान सह उत्‍तराधिकारी मान्सी, ताकी नीम्द प्रार्थनागोळ दा बाधा बिळबाळुल.<verse eid="1PE 3:7" /></para>
  <para style="s">भलाई माळोद कारण कष्ट</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />अन्त दा नीव सप्पा मुंदरी समान विचार, सहानुभुती, तान वार्टुरगोळ से प्यार माळावाळा, दयालु अदिक नम्र आगली पायजे. <verse eid="1PE 3:8" /><verse number="9" style="v" sid="1PE 3:9" />बुराई इन बदला बुराई माळबाळी अदिक श्राप इन बदला श्राप कोळबाळी; बल्‍की प्रत्युत्‍तर दा आशीष अच कोळी, यतिकी आशीष अच आद जो परमेश्वर नीमी कोळोद वचन कोटीदुन याग नीमी कार्सीदुन. <verse eid="1PE 3:9" /><verse number="10" style="v" sid="1PE 3:10" />जसा शास्त्र दा लिख्सकु आद,</para>
  <para style="q1" vid="1PE 3:10">“अगर आव जीवन इन प्यार ताकोमोद चाहासतान,</para>
  <para style="q2" vid="1PE 3:10">अदिक वळ्लेव दिन नोळोद चाहासतान,</para>
  <para style="q2" vid="1PE 3:10">आव तान ल्यालग्या अक बुरा मातगोळ देल, अदिक तान टुट्टीगोळ इक ख्वाटा माताळदुर देल</para>
  <para style="q2" vid="1PE 3:10">रोक्सकु ईटी इदुर्दा अच भलाई आद.<verse eid="1PE 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1PE 3:11" />आव बुराई इन सांगुळ बिळुल, अदिक भलाई इच माळुल;</para>
  <para style="q2" vid="1PE 3:11">आव पुरा मन देल शांती इन साटी प्रयास माळुल.<verse eid="1PE 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1PE 3:12" />यतिकी प्रभु उन कण्णगोळ न्याय मा हतकु ईरताव,</para>
  <para style="q2" vid="1PE 3:12">अदिक आऊन किव आंदुर्द विनती दा हतकु ईरताव;</para>
  <para style="q2" vid="1PE 3:12">लेकीन प्रभु बुराई माळावाळेर्द विंमुख ईरतान.”<verse eid="1PE 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13" />अगर नीव भलाई माळोर साटी तयार ईत्‍तीर रा नीम्द बुराई माळावाळा बाक याव आन? <verse eid="1PE 3:13" /><verse number="14" style="v" sid="1PE 3:14" /><note caller="+" style="x"><char style="xo" closed="false">३:१४ </char><char style="xt" closed="false"><ref loc="MAT 5:10">मत्ती ५:१०</ref></char></note>अगर नीव सच्चाई इन कारण दुख भी नेगदीर, रा धन्य आईर; लेकीन लॉकुर्द अंजुसदुर देल अंजबाळी, अदिक घबरूसबाळी, <verse eid="1PE 3:14" /><verse number="15" style="v" sid="1PE 3:15" />लेकीन तान मन दा मसीह अन साटी सम्मान ईटी, आऊक प्रभु जान्सकु आदर कोळी. अदिक अगर यावारा नीम इक नीम्द शुद्ध आशा अन बारा दा जो नीम दा आद समझुस्ली अनुल; रा आऊक उत्‍तर कोळोर साटी हमेशा तयार ईरी. <verse eid="1PE 3:15" /><verse number="16" style="v" sid="1PE 3:16" />लेकीन ईद विनम्रता अदिक भलाई इन सांगुळ अच माळी. अदिक तान विवेक इक भी शुद्ध ईटी, ताकी यीशु मसीह दा नीम्द वळ्लीद चाल चलन देल नीम सम्मान आगुल अदिक निंदा माळावाळेर लॉकुर नीम्द अपमान माळाहोती लज्जित आगुल. <verse eid="1PE 3:16" /><verse number="17" style="v" sid="1PE 3:17" />यतिकी अगर परमेश्वर उन ईदा इच्छा आद कि नीव भलाई माळोद कारण दुख नेगी, रा बुराई माळोद बदला दुख नेगोद वळ्लीद आद. <verse eid="1PE 3:17" /><verse number="18" style="v" sid="1PE 3:18" />इदुरसाटी मसीह भी पुरा पापगोळ न्याय माळोर साटी ऊंद अच घन सोत्‍तुन, मतलब आव जो निर्दोष ईरोन नाव पापीगोळ साटी सोतोदुन कि नामी परमेश्वर उन हाती ओयुल. मय इन भाव देल रा आव कोंदकु आदुन, लेकीन आत्मा अन भाव देल जित्‍ता माळकु आदुन. <verse eid="1PE 3:18" /><verse number="19" style="v" sid="1PE 3:19" />अदिक आऊन आत्मा अन्द स्थिती दा अच आव होगकु आ कैदी आत्मागोळ इक प्रचार माळदुन, <verse eid="1PE 3:19" /><verse number="20" style="v" sid="1PE 3:20" />ईव अव आत्मागोळ हुव जो आ समय परमेश्वर उन आग्यागोळ मा विश्वास ईला माळतोगोर याग नूह अन्द ड्वांगा माळकु आगोद अदिक परमेश्वर धीरज इन सांगुळ हादी कायोन आग आ ड्वांगा दा थ्वाळासा मतलब सिर्फ येठ्ठ मंळसागोळ अच नीर दा टु ऊळदीदुर. <verse eid="1PE 3:20" /><verse number="21" style="v" sid="1PE 3:21" />ईद नीर आ बपतिस्मा अन्द घाई आद यदुर देल नीम्द भलाई आगतद इदुर दा मय इन मईल तोळोद ईला बल्‍की ऊंद शुद्ध विवेक इन साटी परमेश्वर से विनती आद ईग रा बपतिस्मा नीमी यीशु मसीह अन्द पुनरूत्थान इन द्वारा ऊळस्तद. <verse eid="1PE 3:21" /><verse number="22" style="v" sid="1PE 3:22" />आव स्वर्ग मा होगकु परमेश्वर उन ऊमा कय दी कुरतोदुन; अदिक स्वर्गदूत अदिक स्वर्गीय अधिकारी अदिक सामर्थ्य आऊन हात्‍ती माळकु आदुर.<verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="s">परिवर्तित जीवन</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />इदुरसाटी याग कि मसीह मय दा आगकु दुख नेगदुन रा नीव भी अदा मनसा अक हथियार इन घाई धारण माळी, यतिकी याव मय दा दुख नेगदुन आव पापगोळ देल बिटोदुन, <verse eid="1PE 4:1" /><verse number="2" style="v" sid="1PE 4:2" />ईग टु मुंद नीम्द वाचुस्त समय पृथ्वी इन जीवन मानवीय इच्छागोळ्द अनुसार ईला बल्‍की परमेश्वर उन इच्छा अन अनुसार जीवन व्यतीत माळुल. <verse eid="1PE 4:2" /><verse number="3" style="v" sid="1PE 4:3" />यतिकी मूर्ति पुजा माळावाळेर्द इच्छा अन्द अनुसार क्याल्सा माळोद, अदिक असभ्यता, वासना, पियक्‍कळपन अवैध संबंध, रंगरेली, अदिक बेकार मूर्तिपूजा दा यल ताका नाव पयले समय गऊसदेव, अदा हापाळ आत. <verse eid="1PE 4:3" /><verse number="4" style="v" sid="1PE 4:4" />इदुर देल आंदुर अचम्भा माळतार कि नीव हिंग बोयोद जंगलीपन अदिक लापरवाह अन्द जीवन जगुसोर दा आंदुर साथ कोळालीर, अदिक इदुरसाटी आंदुर नीम्द अपमान माळतार; <verse eid="1PE 4:4" /><verse number="5" style="v" sid="1PE 4:5" />लेकीन जो सोतकु आर अदिक जित्‍तागोळ्द न्याय माळोर साटी तयार आन आ परमेश्वर उक नामी तान व्यवहार इन लेखा जोखा कोळोद बिद्दीत. <verse eid="1PE 4:5" /><verse number="6" style="v" sid="1PE 4:6" />इदुरसाटी आ विश्वासीगोळ इक जो सोतोग्यार खुशखबरी इन उपदेश कोटकु आगीत कि शारीरिक रूप देल चाहे आंदुर्द न्याय मानवीय स्थल मा आगुल लेकीन आत्मिक रूप देल आंदुर परमेश्वर उन अनुसार जित्‍ता ईरूल.<verse eid="1PE 4:6" /></para>
  <para style="s">परमेश्वर उन वळ्लेर भंडारी</para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7" />सप्पा मातगोळ्द अन्त तुरन्त आगावाळा आद; इदुरसाटी संयमी आगकु प्रार्थना माळोर साटी सचेत ईरी. <verse eid="1PE 4:7" /><verse number="8" style="v" sid="1PE 4:8" />सब से धोळ मात ईद आद कि आबुर दाबुर से प्यार ईटी, यतिकी प्यार अनेक पापगोळ इक मुच्च बुळतद. <verse eid="1PE 4:8" /><verse number="9" style="v" sid="1PE 4:9" />बिना कुळकुळ्सकु आबुर दाबुर अतिथी-सत्कार माळी. <verse eid="1PE 4:9" /><verse number="10" style="v" sid="1PE 4:10" />यारी जो वरदान सिक्याद, आव अदरी परमेश्वर उन अलग-अलग प्रकार इन अनुग्रह अन भला भंडारीगोळ घाई आबुर दाबुर स्यावा दा हची. <verse eid="1PE 4:10" /><verse number="11" style="v" sid="1PE 4:11" />जो यावारा प्रचार माळुल, आव परमेश्वर उन वचन इन प्रचार माळुल; जो यावारा स्यावा माळुल, रा आ शक्ति इन सांगुळ माळुल जो परमेश्वर कोळतान; इदुरसाटी ई सप्पा मातगोळ दा यीशु मसीह अन द्वारा, परमेश्वर उन स्तुति आगुल. महिमा अदिक साम्राज्य हमेशा हमेशा आऊन आद. आमीन.<verse eid="1PE 4:11" /></para>
  <para style="s">मसीह आगोद नाता देल दुख नेगोद</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />हे प्रिय संगीगोळा, याग नीम्द अग्नि परीक्षा आगतद आग हिंग असामान्य मातगोळ आगतेला नोळकु नीव आश्चर्य चकित आगबाळी. <verse eid="1PE 4:12" /><verse number="13" style="v" sid="1PE 4:13" />लेकीन ह्यांग-ह्यांग मसीह अन दुख दा सहभागी आगतीर, खुश ईरी, यदुर देल याग आऊन महिमा प्रगट आदीत आ घन भी नीव पुरा रीति देल आनन्दित आगेगी. <verse eid="1PE 4:13" /><verse number="14" style="v" sid="1PE 4:14" />बाक अगर मसीह अन हेसुर इन साटी नीव अपमानीत आगतीर रा नीव धन्य माळी, यतिकी आव महिमामय परमेश्वर उन आत्मा नीम मा आगतद. <verse eid="1PE 4:14" /><verse number="15" style="v" sid="1PE 4:15" />नीम दा टु यावारा मंळसा हत्यारा या काळ्ल या कुकर्मी आगदुर मा, या पराया क्याल्सा दा कय हाका कारण दुख ईला सिकुल. <verse eid="1PE 4:15" /><verse number="16" style="v" sid="1PE 4:16" />लेकीन ई मात साटी परमेश्वर उन धन्यवाद माळी, यतिकी नीव मसीह हेसुर ग्रहण माळदीर.<verse eid="1PE 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 4:17" />यतिकी न्याय माळोद समय इन सुरूवात आगेग्याद कि पयले परमेश्वर उन लॉकुर्द न्याय माळकु आगुल; अदिक याग कि न्याय इन सुरूवात नाम देल अच आदीत रा आंदुर्द येन अन्त आदीत जो परमेश्वर उन खुशखबरी मा विश्वास माळालुर? <verse eid="1PE 4:17" /><verse number="18" style="v" sid="1PE 4:18" />हिंग शास्त्र दा लिख्सकु आद,</para>
  <para style="q1" vid="1PE 4:18">“अगर वळ्लेव न्याय माळावाळा मंळसा अक अच कठिनाई देल उद्धार सिक्‍कीत,</para>
  <para style="q2" vid="1PE 4:18">रा भक्तिहीन बयमान अदिक पापी इन येन आदीत?”<verse eid="1PE 4:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="1PE 4:19" />इदुरसाटी जो परमेश्वर उन इच्छा अन अनुसार दुख नेगुतार, आंदुर भलाई माळतेला तान-तान जीव विश्वासलायक सृजनहार इन कय दा सौप्स बुळुल.<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="s">स्याणागोळी अदिक नवयुवकगोळी बातणी</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />नीम दा जो स्याणा आन, ना आंदुर घाई स्याणा अदिक मसीह अन दुखगोळ्द गवाह अदिक प्रगट आगावाळा महिमा दा सहभागी आगकु आंदरी ईद समझुसतीन. <verse eid="1PE 5:1" /><verse number="2" style="v" sid="1PE 5:2" /><note caller="+" style="x"><char style="xo" closed="false">५:२ </char><char style="xt" closed="false"><ref loc="JHN 21:15-17">यूहन्ना २१:१५-१७</ref></char></note>कि परमेश्वर उन आ झुण्ड इन, जो नीम्द न्याड्या दा आद रखवाली माळी; अदिक दबाव देल ईला लेकीन परमेश्वर उन इच्छा अन अनुसार खुशी देल, अदिक कमाई इन लालच साटी ईला लेकीन मन हचकु. <verse eid="1PE 5:2" /><verse number="3" style="v" sid="1PE 5:3" />जो लॉकुर नीम्द देखरेख इन साटी सौप्सकु आग्यार, नीव आंदुर मा अधिकार जतुसबाळी, बल्‍की झुण्ड इन साटी ऊंद आदर्श बन्सी. <verse eid="1PE 5:3" /><verse number="4" style="v" sid="1PE 5:4" />याग प्रधान रखवाला प्रगट आदान, रा नीमी महिमा अन मुकुट कोटकु आदीत यदुर्द चमक यागलु खतम आगाल.<verse eid="1PE 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5" />ईदा प्रकार हे नवयुवकगोळा, नीव भी तान स्याणागोळ्द हात्‍ती ईरी, अदिक नीव सप्पा च्या सप्पा आबुर दाबुर स्यावा माळोर साटी विनम्रता धारण माळी, यतिकी शास्त्र दा लिख्सकु आद, “परमेश्वर अभिमानीगोळ्द विरोध माळतान, लेकीन नम्र लॉकुर मा अनुग्रह माळतान.”<verse eid="1PE 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 5:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">५:६ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 23:12">मत्ती २३:१२</ref>; <ref loc="LUK 14:11">लूका १४:११</ref>; <ref loc="LUK 18:14">१८:१४</ref></char>
    </note>इदुरसाटी परमेश्वर उन बलवन्त कय इन ल्यालमा दीनता देल ईरी, यदुर देल आव नीमी उचित समय मा वाळुसुल. <verse eid="1PE 5:6" /><verse number="7" style="v" sid="1PE 5:7" />तान सप्पा चिन्ता आऊन मा हाक बुळी, यतिकी आऊक नीम्द ध्यान आद.<verse eid="1PE 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8" />सचेत आगी, अदिक जाग्सतेला ईरी; यतिकी नीम्द दुश्मन शैतान गरजुसतेला हुल्ल इन घाई ईल अल ओयाळतेला ई ताक दा ईरतान कि यारीक हरकु तिनुल. <verse eid="1PE 5:8" /><verse number="9" style="v" sid="1PE 5:9" />विश्वास दा मजबूत आगकु, अदिक ईद जान्सकु आऊन सामना माळी कि नीम वार्टुर जो दुनिया दा आर हिंग अच दुख झेलसेत्यार. <verse eid="1PE 5:9" /><verse number="10" style="v" sid="1PE 5:10" />ईग परमेश्वर जो सप्पा अनुग्रह अन दाता आन, याव नीमी मसीह दा तान अनन्त महिमा अन साटी कारदुन, नीम्द थ्वाळासा समय ताका दुख नेगदुर बाद्दा खुद अच नीमी सिद्ध अदिक संची अदिक बलवन्त माळ्यान. <verse eid="1PE 5:10" /><verse number="11" style="v" sid="1PE 5:11" />आऊंदा साम्राज्य हमेशा हमेशा ईरूल. आमीन.<verse eid="1PE 5:11" /></para>
  <para style="s">आखरी अभिवादन</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">५:१२ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 15:22">प्रेरितगोळ १५:२२</ref>,<ref loc="ACT 15:40">४०</ref></char>
    </note>ना नीमी ऊंद संक्षिप्त चिट्ठी सिलवानुस उन सहयोग देल लिख्सदीन, यारी ना विश्वासलायक मसीह वार्ट मान्सतीन. ना नीमी प्रोत्साहित माळोद चाहसतीन अदिक नांद गवाही कोळतीन जो परमेश्वर उन सही अनुग्रह हुन, ईदुर दा संची ईरी.<verse eid="1PE 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">५:१३ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 12:12">प्रेरितगोळ १२:१२</ref>,<ref loc="ACT 12:25">२५</ref>; <ref loc="ACT 13:13">१३:१३</ref>; <ref loc="ACT 15:37-39">१५:३७-३९</ref>; <ref loc="COL 4:10">कुलुस्सिगोळ ४:१०</ref>; <ref loc="PHM 1:24">फिलेमोन १:२४</ref></char>
    </note>जो बेबीलोन दा नीम्द घाई निवळुस्द मंडली इन लॉकुर, आंदुर नीमी नमस्कार अनतार अदिक मसीह दा नान पार मरकुस उन भी नीमी नमस्कार. <verse eid="1PE 5:13" /><verse number="14" style="v" sid="1PE 5:14" />मसीह दा प्यार पुर्ण भाव देल आबुर दाबुर इक कुतक्या हुडुकु नमस्कार माळी.</para>
  <para style="p" vid="1PE 5:14">नीमी सप्पा मुंदरी, जो मसीह दा आईर, शांती सिकतेला ईरूल.<verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>