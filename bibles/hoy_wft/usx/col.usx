<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="COL" style="id">- Holiya</book>
  <para style="h">कुलुस्सिगोळ</para>
  <para style="toc3">कुलुस्सिगोळ</para>
  <para style="toc2">कुलुस्सिगोळ</para>
  <para style="toc1">कुलुस्सिगोळ हेसुर पौलुस प्रेरित उन चिट्ठी</para>
  <para style="mt2">कुलुस्सियों के नाम पौलुस प्रेरित की पत्री</para>
  <para style="mt1">कुलुस्सिगोळ हेसुर पौलुस प्रेरित उन चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">कुलुस्सियों अन्द चिट्ठी प्रेरित पौलुस उन <char style="xt"><ref loc="COL 1:1">१:१</ref></char> द्वारा मंडली इक लिख्सकु आगीत. आव ईद चिट्ठी आग लिख्सदुन याग आव जयल दा ईरोन, शायद रोम दा, मसीह अन जनम इन लगभग ६० साल बाद्दा. कुलुस्सियों, इफिसियों अदिक फिलेमोन ईद चिट्ठी पौलुस जयल दा ईतकु लिखसीदुन इदुरसाटी ईदरी जयल चिट्ठी अंदकु आगतद.</para>
  <para style="ip">आव ईद चिट्ठी कोलोसे शयर दा मंडली इक लिखसीदुन. पौलुस कुलुस्से दा मंडली चालु माळलिका ईरोन, यतिकी आंदुर <char style="xt"><ref loc="COL 2:1">२:१</ref></char> दा उल्लेख माळ्यार, लेकीन इदुरसाटी येनारा जिम्मेदारी महसूल माळीदुर. ईद संभव आद कि एपाफ्रास मंडली इन स्थापना माळीदुर यतिकी आंदुर कोलोसे टु ईरोर. पौलुस कोलोसे अन्द मंडली दा येनारा गलत शिक्षागोळ देल संबंधित ईरोन. आंदुर ईदुर बारा दा चिट्ठी लिखसुसोर दा हापाळ खर्च माळदुर, आग सकतद कि यहूदी ईसाईगोळ्द ऊंद समुह ईतीदाद, जो हाळोद नियम देल यहूदी कानूनगोळ्द पालन माळोर साटी दुसरा ईसाई वार्टुरगोळी मजबुर माळोद कोशिश माळोर, विशेष रूप देल खतना. पौलुस विशेष रूप देल लिख्सतान कि मसीह अक परमेश्वर <char style="xt"><ref loc="COL 1:15-20">१:१५-२०</ref></char> उन द्वारा स्वीकार माळकु आगोद अलावा मसीह अन्द अलावा येनु ईला या यावारा दुसरा अन्द जरवत आद अदिक मानव तर्क मा आधारित शिक्षागोळ बेकार आव <char style="xt"><ref loc="COL 2:8">२:८</ref></char></para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. पौलुस कोलोसे दा मंडली इक नमस्कार माळकु चिट्ठी सुरू माळतान. <char style="ior"><ref loc="COL 1:1-2">१:१-२</ref></char></para>
  <para style="io1">२. बाक आव मसीह अन्द महानता अन्द बारा दा लिख्सतान विशेष रूप देल कोलोसे <char style="ior"><ref loc="COL 1:3-3:4">१:३–३:४</ref></char> दा ख्वाटा शिक्षा अन जवाब दा.</para>
  <para style="io1">३. पौलुस हापाळ चिट्ठी गोळ दा, आव चिट्ठी गोळ्द उत्‍तरार्ध इक व्यक्त माळतान, जो वळ्लीद ईसाई जीवन जीऊसोर साटी थ्वाळासा विशिष्ट निर्देश कोळतद <char style="ior"><ref loc="COL 3:5-4:6">३:५–४:६</ref></char></para>
  <para style="io1">४. पौलुस अन्य मंडलीगोळ <char style="ior"><ref loc="COL 4:7-18">४:७-१८</ref></char> दा जोर देल वाचुस्द चिट्ठी इन साटी शुभकामनागोळ अदिक निर्देश कोळतान.</para>
  <chapter number="1" style="c" sid="COL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1"/>पौलुस अदिक आऊन वार्ट तीमुथियुस उन दी टु, जो परमेश्वर उन इच्छा देल मसीह यीशु उन प्रेरित आन,<verse eid="COL 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="COL 1:2"/>कुलुस्से दा ईरावाळेर परमेश्वर उन आ पवित्र विश्वासयोग्य वार्टुर इक जो मसीह दा ऊंद आर:</para>
  <para style="p" vid="COL 1:2">नाम आप्प परमेश्वर उन दी टु नीमी अनुग्रह अदिक शांती सिकतेला ईरूल.<verse eid="COL 1:2"/></para>
  <para style="s">धन्यवाद इन प्रार्थना</para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3"/>नाव नीम साटी हमेशा प्रार्थना माळतेव आग नाव तान प्रभु यीशु मसीह अन्द आप्प परमेश्वर उन धन्यवाद माळतेव. <verse eid="COL 1:3"/><verse number="4" style="v" sid="COL 1:4"/>यतिकी नाव मसीह यीशु दा नीम विश्वास अदिक सप्पा परमेश्वर उन पवित्र लॉकुर प्रती नीम प्यार इन बारा दा केळेव; <verse eid="COL 1:4"/><verse number="5" style="v" sid="COL 1:5"/>याग सही बातणी, खुशखबरी, पयला घन नीम हात्‍ती बत्‍त, रा नीव ई आशा अन्द बारा दा केळदीर कि ईद प्रदान माळतद. इदुरसाटी नीम विश्वास अदिक प्यार आ वस्तु मा आधारित आद, यदुर नीव उम्मीद माळतीर, जो नीम साटी स्वर्ग दा सुरक्षित ईटकु आद. <verse eid="COL 1:5"/><verse number="6" style="v" sid="COL 1:6"/>खुशखबरी आशिर्वाद तरेत्याद अदिक सप्पा दुनिया दा फैलुसेत्याद, ठीक हांग अच ह्यांग नीम न्याड्या दा आ दिशी टु आद या दिशी टु नीव पयला घन परमेश्वर उन कृपा अन बारा दा केळीदीर अदिक अदुर देल ईद पता नळुत कि ईद सही दा आद. <verse eid="COL 1:6"/><verse number="7" style="v" sid="COL 1:7"/><note caller="+" style="x"><char style="xo" closed="false">१:७ </char><char style="xt" closed="false"><ref loc="COL 4:12">कुलुस्सिगोळ ४:१२</ref>; <ref loc="PHM 1:23">फिलेमोन १:२३</ref></char></note>परमेश्वर उन अनुग्रह अक नीव नाम प्रिय सहकर्मी सेवक इपफ्रास उन से कलतीर, जो नाम दी टु मसीह नव विश्वासयोग्य कर्मचारी आन. <verse eid="COL 1:7"/><verse number="8" style="v" sid="COL 1:8"/>आवा नामी आ प्यार इन बारा दा हेळ्यान जो आत्मा नीमी कोटाद.<verse eid="COL 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9"/>ई कारण यागी टु नाव नीम बारा दा केळेव आगी टु नाव नीम साटी हमेशा प्रार्थना माळेव, परमेश्वर उन से नाव प्रार्थना माळतेव कि अद पुरा बुद्धी अदिक समझ जो आऊन आत्मा कोळतद आऊन सांगुळ अदुर्द इच्छा अन्द ग्यान देल नीमी तुम बुळुल. <verse eid="COL 1:9"/><verse number="10" style="v" sid="COL 1:10"/>ताकी नीम्द चाल चलन प्रभु उन लायक ईरूल, अदिक आव सब प्रकार देल प्रसन्न ईरूल, अदिक नीम जीवन दा टु वळ्लेव क्याल्सा होळुल, अदिक नीव परमेश्वर उन ग्यान दा वाळुसतेला होगी. <verse eid="COL 1:10"/><verse number="11" style="v" sid="COL 1:11"/>आऊन महिमामय शक्ति देल जो सामर्थ्य प्राप्त आगतद अदुर दा शक्तिशाली आग्त ईरी, ताकी नीव धीरज इन सांगुळ सप्पा येनारा सहन माळा लायक बन्सी. <verse eid="COL 1:11"/><verse number="12" style="v" sid="COL 1:12"/>अदिक खुशी इन सांगुळ आप्प उक धन्यवाद माळी, याव नीमी ई लायक माळदुन कि परमेश्वर उन आ लॉकुर सांगुळ जो आव आंदुर साटी पयले टु ना सुरक्षित माळ्द प्रकाश इन राज्य दा नीव पवित्र लॉकुर सांगुळ उत्‍तराधिकार प्राप्त माळदुर दा सहभागी बन्सी. <verse eid="COL 1:12"/><verse number="13" style="v" sid="COL 1:13"/>आवा नामी अंधकार इन वश टु बचाव माळकु तान प्रिय पार उन राज्य दा प्रवेश माळसुसदुन, <verse eid="COL 1:13"/><verse number="14" style="v" sid="COL 1:14"/><note caller="+" style="x"><char style="xo" closed="false">१:१४ </char><char style="xt" closed="false"><ref loc="EPH 1:7">इफिसिगोळ १:७</ref></char></note>अदिक आऊन द्वारा नाव स्वतंत्र माळकु आदेव, मतलब नामी नाम पापगोळ्द माफ सिक्त.<verse eid="COL 1:14"/></para>
  <para style="s">मसीह नव क्याल्सा अदिक व्यक्तित्व</para>
  <para style="p">
    <verse number="15" style="v" sid="COL 1:15"/>मसीह अदृश्य परमेश्वर उन समानता दा दृश्य रूप हुन अदिक आव सप्पा निर्मितीगोळ दा पयला पार हुन. <verse eid="COL 1:15"/><verse number="16" style="v" sid="COL 1:16"/>परमेश्वर तान द्वारा स्वर्ग अदिक पृथ्वी मा सुरूवात टु सप्पा येनारा माळदुन, आध्यात्मिक शक्तिगोळ, प्रभुगोळ, शासकगोळ अदिक अधिकारीगोळ सहित नोळ्द या बिननोळ्द वस्तुगोळ, परमेश्वर आऊन द्वारा पुरा ब्रम्हाण्ड इन निर्माण माळदुन. <verse eid="COL 1:16"/><verse number="17" style="v" sid="COL 1:17"/>सप्पा वस्तुगोळ से पयले मसीह अन्द अस्तित्व ईरोद अदिक आऊन दा सप्पा वस्तुगोळ तान सही जागा मा स्थिर ईरताव. <verse eid="COL 1:17"/><verse number="18" style="v" sid="COL 1:18"/><note caller="+" style="x"><char style="xo" closed="false">१:१८ </char><char style="xt" closed="false"><ref loc="EPH 1:22">इफिसिगोळ १:२२</ref>,<ref loc="EPH 1:23">२३</ref></char></note>आव तान मय इन स्याणा हुन, मतलब मंडली इन ताल्ला हुन; आवा सुरूवात हुन, अदिक सोत्‍तुर दा टु जित्‍ता आगावाळा पयला जनम ताकोमावाळा पार हुन, ताकी सप्पा वस्तुगोळ दा पयला स्थान हासिल माळ सकुल. <verse eid="COL 1:18"/><verse number="19" style="v" sid="COL 1:19"/>यतिकी परमेश्वर उन खुद इन ईद फैसला ईरोद कि आऊन दा परमेश्वर उन सप्पा परिपुर्णता वास माळुल. <verse eid="COL 1:19"/><verse number="20" style="v" sid="COL 1:20"/><note caller="+" style="x"><char style="xo" closed="false">१:२० </char><char style="xt" closed="false"><ref loc="EPH 2:16">इफिसिगोळ २:१६</ref></char></note>पार उन माध्यम देल परमेश्वर पुरा दुनिया अक तान ताना वापस तरोद फैसला माळदुन परमेश्वर क्रूस मा तान पार उन रक्ता अन माध्यम देल शांती माळदुन अदिक इदुरसाटी पृथ्वी अदिक स्वर्ग दा सप्पा वस्तुगोळी वापस तंदुन.<verse eid="COL 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 1:21"/>ऊंद समय ईरोद याग नीव परमेश्वर उन से हापाळ दुर ईरीर अदिक तान विचारगोळ अदिक बेकार कर्मगोळ कारण परमेश्वर उन दुश्मन ईरीर; <verse eid="COL 1:21"/><verse number="22" style="v" sid="COL 1:22"/>लेकीन ईग, आव तान पार उन शारीरिक मय इन मृत्यु उन द्वारा नीमी तान संगी माळ कोंडान, ताकी नीमी तान हात्‍ती पवित्र अदिक शुद्ध, अदिक निर्दोष माळकु उपस्थित माळुल. <verse eid="COL 1:22"/><verse number="23" style="v" sid="COL 1:23"/>अगर नीव विश्वास इन पायवा मा मजबूत बन्सकु ईत्‍तीर अदिक आ खुशखबरी इन आशा अक यदरी नीव केळीर बिळबाळी, यदुर्द प्रचार आकाश इन ल्यालमा अन्द पुरा दुनिया दा माळकु आत, अदिक यदुर्द ना, पौलुस, सेवक बन्सदीन.<verse eid="COL 1:23"/></para>
  <para style="s">पौलुस उन मंडली दा स्यावा कार्य</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24"/>ईग ना आ दुखगोळ्द कारण खुशी माळतीन, जो नीम्द साटी नेगेतीन अदिक मसीह अन्द क्लेशगोळ्द कमी आऊन मय इन साटी, मतलब मंडली इन साटी, तान मय दा पुरा माळतीन; <verse eid="COL 1:24"/><verse number="25" style="v" sid="COL 1:25"/>अदिक नानी परमेश्वर उन द्वारा मंडली इन सेवक माळकु आत अदिक याव नानी नीम भलाई इन क्याल्सा अन्द साटी कोट्टुन, अदिक ई क्याल्सा पुरा तरीका देल आऊन बातणीगोळ्द घोषणा माळतद. <verse eid="COL 1:25"/><verse number="26" style="v" sid="COL 1:26"/>ईद बातणी रहस्य पुर्ण सच्चाई आद जो सुरूवात काल टु सप्पा मंळसागोळ से गुप्त ईटसुसकु आग्याद, लेकीन ईग आऊन पवित्र लॉकुर मा प्रगट माळकु आग्याद. <verse eid="COL 1:26"/><verse number="27" style="v" sid="COL 1:27"/>परमेश्वर उन ईद योजना ईरोद कि तान लॉकुर मा ईद रहस्य प्रगट माळुल कि ईद रहस्य याट महिमामय किमती आ जो तान लॉकुर साटी आद. अदिक अद रहस्य ईद हुन कि मसीह नीम दा आन, मतलब नीव परमेश्वर उन महिमा अन्द सहभागी आग सकतीर. <verse eid="COL 1:27"/><verse number="28" style="v" sid="COL 1:28"/>इदुरसाटी नाव मसीह अन्द प्रचार सप्पा मुंदुरी माळतेव. अदिक जो बुद्धी नामी प्राप्त आग्याद आ सप्पा बुद्धी इन इस्तेमाल माळतेला नाव सप्पा मुंदुरी निर्देश अदिक शिक्षा प्रदान माळतेव ताकी नाव आंदरी मसीह दा ऊंद व्यक्तिगत परिपुर्ण मंळसा माळकु परमेश्वर उन मुंद उपस्थित माळ सक्केव. <verse eid="COL 1:28"/><verse number="29" style="v" sid="COL 1:29"/>अदिक इदरी पुरा माळोर साटी मसीह अन्द महान सामर्थ्य जो नानी सिकतेला ईरतद अदिक नान दा कार्य माळतद, अदुर्द इस्तेमाल माळतेला ना कठिन मयनत अदिक संघर्ष माळेतीन.<verse eid="COL 1:29"/></para>
  <chapter eid="COL 1"/>
  <chapter number="2" style="c" sid="COL 2"/>
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1"/>ना चाहासतीन नीमी ई मात इन पता नळ्दोगुल कि ना नीम साटी, लौदीकिया दा ईरावाळेर लॉकुर साटी अदिक आ सप्पा मुंदुर साटी जो व्यक्तिगत रूप देल नानी यागलु सिकिदील, ना याट कठिन मयनत माळेतीन. <verse eid="COL 2:1"/><verse number="2" style="v" sid="COL 2:2"/>ताकी आंदुर मनगोळी प्रोत्साहित सिकुल अदिक परस्पर प्यार दा एकजुट आगेगुल, अदिक अद पुरा विश्वास इन धन जो खरा समझ देल प्राप्त आगतद आंदरी सिक्केगुल. ई प्रकार देल आंदरी परमेश्वर उन भेद पता नळदोदित, जो मसीह खुश आन. <verse eid="COL 2:2"/><verse number="3" style="v" sid="COL 2:3"/>याऊन दा परमेश्वर उन बुद्धी इन भंडार अदिक ग्यान होचकु आद.<verse eid="COL 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="COL 2:4"/>ईद ना इदुरसाटी अनतीन कि यावारा मंळसा नीमी ख्वाटा वाद विवाद देल ध्वाका कोळबाळुल. बाक चाहे आंदुर याटारा भी वळ्लेर येती हतबाळुल. <verse eid="COL 2:4"/><verse number="5" style="v" sid="COL 2:5"/>ना मय इन भाव देल नीम से दुर आईन, तरी भी आत्मिक भाव देल नीम्द हात्‍ती आईन, अदिक नीम्द व्यवस्थित जीवन इक अदिक नीम्द विश्वास इन, जो मसीह दा आर, मजबूती नोळकु प्रसन्न आगतीन.<verse eid="COL 2:5"/></para>
  <para style="s">मसीह दा जीवन इन परिपुर्णता</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6"/>इदुरसाटी ह्यांग नीव मसीह यीशु उक प्रभु मान्सकु ग्रहण माळ कोंडीर, हांगा आऊन दा बन्सकु ईरी. <verse eid="COL 2:6"/><verse number="7" style="v" sid="COL 2:7"/>अदिक अदुर्दा जळ हुळकु अदिक वाळुसतेला ईरी; अदिक ह्यांग नीव कल्सकु आगीर हांग अच विश्वास दा मजबूत आगतेला होगी, अदिक यक्कुल से यक्कुल धन्यवाद माळतेला ईरी.<verse eid="COL 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 2:8"/>सावधान ईरी कि यावारा नीमी आ मंळसा अन्द बुद्धी इन व्यर्थ ध्वाका देल गुलाम माळसुस बुळुल, जो मंळसागोळ्द परंपरागोळ देल प्राप्त आगतेला बंदाद अदिक ब्रम्हाण्ड इक शासन माळावाळा आत्मागोळ्द देन हुन, ना कि मसीह अन्द. <verse eid="COL 2:8"/><verse number="9" style="v" sid="COL 2:9"/>यतिकी आऊन दा ईश्वरत्व स्वभाव हमेशा मसीह अन्द मय दा वास माळतद. <verse eid="COL 2:9"/><verse number="10" style="v" sid="COL 2:10"/>अदिक नीमी आऊन एकता दा पुरा जीवन कोटकु आग्याद. आव सुरूवात टु सप्पा आध्यात्मिक शासकगोळ अदिक अधिकार इन स्याणा हुन.<verse eid="COL 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="COL 2:11"/>मसीह अन्द सांगुळ दा नीम्द खतना माळकु आग्याद, ना कि आ खतना अन्द सांगुळ जो मंळसागोळ कय देल माळकु आग्याद, लेकीन मसीह अन्द द्वारा माळ्द खतना अन्द सांगुळ, नीम पापगोळ्द सामर्थ्य देल मुक्त माळकु आगताव. <verse eid="COL 2:11"/><verse number="12" style="v" sid="COL 2:12"/><note caller="+" style="x"><char style="xo" closed="false">२:१२ </char><char style="xt" closed="false"><ref loc="ROM 6:4">रोमियों ६:४</ref></char></note>याग नीव बपतिस्मा ताकोंडीदिर रा नीमी मसीह अन्द सांगुळ दफनुसकु आगीत अदिक बपतिस्मा दा नीम परमेश्वर उन सक्रिय शक्ति दा विश्वास इन माध्यम देल मसीह अन्द सांगुळ भी नेगुकु आगीत, आऊन सांगुळ जित्‍ता भी आदुर. <verse eid="COL 2:12"/><verse number="13" style="v" sid="COL 2:13"/><note caller="+" style="x"><char style="xo" closed="false">२:१३ </char><char style="xt" closed="false"><ref loc="EPH 2:1-5">इफिसिगोळ २:१-५</ref></char></note>ऊंद समय नीव भी आत्मिकता दा सोतकु ईरीर यतिकी नीव पापी, अदिक गैरयहूदी बिना व्यवस्था नोर ईरोर. लेकीन ईग परमेश्वर नीमी मसीह अन्द सांगुळ जीवन दा तंदान. परमेश्वर नाम सप्पा अपराधगोळ इक माफ माळ्यान. <verse eid="COL 2:13"/><verse number="14" style="v" sid="COL 2:14"/><note caller="+" style="x"><char style="xo" closed="false">२:१४ </char><char style="xt" closed="false"><ref loc="EPH 2:15">इफिसिगोळ २:१५</ref></char></note>परमेश्वर नाम बेकार क्याल्सागोळ्द लेखा जोखा अक नाम न्याड्या दा टु हटुस बुट्टुन यदुर दा आ विधीगोळ्द उल्लेख माळकु आगीत जो नाम प्रतिकुल अदिक नाम विरूद्ध ईरोद आव अदरी क्रूस मा खिल्लागोळ देल ठोक्सकु मिटुस बुटान. <verse eid="COL 2:14"/><verse number="15" style="v" sid="COL 2:15"/>अदिक मसीह क्रूस इन द्वारा आध्यात्मिक शासकगोळ्द सुरूवात टु सामर्थ्य अक अदिक अधिकारीगोळी शासन हीन माळ बुट्टुन अदिक तान विजय अभियान दा बंदी माळकु लॉकुर मुंद आंदुर तमाशा माळदुन.<verse eid="COL 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">२:१६ </char>
      <char style="xt" closed="false">
        <ref loc="ROM 14:1-6">रोमियों १४:१-६</ref>
      </char>
    </note>इदुरसाटी यावारा भी मंळसा नीम तिनोद-कुडोद या हाब्ब या व्हाशोद चांद इन हाब्ब, या विश्राम इन दिन इन बारा दा नीम्द याऊ न्याय माळबाळुल. <verse eid="COL 2:16"/><verse number="17" style="v" sid="COL 2:17"/>यतिकी ईव सब बरावाळा मातगोळ्द छाया हुव, लेकीन वास्तविकता अच मसीह हुन. <verse eid="COL 2:17"/><verse number="18" style="v" sid="COL 2:18"/>यातोवारा भी मंळसा अन्द द्वारा तान अपमान माळसुसोद इजाजत कोळबाळी जो विशेष दर्शन इन कारण श्रेष्ट आगोद दावा माळतद अदिक जो ख्वाटा विनम्रता अदिक स्वर्गदूतगोळ्द पुजा मा जोर कोळतद. बिना यातोदारा कारण इन ईत्‍ता मंळसा तान मानवीय सोच देल व्यर्थ बायतान. <verse eid="COL 2:18"/><verse number="19" style="v" sid="COL 2:19"/><note caller="+" style="x"><char style="xo" closed="false">२:१९ </char><char style="xt" closed="false"><ref loc="EPH 4:16">इफिसिगोळ ४:१६</ref></char></note>अदिक मसीह अक हुळकु ईटोद बंद माळ बुटार, आव मसीह जो मय इन ताल्ला हुन. मसीह अन्द हात्‍ती ता दा सप्पा मय आद जो जोळगोळ अदिक नशगोळ से ऊंदा सांगुळ जोळ्सकु आव, अदिक परमेश्वर जसा वाळुसोद चाहासतान हांग वाळुस्त होगतद.<verse eid="COL 2:19"/></para>
  <para style="s">मसीह अन्द सांगुळ सायोद अदिक ऊळोद</para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20"/>यतिकी नीव मसीह अन्द सांगुळ सोतोगीर अदिक ब्रम्हाण्ड इन शासन माळावाळा आत्मागोळ से मुक्त माळकु आगीर. रा बाक येती आंदुर घाई जो दुनिया नोर आर जीवन जीऊसतीर? नीव ईत्‍ता विधीगोळ वश दा येती ईरतीर. <verse eid="COL 2:20"/><verse number="21" style="v" sid="COL 2:21"/>कि “इदरी मुठबाळेतीर, अदरी नेकबाळेतीर, अदिक अदरी कय हचबाळेतीर?” <verse eid="COL 2:21"/><verse number="22" style="v" sid="COL 2:22"/>ईव सप्पा वस्तुगोळ क्याल्सा दा तरास ताका नष्ट आगेदव यतिकी ईव मंळसागोळ नियम अदिक आग्यागोळ अदिक शिक्षागोळ्द अनुसार आव. <verse eid="COL 2:22"/><verse number="23" style="v" sid="COL 2:23"/>निश्चित अच ईत्‍ता प्रकार इन सप्पा नियम स्वर्गदूतगोळ्द जबरदस्ती देल पुजा अदिक ख्वाटा विनम्रता, अदिक मय इन गंभीर उपचारगोळ ग्यान मा आधारित आद लेकीन शारीरिक लालसागोळी रोक्सदुर दा ईऊर देल येनु उच फायदा आगाल्द.<verse eid="COL 2:23"/></para>
  <chapter eid="COL 2"/>
  <chapter number="3" style="c" sid="COL 3"/>
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1"/>याग नीव मसीह अन्द सांगुळ जित्‍ता माळकु आगीर, इदुरसाटी तान दिल इक स्वर्गीय मातगोळ मा हची, यल मसीह तान ऊम्मा कय दी विराजमान आन अदिक परमेश्वर उन ऊम्मा कय दी कुर्तकु आन. <verse eid="COL 3:1"/><verse number="2" style="v" sid="COL 3:2"/>पृथ्वी माकळव वस्तुगोळ ईला लेकीन स्वर्गीय वस्तुगोळ मा ध्यान हची, <verse eid="COL 3:2"/><verse number="3" style="v" sid="COL 3:3"/>यतिकी नीव रा सोतोगीर अदिक नीम्द जीवन मसीह अन्द सांगुळ परमेश्वर दा होचकु आद. <verse eid="COL 3:3"/><verse number="4" style="v" sid="COL 3:4"/>नीम खरा जीवन मसीह हुन याग मसीह प्रगट आदान, आग नीव भी आऊन सांगुळ महिमा सहित प्रगट माळकु आदीर.<verse eid="COL 3:4"/></para>
  <para style="s">हाळोद अदिक व्हाशोद जीवन</para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5"/>इदुरसाटी पृथ्वी माकळव तान आ संसारिक इच्छागोळी कोंद बुळी जो नीम दा कार्य माळतद, मतलब व्यभिचार, अशुध्दता, दुष्कामना, बेकार लालसा अदिक लोभ इक जो मूर्तिपूजा अन्द बराबर आद. <verse eid="COL 3:5"/><verse number="6" style="v" sid="COL 3:6"/>यतिकी ईवा मातगोळ कारण जो आऊन आग्या मान्सालुर आंदुर मा परमेश्वर उन सिट्ट प्रगट आगली होगेत्याद. <verse eid="COL 3:6"/><verse number="7" style="v" sid="COL 3:7"/>अदिक ऊंद समय ईरोद याग नीव भी ईत्‍तव इच्छागोळ अनुसार तान जीवन जीऊसतोगीर, अदिक नीम जीवन आऊंदा प्रभुत्व दा का ईरोद.<verse eid="COL 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 3:8"/>लेकीन ईग नीव भी ईव सप्पा मातगोळी, मतलब सिट्ट, उत्‍तेजना, बैरभाव, अपमान अदिक बाय देल बोयोद ईव सप्पा मातगोळ बिट बुळी. <verse eid="COL 3:8"/><verse number="9" style="v" sid="COL 3:9"/><note caller="+" style="x"><char style="xo" closed="false">३:९ </char><char style="xt" closed="false"><ref loc="EPH 4:22">इफिसिगोळ ४:२२</ref></char></note>आबुर दाबुर से ख्वाटा माताळबाळी, यतिकी नीव हाळोद स्वभाव इक आऊन आदतगोळ सांगुळ ईळ्स कोंडीर. <verse eid="COL 3:9"/><verse number="10" style="v" sid="COL 3:10"/><note caller="+" style="x"><char style="xo" closed="false">३:१० </char><char style="xt" closed="false"><ref loc="EPH 4:24">इफिसिगोळ ४:२४</ref></char></note>अदिक व्हाशोद व्यक्तित्व अक धारण माळ कोंडीर, जो तान सृजनहार इन स्वरूप दा पुरा ग्यान प्राप्त माळोर साटी लगातार व्हाशोद बन्सतेला ईरतद. <verse eid="COL 3:10"/><verse number="11" style="v" sid="COL 3:11"/>अदिक ईदुर परिणाम ईद आद कि अल यहूदी अदिक गैरयहूदी दा येनु फरक ईराल, अदिक ना रा यातोदारा खतना माळ्द अदिक खतनारहित दा, अदिक ना यातोदारा सभ्य अदिक ना असभ्य दा, ना दास अदिक ना स्वतंत्र मंळसा दा, लेकीन मसीह अच सब येनारा हुन अदिक सप्पा विश्वासीगोळ दा मसीह अन्द वास आद.<verse eid="COL 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">३:१२ </char>
      <char style="xt" closed="false">
        <ref loc="EPH 4:2">इफिसिगोळ ४:२</ref>
      </char>
    </note>अदिक नीव परमेश्वर उन लॉकुर हुईर आव नीम से प्यार माळतान अदिक आव तान पवित्र आगोर साटी नीम चुनाव माळ्यान. रा बाक सहानुभुती, दया, नम्रता, कोमलता अदिक धीरज इक धारण माळी. <verse eid="COL 3:12"/><verse number="13" style="v" sid="COL 3:13"/><note caller="+" style="x"><char style="xo" closed="false">३:१३ </char><char style="xt" closed="false"><ref loc="EPH 4:32">इफिसिगोळ ४:३२</ref></char></note>अदिक अगर यारीकारा यारदारा मा दोष हचोद यातारा कारण ईरूल, रा आबुर दाबुर सहन माळी अदिक आबुर दाबुर्द अपराध माफ माळी; ह्यांग प्रभु नीम्द अपराध माफ माळदुन, हांग अच नीव भी माळी. <verse eid="COL 3:13"/><verse number="14" style="v" sid="COL 3:14"/>अदिक ई सप्पा मातगोळ अलावा प्यार इक धारण माळी, प्यार अच सप्पा मुंदुरी आपस दा कटकु ईटतद अदिक परिपुर्ण माळतद. <verse eid="COL 3:14"/><verse number="15" style="v" sid="COL 3:15"/>नीम साटी होगावाळा निर्णयगोळ मा अद शांती इन जो मसीह देल प्राप्त आगतद मार्गदर्शन ईरूल, इदुरसाटी परमेश्वर नीमी ऊंदा सांगुळ आ शांती दा ऊंद मय आगोर साटी कारस्यान. अदिक हमेशा धन्यवाद माळ्त ईरी. <verse eid="COL 3:15"/><verse number="16" style="v" sid="COL 3:16"/><note caller="+" style="x"><char style="xo" closed="false">३:१६ </char><char style="xt" closed="false"><ref loc="EPH 5:19">इफिसिगोळ ५:१९</ref>,<ref loc="EPH 5:20">२०</ref></char></note>तान सप्पा संपन्नता अन्द सांगुळ मसीह अन्द बातणी नीम दिलगोळ दा वास माळुल. अदिक तान सप्पा बुद्धी देल आबुर दाबुर इक शिक्षा अदिक निर्देश कोळ्त ईरी. भजनगोळ स्तुति अदिक आत्मिक हाळगोळी हाळतेला तान दिलगोळ दा परमेश्वर उक धन्यवाद कोळ्त ईरी. <verse eid="COL 3:16"/><verse number="17" style="v" sid="COL 3:17"/>जो येनारा भी नीव माळी या अनी अद सप्पा प्रभु यीशु उन हेसुर मा आग पायजे, अदिक आऊन द्वारा परमेश्वर आप्प उन धन्यवाद माळी.<verse eid="COL 3:17"/></para>
  <para style="s">व्हाशोद जीवन इन पारिवारिक नियम</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">३:१८ </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:22">इफिसिगोळ ५:२२</ref>; <ref loc="1PE 3:1">१ पतरस ३:१</ref></char>
    </note>हे हिंग्सुरा, तान तान गांड्डुर्द हात्‍ती ईरी, ह्यांग मसीह अन्द अनुयायीगोळी शोभा कोळतद.<verse eid="COL 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="COL 3:19"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">३:१९ </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:25">इफिसिगोळ ५:२५</ref>; <ref loc="1PE 3:7">१ पतरस ३:७</ref></char>
    </note>हे गांड्डुरा, तान तान हिंग्सुर से प्यार ईटी, अदिक आंदुर से कठोर व्यवहार माळबाळी.<verse eid="COL 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 3:20"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">३:२० </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:1">इफिसिगोळ ६:१</ref>
      </char>
    </note>हे चिकोरा, सप्पा मातगोळ दा तान तान मोय-आप्प उन आग्या अन्द पालन माळी, यतिकी मसीह अनुयायी इन ईत्‍ता व्यवहार देल परमेश्वर प्रसन्न आगतान.<verse eid="COL 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 3:21"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">३:२१ </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:4">इफिसिगोळ ६:४</ref>
      </char>
    </note>हे मोय आप्पुरा, तान चिकोर इक तंग माळबाळी, हिंग आगबाळुल कि आंदुर्द साहस मुरदोगुल.<verse eid="COL 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="COL 3:22"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">३:२२ </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:5-8">इफिसिगोळ ६:५-८</ref>
      </char>
    </note>हे सेवकगोळा, जो मय इन अनुसार नीम्द स्वामी आन, सप्पा मातगोळ दा आंदुर्द आग्या अन्द पालन माळी, सिर्फ लॉकुरी खुश माळोर साटी अदा समय ईला याग आंदुर नोळतेला आर, बल्‍की खरा मन देल आंदुर्द मान्सी यतिकी नीव प्रभु उन आदर माळतीर. <verse eid="COL 3:22"/><verse number="23" style="v" sid="COL 3:23"/>जो येनारा क्याल्सा नीव माळतीर, तान पुरा मन देल माळी, ईद सम्सकु कि मंळसागोळ्द साटी ईला लेकीन प्रभु उन साटी माळतेव; <verse eid="COL 3:23"/><verse number="24" style="v" sid="COL 3:24"/>याद ईटी कि प्रभु ईदुर प्रतिफल नीमी कोट्टान जो आव तान लॉकुर साटी ईट्यान, यतिकी मसीह खरा स्वामी हुन यार्द नीव स्यावा माळतीर. <verse eid="COL 3:24"/><verse number="25" style="v" sid="COL 3:25"/><note caller="+" style="x"><char style="xo" closed="false">३:२५ </char><char style="xt" closed="false"><ref loc="EPH 6:9">इफिसिगोळ ६:९</ref></char></note>जो अपराध माळतान आव तान अपराध इंद फल ताकोंडान, यतिकी परमेश्वर यारदारा सांगुळ पक्षपात माळालुन.<verse eid="COL 3:25"/></para>
  <chapter eid="COL 3"/>
  <chapter number="4" style="c" sid="COL 4"/>
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">४:१ </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:9">इफिसिगोळ ६:९</ref>
      </char>
    </note>हे स्वामीगोळा, नीव तान तान सेवकगोळी आंदुर क्याल्सागोळ अनुसार जो सही बदला आद आंदरी कोळी. याद ईटी कि स्वर्ग दा नीमव भी यावारा स्वामी आन.<verse eid="COL 4:1"/></para>
  <para style="s">थ्वाळासा व्यावहारिक निर्देश</para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2"/>प्रार्थना दा लगातार हतकु ईरी, अदिक परमेश्वर उक धन्यवाद कोळतेला अदुर दा जागृत ईरी; <verse eid="COL 4:2"/><verse number="3" style="v" sid="COL 4:3"/>अदिक इदुर सांगुळ सांगुळ अच नाम साटी भी प्रार्थना माळतेला ईरी, कि परमेश्वर नाम साटी मसीह अन्द आ भेद इन बातणी प्रचार माळोर साटी वळ्लीद मवका प्रदान माळुल, यतिकी इदुर दा कारण ना कैद दा आईन. <verse eid="COL 4:3"/><verse number="4" style="v" sid="COL 4:4"/>प्रार्थना माळी कि ना इदरी हिंग स्पष्टता अन्द सांगुळ हेळ सकाईन ह्यांग नानी हेळोद जरूरी आद.<verse eid="COL 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 4:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">४:५ </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:16">इफिसिगोळ ५:१६</ref>
      </char>
    </note>समय इन पुरा पुरा इस्तेमाल माळी अदिक अविश्वासीगोळ सांगुळ बुद्धिमानी देल व्यवहार माळी. <verse eid="COL 4:5"/><verse number="6" style="v" sid="COL 4:6"/>नीम मातगोळ पुरा अनुग्रह देल तुमकु अदिक लॉकुरी पसंद बरा लायक ईरूल ताकी नीव जान्स कोमी कि हर मंळसा अक ह्यांग उत्‍तर कोळोद जरूरी आद.<verse eid="COL 4:6"/></para>
  <para style="s">आखरी अभिवादन</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">४:७ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 20:4">प्रेरितगोळ २०:४</ref>; <ref loc="2TI 4:12">२ तीमुथियुस ४:१२</ref></char>
    </note>
    <note caller="+" style="x">
      <char style="xo" closed="false">४:७ </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:21">इफिसिगोळ ६:२१</ref>,<ref loc="EPH 6:22">२२</ref></char>
    </note>नाम प्रिय वार्ट अदिक विश्वासयोग्य सेवक, तुखिकुस, जो प्रभु दा नान सहकर्मी आन, नान सप्पा समाचार नीमी हेळ बुट्टान. <verse eid="COL 4:7"/><verse number="8" style="v" sid="COL 4:8"/>आऊक ना इदुरसाटी नीम्द हात्‍ती कळुदीन कि नीमी नाम्द दशा मालूम आगेगुल अदिक आव नीम्द दिलगोळ इक प्रोत्साहित माळुल. <verse eid="COL 4:8"/><verse number="9" style="v" sid="COL 4:9"/><note caller="+" style="x"><char style="xo" closed="false">४:९ </char><char style="xt" closed="false"><ref loc="PHM 1:10-12">फिलेमोन १:१०-१२</ref></char></note>आऊन सांगुळ ना उनेसिमुस उक भी कळुदीन जो विश्वासलायक अदिक प्रिय वार्ट अदिक नीम दा टु ना ऊंद हुन; ईंदुर नीमी ईलेव सप्पा मातगोळ हेळ बुट्टार.<verse eid="COL 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="COL 4:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">४:१० </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:29">प्रेरितगोळ १९:२९</ref>; <ref loc="ACT 27:2">२७:२</ref>; <ref loc="PHM 1:24">फिलेमोन १:२४</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="ACT 12:12">प्रेरितगोळ १२:१२</ref>,<ref loc="ACT 12:25">२५</ref>; <ref loc="ACT 13:13">१३:१३</ref>; <ref loc="ACT 15:37-39">१५:३७-३९</ref></char>
    </note>अरिस्तर्खुस, जो नान सांगुळ बंदीगृह दा सांगुळ ईतान, अदिक बरनबास उन वार्ट मरकुस उन नीमी नमस्कार, मरकुस उन बारा दा नीमी निर्देश सिक्‍केग्याद अच अगर आव नीम हात्‍ती बंदान रा आऊन स्वागत माळकु आऊक ग्रहण माळेतीर. <verse eid="COL 4:10"/><verse number="11" style="v" sid="COL 4:11"/>यूस्तुस अंदकु आगावाळा यीशु उन भी नीमी नमस्कार सिकुल. सिर्फ ई मुरा मुंदुरा यहूदी विश्वासी परमेश्वर उन राज्य अन्द साटी नान सांगुळ क्याल्सा माळेत्यार, अदिक ईंदुर्द नानी हापाळ सहायता सिक्याद.<verse eid="COL 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 4:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">४:१२ </char>
      <char style="xt" closed="false">
        <ref loc="COL 1:7">कुलुस्सिगोळ १:७</ref>; <ref loc="PHM 1:23">फिलेमोन १:२३</ref></char>
    </note>इपफ्रास, जो नीम दा टु ऊंद आन अदिक मसीह यीशु उन दास आन, नीमी नमस्कार अनतान अदिक सदा नीम साटी प्रार्थनागोळ दा प्रयत्न माळतान, ताकी नीव सिद्ध आगकु पुरा विश्वास इन सांगुळ परमेश्वर उन इच्छा मा स्थिर ईरी. <verse eid="COL 4:12"/><verse number="13" style="v" sid="COL 4:13"/>ना व्यक्तिगत रीति देल आऊन गवाह आईन कि आव नीम साटी अदिक लौदीकिया अदिक हियरापुलिसवाळेर्द साटी कठिन मेहनत माळतेला ईरतान. <verse eid="COL 4:13"/><verse number="14" style="v" sid="COL 4:14"/><note caller="+" style="x"><char style="xo" closed="false">४:१४ </char><char style="xt" closed="false"><ref loc="2TI 4:11">२ तीमुथियुस ४:११</ref>; <ref loc="PHM 1:24">फिलेमोन १:२४</ref>; </char><char style="xt" closed="false"><ref loc="2TI 4:10">२ तीमुथियुस ४:१०</ref>; <ref loc="PHM 1:24">फिलेमोन १:२४</ref></char></note>नाम प्रिय वैद्य लूका अदिक देमास नीमी नमस्कार कळुतार.<verse eid="COL 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="COL 4:15"/>लौदीकिया अन्द विश्वासी वार्टुर, अदिक आकतींग नुमफास अदिक आकिन मान्ना अन्द मंडली इक नाम दी टु नमस्कार अनेत. <verse eid="COL 4:15"/><verse number="16" style="v" sid="COL 4:16"/>याग ईद चिट्ठी नीम अल वाचुसकु आदीत रा हिंग माळेतीर कि लौदीकिया अन्द मंडली दा भी वाचुसकु आगुल, अदिक अदा समय अद चिट्ठी जो लौदीकिया नोर विश्वासी नीमी कळ्यार अदरी नीव भी वाचुसेतीर. <verse eid="COL 4:16"/><verse number="17" style="v" sid="COL 4:17"/><note caller="+" style="x"><char style="xo" closed="false">४:१७ </char><char style="xt" closed="false"><ref loc="PHM 1:2">फिलेमोन १:२</ref></char></note>अदिक अरखिप्पुस से अनेतीर कि “जो स्यावा प्रभु दा आऊक सौप्सकु आग्याद आव अदरी निश्चय इन सांगुळ पुरा माळुल.<verse eid="COL 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18"/>“ना पौलुस खुद तान कय देल नीमी नमस्कार लिखसेतीन. याद ईटी कि ना शंकलीगोळ देल कटकु बंदीगृह दा आईन,”</para>
  <para style="p" vid="COL 4:18">परमेश्वर उन अनुग्रह नीम सांगुळ बन्सकु ईरूल.<verse eid="COL 4:18"/></para>
  <chapter eid="COL 4"/>
</usx>
