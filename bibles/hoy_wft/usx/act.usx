<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- Holiya</book>
  <para style="h">प्रेरितगोळ</para>
  <para style="toc3">प्रेरितगोळ</para>
  <para style="toc2">प्रेरितगोळ</para>
  <para style="toc1">प्रेरितगोळ क्याल्सागोळ्द वर्णन</para>
  <para style="mt2">प्रेरितों के कामों का वर्णन</para>
  <para style="mt1">प्रेरितगोळ क्याल्सागोळ्द वर्णन</para>
  <para style="imt">परिचय</para>
  <para style="ip">प्रेरितगोळ क्याल्सागोळ्द किताब मंडली अन्द सुरूवात इन कात्‍ता हुन अदिक ईद यरूशलेम टु यहूदिया, सामरीया अदिक अदुर मुंद ताका ह्यांग फैलुस्त, जसा यीशु तान चेलागोळी स्वर्ग दा होगा से पयले हेळीदुन <char style="xt"><ref loc="ACT 1:8">१:८</ref></char> इदरी लूका लिखस्यान, आव ऊंद डाक्‍टर ईरोन अदिक ऊंद सीधा खाता ईटोरसाटी हापाळ सावधान ईरोन. आंदुर तान खुशखबरी अदिक अधिनियमगोळ्द किताब थियुफिलुस उक संभोधित माळदुर, जो ऊंद ग्रीक ईरोन, लेकीन किताबगोळ्द उद्देश शायद मसीह समुदायगोळ साटी भी ईरोद यदुर दा ग्रीक अदिक यहूदी येढ्ढु शामिल ईरोर <char style="xt"><ref loc="ACT 1:1">१:१</ref></char></para>
  <para style="ip">प्रेरितगोळ क्याल्सा आग सकतद यीशु मसीह अन जनम इन बाद्दा ६०-६४ साल इन बीच दा लिख्सकु आगीदव यतिकी किताब, कैद टु पौलुस उन रीहाई से पयले खतम आगतद. लूका भी प्रेरित पौलुस उन सांगुळ यात्रा माळदुन अदिक शायद अन्ताकिया नगर दा अधिनियम लिख्सदुन. प्रेरितगोळ लूका अन खुशखबरी इक चालु ईट्यार अदिक यीशु उन स्वर्ग दा होग्गा सांगुळ सुरू आगतद. लेखन दा लूका अन उद्देश आंदुर खुशखबरी इन घाई अच आद. ईद थियुफिलुस चाहासोन, सांगुळ अच मसीहगोळ्द वाळुस्त गिनती देल निश्चित आद कि आंदरी येन कल्सकु आगीत अदिक इदुरसाटी आंदुर यीशु उन जीवन अदिक मसीह न्याय प्रचार इन ऊंद सीधा लेख लिख्सदुर.</para>
  <para style="ip">प्रेरितगोळ्द किताब नाम साटी सुरूवाती मंडली अन उदाहरण प्रदान माळतद अदिक यीशु दा विश्वास दा जीवन जीऊसोर साटी ईद ह्यांग तोर्सतद. प्रेरितगोळ्द उदाहरण नामी तोर्सताव कि दुसरागोळी खुशखबरी बातणी फैलुसदुर दा पवित्र आत्मा अन शक्ति मा भरोसा ह्यांग माळोद आद.</para>
  <para style="iot">रूप रेखा:</para>
  <para style="io1">१. पयले आत्मा चेलागोळ मा बरतद अदिक मंडली वाळुसली हततद <char style="ior"><ref loc="ACT 1:1-8:1">१:१–८:१</ref></char></para>
  <para style="io1">२. इदुर बाद्दा मंडली अक सतुस्कु आगतद अदिक यरूशलेम टु मुंद फैलुसली हततद <char style="ior"><ref loc="ACT 8:2-12:23">८:२–१२:२३</ref></char></para>
  <para style="io1">३. अदुर बाद्दा पौलुस तान पयला प्रचार यात्रा मा होगतान <char style="ior"><ref loc="ACT 12:24-14:28">१२:२४–१४:२८</ref></char></para>
  <para style="io1">४. इदुर बाद्दा मंडली यरूशलेम दा बाक माळकु ईद तय माळ्त कि व्हाशोर विश्वासीगोळ्द येन जरवत आव <char style="ior"><ref loc="ACT 15:1-35">१५:१-३५</ref></char></para>
  <para style="io1">५. बाक पौलुस तान दुसरा प्रचार यात्रा मा होगतान <char style="ior"><ref loc="ACT 15:36-18:22">१५:३६–१८:२२</ref></char></para>
  <para style="io1">६. इदुर बाद्दा आव तान तिसरा प्रचार यात्रा मा होगतान <char style="ior"><ref loc="ACT 18:23-20:38">१८:२३–२०:३८</ref></char></para>
  <para style="io1">७. आग पौलुस उक यरूशलेम दा गिरफ्तार माळकु आत <char style="ior"><ref loc="ACT 21:26">२१:२६</ref></char></para>
  <para style="io1">८. आखरी दा पौलुस उक रोम शयर दा पोहचुस्कु आत. <char style="ior"><ref loc="ACT 27-28">२७–२८</ref></char></para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="s">परिचय</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:१ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 1:1-4">लूका १:१-४</ref>
      </char>
    </note>हे प्रिय, थियुफिलुस:</para>
  <para style="p" vid="ACT 1:1">ना पयला किताब आ सप्पा मातगोळ्द बारा दा लिख्सीन जो यीशु सुरूवात टु माळतेला अदिक कल्सतेला ईत्‍तुन <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />आ दिशी ताका यागासताका आव आ प्रेरितगोळी यारी आव नीवळुसिदुन पवित्र आत्मा अन्द द्वारा आग्या कोटकु म्याकुच नेगुकु आगीदील, निर्देश कोळतेला ईत्‍तुन <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />आव सोत्‍तुर बाद्दा हापाळ सा पक्‍का प्रमाणगोळ देल तान-तान इक आंदरी जित्‍ता तोर्सदुन, अदिक चालीस दिन ताका आव आंदरी कांळ्सतेला ईत्‍तुन, अदिक परमेश्वर उन राज्य अन्द मातगोळी हेळतेला ईत्‍तुन. <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" /><note caller="+" style="x"><char style="xo" closed="false">१:४ </char><char style="xt" closed="false"><ref loc="LUK 24:49">लूका २४:४९</ref></char></note>अदिक आंदुर से सीक्‍कु आंदरी आग्या कोट्टुन, “यरूशलेम इक बिळबाळी, लेकीन आप्प उन आ वादा अन्द पुरा आगोद हादी कायतेला ईरी, यार्द बारा दा ना नीमी हेळीदिन. <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" /><note caller="+" style="x"><char style="xo" closed="false">१:५ </char><char style="xt" closed="false"><ref loc="MAT 3:11">मत्ती ३:११</ref>; <ref loc="MRK 1:8">मरकुस १:८</ref>; <ref loc="LUK 3:16">लूका ३:१६</ref>; <ref loc="JHN 1:33">यूहन्ना १:३३</ref></char></note>यतिकी बपतिस्मा कोळावाळा यूहन्ना रा नीर दा बपतिस्मा कोटान लेकीन थ्वाळासा दिनगोळ्द बाद्दा नीव पवित्र आत्मा देल बपतिस्मा ताकोंडीर.”<verse eid="ACT 1:5" /></para>
  <para style="s">यीशु उन स्वर्गारोहण</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />इदुरसाटी आंदुर जमा आगकु आऊन से केळदुर, “हे प्रभु, येन नी ईदा समय इस्त्राएल इक राज्य मात्‍त वापस माळ कोंड्या?”<verse eid="ACT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7" />यीशु आंदुर से अंदुन, “आ समयगोळी या कालगोळी जानसोद, यारी आप्प तांद अच अधिकार दा ईट्यान, नीम्द क्याल्सा आलच. <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" /><note caller="+" style="x"><char style="xo" closed="false">१:८ </char><char style="xt" closed="false"><ref loc="MAT 28:19">मत्ती २८:१९</ref>; <ref loc="MRK 16:15">मरकुस १६:१५</ref>; <ref loc="LUK 24:47">लूका २४:४७</ref>,<ref loc="LUK 24:48">४८</ref></char></note>लेकीन याग पवित्र आत्मा नीम मा बंदीत आग नीमी सामर्थ्य सिक्‍कीत; अदिक यरूशलेम अदिक पुरा यहूदिया अदिक सामरीया दा, अदिक पृथ्वी इन आखरी ताका नान गवाह ईत्‍तार.” <verse eid="ACT 1:8" /><verse number="9" style="v" sid="ACT 1:9" /><note caller="+" style="x"><char style="xo" closed="false">१:९ </char><char style="xt" closed="false"><ref loc="MRK 16:19">मरकुस १६:१९</ref>; <ref loc="LUK 24:50">लूका २४:५०</ref>,<ref loc="LUK 24:51">५१</ref></char></note>ईद अनकु आव आंदुर नोळ्त-नोळ्त अच म्याकुच नेगुकु आदुन, अदिक आकाश इन ढग आऊक आंदुर कण्णगोळ देल होच बुळ्त.<verse eid="ACT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10" />यीशु उन होगाहोती याग आंदुर आकाश दी तार हचकु नोळोर, रा नोळी, येढ्ढ मंळसागोळ बिळेव चमकदार कपळा हाक्‍कु आंदुर हात्‍ती बंदकु निदुरदुर, <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />अदिक आंदुर से अंदुर, “हे गलीली लॉकुरा, नीव येती निदुरकु आकाश दी नोळेतीर? ईवा यीशु, जो नीम हात्‍ती टु स्वर्ग मा नेगुकु आदुन, याता रीति देल नीव आऊक स्वर्ग इक होग्त नोळदीर अदा रीति देल आव मात्‍त बंदान.”<verse eid="ACT 1:11" /></para>
  <para style="s">यहूदा अन्द जागा मा मत्तियाह अन्द निवळ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />आग प्रेरित जैतून हेसुर इन पहाळी टु ईळदुर जो यरूशलेम नगर इन हात्‍ती आरधा कोश इन दुरी मा आद, यरूशलेम इक मात्‍त वापस बंदुर. <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" /><note caller="+" style="x"><char style="xo" closed="false">१:१३ </char><char style="xt" closed="false"><ref loc="MAT 10:2-4">मत्ती १०:२-४</ref>; <ref loc="MRK 3:16-19">मरकुस ३:१६-१९</ref>; <ref loc="LUK 6:14-16">लूका ६:१४-१६</ref></char></note>याग आंदुर अल पोहचुसदुर रा आ म्याकुच इन कमरा दा होदुर, यल पतरस अदिक यूहन्ना अदिक याकूब अदिक अन्द्रियास अदिक फिलिप्पुस अदिक थोमा अदिक बरतुल्‍मै अदिक मत्ती अदिक हलफई नव पार याकूब अदिक द्याश भक्त शमौन अदिक याकूब उन पार यहूदा ईरतोगोर. <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />ई सप्पा मुंदुर हापाळ आर्तेर अदिक यीशु उन मोय मरियम अदिक आ वार्टुर सांगुळ ऊंद मन अदिक जमा आगकु प्रार्थना दा हतकु ईत्‍तुर.<verse eid="ACT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />अवा दिनगोळ दा पतरस, विश्वासी वार्टुर बीच दा जो ऊंद सौ ईप्पत मंळसागोळ लगभग ईरोर, निदुरकु अनली कुरतुन, <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />“हे नान वार्टुरा,” यीशु अक बंदी माळावाळेर अगुवा यहूदा अन बारा दा पवित्रशास्त्र अन अद लेख यारी दाऊद उन बाय देल पवित्र आत्मा हापाळ पयले अच अंद बुटीत, अदुर पुरा आगोद जरूरी ईरोद.<verse eid="ACT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 1:17" />यतिकी यहूदा रा नाम दा टु ऊंद ईरोन, अदिक ई क्याल्सा दा सहभागी आगोर साटी आऊक निवळुस्कु आगीत. <verse eid="ACT 1:17" /><verse number="18" style="v" sid="ACT 1:18" /><note caller="+" style="x"><char style="xo" closed="false">१:१८ </char><char style="xt" closed="false"><ref loc="MAT 27:3-8">मत्ती २७:३-८</ref></char></note>आव अन्याय इन कमाई देल ऊंद केई कोंड कोंडुन, अदिक ताल्ला अन्द भार देल बिद्दुन अदिक आऊन व्हाट्टा वळदोत अदिक आऊन कळ्लपच्चीगोळ होटकु बिदोदव. <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />ई मात इक यरूशलेम ईनोर सप्पा ईरावाळेर अर्त कोंडुर, ईल ताका कि आ केई इन हेसुर आंदुर भाषा दा हकलदमा, मतलब “खुन इन केई” बिदोत.<verse eid="ACT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20" />
    <note caller="+" style="f">
      <char style="fr" closed="false">१:२० </char>
      <char style="ft" closed="false">भजन संहिता ६९:२५, भजन संहिता १०९:८ </char>
    </note> “भजन संहिता अन्द किताब दा लिख्सकु आद,”</para>
  <para style="q1" vid="ACT 1:20">आऊन मान्ना बरबाद आगेदीत;</para>
  <para style="q2" vid="ACT 1:20">अदिक अदुर दा यारू ईरबाळी.</para>
  <para style="m" vid="ACT 1:20">अदिक आऊन पद यावारा</para>
  <para style="q1" vid="ACT 1:20">दुसरा ताकोम कोमुल.<verse eid="ACT 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 1:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:२१ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:16">मत्ती ३:१६</ref>; <ref loc="MRK 1:9">मरकुस १:९</ref>; <ref loc="LUK 3:21">लूका ३:२१</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MRK 16:19">मरकुस १६:१९</ref>; <ref loc="LUK 24:51">लूका २४:५१</ref></char>
    </note>इदुरसाटी यास दिन ताका प्रभु यीशु नाम सांगुळ होग्त बर्त ईत्‍तुन, मतलब यूहन्ना अन्द बपतिस्मा टु हुडुकु आऊन नाम हात्‍ती टु नेगासताका जो लॉकुर बराबर नाम सांगुळ ईत्‍तुर,<verse eid="ACT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 1:22" />उचित आद कि आंदुर दा टु ऊंद मंळसा नाम सांगुळ प्रभु अन्द जित्‍ता आगोद गवाह आगेगुल.<verse eid="ACT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />आग आंदुर येढ्ढ मुंदुर इक निदरूसदुर, ऊंद यूसुफ उक यार इक बरसब्बा अंदकु आगतद, आऊन दुसरा हेसुर यूस्तुस आद, दुसरा मत्तियाह अक, <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />अदिक ईद प्रार्थना माळदुर, “हे प्रभु, नी जो सप्पा मुंदुर्द मन अरूत्या, ईद प्रगट माळ कि ई येढ्ढु मुंदुर दा टु नी यार इक नीवळुस्या, <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />ताकी आव ई सेवकाई अदिक प्रेरित पद इन जागा ग्रहण माळुल, यदरी यहूदा बिटकु तान जागा अक होटोदुन.” <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />आग आंदुर तान साटी चिट्ठी गोळ हाकदुर, अदिक चिट्ठी मत्तियाह अन्द हेसुर देल होळ्त. इदुरसाटी आव आ हनुन प्रेरितगोळ्द सांगुळ आळुकु आदुन.<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s">पवित्र आत्मा अन्द ईळोद</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />याग पिन्तेकुस्त उन दिन बंदव, “मतलब फसह अन हाब्ब खतम आगतद आग टु पचासवा दिन” बत्‍त, रा आंदुर सप्पा विश्वासी ऊंद जागा मा जमा ईरोर. <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />अचानक आकाश दी टु धोळ्द आंधी घाई सनसनाहट इन शब्द केळ बत्‍त, अदिक आ शब्द देल सप्पा मान्ना यल आंदुर सप्पा मुंदुर कुर्तकु ईरोर, तुम्मेत. <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />अदिक आंदरी बेक्‍की इन घाई ल्यालग्या हरूतेला अदिक फैलुसतेला कांळ्सत अदिक आंदुर दा टु हर ऊंद मंळसा मा बंदकु रूकसेत. <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />आंदुर सप्पा मुंदुर पवित्र आत्मा देल तुम्मेदुर, अदिक या प्रकार देल आत्मा आंदरी माताळोद सामर्थ्य कोळ्त, आंदुर अलग-अलग भाषा दा माताळली कुरतुर.<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />आकाश इन ल्यालमा नोर सप्पा द्याशगोळ दा टु बरावाळेर अलग-अलग प्रकार इन भाषा माताळावाळेर यहूदी भक्त आ समय यरूशलेम दा ईरतोगोर. <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />याग ईद शब्द आत रा हापाळ भीळ हत्‍तेत अदिक लॉकुर चकित आगेदुर, यतिकी हर ऊंद मंळसा अक ईदा केळ बरतोगोद कि ईंदुर नांद अच मात दा माताळेत्यार. <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />आंदुर सप्पा मुंदुर चकित अदिक अचम्भित आगकु अनली कुरतुर, “नोळी, ईंदुर जो माताळेत्यार येन सप्पा गलीली आल्लच? <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />रा बाक येती नाम दा टु हर ऊंद मंळसा तान-तान जनम भूमी इन भाषा केळतान? <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />नाव जो पारथी अदिक मेदी अदिक एलामी अदिक मेसोपोटामिया अदिक यहूदिया अदिक कप्पदूकिया अदिक पुन्तुस अदिक आसिया, <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />अदिक फ्रूगिया अदिक पंफूलिया अदिक मिस्त्र अदिक लीबिया द्याश जो कुरेन इन आसपास आद, ई सप्पा द्याश इनोर ईरावाळेर अदिक रोमी प्रवासी, <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />मतलब यहूदी अदिक यहूदी मत धारण माळावाळेर, क्रेती अदिक अरबी भी आर, लेकीन तान-तान भाषा दा आंदुर से परमेश्वर उन धोळ्द-धोळ्द क्याल्सागोळ्द चर्चा केळतार.” <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />अदिक आंदुर सप्पा मुंदुर चकित आदुर अदिक घबरूसकु आबुर दाबुर से अनली कुरतुर, “ईद येन आगेत्याद?”<verse eid="ACT 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 2:13" />लेकीन दुसरा लॉकुर मज्याक माळकु अंदुर, “आंदुर रा कुडुकु नशा दा चूर आर.”<verse eid="ACT 2:13" /></para>
  <para style="s">पतरस उन बातणी</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />आग पतरस आ हनुन प्रेरितगोळ्द सांगुळ निदुरदुन अदिक धोळ्द शब्द दा अनली कुरतुन, “हे यहूदी अदिक हे यरूशलेम इनोर सप्पा ईरावाळेर लॉकुरा, ईद अर्त कोमी अदिक किव हचकु नान मातगोळ केळी. <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />ह्यांग नीव समसेतिर; ई लॉकुर नशा दा हैलेच, यतिकी ईगल्या रा व्हातुर ईनव ऊंम्बत अच मुरदाव. <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />लेकीन ईद अद मात हुन, जो परमेश्वर उन दी टु बातणी तरावाळा योएल उन द्वारा अंदकु आगीत” <verse eid="ACT 2:16" /><verse number="17" style="v" sid="ACT 2:17" />परमेश्वर अनतान:</para>
  <para style="q1" vid="ACT 2:17">कि आखरी इन दिनगोळ दा हिंग आदीत कि</para>
  <para style="q2" vid="ACT 2:17">ना तान आत्मा सप्पा मंळसा जाती मा हाक्‍काईन.</para>
  <para style="q1" vid="ACT 2:17">अदिक नीम पारगोळ अदिक पोरगोळ</para>
  <para style="q2" vid="ACT 2:17">परमेश्वर उन दी टु बातणी कोट्टार, अदिक नीम हारोदोर मंळसागोळ दर्शन नोळ्यार,</para>
  <para style="q2" vid="ACT 2:17">अदिक नीम स्याणागोळ कान्सा नोळ्यार.<verse eid="ACT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18" />ना तान दासगोळ अदिक तान दासीगोळ मा भी</para>
  <para style="q2" vid="ACT 2:18">आ दिनगोळ दा तान आत्मा दा टु हाक्‍काईन,</para>
  <para style="q2" vid="ACT 2:18">अदिक आंदुर परमेश्वर उन दी टु बातणी कोट्टार.<verse eid="ACT 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19" />अदिक ना म्याकुच आकाश मा अदभुत क्याल्सा</para>
  <para style="q2" vid="ACT 2:19">अदिक ल्यालमा पृथ्वी मा चमत्कारगोळी तोर्साईन,</para>
  <para style="q1" vid="ACT 2:19">मतलब खुन अदिक बेक्‍की अदिक धुंगा अन्द बादल तोरसाईन.<verse eid="ACT 2:19" /></para>
  <para style="q2">
    <verse number="20" style="v" sid="ACT 2:20" />प्रभु उन महान अदिक तेजस्वी दिन इन बरोर</para>
  <para style="q2" vid="ACT 2:20">से पयले सुर्य करीद अदिक चंद्र खुन घाई क्याचांद</para>
  <para style="q2" vid="ACT 2:20">आगेदीत.<verse eid="ACT 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21" />अदिक जो यावारा परमेश्वर उन हेसुर देल प्रार्थना माळ्यान, आऊन उद्धार आदीत.<verse eid="ACT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />हे इस्त्राएलगोळा, ई मातगोळी केळी: यीशु नासरी ऊंद मंळसा ईरोन यार्द परमेश्वर उन दी टु आगोद प्रमाण आ सामर्थ्य अन्द क्याल्सागोळ अदिक आश्चर्य अन्द क्याल्सागोळ अदिक चमत्कारगोळ देल प्रगट आद, जो परमेश्वर नीम न्याड्या आऊन द्वारा माळकु तोरस्यान यदरी नीव खुद अच अरूतीर. <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" /><note caller="+" style="x"><char style="xo" closed="false">२:२३ </char><char style="xt" closed="false"><ref loc="MAT 27:35">मत्ती २७:३५</ref>; <ref loc="MRK 15:24">मरकुस १५:२४</ref>; <ref loc="LUK 23:33">लूका २३:३३</ref>; <ref loc="JHN 19:18">यूहन्ना १९:१८</ref></char></note>अदिक नीव आवा यीशु उक, जो परमेश्वर उन ठहरूस्द योजना अदिक पूर्व ग्यान इन अनुसार हुळसुसकु आदुन, नीव अन्यायीगोळ्द कय देल क्रूस मा येरसुसकु कोंद बुट्टीर. <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" /><note caller="+" style="x"><char style="xo" closed="false">२:२४ </char><char style="xt" closed="false"><ref loc="MAT 28:5">मत्ती २८:५</ref>,<ref loc="MAT 28:6">६</ref>; <ref loc="MRK 16:6">मरकुस १६:६</ref>; <ref loc="LUK 24:5">लूका २४:५</ref></char></note>लेकीन आऊका परमेश्वर मृत्यु उन बंधन दा टु बिळ्सकु जित्‍ता माळदुन; यतिकी ईद अशक्य ईरोद कि यीशु परमेश्वर उन वश दा ईरायदुन. <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />यतिकी दाऊद आऊन बारा दा अनतान,</para>
  <para style="q1" vid="ACT 2:25">ना परमेश्वर उक हमेशा तान मुंद नोळतेला ईत्‍तीन:</para>
  <para style="q2" vid="ACT 2:25">यतिकी आव नांद ऊम्मा कय दी आन, कि नान मनोबल कम आगेगबाळुल.<verse eid="ACT 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26" />ईदा कारण नान मन खुश आत,</para>
  <para style="q2" vid="ACT 2:26">अदिक नान ल्यालग्या मग्न आत;</para>
  <para style="q1" vid="ACT 2:26">उलटा नान मय इक भी</para>
  <para style="q2" vid="ACT 2:26">आशा देल आराम सिक्‍कीत.<verse eid="ACT 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27" />यतिकी नी नान जीव इक मृत्यु अन दुनिया दा बिळतीदील;</para>
  <para style="q2" vid="ACT 2:27">अदिक ना तान पवित्र जनगोळी कब्रगोळ दा हुळु गोट्या.<verse eid="ACT 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28" />नी नानी जीवन इन हादी हेळ्या;</para>
  <para style="q2" vid="ACT 2:28">नी नानी तान दर्शन इन द्वारा खुशी देल तुम बुट्या.<verse eid="ACT 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />हे वार्टुरा, ना नाम पुर्वज दाऊद उन बारा दा नीम से हिम्मत देल अन सकतीन कि आव रा सोतोदुन अदिक नळ्सकु भी आदुन लेकीन आऊन कब्र ईंद भी नाम अल उपस्थित आद. <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />यतिकी आव परमेश्वर उन दी टु बातणी तरावाळा ईरोन, आव जानसोन कि परमेश्वर नान से हिंग किर्‍या तिंदान कि ना नींद वंश दा टु ऊंद मंळसा अक नीन सिंहासन मा कुरसाईन; <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />आव आगावाळा मात इक पयले टु अच नोळकु मसीह अन्द जित्‍ता आगोद बारा दा भविष्यवाणी माळदुन कि ना रा आऊन जीव</para>
  <para style="q1" vid="ACT 2:31">मृत्यु अन्द दुनिया दा बिटकु आदीत अदिक</para>
  <para style="q2" vid="ACT 2:31">ना आऊन मय हुळतित.<verse eid="ACT 2:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="ACT 2:32" />ईवा यीशु उक परमेश्वर सोत्‍तुर दा टु जित्‍ता माळदुन, यार्द नाव सप्पा मुंदुर गवाह आयेव. <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />ई प्रकार आव नेगुकु आदुन अदिक परमेश्वर उन उजवा कय देल सर्वोच्च पद ताकोमकु, अदिक आप्प से अद पवित्र आत्मा हासिल माळकु यदुर्द वादा माळकु आगीत, आव ईद रिचुस बुटान जो नीव नोळतीर अदिक केळतीर. <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />यतिकी दाऊद रा स्वर्ग मा येरीदिल; लेकीन आव खुद अनतान,</para>
  <para style="q1" vid="ACT 2:34">प्रभु नान परमेश्वर से अंदुन,</para>
  <para style="q2" vid="ACT 2:34">नान ऊमा कय दी कुर,<verse eid="ACT 2:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ACT 2:35" />यागासताका कि ना नीन से दुश्मनी ईटावाळेर इक नीन काल दिशी तनकु आंदरी नीन काल इन आशन माळ कोमालीन.<verse eid="ACT 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36" />“इदुरसाटी ईग इस्त्राएल इन सप्पा घराना निश्चित रूप देल अर्त कोमुल कि परमेश्वर आवा यीशु अक यारी नीव क्रूस मा येर्सदिर, प्रभु भी ठहरूसदुन अदिक मसीह भी.”<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />आग केळावाळेर मन तुम्मेदव, अदिक आंदुर पतरस अदिक मिक्‍कु प्रेरितगोळ से केळली कुरतुर, “हे वार्टुरा, नाव येन माळेव?”<verse eid="ACT 2:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38" />पतरस आंदुर से अंदुन, “मन तिर्गुसी, अदिक नीम दा टु हर ऊंद मंळसा तान-तान पापगोळ्द माफ अन्द साटी यीशु मसीह अन्द हेसुर देल बपतिस्मा ताकोम; रा नीमी पवित्र आत्मा अन्द दान सिक्‍कीत. <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />यतिकी ईद वादा नीम, अदिक नीम औलादगोळ, अदिक आ सप्पा दुर-दुर इन लॉकुर साटी भी हुन यारी प्रभु नाम परमेश्वर तान हात्‍ती कारस्यान.”<verse eid="ACT 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40" />आव मात्‍त हापाळ मातगोळ देल भी गवाही कोट कोटकु समजुसदुन कि “तान-तान इक ई बेकार पीढ़ी देल ऊळ्सकु ईटी.” <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />इदुरसाटी यार आऊन वचन ग्रहण माळदुर आंदुर बपतिस्मा ताकोंडुर; अदिक अदा दिशी मुर हजार मंळसागोळ हात्‍तीपास आंदुर्दा जमा आगेदुर. <verse eid="ACT 2:41" /><verse number="42" style="v" sid="ACT 2:42" />अदिक आंदुर प्रेरितगोळ से शिक्षा ताकोमली, अदिक संगत ईटली, अदिक भोजन माळली, अदिक प्रार्थना माळदुर दा मग्न ईरतोगोर.<verse eid="ACT 2:42" /></para>
  <para style="s">विश्वासीगोळ्द जीवन</para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43" />अदिक सप्पा लॉकुर मा अंज्क तुम्मेत, अदिक हापाळ सा अदभुत क्याल्सा अदिक चमत्कार प्रेरितगोळ द्वारा प्रगट आगतोगोव. <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" /><note caller="+" style="x"><char style="xo" closed="false">२:४४ </char><char style="xt" closed="false"><ref loc="ACT 4:32-35">प्रेरितगोळ ४:३२-३५</ref></char></note>अदिक सप्पा विश्वास माळावाळेर ऊंदा ऊज्या जमा ईरतोगोर, अदिक आंदुर सप्पा वस्तुगोळ गुट दा ईरव. <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />आंदुर तान-तान सम्पत्ति अदिक सामान मार मारकु यार्द ह्यांग जरवत ईरतोगोद वाट्सतोगोर. <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />आंदुर हर दिशी ऊंद मन आगकु मंदिर दा ऊंदा ऊज्या जमा आगतोगोर, अदिक मानोन मान्नी खुशी अदिक पवित्र मन देल ऊमतोगोर, <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />अदिक परमेश्वर उन स्तुति माळतोगोर, अदिक सप्पा लॉकुर आंदुर से खुश ईरोर: अदिक यारी उद्धार सिकतोगोद, आंदरी प्रभु हर दिशी आंदुर दा जमा माळ बुळतोगोन.<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s">लंगळा भीख बेळावाळा अन्द वळ्लीद आगोद</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />पतरस अदिक यूहन्ना मदणी अन्द मुर मुरा प्रार्थना अन्द होती आंदुर म्याकुच मंदिर दी होगोर. <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />अदिक लॉकुर ऊंद पैयदायसी लंगळा अक तरोर, यारी आंदुर रोज मंदिर इन आ दरवाजा मा यदरी सुंदर अंदकु आगतद, कुर्स बुळतोगोर कि आव मंदिर दा होगावाळेर से भीख बेळ सकुल. <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />याग आव पतरस अदिक यूहन्ना अक मंदिर दा होग्त नोळदुन, रा आंदुर से भीखा बेळदुन. <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />पतरस यूहन्ना अन्द सांगुळ आऊन दी ध्यान देल नोळकु अंदुन, “नाम दी नोळ!” <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />इदुरसाटी आव आंदुर से येनारा ताकोमोद लालसा ईटतेला आंदुर दी तार हचकु नोळली कुरतुन. <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />लेकीन पतरस अंदुन, “व्हान्ना बेळ्ली रा नान हाती हैलेच, लेकीन जो नान हाती आद अद नीनी कोळतीन; यीशु मसीह नासरी इन हेसुर देल नळु अदिक ओयाळ.” <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />अदिक पतरस आऊन ऊमा कय हुडुकु आऊक नेगदुन; अदिक तुरन्त आऊन कालगोळ अदिक ट्वांगरागोळ दा जोर होट बत्‍त. <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />आव यदकु निदरेदुन अदिक नळुली कुरतुन; अदिक नळुतेला, हारतेला अदिक परमेश्वर उन स्तुति माळतेला आंदुर सांगुळ मंदिर दा होदुन. <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />सप्पा लॉकुर आऊक नळुत टेटाळ्त अदिक परमेश्वर उन स्तुति माळ्त नोळकु, <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />आऊक अर्त कोंडुर कि ईव आवा हुन जो मंदिर इन सुंदर फाटक मा कुर्तकु भीखा बेळतोगोन; अदिक आ घटना देल जो आऊन सांगुळ आगीत आंदुर हापाळ अचम्भित अदिक चकित आदुर.<verse eid="ACT 3:10" /></para>
  <para style="s">मंदिर दा पतरस उन उपदेश</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />याग आव पतरस अदिक यूहन्ना अक हुडुकु ईरोन, रा सप्पा लॉकुर हापाळ आश्चर्य माळतेला आ छपर्या दा यदरी सुलैमान उन छपर्या अंदकु आगतद, आंदुर हाती ओळतेला बंदुर. <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />ईद नोळकु पतरस लॉकुर से अंदुन, “हे इस्त्राएलगोळा, नीव ई मंळसा मा येती आश्चर्य माळेतीर, अदिक नाम दी हिंग येती नोळेतीर जसा नाव अच तान सामर्थ्य या भक्ति देल ईऊक नळोद अदिक टेटाळोद लायक माळ बुटेव. <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />अब्राहम अदिक इसहाक अदिक याकूब उन परमेश्वर, नाम आप्प दादागोळ परमेश्वर तान सेवक यीशु उन महिमा माळदुर, यारी नीव हुळसुस बुट्टीर, अदिक याग पिलातुस आऊक बिळोद विचार माळदुन, आग नीव आऊन मुंद आऊन इनकार माळदीर. <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" /><note caller="+" style="x"><char style="xo" closed="false">३:१४ </char><char style="xt" closed="false"><ref loc="MAT 27:15-23">मत्ती २७:१५-२३</ref>; <ref loc="MRK 15:6-14">मरकुस १५:६-१४</ref>; <ref loc="LUK 23:13-23">लूका २३:१३-२३</ref>; <ref loc="JHN 19:12-15">यूहन्ना १९:१२-१५</ref></char></note>नीव आ पवित्र अदिक न्यायी मंळसा अन्द इनकार माळदीर, अदिक विनती माळदीर कि ऊंद हत्यारा अक नीम साटी बिटकु आगेगुल; <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />अदिक नीव जीवन इन कर्ता धर्ता अक कोंद बुट्टीर, यारी परमेश्वर सोत्‍तुर दा टु जित्‍ता माळदुन; अदिक ई मात इन गवाह नाव आयेव. <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />अदिक आऊंदा हेसुर, आ विश्वास इन द्वारा जो आऊन हेसुर मा आद, ई मंळसा अक यारी नीव नोळतीर अदिक अरूतीर सामर्थ्य कोटान. अदा विश्वास जो आऊन द्वारा आद, ईऊक नीम सप्पा मुंदुर मुंद बिलकुल भला चंगा माळ बुटान.<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />“ईग हे वार्टुरा, नानी मालूम आद कि ईद क्याल्सा नीव अग्यानता दा माळदीर, अदिक हांगा नीम अधिकारीगोळ भी माळदुर. <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />लेकीन याता मातगोळी परमेश्वर सप्पा भविष्यवक्तागोळ बाय देल पयले अच हेळ बुटीदुन, कि आऊन मसीह दुख नेगदान, अवरी आव ई रीति देल पुरा माळदुन. <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />इदुरसाटी, मन तिर्गुसी अदिक वापस बरी कि नीम पाप माफ माळकु आदव, <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />ताकी आत्मिकता शांती इन समय प्रभु उन देल बरूल अदिक आव यीशु अक कळुल जो नीम साटी पयले टु ना मसीह ठहरूस्कु आग्यान, <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />जरूरी आद कि आव स्वर्ग दा आ समय ताका ईरूल यागासताका कि आव सप्पा मातगोळ्द सुधार माळ कोमालुन यदुर्द चर्चा स्याणा लॉकुर काल टु परमेश्वर तान पवित्र भविष्यवक्तागोळ बाय देल माळ्यान. <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" /><note caller="+" style="f"><char style="fr" closed="false">३:२२ </char><char style="ft" closed="false">व्यवस्थाविवरण १८:१५,१८ </char></note> ह्यांग कि मूसा अंदुन, ‘प्रभु परमेश्वर नीम वार्टुर दा टु नीम साटी नान घाई ऊंद भविष्यवक्ता पैदा माळ्यान, जो येनारा आव नीम से अंदान, नीव आऊन केळी. <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />लेकीन हर ऊंद मंळसा जो आ भविष्यवक्ता अन्द केळतीदिल, परमेश्वर उन लॉकुर दा टु ब्यार्र माळकु नाश माळकु आदान.’ <verse eid="ACT 3:23" /><verse number="24" style="v" sid="ACT 3:24" />अदिक शमूएल इन हात्‍ती टु हुडुकु रा आऊन बादवाळेर ताका यास भविष्यवक्ता माताळदुर आ सप्पा ई दिनगोळ बारा दा बातणी कोटार. <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />नीव भविष्यवक्तागोळ औलाद अदिक आ वादा अन भागी हुईर, जो परमेश्वर नीम आप्प दादागोळ से कटदुन, याग आव अब्राहम से अंदुन, ‘नीन घराना अन्द द्वारा पृथ्वी इन सप्पा लॉकुरी आर्शिवाद सिक्‍कीत.’ <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />परमेश्वर तान सेवक उक नेगुकु पयले नीम हात्‍ती कळुदुन, कि नीम दा टु हर ऊंद मंळसा अक आऊन बुराईगोळ देल तिर्गुसकु आर्शिवाद कोळुल.”<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s">महासभा अन मुंद पतरस अदिक यूहन्ना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />याग पतरस अदिक यूहन्ना लॉकुर से ईद अनोर, रा याजक अदिक मंदिर इन रखवाली माळावाळेर्द शासक अदिक सदूकी आंदुर मा येरकु बंदुर. <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />यतिकी आंदुर हापाळ सिट्टी बंदुर कि पतरस अदिक यूहन्ना लॉकुरी उपदेश कोळतेला यीशु उन सोत्‍तुर दा टु जित्‍ता आगोद द्वारा अदिक यीशु उन उदाहरण कोट कोटकु सोत्‍तुर दा टु जीत्‍ता आगोद प्रचार माळतोगोर. <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />आंदुर आंदरी हुडुकु दुसरा दिन ताका जयल दा ईटदुर यतिकी द्याव मुळकेगित. <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />लेकीन वचन इक केळावाळेर दा टु हापाळ मुंदुर विश्वास माळदुर, अदिक आंदुर गिनती अईद हजार मंळसागोळ्द हात्‍तीपास आगेत.<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />दुसरा दिशी यरूशलेम दा यहूदी अधिकारीगोळ अदिक स्याणा लॉकुर अदिक न्यायशास्त्र अन्द गुरुगोळ, <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />अदिक महायाजक हन्ना अदिक कैफा अदिक यूहन्ना अदिक सिकन्दर अदिक यास महायाजक इन घराना नोर ईरोर, सप्पा यरूशलेम दा जमा आदुर. <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />आंदुर पतरस अदिक यूहन्ना अक न्याड्या निदरूसकु केळली कुरतुर कि “नीव ईद क्याल्सा याता सामर्थ्य देल अदिक याता हेसुर देल माळीर.”<verse eid="ACT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8" />आग पतरस पवित्र आत्मा देल परिपुर्ण आगकु आंदुर से अंदुन, “हे लॉकुर्दव अधिकारी अदिक स्याणा लॉकुरा. <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />ई लंगळा मंळसा अन्द सांगुळ जो भलाई माळकु आग्याद, अगर ईंद नाम से आऊन बारा दा केळकु आगतद, कि आव ह्यांग वळ्लेव आदुन. <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />रा नीव सप्पा अदिक पुरा इस्त्राएली लॉकुर जान्स कोमी कि यीशु मसीह नासरी इन हेसुर दा जो सामर्थ्य आद अदुर द्वारा ई लंगळा मंळसा नीम मुंद भला चंगा निदुरकु आन, या यीशु अक नीव क्रूस मा येर्सदिर, अदिक परमेश्वर सोत्‍तुर दा टु जित्‍ता माळदुन. <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />शास्त्र दा लिख्सकु आद, ईव यीशु अदा कल्ल हुन यारी नीव राजमिस्त्रीगोळ बेकार मान्सदिर अदिक</para>
  <para style="q2" vid="ACT 4:11">आव हापाळ महत्वपुर्ण कल्ल आगेदुन.<verse eid="ACT 4:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ACT 4:12" />यावारा दुसरा अन्द द्वारा उद्धार ईला; यतिकी स्वर्ग इन ल्यालमा मंळसागोळ दा अदिक यातोदु दुसरा हेसुर कोटकु आगीदील, यार्द द्वारा नामी उद्धार सिकुल.”<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />याग आंदुर पतरस अदिक यूहन्ना अन्द हिम्मत नोळदुर, अदिक ईद अरतुर कि इंदुर अनपढ़ अदिक साधारण मंळसा आर, रा आश्चर्य माळदुर; बाक आंदरी अरतुर, कि इंदुर यीशु उन सांगुळ ईतार. <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />आ लंगळा मंळसा अक जो वळ्लेव आगीदुन, पतरस अदिक यूहन्ना अन्द सांगुळ निदुर्त नोळकु, आंदुर विरोध दा येनु अन सकिदील. <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />लेकीन आंदरी सभा अन्द व्हार्या होगोद आग्या कोटकु, आंदुर तांदुर दा विचार माळली कुरतुर, <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />अदिक अनली कुरतुर, “नाव ई मंळसागोळ सांगुळ येन माळेव? यतिकी यरूशलेम इन सप्पा ईरावाळेर मा प्रगट आद, कि इंदुर द्वारा ऊंद प्रसिद्ध चमत्कार तोर्सकु आग्याद, अदिक नाव अदुर्द इनकार माळ सकालेव. <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />इदुरसाटी कि ई मात लॉकुर दा मात्‍त यक्कुल फैलुस बाळुल, नाव आंदरी धमकुसेव, कि आंदुर यीशु उन हेसुर देल बाक यातोदु मंळसा से मातगोळी हेळतीदील.”<verse eid="ACT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18" />आग आंदुर पतरस अदिक यूहन्ना अक कारदुर अदिक चेतावनी कोटकु ईद अंदुर, “यीशु उन हेसुर देल येनु अच माताळ बाळेतीर अदिक कल्स बाळेतीर.” <verse eid="ACT 4:18" /><verse number="19" style="v" sid="ACT 4:19" />लेकीन पतरस अदिक यूहन्ना आंदरी उत्‍तर कोट्टुर, “नीवा न्याय माळी; येन ईद परमेश्वर उन नजर दा भला आद कि नाव परमेश्वर उन मात से यक्कुल नीम मात केळेव. <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />यतिकी ईद रा नाम से आगसकाल कि जो नाव नोळेव अदिक केळेव, अद अनतीदिल.” <verse eid="ACT 4:20" /><verse number="21" style="v" sid="ACT 4:21" />आग आंदुर आंदरी मात्‍त यक्कुल धमकी कोटकु बिट बुटुर, यतिकी आंदरी समझ दा बंदिदील कि आंदरी ह्यांग दण्ड कोट्टेव, यतिकी जो घटना आगीत अदुर कारण सप्पा लॉकुर परमेश्वर उन बळाई माळतोगोर. <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />आ लंगळा मंळसा, यार मा ईद चंगाई इन चमत्कार तोर्सकु आगीत, चालीस साल से यक्कुल उमर ईनव ईरोन.<verse eid="ACT 4:22" /></para>
  <para style="s">विश्वासीगोळ्द साटी हिम्मत इन प्रार्थना</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />पतरस अदिक यूहन्ना बिटकु तान संगीगोळ हात्‍ती बंदुर, अदिक जो येनारा प्रधान याजकगोळ अदिक स्याणा लॉकुर आंदुर से अंदीदुर, आंदरी केळ्स बुटुर. <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />ईद केळकु विश्वासीगोळ ऊंद मन आगकु धोळ्द आवाज देल परमेश्वर से अंदुर, हे स्वामी, नी आवा हुय याव स्वर्ग अदिक पृथ्वी अदिक समुद्र अदिक जो येनारा अऊर्दा आद माळ्या. <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />नी पवित्र आत्मा अन द्वारा तान सेवक नाम पुर्वज दाऊद उन बाय देल अंद, गैरयहूदीगोळ हल्ला येती मचुसदुर? अदिक द्याश-द्याश इन लॉकुर</para>
  <para style="q2" vid="ACT 4:25">येती बिना मतलब इन मातगोळ्द विचार माळदुर?<verse eid="ACT 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26" />प्रभु अदिक आऊन मसीह अन्द विरोध दा</para>
  <para style="q2" vid="ACT 4:26">पृथ्वी इन राजा निदुरदुर,</para>
  <para style="q2" vid="ACT 4:26">अदिक अधिकारीगोळ ऊंद सांगुळ जमा आगेदुर.<verse eid="ACT 4:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ACT 4:27" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:२७ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 23:7-11">लूका २३:७-११</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:1">मत्ती २७:१</ref>,<ref loc="MAT 27:2">२</ref>; <ref loc="MRK 15:1">मरकुस १५:१</ref>; <ref loc="LUK 23:1">लूका २३:१</ref>; <ref loc="JHN 18:28">यूहन्ना १८:२८</ref>,<ref loc="JHN 18:29">२९</ref></char>
    </note>यतिकी खराखुरा नीन पवित्र सेवक यीशु उन खिलाप दा, यार्द नी अभिषेक माळ्द, हेरोदेस अदिक पुन्तियुस पिलातुस भी गैरयहूदीगोळ अदिक इस्त्राएलीगोळ सांगुळ ई नगर दा जमा आदुर, <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />आंदुर जमा आदुर यतिकी नीन ताकत अदिक इच्छा अन अनुसार जो येनारा पयले अच निश्चित आगेगीत अद पुरा आगुल. <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />ईग हे प्रभु, आंदुर धमकीगोळी नोळ; अदिक तान दासगोळी ईद इजाजत कोळ कि नीन वचन हापाळ हिम्मत देल केळसुल. <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />चंगा माळोर साटी नी तान कय मुंद माळ कि चमत्कार अदिक अदभुत क्याल्सा नीन पवित्र सेवक यीशु उन हेसुर देल माळकु आगुल.<verse eid="ACT 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31" />याग आंदुर प्रार्थना माळ कोंडुर, रा अद जागा यल आंदुर जमा ईरोर हालुसेत, अदिक आंदुर सप्पा मुंदुर पवित्र आत्मा देल परिपुर्ण आगेदुर, अदिक परमेश्वर उन वचन हिम्मत देल केळ्सतेला ईत्‍तुर.<verse eid="ACT 4:31" /></para>
  <para style="s">विश्वासीगोळ्द एकता अन जीवन</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:३२ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 2:44">प्रेरितगोळ २:४४</ref>,<ref loc="ACT 2:45">४५</ref></char>
    </note>विश्वास कळावार्ळेद मंडली ऊंद चित्त अदिक ऊंद मन इन ईरोद, ईल ताका कि यावारा भी तान धन सम्पत्ति तान ईला अनतोगोन, लेकीन सप्पा येनारा गुट दा ईरोद. <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />प्रेरित बळा सामर्थ्य देल प्रभु यीशु उन जित्‍ता आगोद गवाही कोळ्त ईत्‍तुर अदिक आ सप्पा मुंदुर मा हापाळ अनुग्रह ईरोद. <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />आंदुर दा याऊ भी गरीब बेळावाळा ईला ईरोन; यतिकी यार्द हात्‍ती जागा अदिक मान्नागोळ ईरव, आंदुर अवरी मार-मोटकु, मार्द वस्तुगोळ्द दाम तरोर, <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />अदिक अवरी प्रेरितगोळ्द कालगोळ मा ईटतोगोर; अदिक ह्यांग यारी जरवत ईरतोगोद, अदुर अनुसार हर ऊंद मंळसा अक कोट बुळतोगोर.<verse eid="ACT 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36" />यूसुफ हेसुर ईनव साइप्रस नगर इन ऊंद लेवी ईरोन यार्द हेसुर प्रेरितगोळ बरनबास मतलब हिम्मत कोळावाळा ईटीदुर. <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />आऊन थ्वाळासा जागा जमीन ईरोद, यदरी आव मारदुन, अदिक दाम इन पैस्या तनकु प्रेरितगोळ्द कालगोळ मा ईट बुटुन.<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s">हनन्याह अदिक सफीरा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />हनन्याह हेसुर इन ऊंद मंळसा ईरोन, अदिक आव तान हिंग्स सफीरा अन सांगुळ तान थ्वाळासा जागा मारदुन. <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />अदिक आव आ जागा अन दाम दा टु थ्वाळासा पैस्या ईट बुटुन; अदिक ईद मात आऊन हिंग्स भी जानसोर, अदिक अदुर मिग्द भाग तनकु प्रेरितगोळ्द कालगोळ मुंद ईट बुटुन. <verse eid="ACT 5:2" /><verse number="3" style="v" sid="ACT 5:3" />पतरस अंदुन, “हे हनन्याह! शैतान नीन मन दा ईद मात ह्यांग हाक्त कि नी पवित्र आत्मा से ख्वाटा माताळ्या, अदिक जागा अन दाम दा टु येनारा ईट्या? <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />यागासताका अद नीन हात्‍ती ईत्‍त, येन अद जागा अपमान ईतीदील? अदिक याग अद मारेत रा येन अदुर किमत नीन अधिकार दा ईला ईरोद? अदिक नी ई मात इन तान मन दा येती बिचार माळ्द? नी मंळसागोळ से ईला, लेकीन परमेश्वर से ख्वाटा माताळ्द.” <verse eid="ACT 5:4" /><verse number="5" style="v" sid="ACT 5:5" />ई मातगोळ केळकु हनन्याह बिदोदुन अदिक जीव बिट बुटुन, अदिक सप्पा केळावाळेर मा धोळ्द अंज्क तुम्मेत. <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />बाक हारोद मंळसागोळ यदकु आऊन सकोली तयार माळदुर अदिक आऊन लाश व्हार्या ओतकु नळ्स बुटुर.<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />लगभग मुर तास इन बाद्दा आऊन हिंग्स, जो येनारा आगीत ईला जान्सकु, बुळ्क बंदुर.<verse eid="ACT 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 5:8" />आग पतरस आकिन से अंदुन, “नानी हेळ येन नीव अद जागा इटुर दा अच मार बुटीदीर?” आक अंदुर, “हव, इटुर दा अच.”<verse eid="ACT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9" />पतरस आकिन से अंदुन, “ईद येन मात हुन कि नीव येढ्ढु मुंदुर प्रभु अन्द आत्मा अन परीक्षा साटी ऊंद मन माळदीर? नोळ, नीन गांड्ड उक नळसावाळेर दरवाजा मा अच निदुरकु आर, अदिक नीनी भी व्हार्या ओतार.” <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />आग आक तुरन्त आऊन कालगोळ मा बिद्दुर, अदिक सोतोदुर; अदिक हारोद मंळसागोळ बुळ्क बंदकु आकी सोतकु नोळदुर, अदिक व्हार्या वोतकु आकिन गांड्ड उन हात्‍ती नळ्स बुटुर. <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />सप्पा मंडली मा अदिक ई मातगोळ्द सप्पा केळावाळेर मा धोळ्द अंज्क तुम्मेत.<verse eid="ACT 5:11" /></para>
  <para style="s">चमत्कार अदिक अदभुत क्याल्सा</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />प्रेरितगोळ्द कयगोळ देल हापाळ चमत्कार अदिक अदभुत क्याल्सा लॉकुर न्याड्या दा तोर्सकु आगतोगोव, अदिक आंदुर सप्पा ऊंद मन आगकु सुलैमान उन छपर्या दा जमा आगतोगोर. <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />लेकीन हापाळ दा टु यारीकु ईद हिम्मत ईला आगतोगोद कि आंदुर दा होगकु मिलुसेव; तरी लॉकुर आंदुर्द बळाई माळतोगोर. <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />विश्वास माळावाळेर हापाळ सा मंळसा अदिक आर्तेर मंडलीगोळ दा धोळ्द संख्या दा सिक्त ईत्‍तुर. <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />ईल ताका कि लॉकुर बिमारगोळी सळकगोळ मा तन तनकु, व्हर्सगोळ मा मिंग्स बुळतोगोर कि याग पतरस बंदान, रा आऊन सावली अच आंदुर दा टु यारदारा मा बिदोगुल. <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />यरूशलेम इन आसपास इन नगरगोळ से भी हापाळ लॉकुर बिमारगोळ अदिक अशुध्द आत्मागोळ्द सतुस्द लॉकुरी तन तनकु, जमा आगतोगोर, अदिक सप्पा वळ्लेर माळकु आगोर.<verse eid="ACT 5:16" /></para>
  <para style="s">प्रेरितगोळ्द गिरफ्तारी</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />आग महायाजक अदिक आऊन सप्पा संगी जो सदूकीगोळ्द पंथ नोर ईरोर, जलनखोरी देल तुम्मेदुर. <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />अदिक प्रेरितगोळी हुडुकु बंदीगृह दा बंद माळ बुटुर. <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />लेकीन ईळ्ल इक प्रभु उन ऊंद स्वर्गदूत बंदीगृह अन्द दरवाजा तेरूकु आंदरी व्हार्या तनकु अंदुन, <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />“होगी, मंदिर दा निदुरकु ई व्हाशोद जीवन इन सप्पा मातगोळ लॉकुरी केळसी.” <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />आंदुर ईद केळकु व्हातुर आगतेला अच मंदिर दा होगकु शिक्षा कोळली कुरतुर.</para>
  <para style="p" vid="ACT 5:21">लेकीन महायाजक अदिक आऊन साथीगोळ बंदकु इस्त्राएलगोळ सप्पा स्याणा लॉकुर्द पुरा सभा अक जमा माळदुर, अदिक बंदीगृह दा बातणी कळुदुर कि आंदरी तरूल. <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />लेकीन अधिकारीगोळ अल पोहचुस्कु आंदरी बंदीगृह दा नोळीदील, अदिक वापस बंदकु बातणी कोट्टुर, <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />“नाव बंदीगृह अक हापाळ सावधानी देल बंद माळकु, अदिक पहरेदारगोळी व्हार्या दरवाजागोळ मा निदुरकु नोळदेव; लेकीन याग तेरदेव, रा बुळ्क याऊ सिक्‍कीदील.” <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />याग मंदिर इन सरदार अदिक प्रधान याजक ई मातगोळी केळदुर, आंदरी समझ दा बंदीदिल कि प्रेरितगोळ्द येन आत अदिक ईग येन आदीत! <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />ईटुर दा यावारा बंदकु आंदरी हेळदुन, “नोळी, यारी नीव बंदीगृह दा बंद ईटीदीर, आ मंळसागोळ मंदिर दा निदुरकु लॉकुरी शिक्षा कोळेत्यार.” <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />आग सरदार, अधिकारीगोळ सांगुळ होगकु, आंदरी तंदुन, लेकीन ताकत देल ईला, यतिकी आंदुर लॉकुर से अंजतोगोर कि नाम मा पथराव माळबाळुल.<verse eid="ACT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27" />आंदुर प्रेरितगोळी तनकु महासभा अन्द मुंद निदुरूस बुटुर; अदिक महायाजक आंदुर से पूछताछ माळदुन, <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" /><note caller="+" style="x"><char style="xo" closed="false">५:२८ </char><char style="xt" closed="false"><ref loc="MAT 27:25">मत्ती २७:२५</ref></char></note>“येन नाव नीमी कठोर आग्या कोटीदील कि नीव ई हेसुर देल शिक्षा कोळ बाळेतीर? तरी भी नोळी, नीव सप्पा यरूशलेम इक तान शिक्षा देल तुम बुट्टीर अदिक आ मंळसा अन्द खुन नाम कुतक्या मा तरोद चाहासतीर.”<verse eid="ACT 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29" />आग पतरस अदिक दुसरा प्रेरितगोळ उत्‍तर कोट्टुर, “मंळसागोळ्द आग्या से वाळुसकु परमेश्वर उन आग्या अन्द पालन माळोद अच नाम्द कर्तव्य आद. <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />नाम आप्प दादागोळ्द परमेश्वर यीशु उक सोत्‍तुर दा टु जित्‍ता माळदुन, यारी नीव क्रूस मा येर्सकु कोंद बुटीदीर. <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />आऊक अच परमेश्वर शासक अदिक उद्धारकर्ता ठहरूस्कु, तान ऊमा कय मा नेग्द बुट्टुन, कि आव इस्त्राएलगोळी मन तिर्गुसोद ताकत अदिक पापगोळ्द माफ प्रदान माळुल. <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />नाव ई मातगोळ गवाह आयेव अदिक हांगा पवित्र आत्मा भी, यारी परमेश्वर आंदरी कोटान जो आऊन आग्या मान्सतार.”<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />ईद केळकु आंदुर सिट्टी होट बंदुर, अदिक प्रेरितगोळी कोंद बुळोद चाहासदुर. <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />लेकीन गमलीएल हेसुर इन ऊंद फरीसी जो व्यवस्था अन शिक्षक अदिक सप्पा लॉकुर दा मानवाईक ईरोन, न्याय सभा दा निदुरकु प्रेरितगोळी थ्वाळासा समय इन साटी व्हार्या माळोद आग्या कोट्टुन. <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />आग आव अंदुन, “हे इस्त्राएलगोळा, नीव जो येनारा ई मंळसागोळ सांगुळ माळोद चाहासतीर, सोच विचार माळकु माळेतीर. <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />यतिकी ई दिनगोळ से पयले थियूदास ईद अनतेला अच विद्रोह अन्द झंडा नेगदीदुन, कि ना भी येनारा आईन; अदिक कम से कम नाक सौ मंळसा आऊन सांगुळ आगेदुर, लेकीन आव कोन्सुसकु आदुन अदिक यास लॉकुर आऊक मान्सतोगोर, सप्पा तितर बितर आदुर अदिक मिट्सेदुर. <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />अदुर बाद्दा जनगणना अन्द दिनगोळ दा गलील दा ईरावाळा यहूदा विद्रोह दा ताल्ला नेगदुन, अदिक थ्वाळासा लॉकुरी तान दी माळ कोंडुन; अदिक आव भी नाश आगेदुन अदिक यास लॉकुर आऊक मान्सतोगोर, सप्पा तितर बितर आगेदुर. <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />इदुरसाटी ईग ना नीम से अनतीन, ई मंळसागोळ से दुर अच ईरी अदिक इंदरी होगगोळी; यतिकी अगर ईद न्याय या क्याल्सा मंळसागोळ दी टु आद आग रा मिटुसेदीत; <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />लेकीन अगर परमेश्वर उन दी टु आद, रा नीव आंदरी यागलु मिटुस सकतीदिल. ईलारा हिंग आगबाळुल कि नीव परमेश्वर से भी लळुसावाळेर ठहरूसी. आग सभा अन लॉकुर गमलीएल उन मात मान्स कोंडुर.” <verse eid="ACT 5:39" /><verse number="40" style="v" sid="ACT 5:40" />अदिक प्रेरितगोळी कार्सकु बळसुसदुर; अदिक ईद आदेश कोटकु बिट बुटुर कि यीशु उन हेसुर देल बाक यातोदु मात माळबाळेतीर. <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />प्रेरितगोळ ई मात देल खुश आगकु महासभा अन्द मुंदु टु अनतेला होटोदुर, कि नाव यीशु उन हेसुर इन साटी अपमानीत आगोद लायक रा ठहरूसदेव. <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />आंदुर रोज मंदिर दा अदिक मानोन मान्नी लगातार खुशखबरी इन प्रचार माळतोगोर अदिक कल्सतोगोर कि यीशु उच मसीह हुन.<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s">येळ सेवक</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />आ दिनगोळ दा चेलागोळ्द संख्या हापाळ वाळुसली कुर्त, आग गैरयहूदी भाषा माताळावाळेर इब्रानी भाषा मातावाळेर मा कुळकाळ माळली हतदुर, कि रोज इन दान दा नाम रांड्यागोळ्द बारा दा विचार माळकु आगाल्द. <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />आग आ हन्नेळ प्रेरितगोळ चेलागोळ्द मंडली इक तान हात्‍ती कारूकु अंदुर, “ईद ठीक हैलेच कि नाव परमेश्वर उन वचन बिटकु तिन्सदुर कुळ्सदुर स्यावा दा ईत्‍तेव. <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />इदुरसाटी, हे वार्टुरा अदिक आकतींगेरा, तान दा टु येळ मानवाईक मंळसागोळी जो पवित्र आत्मा अदिक बुद्धी देल परिपुर्ण आर, निवळुस कोमी, कि नाव आंदरी ई क्याल्सा मा ठहरूस बुटेव. <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />लेकीन नाव रा प्रार्थना दा अदिक वचन केळसोद सेवकाई दा हतकु ईत्‍तेव.”<verse eid="ACT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5" />ईद मात सप्पा मंडली इक वळ्लीद हत, अदिक आंदुर स्तिफनुस हेसुर इन ऊंद मंळसा अक जो विश्वास अदिक पवित्र आत्मा देल परिपुर्ण ईरोन, अदिक फिलिप्पुस, अदिक प्रुखुरूस, अदिक नीकानोर, अदिक तीमोन, अदिक परमिनास, अदिक अन्ताकिया वासी नीकुलाउस उक जो यहूदी मत दा होट्ट बंदीदुन, नीवळुस कोंडुर. <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />इंदरी प्रेरितगोळ्द मुंद निदरूसदुर अदिक आंदुर प्रार्थना माळकु आंदुर मा कय ईटदुर.<verse eid="ACT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7" />परमेश्वर उन वचन फैलुस्तेला होत अदिक यरूशलेम दा चेलागोळ गिनती हापाळ वाळुसेत; अदिक याजकगोळ्द ऊंद धोळ्द समाज ई मत इक मान्सावाळा आगेत.<verse eid="ACT 6:7" /></para>
  <para style="s">स्तिफनुस उन गिरफ्तारी</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />स्तिफनुस अनुग्रह अदिक सामर्थ्य देल परिपुर्ण आगकु लॉकुर दा धोळ धोड्डेव अदभुत क्याल्सा अदिक चमत्कार तोर्सतोगोन. <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />आग आ सभागृह दा टु जो लिबिरतीन इन कहलुसतोगोद, अदिक कुरेनी अदिक सिकन्दरिया अदिक किलिकिया अदिक आसिया अन लॉकुर दा टु थ्वाळासा लॉकुर यदकु स्तिफनुस से झगळा माळली हतदुर. <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />लेकीन आ ग्यान अदिक आ आत्मा अन्द यार देल प्रेरित आगकु स्तिफनुस मातगोळी माळतोगोन, आंदुर सामना माळ सकिदील. <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />इदुर मा आंदुर थ्वाळासा लॉकुरी भळकुसदुर जो अनली कुरतुर, “नाव ईऊक मूसा अदिक परमेश्वर उन विरोध दा तिरस्कार इन मातगोळी अनतेला केळेव.” <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />अदिक लॉकुर अदिक स्याणागोळ अदिक शास्त्रीगोळी भळकुसदुर अदिक आंदुर आऊक हुडुकु महासभा दा तंदुर. <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />अदिक ख्वाटा गवाह निदरूसदुर, आंदुर अंदुर, “ईव मंळसा ई पवित्र जागा अदिक व्यवस्था अन्द विरोध दा माताळोद बिळालुन. <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />यतिकी नाव आऊक ईद अनतेला केळेव कि ईवा यीशु नासरी ई मंदिर इक केळ्द बुट्टान, अदिक आ रीतीगोळी बदलुस बुट्टान जो मूसा नामी सोपस्यान.” <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />आग सप्पा लॉकुर जो सभा दा कुर्तकु ईरोर, स्तिफनुस मा नजर हाकदुर रा आऊन बाय स्वर्गदूत उन घाई नोळदुर.<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s">स्तिफनुस उन भाषण</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />आग महायाजक स्तिफनुस से अंदुन, “येन ई मातगोळ सही आव?”<verse eid="ACT 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2" />स्तिफनुस अंदुन, “हे वार्टुरा, अदिक आप्पगोळा केळी. नाम स्याणा अब्राहम हारान द्याश दा कुरोर से पयले मेसोपोटामिया दा ईरोन; रा तेजोमय परमेश्वर आऊक दर्शन कोट्टुन, <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />अदिक आऊन से अंदुन, ‘नी तान द्याश अदिक तान कुटुम्ब टु होटकु आ द्याश दा होग, यदरी ना नीनी तोरसाईन.’ <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />आग आव कसदियागोळ द्याश दा टु होटकु हारान द्याश दा होगकु कुरतुन. अब्राहम उन आप्प उन सोत्‍तुर बाद्दा परमेश्वर आऊक अल टु ई द्याश दा तनकु कुर्सदुन यदुर्दा ईग नीव कुरतीर, <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />अदिक आऊक येनारा मीरास मतलब काल ईटली भी आऊक जागा कोटीदील, लेकीन वादा माळदुन कि ना ईद द्याश नींद अदिक नीन बाद्दा नीन वंश इन कय दा माळ बुळाईन; लेकीन आ समय आऊन यातोदु औलाद भी ईला ईरोद. <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />अदिक परमेश्वर ईद अंदुन, ‘नीन औलाद इन लॉकुर दुसरा द्याश दा परदेशी आदार, अदिक लॉकुर आंदरी दास माळ्यार अदिक नाक सौ वर्ष ताका सतुस्कु आदार.’ <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />बाक परमेश्वर अंदुन, ‘या राष्ट्र इन आंदुर दास आदार, आंदरी ना दण्ड कोळाईन, अदिक इदुर बाद्दा आंदुर होटकु ईदा जागी नान स्यावा माळ्यार.’ <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />अदिक परमेश्वर आऊन से खतना अन्द वादा माळदुन; अदिक ईदा दशा दा इसहाक आऊन से पैदा आदुन अदिक आऊन जनम इन बाद्दा आठवा दिशी आऊन खतना माळकु आत; अदिक इसहाक से याकूब पैदा आदुन अदिक याकूब से हन्नेळ पारगोळ पैदा आदुर ईंदुर्द भी खतना माळकु आत आंदुर नाम कुलपती बन्सदुर.<verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />“कुलपतिगोळ यूसुफ से जलन माळकु आऊक मिस्त्र द्याश होगावाळेर इक मारदुर. लेकीन परमेश्वर आऊन सांगुळ ईरोन, <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />अदिक आऊक आऊन सप्पा दुखगोळ देल बिळ्सकु मिस्त्र अन्द राजा फिरौन उन नजर दा अनुग्रह अदिक बुद्धी प्रदान माळदुन, अदिक आव आऊक मिस्त्र मा अदिक तान सप्पा मान्ना मा शासक नियुक्त माळदुन. <verse eid="ACT 7:10" /><verse number="11" style="v" sid="ACT 7:11" />आग मिस्त्र अदिक कनान इन सप्पा द्याश दा अकाल बित्‍त; यदुर देल भारी दुखगोळ बंदव, अदिक नाम आप्प दादागोळी तिनली ईला सिकतोगोद. <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />लेकीन याकूब ईद केळकु कि मिस्त्र द्याश दा अनाज आद, नाम आप्प दादागोळी पयला घन कळुदुन. <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />दुसरा घन यूसुफ खुद इक तान वार्टुर मा प्रगट माळदुन अदिक यूसुफ उन जाती फिरौन उक मालूम आगेत. <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />आग यूसुफ तान आप्प याकूब अदिक तान सप्पा कुटुम्ब इक, जो पच्यात्‍तर मंळसा ईरोर, बातणी कळुदुन. <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />आग याकूब मिस्त्र दा ल्यालमा होदुन; अदिक अल आव अदिक आऊन चिकोर सोतोदुर. <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />आंदुर लाश शकेम नगर दा पोहचुस्कु आ कब्र दा ईटकु आदव, यारी अब्राहम चाँदी इन सिक्‍का कोटकु शकेम दा हमोर उन औलाद से कोंडीदुन.<verse eid="ACT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />“लेकीन याग आ वादा अन्द पुरा आगोद घळी हात्‍ती बत्‍त जो परमेश्वर अब्राहम से माळीदुन, रा मिस्त्र द्याश दा आ लॉकुर वाळुसेदुर अदिक हापाळ आगेदुर. <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />आग मिस्त्र दा दुसरा राजा आदुन जो यूसुफ उक ईला अरोन. <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />आव नाम जाती से चालाकी माळकु नाम आप्प दादागोळ सांगुळ ईल ताका बुरा व्यवहार माळदुन, कि आंदरी तान चिकोरी भीट बुळोर साटी मजबुर माळदुन. <verse eid="ACT 7:19" /><verse number="20" style="v" sid="ACT 7:20" />आ समय मूसा पैदा आदुन. आव परमेश्वर उन नजर दा हापाळ अच सुंदर ईरोन. आव मुर तिंगुळ ताका तान आप्प उन मान्या पालस्कु आदुन. <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />याग भिटकु आदुन रा फिरौन उन पोर आऊक नेगु कोंडुर, अदिक तान पार उन घाई पाल्सदुर. <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />मूसा अक मिस्त्रीगोळ सप्पा विद्या कल्सकु आत, अदिक आव वचन अदिक कर्म येढ्ढु दा ताकतवर ईरोन.<verse eid="ACT 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23" />“याग आव चालीस वर्ष इनव आदुन, रा आऊन मन दा बत्‍त कि ना इस्त्राएली वार्टुर से मुलाकात माळाईन. <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />आव ऊंद मंळसा मा अन्याय आग्त नोळकु आऊक ऊळ्सदुन, अदिक मिस्त्री इक कोंदकु अत्याचार माळ्द मंळसा अन्द बदला ताकोंडुन. <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />आव विचार माळदुन कि आऊन लॉकुर समस्यार कि परमेश्वर आऊन कयगोळ देल आंदुर्द उद्धार माळ्यान, लेकीन आंदुर समसीदील. <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />दुसरा दिशी याग आंदुर आपस दा झगळा माळोर, रा आव अल बंदुन; अदिक ईद अनकु आंदरी मिलुसोर साटी समजुसदुन, हे मंळसागोळा, आव अंदुन, ‘नीव रा वार्टुर-वार्टुर हुईर,’ आबुर दाबुर मा येती अन्याय माळतीर? <verse eid="ACT 7:26" /><verse number="27" style="v" sid="ACT 7:27" />लेकीन जो तान बाजुवाळा मा अन्याय माळोन, आव आऊक ईद अनकु हटुस बुटुन, ‘नीनी याव नाम मा अधिकार अदिक न्याय माळावाळा ठहरूस्यान? <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />येन याता रीति देल नी नीन मिस्त्री इक कोंद बुट नानी भी कोंद बुळोद चाहासत्या?’ <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />ईद मात केळकु मूसा ओळदुन अदिक मिद्यान द्याश दा परदेशी आगकु ईरली कुरतुन, अदिक अल आऊन येढ्ढ पारगोळ पैदा आदुर.<verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />“याग पुरा चालीस वर्ष बितसेदव, रा ऊंद स्वर्गदूत सीनै पहाळी इन आळी दा आऊक होततेला झाळी इन बेक्‍की अन लपेट दा दर्शन कोट्टुन. <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />मूसा अक ईद दर्शन नोळकु आश्चर्य आत, अदिक याग नोळोर साटी आव हात्‍ती होदुन, रा प्रभु अन्द ईद आवाज बत्‍त, <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />ना नीन आप्प दादागोळ, अब्राहम, इसहाक अदिक याकूब उन परमेश्वर हुईन. आग रा मूसा नळ्गली कुरतुन, ईल ताका कि आऊक नोळोद हिम्मत आगीदील. <verse eid="ACT 7:32" /><verse number="33" style="v" sid="ACT 7:33" />आग प्रभु आऊन से अंदुन, ‘तान कालगोळ दा टु केरू तेगु कोम, यतिकी याता जागा दा नी निदुरकु आय, अद पवित्र जागा हुन. <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />ना सचमुच तान लॉकुर्द जो मिस्त्र द्याश दा आर, दुर्दशा अक नोळीन; अदिक आंदुर्द आह अदिक आंदुर्द वोरलोद केळीन; इदुरसाटी आंदरी बिळसोर साटी ईळदीन. ईग बा, ना नीनी मिस्त्र द्याश दा कळाईन.’<verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />“या मूसा अक आंदुर ईद अनकु अस्वीकार माळीदुर, ‘नीनी यार नाम मा अधिकार अदिक न्याय माळावाळा ठहरूस्यार?’ आऊक अच परमेश्वर शासक अदिक बिळसावाळा ठहरूस्कु, आ स्वर्गदूत उन द्वारा यार आऊक झाळी दा दर्शन कोटीदुन, कळुदुन. <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />ईवा मंळसा मिस्त्र द्याश अदिक क्याचांद समुद्र अदिक आळी दा चालीस वर्ष ताका अदभुत क्याल्सा अदिक चमत्कार तोर्स तोर्सकु आंदरी तेगुकु तंदुन. <verse eid="ACT 7:36" /><verse number="37" style="v" sid="ACT 7:37" />ईव आवा मूसा हुन, याव इस्त्राएलगोळ से अंदुन, ‘परमेश्वर नीम वार्टुर दा टु नीम साटी नान घाई ऊंद बातणी तरावाळा नेगदान.’ <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />ईव आवा हुन, याव आळी दा मंडली अन न्याड्या आ स्वर्गदूत उन सांगुळ सीनै पहाळी मा आऊन से मातगोळी हेळदुन अदिक नाम आप्प दादागोळ सांगुळ ईरोन, आऊक अच जीवित वचन सिक्याव कि नाम ताका पोहचुसुल. <verse eid="ACT 7:38" /><verse number="39" style="v" sid="ACT 7:39" />लेकीन नाम आप्प दादागोळ आऊन मानसोद चाहसीदील, बल्‍की आऊक हटुस्कु तान मन मिस्त्र दी फेर्सदुर, <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />अदिक हारून से अंदुन, ‘नाम साटी हिंग देवता माळ, जो नाम मुंद-मुंद नळुल, यतिकी ईव मूसा जो नामी मिस्त्र द्याश टु तेगुकु तंदुन, नाव जानसालेव आऊक येन आग्याद?’ <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />आ दिनगोळ दा आंदुर ऊंद वस्ता अन घाई कांळ्सावाळा मूर्ति माळदुर, अदिक अदुर मा बली येर्सदुर, अदिक तान कयगोळ देल पाऊनचार माळकु खुशी मान्सदुर. <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />इदुरसाटी परमेश्वर अनदेखा माळकु आंदरी बिट बुटुन, कि आकाशगण इन पुजा माळुल, ह्यांग भविष्यवक्तागोळ किताब दा लिख्सकु आद, ‘हे इस्त्राएल इन घराना, येन नीव</para>
  <para style="q2" vid="ACT 7:42">आळी दा चालीस वर्ष ताका पशुबली अदिक अन्नबली</para>
  <para style="q2" vid="ACT 7:42">नान इक अच येर्सत ईत्‍तीर?<verse eid="ACT 7:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43" />नीव मोलेक इन तम्बू</para>
  <para style="q2" vid="ACT 7:43">अदिक रिफान देवता अन्द तारा अक हुडुकु टेटाळ तोगीर,</para>
  <para style="q2" vid="ACT 7:43">मतलब आ मूर्तिगोळी यारी नीव दण्डवत माळोर साटी माळदीर.</para>
  <para style="q1" vid="ACT 7:43">इदुरसाटी ना नीमी बेबीलोन इन हात्‍ती ओतकु कुरसाईन.’<verse eid="ACT 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />“नाम आप्प दादागोळ हात्‍ती परमेश्वर उन सानिध्य अन्द तम्बू, ह्यांग परमेश्वर मूसा अक हेळदुन हांग माळीदुन. अद आ नमुना अन घाई ईरोद जो मूसा अक तोर्सकु आगीत.” <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />अदा तम्बू अक नाम आप्प दादागोळ पूर्वकाल टु हुडुकु यहोशू अन्द सांगुळ ईल तंदुर; याता समय इन आंदुर आ गैरयहूदीगोळ मा अधिकार माळदुर, यारी परमेश्वर नाम आप्प दादागोळ मुंद टु तेगु बुट्टुन, अदिक अद तम्बू दाऊद उन समय ताका ईत्‍त. <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />आऊन मा परमेश्वर अनुग्रह माळदुन; इदुरसाटी आव विनती माळदुन कि आव याकूब उन परमेश्वर उन साटी निवास स्थान माळुल. <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />आव ईला लेकीन सुलैमान आऊन साटी मान्ना माळदुन.<verse eid="ACT 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48" />लेकीन परमप्रधान कय इन माळ्द मान्नागोळ दा ईरालुन, ह्यांग कि भविष्यवक्ता अंदुन,<verse eid="ACT 7:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49" />प्रभु अनतान, स्वर्ग नांद सिंहासन</para>
  <para style="q2" vid="ACT 7:49">अदिक पृथ्वी नान कालगोळ तल्ला अन्द आशन हुन,</para>
  <para style="q1" vid="ACT 7:49">नान साटी नीव याता प्रकार इन मान्ना माळीर?</para>
  <para style="q2" vid="ACT 7:49">अदिक नांद आराम इन साटी यातोद जागा ईत्‍तीत?<verse eid="ACT 7:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50" />येन ई सप्पा वस्तुगोळ नान कय इन माळदव आल्लच?<verse eid="ACT 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />“नीव याट जीद्दी आईर, अदिक मन अदिक किव इन खतनारहित लॉकुरा, नीव हमेशा पवित्र आत्मा अन्द विरोध माळतीर. ह्यांग नीम आप्प दादागोळ माळतोगोर, हांगा नीव भी माळतीर. <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />भविष्यवक्तागोळ दा टु यारी नीम आप्प दादागोळ सतुसीदील? आंदुर आ न्यायी अन्द आगमन इन पूर्वकाल टु बातणी कोळावाळेर इक कोंद बुटुर; अदिक ईग नीव भी आ न्यायी मंळसा अक हुळसुसावाळेर अदिक कोन्सुसावाळेर आदीर. <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />नीव स्वर्गदूतगोळ द्वारा ठहरूस्द व्यवस्था रा नोळदीर, लेकीन अदुर पालन माळदीर.”<verse eid="ACT 7:53" /></para>
  <para style="s">स्तिफनुस कल्लगोळ होळदुर देल सोत्‍तुन</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />ई मातगोळी केळकु आंदुर होत्‍तेदुर अदिक आऊन मा हल्ल कचली कुरतुर. <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />लेकीन आव पवित्र आत्मा से परिपुर्ण आगकु स्वर्ग दी नोळदुन अदिक परमेश्वर उन महिमा अक अदिक यीशु उक परमेश्वर उन ऊमा कय दी निदुर्त नोळकु अंदुन, <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />“नोळी, ना स्वर्ग इक तेरूत अदिक मंळसा अन पार उक परमेश्वर उन ऊमा कय दी निदुरकु नोळतीन.”<verse eid="ACT 7:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57" />आग आंदुर धोळ्द आवाज देल चिळ्लासकु किव बंद माळ बुटुर, अदिक सभा अन सभासदगोळ ऊंद सांगुळ आऊन मा झपट्टा होळदुर; <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />अदिक आऊक नगर इन व्हार्या तेगुकु आऊन मा कल्लगोळी होडुली कुरतुर. गवाहगोळ तान कपळा शाऊल हेसुर ईनव ऊंद हारोद मंळसा अन कालगोळ हात्‍ती तेगुकु ईट बुटुर. <verse eid="ACT 7:58" /><verse number="59" style="v" sid="ACT 7:59" />आंदुर स्तिफनुस मा कल्लगोळी होडुतेला ईत्‍तुर, अदिक आव ईद अनकु प्रार्थना माळतेला ईत्‍तुन, “हे प्रभु यीशु, नान आत्मा अक ग्रहण माळ.” <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />बाक ट्वांगरा टेक्सकु धोळ्द आवाज देल कारदुन, “हे प्रभु, ईद पाप आंदुर मा हचबाळ.” अदिक ईद अनकु आव सोतोदुन.<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />शाऊल आऊक कोन्नोर दा सहमत ईरोन.</para>
  <para style="s" vid="ACT 8:1">मंडली मा अत्याचार</para>
  <para style="p" vid="ACT 8:1">अदा दिशी टु यरूशलेम इन मंडली मा धोळ्द दुख इन सुरूवात आत अदिक प्रेरितगोळी बिटकु सप्पा अन्द सप्पा मुंदुर यहूदिया अदिक सामरीया द्याशगोळ दा तितर बितर आगेदुर. <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />येनारा भक्तगोळ स्तिफनुस उक कब्र दा ईटदुर अदिक आऊन साटी जोर जोर देल वर्लदुर.<verse eid="ACT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 8:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">८:३ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 22:4">प्रेरितगोळ २२:४</ref>,<ref loc="ACT 22:5">५</ref>; <ref loc="ACT 26:9-11">२६:९-११</ref></char>
    </note>शाऊल मंडली अक बरबाद माळोन; अदिक मानोन मान्नी होक्‍कु मंळसागोळी अदिक आर्तेर इक जेडु जेडुकु बंदीगृह दा हाक्‍क तोगोन.<verse eid="ACT 8:3" /></para>
  <para style="s">सामरीया दा फिलिप्पुस उन प्रचार</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />जो विश्वासी लॉकुर तितर बितर आगीदुर, आंदुर खुशखबरी केळ्सतेला टेटाळोर; <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />अदिक फिलिप्पुस ल्यालमा सामरीया नगर दा होगकु लॉकुर दा मसीह अन्द प्रचार माळली कुरतुन. <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />जो मातगोळी फिलिप्पुस अंदुन अवरी लॉकुर केळकु अदिक जो चमत्कार आव तोर्सतोगोन अवरी नोळ नोळकु, ऊंद चित्त आगकु मन हचदुर. <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />यतिकी हापाळ दा टु अशुध्द आत्मागोळ धोळ्द शब्द दा चिल्ळासतेला होट्ट बुटव, अदिक हापाळ सा लकवा अन्द रोगी अदिक लंगळागोळ भी वळ्लेर माळकु आदुर; <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />अदिक आ नगर दा धोळ्द खुशी छासेत.<verse eid="ACT 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />इदुर से पयले आ नगर दा शमौन हेसुर ईनव ऊंद मंळसा ईरोन, जो जादू टोना माळकु सामरीया अन्द लॉकुरी चकित माळतोगोन अदिक तान तान इक ऊंद धोळ्द मंळसा हेळतोगोन. <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />स्याणेर से धोड्डेर ताका सप्पा आऊंद सम्मान माळकु अनतोगोर, “ईव मंळसा परमेश्वर उन अद ताकत हुन, जो महान कहलुसतद.” <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />आव हापाळ दिनगोळ टु आंदरी तान जादू अन्द क्याल्सागोळ देल चकित माळकु ईटीदुन, इदुरसाटी आंदुर आऊक हापाळ मानसोर. <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />लेकीन याग आंदुर फिलिप्पुस उन बातणी इन विश्वास माळदुर जो परमेश्वर उन राज्य अदिक यीशु मसीह अन्द हेसुर इन खुशखबरी केळ्सतोगोन, रा लॉकुर, येन मंळसा, येन आर्तेर, बपतिस्मा ताकोमली कुरतुर. <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />आग शमौन खुद भी विश्वास माळदुन अदिक बपतिस्मा ताकोमकु फिलिप्पुस उन सांगुळ ईरली कुरतुन. आव धोड्डेव-धोड्डेव चमत्कार अदिक चमत्कार इन क्याल्सा आग्त नोळकु चकित आगतोगोन.<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />याग प्रेरितगोळ जो यरूशलेम दा ईरोर, केळदुर कि सामरीयागोळ परमेश्वर उन वचन मान्स कोंडार रा पतरस अदिक यूहन्ना अक आंदुर हाती कळुदुर. <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />आंदुर होगकु विश्वासीगोळ साटी प्रार्थना माळदुर कि पवित्र आत्मा सिक्‍कुल. <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />यतिकी ईगासताका आंदुर दा टु यारदु मा पवित्र आत्मा ईळदीदिल; आंदुर रा सिर्फ प्रभु यीशु अन्द हेसुर देल बपतिस्मा ताकोंडीदुर. <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />आग पतरस अदिक यूहन्ना आंदुर मा कय ईटदुर अदिक आंदरी पवित्र आत्मा सिक्त.<verse eid="ACT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18" />याग शमौन नोळदुन कि प्रेरितगोळ कय ईटदुर देल पवित्र आत्मा कोटकु आगतद, रा आंदुर हात्‍ती पैस्या तनकु अंदुन, <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />“ईद अधिकार नानी भी कोळी, कि जो यावारा मंळसा मा कय ईटाईन आऊक पवित्र आत्मा सिक्‍कुल.”<verse eid="ACT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20" />पतरस आऊन से अंदुन, “नीन पैस्या नीन सांगुळ नाश आगुल, यतिकी नी परमेश्वर उन दान पैस्यागोळ देल कोंड कोमोद विचार माळ्द. <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />ई मात दा ना नान हिस्सा आद, ना भाग; यतिकी नीन मन परमेश्वर उन मुंद वळ्लीद हैलेच. <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />इदुरसाटी तान ई बुराई देल मन तिर्गुस प्रभु से प्रार्थना माळ, आग सकतद कि अपमान मन इन विचार माफ माळकु आगुल. <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />यतिकी ना नोळतीन कि नी पित्त घाई केयजोर अदिक अन्याय अन्द बंधन दा बिदकु आय.”<verse eid="ACT 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24" />शमौन, पतरस अदिक यूहन्ना से अंदुन, “नीव नान साटी प्रभु से प्रार्थना माळी कि जो मातगोळी नीव अंदीर, अऊर दा टु यातोदारा नान मा बंदकु बिळबाळुल.”<verse eid="ACT 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25" />इदुरसाटी आंदुर गवाही कोटकु अदिक प्रभु उन वचन केळ्सकु यरूशलेम इक होटोदुर, अदिक सामरीगोळ्द हापाळ सा ऊरगोळ दा खुशखबरी केळ्सत होदुर.<verse eid="ACT 8:25" /></para>
  <para style="s">फिलिप्पुस अदिक कूश द्याश इन अधिकारी</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />बाक प्रभु अन्द ऊंद स्वर्गदूत फिलिप्पुस से अंदुन, “येळ, अदिक दक्षिण दी आ हादी मा होग, जो यरूशलेम टु गाज़ा अक होगतद.” ईद धुळा अन्द हादी हुन. <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />आव यदकु होटोदुन, अदिक नोळी, कूश द्याश इन ऊंद मंळसा बरोन जो खोजा जाती अदिक कूश इन रानी कन्दाके अन्द मंत्री अदिक पैस्या अन्द हिसाब ईटावाळा खजांची ईरोन. आव आराधना माळली यरूशलेम बंदीदुन. <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />आव तान रथ मा कुर्तकु ईरोन, अदिक यशायाह भविष्यवक्ता अन्द किताब वाचुसतेला वापस होगोन. <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" />आग पवित्र आत्मा फिलिप्पुस से अन्त, “हात्‍ती होगकु ई रथ इन सांगुळ आगेग.” <verse eid="ACT 8:29" /><verse number="30" style="v" sid="ACT 8:30" />फिलिप्पुस आऊन दी हरदुन अदिक आऊक यशायाह भविष्यवक्ता अन्द किताब वाचुसतेला केळदुन, अदिक आऊन से केळदुन, “नी जो वाचुसित्या येन अदरी नी सम्सत्या भी?”<verse eid="ACT 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31" />आव अंदुन, “यागासताका यावारा नानी समझुसतीदील रा ना ह्यांग समसाईन?” अदिक आव फिलिप्पुस से विनती माळदुन कि आव येरकु आऊन हात्‍ती कुरूल. <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />पवित्रशास्त्र अन्द जो अध्याय आव वाचुसोन,</para>
  <para style="q1" vid="ACT 8:32">अद ईद ईरोद: “आव म्यांडा अन घाई बली आगली पोहचुस्कु आदुन,</para>
  <para style="q2" vid="ACT 8:32">अदिक ह्यांग म्यांडा अन पाड्डा तान चुट्टी कातरूसावार्ळेद मुंद चुपचाप ईरतद,</para>
  <para style="q2" vid="ACT 8:32">हांगा आव भी तान बाय खोलसीदील.<verse eid="ACT 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33" />आऊन दीनता दा आऊंद न्याय ईला आग पायजे</para>
  <para style="q2" vid="ACT 8:33">आऊंद समय इन लॉकुर्द वर्णन याव माळ्यान?</para>
  <para style="q2" vid="ACT 8:33">यतिकी पृथ्वी टु आऊंद जीव तेगुकु आगेत.”<verse eid="ACT 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34" />इदुर मा खोजा जाती इन ऊंद अधिकारी मंळसा फिलिप्पुस से केळदुन, “ना नीन से विनती माळतीन, ईद हेळ कि भविष्यवक्ता ईद यार बारा दा अनतान, तांद या यावारा दुसरा अन्द बारा दा?” <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />आग फिलिप्पुस तान बाय खोल्सदुन, अदिक ईद शास्त्र भाग से सुरूवात माळकु आऊक यीशु उन खुशखबरी केळ्सदुन. <verse eid="ACT 8:35" /><verse number="36" style="v" sid="ACT 8:36" />हादी मा नळुत नळुत आंदुर यातोदारा नीर इन जागा मा पोहचुसदुर. आग खोजा जाती इन अधिकारी मंळसा अंदुन, “नोळ ईल नीर आद, ईग नानी बपतिस्मा ताकोंडुर दा येन रोक आद.” <verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" />फिलिप्पुस अंदुन, “अगर नी पुरा मन देल विश्वास माळत्या रा ताकोम सकत्या.” आव उत्‍तर कोट्टुन, “ना विश्वास माळतीन कि यीशु मसीह परमेश्वर उन पार हुन.”<verse eid="ACT 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 8:38" />आग आव रथ निदरूसोद आग्या कोट्टुन, अदिक फिलिप्पुस अदिक खोजा नीर दा ईळदुर, अदिक आव खोजा अक बपतिस्मा कोट्टुन. <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />याग आंदुर नीर दा टु होटकु म्याकुच बंदुर, रा प्रभु अन्द आत्मा फिलिप्पुस उक नेगुकु ओईत, अदिक खोजा जाती इन अधिकारी आऊक बाक नोळीदील, अदिक आव खुशी माळतेला तान हादी मा होटोदुन. <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />फिलिप्पुस उक हिंग हत्‍त कि आव अशदोद नगर दा आन, अदिक यागासताका कैसरिया दा पोहचुसीदील, आगासताका नगर नगर खुशखबरी केळ्सतेला होदुन.<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s">शाऊल उन दिल इन बदलाव</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />शाऊल जो ईगासताका प्रभु अन्द चेलागोळी धमकुसोद अदिक कोंद बुळोद धुन दा ईरोन, महायाजक उन हात्‍ती होदुन <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />अदिक आऊन से दमिश्क इन सभागृहगोळ दा हेसुर मा ई अभिप्राय इन चिट्ठी गोळी बेळदुन कि येन गंळ्स येन आर्त, यारी आव ई पंथ मा नोळ्यार आंदरी कटकु यरूशलेम तरूल.<verse eid="ACT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 9:3" />लेकीन नळुत नळुत याग आव दमिश्क इन हात्‍ती पोहचुसदुन, रा अचानक आकाश टु आऊंद नाकु दी ज्योति चमकुस्त, <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />अदिक आव जमीन मा बिद्दुन अदिक ईद शब्द केळदुन, “हे शाऊल, हे शाऊल, नी नानी येती सतुसेत्या?”<verse eid="ACT 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5" />शाऊल केळदुन, “हे प्रभु, नी याव हुय?”</para>
  <para style="p" vid="ACT 9:5">आव अंदुन, “ना यीशु हुईन, यारी नी सतुसेत्या. <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />लेकीन ईग यदकु नगर दा होग, अदिक जो नीनी माळोद आद अद नीन से अंदकु आदीत.”<verse eid="ACT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7" />जो मंळसागोळ आऊन सांगुळ ईरोर, आंदुर सट्ट ईतोदुर; यतिकी शब्द रा केळ बरतोगोद लेकीन याऊ कांळ्सतोगोन ईला. <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />आग शाऊल भूमी मा टु येद्दुन, लेकीन याग कण्णगोळी तेरदुन रा आऊक येनु कांळ्सीदील, अदिक आंदुर आऊन कय हुडुकु दमिश्क नगर दा ओतुर. <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />आव मुर दिन ताका नोळ सकिदील, अदिक ना तिंदुन अदिक ना कुळदुन.<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />दमिश्क दा हनन्याह हेसुर इन ऊंद चेला ईरोन, आऊन से प्रभु दर्शन दा अंदुन, “हे हनन्याह!”</para>
  <para style="p" vid="ACT 9:10">आव अंदुन, “प्रभु, ना हुईन.”<verse eid="ACT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11" />आग प्रभु आऊन से अंदुन, “यदकु आ गली दा होग जो ‘सरका’ कहलुसतद, अदिक यहूदा अन्द मान्ना दा शाऊल हेसुर इन ऊंद तरसुसवासी इक केळ; नोळ, आव प्रार्थना माळेत्यान, <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />अदिक आव हनन्याह हेसुर इन ऊंद मंळसा अक बुळ्क बर्त अदिक तान म्याकुच कय ईटतेला उदाहरण दा नोळदुन; ताकी दुबारा नोळ सकुल.”<verse eid="ACT 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13" />हनन्याह उत्‍तर कोट्टुन, “हे प्रभु, ना ई मंळसा अन्द बारा दा हापाळ मुंदुर से केळीन कि ईव यरूशलेम दा नीन पवित्र लॉकुर सांगुळ धोळ्द-धोळ्द बुराईगोळ माळ्यान; <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />अदिक ईल भी ईऊक प्रधान याजकगोळ्द दी टु अधिकार सिक्याद कि जो लॉकुर नीन हेसुर ताकोमतार, आ सप्पा मुंदरी कटबुळ.”<verse eid="ACT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15" />लेकीन प्रभु आऊन से अंदुन, “नी होटोग; यतिकी आव रा गैरयहूदीगोळी अदिक राजागोळी अदिक इस्त्राएलीगोळ्द मुंद नान हेसुर प्रगट माळोर साटी नान नीवळुस्द पात्र हुन. <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />अदिक ना आऊक हेळाईन कि नान हेसुर इन साटी आऊक ह्यांग-ह्यांग दुख नेगोद बिद्दीत.”<verse eid="ACT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17" />आग हनन्याह यदकु आ मान्ना दा होदुन, अदिक आऊन मा तान कय ईटकु अंदुन, “हे वार्ट शाऊल, प्रभु, मतलब यीशु, जो आ हादी मा, याता हादी देल नी बंद्या नीनी कांळ्सीदुन, आवा नानी कळ्यान कि नीनी मात्‍त कण्णगोळ देल कांळ्सुल अदिक नी पवित्र आत्मा देल परिपुर्ण आगेगुल.” <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />अदिक तुरन्त आऊन कण्णगोळ दा टु छिलका घाई बित्‍त अदिक आव नोळली कुरतुन, अदिक यदकु बपतिस्मा ताकोंडुन; <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />बाक भोजन माळकु आऊक आऊंद ताकत वापस सिक्त.</para>
  <para style="s" vid="ACT 9:19">दमिश्क दा शाऊल द्वारा प्रचार</para>
  <para style="p" vid="ACT 9:19">शाऊल हापाळ दिन ताका आ चेलागोळ्द सांगुळ ईत्‍तुन जो दमिश्क दा ईरोर. <verse eid="ACT 9:19" /><verse number="20" style="v" sid="ACT 9:20" />अदिक आव तुरन्त यहूदी लॉकुर्द सभागृहगोळ दा यीशु उन प्रचार माळली कुरतुन कि आव परमेश्वर उन पार हुन.<verse eid="ACT 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 9:21" />सप्पा केळावाळेर चकित आगकु अनली कुरतुर, “येन ईव आवा मंळसा आल्लच जो यरूशलेम दा आंदरी जो यीशु उन उपासना माळावाळेर इक, नाश माळतोगोन; अदिक ईल भी इदुरसाटी बंदीदुन कि आंदरी कटकु प्रधान याजकगोळ्द हात्‍ती तरूल?”<verse eid="ACT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 9:22" />लेकीन शाऊल मात्‍त ताकतवर आगतेला होदुन, अदिक ई मात इन प्रमाण कोट कोटकु कि मसीह ईवा हुन, दमिश्क इन ईरावाळेर यहूदीगोळी आश्चर्य चकित माळ्त ईत्‍तुन.<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">९:२३ </char>
      <char style="xt" closed="false">
        <ref loc="2CO 11:32">२ कुरिन्थि ११:३२</ref>,<ref loc="2CO 11:33">३३</ref></char>
    </note>याग हापाळ दिन बितसेदव, रा यहूदीगोळ मिलुसकु आऊक कोंद बुळोद साजीश रचुसदुर. <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />लेकीन आंदुर्द साजीश शाऊल उक मालूम नळदोत. आंदुर रा आऊक कोन्नोर साटी ईळ्लक हागुल नगर इन फाटकगोळ मा तयार ईरतोगोर. <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />लेकीन ईळ्लकी आऊन चेलागोळ आऊक फुट्टी दा कुर्सदुर, अदिक दिवार इन ख्वादरा दा टु हिलगुकसकु ईळ्स बुटुर.<verse eid="ACT 9:25" /></para>
  <para style="s">यरूशलेम दा शाऊल</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />यरूशलेम दा पोहचुस्कु शाऊल चेलागोळ सांगुळ मिलुसोद कोशिश माळदुन; लेकीन सप्पा आऊन से अंजतोगोर, यतिकी आंदरी विश्वास ईला आगतोगोद, कि आव भी चेला हुन. <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />लेकीन बरनबास आऊक तान सांगुळ प्रेरितगोळ हात्‍ती ओतकु आंदरी हेळदुन कि ईव याता रीति देल हादी मा प्रभु उक नोळदुन, अदिक आव ईऊन से मातगोळी हेळदुन; बाक दमिश्क दा ईव ह्यांग हिम्मत देल यीशु उन हेसुर देल प्रचार माळदुन. <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />आव आंदुर सांगुळ यरूशलेम दा होग्त बर्त अदिक पुरा हिम्मत देल प्रभु उन हेसुर इन प्रचार माळली कुरतुन. <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />अदिक गैरयहूदी भाषा माताळावाळेर यहूदीगोळ्द सांगुळ मातचीत अदिक झगळा माळतोगोन; लेकीन आंदुर आऊक कोंद बुळोद कोशिश माळली कुरतुर. <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />ईद जान्सकु वार्टुर आऊक कैसरिया बंदरगाह दा तंदुर, अदिक तरसुस नगर इक कळु बुटुर.<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />ई प्रकार सप्पा यहूदिया, गलील, अदिक सामरीया दा मंडली अक शांती सिक्त, अदिक अदुर्द उन्नती आग्त ईत्‍त; अदिक अद प्रभु उन अंज्क अदिक पवित्र आत्मा अन्द शांती दा नळुत अदिक वाळुस्त ईत्‍त.<verse eid="ACT 9:31" /></para>
  <para style="s">लुद्दा अदिक याफा नगर दा पतरस</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />बाक हिंग आत कि पतरस हर जागा टेटाळतेला, परमेश्वर उन पवित्र लॉकुर हात्‍ती भी पोहचुसदुन जो लुद्दा नगर दा ईरतोगोर. <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />अल आऊक एनियास हेसुर इन लकवा अन्द ऊंद रोगी मंळसा सिकदुन, जो येठ्ठ वर्ष टु व्हर्स मा बिदकु ईरोन. <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />पतरस आऊन से अंदुन, “हे एनियास! यीशु मसीह नीनी चंगा माळतान. येळ, तान हासक्या नेगु.” आग आव तुरन्त यदकु निदुरदुन. <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />आग लुद्दा अदिक शारोन इन सप्पा ईरावाळेर आऊक नोळकु प्रभु उन दी तिर्गदुर.<verse eid="ACT 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />याफा दा तबीता गैरयहूदी दा दोरकास मतलब हिरण हेसुर इनोर ऊंद विश्वासिनी ईरतोगोर. आक हापाळ सा वळ्लेव क्याल्सा अदिक दान माळतोगोर. <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />अवा दिनगोळ दा आक बिमार आगकु सोतोदुर; अदिक आंदुर आकिन मय तोळ्सकु म्याकुच इन कमरा दा ईट बुटुर. <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />इदुरसाटी कि लुद्दा याफा अन हात्‍ती ईरोद, चेलागोळ ईद केळकु कि पतरस अल आन, येढ्ढ मंळसा कळुकु आऊन से विनती माळदुर, “नाम हाती बरोर साटी देर माळबाळ.” <verse eid="ACT 9:38" /><verse number="39" style="v" sid="ACT 9:39" />आग पतरस यदकु आंदुर सांगुळ आगेदुन, अदिक याग आव पोहचुसदुन रा आंदुर आऊक आ अटारी म्याकुच मा ओतुर. सप्पा रांड्यागितेर वर्लतेला आऊन हात्‍ती बंदकु निदुरदुर, अदिक जो कुळता गोळ अदिक कपळागोळ दोरकास याग आक जित्‍ता ईरोर आंदुर सांगुळ ईरतेला माळीदुर, तोर्सली कुरतुर. <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />आग पतरस सप्पा मुंदरी व्हार्या माळ बुटुन, अदिक ट्वांगरा टेक्सकु प्रार्थना माळदुन अदिक लाश इन दी तिर्गकु नोळदुन अदिक अंदुन, “हे तबीता, येळ.” आग आक तान कण्णगोळी तेरदुर; अदिक पतरस उक नोळकु यदकु कुरतुर. <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />आव कय कोटकु आकी नेगदुन, अदिक परमेश्वर उन पवित्र लॉकुर अदिक रांड्यागितेर इक कारूकु आकी जित्‍ता तोर्स बुटुन. <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />ईद मात सप्पा याफा दा फैलुसेत; अदिक हापाळ सा लॉकुर प्रभु मा विश्वास माळदुर. <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />अदिक पतरस याफा दा शमौन हेसुर इन यावारा तोगुल इन धंदा माळावाळा अन्द मान्या हापाळ दिन ताका ईत्‍तुन.<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s">कुरनेलियुस अदिक पतरस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />कैसरिया दा कुरनेलियुस हेसुर इन ऊंद मंळसा ईरोन, जो इटालियन सेनादल इन अध्यक्ष ईरोन. <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />आव परमेश्वर उक अंजावाळा भक्त ईरोन, अदिक तान सप्पा घराना सांगुळ परमेश्वर उन आराधना माळतोगोन, अदिक यहूदी लॉकुरी हापाळ दान कोळतोगोन, अदिक रोज परमेश्वर उन से प्रार्थना माळतोगोन. <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />आव मदणी लगभग मुर मुरा अन हात्‍ती दर्शन दा स्पष्ट रूप देल नोळदुन कि परमेश्वर उन ऊंद स्वर्गदूत आऊंद हात्‍ती बुळ्क बंदकु अनतान, “हे कुरनेलियुस!”<verse eid="ACT 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4" />कुरनेलियुस स्वर्गदूत उक ध्यान देल नोळदुन अदिक अंजकु अंदुन, “हे प्रभु, येन हुन?”</para>
  <para style="p" vid="ACT 10:4">स्वर्गदूत आऊन से अंदुन, “नीन प्रार्थनागोळ अदिक नीन दान न्याय इन क्याल्सा हिसाब कोळोर साटी परमेश्वर उन मुंद पोहचुस्याव; <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />अदिक ईग याफा दा मंळसा कळुकु शमौन उक, जो पतरस कहलुस्तान, कार्स कोमी. <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />आव शमौन हेसुर इनव मंळसा जो तोगुल इन धंदा माळतान आऊन मान्या पतरस पाऊना आन, यार्द मान्ना समुद्र अन्द किनारा मा आद.” <verse eid="ACT 10:6" /><verse number="7" style="v" sid="ACT 10:7" />याग आव स्वर्गदूत याव आऊन से मातगोळी हेळीदुन होटोदुन, रा आव येढ्ढ सेवक, जो आऊन हात्‍ती मौजुद ईरतोगोर आंदुर दा टु ऊंद भक्त सिपाही इक कारदुन, <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />अदिक आंदरी सप्पा मातगोळी हेळकु याफा नगर इक कळुदुन.<verse eid="ACT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />दुसरा दिशी याग आंदुर नळुत नळुत याफा नगर इन हात्‍ती पोहचुसदुर, रा मदणी इन हात्‍ती पतरस छत मा प्रार्थना माळली येरदुन. <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />आऊक हसु हत अदिक येनारा तिनोद चाहासोन, लेकीन याग ऊम्मोद बनसोद आग अच आऊक दर्शन आत; <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />अदिक आव नोळदुन, कि आकाश खुलसेत; अदिक ऊंद पात्र धोळ्द चादर इन घाई नाकु क्वाना टु लटकुसतेला, पृथ्वी इन दी ईळेत्याद. <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />आ चादर दा पृथ्वी इन सप्पा प्रकार इन नाक कालवाळा पशु अदिक रेंगसावाळा जन्तु अदिक आकाश इन पक्षी ईरव. <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />आऊक ऊंद हिंग शब्द केळ बत्‍त, “हे पतरस येळ, कोन्न अदिक तीन.”<verse eid="ACT 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14" />लेकीन पतरस अंदुन, “ईला प्रभु, यागलु ईला; यतिकी ना यागलु यातोदु अपवित्र या अशुध्द वस्तु तंदिदील.”<verse eid="ACT 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15" />बाक दुसरा घन आऊक शब्द केळ बत्‍त, “जो येनारा परमेश्वर शुद्ध ठहरूस्यान, अदरी नी अशुध्द मान्सबाळ.” <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />मुर घन हिंग अच आत; अदिक तुरन्त अद चादर आकाश मा नेगुकु आगेत.<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />याग पतरस तान मन दा दुविधा दा ईरोन, कि ईद दर्शन जो ना नोळदीन अद येन आग सकतद, रा नोळी, आ मंळसागोळ यारी कुरनेलियुस कळीदुन, शमौन उन मान्ना अन्द पता हचकु दरवाजा मा बंदकु निदुरदुर, <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />अदिक कारूकु केळली कुरतुर, “येन शमौन जो पतरस कहलुस्तान, ईवा पाऊना हुन?”<verse eid="ACT 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19" />पतरस रा आ दर्शन मा सोचतेला अच ईरोन, कि आत्मा आऊन से अंदुन, “नोळ, मुर मंळसा नीन खोज दा आर. <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />इदुरसाटी यदकु ल्यालमा होग, अदिक बिना संकोच देल आंदुर सांगुळ आगेग; यतिकी ना अच आंदरी कळीन.” <verse eid="ACT 10:20" /><verse number="21" style="v" sid="ACT 10:21" />आग पतरस ईळुकु आ मंळसागोळ से अंदुन, “नोळी, यार्द खोज नीव माळेतीर, आव ना अच हुईन. नीम्द बरोद येन कारण आद?”<verse eid="ACT 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22" />आंदुर अंदुर, “कुरनेलियुस सूबेदार नामी कळ्यान जो न्यायी अदिक परमेश्वर उन उपासना माळावाळा अदिक सप्पा यहूदी लॉकुर दा मानवाईक मंळसा आन, आऊक ऊंद परमेश्वर उन पवित्र स्वर्गदूत से ईद निर्देश सिक्याद कि नीनी तान मान्या कारूकु नीन से वचन केळुल.”<verse eid="ACT 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 10:23" />आग पतरस आंदरी बुळ्क कारूकु आंदुर्द पाऊनचार माळदुन. दुसरा दिशी आव आंदुर सांगुळ होदुन, अदिक याफा अन्द वार्टुर दा टु येनारा आऊन सांगुळ आगेदुर. <verse eid="ACT 10:23" /><verse number="24" style="v" sid="ACT 10:24" />दुसरा दिशी आंदुर कैसरिया पोहचुसदुर, अदिक कुरनेलियुस तान परिवार अदिक हात्‍तीगोळोर संगीगोळी जमा माळकु आंदुर्द हादी कायोन. <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />याग पतरस बुळ्क बरोन, रा कुरनेलियुस आऊन से भेंट माळदुन, अदिक आऊन कालगोळ मा बिदकु आऊक प्रणाम माळदुन; <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />लेकीन पतरस आऊक नेगुकु अंदुन, “निदुर, ना भी रा सिर्फ मंळसा हुईन.” <verse eid="ACT 10:26" /><verse number="27" style="v" sid="ACT 10:27" />अदिक पतरस कुरनेलियुस उन सांगुळ मातचीत माळतेला बुळ्क होदुन, यल आव हापाळ सा लॉकुरी जमा नोळदुन. <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />आंदुर से अंदुन, “नीव जान्सतीर कि गैरयहूदी अन्द संगत माळोद या आऊन मान्या होगोद यहूदीगोळ इन साटी अन्याय आद, लेकीन परमेश्वर नानी हेळदुन कि यावारा मंळसा अक अपवित्र या अशुध्द अनबाळेत. <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />इदुरसाटी ना याग कारूकु आदीन रा बिना येनारा माताळोद होटबंदीन. ईग ना केळतीन कि नानी याता क्याल्सा अन्द साटी कारूकु आग्याद?”<verse eid="ACT 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30" />कुरनेलियुस अंदुन, “ईदा घळी टु पुरा नाक दिन पयले, ना तान मान्या मदणी इन मुर मुरा अन लगभग प्रार्थना माळीन; रा नोळी, अचानक ऊंद मंळसा चमकीला कपळा हाक्‍कु, नान मुंद बंदकु निदुरदुन <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />अदिक अनली कुरतुन, ‘हे कुरनेलियुस, नीन प्रार्थना केळकु आगेग्याद अदिक नीन दान न्याय इन स्यावा परमेश्वर उन मुंद याद माळकु आग्याव. <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />इदुरसाटी यारीकारा याफा कळुकु शमौन उक जो पतरस कहलुस्तान, कारू. आव समुद्र अन्द किनारा मा शमौन जो तोगुल इन धंदा माळतान अन्द मान्या पाऊना आन.’ <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />आग ना तुरन्त नीन हात्‍ती लॉकुरी कळुदीन, अदिक नी भला माळ्द जो होटबंद. ईग नाव सप्पा ईल परमेश्वर उन मुंद आयेव, ताकी जो येनारा परमेश्वर नीन से माताळोर साटी अंदान अदरी केळेव.”<verse eid="ACT 10:33" /></para>
  <para style="s">पतरस उन भाषण</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />आग पतरस अंदुन, “ईग नानी सही दा पता नळुत कि परमेश्वर यारदु पक्षपात माळालुन, <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />लेकीन हर राष्ट्र अन्द लॉकुर दा जो आऊन से अंजतार अदिक न्याय इन क्याल्सा माळतार, आंदुर आऊक भाऊस्तार. <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />अद वचन नीव जान्सतीर, जो वचन आव इस्त्राएलगोळ हात्‍ती कळुदुन, याग आव यीशु मसीह अन्द द्वारा जो सप्पा मुंदुर प्रभु आन शांती इन खुशखबरी केळ्सदुन, <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />नीव आ महान घटना अक जान्सतीर, जो इस्त्राएल इन जागा मा आगीत, गलील दा सुरूवात आगकु यूहन्ना अन द्वारा बपतिस्मा कोट्टुर बाद्दा टु यदुर्द प्रचार माळकु आगीत: <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />नीव नासरी यीशु उन बारा दा जान्सायदीर कि ह्यांग परमेश्वर आऊन मा पवित्र आत्मा अदिक सामर्थ्य पलटुसीदुन, अदिक यीशु वळ्लेव क्याल्सा माळतेला अदिक आ सप्पा मुंदरी जो शैतान उन वश दा ईरोर चंगा माळतेला नाकु दी आव ह्यांग ओयाळोन, यतिकी परमेश्वर आऊन सांगुळ ईरोन. <verse eid="ACT 10:38" /><verse number="39" style="v" sid="ACT 10:39" />नाव आ सप्पा क्याल्सागोळ्द गवाह आयेव; जो आव इस्त्राएल इन भूमी मा अदिक यरूशलेम दा भी माळदुन, अदिक आंदुर आऊक क्रूस मा येर्सकु कोंद बुटुर. <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />लेकीन आऊक परमेश्वर तिसरा दिशी मात्‍त जित्‍ता माळदुन, अदिक प्रगट भी माळ बुटुन; <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />सप्पा लॉकुर मा ईला लेकीन आ गवाहगोळ मा यारी परमेश्वर पयले टु निवळुस कोंडीदुन, मतलब नाम मा यार आऊन सोत्‍तुर दा टु जित्‍ता आगदुर बाद्दा आऊन सांगुळ तिनदेव कुळदेव; <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />अदिक आव नामी आग्या कोट्टुन कि लॉकुर दा प्रचार माळी अदिक गवाही कोळी, कि ईव आवा हुन यारी परमेश्वर जीवित अदिक सोतकु लॉकुर्द न्यायी ठहरूस्यान. <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />आऊंद सप्पा भविष्यवक्ता गवाही कोळतार कि जो यावारा आऊन मा विश्वास माळ्यान, आऊक आऊंद हेसुर इन ताकत इन द्वारा पापगोळ्द माफ सिक्‍कीत.”<verse eid="ACT 10:43" /></para>
  <para style="s">गैरयहूदीगोळ मा पवित्र आत्मा ईळुत</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />पतरस ई मातगोळी अनतेला अच ईरोन कि पवित्र आत्मा वचन इन सप्पा केळावाळेर मा ईळुकु बत्‍त. <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />अदिक यास यहूदी विश्वासी जो याफा टु पतरस उन सांगुळ बंदीदुर, आंदुर सप्पा चकित आदुर कि गैरयहूदीगोळ मा भी पवित्र आत्मा अन्द दान पलटुस्कु आग्याद. <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />यतिकी आंदुर आंदरी अलग अलग भाषा माताळ्त अदिक परमेश्वर उन बळाई माळ्त केळदुर. इदुर मा पतरस अंदुन, <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />“येन यावारा इंदरी नीर देल बपतिस्मा ताकोमली रोक्स सकतान, यारी नाम घाई पवित्र आत्मा सिक्याद?” <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />अदिक आव आग्या कोट्टुन कि आंदरी यीशु मसीह अन्द हेसुर देल बपतिस्मा कोटकु आगुल, आग आंदुर पतरस से विनती माळदुर कि आव येनारा दिन अदिक आंदुर सांगुळ ईरूल.<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s">पतरस उन यरूशलेम इन मंडली अक तान क्याल्सागोळ बारा दा हेळोद</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />बाक प्रेरितगोळ अदिक विश्वासी वार्टुर जो यहूदिया दा ईरोर केळदुर कि गैरयहूदीगोळ भी परमेश्वर उन वचन मान्स कोंडार. <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />इदुरसाटी याग पतरस यरूशलेम दा बंदुन, रा यहूदी विश्वासी खतना माळ्द लॉकुर आऊन से झगळा माळली कुरतुर, <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />“नी खतना ईला माळ्द गैरयहूदी लॉकुर मान्या होगकु आंदुर सांगुळ तिंद.” <verse eid="ACT 11:3" /><verse number="4" style="v" sid="ACT 11:4" />आग पतरस आंदरी सुरूवात टु येन येन आत अद सप्पा हेळदुन:<verse eid="ACT 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 11:5" />“ना याफा नगर दा प्रार्थना माळीन, आग ऊंद दर्शन नोळदीन कि ऊंद वस्तु, धोळ्द चादर इन घाई नाकु क्वाना टु लटकुस्द, आकाश टु ईळुकु नान हात्‍ती बत्‍त. <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />याग ना अदुर मा ध्यान माळदीन, रा अदुर्दा पृथ्वी इन नाक कालवाळा पालतु पशुगोळ अदिक वनपशु अदिक रेंगसावाळा जन्तु अदिक आकाश इन पक्षी नोळदीन; <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />अदिक ईद शब्द भी केळदीन, ‘हे पतरस येळ, कोन्न अदिक तिन!’ <verse eid="ACT 11:7" /><verse number="8" style="v" sid="ACT 11:8" />लेकीन ना अंदीन, ‘ईला प्रभु, ईला; यतिकी यातोदु अपवित्र या अशुध्द भोजन नान बाय दा यागलु होगीदील.’ <verse eid="ACT 11:8" /><verse number="9" style="v" sid="ACT 11:9" />इदुर उत्‍तर दा आकाश टु दुसरा घन आवाज आत, ‘जो येनारा परमेश्वर शुद्ध ठहरूस्यान, अदरी अशुध्द अनबाळ.’ <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />मुर घन हांगा आत; आग सप्पा येनारा बाक आकाश मा जेडुकु आगेत. <verse eid="ACT 11:10" /><verse number="11" style="v" sid="ACT 11:11" />अदिक नोळी, तुरन्त मुर मंळसा जो कैसरिया टु नान हात्‍ती कळुकु आगीदुर, आ मान्या यल नाव ईरेव, बंदकु निदुरदुर. <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />आग आत्मा नान से आंदुर सांगुळ बिना संकोच देल आगली हेळ्त, अदिक याफा दा टु आर विश्वासी वार्टुर भी नान सांगुळ कैसरिया बंदुर; अदिक नाव कुरनेलियुस उन मान्या होदेव. <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />कुरनेलियुस नामी हेळदुन, कि आव ऊंद स्वर्गदूत उक तान मान्या निदुरकु नोळदुन, याव आऊन से अंदुन, ‘याफा दा यातारा मंळसा अक कळुकु शमौन उक जो पतरस कहलुस्तान, कारसुस बुळ. <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />आव नीम से हिंग मातगोळी अंदान, यार द्वारा नीनी अदिक अपमान सप्पा परिवार इक उद्धार सिक्‍कीत.’ <verse eid="ACT 11:14" /><verse number="15" style="v" sid="ACT 11:15" />याग ना मातगोळी हेळली कुरतीन, रा पवित्र आत्मा आंदुर मा अदा रीति देल ईळुत याता रीति देल सुरूवात दा नाम मा ईळदीत. <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" /><note caller="+" style="x"><char style="xo" closed="false">११:१६ </char><char style="xt" closed="false"><ref loc="ACT 1:5">प्रेरितगोळ १:५</ref></char></note>आग नानी प्रभु उन अद वचन याद बत्‍त; जो आव अंदिदुन, ‘बपतिस्मा कोळावाळा यूहन्ना रा नीर देल बपतिस्मा कोट्टुन, लेकीन नीमी पवित्र आत्मा देल बपतिस्मा सिक्‍कीत.’ <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />इदुरसाटी याग परमेश्वर गैरयहूदीगोळी भी अदा दान कोट्टुन, जो नामी प्रभु यीशु मसीह मा विश्वास माळदुर देल सिक्‍कीत; रा ना याव ईरीन जो परमेश्वर उक रोक्स सकीन?”<verse eid="ACT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18" />ईद केळकु आंदुर अपमान माळोद बंद माळकु, अदिक परमेश्वर उन बळाई माळकु अनली कुरतुर, “आग रा परमेश्वर गैरयहूदीगोळी भी जीवन इन साटी मन तिर्गुसोद दान कोटान.”<verse eid="ACT 11:18" /></para>
  <para style="s">अन्ताकिया अन्द मंडली</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">११:१९ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 8:1-4">प्रेरितगोळ ८:१-४</ref>
      </char>
    </note>विश्वासीगोळ दा टु थ्वाळासा लॉकुर आ दुख इन मारा देल जो स्तिफनुस उन मृत्यु उन समय दा बिदीत, तितर बितर आगेगीदुर, आंदुर वयाळ्त-वयाळ्त फिनीकी अदिक साइप्रस अदिक अन्ताकिया दा बंदुर; लेकीन यहूदीगोळी बिटकु यारीकु वचन ईला केळ्सतोगोर. <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />लेकीन आंदुर दा टु थ्वाळासा साइप्रस निवासी अदिक कुरेनी ईरोर, जो अन्ताकिया दा बंदकु गैरयहूदीगोळी भी प्रभु यीशु उन खुशखबरी इन मातगोळी केळ्सली कुरतुर. <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />प्रभु उन सामर्थ्य आंदुर सांगुळ ईरोद, अदिक हापाळ लॉकुर विश्वास माळकु प्रभु उन दी तिर्गदुर.<verse eid="ACT 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22" />याग आंदुर चर्चा यरूशलेम इन मंडली अन्द केळदुर दा बत्‍त, रा आंदुर बरनबास उक अन्ताकिया कळुदुर. <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />याग आव अल पोहचुसदुन अदिक नोळदुन कि परमेश्वर लॉकुरी ह्यांग आशिषीत माळ्यान, अदिक आव खुश आदुन अदिक आंदुर से विनती माळदुन कि तान सप्पा मन इन सांगुळ पुरा सच्चाई देल अदिक विश्वासयोग्य प्रभु उन सांगुळ बन्सकु ईरी. <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />बरनबास ऊंद वळ्लेव मंळसा ईरोन, अदिक पवित्र आत्मा अदिक विश्वास देल परिपुर्ण ईरोन; अदिक अन्य हापाळ सा लॉकुर प्रभु दा बंदकु मिलुसदुर.<verse eid="ACT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />आग आव शाऊल उक नोळोर साटी तरसुस नगर इक होटोदुन. <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />याग आव आऊन से मिलुसदुन रा आऊक अन्ताकिया तंदुन; अदिक हिंग आत कि आंदुर ऊंद वर्ष ताका मंडली अन्द सांगुळ सिकोर अदिक हापाळ सा लॉकुरी उपदेश कोळतेला ईत्‍तुर; अदिक सब से पयले अन्ताकिया दा ईदा चेलागोळी मसीह अंदकु आत.<verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />अवा दिनगोळ दा थ्वाळासा भविष्यवक्ता यरूशलेम टु अन्ताकिया बंदुर. <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" /><note caller="+" style="x"><char style="xo" closed="false">११:२८ </char><char style="xt" closed="false"><ref loc="ACT 21:10">प्रेरितगोळ २१:१०</ref></char></note>आंदुर दा टु अगबुस हेसुर इन ऊंद मंळसा निदुरकु आत्मा अन्द अगुवाई दा भविष्यवाणी माळदुन कि सप्पा दुनिया दा धोळ्द अकाल बिद्दीत. अद अकाल क्लौदियुस उन समय दा बित्‍त. <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />आग चेलागोळ निर्णय माळदुर कि हर ऊंद तान तान पूंजी इन अनुसार यहूदिया दा ईरावाळेर विश्वासी वार्टुर मदत अन्द साटी येनारा कळुल. <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />आंदुर हांगा माळदुर; अदिक बरनबास अदिक शाऊल उन कय मंडली अन्द स्याणागोळ हात्‍ती थ्वाळासा पैस्या कळुदुर.<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s">अदिक छल</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />आ समय हेरोदेस राजा मंडली अन्द थ्वाळासा सदस्यगोळी सतुसोद सुरूवात माळदुन. <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />आव यूहन्ना अन्द वार्ट याकूब उक तलवार देल कोन्सुस बुट्टुन. <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />याग आव नोळदुन कि यहूदी लॉकुर आऊन से खुश आगतार, रा आव पतरस उक भी हुडुकोंडुन. अव दिन अखमीरी रोट्टी इन हाब्ब ईनव दिन ईरव. <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />आव पतरस उक हुडुकु बंदीगृह दा हाकदुन, अदिक रखवाली माळोर साटी नाक नाक सिपाहीगोळ्द नाक समुह माळीदुन; ईद विचार देल कि फसह अन बाद्दा आऊक लॉकुर मुंद तरूल. <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />बंदीगृह दा पतरस बंद ईरोन; लेकीन मंडली आऊन साटी मन हचकु परमेश्वर से प्रार्थना माळोद.<verse eid="ACT 12:5" /></para>
  <para style="s">पतरस उन बंदीगृह दा टु बिळोद</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />याग हेरोदेस आऊक लॉकुर मुंद तरली ईरोन, अदा ईळ्लकी पतरस येढ्ढ शंकलीगोळ देल कटकु येढ्ढ सिपाहीगोळ्द बीच दा मिंगोन; अदिक पहरेदारगोळ दरवाजा मा बंदीगृह अन्द रखवाली माळोर. <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />रा नोळी, प्रभु उन ऊंद स्वर्गदूत बंदकु निदुरदुन अदिक आ कोठरी दा ज्योति चमकुस्त, अदिक आव पतरस उन पासळी मा कय बळकु आऊक येद्दुन अदिक अंदुन, “येळ, जल्दी माळ.” अदिक आऊन कयगोळ दा टु शंकलीगोळ बिटकु बिदोदव. <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />आग स्वर्गदूत आऊन से अंदुन, “नेळु कट, अदिक तान केरू हाक्‍क कोम.” आव हांगा माळदुन. बाक स्वर्गदूत आऊन से अंदुन, “तान कपळा हाक्‍कु नान हींद आगेग.” <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />पतरस होटकु आऊन हींद नळुत नळुत बंदीगृह टु व्हार्या बंदुन; लेकीन ईद ईला जानसोन कि जो येनारा स्वर्गदूत माळेत्यान अद सही आद, लेकीन ईद सम्सदुन कि ना दर्शन नोळेतीन. <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />आग आंदुर पयला अदिक दुसरा पहरा टु होटकु आ लोवा अन्द फाटक मा पोहचुसदुर, जो नगर दी हादी होगतद. अद फाटक आंदुर साटी तान ताना खुलसेत, अदिक आंदुर होटकु ऊंद अच गली टु आगकु ऊंद हादी मा बंदुर, अदिक तुरन्त अच स्वर्गदूत आऊक बिटकु होटोदुन. <figure style="fig" alt="Chains embedded in prison wall" file="hk00204c.tif" size="col" copy="Horace Knowles ©" ref="१२:७">जेलखाना अन्द दिवार मा शंकली ठोक्सकु</figure><verse eid="ACT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11" />आग पतरस सावधान आगकु अंदुन, “ईग ना जान्स कोंडीन कि प्रभु तान स्वर्गदूत कळुकु नानी हेरोदेस उन कय देल अदिक यहूदीगोळ्द सप्पा आशा टु बिळ्स बुट्टुन.”<verse eid="ACT 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12" />ईद जान्सकु पतरस आ यूहन्ना अन्द मोय मरियम इन मान्या बंदुन, जो मरकुस कहलुसतान. अल हापाळ सा लॉकुर जमा आगकु प्रार्थना माळोर. <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />याग आव फाटक इन खिळकी ठोक्सदुन, रा रूदे हेसुर इन ऊंद दासी दरवाजा तेरोर साटी बंदुर. <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />पतरस उन शब्द केळकु आक खुशी अन मारा देल फाटक तेर्दिदील, लेकीन ओळकु बुळ्क होदुर अदिक हेळदुर कि पतरस दरवाजा मा निदुरकु आन. <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />आंदुर आकिन से अंदुर, “नी यर्र आय.” लेकीन आक हिम्मत माळकु अंदुर कि हिंग अच आद, “आग आंदुर अंदुर आऊन स्वर्गदूत आगीदान.”<verse eid="ACT 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16" />लेकीन पतरस ठोक्सतेला अच ईत्‍तुन: आखरी दा आंदुर खिळकी खोल्सदुर, अदिक आऊक नोळकु चकित ईतोदुर. <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />आग आव आंदरी कय देल इशारा माळदुन कि चुप ईरूल; अदिक आंदरी हेळदुन कि प्रभु याता रीति देल आऊक बंदीगृह दा टु तेगुकु तंदान. बाक अंदुन, “याकूब अदिक बाकी विश्वासी वार्टुरी ईद मात हेळ बुळेतीर.” आग होटकु येल्यारा दुसरा जागा अक होटोदुन.<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />हुंजकुका अच सिपाहीगोळ दा बळा हलचल मचुसेत कि पतरस उन येन आत.<verse eid="ACT 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 12:19" />याग हेरोदेस सिपाहीगोळ से आऊन खोज माळोद आदेश कोट्टुन लेकीन पतरस सिक्‍कीदील, रा पहरेदारगोळ जाँच माळकु आग्या कोट्टुन कि आंदरी कोंदकु आगुल: अदिक आव यहूदिया अक बिटकु कैसरिया दा होगकु ईरली कुरतुन अदिक अल आव थ्वाळासा समय बितुसदुन.<verse eid="ACT 12:19" /></para>
  <para style="s">हेरोदेस उन सायोद</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />हेरोदेस सूर अदिक सैदा अन्द लॉकुर से हापाळ सिट्ट दा ईरोन. इदुरसाटी आंदुर ऊंद समुह माळकु राजा से मिलुसली बंदुर, पयले आंदुर बलास्तुस उक जो राजा अन्द ऊंद सेवक ईरोन, समझुस्कु मेल माळोद चाहासदुर; यतिकी हेरोदेस राजा अन्द द्याश देल आंदुर्द द्याश इन पालन पोषण आगतोगोद.<verse eid="ACT 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21" />ठहरूस्द दिशी हेरोदेस राजा अन कपळा हाक्‍कु सिंहासन मा कुरतुन, अदिक आंदरी भाषण कोळली कुरतुन. <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />आग लॉकुर चिल्ळास कुरतुर, “ईद रा मंळसा अन्द ईला परमेश्वर उन आवाज हुन.” <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />अदा घळी प्रभु उन ऊंद स्वर्गदूत तुरन्त आऊक बळदुन, यतिकी आव परमेश्वर उक महिमा कोटीदील; अदिक आव किळा हतकु सोतोदुन अदिक अव किळागोळ आऊक तिनली हतदव.<verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />लेकीन परमेश्वर उन वचन लगातार वाळुस्त अदिक फैलुसतेला होत.<verse eid="ACT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25" />याग बरनबास अदिक शाऊल यरूशलेम दा तान क्याल्सा पुरा माळकु यूहन्ना अक जो मरकुस कहलुस्तान, सांगुळ हुडुकु अन्ताकिया वापस बंदुर.<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s">बरनबास अदिक शाऊल उक निवळुसोद अदिक कळोद</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />अन्ताकिया अन्द मंडली दा कई भविष्यवक्ता अदिक गुरु ईरोर; जसा: बरनबास, शमौन जो (नीगर) करेव कहलुसतान; अदिक लूकियुस कुरेनी, अदिक मनाहेम जो हेरोदेस शासक उन सांगुळ दा धोड्डेर आदुन, अदिक शाऊल. <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />याग आंदुर उपास सहित प्रभु उन स्यावा माळोर, रा पवित्र आत्मा आंदुर से अन्त, “नान साटी बरनबास अदिक शाऊल उक आ क्याल्सा अन्द साटी अलग माळी यार साटी ना आंदरी कार्सीन.”<verse eid="ACT 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 13:3" />आग आंदुर उपास अदिक प्रार्थना माळकु अदिक आंदुर मा कय ईटकु आंदरी सार माळदुर.<verse eid="ACT 13:3" /></para>
  <para style="s">कुप्रा दा बरनबास अदिक शाऊल</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />इदुरसाटी बरनबास अदिक शाऊल पवित्र आत्मा अन कळुद सिलूकिया अक होदुर; अदिक अल टु जहाज मा कुर्तकु साइप्रस इक होदुर; <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />अदिक सलमीस दा पोहचुस्कु, परमेश्वर उन वचन यहूदीगोळ्द सभागृहगोळ दा केळ्सदुर. यूहन्ना जो मरकुस कहलुसोन, मदत माळावाळा अन रूप दा आंदुर सांगुळ ईरोन. <figure style="fig" alt="Front view of a synagogue" file="lb00246c.tif" size="col" copy="Horace Knowles ©" ref="१३:५">यहूदी आराधनालय</figure><verse eid="ACT 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6" />आंदुर आ सप्पा टापू दा आगतेला पाफुस ताका पोहचुसदुर. अल आंदरी बार-यीशु हेसुर इन ऊंद यहूदी जादूगर अदिक ख्वाटा भविष्यवक्ता सिकदुन. <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />आव शासक सिरगियुस पौलुस उन संगी ईरोन, जो बुद्धिमान मंळसा ईरोन. आव बरनबास अदिक शाऊल उक तान हात्‍ती कारूकु परमेश्वर उन वचन केळोद चाहासदुन. <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />लेकीन इलीमास जादूगर, यतिकी गैरयहूदीगोळ दा ईदा आऊन हेसुर इन मतलब आद, आंदुर विरोध माळकु शासक उक विश्वास माळोर से रोकसोद चाहासदुन. <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />आग शाऊल यार्द हेसुर पौलुस भी आद, पवित्र आत्मा देल परिपुर्ण आगकु इलीमास जादुगर उन दी टकटकी हचकु नोळदुन अदिक अंदुन, <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />“हे सप्पा कपट अदिक सप्पा चतुराई देल तुमकु शैतान उन औलाद, सप्पा न्यायीपन अन्द दुश्मन, येन नी प्रभु उन सरका हादीगोळी वाकळा माळोद बिळतीदील? <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />ईग नोळ, प्रभु उन कय नीन विरोध दा येदोग्याद; अदिक नी थ्वाळासा समय ताका कुढ्ढ ईत्या अदिक सुर्य अन्द उजुळ नोळतीदिल.”</para>
  <para style="p" vid="ACT 13:11">आग तुरन्त धुंधरापन अदिक अंधार आऊन कण्णगोळ मा छासेत, अदिक आव ईत्‍त आत्‍त ताळु कुरतुन ताकी यावारा आऊन कय हुडुकु आऊक संभाळसुल. <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />आग शासक जो येनारा अल आगीत अदरी नोळकु अदिक प्रभु उन उपदेश देल चकित आगकु विश्वास माळदुन.<verse eid="ACT 13:12" /></para>
  <para style="s">पिसिदिया अन्द अन्ताकिया दा</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />पौलुस अदिक आऊन संगी पाफुस टु जहाज इन द्वारा पंफूलिया प्रदेश इन पिरगा नगर दा बंदुर; अदिक यूहन्ना आंदरी बिटकु यरूशलेम इक होटोदुन. <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />पिरगा नगर टु मुंद वाळुसकु आंदुर पिसिदिया अन्द अन्ताकिया दा पोहचुसदुर; अदिक आराम इन दिन यहूदी लॉकुर्द सभागृह दा होगकु कुरतोदुर. <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />मूसा अन्द व्यवस्था अदिक भविष्यवक्तागोळ किताब देल वाचुसदुर बाद्दा यहूदी लॉकुर्द सभागृह अन्द अधिकारीगोळ आंदुर हात्‍ती बातणी कळुदुर, “हे वार्टुरा अदिक आकतींगेरा, नाव चाहासतेव कि लॉकुरी प्रोत्साहित माळोर साटी नीम मन दा येनारा मात आद रा अनी.”<verse eid="ACT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16" />आग पौलुस निदुरकु अदिक कय देल इशारा माळकु अंदुन, “हे इस्त्राएलगोळा, अदिक सप्पा गैरयहूदीगोळा जो परमेश्वर उन आराधना माळतीर, केळी: <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />ई इस्त्राएली लॉकुर्द परमेश्वर नाम आप्प दादागोळी नीवळुस कोंडीदुन, अदिक याग ई लॉकुर मिस्त्र द्याश दा परदेशी आगकु ईरतोगोर, रा आंदुर्द उन्नती माळदुन; अदिक धोळ्द सामर्थ्य देल आंदरी इजिप्त टु तेगुकु तंदुन. <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />आव येनारा चालीस वर्ष ताका रेगिस्तान दा आंदुर्द सहन माळतेला ईत्‍तुन, <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />अदिक कनान द्याश दा येळ राष्ट्रगोळ्द नाश माळकु परमेश्वर अद पृथ्वी इस्त्राएल इन लॉकुरी अत्‍तरधिकारी इन रूप दा कोट बुट्टुन. <verse eid="ACT 13:19" /><verse number="20" style="v" sid="ACT 13:20" />इदुर बाद्दा आव शमूएल भविष्यवक्ता ताका आंदुर दा न्यायी ठहरूसदुन. <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />अदुर बाद्दा आंदुर ऊंद राजा बेळदुर: आग परमेश्वर चालीस वर्ष इन साटी बिन्यामीन इन जाती दा टु ऊंद मंळसा; मतलब कीश उन पार शाऊल उक आंदुर मा राजा ठहरूसदुन. <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />बाक आऊक अलग माळकु दाऊद उक आंदुर राजा माळदुन; यार बारा दा आव गवाही कोट्टुन, ‘नानी ऊंद मंळसा, यिशै उन पार दाऊद, नान मन इन अनुसार सिक्‍केदुन; आवा नांद सप्पा इच्छा पुरा माळ्यान.’ <verse eid="ACT 13:22" /><verse number="23" style="v" sid="ACT 13:23" />दाऊद उन वंश दा टु परमेश्वर तान वादा अन्द अनुसार इस्त्राएल इन हात्‍ती ऊंद उद्धारकर्ता, मतलब यीशु उक कळुदुन. <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" /><note caller="+" style="x"><char style="xo" closed="false">१३:२४ </char><char style="xt" closed="false"><ref loc="MRK 1:4">मरकुस १:४</ref>; <ref loc="LUK 3:3">लूका ३:३</ref></char></note>यीशु तान कार्यगोळ्द सुरूवात माळोर से पयले यूहन्ना सप्पा इस्त्राएलगोळ दा मन तिर्गुसोद प्रचार माळदुन अदिक बपतिस्मा माळदुन. <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" /><note caller="+" style="x"><char style="xo" closed="false">१३:२५ </char><char style="xt" closed="false"><ref loc="JHN 1:20">यूहन्ना १:२०</ref>; </char><char style="xt" closed="false"><ref loc="MAT 3:11">मत्ती ३:११</ref>; <ref loc="MRK 1:7">मरकुस १:७</ref>; <ref loc="LUK 3:16">लूका ३:१६</ref>; <ref loc="JHN 1:27">यूहन्ना १:२७</ref></char></note>याग बपतिस्मा कोळावाळा यूहन्ना तांद स्यावा पुरा माळदुर मा ईरोन, रा आव अंदुन, ‘नीव नानी येन सम्सतीर? ना आव आल्लच यार हादी नीव कायेतीर. उलटा नोळी, नान बाद्दा ऊंद बरावाळा आन, आऊन कालगोळ केरू उन बंध भी ना खोल्सा लायक हैलेच.’<verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />“हे इस्त्राएली वार्टुरा, नीव जो अब्राहम उन औलाद हुईर; अदिक सप्पा गैरयहूदी जो परमेश्वर उन आराधना माळतार, नीम हात्‍ती ई उद्धार इन वचन कळुकु आग्याद. <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />यतिकी यरूशलेम इन ईरावाळेर अदिक आंदुर अधिकारीगोळ ना उद्धारकर्ता अक अरतुर अदिक ना भविष्यवक्तागोळ्द अव मातगोळ जो हर ऊंद आराम इन दिन वाचुसकु आगतद आऊक सम्सत. अदिक यीशु उक दोषी ठहरूसदुर द्वारा भविष्यवक्तागोळ्द मातगोळी सही साबित माळ्द. <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" /><note caller="+" style="x"><char style="xo" closed="false">१३:२८ </char><char style="xt" closed="false"><ref loc="MAT 27:22">मत्ती २७:२२</ref>,<ref loc="MAT 27:23">२३</ref>; <ref loc="MRK 15:13">मरकुस १५:१३</ref>,<ref loc="MRK 15:14">१४</ref>; <ref loc="LUK 23:21-23">लूका २३:२१-२३</ref>; <ref loc="JHN 19:15">यूहन्ना १९:१५</ref></char></note>आंदरी कोंद बुळोद लायक येनु दोष आऊन दा सिक्‍कीदील, तरी भी पिलातुस से विनती माळदुर कि आव कोंदकु आगुल. <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" /><note caller="+" style="x"><char style="xo" closed="false">१३:२९ </char><char style="xt" closed="false"><ref loc="MAT 27:57-61">मत्ती २७:५७-६१</ref>; <ref loc="MRK 15:42-47">मरकुस १५:४२-४७</ref>; <ref loc="LUK 23:50-56">लूका २३:५०-५६</ref>; <ref loc="JHN 19:38-42">यूहन्ना १९:३८-४२</ref></char></note>याग शास्त्र दा आऊन बारा दा लिख्सद सप्पा मातगोळ आंदुर पुरा माळदुर, रा आऊक क्रूस मा टु ईळ्सकु कब्र दा ईटदुर.” <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />लेकीन परमेश्वर आऊक सोत्‍तुर दा टु जित्‍ता माळदुन, <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" /><note caller="+" style="x"><char style="xo" closed="false">१३:३१ </char><char style="xt" closed="false"><ref loc="ACT 1:3">प्रेरितगोळ १:३</ref></char></note>अदिक आव आंदरी जो आऊन सांगुळ गलील टु यरूशलेम बंदीदुर, हापाळ दिनगोळ ताका कांळ्सतेला ईत्‍तुन; इस्त्राएल लॉकुर्द मुंद ईग आंदुर अच आऊन गवाह आर. <verse eid="ACT 13:31" /><verse number="32" style="v" sid="ACT 13:32" />नाव नीमी आ वादा अन्द बारा दा जो नाम आप्प दादागोळ से माळकु आगीत, ईद खुशखबरी केळ्सतेव, <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />कि परमेश्वर यीशु उक जित्‍ता माळकु, अदा वादा नाम औलाद इन साटी पुरा माळदुन; ह्यांग भजन संहिता दा भी लिख्सकु आद,</para>
  <para style="q1" vid="ACT 13:33">नी नान पार हुय;</para>
  <para style="q2" vid="ACT 13:33">ईंद ना अच नीनी पैदा माळीन.<verse eid="ACT 13:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 13:34" />अदिक परमेश्वर आऊक सोत्‍तुर दा टु जित्‍ता माळकु येब्सदुन ताकी सळुसोर साटी कब्र दा बिदकु ईला ईरूल, इदुरसाटी आव ईद अंदुन,</para>
  <para style="q1" vid="ACT 13:34">ना नीनी पवित्र अदिक अटल आशीष कोळाईन</para>
  <para style="q2" vid="ACT 13:34">जो ना दाऊद उन सांगुळ वादा माळीन.<verse eid="ACT 13:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="ACT 13:35" />इदुरसाटी आव भजन संहिता दा भी अंदान,</para>
  <para style="q1" vid="ACT 13:35">नी तान विश्वासयोग्य सेवक उक कब्र दा सळुस गोळतीदील.<verse eid="ACT 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 13:36" />यतिकी दाऊद रा परमेश्वर उन इच्छा अन्द अनुसार तान समय दा स्यावा माळकु सोतोदुन, अदिक तान आप्प दादागोळ सांगुळ दा नळ्सकु आदुन, अदिक आऊन मय कब्र दा सळुसेत. <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />लेकीन यारी परमेश्वर सोत्‍तुर दा टु जित्‍ता माळदुन, आव सळुसीदील. <verse eid="ACT 13:37" /><verse number="38" style="v" sid="ACT 13:38" />इदुरसाटी, हे नान इस्त्राएली संगीगोळा, नीव जान्स कोमी कि यीशु उन द्वारा पापगोळ्द माफ अन्द बातणी नीमी कोटकु आगतद; <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />अदिक याता मातगोळ दा नीव मूसा अन्द व्यवस्था अन्द द्वारा पापगोळ देल मुक्त आग सकालीर, अवा सप्पा दा हर ऊंद यीशु मा विश्वास माळावाळा पापगोळ देल मुक्त आगतान. <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />इदुरसाटी सावधान ईरी, हिंग आगबाळुल कि जो भविष्यवक्तागोळ किताब दा बंदाद, नीम मा भी अद घटुस बाळुल:<verse eid="ACT 13:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41" />हे अपमान माळावाळेरा, नोळी, चकित आगी, अदिक सोतोगी;</para>
  <para style="q1" vid="ACT 13:41">यतिकी ना नीम दिनगोळ दा ऊंद क्याल्सा माळतीन,</para>
  <para style="q2" vid="ACT 13:41">हिंग क्याल्सा कि अगर यावारा नीम से आऊन बारा दा मातचीत माळुल,</para>
  <para style="q2" vid="ACT 13:41">रा नीव यागलु विश्वास माळतीदील.<verse eid="ACT 13:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />पौलुस अदिक बरनबास उन यहूदी सभागृह टु व्हार्या होळा समय लॉकुर आंदुर से विनती माळली कुरतुर कि अगला आराम इन दिन नामी ई मातगोळी बाक केळ्सकु आगुल. <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />याग सभा येदोत रा यहूदीगोळ अदिक गैरयहूदी मत दा बरावाळेर भक्तगोळ दा टु हापाळ सा पौलुस अदिक बरनबास इन हिंद आगेदुर; अदिक प्रेरितगोळ आंदुर से मातगोळी हेळकु प्रोत्साहित माळदुर कि परमेश्वर उन अनुग्रह दा जीवन बन्सकु ईटी.<verse eid="ACT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />अगला आराम इन दिन नगर इन सप्पा लॉकुर परमेश्वर उन वचन केळोर साटी जमा आगेदुर. <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />लेकीन यहूदी भीळ इक नोळकु जलन देल तुम्मेदुर, अदिक अपमान माळतेला पौलुस उन मातगोळ्द विरोध दा अपशब्द अनली कुरतुर. <verse eid="ACT 13:45" /><verse number="46" style="v" sid="ACT 13:46" />आग पौलुस अदिक बरनबास निडर आगकु अंदुर, जरूरी ईरोद कि परमेश्वर उन वचन पयले नीमी केळ्सकु आगाईत; लेकीन याग नीव अदरी ठुकरूस बुळतीर, अदिक खुद इक अनन्त जीवन इन योग्य ठहरूसालीर, रा नोळी, नाव नीमी बिटकु गैरयहूदी लॉकुर दी तिर्गतेव. <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />यतिकी प्रभु नामी ईद आग्या कोटान,</para>
  <para style="q1" vid="ACT 13:47">ना नीनी गैरयहूदीगोळ साटी ज्योति ठहरूसीन,</para>
  <para style="q2" vid="ACT 13:47">ताकी पुरा संसार ऊळ्सकु आगुल.<verse eid="ACT 13:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />ईद केळकु गैरयहूदीगोळ खुश आदुर, अदिक परमेश्वर उन वचन इन बळाई माळली कुरतुर; अदिक यास अनन्त जीवन इन साटी ठहरूसकु आगीदुर, आंदुर विश्वास माळदुर.<verse eid="ACT 13:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49" />आग प्रभु उन वचन आ सप्पा द्याश दा फैलुसली कुर्त. <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />लेकीन यहूदीगोळ परमेश्वर उन आराधना माळावाळेर अदिक प्रसिद्ध गैरयहूदी आर्तेर इक अदिक नगर इन प्रमुख लॉकुरी उकसुसदुर, अदिक पौलुस अदिक बरनबास इन विरूद्ध उपद्रव माळसुसकु आंदरी तान सीमा दा टु तेग्द बुटुर. <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" /><note caller="+" style="x"><char style="xo" closed="false">१३:५१ </char><char style="xt" closed="false"><ref loc="MAT 10:14">मत्ती १०:१४</ref>; <ref loc="MRK 6:11">मरकुस ६:११</ref>; <ref loc="LUK 9:5">लूका ९:५</ref>; <ref loc="LUK 10:11">१०:११</ref></char></note>आग प्रेरित आंदुर मुंद आंदुर विरोध दा तान कालगोळ धुळा झाळ्सकु इकुनियुम नगर इक होटोदुर. <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />अदिक अन्ताकिया नोर विश्वासी पुरा खुशी देल अदिक पवित्र आत्मा देल परिपुर्ण आगतेला होदुर.<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s">इकुनियुम दा पौलुस अदिक बरनबास</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />इकुनियुम दा हिंग आत कि पौलुस अदिक बरनबास यहूदीगोळ्द सभागृहगोळ दा सांगुळल्या होदुर, अदिक ई प्रकार देल मातगोळी हेळदुर कि यहूदीगोळ अदिक गैरयहूदीगोळ येढ्ढु दा टु हापाळ मुंदुर विश्वास माळदुर. <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />लेकीन विश्वास ईला माळावाळेर यहूदीगोळ गैरयहूदी लॉकुर्द मन दा विश्वासी वार्टुर विरोध दा उकसुसदुर अदिक आंदुर मन दा कळवाहटपन पैदा माळ कोंडुर. <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />पौलुस अदिक बरनबास हापाळ दिन ताका अल ईत्‍तुर, अदिक प्रभु उन बारा दा निर्भयता देल प्रचार माळ्त ईत्‍तुर आंदुर्द द्वारा प्रभु अदभुत चिन्ह अदिक आश्चर्यगोळी माळसुसतेला तान अनुग्रह अन्द बातणी ईद पुरा सच्चाई देल आद इदरी प्रगट माळतेला ईत्‍तुन. <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />लेकीन नगर इन लॉकुर दा फूट बिदोत, इदुर देल यास रा यहूदीगोळ दी अदिक यास प्रेरितगोळ्द दी आगेदुर.<verse eid="ACT 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 14:5" />आग थ्वाळासा गैरयहूदी अदिक यहूदी तान अधिकारीगोळ सांगुळ मिलुसकु आंदुर सांगुळ बुरा व्यवहार माळली अदिक आंदुर मा कल्लगोळ भिळोद चाल नळदुर. <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />आग पौलुस अदिक बरनबास उक ई मात इन पता नळुत आग आंदुर लुकाउनिया अन्द लुस्त्रा अदिक दिरबे घाई नगरगोळ दा अदिक अदुर्द आसपास इन क्षेत्रगोळ दा ओळदुर. <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />अदिक आंदुर अल खुशखबरी केळ्सली कुरतुर.<verse eid="ACT 14:7" /></para>
  <para style="s">लुस्त्रा अदिक दिरबे दा पौलुस अदिक बरनबास</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />लुस्त्रा दा ऊंद मंळसा कुर्तकु ईरोन, जो कालगोळ देल अपंग ईरोन. आव जनम टु अच लंगळा ईरोन अदिक यागलु नळु ईला सकोन. <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />आव पौलुस उक मातगोळी माळ्त केळोन. पौलुस आऊंद दी तार हचकु नोळदुन कि आऊक वळ्लेव आगोद विश्वास आद, <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />अदिक धोळ शब्द देल अंदुन, “तान कालगोळ बल देल सीधा निदुर.” आग आव हारकु नळुली टेटाळली कुरतुन. <verse eid="ACT 14:10" /><verse number="11" style="v" sid="ACT 14:11" />लॉकुर पौलुस उन ईद क्याल्सा नोळकु लुकाउनिया अन्द भाषा दा धोळ्द आवाज देल अंदुर, “द्यावगोळ मंळसागोळ्द रूप दा आगकु नाम हात्‍ती ईळुकु बंदार.” <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />आंदुर बरनबास उक ज्यूस, अदिक पौलुस उक हिरमेस अंदुर, यतिकी पौलुस मातगोळ हेळदुर दा मुख्य ईरोन. <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />ज्यूस द्याव उन आ मंदिर इन पुजारी जो आंदुर नगर इन मुंद ईरोन, वस्ता अदिक फूलगोळ हार फाटकगोळ मा तनकु लॉकुर सांगुळ बलिदान माळोद चाहासोन.<verse eid="ACT 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14" />लेकीन बरनबास अदिक पौलुस प्रेरितगोळ याग ईद केळदुर, रा तान कपळा हरदुर अदिक भीळ दा होदुर, अदिक कारूकु अनली कुरतुर, <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />“हे लॉकुरा, नीव ईद येती माळेतीर? नाव भी रा नीम घाई मंळसा हुयेव, अदिक नीमी परमेश्वर उन खुशखबरी केळसोर साटी नाव ईल आयेव, कि नीव ई बेकार वस्तुगोळ देल अलग आगकु जित्‍ता परमेश्वर उन दी तिर्गी, याव स्वर्ग अदिक पृथ्वी अदिक समुद्र अदिक जो येनारा अऊर्दा आद माळदुन. <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />आव बितुस्द समयगोळ दा सप्पा लॉकुरी तान तान हादीगोळ दा नळु गोट्टुन. <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />लेकीन आव हमेशा भला क्याल्सा माळदुर द्वारा तान अस्तित्व अक प्रमाणित माळदुन: आव नीमी आकाश टु माळ कोट्टुन अदिक मौसम इन अनुसार फसल कोट्टुन; आवा नीमी तिनली कोळतान अदिक नीम दिलगोळी खुशी देल तुम्म बुळतान.” <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />ईद अनकु भी प्रेरितगोळ लॉकुरी धोळ्द परेशानी देल रोक्सदुर कि आंदुर साटी बलिदान माळबाळुल.<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />लेकीन येनारा यहूदीगोळ पिसिदिया अन्द अन्ताकिया अदिक इकुनियुम टु बंदकु लॉकुरी तान दी माळ कोंडुर, अदिक पौलुस मा कल्लगोळ देल बळदुर, अदिक सोतकु सम्सकु आऊक नगर इन व्हार्या जेडुकु ओतुर. <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />पर याग चेलागोळ आऊन नाकु दी बंदकु निदुरदुर, रा आव यदकु मात्‍त नगर दा होदुन अदिक दुसरा दिशी बरनबास उन सांगुळ दिरबे अक होटोदुन.<verse eid="ACT 14:20" /></para>
  <para style="s">सीरिया अन्द अन्ताकिया दा वापस बरोद</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />पौलुस अदिक बरनबास दिरबे नगर इन लॉकुरी खुशखबरी केळ्सकु, अदिक हापाळ सा चेलागोळी माळकु, लुस्त्रा अदिक इकुनियुम अदिक पिसिदिया अन्द अन्ताकिया अक वापस बंदुर, <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />अदिक चेलागोळ मन इक संची माळ्त ईत्‍तुर अदिक ईद प्रोत्साहन कोळोर कि विश्वास दा सच्चाई देल बन्सकु ईरी; अदिक ईद शिक्षा कोळतोगोर, “नामी बळा दुख नेगुकु परमेश्वर उन राज्य दा प्रवेश माळोद आद.” <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />अदिक आंदुर हर ऊंद मंडली दा आंदुर साटी स्याणा लॉकुरी नियुक्त माळदुर अदिक उपास सहित प्रार्थना माळकु आंदरी प्रभु उन कय दा सौप्सदुर यार मा आंदुर विश्वास माळतोगोर.<verse eid="ACT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24" />आग पिसिदिया टु आगतेला आंदुर पंफूलिया पोहचुसदुर; <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />बाक पिरगा दा वचन केळ्सकु अत्तलिया दा बंदुर, <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />अदिक अल टु आंदुर जहाज मा अन्ताकिया होदुर, यल आंदुर आ क्याल्सा अन्द साटी जो आंदुर पुरा माळीदुर परमेश्वर उन अनुग्रह दा कोटकु आगीदुर.<verse eid="ACT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 14:27" />याग आंदुर अन्ताकिया बंदुर रा आंदुर मंडली अन लॉकुर जमा माळकु जो परमेश्वर आंदुर सांगुळ माळदुन अद केळ्सदुर अदिक हेळदुर कि ह्यांग परमेश्वर गैरयहूदीगोळ्द विश्वास माळोर साटी दरवाजा तेरदुन. <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />अदिक आंदुर विश्वासीगोळ सांगुळ हापाळ दिन ताका अल ईत्‍तुर.<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s">यरूशलेम इन सभा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />बाक थ्वाळासा लॉकुर यहूदिया टु अन्ताकिया बंदकु विश्वासी वार्टुरी कल्सली हतदुर: “अगर मूसा अन्द व्यवस्था अन अनुसार नीम्द खतना ईला आगाईत रा नीमी उद्धार सिक सकाल.” <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />इदुर बारा दा पौलुस अदिक बरनबास आंदुर से सहमत ईला ईरोर ईदा कारण देल आंदुर सांगुळ आंदुर्द हापाळ धोळ्द झगळा आत रा ईद ठहरूस्कु आत कि पौलुस अदिक बरनबास अदिक आंदुर दा टु थ्वाळासा संगीगोळ ई मात इन समाधान माळोर साटी प्रेरितगोळ अदिक मंडली नोर स्याणा मंळसागोळ हात्‍ती यरूशलेम इक कळुकु आगुल.<verse eid="ACT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3" />इदुरसाटी मंडली आंदरी येनारा दुर ताका सफर माळोर साटी पोहचुसदुर; अदिक आंदुर फिनीकी अदिक सामरीया टु आगतेला गैरयहूदी लॉकुर ह्यांग परमेश्वर उन दी तिर्गदुर इदुर्द जानकारी केळ्सतेला होदुर, अदिक ई जानकारी देल विश्वासी वार्टुर हापाळ खुश आदुर. <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />याग आंदुर यरूशलेम पोहचुसदुर, रा मंडली अदिक प्रेरित अदिक मंडली नोर स्याणा लॉकुर आंदुर स्वागत माळदुर, अदिक आंदुर हेळदुर कि परमेश्वर आंदुर सांगुळ आगकु येन-येन क्याल्सा माळीदुन. <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />लेकीन फरीसीगोळ समुह दा टु थ्वाळासा लॉकुर जो यार विश्वास माळीदुर, आंदुर यदकु अंदुर, “गैरयहूदीगोळ्द खतना आग अच पायजे अदिक आंदुर मूसा अन्द व्यवस्था अन पालन माळ पायजे.”<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />आग प्रेरित अदिक मंडली अन स्याणा लॉकुर ई मात इन बारा दा विचार माळोर साटी जमा आदुर. <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" /><note caller="+" style="x"><char style="xo" closed="false">१५:७ </char><char style="xt" closed="false"><ref loc="ACT 10:1-43">प्रेरितगोळ १०:१-४३</ref></char></note>आग पतरस हापाळ झगळा आगदुर बाद्दा निदुरकु आंदुर से अंदुन, “हे वार्टुरा, नीव जान्सतीर कि हापाळ दिन पयले परमेश्वर नीम दा टु नानी नीवळुस कोंडुन कि नान बाय देल गैरयहूदीगोळी खुशखबरी इन वचन केळसुसुल ताकी आंदुर केळकु विश्वास माळुल. <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" /><note caller="+" style="x"><char style="xo" closed="false">१५:८ </char><char style="xt" closed="false"><ref loc="ACT 10:44">प्रेरितगोळ १०:४४</ref>; <ref loc="ACT 2:4">२:४</ref></char></note>सप्पा मुंदुर्द मन अरावाळा परमेश्वर आंदरी भी नाम घाई पवित्र आत्मा कोटकु आंदुर गवाही कोटकु आंदुर्द संबंध दा तान समर्थन दर्शुसिदुन; <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />अदिक विश्वास इन द्वारा आंदुर पापगोळी माफ माळदुन आंदुर्द अदिक नाम्द न्याड्या येनु भेदभाव ईटीदिल. <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />रा ईग नीव येती परमेश्वर उन परीक्षा माळतीर कि विश्वासीगोळ कुतक्या मा हिंग जुआळी ईटी, यारी ना नाम आप्प दादागोळ नेगु सकीदुर अदिक ना नाव नेगु सकतेव? <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />ईला, नाम्द ईद विश्वास आद कि जसा ह्यांग नाम प्रभु यीशु उन अनुग्रह देल उद्धार आग्याद; हांगा आंदुर्द भी आग्याद.”<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />आग सप्पा सभा चुपचाप बरनबास अदिक पौलुस उन केळली कुरतुर, कि परमेश्वर आंदुर द्वारा गैरयहूदीगोळ दा ह्यांग धोळ धोळ चमत्कार अदिक अदभुत क्याल्सा तोर्सदुन. <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />याग आंदुर चुप आदुर रा याकूब अनली कुरतुन, हे वार्टुरा, अदिक आकतींगेरा, नांद केळी. <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />शमौन ईगल्या हेळदुन कि परमेश्वर पयले गैरयहूदीगोळ मा ह्यांग कृपा दृष्टी माळदुन, कि आंदुर दा टु तान हेसुर इन साटी ऊंद लॉकुर माळ कोमुल. <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />इदुर देल भविष्यवक्तागोळ वचन भी समर्थन माळताव, जसा कि शास्त्र दा लिख्सकु आद,<verse eid="ACT 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16" />इदुर बाद्दा ना मात्‍त बंदकु दाऊद उन</para>
  <para style="q2" vid="ACT 15:16">बिदकु राज्य मात्‍त स्थापित माळाईन,</para>
  <para style="q1" vid="ACT 15:16">अदिक आऊन खंडरगोळी मात्‍त</para>
  <para style="q2" vid="ACT 15:16">मजबूत कटाईन,<verse eid="ACT 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17" />इदुरसाटी कि मिग्द मंळसागोळ, मतलब सप्पा</para>
  <para style="q2" vid="ACT 15:17">गैरयहूदी जो नान हेसुर इन कहलुस्तार, प्रभु अक ढुंढसुल,<verse eid="ACT 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 15:18" />ईद आवा प्रभु अनतान जो दुनिया अन उत्पत्ति देल ई मातगोळी प्रगट माळतेला बंदान.<verse eid="ACT 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />“इदुरसाटी नान विचार ईद आद कि गैरयहूदीगोळ दा टु जो लॉकुर परमेश्वर उन दी तिर्गतार, नाव आंदरी दुख कोळतीदील; <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />बल्‍की नामी आंदुर हात्‍ती चिट्ठी लिख्सकु कळु पायजे: कि आंदुर भोजन तिनबाळुल जो प्रथा अन अनुसार अशुध्द आद यतिकी अद मूर्तीगोळ मा येर्सद हुन, व्यभिचार देल आंदुर दुर ईरूल अदिक कुतक्या ओतकु कोंद यातोदु पशु उन मास अदिक खुन तिनबाळुल. <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />यतिकी स्याणा लॉकुर काल टु नगर नगर मूसा अन्द व्यवस्था अन्द प्रचार माळावाळेर आग्त बंदार, अदिक अद हर आराम इन दिन सभागृह दा वाचुसकु आगतद.”<verse eid="ACT 15:21" /></para>
  <para style="s">गैरयहूदी विश्वासीगोळी चिट्ठी</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />आग सप्पा मंडली सहित प्रेरितगोळ अदिक मंडली अन्द स्याणागोळ निश्चय माळदुर कि नाम दा टु येनारा येढ्ढ मंळसागोळी नीवळुसुल, मतलब यहूदा जो बरसब्बा कहलुस्तान, अदिक सीलास उक जो वार्टुर दा स्याणा ईरोन; अदिक आंदरी पौलुस अदिक बरनबास उन सांगुळ अन्ताकिया कळुल.<verse eid="ACT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 15:23" />आंदुर आंदुर्द कय दा ईद चिट्ठी लिख्सकु कळुदुर: “अन्ताकिया अदिक सीरिया अदिक किलिकिया अन्द ईरावाळेर वार्टुर इक जो गैरयहूदीगोळ दा टु आर, प्रेरितगोळ अदिक स्याणा लॉकुर वार्टुर्द नमस्कार. <verse eid="ACT 15:23" /><verse number="24" style="v" sid="ACT 15:24" />नाव ईद केळदेव कि नाम दा टु यावारा आदेश हासिल माळ्द बिना अच नाम दा टु थ्वाळासा लॉकुर होगकु, तान शब्दगोळ देल नीमी परेशानी अदिक दुख पोहुचुस्यान. <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />नाव सप्पा मुंदुर आपस दा सहमत आगकु ईद निश्चय माळदेव कि नाम दा टु निवळुस्द मंळसागोळी तान प्रिय बरनबास अदिक पौलुस उन सांगुळ नीम हात्‍ती कळेव. <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />ई हिंग मंळसा आर यार तान जीव नाम प्रभु यीशु मसीह अन्द क्याल्सागोळ साटी जोखिम दा हाक्यार. <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />इदुरसाटी नाव यहूदा अदिक सीलास उक कळेव, जो मातगोळ नाव लिख्सेतेव, आंदुर ऊंद आगकु नीमी ईवा मातगोळ हेळ्यार. <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />पवित्र आत्मा अक अदिक नामी उचित जान्सकु बित्‍त कि ई जरूरी मातगोळी बिटकु, नीम मा बोझ हाकबाळुल; <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />कि नीव मूर्तीगोळ मा बली माळावाळेर से अदिक खुन देल, अदिक कुतक्या वत्‍त पशुगोळ्द मास देल, अदिक व्यभिचार देल दुर ईरी. ईऊर से दुर ईरी रा नीम्द भला आदीत. नाम शुभकामनागोळ मुंद नीम सांगुळ ईरूल.”<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />बाक आंदुर सार आगकु अन्ताकिया पोहचुसदुर, अदिक विश्वासीगोळ्द सभा अक जमा माळकु अद चिट्ठी आंदरी कोट्ट बुटुर. <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />आ लॉकुर चिट्ठी जोर देल वाचुसकु अद प्रोत्साहन सिक्‍कावाळा बातणी इन द्वारा हापाळ खुश आगेदुर. <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />यहूदा अदिक सीलास जो खुद भी भविष्यवक्ता ईरोर, हापाळ मातगोळ देल वार्टुरी शिक्षा कोटकु प्रोत्साहित अदिक संची माळदुर. <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />आंदुर येनारा दिन ईतकु, विश्वासी वार्टुर आंदरी शांती देल आंदुर दा हात्‍ती वापस होगली विदा माळदुर जो आंदरी कळीदुर. <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" /><note caller="+" style="f"><char style="fr" closed="false">१५:३४ </char><char style="ft" closed="false">येनारा हस्तलेखगोळ दा ईद वचन सिकाल्द</char></note> लेकीन सीलास उक अल ईरोद वळ्लीद हत.<verse eid="ACT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 15:35" />लेकीन पौलुस अदिक बरनबास अन्ताकिया दा ईतोदुर: अदिक अन्य हापाळ सा लॉकुर्द सांगुळ प्रभु उन वचन केळ्सतेला ईत्‍तुर.<verse eid="ACT 15:35" /></para>
  <para style="s">पौलुस अदिक बरनबास उन अलग आगोद</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />थ्वाळासा दिन बाद्दा पौलुस बरनबास से अंदुन, “या नगर दा नाव प्रभु उन वचन केळसीदेव, बरी, बाक आंदुर दा नळुकु तान वार्टुरी अदिक आकतींगेरी नोळाता कि आंदुर ह्यांग आर.” <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />आग बरनबास यूहन्ना अक जो मरकुस कहलुस्तान, सांगुळ हुडोद विचार माळदुन. <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" /><note caller="+" style="x"><char style="xo" closed="false">१५:३८ </char><char style="xt" closed="false"><ref loc="ACT 13:13">प्रेरितगोळ १३:१३</ref></char></note>लेकीन पौलुस ईद वळ्लीद समसीदील कि आऊक तान सांगुळ हुळदेव, यतिकी यूहन्ना जो मरकुस कहलुसतान, पंफूलिया टु आंदुर हात्‍ती वापस हिंद तिर्गेगिदुन अदिक आंदुर स्यावा कार्य पुरा आगासताका आंदुर सांगुळ ईला ईरोन. <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />इदुर मा बरनबास अदिक पौलुस उन दा धोळ्द विरोध पैदा आगेत अदिक परिणाम ईद सिक्त कि आंदुर आपस दा आबुर दाबुर से अलग आगेदुर; बरनबास, मरकुस उक हुडुकु जहाज मा साइप्रस होटोदुन. <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />लेकीन पौलुस सीलास उक निवळुस कोंडुन, अदिक विश्वासी वार्टुर से परमेश्वर उन अनुग्रह दा कोटकु अल टु होटोदुन; <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />अदिक आव मंडलीगोळी संची माळतेला सीरिया अदिक किलिकिया टु आगतेला होट्टुन.<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s">तीमुथियुस उन पौलुस अदिक सीलास उन सांगुळ होगोद</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />बाक पौलुस दिरबे अदिक लुस्त्रा दा भी होदुन. अल तीमुथियुस हेसुर इन ऊंद मसीह ईरोन, आऊन मोय यहूदी विश्वासी ईरोर, लेकीन आऊन आप्प गैरयहूदी ईरोन. <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />आव लुस्त्रा अदिक इकुनियुम उन वार्टुर दा वळ्लेव मंळसा ईरोन. <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />पौलुस उन इच्छा ईरोद कि तीमुथियुस आऊन सांगुळ बरूल; अदिक जो यहूदी लॉकुर आ जागागोळ दा ईरोर आंदुर कारण आव आऊंद खतना माळदुन, यतिकी आंदुर सप्पा जानसोर, कि आऊन आप्प गैरयहूदी ईरोन. <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />अदिक नगर नगर होगतेला आंदुर आ नियमगोळी जो यरूशलेम इन प्रेरितगोळ अदिक स्याणागोळ ठहरूसीदुर, मानसोर साटी आंदरी हेळकु आगोद. <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />ई प्रकार मंडलीगोळ विश्वास दा संची आगतेला होत अदिक संख्या दा रोज वाळुस्त होत.<verse eid="ACT 16:5" /></para>
  <para style="s">त्रोआस दा पौलुस उन दर्शन</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />आंदुर फ्रूगिया अदिक गलातिया प्रदेशगोळ दा टु आगकु होदुर, यतिकी पवित्र आत्मा आंदरी आसिया दा वचन केळसोर से मना माळ्त. <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />आंदुर मूसिया अन्द सीमा अन हात्‍ती पोहचुस्कु, बितूनिया क्षेत्र दा होगोद चाहासदुर; लेकीन यीशु उन आत्मा आंदरी इजाजत कोटीदील. <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />इदुरसाटी आंदुर मूसिया टु आगकु त्रोआस दा बंदुर. <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />अल पौलुस ईळ्लकी ऊंद दर्शन नोळदुन कि ऊंद मकिदुनी मंळसा निदुरकु आऊन से विनती माळकु अनेत्यान, “ईपाटी ईळुकु मकिदुनिया दा बा, अदिक नाम्द मदत माळ.” <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />आऊन ईद दर्शन नोळतेला अच नाव तुरन्त मकिदुनिया होगोद चाहासदेव, ईद सम्सकु कि परमेश्वर नामी आंदरी खुशखबरी केळसोर साटी कारस्यान.<verse eid="ACT 16:10" /></para>
  <para style="s">फिलिप्पी दा: लुदिया अन्द मन-बदलुसोद</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />इदुरसाटी त्रोआस टु जहाज कुर्तकु नाव सिधा सुमात्राके होदेव अदिक दुसरा दिशी नियापुलिस दा बंदेव. <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />अल टु नाव फिलिप्पी पोहचुसदेव, जो मकिदुनिया द्याश इन मुख्य नगर अदिक रोमीगोळ्द ऊर हुन; अदिक नाव आ नगर दा थ्वाळासा दिन ताका ईत्‍तेव. <verse eid="ACT 16:12" /><verse number="13" style="v" sid="ACT 16:13" />आराम इन दिन नाव नगर इन फाटक इन व्हार्या गांगा अन्द किनारा ईद सम्सकु होदेव कि अल प्रार्थना माळोद जागा ईतीदाद, अदिक कुर्तकु आ आर्तेर से जो जमा आगीदुर, मातगोळी माळली कुरतेव. <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />लुदिया हेसुर इन थुआतीरा नगर इन जांभळा रंग इन कपळा मारावळ्त ऊंद भक्त आर्त केळोर. प्रभु आकिन मन खोल्सदुन कि आक पौलुस उन मातगोळ मा मन हचुल. <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />याग लुदिया तान घराना समेत बपतिस्मा ताकोंडुर, रा आक नाम से विनती माळदुर, “अगर नीव नानी प्रभु उन विश्वासिनी सम्सतीर, रा नळुकु नान मान्या ईरी,” अदिक आक नामी मान्सकु ओतुर.<verse eid="ACT 16:15" /></para>
  <para style="s">पौलुस अदिक सीलास बंदीगृह दा</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />ऊंद दिशी याग नाव प्रार्थना माळोद जागा मा होगेव, रा नाम मुलाकात ऊंद हारोद आर्त दासी से आत यारदा भविष्य हेळावाळा दुष्टआत्मा ईरोद; अदिक लॉकुर्द भविष्य हेळदुर देल स्वामीगोळ साटी हापाळ पैस्या कमुसकु तरतोगोद. <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />आक पौलुस उन दी नाम हींद बंदकु चिल्ळासली कुरतुर, “ई मंळसा परमप्रधान परमेश्वर उन दास हुय, जो नामी उद्धार इन हादी इन कात्‍ता केळ्सतार.” <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />आक हापाळ दिन ताका हिंग अच माळतेला ईत्‍तुर; लेकीन पौलुस परेशान आदुन, अदिक पलटुस्कु आ दुष्टआत्मा से अंदुन, “ना नीनी यीशु मसीह अन्द हेसुर देल आग्या कोळतीन कि आकिन दा टु होटबुळ.” अदिक अद आत्मा अदा घळी होट बुळ्त. <verse eid="ACT 16:18" /><verse number="19" style="v" sid="ACT 16:19" />याग आ पोर इन स्वामीगोळ नोळदुर कि नाम्द कमाई इन आशा होग्त ईत्‍त, रा पौलुस अदिक सीलास उक हुळकु चौक दा प्रधानगोळ हात्‍ती जेडुकु ओतुर; <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />अदिक आंदरी रोमन अधिकारीगोळ हात्‍ती ओतुर अदिक अंदुर, “ई लॉकुर जो यहूदी आर, नाम नगर दा बळा अशांती फैलुसेत्यार; <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />अदिक हिंग रीति रिवाजगोळी कल्सेत्यार, यारी ग्रहण माळोद या मानसोद नाम रोमीगोळ साटी वळ्लीद हैलेच अदिक नाव ईदुर्द पालन भी माळ सकालेव अदिक मान्स भी सकालेव.”<verse eid="ACT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 16:22" />आग भीळ इन लॉकुर आंदुर्द विरोध दा जमा आगकु पौलुस अदिक सीलास उन मा येरतेला बंदुर, अदिक शासकगोळ आंदुर कपळा हरदुर अदिक अदिक आंदरी कोळागोळ बडोद आग्या कोट्टुर. <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />हापाळ कोळा बळसुस्कु आंदुर आंदरी बंदीगृह दा हाक बुटुर अदिक दरोगा अक आग्या कोट्टुर कि आंदरी कळक बंदोबस्त दा ईटुल. <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />आऊक हिंग आग्या सिक्तेला अच आव आंदरी बुळ्क इन कोठरी दा ईटदुन अदिक आंदुर कालगोळ कोल इक ठोक्स बुटुन.<verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />आर्धा ईळ्लक इन लगभग पौलुस अदिक सीलास प्रार्थना माळतेला परमेश्वर उन भजन हाळोर, अदिक कैदी आंदुर्द केळोर. <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />इटुर दा अचानक धोळ्द भूकम्प बत्‍त, ईल ताका कि बंदीगृह अन्द पायवा हालुसेदव अदिक तुरन्त सप्पा दरवाजा खुलसेदव; अदिक सप्पा कैदीगोळव बंधन खुलसेदव. <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />दरोगा जप दा टु येद्दुन, अदिक बंदीगृह अन्द दरवाजा खुला नोळकु सम्सदुन कि कैदी ओळेग्यार, इदुरसाटी आव तलवार तेगुकु तान तान इक कोंद बुळोद चाहासदुन. <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />लेकीन पौलुस धोळ शब्द दा कारूकु अंदुन, “तान तान इक येनु हानि पहचुसबाळ, यतिकी नाव सप्पा ईल्या आयेव.”<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />आग बंदीगृह अन्द दरोगा दिंग्या कार्सदुन अदिक राटनेरी बुळ्क होदुन, अदिक अंज्क देल नळ्गतेला पौलुस अदिक सीलास उन मुंद बिदोदुन; <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />अदिक आंदरी व्हार्या तनकु अंदुन, “हे सज्जनगोळा, उद्धार सिक्‍कोर साटी ना येन माळाईन?”<verse eid="ACT 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31" />आंदुर अंदुर, “प्रभु यीशु मसीह मा विश्वास माळ, रा नीनी अदिक नीन घराना अक उद्धार सिक्‍कीत.” <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />अदिक आंदुर आऊक अदिक आऊंद सप्पा मान्ना अन्द लॉकुरी प्रभु उन वचन केळ्सदुर. <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />ईळ्लकी अदा घळी दरोगा आंदरी ओतकु आंदुर्द जखमगोळी तोळदुन, अदिक आव तान सप्पा घराना समेत तुरन्त बपतिस्मा ताकोंडुन. <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />आग आव पौलुस अदिक बरनबास उक तान मान्या ओतकु आंदुर्द मुंद भोजन ईटदुन, अदिक सप्पा घराना समेत परमेश्वर मा विश्वास माळकु खुशी माळदुन.<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />याग हागुल आत आग रोमन शासकगोळ तान सिपाहीगोळ अधिकारीगोळ्द कय देल बातणी कळुदुर कि आ मंळसागोळी बिट बुळी.<verse eid="ACT 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 16:36" />दरोगा ईद मातगोळी पौलुस से अंदुन, “शासकगोळ नीमी बिट बुळोद आग्या कळु बुटार. इदुरसाटी ईग होटकु शांती देल होटोगी.”<verse eid="ACT 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37" />लेकीन पौलुस सिपाहीगोळ अधिकारीगोळ से अंदुन, “आंदुर नामी जो रोमी मंळसा आर, दोषी ठहरूस्द बिना लॉकुर मुंद बळदुर अदिक बंदीगृह दा हाकदुर. ईग येन नामी चुपचाप तेगेत्यार? हिंग ईला; लेकीन आंदुर खुद बंदकु नामी व्हार्या तेगुल.”<verse eid="ACT 16:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38" />सिपाहीगोळ्द अधिकारीगोळ ई मातगोळ्द रोमी शासकगोळी जानकारी कोट्टुर, अदिक आंदुर ईद केळकु कि पौलुस अदिक सीलास रोमन नागरीत्वावाळेर लॉकुर उर, अंजेदुर, <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />आग रोमन अधिकारीगोळ बंदकु आंदुर से माफ विनती माळदुर, अदिक आंदरी बंदीगृह टु व्हार्या तनकु नगर बिटकु होगली हेळदुर. <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />पौलुस अदिक सीलास बंदीगृह टु होटकु लुदिया अन्द ईल होदुर, अदिक विश्वासी वार्टुर से भेंट माळकु आंदरी प्रोत्साहन कोटकु होटोदुर.<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s">थिस्सलुनीके नगर दा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />बाक पौलुस अदिक सीलास अम्फिपुलिस अदिक अपुल्लोनिया आगकु थिस्सलुनीके दा बंदुर, यल यहूदीगोळ्द ऊंद यहूदी लॉकुर्द सभागृह ईरोद. <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />पौलुस तान रीति इन अनुसार सभागृह दा होदुन, अदिक मुर आराम इन दिन नियम शास्त्रगोळ देल यहूदी लॉकुर सांगुळ झगळा माळदुन; <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />अदिक अऊर अर्थ आसान भाषा दा समझुस तोगोन कि मसीह अक दुख नेगोद, अदिक सोत्‍तुर दा टु जित्‍ता माळोद, जरूरी ईरोद; अदिक “ईवा यीशु यार्द बारा दा ना नीमी हेळतीन, मसीह हुन.” <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />आंदुर दा टु येनारा लॉकुर विश्वास माळदुर अदिक पौलुस अदिक सीलास उन सांगुळ मीलुसेदुर. परमेश्वर उन आराधना माळावाळेर हापाळ पुरा गैरयहूदीगोळ भी आंदुर दा मीलुसेदुर, ईंदुर दा मुख्य आर्तेर भी ईरोर,<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />लेकीन यहूदीगोळ जलन देल तुमकु बाजारू लॉकुर दा टु येनारा दुष्ट मंळसागोळी तान सांगुळ दा हुळदुर, अदिक भीळ जमा माळकु नगर दा हल्ला मचुसली कुरतुर, अदिक यासोन उन मान्ना मा चढ़ाई माळकु अदिक कोशिश माळली कुरतुर कि ह्यांगारा तरी पौलुस अदिक सीलास उक लॉकुर मुंद तंदेव. <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />आंदरी अल ईला नोळकु आंदुर ईद चिल्ळासतेला यासोन अदिक येनारा विश्वासी वार्टुरी नगर इन शासकगोळ मुंद जेडुतेला तंदुर अदिक अंदुर, “ई लॉकुर यार सप्पा दी मुसीबत पैदा माळ बुटार, आंदुर नाम नगर दा भी होट बंदार. <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />अदिक यासोन आंदरी तान मान्या ईट्यान. ई सप्पा च्या सप्पा ईद अनतार कि यीशु राजा आन, अदिक कैसर उन नियमगोळ्द विरोध माळतार.” <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />आंदुर लॉकुरी अदिक नगर इन शासकगोळी ईद केळ्सकु भळकुस बुटुर. <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />इदुरसाटी आंदुर यासोन अदिक बाकी लॉकुर से जमानत ताकोमकु आंदरी बिट बुटुर.<verse eid="ACT 17:9" /></para>
  <para style="s">बिरीया नगर दा</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />विश्वासी वार्टुर तुरन्त ईळ्लक इन ईळ्लक इच पौलुस अदिक सीलास उक बिरीया कळु बुटुर; अदिक आंदुर अल पोहचुस्कु यहूदीगोळ्द सभागृह दा होदुर. <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />आ लॉकुर रा थिस्सलुनीके अन्द लॉकुर से भला ईरोर, अदिक आंदुर धोळ लालसा देल वचन ग्रहण माळदुर, अदिक रोज शास्त्रगोळ दा अध्ययन माळ माळकु नोळोर कि जो ई मातगोळ पौलुस हेळदुन अव सही आव का ईला. <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />अदिक इदुर परिणाम स्वरूप हापाळ सा यहूदीगोळ अदिक मानवाईक यूनानी आर्तेर मंळसागोळ भी विश्वास ग्रहण माळदुर. <verse eid="ACT 17:12" /><verse number="13" style="v" sid="ACT 17:13" />लेकीन याग थिस्सलुनीके अन्द यहूदी जान्स कोंडुर कि पौलुस बिरीया दा भी परमेश्वर उन वचन केळ्सतान, रा अल भी बंदकु लॉकुरी भळकुसली अदिक दंगा माळली कुरतुर. <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />आग विश्वासी वार्टुर तुरन्त पौलुस उक विदा माळदुर कि समुद्र अन्द किनारा होटोगुल; लेकीन सीलास अदिक तीमुथियुस अल्या ईतोदुर. <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />पौलुस उक विश्वासी वार्टुर एथेंस ताका ओतुर; अदिक सीलास अदिक तीमुथियुस उन साटी आंदुर पौलुस उन से ईद आग्या ताकोमकु विदा आदुर कि आंदरी नान हात्‍ती जल्दी से जल्दी कळुल.<verse eid="ACT 17:15" /></para>
  <para style="s">एथेंस नगर दा</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />याग पौलुस एथेंस दा तीमुथियुस अदिक सीलास उन हादी कायोन, अदिक एथेंस नगर इक मूर्तीगोळ देल तुमकु नोळकु आव हापाळ निराश आगेदुन. <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />इदुरसाटी आव यहूदी लॉकुर्द सभागृह दा यहूदीगोळ अदिक गैरयहूदीगोळ जो परमेश्वर उन आराधना माळतोगोर, अदिक चौक दा होगा बरावाळेर लॉकुर आऊन से सिकतोगोर आंदुर से हर रोज झगळा माळतोगोन.<verse eid="ACT 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 17:18" />आग इपिकूरी अदिक स्तोईकी गुरुगोळ दा टु थ्वाळासा गुरु आऊन से तर्क माळली कुरतुर, अदिक येनारा अंदुर, “ईव अग्यानी येन अनोद चाहासतान?” लेकीन दुसरा अंदुर, आव “अन्य देवतागोळ्द प्रचारक मालूम बिळतान.” यतिकी आव यीशु उन अदिक आऊन पुनरूत्थान इन खुशखबरी केळ्सतोगोन. <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />आग आंदुर पौलुस उक तान सांगुळ अरियुपगुस इन नगर दा ओतुर अदिक केळदुर, “येन नाव जान्स सकतेव कि ईद व्हाशोद शिक्षा जो नी हेळत्या, येन हुन? <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />यतिकी नी अनोखा मातगोळी नामी केळ्सत्या, इदुरसाटी नाव जानसोद चाहासतेव कि ईऊर्द अर्थ येन आद.” <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />इदुरसाटी कि सप्पा एथेंसवासी अदिक परदेशी जो अल ईरतोगोर, सप्पा आऊन व्हासा व्हासा मातगोळी केळली अदिक हेळदुर दा समय बितुसतोगोर.<verse eid="ACT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />आग पौलुस अरियुपगुस उन नगर इन सभा अन न्याड्या दा निदुरकु अंदुन, हे एथेंस इन लॉकुरा, ना नोळतीन कि नीव हर प्रकार देल धार्मिक आईर. <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />यतिकी ना नगर दा टेटाळतेला याग नीम्द आराधना माळोद जागागोळी नोळीन, रा ऊंद हिंग वेदी भी नोळदीन, यदुर मा लिख्सकु ईरोद, अनजाना परमेश्वर उन साटी. इदुरसाटी यार्द नीव बिना नोळ्द आराधना माळतीर, ना नीमी आऊंद बारा दा हेळतीन. <verse eid="ACT 17:23" /><verse number="24" style="v" sid="ACT 17:24" /><note caller="+" style="x"><char style="xo" closed="false">१७:२४ </char><char style="xt" closed="false"><ref loc="ACT 7:48">प्रेरितगोळ ७:४८</ref></char></note>या परमेश्वर पृथ्वी अदिक अदुर सप्पा वस्तुगोळी माळदुन, आव स्वर्ग अदिक पृथ्वी इन स्वामी आन, अदिक आव कय इन माळ्द मंदिरगोळ दा ईरालुन; <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />ना यातोदु वस्तु उन जरवत इन कारण मंळसागोळ्द कयगोळ्द स्यावा ताकोमतान, यतिकी आव खुद अच सप्पा मुंदरी जीवन अदिक श्वास अदिक सप्पा येनारा कोळतान. <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />आव ऊंद अच मंळसा द्वारा पुरा मंळसागोळ्द पैदा माळदुन अदिक सप्पा पृथ्वी मा आव ईरसकुल इदुरसाटी आव माळदुन. अदिक आव पयले टुच लॉकुर्द समय निश्चित माळ कोंडान अदिक आंदुर निवास इन यल आंदुर ईरतार अदुर्द सीमागोळी कट बुट्टुन, <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />ईद इदुरसाटी माळदुन कि लॉकुर परमेश्वर उक ढुंढसुल, आग सकतद कि आंदुर आऊन ताका पोहचुस्कु हासिल माळ कोमुल, तरी भी आव नाम दा टु यारदु से दुर हैलेच. <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />जसा यावारा अंदान कि</para>
  <para style="q1" vid="ACT 17:28">नाव आऊंदा जित्‍ता ईरतेव, अदिक नळुतेला वयाळतेला ईरतेव, अदिक आऊन दा अच नाम अस्तित्व आद.</para>
  <para style="m" vid="ACT 17:28">ईदा प्रकार खुद नीम्द अच थ्वाळासा कविगोळ भी अंदार,</para>
  <para style="q1" vid="ACT 17:28">नाव रा आऊंदा औलाद हुयेव.<verse eid="ACT 17:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="ACT 17:29" />इदुरसाटी परमेश्वर उन औलाद आगकु नामी ईद समसोद उचित हैलेच कि परमेश्वर उन दिव्य रूप व्हान्ना या पैस्या या कल्ल इन घाई आद, जो मंळसा अन्द कारीगरी अदिक कल्पना देल माळकु आगीदाव. <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />“इदुरसाटी परमेश्वर याग लॉकुर परमेश्वर उक ईला जानसोर आ समयगोळ मा ध्यान कोटीदील, लेकीन ईग हर जागा सप्पा मंळसागोळी मन तिर्गुसोद आग्या कोळतान. <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />परमेश्वर ऊंद दिन निश्चित माळ्यान आ दिशी आव तान निवळुस्द ऊंद मंळसा अन द्वारा सच्चाई देल दुनिया अन न्याय माळ्यान अदिक ई मात इन प्रमाण आव आ मंळसा अक सोत्‍तुर दा टु जित्‍ता माळकु सप्पा मुंदुरी कोटान.”<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />सोत्‍तुर दा टु जित्‍ता आगोद इन मात केळकु थ्वाळासा लॉकुर पौलुस से मज्याक माळली कुरतुर, लेकीन दुसरा थ्वाळासा लॉकुर अंदुर, “नाव ईद मातगोळ नीन से केळोद चाहासतेव.” <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />ईदुर मा पौलुस आंदुर न्याड्या दा टु होटबुटुन. <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />लेकीन थ्वाळासा मंळसा आऊन सांगुळ मीलुसेदुर, अदिक विश्वास माळदुर; यारदा दियुनुसियुस जो नगर सभा अन सदस्य ईरोन, अदिक दमरिस हेसुर इन ऊंद आर्त ईरोर, अदिक आंदुर सांगुळ मात्‍त दुसरा लॉकुर ईरोर.<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s">कुरिन्थुस नगर दा पौलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />इदुर बाद्दा पौलुस एथेंस नगर इक बिटकु कुरिन्थुस नगर दा बंदुन. <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />अल आऊक अक्विला हेसुर इन ऊंद यहूदी सिकदुन, यार्द जनम पुन्तुस दा आगीत. आव तान हिंग्स प्रिसकिल्ला अन्द सांगुळ इटली टु ईग ईग अच बंदीदुन, यतिकी क्लौदियुस सप्पा यहूदीगोळी रोम टु होट्ट बुळोद आग्या कोटीदुन. इदुरसाटी आव आंदुर अल होदुन. <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />आंदुर ऊंदा ऊज्या ईरतोगोर अदिक आंदुर क्याल्सा ऊंदा ईरोद आंदुर तान कमाई इन साटी तम्बू माळोद क्याल्सा माळतोगोर. <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />आव हर ऊंद आराम इन दिन यहूदी लॉकुर्द सभागृह दा झगळा माळकु यहूदीगोळ अदिक गैरयहूदीगोळी भी समझुस तोगोन.<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />याग सीलास अदिक तीमुथियुस मकिदुनिया टु बंदुर, रा पौलुस वचन केळ्सदुर दा पुरा समय कोट्टुन अदिक यहूदीगोळी गवाही कोळली कुरतुन कि यीशु उच मसीह हुन. <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />लेकीन याग आंदुर विरोध अदिक अपमान माळली कुरतुर, रा आव तान कपळा झाळ्सकु आंदुर से अंदुन, “नीम सायोद कारण नीव खुद आईर! ना निर्दोष आईन. अदिक इदुर जिम्मेदार ना हैलेच, ईग टु ना गैरयहूदीगोळ्द हाती होगाईन.” <verse eid="ACT 18:6" /><verse number="7" style="v" sid="ACT 18:7" />अल टु होटकु आव तीतुस यूस्तुस हेसुर इन परमेश्वर उन आराधना माळावाळा ऊंद मंळसा अन्द मान्या बंदुन; यार्द मान्ना यहूदी सभागृह टु हतकु ईरोद. <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />आग सभागृह अन सरदार क्रिसपुस तान सप्पा घराना समेत प्रभु मा विश्वास माळदुन; अदिक हापाळ सा कुरिन्थवासी ईद बातणी केळकु विश्वास माळदुर अदिक बपतिस्मा ताकोंडुर.<verse eid="ACT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />प्रभु ऊंद ईळ्लकी दर्शन इन द्वारा पौलुस से अंदुन, “अंजबाळ, उलटा अनतेला ईर अदिक सुंगा ईरबाळ; <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />यतिकी ना नीन सांगुळ आईन, अदिक याऊ नीन मा चढ़ाई माळकु अपमान हानि माळतीदील; यतिकी ई नगर दा नान हापाळ सा लॉकुर आर.” <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />इदुरसाटी आव आंदुर्दा परमेश्वर उन वचन कल्सतेला दिळ वर्ष ताका ईत्‍तुन.<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />याग गल्लियो अक अखाया द्याश इन शासक माळकु आत, आग यहूदी लॉकुर ऊंद आगकु पौलुस मा येरतेला बंदुर, अदिक आऊक न्याय आसन इन मुंद तंदुर, <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />अदिक अनली कुरतुर, “ईव लॉकुरी समझुस्तान कि परमेश्वर उन उपासना हिंग रीति देल माळी, जो नाम्द व्यवस्था अन्द विपरीत आद.”<verse eid="ACT 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14" />याग पौलुस माताळदुर मा अच ईरोन, रा गल्लियो यहूदीगोळ से अंदुन, “हे यहूदीगोळा, अगर ईद येनारा अन्याय या दुष्टता अन्द मात आगाईत, रा उचित ईरोद कि ना नीम्द केळायदिन. <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />लेकीन अगर ईद झगळा शब्दगोळ, अदिक हेसुरगोळ, अदिक नीम खुद इन व्यवस्था अन्द बारा दा आद, रा नीव अच खुद सुलझुसी; यतिकी ना ई मातगोळ्द न्यायी बनसोद चाहासालीन.” <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />अदिक आव आंदरी न्याय आसन इन मुंद टु तेगसुसबुटुन. <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />आग सप्पा लॉकुर सभागृह अन अध्यक्ष सोस्थिनेस उक हुळकु न्याय आसन इन मुंद बळदुर. लेकीन गल्लियो ई मातगोळ मा ध्यान कोटीदील.<verse eid="ACT 18:17" /></para>
  <para style="s">अन्ताकिया अक वापस होगोद</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />पौलुस हापाळ दिन ताका कुरिन्थुस दा ईत्‍तुन. बाक विश्वासी वार्टुर से विदा ताकोमकु जहाज देल सीरिया होदुन आग आऊन सांगुळ प्रिसकिल्ला अदिक अक्विला भी ईरोर. पौलुस किंख्रिया दा तान मुंडन माळदुन, यतिकी आव ऊंद मन्नत बेळीदुन. <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />आव इफिसुस पोहचुस्कु प्रिसकिल्ला अदिक अक्विला अक अल बिट्टुन, अदिक खुद सभागृह दा होगकु यहूदीगोळ से झगळा माळली कुरतुन. <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />याग अलेर लॉकुर आऊन से विनती माळदुर, “नाम सांगुळ अदिक थ्वाळासा दिन ईर.” रा आव स्वीकार माळीदील; <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />लेकीन ईद अनकु आंदुर से सार आदुन, “अगर परमेश्वर चाहास्यान रा ना नीम हात्‍ती मात्‍त बराईन.” आग आव इफिसुस टु जहाज मा कुर्तकु होटोदुन;<verse eid="ACT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 18:22" />अदिक कैसरिया दा ईळुकु यरूशलेम इक होदुन अदिक मंडली अक मुलाकात माळकु अन्ताकिया दा बंदुन. <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />बाक येनारा दिन अन्ताकिया दा ईतकु गलातिया अदिक फ्रूगिया क्षेत्र टु आगतेला होट्टुन, अदिक सप्पा चेलागोळी विश्वास दा संची माळतेला तिर्गदुन.<verse eid="ACT 18:23" /></para>
  <para style="s">इफिसुस अदिक कुरिन्थुस दा अपुल्लोस</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />अपुल्लोस हेसुर इन ऊंद यहूदी ईरोन, यार्द जनम सिकन्दरिया दा आगीत, जो अक्‍कलवाळा मंळसा ईरोन अदिक शास्त्र अक वळ्लीद तरीका देल जानसोन, इफिसुस दा बंदुन. <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />आव प्रभु उन हादी इन शिक्षा ताकोंडिदुन, अदिक मन हचकु अदिक पुरा उत्साह देल यीशु उन बारा दा वळ्लीद-वळ्लीद केळसोन अदिक कलसोन, लेकीन आव सिर्फ यूहन्ना अन्द बपतिस्मा अन्द मात जानसोन. <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />आव सभागृह दा निडर आगकु माताळली कुरतुन, लेकीन प्रिसकिल्ला अदिक अक्विला आऊंद मातगोळी केळकु आऊक तान मान्या ओतुर अदिक परमेश्वर उन हादी आऊक मात्‍त वळ्लीद-वळ्लीद हेळदुन. <verse eid="ACT 18:26" /><verse number="27" style="v" sid="ACT 18:27" />याग अपुल्लोस निश्चय माळदुन कि आप्पारी ईळुकु अखाया अक होदेव इफिसुस उन विश्वासी वार्टुर आऊन हिम्मत वाळुसदुर अदिक अखाया अन अनुयायीगोळी आऊन स्वागत माळोर साटी ऊंद चिट्ठी कळुदुर; अदिक आव अल पोहचुस्कु आ लॉकुर्द बळा सहायता माळदुन जो परमेश्वर उन अनुग्रह अन कारण विश्वास दा बंदीदुर. <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />यतिकी आव शास्त्र देल प्रमाण कोट कोटकु कि यीशु उच मसीह हुन, धोळ प्रबलता देल यहूदीगोळ्द सप्पा मुंदुर मुंद बोलती बंद माळ्त ईत्‍तुन.<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s">इफिसुस नगर दा पौलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />याग अपुल्लोस कुरिन्थुस दा ईरोन, रा पौलुस म्याकुच इन सप्पा प्रदेश टु यात्रा माळतेला इफिसुस दा बंदुन. अल आऊक थ्वाळासा चेलागोळ सिकदुर<verse eid="ACT 19:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 19:2" />आव आंदुर से केळदुन, “येन नीव विश्वास माळावती पवित्र आत्मा अक नोळदीर?” आंदुर आऊन से अंदुर, “नाव रा पवित्र आत्मा अन्द चर्चा भी केळीदील.”<verse eid="ACT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3" />आव आंदुर से अंदुन, “रा बाक नीव यार्द बपतिस्मा ताकोंडीर?” आंदुर अंदुर,</para>
  <para style="p" vid="ACT 19:3">“यूहन्ना अन्द बपतिस्मा.”<verse eid="ACT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१९:४ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:11">मत्ती ३:११</ref>; <ref loc="MRK 1:4">मरकुस १:४</ref>,<ref loc="MRK 1:7">७</ref>,<ref loc="MRK 1:8">८</ref>; <ref loc="LUK 3:4">लूका ३:४</ref>,<ref loc="LUK 3:16">१६</ref>; <ref loc="JHN 1:26">यूहन्ना १:२६</ref>,<ref loc="JHN 1:27">२७</ref></char>
    </note>पौलुस अंदुन, यूहन्ना आंदरी बपतिस्मा कोट्टुन कि आंदुर तान पापगोळ देल तिरगुल, कि जो नान बाद्दा बरावाळा आन, आऊन मा मतलब यीशु मा विश्वास माळेतीर.<verse eid="ACT 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5" />ईद केळकु आंदुर प्रभु यीशु उन हेसुर दा बपतिस्मा ताकोंडुर. <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />याग पौलुस आंदुर मा कय ईटदुन, रा पवित्र आत्मा आंदुर मा ईळुत, अदिक आंदुर अलग-अलग भाषा माताळली अदिक भविष्यवाणी माळली कुरतुर. <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />इंदुर सप्पा लगभग हन्नेळ मंळसा ईरोर.<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />आव यहूदी सभागृह दा होगकु मुर तिंगुळ ताका निडर आगकु माताळतेला ईत्‍तुन, अदिक परमेश्वर उन राज्य अन्द बारा दा झगळा माळतेला अदिक समझुसतेला ईत्‍तुन. <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />लेकीन याग येनारा लॉकुर कठोर आगकु आऊंद मान्सीदील उलटा लॉकुर मुंद ई हादी अक बेकार अनली कुरतुर, रा आव आंदरी बिट बुटुन अदिक चेलागोळी अलग माळ बुटुन, अदिक रोज तुरन्नुस उन शिक्षा अन मान्ना दा झगळा माळतोगोन. <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />येढ्ढ वर्ष ताका ईदा आगतेला ईत्‍त, ईल ताका कि आसिया नोर ईरावाळेर येन यहूदी येन गैरयहूदी सप्पा प्रभु उन वचन केळ कोंडुर.<verse eid="ACT 19:10" /></para>
  <para style="s">स्केवा अन पार</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />परमेश्वर पौलुस उन कयगोळ देल सामर्थ्य अन्द अनोखा क्याल्सा तोर्सतोगोन. <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />ईल ताका कि रूमाल अदिक गमछा आऊन मय देल स्पर्श माळसुसकु बिमारगोळ मा हाकतोगोर, अदिक आंदुर बिमारीगोळ होग्त ईरतोगोव; अदिक दुष्टआत्मागोळ आंदुर दा टु होट बुळतोगव. <verse eid="ACT 19:12" /><verse number="13" style="v" sid="ACT 19:13" />लेकीन येनारा यहूदी जो झाळ फुक माळ्त टेटाळोर, आंदुर प्रभु यीशु मसीह अन हेसुर इस्तेमाल माळली कुरतुर आंदुर दुष्टआत्मागोळी अनतोगोर, “या यीशु उन प्रचार पौलुस माळतान, ना नीमी आ यीशु उन हेसुर देल आग्या कोळतीन.” <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />अदिक स्क्किवा हेसुर इन ऊंद यहूदी प्रधान याजक उन येळ चिकोर ईरोर, जो हिंग माळतोगोर.<verse eid="ACT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 19:15" />लेकीन दुष्टआत्मा आंदरी उत्‍तर कोळ्त, “यीशु उक ना अरूतीन, अदिक पौलुस उक भी अरूतीन, लेकीन नीव यार हुईर?”<verse eid="ACT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 19:16" />अदिक आ मंळसा यारदा दुष्टआत्मा ईरोद आंदुर मा हावी आगकु अदिक आंदरी वश दा तनकु, आंदरी हिंग बडुत कि आंदुर ऊगळा अदिक घायल आगकु आ मान्या टु होटकु ओळदुर. <verse eid="ACT 19:16" /><verse number="17" style="v" sid="ACT 19:17" />ईद मात इफिसुस इन ईरावाळेर सप्पा यहूदी अदिक गैरयहूदी भी जान्स कोंडुर, अदिक आ सप्पा मुंदुर दा अंज्क तुम्मेत; अदिक प्रभु यीशु उन हेसुर इन बळाई आत. <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />यार विश्वास माळीदुर, आंदुर दा टु हापाळ मुंदुर बंदकु तान तान बेकार क्याल्सागोळी मान्स कोंडुर अदिक अल बंदुर. <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />जादू माळावाळेर दा टु हापाळ मुंदुर तान तान पोथळीगोळी जमा माळकु सप्पा मुंदुर मुंद होताक बुटुर, अदिक याग अऊर्द दाम जोळ्सकु आत, रा पचास हजार बेळ्ली इन सिक्‍कागोळ बराबर होळ्त. <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />ई प्रकार प्रभु उन वचन बलपूर्वक फैलुस्त अदिक मजबूत आगतेला होत.<verse eid="ACT 19:20" /></para>
  <para style="s">इफिसुस नगर दा दंगा</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />याग ई मातगोळ आगेदव रा पौलुस मन दा ठान्सदुन कि मकिदुनिया अदिक अखाया टु आगकु यरूशलेम इक होगाईन, अदिक अंदुन, “अल होगदुर बाद्दा नानी रोम इक भी नोळोद जरूरी आद.” <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />इदुरसाटी तान स्यावा माळावाळेर दा टु तीमुथियुस अदिक इरास्तुस उक मकिदुनिया कळुकु खुद थ्वाळासा दिन आसिया दा ईतोदुन.<verse eid="ACT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />आ समय इफिसुस दा प्रभु उन हादी इन बारा दा बळा हंगामा आत. <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />अल बेळ्ली इन क्याल्सा माळावाळा देमेत्रियुस हेसुर इनव ऊंद सोनार ईरतोगोन आव देवी अरतिमिस इन बेळ्ली इन मंदिर माळतोगोन, यदुर देल कारीगरगोळी हापाळ फायदा सिकतोगोद. <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />आव आंदरी अदिक हिंग अच वस्तुगोळ्द कारीगरगोळी जमा माळकु अंदुन, “हे मंळसागोळा, नीव जान्सतीर कि ई क्याल्सा देल नामी याट धन सिकतद. <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />नीव नोळतीर अदिक केळतीर कि सिर्फ इफिसुस अच दा ईला, उलटा सप्पा आसिया क्षेत्र दा ईद अन अनकु ई पौलुस हापाळ सा लॉकुरी समझुसदुन, कि जो कय इन कारीगरी आद, आंदुर परमेश्वर आल्लच. <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />इदुर देल ईग सिर्फ ईदा मात इन अच अंज्क हैलेच कि नाम ई धंदा अन्द महत्व होग्त ईत्‍तीत, उलटा ईद कि महान देवी अरतिमिस इन मंदिर तुच्छ सम्सकु आदीत, अदिक यारी सप्पा आसिया अदिक दुनिया पुजा माळतद आकिन महत्व भी होग्त ईत्‍तीत.”<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />आंदुर ईद केळकु सिट्ट देल तुम्मेदुर अदिक चिल्ळास चिळ्लासकु अनली कुरतुर, इफिसिगोळ अरतिमिस देवी, महान आर! <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />अदिक सप्पा नगर दा धोळ्द हंगामा मचुसेत, अदिक लॉकुर गयुस अदिक अरिस्तर्खुस उक जो पौलुस उन संगी यात्री ईरोर जो मकिदुनिया टु बंदीदुर, आंदरी हुळ्द बुटुर, अदिक नाटक घर दा ओतुर. <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />याग पौलुस लॉकुर्द हात्‍ती बुळ्क होगोद चाहासदुन रा चेलागोळ आऊक होग गोटीदील. <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />आसिया नोर शासकगोळ दा टु भी आऊन कई संगीगोळ आऊन हात्‍ती बातणी कळुदुर अदिक विनती माळदुर कि नाटक घर दा होगकु जोखिम नेगुबाळेत. <verse eid="ACT 19:31" /><verse number="32" style="v" sid="ACT 19:32" />अल यावारा येनारा चिल्ळासोन रा यावारा येनारा, यतिकी सभा दा बळा गळबळी आगोद, अदिक हापाळ सा लॉकुर रा ईद जानसोर भी ईला कि नाव यदुर साटी जमा आगेव. <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />आग आंदुर सिकन्दर उक, यारी यहूदीगोळ निदरूसिदुर, भीळ दा टु मुंद वाळुसदुर. सिकन्दर कय देल इशारा माळकु लॉकुर मुंद खुद इन बचाव इन साटी भाषण कोळोद चाहासोन. <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />लेकीन याग आंदुर जान्स कोंडुर कि आव यहूदी हुन, रा सप्पा च्या सप्पा ऊंद आवाज देल कम से कम येढ्ढ तास ताका चिल्ळासतेला ईत्‍तुर, “इफिसिगोळ अरतिमिस, महान आर.”<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />आग नगर इन लेखा जोखा ईटावाळा लॉकुरी शांत माळकु अंदुन, “हे इफिसुस इन लॉकुरा, येन दुनिया दा हिंग यावारा मंळसा आन जो जान्सालुन कि इफिसिगोळ नगर इन महान देवी अरतिमिस, मंदिर इन अदिक स्वर्ग टु बिळावाळा पवित्र कल्ल इन रक्षा माळावळ्त उर. <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />इदुरसाटी जब कि ई मातगोळ्द खंडन अच आगसकाल, रा उचित आद कि नीव शांत ईरी अदिक बिना सोच्द सम्द येनु माळबाळी. <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />यतिकी नीव ई मंळसागोळी तंदीर जो ना मंदिर इन लुटसावाळेर आर ना नाम देवी इन अपमान माळावाळेर उर. <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />अगर देमेत्रियुस अदिक आऊन संगी कारीगरगोळी यारदारा से शिकायत आद रा कचेरी खुला आद अदिक शासक भी आन; अल होगकु आंदुर आबुर दाबुर मा आरोप हचुल. <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />लेकीन अगर नीव यातोदारा दुसरा मात इन बारा दा येनारा केळोद चाहास्तीर, रा कानूनी सभा दा फैसला माळकु आदीत. <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />यतिकी ईंद इन दंगा अन्द कारण नाम मा दोष हच्चोद अंज्क आद, इदुरसाटी कि इदुर येनु कारण हैलेच, अदिक नाव ई भीळ इन जमा आगोद येनु उत्‍तर कोळ सकालेव.” <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />ईद अनकु नगर इन लेखा जोखा कोळावाळा सभा अक सार माळदुन.<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s">मकिदुनिया अदिक अखाया दा पौलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />याग दंगा थामसेत रा पौलुस चेलागोळी कारसुसकु हिम्मत वाळुसदुन, अदिक आंदुर से सार आगकु मकिदुनिया अन्द दी होटोदुन. <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />आ सप्पा प्रदेश दा टु आगकु अदिक चेलागोळी हापाळ उत्साहीत माळकु आव अखाया दा बंदुन. <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />याग मुर तिंगुळ ईतकु आव अल टु जहाज मा सीरिया अन दी होगोन, रा यहूदी आऊक कोनली ताक दा हतकु ईरोर, इदुरसाटी आव ईद निश्चय माळदुन कि मकिदुनिया आगकु वापस आगेगुल. <verse eid="ACT 20:3" /><verse number="4" style="v" sid="ACT 20:4" />बिरीया अन्द पुर्रुस उन पार सोपत्रुस अदिक थिस्सलुनीके अन्द अरिस्तर्खुस अदिक सिकुन्दुस, अदिक दिरबे अन्द गयुस, अदिक तीमुथियुस, अदिक आसिया अन्द तुखिकुस अदिक त्रुफिमुस आसिया ताका आऊन सांगुळ ईरोर. <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />आंदुर मुंद होटोदुर अदिक त्रोआस दा नाम हादी कायतेला ईत्‍तुर. <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />अदिक नाव अखमीरी रोट्टी इन हाब्ब खतम आगदुर बाद्दा फिलिप्पी टु जहाज देल होटकु अईद दिन इन बाद्दा त्रोआस दा बंदकु आंदुर से मुलाकात माळदेव, अदिक ऊंद हप्ता अल्या ईत्‍तेव.<verse eid="ACT 20:6" /></para>
  <para style="s">पौलुस उन त्रोआस दा आखरी मुलाकात</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />बाक नाव शण्यार इन द्यावगा याग ऊमोर साटी आपस दा जमा आदेव, रा पौलुस आंदुर से मातचीत हेळली कुरतुन, आऊक दुसरा दिशी इच होगोद ईरोद, इदुरसाटी आव आर्धा ईळ्लक ताका मातगोळी हेळतेला ईत्‍तुन. <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />या म्याकुच इन कमरा दा नाव जमा ईरेव, अदुर दा हापाळ दिंग्या होत्‍तव. <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />अदिक यूतुखुस हेसुर इन ऊंद हारोदव खिळकी मा कुर्तकु भर जप्प देल डोलसोन. याग पौलुस हापाळ होत ताका मातगोळी हेळतेला ईत्‍तुन रा आव जप्प इन झ्वाका देल तिसरा मंजील मा टु ल्यालमा बिद्दुन, अदिक याग आंदुर आऊक नेगदुर रा आव सोतोगीदुन. <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />लेकीन पौलुस ल्यालमा ईळदुन अदिक आऊन से लपटुसेदुन, अदिक कुतक्या हतकु अंदुन, “घबरूसबाळी; यतिकी आव जित्‍ता आन.” <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />अदिक पौलुस म्याकुच होगकु ऊंडुन अदिक ईट होत ताका आंदुर से मातगोळी हेळतेला ईत्‍तुन कि व्हातुर आगेत. बाक आव होटोदुन. <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />अदिक आंदुर आ हारोदव पार उक जित्‍ता तंदुर अदिक हापाळ शांती सिक्त.<verse eid="ACT 20:12" /></para>
  <para style="s">त्रोआस टु मिलेतुस इक होगोद</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />नाव पयले अच जहाज मा कुर्तकु अस्सुस इक ईद विचार देल मुंद होदेव कि अल टु नाव पौलुस उक सांगुळ हुडुकोंडेव, यतिकी आव ईद इदुरसाटी ठहरूसीदुन कि खुद अच पैदल बरोद चाहासोन. <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />याग पौलुस अस्सुस दा नामी सिकदुन रा नाव आऊक जहाज दा कुर्सकु मितुलेने नगर दा वळेदेव. <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />अल टु जहाज दा कुर्तकु नाव दुसरा दिशी खियुस नगर इन मुंद पोहचुसदेव, अदिक दुसरा दिशी सामुस नगर दा बंदेव; बाक अदुर दुसरा दिशी नाव मिलेतुस नगर दा बंदेव. <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />यतिकी पौलुस इफिसुस उन हात्‍ती टु आगकु होगोद निश्चय माळीदुन कि येल्यारा हिंग आगबाळुल कि आऊक आसिया दा समय हतुल; यतिकी आव जल्दी दा ईरोन कि अगर आग सकुल रा आव पिन्तेकुस्त हाब्ब दिशी यरूशलेम दा ईरूल.<verse eid="ACT 20:16" /></para>
  <para style="s">पौलुस उन इफिसुस उन स्याणागोळी आखरी भाषण</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />पौलुस मिलेतुस नगर टु इफिसुस नगर दा बातणी कळुदुन, अदिक मंडली अन्द स्याणागोळी कार्सुसदुन. <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />याग आंदुर आऊन हात्‍ती बंदुर, रा आव अंदुन: नीव जान्सतीर कि पयला अच दिशी टु याग ना आसिया दा पहुचुसदीन, ना हर समय नीम सांगुळ याता प्रकार देल ईत्‍तीन. <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />मतलब बळा नम्रता देल, अदिक वर्ल वर्लकु, अदिक आ परीक्षागोळ दा जो यहूदीगोळ्द साजीश इन कारण नान मा बंदकु बित्‍त, ना प्रभु उन स्यावा माळतेला अच ईत्‍तीन; <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />अदिक जो जो मातगोळ नीम फायदा नव ईरव, आंदरी हेळली अदिक लॉकुर्द मुंद अदिक मानोन मान्नी कलसोर से यागलु हिंद आगीदील, <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />उलटा यहूदीगोळ अदिक गैरयहूदीगोळ्द मुंद गवाही कोळ्त ईत्‍तुन कि परमेश्वर उन दी मन तिर्गुसोद अदिक नाम प्रभु यीशु मसीह मा विश्वास माळ पायजे. <verse eid="ACT 20:21" /><verse number="22" style="v" sid="ACT 20:22" />ईग नोळी, ना पवित्र आत्मा अन आग्या अन अनुसार यरूशलेम इक होगतीन, अदिक जान्सालीन कि अल नान मा येन येन बितसीत; <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />ना रा बस ईट चाहासतीन कि हर ऊंद नगर दा पवित्र आत्मा नानी चेतावनी कोळतद कि बंदीगृह अदिक मुश्किल घळीगोळ नान हादी कायताव. <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" /><note caller="+" style="x"><char style="xo" closed="false">२०:२४ </char><char style="xt" closed="false"><ref loc="2TI 4:7">२ तीमुथियुस ४:७</ref></char></note>लेकीन ना तान जीव इक येनु समसालीन, सिर्फ ईट चाहासतीन कि प्रभु यीशु उन कोळ्द क्याल्सा अक पुरा माळाईन, जो क्याल्सा आव नानी कोटान, अदिक अद क्याल्सा ईद कि परमेश्वर उन अनुग्रह अन्द खुशखबरी इन घोषणा माळाईन.<verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />ना परमेश्वर उन राज्य अन प्रचार नीम सप्पा मुंदुर दा माळ्त ओयाळदिन, अदिक ना जान्सतीन कि नीम दा टु नानी यावारा भी यागलु नोळ सकतीदिल. <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />इदुरसाटी ना ईंद इन दिशी पुरा रीति अदिक सफाई देल नीम से अनतीन, कि नीम नाश इन जिम्मेदार ना आल्लच ना निर्दोष आईन. <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />यतिकी ना परमेश्वर उन पुरा योजना जो नीम साटी आव, पुरा रीति देल हेळोर साटी हिंद आगीदील. <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />तान अदिक तान लॉकुर्द पुरा गुट इन देखभाल माळावाळेर बन्सी यतिकी पवित्र आत्मा आंदुर दा टु नीमी आंदुर्द चिंता माळावाळा माळ्यान, कि नीव परमेश्वर उन मंडली अन्द रखवाली माळी, यारी आव तान खुन देल कोंडीदुन. <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />ना जान्सतीन कि नान होगदुर बाद्दा भयंकर लांडग्यागोळ नीम लॉकुर न्याड्या होक्‍केव अदिक अव ई भोला भाला लॉकुर गुट इक बिळतीदील. <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />हिंग समय बंदीत कि नीम्द अच न्याड्या दा टु भी हिंग-हिंग लॉकुर येद्दार जो चेलागोळी तान हींद जेडुली उलटा सिधा मातगोळी हेळ्यार. <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />इदुरसाटी सावधान ईरी, अदिक याद ईटेतीर कि ना मुर वर्ष ताका ईळ्ल हागुल वर्ल वर्लकु हर ऊंद मंळसा अक कलसीन.<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />अदिक ईग ना नीमी परमेश्वर उक, अदिक आऊन अनुग्रह अन्द बातणी इन कय दा सोप्स बुळतीन; जो नीमी पवित्र माळ सकतान अदिक सप्पा लॉकुर दा सप्पा आशीष कोळ सकतान. <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />ना यारदारा बेळ्ली, व्हान्ना या कपळा अन लालच माळीदील. <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />नीव खुद अच जान्सतीर कि ईवा कयगोळ नान अदिक नान संगीगोळ्द जरवत पुरा माळदव. <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />ना नीमी सप्पा येनारा माळकु तोर्सदीन कि ईद रीति देल मेहनत माळतेला निर्बलगोळी संभालसोद अदिक प्रभु यीशु उन वचन याद ईटोद जरूरी आद, जो आव खुद अच अंदिदुन: ताकोमोर से कोळोद वळ्लीद आद.<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />ईद अनकु पौलुस आंदुर सांगुळ ट्वांगरा टेक्सदुन प्रार्थना माळदुन. <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />आग आंदुर सप्पा मुंदुर हापाळ वर्लदुर अदिक पौलुस उन कुतक्या हुडुकु आऊन चुम्मा ताकोमली कुरतुर अदिक सार माळदुर. <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />आंदुर खास माळकु ई मात देल शोक दा ईरोर जो आव अंदिदुन कि नीव नान मार्रा बाक नोळतीदिल. आग आंदुर आऊक जहाज ताका पोहचुसदुर.<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s">पौलुस उन यरूशलेम इक होगोद</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />याग नाव आंदुर से अलग आगकु जहाज खोल्सदेव, रा सरका हादी देल कोस नगर दा बंदेव, अदिक दुसरा दिशी रूदुस दा अदिक अल टु पतरा दा होदेव. <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />अल ऊंद जहाज फिनीकी अक होगतेला सिक्त, अदिक नाव अदुर मा येरकु अदुर मा कुर्तोदेव. <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />याग साइप्रस कांळ्सत, रा नाव अदरी डाक्या कय दी बिट्टेव, अदिक सीरिया अक नळुकु सूर दा ईळदेव; यतिकी अल जहाज इन माल ईळसोद ईरोद. <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />अल नामी थ्वाळासा विश्वासीगोळ सिकदुर अदिक नाव अल येळ दिन ताका ईत्‍तेव. आंदुर आत्मा अन्द सामर्थ्य अन द्वारा पौलुस से अंदुर कि यरूशलेम होगबाळेत. <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />बाक अल रूकसोद नाम समय पुरा आगेत, रा नाव आंदुर से विदा ताकोमकु अल टु सार आगेदेव; अदिक सप्पा मुंदुर आर्तेर अदिक चिकोर समेत नामी नगर इन व्हार्या ताका पोहचुसदुर; अदिक नाव किनारा मा ट्वांगरा टेक्सकु प्रार्थना माळदेव, <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />आग आबुर दाबुर से विदा आगकु, नाव रा जहाज मा येरदेव अदिक आंदुर तान तान मान्नी वापस होटोदुर.<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />आग नाव सूर टु जलयात्रा पुरा माळकु पतुलिमयिस दा पोहचुसदेव, अदिक विश्वासी वार्टुरी नमस्कार माळकु आंदुर सांगुळ ऊंद दिन ईत्‍तेव. <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" /><note caller="+" style="x"><char style="xo" closed="false">२१:८ </char><char style="xt" closed="false"><ref loc="ACT 6:5">प्रेरितगोळ ६:५</ref>; <ref loc="ACT 8:5">८:५</ref></char></note>दुसरा दिशी नाव अल टु नळुकु कैसरिया दा बंदेव, अदिक फिलिप्पुस खुशखबरी प्रचारक उन मान्या जो निवळुस्द विशेष येळ सेवकगोळ दा टु ऊंद ईरोन; होगकु आऊन मान्या ईत्‍तेव. <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />आऊन नाक कुवारा पोरगोळ ईरोर, जो परमेश्वर उन दी टु बरावाळा बातणी कोळतोगोर. <verse eid="ACT 21:9" /><verse number="10" style="v" sid="ACT 21:10" /><note caller="+" style="x"><char style="xo" closed="false">२१:१० </char><char style="xt" closed="false"><ref loc="ACT 11:28">प्रेरितगोळ ११:२८</ref></char></note>याग नाव अल हापाळ दिन ईत कोंडेव, रा अगबुस हेसुर इन ऊंद भविष्यवक्ता यहूदिया टु बंदुन. <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />आव नाम हात्‍ती बंदकु पौलुस उन पट्टा ताकोंडुन, अदिक तान कय काल कटकु अंदुन, “पवित्र आत्मा ईद अनतद कि याता मंळसा अन्द ईद पट्टा हुन, आऊक यरूशलेम दा यहूदी ईदा रीति देल कट्यार, अदिक गैरयहूदीगोळ कय दा सोपस्यार.”<verse eid="ACT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12" />याग नाव ई मातगोळ केळदेव, रा नाव अदिक अलेर लॉकुर आऊन से विनती माळदुर कि यरूशलेम इक होगबाळुल. <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />लेकीन पौलुस उत्‍तर कोट्टुन, “नीव येन माळतीर, हिंग वर्ल वर्लकु नान मन मुरूतीर? ना रा प्रभु यीशु उन हेसुर इन साटी यरूशलेम दा सिर्फ कटकु आगोर साटी अच ईला उलटा सायोर साटी भी तयार आईन.”<verse eid="ACT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 21:14" />याग आव मान्सीदील रा नाव ईद अनकु चुप आगेदेव, “प्रभु उन इच्छा पुरा आगुल.”<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />अल काईक दिन ईत्‍तुर बाद्दा नाव तयारी माळदेव अदिक यरूशलेम इक होटोदेव. <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />कैसरिया टु भी थ्वाळासा चेलागोळ नाम सांगुळ आगेदुर, अदिक नामी मनासोन हेसुर इन साइप्रस इन ऊंद हाळव चेला अन्द मान्या तंदुर, कि नाव आऊन मान्या इत्‍तेव.<verse eid="ACT 21:16" /></para>
  <para style="s">पौलुस उन याकूब उन से मुलाकात</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />याग नाव यरूशलेम दा पोहचुसदेव, रा विश्वासी वार्टुर बळा खुशी इन सांगुळ नाम स्वागत माळदुर. <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />दुसरा दिशी पौलुस नामी हुळकु याकूब उन हात्‍ती होदुन, यल सप्पा स्याणा लॉकुर जमा ईरोर. <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />आग पौलुस आंदरी नमस्कार माळकु, जो जो क्याल्सा परमेश्वर आऊन सेवकाई इन द्वारा गैरयहूदीगोळ दा माळीदुन, ऊंद ऊंद माळकु सप्पा हेळदुन. <verse eid="ACT 21:19" /><verse number="20" style="v" sid="ACT 21:20" />आंदुर ईद केळकु परमेश्वर उन महिमा माळदुर, बाक आऊन से अंदुर, “हे वार्ट पौलुस, नी नोळत्या कि यहूदीगोळ दा टु कई हजार लॉकुर विश्वास माळदुर; अदिक सप्पा व्यवस्था अन साटी धुन हचकु आर. <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />आंदरी नीन बारा दा कल्सकु आग्याद कि नी गैरयहूदीगोळ दा ईरावाळेर यहूदीगोळी मूसा अन व्यवस्था अक बिट बुळोद कल्सत्या, अदिक अनत्या, कि ना तान चिकोर्द खतना माळसुसी अदिक ना रीतिगोळ मा नळी. <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />रा बाक येन माळ पायजे? लॉकुर जरूर केळ्यार कि नी बंद्या. <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />इदुरसाटी जो नाव नीन से अनतेव, अद माळ. नाम ईल नाक मंळसा आर यार मन्नत बेळ्यार. <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />आंदरी हुळकु आंदुर सांगुळ तान तान इक शुद्ध माळ; अदिक आंदुर साटी खर्चा माळ कि आंदुर मुंडन आगुल. आग सप्पा जान्स कोंडार कि जो मातगोळ आंदरी नीन बारा दा हेळकु आग्याद, अऊर्दा येनु सच्चाई हैलेच लेकीन नी खुद भी मूसा अन व्यवस्था अक मान्सकु अदुर अनुसार नळुत्या. <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" /><note caller="+" style="x"><char style="xo" closed="false">२१:२५ </char><char style="xt" closed="false"><ref loc="ACT 15:29">प्रेरितगोळ १५:२९</ref></char></note>लेकीन आ गैरयहूदीगोळ्द बारा दा यार विश्वास माळ्यार, नाव ईद निर्णय माळकु आंदरी चिट्ठी लिख्सकु कळुदेव कि आंदरी येनारा ईत्‍ता भोजन ईला तिन पायजे जो मूर्तीगोळ मा बली येर्सकु आग्याद, अदिक खुन देल अदिक कुतक्या वत्‍त पशु उन मास देल, अदिक व्यभिचार देल ऊळ्दकु ईरूल.”<verse eid="ACT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />ई प्रकार पौलुस आ मंळसागोळी तान सांगुळ हुळदुन, अदिक दुसरा दिशी आंदुर सांगुळ शुद्धीकरण इन रीति इन अनुसार तान तान इक शुद्ध माळदुन अदिक मंदिर दा होदुन यल आव घोषणा माळदुन, कि शुद्धीकरण इन दिन याग पुरा आदव अदिक नाम दा टु हर ऊंद मंळसा अन साटी चढ़ावा याग येर्सकु आदीत.<verse eid="ACT 21:26" /></para>
  <para style="s">मंदिर दा पौलुस उक हुडुकु आगोद</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />याग अव येळ दिन पुरा आगदुर मा ईरव, रा आसिया अन यहूदीगोळ पौलुस उक मंदिर दा नोळकु सप्पा भीळ इक भळकुस बुटुर, अदिक पौलुस उक हुडुकोंडुर, <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />आंदुर चिळ्लासकु अनली कुरतुर, “हे इस्त्राएलगोळा, सहायता माळी; ईव आवा मंळसा हुन, जो इस्त्राएली लॉकुर्द, अदिक मूसा अन व्यवस्था अन, अदिक ई मंदिर इन विरोध दा हर जागा सप्पा लॉकुरी कल्सतान, ईल ताका कि गैरयहूदीगोळी भी मंदिर दा तनकु आव ई पवित्र जागा अक अपवित्र माळ्यान.” <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" /><note caller="+" style="x"><char style="xo" closed="false">२१:२९ </char><char style="xt" closed="false"><ref loc="ACT 20:4">प्रेरितगोळ २०:४</ref></char></note>आंदुर हिंग इदुरसाटी अंदुर, यतिकी आंदुर इदुर से पयले इफिसुसवासी त्रुफिमुस उक आऊन सांगुळ नगर दा नोळीदुर, अदिक समसीदुर कि पौलुस आऊक मंदिर दा हुळकु बंदान.<verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />आग सप्पा नगर भळकुसेत, अदिक लॉकुर ओळकु जमा आदुर अदिक पौलुस उक हुळकु मंदिर इन व्हार्या जेडुकु तंदुर, अदिक तुरन्त दरवाजा बंद माळकु आदव. <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />याग भीळ इन लॉकुर आऊक कोंद बुळोद चाहासोर, रा रोमी तुकळी इन सेनानायक उक खबर सिक्त कि पुरा यरूशलेम दा खलबली मचुसेग्याद. <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />आग आव तुरन्त सैनिकगोळी अदिक सूबेदारगोळी हुळकु आंदुर हात्‍ती ल्यालमा ओळकु बंदुन; अदिक आंदुर पलटन इन सूबेदार उक अदिक सैनिकगोळी नोळकु पौलुस उक बडोद बिट बुटुर. <verse eid="ACT 21:32" /><verse number="33" style="v" sid="ACT 21:33" />आग रोमी सेनानायक पौलुस उन हात्‍ती बंदुन अदिक आऊक बंदी माळ कोंडुन; अदिक आव आऊक येढ्ढ शंकलीगोळ देल कटोद आग्या कोटकु केळदुन, “ईव याव हुन अदिक ईव येन माळ्यान?” <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />लेकीन भीळ दा टु यावारा येनारा रा यावारा येनारा चिल्ळासतेला ईत्‍तुर. याग आव दंगा इन कारण निश्चित रूप देल सच्चाई जान्स सकिदील, रा आऊक किला दा ओयोद आग्या कोट्टुन. <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />याग आव सीळी मा पोहचुसदुन, रा हिंग आत कि भीळ इन दबाव इन कारण सैनिकगोळी आऊक नेगुकु ओयोद बित्‍त, <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />यतिकी लॉकुर्द भीळ ईद चिल्ळासतेला आऊन हिंद बिदकु ईरोद, “आऊक कोंद बुळी.”<verse eid="ACT 21:36" /></para>
  <para style="s">पौलुस उन खुद इक ऊळसोद</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />याग सैनिक पौलुस उक किला दा ओयोर मा ईरोर, रा आव रोमी सेनानायक से अंदुन, “येन नानी आग्या आद कि ना नीन से येनारा अनाईन?”</para>
  <para style="p" vid="ACT 21:37">आग सेनानायक आव अंदुन, “येन नी ग्रीक भाषा माताळत्या? <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />येन नी आव मिस्त्री मंळसा रा आल्लच, याव थ्वाळासा समय पयले विद्रोह सुरू माळसुसिदुन, अदिक जो ईल रेगिस्तान दा नाक हजार कटारबन्द आतंकवादीगोळ्द अगुवाई माळोन?”<verse eid="ACT 21:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39" />आग पौलुस अंदुन, “ना रा तरसुस इन यहूदी मंळसा हुईन! किलिकिया अन्द प्रसिद्ध नगर इन निवासी हुईन. ना नीन से विनती माळतीन कि नानी लॉकुर से मातगोळी हेळगोळ.”<verse eid="ACT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40" />याग आव आग्या कोट्टुन, रा पौलुस सीळी मा निदुरकु लॉकुरी कय देल इशारा माळदुन. याग आंदुर चुप आगेदुर रा आव इब्रानी भाषा दा माताळली कुरतुन:<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />“हे वार्टुरा अदिक आप्प उन घाई सज्जनगोळा, नान बचाव दा जो नानी माताळोद आद अदरी केळी, जो ना ईग नीम मुंद प्रस्तुत माळतीन.” <verse eid="ACT 22:1" /><verse number="2" style="v" sid="ACT 22:2" />आंदुर ईद केळकु कि आव नाम से इब्रानी भाषा दा माताळतान, रा आंदुर मात्‍त यक्कुल चुप आगेदुर. आग आव अंदुन:<verse eid="ACT 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२२:३ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 5:34-39">प्रेरितगोळ ५:३४-३९</ref>
      </char>
    </note>“ना रा ऊंद यहूदी मंळसा हुईन, किलिकिया अन तरसुस दा पैदा आदीन; लेकीन ईदा यरूशलेम नगर दा गमलीएल इन कालगोळ्द हात्‍ती कुर्तकु पुर्वजगोळ्द नियमगोळी कठिन निर्देशगोळी प्राप्त माळदीन, अदिक परमेश्वर उन साटी हिंग धुन हचकु ईरीन, ह्यांग नीव सप्पा ईंद हचकु आईर. <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" /><note caller="+" style="x"><char style="xo" closed="false">२२:४ </char><char style="xt" closed="false"><ref loc="ACT 8:3">प्रेरितगोळ ८:३</ref>; <ref loc="ACT 26:9-11">२६:९-११</ref></char></note>ना मंळसा अदिक आर्तेर येढ्ढु मुंदरी कैदी माळ माळकु बंदीगृह दा हाकदीन, ई हादी मा नळावाळेर इक ईल ताका सतुसदीन कि आंदरी कोन्सुस भी बुटीन. <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />ना सही माताळतीन ई मात इन साटी महायाजक अदिक सप्पा स्याणागोळ गवाह आर, ना दमिश्क दा यहूदी वार्टुर्द हेसुर देल ईंदुर से चिट्ठी भी ताकोंडीदिन, कि जो लॉकुर ई हादी मा नळुतार आंदरी बंदी माळकु यरूशलेम दा तराईन कि आंदरी ना दण्ड कोळसुस सकाईन.<verse eid="ACT 22:5" /></para>
  <para style="s">पौलुस तान मन परिवर्तन इन बारा दा हेळतान</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />“याग ना यात्रा माळतेला दमिश्क इन हात्‍ती पहुचुसदीन, रा हिंग आत कि लगभग मदणी इक अचानक ऊंद तेज उजुळ आकाश टु नान नाकु दी चमकुस्त. <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />अदिक ना जागा मा बिदोदीन अदिक ईद आवाज केळदीन, ‘हे शाऊल, हे शाऊल, नी नानी येती सतुसत्या?’ <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />ना उत्‍तर कोटीन, ‘हे प्रभु, नी याव हुय?’ आव नान से अंदुन, ‘ना यीशु नासरी हुईन, यारी नी सतुसत्या.’ <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />नान संगीगोळ ज्योति रा नोळदुर, लेकीन जो नान से माताळोन आऊन आवाज केळीदील. <verse eid="ACT 22:9" /><verse number="10" style="v" sid="ACT 22:10" />आग ना अंदीन, ‘हे प्रभु, ना येन माळाईन?’ प्रभु नान से अंदुन, ‘यदकु दमिश्क दा होग, अदिक जो येनारा नीन माळोर साटी ठहरूस्कु आग्याद अल नीन से सप्पा हेळकु आगेदीत.’ <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />आ तेज ऊजुळ इन कारण ना कुढ्ढ आगेगिदीन, रा नान संगीगोळ नान कय हुडुकु दमिश्क दा तंदुर.<verse eid="ACT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12" />“आग हनन्याह हेसुर इन व्यवस्था अन अनुसार नळावाळा ऊंद भक्त मंळसा, जो अल ईरावाळेर सप्पा यहूदीगोळ दा सुनाम ईरोन, नान हात्‍ती बंदुन, <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />अदिक निदुरकु नान से अंदुन, ‘हे वार्ट शाऊल, बाक नोळली हत.’ अदा घळी नान कण्णगोळ खुलसेदव अदिक ना आऊक नोळदीन. <verse eid="ACT 22:13" /><verse number="14" style="v" sid="ACT 22:14" />आग आव अंदुन, ‘नाम आप्प दादागोळ परमेश्वर नीनी इदुरसाटी ठहरूसेव कि नी आऊन इच्छा अक जानस्या, अदिक आ न्यायी सेवक उक नोळ्या अदिक आऊन बाय देल मातगोळी केळ्या. <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />यतिकी नी आऊन दी टु सप्पा मंळसागोळ्द मुंद आ मातगोळ्द गवाह आद्या जो नी नोळ्या अदिक केळ्या. <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />ईग येती देर माळत्या? येळ, बपतिस्मा ताकोम, अदिक आऊन हेसुर ताकोमकु तान पापगोळी तोळ्द बुळ.’<verse eid="ACT 22:16" /></para>
  <para style="s">पौलुस उन गैरयहूदीगोळ दा प्रचार इन बुलावा</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />“याग ना बाक यरूशलेम दा बंदकु मंदिर दा प्रार्थना माळीन, रा ऊंद दर्शन नोळदीन, <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />अदिक यदुर दा ना प्रभु उक नोळदीन कि आव नान से अनतान, ‘जल्दी माळकु यरूशलेम टु राटनेरी होटबुळ; यतिकी आ लॉकुर नान बारा दा नीन गवाही मान्सतीदील.’ <verse eid="ACT 22:18" /><verse number="19" style="v" sid="ACT 22:19" />ना अंदीन, ‘हे प्रभु, अद रा नीव जान्सतीर कि ना नीन मा विश्वास माळावाळेरी बंदीगृह दा हाक तोगीन अदिक जागा जागा सभागृह दा बळसुस तोगीन. <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" /><note caller="+" style="x"><char style="xo" closed="false">२२:२० </char><char style="xt" closed="false"><ref loc="ACT 7:58">प्रेरितगोळ ७:५८</ref></char></note>याग नीन गवाह स्तिफनुस उक कोन्सुसकु आत आग ना भी अल निदुरकु ईरीन अदिक ई मात दा सयमत ईरीन, अदिक आऊन कोन्नावाळेर्द कपळागोळ रखवाली माळ तोगीन.’ <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />अदिक प्रभु नान से अंदुन, ‘होटोग: यतिकी ना नीनी गैरयहूदीगोळ हात्‍ती दुर दुर कळाईन.’”<verse eid="ACT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />आंदुर ईद मात ताका पौलुस उन केळतेला ईत्‍तुर, आग ऊँचा आवाज दा चिल्ळासदुर, “हिंग मंळसा अन अन्त माळी, आऊन ई संसार दा जित्‍ता ईरोद उचित हैलेच!” <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />याग आंदुर चिल्ळास तोगोर अदिक कपळा भीळतोगोर अदिक हवा दा धुळा हार्स तोगोर; <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />रा रोमी सेनानायक अंदुन, “इऊक किला दा ओयी, अदिक क्वाळा बळकु जाँच माळी, कि ना जान्साईन कि यहूदी लॉकुर याता कारण आऊन विरोध दा हिंग चिल्ळासेत्यार.” <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />याग आंदुर आऊक बडोर साटी कटदुर रा पौलुस आ सूबेदार से अंदुन जो हात्‍ती निदुरकु ईरोन, “येन ईद उचित आद कि नीव ऊंद रोमी मंळसा अक, अदिक आव भी बिना दोषी ठहरूस्द, क्वाळा बडी?”<verse eid="ACT 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26" />सूबेदार ईद केळकु सेनानायक उन हात्‍ती होगकु अंदुन, “नी ईद येन माळत्या? ईव रा रोमी मंळसा हुन.”<verse eid="ACT 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27" />आग रोमी सेनानायक आऊन हात्‍ती बंदकु अंदुन, “नानी हेळ, येन नी रोमी मंळसा हुय?”</para>
  <para style="p" vid="ACT 22:27">आव अंदुन, “हव.”<verse eid="ACT 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28" />ईद केळकु सेनानायक अंदुन, “नानी रोमी नागरीक आगोद पद हापाळ पैस्या कोटकु सिक्याद.”</para>
  <para style="p" vid="ACT 22:28">पौलुस अंदुन, ना रा जनम टु रोमी मंळसा हुईन.<verse eid="ACT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29" />आग जो लॉकुर आऊक जाँच माळावाळेर ईरोर, आंदुर तुरन्त आऊन हात्‍ती टु हटसेदुर; अदिक रोमी सेनानायक भी ईद जान्सकु कि ईव रोमी हुन अदिक ना ईऊक कट्टीन, अंजेदुन.<verse eid="ACT 22:29" /></para>
  <para style="s">महासभा अन मुंद पौलुस</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />दुसरा दिशी रोमी सेनानायक ठीक ठीक जानसोद इच्छा देल कि यहूदी आऊन मा येती दोष हचतार, आऊन बंधन खोल्स बुट्टुन; अदिक प्रधान याजकगोळ अदिक पुरा महासभा अक जमा आगोद आग्या कोट्टुन, अदिक पौलुस उक ल्यालमा ओतकु आंदुर्द मुंद निदरूस बुटुन.<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />पौलुस महासभा दी टकटकी हचकु नोळदुन अदिक अंदुन, “हे इस्त्राएल इन वार्टुरा, ना ईंद ताका परमेश्वर उन साटी बिलकुल वळ्लीद विवेक देल जीवन बितुसीन.” <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />इदुर मा हनन्याह महायाजक आंदरी जो आऊन हाती निदुरकु ईरोर, आऊन बाय मा क्याबरा बडोद आग्या कोट्टुन. <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" /><note caller="+" style="x"><char style="xo" closed="false">२३:३ </char><char style="xt" closed="false"><ref loc="MAT 23:27">मत्ती २३:२७</ref>,<ref loc="MAT 23:28">२८</ref></char></note>आग पौलुस आऊन से अंदुन, “हे चुना हच्द भीती, परमेश्वर नीनी बळदान. नी व्यवस्था अन अनुसार नान न्याय माळली कुरत्या, अदिक नी खुद व्यवस्था अन विरूद्ध नानी बडोद आग्या कोळत्या?”<verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />जो पौलुस उन हात्‍ती निदुरकु ईरोर आंदुर अंदुर, “येन नी परमेश्वर उन महायाजक उक बुरा भला अनत्या?”<verse eid="ACT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5" />पौलुस अंदुन, “हे नान इस्त्राएल इन वार्टुरा, ना ईला जानसीन कि ईव महायाजक हुन; यतिकी शास्त्र दा लिख्सकु आद: ‘तान लॉकुर्द अधिकारी इक बुरा माताळबाळेत.’”<verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२३:६ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 26:5">प्रेरितगोळ २६:५</ref>; <ref loc="PHP 3:5">फिलिप्पिगोळ ३:५</ref></char>
    </note>आग पौलुस ईद जान्सकु कि ऊंद दल सदूकीगोळ अदिक दुसरा फरीसीगोळ्द हुन, सभा दा कारूकु अंदुन, “हे इस्त्राएल इन वार्टुरा, ना फरीसी अदिक फरीसीगोळ्द वंश इन हुईन, सोत्‍तुर आंदुर आशा अदिक पुनरूत्थान इन बारा दा नान मुकदमा आगेत्याद.”<verse eid="ACT 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7" />याग आव ईद मात अंदुन रा फरीसीगोळ अदिक सदूकीगोळ दा झगळा आगली कुर्त; अदिक सभा दा फूट बिदोत. <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" /><note caller="+" style="x"><char style="xo" closed="false">२३:८ </char><char style="xt" closed="false"><ref loc="MAT 22:23">मत्ती २२:२३</ref>; <ref loc="MRK 12:18">मरकुस १२:१८</ref>; <ref loc="LUK 20:27">लूका २०:२७</ref></char></note>यतिकी सदूकी रा ईद अनतार, कि ना सोत्‍तुर दा टु जित्‍ता आगोद आद, ना स्वर्गदूत अदिक ना आत्मा आद; लेकीन फरीसी ईव सप्पा अक मान्सतार. <verse eid="ACT 23:8" /><verse number="9" style="v" sid="ACT 23:9" />आग बळा हल्ला मचुस्त अदिक येनारा नियम इन गुरुगोळ जो फरीसीगोळ दल इन ईरोर, यदकु निदुरदुर अदिक ईद अनकु झगळुस्ली कुरतुर, “नाव ई मंळसा दा येनु बुराई नोळालेव, अदिक अगर यातोदारा आत्मा या स्वर्गदूत आऊन से माताळ्यान रा बाक येन?”<verse eid="ACT 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10" />याग हापाळ झगळा आत, रा पलटन इन सरदार ईद अंज्क देल कि आंदुर पौलुस उन तुकळा तुकळा माळबाळुल, पलटन इक आग्या कोट्टुन कि ईळुकु आऊक आंदुर न्याड्या दा टु जबरदस्ती तेगुल, अदिक गढ़ दा ओयुल.<verse eid="ACT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11" />अदा ईळ्लकी प्रभु आऊन हात्‍ती निदुरकु अंदुन, “हे पौलुस, हिम्मत ईट; यतिकी ह्यांग नी यरूशलेम दा नान गवाही कोट्ट, हांग अच नीनी रोम दा भी गवाही कोळोद बिद्दीत.”<verse eid="ACT 23:11" /></para>
  <para style="s">पौलुस उन हत्या अन साजीश</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />दुसरा दिशी थ्वाळासा यहूदीगोळ मिलुसकु साजीश रचदुर अदिक किर्‍या तिंदुर कि यागासताका नाव पौलुस उक कोंद बुळालेव, आगासताका नाव येनारा तिनदेव या कुळदेव. <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />यार आपस दा ईद साजीश रचुसीदुर, आंदुर चालीस मुंदुर से यक्कुल ईरोर. <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />आंदुर प्रधान याजकगोळ अदिक स्याणागोळ हात्‍ती होगकु अंदुर, “नाव ईद ठान्स कोंडेव कि यागासताका नाव पौलुस उक कोंद बुळालेव, आगासताका येनु तिनतीदील अदिक कुडुतीदील. <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />इदुरसाटी ईग महासभा समेत पलटन इन सरदार उक समझुसी कि आऊक नीम हात्‍ती तरूल, मान्सी कि नीव आऊन बारा दा यक्कुल अच वळ्लीसा जाँच माळोद चाहासतीर; अदिक नाव आऊन पोहचुसोर से पयले अच आऊक कोन्नोर साटी तयार ईत्‍तेव.”<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />पौलुस उन आकतींग इन पार केळदुन कि आंदुर आऊन घात दा आर, रा गढ़ दा होगकु पौलुस उक बातणी कोट्टुन. <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />पौलुस सूबेदारगोळ दा टु ऊंद मंळसा अक तान हात्‍ती कारूकु अंदुन, “ईव आऊन से येनारा अनोद चाहासतान.” <verse eid="ACT 23:17" /><verse number="18" style="v" sid="ACT 23:18" />इदुरसाटी आव आऊक पलटन इन सरदार उन हात्‍ती ओतकु अंदुन, “बंदी पौलुस नानी कारूकु विनती माळदुन कि ईव जवान पलटन इन सरदार से येनारा अनोद चाहासतान; ईऊक आऊन हाती ओय.”<verse eid="ACT 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19" />पलटन इन सरदार आऊन कय हुडुकु अदिक अलग ओतकु केळदुन, “नी नान से येन अनोद चाहासत्या?”<verse eid="ACT 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20" />आव अंदुन, “यहूदीगोळ साजीश रचुस्यार कि नीन से विनती माळुल कि नाळ पौलुस उक महासभा दा तरूल, आंदुर हिंग दिखावा माळ्यार कि अदिक ठीक देल आऊंद जाँच माळोद चाहास्तार. <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />लेकीन आंदुर्द मान्सबाळेत, यतिकी आंदुर दा टु चालीस से म्याकुच मंळसा आऊन घात दा आर, यार ठान्स कोंडार कि यागासताका आंदुर पौलुस उक कोंद बुळालुर, आगासताका ना तिंदार अदिक ना कुळदार. अदिक ईग आंदुर तयार आर अदिक नीन फैसला अन हादी कायेत्यार.”<verse eid="ACT 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22" />आग पलटन इन सरदार जवान उक ईद आग्या कोटकु सार माळदुन, “यारदु से अनबाळेत कि नी नान ईक ई मातगोळ हेळ्या.”<verse eid="ACT 23:22" /></para>
  <para style="s">पौलुस उक फेलिक्स शासक उन हात्‍ती कळोद</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />आग आव येढ्ढ सूबेदारगोळी तान हात्‍ती कारूकु अंदुन, “कैसरिया होगोर साटी ईळ्लकी ऊंम्बत मुरा ताका येढ्ढ सौ सैनिक, सत्‍तर घोळसवार, अदिक येढ्ढ सौ भालावाळेर इक तयार ईटी.” <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />अदिक पौलुस उन सवारी साटी घ्वाळागोळी तयार ईटी, कि आऊक फेलिक्स शासक उन हात्‍ती वळ्लीसा पोहचुस बुळुल. <verse eid="ACT 23:24" /><verse number="25" style="v" sid="ACT 23:25" />आव ई प्रकार इन चिट्ठी भी लिख्सदुन:<verse eid="ACT 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 23:26" />“महामहिम फेलिक्स शासक उक क्लौदियुस लूसियास उन नमस्कार. <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />ई मंळसा अक यहूदीगोळ हुडुकु कोंद बुळोद चाहासदुर, लेकीन याग ना जान्सदीन कि रोमी हुन, रा पलटन हुळकु बिळ्सकु तंदीन. <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />ना जान्सोद चाहासीन कि आंदुर आऊन मा याता कारण दोष हचतार, इदुरसाटी आऊक आंदुर्द सभा दा वोतीन. <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />आग ना जान्स कोंडीन कि आंदुर तान व्यवस्था अन विवादगोळ बारा दा आऊन मा दोष हचतार, लेकीन कोंद बुळोद या शंकलीगोळ देल कटकु आगोद योग्य आऊन दा येनु दोष हैलेच. <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />याग नानी हेळकु आत कि आंदुर ई मंळसा अन घात दा हतकु आर रा ना तुरन्त आऊक नीन हात्‍ती कळु बुटीन; अदिक आऊन मा दोष हचावाळेर इक भी आग्या कोट्टीन कि आंदुर्द हच्द दोष आव नीन मुंद ईटुल.”<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />इदुरसाटी ह्यांग सैनिकगोळी आग्या कोटकु आगीत, हांग अच आंदुर पौलुस उक हुळकु ईळ्लकी इन ईळ्लकी अन्तिपत्रिस उन हात्‍ती तंदुर. <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />दुसरा दिशी घ्वाळा अन सवारगोळी पौलुस उन सांगुळ मुंद होगोर साटी पैदल नळावाळेर सिपाहीगोळ बिट बुटुर अदिक आंदुर वापस किला दा होट बंदुर. <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />आंदुर कैसरिया पोहचुस्कु शासक उक चिट्ठी कोट्टुर; अदिक पौलुस उक भी आऊन मुंद निदरूसदुर. <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />आव चिट्ठी वाचुसकु केळदुन, ईव याता द्याश इन हुन? अदिक याग जान्स कोंडुन कि किलिकिया अन हुन, <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />रा आव अंदुन, “याग नान दोष हचावाळेर बंदार, आग ना नीन केळाईन.” अदिक आव आग्या कोट्टुन कि आऊक हेरोदेस शासक उन किला दा सुरक्षा दा ईटकु आगुल.<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s">पौलुस उन खिलाप कारवाई</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />अईद दिन इन बाद्दा हनन्याह महायाजक कई स्याणागोळ अदिक तिरतुल्लुस हेसुर इन वकील उक सांगुळ हुळकु बंदुन. आंदुर शासक फेलिक्स उन मुंद पौलुस मा आरोप हचदुर. <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />याग पौलुस उक कारूकु आत रा तिरतुल्लुस आऊन मा दोष हचकु अनली कुरतुन:</para>
  <para style="p" vid="ACT 24:2">“हे महामहिम फेलिक्स, नीन अगुवाई दा नाव हापाळ समय टु धोळ्द शांती इन सांगुळ ईरेतेव, अदिक नीन दुर दृष्टी देल द्याश दा हापाळ वळ्लेव सुधार आग्याव. <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />फेलिक्स शासक उक नाव हर जागा अदिक हर प्रकार देल इदुर्द स्वागत माळतेव अदिक नाव नीम प्रती हापाळ आभारी आयेव. <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />ना नीम्द हापाळ यक्कुल समय ताकोमोद चाहासालीन, रा ना नीन से विनती माळतीन कि कृपया नीव थ्वाळासा दा नाम्द केळकोम. <verse eid="ACT 24:4" /><verse number="5" style="v" sid="ACT 24:5" />यतिकी नाव ई मंळसा अक उपद्रवी अदिक दुनिया दा सप्पा यहूदीगोळ दा फूट हाकावाळा, अदिक नासरीगोळी समुह दा स्याणा मान्सतेव. <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />आव मंदिरगोळी अपवित्र माळोद चाहासदुन, लेकीन नाव आऊक हुडुकोंडेव. <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />लेकीन पलटन इन सरदार लूसियास आऊक जबरदस्ती नाम कय दा टु कसु कोंडुन, <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />ई सप्पा मातगोळी यदुर्द बारा दा नाव आऊन दोष हचतेव, नी खुद अच आऊक जाँच माळकु जान्स कोंड्या.” <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />यहूदीगोळ भी इदुर दा शामिल आगकु हिम्मत देल सांगुळ कोटकु अंदुर, कि ई मातगोळ सप्पा सही आव.<verse eid="ACT 24:9" /></para>
  <para style="s">फेलिक्स उन मुंद पौलुस उन बचाव</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />याग शासक पौलुस उक माताळोद इशारा माळदुन, रा आव उत्‍तर कोट्टुन:</para>
  <para style="p" vid="ACT 24:10">“ना ईद जान्सकु कि नी हापाळ साल टु ई जाती इन न्याय माळेत्या, ईद जान्सकु ना खुशी देल तान बचाव साटी थ्वाळासा मातगोळी माताळोद चाहासतीन. <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />नी खुद जान्स सकत्या कि यागी टु ना यरूशलेम दा आराधना माळली बंदीन, नानी हन्नेळ दिन से यक्कुल आगीदील. <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />यहूदीगोळ नानी ना रा यहूदी सभागृह दा अदिक ना रा नगर दा लॉकुर भीळ दा दंगा माळ्त नोळदुर. <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />अदिक ना रा आंदुर आ मातगोळी, यार्द बारा दा नान मा दोष हचतार, नीन मुंद सच प्रमाणित माळ सकतार. <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />लेकीन ना नीन मुंद ईद मान्स कोमतीन कि याता हादी इक आंदुर ख्वाटा अनतार, अदुर्दा रीति मा ना तान आप्प दादागोळ परमेश्वर उन आराधना माळतीन. लेकीन ना ईद भी विश्वास माळतीन जो मातगोळ मूसा अन व्यवस्था अदिक भविष्यवक्ता अन किताब दा लिख्सकु आद. <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />अदिक परमेश्वर उन मा हांगा आशा ईटतीन ह्यांग आंदुर खुद भी ईटतार, कि वळ्लेर अदिक बेकार येढ्ढु लॉकुर्द भी पुनरूत्थान आदीत. <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />इदुर से ना खुद भी कोशिश माळतीन कि परमेश्वर उन, अदिक मंळसागोळ दी नान विवेक हमेशा निर्दोष ईरूल.<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२४:१७ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 21:17-28">प्रेरितगोळ २१:१७-२८</ref>
      </char>
    </note>“हापाळ वर्ष इन बाद्दा ना तान गरीब लॉकुरी पैस्या कोळली, अदिक बलिदान येर्सली बंदिदीन. <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />याग आंदुर नानी हासिल माळदुर आग ना शुद्धीकरण इन रीति इक पुरा माळीन अदिक ना नान हात्‍ती यातोदारा भीळ ईरोद अदिक ना यातोदारा अव्यवस्था फैलुसिदीन. <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />लेकीन अल आसिया क्षेत्र अन थ्वाळासा यहूदी भी ईरोर. आंदरी जरूरी ईरोद, कि अगर नान विरोध दा आंदुर हात्‍ती येनारा मात आद रा ईल नीन मुंद बंदकु नान मा दोष हचायदुर. <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />या ईद खुद अच हेळुल कि याग ना महासभा अन मुंद निदुरकु ईरीन, रा आंदुर नान दा यातोद अपराध नोळदुर? <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" /><note caller="+" style="x"><char style="xo" closed="false">२४:२१ </char><char style="xt" closed="false"><ref loc="ACT 23:6">प्रेरितगोळ २३:६</ref></char></note>सिवाय ईदुर्द कि याग आंदुर न्याड्या दा ईरीन आग ना धोळ दण दा अंदिदीन ‘सोत्‍तुर दा टु जित्‍ता आगोद बारा दा नान विश्वास इन कारण नान न्याय माळकु आगेत्याद.’”<verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />फेलिक्स, जो ई हादी इन बारा दा ठीक ठीक जानसोन, आंदरी ईद अनकु टाल्स बुटुन, “याग पलटन इन सरदार लूसियास बंदान, रा नीम मात इन निर्णय माळाईन.” <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />अदिक सूबेदार उक आग्या कोट्टुन कि पौलुस उक येनारा छुट कोटकु रखवाली माळेत, अदिक आऊन संगीगोळ दा टु यारीकु भी आऊन स्यावा माळोर से रोक्सबाळेत.<verse eid="ACT 24:23" /></para>
  <para style="s">फेलिक्स अदिक द्रुसिल्ला अन मुंद पौलुस</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />थ्वाळासा दिनगोळ बाद्दा फेलिक्स तान हिंग्स द्रुसिल्ला अक, जो यहूदीनी ईरोर, सांगुळ हुळकु बंदुन अदिक पौलुस उक कार्सुस्कु आ विश्वास इन बारा दा जो मसीह यीशु मा आद, आऊन से केळदुन. <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />याग आव वळ्लेव मातगोळ, अदिक संयम, अदिक बरावाळा न्याय इन दिन इन चर्चा माळोन, रा फेलिक्स अंजकु उत्‍तर कोट्टुन, “ईग नी होग; मवका नोळकु ना नीनी मात्‍त काराईन.” <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />आऊक पौलुस टु येनारा पैस्या सीकोव भी आशा ईरोद, इदुरसाटी घळी घळी कारूकु आऊन से मातगोळ हेळतोगोन.<verse eid="ACT 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27" />लेकीन याग येढ्ढ वर्ष बीतसेदव रा पुरकियुस फेस्तुस, फेलिक्स इन जागा मा व्हासा शासक बन्सकु बंदुन; अदिक फेलिक्स यहूदीगोळी खुश माळोद इच्छा देल पौलुस उक बंदी इच बिटकु होदुन.<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s">पौलुस उन रोमी साम्राज्य अक अपिल</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />फेस्तुस आ द्याश दा पोहचुसोद मुर दिन बाद्दा कैसरिया टु यरूशलेम इक होदुन. <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />आग प्रधान याजकगोळ अदिक यहूदीगोळ्द प्रमुख लॉकुर आऊन मुंद पौलुस उन मा आरोप हचदुर; अदिक आऊन से विनती माळदुर. <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />कि आव पौलुस उक यरूशलेम दा कारसुल कि आंदुर आऊक हादी मा अच कोंदबुळुल. <verse eid="ACT 25:3" /><verse number="4" style="v" sid="ACT 25:4" />फेस्तुस उत्‍तर कोट्टुन, “पौलुस कैसरिया अन्द कैद दा आन, अदिक ना खुद राटनेरी अल होगाईन.” <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />बाक अंदुन, “नीम दा जो अधिकार ईटतार आंदुर नान सांगुळ कैसरिया नळुल, अदिक अगर ई मंळसा येनारा अनुचित क्याल्सा माळ्यान रा आऊन मा दोष हचुल.”<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />आंदुर न्याड्या येनारा येठ्ठ हत्‍त दिन ईतकु फेस्तुस कैसरिया होटोदुन; अदिक दुसरा दिशी न्याय आसन मा कुर्तकु पौलुस उक तरोद आग्या कोट्टुन. <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />याग पौलुस बंदुन रा जो यहूदी यरूशलेम टु बंदीदुर, आंदुर आसपास निदुरकु आऊन मा हापाळ सा गंभीर आरोप हचदुर, यदरी आंदुर साबित ईला माळसकोर. <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />लेकीन पौलुस खुद इन बचाव दा उत्‍तर कोट्टुन, “ना रा ना यहूदीगोळ्द व्यवस्था अन अदिक ना मंदिर इन, अदिक ना रोमन शासक कैसर उन विरूद्ध येनारा पाप माळीन.”<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />आग फेस्तुस यहूदीगोळी खुश माळोद इच्छा देल पौलुस से अंदुन, “येन नी चाहासत्या कि यरूशलेम इक होद्या; अदिक अल नान मुंद नीन ईद मुकदमा तय माळकु आगुल?”<verse eid="ACT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10" />पौलुस अंदुन, “ना कैसर इन न्याय आसन इन मुंद निदुरकु आईन; नान मुकदमा अन्द ईल्या फैसला आग पायजे. ह्यांग नी वळ्लीद तरीका देल जान्सत्या, यहूदीगोळ्द ना येनु अपराध माळीदील. <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />अगर ना अपराधी आईन अदिक कोंद बुळोद लायक येनारा क्याल्सा माळीन, रा सायोर से मार्रा तिर्गुसालीन लेकीन याता मातगोळ्द ईंदुर नान मा दोष हचतार, अगर अऊर दा टु यातोदारा भी मात सही आगीदील, रा नानी याऊ आंदुर कय दा कोळ सकालुन. हिंग ना कैसर उन से विनती माळतीन.”<verse eid="ACT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12" />आग फेस्तुस सलाहकारगोळ से सलाह मसवरा माळकु उत्‍तर कोट्टुन, “नी कैसर उन से विनती माळ्या, इदुरसाटी नीनी कैसर उन हात्‍ती इच ओतकु आदीत.”<verse eid="ACT 25:12" /></para>
  <para style="s">राजा अग्रिप्पा अदिक बरनिके अन मुंद पौलुस</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />येनारा दिन बित्सदुर बाद्दा अग्रिप्पा राजा अदिक बिरनीके कैसरिया दा बंदकु फेस्तुस से भेंट माळदुर. <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />आंदुर हापाळ दिन अल ईत्‍तुर बाद्दा फेस्तुस पौलुस उन बारा दा राजा अक हेळदुन: “ऊंद मंळसा आन, यारी फेलिक्स बंदीगृह दा बिटकु होटोग्यान. <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />याग ना यरूशलेम होगीदीन, रा प्रधान याजक अदिक यहूदीगोळ्द स्याणागोळ आऊन मा आरोप हचदुर अदिक चाहासदुर कि ना आऊक दोषी साबित माळाईन. <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />लेकीन ना आंदरी उत्‍तर कोटीन कि रोमीगोळ्द ईद रीति हैलेच कि यावारा मंळसा अक दण्ड इन साटी यारदारा कय दा कोट्ट बुळुल, यागासताका आरोपी इक तान दोष हचावाळेर मुंद निदुरकु दोष इन उत्‍तर कोळोद मवका सिकाल. <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />इदुरसाटी याग आंदुर नान सांगुळ ईल बंदुर, रा ना येनु देर माळीदील, लेकीन दुसरा अच दिशी न्याय आसन मा कुर्तकु पौलुस उक तरोद आग्या कोटीन. <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />याग आऊन दोष हचावाळेर निदुरदुर, रा आंदुर हिंग अनुचित मातगोळ्द दोष हचीदिल, ह्यांग ना समसीन. <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />लेकीन यहूदी रीति इन अनुसार अदिक यीशु हेसुर इनव यावारा मंळसा अन बारा दा, जो सोतोगिदुन अदिक पौलुस आऊक जीवित हेळतोगोन, विवाद माळतोगोर. <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />ना उलझन दा ईरीन कि ई मातगोळ्द पता ह्यांग हचाईन? इदुरसाटी ना आऊन से केळदीन, ‘येन नी यरूशलेम होद्या कि अल ई मातगोळ्द फैसला आगुल?’ <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />लेकीन याग पौलुस विनती माळदुन कि आऊंद मुकदमा अन फैसला कैसर उन अल आगुल, रा ना आग्या कोटीन कि यागासताका आऊक कैसर उन हात्‍ती कळालीन, आऊक कैद दा ईटकु आगुल.”<verse eid="ACT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22" />आग अग्रिप्पा फेस्तुस से अंदुन, “ना भी आ मंळसा अन केळोद चाहासतीन.” आव अंदुन, “नी नाळ केळ कोंड्या.”<verse eid="ACT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />इदुरसाटी दुसरा दिशी याग अग्रिप्पा अदिक बिरनीके बळा धूमधाम देल बंदुर अदिक पलटन इन सरदारगोळ अदिक नगर इन प्रमुख लॉकुर्द सांगुळ दरबार दा पोहचुसदुर. आग फेस्तुस आग्या कोट्टुन कि आंदुर पौलुस उक तरूल. <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />फेस्तुस अंदुन, “हे राजा अग्रिप्पा, अदिक हे सप्पा मंळसागोळा जो ईल नाम सांगुळ आईर, नीव ई मंळसा अक नोळतीर, यार्द बारा दा सप्पा यहूदीगोळ यरूशलेम दा अदिक ईल भी चिल्ळास चिळ्लासकु नान से विनती माळदुर कि ईऊंद जित्‍ता ईरोद उचित हैलेच. <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />लेकीन ना जान्स कोंडीन कि आव हिंग येनु माळीदील कि कोंदकु आगुल; अदिक जब कि आव खुद अच कैसर उन से नान न्याय आगुल हिंग विनती माळदुन, रा ना आऊक रोम दाकळोद निर्णय माळदीन. <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />लेकीन ना आऊन बचाव इन बारा दा यातोदु निश्चित मात नोळीदील कि कैसर उन हात्‍ती लिख्सकु कळाईन. इदुरसाटी ना आऊक नीम मुंद अदिक खास माळकु हे राजा अग्रिप्पा, नीन मुंद तंदीन कि जाँच्सदुर बाद्दा नानी येनारा रा आऊन बारा दा लिख्सली सिकुल. <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />यतिकी बंदी इक कळोद अदिक जो दोष आऊन मा हचकु आग्याव, अवरी स्पष्ट रीति देल ईला हेळोद, नानी बेकार जान्सकु बिळतद.”<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s">पौलुस उन अग्रिप्पा से खुद इन बचाव इन मातगोळ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />अग्रिप्पा पौलुस से अंदुन, “नीनी तान बारा दा माताळोद आग्या आद.” आग पौलुस कय वाळुसकु उत्‍तर कोळली कुरतुन:<verse eid="ACT 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 26:2" />“हे राजा अग्रिप्पा, यास मातगोळ्द यहूदी नान मा दोष हचतार, ईंद नीन मुंद आंदुर्द उत्‍तर कोळोर दा ना तान इक धन्य सम्सतीन, <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />खास माळकु इदुरसाटी कि नी यहूदीगोळ्द सप्पा रीति रिवाजगोळी अदिक झगळागोळी जान्सत्या. इदुरसाटी ना विनती माळतीन, धीरज देल नांद केळ.”<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />“नान चाल चलन सुरूवात टु तान लॉकुर न्याड्या अदिक यरूशलेम दा ह्यांग ईरोद, अद सप्पा यहूदी जान्सतार. <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" /><note caller="+" style="x"><char style="xo" closed="false">२६:५ </char><char style="xt" closed="false"><ref loc="ACT 23:6">प्रेरितगोळ २३:६</ref>; <ref loc="PHP 3:5">फिलिप्पिगोळ ३:५</ref></char></note>आंदुर नानी हापाळ समय टु अरूतार अदिक अगर आंदुर चाहासतिदार रा ई मात इन गवाही कोळ सकतार कि ना तान रीति इन सब से कट्टर फरीसी समुह अन ऊंद सदस्य अन रूप दा जीवन जीऊसीन. <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />अदिक ईग आ वादा दा आशा अन कारण जो परमेश्वर नाम आप्प दादागोळ से माळीदुन, नान मा मुकदमा नळेत्याद. <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />अदा वादा अन पुरा आगोद आशा हचकु, नाम हन्नेळ गोत्र तान पुरा मन देल ईळ्लक-हागुल परमेश्वर उन स्यावा माळतेला बंदार. हे राजा, ईदा आशा अन बारा दा यहूदी नान मा दोष हचतार. <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />याग कि परमेश्वर सोत्‍तुरी जित्‍ता माळ्यान, रा नीम मान्या ईद मात येती विश्वास इन योग्य समसालुर?” <verse eid="ACT 26:8" /><verse number="9" style="v" sid="ACT 26:9" /><note caller="+" style="x"><char style="xo" closed="false">२६:९ </char><char style="xt" closed="false"><ref loc="ACT 8:3">प्रेरितगोळ ८:३</ref>; <ref loc="ACT 22:4">२२:४</ref>,<ref loc="ACT 22:5">५</ref></char></note>“ना भी खुद विचार माळ तोगीन कि यीशु नासरी इन हेसुर इन विरोध दा ना हापाळ येनारा माळाईन. <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />अदिक ना यरूशलेम दा हिंग अच माळदीन; अदिक प्रधान याजकगोळ से अधिकार ताकोमकु हापाळ सा पवित्र लॉकुरी बंदीगृह दा हाकदीन, अदिक याग आंदुर कोंदकु आगतोगोर रा ना भी आंदुर्द विरोध दा तान सम्मती कोळतोगीन. <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />हर यहूदी सभागृह दा ना आंदरी हापाळ अनली सजा कोळसुस्कु यीशु उन माकळोद विश्वास इक नकार माळली हेळ तोगीन, आंदुर प्रती नान सिट्ट यक्कुल ईरोद कि आंदरी सतुसोर साटी ईल ताका कि ना विदेशी नगरगोळ दा भी होदीन.<verse eid="ACT 26:11" /></para>
  <para style="s">पौलुस उन मन परिवर्तन इन वर्णन</para>
  <para style="r">(<ref loc="ACT 9:1-19">प्रेरितगोळ ९:१-१९</ref>; <ref loc="ACT 22:6-16">२२:६-१६</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />“ईदा उद्देश इक हुडुकु ना प्रधान याजकगोळ से अधिकार अदिक आग्या-चिट्ठी ताकोमकु दमिश्क इक होगीन; <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />रा हे राजा, हादी दा मदणी इन समय ना आकाश टु सुर्य अन तेज से भी वाळुसकु ऊंद ज्योति, तान अदिक तान सांगुळ नळावाळेर्द नाकु दी चमकुसतेला नोळदीन. <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />याग नाव सप्पा जागा मा बिद्देव, रा ना इब्रानी भाषा दा, नान से ईद अनतेला ऊंद शब्द केळदीन, ‘हे शाऊल, हे शाऊल, नी नानी येती सतुसत्या? नी हिंग माळकु तान तान इक का दुख कोळेत्या ह्यांग वस्ता तान ल्यात तुतारी इन आरू मा होडेत्याद.’ <verse eid="ACT 26:14" /><verse number="15" style="v" sid="ACT 26:15" />ना अंदीन, ‘हे प्रभु, नी याव हुय?’ प्रभु अंदुन, ‘ना यीशु हुईन, यारी नी सतुसत्या. <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />लेकीन नी येळ, तान कालगोळ मा निदुर; यतिकी ना नीनी इदुरसाटी दर्शन कोटीन कि नीनी आ मातगोळ्द भी सेवक अदिक गवाह ठहरूसाईन, जो नी ईंद नोळ्या, अदिक अदुर साटी भी जो ना नीनी भविष्य दा हेळाईन. <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />अदिक ना नीनी नीन लॉकुर यहूदीगोळ से अदिक गैरयहूदीगोळ से बिळसाईन, यार हात्‍ती ना ईग नीनी कळाईन <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />कि नी आंदुर्द कण्णगोळी तेरद्या कि आंदुर अंधकार देल ज्योति दी, अदिक शैतान इन अधिकार देल परमेश्वर उन दी तिर्गुल; कि आंदुर्द विश्वास इन द्वारा जो नान मा आद आंदुर आंदुर्द पापगोळ्द माफ अदिक परमेश्वर उन निवळुस्द लॉकुर सांगुळ पवित्र स्थान हासिल माळ्यार.’<verse eid="ACT 26:18" /></para>
  <para style="s">पौलुस उन तान क्याल्सागोळ बारा दा हेळोद</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />“इदुरसाटी हे राजा अग्रिप्पा, ना आ स्वर्गीय दर्शन इन आग्या टालसीदील, <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" /><note caller="+" style="x"><char style="xo" closed="false">२६:२० </char><char style="xt" closed="false"><ref loc="ACT 9:20">प्रेरितगोळ ९:२०</ref>,<ref loc="ACT 9:28">२८</ref>,<ref loc="ACT 9:29">२९</ref></char></note>लेकीन पयले दमिश्क इन, बाक यरूशलेम इन, अदिक आग यहूदिया अन सप्पा द्याश इन ईरावाळेर इक, अदिक गैरयहूदीगोळी समझुसतेला ईत्‍तीन, कि पापगोळ से पश्चाताप माळी अदिक परमेश्वर उन दी तिर्गकु मन तिर्गुसोद लायक क्याल्सा माळी. <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />ई मातगोळ्द कारण यहूदी नानी मंदिर दा हुडुकु कैद दा हाकदुर अदिक कोंद बुळोद कोशिश माळतोगोर. <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />लेकीन परमेश्वर उन सहायता देल ना ईंद ताका बन्सकु आईन अदिक स्याणेर धोड्डेर सप्पा मुंदुर मुंद ईल निदुरकु गवाही कोळतीन, अदिक आ मातगोळी बिटकु येनु अनालीन जो भविष्यवक्तागोळ अदिक मूसा भी अंदुन कि आगावाळा आद, <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" /><note caller="+" style="x"><char style="xo" closed="false">२६:२३ </char><char style="xt" closed="false"><ref loc="1CO 15:20">१ कुरिन्थि १५:२०</ref></char></note>कि मसीह अक दुख नेगोद बिद्दीत, अदिक आवा सब से पयले सोत्‍तुर दा टु जित्‍ता आगकु, नाम यहूदी लॉकुर दा अदिक गैरयहूदीगोळ दा मुक्ति इन ऊजुळ इन बातणी कोट्टान.”<verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />याग पौलुस तान बचाव दा ई मातगोळी माताळोन, रा फेस्तुस धोळ्द शब्द देल चिळ्लासकु अंदुन, “हे पौलुस, नी यर्र आय. हापाळ अक्‍कल नीनी यर्र माळबुटाद.”<verse eid="ACT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25" />लेकीन पौलुस अंदुन, “हे ग्यानी फेस्तुस, ना यर्र हैलेच, लेकीन सही अदिक सम्सावाळा मातगोळी अनतीन. <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />खुद राजा अग्रिप्पा भी ई मातगोळी जान्सतान अदिक ना पुरा हिम्मत इन सांगुळ ई मातगोळ आऊन से हेळेतीन यतिकी ना पक्‍का जान्सतीन कि ईऊर दा टु यातोदु मात आंदरी पता हैलेच हिंग हैलेच ना हिंग इदुरसाटी अनेतीन कि ईव मात यातोदारा क्वाना दा होचकोमकु आगीदील. <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />हे राजा अग्रिप्पा, येन नी भविष्यवक्तागोळ्द विश्वास माळत्या? हव, ना जान्सतीन कि नी विश्वास माळत्या.”<verse eid="ACT 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28" />आग अग्रिप्पा पौलुस से अंदुन, “येन नी ईद विचार माळत्या कि ईट सरलता देल अदिक कम समय दा नी नानी मसीह माळ सकत्या?”<verse eid="ACT 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29" />पौलुस उत्‍तर कोट्टुन, थ्वाळा समय दा अन या यक्कुल समय दा, “परमेश्वर से नान प्रार्थना आद कि ना सिर्फ नी हांगा आगेग ह्यांग ना आईन लेकीन सिवाय ई शंकलीगोळ्द.”<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />आग राजा, शासक, बिरनीके अदिक आंदुर सांगुळ कुरावाळेर निदुरदुर; <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />अदिक ब्यार्र होगकु आपस दा अनली कुरतुर, “ईव मंळसा हिंग रा येनु माळालुन, जो मृत्यु दण्ड या बंदीगृह दा हाक्‍कु आगोद लायक ईरूल.” <verse eid="ACT 26:31" /><verse number="32" style="v" sid="ACT 26:32" />अग्रिप्पा फेस्तुस से अंदुन, “अगर ईव मंळसा कैसर उक न्याय ईला बेळायदुन, रा बिळ सकोन.”<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s">पौलुस उन रोम दा कळुकु आगोद</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />याग ईद तय आगेत कि नाव जहाज द्वारा इटली होदेव, रा आंदुर पौलुस अदिक थ्वाळासा दुसरा बंदीगोळी भी यूलियुस हेसुर ईनव औगुस्तुस उन पलटन इन ऊंद सुबेदार उन कय दा कोट्ट बुटुर. <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />याग ना आसिया क्षेत्र अन किनारा मा जो ऊंद बंदरगाह ईरोद अल टु होगावाळेर अद्रमुत्‍तियुम हेसुर इन नगर इन ऊंद जहाज मा कुर्तकु होट्टुर आग मकिदुनिया अन थिस्सलुनीके नगर इन ऊंद अरिस्तर्खुस हेसुर इन मंळसा नाम सांगुळ ईरोन. <verse eid="ACT 27:2" /><verse number="3" style="v" sid="ACT 27:3" />दुसरा दिन नाव सैदा नगर दा जहाज टु ईळदेव, अदिक यूलियुस पौलुस मा कृपा माळकु आऊक संगीगोळ अल होग गोटुन कि आऊक जो वस्तुगोळ हतताव अदुर्द पुर्ती माळ सकुल. <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />अल टु नाव समुद्र अन हादी देल होट्टेव हवा नाम विरूद्ध दिशा दा ईरोद ई कारण नाव साइप्रस टापू उन बाजु दा टु आगकु होदेव; <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />अदिक किलिकिया अदिक पंफूलिया नगर इन हात्‍तीगोळ्द समुद्र दा टु आग्त लूसिया अन्द मूरा नगर दा ईळदेव. <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />अल सेनानायक उक सिकन्दरिया अन्द ऊंद जहाज इटली होगतेला सिक्त, अदिक आव नामी अदुर मा येर्स बुट्टुन.<verse eid="ACT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 27:7" />याग नाव हापाळ दिन ताका धीरू-धीरू नळुतेला कठिनाई देल कनिदुस नगर इन मुंद पोहचुसदेव, रा इदुरसाटी कि हवा नामी मुंद वाळुस ईला गोळोद, नाव सलमोने नगर इन मुंदु टु आग्त क्रेते टापू उन आड्ड आगतेला नळदेव. <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />अदिक अदुर किनारा-किनारा कठिनाई देल नळुकु सुरक्षित बंदरगाह हेसुर इन ऊंद जागा दा पोहचुसदेव, यल टु लूसिया नगर हात्‍ती ईरोद.<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />याग नाव हापाळ समय अल बीतुसदेव अदिक जहाज इक मुंद वाळुसोर साटी इदुरसाटी तकलीफ आगोद यतिकी उपास इन दिन ईग खतम आगेगीदव. इदुरसाटी पौलुस आंदरी ईद अंदकु समजुसदुन, <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />“हे लॉकुरा, नानी हिंग हतेत्याद कि ईद समुद्र यात्रा हापाळ खतरनाक आदीत, ना सिर्फ माल मत्‍ता अदिक जहाज इन साटी अच उलटा नाम जीवन इन साटी भी.” <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />लेकीन सुबेदार पौलुस उन मातगोळ से यक्कुल जहाज नळसावाळा अदिक जहाज इन मालिक इन मातगोळी वाळुसकु मान्सदुन. <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />ईद बंदरगाह सोळ इन समय कडोद साटी वळ्लीद ईला ईरोद, इदुरसाटी हापाळ मुंदुर्द आग सकुल रा फीनिक्स पोहचुसोद कोशिश माळोद अच ठान्सदुर अदिक सोळ इन समय अल्या कडोद निश्चय माळदुर. ईद रा क्रेते अन्द ऊंद बंदरगाह आद जो दक्षिण-पश्चिम अदिक उत्‍तर पश्चिम येढ्ढु दिशा अन दी खुल्सतद.<verse eid="ACT 27:12" /></para>
  <para style="s">समुद्र दा तुफान</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />याग थ्वाळा-थ्वाळा दक्षिणी टु हवा बरली हत, रा ईद सम्सकु कि नाम योजना पुरा माळ सक्‍केव, लंगर नेगदेव अदिक क्रेते अन किनारा टु नळुतेला जहाज इक मुंद वाळुसली हतदेव. <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />लेकीन घळी तिमुर दा जमीन दी टु ऊंद धोळ्द तुफान येळ्त, यदरी उत्‍तर पूर्व तुफान अंदकु आगतद. <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />याग तुफान जहाज से टकरूस्त रा आ जहाज अदुर कारण मुंद ईला वाळुस सकोद, अदिक नाव कोशिश माळोद बिट बुटेव अदिक जहाज इक हवा सांगुळ यात होगोद आत होग गोट्टेव. <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />आग कौदा हेसुर इन ऊंद स्यांळ्दतुसा टापू उन आळ दा वाहुस्त-वाहुस्त नाव कठिनाई देल जहाज इक वश दा माळदेव. <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />बाक जहाज नळसावाळेर अदरी नेगुकु अनेक उपाय माळकु जहाज इक ल्यालमा टु कटदुर, अदिक सुरतिस इन चोरबालु मा टिकसोद अंज्क देल पाल अदिक सामान ईळ्सकु जहाज इक नीर दा वाहुस गोट्टुर. <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />याग नाव तुफान देल हापाळ ऊफान अदिक धक्‍कागोळ तिनदेव, रा दुसरा दिन आंदुर जहाज इन माल भीळली हतदुर; <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />अदिक तिसरा दिन आंदुर तान कयगोळ देल जहाज इन साज-सामान भी भीट बुटुर. <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />याग हापाळ दिनगोळ ताका ना सुर्य अदिक तारागोळ कांळ्सीदील अदिक धोळ्द तुफान नळुतेला ईत्‍त, रा आखरी दा तान ऊळोद सप्पा आशा नाव बिट बुटेव. <figure style="fig" alt="Ship being wrecked in a storm" file="lb00219c.tif" size="col" copy="Horace Knowles ©" ref="२७:१८">तुफान दा ड्वांगा अन्द नाश आगेत</figure><verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />याग आंदुर हापाळ दिनगोळ ताका उपासा ईतोदुर, रा पौलुस आंदुर न्याड्या निदुरकु अंदुन, “हे लॉकुरा, अगर क्रेते टु रवाना ईला आगोद नान सलाह नीव मान्स कोमायदीर रा ई विनाश अदिक नुकसान देल ऊळ्दोगायदीर. <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />लेकीन ईग ना नीम से विनती माळतीन कि तान हिम्मत कटकु ईटी, यतिकी नीम दा टु यारदु जीव इन हानि आगतीदील, पर सिर्फ ईद जहाज नष्ट आगेदीत. <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />यतिकी अंसी इन ईळ्लकी, याता परमेश्वर उन ना हुईन अदिक यार्द ना आराधना माळतीन आऊन ऊंद स्वर्गदूत नान हात्‍ती बंदुन, <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />अदिक अंदुन ‘हे पौलुस, अंजबाळ! नीनी कैसर उन मुंद निदरोद जरूरी आद. नोळ, परमेश्वर सप्पा मुंदुरी जो नीन सांगुळ यात्रा माळेत्यार, आंदुर भी जीवन नीन सांगुळ आद.’ <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />इदुरसाटी, हे लॉकुरा, हिम्मत ईटी; यतिकी ना परमेश्वर उन विश्वास माळतीन, कि ह्यांग आव नान से अंदान, हांग अच आदीत. <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />लेकीन नामी यातोदारा टापू मा होगकु टिकसोद बिद्दीत.”<verse eid="ACT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />याग चौदावा ईळ्लक बत्‍त, अदिक नाव भूमध्य समुद्र दा भटकुसतेला टेटाळेव, रा आर्धा ईळ्लक इन हात्‍ती जहाज नळसावाळेर अनुमान हचकु जान्सदुर कि नाव यातोदारा जमीन इन हात्‍ती पोहचुसेतेव. <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />नीर इन गहराई अन अंदाज ताकोंडुर मा ऊंद सौ ईप्पत फूट इन गहराई ईरोद, अदिक थ्वाळा मुंद वाळुसकु बाक गहराई अन अंदाज ताकोंडुर रा नब्बे फूट गहराई ईरोद. <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />आग कल्ल इन जागागोळ देल टकरूसोद अंज्क देल आंदुर जहाज इन हिंदळोद भाग दा नाक लंगर हाकदुर, अदिक व्हातुर आगोद प्रार्थना माळोर. <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />लेकीन याग जहाज नळसावाळेर जहाज मा टु ओळोद कोशिश माळोर, अदिक गली टु लंगर हाक्‍कोद बहाना देल जहाज समुद्र दा ईळ्स बुटुर; <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />लेकीन पौलुस सूबेदार अदिक सैनिकगोळ से अंदुन, “अगर इंदुर जहाज मा ईतीदील, रा नीव भी ऊळु सकालीर.” <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />आग सैनिकगोळ जाळी कडुकु जहाज समुद्र दा होग गोट्टुर.<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />याग व्हातुर आगदुर मा ईरोद, आग पौलुस ईद अनकु, सप्पा मुंदरी ऊम्मोर साटी विनती माळदुन, “ईंद चौदा दिन आदव कि नीव हादी काईत काईत उपास ईतीर, अदिक येनु तंदिदील. <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />ना इदुरसाटी नीमी तिनोर साटी विनती माळेतीन कि नीम जित्‍ता ईरोरसाटी जरूरी आद; यतिकी नीम दा टु यारदु ताल्ला अन्द ऊंद चुट्टी भी बिळबाळुल.” <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />ईद अनकु आव रोट्टी हुडुकु सप्पा मुंदुर मुंद परमेश्वर उन धन्यवाद माळदुन अदिक मुरूकु तिनली कुरतुन. <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />आग आंदुर सप्पा मुंदुर भी हिम्मत कटकु ऊमली कुरतुर. <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />नाव सप्पा मिलुसकु जहाज मा येढ्ढ सौ छ्यात्‍तर मुंदुर ईरेव. <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />याग आंदुर ऊंडकु संतुष्ट आदुर, रा गोदी इक समुद्र दा भिटकु जहाज इक हल्‍का माळली कुरतुर.<verse eid="ACT 27:38" /></para>
  <para style="s">जहाज इन बरबादी</para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />याग व्हातुर आत रा आंदुर आ द्याश इक अरतीदिल, लेकीन ऊंद खाळी इन किनारा कांळ्सत, अदिक विचार माळदुर कि अगर आग सकुल रा इदुर मा जहाज इक टेकसेव. <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />आग आंदुर लंगरगोळी खोल्सकु समुद्र दा बिट बुटुर अदिक अदा समय जाळीगोळ्द बंधन खोल्स बुटुर, अदिक जहाज इन मुंद मुंदळोद पाल येर्सकु किनारा दी होटोदुर. <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />लेकीन येढ्ढ समुद्र अन संगम इन जागा हुडुकु आंदुर जहाज इक टेक्सदुर, अदिक जहाज इन मुंदळोद हिस्सा धक्‍का तिनकु नट्टोत अदिक आलगाळ सकिदील; लेकीन हिंदळोद लयरगोळ्द बल देल मुरूली हत.<verse eid="ACT 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42" />आग सैनिकगोळ ईद विचार आत कि बंदीगोळी कोंद बुटेव, हिंग आगबाळुल कि यावारा तैरूस्कु ओळेगुल. <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />लेकीन सूबेदार पौलुस उक सुरक्षित माळोद इच्छा देल आंदरी ईद विचार देल रोक्सदुन अदिक उल्टा ईद आग्या कोट्टुन, कि जो तैरूस सकतार, पयले हारकु किनारा मा होट बुळुल; <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />अदिक बाकी यारारा पट्टीगोळ मा, अदिक यावारा जहाज इन मुर्द तुकळा गोळ्द सहारा देल होट बुळुल. ईद रीति देल सप्पा मुंदुर किनारा मा सुरक्षित ऊळ्दकु होट्टुर.<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s">माल्टा टापू दा पौलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />याग नाव किनारा मा सुरक्षित पोहचुसदेव, आग पता नळुत कि ईद टापू उक माल्टा अंदकु आगतद. <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />अलेर निवासीगोळ नाम मा अनोखा कृपा माळदुर; यतिकी माळ बरोद कारण सोळ इन ईरोद, इदुरसाटी आंदुर बेक्‍की होत्‍ताकु नाम सप्पा मुंदुर्द स्वागत माळदुर. <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />याग पौलुस वंळ्गेव हुळ्लीगोळ्द गट्टा सकलुसकु बेक्‍की मा ईटदुन, रा ऊंद हाव बेक्‍की इन आच देल होळ्त अदिक आऊन कय इक गुणसेत. <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />याग आ निवासीगोळ हाव इक आऊन कय इक गुंडस्कु नोळदुर, रा आपस दा अंदुर, “सचमुच ईव मंळसा हत्यारा आन लेकीन ईऊन किस्मत वळ्लेव आव जो समुद्र दा ऊळदोदुन, तरी भी न्याय जीवित ईर गोटीदील.” <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />आग आव हाव इक बेक्‍की दा झटकुस बुटुन, अदिक पौलुस उक येनु हानि भी पोहचुसीदील. <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />लेकीन आंदुर हादी कायतोगोर कि आव बातोदान या एकाएक बिदकु सोतोदान, लेकीन याग आंदुर हापाळ होत ताका नोळ्त ईत्‍तुर अदिक नोळकु आऊक असाधारण रूप दा भी येनु आगिदील, रा तान विचार बदलुस्कु अनली हतदुर, “ईव रा यावारा देवता हुन.”<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />आ जागा अन आसपास आ टापू उन प्रधान अधिकारी पुबलियुस उन जागा ईरोद. आव नामी तान मान्या ओतकु नाम स्वागत माळदुन मुर दिन संगीभाव देल पाऊनचार माळदुन. <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />पुबलियुस उन आप्प मय देल अदिक आव खुन देल रोगी बिदकु ईरोन. इदुरसाटी पौलुस आऊन हात्‍ती मान्या होगकु प्रार्थना माळदुन अदिक आऊन मा कय ईटकु आऊक चंगा माळदुन. <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />याग हिंग आत रा आ टापू उन बाकी बिमार बंदुर अदिक चंगा माळकु आदुर. <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />आंदुर नाम्द हर प्रकार देल आदर माळदुर, अदिक याग नाव होगली कुरतेव रा जो येनारा नाम साटी जरूरी ईरोद, जहाज मा ईट बुटुर.<verse eid="ACT 28:10" /></para>
  <para style="s">माल्टा टापू टु रोम दी</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />मुर तिंगुळ इन बाद्दा नाव सिकन्दरिया अन्द ऊंद जहाज मा येरदेव, अदिक ई जहाज ईदा टापू दा सोळ इन दिनगोळ कारण ईल्या रूक्सकु ईरोद, आ जहाज इक जुळवा ईश्वर अंदकु आगोद. <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />नाव सुरकूसा दा पोहचुसदेव अदिक मुर दिन ताका अल्या ईत्‍तेव. <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />अल टु नाव रवाना आगकु रेगियुम नगर दा बंदेव; अदिक दुसरा दिशी दक्षिण टु हवा नळुत, अदिक नाव दुसरा दिशी पुतियुली नगर दा बंदेव. <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />अल नामी विश्वासी वार्टुर सिकदुर, अदिक आंदुर कहना देल नाव आंदुर अल येळ दिन ताका ईत्‍तेव; अदिक ई रीति देल नाव रोम इक होटोदेव. <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />याग रोम इन विश्वासी वार्टुर इक नाम सुचना सिक्त रा अप्पियुस इन सात्‍ता अदिक मुर-सराए ताका नाम से मुलाकात माळली बंदुर, यारी नोळकु पौलुस परमेश्वर उन धन्यवाद माळदुन अदिक प्रोत्साहित आदुन.<verse eid="ACT 28:15" /></para>
  <para style="s">रोम दा पौलुस</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16" />याग नाव रोम दा पोहचुसदेव, रा पौलुस उक ऊंद सैनिक उन सांगुळ जो आऊन रखवाली माळतोगोन, आबना ईरोद आग्या सिक्‍केत. <figure style="fig" alt="Street scene of The Roman city" file="hk00242c.tif" size="span" copy="Horace Knowles ©" ref="२८:१६">रोमन शयर इन सळक इन नजारा</figure><verse eid="ACT 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />मुर दिन इन बाद्दा आव यहूदीगोळ्द प्रमुख लॉकुरी कारदुन, अदिक याग आंदुर जमा आदुर रा आंदुर से अंदुन, “हे वार्टुरा, ना तान लॉकुर्द या आप्प दादागोळ व्यवहारगोळ्द विरोध दा येनु अच माळीदील, तरी नानी बंदी माळकु यरूशलेम टु रोमीगोळ्द कय दा कोटकु आत. <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />आंदुर नान जाँच माळदुर अदिक नानी बिट बुळोद चाहासदुर, यतिकी नान दा मृत्यु उन योग्य येनु दोष ईला ईरोद. <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" /><note caller="+" style="x"><char style="xo" closed="false">२८:१९ </char><char style="xt" closed="false"><ref loc="ACT 25:11">प्रेरितगोळ २५:११</ref></char></note>लेकीन याग यहूदी ईदुर्द विरोध दा माताळली कुरतुर, रा नानी कैसर से न्याय बेळोद प्रार्थना माळोद बित्‍त: इदुरसाटी ईला कि नानी तान लॉकुर मा येनारा दोष हचोद ईरोद. <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />इदुरसाटी ना नीमी कारदिन कि नीम से मिलुसाईन अदिक मातचीत हेळाईन; यतिकी आ मंळसा अन साटी ना ई शंकली देल जकळुसकु आईन यार्द इस्त्राएल इन लॉकुर आशा माळतोगोर.”<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />आंदुर आऊन से अंदुर, “ना नामी नीन बारा दा यहूदीगोळ से चिट्ठी गोळ सिकदव, अदिक ना वार्टुर दा टु यावारा बंदकु नीन बारा दा येनारा हेळदुर अदिक ना बुरा अंदुर. <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />लेकीन नीन विचार येन आद? अदा नाव नीन से केळोद चाहासतेव, यतिकी नाव जान्सतेव कि नी याता समुह टु बरत्या अद समुह अन विरोध सप्पा दी लॉकुर माळतार.”<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />आग आंदुर आऊन साटी ऊंद दिन ठहरूसदुर, अदिक हापाळ सा लॉकुर जमा आदुर, अदिक आव परमेश्वर उन राज्य अन गवाही कोळतेला, अदिक मूसा अन व्यवस्था अदिक भविष्यवक्तागोळ्द किताबगोळ देल यीशु उन बारा दा समझुस समझुस्कु व्हातर्या टु द्यावगा ताका वर्णन माळतेला ईत्‍तुन. <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />आग थ्वाळासा लॉकुर आ मातगोळी मान्स कोंडुर, अदिक थ्वाळासा लॉकुर विश्वास माळीदील. <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />बाक आंदुर आपस दा आबुर दाबुर देल असयमत आगतेला आंदुर अल टु होग कुरतुर, आग पौलुस ईद ऊंद मात अंदुन अदिक यशायाह भविष्यवक्ता अन द्वारा पवित्र आत्मा नीम आप्प दादागोळ से याट सही अंदीत, <verse eid="ACT 28:25" /><verse number="26" style="v" sid="ACT 28:26" />यतिकी आव अंदुन,</para>
  <para style="q1" vid="ACT 28:26">होगकु ई लॉकुर से अन,</para>
  <para style="q1" vid="ACT 28:26">कि नीव केळीर, लेकीन सम्सतिदील,</para>
  <para style="q2" vid="ACT 28:26">अदिक नीव नोळतेला अच ईत्‍तीर, लेकीन नीमी कांळ्सतिदील;<verse eid="ACT 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27" />यतिकी ई लॉकुर्द मन कठोर अदिक आंदुर तान किव बंद माळ बुटार,</para>
  <para style="q2" vid="ACT 28:27">अदिक आंदुर कण्णगोळ बंद आगेग्याव,</para>
  <para style="q2" vid="ACT 28:27">हिंग आगबाळुल कि आंदुर यागलु कण्णगोळ देल नोळुल अदिक किवगोळ देल केळुल</para>
  <para style="q2" vid="ACT 28:27">अदिक मन देल समसुल अदिक नान दी तिर्गुल,</para>
  <para style="q2" vid="ACT 28:27">अदिक ना आंदरी चंगा माळाईन.<verse eid="ACT 28:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28" />अदिक पौलुस ई मात देल ईदुर्द समापन माळदुन कि “नीमी जान्स कोम पायजे कि परमेश्वर उन ई उद्धार इन बातणी गैरयहूदीगोळ हात्‍ती कळुकु आगेग्याद, आंदुर ईदरी केळ्यार.” <verse eid="ACT 28:28" /><verse number="29" style="v" sid="ACT 28:29" /><note caller="+" style="f"><char style="fr" closed="false">२८:२९ </char><char style="ft" closed="false">येनारा हस्तलेख दा ईद वचन सिकाल्द</char></note> याग आव ईद अंदुन रा यहूदी आपस दा हापाळ झगळा माळली कुरतुर अदिक अल टु होटोदुर.<verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />पौलुस पुरा येढ्ढ वर्ष तान किराया अन मान्या ईत्‍तुन, अदिक जो आऊन हात्‍ती आऊन से मुलाकात माळली बरतोगोर, आ सप्पा मुंदुर्द स्वागत माळ्त ईत्‍तुन. <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />अदिक पुरा स्वतंत्रता अदिक हिम्मत इन सांगुळ परमेश्वर उन राज्य अन्द प्रचार माळोन अदिक प्रभु यीशु मसीह अन बारा दा कल्सतेला ईत्‍तुन.<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>