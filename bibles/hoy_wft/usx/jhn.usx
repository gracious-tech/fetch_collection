<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Holiya</book>
  <para style="h">यूहन्ना</para>
  <para style="toc3">यूहन्ना</para>
  <para style="toc2">यूहन्ना</para>
  <para style="toc1">यूहन्ना अन्द लिख्सद यीशु मसीह अन बारा दा खुशखबरी</para>
  <para style="mt2">यूहन्ना रचित यीशु मसीह का सुसमाचार</para>
  <para style="mt1">यूहन्ना अन्द लिख्सद यीशु मसीह अन बारा दा खुशखबरी</para>
  <para style="imt">परिचय</para>
  <para style="ip">ईद यूहन्ना अन लिख्सद ई खुशखबरी इन किताब व्हाशेव नियम इन नाक खुशखबरी इन किताबगोळ दा टु ऊंद हुन, जो यीशु मसीह अन जीवन इन बारा दा हेळतद. यीशु मसीह अन सोत्‍तुर बाद्दा, मत्ती, मरकुस, लूका, अदिक यूहन्ना अन द्वारा ई किताबगोळी लिख्सकु आग्याद. ई सप्पा किताबगोळी खुशखबरी इन किताब अनतार. मसीह अन जनम इन ९० वर्ष इन बाद्दा ईद खुशखबरी प्रेरित यूहन्ना लिखस्यान. ई किताब दा ईद लिख्सकु हैलेच कि इदरी लिखसावाळा लेखक यूहन्ना हुन, तरी भी पयला यूहन्ना, दुसरा यूहन्ना अदिक तिसरा यूहन्ना अन लिखावट देल मेल तिनतद. आ समय यूहन्ना इफिसुस शयर दा ईरतोगोन इदुरसाटी ई किताब इफिसुस दा लिख्सकु आग्याद हिंग येनारा स्याणा लेखकगोळ मान्सतार.</para>
  <para style="ip">यूहन्ना ई किताब लिखसोद उद्देश सफाई देल ईटतान कि लॉकुरी, यीशु मसीह हुन अदिक जित्‍ता परमेश्वर उन पार हुन <char style="xt"><ref loc="JHN 20:31">यूहन्ना २०:३१</ref></char> ई मात मा विश्वास माळोर साटी लॉकुरी मदत सिकुल. आऊन मा विश्वास माळदुर द्वारा आऊन हेसुर देल नामी जीवन सिक सकुल. ईद किताब यहूदी अदिक गैरयहूदी येढ्ढु मुंदुर साटी लिख्सकु आग्याद. यूहन्ना अन खुशखबरी दा बाकी नव मुर खुशखबरी दा टु येनारा मातगोळ अलग आव. यीशु मसीह अन माळ्द चमत्कारगोळ मा यूहन्ना ऊजुळ हाकतान अदिक आऊन उदाहरणगोळ बारा दा यक्कुल लिख्सकु आगीदील. यीशु अन बपतिस्मा अदिक सुनसान जागा दा परीक्षा, ऊंदा घाई जरूरी घटनागोळी ई खुशखबरी दा लिख्सकु आगीदील.</para>
  <para style="iot">रूप रेखा:</para>
  <para style="io1">१. यूहन्ना खुशखबरी इन सुरूवात <char style="ior"><ref loc="JHN 1:1-18">१:१-१८</ref></char></para>
  <para style="io1">२. बाद्दा आव आ चमत्कारगोळ बारा दा लिख्सतान जो यीशु माळ्यान <char style="ior"><ref loc="JHN 1:19-12:50">१:१९–१२:५०</ref></char></para>
  <para style="io1">३. मुंद आव हापाळ घटनागोळ बारा दा हेळतान जो यीशु मसीह इन जीवन इक मृत्यु अदिक पुनरूत्थान ताका ओयताव <char style="ior"><ref loc="JHN 13:1-20:31">१३:१–२०:३१</ref></char></para>
  <para style="io1">४. यूहन्ना अन <char style="ior"><ref loc="JHN 21">२१</ref></char> आ पाठ दा खुशखबरी खतम माळतान, यदुर दा यीशु सोत्‍तुर दा टु जित्‍ता आगकु लॉकुर मुंद बरतान. अदिक आखरी दा तान किताब लिखसोद उद्देश हेळतेला खतम माळतान.</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">जीवन इन शब्द</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />सुरूवात दा शब्द ईरोद, अदिक शब्द परमेश्वर उन सांगुळ ईरोद, अदिक शब्द परमेश्वर ईरोन. <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />ईदा शब्द सुरूवात टु परमेश्वर उन सांगुळ ईरोद. <verse eid="JHN 1:2" /><verse number="3" style="v" sid="JHN 1:3" />सप्पा येनारा शब्द इन द्वारा पैदा आत, अदिक जो येनारा पैदा आग्याद अदुर दा टु यातोदारा भी चिज आऊन सिवाय बनसीदील. <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />शब्द जीवन इन स्त्रोत ईरोद अदिक अद जीवन लॉकुर साटी ऊजुळ तर्त. <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />ऊजुळ अंधार दा चमकुसतद, अदिक अंधार यागलु इदरी हारूस सकाल.<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:६ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:1">मत्ती ३:१</ref>; <ref loc="MRK 1:4">मरकुस १:४</ref>; <ref loc="LUK 3:1">लूका ३:१</ref>,<ref loc="LUK 3:2">२</ref></char>
    </note>परमेश्वर ऊंद बातणी कोळावाळा कळुदुन यार्द हेसुर यूहन्ना ईरोद. <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />आव गवाही कोळली बंदुन कि ऊजुळ इन गवाही कोळुल, ताकी सप्पा मुंदुर आऊन बातणी केळकु विश्वास माळुल. <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />आव खुद रा ऊजुळ ईला ईरोन, लेकीन आ ऊजुळ इन गवाही कोळोर साटी बंदीदुन. <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />खरा ऊजुळ जो हर ऊंद मंळसा अक प्रकाशित माळतद, दुनिया दा बरावाळा ईरोद.<verse eid="JHN 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10" />अद शब्द दुनिया दा ईरोद, अदिक परमेश्वर आऊन द्वारा दुनिया माळदुन, तरी भी दुनिया आऊक अरतीदिल. <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />आव तान खुद इन लॉकुर हाती बंदुन लेकीन आऊन खुद इन लॉकुर आऊक ग्रहण माळीदील. <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />लेकीन यास मुंदुर आऊक ग्रहण माळदुर, मतलब आंदरी जो आऊन हेसुर मा विश्वास ईटतार, आव आंदरी परमेश्वर उन औलाद आगोद अधिकार कोट्टुन. <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />आंदुर ना रा स्वाभाविक तरीका देल परमेश्वर उन औलाद बन्सदुर, मतलब मानवीय आप्प उन देल पैदा आगीदील बल्‍की परमेश्वर खुद आंदुरव आप्प ईरोन.<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />अदिक वचन देहधारी आत; अदिक अनुग्रह अदिक सच्चाई देल परिपुर्ण आगकु नाम न्याड्या ड्यारा हाक्त, अदिक नाव अदुर्द हिंग महिमा नोळदेव, जसा आप्प उन ऊंद ठैसा अन्द महिमा.<verse eid="JHN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />यूहन्ना आऊन बारा दा गवाही कोट्टुन, अदिक कारूकु अंदुन, “ईव आवा हुन, यार्द वर्णन ना माळदीन कि जो नान बाद्दा बरेत्यान, आव नान से वाळुसकु आन यतिकी आव नान से पयले ईरोन.”<verse eid="JHN 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16" />यतिकी आऊन परिपुर्णता दा टु नाव सप्पा मुंदुर प्राप्त माळदेव मतलब अनुग्रह मा अनुग्रह प्राप्त माळदेव. <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />इदुरसाटी कि व्यवस्था रा मूसा अन्द द्वारा कोटकु आत, लेकीन अनुग्रह अदिक सच्चाई यीशु मसीह अन्द द्वारा बत्‍त. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />परमेश्वर उक याऊ यागलु नोळीदील, ऊंद ठैसा पार जो आप्प उन क्वारा दा आन, आवा परमेश्वर उक प्रगट माळदुन.<verse eid="JHN 1:18" /></para>
  <para style="s">यूहन्ना बपतिस्मा कोळावाळा अन्द बातणी</para>
  <para style="r">(<ref loc="MAT 3:1-12">मत्ती ३:१-१२</ref>; <ref loc="MRK 1:1-8">मरकुस १:१-८</ref>; <ref loc="LUK 3:1-18">लूका ३:१-१८</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />यूहन्ना अन्द गवाही ईद आद, कि याग यहूदीगोळ यरूशलेम टु याजकगोळ अदिक कर ताकोमावाळेर इक आऊन से ईद केळोर साटी कळुदुर, “नी याव हुय?”<verse eid="JHN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20" />रा आव ईद मान्स कोंडुन अदिक इनकार माळीदिल, लेकीन मान्स कोंडुन, “ना मसीह आलच.”<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />आग आंदुर आऊन से केळदुर, “रा बाक नी याव हुय? येन नी एलिय्याह हुय?”</para>
  <para style="p" vid="JHN 1:21">आव अंदुन, ईला, “ना एलिय्याह आलच.”</para>
  <para style="p" vid="JHN 1:21">“रा येन नी आ भविष्यवक्ता हुय?”</para>
  <para style="p" vid="JHN 1:21">आव उत्‍तर कोट्टुन, “ईला.”<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />आग आंदुर आऊन से केळदुर, “बाक नी हुय याव? यतिकी नाव तान कळावाळेर इक उत्‍तर कोट्टेव. नी तान बारा दा येन हेळत्या?”<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />यूहन्ना अंदुन, “ह्यांग यशायाह भविष्यवक्ता अंदान:</para>
  <para style="q1" vid="JHN 1:23">“ना आळी दा ऊंद कारावाळा अन्द आवाज हुईन</para>
  <para style="q2" vid="JHN 1:23">कि नीव प्रभु उन हादी सरका माळी.”<verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />आंदुर फरीसीगोळ्द दी टु कळुकु आगीदुर. <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />आंदुर आऊन से केळदुर, “अगर नी मसीह आलच, अदिक ना एलिय्याह, अदिक ना आ भविष्यवक्ता हुय, रा बाक बपतिस्मा येती कोळत्या?”<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />बपतिस्मा कोळावाळा यूहन्ना आंदरी उत्‍तर कोट्टुन, “ना रा नीर देल बपतिस्मा कोळतीन, लेकीन नीम बीच दा ऊंद मंळसा निदुरकु आन यारी नीव अरालीर. <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />मतलब नान बाद्दा बरावाळा आन, आऊन केरू उन बन्ध भी ना खोल्सा लायक हैलेच.”<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />“ई मातगोळ यरदन गांगा अन्द आप्पाटी बैतनिय्याह नगर दा आदव, यल यूहन्ना बपतिस्मा कोळतोगोन.”<verse eid="JHN 1:28" /></para>
  <para style="s">परमेश्वर उन मेमना<note caller="+" style="f"><char style="fr" closed="false">१:२९ </char><char style="ft" closed="false">म्यांडा अन पाड्डा</char></note></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />“दुसरा दिशी यूहन्ना यीशु उक तान दी बर्त नोळकु अंदुन, नोळी ईव परमेश्वर उन म्यांडा अन पाड्डा हुन जो दुनिया अन्द पाप नेगुकु वोयतान. <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />ईव आवा हुन यार्द बारा दा ना अंदिदीन, ऊंद मंळसा नान हिंद बरतान जो नान से श्रेष्ट आन, यतिकी आव नान से पयले ईरोन. <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />ना भी रा आऊक ईला अरीन, लेकीन इदुरसाटी ना नीर देल बपतिस्मा कोळतेला बंदीन कि आव इस्त्राएल मा प्रगट आगेगुल.”<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />अदिक बपतिस्मा कोळावाळा यूहन्ना ईद गवाही कोट्टुन: “ना पवित्र आत्मा अक कबूतर इन घाई स्वर्ग टु ईळुतेला नोळीन, अदिक नोळदीन कि आ आत्मा आऊन मा बंदकु ठेहरूसेत. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />ना रा आऊक ईला अरीन, लेकीन याव नानी नीर देल बपतिस्मा कोळली कळुदुन, आवा नान से अंदुन, ‘यार मा नी आत्मा अक ईळुत अदिक ठेहरूस्त नोळ्या, आवा पवित्र आत्मा देल बपतिस्मा कोळावाळा हुन.’ <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />अदिक ना नोळदीन, अदिक गवाही कोट्टीन कि ईवा परमेश्वर उन पार हुन.”<verse eid="JHN 1:34" /></para>
  <para style="s">यीशु नोर पयला चेलागोळ</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />दुसरा दिन मात्‍त यूहन्ना तान येढ्ढ चेलागोळ सांगुळ निदुरकु ईरोन, <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />अदिक आव यीशु उक होग्त नोळदुन, अदिक अंदुन, “नोळी, ईव परमेश्वर उन म्यांडा अन पाड्डा हुन.”<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />आग आंदुर येढ्ढु चेलागोळ आऊन मातगोळ केळकु यीशु उन हिंद आगेदुर. <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />यीशु तिर्गकु आंदरी बर्त नोळदुन अदिक आंदुर से अंदुन, “नीव यार्द खोज दा आईर?”</para>
  <para style="p" vid="JHN 1:38">आंदुर आऊन से अंदुर, “हे गुरु, नी यल ईरत्या?”<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />यीशु आंदुर से अंदुन, “नळी, रा नोळ कोंडीर.” आग आंदुर होगकु आऊन ईरोद जागा नोळदुर, अदिक आ दिन आऊन सांगुळ ईत्‍तुर. यतिकी द्यावमुळका नव लगभग नाक मुरदोगिदव.<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />आ येढ्ढु मुंदुर दा टु, जो यूहन्ना अन्द मात केळकु हिंद आगेगीदुर, ऊंद शमौन पतरस उन वार्ट अन्द्रियास ईरोन. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />आव पयले तान सग्गा वार्ट शमौन से सिक्‍कु आऊन से अंदुन, “नामी ख्रिस्त, मतलब मसीह, सिक्‍केग्यान.” <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />अन्द्रियास आऊक यीशु उन हात्‍ती तंदुन.</para>
  <para style="p" vid="JHN 1:42">यीशु आऊन मा दृष्टी माळकु अंदुन, “नी यूहन्ना अन्द पार शमौन हुय: नीनी कैफा मतलब पतरस अंदकु आदीत.<verse eid="JHN 1:42" /></para>
  <para style="s">फिलिप्पुस अदिक नतनएल उक कारूकु आगोद</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />“दुसरा दिशी यीशु गलील नगर इक होगोद चाहासदुन. यीशु फिलिप्पुस से भेंट माळदुन अदिक अंदुन, ‘नान हिंद आगेग.’” <verse eid="JHN 1:43" /><verse number="44" style="v" sid="JHN 1:44" />फिलिप्पुस, अन्द्रियास अदिक पतरस उन नगर बैतसैदा नव ईरावाळा ईरोन. <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />फिलिप्पुस नतनएल से भेंट माळदुन अदिक आऊन से अंदुन, “यार्द वर्णन मूसा व्यवस्था अन्द किताब दा अदिक भविष्यवक्तागोळ माळ्यार, आव नामी सिक्‍केदुन; आव यूसुफ उन पार, यीशु नासरी हुन.”<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />नतनएल आऊन से अंदुन, “येन येनारा वळ्लीद वस्तु भी नासरत नगर टु होळ सकतद?”</para>
  <para style="p" vid="JHN 1:46">फिलिप्पुस आऊन से अंदुन, “नळुकु नोळ कोम.”<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />यीशु नतनएल उक तान दी बर्त नोळकु आऊन बारा दा अंदुन, “नोळी, ईव सही दा इस्त्राएली हुन: ईऊन बुळ्क कपट हैलेच.”<verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />नतनएल आऊन से अंदुन, “नी नानी ह्यांग अरूत्या?”</para>
  <para style="p" vid="JHN 1:48">यीशु आऊक उत्‍तर कोट्टुन, “इदुर से पयले कि फिलिप्पुस नीनी कारदुन, याग नी अंजीर इन मार्र इन ल्यालमा ईर्‍या, आग ना नीनी नोळीदीन.”<verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />नतनएल आऊक उत्‍तर कोट्टुन, “हे गुरु, नी परमेश्वर उन पार हुय; नी इस्त्राएल इन राजा हुय.”<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />यीशु आऊक उत्‍तर कोट्टुन, “ना जो नीन से अंदीन कि ना नीनी अंजीर इन मार्र इन ल्यालमा नोळदीन, येन नी इदुरसाटी नान मा विश्वास माळत्या? नी इदुर से भी धोड्-धोड्डेव क्याल्सा नोळ्या.” <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />बाक आऊन से अंदुन, “ना नीम से खरा खरा माताळतीन कि नीव स्वर्ग इक तेरूतेला, अदिक परमेश्वर उन स्वर्गदूतगोळ इक मंळसा अन पार उन म्याकुच ईळुत अदिक म्याकुच होग्त नोळीर.”<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">काना नगर दा मदा</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />तिसरा दिशी गलील इन काना नगर दा यारदारा मदा ईरोद, अदिक यीशु उन मोय भी अल ईरोर. <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />यीशु अदिक आऊन चेलागोळ भी आ मदा दा आमंत्रित ईरोर. <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />याग अंगुर इन रास्सा खतम आगेत, रा यीशु उन मोय यीशु से अंदुर, “आंदुर हात्‍ती अंगुर इन रास्सा मिकिदिल.”<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />यीशु आकिन से अंदुन “हे मोयी, नानी नीन से येन क्याल्सा? ईगल्या नान समय बरली आद.”<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />आऊन मोय सेवकगोळ से अंदुर, “जो येनारा आव नीम से अंदान, अदा माळेतीर.”<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />अल यहूदीगोळ्द कय-काल तोळोद प्रथा अन्द अनुसार कल्लगोळ्द आर: माळका ईटकु ईरव, हर ऊंद माळका दा लगभग येढ्ढ-येढ्ढ, मुर-मुर मन तुमकु आगोद. <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />यीशु सेवकगोळ से अंदुन, “माळकागोळ दा नीर तुम बुळी.” आंदुर अवरी सीगासीग तुम बुटुर. <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />आग आव आंदुर से अंदुन, “ईग थ्वाळासा नीर तेगुकु सयपाक माळावाळा प्रधान उन हात्‍ती ओई.” अदिक आंदुर ओतुर. <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />याग सयपाक माळावाळा प्रधान अद नीर इक नेकदुन, जो अंगुर इन रास्सा बनसेगित अदिक आव ईला अरोन कि अद यल टु बंदाद लेकीन जो सेवकगोळ नीर तेगदिदुर आंदुर अरोर, रा सयपाक माळावाळा प्रधान मंळगार उक कारूकु आऊन से अंदुन, <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />“हर ऊंद मंळसा पयले वळ्लीद अंगुर इन रास्सा कोळतान, अदिक याग लॉकुर कुडुकु संतुष्ट आगेगतार, आग थ्वाळासा मध्यम प्रकार इन रास्सा कोळतान; लेकीन नी रा वळ्लीद अंगुर इन रास्सा ईगासताका मिक्सकु ईट्या.” <figure style="fig" alt="Filling water in the stone jars" file="lb00135c.tif" size="col" copy="Horace Knowles ©" ref="२:७">कल्ल इन बर्तनगोळ दा नीर तुमतेला मंळसा</figure><verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />यीशु गलील इन काना नगर दा तान ईद पयला चमत्कार तोर्सकु तान महिमा प्रगट माळदुन अदिक आऊन चेलागोळ आऊन मा विश्वास माळदुर.<verse eid="JHN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२:१२ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:13">मत्ती ४:१३</ref>
      </char>
    </note>इदुर बाद्दा यीशु अदिक आऊन मोय अदिक आऊन वार्टुर अदिक आऊन चेलागोळ कफरनहूम नगर इक होदुर अदिक अल थ्वाळासा दिन ईत्‍तुर.<verse eid="JHN 2:12" /></para>
  <para style="s">यीशु उन मंदिर दा होगोद</para>
  <para style="r">(<ref loc="MAT 21:12">मत्ती २१:१२</ref>,<ref loc="MAT 21:13">१३</ref>; <ref loc="MRK 11:15-17">मरकुस ११:१५-१७</ref>; <ref loc="LUK 19:45">लूका १९:४५</ref>,<ref loc="LUK 19:46">४६</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />यहूदीगोळ्द फसह अन्द हाब्ब हात्‍ती ईरोद, अदिक यीशु यरूशलेम इक होदुन. <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />आव मंदिर दा वस्ता, म्यांडा अदिक कबूतर मारावाळेर अदिक व्हान्ना मारावाळेर लॉकुरी कुर्तकु नोळदुन. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />आग आव जाळीगोळ्द क्वाळा माळकु, सप्पा म्यांडागोळ अदिक वस्तागोळी मंदिर टु तेग्द बुट्टुन, अदिक व्हान्ना मारावाळेर लॉकुर्द पैस्या भिटकु सळा माळ बुट्टुन अदिक पांळ्सीगोळी उलटुस बुट्टुन, <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />अदिक कबूतरमारावाळेर से अंदुन, “इवरी ईल टु राटनेरी ओई. नान आप्प उन मान्ना अक व्यापार इन मान्ना माळबाळी.” <verse eid="JHN 2:16" /><verse number="17" style="v" sid="JHN 2:17" /><note caller="+" style="f"><char style="fr" closed="false">२:१७ </char><char style="ft" closed="false">भजन संहिता ६ ९:९ </char></note>आग आऊन चेलागोळी याद बत्‍त कि लिख्सकु शास्त्र आद, “नीन मान्ना अन्द धुन नानी तिंद बुट्टीत.”<verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />इदुर मा यहूदीगोळ आऊन से अंदुर, “नी जो ईद माळत्या रा नामी यातोद चमत्कार तोर्सत्या?”<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२:१९ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:61">मत्ती २६:६१</ref>; <ref loc="MAT 27:40">२७:४०</ref>; <ref loc="MRK 14:58">मरकुस १४:५८</ref>; <ref loc="MRK 15:29">१५:२९</ref></char>
    </note>यीशु आंदरी उत्‍तर कोट्टुन, “ई मंदिर इक केळ्द बुळी, अदिक ना इदरी मुर दिन दा निदरूस बुळाईन.”<verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />यहूदीगोळ अंदुर, “ई मंदिर इक माळदुर दा छ्यालीस वर्ष हत्याव, अदिक येन नी ईदरी मुर दिन दा निदरूस बुट्या?”<verse eid="JHN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21" />लेकीन यीशु तान मय इन मंदिर इन बारा दा अंदिदुन. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />इदुरसाटी याग आव सोत्‍तुर दा टु जित्‍ता आदुन रा आऊन चेलागोळी याद बत्‍त कि आव ईद अंदिदुन; अदिक आंदुर पवित्रशास्त्र अदिक आ वचन इन जो यीशु अंदिदुन, विश्वास माळदुर.<verse eid="JHN 2:22" /></para>
  <para style="s">यीशु मंळसा अन्द मन इक अरूतान</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />याग यीशु यरूशलेम दा फसह अन्द समय हाब्ब दा ईरोन, रा हापाळ मुंदुर आ चमत्कारगोळी जो आव तोर्सतोगोन नोळकु आऊन हेसुर मा विश्वास माळदुर. <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />लेकीन यीशु तान तान इक आंदुर भरोसा मा बिटीदिल, यतिकी आव सप्पा मुंदुर मनगोळी अरूतोगोन; <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />अदिक आऊक जरवत ईला ईरोद कि मंळसा अन्द बारा दा यावारा गवाही कोळुल, यतिकी आव खुद अच अरोन कि मंळसा अन्द मन दा येन आद?<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">यीशु अदिक नीकुदेमुस</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />फरीसीगोळ दा नीकुदेमुस हेसुर ईनव ऊंद मंळसा ईरोन, जो यहूदी लॉकुरव सरदार ईरोन. <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />आव ईळ्लक इक यीशु उन हात्‍ती बंदकु आऊन से अंदुन, “हे गुरु, नाव जान्सतेव कि नी परमेश्वर दी टु गुरु आगकु बंद्या, यतिकी ई चिन्हगोळी जो नी तोर्सत्या, अगर परमेश्वर नीन सांगुळ ईला ईरायदुन रा नी ई चिन्हगोळी ईला तोर्स सकाईद.”<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />यीशु आऊक उत्‍तर कोट्टुन, “ना नीन से खरा खरा अनतीन, अगर यावारा व्हाशोद रीति देल पैदा आगालुन रा आव परमेश्वर उन राज्य नोळ सकालुन.”<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />नीकुदेमुस यीशु उक अंदुन, “मंळसा याग हाळाबाट आगेदुन, रा ह्यांग पैदा आग सकतान? येन आव तान मोय इन गर्भ दा दुसरा घन प्रवेश माळकु पैदा आग सकतान?”<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />यीशु उत्‍तर कोट्टुन, “ना नीन से खरा खरा अनतीन, यागासताका यावारा मंळसा नीर अदिक आत्मा देल पैदा आगालुन आगासताका आव परमेश्वर उन राज्य दा प्रवेश माळ सकालुन. <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />यतिकी जो मय देल पैदा आग्याद, अद मय हुन; अदिक जो आत्मा देल पैदा आग्याद, अद आत्मा हुन. <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />अचम्भा माळबाळ कि ना नीन से अंदीन, ‘नीनी व्हाशोद रीति देल पैदा आगोद जरूरी आद.’ <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />हवा यात चाहासतद आत नळुतद अदिक नी अदुर्द शब्द केळत्या, लेकीन अरू सकाल कि अद यातु टु बरतद अदिक यात होगतद? जो यावारा आत्मा देल पैदा आग्यान आव हिंग अच आन.”<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />नीकुदेमुस आऊक उत्‍तर कोट्टुन, “ईव मातगोळ ह्यांग आग सकताव?”<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />ईद केळकु यीशु आऊन से अंदुन, “नी इस्त्राएलीगोळ्द गुरु ईतकु भी येन ई मातगोळी समसाल? <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />ना नीन से खरा खरा अनतीन कि नाव जो अरूतेव अद माताळतेव, अदिक यदरी नाव नोळेव अदुर्द गवाही कोळतेव, अदिक नीव नाम गवाही ग्रहण माळालीर. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />याग ना नीम से पृथ्वी इन मातगोळ माळदीन अदिक नीव विश्वास माळीदिल, रा अगर ना नीम से स्वर्ग इन मातगोळ माळाईन रा बाक ह्यांग विश्वास माळीर? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />याऊ स्वर्ग मा येरीदिल, सिर्फ आवा जो स्वर्ग टु ईळदान, मतलब मंळसा अन पार जो स्वर्ग दा आन.”<verse eid="JHN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14" />अदिक याता रीति देल मूसा आळी दा हाव इक ऊँचाई मा येर्सदुन, अदा रीति देल जरूरी आद कि मंळसा अन पार भी ऊँचाई मा येर्सकु आगुल; <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />ताकी जो यावारा आऊन मा विश्वास माळ्यान आऊक अनन्त जीवन सिकुल. <verse eid="JHN 3:15" /><verse number="16" style="v" sid="JHN 3:16" />“यतिकी परमेश्वर दुनिया से हिंग प्यार ईटदुन कि आव तान ऊंद ठैसा पार कोट बुट्टुन, ताकी जो यावारा आऊन मा विश्वास माळ्यान आऊन नाश आगबाळुल, लेकीन आऊक अनन्त जीवन सिकुल. <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />परमेश्वर तान पार उक दुनिया दा इदुरसाटी कळीदिल कि दुनिया मा दण्ड इन आग्या कोळुल, लेकीन इदुरसाटी कळ्यान कि दुनिया अक आऊन द्वारा उद्धार सिकुल.<verse eid="JHN 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 3:18" />“जो आऊन मा विश्वास माळतान, आऊन मा दण्ड इन आग्या आगाल, लेकीन जो आऊन मा विश्वास माळालुन, आव दोषी ठहरूसतान; इदुरसाटी कि आव परमेश्वर उन ऊंद ठैसा पार उन हेसुर मा विश्वास माळीदिल. <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />अदिक दण्ड इन आग्या अन्द कारण ईद आद कि ज्योति दुनिया दा बंदाद, अदिक मंळसागोळ अंधार इक ज्योति से यक्कुल प्रिय सम्सदुर यतिकी आंदुर क्याल्सा बुरा ईरव. <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />यतिकी जो यावारा बुराई माळतान, आव ज्योति से दुश्मनी ईटतान, अदिक ज्योति इन हात्‍ती बरालुन, हिंग आगबाळुल कि आऊन क्याल्सागोळ मा दोष हचकु आगुल. <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />लेकीन आव जो सच्चाई मा नळुतान, अदिक ज्योति इन हात्‍ती बरतान, यदुर देल ईद प्रगट आगेगुल कि आऊन क्याल्सा परमेश्वर उन दी टु माळकु आग्याव.”<verse eid="JHN 3:21" /></para>
  <para style="s">यीशु अदिक यूहन्ना</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />इदुर बाद्दा यीशु अदिक आऊन चेलागोळ यहूदिया द्याश दा बंदुर; अदिक यीशु अल आंदुर सांगुळ ईतकु बपतिस्मा कोळली कुरतुन. <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />यूहन्ना भी शालेम नगर इन हात्‍ती ऐनोन दा बपतिस्मा कोळतोगोन, यतिकी अल हापाळ नीर ईरोद, अदिक लॉकुर बंदकु बपतिस्मा ताकोम तोगोर. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" /><note caller="+" style="x"><char style="xo" closed="false">३:२४ </char><char style="xt" closed="false"><ref loc="MAT 14:3">मत्ती १४:३</ref>; <ref loc="MRK 6:17">मरकुस ६:१७</ref>; <ref loc="LUK 3:19">लूका ३:१९</ref>,<ref loc="LUK 3:20">२०</ref></char></note>यूहन्ना आ समय ताका बंदीगृह दा हाक्‍कु आगली ईरोन.<verse eid="JHN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />अल यूहन्ना अन्द चेलागोळ्द यावारा यहूदी इन सांगुळ शुद्धीकरण इन बारा दा वाद-विवाद आत. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />अदिक आंदुर यूहन्ना अन्द हात्‍ती बंदकु आऊन से अंदुर, “हे गुरु, जो मंळसा यरदन इन आप्पाटी नीन सांगुळ ईरोन, अदिक यार्द नी गवाही कोट्या; नोळ, आव बपतिस्मा कोळतान, अदिक सप्पा मुंदुर आऊन हात्‍ती बरतार.”<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />यूहन्ना उत्‍तर कोट्टुन, “यागासताका मंळसा अक स्वर्ग इन दी टु कोटकु आगाल, आगासताका आव येनु हासिल माळ सकालुन. <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" /><note caller="+" style="x"><char style="xo" closed="false">३:२८ </char><char style="xt" closed="false"><ref loc="JHN 1:20">यूहन्ना १:२०</ref></char></note>नीव रा खुद अच नान गवाह हुईर कि ना अंदीन, ‘ना मसीह आलच, लेकीन आऊन मुंद कळुकु आगीन.’ <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />यार्द मंळगीत आर, आवा मंळगार हुन; लेकीन मंळगार उन संगी जो निदुरकु आऊन केळतान, मंळगार उन शब्द केळकु हापाळ खुश आगतान: ईग नान ईद खुशी पुरा आग्याद. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />जरूरी आद कि आव धोड्डेव आगुल अदिक ना स्याणेव.<verse eid="JHN 3:30" /></para>
  <para style="s">स्वर्ग टु बरावाळा आव याव हुन</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />“जो म्याकुच टु बरतान आव सब से वळ्लेव आन; जो पृथ्वी टु बरतान आव पृथ्वी नव हुन, अदिक पृथ्वी इन मातगोळी हेळतान: जो स्वर्ग टु बरतान, आव सप्पा मुंदुर्द म्याकुच आन. <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />जो येनारा आव नोळ्यान अदिक केळ्यान, अदुर्दा गवाही कोळतान; अदिक याऊ आऊन गवाही ग्रहण माळालुन. <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />याव आऊन गवाही ग्रहण माळ कोंडुन आव ई मात मा छाप हच बुट्टुन कि परमेश्वर खरा आन. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />यतिकी यारी परमेश्वर कळ्यान, आव परमेश्वर उन मातगोळ अनतान; यतिकी आव आत्मा आळु आळुकु कोळालुन. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" /><note caller="+" style="x"><char style="xo" closed="false">३:३५ </char><char style="xt" closed="false"><ref loc="MAT 11:27">मत्ती ११:२७</ref>; <ref loc="LUK 10:22">लूका १०:२२</ref></char></note>आप्प पार से प्यार ईटतान, अदिक आव सप्पा वस्तुगोळ आऊन कय दा ईट बुटान. <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />जो पार मा विश्वास माळतान, अनन्त जीवन आऊन हुन; लेकीन जो पार उन मातगोळी मान्सालुन, आव जीवन इक नोळतीदिल, लेकीन परमेश्वर उन सिट्ट आऊन मा ईरतद.”<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">यीशु अदिक सामरी आर्त</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />फरीसीगोळ केळ्यार कि यीशु बपतिस्मा माळावाळा यूहन्ना से यक्कुल चेलागोळी बपतिस्मा कोळतान. <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />यीशु खुद यागलु ईला उलटा आऊन चेलागोळ बपतिस्मा कोळतोगोर. <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />याग यीशु अक पता नळुत कि फरीसीगोळ हिंग मातगोळी माळतार रा आव यहूदिया बिटकु गलील इक ओळेदुन, <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />अदिक आऊक सामरीया टु आगकु होगोद जरूरी ईरोद. <verse eid="JHN 4:4" /><verse number="5" style="v" sid="JHN 4:5" />इदुरसाटी आव सूखार हेसुर इन सामरीया अन्द ऊंद नगर ताका बंदुन, जो आ भूमी इन हात्‍ती आद यदरी याकूब तान पार यूसुफ उक कोटीदुन; <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />अदिक याकूब उन भाय भी अल्या ईरोद. इदुरसाटी यात्रा टु थक्स माळकु यीशु भाय इन हात्‍ती हिंग अच कुरतोदुन. आ समय लगभग हागुल इनव हन्नेळ मुरदिदव. <verse eid="JHN 4:6" /><verse number="7" style="v" sid="JHN 4:7" />इटुर दा ऊंद सामरी जाती नोर आर्त नीर तुमली बंदुर. यीशु आकिन से अंदुन, “नानी नीर कुळ्स.” <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />यतिकी आऊन चेलागोळ रा नगर दा भोजन कोम्मोर साटी होगीदुर. <verse eid="JHN 4:8" /><verse number="9" style="v" sid="JHN 4:9" />आ सामरी जात इन आर्त आऊन से अंदुर, “नी यहूदी ईतकु ना सामरी जाती नोर आर्त इन से नीर येती बेळत्या?” यतिकी यहूदी सामरी जात इन लॉकुर सांगुळ यातोदु प्रकार इन व्यवहार ईटालुर. <verse eid="JHN 4:9" /><verse number="10" style="v" sid="JHN 4:10" />यीशु उत्‍तर कोट्टुन, “अगर नी परमेश्वर उन वरदान इक जानसाईद, अदिक ईद भी जानसाईद कि आव याव हुन जो नीन से अनतान, ‘नानी नीर कुळ्स,’ रा नी आऊन से बेळाईद, अदिक आव नीनी जीवन इन नीर कोळायदुन.” <verse eid="JHN 4:10" /><verse number="11" style="v" sid="JHN 4:11" />आर्त आऊन से अंदुर, “हे प्रभु, नीन हात्‍ती नीर तुमली रा बाल्टी भी हैलेच, अदिक भाय खोल आद; रा बाक अद जीवन इन नीर नीन हात्‍ती यल टु बत्‍त? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />येन नी नाम आप्प याकूब से धोड्डेव आय, याव नामी ईद भाय कोट्टुन; अदिक खुद अच तान औलाद, अदिक तान जनावरगोळ सांगुळ इदुर दा टु नीर कुळदुन?” <verse eid="JHN 4:12" /><verse number="13" style="v" sid="JHN 4:13" />यीशु आक इक उत्‍तर कोट्टुन, “जो यावारा ईद नीर कुळदान आव मात्‍त प्यासा ईत्‍तान, <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />लेकीन जो यावारा आ नीर इक कुळदान जो ना आऊक कोळाईन, आव बाक अनन्त काल ताका प्यासा आगतीदील; लेकीन जो नीर ना आऊक कोळाईन, अद आऊन दा ऊंद झरना बनसेदित जो अनन्त जीवन इन साटी उमळुसतेला ईत्‍तीत.” <verse eid="JHN 4:14" /><verse number="15" style="v" sid="JHN 4:15" />आर्त आऊन से अंदुर, “हे प्रभु, अद नीर नानी कोळ ताकी ना प्यासा आगबाळुल अदिक ना नीर तुमली ईट दुर बराईन.” <verse eid="JHN 4:15" /><verse number="16" style="v" sid="JHN 4:16" />यीशु आकिन से अंदुन, “होग, तान गांड्ड उक ईल कारूकु तर.” <verse eid="JHN 4:16" /><verse number="17" style="v" sid="JHN 4:17" />आर्त उत्‍तर कोट्टुर, “ना बिना गांड्ड उन आईन.” यीशु आकिन से अंदुन, “नी ठीक अनत्या, ‘ना बिना गांड्ड उन आईन.’ <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />यतिकी नी अईद गांडुरी माळ कोंड्या, अदिक यार हात्‍ती नी ईग आय आव भी नीन गांड्ड आल्लच. ईद नी सही अच अनत्या.” <verse eid="JHN 4:18" /><verse number="19" style="v" sid="JHN 4:19" />आर्त आऊन से अंदुर, “हे प्रभु, नानी हततद कि नी भविष्यवक्ता हुय. <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />नाम आप्प दादागोळ ईदा पहाळी मा आराधना माळदुर, अदिक नीव अनतीर कि अद जागा यल आराधना माळ पायजे यरूशलेम दा आद.” <verse eid="JHN 4:20" /><verse number="21" style="v" sid="JHN 4:21" />यीशु आकिन से अंदुन, “हे आर्त, नान मात इन विश्वास माळ कि अद समय बरतद कि नीव ना रा ईद पहाळी मा आप्प उन आराधना माळीर, ना यरूशलेम दा. <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />नीव यारी जान्सालीर, आऊन आराधना माळतीर; अदिक नाव यारी जान्सतेव आऊन आराधना माळतेव; यतिकी उद्धार यहूदीगोळ दा टु आद. <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />लेकीन अद समय बरतद, लेकीन ईग भी आद, यारदा खरा भक्त आप्प उन आराधना आत्मा अदिक सच्चाई देल माळेव, यतिकी आप्प तान साटी हिंग अच आराधकगोळी ढुंढ्सतान. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />परमेश्वर आत्मा आन, अदिक जरूरी आद कि आऊन आराधना माळावाळेर आत्मा अदिक सच्चाई देल आराधना माळुल.” <verse eid="JHN 4:24" /><verse number="25" style="v" sid="JHN 4:25" />आर्त आऊन से अंदुर, “ना जान्सतीन कि मसीह जो ख्रिस्त कहलुस्तान, बरावाळा आन; याग आव बंदान, रा नामी सप्पा मातगोळी हेळ बुट्टान.” <verse eid="JHN 4:25" /><verse number="26" style="v" sid="JHN 4:26" />यीशु आकिन से अंदुन, “ना जो नीन से अनेतीन, आवा हुईन.”<verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />इटुर दा यीशु उन चेलागोळ होट्ट बंदुर, अदिक अचम्भा माळली कुरतुर कि आव आर्त से मातगोळी हेळेत्यान; तरी याऊ केळीदील, “नी येन चाहासत्या?” या “यदुर साटी आकिन से मातगोळी हेळत्या?” <verse eid="JHN 4:27" /><verse number="28" style="v" sid="JHN 4:28" />आग आर्त तान घागरी बिटकु नगर दा वोळेदुर, अदिक लॉकुर से अनली कुरतुर, <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />“बरी, ऊंद मंळसा अक नोळी, याव सप्पा येनारा जो ना माळीन नानी हेळ बुटुन. येनारा ईवा रा मसीह आल्लच?” <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />इदुरसाटी लॉकुर नगर टु होटकु आऊन हात्‍ती बरली कुरतुर. <verse eid="JHN 4:30" /><verse number="31" style="v" sid="JHN 4:31" />ईदुर बीच दा आऊन चेलागोळ यीशु से ईद विनती माळदुर, “हे गुरु, येनारा तिन कोम.” <verse eid="JHN 4:31" /><verse number="32" style="v" sid="JHN 4:32" />लेकीन आव आंदुर से अंदुन, “नान हात्‍ती तिनोर साटी हिंग भोजन आद यदरी नीव जान्सालीर.” <verse eid="JHN 4:32" /><verse number="33" style="v" sid="JHN 4:33" />आग चेलागोळ आपस दा अंदुर, “येन यावारा आऊन साटी येनारा तिनली तंदान?” <verse eid="JHN 4:33" /><verse number="34" style="v" sid="JHN 4:34" />यीशु आंदुर से अंदुन, “नान भोजन ईद आद कि तान कळावाळा अन्द इच्छा अन अनुसार नळाईन अदिक आऊन क्याल्सा पुरा माळाईन. <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />येन नीव अनालीर, ‘कटनी आगदुर दा ईग भी नाक तिंगुळ बाकी आव?’ नोळी, ना नीम से अनतीन, तान कण्णगोळी नेगुकु केयगोळ मा नजर हाक्‍की कि अव कटाई इन साटी फसल पकसेग्याद. <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />फसल कडावाळा अक मजदूरी सिकतद अदिक अनन्त जीवन इन साटी काय जमा माळतान, ताकी हचावाळा अदिक कडावाळा येढ्ढु मुंदुर मिलुसकु आनन्द माळुल. <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />यतिकी ईल ईद कहावत सही कुरतद: ‘फसल हचावाळा दुसरा आन अदिक कडावाळा दुसरा.’ <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />ना नीमी अद केई कडोर साटी कळुदीन यदुर्दा नीव मेहनत माळीदील: दुसरागोळ मेहनत माळदुर अदिक नीव आंदुर्द मेहनत इन फल दा हिस्सेदार आदीर.”<verse eid="JHN 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />आ नगर इन हापाळ सा सामरी लॉकुर आ आर्त इन अंदुर देल यीशु मा विश्वास माळदुर; यतिकी आक ईद गवाही कोटीदुर: आव सप्पा येनारा जो ना माळदीन, नानी हेळ बुटुन. <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />इदुरसाटी याग ई सामरी लॉकुर आऊन हात्‍ती बंदुर, रा आऊन से विनती माळली कुरतुर कि नाम ईल ईर. इदुरसाटी आव अल येढ्ढ दिन ताका ईत्‍तुन. <verse eid="JHN 4:40" /><verse number="41" style="v" sid="JHN 4:41" />आऊन वचन इन कारण अदिक भी हापाळ सा लॉकुर विश्वास माळदुर <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />अदिक आ आर्त से अंदुर, “ईग नाव नीन अंदुर देल अच विश्वास माळालेव; यतिकी नाव खुद अच केळ कोंडेव, अदिक जान्सतेव कि ईवा सही दा दुनिया अन उद्धारकर्ता हुन.”<verse eid="JHN 4:42" /></para>
  <para style="s">यीशु अधिकारी अन पार उक चंगा माळदुन</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />बाक आ येढ्ढ दिनगोळ बाद्दा यीशु अल टु होटकु गलील इक होदुन, <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" /><note caller="+" style="x"><char style="xo" closed="false">४:४४ </char><char style="xt" closed="false"><ref loc="MAT 13:57">मत्ती १३:५७</ref>; <ref loc="MRK 6:4">मरकुस ६:४</ref>; <ref loc="LUK 4:24">लूका ४:२४</ref></char></note>यतिकी यीशु खुद अच गवाही कोट्टुन कि भविष्यवक्ता अन्द तान द्याश दा आदर आगाल्द. <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" /><note caller="+" style="x"><char style="xo" closed="false">४:४५ </char><char style="xt" closed="false"><ref loc="JHN 2:23">यूहन्ना २:२३</ref></char></note>याग आव गलील दा बंदुन, रा गलीली लॉकुर खुशी देल आऊन सांगुळ मिलुसदुर; यतिकी यास क्याल्सा आव यरूशलेम दा हाब्ब इन समय माळीदुन, आंदुर आ सप्पा अक नोळीदुर, यतिकी आंदुर भी हाब्ब दा होगीदुर.<verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:४६ </char>
      <char style="xt" closed="false">
        <ref loc="JHN 2:1-11">यूहन्ना २:१-११</ref>
      </char>
    </note>आग यीशु बाक गलील इन काना नगर दा बंदुन, यल आव नीर इक अंगुर इन रास्सा माळीदुन. अल राजा अन ऊंद कर्मचारी ईरोन यार पार कफरनहूम नगर दा बिमार ईरोन. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />आव ईद केळकु कि यीशु यहूदिया टु गलील दा होट बंदान, आऊन हात्‍ती होदुन अदिक आऊन से ईद विनती माळली कुरतुन कि नळुकु नान पार उक चंगा माळुल: यतिकी आव सोत्‍तुर मा ईरोन. <verse eid="JHN 4:47" /><verse number="48" style="v" sid="JHN 4:48" />यीशु आऊन से अंदुन, “यागासताका नीव चमत्कार अदिक अदभुत क्याल्सा नोळालीर आगासताका यागलु विश्वास माळतीदील.” <verse eid="JHN 4:48" /><verse number="49" style="v" sid="JHN 4:49" />राजा अन कर्मचारी आऊन से अंदुन, “हे प्रभु, नान पार उन सायोर से पयले नळ.” <verse eid="JHN 4:49" /><verse number="50" style="v" sid="JHN 4:50" />यीशु आऊन से अंदुन, “होग, नीन पार जित्‍ता आन.” आ मंळसा यीशु उन अंद मात इन भरोसा माळदुन अदिक ओळेदुन. <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />आव हादी मा का ईरोन कि आऊन दास आऊन से बंदकु सिकदुर अदिक अनली कुरतुर, “नीन पार जित्‍ता आन.” <verse eid="JHN 4:51" /><verse number="52" style="v" sid="JHN 4:52" />आव आंदुर से केळदुन, “याता घळी आव वळ्लेव आगली कुरतुन?” आंदुर आऊन से अंदुर, “नाळ सातवा तास दा आऊन मय ईळदव.” <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />आग आप्प जान्स कोंडुन कि ईद अदा घळी आत याता घळी यीशु आऊन से अंदुन, “नीन पार जित्‍ता आन,” अदिक आव अदिक आऊन सप्पा परिवार विश्वास माळदुर. <verse eid="JHN 4:53" /><verse number="54" style="v" sid="JHN 4:54" />ईद दुसरा आश्चर्यकर्म ईरोद जो यीशु यहूदिया टु गलील दा बंदकु तोर्सदुन.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">अळतीस वर्ष इन रोगी अक चंगा माळोद</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />ई मातगोळ बाद्दा यहूदीगोळ्द ऊंद हाब्ब आत, अदिक यीशु यरूशलेम इक होदुन. <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />यरूशलेम दा भेंट-फाटक इन हात्‍ती ऊंद कुण्ड आद जो इब्रानी भाषा बैतसैदा कहलुसतद; अदुर अईद छपर्या आव. <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />इऊर दा हापाळ सा बिमार, कुढ्ढ, लंगळा अदिक लकवा अन रोगी लॉकुर बिदकु ईरतोगोर. <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />यतिकी निवळुस्द समय मा परमेश्वर उन स्वर्गदूत कुण्ड दा ईळुकु नीर इक हालुसतोगोर. नीर हालुसतेला अच जो यावारा पयले ईळुतोगोन आव चंगा आगेग तोगोन बाक आऊक यातोदारा बिमारी येती आगबाळुल. <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />अल ऊंद मंळसा ईरोन, जो अळतीस वर्ष टु बिमारी देल बिदकु ईरोन. <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />यीशु आऊक बिदकु नोळकु अदिक ईद जान्सकु कि आव हापाळ दिन टु ई दशा दा बिदकु आन, आऊन से केळदुन, “येन नी चंगा आगोद चाहासत्या?” <verse eid="JHN 5:6" /><verse number="7" style="v" sid="JHN 5:7" />आ बिमार मंळसा आऊक उत्‍तर कोट्टुन, “हे प्रभु, नान हात्‍ती याऊ मंळसा हैलेच कि जो नीर हालुस्कु आगुल, रा नानी कुण्ड दा ईळस्यान; लेकीन नान पोहचुस ताका यावारा दुसरा नान से पयले ईळदोगतान.” <verse eid="JHN 5:7" /><verse number="8" style="v" sid="JHN 5:8" />यीशु आऊन से अंदुन, “येळ, तान व्हर्स नेगु, नळु अदिक वयाळ.” <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />आव मंळसा तुरन्त चंगा आगेदुन, अदिक तान व्हर्स नेगुकु नळुली कुरतुन.<verse eid="JHN 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 5:10" />अद आराम इन दिन ईरोद. इदुरसाटी यहूदी आऊन से जो चंगा आगीदुन, अनली कुरतुर, “ईंद रा आराम इन दिन आद, नीनी व्हर्स नेगोद उचित हैलेच.” <verse eid="JHN 5:10" /><verse number="11" style="v" sid="JHN 5:11" />आव आंदरी उत्‍तर कोट्टुन, “याव नानी चंगा माळदुन, आवा नान से अंदुन, ‘तान व्हर्स नेगु, नळु अदिक वयाळ.’” <verse eid="JHN 5:11" /><verse number="12" style="v" sid="JHN 5:12" />आंदुर आऊन से केळदुर, “आव याव मंळसा हुन याव नीन से अंदुन, ‘व्हर्स नेगु, नळु अदिक वयाळ.’” <verse eid="JHN 5:12" /><verse number="13" style="v" sid="JHN 5:13" />लेकीन जो चंगा आगेगिदुन आव ईला जानसोन कि आव याव हुन, यतिकी आ जागा दा भीळ इन कारण यीशु अल टु हटसेगिदुन. <verse eid="JHN 5:13" /><verse number="14" style="v" sid="JHN 5:14" />ई मातगोळ बाद्दा आव यीशु अक मंदिर दा सिकदुन. यीशु आऊन से अंदुन, “नोळ, नी चंगा आगेग्या: मात्‍त पाप माळबाळेत, हिंग आगबाळुल कि इदुर देल यातोदारा भारी परेशानी नीन मा बंदकु बिळुल.” <verse eid="JHN 5:14" /><verse number="15" style="v" sid="JHN 5:15" />आ मंळसा होगकु यहूदी लॉकुर से अंद बुटुन कि याव नानी चंगा माळदुन आव यीशु हुन. <verse eid="JHN 5:15" /><verse number="16" style="v" sid="JHN 5:16" />ईद कारण यहूदी यीशु अक सतुस्ली कुरतुर, यतिकी आव ईत्‍ता क्याल्सा आराम इन दिशी माळतोगोन. <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />इदुर मा यीशु आंदुर से अंदुन, “नान आप्प ईगासताका क्याल्सा माळतान, अदिक ना भी क्याल्सा माळतीन.” <verse eid="JHN 5:17" /><verse number="18" style="v" sid="JHN 5:18" />ईद कारण यहूदी अदिक भी यक्कुल आऊक कोंद बुळोद कोशिश माळली कुरतुर, यतिकी आव ना सिर्फ आराम इन दिन इन विधी अक मुरोन, लेकीन परमेश्वर उक तान आप्प अंदकु तान तान इक परमेश्वर उन घाई भी ठहरूसतोगोन.<verse eid="JHN 5:18" /></para>
  <para style="s">पार उन अधिकार</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />इदुर मा यीशु आंदुर से अंदुन, “ना नीम से खरा खरा अनतीन, पार खुद देल येनु माळ सकालुन, सिर्फ आव जो आप्प उक माळ्त नोळतान; यतिकी याता याता क्याल्सागोळी आव माळतान अवरी पार भी अदा रीति देल माळतान. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />यतिकी आप्प पार उन से प्यार ईटतान अदिक जो जो क्याल्सा आव खुद माळतान, आव सप्पा आऊक तोर्सतान; अदिक आव इऊर से भी धोड्डेव क्याल्सा आऊक तोर्सतान, ताकी नीव अचम्भा माळीर. <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />ह्यांग आप्प सोत्‍तुरी नेगुतान अदिक जित्‍ता माळतान, हांग अच पार भी यारी चाहासतान आंदरी जित्‍ता माळतान. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />आप्प यारदु न्याय माळालुन, लेकीन न्याय माळोद सप्पा क्याल्सा पार उक कोट्ट बुटुन, <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />कि सप्पा लॉकुर ह्यांग आप्प उन आदर माळतार हांग अच पार उन भी आदर माळुल. जो पार आदर माळालुन, आव आप्प उन यारी आव कळ्यान, आदर माळालुन. <verse eid="JHN 5:23" /><verse number="24" style="v" sid="JHN 5:24" />ना नीम से खरा खरा अनतीन, जो नान वचन केळकु नान कळावाळा मा विश्वास माळतान, अनन्त जीवन आऊंद हुन; अदिक आऊन मा दण्ड इन आग्या आगाल्द लेकीन आव मृत्यु टु आप्पाटी आगकु जीवन दा प्रवेश माळ कोंडान.<verse eid="JHN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 5:25" />“ना नीम से खरा खरा अनतीन अद समय बरतद, अदिक ईग आद, यारदा सायावाळेर परमेश्वर उन पार उन आवाज केळ्यार, अदिक जो केळ्यार आंदुर जित्‍ता ईत्‍तार. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />यतिकी याता रीति देल आप्प तान तान दा जीवन ईटतान, अदा रीति देल आव पार उक भी ईद अधिकार कोटान कि तान तान दा जीवन ईटुल; <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />लेकीन आऊक न्याय माळोद भी अधिकार कोटान, इदुरसाटी कि आव मंळसा अन पार हुन. <verse eid="JHN 5:27" /><verse number="28" style="v" sid="JHN 5:28" />इदुर देल अचम्भा माळबाळी; यतिकी अद समय बरतद कि यास कब्रगोळ दा आर आंदुर आऊन आवाज केळकु व्हार्या होटकु बंदार. <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />यार वळ्लीद माळ्यार आंदुर जीवन इन पुनरूत्थान इन साटी जित्‍ता आदार अदिक यार बुराई माळ्यार आंदुर दण्ड इन पुनरूत्थान इन साटी जित्‍ता आदार.<verse eid="JHN 5:29" /></para>
  <para style="s">यीशु अन बारा दा गवाही</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30" />“ना तान तान देल येनु माळ सकालीन; ह्यांग केळतीन, हांगा न्याय माळतीन; अदिक नान न्याय खरा आद, यतिकी ना तान इच्छा देल ईला लेकीन तान कळावाळा अन्द इच्छा चाहासतीन. <verse eid="JHN 5:30" /><verse number="31" style="v" sid="JHN 5:31" />अगर ना खुद अच तान गवाही कोळाईन, रा नान गवाही खरा हैलेच. <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />दुसरा अदिक आन जो नान गवाही कोळतान, अदिक ना जान्सतीन कि नान जो गवाही आव कोळतान, अद खरा आद. <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" /><note caller="+" style="x"><char style="xo" closed="false">५:३३ </char><char style="xt" closed="false"><ref loc="JHN 1:19-27">यूहन्ना १:१९-२७</ref>; <ref loc="JHN 3:27-30">३:२७-३०</ref></char></note>नीव यूहन्ना से केळसुसदीर अदिक आव सच्चाई इन गवाही कोट्टुन. <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />लेकीन ना तान बारा दा मंळसा अन गवाही चाहासालीन; तरी ना ई मातगोळी इदुरसाटी अनतीन कि नीमी उद्धार सिक्‍कुल. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />आव रा होत्‍ततेला अदिक चमकुसतेला दिंग्या ईरोन, अदिक नीमी येनारा समय ताका आऊन ज्योति दा मग्न आगोद वळ्लीद हत. <verse eid="JHN 5:35" /><verse number="36" style="v" sid="JHN 5:36" />लेकीन नान हात्‍ती जो गवाही आद अद यूहन्ना अन गवाही देल धोळ्द आद; यतिकी जो क्याल्सा आप्प नानी पुरा माळोर साटी कोटान मतलब ईदा क्याल्सा जो ना माळतीन, अव नान गवाह आव कि आप्प नानी कळ्यान. <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" /><note caller="+" style="x"><char style="xo" closed="false">५:३७ </char><char style="xt" closed="false"><ref loc="MAT 3:17">मत्ती ३:१७</ref>; <ref loc="MRK 1:11">मरकुस १:११</ref>; <ref loc="LUK 3:22">लूका ३:२२</ref></char></note>अदिक आप्प याव नानी कळ्यान, आवा नान गवाही कोटान. नीव ना यागल्यारा आऊंद आवाज केळदीर, अदिक ना आऊंद रूप नोळदीर; <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />अदिक आऊन वचन इक मन दा जमा ईटालीर, यतिकी आव यारी कळ्यान नीव आऊंद विश्वास माळालीर. <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />नीव पवित्रशास्त्र दा ढुंढ्सतीर, यतिकी सम्सतीर कि अदुर्दा अनन्त जीवन नीमी सिकतद; अदिक ईव आवा हुन जो नान गवाही कोळतान; <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />तरी भी नीव जीवन साटी नान हात्‍ती बरोद चाहासालीर. <verse eid="JHN 5:40" /><verse number="41" style="v" sid="JHN 5:41" />ना मंळसागोळ से आदर चाहासालीन. <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />लेकीन ना नीमी जान्सतीन कि नीम दा परमेश्वर उन प्यार हैलेच. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />ना तान आप्प उन हेसुर देल बंदीन, अदिक नीव नानी ग्रहण माळालीर; अगर दुसरा यावारा तांद अच हेसुर देल बंदान, रा आऊक ग्रहण माळ कोंडीर. <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />नीव जो आबुर दाबुर से आदर चाहासतीर अदिक अद आदर जो ऊंद मात्र परमेश्वर उन दी टु आद, चाहासालीर, याता प्रकार विश्वास माळ सकतीर? <verse eid="JHN 5:44" /><verse number="45" style="v" sid="JHN 5:45" />ईद सम्सबाळी कि ना आप्प उन मुंद नीम मा दोष हचाईन; नीम मा दोष हचावाळा रा मूसा हुन, यार मा नीव भरोसा ईटीर. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />यतिकी अगर नीव मूसा अन विश्वास माळायदीर, रा नान भी विश्वास माळायदीर, इदुरसाटी कि आव नान बारा दा लिखस्यान. <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />लेकीन अगर नीव आऊन लिख्सद मातगोळ मा विश्वास माळालीर, रा नान मातगोळ मा ह्यांग विश्वास माळीर?”<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">अईद हजार मंळसागोळी तिनसोद</para>
  <para style="r">(<ref loc="MAT 14:13-21">मत्ती १४:१३-२१</ref>; <ref loc="MRK 6:30-44">मरकुस ६:३०-४४</ref>; <ref loc="LUK 9:10-17">लूका ९:१०-१७</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />ई मातगोळ्द बाद्दा यीशु गलील इन झील<note caller="+" style="f"><char style="fr" closed="false">६:१ </char><char style="ft" closed="false">झील इन मतलब धोळ क्यार्रा हुन</char></note> मतलब तिबिरियास इन झील इन आप्पाटी होदुन. <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />अदिक ऊंद धोळ्द भीळ आऊन हिंद आगेत यतिकी जो आश्चर्यकर्म आव बिमारगोळ मा तोर्सतोगोन आंदुर अवरी नोळतोगोर. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />आग यीशु पहाळी मा येरकु तान चेलागोळ सांगुळ अल कुरतोदुन. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />यहूदीगोळ्द फसह अन हाब्ब हात्‍ती ईरोद. <verse eid="JHN 6:4" /><verse number="5" style="v" sid="JHN 6:5" />याग यीशु तान कण्णगोळी नेगुकु ऊंद धोळ्द भीळ इक तान हात्‍ती बर्त नोळदुन, रा फिलिप्पुस से अंदुन, “नाव इंदुर भोजन इन साटी यल टु रोट्टी कोंडकु तंदेव?” <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />आव ईद मात आऊक परखुसोर साटी अंदुन, यतिकी आव खुद जानसोन कि आव येन माळ्यान. <verse eid="JHN 6:6" /><verse number="7" style="v" sid="JHN 6:7" />फिलिप्पुस आऊक उत्‍तर कोट्टुन, “येढ्ढ सौ दीनार इन रोट्टी भी आंदुर साटी पुरा आगतीदील कि आंदुर दा टु हर ऊंद इक थ्वाळा-थ्वाळा सिक्‍केगुल.” <verse eid="JHN 6:7" /><verse number="8" style="v" sid="JHN 6:8" />आऊन चेलागोळ दा टु शमौन पतरस उन वार्ट अन्द्रियास आऊन से अंदुन, <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />“ईल ऊंद पार आन यार हात्‍ती जवारी इन अईद रोट्टी अदिक येढ्ढ मेनगोळ आव; लेकीन ईस लॉकुर साटी अव येन आव?” <verse eid="JHN 6:9" /><verse number="10" style="v" sid="JHN 6:10" />यीशु अंदुन, “लॉकुरी कुर्स बुळी.” आ जागा दा हापाळ काड्डा ईरोद: आग लॉकुर यारदा गंळ्सुर्द संख्या लगभग अईद हजार इन ईरोद, कुरतोदुर. <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />आग यीशु रोट्टीगोळी हुळदुन, अदिक धन्यवाद माळकु कुरावाळेर इक वाट्स बुटुन; अदिक हांग अच मेनगोळ दा टु यास आंदुर चाहासोर वाट्स बुटुन. <verse eid="JHN 6:11" /><verse number="12" style="v" sid="JHN 6:12" />याग आंदुर तिनकु संतुष्ट आगेदुर रा आव तान चेलागोळ से अंदुन, “मिक्‍कु तुकळागोळी जमा माळबुळी कि येनु भिटकु आगबाळुल.” <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />इदुरसाटी आंदुर जमा माळदुर, अदिक जवारी इन अईद रोट्टीगोळ तुकळागोळ से जो तिनावाळेर ऊळोर, हन्नेळ फुट्टी तुमदव. <verse eid="JHN 6:13" /><verse number="14" style="v" sid="JHN 6:14" />आग जो आश्चर्यकर्म आव माळकु तोर्सदुन अदरी आ लॉकुर नोळकु अनली कुरतुर, “आव भविष्यवक्ता जो दुनिया दा बरावाळा ईरोन निश्चय ईवा हुन.” <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />यीशु ईद जान्सकु कि आंदुर नानी राजा माळोर साटी हुडोद चाहासतार, बाक पहाळी मा आबना ओळेदुन.<verse eid="JHN 6:15" /></para>
  <para style="s">यीशु उन नीर मा नळोद</para>
  <para style="r">(<ref loc="MAT 14:22-33">मत्ती १४:२२-३३</ref>; <ref loc="MRK 6:45-52">मरकुस ६:४५-५२</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />याग द्याव मुळ्कत, रा यीशु उन चेलागोळ झील इन किनारा मा होदुर, <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />अदिक ड्वांगा मा येरकु झील इन आप्पाटी कफरनहूम इक होगली कुरतुर. आ समय अंधार आगेगीत, अदिक यीशु ईगासताका आंदुर हात्‍ती ईला बंदीदुन. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />आँधी अन कारण झील दा लयरगोळ येळली कुरतव. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />याग आंदुर केई केई अईद-आर कोस इन लगभग होटोदुर, रा आंदुर यीशु उक झील मा नळुत अदिक ड्वांगा अन हात्‍ती बर्त नोळदुर, अदिक अंजेदुर. <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />लेकीन आव आंदुर से अंदुन, “ना हुईन; अंजबाळी.” <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />इदुरसाटी आंदुर आऊक ड्वांगा मा येरसोर साटी तयार आदुर अदिक तुरन्त अद ड्वांगा आ जागा मा पोहचुसेत यल आंदुर होगोर.<verse eid="JHN 6:21" /></para>
  <para style="s">लॉकुर्द यीशु उक ढुंढसोद</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />दुसरा दिशी आ भीळ, जो झील इन आप्पाटी निदुरकु ईरोद, ईद नोळदुर कि ईल ऊंद इक बिटकु अदिक यातोदु ड्वांगा ईला ईरोद; अदिक यीशु तान चेलागोळ सांगुळ आ ड्वांगा मा ईला येरीदुन, लेकीन सिर्फ आऊन चेलागोळ अच होगीदुर. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />आग हापाळ ड्वांगागोळ तिबिरियास टु आ जागा अन हात्‍ती बंदव, यल आंदुर प्रभु उक धन्यवाद माळदुर बाद्दा रोट्टी तिंदीदुर. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />इदुरसाटी याग भीळ नोळ्त कि ईल ना यीशु आन अदिक ना आऊन चेलागोळ, रा आंदुर भी ड्वांगागोळ मा येरकु यीशु उक ढुंढ्सतेला कफरनहूम पोहचुसदुर.<verse eid="JHN 6:24" /></para>
  <para style="s">यीशु जीवन इन रोट्टी</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />झील इन आप्पाटी याग लॉकुर्द भीळ यीशु से सिकदुर रा अंदुर, “हे गुरु, नी ईल याग बंद?” <verse eid="JHN 6:25" /><verse number="26" style="v" sid="JHN 6:26" />यीशु आंदरी उत्‍तर कोट्टुन, “ना नीम से खरा खरा अनतीन, नीव नानी इदुरसाटी ढुंढसालीर कि नीव आश्चर्यकर्म नोळदीर, लेकीन इदुरसाटी कि नीव रोट्टीगोळी तिनकु संतुष्ट आदीर. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />नाशवान भोजन इन साटी मेहनत माळबाळी, लेकीन आ भोजन इन साटी जो अनन्त जीवन ताका ठहरूसतद, यारी मंळसा अन पार नीमी कोट्टान; यतिकी आप्प मतलब परमेश्वर अदुर मा छाप हच्यान.” <verse eid="JHN 6:27" /><verse number="28" style="v" sid="JHN 6:28" />आंदुर आऊन से अंदुर, “परमेश्वर उन क्याल्सा माळोर साटी नाव येन माळेव?” <verse eid="JHN 6:28" /><verse number="29" style="v" sid="JHN 6:29" />यीशु आंदरी उत्‍तर कोट्टुन, “परमेश्वर उन क्याल्सा ईद आद कि नीव आऊन मा विश्वास माळी, यारी आव कळ्यान.” <verse eid="JHN 6:29" /><verse number="30" style="v" sid="JHN 6:30" />आग आंदुर आऊन से अंदुर, “बाक नी यातोद चमत्कार तोर्सत्या कि नाव अदरी नोळकु नीन विश्वास माळेव? नी यातोद क्याल्सा तोर्सत्या?” <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />नाम आप्प दादागोळ आळी दा मन्ना तिंदुर; ह्यांग लिख्सकु आद, “आव आंदरी तिनोर साटी स्वर्ग टु रोट्टी कोट्टुन.” <verse eid="JHN 6:31" /><verse number="32" style="v" sid="JHN 6:32" />यीशु आंदुर से अंदुन, “ना नीम से खरा खरा अनतीन कि मूसा नीमी अद रोट्टी स्वर्ग टु कोटीदील, लेकीन नान आप्प नीमी खरा रोट्टी स्वर्ग टु कोळतान. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />यतिकी परमेश्वर उन रोट्टी अदा हुन जो स्वर्ग टु ईळुकु दुनिया अक जीवन कोळतद.” <verse eid="JHN 6:33" /><verse number="34" style="v" sid="JHN 6:34" />आग आंदुर आऊन से अंदुर, “हे प्रभु, ईद रोट्टी नामी हमेशा कोळतेला ईर.”<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />यीशु आंदुर से अंदुन, “जीवन इन रोट्टी ना हुईन: जो नान हात्‍ती बरतान आव यागलु उपासा ईरतीदील, अदिक जो नान मा विश्वास माळतान आव यागलु प्यासा ईरतीदील. <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />लेकीन ना नीम से अंदिदीन कि नीव नानी नोळ भी कोंडीर तरी विश्वास माळालीर. <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />जो येनारा आप्प नानी कोळतान अद सप्पा नान हात्‍ती बंदीत, अदिक जो यावारा नान हात्‍ती बंदान आऊक ना यागलु तेगुतिदील. <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />यतिकी ना तान इच्छा ईला लेकीन तान कळावाळा अन्द इच्छा पुरा माळोर साटी स्वर्ग टु ईळदीन; <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />अदिक नान कळावाळा अन इच्छा ईद आद कि जो येनारा आव नानी कोटान, अदुर दा टु ना येनारा खोऊसालीन, लेकीन आऊक आखरी दिशी बाक जित्‍ता माळाईन. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />यतिकी नान आप्प उन इच्छा ईद आद कि जो यावारा पार उक नोळुल अदिक आऊन मा विश्वास माळुल, आऊक अनन्त जीवन सिक्‍कीत; अदिक ना आऊक आखरी दिशी बाक जित्‍ता माळाईन.” <verse eid="JHN 6:40" /><verse number="41" style="v" sid="JHN 6:41" />“इदुरसाटी यहूदी लॉकुर आऊन मा कुळकुळ्सली हतदुर, यतिकी आव अंदिदुन, जो रोट्टी स्वर्ग टु ईळुत, अद ना हुईन.” <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />अदिक आंदुर अंदुर, “येन ईव यूसुफ उन पार यीशु आल्लच, यार मोय-आप्प उक नाव अरूतेव? रा आव ह्यांग अनतान कि ना स्वर्ग टु ईळदीन?” <verse eid="JHN 6:42" /><verse number="43" style="v" sid="JHN 6:43" />यीशु आंदरी उत्‍तर कोट्टुन, आपस दा कुळकुळुसबाळी. <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />याऊ नान हात्‍ती बर सकालुन यागासताका आप्प, याव नानी कळ्यान, आऊक जेडु कोमालुन; अदिक ना आऊक आखरी दिशी बाक जित्‍ता माळाईन. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />भविष्यवक्तागोळ्द लेखगोळ दा ईद लिख्सकु आद: “<note caller="+" style="f"><char style="fr" closed="false">६:४५ </char><char style="ft" closed="false">यशायाह ५४:१३ </char></note>आंदुर सप्पा परमेश्वर उन दी टु कल्सकु ईत्‍तार.” जो यावारा आप्प से केळ्यान अदिक कलतान, आव नान हात्‍ती बरतान. <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />ईद ईला कि यावारा आप्प उक नोळ्यान; लेकीन जो परमेश्वर उन दी टु आन, सिर्फ आवा आप्प उक नोळ्यान. <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />“ना नीम से खरा खरा अनतीन कि जो यावारा विश्वास माळतान, अनन्त जीवन आऊंदा हुन. <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />जीवन इन रोट्टी ना हुईन. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />नीम आप्प दादागोळ आळी दा मन्ना तिंदुर लेकीन आंदुर सोतोदुर. <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />लेकीन ईद अद रोट्टी हुन जो स्वर्ग टु ईळुतद ताकी मंळसा अदरी तिनुल अदिक सायबाळुल. <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />जीवन इन रोट्टी जो स्वर्ग टु ईळुत, ना हुईन. अगर यावारा ईद रोट्टी दा टु तिंदान, रा सदा जित्‍ता ईत्‍तान; अदिक जो रोट्टी ना दुनिया अक जित्‍ता ईरोरसाटी कोळाईन, अद नान मय हुन.”<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />इदुर मा यहूदी ईद अनकु आपस दा झगळा माळली कुरतुर, “ईव मंळसा ह्यांग नामी तान मय तिनली कोळ सकतान?” <verse eid="JHN 6:52" /><verse number="53" style="v" sid="JHN 6:53" />यीशु आंदुर से अंदुन, “ना नीम से खरा खरा अनतीन कि यागासताका नीव मंळसा अन पार उन मय तिनालीर, अदिक आऊन खुन कुडालीर, नीम दा जीवन हैलेच. <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />जो नान मास तिनतान अदिक नान खुन कुडुतान, अनन्त जीवन आऊंदा आद; अदिक ना आऊक आखरी दिशी बाक जित्‍ता माळाईन. <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />यतिकी नान मास सही दा तिनोद चिज हुन, अदिक नान खुन सही दा कुडोद चिज हुन. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />जो नान मास तिनतान अदिक नान खुन कुडुतान आव नान दा संची बन्सकु ईरतान, अदिक ना आऊन दा. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />ह्यांग जित्‍ता आप्प नानी कळ्यान, अदिक ना आप्प उन कारण जित्‍ता आईन, हांगा आव भी जो नानी तिंदान नान कारण जित्‍ता ईत्‍तान. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />जो रोट्टी स्वर्ग टु ईळुत अदा हुन, आ रोट्टी अन घाई यारी आप्प दादागोळ तिंदुर अदिक सोतोदुर; जो यावारा ईद रोट्टी तिंदान, आव सदा जित्‍ता ईत्‍तान.” <verse eid="JHN 6:58" /><verse number="59" style="v" sid="JHN 6:59" />ई मातगोळी आव कफरनहूम इन ऊंद यहूदी लॉकुर्द सभागृह दा उपदेश कोळाहोती अंदुन.<verse eid="JHN 6:59" /></para>
  <para style="s">अनन्त जीवन इन वचन</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />यीशु उन चेलागोळ दा टु हापाळ मुंदुर ईद केळकु अंदुर, “ईद कठोर मात आद; इदरी याव केळ सकतान?” <verse eid="JHN 6:60" /><verse number="61" style="v" sid="JHN 6:61" />यीशु तान मन दा ईद जान्सकु कि नान चेलागोळ आपस दा ईद मात मा कुळकुळुसतार, आंदुर से केळदुन, “येन ईद मात देल नीमी ठोकर हततद? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />अगर नीव मंळसा अन पार उक येल आव पयले ईरोन, अल म्याकुच होग्त नोळीर, रा येन आदीत? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />आत्मा रा जीवनदायक आद, मय देल येनु लाभ हैलेच; जो मातगोळी ना नीम से अंदीन अव आत्मा हु, अदिक जीवन भी हुन. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />लेकीन नीम दा टु येनारा हिंग आर जो विश्वास माळालुर.” यतिकी यीशु पयले टु अच जानसोन कि जो विश्वास माळालुर, आंदुर यार उर; अदिक याव नानी हुळसुस्यान. <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />अदिक आव अंदुन, “इदुर्दा साटी ना नीम से अंदिदीन कि यागासताका यारीकारा आप्प उन दी टु ईद वरदान कोटकु आगाल्द आगासताका आव नान हात्‍ती बर सकालुन.”<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />इदुर मा आऊन चेलागोळ दा टु हापाळ मुंदुर वापस आगेदुर अदिक अदुर बाद्दा आऊन सांगुळ होगीदील. <verse eid="JHN 6:66" /><verse number="67" style="v" sid="JHN 6:67" />आग यीशु आ हन्नेळ चेलागोळी अंदुन, “येन नीव भी होगोद चाहासतीर?” <verse eid="JHN 6:67" /><verse number="68" style="v" sid="JHN 6:68" /><note caller="+" style="x"><char style="xo" closed="false">६:६८ </char><char style="xt" closed="false"><ref loc="MAT 16:16">मत्ती १६:१६</ref>; <ref loc="MRK 8:29">मरकुस ८:२९</ref>; <ref loc="LUK 9:20">लूका ९:२०</ref></char></note>शमौन पतरस आऊक उत्‍तर कोट्टुन, “हे प्रभु, नाव यार हाती होदेव? अनन्त जीवन इन मातगोळ रा नींद अच हाती आव; <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />अदिक नाव विश्वास माळदेव अदिक जान्स कोंडेव कि परमेश्वर उन पवित्र जन नीना हुय.” <verse eid="JHN 6:69" /><verse number="70" style="v" sid="JHN 6:70" />यीशु आंदरी उत्‍तर कोट्टुन, “येन ना नीव हन्नेळ मुंदरी नीवळुसीदील? तरी नीम दा टु ऊंद मंळसा शैतान आन.” <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />ईद आव शमौन इस्करियोती इन पार यहूदा अन बारा दा अंदिदुन, यतिकी आवा जो हन्नेळ चेलागोळ दा टु ऊंद ईरोन, आऊक हुळसुसोद ईरोद.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">यीशु अदिक आऊन वार्टुर</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />ई मातगोळ्द बाद्दा यीशु गलील दा टेटाळतेला ईत्‍तुन; यतिकी यहूदी लॉकुर आऊक कोंद बुळोद कोशिश माळोर, इदुरसाटी आव यहूदिया दा टेटाळोद ईला चाहासोन. <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />यहूदीगोळ्द झोपळीगोळ्द हाब्ब<note caller="+" style="f"><char style="fr" closed="false">७:२ </char><char style="ft" closed="false">हाब्ब इन मतलब त्यौहार</char></note> हात्‍ती ईरोद. <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />इदुरसाटी आऊन वार्टुर आऊन से अंदुर, “ईल टु यहूदिया अक होग, कि जो क्याल्सा नी माळत्या अवरी नीन चेलागोळ अल भी नोळुल. <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />यतिकी हिंग याऊ ईला ईतीदान जो प्रसिद्ध आगोद चाहासुल, अदिक होचकु क्याल्सा माळुल. अगर नी क्याल्सा माळत्या, रा तान तान इक दुनिया मा प्रगट माळ.” <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />यतिकी आऊन वार्टुर भी आऊन मा विश्वास ईला माळतोगोर. <verse eid="JHN 7:5" /><verse number="6" style="v" sid="JHN 7:6" />आग यीशु आंदुर से अंदुन, “नान समय ईगासताका बंदिदील, लेकीन नीम साटी सप्पा समय आद. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />दुनिया नीम से दुश्मनी माळ सकाल, लेकीन अद नान से दुश्मनी माळतद यतिकी ना अदुर विरोध दा ईद गवाही कोळतीन कि अदुर क्याल्सा बुरा आद. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />नीव हाब्ब दा होगी; ना ईगल्या ईद हाब्ब दा होगालीन, यतिकी ईगासताका नान समय पुरा आगीदील.” <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />आव आंदुर से ई मातगोळी अनकु गलील दा अच ईतोदुन.<verse eid="JHN 7:9" /></para>
  <para style="s">झोपळीगोळ्द हाब्ब दा यीशु</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />लेकीन याग आऊन वार्टुर हाब्ब दा वोळेदुर रा आव खुद भी, प्रगट दा ईला लेकीन मान्सी गुप्त रूप देल होदुन. <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />यहूदी हाब्ब दा आऊक ईद अनकु ढुंढ्सली कुरतुर, “आव यल आन?” <verse eid="JHN 7:11" /><verse number="12" style="v" sid="JHN 7:12" />अदिक लॉकुर दा आऊन बारा दा सुंगा मुंगा हापाळ सा मातगोळ आदव: यारारा अनतोगोर, “आव वळ्लेव मंळसा आन.” अदिक यारारा अनतोगोर, “ईला, आव लॉकुरी भरमुसतान.” <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />तरी यहूदीगोळ्द अंज्क इन कारण याऊ मंळसा आऊन बारा दा खुल्सकु ईला माताळोन.<verse eid="JHN 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />याग हाब्ब इन आर्धा दिन बितसेदव; रा यीशु मंदिर दा होगकु उपदेश माळली कुरतुन. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />आग यहूदीगोळ चकित आगकु अंदुर, “ईऊक बिना वाचुस्द अक्‍कल ह्यांग होटबत?” <verse eid="JHN 7:15" /><verse number="16" style="v" sid="JHN 7:16" />यीशु आंदरी उत्‍तर कोट्टुन, “नान उपदेश नांद ईला, लेकीन नान कळावाळा अन हुन. <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />अगर यावारा आऊन इच्छा मा नळोद चाहासतान, रा आव ईद उपदेश इन बारा दा जान्स कोंडान कि ईद परमेश्वर उन दी टु हुन या तान दी टु अनतीन. <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />जो तान दी टु येनारा अनतान, आव तांद अच बळाई चाहासतान; लेकीन जो तान कळावाळा अन बळाई चाहासतान आवा खरा आन, अदिक अदुर दा अन्याय ईला. <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />येन मूसा नीमी व्यवस्था कोटीदील? तरी नीम दा टु याऊ व्यवस्था मा नळालुन. नीव येती नानी कोंद बुळोद चाहासतीर?” <verse eid="JHN 7:19" /><verse number="20" style="v" sid="JHN 7:20" />लॉकुर उत्‍तर कोट्टुर, “नीन दा दुष्टआत्मा आद! याव नीनी कोंद बुळोद चाहासतान?” <verse eid="JHN 7:20" /><verse number="21" style="v" sid="JHN 7:21" />यीशु आंदरी उत्‍तर कोट्टुन, “ना ऊंद क्याल्सा माळदीन, अदिक नीव सप्पा आश्चर्य माळतीर. <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />ईदा कारण मूसा नीमी खतना अन आग्या कोटान ईद ईला कि अद मूसा अन दी टु आद लेकीन आप्प दादागोळ टु नळुत बंदाद, अदिक नीव आराम इन दिन मंळसा अन खतना माळतीर. <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" /><note caller="+" style="x"><char style="xo" closed="false">७:२३ </char><char style="xt" closed="false"><ref loc="JHN 5:9">यूहन्ना ५:९</ref></char></note>याग आराम इन दिन मंळसा अन खतना माळकु आगतद ताकी मूसा अन व्यवस्था अन आग्या टलुस बाळुल, रा नीव नान मा येती इदुरसाटी सिट्ट माळतीर कि ना आराम इन दिन ऊंद मंळसा अक पुरा रीति देल चंगा माळदीन. <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />बाय नोळ्द न्याय माळबाळी, लेकीन ठीक ठीक न्याय माळी.”<verse eid="JHN 7:24" /></para>
  <para style="s">येन यीशु अच मसीह हुन?</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />आग येनारा यरूशलेम इन लॉकुर अनली कुरतुर, “येन ईव आवा आल्लच यारी कोंद बुळोद कोशिश माळकु आगेत्याद? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />लेकीन नोळी, आव रा मसीहगोळ घाई खुल्लम खुल्ला मातगोळी माळतान अदिक याऊ सरदार आऊन से येनु अनालुर. <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />ईऊक रा नाव जान्सतेव कि ईव येलेव हुन; लेकीन मसीह याग बंदान रा याऊ जान्सतीदील कि आव येलेव हुन.” <verse eid="JHN 7:27" /><verse number="28" style="v" sid="JHN 7:28" />आग यीशु मंदिर दा उपदेश कोळतेला कारूकु अंदुन, “नीव नानी जान्सतीर, अदिक ईद भी जान्सतीर कि ना येलेव हुईन. ना रा खुद देल बंदिदील, लेकीन नानी कळावाळा खरा आन, आऊक नीव जान्सालीर. <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />ना आऊक जान्सतीन यतिकी ना आऊन दी टु आईन अदिक आवा नानी कळ्यान.” <verse eid="JHN 7:29" /><verse number="30" style="v" sid="JHN 7:30" />इदुर मा आंदुर आऊक हुडोद चाहासदुर, तरी याऊ आऊन मा कय हाकिदील यतिकी आऊन सही समय ईगासताका बरली का ईरोद. <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />तरी भी भीळ दा टु हापाळ सा लॉकुर आऊन मा विश्वास माळदुर, अदिक अनली कुरतुर, “मसीह याग बंदान रा येन इदुर से यक्कुल आश्चर्यकर्म तोरस्यान जो ईव तोर्सदुन?”<verse eid="JHN 7:31" /></para>
  <para style="s">यीशु उक हुडोद कोशिश</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />फरीसीगोळ लॉकुरी यीशु उन बारा दा ई मातगोळ सुंगा मुंगा अंत केळदुर; अदिक प्रधान याजकगोळ अदिक फरीसीगोळ आऊक हुडोर साटी सिपाही कळुदुर. <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />इदुर मा यीशु अंदुन, “ना थ्वाळासा समय ताका अदिक नीम सांगुळ आईन, आग तान कळावाळा अन हात्‍ती होटोगाईन. <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />नीव नानी ढुंढसीर, लेकीन नीमी सिकतीदील; अदिक येल ना आईन, अल नीव बर सकालीर.”<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />इदुर मा यहूदीगोळ आपस दा अंदुर, “ईव येल होदान कि नामी सिकतीदील? येन ईव आंदुर हात्‍ती होदान जो ग्रीकगोळ दा तितर-बितर आगकु ईरतार, अदिक ग्रीकगोळी भी उपदेश कोट्टान? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />ईद येन मात आद जो आव अंदुन, कि ‘नीव नानी ढुंढसीर, लेकीन सिकतीदील; अदिक येल ना आईन, अल नीव बर सकालीर.’”<verse eid="JHN 7:36" /></para>
  <para style="s">जीवन नीर इन गांगा</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />हाब्ब इन आखरी दिशी, जो मुख्य दिन आद, यीशु निदुरदुन अदिक कारूकु अंदुन, “अगर यावारा प्यासा आन रा नान हात्‍ती बरूल अदिक कुडुल. <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />जो नान मा विश्वास माळ्यान, ह्यांग पवित्रशास्त्र दा बंदाद, ‘आऊन दिल दा टु जीवन इन नीर इन गांगा वाहुसकु होट्टीत.’” <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />आव ईद वचन पवित्र आत्मा अन बारा दा अंदुन, यारी आऊन मा विश्वास माळावाळेरी सिक्‍कोद ईरोद; यतिकी आत्मा ईगासताका ईला ईळदीत, यतिकी यीशु ईगासताका तान महिमा अक ईला पोहचुसीदुन.<verse eid="JHN 7:39" /></para>
  <para style="s">लॉकुर दा भेदभाव</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />आग भीळ दा टु यारारा यारारा ई मातगोळी केळकु अंदुर, “सही दा ईवा आव भविष्यवक्ता हुन.” <verse eid="JHN 7:40" /><verse number="41" style="v" sid="JHN 7:41" />दुसरागोळ अंदुर, “ईव मसीह हुन.” लेकीन येनारा लॉकुर अंदुर, “येती? येन मसीह गलील टु बंदान? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />येन पवित्रशास्त्र दा ईद बंदिदील कि मसीह दाऊद इन वंश टु अदिक बैतलहम ऊर टु बंदान, यल दाऊद ईरतान?” <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />इदुरसाटी आऊन कारण लॉकुर दा फूट बित्‍त. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />आंदुर दा टु यारारा आऊक हुडोद चाहासोर, लेकीन याऊ आऊन मा कय हाकीदील.<verse eid="JHN 7:44" /></para>
  <para style="s">यहूदी अधिकारीगोळ्द अविश्वास</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />आग सिपाही प्रधान याजक अदिक फरीसीगोळ हात्‍ती वापस बंदुर; आंदुर सिपाहीगोळ से अंदुर, “नीव आऊक येती तंदिदील?” <verse eid="JHN 7:45" /><verse number="46" style="v" sid="JHN 7:46" />सिपाहीगोळ उत्‍तर कोट्टुर, “यावारा मंळसा यागलु हिंग मातगोळी माळीदील.” <verse eid="JHN 7:46" /><verse number="47" style="v" sid="JHN 7:47" />फरीसीगोळ आंदरी उत्‍तर कोट्टुर, “येन नीव भी भरमुसकु आगीर? <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />येन सरदारगोळ या फरीसीगोळ दा टु यारारा आऊन मा विश्वास माळ्यार? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />लेकीन ई लॉकुर जो व्यवस्था जान्सालुर, शापित आर.” <verse eid="JHN 7:49" /><verse number="50" style="v" sid="JHN 7:50" /><note caller="+" style="x"><char style="xo" closed="false">७:५० </char><char style="xt" closed="false"><ref loc="JHN 3:1">यूहन्ना ३:१</ref>,<ref loc="JHN 3:2">२</ref></char></note>नीकुदेमुस, जो पयले आऊन हात्‍ती बंदीदुन अदिक आंदुर दा टु ऊंद ईरोन, आंदुर से अंदुन, <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />“येन नाम व्यवस्था यावारा मंळसा अक, यागासताका पयले आऊंद केळकु जान्स कोमालुर कि आव येन माळतान, दोषी ठहरूसतार?” <verse eid="JHN 7:51" /><verse number="52" style="v" sid="JHN 7:52" />आंदुर आऊक उत्‍तर कोट्टुर, “येन नी भी गलील इन हुय? ढुंढ्स अदिक नोळ कि गलील टु यावारा भविष्यवक्ता प्रगट ईला आगोद.” <verse eid="JHN 7:52" /><verse number="53" style="v" sid="JHN 7:53" />आग सप्पा लॉकुर तान तान मान्नी वोळेदुर.<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s">व्यभिचारिणी इक माफ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />लेकीन यीशु जैतून इन पहाळी मा होदुन. <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />व्हातर्या आव मात्‍त मंदिर दा बंदुन; सप्पा लॉकुर आऊन हात्‍ती बंदुर अदिक आव कुर्तकु आंदरी उपदेश कोळली कुरतुन. <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />आग शास्त्री अदिक फरीसी ऊंद आर्त इक तंदुर जो व्यभिचार दा हुळकु आगीदुर, अदिक आकी बीच दा निदरूसकु यीशु से अंदुर, <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />“हे गुरु, ई आर्त व्यभिचार माळ्त हुळकु आदुर. <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />व्यवस्था दा मूसा नामी आग्या कोटान कि हिंग आर्तेर मा पथराव माळुल. इदुरसाटी नी ई आर्त इन बारा दा येन अनत्या?” <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />आंदुर आऊक परखुसोर साटी ईद मात अंदुर ताकी आऊन मा दोष हचोर साटी येनारा मात सिक्‍कुल. लेकीन यीशु बांगकु बेळ्ल देल जागा मा लिख्सली कुरतुन. <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />याग आंदुर आऊन से केळतेला अच ईत्‍तुर, रा आव सिधा निदुरकु आंदुर से अंदुन, “नीम दा जो निष्पाप आन, आवा पयले आकी कल्ल होळदान.” <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />अदिक बाक बांगकु जागा मा बेळ्ल देल लिख्सली कुरतुन. <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />लेकीन आंदुर ईद केळकु धोड्डेर टु हुळकु स्याणेर ताका, ऊंद ऊंद माळकु होट्ट बुटुर, अदिक यीशु आबना ईतोदुन, अदिक आर्त अल्या बीच दा निदुरकु ईतोदुर. <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />यीशु सरका आगकु आकिन से अंदुन, “हे आर्त, आंदुर येल होदुर? येन यारारा दण्ड इन आग्या कोटीदील?” <verse eid="JHN 8:10" /><verse number="11" style="v" sid="JHN 8:11" />आक अंदुर, “हे प्रभु, याऊ ईला.” यीशु अंदुन “ना भी नीनी दण्ड इन आग्या कोळालीन; होग, अदिक बाक पाप माळबाळेत.”<verse eid="JHN 8:11" /></para>
  <para style="s">यीशु दुनिया अन ज्योति</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">८:१२ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:14">मत्ती ५:१४</ref>; <ref loc="JHN 9:5">यूहन्ना ९:५</ref></char>
    </note>यीशु बाक लॉकुर से अंदुन, “दुनिया अन ज्योति ना हुईन; जो नान हिंद आगेदान आव अंधकार दा नळुतीदील; लेकीन जीवन इन ज्योति सिक्‍कीत.” <verse eid="JHN 8:12" /><verse number="13" style="v" sid="JHN 8:13" /><note caller="+" style="x"><char style="xo" closed="false">८:१३ </char><char style="xt" closed="false"><ref loc="JHN 5:31">यूहन्ना ५:३१</ref></char></note>फरीसीगोळ आऊन से अंदुर, “नी तान गवाही खुद अच कोळत्या, नीन गवाही सही हैलेच.” <verse eid="JHN 8:13" /><verse number="14" style="v" sid="JHN 8:14" />यीशु आंदरी उत्‍तर कोट्टुन, “भला ही ना तान गवाही खुद अच कोळतीन, तरी भी नान गवाही खरा आद, यतिकी ना जान्सतीन कि ना यल टु बंदीन अदिक यल होगतीन? लेकीन नीव जान्सालीर कि ना यल टु बरतीन या यल होगतीन. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />नीव मय इन अनुसार न्याय माळतीर; ना यारदु न्याय माळालीन. <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />अदिक अगर ना न्याय माळाईन भी, रा नान न्याय खरा आद; यतिकी ना आबना हैलेच, लेकीन ना हुईन, अदिक आप्प आन याव नानी कळुदुन. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />नीम व्यवस्था दा भी लिख्सकु आद कि येढ्ढ मुंदुर गवाही मिलुसकु सही आगतद; <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />ऊंद रा ना खुद तान गवाही कोळतीन, अदिक दुसरा आप्प नान गवाही कोळतान याव नानी कळ्यान.” <verse eid="JHN 8:18" /><verse number="19" style="v" sid="JHN 8:19" />आंदुर आऊन से अंदुर, “नीन आप्प यल आन?” यीशु उत्‍तर कोट्टुन, “ना नीव नानी जान्सतीर, ना नान आप्प उक, अगर नानी जान्सायदीर रा नान आप्प उक भी जान्सायदीर.” <verse eid="JHN 8:19" /><verse number="20" style="v" sid="JHN 8:20" />ई मातगोळी आव मंदिर दा उपदेश कोळतेला भंडार मान्या अंदुन, अदिक याऊ आऊक हुळदीदिल, यतिकी आऊन समय ईगासताका ईला बंदीत.<verse eid="JHN 8:20" /></para>
  <para style="s">तान बारा दा यीशु उन कथन</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />यीशु बाक आंदुर से अंदुन, “ना होगतीन, अदिक नीव नानी ढुंढसीर अदिक तान पाप दा सोत्‍तीर; यल ना होगतीन, अल नीव बर सकालीर.” <verse eid="JHN 8:21" /><verse number="22" style="v" sid="JHN 8:22" />इदुर मा यहूदीगोळ अंदुर, “येन आव तान तान इक कोंद बुटान, जो अनतान, ‘यल ना होगतीन अल नीव बर सकालीर.’” <verse eid="JHN 8:22" /><verse number="23" style="v" sid="JHN 8:23" />आव आंदुर से अंदुन, “नीव ल्यालमा नोर हुईर, ना म्याकुच इनव हुईन; नीव दुनिया नोर हुईर, ना दुनिया इनव आल्लच. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />इदुरसाटी ना नीम से अंदीन कि तान पापगोळ दा सोत्‍तीर, यतिकी अगर नीव विश्वास माळतीदील कि ना आवा हुईन रा तान पापगोळ दा सोत्‍तीर.” <verse eid="JHN 8:24" /><verse number="25" style="v" sid="JHN 8:25" />आंदुर आऊन से अंदुर, “नी याव हुय?” यीशु आंदुर से अंदुन, “आवा हुईन जो सुरूवात टु नीम से अनतेला बंदीन. <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />नीम बारा दा नानी हापाळ येनारा अनोद अदिक निर्णय माळोद आद; लेकीन नान कळावाळा खरा आन, अदिक जो ना आऊन से केळदीन अदा दुनिया अक अनतीन.” <verse eid="JHN 8:26" /><verse number="27" style="v" sid="JHN 8:27" />आंदुर ईद समसीदील कि नाम से आप्प उन बारा दा अनतान. <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />आग यीशु अंदुन, “याग नीव मंळसा अन पार उक म्याकुच येरसीर, रा जानसीर कि ना आवा हुईन; ना तान तान से येनु माळालीन लेकीन ह्यांग नान आप्प नानी कलस्यान हांग अच ई मातगोळी अनतीन. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />नान कळावाळा नान सांगुळ आन; आव नानी आबना बिटीदिल यतिकी ना सदा अदा क्याल्सा माळतीन यदुर देल आव प्रसन्न आगतान.” <verse eid="JHN 8:29" /><verse number="30" style="v" sid="JHN 8:30" />आव ईव मातगोळी अनतेला अच ईरोन कि हापाळ मुंदुर आऊन मा विश्वास माळदुर.<verse eid="JHN 8:30" /></para>
  <para style="s">सच्चाई नीमी स्वतंत्र माळीत</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />आग यीशु आ यहूदीगोळ से यार आऊन मा विश्वास माळीदुर, अंदुन, “अगर नीव नान वचन दा बन्सकु ईत्‍तीर, रा सही दा नान चेलागोळ ठहरूसीर. <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />नीव सही अक जानसीर, अदिक सही नीमी स्वतंत्र माळीत.” <verse eid="JHN 8:32" /><verse number="33" style="v" sid="JHN 8:33" /><note caller="+" style="x"><char style="xo" closed="false">८:३३ </char><char style="xt" closed="false"><ref loc="MAT 3:9">मत्ती ३:९</ref>; <ref loc="LUK 3:8">लूका ३:८</ref></char></note>आंदुर आऊक उत्‍तर कोट्टुर, “नाव रा अब्राहम उन वंश टु आयेव, अदिक यागलु यारदु दास आगीदील. बाक नी ह्यांग अनत्या कि नीव स्वतंत्र आगेदीर?” <verse eid="JHN 8:33" /><verse number="34" style="v" sid="JHN 8:34" />यीशु आंदरी उत्‍तर कोट्टुन, “ना नीम से खरा खरा अनतीन कि जो यावारा पाप माळतान आव पाप इन दास आन. <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />दास सदा मान्या ईरालुन; पार सदा ईरतान. <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />इदुरसाटी अगर पार नीमी स्वतंत्र माळ्यान, रा सचमुच नीव स्वतंत्र आगेदीर. <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />ना जान्सतीन कि नीव अब्राहम उन वंश टु आईर; तरी नान वचन नीम दिल दा जागा हुडाल्द, इदुरसाटी नीव नानी कोंद बुळोद चाहासतीर. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />ना अदा अनतीन, जो तान आप्प उन मान्या नोळदीन; अदिक नीव अदा माळतेला ईरतीर जो नीव तान आप्प उन से केळदीर.” <verse eid="JHN 8:38" /><verse number="39" style="v" sid="JHN 8:39" />आंदुर आऊक उत्‍तर कोट्टुर, “नाम आप्प रा अब्राहम हुन.” यीशु आंदुर से अंदुन, “अगर नीव अब्राहम उन औलाद आगयदीर, रा अब्राहम उन घाई क्याल्सा माळायदीर. <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />लेकीन ईग नीव नान घाई मंळसा अक कोंद बुळोद चाहासतीर, याव नीमी अद सही वचन हेळदुन जो परमेश्वर से केळदेव; हिंग रा अब्राहम ईला माळीदुन. <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />नीव तान आप्प उन घाई क्याल्सा माळतीर.” आंदुर आऊन से अंदुर, “नाव व्यभिचार देल पैदा आगीदील, नाम ऊंद आप्प आन मतलब परमेश्वर.” <verse eid="JHN 8:41" /><verse number="42" style="v" sid="JHN 8:42" />यीशु आंदुर से अंदुन, “अगर परमेश्वर नीम आप्प ईरायदुन, रा नीव नान से प्यार ईटायदीर; यतिकी ना परमेश्वर उन दी टु बंदीन. ना खुद देल बंदिदील, लेकीन आवा नानी कळ्यान. <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />नीव नान मात येती समसालीर? इदुरसाटी कि नीव नान वचन केळ सकालीर. <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />नीव तान आप्प शैतान उन दी टु आईर अदिक तान आप्प उन लालसागोळी पुरा माळोद चाहासतीर. आव रा सुरूवात टु हत्यारा आन अदिक सही मा संची ईतीदील; यतिकी सही आऊन दा हैलेच. याग आव ख्वाटा माताळतान, रा तान स्वभाव देल अच माताळतान; यतिकी आव झुठा आन अदिक झुठ इन आप्प आन. <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />लेकीन ना जो खरा माताळतीन, इदुर्दा साटी नीव नांद विश्वास माळालीर. <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />नीम दा टु याव नानी पापी ठहरूसतान? अगर ना खरा माताळतीन, रा नीव नान विश्वास येती माळालीर? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />जो परमेश्वर टु आगतान, आव परमेश्वर उन मातगोळी केळतान; अदिक नीव इदुरसाटी केळालीर कि परमेश्वर उन दी टु आल्लच.”<verse eid="JHN 8:47" /></para>
  <para style="s">यीशु अदिक अब्राहम</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />ईद केळकु यहूदीगोळ यीशु से अंदुर, “येन नाव खरा अनालेव कि नी सामरी हुय, अदिक नीन दा दुष्टआत्मा आद?” <verse eid="JHN 8:48" /><verse number="49" style="v" sid="JHN 8:49" />यीशु उत्‍तर कोट्टुन, “नान दा दुष्टआत्मा हैलेच; लेकीन ना तान आप्प उन आदर माळतीन, अदिक नीव नान निरादर माळतीर. <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />लेकीन ना तान प्रतिष्ठा चाहासालीन; हव, ऊंद आन जो चाहासतान अदिक न्याय माळतान. <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />ना नीम से खरा खरा अनतीन कि अगर यावारा मंळसा नान वचन मा नळदान, रा आव अनन्त काल ताका मृत्यु अक नोळतीदिल.” <verse eid="JHN 8:51" /><verse number="52" style="v" sid="JHN 8:52" />यहूदीगोळ आऊन से अंदुर, “ईग नाव जान्स कोंडेव कि नीन दा दुष्टआत्मा आद. अब्राहम सोतोदुन, अदिक भविष्यवक्तागोळ भी सोतोग्यार; अदिक नी अनत्या, ‘अगर यावारा नान वचन मा नळदान रा आव अनन्त काल ताका मृत्यु नोळतीदिल.’ <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />नाम आप्प अब्राहम रा सोतोदुन. येन नी आऊन से धोड्डेव आय? अदिक भविष्यवक्तागोळ भी सोतोदुर. नीमी येन हततद कि नीव येन हुईर?” <verse eid="JHN 8:53" /><verse number="54" style="v" sid="JHN 8:54" />यीशु उत्‍तर कोट्टुन, “अगर ना खुद तान महिमा माळाईन, रा नान महिमा येनु ईला; लेकीन नान महिमा माळावाळा नान आप्प आन, यारी नीव अनतीर कि आव नीम परमेश्वर हुन. <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />नीव रा आऊक जानसीदील: लेकीन ना आऊक जान्सतीन. अगर ना अनाईन कि ना आऊक जान्सालीन, रा ना नीम घाई ख्वाटा ठहरूसाईन; लेकीन ना आऊक जान्सतीन अदिक आऊन वचन मा नळुतीन. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />नीम आप्प अब्राहम नान हागुल नोळोद आशा देल हापाळ मग्न ईरोन; अदिक आव नोळदुन अदिक खुश आदुन.” <verse eid="JHN 8:56" /><verse number="57" style="v" sid="JHN 8:57" />यहूदीगोळ आऊन से अंदुर, “ईगासताका नी पचास वर्ष इन हैलेच, तरी भी नी अब्राहम उक नोळ्या?” <verse eid="JHN 8:57" /><verse number="58" style="v" sid="JHN 8:58" />यीशु आंदुर से अंदुन, “ना खरा खरा अनतीन, कि पयले इदुर्द कि अब्राहम पैदा आदुन, ना आईन.” <verse eid="JHN 8:58" /><verse number="59" style="v" sid="JHN 8:59" />आग आंदुर आऊक बडोर साटी कल्ल नेगदुर, लेकीन यीशु होचकु मंदिर टु होटबुटुन.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">जनम इन कुढ्ढ उक कण्ण कोळोद</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />होगाहोती यीशु ऊंद मंळसा अक नोळदुन जो जनम टु कुढ्ढ ईरोन. <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />आऊन चेलागोळ आऊन से केळदुर, “हे गुरु, याव पाप माळीदुन कि ईव कुढ्ढ पैदा आदुन, ई मंळसा या ईऊन मोय या ईऊन आप्प?” <verse eid="JHN 9:2" /><verse number="3" style="v" sid="JHN 9:3" />यीशु उत्‍तर कोट्टुन, “ना रा ईव पाप माळीदुन, ना ईऊन मोय ना आप्प; लेकीन ईद इदुरसाटी आत कि परमेश्वर उन क्याल्सा आऊन मा प्रगट आगुल. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />याव नानी कळ्यान, नामी आऊन क्याल्सा हागुल ईरतेला अच माळोद जरूरी आद; अद ईळ्लक बरोद आद यदुर्दा याऊ क्याल्सा माळ सकतीदिल. <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" /><note caller="+" style="x"><char style="xo" closed="false">९:५ </char><char style="xt" closed="false"><ref loc="MAT 5:14">मत्ती ५:१४</ref>; <ref loc="JHN 8:12">यूहन्ना ८:१२</ref></char></note>यागासताका ना दुनिया दा आईन, आगासताका दुनिया अन ज्योति आईन.” <verse eid="JHN 9:5" /><verse number="6" style="v" sid="JHN 9:6" />ईद अनकु आव जागा मा ऊगुळदुन, अदिक आ ऊगळा देल मुण्ण इक काल्सदुन, अदिक अद मुण्ण आ कुढ्ढ उन कण्णगोळ मा हचकु <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" /><note caller="+" style="f"><char style="fr" closed="false">९:७ </char><char style="ft" closed="false">शीलोह अन मतलब “कळुकु आगोद” हुन.</char></note>आऊन से अंदुन, “होग, शीलोह अन कुण्ड दा तोळकोम” आव होगकु तोळदुन, अदिक नोळतेला वापस बंदुन. <verse eid="JHN 9:7" /><verse number="8" style="v" sid="JHN 9:8" />आग आऊन बाजुवाळेर अदिक यार पयले आऊक भीख बेळतेला नोळीदुर, अनली कुरतुर, “येन ईव आवा आल्लच, जो कुर्तकु भीख बेळतोगोन?” <verse eid="JHN 9:8" /><verse number="9" style="v" sid="JHN 9:9" />येनारा लॉकुर अंदुर, “ईव आवा हुन,” दुसरागोळ अंदुर, “ईला, लेकीन आऊन घाई आन.” आव अंदुन, “ना आवा हुईन.” <verse eid="JHN 9:9" /><verse number="10" style="v" sid="JHN 9:10" />आग आंदुर आऊन से केळली कुरतुर, “नीन कण्णगोळ ह्यांग खुलसेदव?” <verse eid="JHN 9:10" /><verse number="11" style="v" sid="JHN 9:11" />आव उत्‍तर कोट्टुन, “यीशु हेसुर इन ऊंद मंळसा मुण्ण काल्सदुन, अदिक नान कण्णगोळ मा हचकु नान से अंदुन, ‘शीलोह दा होगकु तोळकोम,’ इदुरसाटी ना होदीन अदिक तोळदिन अदिक नोळली कुरतीन.” <verse eid="JHN 9:11" /><verse number="12" style="v" sid="JHN 9:12" />आंदुर आऊन से केळदुर, “आव यल आन?” आव अंदुन, “ना जान्सालीन.”<verse eid="JHN 9:12" /></para>
  <para style="s">फरीसीगोळ द्वारा चंगाई इन जाँच पळताल</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />लॉकुर आऊक जो पयले कुढ्ढ ईरोन फरीसीगोळ हात्‍ती ओतुर. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />याता दिशी यीशु मुण्ण काल्सकु आऊन कण्णगोळी तेरदीदुन, अद आराम इन दिन ईरोद. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />बाक फरीसीगोळ भी आऊन से केळदुर कि आऊन कण्णगोळ याता रीति देल खुलसेदव. आव आंदुर से अंदुन, “आव नान कण्णगोळ मा मुण्ण हचदुन, बाक ना तोळु कोंडीन, अदिक ईग ना नोळ सकतीन.” <verse eid="JHN 9:15" /><verse number="16" style="v" sid="JHN 9:16" />इदुर मा येनारा फरीसी अनली कुरतुर, “ई मंळसा परमेश्वर उन दी टु आल्लच, यतिकी आव आराम इन दिन मानसालुन.” दुसरागोळ अंदुर, “पापी मंळसा हिंग चमत्कार ह्यांग तोर्स सकतान?” इदुरसाटी आंदुर दा फूट बिदोत. <verse eid="JHN 9:16" /><verse number="17" style="v" sid="JHN 9:17" />आंदुर आ कुढ्ढ मंळसा से मात्‍त अंदुर, “आव नीन कण्णगोळी खोलस्यान. नी आऊन बारा दा येन अनत्या?” आव अंदुन, “आव भविष्यवक्ता आन.”<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />लेकीन यहूदीगोळी विश्वास आगीदील कि आव कुढ्ढ ईरोन अदिक ईग नोळतान, यागासताका आंदुर आऊन, यार्द कण्णगोळ खुलसेगीदव, आऊन मोय-आप्प उक कारूकु <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />आंदुर से केळीदील, “येन ईव नीम पार हुन, यारी नीव अनतीर कि कुढ्ढ पैदा आगीदुन? बाक ईग ह्यांग नोळतान?” <verse eid="JHN 9:19" /><verse number="20" style="v" sid="JHN 9:20" />आऊन मोय-आप्प उत्‍तर कोट्टुर, “नाव रा जान्सतेव कि ईव नाम पार हुन, अदिक कुढ्ढ पैदा आगीदुन: <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />लेकीन नाव ईद जानसालेव कि ईग ह्यांग नोळतान, अदिक ना ईद जान्सतेव कि याव आऊन कण्णगोळी तेरदुन. आव स्याणा आन, आऊन से अच केळ कोमी: आव तान बारा दा खुद अंद बुटान.” <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />ई मातगोळी आऊन मोय आप्प इदुरसाटी अंदुर यतिकी आंदुर यहूदीगोळ से अंजोर, यतिकी यहूदी ऊंद मत आगेगीदुर कि अगर यावारा अंदान कि आव मसीह हुन, रा आव सभागृह टु तेगुकु आदान. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />ईदा कारण आऊन मोय आप्प अंदुर, “आव स्याणा आन, आऊन से अच केळ कोमी.”<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />आग आंदुर आ मंळसा अक जो कुढ्ढ ईरोन, दुसरा घन कारूकु आऊन से अंदुर, “परमेश्वर उन स्तुती माळ. नाव रा जान्सतेव कि आ मंळसा पापी आन.” <verse eid="JHN 9:24" /><verse number="25" style="v" sid="JHN 9:25" />आव उत्‍तर कोट्टुन, “ना जानसालीन कि आव पापी आन या हैलेच; ना ऊंद मात जान्सतीन कि ना पयले कुढ्ढ ईरीन अदिक ईग नोळतीन.” <verse eid="JHN 9:25" /><verse number="26" style="v" sid="JHN 9:26" />आंदुर आऊन से मात्‍त अंदुर, “आव नीन सांगुळ येन माळदुन? अदिक याता प्रकार देल नीन कण्णगोळी खोल्सदुन?” <verse eid="JHN 9:26" /><verse number="27" style="v" sid="JHN 9:27" />आव आंदुर से अंदुन, “ना रा नीम से अंद कोंडीन, अदिक नीव केळीदील; ईग दुसरा घन येती केळोद चाहासतीर? येन नीव भी आऊन चेला बनसोद चाहासतीर?” <verse eid="JHN 9:27" /><verse number="28" style="v" sid="JHN 9:28" />आग आंदुर आऊक बुरा भला अनली कुरतुर, “नी अच आऊन चेला आय, नाव रा मूसा अन चेला हुयेव. <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />नाव जान्सतेव कि परमेश्वर मूसा से मातगोळी हेळदुन; लेकीन ई मंळसा अक जानसालेव कि येलेव हुन.” <verse eid="JHN 9:29" /><verse number="30" style="v" sid="JHN 9:30" />आव आंदरी उत्‍तर कोट्टुन, “ईद रा आश्चर्य अन मात आद कि नीव जानसालीर कि आव येलेव हुन, लेकीन आव नान कण्णगोळी खोल्स बुटुन. <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />नाव जान्सतेव कि परमेश्वर पापीगोळ्द केळालुन, लेकीन अगर यावारा परमेश्वर उन भक्त आन अदिक आऊन इच्छा मा नळुतान, रा आव आऊन केळतान. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />दुनिया अन सुरूवात देल ईद यागलु केळदुर दा बंदिदील कि यावारा जनम इन कुढ्ढ उन कण्णगोळी खोल्सदुन. <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />अगर ईव मंळसा परमेश्वर उन दी टु ईला ईरायदुन, रा येनु भी ईला माळ सकायदुन.” <verse eid="JHN 9:33" /><verse number="34" style="v" sid="JHN 9:34" />आंदुर आऊक उत्‍तर कोट्टुर, “नी रा बिलकुल पापगोळ दा पैदा आग्या, नी नामी येन कल्सत्या?” अदिक आंदुर आऊक व्हार्या तेग्द बुटुर.<verse eid="JHN 9:34" /></para>
  <para style="s">आत्मिक कुढ्ढपन</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />यीशु केळदुन कि आंदुर आऊक व्हार्या तेग्द बुटुर, अदिक याग आऊन से भेंट आत रा अंदुन, “येन नी परमेश्वर उन पार उन मा विश्वास माळत्या?” <verse eid="JHN 9:35" /><verse number="36" style="v" sid="JHN 9:36" />आव उत्‍तर कोट्टुन, “हे प्रभु, आव याव हुन, कि ना आऊन मा विश्वास माळाईन?” <verse eid="JHN 9:36" /><verse number="37" style="v" sid="JHN 9:37" />यीशु आऊन से अंदुन, “नी आऊक नोळ्या, अदिक जो नीन सांगुळ मातगोळी हेळेत्यान आव आवा हुन.” <verse eid="JHN 9:37" /><verse number="38" style="v" sid="JHN 9:38" />आव अंदुन, “हे प्रभु, ना नीन मा विश्वास माळतीन.” अदिक आऊक बांगकु प्रणाम माळदुन. <verse eid="JHN 9:38" /><verse number="39" style="v" sid="JHN 9:39" />आग यीशु अंदुन, “ना ई दुनिया दा न्याय इन साटी बंदीन, ताकी जो नोळालुर आंदुर नोळुल, अदिक जो नोळतार आंदुर कुढ्ढ आगेगुल.” <verse eid="JHN 9:39" /><verse number="40" style="v" sid="JHN 9:40" />जो फरीसी आऊन सांगुळ ईरोर आंदुर आऊन ई मातगोळी केळकु आऊन से अंदुर, “येन नाव भी कुढ्ढ आयेव?” <verse eid="JHN 9:40" /><verse number="41" style="v" sid="JHN 9:41" />यीशु आंदुर से अंदुन, “अगर नीव कुढ्ढ ईरायदीर रा पापी ईला ठहरूसायदीर; लेकीन ईग अनतीर कि नाव नोळतेव, इदुरसाटी नीम दा पाप बन्सकु ईरतद.<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">चरवाहा अदिक म्यांडागोळ्द उदाहरण</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />“ना नीम से खरा खरा अनतीन कि जो यावारा दरवाजा टु म्यांडाशाला दा प्रवेश माळालुन, लेकीन दुसरा दी टु येरतान, आव काल्ळ अदिक डाकू हुन. <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />लेकीन जो दरवाजा टु बुळ्क प्रवेश माळतान आव म्यांडागोळ्द चरवाहा हुन. <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />आऊन साटी चौकीदार दरवाजा खोल्स बुळतान, अदिक म्यांडा आऊन आवाज केळताव, अदिक आव तान म्यांडागोळी हेसुर ताकोम ताकोमकु कारूतान अदिक व्हार्या वोयतान. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />याग आव तान सप्पा म्यांडागोळी व्हार्या तेगु कोमतान, रा अऊर मुंद मुंद नळुतान, अदिक म्यांडागोळ आऊन हिंद हिंद आगेगताव, यतिकी अव आऊन आवाज अरूताव. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />लेकीन अव दुसरा अन हिंद होगतीदील, लेकीन आऊन से दुर ओळेव, यतिकी अव दुसरा अन आवाज अरालव.” <verse eid="JHN 10:5" /><verse number="6" style="v" sid="JHN 10:6" />यीशु आंदुर से ईद उदाहरण अंदुन, लेकीन आंदुर समसीदील कि ईव याता मातगोळ हु जो आव नाम से अनतान.<verse eid="JHN 10:6" /></para>
  <para style="s">यीशु वळ्लेव चरवाहा</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />आग यीशु आंदुर से मात्‍त अंदुन, “ना नीम से खरा खरा अनतीन, म्यांडागोळ दरवाजा ना हुईन. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />यास नान से पयले बंदुर आंदुर सप्पा काल्ळुर अदिक डाकू उर, लेकीन म्यांडागोळ आंदुर्द केळीदील. <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />दरवाजा ना हुईन; अगर यावारा नान द्वारा बुळ्क प्रवेश माळ्यान, रा उद्धार सिक्‍कीत, अदिक बुळ्क व्हार्या होग्त बर्त ईत्‍तान अदिक चारा सिक्‍कीत. <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />काल्ळ यातोदारा क्याल्सा अन साटी ईला लेकीन सिर्फ चोरी माळली अदिक घात माळली अदिक नाश माळली इक बरतान; ना इदुरसाटी बंदीन कि आंदरी जीवन सिक्‍कुल, अदिक हापाळ जीवन सिक्‍कुल.” <figure style="fig" alt="Shepherd with his sheep in sheepfold" file="lb00014c.tif" size="span" loc="10:10" copy="Horace Knowles ©" ref="१०:७">म्यांडा आळसावाळा क्वाटक्या दा म्यांडागोळ्द रखवाली माळतेला</figure><verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />“वळ्लेव चरवाहा ना हुईन; वळ्लेव चरवाहा म्यांडागोळ साटी तान जीव कोळतान. <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />मजदूर जो ना चरवाहा आन अदिक ना म्यांडागोळ मालिक आन, लांडग्या अक बर्त नोळ म्यांडागोळी बिटकु वोळेगतान; अदिक लांडग्या अवरी हुडुतद अदिक तितर बितर माळ बुळतद. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />आव इदुरसाटी वोळेगतान कि आव मजदूर हुन, अदिक आऊक म्यांडागोळ चिंता हैलेच. <verse eid="JHN 10:13" /><verse number="14" style="v" sid="JHN 10:14" /><note caller="+" style="x"><char style="xo" closed="false">१०:१४ </char><char style="xt" closed="false"><ref loc="MAT 11:27">मत्ती ११:२७</ref>; <ref loc="LUK 10:22">लूका १०:२२</ref></char></note>वळ्लेव चरवाहा ना हुईन; ना तान म्यांडागोळी जान्सतीन, अदिक नान म्यांडागोळ नानी जान्सताव. <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />ह्यांग आप्प नानी जान्सतान अदिक ना आप्प उक जान्सतीन अदिक ना म्यांडागोळ साटी तान जीव कोळतीन. <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />नान अदिक भी म्यांडागोळ आव, जो ई म्यांडाशाला अन आल्लच. नानी अवरी भी तरोद जरूरी आद. अव नान आवाज केळेव, आग ऊंद अच झुण्ड अदिक ऊंद अच चरवाहा ईत्‍तान. <verse eid="JHN 10:16" /><verse number="17" style="v" sid="JHN 10:17" />आप्प इदुरसाटी नान से प्यार ईटतान कि ना तान जीव कोळतीन कि अदरी मात्‍त ताकोम कोमाईन. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />याऊ अदरी नान से कसालुन, लेकीन ना अदरी खुद अच कोळतीन. नानी आऊंद कोळोद भी अधिकार आद, अदिक अदरी बाक ताकोम कोमोद भी अधिकार आद: ईद आग्या नान आप्प उन देल नानी सिक्याद.”<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />ई मातगोळ कारण यहूदीगोळ दा मात्‍त फूट बिदोत. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />आंदुर से हापाळ सा लॉकुर अनली कुरतुर, “आऊन दा दुष्टआत्मा आद, अदिक आव येर्र आन; आऊंद येती केळतीर?” <verse eid="JHN 10:20" /><verse number="21" style="v" sid="JHN 10:21" />अन्य लॉकुर अंदुर, “ई मातगोळ ईत्‍ता मंळसा नव आल्लच यारदा दुष्टआत्मा आद. येन दुष्टआत्मा कुढ्ढगोळ कण्णगोळी खोल्स सकतद?”<verse eid="JHN 10:21" /></para>
  <para style="s">यीशु उक नकारसोद</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />यरूशलेम दा स्थापना हाब्ब मनुस्कु आगोद; अदिक सोळ इन दिन ईरव. <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />यीशु मंदिर दा सुलैमान उन छपर्या दा टेटाळोन. <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />आग यहूदीगोळ आऊक बंदकु घेर्सदुर अदिक केळदुर, “नी नाम मन इक यागासताका दुविधा दा ईट्या? अगर नी मसीह हुय रा नाम से साफ साफ अंद बुळ.” <verse eid="JHN 10:24" /><verse number="25" style="v" sid="JHN 10:25" />यीशु आंदरी उत्‍तर कोट्टुन, “ना नीम से अंद बुटीन पर नीव विश्वास अच माळालीर. जो क्याल्सा ना तान आप्प उन हेसुर देल माळतीन अव अच नान गवाह हु, <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />लेकीन नीव इदुरसाटी विश्वास माळालीर यतिकी नीव नान म्यांडागोळ दा टु आल्लच. <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />नान म्यांडागोळ नान आवाज केळताव; ना अवरी जान्सतीन, अदिक अव नान हिंद हिंद नळुताव; <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />अदिक ना अवरी अनन्त जीवन कोळतीन. अव यागलु नाश आगतीदील, अदिक याऊ अवरी नान कय दा टु कसु सकालुन. <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />नान आप्प, याव अवरी नानी कोटान, सप्पा से धोड्डेव आन अदिक याऊ अवरी आप्प उन कय देल कसु सकालुन. <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />ना अदिक नान आप्प ऊंद आयेव.” <verse eid="JHN 10:30" /><verse number="31" style="v" sid="JHN 10:31" />यहूदीगोळ आऊन मा पथराव माळोर साटी मात्‍त कल्लगोळी नेगदुर. <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />इदुर मा यीशु आंदुर से अंदुन, “ना नीमी तान आप्प उन दी टु हापाळ सा भला क्याल्सा तोर्सदीन; अऊर दा टु याता क्याल्सा अन साटी नीव नान मा पथराव माळतीर?” <verse eid="JHN 10:32" /><verse number="33" style="v" sid="JHN 10:33" />यहूदीगोळ आऊक उत्‍तर कोट्टुर, “भला क्याल्सा अन साटी नाव नीन मा पथराव माळालेव लेकीन परमेश्वर उन अपमान माळोद कारण; अदिक इदुरसाटी कि नी मंळसा आगकु भी तान तान इक परमेश्वर माळत्या.” <verse eid="JHN 10:33" /><verse number="34" style="v" sid="JHN 10:34" />यीशु आंदरी उत्‍तर कोट्टुन, “येन नीम व्यवस्था दा लिख्सकु हैलेच, ‘ना अंदीन, नीव मय हुईर?’ <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />अगर आव आंदरी मय अंदुन यार हात्‍ती परमेश्वर उन वचन पोहचुस्त अदिक शास्त्र अन मात ख्वाटा आग सकालव. <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />रा यारी आप्प पवित्र ठहरूस्कु दुनिया दा कळुदुन, नीव आऊन से अनतीर, ‘नी अपमान माळत्या,’ इदुरसाटी कि ना अंदीन, ‘ना परमेश्वर उन पार हुईन?’ <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />अगर ना तान आप्प उन क्याल्सा माळालीन, रा नान विश्वास माळबाळी. <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />लेकीन अगर ना माळतीन, रा चाहे नान विश्वास भी माळबाळी, लेकीन आ क्याल्सागोळ्द रा विश्वास माळी, ताकी नीव जान्सी अदिक समसी कि आप्प नान दा आन अदिक ना आप्प दा आईन.” <verse eid="JHN 10:38" /><verse number="39" style="v" sid="JHN 10:39" />आग आंदुर मात्‍त आऊक हुडोद कोशिश माळदुर लेकीन आव आंदुर कय दा टु होटबुटुन.<verse eid="JHN 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१०:४० </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:28">यूहन्ना १:२८</ref>
      </char>
    </note>बाक आव यरदन इन आप्पाटी आ जागा मा ओळेदुन, यल यूहन्ना पयले बपतिस्मा कोळतोगोन, अदिक अल्या ईत्‍तुन. <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />हापाळ सा लॉकुर आऊन हात्‍ती बंदकु अनतोगोर, “यूहन्ना रा यातोदु चमत्कार तोरसीदील, लेकीन जो येनारा यूहन्ना ईऊंद बारा दा अंदिदुन, अद सप्पा सही ईरोद.” <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />अदिक अल हापाळ सा लॉकुर यीशु मा विश्वास माळदुर.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">लाज़र उन मृत्यु</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">११:१ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:38">लूका १०:३८</ref>,<ref loc="LUK 10:39">३९</ref></char>
    </note>मरियम अदिक आकिन आकतींग मार्था अन्द ऊर बैतनिय्याह अन्द लाज़र हेसुर इन ऊंद मंळसा बिमार ईरोन. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" /><note caller="+" style="x"><char style="xo" closed="false">११:२ </char><char style="xt" closed="false"><ref loc="JHN 12:3">यूहन्ना १२:३</ref></char></note>इक आका मरियम ईरोर यार प्रभु मा अत्‍तर हाक्‍कु आऊन कालगोळी तान चुट्टीगोळ देल सिटीदुर, ईकी नवा वार्ट लाज़र बिमार ईरोन. <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />इदुरसाटी आऊन आकतींगेर यीशु उक बातणी कळुदुर, “हे प्रभु, नोळ, यार से नी प्यार ईटत्या, आव बिमार आन.”<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />ईद केळकु यीशु अंदुन, “ईद बिमारी सायोद आलच; लेकीन परमेश्वर उन महिमा अन्द साटी हुन, कि आऊन द्वारा परमेश्वर उन पार ऊंद महिमा आगुल.”<verse eid="JHN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5" />यीशु मार्था अदिक आकिन आकतींग अदिक लाज़र से प्यार ईटतोगोन. <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />तरी भी याग आव केळदुन कि आव बिमार आन, रा याता जागा मा आव ईरोन, अल येढ्ढ दिन मात्‍त रूकसेदुन. <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />ईदुर बाद्दा आव चेलागोळ से अंदुन, “बरी, नाव मात्‍त यहूदिया नगर इक होगाता.”<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />चेलागोळ यीशु से अंदुर, “हे गुरु, ईगल्या रा यहूदी लॉकुर नीन मा कल्लगोळी होडोद चाहासोर, अदिक येन नी मात्‍त अल्या होगोद चाहासत्या?”<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />यीशु उत्‍तर कोट्टुन, “येन हागुल ईनव हन्नेळ घंटा ईरालव? अगर यावारा हागुल इन होती नळुतान रा ठोकर तिनालुन, यतिकी ई दुनिया अन्द उजुळ नोळतान. <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />लेकीन अगर यावारा ईळ्लक इन होती नळुतान रा ठोकर तिनतान, यतिकी अदुर्दा उजुळ हैलेच.” <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />आव ई मातगोळ अंदुन, अदिक ईदुर बाद्दा आंदुर से अनली कुरतुन, “नाम संगी लाज़र मिंगेग्यान, लेकीन ना आऊक येब्सली होगतीन.”<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />आग चेलागोळ आऊन से अंदुर, “हे प्रभु, अगर आव मिंगेग्यान, रा वळ्लेव आगेदान.” <verse eid="JHN 11:12" /><verse number="13" style="v" sid="JHN 11:13" />यीशु रा आऊन मृत्यु ऊंद बारा दा अंदिदुन, लेकीन आंदरी हिंग हत्‍त कि आव जप देल मिंगोद बारा दा अंदान. <verse eid="JHN 11:13" /><verse number="14" style="v" sid="JHN 11:14" />आग यीशु आंदुर से साफ साफ अंद बुट्टुन, “लाज़र सोतोग्यान; <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />अदिक ना नीम कारण खुश आईन कि ना अल ईला ईरीन यदुर देल नीव विश्वास माळी. लेकीन ईग बरी, नाव आऊन हात्‍ती होगाता.” <verse eid="JHN 11:15" /><verse number="16" style="v" sid="JHN 11:16" />आग थोमा यारी दिदुमुस अनतार, तान साथी चेलागोळ से अंदुन, “बरी, नाव भी आऊन सांगुळ सायली होगाता.”<verse eid="JHN 11:16" /></para>
  <para style="s">यीशु ऊंद पुनरूत्थान अदिक जीवन</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />अल होगदुर मा यीशु उक ईद मालूम आत कि लाज़र उक कब्र दा ईटकु नाक दिन आगेग्याव. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />बैतनिय्याह यरूशलेम इन हात्‍ती येढ्ढ मील इन दुरी मा ईरोद. <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />हापाळ सा यहूदी मार्था अदिक मरियम इन हात्‍ती आकिन वार्ट ऊंद मृत्यु मा शांती कोळोर साटी बंदीदुर.<verse eid="JHN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20" />याग मार्था यीशु ऊंद बरोद समाचार केळदुर रा आऊन से मुलाकात माळली होदुर, लेकीन मरियम मान्या अच ईत्‍तुर. <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />मार्था यीशु से अंदुर, “हे प्रभु, अगर नी ईल ईराईद, रा नान वार्ट ईला सायायदुन. <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />लेकीन ना ईग भी जान्सतीन कि नी जो येनारा परमेश्वर से बेळ्या, परमेश्वर नीनी कोट्टान.”<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />यीशु आकिन से अंदुन, “नीन वार्ट मात्‍त जित्‍ता आदान.”<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />मार्था आऊन से अंदुर, “ना जान्सतीन कि आखरी दिनगोळ दा पुनरूत्थान इन समय आव जित्‍ता आदान.”<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />यीशु आकिन से अंदुन, “पुनरूत्थान अदिक जीवन ना अच हुईन; जो यावारा नान मा विश्वास माळतान आव अगर सोतो भी दान तरी भी जित्‍ता आदान, <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />अदिक जो यावारा जित्‍ता आन अदिक नान मा विश्वास माळतान, आव अनन्त काल ताका सायतीदील. येन नी ई मात मा विश्वास माळत्या?”<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />आक आऊन से अंदुर, “हव हे प्रभु, ना विश्वास माळतीन कि परमेश्वर उन पार मसीह जो दुनिया दा बरावाळा ईरोन, आव नी अच हुय.”<verse eid="JHN 11:27" /></para>
  <para style="s">यीशु वर्लदुन</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />ईद अनकु आक होटोदुर, अदिक तान आकतींग मरियम इक कारूकु सुंगासुंग अंदुर, “गुरु ईवा हुन अदिक नीनी कारूतान.” <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />ईद केळ्त अच आक तुरन्त यदकु आऊन हात्‍ती बंदुर. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />यीशु ईगल्या ऊर दा बरली इक ईरोन लेकीन अदा जागा मा ईरोन यल मार्था आऊन से मुलाकात माळीदुर. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />आग जो यहूदी आऊन सांगुळ मान्या ईरोर अदिक आऊक शांती कोळोर, ईद नोळकु कि मरियम तुरन्त यदकु व्हार्या होग्यार आंदुर ईद सम्सदुर कि आक कब्र मा वर्ली होगेत्यार, रा आकिन हिंद आगेदुर.<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />याग मरियम अल पोहचुसदुर यल यीशु ईरोन, रा आऊक नोळ्त अच आऊन कालगोळ मा बिदोदुर अदिक अंदुर, “हे प्रभु, अगर नी ईल ईराईद रा नान वार्ट ईला सायायदुन.”<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />याग यीशु आक इक अदिक आ यहूदीगोळी जो आकिन सांगुळ बंदीदुर, वर्लतेला नोळदुन, रा तान आत्मा दा हापाळ अच उदास अदिक व्याकुल आदुन, <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />अदिक अंदुन, “नीव आऊक यल ईटीर?”</para>
  <para style="p" vid="JHN 11:34">आंदुर आऊन से अंदुर, “हे प्रभु, नळुकु नोळ कोम.”<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />यीशु वर्लदुन. <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />आग यहूदी अनली हतदुर, “नोळी, आव आऊन से याट प्यार ईटतान.”<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />लेकीन आंदुर दा टु थ्वाळासा यहूदीगोळ अंदुर, “येन ईव याव कुढ्ढ मंळसा अन्द कण्णगोळ तेरदुन, येन ईद भी माळ सकिदील कि ई मंळसा ईला सायायदुन?”<verse eid="JHN 11:37" /></para>
  <para style="s">यीशु लाज़र उक जित्‍ता माळदुन</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />यीशु तान मन दा मात्‍त हापाळ अच उदास आगकु कब्र मा बंदुन. अद ऊंद गुफा ईरोद अदिक ऊंद कल्ल आ गुफा मा ईटकु ईरोद. <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />यीशु अंदुन, “कल्ल सरकुसी.”</para>
  <para style="p" vid="JHN 11:39">जो सोतकु ईरोन आऊन आकतींग मार्था आऊन से अनली हतदुर, “हे प्रभु, आऊन दा टु ईग वास बरतद, यतिकी आऊक सोतकु नाक दिन आगेग्याव.”<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />यीशु आकिन से अंदुन, “येन ना नीन से ईला अंदिदीन कि अगर नी विश्वास माळ्या, रा परमेश्वर ऊंद महिमा अक नोळ्या.” <verse eid="JHN 11:40" /><verse number="41" style="v" sid="JHN 11:41" />आग आंदुर आ कल्ल इक सरकुसदुर. यीशु तान कण्णगोळ नेगुकु अंदुन, “हे आप्पा, ना नींद धन्यवाद माळतीन कि नी नांद केळ कोंड्या. <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />ना जानसीन कि नी हमेशा नांद केळत्या, लेकीन जो भीळ आसपास निदुरकु आद, आंदुर कारण ना हिंग अंदीन, यदुर देल कि आंदुर विश्वास माळुल कि नी नानी कळ्या.” <verse eid="JHN 11:42" /><verse number="43" style="v" sid="JHN 11:43" />ईद अंदकु आव धोळ्द आवाज देल कारदुन, “हे लाज़र, व्हार्या बा!” <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />जो सोतोगिदुन आव कब्र दा टु ह्यांग आऊनव कय काल कटकु ईरव हांगा व्हार्या बंदुन, अदिक आऊन बाय गमछा देल होचकु ईरोद. यीशु आंदुर से अंदुन, “आऊक तेरू बुळी अदिक होगगोळी.”<verse eid="JHN 11:44" /></para>
  <para style="s">यीशु उन खिलाप साजीश</para>
  <para style="r">(<ref loc="MAT 26:1-5">मत्ती २६:१-५</ref>; <ref loc="MRK 14:1">मरकुस १४:१</ref>,<ref loc="MRK 14:2">२</ref>; <ref loc="LUK 22:1">लूका २२:१</ref>,<ref loc="LUK 22:2">२</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />आग जो यहूदी मरियम इन हात्‍ती बंदीदुर अदिक यीशु उन ईद क्याल्सा नोळीदुर, आंदुर दा टु हापाळ मुंदुर आऊन मा विश्वास माळदुर. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />लेकीन आंदुर दा टु थ्वाळासा यहूदीगोळ फरीसीगोळ्द हात्‍ती होगकु यीशु उन क्याल्सागोळ्द बातणी कोट्टुर. <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />ईदुर मा प्रधान याजकगोळ अदिक फरीसीगोळ महासभा कार्सदुर, अदिक अंदुर, “नाव येन माळेतेव? ई मंळसा रा हापाळ चमत्कार तोर्सतान. <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />अगर नाव आऊक हिंग अच बिट बुटेव, रा सप्पा आऊन मा विश्वास माळ कोंडार, अदिक रोमी साम्राज्य अन्द लॉकुर बंदकु नाम जागा अदिक जाती येढ्ढु मा अधिकार माळ कोंडार.”<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />आग आंदुर दा टु कैफा हेसुर ईनव ऊंद मंळसा जो आ वर्ष ईनव महायाजक ईरोन, आंदुर से अंदुन, “नीव येनु अच जानसालीर; <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />अदिक ना नीमी ईद ऊम्सतद कि नीम साटी ईद वळ्लीद आद कि नाम लॉकुर्द साटी ऊंद मंळसा सायुल, अदिक सप्पा जाती इन नाश आगबाळुल.” <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />ईद मात आव तान दी टु अंदिदील, लेकीन आ वर्ष इन महायाजक आगकु भविष्यवाणी माळदुन, कि यीशु आ जाती इन साटी सोत्‍तान; <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />अदिक ना सिर्फ आ जाती इन साटी, उलटा इदुरसाटी भी कि परमेश्वर उन जो तितर-बितर औलाद आव अवरी ऊंद माळ सकुल.<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />इदुरसाटी अदा दिन टु आंदुर आऊक कोंद बुळोद साजीश माळली कुरतुर. <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />इदुरसाटी यीशु आ समय टु यहूदीगोळ दा प्रगट आगकु टेटीदिल, लेकीन अल टु आळी इन हात्‍तीपास इन प्रदेश इन इफ्राईम हेसुर इन ऊंद नगर इक होटोदुन; अदिक तान चेलागोळ्द सांगुळ अल्या ईरली कुरतुन.<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />यहूदीगोळ्द फसह अन्द हाब्ब हात्‍ती ईरोद, अदिक हापाळ सा लॉकुर फसह से पयले देहात टु यरूशलेम इक होदुर कि तान तान इक शुद्ध माळुल. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />इदुरसाटी आंदुर यीशु उक ढुंढ्सली हतदुर अदिक मंदिर दा निदुरकु आपस दा अनली हतदुर, “नीव येन सोचतीर? येन आव हाब्ब दा बरतीदील?” <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />प्रधान याजकगोळ अदिक फरीसीगोळ ईद आदेश कोटकु ईटीदुर कि यावारा यीशु उक नोळुल रा खबर कोळुल, कि आंदुर आऊक हुडु सकुल.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">यीशु उन कालगोळ मा अत्‍तर हाक्‍कोद</para>
  <para style="r">(<ref loc="MAT 26:6-13">मत्ती २६:६-१३</ref>; <ref loc="MRK 14:3-9">मरकुस १४:३-९</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />यीशु फसह हाब्ब इन आर दिन पयले बैतनिय्याह दा बंदुन यल लाज़र ईरोन, यारी यीशु सोत्‍तुर दा टु जित्‍ता माळीदुन. <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />अल आंदुर आऊन साठी भोजन तयार माळदुर; अदिक मार्था स्यावा माळोर, अदिक लाज़र आंदुर दा टु ऊंद ईरोन जो आऊन सांगुळ भोजन माळली कुरतीदुन. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" /><note caller="+" style="x"><char style="xo" closed="false">१२:३ </char><char style="xt" closed="false"><ref loc="LUK 7:37">लूका ७:३७</ref>,<ref loc="LUK 7:38">३८</ref></char></note>आग मरियम जटामांसी इन आर्धा लीटर किमती शुद्ध अत्‍तर तनकु यीशु उन कालगोळ मा हाकदुर, अदिक तान चुट्टीगोळ देल आऊन काल सिटदुर; अदिक अत्‍तर इन वास देल सप्पा मान्ना सुगन्धित आगेत. <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />लेकीन आऊन चेलागोळ दा टु यहूदा इस्करियोती हेसुर ईनव ऊंद चेला जो आऊक हुळसुसदुर मा ईरोन, अनली कुरतुन, <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />“ईद अत्‍तर मुर सौ दीनार दा मारकु कंगालगोळी येती कोटकु आगीदील?” <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />आव ईद मात इदुरसाटी अंदिदील कि आऊक कंगालगोळ्द चिन्ता ईरोद लेकीन इदुरसाटी कि आव काळ्ल ईरोन, अदिक आऊन हात्‍ती आंदुर्द झ्वारा ईरतोगोद अदिक अदुर्दा जो येनारा भी हाक्‍कु आगतोगोद, आव तेगु कोम तोगोन. <figure style="fig" alt="Alabaster jars" file="hk00142c.tif" size="col" copy="Horace Knowles ©" ref="१२:३">संगमरमर इन बर्तन</figure><verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />यीशु अंदुन, “आऊक ईरगोळी. आऊक ईद नांद नळसा दिशी इन साठी ईटगोळी. <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />यतिकी कंगाल रा नीम सांगुळ सदा ईरतार, लेकीन ना नीम सांगुळ सदा ईरतीदील.”<verse eid="JHN 12:8" /></para>
  <para style="s">लाज़र इन विरूद्ध साजीश</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />याग यहूदीगोळ्द धोळ्द भीळ जान्सेत कि आव अल आन, रा आंदुर ना सिर्फ यीशु उन कारण बंदुर लेकीन इदुरसाटी भी कि लाज़र उक नोळुल, यारी आव सोत्‍तुर दा टु जित्‍ता माळदुन. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />आग प्रधान याजकगोळ लाज़र उक भी कोंद बुळोद साजीश रचुसदुर. <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />यतिकी आऊन कारण हापाळ सा यहूदी होटोदुर अदिक यीशु मा विश्वास माळदुर.<verse eid="JHN 12:11" /></para>
  <para style="s">यरूशलेम दा विजय-प्रवेश</para>
  <para style="r">(<ref loc="MAT 21:1-11">मत्ती २१:१-११</ref>; <ref loc="MRK 11:1-11">मरकुस ११:१-११</ref>; <ref loc="LUK 19:28-40">लूका १९:२८-४०</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />दुसरा दिशी हापाळ सा लॉकुर जो हाब्ब दा बंदीदुर ईद केळदुर कि यीशु यरूशलेम दा बरेत्यान. <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />इदुरसाटी आंदुर खजुर इन डगालगोळी हुळदुर अदिक आऊन से भेंट माळोर साठी होट्टुर, अदिक कारूली कुरतुर, “होशाना<note caller="+" style="f"><char style="fr" closed="false">१२:१३ </char><char style="ft" closed="false">प्रभु अन्द जय</char></note>! धन्य इस्त्राएल ईनव राजा, जो प्रभु उन हेसुर देल बरतान.”<verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />याग यीशु उक गधा अन्द पाड्डा सिक्त; रा आव अदुर मा कुरतुन, ह्यांग शास्त्र दा लिख्सकु आद,<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />“हे सिय्योन इन पोरी, अंजबाळ;</para>
  <para style="q1" vid="JHN 12:15">नोळ, नीन राजा</para>
  <para style="q2" vid="JHN 12:15">गधा अन्द पाड्डा मा येरकु नीन हात्‍ती बरेत्यान.”<verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />आऊन चेलागोळ ई मातगोळी पयले सम्स सकिदील, लेकीन याग यीशु उन महिमा प्रगट आत रा आंदरी याद बत्‍त कि ई मातगोळ आऊन बारा दा लिख्सकु ईरोव अदिक लॉकुर आऊन से ईदा प्रकार इन व्यवहार माळीदुर. <verse eid="JHN 12:16" /><verse number="17" style="v" sid="JHN 12:17" />आग भीळ इन आ लॉकुर गवाही कोट्टुर, जो आ समय आऊन सांगुळ ईरोर याग आव लाज़र उक कब्र दा टु कारूकु सोत्‍तुर दा टु जित्‍ता माळदुन. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />ईदा कारण लॉकुर आऊन से मुलाकात माळली बंदीदुर यतिकी आंदुर केळीदुर कि आव ईद आश्चर्यकर्म तोरस्यान. <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />आग फरीसीगोळ आपस दा अंदुर, “सोची रा सही कि नीम से येनु बनसाल. नोळी, दुनिया आऊन हिंद आगेत्याद.”<verse eid="JHN 12:19" /></para>
  <para style="s">गैरयहूदीगोळ्द यीशु उक ढुंढसोद</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />जो लॉकुर आ हाब्ब दा आराधना माळली बंदीदुर आंदुर दा टु येनारा गैरयहूदी ईरोर. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />आंदुर गलील इन बैतसैदा नोर ईरावाळेर फिलिप्पुस उन हात्‍ती बंदकु आऊन से विनती माळदुन, “श्रीमान, नाव यीशु से मुलाकात माळोद चाहासतेव.”<verse eid="JHN 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22" />फिलिप्पुस बंदकु अन्द्रियास से अंदुन, आग अन्द्रियास अदिक फिलिप्पुस होगकु यीशु से अंदुन. <verse eid="JHN 12:22" /><verse number="23" style="v" sid="JHN 12:23" />ईदुर मा यीशु आंदुर से अंदुन, “आ समय होट बंदाद कि मंळसा अन पार उन महिमा आगुल. <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />ना नीम से खरा खरा अनतीन कि यागासताका गोदी इन बींजा जमीन मा बिदकु सोतोगाल, अद आबना ईरतद; लेकीन याग सोतोगतद, रा हापाळ फसल तरतद. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" /><note caller="+" style="x"><char style="xo" closed="false">१२:२५ </char><char style="xt" closed="false"><ref loc="MAT 10:39">मत्ती १०:३९</ref>; <ref loc="MAT 16:25">१६:२५</ref>; <ref loc="MRK 8:35">मरकुस ८:३५</ref>; <ref loc="LUK 9:24">लूका ९:२४</ref>; <ref loc="LUK 17:33">१७:३३</ref></char></note>जो तान जीव इक प्रिय जान्सतान, आव अदरी खोऊस बुळतान; अदिक जो ई दुनिया दा तान जीव इक अप्रिय जान्सतान, आव अनन्त जीवन इन साठी अदुर्द रक्षा माळ्यान. <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />अगर यावारा नान स्यावा माळ्यान, रा नान हिंद आगेगुल; अदिक यल ना आईन, अल नान सेवक भी ईत्‍तान. अगर यावारा नान स्यावा माळ्यान, रा नान आप्प आऊन आदर माळ्यान.<verse eid="JHN 12:26" /></para>
  <para style="s">क्रूस इन मृत्यु इन इशारा</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />“ईग नान जीव व्याकुल आद. इदुरसाटी ईग ना येन अनाईन, ‘हे आप्पा, नानी ई घळी देल ऊळ्स?’ ईला, यतिकी ना ईदा कारण ई घळी इक पोहचुसीन. <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />हे आप्पा, तान हेसुर इन महिमा माळ.”</para>
  <para style="p" vid="JHN 12:28">“आग ईद आकाशवाणी आत, ना आऊंद महिमा माळीन, अदिक मात्‍त माळाईन.”<verse eid="JHN 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29" />आग जो लॉकुर निदुरकु केळोर आंदुर अंदुर कि बादल गरजुस्त. दुसरागोळ अंदुर, येनारा स्वर्गदूत आऊन से माताळदुन.<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />ईदुर मा यीशु अंदुन, “ईद आवाज नान साटी ईला, लेकीन नीम साटी बंदाद. <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />ईग ई दुनिया अन न्याय आगतद, ईग ई दुनिया अन सरदार तेगुकु आदान; <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />अदिक ना अगर पृथ्वी मा टु म्याकुच येर्सकु आगाईन, रा सप्पा मुंदुरी तान हात्‍ती जेडाईन.” <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />हिंग अंदकु आव ईद प्रगट माळ बुट्टुन कि आव ह्यांग मृत्यु देल सोत्‍तान.<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />इदुर मा लॉकुर आऊन से अंदुर, “नाव व्यवस्था अन्द ईद मात केळेव कि मसीह हमेशा ईत्‍तान, बाक नी येती अनत्या कि मंळसा अन्द पार उक म्याकुच येरसोद जरूरी आद? ईव मंळसा अन पार याव हुन?”<verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />यीशु आंदुर से अंदुन, “ज्योति ईग थ्वाळासा देर ताका नीम बीच दा आद. यागासताका ज्योति नीम सांगुळ आद आगासताका नळुतेला ईरी, हिंग आगबाळुल कि अंधकार नीमी बंदकु घेर्सुल; जो अंधकार दा नळुतान आव जानसालुन कि यात्‍त होगतान. <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />यागासताका ज्योति नीम सांगुळ आद, ज्योति मा विश्वास माळी ताकी नीव ज्योति अन औलाद आगी.”</para>
  <para style="s" vid="JHN 12:36">यहूदीगोळ अविश्वास दा बन्सकु ईरेतीर</para>
  <para style="p" vid="JHN 12:36">ईव मातगोळी अंदकु यीशु ओळेदुन अदिक आंदुर से होचकु ईत्‍तुन <verse eid="JHN 12:36" /><verse number="37" style="v" sid="JHN 12:37" />आव आंदुर मुंद ईस चमत्कार<note caller="+" style="f"><char style="fr" closed="false">१२:३७ </char><char style="fq" closed="false">चमत्कार </char></note> तोर्सदुन, तरी आंदुर आऊन मा विश्वास माळीदिल; <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />ताकी यशायाह भविष्यवक्ता अन्द वचन पुरा आगुल जो आव अंदुन:</para>
  <para style="q1" vid="JHN 12:38">“हे प्रभु, नाम बातणी इन याव विश्वास माळ्यान?</para>
  <para style="q2" vid="JHN 12:38">अदिक प्रभु अन्द ताकत यार मा प्रगट आग्याद?”<verse eid="JHN 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39" />ई कारण आंदुर विश्वास माळ सकिदील, यतिकी यशायाह ईद भी अंदान:<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />“आव आंदुर कण्णगोळी कुढ्ढ,</para>
  <para style="q2" vid="JHN 12:40">अदिक आंदुर मन कठोर माळ बुटुन;</para>
  <para style="q1" vid="JHN 12:40">येल्यारा हिंग आगबाळुल कि आंदुर कण्णगोळ देल नोळुल,</para>
  <para style="q2" vid="JHN 12:40">अदिक मन देल समसुल,</para>
  <para style="q2" vid="JHN 12:40">अदिक तिर्गुल,</para>
  <para style="q2" vid="JHN 12:40">अदिक ना आंदरी चंगा माळाईन.”<verse eid="JHN 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41" />यशायाह ई मातगोळी इदुरसाटी अंदुन कि आव आऊन महिमा नोळदुन, अदिक आव आऊन बारा दा मातगोळी हेळदुन.<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />तरी अधिकारीगोळ दा टु हापाळ लॉकुर आऊन मा विश्वास माळदुर, लेकीन फरीसीगोळ कारण प्रगट दा ईला मानसोर, येल्यारा हिंग आगबाळुल कि आंदुर यहूदी लॉकुर्द सभागृह दा टु तेगुकु आदार: <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />यतिकी मंळसागोळ दी टु प्रशंसा आंदरी परमेश्वर उन दी टु प्रशंसा अन्द अपेक्षा यक्कुल प्रिय हततोगोद.<verse eid="JHN 12:43" /></para>
  <para style="s">यीशु नव वचन: न्याय इन आधार</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />यीशु कारूकु अंदुन, “जो नान मा विश्वास माळतान, आव नान मा ईला उलटा नान कळावाळा मा विश्वास माळतान. <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />अदिक जो नानी नोळतान, आव नान कळावाळा अक नोळतान. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />ना दुनिया दा ज्योति आगकु बंदीन, ताकी जो यावारा नान मा विश्वास माळुल आव अंधकार दा ईरबाळुल. <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />अगर यावारा नान मातगोळी केळकु मान्सालुन, रा ना आऊक दोषी ठहरूसालीन; यतिकी ना दुनिया अक दोषी ठहरूसोर साटी ईला, लेकीन दुनिया अन्द उद्धार माळोर साटी बंदीन. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />जो नानी तुच्छ जानस्तान अदिक नान मातगोळी ग्रहण माळालुन आऊक दोषी ठहरूसावाळा रा ऊंद आन: मतलब जो वचन ना अंदीन, अदा हिंदळोव दिन दा आऊक दोषी ठहरूसीत. <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />यतिकी ना तान दी टु मातगोळी माळीदिल; लेकीन आप्प याव नानी कळ्यान आवा नानी आग्या कोटान कि येन येन अनाईन अदिक येन येन माताळाईन? <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />अदिक ना जान्सतीन कि आऊन आग्या अनन्त जीवन आद. इदुरसाटी ना जो येनारा माताळतीन, अद ह्यांग आप्प नान से अंदान हांगा माताळतीन.”<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">यीशु उन चेलागोळ्द काल तोळोद</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />फसह इन हाब्ब से पयले, याग यीशु जान्स कोंडुन कि नांद आ घळी होट्ट बंदाद कि दुनिया बिटकु आप्प उन हात्‍ती होगाईन, रा तान लॉकुर से जो दुनिया दा ईरोर ह्यांग प्यार आव ईटतोगोन, आखरी ताका हांग अच प्यार ईटतेला ईत्‍तुन. <verse eid="JHN 13:1" /><verse number="2" style="v" sid="JHN 13:2" />याग शैतान शमौन उन पार यहूदा इस्करियोती इन मन दा ईद हाक बुटीदुन कि आऊक हुळसुसुल, रा भोजन इन समय <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />यीशु, ईद जान्सकु कि आप्प सप्पा येनारा नांद कय दा माळ बुटान अदिक ना परमेश्वर उन हात्‍ती टु बंदीन अदिक परमेश्वर उन हात्‍ती होगतीन, <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />भोजन मा टु यदकु तान म्याकळव कपळागोळी ईळ्स बुट्टुन, अदिक गमछा हुडुकु तान नेळु कटदुन. <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />आग बरतन दा नीर तुमकु चेलागोळ्द काल तोळुली अदिक याता गमछा देल आऊन नेळु कटकु ईरोद अदुर देल अच सीटली कुरतुन. <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />याग आव शमौन पतरस उन हात्‍ती बंदुन, आग पतरस आऊन से अंदुन, “हे प्रभु, येन नी नांद काल तोळुत्या?” <verse eid="JHN 13:6" /><verse number="7" style="v" sid="JHN 13:7" />यीशु आऊक उत्‍तर कोट्टुन, “जो ना माळतीन, नी अदरी ईगल्या जान्साल, लेकीन ईदुर बाद्दा नीनी ऊमसीत.” <verse eid="JHN 13:7" /><verse number="8" style="v" sid="JHN 13:8" />पतरस आऊन से अंदुन, “नी नान काल यागलु तोळु सकतीदिल!” ईद केळकु यीशु आऊन से अंदुन, “अगर ना नीन काल तोळुतीदिल, रा नांद सांगुळ नींद येनु संबंध हैलेच.” <verse eid="JHN 13:8" /><verse number="9" style="v" sid="JHN 13:9" />शमौन पतरस आऊन से अंदुन, “हे प्रभु, रा बाक नान काल अच ईला, उलटा कय अदिक ताल्ला भी तोळु कोळ.” <verse eid="JHN 13:9" /><verse number="10" style="v" sid="JHN 13:10" />यीशु आऊन से अंदुन, “जो मय तोळु कोंडान आऊक काल इन अलावा अदिक येनु तोळोद जरवत हैलेच, लेकीन आव बिलकुल शुद्ध आन; अदिक नीव शुद्ध आईर, लेकीन सप्पा अन्द सप्पा मुंदुर ईला.” <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />आव रा तान हुळसुसावाळा अक अरोन इदुरसाटी आव अंदुन, “नीव सप्पा मुंदुर शुद्ध हैलेच.” <verse eid="JHN 13:11" /><verse number="12" style="v" sid="JHN 13:12" /><note caller="+" style="x"><char style="xo" closed="false">१३:१२ </char><char style="xt" closed="false"><ref loc="LUK 22:27">लूका २२:२७</ref></char></note>याग आव आंदुर काल तोळ्द बुट्टुन, अदिक तान कपळा हाक्‍कु मात्‍त कुरतोदुन, रा आंदुर से अनली कुरतुन, “येन नीव सम्सदीर कि ना नीम सांगुळ येन माळदीन? <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />नीव नानी गुरु अदिक प्रभु अनकु कारूतीर, अदिक ठीक अच अनतीर, यतिकी ना आवा हुईन. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />अगर ना प्रभु अदिक गुरु ईतकु नीम काल तोळदिन, रा नीमी भी आबुर दाबुर काल तोळु पायजे. <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />यतिकी ना नीमी नमुना तोर्स बुटीन कि ह्यांग ना नीम सांगुळ माळदीन, नीव भी हांग अच माळतोगी. <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" /><note caller="+" style="x"><char style="xo" closed="false">१३:१६ </char><char style="xt" closed="false"><ref loc="MAT 10:24">मत्ती १०:२४</ref>; <ref loc="LUK 6:40">लूका ६:४०</ref>; <ref loc="JHN 15:20">यूहन्ना १५:२०</ref></char></note>ना नीम से खरा खरा माताळतीन, दास तान स्वामी देल धोड्डेव हैलेच, अदिक ना कळुदव तान कळावाळा से. <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />नीव ई मातगोळ जान्सतीर, अदिक अगर अऊर मा नळी रा धन्य आईर. <verse eid="JHN 13:17" /><verse number="18" style="v" sid="JHN 13:18" />ना नीम सप्पा मुंदुर बारा दा अनालीन; यार्द ना चुनाव माळीन, आंदरी ना अरूतीन; लेकीन ईद इदुरसाटी हुन कि पवित्रशास्त्र अन्द अद वचन पुरा आगुल, ‘जो नांद रोट्टी तिनतान, आव नान मा ल्यात नेगदुन.’ <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />ईग ना अदुर आगोर से पयले नीमी हेळ बुळतीन कि याग ईद पुरा आगेदीत रा नीव विश्वास माळेतीर कि ना आवा हुईन. <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" /><note caller="+" style="x"><char style="xo" closed="false">१३:२० </char><char style="xt" closed="false"><ref loc="MAT 10:40">मत्ती १०:४०</ref>; <ref loc="MRK 9:37">मरकुस ९:३७</ref>; <ref loc="LUK 9:48">लूका ९:४८</ref>; <ref loc="LUK 10:16">१०:१६</ref></char></note>ना नीम से खरा खरा माताळतीन कि जो नानी कळावाळा अक ग्रहण माळतान, आव नानी ग्रहण माळतान; अदिक जो नानी ग्रहण माळतान, आव नानी कळावाळा अक ग्रहण माळतान.”<verse eid="JHN 13:20" /></para>
  <para style="s">यीशु अन विश्वासघात माळावाळा अन दी इशारा</para>
  <para style="r">(<ref loc="MAT 26:20-25">मत्ती २६:२०-२५</ref>; <ref loc="MRK 14:17-21">मरकुस १४:१७-२१</ref>; <ref loc="LUK 22:21-23">लूका २२:२१-२३</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />ई मातगोळ अंदकु यीशु आत्मा दा व्याकुल आदुन अदिक ईद गवाही कोट्टुन, “ना नीम से खरा खरा अनतीन कि नीम दा टु ऊंद मंळसा नानी हुळसुस्यान.” <verse eid="JHN 13:21" /><verse number="22" style="v" sid="JHN 13:22" />चेलागोळ संदेह देल, आबुर दाबुर दी नोळली कुरतुर कि आव यार बारा दा अनेत्यान. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />आऊन चेलागोळ दा टु ऊंद यार से यीशु प्यार ईटतोगोन, यीशु उन याद्दा अन्द दी बांगकु कुर्तकु ईरोन. <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />शमौन पतरस आऊन दी इशारा माळकु आऊन से केळदुन, “रा हेळ, आव यार बारा दा अनेत्यान?” <verse eid="JHN 13:24" /><verse number="25" style="v" sid="JHN 13:25" />आग आव हांग अच यीशु उन याद्दा अन्द दी बांगकु आऊन से केळदुन, “हे प्रभु, आव याव हुन?” <verse eid="JHN 13:25" /><verse number="26" style="v" sid="JHN 13:26" />यीशु उत्‍तर कोट्टुन, “यारी ना ईद रोट्टी इन तुकळा तंळग्या दा डोब्सकु कोळाईन आवा हुन.” अदिक आव तुकळा डोब्सकु शमौन इस्करियोती इन पार यहूदा अक कोट्टुन. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />तुकळा ताकोम्त अच शैतान आऊन दा समुसेत. आग यीशु आऊन से अंदुन, “जो नी माळत्या, तुरन्त माळ.” <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />लेकीन कुरावाळेर दा टु यावारा भी जान्सीदिल कि आव ईद मात आऊन से यदुर साठी अंदुन. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />यहूदा अन्द हात्‍ती झ्वारा ईरतोगोद, इदुरसाटी यारारा यारारा सम्सदुर कि यीशु आऊन से अनेत्यान कि जो येनारा नामी हाब्ब इन साठी पायजे अद कोंड कोम, या ईद कि कंगालगोळी येनारा कोळ. <verse eid="JHN 13:29" /><verse number="30" style="v" sid="JHN 13:30" />इदुरसाटी आव तुकळा हुळकु तुरन्त व्हार्या होटोदुन; अदिक ईद ईळ्लक इन समय ईरोद.<verse eid="JHN 13:30" /></para>
  <para style="s">व्हाशोद आग्या</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />याग आव व्हार्या होटोदुन रा यीशु अंदुन, “ईग मंळसा अन पार उन महिमा आग्याद, अदिक परमेश्वर उन महिमा आऊन दा आग्याद; <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />अगर परमेश्वर उन महिमा आऊन द्वारा आत, रा परमेश्वर भी तान द्वारा आऊन महिमा प्रगट माळ्यान अदिक तुरन्त माळ्यान. <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" /><note caller="+" style="x"><char style="xo" closed="false">१३:३३ </char><char style="xt" closed="false"><ref loc="JHN 7:34">यूहन्ना ७:३४</ref></char></note>हे चिकोरगोळा, ना मात्‍त घळी तिम नीम हात्‍ती आईन: बाक नीव नानी ढुंढसीर, अदिक ह्यांग ना यहूदीगोळ से अंदीन, ‘यल ना होगतीन अल नीव बर सकालीर,’ हांग अच ना ईग नीम से भी अनतीन. <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" /><note caller="+" style="x"><char style="xo" closed="false">१३:३४ </char><char style="xt" closed="false"><ref loc="JHN 15:12">यूहन्ना १५:१२</ref>,<ref loc="JHN 15:17">१७</ref>; <ref loc="1JN 3:23">१ यूहन्ना ३:२३</ref>; <ref loc="2JN 1:5">२ यूहन्ना १:५</ref></char></note>ना नीमी ऊंद व्हाशोद आग्या कोळतीन कि आबुर दाबुर से प्यार ईटी; ह्यांग ना नीम से प्यार ईटीन, हांग अच नीव भी आबुर दाबुर से प्यार ईटी. <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />अगर नीव आपस दा प्यार ईट्टीर, रा ईदुर देल सप्पा मुंदुर जानस्यार कि नीव नांद चेलागोळ हुईर.”<verse eid="JHN 13:35" /></para>
  <para style="s">यीशु उन द्वारा पतरस उन इनकार इन इशारा</para>
  <para style="r">(<ref loc="MAT 26:31-35">मत्ती २६:३१-३५</ref>; <ref loc="MRK 14:27-31">मरकुस १४:२७-३१</ref>; <ref loc="LUK 22:31-34">लूका २२:३१-३४</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />शमौन पतरस यीशु से अंदुन, “हे प्रभु, नी यल होगत्या?” यीशु उत्‍तर कोट्टुन, “यल ना होगतीन अल नी ईगल्या नान हिंद बर सकाल; लेकीन बाद्दा नी नान हिंद बंद्या.” <verse eid="JHN 13:36" /><verse number="37" style="v" sid="JHN 13:37" />पतरस आऊन से अंदुन, “हे प्रभु, ईगल्या ना नीन हिंद येती बर सकालीन? ना रा नीन साठी तान जीव भी कोट्ट बुळाईन.” <verse eid="JHN 13:37" /><verse number="38" style="v" sid="JHN 13:38" />यीशु उत्‍तर कोट्टुन, “येन नी नान साठी तान जीव कोट्या? ना नीन से खरा खरा माताळतीन कि हुंज कुग्गोर से पयले ताका नी नांद मुर घन इनकार माळ कोंड्या.<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">परमेश्वर ताका होगोद हादी</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />“नीम मन व्याकुल आगबाळुल; परमेश्वर मा विश्वास ईटी अदिक नान मा भी विश्वास ईटी. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />नान आप्प उन मान्या हापाळ सा ईरोद जागा आद, अगर ईला ईराईत रा ना नीम से अनबुळायदिन; यतिकी ना नीम साटी जागा तयार माळली होगतीन. <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />अदिक अगर ना होगकु नीम साटी जागा तयार माळाईन, रा बाक बंदकु नीमी तान मान्या ओयाईन कि ना यल इराईन नीव भी अल ईरी. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />ना यल होगतीन नीव अल ईद हादी अरूतीर.” <verse eid="JHN 14:4" /><verse number="5" style="v" sid="JHN 14:5" />थोमा आऊन से अंदुन, “हे प्रभु, नाव ईद अरालेव कि नी यल होगेत्या; रा हादी ह्यांग अरतेव?” <verse eid="JHN 14:5" /><verse number="6" style="v" sid="JHN 14:6" />यीशु आऊन से अंदुन, “हादी अदिक सच्चाई अदिक जीवन ना अच हुईन; बिना नान द्वारा याऊ आप्प उन हात्‍ती होग सकालुन. <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />आव आंदुर से अंदुन अगर नीव नानी अर्त कोमायदीर, रा नान आप्प उक भी अरायदिर; अदिक ईग आऊक अरूतीर, अदिक आऊक नोळीर भी.”<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />फिलिप्पुस आऊन से अंदुन, “हे प्रभु, आप्प उक नामी तोर्स बुळ, ईदा नाम साटी हापाळ आद.” <verse eid="JHN 14:8" /><verse number="9" style="v" sid="JHN 14:9" />यीशु आऊन से अंदुन, “हे फिलिप्पुस, ना ईस दिन टु नीम सांगुळ आईन, अदिक येन नी नानी जान्साल? याव नानी नोळ्यान आव आप्प उक नोळ्यान. नी येती अनत्या कि आप्प उक नामी तोर्स?” <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />येन नी विश्वास माळाल कि ना आप्प दा आईन अदिक आप्प नान दा आन? ई मातगोळी जो ना नीम से अनतीन, तान दी टु अनालीन, लेकीन आप्प नान दा ईतकु तान क्याल्सा माळतान. <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />नान विश्वास माळी कि ना आप्प उन दा आईन अदिक आप्प नान दा आन; ईदारा क्याल्सागोळ्द अच कारण नान विश्वास माळी. <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />“ना नीम से खरा खरा अनतीन कि जो नान मा विश्वास ईटतान, ई क्याल्सा जो ना माळतीन आव भी माळ्यान, बल्‍की ईऊर से भी धोड्डेव क्याल्सा माळ्यान, यतिकी ना आप्प उन हात्‍ती होगतीन. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />जो येनारा नीव नान हेसुर देल बेळीर, अदा ना माळाईन कि पार उन दरवाजा मा आप्प उन महिमा आगुल. <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />अगर नीव नान से नान हेसुर देल येनारा बेळीर, रा ना अदरी माळाईन.”<verse eid="JHN 14:14" /></para>
  <para style="s">पवित्र आत्मा अन वादा</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />“अगर नीव नान से प्यार ईटतीर, रा नान आग्यागोळी मानसीर. <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />ना आप्प उन से विनती माळाईन, अदिक आव नीमी ऊंद अदिक सहायक कोट्टान कि आव सदा नीम सांगुळ ईरूल. <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />मतलब खरा अन आत्मा, यारी दुनिया ग्रहण माळ सकाल्द, यतिकी आव ना आऊक नोळतान अदिक ना आऊक अरूतान; नीव आऊक अरूतीर, यतिकी आव नीम सांगुळ ईरतान, अदिक आव नीम दा ईत्‍तान. <verse eid="JHN 14:17" /><verse number="18" style="v" sid="JHN 14:18" />ना नीमी अनाथ बिळतीदील; ना नीम हात्‍ती बरतीन. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />अदिक थ्वाळासा समय ईतोग्याद कि बाक दुनिया नानी नोळतीदिल, लेकीन नीव नानी नोळीर; इदुरसाटी कि ना जित्‍ता आईन, नीव भी जित्‍ता ईत्‍तीर. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />आ दिशी नीव जानसीर कि ना तान आप्प दा आईन, अदिक नीव नान दा, अदिक ना नीम दा. <verse eid="JHN 14:20" /><verse number="21" style="v" sid="JHN 14:21" />यार हात्‍ती नान आग्यागोळ आव अदिक आव अवरी मान्सतान, आवा नान से प्यार ईटतान; अदिक जो नान से प्यार ईटतान आऊन से नान आप्प प्यार ईट्यान, अदिक ना आऊन से प्यार ईटाईन अदिक तान तान इक आऊन मा प्रगट माळाईन.” <verse eid="JHN 14:21" /><verse number="22" style="v" sid="JHN 14:22" />आ यहूदा जो इस्करियोती ईला ईरोन, आऊन से अंदुन, “हे प्रभु, येन आत कि नी तान तान इक नाम मा प्रगट माळोद चाहासत्या अदिक दुनिया मा ईला?” <verse eid="JHN 14:22" /><verse number="23" style="v" sid="JHN 14:23" />यीशु आऊक उत्‍तर कोट्टुन, “अगर यावारा नान से प्यार ईट्यान रा आव नान वचन इक मानस्यान, अदिक नान आप्प आऊन से प्यार ईट्यान, अदिक नाव आऊन हात्‍ती बंदेव अदिक आऊन सांगुळ वास माळेव. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />जो नान से प्यार ईटालुन, आव नान वचन मानसालुन; अदिक जो वचन नीव केळतीर अद नांद ईला लेकीन आप्प उन हुन, याव नानी कळुदुन.” <verse eid="JHN 14:24" /><verse number="25" style="v" sid="JHN 14:25" />“ई मातगोळी ना नीम सांगुळ ईतकु नीम से अंदीन. <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />लेकीन सहायक मतलब पवित्र आत्मा यारी आप्प नान हेसुर देल कळ्यान, आव सप्पा मातगोळी कलस्यान, अदिक जो येनारा ना नीम से अंदीन, आव सप्पा नीमी याद माळसुस्यान. <verse eid="JHN 14:26" /><verse number="27" style="v" sid="JHN 14:27" />ना नीमी शांती कोटकु होगतीन, तान शांती नीमी कोळतीन; ह्यांग दुनिया कोळतद, ना नीमी हांग कोळालीन: नीम मन व्याकुल आगबाळुल अदिक अंजबाळुल.” <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />नीव केळदीर कि ना नीम से अंदीन, “ना होगतीन, अदिक नीम हात्‍ती मात्‍त बराईन.” अगर नीव नान से प्यार ईटायदीर, रा ई मात देल खुश आगायदीर कि ना आप्प उन हात्‍ती होगतीन, यतिकी आप्प नान से धोड्डेव आन. <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />अदिक ना ईग इदुर्द आगोर से पयले नीम से अंद बुटीन, कि याग अद आगेदीत, रा नीव विश्वास माळी. <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />ना ईग नीम सांगुळ अदिक हापाळ मातगोळी माळतीदील, यतिकी ई दुनिया अन सरदार बरतान. नान मा आऊन येनु अधिकार हैलेच; <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />लेकीन ईद इदुरसाटी आगतद कि दुनिया जानसुल कि ना आप्प से प्यार ईटतीन, अदिक ह्यांग आप्प नानी आग्या कोट्टुन ना हांग अच माळतीन. येळी, ईल टु नळी.<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">यीशु खरा दाखलता</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />“खरा दाखलता ना हुईन, अदिक नान आप्प किसान आन. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />जो खांदी नान दा आद अदिक फलसाल्द, अदरी आव कळ्द बुळतान; अदिक जो फल्सतद, अदरी आव छाट्सतान ताकी अदिक फलसुल. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />नीव रा आ वचन इन कारण जो ना नीम से अंदीन, शुद्ध आईर. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />नीव नान दा बन्सकु ईरी, अदिक ना नीम दा. ह्यांग खांदी अगर दाखलता दा बन्सकु ईरतीदील रा तान तान देल फल्स सकाल्द, हांगा नीव भी अगर नान दा बन्सकु ईरतीदील रा फल्स सकालीर. <verse eid="JHN 15:4" /><verse number="5" style="v" sid="JHN 15:5" />ना दाखलता हुईन: अदिक नीव खांदीगोळ हुईर. जो नान दा बन्सकु ईरतान अदिक ना आऊन दा, अद हापाळ काय तरतद, यतिकी नान से अलग आगकु नीव येनु माळ सकालीर. <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />अगर यावारा नान दा बन्सकु ईरूल, रा आव खांदी अन घाई भिटकु आगतान, अदिक वंळ्गेगतान; अदिक लॉकुर अवरी सकलुसकु बेक्‍की दा भीट बुळतार, अदिक अव होत्‍तेगताव. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />अगर नीव नान दा बन्सकु ईत्‍तीर अदिक नान वचन नीम दा बन्सकु ईत्‍तीत, रा जो चाहासीर बेळी अदिक अद नीम साटी आगेदीत. <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />नान आप्प उन महिमा ईदुर देल आगतद कि नीव हापाळ सा काय तरी, आग अच नीव नान चेला ठहरूसीर.” <verse eid="JHN 15:8" /><verse number="9" style="v" sid="JHN 15:9" />ह्यांग आप्प नान से प्यार ईटदुन, हांग अच ना नीम से प्यार ईटदीन; नान प्यार दा बन्सकु ईरी. <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />अगर नीव नान आग्यागोळी मानसीर, रा नान प्यार दा बन्सकु ईत्‍तीर; ह्यांग कि ना तान आप्प उन आग्यागोळी मान्सदीन, अदिक आऊन प्यार दा बन्सकु ईरतीन. <verse eid="JHN 15:10" /><verse number="11" style="v" sid="JHN 15:11" />ना ई मातगोळी नीम से इदुरसाटी अंदीन, कि नान खुशी नीम दा बन्सकु ईरूल, अदिक नीम खुशी पुरा आगेगुल. <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" /><note caller="+" style="x"><char style="xo" closed="false">१५:१२ </char><char style="xt" closed="false"><ref loc="JHN 13:34">यूहन्ना १३:३४</ref>; <ref loc="JHN 15:17">१५:१७</ref>; <ref loc="1JN 3:23">१ यूहन्ना ३:२३</ref>; <ref loc="2JN 1:5">२ यूहन्ना १:५</ref></char></note>“नान आग्या ईद आद, कि ह्यांग ना नीम से प्यार ईटदीन, हांग अच नीव भी आबुर दाबुर से प्यार ईटी. <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />इदुर से धोळ्द प्यार यारदु ईला कि यावारा तान संगीगोळ साटी तान जीव कोळुल. <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />जो आग्या ना नीमी कोळतीन, अगर अदरी मानसीर रा नीव नान संगी हुईर. <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />ईगी टु ना नीमी दास अनतीदिल, यतिकी दास जानसालुन कि आऊन मालिक येन माळतान; लेकीन ना नीमी संगी अंदीन, यतिकी जो मातगोळी ना तान आप्प से केळदीन, अव सप्पा नीमी हेळ बुटीन. <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />नीव नानी नीवळुसीदील लेकीन ना नीमी नीवळुसदीन कि नीव होगकु काय तरी अदिक नीम काय बन्सकु ईरूल, कि नीव नान हेसुर देल जो येनारा आप्प से बेळी, अद नीमी कोळुल. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />ई मातगोळ आग्या ना नीमी इदुरसाटी कोळतीन कि नीव आबुर दाबुर से प्यार ईटी.”<verse eid="JHN 15:17" /></para>
  <para style="s">दुनिया अन दुश्मनी</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />“अगर दुनिया नीम से दुश्मनी ईटतद, रा नीव जान्सतीर कि आव नीम से पयले नान से दुश्मनी ईटदुर. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />अगर नीव दुनिया नोर आगायदीर, रा दुनिया तानोर से प्यार ईटाईत; लेकीन ईद कारण कि नीव दुनिया अन आल्लच, लेकीन ना नीमी दुनिया दा टु नीवळुस कोंडीन, इदुरसाटी दुनिया नीम से दुश्मनी ईटतद. <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" /><note caller="+" style="x"><char style="xo" closed="false">१५:२० </char><char style="xt" closed="false"><ref loc="MAT 10:24">मत्ती १०:२४</ref>; <ref loc="LUK 6:40">लूका ६:४०</ref>; <ref loc="JHN 13:16">यूहन्ना १३:१६</ref></char></note>जो मात ना नीम से अंदिदीन, ‘दास तान स्वामी से धोड्डेव ईरालुन,’ अदरी याद ईटी. अगर आंदुर नानी सतुसदुर, रा नीमी भी सतुस्यार; अगर आंदुर नान मात मान्सदुर, रा नीम्द भी मानस्यार. <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />लेकीन ईद सप्पा येनारा आंदुर नान हेसुर इन कारण नीम सांगुळ माळ्यार, यतिकी आंदुर नानी कळावाळा अक जानसालुर. <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />अगर ना ईला बरायदीन अदिक आंदुर से मातगोळी ईला माळायदीन, रा आंदुर पापी ईला ठहरूसयदुर; लेकीन ईग आंदरी पाप इन साटी येनु बहाना हैलेच. <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />जो नान से दुश्मनी ईटतान, आव नान आप्प से भी दुश्मनी ईटतान. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />अगर ना आंदुर दा आंदुर क्याल्सा ईला माळायदीन जो अदिक याऊ माळीदील, रा आंदुर पापी ईला ठहरूसयदुर; लेकीन ईग रा आंदुर नानी अदिक नान आप्प येढ्ढु मुंदरी नोळदुर अदिक येढ्ढु से दुश्मनी माळदुर. <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />ईद इदुरसाटी आत कि अद वचन पुरा आगुल, जो आंदुर्द व्यवस्था दा लिख्सकु आद, ‘आंदुर नान से फालतु दुश्मनी माळदुर.’ <verse eid="JHN 15:25" /><verse number="26" style="v" sid="JHN 15:26" />लेकीन याग आव मदतगार बंदान, यारी ना नीम हाती आप्प उन दी टु कळाईन, मतलब सच्चाई अन आत्मा जो आप्प उन दी टु होळतान, रा आव नान गवाही कोट्टान; <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />अदिक नीव भी नान गवाह आईर यतिकी सुरूवात टु नान सांगुळ ईतीर.”<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />“ई मातगोळी ना नीम से इदुरसाटी अंदीन कि नीव ठोकर तिनबाळी. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />आंदुर नीमी यहूदी लॉकुर्द सभागृहगोळ दा टु तेगु बुट्टार, लेकीन अद समय बंदाद, कि जो यावारा नीमी कोंद बुट्टान आव समस्यान कि ना परमेश्वर उन स्यावा माळतीन. <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />हिंग आंदुर इदुरसाटी माळ्यार कि आंदुर ना आप्प उक जानस्यार अदिक ना नानी जान्सतार. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />लेकीन ई मातगोळी ना इदुरसाटी अंदीन, कि याग इंदुर समय बंदीत रा नीमी याद होट बंदीत कि ना नीम से पयले अच अंद बुटीदीन.”</para>
  <para style="s" vid="JHN 16:4">पवित्र आत्मा अन क्याल्सा</para>
  <para style="p" vid="JHN 16:4">“ना सुरूवात टु नीम से ई मातगोळी इदुरसाटी अंदिदील यतिकी ना नीम सांगुळ ईरीन. <verse eid="JHN 16:4" /><verse number="5" style="v" sid="JHN 16:5" />लेकीन ईग ना तान कळावाळा अन हात्‍ती होगतीन; अदिक नीम दा टु याऊ नान से केळालुन, कि ‘नी येल होगत्या.’” <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />लेकीन ना जो ई मातगोळी नीम से अंदीन, इदुरसाटी नीम मन शोक देल तुम्मेग्याद. <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />तरी ना नीम से खरा माताळतीन कि नांद होगोद नीम साटी वळ्लीद आद, यतिकी अगर ना होगतीदील रा आव सहायक नीम हात्‍ती बरतीदील; लेकीन अगर ना होगाईन, रा आऊक नीम हात्‍ती कळाईन. <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />आव बंदकु दुनिया अक पाप अदिक न्यायीपन अदिक न्याय इन बारा दा समझुस्यान. <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />पाप इन बारा दा इदुरसाटी कि आंदुर नान मा विश्वास माळालुर; <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />अदिक न्यायीपन अन बारा दा इदुरसाटी कि ना आप्प उन हात्‍ती होगतीन, अदिक नीव नानी बाक नोळतीदिल; <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />न्याय इन बारा दा इदुरसाटी कि दुनिया अन सरदार दोषी ठहरूस्कु आग्यान. <verse eid="JHN 16:11" /><verse number="12" style="v" sid="JHN 16:12" />“नानी नीम से अदिक भी हापाळ सा मातगोळी अनोद आद, लेकीन ईगल्या नीव अवरी सहन माळ सकालीर. <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />लेकीन याग आव मतलब सच्चाई अन आत्मा बंदान, रा नीमी सप्पा सच्चाई अन हादी हेळ्यान, यतिकी आव तान दी टु ईला अंदान लेकीन जो येनारा केळ्यान अदा अंदान, अदिक बरावाळा मातगोळी नीमी हेळ्यान. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />आव नांद महिमा माळ्यान, यतिकी आव नान मातगोळ दा टु हुळकु नीमी हेळ्यान. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />जो येनारा आप्प उन आद, अद सप्पा नान हुन; इदुरसाटी ना अंदीन कि आव नान मातगोळ दा टु हुळकु नीमी हेळ्यान.<verse eid="JHN 16:15" /></para>
  <para style="s">दुख सुख दा बदलुसेदीत</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />“घळी तीमुर दा नीव नानी नोळतीदिल, अदिक बाक घळी तीमुर दा का नानी नोळीर.” <verse eid="JHN 16:16" /><verse number="17" style="v" sid="JHN 16:17" />आग आऊन येनारा चेलागोळ आपस दा अंदुर, “ईद येन हुन जो आव नाम से अनतान, ‘घळी तीमुर दा नीव नानी नोळतीदिल, अदिक बाक घळी तीमुर दा का नानी नोळीर?’ अदिक ईद ‘इदुरसाटी कि ना आप्प उन हात्‍ती होगतीन.’” <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />आग आंदुर अंदुर, “ईद ‘घळी तीमुर’ जो आव अनतान, येन मात आद? नाव जानसालेव कि आव येन अनतान.” <verse eid="JHN 16:18" /><verse number="19" style="v" sid="JHN 16:19" />यीशु ईद जान्सकु कि आंदुर नान से केळोद चाहासतार, आंदुर से अंदुन, “येन नीव आपस दा नान ई मात इन बारा दा जाँच माळतीर, ‘घळी तीमुर दा नीव नानी नोळतीदिल, अदिक बाक घळी तीमुर दा का नानी नोळीर?’ <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />ना नीम से खरा खरा अनतीन कि नीव वर्लीर अदिक दुख माळीर, लेकीन दुनिया खुशी माळीत; नीमी शोक आदीत, लेकीन नीम शोक खुशी दा बदलुसेदीत. <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />चिग्द हाळोद समय आर्त इक दुख आगतद, यतिकी आकिन दुख इन घळी होट बंदाद, लेकीन याग आक चिग्द उक जनम कोट बुळतार, रा ईद खुशी देल कि दुनिया दा ऊंद मंळसा पैदा आदुन, आ संकट इक बाक याद माळालुर. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />अदा प्रकार नीमी भी ईग रा दुख आद, लेकीन ना नीम से बाक सिकाईन अदिक नीम मन खुशी देल तुम्मेदव; अदिक नीम खुशी याऊ नीम से कसु सकतीदिल. <verse eid="JHN 16:22" /><verse number="23" style="v" sid="JHN 16:23" />आ दिशी नीव नान से येनु कोळतीदील. ना नीम से खरा खरा माताळतीन, अगर आप्प उन से येनारा बेळीर, रा आव नान हेसुर देल नीमी कोट्टान. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />ईगासताका नीव नान हेसुर देल येनु बेळीदील; बेळीर रा नीमी सिक्‍कीत ताकी नीम खुशी पुरा आगेगुल.<verse eid="JHN 16:24" /></para>
  <para style="s">दुनिया मा विजय</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />“ना ई मातगोळी नीम से उदाहरणगोळ दा अंदीन, लेकीन अद समय बंदीत कि ना नीम से बाक उदाहरणगोळ दा अनतीदिल, लेकीन खुल्सकु नीमी आप्प उन बारा दा हेळाईन. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />आ दिशी नीव नान हेसुर देल बेळीर; अदिक ना नीम से ईद अनालीन कि ना नीम साटी आप्प उन से विनती माळाईन; <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />यतिकी आप्प रा खुद अच नीव से प्यार ईटतान, इदुरसाटी कि नीव नान से प्यार ईटदीर अदिक ईद भी विश्वास माळदीर कि आप्प उन दी टु बंदीन. <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />ना आप्प उन दी टु दुनिया दा बंदीन; ना मात्‍त दुनिया अक बिटकु आप्प उन हात्‍ती होगतीन.” <verse eid="JHN 16:28" /><verse number="29" style="v" sid="JHN 16:29" />आऊन चेलागोळ अंदुर, “नोळ, ईग रा नी खुल्सकु अनत्या, अदिक येनु उदाहरण अनाल. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />ईग नाव जान्स कोंडेव कि नी सब येनारा जान्सत्या, अदिक इदुर जरवत हैलेच कि यावारा नीन से येनारा केळुल; इदुर देल नाव विश्वास माळतेव कि नी परमेश्वर उन दी टु बंद्या.” <verse eid="JHN 16:30" /><verse number="31" style="v" sid="JHN 16:31" />ईद केळकु यीशु आंदुर से अंदुन, “येन नीव ईग विश्वास माळतीर? <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />नोळी, अद घळी बरतद बल्‍की होट बंदाद कि नीव सप्पा तितर बितर आगकु तान तान हादी हुळदीर, अदिक नानी आबना बिट बुट्टीर; तरी ना आबना ईला यतिकी आप्प नान सांगुळ आन. <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />ना ई मातगोळी नीम से इदुरसाटी अंदीन कि नीमी नान दा शांती सिकुल. दुनिया दा नीमी दुख आगतद, लेकीन हिम्मत ईटी, ना दुनिया अक जीत्स कोंडीन.”<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">यीशु उन महायाजकीय प्रार्थना: खुद इन साटी</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />यीशु ई मातगोळी अंदुन अदिक तान कण्णगोळी आकाश इन दी म्याकुच नेगुकु अंदुन, “हे आप्पा, अद घळी होट बंदाद; तान पार उन महिमा माळ कि पार भी नीन महिमा माळुल, <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />यतिकी नी आऊक सप्पा प्राणीगोळ मा अधिकार कोट्या, कि यारी नी आऊक कोट्या आ सप्पा अक आव अनन्त जीवन कोळुल. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />अदिक अनन्त जीवन ईद आद कि आंदुर नीन ऊंद मात्र खरा परमेश्वर उक अदिक यीशु मसीह अक, यारी नी कळ्या, जानसुल. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />जो क्याल्सा नी नानी माळली कोटीद, अदरी पुरा माळकु ना पृथ्वी मा नीन महिमा माळीन. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />ईग हे आप्प, नी तान सांगुळ नान महिमा आ महिमा देल माळ जो दुनिया अन दुनिया से पयले, नांद नीन सांगुळ ईरोद.<verse eid="JHN 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />“ना नीन हेसुर आ मंळसागोळ मा प्रगट माळीन यारी नी दुनिया दा टु नानी कोट्ट. आंदुर नीनोर ईरोर अदिक नी आंदरी नानी कोट्ट, अदिक आंदुर नीन वचन इक मान्स कोंडुर. <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />ईग आंदुर जान्स कोंडुर कि जो येनारा नी नानी कोट्या अद सप्पा नीन दी टु आद; <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />यतिकी जो वचन नी नानी कोट्ट, ना अवरी आंदुर हाती पोहचुस बुटीन; अदिक आंदुर अवरी ग्रहण माळदुर, अदिक खरा खरा जान्स कोंडुर कि ना नीन दी टु बंदीन, अदिक विश्वास माळ कोंडुर कि नी अच नानी कळ्या. <verse eid="JHN 17:8" /><verse number="9" style="v" sid="JHN 17:9" />ना आंदुर साटी विनती माळतीन; दुनिया अन साटी विनती माळालीन लेकीन आंदुर्दा साटी यारी नी नानी कोट्या, यतिकी आंदुर नीनोर उर; <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />अदिक जो येनारा नांद आद अद सप्पा नींद हुन, अदिक जो नींद हुन अद नांद हुन, अदिक ईऊर देल नांद महिमा प्रगट आग्याद. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />ना ईग दुनिया दा ईरतीदील, लेकीन इंदुर दुनिया दा ईत्‍तार, अदिक ना नीन हात्‍ती बरतीन. हे पवित्र आप्प, तान आ हेसुर देल जो नी नानी कोट्या, अऊर्द रक्षा माळ कि अव नाम घाई ऊंद आगुल. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" /><note caller="+" style="x"><char style="xo" closed="false">१७:१२ </char><char style="xt" closed="false"><ref loc="JHN 13:18">यूहन्ना १३:१८</ref></char></note>याग ना आंदुर सांगुळ ईरीन, रा ना नीन अद हेसुर देल, जो नी नानी कोट्या अदुर्द रक्षा माळदीन. ना आंदुर्द सावधानी माळदीन, अदिक विनाश इन पार उक बिटकु आंदुर दा टु याऊ नाश आगीदील, इदुरसाटी कि जो पवित्रशास्त्र दा अंदकु आग्याद अद पुरा आगुल. <verse eid="JHN 17:12" /><verse number="13" style="v" sid="JHN 17:13" />ईग ना नीन हात्‍ती बरतीन, अदिक ई मातगोळी दुनिया<note caller="+" style="f"><char style="fr" closed="false">१७:१३ </char><char style="ft" closed="false">पुरा दुनिया</char></note> दा अनतीन, कि आंदुर नान खुशी तान दा पुरा आगुल. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />ना नीन वचन आंदरी पोहचुस बुटीन; अदिक दुनिया आंदुर से दुश्मनी माळ्त, यतिकी ह्यांग ना दुनिया नव आल्लच, हांग अच आंदुर भी दुनिया नोर आल्लच. <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />ना ईद विनती माळालीन कि नी आंदरी दुनिया टु नेगु कोम; लेकीन ईद कि नी आंदरी आ दुष्ट टु ऊळ्सकु ईट. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />ह्यांग ना दुनिया नव आल्लच, हांगा आंदुर भी दुनिया नोर आल्लच. <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />सच्चाई अन द्वारा आंदरी पवित्र माळ: नीन वचन सही आद. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />ह्यांग नी नानी दुनिया दा कळुद, हांगा ना भी आंदरी दुनिया दा कळुदीन; <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />अदिक आंदुर साटी ना तान तान इक पवित्र माळतीन, ताकी आंदुर भी सही अन द्वारा पवित्र माळकु आगुल.<verse eid="JHN 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />“ना सिर्फ इंदुर्दा साटी विनती माळालीन, लेकीन आंदुर साटी भी जो इंदुर वचन इन द्वारा नान मा विश्वास माळ्यार, <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />कि आंदुर सप्पा ऊंद आगुल; ह्यांग नी हे आप्प नान दा आय, अदिक ना नीन दा आईन, हांग अच आंदुर भी नाम दा आगुल, यार से दुनिया विश्वास माळुल कि नी अच नानी कळ्या. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />अद महिमा जो नी नानी कोट्या ना आंदरी अद कोट्टीन, कि आंदुर हांग अच ऊंद आगुल ह्यांग कि नाव ऊंद आयेव, <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />ना आंदुर दा अदिक नी नान दा कि आंदुर सिद्ध आगकु ऊंद आगेगुल, अदिक दुनिया जानसुल कि नी अच नानी कळ्या, अदिक ह्यांग नी नान से प्यार ईट्द हांग अच आंदुर से प्यार ईट्द. <verse eid="JHN 17:23" /><verse number="24" style="v" sid="JHN 17:24" />हे आप्प, ना चाहासतीन कि यारी नी नानी कोट्या, येल ना आईन अल आंदुर भी नान सांगुळ ईरूल, कि आंदुर नान आ महिमा अक नोळुल जो नी नानी कोट्या, यतिकी नी दुनिया अन उत्पत्ति से पयले नान से प्यार ईट्द. <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />हे न्यायी आप्प, दुनिया नानी जानसीदील, लेकीन ना नीनी जान्सदीन; अदिक इंदुर भी जान्सदुर कि नी अच नानी कळ्या. <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />ना नीन हेसुर आंदरी हेळदीन अदिक हेळ्त ईराइन कि जो प्यार नीनी नान से ईरोद अद आंदुर दा ईरूल, अदिक ना आंदुर दा ईरूल.”<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">यीशु उक हुळसुसकु आगोद</para>
  <para style="r">(<ref loc="MAT 26:47-56">मत्ती २६:४७-५६</ref>; <ref loc="MRK 14:43-50">मरकुस १४:४३-५०</ref>; <ref loc="LUK 22:47-53">लूका २२:४७-५३</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />यीशु ई मातगोळी अनकु तान चेलागोळ सांगुळ किद्रोन नाला अन आप्पाटी होदुन. अल ऊंद बेली ईरोद, यदुर्दा आव अदिक आऊन चेलागोळ होदुर. <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />आऊक हुळसुसावाळा यहूदा भी अद जागा जानसोन, यतिकी पयले हापाळ घन यीशु तान चेलागोळ सांगुळ अल होगीदुन. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />आग यहूदा, सैनिकगोळ्द ऊंद दल इक अदिक प्रधान याजकगोळी अदिक फरीसीगोळ दी टु चौकीदारगोळी हुळकु, कंदीलगोळ, मशालगोळी अदिक हथियारगोळी हुळकु अल बंदुन. <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />आग यीशु, आ सप्पा मातगोळी जो आऊन मा बरावाळा ईरव जान्सकु, होट्टुन अदिक आंदुर से अंदुन, “यारी ढुंढ्सतीर?” <verse eid="JHN 18:4" /><verse number="5" style="v" sid="JHN 18:5" />आंदुर आऊक उत्‍तर कोट्टुर, “यीशु नासरी अक.” यीशु आंदुर से अंदुन, “ना हुईन.” आऊक हुळसुसावाळा यहूदा भी आंदुर सांगुळ निदुरकु ईरोन. <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />आऊंद ईद अनतेला अच, “ना हुईन,” आंदुर हिंद सरकुसकु जागा मा बिदोदुर. <verse eid="JHN 18:6" /><verse number="7" style="v" sid="JHN 18:7" />आग आव मात्‍त आंदुर से केळदुन, “नीव यारी ढुंढ्सतीर.” आंदुर अंदुर, “यीशु नासरी अक.” <verse eid="JHN 18:7" /><verse number="8" style="v" sid="JHN 18:8" />यीशु उत्‍तर कोट्टुन, “ना रा नीम से अंद कोडींन कि ना हुईन, अगर नानी ढुंढ्सतीर रा इंदरी होगगोळी.” <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />ईद इदुरसाटी आत कि अद वचन पुरा आगुल जो आव अंदिदुन: “यारी नी नानी कोट्या आंदुर दा टु ना ऊंद इक भी खोऊसीदील.” <verse eid="JHN 18:9" /><verse number="10" style="v" sid="JHN 18:10" />आग शमौन पतरस तलवार, जो आऊन हात्‍ती ईरोद, जेळदुन अदिक महायाजक उन दास मा नळ्सकु आऊन ऊमा किव हार्स बुटुन. आ दास उन हेसुर मलखुस ईरोद. <verse eid="JHN 18:10" /><verse number="11" style="v" sid="JHN 18:11" /><note caller="+" style="x"><char style="xo" closed="false">१८:११ </char><char style="xt" closed="false"><ref loc="MAT 26:39">मत्ती २६:३९</ref>; <ref loc="MRK 14:36">मरकुस १४:३६</ref>; <ref loc="LUK 22:42">लूका २२:४२</ref></char></note>आग यीशु पतरस से अंदुन, “तान तलवार म्यान दा ईट. जो कटोरा आप्प नानी कोटान, येन ना अदरी कुडुतीदील?”<verse eid="JHN 18:11" /></para>
  <para style="s">हन्ना अन पयले यीशु</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />आग सैनिकगोळ अदिक आंदुर सूबेदार अदिक यहूदीगोळ चौकीदारगोळ यीशु उक हुळकु कट बुटुर, <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />अदिक पयले आऊक हन्ना अन हात्‍ती ओतुर, यतिकी आव आ वर्ष इन महायाजक कैफा अन मॉव ईरोन. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" /><note caller="+" style="x"><char style="xo" closed="false">१८:१४ </char><char style="xt" closed="false"><ref loc="JHN 11:49">यूहन्ना ११:४९</ref>,<ref loc="JHN 11:50">५०</ref></char></note>ईव आवा कैफा ईरोन, यार यहूदीगोळी सलाह कोटीदुन कि नाम लॉकुर साटी ऊंद मंळसा अन सायोद वळ्लीद आद.<verse eid="JHN 18:14" /></para>
  <para style="s">पतरस उन इनकार</para>
  <para style="r">(<ref loc="MAT 26:69">मत्ती २६:६९</ref>,<ref loc="MAT 26:70">७०</ref>; <ref loc="MRK 14:66-68">मरकुस १४:६६-६८</ref>; <ref loc="LUK 22:55-57">लूका २२:५५-५७</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />शमौन पतरस अदिक ऊंद अन्य चेला भी यीशु उन हिंद आगेदुर. ईव चेला महायाजक उन जाना पयचाना ईरोन, इदुरसाटी आव यीशु उन सांगुळ महायाजक उन आंगुळ दा होदुन, <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />लेकीन पतरस व्हार्या दरवाजा मा निदुरकु ईत्‍तुन. आग आव दुसरा चेला जो महायाजक उन जान पयचान इनव ईरोन, व्हार्या होट्टुन अदिक चौकीदारगीत इन से अनकु पतरस उक बुळ्क तंदुन. <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />आ दासी जो चौकीदारगीत ईरोर, पतरस से अंदुर, “येनारा नी भी ई मंळसा अन चेलागोळ दा टु रा हैलेच?” आव अंदुन, ईला “ना आल्लच.” <verse eid="JHN 18:17" /><verse number="18" style="v" sid="JHN 18:18" />दास अदिक चौकीदार सोळ इन कारण कॉरसा होत्‍ताकु निदुरकु बेक्‍की सेकसोर, अदिक पतरस भी आंदुर सांगुळ निदुरकु बेक्‍की सेकसोन.<verse eid="JHN 18:18" /></para>
  <para style="s">महायाजक उन द्वारा यीशु उन जाँच</para>
  <para style="r">(<ref loc="MAT 26:59-66">मत्ती २६:५९-६६</ref>; <ref loc="MRK 14:55-64">मरकुस १४:५५-६४</ref>; <ref loc="LUK 22:66-71">लूका २२:६६-७१</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />आग महायाजक यीशु से आऊन चेलागोळ बारा दा अदिक आऊन उपदेश इन बारा दा जाँच माळदुन. <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />यीशु आऊक उत्‍तर कोट्टुन, “ना दुनिया अन सांगुळ खुल्सकु मातगोळी हेळदीन; ना सभागृहगोळ अदिक मंदिर दा, यल सप्पा यहूदी जमा आगतोगोर, सदा उपदेश माळदीन अदिक गुप्त दा येनु अंदिदील. <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />नी नान से येती केळत्या? केळावाळेर से केळ कि ना आंदुर से येन अंदीन. नोळ, आंदुर जान्सतार कि ना येन येन अंदीन.” <verse eid="JHN 18:21" /><verse number="22" style="v" sid="JHN 18:22" />याग आव ईद अंदुन, रा चौकीदारगोळ दा टु ऊंद जो हात्‍ती निदुरकु ईरोन, यीशु उक क्याबरा बळकु अंदुन, “येन नी महायाजक उक ईत्‍ता प्रकार देल उत्‍तर कोळत्या?” <verse eid="JHN 18:22" /><verse number="23" style="v" sid="JHN 18:23" />यीशु आऊक उत्‍तर कोट्टुन, “अगर ना बुरा अंदीन, रा आ बुराई अन गवाही कोळ; लेकीन अगर भला अंदीन, रा नानी येती बडुत्या?” <verse eid="JHN 18:23" /><verse number="24" style="v" sid="JHN 18:24" />हन्ना आऊक कटकु कैफा महायाजक उन कळु बुटुन.<verse eid="JHN 18:24" /></para>
  <para style="s">पतरस उन दुबारा इनकार</para>
  <para style="r">(<ref loc="MAT 26:71-75">मत्ती २६:७१-७५</ref>; <ref loc="MRK 14:69-72">मरकुस १४:६९-७२</ref>; <ref loc="LUK 22:58-62">लूका २२:५८-६२</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />शमौन पतरस निदुरकु बेक्‍की सेकसोन. आग आंदुर आऊन से अंदुर, “येनारा नी भी रा आऊन चेलागोळ दा टु रा हैलेच?” आव इनकार माळकु अंदुन, “ना आल्लच.” <verse eid="JHN 18:25" /><verse number="26" style="v" sid="JHN 18:26" />महायाजक उन दासगोळ दा टु ऊंद, जो परिवार दा टु ईरोन यार्द किव पतरस कोद बुटीदुन, अंदुन, “येन ना नीनी आऊन सांगुळ बेली दा ईला नोळीदिन?” <verse eid="JHN 18:26" /><verse number="27" style="v" sid="JHN 18:27" />पतरस मात्‍त इनकार माळदुन, अदिक तुरन्त हुंज कुग्त.<verse eid="JHN 18:27" /></para>
  <para style="s">पिलातुस उन मुंद यीशु</para>
  <para style="r">(<ref loc="MAT 27:1">मत्ती २७:१</ref>,<ref loc="MAT 27:2">२</ref>,<ref loc="MAT 27:11-14">११-१४</ref>; <ref loc="MRK 15:1-5">मरकुस १५:१-५</ref>; <ref loc="LUK 23:1-5">लूका २३:१-५</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />आग आंदुर यीशु उक कैफा अन हात्‍ती टु किला अक ओतुर, अदिक व्हातुर इन समय ईरोद, लेकीन आंदुर खुद किला अन बुळ्क होगीदील ताकी अशुध्द आगबाळुल लेकीन फसह तिन सकुल. <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />आग पिलातुस आंदुर हात्‍ती व्हार्या होटकु बंदुन अदिक अंदुन, “नीव ई मंळसा मा याता मात इन आरोप हचतीर?” <verse eid="JHN 18:29" /><verse number="30" style="v" sid="JHN 18:30" />आंदुर आऊक उत्‍तर कोट्टुर, “अगर आव कुकर्मी ईला ईरायदुन रा नाव आऊक नीन कय दा ईला कोळायदेव.” <verse eid="JHN 18:30" /><verse number="31" style="v" sid="JHN 18:31" />पिलातुस आंदुर से अंदुन, “नीव अच ईऊक वोतकु तान व्यवस्था अन अनुसार आऊंद न्याय माळी.” यहूदीगोळ आऊन से अंदुर, “नामी अधिकार हैलेच कि यारदारा जीव ताकोंडेव.” <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" /><note caller="+" style="x"><char style="xo" closed="false">१८:३२ </char><char style="xt" closed="false"><ref loc="JHN 3:14">यूहन्ना ३:१४</ref>; <ref loc="JHN 12:32">१२:३२</ref></char></note>ईद इदुरसाटी आत कि यीशु उन अद मात पुरा आगुल जो आव ईद संकेत कोळाहोती अंदिदुन कि आऊंद मृत्यु ह्यांग आदीत.<verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />आग पिलातुस मात्‍त किला अन बुळ्क होदुन, अदिक यीशु उक कारूकु आऊन से केळदुन, “येन नी यहूदीगोळ राजा हुय?” <verse eid="JHN 18:33" /><verse number="34" style="v" sid="JHN 18:34" />यीशु उत्‍तर कोट्टुन, “येन नी ईद मात तान दी टु अनत्या या दुसरागोळ नान बारा दा नीन से ईद अंदार?” <verse eid="JHN 18:34" /><verse number="35" style="v" sid="JHN 18:35" />पिलातुस उत्‍तर कोट्टुन, “येन ना यहूदी हुईन? अपमान अच जाती अदिक प्रधान याजकगोळ नीनी नान कय दा कोटार. नी येन माळ्या?” <verse eid="JHN 18:35" /><verse number="36" style="v" sid="JHN 18:36" />यीशु उत्‍तर कोट्टुन, “नान राज्य ई दुनिया अन आल्लच; अगर नान राज्य ई दुनिया अन आगाईत, रा नान सेवकगोळ लळाई माळायदुर कि नानी यहूदीगोळ कय दा कोटकु आगबाळुल: लेकीन नान राज्य ईल ईद आल्लच.” <verse eid="JHN 18:36" /><verse number="37" style="v" sid="JHN 18:37" />पिलातुस आऊन से अंदुन, “रा येन नी राजा हुय?” यीशु उत्‍तर कोट्टुन, “नी अनत्या कि ना राजा हुईन. ना इदुरसाटी पैदा आदीन अदिक इदुरसाटी दुनिया दा बंदीन कि सच्चाई इन गवाही कोळाईन. जो यावारा सच्चाई नव आन, आव नान आवाज केळतान.” <verse eid="JHN 18:37" /><verse number="38" style="v" sid="JHN 18:38" />पिलातुस आऊन से अंदुन, “सही येन आद?”</para>
  <para style="s" vid="JHN 18:38">मृत्यु दण्ड इन आग्या</para>
  <para style="r" vid="JHN 18:38">(<ref loc="MAT 27:15-31">मत्ती २७:१५-३१</ref>; <ref loc="MRK 15:6-20">मरकुस १५:६-२०</ref>; <ref loc="LUK 23:13-25">लूका २३:१३-२५</ref>)</para>
  <para style="p" vid="JHN 18:38">ईद अनकु आव मात्‍त यहूदीगोळ हात्‍ती होदुन अदिक आंदुर से अंदुन, “नानी रा आऊन दा येनु दोष सिक्‍कीदील. <verse eid="JHN 18:38" /><verse number="39" style="v" sid="JHN 18:39" />लेकीन नीम्द ईद रीति आद कि ना फसह दा नीम्द साटी ऊंद मंळसा अक बिट बुळाईन. इदुरसाटी येन नीव चाहासतीर कि ना नीम साटी यहूदीगोळ राजा अक बिट बुळाईन?” <verse eid="JHN 18:39" /><verse number="40" style="v" sid="JHN 18:40" />आग आंदुर मात्‍त चिल्ळासकु अंदुर, “ईऊक ईला, लेकीन नाम साटी बरअब्बा अक बिट बुळ.” अदिक बरअब्बा डाकू ईरोन.<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />इदुर मा पिलातुस यीशु उक क्वाळा बळसुसदुन. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />सिपाहीगोळ मुळ्लगोळ मुकुट माळकु आऊन ताल्ला मा ईटदुर, अदिक जांभळा कलर इन कपळा हाकसुसदुर. <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />अदिक आऊन हात्‍ती खुशी देल बंद बंदकु अनली कुरतुर, “हे यहूदीगोळ राजा, प्रणाम!” अदिक आऊक क्याबरा भी बळदुर. <verse eid="JHN 19:3" /><verse number="4" style="v" sid="JHN 19:4" />आग पिलातुस मात्‍त व्हार्या होटकु लॉकुर से अंदुन, “नोळी, ना आऊक नीम हात्‍ती मात्‍त व्हार्या तरतीन; ताकी नीव जान्सी कि आऊन दा नानी येनु भी दोष सिक्‍कीदील.” <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />आग यीशु मुळ्लगोळ मुकुट अदिक जांभळा कलर इन कपळा हाक्‍कु व्हार्या होट्टुन; अदिक पिलातुस आंदुर से अंदुन, “नोळी, ईव मंळसा!” <verse eid="JHN 19:5" /><verse number="6" style="v" sid="JHN 19:6" />“याग प्रधान याजकगोळ अदिक चौकीदारगोळ आऊक नोळदुर, रा चिल्ळासकु अंदुर, आऊक क्रूस मा येर्स, क्रूस मा!” पिलातुस आंदुर से अंदुन, “नीव अच आऊक हुळकु क्रूस मा येरसी, यतिकी नानी आऊन दा येनु दोष सिक्‍कीदील.” <verse eid="JHN 19:6" /><verse number="7" style="v" sid="JHN 19:7" />यहूदीगोळ आऊक उत्‍तर कोट्टुर, “नाम्द भी व्यवस्था आद अदिक आ व्यवस्था अन अनुसार आव कोंद बुळोद योग्य आन, यतिकी आव तान तान इक परमेश्वर उन पार माळदुन.” <verse eid="JHN 19:7" /><verse number="8" style="v" sid="JHN 19:8" />याग पिलातुस ईद मात केळदुन रा अदिक भी अंजेदुन, <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />अदिक मात्‍त किला अन बुळ्क होदुन अदिक यीशु से अंदुन, “नी येलेव हुय?” लेकीन यीशु आऊक येनु भी उत्‍तर कोटीदील. <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />इदुर मा पिलातुस आऊन से अंदुन, “नान से येती माताळाल? येन नी जान्साल कि नीनी बिट बुळोद अधिकार नानी आद, अदिक नीनी क्रूस मा येरसोद भी अधिकार नानी आद.” <verse eid="JHN 19:10" /><verse number="11" style="v" sid="JHN 19:11" />यीशु उत्‍तर कोट्टुन, “अगर नीनी म्याकुच टु कोटकु ईला आगाईत, रा नीन नान मा येनु अधिकार ईला ईराईत; इदुरसाटी याव नानी नीन कय दा हुळसुस्यान आऊन पाप यक्कुल आव.” <verse eid="JHN 19:11" /><verse number="12" style="v" sid="JHN 19:12" />इदुर मा पिलातुस आऊक बिट बुळोद चाहासदुन, लेकीन यहूदीगोळ चिल्ळास चिल्ळासकु अंदुर, “अगर नी ईऊक बिटबुट्या, रा नीन भक्ति कैसर सरकार उन दी हैलेच. जो यावारा तान तान इक राजा माळतान आव कैसर सरकार इन सामना माळतान.” <verse eid="JHN 19:12" /><verse number="13" style="v" sid="JHN 19:13" />ई मातगोळी केळकु पिलातुस यीशु उक व्हार्या तंदुन अदिक आ जागा कल्ल इन ऊंद चबूतरा ईरोद जो इब्रानी भाषा दा “गब्बता” कहलुसतद, अदिक अल न्याय आसन मा कुरतुन. <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />ईद फसह अन तयारी इन दिन ईरोद, अदिक सहावा घंटा अन लगभग ईरोद. आग आव यहूदीगोळ से अंदुन, “नोळी नीम राजा!” <verse eid="JHN 19:14" /><verse number="15" style="v" sid="JHN 19:15" />लेकीन आंदुर चिल्ळासदुर, “ओय! ओय! आऊक क्रूस मा येर्स!” पिलातुस आंदुर से अंदुन, “येन ना नीम राजा अक क्रूस मा येरसाईन?” प्रधान याजकगोळ उत्‍तर कोट्टुर, “कैसर सरकार उक बिटकु नाम याऊ राजा हैलेच.” <verse eid="JHN 19:15" /><verse number="16" style="v" sid="JHN 19:16" />आग पिलातुस यीशु उक आंदुर कय दा कोट बुटुन ताकी आव क्रूस मा येर्सकु आगुल.</para>
  <para style="s" vid="JHN 19:16">यीशु उक क्रूस मा येर्सकु आगोद</para>
  <para style="r" vid="JHN 19:16">(<ref loc="MAT 27:32-44">मत्ती २७:३२-४४</ref>; <ref loc="MRK 15:21-32">मरकुस १५:२१-३२</ref>; <ref loc="LUK 23:26-43">लूका २३:२६-४३</ref>)</para>
  <para style="p" vid="JHN 19:16">इदुरसाटी आंदुर आऊक तान कबजा दा माळदुर. <verse eid="JHN 19:16" /><verse number="17" style="v" sid="JHN 19:17" />आग आंदुर यीशु उक ओतुर, अदिक आव तान क्रूस नेगुकु आ जागा ताका व्हार्या होदुन, जो “खोपळी इन जागा” अनकु आगतद अदिक इब्रानी भाषा दा “गुलगुता.” <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />अल आंदुर आऊक अदिक आऊन सांगुळ अदिक येढ्ढ मंळसागोळी क्रूस मा येर्सदुर, ऊंद इक इत्‍त अदिक ऊंद इक आत्‍त, अदिक न्याड्या दा यीशु उक. <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />पिलातुस ऊंद दोष चिट्ठी लिख्सकु क्रूस मा हच बुटुन, अदिक अदुर दा ईद लिख्सकु ईरोद, “यीशु नासरी, यहूदीगोळ राजा.” <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />ईद दोष चिट्ठी हापाळ सा यहूदीगोळ वाचुसदुर, “यतिकी अद जागा यल यीशु क्रूस मा येर्सकु आगीदुन नगर इन हाती ईरोद; अदिक चिट्ठी इब्रानी अदिक लतीनी अदिक ग्रीक भाषा दा लिख्सकु ईरोद. <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />आग यहूदीगोळ प्रधान याजकगोळ पिलातुस से अंदुर, ‘यहूदीगोळ राजा’ लिख्सबाळ लेकीन ईद कि ‘आव अंदुन’ ना यहूदीगोळ राजा हुईन.” <verse eid="JHN 19:21" /><verse number="22" style="v" sid="JHN 19:22" />पिलातुस उत्‍तर कोट्टुन, “ना जो लिख्स बुटीन, अद लिख्स बुटीन.” <verse eid="JHN 19:22" /><verse number="23" style="v" sid="JHN 19:23" />याग सैनिक यीशु उक क्रूस मा येर्स बुटुर, रा आऊन कपळा हुळकु नाक भाग माळदुर, हर सैनिक उन साटी ऊंद भाग, अदिक कुळता. भी ताकोंडुर, लेकीन कुळता. बिना होल्दकु म्याकुच टु ल्यालमा ताका बन्सकु ईरोद. <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />इदुरसाटी आंदुर आपस दा अंदुर, “नाव इदरी हरालेव, लेकीन इदुर मा चिट्ठी हाक्‍केव कि ईद यार्द आदीत.” ईद इदुरसाटी आत कि पवित्रशास्त्र दा जो लिख्सकु आद पुरा आगुल</para>
  <para style="p" vid="JHN 19:24">“आंदुर नान कपळा आपस दा वाट्स बुटुर अदिक नान कपळा मा चिट्ठी हाकदुर.” <verse eid="JHN 19:24" /><verse number="25" style="v" sid="JHN 19:25" />इदुरसाटी सैनिकगोळ हिंग अच माळदुर. यीशु उन क्रूस इन हाती आऊन मोय, अदिक आऊन मोय इन आकतींग, क्लोपास उन हिंग्स मरियम, अदिक मरियम मगदलीनी निदुरकु ईरोर. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />याग यीशु तान मोय, अदिक आ चेला अक यार से आव प्यार ईटतोगोन हात्‍ती निदुरकु नोळदुन रा तान मोय से अंदुन, “हे मोयी, नोळ, ईव नीन पार हुन.” <verse eid="JHN 19:26" /><verse number="27" style="v" sid="JHN 19:27" />आग आव चेला से अंदुन, “ईक नीन मोय उर.” अदिक अदा समय टु आव चेला आकी तान मान्या ओतुन.<verse eid="JHN 19:27" /></para>
  <para style="s">यीशु उन मृत्यु</para>
  <para style="r">(<ref loc="MAT 27:45-56">मत्ती २७:४५-५६</ref>; <ref loc="MRK 15:33-41">मरकुस १५:३३-४१</ref>; <ref loc="LUK 23:44-49">लूका २३:४४-४९</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />इदुर बाद्दा यीशु ईद जान्सकु कि ईग सप्पा येनारा पुरा आगेग्याद, इदुरसाटी कि पवित्रशास्त्र दा जो अंदकु आगीत अद पुरा आगुल, अंदुन, “ना प्यासा आईन.” <verse eid="JHN 19:28" /><verse number="29" style="v" sid="JHN 19:29" />अल हुळ्लग अंगुर इन रास्सा देल तुमकु ऊंद बरतन ईटकु ईरोद, इदुरसाटी आंदुर अंगुर इन रास्सा दा नेनाक्द ऊंद स्पंज इक हिस्सप इन डगालगोळ मा ईटदुर अदिक म्याकुच नेगुकु, आऊन बाय इक हचदुर. <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />याग यीशु अद सिरका हुळदुन अदिक अंदुन, “पुरा आत.” अदिक ताल्ला ल्यालमा माळकु जीव बिट बुटुन.<verse eid="JHN 19:30" /></para>
  <para style="s">भाला देल छेद माळोद</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />इदुरसाटी कि अद तयारी अन दिन ईरोद यहूदीगोळ पिलातुस से विनती माळदुर कि आंदुर कालगोळी मुर्दकु आगुल अदिक आंदुर ईळ्सकु आगुल, ताकी आराम इन दिशी आंदुर क्रूस मा ईरबाळुल, यतिकी अद आराम इन दिन धोळ्द दिन ईरोद. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />इदुरसाटी सैनिकगोळ बंदकु आ मंळसागोळ दा टु पयला मंळसा अन कालगोळी मुरदुर आग दुसरा अन भी, जो यीशु उन सांगुळ क्रूस मा येर्सकु आगीदुर; <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />लेकीन यीशु उन हात्‍ती बंदकु नोळदुर कि आव सोतोग्यान, रा आऊन कालगोळी मुरदीदील. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />लेकीन सैनिकगोळ दा टु ऊंद सैनिक बरची देल आऊंद हतोरी दा छेद माळदुन, अदिक अदुर दा टु तुरन्त खुन अदिक नीर होळ्त. <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />याव ईद नोळदुन, आव गवाही कोटान, अदिक आऊन गवाही खरा आद; अदिक आव जान्सतान कि आव सही अनतान कि नीव भी विश्वास माळी. <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />ई मातगोळ इदुरसाटी आदव कि पवित्रशास्त्र दा जो अनकु आगीत अद पुरा आगुल, “आऊंद यातोदु येलु मुरूकु आगतीदील.” <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" /><note caller="+" style="x"><char style="xo" closed="false">१९:३७ </char><char style="xt" closed="false"><ref loc="REV 1:7">प्रकाशितवाक्य १:७</ref></char></note>मात्‍त ऊंद अदिक शास्त्र दा ईद लिख्सकु आद, “यारी आंदुर छेद माळ्यार, अदुर मा आंदुर नजर हाक्यार.”<verse eid="JHN 19:37" /></para>
  <para style="s">यीशु उक नळ्सकु आगोद</para>
  <para style="r">(<ref loc="MAT 27:57-61">मत्ती २७:५७-६१</ref>; <ref loc="MRK 15:42-47">मरकुस १५:४२-४७</ref>; <ref loc="LUK 23:50-56">लूका २३:५०-५६</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />ई मातगोळ बाद्दा अरिमतिया अन यूसुफ जो यीशु उन चेला ईरोन, लेकीन यहूदीगोळ अंज्क देल ई मात इक होचकु ईटतोगोन, पिलातुस से विनती माळदुन कि येन आव यीशु उन लाश ओय सकतान. पिलातुस आऊन विनती केळदुन, अदिक आव बंदकु आऊन लाश ओतुन. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" /><note caller="+" style="x"><char style="xo" closed="false">१९:३९ </char><char style="xt" closed="false"><ref loc="JHN 3:1">यूहन्ना ३:१</ref>,<ref loc="JHN 3:2">२</ref></char></note>नीकुदेमुस भी, जो यीशु उन हात्‍ती ईळ्लकी होगीदुन, पचास सेर इन लगभग मिलुस्द अत्‍तर अदिक एलवा तंदुन. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />आग आंदुर यीशु उन लाश ताकोंडुर, अदिक यहूदीगोळ नळसोद रीति अन अनुसार आऊक सुगन्ध द्रव इन सांगुळ मलमल इन चद्दर दा गुंळ्सदुन. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />आ जागा मा यल यीशु क्रूस मा येर्सकु आगीदुन, ऊंद बेली ईरोद, अदिक आ बेली दा ऊंद व्हाशोद कब्र ईरोद यल यागलु यारदु लाश ईटकु ईला आगीत. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />इदुरसाटी यहूदीगोळ तयारी अन दिन इन कारण आंदुर यीशु उक अदुर दा ईटदुर, यतिकी अद कब्र हाती ईरोद.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">खाली कब्र</para>
  <para style="r">(<ref loc="MAT 28:1-8">मत्ती २८:१-८</ref>; <ref loc="MRK 16:1-8">मरकुस १६:१-८</ref>; <ref loc="LUK 24:1-12">लूका २४:१-१२</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />हप्ता अन पयला दिशी मरियम मगदलीनी व्हातर्या का अंधार ईरतेला अच कब्र मा बंदुर, अदिक कल्ल इक कब्र मा टु हटुस्कु नोळदुर. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />आग आक ओळतेला होदुर अदिक शमौन पतरस अदिक आ दुसरा चेला अन हात्‍ती यार से यीशु प्यार ईटतोगोन, बंदकु अंदुर, “आंदुर प्रभु उक कब्र दा टु तेगुकु ओतुर, अदिक नाव जानसालेव कि आऊक येल ईट बुटार.” <verse eid="JHN 20:2" /><verse number="3" style="v" sid="JHN 20:3" />आग पतरस अदिक आव दुसरा चेला होटकु कब्र अन दी होदुर. <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />आंदुर येढ्ढु मुंदुर सांगुळ सांगुळ ओळोर, लेकीन दुसरा चेला पतरस से मुंद वाळुसकु कब्र मा पयले पोहचुसदुन; <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />अदिक बांगकु कफन इन कपळा बिदकु नोळदुन, तरी आव बुळ्क होगीदील. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />आग शमौन पतरस आऊन हिंद हिंद पोहचुसदुन, अदिक कब्र अन बुळ्क होदुन अदिक कफन इन कपळा बिदकु नोळदुन; <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />अदिक अद गमछा जो आऊन ताल्ला अक कटकु ईरोद, कफन इन कपळागोळ सांगुळ बिदकु ईला ईरोद, लेकीन अलग ऊंद जागा दा लपटुसकु ईटकु नोळदुन. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />आग दुसरा चेला भी जो कब्र मा पयले पोहचुसीदुन, बुळ्क होदुन अदिक नोळकु विश्वास माळदुन. <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />आंदुर रा ईगासताका पवित्रशास्त्र अन अद मात ईला समसीदुर कि आऊक सोत्‍तुर दा टु जित्‍ता आगोद बिद्दीत. <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />आग ई चेलागोळ तान मान्नी होटोदुर.<verse eid="JHN 20:10" /></para>
  <para style="s">मरियम मगदलीनी मा प्रगट आगोद</para>
  <para style="r">(<ref loc="MAT 28:9">मत्ती २८:९</ref>,<ref loc="MAT 28:10">१०</ref>; <ref loc="MRK 16:9-11">मरकुस १६:९-११</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />लेकीन मरियम वर्लतेला कब्र अन हात्‍ती अच व्हार्या निदुरकु ईत्‍तुर, अदिक वर्ल्त वर्ल्त कब्र अन दी बांगकु, <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />येढ्ढ स्वर्गदूतगोळ इक बिळेव कपळा हाक्‍कु ऊंद इक ताल्ला अन दी अदिक दुसरा अक काल इन दी कुर्तकु नोळदुर, यल यीशु उन लाश ईटकु आगीत. <verse eid="JHN 20:12" /><verse number="13" style="v" sid="JHN 20:13" />आंदुर आकिन से अंदुर, “हे नारी, नी येती वर्लत्या?” आक आंदुर से अंदुर, “आंदुर नान प्रभु उक नेगुकु ओतुर अदिक ना जानसालीन कि आऊक येल ईट्यार.” <verse eid="JHN 20:13" /><verse number="14" style="v" sid="JHN 20:14" />ईद अनकु आक हिंद नोळदुर अदिक यीशु उक निदुरकु नोळदुर, लेकीन पहचानसीदील कि ईव यीशु हुन. <verse eid="JHN 20:14" /><verse number="15" style="v" sid="JHN 20:15" />यीशु आकिन से अंदुन, “हे नारी, नी येती वर्लत्या? यारी ढुंढ्सत्या?” आक माली सम्सकु आऊन से अंदुर, “हे महाराज, अगर नी आऊक नेगु कोंड्या रा नानी हेळ कि आऊक येल ईट्या, अदिक ना आऊक ओयाईन.” <verse eid="JHN 20:15" /><verse number="16" style="v" sid="JHN 20:16" />यीशु आकिन से अंदुन, “मरियम!” आक हिंद नोळकु आऊन से इब्रानी भाषा दा अंदुर, “रब्बूनी!” मतलब “हे गुरु.” <verse eid="JHN 20:16" /><verse number="17" style="v" sid="JHN 20:17" />यीशु आकिन से अंदुन, “नानी मुटबाळ, यतिकी ना ईगासताका आप्प उन हात्‍ती म्याकुच होगली आईन, लेकीन नान वार्टुर हात्‍ती होगकु आंदुर से अंद बुळ, कि ना तान आप्प अदिक नीम आप्प, अदिक तान परमेश्वर अदिक नीम परमेश्वर उन हात्‍ती म्याकुच होगतीन.” <verse eid="JHN 20:17" /><verse number="18" style="v" sid="JHN 20:18" />मरियम मगदलीनी होगकु चेलागोळी हेळदुर, “ना प्रभु उक नोळदीन, अदिक आव नान से ई मातगोळी अंदुन.”<verse eid="JHN 20:18" /></para>
  <para style="s">चेलागोळ मा प्रगट आगोद</para>
  <para style="r">(<ref loc="MAT 28:16-20">मत्ती २८:१६-२०</ref>; <ref loc="MRK 16:14-18">मरकुस १६:१४-१८</ref>; <ref loc="LUK 24:36-49">लूका २४:३६-४९</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />अदा दिशी जो हप्ता अन पयला दिन ईरोद, द्यावगा अन होती याग अलेव दरवाजा येल चेलागोळ ईरोर, यहूदीगोळ अंज्क इन मारा देल बंद ईरव, आग यीशु बंदुन अदिक आंदुर न्याड्या दा निदुरकु आंदुर से अंदुन, “नीमी शांती सिकुल.” <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />अदिक ईद अनकु आव तान कय अदिक तान हतोरी आंदरी तोर्सदुन. आग चेलागोळ प्रभु उक नोळकु खुश आदुर. <verse eid="JHN 20:20" /><verse number="21" style="v" sid="JHN 20:21" />यीशु आंदुर से मात्‍त अंदुन, “नीमी शांती सिकुल; ह्यांग आप्प नानी कळ्यान, हांग अच ना भी नीमी कळुतीन.” <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />ईद अनकु आव आंदुर मा ऊरदुन अदिक आंदुर से अंदुन, “पवित्र आत्मा हुडी. <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" /><note caller="+" style="x"><char style="xo" closed="false">२०:२३ </char><char style="xt" closed="false"><ref loc="MAT 16:19">मत्ती १६:१९</ref>; <ref loc="MAT 18:18">१८:१८</ref></char></note>यार पाप नीव माफ माळी, अव आंदुर साटी माफ माळकु आग्याव; यार नीव ईटी, अव ईटकु आग्याव.”<verse eid="JHN 20:23" /></para>
  <para style="s">थोमा मा प्रगट आगोद</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />लेकीन हन्नेळ दा टु ऊंद, मतलब थोमा जो दिदुमुस कहलुस्तान, याग यीशु बंदुन रा आंदुर सांगुळ ईला ईरोन. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />याग अन्य चेलागोळ आऊन से अनली कुरतुर, “नाव प्रभु उक नोळेव,” आग आव आंदुर से अंदुन, “यागासताका ना आऊन कयगोळ दा खिल्लागोळ छेद नोळ कोमालीन, अदिक खिल्लागोळ छेद दा तान बेळ्ल हाक्‍क कोमालीन, अदिक आऊन हतोरी दा तान कय हाक्‍क कोमालीन, आगासताका ना विश्वास माळतीदील.” <verse eid="JHN 20:25" /><verse number="26" style="v" sid="JHN 20:26" />येठ्ठ दिन इन बाद्दा आऊन चेलागोळ मात्‍त मान्ना अन बुळ्क ईरोर, अदिक थोमा आंदुर सांगुळ ईरोन; अदिक दरवाजा बंद ईरव, आग यीशु बंदुन अदिक आंदुर बीच दा निदुरकु अंदुन, “नीमी शांती सिकुल.” <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />आग आव थोमा से अंदुन, “तान बेळ्ल ईल तनकु नान कयगोळी नोळ अदिक तान कय तनकु नान कुसी दा हाक्‍क, अदिक अविश्वासी ईला लेकीन विश्वासी आग.” <verse eid="JHN 20:27" /><verse number="28" style="v" sid="JHN 20:28" />ईद केळकु थोमा उत्‍तर कोट्टुन, “हे नान प्रभु, हे नान परमेश्वर!” <verse eid="JHN 20:28" /><verse number="29" style="v" sid="JHN 20:29" />यीशु आऊन से अंदुन, “नी नानी नोळ्या, येन इदुरसाटी विश्वास माळ्द? धन्य आंदुर आर यार बिना नोळ्द विश्वास माळदुर.”<verse eid="JHN 20:29" /></para>
  <para style="s">ई किताब इन उद्देश</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />यीशु अदिक भी हापाळ सा चमत्कार चेलागोळ मुंद तोर्सदुन, जो ई किताब दा लिख्सकु आगीदील; <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />लेकीन ईव इदुरसाटी लिख्सकु आदव कि नीव विश्वास माळी कि यीशु अच परमेश्वर उन पार मसीह हुन, अदिक विश्वास माळी कि आऊन हेसुर देल जीवन सिक्‍कुल.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">तिबिरियास झील इन किनारा चेलागोळ मा प्रगट आगोद</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />ई मातगोळ बाद्दा यीशु तान तान इक तिबिरियास झील इन किनारा चेलागोळ मा प्रगट माळदुन, अदिक ई रीति देल प्रगट माळदुन: <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />शमौन पतरस, अदिक थोमा जो दिदुमुस कहलुस्तान, अदिक गलील इन काना नगर इन नतनएल, अदिक जब्दी अन पार, अदिक आऊन चेलागोळ दा टु येढ्ढ मुंदुर जमा ईरोर. <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" /><note caller="+" style="x"><char style="xo" closed="false">२१:३ </char><char style="xt" closed="false"><ref loc="LUK 5:5">लूका ५:५</ref></char></note>शमौन पतरस आंदुर से अंदुन, “ना मेन हुडुली होगेतीन.” आंदुर आऊन से अंदुर, “नाव भी नीन सांगुळ बरतेव.” इदुरसाटी आंदुर होटकु ड्वांगा मा येरदुर, लेकीन आ ईळ्लकी येनु हुळदीदील. <verse eid="JHN 21:3" /><verse number="4" style="v" sid="JHN 21:4" />व्हातुर आगतेला अच यीशु किनारा मा बंदकु निदुरदुन; तरी चेलागोळ पहचानसीदील कि ईव यीशु हुन. <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />आग यीशु आंदुर से अंदुन, “हे चिकोरगोळा, येन नीम हात्‍ती येनारा मेनगोळ आव?” आंदुर उत्‍तर कोट्टुर, “ईला.” <verse eid="JHN 21:5" /><verse number="6" style="v" sid="JHN 21:6" /><note caller="+" style="x"><char style="xo" closed="false">२१:६ </char><char style="xt" closed="false"><ref loc="LUK 5:6">लूका ५:६</ref></char></note>आव आंदुर से अंदुन, “ड्वांगा अन ऊमा कय इन दी जार हाक्‍की रा सिक्‍केव.” इदुरसाटी आंदुर जार हाकदुर, अदिक सप्पा मेनगोळ बहुतायत इन कारण अदरी जेडु सकिदील. <verse eid="JHN 21:6" /><verse number="7" style="v" sid="JHN 21:7" />आग आ चेला यार से यीशु प्यार ईटतोगोन, पतरस से अंदुन, “ईव रा प्रभु हुन!” शमौन पतरस ईद केळकु कि आव प्रभु हुन, नेळु मा गमछा कसुसदुन, यतिकी आव बिना कपळा नव ईरोन, अदिक झील दा हारेदुन. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />लेकीन दुसरा चेलागोळ ड्वांगा मा मेनगोळ देल तुमकु जार जेडुतेला बंदुर, यतिकी आंदुर किनारा टु यक्कुल दुर ईला ईरोर, लेकीन येनारा येढ्ढ सौ कय मा ईरोर.<verse eid="JHN 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 21:9" />याग आंदुर किनारा मा ईळदुर, रा आंदुर कॉरसा अन बेक्‍की अदिक अदुर मा मेन ईटकु, अदिक रोट्टी नोळदुर. <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />यीशु आंदुर से अंदुन, “जो मेनगोळी नीव ईगल्या हुळदीर, अऊर दा टु येनारा तरी.” <verse eid="JHN 21:10" /><verse number="11" style="v" sid="JHN 21:11" />रा शमौन पतरस ड्वांगा मा येरकु ऊंद सौ तिरूपन धोड्डेव मेनगोळ देल तुमकु जार किनारा मा जेळदुन, अदिक ईस मेनगोळ ईत्‍तुर मा भी जार हरदीदील. <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />यीशु आंदुर से अंदुन, “बरी, भोजन माळी.” चेलागोळ दा टु यारूकु साहस आगीदील कि आऊन से केळुल, “नी याव हुय?” यतिकी आंदुर जानसोर कि ईव प्रभु अच हुन. <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />यीशु बंदुन अदिक रोट्टी हुळकु आंदरी कोट्टुन, अदिक हांग अच मेन भी. <verse eid="JHN 21:13" /><verse number="14" style="v" sid="JHN 21:14" />ईद तिसरा बार हुन कि यीशु सोत्‍तुर दा टु जित्‍ता आगदुर बाद्दा चेलागोळी कांळ्सदुन.<verse eid="JHN 21:14" /></para>
  <para style="s">यीशु अदिक पतरस</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />भोजन माळदुर बाद्दा यीशु शमौन पतरस से अंदुन, “हे शमौन, यूहन्ना अन पार, येन नी इंदुर से वाळुसकु नान से प्यार ईटत्या?” आव आऊन से अंदुन, “हव, प्रभु; नी रा जान्सत्या कि ना नीन से प्यार ईटतीन.” आव आऊन से अंदुन, “नान म्यांडा अन पाड्डागोळी आळ्स.” <verse eid="JHN 21:15" /><verse number="16" style="v" sid="JHN 21:16" />आव मात्‍त दुसरा घन आऊन से अंदुन, “हे शमौन, यूहन्ना अन पार, येन नी नान से प्यार ईटत्या?” आव आऊन से अंदुन, “हव, प्रभु; नी रा जान्सत्या कि ना नीन से प्यार ईटतीन.” आव आऊन से अंदुन, “नान म्यांडागोळ रखवाली माळ.” <verse eid="JHN 21:16" /><verse number="17" style="v" sid="JHN 21:17" />आव तिसरा घन आऊन से अंदुन, “हे शमौन, यूहन्ना अन पार, येन नी नान से प्यार ईटत्या?” पतरस उदास आदुन कि यीशु आऊन से तिसरा घन अंदुन, “येन नी नान से प्यार ईटत्या?” अदिक आऊन से अंदुन, “हे प्रभु, नी रा सप्पा येनारा जान्सत्या; नी ईद जान्सत्या कि ना नीन से प्यार ईटतीन.” यीशु आऊन से अंदुन, “नान म्यांडागोळी आळ्स. <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />ना नीन से सही सही अनतीन, याग नी हारोदव ईर्या रा तान नेळु कटकु येल चाहस्या अल टेटाळ्या; लेकीन नी याग हाळाबाट आद्या रा तान कय फैलुस्या, अदिक दुसरा नीन नेळु कटकु येल नी चाहासतीदील अल नीनी वोतान.” <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />आव ई मातगोळ देल इशारा कोट्टुन कि पतरस ह्यांग मृत्यु देल परमेश्वर उन महिमा माळ्यान. अदिक आग आव आऊन से अंदुन, “नान हिंद आगेग.”<verse eid="JHN 21:19" /></para>
  <para style="s">यीशु अदिक आऊन प्रिय चेला</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२१:२० </char>
      <char style="xt" closed="false">
        <ref loc="JHN 13:25">यूहन्ना १३:२५</ref>
      </char>
    </note>पतरस पलटुस्कु आ चेला अक हिंद बरतेला नोळदुन, यार से यीशु प्यार ईटतोगोन, अदिक याव भोजन इन समय आऊन याद्दा अन दी बांगकु केळीदुन, “हे प्रभु, नीनी हुळसुसावाळा याव हुन?” <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />आऊक नोळकु पतरस यीशु से अंदुन, “हे प्रभु, ईऊंद येन हाल आदीत?” <verse eid="JHN 21:21" /><verse number="22" style="v" sid="JHN 21:22" />यीशु आऊन से अंदुन, “अगर ना चाहासाईन कि आव नान बरासताका रूक्सकु ईरूल, रा नीनी इदुर से येन? नी नान हिंद आगेग.” <verse eid="JHN 21:22" /><verse number="23" style="v" sid="JHN 21:23" />इदुरसाटी वार्टुर दा ईद मात फैलुसेत कि आव चेला सायतीदील, तरी यीशु आऊन से ईद अंदिदील कि आव सायतीदील, लेकीन ईद कि “अगर ना चाहासाईन कि आव नान बरासताका रूक्सकु ईरूल, रा नीनी इदुर से येन?”<verse eid="JHN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />ईव आवा चेला हुन जो ई मातगोळ गवाही कोळतान अदिक याव ई मातगोळी लिखस्यान, अदिक नाव जान्सतेव कि आऊन गवाही खरा आद.<verse eid="JHN 21:24" /></para>
  <para style="s">उपसंहार</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />अदिक भी हापाळ सा क्याल्सा आव, जो यीशु माळदुन; अगर अव ऊंद ऊंद माळकु लिख्सकु आगायदव, रा ना सम्सतीन कि किताबगोळ जो लिख्सकु आगायदव अव दुनिया दा भी ईला समुसयदव.<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>