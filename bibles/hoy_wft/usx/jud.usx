<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JUD" style="id">- Holiya</book>
  <para style="h">यहूदा</para>
  <para style="toc3">यहूदा</para>
  <para style="toc2">यहूदा</para>
  <para style="toc1">यहूदा अन्द चिट्ठी</para>
  <para style="mt2">यहूदा की पत्री</para>
  <para style="mt1">यहूदा अन्द चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">यहूदा हेसुर इन चिट्ठी इन हेसुर इदुर लेखक उन हेसुर मा ईटकु आग्याद. यहूदा खुद इक याकूब, यीशु उन वार्ट उन रूप दा अरूतान. इदुरसाटी आव भी यीशु उन वार्टुर दा टु ऊंद मान्सकु आगतान <char style="xt"><ref loc="JUD 1:1">१</ref></char>. नाव जान्सालेव कि ई चिट्ठी ऊंद विशिष्ट मंडली इन साटी ईरोद अदिक हाळोद नियम इन संदर्भगोळ कारण, यहूदा अन्द मुल पाठकगोळ्द संभावना यहूदीगोळ से आगीत. हालाकि, आव तान चिट्ठी इक संबोधित माळतान “आ सप्पा मुंदुर इक यारी कारूकु आग्याद, यारी आप्प उन से प्यार आद अदिक यीशु मसीह अन्द साटी ईटकु आद” <char style="xt"><ref loc="JUD 1:1">१</ref></char>. ईद चिट्ठी शायद मसीह अन्द जनम इन ६० साल इन बाद्दा लिख्सकु आगीत.</para>
  <para style="ip">सप्पा इसाईगोळी चिट्ठी लिखसोद आंदुर उद्देश आंदरी ख्वाटा गुरुगोळ <char style="xt"><ref loc="JUD 1:4">यहूदा १:४</ref></char> द्वारा भटकुसोद खिलाप चेतावनी कोळोद हुन. आव हाळोद नियम इन घटनागोळ अदिक खातागोळी आंदुर तर्कगोळी ताकत कोळोर साटी संदर्भित माळतान. ईद चिट्ठी दुसरा पतरस उन चिट्ठी इन सांगुळ ख्वाटा गुरुगोळ <char style="xt"><ref loc="JUD 1:4">यहूदा १:४</ref></char>, <char style="xt"><ref loc="2PE 2:1">२ पतरस २:१</ref></char> सांगुळ-सांगुळ स्वर्गदूतगोळ अदिक सदोम अदिक अमोरा अन्द संदर्भगोळ्द खिलाप चेतावनी सहित हापाळ विचार मुंद तरतद.</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. यहूदा पयले तान पाठकगोळी संबोधित माळतान. <char style="ior"><ref loc="JUD 1:1-2">१:१-२</ref></char></para>
  <para style="io1">२. ईदुर बाद्दा, आव लेखन इन साटी तान कारण कोळतान जो आंदरी ख्वाटा गुरुगोळ्द खिलाप चेतावनी कोळोद हुन. <char style="ior"><ref loc="JUD 1:3-4">१:३-४</ref></char></para>
  <para style="io1">३. अदुर बाद्दा आव हाळोद नियम दा लॉकुर अदिक घटनागोळ्द उदाहरण कोळतान. <char style="ior"><ref loc="JUD 1:5-16">१:५-१६</ref></char></para>
  <para style="io1">४. बाक आव आंदरी हेळतान कि आंदुर प्रतिक्रिया चेतावनी इन साटी येन ईर पायजे. <char style="ior"><ref loc="JUD 1:17-23">१:१७-२३</ref></char></para>
  <para style="io1">५. आखरी दा आव आ चिट्ठी इक परमेश्वर उन स्तुति माळकु खतम माळ बुळतान. <char style="ior"><ref loc="JUD 1:24-25">१:२४-२५</ref></char></para>
  <chapter number="1" style="c" sid="JUD 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१:१ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 13:55">मत्ती १३:५५</ref>; <ref loc="MRK 6:3">मरकुस ६:३</ref></char>
    </note>यहूदा अन दी टु जो यीशु मसीह अन दास अदिक याकूब उन वार्ट हुन,</para>
  <para style="p" vid="JUD 1:1">जो कार्सकु आग्यार आंदुर हेसुर जो परमेश्वर आप्प दा प्रिय अदिक यीशु मसीह अन साटी सुरक्षित आन.<verse eid="JUD 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JUD 1:2"/>दया अदिक शांती अदिक प्यार नीमी हापाळ सा प्राप्त आगतेला ईरूल.<verse eid="JUD 1:2"/></para>
  <para style="s">ख्वाटा गुरु</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3"/>हे प्रिय संगीगोळा, याग ना नीमी आ उद्धार इन बारा दा लिख्सदुर दा हापाळ मेहनत देल कोशिश माळीन यदुर दा नाव सप्पा सहभागी आयेव, रा ना नीमी ईद समझुसोद जरूरी सम्सदीन कि नीमी प्रोत्साहित माळाईन आ विश्वास इन साटी पुरा कोशिश माळी जो पवित्र लॉकुरी ऊंद अच घन सौप्सकु आगीत. <verse eid="JUD 1:3"/><verse number="4" style="v" sid="JUD 1:4"/>यतिकी यास ईत्‍ता मंळसा चुपचाप नाम दा बंदकु सिकदुर, यार्द ई दण्ड इन वर्णन हाळोद समय दा पयले टु अच भविष्यवाणी माळकु आगीत: हिंग लॉकुर परमेश्वर उन बिना, अदिक हिंग लॉकुर परमेश्वर उन अनुग्रह अक लुचपन दा बदलुस बुळतार, अदिक नाम ऊंद मात्र स्वामी अदिक प्रभु यीशु मसीह अन इनकार माळतार.<verse eid="JUD 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5"/>लेकीन नीव सप्पा मात ऊंद घन जान्स कोंडीर, तरी ना नीमी ई मात इन सुधी कोळोद चाहासतीन कि प्रभु ऊंद कुल इक मिस्त्र द्याश टु बीळ्सदुर बाद्दा विश्वास ईला तरावाळेर इक नाश माळ बुट्टुन. <verse eid="JUD 1:5"/><verse number="6" style="v" sid="JUD 1:6"/>बाक जो स्वर्गदूतगोळ तान धोळ्द पद इक संची ईटीदील उलटा तान निज निवास इक बिट बुट्टुर, आव आंदरी भी आ भीषण दिन इन न्याय इन साटी अंधकार दा, जो सदा काल इन साटी आद बंधनगोळ दा ईटकु आद. <verse eid="JUD 1:6"/><verse number="7" style="v" sid="JUD 1:7"/>याता रीति देल सदोम अदिक गमोरा अदिक आंदुर आसपास इन नगर, जो स्वर्गदूतगोळ घाई व्यभिचारी आगेगीदुर अदिक पराया मय इन हिंद हत्‍तेगीदुर बेक्‍की इन अनन्त दण्ड दा बिदकु उदाहरण ठहरूस्यार.<verse eid="JUD 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8"/>अदा रीति देल ई स्वप्नदर्शी भी तान तान मय इक अशुध्द माळतार, अदिक परमेश्वर उक तुच्छ जान्सतार, अदिक दिव्य स्वर्गदूतगोळ इक बुरा भला अनतार. <verse eid="JUD 1:8"/><verse number="9" style="v" sid="JUD 1:9"/><note caller="+" style="x"><char style="xo" closed="false">१:९ </char><char style="xt" closed="false"><ref loc="REV 12:7">प्रकाशितवाक्य १२:७</ref></char></note>लेकीन प्रधान स्वर्गदूत मीकाईल, याग शैतान से मूसा अन लाश इन बारा दा वाद विवाद माळदुन, रा आऊक बुरा भला अनकु दोष हचोद साहस माळीदील लेकीन ईद अंदुन, “प्रभु नींद न्याय माळुल.” <verse eid="JUD 1:9"/><verse number="10" style="v" sid="JUD 1:10"/>लेकीन ई लॉकुर याता मातगोळी जान्सालुर आंदरी बुरा भला अनतार, अदिक याता मातगोळी अचेतन पशुगोळ घाई स्वभाव देल अच जान्सतार, आंदुर दा तान तान इक नाश माळतार. <verse eid="JUD 1:10"/><verse number="11" style="v" sid="JUD 1:11"/>आंदुर मा हाय! यतिकी आंदुर कैन इन चाल नळदुर, अदिक पैस्या अन लोभ इन साटी बिलाम इन घाई भ्रष्ट आगेग्यार, अदिक कोरह अन घाई विरोध माळकु नाश आग्यार. <verse eid="JUD 1:11"/><verse number="12" style="v" sid="JUD 1:12"/>ईद नीम प्यार भोज दा आ होचकु चट्टानगोळ घाई आद जो घातक आद. जो सिर्फ तान स्वार्थ इंद अच चिंता माळतार. अदिक बिना नीर इन बादल इन घाई आर, आंदुर पतझळ इन ईत्‍ता मार्र उर यदुर मा काय ईराल्द आंदुर येढ्ढ घन सोतकु आर अदिक आंदरी जळ देल कीतकु आग्याद. <verse eid="JUD 1:12"/><verse number="13" style="v" sid="JUD 1:13"/>इंदुर समुद्र अन प्रचंड लयर उर, जो तान शरम इन फेस भिळतार; इंदुर डावाडोल तारा उर, यार साटी परमेश्वर सनातन काल ताका घोर अंधकार ईट्यान.<verse eid="JUD 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14"/>हनोक भी जो आदम टु सातवा पीढ़ी दा ईरोन, इंदुर बारा दा ईद भविष्यवाणी माळदुन, “नोळी, प्रभु तान हजारो पवित्र स्वर्गदूतगोळ सांगुळ बंदान.” <verse eid="JUD 1:14"/><verse number="15" style="v" sid="JUD 1:15"/>कि सप्पा मुंदुर न्याय माळुल, अदिक सप्पा भक्तिहीनगोळी आंदुर अभक्ति इन सप्पा क्याल्सागोळ बारा दा जो आंदुर भक्तिहीन आगकु माळ्यार, अदिक आ सप्पा कठोर मातगोळ बारा दा जो भक्तिहीन पापीगोळ आऊन विरोध दा अंदार, दोषी ठहरूसुल.<verse eid="JUD 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JUD 1:16"/>इंदुर रा असंतुष्ट, कुळकुळुसावाळेर, अदिक तान बेकार लालसागोळ्द अनुसार नळावाळेर उर, अदिक तान बाय देल घमण्ड इन मातगोळ माताळतार, अदिक आंदुर लाभ इन साटी बाय नोळकु बळाई माळतार.<verse eid="JUD 1:16"/></para>
  <para style="s">चेतावनी अदिक उपदेश</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17"/>लेकीन हे प्रियगोळा, नीव आ मातगोळी याद ईटी जो नाम प्रभु यीशु मसीह अन प्रेरित पयले अच अन कोंडार. <verse eid="JUD 1:17"/><verse number="18" style="v" sid="JUD 1:18"/><note caller="+" style="x"><char style="xo" closed="false">१:१८ </char><char style="xt" closed="false"><ref loc="2PE 3:3">२ पतरस ३:३</ref></char></note>इदुरसाटी आंदुर नीम से अनतोगोर, “आखरी दिनगोळ दा हिंग मज्याक माळावाळेर ईत्‍तार जो तान भक्तिहीन लालसा अन अनुसार नळदार.” <verse eid="JUD 1:18"/><verse number="19" style="v" sid="JUD 1:19"/>इंदुर आंदुर उर जो फूट हाकतार; इंदुर जो शारीरिक इच्छागोळ्द निमंत्रण दा आर, यारदा परमेश्वर उन आत्मा हैलेच. <verse eid="JUD 1:19"/><verse number="20" style="v" sid="JUD 1:20"/>लेकीन हे प्रिय संगीगोळा, नीव तान अति पवित्र विश्वास दा उन्नती माळतेला अदिक पवित्र आत्मा दा प्रार्थना माळतेला, <verse eid="JUD 1:20"/><verse number="21" style="v" sid="JUD 1:21"/>तान तान इक परमेश्वर उन प्यार दा माळकु ईटी; अदिक अनन्त जीवन इन साटी नाम प्रभु यीशु मसीह अन दया अन हादी कायतेला ईरी.<verse eid="JUD 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22"/>आंदुर मा जो शंका दा आर दया माळी; <verse eid="JUD 1:22"/><verse number="23" style="v" sid="JUD 1:23"/>अदिक हापाळ मुंदरी बेक्‍की दा टु झपटुसकु तेगी; अदिक हापाळ मुंदुर मा अंज्क इन सांगुळ दया माळी, लेकीन आंदुर्द कपळागोळ से भी सिट्ट माळी जो मय इन द्वारा कलंकीत आगेग्याद.<verse eid="JUD 1:23"/></para>
  <para style="s">आर्शिवाद</para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24"/>ईग जो नीमी आऊन प्रती बिळदुर देल ऊळ्स सकतान, अदिक तान महिमा अन भरपुरी इन मुंद निर्दोष निदरूस सकतान, <verse eid="JUD 1:24"/><verse number="25" style="v" sid="JUD 1:25"/>आ ऊंद मात्र परमेश्वर नामव उद्धारकर्ता अन महिमा अदिक गौरव अदिक पराक्रम अदिक अधिकार, नामव प्रभु यीशु मसीह अन द्वारा ह्यांग अनन्त काल टु आद, ईग भी आगुल अदिक हमेशा हमेशा ईरूल. आमीन.<verse eid="JUD 1:25"/></para>
  <chapter eid="JUD 1"/>
</usx>
