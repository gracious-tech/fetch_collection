<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="OBA" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">俄巴底亚书</para>
  <para style="mt">俄巴底亚书</para>
  <chapter number="1" style="c" sid="OBA 1" />
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1" />
    <char style="pn">俄巴底亚</char>的异象<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">异象——或译作“启示”。</char></note>。</para>
  <para style="s" vid="OBA 1:1">以东必遭审判</para>
  <para style="p" vid="OBA 1:1">我们从耶和华听见了消息，有一位信使被派到列国中，说：“起来！让我们起来与<char style="pn">以东</char>作战。”</para>
  <para style="p" vid="OBA 1:1">主耶和华论到<char style="pn">以东</char>如此说：<verse eid="OBA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2" />看哪，我要使你成为列国中最小的，</para>
  <para style="q1" vid="OBA 1:2">你必被极度藐视。<verse eid="OBA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3" />
    <char style="pn">以东</char>啊<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">以东啊——辅助词语。</char></note>，你安居在山岩缝隙中，</para>
  <para style="q1" vid="OBA 1:3">稳坐在高峰上，</para>
  <para style="q1" vid="OBA 1:3">你心中的狂傲蒙蔽了你，</para>
  <para style="q1" vid="OBA 1:3">你心里说：</para>
  <para style="q1" vid="OBA 1:3">“谁能把我拽落到地上呢？”<verse eid="OBA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4" />即使你如鹰在高处飞翔，</para>
  <para style="q1" vid="OBA 1:4">即使你在星辰之间搭窝，</para>
  <para style="q1" vid="OBA 1:4">我也要把你从那里拽落下来。</para>
  <para style="q1" vid="OBA 1:4">这是耶和华的宣告。<verse eid="OBA 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5" />如果盗贼来到你那里，</para>
  <para style="q1" vid="OBA 1:5">如果强盗夜间来到，</para>
  <para style="q1" vid="OBA 1:5">他们岂不是任意偷窃吗？</para>
  <para style="q1" vid="OBA 1:5">如果摘葡萄的来到你那里，</para>
  <para style="q1" vid="OBA 1:5">他们岂不是只留下遗落的葡萄吗？</para>
  <para style="q1" vid="OBA 1:5">唉，你将怎样被摧毁啊！<verse eid="OBA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6" />
    <char style="pn">以扫</char>将怎样被搜刮一空，</para>
  <para style="q1" vid="OBA 1:6">他藏匿的财物将怎样被搜出！<verse eid="OBA 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7" />与你立约的盟友，</para>
  <para style="q1" vid="OBA 1:7">都将把你赶出境外；</para>
  <para style="q1" vid="OBA 1:7">与你和平相处的人，</para>
  <para style="q1" vid="OBA 1:7">将欺哄你，征服你；</para>
  <para style="q1" vid="OBA 1:7">与你同席吃饭的人，</para>
  <para style="q1" vid="OBA 1:7">将在你脚下布设网罗。</para>
  <para style="q1" vid="OBA 1:7">你在这些事上毫无聪明！<verse eid="OBA 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8" />到那日，</para>
  <para style="q1" vid="OBA 1:8">我难道不会从<char style="pn">以东</char>消灭智慧人，</para>
  <para style="q1" vid="OBA 1:8">从<char style="pn">以扫</char>山地消灭聪明人吗？</para>
  <para style="q1" vid="OBA 1:8">这是耶和华的宣告。<verse eid="OBA 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9" />
    <char style="pn">提幔</char>哪，你的勇士们必丧胆，</para>
  <para style="q1" vid="OBA 1:9">以致<char style="pn">以扫</char>山地的人都被屠杀剪除。<verse eid="OBA 1:9" /></para>
  <para style="b" />
  <para style="s">以东对犹大的罪行</para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10" />因为你恶待你的兄弟<char style="pn">雅各</char>，</para>
  <para style="q1" vid="OBA 1:10">你必被羞耻淹没，永远被剪除。<verse eid="OBA 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11" />当外族人掳走<char style="pn">雅各</char>的财富，</para>
  <para style="q1" vid="OBA 1:11">当外邦人闯入<char style="pn">雅各</char>的众城门，</para>
  <para style="q1" vid="OBA 1:11">又为<char style="pn">耶路撒冷</char>抽签的时候，</para>
  <para style="q1" vid="OBA 1:11">那日你却站在一旁，</para>
  <para style="q1" vid="OBA 1:11">你甚至像他们中的一员。<verse eid="OBA 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12" />在你兄弟遭灾祸的日子，</para>
  <para style="q1" vid="OBA 1:12">你不该漠然观望；</para>
  <para style="q1" vid="OBA 1:12">在<char style="pn">犹大</char>子孙灭亡的日子，</para>
  <para style="q1" vid="OBA 1:12">你不该幸灾乐祸；</para>
  <para style="q1" vid="OBA 1:12">在那患难的日子，</para>
  <para style="q1" vid="OBA 1:12">你不该夸口自高；<verse eid="OBA 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13" />在我子民遭难的日子，</para>
  <para style="q1" vid="OBA 1:13">你不该闯入他们的城门；</para>
  <para style="q1" vid="OBA 1:13">在他们遭难的日子，</para>
  <para style="q1" vid="OBA 1:13">你也不该漠然观望他们的祸患；</para>
  <para style="q1" vid="OBA 1:13">在他们遭难的日子，</para>
  <para style="q1" vid="OBA 1:13">你不该伸手抢他们的财富；<verse eid="OBA 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14" />在那患难的日子，</para>
  <para style="q1" vid="OBA 1:14">你不该站在岔路口</para>
  <para style="q1" vid="OBA 1:14">剪除他们逃脱的人，</para>
  <para style="q1" vid="OBA 1:14">不该把他们的幸存者交出去。<verse eid="OBA 1:14" /></para>
  <para style="b" />
  <para style="s">主审判万国的日子</para>
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15" />耶和华的日子临近万国了，</para>
  <para style="q1" vid="OBA 1:15">他必照着你所行的对待你，</para>
  <para style="q1" vid="OBA 1:15">你的报应将归到你头上。<verse eid="OBA 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16" />
    <char style="pn">犹大</char>人在我的圣山上</para>
  <para style="q1" vid="OBA 1:16">怎样喝了苦杯<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">苦杯——辅助词语。</char></note>，</para>
  <para style="q1" vid="OBA 1:16">万国也将照样不停地喝；</para>
  <para style="q1" vid="OBA 1:16">他们边喝边吞咽，</para>
  <para style="q1" vid="OBA 1:16">醉得像是不曾存在。<verse eid="OBA 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17" />但在<char style="pn">锡安</char>山上必有幸存者，</para>
  <para style="q1" vid="OBA 1:17">那山将成为圣地；</para>
  <para style="q1" vid="OBA 1:17">
    <char style="pn">雅各</char>家必得回自己的产业。<verse eid="OBA 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18" />
    <char style="pn">雅各</char>家将成为烈火，</para>
  <para style="q1" vid="OBA 1:18">
    <char style="pn">约瑟</char>家将成为火焰；</para>
  <para style="q1" vid="OBA 1:18">
    <char style="pn">以扫</char>家却将成为麦秸，</para>
  <para style="q1" vid="OBA 1:18">被点燃，被吞噬，</para>
  <para style="q1" vid="OBA 1:18">
    <char style="pn">以扫</char>家必没有一人存活。</para>
  <para style="q1" vid="OBA 1:18">这是耶和华说的。<verse eid="OBA 1:18" /></para>
  <para style="b" />
  <para style="s">以色列未来的祝福</para>
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19" />南地<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="ft" closed="false">南地——音译作“内盖夫”；下同。</char></note>的人将拥有<char style="pn">以扫</char>山地，</para>
  <para style="q1" vid="OBA 1:19">丘陵地带的人将拥有<char style="pn">非利士</char>人之地<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="ft" closed="false">南地的人将拥有以扫山地，丘陵地带的人将拥有非利士人之地——或译作“以色列将拥有南地和以扫山地，丘陵地带和非利士人之地”。</char></note>；</para>
  <para style="q1" vid="OBA 1:19">他们将拥有</para>
  <para style="q1" vid="OBA 1:19">
    <char style="pn">以法莲</char>的土地和<char style="pn">撒玛利亚</char>的土地；</para>
  <para style="q1" vid="OBA 1:19">
    <char style="pn">便雅悯</char>人将拥有<char style="pn">基列</char>地。<verse eid="OBA 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20" />流亡在<char style="pn">哈腊</char><note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="ft" closed="false">在哈腊——或译作“队伍”；参《列王纪下》17:6。</char></note>的<char style="pn">以色列</char>子孙，</para>
  <para style="q1" vid="OBA 1:20">将拥有<char style="pn">迦南</char>人<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="ft" closed="false">迦南人——这里特指腓尼基人。</char></note>之地，直到<char style="pn">撒勒法</char>；</para>
  <para style="q1" vid="OBA 1:20">流亡在<char style="pn">西法拉</char>的<char style="pn">耶路撒冷</char>人，</para>
  <para style="q1" vid="OBA 1:20">将拥有南地的城镇。<verse eid="OBA 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21" />得救的人<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="ft" closed="false">得救的人——或译作“那些拯救者”。</char></note>将登上<char style="pn">锡安</char>山，</para>
  <para style="q1" vid="OBA 1:21">治理<char style="pn">以扫</char>山地；</para>
  <para style="q1" vid="OBA 1:21">国度将归于耶和华。<verse eid="OBA 1:21" /></para>
  <chapter eid="OBA 1" />
</usx>