<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EZR" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">以斯拉记</para>
  <para style="mt">以斯拉记</para>
  <chapter number="1" style="c" sid="EZR 1" />
  <para style="s">居鲁士王发布通告</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 1:1" />
    <char style="pn">波斯</char>王<char style="pn">居鲁士</char>元年，为了应验耶和华藉<char style="pn">耶利米</char>的口所说的话，耶和华触动<char style="pn">波斯</char>王<char style="pn">居鲁士</char>的心，使他向全国传令，并且发文通告：<verse eid="EZR 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EZR 1:2" />“<char style="pn">波斯</char>王<char style="pn">居鲁士</char>如此说：</para>
  <para style="mi" vid="EZR 1:2">天上的神耶和华把地上的万国都赐给了我，他也指派我在<char style="pn">犹大</char>的<char style="pn">耶路撒冷</char>为他建造殿宇。 <verse eid="EZR 1:2" /><verse number="3" style="v" sid="EZR 1:3" />所以你们当中无论是谁，凡是属神的子民，愿他的神与他同在，愿他上<char style="pn">犹大</char>的<char style="pn">耶路撒冷</char>去，建造<char style="pn">以色列</char>的神耶和华的殿，耶和华就是那在<char style="pn">耶路撒冷</char>的神。 <verse eid="EZR 1:3" /><verse number="4" style="v" sid="EZR 1:4" />这些余剩者，无论寄居在什么地方，那地方的人都要用金银、财物和牲畜支持他们，还要为<char style="pn">耶路撒冷</char>的神的殿奉献甘心祭。”<verse eid="EZR 1:4" /></para>
  <para style="s">掳民回归耶路撒冷</para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 1:5" />于是，<char style="pn">犹大</char>和<char style="pn">便雅悯</char>的各父系首领，祭司、<char style="pn">利未</char>人，凡是被神触动了心的人，都起来，要上去建造<char style="pn">耶路撒冷</char>的耶和华的殿。 <verse eid="EZR 1:5" /><verse number="6" style="v" sid="EZR 1:6" />他们周围的人都用银器、金子、财物、牲畜和珍宝来支持他们，还有各样甘愿奉献的礼物。 <verse eid="EZR 1:6" /><verse number="7" style="v" sid="EZR 1:7" /><char style="pn">居鲁士</char>王也拿出了耶和华殿的器皿，就是<char style="pn">尼布甲尼撒</char>从<char style="pn">耶路撒冷</char>取走，放在自己神明殿宇里的那些器皿。 <verse eid="EZR 1:7" /><verse number="8" style="v" sid="EZR 1:8" /><char style="pn">波斯</char>王<char style="pn">居鲁士</char>委派司库官<char style="pn">米特利达</char>把它们拿出来，清点了交给<char style="pn">犹大</char>的领袖<char style="pn">设巴萨</char>。 <verse eid="EZR 1:8" /><verse number="9" style="v" sid="EZR 1:9" />它们的数目如下：金盘三十个，银盘一千个，刀子<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">刀子——或译作“香炉”。</char></note>二十九把， <verse eid="EZR 1:9" /><verse number="10" style="v" sid="EZR 1:10" />金碟三十个，成套的银碟四百一十个<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">成套的银碟四百一十个——七十士译本作“银碟两千四百一十个”。</char></note>，别的器皿一千件； <verse eid="EZR 1:10" /><verse number="11" style="v" sid="EZR 1:11" />金银器皿总共有五千四百件。<char style="pn">设巴萨</char>带领那些掳民从<char style="pn">巴比伦</char>上<char style="pn">耶路撒冷</char>的时候，也把这些器皿都一同带了上来。<verse eid="EZR 1:11" /></para>
  <chapter eid="EZR 1" />
  <chapter number="2" style="c" sid="EZR 2" />
  <para style="s">回归的掳民</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 2:1" />以下是从流亡之地的掳民中上来的<char style="pn">犹大</char>省人，他们从前被<char style="pn">巴比伦</char>王<char style="pn">尼布甲尼撒</char>掳到了<char style="pn">巴比伦</char>，现在回归<char style="pn">耶路撒冷</char>和<char style="pn">犹大</char>，各回本城。 <verse eid="EZR 2:1" /><verse number="2" style="v" sid="EZR 2:2" />他们是跟着<char style="pn">所罗巴伯</char>、<char style="pn">耶书亚</char>、<char style="pn">尼希米</char>、<char style="pn">西莱雅</char>、<char style="pn">利耶拉雅</char>、<char style="pn">末迪凯</char>、<char style="pn">比尔杉</char>、<char style="pn">米斯帕尔</char>、<char style="pn">比格瓦伊</char>、<char style="pn">利户姆</char>、<char style="pn">巴纳</char>一起回来的。</para>
  <para style="p" vid="EZR 2:2">这些<char style="pn">以色列</char>民众，男人的数目如下：<verse eid="EZR 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZR 2:3" />
    <char style="pn">帕罗示</char>的子孙，两千一百七十二人；<verse eid="EZR 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZR 2:4" />
    <char style="pn">示法提雅</char>的子孙，三百七十二人；<verse eid="EZR 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZR 2:5" />
    <char style="pn">阿拉赫</char>的子孙，七百七十五人；<verse eid="EZR 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZR 2:6" />
    <char style="pn">帕哈摩押</char>的子孙，就是<char style="pn">耶书亚</char>的子孙和<char style="pn">约押</char>的子孙，两千八百一十二人；<verse eid="EZR 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZR 2:7" />
    <char style="pn">以拦</char>的子孙，一千两百五十四人；<verse eid="EZR 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZR 2:8" />
    <char style="pn">萨图</char>的子孙，九百四十五人；<verse eid="EZR 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZR 2:9" />
    <char style="pn">撒该</char>的子孙，七百六十人；<verse eid="EZR 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZR 2:10" />
    <char style="pn">巴尼</char>的子孙，六百四十二人；<verse eid="EZR 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZR 2:11" />
    <char style="pn">比巴伊</char>的子孙，六百二十三人；<verse eid="EZR 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZR 2:12" />
    <char style="pn">阿兹伽德</char>的子孙，一千两百二十二人；<verse eid="EZR 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZR 2:13" />
    <char style="pn">亚多尼卡姆</char>的子孙，六百六十六人；<verse eid="EZR 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZR 2:14" />
    <char style="pn">比格瓦伊</char>的子孙，两千零五十六人；<verse eid="EZR 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="EZR 2:15" />
    <char style="pn">阿丁</char>的子孙，四百五十四人；<verse eid="EZR 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="EZR 2:16" />
    <char style="pn">阿特尔</char>的子孙，就是<char style="pn">希西加</char>的后裔，九十八人；<verse eid="EZR 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="EZR 2:17" />
    <char style="pn">比扎伊</char>的子孙，三百二十三人；<verse eid="EZR 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="EZR 2:18" />
    <char style="pn">约拉</char>的子孙，一百一十二人；<verse eid="EZR 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="EZR 2:19" />
    <char style="pn">哈书姆</char>的子孙，两百二十三人；<verse eid="EZR 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="EZR 2:20" />
    <char style="pn">格巴尔</char>的子孙，九十五人；<verse eid="EZR 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="EZR 2:21" />
    <char style="pn">伯利恒</char>人，一百二十三人；<verse eid="EZR 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="EZR 2:22" />
    <char style="pn">尼托法</char>人，五十六人；<verse eid="EZR 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="EZR 2:23" />
    <char style="pn">亚纳图</char>人，一百二十八人；<verse eid="EZR 2:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="EZR 2:24" />
    <char style="pn">阿兹玛维</char>人，四十二人；<verse eid="EZR 2:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="EZR 2:25" />
    <char style="pn">基列-耶琳</char>人、<char style="pn">克非拉</char>人、<char style="pn">比录</char>人，七百四十三人；<verse eid="EZR 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="EZR 2:26" />
    <char style="pn">拉玛</char>人和<char style="pn">迦巴</char>人，六百二十一人；<verse eid="EZR 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="EZR 2:27" />
    <char style="pn">米克玛</char>人，一百二十二人；<verse eid="EZR 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="EZR 2:28" />
    <char style="pn">伯特利</char>和<char style="pn">艾</char>城的人，两百二十三人；<verse eid="EZR 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="EZR 2:29" />
    <char style="pn">尼波</char>人，五十二人；<verse eid="EZR 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="EZR 2:30" />
    <char style="pn">玛革比士</char>人，一百五十六人；<verse eid="EZR 2:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="EZR 2:31" />另一个<char style="pn">以拦</char>的子孙，一千两百五十四人；<verse eid="EZR 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="EZR 2:32" />
    <char style="pn">哈琳</char>的子孙，三百二十人；<verse eid="EZR 2:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="EZR 2:33" />
    <char style="pn">罗德</char>人、<char style="pn">哈迪</char>人、<char style="pn">阿挪</char>人，七百二十五人；<verse eid="EZR 2:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="EZR 2:34" />
    <char style="pn">耶利哥</char>人，三百四十五人；<verse eid="EZR 2:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="EZR 2:35" />
    <char style="pn">西纳</char>人，三千六百三十人。<verse eid="EZR 2:35" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="36" style="v" sid="EZR 2:36" />祭司有：</para>
  <para style="q1" vid="EZR 2:36">
    <char style="pn">耶书亚</char>家族的<char style="pn">耶达亚</char>子孙，九百七十三人；<verse eid="EZR 2:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="EZR 2:37" />
    <char style="pn">伊梅尔</char>的子孙，一千零五十二人；<verse eid="EZR 2:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="EZR 2:38" />
    <char style="pn">帕示户珥</char>的子孙，一千两百四十七人；<verse eid="EZR 2:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="EZR 2:39" />
    <char style="pn">哈琳</char>的子孙，一千零一十七人。<verse eid="EZR 2:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="EZR 2:40" />
    <char style="pn">利未</char>人有：</para>
  <para style="q1" vid="EZR 2:40">
    <char style="pn">耶书亚</char>的子孙和<char style="pn">卡米尔</char>的子孙，就是<char style="pn">赫达维亚</char>的后裔，七十四人。<verse eid="EZR 2:40" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="41" style="v" sid="EZR 2:41" />歌手有：</para>
  <para style="q1" vid="EZR 2:41">
    <char style="pn">亚萨</char>的子孙，一百二十八人。<verse eid="EZR 2:41" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="42" style="v" sid="EZR 2:42" />门卫的子孙有：</para>
  <para style="q1" vid="EZR 2:42">
    <char style="pn">沙勒姆</char>的子孙、<char style="pn">阿特尔</char>的子孙、</para>
  <para style="q1" vid="EZR 2:42">
    <char style="pn">达门</char>的子孙、<char style="pn">阿库布</char>的子孙、</para>
  <para style="q1" vid="EZR 2:42">
    <char style="pn">哈迪达</char>的子孙、<char style="pn">朔拜</char>的子孙，</para>
  <para style="q1" vid="EZR 2:42">总共一百三十九人。<verse eid="EZR 2:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="EZR 2:43" />圣殿仆役有：</para>
  <para style="q1" vid="EZR 2:43">
    <char style="pn">西哈</char>的子孙、<char style="pn">哈苏法</char>的子孙、<char style="pn">塔巴奥特</char>的子孙、<verse eid="EZR 2:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="EZR 2:44" />
    <char style="pn">克罗斯</char>的子孙、<char style="pn">希阿哈</char>的子孙、<char style="pn">巴顿</char>的子孙、<verse eid="EZR 2:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="EZR 2:45" />
    <char style="pn">利巴纳</char>的子孙、<char style="pn">哈伽巴</char>的子孙、<char style="pn">阿库布</char>的子孙、<verse eid="EZR 2:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="EZR 2:46" />
    <char style="pn">哈伽布</char>的子孙、<char style="pn">沙勒迈</char>的子孙、<char style="pn">哈南</char>的子孙、<verse eid="EZR 2:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="EZR 2:47" />
    <char style="pn">吉德列</char>的子孙、<char style="pn">伽哈尔</char>的子孙、<char style="pn">利阿亚</char>的子孙、<verse eid="EZR 2:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="EZR 2:48" />
    <char style="pn">利汛</char>的子孙、<char style="pn">尼克达</char>的子孙、<char style="pn">伽扎姆</char>的子孙、<verse eid="EZR 2:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="EZR 2:49" />
    <char style="pn">乌撒</char>的子孙、<char style="pn">帕西亚</char>的子孙、<char style="pn">比萨伊</char>的子孙、<verse eid="EZR 2:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="EZR 2:50" />
    <char style="pn">阿斯纳</char>的子孙、<char style="pn">米乌尼</char>的子孙、<char style="pn">尼弗舍欣</char>的子孙、<verse eid="EZR 2:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="EZR 2:51" />
    <char style="pn">巴布克</char>的子孙、<char style="pn">哈库法</char>的子孙、<char style="pn">哈尔胡尔</char>的子孙、<verse eid="EZR 2:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="EZR 2:52" />
    <char style="pn">巴兹路特</char>的子孙、<char style="pn">米希达</char>的子孙、<char style="pn">哈尔沙</char>的子孙、<verse eid="EZR 2:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="EZR 2:53" />
    <char style="pn">巴尔克斯</char>的子孙、<char style="pn">西西拉</char>的子孙、<char style="pn">特玛赫</char>的子孙、<verse eid="EZR 2:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="EZR 2:54" />
    <char style="pn">尼其亚</char>的子孙、<char style="pn">哈提法</char>的子孙。<verse eid="EZR 2:54" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="55" style="v" sid="EZR 2:55" />
    <char style="pn">所罗门</char>臣仆的子孙有：</para>
  <para style="q1" vid="EZR 2:55">
    <char style="pn">索泰</char>的子孙、<char style="pn">索菲列</char>的子孙、<char style="pn">培鲁达</char>的子孙、<verse eid="EZR 2:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="EZR 2:56" />
    <char style="pn">雅阿拉</char>的子孙、<char style="pn">达尔昆</char>的子孙、<char style="pn">吉德列</char>的子孙、<verse eid="EZR 2:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="EZR 2:57" />
    <char style="pn">示法提雅</char>的子孙、<char style="pn">哈提列</char>的子孙、</para>
  <para style="q1" vid="EZR 2:57">
    <char style="pn">波克列·泽巴音</char>的子孙、<char style="pn">亚米</char>的子孙。<verse eid="EZR 2:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="EZR 2:58" />圣殿仆役和<char style="pn">所罗门</char>臣仆的子孙，总共三百九十二人。<verse eid="EZR 2:58" /></para>
  <para style="b" />
  <para style="p">
    <verse number="59" style="v" sid="EZR 2:59" />从<char style="pn">特拉米拉</char>、<char style="pn">特拉哈萨</char>、<char style="pn">克鲁布</char>、<char style="pn">亚丹</char>、<char style="pn">伊梅尔</char>上来的人，无法说明自己的父家和世系<note caller="+" style="f"><char style="fr" closed="false">2:59 </char><char style="ft" closed="false">世系——或译作“后裔”。</char></note>是否属于<char style="pn">以色列</char>，这些人有：<verse eid="EZR 2:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="EZR 2:60" />
    <char style="pn">德拉雅</char>的子孙、<char style="pn">托比亚</char>的子孙、</para>
  <para style="q1" vid="EZR 2:60">
    <char style="pn">尼克达</char>的子孙，共六百五十二人。<verse eid="EZR 2:60" /></para>
  <para style="b" />
  <para style="p">
    <verse number="61" style="v" sid="EZR 2:61" />另外，祭司的子孙中，有<char style="pn">哈巴雅</char>的子孙、<char style="pn">哈克兹</char>的子孙、<char style="pn">巴尔兹莱</char>的子孙——这<char style="pn">巴尔兹莱</char>娶了<char style="pn">基列</char>人<char style="pn">巴尔兹莱</char>的女儿为妻，所以照着岳父家的名字称呼—— <verse eid="EZR 2:61" /><verse number="62" style="v" sid="EZR 2:62" />这些人在所记录的家谱中寻找有关自己的记录，却找不到，于是被算为不洁而革除了祭司职份。 <verse eid="EZR 2:62" /><verse number="63" style="v" sid="EZR 2:63" />省长告诫他们，不可吃至圣物，直到有一位使用乌陵和土明的祭司兴起。<verse eid="EZR 2:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="EZR 2:64" />全体会众，一共四万两千三百六十人。<verse eid="EZR 2:64" /></para>
  <para style="q1">
    <verse number="65" style="v" sid="EZR 2:65" />此外还有他们的仆婢，七千三百三十七人；</para>
  <para style="q1" vid="EZR 2:65">还有他们的男女歌手，两百人。<verse eid="EZR 2:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="EZR 2:66" />他们的马有七百三十六匹，</para>
  <para style="q1" vid="EZR 2:66">骡子有两百四十五匹，<verse eid="EZR 2:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="EZR 2:67" />骆驼有四百三十五匹，</para>
  <para style="q1" vid="EZR 2:67">驴子有六千七百二十匹。<verse eid="EZR 2:67" /></para>
  <para style="s">为神的殿奉献</para>
  <para style="p">
    <verse number="68" style="v" sid="EZR 2:68" />各父系的首领来到耶和华在<char style="pn">耶路撒冷</char>的居所时，他们中的一些人为神的殿甘愿奉献，为要在原来的根基上重建神的殿。 <verse eid="EZR 2:68" /><verse number="69" style="v" sid="EZR 2:69" />人们照着自己的能力，给工程的银库捐献了总共六万一千达利克金币<note caller="+" style="f"><char style="fr" closed="false">2:69 </char><char style="ft" closed="false">六万一千达利克金币——相当于512公斤金子。1达利克金币=8.4公克。</char></note>，五千弥纳银币<note caller="+" style="f"><char style="fr" closed="false">2:69 </char><char style="ft" closed="false">五千弥纳银币——相当于2,850公斤银子。1弥纳银币=570公克。</char></note>，一百件祭司的礼服。<verse eid="EZR 2:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="EZR 2:70" />那时，祭司、<char style="pn">利未</char>人、一些民众、歌手、门卫和圣殿仆役住在各自的城中，其他<char style="pn">以色列</char>人也都住在各自的城中。<verse eid="EZR 2:70" /></para>
  <chapter eid="EZR 2" />
  <chapter number="3" style="c" sid="EZR 3" />
  <para style="s">恢复献祭</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 3:1" />到了七月，<char style="pn">以色列</char>子民都在各自的城中了。那时，民众如同一人聚集到<char style="pn">耶路撒冷</char>。 <verse eid="EZR 3:1" /><verse number="2" style="v" sid="EZR 3:2" /><char style="pn">约萨达</char>的儿子<char style="pn">耶书亚</char>和他的兄弟众祭司，以及<char style="pn">撒拉铁</char>的儿子<char style="pn">所罗巴伯</char>和他的兄弟们，就起来重建<char style="pn">以色列</char>神的祭坛，要照着神人<char style="pn">摩西</char>的律法上所记的，在祭坛上献燔祭。 <verse eid="EZR 3:2" /><verse number="3" style="v" sid="EZR 3:3" />虽然各地的民众恐吓他们，他们还是在原来的基座上修筑了祭坛，在祭坛上向耶和华献燔祭，就是清晨和傍晚的燔祭。 <verse eid="EZR 3:3" /><verse number="4" style="v" sid="EZR 3:4" />他们照着律法<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">律法——辅助词语。</char></note>上所记的守住棚节，每天按照规定的份额、照着数目献上当天的燔祭。 <verse eid="EZR 3:4" /><verse number="5" style="v" sid="EZR 3:5" />之后，他们献上常献的燔祭、新月节的祭物、耶和华神圣节期的所有祭物，以及甘愿奉献给耶和华的一切甘心祭。<verse eid="EZR 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 3:6" />从七月一日起，他们开始向耶和华献上燔祭，那时耶和华的圣殿还没有奠定根基。 <verse eid="EZR 3:6" /><verse number="7" style="v" sid="EZR 3:7" />他们又照着<char style="pn">波斯</char>王<char style="pn">居鲁士</char>给他们的许可，把银子交给石匠和木匠，又把食物、酒和油交给<char style="pn">西顿</char>人和<char style="pn">提尔</char>人，好让他们把香柏木从<char style="pn">黎巴嫩</char>经海上运到<char style="pn">约帕</char>。<verse eid="EZR 3:7" /></para>
  <para style="s">重建圣殿</para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 3:8" />他们来到<char style="pn">耶路撒冷</char>的神的殿之后，在第二年的二月，<char style="pn">撒拉铁</char>的儿子<char style="pn">所罗巴伯</char>、<char style="pn">约萨达</char>的儿子<char style="pn">耶书亚</char>，还有他们其余的兄弟——那些祭司和<char style="pn">利未</char>人，以及掳民中所有归回<char style="pn">耶路撒冷</char>的人，就开始动工。他们安排二十岁以上的<char style="pn">利未</char>人来监管耶和华殿的工程。 <verse eid="EZR 3:8" /><verse number="9" style="v" sid="EZR 3:9" />于是，<char style="pn">赫达维亚</char><note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="ft" closed="false">赫达维亚——或音译“耶胡达、犹大”；参《以斯拉记》2:40。</char></note>的后裔<char style="pn">耶书亚</char>和他的儿子们、兄弟们以及<char style="pn">卡米尔</char>和他的儿子们，还有<char style="pn">利未</char>人<char style="pn">希纳达</char>的子孙、兄弟们，一同合作监管那些在神的殿工作的人。<verse eid="EZR 3:9" /></para>
  <para style="s">奠定圣殿根基</para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 3:10" />当工匠们奠定耶和华圣殿的根基时，祭司们穿着礼服、拿着号筒，<char style="pn">利未</char>人<char style="pn">亚萨</char>的子孙拿着大钹，他们都照着<char style="pn">以色列</char>王<char style="pn">大卫</char>的规定站立着，赞美耶和华。 <verse eid="EZR 3:10" /><verse number="11" style="v" sid="EZR 3:11" />他们赞美称谢耶和华，歌唱说：</para>
  <para style="q1" vid="EZR 3:11">“他是美善的，</para>
  <para style="q1" vid="EZR 3:11">他对<char style="pn">以色列</char>的慈爱永远长存！”</para>
  <para style="b" vid="EZR 3:11" />
  <para style="p" vid="EZR 3:11">他们赞美耶和华的时候，全体民众大声呼喊，因为耶和华殿的根基奠定了。 <verse eid="EZR 3:11" /><verse number="12" style="v" sid="EZR 3:12" />有许多祭司、<char style="pn">利未</char>人和父系首领，就是那些见过先前殿宇的长老们，如今亲眼看见这殿的根基奠定了，就放声大哭，也有许多人扬声欢呼庆祝。 <verse eid="EZR 3:12" /><verse number="13" style="v" sid="EZR 3:13" />人们甚至无法分辨欢呼庆祝的声音和哭号的声音，因为民众大声呼喊，声音一直传到远处。<verse eid="EZR 3:13" /></para>
  <chapter eid="EZR 3" />
  <chapter number="4" style="c" sid="EZR 4" />
  <para style="s">重建圣殿受阻挠</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 4:1" />
    <char style="pn">犹大</char>和<char style="pn">便雅悯</char>的敌人听说那些回归的掳民在为<char style="pn">以色列</char>的神耶和华重建圣殿， <verse eid="EZR 4:1" /><verse number="2" style="v" sid="EZR 4:2" />就来见<char style="pn">所罗巴伯</char>和各父系的首领，对他们说：“让我们与你们一同建造吧！我们也像你们一样寻求你们的神，从<char style="pn">亚述</char>王<char style="pn">以撒哈顿</char>把我们迁到这里的日子以来，我们一直都向你们的神献祭。”<verse eid="EZR 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 4:3" />但<char style="pn">所罗巴伯</char>和<char style="pn">耶书亚</char>以及<char style="pn">以色列</char>其余的父系首领对他们说：“我们为我们的神建造殿宇，与你们无关；我们是照着<char style="pn">波斯</char>的王——<char style="pn">居鲁士</char>王所吩咐的，要自己为<char style="pn">以色列</char>的神耶和华建造。”<verse eid="EZR 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZR 4:4" />于是，当地的人就使<char style="pn">犹大</char>民众的手发软，阻挠他们建造， <verse eid="EZR 4:4" /><verse number="5" style="v" sid="EZR 4:5" />还收买官员来反对他们，破坏他们的工程计划。在<char style="pn">波斯</char>王<char style="pn">居鲁士</char>所有的日子里，一直到<char style="pn">波斯</char>王<char style="pn">大流士</char>在位时，都是这样。<verse eid="EZR 4:5" /></para>
  <para style="s">重建耶路撒冷受阻挠</para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 4:6" />
    <char style="pn">亚哈随鲁</char>王在位初期，那些人写了一封控告信，指控<char style="pn">犹大</char>和<char style="pn">耶路撒冷</char>的居民。 <verse eid="EZR 4:6" /><verse number="7" style="v" sid="EZR 4:7" /><char style="pn">亚达薛西</char>年间，<char style="pn">比施兰</char>、<char style="pn">米特利达</char>、<char style="pn">塔别</char>以及他们其余的同僚，上书<char style="pn">波斯</char>王<char style="pn">亚达薛西</char>，公文的文书是用<char style="pn">亚兰</char>语写下、用<char style="pn">亚兰</char>语转述的。 <verse eid="EZR 4:7" /><verse number="8" style="v" sid="EZR 4:8" />行政长官<char style="pn">利户姆</char>和书记<char style="pn">希姆沙伊</char>也给<char style="pn">亚达薛西</char>王写了一封指控<char style="pn">耶路撒冷</char>的奏章：<verse eid="EZR 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZR 4:9" />“谨有行政长官<char style="pn">利户姆</char>、书记<char style="pn">希姆沙伊</char>和他们其余的同僚，司法官、行政官员、各级官员，<char style="pn">波斯</char>人、<char style="pn">乌鲁克</char>人、<char style="pn">巴比伦</char>人、<char style="pn">苏萨</char>人——就是<char style="pn">以拦</char>人， <verse eid="EZR 4:9" /><verse number="10" style="v" sid="EZR 4:10" />以及其余的民族，就是被伟大尊贵的<char style="pn">亚斯纳巴</char>迁移，安置在<char style="pn">撒玛利亚</char>城和<char style="pn">幼发拉底</char>河对岸其余地区的民族，现在 <verse eid="EZR 4:10" /><verse number="11" style="v" sid="EZR 4:11" />有呈送给王的奏章副本如下：</para>
  <para style="mi" vid="EZR 4:11">致<char style="pn">亚达薛西</char>王，</para>
  <para style="mi" vid="EZR 4:11">我们是<note caller="+" style="f"><char style="fr" closed="false">4:11 </char><char style="ft" closed="false">我们是——辅助词语。</char></note>你的臣民，是<char style="pn">幼发拉底</char>河对岸地区的人。现在 <verse eid="EZR 4:11" /><verse number="12" style="v" sid="EZR 4:12" />愿王知道，从王那里上到我们这里的<char style="pn">犹太</char>人，已经到了<char style="pn">耶路撒冷</char>，正在重建这座邪恶、反叛的城，就要建好城墙，打好根基了。 <verse eid="EZR 4:12" /><verse number="13" style="v" sid="EZR 4:13" />如今愿王知道，如果这城被重建，城墙被建好，他们就不会交纳税捐、贡物和路税了，王的财政收入就会受损。 <verse eid="EZR 4:13" /><verse number="14" style="v" sid="EZR 4:14" />如今我们既然吃宫廷的盐，就不应该看着王蒙受亏损<note caller="+" style="f"><char style="fr" closed="false">4:14 </char><char style="ft" closed="false">蒙受亏损——原文直译“蒙羞”。</char></note>，因此我们上奏禀告， <verse eid="EZR 4:14" /><verse number="15" style="v" sid="EZR 4:15" />请王调查先王的记事档案，从记事档案中查找，就会明白这城是反叛之城，曾使君王和各省受损。从久远的日子以来，这城就常常发生叛乱，因此才被摧毁。 <verse eid="EZR 4:15" /><verse number="16" style="v" sid="EZR 4:16" />我们禀告王：如果这城被重建，城墙被建好，那么王在<char style="pn">幼发拉底</char>河对岸地区必将一无所有。”<verse eid="EZR 4:16" /></para>
  <para style="s">亚达薛西王的回复</para>
  <para style="p">
    <verse number="17" style="v" sid="EZR 4:17" />王就发谕旨给行政长官<char style="pn">利户姆</char>、书记<char style="pn">希姆沙伊</char>和他们其余的同僚，就是住在<char style="pn">撒玛利亚</char>和<char style="pn">幼发拉底</char>河对岸其余地区的人：</para>
  <para style="mi" vid="EZR 4:17">“愿你们平安！</para>
  <para style="mi" vid="EZR 4:17">现在 <verse eid="EZR 4:17" /><verse number="18" style="v" sid="EZR 4:18" />你们呈送来的公函，已经在我面前清楚地诵读了。 <verse eid="EZR 4:18" /><verse number="19" style="v" sid="EZR 4:19" />我已下令调查，查出这城从久远的日子以来就常常背叛王，发生造反和叛乱的事。 <verse eid="EZR 4:19" /><verse number="20" style="v" sid="EZR 4:20" />从前有强势的君王管理<char style="pn">耶路撒冷</char>，有掌权者治理整个<char style="pn">幼发拉底</char>河对岸地区，那时税捐、贡物和路税都交给了他们。 <verse eid="EZR 4:20" /><verse number="21" style="v" sid="EZR 4:21" />现在你们要命令这些人停工；我若不下令，这城就不可重建。 <verse eid="EZR 4:21" /><verse number="22" style="v" sid="EZR 4:22" />你们当谨慎，做这件事不可疏忽。何必让损害增加，使王受亏损呢？”<verse eid="EZR 4:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="EZR 4:23" />
    <char style="pn">亚达薛西</char>王的公函副本在<char style="pn">利户姆</char>、书记<char style="pn">希姆沙伊</char>和他们的同僚面前诵读后，他们就急忙前往<char style="pn">耶路撒冷</char>，到<char style="pn">犹太</char>人那里去，以强权和武力使他们停工。<verse eid="EZR 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 4:24" />这样，<char style="pn">耶路撒冷</char>的神殿工程就停工了，一直停工到<char style="pn">波斯</char>王<char style="pn">大流士</char>执政的第二年。<verse eid="EZR 4:24" /></para>
  <chapter eid="EZR 4" />
  <chapter number="5" style="c" sid="EZR 5" />
  <para style="s">重启圣殿工程</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 5:1" />那时有两位先知，就是先知<char style="pn">哈该</char>和<char style="pn">易多</char>的孙子<char style="pn">撒迦利亚</char>，奉那差遣他们的<char style="pn">以色列</char>神的名，说神言鼓励那些在<char style="pn">犹大</char>和<char style="pn">耶路撒冷</char>的<char style="pn">犹太</char>人。 <verse eid="EZR 5:1" /><verse number="2" style="v" sid="EZR 5:2" />于是<char style="pn">撒拉铁</char>的儿子<char style="pn">所罗巴伯</char>和<char style="pn">约萨达</char>的儿子<char style="pn">耶书亚</char>起来，开始重建<char style="pn">耶路撒冷</char>的神殿；神的众先知与他们在一起，扶持他们。<verse eid="EZR 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 5:3" />当时，<char style="pn">幼发拉底</char>河对岸地区的省长<char style="pn">达奈</char>，还有<char style="pn">示塔·波斯奈</char>和他们的同僚，来到<char style="pn">犹太</char>人那里，对他们这样说：“谁下令让你们重建这殿宇，完成这建筑的？” <verse eid="EZR 5:3" /><verse number="4" style="v" sid="EZR 5:4" />又问他们：“重建这建筑的那些人叫什么名字？”<note caller="+" style="f"><char style="fr" closed="false">5:4 </char><char style="ft" closed="false">此节依据七十士译本和有些古抄本；马索拉文本作“我们如实告诉了他们，重建这建筑的那些人叫什么名字。”</char></note> <verse eid="EZR 5:4" /><verse number="5" style="v" sid="EZR 5:5" />然而，神的眼目一直看顾<char style="pn">犹太</char>人的长老们，那些人就没有让他们停工，而是等待报告送交<char style="pn">大流士</char>后，得到相关的回复公函。<verse eid="EZR 5:5" /></para>
  <para style="s">呈给大流士王的奏章</para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 5:6" />
    <char style="pn">幼发拉底</char>河对岸地区的省长<char style="pn">达奈</char>，还有<char style="pn">示塔·波斯奈</char>和他的同僚，就是在<char style="pn">幼发拉底</char>河对岸地区的官员们，向<char style="pn">大流士</char>王呈送奏章副本。 <verse eid="EZR 5:6" /><verse number="7" style="v" sid="EZR 5:7" />他们呈送给王的报告，其中这样写着：</para>
  <para style="mi" vid="EZR 5:7">“致<char style="pn">大流士</char>王：</para>
  <para style="mi" vid="EZR 5:7">愿王万事平安！<verse eid="EZR 5:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="EZR 5:8" />愿王知道，我们前往<char style="pn">犹大</char>省，到了伟大之神的殿。那殿正在用巨大的块石重建，梁木也安置在墙中；这工作得到认真执行，在他们手中进展顺利。 <verse eid="EZR 5:8" /><verse number="9" style="v" sid="EZR 5:9" />我们就问这些长老，对他们这样说：‘谁下令让你们重建这殿宇，完成这建筑的？’ <verse eid="EZR 5:9" /><verse number="10" style="v" sid="EZR 5:10" />我们还问了他们的名字，要把那些为首之人的名字写下来，禀告王。<verse eid="EZR 5:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="EZR 5:11" />那些人这样答复我们说：</para>
  <para style="mi" vid="EZR 5:11">‘我们是天地之神的仆人，正在重建这多年前所建造的殿宇。这是一位伟大的<char style="pn">以色列</char>王所建造并完成的， <verse eid="EZR 5:11" /><verse number="12" style="v" sid="EZR 5:12" />只是因为我们的祖先惹天上的神震怒，神就把他们交在<char style="pn">迦勒底</char>人<char style="pn">巴比伦</char>王<char style="pn">尼布甲尼撒</char>手中，<char style="pn">尼布甲尼撒</char>王拆毁了这殿宇，并把民众迁移到<char style="pn">巴比伦</char>。 <verse eid="EZR 5:12" /><verse number="13" style="v" sid="EZR 5:13" />然而<char style="pn">巴比伦</char>王<char style="pn">居鲁士</char>元年，<char style="pn">居鲁士</char>王下令重建这座神殿。 <verse eid="EZR 5:13" /><verse number="14" style="v" sid="EZR 5:14" />而且神殿的金银器皿，就是<char style="pn">尼布甲尼撒</char>从<char style="pn">耶路撒冷</char>的圣殿中取走带到<char style="pn">巴比伦</char>殿宇的，<char style="pn">居鲁士</char>王也从<char style="pn">巴比伦</char>的殿宇中拿出来，交给了王所设立的省长，名叫<char style="pn">设巴萨</char>。 <verse eid="EZR 5:14" /><verse number="15" style="v" sid="EZR 5:15" />王吩咐<char style="pn">设巴萨</char>把这些器皿带上去，存放在<char style="pn">耶路撒冷</char>的圣殿里，并在原处重建神的殿。 <verse eid="EZR 5:15" /><verse number="16" style="v" sid="EZR 5:16" />于是这<char style="pn">设巴萨</char>前来，立定了<char style="pn">耶路撒冷</char>神殿的根基。从那时直到如今，神的殿一直在建造，但没有完工。’<verse eid="EZR 5:16" /></para>
  <para style="mi">
    <verse number="17" style="v" sid="EZR 5:17" />现在如果王认为好，就请在<char style="pn">巴比伦</char>王室案卷的库房里调查，看<char style="pn">居鲁士</char>王是否曾下令重建<char style="pn">耶路撒冷</char>这座神殿。然后请王下达关于这事的旨意给我们。”<verse eid="EZR 5:17" /></para>
  <chapter eid="EZR 5" />
  <chapter number="6" style="c" sid="EZR 6" />
  <para style="s">大流士王的调查</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 6:1" />于是<char style="pn">大流士</char>王下令，在<char style="pn">巴比伦</char>存放案卷的档案库里调查。 <verse eid="EZR 6:1" /><verse number="2" style="v" sid="EZR 6:2" />在<char style="pn">米底亚</char><note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="ft" closed="false">米底亚——原文作“玛代”。</char></note>省的<char style="pn">亚马塔</char>城堡中，他们找到一个书卷，其中这样写着：</para>
  <para style="mi" vid="EZR 6:2">“记事： <verse eid="EZR 6:2" /><verse number="3" style="v" sid="EZR 6:3" /><char style="pn">居鲁士</char>王元年，<char style="pn">居鲁士</char>王下令：关于在<char style="pn">耶路撒冷</char>的神殿，要重建这殿宇作为献祭的地方，并且立定它的根基。这殿宇要高六十肘<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false">六十肘——相当于27.4公尺；下同。1肘=45.7公分。</char></note>，宽六十肘， <verse eid="EZR 6:3" /><verse number="4" style="v" sid="EZR 6:4" />有三层大石头和一层新木料；经费由王室提供。 <verse eid="EZR 6:4" /><verse number="5" style="v" sid="EZR 6:5" />至于神殿的金银器皿，就是<char style="pn">尼布甲尼撒</char>从<char style="pn">耶路撒冷</char>的圣殿中取走带到<char style="pn">巴比伦</char>的，也要带回去，送到<char style="pn">耶路撒冷</char>圣殿中，各归原处，存放在神的殿中。”<verse eid="EZR 6:5" /></para>
  <para style="s">大流士王的命令</para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 6:6" />于是王下令<note caller="+" style="f"><char style="fr" closed="false">6:6 </char><char style="ft" closed="false">于是王下令——辅助词语。</char></note>：</para>
  <para style="mi" vid="EZR 6:6">“现在，<char style="pn">幼发拉底</char>河对岸地区的省长<char style="pn">达奈</char>、<char style="pn">示塔·波斯奈</char>和你们的同僚，就是在<char style="pn">幼发拉底</char>河对岸地区的官员们，你们当远离那里。 <verse eid="EZR 6:6" /><verse number="7" style="v" sid="EZR 6:7" />不要干涉这座神殿的工程，要让<char style="pn">犹太</char>人的省长和<char style="pn">犹太</char>人的长老们在原处重建这座神殿。<verse eid="EZR 6:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="EZR 6:8" />我下令指示你们怎样协助这些<char style="pn">犹太</char>人的长老重建这座神殿：要从王的财政，就是<char style="pn">幼发拉底</char>河对岸地区的税捐中，提供充足的经费给这些人，以免停工。 <verse eid="EZR 6:8" /><verse number="9" style="v" sid="EZR 6:9" />他们所需要的任何东西，无论是献给天上的神作燔祭的公牛犊、公绵羊和公羊羔，还是小麦、盐、酒和油，都要照着<char style="pn">耶路撒冷</char>的祭司们的吩咐，每天提供给他们，不可疏忽。 <verse eid="EZR 6:9" /><verse number="10" style="v" sid="EZR 6:10" />这样，他们可以向天上的神献上馨香之祭，并为王和王子们的福寿祷告。<verse eid="EZR 6:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="EZR 6:11" />我还下令：任何人更改这谕旨，就要从他的房屋上拆出一根梁木，把他举起来钉在上面，他的家必因此成为废堆。 <verse eid="EZR 6:11" /><verse number="12" style="v" sid="EZR 6:12" />任何君王或臣民，如果擅自更改这谕旨<note caller="+" style="f"><char style="fr" closed="false">6:12 </char><char style="ft" closed="false">擅自更改这谕旨——原文直译“伸手更改”。</char></note>，毁坏<char style="pn">耶路撒冷</char>的这座神殿，就愿那使自己的名安居其中的神灭绝他！我<char style="pn">大流士</char>已经下令，必须认真执行。”<verse eid="EZR 6:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="EZR 6:13" />这样，<char style="pn">幼发拉底</char>河对岸地区的省长<char style="pn">达奈</char>、<char style="pn">示塔·波斯奈</char>和他们的同僚，就遵照<char style="pn">大流士</char>王下达的命令<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">命令——辅助词语。</char></note>，认真执行。 <verse eid="EZR 6:13" /><verse number="14" style="v" sid="EZR 6:14" /><char style="pn">犹太</char>人的长老们也在先知<char style="pn">哈该</char>和<char style="pn">易多</char>的孙子<char style="pn">撒迦利亚</char>的神言鼓励下，继续建造，进展顺利。他们照着<char style="pn">以色列</char>的神的命令，照着<char style="pn">居鲁士</char>、<char style="pn">大流士</char>、<char style="pn">波斯</char>王<char style="pn">亚达薛西</char>的命令，建造并完成了。 <verse eid="EZR 6:14" /><verse number="15" style="v" sid="EZR 6:15" />在<char style="pn">大流士</char>王执政的第六年，亚达月的第三日，这圣殿完工了。<verse eid="EZR 6:15" /></para>
  <para style="s">圣殿的奉献礼和逾越节</para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 6:16" />
    <char style="pn">以色列</char>人，包括祭司、<char style="pn">利未</char>人和其余的回归掳民，就欢欢喜喜地为这座神殿举行奉献礼。 <verse eid="EZR 6:16" /><verse number="17" style="v" sid="EZR 6:17" />他们为这座神殿的奉献礼献上一百头公牛、两百只公绵羊、四百只公羊羔；又按着<char style="pn">以色列</char>支派的数目，献上十二只公山羊，作为全<char style="pn">以色列</char>的赎罪祭。 <verse eid="EZR 6:17" /><verse number="18" style="v" sid="EZR 6:18" />他们还照着<char style="pn">摩西</char>的书上所记的，指派祭司和<char style="pn">利未</char>人按照班组班次，在<char style="pn">耶路撒冷</char>服事神。<verse eid="EZR 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZR 6:19" />一月十四日，回归的掳民守逾越节。 <verse eid="EZR 6:19" /><verse number="20" style="v" sid="EZR 6:20" />那时祭司和<char style="pn">利未</char>人同心合一洁净自己，他们全都洁净了，就为所有回归的掳民、他们的兄弟众祭司，以及他们自己，宰杀了逾越节的羔羊。 <verse eid="EZR 6:20" /><verse number="21" style="v" sid="EZR 6:21" />吃羔羊<note caller="+" style="f"><char style="fr" closed="false">6:21 </char><char style="ft" closed="false">羔羊——辅助词语。</char></note>的人有从流亡之地回归的<char style="pn">以色列</char>子孙，也有归附<char style="pn">以色列</char>的当地人，这些人从外邦人的污秽中分别出来，为要寻求耶和华<char style="pn">以色列</char>的神。 <verse eid="EZR 6:21" /><verse number="22" style="v" sid="EZR 6:22" />他们欢欢喜喜地守了七天除酵节，因为耶和华使他们欢喜；他使<char style="pn">亚述</char>王的心转向他们，在<char style="pn">以色列</char>神的神殿工程上扶持他们的手。<verse eid="EZR 6:22" /></para>
  <chapter eid="EZR 6" />
  <chapter number="7" style="c" sid="EZR 7" />
  <para style="s">以斯拉回归耶路撒冷</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 7:1" />这些事以后，<char style="pn">波斯</char>王<char style="pn">亚达薛西</char>在位时，<char style="pn">以斯拉</char>回来了<note caller="+" style="f"><char style="fr" closed="false">7:1 </char><char style="ft" closed="false">回来了——辅助词语。</char></note>——他是<char style="pn">西莱雅</char>的儿子，<char style="pn">西莱雅</char>是<char style="pn">亚撒利雅</char>的儿子，<char style="pn">亚撒利雅</char>是<char style="pn">希勒加</char>的儿子， <verse eid="EZR 7:1" /><verse number="2" style="v" sid="EZR 7:2" /><char style="pn">希勒加</char>是<char style="pn">沙勒姆</char>的儿子，<char style="pn">沙勒姆</char>是<char style="pn">撒督</char>的儿子，<char style="pn">撒督</char>是<char style="pn">亚希突</char>的儿子， <verse eid="EZR 7:2" /><verse number="3" style="v" sid="EZR 7:3" /><char style="pn">亚希突</char>是<char style="pn">亚玛利雅</char>的儿子，<char style="pn">亚玛利雅</char>是<char style="pn">亚撒利雅</char>的儿子，<char style="pn">亚撒利雅</char>是<char style="pn">米拉约</char>的儿子， <verse eid="EZR 7:3" /><verse number="4" style="v" sid="EZR 7:4" /><char style="pn">米拉约</char>是<char style="pn">西拉希雅</char>的儿子，<char style="pn">西拉希雅</char>是<char style="pn">乌基</char>的儿子，<char style="pn">乌基</char>是<char style="pn">布其</char>的儿子， <verse eid="EZR 7:4" /><verse number="5" style="v" sid="EZR 7:5" /><char style="pn">布其</char>是<char style="pn">亚比书</char>的儿子，<char style="pn">亚比书</char>是<char style="pn">非尼哈</char>的儿子，<char style="pn">非尼哈</char>是<char style="pn">以利亚撒</char>的儿子，<char style="pn">以利亚撒</char>是大祭司<char style="pn">亚伦</char>的儿子。 <verse eid="EZR 7:5" /><verse number="6" style="v" sid="EZR 7:6" />这<char style="pn">以斯拉</char>从<char style="pn">巴比伦</char>上来，他是经文士，精通<char style="pn">以色列</char>的神耶和华所赐下的<char style="pn">摩西</char>律法。王准许了他所求的一切，因为他的神耶和华的手帮助他。<verse eid="EZR 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 7:7" />这样，在<char style="pn">亚达薛西</char>王第七年，一些<char style="pn">以色列</char>人、祭司、<char style="pn">利未</char>人、歌手、门卫和圣殿仆役，上<char style="pn">耶路撒冷</char>去。 <verse eid="EZR 7:7" /><verse number="8" style="v" sid="EZR 7:8" /><char style="pn">亚达薛西</char><note caller="+" style="f"><char style="fr" closed="false">7:8 </char><char style="ft" closed="false">亚达薛西——辅助词语。</char></note>王第七年的五月，<char style="pn">以斯拉</char>来到了<char style="pn">耶路撒冷</char>。 <verse eid="EZR 7:8" /><verse number="9" style="v" sid="EZR 7:9" />他在一月一日从<char style="pn">巴比伦</char>起程上行，五月一日就来到<char style="pn">耶路撒冷</char>，是因他的神施恩的手帮助他。 <verse eid="EZR 7:9" /><verse number="10" style="v" sid="EZR 7:10" />因为<char style="pn">以斯拉</char>立定了心志，要研读并遵行耶和华的律法，并在<char style="pn">以色列</char>人中教导这些律例和法规。<verse eid="EZR 7:10" /></para>
  <para style="s">亚达薛西王的公文</para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 7:11" />
    <char style="pn">亚达薛西</char>王将公文的副本交给了<char style="pn">以斯拉</char>，他是祭司，是经文士，精通耶和华的诫命和赐给<char style="pn">以色列</char>的律例。公文副本如下：<verse eid="EZR 7:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="EZR 7:12" />“王中之王<char style="pn">亚达薛西</char>致祭司<char style="pn">以斯拉</char>，那精通<note caller="+" style="f"><char style="fr" closed="false">7:12 </char><char style="ft" closed="false">精通——辅助词语。</char></note>天上之神法令的经文士……<note caller="+" style="f"><char style="fr" closed="false">7:12 </char><char style="ft" closed="false">省略号——原文语义不明；或译作“愿你平安”。</char></note></para>
  <para style="mi" vid="EZR 7:12">现在 <verse eid="EZR 7:12" /><verse number="13" style="v" sid="EZR 7:13" />我下令：在我国中的<char style="pn">以色列</char>民以及他们的祭司和<char style="pn">利未</char>人，凡是甘愿奉献自己去<char style="pn">耶路撒冷</char>的，都可以与你一起去。 <verse eid="EZR 7:13" /><verse number="14" style="v" sid="EZR 7:14" />既然你从王和七位内阁大臣面前受了差派，照着你的神交托给你的法令去调查<char style="pn">犹大</char>和<char style="pn">耶路撒冷</char>的情况， <verse eid="EZR 7:14" /><verse number="15" style="v" sid="EZR 7:15" />并且带去王和内阁大臣们甘愿奉献给住在<char style="pn">耶路撒冷</char>的<char style="pn">以色列</char>之神的金银， <verse eid="EZR 7:15" /><verse number="16" style="v" sid="EZR 7:16" />还有你在<char style="pn">巴比伦</char>全省得到的一切金银，以及民众和祭司们甘愿奉献给<char style="pn">耶路撒冷</char>他们神殿宇的奉献物， <verse eid="EZR 7:16" /><verse number="17" style="v" sid="EZR 7:17" />那么，这些银子要专用于购买公牛、公绵羊、公羊羔，以及同献的素祭和酒祭，你要在<char style="pn">耶路撒冷</char>你们神殿的祭坛上把它们献上。 <verse eid="EZR 7:17" /><verse number="18" style="v" sid="EZR 7:18" />其余的金银，你和你的兄弟们看怎样好，就怎样用，要照着你们神的旨意去做。 <verse eid="EZR 7:18" /><verse number="19" style="v" sid="EZR 7:19" />至于那些交给你，在你神的殿中事奉用的器皿，你要完全交付在<char style="pn">耶路撒冷</char>的神面前。 <verse eid="EZR 7:19" /><verse number="20" style="v" sid="EZR 7:20" />你神的殿由你负责的其余需用，你可以从王的府库里支取。<verse eid="EZR 7:20" /></para>
  <para style="mi">
    <verse number="21" style="v" sid="EZR 7:21" />我<char style="pn">亚达薛西</char>王向<char style="pn">幼发拉底</char>河对岸地区所有的司库官下令：那精通<note caller="+" style="f"><char style="fr" closed="false">7:21 </char><char style="ft" closed="false">精通——辅助词语。</char></note>天上之神法令的经文士，祭司<char style="pn">以斯拉</char>，他向你们要求的一切，你们都要认真照办； <verse eid="EZR 7:21" /><verse number="22" style="v" sid="EZR 7:22" />银子上限一百他连得<note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="ft" closed="false">一百他连得——相当于3.4公吨。1他连得=34.2公斤。</char></note>，小麦上限一百柯珥<note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="ft" closed="false">一百柯珥——相当于22,000公升。1柯珥=220公升。</char></note>，酒上限一百罢特<note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="ft" closed="false">一百罢特——相当于2,200公升；下同。1罢特=22公升。</char></note>，油上限一百罢特，盐不用记数。 <verse eid="EZR 7:22" /><verse number="23" style="v" sid="EZR 7:23" />凡是天上之神所命令的，都要为天上之神的殿尽心执行。何必让震怒临到王和王子们的国土呢？ <verse eid="EZR 7:23" /><verse number="24" style="v" sid="EZR 7:24" />你们还要知道：对于所有的祭司、<char style="pn">利未</char>人、歌手、门卫、圣殿仆役，以及在神的这殿宇事奉的人，你们都无权向他们征收税捐、贡物和路税。<verse eid="EZR 7:24" /></para>
  <para style="mi">
    <verse number="25" style="v" sid="EZR 7:25" />至于你<char style="pn">以斯拉</char>，你要照着你的神赐予你的智慧，指派那些明白你神的法令的人作司法官和审判官，让他们治理<char style="pn">幼发拉底</char>河对岸地区的所有百姓；你们也要教导那些不明白法令的人。 <verse eid="EZR 7:25" /><verse number="26" style="v" sid="EZR 7:26" />任何人不遵行你神的法令和王的法令，他就要受到严厉的审判：或处死，或放逐，或没收财产，或囚禁。”<verse eid="EZR 7:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="EZR 7:27" />我们祖先的神耶和华是当受颂赞的！他把这样的意念放在王的心中，为要使<char style="pn">耶路撒冷</char>耶和华的圣殿得荣耀。 <verse eid="EZR 7:27" /><verse number="28" style="v" sid="EZR 7:28" />他还在王和王的内阁大臣面前，以及王的所有高官面前向我施慈爱。这样，因着我神耶和华的手帮助我，我就坚强，从<char style="pn">以色列</char>人中招聚首领们，与我一同上去。<verse eid="EZR 7:28" /></para>
  <chapter eid="EZR 7" />
  <chapter number="8" style="c" sid="EZR 8" />
  <para style="s">与以斯拉一同回归的人</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 8:1" />
    <char style="pn">亚达薛西</char>王在位时，与我一同从<char style="pn">巴比伦</char>上来的人，他们各父系的首领和家谱记录如下：<verse eid="EZR 8:1" /></para>
  <para style="mi">
    <verse number="2" style="v" sid="EZR 8:2" />
    <char style="pn">非尼哈</char>的子孙，有<char style="pn">革顺</char>；</para>
  <para style="mi" vid="EZR 8:2">
    <char style="pn">以塔玛尔</char>的子孙，有<char style="pn">但以理</char>；</para>
  <para style="mi" vid="EZR 8:2">
    <char style="pn">大卫</char>的子孙，有<char style="pn">哈突施</char>， <verse eid="EZR 8:2" /><verse number="3" style="v" sid="EZR 8:3" />属于<char style="pn">谢喀尼亚</char>的后裔；</para>
  <para style="mi" vid="EZR 8:3">
    <char style="pn">帕罗示</char>的子孙，有<char style="pn">撒迦利亚</char>，以及与他一起记录在家谱中的男子一百五十人；<verse eid="EZR 8:3" /></para>
  <para style="mi">
    <verse number="4" style="v" sid="EZR 8:4" />
    <char style="pn">帕哈摩押</char>的子孙，有<char style="pn">西拉希雅</char>的儿子<char style="pn">以利约奈</char>，以及与他一起的男子两百人；<verse eid="EZR 8:4" /></para>
  <para style="mi">
    <verse number="5" style="v" sid="EZR 8:5" />
    <char style="pn">萨图</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">8:5 </char>
      <char style="ft" closed="false">萨图——依据七十士译本；马索拉文本此处缺失名字。</char>
    </note>的子孙，有<char style="pn">雅哈希</char>的儿子<char style="pn">谢喀尼亚</char>，以及与他一起的男子三百人；<verse eid="EZR 8:5" /></para>
  <para style="mi">
    <verse number="6" style="v" sid="EZR 8:6" />
    <char style="pn">阿丁</char>的子孙，有<char style="pn">约拿单</char>的儿子<char style="pn">伊别德</char>，以及与他一起的男子五十人；<verse eid="EZR 8:6" /></para>
  <para style="mi">
    <verse number="7" style="v" sid="EZR 8:7" />
    <char style="pn">以拦</char>的子孙，有<char style="pn">亚塔利雅</char>的儿子<char style="pn">耶赛亚</char>，以及与他一起的男子七十人；<verse eid="EZR 8:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="EZR 8:8" />
    <char style="pn">示法提雅</char>的子孙，有<char style="pn">米迦勒</char>的儿子<char style="pn">希巴迪亚</char>，以及与他一起的男子八十人；<verse eid="EZR 8:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="EZR 8:9" />
    <char style="pn">约押</char>的子孙，有<char style="pn">耶希业</char>的儿子<char style="pn">俄巴底亚</char>，以及与他一起的男子两百一十八人；<verse eid="EZR 8:9" /></para>
  <para style="mi">
    <verse number="10" style="v" sid="EZR 8:10" />
    <char style="pn">巴尼</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">8:10 </char>
      <char style="ft" closed="false">巴尼——依据七十士译本；马索拉文本此处缺失名字。</char>
    </note>的子孙，有<char style="pn">约细斐</char>的儿子<char style="pn">示罗米</char>，以及与他一起的男子一百六十人；<verse eid="EZR 8:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="EZR 8:11" />
    <char style="pn">比巴伊</char>的子孙，有<char style="pn">比巴伊</char>的儿子<char style="pn">撒迦利亚</char>，以及与他一起的男子二十八人；<verse eid="EZR 8:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="EZR 8:12" />
    <char style="pn">阿兹伽德</char>的子孙，有<char style="pn">哈卡坦</char>的儿子<char style="pn">约哈南</char>，以及与他一起的男子一百一十人；<verse eid="EZR 8:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="EZR 8:13" />
    <char style="pn">亚多尼卡姆</char>的子孙是随后来的，他们的名字是<char style="pn">以利菲列</char>、<char style="pn">耶乌利</char>、<char style="pn">示玛雅</char>，与他们一起的男子有六十人；<verse eid="EZR 8:13" /></para>
  <para style="mi">
    <verse number="14" style="v" sid="EZR 8:14" />
    <char style="pn">比格瓦伊</char>的子孙，有<char style="pn">乌塔伊</char>和<char style="pn">扎克尔</char>，以及与他们一起的男子七十人。<verse eid="EZR 8:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="EZR 8:15" />我把他们聚集到流向<char style="pn">亚哈瓦</char>的那条河边，我们在那里扎营三天。我在民众和祭司中仔细查找，却在那里没有找到一个<char style="pn">利未</char>子孙。 <verse eid="EZR 8:15" /><verse number="16" style="v" sid="EZR 8:16" />于是我派遣<char style="pn">以利以谢</char>、<char style="pn">亚利伊勒</char>、<char style="pn">示玛雅</char>、<char style="pn">以利拿单</char>、<char style="pn">雅立</char>、<char style="pn">以利拿单</char>、<char style="pn">拿单</char>、<char style="pn">撒迦利亚</char>和<char style="pn">米书兰</char>这些首领，以及教师<char style="pn">约雅立</char>和<char style="pn">以利拿单</char>。 <verse eid="EZR 8:16" /><verse number="17" style="v" sid="EZR 8:17" />我吩咐他们去见<char style="pn">卡西非亚</char>地区的首领<char style="pn">易多</char>，并交代他们要对<char style="pn">易多</char>和他在<char style="pn">卡西非亚</char>地区作圣殿仆役的兄弟们说什么话，好为我们神的殿带回来一些事奉的人。 <verse eid="EZR 8:17" /><verse number="18" style="v" sid="EZR 8:18" />因着我们的神施恩的手帮助我们，他们就从<char style="pn">以色列</char>之子<char style="pn">利未</char>的孙子<char style="pn">玛赫利</char>的后裔中，给我们带回来一个明达人<char style="pn">示利比</char>，以及他的儿子们和兄弟们十八人； <verse eid="EZR 8:18" /><verse number="19" style="v" sid="EZR 8:19" />还有<char style="pn">哈沙比雅</char>，并与他一起的<char style="pn">米拉利</char>子孙<char style="pn">耶赛亚</char>，以及他的兄弟们和他们的儿子二十人； <verse eid="EZR 8:19" /><verse number="20" style="v" sid="EZR 8:20" />还有一些圣殿仆役，是<char style="pn">大卫</char>和首领们从前所委派服事<char style="pn">利未</char>人的圣殿仆役的子孙<note caller="+" style="f"><char style="fr" closed="false">8:20 </char><char style="ft" closed="false">的子孙——辅助词语。</char></note>，共有两百二十人。他们全都被列入了名单。<verse eid="EZR 8:20" /></para>
  <para style="s">准备回归</para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 8:21" />那时我在<char style="pn">亚哈瓦</char>河边宣告禁食，要在我们的神面前谦卑下来，为我们和我们的家属以及我们所拥有的一切，向神祈求平安的行程。 <verse eid="EZR 8:21" /><verse number="22" style="v" sid="EZR 8:22" />我羞于求王派出军队和马兵帮助我们对付路上的敌人，因为我们已经告诉王说：“我们神施恩的手必帮助所有寻求他的人，他的大能和怒气必攻击所有离弃他的人。” <verse eid="EZR 8:22" /><verse number="23" style="v" sid="EZR 8:23" />我们为此禁食，向我们的神祈求，他就应允了我们的祈求。<verse eid="EZR 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 8:24" />我从祭司首领中分别出来十二个人，就是<char style="pn">示利比</char>、<char style="pn">哈沙比雅</char>，以及他们兄弟中与他们同工的十个人。 <verse eid="EZR 8:24" /><verse number="25" style="v" sid="EZR 8:25" />我把那些金银和器皿，就是王和内阁大臣们、首领们以及所有在<char style="pn">巴比伦</char>的<char style="pn">以色列</char>人献给我们神殿的供物，都称了交给他们。 <verse eid="EZR 8:25" /><verse number="26" style="v" sid="EZR 8:26" />我称出来交到他们手中的，有：银子六百五十他连得<note caller="+" style="f"><char style="fr" closed="false">8:26 </char><char style="ft" closed="false">六百五十他连得——相当于22.2公吨。1他连得=34.2公斤。</char></note>，银器一百他连得<note caller="+" style="f"><char style="fr" closed="false">8:26 </char><char style="ft" closed="false">一百他连得——相当于3.4公吨；下同。</char></note>，金子一百他连得； <verse eid="EZR 8:26" /><verse number="27" style="v" sid="EZR 8:27" />金碟二十个，值一千达利克<note caller="+" style="f"><char style="fr" closed="false">8:27 </char><char style="ft" closed="false">一千达利克——相当于8.4公斤金子。1达利克金币=8.4公克。</char></note>；抛光的上等铜器两个，珍贵如金。 <verse eid="EZR 8:27" /><verse number="28" style="v" sid="EZR 8:28" />那时，我对他们说：“你们是归于耶和华为圣的，这些器皿也是神圣的，这些金银是甘心奉献物，归于耶和华你们祖先的神。 <verse eid="EZR 8:28" /><verse number="29" style="v" sid="EZR 8:29" />你们当警醒看守，直到你们在<char style="pn">耶路撒冷</char>耶和华殿的库房，在祭司和<char style="pn">利未</char>人的首领们以及<char style="pn">以色列</char>各父系首领面前，把它们都过了秤。” <verse eid="EZR 8:29" /><verse number="30" style="v" sid="EZR 8:30" />于是祭司和<char style="pn">利未</char>人接收了这些称量过的金银和器皿，要带到<char style="pn">耶路撒冷</char>我们神的殿。<verse eid="EZR 8:30" /></para>
  <para style="s">到达耶路撒冷</para>
  <para style="p">
    <verse number="31" style="v" sid="EZR 8:31" />一月十二日，我们从<char style="pn">亚哈瓦</char>河边起程，往<char style="pn">耶路撒冷</char>去。我们神的手帮助了我们，保守我们避开敌人和路上埋伏之人的手。 <verse eid="EZR 8:31" /><verse number="32" style="v" sid="EZR 8:32" />我们来到<char style="pn">耶路撒冷</char>，在那里歇息了三天。 <verse eid="EZR 8:32" /><verse number="33" style="v" sid="EZR 8:33" />第四天，在我们神的殿中，我们把金银和器皿过了秤，然后交到祭司<char style="pn">乌利亚</char>的儿子<char style="pn">米利莫</char>手中，与他同工的有<char style="pn">非尼哈</char>的儿子<char style="pn">以利亚撒</char>，还有<char style="pn">利未</char>人<char style="pn">耶书亚</char>的儿子<char style="pn">约撒巴</char>和<char style="pn">宾努伊</char>的儿子<char style="pn">挪亚迪</char>。 <verse eid="EZR 8:33" /><verse number="34" style="v" sid="EZR 8:34" />这一切都核对了数目和重量，重量全都在当时记下来了。<verse eid="EZR 8:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EZR 8:35" />从流亡之地回归的那些掳民，向<char style="pn">以色列</char>的神献上了燔祭：为全体<char style="pn">以色列</char>人献上公牛十二头，公绵羊九十六只，公羊羔七十七只，赎罪祭公山羊十二只；这都是献给耶和华的燔祭。<verse eid="EZR 8:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EZR 8:36" />他们也把王的法令交给王的行政官们和大河<note caller="+" style="f"><char style="fr" closed="false">8:36 </char><char style="ft" closed="false">大河——指幼发拉底河。</char></note>对岸的省长们，这些人就资助<char style="pn">以色列</char>民和神的殿。<verse eid="EZR 8:36" /></para>
  <chapter eid="EZR 8" />
  <chapter number="9" style="c" sid="EZR 9" />
  <para style="s">以色列人与外邦人通婚</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 9:1" />这些事办完后，首领们前来见我，说：“<char style="pn">以色列</char>民众、祭司和<char style="pn">利未</char>人没有从各地的民中分别出来，反而效法<char style="pn">迦南</char>人、<char style="pn">赫提</char>人、<char style="pn">比利洗</char>人、<char style="pn">耶布斯</char>人、<char style="pn">亚扪</char>人、<char style="pn">摩押</char>人、<char style="pn">埃及</char>人和<char style="pn">亚摩利</char>人的可憎行为。 <verse eid="EZR 9:1" /><verse number="2" style="v" sid="EZR 9:2" />他们竟然为自己、为自己的儿子娶了那些人的女儿，以致圣洁的种族与各地的民结交，而且首领们和官长们在这不忠之事上是首恶。” <verse eid="EZR 9:2" /><verse number="3" style="v" sid="EZR 9:3" />我一听见这事，就撕裂衣服和外袍，拔掉头发和胡须，悲凄地坐下来。<verse eid="EZR 9:3" /></para>
  <para style="s">以斯拉的认罪告白</para>
  <para style="p">
    <verse number="4" style="v" sid="EZR 9:4" />凡是因<char style="pn">以色列</char>神的话语战兢的人，都为那些掳民的不忠而聚集到我这里。我悲凄地坐着，直到献晚祭的时候。 <verse eid="EZR 9:4" /><verse number="5" style="v" sid="EZR 9:5" />献晚祭的时候，我从禁食<note caller="+" style="f"><char style="fr" closed="false">9:5 </char><char style="ft" closed="false">禁食——或译作“自我苦待”。</char></note>中起来，穿着撕裂的衣服和外袍，屈膝跪下，向我的神耶和华伸开双手， <verse eid="EZR 9:5" /><verse number="6" style="v" sid="EZR 9:6" />说：</para>
  <para style="mi" vid="EZR 9:6">“我的神哪，我抱愧羞惭！我的神哪，我不敢向你仰起我的脸！我们的罪孽漫过头顶，我们的罪责高达诸天。 <verse eid="EZR 9:6" /><verse number="7" style="v" sid="EZR 9:7" />从祖先的日子起，我们就在极大的罪责中，直到今天。因我们的罪孽，我们和我们的君王、祭司们都被交在列国的王手中，被刀杀、被俘虏、被掳掠，满脸都是羞耻，就像今日这样。 <verse eid="EZR 9:7" /><verse number="8" style="v" sid="EZR 9:8" />如今在短暂的片刻，有恩典从我们的神耶和华而来，要给我们留下幸存者，并在他的圣地赐给我们一个安身之处<note caller="+" style="f"><char style="fr" closed="false">9:8 </char><char style="ft" closed="false">安身之处——原文直译“橛子”。</char></note>，这样我们的神使我们的眼目明亮，使我们在所受的奴役中稍稍复兴。 <verse eid="EZR 9:8" /><verse number="9" style="v" sid="EZR 9:9" />虽然我们成了奴仆，但我们的神并没有任凭我们受奴役，而是在<char style="pn">波斯</char>诸王面前向我们施慈爱，使我们复兴，得以恢复我们神的殿，重建这殿的荒废之处，使我们在<char style="pn">犹大</char>、在<char style="pn">耶路撒冷</char>有了围护的墙。<verse eid="EZR 9:9" /></para>
  <para style="mi">
    <verse number="10" style="v" sid="EZR 9:10" />“既然如此，我们的神哪，现在我们还有什么可说的呢？我们确实离弃了你的诫命， <verse eid="EZR 9:10" /><verse number="11" style="v" sid="EZR 9:11" />就是你藉着你的仆人众先知所吩咐说的：‘你们将进去继承的那地是污秽之地，有各地之民的污秽和他们的可憎之事，他们使那地从这边到那边充满了他们的不洁。 <verse eid="EZR 9:11" /><verse number="12" style="v" sid="EZR 9:12" />所以不要把你们的女儿嫁给他们的儿子，也不要为你们的儿子娶他们的女儿，永远不要为他们谋平安和福利，这样你们就强盛，能吃这地的美物，并使你们的子孙永远继承这地。’ <verse eid="EZR 9:12" /><verse number="13" style="v" sid="EZR 9:13" />如今，因我们的恶行，因我们的大罪，我们遭遇了这一切——然而你，我们的神哪，你惩罚我们轻于我们犯罪所当受的<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false">所当受的——辅助词语。</char></note>，还使我们像这样成为幸存者—— <verse eid="EZR 9:13" /><verse number="14" style="v" sid="EZR 9:14" />难道我们可以再次违背你的诫命，与这些行可憎之事的民族通婚吗？难道你不会对我们发怒，直到灭绝我们，以致没有一个余剩者或幸存者吗？ <verse eid="EZR 9:14" /><verse number="15" style="v" sid="EZR 9:15" />耶和华<char style="pn">以色列</char>的神哪，你是公义的，我们竟然被留下成为了幸存者，就像今日这样。看哪，我们在你面前有罪了，为此实在没有人能在你面前站立得住！”<verse eid="EZR 9:15" /></para>
  <chapter eid="EZR 9" />
  <chapter number="10" style="c" sid="EZR 10" />
  <para style="s">送走外邦妻子</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 10:1" />
    <char style="pn">以斯拉</char>祷告、认罪，俯伏在神的殿前面哭泣的时候，<char style="pn">以色列</char>的广大会众——男人、女人和孩子，都聚集到他那里，人们也痛哭流涕。 <verse eid="EZR 10:1" /><verse number="2" style="v" sid="EZR 10:2" /><char style="pn">以拦</char>的子孙<char style="pn">耶希业</char>的儿子<char style="pn">谢喀尼亚</char>就对<char style="pn">以斯拉</char>说：“我们对我们的神不忠，从当地百姓中娶了外邦女子。虽然这样，<char style="pn">以色列</char>还有希望。 <verse eid="EZR 10:2" /><verse number="3" style="v" sid="EZR 10:3" />现在让我们与我们的神立约吧，按着我主与那些因我们神的诫命而战兢的人的意见，送走那些女人和她们所生的；这事要照着律法处理。 <verse eid="EZR 10:3" /><verse number="4" style="v" sid="EZR 10:4" />起来，这件事要靠你了；我们与你同心，你要坚强行事！”<verse eid="EZR 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 10:5" />于是<char style="pn">以斯拉</char>起来，让众祭司首领、<char style="pn">利未</char>人和全体<char style="pn">以色列</char>人都起誓要照着这话语去做。他们就起了誓。 <verse eid="EZR 10:5" /><verse number="6" style="v" sid="EZR 10:6" />随后，<char style="pn">以斯拉</char>从神的殿前面起身，来到<char style="pn">以利亚实</char>的儿子<char style="pn">约哈南</char>的房间。他待在那里，不吃饭也不喝水，为那些掳民的不忠而极其悲恸。<verse eid="EZR 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 10:7" />他们在<char style="pn">犹大</char>和<char style="pn">耶路撒冷</char>通告所有回归的掳民，要他们聚集到<char style="pn">耶路撒冷</char>， <verse eid="EZR 10:7" /><verse number="8" style="v" sid="EZR 10:8" />任何人不照着首领和长老们所商议的在三天之内来到，他的一切财物都要成为奉献物<note caller="+" style="f"><char style="fr" closed="false">10:8 </char><char style="ft" closed="false">成为奉献物——或译作“被没收充公”。</char></note>，他自己也要从回归的掳民会众当中被革除。<verse eid="EZR 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZR 10:9" />于是，<char style="pn">犹大</char>和<char style="pn">便雅悯</char>的所有男人三天内都聚集到<char style="pn">耶路撒冷</char>。那是在九月的二十日，全体民众坐在神殿的广场上，他们因这事，又因下雨，都战战兢兢。 <verse eid="EZR 10:9" /><verse number="10" style="v" sid="EZR 10:10" />祭司<char style="pn">以斯拉</char>起身，对他们说：“你们不忠，娶了外邦女子，以致增添了<char style="pn">以色列</char>的罪责。 <verse eid="EZR 10:10" /><verse number="11" style="v" sid="EZR 10:11" />现在，你们要向你们祖先的神耶和华认罪<note caller="+" style="f"><char style="fr" closed="false">10:11 </char><char style="ft" closed="false">认罪——原文直译“献上感谢”。</char></note>，遵行他的旨意，与当地百姓和外邦女子分别开来。”<verse eid="EZR 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 10:12" />全体会众大声回应说：“我们必照着你的话去做。 <verse eid="EZR 10:12" /><verse number="13" style="v" sid="EZR 10:13" />不过民众很多，这时候又下雨，我们不能站在外面；而且这不是一天、两天的事，因为在这事上我们有许多人犯罪<note caller="+" style="f"><char style="fr" closed="false">10:13 </char><char style="ft" closed="false">有许多人犯罪——或译作“犯了大罪”。</char></note>。 <verse eid="EZR 10:13" /><verse number="14" style="v" sid="EZR 10:14" />请让我们的首领们代表全体会众留下来，以后让我们各城所有娶了外邦女子的人，在指定的时候与各城的长老和审判官们一同前来。这样，我们的神因这事而发的烈怒就会转消。” <verse eid="EZR 10:14" /><verse number="15" style="v" sid="EZR 10:15" />只有<char style="pn">亚撒晖</char>的儿子<char style="pn">约拿单</char>和<char style="pn">提克瓦</char>的儿子<char style="pn">雅哈谢</char>反对这事，<char style="pn">米书兰</char>和<char style="pn">利未</char>人<char style="pn">沙比泰</char>也支持他们。<verse eid="EZR 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 10:16" />于是，回归的掳民就这样做。祭司<char style="pn">以斯拉</char>把各父系首领中的一些人，按着他们的父家分别出来，并且全都列入了名单。他们在十月一日坐下来调查这事， <verse eid="EZR 10:16" /><verse number="17" style="v" sid="EZR 10:17" />直到一月一日，调查完了所有娶外邦女子的男人。<verse eid="EZR 10:17" /></para>
  <para style="s">娶外邦女子的人</para>
  <para style="p">
    <verse number="18" style="v" sid="EZR 10:18" />祭司的子孙中，查出娶了外邦女子的是：</para>
  <para style="mi" vid="EZR 10:18">
    <char style="pn">约萨达</char>的儿子<char style="pn">耶书亚</char>和他兄弟们的子孙中，有<char style="pn">玛西雅</char>、<char style="pn">以利以谢</char>、<char style="pn">雅立</char>、<char style="pn">基大利</char>； <verse eid="EZR 10:18" /><verse number="19" style="v" sid="EZR 10:19" />他们举手承诺要送走他们的妻子，并且认罪，为自己的罪献上了一只公绵羊。<verse eid="EZR 10:19" /></para>
  <para style="mi">
    <verse number="20" style="v" sid="EZR 10:20" />
    <char style="pn">伊梅尔</char>的子孙中，有<char style="pn">哈纳尼</char>、<char style="pn">希巴迪亚</char>。<verse eid="EZR 10:20" /></para>
  <para style="mi">
    <verse number="21" style="v" sid="EZR 10:21" />
    <char style="pn">哈琳</char>的子孙中，有<char style="pn">玛西雅</char>、<char style="pn">以利亚</char>、<char style="pn">示玛雅</char>、<char style="pn">耶希业</char>、<char style="pn">乌西雅</char>。<verse eid="EZR 10:21" /></para>
  <para style="mi">
    <verse number="22" style="v" sid="EZR 10:22" />
    <char style="pn">帕示户珥</char>的子孙中，有<char style="pn">以利约奈</char>、<char style="pn">玛西雅</char>、<char style="pn">以实玛利</char>、<char style="pn">拿旦业</char>、<char style="pn">约撒巴</char>、<char style="pn">以利亚萨</char>。<verse eid="EZR 10:22" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="23" style="v" sid="EZR 10:23" />
    <char style="pn">利未</char>人中，有<char style="pn">约撒巴</char>、<char style="pn">示每</char>、<char style="pn">基拉雅</char>——就是<char style="pn">基利达</char>，还有<char style="pn">佩塔希雅</char>、<char style="pn">犹大</char>、<char style="pn">以利以谢</char>。<verse eid="EZR 10:23" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="24" style="v" sid="EZR 10:24" />歌手中，有<char style="pn">以利亚实</char>。</para>
  <para style="mi" vid="EZR 10:24">门卫中，有<char style="pn">沙勒姆</char>、<char style="pn">特勒姆</char>、<char style="pn">乌利</char>。<verse eid="EZR 10:24" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="25" style="v" sid="EZR 10:25" />还有一些<char style="pn">以色列</char>人：</para>
  <para style="mi" vid="EZR 10:25">
    <char style="pn">帕罗示</char>的子孙中，有<char style="pn">拉姆亚</char>、<char style="pn">耶基雅</char>、<char style="pn">玛基雅</char>、<char style="pn">米雅悯</char>、<char style="pn">以利亚撒</char>、<char style="pn">玛基雅</char>、<char style="pn">比纳雅</char>。<verse eid="EZR 10:25" /></para>
  <para style="mi">
    <verse number="26" style="v" sid="EZR 10:26" />
    <char style="pn">以拦</char>的子孙中，有<char style="pn">玛塔尼亚</char>、<char style="pn">撒迦利亚</char>、<char style="pn">耶希业</char>、<char style="pn">阿伯迪</char>、<char style="pn">耶利莫</char>、<char style="pn">以利亚</char>。<verse eid="EZR 10:26" /></para>
  <para style="mi">
    <verse number="27" style="v" sid="EZR 10:27" />
    <char style="pn">萨图</char>的子孙中，有<char style="pn">以利约奈</char>、<char style="pn">以利亚实</char>、<char style="pn">玛塔尼亚</char>、<char style="pn">耶利莫</char>、<char style="pn">撒巴德</char>、<char style="pn">阿兹扎</char>。<verse eid="EZR 10:27" /></para>
  <para style="mi">
    <verse number="28" style="v" sid="EZR 10:28" />
    <char style="pn">比巴伊</char>的子孙中，有<char style="pn">约哈南</char>、<char style="pn">哈纳尼雅</char>、<char style="pn">扎巴伊</char>、<char style="pn">阿特莱</char>。<verse eid="EZR 10:28" /></para>
  <para style="mi">
    <verse number="29" style="v" sid="EZR 10:29" />
    <char style="pn">巴尼</char>的子孙中，有<char style="pn">米书兰</char>、<char style="pn">玛卢克</char>、<char style="pn">亚达雅</char>、<char style="pn">雅实布</char>、<char style="pn">谢阿勒</char>、<char style="pn">耶利莫</char>。<verse eid="EZR 10:29" /></para>
  <para style="mi">
    <verse number="30" style="v" sid="EZR 10:30" />
    <char style="pn">帕哈摩押</char>的子孙中，有<char style="pn">阿德纳</char>、<char style="pn">基拉</char>、<char style="pn">比纳雅</char>、<char style="pn">玛西雅</char>、<char style="pn">玛塔尼亚</char>、<char style="pn">比撒列</char>、<char style="pn">宾努伊</char>、<char style="pn">玛拿西</char>。<verse eid="EZR 10:30" /></para>
  <para style="mi">
    <verse number="31" style="v" sid="EZR 10:31" />
    <char style="pn">哈琳</char>的子孙中，有<char style="pn">以利以谢</char>、<char style="pn">伊示亚</char>、<char style="pn">玛基雅</char>、<char style="pn">示玛雅</char>、<char style="pn">西缅</char>、 <verse eid="EZR 10:31" /><verse number="32" style="v" sid="EZR 10:32" /><char style="pn">便雅悯</char>、<char style="pn">玛卢克</char>、<char style="pn">示玛利雅</char>。<verse eid="EZR 10:32" /></para>
  <para style="mi">
    <verse number="33" style="v" sid="EZR 10:33" />
    <char style="pn">哈书姆</char>的子孙中，有<char style="pn">玛特奈</char>、<char style="pn">玛特塔</char>、<char style="pn">撒巴德</char>、<char style="pn">以利菲列</char>、<char style="pn">耶利迈</char>、<char style="pn">玛拿西</char>、<char style="pn">示每</char>。<verse eid="EZR 10:33" /></para>
  <para style="mi">
    <verse number="34" style="v" sid="EZR 10:34" />
    <char style="pn">巴尼</char>的子孙中，有<char style="pn">玛阿代</char>、<char style="pn">阿姆兰</char>、<char style="pn">乌伊勒</char>、 <verse eid="EZR 10:34" /><verse number="35" style="v" sid="EZR 10:35" /><char style="pn">比纳雅</char>、<char style="pn">比迪雅</char>、<char style="pn">克录希</char>、 <verse eid="EZR 10:35" /><verse number="36" style="v" sid="EZR 10:36" /><char style="pn">瓦尼亚</char>、<char style="pn">米利莫</char>、<char style="pn">以利亚实</char>、 <verse eid="EZR 10:36" /><verse number="37" style="v" sid="EZR 10:37" /><char style="pn">玛塔尼亚</char>、<char style="pn">玛特奈</char>、<char style="pn">雅阿苏</char>、 <verse eid="EZR 10:37" /><verse number="38" style="v" sid="EZR 10:38" /><char style="pn">巴尼</char>、<char style="pn">宾努伊</char>、<char style="pn">示每</char>、 <verse eid="EZR 10:38" /><verse number="39" style="v" sid="EZR 10:39" /><char style="pn">示勒米雅</char>、<char style="pn">拿单</char>、<char style="pn">亚达雅</char>、 <verse eid="EZR 10:39" /><verse number="40" style="v" sid="EZR 10:40" /><char style="pn">玛赫拿德拜</char>、<char style="pn">沙沙伊</char>、<char style="pn">沙拉伊</char>、 <verse eid="EZR 10:40" /><verse number="41" style="v" sid="EZR 10:41" /><char style="pn">阿扎列</char>、<char style="pn">示勒米雅</char>、<char style="pn">示玛利雅</char>、 <verse eid="EZR 10:41" /><verse number="42" style="v" sid="EZR 10:42" /><char style="pn">沙勒姆</char>、<char style="pn">亚玛利雅</char>、<char style="pn">约瑟</char>。<verse eid="EZR 10:42" /></para>
  <para style="mi">
    <verse number="43" style="v" sid="EZR 10:43" />
    <char style="pn">尼波</char>的子孙中，有<char style="pn">耶伊列</char>、<char style="pn">玛塔提雅</char>、<char style="pn">撒巴德</char>、<char style="pn">锡彼纳</char>、<char style="pn">伊度</char>、<char style="pn">约珥</char>、<char style="pn">比纳雅</char>。<verse eid="EZR 10:43" /></para>
  <para style="b" />
  <para style="p">
    <verse number="44" style="v" sid="EZR 10:44" />这些人全都娶了外邦女子，其中有些人的妻子还生了儿女<note caller="+" style="f"><char style="fr" closed="false">10:44 </char><char style="ft" closed="false">其中有些人的妻子还生了儿女——或译作“现在他们把妻子连同孩子都送走了”。</char></note>。<verse eid="EZR 10:44" /></para>
  <chapter eid="EZR 10" />
</usx>