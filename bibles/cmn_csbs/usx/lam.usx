<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LAM" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">耶利米哀歌</para>
  <para style="mt">耶利米哀歌</para>
  <chapter number="1" style="c" sid="LAM 1" />
  <para style="s">为耶路撒冷悲哀</para>
  <para style="b" />
  <para style="qa">א Alef<note caller="+" style="f"><char style="fr" closed="false">1:0 </char><char style="ft" closed="false">这首希伯来文的字母诗，每行诗句的首字母按希伯来字母顺序排列。1-4章下同。</char></note></para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 1:1" />从前人口众多的城，</para>
  <para style="q1" vid="LAM 1:1">现在竟然孤独地坐着！</para>
  <para style="q1" vid="LAM 1:1">这在列国中为大的，</para>
  <para style="q1" vid="LAM 1:1">竟然像寡妇那样；</para>
  <para style="q1" vid="LAM 1:1">在各省中为王后的，</para>
  <para style="q1" vid="LAM 1:1">竟然成为服苦役的！<verse eid="LAM 1:1" /></para>
  <para style="b" />
  <para style="qa">ב Bet</para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2" />她夜间痛哭，</para>
  <para style="q1" vid="LAM 1:2">眼泪淌满脸颊；</para>
  <para style="q1" vid="LAM 1:2">在她所有亲爱的人中，</para>
  <para style="q1" vid="LAM 1:2">没有一个安慰她的；</para>
  <para style="q1" vid="LAM 1:2">她所有的朋友都背弃她，</para>
  <para style="q1" vid="LAM 1:2">成为她的仇敌。<verse eid="LAM 1:2" /></para>
  <para style="b" />
  <para style="qa">ג Gimel</para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3" />
    <char style="pn">犹大</char>因苦难和严酷的劳役而迁徙；</para>
  <para style="q1" vid="LAM 1:3">她住在列国中，</para>
  <para style="q1" vid="LAM 1:3">找不到歇息之处；</para>
  <para style="q1" vid="LAM 1:3">在她的困境中，</para>
  <para style="q1" vid="LAM 1:3">所有追赶她的人都追上了她。<verse eid="LAM 1:3" /></para>
  <para style="b" />
  <para style="qa">ד Dalet</para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4" />
    <char style="pn">锡安</char>的道路因无人来守节期而悲哀；</para>
  <para style="q1" vid="LAM 1:4">她所有的城门都荒凉，</para>
  <para style="q1" vid="LAM 1:4">她的祭司们叹息，</para>
  <para style="q1" vid="LAM 1:4">她的处女们忧伤，</para>
  <para style="q1" vid="LAM 1:4">她自己也苦痛。<verse eid="LAM 1:4" /></para>
  <para style="b" />
  <para style="qa">ה He</para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5" />她的敌人成为她的首领，</para>
  <para style="q1" vid="LAM 1:5">她的仇敌安稳；</para>
  <para style="q1" vid="LAM 1:5">耶和华因她众多的过犯使她受苦；</para>
  <para style="q1" vid="LAM 1:5">她的幼童在敌人面前被掳去。<verse eid="LAM 1:5" /></para>
  <para style="b" />
  <para style="qa">ו Vav</para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6" />女子<char style="pn">锡安</char>所有的威荣都离她而去；</para>
  <para style="q1" vid="LAM 1:6">她的首领们像找不到草场的鹿，</para>
  <para style="q1" vid="LAM 1:6">在追赶他们的人面前行走无力。<verse eid="LAM 1:6" /></para>
  <para style="b" />
  <para style="qa">ז Zayin</para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7" />
    <char style="pn">耶路撒冷</char>在苦难和流浪的日子里，</para>
  <para style="q1" vid="LAM 1:7">想起古时她一切所珍爱的。</para>
  <para style="q1" vid="LAM 1:7">她的民众落在敌人手中，</para>
  <para style="q1" vid="LAM 1:7">却无人帮助她；</para>
  <para style="q1" vid="LAM 1:7">敌人看见她，</para>
  <para style="q1" vid="LAM 1:7">就讥笑她的毁灭。<verse eid="LAM 1:7" /></para>
  <para style="b" />
  <para style="qa">ח Khet</para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8" />
    <char style="pn">耶路撒冷</char>大大犯罪，</para>
  <para style="q1" vid="LAM 1:8">因此成为不洁之物。</para>
  <para style="q1" vid="LAM 1:8">所有曾尊敬她的，都蔑视她，</para>
  <para style="q1" vid="LAM 1:8">因为看见她的下体；</para>
  <para style="q1" vid="LAM 1:8">她自己也叹息，</para>
  <para style="q1" vid="LAM 1:8">转过身去。<verse eid="LAM 1:8" /></para>
  <para style="b" />
  <para style="qa">ט Tet</para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9" />她的污秽就在衣袍的下摆上；</para>
  <para style="q1" vid="LAM 1:9">她未曾顾念自己的结局，</para>
  <para style="q1" vid="LAM 1:9">她令人惊奇地败落，</para>
  <para style="q1" vid="LAM 1:9">却无人安慰她。</para>
  <para style="q1" vid="LAM 1:9">耶和华啊！求你看顾我的苦难，</para>
  <para style="q1" vid="LAM 1:9">因为仇敌高抬自己。<verse eid="LAM 1:9" /></para>
  <para style="b" />
  <para style="qa">י Yod</para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10" />敌人向她所珍爱的一切伸手，</para>
  <para style="q1" vid="LAM 1:10">她看见外邦人进入她的圣所——</para>
  <para style="q1" vid="LAM 1:10">你曾吩咐不可让他们进入你的集会。<verse eid="LAM 1:10" /></para>
  <para style="b" />
  <para style="qa">כ Kaf</para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11" />她所有的民众都叹息，寻找粮食；</para>
  <para style="q1" vid="LAM 1:11">他们用自己所珍爱的换取食物，</para>
  <para style="q1" vid="LAM 1:11">为要恢复精力。</para>
  <para style="q1" vid="LAM 1:11">耶和华啊！求你看顾，求你垂看，</para>
  <para style="q1" vid="LAM 1:11">因为我被蔑视。<verse eid="LAM 1:11" /></para>
  <para style="b" />
  <para style="qa">ל Lamed</para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12" />所有过路的人哪，</para>
  <para style="q1" vid="LAM 1:12">这对你们不算什么吗？</para>
  <para style="q1" vid="LAM 1:12">你们要注目观看，</para>
  <para style="q1" vid="LAM 1:12">有没有痛苦像我所受的痛苦，</para>
  <para style="q1" vid="LAM 1:12">就是耶和华在他烈怒的日子里使我受的苦？<verse eid="LAM 1:12" /></para>
  <para style="b" />
  <para style="qa">מ Mem</para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13" />他从至高处降火，</para>
  <para style="q1" vid="LAM 1:13">使火进入我的骨头；</para>
  <para style="q1" vid="LAM 1:13">他在我的脚前张开网罗，</para>
  <para style="q1" vid="LAM 1:13">使我转身退后；</para>
  <para style="q1" vid="LAM 1:13">他使我凄凉，</para>
  <para style="q1" vid="LAM 1:13">终日昏沉。<verse eid="LAM 1:13" /></para>
  <para style="b" />
  <para style="qa">נ Nun</para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14" />我过犯的轭被捆绑，</para>
  <para style="q1" vid="LAM 1:14">被他的手所缠绑，</para>
  <para style="q1" vid="LAM 1:14">加在我的颈项上；</para>
  <para style="q1" vid="LAM 1:14">他使我的力量衰败。</para>
  <para style="q1" vid="LAM 1:14">主把我交在我不能抵挡的人手中。<verse eid="LAM 1:14" /></para>
  <para style="b" />
  <para style="qa">ס Samek</para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15" />主弃绝我当中的所有壮士，</para>
  <para style="q1" vid="LAM 1:15">宣告所定的日期对付我，</para>
  <para style="q1" vid="LAM 1:15">要打碎我的少男；</para>
  <para style="q1" vid="LAM 1:15">主践踏少女<char style="pn">犹大</char>，</para>
  <para style="q1" vid="LAM 1:15">如在榨酒池中踹酒。<verse eid="LAM 1:15" /></para>
  <para style="b" />
  <para style="qa">ע Ayin</para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16" />我因这些事哭泣，双眼流泪，</para>
  <para style="q1" vid="LAM 1:16">因为那安慰我、使我恢复精神的远离我；</para>
  <para style="q1" vid="LAM 1:16">我的儿女凄凉，</para>
  <para style="q1" vid="LAM 1:16">因为仇敌得胜了。<verse eid="LAM 1:16" /></para>
  <para style="b" />
  <para style="qa">פ Pe</para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 1:17" />
    <char style="pn">锡安</char>伸开双手，却无人安慰她。</para>
  <para style="q1" vid="LAM 1:17">耶和华针对<char style="pn">雅各</char>吩咐，</para>
  <para style="q1" vid="LAM 1:17">四围的人都作他的敌人；</para>
  <para style="q1" vid="LAM 1:17">
    <char style="pn">耶路撒冷</char>在他们中间成为污秽之物。<verse eid="LAM 1:17" /></para>
  <para style="b" />
  <para style="qa">צ Tsade</para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18" />耶和华是公义的！</para>
  <para style="q1" vid="LAM 1:18">我违背了他的命令。</para>
  <para style="q1" vid="LAM 1:18">万民哪，你们要听，看看我的痛苦！</para>
  <para style="q1" vid="LAM 1:18">我的少女和少男都被掳去了。<verse eid="LAM 1:18" /></para>
  <para style="b" />
  <para style="qa">ק Qof</para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 1:19" />我呼唤我所亲爱的，</para>
  <para style="q1" vid="LAM 1:19">他们却欺骗我；</para>
  <para style="q1" vid="LAM 1:19">我的祭司们和长老们寻找食物恢复精力时，</para>
  <para style="q1" vid="LAM 1:19">就在城中断了气。<verse eid="LAM 1:19" /></para>
  <para style="b" />
  <para style="qa">ר Resh</para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20" />耶和华啊，求你看看，</para>
  <para style="q1" vid="LAM 1:20">危难临到了我！</para>
  <para style="q1" vid="LAM 1:20">我的心肠翻腾，</para>
  <para style="q1" vid="LAM 1:20">我的心在我里面翻转，</para>
  <para style="q1" vid="LAM 1:20">因为我极其悖逆。</para>
  <para style="q1" vid="LAM 1:20">街上刀剑使人丧子，</para>
  <para style="q1" vid="LAM 1:20">在家也如死亡。<verse eid="LAM 1:20" /></para>
  <para style="b" />
  <para style="qa">שׁ Shin</para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21" />人们听见我叹息，</para>
  <para style="q1" vid="LAM 1:21">却无人安慰我；</para>
  <para style="q1" vid="LAM 1:21">我一切的仇敌听见我的灾祸，</para>
  <para style="q1" vid="LAM 1:21">就因你做了这事而高兴。</para>
  <para style="q1" vid="LAM 1:21">愿你使你宣告的日子来到，</para>
  <para style="q1" vid="LAM 1:21">他们就会像我一样。<verse eid="LAM 1:21" /></para>
  <para style="b" />
  <para style="qa">ת Tav</para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22" />愿他们一切的恶行都呈到你面前，</para>
  <para style="q1" vid="LAM 1:22">求你对待他们，</para>
  <para style="q1" vid="LAM 1:22">像你因我一切的过犯而对待我一样！</para>
  <para style="q1" vid="LAM 1:22">因为我的叹息甚多，</para>
  <para style="q1" vid="LAM 1:22">我的心虚脱了。<verse eid="LAM 1:22" /></para>
  <chapter eid="LAM 1" />
  <chapter number="2" style="c" sid="LAM 2" />
  <para style="s">对耶路撒冷的审判</para>
  <para style="b" />
  <para style="qa">א Alef</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 2:1" />主竟然在怒气中用黑云笼罩女子<char style="pn">锡安</char>！</para>
  <para style="q1" vid="LAM 2:1">他把<char style="pn">以色列</char>的荣耀从天上抛弃在地，</para>
  <para style="q1" vid="LAM 2:1">在他烈怒的日子里，</para>
  <para style="q1" vid="LAM 2:1">毫不记念自己的脚凳！<verse eid="LAM 2:1" /></para>
  <para style="b" />
  <para style="qa">ב Bet</para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2" />主吞灭<char style="pn">雅各</char>所有的居所，</para>
  <para style="q1" vid="LAM 2:2">并不顾惜；</para>
  <para style="q1" vid="LAM 2:2">他在盛怒中拆毁女子<char style="pn">犹大</char>的堡垒，</para>
  <para style="q1" vid="LAM 2:2">使它们坠落在地；</para>
  <para style="q1" vid="LAM 2:2">他折辱这国和其中的首领们。<verse eid="LAM 2:2" /></para>
  <para style="b" />
  <para style="qa">ג Gimel</para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3" />他在烈怒中砍断<char style="pn">以色列</char>所有的角，</para>
  <para style="q1" vid="LAM 2:3">他从仇敌面前收回右手；</para>
  <para style="q1" vid="LAM 2:3">他像吞噬四围的火焰，</para>
  <para style="q1" vid="LAM 2:3">在<char style="pn">雅各</char>中焚烧。<verse eid="LAM 2:3" /></para>
  <para style="b" />
  <para style="qa">ד Dalet</para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4" />他如仇敌拉开弓；</para>
  <para style="q1" vid="LAM 2:4">他如同敌人，</para>
  <para style="q1" vid="LAM 2:4">右手就位杀死一切眼中所珍爱的。</para>
  <para style="q1" vid="LAM 2:4">他在女子<char style="pn">锡安</char>的帐篷上，</para>
  <para style="q1" vid="LAM 2:4">倾泻如火的烈怒。<verse eid="LAM 2:4" /></para>
  <para style="b" />
  <para style="qa">ה He</para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5" />主如仇敌吞灭<char style="pn">以色列</char>，</para>
  <para style="q1" vid="LAM 2:5">吞灭她所有的宫殿，</para>
  <para style="q1" vid="LAM 2:5">毁掉她的堡垒；</para>
  <para style="q1" vid="LAM 2:5">他给女子<char style="pn">犹大</char>加增了悲伤和哀号。<verse eid="LAM 2:5" /></para>
  <para style="b" />
  <para style="qa">ו Vav</para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6" />他摧毁自己的帐幕如摧毁园子，</para>
  <para style="q1" vid="LAM 2:6">毁掉自己所定的会所；</para>
  <para style="q1" vid="LAM 2:6">耶和华使节期和安息日在<char style="pn">锡安</char>被遗忘，</para>
  <para style="q1" vid="LAM 2:6">他在强烈的愤怒中藐视君王和祭司。<verse eid="LAM 2:6" /></para>
  <para style="b" />
  <para style="qa">ז Zayin</para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7" />主抛弃了自己的祭坛，</para>
  <para style="q1" vid="LAM 2:7">废弃了自己的圣所；</para>
  <para style="q1" vid="LAM 2:7">他把宫殿的墙交在仇敌手中；</para>
  <para style="q1" vid="LAM 2:7">他们在耶和华的殿中大声喧嚷，</para>
  <para style="q1" vid="LAM 2:7">像在节期之日那样。<verse eid="LAM 2:7" /></para>
  <para style="b" />
  <para style="qa">ח Khet</para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8" />耶和华定意要毁掉女子<char style="pn">锡安</char>的城墙；</para>
  <para style="q1" vid="LAM 2:8">他拉了准绳，绝不收手停止吞灭；</para>
  <para style="q1" vid="LAM 2:8">他使城垣和城墙悲恸，一同败落。<verse eid="LAM 2:8" /></para>
  <para style="b" />
  <para style="qa">ט Tet</para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9" />
    <char style="pn">锡安</char>的各城门都陷入地里，</para>
  <para style="q1" vid="LAM 2:9">耶和华把她的门闩都毁坏、打断；</para>
  <para style="q1" vid="LAM 2:9">她的君王和首领们都在列国之中；</para>
  <para style="q1" vid="LAM 2:9">律法不复存在，</para>
  <para style="q1" vid="LAM 2:9">她的先知们也得不到来自耶和华的异象。<verse eid="LAM 2:9" /></para>
  <para style="b" />
  <para style="qa">י Yod</para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10" />女子<char style="pn">锡安</char>的长老们坐在地上静默，</para>
  <para style="q1" vid="LAM 2:10">扬尘土在头上，束上麻布；</para>
  <para style="q1" vid="LAM 2:10">少女<char style="pn">耶路撒冷</char>垂头于地。<verse eid="LAM 2:10" /></para>
  <para style="b" />
  <para style="qa">כ Kaf</para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11" />我的眼睛因流泪而衰竭，</para>
  <para style="q1" vid="LAM 2:11">我的心肠翻腾，</para>
  <para style="q1" vid="LAM 2:11">我的肝倾泻于地，</para>
  <para style="q1" vid="LAM 2:11">因为我的子民<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">子民——原文直译“女儿子民”。</char></note>败亡，</para>
  <para style="q1" vid="LAM 2:11">幼童和吃奶的婴儿在城里的街上昏倒。<verse eid="LAM 2:11" /></para>
  <para style="b" />
  <para style="qa">ל Lamed</para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12" />他们像被击伤的人昏倒在城里的街上，</para>
  <para style="q1" vid="LAM 2:12">他们在母亲的怀中要丧命<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">他们在母亲的怀中要丧命——原文直译“他们的性命倾泻在母亲的怀中”。</char></note>时，</para>
  <para style="q1" vid="LAM 2:12">就问母亲：“五谷和酒在哪里呢？”<verse eid="LAM 2:12" /></para>
  <para style="b" />
  <para style="qa">מ Mem</para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 2:13" />女子<char style="pn">耶路撒冷</char>啊，</para>
  <para style="q1" vid="LAM 2:13">我能为你说什么呢<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">我能为你说什么呢——原文直译“我用什么为你作见证呢”。</char></note>？</para>
  <para style="q1" vid="LAM 2:13">我把你比作什么呢？</para>
  <para style="q1" vid="LAM 2:13">少女<char style="pn">锡安</char>哪，</para>
  <para style="q1" vid="LAM 2:13">我把你等同什么，</para>
  <para style="q1" vid="LAM 2:13">好安慰你呢？</para>
  <para style="q1" vid="LAM 2:13">因为你的破败大如海洋，</para>
  <para style="q1" vid="LAM 2:13">谁能医治你呢？<verse eid="LAM 2:13" /></para>
  <para style="b" />
  <para style="qa">נ Nun</para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14" />你的先知们为你见虚妄和骗人的异象；</para>
  <para style="q1" vid="LAM 2:14">他们没有揭露你的罪孽，</para>
  <para style="q1" vid="LAM 2:14">好使你的掳民回归，</para>
  <para style="q1" vid="LAM 2:14">却向你指示虚妄和误导人的默示。<verse eid="LAM 2:14" /></para>
  <para style="b" />
  <para style="qa">ס Samek</para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 2:15" />所有过路的人都向你拍掌，</para>
  <para style="q1" vid="LAM 2:15">他们对女子<char style="pn">耶路撒冷</char>嗤笑、摇头，说：</para>
  <para style="q1" vid="LAM 2:15">“这就是那被称为全然美丽、全地所喜乐的城吗？”<verse eid="LAM 2:15" /></para>
  <para style="b" />
  <para style="qa">פ Pe</para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16" />你一切的仇敌张开口攻击你，</para>
  <para style="q1" vid="LAM 2:16">他们嗤笑、咬牙切齿，说：</para>
  <para style="q1" vid="LAM 2:16">“我们吞灭了她！</para>
  <para style="q1" vid="LAM 2:16">这真是我们等候的日子！</para>
  <para style="q1" vid="LAM 2:16">我们等到了，亲眼看见了！”<verse eid="LAM 2:16" /></para>
  <para style="b" />
  <para style="qa">ע Ayin</para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17" />耶和华做成了他所决意的，</para>
  <para style="q1" vid="LAM 2:17">成就了他古时所命定的话语；</para>
  <para style="q1" vid="LAM 2:17">他拆毁，并不顾惜；</para>
  <para style="q1" vid="LAM 2:17">他让仇敌对你幸灾乐祸，</para>
  <para style="q1" vid="LAM 2:17">他高举了你敌人的角。<verse eid="LAM 2:17" /></para>
  <para style="b" />
  <para style="qa">צ Tsade</para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18" />女子<char style="pn">锡安</char>的城墙啊，</para>
  <para style="q1" vid="LAM 2:18">你的心要向主呼求<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="ft" closed="false">你的心要向主呼求——原文直译“他们的心向主呼求”。</char></note>！</para>
  <para style="q1" vid="LAM 2:18">愿你的眼泪如河昼夜流下，</para>
  <para style="q1" vid="LAM 2:18">不让自己歇息，</para>
  <para style="q1" vid="LAM 2:18">也不让你眼中的瞳人休息！<verse eid="LAM 2:18" /></para>
  <para style="b" />
  <para style="qa">ק Qof</para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19" />起来，你要在夜间，</para>
  <para style="q1" vid="LAM 2:19">在更次开始的时候呼喊！</para>
  <para style="q1" vid="LAM 2:19">你要在主面前如水倾吐心意；</para>
  <para style="q1" vid="LAM 2:19">你要为你幼童的性命向主举起双手，</para>
  <para style="q1" vid="LAM 2:19">他们因饥荒在各个街头昏倒。<verse eid="LAM 2:19" /></para>
  <para style="b" />
  <para style="qa">ר Resh</para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20" />耶和华啊，求你看顾，求你垂看！</para>
  <para style="q1" vid="LAM 2:20">你曾这样对待过谁呢？</para>
  <para style="q1" vid="LAM 2:20">难道妇女可以吃自己所生的，抚育的幼童吗？</para>
  <para style="q1" vid="LAM 2:20">难道祭司和先知可以在主的圣所中被杀死吗？<verse eid="LAM 2:20" /></para>
  <para style="b" />
  <para style="qa">שׁ Shin</para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21" />少年人和老年人躺卧在街上的尘土中，</para>
  <para style="q1" vid="LAM 2:21">我的少女和少男倒在刀下；</para>
  <para style="q1" vid="LAM 2:21">你在烈怒的日子里杀死了他们，</para>
  <para style="q1" vid="LAM 2:21">你杀戮，并不顾惜。<verse eid="LAM 2:21" /></para>
  <para style="b" />
  <para style="qa">ת Tav</para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22" />你从四围召唤惊吓我的人，</para>
  <para style="q1" vid="LAM 2:22">像在节期之日召唤人那样。</para>
  <para style="q1" vid="LAM 2:22">在耶和华烈怒的日子里，</para>
  <para style="q1" vid="LAM 2:22">没有一个逃脱的人或幸存者；</para>
  <para style="q1" vid="LAM 2:22">我所抚育、养大的，</para>
  <para style="q1" vid="LAM 2:22">我的仇敌灭绝了他们。<verse eid="LAM 2:22" /></para>
  <chapter eid="LAM 2" />
  <chapter number="3" style="c" sid="LAM 3" />
  <para style="s">耶和华的信实广大</para>
  <para style="b" />
  <para style="qa">א Alef</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 3:1" />我是在耶和华盛怒的杖下经历苦难的人。<verse eid="LAM 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2" />他驱赶我，使我行走在黑暗里，</para>
  <para style="q1" vid="LAM 3:2">而没有在光明中；<verse eid="LAM 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3" />他真是终日一再地转手攻击我。<verse eid="LAM 3:3" /></para>
  <para style="b" />
  <para style="qa">ב Bet</para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4" />他使我的皮肉衰朽，</para>
  <para style="q1" vid="LAM 3:4">折断我的骨头；<verse eid="LAM 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5" />他建造高垒攻击我，</para>
  <para style="q1" vid="LAM 3:5">以苦楚和艰难包围我。<verse eid="LAM 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6" />他使我住在黑暗之地，</para>
  <para style="q1" vid="LAM 3:6">如同死了很久的人。<verse eid="LAM 3:6" /></para>
  <para style="b" />
  <para style="qa">ג Gimel</para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7" />他筑墙拦住我，使我不能出去；</para>
  <para style="q1" vid="LAM 3:7">他使我的铜链沉重；<verse eid="LAM 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8" />甚至我哀求、呼救的时候，</para>
  <para style="q1" vid="LAM 3:8">他掩耳不听我的祷告；<verse eid="LAM 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9" />他用凿好的料石筑墙拦住我的道路，</para>
  <para style="q1" vid="LAM 3:9">使我的路径扭曲。<verse eid="LAM 3:9" /></para>
  <para style="b" />
  <para style="qa">ד Dalet</para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10" />他对我像埋伏的熊，</para>
  <para style="q1" vid="LAM 3:10">像在隐秘处的狮子；<verse eid="LAM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11" />他使我偏离道路，把我撕碎，</para>
  <para style="q1" vid="LAM 3:11">他使我凄凉；<verse eid="LAM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12" />他拉开弓，</para>
  <para style="q1" vid="LAM 3:12">把我立作箭靶子。<verse eid="LAM 3:12" /></para>
  <para style="b" />
  <para style="qa">ה He</para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13" />他把箭袋里的箭射入我的肺腑；<verse eid="LAM 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14" />我在我所有的族人中成为笑柄，</para>
  <para style="q1" vid="LAM 3:14">终日成为他们的歌谣。<verse eid="LAM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15" />他使我饱尝苦涩，</para>
  <para style="q1" vid="LAM 3:15">醉尝苦艾。<verse eid="LAM 3:15" /></para>
  <para style="b" />
  <para style="qa">ו Vav</para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16" />他用沙石磨碎我的牙齿，</para>
  <para style="q1" vid="LAM 3:16">使我蜷缩在灰烬中；<verse eid="LAM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17" />他使我的灵魂远离平安，</para>
  <para style="q1" vid="LAM 3:17">我已忘记了福份；<verse eid="LAM 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18" />我就说：“我的忍耐消亡了，</para>
  <para style="q1" vid="LAM 3:18">来自耶和华的盼望也消亡了！”<verse eid="LAM 3:18" /></para>
  <para style="b" />
  <para style="qa">ז Zayin</para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19" />求你记念我的苦难和流浪——苦艾和毒草！<verse eid="LAM 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 3:20" />我灵里不断想起这些事<note caller="+" style="f"><char style="fr" closed="false">3:20 </char><char style="ft" closed="false">这些事——辅助词语。</char></note>，</para>
  <para style="q1" vid="LAM 3:20">就在我里面沮丧，<verse eid="LAM 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 3:21" />但我心里一回想以下的事，</para>
  <para style="q1" vid="LAM 3:21">我就因此有期盼。<verse eid="LAM 3:21" /></para>
  <para style="b" />
  <para style="qa">ח Khet</para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22" />我们不致灭尽，是因为耶和华的慈爱<note caller="+" style="f"><char style="fr" closed="false">3:22 </char><char style="ft" closed="false">我们不致灭尽，是因为耶和华的慈爱——有古抄本和古译本作“耶和华的慈爱永不终止”。</char></note>，</para>
  <para style="q1" vid="LAM 3:22">他的怜悯永不止息；<verse eid="LAM 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23" />每早晨这都是新的，</para>
  <para style="q1" vid="LAM 3:23">你的信实极其广大！<verse eid="LAM 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24" />我灵里说：“耶和华是我继业的份，</para>
  <para style="q1" vid="LAM 3:24">因此我要期盼他。”<verse eid="LAM 3:24" /></para>
  <para style="b" />
  <para style="qa">ט Tet</para>
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25" />耶和华善待等候他的人和寻求他的人；<verse eid="LAM 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26" />安静等候耶和华的救恩，是美好的；<verse eid="LAM 3:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="LAM 3:27" />人在年轻时负轭，是美好的。<verse eid="LAM 3:27" /></para>
  <para style="b" />
  <para style="qa">י Yod</para>
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28" />愿他独坐静默，</para>
  <para style="q1" vid="LAM 3:28">因为这是耶和华让他担负的；<verse eid="LAM 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29" />愿他的口贴于尘土，</para>
  <para style="q1" vid="LAM 3:29">或许还有盼望；<verse eid="LAM 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30" />愿他把脸颊交给责打他的人，</para>
  <para style="q1" vid="LAM 3:30">使他饱受辱骂。<verse eid="LAM 3:30" /></para>
  <para style="b" />
  <para style="qa">כ Kaf</para>
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31" />主必不永远抛弃我们<note caller="+" style="f"><char style="fr" closed="false">3:31 </char><char style="ft" closed="false">我们——辅助词语。</char></note>，<verse eid="LAM 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LAM 3:32" />他虽然使我们悲伤，</para>
  <para style="q1" vid="LAM 3:32">却照着丰盛的慈爱施怜悯；<verse eid="LAM 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33" />因为他从心里并不愿意苦待人，</para>
  <para style="q1" vid="LAM 3:33">使世人悲伤。<verse eid="LAM 3:33" /></para>
  <para style="b" />
  <para style="qa">ל Lamed</para>
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34" />把地上所有的被囚者压碎在脚下，<verse eid="LAM 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35" />在至高者面前屈枉人的公正，<verse eid="LAM 3:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="LAM 3:36" />在争讼的事上屈枉人——</para>
  <para style="q1" vid="LAM 3:36">这些都是主不允许的。<verse eid="LAM 3:36" /></para>
  <para style="b" />
  <para style="qa">מ Mem</para>
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37" />除非主命定，谁能说了就成就呢？<verse eid="LAM 3:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38" />是祸是福，不都出于至高者的口吗？<verse eid="LAM 3:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39" />人——活着的人因自己的罪过受惩罚<note caller="+" style="f"><char style="fr" closed="false">3:39 </char><char style="ft" closed="false">受惩罚——辅助词语。</char></note>，</para>
  <para style="q1" vid="LAM 3:39">为什么发怨言呢？<verse eid="LAM 3:39" /></para>
  <para style="b" />
  <para style="qa">נ Nun</para>
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40" />让我们省察、探查自己的道路，</para>
  <para style="q1" vid="LAM 3:40">回转归向耶和华！<verse eid="LAM 3:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41" />让我们向天上的神，</para>
  <para style="q1" vid="LAM 3:41">举起我们的心，举起双手！<verse eid="LAM 3:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42" />我们叛逆、悖逆，</para>
  <para style="q1" vid="LAM 3:42">你并不赦免。<verse eid="LAM 3:42" /></para>
  <para style="b" />
  <para style="qa">ס Samek</para>
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43" />你以怒气披裹自己，追赶我们，</para>
  <para style="q1" vid="LAM 3:43">你杀戮，并不顾惜；<verse eid="LAM 3:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44" />你以云彩披裹自己，</para>
  <para style="q1" vid="LAM 3:44">以致祷告不能穿过；<verse eid="LAM 3:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45" />你使我们在万民当中成为渣滓和废物。<verse eid="LAM 3:45" /></para>
  <para style="b" />
  <para style="qa">פ Pe</para>
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46" />我们一切的仇敌张开口攻击我们；<verse eid="LAM 3:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47" />恐怖和陷坑，毁坏和败亡都临到我们；<verse eid="LAM 3:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48" />我的眼睛泪流成河，</para>
  <para style="q1" vid="LAM 3:48">因为我的子民<note caller="+" style="f"><char style="fr" closed="false">3:48 </char><char style="ft" closed="false">子民——原文直译“女儿子民”。</char></note>败亡。<verse eid="LAM 3:48" /></para>
  <para style="b" />
  <para style="qa">ע Ayin</para>
  <para style="q1">
    <verse number="49" style="v" sid="LAM 3:49" />我的眼睛流泪不止，</para>
  <para style="q1" vid="LAM 3:49">总是不停，<verse eid="LAM 3:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="LAM 3:50" />直到耶和华俯看，</para>
  <para style="q1" vid="LAM 3:50">从天上观看。<verse eid="LAM 3:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51" />因看见<note caller="+" style="f"><char style="fr" closed="false">3:51 </char><char style="ft" closed="false">看见——辅助词语。</char></note>我城中女子，</para>
  <para style="q1" vid="LAM 3:51">我的眼睛给我的灵魂带来悲痛。<verse eid="LAM 3:51" /></para>
  <para style="b" />
  <para style="qa">צ Tsade</para>
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52" />我的仇敌无故猎捕我，</para>
  <para style="q1" vid="LAM 3:52">像猎捕雀鸟那样；<verse eid="LAM 3:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53" />他们要使我的性命在坑里断绝，</para>
  <para style="q1" vid="LAM 3:53">把石头扔在我身上；<verse eid="LAM 3:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54" />水淹过我的头，</para>
  <para style="q1" vid="LAM 3:54">我说：“我被剪除了！”<verse eid="LAM 3:54" /></para>
  <para style="b" />
  <para style="qa">ק Qof</para>
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55" />耶和华啊，我从最深的阴坑呼求你的名！<verse eid="LAM 3:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56" />你已经听见了我的声音：</para>
  <para style="q1" vid="LAM 3:56">“求你不要掩耳不解救我，</para>
  <para style="q1" vid="LAM 3:56">不听我的呼求！”<verse eid="LAM 3:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57" />在我呼求你的日子里，</para>
  <para style="q1" vid="LAM 3:57">你靠近我，说：“不要害怕！”<verse eid="LAM 3:57" /></para>
  <para style="b" />
  <para style="qa">ר Resh</para>
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58" />主啊，你为我的灵魂辩护，</para>
  <para style="q1" vid="LAM 3:58">你赎回了我的性命！<verse eid="LAM 3:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59" />耶和华啊，你看见了我的冤屈，</para>
  <para style="q1" vid="LAM 3:59">求你为我施行公正的审判；<verse eid="LAM 3:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60" />他们的报复，</para>
  <para style="q1" vid="LAM 3:60">他们针对我的计划，</para>
  <para style="q1" vid="LAM 3:60">你全都看见了！<verse eid="LAM 3:60" /></para>
  <para style="b" />
  <para style="qa">שׂ Sin / שׁ Shin</para>
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61" />耶和华啊，你听见了他们的辱骂，</para>
  <para style="q1" vid="LAM 3:61">一切针对我的计策！<verse eid="LAM 3:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62" />那些起来敌对我之人的嘴唇和流言蜚语终日攻击我；<verse eid="LAM 3:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63" />求你注目，他们坐下、起来，</para>
  <para style="q1" vid="LAM 3:63">我是他们嘲笑的歌曲！<verse eid="LAM 3:63" /></para>
  <para style="b" />
  <para style="qa">ת Tav</para>
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64" />耶和华啊，你必照着他们手所做的，</para>
  <para style="q1" vid="LAM 3:64">向他们施行应得的报应！<verse eid="LAM 3:64" /></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65" />你必使他们的心谬妄，</para>
  <para style="q1" vid="LAM 3:65">使你的诅咒临到他们；<verse eid="LAM 3:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66" />你必在怒气中追赶他们，</para>
  <para style="q1" vid="LAM 3:66">从耶和华的诸天之下除灭他们。<verse eid="LAM 3:66" /></para>
  <chapter eid="LAM 3" />
  <chapter number="4" style="c" sid="LAM 4" />
  <para style="s">陷落后的耶路撒冷</para>
  <para style="b" />
  <para style="qa">א Alef</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 4:1" />金子竟然失去光泽，</para>
  <para style="q1" vid="LAM 4:1">上好的黄金竟然变了颜色！</para>
  <para style="q1" vid="LAM 4:1">神圣的宝石散落在各个街头。<verse eid="LAM 4:1" /></para>
  <para style="b" />
  <para style="qa">ב Bet</para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2" />
    <char style="pn">锡安</char>宝贵的儿女曾与纯金同比衡量，</para>
  <para style="q1" vid="LAM 4:2">现在竟然算为陶匠之手所做的瓦罐！<verse eid="LAM 4:2" /></para>
  <para style="b" />
  <para style="qa">ג Gimel</para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3" />连豺狗也哺乳它们的幼仔，</para>
  <para style="q1" vid="LAM 4:3">但我的子民<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false">子民——原文直译“女儿子民”；本章下同。</char></note>却凶狠如旷野中的鸵鸟。<verse eid="LAM 4:3" /></para>
  <para style="b" />
  <para style="qa">ד Dalet</para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4" />吃奶婴儿的舌头因干渴紧贴着上颚；</para>
  <para style="q1" vid="LAM 4:4">幼童乞求粮食，却无人分给他们。<verse eid="LAM 4:4" /></para>
  <para style="b" />
  <para style="qa">ה He</para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5" />那些曾吃美食的，</para>
  <para style="q1" vid="LAM 4:5">现在却在街上凄凉；</para>
  <para style="q1" vid="LAM 4:5">那些穿着朱红衣服长大的，</para>
  <para style="q1" vid="LAM 4:5">现在却拥抱粪堆。<verse eid="LAM 4:5" /></para>
  <para style="b" />
  <para style="qa">ו Vav</para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6" />我子民的罪孽比<char style="pn">所多玛</char>的罪恶更大——</para>
  <para style="q1" vid="LAM 4:6">
    <char style="pn">所多玛</char>瞬间被倾覆，</para>
  <para style="q1" vid="LAM 4:6">尽管无人动手攻击它。<verse eid="LAM 4:6" /></para>
  <para style="b" />
  <para style="qa">ז Zayin</para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7" />
    <char style="pn">锡安</char>的<char style="pn">拿细耳</char>人<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">拿细耳人——或译作“贵族”或“分别为圣的人”。</char></note>曾比雪纯净，</para>
  <para style="q1" vid="LAM 4:7">比奶洁白；</para>
  <para style="q1" vid="LAM 4:7">他们的身体比红宝石红润，</para>
  <para style="q1" vid="LAM 4:7">样貌如同蓝宝石。<verse eid="LAM 4:7" /></para>
  <para style="b" />
  <para style="qa">ח Khet</para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8" />现在他们的容貌比煤炭黝黑，</para>
  <para style="q1" vid="LAM 4:8">在街上无人认出；</para>
  <para style="q1" vid="LAM 4:8">他们的皮肤干缩在骨头上，</para>
  <para style="q1" vid="LAM 4:8">枯干如同木柴。<verse eid="LAM 4:8" /></para>
  <para style="b" />
  <para style="qa">ט Tet</para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9" />被刀所杀的比死于饥荒的更好；</para>
  <para style="q1" vid="LAM 4:9">饥饿的因缺乏田野的出产，渐渐消瘦而死。<verse eid="LAM 4:9" /></para>
  <para style="b" />
  <para style="qa">י Yod</para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10" />慈心的妇女亲手煮自己的孩子——</para>
  <para style="q1" vid="LAM 4:10">在我子民败亡的时候，</para>
  <para style="q1" vid="LAM 4:10">孩子成为她们的食物。<verse eid="LAM 4:10" /></para>
  <para style="b" />
  <para style="qa">כ Kaf</para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11" />耶和华发尽了他的怒火，</para>
  <para style="q1" vid="LAM 4:11">倾泻了他猛烈的怒气；</para>
  <para style="q1" vid="LAM 4:11">他在<char style="pn">锡安</char>点火，</para>
  <para style="q1" vid="LAM 4:11">吞噬了她的根基。<verse eid="LAM 4:11" /></para>
  <para style="b" />
  <para style="qa">ל Lamed</para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12" />地上的君王们和世上所有的居民都不相信</para>
  <para style="q1" vid="LAM 4:12">敌人和仇敌能进入<char style="pn">耶路撒冷</char>的各城门。<verse eid="LAM 4:12" /></para>
  <para style="b" />
  <para style="qa">מ Mem</para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13" />这都因她的先知们的罪恶和祭司们的罪孽，</para>
  <para style="q1" vid="LAM 4:13">他们在城中流了义人血。<verse eid="LAM 4:13" /></para>
  <para style="b" />
  <para style="qa">נ Nun</para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14" />他们在街上盲目地流荡，</para>
  <para style="q1" vid="LAM 4:14">他们被血玷污，</para>
  <para style="q1" vid="LAM 4:14">没有人能碰他们的衣袍。<verse eid="LAM 4:14" /></para>
  <para style="b" />
  <para style="qa">ס Samek</para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15" />人们向他们呼喊：</para>
  <para style="q1" vid="LAM 4:15">“走开，不洁净的！</para>
  <para style="q1" vid="LAM 4:15">走开，走开，不要碰我们！”</para>
  <para style="q1" vid="LAM 4:15">他们就逃亡、四处漂泊；</para>
  <para style="q1" vid="LAM 4:15">列国中的人也说：</para>
  <para style="q1" vid="LAM 4:15">“他们不可再寄居下去！”<verse eid="LAM 4:15" /></para>
  <para style="b" />
  <para style="qa">פ Pe</para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16" />耶和华亲自分散他们，</para>
  <para style="q1" vid="LAM 4:16">不再看顾他们；</para>
  <para style="q1" vid="LAM 4:16">人们不尊重祭司，</para>
  <para style="q1" vid="LAM 4:16">也不恩待长老。<verse eid="LAM 4:16" /></para>
  <para style="b" />
  <para style="qa">ע Ayin</para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17" />我们一直徒劳地期盼<note caller="+" style="f"><char style="fr" closed="false">4:17 </char><char style="ft" closed="false">期盼——辅助词语。</char></note>帮助，</para>
  <para style="q1" vid="LAM 4:17">以致眼睛衰竭；</para>
  <para style="q1" vid="LAM 4:17">我们在守望台上守望，</para>
  <para style="q1" vid="LAM 4:17">期盼一个不能拯救我们的国家。<verse eid="LAM 4:17" /></para>
  <para style="b" />
  <para style="qa">צ Tsade</para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18" />敌人追踪我们的脚步，</para>
  <para style="q1" vid="LAM 4:18">使我们不能在自己的街上行走。</para>
  <para style="q1" vid="LAM 4:18">我们的结局近了，</para>
  <para style="q1" vid="LAM 4:18">我们的日子满了，</para>
  <para style="q1" vid="LAM 4:18">我们的结局已经来到了！<verse eid="LAM 4:18" /></para>
  <para style="b" />
  <para style="qa">ק Qof</para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19" />追赶我们的人比天空的老鹰更快，</para>
  <para style="q1" vid="LAM 4:19">他们在山上追逼我们，</para>
  <para style="q1" vid="LAM 4:19">在旷野中埋伏等着我们。<verse eid="LAM 4:19" /></para>
  <para style="b" />
  <para style="qa">ר Resh</para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20" />我们鼻孔的气息——耶和华的受膏者，</para>
  <para style="q1" vid="LAM 4:20">在他们的陷坑中被捉住；</para>
  <para style="q1" vid="LAM 4:20">我们曾论到他，说：</para>
  <para style="q1" vid="LAM 4:20">“在他的荫庇下，</para>
  <para style="q1" vid="LAM 4:20">我们要在列国中存活。”<verse eid="LAM 4:20" /></para>
  <para style="b" />
  <para style="qa">שׂ Sin</para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21" />住在<char style="pn">乌斯</char>地的女子<char style="pn">以东</char>啊，</para>
  <para style="q1" vid="LAM 4:21">尽管高兴欢喜吧！</para>
  <para style="q1" vid="LAM 4:21">这杯也必传到你那里，</para>
  <para style="q1" vid="LAM 4:21">你必喝醉，赤身露体。<verse eid="LAM 4:21" /></para>
  <para style="b" />
  <para style="qa">ת Tav</para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22" />女子<char style="pn">锡安</char>哪，</para>
  <para style="q1" vid="LAM 4:22">你当受的惩罚已经结束，</para>
  <para style="q1" vid="LAM 4:22">耶和华必不再使你迁徙！</para>
  <para style="q1" vid="LAM 4:22">女子<char style="pn">以东</char>啊，</para>
  <para style="q1" vid="LAM 4:22">他必惩罚你的罪孽，</para>
  <para style="q1" vid="LAM 4:22">揭露你的罪恶！<verse eid="LAM 4:22" /></para>
  <chapter eid="LAM 4" />
  <chapter number="5" style="c" sid="LAM 5" />
  <para style="s">求耶和华带来更新</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 5:1" />耶和华啊，求你记念所临到我们的，</para>
  <para style="q1" vid="LAM 5:1">求你看顾，求你垂看我们的羞辱！<verse eid="LAM 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2" />我们的继业转归外族人，</para>
  <para style="q1" vid="LAM 5:2">我们的房屋转归外邦人。<verse eid="LAM 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3" />我们成为孤儿，没有父亲，</para>
  <para style="q1" vid="LAM 5:3">我们的母亲像寡妇那样。<verse eid="LAM 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4" />我们喝的水要用银子买，</para>
  <para style="q1" vid="LAM 5:4">我们的木柴要付代价得来。<verse eid="LAM 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5" />我们被紧紧追赶<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="ft" closed="false">我们被紧紧追赶——原文直译“我们被追赶到了我们的颈项”。</char></note>；</para>
  <para style="q1" vid="LAM 5:5">我们疲惫，不得安息。<verse eid="LAM 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6" />我们向<char style="pn">埃及</char>和<char style="pn">亚述</char>举手臣服，</para>
  <para style="q1" vid="LAM 5:6">为要得以饱食。<verse eid="LAM 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7" />我们的祖先犯了罪，</para>
  <para style="q1" vid="LAM 5:7">如今他们不在了，</para>
  <para style="q1" vid="LAM 5:7">我们却背负他们的罪孽。<verse eid="LAM 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8" />奴仆管辖我们，</para>
  <para style="q1" vid="LAM 5:8">无人救拔我们脱离他们的手。<verse eid="LAM 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9" />因旷野中的刀剑，</para>
  <para style="q1" vid="LAM 5:9">我们冒生命危险得来粮食；<verse eid="LAM 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10" />因饥荒的燥热，</para>
  <para style="q1" vid="LAM 5:10">我们的皮肤热如火炉。<verse eid="LAM 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11" />妇女们在<char style="pn">锡安</char>被玷辱，</para>
  <para style="q1" vid="LAM 5:11">处女们在<char style="pn">犹大</char>各城被玷辱。<verse eid="LAM 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12" />首领们被绑手吊起，</para>
  <para style="q1" vid="LAM 5:12">长老们不被尊敬。<verse eid="LAM 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13" />青年人被迫推磨，</para>
  <para style="q1" vid="LAM 5:13">少年人在木柴的重压<note caller="+" style="f"><char style="fr" closed="false">5:13 </char><char style="ft" closed="false">的重压——辅助词语。</char></note>之下绊倒。<verse eid="LAM 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14" />长老们已不在城门口，</para>
  <para style="q1" vid="LAM 5:14">青年人止息了他们的音乐。<verse eid="LAM 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15" />我们心里的喜乐止息了，</para>
  <para style="q1" vid="LAM 5:15">我们的跳舞变为哀恸。<verse eid="LAM 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16" />冠冕从我们的头上掉落；</para>
  <para style="q1" vid="LAM 5:16">我们有祸了！</para>
  <para style="q1" vid="LAM 5:16">因为我们犯了罪。<verse eid="LAM 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17" />因这事我们的心昏沉，</para>
  <para style="q1" vid="LAM 5:17">因这些事我们的眼睛昏暗——<verse eid="LAM 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18" />这都因为<char style="pn">锡安</char>山荒凉，</para>
  <para style="q1" vid="LAM 5:18">豺狗行在其上。<verse eid="LAM 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 5:19" />耶和华啊，你永远坐着为王，</para>
  <para style="q1" vid="LAM 5:19">你的宝座存到万代！<verse eid="LAM 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20" />你为什么永久忘记我们？</para>
  <para style="q1" vid="LAM 5:20">为什么长久<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="ft" closed="false">长久——原文直译“长久的日子”。</char></note>离弃我们呢？<verse eid="LAM 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21" />耶和华啊！求你使我们回转归向你，</para>
  <para style="q1" vid="LAM 5:21">我们就得以回转；</para>
  <para style="q1" vid="LAM 5:21">求你更新我们的日子，</para>
  <para style="q1" vid="LAM 5:21">像古时一样；<verse eid="LAM 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22" />或者你已经彻底厌弃了我们，</para>
  <para style="q1" vid="LAM 5:22">对我们发怒到了极点！<verse eid="LAM 5:22" /></para>
  <chapter eid="LAM 5" />
</usx>