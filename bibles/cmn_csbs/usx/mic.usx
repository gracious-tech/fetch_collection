<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MIC" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">弥迦书</para>
  <para style="mt">弥迦书</para>
  <chapter number="1" style="c" sid="MIC 1" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1" />
    <char style="pn">犹大</char>王<char style="pn">约坦</char>、<char style="pn">亚哈斯</char>、<char style="pn">希西加</char>年间，耶和华的话语临到了<char style="pn">摩利沙</char>人<char style="pn">弥迦</char>，这是他所见有关<char style="pn">撒玛利亚</char>和<char style="pn">耶路撒冷</char>的异象：<verse eid="MIC 1:1" /></para>
  <para style="b" />
  <para style="s">审判临到以色列</para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 1:2" />所有的子民哪，你们要听！</para>
  <para style="q1" vid="MIC 1:2">大地和其上所充满的，你们要留心听！</para>
  <para style="q1" vid="MIC 1:2">主耶和华作见证人指控你们，</para>
  <para style="q1" vid="MIC 1:2">主从他的圣殿指控你们。<verse eid="MIC 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 1:3" />看哪，耶和华从他的居所出来，</para>
  <para style="q1" vid="MIC 1:3">他降临，踏行大地的高处。<verse eid="MIC 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 1:4" />群山在他脚下消融，</para>
  <para style="q1" vid="MIC 1:4">山谷也崩裂，如蜡遇火，</para>
  <para style="q1" vid="MIC 1:4">如水从斜坡上冲下来。<verse eid="MIC 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 1:5" />这都是因为<char style="pn">雅各</char>的过犯，</para>
  <para style="q1" vid="MIC 1:5">因为<char style="pn">以色列</char>家的罪恶。</para>
  <para style="q1" vid="MIC 1:5">
    <char style="pn">雅各</char>的过犯在哪里？</para>
  <para style="q1" vid="MIC 1:5">难道不是在<char style="pn">撒玛利亚</char>吗？</para>
  <para style="q1" vid="MIC 1:5">
    <char style="pn">犹大</char>的高坛<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">高坛——七十士译本作“罪恶”。</char></note>在哪里？</para>
  <para style="q1" vid="MIC 1:5">难道不是在<char style="pn">耶路撒冷</char>吗？<verse eid="MIC 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 1:6" />所以我要使<char style="pn">撒玛利亚</char></para>
  <para style="q1" vid="MIC 1:6">成为田野的荒堆，</para>
  <para style="q1" vid="MIC 1:6">成为只能栽种葡萄园的地方。</para>
  <para style="q1" vid="MIC 1:6">我要把她的石头倒在山谷中，</para>
  <para style="q1" vid="MIC 1:6">使她的根基裸露。<verse eid="MIC 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 1:7" />她所有的雕像都将被打碎，</para>
  <para style="q1" vid="MIC 1:7">所有卖淫的酬金都将被火烧掉，</para>
  <para style="q1" vid="MIC 1:7">我要使她所有的偶像都荒废；</para>
  <para style="q1" vid="MIC 1:7">她既然从卖淫的酬金得积蓄，</para>
  <para style="q1" vid="MIC 1:7">所积蓄的也必再成为卖淫的酬金。<verse eid="MIC 1:7" /></para>
  <para style="b" />
  <para style="s">审判临到犹大</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 1:8" />为此我要哀哭号叫，</para>
  <para style="q1" vid="MIC 1:8">赤身光脚行走；</para>
  <para style="q1" vid="MIC 1:8">我要哀号如豺狗，</para>
  <para style="q1" vid="MIC 1:8">哀鸣如鸵鸟。<verse eid="MIC 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 1:9" />因为她的创伤无法救治，</para>
  <para style="q1" vid="MIC 1:9">并且蔓延到<char style="pn">犹大</char>，</para>
  <para style="q1" vid="MIC 1:9">延伸到我同胞的城门，</para>
  <para style="q1" vid="MIC 1:9">延伸到<char style="pn">耶路撒冷</char>。<verse eid="MIC 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="MIC 1:10" />你们不要在<char style="pn">迦特</char><note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">迦特——与希伯来语的“报告”谐音。</char></note>报告这事，</para>
  <para style="q1" vid="MIC 1:10">绝不要哭泣！</para>
  <para style="q1" vid="MIC 1:10">要在<char style="pn">伯亚弗拉</char><note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">伯亚弗拉——意思是“尘土之家”。</char></note>打滚于尘土中。<verse eid="MIC 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 1:11" />
    <char style="pn">沙斐</char>的居民哪，</para>
  <para style="q1" vid="MIC 1:11">赤身羞耻地走过去吧！</para>
  <para style="q1" vid="MIC 1:11">
    <char style="pn">策楠</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">1:11 </char>
      <char style="ft" closed="false">策楠——与希伯来语的“出来”谐音。</char>
    </note>的居民不敢出城；</para>
  <para style="q1" vid="MIC 1:11">
    <char style="wj">
      <char style="pn">伯伊泽尔</char>
    </char>在哀号，</para>
  <para style="q1" vid="MIC 1:11">你们失去了立足之地。<verse eid="MIC 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 1:12" />
    <char style="pn">玛罗特</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">1:12 </char>
      <char style="ft" closed="false">玛罗特——意思是“苦”。</char>
    </note>的居民苦苦等候好消息，</para>
  <para style="q1" vid="MIC 1:12">因为灾祸从耶和华那里</para>
  <para style="q1" vid="MIC 1:12">临到了<char style="pn">耶路撒冷</char>城门。<verse eid="MIC 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 1:13" />
    <char style="pn">拉吉</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">1:13 </char>
      <char style="ft" closed="false">拉吉——与希伯来语的“套车”谐音。</char>
    </note>的居民哪，</para>
  <para style="q1" vid="MIC 1:13">用快马套车吧！</para>
  <para style="q1" vid="MIC 1:13">你是女子<char style="pn">锡安</char>犯罪的开端，</para>
  <para style="q1" vid="MIC 1:13">
    <char style="pn">以色列</char>的过犯都在你中间找到了。<verse eid="MIC 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 1:14" />
    <char style="pn">犹大</char>啊<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">犹大啊——辅助词语；本章下同。</char></note>，</para>
  <para style="q1" vid="MIC 1:14">你要拿出陪嫁礼品送别<char style="pn">摩利沙</char><note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">摩利沙——意思与希伯来语的“未婚妻”相近。</char></note>-<char style="pn">迦特</char>。</para>
  <para style="q1" vid="MIC 1:14">
    <char style="pn">阿克济</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">1:14 </char>
      <char style="ft" closed="false">阿克济——与希伯来语的“虚假、不可靠”谐音。</char>
    </note>的各家对<char style="pn">以色列</char>诸王</para>
  <para style="q1" vid="MIC 1:14">是不可靠的溪流。<verse eid="MIC 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 1:15" />
    <char style="pn">玛利沙</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">1:15 </char>
      <char style="ft" closed="false">玛利沙——与希伯来语的“占有、征服”谐音。</char>
    </note>的居民哪，</para>
  <para style="q1" vid="MIC 1:15">我要使征服你的再次来到你这里，</para>
  <para style="q1" vid="MIC 1:15">
    <char style="pn">以色列</char>的尊贵人必逃往<char style="pn">亚杜兰</char>。<verse eid="MIC 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 1:16" />
    <char style="pn">犹大</char>啊，</para>
  <para style="q1" vid="MIC 1:16">为你喜爱的儿女，你剃头剪发吧！</para>
  <para style="q1" vid="MIC 1:16">让你的头如秃鹰彻底光秃！</para>
  <para style="q1" vid="MIC 1:16">因为他们将被掳走离开你。<verse eid="MIC 1:16" /></para>
  <chapter eid="MIC 1" />
  <chapter number="2" style="c" sid="MIC 2" />
  <para style="s">欺压者受审判</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 2:1" />有祸了，那些在床上谋划奸恶、</para>
  <para style="q1" vid="MIC 2:1">策划恶事的人！</para>
  <para style="q1" vid="MIC 2:1">早晨天一亮，他们就行动，</para>
  <para style="q1" vid="MIC 2:1">因为手中有权力。<verse eid="MIC 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 2:2" />他们贪爱田地就抢占，</para>
  <para style="q1" vid="MIC 2:2">贪爱房屋就夺取。</para>
  <para style="q1" vid="MIC 2:2">他们侵夺人的家产，</para>
  <para style="q1" vid="MIC 2:2">掠夺人的继业。<verse eid="MIC 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="MIC 2:3" />因此耶和华如此说：</para>
  <para style="q1" vid="MIC 2:3">看哪，我必针对这族类谋划灾祸！</para>
  <para style="q1" vid="MIC 2:3">你们不能从脖子上甩脱它，</para>
  <para style="q1" vid="MIC 2:3">不能昂首行走，</para>
  <para style="q1" vid="MIC 2:3">因为那是灾祸的时候。<verse eid="MIC 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 2:4" />到那日，</para>
  <para style="q1" vid="MIC 2:4">必有人针对你们吟唱讽刺歌，</para>
  <para style="q1" vid="MIC 2:4">像是在沉痛哀号，说：</para>
  <para style="q1" vid="MIC 2:4">“我们被彻底摧毁了！</para>
  <para style="q1" vid="MIC 2:4">他把子民的继业转给别人了！</para>
  <para style="q1" vid="MIC 2:4">他竟然把继业从我挪去，</para>
  <para style="q1" vid="MIC 2:4">把我们的田地分给了悖逆的人！”<verse eid="MIC 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 2:5" />确实，将来在耶和华的会众里，</para>
  <para style="q1" vid="MIC 2:5">必无人为你抽签拉量绳分地<note caller="+" style="f"><char style="fr" closed="false">2:5 </char><char style="ft" closed="false">分地——辅助词语。</char></note>。<verse eid="MIC 2:5" /></para>
  <para style="b" />
  <para style="s">主的话语被拒绝</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 2:6" />那些人传道说：</para>
  <para style="q1" vid="MIC 2:6">“你们不可传道，</para>
  <para style="q1" vid="MIC 2:6">不可这样传道，</para>
  <para style="q1" vid="MIC 2:6">羞辱不会来临的！”<verse eid="MIC 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 2:7" />
    <char style="pn">雅各</char>家啊，</para>
  <para style="q1" vid="MIC 2:7">怎么有人这样说：</para>
  <para style="q1" vid="MIC 2:7">“耶和华的灵会不耐烦吗？</para>
  <para style="q1" vid="MIC 2:7">这些会是他的作为吗？”</para>
  <para style="q1" vid="MIC 2:7">我的话语难道不是</para>
  <para style="q1" vid="MIC 2:7">对行事正直的人有益处吗？<verse eid="MIC 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 2:8" />近来我的子民如仇敌兴起！</para>
  <para style="q1" vid="MIC 2:8">你们从那些没想着战斗、</para>
  <para style="q1" vid="MIC 2:8">毫无戒备的过路人身上，</para>
  <para style="q1" vid="MIC 2:8">剥去他们的外衣。<verse eid="MIC 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 2:9" />你们把我子民中的妇人</para>
  <para style="q1" vid="MIC 2:9">赶出安乐的家园，</para>
  <para style="q1" vid="MIC 2:9">把我所赐的尊严</para>
  <para style="q1" vid="MIC 2:9">从她们的幼童永远夺去。<verse eid="MIC 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="MIC 2:10" />起来，离开吧！</para>
  <para style="q1" vid="MIC 2:10">这里绝不是安息之地，</para>
  <para style="q1" vid="MIC 2:10">因为它不洁净，必遭毁灭，</para>
  <para style="q1" vid="MIC 2:10">而且是惨重的祸患。<verse eid="MIC 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 2:11" />如果有人往来行走，</para>
  <para style="q1" vid="MIC 2:11">以虚妄和谎言欺骗说：</para>
  <para style="q1" vid="MIC 2:11">“我向你传道，必有淡酒烈酒”，</para>
  <para style="q1" vid="MIC 2:11">那人反倒是这子民的传道者！<verse eid="MIC 2:11" /></para>
  <para style="b" />
  <para style="s">招聚余剩之民</para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 2:12" />
    <char style="pn">雅各</char>啊，</para>
  <para style="q1" vid="MIC 2:12">我必招聚你所有的人，</para>
  <para style="q1" vid="MIC 2:12">必聚集<char style="pn">以色列</char>的余剩之民。</para>
  <para style="q1" vid="MIC 2:12">我要把他们安置在一起，</para>
  <para style="q1" vid="MIC 2:12">像羊群在羊圈里，</para>
  <para style="q1" vid="MIC 2:12">像牛群在草场上，</para>
  <para style="q1" vid="MIC 2:12">人数众多，喧闹欢腾。<verse eid="MIC 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 2:13" />开路者在他们前面上去，</para>
  <para style="q1" vid="MIC 2:13">他们冲过城门出去；</para>
  <para style="q1" vid="MIC 2:13">他们的王在前面过去，</para>
  <para style="q1" vid="MIC 2:13">耶和华在他们的前头。<verse eid="MIC 2:13" /></para>
  <chapter eid="MIC 2" />
  <chapter number="3" style="c" sid="MIC 3" />
  <para style="s">不义的领袖受审判</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 3:1" />我又说：</para>
  <para style="q1" vid="MIC 3:1">
    <char style="pn">雅各</char>的首领、<char style="pn">以色列</char>家的领袖啊，</para>
  <para style="q1" vid="MIC 3:1">你们听着！</para>
  <para style="q1" vid="MIC 3:1">难道你们不知道公正吗？<verse eid="MIC 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 3:2" />你们憎恨美善、喜爱邪恶，</para>
  <para style="q1" vid="MIC 3:2">从人们身上剥皮，</para>
  <para style="q1" vid="MIC 3:2">从他们骨头上剔肉。<verse eid="MIC 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 3:3" />你们吃我子民的肉，</para>
  <para style="q1" vid="MIC 3:3">剥他们的皮，</para>
  <para style="q1" vid="MIC 3:3">打碎他们的骨头，</para>
  <para style="q1" vid="MIC 3:3">把他们切成碎块放进小锅，</para>
  <para style="q1" vid="MIC 3:3">切成肉块放进大锅。<verse eid="MIC 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 3:4" />必有一天，你们<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">你们——原文直译“他们”；指行恶的领袖们。本节下同。</char></note>将哀求耶和华，</para>
  <para style="q1" vid="MIC 3:4">他却不回应你们。</para>
  <para style="q1" vid="MIC 3:4">到那时，</para>
  <para style="q1" vid="MIC 3:4">他必向你们隐藏他的脸，</para>
  <para style="q1" vid="MIC 3:4">因为你们是行恶的。<verse eid="MIC 3:4" /></para>
  <para style="b" />
  <para style="s">假先知受审判</para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 3:5" />至于那些使我子民迷失的先知，</para>
  <para style="q1" vid="MIC 3:5">他们口齿间有可嚼的，</para>
  <para style="q1" vid="MIC 3:5">就宣告平安，</para>
  <para style="q1" vid="MIC 3:5">谁不给他们吃的，</para>
  <para style="q1" vid="MIC 3:5">他们就对谁宣告天罚<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">天罚——或译作“圣战”。</char></note>，</para>
  <para style="q1" vid="MIC 3:5">耶和华论到他们如此说：<verse eid="MIC 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 3:6" />因此黑夜必临到你们，</para>
  <para style="q1" vid="MIC 3:6">以致没有异象；</para>
  <para style="q1" vid="MIC 3:6">黑暗必临到你们，</para>
  <para style="q1" vid="MIC 3:6">以致不能占卜。</para>
  <para style="q1" vid="MIC 3:6">太阳向那些先知沉落，</para>
  <para style="q1" vid="MIC 3:6">白昼对他们变为黑暗。<verse eid="MIC 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 3:7" />那些先见将蒙羞，</para>
  <para style="q1" vid="MIC 3:7">那些占卜的将惭愧；</para>
  <para style="q1" vid="MIC 3:7">他们全都蒙着嘴，</para>
  <para style="q1" vid="MIC 3:7">因为得不到神的回应。<verse eid="MIC 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="MIC 3:8" />然而我因着耶和华的灵，</para>
  <para style="q1" vid="MIC 3:8">充满了能力、公正和勇气，</para>
  <para style="q1" vid="MIC 3:8">可以向<char style="pn">雅各</char>指明他的过犯，</para>
  <para style="q1" vid="MIC 3:8">向<char style="pn">以色列</char>指明他的罪恶。<verse eid="MIC 3:8" /></para>
  <para style="b" />
  <para style="s">锡安被摧毁</para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 3:9" />
    <char style="pn">雅各</char>家的首领、<char style="pn">以色列</char>家的领袖啊，</para>
  <para style="q1" vid="MIC 3:9">你们要听这话！</para>
  <para style="q1" vid="MIC 3:9">你们憎恶公正，扭曲一切正直，<verse eid="MIC 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 3:10" />以人血建造<char style="pn">锡安</char>，</para>
  <para style="q1" vid="MIC 3:10">以不义修筑<char style="pn">耶路撒冷</char>。<verse eid="MIC 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 3:11" />这城的首领为贿赂而审判，</para>
  <para style="q1" vid="MIC 3:11">祭司为工价而教导，</para>
  <para style="q1" vid="MIC 3:11">先知为银子而占卜，</para>
  <para style="q1" vid="MIC 3:11">他们却仰赖耶和华说：</para>
  <para style="q1" vid="MIC 3:11">“难道耶和华不在我们当中吗？</para>
  <para style="q1" vid="MIC 3:11">灾祸不会临到我们。”<verse eid="MIC 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 3:12" />为此，因你们的缘故，</para>
  <para style="q1" vid="MIC 3:12">
    <char style="pn">锡安</char>必像田地那样被翻耕，</para>
  <para style="q1" vid="MIC 3:12">
    <char style="pn">耶路撒冷</char>将成为荒堆，</para>
  <para style="q1" vid="MIC 3:12">圣殿山将成为荒林的高处。<verse eid="MIC 3:12" /></para>
  <chapter eid="MIC 3" />
  <chapter number="4" style="c" sid="MIC 4" />
  <para style="s">耶和华将在锡安作王</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 4:1" />在末后的日子，</para>
  <para style="q1" vid="MIC 4:1">耶和华殿的山</para>
  <para style="q1" vid="MIC 4:1">将被坚立为群山之首，</para>
  <para style="q1" vid="MIC 4:1">被高举超过万岭，</para>
  <para style="q1" vid="MIC 4:1">万民都将涌向这山。<verse eid="MIC 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 4:2" />将有许多民族前往，说：</para>
  <para style="q1" vid="MIC 4:2">“来吧，让我们上耶和华的山，</para>
  <para style="q1" vid="MIC 4:2">到<char style="pn">雅各</char>神的殿！</para>
  <para style="q1" vid="MIC 4:2">愿他把道路指示给我们，</para>
  <para style="q1" vid="MIC 4:2">好让我们遵行他的道。”</para>
  <para style="q1" vid="MIC 4:2">因为训诲从<char style="pn">锡安</char>而出，</para>
  <para style="q1" vid="MIC 4:2">耶和华的话语从<char style="pn">耶路撒冷</char>而来。<verse eid="MIC 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 4:3" />他将在许多民族之间施行审判，</para>
  <para style="q1" vid="MIC 4:3">为远方强盛的列国作出裁决。</para>
  <para style="q1" vid="MIC 4:3">他们将把刀剑打成犁头，</para>
  <para style="q1" vid="MIC 4:3">把长矛打成镰刀；</para>
  <para style="q1" vid="MIC 4:3">这国不举起刀剑攻击那国，</para>
  <para style="q1" vid="MIC 4:3">他们不再学习战事。<verse eid="MIC 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 4:4" />各人安坐</para>
  <para style="q1" vid="MIC 4:4">在自己的葡萄树和无花果树下，</para>
  <para style="q1" vid="MIC 4:4">无人惊吓。</para>
  <para style="q1" vid="MIC 4:4">这是万军之耶和华亲口说的。<verse eid="MIC 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 4:5" />列邦各奉自己神的名而行，</para>
  <para style="q1" vid="MIC 4:5">我们却要奉我们神耶和华的名而行，</para>
  <para style="q1" vid="MIC 4:5">直到永永远远。<verse eid="MIC 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="MIC 4:6" />这是耶和华的宣告：</para>
  <para style="q1" vid="MIC 4:6">到那日，我必招聚瘸腿的，</para>
  <para style="q1" vid="MIC 4:6">聚集被驱散的，以及我所惩治的。<verse eid="MIC 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 4:7" />我要使瘸腿的成为余剩之民，</para>
  <para style="q1" vid="MIC 4:7">使被放逐的成为强盛之国。</para>
  <para style="q1" vid="MIC 4:7">耶和华要在<char style="pn">锡安</char>山作王统治他们，</para>
  <para style="q1" vid="MIC 4:7">从今直到永远。<verse eid="MIC 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 4:8" />至于你，羊群的守望塔<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">羊群的守望塔——或音译“伊德高台”。</char></note>，</para>
  <para style="q1" vid="MIC 4:8">女子<char style="pn">锡安</char>的山冈啊，</para>
  <para style="q1" vid="MIC 4:8">那先前的权柄、女子<char style="pn">耶路撒冷</char>的国权，</para>
  <para style="q1" vid="MIC 4:8">将复归于你。<verse eid="MIC 4:8" /></para>
  <para style="b" />
  <para style="s">被掳后得解救</para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 4:9" />现在你为什么大声哭号呢？</para>
  <para style="q1" vid="MIC 4:9">难道你中间没有君王，</para>
  <para style="q1" vid="MIC 4:9">或者你的谋士都消亡了，</para>
  <para style="q1" vid="MIC 4:9">以致剧痛抓住你，像妇人临产那样吗？<verse eid="MIC 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 4:10" />女子<char style="pn">锡安</char>哪，</para>
  <para style="q1" vid="MIC 4:10">像临产妇人那样痛苦呻吟吧！</para>
  <para style="q1" vid="MIC 4:10">现在你必从城中出来，</para>
  <para style="q1" vid="MIC 4:10">居住在野外，然后到<char style="pn">巴比伦</char>去。</para>
  <para style="q1" vid="MIC 4:10">在那里你将得解救，</para>
  <para style="q1" vid="MIC 4:10">耶和华必救赎你脱离仇敌的手。<verse eid="MIC 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 4:11" />现在许多民族聚集起来攻击你，说：</para>
  <para style="q1" vid="MIC 4:11">“愿<char style="pn">锡安</char>被玷污，</para>
  <para style="q1" vid="MIC 4:11">我们要观赏她！”<verse eid="MIC 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 4:12" />他们却不知道耶和华的意念，</para>
  <para style="q1" vid="MIC 4:12">也不明白他的谋划；</para>
  <para style="q1" vid="MIC 4:12">其实他聚集他们，</para>
  <para style="q1" vid="MIC 4:12">就像把禾捆聚集到打谷场上。<verse eid="MIC 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 4:13" />女子<char style="pn">锡安</char>哪，你起来踹谷吧！</para>
  <para style="q1" vid="MIC 4:13">我必使你的犄角成为铁的，</para>
  <para style="q1" vid="MIC 4:13">使你的蹄子成为铜的。</para>
  <para style="q1" vid="MIC 4:13">你将磨碎许多民族，</para>
  <para style="q1" vid="MIC 4:13">把战利品永献给耶和华，</para>
  <para style="q1" vid="MIC 4:13">把他们的财富归给全地的主。<verse eid="MIC 4:13" /></para>
  <chapter eid="MIC 4" />
  <chapter number="5" style="c" sid="MIC 5" />
  <para style="s">一位得胜的君王<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="ft" closed="false">此章在马索拉文本为4:14至5:14。</char></note></para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 5:1" />你这被围攻的女子啊，</para>
  <para style="q1" vid="MIC 5:1">割伤自己吧！</para>
  <para style="q1" vid="MIC 5:1">我们被围困了！</para>
  <para style="q1" vid="MIC 5:1">敌人要用杖击打<char style="pn">以色列</char>审判官的脸颊。<verse eid="MIC 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 5:2" />
    <char style="pn">伯利恒</char>-<char style="pn">以法他</char>啊，</para>
  <para style="q1" vid="MIC 5:2">你在<char style="pn">犹大</char>各宗族的城<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">各宗族的城——原文直译“一千”；常用于表示群体单位。</char></note>中虽然微小，</para>
  <para style="q1" vid="MIC 5:2">但从你中间将出来一个人，</para>
  <para style="q1" vid="MIC 5:2">为我作<char style="pn">以色列</char>的掌权者。</para>
  <para style="q1" vid="MIC 5:2">他的根源从太初就在，</para>
  <para style="q1" vid="MIC 5:2">从亘古的日子就有。<verse eid="MIC 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 5:3" />因此耶和华将把他们交出去<note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="ft" closed="false">把他们交出去——或译作“把以色列人交付敌人”。</char></note>，</para>
  <para style="q1" vid="MIC 5:3">直到那临产的妇人生孩子的时候。</para>
  <para style="q1" vid="MIC 5:3">那时，他余剩的兄弟们</para>
  <para style="q1" vid="MIC 5:3">将重新归入<char style="pn">以色列</char>子孙。<verse eid="MIC 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 5:4" />他必兴起，以耶和华的大能，</para>
  <para style="q1" vid="MIC 5:4">以他的神耶和华之名的威严牧养他们；</para>
  <para style="q1" vid="MIC 5:4">他们将安然居住，</para>
  <para style="q1" vid="MIC 5:4">因为那时他将尊大直到地极。<verse eid="MIC 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 5:5" />这一位就是我们的平安。</para>
  <para style="q1" vid="MIC 5:5">当<char style="pn">亚述</char>入侵我们的土地，</para>
  <para style="q1" vid="MIC 5:5">践踏我们的城堡时，</para>
  <para style="q1" vid="MIC 5:5">我们会兴起</para>
  <para style="q1" vid="MIC 5:5">七个牧人、八个首领对付他，<verse eid="MIC 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 5:6" />他们以刀剑统管<char style="pn">亚述</char>地，</para>
  <para style="q1" vid="MIC 5:6">以拔出的剑统管<char style="pn">宁录</char>地。</para>
  <para style="q1" vid="MIC 5:6">当<char style="pn">亚述</char>入侵我们的土地、</para>
  <para style="q1" vid="MIC 5:6">践踏我们的地界时，</para>
  <para style="q1" vid="MIC 5:6">他必从<char style="pn">亚述</char>手中解救我们。<verse eid="MIC 5:6" /></para>
  <para style="b" />
  <para style="s">荣耀圣洁的余剩之民</para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 5:7" />那时，<char style="pn">雅各</char>的余剩之民</para>
  <para style="q1" vid="MIC 5:7">在许多民族当中，</para>
  <para style="q1" vid="MIC 5:7">就像耶和华赐下的甘露，</para>
  <para style="q1" vid="MIC 5:7">又像牧草上的甘霖；</para>
  <para style="q1" vid="MIC 5:7">他们不仰望人，</para>
  <para style="q1" vid="MIC 5:7">也不期待世人。<verse eid="MIC 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 5:8" />
    <char style="pn">雅各</char>的余剩之民</para>
  <para style="q1" vid="MIC 5:8">在列国中，在许多民族当中，</para>
  <para style="q1" vid="MIC 5:8">就像森林百兽中的狮子，</para>
  <para style="q1" vid="MIC 5:8">又像羊群中的少壮狮子；</para>
  <para style="q1" vid="MIC 5:8">他若经过，就踩踏撕碎，</para>
  <para style="q1" vid="MIC 5:8">无人解救。<verse eid="MIC 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 5:9" />愿你的手高举，</para>
  <para style="q1" vid="MIC 5:9">胜过你的敌人，</para>
  <para style="q1" vid="MIC 5:9">愿你的一切仇敌都被剪除！<verse eid="MIC 5:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="MIC 5:10" />这是耶和华的宣告：</para>
  <para style="q1" vid="MIC 5:10">到那日，</para>
  <para style="q1" vid="MIC 5:10">我必从你中间剪除你的马匹，</para>
  <para style="q1" vid="MIC 5:10">摧毁你的战车。<verse eid="MIC 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 5:11" />我要剪除你境内的城镇，</para>
  <para style="q1" vid="MIC 5:11">拆毁你所有的堡垒。<verse eid="MIC 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 5:12" />我要从你手中剪除巫术，</para>
  <para style="q1" vid="MIC 5:12">你那里绝不再有算命者。<verse eid="MIC 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 5:13" />我要从你当中剪除你的雕像和神柱，</para>
  <para style="q1" vid="MIC 5:13">你不会再向自己手所做的下拜。<verse eid="MIC 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 5:14" />我要从你中间拔出<char style="pn">亚舍拉</char>柱，</para>
  <para style="q1" vid="MIC 5:14">毁灭你的城镇。<verse eid="MIC 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 5:15" />我要在怒气和怒火中，</para>
  <para style="q1" vid="MIC 5:15">向那些不听从我的国家施行报复。<verse eid="MIC 5:15" /></para>
  <chapter eid="MIC 5" />
  <chapter number="6" style="c" sid="MIC 6" />
  <para style="s">主对犹大的指控</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1" />你们要听耶和华所说的：</para>
  <para style="q1" vid="MIC 6:1">起来，在群山面前申辩吧，</para>
  <para style="q1" vid="MIC 6:1">让山岭听见你的声音；<verse eid="MIC 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 6:2" />群山和大地恒久的根基啊，</para>
  <para style="q1" vid="MIC 6:2">请听耶和华的争讼！</para>
  <para style="q1" vid="MIC 6:2">因为耶和华与他的子民有争讼，</para>
  <para style="q1" vid="MIC 6:2">与<char style="pn">以色列</char>辩论。<verse eid="MIC 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 6:3" />我的子民哪，我对你做了什么，</para>
  <para style="q1" vid="MIC 6:3">我在什么事上使你厌烦呢？</para>
  <para style="q1" vid="MIC 6:3">你指证我吧！<verse eid="MIC 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 6:4" />是我把你从<char style="pn">埃及</char>地带上来，</para>
  <para style="q1" vid="MIC 6:4">从为奴之家救赎出来，</para>
  <para style="q1" vid="MIC 6:4">又派遣了<char style="pn">摩西</char>、<char style="pn">亚伦</char>和<char style="pn">米利暗</char>带领你。<verse eid="MIC 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 6:5" />我的子民哪，</para>
  <para style="q1" vid="MIC 6:5">你们要回想<char style="pn">摩押</char>王<char style="pn">巴勒</char>策划了什么，</para>
  <para style="q1" vid="MIC 6:5">
    <char style="pn">比珥</char>的儿子<char style="pn">巴兰</char>答应了他什么，</para>
  <para style="q1" vid="MIC 6:5">以及从<char style="pn">什亭</char>到<char style="pn">吉甲</char>发生了什么，</para>
  <para style="q1" vid="MIC 6:5">好使你们明白耶和华的公义行为。<verse eid="MIC 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="MIC 6:6" />我朝见耶和华，向至高的神跪拜时，</para>
  <para style="q1" vid="MIC 6:6">要献上什么呢？</para>
  <para style="q1" vid="MIC 6:6">难道我要带着燔祭，</para>
  <para style="q1" vid="MIC 6:6">带着一岁的公牛犊朝见他吗？<verse eid="MIC 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 6:7" />难道耶和华喜悦</para>
  <para style="q1" vid="MIC 6:7">千千的公羊，万万的油河吗？</para>
  <para style="q1" vid="MIC 6:7">难道我可以为自己的过犯献上长子，</para>
  <para style="q1" vid="MIC 6:7">为自己的罪恶献上亲生儿女<note caller="+" style="f"><char style="fr" closed="false">6:7 </char><char style="ft" closed="false">亲生儿女——原文直译“腹中的出产”。</char></note>吗？<verse eid="MIC 6:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="MIC 6:8" />世人哪，耶和华已经告诉你了，</para>
  <para style="q1" vid="MIC 6:8">什么是美善，</para>
  <para style="q1" vid="MIC 6:8">什么是耶和华向你要求的：</para>
  <para style="q1" vid="MIC 6:8">他只要你实行公正，</para>
  <para style="q1" vid="MIC 6:8">喜爱恩慈<note caller="+" style="f"><char style="fr" closed="false">6:8 </char><char style="ft" closed="false">恩慈——或译作“信实的爱”。</char></note>，</para>
  <para style="q1" vid="MIC 6:8">心存谦卑与你的神同行。<verse eid="MIC 6:8" /></para>
  <para style="b" />
  <para style="s">主的判决</para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 6:9" />耶和华向这城发声呼喊！</para>
  <para style="q1" vid="MIC 6:9">敬畏他<note caller="+" style="f"><char style="fr" closed="false">6:9 </char><char style="ft" closed="false">他——原文直译“你”。</char></note>的名是真智慧，</para>
  <para style="q1" vid="MIC 6:9">这支派和这城的会众啊，</para>
  <para style="q1" vid="MIC 6:9">你们要聆听<note caller="+" style="f"><char style="fr" closed="false">6:9 </char><char style="ft" closed="false">这支派和这城的会众啊，你们要聆听——或译作“你们当听从这权杖和指派它的那一位”。</char></note>：<verse eid="MIC 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 6:10" />恶人家中不是还有不义之财，</para>
  <para style="q1" vid="MIC 6:10">有可憎的缩小<note caller="+" style="f"><char style="fr" closed="false">6:10 </char><char style="ft" closed="false">缩小——或译作“诡诈”。</char></note>量斗<note caller="+" style="f"><char style="fr" closed="false">6:10 </char><char style="ft" closed="false">量斗——原文直译“伊法”；相当于22公升的谷物量器。</char></note>吗？<verse eid="MIC 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 6:11" />人用不义的天平和欺诈的砝码，</para>
  <para style="q1" vid="MIC 6:11">难道我能看为清正吗？<note caller="+" style="f"><char style="fr" closed="false">6:11 </char><char style="ft" closed="false">此节或译作：我如果用不义的天平和欺诈的砝码，难道能显为清洁吗？</char></note><verse eid="MIC 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 6:12" />城中的富人充满恶行，</para>
  <para style="q1" vid="MIC 6:12">城中的居民说虚假的话，</para>
  <para style="q1" vid="MIC 6:12">他们的舌头满口是诡诈。<verse eid="MIC 6:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="MIC 6:13" />因此我要重重击打你，</para>
  <para style="q1" vid="MIC 6:13">使你因罪恶而荒凉。<verse eid="MIC 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 6:14" />你吃却吃不饱，饥肠辘辘。</para>
  <para style="q1" vid="MIC 6:14">你所获取的，无法保全；</para>
  <para style="q1" vid="MIC 6:14">你所保全的，我必交给刀剑。<verse eid="MIC 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 6:15" />你播种却没有收获，</para>
  <para style="q1" vid="MIC 6:15">踹橄榄却不能用油抹身，</para>
  <para style="q1" vid="MIC 6:15">踹葡萄却喝不到葡萄酒。<verse eid="MIC 6:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 6:16" />你持守了<char style="pn">欧姆利</char>的习俗和</para>
  <para style="q1" vid="MIC 6:16">
    <char style="pn">亚哈</char>家的一切作为，</para>
  <para style="q1" vid="MIC 6:16">随从他们的计谋，</para>
  <para style="q1" vid="MIC 6:16">因此我要使你成为荒场<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false">成为荒场——或译作“令人惊骇”。</char></note>，</para>
  <para style="q1" vid="MIC 6:16">使你的居民被嗤笑，</para>
  <para style="q1" vid="MIC 6:16">你们必担当我子民的羞辱。<verse eid="MIC 6:16" /></para>
  <chapter eid="MIC 6" />
  <chapter number="7" style="c" sid="MIC 7" />
  <para style="s">以色列的败坏</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 7:1" />我多么悲惨！</para>
  <para style="q1" vid="MIC 7:1">就像采摘夏季的果实，</para>
  <para style="q1" vid="MIC 7:1">又像采收遗落的葡萄，</para>
  <para style="q1" vid="MIC 7:1">却找不到一串可吃的，</para>
  <para style="q1" vid="MIC 7:1">找不到我渴望的初熟无花果。<verse eid="MIC 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 7:2" />忠信者从地上消亡了，</para>
  <para style="q1" vid="MIC 7:2">世人中没有一个正直人。</para>
  <para style="q1" vid="MIC 7:2">他们全都埋伏杀人流血，</para>
  <para style="q1" vid="MIC 7:2">用网罗彼此猎取。<verse eid="MIC 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 7:3" />他们双手擅长作恶，</para>
  <para style="q1" vid="MIC 7:3">首领和审判官索要贿赂，</para>
  <para style="q1" vid="MIC 7:3">权贵们交谈心中的贪欲，</para>
  <para style="q1" vid="MIC 7:3">他们相互勾结。<verse eid="MIC 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 7:4" />他们中最好的就像荆棘，</para>
  <para style="q1" vid="MIC 7:4">最正直的也不过是蒺藜。</para>
  <para style="q1" vid="MIC 7:4">你的守望者们所预言的日子，</para>
  <para style="q1" vid="MIC 7:4">你受惩罚的日子已经来到，</para>
  <para style="q1" vid="MIC 7:4">现在他们必定惊惶。<verse eid="MIC 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 7:5" />不要相信朋友，</para>
  <para style="q1" vid="MIC 7:5">不要信赖同伴，</para>
  <para style="q1" vid="MIC 7:5">连躺在你怀中的妻子，</para>
  <para style="q1" vid="MIC 7:5">你也要向她谨守你的口。<verse eid="MIC 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 7:6" />因为儿子将敌视父亲，</para>
  <para style="q1" vid="MIC 7:6">女儿将起来敌对母亲，</para>
  <para style="q1" vid="MIC 7:6">儿媳将敌对婆婆，</para>
  <para style="q1" vid="MIC 7:6">人的仇敌就是自己的家人。<verse eid="MIC 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 7:7" />但我仍要守候耶和华，</para>
  <para style="q1" vid="MIC 7:7">等候神我的救主，</para>
  <para style="q1" vid="MIC 7:7">我的神必垂听我。<verse eid="MIC 7:7" /></para>
  <para style="b" />
  <para style="s">为锡安施行公正</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 7:8" />我的仇敌啊，不要对我幸灾乐祸！</para>
  <para style="q1" vid="MIC 7:8">我虽然仆倒，仍将起来；</para>
  <para style="q1" vid="MIC 7:8">我虽然坐在黑暗里，</para>
  <para style="q1" vid="MIC 7:8">耶和华必作我的光。<verse eid="MIC 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 7:9" />我应当承受耶和华的愤怒，</para>
  <para style="q1" vid="MIC 7:9">因为我对他犯了罪；</para>
  <para style="q1" vid="MIC 7:9">直到他为我辩护，</para>
  <para style="q1" vid="MIC 7:9">为我施行公正。</para>
  <para style="q1" vid="MIC 7:9">那时他将领我出黑暗<note caller="+" style="f"><char style="fr" closed="false">7:9 </char><char style="ft" closed="false">黑暗——辅助词语。</char></note>，入光明，</para>
  <para style="q1" vid="MIC 7:9">我将看见他的公义。<verse eid="MIC 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 7:10" />我的仇敌看见了，</para>
  <para style="q1" vid="MIC 7:10">就必被羞耻淹没，</para>
  <para style="q1" vid="MIC 7:10">他曾对我说：</para>
  <para style="q1" vid="MIC 7:10">“你的神耶和华在哪里呢？”</para>
  <para style="q1" vid="MIC 7:10">我必亲眼看他遭报，</para>
  <para style="q1" vid="MIC 7:10">那时他将被践踏，</para>
  <para style="q1" vid="MIC 7:10">如同街上的烂泥。<verse eid="MIC 7:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="MIC 7:11" />必有一天，要重建你的围墙；</para>
  <para style="q1" vid="MIC 7:11">那一天，你的地界将扩展；<verse eid="MIC 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 7:12" />那一天，</para>
  <para style="q1" vid="MIC 7:12">从<char style="pn">亚述</char>到<char style="pn">埃及</char>的城镇，</para>
  <para style="q1" vid="MIC 7:12">从<char style="pn">埃及</char>到大河，</para>
  <para style="q1" vid="MIC 7:12">从这海到那海，</para>
  <para style="q1" vid="MIC 7:12">从这山到那山，</para>
  <para style="q1" vid="MIC 7:12">人们将来到你这里。<verse eid="MIC 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 7:13" />全地却将因其上的居民，</para>
  <para style="q1" vid="MIC 7:13">因他们行为所结的果实而荒凉。<verse eid="MIC 7:13" /></para>
  <para style="b" />
  <para style="s">弥迦的祷告</para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 7:14" />求你用你的杖牧养你的子民，</para>
  <para style="q1" vid="MIC 7:14">牧养你的产业、你的羊群，</para>
  <para style="q1" vid="MIC 7:14">他们独自安居在林间，在果园中；</para>
  <para style="q1" vid="MIC 7:14">愿他们在<char style="pn">巴珊</char>和<char style="pn">基列</char>得牧养，</para>
  <para style="q1" vid="MIC 7:14">像古时的日子那样。<verse eid="MIC 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 7:15" />“我必向他显明奇妙的事，</para>
  <para style="q1" vid="MIC 7:15">就像你出<char style="pn">埃及</char>地的日子那样。”<verse eid="MIC 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 7:16" />列国看见了，</para>
  <para style="q1" vid="MIC 7:16">就为他们的一切势力羞惭，</para>
  <para style="q1" vid="MIC 7:16">捂住嘴巴，耳朵变聋。<verse eid="MIC 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MIC 7:17" />他们将舔土如蛇，</para>
  <para style="q1" vid="MIC 7:17">如地上的爬虫；</para>
  <para style="q1" vid="MIC 7:17">他们将颤抖着从他们的营寨出来。</para>
  <para style="q1" vid="MIC 7:17">他们来到我们的神耶和华面前，</para>
  <para style="q1" vid="MIC 7:17">战战兢兢，因你而害怕。<verse eid="MIC 7:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="MIC 7:18" />神哪，有哪一位能像你赦免罪孽，</para>
  <para style="q1" vid="MIC 7:18">除去你产业余剩之民的过犯呢？</para>
  <para style="q1" vid="MIC 7:18">你不永远怀怒，</para>
  <para style="q1" vid="MIC 7:18">而是喜爱施行恩慈<note caller="+" style="f"><char style="fr" closed="false">7:18 </char><char style="ft" closed="false">恩慈——或译作“信实的爱”；下同。</char></note>。<verse eid="MIC 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MIC 7:19" />你会重新怜悯我们，</para>
  <para style="q1" vid="MIC 7:19">制伏我们的罪孽；</para>
  <para style="q1" vid="MIC 7:19">你会把我们<note caller="+" style="f"><char style="fr" closed="false">7:19 </char><char style="ft" closed="false">我们——依据七十士译本；马索拉文本作“他们”。</char></note>所有的罪恶都抛入海洋深处。<verse eid="MIC 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MIC 7:20" />你必照着你古时向我们祖先所起的誓，</para>
  <para style="q1" vid="MIC 7:20">向<char style="pn">雅各</char>显出信实，</para>
  <para style="q1" vid="MIC 7:20">向<char style="pn">亚伯拉罕</char>施行恩慈。<verse eid="MIC 7:20" /></para>
  <chapter eid="MIC 7" />
</usx>