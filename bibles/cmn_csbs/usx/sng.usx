<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="SNG" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">雅歌</para>
  <para style="mt">雅歌</para>
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="nb">
    <verse number="1" style="v" sid="SNG 1:1" />歌中之歌，<char style="pn">所罗门</char>的歌。<verse eid="SNG 1:1" /></para>
  <para style="b" />
  <para style="sp">女子</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2" />愿他的口连连亲吻我！</para>
  <para style="q1" vid="SNG 1:2">你的爱情实在比酒更醇美。<verse eid="SNG 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3" />你的膏油馨香芬芳，</para>
  <para style="q1" vid="SNG 1:3">你的名如膏油淌溢，</para>
  <para style="q1" vid="SNG 1:3">因此少女们都爱你。<verse eid="SNG 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4" />拉着我跟随你啊，</para>
  <para style="q1" vid="SNG 1:4">让我们快跑——</para>
  <para style="q1" vid="SNG 1:4">王带我进了他的内室！</para>
  <para style="q1" vid="SNG 1:4">让我们因你而欢喜快乐，</para>
  <para style="q1" vid="SNG 1:4">回味你的爱情胜过品尝美酒。</para>
  <para style="q1" vid="SNG 1:4">她们理当爱你！<verse eid="SNG 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5" />
    <char style="pn">耶路撒冷</char>的女儿们哪，</para>
  <para style="q1" vid="SNG 1:5">我虽然黑，但是秀美，</para>
  <para style="q1" vid="SNG 1:5">如同<char style="pn">基达</char>的帐篷，</para>
  <para style="q1" vid="SNG 1:5">如同<char style="pn">所罗门</char>的幔帐。<verse eid="SNG 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6" />不要因为我黑就那样看我，</para>
  <para style="q1" vid="SNG 1:6">是太阳晒黑了我。</para>
  <para style="q1" vid="SNG 1:6">我母亲的儿子们对我发怒，</para>
  <para style="q1" vid="SNG 1:6">让我看护葡萄园，</para>
  <para style="q1" vid="SNG 1:6">我自己的葡萄园却没有看护。<verse eid="SNG 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7" />我心所爱的啊，请告诉我，</para>
  <para style="q1" vid="SNG 1:7">你在何处放牧，</para>
  <para style="q1" vid="SNG 1:7">中午你让羊群在何处安歇？</para>
  <para style="q1" vid="SNG 1:7">我何必像蒙着脸<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">蒙着脸——或译作“徘徊”。</char></note>的女子，</para>
  <para style="q1" vid="SNG 1:7">在你同伴的羊群旁边呢？<verse eid="SNG 1:7" /></para>
  <para style="b" />
  <para style="sp">众人</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8" />你这女子中最美丽的，</para>
  <para style="q1" vid="SNG 1:8">你如果不知道，</para>
  <para style="q1" vid="SNG 1:8">就跟着羊群的脚踪出去吧，</para>
  <para style="q1" vid="SNG 1:8">在牧人们的帐篷旁边</para>
  <para style="q1" vid="SNG 1:8">牧放你的小羊。<verse eid="SNG 1:8" /></para>
  <para style="b" />
  <para style="s">良人</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9" />我的佳偶啊，</para>
  <para style="q1" vid="SNG 1:9">我将你比作法老车驾前的牝马；<verse eid="SNG 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10" />你的脸颊因流苏而秀美，</para>
  <para style="q1" vid="SNG 1:10">你的颈项因珠串而优雅！<verse eid="SNG 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11" />我们要为你制作金流苏，</para>
  <para style="q1" vid="SNG 1:11">缀上银珠子。<verse eid="SNG 1:11" /></para>
  <para style="b" />
  <para style="sp">女子</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12" />王偎坐下来的时候，</para>
  <para style="q1" vid="SNG 1:12">我的哪哒散发馨香。<verse eid="SNG 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13" />我以我的良人为一袋没药，</para>
  <para style="q1" vid="SNG 1:13">长留在我胸怀间；<verse eid="SNG 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14" />我以我的良人为一串凤仙花，</para>
  <para style="q1" vid="SNG 1:14">盛开<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">盛开——辅助词语。</char></note>在<char style="pn">恩盖迪</char>的葡萄园。<verse eid="SNG 1:14" /></para>
  <para style="b" />
  <para style="s">良人</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15" />看哪，我的佳偶，你多美丽！</para>
  <para style="q1" vid="SNG 1:15">看哪，你多美丽！</para>
  <para style="q1" vid="SNG 1:15">你的眼睛像一对鸽子。<verse eid="SNG 1:15" /></para>
  <para style="b" />
  <para style="sp">女子</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16" />看哪，我的良人，</para>
  <para style="q1" vid="SNG 1:16">你多俊美，多么美好！</para>
  <para style="q1" vid="SNG 1:16">我们的床多么青翠，<verse eid="SNG 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17" />我们房屋的梁都是香柏木，</para>
  <para style="q1" vid="SNG 1:17">我们的椽子是松木。<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1" />我是<char style="pn">沙仑</char>的玫瑰花，</para>
  <para style="q1" vid="SNG 2:1">是谷中的百合花。<verse eid="SNG 2:1" /></para>
  <para style="b" />
  <para style="sp">良人</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2" />我的佳偶在女子中，</para>
  <para style="q1" vid="SNG 2:2">像蒺藜丛中的一枝百合花！<verse eid="SNG 2:2" /></para>
  <para style="b" />
  <para style="sp">女子</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3" />我的良人在男子中，</para>
  <para style="q1" vid="SNG 2:3">像林木中的一棵苹果树。</para>
  <para style="q1" vid="SNG 2:3">我欢喜地坐在他树荫下，</para>
  <para style="q1" vid="SNG 2:3">他的果实在我唇齿间甘甜。<verse eid="SNG 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4" />他带我进入宴会殿堂，</para>
  <para style="q1" vid="SNG 2:4">爱的旗帜在我之上。<verse eid="SNG 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5" />请以葡萄饼增补我力量，</para>
  <para style="q1" vid="SNG 2:5">以苹果使我舒畅，</para>
  <para style="q1" vid="SNG 2:5">因我思爱成病！<verse eid="SNG 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6" />愿他左手托着我的头，</para>
  <para style="q1" vid="SNG 2:6">右手抱住我。<verse eid="SNG 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7" />
    <char style="pn">耶路撒冷</char>的女儿们哪，</para>
  <para style="q1" vid="SNG 2:7">我指着羚羊或田野的母鹿叮嘱你们：</para>
  <para style="q1" vid="SNG 2:7">不要催促，不要催发爱情，</para>
  <para style="q1" vid="SNG 2:7">要等它自愿发生！<verse eid="SNG 2:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8" />听啊，我良人的声音！</para>
  <para style="q1" vid="SNG 2:8">看哪，他来了——</para>
  <para style="q1" vid="SNG 2:8">跃过群山，翻过山岭！<verse eid="SNG 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9" />我的良人好比羚羊或小鹿。</para>
  <para style="q1" vid="SNG 2:9">看哪，他站在我们的墙外面，</para>
  <para style="q1" vid="SNG 2:9">透过窗户凝望，</para>
  <para style="q1" vid="SNG 2:9">透过窗格探看！<verse eid="SNG 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10" />我的良人呼唤我说：</para>
  <para style="q1" vid="SNG 2:10">“起来，我的佳偶！</para>
  <para style="q1" vid="SNG 2:10">走吧，我的美人！<verse eid="SNG 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11" />看哪，冬天已经过去，</para>
  <para style="q1" vid="SNG 2:11">雨季已经消逝离开；<verse eid="SNG 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12" />大地上百花绽放，</para>
  <para style="q1" vid="SNG 2:12">欢唱<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">欢唱——或译作“修剪”；原文是双关语。</char></note>的时节来到，</para>
  <para style="q1" vid="SNG 2:12">我们境内已经听见斑鸠的叫声；<verse eid="SNG 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13" />无花果树结出了青果，</para>
  <para style="q1" vid="SNG 2:13">葡萄树也开花放香。</para>
  <para style="q1" vid="SNG 2:13">起来，我的佳偶！</para>
  <para style="q1" vid="SNG 2:13">跟我走吧，我的美人！”<verse eid="SNG 2:13" /></para>
  <para style="b" />
  <para style="s">良人</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14" />我的鸽子啊，</para>
  <para style="q1" vid="SNG 2:14">你在山岩缝隙中，</para>
  <para style="q1" vid="SNG 2:14">在峭壁的隐秘处。</para>
  <para style="q1" vid="SNG 2:14">请让我看见你的容貌，</para>
  <para style="q1" vid="SNG 2:14">听见你的声音；</para>
  <para style="q1" vid="SNG 2:14">因为你的声音甜美，</para>
  <para style="q1" vid="SNG 2:14">你的容貌秀美。<verse eid="SNG 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15" />请为我们捉拿狐狸，</para>
  <para style="q1" vid="SNG 2:15">就是毁坏葡萄园的小狐狸，</para>
  <para style="q1" vid="SNG 2:15">我们的葡萄园正在花期。<verse eid="SNG 2:15" /></para>
  <para style="b" />
  <para style="s">女子</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16" />我的良人属我，我也属他；</para>
  <para style="q1" vid="SNG 2:16">他在百合花中放牧。<verse eid="SNG 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17" />等天起凉风、日影飞逝的时候，</para>
  <para style="q1" vid="SNG 2:17">我的良人哪，你要回来，</para>
  <para style="q1" vid="SNG 2:17">好比羚羊或小鹿，</para>
  <para style="q1" vid="SNG 2:17">越过起伏的山岭<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="ft" closed="false">起伏的山岭——或音译“比特山”。</char></note>！<verse eid="SNG 2:17" /></para>
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1" />夜间我在床上，</para>
  <para style="q1" vid="SNG 3:1">寻找我心所爱的；</para>
  <para style="q1" vid="SNG 3:1">我寻找他，却没有找到。<verse eid="SNG 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2" />“我要起来，走遍城中，</para>
  <para style="q1" vid="SNG 3:2">在街道，在广场，</para>
  <para style="q1" vid="SNG 3:2">寻找我心所爱的！”</para>
  <para style="q1" vid="SNG 3:2">我寻找他，还是没有找到。<verse eid="SNG 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3" />守夜的人遇见了我，</para>
  <para style="q1" vid="SNG 3:3">他们正在城中巡行。</para>
  <para style="q1" vid="SNG 3:3">“你们有没有看见我心所爱的？”<verse eid="SNG 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4" />我刚离开他们，</para>
  <para style="q1" vid="SNG 3:4">就找到我心所爱的。</para>
  <para style="q1" vid="SNG 3:4">我抱住他，不放他走，</para>
  <para style="q1" vid="SNG 3:4">直到把他带到我母亲的家，</para>
  <para style="q1" vid="SNG 3:4">进入孕育我之人的内室。<verse eid="SNG 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5" />
    <char style="pn">耶路撒冷</char>的女儿们哪，</para>
  <para style="q1" vid="SNG 3:5">我指着羚羊或田野的母鹿叮嘱你们：</para>
  <para style="q1" vid="SNG 3:5">不要催促，不要催发爱情，</para>
  <para style="q1" vid="SNG 3:5">要等它自愿发生！<verse eid="SNG 3:5" /></para>
  <para style="b" />
  <para style="sp">众人</para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6" />那像烟柱一样，</para>
  <para style="q1" vid="SNG 3:6">从旷野上来的是什么呢？</para>
  <para style="q1" vid="SNG 3:6">它薰染了没药和乳香，</para>
  <para style="q1" vid="SNG 3:6">以及客商各样的香粉。<verse eid="SNG 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7" />看哪，是<char style="pn">所罗门</char>的御轿！</para>
  <para style="q1" vid="SNG 3:7">四围有六十位勇士，</para>
  <para style="q1" vid="SNG 3:7">
    <char style="pn">以色列</char>精锐的勇士。<verse eid="SNG 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8" />他们全都佩刀，善于争战；</para>
  <para style="q1" vid="SNG 3:8">各人腰间佩刀，</para>
  <para style="q1" vid="SNG 3:8">应对夜间的危险。<verse eid="SNG 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9" />
    <char style="pn">所罗门</char>王用<char style="pn">黎巴嫩</char>的木料，</para>
  <para style="q1" vid="SNG 3:9">为自己做了一顶轿子：<verse eid="SNG 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10" />轿柱是银做的，</para>
  <para style="q1" vid="SNG 3:10">轿底是金做的，</para>
  <para style="q1" vid="SNG 3:10">坐垫是紫色布，</para>
  <para style="q1" vid="SNG 3:10">轿内装饰着<char style="pn">耶路撒冷</char>女儿们的爱情。<verse eid="SNG 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 3:11" />
    <char style="pn">锡安</char>的女儿啊，</para>
  <para style="q1" vid="SNG 3:11">你们出来观看<char style="pn">所罗门</char>王，</para>
  <para style="q1" vid="SNG 3:11">他戴着冠冕，</para>
  <para style="q1" vid="SNG 3:11">是在他结婚的日子，</para>
  <para style="q1" vid="SNG 3:11">心里喜乐的日子，</para>
  <para style="q1" vid="SNG 3:11">母亲为他戴上的！<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="sp">良人</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1" />看哪，我的佳偶，你多美丽！</para>
  <para style="q1" vid="SNG 4:1">看哪，你多美丽！</para>
  <para style="q1" vid="SNG 4:1">你的眼睛在面纱后，</para>
  <para style="q1" vid="SNG 4:1">好像一对鸽子。</para>
  <para style="q1" vid="SNG 4:1">你的头发像一群山羊，</para>
  <para style="q1" vid="SNG 4:1">从<char style="pn">基列</char>山奔下来。<verse eid="SNG 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2" />你的牙齿好比一群新剪毛的羊，</para>
  <para style="q1" vid="SNG 4:2">洗净后上来，</para>
  <para style="q1" vid="SNG 4:2">全都是双生的，</para>
  <para style="q1" vid="SNG 4:2">没有失丧一只。<verse eid="SNG 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3" />你的嘴唇像一条红丝带，</para>
  <para style="q1" vid="SNG 4:3">你的小嘴也秀美。</para>
  <para style="q1" vid="SNG 4:3">你的脸颊在面纱后，</para>
  <para style="q1" vid="SNG 4:3">就像两瓣石榴。<verse eid="SNG 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4" />你的颈项如<char style="pn">大卫</char>的塔楼，</para>
  <para style="q1" vid="SNG 4:4">层叠建造，</para>
  <para style="q1" vid="SNG 4:4">有一千小盾挂在其上，</para>
  <para style="q1" vid="SNG 4:4">全是勇士的盾牌。<verse eid="SNG 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5" />你的双乳像两只小鹿，</para>
  <para style="q1" vid="SNG 4:5">像双生的羚羊，</para>
  <para style="q1" vid="SNG 4:5">徜徉在百合花中。<verse eid="SNG 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6" />等到天起凉风、日影飞逝，</para>
  <para style="q1" vid="SNG 4:6">我就前往没药山、乳香岭！<verse eid="SNG 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7" />我的佳偶，</para>
  <para style="q1" vid="SNG 4:7">你全然美丽，你毫无瑕疵！<verse eid="SNG 4:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8" />我的新娘啊，</para>
  <para style="q1" vid="SNG 4:8">让我带你离开<char style="pn">黎巴嫩</char>山，</para>
  <para style="q1" vid="SNG 4:8">一同离开<char style="pn">黎巴嫩</char>山！</para>
  <para style="q1" vid="SNG 4:8">从<char style="pn">亚玛拿</char>山顶，</para>
  <para style="q1" vid="SNG 4:8">从<char style="pn">示尼珥</char>和<char style="pn">黑门</char>山顶，</para>
  <para style="q1" vid="SNG 4:8">从狮子洞和豹子山俯看！<verse eid="SNG 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9" />你夺去了我的心，</para>
  <para style="q1" vid="SNG 4:9">我的妹子，我的新娘！</para>
  <para style="q1" vid="SNG 4:9">你用眼眸的一瞥，</para>
  <para style="q1" vid="SNG 4:9">用你颈项上的一串明珠，</para>
  <para style="q1" vid="SNG 4:9">夺去了我的心。<verse eid="SNG 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10" />你的爱情多么美，</para>
  <para style="q1" vid="SNG 4:10">我的妹子，我的新娘！</para>
  <para style="q1" vid="SNG 4:10">你的爱情多么醇美，胜过美酒；</para>
  <para style="q1" vid="SNG 4:10">你膏油的馨香胜过一切香料。<verse eid="SNG 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11" />你的嘴唇滴落蜂房的蜜，</para>
  <para style="q1" vid="SNG 4:11">新娘啊，你舌头底下有蜂蜜和奶，</para>
  <para style="q1" vid="SNG 4:11">你衣裳的香气如<char style="pn">黎巴嫩</char>的香气。<verse eid="SNG 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12" />你是关锁的园子，</para>
  <para style="q1" vid="SNG 4:12">我的妹子，我的新娘！</para>
  <para style="q1" vid="SNG 4:12">你是关锁的园林<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="ft" closed="false">园林——或译作“水井”。</char></note>，封住的泉源。<verse eid="SNG 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13" />你所栽种的<note caller="+" style="f"><char style="fr" closed="false">4:13 </char><char style="ft" closed="false">所栽种的——或译作“所灌溉的”。</char></note>是石榴园，</para>
  <para style="q1" vid="SNG 4:13">有佳美的果实，</para>
  <para style="q1" vid="SNG 4:13">还有凤仙花和哪哒，<verse eid="SNG 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 4:14" />哪哒和番红花，菖蒲和肉桂，</para>
  <para style="q1" vid="SNG 4:14">以及各样的乳香树，</para>
  <para style="q1" vid="SNG 4:14">有没药和沉香，</para>
  <para style="q1" vid="SNG 4:14">以及各样上等的香料。<verse eid="SNG 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15" />你是园中的泉源，</para>
  <para style="q1" vid="SNG 4:15">是活水井，</para>
  <para style="q1" vid="SNG 4:15">是从<char style="pn">黎巴嫩</char>流下来的溪水。<verse eid="SNG 4:15" /></para>
  <para style="b" />
  <para style="sp">女子</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16" />北风啊，兴起！</para>
  <para style="q1" vid="SNG 4:16">南风啊，吹来！</para>
  <para style="q1" vid="SNG 4:16">吹进我的园子，</para>
  <para style="q1" vid="SNG 4:16">让其中的香气散发出来。</para>
  <para style="q1" vid="SNG 4:16">愿我的良人进入他的园子，</para>
  <para style="q1" vid="SNG 4:16">享用佳美的果实。<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="sp">良人</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1" />我进了我的园子，</para>
  <para style="q1" vid="SNG 5:1">我的妹子，我的新娘！</para>
  <para style="q1" vid="SNG 5:1">我采摘了我的没药和香料，</para>
  <para style="q1" vid="SNG 5:1">吃了我的蜂房和蜂蜜，</para>
  <para style="q1" vid="SNG 5:1">喝了我的酒和奶。</para>
  <para style="q1" vid="SNG 5:1">吃吧，朋友们！</para>
  <para style="q1" vid="SNG 5:1">喝吧，畅饮吧，亲爱的人们！<verse eid="SNG 5:1" /></para>
  <para style="b" />
  <para style="sp">女子</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2" />我沉睡，心却醒着。</para>
  <para style="q1" vid="SNG 5:2">听啊，我良人的声音，</para>
  <para style="q1" vid="SNG 5:2">他在叩门。</para>
  <para style="b" vid="SNG 5:2" />
  <para style="sp" vid="SNG 5:2">良人</para>
  <para style="q1" vid="SNG 5:2">“请给我开门，</para>
  <para style="q1" vid="SNG 5:2">我的妹子，我的佳偶，</para>
  <para style="q1" vid="SNG 5:2">我的鸽子，我的完美佳人！</para>
  <para style="q1" vid="SNG 5:2">我头上满了露水，</para>
  <para style="q1" vid="SNG 5:2">发绺沾满夜间的雾滴。”<verse eid="SNG 5:2" /></para>
  <para style="b" />
  <para style="sp">女子</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3" />“我已脱下袍子，</para>
  <para style="q1" vid="SNG 5:3">怎能再穿上呢？</para>
  <para style="q1" vid="SNG 5:3">我已洗净双脚，</para>
  <para style="q1" vid="SNG 5:3">怎能再弄脏呢？”<verse eid="SNG 5:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4" />我的良人从门缝伸进手来，</para>
  <para style="q1" vid="SNG 5:4">我的内心就因他而颤动。<verse eid="SNG 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5" />我起来给我的良人开门，</para>
  <para style="q1" vid="SNG 5:5">我的双手滴落没药，</para>
  <para style="q1" vid="SNG 5:5">我手指头的没药汁落在门闩上。<verse eid="SNG 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6" />我给良人开了门，</para>
  <para style="q1" vid="SNG 5:6">良人却已转身离去。</para>
  <para style="q1" vid="SNG 5:6">他告别的时候，我伤心至极！</para>
  <para style="q1" vid="SNG 5:6">我寻找他，却没有找到；</para>
  <para style="q1" vid="SNG 5:6">我呼唤他，却没有回应。<verse eid="SNG 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7" />守夜的人遇见了我，</para>
  <para style="q1" vid="SNG 5:7">他们正在城中巡行。</para>
  <para style="q1" vid="SNG 5:7">他们击打我，打伤我；</para>
  <para style="q1" vid="SNG 5:7">那些看守城墙的人，</para>
  <para style="q1" vid="SNG 5:7">从我身上拿走我的披巾。<verse eid="SNG 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8" />
    <char style="pn">耶路撒冷</char>的女儿们哪，</para>
  <para style="q1" vid="SNG 5:8">我叮嘱你们：</para>
  <para style="q1" vid="SNG 5:8">如果你们找到我的良人，</para>
  <para style="q1" vid="SNG 5:8">请告诉他：我思爱成病！<verse eid="SNG 5:8" /></para>
  <para style="b" />
  <para style="sp">耶路撒冷的女子</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9" />你这女子中最美丽的，</para>
  <para style="q1" vid="SNG 5:9">你的良人比别人的良人好在哪里？</para>
  <para style="q1" vid="SNG 5:9">你的良人比别人的良人好在哪里，</para>
  <para style="q1" vid="SNG 5:9">你竟这样叮嘱我们？<verse eid="SNG 5:9" /></para>
  <para style="b" />
  <para style="sp">女子</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10" />我的良人光洁红润，</para>
  <para style="q1" vid="SNG 5:10">超乎万人之上。<verse eid="SNG 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11" />他的头好像至纯的黄金，</para>
  <para style="q1" vid="SNG 5:11">他的发绺卷曲，黑如乌鸦。<verse eid="SNG 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12" />他的眼睛好像溪水旁的鸽子，</para>
  <para style="q1" vid="SNG 5:12">在牛奶中洗净了，</para>
  <para style="q1" vid="SNG 5:12">停落在池塘边<note caller="+" style="f"><char style="fr" closed="false">5:12 </char><char style="ft" closed="false">停落在池塘边——或译作“镶嵌如宝石”。</char></note>。<verse eid="SNG 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13" />他的脸颊如香花畦，</para>
  <para style="q1" vid="SNG 5:13">如香草的高台。</para>
  <para style="q1" vid="SNG 5:13">他的嘴唇是百合花，</para>
  <para style="q1" vid="SNG 5:13">滴落没药汁。<verse eid="SNG 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14" />他的手臂是金杖，</para>
  <para style="q1" vid="SNG 5:14">镶嵌着黄水晶。</para>
  <para style="q1" vid="SNG 5:14">他的腰腹是抛光的象牙，</para>
  <para style="q1" vid="SNG 5:14">镶裹着蓝宝石。<verse eid="SNG 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15" />他的大腿是白玉石柱，</para>
  <para style="q1" vid="SNG 5:15">稳立在纯金底座上。</para>
  <para style="q1" vid="SNG 5:15">他的身材像<char style="pn">黎巴嫩</char>山，</para>
  <para style="q1" vid="SNG 5:15">挺拔如香柏树。<verse eid="SNG 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16" />他的唇齿甜蜜，</para>
  <para style="q1" vid="SNG 5:16">他全然令人珍爱。</para>
  <para style="q1" vid="SNG 5:16">
    <char style="pn">耶路撒冷</char>的女儿们哪，</para>
  <para style="q1" vid="SNG 5:16">这就是我的良人，</para>
  <para style="q1" vid="SNG 5:16">这就是我的朋友！<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="sp">耶路撒冷的女子</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1" />你这女子中最美丽的，</para>
  <para style="q1" vid="SNG 6:1">你的良人去了哪里？</para>
  <para style="q1" vid="SNG 6:1">你的良人转往了何处？</para>
  <para style="q1" vid="SNG 6:1">让我们与你一同寻找他！<verse eid="SNG 6:1" /></para>
  <para style="b" />
  <para style="sp">女子</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2" />我的良人前往他的园子，</para>
  <para style="q1" vid="SNG 6:2">到了香花畦，</para>
  <para style="q1" vid="SNG 6:2">在园子里放牧，</para>
  <para style="q1" vid="SNG 6:2">采摘百合花。<verse eid="SNG 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3" />我属我的良人，</para>
  <para style="q1" vid="SNG 6:3">我的良人也属我；</para>
  <para style="q1" vid="SNG 6:3">他在百合花中放牧。<verse eid="SNG 6:3" /></para>
  <para style="b" />
  <para style="sp">良人</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4" />我的佳偶，你美丽如<char style="pn">提尔撒</char>，</para>
  <para style="q1" vid="SNG 6:4">秀美如<char style="pn">耶路撒冷</char>，</para>
  <para style="q1" vid="SNG 6:4">威严如高举旌旗的军队。<verse eid="SNG 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5" />请将你的眼眸从我移开，</para>
  <para style="q1" vid="SNG 6:5">因为它们使我惊乱。</para>
  <para style="q1" vid="SNG 6:5">你的头发像一群山羊，</para>
  <para style="q1" vid="SNG 6:5">从<char style="pn">基列</char>山奔下来。<verse eid="SNG 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6" />你的牙齿好比一群羊，</para>
  <para style="q1" vid="SNG 6:6">洗净后上来，</para>
  <para style="q1" vid="SNG 6:6">全都是双生的，</para>
  <para style="q1" vid="SNG 6:6">没有失丧一只。<verse eid="SNG 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7" />你的脸颊在面纱后，</para>
  <para style="q1" vid="SNG 6:7">就像两瓣石榴。<verse eid="SNG 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8" />虽有六十位王后，</para>
  <para style="q1" vid="SNG 6:8">八十位妃嫔，</para>
  <para style="q1" vid="SNG 6:8">以及无数的少女——<verse eid="SNG 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9" />我的鸽子，我的完美佳人，</para>
  <para style="q1" vid="SNG 6:9">她却是独一的！</para>
  <para style="q1" vid="SNG 6:9">她母亲看她是独一的，</para>
  <para style="q1" vid="SNG 6:9">生她的妇人以她为最爱<note caller="+" style="f"><char style="fr" closed="false">6:9 </char><char style="ft" closed="false">以她为最爱——依据七十士译本；或译作“看她最纯洁”。</char></note>。</para>
  <para style="q1" vid="SNG 6:9">众女子看见她，就称她有福，</para>
  <para style="q1" vid="SNG 6:9">王后和妃嫔们也都赞美她。<verse eid="SNG 6:9" /></para>
  <para style="b" />
  <para style="sp">耶路撒冷的女子</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10" />那像曙光一样俯视的是谁呢？</para>
  <para style="q1" vid="SNG 6:10">她美丽如月亮，</para>
  <para style="q1" vid="SNG 6:10">光洁如太阳，</para>
  <para style="q1" vid="SNG 6:10">威严如高举旌旗的军队！<verse eid="SNG 6:10" /></para>
  <para style="b" />
  <para style="sp">女子</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11" />我前往核桃园，</para>
  <para style="q1" vid="SNG 6:11">要看看溪谷中的嫩枝，</para>
  <para style="q1" vid="SNG 6:11">葡萄树是否发芽，</para>
  <para style="q1" vid="SNG 6:11">石榴树是否开花。<verse eid="SNG 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12" />不知不觉，</para>
  <para style="q1" vid="SNG 6:12">我坐上了尊贵者的战车。<verse eid="SNG 6:12" /></para>
  <para style="b" />
  <para style="sp">耶路撒冷的女子</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13" />
    <note caller="+" style="f">
      <char style="fr" closed="false">6:13 </char>
      <char style="ft" closed="false">——此节在马索拉文本为7:1。</char>
    </note>回来，回来，<char style="pn">书拉密</char>的女子！</para>
  <para style="q1" vid="SNG 6:13">回来，回来，让我们看看你！</para>
  <para style="b" vid="SNG 6:13" />
  <para style="sp" vid="SNG 6:13">良人</para>
  <para style="q1" vid="SNG 6:13">你们为什么要观看<char style="pn">书拉密</char>的女子，</para>
  <para style="q1" vid="SNG 6:13">就像观看<char style="pn">玛哈念</char><note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">玛哈念——或译作“两队军兵”。</char></note>的舞蹈呢？<verse eid="SNG 6:13" /></para>
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1" />
    <note caller="+" style="f">
      <char style="fr" closed="false">7:1 </char>
      <char style="ft" closed="false">此章在马索拉文本为7:2至7:14。</char>
    </note>尊贵的女子啊，</para>
  <para style="q1" vid="SNG 7:1">你的脚在鞋子里多么美！</para>
  <para style="q1" vid="SNG 7:1">你的大腿圆润如珠玉，</para>
  <para style="q1" vid="SNG 7:1">是巧匠的手艺。<verse eid="SNG 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2" />你的肚脐像一个圆杯，</para>
  <para style="q1" vid="SNG 7:2">从不缺少调和的酒。</para>
  <para style="q1" vid="SNG 7:2">你的腰腹像一堆小麦，</para>
  <para style="q1" vid="SNG 7:2">四周环绕着百合花。<verse eid="SNG 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3" />你的双乳像两只小鹿，</para>
  <para style="q1" vid="SNG 7:3">像双生的羚羊。<verse eid="SNG 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4" />你的颈项如象牙的塔楼，</para>
  <para style="q1" vid="SNG 7:4">你的眼睛像<char style="pn">巴特拉宾</char>城门旁</para>
  <para style="q1" vid="SNG 7:4">
    <char style="pn">希实本</char>的水池。</para>
  <para style="q1" vid="SNG 7:4">你的鼻梁如<char style="pn">黎巴嫩</char>的塔楼，</para>
  <para style="q1" vid="SNG 7:4">俯看着<char style="pn">大马士革</char>。<verse eid="SNG 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5" />你的头高昂如<char style="pn">迦密</char>山，</para>
  <para style="q1" vid="SNG 7:5">你的头发像紫色的缎子，</para>
  <para style="q1" vid="SNG 7:5">王被这秀发缠住了。<verse eid="SNG 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6" />你多么美，多么令人喜悦！</para>
  <para style="q1" vid="SNG 7:6">佳偶啊，你多么令人陶醉！<verse eid="SNG 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7" />你这身材好比棕榈树，</para>
  <para style="q1" vid="SNG 7:7">你的乳房是饱满的果实。<verse eid="SNG 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8" />我说：“我要爬上棕榈树，</para>
  <para style="q1" vid="SNG 7:8">我要抓住它的果实！”</para>
  <para style="q1" vid="SNG 7:8">愿你的乳房像两挂葡萄，</para>
  <para style="q1" vid="SNG 7:8">愿你鼻孔的香气如苹果；<verse eid="SNG 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 7:9" />愿你的唇齿像上好的酒——</para>
  <para style="b" vid="SNG 7:9" />
  <para style="sp" vid="SNG 7:9">女子</para>
  <para style="q1" vid="SNG 7:9">缓缓流向我的良人，</para>
  <para style="q1" vid="SNG 7:9">滑入沉醉<note caller="+" style="f"><char style="fr" closed="false">7:9 </char><char style="ft" closed="false">沉醉——原文直译“沉睡”。</char></note>的嘴唇！<verse eid="SNG 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10" />我属我的良人，</para>
  <para style="q1" vid="SNG 7:10">他唯独恋慕我。<verse eid="SNG 7:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11" />走吧，我的良人，</para>
  <para style="q1" vid="SNG 7:11">让我们出去到田间，</para>
  <para style="q1" vid="SNG 7:11">在凤仙花丛<note caller="+" style="f"><char style="fr" closed="false">7:11 </char><char style="ft" closed="false">凤仙花丛——或译作“乡村”。</char></note>中留宿。<verse eid="SNG 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12" />让我们早早起来去葡萄园，</para>
  <para style="q1" vid="SNG 7:12">看看葡萄树是否发芽，</para>
  <para style="q1" vid="SNG 7:12">花苞是否绽开，</para>
  <para style="q1" vid="SNG 7:12">石榴树是否开花，</para>
  <para style="q1" vid="SNG 7:12">我要在那里将我的爱情献给你。<verse eid="SNG 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13" />风茄正散发香气，</para>
  <para style="q1" vid="SNG 7:13">在我们的门口有各样新陈的佳果，</para>
  <para style="q1" vid="SNG 7:13">我的良人哪，</para>
  <para style="q1" vid="SNG 7:13">这都是我为你珍藏的。<verse eid="SNG 7:13" /></para>
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1" />多希望你是我的兄弟，</para>
  <para style="q1" vid="SNG 8:1">我母亲的乳汁所喂养的！</para>
  <para style="q1" vid="SNG 8:1">这样，我在外面遇见你，</para>
  <para style="q1" vid="SNG 8:1">就可以亲吻你，</para>
  <para style="q1" vid="SNG 8:1">也没有人藐视我。<verse eid="SNG 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2" />我就能引领你，</para>
  <para style="q1" vid="SNG 8:2">进入那教导我的母亲的家；</para>
  <para style="q1" vid="SNG 8:2">我要给你喝醇香的酒，</para>
  <para style="q1" vid="SNG 8:2">我酿的石榴甜酒。<verse eid="SNG 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3" />愿他左手托着我的头，</para>
  <para style="q1" vid="SNG 8:3">右手抱住我。<verse eid="SNG 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4" />
    <char style="pn">耶路撒冷</char>的女儿们哪，</para>
  <para style="q1" vid="SNG 8:4">我叮嘱你们：</para>
  <para style="q1" vid="SNG 8:4">不要催促，不要催发爱情，</para>
  <para style="q1" vid="SNG 8:4">要等它自愿发生！<verse eid="SNG 8:4" /></para>
  <para style="b" />
  <para style="sp">耶路撒冷的女子</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5" />那偎依着良人，</para>
  <para style="q1" vid="SNG 8:5">从旷野上来的是谁呢？</para>
  <para style="b" vid="SNG 8:5" />
  <para style="sp" vid="SNG 8:5">女子</para>
  <para style="q1" vid="SNG 8:5">在苹果树下，我唤醒了你；</para>
  <para style="q1" vid="SNG 8:5">在那里，你的母亲怀上你；</para>
  <para style="q1" vid="SNG 8:5">在那里，她怀上你又生下你。<verse eid="SNG 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6" />愿你把我放在心上如印章，</para>
  <para style="q1" vid="SNG 8:6">戴在手臂上如印戒！</para>
  <para style="q1" vid="SNG 8:6">因为爱情如死亡一样顽强，</para>
  <para style="q1" vid="SNG 8:6">妒爱像阴间一样残忍；</para>
  <para style="q1" vid="SNG 8:6">它的光焰是火的光焰，</para>
  <para style="q1" vid="SNG 8:6">是炽烈的火焰。<verse eid="SNG 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7" />这爱情，</para>
  <para style="q1" vid="SNG 8:7">大水不能扑灭，</para>
  <para style="q1" vid="SNG 8:7">江河不能冲没。</para>
  <para style="q1" vid="SNG 8:7">谁若拿全部的家财换这爱情，</para>
  <para style="q1" vid="SNG 8:7">就要被全然藐视。<verse eid="SNG 8:7" /></para>
  <para style="b" />
  <para style="sp">弟兄们</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8" />我们有一个小妹妹，</para>
  <para style="q1" vid="SNG 8:8">她的乳房还未长成。</para>
  <para style="q1" vid="SNG 8:8">有人给她提亲的日子，</para>
  <para style="q1" vid="SNG 8:8">我们该为妹妹怎样办理呢？<verse eid="SNG 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9" />如果她是城墙，</para>
  <para style="q1" vid="SNG 8:9">我们就在她前面修筑银的营寨；</para>
  <para style="q1" vid="SNG 8:9">如果她是城门，</para>
  <para style="q1" vid="SNG 8:9">我们就用香柏木板把她围起来。<verse eid="SNG 8:9" /></para>
  <para style="b" />
  <para style="sp">女子</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10" />我是城墙，</para>
  <para style="q1" vid="SNG 8:10">我的乳房就像塔楼；</para>
  <para style="q1" vid="SNG 8:10">那时在他眼中，</para>
  <para style="q1" vid="SNG 8:10">我像寻得了平安的人。<verse eid="SNG 8:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11" />
    <char style="pn">所罗门</char>在<char style="pn">巴力哈门</char>有一个葡萄园，</para>
  <para style="q1" vid="SNG 8:11">他把这葡萄园交给了看护的人，</para>
  <para style="q1" vid="SNG 8:11">各人要为收获的果实</para>
  <para style="q1" vid="SNG 8:11">上交一千锭银子。<verse eid="SNG 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12" />我自己的葡萄园由我支配，</para>
  <para style="q1" vid="SNG 8:12">
    <char style="pn">所罗门</char>哪，</para>
  <para style="q1" vid="SNG 8:12">一千锭银子给你，</para>
  <para style="q1" vid="SNG 8:12">两百锭给看护果实的人。<verse eid="SNG 8:12" /></para>
  <para style="b" />
  <para style="sp">良人</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13" />在这园中安居的女子啊，</para>
  <para style="q1" vid="SNG 8:13">我的同伴都在聆听你的声音。</para>
  <para style="q1" vid="SNG 8:13">请让我倾听！<verse eid="SNG 8:13" /></para>
  <para style="b" />
  <para style="sp">女子</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14" />我的良人哪，快来吧，</para>
  <para style="q1" vid="SNG 8:14">好比羚羊或小鹿，</para>
  <para style="q1" vid="SNG 8:14">越过香料山！<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>