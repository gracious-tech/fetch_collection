<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NAM" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">那鸿书</para>
  <para style="mt">那鸿书</para>
  <chapter number="1" style="c" sid="NAM 1" />
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1" />有关<char style="pn">尼尼微</char>的默示，<char style="pn">伊勒克施</char>人<char style="pn">那鸿</char>的异象<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">异象——或译作“启示”。</char></note>记录：<verse eid="NAM 1:1" /></para>
  <para style="b" />
  <para style="s">神施行报复</para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 1:2" />耶和华是忌邪和报复的神；</para>
  <para style="q1" vid="NAM 1:2">耶和华施行报复，怀有烈怒；</para>
  <para style="q1" vid="NAM 1:2">耶和华报复他的敌人，</para>
  <para style="q1" vid="NAM 1:2">对他的仇敌怀怒。<verse eid="NAM 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 1:3" />耶和华不轻易发怒，</para>
  <para style="q1" vid="NAM 1:3">有伟大的能力；</para>
  <para style="q1" vid="NAM 1:3">耶和华绝不会让有罪的免于罪罚。</para>
  <para style="q1" vid="NAM 1:3">他在旋风和暴风中行路，</para>
  <para style="q1" vid="NAM 1:3">云雾是他脚下的尘土。<verse eid="NAM 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 1:4" />他斥责海，海就枯干，</para>
  <para style="q1" vid="NAM 1:4">他使所有的河流干涸；</para>
  <para style="q1" vid="NAM 1:4">
    <char style="pn">巴珊</char>和<char style="pn">迦密</char>就衰败，</para>
  <para style="q1" vid="NAM 1:4">
    <char style="pn">黎巴嫩</char>的花朵也衰残。<verse eid="NAM 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 1:5" />大山因他而震动，</para>
  <para style="q1" vid="NAM 1:5">小山也崩解，</para>
  <para style="q1" vid="NAM 1:5">大地在他的面前起伏动荡，</para>
  <para style="q1" vid="NAM 1:5">世界和其上的居民也都如此。<verse eid="NAM 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 1:6" />谁能在他的愤怒面前站立得住，</para>
  <para style="q1" vid="NAM 1:6">谁能抵挡他猛烈的怒气？</para>
  <para style="q1" vid="NAM 1:6">他的烈怒如火倾泻，</para>
  <para style="q1" vid="NAM 1:6">磐石也在他面前崩裂。<verse eid="NAM 1:6" /></para>
  <para style="b" />
  <para style="s">尼尼微将毁灭</para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 1:7" />耶和华是良善的，</para>
  <para style="q1" vid="NAM 1:7">是人在患难之日的堡垒，</para>
  <para style="q1" vid="NAM 1:7">他认识那些投靠他的人。<verse eid="NAM 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 1:8" />他却要用泛滥的洪流</para>
  <para style="q1" vid="NAM 1:8">彻底冲毁<char style="pn">尼尼微</char><note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">尼尼微——或译作“仇敌的住处”。</char></note>，</para>
  <para style="q1" vid="NAM 1:8">把仇敌驱赶到黑暗中。<verse eid="NAM 1:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="NAM 1:9" />你们谋划什么抵挡耶和华呢？</para>
  <para style="q1" vid="NAM 1:9">他必彻底冲毁，</para>
  <para style="q1" vid="NAM 1:9">敌对者<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">敌对者——或译作“患难”。</char></note>再也不能兴起。<verse eid="NAM 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 1:10" />他们即使像缠结的荆棘，</para>
  <para style="q1" vid="NAM 1:10">又像酒徒沉迷的酒，</para>
  <para style="q1" vid="NAM 1:10">也必如干透的麦秸，</para>
  <para style="q1" vid="NAM 1:10">被火吞噬。<verse eid="NAM 1:10" /></para>
  <para style="b" />
  <para style="s">神应许拯救犹大</para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 1:11" />有个卑劣的阴谋家从<char style="pn">尼尼微</char><note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">尼尼微——原文作“你”。</char></note>出来，</para>
  <para style="q1" vid="NAM 1:11">谋划恶事抵挡耶和华。<verse eid="NAM 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 1:12" />耶和华如此说：</para>
  <para style="q1" vid="NAM 1:12">“虽然他们装备齐全，</para>
  <para style="q1" vid="NAM 1:12">人数如此众多，</para>
  <para style="q1" vid="NAM 1:12">但他们照样会被剪除消逝。</para>
  <para style="q1" vid="NAM 1:12">
    <char style="pn">犹大</char>啊<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">犹大啊——辅助词语。</char></note>，</para>
  <para style="q1" vid="NAM 1:12">我虽然曾苦待你，</para>
  <para style="q1" vid="NAM 1:12">但不会再苦待你。<verse eid="NAM 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 1:13" />现在我要从你身上打断他的轭，</para>
  <para style="q1" vid="NAM 1:13">拉断你身上的绳索。”<verse eid="NAM 1:13" /></para>
  <para style="b" />
  <para style="s">亚述王败亡</para>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 1:14" />
    <char style="pn">尼尼微</char>啊<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">尼尼微啊——辅助词语。</char></note>，</para>
  <para style="q1" vid="NAM 1:14">耶和华已经针对你下令：</para>
  <para style="q1" vid="NAM 1:14">你的名不会再延续下去了；</para>
  <para style="q1" vid="NAM 1:14">我将从你神明的庙宇中</para>
  <para style="q1" vid="NAM 1:14">铲除雕像和铸像，</para>
  <para style="q1" vid="NAM 1:14">我将预备你的坟墓，</para>
  <para style="q1" vid="NAM 1:14">因为你是被诅咒<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">被诅咒——或译作“卑劣”。</char></note>的。<verse eid="NAM 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="NAM 1:15" />看哪，群山上</para>
  <para style="q1" vid="NAM 1:15">有传好消息、宣告平安的人的脚踪。</para>
  <para style="q1" vid="NAM 1:15">
    <char style="pn">犹大</char>啊，守你的节期，</para>
  <para style="q1" vid="NAM 1:15">还你所许的愿吧！</para>
  <para style="q1" vid="NAM 1:15">因为那卑劣之徒</para>
  <para style="q1" vid="NAM 1:15">再也不会从你中间经过了，</para>
  <para style="q1" vid="NAM 1:15">他们全都被剪除了。<verse eid="NAM 1:15" /></para>
  <chapter eid="NAM 1" />
  <chapter number="2" style="c" sid="NAM 2" />
  <para style="s">尼尼微受审判</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 2:1" />
    <char style="pn">尼尼微</char>啊<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">尼尼微啊——辅助词语。</char></note>，</para>
  <para style="q1" vid="NAM 2:1">驱散者上来攻击你了！</para>
  <para style="q1" vid="NAM 2:1">你要坚守堡垒，</para>
  <para style="q1" vid="NAM 2:1">守望道路，</para>
  <para style="q1" vid="NAM 2:1">稳固你的腰，</para>
  <para style="q1" vid="NAM 2:1">鼓足你的全部力量。<verse eid="NAM 2:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="NAM 2:2" />耶和华必恢复<char style="pn">雅各</char>的繁荣，</para>
  <para style="q1" vid="NAM 2:2">也就是<char style="pn">以色列</char>的繁荣；</para>
  <para style="q1" vid="NAM 2:2">尽管抢掠者曾把他们抢掠一空，</para>
  <para style="q1" vid="NAM 2:2">毁坏了他们的葡萄枝。<verse eid="NAM 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="NAM 2:3" />驱散者的战士们拿着赤红的盾牌，</para>
  <para style="q1" vid="NAM 2:3">勇士们身穿朱红色衣服；</para>
  <para style="q1" vid="NAM 2:3">在预备好战斗的日子，</para>
  <para style="q1" vid="NAM 2:3">铁战车如火闪亮，</para>
  <para style="q1" vid="NAM 2:3">柏木的矛杆飞舞。<verse eid="NAM 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 2:4" />战车在街道上狂奔，</para>
  <para style="q1" vid="NAM 2:4">在广场上猛冲；</para>
  <para style="q1" vid="NAM 2:4">它们形状像火把，</para>
  <para style="q1" vid="NAM 2:4">疾驰如闪电。<verse eid="NAM 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 2:5" />王<note caller="+" style="f"><char style="fr" closed="false">2:5 </char><char style="ft" closed="false">王——辅助词语。</char></note>召集他的军官们，</para>
  <para style="q1" vid="NAM 2:5">他们跌跌撞撞前进，</para>
  <para style="q1" vid="NAM 2:5">急速冲向城墙，架起防护盾。<verse eid="NAM 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 2:6" />河的闸门被打开了，</para>
  <para style="q1" vid="NAM 2:6">王宫被冲毁了。<verse eid="NAM 2:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="NAM 2:7" />王后将被剥去荣华<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">王后将被剥去荣华——或译作“这事已命定，她要被剥去荣华”。</char></note>，被带走；</para>
  <para style="q1" vid="NAM 2:7">她的婢女们捶着胸，</para>
  <para style="q1" vid="NAM 2:7">哀鸣如鸽子。<verse eid="NAM 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 2:8" />
    <char style="pn">尼尼微</char>往日就像满盈的蓄水池，</para>
  <para style="q1" vid="NAM 2:8">但现在人们纷纷逃跑；</para>
  <para style="q1" vid="NAM 2:8">虽有喊声<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false">虽有喊声——辅助词语。</char></note>“站住！站住！”</para>
  <para style="q1" vid="NAM 2:8">却无一人回头。<verse eid="NAM 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 2:9" />抢夺银子吧，</para>
  <para style="q1" vid="NAM 2:9">抢夺金子吧！</para>
  <para style="q1" vid="NAM 2:9">满屋的资财不计其数，</para>
  <para style="q1" vid="NAM 2:9">各样的宝器琳琅满目。<verse eid="NAM 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 2:10" />荒废了！荒芜了！荒凉了！</para>
  <para style="q1" vid="NAM 2:10">人心消融，膝盖颤抖，</para>
  <para style="q1" vid="NAM 2:10">满腰剧痛，人人脸色惨白！<verse eid="NAM 2:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="NAM 2:11" />狮子的巢穴在哪里呢？</para>
  <para style="q1" vid="NAM 2:11">少壮狮子的栖息地在哪里呢？</para>
  <para style="q1" vid="NAM 2:11">公狮、母狮行走游荡，</para>
  <para style="q1" vid="NAM 2:11">幼狮不受惊吓的地方在哪里呢？<verse eid="NAM 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 2:12" />在那里<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">在那里——辅助词语。</char></note>，</para>
  <para style="q1" vid="NAM 2:12">公狮为幼狮撕掠足够的食物，</para>
  <para style="q1" vid="NAM 2:12">为母狮咬死活物；</para>
  <para style="q1" vid="NAM 2:12">猎物堆满它的洞穴，</para>
  <para style="q1" vid="NAM 2:12">撕碎的肉堆满它的巢穴。<verse eid="NAM 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 2:13" />这是万军之耶和华的宣告：</para>
  <para style="q1" vid="NAM 2:13">看哪，我与你敌对！</para>
  <para style="q1" vid="NAM 2:13">我要使你的战车在浓烟中烧掉，</para>
  <para style="q1" vid="NAM 2:13">使你的少壮狮子被刀剑吞灭。</para>
  <para style="q1" vid="NAM 2:13">我要使你的猎物从地上断绝，</para>
  <para style="q1" vid="NAM 2:13">你使者的声音再也不会被人听见。<verse eid="NAM 2:13" /></para>
  <chapter eid="NAM 2" />
  <chapter number="3" style="c" sid="NAM 3" />
  <para style="s">亚述的覆灭</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 3:1" />有祸了，这杀人流血的城！</para>
  <para style="q1" vid="NAM 3:1">城中尽是欺诈，充满抢劫，</para>
  <para style="q1" vid="NAM 3:1">抢夺的事从不间断。<verse eid="NAM 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 3:2" />听啊，</para>
  <para style="q1" vid="NAM 3:2">鞭子的响声，车轮的轰鸣！</para>
  <para style="q1" vid="NAM 3:2">战马飞跃，战车奔腾。<verse eid="NAM 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 3:3" />马兵冲上来，</para>
  <para style="q1" vid="NAM 3:3">刀剑闪耀，长矛闪亮。</para>
  <para style="q1" vid="NAM 3:3">被杀的人众多，死尸成堆，</para>
  <para style="q1" vid="NAM 3:3">尸体不计其数，</para>
  <para style="q1" vid="NAM 3:3">以致人们绊倒在尸体上。<verse eid="NAM 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 3:4" />一切都因这淫妇众多的淫行，</para>
  <para style="q1" vid="NAM 3:4">这漂亮艳丽的女人行巫术，</para>
  <para style="q1" vid="NAM 3:4">以淫行迷惑<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">迷惑——马索拉文本作“出卖”。</char></note>列邦，</para>
  <para style="q1" vid="NAM 3:4">以巫术迷惑各族。<verse eid="NAM 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 3:5" />这是万军之耶和华的宣告：</para>
  <para style="q1" vid="NAM 3:5">看哪，我与你敌对！</para>
  <para style="q1" vid="NAM 3:5">我要掀开你的衣裙，蒙在你脸上，</para>
  <para style="q1" vid="NAM 3:5">让列邦观看你的裸体，</para>
  <para style="q1" vid="NAM 3:5">让各国观看你的羞辱。<verse eid="NAM 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 3:6" />我要把可憎之物扔到你身上，</para>
  <para style="q1" vid="NAM 3:6">辱没你，拿你来示众。<verse eid="NAM 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 3:7" />所有看见你的都会逃避你，说：</para>
  <para style="q1" vid="NAM 3:7">“<char style="pn">尼尼微</char>被摧毁了！</para>
  <para style="q1" vid="NAM 3:7">谁会为她悲哀，</para>
  <para style="q1" vid="NAM 3:7">从哪里找安慰你的人呢？”<verse eid="NAM 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="NAM 3:8" />难道你比<char style="pn">挪亚门</char><note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">挪亚门——希腊语音译为“底比斯”。</char></note>更优越吗？</para>
  <para style="q1" vid="NAM 3:8">她坐落在<char style="pn">尼罗</char>河边，</para>
  <para style="q1" vid="NAM 3:8">大水环绕她，</para>
  <para style="q1" vid="NAM 3:8">海<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">海——指尼罗河；参《以赛亚书》19:5-8。</char></note>是她的壁垒，</para>
  <para style="q1" vid="NAM 3:8">海水是她的城墙。<verse eid="NAM 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 3:9" />
    <char style="pn">库实</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">3:9 </char>
      <char style="ft" closed="false">库实——指埃塞俄比亚。</char>
    </note>和<char style="pn">埃及</char>是她的力量，</para>
  <para style="q1" vid="NAM 3:9">无穷无尽；</para>
  <para style="q1" vid="NAM 3:9">
    <char style="pn">普特</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">3:9 </char>
      <char style="ft" closed="false">普特——指利比亚。</char>
    </note>和<char style="pn">利比亚</char>是她的帮手。<verse eid="NAM 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 3:10" />但她还是成了俘虏，被掳去；</para>
  <para style="q1" vid="NAM 3:10">她的幼童在各街头被摔死，</para>
  <para style="q1" vid="NAM 3:10">她的权贵被抽签分配，</para>
  <para style="q1" vid="NAM 3:10">她的大臣全都被锁链捆住。<verse eid="NAM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 3:11" />你也将这样醉倒，神志不清<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">神志不清——或译作“四处躲藏”。</char></note>；</para>
  <para style="q1" vid="NAM 3:11">你也将寻找堡垒躲避仇敌。<verse eid="NAM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 3:12" />你所有的堡垒</para>
  <para style="q1" vid="NAM 3:12">都像无花果树上的初熟果实，</para>
  <para style="q1" vid="NAM 3:12">一被摇动，就掉进吞吃者口中。<verse eid="NAM 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="NAM 3:13" />看哪，</para>
  <para style="q1" vid="NAM 3:13">你当中的军兵如同女人，</para>
  <para style="q1" vid="NAM 3:13">你各地的城门向仇敌大大敞开，</para>
  <para style="q1" vid="NAM 3:13">火焰吞噬你的门闩。<verse eid="NAM 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 3:14" />你取水应对围困吧！</para>
  <para style="q1" vid="NAM 3:14">加固你的堡垒吧！</para>
  <para style="q1" vid="NAM 3:14">你要进到烂泥中，踹踏泥团，</para>
  <para style="q1" vid="NAM 3:14">并且修缮砖窑。<verse eid="NAM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 3:15" />在你那里，火焰将吞噬你，</para>
  <para style="q1" vid="NAM 3:15">刀剑将剪除你，</para>
  <para style="q1" vid="NAM 3:15">像蝗蝻那样吞灭你。</para>
  <para style="q1" vid="NAM 3:15">你像蝗蝻那样增多吧，</para>
  <para style="q1" vid="NAM 3:15">像蝗虫那样增多吧！<verse eid="NAM 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="NAM 3:16" />你增添客商，</para>
  <para style="q1" vid="NAM 3:16">多过天上的星辰。</para>
  <para style="q1" vid="NAM 3:16">但蝗蝻脱壳，就飞走。<verse eid="NAM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="NAM 3:17" />你的首领多如蝗虫，</para>
  <para style="q1" vid="NAM 3:17">你的军官好像成群的蚂蚱；</para>
  <para style="q1" vid="NAM 3:17">寒冷时它们停留在围栏上，</para>
  <para style="q1" vid="NAM 3:17">太阳一升起，它们就飞走了，</para>
  <para style="q1" vid="NAM 3:17">没有人知道它们在哪里。<verse eid="NAM 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="NAM 3:18" />
    <char style="pn">亚述</char>王啊，</para>
  <para style="q1" vid="NAM 3:18">你的牧人打盹，</para>
  <para style="q1" vid="NAM 3:18">你的贵族安眠，</para>
  <para style="q1" vid="NAM 3:18">你的子民散落在山上，</para>
  <para style="q1" vid="NAM 3:18">没有人招聚他们。<verse eid="NAM 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NAM 3:19" />你的创伤无法医治，</para>
  <para style="q1" vid="NAM 3:19">你的伤势严重。</para>
  <para style="q1" vid="NAM 3:19">凡是听到你消息的，</para>
  <para style="q1" vid="NAM 3:19">都必因你而鼓掌，</para>
  <para style="q1" vid="NAM 3:19">因为谁不时常遭受你的祸害呢？<verse eid="NAM 3:19" /></para>
  <chapter eid="NAM 3" />
</usx>