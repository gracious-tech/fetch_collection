<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HOS" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">何西阿书</para>
  <para style="mt">何西阿书</para>
  <chapter number="1" style="c" sid="HOS 1" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 1:1" />在<char style="pn">乌西雅</char>、<char style="pn">约坦</char>、<char style="pn">亚哈斯</char>、<char style="pn">希西加</char>作<char style="pn">犹大</char>王，<char style="pn">约阿施</char>的儿子<char style="pn">耶罗波安</char>作<char style="pn">以色列</char>王的日子，耶和华的话语临到了<char style="pn">贝尔里</char>的儿子<char style="pn">何西阿</char>。<verse eid="HOS 1:1" /></para>
  <para style="s">何西阿的婚姻与孩子</para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 1:2" />耶和华初次与<char style="pn">何西阿</char>说话。耶和华对<char style="pn">何西阿</char>说：</para>
  <para style="q1" vid="HOS 1:2">“你去，娶一个淫乱的女人，</para>
  <para style="q1" vid="HOS 1:2">得淫乱所生的孩子。</para>
  <para style="q1" vid="HOS 1:2">因为这地放纵行淫，</para>
  <para style="q1" vid="HOS 1:2">背弃了耶和华。”<verse eid="HOS 1:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="HOS 1:3" />他就去，娶了<char style="pn">迪布拉音</char>的女儿<char style="pn">格梅尔</char>。<char style="pn">格梅尔</char>怀孕，为他生了一个儿子。 <verse eid="HOS 1:3" /><verse number="4" style="v" sid="HOS 1:4" />耶和华对<char style="pn">何西阿</char>说：</para>
  <para style="q1" vid="HOS 1:4">“你要给他起名为<char style="pn">耶斯列</char>。</para>
  <para style="q1" vid="HOS 1:4">因为再过片刻，</para>
  <para style="q1" vid="HOS 1:4">我要向<char style="pn">耶户</char>家追讨<char style="pn">耶斯列</char>的血债，</para>
  <para style="q1" vid="HOS 1:4">并且使<char style="pn">以色列</char>家的王国终止。<verse eid="HOS 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 1:5" />到那日，我必在<char style="pn">耶斯列</char>平原</para>
  <para style="q1" vid="HOS 1:5">折断<char style="pn">以色列</char>的弓。”<verse eid="HOS 1:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="HOS 1:6" />后来<char style="pn">格梅尔</char>又怀孕，生了一个女儿。耶和华对<char style="pn">何西阿</char>说：</para>
  <para style="q1" vid="HOS 1:6">“你要给她起名为<char style="pn">罗茹哈玛</char><note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">罗茹哈玛——意思是“那不蒙怜悯的”；下同。</char></note>。</para>
  <para style="q1" vid="HOS 1:6">因为我绝不再怜悯<char style="pn">以色列</char>家，</para>
  <para style="q1" vid="HOS 1:6">我绝不饶恕他们。<verse eid="HOS 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 1:7" />我却要怜悯<char style="pn">犹大</char>家；</para>
  <para style="q1" vid="HOS 1:7">我要使他们靠他们的神耶和华得救，</para>
  <para style="q1" vid="HOS 1:7">而不是靠弓、刀、武力<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">武力——或译作“争战”。</char></note>、</para>
  <para style="q1" vid="HOS 1:7">马匹和马兵得救。”<verse eid="HOS 1:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="HOS 1:8" />
    <char style="pn">格梅尔</char>给<char style="pn">罗茹哈玛</char>断奶以后，又怀孕，生了一个儿子。 <verse eid="HOS 1:8" /><verse number="9" style="v" sid="HOS 1:9" />耶和华说：</para>
  <para style="q1" vid="HOS 1:9">“你要给他起名为<char style="pn">罗阿米</char><note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">罗阿米——意思是“不是我的子民”。</char></note>。</para>
  <para style="q1" vid="HOS 1:9">因为你们不是我的子民，</para>
  <para style="q1" vid="HOS 1:9">我也不是你们的神<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">神——原文直译“我是”。</char></note>！”<verse eid="HOS 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="HOS 1:10" />然而，<char style="pn">以色列</char>子孙的数目</para>
  <para style="q1" vid="HOS 1:10">将多如海沙，</para>
  <para style="q1" vid="HOS 1:10">无法测量，无法数清。</para>
  <para style="q1" vid="HOS 1:10">从前在什么地方对他们</para>
  <para style="q1" vid="HOS 1:10">说“你们不是我的子民”，</para>
  <para style="q1" vid="HOS 1:10">就在那里，他们将被</para>
  <para style="q1" vid="HOS 1:10">称为“永生神的儿女”。<verse eid="HOS 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 1:11" />
    <char style="pn">犹大</char>子孙和<char style="pn">以色列</char>子孙</para>
  <para style="q1" vid="HOS 1:11">将聚集在一起，</para>
  <para style="q1" vid="HOS 1:11">为自己立一位首领，</para>
  <para style="q1" vid="HOS 1:11">从这地上去。</para>
  <para style="q1" vid="HOS 1:11">
    <char style="pn">耶斯列</char>的日子实在是大日子！<verse eid="HOS 1:11" /></para>
  <chapter eid="HOS 1" />
  <chapter number="2" style="c" sid="HOS 2" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 2:1" />
    <note caller="+" style="f">
      <char style="fr" closed="false">2:1 </char>
      <char style="ft" closed="false">此章在马索拉文本为2:3至2:25。</char>
    </note>那时，你们要</para>
  <para style="q1" vid="HOS 2:1">称你们的兄弟为“我的子民<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">我的子民——音译作“阿米”。</char></note>”，</para>
  <para style="q1" vid="HOS 2:1">称你们的姐妹为“蒙怜悯的<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">蒙怜悯的——音译作“茹哈玛”。</char></note>”。<verse eid="HOS 2:1" /></para>
  <para style="b" />
  <para style="s">责罚以色列的淫行</para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 2:2" />你们要谴责你们的母亲，要谴责她；</para>
  <para style="q1" vid="HOS 2:2">她已经不是我的妻子，</para>
  <para style="q1" vid="HOS 2:2">我也不是她的丈夫！</para>
  <para style="q1" vid="HOS 2:2">要让她除掉脸上的淫相，</para>
  <para style="q1" vid="HOS 2:2">除掉双乳间的淫荡，<verse eid="HOS 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 2:3" />免得我把她剥光，</para>
  <para style="q1" vid="HOS 2:3">使她赤裸如刚出生时那样。</para>
  <para style="q1" vid="HOS 2:3">我要使她如同荒漠，</para>
  <para style="q1" vid="HOS 2:3">如同干旱之地，</para>
  <para style="q1" vid="HOS 2:3">我要使她因干渴而死。<verse eid="HOS 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 2:4" />她的儿女，我也不会怜悯，</para>
  <para style="q1" vid="HOS 2:4">因为他们是淫乱所生的儿女。<verse eid="HOS 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 2:5" />他们的母亲实在淫乱，</para>
  <para style="q1" vid="HOS 2:5">那孕育他们的行了羞耻的事。</para>
  <para style="q1" vid="HOS 2:5">她竟然说：“我要随从我的情人，</para>
  <para style="q1" vid="HOS 2:5">是他们给了我饼和水、</para>
  <para style="q1" vid="HOS 2:5">羊毛和细麻、油和酒。”<verse eid="HOS 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 2:6" />所以看哪，</para>
  <para style="q1" vid="HOS 2:6">我要用荆棘堵住她的道路；</para>
  <para style="q1" vid="HOS 2:6">我要筑墙拦住她，</para>
  <para style="q1" vid="HOS 2:6">使她找不到路径。<verse eid="HOS 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 2:7" />她追赶她的情人却追不上，</para>
  <para style="q1" vid="HOS 2:7">寻找他们却找不到，</para>
  <para style="q1" vid="HOS 2:7">就会说：</para>
  <para style="q1" vid="HOS 2:7">“我还是回到我第一个丈夫那里去吧，</para>
  <para style="q1" vid="HOS 2:7">我那时比现在好！”<verse eid="HOS 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 2:8" />她不知道，</para>
  <para style="q1" vid="HOS 2:8">是我赐给了她五谷、新酒和新油，</para>
  <para style="q1" vid="HOS 2:8">也给她增添了金银——</para>
  <para style="q1" vid="HOS 2:8">他们竟把这些<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false">把这些——辅助词语。</char></note>献给<char style="pn">巴力</char>！<verse eid="HOS 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 2:9" />因此我要在收割时收回我的五谷，</para>
  <para style="q1" vid="HOS 2:9">在酿酒的季节收回我的新酒，</para>
  <para style="q1" vid="HOS 2:9">我要收走我给她遮体用的羊毛和细麻。<verse eid="HOS 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 2:10" />现在我要在她情人们眼前</para>
  <para style="q1" vid="HOS 2:10">暴露她的丑态，</para>
  <para style="q1" vid="HOS 2:10">无人能从我手中解救她。<verse eid="HOS 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 2:11" />我要终止她所有的欢庆，</para>
  <para style="q1" vid="HOS 2:11">终止她的节期、新月节、安息日</para>
  <para style="q1" vid="HOS 2:11">以及她所有的约期。<verse eid="HOS 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 2:12" />我必摧毁她的葡萄树和无花果树，</para>
  <para style="q1" vid="HOS 2:12">因为她说：</para>
  <para style="q1" vid="HOS 2:12">“这些是我的情人们送给我的赏赐。”</para>
  <para style="q1" vid="HOS 2:12">我要使这些果树成为荒林，</para>
  <para style="q1" vid="HOS 2:12">被田野的走兽吞吃。<verse eid="HOS 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 2:13" />我必惩罚她，</para>
  <para style="q1" vid="HOS 2:13">因为她在<char style="pn">巴力</char>的节日向它们烧香；</para>
  <para style="q1" vid="HOS 2:13">那时她佩戴耳环和饰品，</para>
  <para style="q1" vid="HOS 2:13">随从她的情人们，</para>
  <para style="q1" vid="HOS 2:13">反而把我忘记。</para>
  <para style="q1" vid="HOS 2:13">这是耶和华的宣告。<verse eid="HOS 2:13" /></para>
  <para style="b" />
  <para style="s">淫乱的以色列得赦免</para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 2:14" />所以看哪，我要说服她，</para>
  <para style="q1" vid="HOS 2:14">把她带到旷野去，</para>
  <para style="q1" vid="HOS 2:14">对她说宽心的话。<verse eid="HOS 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 2:15" />我要在那里把她的葡萄园给她，</para>
  <para style="q1" vid="HOS 2:15">使<char style="pn">亚割</char>谷成为她的希望之门。</para>
  <para style="q1" vid="HOS 2:15">她必在那里回应我，</para>
  <para style="q1" vid="HOS 2:15">像她年幼时的日子，</para>
  <para style="q1" vid="HOS 2:15">像从<char style="pn">埃及</char>地上来的日子那样。<verse eid="HOS 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 2:16" />这是耶和华的宣告：</para>
  <para style="q1" vid="HOS 2:16">到那日，</para>
  <para style="q1" vid="HOS 2:16">你必称呼我<char style="pn">伊施</char><note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">伊施——或译作“我的丈夫”。</char></note>，</para>
  <para style="q1" vid="HOS 2:16">不再称呼我<char style="pn">巴力</char><note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">巴力——或译作“我的主”。</char></note>。<verse eid="HOS 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 2:17" />我要从她口中除掉<char style="pn">巴力</char>的名号，</para>
  <para style="q1" vid="HOS 2:17">这些名号绝不再被提起。<verse eid="HOS 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 2:18" />到那日，我必为我的民，</para>
  <para style="q1" vid="HOS 2:18">与田野的走兽、天空的飞鸟、</para>
  <para style="q1" vid="HOS 2:18">地上的爬虫立约；</para>
  <para style="q1" vid="HOS 2:18">我也要从地上折断弓刀，</para>
  <para style="q1" vid="HOS 2:18">止息战争，</para>
  <para style="q1" vid="HOS 2:18">使他们安然躺卧。<verse eid="HOS 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 2:19" />我要聘娶你归我，直到永远；</para>
  <para style="q1" vid="HOS 2:19">我要以公义、公正、恩慈和怜悯，</para>
  <para style="q1" vid="HOS 2:19">聘娶你归我；<verse eid="HOS 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="HOS 2:20" />我要以信实聘娶你归我。</para>
  <para style="q1" vid="HOS 2:20">那时，你必认识耶和华。<verse eid="HOS 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="HOS 2:21" />这是耶和华的宣告：</para>
  <para style="q1" vid="HOS 2:21">到那日，我必应允，</para>
  <para style="q1" vid="HOS 2:21">我应允天，天应允地，<verse eid="HOS 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="HOS 2:22" />地应允五谷、新酒和新油，</para>
  <para style="q1" vid="HOS 2:22">它们应允<char style="pn">耶斯列</char>。<verse eid="HOS 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="HOS 2:23" />我要为自己把她栽种在这地；</para>
  <para style="q1" vid="HOS 2:23">我要怜悯<char style="pn">罗茹哈玛</char><note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">罗茹哈玛——或译作“那不蒙怜悯的”。</char></note>，</para>
  <para style="q1" vid="HOS 2:23">对<char style="pn">罗阿米</char><note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">罗阿米——或译作“那不是我子民的”。</char></note>说：“你是我的子民”，</para>
  <para style="q1" vid="HOS 2:23">他也将说：“你是我的神。”<verse eid="HOS 2:23" /></para>
  <chapter eid="HOS 2" />
  <chapter number="3" style="c" sid="HOS 3" />
  <para style="s">等待以色列回转</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 3:1" />耶和华对我说：“你再去爱那个另有新欢的女人，那个淫妇；正如耶和华爱<char style="pn">以色列</char>子民，虽然他们转向了别的神，贪爱葡萄饼。”<verse eid="HOS 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 3:2" />于是，我用十五块银子、一贺梅珥<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">一贺梅珥——相当于220公升。</char></note>半<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">半——原文作“勒特克”；1勒特克=110公升。</char></note>的大麦，把她买回来归我。 <verse eid="HOS 3:2" /><verse number="3" style="v" sid="HOS 3:3" />我对她说：“你要为我独居多日；不可淫乱，不可归属别的男人，我也不会亲近你<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">我也不会亲近你——或译作“我也会同样对你忠诚”。</char></note>。”<verse eid="HOS 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 3:4" />
    <char style="pn">以色列</char>子民必独居多日，没有君王，没有首领，没有献祭，没有神柱，没有以弗得和家族神像。 <verse eid="HOS 3:4" /><verse number="5" style="v" sid="HOS 3:5" />之后，<char style="pn">以色列</char>子民将回转，寻求耶和华他们的神，寻求<char style="pn">大卫</char>他们的王。在末后的日子，他们将以敬畏的心寻求耶和华和他的美福。<verse eid="HOS 3:5" /></para>
  <chapter eid="HOS 3" />
  <chapter number="4" style="c" sid="HOS 4" />
  <para style="s">耶和华指控以色列</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 4:1" />
    <char style="pn">以色列</char>子孙哪，</para>
  <para style="q1" vid="HOS 4:1">你们当听耶和华的话语！</para>
  <para style="q1" vid="HOS 4:1">耶和华与这地的居民有争讼，</para>
  <para style="q1" vid="HOS 4:1">因为这地上没有真理，</para>
  <para style="q1" vid="HOS 4:1">没有忠诚<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">忠诚——或译作“信实的爱”。</char></note>，没有人认识神，<verse eid="HOS 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 4:2" />只有诅咒、欺骗、</para>
  <para style="q1" vid="HOS 4:2">杀人、偷窃、通奸，</para>
  <para style="q1" vid="HOS 4:2">他们任意妄为，</para>
  <para style="q1" vid="HOS 4:2">杀人流血的事接连不断。<verse eid="HOS 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 4:3" />因此这地荒芜，</para>
  <para style="q1" vid="HOS 4:3">其上所有的居民、</para>
  <para style="q1" vid="HOS 4:3">田野的走兽、天空的飞鸟都衰微，</para>
  <para style="q1" vid="HOS 4:3">海里的鱼也绝迹。<verse eid="HOS 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 4:4" />然而谁也不要指控，</para>
  <para style="q1" vid="HOS 4:4">谁也不要指责。</para>
  <para style="q1" vid="HOS 4:4">祭司啊，我是与你争讼<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">祭司啊，我是与你争讼——或译作“我的子民像是指控祭司的”。</char></note>！<verse eid="HOS 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 4:5" />白天你将绊倒，</para>
  <para style="q1" vid="HOS 4:5">夜间先知也与你一同绊倒。</para>
  <para style="q1" vid="HOS 4:5">我要使你的母亲灭亡，<verse eid="HOS 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 4:6" />我的子民必因没有知识而灭亡。</para>
  <para style="q1" vid="HOS 4:6">你既然厌弃知识，</para>
  <para style="q1" vid="HOS 4:6">我也要厌弃你作我的祭司；</para>
  <para style="q1" vid="HOS 4:6">你忘记你神的训诲，</para>
  <para style="q1" vid="HOS 4:6">我也要忘记你的儿女。<verse eid="HOS 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="HOS 4:7" />祭司越增多，</para>
  <para style="q1" vid="HOS 4:7">他们就越对我犯罪，</para>
  <para style="q1" vid="HOS 4:7">我要使他们的荣耀变为羞辱。<verse eid="HOS 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 4:8" />他们享用我子民的赎罪祭，</para>
  <para style="q1" vid="HOS 4:8">心里盼望我的子民犯罪。<verse eid="HOS 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 4:9" />所以子民怎样，</para>
  <para style="q1" vid="HOS 4:9">祭司也将怎样，</para>
  <para style="q1" vid="HOS 4:9">我必照着他们各人的行径惩罚他们，</para>
  <para style="q1" vid="HOS 4:9">照他们的行为报应他们。<verse eid="HOS 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 4:10" />他们吃却吃不饱，</para>
  <para style="q1" vid="HOS 4:10">行淫而不能繁衍。</para>
  <para style="q1" vid="HOS 4:10">因为他们离弃耶和华，</para>
  <para style="q1" vid="HOS 4:10">执意 <verse eid="HOS 4:10" /><verse number="11" style="v" sid="HOS 4:11" />行淫，</para>
  <para style="q1" vid="HOS 4:11">陈酒和新酒夺去了他们的心。<verse eid="HOS 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="HOS 4:12" />我的子民求问木头，</para>
  <para style="q1" vid="HOS 4:12">让那些木杖指示他们。</para>
  <para style="q1" vid="HOS 4:12">因为淫乱的灵使他们迷失，</para>
  <para style="q1" vid="HOS 4:12">他们行淫背叛他们的神。<verse eid="HOS 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 4:13" />他们在各山顶、各丘陵上，</para>
  <para style="q1" vid="HOS 4:13">在橡树、杨树和黄连树底下</para>
  <para style="q1" vid="HOS 4:13">献祭烧香，</para>
  <para style="q1" vid="HOS 4:13">因为树荫美好。</para>
  <para style="q1" vid="HOS 4:13">因此你们的女儿行淫，</para>
  <para style="q1" vid="HOS 4:13">新娶的儿媳<note caller="+" style="f"><char style="fr" closed="false">4:13 </char><char style="ft" closed="false">新娶的儿媳——或译作“你们的新娘”。</char></note>通奸。<verse eid="HOS 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 4:14" />但我不惩罚你们的女儿，</para>
  <para style="q1" vid="HOS 4:14">即使她们行淫；</para>
  <para style="q1" vid="HOS 4:14">我也不惩罚你们的儿媳，</para>
  <para style="q1" vid="HOS 4:14">即使她们通奸；</para>
  <para style="q1" vid="HOS 4:14">因为是你们转离与妓女同居，</para>
  <para style="q1" vid="HOS 4:14">与庙妓一同献祭。</para>
  <para style="q1" vid="HOS 4:14">无知的子民，必将灭亡！<verse eid="HOS 4:14" /></para>
  <para style="b" />
  <para style="s">警诫以色列和犹大</para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 4:15" />
    <char style="pn">以色列</char>啊，你虽然行淫，</para>
  <para style="q1" vid="HOS 4:15">但不要让<char style="pn">犹大</char>陷入罪恶。</para>
  <para style="q1" vid="HOS 4:15">你们不要去<char style="pn">吉甲</char>，</para>
  <para style="q1" vid="HOS 4:15">不要上<char style="pn">伯亚文</char>，</para>
  <para style="q1" vid="HOS 4:15">也不要说</para>
  <para style="q1" vid="HOS 4:15">“我指着耶和华的永生起誓”。<verse eid="HOS 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 4:16" />
    <char style="pn">以色列</char>顽梗，</para>
  <para style="q1" vid="HOS 4:16">实在像顽梗的母牛！</para>
  <para style="q1" vid="HOS 4:16">耶和华怎能牧放他们，</para>
  <para style="q1" vid="HOS 4:16">像在宽阔之地牧放羊羔那样？<verse eid="HOS 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 4:17" />
    <char style="pn">以法莲</char>与偶像联合，</para>
  <para style="q1" vid="HOS 4:17">任凭他吧！<verse eid="HOS 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 4:18" />他们纵情饮酒，放纵行淫；</para>
  <para style="q1" vid="HOS 4:18">他们的官长深爱羞耻的事。<verse eid="HOS 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 4:19" />风把<char style="pn">以色列</char><note caller="+" style="f"><char style="fr" closed="false">4:19 </char><char style="ft" closed="false">以色列——原文直译“她”。</char></note>裹在翅膀里，</para>
  <para style="q1" vid="HOS 4:19">人们必因自己的祭物蒙羞！<verse eid="HOS 4:19" /></para>
  <chapter eid="HOS 4" />
  <chapter number="5" style="c" sid="HOS 5" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 5:1" />祭司啊，要听这些话！</para>
  <para style="q1" vid="HOS 5:1">
    <char style="pn">以色列</char>家啊，要留心听！</para>
  <para style="q1" vid="HOS 5:1">王室啊，要倾听！</para>
  <para style="q1" vid="HOS 5:1">因为这审判是针对你们的，</para>
  <para style="q1" vid="HOS 5:1">你们成了<char style="pn">米斯巴</char>的网罗，</para>
  <para style="q1" vid="HOS 5:1">成了<char style="pn">他泊</char>山上张开的网。<verse eid="HOS 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 5:2" />这些人在<char style="pn">什亭</char>挖掘深坑<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">这些人在什亭挖掘深坑——或译作“这些背道的人大行杀戮”。</char></note>，</para>
  <para style="q1" vid="HOS 5:2">所以我必惩治他们所有的人。<verse eid="HOS 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 5:3" />我认识<char style="pn">以法莲</char>，</para>
  <para style="q1" vid="HOS 5:3">
    <char style="pn">以色列</char>无法向我隐藏。</para>
  <para style="q1" vid="HOS 5:3">
    <char style="pn">以法莲</char>哪，你竟然行淫，</para>
  <para style="q1" vid="HOS 5:3">
    <char style="pn">以色列</char>玷污了自己！<verse eid="HOS 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 5:4" />他们的恶行使他们不能回转</para>
  <para style="q1" vid="HOS 5:4">归向他们的神，</para>
  <para style="q1" vid="HOS 5:4">因为淫乱的灵在他们当中；</para>
  <para style="q1" vid="HOS 5:4">他们不认识耶和华。<verse eid="HOS 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 5:5" />
    <char style="pn">以色列</char>脸上的傲慢指证他自己，</para>
  <para style="q1" vid="HOS 5:5">
    <char style="pn">以色列</char>和<char style="pn">以法莲</char>必因自己的罪孽绊倒，</para>
  <para style="q1" vid="HOS 5:5">
    <char style="pn">犹大</char>也必与他们一起绊倒。<verse eid="HOS 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 5:6" />他们将带着牛羊去寻求耶和华，</para>
  <para style="q1" vid="HOS 5:6">却找不到，</para>
  <para style="q1" vid="HOS 5:6">他已经离弃了他们。<verse eid="HOS 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 5:7" />他们背弃耶和华，</para>
  <para style="q1" vid="HOS 5:7">他们生的是私生子<note caller="+" style="f"><char style="fr" closed="false">5:7 </char><char style="ft" closed="false">私生子——或译作“外族儿女”。</char></note>，</para>
  <para style="q1" vid="HOS 5:7">所以新月节<note caller="+" style="f"><char style="fr" closed="false">5:7 </char><char style="ft" closed="false">新月节——或译作“毁灭者”。</char></note>必吞噬他们和他们的地业。<verse eid="HOS 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HOS 5:8" />你们要在<char style="pn">基比亚</char>吹响号角，</para>
  <para style="q1" vid="HOS 5:8">在<char style="pn">拉玛</char>吹响号筒，</para>
  <para style="q1" vid="HOS 5:8">要在<char style="pn">伯亚文</char>呼喊：</para>
  <para style="q1" vid="HOS 5:8">“<char style="pn">便雅悯</char>哪，小心背后！”<verse eid="HOS 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 5:9" />在责罚的日子里，<char style="pn">以法莲</char>必成为荒场，</para>
  <para style="q1" vid="HOS 5:9">我已在<char style="pn">以色列</char>各支派指示确定的事。<verse eid="HOS 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 5:10" />
    <char style="pn">犹大</char>的首领们就像挪移地界的人，</para>
  <para style="q1" vid="HOS 5:10">我必像泼水那样向他们倾泻我的盛怒。<verse eid="HOS 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 5:11" />
    <char style="pn">以法莲</char>受欺压，被审判压碎，</para>
  <para style="q1" vid="HOS 5:11">是因为他情愿追随虚无<note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="ft" closed="false">虚无——或译作“人的命令”。</char></note>。<verse eid="HOS 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 5:12" />所以我亲自行动，</para>
  <para style="q1" vid="HOS 5:12">如蛀虫对付<char style="pn">以法莲</char>，</para>
  <para style="q1" vid="HOS 5:12">如朽烂对付<char style="pn">犹大</char>家。<verse eid="HOS 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 5:13" />
    <char style="pn">以法莲</char>看见自己的病患，</para>
  <para style="q1" vid="HOS 5:13">
    <char style="pn">犹大</char>看见自己的创伤，</para>
  <para style="q1" vid="HOS 5:13">
    <char style="pn">以法莲</char>就前往<char style="pn">亚述</char>，</para>
  <para style="q1" vid="HOS 5:13">派人去见那大君王。</para>
  <para style="q1" vid="HOS 5:13">可是他不能医治你们，</para>
  <para style="q1" vid="HOS 5:13">不能治愈你们的创伤。<verse eid="HOS 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 5:14" />我必如猛狮对付<char style="pn">以法莲</char>，</para>
  <para style="q1" vid="HOS 5:14">如少壮狮子对付<char style="pn">犹大</char>家。</para>
  <para style="q1" vid="HOS 5:14">我，是我，要撕掠而去；</para>
  <para style="q1" vid="HOS 5:14">我拖走他们，无人解救。<verse eid="HOS 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 5:15" />我要回我的地方去，</para>
  <para style="q1" vid="HOS 5:15">直到他们承担罪责，</para>
  <para style="q1" vid="HOS 5:15">然后寻求我的面，</para>
  <para style="q1" vid="HOS 5:15">在危难中切切寻求我。<verse eid="HOS 5:15" /></para>
  <chapter eid="HOS 5" />
  <chapter number="6" style="c" sid="HOS 6" />
  <para style="s">呼吁子民回转</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 6:1" />来吧，让我们回转归向耶和华！</para>
  <para style="q1" vid="HOS 6:1">因为他撕裂我们，</para>
  <para style="q1" vid="HOS 6:1">也必医治我们；</para>
  <para style="q1" vid="HOS 6:1">他打伤我们，</para>
  <para style="q1" vid="HOS 6:1">也必包扎我们。<verse eid="HOS 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 6:2" />两天后他会使我们复苏，</para>
  <para style="q1" vid="HOS 6:2">第三天他会使我们起来，</para>
  <para style="q1" vid="HOS 6:2">我们就活在他的面前。<verse eid="HOS 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 6:3" />我们要认识耶和华，竭力认识他。</para>
  <para style="q1" vid="HOS 6:3">他必如曙光出现；</para>
  <para style="q1" vid="HOS 6:3">他临到我们像甘霖，</para>
  <para style="q1" vid="HOS 6:3">像滋润大地的春雨。<verse eid="HOS 6:3" /></para>
  <para style="b" />
  <para style="s">第一首哀歌</para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 6:4" />
    <char style="pn">以法莲</char>哪，我要怎么处置你呢？</para>
  <para style="q1" vid="HOS 6:4">
    <char style="pn">犹大</char>啊，我要怎么处置你呢？</para>
  <para style="q1" vid="HOS 6:4">你们的忠诚<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="ft" closed="false">忠诚——或译作“信实之爱”；下同。</char></note>消逝，</para>
  <para style="q1" vid="HOS 6:4">如同清晨的云雾，</para>
  <para style="q1" vid="HOS 6:4">又如早上的露水。<verse eid="HOS 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 6:5" />因此我藉着众先知砍碎他们，</para>
  <para style="q1" vid="HOS 6:5">用我口中的言语杀死他们，</para>
  <para style="q1" vid="HOS 6:5">我的审判像光辉那样发出。<verse eid="HOS 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 6:6" />因为我喜悦忠诚，而不是祭物；</para>
  <para style="q1" vid="HOS 6:6">喜悦人认识神，而不是献燔祭。<verse eid="HOS 6:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="HOS 6:7" />他们却如<char style="pn">亚当</char><note caller="+" style="f"><char style="fr" closed="false">6:7 </char><char style="ft" closed="false">如亚当——或译作“在亚当”；参《约书亚书》3:16。</char></note>违背了约，</para>
  <para style="q1" vid="HOS 6:7">他们在那里背弃我：<verse eid="HOS 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 6:8" />
    <char style="pn">基列</char>是作恶之徒的城，</para>
  <para style="q1" vid="HOS 6:8">足迹沾满了血。<verse eid="HOS 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 6:9" />祭司像埋伏等候的匪徒，</para>
  <para style="q1" vid="HOS 6:9">结伙在<char style="pn">示剑</char>的路上杀人；</para>
  <para style="q1" vid="HOS 6:9">他们实在行了丑恶的事。<verse eid="HOS 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 6:10" />我在<char style="pn">以色列</char>家看见了可怕的事，</para>
  <para style="q1" vid="HOS 6:10">那里有<char style="pn">以法莲</char>的淫行，</para>
  <para style="q1" vid="HOS 6:10">
    <char style="pn">以色列</char>玷污了自己。<verse eid="HOS 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 6:11" />
    <char style="pn">犹大</char>啊，</para>
  <para style="q1" vid="HOS 6:11">我使流亡的子民回归<note caller="+" style="f"><char style="fr" closed="false">6:11 </char><char style="ft" closed="false">使流亡的子民回归——或译作“复兴我子民的继业”。</char></note>时，</para>
  <para style="q1" vid="HOS 6:11">你也有命定的收成<note caller="+" style="f"><char style="fr" closed="false">6:11 </char><char style="ft" closed="false">收成——或译作“审判”。</char></note>。<verse eid="HOS 6:11" /></para>
  <chapter eid="HOS 6" />
  <chapter number="7" style="c" sid="HOS 7" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 7:1" />当我想要医治<char style="pn">以色列</char>时，</para>
  <para style="q1" vid="HOS 7:1">
    <char style="pn">以法莲</char>的罪孽和<char style="pn">撒玛利亚</char>的罪恶</para>
  <para style="q1" vid="HOS 7:1">就会暴露出来。</para>
  <para style="q1" vid="HOS 7:1">是的，他们行事诡诈，</para>
  <para style="q1" vid="HOS 7:1">内有窃贼进入，</para>
  <para style="q1" vid="HOS 7:1">外有匪徒抢掠。<verse eid="HOS 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 7:2" />他们心里不考虑</para>
  <para style="q1" vid="HOS 7:2">我会记住他们的一切恶行。</para>
  <para style="q1" vid="HOS 7:2">现在他们的行为围绕着他们，</para>
  <para style="q1" vid="HOS 7:2">都在我的面前。<verse eid="HOS 7:2" /></para>
  <para style="b" />
  <para style="s">以色列的败坏</para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 7:3" />他们以恶行取悦君王，</para>
  <para style="q1" vid="HOS 7:3">以谎言取悦首领们。<verse eid="HOS 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 7:4" />他们都是通奸的人，</para>
  <para style="q1" vid="HOS 7:4">像烧热的火炉，</para>
  <para style="q1" vid="HOS 7:4">烤饼人从揉面到发酵的时候，</para>
  <para style="q1" vid="HOS 7:4">都不用扇火。<verse eid="HOS 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 7:5" />在我们君王喜庆<note caller="+" style="f"><char style="fr" closed="false">7:5 </char><char style="ft" closed="false">喜庆——辅助词语。</char></note>的日子，</para>
  <para style="q1" vid="HOS 7:5">首领们因酒烈而大醉，</para>
  <para style="q1" vid="HOS 7:5">王与亵慢人联起手来。<verse eid="HOS 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 7:6" />是的，他们心如火炉</para>
  <para style="q1" vid="HOS 7:6">从埋伏之处冲上来；</para>
  <para style="q1" vid="HOS 7:6">他们心中所烤的整夜沉寂，</para>
  <para style="q1" vid="HOS 7:6">一到清晨就像烈焰燃起。<verse eid="HOS 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 7:7" />他们全都灼热如同火炉，</para>
  <para style="q1" vid="HOS 7:7">吞噬他们的首领；</para>
  <para style="q1" vid="HOS 7:7">他们的君王都倒下了。</para>
  <para style="q1" vid="HOS 7:7">他们中间没有人呼求我！<verse eid="HOS 7:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HOS 7:8" />
    <char style="pn">以法莲</char>与各民族混杂，</para>
  <para style="q1" vid="HOS 7:8">
    <char style="pn">以法莲</char>是没有翻过的饼。<verse eid="HOS 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 7:9" />外族人吞噬了他的力量，</para>
  <para style="q1" vid="HOS 7:9">他却不知道；</para>
  <para style="q1" vid="HOS 7:9">他已经满头白发，</para>
  <para style="q1" vid="HOS 7:9">他也不知道！<verse eid="HOS 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 7:10" />
    <char style="pn">以色列</char>脸上的傲慢指证他自己。</para>
  <para style="q1" vid="HOS 7:10">在这一切事上，</para>
  <para style="q1" vid="HOS 7:10">他们并不回转归向耶和华他们的神，</para>
  <para style="q1" vid="HOS 7:10">也不寻求他。<verse eid="HOS 7:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 7:11" />
    <char style="pn">以法莲</char>就像愚笨、没有心智的鸽子，</para>
  <para style="q1" vid="HOS 7:11">他们呼求<char style="pn">埃及</char>，投奔<char style="pn">亚述</char>。<verse eid="HOS 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 7:12" />当他们去的时候，</para>
  <para style="q1" vid="HOS 7:12">我必向他们张开我的网罗。</para>
  <para style="q1" vid="HOS 7:12">我要把他们像天空的飞鸟打下来，</para>
  <para style="q1" vid="HOS 7:12">照着他们同党的传闻管教他们。<verse eid="HOS 7:12" /></para>
  <para style="b" />
  <para style="s">第二首哀歌</para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 7:13" />他们有祸了，因为他们远离我！</para>
  <para style="q1" vid="HOS 7:13">毁灭临到他们了，因为他们悖逆我！</para>
  <para style="q1" vid="HOS 7:13">我要救赎他们，他们却向我说谎。<verse eid="HOS 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 7:14" />他们不是真心向我哀求，</para>
  <para style="q1" vid="HOS 7:14">只是在床上号叫；</para>
  <para style="q1" vid="HOS 7:14">他们为求五谷和新酒，砍伤自己<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="ft" closed="false">砍伤自己——依据七十士译本；或译作“聚集起来”。</char></note>。</para>
  <para style="q1" vid="HOS 7:14">他们离弃我！<verse eid="HOS 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 7:15" />我管教他们，扶持他们的膀臂，</para>
  <para style="q1" vid="HOS 7:15">他们却谋划恶事敌对我。<verse eid="HOS 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 7:16" />他们转向，却不转向至高者；</para>
  <para style="q1" vid="HOS 7:16">他们就像翻背的弓。</para>
  <para style="q1" vid="HOS 7:16">他们的首领必因舌头的狂傲<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false">舌头的狂傲——或译作“惹怒我的话语”。</char></note>倒在刀下，</para>
  <para style="q1" vid="HOS 7:16">以致在<char style="pn">埃及</char>地成为笑柄。<verse eid="HOS 7:16" /></para>
  <chapter eid="HOS 7" />
  <chapter number="8" style="c" sid="HOS 8" />
  <para style="s">以色列的幻想破灭</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 8:1" />你用口吹响号角吧！</para>
  <para style="q1" vid="HOS 8:1">敌人<note caller="+" style="f"><char style="fr" closed="false">8:1 </char><char style="ft" closed="false">敌人——辅助词语。</char></note>必如鹰扑向耶和华的殿，</para>
  <para style="q1" vid="HOS 8:1">因为这民违背我的约，</para>
  <para style="q1" vid="HOS 8:1">背离我的训诲。<verse eid="HOS 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 8:2" />他们将向我呼救：</para>
  <para style="q1" vid="HOS 8:2">“我的神哪，</para>
  <para style="q1" vid="HOS 8:2">我们<char style="pn">以色列</char>认识你了！”<verse eid="HOS 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 8:3" />
    <char style="pn">以色列</char>抛弃了美善，</para>
  <para style="q1" vid="HOS 8:3">仇敌必追赶他。<verse eid="HOS 8:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HOS 8:4" />他们立王，</para>
  <para style="q1" vid="HOS 8:4">不经过我；</para>
  <para style="q1" vid="HOS 8:4">他们立首领，</para>
  <para style="q1" vid="HOS 8:4">我并没有承认。</para>
  <para style="q1" vid="HOS 8:4">他们用金银为自己制造偶像，</para>
  <para style="q1" vid="HOS 8:4">以致他们被剪除。<verse eid="HOS 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 8:5" />
    <char style="pn">撒玛利亚</char>啊，</para>
  <para style="q1" vid="HOS 8:5">你的金牛犊被丢弃了！</para>
  <para style="q1" vid="HOS 8:5">我的怒气向他们发作，</para>
  <para style="q1" vid="HOS 8:5">他们什么时候才能清白无罪呢？<verse eid="HOS 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 8:6" />这金牛犊竟然出自<char style="pn">以色列</char>！</para>
  <para style="q1" vid="HOS 8:6">它是工匠所造的，它并不是神。</para>
  <para style="q1" vid="HOS 8:6">
    <char style="pn">撒玛利亚</char>的金牛犊必成为碎末！<verse eid="HOS 8:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="HOS 8:7" />其实，他们播种的是风，</para>
  <para style="q1" vid="HOS 8:7">收割的是旋风。</para>
  <para style="q1" vid="HOS 8:7">庄稼不结穗子，</para>
  <para style="q1" vid="HOS 8:7">无法出产面粉；</para>
  <para style="q1" vid="HOS 8:7">即使出产了，</para>
  <para style="q1" vid="HOS 8:7">也会被外族人吞吃。<verse eid="HOS 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 8:8" />
    <char style="pn">以色列</char>被吞吃了，</para>
  <para style="q1" vid="HOS 8:8">如今他们在列国中</para>
  <para style="q1" vid="HOS 8:8">就像没人想要的器皿。<verse eid="HOS 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 8:9" />他们竟然投奔<char style="pn">亚述</char>，</para>
  <para style="q1" vid="HOS 8:9">如同独行的野驴；</para>
  <para style="q1" vid="HOS 8:9">
    <char style="pn">以法莲</char>贿买情人。<verse eid="HOS 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 8:10" />尽管他们在列国中贿买情人，</para>
  <para style="q1" vid="HOS 8:10">现在我必聚拢他们施行审判<note caller="+" style="f"><char style="fr" closed="false">8:10 </char><char style="ft" closed="false">施行审判——辅助词语。</char></note>，</para>
  <para style="q1" vid="HOS 8:10">他们很快就要因君王和首领</para>
  <para style="q1" vid="HOS 8:10">所加的重担而痛苦不堪。<verse eid="HOS 8:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 8:11" />
    <char style="pn">以法莲</char>虽然增多赎罪的祭坛，</para>
  <para style="q1" vid="HOS 8:11">却成了使他犯罪的祭坛！<verse eid="HOS 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 8:12" />我为他写下千万条<note caller="+" style="f"><char style="fr" closed="false">8:12 </char><char style="ft" closed="false">千万条——或译作“许多”。</char></note>训诲，</para>
  <para style="q1" vid="HOS 8:12">都被看作与他无关的。<verse eid="HOS 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 8:13" />至于献给我的祭物，</para>
  <para style="q1" vid="HOS 8:13">他们献上祭肉，也吃了，</para>
  <para style="q1" vid="HOS 8:13">耶和华却不悦纳他们。</para>
  <para style="q1" vid="HOS 8:13">现在他要记起他们的罪孽，</para>
  <para style="q1" vid="HOS 8:13">惩罚他们的罪恶，</para>
  <para style="q1" vid="HOS 8:13">他们必回到<char style="pn">埃及</char>。<verse eid="HOS 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 8:14" />
    <char style="pn">以色列</char>忘记了他的创造主，</para>
  <para style="q1" vid="HOS 8:14">建造许多宫殿，</para>
  <para style="q1" vid="HOS 8:14">
    <char style="pn">犹大</char>也增多坚固的城。</para>
  <para style="q1" vid="HOS 8:14">所以我必使烈火降在他的城镇，</para>
  <para style="q1" vid="HOS 8:14">吞噬他的城堡。<verse eid="HOS 8:14" /></para>
  <chapter eid="HOS 8" />
  <chapter number="9" style="c" sid="HOS 9" />
  <para style="s">以色列将被掳</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 9:1" />
    <char style="pn">以色列</char>啊，不要欢喜，</para>
  <para style="q1" vid="HOS 9:1">不要像外邦人那样快乐！</para>
  <para style="q1" vid="HOS 9:1">因为你行淫背叛你的神，</para>
  <para style="q1" vid="HOS 9:1">贪爱各处打谷场上卖淫的酬金。<verse eid="HOS 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 9:2" />打谷场和榨酒池不会再供养他们，</para>
  <para style="q1" vid="HOS 9:2">新酒也不再供应他们。<verse eid="HOS 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 9:3" />他们不能居住在耶和华的土地上，</para>
  <para style="q1" vid="HOS 9:3">
    <char style="pn">以法莲</char>将回到<char style="pn">埃及</char>，</para>
  <para style="q1" vid="HOS 9:3">在<char style="pn">亚述</char>吃不洁之物。<verse eid="HOS 9:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HOS 9:4" />他们不能向耶和华浇奠酒祭，</para>
  <para style="q1" vid="HOS 9:4">他们的祭物也不蒙他喜悦。</para>
  <para style="q1" vid="HOS 9:4">他们的祭物是丧家的食物，</para>
  <para style="q1" vid="HOS 9:4">凡是吃的人都使自己受玷污；</para>
  <para style="q1" vid="HOS 9:4">因为他们的食物是为自己的欲望，</para>
  <para style="q1" vid="HOS 9:4">不能奉入耶和华的殿。<verse eid="HOS 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 9:5" />到所定的节期，</para>
  <para style="q1" vid="HOS 9:5">在耶和华节期的日子，</para>
  <para style="q1" vid="HOS 9:5">你们该怎么办呢？<verse eid="HOS 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 9:6" />看哪，他们逃避毁灭，</para>
  <para style="q1" vid="HOS 9:6">
    <char style="pn">埃及</char>却将收殓他们，</para>
  <para style="q1" vid="HOS 9:6">
    <char style="pn">摩弗</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">9:6 </char>
      <char style="ft" closed="false">摩弗——希腊语音译为“孟斐斯”。</char>
    </note>将埋葬他们！</para>
  <para style="q1" vid="HOS 9:6">灌木丛将覆盖他们宝贵的银器，</para>
  <para style="q1" vid="HOS 9:6">蒺藜将占据他们的帐篷。<verse eid="HOS 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="HOS 9:7" />惩罚的日子来到了，</para>
  <para style="q1" vid="HOS 9:7">报应的日子来到了！</para>
  <para style="q1" vid="HOS 9:7">要让<char style="pn">以色列</char>知道：</para>
  <para style="q1" vid="HOS 9:7">先知是愚妄人，</para>
  <para style="q1" vid="HOS 9:7">受灵感的是疯子；</para>
  <para style="q1" vid="HOS 9:7">因为你们的罪孽众多，</para>
  <para style="q1" vid="HOS 9:7">你们的敌意极大。<verse eid="HOS 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 9:8" />先知为我的神<note caller="+" style="f"><char style="fr" closed="false">9:8 </char><char style="ft" closed="false">为我的神——或译作“与我的神一同”。</char></note>守望<char style="pn">以法莲</char>，</para>
  <para style="q1" vid="HOS 9:8">然而他一切道路上</para>
  <para style="q1" vid="HOS 9:8">都有捕鸟人的网罗，</para>
  <para style="q1" vid="HOS 9:8">他神的殿中充满敌意。<verse eid="HOS 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 9:9" />
    <char style="pn">以法莲</char>深深陷入败坏，</para>
  <para style="q1" vid="HOS 9:9">像在<char style="pn">基比亚</char>的日子那样。</para>
  <para style="q1" vid="HOS 9:9">耶和华必记起他们的罪孽，</para>
  <para style="q1" vid="HOS 9:9">惩罚他们的罪恶。<verse eid="HOS 9:9" /></para>
  <para style="b" />
  <para style="s">以法莲断绝后裔</para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 9:10" />从前我找到<char style="pn">以色列</char>，</para>
  <para style="q1" vid="HOS 9:10">他们就像旷野中的葡萄，</para>
  <para style="q1" vid="HOS 9:10">我看你们的祖先</para>
  <para style="q1" vid="HOS 9:10">就像无花果树最好的初熟果子。</para>
  <para style="q1" vid="HOS 9:10">他们来到<char style="pn">巴力</char>-<char style="pn">毗珥</char>，</para>
  <para style="q1" vid="HOS 9:10">却把自己献给可耻的偶像，</para>
  <para style="q1" vid="HOS 9:10">以致成为可憎厌的，</para>
  <para style="q1" vid="HOS 9:10">与他们所爱的偶像<note caller="+" style="f"><char style="fr" closed="false">9:10 </char><char style="ft" closed="false">偶像——辅助词语。</char></note>一样。<verse eid="HOS 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 9:11" />
    <char style="pn">以法莲</char>的荣耀必像鸟一样飞走，</para>
  <para style="q1" vid="HOS 9:11">他们不生育，不受孕，不怀胎。<verse eid="HOS 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 9:12" />即使他们养大了儿女，</para>
  <para style="q1" vid="HOS 9:12">我也要使这些儿女丧亡，一个不留。</para>
  <para style="q1" vid="HOS 9:12">是的，他们也有祸了，</para>
  <para style="q1" vid="HOS 9:12">因我离弃了他们。<verse eid="HOS 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 9:13" />我看<char style="pn">以法莲</char></para>
  <para style="q1" vid="HOS 9:13">像栽种在牧场上的<char style="pn">提尔</char>，</para>
  <para style="q1" vid="HOS 9:13">
    <char style="pn">以法莲</char>却把自己的儿女带出去，</para>
  <para style="q1" vid="HOS 9:13">交给杀戮的人。<verse eid="HOS 9:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="HOS 9:14" />耶和华啊，求你赏赐他们——</para>
  <para style="q1" vid="HOS 9:14">赐什么呢？</para>
  <para style="q1" vid="HOS 9:14">赐给他们掉落的胎儿、枯竭的乳房！<verse eid="HOS 9:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="HOS 9:15" />他们一切恶行都在<char style="pn">吉甲</char>；</para>
  <para style="q1" vid="HOS 9:15">是的，我在那里憎恶他们。</para>
  <para style="q1" vid="HOS 9:15">因他们的恶行，</para>
  <para style="q1" vid="HOS 9:15">我要把他们从我的家中赶出去。</para>
  <para style="q1" vid="HOS 9:15">我不再喜爱他们，</para>
  <para style="q1" vid="HOS 9:15">他们的首领都是顽梗的。<verse eid="HOS 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 9:16" />
    <char style="pn">以法莲</char>必被责打，</para>
  <para style="q1" vid="HOS 9:16">树根枯干，</para>
  <para style="q1" vid="HOS 9:16">不能结出果实。</para>
  <para style="q1" vid="HOS 9:16">就算他们生了孩子，</para>
  <para style="q1" vid="HOS 9:16">我也要把他们亲生的宝贝处死。<verse eid="HOS 9:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="HOS 9:17" />我的神厌弃他们，</para>
  <para style="q1" vid="HOS 9:17">因为他们不听从他。</para>
  <para style="q1" vid="HOS 9:17">他们必在列国中漂泊。<verse eid="HOS 9:17" /></para>
  <chapter eid="HOS 9" />
  <chapter number="10" style="c" sid="HOS 10" />
  <para style="s">葡萄树和小母牛</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 10:1" />
    <char style="pn">以色列</char>是旺长<note caller="+" style="f"><char style="fr" closed="false">10:1 </char><char style="ft" closed="false">旺长——或译作“虚无”。</char></note>的葡萄树，</para>
  <para style="q1" vid="HOS 10:1">她结出果实，</para>
  <para style="q1" vid="HOS 10:1">果实越多，祭坛就越多；</para>
  <para style="q1" vid="HOS 10:1">她的土地越肥美，她就越妆饰神柱。<verse eid="HOS 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 10:2" />他们虚心假意，</para>
  <para style="q1" vid="HOS 10:2">现在必承担罪责，</para>
  <para style="q1" vid="HOS 10:2">耶和华将拆毁他们的祭坛，</para>
  <para style="q1" vid="HOS 10:2">摧毁他们的神柱。<verse eid="HOS 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 10:3" />那时他们必说：</para>
  <para style="q1" vid="HOS 10:3">“我们没有王，</para>
  <para style="q1" vid="HOS 10:3">因为我们不敬畏耶和华。</para>
  <para style="q1" vid="HOS 10:3">王又能为我们做什么呢？”<verse eid="HOS 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 10:4" />他们说空话，起假誓立约，</para>
  <para style="q1" vid="HOS 10:4">所以惩罚如毒草在田地的犁沟中蔓延。<verse eid="HOS 10:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="HOS 10:5" />
    <char style="pn">撒玛利亚</char>的居民</para>
  <para style="q1" vid="HOS 10:5">因<char style="pn">伯亚文</char>的小母牛而惧怕；</para>
  <para style="q1" vid="HOS 10:5">它的子民必为它悲恸，</para>
  <para style="q1" vid="HOS 10:5">这些服事偶像的祭司</para>
  <para style="q1" vid="HOS 10:5">将为它的荣耀嚎叫，</para>
  <para style="q1" vid="HOS 10:5">因为荣耀离开了它<note caller="+" style="f"><char style="fr" closed="false">10:5 </char><char style="ft" closed="false">这些服事偶像的祭司将为它的荣耀嚎叫，因为荣耀离开了它——或译作“这些服事偶像的祭司曾为它的荣耀快乐，但荣耀离开了它”。</char></note>。<verse eid="HOS 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 10:6" />连它也要被带到<char style="pn">亚述</char>，</para>
  <para style="q1" vid="HOS 10:6">成为献给<char style="pn">亚述</char>大王的贡物。</para>
  <para style="q1" vid="HOS 10:6">
    <char style="pn">以法莲</char>必承受羞辱，</para>
  <para style="q1" vid="HOS 10:6">
    <char style="pn">以色列</char>将因自己的谋略而羞惭。<verse eid="HOS 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 10:7" />
    <char style="pn">撒玛利亚</char>被摧毁了，</para>
  <para style="q1" vid="HOS 10:7">她的王好像水面上的残枝<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false">残枝——或译作“泡沫”。</char></note>。<verse eid="HOS 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 10:8" />偶像的高坛，就是<char style="pn">以色列</char>的罪恶，</para>
  <para style="q1" vid="HOS 10:8">被拆毁了！</para>
  <para style="q1" vid="HOS 10:8">荆棘和蒺藜爬上他们的祭坛。</para>
  <para style="q1" vid="HOS 10:8">他们必对大山说：“遮盖我们吧！”</para>
  <para style="q1" vid="HOS 10:8">对小山说：“倒在我们身上吧！”<verse eid="HOS 10:8" /></para>
  <para style="b" />
  <para style="s">以色列因罪而败亡</para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 10:9" />
    <char style="pn">以色列</char>啊，</para>
  <para style="q1" vid="HOS 10:9">从<char style="pn">基比亚</char>的日子起，你就犯罪！</para>
  <para style="q1" vid="HOS 10:9">他们一直在那里犯罪。</para>
  <para style="q1" vid="HOS 10:9">对不义之人的战争，</para>
  <para style="q1" vid="HOS 10:9">难道不会在<char style="pn">基比亚</char>追上他们吗？<verse eid="HOS 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 10:10" />我必按自己的心意，管教他们。</para>
  <para style="q1" vid="HOS 10:10">他们被自己双重罪孽捆绑的时候，</para>
  <para style="q1" vid="HOS 10:10">列邦必聚集起来攻击他们。<verse eid="HOS 10:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 10:11" />
    <char style="pn">以法莲</char>曾是驯服的小母牛，</para>
  <para style="q1" vid="HOS 10:11">喜爱踹谷，</para>
  <para style="q1" vid="HOS 10:11">现在我却要把轭套在它肥壮的脖子上。</para>
  <para style="q1" vid="HOS 10:11">我要使<char style="pn">以法莲</char>拉犁，</para>
  <para style="q1" vid="HOS 10:11">
    <char style="pn">犹大</char>要耕作，</para>
  <para style="q1" vid="HOS 10:11">
    <char style="pn">雅各</char>要为自己耙地。<verse eid="HOS 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 10:12" />你们要为自己播种公义，</para>
  <para style="q1" vid="HOS 10:12">收获忠诚<note caller="+" style="f"><char style="fr" closed="false">10:12 </char><char style="ft" closed="false">忠诚——或译作“慈爱”。</char></note>的果实，</para>
  <para style="q1" vid="HOS 10:12">要开垦你们的荒地。</para>
  <para style="q1" vid="HOS 10:12">现在正是求问耶和华的时候，</para>
  <para style="q1" vid="HOS 10:12">要等到他来，使公义如雨滋润你们。<verse eid="HOS 10:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="HOS 10:13" />你们耕耘邪恶，收获不义，</para>
  <para style="q1" vid="HOS 10:13">吃了谎言的果实。</para>
  <para style="q1" vid="HOS 10:13">因为你依靠自己的道路<note caller="+" style="f"><char style="fr" closed="false">10:13 </char><char style="ft" closed="false">道路——或译作“战车”。</char></note></para>
  <para style="q1" vid="HOS 10:13">和自己众多的勇士，<verse eid="HOS 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 10:14" />所以你的子民中将起喧嚷，</para>
  <para style="q1" vid="HOS 10:14">你所有的堡垒都要被摧毁，</para>
  <para style="q1" vid="HOS 10:14">就像<char style="pn">沙勒曼</char>在争战的日子里</para>
  <para style="q1" vid="HOS 10:14">摧毁<char style="pn">伯亚比勒</char>那样，</para>
  <para style="q1" vid="HOS 10:14">母亲和儿女一同被摔死。<verse eid="HOS 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 10:15" />
    <char style="pn">伯特利</char>啊，我必这样对待你们，</para>
  <para style="q1" vid="HOS 10:15">因为你们的罪恶极大。</para>
  <para style="q1" vid="HOS 10:15">黎明的时候，</para>
  <para style="q1" vid="HOS 10:15">
    <char style="pn">以色列</char>的王将被彻底除灭。<verse eid="HOS 10:15" /></para>
  <chapter eid="HOS 10" />
  <chapter number="11" style="c" sid="HOS 11" />
  <para style="s">耶和华对以色列的爱</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 11:1" />
    <char style="pn">以色列</char>年少的时候，我就爱他；</para>
  <para style="q1" vid="HOS 11:1">我把我的儿子从<char style="pn">埃及</char>召唤出来。<verse eid="HOS 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 11:2" />我越召唤他们，他们越远离我；</para>
  <para style="q1" vid="HOS 11:2">他们向<char style="pn">巴力</char>献祭，向偶像烧香。<verse eid="HOS 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 11:3" />我教导<char style="pn">以法莲</char>走路，</para>
  <para style="q1" vid="HOS 11:3">用膀臂抱着他们，</para>
  <para style="q1" vid="HOS 11:3">他们却不明白是我医治<note caller="+" style="f"><char style="fr" closed="false">11:3 </char><char style="ft" closed="false">医治——或译作“看护”。</char></note>了他们。<verse eid="HOS 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 11:4" />我用慈绳爱索牵引他们；</para>
  <para style="q1" vid="HOS 11:4">我对待他们，</para>
  <para style="q1" vid="HOS 11:4">就像人把婴孩抱在脸颊旁<note caller="+" style="f"><char style="fr" closed="false">11:4 </char><char style="ft" closed="false">把婴孩抱在脸颊旁——或译作“除掉牛脸颊上的轭”。</char></note>，</para>
  <para style="q1" vid="HOS 11:4">俯身喂养他。<verse eid="HOS 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 11:5" />他们绝不能回到<char style="pn">埃及</char>地，</para>
  <para style="q1" vid="HOS 11:5">
    <char style="pn">亚述</char>却要作他们的王，</para>
  <para style="q1" vid="HOS 11:5">因为他们不肯悔改。<verse eid="HOS 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 11:6" />刀剑必在他们各城挥舞，</para>
  <para style="q1" vid="HOS 11:6">消灭他们的占卜者<note caller="+" style="f"><char style="fr" closed="false">11:6 </char><char style="ft" closed="false">消灭他们的占卜者——或译作“毁坏他们的门闩”。</char></note>，</para>
  <para style="q1" vid="HOS 11:6">挫败他们的计谋。<verse eid="HOS 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 11:7" />我的子民执意背离我，</para>
  <para style="q1" vid="HOS 11:7">他们虽然向至高者呼求，</para>
  <para style="q1" vid="HOS 11:7">却全然不尊崇他。<verse eid="HOS 11:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HOS 11:8" />
    <char style="pn">以法莲</char>哪，我怎能撇弃你呢？</para>
  <para style="q1" vid="HOS 11:8">
    <char style="pn">以色列</char>啊，我怎能把你交出去呢？</para>
  <para style="q1" vid="HOS 11:8">我怎能撇弃你如<char style="pn">押玛</char>，</para>
  <para style="q1" vid="HOS 11:8">使你如<char style="pn">洗扁</char>那样呢？</para>
  <para style="q1" vid="HOS 11:8">我心里翻腾<note caller="+" style="f"><char style="fr" closed="false">11:8 </char><char style="ft" closed="false">心里翻腾——或译作“回心转意”。</char></note>，</para>
  <para style="q1" vid="HOS 11:8">我的怜爱全都涌上来。<verse eid="HOS 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 11:9" />我不再发出我猛烈的怒气，</para>
  <para style="q1" vid="HOS 11:9">不再毁掉<char style="pn">以法莲</char>。</para>
  <para style="q1" vid="HOS 11:9">因为我是神，而非世人；</para>
  <para style="q1" vid="HOS 11:9">我是你们当中的至圣者，</para>
  <para style="q1" vid="HOS 11:9">我不愿在烈怒中来临。<verse eid="HOS 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 11:10" />他们将跟随耶和华；</para>
  <para style="q1" vid="HOS 11:10">他要像狮子吼叫，</para>
  <para style="q1" vid="HOS 11:10">他一吼叫，</para>
  <para style="q1" vid="HOS 11:10">儿女就从西方战兢而来。<verse eid="HOS 11:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 11:11" />他们要像雀鸟从<char style="pn">埃及</char>战兢而来，</para>
  <para style="q1" vid="HOS 11:11">又如鸽子从<char style="pn">亚述</char>地战兢归来。</para>
  <para style="q1" vid="HOS 11:11">我要使他们住在自己家中。</para>
  <para style="q1" vid="HOS 11:11">这是耶和华的宣告。<verse eid="HOS 11:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="HOS 11:12" />
    <note caller="+" style="f">
      <char style="fr" closed="false">11:12 </char>
      <char style="ft" closed="false">此节在马索拉文本为12:1。</char>
    </note>
    <char style="pn">以法莲</char>用谎言围绕我，</para>
  <para style="q1" vid="HOS 11:12">
    <char style="pn">以色列</char>家用欺骗围着我。</para>
  <para style="q1" vid="HOS 11:12">
    <char style="pn">犹大</char>一再抗拒神，</para>
  <para style="q1" vid="HOS 11:12">抗拒信实的至圣者<note caller="+" style="f"><char style="fr" closed="false">11:12 </char><char style="ft" closed="false">犹大一再抗拒神，抗拒信实的至圣者——或译作“犹大仍然与神同行，忠实于至圣者”。</char></note>。<verse eid="HOS 11:12" /></para>
  <chapter eid="HOS 11" />
  <chapter number="12" style="c" sid="HOS 12" />
  <para style="s">耶和华指控雅各家</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 12:1" />
    <note caller="+" style="f">
      <char style="fr" closed="false">12:1 </char>
      <char style="ft" closed="false">此章在马索拉文本为12:2至12:15。</char>
    </note>
    <char style="pn">以法莲</char>以风为食，</para>
  <para style="q1" vid="HOS 12:1">追逐东风，</para>
  <para style="q1" vid="HOS 12:1">终日增添虚谎和毁坏。</para>
  <para style="q1" vid="HOS 12:1">他与<char style="pn">亚述</char>立约，</para>
  <para style="q1" vid="HOS 12:1">把油送给<char style="pn">埃及</char>。<verse eid="HOS 12:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="HOS 12:2" />耶和华与<char style="pn">犹大</char>有争讼，</para>
  <para style="q1" vid="HOS 12:2">要照<char style="pn">雅各</char>的行径惩罚他，</para>
  <para style="q1" vid="HOS 12:2">照他的行为报应他。<verse eid="HOS 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 12:3" />他曾在母腹中抓住哥哥的脚跟，</para>
  <para style="q1" vid="HOS 12:3">又在壮年时与神较力。<verse eid="HOS 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 12:4" />
    <char style="pn">雅各</char>与天使较力而得胜，</para>
  <para style="q1" vid="HOS 12:4">并且哭泣，恳求他施恩；</para>
  <para style="q1" vid="HOS 12:4">又在<char style="pn">伯特利</char>遇见他，</para>
  <para style="q1" vid="HOS 12:4">在那里与他<note caller="+" style="f"><char style="fr" closed="false">12:4 </char><char style="ft" closed="false">他——依据七十士译本；马索拉文本作“我们”。</char></note>说话；<verse eid="HOS 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 12:5" />他是耶和华万军之神，</para>
  <para style="q1" vid="HOS 12:5">耶和华是他的名号。<verse eid="HOS 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 12:6" />所以你要回转归向你的神，</para>
  <para style="q1" vid="HOS 12:6">要持守忠诚<note caller="+" style="f"><char style="fr" closed="false">12:6 </char><char style="ft" closed="false">忠诚——或译作“慈爱”。</char></note>和公义，</para>
  <para style="q1" vid="HOS 12:6">一直等候你的神。<verse eid="HOS 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="HOS 12:7" />
    <char style="pn">以法莲</char>是个<note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="ft" closed="false">以法莲是个——辅助词语。</char></note>商人，</para>
  <para style="q1" vid="HOS 12:7">他手中有欺诈的天平，</para>
  <para style="q1" vid="HOS 12:7">他专爱欺压。<verse eid="HOS 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 12:8" />
    <char style="pn">以法莲</char>还说：</para>
  <para style="q1" vid="HOS 12:8">“我真的富有了，我发财了！</para>
  <para style="q1" vid="HOS 12:8">这是我一切辛苦所得，</para>
  <para style="q1" vid="HOS 12:8">我身上找不到可定罪的过犯。”<verse eid="HOS 12:8" /></para>
  <para style="b" />
  <para style="s">以色列受管教</para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 12:9" />自从你出<char style="pn">埃及</char>地以来，</para>
  <para style="q1" vid="HOS 12:9">我就是耶和华你的神。</para>
  <para style="q1" vid="HOS 12:9">我要使你再住帐篷，</para>
  <para style="q1" vid="HOS 12:9">像在节期的日子那样。<verse eid="HOS 12:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 12:10" />我已经告诉众先知，</para>
  <para style="q1" vid="HOS 12:10">并且亲自增多异象<note caller="+" style="f"><char style="fr" closed="false">12:10 </char><char style="ft" closed="false">异象——或译作“启示”。</char></note>，</para>
  <para style="q1" vid="HOS 12:10">藉着众先知设了比喻。<verse eid="HOS 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 12:11" />
    <char style="pn">基列</char>不是奸恶的吗？</para>
  <para style="q1" vid="HOS 12:11">他们实在虚妄！</para>
  <para style="q1" vid="HOS 12:11">人们在<char style="pn">吉甲</char>向公牛献祭，</para>
  <para style="q1" vid="HOS 12:11">他们的祭坛</para>
  <para style="q1" vid="HOS 12:11">也多如田间犁沟旁的石堆。<verse eid="HOS 12:11" /></para>
  <para style="b" />
  <para style="s">雅各家受责罚</para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 12:12" />
    <char style="pn">雅各</char>曾逃到<char style="pn">亚兰</char>地，</para>
  <para style="q1" vid="HOS 12:12">
    <char style="pn">以色列</char>为得妻子而劳苦，</para>
  <para style="q1" vid="HOS 12:12">为得妻子而看顾羊群。<verse eid="HOS 12:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 12:13" />耶和华藉着一位先知</para>
  <para style="q1" vid="HOS 12:13">把<char style="pn">以色列</char>从<char style="pn">埃及</char>带上来，</para>
  <para style="q1" vid="HOS 12:13">也藉着一位先知看顾他。<verse eid="HOS 12:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="HOS 12:14" />
    <char style="pn">以法莲</char>极力惹怒耶和华，</para>
  <para style="q1" vid="HOS 12:14">所以他的主</para>
  <para style="q1" vid="HOS 12:14">把他的血债归在他身上，</para>
  <para style="q1" vid="HOS 12:14">把他的羞辱回报给他。<verse eid="HOS 12:14" /></para>
  <chapter eid="HOS 12" />
  <chapter number="13" style="c" sid="HOS 13" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 13:1" />从前<char style="pn">以法莲</char>一说话，人都战兢；</para>
  <para style="q1" vid="HOS 13:1">他在<char style="pn">以色列</char>中被高举。</para>
  <para style="q1" vid="HOS 13:1">但他因事奉<char style="pn">巴力</char>而有了罪责，</para>
  <para style="q1" vid="HOS 13:1">以致败亡<note caller="+" style="f"><char style="fr" closed="false">13:1 </char><char style="ft" closed="false">败亡——原文直译“死亡”。</char></note>。<verse eid="HOS 13:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="HOS 13:2" />如今他们一再犯罪！</para>
  <para style="q1" vid="HOS 13:2">他们用银子为自己铸造神像，</para>
  <para style="q1" vid="HOS 13:2">照着自己的聪明铸造偶像，</para>
  <para style="q1" vid="HOS 13:2">全都是工匠的作品。</para>
  <para style="q1" vid="HOS 13:2">论到这些，他们说：</para>
  <para style="q1" vid="HOS 13:2">“让献祭的人亲吻金牛犊吧！”<verse eid="HOS 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 13:3" />因此他们必如清晨的云雾，</para>
  <para style="q1" vid="HOS 13:3">又如早上消逝的露水；</para>
  <para style="q1" vid="HOS 13:3">如打谷场上吹走的糠秕，</para>
  <para style="q1" vid="HOS 13:3">又如窗口冒出的烟。<verse eid="HOS 13:3" /></para>
  <para style="b" />
  <para style="s">摧毁与救赎</para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 13:4" />自从你出<char style="pn">埃及</char>地，</para>
  <para style="q1" vid="HOS 13:4">我耶和华就是你的神。</para>
  <para style="q1" vid="HOS 13:4">除我以外，你不可认识别的神；</para>
  <para style="q1" vid="HOS 13:4">在我之外，没有拯救者。<verse eid="HOS 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 13:5" />是我在旷野中，</para>
  <para style="q1" vid="HOS 13:5">在干旱之地眷顾<note caller="+" style="f"><char style="fr" closed="false">13:5 </char><char style="ft" closed="false">眷顾——原文直译“认识”；七十士译本作“喂养”。</char></note>你。<verse eid="HOS 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 13:6" />他们在牧场上，</para>
  <para style="q1" vid="HOS 13:6">得以饱足。</para>
  <para style="q1" vid="HOS 13:6">他们饱足了，</para>
  <para style="q1" vid="HOS 13:6">就心里高傲，</para>
  <para style="q1" vid="HOS 13:6">因此忘记了我。<verse eid="HOS 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 13:7" />所以我要像猛狮攻击他们，</para>
  <para style="q1" vid="HOS 13:7">像路旁的豹子窥伺他们。<verse eid="HOS 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 13:8" />我要像失去幼仔的母熊冲向他们，</para>
  <para style="q1" vid="HOS 13:8">我要撕裂他们的胸膛，</para>
  <para style="q1" vid="HOS 13:8">像母狮在那里吞噬他们，</para>
  <para style="q1" vid="HOS 13:8">田野的走兽必撕裂他们。<verse eid="HOS 13:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 13:9" />
    <char style="pn">以色列</char>啊，我要毁灭你，</para>
  <para style="q1" vid="HOS 13:9">因为你敌对我，敌对你的帮助者<note caller="+" style="f"><char style="fr" closed="false">13:9 </char><char style="ft" closed="false">因为你敌对我，敌对你的帮助者——七十士译本作“谁能帮助你呢”。</char></note>。<verse eid="HOS 13:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="HOS 13:10" />你的王究竟在哪里呢？</para>
  <para style="q1" vid="HOS 13:10">让他在你各城拯救你吧！</para>
  <para style="q1" vid="HOS 13:10">你的审判官在哪里呢？</para>
  <para style="q1" vid="HOS 13:10">你从前竟然说：</para>
  <para style="q1" vid="HOS 13:10">“请赐给我君王和首领！”<verse eid="HOS 13:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 13:11" />我在怒气中赐给了你君王，</para>
  <para style="q1" vid="HOS 13:11">又在盛怒中废去君王。<verse eid="HOS 13:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 13:12" />
    <char style="pn">以法莲</char>的罪孽被包裹起来，</para>
  <para style="q1" vid="HOS 13:12">他的罪恶被封存了。<verse eid="HOS 13:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 13:13" />临产妇人的绞痛将临到他身上，</para>
  <para style="q1" vid="HOS 13:13">他是毫无智慧的儿子！</para>
  <para style="q1" vid="HOS 13:13">是的，孩子出母腹的时候到了，</para>
  <para style="q1" vid="HOS 13:13">他却耽延不出。<verse eid="HOS 13:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="HOS 13:14" />我要救赎他们脱离阴间的权势，</para>
  <para style="q1" vid="HOS 13:14">把他们从死亡中赎回来。</para>
  <para style="q1" vid="HOS 13:14">死亡啊，你的毒刺<note caller="+" style="f"><char style="fr" closed="false">13:14 </char><char style="ft" closed="false">毒刺——原文直译“瘟疫”。</char></note>在哪里？</para>
  <para style="q1" vid="HOS 13:14">阴间哪，你的毒害在哪里？</para>
  <para style="q1" vid="HOS 13:14">怜恤从我眼前隐藏了！<verse eid="HOS 13:14" /></para>
  <para style="b" />
  <para style="s">将要来临的审判</para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 13:15" />他虽然在芦苇<note caller="+" style="f"><char style="fr" closed="false">13:15 </char><char style="ft" closed="false">芦苇——或译作“兄弟”。</char></note>中茂盛，</para>
  <para style="q1" vid="HOS 13:15">但必有东风刮来，</para>
  <para style="q1" vid="HOS 13:15">是耶和华的风，从旷野上来。</para>
  <para style="q1" vid="HOS 13:15">他的源头必枯干，</para>
  <para style="q1" vid="HOS 13:15">他的泉源必干涸；</para>
  <para style="q1" vid="HOS 13:15">东风将刮走宝库里的一切宝器。<verse eid="HOS 13:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="HOS 13:16" />
    <char style="pn">撒玛利亚</char>要承担罪责，</para>
  <para style="q1" vid="HOS 13:16">因为他悖逆他的神。</para>
  <para style="q1" vid="HOS 13:16">他必倒在刀下，</para>
  <para style="q1" vid="HOS 13:16">他的幼童将被摔死，</para>
  <para style="q1" vid="HOS 13:16">他的孕妇将被剖开。<verse eid="HOS 13:16" /></para>
  <chapter eid="HOS 13" />
  <chapter number="14" style="c" sid="HOS 14" />
  <para style="s">呼吁以色列回转</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 14:1" />
    <char style="pn">以色列</char>啊，回转吧，</para>
  <para style="q1" vid="HOS 14:1">归向耶和华你的神！</para>
  <para style="q1" vid="HOS 14:1">因为你的罪孽使你绊倒了。<verse eid="HOS 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 14:2" />要带上你的祈求，</para>
  <para style="q1" vid="HOS 14:2">回转归向耶和华，对他说：</para>
  <para style="q1" vid="HOS 14:2">“求你饶恕所有的罪孽，</para>
  <para style="q1" vid="HOS 14:2">以恩惠接纳我们<note caller="+" style="f"><char style="fr" closed="false">14:2 </char><char style="ft" closed="false">我们——辅助词语。</char></note>，</para>
  <para style="q1" vid="HOS 14:2">好让我们以嘴唇的祭<note caller="+" style="f"><char style="fr" closed="false">14:2 </char><char style="ft" closed="false">嘴唇的祭——原文直译“嘴唇”；或译作“赞美”。</char></note>代替公牛献上。<verse eid="HOS 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 14:3" />
    <char style="pn">亚述</char>不能拯救我们，</para>
  <para style="q1" vid="HOS 14:3">我们不再乘驾<char style="pn">埃及</char><note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">埃及——辅助词语。</char></note>战马，</para>
  <para style="q1" vid="HOS 14:3">也不再把我们手所造的称为</para>
  <para style="q1" vid="HOS 14:3">‘我们的神’。</para>
  <para style="q1" vid="HOS 14:3">只有在你那里，孤儿才蒙怜悯！”<verse eid="HOS 14:3" /></para>
  <para style="b" />
  <para style="s">以色列复兴的应许</para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 14:4" />我要医除他们的背道；</para>
  <para style="q1" vid="HOS 14:4">我心甘情愿爱他们，</para>
  <para style="q1" vid="HOS 14:4">我已转消对他们的怒气。<verse eid="HOS 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 14:5" />我要像露水滋润<note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="ft" closed="false">滋润——辅助词语。</char></note><char style="pn">以色列</char>，</para>
  <para style="q1" vid="HOS 14:5">他必如百合花绽放，</para>
  <para style="q1" vid="HOS 14:5">如<char style="pn">黎巴嫩</char>的树木扎根。<verse eid="HOS 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 14:6" />他的嫩枝必伸展，</para>
  <para style="q1" vid="HOS 14:6">他的尊荣如橄榄树，</para>
  <para style="q1" vid="HOS 14:6">他的香气如<char style="pn">黎巴嫩</char>的香柏树<note caller="+" style="f"><char style="fr" closed="false">14:6 </char><char style="ft" closed="false">的香柏树——辅助词语。</char></note>。<verse eid="HOS 14:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 14:7" />那些曾住在他树荫下的</para>
  <para style="q1" vid="HOS 14:7">将回归，发旺如五谷；</para>
  <para style="q1" vid="HOS 14:7">他必兴盛如葡萄树，</para>
  <para style="q1" vid="HOS 14:7">他的名声如<char style="pn">黎巴嫩</char>的酒。<verse eid="HOS 14:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HOS 14:8" />
    <char style="pn">以法莲</char>说：</para>
  <para style="q1" vid="HOS 14:8">“我与偶像还有什么相干呢？”</para>
  <para style="q1" vid="HOS 14:8">那时，我必回应他，看顾他。</para>
  <para style="q1" vid="HOS 14:8">我像青翠的松树，</para>
  <para style="q1" vid="HOS 14:8">你的果实从我而出。<verse eid="HOS 14:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HOS 14:9" />谁是智慧人，愿他领悟这些事；</para>
  <para style="q1" vid="HOS 14:9">谁是有悟性的人，</para>
  <para style="q1" vid="HOS 14:9">愿他明白这一切！</para>
  <para style="q1" vid="HOS 14:9">是的，耶和华的道路正直，</para>
  <para style="q1" vid="HOS 14:9">义人走在其上，</para>
  <para style="q1" vid="HOS 14:9">悖逆的人却在其上绊倒。<verse eid="HOS 14:9" /></para>
  <chapter eid="HOS 14" />
</usx>