<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CH" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">历代志上</para>
  <para style="mt">历代志上</para>
  <chapter number="1" style="c" sid="1CH 1" />
  <para style="s">从亚当到亚伯拉罕</para>
  <para style="mi">
    <verse number="1" style="v" sid="1CH 1:1" />
    <char style="pn">亚当</char>，<char style="pn">塞特</char>，<char style="pn">以挪士</char>，<verse eid="1CH 1:1" /></para>
  <para style="mi">
    <verse number="2" style="v" sid="1CH 1:2" />
    <char style="pn">该南</char>，<char style="pn">玛勒列</char>，<char style="pn">雅列</char>，<verse eid="1CH 1:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 1:3" />
    <char style="pn">以诺</char>，<char style="pn">玛土撒拉</char>，<char style="pn">拉麦</char>，<verse eid="1CH 1:3" /></para>
  <para style="mi">
    <verse number="4" style="v" sid="1CH 1:4" />
    <char style="pn">挪亚</char>，他的儿子<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">他的儿子——辅助词语；依据七十士译本。</char></note><char style="pn">闪</char>、<char style="pn">含</char>和<char style="pn">雅弗</char>。<verse eid="1CH 1:4" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="5" style="v" sid="1CH 1:5" />
    <char style="pn">雅弗</char>的儿子是<char style="pn">格梅尔</char>、<char style="pn">玛格</char>、<char style="pn">玛代</char>、<char style="pn">雅完</char>、<char style="pn">图巴</char>、<char style="pn">米设</char>、<char style="pn">提拉</char>。<verse eid="1CH 1:5" /></para>
  <para style="mi">
    <verse number="6" style="v" sid="1CH 1:6" />
    <char style="pn">格梅尔</char>的儿子是<char style="pn">阿实基拿</char>、<char style="pn">利法特</char>、<char style="pn">陀伽玛</char>。<verse eid="1CH 1:6" /></para>
  <para style="mi">
    <verse number="7" style="v" sid="1CH 1:7" />
    <char style="pn">雅完</char>的儿子是<char style="pn">以利沙</char>、<char style="pn">塔尔施</char>、<char style="pn">基提</char>、<char style="pn">罗单</char>。<verse eid="1CH 1:7" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="8" style="v" sid="1CH 1:8" />
    <char style="pn">含</char>的儿子是<char style="pn">库实</char>、<char style="pn">麦西</char>、<char style="pn">普特</char>、<char style="pn">迦南</char>。<verse eid="1CH 1:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="1CH 1:9" />
    <char style="pn">库实</char>的儿子是<char style="pn">西拔</char>、<char style="pn">哈腓拉</char>、<char style="pn">撒弗他</char>、<char style="pn">拉玛</char>、<char style="pn">撒弗提迦</char>。</para>
  <para style="mi" vid="1CH 1:9">
    <char style="pn">拉玛</char>的儿子是<char style="pn">示巴</char>、<char style="pn">底但</char>。<verse eid="1CH 1:9" /></para>
  <para style="mi">
    <verse number="10" style="v" sid="1CH 1:10" />
    <char style="pn">库实</char>又生了<char style="pn">宁录</char>，<char style="pn">宁录</char>是地上第一个强人。<verse eid="1CH 1:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="1CH 1:11" />
    <char style="pn">麦西</char>生了<char style="pn">吕底亚</char>人、<char style="pn">亚拿米</char>人、<char style="pn">利哈比</char>人、<char style="pn">拿弗土希</char>人、 <verse eid="1CH 1:11" /><verse number="12" style="v" sid="1CH 1:12" /><char style="pn">帕斯鲁细</char>人、<char style="pn">迦斯路希</char>人、<char style="pn">迦斐托</char>人；<char style="pn">非利士</char>人来源于<char style="pn">迦斯路希</char>人。<verse eid="1CH 1:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 1:13" />
    <char style="pn">迦南</char>生了长子<char style="pn">西顿</char>，又生了<char style="pn">赫提</char>， <verse eid="1CH 1:13" /><verse number="14" style="v" sid="1CH 1:14" />接着是<char style="pn">耶布斯</char>人、<char style="pn">亚摩利</char>人、<char style="pn">革迦撒</char>人、 <verse eid="1CH 1:14" /><verse number="15" style="v" sid="1CH 1:15" /><char style="pn">希未</char>人、<char style="pn">亚基</char>人、<char style="pn">西尼</char>人、 <verse eid="1CH 1:15" /><verse number="16" style="v" sid="1CH 1:16" /><char style="pn">亚瓦底</char>人、<char style="pn">洗玛利</char>人、<char style="pn">哈马</char>人。<verse eid="1CH 1:16" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="17" style="v" sid="1CH 1:17" />
    <char style="pn">闪</char>的儿子是<char style="pn">以拦</char>、<char style="pn">亚述</char>、<char style="pn">亚法撒</char>、<char style="pn">吕底亚</char>、<char style="pn">亚兰</char>。</para>
  <para style="mi" vid="1CH 1:17">
    <char style="pn">亚兰</char>的儿子是<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">亚兰的儿子是——依据七十士译本；参《创世记》10:23。</char></note><char style="pn">乌斯</char>、<char style="pn">户勒</char>、<char style="pn">基帖</char>、<char style="pn">米设</char>。<verse eid="1CH 1:17" /></para>
  <para style="mi">
    <verse number="18" style="v" sid="1CH 1:18" />
    <char style="pn">亚法撒</char>生<char style="pn">沙拉</char>，<char style="pn">沙拉</char>生<char style="pn">希伯</char>。<verse eid="1CH 1:18" /></para>
  <para style="mi">
    <verse number="19" style="v" sid="1CH 1:19" />
    <char style="pn">希伯</char>生了两个儿子，一个名叫<char style="pn">法勒</char>，因为在他的日子里，地上的人分开了；<char style="pn">法勒</char>的兄弟名叫<char style="pn">约坍</char>。<verse eid="1CH 1:19" /></para>
  <para style="mi">
    <verse number="20" style="v" sid="1CH 1:20" />
    <char style="pn">约坍</char>生了<char style="pn">亚摩达</char>、<char style="pn">沙列</char>、<char style="pn">哈萨玛非</char>、<char style="pn">耶拉</char>、 <verse eid="1CH 1:20" /><verse number="21" style="v" sid="1CH 1:21" /><char style="pn">哈多兰</char>、<char style="pn">乌萨</char>、<char style="pn">德拉</char>、 <verse eid="1CH 1:21" /><verse number="22" style="v" sid="1CH 1:22" /><char style="pn">以巴录</char>、<char style="pn">亚比玛利</char>、<char style="pn">示巴</char>、 <verse eid="1CH 1:22" /><verse number="23" style="v" sid="1CH 1:23" /><char style="pn">俄斐</char>、<char style="pn">哈腓拉</char>、<char style="pn">约巴</char>。这些全都是<char style="pn">约坍</char>的儿子。<verse eid="1CH 1:23" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="24" style="v" sid="1CH 1:24" />
    <char style="pn">闪</char>，<char style="pn">亚法撒</char>，<char style="pn">沙拉</char>，<verse eid="1CH 1:24" /></para>
  <para style="mi">
    <verse number="25" style="v" sid="1CH 1:25" />
    <char style="pn">希伯</char>，<char style="pn">法勒</char>，<char style="pn">拉吴</char>，<verse eid="1CH 1:25" /></para>
  <para style="mi">
    <verse number="26" style="v" sid="1CH 1:26" />
    <char style="pn">西鹿</char>，<char style="pn">拿鹤</char>，<char style="pn">塔拉</char>，<verse eid="1CH 1:26" /></para>
  <para style="mi">
    <verse number="27" style="v" sid="1CH 1:27" />
    <char style="pn">亚伯兰</char>，<char style="pn">亚伯兰</char>就是<char style="pn">亚伯拉罕</char>。<verse eid="1CH 1:27" /></para>
  <para style="b" />
  <para style="s">亚伯拉罕的子孙</para>
  <para style="mi">
    <verse number="28" style="v" sid="1CH 1:28" />
    <char style="pn">亚伯拉罕</char>的儿子是<char style="pn">以撒</char>和<char style="pn">以实玛利</char>。<verse eid="1CH 1:28" /></para>
  <para style="mi">
    <verse number="29" style="v" sid="1CH 1:29" />以下是他们的家系：</para>
  <para style="mi" vid="1CH 1:29">
    <char style="pn">以实玛利</char>的长子是<char style="pn">尼拜约</char>，其次是<char style="pn">基达</char>、<char style="pn">亚德别</char>、<char style="pn">米比衫</char>、 <verse eid="1CH 1:29" /><verse number="30" style="v" sid="1CH 1:30" /><char style="pn">米施玛</char>、<char style="pn">度玛</char>、<char style="pn">玛撒</char>、<char style="pn">哈达</char>、<char style="pn">提玛</char>、 <verse eid="1CH 1:30" /><verse number="31" style="v" sid="1CH 1:31" /><char style="pn">伊突</char>、<char style="pn">拿非施</char>、<char style="pn">基底玛</char>。</para>
  <para style="mi" vid="1CH 1:31">这些是<char style="pn">以实玛利</char>的儿子。<verse eid="1CH 1:31" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="32" style="v" sid="1CH 1:32" />
    <char style="pn">亚伯拉罕</char>的妾<char style="pn">基土拉</char>所生的儿子是<char style="pn">新兰</char>、<char style="pn">约珊</char>、<char style="pn">米但</char>、<char style="pn">米甸</char>、<char style="pn">伊施巴</char>和<char style="pn">书亚</char>。</para>
  <para style="mi" vid="1CH 1:32">
    <char style="pn">约珊</char>的儿子是<char style="pn">示巴</char>和<char style="pn">底但</char>。<verse eid="1CH 1:32" /></para>
  <para style="mi">
    <verse number="33" style="v" sid="1CH 1:33" />
    <char style="pn">米甸</char>的儿子是<char style="pn">以法</char>、<char style="pn">以弗</char>、<char style="pn">哈诺</char>、<char style="pn">亚比大</char>和<char style="pn">以勒大</char>。</para>
  <para style="mi" vid="1CH 1:33">这些全都是<char style="pn">基土拉</char>的子孙。<verse eid="1CH 1:33" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="34" style="v" sid="1CH 1:34" />
    <char style="pn">亚伯拉罕</char>生了<char style="pn">以撒</char>，<char style="pn">以撒</char>的儿子是<char style="pn">以扫</char>和<char style="pn">以色列</char>。<verse eid="1CH 1:34" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="35" style="v" sid="1CH 1:35" />
    <char style="pn">以扫</char>的儿子是<char style="pn">以利法</char>、<char style="pn">流珥</char>、<char style="pn">耶乌施</char>、<char style="pn">雅兰</char>和<char style="pn">可拉</char>。<verse eid="1CH 1:35" /></para>
  <para style="mi">
    <verse number="36" style="v" sid="1CH 1:36" />
    <char style="pn">以利法</char>的儿子是<char style="pn">提幔</char>、<char style="pn">阿抹</char>、<char style="pn">洗玻</char>、<char style="pn">迦坦</char>、<char style="pn">基纳斯</char>、<char style="pn">亭纳</char>和<char style="pn">亚玛力</char>。<verse eid="1CH 1:36" /></para>
  <para style="mi">
    <verse number="37" style="v" sid="1CH 1:37" />
    <char style="pn">流珥</char>的儿子是<char style="pn">拿哈</char>、<char style="pn">谢拉</char>、<char style="pn">沙玛</char>和<char style="pn">米撒</char>。<verse eid="1CH 1:37" /></para>
  <para style="b" />
  <para style="s">以东人</para>
  <para style="mi">
    <verse number="38" style="v" sid="1CH 1:38" />
    <char style="pn">西珥</char>的儿子是<char style="pn">罗坍</char>、<char style="pn">朔巴</char>、<char style="pn">基比文</char>、<char style="pn">亚拿</char>、<char style="pn">底顺</char>、<char style="pn">以察</char>和<char style="pn">底珊</char>。<verse eid="1CH 1:38" /></para>
  <para style="mi">
    <verse number="39" style="v" sid="1CH 1:39" />
    <char style="pn">罗坍</char>的儿子是<char style="pn">何利</char>和<char style="pn">赫曼</char>，<char style="pn">罗坍</char>的妹妹是<char style="pn">亭娜</char>。<verse eid="1CH 1:39" /></para>
  <para style="mi">
    <verse number="40" style="v" sid="1CH 1:40" />
    <char style="pn">朔巴</char>的儿子是<char style="pn">亚勒文</char>、<char style="pn">玛拿哈</char>、<char style="pn">以巴录</char>、<char style="pn">示玻</char>、<char style="pn">阿南</char>。</para>
  <para style="mi" vid="1CH 1:40">
    <char style="pn">基比文</char>的儿子是<char style="pn">阿亚</char>和<char style="pn">亚拿</char>。<verse eid="1CH 1:40" /></para>
  <para style="mi">
    <verse number="41" style="v" sid="1CH 1:41" />
    <char style="pn">亚拿</char>的儿子是<char style="pn">底顺</char>。</para>
  <para style="mi" vid="1CH 1:41">
    <char style="pn">底顺</char>的儿子是<char style="pn">哈默兰</char>、<char style="pn">伊示班</char>、<char style="pn">益兰</char>和<char style="pn">基兰</char>。<verse eid="1CH 1:41" /></para>
  <para style="mi">
    <verse number="42" style="v" sid="1CH 1:42" />
    <char style="pn">以察</char>的儿子是<char style="pn">比勒罕</char>、<char style="pn">撒番</char>、<char style="pn">亚干</char>。</para>
  <para style="mi" vid="1CH 1:42">
    <char style="pn">底珊</char>的儿子是<char style="pn">乌斯</char>和<char style="pn">亚兰</char>。<verse eid="1CH 1:42" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="43" style="v" sid="1CH 1:43" />
    <char style="pn">以色列</char>子孙还没有君王统治的时候，统治<char style="pn">以东</char>地的君王如下：</para>
  <para style="mi" vid="1CH 1:43">
    <char style="pn">比珥</char>的儿子<char style="pn">比拉</char>，他的城名叫<char style="pn">亭哈巴</char>。<verse eid="1CH 1:43" /></para>
  <para style="mi">
    <verse number="44" style="v" sid="1CH 1:44" />
    <char style="pn">比拉</char>死后，<char style="pn">波斯拉</char>人<char style="pn">谢拉</char>的儿子<char style="pn">约巴</char>接替他作王。<verse eid="1CH 1:44" /></para>
  <para style="mi">
    <verse number="45" style="v" sid="1CH 1:45" />
    <char style="pn">约巴</char>死后，从<char style="pn">提幔</char>地来的<char style="pn">户珊</char>接替他作王。<verse eid="1CH 1:45" /></para>
  <para style="mi">
    <verse number="46" style="v" sid="1CH 1:46" />
    <char style="pn">户珊</char>死后，<char style="pn">比达</char>的儿子<char style="pn">哈达</char>接替他作王；</para>
  <para style="mi" vid="1CH 1:46">
    <char style="pn">哈达</char>曾在<char style="pn">摩押</char>地击败<char style="pn">米甸</char>人，他的城名叫<char style="pn">亚未得</char>。<verse eid="1CH 1:46" /></para>
  <para style="mi">
    <verse number="47" style="v" sid="1CH 1:47" />
    <char style="pn">哈达</char>死后，<char style="pn">玛士利加</char>人<char style="pn">桑拉</char>接替他作王。<verse eid="1CH 1:47" /></para>
  <para style="mi">
    <verse number="48" style="v" sid="1CH 1:48" />
    <char style="pn">桑拉</char>死后，大河<note caller="+" style="f"><char style="fr" closed="false">1:48 </char><char style="ft" closed="false">大河——指幼发拉底河。</char></note>边的<char style="pn">利河伯</char>人<char style="pn">扫罗</char>接替他作王。<verse eid="1CH 1:48" /></para>
  <para style="mi">
    <verse number="49" style="v" sid="1CH 1:49" />
    <char style="pn">扫罗</char>死后，<char style="pn">亚革波</char>的儿子<char style="pn">巴勒·哈南</char>接替他作王。<verse eid="1CH 1:49" /></para>
  <para style="mi">
    <verse number="50" style="v" sid="1CH 1:50" />
    <char style="pn">巴勒·哈南</char>死后，<char style="pn">哈达</char>接替他作王，他的城名叫<char style="pn">巴伊</char>；</para>
  <para style="mi" vid="1CH 1:50">他的妻子名叫<char style="pn">米赫塔别</char>，是<char style="pn">米·萨合</char>的孙女、<char style="pn">玛特列</char>的女儿。<verse eid="1CH 1:50" /></para>
  <para style="mi">
    <verse number="51" style="v" sid="1CH 1:51" />之后<char style="pn">哈达</char>也死了。</para>
  <para style="b" vid="1CH 1:51" />
  <para style="mi" vid="1CH 1:51">
    <char style="pn">以东</char>人的族长有：<char style="pn">亭纳</char>族长、<char style="pn">亚勒瓦</char>族长、<char style="pn">耶帖</char>族长、<verse eid="1CH 1:51" /></para>
  <para style="mi">
    <verse number="52" style="v" sid="1CH 1:52" />
    <char style="pn">阿何利巴玛</char>族长、<char style="pn">以拉</char>族长、<char style="pn">比嫩</char>族长、<verse eid="1CH 1:52" /></para>
  <para style="mi">
    <verse number="53" style="v" sid="1CH 1:53" />
    <char style="pn">基纳斯</char>族长、<char style="pn">提幔</char>族长、<char style="pn">米比萨</char>族长、<verse eid="1CH 1:53" /></para>
  <para style="mi">
    <verse number="54" style="v" sid="1CH 1:54" />
    <char style="pn">玛基叠</char>族长、<char style="pn">以兰</char>族长。</para>
  <para style="mi" vid="1CH 1:54">以上是<char style="pn">以东</char>人的各族长。<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" sid="1CH 2" />
  <para style="s">以色列众子</para>
  <para style="mi">
    <verse number="1" style="v" sid="1CH 2:1" />以下是<char style="pn">以色列</char>的众子：</para>
  <para style="mi" vid="1CH 2:1">
    <char style="pn">鲁本</char>、<char style="pn">西缅</char>、<char style="pn">利未</char>、</para>
  <para style="mi" vid="1CH 2:1">
    <char style="pn">犹大</char>、<char style="pn">以萨迦</char>、<char style="pn">西布伦</char>、<verse eid="1CH 2:1" /></para>
  <para style="mi">
    <verse number="2" style="v" sid="1CH 2:2" />
    <char style="pn">但</char>、<char style="pn">约瑟</char>、<char style="pn">便雅悯</char>、</para>
  <para style="mi" vid="1CH 2:2">
    <char style="pn">拿弗他利</char>、<char style="pn">迦得</char>和<char style="pn">亚设</char>。<verse eid="1CH 2:2" /></para>
  <para style="b" />
  <para style="s">犹大子孙</para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 2:3" />
    <char style="pn">犹大</char>的儿子是<char style="pn">珥</char>、<char style="pn">俄南</char>和<char style="pn">示拉</char>，这三人是<char style="pn">迦南</char>女子<char style="pn">芭书娅</char>给他生的。<char style="pn">犹大</char>的长子<char style="pn">珥</char>做耶和华眼中看为恶的事，耶和华就把他击杀了。 <verse eid="1CH 2:3" /><verse number="4" style="v" sid="1CH 2:4" /><char style="pn">犹大</char>的儿媳<char style="pn">塔玛尔</char>给他生了<char style="pn">法勒斯</char>和<char style="pn">谢拉</char>。<char style="pn">犹大</char>总共有五个儿子。<verse eid="1CH 2:4" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="5" style="v" sid="1CH 2:5" />
    <char style="pn">法勒斯</char>的儿子是<char style="pn">希斯伦</char>和<char style="pn">哈姆勒</char>。<verse eid="1CH 2:5" /></para>
  <para style="mi">
    <verse number="6" style="v" sid="1CH 2:6" />
    <char style="pn">谢拉</char>的儿子是<char style="pn">泽姆利</char>、<char style="pn">伊坦</char>、<char style="pn">希幔</char>、<char style="pn">卡珥克勒</char>、<char style="pn">达拉</char>，总共五人。<verse eid="1CH 2:6" /></para>
  <para style="mi">
    <verse number="7" style="v" sid="1CH 2:7" />
    <char style="pn">迦米</char>的儿子是<char style="pn">亚干</char>，他违犯了当灭之物的禁令<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">的禁令——辅助词语。</char></note>，给<char style="pn">以色列</char>带来了祸患。<verse eid="1CH 2:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="1CH 2:8" />
    <char style="pn">伊坦</char>的儿子是<char style="pn">亚撒利雅</char>。<verse eid="1CH 2:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="1CH 2:9" />
    <char style="pn">希斯伦</char>所生的儿子是<char style="pn">耶拉米列</char>、<char style="pn">兰</char>和<char style="pn">基路拜</char>。<verse eid="1CH 2:9" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="10" style="v" sid="1CH 2:10" />
    <char style="pn">兰</char>生<char style="pn">亚米拿达</char>，</para>
  <para style="mi" vid="1CH 2:10">
    <char style="pn">亚米拿达</char>生<char style="pn">犹大</char>子孙的领袖<char style="pn">拿顺</char>，<verse eid="1CH 2:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="1CH 2:11" />
    <char style="pn">拿顺</char>生<char style="pn">撒门</char><note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">撒门——或音译作“萨玛”；下同。</char></note>，</para>
  <para style="mi" vid="1CH 2:11">
    <char style="pn">撒门</char>生<char style="pn">波阿斯</char>，<verse eid="1CH 2:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="1CH 2:12" />
    <char style="pn">波阿斯</char>生<char style="pn">俄备得</char>，</para>
  <para style="mi" vid="1CH 2:12">
    <char style="pn">俄备得</char>生<char style="pn">耶西</char>。<verse eid="1CH 2:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 2:13" />
    <char style="pn">耶西</char>生了长子<char style="pn">以利押</char>，</para>
  <para style="mi" vid="1CH 2:13">次子<char style="pn">亚比拿达</char>，三子<char style="pn">示米亚</char>，<verse eid="1CH 2:13" /></para>
  <para style="mi">
    <verse number="14" style="v" sid="1CH 2:14" />四子<char style="pn">拿旦业</char>，五子<char style="pn">拉代</char>，<verse eid="1CH 2:14" /></para>
  <para style="mi">
    <verse number="15" style="v" sid="1CH 2:15" />六子<char style="pn">阿鲜</char>，七子<char style="pn">大卫</char>。<verse eid="1CH 2:15" /></para>
  <para style="mi">
    <verse number="16" style="v" sid="1CH 2:16" />他们的姐妹是<char style="pn">洗鲁雅</char>和<char style="pn">娅比盖</char>。</para>
  <para style="mi" vid="1CH 2:16">
    <char style="pn">洗鲁雅</char>的儿子是<char style="pn">亚比筛</char>、<char style="pn">约押</char>、<char style="pn">亚撒晖</char>，共三人。<verse eid="1CH 2:16" /></para>
  <para style="mi">
    <verse number="17" style="v" sid="1CH 2:17" />
    <char style="pn">娅比盖</char>生<char style="pn">亚玛撒</char>，</para>
  <para style="mi" vid="1CH 2:17">
    <char style="pn">亚玛撒</char>的父亲是<char style="pn">以实玛利</char>人<char style="pn">耶特尔</char>。<verse eid="1CH 2:17" /></para>
  <para style="mi">
    <verse number="18" style="v" sid="1CH 2:18" />
    <char style="pn">希斯伦</char>的儿子<char style="pn">迦勒</char>与妻子<char style="pn">阿苏巴</char>和<char style="pn">耶略</char>生了儿子，这些儿子是<char style="pn">耶设</char>、<char style="pn">朔罢</char>、<char style="pn">押墩</char>。 <verse eid="1CH 2:18" /><verse number="19" style="v" sid="1CH 2:19" /><char style="pn">阿苏巴</char>死后，<char style="pn">迦勒</char>又娶<char style="pn">以法她</char>，生了<char style="pn">户珥</char>。 <verse eid="1CH 2:19" /><verse number="20" style="v" sid="1CH 2:20" /><char style="pn">户珥</char>生<char style="pn">乌利</char>，<char style="pn">乌利</char>生<char style="pn">比撒列</char>。 <verse eid="1CH 2:20" /><verse number="21" style="v" sid="1CH 2:21" />后来<char style="pn">希斯伦</char>六十岁时，娶了<char style="pn">基列</char>之父<char style="pn">玛吉</char>的女儿，与她同房，她就为<char style="pn">希斯伦</char>生了<char style="pn">西割</char>。 <verse eid="1CH 2:21" /><verse number="22" style="v" sid="1CH 2:22" /><char style="pn">西割</char>生<char style="pn">睚珥</char>，<char style="pn">睚珥</char>在<char style="pn">基列</char>地拥有二十三座城； <verse eid="1CH 2:22" /><verse number="23" style="v" sid="1CH 2:23" />后来<char style="pn">基述</char>人和<char style="pn">亚兰</char>人从他们手中夺取了这些<char style="pn">睚珥</char>镇，以及<char style="pn">基纳</char>和附属的村镇，共六十座城。这些都是<char style="pn">基列</char>之父<char style="pn">玛吉</char>的子孙。 <verse eid="1CH 2:23" /><verse number="24" style="v" sid="1CH 2:24" /><char style="pn">希斯伦</char>死了以后，<char style="pn">迦勒</char>与父亲<char style="pn">希斯伦</char>的妻子<char style="pn">以法她</char>同房，她为<char style="pn">迦勒</char>生了<char style="pn">提克亚</char>之祖<char style="pn">亚施户</char>。<note caller="+" style="f"><char style="fr" closed="false">2:24 </char><char style="ft" closed="false">此节依据七十士译本；马索拉文本作“希斯伦在迦勒-以法他死了以后，希斯伦的妻子娅比雅为他生了提克亚之祖亚施户。”</char></note><verse eid="1CH 2:24" /></para>
  <para style="mi">
    <verse number="25" style="v" sid="1CH 2:25" />
    <char style="pn">希斯伦</char>长子<char style="pn">耶拉米列</char>的儿子是：长子<char style="pn">兰</char>，以及<char style="pn">布拿</char>、<char style="pn">阿连</char>、<char style="pn">阿鲜</char>和<char style="pn">亚希雅</char>。 <verse eid="1CH 2:25" /><verse number="26" style="v" sid="1CH 2:26" /><char style="pn">耶拉米列</char>又有另外一个妻子，名叫<char style="pn">娅塔拉</char>，她是<char style="pn">阿南</char>的母亲。<verse eid="1CH 2:26" /></para>
  <para style="mi">
    <verse number="27" style="v" sid="1CH 2:27" />
    <char style="pn">耶拉米列</char>长子<char style="pn">兰</char>的儿子是<char style="pn">玛斯</char>、<char style="pn">雅悯</char>和<char style="pn">以结</char>。<verse eid="1CH 2:27" /></para>
  <para style="mi">
    <verse number="28" style="v" sid="1CH 2:28" />
    <char style="pn">阿南</char>的儿子是<char style="pn">沙买</char>和<char style="pn">雅达</char>，</para>
  <para style="mi" vid="1CH 2:28">
    <char style="pn">沙买</char>的儿子是<char style="pn">纳达布</char>和<char style="pn">亚比述</char>。 <verse eid="1CH 2:28" /><verse number="29" style="v" sid="1CH 2:29" /><char style="pn">亚比述</char>的妻子名叫<char style="pn">亚比亥</char>，她为<char style="pn">亚比述</char>生了<char style="pn">阿赫班</char>和<char style="pn">莫利德</char>。<verse eid="1CH 2:29" /></para>
  <para style="mi">
    <verse number="30" style="v" sid="1CH 2:30" />
    <char style="pn">纳达布</char>的儿子是<char style="pn">塞列德</char>和<char style="pn">阿帕因</char>，<char style="pn">塞列德</char>没有儿子就死了。<verse eid="1CH 2:30" /></para>
  <para style="mi">
    <verse number="31" style="v" sid="1CH 2:31" />
    <char style="pn">阿帕因</char>的儿子是<char style="pn">伊示</char>，</para>
  <para style="mi" vid="1CH 2:31">
    <char style="pn">伊示</char>的儿子是<char style="pn">示珊</char>，</para>
  <para style="mi" vid="1CH 2:31">
    <char style="pn">示珊</char>的儿子是<char style="pn">阿赫莱</char>。<verse eid="1CH 2:31" /></para>
  <para style="mi">
    <verse number="32" style="v" sid="1CH 2:32" />
    <char style="pn">沙买</char>兄弟<char style="pn">雅达</char>的儿子是<char style="pn">耶特尔</char>和<char style="pn">约拿单</char>，<char style="pn">耶特尔</char>没有儿子就死了。<verse eid="1CH 2:32" /></para>
  <para style="mi">
    <verse number="33" style="v" sid="1CH 2:33" />
    <char style="pn">约拿单</char>的儿子是<char style="pn">比勒</char>和<char style="pn">撒萨</char>。这些都是<char style="pn">耶拉米列</char>的子孙。<verse eid="1CH 2:33" /></para>
  <para style="mi">
    <verse number="34" style="v" sid="1CH 2:34" />
    <char style="pn">示珊</char>没有儿子，只有女儿。<char style="pn">示珊</char>有一个<char style="pn">埃及</char>奴仆，名叫<char style="pn">耶哈</char>。 <verse eid="1CH 2:34" /><verse number="35" style="v" sid="1CH 2:35" /><char style="pn">示珊</char>把女儿给奴仆<char style="pn">耶哈</char>为妻，生下<char style="pn">亚泰</char>归他。<verse eid="1CH 2:35" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="36" style="v" sid="1CH 2:36" />
    <char style="pn">亚泰</char>生<char style="pn">拿单</char>，</para>
  <para style="mi" vid="1CH 2:36">
    <char style="pn">拿单</char>生<char style="pn">撒巴德</char>，<verse eid="1CH 2:36" /></para>
  <para style="mi">
    <verse number="37" style="v" sid="1CH 2:37" />
    <char style="pn">撒巴德</char>生<char style="pn">以弗拉</char>，</para>
  <para style="mi" vid="1CH 2:37">
    <char style="pn">以弗拉</char>生<char style="pn">俄备得</char>，<verse eid="1CH 2:37" /></para>
  <para style="mi">
    <verse number="38" style="v" sid="1CH 2:38" />
    <char style="pn">俄备得</char>生<char style="pn">耶户</char>，</para>
  <para style="mi" vid="1CH 2:38">
    <char style="pn">耶户</char>生<char style="pn">亚撒利雅</char>，<verse eid="1CH 2:38" /></para>
  <para style="mi">
    <verse number="39" style="v" sid="1CH 2:39" />
    <char style="pn">亚撒利雅</char>生<char style="pn">希利斯</char>，</para>
  <para style="mi" vid="1CH 2:39">
    <char style="pn">希利斯</char>生<char style="pn">以利亚萨</char>，<verse eid="1CH 2:39" /></para>
  <para style="mi">
    <verse number="40" style="v" sid="1CH 2:40" />
    <char style="pn">以利亚萨</char>生<char style="pn">西斯买</char>，</para>
  <para style="mi" vid="1CH 2:40">
    <char style="pn">西斯买</char>生<char style="pn">沙勒姆</char>，<verse eid="1CH 2:40" /></para>
  <para style="mi">
    <verse number="41" style="v" sid="1CH 2:41" />
    <char style="pn">沙勒姆</char>生<char style="pn">耶加米雅</char>，</para>
  <para style="mi" vid="1CH 2:41">
    <char style="pn">耶加米雅</char>生<char style="pn">以利沙玛</char>。<verse eid="1CH 2:41" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="42" style="v" sid="1CH 2:42" />
    <char style="pn">耶拉米列</char>兄弟<char style="pn">迦勒</char>的儿子有：</para>
  <para style="mi" vid="1CH 2:42">长子<char style="pn">米沙</char>，他是<char style="pn">西弗</char>的父亲；</para>
  <para style="mi" vid="1CH 2:42">次子<char style="pn">玛利沙</char><note caller="+" style="f"><char style="fr" closed="false">2:42 </char><char style="ft" closed="false">次子玛利沙——马索拉文本作“玛利沙的众子”。</char></note>，是<char style="pn">希伯伦</char>的父亲。<verse eid="1CH 2:42" /></para>
  <para style="mi">
    <verse number="43" style="v" sid="1CH 2:43" />
    <char style="pn">希伯伦</char>的儿子是<char style="pn">可拉</char>、<char style="pn">塔普阿</char>、<char style="pn">利肯</char>和<char style="pn">示玛</char>。<verse eid="1CH 2:43" /></para>
  <para style="mi">
    <verse number="44" style="v" sid="1CH 2:44" />
    <char style="pn">示玛</char>生了<char style="pn">约克安</char>之父<char style="pn">拉罕</char>。</para>
  <para style="mi" vid="1CH 2:44">
    <char style="pn">利肯</char>生了<char style="pn">沙买</char>。<verse eid="1CH 2:44" /></para>
  <para style="mi">
    <verse number="45" style="v" sid="1CH 2:45" />
    <char style="pn">沙买</char>的儿子是<char style="pn">玛云</char>，<char style="pn">玛云</char>是<char style="pn">伯促尔</char>的父亲。<verse eid="1CH 2:45" /></para>
  <para style="mi">
    <verse number="46" style="v" sid="1CH 2:46" />
    <char style="pn">迦勒</char>的妾<char style="pn">以法</char>生了<char style="pn">哈兰</char>、<char style="pn">莫扎</char>和<char style="pn">伽泽兹</char>，</para>
  <para style="mi" vid="1CH 2:46">
    <char style="pn">哈兰</char>生<char style="pn">伽泽兹</char>。<verse eid="1CH 2:46" /></para>
  <para style="mi">
    <verse number="47" style="v" sid="1CH 2:47" />
    <char style="pn">雅代</char>的儿子是<char style="pn">利健</char>、<char style="pn">约坦</char>、<char style="pn">基珊</char>、<char style="pn">毗力</char>、<char style="pn">以法</char>和<char style="pn">沙亚弗</char>。<verse eid="1CH 2:47" /></para>
  <para style="mi">
    <verse number="48" style="v" sid="1CH 2:48" />
    <char style="pn">迦勒</char>的妾<char style="pn">玛迦</char>生了<char style="pn">示别</char>、<char style="pn">特哈拿</char>， <verse eid="1CH 2:48" /><verse number="49" style="v" sid="1CH 2:49" />又生<char style="pn">麦玛拿</char>之父<char style="pn">沙亚弗</char>，<char style="pn">抹比拿</char>之父和<char style="pn">基比亚</char>之父<char style="pn">示法</char>。<char style="pn">迦勒</char>的女儿是<char style="pn">娅撒</char>。<verse eid="1CH 2:49" /></para>
  <para style="mi">
    <verse number="50" style="v" sid="1CH 2:50" />这些都是<char style="pn">迦勒</char>的子孙。</para>
  <para style="b" vid="1CH 2:50" />
  <para style="mi" vid="1CH 2:50">
    <char style="pn">以法她</char>的长子是<char style="pn">户珥</char>，<char style="pn">户珥</char>的儿子是：</para>
  <para style="mi" vid="1CH 2:50">
    <char style="pn">基列-耶琳</char>之祖<char style="pn">朔巴</char>、<verse eid="1CH 2:50" /></para>
  <para style="mi">
    <verse number="51" style="v" sid="1CH 2:51" />
    <char style="pn">伯利恒</char>之祖<char style="pn">撒门</char>、</para>
  <para style="mi" vid="1CH 2:51">
    <char style="pn">伯迦德</char>之祖<char style="pn">哈勒</char>。<verse eid="1CH 2:51" /></para>
  <para style="mi">
    <verse number="52" style="v" sid="1CH 2:52" />
    <char style="pn">基列-耶琳</char>之祖<char style="pn">朔巴</char>的子孙是<char style="pn">哈罗耶</char>，一半的<char style="pn">玛拿哈</char>人， <verse eid="1CH 2:52" /><verse number="53" style="v" sid="1CH 2:53" />以及<char style="pn">基列-耶琳</char>的各家族<char style="pn">以帖</char>人、<char style="pn">布特</char>人、<char style="pn">舒玛</char>人和<char style="pn">米示拉</char>人；<char style="pn">佐拉</char>人和<char style="pn">以实陶</char>人也来源于这些家族。<verse eid="1CH 2:53" /></para>
  <para style="mi">
    <verse number="54" style="v" sid="1CH 2:54" />
    <char style="pn">撒门</char>的子孙是<char style="pn">伯利恒</char>人、<char style="pn">尼托法</char>人、<char style="pn">阿塔罗-伯约押</char>人、一半的<char style="pn">玛拿哈</char>人、<char style="pn">佐拉</char>人； <verse eid="1CH 2:54" /><verse number="55" style="v" sid="1CH 2:55" />还有住在<char style="pn">雅比斯</char>的文士家族：<char style="pn">特拉</char>人、<char style="pn">示米押</char>人和<char style="pn">苏甲</char>人。他们都是<char style="pn">基尼</char>人，是<char style="pn">利甲</char>家的族长<char style="pn">哈末</char>的后人。<verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" sid="1CH 3" />
  <para style="s">大卫的儿女</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 3:1" />以下是<char style="pn">大卫</char>在<char style="pn">希伯仑</char>所生的儿子：</para>
  <para style="mi" vid="1CH 3:1">长子<char style="pn">暗嫩</char>，由<char style="pn">耶斯列</char>人<char style="pn">娅希暖</char>所生；</para>
  <para style="mi" vid="1CH 3:1">次子<char style="pn">但以理</char>，由<char style="pn">迦密</char>人<char style="pn">娅比盖</char>所生；<verse eid="1CH 3:1" /></para>
  <para style="mi">
    <verse number="2" style="v" sid="1CH 3:2" />三子<char style="pn">押沙龙</char>，由<char style="pn">基述</char>王<char style="pn">塔尔迈</char>的女儿<char style="pn">玛迦</char>所生；</para>
  <para style="mi" vid="1CH 3:2">四子<char style="pn">亚多尼雅</char>，是<char style="pn">哈及</char>的儿子；<verse eid="1CH 3:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 3:3" />五子<char style="pn">示法提雅</char>，由<char style="pn">亚比塔</char>所生；</para>
  <para style="mi" vid="1CH 3:3">六子<char style="pn">以特念</char>，由<char style="pn">大卫</char>的妻子<char style="pn">以格拉</char>所生。<verse eid="1CH 3:3" /></para>
  <para style="mi">
    <verse number="4" style="v" sid="1CH 3:4" />六个都是他在<char style="pn">希伯仑</char>所生的，他在那里统治了七年零六个月。</para>
  <para style="mi" vid="1CH 3:4">他在<char style="pn">耶路撒冷</char>统治了三十三年， <verse eid="1CH 3:4" /><verse number="5" style="v" sid="1CH 3:5" />以下是他在<char style="pn">耶路撒冷</char>所生的：</para>
  <para style="mi" vid="1CH 3:5">
    <char style="pn">示米亚</char>、<char style="pn">朔罢</char>、<char style="pn">拿单</char>和<char style="pn">所罗门</char>，这四人由<char style="pn">亚米利</char>的女儿<char style="pn">芭书娅</char>所生；<verse eid="1CH 3:5" /></para>
  <para style="mi">
    <verse number="6" style="v" sid="1CH 3:6" />还有<char style="pn">益辖</char>、<char style="pn">以利沙玛</char>、<char style="pn">以利菲列</char>、 <verse eid="1CH 3:6" /><verse number="7" style="v" sid="1CH 3:7" /><char style="pn">挪迦</char>、<char style="pn">尼斐</char>、<char style="pn">雅非亚</char>、 <verse eid="1CH 3:7" /><verse number="8" style="v" sid="1CH 3:8" /><char style="pn">以利沙玛</char>、<char style="pn">以利雅大</char>和<char style="pn">以利菲列</char>，共九人。<verse eid="1CH 3:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="1CH 3:9" />这都是<char style="pn">大卫</char>的儿子，此外还有妃嫔们所生的儿子，以及他们的妹妹<char style="pn">塔玛尔</char>。<verse eid="1CH 3:9" /></para>
  <para style="b" />
  <para style="s">犹大列王</para>
  <para style="mi">
    <verse number="10" style="v" sid="1CH 3:10" />
    <char style="pn">所罗门</char>的儿子是<char style="pn">罗波安</char>，</para>
  <para style="mi" vid="1CH 3:10">
    <char style="pn">罗波安</char>的儿子是<char style="pn">亚比雅</char>，</para>
  <para style="mi" vid="1CH 3:10">
    <char style="pn">亚比雅</char>的儿子是<char style="pn">亚撒</char>，</para>
  <para style="mi" vid="1CH 3:10">
    <char style="pn">亚撒</char>的儿子是<char style="pn">约沙法</char>，<verse eid="1CH 3:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="1CH 3:11" />
    <char style="pn">约沙法</char>的儿子是<char style="pn">约兰</char>，</para>
  <para style="mi" vid="1CH 3:11">
    <char style="pn">约兰</char>的儿子是<char style="pn">亚哈谢</char>，</para>
  <para style="mi" vid="1CH 3:11">
    <char style="pn">亚哈谢</char>的儿子是<char style="pn">约阿施</char>，<verse eid="1CH 3:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="1CH 3:12" />
    <char style="pn">约阿施</char>的儿子是<char style="pn">亚玛谢</char>，</para>
  <para style="mi" vid="1CH 3:12">
    <char style="pn">亚玛谢</char>的儿子是<char style="pn">亚撒利雅</char><note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">亚撒利雅——又称“乌西雅”；见《历代志下》26:1。</char></note>，</para>
  <para style="mi" vid="1CH 3:12">
    <char style="pn">亚撒利雅</char>的儿子是<char style="pn">约坦</char>，<verse eid="1CH 3:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 3:13" />
    <char style="pn">约坦</char>的儿子是<char style="pn">亚哈斯</char>，</para>
  <para style="mi" vid="1CH 3:13">
    <char style="pn">亚哈斯</char>的儿子是<char style="pn">希西加</char>，</para>
  <para style="mi" vid="1CH 3:13">
    <char style="pn">希西加</char>的儿子是<char style="pn">玛拿西</char>，<verse eid="1CH 3:13" /></para>
  <para style="mi">
    <verse number="14" style="v" sid="1CH 3:14" />
    <char style="pn">玛拿西</char>的儿子是<char style="pn">亚门</char>，</para>
  <para style="mi" vid="1CH 3:14">
    <char style="pn">亚门</char>的儿子是<char style="pn">约西亚</char>。<verse eid="1CH 3:14" /></para>
  <para style="mi">
    <verse number="15" style="v" sid="1CH 3:15" />
    <char style="pn">约西亚</char>的儿子是</para>
  <para style="mi" vid="1CH 3:15">长子<char style="pn">约哈南</char>，次子<char style="pn">约雅敬</char>，</para>
  <para style="mi" vid="1CH 3:15">三子<char style="pn">西底加</char>，四子<char style="pn">沙勒姆</char>。<verse eid="1CH 3:15" /></para>
  <para style="mi">
    <verse number="16" style="v" sid="1CH 3:16" />
    <char style="pn">约雅敬</char>的儿子是<char style="pn">耶哥尼雅</char>和<char style="pn">西底加</char>。<verse eid="1CH 3:16" /></para>
  <para style="b" />
  <para style="s">流亡期间的王室</para>
  <para style="mi">
    <verse number="17" style="v" sid="1CH 3:17" />被掳之人<char style="pn">耶哥尼雅</char>的子孙是：他的儿子<char style="pn">撒拉铁</char>， <verse eid="1CH 3:17" /><verse number="18" style="v" sid="1CH 3:18" />以及<char style="pn">玛基兰</char>、<char style="pn">皮达雅</char>、<char style="pn">示拿萨</char>、<char style="pn">耶加米雅</char>、<char style="pn">赫沙玛</char>和<char style="pn">尼达比雅</char>。<verse eid="1CH 3:18" /></para>
  <para style="mi">
    <verse number="19" style="v" sid="1CH 3:19" />
    <char style="pn">皮达雅</char>的子孙是：<char style="pn">所罗巴伯</char>和<char style="pn">示每</char>，<char style="pn">所罗巴伯</char>的儿子<char style="pn">米书兰</char>、<char style="pn">哈纳尼雅</char>，还有他们的妹妹<char style="pn">示罗米</char>， <verse eid="1CH 3:19" /><verse number="20" style="v" sid="1CH 3:20" />以及<char style="pn">哈舒巴</char>、<char style="pn">欧黑尔</char>、<char style="pn">比利迦</char>、<char style="pn">哈撒迪亚</char>和<char style="pn">犹沙赫瑟</char>五人。<verse eid="1CH 3:20" /></para>
  <para style="mi">
    <verse number="21" style="v" sid="1CH 3:21" />
    <char style="pn">哈纳尼雅</char>的子孙是：<char style="pn">皮拉提</char>、<char style="pn">耶赛亚</char>，以及<char style="pn">勒法雅</char>的众子，<char style="pn">亚珥楠</char>的众子，<char style="pn">俄巴底亚</char>的众子，<char style="pn">谢喀尼亚</char>的众子。<verse eid="1CH 3:21" /></para>
  <para style="mi">
    <verse number="22" style="v" sid="1CH 3:22" />
    <char style="pn">谢喀尼亚</char>的子孙是：<char style="pn">示玛雅</char>，<char style="pn">示玛雅</char>的儿子<char style="pn">哈突施</char>、<char style="pn">以甲</char>、<char style="pn">巴利亚</char>、<char style="pn">尼利雅</char>和<char style="pn">沙法</char>，共六人。<verse eid="1CH 3:22" /></para>
  <para style="mi">
    <verse number="23" style="v" sid="1CH 3:23" />
    <char style="pn">尼利雅</char>的子孙是：<char style="pn">以利约奈</char>、<char style="pn">希西加</char>和<char style="pn">亚斯利甘</char>，共三人。<verse eid="1CH 3:23" /></para>
  <para style="mi">
    <verse number="24" style="v" sid="1CH 3:24" />
    <char style="pn">以利约奈</char>的子孙是：<char style="pn">赫达耶瓦</char>、<char style="pn">以利亚实</char>、<char style="pn">佩拉雅</char>、<char style="pn">阿库布</char>、<char style="pn">约哈南</char>、<char style="pn">德拉雅</char>和<char style="pn">阿纳尼</char>，共七人。<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" sid="1CH 4" />
  <para style="s">犹大子孙</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 4:1" />
    <char style="pn">犹大</char>的子孙是<char style="pn">法勒斯</char>、<char style="pn">希斯伦</char>、<char style="pn">迦米</char>、<char style="pn">户珥</char>和<char style="pn">朔巴</char>。<verse eid="1CH 4:1" /></para>
  <para style="mi">
    <verse number="2" style="v" sid="1CH 4:2" />
    <char style="pn">朔巴</char>的儿子<char style="pn">利阿亚</char>生<char style="pn">雅哈</char>，</para>
  <para style="mi" vid="1CH 4:2">
    <char style="pn">雅哈</char>生<char style="pn">亚户买</char>和<char style="pn">拉哈</char>；</para>
  <para style="mi" vid="1CH 4:2">这些是<char style="pn">佐拉</char>人的各家族。<verse eid="1CH 4:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 4:3" />
    <char style="pn">以坦</char>人之祖如下：<char style="pn">耶斯列</char>、<char style="pn">伊施玛</char>、<char style="pn">伊得巴</char>，他们的妹妹名字是<char style="pn">哈慈勒珀妮</char>；<verse eid="1CH 4:3" /></para>
  <para style="mi">
    <verse number="4" style="v" sid="1CH 4:4" />
    <char style="pn">毗努伊勒</char>是<char style="pn">格多</char>的父亲；</para>
  <para style="mi" vid="1CH 4:4">
    <char style="pn">以谢尔</char>是<char style="pn">户沙</char>的父亲；</para>
  <para style="mi" vid="1CH 4:4">这些都是<char style="pn">伯利恒</char>之祖<char style="pn">户珥</char>的子孙。<char style="pn">户珥</char>是<char style="pn">以法她</char>的长子。<verse eid="1CH 4:4" /></para>
  <para style="mi">
    <verse number="5" style="v" sid="1CH 4:5" />
    <char style="pn">提克亚</char>人之祖<char style="pn">亚施户</char>有两个妻子：<char style="pn">赫拉</char>和<char style="pn">拿拉</char>。 <verse eid="1CH 4:5" /><verse number="6" style="v" sid="1CH 4:6" /><char style="pn">拿拉</char>生了<char style="pn">亚户撒</char>、<char style="pn">希弗</char>、<char style="pn">提米尼</char>、<char style="pn">阿哈示塔利</char>，这些都是<char style="pn">拿拉</char>的儿子。<verse eid="1CH 4:6" /></para>
  <para style="mi">
    <verse number="7" style="v" sid="1CH 4:7" />
    <char style="pn">赫拉</char>的儿子是<char style="pn">洗列</char>、<char style="pn">琐哈尔</char>和<char style="pn">伊提南</char>。<verse eid="1CH 4:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="1CH 4:8" />
    <char style="pn">克兹</char>生了<char style="pn">阿诺布</char>、<char style="pn">措比巴</char>，以及<char style="pn">哈仑</char>之子<char style="pn">阿哈黑尔</char>的各家族。<verse eid="1CH 4:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9" />
    <char style="pn">雅比斯</char>比他的兄弟们更有尊荣。他母亲给他起名为<char style="pn">雅比斯</char>，说：“我在痛苦中生的。”<verse eid="1CH 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 4:10" />
    <char style="pn">雅比斯</char>呼求<char style="pn">以色列</char>的神说：“但愿你大大祝福我，扩大我的边界！愿你的手与我同在，愿你使我脱离祸患，不受伤害！”神成全了他的祈求。<verse eid="1CH 4:10" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="11" style="v" sid="1CH 4:11" />
    <char style="pn">书哈</char>的兄弟<char style="pn">基律</char>生了<char style="pn">伊施屯</char>之父<char style="pn">米希尔</char>。<verse eid="1CH 4:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="1CH 4:12" />
    <char style="pn">伊施屯</char>生了<char style="pn">伯拉法</char>、<char style="pn">帕西亚</char>，以及<char style="pn">纳哈什</char>城<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="ft" closed="false">纳哈什城——或译作“珥-纳哈什”。</char></note>之祖<char style="pn">提欣纳</char>；这些就是<char style="pn">利迦</char>人。<verse eid="1CH 4:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 4:13" />
    <char style="pn">基纳斯</char>的儿子是<char style="pn">俄陀聂</char>和<char style="pn">西莱雅</char>。</para>
  <para style="mi" vid="1CH 4:13">
    <char style="pn">俄陀聂</char>的儿子是<char style="pn">哈塔</char>、 <verse eid="1CH 4:13" /><verse number="14" style="v" sid="1CH 4:14" /><char style="pn">梅诺泰</char>，<char style="pn">梅诺泰</char>生了<char style="pn">俄弗拉</char>。</para>
  <para style="mi" vid="1CH 4:14">
    <char style="pn">西莱雅</char>生了<char style="pn">哈拉欣</char>谷<note caller="+" style="f"><char style="fr" closed="false">4:14 </char><char style="ft" closed="false">哈拉欣谷——或译作“格哈拉欣人”、“匠人谷”。</char></note>之祖<char style="pn">约押</char>，他们都是工匠。<verse eid="1CH 4:14" /></para>
  <para style="mi">
    <verse number="15" style="v" sid="1CH 4:15" />
    <char style="pn">耶弗尼</char>之子<char style="pn">迦勒</char>的子孙是<char style="pn">以路</char>、<char style="pn">以拉</char>和<char style="pn">拿安</char>，<char style="pn">以拉</char>的儿子是<char style="pn">基纳斯</char>。<verse eid="1CH 4:15" /></para>
  <para style="mi">
    <verse number="16" style="v" sid="1CH 4:16" />
    <char style="pn">耶哈利勒</char>的儿子是<char style="pn">西弗</char>、<char style="pn">西法</char>、<char style="pn">提利</char>和<char style="pn">亚撒列</char>。<verse eid="1CH 4:16" /></para>
  <para style="mi">
    <verse number="17-18" style="v" sid="1CH 4:17-18" />
    <char style="pn">以斯拉</char>的儿子是<char style="pn">耶特尔</char>、<char style="pn">米列</char>、<char style="pn">以弗</char>和<char style="pn">雅伦</char>。<char style="pn">米列</char>所娶法老的女儿<char style="pn">比提娅</char>生了<char style="pn">米利暗</char>、<char style="pn">沙买</char>和<char style="pn">以实提莫</char>之祖<char style="pn">益巴</char>，这些是<char style="pn">比提娅</char>的儿子；<char style="pn">米列</char>的<char style="pn">犹大</char>妻子生了<char style="pn">格多</char>之祖<char style="pn">雅列</char>，<char style="pn">梭哥</char>之祖<char style="pn">希伯</char>和<char style="pn">撒挪亚</char>之祖<char style="pn">耶库蒂尔</char>。 <verse eid="1CH 4:17-18" /><verse number="19" style="v" sid="1CH 4:19" /><char style="pn">霍迪亚</char>的妻子是<char style="pn">娜娢</char>的姐妹，她的儿子是<char style="pn">迦米</char>人<char style="pn">基伊拉</char>之祖，以及<char style="pn">玛迦</char>人<char style="pn">以实提莫</char>之祖。<verse eid="1CH 4:19" /></para>
  <para style="mi">
    <verse number="20" style="v" sid="1CH 4:20" />
    <char style="pn">示门</char>的儿子是<char style="pn">暗嫩</char>、<char style="pn">林拿</char>、<char style="pn">本哈南</char>和<char style="pn">提伦</char>。</para>
  <para style="mi" vid="1CH 4:20">
    <char style="pn">伊示</char>的子孙是<char style="pn">泽赫特</char>和<char style="pn">便泽赫特</char>。<verse eid="1CH 4:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="1CH 4:21" />
    <char style="pn">犹大</char>的儿子<char style="pn">示拉</char>的子孙是：<char style="pn">利迦</char>之祖<char style="pn">珥</char>，<char style="pn">玛利沙</char>之祖<char style="pn">拉阿达</char>，在<char style="pn">伯亚实比</char>织造细麻布的各家族。 <verse eid="1CH 4:21" /><verse number="22" style="v" sid="1CH 4:22" />还有<char style="pn">约敬</char>，<char style="pn">克则巴</char>人，在<char style="pn">摩押</char>作了主人的<char style="pn">约阿施</char>和<char style="pn">萨拉</char>，以及<char style="pn">雅叔比利恒</char>，这些是古代的记录。 <verse eid="1CH 4:22" /><verse number="23" style="v" sid="1CH 4:23" />他们都是陶匠，是<char style="pn">尼塔因</char>和<char style="pn">格德拉</char>的居民，他们住在那里为王工作。<verse eid="1CH 4:23" /></para>
  <para style="b" />
  <para style="s">西缅子孙</para>
  <para style="mi">
    <verse number="24" style="v" sid="1CH 4:24" />
    <char style="pn">西缅</char>的子孙是<char style="pn">尼姆利</char>、<char style="pn">雅悯</char>、<char style="pn">雅立</char>、<char style="pn">谢拉</char>和<char style="pn">扫罗</char>；<verse eid="1CH 4:24" /></para>
  <para style="mi">
    <verse number="25" style="v" sid="1CH 4:25" />
    <char style="pn">扫罗</char>的儿子<char style="pn">沙勒姆</char>，<char style="pn">沙勒姆</char>的儿子<char style="pn">米比衫</char>，<char style="pn">米比衫</char>的儿子<char style="pn">米施玛</char>。<verse eid="1CH 4:25" /></para>
  <para style="mi">
    <verse number="26" style="v" sid="1CH 4:26" />
    <char style="pn">米施玛</char>的子孙是<char style="pn">米施玛</char>的儿子<char style="pn">哈姆列</char>，<char style="pn">哈姆列</char>的儿子<char style="pn">扎克尔</char>，<char style="pn">扎克尔</char>的儿子<char style="pn">示每</char>。<verse eid="1CH 4:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27" />
    <char style="pn">示每</char>有十六个儿子，六个女儿，但他兄弟们的儿女不多，他们整个家族也不如<char style="pn">犹大</char>的子孙那样众多。 <verse eid="1CH 4:27" /><verse number="28" style="v" sid="1CH 4:28" />他们住在<char style="pn">比尔-谢巴</char>、<char style="pn">莫拉达</char>、<char style="pn">哈萨书尔</char>、 <verse eid="1CH 4:28" /><verse number="29" style="v" sid="1CH 4:29" /><char style="pn">碧拉</char>、<char style="pn">埃曾</char>、<char style="pn">托拉德</char>、 <verse eid="1CH 4:29" /><verse number="30" style="v" sid="1CH 4:30" /><char style="pn">彼土利</char>、<char style="pn">霍尔玛</char>、<char style="pn">洗革拉</char>、 <verse eid="1CH 4:30" /><verse number="31" style="v" sid="1CH 4:31" /><char style="pn">伯玛克波</char>、<char style="pn">哈萨苏撒</char>、<char style="pn">伯比利</char>和<char style="pn">沙拉音</char>。直到<char style="pn">大卫</char>作王，这些都是他们的城， <verse eid="1CH 4:31" /><verse number="32" style="v" sid="1CH 4:32" />包括附属的村庄；还有<char style="pn">以坦</char>、<char style="pn">阿音</char>、<char style="pn">临门</char>、<char style="pn">托肯</char>和<char style="pn">阿珊</char>五座城， <verse eid="1CH 4:32" /><verse number="33" style="v" sid="1CH 4:33" />以及这些城周围所有的村庄，直到<char style="pn">巴力</char><note caller="+" style="f"><char style="fr" closed="false">4:33 </char><char style="ft" closed="false">巴力——或译作“巴阿拉”；参《约书亚记》19:8。</char></note>；这些是他们居住的地方。他们也为自己记录家谱：<verse eid="1CH 4:33" /></para>
  <para style="mi">
    <verse number="34" style="v" sid="1CH 4:34" />有<char style="pn">米所巴</char>、<char style="pn">雅米勒</char>、<char style="pn">亚玛谢</char>的儿子<char style="pn">约沙</char>、 <verse eid="1CH 4:34" /><verse number="35" style="v" sid="1CH 4:35" /><char style="pn">约珥</char>、<char style="pn">耶户</char>；<char style="pn">耶户</char>是<char style="pn">约示比</char>的儿子，<char style="pn">约示比</char>是<char style="pn">西莱雅</char>的儿子，<char style="pn">西莱雅</char>是<char style="pn">阿希业</char>的儿子。<verse eid="1CH 4:35" /></para>
  <para style="mi">
    <verse number="36" style="v" sid="1CH 4:36" />还有<char style="pn">以利约奈</char>、<char style="pn">雅格巴</char>、<char style="pn">约朔海</char>、<char style="pn">亚撒雅</char>、<char style="pn">亚迪业</char>、<char style="pn">耶西玛利</char>、<char style="pn">比纳雅</char>、 <verse eid="1CH 4:36" /><verse number="37" style="v" sid="1CH 4:37" /><char style="pn">细撒</char>；<char style="pn">细撒</char>是<char style="pn">示非</char>的儿子，<char style="pn">示非</char>是<char style="pn">亚龙</char>的儿子，<char style="pn">亚龙</char>是<char style="pn">耶达雅</char>的儿子，<char style="pn">耶达雅</char>是<char style="pn">示姆利</char>的儿子，<char style="pn">示姆利</char>是<char style="pn">示玛雅</char>的儿子。<verse eid="1CH 4:37" /></para>
  <para style="b" />
  <para style="p">
    <verse number="38" style="v" sid="1CH 4:38" />这些按名字记下来的，都是他们各家族的领袖；他们的父家繁衍众多。 <verse eid="1CH 4:38" /><verse number="39" style="v" sid="1CH 4:39" />他们往<char style="pn">格多</char>的路口去，直到山谷东边，为自己的羊群寻找草场。 <verse eid="1CH 4:39" /><verse number="40" style="v" sid="1CH 4:40" />他们找到了肥沃美好的草场，那地也边界宽广，平静安稳，从前住在那里的是<char style="pn">含</char>族的人。<verse eid="1CH 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41" />这些按名字记下来的人，在<char style="pn">犹大</char>王<char style="pn">希西加</char>年间前来，攻击<char style="pn">含</char>族人的帐篷和在那里遇见的<char style="pn">米乌尼</char>人，把他们灭绝净尽，直到今日；又取代他们住在那里，因为有草场可以牧放他们的羊群。 <verse eid="1CH 4:41" /><verse number="42" style="v" sid="1CH 4:42" />这些<char style="pn">西缅</char>子孙当中，有五百人往<char style="pn">西珥</char>山去，他们的首领是<char style="pn">伊示</char>的众子<char style="pn">皮拉提</char>、<char style="pn">尼利雅</char>、<char style="pn">勒法雅</char>和<char style="pn">乌基业</char>。 <verse eid="1CH 4:42" /><verse number="43" style="v" sid="1CH 4:43" />他们击杀了<char style="pn">亚玛力</char>人中逃脱的余剩者，就住在那里，直到今日。<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" sid="1CH 5" />
  <para style="s">鲁本子孙</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 5:1" />以下是<char style="pn">以色列</char>的长子<char style="pn">鲁本</char>的子孙。<char style="pn">鲁本</char>虽然是长子，但他玷污了父亲的床榻，他的长子名份就被转给<char style="pn">以色列</char>之子<char style="pn">约瑟</char>的两个儿子，所以在家谱记录中没有长子名份。 <verse eid="1CH 5:1" /><verse number="2" style="v" sid="1CH 5:2" /><char style="pn">犹大</char>虽然在他兄弟们中强盛，领袖也是从他而出，但长子名份是属于<char style="pn">约瑟</char>的。<verse eid="1CH 5:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 5:3" />
    <char style="pn">以色列</char>长子<char style="pn">鲁本</char>的儿子是</para>
  <para style="mi" vid="1CH 5:3">
    <char style="pn">哈诺</char>、<char style="pn">法路</char>、<char style="pn">希斯伦</char>和<char style="pn">迦米</char>。<verse eid="1CH 5:3" /></para>
  <para style="mi">
    <verse number="4" style="v" sid="1CH 5:4" />
    <char style="pn">约珥</char>的子孙是：他的儿子<char style="pn">示玛雅</char>，</para>
  <para style="mi" vid="1CH 5:4">
    <char style="pn">示玛雅</char>的儿子<char style="pn">歌革</char>，<char style="pn">歌革</char>的儿子<char style="pn">示每</char>，<verse eid="1CH 5:4" /></para>
  <para style="mi">
    <verse number="5" style="v" sid="1CH 5:5" />
    <char style="pn">示每</char>的儿子<char style="pn">米迦</char>，<char style="pn">米迦</char>的儿子<char style="pn">利阿亚</char>，</para>
  <para style="mi" vid="1CH 5:5">
    <char style="pn">利阿亚</char>的儿子<char style="pn">巴力</char>， <verse eid="1CH 5:5" /><verse number="6" style="v" sid="1CH 5:6" /><char style="pn">巴力</char>的儿子<char style="pn">备拉</char>。</para>
  <para style="b" vid="1CH 5:6" />
  <para style="p" vid="1CH 5:6">
    <char style="pn">备拉</char>被<char style="pn">亚述</char>王<char style="pn">提革拉·毗列色</char>掳走了，他是<char style="pn">鲁本</char>支派的领袖。 <verse eid="1CH 5:6" /><verse number="7" style="v" sid="1CH 5:7" /><char style="pn">备拉</char>的族兄弟，按着自己的家族，照着他们的家系记录，有首领<char style="pn">耶伊列</char>、<char style="pn">撒迦利亚</char>、 <verse eid="1CH 5:7" /><verse number="8" style="v" sid="1CH 5:8" /><char style="pn">比拉</char>；<char style="pn">比拉</char>是<char style="pn">亚撒</char>的儿子，<char style="pn">亚撒</char>是<char style="pn">示玛</char>的儿子，<char style="pn">示玛</char>是<char style="pn">约珥</char>的儿子。<char style="pn">约珥</char>住在<char style="pn">亚罗珥</char>，直到<char style="pn">尼波</char>和<char style="pn">巴力梅翁</char>一带； <verse eid="1CH 5:8" /><verse number="9" style="v" sid="1CH 5:9" />他又到东边居住，一直到<char style="pn">幼发拉底</char>河这边旷野的入口，因为他们在<char style="pn">基列</char>地的牲畜增多了。 <verse eid="1CH 5:9" /><verse number="10" style="v" sid="1CH 5:10" /><char style="pn">扫罗</char>年间，他们与<char style="pn">哈格利</char>人作战，<char style="pn">哈格利</char>人败在他们手下，他们就住在<char style="pn">基列</char>东边全域<char style="pn">哈格利</char>人的帐篷中。<verse eid="1CH 5:10" /></para>
  <para style="b" />
  <para style="s">迦得子孙</para>
  <para style="mi">
    <verse number="11" style="v" sid="1CH 5:11" />
    <char style="pn">迦得</char>的子孙在他们对面，住在<char style="pn">巴珊</char>地，直到<char style="pn">撒迦</char>。<verse eid="1CH 5:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="1CH 5:12" />他们有首领<char style="pn">约珥</char>，副首领<char style="pn">沙番</char>，还有<char style="pn">雅奈</char>和住在<char style="pn">巴珊</char>的<char style="pn">沙法</char>。<verse eid="1CH 5:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 5:13" />按着他们的父家，他们的族兄弟是<char style="pn">米迦勒</char>、<char style="pn">米书兰</char>、<char style="pn">示巴</char>、<char style="pn">约赖</char>、<char style="pn">雅干</char>、<char style="pn">细亚</char>和<char style="pn">希伯</char>，共七人。<verse eid="1CH 5:13" /></para>
  <para style="mi">
    <verse number="14" style="v" sid="1CH 5:14" />这些都是<char style="pn">亚比亥</char>的子孙；<char style="pn">亚比亥</char>是<char style="pn">户利</char>的儿子，</para>
  <para style="mi" vid="1CH 5:14">
    <char style="pn">户利</char>是<char style="pn">耶罗亚</char>的儿子，<char style="pn">耶罗亚</char>是<char style="pn">基列</char>的儿子，</para>
  <para style="mi" vid="1CH 5:14">
    <char style="pn">基列</char>是<char style="pn">米迦勒</char>的儿子，<char style="pn">米迦勒</char>是<char style="pn">耶示筛</char>的儿子，</para>
  <para style="mi" vid="1CH 5:14">
    <char style="pn">耶示筛</char>是<char style="pn">耶哈多</char>的儿子，<char style="pn">耶哈多</char>是<char style="pn">布斯</char>的儿子。<verse eid="1CH 5:14" /></para>
  <para style="mi">
    <verse number="15" style="v" sid="1CH 5:15" />
    <char style="pn">古尼</char>的孙子、<char style="pn">押比叠</char>的儿子<char style="pn">亚希</char>，是他们父家的首领。 <verse eid="1CH 5:15" /><verse number="16" style="v" sid="1CH 5:16" />他们住在<char style="pn">基列</char>、<char style="pn">巴珊</char>和附属的村镇，以及整个<char style="pn">沙仑</char>牧野，直到它的尽头。 <verse eid="1CH 5:16" /><verse number="17" style="v" sid="1CH 5:17" />他们全都在<char style="pn">犹大</char>王<char style="pn">约坦</char>年间和<char style="pn">以色列</char>王<char style="pn">耶罗波安</char>年间，被记录在家谱中。<verse eid="1CH 5:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18" />
    <char style="pn">鲁本</char>、<char style="pn">迦得</char>和<char style="pn">玛拿西</char>半支派的勇士，那些拿盾牌刀剑、拉弓射箭、受过作战训练的，有四万四千七百六十人，都能列队出战。 <verse eid="1CH 5:18" /><verse number="19" style="v" sid="1CH 5:19" />他们与<char style="pn">哈格利</char>人、<char style="pn">伊突</char>人、<char style="pn">拿非施</char>人和<char style="pn">挪达</char>人作战。 <verse eid="1CH 5:19" /><verse number="20" style="v" sid="1CH 5:20" />他们得到帮助，<char style="pn">哈格利</char>人和所有与<char style="pn">哈格利</char>人同盟的人都被交在他们手中，因为他们在战争中向神哀求，神就因为他们信靠他而应允了他们的祈求。 <verse eid="1CH 5:20" /><verse number="21" style="v" sid="1CH 5:21" />他们掳掠了<char style="pn">夏甲</char>人的牲畜，有骆驼五万头、羊二十五万只、驴子两千只；还掳掠了人口十万。 <verse eid="1CH 5:21" /><verse number="22" style="v" sid="1CH 5:22" />有许多<char style="pn">夏甲</char>人被杀倒下，因为这场战争是出于神。他们就取代<char style="pn">夏甲</char>人住下，直到被掳时期。<verse eid="1CH 5:22" /></para>
  <para style="s">玛拿西半支派</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23" />
    <char style="pn">玛拿西</char>半支派的子孙住在那地，从<char style="pn">巴珊</char>直到<char style="pn">巴力黑门</char>、<char style="pn">示尼珥</char>和<char style="pn">黑门</char>山；他们人数众多。 <verse eid="1CH 5:23" /><verse number="24" style="v" sid="1CH 5:24" />以下是他们父家的首领：<char style="pn">以弗</char>、<char style="pn">伊示</char>、<char style="pn">以利业</char>、<char style="pn">亚斯列</char>、<char style="pn">耶利米</char>、<char style="pn">赫达维亚</char>、<char style="pn">耶赫迪业</char>，都是英勇的战士、有名望的人，是他们父家的首领。 <verse eid="1CH 5:24" /><verse number="25" style="v" sid="1CH 5:25" />但他们对祖先的神不忠，行淫追随当地之民的神明，这民是神从他们面前所除灭的。 <verse eid="1CH 5:25" /><verse number="26" style="v" sid="1CH 5:26" />所以，<char style="pn">以色列</char>的神触动了<char style="pn">亚述</char>王<char style="pn">普勒</char>——<char style="pn">亚述</char>王<char style="pn">提革拉·毗列色</char>的心，他就把<char style="pn">鲁本</char>支派、<char style="pn">迦得</char>支派和<char style="pn">玛拿西</char>半支派的人掳走，带到了<char style="pn">哈腊</char>、<char style="pn">哈博</char>、<char style="pn">哈拉</char>，以及<char style="pn">歌散</char>河边，直到今日。<verse eid="1CH 5:26" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" sid="1CH 6" />
  <para style="s">利未人</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 6:1" />
    <note caller="+" style="f">
      <char style="fr" closed="false">6:1 </char>
      <char style="ft" closed="false">此章在马索拉文本为5:27至6:66。</char>
    </note>
    <char style="pn">利未</char>的儿子是<char style="pn">革顺</char>、<char style="pn">哥辖</char>和<char style="pn">米拉利</char>。<verse eid="1CH 6:1" /></para>
  <para style="mi">
    <verse number="2" style="v" sid="1CH 6:2" />
    <char style="pn">哥辖</char>的儿子是<char style="pn">阿姆兰</char>、<char style="pn">以斯哈</char>、<char style="pn">希伯伦</char>和<char style="pn">乌基业</char>。<verse eid="1CH 6:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 6:3" />
    <char style="pn">阿姆兰</char>的儿女是<char style="pn">亚伦</char>、<char style="pn">摩西</char>和<char style="pn">米利暗</char>。</para>
  <para style="mi" vid="1CH 6:3">
    <char style="pn">亚伦</char>的儿子是<char style="pn">纳达布</char>、<char style="pn">亚比户</char>、<char style="pn">以利亚撒</char>和<char style="pn">以塔玛尔</char>。<verse eid="1CH 6:3" /></para>
  <para style="mi">
    <verse number="4" style="v" sid="1CH 6:4" />
    <char style="pn">以利亚撒</char>生<char style="pn">非尼哈</char>，</para>
  <para style="mi" vid="1CH 6:4">
    <char style="pn">非尼哈</char>生<char style="pn">亚比书</char>，<verse eid="1CH 6:4" /></para>
  <para style="mi">
    <verse number="5" style="v" sid="1CH 6:5" />
    <char style="pn">亚比书</char>生<char style="pn">布其</char>，</para>
  <para style="mi" vid="1CH 6:5">
    <char style="pn">布其</char>生<char style="pn">乌基</char>，<verse eid="1CH 6:5" /></para>
  <para style="mi">
    <verse number="6" style="v" sid="1CH 6:6" />
    <char style="pn">乌基</char>生<char style="pn">西拉希雅</char>，</para>
  <para style="mi" vid="1CH 6:6">
    <char style="pn">西拉希雅</char>生<char style="pn">米拉约</char>，<verse eid="1CH 6:6" /></para>
  <para style="mi">
    <verse number="7" style="v" sid="1CH 6:7" />
    <char style="pn">米拉约</char>生<char style="pn">亚玛利雅</char>，</para>
  <para style="mi" vid="1CH 6:7">
    <char style="pn">亚玛利雅</char>生<char style="pn">亚希突</char>，<verse eid="1CH 6:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="1CH 6:8" />
    <char style="pn">亚希突</char>生<char style="pn">撒督</char>，</para>
  <para style="mi" vid="1CH 6:8">
    <char style="pn">撒督</char>生<char style="pn">亚希玛斯</char>，<verse eid="1CH 6:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="1CH 6:9" />
    <char style="pn">亚希玛斯</char>生<char style="pn">亚撒利雅</char>，</para>
  <para style="mi" vid="1CH 6:9">
    <char style="pn">亚撒利雅</char>生<char style="pn">约哈南</char>，<verse eid="1CH 6:9" /></para>
  <para style="mi">
    <verse number="10" style="v" sid="1CH 6:10" />
    <char style="pn">约哈南</char>生<char style="pn">亚撒利雅</char>——他在<char style="pn">所罗门</char>于<char style="pn">耶路撒冷</char>建造的圣殿中作祭司——<verse eid="1CH 6:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="1CH 6:11" />
    <char style="pn">亚撒利雅</char>生<char style="pn">亚玛利雅</char>，</para>
  <para style="mi" vid="1CH 6:11">
    <char style="pn">亚玛利雅</char>生<char style="pn">亚希突</char>，<verse eid="1CH 6:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="1CH 6:12" />
    <char style="pn">亚希突</char>生<char style="pn">撒督</char>，</para>
  <para style="mi" vid="1CH 6:12">
    <char style="pn">撒督</char>生<char style="pn">沙勒姆</char>，<verse eid="1CH 6:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 6:13" />
    <char style="pn">沙勒姆</char>生<char style="pn">希勒加</char>，</para>
  <para style="mi" vid="1CH 6:13">
    <char style="pn">希勒加</char>生<char style="pn">亚撒利雅</char>，<verse eid="1CH 6:13" /></para>
  <para style="mi">
    <verse number="14" style="v" sid="1CH 6:14" />
    <char style="pn">亚撒利雅</char>生<char style="pn">西莱雅</char>，</para>
  <para style="mi" vid="1CH 6:14">
    <char style="pn">西莱雅</char>生<char style="pn">约萨达</char>，<verse eid="1CH 6:14" /></para>
  <para style="mi">
    <verse number="15" style="v" sid="1CH 6:15" />在耶和华藉着<char style="pn">尼布甲尼撒</char>的手掳掠<char style="pn">犹大</char>和<char style="pn">耶路撒冷</char>的时候，<char style="pn">约萨达</char>也被掳去了。<verse eid="1CH 6:15" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="16" style="v" sid="1CH 6:16" />
    <char style="pn">利未</char>的儿子是<char style="pn">革顺</char>、<char style="pn">哥辖</char>和<char style="pn">米拉利</char>。<verse eid="1CH 6:16" /></para>
  <para style="mi">
    <verse number="17" style="v" sid="1CH 6:17" />
    <char style="pn">革顺</char>的儿子名字是<char style="pn">立尼</char>和<char style="pn">示每</char>。<verse eid="1CH 6:17" /></para>
  <para style="mi">
    <verse number="18" style="v" sid="1CH 6:18" />
    <char style="pn">哥辖</char>的儿子是<char style="pn">阿姆兰</char>、<char style="pn">以斯哈</char>、<char style="pn">希伯伦</char>和<char style="pn">乌基业</char>。<verse eid="1CH 6:18" /></para>
  <para style="mi">
    <verse number="19" style="v" sid="1CH 6:19" />
    <char style="pn">米拉利</char>的儿子是<char style="pn">玛赫利</char>和<char style="pn">穆希</char>。</para>
  <para style="mi" vid="1CH 6:19">以下是按着他们的父系，<char style="pn">利未</char>人的各家族：<verse eid="1CH 6:19" /></para>
  <para style="mi">
    <verse number="20" style="v" sid="1CH 6:20" />属于<char style="pn">革顺</char>的，是他的儿子<char style="pn">立尼</char>，</para>
  <para style="mi" vid="1CH 6:20">
    <char style="pn">立尼</char>的儿子<char style="pn">雅哈</char>，<char style="pn">雅哈</char>的儿子<char style="pn">津玛</char>，<verse eid="1CH 6:20" /></para>
  <para style="mi">
    <verse number="21" style="v" sid="1CH 6:21" />
    <char style="pn">津玛</char>的儿子<char style="pn">约亚</char>，<char style="pn">约亚</char>的儿子<char style="pn">易多</char>，</para>
  <para style="mi" vid="1CH 6:21">
    <char style="pn">易多</char>的儿子<char style="pn">谢拉</char>，<char style="pn">谢拉</char>的儿子<char style="pn">耶特赖</char>。<verse eid="1CH 6:21" /></para>
  <para style="mi">
    <verse number="22" style="v" sid="1CH 6:22" />
    <char style="pn">哥辖</char>的子孙，是<char style="pn">哥辖</char>的儿子<char style="pn">亚米拿达</char>，</para>
  <para style="mi" vid="1CH 6:22">
    <char style="pn">亚米拿达</char>的儿子<char style="pn">可拉</char>，<char style="pn">可拉</char>的儿子<char style="pn">亚惜</char>，<verse eid="1CH 6:22" /></para>
  <para style="mi">
    <verse number="23" style="v" sid="1CH 6:23" />
    <char style="pn">亚惜</char>的儿子<char style="pn">以利加拿</char>，<char style="pn">以利加拿</char>的儿子<char style="pn">伊比雅撒</char>，</para>
  <para style="mi" vid="1CH 6:23">
    <char style="pn">伊比雅撒</char>的儿子<char style="pn">亚惜</char>， <verse eid="1CH 6:23" /><verse number="24" style="v" sid="1CH 6:24" /><char style="pn">亚惜</char>的儿子<char style="pn">塔哈特</char>，</para>
  <para style="mi" vid="1CH 6:24">
    <char style="pn">塔哈特</char>的儿子<char style="pn">乌列</char>，<char style="pn">乌列</char>的儿子<char style="pn">乌西雅</char>，</para>
  <para style="mi" vid="1CH 6:24">
    <char style="pn">乌西雅</char>的儿子<char style="pn">扫罗</char>；<verse eid="1CH 6:24" /></para>
  <para style="mi">
    <verse number="25" style="v" sid="1CH 6:25" />
    <char style="pn">以利加拿</char>的儿子<char style="pn">亚玛赛</char>和<char style="pn">亚希莫</char>，<verse eid="1CH 6:25" /></para>
  <para style="mi">
    <verse number="26" style="v" sid="1CH 6:26" />
    <char style="pn">亚希莫</char>的儿子<char style="pn">以利加拿</char>，<char style="pn">以利加拿</char>的儿子<char style="pn">琐菲</char>，</para>
  <para style="mi" vid="1CH 6:26">
    <char style="pn">琐菲</char>的儿子<char style="pn">拿哈</char>， <verse eid="1CH 6:26" /><verse number="27" style="v" sid="1CH 6:27" /><char style="pn">拿哈</char>的儿子<char style="pn">以利押</char>，</para>
  <para style="mi" vid="1CH 6:27">
    <char style="pn">以利押</char>的儿子<char style="pn">耶罗罕</char>，<char style="pn">耶罗罕</char>的儿子<char style="pn">以利加拿</char>。<verse eid="1CH 6:27" /></para>
  <para style="mi">
    <verse number="28" style="v" sid="1CH 6:28" />
    <char style="pn">撒母耳</char>的儿子是长子<char style="pn">约珥</char>，次子<char style="pn">亚比雅</char>。<verse eid="1CH 6:28" /></para>
  <para style="mi">
    <verse number="29" style="v" sid="1CH 6:29" />
    <char style="pn">米拉利</char>的子孙，是他的儿子<char style="pn">玛赫利</char>，</para>
  <para style="mi" vid="1CH 6:29">
    <char style="pn">玛赫利</char>的儿子<char style="pn">立尼</char>，<char style="pn">立尼</char>的儿子<char style="pn">示每</char>，</para>
  <para style="mi" vid="1CH 6:29">
    <char style="pn">示每</char>的儿子<char style="pn">乌撒</char>， <verse eid="1CH 6:29" /><verse number="30" style="v" sid="1CH 6:30" /><char style="pn">乌撒</char>的儿子<char style="pn">示米亚</char>，</para>
  <para style="mi" vid="1CH 6:30">
    <char style="pn">示米亚</char>的儿子<char style="pn">哈基雅</char>，<char style="pn">哈基雅</char>的儿子<char style="pn">亚撒雅</char>。<verse eid="1CH 6:30" /></para>
  <para style="s">唱诗班</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31" />以下是约柜安定下来以后，<char style="pn">大卫</char>设立在耶和华殿中掌管歌唱的人。 <verse eid="1CH 6:31" /><verse number="32" style="v" sid="1CH 6:32" />他们从前是在会幕的帐幕前用歌唱事奉的，直到<char style="pn">所罗门</char>在<char style="pn">耶路撒冷</char>建造了耶和华的殿，他们就照着惯例服事供职。 <verse eid="1CH 6:32" /><verse number="33" style="v" sid="1CH 6:33" />这些供职的人以及他们的子孙如下：</para>
  <para style="mi" vid="1CH 6:33">
    <char style="pn">哥辖</char>的子孙中有歌唱者<char style="pn">希幔</char>，</para>
  <para style="mi" vid="1CH 6:33">他是<char style="pn">约珥</char>的儿子，<char style="pn">约珥</char>是<char style="pn">撒母耳</char>的儿子，<verse eid="1CH 6:33" /></para>
  <para style="mi">
    <verse number="34" style="v" sid="1CH 6:34" />
    <char style="pn">撒母耳</char>是<char style="pn">以利加拿</char>的儿子，<char style="pn">以利加拿</char>是<char style="pn">耶罗罕</char>的儿子，</para>
  <para style="mi" vid="1CH 6:34">
    <char style="pn">耶罗罕</char>是<char style="pn">以利业</char>的儿子，<char style="pn">以利业</char>是<char style="pn">托阿</char>的儿子，<verse eid="1CH 6:34" /></para>
  <para style="mi">
    <verse number="35" style="v" sid="1CH 6:35" />
    <char style="pn">托阿</char>是<char style="pn">苏弗</char>的儿子，<char style="pn">苏弗</char>是<char style="pn">以利加拿</char>的儿子，</para>
  <para style="mi" vid="1CH 6:35">
    <char style="pn">以利加拿</char>是<char style="pn">玛哈</char>的儿子，<char style="pn">玛哈</char>是<char style="pn">亚玛赛</char>的儿子，<verse eid="1CH 6:35" /></para>
  <para style="mi">
    <verse number="36" style="v" sid="1CH 6:36" />
    <char style="pn">亚玛赛</char>是<char style="pn">以利加拿</char>的儿子，<char style="pn">以利加拿</char>是<char style="pn">约珥</char>的儿子，</para>
  <para style="mi" vid="1CH 6:36">
    <char style="pn">约珥</char>是<char style="pn">亚撒利雅</char>的儿子，<char style="pn">亚撒利雅</char>是<char style="pn">西番雅</char>的儿子，<verse eid="1CH 6:36" /></para>
  <para style="mi">
    <verse number="37" style="v" sid="1CH 6:37" />
    <char style="pn">西番雅</char>是<char style="pn">塔哈特</char>的儿子，<char style="pn">塔哈特</char>是<char style="pn">亚惜</char>的儿子，</para>
  <para style="mi" vid="1CH 6:37">
    <char style="pn">亚惜</char>是<char style="pn">伊比雅撒</char>的儿子，<char style="pn">伊比雅撒</char>是<char style="pn">可拉</char>的儿子，<verse eid="1CH 6:37" /></para>
  <para style="mi">
    <verse number="38" style="v" sid="1CH 6:38" />
    <char style="pn">可拉</char>是<char style="pn">以斯哈</char>的儿子，<char style="pn">以斯哈</char>是<char style="pn">哥辖</char>的儿子，</para>
  <para style="mi" vid="1CH 6:38">
    <char style="pn">哥辖</char>是<char style="pn">利未</char>的儿子，<char style="pn">利未</char>是<char style="pn">以色列</char>的儿子。<verse eid="1CH 6:38" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="39" style="v" sid="1CH 6:39" />站在<char style="pn">希幔</char>右边的是他的兄弟<char style="pn">亚萨</char>，</para>
  <para style="mi" vid="1CH 6:39">
    <char style="pn">亚萨</char>是<char style="pn">比利迦</char>的儿子，<char style="pn">比利迦</char>是<char style="pn">示米亚</char>的儿子，<verse eid="1CH 6:39" /></para>
  <para style="mi">
    <verse number="40" style="v" sid="1CH 6:40" />
    <char style="pn">示米亚</char>是<char style="pn">米迦勒</char>的儿子，<char style="pn">米迦勒</char>是<char style="pn">巴西雅</char>的儿子，</para>
  <para style="mi" vid="1CH 6:40">
    <char style="pn">巴西雅</char>是<char style="pn">玛基雅</char>的儿子， <verse eid="1CH 6:40" /><verse number="41" style="v" sid="1CH 6:41" /><char style="pn">玛基雅</char>是<char style="pn">伊特尼</char>的儿子，</para>
  <para style="mi" vid="1CH 6:41">
    <char style="pn">伊特尼</char>是<char style="pn">谢拉</char>的儿子，<char style="pn">谢拉</char>是<char style="pn">亚达雅</char>的儿子，<verse eid="1CH 6:41" /></para>
  <para style="mi">
    <verse number="42" style="v" sid="1CH 6:42" />
    <char style="pn">亚达雅</char>是<char style="pn">伊坦</char>的儿子，<char style="pn">伊坦</char>是<char style="pn">津玛</char>的儿子，</para>
  <para style="mi" vid="1CH 6:42">
    <char style="pn">津玛</char>是<char style="pn">示每</char>的儿子， <verse eid="1CH 6:42" /><verse number="43" style="v" sid="1CH 6:43" /><char style="pn">示每</char>是<char style="pn">雅哈</char>的儿子，</para>
  <para style="mi" vid="1CH 6:43">
    <char style="pn">雅哈</char>是<char style="pn">革顺</char>的儿子，<char style="pn">革顺</char>是<char style="pn">利未</char>的儿子。<verse eid="1CH 6:43" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="44" style="v" sid="1CH 6:44" />他们的族兄弟<char style="pn">米拉利</char>的子孙<char style="pn">伊坦</char>站在左边，</para>
  <para style="mi" vid="1CH 6:44">
    <char style="pn">伊坦</char>是<char style="pn">基示</char>的儿子，<char style="pn">基示</char>是<char style="pn">阿伯迪</char>的儿子，</para>
  <para style="mi" vid="1CH 6:44">
    <char style="pn">阿伯迪</char>是<char style="pn">玛卢克</char>的儿子， <verse eid="1CH 6:44" /><verse number="45" style="v" sid="1CH 6:45" /><char style="pn">玛卢克</char>是<char style="pn">哈沙比雅</char>的儿子，</para>
  <para style="mi" vid="1CH 6:45">
    <char style="pn">哈沙比雅</char>是<char style="pn">亚玛谢</char>的儿子，<char style="pn">亚玛谢</char>是<char style="pn">希勒加</char>的儿子，<verse eid="1CH 6:45" /></para>
  <para style="mi">
    <verse number="46" style="v" sid="1CH 6:46" />
    <char style="pn">希勒加</char>是<char style="pn">阿姆基</char>的儿子，<char style="pn">阿姆基</char>是<char style="pn">巴尼</char>的儿子，</para>
  <para style="mi" vid="1CH 6:46">
    <char style="pn">巴尼</char>是<char style="pn">谢梅尔</char>的儿子， <verse eid="1CH 6:46" /><verse number="47" style="v" sid="1CH 6:47" /><char style="pn">谢梅尔</char>是<char style="pn">玛赫利</char>的儿子，</para>
  <para style="mi" vid="1CH 6:47">
    <char style="pn">玛赫利</char>是<char style="pn">穆希</char>的儿子，<char style="pn">穆希</char>是<char style="pn">米拉利</char>的子孙，</para>
  <para style="mi" vid="1CH 6:47">
    <char style="pn">米拉利</char>是<char style="pn">利未</char>的儿子。<verse eid="1CH 6:47" /></para>
  <para style="s">亚伦子孙</para>
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48" />他们的<char style="pn">利未</char>兄弟们被指定办理神殿中帐幕的一切服事。 <verse eid="1CH 6:48" /><verse number="49" style="v" sid="1CH 6:49" /><char style="pn">亚伦</char>和他的子孙照着神的仆人<char style="pn">摩西</char>所吩咐的一切，在燔祭坛和香坛上烧献，负责至圣所的一切工作，为<char style="pn">以色列</char>赎罪。<verse eid="1CH 6:49" /></para>
  <para style="mi">
    <verse number="50" style="v" sid="1CH 6:50" />
    <char style="pn">亚伦</char>的子孙如下：<char style="pn">亚伦</char>的儿子<char style="pn">以利亚撒</char>，</para>
  <para style="mi" vid="1CH 6:50">
    <char style="pn">以利亚撒</char>的儿子<char style="pn">非尼哈</char>，<char style="pn">非尼哈</char>的儿子<char style="pn">亚比书</char>，<verse eid="1CH 6:50" /></para>
  <para style="mi">
    <verse number="51" style="v" sid="1CH 6:51" />
    <char style="pn">亚比书</char>的儿子<char style="pn">布其</char>，<char style="pn">布其</char>的儿子<char style="pn">乌基</char>，</para>
  <para style="mi" vid="1CH 6:51">
    <char style="pn">乌基</char>的儿子<char style="pn">西拉希雅</char>， <verse eid="1CH 6:51" /><verse number="52" style="v" sid="1CH 6:52" /><char style="pn">西拉希雅</char>的儿子<char style="pn">米拉约</char>，</para>
  <para style="mi" vid="1CH 6:52">
    <char style="pn">米拉约</char>的儿子<char style="pn">亚玛利雅</char>，<char style="pn">亚玛利雅</char>的儿子<char style="pn">亚希突</char>，<verse eid="1CH 6:52" /></para>
  <para style="mi">
    <verse number="53" style="v" sid="1CH 6:53" />
    <char style="pn">亚希突</char>的儿子<char style="pn">撒督</char>，<char style="pn">撒督</char>的儿子<char style="pn">亚希玛斯</char>。<verse eid="1CH 6:53" /></para>
  <para style="s">利未人的居所</para>
  <para style="p">
    <verse number="54" style="v" sid="1CH 6:54" />以下是他们在自己境内，按着各自的营寨居住的地方：</para>
  <para style="p" vid="1CH 6:54">
    <char style="pn">哥辖</char>家族中的<char style="pn">亚伦</char>子孙先抽签， <verse eid="1CH 6:54" /><verse number="55" style="v" sid="1CH 6:55" />分得了<char style="pn">犹大</char>地的<char style="pn">希伯仑</char>和周围的牧野； <verse eid="1CH 6:55" /><verse number="56" style="v" sid="1CH 6:56" />至于这城的田野和村庄，<char style="pn">以色列</char>人已经给了<char style="pn">耶弗尼</char>的儿子<char style="pn">迦勒</char>。<verse eid="1CH 6:56" /></para>
  <para style="mi">
    <verse number="57" style="v" sid="1CH 6:57" />
    <char style="pn">亚伦</char>子孙分得了逃城<char style="pn">希伯仑</char>，<char style="pn">立拿</char>和附属的牧野，<char style="pn">雅提珥</char>，<char style="pn">以实提莫</char>和附属的牧野， <verse eid="1CH 6:57" /><verse number="58" style="v" sid="1CH 6:58" /><char style="pn">希仑</char>和附属的牧野，<char style="pn">底璧</char>和附属的牧野， <verse eid="1CH 6:58" /><verse number="59" style="v" sid="1CH 6:59" /><char style="pn">阿珊</char>和附属的牧野，<char style="pn">伯示麦</char>和附属的牧野。 <verse eid="1CH 6:59" /><verse number="60" style="v" sid="1CH 6:60" />又从<char style="pn">便雅悯</char>支派中，得了<char style="pn">迦巴</char>和附属的牧野，<char style="pn">阿勒米特</char>和附属的牧野，<char style="pn">亚纳图</char>和附属的牧野。他们各家族总共得了十三座城。<verse eid="1CH 6:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="1CH 6:61" />至于<char style="pn">哥辖</char>其余的子孙，从别的支派家族，就是从<char style="pn">玛拿西</char>半支派中，抽签得了十座城。<verse eid="1CH 6:61" /></para>
  <para style="b" />
  <para style="p">
    <verse number="62" style="v" sid="1CH 6:62" />
    <char style="pn">革顺</char>子孙，按着他们的家族，从<char style="pn">以萨迦</char>支派、<char style="pn">亚设</char>支派、<char style="pn">拿弗他利</char>支派和在<char style="pn">巴珊</char>地的<char style="pn">玛拿西</char>支派中，得了十三座城。<verse eid="1CH 6:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="1CH 6:63" />
    <char style="pn">米拉利</char>子孙，按着他们的家族，从<char style="pn">鲁本</char>支派、<char style="pn">迦得</char>支派和<char style="pn">西布伦</char>支派中，抽签得了十二座城。<verse eid="1CH 6:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="1CH 6:64" />这样，<char style="pn">以色列</char>人把这些城和附属的牧野分给了<char style="pn">利未</char>人。 <verse eid="1CH 6:64" /><verse number="65" style="v" sid="1CH 6:65" />他们还按照抽签，从<char style="pn">犹大</char>支派、<char style="pn">西缅</char>支派和<char style="pn">便雅悯</char>支派中，把那些点到名字的城分给了<char style="pn">利未</char>人。<verse eid="1CH 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="1CH 6:66" />
    <char style="pn">哥辖</char>子孙的一些家族，也得了<char style="pn">以法莲</char>支派境内的城。<verse eid="1CH 6:66" /></para>
  <para style="mi">
    <verse number="67" style="v" sid="1CH 6:67" />他们分得了<char style="pn">以法莲</char>山地的逃城<char style="pn">示剑</char>和附属的牧野，<char style="pn">基色</char>和附属的牧野， <verse eid="1CH 6:67" /><verse number="68" style="v" sid="1CH 6:68" /><char style="pn">约克缅</char>和附属的牧野，<char style="pn">伯贺仑</char>和附属的牧野， <verse eid="1CH 6:68" /><verse number="69" style="v" sid="1CH 6:69" /><char style="pn">阿雅仑</char>和附属的牧野，<char style="pn">迦特临门</char>和附属的牧野。 <verse eid="1CH 6:69" /><verse number="70" style="v" sid="1CH 6:70" />还从<char style="pn">玛拿西</char>半支派中，分给<char style="pn">哥辖</char>子孙其余的家族：<char style="pn">阿内尔</char>和附属的牧野，<char style="pn">比连</char>和附属的牧野。<verse eid="1CH 6:70" /></para>
  <para style="b" />
  <para style="p">
    <verse number="71" style="v" sid="1CH 6:71" />
    <char style="pn">革顺</char>子孙，</para>
  <para style="mi" vid="1CH 6:71">从<char style="pn">玛拿西</char>半支派的家族中，得了<char style="pn">巴珊</char>的<char style="pn">戈兰</char>和附属的牧野，<char style="pn">亚斯他录</char>和附属的牧野； <verse eid="1CH 6:71" /><verse number="72" style="v" sid="1CH 6:72" />从<char style="pn">以萨迦</char>支派中，得了<char style="pn">基低斯</char>和附属的牧野，<char style="pn">达比拉</char>和附属的牧野， <verse eid="1CH 6:72" /><verse number="73" style="v" sid="1CH 6:73" /><char style="pn">拉末</char>和附属的牧野，<char style="pn">亚年</char>和附属的牧野； <verse eid="1CH 6:73" /><verse number="74" style="v" sid="1CH 6:74" />从<char style="pn">亚设</char>支派中，得了<char style="pn">玛沙</char>和附属的牧野，<char style="pn">阿布顿</char>和附属的牧野， <verse eid="1CH 6:74" /><verse number="75" style="v" sid="1CH 6:75" /><char style="pn">户割</char>和附属的牧野，<char style="pn">利合</char>和附属的牧野； <verse eid="1CH 6:75" /><verse number="76" style="v" sid="1CH 6:76" />从<char style="pn">拿弗他利</char>支派中，得了<char style="pn">加利利</char>的<char style="pn">基低斯</char>和附属的牧野，<char style="pn">哈门</char>和附属的牧野，<char style="pn">基列亭</char>和附属的牧野。<verse eid="1CH 6:76" /></para>
  <para style="b" />
  <para style="p">
    <verse number="77" style="v" sid="1CH 6:77" />
    <char style="pn">米拉利</char>子孙——其余的<char style="pn">利未</char>人，</para>
  <para style="mi" vid="1CH 6:77">从<char style="pn">西布伦</char>支派中，得了<char style="pn">临摩挪</char>和附属的牧野，<char style="pn">他泊</char>和附属的牧野； <verse eid="1CH 6:77" /><verse number="78" style="v" sid="1CH 6:78" />从<char style="pn">鲁本</char>支派中，在<char style="pn">耶利哥</char>的<char style="pn">约旦</char>河对面，就是<char style="pn">约旦</char>河东边，得了在旷野中的<char style="pn">比册尔</char>和附属的牧野，<char style="pn">雅哈兹</char>和附属的牧野， <verse eid="1CH 6:78" /><verse number="79" style="v" sid="1CH 6:79" /><char style="pn">基底莫</char>和附属的牧野，<char style="pn">米法押</char>和附属的牧野； <verse eid="1CH 6:79" /><verse number="80" style="v" sid="1CH 6:80" />从<char style="pn">迦得</char>支派中，得了<char style="pn">基列</char>的<char style="pn">拉末</char>和附属的牧野，<char style="pn">玛哈念</char>和附属的牧野， <verse eid="1CH 6:80" /><verse number="81" style="v" sid="1CH 6:81" /><char style="pn">希实本</char>和附属的牧野，<char style="pn">雅谢</char>和附属的牧野。<verse eid="1CH 6:81" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" sid="1CH 7" />
  <para style="s">以萨迦子孙</para>
  <para style="mi">
    <verse number="1" style="v" sid="1CH 7:1" />
    <char style="pn">以萨迦</char>的儿子是<char style="pn">陀拉</char>、<char style="pn">普瓦</char>、<char style="pn">雅实布</char>和<char style="pn">希姆仑</char>，共四人。<verse eid="1CH 7:1" /></para>
  <para style="mi">
    <verse number="2" style="v" sid="1CH 7:2" />
    <char style="pn">陀拉</char>的儿子是<char style="pn">乌基</char>、<char style="pn">勒法雅</char>、<char style="pn">耶勒</char>、<char style="pn">雅买</char>、<char style="pn">易伯散</char>和<char style="pn">撒母耳</char>，都是他们父家的首领，是<char style="pn">陀拉</char>族谱系中英勇的战士，<char style="pn">大卫</char>年间他们的数目有两万两千六百人。<verse eid="1CH 7:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 7:3" />
    <char style="pn">乌基</char>的儿子是<char style="pn">伊斯拉希雅</char>，<char style="pn">伊斯拉希雅</char>的儿子是<char style="pn">米迦勒</char>、<char style="pn">俄巴底亚</char>、<char style="pn">约珥</char>和<char style="pn">伊示亚</char>，共五人，都是首领。 <verse eid="1CH 7:3" /><verse number="4" style="v" sid="1CH 7:4" />按着他们父家的谱系，跟随他们的作战军兵有三万六千人，因为他们的妻儿众多。 <verse eid="1CH 7:4" /><verse number="5" style="v" sid="1CH 7:5" />他们的族兄弟，<char style="pn">以萨迦</char>所有家族中英勇的战士，按着他们的家谱记录，共有八万七千人。<verse eid="1CH 7:5" /></para>
  <para style="b" />
  <para style="s">便雅悯子孙</para>
  <para style="mi">
    <verse number="6" style="v" sid="1CH 7:6" />
    <char style="pn">便雅悯</char>的儿子是<char style="pn">比拉</char>、<char style="pn">比结</char>和<char style="pn">耶迪阿业</char>，共三人。<verse eid="1CH 7:6" /></para>
  <para style="mi">
    <verse number="7" style="v" sid="1CH 7:7" />
    <char style="pn">比拉</char>的儿子是<char style="pn">伊兹本</char>、<char style="pn">乌基</char>、<char style="pn">乌基业</char>、<char style="pn">耶利莫</char>和<char style="pn">以利</char>，共五人，都是他们父家的首领，是英勇的战士。他们记录家谱的，有两万两千零三十四人。<verse eid="1CH 7:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="1CH 7:8" />
    <char style="pn">比结</char>的儿子是<char style="pn">细米拉</char>、<char style="pn">约阿施</char>、<char style="pn">以利以谢</char>、<char style="pn">以利约奈</char>、<char style="pn">欧姆利</char>、<char style="pn">耶利莫</char>、<char style="pn">亚比雅</char>、<char style="pn">亚纳图</char>和<char style="pn">阿勒米特</char>，这都是<char style="pn">比结</char>的儿子。 <verse eid="1CH 7:8" /><verse number="9" style="v" sid="1CH 7:9" />他们按着各父家首领的谱系记录了家谱，都是英勇的战士，共两万零两百人。<verse eid="1CH 7:9" /></para>
  <para style="mi">
    <verse number="10" style="v" sid="1CH 7:10" />
    <char style="pn">耶迪阿业</char>的儿子是<char style="pn">比勒罕</char>，<char style="pn">比勒罕</char>的儿子是<char style="pn">耶乌施</char>、<char style="pn">便雅悯</char>、<char style="pn">以胡德</char>、<char style="pn">克拿阿纳</char>、<char style="pn">细坦</char>、<char style="pn">塔尔施</char>和<char style="pn">亚希沙哈</char>。 <verse eid="1CH 7:10" /><verse number="11" style="v" sid="1CH 7:11" />这些都是<char style="pn">耶迪阿业</char>的儿子，是各父系的首领、英勇的战士；他们能上阵出战的，共一万七千两百人。 <verse eid="1CH 7:11" /><verse number="12" style="v" sid="1CH 7:12" />此外还有<char style="pn">以珥</char>的儿子<char style="pn">书皮姆</char>和<char style="pn">户皮姆</char>，<char style="pn">阿赫尔</char>的儿子<char style="pn">户西姆</char>。<verse eid="1CH 7:12" /></para>
  <para style="b" />
  <para style="s">拿弗他利子孙</para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 7:13" />
    <char style="pn">拿弗他利</char>的儿子是<char style="pn">雅赫兹列</char>、<char style="pn">古尼</char>、<char style="pn">耶则尔</char>、<char style="pn">沙勒姆</char>。他们都是<char style="pn">碧拉</char>的子孙。<verse eid="1CH 7:13" /></para>
  <para style="b" />
  <para style="s">玛拿西子孙</para>
  <para style="mi">
    <verse number="14" style="v" sid="1CH 7:14" />
    <char style="pn">玛拿西</char>的儿子是<char style="pn">亚斯列</char>，是他的<char style="pn">亚兰</char>妾所生的，她还生了<char style="pn">基列</char>的父亲<char style="pn">玛吉</char>。 <verse eid="1CH 7:14" /><verse number="15" style="v" sid="1CH 7:15" /><char style="pn">玛吉</char>娶了一个妻子，是<char style="pn">户皮姆</char>和<char style="pn">书皮姆</char>的妹妹，名叫<char style="pn">玛迦</char>。<char style="pn">玛吉</char>有另一系的子孙<note caller="+" style="f"><char style="fr" closed="false">7:15 </char><char style="ft" closed="false">玛吉……的子孙——辅助词语；参《约书亚记》17:3。</char></note>名叫<char style="pn">西罗非哈</char>，<char style="pn">西罗非哈</char>只有女儿。 <verse eid="1CH 7:15" /><verse number="16" style="v" sid="1CH 7:16" /><char style="pn">玛吉</char>的妻子<char style="pn">玛迦</char>生了一个儿子，她给他起名为<char style="pn">佩雷示</char>；<char style="pn">佩雷示</char>的兄弟名叫<char style="pn">谢雷示</char>，<char style="pn">谢雷示</char>的儿子是<char style="pn">乌兰</char>和<char style="pn">利肯</char>， <verse eid="1CH 7:16" /><verse number="17" style="v" sid="1CH 7:17" /><char style="pn">乌兰</char>的儿子是<char style="pn">比丹</char>。</para>
  <para style="mi" vid="1CH 7:17">这些是<char style="pn">基列</char>的子孙，<char style="pn">基列</char>是<char style="pn">玛吉</char>的儿子，<char style="pn">玛吉</char>是<char style="pn">玛拿西</char>的儿子。 <verse eid="1CH 7:17" /><verse number="18" style="v" sid="1CH 7:18" /><char style="pn">基列</char>的妹妹<char style="pn">哈莫莉克</char>生了<char style="pn">伊施赫德</char>、<char style="pn">亚比以谢</char>、<char style="pn">玛拉</char>。<verse eid="1CH 7:18" /></para>
  <para style="mi">
    <verse number="19" style="v" sid="1CH 7:19" />
    <char style="pn">谢米达</char>的儿子是<char style="pn">阿希扬</char>、<char style="pn">示剑</char>、<char style="pn">利克希</char>、<char style="pn">阿尼安</char>。<verse eid="1CH 7:19" /></para>
  <para style="b" />
  <para style="s">以法莲子孙</para>
  <para style="mi">
    <verse number="20" style="v" sid="1CH 7:20" />
    <char style="pn">以法莲</char>的儿子是<char style="pn">书提拉</char>，</para>
  <para style="mi" vid="1CH 7:20">
    <char style="pn">书提拉</char>的儿子是<char style="pn">贝列德</char>，</para>
  <para style="mi" vid="1CH 7:20">
    <char style="pn">贝列德</char>的儿子是<char style="pn">塔哈特</char>，</para>
  <para style="mi" vid="1CH 7:20">
    <char style="pn">塔哈特</char>的儿子是<char style="pn">伊拉达</char>，</para>
  <para style="mi" vid="1CH 7:20">
    <char style="pn">伊拉达</char>的儿子是<char style="pn">塔哈特</char>，<verse eid="1CH 7:20" /></para>
  <para style="mi">
    <verse number="21" style="v" sid="1CH 7:21" />
    <char style="pn">塔哈特</char>的儿子是<char style="pn">撒巴德</char>，</para>
  <para style="mi" vid="1CH 7:21">
    <char style="pn">撒巴德</char>的儿子是<char style="pn">书提拉</char>。</para>
  <para style="mi" vid="1CH 7:21">
    <char style="pn">以法莲</char>的儿子还有<char style="pn">以谢尔</char>和<char style="pn">以利亚德</char>，被当地的<char style="pn">迦特</char>人杀了，因为他们下去夺取<char style="pn">迦特</char>人的牲畜。 <verse eid="1CH 7:21" /><verse number="22" style="v" sid="1CH 7:22" />他们的父亲<char style="pn">以法莲</char>悲恸了许多日子，他的族兄弟都来安慰他。 <verse eid="1CH 7:22" /><verse number="23" style="v" sid="1CH 7:23" />后来<char style="pn">以法莲</char>与妻子同房，她就怀孕，生了一个儿子，<char style="pn">以法莲</char>给儿子起名为<char style="pn">比利亚</char>，因为他家里遭了祸患。 <verse eid="1CH 7:23" /><verse number="24" style="v" sid="1CH 7:24" />他的女儿是<char style="pn">谢伊拉</char>，<char style="pn">谢伊拉</char>建造了下<char style="pn">伯贺仑</char>和上<char style="pn">伯贺仑</char>，以及<char style="pn">乌曾-谢伊拉</char>。<verse eid="1CH 7:24" /></para>
  <para style="mi">
    <verse number="25" style="v" sid="1CH 7:25" />
    <char style="pn">比利亚</char>的儿子是<char style="pn">利法</char>和<char style="pn">利谢</char>，</para>
  <para style="mi" vid="1CH 7:25">
    <char style="pn">利谢</char>的儿子是<char style="pn">特拉</char>，</para>
  <para style="mi" vid="1CH 7:25">
    <char style="pn">特拉</char>的儿子是<char style="pn">塔罕</char>，<verse eid="1CH 7:25" /></para>
  <para style="mi">
    <verse number="26" style="v" sid="1CH 7:26" />
    <char style="pn">塔罕</char>的儿子是<char style="pn">拉丹</char>，</para>
  <para style="mi" vid="1CH 7:26">
    <char style="pn">拉丹</char>的儿子是<char style="pn">亚米忽</char>，</para>
  <para style="mi" vid="1CH 7:26">
    <char style="pn">亚米忽</char>的儿子是<char style="pn">以利沙玛</char>，<verse eid="1CH 7:26" /></para>
  <para style="mi">
    <verse number="27" style="v" sid="1CH 7:27" />
    <char style="pn">以利沙玛</char>的儿子是<char style="pn">嫩</char>，</para>
  <para style="mi" vid="1CH 7:27">
    <char style="pn">嫩</char>的儿子是<char style="pn">约书亚</char>。<verse eid="1CH 7:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="1CH 7:28" />他们的产业和居住的地方是<char style="pn">伯特利</char>和附属的村镇，东边的<char style="pn">拿兰</char>，西边的<char style="pn">基色</char>和附属的村镇，以及<char style="pn">示剑</char>和附属的村镇，直到<char style="pn">艾雅</char>和附属的村镇； <verse eid="1CH 7:28" /><verse number="29" style="v" sid="1CH 7:29" />还有靠近<char style="pn">玛拿西</char>子孙边界的<char style="pn">伯珊</char>和附属的村镇，<char style="pn">特纳克</char>和附属的村镇，<char style="pn">米吉多</char>和附属的村镇，<char style="pn">多珥</char>和附属的村镇。<char style="pn">以色列</char>的儿子<char style="pn">约瑟</char>的子孙就住在这些地方。<verse eid="1CH 7:29" /></para>
  <para style="b" />
  <para style="s">亚设子孙</para>
  <para style="mi">
    <verse number="30" style="v" sid="1CH 7:30" />
    <char style="pn">亚设</char>的儿子是<char style="pn">伊姆纳</char>、<char style="pn">伊施瓦</char>、<char style="pn">伊施韦</char>和<char style="pn">比利亚</char>，还有他们的妹妹<char style="pn">西拉</char>。<verse eid="1CH 7:30" /></para>
  <para style="mi">
    <verse number="31" style="v" sid="1CH 7:31" />
    <char style="pn">比利亚</char>的儿子是<char style="pn">希伯</char>和<char style="pn">玛结</char>，<char style="pn">玛结</char>是<char style="pn">比尔仔特</char>的父亲。<verse eid="1CH 7:31" /></para>
  <para style="mi">
    <verse number="32" style="v" sid="1CH 7:32" />
    <char style="pn">希伯</char>生了<char style="pn">雅弗列</char>、<char style="pn">朔梅尔</char>、<char style="pn">赫坦</char>和他们的妹妹<char style="pn">淑雅</char>。<verse eid="1CH 7:32" /></para>
  <para style="mi">
    <verse number="33" style="v" sid="1CH 7:33" />
    <char style="pn">雅弗列</char>的儿子是<char style="pn">琶萨</char>、<char style="pn">宾哈勒</char>和<char style="pn">阿示瓦</char>，这些是<char style="pn">雅弗列</char>的儿子。<verse eid="1CH 7:33" /></para>
  <para style="mi">
    <verse number="34" style="v" sid="1CH 7:34" />
    <char style="pn">朔梅尔</char>的儿子是<char style="pn">亚希</char>、<char style="pn">罗迦</char>、<char style="pn">户巴</char><note caller="+" style="f"><char style="fr" closed="false">7:34 </char><char style="ft" closed="false">户巴——传统音译作“耶户巴”。</char></note>和<char style="pn">亚兰</char>。<verse eid="1CH 7:34" /></para>
  <para style="mi">
    <verse number="35" style="v" sid="1CH 7:35" />他的兄弟<char style="pn">希连</char>的儿子是<char style="pn">佐法</char>、<char style="pn">伊姆纳</char>、<char style="pn">示列斯</char>和<char style="pn">亚玛尔</char>。<verse eid="1CH 7:35" /></para>
  <para style="mi">
    <verse number="36" style="v" sid="1CH 7:36" />
    <char style="pn">佐法</char>的儿子是<char style="pn">苏阿赫</char>、<char style="pn">哈尼弗</char>、<char style="pn">书阿勒</char>、<char style="pn">比利</char>、<char style="pn">伊姆拉</char>、 <verse eid="1CH 7:36" /><verse number="37" style="v" sid="1CH 7:37" /><char style="pn">比册尔</char>、<char style="pn">赫德</char>、<char style="pn">沙玛</char>、<char style="pn">希勒沙</char>、<char style="pn">益兰</char>、<char style="pn">比尔拉</char>。<verse eid="1CH 7:37" /></para>
  <para style="mi">
    <verse number="38" style="v" sid="1CH 7:38" />
    <char style="pn">耶特尔</char>的儿子是<char style="pn">耶弗尼</char>、<char style="pn">皮斯巴</char>和<char style="pn">阿拉</char>。<verse eid="1CH 7:38" /></para>
  <para style="mi">
    <verse number="39" style="v" sid="1CH 7:39" />
    <char style="pn">乌拉</char>的儿子是<char style="pn">阿拉赫</char>、<char style="pn">哈尼业</char>和<char style="pn">利茨亚</char>。<verse eid="1CH 7:39" /></para>
  <para style="mi">
    <verse number="40" style="v" sid="1CH 7:40" />这些人都是<char style="pn">亚设</char>的子孙，是他们父家的首领，是精选的勇士，在领袖中为首。他们的家谱记录里，能上阵出战的，数目有两万六千人。<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" sid="1CH 8" />
  <para style="s">便雅悯子孙</para>
  <para style="mi">
    <verse number="1" style="v" sid="1CH 8:1" />
    <char style="pn">便雅悯</char>生了长子<char style="pn">比拉</char>，</para>
  <para style="mi" vid="1CH 8:1">次子<char style="pn">阿实别</char>，三子<char style="pn">亚哈拉</char>，<verse eid="1CH 8:1" /></para>
  <para style="mi">
    <verse number="2" style="v" sid="1CH 8:2" />四子<char style="pn">挪哈</char>，五子<char style="pn">勒法</char>。<verse eid="1CH 8:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 8:3" />
    <char style="pn">比拉</char>的儿子是<char style="pn">阿达尔</char>、<char style="pn">基拉</char>、<char style="pn">亚比忽</char>、<verse eid="1CH 8:3" /></para>
  <para style="mi">
    <verse number="4" style="v" sid="1CH 8:4" />
    <char style="pn">亚比书</char>、<char style="pn">奈曼</char>、<char style="pn">亚何亚</char>、<verse eid="1CH 8:4" /></para>
  <para style="mi">
    <verse number="5" style="v" sid="1CH 8:5" />
    <char style="pn">基拉</char>、<char style="pn">谢弗番</char>和<char style="pn">户兰</char>。<verse eid="1CH 8:5" /></para>
  <para style="mi">
    <verse number="6" style="v" sid="1CH 8:6" />以下是<char style="pn">埃胡德</char>的子孙，他们这些人是<char style="pn">迦巴</char>居民各父系的首领，曾被迁徙到<char style="pn">玛拿哈</char>； <verse eid="1CH 8:6" /><verse number="7" style="v" sid="1CH 8:7" />有<char style="pn">奈曼</char>、<char style="pn">亚希雅</char>、<char style="pn">基拉</char>——是他使他们迁徙的——<char style="pn">基拉</char>生了<char style="pn">乌撒</char>和<char style="pn">亚希忽</char>。<verse eid="1CH 8:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="1CH 8:8" />
    <char style="pn">沙哈莱姆</char>休了他的两个妻子<char style="pn">户茜姆</char>和<char style="pn">巴阿拉</char>以后，又在<char style="pn">摩押</char>地生养孩子， <verse eid="1CH 8:8" /><verse number="9" style="v" sid="1CH 8:9" />他的妻子<char style="pn">赫德示</char>生了<char style="pn">约巴</char>、<char style="pn">洗比雅</char>、<char style="pn">米沙</char>、<char style="pn">玛勒干</char>、 <verse eid="1CH 8:9" /><verse number="10" style="v" sid="1CH 8:10" /><char style="pn">耶乌兹</char>、<char style="pn">撒其亚</char>和<char style="pn">米尔玛</char>；这些都是他的儿子，是各父系的首领。 <verse eid="1CH 8:10" /><verse number="11" style="v" sid="1CH 8:11" />他与<char style="pn">户茜姆</char>生了<char style="pn">阿比突</char>和<char style="pn">以利帕力</char>。<verse eid="1CH 8:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="1CH 8:12" />
    <char style="pn">以利帕力</char>的子孙是<char style="pn">希伯</char>、<char style="pn">米珊</char>和<char style="pn">谢梅德</char>，<char style="pn">谢梅德</char>建造了<char style="pn">阿挪</char>和<char style="pn">罗德</char>以及附属的村镇。<verse eid="1CH 8:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 8:13" />还有<char style="pn">比利亚</char>和<char style="pn">示玛</char>，他们是<char style="pn">阿雅仑</char>的居民各父系的首领，他们曾经赶走了<char style="pn">迦特</char>的居民；<verse eid="1CH 8:13" /></para>
  <para style="mi">
    <verse number="14" style="v" sid="1CH 8:14" />又有<char style="pn">亚希约</char>、<char style="pn">沙煞</char>、<char style="pn">耶利莫</char>、 <verse eid="1CH 8:14" /><verse number="15" style="v" sid="1CH 8:15" /><char style="pn">希巴迪亚</char>、<char style="pn">阿拉德</char>、<char style="pn">埃德</char>、 <verse eid="1CH 8:15" /><verse number="16" style="v" sid="1CH 8:16" /><char style="pn">米迦勒</char>、<char style="pn">伊施巴</char>和<char style="pn">约哈</char>，都是<char style="pn">比利亚</char>的儿子；<verse eid="1CH 8:16" /></para>
  <para style="mi">
    <verse number="17" style="v" sid="1CH 8:17" />又有<char style="pn">希巴迪亚</char>、<char style="pn">米书兰</char>、<char style="pn">希西基</char>、<char style="pn">希伯</char>、 <verse eid="1CH 8:17" /><verse number="18" style="v" sid="1CH 8:18" /><char style="pn">伊施米莱</char>、<char style="pn">伊斯利亚</char>和<char style="pn">约巴</char>。他们都是<char style="pn">以利帕力</char>的儿子。<verse eid="1CH 8:18" /></para>
  <para style="mi">
    <verse number="19" style="v" sid="1CH 8:19" />还有<char style="pn">雅其姆</char>、<char style="pn">泽克利</char>、<char style="pn">扎布迪</char>、 <verse eid="1CH 8:19" /><verse number="20" style="v" sid="1CH 8:20" /><char style="pn">以利乃</char>、<char style="pn">洗勒太</char>、<char style="pn">以利业</char>、 <verse eid="1CH 8:20" /><verse number="21" style="v" sid="1CH 8:21" /><char style="pn">亚达雅</char>、<char style="pn">比拉雅</char>和<char style="pn">申拉</char>，都是<char style="pn">示每</char>的儿子；<verse eid="1CH 8:21" /></para>
  <para style="mi">
    <verse number="22" style="v" sid="1CH 8:22" />
    <char style="pn">伊施班</char>、<char style="pn">希伯</char>、<char style="pn">以利业</char>、 <verse eid="1CH 8:22" /><verse number="23" style="v" sid="1CH 8:23" /><char style="pn">阿布顿</char>、<char style="pn">泽克利</char>、<char style="pn">哈南</char>、 <verse eid="1CH 8:23" /><verse number="24" style="v" sid="1CH 8:24" /><char style="pn">哈纳尼雅</char>、<char style="pn">以拦</char>、<char style="pn">安陀提雅</char>、 <verse eid="1CH 8:24" /><verse number="25" style="v" sid="1CH 8:25" /><char style="pn">伊弗底雅</char>和<char style="pn">毗努伊勒</char>，都是<char style="pn">沙煞</char>的儿子；<verse eid="1CH 8:25" /></para>
  <para style="mi">
    <verse number="26" style="v" sid="1CH 8:26" />
    <char style="pn">珊示莱</char>、<char style="pn">示哈利</char>、<char style="pn">亚塔利雅</char>、 <verse eid="1CH 8:26" /><verse number="27" style="v" sid="1CH 8:27" /><char style="pn">雅利西</char>、<char style="pn">以利亚</char>和<char style="pn">泽克利</char>，都是<char style="pn">耶罗罕</char>的儿子。<verse eid="1CH 8:27" /></para>
  <para style="mi">
    <verse number="28" style="v" sid="1CH 8:28" />这些人都是各父系的首领，在他们的谱系中为首。他们住在<char style="pn">耶路撒冷</char>。<verse eid="1CH 8:28" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="29" style="v" sid="1CH 8:29" />
    <char style="pn">基遍</char>之祖<char style="pn">耶伊列</char><note caller="+" style="f"><char style="fr" closed="false">8:29 </char><char style="ft" closed="false">耶伊列——辅助词语；参《历代志上》9:35。</char></note>住在<char style="pn">基遍</char>，他的妻子名叫<char style="pn">玛迦</char>。 <verse eid="1CH 8:29" /><verse number="30" style="v" sid="1CH 8:30" />他的长子是<char style="pn">阿布顿</char>，然后是<char style="pn">苏珥</char>、<char style="pn">基士</char>、<char style="pn">巴力</char>、<char style="pn">纳达布</char>、 <verse eid="1CH 8:30" /><verse number="31" style="v" sid="1CH 8:31" /><char style="pn">格多</char>、<char style="pn">亚希约</char>、<char style="pn">撒迦</char>、 <verse eid="1CH 8:31" /><verse number="32" style="v" sid="1CH 8:32" /><char style="pn">米克罗</char>；<char style="pn">米克罗</char>生了<char style="pn">示米亚</char>。他们也与族兄弟一同住在<char style="pn">耶路撒冷</char>，在他们众兄弟对面。<verse eid="1CH 8:32" /></para>
  <para style="mi">
    <verse number="33" style="v" sid="1CH 8:33" />
    <char style="pn">尼珥</char>生<char style="pn">基士</char>，<char style="pn">基士</char>生<char style="pn">扫罗</char>，<char style="pn">扫罗</char>生了<char style="pn">约拿单</char>、<char style="pn">麦基舒亚</char>、<char style="pn">亚比拿达</char>和<char style="pn">伊施巴力</char>。<verse eid="1CH 8:33" /></para>
  <para style="mi">
    <verse number="34" style="v" sid="1CH 8:34" />
    <char style="pn">约拿单</char>的儿子是<char style="pn">米力巴力</char>，<char style="pn">米力巴力</char>生了<char style="pn">米迦</char>。<verse eid="1CH 8:34" /></para>
  <para style="mi">
    <verse number="35" style="v" sid="1CH 8:35" />
    <char style="pn">米迦</char>的儿子是<char style="pn">皮敦</char>、<char style="pn">米勒</char>、<char style="pn">塔利亚</char>和<char style="pn">亚哈斯</char>。<verse eid="1CH 8:35" /></para>
  <para style="mi">
    <verse number="36" style="v" sid="1CH 8:36" />
    <char style="pn">亚哈斯</char>生<char style="pn">耶赫阿达</char>，</para>
  <para style="mi" vid="1CH 8:36">
    <char style="pn">耶赫阿达</char>生<char style="pn">阿勒米特</char>、<char style="pn">阿兹玛维</char>和<char style="pn">泽姆利</char>，</para>
  <para style="mi" vid="1CH 8:36">
    <char style="pn">泽姆利</char>生<char style="pn">莫扎</char>， <verse eid="1CH 8:36" /><verse number="37" style="v" sid="1CH 8:37" /><char style="pn">莫扎</char>生<char style="pn">比尼亚</char>，</para>
  <para style="mi" vid="1CH 8:37">
    <char style="pn">比尼亚</char>的儿子是<char style="pn">勒法</char>，<char style="pn">勒法</char>的儿子是<char style="pn">以利亚萨</char>，<char style="pn">以利亚萨</char>的儿子是<char style="pn">亚悉</char>。<verse eid="1CH 8:37" /></para>
  <para style="mi">
    <verse number="38" style="v" sid="1CH 8:38" />
    <char style="pn">亚悉</char>有六个儿子，以下是他们的名字：<char style="pn">亚斯利甘</char>、<char style="pn">波基路</char>、<char style="pn">以实玛利</char>、<char style="pn">示亚利雅</char>、<char style="pn">俄巴底亚</char>和<char style="pn">哈南</char>，这些都是<char style="pn">亚悉</char>的儿子。<verse eid="1CH 8:38" /></para>
  <para style="mi">
    <verse number="39" style="v" sid="1CH 8:39" />
    <char style="pn">亚悉</char>的兄弟<char style="pn">以设</char>的儿子是：长子<char style="pn">乌兰</char>，次子<char style="pn">耶乌施</char>，三子<char style="pn">以利菲列</char>。<verse eid="1CH 8:39" /></para>
  <para style="mi">
    <verse number="40" style="v" sid="1CH 8:40" />
    <char style="pn">乌兰</char>的子孙都是英勇的战士，是弓箭手。他们儿孙众多，共一百五十人。</para>
  <para style="b" vid="1CH 8:40" />
  <para style="mi" vid="1CH 8:40">以上都是<char style="pn">便雅悯</char>子孙。<verse eid="1CH 8:40" /></para>
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" sid="1CH 9" />
  <para style="s">第一批回归的流亡者</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1" />全体<char style="pn">以色列</char>人都记录了家谱，看哪，被记在《<char style="pn">以色列</char>诸王纪》上。至于<char style="pn">犹大</char>，他们因对神不忠，就被掳到<char style="pn">巴比伦</char>去了。 <verse eid="1CH 9:1" /><verse number="2" style="v" sid="1CH 9:2" />第一批回来居住在自己的产业、自己城中的，有<char style="pn">以色列</char>人、祭司、<char style="pn">利未</char>人和圣殿仆役。<verse eid="1CH 9:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 9:3" />住在<char style="pn">耶路撒冷</char>的，有<char style="pn">犹大</char>子孙、<char style="pn">便雅悯</char>子孙，<char style="pn">以法莲</char>和<char style="pn">玛拿西</char>子孙。<verse eid="1CH 9:3" /></para>
  <para style="mi">
    <verse number="4" style="v" sid="1CH 9:4" />
    <char style="pn">犹大</char>儿子<char style="pn">法勒斯</char>的子孙中有<char style="pn">乌塔伊</char>，他是<char style="pn">亚米忽</char>的儿子、<char style="pn">欧姆利</char>的孙子、<char style="pn">伊姆利</char>的曾孙、<char style="pn">巴尼</char>的玄孙；<verse eid="1CH 9:4" /></para>
  <para style="mi">
    <verse number="5" style="v" sid="1CH 9:5" />
    <char style="pn">示拉</char>的子孙<note caller="+" style="f"><char style="fr" closed="false">9:5 </char><char style="ft" closed="false">示拉的子孙——或译作“示罗人”。</char></note>中有长子<char style="pn">亚撒雅</char>和他的儿子们；<verse eid="1CH 9:5" /></para>
  <para style="mi">
    <verse number="6" style="v" sid="1CH 9:6" />
    <char style="pn">谢拉</char>的子孙中有<char style="pn">耶乌利</char>；</para>
  <para style="mi" vid="1CH 9:6">还有他们的族兄弟，共六百九十人。<verse eid="1CH 9:6" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="7" style="v" sid="1CH 9:7" />
    <char style="pn">便雅悯</char>的子孙中有<char style="pn">萨鲁</char>，他是<char style="pn">米书兰</char>的儿子、<char style="pn">赫达维亚</char>的孙子，<char style="pn">哈西努亚</char>的曾孙；<verse eid="1CH 9:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="1CH 9:8" />又有<char style="pn">伊比尼雅</char>，他是<char style="pn">耶罗罕</char>的儿子；</para>
  <para style="mi" vid="1CH 9:8">又有<char style="pn">以拉</char>，他是<char style="pn">乌基</char>的儿子、<char style="pn">米基立</char>的孙子；</para>
  <para style="mi" vid="1CH 9:8">又有<char style="pn">米书兰</char>，他是<char style="pn">示法提雅</char>的儿子、<char style="pn">流珥</char>的孙子、<char style="pn">伊比尼雅</char>的曾孙；<verse eid="1CH 9:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="1CH 9:9" />还有他们的族兄弟，按着谱系共九百五十六人。</para>
  <para style="mi" vid="1CH 9:9">这些人都是他们父家各父系的首领。<verse eid="1CH 9:9" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="10" style="v" sid="1CH 9:10" />祭司中有<char style="pn">耶达亚</char>、<char style="pn">耶赫亚利</char>、<char style="pn">雅斤</char>；<verse eid="1CH 9:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="1CH 9:11" />又有神殿总管<char style="pn">亚撒利雅</char>，他是<char style="pn">希勒加</char>的儿子、<char style="pn">米书兰</char>的孙子、<char style="pn">撒督</char>的曾孙、<char style="pn">米拉约</char>的玄孙、<char style="pn">亚希突</char>的来孙；<verse eid="1CH 9:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="1CH 9:12" />又有<char style="pn">亚达雅</char>，他是<char style="pn">耶罗罕</char>的儿子、<char style="pn">帕示户珥</char>的孙子、<char style="pn">玛基雅</char>的曾孙；</para>
  <para style="mi" vid="1CH 9:12">又有<char style="pn">玛萨伊</char>，他是<char style="pn">亚迪业</char>的儿子、<char style="pn">雅赫则拉</char>的孙子、<char style="pn">米书兰</char>的曾孙、<char style="pn">米实列莫</char>的玄孙、<char style="pn">伊梅尔</char>的来孙；<verse eid="1CH 9:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 9:13" />还有他们的族兄弟。他们都是父家的首领，共一千七百六十人，是在神殿的服事工作上有能力的人。<verse eid="1CH 9:13" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="14" style="v" sid="1CH 9:14" />
    <char style="pn">利未</char>人中有<char style="pn">示玛雅</char>，他是<char style="pn">哈述</char>的儿子、<char style="pn">亚斯利甘</char>的孙子、<char style="pn">哈沙比雅</char>的曾孙，属<char style="pn">米拉利</char>的后裔；<verse eid="1CH 9:14" /></para>
  <para style="mi">
    <verse number="15" style="v" sid="1CH 9:15" />又有<char style="pn">巴赫巴克</char>、<char style="pn">赫列示</char>、<char style="pn">迦拉</char>和<char style="pn">玛塔尼亚</char>，<char style="pn">玛塔尼亚</char>是<char style="pn">米迦</char>的儿子、<char style="pn">泽克利</char>的孙子、<char style="pn">亚萨</char>的曾孙；<verse eid="1CH 9:15" /></para>
  <para style="mi">
    <verse number="16" style="v" sid="1CH 9:16" />又有<char style="pn">俄巴底亚</char>，他是<char style="pn">示玛雅</char>的儿子、<char style="pn">迦拉</char>的孙子、<char style="pn">耶杜顿</char>的曾孙；</para>
  <para style="mi" vid="1CH 9:16">还有<char style="pn">比利迦</char>，他是<char style="pn">亚撒</char>的儿子、<char style="pn">以利加拿</char>的孙子。</para>
  <para style="mi" vid="1CH 9:16">他们都住在<char style="pn">尼托法</char>人的村庄。<verse eid="1CH 9:16" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="17" style="v" sid="1CH 9:17" />门卫有<char style="pn">沙勒姆</char>、<char style="pn">阿库布</char>、<char style="pn">达门</char>、<char style="pn">亚希幔</char>以及他们的族兄弟，</para>
  <para style="mi" vid="1CH 9:17">
    <char style="pn">沙勒姆</char>是首领， <verse eid="1CH 9:17" /><verse number="18" style="v" sid="1CH 9:18" />他们看守东边的王门直到如今；他们曾经是<char style="pn">利未</char>人营地的门卫。<verse eid="1CH 9:18" /></para>
  <para style="mi">
    <verse number="19" style="v" sid="1CH 9:19" />
    <char style="pn">沙勒姆</char>是<char style="pn">可列</char>的儿子、<char style="pn">伊比雅撒</char>的孙子、<char style="pn">可拉</char>的曾孙；他和父家的族兄弟<char style="pn">可拉</char>子孙一起负责服事工作，看守会幕的门。他们的祖先曾经负责耶和华的营地，看守营地的入口； <verse eid="1CH 9:19" /><verse number="20" style="v" sid="1CH 9:20" />从前<char style="pn">以利亚撒</char>的儿子<char style="pn">非尼哈</char>是他们的领袖，耶和华与他同在。<verse eid="1CH 9:20" /></para>
  <para style="mi">
    <verse number="21" style="v" sid="1CH 9:21" />
    <char style="pn">米施利米雅</char>的儿子<char style="pn">撒迦利亚</char>是会幕入口的门卫。<verse eid="1CH 9:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="1CH 9:22" />这些被选作门卫的，共两百一十二人。他们在自己的村庄里被记录了家谱，他们是<char style="pn">大卫</char>和先见<char style="pn">撒母耳</char>所指定委任的。 <verse eid="1CH 9:22" /><verse number="23" style="v" sid="1CH 9:23" />他们和他们的子孙负责在耶和华殿，也就是会幕的门口履行职责。 <verse eid="1CH 9:23" /><verse number="24" style="v" sid="1CH 9:24" />东、西、南、北四方都有门卫； <verse eid="1CH 9:24" /><verse number="25" style="v" sid="1CH 9:25" />他们那些在村庄里的族兄弟，每七天定时来与他们同工。 <verse eid="1CH 9:25" /><verse number="26" style="v" sid="1CH 9:26" />至于四个受委任作门卫长的，他们是<char style="pn">利未</char>人，负责神殿的房间和库房。 <verse eid="1CH 9:26" /><verse number="27" style="v" sid="1CH 9:27" />他们在神殿四围过夜，因为他们负责看守，并且保管钥匙，要每天早晨开门。<verse eid="1CH 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28" />
    <char style="pn">利未</char>人中，有一些人管理服事用的器具：按照数目拿出去，也要按照数目送回来。 <verse eid="1CH 9:28" /><verse number="29" style="v" sid="1CH 9:29" />还有一些人被指定管理器具，就是圣所的一切器具，以及细面粉、酒、油、乳香和香料。 <verse eid="1CH 9:29" /><verse number="30" style="v" sid="1CH 9:30" />祭司成员中，有一些人负责用香料调制膏油。 <verse eid="1CH 9:30" /><verse number="31" style="v" sid="1CH 9:31" /><char style="pn">利未</char>人<char style="pn">玛塔提雅</char>是<char style="pn">可拉</char>子孙<char style="pn">沙勒姆</char>的长子，他受委任管理烤饼的工作。 <verse eid="1CH 9:31" /><verse number="32" style="v" sid="1CH 9:32" />他们的族兄弟<char style="pn">哥辖</char>子孙中，有一些人负责为每个安息日预备陈设饼。<verse eid="1CH 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33" />至于那些歌手，是<char style="pn">利未</char>人各父系的首领，住在圣殿的公房里，免于其他事务，因为要日夜担负本职工作。 <verse eid="1CH 9:33" /><verse number="34" style="v" sid="1CH 9:34" />这些人都是<char style="pn">利未</char>人各父系的首领，在他们的谱系中为首。他们住在<char style="pn">耶路撒冷</char>。<verse eid="1CH 9:34" /></para>
  <para style="b" />
  <para style="s">扫罗家族</para>
  <para style="mi">
    <verse number="35" style="v" sid="1CH 9:35" />
    <char style="pn">基遍</char>之祖<char style="pn">耶伊列</char>住在<char style="pn">基遍</char>，他的妻子名叫<char style="pn">玛迦</char>。 <verse eid="1CH 9:35" /><verse number="36" style="v" sid="1CH 9:36" />他的长子是<char style="pn">阿布顿</char>，然后是<char style="pn">苏珥</char>、<char style="pn">基士</char>、<char style="pn">巴力</char>、<char style="pn">尼珥</char>、<char style="pn">纳达布</char>、 <verse eid="1CH 9:36" /><verse number="37" style="v" sid="1CH 9:37" /><char style="pn">格多</char>、<char style="pn">亚希约</char>、<char style="pn">撒迦利亚</char>和<char style="pn">米克罗</char>； <verse eid="1CH 9:37" /><verse number="38" style="v" sid="1CH 9:38" /><char style="pn">米克罗</char>生了<char style="pn">示米亚</char>。他们也与族兄弟一同住在<char style="pn">耶路撒冷</char>，在他们众兄弟对面。<verse eid="1CH 9:38" /></para>
  <para style="mi">
    <verse number="39" style="v" sid="1CH 9:39" />
    <char style="pn">尼珥</char>生<char style="pn">基士</char>，<char style="pn">基士</char>生<char style="pn">扫罗</char>，<char style="pn">扫罗</char>生了<char style="pn">约拿单</char>、<char style="pn">麦基舒亚</char>、<char style="pn">亚比拿达</char>和<char style="pn">伊施巴力</char>。<verse eid="1CH 9:39" /></para>
  <para style="mi">
    <verse number="40" style="v" sid="1CH 9:40" />
    <char style="pn">约拿单</char>的儿子是<char style="pn">米力巴力</char>，<char style="pn">米力巴力</char>生了<char style="pn">米迦</char>。<verse eid="1CH 9:40" /></para>
  <para style="mi">
    <verse number="41" style="v" sid="1CH 9:41" />
    <char style="pn">米迦</char>的儿子是<char style="pn">皮敦</char>、<char style="pn">米勒</char>、<char style="pn">塔利亚</char>、 <verse eid="1CH 9:41" /><verse number="42" style="v" sid="1CH 9:42" /><char style="pn">亚哈斯</char>。</para>
  <para style="mi" vid="1CH 9:42">
    <char style="pn">亚哈斯</char>生<char style="pn">雅拉</char><note caller="+" style="f"><char style="fr" closed="false">9:42 </char><char style="ft" closed="false">雅拉——有古抄本和古译本作“约阿达”；参《历代志上》8:36。</char></note>，<char style="pn">雅拉</char>生<char style="pn">阿勒米特</char>、<char style="pn">阿兹玛维</char>和<char style="pn">泽姆利</char>，</para>
  <para style="mi" vid="1CH 9:42">
    <char style="pn">泽姆利</char>生<char style="pn">莫扎</char>， <verse eid="1CH 9:42" /><verse number="43" style="v" sid="1CH 9:43" /><char style="pn">莫扎</char>生<char style="pn">比尼亚</char>，</para>
  <para style="mi" vid="1CH 9:43">
    <char style="pn">比尼亚</char>的儿子是<char style="pn">勒法雅</char>，<char style="pn">勒法雅</char>的儿子是<char style="pn">以利亚萨</char>，<char style="pn">以利亚萨</char>的儿子是<char style="pn">亚悉</char>。<verse eid="1CH 9:43" /></para>
  <para style="mi">
    <verse number="44" style="v" sid="1CH 9:44" />
    <char style="pn">亚悉</char>有六个儿子，以下是他们的名字：<char style="pn">亚斯利甘</char>、<char style="pn">波基路</char>、<char style="pn">以实玛利</char>、<char style="pn">示亚利雅</char>、<char style="pn">俄巴底亚</char>和<char style="pn">哈南</char>，这些都是<char style="pn">亚悉</char>的儿子。<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" sid="1CH 10" />
  <para style="s">扫罗与儿子们之死</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1" />
    <char style="pn">非利士</char>人与<char style="pn">以色列</char>人争战，<char style="pn">以色列</char>人从<char style="pn">非利士</char>人面前逃跑，被杀的人倒在<char style="pn">基利波</char>山上。 <verse eid="1CH 10:1" /><verse number="2" style="v" sid="1CH 10:2" /><char style="pn">非利士</char>人追上<char style="pn">扫罗</char>和他的儿子们，<char style="pn">非利士</char>人杀死了<char style="pn">扫罗</char>的儿子<char style="pn">约拿单</char>、<char style="pn">亚比拿达</char>和<char style="pn">麦基舒亚</char>。 <verse eid="1CH 10:2" /><verse number="3" style="v" sid="1CH 10:3" /><char style="pn">扫罗</char>遭到猛烈的攻击，弓箭手射中了他，他受到射手的重创。 <verse eid="1CH 10:3" /><verse number="4" style="v" sid="1CH 10:4" /><char style="pn">扫罗</char>对替他拿兵器的说：“拔出你的刀来，把我刺死！免得这些未受割礼的人来折辱我。”但拿兵器的人不肯，因为他极其害怕。于是<char style="pn">扫罗</char>拿起刀，伏在刀上。 <verse eid="1CH 10:4" /><verse number="5" style="v" sid="1CH 10:5" />替他拿兵器的看见<char style="pn">扫罗</char>死了，自己也伏在刀上死了。 <verse eid="1CH 10:5" /><verse number="6" style="v" sid="1CH 10:6" />这样，<char style="pn">扫罗</char>和他三个儿子死了，还有他的家人全都死了。<verse eid="1CH 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7" />所有在平原的<char style="pn">以色列</char>人，看到<char style="pn">以色列</char>人逃跑，并且<char style="pn">扫罗</char>和他儿子们死了，他们就弃城逃跑。于是<char style="pn">非利士</char>人来住在其中。<verse eid="1CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8" />第二天，<char style="pn">非利士</char>人来剥去被杀之人的衣物，发现<char style="pn">扫罗</char>和他儿子们倒在<char style="pn">基利波</char>山上。 <verse eid="1CH 10:8" /><verse number="9" style="v" sid="1CH 10:9" />他们就剥去他的衣物，拿了他的头颅和装备，然后派人到<char style="pn">非利士</char>地的四境，向他们的偶像和民众传扬这好消息。 <verse eid="1CH 10:9" /><verse number="10" style="v" sid="1CH 10:10" />他们把<char style="pn">扫罗</char>的装备放在他们神明的庙宇里，把他的头颅钉在<char style="pn">大衮</char>的庙宇中。<verse eid="1CH 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11" />
    <char style="pn">基列-雅比</char>的人都听说了<char style="pn">非利士</char>人对<char style="pn">扫罗</char>所做的这一切事， <verse eid="1CH 10:11" /><verse number="12" style="v" sid="1CH 10:12" />勇士们就都动身，取回<char style="pn">扫罗</char>的尸体和他儿子们的尸体，带到<char style="pn">雅比</char>，把他们的骸骨葬在<char style="pn">雅比</char>的那棵橡树下，并且禁食七天。<verse eid="1CH 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13" />
    <char style="pn">扫罗</char>死了，因他对耶和华行事不忠，不遵守耶和华的话语，甚至去找一个招魂的求问， <verse eid="1CH 10:13" /><verse number="14" style="v" sid="1CH 10:14" />而没有求问耶和华，所以耶和华使他被杀，把王位转归于<char style="pn">耶西</char>的儿子<char style="pn">大卫</char>。<verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" sid="1CH 11" />
  <para style="s">大卫受膏为王</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1" />全体<char style="pn">以色列</char>人聚集到<char style="pn">希伯仑</char>来见<char style="pn">大卫</char>，说：“看哪，我们是你的骨肉之亲。 <verse eid="1CH 11:1" /><verse number="2" style="v" sid="1CH 11:2" />从前<char style="pn">扫罗</char>作王的时候，带领<char style="pn">以色列</char>出入的就是你，你的神耶和华也曾对你说：‘你要牧养我的子民<char style="pn">以色列</char>，你要作我的子民<char style="pn">以色列</char>的领袖。’”<verse eid="1CH 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3" />
    <char style="pn">以色列</char>的长老们都来到<char style="pn">希伯仑</char>见王，<char style="pn">大卫</char>在<char style="pn">希伯仑</char>，在耶和华面前与他们立约，他们就膏立<char style="pn">大卫</char>作<char style="pn">以色列</char>的王，正如耶和华藉着<char style="pn">撒母耳</char>所传的话。<verse eid="1CH 11:3" /></para>
  <para style="s">大卫攻取耶路撒冷</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4" />
    <char style="pn">大卫</char>和<char style="pn">以色列</char>全军来到<char style="pn">耶路撒冷</char>——就是<char style="pn">耶布斯</char>，那地的居民都是<char style="pn">耶布斯</char>人。 <verse eid="1CH 11:4" /><verse number="5" style="v" sid="1CH 11:5" /><char style="pn">耶布斯</char>的居民对<char style="pn">大卫</char>说：“你进不到这里来！”然而<char style="pn">大卫</char>攻取了<char style="pn">锡安</char>的堡垒，就是后来的<char style="pn">大卫</char>城。<verse eid="1CH 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 11:6" />
    <char style="pn">大卫</char>说：“谁先击杀<char style="pn">耶布斯</char>人，他就作元帅，作首领。”<char style="pn">洗鲁雅</char>的儿子<char style="pn">约押</char>先攻上去，就作了元帅。<verse eid="1CH 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 11:7" />
    <char style="pn">大卫</char>住在这堡垒里，因此人们称它为“<char style="pn">大卫</char>城”。 <verse eid="1CH 11:7" /><verse number="8" style="v" sid="1CH 11:8" /><char style="pn">大卫</char>把城的周围建造起来，从梯垒直到四围城墙；<char style="pn">约押</char>修复城其余的部分。 <verse eid="1CH 11:8" /><verse number="9" style="v" sid="1CH 11:9" /><char style="pn">大卫</char>越来越强大，因为万军之耶和华与他同在。<verse eid="1CH 11:9" /></para>
  <para style="s">大卫的勇士们</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10" />这些是<char style="pn">大卫</char>勇士们的首领，就是与全<char style="pn">以色列</char>一同极力拥护他王权的人，他们照着耶和华所应许<char style="pn">以色列</char>的，立他为王。 <verse eid="1CH 11:10" /><verse number="11" style="v" sid="1CH 11:11" />以下是<char style="pn">大卫</char>的勇士们的名单：</para>
  <para style="p" vid="1CH 11:11">
    <char style="pn">哈克莫尼</char>人<char style="pn">雅朔班</char>，是众军官<note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="ft" closed="false">众军官——或译作“三十勇士”。</char></note>之首，他曾挥动长矛，一次击杀了三百人。<verse eid="1CH 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12" />其次是<char style="pn">阿赫阿</char>人<char style="pn">朵多</char>的儿子<char style="pn">以利亚撒</char>，他是三勇士之一。 <verse eid="1CH 11:12" /><verse number="13" style="v" sid="1CH 11:13" />从前他与<char style="pn">大卫</char>在<char style="pn">巴斯达悯</char>，<char style="pn">非利士</char>人聚集在那里要打仗，那里有一块长满了大麦的田地。<char style="pn">以色列</char>军兵从<char style="pn">非利士</char>人面前逃跑， <verse eid="1CH 11:13" /><verse number="14" style="v" sid="1CH 11:14" />他们却在那块田中站立，守护那块田，击杀<char style="pn">非利士</char>人。这样耶和华施行了大拯救。<verse eid="1CH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15" />有一次，三十个首领中的那三个人下去，到<char style="pn">亚杜兰</char>山洞的磐石那里去见<char style="pn">大卫</char>。<char style="pn">非利士</char>人的军队在<char style="pn">利乏音</char>谷扎营。 <verse eid="1CH 11:15" /><verse number="16" style="v" sid="1CH 11:16" />那时<char style="pn">大卫</char>在要塞中，而<char style="pn">非利士</char>人的驻军在<char style="pn">伯利恒</char>。 <verse eid="1CH 11:16" /><verse number="17" style="v" sid="1CH 11:17" /><char style="pn">大卫</char>心中渴望，说：“谁能把<char style="pn">伯利恒</char>城门旁水窖里的水带来给我喝啊！” <verse eid="1CH 11:17" /><verse number="18" style="v" sid="1CH 11:18" />那三个人就突破<char style="pn">非利士</char>人的防营，从<char style="pn">伯利恒</char>城门旁的水窖里打水，提上来，带回<char style="pn">大卫</char>那里。但<char style="pn">大卫</char>不肯喝，而是把水浇奠在耶和华面前， <verse eid="1CH 11:18" /><verse number="19" style="v" sid="1CH 11:19" />说：“我绝不可在我的神面前做这事！我怎么能喝那些冒生命危险之人的血呢？这水是他们冒着生命危险取回来的。”所以<char style="pn">大卫</char>不肯喝。这些是三勇士的事迹。<verse eid="1CH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20" />
    <char style="pn">约押</char>的弟弟<char style="pn">亚比筛</char>，是三十<note caller="+" style="f"><char style="fr" closed="false">11:20 </char><char style="ft" closed="false">三十—— 依据古叙利亚文译本；马索拉文本作“三”。</char></note>勇士之首；他曾挥动长矛杀了三百人，所以和那三勇士一样有名。 <verse eid="1CH 11:20" /><verse number="21" style="v" sid="1CH 11:21" />他在三十<note caller="+" style="f"><char style="fr" closed="false">11:21 </char><char style="ft" closed="false">三十—— 依据古叙利亚文译本；马索拉文本作“三”。</char></note>勇士中倍受尊崇，所以成为他们的首领，只是不及那三勇士。<verse eid="1CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22" />
    <char style="pn">耶赫亚达</char>的儿子<char style="pn">比纳雅</char>，是来自<char style="pn">卡布策勒</char>的勇士，有许多事迹。他曾击杀了<char style="pn">摩押</char>的两个英雄，也曾在下雪的日子，下到坑里杀了一只狮子。 <verse eid="1CH 11:22" /><verse number="23" style="v" sid="1CH 11:23" />他还击杀了一个身高五肘<note caller="+" style="f"><char style="fr" closed="false">11:23 </char><char style="ft" closed="false">五肘——相当于2.3公尺。1肘=45.7公分。</char></note>的<char style="pn">埃及</char>人；这<char style="pn">埃及</char>人手中有长矛，<char style="pn">比纳雅</char>却拿着棍子下去攻击他，从他手中抢夺了长矛，用那长矛把他杀了。 <verse eid="1CH 11:23" /><verse number="24" style="v" sid="1CH 11:24" />这些是<char style="pn">耶赫亚达</char>的儿子<char style="pn">比纳雅</char>的事迹，他和三勇士一样有名。 <verse eid="1CH 11:24" /><verse number="25" style="v" sid="1CH 11:25" />看哪，他在三十勇士中受尊崇，但是不及那三勇士。<char style="pn">大卫</char>立他作侍卫长。<verse eid="1CH 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 11:26" />军队中的勇士有：</para>
  <para style="mi" vid="1CH 11:26">
    <char style="pn">约押</char>的弟弟<char style="pn">亚撒晖</char>，</para>
  <para style="mi" vid="1CH 11:26">
    <char style="pn">伯利恒</char>人<char style="pn">朵多</char>的儿子<char style="pn">伊勒哈南</char>，<verse eid="1CH 11:26" /></para>
  <para style="mi">
    <verse number="27" style="v" sid="1CH 11:27" />
    <char style="pn">哈律</char>人<char style="pn">沙玛</char>，</para>
  <para style="mi" vid="1CH 11:27">
    <char style="pn">佩罗尼</char>人<char style="pn">希利斯</char>，<verse eid="1CH 11:27" /></para>
  <para style="mi">
    <verse number="28" style="v" sid="1CH 11:28" />
    <char style="pn">提克亚</char>人<char style="pn">益吉</char>的儿子<char style="pn">伊拉</char>，</para>
  <para style="mi" vid="1CH 11:28">
    <char style="pn">亚拿突</char>人<char style="pn">亚比以谢</char>，<verse eid="1CH 11:28" /></para>
  <para style="mi">
    <verse number="29" style="v" sid="1CH 11:29" />
    <char style="pn">户沙</char>人<char style="pn">西比凯</char>，</para>
  <para style="mi" vid="1CH 11:29">
    <char style="pn">阿赫阿</char>人<char style="pn">伊莱</char>，<verse eid="1CH 11:29" /></para>
  <para style="mi">
    <verse number="30" style="v" sid="1CH 11:30" />
    <char style="pn">尼托法</char>人<char style="pn">玛哈莱</char>，</para>
  <para style="mi" vid="1CH 11:30">
    <char style="pn">尼托法</char>人<char style="pn">巴纳</char>的儿子<char style="pn">希勒</char>，<verse eid="1CH 11:30" /></para>
  <para style="mi">
    <verse number="31" style="v" sid="1CH 11:31" />
    <char style="pn">基比亚</char>的<char style="pn">便雅悯</char>人<char style="pn">利拜</char>的儿子<char style="pn">伊太</char>，</para>
  <para style="mi" vid="1CH 11:31">
    <char style="pn">比拉顿</char>人<char style="pn">比纳雅</char>，<verse eid="1CH 11:31" /></para>
  <para style="mi">
    <verse number="32" style="v" sid="1CH 11:32" />
    <char style="pn">迦实</char>溪谷的人<char style="pn">户莱</char>，</para>
  <para style="mi" vid="1CH 11:32">
    <char style="pn">亚拉巴</char>人<char style="pn">亚比耶</char>，<verse eid="1CH 11:32" /></para>
  <para style="mi">
    <verse number="33" style="v" sid="1CH 11:33" />
    <char style="pn">巴鲁米</char>人<char style="pn">阿兹玛维</char>，</para>
  <para style="mi" vid="1CH 11:33">
    <char style="pn">沙本</char>人<char style="pn">以利雅哈巴</char>，<verse eid="1CH 11:33" /></para>
  <para style="mi">
    <verse number="34" style="v" sid="1CH 11:34" />
    <char style="pn">基孙</char>人<char style="pn">哈善</char>的儿子们，</para>
  <para style="mi" vid="1CH 11:34">
    <char style="pn">哈拉</char>人<char style="pn">沙基</char>的儿子<char style="pn">约拿单</char>，<verse eid="1CH 11:34" /></para>
  <para style="mi">
    <verse number="35" style="v" sid="1CH 11:35" />
    <char style="pn">哈拉</char>人<char style="pn">沙卡尔</char>的儿子<char style="pn">亚希暗</char>，</para>
  <para style="mi" vid="1CH 11:35">
    <char style="pn">吾珥</char>的儿子<char style="pn">以利法勒</char>，<verse eid="1CH 11:35" /></para>
  <para style="mi">
    <verse number="36" style="v" sid="1CH 11:36" />
    <char style="pn">米基拉</char>人<char style="pn">希弗</char>，</para>
  <para style="mi" vid="1CH 11:36">
    <char style="pn">佩罗尼</char>人<char style="pn">亚希雅</char>，<verse eid="1CH 11:36" /></para>
  <para style="mi">
    <verse number="37" style="v" sid="1CH 11:37" />
    <char style="pn">迦密</char>人<char style="pn">希斯罗</char>，</para>
  <para style="mi" vid="1CH 11:37">
    <char style="pn">伊斯拜</char>的儿子<char style="pn">拿莱</char>，<verse eid="1CH 11:37" /></para>
  <para style="mi">
    <verse number="38" style="v" sid="1CH 11:38" />
    <char style="pn">拿单</char>的兄弟<char style="pn">约珥</char>，</para>
  <para style="mi" vid="1CH 11:38">
    <char style="pn">哈格利</char>的儿子<char style="pn">弥伯哈</char>，<verse eid="1CH 11:38" /></para>
  <para style="mi">
    <verse number="39" style="v" sid="1CH 11:39" />
    <char style="pn">亚扪</char>人<char style="pn">洗勒</char>，</para>
  <para style="mi" vid="1CH 11:39">替<char style="pn">洗鲁雅</char>之子<char style="pn">约押</char>拿兵器的<char style="pn">比录</char>人<char style="pn">拿哈莱</char>，<verse eid="1CH 11:39" /></para>
  <para style="mi">
    <verse number="40" style="v" sid="1CH 11:40" />
    <char style="pn">以帖</char>人<char style="pn">伊拉</char>，</para>
  <para style="mi" vid="1CH 11:40">
    <char style="pn">以帖</char>人<char style="pn">迦立</char>，<verse eid="1CH 11:40" /></para>
  <para style="mi">
    <verse number="41" style="v" sid="1CH 11:41" />
    <char style="pn">赫提</char>人<char style="pn">乌利亚</char>，</para>
  <para style="mi" vid="1CH 11:41">
    <char style="pn">阿赫莱</char>的儿子<char style="pn">撒巴德</char>，<verse eid="1CH 11:41" /></para>
  <para style="mi">
    <verse number="42" style="v" sid="1CH 11:42" />
    <char style="pn">鲁本</char>人<char style="pn">示撒</char>的儿子<char style="pn">阿迪纳</char>——他是<char style="pn">鲁本</char>支派的一个首领，有三十人跟随他，<verse eid="1CH 11:42" /></para>
  <para style="mi">
    <verse number="43" style="v" sid="1CH 11:43" />
    <char style="pn">玛迦</char>的儿子<char style="pn">哈南</char>，</para>
  <para style="mi" vid="1CH 11:43">
    <char style="pn">弥特尼</char>人<char style="pn">约沙法</char>，<verse eid="1CH 11:43" /></para>
  <para style="mi">
    <verse number="44" style="v" sid="1CH 11:44" />
    <char style="pn">亚施塔拉</char>人<char style="pn">乌西亚</char>，</para>
  <para style="mi" vid="1CH 11:44">
    <char style="pn">亚罗珥</char>人<char style="pn">赫坦</char>的儿子<char style="pn">沙玛</char>和<char style="pn">耶伊列</char>，<verse eid="1CH 11:44" /></para>
  <para style="mi">
    <verse number="45" style="v" sid="1CH 11:45" />
    <char style="pn">提洗</char>人<char style="pn">示姆利</char>的儿子<char style="pn">耶迪阿业</char>和他的兄弟<char style="pn">约哈</char>，<verse eid="1CH 11:45" /></para>
  <para style="mi">
    <verse number="46" style="v" sid="1CH 11:46" />
    <char style="pn">玛哈维</char>人<char style="pn">以利业</char>，</para>
  <para style="mi" vid="1CH 11:46">
    <char style="pn">伊利纳姆</char>的儿子<char style="pn">耶利拜</char>和<char style="pn">约沙维亚</char>，</para>
  <para style="mi" vid="1CH 11:46">
    <char style="pn">摩押</char>人<char style="pn">伊特玛</char>，<verse eid="1CH 11:46" /></para>
  <para style="mi">
    <verse number="47" style="v" sid="1CH 11:47" />还有<char style="pn">以利业</char>、<char style="pn">俄备得</char>和<char style="pn">米琐巴</char>人<char style="pn">雅西业</char>。<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" sid="1CH 12" />
  <para style="s">大卫最初的支持者</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 12:1" />以下是<char style="pn">大卫</char>被迫躲避<char style="pn">基士</char>的儿子<char style="pn">扫罗</char>时，来到<char style="pn">洗革拉大卫</char>那里的人：他们都是勇士，帮助<char style="pn">大卫</char>争战； <verse eid="1CH 12:1" /><verse number="2" style="v" sid="1CH 12:2" />他们装备了弓箭，左右手都能投石、拉弓射箭；他们是<char style="pn">便雅悯</char>人，是<char style="pn">扫罗</char>的族兄弟。<verse eid="1CH 12:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 12:3" />为首的是<char style="pn">亚希以谢</char>，</para>
  <para style="mi" vid="1CH 12:3">其次是<char style="pn">约阿施</char>，</para>
  <para style="mi" vid="1CH 12:3">都是<char style="pn">基比亚</char>人<char style="pn">示米亚</char>的儿子；</para>
  <para style="mi" vid="1CH 12:3">还有<char style="pn">阿兹玛维</char>的儿子<char style="pn">耶薛</char>和<char style="pn">毗力</char>，</para>
  <para style="mi" vid="1CH 12:3">
    <char style="pn">比拉卡</char>，<char style="pn">亚拿突</char>人<char style="pn">耶户</char>，<verse eid="1CH 12:3" /></para>
  <para style="mi">
    <verse number="4" style="v" sid="1CH 12:4" />
    <char style="pn">基遍</char>人<char style="pn">伊施玛雅</char>，他是三十勇士之一，统领那三十人；</para>
  <para style="mi" vid="1CH 12:4">还有<char style="pn">耶利米</char>，<char style="pn">雅哈希</char>，<char style="pn">约哈南</char>，<char style="pn">基得拉</char>人<char style="pn">约撒巴</char>，<verse eid="1CH 12:4" /></para>
  <para style="mi">
    <verse number="5" style="v" sid="1CH 12:5" />
    <char style="pn">伊利乌赛</char>，<char style="pn">耶利莫</char>，<char style="pn">比亚利雅</char>，<char style="pn">示玛利雅</char>，</para>
  <para style="mi" vid="1CH 12:5">
    <char style="pn">哈律弗</char>人<char style="pn">示法提雅</char>，<verse eid="1CH 12:5" /></para>
  <para style="mi">
    <verse number="6" style="v" sid="1CH 12:6" />又有<char style="pn">可拉</char>子孙<char style="pn">以利加拿</char>、<char style="pn">伊示亚</char>、<char style="pn">阿扎列</char>、<char style="pn">约以谢</char>和<char style="pn">雅朔班</char>，<verse eid="1CH 12:6" /></para>
  <para style="mi">
    <verse number="7" style="v" sid="1CH 12:7" />
    <char style="pn">格多</char>人<char style="pn">耶罗罕</char>的儿子<char style="pn">犹拉</char>和<char style="pn">希巴迪亚</char>。<verse eid="1CH 12:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8" />
    <char style="pn">迦得</char>人中也有到旷野的要塞投奔<char style="pn">大卫</char>的，都是能作战的英勇战士，配备盾牌和长矛。他们脸像狮子的脸，速度快如山上的羚羊。<verse eid="1CH 12:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="1CH 12:9" />为首的是<char style="pn">以谢尔</char>，第二是<char style="pn">俄巴底亚</char>，第三是<char style="pn">以利押</char>，<verse eid="1CH 12:9" /></para>
  <para style="mi">
    <verse number="10" style="v" sid="1CH 12:10" />第四是<char style="pn">弥施玛拿</char>，第五是<char style="pn">耶利米</char>，<verse eid="1CH 12:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="1CH 12:11" />第六是<char style="pn">亚泰</char>，第七是<char style="pn">以利业</char>，<verse eid="1CH 12:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="1CH 12:12" />第八是<char style="pn">约哈南</char>，第九是<char style="pn">以利萨巴</char>，<verse eid="1CH 12:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 12:13" />第十是<char style="pn">耶利米</char>，第十一是<char style="pn">末巴奈</char>。<verse eid="1CH 12:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14" />这些都是<char style="pn">迦得</char>子孙，是队伍中的首领，地位最小的带领一百人，最大的带领一千人。 <verse eid="1CH 12:14" /><verse number="15" style="v" sid="1CH 12:15" />这些人曾在一月份河水涨过整个河岸的时候，渡过<char style="pn">约旦</char>河，使全平原的人东奔西逃。<verse eid="1CH 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16" />
    <char style="pn">便雅悯</char>子孙和<char style="pn">犹大</char>子孙中，也有人来到要塞归向<char style="pn">大卫</char>。 <verse eid="1CH 12:16" /><verse number="17" style="v" sid="1CH 12:17" /><char style="pn">大卫</char>出去面见他们，答复他们说：“如果你们是和平地来帮助我，我的心就与你们契合；但如果你们要把我这手无恶行的人出卖给我的敌人，就愿我们祖先的神鉴察、裁决！”<verse eid="1CH 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18" />神的灵临到三十勇士的首领<char style="pn">亚玛赛</char>身上<note caller="+" style="f"><char style="fr" closed="false">12:18 </char><char style="ft" closed="false">临到……身上——或译作“覆盖”。</char></note>，他说：</para>
  <para style="q1" vid="1CH 12:18">“<char style="pn">大卫</char>啊，我们是来归向你的；</para>
  <para style="q1" vid="1CH 12:18">
    <char style="pn">耶西</char>的儿子啊，我们是拥护你的。</para>
  <para style="q1" vid="1CH 12:18">平安！愿你平安，</para>
  <para style="q1" vid="1CH 12:18">愿帮助你的也都平安，</para>
  <para style="q1" vid="1CH 12:18">因为你的神帮助你。”</para>
  <para style="m" vid="1CH 12:18">
    <char style="pn">大卫</char>就接收他们，委任他们作部队首领。<verse eid="1CH 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19" />
    <char style="pn">玛拿西</char>人中也有来投靠<char style="pn">大卫</char>的。当时<char style="pn">大卫</char>要随同<char style="pn">非利士</char>人去与<char style="pn">扫罗</char>作战，但后来他没有帮助<char style="pn">非利士</char>人，因为<char style="pn">非利士</char>的首领们商议后驱逐了他，说“恐怕<char style="pn">大卫</char>会拿我们的头颅去归降他主人<char style="pn">扫罗</char>”。 <verse eid="1CH 12:19" /><verse number="20" style="v" sid="1CH 12:20" /><char style="pn">大卫</char>回到<char style="pn">洗革拉</char>的时候，<char style="pn">玛拿西</char>人<char style="pn">阿德纳</char>、<char style="pn">约撒巴</char>、<char style="pn">耶迪阿业</char>、<char style="pn">米迦勒</char>、<char style="pn">约撒巴</char>、<char style="pn">以利户</char>和<char style="pn">洗勒太</char>来投靠他，他们都是<char style="pn">玛拿西</char>人的千夫长。 <verse eid="1CH 12:20" /><verse number="21" style="v" sid="1CH 12:21" />他们帮助<char style="pn">大卫</char>打击匪徒，他们全都是英勇的战士，是军队的将领。 <verse eid="1CH 12:21" /><verse number="22" style="v" sid="1CH 12:22" />那时每天都有人来归向<char style="pn">大卫</char>，要帮助他，以至他们成为一支大军，像神的军队那样。<verse eid="1CH 12:22" /></para>
  <para style="s">大卫在希伯仑的队伍</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 12:23" />有全副武装的队伍来到<char style="pn">希伯仑大卫</char>那里，要照着耶和华的吩咐把<char style="pn">扫罗</char>的王权转归于<char style="pn">大卫</char>，他们的人数如下：<verse eid="1CH 12:23" /></para>
  <para style="mi">
    <verse number="24" style="v" sid="1CH 12:24" />
    <char style="pn">犹大</char>子孙中，拿盾牌和长矛的武装队伍有六千八百人。<verse eid="1CH 12:24" /></para>
  <para style="mi">
    <verse number="25" style="v" sid="1CH 12:25" />
    <char style="pn">西缅</char>子孙中，英勇善战的人有七千一百。<verse eid="1CH 12:25" /></para>
  <para style="mi">
    <verse number="26" style="v" sid="1CH 12:26" />
    <char style="pn">利未</char>子孙中，有四千六百人。 <verse eid="1CH 12:26" /><verse number="27" style="v" sid="1CH 12:27" /><char style="pn">耶赫亚达</char>是<char style="pn">亚伦</char>子孙的领袖，跟从他的有三千七百人； <verse eid="1CH 12:27" /><verse number="28" style="v" sid="1CH 12:28" />还有年轻、英勇的战士<char style="pn">撒督</char>，以及他父家的二十二个将领。<verse eid="1CH 12:28" /></para>
  <para style="mi">
    <verse number="29" style="v" sid="1CH 12:29" />
    <char style="pn">便雅悯</char>子孙——<char style="pn">扫罗</char>的族兄弟中有三千人，直到那时他们大多数人仍然忠于<char style="pn">扫罗</char>家。<verse eid="1CH 12:29" /></para>
  <para style="mi">
    <verse number="30" style="v" sid="1CH 12:30" />
    <char style="pn">以法莲</char>子孙中，有两万零八百人，都是英勇的战士，在他们父家是有名望的人。<verse eid="1CH 12:30" /></para>
  <para style="mi">
    <verse number="31" style="v" sid="1CH 12:31" />
    <char style="pn">玛拿西</char>半支派中，被列入名单的有一万八千人，都来拥立<char style="pn">大卫</char>作王。<verse eid="1CH 12:31" /></para>
  <para style="mi">
    <verse number="32" style="v" sid="1CH 12:32" />
    <char style="pn">以萨迦</char>子孙中，有两百个首领，都洞察时务、知道<char style="pn">以色列</char>该做什么；他们所有的族兄弟都听从他们的吩咐。<verse eid="1CH 12:32" /></para>
  <para style="mi">
    <verse number="33" style="v" sid="1CH 12:33" />
    <char style="pn">西布伦</char>支派中，装备各样武器能列阵出战的有五万人，都是不怀二心来助战的。<verse eid="1CH 12:33" /></para>
  <para style="mi">
    <verse number="34" style="v" sid="1CH 12:34" />
    <char style="pn">拿弗他利</char>支派中，有一千个将领，跟随他们带着盾牌和长矛的，有三万七千人。<verse eid="1CH 12:34" /></para>
  <para style="mi">
    <verse number="35" style="v" sid="1CH 12:35" />
    <char style="pn">但</char>支派中，能列阵出战的有两万八千六百人。<verse eid="1CH 12:35" /></para>
  <para style="mi">
    <verse number="36" style="v" sid="1CH 12:36" />
    <char style="pn">亚设</char>支派中，能列阵出战的有四万人。<verse eid="1CH 12:36" /></para>
  <para style="mi">
    <verse number="37" style="v" sid="1CH 12:37" />在<char style="pn">约旦</char>河东岸，<char style="pn">鲁本</char>支派、<char style="pn">迦得</char>支派和<char style="pn">玛拿西</char>半支派中，装备各样武器作战的军队有十二万人。<verse eid="1CH 12:37" /></para>
  <para style="b" />
  <para style="p">
    <verse number="38" style="v" sid="1CH 12:38" />所有这些战士队列整齐，来<char style="pn">希伯仑</char>全心拥立<char style="pn">大卫</char>作全<char style="pn">以色列</char>的王；<char style="pn">以色列</char>其余的人也都一心要<char style="pn">大卫</char>作王。 <verse eid="1CH 12:38" /><verse number="39" style="v" sid="1CH 12:39" />他们在那里三天，与<char style="pn">大卫</char>一同吃喝，他们的族兄弟为他们预备了一切。 <verse eid="1CH 12:39" /><verse number="40" style="v" sid="1CH 12:40" />还有他们附近的人，甚至从<char style="pn">以萨迦</char>、<char style="pn">西布伦</char>和<char style="pn">拿弗他利</char>来的人，用驴子、骆驼、骡子和牛运来食物，有大量的面饼、无花果饼、葡萄饼、酒、油、牛、羊，因为在<char style="pn">以色列</char>充满了喜乐。<verse eid="1CH 12:40" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" sid="1CH 13" />
  <para style="s">大卫迁移约柜</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1" />
    <char style="pn">大卫</char>与千夫长、百夫长和所有的领袖一同商议， <verse eid="1CH 13:1" /><verse number="2" style="v" sid="1CH 13:2" />然后<char style="pn">大卫</char>对<char style="pn">以色列</char>全体会众说：“如果你们认为好，认为这事出于耶和华我们的神，我们就各处派人，去见仍留在<char style="pn">以色列</char>各地的同胞，以及与他们一起住在有牧野之城的祭司和<char style="pn">利未</char>人，让他们聚集到我们这里来， <verse eid="1CH 13:2" /><verse number="3" style="v" sid="1CH 13:3" />然后我们把我们神的约柜带回到这里。因为<char style="pn">扫罗</char>年间，我们一直没有求问神。” <verse eid="1CH 13:3" /><verse number="4" style="v" sid="1CH 13:4" />全体会众都同意这样做，因为这事在全体民众眼中看为好。<verse eid="1CH 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5" />于是<char style="pn">大卫</char>把全体<char style="pn">以色列</char>人从<char style="pn">埃及</char>的<char style="pn">西赫</char>河直到<char style="pn">哈马</char>隘口都招聚起来，要把神的约柜从<char style="pn">基列-耶琳</char>接来。 <verse eid="1CH 13:5" /><verse number="6" style="v" sid="1CH 13:6" /><char style="pn">大卫</char>与全体<char style="pn">以色列</char>人前往<char style="pn">巴阿拉</char>，就是属于<char style="pn">犹大</char>的<char style="pn">基列-耶琳</char>，要把神的约柜从那里抬上来；这约柜是以坐在基路伯之上的耶和华而命名的。 <verse eid="1CH 13:6" /><verse number="7" style="v" sid="1CH 13:7" />他们把神的约柜安放在一辆新车上，从<char style="pn">亚比拿达</char>家里运出来，由<char style="pn">乌撒</char>和<char style="pn">亚希约</char>引领着车。<verse eid="1CH 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 13:8" />
    <char style="pn">大卫</char>和全体<char style="pn">以色列</char>人伴着竖琴、里拉琴、铃鼓、铜钹和号筒，在神面前极力欢庆、歌唱。 <verse eid="1CH 13:8" /><verse number="9" style="v" sid="1CH 13:9" />当他们来到<char style="pn">基顿</char>禾场时，牛绊了一下，<char style="pn">乌撒</char>就伸手扶住约柜。 <verse eid="1CH 13:9" /><verse number="10" style="v" sid="1CH 13:10" />于是耶和华的怒气向<char style="pn">乌撒</char>发作，击杀了他，因为他伸手扶住了约柜；他就当场死在神面前。<verse eid="1CH 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11" />
    <char style="pn">大卫</char>很恼火，因为耶和华向<char style="pn">乌撒</char>怒气爆发。因此那地方被称为<char style="pn">佩勒斯-乌撒</char>，直到今日。 <verse eid="1CH 13:11" /><verse number="12" style="v" sid="1CH 13:12" />那一天，<char style="pn">大卫</char>惧怕神，说：“我怎能把神的约柜接到我这里来呢？” <verse eid="1CH 13:12" /><verse number="13" style="v" sid="1CH 13:13" />因此<char style="pn">大卫</char>没有把约柜迁移到<char style="pn">大卫</char>城自己那里，而是把它转运到<char style="pn">迦特</char>人<char style="pn">俄别·以东</char>的家。 <verse eid="1CH 13:13" /><verse number="14" style="v" sid="1CH 13:14" />神的约柜与<char style="pn">俄别·以东</char>一家同在，停留在他家三个月，耶和华祝福了<char style="pn">俄别·以东</char>的家和一切属于他的。<verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" sid="1CH 14" />
  <para style="s">神祝福大卫</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1" />
    <char style="pn">提尔</char>王<char style="pn">希兰</char>派遣使者到<char style="pn">大卫</char>那里，送来香柏木、石匠和木匠，要为他建造宫殿。 <verse eid="1CH 14:1" /><verse number="2" style="v" sid="1CH 14:2" /><char style="pn">大卫</char>知道耶和华已经坚立他为<char style="pn">以色列</char>的王，并且为自己的子民<char style="pn">以色列</char>的缘故，高抬他的王权。<verse eid="1CH 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3" />
    <char style="pn">大卫</char>在<char style="pn">耶路撒冷</char>又娶了妻妾，生了更多儿女。 <verse eid="1CH 14:3" /><verse number="4" style="v" sid="1CH 14:4" />他在<char style="pn">耶路撒冷</char>所生的儿子名字如下：<char style="pn">沙慕亚</char>、<char style="pn">朔罢</char>、<char style="pn">拿单</char>、<char style="pn">所罗门</char>、 <verse eid="1CH 14:4" /><verse number="5" style="v" sid="1CH 14:5" /><char style="pn">益辖</char>、<char style="pn">以利书亚</char>、<char style="pn">以勒佩列</char>、 <verse eid="1CH 14:5" /><verse number="6" style="v" sid="1CH 14:6" /><char style="pn">挪迦</char>、<char style="pn">尼斐</char>、<char style="pn">雅非亚</char>、 <verse eid="1CH 14:6" /><verse number="7" style="v" sid="1CH 14:7" /><char style="pn">以利沙玛</char>、<char style="pn">比利雅大</char>、<char style="pn">以利菲列</char>。<verse eid="1CH 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8" />
    <char style="pn">非利士</char>人听说<char style="pn">大卫</char>被膏立为全<char style="pn">以色列</char>的王，<char style="pn">非利士</char>全军就上来寻索<char style="pn">大卫</char>。<char style="pn">大卫</char>听说了，就出去迎击他们。 <verse eid="1CH 14:8" /><verse number="9" style="v" sid="1CH 14:9" /><char style="pn">非利士</char>人来了，抢掠<char style="pn">利乏音</char>谷。 <verse eid="1CH 14:9" /><verse number="10" style="v" sid="1CH 14:10" /><char style="pn">大卫</char>求问神，说：“我可以上去攻打<char style="pn">非利士</char>人吗？你会把他们交在我手中吗？”</para>
  <para style="p" vid="1CH 14:10">耶和华对他说：“上去吧，我一定把他们交在你手中。”<verse eid="1CH 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11" />
    <char style="pn">非利士</char>人上到<char style="pn">巴力批拉津</char>，<char style="pn">大卫</char>在那里击败了他们。<char style="pn">大卫</char>说：“神藉着我的手冲溃我的仇敌，如同洪水冲破堤岸。”因此他们给那地方起名为<char style="pn">巴力批拉津</char>。 <verse eid="1CH 14:11" /><verse number="12" style="v" sid="1CH 14:12" /><char style="pn">非利士</char>人把他们的神像遗弃在那里，<char style="pn">大卫</char>就吩咐人用火焚烧了。<verse eid="1CH 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13" />
    <char style="pn">非利士</char>人再次抢掠<char style="pn">利乏音</char>谷。 <verse eid="1CH 14:13" /><verse number="14" style="v" sid="1CH 14:14" /><char style="pn">大卫</char>又求问神，神对他说：“不要直接上去追赶他们，要绕过他们，从桑树林对面进攻。 <verse eid="1CH 14:14" /><verse number="15" style="v" sid="1CH 14:15" />当你听见桑树林的树梢上有行进的声音，就要出去作战，因为神已经在你前面出去攻打<char style="pn">非利士</char>的军队了。” <verse eid="1CH 14:15" /><verse number="16" style="v" sid="1CH 14:16" /><char style="pn">大卫</char>就照着神所指示的去做，击杀<char style="pn">非利士</char>的军队，从<char style="pn">基遍</char>直到<char style="pn">基色</char>。 <verse eid="1CH 14:16" /><verse number="17" style="v" sid="1CH 14:17" /><char style="pn">大卫</char>的名声传遍全地，耶和华使万国都惧怕他。<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" sid="1CH 15" />
  <para style="s">约柜进入耶路撒冷</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1" />
    <char style="pn">大卫</char>在<char style="pn">大卫</char>城为自己建造宫殿，又为神的约柜预备地方，为它支搭了一座帐篷。 <verse eid="1CH 15:1" /><verse number="2" style="v" sid="1CH 15:2" />那时<char style="pn">大卫</char>说：“除了<char style="pn">利未</char>人以外，没有人可以抬神的约柜，因为耶和华拣选了他们抬耶和华的约柜，并且永远事奉他。”<verse eid="1CH 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 15:3" />
    <char style="pn">大卫</char>招聚全体<char style="pn">以色列</char>人到<char style="pn">耶路撒冷</char>，要把耶和华的约柜抬上来放到<char style="pn">大卫</char>所预备的地方。 <verse eid="1CH 15:3" /><verse number="4" style="v" sid="1CH 15:4" /><char style="pn">大卫</char>又招聚<char style="pn">亚伦</char>的子孙和<char style="pn">利未</char>人：<verse eid="1CH 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 15:5" />
    <char style="pn">哥辖</char>的子孙中，有首领<char style="pn">乌列</char>和他的族兄弟一百二十人； <verse eid="1CH 15:5" /><verse number="6" style="v" sid="1CH 15:6" /><char style="pn">米拉利</char>的子孙中，有首领<char style="pn">亚撒雅</char>和他的族兄弟两百二十人； <verse eid="1CH 15:6" /><verse number="7" style="v" sid="1CH 15:7" /><char style="pn">革顺</char>的子孙中，有首领<char style="pn">约珥</char>和他的族兄弟一百三十人； <verse eid="1CH 15:7" /><verse number="8" style="v" sid="1CH 15:8" /><char style="pn">以利撒番</char>的子孙中，有首领<char style="pn">示玛雅</char>和他的族兄弟两百人； <verse eid="1CH 15:8" /><verse number="9" style="v" sid="1CH 15:9" /><char style="pn">希伯伦</char>的子孙中，有首领<char style="pn">以利业</char>和他的族兄弟八十人； <verse eid="1CH 15:9" /><verse number="10" style="v" sid="1CH 15:10" /><char style="pn">乌基业</char>的子孙中，有首领<char style="pn">亚米拿达</char>和他的族兄弟一百一十二人。<verse eid="1CH 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11" />
    <char style="pn">大卫</char>召来<char style="pn">撒督</char>和<char style="pn">亚比亚特</char>两位祭司，以及<char style="pn">利未</char>人<char style="pn">乌列</char>、<char style="pn">亚撒雅</char>、<char style="pn">约珥</char>、<char style="pn">示玛雅</char>、<char style="pn">以利业</char>和<char style="pn">亚米拿达</char>， <verse eid="1CH 15:11" /><verse number="12" style="v" sid="1CH 15:12" />对他们说：“你们是<char style="pn">利未</char>人各父系的首领，你们和你们的族兄弟要使自己分别为圣，好把<char style="pn">以色列</char>的神耶和华的约柜抬上来放到我所预备的地方。 <verse eid="1CH 15:12" /><verse number="13" style="v" sid="1CH 15:13" />因为上一次你们不在场，我们也没有按照规定求问神，所以耶和华我们的神就对我们发怒。” <verse eid="1CH 15:13" /><verse number="14" style="v" sid="1CH 15:14" />于是祭司和<char style="pn">利未</char>人使自己分别为圣，为要把<char style="pn">以色列</char>的神耶和华的约柜抬上来。 <verse eid="1CH 15:14" /><verse number="15" style="v" sid="1CH 15:15" /><char style="pn">利未</char>子孙照着耶和华的话，按<char style="pn">摩西</char>所吩咐的，用杠子把神的约柜扛在肩上。<verse eid="1CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16" />
    <char style="pn">大卫</char>吩咐<char style="pn">利未</char>人的首领指派他们的族兄弟作歌手，用里拉琴、竖琴、铜钹等各种乐器伴奏，高唱喜乐的歌。 <verse eid="1CH 15:16" /><verse number="17" style="v" sid="1CH 15:17" /><char style="pn">利未</char>人就指派了<char style="pn">约珥</char>的儿子<char style="pn">希幔</char>和他的族兄弟<char style="pn">比利迦</char>的儿子<char style="pn">亚萨</char>，以及他们的族兄弟<char style="pn">米拉利</char>子孙中<char style="pn">古沙雅</char>的儿子<char style="pn">伊坦</char>； <verse eid="1CH 15:17" /><verse number="18" style="v" sid="1CH 15:18" />其次是与他们一起的族兄弟：<char style="pn">撒迦利亚</char><note caller="+" style="f"><char style="fr" closed="false">15:18 </char><char style="ft" closed="false">撒迦利亚——依据七十士译本以及有些古抄本；马索拉文本作“儿子撒迦利亚”。</char></note>、<char style="pn">雅阿基业</char>、<char style="pn">示米拉莫</char>、<char style="pn">耶希业</char>、<char style="pn">乌尼</char>、<char style="pn">以利押</char>、<char style="pn">比纳雅</char>、<char style="pn">玛西雅</char>、<char style="pn">玛塔提雅</char>、<char style="pn">以利斐利户</char>、<char style="pn">弥克尼雅</char>，以及门卫<char style="pn">俄别·以东</char>和<char style="pn">耶伊列</char>。 <verse eid="1CH 15:18" /><verse number="19" style="v" sid="1CH 15:19" />歌手<char style="pn">希幔</char>、<char style="pn">亚萨</char>和<char style="pn">伊坦</char>要敲响铜钹； <verse eid="1CH 15:19" /><verse number="20" style="v" sid="1CH 15:20" /><char style="pn">撒迦利亚</char>、<char style="pn">雅基业</char>、<char style="pn">示米拉莫</char>、<char style="pn">耶希业</char>、<char style="pn">乌尼</char>、<char style="pn">以利押</char>、<char style="pn">玛西雅</char>和<char style="pn">比纳雅</char>弹里拉琴，用“少女”曲调<note caller="+" style="f"><char style="fr" closed="false">15:20 </char><char style="ft" closed="false">用“少女”曲调——或译作“调用阿拉莫特”。</char></note>； <verse eid="1CH 15:20" /><verse number="21" style="v" sid="1CH 15:21" /><char style="pn">玛塔提雅</char>、<char style="pn">以利斐利户</char>、<char style="pn">弥克尼雅</char>、<char style="pn">俄别·以东</char>、<char style="pn">耶伊列</char>和<char style="pn">阿撒细雅</char>弹竖琴，用“第八”曲调<note caller="+" style="f"><char style="fr" closed="false">15:21 </char><char style="ft" closed="false">用“第八”曲调——或译作“调用谢米尼特”。</char></note>领奏。 <verse eid="1CH 15:21" /><verse number="22" style="v" sid="1CH 15:22" /><char style="pn">克纳尼雅</char>是<char style="pn">利未</char>人歌唱的领队，教导人歌唱，因为他精通于此。 <verse eid="1CH 15:22" /><verse number="23" style="v" sid="1CH 15:23" /><char style="pn">比利迦</char>和<char style="pn">以利加拿</char>是看守约柜的门卫。 <verse eid="1CH 15:23" /><verse number="24" style="v" sid="1CH 15:24" />祭司<char style="pn">示巴尼</char>、<char style="pn">约沙法</char>、<char style="pn">拿旦业</char>、<char style="pn">亚玛赛</char>、<char style="pn">撒迦利亚</char>、<char style="pn">比纳雅</char>和<char style="pn">以利以谢</char>，在神的约柜前吹号。<char style="pn">俄别·以东</char>和<char style="pn">耶希亚</char>也是看守约柜的门卫。<verse eid="1CH 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25" />于是<char style="pn">大卫</char>、<char style="pn">以色列</char>的长老们和千夫长们一起前去，欢欢喜喜地把耶和华的约柜从<char style="pn">俄别·以东</char>家里抬上来。 <verse eid="1CH 15:25" /><verse number="26" style="v" sid="1CH 15:26" />神帮助那些抬耶和华约柜的<char style="pn">利未</char>人，他们就祭献了七头公牛和七只公绵羊。<verse eid="1CH 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 15:27" />
    <char style="pn">大卫</char>和所有抬约柜的<char style="pn">利未</char>人，并歌手和歌手的首领<char style="pn">克纳尼雅</char>，都穿着细麻布的外袍，<char style="pn">大卫</char>还穿着细麻布的以弗得。 <verse eid="1CH 15:27" /><verse number="28" style="v" sid="1CH 15:28" />全体<char style="pn">以色列</char>人在欢呼和号角声中，奏响号筒、铜钹、里拉琴和竖琴，把耶和华的约柜抬上来。 <verse eid="1CH 15:28" /><verse number="29" style="v" sid="1CH 15:29" />当耶和华的约柜进入<char style="pn">大卫</char>城时，<char style="pn">扫罗</char>的女儿<char style="pn">米甲</char>透过窗户俯看，看见<char style="pn">大卫</char>王跳跃欢庆，心里就藐视他。<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" sid="1CH 16" />
  <para style="nb">
    <verse number="1" style="v" sid="1CH 16:1" />他们把神的约柜抬来，安放在<char style="pn">大卫</char>为它支搭的帐篷内，然后在神面前献上燔祭和平安祭。 <verse eid="1CH 16:1" /><verse number="2" style="v" sid="1CH 16:2" /><char style="pn">大卫</char>献完了燔祭和平安祭，就奉耶和华的名祝福民众， <verse eid="1CH 16:2" /><verse number="3" style="v" sid="1CH 16:3" />又分给<char style="pn">以色列</char>所有的人，无论男女，每人一个饼、一个枣饼、一个葡萄饼。<verse eid="1CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4" />
    <char style="pn">大卫</char>指定一些<char style="pn">利未</char>人在耶和华的约柜前事奉，来记念、称谢、赞美耶和华<char style="pn">以色列</char>的神。 <verse eid="1CH 16:4" /><verse number="5" style="v" sid="1CH 16:5" />为首的是<char style="pn">亚萨</char>，其次是<char style="pn">撒迦利亚</char>、<char style="pn">耶伊列</char>、<char style="pn">示米拉莫</char>、<char style="pn">耶希业</char>、<char style="pn">玛塔提雅</char>、<char style="pn">以利押</char>、<char style="pn">比纳雅</char>、<char style="pn">俄别·以东</char>和<char style="pn">耶伊列</char>，他们弹奏里拉琴和竖琴等乐器，而<char style="pn">亚萨</char>奏响铜钹。 <verse eid="1CH 16:5" /><verse number="6" style="v" sid="1CH 16:6" /><char style="pn">比纳雅</char>和<char style="pn">雅哈希</char>两位祭司常在神的约柜前吹号。<verse eid="1CH 16:6" /></para>
  <para style="s">大卫的感恩诗歌</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7" />那一天，<char style="pn">大卫</char>首次指定<char style="pn">亚萨</char>和他的族兄弟负责称谢耶和华：<verse eid="1CH 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 16:8" />你们当称谢耶和华，呼求他的名，</para>
  <para style="q1" vid="1CH 16:8">在万民中传扬他的作为；<verse eid="1CH 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9" />当向他歌唱，歌颂他，</para>
  <para style="q1" vid="1CH 16:9">谈论他一切的奇妙作为；<verse eid="1CH 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10" />当以他的圣名夸耀，</para>
  <para style="q1" vid="1CH 16:10">愿寻求耶和华的人心里欢喜！<verse eid="1CH 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11" />你们当寻求耶和华和他的力量，</para>
  <para style="q1" vid="1CH 16:11">一直寻求他的容面。<verse eid="1CH 16:11" /></para>
  <para style="q1">
    <verse number="12-13" style="v" sid="1CH 16:12-13" />他的仆人<char style="pn">以色列</char>的后裔啊，</para>
  <para style="q1" vid="1CH 16:12-13">他所拣选的<char style="pn">雅各</char>的子孙哪，</para>
  <para style="q1" vid="1CH 16:12-13">你们当记念他所行的奇妙作为，</para>
  <para style="q1" vid="1CH 16:12-13">记念他的奇事和他口中的法规！<verse eid="1CH 16:12-13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14" />他是耶和华我们的神，</para>
  <para style="q1" vid="1CH 16:14">他的公正充满全地。<verse eid="1CH 16:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15" />他记念自己的约，直到永远；</para>
  <para style="q1" vid="1CH 16:15">记念他所吩咐的话，直到千代——<verse eid="1CH 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16" />就是他与<char style="pn">亚伯拉罕</char>所立的约，</para>
  <para style="q1" vid="1CH 16:16">向<char style="pn">以撒</char>所起的誓；<verse eid="1CH 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 16:17" />又把这约给<char style="pn">雅各</char>立为律例，</para>
  <para style="q1" vid="1CH 16:17">给<char style="pn">以色列</char>立为永远的约；<verse eid="1CH 16:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18" />他说：“我要把<char style="pn">迦南</char>地赐给你，</para>
  <para style="q1" vid="1CH 16:18">作为你们分得的继业。”<verse eid="1CH 16:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19" />那时他们<note caller="+" style="f"><char style="fr" closed="false">16:19 </char><char style="ft" closed="false">他们——原文作“你们”；参《诗篇》105:12。</char></note>人数稀少，实在很少，</para>
  <para style="q1" vid="1CH 16:19">在那地是寄居的；<verse eid="1CH 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 16:20" />他们从这国流浪到那国，</para>
  <para style="q1" vid="1CH 16:20">从这邦流浪到那邦。<verse eid="1CH 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21" />他不容任何人欺压他们，</para>
  <para style="q1" vid="1CH 16:21">还为他们的缘故责备君王：<verse eid="1CH 16:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 16:22" />“你们不可碰我的受膏者，</para>
  <para style="q1" vid="1CH 16:22">不可恶待我的先知。”<verse eid="1CH 16:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23" />全地啊，你们当向耶和华歌唱，</para>
  <para style="q1" vid="1CH 16:23">日复一日地传扬他的救恩！<verse eid="1CH 16:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24" />当在列国中讲述他的荣耀，</para>
  <para style="q1" vid="1CH 16:24">在万民中讲述他的奇妙作为；<verse eid="1CH 16:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25" />因耶和华伟大，当受极大的赞美；</para>
  <para style="q1" vid="1CH 16:25">他超越一切神明，当受敬畏；<verse eid="1CH 16:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26" />万民的一切神明都是虚无的偶像，</para>
  <para style="q1" vid="1CH 16:26">而耶和华造了诸天。<verse eid="1CH 16:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27" />尊荣和威严在他的面前，</para>
  <para style="q1" vid="1CH 16:27">力量和喜乐在他的居所。<verse eid="1CH 16:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28" />万民万族啊，你们当把荣耀和力量</para>
  <para style="q1" vid="1CH 16:28">归给耶和华，归给耶和华！<verse eid="1CH 16:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 16:29" />当把耶和华之名的荣耀归给他，</para>
  <para style="q1" vid="1CH 16:29">带着供物，来到他的面前。</para>
  <para style="q1" vid="1CH 16:29">当向圣洁威严的耶和华下拜；<verse eid="1CH 16:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="1CH 16:30" />全地啊，你们当在他面前震撼！</para>
  <para style="b" vid="1CH 16:30" />
  <para style="q1" vid="1CH 16:30">是的，世界被确立，不致动摇！<verse eid="1CH 16:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31" />愿诸天欢喜，愿大地快乐，</para>
  <para style="q1" vid="1CH 16:31">愿人们在列国中说：“耶和华作王了！”<verse eid="1CH 16:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32" />愿海洋和其中所充满的澎湃如雷，</para>
  <para style="q1" vid="1CH 16:32">愿田野和其中的一切都欢庆。<verse eid="1CH 16:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33" />那时森林中的树木将在耶和华面前欢呼，</para>
  <para style="q1" vid="1CH 16:33">因为他来要审判大地。<verse eid="1CH 16:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34" />你们当称谢耶和华，</para>
  <para style="q1" vid="1CH 16:34">他是美善的，他的慈爱永远长存！<verse eid="1CH 16:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35" />你们要说：</para>
  <para style="q1" vid="1CH 16:35">“拯救我们的神哪，求你拯救我们！</para>
  <para style="q1" vid="1CH 16:35">求你从列国中招聚我们、解救我们，</para>
  <para style="q1" vid="1CH 16:35">好让我们称颂你的圣名，</para>
  <para style="q1" vid="1CH 16:35">以赞美你为福乐！”<verse eid="1CH 16:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36" />
    <char style="pn">以色列</char>的神耶和华是当受颂赞的，</para>
  <para style="q1" vid="1CH 16:36">从永远到永远<note caller="+" style="f"><char style="fr" closed="false">16:36 </char><char style="ft" closed="false">永远到永远——或译作“亘古到永远”。</char></note>。</para>
  <para style="m" vid="1CH 16:36">全体民众都说“阿们”，并且赞美耶和华。<verse eid="1CH 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37" />
    <char style="pn">大卫</char>安排<char style="pn">亚萨</char>和他的族兄弟在耶和华的约柜前，要按着每天的任务，常在约柜前事奉； <verse eid="1CH 16:37" /><verse number="38" style="v" sid="1CH 16:38" />还有<char style="pn">俄别·以东</char>和他的族兄弟六十八人，<char style="pn">耶杜顿</char>的儿子<char style="pn">俄别·以东</char>以及<char style="pn">何萨</char>作门卫。 <verse eid="1CH 16:38" /><verse number="39" style="v" sid="1CH 16:39" /><char style="pn">大卫</char>又安排祭司<char style="pn">撒督</char>和他的兄弟众祭司在<char style="pn">基遍</char>的高坛，在耶和华的帐幕前事奉， <verse eid="1CH 16:39" /><verse number="40" style="v" sid="1CH 16:40" />要照着律法所记的一切，就是耶和华所吩咐<char style="pn">以色列</char>的，清晨和傍晚在燔祭的祭坛上向耶和华献上常献的燔祭。 <verse eid="1CH 16:40" /><verse number="41" style="v" sid="1CH 16:41" />还有<char style="pn">希幔</char>、<char style="pn">耶杜顿</char>和其余被选出、被指名的人，与他们一起称谢耶和华：“他的慈爱永远长存！” <verse eid="1CH 16:41" /><verse number="42" style="v" sid="1CH 16:42" /><char style="pn">希幔</char>、<char style="pn">耶杜顿</char>与他们一同用号筒、铜钹等各种乐器发声歌颂神。<char style="pn">耶杜顿</char>的子孙守门。<verse eid="1CH 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43" />于是全体民众各回各家，<char style="pn">大卫</char>也回去为自己的家人祝福。<verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" sid="1CH 17" />
  <para style="s">大卫想建造圣殿</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1" />
    <char style="pn">大卫</char>住进自己的宫殿以后，对先知<char style="pn">拿单</char>说：“你看，我住在香柏木的宫殿里，耶和华的约柜却在帐幕里。”<verse eid="1CH 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2" />
    <char style="pn">拿单</char>对<char style="pn">大卫</char>说：“你心里所想的一切，只管去做，因为神与你同在。”<verse eid="1CH 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3" />当天夜里，神的话语临到<char style="pn">拿单</char>，说： <verse eid="1CH 17:3" /><verse number="4" style="v" sid="1CH 17:4" />“你去告诉我的仆人<char style="pn">大卫</char>：‘耶和华如此说：不是你要为我建造殿宇居住。 <verse eid="1CH 17:4" /><verse number="5" style="v" sid="1CH 17:5" />要知道，从我把<char style="pn">以色列</char>人带上来的那天到今天，我从来没有住过殿宇，我一直从这帐幕到那帐幕，从一个住所到另一个住所。 <verse eid="1CH 17:5" /><verse number="6" style="v" sid="1CH 17:6" />在我与全体<char style="pn">以色列</char>人走过的哪一个地方，我何曾对哪一个<char style="pn">以色列</char>士师，就是我吩咐要牧养我子民的士师，说过这话：你们怎么不为我建造一座香柏木的殿宇呢？’<verse eid="1CH 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 17:7" />“现在，你要对我的仆人<char style="pn">大卫</char>这样说：‘万军之耶和华如此说：是我把你从牧场上、从羊群后带出来，作我子民<char style="pn">以色列</char>的领袖。 <verse eid="1CH 17:7" /><verse number="8" style="v" sid="1CH 17:8" />在你所去的任何地方，我都与你同在，并且从你面前剪除了你的一切仇敌。我将为你成就大名，如同世上那些伟人的名。 <verse eid="1CH 17:8" /><verse number="9" style="v" sid="1CH 17:9" />我必为我的子民<char style="pn">以色列</char>选定一个地方，栽植他们，使他们安居在那里，不再受搅扰，也不再像先前那样被不义之人迫害—— <verse eid="1CH 17:9" /><verse number="10" style="v" sid="1CH 17:10" />从我吩咐士师治理我子民<char style="pn">以色列</char>的日子以来，他们一直被迫害。我要制伏你的一切仇敌。</para>
  <para style="p" vid="1CH 17:10">“‘我向你宣告：耶和华将为你建立家室。 <verse eid="1CH 17:10" /><verse number="11" style="v" sid="1CH 17:11" />当你寿数满足，归到你列祖那里时，我必兴起你的后裔——你亲生的儿子接续你，我也必坚立他的王权。 <verse eid="1CH 17:11" /><verse number="12" style="v" sid="1CH 17:12" />他将为我建造殿宇，我必坚立他的王位，直到永远。 <verse eid="1CH 17:12" /><verse number="13" style="v" sid="1CH 17:13" />我要作他的父亲，他要作我的儿子；我不会使我的慈爱离开他，像离开在你之前的人那样； <verse eid="1CH 17:13" /><verse number="14" style="v" sid="1CH 17:14" />我要在我的家和我的国度里永远确立他，他的王位必永远坚立。’”<verse eid="1CH 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15" />
    <char style="pn">拿单</char>就把这一切话语，把这整个异象<note caller="+" style="f"><char style="fr" closed="false">17:15 </char><char style="ft" closed="false">异象——或译作“启示”。</char></note>，如实地告诉了<char style="pn">大卫</char>。<verse eid="1CH 17:15" /></para>
  <para style="s">大卫的感恩祷告</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16" />于是<char style="pn">大卫</char>王进去，坐在耶和华面前，说：“耶和华神哪，我是谁，我的家算什么，你竟带领我到这地步！ <verse eid="1CH 17:16" /><verse number="17" style="v" sid="1CH 17:17" />神哪，这在你眼中还看为小事，你竟又提说仆人家的未来！耶和华神哪，你看待我像一个高贵的人<note caller="+" style="f"><char style="fr" closed="false">17:17 </char><char style="ft" closed="false">你看待我像一个高贵的人——或译作“你向我显明了人都渴望知道的事”。</char></note>。 <verse eid="1CH 17:17" /><verse number="18" style="v" sid="1CH 17:18" />你赐给你仆人荣耀，<char style="pn">大卫</char>还能对你说什么呢？你知道你的仆人。 <verse eid="1CH 17:18" /><verse number="19" style="v" sid="1CH 17:19" />耶和华啊，你为你仆人的缘故，照着自己的心意行了这一切大事，为要显明这一切伟大的事。<verse eid="1CH 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 17:20" />“耶和华啊，照着我们耳中所听见的一切，没有像你的，除你以外没有别的神。 <verse eid="1CH 17:20" /><verse number="21" style="v" sid="1CH 17:21" />世上有哪一国像你的子民<char style="pn">以色列</char>呢？神为自己赎回一个民族，为自己立名，行大而可畏的事，在你从<char style="pn">埃及</char>救赎的子民面前驱逐了列国。 <verse eid="1CH 17:21" /><verse number="22" style="v" sid="1CH 17:22" />你使你的子民<char style="pn">以色列</char>永远作你的子民；耶和华啊，你也作了他们的神。<verse eid="1CH 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 17:23" />“现在，耶和华啊，你所应许的有关你仆人和他家的话，求你永远确立。求你照着你所应许的行事， <verse eid="1CH 17:23" /><verse number="24" style="v" sid="1CH 17:24" />这样，你的名就永远确立、被尊为大，人必说：‘<char style="pn">以色列</char>的神——万军之耶和华，就是<char style="pn">以色列</char>的神。’你仆人<char style="pn">大卫</char>的家也将在你面前被坚立， <verse eid="1CH 17:24" /><verse number="25" style="v" sid="1CH 17:25" />因为你——我的神哪，是你亲自启示你的仆人<note caller="+" style="f"><char style="fr" closed="false">17:25 </char><char style="ft" closed="false">启示你的仆人——原文直译“开启你仆人的耳朵”。</char></note>，要为他建立家室；所以你的仆人有了勇气在你面前祷告。 <verse eid="1CH 17:25" /><verse number="26" style="v" sid="1CH 17:26" />是的，耶和华啊，你是神，是你向你的仆人应许了这福份。 <verse eid="1CH 17:26" /><verse number="27" style="v" sid="1CH 17:27" />现在，愿你祝福你仆人的家，使它在你面前永远长存，因为耶和华啊，你所祝福的，必永远蒙福。”<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" sid="1CH 18" />
  <para style="s">大卫的军事胜利</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1" />此后，<char style="pn">大卫</char>击败<char style="pn">非利士</char>人，制伏了他们，从<char style="pn">非利士</char>人手中夺取了<char style="pn">迦特</char>和附属的村镇。 <verse eid="1CH 18:1" /><verse number="2" style="v" sid="1CH 18:2" />他又击败<char style="pn">摩押</char>人，<char style="pn">摩押</char>就臣服于<char style="pn">大卫</char>，向他进贡。<verse eid="1CH 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3" />当<char style="pn">琐巴</char>王<char style="pn">哈大底谢</char>去建立他在<char style="pn">幼发拉底</char>河流域的掌控权时，<char style="pn">大卫</char>在<char style="pn">哈马</char>击败了他。 <verse eid="1CH 18:3" /><verse number="4" style="v" sid="1CH 18:4" /><char style="pn">大卫</char>夺取了他一千辆战车，俘虏了七千马兵、两万步兵，<char style="pn">大卫</char>从拉战车的马中保留了一百匹，把其余所有拉战车的马都砍断了蹄筋。<verse eid="1CH 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5" />
    <char style="pn">大马士革</char>的<char style="pn">亚兰</char>人来帮助<char style="pn">琐巴</char>王<char style="pn">哈大底谢</char>时，<char style="pn">大卫</char>击杀了<char style="pn">亚兰</char>人两万两千。 <verse eid="1CH 18:5" /><verse number="6" style="v" sid="1CH 18:6" /><char style="pn">大卫</char>在<char style="pn">大马士革</char>的<char style="pn">亚兰</char>地设立驻军，这样<char style="pn">亚兰</char>人就臣服于<char style="pn">大卫</char>，向他进贡。<char style="pn">大卫</char>无论往哪里去，耶和华都使他得胜。<verse eid="1CH 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7" />
    <char style="pn">大卫</char>夺取<char style="pn">哈大底谢</char>臣仆们所拿的金盾牌，把它们带回<char style="pn">耶路撒冷</char>。 <verse eid="1CH 18:7" /><verse number="8" style="v" sid="1CH 18:8" /><char style="pn">大卫</char>也从<char style="pn">哈大底谢</char>的城——<char style="pn">提巴</char>城和<char style="pn">昆</char>城中，夺走极多的铜；后来<char style="pn">所罗门</char>就是用这些铜制造铜海、柱子和各样铜器的。<verse eid="1CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9" />
    <char style="pn">哈马</char>王<char style="pn">陀伊</char>听说<char style="pn">大卫</char>击败了<char style="pn">琐巴</char>王<char style="pn">哈大底谢</char>的全军， <verse eid="1CH 18:9" /><verse number="10" style="v" sid="1CH 18:10" />就派遣他儿子<char style="pn">哈多兰</char>去见<char style="pn">大卫</char>王，向他问安，为他祝福，因为<char style="pn">大卫</char>攻打<char style="pn">哈大底谢</char>并击败了他；原来<char style="pn">哈大底谢</char>一直是<char style="pn">陀伊</char>的敌手。<char style="pn">哈多兰</char>送来各样金、银、铜的器皿， <verse eid="1CH 18:10" /><verse number="11" style="v" sid="1CH 18:11" /><char style="pn">大卫</char>王把这些分别为圣归于耶和华，就像他从各国获得的金银那样——这些金银是从<char style="pn">以东</char>人、<char style="pn">摩押</char>人、<char style="pn">亚扪</char>人、<char style="pn">非利士</char>人和<char style="pn">亚玛力</char>人那里获得的。<verse eid="1CH 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12" />
    <char style="pn">洗鲁雅</char>的儿子<char style="pn">亚比筛</char>在<char style="pn">盐谷</char>击杀了一万八千<char style="pn">以东</char>人。 <verse eid="1CH 18:12" /><verse number="13" style="v" sid="1CH 18:13" /><char style="pn">大卫</char>在<char style="pn">以东</char>设立驻军，全<char style="pn">以东</char>就臣服于<char style="pn">大卫</char>。<char style="pn">大卫</char>无论往哪里去，耶和华都使他得胜。<verse eid="1CH 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14" />
    <char style="pn">大卫</char>作王统治全<char style="pn">以色列</char>，为他所有百姓实行公正和公义。<verse eid="1CH 18:14" /></para>
  <para style="mi">
    <verse number="15" style="v" sid="1CH 18:15" />
    <char style="pn">洗鲁雅</char>的儿子<char style="pn">约押</char>统管军队，</para>
  <para style="mi" vid="1CH 18:15">
    <char style="pn">亚希律</char>的儿子<char style="pn">约沙法</char>作史官，<verse eid="1CH 18:15" /></para>
  <para style="mi">
    <verse number="16" style="v" sid="1CH 18:16" />
    <char style="pn">亚希突</char>的儿子<char style="pn">撒督</char>和<char style="pn">亚比亚特</char>的儿子<char style="pn">亚希米勒</char>作祭司，</para>
  <para style="mi" vid="1CH 18:16">
    <char style="pn">沙威沙</char>作书记，<verse eid="1CH 18:16" /></para>
  <para style="mi">
    <verse number="17" style="v" sid="1CH 18:17" />
    <char style="pn">耶赫亚达</char>的儿子<char style="pn">比纳雅</char>统管<char style="pn">基利提</char>人和<char style="pn">比利提</char>人，</para>
  <para style="mi" vid="1CH 18:17">
    <char style="pn">大卫</char>的儿子们在王的身边作内官。<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" sid="1CH 19" />
  <para style="s">以色列战胜亚扪人</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1" />此后，<char style="pn">亚扪</char>人的王<char style="pn">纳哈什</char>死了，他的儿子接替他作王。 <verse eid="1CH 19:1" /><verse number="2" style="v" sid="1CH 19:2" /><char style="pn">大卫</char>说：“我要以恩慈对待<char style="pn">纳哈什</char>的儿子<char style="pn">哈嫩</char>，因为他父亲曾以恩慈对待我。”</para>
  <para style="p" vid="1CH 19:2">于是<char style="pn">大卫</char>派遣使者为<char style="pn">哈嫩</char>丧父的事安慰他。<char style="pn">大卫</char>的臣仆来到<char style="pn">亚扪</char>人之地见<char style="pn">哈嫩</char>，要安慰他， <verse eid="1CH 19:2" /><verse number="3" style="v" sid="1CH 19:3" />但<char style="pn">亚扪</char>人的首领们对<char style="pn">哈嫩</char>说：“你以为<char style="pn">大卫</char>是尊敬你父亲，所以派人来安慰你吗？他的臣仆们来见你，难道不是为了探查、倾覆，为了窥探这地吗？” <verse eid="1CH 19:3" /><verse number="4" style="v" sid="1CH 19:4" /><char style="pn">哈嫩</char>就抓住<char style="pn">大卫</char>的臣仆，把他们的胡须剃掉，又把他们的衣服从臀部以下割去一半，然后放他们走。<verse eid="1CH 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 19:5" />有人来把这些人遭遇的事向<char style="pn">大卫</char>报告，<char style="pn">大卫</char>就派人去迎接他们，因为这些人受了极大的羞辱。王说：“你们可以住在<char style="pn">耶利哥</char>，等胡须长好了再回来。”<verse eid="1CH 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6" />
    <char style="pn">亚扪</char>人知道他们被<char style="pn">大卫</char>厌恶，<char style="pn">哈嫩</char>和<char style="pn">亚扪</char>人就派人拿一千他连得<note caller="+" style="f"><char style="fr" closed="false">19:6 </char><char style="ft" closed="false">一千他连得——相当于34.2公吨。1他连得=34.2公斤。</char></note>银子，从<char style="pn">美索不达米亚</char><note caller="+" style="f"><char style="fr" closed="false">19:6 </char><char style="ft" closed="false">美索不达米亚——原文直译“两河之间的亚兰”。</char></note>、<char style="pn">亚兰-玛迦</char>和<char style="pn">琐巴</char>雇用战车和马兵。 <verse eid="1CH 19:6" /><verse number="7" style="v" sid="1CH 19:7" />他们雇来了三万两千辆战车，还有<char style="pn">玛迦</char>王和他的军兵。这些军兵都来到<char style="pn">米底巴</char>前面扎营。<char style="pn">亚扪</char>人也从他们各城中聚集，出来作战。<verse eid="1CH 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8" />
    <char style="pn">大卫</char>听说了，就派遣<char style="pn">约押</char>和全军的勇士出战。 <verse eid="1CH 19:8" /><verse number="9" style="v" sid="1CH 19:9" /><char style="pn">亚扪</char>人出来，在自己的城门口摆开战阵；前来的诸王，他们单独在郊外摆阵。 <verse eid="1CH 19:9" /><verse number="10" style="v" sid="1CH 19:10" /><char style="pn">约押</char>见自己腹背受敌，就从<char style="pn">以色列</char>所有精兵中挑选了一部分，摆阵迎战<char style="pn">亚兰</char>人， <verse eid="1CH 19:10" /><verse number="11" style="v" sid="1CH 19:11" />其余的人交在他兄弟<char style="pn">亚比筛</char>手下，摆阵迎战<char style="pn">亚扪</char>人。<verse eid="1CH 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 19:12" />
    <char style="pn">约押</char>说：“如果<char style="pn">亚兰</char>人强过我，你就过来帮助我；如果<char style="pn">亚扪</char>人强过你，我就过去帮助你。 <verse eid="1CH 19:12" /><verse number="13" style="v" sid="1CH 19:13" />要坚强，我们要为我们的人民、为我们神的城镇而坚强！愿耶和华做他眼中看为好的事。”<verse eid="1CH 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14" />于是<char style="pn">约押</char>和跟随他的人上前与<char style="pn">亚兰</char>人作战，<char style="pn">亚兰</char>人从他面前逃跑。 <verse eid="1CH 19:14" /><verse number="15" style="v" sid="1CH 19:15" /><char style="pn">亚扪</char>人见<char style="pn">亚兰</char>人逃跑，也从<char style="pn">约押</char>的弟弟<char style="pn">亚比筛</char>面前逃跑，逃进城里。于是<char style="pn">约押</char>就回<char style="pn">耶路撒冷</char>去了。<verse eid="1CH 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16" />
    <char style="pn">亚兰</char>人见自己败在<char style="pn">以色列</char>人面前，就派遣使者去把大河<note caller="+" style="f"><char style="fr" closed="false">19:16 </char><char style="ft" closed="false">大河——指幼发拉底河。</char></note>对岸的<char style="pn">亚兰</char>人调过来，由<char style="pn">哈大底谢</char>的元帅<char style="pn">朔法</char>率领他们。<verse eid="1CH 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17" />有人向<char style="pn">大卫</char>报告，<char style="pn">大卫</char>就招聚<char style="pn">以色列</char>全军，过了<char style="pn">约旦</char>河，来到<char style="pn">亚兰</char>人那里，对着他们摆阵。<char style="pn">大卫</char>摆阵迎战<char style="pn">亚兰</char>人，<char style="pn">亚兰</char>人就与他交战。 <verse eid="1CH 19:17" /><verse number="18" style="v" sid="1CH 19:18" /><char style="pn">亚兰</char>人在<char style="pn">以色列</char>人面前逃跑，<char style="pn">大卫</char>杀了<char style="pn">亚兰</char>的战车兵七千<note caller="+" style="f"><char style="fr" closed="false">19:18 </char><char style="ft" closed="false">七千——《撒母耳记下》10:18为“七百”。</char></note>、步兵四万，并且杀死了元帅<char style="pn">朔法</char>。 <verse eid="1CH 19:18" /><verse number="19" style="v" sid="1CH 19:19" /><char style="pn">哈大底谢</char>的臣属见自己败在<char style="pn">以色列</char>面前，就与<char style="pn">大卫</char>讲和，臣服于他。于是<char style="pn">亚兰</char>人不敢再帮助<char style="pn">亚扪</char>人了。<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" sid="1CH 20" />
  <para style="s">攻取拉巴城</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1" />年初，正是诸王出战的时候，<char style="pn">约押</char>率领军兵毁坏了<char style="pn">亚扪</char>人之地，然后去围困<char style="pn">拉巴</char>。那时<char style="pn">大卫</char>一直留在<char style="pn">耶路撒冷</char>。<char style="pn">约押</char>攻打<char style="pn">拉巴</char>，把城摧毁了。 <verse eid="1CH 20:1" /><verse number="2" style="v" sid="1CH 20:2" /><char style="pn">大卫</char>夺取了<char style="pn">亚扪</char>王<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">亚扪王——原文直译“他们的王”；七十士译本和有些古抄本作“米勒公”，就是亚扪人的神。</char></note>头上的王冠，其金子的重量是一他连得<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">一他连得——相当于34.2公斤。</char></note>，其上有宝石；这王冠就戴在<char style="pn">大卫</char>的头上。<char style="pn">大卫</char>从那城带走了极多的战利品， <verse eid="1CH 20:2" /><verse number="3" style="v" sid="1CH 20:3" />并且把城里的居民带出来，让他们用锯子、铁镐、斧子做工；<char style="pn">大卫</char>对待<char style="pn">亚扪</char>人的各城都是这样。然后<char style="pn">大卫</char>和全军回<char style="pn">耶路撒冷</char>去了。<verse eid="1CH 20:3" /></para>
  <para style="s">击杀非利士巨人</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4" />此后，<char style="pn">以色列</char>人与<char style="pn">非利士</char>人在<char style="pn">基色</char>起了战争；那时<char style="pn">户沙</char>人<char style="pn">西比凯</char>击杀了巨人<note caller="+" style="f"><char style="fr" closed="false">20:4 </char><char style="ft" closed="false">巨人——或译作“利乏音人”。</char></note>的后裔<char style="pn">希派</char>，<char style="pn">非利士</char>人就被制伏了。<verse eid="1CH 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5" />
    <char style="pn">以色列</char>人与<char style="pn">非利士</char>人又有战争。<char style="pn">雅雷</char>的儿子<char style="pn">伊勒哈南</char>击杀了<char style="pn">迦特</char>人<char style="pn">歌利亚</char>的兄弟<char style="pn">拉哈米</char>，这人长矛的杆像织布的机轴那样粗。<verse eid="1CH 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6" />在<char style="pn">迦特</char>又有战争。有一个身材高大的人，手脚各有六个指头，总共二十四个，他也是巨人的后裔。 <verse eid="1CH 20:6" /><verse number="7" style="v" sid="1CH 20:7" />他向<char style="pn">以色列</char>骂阵，<char style="pn">大卫</char>的哥哥<char style="pn">示米亚</char>的儿子<char style="pn">约拿单</char>把他击杀了。<verse eid="1CH 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 20:8" />这些人是<char style="pn">迦特</char>巨人的后裔，他们都倒在<char style="pn">大卫</char>和他臣仆们手下。<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" sid="1CH 21" />
  <para style="s">数点军队人数</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1" />撒旦<note caller="+" style="f"><char style="fr" closed="false">21:1 </char><char style="ft" closed="false">撒旦——指那控告者。</char></note>起来攻击<char style="pn">以色列</char>，诱导<char style="pn">大卫</char>去数点<char style="pn">以色列</char>人。 <verse eid="1CH 21:1" /><verse number="2" style="v" sid="1CH 21:2" /><char style="pn">大卫</char>对<char style="pn">约押</char>和军兵的将领们说：“你们去，数点<char style="pn">以色列</char>人，从<char style="pn">比尔-谢巴</char>直到<char style="pn">但</char>，然后回来告诉我，我好知道他们的数目。”<verse eid="1CH 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3" />
    <char style="pn">约押</char>说：“愿耶和华使他的军兵<note caller="+" style="f"><char style="fr" closed="false">21:3 </char><char style="ft" closed="false">军兵——或译作“子民”。</char></note>增添到现有的一百倍。我主我王啊！他们不全都是我主的臣仆吗？我主何必想做这事呢？为什么要使<char style="pn">以色列</char>陷入罪里呢？”<verse eid="1CH 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4" />但王的命令强过<char style="pn">约押</char>，<char style="pn">约押</char>就出去，走遍全<char style="pn">以色列</char>，之后回到了<char style="pn">耶路撒冷</char>。 <verse eid="1CH 21:4" /><verse number="5" style="v" sid="1CH 21:5" /><char style="pn">约押</char>把军兵的统计数目呈报<char style="pn">大卫</char>：全<char style="pn">以色列</char>中拿刀剑的人有一百一十万，<char style="pn">犹大</char>中拿刀剑的人有四十七万。 <verse eid="1CH 21:5" /><verse number="6" style="v" sid="1CH 21:6" />但是<char style="pn">利未</char>人和<char style="pn">便雅悯</char>人，他没有数点在内，因为<char style="pn">约押</char>厌恶王这个命令。<verse eid="1CH 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 21:7" />这事在神的眼中看为恶，于是他打击了<char style="pn">以色列</char>。 <verse eid="1CH 21:7" /><verse number="8" style="v" sid="1CH 21:8" /><char style="pn">大卫</char>对神说：“我做这事，犯了大罪！现在，求你除去你仆人的罪孽，因我做了极其愚蠢的事！”<verse eid="1CH 21:8" /></para>
  <para style="s">大卫遭受惩罚</para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9" />耶和华吩咐<char style="pn">大卫</char>的先见<char style="pn">迦得</char>，说： <verse eid="1CH 21:9" /><verse number="10" style="v" sid="1CH 21:10" />“你去告诉<char style="pn">大卫</char>说：‘耶和华如此说：我给你三样灾，你从其中挑选一个，我就降在你身上。’”<verse eid="1CH 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11" />
    <char style="pn">迦得</char>就来见<char style="pn">大卫</char>，对他说：“耶和华如此说：‘任你选择： <verse eid="1CH 21:11" /><verse number="12" style="v" sid="1CH 21:12" />三年饥荒，或者三个月在敌人面前被驱逐，被仇敌的刀剑追逼，或者三天被耶和华的刀剑攻击，国中发生瘟疫，耶和华的使者在<char style="pn">以色列</char>的全境施行毁灭。’现在，你看看我应该怎么回话给派遣我来的那一位。”<verse eid="1CH 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13" />
    <char style="pn">大卫</char>对<char style="pn">迦得</char>说：“这使我非常为难！还是让我落在耶和华手中吧，因为他有极其丰盛的怜悯；请不要让我落在人的手中。”<verse eid="1CH 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14" />于是耶和华在<char style="pn">以色列</char>降下瘟疫，<char style="pn">以色列</char>中倒毙了七万人。 <verse eid="1CH 21:14" /><verse number="15" style="v" sid="1CH 21:15" />神派遣天使去毁灭<char style="pn">耶路撒冷</char>，天使正要毁灭时，耶和华见了就后悔降这祸患，他对施行毁灭的天使说：“够了，住手吧！”那时耶和华的使者站在<char style="pn">耶布斯</char>人<char style="pn">欧珥楠</char>的打谷场那里。<verse eid="1CH 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16" />
    <char style="pn">大卫</char>举目，看见耶和华的使者站在天地之间，手里拿着拔出的刀，伸在<char style="pn">耶路撒冷</char>之上。<char style="pn">大卫</char>和长老们都披上麻布，脸伏于地。 <verse eid="1CH 21:16" /><verse number="17" style="v" sid="1CH 21:17" /><char style="pn">大卫</char>对神说：“吩咐数点人口的不是我吗？是我犯了罪，是我行了大恶！这群羊，他们做了什么呢？耶和华我的神哪，愿你的手对付我和我的父家，不要让瘟疫临到你的子民。”<verse eid="1CH 21:17" /></para>
  <para style="s">大卫立坛献祭</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18" />耶和华的使者吩咐<char style="pn">迦得</char>去告诉<char style="pn">大卫</char>，叫<char style="pn">大卫</char>上去，在<char style="pn">耶布斯</char>人<char style="pn">欧珥楠</char>的打谷场上为耶和华立一座祭坛。 <verse eid="1CH 21:18" /><verse number="19" style="v" sid="1CH 21:19" /><char style="pn">大卫</char>就照着<char style="pn">迦得</char>奉耶和华的名所说的话上去了。<verse eid="1CH 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 21:20" />那时<char style="pn">欧珥楠</char>正在踹小麦，<char style="pn">欧珥楠</char>转过身来，看见了天使，就与他的四个儿子一同躲藏起来。 <verse eid="1CH 21:20" /><verse number="21" style="v" sid="1CH 21:21" /><char style="pn">大卫</char>来到<char style="pn">欧珥楠</char>那里，<char style="pn">欧珥楠</char>看见<char style="pn">大卫</char>，就从打谷场出来，脸伏于地向<char style="pn">大卫</char>下拜。<verse eid="1CH 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22" />
    <char style="pn">大卫</char>对<char style="pn">欧珥楠</char>说：“请把打谷场这块地卖给我，我好在这里为耶和华筑一座祭坛；请按足价卖给我，使瘟疫在百姓中间止住。”<verse eid="1CH 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23" />
    <char style="pn">欧珥楠</char>对<char style="pn">大卫</char>说：“只管拿去用，我主我王看怎样好就怎样做吧！看，我还送上牛作燔祭，打谷器具作木柴，小麦作素祭；这一切我都送给王。”<verse eid="1CH 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24" />
    <char style="pn">大卫</char>王对<char style="pn">欧珥楠</char>说：“不，我一定要按足价购买，我不能拿你的东西给耶和华，也不能献上无偿的燔祭。”<verse eid="1CH 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25" />
    <char style="pn">大卫</char>就为那块地付了<char style="pn">欧珥楠</char>重六百谢克尔<note caller="+" style="f"><char style="fr" closed="false">21:25 </char><char style="ft" closed="false">六百谢克尔——相当于6.8公斤。1谢克尔=11.4公克。</char></note>的金子。 <verse eid="1CH 21:25" /><verse number="26" style="v" sid="1CH 21:26" /><char style="pn">大卫</char>在那里为耶和华筑了一座祭坛，献上燔祭和平安祭。他向耶和华呼求，耶和华就从天上降火在燔祭的祭坛上，应允了他。<verse eid="1CH 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27" />耶和华吩咐天使，天使就把剑收回鞘中。 <verse eid="1CH 21:27" /><verse number="28" style="v" sid="1CH 21:28" />那时候，<char style="pn">大卫</char>见耶和华在<char style="pn">耶布斯</char>人<char style="pn">欧珥楠</char>的打谷场上回应了他，就在那里献祭—— <verse eid="1CH 21:28" /><verse number="29" style="v" sid="1CH 21:29" /><char style="pn">摩西</char>在旷野所造的耶和华的帐幕，以及燔祭的祭坛，那时候都在<char style="pn">基遍</char>的高坛—— <verse eid="1CH 21:29" /><verse number="30" style="v" sid="1CH 21:30" />可是<char style="pn">大卫</char>不能够来到神面前求问，因为耶和华使者的刀使他惊慌失措。<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" sid="1CH 22" />
  <para style="nb">
    <verse number="1" style="v" sid="1CH 22:1" />
    <char style="pn">大卫</char>说：“这里是神耶和华的殿，这里是<char style="pn">以色列</char>献燔祭的祭坛。”<verse eid="1CH 22:1" /></para>
  <para style="s">大卫为圣殿筹备</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2" />
    <char style="pn">大卫</char>吩咐把<char style="pn">以色列</char>地的寄居者招聚起来，又安排石匠开凿石头，要用凿好的料石建造神的殿。 <verse eid="1CH 22:2" /><verse number="3" style="v" sid="1CH 22:3" /><char style="pn">大卫</char>预备了大量的铁，用来制作所有门扇上的钉子和连接件；又预备了铜，多得无法称量； <verse eid="1CH 22:3" /><verse number="4" style="v" sid="1CH 22:4" />还有无数的香柏木，因为<char style="pn">西顿</char>人和<char style="pn">提尔</char>人给<char style="pn">大卫</char>运来了大量的香柏木。 <verse eid="1CH 22:4" /><verse number="5" style="v" sid="1CH 22:5" /><char style="pn">大卫</char>想：“我儿子<char style="pn">所罗门</char>年少幼嫩，而要为耶和华建造的殿宇必须极其宏伟，名声和荣耀传遍全地。现在我就要为这殿宇<note caller="+" style="f"><char style="fr" closed="false">22:5 </char><char style="ft" closed="false">这殿宇——或译作“他”。</char></note>做准备。”这样<char style="pn">大卫</char>在死之前，做了许多的准备。<verse eid="1CH 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6" />
    <char style="pn">大卫</char>召来他儿子<char style="pn">所罗门</char>，吩咐他要为<char style="pn">以色列</char>的神耶和华建造殿宇。 <verse eid="1CH 22:6" /><verse number="7" style="v" sid="1CH 22:7" /><char style="pn">大卫</char>对<char style="pn">所罗门</char>说：“我儿啊，我一直有心为我神耶和华的名建造殿宇， <verse eid="1CH 22:7" /><verse number="8" style="v" sid="1CH 22:8" />只是耶和华的话语临到我说：‘你流了很多人的血，打过许多仗，你不可为我的名建造殿宇，因为你在我面前，在大地上流了很多人的血。 <verse eid="1CH 22:8" /><verse number="9" style="v" sid="1CH 22:9" />看哪，你将生一个儿子，他必成为安息之人，我要使他安定，脱离四围一切仇敌。他的名字要叫<char style="pn">所罗门</char>，他在位的日子，我要把和平、安宁赐给<char style="pn">以色列</char>。 <verse eid="1CH 22:9" /><verse number="10" style="v" sid="1CH 22:10" />他要为我的名建造殿宇，并且他要作我的儿子，我要作他的父亲。我必使他王位坚立，统治<char style="pn">以色列</char>直到永远。’<verse eid="1CH 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11" />“我儿啊，现在愿耶和华与你同在，使你顺利建造你的神耶和华的殿，正如他论到你所说的话。 <verse eid="1CH 22:11" /><verse number="12" style="v" sid="1CH 22:12" />唯愿耶和华赐给你见识和悟性，这样他委任你统治<char style="pn">以色列</char>时，你就会遵守你的神耶和华的律法。 <verse eid="1CH 22:12" /><verse number="13" style="v" sid="1CH 22:13" />那时，如果你谨守遵行耶和华指示<char style="pn">摩西</char>给<char style="pn">以色列</char>的律例和法规，就必亨通。你要坚强、勇敢！不要害怕，不要丧胆。<verse eid="1CH 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 22:14" />“看哪，我辛苦为耶和华的殿预备了金子十万他连得<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">十万他连得——相当于3,420公吨。1他连得=34.2公斤。</char></note>，银子一百万他连得<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">一百万他连得——相当于34,200公吨。</char></note>，铜和铁多得无法称量；我也预备了木材和料石，你还可以增添。 <verse eid="1CH 22:14" /><verse number="15" style="v" sid="1CH 22:15" />此外在你这里有许多工人，石匠，雕刻木头石头的，以及一切能做各样工艺的巧匠， <verse eid="1CH 22:15" /><verse number="16" style="v" sid="1CH 22:16" />又有无数的金、银、铜、铁。起来行动吧，愿耶和华与你同在！”<verse eid="1CH 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17" />
    <char style="pn">大卫</char>又吩咐<char style="pn">以色列</char>所有的首领帮助他儿子<char style="pn">所罗门</char>，说： <verse eid="1CH 22:17" /><verse number="18" style="v" sid="1CH 22:18" />“你们的神耶和华不是与你们同在吗？他不是使你们四围都安定吗？因他已经把这地的居民交在我手中，这地在耶和华面前和他子民面前被征服了。 <verse eid="1CH 22:18" /><verse number="19" style="v" sid="1CH 22:19" />现在你们要立定心志寻求耶和华你们的神，起来建造神耶和华的圣所，好把耶和华的约柜和神的神圣器皿都搬进为耶和华的名所建造的殿宇。”<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" sid="1CH 23" />
  <para style="s">分配利未人班组</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1" />
    <char style="pn">大卫</char>年迈，寿数满足时，立他儿子<char style="pn">所罗门</char>为<char style="pn">以色列</char>的王。 <verse eid="1CH 23:1" /><verse number="2" style="v" sid="1CH 23:2" /><char style="pn">大卫</char>招聚<char style="pn">以色列</char>的所有首领，以及祭司和<char style="pn">利未</char>人。 <verse eid="1CH 23:2" /><verse number="3" style="v" sid="1CH 23:3" />三十岁以上的<char style="pn">利未</char>人都被数点，按着他们的人头，数目是男丁三万八千。 <verse eid="1CH 23:3" /><verse number="4" style="v" sid="1CH 23:4" />其中监管耶和华殿工作的有两万四千人，作官长和审判官的有六千人， <verse eid="1CH 23:4" /><verse number="5" style="v" sid="1CH 23:5" />门卫有四千人，那些用<char style="pn">大卫</char>所预备的颂赞乐器来赞美耶和华的，有四千人。<verse eid="1CH 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 23:6" />
    <char style="pn">大卫</char>又按着<char style="pn">利未</char>的儿子<char style="pn">革顺</char>、<char style="pn">哥辖</char>和<char style="pn">米拉利</char>的宗族，给他们分配班组。<verse eid="1CH 23:6" /></para>
  <para style="mi">
    <verse number="7" style="v" sid="1CH 23:7" />
    <char style="pn">革顺</char>人有<char style="pn">拉丹</char>和<char style="pn">示每</char>。<verse eid="1CH 23:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="1CH 23:8" />
    <char style="pn">拉丹</char>的儿子，长子是<char style="pn">耶希业</char>，其次是<char style="pn">泽坦</char>和<char style="pn">约珥</char>，共三人。 <verse eid="1CH 23:8" /><verse number="9" style="v" sid="1CH 23:9" />这些人是<char style="pn">拉丹</char>各父系的首领。</para>
  <para style="mi" vid="1CH 23:9">
    <char style="pn">示每</char>的儿子是<char style="pn">示罗米</char>、<char style="pn">哈薛</char>和<char style="pn">哈兰</char>，共三人。<verse eid="1CH 23:9" /></para>
  <para style="mi">
    <verse number="10" style="v" sid="1CH 23:10" />
    <char style="pn">示每</char>的子孙是<char style="pn">雅哈</char>、<char style="pn">细撒</char><note caller="+" style="f"><char style="fr" closed="false">23:10 </char><char style="ft" closed="false">细撒——依据七十士译本；马索拉文本作“细拿”；参照下一节。</char></note>、<char style="pn">耶乌施</char>和<char style="pn">比利亚</char>，这四人都是<char style="pn">示每</char>的子孙。<verse eid="1CH 23:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="1CH 23:11" />
    <char style="pn">雅哈</char>是长子，<char style="pn">细撒</char>是次子；<char style="pn">耶乌施</char>和<char style="pn">比利亚</char>子孙不多，归为一个父家，同属一个职份。<verse eid="1CH 23:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="1CH 23:12" />
    <char style="pn">哥辖</char>的儿子是<char style="pn">阿姆兰</char>、<char style="pn">以斯哈</char>、<char style="pn">希伯伦</char>和<char style="pn">乌基业</char>，共四人。<verse eid="1CH 23:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 23:13" />
    <char style="pn">阿姆兰</char>的儿子是<char style="pn">亚伦</char>和<char style="pn">摩西</char>。</para>
  <para style="m" vid="1CH 23:13">
    <char style="pn">亚伦</char>和他的子孙永远被分别出来，为要被分别为至圣的<note caller="+" style="f"><char style="fr" closed="false">23:13 </char><char style="ft" closed="false">为要被分别为至圣的——或译作“为要把至圣之物分别为圣”。</char></note>，在耶和华面前烧香、事奉，奉耶和华的名祝福，直到永远。 <verse eid="1CH 23:13" /><verse number="14" style="v" sid="1CH 23:14" />至于神人<char style="pn">摩西</char>，他的子孙被算在<char style="pn">利未</char>支派中。<verse eid="1CH 23:14" /></para>
  <para style="mi">
    <verse number="15" style="v" sid="1CH 23:15" />
    <char style="pn">摩西</char>的儿子是<char style="pn">革顺</char>和<char style="pn">以利以谢</char>。<verse eid="1CH 23:15" /></para>
  <para style="mi">
    <verse number="16" style="v" sid="1CH 23:16" />
    <char style="pn">革顺</char>的儿子，有长子<char style="pn">谢布业</char>。<verse eid="1CH 23:16" /></para>
  <para style="mi">
    <verse number="17" style="v" sid="1CH 23:17" />
    <char style="pn">以利以谢</char>的儿子，有头生的<char style="pn">利哈比雅</char>；<char style="pn">以利以谢</char>没有别的儿子，但<char style="pn">利哈比雅</char>的儿子却很多。<verse eid="1CH 23:17" /></para>
  <para style="mi">
    <verse number="18" style="v" sid="1CH 23:18" />
    <char style="pn">以斯哈</char>的儿子，有长子<char style="pn">示罗米</char>。 <verse eid="1CH 23:18" /><verse number="19" style="v" sid="1CH 23:19" /><char style="pn">希伯伦</char>的儿子，有长子<char style="pn">耶利雅</char>，</para>
  <para style="mi" vid="1CH 23:19">次子<char style="pn">亚玛利雅</char>，三子<char style="pn">雅哈希</char>，</para>
  <para style="mi" vid="1CH 23:19">四子<char style="pn">耶咖缅</char>。<verse eid="1CH 23:19" /></para>
  <para style="mi">
    <verse number="20" style="v" sid="1CH 23:20" />
    <char style="pn">乌基业</char>的儿子，有长子<char style="pn">米迦</char>，</para>
  <para style="mi" vid="1CH 23:20">次子<char style="pn">伊示亚</char>。<verse eid="1CH 23:20" /></para>
  <para style="mi">
    <verse number="21" style="v" sid="1CH 23:21" />
    <char style="pn">米拉利</char>的儿子有<char style="pn">玛赫利</char>和<char style="pn">穆希</char>，</para>
  <para style="mi" vid="1CH 23:21">
    <char style="pn">玛赫利</char>的儿子有<char style="pn">以利亚撒</char>和<char style="pn">基士</char>。<verse eid="1CH 23:21" /></para>
  <para style="mi">
    <verse number="22" style="v" sid="1CH 23:22" />
    <char style="pn">以利亚撒</char>死了，他没有儿子，只有女儿，</para>
  <para style="mi" vid="1CH 23:22">她们的族兄弟——就是<char style="pn">基士</char>的众子——娶了她们。<verse eid="1CH 23:22" /></para>
  <para style="mi">
    <verse number="23" style="v" sid="1CH 23:23" />
    <char style="pn">穆希</char>的儿子有<char style="pn">玛赫利</char>、<char style="pn">伊德</char>和<char style="pn">耶利莫</char>，共三人。<verse eid="1CH 23:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="1CH 23:24" />以上按着他们的父家，都是<char style="pn">利未</char>的子孙，是各父系的首领，按名单，按着他们的人头数点，都在二十岁以上，为耶和华的殿服事做工。 <verse eid="1CH 23:24" /><verse number="25" style="v" sid="1CH 23:25" />因为<char style="pn">大卫</char>说：“<char style="pn">以色列</char>的神耶和华已经使他的子民得享安息，他将永远居住在<char style="pn">耶路撒冷</char>， <verse eid="1CH 23:25" /><verse number="26" style="v" sid="1CH 23:26" /><char style="pn">利未</char>人也不必再抬帐幕和其中一切用于服事的器具了。” <verse eid="1CH 23:26" /><verse number="27" style="v" sid="1CH 23:27" />根据<char style="pn">大卫</char>临终的吩咐，他们都是二十岁以上被数点的<char style="pn">利未</char>子孙。 <verse eid="1CH 23:27" /><verse number="28" style="v" sid="1CH 23:28" />他们的职任是协助<char style="pn">亚伦</char>子孙做耶和华殿的服事工作，管理庭院和公房，负责洁净一切圣物，从事神殿的各样服事工作； <verse eid="1CH 23:28" /><verse number="29" style="v" sid="1CH 23:29" />负责陈设饼、素祭的细面粉、无酵薄饼，烤制、揉拌，也负责所有的容量和尺寸； <verse eid="1CH 23:29" /><verse number="30" style="v" sid="1CH 23:30" />每天早晨侍立，称谢赞美耶和华，傍晚也是如此； <verse eid="1CH 23:30" /><verse number="31" style="v" sid="1CH 23:31" />也负责向耶和华献上一切燔祭，在安息日、新月节和各节期，按照数目，照着规定，把燔祭常献在耶和华面前。 <verse eid="1CH 23:31" /><verse number="32" style="v" sid="1CH 23:32" />他们要谨守会幕的职责、圣所的职责，以及协助他们的族兄弟<char style="pn">亚伦</char>子孙的职责，在耶和华的殿服事。<verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" sid="1CH 24" />
  <para style="s">分配祭司班组</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1" />
    <char style="pn">亚伦</char>子孙的班组如下：<char style="pn">亚伦</char>的儿子是<char style="pn">纳达布</char>、<char style="pn">亚比户</char>、<char style="pn">以利亚撒</char>和<char style="pn">以塔玛尔</char>。 <verse eid="1CH 24:1" /><verse number="2" style="v" sid="1CH 24:2" /><char style="pn">纳达布</char>和<char style="pn">亚比户</char>比他们父亲死的早，没有子嗣，因此<char style="pn">以利亚撒</char>和<char style="pn">以塔玛尔</char>作祭司。 <verse eid="1CH 24:2" /><verse number="3" style="v" sid="1CH 24:3" /><char style="pn">大卫</char>与<char style="pn">以利亚撒</char>的子孙<char style="pn">撒督</char>和<char style="pn">以塔玛尔</char>的子孙<char style="pn">亚希米勒</char>，按着各人的监管职份，分派他们的服事工作， <verse eid="1CH 24:3" /><verse number="4" style="v" sid="1CH 24:4" />可是发现<char style="pn">以利亚撒</char>子孙中作首领的比<char style="pn">以塔玛尔</char>子孙多，就给他们分派如下：<char style="pn">以利亚撒</char>的子孙，按着父家，有十六人作首领；<char style="pn">以塔玛尔</char>的子孙，按着父家，有八人。 <verse eid="1CH 24:4" /><verse number="5" style="v" sid="1CH 24:5" />他们以抽签的方式分派，彼此同等，因为<char style="pn">以利亚撒</char>的子孙和<char style="pn">以塔玛尔</char>的子孙中，都有在圣所作首领的，以及在神面前作首领的。<verse eid="1CH 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 24:6" />有<char style="pn">利未</char>人<char style="pn">拿旦业</char>的儿子书记<char style="pn">示玛雅</char>作记录，在君王、众首领、祭司<char style="pn">撒督</char>、<char style="pn">亚比亚特</char>的儿子<char style="pn">亚希米勒</char>，以及祭司和<char style="pn">利未</char>人各父系的首领面前，记录他们的名字。为<char style="pn">以利亚撒</char>一个父家抽一签，也为<char style="pn">以塔玛尔</char>一个父家抽一签。<verse eid="1CH 24:6" /></para>
  <para style="mi">
    <verse number="7" style="v" sid="1CH 24:7" />第一支签为<char style="pn">耶赫亚利</char>抽出，第二支为<char style="pn">耶达亚</char>，<verse eid="1CH 24:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="1CH 24:8" />第三支为<char style="pn">哈琳</char>，第四支为<char style="pn">梭琳</char>，<verse eid="1CH 24:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="1CH 24:9" />第五支为<char style="pn">玛基雅</char>，第六支为<char style="pn">米雅悯</char>，<verse eid="1CH 24:9" /></para>
  <para style="mi">
    <verse number="10" style="v" sid="1CH 24:10" />第七支为<char style="pn">哈克兹</char>，第八支为<char style="pn">亚比雅</char>，<verse eid="1CH 24:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="1CH 24:11" />第九支为<char style="pn">耶书亚</char>，第十支为<char style="pn">谢喀尼亚</char>，<verse eid="1CH 24:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="1CH 24:12" />第十一支为<char style="pn">以利亚实</char>，第十二支为<char style="pn">雅其姆</char>，<verse eid="1CH 24:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 24:13" />第十三支为<char style="pn">胡巴</char>，第十四支为<char style="pn">耶示比押</char>，<verse eid="1CH 24:13" /></para>
  <para style="mi">
    <verse number="14" style="v" sid="1CH 24:14" />第十五支为<char style="pn">比勒伽</char>，第十六支为<char style="pn">伊梅尔</char>，<verse eid="1CH 24:14" /></para>
  <para style="mi">
    <verse number="15" style="v" sid="1CH 24:15" />第十七支为<char style="pn">赫兹尔</char>，第十八支为<char style="pn">哈皮泽</char>，<verse eid="1CH 24:15" /></para>
  <para style="mi">
    <verse number="16" style="v" sid="1CH 24:16" />第十九支为<char style="pn">佩塔希雅</char>，第二十支为<char style="pn">以西结</char>，<verse eid="1CH 24:16" /></para>
  <para style="mi">
    <verse number="17" style="v" sid="1CH 24:17" />第二十一支为<char style="pn">雅斤</char>，第二十二支为<char style="pn">迦末</char>，<verse eid="1CH 24:17" /></para>
  <para style="mi">
    <verse number="18" style="v" sid="1CH 24:18" />第二十三支为<char style="pn">德拉雅</char>，第二十四支为<char style="pn">玛西亚</char>。<verse eid="1CH 24:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19" />以上就是他们监管职份的班组，为要照着规定进入耶和华的殿服事；这规定是先祖<char style="pn">亚伦</char>经手，照着<char style="pn">以色列</char>的神耶和华的指示所定的。<verse eid="1CH 24:19" /></para>
  <para style="b" />
  <para style="s">分配其余的利未人</para>
  <para style="mi">
    <verse number="20" style="v" sid="1CH 24:20" />至于其余的<char style="pn">利未</char>子孙：</para>
  <para style="mi" vid="1CH 24:20">
    <char style="pn">阿姆兰</char>的子孙中有<char style="pn">书巴业</char>，</para>
  <para style="mi" vid="1CH 24:20">
    <char style="pn">书巴业</char>的子孙中有<char style="pn">耶希迪亚</char>。<verse eid="1CH 24:20" /></para>
  <para style="mi">
    <verse number="21" style="v" sid="1CH 24:21" />还有<char style="pn">利哈比雅</char>，</para>
  <para style="mi" vid="1CH 24:21">
    <char style="pn">利哈比雅</char>的子孙中有为首的<char style="pn">伊示亚</char>。<verse eid="1CH 24:21" /></para>
  <para style="mi">
    <verse number="22" style="v" sid="1CH 24:22" />
    <char style="pn">以斯哈</char>的子孙中有<char style="pn">示罗莫</char>，</para>
  <para style="mi" vid="1CH 24:22">
    <char style="pn">示罗莫</char>的子孙中有<char style="pn">雅哈</char>。<verse eid="1CH 24:22" /></para>
  <para style="mi">
    <verse number="23" style="v" sid="1CH 24:23" />还有<char style="pn">希伯伦</char>的儿子：</para>
  <para style="mi" vid="1CH 24:23">长子<char style="pn">耶利雅</char>，次子<char style="pn">亚玛利雅</char>，</para>
  <para style="mi" vid="1CH 24:23">三子<char style="pn">雅哈希</char>，四子<char style="pn">耶咖缅</char>。<verse eid="1CH 24:23" /></para>
  <para style="mi">
    <verse number="24" style="v" sid="1CH 24:24" />
    <char style="pn">乌基业</char>的子孙中有<char style="pn">米迦</char>，</para>
  <para style="mi" vid="1CH 24:24">
    <char style="pn">米迦</char>的子孙中有<char style="pn">沙米尔</char>。<verse eid="1CH 24:24" /></para>
  <para style="mi">
    <verse number="25" style="v" sid="1CH 24:25" />还有<char style="pn">米迦</char>的兄弟<char style="pn">伊示亚</char>，</para>
  <para style="mi" vid="1CH 24:25">
    <char style="pn">伊示亚</char>的子孙中有<char style="pn">撒迦利亚</char>。<verse eid="1CH 24:25" /></para>
  <para style="mi">
    <verse number="26" style="v" sid="1CH 24:26" />
    <char style="pn">米拉利</char>的子孙中有<char style="pn">玛赫利</char>、<char style="pn">穆希</char>，</para>
  <para style="mi" vid="1CH 24:26">以及他儿子<char style="pn">雅西雅</char>的子孙<note caller="+" style="f"><char style="fr" closed="false">24:26 </char><char style="ft" closed="false">他儿子雅西雅的子孙——或译作“雅西雅的子孙比挪”。</char></note>。<verse eid="1CH 24:26" /></para>
  <para style="mi">
    <verse number="27" style="v" sid="1CH 24:27" />
    <char style="pn">米拉利</char>子孙中，属于<char style="pn">雅西雅</char>的有</para>
  <para style="mi" vid="1CH 24:27">
    <char style="pn">比挪</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">24:27 </char>
      <char style="ft" closed="false">属于雅西雅的有比挪——或译作“属于他儿子雅西雅的有”。</char>
    </note>、<char style="pn">朔含</char>、<char style="pn">扎克尔</char>、<char style="pn">伊比利</char>。<verse eid="1CH 24:27" /></para>
  <para style="mi">
    <verse number="28" style="v" sid="1CH 24:28" />属于<char style="pn">玛赫利</char>的有<char style="pn">以利亚撒</char>，<char style="pn">以利亚撒</char>没有儿子；<verse eid="1CH 24:28" /></para>
  <para style="mi">
    <verse number="29" style="v" sid="1CH 24:29" />至于<char style="pn">基士</char>，<char style="pn">基士</char>的子孙中有<char style="pn">耶拉米列</char>。<verse eid="1CH 24:29" /></para>
  <para style="mi">
    <verse number="30" style="v" sid="1CH 24:30" />还有<char style="pn">穆希</char>的儿子<char style="pn">玛赫利</char>、<char style="pn">伊德</char>和<char style="pn">耶利莫</char>。</para>
  <para style="b" vid="1CH 24:30" />
  <para style="p" vid="1CH 24:30">以上按着他们的父家，都是<char style="pn">利未</char>的子孙。 <verse eid="1CH 24:30" /><verse number="31" style="v" sid="1CH 24:31" />他们也与他们的族兄弟<char style="pn">亚伦</char>子孙一样，在<char style="pn">大卫</char>王、<char style="pn">撒督</char>、<char style="pn">亚希米勒</char>，以及祭司和<char style="pn">利未</char>人各父系的首领面前抽签；族长们与他们最小的族兄弟一样抽签。<verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" sid="1CH 25" />
  <para style="s">利未乐师</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1" />
    <char style="pn">大卫</char>和服事队伍的首领们也把<char style="pn">亚萨</char>、<char style="pn">希幔</char>和<char style="pn">耶杜顿</char>的子孙分别出来<note caller="+" style="f"><char style="fr" closed="false">25:1 </char><char style="ft" closed="false">服事队伍的首领们也把……分别出来——或译作“军队的将领们也把……分别出来服事”。</char></note>，要他们伴着竖琴、里拉琴和铜钹来说神言。他们的服事工作人数如下：<verse eid="1CH 25:1" /></para>
  <para style="mi">
    <verse number="2" style="v" sid="1CH 25:2" />
    <char style="pn">亚萨</char>的儿子有</para>
  <para style="mi" vid="1CH 25:2">
    <char style="pn">扎克尔</char>、<char style="pn">约瑟</char>、<char style="pn">尼坦亚</char>和<char style="pn">亚撒利拉</char>；</para>
  <para style="mi" vid="1CH 25:2">
    <char style="pn">亚萨</char>的儿子们都在<char style="pn">亚萨</char>的指挥下，</para>
  <para style="mi" vid="1CH 25:2">
    <char style="pn">亚萨</char>受王的指示说神言。<verse eid="1CH 25:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 25:3" />属<char style="pn">耶杜顿</char>的，有<char style="pn">耶杜顿</char>的儿子</para>
  <para style="mi" vid="1CH 25:3">
    <char style="pn">基大利</char>、<char style="pn">西利</char>、<char style="pn">耶赛亚</char>、<char style="pn">示每</char>、<char style="pn">哈沙比雅</char>和<char style="pn">玛塔提雅</char>，共六人，都在他们父亲<char style="pn">耶杜顿</char>的指挥下，伴着竖琴说神言，称谢赞美耶和华。<verse eid="1CH 25:3" /></para>
  <para style="mi">
    <verse number="4" style="v" sid="1CH 25:4" />属<char style="pn">希幔</char>的，有<char style="pn">希幔</char>的儿子</para>
  <para style="mi" vid="1CH 25:4">
    <char style="pn">布其雅</char>、<char style="pn">玛塔尼亚</char>、<char style="pn">乌基业</char>、<char style="pn">谢布业</char>、<char style="pn">耶利莫</char>、<char style="pn">哈纳尼雅</char>、<char style="pn">哈纳尼</char>、<char style="pn">以利亚塔</char>、<char style="pn">格达利提</char>、<char style="pn">罗幔提·以谢</char>、<char style="pn">约施比咖沙</char>、<char style="pn">玛罗提</char>、<char style="pn">何提</char>和<char style="pn">玛哈秀特</char>。 <verse eid="1CH 25:4" /><verse number="5" style="v" sid="1CH 25:5" />这些都是王的先见<char style="pn">希幔</char>的儿子，是神照着应许，为要高抬他<note caller="+" style="f"><char style="fr" closed="false">25:5 </char><char style="ft" closed="false">高抬他——原文直译“高举犄角”。</char></note>而赐予的；神赐给<char style="pn">希幔</char>十四个儿子，三个女儿。<verse eid="1CH 25:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="1CH 25:6" />这些人都在他们父亲的指挥下，在耶和华殿中用诗歌，用铜钹、竖琴和里拉琴做神殿中的服事。<char style="pn">亚萨</char>、<char style="pn">耶杜顿</char>和<char style="pn">希幔</char>受了王的指示服事。 <verse eid="1CH 25:6" /><verse number="7" style="v" sid="1CH 25:7" />他们连同他们的族兄弟，就是所有在献给耶和华的诗歌上受过训练，精通歌唱的，数目共有两百八十八人。 <verse eid="1CH 25:7" /><verse number="8" style="v" sid="1CH 25:8" />他们无论尊卑，无论师徒，都一样为职责抽签。<verse eid="1CH 25:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="1CH 25:9" />第一支签为<char style="pn">亚萨</char>的子孙<char style="pn">约瑟</char>抽出。第二支为<char style="pn">基大利</char>，以及他的族兄弟、儿子，共十二人。<verse eid="1CH 25:9" /></para>
  <para style="mi">
    <verse number="10" style="v" sid="1CH 25:10" />第三支为<char style="pn">扎克尔</char>，以及他的儿子和族兄弟，共十二人。<verse eid="1CH 25:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="1CH 25:11" />第四支为<char style="pn">伊希利</char>，以及他的儿子和族兄弟，共十二人。<verse eid="1CH 25:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="1CH 25:12" />第五支为<char style="pn">尼坦亚</char>，以及他的儿子和族兄弟，共十二人。<verse eid="1CH 25:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 25:13" />第六支为<char style="pn">布其雅</char>，以及他的儿子和族兄弟，共十二人。<verse eid="1CH 25:13" /></para>
  <para style="mi">
    <verse number="14" style="v" sid="1CH 25:14" />第七支为<char style="pn">耶萨利拉</char>，以及他的儿子和族兄弟，共十二人。<verse eid="1CH 25:14" /></para>
  <para style="mi">
    <verse number="15" style="v" sid="1CH 25:15" />第八支为<char style="pn">耶赛亚</char>，以及他的儿子和族兄弟，共十二人。<verse eid="1CH 25:15" /></para>
  <para style="mi">
    <verse number="16" style="v" sid="1CH 25:16" />第九支为<char style="pn">玛塔尼亚</char>，以及他的儿子和族兄弟，共十二人。<verse eid="1CH 25:16" /></para>
  <para style="mi">
    <verse number="17" style="v" sid="1CH 25:17" />第十支为<char style="pn">示每</char>，以及他的儿子和族兄弟，共十二人。<verse eid="1CH 25:17" /></para>
  <para style="mi">
    <verse number="18" style="v" sid="1CH 25:18" />第十一支为<char style="pn">阿扎列</char>，以及他的儿子和族兄弟，共十二人。<verse eid="1CH 25:18" /></para>
  <para style="mi">
    <verse number="19" style="v" sid="1CH 25:19" />第十二支为<char style="pn">哈沙比雅</char>，以及他的儿子和族兄弟，共十二人。<verse eid="1CH 25:19" /></para>
  <para style="mi">
    <verse number="20" style="v" sid="1CH 25:20" />第十三支为<char style="pn">书巴业</char>，以及他的儿子和族兄弟，共十二人。<verse eid="1CH 25:20" /></para>
  <para style="mi">
    <verse number="21" style="v" sid="1CH 25:21" />第十四支为<char style="pn">玛塔提雅</char>，以及他的儿子和族兄弟，共十二人。<verse eid="1CH 25:21" /></para>
  <para style="mi">
    <verse number="22" style="v" sid="1CH 25:22" />第十五支为<char style="pn">耶利莫</char>，以及他的儿子和族兄弟，共十二人。<verse eid="1CH 25:22" /></para>
  <para style="mi">
    <verse number="23" style="v" sid="1CH 25:23" />第十六支为<char style="pn">哈纳尼雅</char>，以及他的儿子和族兄弟，共十二人。<verse eid="1CH 25:23" /></para>
  <para style="mi">
    <verse number="24" style="v" sid="1CH 25:24" />第十七支为<char style="pn">约施比咖沙</char>，以及他的儿子和族兄弟，共十二人。<verse eid="1CH 25:24" /></para>
  <para style="mi">
    <verse number="25" style="v" sid="1CH 25:25" />第十八支为<char style="pn">哈纳尼</char>，以及他的儿子和族兄弟，共十二人。<verse eid="1CH 25:25" /></para>
  <para style="mi">
    <verse number="26" style="v" sid="1CH 25:26" />第十九支为<char style="pn">玛罗提</char>，以及他的儿子和族兄弟，共十二人。<verse eid="1CH 25:26" /></para>
  <para style="mi">
    <verse number="27" style="v" sid="1CH 25:27" />第二十支为<char style="pn">以利亚塔</char>，以及他的儿子和族兄弟，共十二人。<verse eid="1CH 25:27" /></para>
  <para style="mi">
    <verse number="28" style="v" sid="1CH 25:28" />第二十一支为<char style="pn">何提</char>，以及他的儿子和族兄弟，共十二人。<verse eid="1CH 25:28" /></para>
  <para style="mi">
    <verse number="29" style="v" sid="1CH 25:29" />第二十二支为<char style="pn">格达利提</char>，以及他的儿子和族兄弟，共十二人。<verse eid="1CH 25:29" /></para>
  <para style="mi">
    <verse number="30" style="v" sid="1CH 25:30" />第二十三支为<char style="pn">玛哈秀特</char>，以及他的儿子和族兄弟，共十二人。<verse eid="1CH 25:30" /></para>
  <para style="mi">
    <verse number="31" style="v" sid="1CH 25:31" />第二十四支为<char style="pn">罗幔提·以谢</char>，以及他的儿子和族兄弟，共十二人。<verse eid="1CH 25:31" /></para>
  <chapter eid="1CH 25" />
  <chapter number="26" style="c" sid="1CH 26" />
  <para style="s">利未门卫</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 26:1" />以下是门卫的班组：</para>
  <para style="mi" vid="1CH 26:1">
    <char style="pn">可拉</char>家系<char style="pn">亚萨</char>的子孙中，</para>
  <para style="mi" vid="1CH 26:1">有<char style="pn">可列</char>的儿子<char style="pn">米施利米雅</char>。<verse eid="1CH 26:1" /></para>
  <para style="mi">
    <verse number="2" style="v" sid="1CH 26:2" />
    <char style="pn">米施利米雅</char>的儿子，</para>
  <para style="mi" vid="1CH 26:2">有长子<char style="pn">撒迦利亚</char>，次子<char style="pn">耶迪阿业</char>，</para>
  <para style="mi" vid="1CH 26:2">三子<char style="pn">希巴迪亚</char>，四子<char style="pn">亚特尼尔</char>，<verse eid="1CH 26:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 26:3" />五子<char style="pn">以拦</char>，六子<char style="pn">约哈南</char>，</para>
  <para style="mi" vid="1CH 26:3">七子<char style="pn">以利约奈</char>。<verse eid="1CH 26:3" /></para>
  <para style="mi">
    <verse number="4" style="v" sid="1CH 26:4" />
    <char style="pn">俄别·以东</char>的儿子，</para>
  <para style="mi" vid="1CH 26:4">有长子<char style="pn">示玛雅</char>，次子<char style="pn">约撒巴</char>，</para>
  <para style="mi" vid="1CH 26:4">三子<char style="pn">约亚</char>，四子<char style="pn">沙卡尔</char>，</para>
  <para style="mi" vid="1CH 26:4">五子<char style="pn">拿旦业</char>， <verse eid="1CH 26:4" /><verse number="5" style="v" sid="1CH 26:5" />六子<char style="pn">亚米利</char>，</para>
  <para style="mi" vid="1CH 26:5">七子<char style="pn">以萨迦</char>，八子<char style="pn">佩乌利太</char>；</para>
  <para style="mi" vid="1CH 26:5">神实在祝福了<char style="pn">俄别·以东</char>。<verse eid="1CH 26:5" /></para>
  <para style="mi">
    <verse number="6" style="v" sid="1CH 26:6" />他儿子<char style="pn">示玛雅</char>所生的儿子，都是他们父家的领袖，因为他们是英勇的战士。<verse eid="1CH 26:6" /></para>
  <para style="mi">
    <verse number="7" style="v" sid="1CH 26:7" />
    <char style="pn">示玛雅</char>的儿子有<char style="pn">俄得尼</char>、<char style="pn">利法益</char>、<char style="pn">俄备得</char>和<char style="pn">以利萨巴</char>，<char style="pn">以利萨巴</char>的兄弟<char style="pn">以利户</char>和<char style="pn">西玛迦</char>都是勇士。 <verse eid="1CH 26:7" /><verse number="8" style="v" sid="1CH 26:8" />这些都是<char style="pn">俄别·以东</char>的子孙，他们和他们的儿子、族兄弟都是在服事上有能力有才干的人。<char style="pn">俄别·以东</char>的子孙共有六十二人。<verse eid="1CH 26:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="1CH 26:9" />
    <char style="pn">米施利米雅</char>的儿子和族兄弟，都是勇士，共十八人。<verse eid="1CH 26:9" /></para>
  <para style="mi">
    <verse number="10" style="v" sid="1CH 26:10" />
    <char style="pn">米拉利</char>子孙<char style="pn">何萨</char>的儿子，有长子<char style="pn">示姆利</char>——他并不是头生的，但他父亲立他为长子—— <verse eid="1CH 26:10" /><verse number="11" style="v" sid="1CH 26:11" />次子<char style="pn">希勒加</char>，三子<char style="pn">底巴利雅</char>，四子<char style="pn">撒迦利亚</char>。<char style="pn">何萨</char>的儿子和族兄弟，共有十三个人。<verse eid="1CH 26:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="1CH 26:12" />对于这些门卫的班组，作首领的人与他们的族兄弟一样有职责，都在耶和华的殿中事奉。 <verse eid="1CH 26:12" /><verse number="13" style="v" sid="1CH 26:13" />他们无论尊卑，都按着父家，为各门抽签。<verse eid="1CH 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 26:14" />抽到东门的签是<char style="pn">示勒米雅</char>。他儿子<char style="pn">撒迦利亚</char>是个有见识的谋士，他们抽签，他的签抽出来是北门。 <verse eid="1CH 26:14" /><verse number="15" style="v" sid="1CH 26:15" /><char style="pn">俄别·以东</char>抽到南门，他的儿子们抽到了库房。 <verse eid="1CH 26:15" /><verse number="16" style="v" sid="1CH 26:16" /><char style="pn">书皮姆</char>与<char style="pn">何萨</char>抽到西门，连同斜坡大道上的<char style="pn">沙利基</char>门。</para>
  <para style="p" vid="1CH 26:16">守卫与守卫相对而立， <verse eid="1CH 26:16" /><verse number="17" style="v" sid="1CH 26:17" />每天看守东门的有六个<char style="pn">利未</char>人，看守北门的有四个，看守南门的有四个，看守仓库的是两个、两个轮流。 <verse eid="1CH 26:17" /><verse number="18" style="v" sid="1CH 26:18" />看守西边前院的，有四个人在大道上，两个人在前院里。<verse eid="1CH 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 26:19" />以上都是<char style="pn">可拉</char>子孙和<char style="pn">米拉利</char>子孙中的门卫班组。<verse eid="1CH 26:19" /></para>
  <para style="s">利未其他的职守</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20" />
    <char style="pn">利未</char>人<char style="pn">亚希雅</char>管理神殿的库房，以及存放圣物的库房。 <verse eid="1CH 26:20" /><verse number="21" style="v" sid="1CH 26:21" /><char style="pn">拉丹</char>的子孙，就是属于<char style="pn">拉丹</char>的<char style="pn">革顺</char>人，作<char style="pn">拉丹</char>父系首领的是<char style="pn">革顺</char>人<char style="pn">耶希伊利</char>； <verse eid="1CH 26:21" /><verse number="22" style="v" sid="1CH 26:22" /><char style="pn">耶希伊利</char>的儿子，就是<char style="pn">泽坦</char>和他的兄弟<char style="pn">约珥</char>，管理耶和华殿中的库房。<verse eid="1CH 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 26:23" />
    <char style="pn">阿姆兰</char>家族、<char style="pn">以斯哈</char>家族、<char style="pn">希伯伦</char>家族和<char style="pn">乌基业</char>家族中： <verse eid="1CH 26:23" /><verse number="24" style="v" sid="1CH 26:24" /><char style="pn">摩西</char>的孙子、<char style="pn">革顺</char>的儿子<char style="pn">谢布业</char>担任库房的总管。 <verse eid="1CH 26:24" /><verse number="25" style="v" sid="1CH 26:25" /><char style="pn">谢布业</char>的族兄弟是<char style="pn">以利以谢</char>，<char style="pn">以利以谢</char>的儿子是<char style="pn">利哈比雅</char>，<char style="pn">利哈比雅</char>的儿子是<char style="pn">耶赛亚</char>，<char style="pn">耶赛亚</char>的儿子是<char style="pn">约兰</char>，<char style="pn">约兰</char>的儿子是<char style="pn">泽克利</char>，<char style="pn">泽克利</char>的儿子是<char style="pn">示罗米</char>； <verse eid="1CH 26:25" /><verse number="26" style="v" sid="1CH 26:26" />这<char style="pn">示罗米</char>和他的族兄弟们管理所有库房的圣物，就是<char style="pn">大卫</char>王、各父系首领、千夫长、百夫长和将领们所分别为圣之物。 <verse eid="1CH 26:26" /><verse number="27" style="v" sid="1CH 26:27" />他们把战争中的战利品分别为圣，以备修缮耶和华的殿。 <verse eid="1CH 26:27" /><verse number="28" style="v" sid="1CH 26:28" />先见<char style="pn">撒母耳</char>、<char style="pn">基士</char>的儿子<char style="pn">扫罗</char>、<char style="pn">尼珥</char>的儿子<char style="pn">押尼珥</char>和<char style="pn">洗鲁雅</char>的儿子<char style="pn">约押</char>所分别为圣的一切，凡是分别为圣的，都由<char style="pn">示罗米</char>和他的族兄弟经手管理。<verse eid="1CH 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 26:29" />
    <char style="pn">以斯哈</char>家族有<char style="pn">克纳尼雅</char>和他的儿子们担当圣殿以外的工作，作<char style="pn">以色列</char>的官长和审判官。 <verse eid="1CH 26:29" /><verse number="30" style="v" sid="1CH 26:30" /><char style="pn">希伯伦</char>家族有<char style="pn">哈沙比雅</char>和他的族兄弟，共一千七百个勇士，在<char style="pn">约旦</char>河西岸担当<char style="pn">以色列</char>的监管职份，负责耶和华的一切工作和王的服事工作。 <verse eid="1CH 26:30" /><verse number="31" style="v" sid="1CH 26:31" /><char style="pn">希伯伦</char>家族的<char style="pn">耶利雅</char>，按着父家谱系是<char style="pn">希伯伦</char>家族的首领；<char style="pn">大卫</char>在位第四十年做普查，在<char style="pn">基列</char>的<char style="pn">雅谢</char>从他们家族中找到一些英勇的战士。 <verse eid="1CH 26:31" /><verse number="32" style="v" sid="1CH 26:32" /><char style="pn">耶利雅</char>的族兄弟有两千七百人，都是勇士，是各父系的首领。<char style="pn">大卫</char>王指派他们管理<char style="pn">鲁本</char>支派、<char style="pn">迦得</char>支派和<char style="pn">玛拿西</char>半支派中一切有关神的事务和王的事务。<verse eid="1CH 26:32" /></para>
  <chapter eid="1CH 26" />
  <chapter number="27" style="c" sid="1CH 27" />
  <para style="s">大卫的官吏</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 27:1" />以下是<char style="pn">以色列</char>子孙各父系的首领、千夫长、百夫长，以及在一切事务上事奉王的官长们的数目。各班组在一年中所有的月份按月轮流出入，每个班组有两万四千人。<verse eid="1CH 27:1" /></para>
  <para style="mi">
    <verse number="2" style="v" sid="1CH 27:2" />一月第一班组是<char style="pn">撒巴迪业</char>的儿子<char style="pn">雅朔班</char>负责，他的班组有两万四千人。 <verse eid="1CH 27:2" /><verse number="3" style="v" sid="1CH 27:3" />他是<char style="pn">法勒斯</char>的子孙，是一月班组所有将领的首领。<verse eid="1CH 27:3" /></para>
  <para style="mi">
    <verse number="4" style="v" sid="1CH 27:4" />二月第二班组是<char style="pn">阿赫阿</char>人<char style="pn">朵代</char>负责，领袖<char style="pn">米克罗</char>也在他班组；他的班组有两万四千人。<verse eid="1CH 27:4" /></para>
  <para style="mi">
    <verse number="5" style="v" sid="1CH 27:5" />三月第三班组是祭司长<char style="pn">耶赫亚达</char>的儿子将领<char style="pn">比纳雅</char>负责，他的班组有两万四千人。 <verse eid="1CH 27:5" /><verse number="6" style="v" sid="1CH 27:6" />这<char style="pn">比纳雅</char>是三十勇士之一，管理那三十人，他的儿子<char style="pn">暗米萨拔</char>也在他班组。<verse eid="1CH 27:6" /></para>
  <para style="mi">
    <verse number="7" style="v" sid="1CH 27:7" />四月第四班组是<char style="pn">约押</char>的弟弟<char style="pn">亚撒晖</char>负责，接续他的是他儿子<char style="pn">希巴迪亚</char>；他的班组有两万四千人。<verse eid="1CH 27:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="1CH 27:8" />五月第五班组是首领<char style="pn">伊斯拉</char>人<char style="pn">珊合</char>负责，他的班组有两万四千人。<verse eid="1CH 27:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="1CH 27:9" />六月第六班组是<char style="pn">提克亚</char>人<char style="pn">益吉</char>的儿子<char style="pn">伊拉</char>负责，他的班组有两万四千人。<verse eid="1CH 27:9" /></para>
  <para style="mi">
    <verse number="10" style="v" sid="1CH 27:10" />七月第七班组是<char style="pn">以法莲</char>子孙<char style="pn">佩罗尼</char>人<char style="pn">希利斯</char>负责，他的班组有两万四千人。<verse eid="1CH 27:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="1CH 27:11" />八月第八班组是<char style="pn">谢拉</char>家族的<char style="pn">户沙</char>人<char style="pn">西比凯</char>负责，他的班组有两万四千人。<verse eid="1CH 27:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="1CH 27:12" />九月第九班组是<char style="pn">便雅悯</char>子孙<char style="pn">亚拿突</char>人<char style="pn">亚比以谢</char>负责，他的班组有两万四千人。<verse eid="1CH 27:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="1CH 27:13" />十月第十班组是<char style="pn">谢拉</char>家族的<char style="pn">尼托法</char>人<char style="pn">玛哈莱</char>负责，他的班组有两万四千人。<verse eid="1CH 27:13" /></para>
  <para style="mi">
    <verse number="14" style="v" sid="1CH 27:14" />十一月第十一班组是<char style="pn">以法莲</char>子孙<char style="pn">比拉顿</char>人<char style="pn">比纳雅</char>负责，他的班组有两万四千人。<verse eid="1CH 27:14" /></para>
  <para style="mi">
    <verse number="15" style="v" sid="1CH 27:15" />十二月第十二班组是<char style="pn">俄陀聂</char>家系<char style="pn">尼托法</char>人<char style="pn">赫尔达伊</char>负责，他的班组有两万四千人。<verse eid="1CH 27:15" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="16" style="v" sid="1CH 27:16" />以下是<char style="pn">以色列</char>各支派的负责人：</para>
  <para style="mi" vid="1CH 27:16">
    <char style="pn">鲁本</char>支派的领袖，是<char style="pn">泽克利</char>的儿子<char style="pn">以利以谢</char>；</para>
  <para style="mi" vid="1CH 27:16">
    <char style="pn">西缅</char>支派，是<char style="pn">玛迦</char>的儿子<char style="pn">示法提雅</char>；<verse eid="1CH 27:16" /></para>
  <para style="mi">
    <verse number="17" style="v" sid="1CH 27:17" />
    <char style="pn">利未</char>支派，是<char style="pn">基姆利</char>的儿子<char style="pn">哈沙比雅</char>；</para>
  <para style="mi" vid="1CH 27:17">
    <char style="pn">亚伦</char>子孙，是<char style="pn">撒督</char>；<verse eid="1CH 27:17" /></para>
  <para style="mi">
    <verse number="18" style="v" sid="1CH 27:18" />
    <char style="pn">犹大</char>支派，是<char style="pn">大卫</char>的哥哥<char style="pn">以利户</char>；</para>
  <para style="mi" vid="1CH 27:18">
    <char style="pn">以萨迦</char>支派，是<char style="pn">米迦勒</char>的儿子<char style="pn">欧姆利</char>；<verse eid="1CH 27:18" /></para>
  <para style="mi">
    <verse number="19" style="v" sid="1CH 27:19" />
    <char style="pn">西布伦</char>支派，是<char style="pn">俄巴底亚</char>的儿子<char style="pn">伊施玛雅</char>；</para>
  <para style="mi" vid="1CH 27:19">
    <char style="pn">拿弗他利</char>支派，是<char style="pn">亚斯列</char>的儿子<char style="pn">耶利莫</char>；<verse eid="1CH 27:19" /></para>
  <para style="mi">
    <verse number="20" style="v" sid="1CH 27:20" />
    <char style="pn">以法莲</char>子孙，是<char style="pn">阿撒细雅</char>的儿子<char style="pn">何西阿</char>；</para>
  <para style="mi" vid="1CH 27:20">
    <char style="pn">玛拿西</char>半支派，是<char style="pn">皮达雅</char>的儿子<char style="pn">约珥</char>；<verse eid="1CH 27:20" /></para>
  <para style="mi">
    <verse number="21" style="v" sid="1CH 27:21" />
    <char style="pn">玛拿西</char>在<char style="pn">基列</char>地的那半支派，是<char style="pn">撒迦利亚</char>的儿子<char style="pn">伊度</char>；</para>
  <para style="mi" vid="1CH 27:21">
    <char style="pn">便雅悯</char>支派，是<char style="pn">押尼珥</char>的儿子<char style="pn">雅西业</char>；<verse eid="1CH 27:21" /></para>
  <para style="mi">
    <verse number="22" style="v" sid="1CH 27:22" />
    <char style="pn">但</char>支派，是<char style="pn">耶罗罕</char>的儿子<char style="pn">阿扎列</char>。</para>
  <para style="mi" vid="1CH 27:22">以上是<char style="pn">以色列</char>各支派的首领。<verse eid="1CH 27:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23" />
    <char style="pn">大卫</char>没有统计二十岁以下之人的数目，因为耶和华已经应许，他要使<char style="pn">以色列</char>增多，如同天上的星辰。 <verse eid="1CH 27:23" /><verse number="24" style="v" sid="1CH 27:24" /><char style="pn">洗鲁雅</char>的儿子<char style="pn">约押</char>曾经开始数点，但因着这事，耶和华的震怒临到了<char style="pn">以色列</char>，所以他没有完成，数目也没有记在《<char style="pn">大卫</char>王年代志》上。<verse eid="1CH 27:24" /></para>
  <para style="mi">
    <verse number="25" style="v" sid="1CH 27:25" />负责王室库房的是<char style="pn">亚迪业</char>的儿子<char style="pn">阿兹玛维</char>，</para>
  <para style="mi" vid="1CH 27:25">负责郊外、城镇、乡村和守望楼那些库房的是<char style="pn">乌西雅</char>的儿子<char style="pn">约拿单</char>，<verse eid="1CH 27:25" /></para>
  <para style="mi">
    <verse number="26" style="v" sid="1CH 27:26" />负责那些在田野做工、耕种土地之人的，是<char style="pn">基律</char>的儿子<char style="pn">以斯利</char>；<verse eid="1CH 27:26" /></para>
  <para style="mi">
    <verse number="27" style="v" sid="1CH 27:27" />负责葡萄园的是<char style="pn">拉玛</char>人<char style="pn">示每</char>，</para>
  <para style="mi" vid="1CH 27:27">负责葡萄园中酒库的是<char style="pn">实弗米</char>人<char style="pn">扎布迪</char>，<verse eid="1CH 27:27" /></para>
  <para style="mi">
    <verse number="28" style="v" sid="1CH 27:28" />负责丘陵上的橄榄园和西克莫无花果树的是<char style="pn">基第利</char>人<char style="pn">巴勒·哈南</char>，</para>
  <para style="mi" vid="1CH 27:28">负责油库的是<char style="pn">约阿施</char>，<verse eid="1CH 27:28" /></para>
  <para style="mi">
    <verse number="29" style="v" sid="1CH 27:29" />负责那些牧放在<char style="pn">沙仑</char>的牛群的是<char style="pn">沙仑</char>人<char style="pn">希特赖</char>，</para>
  <para style="mi" vid="1CH 27:29">负责那些牧放在平原的牛群的是<char style="pn">亚第赉</char>的儿子<char style="pn">沙法</char>，<verse eid="1CH 27:29" /></para>
  <para style="mi">
    <verse number="30" style="v" sid="1CH 27:30" />负责骆驼的是<char style="pn">以实玛利</char>人<char style="pn">阿比勒</char>，</para>
  <para style="mi" vid="1CH 27:30">负责驴子的是<char style="pn">米伦</char>人<char style="pn">耶希迪亚</char>，<verse eid="1CH 27:30" /></para>
  <para style="mi">
    <verse number="31" style="v" sid="1CH 27:31" />负责羊群的是<char style="pn">哈格利</char>人<char style="pn">雅悉</char>。</para>
  <para style="mi" vid="1CH 27:31">以上是为<char style="pn">大卫</char>王管理财物的官员。<verse eid="1CH 27:31" /></para>
  <para style="b" />
  <para style="p">
    <verse number="32" style="v" sid="1CH 27:32" />
    <char style="pn">大卫</char>的叔叔<char style="pn">约拿单</char>作谋士，他是有悟性的人，也是文士。<char style="pn">哈克莫尼</char>的儿子<char style="pn">耶希业</char>辅导王子们。 <verse eid="1CH 27:32" /><verse number="33" style="v" sid="1CH 27:33" /><char style="pn">亚希多弗</char>也是王的谋士。<char style="pn">亚基</char>人<char style="pn">户筛</char>是王的朋友。 <verse eid="1CH 27:33" /><verse number="34" style="v" sid="1CH 27:34" /><char style="pn">亚希多弗</char>之后，<char style="pn">比纳雅</char>的儿子<char style="pn">耶赫亚达</char>和<char style="pn">亚比亚特</char>作谋士。<char style="pn">约押</char>作王的元帅。<verse eid="1CH 27:34" /></para>
  <chapter eid="1CH 27" />
  <chapter number="28" style="c" sid="1CH 28" />
  <para style="s">大卫指定所罗门建圣殿</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1" />
    <char style="pn">大卫</char>把<char style="pn">以色列</char>所有的首领招聚到<char style="pn">耶路撒冷</char>，他们是各支派的首领、事奉王的各班组首领、千夫长、百夫长、为王和王子管理一切财物牲畜的官员，还有内臣和勇士们，以及所有英勇的战士。 <verse eid="1CH 28:1" /><verse number="2" style="v" sid="1CH 28:2" /><char style="pn">大卫</char>王站起来，说：“我的兄弟，我的子民哪，请听我说！我心中有意要为耶和华的约柜、为我们神的脚凳建造一个安息之所，并且我已经预备好要建造， <verse eid="1CH 28:2" /><verse number="3" style="v" sid="1CH 28:3" />然而神对我说：‘你不可为我的名建造殿宇，因为你是个战士，曾经流过人的血。’<verse eid="1CH 28:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 28:4" />“<char style="pn">以色列</char>的神耶和华从我父的全家拣选我，永远作<char style="pn">以色列</char>的王。他拣选了<char style="pn">犹大</char>作首领，在<char style="pn">犹大</char>家拣选我父家，又在我父的儿子中喜悦我，立我作全<char style="pn">以色列</char>的王。 <verse eid="1CH 28:4" /><verse number="5" style="v" sid="1CH 28:5" />从我所有的儿子中——耶和华实在赐给了我许多儿子——他又拣选我儿子<char style="pn">所罗门</char>坐耶和华国度的王位，统治<char style="pn">以色列</char>。 <verse eid="1CH 28:5" /><verse number="6" style="v" sid="1CH 28:6" />耶和华对我说：‘是你的儿子<char style="pn">所罗门</char>，他将要建造我的殿宇和庭院，因为我已拣选他作我的儿子，我要作他的父亲。 <verse eid="1CH 28:6" /><verse number="7" style="v" sid="1CH 28:7" />如果他坚持遵行我的诫命和法规，像今日这样，我就坚立他的王权，直到永远。’<verse eid="1CH 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 28:8" />“现在，耶和华的会众全体<char style="pn">以色列</char>人都在看，我们的神也在听：你们要谨守并寻求你们神耶和华的一切诫命，好使你们可以继承这美地，并且给你们的后代子孙为继业，直到永远。<verse eid="1CH 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9" />“至于你，我儿<char style="pn">所罗门</char>哪，当认识你父亲的神，要以完全的心、乐意的灵服事他，因为耶和华鉴察所有人的心，洞察人的每个意念动机。如果你寻求他，他必让你寻见；如果你离弃他，他必永远抛弃你。 <verse eid="1CH 28:9" /><verse number="10" style="v" sid="1CH 28:10" />现在你看，耶和华已经拣选你来建造殿宇为圣所，你要坚强行事！”<verse eid="1CH 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11" />
    <char style="pn">大卫</char>把圣殿的设计都交给他儿子<char style="pn">所罗门</char>，有门廊、房屋、府库、楼阁、内殿和施恩座圣所。 <verse eid="1CH 28:11" /><verse number="12" style="v" sid="1CH 28:12" />这设计包含他灵里所领受的一切，有耶和华殿的庭院、四围所有的房间、神殿中的库房和存放圣物的库房； <verse eid="1CH 28:12" /><verse number="13" style="v" sid="1CH 28:13" />还有祭司和<char style="pn">利未</char>人的班组，耶和华殿中的各样服事工作，以及耶和华殿中各样服事器具的规格： <verse eid="1CH 28:13" /><verse number="14" style="v" sid="1CH 28:14" />用于服事的各样金器所需的金子重量；用于服事的各样银器、各样器皿所需的银子重量； <verse eid="1CH 28:14" /><verse number="15" style="v" sid="1CH 28:15" />照着每个灯台的服事用途，每个灯台和它灯盏的重量，金灯台和灯盏所需的金子重量，银灯台和灯盏所需的银子重量； <verse eid="1CH 28:15" /><verse number="16" style="v" sid="1CH 28:16" />按每张桌子计算，陈设饼的桌子所需的金子重量，银桌子所需的银子重量； <verse eid="1CH 28:16" /><verse number="17" style="v" sid="1CH 28:17" />叉子、碗和壶所需的纯金重量；各金碟所需的金子重量；各银碟所需的银子重量； <verse eid="1CH 28:17" /><verse number="18" style="v" sid="1CH 28:18" />纯金香坛所需的金子重量；还包括耶和华乘驾的<note caller="+" style="f"><char style="fr" closed="false">28:18 </char><char style="ft" closed="false">耶和华乘驾的——原文直译“战车”；参《撒母耳记下》22:11。</char></note>金基路伯的设计，它展翅遮掩着耶和华的约柜。<verse eid="1CH 28:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 28:19" />
    <char style="pn">大卫</char>说：“因耶和华的手在我身上，我明悟了所记录下来的这一切——这设计的所有细节。”<verse eid="1CH 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20" />
    <char style="pn">大卫</char>又对他的儿子<char style="pn">所罗门</char>说：“你要坚强、勇敢行事！不要害怕，不要丧胆，因为耶和华神——我的神与你同在。他必不撇下你，也不离弃你，直到耶和华殿中服事所需的一切工作全都完成。 <verse eid="1CH 28:20" /><verse number="21" style="v" sid="1CH 28:21" />你看，有各班组的祭司和<char style="pn">利未</char>人准备做神殿各样的服事；那些在各样工作上有才能并且甘心乐意的人都在你身边，准备做各样的服事；首领们和所有百姓都听从你的一切指挥。”<verse eid="1CH 28:21" /></para>
  <chapter eid="1CH 28" />
  <chapter number="29" style="c" sid="1CH 29" />
  <para style="s">建圣殿的捐献</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1" />
    <char style="pn">大卫</char>王对全体会众说：“神特别拣选了我儿子<char style="pn">所罗门</char>，他还年少幼嫩，而这工程极大，因为这宫殿不是为人，而是为耶和华神建造的。 <verse eid="1CH 29:1" /><verse number="2" style="v" sid="1CH 29:2" />我已经尽力为我神的殿预备了金器所需的金子、银器所需的银子、铜器所需的铜、铁器所需的铁、木器所需的木材，还有红玛瑙石、镶嵌用的孔雀石，以及彩石、各样的宝石和大量的大理石。 <verse eid="1CH 29:2" /><verse number="3" style="v" sid="1CH 29:3" />此外，因我喜爱我神的殿，我除了为圣殿所预备的一切之外，也把我自己的金银珍宝献给了我神的殿， <verse eid="1CH 29:3" /><verse number="4" style="v" sid="1CH 29:4" />有三千他连得<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">三千他连得——相当于100公吨。1他连得=34.2公斤。</char></note><char style="pn">俄斐</char>黄金、七千他连得<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">七千他连得——相当于240公吨。</char></note>纯银，要用来装饰殿宇的墙， <verse eid="1CH 29:4" /><verse number="5" style="v" sid="1CH 29:5" />并要用金子做金器，银子做银器，藉着工匠的手做成各样的工艺品。今天谁甘愿奉献，全心归于耶和华呢？”<verse eid="1CH 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6" />于是各家族的首领、<char style="pn">以色列</char>各支派的首领、千夫长、百夫长和管理王事务的官员，都甘愿奉献。 <verse eid="1CH 29:6" /><verse number="7" style="v" sid="1CH 29:7" />他们为神殿的服事捐献了金子五千他连得零一万达利克<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">五千他连得零一万达利克——相当于171公吨又84公斤。1他连得=34.2公斤；1达利克金币=8.4公克。</char></note>，银子一万他连得<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">一万他连得——相当于342公吨。</char></note>，铜一万八千他连得<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">一万八千他连得——相当于616公吨。</char></note>，铁十万他连得<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">十万他连得——相当于3,420公吨。</char></note>。 <verse eid="1CH 29:7" /><verse number="8" style="v" sid="1CH 29:8" />那些有宝石的也捐献宝石到耶和华殿的库房里，由<char style="pn">革顺</char>人<char style="pn">耶希业</char>经手管理。 <verse eid="1CH 29:8" /><verse number="9" style="v" sid="1CH 29:9" />民众因这些人甘愿奉献而欢喜，因为他们是全心甘愿奉献给耶和华的；<char style="pn">大卫</char>王也极其欢喜快乐。<verse eid="1CH 29:9" /></para>
  <para style="s">大卫的祷告</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10" />于是<char style="pn">大卫</char>在全体会众面前颂赞耶和华，<char style="pn">大卫</char>说：“我们先祖<char style="pn">以色列</char>的神耶和华啊，你是当受颂赞的，从永远到永远<note caller="+" style="f"><char style="fr" closed="false">29:10 </char><char style="ft" closed="false">永远到永远——或译作“亘古到永远”。</char></note>！ <verse eid="1CH 29:10" /><verse number="11" style="v" sid="1CH 29:11" />耶和华啊，尊大、权柄、荣耀、威严、尊荣都是你的，天上地上的万有都是你的。耶和华啊，国度也是你的，你显为尊崇，为万有之首。 <verse eid="1CH 29:11" /><verse number="12" style="v" sid="1CH 29:12" />财富和荣耀都从你而来，是你掌管一切。你手中有能力和权柄；你的手使人伟大、强盛。 <verse eid="1CH 29:12" /><verse number="13" style="v" sid="1CH 29:13" />我们的神哪，现在我们称谢你，赞美你荣耀之名。<verse eid="1CH 29:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14" />“我究竟算什么呢？我的子民算什么呢？我们竟然能这样甘愿奉献！其实一切都从你而来，我们只是把从你手中得来的献给你。 <verse eid="1CH 29:14" /><verse number="15" style="v" sid="1CH 29:15" />我们是依靠你的外人，是寄居的，像我们所有的祖先那样。我们在世的日子如同虚影，没有盼望。 <verse eid="1CH 29:15" /><verse number="16" style="v" sid="1CH 29:16" />耶和华我们的神哪，我们预备了这么多，要为你的圣名建造殿宇，这些都是从你手中得来的，一切都是属于你的。 <verse eid="1CH 29:16" /><verse number="17" style="v" sid="1CH 29:17" />我的神哪，我知道你察验人心，喜悦公平；我怀着正直的心，甘愿奉献了这一切，现在我也欢喜地看见你在这里的子民都甘愿奉献给你。 <verse eid="1CH 29:17" /><verse number="18" style="v" sid="1CH 29:18" />我们先祖<char style="pn">亚伯拉罕</char>、<char style="pn">以撒</char>、<char style="pn">以色列</char>的神耶和华啊，求你永远保守你子民心中这样的意念动机，使他们立定心志归向你。 <verse eid="1CH 29:18" /><verse number="19" style="v" sid="1CH 29:19" />求你赐我儿子<char style="pn">所罗门</char>一颗完全的心，好使他遵守你的诫命、法度和律例，去做成这一切，用我所预备的建造这殿宇。”<verse eid="1CH 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20" />然后<char style="pn">大卫</char>对全体会众说：“现在要颂赞耶和华你们的神！”全体会众就颂赞耶和华他们祖先的神，俯身向耶和华、向王下拜。<verse eid="1CH 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21" />第二天他们向耶和华献祭，向耶和华所献的燔祭有公牛一千头、公绵羊一千只、绵羊羔一千只，还有同献的酒祭，以及为全体<char style="pn">以色列</char>人献上的大量祭物。 <verse eid="1CH 29:21" /><verse number="22" style="v" sid="1CH 29:22" />那一天，他们极其欢喜地在耶和华面前吃喝。</para>
  <para style="s" vid="1CH 29:22">所罗门继位</para>
  <para style="p" vid="1CH 29:22">他们再次确立<char style="pn">大卫</char>的儿子<char style="pn">所罗门</char>作王，为耶和华膏立他作君王，又膏立<char style="pn">撒督</char>作祭司。 <verse eid="1CH 29:22" /><verse number="23" style="v" sid="1CH 29:23" />于是<char style="pn">所罗门</char>坐在耶和华设立<note caller="+" style="f"><char style="fr" closed="false">29:23 </char><char style="ft" closed="false">设立——辅助词语。</char></note>的宝座上，接替他父亲<char style="pn">大卫</char>作王。他就亨通，全体<char style="pn">以色列</char>人都听从他。 <verse eid="1CH 29:23" /><verse number="24" style="v" sid="1CH 29:24" />所有的首领和勇士，以及<char style="pn">大卫</char>王所有的儿子，都举手臣服<char style="pn">所罗门</char>王。 <verse eid="1CH 29:24" /><verse number="25" style="v" sid="1CH 29:25" />耶和华在全体<char style="pn">以色列</char>人面前高抬<char style="pn">所罗门</char>，赐给他王权的尊荣，是在他之前任何一个<char style="pn">以色列</char>王都比不上的。<verse eid="1CH 29:25" /></para>
  <para style="s">大卫生平概述</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26" />
    <char style="pn">耶西</char>的儿子<char style="pn">大卫</char>作全<char style="pn">以色列</char>的王， <verse eid="1CH 29:26" /><verse number="27" style="v" sid="1CH 29:27" />他统治<char style="pn">以色列</char>的日子有四十年：在<char style="pn">希伯仑</char>统治七年，在<char style="pn">耶路撒冷</char>统治三十三年。 <verse eid="1CH 29:27" /><verse number="28" style="v" sid="1CH 29:28" /><char style="pn">大卫</char>富贵荣华，尽享天年，寿数满足而死，他的儿子<char style="pn">所罗门</char>接替他作王。 <verse eid="1CH 29:28" /><verse number="29" style="v" sid="1CH 29:29" /><char style="pn">大卫</char>王从始至终的事迹，看哪，都记在《先见<char style="pn">撒母耳</char>纪事》《先知<char style="pn">拿单</char>纪事》和《先见<char style="pn">迦得</char>纪事》上。 <verse eid="1CH 29:29" /><verse number="30" style="v" sid="1CH 29:30" />他的王权、他的武力，以及他和<char style="pn">以色列</char>并这地列国所经历的时事，也都记在这些书上。<verse eid="1CH 29:30" /></para>
  <chapter eid="1CH 29" />
</usx>