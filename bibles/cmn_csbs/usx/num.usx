<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NUM" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">民数记</para>
  <para style="mt">民数记</para>
  <chapter number="1" style="c" sid="NUM 1" />
  <para style="s">数点以色列民</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 1:1" />
    <char style="pn">以色列</char>人出<char style="pn">埃及</char>地之后，第二年二月一日，耶和华在<char style="pn">西奈</char>旷野、在会幕中指示<char style="pn">摩西</char>说： <verse eid="NUM 1:1" /><verse number="2" style="v" sid="NUM 1:2" />“你们要统计全体<char style="pn">以色列</char>会众的人数；按着家族、父家，按名单<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="ft" closed="false">名单——原文直译“人名的数目”；下同。</char></note>，按着他们的人头统计所有的男子。 <verse eid="NUM 1:2" /><verse number="3" style="v" sid="NUM 1:3" />你和<char style="pn">亚伦</char>要按着队伍，数点<char style="pn">以色列</char>二十岁以上所有能出战的。 <verse eid="NUM 1:3" /><verse number="4" style="v" sid="NUM 1:4" />每个支派要有一个人协助你们，都要是父家的首领。 <verse eid="NUM 1:4" /><verse number="5" style="v" sid="NUM 1:5" />这些协助你们的人，名字如下：</para>
  <para style="q1" vid="NUM 1:5">属<char style="pn">鲁本</char>支派的，是<char style="pn">谢德珥</char>的儿子<char style="pn">以利佐</char>。<verse eid="NUM 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NUM 1:6" />属<char style="pn">西缅</char>支派的，是<char style="pn">苏利沙代</char>的儿子<char style="pn">谢路米业</char>。<verse eid="NUM 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 1:7" />属<char style="pn">犹大</char>支派的，是<char style="pn">亚米拿达</char>的儿子<char style="pn">拿顺</char>。<verse eid="NUM 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 1:8" />属<char style="pn">以萨迦</char>支派的，是<char style="pn">苏押</char>的儿子<char style="pn">拿旦业</char>。<verse eid="NUM 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 1:9" />属<char style="pn">西布伦</char>支派的，是<char style="pn">希伦</char>的儿子<char style="pn">以利押</char>。<verse eid="NUM 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NUM 1:10" />
    <char style="pn">约瑟</char>的子孙中，</para>
  <para style="q1" vid="NUM 1:10">属<char style="pn">以法莲</char>支派的，是<char style="pn">亚米忽</char>的儿子<char style="pn">以利沙玛</char>；</para>
  <para style="q1" vid="NUM 1:10">属<char style="pn">玛拿西</char>支派的，是<char style="pn">佩达佐</char>的儿子<char style="pn">迦玛列</char>。<verse eid="NUM 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NUM 1:11" />属<char style="pn">便雅悯</char>支派的，是<char style="pn">基多尼</char>的儿子<char style="pn">亚比但</char>。<verse eid="NUM 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NUM 1:12" />属<char style="pn">但</char>支派的，是<char style="pn">亚米沙代</char>的儿子<char style="pn">亚希以谢</char>。<verse eid="NUM 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NUM 1:13" />属<char style="pn">亚设</char>支派的，是<char style="pn">俄兰</char>的儿子<char style="pn">帕结</char>。<verse eid="NUM 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="NUM 1:14" />属<char style="pn">迦得</char>支派的，是<char style="pn">德珥</char>的儿子<char style="pn">以利雅萨</char>。<verse eid="NUM 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NUM 1:15" />属<char style="pn">拿弗他利</char>支派的，是<char style="pn">恩南</char>的儿子<char style="pn">亚希拉</char>。<verse eid="NUM 1:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="NUM 1:16" />以上是会众里选召出来的人，都是他们父系支派的领袖，是<char style="pn">以色列</char>千军的首领。”<verse eid="NUM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 1:17" />于是，<char style="pn">摩西</char>和<char style="pn">亚伦</char>带着这些被指名的人， <verse eid="NUM 1:17" /><verse number="18" style="v" sid="NUM 1:18" />在二月一日招聚全体会众，按着家族、父家，按名单，按着他们的人头，登记二十岁以上的男子。 <verse eid="NUM 1:18" /><verse number="19" style="v" sid="NUM 1:19" /><char style="pn">摩西</char>照着耶和华所指示的，在<char style="pn">西奈</char>旷野数点了他们。<verse eid="NUM 1:19" /></para>
  <para style="mi">
    <verse number="20" style="v" sid="NUM 1:20" />
    <char style="pn">以色列</char>的长子<char style="pn">鲁本</char>的子孙，他们的谱系：按着家族、父家，按名单，按着他们的人头，二十岁以上所有能出战的男子， <verse eid="NUM 1:20" /><verse number="21" style="v" sid="NUM 1:21" /><char style="pn">鲁本</char>支派被数点的，共四万六千五百人。<verse eid="NUM 1:21" /></para>
  <para style="mi">
    <verse number="22" style="v" sid="NUM 1:22" />
    <char style="pn">西缅</char>子孙的谱系：按着家族、父家，按名单数点，按着他们的人头，二十岁以上所有能出战的男子， <verse eid="NUM 1:22" /><verse number="23" style="v" sid="NUM 1:23" /><char style="pn">西缅</char>支派被数点的，共五万九千三百人。<verse eid="NUM 1:23" /></para>
  <para style="mi">
    <verse number="24" style="v" sid="NUM 1:24" />
    <char style="pn">迦得</char>子孙的谱系：按着家族、父家，按名单，二十岁以上所有能出战的男子， <verse eid="NUM 1:24" /><verse number="25" style="v" sid="NUM 1:25" /><char style="pn">迦得</char>支派被数点的，共四万五千六百五十人。<verse eid="NUM 1:25" /></para>
  <para style="mi">
    <verse number="26" style="v" sid="NUM 1:26" />
    <char style="pn">犹大</char>子孙的谱系：按着家族、父家，按名单，二十岁以上所有能出战的男子， <verse eid="NUM 1:26" /><verse number="27" style="v" sid="NUM 1:27" /><char style="pn">犹大</char>支派被数点的，共七万四千六百人。<verse eid="NUM 1:27" /></para>
  <para style="mi">
    <verse number="28" style="v" sid="NUM 1:28" />
    <char style="pn">以萨迦</char>子孙的谱系：按着家族、父家，按名单，二十岁以上所有能出战的男子， <verse eid="NUM 1:28" /><verse number="29" style="v" sid="NUM 1:29" /><char style="pn">以萨迦</char>支派被数点的，共五万四千四百人。<verse eid="NUM 1:29" /></para>
  <para style="mi">
    <verse number="30" style="v" sid="NUM 1:30" />
    <char style="pn">西布伦</char>子孙的谱系：按着家族、父家，按名单，二十岁以上所有能出战的男子， <verse eid="NUM 1:30" /><verse number="31" style="v" sid="NUM 1:31" /><char style="pn">西布伦</char>支派被数点的，共五万七千四百人。<verse eid="NUM 1:31" /></para>
  <para style="mi">
    <verse number="32" style="v" sid="NUM 1:32" />
    <char style="pn">约瑟</char>的子孙中，</para>
  <para style="mi" vid="NUM 1:32">
    <char style="pn">以法莲</char>子孙的谱系：按着家族、父家，按名单，二十岁以上所有能出战的男子， <verse eid="NUM 1:32" /><verse number="33" style="v" sid="NUM 1:33" /><char style="pn">以法莲</char>支派被数点的，共四万零五百人。<verse eid="NUM 1:33" /></para>
  <para style="mi">
    <verse number="34" style="v" sid="NUM 1:34" />
    <char style="pn">玛拿西</char>子孙的谱系：按着家族、父家，按名单，二十岁以上所有能出战的男子， <verse eid="NUM 1:34" /><verse number="35" style="v" sid="NUM 1:35" /><char style="pn">玛拿西</char>支派被数点的，共三万两千两百人。<verse eid="NUM 1:35" /></para>
  <para style="mi">
    <verse number="36" style="v" sid="NUM 1:36" />
    <char style="pn">便雅悯</char>子孙的谱系：按着家族、父家，按名单，二十岁以上所有能出战的男子， <verse eid="NUM 1:36" /><verse number="37" style="v" sid="NUM 1:37" /><char style="pn">便雅悯</char>支派被数点的，共三万五千四百人。<verse eid="NUM 1:37" /></para>
  <para style="mi">
    <verse number="38" style="v" sid="NUM 1:38" />
    <char style="pn">但</char>子孙的谱系：按着家族、父家，按名单，二十岁以上所有能出战的男子， <verse eid="NUM 1:38" /><verse number="39" style="v" sid="NUM 1:39" /><char style="pn">但</char>支派被数点的，共六万两千七百人。<verse eid="NUM 1:39" /></para>
  <para style="mi">
    <verse number="40" style="v" sid="NUM 1:40" />
    <char style="pn">亚设</char>子孙的谱系：按着家族、父家，按名单，二十岁以上所有能出战的男子， <verse eid="NUM 1:40" /><verse number="41" style="v" sid="NUM 1:41" /><char style="pn">亚设</char>支派被数点的，共四万一千五百人。<verse eid="NUM 1:41" /></para>
  <para style="mi">
    <verse number="42" style="v" sid="NUM 1:42" />
    <char style="pn">拿弗他利</char>子孙的谱系：按着家族、父家，按名单，二十岁以上所有能出战的男子， <verse eid="NUM 1:42" /><verse number="43" style="v" sid="NUM 1:43" /><char style="pn">拿弗他利</char>支派被数点的，共五万三千四百人。<verse eid="NUM 1:43" /></para>
  <para style="b" />
  <para style="p">
    <verse number="44" style="v" sid="NUM 1:44" />以上是被数点的人，是<char style="pn">摩西</char>和<char style="pn">亚伦</char>以及<char style="pn">以色列</char>的众领袖所数点的，领袖有十二人，各人代表自己的父家。 <verse eid="NUM 1:44" /><verse number="45" style="v" sid="NUM 1:45" />这些按父家被数点的<char style="pn">以色列</char>子孙，都是<char style="pn">以色列</char>中二十岁以上所有能出战的男子； <verse eid="NUM 1:45" /><verse number="46" style="v" sid="NUM 1:46" />被数点的总共有六十万三千五百五十人。<verse eid="NUM 1:46" /></para>
  <para style="s">利未人的职责</para>
  <para style="p">
    <verse number="47" style="v" sid="NUM 1:47" />
    <char style="pn">利未</char>人没有按着他们的父系支派与<char style="pn">以色列</char>子孙一起被数点， <verse eid="NUM 1:47" /><verse number="48" style="v" sid="NUM 1:48" />因为耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 1:48" /><verse number="49" style="v" sid="NUM 1:49" />“唯独不可数点<char style="pn">利未</char>支派，不可将他们的人数与<char style="pn">以色列</char>子孙一起统计。 <verse eid="NUM 1:49" /><verse number="50" style="v" sid="NUM 1:50" />你要指派<char style="pn">利未</char>人管理见证帐幕和其中的所有器具，以及属于帐幕的一切。他们要抬帐幕和帐幕的所有器具，做帐幕的事奉，在帐幕的四围扎营。 <verse eid="NUM 1:50" /><verse number="51" style="v" sid="NUM 1:51" />起行的时候，<char style="pn">利未</char>人要拆卸帐幕；扎营的时候，<char style="pn">利未</char>人要立起帐幕。接近帐幕的外人，必须被处死。<verse eid="NUM 1:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="NUM 1:52" />“<char style="pn">以色列</char>子孙扎营时，要各按自己的队伍，各归自己的营地，各归自己的旗帜。 <verse eid="NUM 1:52" /><verse number="53" style="v" sid="NUM 1:53" />至于<char style="pn">利未</char>人，要扎营在见证帐幕的四围，以免震怒临到<char style="pn">以色列</char>会众；<char style="pn">利未</char>人要谨守见证帐幕的职责。”<verse eid="NUM 1:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="NUM 1:54" />
    <char style="pn">以色列</char>子孙就这样做了；耶和华所指示<char style="pn">摩西</char>的一切，他们都照着做了。<verse eid="NUM 1:54" /></para>
  <chapter eid="NUM 1" />
  <chapter number="2" style="c" sid="NUM 2" />
  <para style="s">营地的布置</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 2:1" />耶和华指示<char style="pn">摩西</char>和<char style="pn">亚伦</char>说： <verse eid="NUM 2:1" /><verse number="2" style="v" sid="NUM 2:2" />“<char style="pn">以色列</char>子孙要各归自己的旗帜，照着父家的标帜扎营，要对着会幕在四围扎营。<verse eid="NUM 2:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="NUM 2:3" />“在东边日出的方向按队伍扎营的，是<char style="pn">犹大</char>营的旗帜；<char style="pn">犹大</char>子孙的领袖是<char style="pn">亚米拿达</char>的儿子<char style="pn">拿顺</char>， <verse eid="NUM 2:3" /><verse number="4" style="v" sid="NUM 2:4" />他的队伍，那些被数点的共七万四千六百人。 <verse eid="NUM 2:4" /><verse number="5" style="v" sid="NUM 2:5" />挨着他扎营的是<char style="pn">以萨迦</char>支派；<char style="pn">以萨迦</char>子孙的领袖是<char style="pn">苏押</char>的儿子<char style="pn">拿旦业</char>， <verse eid="NUM 2:5" /><verse number="6" style="v" sid="NUM 2:6" />他的队伍，那些被数点的共五万四千四百人。 <verse eid="NUM 2:6" /><verse number="7" style="v" sid="NUM 2:7" />然后是<char style="pn">西布伦</char>支派；<char style="pn">西布伦</char>子孙的领袖是<char style="pn">希伦</char>的儿子<char style="pn">以利押</char>， <verse eid="NUM 2:7" /><verse number="8" style="v" sid="NUM 2:8" />他的队伍，那些被数点的共五万七千四百人。 <verse eid="NUM 2:8" /><verse number="9" style="v" sid="NUM 2:9" />所有属<char style="pn">犹大</char>营、按队伍被数点的，共十八万六千四百人；他们要首先起行。<verse eid="NUM 2:9" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="10" style="v" sid="NUM 2:10" />“在南边，按队伍是<char style="pn">鲁本</char>营的旗帜；<char style="pn">鲁本</char>子孙的领袖是<char style="pn">谢德珥</char>的儿子<char style="pn">以利佐</char>， <verse eid="NUM 2:10" /><verse number="11" style="v" sid="NUM 2:11" />他的队伍，那些被数点的共四万六千五百人。 <verse eid="NUM 2:11" /><verse number="12" style="v" sid="NUM 2:12" />挨着他扎营的是<char style="pn">西缅</char>支派；<char style="pn">西缅</char>子孙的领袖是<char style="pn">苏利沙代</char>的儿子<char style="pn">谢路米业</char>， <verse eid="NUM 2:12" /><verse number="13" style="v" sid="NUM 2:13" />他的队伍，那些被数点的共五万九千三百人。 <verse eid="NUM 2:13" /><verse number="14" style="v" sid="NUM 2:14" />然后是<char style="pn">迦得</char>支派；<char style="pn">迦得</char>子孙的领袖是<char style="pn">德珥</char>的儿子<char style="pn">以利雅萨</char>， <verse eid="NUM 2:14" /><verse number="15" style="v" sid="NUM 2:15" />他的队伍，那些被数点的共四万五千六百五十人。 <verse eid="NUM 2:15" /><verse number="16" style="v" sid="NUM 2:16" />所有属<char style="pn">鲁本</char>营、按队伍被数点的，共十五万一千四百五十人；他们作为第二队起行。<verse eid="NUM 2:16" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="17" style="v" sid="NUM 2:17" />“随后，会幕和<char style="pn">利未</char>营要在众营中间起行。他们怎样扎营，也怎样起行；各照自己的位置，各按自己的旗帜。<verse eid="NUM 2:17" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="18" style="v" sid="NUM 2:18" />“在西边，按队伍是<char style="pn">以法莲</char>营的旗帜；<char style="pn">以法莲</char>子孙的领袖是<char style="pn">亚米忽</char>的儿子<char style="pn">以利沙玛</char>， <verse eid="NUM 2:18" /><verse number="19" style="v" sid="NUM 2:19" />他的队伍，那些被数点的共四万零五百人。 <verse eid="NUM 2:19" /><verse number="20" style="v" sid="NUM 2:20" />挨着他是<char style="pn">玛拿西</char>支派；<char style="pn">玛拿西</char>子孙的领袖是<char style="pn">佩达佐</char>的儿子<char style="pn">迦玛列</char>， <verse eid="NUM 2:20" /><verse number="21" style="v" sid="NUM 2:21" />他的队伍，那些被数点的共三万两千两百人。 <verse eid="NUM 2:21" /><verse number="22" style="v" sid="NUM 2:22" />然后是<char style="pn">便雅悯</char>支派；<char style="pn">便雅悯</char>子孙的领袖是<char style="pn">基多尼</char>的儿子<char style="pn">亚比但</char>， <verse eid="NUM 2:22" /><verse number="23" style="v" sid="NUM 2:23" />他的队伍，那些被数点的共三万五千四百人。 <verse eid="NUM 2:23" /><verse number="24" style="v" sid="NUM 2:24" />所有属<char style="pn">以法莲</char>营、按队伍被数点的，共十万八千一百人；他们作为第三队起行。<verse eid="NUM 2:24" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="25" style="v" sid="NUM 2:25" />“在北边，按队伍是<char style="pn">但</char>营的旗帜；<char style="pn">但</char>子孙的领袖是<char style="pn">亚米沙代</char>的儿子<char style="pn">亚希以谢</char>， <verse eid="NUM 2:25" /><verse number="26" style="v" sid="NUM 2:26" />他的队伍，那些被数点的共六万两千七百人。 <verse eid="NUM 2:26" /><verse number="27" style="v" sid="NUM 2:27" />挨着他扎营的是<char style="pn">亚设</char>支派；<char style="pn">亚设</char>子孙的领袖是<char style="pn">俄兰</char>的儿子<char style="pn">帕结</char>， <verse eid="NUM 2:27" /><verse number="28" style="v" sid="NUM 2:28" />他的队伍，那些被数点的共四万一千五百人。 <verse eid="NUM 2:28" /><verse number="29" style="v" sid="NUM 2:29" />然后是<char style="pn">拿弗他利</char>支派；<char style="pn">拿弗他利</char>子孙的领袖是<char style="pn">恩南</char>的儿子<char style="pn">亚希拉</char>， <verse eid="NUM 2:29" /><verse number="30" style="v" sid="NUM 2:30" />他的队伍，那些被数点的共五万三千四百人。 <verse eid="NUM 2:30" /><verse number="31" style="v" sid="NUM 2:31" />所有属<char style="pn">但</char>营被数点的，共十五万七千六百人；他们要随自己的旗帜最后起行。”<verse eid="NUM 2:31" /></para>
  <para style="b" />
  <para style="p">
    <verse number="32" style="v" sid="NUM 2:32" />以上是按父家被数点的<char style="pn">以色列</char>子孙；众营按队伍被数点的，总共六十万三千五百五十人。 <verse eid="NUM 2:32" /><verse number="33" style="v" sid="NUM 2:33" />照着耶和华指示<char style="pn">摩西</char>的，<char style="pn">利未</char>人没有与<char style="pn">以色列</char>子孙一起被数点。 <verse eid="NUM 2:33" /><verse number="34" style="v" sid="NUM 2:34" /><char style="pn">以色列</char>子孙就这样做，他们照着耶和华所指示<char style="pn">摩西</char>的一切，按着自己的旗帜扎营，各按家族和父家起行。<verse eid="NUM 2:34" /></para>
  <chapter eid="NUM 2" />
  <chapter number="3" style="c" sid="NUM 3" />
  <para style="s">亚伦的儿子和利未人</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 3:1" />以下是<char style="pn">亚伦</char>和<char style="pn">摩西</char>的家系记事，那时耶和华在<char style="pn">西奈</char>山向<char style="pn">摩西</char>说话。<verse eid="NUM 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 3:2" />
    <char style="pn">亚伦</char>儿子们的名字是：长子<char style="pn">纳达布</char>，还有<char style="pn">亚比户</char>、<char style="pn">以利亚撒</char>、<char style="pn">以塔玛尔</char>。 <verse eid="NUM 3:2" /><verse number="3" style="v" sid="NUM 3:3" />这些是<char style="pn">亚伦</char>儿子们的名字，他们是受膏的祭司，<char style="pn">摩西</char>使他们承接圣职作祭司。 <verse eid="NUM 3:3" /><verse number="4" style="v" sid="NUM 3:4" /><char style="pn">纳达布</char>和<char style="pn">亚比户</char>在<char style="pn">西奈</char>旷野向耶和华献上违规的火，就死在耶和华面前；他们没有儿子。<char style="pn">以利亚撒</char>和<char style="pn">以塔玛尔</char>在父亲<char style="pn">亚伦</char>面前<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">面前——或译作“活着时”。</char></note>作祭司。<verse eid="NUM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 3:5" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 3:5" /><verse number="6" style="v" sid="NUM 3:6" />“你要让<char style="pn">利未</char>支派上前来，侍立在祭司<char style="pn">亚伦</char>面前，辅助他。 <verse eid="NUM 3:6" /><verse number="7" style="v" sid="NUM 3:7" />他们要在会幕前为<char style="pn">亚伦</char>和全体会众谨守职责，做帐幕的服事工作。 <verse eid="NUM 3:7" /><verse number="8" style="v" sid="NUM 3:8" />他们也要看管会幕的所有器具，并且为<char style="pn">以色列</char>子民谨守职责，做帐幕的服事工作。 <verse eid="NUM 3:8" /><verse number="9" style="v" sid="NUM 3:9" />你要把<char style="pn">利未</char>人指派给<char style="pn">亚伦</char>和他的儿子们，这是从<char style="pn">以色列</char>子孙中特别指派给他们的。 <verse eid="NUM 3:9" /><verse number="10" style="v" sid="NUM 3:10" />你要指派<char style="pn">亚伦</char>和他的儿子们谨守他们祭司的职份；接近帐幕的外人，必须被处死。”<verse eid="NUM 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 3:11" />耶和华又指示<char style="pn">摩西</char>说： <verse eid="NUM 3:11" /><verse number="12" style="v" sid="NUM 3:12" />“看哪，我已经从<char style="pn">以色列</char>子孙中拣选了<char style="pn">利未</char>人，代替<char style="pn">以色列</char>子孙中所有头生的长子，所以<char style="pn">利未</char>人要归属我。 <verse eid="NUM 3:12" /><verse number="13" style="v" sid="NUM 3:13" />因为所有头生的都属于我；<char style="pn">埃及</char>地所有头生的被我击杀那天，我已经使<char style="pn">以色列</char>所有头生的，无论是人还是牲畜，都分别为圣归于我了，他们是属于我的。我是耶和华。”<verse eid="NUM 3:13" /></para>
  <para style="s">数点利未人</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 3:14" />耶和华在<char style="pn">西奈</char>旷野指示<char style="pn">摩西</char>说： <verse eid="NUM 3:14" /><verse number="15" style="v" sid="NUM 3:15" />“你要按父家和家族数点<char style="pn">利未</char>子孙；所有一个月以上的男性，你都要数点。” <verse eid="NUM 3:15" /><verse number="16" style="v" sid="NUM 3:16" /><char style="pn">摩西</char>就按照耶和华的命令，照着所受的指示数点他们。<verse eid="NUM 3:16" /></para>
  <para style="mi">
    <verse number="17" style="v" sid="NUM 3:17" />以下是<char style="pn">利未</char>儿子们的名字：<char style="pn">革顺</char>，<char style="pn">哥辖</char>，<char style="pn">米拉利</char>。 <verse eid="NUM 3:17" /><verse number="18" style="v" sid="NUM 3:18" /><char style="pn">革顺</char>儿子的名字，按家族是<char style="pn">立尼</char>、<char style="pn">示每</char>。 <verse eid="NUM 3:18" /><verse number="19" style="v" sid="NUM 3:19" /><char style="pn">哥辖</char>的儿子，按家族是<char style="pn">阿姆兰</char>、<char style="pn">以斯哈</char>、<char style="pn">希伯伦</char>、<char style="pn">乌基业</char>。 <verse eid="NUM 3:19" /><verse number="20" style="v" sid="NUM 3:20" /><char style="pn">米拉利</char>的儿子，按家族是<char style="pn">玛赫利</char>、<char style="pn">穆希</char>。这些是<char style="pn">利未</char>人的家族，各按他们的父家。<verse eid="NUM 3:20" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="21" style="v" sid="NUM 3:21" />属<char style="pn">革顺</char>的，有<char style="pn">立尼</char>家族和<char style="pn">示每</char>家族；这些是<char style="pn">革顺</char>的家族。 <verse eid="NUM 3:21" /><verse number="22" style="v" sid="NUM 3:22" />他们被数点的，是所有一个月以上男性的数目，被数点的共七千五百人。 <verse eid="NUM 3:22" /><verse number="23" style="v" sid="NUM 3:23" /><char style="pn">革顺</char>家族要在帐幕后面靠西边扎营， <verse eid="NUM 3:23" /><verse number="24" style="v" sid="NUM 3:24" /><char style="pn">革顺</char>人的父家领袖是<char style="pn">拉伊勒</char>的儿子<char style="pn">以利雅萨</char>。 <verse eid="NUM 3:24" /><verse number="25" style="v" sid="NUM 3:25" /><char style="pn">革顺</char>子孙在会幕中负责：帐幕，罩篷，罩篷的顶罩，会幕入口的帘幕， <verse eid="NUM 3:25" /><verse number="26" style="v" sid="NUM 3:26" />院子的帷幔，在帐幕和祭坛四围的院子入口的帘幕，它们的绳子，以及相关的一切工作。<verse eid="NUM 3:26" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="27" style="v" sid="NUM 3:27" />属<char style="pn">哥辖</char>的，有<char style="pn">阿姆兰</char>家族、<char style="pn">以斯哈</char>家族、<char style="pn">希伯伦</char>家族、<char style="pn">乌基业</char>家族；这些是<char style="pn">哥辖</char>的家族。 <verse eid="NUM 3:27" /><verse number="28" style="v" sid="NUM 3:28" />所有一个月以上男性的数目，共八千六百<note caller="+" style="f"><char style="fr" closed="false">3:28 </char><char style="ft" closed="false">八千六百——或译作“八千三百”。</char></note>人；他们要谨守圣所的职责。 <verse eid="NUM 3:28" /><verse number="29" style="v" sid="NUM 3:29" /><char style="pn">哥辖</char>子孙的家族要在帐幕南边扎营， <verse eid="NUM 3:29" /><verse number="30" style="v" sid="NUM 3:30" /><char style="pn">哥辖</char>家族的父家领袖是<char style="pn">乌基业</char>的儿子<char style="pn">以利撒番</char>。 <verse eid="NUM 3:30" /><verse number="31" style="v" sid="NUM 3:31" />他们负责：约柜，桌子，灯台，祭坛和香坛，事奉用的圣所器具，帘幕，以及相关的一切工作。 <verse eid="NUM 3:31" /><verse number="32" style="v" sid="NUM 3:32" /><char style="pn">利未</char>人众领袖的主管是祭司<char style="pn">亚伦</char>的儿子<char style="pn">以利亚撒</char>，他是那些谨守圣所职责之人的监督。<verse eid="NUM 3:32" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="33" style="v" sid="NUM 3:33" />属<char style="pn">米拉利</char>的，有<char style="pn">玛贺利</char>家族和<char style="pn">穆希</char>家族；这些是<char style="pn">米拉利</char>的家族。 <verse eid="NUM 3:33" /><verse number="34" style="v" sid="NUM 3:34" />他们被数点的，所有一个月以上男性的数目，共六千两百人。 <verse eid="NUM 3:34" /><verse number="35" style="v" sid="NUM 3:35" /><char style="pn">米拉利</char>家族的父家领袖是<char style="pn">亚比亥</char>的儿子<char style="pn">苏列</char>，他们要在帐幕北边扎营。 <verse eid="NUM 3:35" /><verse number="36" style="v" sid="NUM 3:36" /><char style="pn">米拉利</char>子孙所负责的是：帐幕的木板，门闩，柱子，底座，帐幕的所有器具，以及相关的一切工作， <verse eid="NUM 3:36" /><verse number="37" style="v" sid="NUM 3:37" />还有院子四围的柱子和它们的底座、橛子、绳子。<verse eid="NUM 3:37" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="38" style="v" sid="NUM 3:38" />在帐幕前面朝东，就是在会幕前面日出方向扎营的，是<char style="pn">摩西</char>和<char style="pn">亚伦</char>以及<char style="pn">亚伦</char>的儿子们。他们为圣所和<char style="pn">以色列</char>子民谨守职责<note caller="+" style="f"><char style="fr" closed="false">3:38 </char><char style="ft" closed="false">为圣所和以色列子民谨守职责——或译作“代表以色列子民谨守圣所的职责”。</char></note>。接近帐幕的外人，必须被处死。<verse eid="NUM 3:38" /></para>
  <para style="b" />
  <para style="p">
    <verse number="39" style="v" sid="NUM 3:39" />所有被数点的<char style="pn">利未</char>人，就是<char style="pn">摩西</char>和<char style="pn">亚伦</char>按照耶和华的指示、按家族数点的，所有一个月以上的男性，总共两万两千人。<verse eid="NUM 3:39" /></para>
  <para style="s">头生者的赎价</para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 3:40" />耶和华对<char style="pn">摩西</char>说：“你要数点<char style="pn">以色列</char>子孙中所有一个月以上的头生男性，按名单统计他们。 <verse eid="NUM 3:40" /><verse number="41" style="v" sid="NUM 3:41" />我是耶和华，你要拣选<char style="pn">利未</char>人归于我，代替<char style="pn">以色列</char>子孙所有头生的；并要用<char style="pn">利未</char>人的牲畜，代替<char style="pn">以色列</char>子孙所有头生的牲畜。” <verse eid="NUM 3:41" /><verse number="42" style="v" sid="NUM 3:42" /><char style="pn">摩西</char>就照着耶和华所指示的，数点<char style="pn">以色列</char>子孙中所有头生的。 <verse eid="NUM 3:42" /><verse number="43" style="v" sid="NUM 3:43" />按名单，所有一个月以上的头生男性，被数点的有两万两千两百七十三人。<verse eid="NUM 3:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 3:44" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 3:44" /><verse number="45" style="v" sid="NUM 3:45" />“你要拣选<char style="pn">利未</char>人，代替<char style="pn">以色列</char>子孙中所有头生的；并要用<char style="pn">利未</char>人的牲畜，代替<char style="pn">以色列</char>子孙的牲畜。<char style="pn">利未</char>人要归于我，我是耶和华。 <verse eid="NUM 3:45" /><verse number="46" style="v" sid="NUM 3:46" /><char style="pn">以色列</char>子孙头生的男子比<char style="pn">利未</char>人多出了两百七十三人，他们的赎价， <verse eid="NUM 3:46" /><verse number="47" style="v" sid="NUM 3:47" />你要每人收取五谢克尔，按圣所的谢克尔<note caller="+" style="f"><char style="fr" closed="false">3:47 </char><char style="ft" closed="false">谢克尔——重量单位；后来成为货币单位。1谢克尔=11.4公克。本章下同。</char></note>标准收取，一谢克尔是二十季拉<note caller="+" style="f"><char style="fr" closed="false">3:47 </char><char style="ft" closed="false">二十季拉——相当于11.4公克。1季拉=0.57公克。</char></note>。 <verse eid="NUM 3:47" /><verse number="48" style="v" sid="NUM 3:48" />你要把银子，就是多出来之人的赎价，交给<char style="pn">亚伦</char>和他的儿子们。”<verse eid="NUM 3:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="NUM 3:49" />
    <char style="pn">摩西</char>就在<char style="pn">利未</char>人所赎的人以外，向多出来的人收取赎价的银子。 <verse eid="NUM 3:49" /><verse number="50" style="v" sid="NUM 3:50" />他从这些<char style="pn">以色列</char>子孙的头生子那里收取了银子，按圣所的谢克尔标准，共一千三百七十五谢克尔<note caller="+" style="f"><char style="fr" closed="false">3:50 </char><char style="ft" closed="false">一千三百七十五谢克尔——相当于15.7公斤。1谢克尔=11.4公克。</char></note>。 <verse eid="NUM 3:50" /><verse number="51" style="v" sid="NUM 3:51" /><char style="pn">摩西</char>按照耶和华的吩咐，把赎价银子交给了<char style="pn">亚伦</char>和他的儿子们，正如耶和华所指示<char style="pn">摩西</char>的。<verse eid="NUM 3:51" /></para>
  <chapter eid="NUM 3" />
  <chapter number="4" style="c" sid="NUM 4" />
  <para style="s">哥辖子孙的职责</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 4:1" />耶和华指示<char style="pn">摩西</char>和<char style="pn">亚伦</char>说： <verse eid="NUM 4:1" /><verse number="2" style="v" sid="NUM 4:2" />“你们要按家族和父家，统计<char style="pn">利未</char>子孙中<char style="pn">哥辖</char>子孙的人数， <verse eid="NUM 4:2" /><verse number="3" style="v" sid="NUM 4:3" />就是三十岁以上到五十岁，所有前来供职、在会幕中工作的人数。<verse eid="NUM 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 4:4" />“<char style="pn">哥辖</char>子孙在会幕中有关至圣物的服事工作如下： <verse eid="NUM 4:4" /><verse number="5" style="v" sid="NUM 4:5" />当营队起行时，<char style="pn">亚伦</char>和他的儿子们要进去，取下帘幕的幔子，用它遮盖见证柜。 <verse eid="NUM 4:5" /><verse number="6" style="v" sid="NUM 4:6" />又放上海狮皮<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">海狮皮——原文语义不确定，基本意思是一种精细的皮革；本章下同。</char></note>的顶罩，再铺上纯蓝色的布，然后穿进杠子。<verse eid="NUM 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 4:7" />“<char style="pn">亚伦</char>和他的儿子们要在陈设饼的桌子上铺蓝色的布，其上摆放盘子、勺子、碗和酒祭用的壶，常献的饼也必须在桌上。 <verse eid="NUM 4:7" /><verse number="8" style="v" sid="NUM 4:8" />又在它们上面铺朱红色的布，再用海狮皮的顶罩遮盖，然后穿进杠子。<verse eid="NUM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 4:9" />“他们要取来蓝色的布，遮盖灯台和灯台的灯盏、灯剪、灯盘，以及所有的油罐，就是用来盛油的器皿。 <verse eid="NUM 4:9" /><verse number="10" style="v" sid="NUM 4:10" />然后把灯台和灯台的所有器具放进海狮皮的顶罩内，放在抬架上。<verse eid="NUM 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 4:11" />“他们要在金祭坛上铺蓝色的布，再用海狮皮的顶罩遮盖，然后穿进杠子。 <verse eid="NUM 4:11" /><verse number="12" style="v" sid="NUM 4:12" />他们要把圣所中事奉用的所有器具取来，包在蓝色的布里，再用海狮皮的顶罩遮盖它们，然后放在抬架上。<verse eid="NUM 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 4:13" />“他们要收去祭坛的灰，然后在祭坛上铺紫色的布。 <verse eid="NUM 4:13" /><verse number="14" style="v" sid="NUM 4:14" />又把祭坛上事奉用的所有器具，就是火盆、叉子、铲子、碗，以及一切祭坛用具，都放在祭坛上；再铺上海狮皮的顶罩，然后穿进杠子。<verse eid="NUM 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 4:15" />“营队起行的时候，<char style="pn">亚伦</char>和他的儿子们把圣物和圣所的所有器具都遮盖完毕，之后<char style="pn">哥辖</char>的子孙要进来抬；他们不可触碰圣物，免得死亡。这些就是会幕中<char style="pn">哥辖</char>子孙负责扛抬的。<verse eid="NUM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 4:16" />“祭司<char style="pn">亚伦</char>的儿子<char style="pn">以利亚撒</char>所负责的，是灯油、芬芳香、常献的素祭和膏油，并负责整个帐幕和帐幕里的一切，圣所和圣所内的器具。”<verse eid="NUM 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 4:17" />耶和华指示<char style="pn">摩西</char>和<char style="pn">亚伦</char>说： <verse eid="NUM 4:17" /><verse number="18" style="v" sid="NUM 4:18" />“不要让<char style="pn">哥辖</char>家族的支系从<char style="pn">利未</char>人中被除灭。 <verse eid="NUM 4:18" /><verse number="19" style="v" sid="NUM 4:19" />要为他们这样做：当他们接近至圣物的时候，<char style="pn">亚伦</char>和他的儿子们要进去，安排他们每个人的服事工作和各人要负责扛抬的；这样他们就可以存活，不致死亡。 <verse eid="NUM 4:19" /><verse number="20" style="v" sid="NUM 4:20" />他们片刻都不可进去看圣物，免得他们死亡。”<verse eid="NUM 4:20" /></para>
  <para style="s">革顺子孙的职责</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 4:21" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 4:21" /><verse number="22" style="v" sid="NUM 4:22" />“你也要按父家和家族，统计<char style="pn">革顺</char>子孙的人数， <verse eid="NUM 4:22" /><verse number="23" style="v" sid="NUM 4:23" />数点三十岁以上到五十岁，所有前来供职、在会幕中做服事的人。<verse eid="NUM 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 4:24" />“<char style="pn">革顺</char>家族的服事、扛抬工作如下： <verse eid="NUM 4:24" /><verse number="25" style="v" sid="NUM 4:25" />他们要抬帐幕的幔帐、会幕和它的顶罩以及覆盖其上的海狮皮顶罩，还有会幕入口的帘幕， <verse eid="NUM 4:25" /><verse number="26" style="v" sid="NUM 4:26" />院子的帷幔，在帐幕和祭坛四围的院子入口的帘幕，它们的绳子，以及服事用的一切器具；所有相关的工作，他们都要去做。<verse eid="NUM 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 4:27" />“<char style="pn">革顺</char>子孙所有的服事，所有的扛抬和服事工作，都要遵照<char style="pn">亚伦</char>和他儿子们的吩咐；他们所有的扛抬工作，你们都要为他们指派相关的职责。 <verse eid="NUM 4:27" /><verse number="28" style="v" sid="NUM 4:28" />这是<char style="pn">革顺</char>子孙各家族在会幕中的服事，是在祭司<char style="pn">亚伦</char>的儿子<char style="pn">以塔玛尔</char>手下履行的职责。<verse eid="NUM 4:28" /></para>
  <para style="s">米拉利子孙的职责</para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 4:29" />“<char style="pn">米拉利</char>的子孙，你也要按家族和父家数点他们， <verse eid="NUM 4:29" /><verse number="30" style="v" sid="NUM 4:30" />数点三十岁以上到五十岁，所有前来供职、做会幕服事工作的人。<verse eid="NUM 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 4:31" />“他们在会幕中的一切服事，要负责的扛抬工作如下：帐幕的木板，门闩，柱子和底座， <verse eid="NUM 4:31" /><verse number="32" style="v" sid="NUM 4:32" />院子四围的柱子和它们的底座、橛子、绳子，以及相关的一切器具，相关的一切工作。你们要按名字指派他们负责扛抬的器具。 <verse eid="NUM 4:32" /><verse number="33" style="v" sid="NUM 4:33" />这是<char style="pn">米拉利</char>子孙各家族的服事，是他们在会幕中的各样服事，在祭司<char style="pn">亚伦</char>的儿子<char style="pn">以塔玛尔</char>手下履行。”<verse eid="NUM 4:33" /></para>
  <para style="s">数点供职的利未人</para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 4:34" />于是，<char style="pn">摩西</char>和<char style="pn">亚伦</char>以及会众领袖们按家族和父家，数点<char style="pn">哥辖</char>的子孙。 <verse eid="NUM 4:34" /><verse number="35" style="v" sid="NUM 4:35" />三十岁以上到五十岁，所有前来供职、在会幕中服事的人， <verse eid="NUM 4:35" /><verse number="36" style="v" sid="NUM 4:36" />按着家族被数点，有两千七百五十人。 <verse eid="NUM 4:36" /><verse number="37" style="v" sid="NUM 4:37" />这些就是<char style="pn">哥辖</char>家族所有在会幕中服事、被数点的人，<char style="pn">摩西</char>和<char style="pn">亚伦</char>按照耶和华藉着<char style="pn">摩西</char>所指示的，数点了他们。<verse eid="NUM 4:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 4:38" />
    <char style="pn">革顺</char>子孙被数点的，是按家族和父家， <verse eid="NUM 4:38" /><verse number="39" style="v" sid="NUM 4:39" />三十岁以上到五十岁，所有前来供职、在会幕中服事的人； <verse eid="NUM 4:39" /><verse number="40" style="v" sid="NUM 4:40" />他们按家族和父家被数点的，有两千六百三十人。 <verse eid="NUM 4:40" /><verse number="41" style="v" sid="NUM 4:41" />这些就是<char style="pn">革顺</char>子孙各家族所有在会幕中服事、被数点的人，是<char style="pn">摩西</char>和<char style="pn">亚伦</char>按照耶和华的指示数点的。<verse eid="NUM 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 4:42" />
    <char style="pn">米拉利</char>子孙各家族被数点的，是按家族和父家， <verse eid="NUM 4:42" /><verse number="43" style="v" sid="NUM 4:43" />三十岁以上到五十岁，所有前来供职、在会幕中服事的人； <verse eid="NUM 4:43" /><verse number="44" style="v" sid="NUM 4:44" />他们按家族被数点的，有三千两百人。 <verse eid="NUM 4:44" /><verse number="45" style="v" sid="NUM 4:45" />这些就是<char style="pn">米拉利</char>子孙各家族被数点的人，<char style="pn">摩西</char>和<char style="pn">亚伦</char>按照耶和华藉着<char style="pn">摩西</char>所指示的，数点了他们。<verse eid="NUM 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 4:46" />
    <char style="pn">摩西</char>和<char style="pn">亚伦</char>以及<char style="pn">以色列</char>众领袖数点<char style="pn">利未</char>人，所有被数点的，是按家族和父家， <verse eid="NUM 4:46" /><verse number="47" style="v" sid="NUM 4:47" />三十岁以上到五十岁，所有前来在会幕中做服事工作和扛抬工作的人。 <verse eid="NUM 4:47" /><verse number="48" style="v" sid="NUM 4:48" />他们被数点的，总共是八千五百八十人， <verse eid="NUM 4:48" /><verse number="49" style="v" sid="NUM 4:49" />都是按照耶和华的吩咐，藉着<char style="pn">摩西</char>数点的，各人负责自己的服事工作和扛抬工作。<char style="pn">摩西</char>照着耶和华所指示他的，数点了他们。<verse eid="NUM 4:49" /></para>
  <chapter eid="NUM 4" />
  <chapter number="5" style="c" sid="NUM 5" />
  <para style="s">隔离不洁净的人</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 5:1" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 5:1" /><verse number="2" style="v" sid="NUM 5:2" />“你要吩咐<char style="pn">以色列</char>子民：把所有患麻风病的、所有患漏症的、所有因接触尸体而不洁净的，都从营里送出去。 <verse eid="NUM 5:2" /><verse number="3" style="v" sid="NUM 5:3" />无论男女，都要送出去。你们要把他们送到营地外面，以免玷污了他们的营地，因为我居住在他们中间。” <verse eid="NUM 5:3" /><verse number="4" style="v" sid="NUM 5:4" /><char style="pn">以色列</char>子民就这样做，把他们送到营地外面。耶和华所指示<char style="pn">摩西</char>的，<char style="pn">以色列</char>子民都照着做了。<verse eid="NUM 5:4" /></para>
  <para style="s">赎罪赔偿</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 5:5" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 5:5" /><verse number="6" style="v" sid="NUM 5:6" />“你要吩咐<char style="pn">以色列</char>子民：如果有男人或女人犯了人常犯的任何罪，以致不忠于耶和华，那人就要承担罪责。 <verse eid="NUM 5:6" /><verse number="7" style="v" sid="NUM 5:7" />他要承认自己所犯的罪，按全数对他的亏负作出赔偿，并且加上五分之一，交给他所亏负的人。 <verse eid="NUM 5:7" /><verse number="8" style="v" sid="NUM 5:8" />但如果被亏负的人没有近亲为他接受损害赔偿，那么，这损害赔偿以及犯罪之人的赎罪祭公绵羊，都归于耶和华，归给祭司。 <verse eid="NUM 5:8" /><verse number="9" style="v" sid="NUM 5:9" /><char style="pn">以色列</char>子民带到祭司那里的所有圣物中，凡是供物，都要归给祭司。 <verse eid="NUM 5:9" /><verse number="10" style="v" sid="NUM 5:10" />各人的圣物原属于自己，各人献到祭司那里的，要归给祭司。”<verse eid="NUM 5:10" /></para>
  <para style="s">关于丈夫猜忌的条例</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 5:11" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 5:11" /><verse number="12" style="v" sid="NUM 5:12" />“你要吩咐<char style="pn">以色列</char>子民，对他们说：如果一个人的妻子行为不轨，对丈夫不忠， <verse eid="NUM 5:12" /><verse number="13" style="v" sid="NUM 5:13" />有男人与她同寝交合，但她瞒过了丈夫，隐藏了这事，她使自己受玷污却没有见证人，也没有被捉住—— <verse eid="NUM 5:13" /><verse number="14" style="v" sid="NUM 5:14" />无论是丈夫起了猜忌的心，猜忌妻子，而她确实玷污了自己，或者是丈夫起了猜忌的心，猜忌妻子，而她并没有玷污自己—— <verse eid="NUM 5:14" /><verse number="15" style="v" sid="NUM 5:15" />这个人就要把自己的妻子带到祭司那里，并且为她带来祭物，就是十分之一伊法<note caller="+" style="f"><char style="fr" closed="false">5:15 </char><char style="ft" closed="false">十分之一伊法——相当于2.2公升。1伊法＝22公升。</char></note>大麦粉。不可浇上油，也不可加上乳香，因为这是猜忌的素祭，是想起罪孽的反思素祭。<verse eid="NUM 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 5:16" />“祭司要让她上前来，站在耶和华面前。 <verse eid="NUM 5:16" /><verse number="17" style="v" sid="NUM 5:17" />祭司要用瓦器取圣水，还要取一些在帐幕地面上的尘土，放在水中。 <verse eid="NUM 5:17" /><verse number="18" style="v" sid="NUM 5:18" />祭司要让那女人站在耶和华面前，散开那女人的头发，然后把反思素祭，就是猜忌的素祭，放在她手掌上。祭司要手里端着会带来诅咒的苦水， <verse eid="NUM 5:18" /><verse number="19" style="v" sid="NUM 5:19" />让那女人起誓，对她说：‘如果没有别的男人与你同寝，如果你在丈夫权下没有行为不轨受玷污，你就免于这诅咒苦水的罪罚。 <verse eid="NUM 5:19" /><verse number="20" style="v" sid="NUM 5:20" />但如果你在丈夫权下行为不轨，与丈夫以外的男人交合，玷污了自己——’ <verse eid="NUM 5:20" /><verse number="21" style="v" sid="NUM 5:21" />这时祭司要让那女人以诅咒的誓言起誓，然后对那女人说：‘当耶和华使你大腿萎缩、肚子肿胀的时候，愿耶和华使你在族人中间成为诅咒和誓语。 <verse eid="NUM 5:21" /><verse number="22" style="v" sid="NUM 5:22" />愿这带来诅咒的水进入你的肚腹，使肚子肿胀、大腿萎缩。’那女人就要说：‘阿们，阿们。’<verse eid="NUM 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 5:23" />“祭司要将这些诅咒写在书卷上，把这些字擦抹到苦水里。 <verse eid="NUM 5:23" /><verse number="24" style="v" sid="NUM 5:24" />之后要让那女人喝这带来诅咒的苦水，这诅咒的水就会进入她体内产生痛苦。 <verse eid="NUM 5:24" /><verse number="25" style="v" sid="NUM 5:25" />祭司要从那女人手中接过猜忌的素祭，在耶和华面前把这素祭摇一摇，然后带到祭坛那里。 <verse eid="NUM 5:25" /><verse number="26" style="v" sid="NUM 5:26" />祭司要从素祭中捧出一把，作为记念部分，在祭坛上烧献为烟，然后让女人喝那水。<verse eid="NUM 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 5:27" />“祭司让她喝那水以后：如果她玷污了自己，对她丈夫不忠，这带来诅咒的水就会进到她体内，产生痛苦。她的肚子会肿胀，她的大腿会萎缩，那女人就在族人中间成为诅咒。 <verse eid="NUM 5:27" /><verse number="28" style="v" sid="NUM 5:28" />但如果那女人没有使自己受玷污，她是清白的，她就免于罪罚，仍然能怀孕生子。<verse eid="NUM 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 5:29" />“这就是关于猜忌的条例：如果妻子在丈夫权下行为不轨，玷污了自己， <verse eid="NUM 5:29" /><verse number="30" style="v" sid="NUM 5:30" />或者丈夫起了猜忌的心，猜忌自己的妻子，就要让那女人站在耶和华面前，祭司要对她执行这一切条例。 <verse eid="NUM 5:30" /><verse number="31" style="v" sid="NUM 5:31" />这样丈夫就免于罪责，那女人却要承担自己的罪责。”<verse eid="NUM 5:31" /></para>
  <chapter eid="NUM 5" />
  <chapter number="6" style="c" sid="NUM 6" />
  <para style="s">拿细耳人的离俗条例</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 6:1" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 6:1" /><verse number="2" style="v" sid="NUM 6:2" />“你要吩咐<char style="pn">以色列</char>子民，对他们说：如果有男人或女人许了特殊的愿，就是<char style="pn">拿细耳</char>人<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="ft" closed="false">拿细耳人——意思是“分别出来的人”；本章下同。</char></note>的愿，为要离俗归于耶和华， <verse eid="NUM 6:2" /><verse number="3" style="v" sid="NUM 6:3" />他就要远离淡酒烈酒，也不可喝淡酒烈酒做的醋。任何葡萄汁，他都不可喝；鲜的或干的葡萄，他也不可吃。 <verse eid="NUM 6:3" /><verse number="4" style="v" sid="NUM 6:4" />在他离俗的所有日子，凡是葡萄树所出产的，甚至是葡萄籽或葡萄皮的产物，他都不可吃。<verse eid="NUM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 6:5" />“在他许愿离俗的所有日子，他都不可用剃刀剃他的头。他要分别为圣，任由头发变长，直到他离俗归于耶和华的日子满了。 <verse eid="NUM 6:5" /><verse number="6" style="v" sid="NUM 6:6" />他在离俗归于耶和华的所有日子，都不可接近死人的尸体。 <verse eid="NUM 6:6" /><verse number="7" style="v" sid="NUM 6:7" />即使那是他的父母、兄弟或姐妹，当他们死的时候，他也不可为他们玷污自己，因为离俗归神的标记在他头上。 <verse eid="NUM 6:7" /><verse number="8" style="v" sid="NUM 6:8" />在他离俗的所有日子，他都是归耶和华为圣的。<verse eid="NUM 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 6:9" />“如果有人突然死在他旁边，以致玷污了他离俗的头，他就要在第七天，在得洁净的日子剃头。 <verse eid="NUM 6:9" /><verse number="10" style="v" sid="NUM 6:10" />在第八天，他要把两只斑鸠或两只雏鸽带到会幕入口给祭司。 <verse eid="NUM 6:10" /><verse number="11" style="v" sid="NUM 6:11" />祭司要献一只作赎罪祭，一只作燔祭，为他赎那因尸体而带来的罪污。当天，他要使他的头重新分别为圣， <verse eid="NUM 6:11" /><verse number="12" style="v" sid="NUM 6:12" />重新把离俗的日子献给耶和华，并且带来一只一岁的公羊羔作赎愆祭；先前的那些日子失效了，因为他的离俗已经被玷污。<verse eid="NUM 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 6:13" />“拿细耳人有以下条例：在他离俗的日子满了那天，要让他来到会幕入口。 <verse eid="NUM 6:13" /><verse number="14" style="v" sid="NUM 6:14" />他要向耶和华献上他的祭物，一只无瑕疵的一岁公羊羔作燔祭，一只无瑕疵的一岁母羊羔作赎罪祭，一只无瑕疵的公绵羊作平安祭， <verse eid="NUM 6:14" /><verse number="15" style="v" sid="NUM 6:15" />还有一篮子调了油的无酵细面饼和抹了油的无酵薄饼，以及同献的素祭和酒祭。<verse eid="NUM 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 6:16" />“祭司要把这些祭物带到耶和华面前，献上那人的赎罪祭和燔祭， <verse eid="NUM 6:16" /><verse number="17" style="v" sid="NUM 6:17" />并将那只公绵羊连同那一篮子无酵饼献给耶和华作平安祭，还要献上同献的素祭和酒祭。<verse eid="NUM 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 6:18" />“拿细耳人要在会幕入口剃自己离俗的头，把他的离俗头发拿去，放在平安祭下的火中。 <verse eid="NUM 6:18" /><verse number="19" style="v" sid="NUM 6:19" />他剃了自己离俗的头之后，祭司要取出煮过的公绵羊前腿，并从篮子里取出一个无酵饼和一个无酵薄饼，放在这拿细耳人手掌上。 <verse eid="NUM 6:19" /><verse number="20" style="v" sid="NUM 6:20" />然后祭司要把它们作为摇献祭物，在耶和华面前摇一摇；这些连同摇献祭物的胸肉以及供物的大腿，都是归于祭司的圣物。之后拿细耳人就可以喝酒了。<verse eid="NUM 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 6:21" />“这是拿细耳人的条例。如果他在离俗许愿之外，还向耶和华许愿献上他所能负担的祭物，他就要在离俗条例之外，也按照所许的愿去做。”<verse eid="NUM 6:21" /></para>
  <para style="s">祭司祝福以色列子民</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 6:22" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 6:22" /><verse number="23" style="v" sid="NUM 6:23" />“你要吩咐<char style="pn">亚伦</char>和他的儿子们，要这样祝福<char style="pn">以色列</char>子民，对他们说：<verse eid="NUM 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 6:24" />愿耶和华祝福你，保守你；<verse eid="NUM 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="NUM 6:25" />愿耶和华使他的脸光照你，恩待你；<verse eid="NUM 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="NUM 6:26" />愿耶和华向你显出笑容，赐你平安。<verse eid="NUM 6:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="NUM 6:27" />他们要这样把我的名安置在<char style="pn">以色列</char>子民身上，我就祝福他们。”<verse eid="NUM 6:27" /></para>
  <chapter eid="NUM 6" />
  <chapter number="7" style="c" sid="NUM 7" />
  <para style="s">领袖们的祭物</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 7:1" />
    <char style="pn">摩西</char>立起了帐幕，就在当天膏抹帐幕，使帐幕和它的所有器具，祭坛和它的所有器具都分别为圣。他膏抹这些，使它们分别为圣之后， <verse eid="NUM 7:1" /><verse number="2" style="v" sid="NUM 7:2" /><char style="pn">以色列</char>的众领袖，他们各父家的首领就来奉献。他们是那些协助数点人口的各支派领袖。 <verse eid="NUM 7:2" /><verse number="3" style="v" sid="NUM 7:3" />他们把自己的礼物带到耶和华面前，就是六辆篷车和十二头公牛，每两个领袖一辆车，每一个首领一头牛。他们在帐幕面前献上这些， <verse eid="NUM 7:3" /><verse number="4" style="v" sid="NUM 7:4" />耶和华就指示<char style="pn">摩西</char>说： <verse eid="NUM 7:4" /><verse number="5" style="v" sid="NUM 7:5" />“你要收下他们的奉献，用来做会幕的服事，并按照各人的服事，把牛和车交给<char style="pn">利未</char>人。”<verse eid="NUM 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 7:6" />
    <char style="pn">摩西</char>就收下车和牛，交给了<char style="pn">利未</char>人。 <verse eid="NUM 7:6" /><verse number="7" style="v" sid="NUM 7:7" />他按照<char style="pn">革顺</char>子孙的服事，把两辆车和四头公牛交给他们。 <verse eid="NUM 7:7" /><verse number="8" style="v" sid="NUM 7:8" />又按照<char style="pn">米拉利</char>子孙在<char style="pn">亚伦</char>的儿子祭司<char style="pn">以塔玛尔</char>手下的服事，把四辆车和八头公牛交给他们。 <verse eid="NUM 7:8" /><verse number="9" style="v" sid="NUM 7:9" />但他没有把这些交给<char style="pn">哥辖</char>的子孙，因为他们的服事工作是用肩膀扛抬圣物。<verse eid="NUM 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 7:10" />在膏抹祭坛的那天，领袖们带来了祭坛奉献礼的礼物。这些领袖把礼物带到祭坛前， <verse eid="NUM 7:10" /><verse number="11" style="v" sid="NUM 7:11" />耶和华对<char style="pn">摩西</char>说：“他们要每天一个领袖，轮流<note caller="+" style="f"><char style="fr" closed="false">7:11 </char><char style="ft" closed="false">每天一个领袖，轮流——原文直译“一天一个领袖、一天一个领袖”。</char></note>为祭坛的奉献礼献上各自的礼物。”<verse eid="NUM 7:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="NUM 7:12" />第一天献上礼物的，是<char style="pn">犹大</char>支派<char style="pn">亚米拿达</char>的儿子<char style="pn">拿顺</char>。 <verse eid="NUM 7:12" /><verse number="13" style="v" sid="NUM 7:13" />他的礼物是：一个银盘，重一百三十谢克尔<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="ft" closed="false">一百三十谢克尔——相当于1,482公克；本章下同。1谢克尔=11.4公克。</char></note>，一个银碗，重七十谢克尔<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="ft" closed="false">七十谢克尔——相当于798公克；本章下同。</char></note>，都按圣所的谢克尔标准，两个器皿都盛满调了油的细面粉作素祭； <verse eid="NUM 7:13" /><verse number="14" style="v" sid="NUM 7:14" />一个金勺子，重十谢克尔<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="ft" closed="false">十谢克尔——相当于114公克；本章下同。</char></note>，盛满了香； <verse eid="NUM 7:14" /><verse number="15" style="v" sid="NUM 7:15" />一头公牛，一只公绵羊，一只一岁的公羊羔，作燔祭； <verse eid="NUM 7:15" /><verse number="16" style="v" sid="NUM 7:16" />一只公山羊，作赎罪祭； <verse eid="NUM 7:16" /><verse number="17" style="v" sid="NUM 7:17" />两头公牛，五只公绵羊，五只公山羊，五只一岁的公羊羔，作平安祭。这是<char style="pn">亚米拿达</char>的儿子<char style="pn">拿顺</char>的礼物。<verse eid="NUM 7:17" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="18" style="v" sid="NUM 7:18" />第二天献上的，是<char style="pn">以萨迦</char>的领袖，<char style="pn">苏押</char>的儿子<char style="pn">拿旦业</char>。 <verse eid="NUM 7:18" /><verse number="19" style="v" sid="NUM 7:19" />他献上的礼物是：一个银盘，重一百三十谢克尔，一个银碗，重七十谢克尔，都按圣所的谢克尔标准，两个器皿都盛满调了油的细面粉作素祭； <verse eid="NUM 7:19" /><verse number="20" style="v" sid="NUM 7:20" />一个金勺子，重十谢克尔，盛满了香； <verse eid="NUM 7:20" /><verse number="21" style="v" sid="NUM 7:21" />一头公牛，一只公绵羊，一只一岁的公羊羔，作燔祭； <verse eid="NUM 7:21" /><verse number="22" style="v" sid="NUM 7:22" />一只公山羊，作赎罪祭； <verse eid="NUM 7:22" /><verse number="23" style="v" sid="NUM 7:23" />两头公牛，五只公绵羊，五只公山羊，五只一岁的公羊羔，作平安祭。这是<char style="pn">苏押</char>的儿子<char style="pn">拿旦业</char>的礼物。<verse eid="NUM 7:23" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="24" style="v" sid="NUM 7:24" />第三天是<char style="pn">西布伦</char>子孙的领袖，<char style="pn">希伦</char>的儿子<char style="pn">以利押</char>。 <verse eid="NUM 7:24" /><verse number="25" style="v" sid="NUM 7:25" />他的礼物是：一个银盘，重一百三十谢克尔，一个银碗，重七十谢克尔，都按圣所的谢克尔标准，两个器皿都盛满调了油的细面粉作素祭； <verse eid="NUM 7:25" /><verse number="26" style="v" sid="NUM 7:26" />一个金勺子，重十谢克尔，盛满了香； <verse eid="NUM 7:26" /><verse number="27" style="v" sid="NUM 7:27" />一头公牛，一只公绵羊，一只一岁的公羊羔，作燔祭； <verse eid="NUM 7:27" /><verse number="28" style="v" sid="NUM 7:28" />一只公山羊，作赎罪祭； <verse eid="NUM 7:28" /><verse number="29" style="v" sid="NUM 7:29" />两头公牛，五只公绵羊，五只公山羊，五只一岁的公羊羔，作平安祭。这是<char style="pn">希伦</char>的儿子<char style="pn">以利押</char>的礼物。<verse eid="NUM 7:29" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="30" style="v" sid="NUM 7:30" />第四天是<char style="pn">鲁本</char>子孙的领袖，<char style="pn">谢德珥</char>的儿子<char style="pn">以利佐</char>。 <verse eid="NUM 7:30" /><verse number="31" style="v" sid="NUM 7:31" />他的礼物是：一个银盘，重一百三十谢克尔，一个银碗，重七十谢克尔，都按圣所的谢克尔标准，两个器皿都盛满调了油的细面粉作素祭； <verse eid="NUM 7:31" /><verse number="32" style="v" sid="NUM 7:32" />一个金勺子，重十谢克尔，盛满了香； <verse eid="NUM 7:32" /><verse number="33" style="v" sid="NUM 7:33" />一头公牛，一只公绵羊，一只一岁的公羊羔，作燔祭； <verse eid="NUM 7:33" /><verse number="34" style="v" sid="NUM 7:34" />一只公山羊，作赎罪祭； <verse eid="NUM 7:34" /><verse number="35" style="v" sid="NUM 7:35" />两头公牛，五只公绵羊，五只公山羊，五只一岁的公羊羔，作平安祭。这是<char style="pn">谢德珥</char>的儿子<char style="pn">以利佐</char>的礼物。<verse eid="NUM 7:35" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="36" style="v" sid="NUM 7:36" />第五天是<char style="pn">西缅</char>子孙的领袖，<char style="pn">苏利沙代</char>的儿子<char style="pn">谢路米业</char>。 <verse eid="NUM 7:36" /><verse number="37" style="v" sid="NUM 7:37" />他的礼物是：一个银盘，重一百三十谢克尔，一个银碗，重七十谢克尔，都按圣所的谢克尔标准，两个器皿都盛满调了油的细面粉作素祭； <verse eid="NUM 7:37" /><verse number="38" style="v" sid="NUM 7:38" />一个金勺子，重十谢克尔，盛满了香； <verse eid="NUM 7:38" /><verse number="39" style="v" sid="NUM 7:39" />一头公牛，一只公绵羊，一只一岁的公羊羔，作燔祭； <verse eid="NUM 7:39" /><verse number="40" style="v" sid="NUM 7:40" />一只公山羊，作赎罪祭； <verse eid="NUM 7:40" /><verse number="41" style="v" sid="NUM 7:41" />两头公牛，五只公绵羊，五只公山羊，五只一岁的公羊羔，作平安祭。这是<char style="pn">苏利沙代</char>的儿子<char style="pn">谢路米业</char>的礼物。<verse eid="NUM 7:41" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="42" style="v" sid="NUM 7:42" />第六天是<char style="pn">迦得</char>子孙的领袖，<char style="pn">德珥</char>的儿子<char style="pn">以利雅萨</char>。 <verse eid="NUM 7:42" /><verse number="43" style="v" sid="NUM 7:43" />他的礼物是：一个银盘，重一百三十谢克尔，一个银碗，重七十谢克尔，都按圣所的谢克尔标准，两个器皿都盛满调了油的细面粉作素祭； <verse eid="NUM 7:43" /><verse number="44" style="v" sid="NUM 7:44" />一个金勺子，重十谢克尔，盛满了香； <verse eid="NUM 7:44" /><verse number="45" style="v" sid="NUM 7:45" />一头公牛，一只公绵羊，一只一岁的公羊羔，作燔祭； <verse eid="NUM 7:45" /><verse number="46" style="v" sid="NUM 7:46" />一只公山羊，作赎罪祭； <verse eid="NUM 7:46" /><verse number="47" style="v" sid="NUM 7:47" />两头公牛，五只公绵羊，五只公山羊，五只一岁的公羊羔，作平安祭。这是<char style="pn">德珥</char>的儿子<char style="pn">以利雅萨</char>的礼物。<verse eid="NUM 7:47" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="48" style="v" sid="NUM 7:48" />第七天是<char style="pn">以法莲</char>子孙的领袖，<char style="pn">亚米忽</char>的儿子<char style="pn">以利沙玛</char>。 <verse eid="NUM 7:48" /><verse number="49" style="v" sid="NUM 7:49" />他的礼物是：一个银盘，重一百三十谢克尔，一个银碗，重七十谢克尔，都按圣所的谢克尔标准，两个器皿都盛满调了油的细面粉作素祭； <verse eid="NUM 7:49" /><verse number="50" style="v" sid="NUM 7:50" />一个金勺子，重十谢克尔，盛满了香； <verse eid="NUM 7:50" /><verse number="51" style="v" sid="NUM 7:51" />一头公牛，一只公绵羊，一只一岁的公羊羔，作燔祭； <verse eid="NUM 7:51" /><verse number="52" style="v" sid="NUM 7:52" />一只公山羊，作赎罪祭； <verse eid="NUM 7:52" /><verse number="53" style="v" sid="NUM 7:53" />两头公牛，五只公绵羊，五只公山羊，五只一岁的公羊羔，作平安祭。这是<char style="pn">亚米忽</char>的儿子<char style="pn">以利沙玛</char>的礼物。<verse eid="NUM 7:53" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="54" style="v" sid="NUM 7:54" />第八天是<char style="pn">玛拿西</char>子孙的领袖，<char style="pn">佩达佐</char>的儿子<char style="pn">迦玛列</char>。 <verse eid="NUM 7:54" /><verse number="55" style="v" sid="NUM 7:55" />他的礼物是：一个银盘，重一百三十谢克尔，一个银碗，重七十谢克尔，都按圣所的谢克尔标准，两个器皿都盛满调了油的细面粉作素祭； <verse eid="NUM 7:55" /><verse number="56" style="v" sid="NUM 7:56" />一个金勺子，重十谢克尔，盛满了香； <verse eid="NUM 7:56" /><verse number="57" style="v" sid="NUM 7:57" />一头公牛，一只公绵羊，一只一岁的公羊羔，作燔祭； <verse eid="NUM 7:57" /><verse number="58" style="v" sid="NUM 7:58" />一只公山羊，作赎罪祭； <verse eid="NUM 7:58" /><verse number="59" style="v" sid="NUM 7:59" />两头公牛，五只公绵羊，五只公山羊，五只一岁的公羊羔，作平安祭。这是<char style="pn">佩达佐</char>的儿子<char style="pn">迦玛列</char>的礼物。<verse eid="NUM 7:59" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="60" style="v" sid="NUM 7:60" />第九天是<char style="pn">便雅悯</char>子孙的领袖，<char style="pn">基多尼</char>的儿子<char style="pn">亚比但</char>。 <verse eid="NUM 7:60" /><verse number="61" style="v" sid="NUM 7:61" />他的礼物是：一个银盘，重一百三十谢克尔，一个银碗，重七十谢克尔，都按圣所的谢克尔标准，两个器皿都盛满调了油的细面粉作素祭； <verse eid="NUM 7:61" /><verse number="62" style="v" sid="NUM 7:62" />一个金勺子，重十谢克尔，盛满了香； <verse eid="NUM 7:62" /><verse number="63" style="v" sid="NUM 7:63" />一头公牛，一只公绵羊，一只一岁的公羊羔，作燔祭； <verse eid="NUM 7:63" /><verse number="64" style="v" sid="NUM 7:64" />一只公山羊，作赎罪祭； <verse eid="NUM 7:64" /><verse number="65" style="v" sid="NUM 7:65" />两头公牛，五只公绵羊，五只公山羊，五只一岁的公羊羔，作平安祭。这是<char style="pn">基多尼</char>的儿子<char style="pn">亚比但</char>的礼物。<verse eid="NUM 7:65" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="66" style="v" sid="NUM 7:66" />第十天是<char style="pn">但</char>子孙的领袖，<char style="pn">亚米沙代</char>的儿子<char style="pn">亚希以谢</char>。 <verse eid="NUM 7:66" /><verse number="67" style="v" sid="NUM 7:67" />他的礼物是：一个银盘，重一百三十谢克尔，一个银碗，重七十谢克尔，都按圣所的谢克尔标准，两个器皿都盛满调了油的细面粉作素祭； <verse eid="NUM 7:67" /><verse number="68" style="v" sid="NUM 7:68" />一个金勺子，重十谢克尔，盛满了香； <verse eid="NUM 7:68" /><verse number="69" style="v" sid="NUM 7:69" />一头公牛，一只公绵羊，一只一岁的公羊羔，作燔祭； <verse eid="NUM 7:69" /><verse number="70" style="v" sid="NUM 7:70" />一只公山羊，作赎罪祭； <verse eid="NUM 7:70" /><verse number="71" style="v" sid="NUM 7:71" />两头公牛，五只公绵羊，五只公山羊，五只一岁的公羊羔，作平安祭。这是<char style="pn">亚米沙代</char>的儿子<char style="pn">亚希以谢</char>的礼物。<verse eid="NUM 7:71" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="72" style="v" sid="NUM 7:72" />第十一天是<char style="pn">亚设</char>子孙的领袖，<char style="pn">俄兰</char>的儿子<char style="pn">帕结</char>。 <verse eid="NUM 7:72" /><verse number="73" style="v" sid="NUM 7:73" />他的礼物是：一个银盘，重一百三十谢克尔，一个银碗，重七十谢克尔，都按圣所的谢克尔标准，两个器皿都盛满调了油的细面粉作素祭； <verse eid="NUM 7:73" /><verse number="74" style="v" sid="NUM 7:74" />一个金勺子，重十谢克尔，盛满了香； <verse eid="NUM 7:74" /><verse number="75" style="v" sid="NUM 7:75" />一头公牛，一只公绵羊，一只一岁的公羊羔，作燔祭； <verse eid="NUM 7:75" /><verse number="76" style="v" sid="NUM 7:76" />一只公山羊，作赎罪祭； <verse eid="NUM 7:76" /><verse number="77" style="v" sid="NUM 7:77" />两头公牛，五只公绵羊，五只公山羊，五只一岁的公羊羔，作平安祭。这是<char style="pn">俄兰</char>的儿子<char style="pn">帕结</char>的礼物。<verse eid="NUM 7:77" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="78" style="v" sid="NUM 7:78" />第十二天是<char style="pn">拿弗他利</char>子孙的领袖，<char style="pn">恩南</char>的儿子<char style="pn">亚希拉</char>。 <verse eid="NUM 7:78" /><verse number="79" style="v" sid="NUM 7:79" />他的礼物是：一个银盘，重一百三十谢克尔，一个银碗，重七十谢克尔，都按圣所的谢克尔标准，两个器皿都盛满调了油的细面粉作素祭； <verse eid="NUM 7:79" /><verse number="80" style="v" sid="NUM 7:80" />一个金勺子，重十谢克尔，盛满了香； <verse eid="NUM 7:80" /><verse number="81" style="v" sid="NUM 7:81" />一头公牛，一只公绵羊，一只一岁的公羊羔，作燔祭； <verse eid="NUM 7:81" /><verse number="82" style="v" sid="NUM 7:82" />一只公山羊，作赎罪祭； <verse eid="NUM 7:82" /><verse number="83" style="v" sid="NUM 7:83" />两头公牛，五只公绵羊，五只公山羊，五只一岁的公羊羔，作平安祭。这是<char style="pn">恩南</char>的儿子<char style="pn">亚希拉</char>的礼物。<verse eid="NUM 7:83" /></para>
  <para style="b" />
  <para style="p">
    <verse number="84" style="v" sid="NUM 7:84" />以上是膏抹祭坛那天，<char style="pn">以色列</char>众领袖为祭坛奉献礼所带来的礼物，总共有：十二个银盘，十二个银碗，十二个金勺子。 <verse eid="NUM 7:84" /><verse number="85" style="v" sid="NUM 7:85" />每个银盘重一百三十谢克尔，每个碗七十谢克尔，所有器皿的银子，都按圣所的谢克尔标准，共两千四百谢克尔<note caller="+" style="f"><char style="fr" closed="false">7:85 </char><char style="ft" closed="false">两千四百谢克尔——相当于27.4公斤。1谢克尔=11.4公克。</char></note>。 <verse eid="NUM 7:85" /><verse number="86" style="v" sid="NUM 7:86" />十二个盛满了香的金勺子，都按圣所的谢克尔标准，每个勺子是十谢克尔，所有勺子的金子共一百二十谢克尔<note caller="+" style="f"><char style="fr" closed="false">7:86 </char><char style="ft" closed="false">一百二十谢克尔——相当于1,368公克。</char></note>。 <verse eid="NUM 7:86" /><verse number="87" style="v" sid="NUM 7:87" />作燔祭的牲畜，共有十二头公牛，十二只公绵羊，十二只一岁的公羊羔；还有同献的素祭；作赎罪祭的有十二只公山羊； <verse eid="NUM 7:87" /><verse number="88" style="v" sid="NUM 7:88" />作平安祭的牲畜，共有二十四头公牛，六十只公绵羊，六十只公山羊，六十只一岁的公羊羔。这就是膏抹祭坛之后，祭坛奉献礼的礼物。<verse eid="NUM 7:88" /></para>
  <para style="p">
    <verse number="89" style="v" sid="NUM 7:89" />
    <char style="pn">摩西</char>进入会幕要与耶和华说话的时候，会听见有声音从见证柜上面的施恩座上方、从两个基路伯之间对他说话，耶和华就这样对他说话。<verse eid="NUM 7:89" /></para>
  <chapter eid="NUM 7" />
  <chapter number="8" style="c" sid="NUM 8" />
  <para style="s">会幕的灯台</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 8:1" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 8:1" /><verse number="2" style="v" sid="NUM 8:2" />“你要吩咐<char style="pn">亚伦</char>，对他说：点灯的时候，要让七盏灯照亮灯台的前面。” <verse eid="NUM 8:2" /><verse number="3" style="v" sid="NUM 8:3" /><char style="pn">亚伦</char>就这样做了。他照着耶和华所指示<char style="pn">摩西</char>的，点燃了灯照亮灯台的前面。 <verse eid="NUM 8:3" /><verse number="4" style="v" sid="NUM 8:4" />灯台的工艺是用金子锤擛，从底座到花朵都锤擛成形；<char style="pn">摩西</char>照着耶和华所显示给他的样式，做了灯台。<verse eid="NUM 8:4" /></para>
  <para style="s">利未人承接圣职</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 8:5" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 8:5" /><verse number="6" style="v" sid="NUM 8:6" />“你要从<char style="pn">以色列</char>子孙中拣选<char style="pn">利未</char>人，为他们举行洁净礼。 <verse eid="NUM 8:6" /><verse number="7" style="v" sid="NUM 8:7" />你要对他们这样做，使他们得洁净：要把赎罪的水弹洒在他们身上，又让他们用剃刀剃全身，并且洗自己的衣服，这样他们就得洁净了。<verse eid="NUM 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 8:8" />“然后他们要取来一头公牛，还有同献的素祭，就是调了油的细面粉；你也要另外取来一头公牛，作赎罪祭。 <verse eid="NUM 8:8" /><verse number="9" style="v" sid="NUM 8:9" />你要把<char style="pn">利未</char>人带到会幕前面，并且招聚全体<char style="pn">以色列</char>会众。 <verse eid="NUM 8:9" /><verse number="10" style="v" sid="NUM 8:10" />当你把<char style="pn">利未</char>人带到了耶和华面前，<char style="pn">以色列</char>子孙就要按手在<char style="pn">利未</char>人身上。 <verse eid="NUM 8:10" /><verse number="11" style="v" sid="NUM 8:11" /><char style="pn">亚伦</char>要从<char style="pn">以色列</char>子孙中把<char style="pn">利未</char>人作为摇献祭，奉献在耶和华面前，使他们可以做服事耶和华的工作。 <verse eid="NUM 8:11" /><verse number="12" style="v" sid="NUM 8:12" /><char style="pn">利未</char>人要按手在两头公牛的头上，一头作赎罪祭，另一头作燔祭，献给耶和华，为<char style="pn">利未</char>人赎罪。<verse eid="NUM 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 8:13" />“你要让<char style="pn">利未</char>人站在<char style="pn">亚伦</char>和他的儿子们面前，把他们作为摇献祭，奉献给耶和华。 <verse eid="NUM 8:13" /><verse number="14" style="v" sid="NUM 8:14" />这样，你把<char style="pn">利未</char>人从<char style="pn">以色列</char>子孙中分别出来，<char style="pn">利未</char>人就归属我了。 <verse eid="NUM 8:14" /><verse number="15" style="v" sid="NUM 8:15" />此后，<char style="pn">利未</char>人要进入会幕服事。你要洁净他们，把他们作为摇献祭献上。 <verse eid="NUM 8:15" /><verse number="16" style="v" sid="NUM 8:16" />因为他们是从<char style="pn">以色列</char>子孙中特定献给我的，我已经拣选了他们，代替<char style="pn">以色列</char>子孙中所有的头胎、所有的长子归属我。 <verse eid="NUM 8:16" /><verse number="17" style="v" sid="NUM 8:17" /><char style="pn">以色列</char>子孙中所有头生的，无论是人还是牲畜，都属于我；我在击杀<char style="pn">埃及</char>地所有头生的那一天，已经把他们分别为圣归于我。 <verse eid="NUM 8:17" /><verse number="18" style="v" sid="NUM 8:18" />但我拣选<char style="pn">利未</char>人代替<char style="pn">以色列</char>子孙中所有头生的； <verse eid="NUM 8:18" /><verse number="19" style="v" sid="NUM 8:19" />我从<char style="pn">以色列</char>子孙中把<char style="pn">利未</char>人作为奉献，赐给<char style="pn">亚伦</char>和他的儿子们，在会幕中为<char style="pn">以色列</char>子民做服事，并为<char style="pn">以色列</char>子民赎罪，免得<char style="pn">以色列</char>子民接近圣所时，灾殃临到<char style="pn">以色列</char>子民。”<verse eid="NUM 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 8:20" />
    <char style="pn">摩西</char>和<char style="pn">亚伦</char>以及全体<char style="pn">以色列</char>会众就对<char style="pn">利未</char>人这样做了；耶和华所指示<char style="pn">摩西</char>有关<char style="pn">利未</char>人的一切，<char style="pn">以色列</char>子民都照样对他们做了。 <verse eid="NUM 8:20" /><verse number="21" style="v" sid="NUM 8:21" /><char style="pn">利未</char>人洁净了自己，洗了自己的衣服，<char style="pn">亚伦</char>就把他们作为摇献祭，奉献在耶和华面前；<char style="pn">亚伦</char>又为他们赎罪，使他们得洁净。 <verse eid="NUM 8:21" /><verse number="22" style="v" sid="NUM 8:22" />之后，<char style="pn">利未</char>人进去，在<char style="pn">亚伦</char>和他的儿子们面前，在会幕中做服事。耶和华所指示<char style="pn">摩西</char>有关<char style="pn">利未</char>人的一切，他们都照样对<char style="pn">利未</char>人做了。<verse eid="NUM 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 8:23" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 8:23" /><verse number="24" style="v" sid="NUM 8:24" />“以下是关于<char style="pn">利未</char>人的安排：二十五岁以上的要前来，在会幕的服事上供职。 <verse eid="NUM 8:24" /><verse number="25" style="v" sid="NUM 8:25" />到了五十岁，他要退出服事工作，不再服事。 <verse eid="NUM 8:25" /><verse number="26" style="v" sid="NUM 8:26" />他可以在会幕中值守，辅助他的弟兄们，但不能做自己的服事。你要这样安排<char style="pn">利未</char>人的职责。”<verse eid="NUM 8:26" /></para>
  <chapter eid="NUM 8" />
  <chapter number="9" style="c" sid="NUM 9" />
  <para style="s">出埃及后第一次守逾越节</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 9:1" />他们出<char style="pn">埃及</char>地之后，第二年一月，耶和华在<char style="pn">西奈</char>旷野指示<char style="pn">摩西</char>说： <verse eid="NUM 9:1" /><verse number="2" style="v" sid="NUM 9:2" />“<char style="pn">以色列</char>子民要在所定的日期守逾越节。 <verse eid="NUM 9:2" /><verse number="3" style="v" sid="NUM 9:3" />你们要在这个月的十四日，黄昏的时候，按所定的日期守这节。你们要照着所有的律例和法规来守逾越节。”<verse eid="NUM 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 9:4" />于是<char style="pn">摩西</char>吩咐<char style="pn">以色列</char>子民要守逾越节。 <verse eid="NUM 9:4" /><verse number="5" style="v" sid="NUM 9:5" />他们就在一月十四日，黄昏的时候，在<char style="pn">西奈</char>旷野守逾越节。耶和华所指示<char style="pn">摩西</char>的一切，<char style="pn">以色列</char>子民都照着做了。<verse eid="NUM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 9:6" />但有一些人因接触人的尸体而不洁净了，不能在那一天守逾越节，所以当天来到<char style="pn">摩西</char>和<char style="pn">亚伦</char>面前。 <verse eid="NUM 9:6" /><verse number="7" style="v" sid="NUM 9:7" />那些人对<char style="pn">摩西</char>说：“我们确实因接触人的尸体而不洁净，但为什么被限制，不能在这节期与<char style="pn">以色列</char>子民一起献上耶和华的祭物呢？”<verse eid="NUM 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 9:8" />
    <char style="pn">摩西</char>回答他们：“你们在这里等候，我要聆听耶和华对你们有什么指示。”<verse eid="NUM 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 9:9" />随后耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 9:9" /><verse number="10" style="v" sid="NUM 9:10" />“你要吩咐<char style="pn">以色列</char>子民：无论是你们还是你们的后代，如果有人因接触尸体而不洁净了，或者在远方旅行，他还是可以向耶和华守逾越节。 <verse eid="NUM 9:10" /><verse number="11" style="v" sid="NUM 9:11" />他们要在下一个月的十四日，黄昏的时候守这节。羔羊的肉要与无酵饼和苦菜一起吃， <verse eid="NUM 9:11" /><verse number="12" style="v" sid="NUM 9:12" />一点也不可留到早晨，羔羊的骨头一根也不可折断；他们要照着逾越节的所有律例守这节。<verse eid="NUM 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 9:13" />“但那洁净的、当时也不在旅行的人，如果没有守逾越节，那人就要从民中被剪除。那人没有在这节期献上耶和华的祭物，所以要承担自己的罪过。<verse eid="NUM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 9:14" />“如果寄居在你们中间的外人，也想守耶和华的逾越节，他就要照着逾越节的律例和法规去做。无论是对外人还是对本族人<note caller="+" style="f"><char style="fr" closed="false">9:14 </char><char style="ft" closed="false">本族人——原文直译“本地人”。</char></note>，你们要有同一个律例。”<verse eid="NUM 9:14" /></para>
  <para style="s">云柱引领</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 9:15" />在立起帐幕那一天，有云彩遮盖帐幕，就是见证会幕；到了晚上，云彩停留在帐幕上方，像火的形状，直到清晨。 <verse eid="NUM 9:15" /><verse number="16" style="v" sid="NUM 9:16" />此后一直如此，白天有云彩遮盖帐幕，夜间有火的形状。 <verse eid="NUM 9:16" /><verse number="17" style="v" sid="NUM 9:17" />每当云彩从会幕上方收上去，随后<char style="pn">以色列</char>子民就起行；云彩在哪个地方停留，<char style="pn">以色列</char>子民就在哪里扎营。 <verse eid="NUM 9:17" /><verse number="18" style="v" sid="NUM 9:18" /><char style="pn">以色列</char>子民照着耶和华的指示起行，也照着耶和华的指示扎营；云彩在帐幕上方停留多久，他们就扎营多久。 <verse eid="NUM 9:18" /><verse number="19" style="v" sid="NUM 9:19" />即使云彩停留在帐幕上方许多天，<char style="pn">以色列</char>子民也谨守耶和华的吩咐不起行。 <verse eid="NUM 9:19" /><verse number="20" style="v" sid="NUM 9:20" />有时云彩只停留在帐幕上方几天，他们就照着耶和华的指示扎营，然后照着耶和华的指示起行。 <verse eid="NUM 9:20" /><verse number="21" style="v" sid="NUM 9:21" />有时云彩从晚上停留到早晨，当云彩在早晨收上去的时候，他们就起行。无论是白天还是夜间，只要云彩收上去，他们就起行。 <verse eid="NUM 9:21" /><verse number="22" style="v" sid="NUM 9:22" />无论是两天，还是一个月，或是一年<note caller="+" style="f"><char style="fr" closed="false">9:22 </char><char style="ft" closed="false">一年——或译作“许多日子”。</char></note>，只要云彩停留在帐幕上方，在那里停住，<char style="pn">以色列</char>子民就扎营不起行；当云彩收上去的时候，他们才起行。<verse eid="NUM 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 9:23" />他们按照耶和华的指示扎营，也按照耶和华的指示起行。他们遵照耶和华藉着<char style="pn">摩西</char>所指示的，谨守耶和华的吩咐。<verse eid="NUM 9:23" /></para>
  <chapter eid="NUM 9" />
  <chapter number="10" style="c" sid="NUM 10" />
  <para style="s">两支银号筒</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 10:1" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 10:1" /><verse number="2" style="v" sid="NUM 10:2" />“你要制作两支银号筒，用锤擛工艺制作，用来聚集会众，也用来拔营起行。 <verse eid="NUM 10:2" /><verse number="3" style="v" sid="NUM 10:3" />当两支号筒吹响时，全体会众要到你那里，在会幕入口集合； <verse eid="NUM 10:3" /><verse number="4" style="v" sid="NUM 10:4" />如果只吹响一支，领袖们，就是<char style="pn">以色列</char>千军的首领，要到你那里集合。<verse eid="NUM 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 10:5" />“当你们吹响警号时，扎营在东面的营队要起行。 <verse eid="NUM 10:5" /><verse number="6" style="v" sid="NUM 10:6" />当你们第二次吹响警号时，扎营在南面的营队要起行。让会众起程时，要吹响警号， <verse eid="NUM 10:6" /><verse number="7" style="v" sid="NUM 10:7" />招聚会众时也要吹号，但不要吹警号。 <verse eid="NUM 10:7" /><verse number="8" style="v" sid="NUM 10:8" />那些作祭司的<char style="pn">亚伦</char>子孙要吹响号筒。这要作为你们世世代代永远的律例。<verse eid="NUM 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 10:9" />“当你们在自己的土地上，与扰害你们的敌人作战时，你们要用号筒吹警号。这样，你们就能在你们的神耶和华面前蒙记念，得拯救，脱离你们的仇敌。 <verse eid="NUM 10:9" /><verse number="10" style="v" sid="NUM 10:10" />在你们喜乐的日子和所定的节期，以及月初，你们要为你们的燔祭和平安祭吹响号筒。这样，它们就使你们在你们的神面前蒙记念。我是耶和华你们的神。”<verse eid="NUM 10:10" /></para>
  <para style="s">从西奈旷野到帕兰旷野</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 10:11" />到了第二年的二月二十日，云彩从见证帐幕上方收上去了； <verse eid="NUM 10:11" /><verse number="12" style="v" sid="NUM 10:12" /><char style="pn">以色列</char>子民从<char style="pn">西奈</char>旷野起行，一程一程地前行，云彩到<char style="pn">帕兰</char>旷野就停住了。 <verse eid="NUM 10:12" /><verse number="13" style="v" sid="NUM 10:13" />这是他们第一次按照耶和华藉着<char style="pn">摩西</char>所指示的起行。<verse eid="NUM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 10:14" />首先按队伍起行的，是<char style="pn">犹大</char>子孙营队的旗帜。统领<char style="pn">犹大</char>队伍的，是<char style="pn">亚米拿达</char>的儿子<char style="pn">拿顺</char>； <verse eid="NUM 10:14" /><verse number="15" style="v" sid="NUM 10:15" />统领<char style="pn">以萨迦</char>支派队伍的，是<char style="pn">苏押</char>的儿子<char style="pn">拿旦业</char>。 <verse eid="NUM 10:15" /><verse number="16" style="v" sid="NUM 10:16" />统领<char style="pn">西布伦</char>支派队伍的，是<char style="pn">希伦</char>的儿子<char style="pn">以利押</char>。 <verse eid="NUM 10:16" /><verse number="17" style="v" sid="NUM 10:17" />然后，帐幕被拆下来，<char style="pn">革顺</char>的子孙和<char style="pn">米拉利</char>的子孙抬着帐幕起行。<verse eid="NUM 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 10:18" />接着按队伍起行的，是<char style="pn">鲁本</char>营队的旗帜。统领<char style="pn">鲁本</char>队伍的，是<char style="pn">谢德珥</char>的儿子<char style="pn">以利佐</char>； <verse eid="NUM 10:18" /><verse number="19" style="v" sid="NUM 10:19" />统领<char style="pn">西缅</char>支派队伍的，是<char style="pn">苏利沙代</char>的儿子<char style="pn">谢路米业</char>； <verse eid="NUM 10:19" /><verse number="20" style="v" sid="NUM 10:20" />统领<char style="pn">迦得</char>支派队伍的，是<char style="pn">德珥</char>的儿子<char style="pn">以利雅萨</char>。 <verse eid="NUM 10:20" /><verse number="21" style="v" sid="NUM 10:21" />然后，<char style="pn">哥辖</char>人抬着圣物起行，帐幕要在他们到达之前立起来。<verse eid="NUM 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 10:22" />接着按队伍起行的，是<char style="pn">以法莲</char>子孙营队的旗帜。统领<char style="pn">以法莲</char>队伍的，是<char style="pn">亚米忽</char>的儿子<char style="pn">以利沙玛</char>； <verse eid="NUM 10:22" /><verse number="23" style="v" sid="NUM 10:23" />统领<char style="pn">玛拿西</char>支派队伍的，是<char style="pn">佩达佐</char>的儿子<char style="pn">迦玛列</char>； <verse eid="NUM 10:23" /><verse number="24" style="v" sid="NUM 10:24" />统领<char style="pn">便雅悯</char>支派队伍的，是<char style="pn">基多尼</char>的儿子<char style="pn">亚比但</char>。<verse eid="NUM 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 10:25" />最后按队伍起行的，是<char style="pn">但</char>子孙营队的旗帜，他们作全营的后卫队。统领他们队伍的，是<char style="pn">亚米沙代</char>的儿子<char style="pn">亚希以谢</char>； <verse eid="NUM 10:25" /><verse number="26" style="v" sid="NUM 10:26" />统领<char style="pn">亚设</char>支派队伍的，是<char style="pn">俄兰</char>的儿子<char style="pn">帕结</char>； <verse eid="NUM 10:26" /><verse number="27" style="v" sid="NUM 10:27" />统领<char style="pn">拿弗他利</char>支派队伍的，是<char style="pn">恩南</char>的儿子<char style="pn">亚希拉</char>。 <verse eid="NUM 10:27" /><verse number="28" style="v" sid="NUM 10:28" />以上是<char style="pn">以色列</char>子孙按着队伍的起程次序，他们就这样起行。<verse eid="NUM 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 10:29" />那时，<char style="pn">摩西</char>对他岳父<char style="pn">米甸</char>人<char style="pn">流珥</char>的儿子<char style="pn">何巴</char>说：“我们要起行，去耶和华所说‘我要将它赐给你们’的那个地方，请你与我们一起去，我们会厚待你，耶和华已经向<char style="pn">以色列</char>应许了福份。”<verse eid="NUM 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 10:30" />
    <char style="pn">何巴</char>回答说：“我不去，我宁愿回我本地本族去。”<verse eid="NUM 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 10:31" />
    <char style="pn">摩西</char>说：“请不要离开我们，因为你了解旷野扎营的地方，可以作我们的向导<note caller="+" style="f"><char style="fr" closed="false">10:31 </char><char style="ft" closed="false">向导——原文直译“眼睛”。</char></note>； <verse eid="NUM 10:31" /><verse number="32" style="v" sid="NUM 10:32" />而且如果你与我们一起去，将来耶和华赐下福份，使我们蒙福，我们也必使你一同蒙福。”<verse eid="NUM 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 10:33" />于是，他们离开耶和华的山，前行了三天的路程。这三天的路程中，耶和华的约柜一直在他们前头前行，为他们寻找安歇的地方。 <verse eid="NUM 10:33" /><verse number="34" style="v" sid="NUM 10:34" />他们从营地起行，白天总有耶和华的云彩在他们上方。<verse eid="NUM 10:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 10:35" />每当约柜起行时，<char style="pn">摩西</char>就说：</para>
  <para style="q1" vid="NUM 10:35">“耶和华啊，求你起来！</para>
  <para style="q1" vid="NUM 10:35">愿你的仇敌四散，</para>
  <para style="q1" vid="NUM 10:35">愿那些恨你的人从你面前奔逃！”<verse eid="NUM 10:35" /></para>
  <para style="b" />
  <para style="p">
    <verse number="36" style="v" sid="NUM 10:36" />每当约柜停下来，他就说：</para>
  <para style="q1" vid="NUM 10:36">“耶和华啊，</para>
  <para style="q1" vid="NUM 10:36">求你回到千千万万<char style="pn">以色列</char>人当中<note caller="+" style="f"><char style="fr" closed="false">10:36 </char><char style="ft" closed="false">耶和华啊，求你回到千千万万以色列人当中——或译作“耶和华，以色列的万军啊，求你回来”。</char></note>！”<verse eid="NUM 10:36" /></para>
  <chapter eid="NUM 10" />
  <chapter number="11" style="c" sid="NUM 11" />
  <para style="s">民众发怨言</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 11:1" />当时，民众发怨言，恶言上达耶和华耳中。耶和华听见了就怒气发作，耶和华的火在他们中间焚烧，吞噬了营地的边缘。 <verse eid="NUM 11:1" /><verse number="2" style="v" sid="NUM 11:2" />民众向<char style="pn">摩西</char>哀求，<char style="pn">摩西</char>向耶和华祷告，火就熄灭了。 <verse eid="NUM 11:2" /><verse number="3" style="v" sid="NUM 11:3" />于是那地方被起名为“<char style="pn">塔备拉</char>”，因为耶和华的火曾在他们中间焚烧。<verse eid="NUM 11:3" /></para>
  <para style="s">抱怨饮食</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 11:4" />他们当中一些闲杂人贪图口腹之欲，以致<char style="pn">以色列</char>子民也再次哭泣，说：“谁给我们肉吃呢？ <verse eid="NUM 11:4" /><verse number="5" style="v" sid="NUM 11:5" />真想念在<char style="pn">埃及</char>能随意吃的鱼、黄瓜、西瓜、韭菜、葱和蒜。 <verse eid="NUM 11:5" /><verse number="6" style="v" sid="NUM 11:6" />现在我们什么胃口都没有了！我们眼前除了吗哪以外，什么都没有。”<verse eid="NUM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 11:7" />吗哪仿佛芫荽的种子，外观如同珍珠<note caller="+" style="f"><char style="fr" closed="false">11:7 </char><char style="ft" closed="false">珍珠——或译作“红玉”或“稀罕的香料”。</char></note>。 <verse eid="NUM 11:7" /><verse number="8" style="v" sid="NUM 11:8" />民众四处走动，捡拾吗哪，用磨碾碎或用臼捣碎，然后用锅煮了，做成饼，味道就像是纯橄榄油的味道。 <verse eid="NUM 11:8" /><verse number="9" style="v" sid="NUM 11:9" />夜间露水降在营地上的时候，吗哪也与它一起降下。<verse eid="NUM 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 11:10" />
    <char style="pn">摩西</char>听见了百姓家家户户在帐篷门口哭，那时耶和华的怒气大大发作，<char style="pn">摩西</char>也感到悲苦。 <verse eid="NUM 11:10" /><verse number="11" style="v" sid="NUM 11:11" /><char style="pn">摩西</char>对耶和华说：“你为什么恶待你的仆人呢？为什么我不在你眼前蒙恩，以致你把这全体民众的重担放在我身上呢？ <verse eid="NUM 11:11" /><verse number="12" style="v" sid="NUM 11:12" />是我怀上了这全体民众吗？是我生下了他们吗？你竟然吩咐我把他们抱在怀中，像保姆抱吃奶的婴儿那样，带到你起誓要赐给他们先祖的地方。 <verse eid="NUM 11:12" /><verse number="13" style="v" sid="NUM 11:13" />我从哪里得肉给这全体民众呢？他们竟然对我哭着说：‘给我们肉吃！’ <verse eid="NUM 11:13" /><verse number="14" style="v" sid="NUM 11:14" />我不能够独自背负这全体民众，这对我实在太沉重了。 <verse eid="NUM 11:14" /><verse number="15" style="v" sid="NUM 11:15" />如果你要这样对待我，求你现在就杀了我；如果我在你眼前蒙恩，请不要让我看到自己的悲苦。”<verse eid="NUM 11:15" /></para>
  <para style="s">拣选七十位长老</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 11:16" />耶和华就对<char style="pn">摩西</char>说：“你要从<char style="pn">以色列</char>的长老中为我招聚七十个人，就是你所知道的那些民间长老和官长；要把他们带到会幕，与你一同站在那里。 <verse eid="NUM 11:16" /><verse number="17" style="v" sid="NUM 11:17" />我要降临，在那里与你说话，并且把你身上的灵分出一些，赐给他们。这样，他们就与你一同背负这民众的重担，免得你独自背负。<verse eid="NUM 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 11:18" />“你要对民众说：你们要为明天把自己分别为圣，你们将会有肉吃。因为你们在耶和华耳中哭着说：‘谁给我们肉吃呢？我们在<char style="pn">埃及</char>多好！’所以，耶和华就要给你们肉吃了。 <verse eid="NUM 11:18" /><verse number="19" style="v" sid="NUM 11:19" />你们不是吃一天两天，也不是五天十天，也不是二十天， <verse eid="NUM 11:19" /><verse number="20" style="v" sid="NUM 11:20" />而是整整一个月，直到肉从你们鼻孔里出来，让你们恶心<note caller="+" style="f"><char style="fr" closed="false">11:20 </char><char style="ft" closed="false">让你们恶心——或译作“使你们厌恶它”。</char></note>。因为你们厌弃在你们中间的耶和华，在他面前哭着说：‘我们为什么从<char style="pn">埃及</char>出来呢？’”<verse eid="NUM 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 11:21" />
    <char style="pn">摩西</char>说：“与我一起的民众，步行的男人<note caller="+" style="f"><char style="fr" closed="false">11:21 </char><char style="ft" closed="false">男人——辅助词语；参《出埃及记》12:37。</char></note>有六十万，你竟然说要给他们肉吃，吃一整个月？ <verse eid="NUM 11:21" /><verse number="22" style="v" sid="NUM 11:22" />难道把羊群和牛群都给他们宰杀了，就够他们吃吗？或者把海里所有的鱼都给他们聚拢起来，就够他们吃吗？”<verse eid="NUM 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 11:23" />耶和华对<char style="pn">摩西</char>说：“难道耶和华的手臂缩短了吗？现在你就要看到我的话是否向你应验。”<verse eid="NUM 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 11:24" />于是<char style="pn">摩西</char>出去，将耶和华的话告诉民众，并从民间的长老中招聚了七十个人，让他们站在会幕周围。 <verse eid="NUM 11:24" /><verse number="25" style="v" sid="NUM 11:25" />耶和华在云彩中降临，对<char style="pn">摩西</char>说话，并把他身上的灵分出一些，赐给七十个长老。当那灵停留在他们身上时，他们就说神言；他们以后再没有说过。 <verse eid="NUM 11:25" /><verse number="26" style="v" sid="NUM 11:26" />但有两个人留在营中，一个名叫<char style="pn">伊利达</char>，另一个名叫<char style="pn">米达</char>，那灵也停留在他们身上，他们就在营中说神言；他们也在入选名单中，却没有出去到会幕那里。 <verse eid="NUM 11:26" /><verse number="27" style="v" sid="NUM 11:27" />有个年轻人跑来报告<char style="pn">摩西</char>说：“<char style="pn">伊利达</char>和<char style="pn">米达</char>正在营中说神言。”<verse eid="NUM 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 11:28" />
    <char style="pn">嫩</char>的儿子<char style="pn">约书亚</char>——他从年轻时就作<char style="pn">摩西</char>的助手<note caller="+" style="f"><char style="fr" closed="false">11:28 </char><char style="ft" closed="false">助手——或译作“侍从”。</char></note>，他回应说：“我主<char style="pn">摩西</char>啊，请阻止他们。”<verse eid="NUM 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 11:29" />
    <char style="pn">摩西</char>对他说：“你为我的缘故起了嫉妒吗？但愿耶和华所有的子民都是先知，愿耶和华把他的灵赐给他们！” <verse eid="NUM 11:29" /><verse number="30" style="v" sid="NUM 11:30" />之后，<char style="pn">摩西</char>和<char style="pn">以色列</char>的众长老回到了营地。<verse eid="NUM 11:30" /></para>
  <para style="s">刮来鹌鹑</para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 11:31" />有风从耶和华那里刮起，从海上刮来鹌鹑，散落在营地，覆盖营地四围，一边约有一天的路程远，另一边也约有一天的路程远，在地面上高约有两肘<note caller="+" style="f"><char style="fr" closed="false">11:31 </char><char style="ft" closed="false">两肘——相当于91.4公分。1肘=45.7公分。</char></note>。 <verse eid="NUM 11:31" /><verse number="32" style="v" sid="NUM 11:32" />民众就起来，那一天的整天整夜，以及第二天的整天，他们都在收取鹌鹑，最少的也收取了十贺梅珥<note caller="+" style="f"><char style="fr" closed="false">11:32 </char><char style="ft" closed="false">十贺梅珥——相当于2,200公升。1贺梅珥=220公升。</char></note>，满满摊放在营地的四围。<verse eid="NUM 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 11:33" />然而，那肉还在他们的口齿间没有被嚼烂，耶和华的怒气就向民众发作了，耶和华用极重的灾害打击民众。 <verse eid="NUM 11:33" /><verse number="34" style="v" sid="NUM 11:34" />那地方就被起名为“<char style="pn">基布罗-哈特瓦</char>”，因为在那里埋葬了那些起贪欲的民众。<verse eid="NUM 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 11:35" />民众从<char style="pn">基布罗-哈特瓦</char>前行到<char style="pn">哈洗录</char>，就停留在<char style="pn">哈洗录</char>。<verse eid="NUM 11:35" /></para>
  <chapter eid="NUM 11" />
  <chapter number="12" style="c" sid="NUM 12" />
  <para style="s">米利暗和亚伦毁谤摩西</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 12:1" />
    <char style="pn">米利暗</char>和<char style="pn">亚伦</char>因<char style="pn">摩西</char>娶的是<char style="pn">库实</char>女人，就攻击<char style="pn">摩西</char>说：“他娶了一个<char style="pn">库实</char>女人！” <verse eid="NUM 12:1" /><verse number="2" style="v" sid="NUM 12:2" />还说：“难道耶和华仅仅藉着<char style="pn">摩西</char>说话吗？他不也藉着我们说话吗？”耶和华听见了这些。<verse eid="NUM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 12:3" />
    <char style="pn">摩西</char>为人极其谦卑，超过世上所有的人。 <verse eid="NUM 12:3" /><verse number="4" style="v" sid="NUM 12:4" />那时，耶和华突然对<char style="pn">摩西</char>、<char style="pn">亚伦</char>和<char style="pn">米利暗</char>说：“你们三个人出来，到会幕那里！”他们三个人就出来。 <verse eid="NUM 12:4" /><verse number="5" style="v" sid="NUM 12:5" />耶和华在云柱中降临，停留在会幕入口呼唤<char style="pn">亚伦</char>和<char style="pn">米利暗</char>，他们两个人就上前来。 <verse eid="NUM 12:5" /><verse number="6" style="v" sid="NUM 12:6" />耶和华说：</para>
  <para style="q1" vid="NUM 12:6">“你们听我说：</para>
  <para style="q1" vid="NUM 12:6">如果你们当中有先知，</para>
  <para style="q1" vid="NUM 12:6">我耶和华是在异象中向他显现，</para>
  <para style="q1" vid="NUM 12:6">在梦中与他说话。<verse eid="NUM 12:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 12:7" />但我的仆人<char style="pn">摩西</char>不一样，</para>
  <para style="q1" vid="NUM 12:7">他在我全家是忠诚的，<verse eid="NUM 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 12:8" />我是与他面对面说话，</para>
  <para style="q1" vid="NUM 12:8">清清楚楚，并不用谜语；</para>
  <para style="q1" vid="NUM 12:8">他可以看见耶和华的形象。</para>
  <para style="q1" vid="NUM 12:8">你们为什么毁谤我的仆人<char style="pn">摩西</char>而不害怕呢？”<verse eid="NUM 12:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="NUM 12:9" />耶和华对他们怒气发作，然后离开了。<verse eid="NUM 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 12:10" />云彩从会幕上方收回了，看哪，<char style="pn">米利暗</char>患了麻风病，像雪一样。<char style="pn">亚伦</char>转向<char style="pn">米利暗</char>，看见她患了麻风病。 <verse eid="NUM 12:10" /><verse number="11" style="v" sid="NUM 12:11" /><char style="pn">亚伦</char>就对<char style="pn">摩西</char>说：“哦，我主啊，请不要追究我们在愚昧中所犯的罪。 <verse eid="NUM 12:11" /><verse number="12" style="v" sid="NUM 12:12" />请不要让她像那出母腹时肉已经腐烂一半的死胎那样。”<verse eid="NUM 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 12:13" />
    <char style="pn">摩西</char>向耶和华呼求说：“神哪，求求你！求你医治她！”<verse eid="NUM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 12:14" />耶和华对<char style="pn">摩西</char>说：“如果她父亲吐唾沫在她脸上，难道她不会蒙羞七天吗？你要把她隔离在营地外七天，之后带回来。” <verse eid="NUM 12:14" /><verse number="15" style="v" sid="NUM 12:15" />于是<char style="pn">米利暗</char>被隔离在营地外七天；民众没有前行，直到<char style="pn">米利暗</char>被带回来。 <verse eid="NUM 12:15" /><verse number="16" style="v" sid="NUM 12:16" />之后民众从<char style="pn">哈洗录</char>起行，在<char style="pn">帕兰</char>旷野扎营。<verse eid="NUM 12:16" /></para>
  <chapter eid="NUM 12" />
  <chapter number="13" style="c" sid="NUM 13" />
  <para style="s">探察迦南地</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 13:1" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 13:1" /><verse number="2" style="v" sid="NUM 13:2" />“你要派人去探察我赐给<char style="pn">以色列</char>子孙的<char style="pn">迦南</char>地，按父系支派，每支派差遣一人，都是他们当中的首领。” <verse eid="NUM 13:2" /><verse number="3" style="v" sid="NUM 13:3" /><char style="pn">摩西</char>就按照耶和华的指示，从<char style="pn">帕兰</char>旷野派出他们，全都是作<char style="pn">以色列</char>子民首领的人。 <verse eid="NUM 13:3" /><verse number="4" style="v" sid="NUM 13:4" />以下是他们的名字：</para>
  <para style="q1" vid="NUM 13:4">属<char style="pn">鲁本</char>支派的，是<char style="pn">扎克尔</char>的儿子<char style="pn">沙慕亚</char>；<verse eid="NUM 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NUM 13:5" />属<char style="pn">西缅</char>支派的，是<char style="pn">何利</char>的儿子<char style="pn">沙法</char>；<verse eid="NUM 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NUM 13:6" />属<char style="pn">犹大</char>支派的，是<char style="pn">耶弗尼</char>的儿子<char style="pn">迦勒</char>；<verse eid="NUM 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 13:7" />属<char style="pn">以萨迦</char>支派的，是<char style="pn">约瑟</char>的儿子<char style="pn">以甲</char>；<verse eid="NUM 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 13:8" />属<char style="pn">以法莲</char>支派的，是<char style="pn">嫩</char>的儿子<char style="pn">何西阿</char>；<verse eid="NUM 13:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 13:9" />属<char style="pn">便雅悯</char>支派的，是<char style="pn">拉弗</char>的儿子<char style="pn">帕尔提</char>；<verse eid="NUM 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NUM 13:10" />属<char style="pn">西布伦</char>支派的，是<char style="pn">索迪</char>的儿子<char style="pn">伽迪列</char>；<verse eid="NUM 13:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NUM 13:11" />属<char style="pn">约瑟</char>支派，就是<char style="pn">玛拿西</char>支派的，是<char style="pn">苏希</char>的儿子<char style="pn">迦底</char>；<verse eid="NUM 13:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NUM 13:12" />属<char style="pn">但</char>支派的，是<char style="pn">基玛利</char>的儿子<char style="pn">亚米利</char>；<verse eid="NUM 13:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NUM 13:13" />属<char style="pn">亚设</char>支派的，是<char style="pn">米迦勒</char>的儿子<char style="pn">西帖</char>；<verse eid="NUM 13:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="NUM 13:14" />属<char style="pn">拿弗他利</char>支派的，是<char style="pn">沃夫西</char>的儿子<char style="pn">拿比</char>；<verse eid="NUM 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NUM 13:15" />属<char style="pn">迦得</char>支派的，是<char style="pn">玛基</char>的儿子<char style="pn">格乌列</char>。<verse eid="NUM 13:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="NUM 13:16" />以上就是<char style="pn">摩西</char>派去探察那地的人的名字；<char style="pn">摩西</char>称<char style="pn">嫩</char>的儿子<char style="pn">何西阿</char>为<char style="pn">约书亚</char>。<verse eid="NUM 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 13:17" />
    <char style="pn">摩西</char>派他们去探察<char style="pn">迦南</char>地，对他们说：“你们前往南地<note caller="+" style="f"><char style="fr" closed="false">13:17 </char><char style="ft" closed="false">南地——音译作“内盖夫”；本章下同。</char></note>那里，然后上到山地去。 <verse eid="NUM 13:17" /><verse number="18" style="v" sid="NUM 13:18" />你们要察看那地是怎样的：住在那里的民是强是弱、是少是多， <verse eid="NUM 13:18" /><verse number="19" style="v" sid="NUM 13:19" />他们所住的地方是好是坏，他们所住的城是营地是堡垒， <verse eid="NUM 13:19" /><verse number="20" style="v" sid="NUM 13:20" />那地是肥沃还是贫瘠，那里有树木没有。你们要尽力带一些当地的果实回来。”那时正是葡萄初熟的季节。<verse eid="NUM 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 13:21" />于是他们上去探察那地，从<char style="pn">寻</char>的旷野直到<char style="pn">哈马</char>隘口那里的<char style="pn">利合</char>。 <verse eid="NUM 13:21" /><verse number="22" style="v" sid="NUM 13:22" />他们上到南地，来到<char style="pn">希伯仑</char>；那里有<char style="pn">亚衲</char>人的后裔<char style="pn">亚希幔</char>、<char style="pn">示筛</char>和<char style="pn">塔尔迈</char>，<char style="pn">希伯仑</char>比<char style="pn">埃及</char>的<char style="pn">琐安</char>早建造七年。 <verse eid="NUM 13:22" /><verse number="23" style="v" sid="NUM 13:23" />他们来到<char style="pn">以实格</char>溪谷，从那里砍下一根葡萄枝，上面带着一挂葡萄，由两个人用杠子抬着，还带了一些石榴和无花果。 <verse eid="NUM 13:23" /><verse number="24" style="v" sid="NUM 13:24" /><char style="pn">以色列</char>人给那地方起名为“<char style="pn">以实格</char>溪谷”，因为他们从那里砍下了一挂葡萄。 <verse eid="NUM 13:24" /><verse number="25" style="v" sid="NUM 13:25" />四十天后，他们探察完那地回来了。<verse eid="NUM 13:25" /></para>
  <para style="s">报告迦南地的情况</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 13:26" />他们回到<char style="pn">帕兰</char>旷野的<char style="pn">加低斯</char>，来到<char style="pn">摩西</char>和<char style="pn">亚伦</char>以及全体<char style="pn">以色列</char>会众那里，向他们和全体会众报告，又给他们看那地的果实。 <verse eid="NUM 13:26" /><verse number="27" style="v" sid="NUM 13:27" />他们向<char style="pn">摩西</char>讲述，说：“我们到了你派我们去的那地，果然是流奶与蜜之地，这就是那里的果实。 <verse eid="NUM 13:27" /><verse number="28" style="v" sid="NUM 13:28" />不过住在那地的民强悍，城市极其坚固高大，我们在那里还看见了<char style="pn">亚衲</char>人的后裔。 <verse eid="NUM 13:28" /><verse number="29" style="v" sid="NUM 13:29" /><char style="pn">亚玛力</char>人住在南地，<char style="pn">赫提</char>人、<char style="pn">耶布斯</char>人和<char style="pn">亚摩利</char>人住在山地，<char style="pn">迦南</char>人住在海边和<char style="pn">约旦</char>河沿岸。”<verse eid="NUM 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 13:30" />
    <char style="pn">迦勒</char>让民众在<char style="pn">摩西</char>面前安静下来，说：“我们尽管上去，占有那地！我们一定能征服它。”<verse eid="NUM 13:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 13:31" />但那些与他一起上去探察<note caller="+" style="f"><char style="fr" closed="false">13:31 </char><char style="ft" closed="false">探察——辅助词语。</char></note>的人说：“我们不能上去攻打那民，他们实在比我们强大。” <verse eid="NUM 13:31" /><verse number="32" style="v" sid="NUM 13:32" />那些人还向<char style="pn">以色列</char>子民散布有关所探察之地的谣言，说：“我们过去探察的那地，是吞没居民之地，而且我们在那里看见的民都是身材高大的人。 <verse eid="NUM 13:32" /><verse number="33" style="v" sid="NUM 13:33" />我们在那里也看见了巨人<note caller="+" style="f"><char style="fr" closed="false">13:33 </char><char style="ft" closed="false">巨人——或译作“伟人”。</char></note>，就是巨人的后裔<char style="pn">亚衲</char>子孙。在我们眼中，我们就像是蚱蜢；在他们眼中，我们也是如此。”<verse eid="NUM 13:33" /></para>
  <chapter eid="NUM 13" />
  <chapter number="14" style="c" sid="NUM 14" />
  <para style="s">以色列人拒绝进迦南地</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 14:1" />全体会众就起来，大声喧嚷，那天夜里，民众都哭泣。 <verse eid="NUM 14:1" /><verse number="2" style="v" sid="NUM 14:2" /><char style="pn">以色列</char>子民都向<char style="pn">摩西</char>和<char style="pn">亚伦</char>发怨言，全体会众对他们说：“我们还不如死在<char style="pn">埃及</char>地，或者死在这旷野！ <verse eid="NUM 14:2" /><verse number="3" style="v" sid="NUM 14:3" />耶和华为什么要把我们领到这地，使我们倒在刀下呢？我们的妻子和孩童要成为掠物了！我们回<char style="pn">埃及</char>不是更好吗？” <verse eid="NUM 14:3" /><verse number="4" style="v" sid="NUM 14:4" />他们又彼此说：“让我们立一个首领，回<char style="pn">埃及</char>去吧！”<verse eid="NUM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 14:5" />
    <char style="pn">摩西</char>和<char style="pn">亚伦</char>就在<char style="pn">以色列</char>子孙全体会众面前脸伏于地。 <verse eid="NUM 14:5" /><verse number="6" style="v" sid="NUM 14:6" />那时，探察那地的人当中，<char style="pn">嫩</char>的儿子<char style="pn">约书亚</char>和<char style="pn">耶弗尼</char>的儿子<char style="pn">迦勒</char>撕裂衣服， <verse eid="NUM 14:6" /><verse number="7" style="v" sid="NUM 14:7" />对全体<char style="pn">以色列</char>会众说：“我们过去探察的那地，是极其美好的地方。 <verse eid="NUM 14:7" /><verse number="8" style="v" sid="NUM 14:8" />如果耶和华喜悦我们，他必把我们带进那地，把那流奶与蜜之地赐给我们； <verse eid="NUM 14:8" /><verse number="9" style="v" sid="NUM 14:9" />至于你们，不要背叛耶和华！不要怕那地的民，他们是我们的猎物；他们的保障已经离开他们了，但耶和华与我们同在。你们不要怕他们！”<verse eid="NUM 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 14:10" />但全体会众说要用石头砸死这二人。这时，耶和华的荣耀在会幕中向全体<char style="pn">以色列</char>子民显现。<verse eid="NUM 14:10" /></para>
  <para style="s">以色列子民受审判</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 14:11" />耶和华对<char style="pn">摩西</char>说：“这子民藐视我，要到什么时候呢？我在他们当中行了这一切神迹，他们还不相信我，要到什么时候呢？ <verse eid="NUM 14:11" /><verse number="12" style="v" sid="NUM 14:12" />我要用瘟疫打击他们，不让他们继承那地，却使你成为一个比他们强大的民族。”<verse eid="NUM 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 14:13" />但<char style="pn">摩西</char>对耶和华说：“<char style="pn">埃及</char>人必听见这事。要知道，你用你的大能将这子民从他们当中带上来， <verse eid="NUM 14:13" /><verse number="14" style="v" sid="NUM 14:14" />他们会告诉这地的居民；这些居民也听说了：你耶和华与这子民同在，你耶和华曾被人亲眼看见，你的云彩停留在子民上面，你白天在云柱中、黑夜在火柱中，行走在他们前头。 <verse eid="NUM 14:14" /><verse number="15" style="v" sid="NUM 14:15" />你如果把这子民全都<note caller="+" style="f"><char style="fr" closed="false">14:15 </char><char style="ft" closed="false">全都——原文直译“如同一人”。</char></note>杀掉，那些听过你名声的民族就会议论说： <verse eid="NUM 14:15" /><verse number="16" style="v" sid="NUM 14:16" />‘耶和华因为不能领这子民进入他起誓要给他们的那地，所以在旷野把他们宰杀了。’<verse eid="NUM 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 14:17" />“现在，愿我主彰显大能！正如你曾宣告说： <verse eid="NUM 14:17" /><verse number="18" style="v" sid="NUM 14:18" />‘耶和华不轻易发怒，并有丰盛的慈爱；他赦免罪孽和过犯，但绝不会让有罪的免于罪责，而会追究罪责，从父亲到儿子，直到第三代、第四代’， <verse eid="NUM 14:18" /><verse number="19" style="v" sid="NUM 14:19" />求你照着你的大慈爱赦免这子民的罪孽，就像从<char style="pn">埃及</char>到如今你一直赦免这子民一样。”<verse eid="NUM 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 14:20" />耶和华说：“我已经照你的祈求赦免了他们。 <verse eid="NUM 14:20" /><verse number="21" style="v" sid="NUM 14:21" />然而我指着我的永生起誓，指着那充满全地的耶和华的荣耀起誓： <verse eid="NUM 14:21" /><verse number="22" style="v" sid="NUM 14:22" />虽然这些人全都看见过我的荣耀，以及我在<char style="pn">埃及</char>、在旷野所行的神迹，他们却试探了我这十次，并没有听从我的话， <verse eid="NUM 14:22" /><verse number="23" style="v" sid="NUM 14:23" />所以，他们绝不会见到我所起誓赐给他们先祖的那地，所有藐视我的人都不会见到。 <verse eid="NUM 14:23" /><verse number="24" style="v" sid="NUM 14:24" />但我的仆人<char style="pn">迦勒</char>，因他有与他们不同的灵<note caller="+" style="f"><char style="fr" closed="false">14:24 </char><char style="ft" closed="false">与他们不同的灵——或译作“不同的心志”。</char></note>，全心跟从我，我要把他带进他曾进去的那地，他的后裔也必继承那地。 <verse eid="NUM 14:24" /><verse number="25" style="v" sid="NUM 14:25" /><char style="pn">亚玛力</char>人和<char style="pn">迦南</char>人住在山间平地，明天你们要转回，沿着通往<char style="pn">红海</char>的路往旷野前行。”<verse eid="NUM 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 14:26" />耶和华又指示<char style="pn">摩西</char>和<char style="pn">亚伦</char>说： <verse eid="NUM 14:26" /><verse number="27" style="v" sid="NUM 14:27" />“这邪恶的会众，他们向我发怨言要到什么时候呢？<char style="pn">以色列</char>子民向我所发的怨言，我都听见了。 <verse eid="NUM 14:27" /><verse number="28" style="v" sid="NUM 14:28" />你要对他们说，这是耶和华的宣告：我指着我的永生起誓，我必定照着你们在我耳中所说的话对待你们。 <verse eid="NUM 14:28" /><verse number="29" style="v" sid="NUM 14:29" />你们这些被数点过的，就是二十岁以上所有在名单中的，都将横尸在这旷野中，因为你们向我发怨言。 <verse eid="NUM 14:29" /><verse number="30" style="v" sid="NUM 14:30" />除了<char style="pn">耶弗尼</char>的儿子<char style="pn">迦勒</char>和<char style="pn">嫩</char>的儿子<char style="pn">约书亚</char>以外，你们绝不会进入我举手起誓要让你们安居其中的那地； <verse eid="NUM 14:30" /><verse number="31" style="v" sid="NUM 14:31" />但你们的孩童，就是你们说将成为掠物的，我要带他们进去，他们将得见你们所厌弃的那地。 <verse eid="NUM 14:31" /><verse number="32" style="v" sid="NUM 14:32" />至于你们，你们将横尸在这旷野中， <verse eid="NUM 14:32" /><verse number="33" style="v" sid="NUM 14:33" />你们的子孙将在旷野游牧四十年，承担你们不忠贞的罪，直到你们全都横尸在旷野中。 <verse eid="NUM 14:33" /><verse number="34" style="v" sid="NUM 14:34" />按你们探察那地的天数，共四十天，一天算一年，你们要承担你们的罪责四十年。这样你们就知道敌对我的后果<note caller="+" style="f"><char style="fr" closed="false">14:34 </char><char style="ft" closed="false">敌对我的后果——或译作“我疏远你们了”。</char></note>。 <verse eid="NUM 14:34" /><verse number="35" style="v" sid="NUM 14:35" />我耶和华发了话，就必如此对待这一切聚集起来敌对我的邪恶会众，他们必在这旷野中灭尽，死在这里。”<verse eid="NUM 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 14:36" />
    <char style="pn">摩西</char>派去探察那地的人回来后，散布有关那地的谣言，以致全体会众向<char style="pn">摩西</char>发怨言， <verse eid="NUM 14:36" /><verse number="37" style="v" sid="NUM 14:37" />这些散布那地可怕谣言的人就遭受瘟疫，死在耶和华面前。 <verse eid="NUM 14:37" /><verse number="38" style="v" sid="NUM 14:38" />这些去探察那地的人当中，只有<char style="pn">嫩</char>的儿子<char style="pn">约书亚</char>和<char style="pn">耶弗尼</char>的儿子<char style="pn">迦勒</char>活了下来。<verse eid="NUM 14:38" /></para>
  <para style="s">以色列被击溃</para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 14:39" />
    <char style="pn">摩西</char>将这些话告诉了全体<char style="pn">以色列</char>子民，人们就极其悲恸。 <verse eid="NUM 14:39" /><verse number="40" style="v" sid="NUM 14:40" />他们清早起来，上到山地高处，说：“我们来了，我们要上耶和华应许的那地方去！我们实在犯了罪。”<verse eid="NUM 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 14:41" />
    <char style="pn">摩西</char>说：“你们为什么又要违背耶和华的吩咐呢？这不会成功的。 <verse eid="NUM 14:41" /><verse number="42" style="v" sid="NUM 14:42" />你们不要上去，以免败在你们仇敌面前，因为耶和华不在你们当中。 <verse eid="NUM 14:42" /><verse number="43" style="v" sid="NUM 14:43" /><char style="pn">亚玛力</char>人和<char style="pn">迦南</char>人就在那里，在你们前头，你们必倒在刀下。因为你们既然转离不跟从耶和华，耶和华也必不与你们同在。”<verse eid="NUM 14:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 14:44" />他们却擅自上山地高处去，尽管耶和华的约柜和<char style="pn">摩西</char>都没有从营地中出来。 <verse eid="NUM 14:44" /><verse number="45" style="v" sid="NUM 14:45" />于是住在那山地的<char style="pn">亚玛力</char>人和<char style="pn">迦南</char>人下来击杀他们，击溃他们，直到<char style="pn">霍尔玛</char>。<verse eid="NUM 14:45" /></para>
  <chapter eid="NUM 14" />
  <chapter number="15" style="c" sid="NUM 15" />
  <para style="s">献祭的条例</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 15:1" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 15:1" /><verse number="2" style="v" sid="NUM 15:2" />“你要吩咐<char style="pn">以色列</char>子民，对他们说：你们进入了我赐给你们的安居之地后， <verse eid="NUM 15:2" /><verse number="3" style="v" sid="NUM 15:3" />向耶和华献上火祭时，无论是燔祭或是别的祭物，无论是为了还特殊的愿，或是作甘心祭，或是作各节期的祭，都要从牛群或羊群中取来，烧献为馨香之气给耶和华。 <verse eid="NUM 15:3" /><verse number="4" style="v" sid="NUM 15:4" />那向耶和华献上祭物的人，还要献上十分之一伊法<note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="ft" closed="false">十分之一伊法——相当于2.2公升。1伊法=22公升。</char></note>细面粉为素祭，用四分之一欣<note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="ft" closed="false">四分之一欣——相当于0.9公升。1欣=3.7公升。</char></note>油调和。 <verse eid="NUM 15:4" /><verse number="5" style="v" sid="NUM 15:5" />在燔祭或别的祭物之外，你还要为每只绵羊羔预备四分之一欣的酒作酒祭。 <verse eid="NUM 15:5" /><verse number="6" style="v" sid="NUM 15:6" />或是为每只公绵羊预备十分之二伊法<note caller="+" style="f"><char style="fr" closed="false">15:6 </char><char style="ft" closed="false">十分之二伊法——相当于4.4公升。1伊法=22公升。</char></note>细面粉为素祭，用三分之一欣<note caller="+" style="f"><char style="fr" closed="false">15:6 </char><char style="ft" closed="false">三分之一欣——相当于1.2公升。1欣=3.7公升。</char></note>油调和； <verse eid="NUM 15:6" /><verse number="7" style="v" sid="NUM 15:7" />还要献上三分之一欣的酒作酒祭，烧献为馨香之气给耶和华。<verse eid="NUM 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 15:8" />“当你预备一头公牛作燔祭或别的祭物献给耶和华，无论是为了还特殊的愿或是作平安祭， <verse eid="NUM 15:8" /><verse number="9" style="v" sid="NUM 15:9" />都要与公牛一起献上十分之三伊法<note caller="+" style="f"><char style="fr" closed="false">15:9 </char><char style="ft" closed="false">十分之三伊法——相当于6.6公升。1伊法=22公升。</char></note>细面粉为素祭，用半欣<note caller="+" style="f"><char style="fr" closed="false">15:9 </char><char style="ft" closed="false">半欣——相当于1.9公升。1欣=3.7公升。</char></note>油调和。 <verse eid="NUM 15:9" /><verse number="10" style="v" sid="NUM 15:10" />还要献上半欣的酒为酒祭，作为馨香的火祭献给耶和华。 <verse eid="NUM 15:10" /><verse number="11" style="v" sid="NUM 15:11" />为每头公牛、每只公绵羊、每只绵羊羔或山羊羔，都要这样预备； <verse eid="NUM 15:11" /><verse number="12" style="v" sid="NUM 15:12" />无论为多少牛羊，都要照着它们的数量，这样为每一只祭牲预备。<verse eid="NUM 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 15:13" />“任何本族人<note caller="+" style="f"><char style="fr" closed="false">15:13 </char><char style="ft" closed="false">本族人——原文直译“本地人”；本章下同。</char></note>向耶和华献上馨香的火祭，都要这样预备。 <verse eid="NUM 15:13" /><verse number="14" style="v" sid="NUM 15:14" />如果寄居在你们中间的外人，或世世代代在你们中间的外人，想要向耶和华献上馨香的火祭，那么，你们怎样做，他也要怎样做。 <verse eid="NUM 15:14" /><verse number="15" style="v" sid="NUM 15:15" />无论是对你们还是对寄居的外人，会众要有同一个律例。这是你们世世代代永远的律例。在耶和华面前，你们怎样，外人也要怎样。 <verse eid="NUM 15:15" /><verse number="16" style="v" sid="NUM 15:16" />你们和寄居在你们中间的外人，是同一个条例、同一个规定。”<verse eid="NUM 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 15:17" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 15:17" /><verse number="18" style="v" sid="NUM 15:18" />“你要吩咐<char style="pn">以色列</char>子民，对他们说：当你们进入我要带你们去的那地， <verse eid="NUM 15:18" /><verse number="19" style="v" sid="NUM 15:19" />享用那地的出产时，你们要奉上一份供物给耶和华。 <verse eid="NUM 15:19" /><verse number="20" style="v" sid="NUM 15:20" />你们要用初熟五谷的面团做饼，作为供物奉上，就像打谷场的供物一样把它奉上。 <verse eid="NUM 15:20" /><verse number="21" style="v" sid="NUM 15:21" />你们世世代代都要从你们初熟五谷的面团中，把一份供物献给耶和华。<verse eid="NUM 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 15:22" />“如果你们无意中有了过失，没有遵行耶和华吩咐<char style="pn">摩西</char>的这一切诫命， <verse eid="NUM 15:22" /><verse number="23" style="v" sid="NUM 15:23" />就是耶和华藉着<char style="pn">摩西</char>所指示你们的一切——从耶和华指示你们的那天起，之后世世代代， <verse eid="NUM 15:23" /><verse number="24" style="v" sid="NUM 15:24" />如果是会众没有察觉而无意中有了过失，全体会众就要献上一头公牛为燔祭，作馨香之气献给耶和华，并按照规定献上同献的素祭和酒祭；还有一只公山羊为赎罪祭。 <verse eid="NUM 15:24" /><verse number="25" style="v" sid="NUM 15:25" />祭司要为全体<char style="pn">以色列</char>会众赎罪，他们就得赦免，因为这是无意的过失。他们要为自己无意的过失带来祭物，就是献给耶和华的火祭和赎罪祭，带到耶和华面前。 <verse eid="NUM 15:25" /><verse number="26" style="v" sid="NUM 15:26" />全体<char style="pn">以色列</char>会众和寄居在他们中间的外人，都必得赦免，因为这是全体民众无意的过失。<verse eid="NUM 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 15:27" />“如果是一个人无意中犯了罪，他就要献上一只一岁的母山羊作赎罪祭。 <verse eid="NUM 15:27" /><verse number="28" style="v" sid="NUM 15:28" />祭司要为那无意中过失犯罪的人赎罪；祭司在耶和华面前为他赎罪，他就必得赦免。 <verse eid="NUM 15:28" /><verse number="29" style="v" sid="NUM 15:29" />无论是<char style="pn">以色列</char>子孙中的本族人，还是寄居在他们中间的外人，你们无意中有过失的人都是同一个条例。<verse eid="NUM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 15:30" />“但狂妄行事的人，无论是本族人或是外人，那人是在亵渎耶和华，必须从民中被剪除。 <verse eid="NUM 15:30" /><verse number="31" style="v" sid="NUM 15:31" />那人既然藐视耶和华的话语，违背他的诫命，就必须被剪除，他的罪责要归在自己身上。”<verse eid="NUM 15:31" /></para>
  <para style="s">违犯安息日</para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 15:32" />
    <char style="pn">以色列</char>子孙在旷野的时候，人们发现有一个人在安息日捡木柴。 <verse eid="NUM 15:32" /><verse number="33" style="v" sid="NUM 15:33" />那些发现他在捡木柴的人，就把他带到<char style="pn">摩西</char>和<char style="pn">亚伦</char>以及全体会众那里。 <verse eid="NUM 15:33" /><verse number="34" style="v" sid="NUM 15:34" />他们把他拘押起来，因为还不明确该怎样处置他。 <verse eid="NUM 15:34" /><verse number="35" style="v" sid="NUM 15:35" />耶和华对<char style="pn">摩西</char>说：“那人必须被处死，全体会众要在营地外用石头砸死他。” <verse eid="NUM 15:35" /><verse number="36" style="v" sid="NUM 15:36" />于是全体会众把那人带到营地外，用石头砸死了他，正如耶和华所指示<char style="pn">摩西</char>的。<verse eid="NUM 15:36" /></para>
  <para style="s">衣服䍁子的规条</para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 15:37" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 15:37" /><verse number="38" style="v" sid="NUM 15:38" />“你要吩咐<char style="pn">以色列</char>子民，告诉他们要世世代代在外衣的衣摆上做䍁子，并给衣摆的䍁子加上一根蓝色的细带子。 <verse eid="NUM 15:38" /><verse number="39" style="v" sid="NUM 15:39" />你们要这样做䍁子，使你们看见就想起并遵行耶和华的一切诫命，而不随从自己惯于行淫的欲念和眼目； <verse eid="NUM 15:39" /><verse number="40" style="v" sid="NUM 15:40" />也使你们牢记并遵行我的一切诫命，成为圣洁的，归于你们的神。 <verse eid="NUM 15:40" /><verse number="41" style="v" sid="NUM 15:41" />我是耶和华你们的神，是我把你们从<char style="pn">埃及</char>地领了出来，为要作你们的神。我是耶和华你们的神。”<verse eid="NUM 15:41" /></para>
  <chapter eid="NUM 15" />
  <chapter number="16" style="c" sid="NUM 16" />
  <para style="s">可拉煽动叛乱</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 16:1" />
    <char style="pn">以斯哈</char>的儿子<char style="pn">可拉</char>，是<char style="pn">利未</char>之子<char style="pn">哥辖</char>的孙子，他带着<char style="pn">鲁本</char>子孙<char style="pn">以利押</char>的儿子<char style="pn">大坍</char>和<char style="pn">亚比兰</char>，以及<char style="pn">比勒</char>的儿子<char style="pn">奥恩</char>， <verse eid="NUM 16:1" /><verse number="2" style="v" sid="NUM 16:2" />起来对抗<char style="pn">摩西</char>，随同他们的还有<char style="pn">以色列</char>子孙中的两百五十人，都是议会选召出来的会众领袖，是有名望的人。 <verse eid="NUM 16:2" /><verse number="3" style="v" sid="NUM 16:3" />他们聚集起来对抗<char style="pn">摩西</char>和<char style="pn">亚伦</char>，说：“你们僭越了！其实全体会众每一个都是圣洁的，耶和华也与他们同在，你们为何高抬自己，站在耶和华的会众之上呢？”<verse eid="NUM 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 16:4" />
    <char style="pn">摩西</char>听见了，就脸伏于地。 <verse eid="NUM 16:4" /><verse number="5" style="v" sid="NUM 16:5" />他对<char style="pn">可拉</char>和<char style="pn">可拉</char>的所有同党说：“明天早晨，耶和华会显明谁是属于他的，谁是分别为圣的，他会让那人亲近他，让他所拣选的人亲近他。 <verse eid="NUM 16:5" /><verse number="6" style="v" sid="NUM 16:6" />你们要这样做：<char style="pn">可拉</char>和<char style="pn">可拉</char>的所有同党，你们拿来香炉， <verse eid="NUM 16:6" /><verse number="7" style="v" sid="NUM 16:7" />明天在耶和华面前，给香炉里盛上火，加上香。那时，耶和华拣选了谁，谁就是分别为圣的。<char style="pn">利未</char>的子孙哪，是你们僭越了！”<verse eid="NUM 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 16:8" />
    <char style="pn">摩西</char>又对<char style="pn">可拉</char>说：“<char style="pn">利未</char>的子孙哪，你们听着！ <verse eid="NUM 16:8" /><verse number="9" style="v" sid="NUM 16:9" /><char style="pn">以色列</char>的神将你们从<char style="pn">以色列</char>会众当中分别出来，让你们亲近他，做耶和华帐幕的服事工作，并站在会众面前事奉他们，这对你们是小事吗？ <verse eid="NUM 16:9" /><verse number="10" style="v" sid="NUM 16:10" />耶和华让你和你所有的弟兄，就是与你一起的<char style="pn">利未</char>子孙，都亲近他，现在你们还想谋求祭司的职份吗？ <verse eid="NUM 16:10" /><verse number="11" style="v" sid="NUM 16:11" />其实，你和你所有的同党聚集起来是在敌对耶和华！<char style="pn">亚伦</char>算什么，你们竟然向他发怨言？”<verse eid="NUM 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 16:12" />
    <char style="pn">摩西</char>派人去把<char style="pn">以利押</char>的儿子<char style="pn">大坍</char>和<char style="pn">亚比兰</char>召来，他们却说：“我们不过去。 <verse eid="NUM 16:12" /><verse number="13" style="v" sid="NUM 16:13" />你把我们从流奶与蜜之地带上来，让我们死在旷野，这算小事吗？你还想自立为王统治我们！ <verse eid="NUM 16:13" /><verse number="14" style="v" sid="NUM 16:14" />况且，你并没有把我们领到流奶与蜜之地，也没有赐给我们田地和葡萄园为继业。难道你想剜出我们这些人的眼睛吗？我们不过去！”<verse eid="NUM 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 16:15" />
    <char style="pn">摩西</char>就非常恼火，他对耶和华说：“求你不要悦纳他们的供物。我并没有夺走过他们一头驴子，也没有伤害过他们任何一人。”<verse eid="NUM 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 16:16" />
    <char style="pn">摩西</char>对<char style="pn">可拉</char>说：“明天你和你的所有同党都要到耶和华面前，你和他们，还有<char style="pn">亚伦</char>都要在场。 <verse eid="NUM 16:16" /><verse number="17" style="v" sid="NUM 16:17" />你们各自拿来香炉，放上香。他们各人要在耶和华面前呈上自己的香炉，共两百五十个香炉，你和<char style="pn">亚伦</char>也要呈上自己的香炉。”<verse eid="NUM 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 16:18" />于是他们各自拿来香炉，给香炉里盛上火，加上香，与<char style="pn">摩西</char>和<char style="pn">亚伦</char>一起站在会幕入口。 <verse eid="NUM 16:18" /><verse number="19" style="v" sid="NUM 16:19" /><char style="pn">可拉</char>把全体会众都招聚到会幕入口，对抗<char style="pn">摩西</char>和<char style="pn">亚伦</char>。那时，耶和华的荣耀向全体会众显现， <verse eid="NUM 16:19" /><verse number="20" style="v" sid="NUM 16:20" />耶和华指示<char style="pn">摩西</char>和<char style="pn">亚伦</char>说： <verse eid="NUM 16:20" /><verse number="21" style="v" sid="NUM 16:21" />“你们从这会众当中分离出来，我要一瞬间消灭他们！”<verse eid="NUM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 16:22" />
    <char style="pn">摩西</char>和<char style="pn">亚伦</char>就脸伏于地，说：“神哪，使一切肉体有气息<note caller="+" style="f"><char style="fr" closed="false">16:22 </char><char style="ft" closed="false">使一切肉体有气息——或译作“赐予全人类气息”。</char></note>的神！一个人犯罪，你就对全体会众发怒吗？”<verse eid="NUM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 16:23" />于是，耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 16:23" /><verse number="24" style="v" sid="NUM 16:24" />“你要吩咐会众说：你们都从<char style="pn">可拉</char>、<char style="pn">大坍</char>和<char style="pn">亚比兰</char>的帐幕周围离开！”<verse eid="NUM 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 16:25" />于是<char style="pn">摩西</char>起来，到<char style="pn">大坍</char>和<char style="pn">亚比兰</char>那里去，<char style="pn">以色列</char>的长老们跟随着他。 <verse eid="NUM 16:25" /><verse number="26" style="v" sid="NUM 16:26" />他告诉会众说：“你们要远离这些恶人的帐篷，不要碰任何属于他们的东西，免得你们因他们的一切罪恶而被除灭。” <verse eid="NUM 16:26" /><verse number="27" style="v" sid="NUM 16:27" />会众就从<char style="pn">可拉</char>、<char style="pn">大坍</char>、<char style="pn">亚比兰</char>的帐篷四围离开了。<char style="pn">大坍</char>和<char style="pn">亚比兰</char>，还有他们的妻子、儿女和孩童都出来，站在他们的帐篷入口。<verse eid="NUM 16:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 16:28" />
    <char style="pn">摩西</char>说：“藉着这事，你们必知道，是耶和华派遣了我来做这一切工作，而不是我随从自己的心意做事。 <verse eid="NUM 16:28" /><verse number="29" style="v" sid="NUM 16:29" />如果这些人的死如世人的死，他们的遭遇如世人的遭遇，耶和华就没有派遣我。 <verse eid="NUM 16:29" /><verse number="30" style="v" sid="NUM 16:30" />但如果耶和华行一件新事，使地张口吞掉他们和属于他们的一切，使他们活活地下到阴间，你们就明白：这些人确实藐视了耶和华。”<verse eid="NUM 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 16:31" />他刚说完这一切话，那些人脚下的土地就裂开了。 <verse eid="NUM 16:31" /><verse number="32" style="v" sid="NUM 16:32" />地张口吞掉他们和他们的家人，以及所有属于<char style="pn">可拉</char>的人和财物。 <verse eid="NUM 16:32" /><verse number="33" style="v" sid="NUM 16:33" />他们和所有属于他们的，都活活地下到阴间，地掩埋了他们，他们就从会众当中消失了。 <verse eid="NUM 16:33" /><verse number="34" style="v" sid="NUM 16:34" />因他们的叫声周围所有的<char style="pn">以色列</char>人都逃跑了，他们说：“恐怕地要把我们也吞掉了！” <verse eid="NUM 16:34" /><verse number="35" style="v" sid="NUM 16:35" />还有火从耶和华那里出来，吞灭了那两百五十个呈上香的人。<verse eid="NUM 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 16:36" />
    <note caller="+" style="f">
      <char style="fr" closed="false">16:36 </char>
      <char style="ft" closed="false">此节至17:13在马索拉文本为17:1至17:28。</char>
    </note>耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 16:36" /><verse number="37" style="v" sid="NUM 16:37" />“你要吩咐祭司<char style="pn">亚伦</char>的儿子<char style="pn">以利亚撒</char>，让他从燃烧的火中拿起那些香炉，将火撒在远处，因为那些香炉都分别为圣了。 <verse eid="NUM 16:37" /><verse number="38" style="v" sid="NUM 16:38" />至于那些犯罪丧命之人的香炉，要锤成薄片，用来包祭坛，因为这些香炉已经被献在耶和华面前，分别为圣了；它们要给<char style="pn">以色列</char>子孙作鉴戒。”<verse eid="NUM 16:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 16:39" />于是，祭司<char style="pn">以利亚撒</char>取来那些被烧死的人所献的铜香炉，人们把香炉锤成薄片，用来包祭坛， <verse eid="NUM 16:39" /><verse number="40" style="v" sid="NUM 16:40" />为<char style="pn">以色列</char>子孙作记念，免得那不属于<char style="pn">亚伦</char>后裔的外人靠近耶和华面前烧香，以致有<char style="pn">可拉</char>和他的同党一样的遭遇。这都是照耶和华藉着<char style="pn">摩西</char>所吩咐<char style="pn">以利亚撒</char>的。<verse eid="NUM 16:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 16:41" />但第二天，全体<char style="pn">以色列</char>会众向<char style="pn">摩西</char>和<char style="pn">亚伦</char>发怨言，说：“你们杀了耶和华的子民！” <verse eid="NUM 16:41" /><verse number="42" style="v" sid="NUM 16:42" />正当会众聚集起来对抗<char style="pn">摩西</char>和<char style="pn">亚伦</char>的时候，他们转向会幕，看哪，云彩遮盖会幕，耶和华的荣耀显现了。<verse eid="NUM 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="NUM 16:43" />
    <char style="pn">摩西</char>和<char style="pn">亚伦</char>来到会幕前面， <verse eid="NUM 16:43" /><verse number="44" style="v" sid="NUM 16:44" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 16:44" /><verse number="45" style="v" sid="NUM 16:45" />“你们从这会众当中离开，我要一瞬间消灭他们！”<char style="pn">摩西</char>和<char style="pn">亚伦</char>就脸伏于地。<verse eid="NUM 16:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 16:46" />
    <char style="pn">摩西</char>对<char style="pn">亚伦</char>说：“你拿来香炉，香炉里盛上祭坛的火，加上香，赶快到会众那里去，为他们赎罪，因为有震怒从耶和华面前发出，瘟疫已经开始了。”<verse eid="NUM 16:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="NUM 16:47" />
    <char style="pn">亚伦</char>照着<char style="pn">摩西</char>所说的拿来香炉，跑到会众当中。看哪，瘟疫已经在子民中开始了！他就呈上香<note caller="+" style="f"><char style="fr" closed="false">16:47 </char><char style="ft" closed="false">呈上香——或译作“给香炉放上香”。</char></note>，为子民赎罪。 <verse eid="NUM 16:47" /><verse number="48" style="v" sid="NUM 16:48" />他站在死人和活人之间，瘟疫就止住了。 <verse eid="NUM 16:48" /><verse number="49" style="v" sid="NUM 16:49" />除了因<char style="pn">可拉</char>事件而死的人以外，死于瘟疫的有一万四千七百人。 <verse eid="NUM 16:49" /><verse number="50" style="v" sid="NUM 16:50" /><char style="pn">亚伦</char>回到会幕入口<char style="pn">摩西</char>那里，瘟疫已经止住了。<verse eid="NUM 16:50" /></para>
  <chapter eid="NUM 16" />
  <chapter number="17" style="c" sid="NUM 17" />
  <para style="s">亚伦的杖被选中</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 17:1" />
    <note caller="+" style="f">
      <char style="fr" closed="false">17:1 </char>
      <char style="ft" closed="false">此章在马索拉文本为17:16至17:28。</char>
    </note>耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 17:1" /><verse number="2" style="v" sid="NUM 17:2" />“你告诉<char style="pn">以色列</char>子民，要按父家从他们那里取来木杖，每个父家一根，从所有的父家领袖那里取来十二根杖。你要把各人的名字写在各自的杖上， <verse eid="NUM 17:2" /><verse number="3" style="v" sid="NUM 17:3" />也把<char style="pn">亚伦</char>的名字写在<char style="pn">利未</char>的杖上，这样一根杖代表一个父家首领。 <verse eid="NUM 17:3" /><verse number="4" style="v" sid="NUM 17:4" />你要把这些杖放在会幕里见证柜的前面，那里是我与你们相会的地方。 <verse eid="NUM 17:4" /><verse number="5" style="v" sid="NUM 17:5" />我所拣选的那个人，他的杖将会发芽，这样我就从我面前平息了<char style="pn">以色列</char>子民向你们所发的怨言。”<verse eid="NUM 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 17:6" />于是<char style="pn">摩西</char>吩咐<char style="pn">以色列</char>子民，他们所有的领袖就按父家把木杖交给他，一根杖代表一个领袖，共十二根杖，<char style="pn">亚伦</char>的杖也在他们的杖中间。 <verse eid="NUM 17:6" /><verse number="7" style="v" sid="NUM 17:7" /><char style="pn">摩西</char>就把这些杖安置在见证会幕内耶和华面前。<verse eid="NUM 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 17:8" />到了第二天，<char style="pn">摩西</char>进入见证会幕，看哪，<char style="pn">利未</char>家<char style="pn">亚伦</char>的杖发了芽，吐出花苞，开了花，结了杏。 <verse eid="NUM 17:8" /><verse number="9" style="v" sid="NUM 17:9" /><char style="pn">摩西</char>把所有的木杖从耶和华面前拿出来，给所有的<char style="pn">以色列</char>子民。他们看了，各人就取回自己的杖。 <verse eid="NUM 17:9" /><verse number="10" style="v" sid="NUM 17:10" />耶和华对<char style="pn">摩西</char>说：“<char style="pn">亚伦</char>的杖要放回见证柜前面，保存下来给悖逆的人作鉴戒。这样他们的怨言就可以从我面前止息，以免他们死亡。” <verse eid="NUM 17:10" /><verse number="11" style="v" sid="NUM 17:11" /><char style="pn">摩西</char>遵行耶和华所指示他的，都照着做了。<verse eid="NUM 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 17:12" />那时，<char style="pn">以色列</char>子民对<char style="pn">摩西</char>说：“看哪，我们丧命了！我们灭亡了！我们全都灭亡了！ <verse eid="NUM 17:12" /><verse number="13" style="v" sid="NUM 17:13" />凡是靠近耶和华帐幕的人都要死，难道我们全都要丧命吗？”<verse eid="NUM 17:13" /></para>
  <chapter eid="NUM 17" />
  <chapter number="18" style="c" sid="NUM 18" />
  <para style="s">会幕的圣职</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 18:1" />于是，耶和华对<char style="pn">亚伦</char>说：“你和你的儿子们以及你的父家，要一同承担与圣所相关的罪责；你和你的儿子们，要一同承担与你们祭司职份相关的罪责。 <verse eid="NUM 18:1" /><verse number="2" style="v" sid="NUM 18:2" />你还要带你<char style="pn">利未</char>支派的弟兄，就是你父系支派的人，与你一同上前事奉。他们要从属你，辅助你。当你和你的儿子们一同在见证会幕前面时， <verse eid="NUM 18:2" /><verse number="3" style="v" sid="NUM 18:3" />他们要为你和整个会幕谨守职责，只是他们不可靠近圣所的器具和祭坛，以免他们和你们都死亡。 <verse eid="NUM 18:3" /><verse number="4" style="v" sid="NUM 18:4" />他们要从属你，为帐幕的一切服事谨守会幕的职责；外人不可靠近你们。<verse eid="NUM 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 18:5" />“你们要谨守圣所的职责和祭坛的职责，以免震怒再临到<char style="pn">以色列</char>子孙。 <verse eid="NUM 18:5" /><verse number="6" style="v" sid="NUM 18:6" />看哪，我已经从<char style="pn">以色列</char>子孙中拣选了你的弟兄<char style="pn">利未</char>人，赏赐给你们，献于耶和华做会幕的服事工作。 <verse eid="NUM 18:6" /><verse number="7" style="v" sid="NUM 18:7" />你和你的儿子们要为祭坛和幔子内的一切事务，谨守祭司的职份，做好服事。我把祭司职份作为服事工作赏赐给你们，凡是接近的外人，都要被处死。”<verse eid="NUM 18:7" /></para>
  <para style="s">祭司和利未人的份例</para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 18:8" />耶和华又对<char style="pn">亚伦</char>说：“看哪，我已经把奉献供物的职责交给了你。至于<char style="pn">以色列</char>子孙所有的圣物，我把它们赐给你作受膏的份，也给你的儿子们作永远的份例。 <verse eid="NUM 18:8" /><verse number="9" style="v" sid="NUM 18:9" />人们带来献给我的至圣物，就是所有的祭物，包括所有的素祭、所有的赎罪祭、所有的赎愆祭，其中没有烧献的要归属你；这些是至圣的，归于你和你的子孙。 <verse eid="NUM 18:9" /><verse number="10" style="v" sid="NUM 18:10" />你要把它作为至圣物吃，只有男的才可以吃；你要把它当作神圣的。<verse eid="NUM 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 18:11" />“<char style="pn">以色列</char>子孙奉献的供物，就是他们所有的摇献祭物，也归于你；我把它们赐给你和与你一起的儿女们，作永远的份例，你家里所有洁净的人都可以吃。 <verse eid="NUM 18:11" /><verse number="12" style="v" sid="NUM 18:12" />所有最好的新油、最好的新酒，以及人们献给耶和华的初熟五谷，我也赐给你。 <verse eid="NUM 18:12" /><verse number="13" style="v" sid="NUM 18:13" />他们地里的一切初熟之物，就是他们带来献给耶和华的，都归属你。你家里所有洁净的人都可以吃。<verse eid="NUM 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 18:14" />“<char style="pn">以色列</char>中一切永献之物都归属你。 <verse eid="NUM 18:14" /><verse number="15" style="v" sid="NUM 18:15" />他们向耶和华献上的所有头胎的活物，无论是人还是牲畜，都归属你。只是你必须让他们把头生的人赎回，还有头生的不洁净牲畜，也要赎回。 <verse eid="NUM 18:15" /><verse number="16" style="v" sid="NUM 18:16" />出生一个月以后要赎回的，要照你所估的价，用五谢克尔银子赎回；按圣所的谢克尔<note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="ft" closed="false">谢克尔——重量单位；后来成为货币单位。1谢克尔=11.4公克。</char></note>标准，一谢克尔是二十季拉<note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="ft" closed="false">二十季拉——相当于11.4公克。1季拉=0.57公克。</char></note>。<verse eid="NUM 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 18:17" />“但是头生的公牛，或头生的绵羊，或头生的山羊，不可赎回；它们是圣物。你要把它们的血洒在祭坛上，把它们的脂肪烧献为火祭，作馨香之气献给耶和华。 <verse eid="NUM 18:17" /><verse number="18" style="v" sid="NUM 18:18" />它们的肉要归属你，就像摇献祭物的胸肉和右腿一样归属你。<verse eid="NUM 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 18:19" />“<char style="pn">以色列</char>子孙向耶和华奉上的一切神圣供物，我都赐给你和与你一起的儿女们，作永远的份例。这是你和与你一起的后裔在耶和华面前永远的盐约。”<verse eid="NUM 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 18:20" />耶和华对<char style="pn">亚伦</char>说：“你不可在<char style="pn">以色列</char>子孙的土地中分得继业，你在他们中间没有继业的份。在<char style="pn">以色列</char>子孙中，我就是你的份，你的产业。<verse eid="NUM 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 18:21" />“至于<char style="pn">利未</char>的子孙，看哪，我把<char style="pn">以色列</char>中所有出产的十分之一赐给了他们为产业，回报他们所做的会幕服事工作。 <verse eid="NUM 18:21" /><verse number="22" style="v" sid="NUM 18:22" /><char style="pn">以色列</char>子孙不可再靠近会幕，以免他们承担罪过而死。 <verse eid="NUM 18:22" /><verse number="23" style="v" sid="NUM 18:23" /><char style="pn">利未</char>人要做会幕的服事工作，他们要承担与圣所相关的罪责。这是你们世世代代永远的律例：他们不可在<char style="pn">以色列</char>子孙中分得继业。 <verse eid="NUM 18:23" /><verse number="24" style="v" sid="NUM 18:24" />因为我已经把<char style="pn">以色列</char>子孙的十分之一出产，就是他们向耶和华奉上的供物，赐给了<char style="pn">利未</char>人作产业。因此我对他们说，他们不可在<char style="pn">以色列</char>子孙中分得继业。”<verse eid="NUM 18:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 18:25" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 18:25" /><verse number="26" style="v" sid="NUM 18:26" />“你要吩咐<char style="pn">利未</char>人，对他们说：当你们从<char style="pn">以色列</char>子孙获得了我所赐给你们的那十分之一出产为产业，你们要再从那十分之一中奉上十分之一，作为献给耶和华的供物。 <verse eid="NUM 18:26" /><verse number="27" style="v" sid="NUM 18:27" />这算为你们奉献的供物，就像你们打谷场上的五谷，酒榨中满盈的酒一样。 <verse eid="NUM 18:27" /><verse number="28" style="v" sid="NUM 18:28" />这样，你们从<char style="pn">以色列</char>子孙获得的全部十分之一出产，也要从中奉上耶和华的供物，把这份献给耶和华的供物交给祭司<char style="pn">亚伦</char>。 <verse eid="NUM 18:28" /><verse number="29" style="v" sid="NUM 18:29" />你们要从你们的一切礼物中，从一切最好的、至圣的部分中，奉上耶和华的各样供物。<verse eid="NUM 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 18:30" />“你要对<char style="pn">利未</char>人说：‘当你们从其中把最好的奉献之后，其余的就算为<char style="pn">利未</char>人的，就像打谷场的收成和酒榨的收成。 <verse eid="NUM 18:30" /><verse number="31" style="v" sid="NUM 18:31" />你们和你们的家人可以在任何地方吃它，因为这是你们的酬报，以回报你们在会幕里的服事。 <verse eid="NUM 18:31" /><verse number="32" style="v" sid="NUM 18:32" />当你们把其中最好的奉献之后，你们就不会因它而承担罪过了；你们不可亵渎<char style="pn">以色列</char>子孙的圣物，免得你们死亡。”<verse eid="NUM 18:32" /></para>
  <chapter eid="NUM 18" />
  <chapter number="19" style="c" sid="NUM 19" />
  <para style="s">洁净礼</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 19:1" />耶和华指示<char style="pn">摩西</char>和<char style="pn">亚伦</char>说： <verse eid="NUM 19:1" /><verse number="2" style="v" sid="NUM 19:2" />“以下是耶和华所吩咐的律法条例：你要告诉<char style="pn">以色列</char>子民，把一头没有残疾、没有负过轭的无瑕疵红母牛带到你这里。 <verse eid="NUM 19:2" /><verse number="3" style="v" sid="NUM 19:3" />你们要把这牛交给祭司<char style="pn">以利亚撒</char>，然后领到营地外，在他面前宰杀了。 <verse eid="NUM 19:3" /><verse number="4" style="v" sid="NUM 19:4" />祭司<char style="pn">以利亚撒</char>要用手指蘸一些母牛的血，向着会幕前面弹洒七次。 <verse eid="NUM 19:4" /><verse number="5" style="v" sid="NUM 19:5" />然后这母牛要在他眼前被焚烧，皮、肉、血，连同粪便都要烧掉。 <verse eid="NUM 19:5" /><verse number="6" style="v" sid="NUM 19:6" />祭司要拿来香柏木、牛膝草和朱红色线，扔进焚烧母牛的火中。 <verse eid="NUM 19:6" /><verse number="7" style="v" sid="NUM 19:7" />祭司要洗衣服，用水洗身，之后才可以进入营地；祭司会不洁净直到傍晚。 <verse eid="NUM 19:7" /><verse number="8" style="v" sid="NUM 19:8" />那焚烧母牛的人，也要用水洗衣服，用水洗身；他会不洁净直到傍晚。<verse eid="NUM 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 19:9" />“要有一个洁净的人收取那母牛的灰烬，放置在营地外洁净的地方，为<char style="pn">以色列</char>会众保存下来，用于调制除污秽的水；这是除罪用的。 <verse eid="NUM 19:9" /><verse number="10" style="v" sid="NUM 19:10" />那收取母牛灰烬的人要洗衣服，他会不洁净直到傍晚。这要作为<char style="pn">以色列</char>子孙和寄居在他们中间的外人永远的律例。<verse eid="NUM 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 19:11" />“凡是触碰死尸的人，无论那是谁的尸体，他都会不洁净七天。 <verse eid="NUM 19:11" /><verse number="12" style="v" sid="NUM 19:12" />他要在第三天和第七天用那除污秽的水洁净自己，他就得洁净了；如果他在第三天和第七天不洁净自己，他就不得洁净。 <verse eid="NUM 19:12" /><verse number="13" style="v" sid="NUM 19:13" />凡是触碰死人尸体的，如果不洁净自己，他就玷污了耶和华的帐幕，这人必须从<char style="pn">以色列</char>中被剪除。因为那除污秽的水没有洒在他身上，他仍是不洁净的，他的污秽还在他身上。<verse eid="NUM 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 19:14" />“以下是有人死在帐篷里时的条例：所有进入那帐篷的人或已经在那帐篷里的人，都会不洁净七天。 <verse eid="NUM 19:14" /><verse number="15" style="v" sid="NUM 19:15" />帐篷里所有敞口的器皿，就是没有扣上盖子的，都会不洁净。 <verse eid="NUM 19:15" /><verse number="16" style="v" sid="NUM 19:16" />另外，任何人在田野上触碰被刀剑所杀的，或自然<note caller="+" style="f"><char style="fr" closed="false">19:16 </char><char style="ft" closed="false">自然——辅助词语。</char></note>死去的，或人的骨头，或坟墓，他也会不洁净七天。 <verse eid="NUM 19:16" /><verse number="17" style="v" sid="NUM 19:17" />他们要为不洁净的人取来那赎罪祭牲烧成的灰，放在器皿里，加上活水。 <verse eid="NUM 19:17" /><verse number="18" style="v" sid="NUM 19:18" />要有一个洁净的人拿牛膝草蘸那水，洒在帐篷上、所有器具上以及帐篷里的人身上，也洒在那触碰了人骨头的，或触碰被杀的、自然<note caller="+" style="f"><char style="fr" closed="false">19:18 </char><char style="ft" closed="false">自然——辅助词语。</char></note>死的，或触碰坟墓的人身上。<verse eid="NUM 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 19:19" />“洁净的人要在第三天和第七天把那水洒在不洁净的人身上，这样就使他在第七天得洁净；他要洗衣服，用水洗身，到傍晚就洁净了。 <verse eid="NUM 19:19" /><verse number="20" style="v" sid="NUM 19:20" />凡是不洁净的人，如果没有洁净自己，这人就要从会众当中被剪除，因为他玷污了耶和华的圣所；那除污秽的水没有洒在他身上，他就是不洁净的。 <verse eid="NUM 19:20" /><verse number="21" style="v" sid="NUM 19:21" />这要作为他们永远的律例。洒这除污秽之水的人，要洗自己的衣服；凡是触碰除污秽之水的人，都会不洁净直到傍晚。 <verse eid="NUM 19:21" /><verse number="22" style="v" sid="NUM 19:22" />那不洁净的人碰过的任何东西都不洁净，触碰那些东西的人也会不洁净直到傍晚。”<verse eid="NUM 19:22" /></para>
  <chapter eid="NUM 19" />
  <chapter number="20" style="c" sid="NUM 20" />
  <para style="s">岩石出水</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 20:1" />一月的时候，<char style="pn">以色列</char>全体会众来到<char style="pn">寻</char>的旷野，民众就住在<char style="pn">加低斯</char>。<char style="pn">米利暗</char>死在那里，也葬在那里。<verse eid="NUM 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 20:2" />那时，会众没有水了，就聚集起来对抗<char style="pn">摩西</char>和<char style="pn">亚伦</char>。 <verse eid="NUM 20:2" /><verse number="3" style="v" sid="NUM 20:3" />民众向<char style="pn">摩西</char>争闹，开口说：“我们的兄弟在耶和华面前丧命时，还不如让我们也死了！ <verse eid="NUM 20:3" /><verse number="4" style="v" sid="NUM 20:4" />你们为什么把耶和华的会众领到这旷野，使我们和我们的牲畜死在这里呢？ <verse eid="NUM 20:4" /><verse number="5" style="v" sid="NUM 20:5" />为什么把我们从<char style="pn">埃及</char>带上来，领我们到这样恶劣的地方呢？这里没有撒种的地方，没有无花果树、葡萄树、石榴树，也没有水喝。”<verse eid="NUM 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 20:6" />
    <char style="pn">摩西</char>和<char style="pn">亚伦</char>就从会众面前来到会幕的入口，脸伏于地。耶和华的荣耀向他们显现， <verse eid="NUM 20:6" /><verse number="7" style="v" sid="NUM 20:7" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 20:7" /><verse number="8" style="v" sid="NUM 20:8" />“你把那根杖取来，然后你和你哥哥<char style="pn">亚伦</char>招聚会众，在他们眼前吩咐岩石流出水来。这样，你就使水从岩石中流出来，给会众和他们的牲畜喝。”<verse eid="NUM 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 20:9" />于是，<char style="pn">摩西</char>照着耶和华指示他的，从耶和华面前取来那根杖。 <verse eid="NUM 20:9" /><verse number="10" style="v" sid="NUM 20:10" /><char style="pn">摩西</char>和<char style="pn">亚伦</char>招聚会众到岩石前面，对他们说：“悖逆的人哪，你们听着！难道我们必须使这岩石给你们流出水吗？” <verse eid="NUM 20:10" /><verse number="11" style="v" sid="NUM 20:11" /><char style="pn">摩西</char>举起手，用他的杖击打岩石两次，就有大量的水流出来，会众和他们的牲畜都喝了。<verse eid="NUM 20:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 20:12" />然而，耶和华对<char style="pn">摩西</char>和<char style="pn">亚伦</char>说：“由于你们没有信我，没有在<char style="pn">以色列</char>子民眼前尊我为圣，因此你们不能带领这会众进入我赐给他们的那地。” <verse eid="NUM 20:12" /><verse number="13" style="v" sid="NUM 20:13" />这就是“<char style="pn">米利巴</char>水”，因<char style="pn">以色列</char>子民向耶和华争闹，耶和华就在他们中间显为圣。<verse eid="NUM 20:13" /></para>
  <para style="s">以东拒绝以色列过境</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 20:14" />
    <char style="pn">摩西</char>从<char style="pn">加低斯</char>派遣使者去见<char style="pn">以东</char>王，说：“你的兄弟<char style="pn">以色列</char>如此说：你知道我们所遭遇的一切艰难。 <verse eid="NUM 20:14" /><verse number="15" style="v" sid="NUM 20:15" />我们的祖先下到<char style="pn">埃及</char>，我们在<char style="pn">埃及</char>住了许多日子，<char style="pn">埃及</char>人恶待我们和我们的祖先。 <verse eid="NUM 20:15" /><verse number="16" style="v" sid="NUM 20:16" />我们向耶和华呼求，他垂听了我们的呼声，派遣一位使者把我们从<char style="pn">埃及</char>带了出来。现在，我们到了你边境的<char style="pn">加低斯</char>城。 <verse eid="NUM 20:16" /><verse number="17" style="v" sid="NUM 20:17" />请让我们从你境内经过；我们不会进入田间或葡萄园，也不喝井里的水。我们只走大道，不偏左右，直到我们过了你的地界。”<verse eid="NUM 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 20:18" />
    <char style="pn">以东</char>却答复说：“你不可从我这里经过，否则我会带着刀剑出来迎击你。”<verse eid="NUM 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 20:19" />
    <char style="pn">以色列</char>人对他说：“我们只从大道上过去；如果我们和我们的牲畜喝了你的水，我们会付水钱。我们没有别的要求，只愿让我们徒步经过！”<verse eid="NUM 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 20:20" />但他回答：“你们不可经过。”<char style="pn">以东</char>就带着大军，强势出来迎击<char style="pn">以色列</char>。 <verse eid="NUM 20:20" /><verse number="21" style="v" sid="NUM 20:21" /><char style="pn">以东</char>拒绝让<char style="pn">以色列</char>经过他的境内，于是<char style="pn">以色列</char>转身离开了他。<verse eid="NUM 20:21" /></para>
  <para style="s">亚伦去世</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 20:22" />
    <char style="pn">以色列</char>全体会众从<char style="pn">加低斯</char>起行，来到了<char style="pn">何珥</char>山。 <verse eid="NUM 20:22" /><verse number="23" style="v" sid="NUM 20:23" />在<char style="pn">以东</char>地边界的<char style="pn">何珥</char>山，耶和华对<char style="pn">摩西</char>和<char style="pn">亚伦</char>说： <verse eid="NUM 20:23" /><verse number="24" style="v" sid="NUM 20:24" />“<char style="pn">亚伦</char>要归到他的先人那里了。他不得进入我赐给<char style="pn">以色列</char>子孙的那地，因为你们在<char style="pn">米利巴</char>水边违背了我的命令。 <verse eid="NUM 20:24" /><verse number="25" style="v" sid="NUM 20:25" />你要带来<char style="pn">亚伦</char>和他的儿子<char style="pn">以利亚撒</char>，把他们带到<char style="pn">何珥</char>山上。 <verse eid="NUM 20:25" /><verse number="26" style="v" sid="NUM 20:26" />你要脱下<char style="pn">亚伦</char>的圣衣，给他的儿子<char style="pn">以利亚撒</char>穿上。然后，<char style="pn">亚伦</char>会归到先人那里，死在山上。”<verse eid="NUM 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 20:27" />
    <char style="pn">摩西</char>就照着耶和华所指示的去做，他们在全体会众眼前上了<char style="pn">何珥</char>山。 <verse eid="NUM 20:27" /><verse number="28" style="v" sid="NUM 20:28" /><char style="pn">摩西</char>脱下<char style="pn">亚伦</char>的圣衣，给他的儿子<char style="pn">以利亚撒</char>穿上，<char style="pn">亚伦</char>就死在山顶上。随后，<char style="pn">摩西</char>和<char style="pn">以利亚撒</char>从山上下来。 <verse eid="NUM 20:28" /><verse number="29" style="v" sid="NUM 20:29" />全体会众看到<char style="pn">亚伦</char>去世了，<char style="pn">以色列</char>全家就为<char style="pn">亚伦</char>哀哭三十天。<verse eid="NUM 20:29" /></para>
  <chapter eid="NUM 20" />
  <chapter number="21" style="c" sid="NUM 21" />
  <para style="s">击败迦南王</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 21:1" />
    <char style="pn">迦南</char>的<char style="pn">阿拉德</char>王住在南地<note caller="+" style="f"><char style="fr" closed="false">21:1 </char><char style="ft" closed="false">南地——音译作“内盖夫”。</char></note>，听说<char style="pn">以色列</char>沿着通往<char style="pn">阿塔林</char>的路来了，就攻打<char style="pn">以色列</char>，俘虏了他们一些人。 <verse eid="NUM 21:1" /><verse number="2" style="v" sid="NUM 21:2" /><char style="pn">以色列</char>向耶和华许愿说：“如果你把这民确实交在我手中，我就把他们的城镇都毁灭净尽。” <verse eid="NUM 21:2" /><verse number="3" style="v" sid="NUM 21:3" />耶和华垂听了<char style="pn">以色列</char>的祈求，交出<char style="pn">迦南</char>人。<char style="pn">以色列</char>人把他们和他们的城镇都毁灭净尽，那地方就被起名为“<char style="pn">霍尔玛</char>”。<verse eid="NUM 21:3" /></para>
  <para style="s">举起铜蛇</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 21:4" />他们离开<char style="pn">何珥</char>山，沿着通往<char style="pn">红海</char>的路前行，要绕过<char style="pn">以东</char>地，民众在路上失去耐心。 <verse eid="NUM 21:4" /><verse number="5" style="v" sid="NUM 21:5" />民众攻击神和<char style="pn">摩西</char>说：“你们为什么把我们从<char style="pn">埃及</char>带上来，使我们死在旷野呢？这里既没有食物，也没有水，我们的心也厌烦了这淡而无味的食物！” <verse eid="NUM 21:5" /><verse number="6" style="v" sid="NUM 21:6" />于是耶和华派出毒蛇<note caller="+" style="f"><char style="fr" closed="false">21:6 </char><char style="ft" closed="false">毒蛇——或译作“火蛇”；本章下同。</char></note>到民众当中咬他们，<char style="pn">以色列</char>死了许多人。<verse eid="NUM 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 21:7" />民众来见<char style="pn">摩西</char>，说：“我们犯罪了，我们攻击了耶和华和你。求你向耶和华祷告，让蛇离开我们。”于是<char style="pn">摩西</char>就为民众祷告。<verse eid="NUM 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 21:8" />耶和华对<char style="pn">摩西</char>说：“你要铸造一条毒蛇，挂在旗杆上。凡是被咬的人，一看见它就能存活。” <verse eid="NUM 21:8" /><verse number="9" style="v" sid="NUM 21:9" /><char style="pn">摩西</char>就铸造了一条铜蛇，挂在旗杆上。凡是被蛇咬了的人，只要仰望那铜蛇，就得以存活。<verse eid="NUM 21:9" /></para>
  <para style="s">绕行摩押地界</para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 21:10" />
    <char style="pn">以色列</char>子民起行，扎营在<char style="pn">奥伯特</char>。 <verse eid="NUM 21:10" /><verse number="11" style="v" sid="NUM 21:11" />又从<char style="pn">奥伯特</char>起行，扎营在<char style="pn">伊耶-亚巴琳</char>，就在<char style="pn">摩押</char>东面的旷野。 <verse eid="NUM 21:11" /><verse number="12" style="v" sid="NUM 21:12" />又从那里起行，扎营在<char style="pn">撒烈</char>溪谷。 <verse eid="NUM 21:12" /><verse number="13" style="v" sid="NUM 21:13" />又从那里起行，扎营在<char style="pn">亚嫩</char>河对岸。这条河在旷野中，从<char style="pn">亚摩利</char>人的边界流出来；<char style="pn">亚嫩</char>河就是<char style="pn">摩押</char>的边界，位于<char style="pn">摩押</char>和<char style="pn">亚摩利</char>之间。 <verse eid="NUM 21:13" /><verse number="14" style="v" sid="NUM 21:14" />因此在《耶和华战记》上说：</para>
  <para style="q1" vid="NUM 21:14">“<char style="pn">苏法</char>的<char style="pn">哇哈伯</char>，<char style="pn">亚嫩</char>河的溪谷，<verse eid="NUM 21:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NUM 21:15" />以及往<char style="pn">亚珥</char>居住地延伸的溪谷斜坡，</para>
  <para style="q1" vid="NUM 21:15">都紧靠<char style="pn">摩押</char>的边界。”<verse eid="NUM 21:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="NUM 21:16" />他们从那里来到<char style="pn">比尔</char>，就是在这井旁，耶和华曾对<char style="pn">摩西</char>说：“招聚民众来，我要赐给他们水。” <verse eid="NUM 21:16" /><verse number="17" style="v" sid="NUM 21:17" />那时<char style="pn">以色列</char>唱了这首歌：</para>
  <para style="q1" vid="NUM 21:17">“井啊，涌上水来！</para>
  <para style="q1" vid="NUM 21:17">你们要为这井歌唱。<verse eid="NUM 21:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 21:18" />这井是首领们所挖的，</para>
  <para style="q1" vid="NUM 21:18">是民中的贵族用权杖、用手杖开凿的。”</para>
  <para style="b" vid="NUM 21:18" />
  <para style="p" vid="NUM 21:18">然后，他们从旷野来到<char style="pn">玛塔纳</char>。 <verse eid="NUM 21:18" /><verse number="19" style="v" sid="NUM 21:19" />又从<char style="pn">玛塔纳</char>到<char style="pn">拿哈列</char>，从<char style="pn">拿哈列</char>到<char style="pn">巴末</char>， <verse eid="NUM 21:19" /><verse number="20" style="v" sid="NUM 21:20" />从<char style="pn">巴末</char>到<char style="pn">摩押</char>境内的山谷，在那里的<char style="pn">毗斯迦</char>山顶可以俯看荒漠。<verse eid="NUM 21:20" /></para>
  <para style="s">击败亚摩利王</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 21:21" />
    <char style="pn">以色列</char>派使者去见<char style="pn">亚摩利</char>王<char style="pn">西宏</char>，说： <verse eid="NUM 21:21" /><verse number="22" style="v" sid="NUM 21:22" />“请让我们从你境内经过，我们不进入田间和葡萄园，也不喝井里的水。我们只走大道，直到过了你的地界。” <verse eid="NUM 21:22" /><verse number="23" style="v" sid="NUM 21:23" />但<char style="pn">西宏</char>不允许<char style="pn">以色列</char>经过他的境内。<char style="pn">西宏</char>招聚他的全军，出来在旷野迎击<char style="pn">以色列</char>。他来到<char style="pn">雅哈兹</char>，与<char style="pn">以色列</char>交战。 <verse eid="NUM 21:23" /><verse number="24" style="v" sid="NUM 21:24" /><char style="pn">以色列</char>用刀击杀他，占有了他的领土，从<char style="pn">亚嫩</char>河到<char style="pn">雅博</char>河，直到<char style="pn">亚扪</char>人那里，因为<char style="pn">亚扪</char>人的边防稳固。<verse eid="NUM 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 21:25" />
    <char style="pn">以色列</char>夺取了那些城，就住在<char style="pn">亚摩利</char>人的所有城镇，包括<char style="pn">希实本</char>和它的所有村镇。 <verse eid="NUM 21:25" /><verse number="26" style="v" sid="NUM 21:26" /><char style="pn">希实本</char>是<char style="pn">亚摩利</char>王<char style="pn">西宏</char>的都城，<char style="pn">西宏</char>曾与<char style="pn">摩押</char>先前的王交战，从他手中夺取了他的全地，直到<char style="pn">亚嫩</char>河， <verse eid="NUM 21:26" /><verse number="27" style="v" sid="NUM 21:27" />因此那些唱歌谣的人说：</para>
  <para style="q1" vid="NUM 21:27">“来<char style="pn">希实本</char>吧！</para>
  <para style="q1" vid="NUM 21:27">愿<char style="pn">西宏</char>的城被建造，得坚立！<verse eid="NUM 21:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="NUM 21:28" />有火从<char style="pn">希实本</char>出来，</para>
  <para style="q1" vid="NUM 21:28">有火焰从<char style="pn">西宏</char>的城发出，</para>
  <para style="q1" vid="NUM 21:28">吞噬了<char style="pn">摩押</char>的<char style="pn">亚珥</char>，</para>
  <para style="q1" vid="NUM 21:28">以及<char style="pn">亚嫩</char>河的高坛之主。<verse eid="NUM 21:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="NUM 21:29" />
    <char style="pn">摩押</char>啊，你有祸了！</para>
  <para style="q1" vid="NUM 21:29">
    <char style="pn">基抹</char>的民哪，你们灭亡了！</para>
  <para style="q1" vid="NUM 21:29">
    <char style="pn">基抹</char>任凭自己的儿子逃亡，</para>
  <para style="q1" vid="NUM 21:29">任凭女儿被<char style="pn">亚摩利</char>王<char style="pn">西宏</char>掳去。<verse eid="NUM 21:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="NUM 21:30" />我们射杀了他们，</para>
  <para style="q1" vid="NUM 21:30">
    <char style="pn">希实本</char>灭亡了，直到<char style="pn">迪本</char>；</para>
  <para style="q1" vid="NUM 21:30">我们使它荒凉，</para>
  <para style="q1" vid="NUM 21:30">直到<char style="pn">挪法</char>，直到<char style="pn">米底巴</char>。”<verse eid="NUM 21:30" /></para>
  <para style="b" />
  <para style="p">
    <verse number="31" style="v" sid="NUM 21:31" />这样，<char style="pn">以色列</char>就住在<char style="pn">亚摩利</char>人之地。 <verse eid="NUM 21:31" /><verse number="32" style="v" sid="NUM 21:32" /><char style="pn">摩西</char>又派人去窥探<char style="pn">雅谢</char>，随后攻取<char style="pn">雅谢</char>的村镇，赶出了那里的<char style="pn">亚摩利</char>人。<verse eid="NUM 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 21:33" />然后他们转身，沿着通往<char style="pn">巴珊</char>的路上去。<char style="pn">巴珊</char>王<char style="pn">欧革</char>带着他的全军出来迎战他们，在<char style="pn">伊德赖</char>作战。 <verse eid="NUM 21:33" /><verse number="34" style="v" sid="NUM 21:34" />耶和华对<char style="pn">摩西</char>说：“不要怕他，我已经把他和他的全军以及他的领土，都交在你手中了。你要像对待住<char style="pn">希实本</char>的<char style="pn">亚摩利</char>王<char style="pn">西宏</char>那样对待他。” <verse eid="NUM 21:34" /><verse number="35" style="v" sid="NUM 21:35" />于是他们击杀了<char style="pn">欧革</char>和他的儿子们以及他的全军，没有给他留下一人存活，并且占有了他的领土。<verse eid="NUM 21:35" /></para>
  <chapter eid="NUM 21" />
  <chapter number="22" style="c" sid="NUM 22" />
  <para style="s">巴勒雇佣巴兰</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 22:1" />
    <char style="pn">以色列</char>子民起行，在<char style="pn">耶利哥</char>东边<char style="pn">约旦</char>河对面的<char style="pn">摩押</char>平原扎营。 <verse eid="NUM 22:1" /><verse number="2" style="v" sid="NUM 22:2" /><char style="pn">以色列</char>对<char style="pn">亚摩利</char>人所做的一切，<char style="pn">西拨</char>的儿子<char style="pn">巴勒</char>都看到了。 <verse eid="NUM 22:2" /><verse number="3" style="v" sid="NUM 22:3" /><char style="pn">摩押</char>就非常惧怕这民，因为他们人数众多。<char style="pn">摩押</char>因<char style="pn">以色列</char>人的缘故而忧心， <verse eid="NUM 22:3" /><verse number="4" style="v" sid="NUM 22:4" />对<char style="pn">米甸</char>的长老们说：“恐怕这部族要吃光我们周围的一切，就像牛吃光田野的青草一样。”</para>
  <para style="p" vid="NUM 22:4">那时，<char style="pn">西拨</char>的儿子<char style="pn">巴勒</char>是<char style="pn">摩押</char>王。 <verse eid="NUM 22:4" /><verse number="5" style="v" sid="NUM 22:5" />他就派遣使者到他本族人之地大河<note caller="+" style="f"><char style="fr" closed="false">22:5 </char><char style="ft" closed="false">大河——指幼发拉底河。</char></note>边的<char style="pn">佩托尔</char>，去见<char style="pn">比珥</char>的儿子<char style="pn">巴兰</char>，要召他来，说：“你看，有一个民族从<char style="pn">埃及</char>出来，他们遮满了地面，在我对面驻扎。 <verse eid="NUM 22:5" /><verse number="6" style="v" sid="NUM 22:6" />现在请你来，为我诅咒这民族，因为他们比我强大。这样，或许我能够击败他们，把他们从这地驱逐出去。因为我知道，你祝福的人必受祝福，你诅咒的人必受诅咒。”<verse eid="NUM 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 22:7" />
    <char style="pn">摩押</char>的长老们和<char style="pn">米甸</char>的长老们，手里带着占卜的酬金就去了。他们来见<char style="pn">巴兰</char>，将<char style="pn">巴勒</char>的话告诉了他。 <verse eid="NUM 22:7" /><verse number="8" style="v" sid="NUM 22:8" /><char style="pn">巴兰</char>对他们说：“你们今晚在这里过夜吧。我将照着耶和华吩咐我的，回复你们。”于是<char style="pn">摩押</char>的首领们就住在<char style="pn">巴兰</char>那里。<verse eid="NUM 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 22:9" />神临到<char style="pn">巴兰</char>，说：“那些在你这里的人是谁？”<verse eid="NUM 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 22:10" />
    <char style="pn">巴兰</char>对神说：“<char style="pn">西拨</char>的儿子<char style="pn">摩押</char>王<char style="pn">巴勒</char>派了人到我这里来，说： <verse eid="NUM 22:10" /><verse number="11" style="v" sid="NUM 22:11" />‘你看，有一个民族从<char style="pn">埃及</char>出来，遮满了地面。现在请你来，为我诅咒他们，或许我能击败他们，驱逐他们。’”<verse eid="NUM 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 22:12" />神对<char style="pn">巴兰</char>说：“你不可跟着他们去，不可诅咒那民族，因为他们是蒙祝福的。”<verse eid="NUM 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 22:13" />
    <char style="pn">巴兰</char>清晨起来，对<char style="pn">巴勒</char>的首领们说：“你们回本地去吧，因为耶和华不允许我跟着你们去。”<verse eid="NUM 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 22:14" />
    <char style="pn">摩押</char>的首领们就起身，回到<char style="pn">巴勒</char>那里，说：“<char style="pn">巴兰</char>不愿跟着我们来。”<verse eid="NUM 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 22:15" />于是，<char style="pn">巴勒</char>再次派遣一批首领，比先前的更多更尊贵。 <verse eid="NUM 22:15" /><verse number="16" style="v" sid="NUM 22:16" />他们来到<char style="pn">巴兰</char>那里，对他说：“<char style="pn">西拨</char>的儿子<char style="pn">巴勒</char>如此说：请不要推辞来我这里， <verse eid="NUM 22:16" /><verse number="17" style="v" sid="NUM 22:17" />我一定使你大得尊荣。无论你告诉我什么，我都会照办。来吧，请为我诅咒这民族。”<verse eid="NUM 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 22:18" />
    <char style="pn">巴兰</char>回答<char style="pn">巴勒</char>的臣仆，说：“即使<char style="pn">巴勒</char>把他满屋的金银都给我，我也不能违背我的神耶和华的吩咐，无论做小事还是大事。 <verse eid="NUM 22:18" /><verse number="19" style="v" sid="NUM 22:19" />所以，请你们今晚也住在这里吧，我要知道耶和华还会对我说什么。”<verse eid="NUM 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 22:20" />夜间，神临到<char style="pn">巴兰</char>对他说：“既然这些人来邀请你，你就起来跟着他们去吧，只是你要做我吩咐你的事。” <verse eid="NUM 22:20" /><verse number="21" style="v" sid="NUM 22:21" />于是<char style="pn">巴兰</char>清晨起来，备好驴，跟着<char style="pn">摩押</char>的首领们去了。<verse eid="NUM 22:21" /></para>
  <para style="s">天使和巴兰的驴子</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 22:22" />因<char style="pn">巴兰</char>前往，神就怒气发作。耶和华的一位使者站在路上敌对他。当时，<char style="pn">巴兰</char>骑在驴上，他的两个仆人跟随着他。 <verse eid="NUM 22:22" /><verse number="23" style="v" sid="NUM 22:23" />驴看见耶和华的使者站在路上，手里有拔出的刀，驴就转离那条路，走到田野中。<char style="pn">巴兰</char>打驴，要使它转回那条路。 <verse eid="NUM 22:23" /><verse number="24" style="v" sid="NUM 22:24" />于是，耶和华的使者站在葡萄园之间的窄路上，这边有围墙，那边也有围墙。 <verse eid="NUM 22:24" /><verse number="25" style="v" sid="NUM 22:25" />驴看见耶和华的使者，就挤到墙边，把<char style="pn">巴兰</char>的脚也挤到墙边上，<char style="pn">巴兰</char>就又打它。 <verse eid="NUM 22:25" /><verse number="26" style="v" sid="NUM 22:26" />耶和华的使者再上前去，站到左右都无路可转的狭窄地方。 <verse eid="NUM 22:26" /><verse number="27" style="v" sid="NUM 22:27" />驴看见耶和华的使者，就趴在<char style="pn">巴兰</char>身下。<char style="pn">巴兰</char>怒气发作，用杖打驴。<verse eid="NUM 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 22:28" />于是耶和华开了驴的口，驴对<char style="pn">巴兰</char>说：“我对你做了什么，你竟打我这三次？”<verse eid="NUM 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 22:29" />
    <char style="pn">巴兰</char>对驴说：“因为你捉弄我！要是我手里有刀，我现在就宰了你。”<verse eid="NUM 22:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 22:30" />驴对<char style="pn">巴兰</char>说：“我不就是你至今一直在骑的那头驴吗？我往常对你这样做过吗？”</para>
  <para style="p" vid="NUM 22:30">
    <char style="pn">巴兰</char>说：“没有。”<verse eid="NUM 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 22:31" />耶和华打开<char style="pn">巴兰</char>的眼睛，他看见耶和华的使者站在路上，手里拿着拔出的刀，他就俯身，脸伏于地。 <verse eid="NUM 22:31" /><verse number="32" style="v" sid="NUM 22:32" />耶和华的使者对他说：“你为什么这三次打你的驴呢？看哪，我出来敌对你，因为这条路在我面前是邪僻的。 <verse eid="NUM 22:32" /><verse number="33" style="v" sid="NUM 22:33" />驴看见我，所以从我面前转开了这三次。如果它不从我面前转开，我早已经把你杀了，只让它存活。”<verse eid="NUM 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 22:34" />
    <char style="pn">巴兰</char>对耶和华的使者说：“我有罪了！我实在不知道你站在路上阻挡我。现在如果你不喜悦，我就回去吧。”<verse eid="NUM 22:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 22:35" />耶和华的使者对<char style="pn">巴兰</char>说：“你跟着这些人去吧，但只可以说我吩咐你的话。”于是<char style="pn">巴兰</char>就跟着<char style="pn">巴勒</char>的首领们去了。<verse eid="NUM 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 22:36" />
    <char style="pn">巴勒</char>听见<char style="pn">巴兰</char>来了就出去，到<char style="pn">摩押</char>的都城迎接他，这城在<char style="pn">亚嫩</char>河的边界，在边界线上。 <verse eid="NUM 22:36" /><verse number="37" style="v" sid="NUM 22:37" /><char style="pn">巴勒</char>对<char style="pn">巴兰</char>说：“我不是迫切派人去召你来吗？你为什么不来我这里呢？难道我不会真的使你得尊荣吗？”<verse eid="NUM 22:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 22:38" />
    <char style="pn">巴兰</char>对<char style="pn">巴勒</char>说：“看，我已经来到你这里了。难道现在我就能擅自说什么吗？神把什么话放在我口中，我就说什么。”<verse eid="NUM 22:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 22:39" />于是<char style="pn">巴兰</char>跟着<char style="pn">巴勒</char>去，来到了<char style="pn">基列-胡佐</char>。 <verse eid="NUM 22:39" /><verse number="40" style="v" sid="NUM 22:40" /><char style="pn">巴勒</char>祭献了牛羊，然后把肉送给<char style="pn">巴兰</char>以及与他一起的首领们。 <verse eid="NUM 22:40" /><verse number="41" style="v" sid="NUM 22:41" />到了清晨，<char style="pn">巴勒</char>带<char style="pn">巴兰</char>登上<char style="pn">巴力</char>高原，从那里可以看到<char style="pn">以色列</char>民营地的边缘。<verse eid="NUM 22:41" /></para>
  <chapter eid="NUM 22" />
  <chapter number="23" style="c" sid="NUM 23" />
  <para style="s">巴兰领受神谕</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 23:1" />
    <char style="pn">巴兰</char>对<char style="pn">巴勒</char>说：“请在这里为我筑七座祭坛，并在这里为我预备七头公牛、七只公绵羊。” <verse eid="NUM 23:1" /><verse number="2" style="v" sid="NUM 23:2" /><char style="pn">巴勒</char>就照着<char style="pn">巴兰</char>所说的做了。<char style="pn">巴勒</char>和<char style="pn">巴兰</char>在每座祭坛上献一头公牛、一只公绵羊。 <verse eid="NUM 23:2" /><verse number="3" style="v" sid="NUM 23:3" /><char style="pn">巴兰</char>对<char style="pn">巴勒</char>说：“你站在你的燔祭旁边，我要往前去，或许耶和华会临到，接见我。他指示我什么信息，我都会告诉你。”然后，<char style="pn">巴兰</char>走到一片光秃的高地。<verse eid="NUM 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 23:4" />神临到<char style="pn">巴兰</char>，<char style="pn">巴兰</char>对神说：“我预备了七座祭坛，在每座祭坛上献了一头公牛、一只公绵羊。” <verse eid="NUM 23:4" /><verse number="5" style="v" sid="NUM 23:5" />耶和华就把话放在<char style="pn">巴兰</char>的口中，说：“你回<char style="pn">巴勒</char>那里去，要如此如此说。”<verse eid="NUM 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 23:6" />他回到<char style="pn">巴勒</char>那里，看哪，<char style="pn">巴勒</char>和<char style="pn">摩押</char>全体首领都站在燔祭旁边。<verse eid="NUM 23:6" /></para>
  <para style="s">第一个神谕</para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 23:7" />
    <char style="pn">巴兰</char>发布谕示，说：</para>
  <para style="q1" vid="NUM 23:7">“<char style="pn">巴勒</char>请我从<char style="pn">亚兰</char>来，</para>
  <para style="q1" vid="NUM 23:7">
    <char style="pn">摩押</char>王请我出东山，他说：</para>
  <para style="q1" vid="NUM 23:7">‘来吧，为我诅咒<char style="pn">雅各</char>；</para>
  <para style="q1" vid="NUM 23:7">来吧，向<char style="pn">以色列</char>宣判！’<verse eid="NUM 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 23:8" />神没有诅咒的，我怎么能诅咒？</para>
  <para style="q1" vid="NUM 23:8">耶和华没有宣判，我怎么能宣判？<verse eid="NUM 23:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 23:9" />我从岩壁的顶峰观望他，</para>
  <para style="q1" vid="NUM 23:9">从山岗上注视他</para>
  <para style="q1" vid="NUM 23:9">——看，这独居的民族，</para>
  <para style="q1" vid="NUM 23:9">不把自己算在列国之中。<verse eid="NUM 23:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NUM 23:10" />谁能数点<char style="pn">雅各</char>的尘沙，</para>
  <para style="q1" vid="NUM 23:10">谁能数算<char style="pn">以色列</char>的烟尘<note caller="+" style="f"><char style="fr" closed="false">23:10 </char><char style="ft" closed="false">烟尘——或译作“四分之一”。</char></note>？</para>
  <para style="q1" vid="NUM 23:10">愿我死如正直人的死，</para>
  <para style="q1" vid="NUM 23:10">愿我的结局像他一样。”<verse eid="NUM 23:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="NUM 23:11" />
    <char style="pn">巴勒</char>对<char style="pn">巴兰</char>说：“你对我做了什么事！我带你来诅咒我的仇敌，看哪，你却大大祝福他们。”<verse eid="NUM 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 23:12" />
    <char style="pn">巴兰</char>回答说：“耶和华放在我口中的话，我怎么能不忠实传讲呢？”<verse eid="NUM 23:12" /></para>
  <para style="s">第二个神谕</para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 23:13" />
    <char style="pn">巴勒</char>对<char style="pn">巴兰</char>说：“来吧，请与我一起到另外一个地方，你可以从那里看到那民族；只会看到他们营地的边缘，不能看见全部。请在那里为我诅咒他们。” <verse eid="NUM 23:13" /><verse number="14" style="v" sid="NUM 23:14" />于是<char style="pn">巴勒</char>带<char style="pn">巴兰</char>到<char style="pn">琐腓</char>野外，<char style="pn">毗斯迦</char>山顶上<note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">琐腓野外，毗斯迦山顶上——或译作“毗斯迦山顶的守望台”。</char></note>。<char style="pn">巴勒</char>筑了七座祭坛，在每座祭坛上献一头公牛、一只公绵羊。<verse eid="NUM 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 23:15" />
    <char style="pn">巴兰</char>对<char style="pn">巴勒</char>说：“你站在你的燔祭旁边，我要到那边受接见。”<verse eid="NUM 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 23:16" />耶和华接见<char style="pn">巴兰</char>，把话语放在他口中，说：“你回<char style="pn">巴勒</char>那里去，要如此如此说。”<verse eid="NUM 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 23:17" />
    <char style="pn">巴兰</char>回到<char style="pn">巴勒</char>那里，看哪，<char style="pn">巴勒</char>站在燔祭旁边，<char style="pn">摩押</char>的首领们也与他在一起。<char style="pn">巴勒</char>问他：“耶和华说了什么？”<verse eid="NUM 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 23:18" />
    <char style="pn">巴兰</char>发布谕示，说：</para>
  <para style="q1" vid="NUM 23:18">“<char style="pn">巴勒</char>啊，你起来听着；</para>
  <para style="q1" vid="NUM 23:18">
    <char style="pn">西拨</char>的儿子啊，听我说！<verse eid="NUM 23:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 23:19" />神不是会说谎的人，</para>
  <para style="q1" vid="NUM 23:19">也不是会后悔的人类。</para>
  <para style="q1" vid="NUM 23:19">难道他说了会不做吗？</para>
  <para style="q1" vid="NUM 23:19">他发话了，会不成就吗？<verse eid="NUM 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="NUM 23:20" />看哪，我奉命祝福；</para>
  <para style="q1" vid="NUM 23:20">神已经祝福了，</para>
  <para style="q1" vid="NUM 23:20">我不能翻转。<verse eid="NUM 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="NUM 23:21" />神使<char style="pn">雅各</char>中看不到祸患，</para>
  <para style="q1" vid="NUM 23:21">使<char style="pn">以色列</char>中看不见苦难。</para>
  <para style="q1" vid="NUM 23:21">他的神耶和华与他同在，</para>
  <para style="q1" vid="NUM 23:21">欢呼君王的声音在他们中间。<verse eid="NUM 23:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 23:22" />神把他们从<char style="pn">埃及</char>领出来，</para>
  <para style="q1" vid="NUM 23:22">像野牛的角为他们争战<note caller="+" style="f"><char style="fr" closed="false">23:22 </char><char style="ft" closed="false">争战——辅助词语。</char></note>。<verse eid="NUM 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="NUM 23:23" />实在没有法术对付<char style="pn">雅各</char>，</para>
  <para style="q1" vid="NUM 23:23">也没有占卜对付<char style="pn">以色列</char>，</para>
  <para style="q1" vid="NUM 23:23">每当论到<char style="pn">雅各</char>，</para>
  <para style="q1" vid="NUM 23:23">论到<char style="pn">以色列</char>，人都会说：</para>
  <para style="q1" vid="NUM 23:23">‘神成就了何等的事啊！’<verse eid="NUM 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 23:24" />看，这民族起来如母狮，</para>
  <para style="q1" vid="NUM 23:24">挺身像公狮。</para>
  <para style="q1" vid="NUM 23:24">它不吞吃猎物，不喝被杀之人的血，</para>
  <para style="q1" vid="NUM 23:24">就绝不躺下。”<verse eid="NUM 23:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="NUM 23:25" />
    <char style="pn">巴勒</char>对<char style="pn">巴兰</char>说：“既然你一点也不诅咒他们，那就一点也不要祝福他们。”<verse eid="NUM 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 23:26" />
    <char style="pn">巴兰</char>回答<char style="pn">巴勒</char>说：“我不是告诉过你，耶和华所说的一切我必须遵行吗？”<verse eid="NUM 23:26" /></para>
  <para style="s">第三个神谕</para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 23:27" />于是<char style="pn">巴勒</char>对<char style="pn">巴兰</char>说：“来，请让我带你到另外一个地方。或许在神的眼中，你从那里为我诅咒他们是合宜的。” <verse eid="NUM 23:27" /><verse number="28" style="v" sid="NUM 23:28" /><char style="pn">巴勒</char>就带<char style="pn">巴兰</char>到<char style="pn">毗珥</char>山顶，在那里可以俯看荒漠。<verse eid="NUM 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 23:29" />
    <char style="pn">巴兰</char>对<char style="pn">巴勒</char>说：“请在这里为我筑七座祭坛，并在这里为我预备七头公牛、七只公绵羊。” <verse eid="NUM 23:29" /><verse number="30" style="v" sid="NUM 23:30" /><char style="pn">巴勒</char>就照着<char style="pn">巴兰</char>所说的做了，在每座祭坛上献一头公牛、一只公绵羊。<verse eid="NUM 23:30" /></para>
  <chapter eid="NUM 23" />
  <chapter number="24" style="c" sid="NUM 24" />
  <para style="nb">
    <verse number="1" style="v" sid="NUM 24:1" />
    <char style="pn">巴兰</char>看到祝福<char style="pn">以色列</char>能取悦耶和华，就没有像前几次那样尝试用法术，而是把脸转向旷野。 <verse eid="NUM 24:1" /><verse number="2" style="v" sid="NUM 24:2" /><char style="pn">巴兰</char>举目，看见<char style="pn">以色列</char>按各自的支派安居，神的灵就临到他身上。 <verse eid="NUM 24:2" /><verse number="3" style="v" sid="NUM 24:3" />他发布谕示，说：</para>
  <para style="q1" vid="NUM 24:3">“这是<char style="pn">比珥</char>的儿子<char style="pn">巴兰</char>的宣告，</para>
  <para style="q1" vid="NUM 24:3">眼睛开启之人的宣告；<verse eid="NUM 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NUM 24:4" />这听到神的话语之人，</para>
  <para style="q1" vid="NUM 24:4">看到全能者的异象，</para>
  <para style="q1" vid="NUM 24:4">俯伏着，双眼被开启，</para>
  <para style="q1" vid="NUM 24:4">他的宣告如下：<verse eid="NUM 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NUM 24:5" />
    <char style="pn">雅各</char>啊，你的帐篷多么美好；</para>
  <para style="q1" vid="NUM 24:5">
    <char style="pn">以色列</char>啊，你的帐幕何等华美！<verse eid="NUM 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NUM 24:6" />它们像绵延的溪谷，</para>
  <para style="q1" vid="NUM 24:6">像河边的园林；</para>
  <para style="q1" vid="NUM 24:6">像耶和华栽种的沉香树，</para>
  <para style="q1" vid="NUM 24:6">像水边的香柏树。<verse eid="NUM 24:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 24:7" />露水从他的枝干滴落<note caller="+" style="f"><char style="fr" closed="false">24:7 </char><char style="ft" closed="false">露水从他的枝干滴落——或译作“水从他的桶里流出”。</char></note>，</para>
  <para style="q1" vid="NUM 24:7">他的根<note caller="+" style="f"><char style="fr" closed="false">24:7 </char><char style="ft" closed="false">根——或译作“种子”。</char></note>在水源丰富之地；</para>
  <para style="q1" vid="NUM 24:7">他的君王必高过<char style="pn">亚甲</char>，</para>
  <para style="q1" vid="NUM 24:7">他的王权必被高举。<verse eid="NUM 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 24:8" />神把他从<char style="pn">埃及</char>领出来，</para>
  <para style="q1" vid="NUM 24:8">像野牛的角为他争战<note caller="+" style="f"><char style="fr" closed="false">24:8 </char><char style="ft" closed="false">争战——辅助词语。</char></note>。</para>
  <para style="q1" vid="NUM 24:8">他必吞噬那些敌对他的国家，</para>
  <para style="q1" vid="NUM 24:8">压碎他们的骨头，</para>
  <para style="q1" vid="NUM 24:8">用箭射透他们。<verse eid="NUM 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 24:9" />他屈身躺卧如公狮和母狮，</para>
  <para style="q1" vid="NUM 24:9">谁敢招惹他？</para>
  <para style="q1" vid="NUM 24:9">凡祝福你的，必受祝福；</para>
  <para style="q1" vid="NUM 24:9">凡诅咒你的，必受诅咒！”<verse eid="NUM 24:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="NUM 24:10" />
    <char style="pn">巴勒</char>就对<char style="pn">巴兰</char>发怒，拍掌对<char style="pn">巴兰</char>说：“我召你来是为了诅咒我的仇敌，看哪，你竟然祝福了他们这三次！ <verse eid="NUM 24:10" /><verse number="11" style="v" sid="NUM 24:11" />现在赶紧回你本地去吧！我曾说要使你大得尊荣，看哪，耶和华却阻挡你得尊荣。”<verse eid="NUM 24:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 24:12" />
    <char style="pn">巴兰</char>回答<char style="pn">巴勒</char>：“我不是告诉过你派来见我的那些使者吗？我说： <verse eid="NUM 24:12" /><verse number="13" style="v" sid="NUM 24:13" />即使<char style="pn">巴勒</char>把他满屋的金银给我，我也不能违背耶和华的吩咐，凭自己的心意做好做歹。耶和华说什么，我就说什么。 <verse eid="NUM 24:13" /><verse number="14" style="v" sid="NUM 24:14" />现在，看哪，我将要回我的族人那里去了。请让我告诉你，日后那民族会怎样对待你的子民。”<verse eid="NUM 24:14" /></para>
  <para style="s">第四个神谕</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 24:15" />于是<char style="pn">巴兰</char>发布谕示，说：</para>
  <para style="q1" vid="NUM 24:15">“这是<char style="pn">比珥</char>的儿子<char style="pn">巴兰</char>的宣告，</para>
  <para style="q1" vid="NUM 24:15">眼睛开启之人的宣告；<verse eid="NUM 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="NUM 24:16" />这听到神的话语之人，</para>
  <para style="q1" vid="NUM 24:16">明白至高者的知识，</para>
  <para style="q1" vid="NUM 24:16">看到全能者的异象，</para>
  <para style="q1" vid="NUM 24:16">俯伏着，双眼被开启，</para>
  <para style="q1" vid="NUM 24:16">他的宣告如下：<verse eid="NUM 24:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="NUM 24:17" />我看见他，却不是现在；</para>
  <para style="q1" vid="NUM 24:17">我望见他，却不在近处。</para>
  <para style="q1" vid="NUM 24:17">有一颗星从<char style="pn">雅各</char>发出，</para>
  <para style="q1" vid="NUM 24:17">有一根杖从<char style="pn">以色列</char>兴起；</para>
  <para style="q1" vid="NUM 24:17">他将击碎<char style="pn">摩押</char>的额角，</para>
  <para style="q1" vid="NUM 24:17">击溃所有的<char style="pn">谢特</char>人<note caller="+" style="f"><char style="fr" closed="false">24:17 </char><char style="ft" closed="false">击溃所有的谢特人——有古卷作“打破所有谢特人的头颅”；参《耶利米书》48:45。</char></note>。<verse eid="NUM 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 24:18" />
    <char style="pn">以东</char>将成为他的领地，</para>
  <para style="q1" vid="NUM 24:18">他的仇敌<char style="pn">西珥</char>将被他占领，</para>
  <para style="q1" vid="NUM 24:18">
    <char style="pn">以色列</char>必做大能的事。<verse eid="NUM 24:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 24:19" />有一位出自<char style="pn">雅各</char>的必执掌大权，</para>
  <para style="q1" vid="NUM 24:19">他将灭绝城里的幸存者。”<verse eid="NUM 24:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="NUM 24:20" />然后他观看<char style="pn">亚玛力</char>，发布谕示说：</para>
  <para style="q1" vid="NUM 24:20">“<char style="pn">亚玛力</char>是列国之首，</para>
  <para style="q1" vid="NUM 24:20">但他最终归向灭亡。”<verse eid="NUM 24:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="NUM 24:21" />
    <char style="pn">巴兰</char>又观看<char style="pn">基尼</char>人，发布谕示说：</para>
  <para style="q1" vid="NUM 24:21">“你的住处稳固，</para>
  <para style="q1" vid="NUM 24:21">你在岩石中筑巢。<verse eid="NUM 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 24:22" />然而<char style="pn">基尼</char>必被烧毁，</para>
  <para style="q1" vid="NUM 24:22">最终<char style="pn">亚述</char>要把你掳去。”<verse eid="NUM 24:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="NUM 24:23" />
    <char style="pn">巴兰</char>又发布谕示，说：</para>
  <para style="q1" vid="NUM 24:23">“有祸了！</para>
  <para style="q1" vid="NUM 24:23">神定意如此，谁能存活呢？<verse eid="NUM 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 24:24" />有船队从<char style="pn">基提</char>海岸而来，</para>
  <para style="q1" vid="NUM 24:24">要制伏<char style="pn">亚述</char>、制伏<char style="pn">希伯</char>，</para>
  <para style="q1" vid="NUM 24:24">但它也归向灭亡。”<verse eid="NUM 24:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="NUM 24:25" />然后，<char style="pn">巴兰</char>起身离开，回本地去，<char style="pn">巴勒</char>也上路回去了。<verse eid="NUM 24:25" /></para>
  <chapter eid="NUM 24" />
  <chapter number="25" style="c" sid="NUM 25" />
  <para style="s">以色列敬拜巴力</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 25:1" />
    <char style="pn">以色列</char>住在<char style="pn">什亭</char>的时候，民众开始与<char style="pn">摩押</char>女子行淫。 <verse eid="NUM 25:1" /><verse number="2" style="v" sid="NUM 25:2" />这些女子邀请民众参加她们神明的祭祀，民众吃了祭物，又向她们的神明下拜。 <verse eid="NUM 25:2" /><verse number="3" style="v" sid="NUM 25:3" />这样，<char style="pn">以色列</char>与<char style="pn">毗珥</char>的<char style="pn">巴力</char>联合，耶和华的怒气就向<char style="pn">以色列</char>发作。 <verse eid="NUM 25:3" /><verse number="4" style="v" sid="NUM 25:4" />耶和华对<char style="pn">摩西</char>说：“你把民众的首领都带来，在日光之下，在耶和华面前把他们处死示众，好让耶和华的烈怒转离<char style="pn">以色列</char>。”<verse eid="NUM 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 25:5" />
    <char style="pn">摩西</char>就对<char style="pn">以色列</char>的审判官们说：“你们各人要把你们当中与<char style="pn">毗珥</char>的<char style="pn">巴力</char>联合的人杀掉。”<verse eid="NUM 25:5" /></para>
  <para style="s">非尼哈果断行动</para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 25:6" />
    <char style="pn">摩西</char>和全体<char style="pn">以色列</char>会众正在会幕的入口哭泣时，看哪，<char style="pn">以色列</char>子民中有一个人前来，在他们眼前把一个<char style="pn">米甸</char>女子带到弟兄们那里。 <verse eid="NUM 25:6" /><verse number="7" style="v" sid="NUM 25:7" />祭司<char style="pn">亚伦</char>的孙子、<char style="pn">以利亚撒</char>的儿子<char style="pn">非尼哈</char>看见了，就从会众当中起身，手拿长矛， <verse eid="NUM 25:7" /><verse number="8" style="v" sid="NUM 25:8" />跟在那<char style="pn">以色列</char>人后面进了帐篷，用长矛把那<char style="pn">以色列</char>人和女子两人刺透，一直刺入女子的肚腹。这样，瘟疫就从<char style="pn">以色列</char>子民中止住了。 <verse eid="NUM 25:8" /><verse number="9" style="v" sid="NUM 25:9" />当时死于瘟疫的，有两万四千人。<verse eid="NUM 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 25:10" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 25:10" /><verse number="11" style="v" sid="NUM 25:11" />“祭司<char style="pn">亚伦</char>的孙子、<char style="pn">以利亚撒</char>的儿子<char style="pn">非尼哈</char>使我的怒火转离了<char style="pn">以色列</char>子民，因为他在他们中间因我的妒火而发热心，使我没有在妒火中灭绝<char style="pn">以色列</char>子民。 <verse eid="NUM 25:11" /><verse number="12" style="v" sid="NUM 25:12" />因此你要告诉他：看哪，我把我的平安之约赐给他， <verse eid="NUM 25:12" /><verse number="13" style="v" sid="NUM 25:13" />这约将成为他和他后裔永远担任祭司的约，因为他为他的神而嫉愤，为<char style="pn">以色列</char>子民赎了罪。”<verse eid="NUM 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 25:14" />那个与<char style="pn">米甸</char>女子一同被杀的<char style="pn">以色列</char>人，名叫<char style="pn">泽姆利</char>，是<char style="pn">萨鲁</char>的儿子，是<char style="pn">西缅</char>一个宗族的领袖。 <verse eid="NUM 25:14" /><verse number="15" style="v" sid="NUM 25:15" />那个被杀的<char style="pn">米甸</char>女子名叫<char style="pn">柯兹比</char>，是<char style="pn">苏珥</char>的女儿，<char style="pn">苏珥</char>是<char style="pn">米甸</char>一个宗族的首领。<verse eid="NUM 25:15" /></para>
  <para style="s">报复米甸人</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 25:16" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 25:16" /><verse number="17" style="v" sid="NUM 25:17" />“你要扰害<char style="pn">米甸</char>人，击杀他们。 <verse eid="NUM 25:17" /><verse number="18" style="v" sid="NUM 25:18" />因为他们以诡计扰害你们，就是在<char style="pn">毗珥</char>的事情上，以及他们的姐妹、<char style="pn">米甸</char>领袖的女儿<char style="pn">柯兹比</char>的事情上行诡诈对付你们；这<char style="pn">柯兹比</char>，已经在瘟疫的日子里，因<char style="pn">毗珥</char>的事情而被杀。”<verse eid="NUM 25:18" /></para>
  <chapter eid="NUM 25" />
  <chapter number="26" style="c" sid="NUM 26" />
  <para style="s">第二次人口普查</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 26:1" />瘟疫之后，耶和华告诉<char style="pn">摩西</char>和祭司<char style="pn">亚伦</char>的儿子<char style="pn">以利亚撒</char>，说： <verse eid="NUM 26:1" /><verse number="2" style="v" sid="NUM 26:2" />“你们要按着父家，统计全体<char style="pn">以色列</char>会众，就是<char style="pn">以色列</char>中二十岁以上所有能出战的男子的人数。”<verse eid="NUM 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 26:3" />于是，在<char style="pn">耶利哥</char>东边<char style="pn">约旦</char>河对面的<char style="pn">摩押</char>平原，<char style="pn">摩西</char>和祭司<char style="pn">以利亚撒</char>吩咐<char style="pn">以色列</char>人说， <verse eid="NUM 26:3" /><verse number="4" style="v" sid="NUM 26:4" />要统计二十岁以上的男子，正如耶和华向<char style="pn">摩西</char>和出<char style="pn">埃及</char>地的<char style="pn">以色列</char>子民所指示的。<verse eid="NUM 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NUM 26:5" />
    <char style="pn">鲁本</char>是<char style="pn">以色列</char>的长子。</para>
  <para style="q1" vid="NUM 26:5">
    <char style="pn">鲁本</char>的子孙有：</para>
  <para style="q1" vid="NUM 26:5">属<char style="pn">哈诺</char>的，<char style="pn">哈诺</char>家族；</para>
  <para style="q1" vid="NUM 26:5">属<char style="pn">法路</char>的，<char style="pn">法路</char>家族；<verse eid="NUM 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NUM 26:6" />属<char style="pn">希斯伦</char>的，<char style="pn">希斯伦</char>家族；</para>
  <para style="q1" vid="NUM 26:6">属<char style="pn">迦米</char>的，<char style="pn">迦米</char>家族。<verse eid="NUM 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 26:7" />以上是<char style="pn">鲁本</char>的家族，</para>
  <para style="q1" vid="NUM 26:7">他们被数点的，共四万三千七百三十人。<verse eid="NUM 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 26:8" />
    <char style="pn">法路</char>的儿子是<char style="pn">以利押</char>。<verse eid="NUM 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 26:9" />
    <char style="pn">以利押</char>的儿子是<char style="pn">尼姆利</char>、<char style="pn">大坍</char>、<char style="pn">亚比兰</char>。</para>
  <para style="b" vid="NUM 26:9" />
  <para style="p" vid="NUM 26:9">这<char style="pn">大坍</char>和<char style="pn">亚比兰</char>是会众里选召出来的领袖，在<char style="pn">可拉</char>同党对抗耶和华的时候，与他们一起对抗<char style="pn">摩西</char>和<char style="pn">亚伦</char>。 <verse eid="NUM 26:9" /><verse number="10" style="v" sid="NUM 26:10" />那时地张开口，把他们和<char style="pn">可拉</char>一起吞掉了，那些同党也死了，火吞噬了两百五十人。这样，他们就成为一个鉴戒。 <verse eid="NUM 26:10" /><verse number="11" style="v" sid="NUM 26:11" />然而，<char style="pn">可拉</char>的子孙并没有全都死掉。<verse eid="NUM 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NUM 26:12" />
    <char style="pn">西缅</char>的子孙，按家族有：</para>
  <para style="q1" vid="NUM 26:12">属<char style="pn">尼姆利</char>的，<char style="pn">尼姆利</char>家族；</para>
  <para style="q1" vid="NUM 26:12">属<char style="pn">雅悯</char>的，<char style="pn">雅悯</char>家族；</para>
  <para style="q1" vid="NUM 26:12">属<char style="pn">雅斤</char>的，<char style="pn">雅斤</char>家族；<verse eid="NUM 26:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NUM 26:13" />属<char style="pn">谢拉</char>的，<char style="pn">谢拉</char>家族；</para>
  <para style="q1" vid="NUM 26:13">属<char style="pn">扫罗</char>的，<char style="pn">扫罗</char>家族。<verse eid="NUM 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="NUM 26:14" />以上是<char style="pn">西缅</char>的家族，</para>
  <para style="q1" vid="NUM 26:14">共两万两千两百人。<verse eid="NUM 26:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="NUM 26:15" />
    <char style="pn">迦得</char>的子孙，按家族有：</para>
  <para style="q1" vid="NUM 26:15">属<char style="pn">洗分</char>的，<char style="pn">洗分</char>家族；</para>
  <para style="q1" vid="NUM 26:15">属<char style="pn">哈基</char>的，<char style="pn">哈基</char>家族；</para>
  <para style="q1" vid="NUM 26:15">属<char style="pn">书尼</char>的，<char style="pn">书尼</char>家族；<verse eid="NUM 26:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="NUM 26:16" />属<char style="pn">阿兹尼</char>的，<char style="pn">阿兹尼</char>家族；</para>
  <para style="q1" vid="NUM 26:16">属<char style="pn">伊利</char>的，<char style="pn">伊利</char>家族；<verse eid="NUM 26:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="NUM 26:17" />属<char style="pn">阿罗迪</char>的，<char style="pn">阿罗迪</char>家族；</para>
  <para style="q1" vid="NUM 26:17">属<char style="pn">阿尔耶利</char>的，<char style="pn">阿尔耶利</char>家族。<verse eid="NUM 26:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 26:18" />以上是<char style="pn">迦得</char>子孙的家族，</para>
  <para style="q1" vid="NUM 26:18">他们被数点的，</para>
  <para style="q1" vid="NUM 26:18">共四万零五百人。<verse eid="NUM 26:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="NUM 26:19" />
    <char style="pn">犹大</char>的儿子是<char style="pn">珥</char>和<char style="pn">俄南</char>，</para>
  <para style="q1" vid="NUM 26:19">但<char style="pn">珥</char>和<char style="pn">俄南</char>已经死在<char style="pn">迦南</char>地。<verse eid="NUM 26:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="NUM 26:20" />
    <char style="pn">犹大</char>的子孙，按家族有：</para>
  <para style="q1" vid="NUM 26:20">属<char style="pn">示拉</char>的，<char style="pn">示拉</char>家族；</para>
  <para style="q1" vid="NUM 26:20">属<char style="pn">法勒斯</char>的，<char style="pn">法勒斯</char>家族；</para>
  <para style="q1" vid="NUM 26:20">属<char style="pn">谢拉</char>的，<char style="pn">谢拉</char>家族；<verse eid="NUM 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="NUM 26:21" />
    <char style="pn">法勒斯</char>的子孙有：</para>
  <para style="q1" vid="NUM 26:21">属<char style="pn">希斯伦</char>的，<char style="pn">希斯伦</char>家族；</para>
  <para style="q1" vid="NUM 26:21">属<char style="pn">哈姆勒</char>的，<char style="pn">哈姆勒</char>家族。<verse eid="NUM 26:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 26:22" />以上是<char style="pn">犹大</char>的家族，</para>
  <para style="q1" vid="NUM 26:22">按着被数点的，</para>
  <para style="q1" vid="NUM 26:22">共七万六千五百人。<verse eid="NUM 26:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="NUM 26:23" />
    <char style="pn">以萨迦</char>的子孙，按家族有：</para>
  <para style="q1" vid="NUM 26:23">属<char style="pn">陀拉</char>的，<char style="pn">陀拉</char>家族；</para>
  <para style="q1" vid="NUM 26:23">属<char style="pn">普瓦</char>的，<char style="pn">普瓦</char>家族；<verse eid="NUM 26:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 26:24" />属<char style="pn">雅实布</char>的，<char style="pn">雅实布</char>家族；</para>
  <para style="q1" vid="NUM 26:24">属<char style="pn">希姆仑</char>的，<char style="pn">希姆仑</char>家族；<verse eid="NUM 26:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="NUM 26:25" />以上是<char style="pn">以萨迦</char>的家族，</para>
  <para style="q1" vid="NUM 26:25">他们被数点的，</para>
  <para style="q1" vid="NUM 26:25">共六万四千三百人。<verse eid="NUM 26:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="NUM 26:26" />
    <char style="pn">西布伦</char>的子孙，按家族有：</para>
  <para style="q1" vid="NUM 26:26">属<char style="pn">西列德</char>的，<char style="pn">西列德</char>家族；</para>
  <para style="q1" vid="NUM 26:26">属<char style="pn">埃隆</char>的，<char style="pn">埃隆</char>家族；</para>
  <para style="q1" vid="NUM 26:26">属<char style="pn">雅赫列</char>的，<char style="pn">雅赫列</char>家族。<verse eid="NUM 26:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="NUM 26:27" />以上是<char style="pn">西布伦</char>的家族，</para>
  <para style="q1" vid="NUM 26:27">他们被数点的，</para>
  <para style="q1" vid="NUM 26:27">共六万零五百人。<verse eid="NUM 26:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="NUM 26:28" />
    <char style="pn">约瑟</char>的儿子，按家族有：</para>
  <para style="q1" vid="NUM 26:28">
    <char style="pn">玛拿西</char>和<char style="pn">以法莲</char>。<verse eid="NUM 26:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="NUM 26:29" />
    <char style="pn">玛拿西</char>的子孙有：</para>
  <para style="q1" vid="NUM 26:29">属<char style="pn">玛吉</char>的，<char style="pn">玛吉</char>家族。</para>
  <para style="q1" vid="NUM 26:29">
    <char style="pn">玛吉</char>生了<char style="pn">基列</char>，</para>
  <para style="q1" vid="NUM 26:29">属<char style="pn">基列</char>的有<char style="pn">基列</char>家族。<verse eid="NUM 26:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="NUM 26:30" />
    <char style="pn">基列</char>的子孙如下：</para>
  <para style="q1" vid="NUM 26:30">属<char style="pn">伊以谢</char>的，<char style="pn">伊以谢</char>家族；</para>
  <para style="q1" vid="NUM 26:30">属<char style="pn">希勒</char>的，<char style="pn">希勒</char>家族；<verse eid="NUM 26:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="NUM 26:31" />属<char style="pn">亚斯列</char>的，<char style="pn">亚斯列</char>家族；</para>
  <para style="q1" vid="NUM 26:31">属<char style="pn">示剑</char>的，<char style="pn">示剑</char>家族；<verse eid="NUM 26:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="NUM 26:32" />属<char style="pn">谢米达</char>的，<char style="pn">谢米达</char>家族；</para>
  <para style="q1" vid="NUM 26:32">属<char style="pn">希弗</char>的，<char style="pn">希弗</char>家族。<verse eid="NUM 26:32" /></para>
  <para style="b" />
  <para style="p">
    <verse number="33" style="v" sid="NUM 26:33" />
    <char style="pn">希弗</char>的儿子<char style="pn">西罗非哈</char>没有儿子，只有女儿。<char style="pn">西罗非哈</char>的女儿名字是<char style="pn">玛拉</char>、<char style="pn">挪阿</char>、<char style="pn">霍格拉</char>、<char style="pn">米尔卡</char>、<char style="pn">提尔撒</char>。<verse eid="NUM 26:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="NUM 26:34" />以上是<char style="pn">玛拿西</char>的家族，</para>
  <para style="q1" vid="NUM 26:34">他们被数点的，</para>
  <para style="q1" vid="NUM 26:34">共五万两千七百人。<verse eid="NUM 26:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="NUM 26:35" />
    <char style="pn">以法莲</char>的子孙如下，按家族有：</para>
  <para style="q1" vid="NUM 26:35">属<char style="pn">书提拉</char>的，<char style="pn">书提拉</char>家族；</para>
  <para style="q1" vid="NUM 26:35">属<char style="pn">比结</char>的，<char style="pn">比结</char>家族；</para>
  <para style="q1" vid="NUM 26:35">属<char style="pn">塔罕</char>的，<char style="pn">塔罕</char>家族。<verse eid="NUM 26:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="NUM 26:36" />
    <char style="pn">书提拉</char>的子孙有：</para>
  <para style="q1" vid="NUM 26:36">属<char style="pn">伊兰</char>的，<char style="pn">伊兰</char>家族。<verse eid="NUM 26:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="NUM 26:37" />以上是<char style="pn">以法莲</char>子孙的家族，</para>
  <para style="q1" vid="NUM 26:37">他们被数点的，</para>
  <para style="q1" vid="NUM 26:37">共三万两千五百人。</para>
  <para style="q1" vid="NUM 26:37">按家族，这些都是<char style="pn">约瑟</char>的子孙。<verse eid="NUM 26:37" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="38" style="v" sid="NUM 26:38" />
    <char style="pn">便雅悯</char>的子孙，按家族有：</para>
  <para style="q1" vid="NUM 26:38">属<char style="pn">比拉</char>的，<char style="pn">比拉</char>家族；</para>
  <para style="q1" vid="NUM 26:38">属<char style="pn">阿实别</char>的，<char style="pn">阿实别</char>家族；</para>
  <para style="q1" vid="NUM 26:38">属<char style="pn">阿希兰</char>的，<char style="pn">阿希兰</char>家族；<verse eid="NUM 26:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="NUM 26:39" />属<char style="pn">谢弗番</char>的，<char style="pn">谢弗番</char>家族；</para>
  <para style="q1" vid="NUM 26:39">属<char style="pn">户番</char>的，<char style="pn">户番</char>家族。<verse eid="NUM 26:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="NUM 26:40" />
    <char style="pn">比拉</char>的儿子是<char style="pn">阿尔德</char>、<char style="pn">奈曼</char>，他们有：</para>
  <para style="q1" vid="NUM 26:40">属<char style="pn">阿尔德</char>的，<char style="pn">阿尔德</char>家族；</para>
  <para style="q1" vid="NUM 26:40">属<char style="pn">奈曼</char>的，<char style="pn">奈曼</char>家族。<verse eid="NUM 26:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="NUM 26:41" />以上是<char style="pn">便雅悯</char>的子孙，</para>
  <para style="q1" vid="NUM 26:41">他们按家族被数点的，</para>
  <para style="q1" vid="NUM 26:41">共四万五千六百人。<verse eid="NUM 26:41" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="42" style="v" sid="NUM 26:42" />
    <char style="pn">但</char>的子孙如下，按家族有：</para>
  <para style="q1" vid="NUM 26:42">属<char style="pn">书含</char>的，<char style="pn">书含</char>家族。</para>
  <para style="q1" vid="NUM 26:42">按家族，这就是<char style="pn">但</char>的家族。<verse eid="NUM 26:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="NUM 26:43" />
    <char style="pn">书含</char>全家族被数点的，</para>
  <para style="q1" vid="NUM 26:43">共六万四千四百人。<verse eid="NUM 26:43" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="44" style="v" sid="NUM 26:44" />
    <char style="pn">亚设</char>的子孙，按家族有：</para>
  <para style="q1" vid="NUM 26:44">属<char style="pn">伊姆纳</char>的，<char style="pn">伊姆纳</char>家族；</para>
  <para style="q1" vid="NUM 26:44">属<char style="pn">伊施韦</char>的，<char style="pn">伊施韦</char>家族；</para>
  <para style="q1" vid="NUM 26:44">属<char style="pn">比利亚</char>的，<char style="pn">比利亚</char>家族；<verse eid="NUM 26:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="NUM 26:45" />
    <char style="pn">比利亚</char>的子孙有：</para>
  <para style="q1" vid="NUM 26:45">属<char style="pn">希伯</char>的，<char style="pn">希伯</char>家族；</para>
  <para style="q1" vid="NUM 26:45">属<char style="pn">玛结</char>的，<char style="pn">玛结</char>家族。<verse eid="NUM 26:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="NUM 26:46" />
    <char style="pn">亚设</char>的女儿名叫<char style="pn">西拉</char>。<verse eid="NUM 26:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="NUM 26:47" />以上是<char style="pn">亚设</char>子孙的家族，</para>
  <para style="q1" vid="NUM 26:47">他们被数点的，</para>
  <para style="q1" vid="NUM 26:47">共五万三千四百人。<verse eid="NUM 26:47" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="48" style="v" sid="NUM 26:48" />
    <char style="pn">拿弗他利</char>的子孙，按家族有：</para>
  <para style="q1" vid="NUM 26:48">属<char style="pn">雅赫兹列</char>的，<char style="pn">雅赫兹列</char>家族；</para>
  <para style="q1" vid="NUM 26:48">属<char style="pn">古尼</char>的，<char style="pn">古尼</char>家族；<verse eid="NUM 26:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="NUM 26:49" />属<char style="pn">耶则尔</char>的，<char style="pn">耶则尔</char>家族；</para>
  <para style="q1" vid="NUM 26:49">属<char style="pn">谢勒姆</char>的，<char style="pn">谢勒姆</char>家族。<verse eid="NUM 26:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="NUM 26:50" />以上是<char style="pn">拿弗他利</char>的家族，</para>
  <para style="q1" vid="NUM 26:50">他们按家族被数点的，</para>
  <para style="q1" vid="NUM 26:50">共四万五千四百人。<verse eid="NUM 26:50" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="51" style="v" sid="NUM 26:51" />以上就是被数点的<char style="pn">以色列</char>子孙，</para>
  <para style="q1" vid="NUM 26:51">共六十万零一千七百三十人。<verse eid="NUM 26:51" /></para>
  <para style="b" />
  <para style="p">
    <verse number="52" style="v" sid="NUM 26:52" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 26:52" /><verse number="53" style="v" sid="NUM 26:53" />“要按名单，把那地分给这些人为继业。 <verse eid="NUM 26:53" /><verse number="54" style="v" sid="NUM 26:54" />人多的，你要多给他们产业；人少的，你要少给他们产业；他们各自要按着被数点的人口分得继业。 <verse eid="NUM 26:54" /><verse number="55" style="v" sid="NUM 26:55" />只是他们要以抽签的方式分地，按自己父系支派的名字得继业。 <verse eid="NUM 26:55" /><verse number="56" style="v" sid="NUM 26:56" />各支派无论人多人少，都要按所抽的签分配继业。”<verse eid="NUM 26:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="NUM 26:57" />以下是被数点的<char style="pn">利未</char>人，按家族有：</para>
  <para style="q1" vid="NUM 26:57">属<char style="pn">革顺</char>的，<char style="pn">革顺</char>家族；</para>
  <para style="q1" vid="NUM 26:57">属<char style="pn">哥辖</char>的，<char style="pn">哥辖</char>家族；</para>
  <para style="q1" vid="NUM 26:57">属<char style="pn">米拉利</char>的，<char style="pn">米拉利</char>家族。<verse eid="NUM 26:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="NUM 26:58" />
    <char style="pn">利未</char>的家族有：</para>
  <para style="q1" vid="NUM 26:58">
    <char style="pn">立尼</char>家族、</para>
  <para style="q1" vid="NUM 26:58">
    <char style="pn">希伯伦</char>家族、</para>
  <para style="q1" vid="NUM 26:58">
    <char style="pn">玛贺利</char>家族、</para>
  <para style="q1" vid="NUM 26:58">
    <char style="pn">穆希</char>家族、</para>
  <para style="q1" vid="NUM 26:58">
    <char style="pn">可拉</char>家族。</para>
  <para style="b" vid="NUM 26:58" />
  <para style="p" vid="NUM 26:58">
    <char style="pn">哥辖</char>生了<char style="pn">阿姆兰</char>。 <verse eid="NUM 26:58" /><verse number="59" style="v" sid="NUM 26:59" /><char style="pn">阿姆兰</char>的妻子名叫<char style="pn">约基别</char>，是<char style="pn">利未</char>在<char style="pn">埃及</char>所生的女儿；她为<char style="pn">阿姆兰</char>生了<char style="pn">亚伦</char>、<char style="pn">摩西</char>和他们的姐姐<char style="pn">米利暗</char>。 <verse eid="NUM 26:59" /><verse number="60" style="v" sid="NUM 26:60" /><char style="pn">亚伦</char>生了<char style="pn">纳达布</char>、<char style="pn">亚比户</char>、<char style="pn">以利亚撒</char>、<char style="pn">以塔玛尔</char>， <verse eid="NUM 26:60" /><verse number="61" style="v" sid="NUM 26:61" /><char style="pn">纳达布</char>和<char style="pn">亚比户</char>向耶和华献上违规的火，就死了。 <verse eid="NUM 26:61" /><verse number="62" style="v" sid="NUM 26:62" /><char style="pn">利未</char>人被数点的所有一个月以上的男性，有两万三千人。他们并没有与<char style="pn">以色列</char>子孙一起被数点，因为他们不在<char style="pn">以色列</char>子孙中分得继业。<verse eid="NUM 26:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="NUM 26:63" />这些就是<char style="pn">摩西</char>和祭司<char style="pn">以利亚撒</char>数点的人，他们在<char style="pn">耶利哥</char>东边<char style="pn">约旦</char>河对面的<char style="pn">摩押</char>平原数点了<char style="pn">以色列</char>子孙。 <verse eid="NUM 26:63" /><verse number="64" style="v" sid="NUM 26:64" />这些人中，没有一个是<char style="pn">摩西</char>和祭司<char style="pn">亚伦</char>从前在<char style="pn">西奈</char>旷野数点<char style="pn">以色列</char>子孙时数点过的， <verse eid="NUM 26:64" /><verse number="65" style="v" sid="NUM 26:65" />因为耶和华曾论到这些人说：“他们必须死在旷野；除了<char style="pn">耶弗尼</char>的儿子<char style="pn">迦勒</char>和<char style="pn">嫩</char>的儿子<char style="pn">约书亚</char>以外，他们当中没有一个人会存留下来。”<verse eid="NUM 26:65" /></para>
  <chapter eid="NUM 26" />
  <chapter number="27" style="c" sid="NUM 27" />
  <para style="s">女儿继承地业的案例</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 27:1" />那时，<char style="pn">西罗非哈</char>的女儿们上前来——<char style="pn">西罗非哈</char>是<char style="pn">希弗</char>的儿子、<char style="pn">基列</char>的孙子、<char style="pn">玛吉</char>的曾孙、<char style="pn">玛拿西</char>的玄孙，属于<char style="pn">约瑟</char>儿子<char style="pn">玛拿西</char>的家族；他女儿的名字是：<char style="pn">玛拉</char>、<char style="pn">挪阿</char>、<char style="pn">霍格拉</char>、<char style="pn">米尔卡</char>、<char style="pn">提尔撒</char>—— <verse eid="NUM 27:1" /><verse number="2" style="v" sid="NUM 27:2" />她们站在会幕的入口，在<char style="pn">摩西</char>、祭司<char style="pn">以利亚撒</char>和领袖们，以及全体会众面前说： <verse eid="NUM 27:2" /><verse number="3" style="v" sid="NUM 27:3" />“我们的父亲死在旷野，他不在那些聚众反对耶和华的一伙人当中，不属于<char style="pn">可拉</char>同党，而是因自己的罪过死了；他没有儿子。 <verse eid="NUM 27:3" /><verse number="4" style="v" sid="NUM 27:4" />为什么因我们的父亲没有儿子，就要把他的名字从他家族中除去呢？求你在我们父亲的兄弟中分给我们一份地业。”<verse eid="NUM 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 27:5" />
    <char style="pn">摩西</char>就把她们的案件呈到耶和华面前。 <verse eid="NUM 27:5" /><verse number="6" style="v" sid="NUM 27:6" />耶和华告诉<char style="pn">摩西</char>说： <verse eid="NUM 27:6" /><verse number="7" style="v" sid="NUM 27:7" />“<char style="pn">西罗非哈</char>的女儿们说得对，你一定要在她们父亲的兄弟中分给她们一份可继承的地业，把她们父亲的继业转给她们。 <verse eid="NUM 27:7" /><verse number="8" style="v" sid="NUM 27:8" />你还要吩咐<char style="pn">以色列</char>子民说：如果一个人死了，并且没有儿子，就要把他的继业转给他的女儿。 <verse eid="NUM 27:8" /><verse number="9" style="v" sid="NUM 27:9" />如果他没有女儿，就要把他的继业转给他的兄弟。 <verse eid="NUM 27:9" /><verse number="10" style="v" sid="NUM 27:10" />如果他没有兄弟，就要把他的继业转给他父亲的兄弟。 <verse eid="NUM 27:10" /><verse number="11" style="v" sid="NUM 27:11" />如果他父亲也没有兄弟，就要把他的继业给他家族中与他最近的亲属，那人可以拥有这继业。”这要成为<char style="pn">以色列</char>子孙的律例法规，正如耶和华所指示<char style="pn">摩西</char>的。<verse eid="NUM 27:11" /></para>
  <para style="s">约书亚受命接替摩西</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 27:12" />耶和华对<char style="pn">摩西</char>说：“你到这<char style="pn">亚巴琳</char>山上去，观看我赐给<char style="pn">以色列</char>子孙的土地。 <verse eid="NUM 27:12" /><verse number="13" style="v" sid="NUM 27:13" />你观看了那地之后，你也要归到你的先人那里，像你的哥哥<char style="pn">亚伦</char>归到先人那里一样。 <verse eid="NUM 27:13" /><verse number="14" style="v" sid="NUM 27:14" />因为在<char style="pn">寻</char>的旷野，当会众争闹时，你们违背了我的命令，没有在那水边在他们眼前尊我为圣。”那水就是<char style="pn">寻</char>的旷野中的<char style="pn">米利巴-加低斯</char>水。<verse eid="NUM 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 27:15" />于是，<char style="pn">摩西</char>请求耶和华说： <verse eid="NUM 27:15" /><verse number="16" style="v" sid="NUM 27:16" />“愿耶和华——那使一切肉体有气息<note caller="+" style="f"><char style="fr" closed="false">27:16 </char><char style="ft" closed="false">使一切肉体有气息——或译作“赐予全人类气息”。</char></note>的神，指派一个人管理会众， <verse eid="NUM 27:16" /><verse number="17" style="v" sid="NUM 27:17" />这人要在他们前面出入。他要带领他们出入，以免耶和华的会众像没有牧人的羊群那样。”<verse eid="NUM 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 27:18" />耶和华就对<char style="pn">摩西</char>说：“你把<char style="pn">嫩</char>的儿子<char style="pn">约书亚</char>带来，他是一个心中有圣灵的人。你要按手在他头上， <verse eid="NUM 27:18" /><verse number="19" style="v" sid="NUM 27:19" />让他站在祭司<char style="pn">以利亚撒</char>和全体会众面前，在他们眼前任命他； <verse eid="NUM 27:19" /><verse number="20" style="v" sid="NUM 27:20" />并将你的一些尊荣加给他，好让全体<char style="pn">以色列</char>会众都听从他。 <verse eid="NUM 27:20" /><verse number="21" style="v" sid="NUM 27:21" />他要站在祭司<char style="pn">以利亚撒</char>面前；<char style="pn">以利亚撒</char>要在耶和华面前凭借乌陵的裁决为他求问。<char style="pn">约书亚</char>和所有与他一起的<char style="pn">以色列</char>子民，就是全体会众，都要照着<char style="pn">以利亚撒</char>的命令出入。”<verse eid="NUM 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 27:22" />
    <char style="pn">摩西</char>就照着耶和华所指示的去做。他把<char style="pn">约书亚</char>带来，让他站在祭司<char style="pn">以利亚撒</char>和全体会众面前， <verse eid="NUM 27:22" /><verse number="23" style="v" sid="NUM 27:23" />按手在他头上，任命他，正如耶和华藉着<char style="pn">摩西</char>所说的。<verse eid="NUM 27:23" /></para>
  <chapter eid="NUM 27" />
  <chapter number="28" style="c" sid="NUM 28" />
  <para style="s">规定要献燔祭</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 28:1" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 28:1" /><verse number="2" style="v" sid="NUM 28:2" />“你要吩咐<char style="pn">以色列</char>子民，对他们说：你们务必在所定的日期向我献上祭物作馨香之气，作为献给我的火祭食物。 <verse eid="NUM 28:2" /><verse number="3" style="v" sid="NUM 28:3" />你要对他们说，献给耶和华的火祭如下：</para>
  <para style="s" vid="NUM 28:3">每日常献的燔祭</para>
  <para style="p" vid="NUM 28:3">“两只无瑕疵的一岁公羊羔，作为每天常献的燔祭， <verse eid="NUM 28:3" /><verse number="4" style="v" sid="NUM 28:4" />早晨献一只羊羔，黄昏的时候献另一只羊羔； <verse eid="NUM 28:4" /><verse number="5" style="v" sid="NUM 28:5" />还有十分之一伊法<note caller="+" style="f"><char style="fr" closed="false">28:5 </char><char style="ft" closed="false">十分之一伊法——相当于2.2公升；本章下同。1伊法＝22公升。</char></note>细面粉，用四分之一欣<note caller="+" style="f"><char style="fr" closed="false">28:5 </char><char style="ft" closed="false">四分之一欣——相当于0.9公升；本章下同。1欣=3.7公升。</char></note>压榨的油调和作素祭。 <verse eid="NUM 28:5" /><verse number="6" style="v" sid="NUM 28:6" />这常献的燔祭是在<char style="pn">西奈</char>山规定的，是献给耶和华的馨香火祭。 <verse eid="NUM 28:6" /><verse number="7" style="v" sid="NUM 28:7" />还要为每一只公羊羔同献四分之一欣的酒祭，在圣所中将醇酒的酒祭浇奠给耶和华。 <verse eid="NUM 28:7" /><verse number="8" style="v" sid="NUM 28:8" />你要在黄昏的时候献第二只羊羔，像早晨的素祭和酒祭一样献上，作馨香的火祭献给耶和华。<verse eid="NUM 28:8" /></para>
  <para style="s">安息日的燔祭</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 28:9" />“在安息日，要献两只无瑕疵的一岁公羊羔，还有十分之二伊法<note caller="+" style="f"><char style="fr" closed="false">28:9 </char><char style="ft" closed="false">十分之二伊法——相当于4.4公升；本章下同。1伊法=22公升。</char></note>调了油的细面粉为素祭，以及同献的酒祭。 <verse eid="NUM 28:9" /><verse number="10" style="v" sid="NUM 28:10" />这是在常献的燔祭和同献的酒祭以外，每个安息日都要献的燔祭。<verse eid="NUM 28:10" /></para>
  <para style="s">月初的燔祭</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 28:11" />“在每个月的第一天，你们要向耶和华献上燔祭：两头公牛、一只公绵羊、七只无瑕疵的一岁公羊羔。 <verse eid="NUM 28:11" /><verse number="12" style="v" sid="NUM 28:12" />为每一头公牛，献上十分之三伊法<note caller="+" style="f"><char style="fr" closed="false">28:12 </char><char style="ft" closed="false">十分之三伊法——相当于6.6公升；本章下同。1伊法=22公升。</char></note>调了油的细面粉作素祭；为每一只公绵羊，献上十分之二伊法调了油的细面粉作素祭； <verse eid="NUM 28:12" /><verse number="13" style="v" sid="NUM 28:13" />为每一只羊羔，献上十分之一伊法调了油的细面粉作素祭。这是燔祭，作馨香的火祭献给耶和华。 <verse eid="NUM 28:13" /><verse number="14" style="v" sid="NUM 28:14" />还有同献的酒祭，每头公牛要二分之一欣<note caller="+" style="f"><char style="fr" closed="false">28:14 </char><char style="ft" closed="false">二分之一欣——相当于1.9公升。1欣=3.7公升。</char></note>酒，每只公绵羊要三分之一欣<note caller="+" style="f"><char style="fr" closed="false">28:14 </char><char style="ft" closed="false">三分之一欣——相当于1.2公升。</char></note>酒，每只羊羔要四分之一欣<note caller="+" style="f"><char style="fr" closed="false">28:14 </char><char style="ft" closed="false">四分之一欣——相当于0.9公升。</char></note>酒。这是一年之中每个月都要献上的新月燔祭。 <verse eid="NUM 28:14" /><verse number="15" style="v" sid="NUM 28:15" />除了常献的燔祭和同献的酒祭以外，还要献给耶和华一只公山羊作赎罪祭。<verse eid="NUM 28:15" /></para>
  <para style="s">逾越节的燔祭</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 28:16" />“一月十四日是耶和华的逾越节， <verse eid="NUM 28:16" /><verse number="17" style="v" sid="NUM 28:17" />这个月的十五日是节期，要吃无酵饼七天。 <verse eid="NUM 28:17" /><verse number="18" style="v" sid="NUM 28:18" />第一天要有神圣的聚会，任何日常工作都不可做。 <verse eid="NUM 28:18" /><verse number="19" style="v" sid="NUM 28:19" />你们要献上两头公牛、一只公绵羊、七只一岁的公羊羔，都必须是无瑕疵的，作为火祭，作为燔祭献给耶和华。 <verse eid="NUM 28:19" /><verse number="20" style="v" sid="NUM 28:20" />还有同献的素祭，就是调了油的细面粉：为每头公牛，要献十分之三伊法面粉；为每只公绵羊，要献十分之二伊法面粉； <verse eid="NUM 28:20" /><verse number="21" style="v" sid="NUM 28:21" />至于那七只公羊羔，要为每一只羊羔献十分之一伊法面粉。 <verse eid="NUM 28:21" /><verse number="22" style="v" sid="NUM 28:22" />还要献一只赎罪祭公山羊，为你们赎罪。 <verse eid="NUM 28:22" /><verse number="23" style="v" sid="NUM 28:23" />除了清晨的燔祭，就是常献的燔祭以外，你们还要献以上这些祭物。 <verse eid="NUM 28:23" /><verse number="24" style="v" sid="NUM 28:24" />在常献的燔祭和同献的酒祭以外，一连七天，每天都要这样献上火祭的食物，作馨香之气献给耶和华。 <verse eid="NUM 28:24" /><verse number="25" style="v" sid="NUM 28:25" />第七天要有神圣的聚会，任何日常工作都不可做。<verse eid="NUM 28:25" /></para>
  <para style="s">七七节的燔祭</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 28:26" />“在初熟之日，当你们在七七节向耶和华献上新的素祭时，要有神圣的聚会，任何日常工作都不可做。 <verse eid="NUM 28:26" /><verse number="27" style="v" sid="NUM 28:27" />你们要献上两头公牛、一只公绵羊、七只一岁的公羊羔为燔祭，作馨香之气献给耶和华。 <verse eid="NUM 28:27" /><verse number="28" style="v" sid="NUM 28:28" />还有同献的素祭，就是调了油的细面粉：为每头公牛，要献十分之三伊法面粉；为每一只公绵羊，要献十分之二伊法面粉； <verse eid="NUM 28:28" /><verse number="29" style="v" sid="NUM 28:29" />至于那七只公羊羔，要为每一只羊羔献十分之一伊法面粉。 <verse eid="NUM 28:29" /><verse number="30" style="v" sid="NUM 28:30" />还要献一只公山羊，为你们赎罪。 <verse eid="NUM 28:30" /><verse number="31" style="v" sid="NUM 28:31" />你们要在常献的燔祭和同献的素祭以外，献上这些无瑕疵的燔祭和同献的酒祭。<verse eid="NUM 28:31" /></para>
  <chapter eid="NUM 28" />
  <chapter number="29" style="c" sid="NUM 29" />
  <para style="s">吹角节的燔祭</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 29:1" />“七月的第一日，你们要有神圣的聚会，任何日常工作都不可做，这是你们长鸣号角的日子。 <verse eid="NUM 29:1" /><verse number="2" style="v" sid="NUM 29:2" />你们要献一头公牛、一只公绵羊、七只无瑕疵的一岁公羊羔为燔祭，作馨香之气献给耶和华。 <verse eid="NUM 29:2" /><verse number="3" style="v" sid="NUM 29:3" />还有同献的素祭，就是调了油的细面粉：为每头公牛，要献十分之三伊法<note caller="+" style="f"><char style="fr" closed="false">29:3 </char><char style="ft" closed="false">十分之三伊法——相当于6.6公升；本章下同。1伊法=22公升。</char></note>面粉；为每只公绵羊，要献十分之二伊法<note caller="+" style="f"><char style="fr" closed="false">29:3 </char><char style="ft" closed="false">十分之二伊法——相当于4.4公升；本章下同。1伊法=22公升。</char></note>面粉； <verse eid="NUM 29:3" /><verse number="4" style="v" sid="NUM 29:4" />至于那七只公羊羔，要为每只羊羔献十分之一伊法<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">十分之一伊法——相当于2.2公升；本章下同。1伊法＝22公升。</char></note>面粉。 <verse eid="NUM 29:4" /><verse number="5" style="v" sid="NUM 29:5" />还要献一只公山羊作赎罪祭，为你们赎罪。 <verse eid="NUM 29:5" /><verse number="6" style="v" sid="NUM 29:6" />你们要在新月燔祭和同献的素祭、常献的燔祭和同献的素祭，以及照着法规同献的酒祭以外，把这些作为馨香的火祭献给耶和华。<verse eid="NUM 29:6" /></para>
  <para style="s">赎罪日的燔祭</para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 29:7" />“七月十日，你们要有神圣的聚会，要刻苦己心，任何工作都不可做。 <verse eid="NUM 29:7" /><verse number="8" style="v" sid="NUM 29:8" />你们要献上一头公牛、一只公绵羊、七只一岁的公羊羔，都必须是无瑕疵的，作为馨香的燔祭献给耶和华。 <verse eid="NUM 29:8" /><verse number="9" style="v" sid="NUM 29:9" />还有同献的素祭，就是调了油的细面粉：为每头公牛，要献十分之三伊法面粉；为每只公绵羊，要献十分之二伊法面粉； <verse eid="NUM 29:9" /><verse number="10" style="v" sid="NUM 29:10" />至于那七只公羊羔，要为每只羊羔献十分之一伊法面粉。 <verse eid="NUM 29:10" /><verse number="11" style="v" sid="NUM 29:11" />还要献一只公山羊作赎罪祭。这是在赎罪祭、常献的燔祭和同献的素祭，以及同献的酒祭以外的燔祭。<verse eid="NUM 29:11" /></para>
  <para style="s">住棚节的燔祭</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 29:12" />“七月十五日，你们要有神圣的聚会，任何日常工作都不可做，你们要向耶和华守节期七天。 <verse eid="NUM 29:12" /><verse number="13" style="v" sid="NUM 29:13" />你们要献上十三头公牛、两只公绵羊、十四只一岁的公羊羔，都必须是无瑕疵的，作为燔祭，作为馨香的火祭献给耶和华。 <verse eid="NUM 29:13" /><verse number="14" style="v" sid="NUM 29:14" />还有同献的素祭，就是调了油的细面粉：十三头公牛，为每头公牛要献十分之三伊法面粉；两只公绵羊，为每一只公绵羊要献十分之二伊法面粉； <verse eid="NUM 29:14" /><verse number="15" style="v" sid="NUM 29:15" />十四只公羊羔，为每一只羊羔要献十分之一伊法面粉。 <verse eid="NUM 29:15" /><verse number="16" style="v" sid="NUM 29:16" />还要献一只公山羊作赎罪祭。这是在常献的燔祭和同献的素祭，以及同献的酒祭以外的燔祭。<verse eid="NUM 29:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 29:17" />“第二天，要献十二头公牛、两只公绵羊、十四只一岁的公羊羔，都是无瑕疵的。 <verse eid="NUM 29:17" /><verse number="18" style="v" sid="NUM 29:18" />还有为公牛、公绵羊和羊羔同献的素祭和酒祭，都要按数目、照法规献上。 <verse eid="NUM 29:18" /><verse number="19" style="v" sid="NUM 29:19" />还要献一只公山羊作赎罪祭。这是在常献的燔祭和同献的素祭，以及同献的酒祭以外的燔祭。<verse eid="NUM 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 29:20" />“第三天，要献十一头公牛、两只公绵羊、十四只一岁的公羊羔，都是无瑕疵的。 <verse eid="NUM 29:20" /><verse number="21" style="v" sid="NUM 29:21" />还有为公牛、公绵羊和公羊羔同献的素祭和酒祭，都要按数目、照法规献上。 <verse eid="NUM 29:21" /><verse number="22" style="v" sid="NUM 29:22" />还要献一只公山羊作赎罪祭。这是在常献的燔祭和同献的素祭，以及同献的酒祭以外的燔祭。<verse eid="NUM 29:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 29:23" />“第四天，要献十头公牛、两只公绵羊、十四只一岁的公羊羔，都是无瑕疵的。 <verse eid="NUM 29:23" /><verse number="24" style="v" sid="NUM 29:24" />还有为公牛、公绵羊和公羊羔同献的素祭和酒祭，都要按数目、照法规献上。 <verse eid="NUM 29:24" /><verse number="25" style="v" sid="NUM 29:25" />还要献一只公山羊作赎罪祭。这是在常献的燔祭和同献的素祭，以及同献的酒祭以外的燔祭。<verse eid="NUM 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 29:26" />“第五天，要献九头公牛、两只公绵羊、十四只一岁的公羊羔，都是无瑕疵的。 <verse eid="NUM 29:26" /><verse number="27" style="v" sid="NUM 29:27" />还有为公牛、公绵羊和公羊羔同献的素祭和酒祭，都要按数目、照法规献上。 <verse eid="NUM 29:27" /><verse number="28" style="v" sid="NUM 29:28" />还要献一只公山羊作赎罪祭。这是在常献的燔祭和同献的素祭，以及同献的酒祭以外的燔祭。<verse eid="NUM 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 29:29" />“第六天，要献八头公牛、两只公绵羊、十四只一岁的公羊羔，都是无瑕疵的。 <verse eid="NUM 29:29" /><verse number="30" style="v" sid="NUM 29:30" />还有为公牛、公绵羊和公羊羔同献的素祭和酒祭，都要按数目、照法规献上。 <verse eid="NUM 29:30" /><verse number="31" style="v" sid="NUM 29:31" />还要献一只公山羊作赎罪祭。这是在常献的燔祭和同献的素祭，以及同献的酒祭以外的燔祭。<verse eid="NUM 29:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 29:32" />“第七天，要献七头公牛、两只公绵羊、十四只一岁的公羊羔，都是无瑕疵的。 <verse eid="NUM 29:32" /><verse number="33" style="v" sid="NUM 29:33" />还有为公牛、公绵羊和公羊羔同献的素祭和酒祭，都要按数目、照法规献上。 <verse eid="NUM 29:33" /><verse number="34" style="v" sid="NUM 29:34" />还要献一只公山羊作赎罪祭。这是在常献的燔祭和同献的素祭，以及同献的酒祭以外的燔祭。<verse eid="NUM 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 29:35" />“第八天，你们要有严肃集会，任何日常工作都不可做。 <verse eid="NUM 29:35" /><verse number="36" style="v" sid="NUM 29:36" />你们要献上一头公牛、一只公绵羊、七只一岁的公羊羔，都是无瑕疵的，作为燔祭，作为馨香的火祭献给耶和华。 <verse eid="NUM 29:36" /><verse number="37" style="v" sid="NUM 29:37" />还有为公牛、公绵羊和公羊羔同献的素祭和酒祭，都要按数目、照法规献上。 <verse eid="NUM 29:37" /><verse number="38" style="v" sid="NUM 29:38" />还要献一只公山羊作赎罪祭。这是在常献的燔祭和同献的素祭，以及同献的酒祭以外的燔祭。<verse eid="NUM 29:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 29:39" />“你们在所定的日期，在还愿祭和甘心祭的燔祭、素祭、酒祭和平安祭以外，还要把这些献给耶和华。”<verse eid="NUM 29:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 29:40" />于是，<char style="pn">摩西</char>照着耶和华所指示他的，把一切都告诉了<char style="pn">以色列</char>子民。<verse eid="NUM 29:40" /></para>
  <chapter eid="NUM 29" />
  <chapter number="30" style="c" sid="NUM 30" />
  <para style="s">关于许愿的条例</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 30:1" />
    <char style="pn">摩西</char>吩咐<char style="pn">以色列</char>子民各支派的首领说：“这是耶和华所指示的话： <verse eid="NUM 30:1" /><verse number="2" style="v" sid="NUM 30:2" />一个男人如果向耶和华许了愿，或者起了誓，以誓约来约束自己，他就不可食言，必须照着他口中说出的一切去做。<verse eid="NUM 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 30:3" />“一个女人年轻时在她的父家，如果向耶和华许了愿，以誓约来约束自己， <verse eid="NUM 30:3" /><verse number="4" style="v" sid="NUM 30:4" />她的父亲也听到她所许的愿以及她约束自己的誓约，却对她保持沉默，她所许的愿就全都有效，她约束自己的一切誓约也都有效。 <verse eid="NUM 30:4" /><verse number="5" style="v" sid="NUM 30:5" />但如果她父亲在听到的那天反对她，她所许的愿和她约束自己的誓约，就全都无效；耶和华也会赦免她，因为她父亲反对了她。<verse eid="NUM 30:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 30:6" />“如果她嫁人时，还有所许的愿在身，或者有约束自己的冒失话从她口中说出， <verse eid="NUM 30:6" /><verse number="7" style="v" sid="NUM 30:7" />她丈夫听到了，却在听到的那天对她保持沉默，她所许的愿就仍旧有效，她约束自己的誓约也仍旧有效。 <verse eid="NUM 30:7" /><verse number="8" style="v" sid="NUM 30:8" />但如果她丈夫在听到的那天反对她，丈夫就废除了她身上所许的愿，以及她口中说出约束自己的冒失话，而耶和华也会赦免她。<verse eid="NUM 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 30:9" />“至于寡妇或被休的妇人所许的愿，她所约束自己的一切誓约，都有效。<verse eid="NUM 30:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 30:10" />“如果女人在她丈夫家里许了愿，或者以誓约来约束自己， <verse eid="NUM 30:10" /><verse number="11" style="v" sid="NUM 30:11" />她丈夫听到了，却对她保持沉默，没有反对她，她所许的愿就全都有效，她约束自己的一切誓约也都有效。 <verse eid="NUM 30:11" /><verse number="12" style="v" sid="NUM 30:12" />但如果她丈夫在听到的那天把它们明确废除了，她口中说出的一切，无论是所许的愿还是她的誓约，就全都无效，她丈夫把它们废除了；而耶和华也会赦免她。 <verse eid="NUM 30:12" /><verse number="13" style="v" sid="NUM 30:13" />她所许的任何愿，以及刻苦约束自己的任何誓约，她丈夫都可以使它有效，或者把它废除。 <verse eid="NUM 30:13" /><verse number="14" style="v" sid="NUM 30:14" />她丈夫如果天天对她保持沉默，就使她所许的任何愿或她身上的任何誓约都有效了。她丈夫既然在听到的那天对她保持沉默，就使这些都有效了。 <verse eid="NUM 30:14" /><verse number="15" style="v" sid="NUM 30:15" />但如果她丈夫在听到之后，明确废除它们，丈夫就要承担她的罪责。”<verse eid="NUM 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 30:16" />这些是耶和华指示<char style="pn">摩西</char>的律例，涉及丈夫对妻子的责任<note caller="+" style="f"><char style="fr" closed="false">30:16 </char><char style="ft" closed="false">对……的责任——原文直译“与……之间”；下同。</char></note>，以及女儿年轻在父家时父亲对女儿的责任。<verse eid="NUM 30:16" /></para>
  <chapter eid="NUM 30" />
  <chapter number="31" style="c" sid="NUM 31" />
  <para style="s">与米甸人作战</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 31:1" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 31:1" /><verse number="2" style="v" sid="NUM 31:2" />“你要向<char style="pn">米甸</char>人报<char style="pn">以色列</char>人的仇，然后你将归到你的先人那里。”<verse eid="NUM 31:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 31:3" />
    <char style="pn">摩西</char>就吩咐民众：“你们当中要有一些人武装起来去作战，攻打<char style="pn">米甸</char>人，向<char style="pn">米甸</char>人施行耶和华的报复。 <verse eid="NUM 31:3" /><verse number="4" style="v" sid="NUM 31:4" /><char style="pn">以色列</char>所有支派中，每支派要派遣一千人去作战。” <verse eid="NUM 31:4" /><verse number="5" style="v" sid="NUM 31:5" />于是，从<char style="pn">以色列</char>千军中选出了一万两千武装起来作战的人，每支派有一千人。 <verse eid="NUM 31:5" /><verse number="6" style="v" sid="NUM 31:6" /><char style="pn">摩西</char>派他们去作战，每支派有一千人。他们和祭司<char style="pn">以利亚撒</char>的儿子<char style="pn">非尼哈</char>一起去作战，<char style="pn">非尼哈</char>手里带着圣所的器具和发令的号角。<verse eid="NUM 31:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 31:7" />他们就照着耶和华指示<char style="pn">摩西</char>的，与<char style="pn">米甸</char>人作战，杀死了<char style="pn">米甸</char>所有的男子。 <verse eid="NUM 31:7" /><verse number="8" style="v" sid="NUM 31:8" />在这些被杀的人以外，他们还杀了<char style="pn">米甸</char>的王，就是<char style="pn">埃维</char>、<char style="pn">利肯</char>、<char style="pn">苏珥</char>、<char style="pn">户珥</char>、<char style="pn">利巴</char>五个<char style="pn">米甸</char>王，并且用刀杀了<char style="pn">比珥</char>的儿子<char style="pn">巴兰</char>。 <verse eid="NUM 31:8" /><verse number="9" style="v" sid="NUM 31:9" /><char style="pn">以色列</char>人掳走了<char style="pn">米甸</char>人的妇女和孩童，还掠夺了他们所有的牛羊牲畜和财物， <verse eid="NUM 31:9" /><verse number="10" style="v" sid="NUM 31:10" />又用火烧了他们所住的一切城镇，以及他们所有的营寨。 <verse eid="NUM 31:10" /><verse number="11" style="v" sid="NUM 31:11" />他们把所有的掠物和所有的掳物，连人和牲畜都带走了。 <verse eid="NUM 31:11" /><verse number="12" style="v" sid="NUM 31:12" />他们把俘虏、掳物和掠物都带到营地，就在<char style="pn">耶利哥</char>东边<char style="pn">约旦</char>河对面的<char style="pn">摩押</char>平原那里，带给<char style="pn">摩西</char>和祭司<char style="pn">以利亚撒</char>以及<char style="pn">以色列</char>会众。<verse eid="NUM 31:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 31:13" />
    <char style="pn">摩西</char>和祭司<char style="pn">以利亚撒</char>，以及所有的会众领袖都出去，到营地外面迎接他们。 <verse eid="NUM 31:13" /><verse number="14" style="v" sid="NUM 31:14" />然而，<char style="pn">摩西</char>对那些从战阵上回来的军官千夫长和百夫长发怒。 <verse eid="NUM 31:14" /><verse number="15" style="v" sid="NUM 31:15" /><char style="pn">摩西</char>对他们说：“你们怎么让所有的女人都存活呢？ <verse eid="NUM 31:15" /><verse number="16" style="v" sid="NUM 31:16" />看哪，正是她们按照<char style="pn">巴兰</char>的计谋，使<char style="pn">以色列</char>子民在<char style="pn">毗珥</char>的事情上背叛耶和华，以致瘟疫临到了耶和华的会众！ <verse eid="NUM 31:16" /><verse number="17" style="v" sid="NUM 31:17" />现在，你们要把<char style="pn">米甸</char>所有的男孩杀死，也要把所有与男人同床共寝过的女人杀死； <verse eid="NUM 31:17" /><verse number="18" style="v" sid="NUM 31:18" />只有那些不曾与男人同寝过的女孩，可以让她们存活，归于你们。<verse eid="NUM 31:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 31:19" />“至于你们，要在营地外停留七天。你们和你们的俘虏，所有杀了人的、所有触碰了被杀之人的，都要在第三天和第七天洁净自己。 <verse eid="NUM 31:19" /><verse number="20" style="v" sid="NUM 31:20" />你们还要洁净每件衣服、每件皮具、每件羊毛织品和每件木器。”<verse eid="NUM 31:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 31:21" />祭司<char style="pn">以利亚撒</char>对那些作战回来的军人说：“这是耶和华指示<char style="pn">摩西</char>的律法条例： <verse eid="NUM 31:21" /><verse number="22" style="v" sid="NUM 31:22" />唯独金、银、铜、铁、锡、铅， <verse eid="NUM 31:22" /><verse number="23" style="v" sid="NUM 31:23" />这些经得起火烧的东西，你们要使它们经火洁净，但还要用除污秽的水使它们得洁净；至于那些经不起火烧的，要使它们经水洁净。 <verse eid="NUM 31:23" /><verse number="24" style="v" sid="NUM 31:24" />第七天，你们洗衣服，就洁净了，然后可以回营地。”<verse eid="NUM 31:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 31:25" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 31:25" /><verse number="26" style="v" sid="NUM 31:26" />“你和祭司<char style="pn">以利亚撒</char>，以及会众各父系的首领，要统计所掳来的掳物——连人带牲畜的数目。 <verse eid="NUM 31:26" /><verse number="27" style="v" sid="NUM 31:27" />你要在那些出征的战士和全体会众之间，同分掳物。 <verse eid="NUM 31:27" /><verse number="28" style="v" sid="NUM 31:28" />你还要从出征的战士所得的人、牛、驴和羊中，每五百个取一个，作为贡物献给耶和华。 <verse eid="NUM 31:28" /><verse number="29" style="v" sid="NUM 31:29" />你们要从他们那一半中取出这些，作为献给耶和华的供物交给祭司<char style="pn">以利亚撒</char>； <verse eid="NUM 31:29" /><verse number="30" style="v" sid="NUM 31:30" />也要从<char style="pn">以色列</char>子孙的这一半中，就是从人、牛、驴、羊以及各样牲畜中，每五十个取一个，交给谨守耶和华帐幕职责的<char style="pn">利未</char>人。”<verse eid="NUM 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 31:31" />
    <char style="pn">摩西</char>和祭司<char style="pn">以利亚撒</char>就照耶和华指示<char style="pn">摩西</char>的去做。 <verse eid="NUM 31:31" /><verse number="32" style="v" sid="NUM 31:32" />那些掳物，就是军兵所掠夺存留下来的掠物有：</para>
  <para style="q1" vid="NUM 31:32">羊六十七万五千只；<verse eid="NUM 31:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="NUM 31:33" />牛七万两千头；<verse eid="NUM 31:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="NUM 31:34" />驴六万一千匹；<verse eid="NUM 31:34" /></para>
  <para style="mi">
    <verse number="35" style="v" sid="NUM 31:35" />人口总共三万两千，都是没有与男人同寝过的女人。<verse eid="NUM 31:35" /></para>
  <para style="b" />
  <para style="p">
    <verse number="36" style="v" sid="NUM 31:36" />出征的人分得的那一半：</para>
  <para style="q1" vid="NUM 31:36">羊的数目是三十三万七千五百只，<verse eid="NUM 31:36" /></para>
  <para style="mi">
    <verse number="37" style="v" sid="NUM 31:37" />这些羊中归于耶和华的贡物有六百七十五只；<verse eid="NUM 31:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="NUM 31:38" />牛三万六千头，</para>
  <para style="q1" vid="NUM 31:38">其中归于耶和华的贡物有七十二头；<verse eid="NUM 31:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="NUM 31:39" />驴三万零五百匹，</para>
  <para style="q1" vid="NUM 31:39">其中归于耶和华的贡物有六十一匹；<verse eid="NUM 31:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="NUM 31:40" />人口一万六千，</para>
  <para style="q1" vid="NUM 31:40">其中归于耶和华的贡物有三十二人。<verse eid="NUM 31:40" /></para>
  <para style="b" />
  <para style="p">
    <verse number="41" style="v" sid="NUM 31:41" />
    <char style="pn">摩西</char>把贡物，就是献给耶和华的供物，交给了祭司<char style="pn">以利亚撒</char>，正如耶和华所指示<char style="pn">摩西</char>的。<verse eid="NUM 31:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 31:42" />
    <char style="pn">以色列</char>子孙的那一半，是<char style="pn">摩西</char>从作战的人取来分给他们的， <verse eid="NUM 31:42" /><verse number="43" style="v" sid="NUM 31:43" />会众的一半有：</para>
  <para style="q1" vid="NUM 31:43">羊三十三万七千五百只，<verse eid="NUM 31:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="NUM 31:44" />牛三万六千头，<verse eid="NUM 31:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="NUM 31:45" />驴三万零五百匹，<verse eid="NUM 31:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="NUM 31:46" />人口一万六千。<verse eid="NUM 31:46" /></para>
  <para style="b" />
  <para style="p">
    <verse number="47" style="v" sid="NUM 31:47" />
    <char style="pn">摩西</char>从<char style="pn">以色列</char>子孙的那一半中，无论是人还是牲畜，每五十个抽出一个，交给了谨守耶和华帐幕职责的<char style="pn">利未</char>人，正如耶和华所指示<char style="pn">摩西</char>的。<verse eid="NUM 31:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 31:48" />那些率领千军的军官，就是千夫长、百夫长，来到<char style="pn">摩西</char>那里， <verse eid="NUM 31:48" /><verse number="49" style="v" sid="NUM 31:49" />对<char style="pn">摩西</char>说：“你的仆人已经统计了我们手下战士的人数，我们没有少一个人。 <verse eid="NUM 31:49" /><verse number="50" style="v" sid="NUM 31:50" />我们带来了耶和华的祭物，就是各人所获得的金器——臂环、镯子、戒指、耳环、项链，要在耶和华面前为我们赎罪。”<verse eid="NUM 31:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="NUM 31:51" />
    <char style="pn">摩西</char>和祭司<char style="pn">以利亚撒</char>接受了他们的金器，全都是精工的首饰。 <verse eid="NUM 31:51" /><verse number="52" style="v" sid="NUM 31:52" />他们献给耶和华为供物的金子，就是千夫长和百夫长献出的，共有一万六千七百五十谢克尔<note caller="+" style="f"><char style="fr" closed="false">31:52 </char><char style="ft" closed="false">一万六千七百五十谢克尔——相当于191公斤。1谢克尔=11.4公克。</char></note>； <verse eid="NUM 31:52" /><verse number="53" style="v" sid="NUM 31:53" />军人们掠夺的，各归自己。 <verse eid="NUM 31:53" /><verse number="54" style="v" sid="NUM 31:54" /><char style="pn">摩西</char>和祭司<char style="pn">以利亚撒</char>接受了千夫长和百夫长的金子，带进会幕，为<char style="pn">以色列</char>子孙在耶和华面前作记念。<verse eid="NUM 31:54" /></para>
  <chapter eid="NUM 31" />
  <chapter number="32" style="c" sid="NUM 32" />
  <para style="s">外约旦河之地</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 32:1" />
    <char style="pn">鲁本</char>子孙和<char style="pn">迦得</char>子孙有许多牲畜，极其兴旺。他们观看<char style="pn">雅谢</char>地和<char style="pn">基列</char>地，发现那地方很适合放牧牲畜。 <verse eid="NUM 32:1" /><verse number="2" style="v" sid="NUM 32:2" />于是<char style="pn">迦得</char>子孙和<char style="pn">鲁本</char>子孙前来，对<char style="pn">摩西</char>和祭司<char style="pn">以利亚撒</char>，以及会众领袖们说： <verse eid="NUM 32:2" /><verse number="3" style="v" sid="NUM 32:3" />“<char style="pn">亚塔罗</char>、<char style="pn">迪本</char>、<char style="pn">雅谢</char>、<char style="pn">宁拉</char>、<char style="pn">希实本</char>、<char style="pn">以利亚利</char>、<char style="pn">谢巴姆</char>、<char style="pn">尼波</char>、<char style="pn">比稳</char>， <verse eid="NUM 32:3" /><verse number="4" style="v" sid="NUM 32:4" />就是耶和华在<char style="pn">以色列</char>会众面前所征服的土地，很适合放牧牲畜，而你的仆人们有许多牲畜。” <verse eid="NUM 32:4" /><verse number="5" style="v" sid="NUM 32:5" />他们接着说：“如果我们在你眼前蒙恩，就请把这地分给你的仆人作产业，不要领我们过<char style="pn">约旦</char>河。”<verse eid="NUM 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 32:6" />
    <char style="pn">摩西</char>对<char style="pn">迦得</char>子孙和<char style="pn">鲁本</char>子孙说：“难道你们的弟兄去作战，你们却要坐在这里吗？ <verse eid="NUM 32:6" /><verse number="7" style="v" sid="NUM 32:7" />你们为什么不过河前往耶和华赐给<char style="pn">以色列</char>子孙的土地，以致他们灰心丧胆呢？ <verse eid="NUM 32:7" /><verse number="8" style="v" sid="NUM 32:8" />我从<char style="pn">加低斯-巴尼亚</char>派你们的父辈去察看那地时，他们也这样做过。 <verse eid="NUM 32:8" /><verse number="9" style="v" sid="NUM 32:9" />他们上到<char style="pn">以实格</char>溪谷，察看了那地后，却使<char style="pn">以色列</char>子民灰心丧胆，不愿进入耶和华赐给他们的土地。 <verse eid="NUM 32:9" /><verse number="10" style="v" sid="NUM 32:10" />所以在那天，耶和华怒气发作，起誓说： <verse eid="NUM 32:10" /><verse number="11" style="v" sid="NUM 32:11" />‘从<char style="pn">埃及</char>上来的二十岁以上的男子，绝不会见到我起誓给<char style="pn">亚伯拉罕</char>、<char style="pn">以撒</char>、<char style="pn">雅各</char>的那地，因为他们没有全心跟从我。 <verse eid="NUM 32:11" /><verse number="12" style="v" sid="NUM 32:12" />只有<char style="pn">基尼洗</char>人<char style="pn">耶弗尼</char>的儿子<char style="pn">迦勒</char>和<char style="pn">嫩</char>的儿子<char style="pn">约书亚</char>例外，因为他们全心跟随耶和华。’ <verse eid="NUM 32:12" /><verse number="13" style="v" sid="NUM 32:13" />耶和华的怒气向<char style="pn">以色列</char>发作，使他们在旷野漂泊四十年，直到在耶和华眼前作恶的那整个世代都灭尽了。 <verse eid="NUM 32:13" /><verse number="14" style="v" sid="NUM 32:14" />看哪，你们这罪人的族类，你们起来接续你们的父辈，再次增添耶和华对<char style="pn">以色列</char>的猛烈怒气。 <verse eid="NUM 32:14" /><verse number="15" style="v" sid="NUM 32:15" />如果你们转离不跟从他，他必再次把<char style="pn">以色列</char>撇弃在旷野，那样你们就毁了这整个民族。”<verse eid="NUM 32:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 32:16" />于是，他们近前来说：“我们是要在这里为我们的牲畜建造围栏，为我们的家属建造城镇。 <verse eid="NUM 32:16" /><verse number="17" style="v" sid="NUM 32:17" />然后我们必武装起来，在<char style="pn">以色列</char>子孙前面领先前行，直到把他们带到他们的地方；我们的家属要留在坚固的城里，躲避这地的居民。 <verse eid="NUM 32:17" /><verse number="18" style="v" sid="NUM 32:18" />在<char style="pn">以色列</char>子孙各自继承他们的产业之前，我们绝不回自己的家； <verse eid="NUM 32:18" /><verse number="19" style="v" sid="NUM 32:19" />我们也不会在<char style="pn">约旦</char>河对岸那一带与大家同分产业，因为我们已经在<char style="pn">约旦</char>河东边分得了自己的产业。”<verse eid="NUM 32:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 32:20" />
    <char style="pn">摩西</char>就对他们说：“如果你们是要这样做，如果你们在耶和华面前武装起来去作战， <verse eid="NUM 32:20" /><verse number="21" style="v" sid="NUM 32:21" />你们所有武装起来的人就要在耶和华面前渡过<char style="pn">约旦</char>河，直到耶和华将仇敌从他面前赶出去。 <verse eid="NUM 32:21" /><verse number="22" style="v" sid="NUM 32:22" />当那地在耶和华面前被征服之后，你们才可以回来。这样你们就对耶和华和<char style="pn">以色列</char>尽责了，这地就在耶和华面前成为你们的产业。 <verse eid="NUM 32:22" /><verse number="23" style="v" sid="NUM 32:23" />但如果你们不这样做，看哪，你们就对耶和华犯罪了！要知道，你们的罪必找上你们。 <verse eid="NUM 32:23" /><verse number="24" style="v" sid="NUM 32:24" />你们就为家属建造城镇、为羊群建造围栏吧！但你们口里说出的，一定要实行。”<verse eid="NUM 32:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 32:25" />
    <char style="pn">迦得</char>子孙和<char style="pn">鲁本</char>子孙回答<char style="pn">摩西</char>说：“你的仆人们必照着我主所吩咐的去做。 <verse eid="NUM 32:25" /><verse number="26" style="v" sid="NUM 32:26" />我们的孩童、妻子，以及我们的牛羊和所有的牲畜，都会留在<char style="pn">基列</char>各城。 <verse eid="NUM 32:26" /><verse number="27" style="v" sid="NUM 32:27" />但你的仆人们，凡是武装起来的军兵，都会照着我主所吩咐的，在耶和华面前过河去作战。”<verse eid="NUM 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 32:28" />于是，<char style="pn">摩西</char>就为了他们吩咐祭司<char style="pn">以利亚撒</char>和<char style="pn">嫩</char>的儿子<char style="pn">约书亚</char>，以及<char style="pn">以色列</char>子孙各支派父系的首领。 <verse eid="NUM 32:28" /><verse number="29" style="v" sid="NUM 32:29" /><char style="pn">摩西</char>说：“<char style="pn">迦得</char>子孙和<char style="pn">鲁本</char>子孙，凡是武装起来在耶和华面前去作战的人，如果与你们一同过<char style="pn">约旦</char>河，并且那地在你们面前被征服了，你们就要把<char style="pn">基列</char>地分给他们作产业。 <verse eid="NUM 32:29" /><verse number="30" style="v" sid="NUM 32:30" />但如果他们不愿武装起来与你们一同过河，他们就要在<char style="pn">迦南</char>地与你们同分产业。”<verse eid="NUM 32:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 32:31" />
    <char style="pn">迦得</char>子孙和<char style="pn">鲁本</char>子孙回应说：“耶和华所吩咐你仆人们的，我们都必照样遵行。 <verse eid="NUM 32:31" /><verse number="32" style="v" sid="NUM 32:32" />我们会武装起来，在耶和华面前过河到<char style="pn">迦南</char>地，而我们继承的地业是在<char style="pn">约旦</char>河这边。”<verse eid="NUM 32:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 32:33" />于是，<char style="pn">摩西</char>把<char style="pn">亚摩利</char>王<char style="pn">西宏</char>的王国和<char style="pn">巴珊</char>王<char style="pn">欧革</char>的王国，就是他们境内的土地连同城镇，以及周围的土地和城镇，都分给了<char style="pn">迦得</char>子孙和<char style="pn">鲁本</char>子孙，以及<char style="pn">约瑟</char>的儿子<char style="pn">玛拿西</char>半支派。 <verse eid="NUM 32:33" /><verse number="34" style="v" sid="NUM 32:34" /><char style="pn">迦得</char>子孙就建造了<char style="pn">迪本</char>、<char style="pn">亚塔罗</char>、<char style="pn">亚罗珥</char>、 <verse eid="NUM 32:34" /><verse number="35" style="v" sid="NUM 32:35" /><char style="pn">亚他录-朔反</char>、<char style="pn">雅谢</char>、<char style="pn">约比哈</char>、 <verse eid="NUM 32:35" /><verse number="36" style="v" sid="NUM 32:36" /><char style="pn">伯宁拉</char>、<char style="pn">伯哈兰</char>，都是坚固的城，并建造了牲畜围栏。 <verse eid="NUM 32:36" /><verse number="37" style="v" sid="NUM 32:37" /><char style="pn">鲁本</char>子孙建造了<char style="pn">希实本</char>、<char style="pn">以利亚利</char>、<char style="pn">基列亭</char>、 <verse eid="NUM 32:37" /><verse number="38" style="v" sid="NUM 32:38" /><char style="pn">尼波</char>、<char style="pn">巴力梅翁</char>（这些名字是被改的）、<char style="pn">西比玛</char>。他们给所建造的城都起了别的名字。<verse eid="NUM 32:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 32:39" />
    <char style="pn">玛拿西</char>的儿子<char style="pn">玛吉</char>的子孙往<char style="pn">基列</char>去，攻取那地，把那里的<char style="pn">亚摩利</char>人赶了出去。 <verse eid="NUM 32:39" /><verse number="40" style="v" sid="NUM 32:40" />于是<char style="pn">摩西</char>把<char style="pn">基列</char>分给<char style="pn">玛拿西</char>的儿子<char style="pn">玛吉</char>，他就住在那里。 <verse eid="NUM 32:40" /><verse number="41" style="v" sid="NUM 32:41" /><char style="pn">玛拿西</char>的儿子<char style="pn">睚珥</char>也前去，攻取了<char style="pn">亚摩利</char>人的一些村镇，就称它们为<char style="pn">睚珥</char>镇。 <verse eid="NUM 32:41" /><verse number="42" style="v" sid="NUM 32:42" /><char style="pn">挪巴</char>也前去，攻取了<char style="pn">基纳</char>和附属的村镇，就以自己的名字称<char style="pn">基纳</char>为<char style="pn">挪巴</char>。<verse eid="NUM 32:42" /></para>
  <chapter eid="NUM 32" />
  <chapter number="33" style="c" sid="NUM 33" />
  <para style="s">旷野行程回顾</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 33:1" />以下是<char style="pn">以色列</char>子民在<char style="pn">摩西</char>和<char style="pn">亚伦</char>的指挥下，按队伍出<char style="pn">埃及</char>地的行程。 <verse eid="NUM 33:1" /><verse number="2" style="v" sid="NUM 33:2" /><char style="pn">摩西</char>照着耶和华的指示，记下他们每段行程的起点，以下是他们行程的各起点：<verse eid="NUM 33:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="NUM 33:3" />一月十五日，就是逾越节的第二天，<char style="pn">以色列</char>子孙从<char style="pn">拉美西斯</char>起程，在全体<char style="pn">埃及</char>人眼前昂然无惧地<note caller="+" style="f"><char style="fr" closed="false">33:3 </char><char style="ft" closed="false">昂然无惧地——原文直译“高举着手”。</char></note>出来了。 <verse eid="NUM 33:3" /><verse number="4" style="v" sid="NUM 33:4" />那时<char style="pn">埃及</char>人正在埋葬他们的长子，就是耶和华在他们中间所击杀的；耶和华也对他们的神明施行了审判。 <verse eid="NUM 33:4" /><verse number="5" style="v" sid="NUM 33:5" /><char style="pn">以色列</char>子孙从<char style="pn">拉美西斯</char>起程，在<char style="pn">疏割</char>扎营。<verse eid="NUM 33:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NUM 33:6" />然后从<char style="pn">疏割</char>起行，在旷野边缘的<char style="pn">伊坦</char>扎营。<verse eid="NUM 33:6" /></para>
  <para style="mi">
    <verse number="7" style="v" sid="NUM 33:7" />又从<char style="pn">伊坦</char>起行，然后转回到<char style="pn">巴力洗分</char>前面的<char style="pn">比哈希录</char>，在<char style="pn">密夺</char>附近扎营。<verse eid="NUM 33:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="NUM 33:8" />然后从<char style="pn">比哈希录</char>前面起行，从海里走过，到了旷野；又在<char style="pn">伊坦</char>旷野走了三天的路程，在<char style="pn">玛拉</char>扎营。<verse eid="NUM 33:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="NUM 33:9" />再从<char style="pn">玛拉</char>起行，来到<char style="pn">伊利姆</char>，<char style="pn">伊利姆</char>有十二股水泉和七十棵棕榈树；他们在那里扎营。<verse eid="NUM 33:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NUM 33:10" />然后从<char style="pn">伊利姆</char>起行，在<char style="pn">红海</char>边扎营。<verse eid="NUM 33:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="NUM 33:11" />又从<char style="pn">红海</char>起行，在<char style="pn">汛</char>的旷野扎营。<verse eid="NUM 33:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="NUM 33:12" />然后从<char style="pn">汛</char>的旷野起行，在<char style="pn">多夫卡</char>扎营。<verse eid="NUM 33:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="NUM 33:13" />又从<char style="pn">多夫卡</char>起行，在<char style="pn">阿卢什</char>扎营。<verse eid="NUM 33:13" /></para>
  <para style="mi">
    <verse number="14" style="v" sid="NUM 33:14" />再从<char style="pn">阿卢什</char>起行，在<char style="pn">利菲迪姆</char>扎营；</para>
  <para style="q1" vid="NUM 33:14">在那里，百姓没有水喝。<verse eid="NUM 33:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NUM 33:15" />从<char style="pn">利菲迪姆</char>起行，在<char style="pn">西奈</char>旷野扎营。<verse eid="NUM 33:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="NUM 33:16" />从<char style="pn">西奈</char>旷野起行，在<char style="pn">基布罗-哈特瓦</char>扎营。<verse eid="NUM 33:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="NUM 33:17" />从<char style="pn">基布罗-哈特瓦</char>起行，在<char style="pn">哈洗录</char>扎营。<verse eid="NUM 33:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 33:18" />从<char style="pn">哈洗录</char>起行，在<char style="pn">利提玛</char>扎营。<verse eid="NUM 33:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 33:19" />从<char style="pn">利提玛</char>起行，在<char style="pn">临门-法勒斯</char>扎营。<verse eid="NUM 33:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="NUM 33:20" />从<char style="pn">临门-法勒斯</char>起行，在<char style="pn">立拿</char>扎营。<verse eid="NUM 33:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="NUM 33:21" />从<char style="pn">立拿</char>起行，在<char style="pn">利撒</char>扎营。<verse eid="NUM 33:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 33:22" />从<char style="pn">利撒</char>起行，在<char style="pn">克希拉塔</char>扎营。<verse eid="NUM 33:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="NUM 33:23" />从<char style="pn">克希拉塔</char>起行，在<char style="pn">沙斐</char>山扎营。<verse eid="NUM 33:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 33:24" />从<char style="pn">沙斐</char>山起行，在<char style="pn">哈拉达</char>扎营。<verse eid="NUM 33:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="NUM 33:25" />从<char style="pn">哈拉达</char>起行，在<char style="pn">玛克希录</char>扎营。<verse eid="NUM 33:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="NUM 33:26" />从<char style="pn">玛克希录</char>起行，在<char style="pn">塔哈特</char>扎营。<verse eid="NUM 33:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="NUM 33:27" />从<char style="pn">塔哈特</char>起行，在<char style="pn">塔拉</char>扎营。<verse eid="NUM 33:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="NUM 33:28" />从<char style="pn">塔拉</char>起行，在<char style="pn">米特卡</char>扎营。<verse eid="NUM 33:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="NUM 33:29" />从<char style="pn">米特卡</char>起行，在<char style="pn">哈什莫纳</char>扎营。<verse eid="NUM 33:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="NUM 33:30" />从<char style="pn">哈什莫纳</char>起行，在<char style="pn">莫西洛</char>扎营。<verse eid="NUM 33:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="NUM 33:31" />从<char style="pn">莫西洛</char>起行，在<char style="pn">比尼-亚干</char>扎营。<verse eid="NUM 33:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="NUM 33:32" />从<char style="pn">比尼-亚干</char>起行，在<char style="pn">霍-哈吉加德</char>扎营。<verse eid="NUM 33:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="NUM 33:33" />从<char style="pn">霍-哈吉加德</char>起行，在<char style="pn">约特瓦塔</char>扎营。<verse eid="NUM 33:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="NUM 33:34" />从<char style="pn">约特瓦塔</char>起行，在<char style="pn">阿博拿</char>扎营。<verse eid="NUM 33:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="NUM 33:35" />从<char style="pn">阿博拿</char>起行，在<char style="pn">以旬迦别</char>扎营。<verse eid="NUM 33:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="NUM 33:36" />从<char style="pn">以旬迦别</char>起行，在<char style="pn">寻</char>的旷野，就是<char style="pn">加低斯</char>扎营。<verse eid="NUM 33:36" /></para>
  <para style="mi">
    <verse number="37" style="v" sid="NUM 33:37" />然后从<char style="pn">加低斯</char>起行，在<char style="pn">以东</char>地边界的<char style="pn">何珥</char>山扎营。 <verse eid="NUM 33:37" /><verse number="38" style="v" sid="NUM 33:38" /><char style="pn">以色列</char>子孙出<char style="pn">埃及</char>地之后，第四十年的五月一日，祭司<char style="pn">亚伦</char>按照耶和华的指示上<char style="pn">何珥</char>山，然后死在那里。 <verse eid="NUM 33:38" /><verse number="39" style="v" sid="NUM 33:39" /><char style="pn">亚伦</char>死在<char style="pn">何珥</char>山上的时候，一百二十三岁。 <verse eid="NUM 33:39" /><verse number="40" style="v" sid="NUM 33:40" />那时，住在<char style="pn">迦南</char>地南方<note caller="+" style="f"><char style="fr" closed="false">33:40 </char><char style="ft" closed="false">南方——音译作“尼革夫”。</char></note>的<char style="pn">迦南</char>王<char style="pn">阿拉德</char>，听说<char style="pn">以色列</char>人来了。<verse eid="NUM 33:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="NUM 33:41" />
    <char style="pn">以色列</char>子孙又从<char style="pn">何珥</char>山起行，在<char style="pn">撒摩拿</char>扎营。<verse eid="NUM 33:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="NUM 33:42" />然后从<char style="pn">撒摩拿</char>起行，在<char style="pn">普嫩</char>扎营。<verse eid="NUM 33:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="NUM 33:43" />从<char style="pn">普嫩</char>起行，在<char style="pn">奥伯特</char>扎营。<verse eid="NUM 33:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="NUM 33:44" />从<char style="pn">奥伯特</char>起行，在<char style="pn">摩押</char>边界上的<char style="pn">伊耶-亚巴琳</char>扎营。<verse eid="NUM 33:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="NUM 33:45" />从<char style="pn">伊音</char><note caller="+" style="f"><char style="fr" closed="false">33:45 </char><char style="ft" closed="false">伊音——指伊耶-亚巴琳。</char></note>起行，在<char style="pn">迪本-迦得</char>扎营。<verse eid="NUM 33:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="NUM 33:46" />从<char style="pn">迪本-迦得</char>起行，在<char style="pn">阿勒蒙-迪布拉泰姆</char>扎营。<verse eid="NUM 33:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="NUM 33:47" />从<char style="pn">阿勒蒙-迪布拉泰姆</char>起行，在<char style="pn">尼波</char>对面的<char style="pn">亚巴琳</char>山扎营。<verse eid="NUM 33:47" /></para>
  <para style="mi">
    <verse number="48" style="v" sid="NUM 33:48" />从<char style="pn">亚巴琳</char>山起行，在<char style="pn">耶利哥</char>东边<char style="pn">约旦</char>河对面的<char style="pn">摩押</char>平原扎营。 <verse eid="NUM 33:48" /><verse number="49" style="v" sid="NUM 33:49" />他们在<char style="pn">摩押</char>平原沿着<char style="pn">约旦</char>河扎营，从<char style="pn">伯耶西莫</char>直到<char style="pn">阿贝勒什亭</char>。<verse eid="NUM 33:49" /></para>
  <para style="s">继承迦南的指示</para>
  <para style="p">
    <verse number="50" style="v" sid="NUM 33:50" />那时，耶和华在<char style="pn">耶利哥</char>东边<char style="pn">约旦</char>河对面的<char style="pn">摩押</char>平原指示<char style="pn">摩西</char>说： <verse eid="NUM 33:50" /><verse number="51" style="v" sid="NUM 33:51" />“你要吩咐<char style="pn">以色列</char>子民，对他们说：当你们过了<char style="pn">约旦</char>河，到<char style="pn">迦南</char>地时， <verse eid="NUM 33:51" /><verse number="52" style="v" sid="NUM 33:52" />要把那地的居民全都从你们面前赶出去，并且毁掉他们所有的雕像，毁掉他们所铸造的一切偶像，拆毁他们所有的高坛。 <verse eid="NUM 33:52" /><verse number="53" style="v" sid="NUM 33:53" />你们要占有那地，住在其中，因为我已经把那地赐给你们，让你们继承它。 <verse eid="NUM 33:53" /><verse number="54" style="v" sid="NUM 33:54" />你们要按家族，以抽签的方式分得那地为继业。人多的，多给他们继业；人少的，少给他们继业；签抽到哪里，哪里就归属那人。你们要按你们的父系支派分得继业。 <verse eid="NUM 33:54" /><verse number="55" style="v" sid="NUM 33:55" />但如果你们不把那地的居民从你们面前赶出去，你所留下的那些人必成为你们眼中的刺、肋旁的荆棘，他们会在你们所住的地上扰害你们； <verse eid="NUM 33:55" /><verse number="56" style="v" sid="NUM 33:56" />而且，我曾怎样计划对待他们，也将怎样对待你们。”<verse eid="NUM 33:56" /></para>
  <chapter eid="NUM 33" />
  <chapter number="34" style="c" sid="NUM 34" />
  <para style="s">应许之地的边界</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 34:1" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 34:1" /><verse number="2" style="v" sid="NUM 34:2" />“你要吩咐<char style="pn">以色列</char>子民，对他们说：你们进入<char style="pn">迦南</char>地之后分得为继业的<char style="pn">迦南</char>之地，其边界如下：<verse eid="NUM 34:2" /></para>
  <para style="mi">
    <verse number="3" style="v" sid="NUM 34:3" />你们的南端是从<char style="pn">寻</char>的旷野起，沿着<char style="pn">以东</char>的边境延伸；南面的边界是从盐海的东边开始。 <verse eid="NUM 34:3" /><verse number="4" style="v" sid="NUM 34:4" />边界从<char style="pn">阿克拉宾</char>斜坡的南边转过去，经过<char style="pn">寻</char>的旷野，抵达<char style="pn">加低斯-巴尼亚</char>南边的尽头，然后延伸到<char style="pn">哈萨-阿达尔</char>，再经过<char style="pn">阿兹蒙</char>。 <verse eid="NUM 34:4" /><verse number="5" style="v" sid="NUM 34:5" />边界接着从<char style="pn">阿兹蒙</char>转到<char style="pn">埃及</char>河，终点是大海<note caller="+" style="f"><char style="fr" closed="false">34:5 </char><char style="ft" closed="false">大海——指地中海；下同。</char></note>。<verse eid="NUM 34:5" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="6" style="v" sid="NUM 34:6" />至于你们西面的边界，是大海和海岸线；这就是你们西面的边界。<verse eid="NUM 34:6" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="7" style="v" sid="NUM 34:7" />你们北面的边界如下：从大海开始，划界到<char style="pn">何珥</char>山。 <verse eid="NUM 34:7" /><verse number="8" style="v" sid="NUM 34:8" />又从<char style="pn">何珥</char>山划界到<char style="pn">哈马</char>隘口，终点是<char style="pn">泽达德</char>。 <verse eid="NUM 34:8" /><verse number="9" style="v" sid="NUM 34:9" />边界又延伸到<char style="pn">基弗仑</char>，终点是<char style="pn">哈萨耶楠</char>。这就是你们北面的边界。<verse eid="NUM 34:9" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="10" style="v" sid="NUM 34:10" />你们东面的边界，要从<char style="pn">哈萨耶楠</char>划界到<char style="pn">谢法姆</char>。 <verse eid="NUM 34:10" /><verse number="11" style="v" sid="NUM 34:11" />边界从<char style="pn">谢法姆</char>下到<char style="pn">阿音</char>东边的<char style="pn">利比拉</char>，然后往下，<char style="pn">伸展</char>到<char style="pn">革尼勒</char>湖<note caller="+" style="f"><char style="fr" closed="false">34:11 </char><char style="ft" closed="false">革尼勒湖——指加利利海；又称“革尼撒勒湖、太巴列湖”。</char></note>的东侧。 <verse eid="NUM 34:11" /><verse number="12" style="v" sid="NUM 34:12" />又下到<char style="pn">约旦</char>河，终点是盐海。</para>
  <para style="b" vid="NUM 34:12" />
  <para style="mi" vid="NUM 34:12">以上就是你们土地四围的边界。”<verse eid="NUM 34:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="NUM 34:13" />于是，<char style="pn">摩西</char>吩咐<char style="pn">以色列</char>子民说：“这是你们要以抽签的方式来继承的土地，是耶和华指示要分给九个半支派的。 <verse eid="NUM 34:13" /><verse number="14" style="v" sid="NUM 34:14" />因为<char style="pn">鲁本</char>支派按父家取得了他们的继业，<char style="pn">迦得</char>支派按父家取得了他们的继业，<char style="pn">玛拿西</char>半支派也取得了他们的继业， <verse eid="NUM 34:14" /><verse number="15" style="v" sid="NUM 34:15" />这两个半支派已经在<char style="pn">耶利哥</char>对面，<char style="pn">约旦</char>河东边日出的方向，取得了他们的继业。”<verse eid="NUM 34:15" /></para>
  <para style="s">分配土地的领袖们</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 34:16" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 34:16" /><verse number="17" style="v" sid="NUM 34:17" />“以下是要为你们分配地业之人的名字：祭司<char style="pn">以利亚撒</char>，<char style="pn">嫩</char>的儿子<char style="pn">约书亚</char>。 <verse eid="NUM 34:17" /><verse number="18" style="v" sid="NUM 34:18" />还要从每支派选出一位领袖，来协助分配土地为继业， <verse eid="NUM 34:18" /><verse number="19" style="v" sid="NUM 34:19" />这些人的名字是：</para>
  <para style="q1" vid="NUM 34:19">
    <char style="pn">耶弗尼</char>的儿子<char style="pn">迦勒</char>，</para>
  <para style="q1" vid="NUM 34:19">属<char style="pn">犹大</char>支派；<verse eid="NUM 34:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="NUM 34:20" />
    <char style="pn">亚米忽</char>的儿子<char style="pn">撒母耳</char>，</para>
  <para style="q1" vid="NUM 34:20">属<char style="pn">西缅</char>支派；<verse eid="NUM 34:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="NUM 34:21" />
    <char style="pn">基斯伦</char>的儿子<char style="pn">伊利达德</char>，</para>
  <para style="q1" vid="NUM 34:21">属<char style="pn">便雅悯</char>支派；<verse eid="NUM 34:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 34:22" />
    <char style="pn">约格利</char>的儿子<char style="pn">布其</char>，</para>
  <para style="q1" vid="NUM 34:22">是<char style="pn">但</char>支派的领袖；<verse eid="NUM 34:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="NUM 34:23" />
    <char style="pn">约瑟</char>子孙<char style="pn">以弗</char>的儿子<char style="pn">哈尼业</char>，</para>
  <para style="q1" vid="NUM 34:23">是<char style="pn">玛拿西</char>支派的领袖；<verse eid="NUM 34:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 34:24" />
    <char style="pn">示弗坦</char>的儿子<char style="pn">基姆利</char>，</para>
  <para style="q1" vid="NUM 34:24">是<char style="pn">以法莲</char>支派的领袖；<verse eid="NUM 34:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="NUM 34:25" />
    <char style="pn">帕尔纳克</char>的儿子<char style="pn">以利撒番</char>，</para>
  <para style="q1" vid="NUM 34:25">是<char style="pn">西布伦</char>支派的领袖；<verse eid="NUM 34:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="NUM 34:26" />
    <char style="pn">阿赞</char>的儿子<char style="pn">帕尔提业</char>，</para>
  <para style="q1" vid="NUM 34:26">是<char style="pn">以萨迦</char>支派的领袖；<verse eid="NUM 34:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="NUM 34:27" />
    <char style="pn">示罗米</char>的儿子<char style="pn">亚希忽</char>，</para>
  <para style="q1" vid="NUM 34:27">是<char style="pn">亚设</char>支派的领袖；<verse eid="NUM 34:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="NUM 34:28" />
    <char style="pn">亚米忽</char>的儿子<char style="pn">佩达业</char>，</para>
  <para style="q1" vid="NUM 34:28">是<char style="pn">拿弗他利</char>支派的领袖。<verse eid="NUM 34:28" /></para>
  <para style="b" />
  <para style="p">
    <verse number="29" style="v" sid="NUM 34:29" />以上就是耶和华所吩咐，要在<char style="pn">迦南</char>地给<char style="pn">以色列</char>子孙分配继业的人。”<verse eid="NUM 34:29" /></para>
  <chapter eid="NUM 34" />
  <chapter number="35" style="c" sid="NUM 35" />
  <para style="s">利未人的城</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 35:1" />耶和华在<char style="pn">耶利哥</char>东边<char style="pn">约旦</char>河对面的<char style="pn">摩押</char>平原，指示<char style="pn">摩西</char>说： <verse eid="NUM 35:1" /><verse number="2" style="v" sid="NUM 35:2" />“你要吩咐<char style="pn">以色列</char>子民，让他们从所得的继业中，分给<char style="pn">利未</char>人一些城居住，也把这些城周围的牧野给<char style="pn">利未</char>人。 <verse eid="NUM 35:2" /><verse number="3" style="v" sid="NUM 35:3" />这些城要用来给他们居住，而牧野用来安置他们所拥有的牛羊<note caller="+" style="f"><char style="fr" closed="false">35:3 </char><char style="ft" closed="false">他们所拥有的牛羊——或译作“他们的牛羊、他们的财物”。</char></note>和一切牲畜。 <verse eid="NUM 35:3" /><verse number="4" style="v" sid="NUM 35:4" />你们给<char style="pn">利未</char>人的那些城郊牧野，要从城墙算起，四围向外一千肘<note caller="+" style="f"><char style="fr" closed="false">35:4 </char><char style="ft" closed="false">一千肘——相当于457公尺。1肘=45.7公分。</char></note>； <verse eid="NUM 35:4" /><verse number="5" style="v" sid="NUM 35:5" />然后从城外那里测量，向东边两千肘<note caller="+" style="f"><char style="fr" closed="false">35:5 </char><char style="ft" closed="false">两千肘——相当于914公尺；下同。</char></note>，向南边两千肘，向西边两千肘，向北边两千肘，城要在中间。这是给他们的城郊牧野。<verse eid="NUM 35:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 35:6" />“你们给<char style="pn">利未</char>人的城，其中要有六座逃城，让过失杀人者可以逃到那里；在六座之外，还要给他们四十二座城。 <verse eid="NUM 35:6" /><verse number="7" style="v" sid="NUM 35:7" />你们要给<char style="pn">利未</char>人的城一共是四十八座城，还包括城郊的牧野。 <verse eid="NUM 35:7" /><verse number="8" style="v" sid="NUM 35:8" />你们从<char style="pn">以色列</char>子孙的产业中分给<char style="pn">利未</char>人那些城，多的要多给，少的要少给。各支派要根据所得的继业，把一些城分给<char style="pn">利未</char>人。”<verse eid="NUM 35:8" /></para>
  <para style="s">逃城</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 35:9" />耶和华指示<char style="pn">摩西</char>说： <verse eid="NUM 35:9" /><verse number="10" style="v" sid="NUM 35:10" />“你要吩咐<char style="pn">以色列</char>子民，对他们说：当你们过了<char style="pn">约旦</char>河，到<char style="pn">迦南</char>地时， <verse eid="NUM 35:10" /><verse number="11" style="v" sid="NUM 35:11" />要为自己选定几座城作逃城，使无意中杀了人的凶手可以逃到那里。 <verse eid="NUM 35:11" /><verse number="12" style="v" sid="NUM 35:12" />这些城要作你们逃避报血仇者的避难所，这样过失杀人者就不至于死，等候站在会众面前受审判。 <verse eid="NUM 35:12" /><verse number="13" style="v" sid="NUM 35:13" />你们分给<char style="pn">利未</char>人的城，有六座要为你们作逃城： <verse eid="NUM 35:13" /><verse number="14" style="v" sid="NUM 35:14" />在<char style="pn">约旦</char>河对岸指定三座城，在<char style="pn">迦南</char>地也指定三座城，作为逃城。 <verse eid="NUM 35:14" /><verse number="15" style="v" sid="NUM 35:15" />这六座城要给<char style="pn">以色列</char>子孙，以及那些外人和寄居在他们中间的人作避难所，好让任何无意中杀了人的可以逃到那里。<verse eid="NUM 35:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 35:16" />“但如果有人用铁器打人致死，他就是故意杀人的，这凶手必须被处死。 <verse eid="NUM 35:16" /><verse number="17" style="v" sid="NUM 35:17" />如果有人手里拿着可打死人的石头打人致死，他就是故意杀人的，这凶手必须被处死。 <verse eid="NUM 35:17" /><verse number="18" style="v" sid="NUM 35:18" />或者有人手里拿着可打死人的木器打人致死，他就是故意杀人的，这凶手必须被处死。 <verse eid="NUM 35:18" /><verse number="19" style="v" sid="NUM 35:19" />报血仇的人要亲自把凶手处死，遇见他时，就要处死他。 <verse eid="NUM 35:19" /><verse number="20" style="v" sid="NUM 35:20" />如果有人因仇恨推倒人或故意向人扔东西，致其死亡， <verse eid="NUM 35:20" /><verse number="21" style="v" sid="NUM 35:21" />或者因仇恨动手打人致死，这打死人的必须被处死，他是故意杀人的。报血仇的人遇见凶手时，就要把他处死。<verse eid="NUM 35:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 35:22" />“如果有人毫无仇恨而突然推倒了人，或者并非故意把任何器具扔在人身上， <verse eid="NUM 35:22" /><verse number="23" style="v" sid="NUM 35:23" />或者因没看见而把任何可打死人的石头砸在人身上，致其死亡，他本不是那人的仇敌，也不是谋害那人， <verse eid="NUM 35:23" /><verse number="24" style="v" sid="NUM 35:24" />会众就要在这凶手和报血仇的人之间，按照这些法规审判。 <verse eid="NUM 35:24" /><verse number="25" style="v" sid="NUM 35:25" />会众要从报血仇的人手中救出这过失杀人者，让他回到他曾逃入的逃城。他要住在城中，直到以圣油膏立的大祭司去世。<verse eid="NUM 35:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 35:26" />“但如果那过失杀人者擅自出了他所逃入的逃城的地界， <verse eid="NUM 35:26" /><verse number="27" style="v" sid="NUM 35:27" />报血仇的人在逃城地界外遇见那杀人者，把他杀了，报血仇的人并不负血债。 <verse eid="NUM 35:27" /><verse number="28" style="v" sid="NUM 35:28" />因为那过失杀人者应该留在逃城，直到大祭司去世；大祭司去世以后，他才可以回到他产业之地。 <verse eid="NUM 35:28" /><verse number="29" style="v" sid="NUM 35:29" />这要在你们居住的任何地方，作你们世世代代的律例法规。<verse eid="NUM 35:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 35:30" />“无论谁杀了人，都要凭几个见证人的口来处决凶手；不可只凭一个见证人的指证来处死人。 <verse eid="NUM 35:30" /><verse number="31" style="v" sid="NUM 35:31" />你们不可接受赎金来保全杀人者的性命，他犯了死罪，必须被处死。 <verse eid="NUM 35:31" /><verse number="32" style="v" sid="NUM 35:32" />你们也不可接受那逃入逃城之人的赎金，让他在大祭司去世之前回本地居住。<verse eid="NUM 35:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 35:33" />“这样，你们就不会玷污你们所在之地，因为血会使地玷污；如果有血流在地上，除非藉着那流人血之人的血，地就无法赎清罪污。 <verse eid="NUM 35:33" /><verse number="34" style="v" sid="NUM 35:34" />你们不可玷污所住之地，因为我也住在那里，我耶和华就住在<char style="pn">以色列</char>子民中间。”<verse eid="NUM 35:34" /></para>
  <chapter eid="NUM 35" />
  <chapter number="36" style="c" sid="NUM 36" />
  <para style="s">西罗非哈女儿们的产业</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 36:1" />
    <char style="pn">约瑟</char>子孙的家族中，<char style="pn">玛拿西</char>的孙子、<char style="pn">玛吉</char>的儿子<char style="pn">基列</char>的子孙各家族的父系首领上前来，在<char style="pn">摩西</char>和领袖们——<char style="pn">以色列</char>子孙的各父系首领们面前申诉， <verse eid="NUM 36:1" /><verse number="2" style="v" sid="NUM 36:2" />说：“耶和华曾吩咐我主以抽签的方式把地分给<char style="pn">以色列</char>子孙为继业，我主又受耶和华的吩咐，要把我们兄弟<char style="pn">西罗非哈</char>的继业给他的女儿们。 <verse eid="NUM 36:2" /><verse number="3" style="v" sid="NUM 36:3" />可是，如果她们嫁给<char style="pn">以色列</char>子孙其他支派的人，那么她们的继业就会从我们祖先的继业中减去，加到她们丈夫<note caller="+" style="f"><char style="fr" closed="false">36:3 </char><char style="ft" closed="false">丈夫——原文直译“所属的”；下同。</char></note>那个支派的继业上，这继业就从我们抽签所得的继业中减去了。 <verse eid="NUM 36:3" /><verse number="4" style="v" sid="NUM 36:4" />即使到了<char style="pn">以色列</char>子孙的禧年，她们的继业也会被加到她们丈夫那个支派的继业上。这样，她们的继业就从我们父家支派的继业中减去了。”<verse eid="NUM 36:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 36:5" />
    <char style="pn">摩西</char>按照耶和华的指示，吩咐<char style="pn">以色列</char>子民说：“<char style="pn">约瑟</char>支派的人说得对。 <verse eid="NUM 36:5" /><verse number="6" style="v" sid="NUM 36:6" />这是耶和华关于<char style="pn">西罗非哈</char>的女儿们所指示的话：她们可以嫁给自己眼中看为好的，只是必须嫁给自己父系支派家族的人。 <verse eid="NUM 36:6" /><verse number="7" style="v" sid="NUM 36:7" />这样，<char style="pn">以色列</char>子孙的继业就不会从一个支派转到另一个支派了；<char style="pn">以色列</char>子孙必须守住各自父家支派的继业。 <verse eid="NUM 36:7" /><verse number="8" style="v" sid="NUM 36:8" /><char style="pn">以色列</char>子孙各支派中凡是继承产业的女子，只能嫁给她父系支派家族中的人，好让<char style="pn">以色列</char>子孙能各自继承自己祖先的产业。 <verse eid="NUM 36:8" /><verse number="9" style="v" sid="NUM 36:9" />这样，继业就不会从一个支派转到另一个支派了；<char style="pn">以色列</char>子孙各支派必须守住各自的继业。”<verse eid="NUM 36:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 36:10" />耶和华怎样指示<char style="pn">摩西</char>，<char style="pn">西罗非哈</char>的女儿们就怎样做。 <verse eid="NUM 36:10" /><verse number="11" style="v" sid="NUM 36:11" /><char style="pn">西罗非哈</char>的女儿<char style="pn">玛拉</char>、<char style="pn">提尔撒</char>、<char style="pn">霍格拉</char>、<char style="pn">米尔卡</char>、<char style="pn">挪阿</char>，嫁给了她们叔伯的儿子们为妻。 <verse eid="NUM 36:11" /><verse number="12" style="v" sid="NUM 36:12" />她们嫁给<char style="pn">约瑟</char>的儿子<char style="pn">玛拿西</char>子孙家族中的人，这样她们的继业就留在了她们父系家族的支派中。<verse eid="NUM 36:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 36:13" />以上是耶和华在<char style="pn">耶利哥</char>东边<char style="pn">约旦</char>河对面的<char style="pn">摩押</char>平原，藉着<char style="pn">摩西</char>向<char style="pn">以色列</char>子民颁布的诫命和法规。<verse eid="NUM 36:13" /></para>
  <chapter eid="NUM 36" />
</usx>