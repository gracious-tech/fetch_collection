<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id">CHINESE STANDARD BIBLE©, Copyright © 2005, 2008, 2011, 2025, 2026 by Global Bible Initiative [1.1.2026.0507]</book>
  <para style="h">阿摩司书</para>
  <para style="mt">阿摩司书</para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />
    <char style="pn">提克亚</char>的一位牧人<char style="pn">阿摩司</char>的异象。在<char style="pn">犹大</char>王<char style="pn">乌西雅</char>年间、<char style="pn">约阿施</char>的儿子<char style="pn">以色列</char>王<char style="pn">耶罗波安</char>年间，就是大地震的前两年，他见了有关<char style="pn">以色列</char>的异象。 <verse eid="AMO 1:1" /><verse number="2" style="v" sid="AMO 1:2" />他说：</para>
  <para style="q1" vid="AMO 1:2">耶和华从<char style="pn">锡安</char>吼叫，</para>
  <para style="q1" vid="AMO 1:2">从<char style="pn">耶路撒冷</char>发声，</para>
  <para style="q1" vid="AMO 1:2">牧人们的草场就荒芜，</para>
  <para style="q1" vid="AMO 1:2">
    <char style="pn">迦密</char>山顶也枯干。<verse eid="AMO 1:2" /></para>
  <para style="s">审判以色列的邻邦</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3" />耶和华如此说：</para>
  <para style="q1" vid="AMO 1:3">因<char style="pn">大马士革</char>三番四次地犯罪，</para>
  <para style="q1" vid="AMO 1:3">因他们用铁碾滚轧<char style="pn">基列</char>，</para>
  <para style="q1" vid="AMO 1:3">我绝不撤回对它的审判<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">审判——辅助词语；本章下同。</char></note>。<verse eid="AMO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 1:4" />我要降火在<char style="pn">哈薛</char>的宫殿，</para>
  <para style="q1" vid="AMO 1:4">使火吞噬<char style="pn">本哈达</char>的城堡。<verse eid="AMO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 1:5" />我要打断<char style="pn">大马士革</char>的门闩，</para>
  <para style="q1" vid="AMO 1:5">剪除<char style="pn">亚文</char>平原<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">亚文平原——意思是“邪恶平原”。</char></note>的居民<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">居民——或译作“统治者”；本章下同。</char></note>，</para>
  <para style="q1" vid="AMO 1:5">剪除<char style="pn">伯伊甸</char><note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">伯伊甸——意思是“快乐之家”。</char></note>的掌权者，</para>
  <para style="q1" vid="AMO 1:5">
    <char style="pn">亚兰</char>的民众必被掳到<char style="pn">吉珥</char>。</para>
  <para style="q1" vid="AMO 1:5">这是耶和华说的。<verse eid="AMO 1:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6" />耶和华如此说：</para>
  <para style="q1" vid="AMO 1:6">因<char style="pn">加沙</char>三番四次地犯罪，</para>
  <para style="q1" vid="AMO 1:6">因他们掳走全体掳民，</para>
  <para style="q1" vid="AMO 1:6">交给<char style="pn">以东</char>，</para>
  <para style="q1" vid="AMO 1:6">我绝不撤回对它的审判。<verse eid="AMO 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 1:7" />我要降火在<char style="pn">加沙</char>的城墙上，</para>
  <para style="q1" vid="AMO 1:7">使火吞噬它的城堡。<verse eid="AMO 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 1:8" />我要剪除<char style="pn">阿实突</char>的居民，</para>
  <para style="q1" vid="AMO 1:8">剪除<char style="pn">阿实基伦</char>的掌权者。</para>
  <para style="q1" vid="AMO 1:8">我要转手对付<char style="pn">以革伦</char>，</para>
  <para style="q1" vid="AMO 1:8">
    <char style="pn">非利士</char>余剩之民必灭亡。</para>
  <para style="q1" vid="AMO 1:8">这是主耶和华说的。<verse eid="AMO 1:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9" />耶和华如此说：</para>
  <para style="q1" vid="AMO 1:9">因<char style="pn">提尔</char>三番四次地犯罪，</para>
  <para style="q1" vid="AMO 1:9">因他们不顾念兄弟盟约，</para>
  <para style="q1" vid="AMO 1:9">而把全体掳民交给<char style="pn">以东</char>，</para>
  <para style="q1" vid="AMO 1:9">我绝不撤回对它的审判。<verse eid="AMO 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 1:10" />我要降火在<char style="pn">提尔</char>的城墙上，</para>
  <para style="q1" vid="AMO 1:10">使火吞噬它的城堡。<verse eid="AMO 1:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11" />耶和华如此说：</para>
  <para style="q1" vid="AMO 1:11">因<char style="pn">以东</char>三番四次地犯罪，</para>
  <para style="q1" vid="AMO 1:11">因他拿刀剑追赶兄弟，</para>
  <para style="q1" vid="AMO 1:11">泯灭了怜悯之心，</para>
  <para style="q1" vid="AMO 1:11">因他的怒气长久发作，</para>
  <para style="q1" vid="AMO 1:11">他的盛怒持续不停，</para>
  <para style="q1" vid="AMO 1:11">我绝不撤回对它的审判。<verse eid="AMO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 1:12" />我要降火在<char style="pn">提幔</char>，</para>
  <para style="q1" vid="AMO 1:12">使火吞噬<char style="pn">伯斯拉</char>的城堡。<verse eid="AMO 1:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13" />耶和华如此说：</para>
  <para style="q1" vid="AMO 1:13">因<char style="pn">亚扪</char>人三番四次地犯罪，</para>
  <para style="q1" vid="AMO 1:13">因他们为了扩张地界</para>
  <para style="q1" vid="AMO 1:13">而剖开<char style="pn">基列</char>的孕妇，</para>
  <para style="q1" vid="AMO 1:13">我绝不撤回对它的审判。<verse eid="AMO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 1:14" />我要在争战之日的呐喊中，</para>
  <para style="q1" vid="AMO 1:14">在旋风之日的狂风中，</para>
  <para style="q1" vid="AMO 1:14">点火焚烧<char style="pn">拉巴</char>的城墙，</para>
  <para style="q1" vid="AMO 1:14">使火吞噬它的城堡。<verse eid="AMO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 1:15" />他们的王必被掳去，</para>
  <para style="q1" vid="AMO 1:15">王和他的首领都将被掳。</para>
  <para style="q1" vid="AMO 1:15">这是耶和华说的。<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="nb">
    <verse number="1" style="v" sid="AMO 2:1" />耶和华如此说：</para>
  <para style="q1" vid="AMO 2:1">因<char style="pn">摩押</char>三番四次地犯罪，</para>
  <para style="q1" vid="AMO 2:1">因他把<char style="pn">以东</char>王的骨头焚烧成灰，</para>
  <para style="q1" vid="AMO 2:1">我绝不撤回对它的审判<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">审判——辅助词语；本章下同。</char></note>。<verse eid="AMO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 2:2" />我要降火在<char style="pn">摩押</char>，</para>
  <para style="q1" vid="AMO 2:2">使火吞噬<char style="pn">加略</char>的城堡，</para>
  <para style="q1" vid="AMO 2:2">
    <char style="pn">摩押</char>必在喧嚷、呐喊</para>
  <para style="q1" vid="AMO 2:2">和号角声中死去。<verse eid="AMO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 2:3" />我要剪除它当中的审判官，</para>
  <para style="q1" vid="AMO 2:3">连同它的首领全都杀死。</para>
  <para style="q1" vid="AMO 2:3">这是耶和华说的。<verse eid="AMO 2:3" /></para>
  <para style="s">审判犹大</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4" />耶和华如此说：</para>
  <para style="q1" vid="AMO 2:4">因<char style="pn">犹大</char>三番四次地犯罪，</para>
  <para style="q1" vid="AMO 2:4">因他们厌弃耶和华的训诲，</para>
  <para style="q1" vid="AMO 2:4">不遵守他的律例，</para>
  <para style="q1" vid="AMO 2:4">因他们祖先所随从的假神<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">假神——或译作“虚谎”。</char></note></para>
  <para style="q1" vid="AMO 2:4">使他们迷失，</para>
  <para style="q1" vid="AMO 2:4">我绝不撤回对它的审判。<verse eid="AMO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 2:5" />我要降火在<char style="pn">犹大</char>，</para>
  <para style="q1" vid="AMO 2:5">使火吞噬<char style="pn">耶路撒冷</char>的城堡。<verse eid="AMO 2:5" /></para>
  <para style="s">审判以色列</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6" />耶和华如此说：</para>
  <para style="q1" vid="AMO 2:6">因<char style="pn">以色列</char>三番四次地犯罪，</para>
  <para style="q1" vid="AMO 2:6">因他们把义人卖了获得银子，</para>
  <para style="q1" vid="AMO 2:6">把穷人卖了换取鞋子，</para>
  <para style="q1" vid="AMO 2:6">我绝不撤回对它的审判。<verse eid="AMO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 2:7" />他们把贫弱者的头踩在尘土中，</para>
  <para style="q1" vid="AMO 2:7">屈枉卑微人的义行。</para>
  <para style="q1" vid="AMO 2:7">儿子和父亲与同一个女子行淫，</para>
  <para style="q1" vid="AMO 2:7">以致我的圣名被亵渎。<verse eid="AMO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 2:8" />他们在各祭坛旁</para>
  <para style="q1" vid="AMO 2:8">躺卧在作抵押的衣服上，</para>
  <para style="q1" vid="AMO 2:8">在他们神的殿中喝没收<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false">没收——原文直译“处罚”。</char></note>所得的酒。<verse eid="AMO 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 2:9" />是我把<char style="pn">亚摩利</char>人</para>
  <para style="q1" vid="AMO 2:9">从他们面前除灭了；</para>
  <para style="q1" vid="AMO 2:9">
    <char style="pn">亚摩利</char>人高如香柏树、壮如橡树，</para>
  <para style="q1" vid="AMO 2:9">我却把这树连同上面的果实、</para>
  <para style="q1" vid="AMO 2:9">下面的根都除灭了。<verse eid="AMO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 2:10" />是我把你们从<char style="pn">埃及</char>地带了上来，</para>
  <para style="q1" vid="AMO 2:10">在旷野中引领你们四十年，</para>
  <para style="q1" vid="AMO 2:10">去占有<char style="pn">亚摩利</char>人之地。<verse eid="AMO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 2:11" />是我从你们的子孙中</para>
  <para style="q1" vid="AMO 2:11">兴起一些人作先知，</para>
  <para style="q1" vid="AMO 2:11">从你们的年轻人中</para>
  <para style="q1" vid="AMO 2:11">兴起一些人作拿细耳人。</para>
  <para style="q1" vid="AMO 2:11">
    <char style="pn">以色列</char>人哪，难道不正是这样吗？</para>
  <para style="q1" vid="AMO 2:11">这是耶和华的宣告。<verse eid="AMO 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="AMO 2:12" />你们却使拿细耳人喝酒，</para>
  <para style="q1" vid="AMO 2:12">又吩咐先知说：</para>
  <para style="q1" vid="AMO 2:12">“不要说神言。”<verse eid="AMO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 2:13" />看哪，我要重压你们，</para>
  <para style="q1" vid="AMO 2:13">像满载的车子上压紧了禾捆那样。<verse eid="AMO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 2:14" />跑得快的无处避难，</para>
  <para style="q1" vid="AMO 2:14">强壮的用不上力，</para>
  <para style="q1" vid="AMO 2:14">勇猛的不能救自己的性命。<verse eid="AMO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 2:15" />拿弓的站立不住，</para>
  <para style="q1" vid="AMO 2:15">脚步飞快的不能逃脱，</para>
  <para style="q1" vid="AMO 2:15">骑马的也不能救自己的性命。<verse eid="AMO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 2:16" />到那日，勇士中最有胆量的</para>
  <para style="q1" vid="AMO 2:16">也将丢盔弃甲<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">丢盔弃甲——原文直译“赤身”。</char></note>而逃。</para>
  <para style="q1" vid="AMO 2:16">这是耶和华的宣告。<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="s">选民以色列受惩罚</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />
    <char style="pn">以色列</char>人哪，你们要听这话！我耶和华针对你们，针对我从<char style="pn">埃及</char>地带上来的<char style="pn">以色列</char>全家宣告说：<verse eid="AMO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 3:2" />地上万族中，我只拣选了<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">拣选了——原文直译“认识”。</char></note>你们，</para>
  <para style="q1" vid="AMO 3:2">因此我要因你们的一切罪孽惩罚你们。<verse eid="AMO 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 3:3" />二人若不同心<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">同心——或译作“会合”。</char></note>，岂能同行？<verse eid="AMO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 3:4" />狮子没有猎物，</para>
  <para style="q1" vid="AMO 3:4">怎会在森林中吼叫呢？</para>
  <para style="q1" vid="AMO 3:4">少壮狮子若无捕获，</para>
  <para style="q1" vid="AMO 3:4">怎会从洞中发出吼声呢？<verse eid="AMO 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 3:5" />没有诱饵，</para>
  <para style="q1" vid="AMO 3:5">雀鸟怎会落入地上的网罗呢？</para>
  <para style="q1" vid="AMO 3:5">什么都没有捉住，</para>
  <para style="q1" vid="AMO 3:5">网罗怎会从地上弹起来呢？<verse eid="AMO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 3:6" />城中若吹响号角，</para>
  <para style="q1" vid="AMO 3:6">民众会不战兢吗？</para>
  <para style="q1" vid="AMO 3:6">城中若有灾祸临到，</para>
  <para style="q1" vid="AMO 3:6">难道不是耶和华所降的吗？<verse eid="AMO 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 3:7" />若不先把奥秘启示给仆人众先知，</para>
  <para style="q1" vid="AMO 3:7">主耶和华就不会做什么。<verse eid="AMO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 3:8" />狮子吼叫，谁不害怕呢？</para>
  <para style="q1" vid="AMO 3:8">主耶和华发了话，谁不说神言呢？<verse eid="AMO 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 3:9" />要向<char style="pn">阿实突</char>的城堡</para>
  <para style="q1" vid="AMO 3:9">和<char style="pn">埃及</char>地的城堡传告说：</para>
  <para style="q1" vid="AMO 3:9">“你们聚集到<char style="pn">撒玛利亚</char>的山上，</para>
  <para style="q1" vid="AMO 3:9">看看城中的许多骚乱</para>
  <para style="q1" vid="AMO 3:9">和城中的欺压吧！”<verse eid="AMO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 3:10" />那些人在城堡里积蓄恶行和迫害，</para>
  <para style="q1" vid="AMO 3:10">不知道去做正直的事。</para>
  <para style="q1" vid="AMO 3:10">这是耶和华的宣告。<verse eid="AMO 3:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="AMO 3:11" />因此主耶和华如此说：</para>
  <para style="q1" vid="AMO 3:11">敌人必围攻这地，</para>
  <para style="q1" vid="AMO 3:11">推倒你的堡垒<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">推倒你的堡垒——或译作“使你的力量削弱”。</char></note>，</para>
  <para style="q1" vid="AMO 3:11">你的城堡将被掠夺。<verse eid="AMO 3:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12" />耶和华如此说：</para>
  <para style="q1" vid="AMO 3:12">牧人怎样从狮子口中抢救出两条腿，</para>
  <para style="q1" vid="AMO 3:12">或是一小块耳朵，</para>
  <para style="q1" vid="AMO 3:12">住在<char style="pn">撒玛利亚</char>的<char style="pn">以色列</char>人也将如此，</para>
  <para style="q1" vid="AMO 3:12">被抢救出的只是床榻的一角、床铺的一边。<verse eid="AMO 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 3:13" />你们要听，要警诫<char style="pn">雅各</char>家！</para>
  <para style="q1" vid="AMO 3:13">这是主耶和华万军之神的宣告。<verse eid="AMO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 3:14" />在我惩罚<char style="pn">以色列</char>过犯的日子里，</para>
  <para style="q1" vid="AMO 3:14">我必摧毁<char style="pn">伯特利</char>的祭坛，</para>
  <para style="q1" vid="AMO 3:14">祭坛的犄角将被砍断，</para>
  <para style="q1" vid="AMO 3:14">掉落在地。<verse eid="AMO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 3:15" />我要摧毁冬宫与夏宫，</para>
  <para style="q1" vid="AMO 3:15">象牙装饰的房屋将消亡，</para>
  <para style="q1" vid="AMO 3:15">高大的楼房将化为乌有。</para>
  <para style="q1" vid="AMO 3:15">这是耶和华的宣告。<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="s">社会和属灵的败坏</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 4:1" />在<char style="pn">撒玛利亚</char>山上的<char style="pn">巴珊</char>母牛啊，</para>
  <para style="q1" vid="AMO 4:1">你们要听这话！</para>
  <para style="q1" vid="AMO 4:1">你们欺压贫弱者，</para>
  <para style="q1" vid="AMO 4:1">压迫穷人；</para>
  <para style="q1" vid="AMO 4:1">你们对丈夫<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">丈夫——原文直译“主人”。</char></note>说：</para>
  <para style="q1" vid="AMO 4:1">“拿酒来，让我们喝。”<verse eid="AMO 4:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="AMO 4:2" />主耶和华指着自己的神圣起誓：</para>
  <para style="q1" vid="AMO 4:2">“看哪，日子将临到你们，</para>
  <para style="q1" vid="AMO 4:2">人必用钩子把你们钩去，</para>
  <para style="q1" vid="AMO 4:2">连你们最后一个也用鱼钩钩去。<verse eid="AMO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 4:3" />你们将各自从面前的城墙破口出去，</para>
  <para style="q1" vid="AMO 4:3">被押送到<char style="pn">哈尔蒙</char>。</para>
  <para style="q1" vid="AMO 4:3">这是耶和华的宣告。<verse eid="AMO 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="AMO 4:4" />只管来<char style="pn">伯特利</char>悖逆，</para>
  <para style="q1" vid="AMO 4:4">来<char style="pn">吉甲</char>增添悖逆吧！</para>
  <para style="q1" vid="AMO 4:4">每早晨献上你们的祭物，</para>
  <para style="q1" vid="AMO 4:4">每三天献上你们的十分之一吧！<verse eid="AMO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 4:5" />只管烧献有酵的感谢祭，</para>
  <para style="q1" vid="AMO 4:5">宣告、传扬你们的甘心祭吧！</para>
  <para style="q1" vid="AMO 4:5">
    <char style="pn">以色列</char>子孙哪，你们实在喜爱这样做。</para>
  <para style="q1" vid="AMO 4:5">这是主耶和华的宣告。<verse eid="AMO 4:5" /></para>
  <para style="b" />
  <para style="s">主的管教与以色列的悖逆</para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 4:6" />因此我使你们在所有的城中</para>
  <para style="q1" vid="AMO 4:6">都齿间干净，</para>
  <para style="q1" vid="AMO 4:6">在你们所有的地方都缺乏粮食，</para>
  <para style="q1" vid="AMO 4:6">然而你们仍不回转归向我。</para>
  <para style="q1" vid="AMO 4:6">这是耶和华的宣告。<verse eid="AMO 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 4:7" />而且我在收割前三个月不给你们降雨，</para>
  <para style="q1" vid="AMO 4:7">我在一个城市降雨，</para>
  <para style="q1" vid="AMO 4:7">而在另一个城市不降雨；</para>
  <para style="q1" vid="AMO 4:7">一块田地降雨，</para>
  <para style="q1" vid="AMO 4:7">另一块田地因没有降雨而干枯；<verse eid="AMO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 4:8" />两三个城市的人</para>
  <para style="q1" vid="AMO 4:8">漂泊到一个城市去喝水，</para>
  <para style="q1" vid="AMO 4:8">却不够喝；</para>
  <para style="q1" vid="AMO 4:8">然而你们仍不回转归向我。</para>
  <para style="q1" vid="AMO 4:8">这是耶和华的宣告。<verse eid="AMO 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 4:9" />我用枯焦和霉烂打击你们，</para>
  <para style="q1" vid="AMO 4:9">你们的果园、葡萄园、</para>
  <para style="q1" vid="AMO 4:9">无花果树和橄榄园大量<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">大量——或译作“许多次”。</char></note>被飞蝗吞吃。</para>
  <para style="q1" vid="AMO 4:9">然而，你们仍不回转归向我。</para>
  <para style="q1" vid="AMO 4:9">这是耶和华的宣告。<verse eid="AMO 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 4:10" />我照着从前在<char style="pn">埃及</char>所行的，</para>
  <para style="q1" vid="AMO 4:10">降瘟疫到你们中间；</para>
  <para style="q1" vid="AMO 4:10">我用刀剑杀戮你们的青年人，</para>
  <para style="q1" vid="AMO 4:10">掳去你们的马匹；</para>
  <para style="q1" vid="AMO 4:10">我使你们营地的臭气上腾，</para>
  <para style="q1" vid="AMO 4:10">进入你们的鼻孔。</para>
  <para style="q1" vid="AMO 4:10">然而，你们仍不回转归向我。</para>
  <para style="q1" vid="AMO 4:10">这是耶和华的宣告。<verse eid="AMO 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 4:11" />我倾覆你们，</para>
  <para style="q1" vid="AMO 4:11">就像神从前覆灭<char style="pn">所多玛</char>和<char style="pn">格摩拉</char>那样；</para>
  <para style="q1" vid="AMO 4:11">你们像是从大火中抢救出的一根柴。</para>
  <para style="q1" vid="AMO 4:11">然而，你们仍不回转归向我。</para>
  <para style="q1" vid="AMO 4:11">这是耶和华的宣告。<verse eid="AMO 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="AMO 4:12" />因此，<char style="pn">以色列</char>啊，</para>
  <para style="q1" vid="AMO 4:12">我必这样处置你。</para>
  <para style="q1" vid="AMO 4:12">因我要对你做这些事，</para>
  <para style="q1" vid="AMO 4:12">
    <char style="pn">以色列</char>啊，预备好迎见你的神吧！<verse eid="AMO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13" />看哪，</para>
  <para style="q1" vid="AMO 4:13">是他塑造群山、创造了风，</para>
  <para style="q1" vid="AMO 4:13">向人类宣告他的心意；</para>
  <para style="q1" vid="AMO 4:13">他使晨光变为漆黑，</para>
  <para style="q1" vid="AMO 4:13">踏行大地的高处；</para>
  <para style="q1" vid="AMO 4:13">万军之神耶和华是他的名。<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s">哀悼以色列家</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />
    <char style="pn">以色列</char>家啊，你们要听这话，这是我为你们作的一首哀歌：<verse eid="AMO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2" />少女<char style="pn">以色列</char>仆倒了，</para>
  <para style="q1" vid="AMO 5:2">再也不会起来！</para>
  <para style="q1" vid="AMO 5:2">她被撇弃在地上，</para>
  <para style="q1" vid="AMO 5:2">没有人扶起她。<verse eid="AMO 5:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3" />是的，主耶和华如此说：</para>
  <para style="q1" vid="AMO 5:3">
    <char style="pn">以色列</char>家的城镇，</para>
  <para style="q1" vid="AMO 5:3">一千人出战只会剩下一百，</para>
  <para style="q1" vid="AMO 5:3">一百人出战只会剩下十个。<verse eid="AMO 5:3" /></para>
  <para style="s">当求问主而存活</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4" />是的，主耶和华对<char style="pn">以色列</char>家如此说：</para>
  <para style="q1" vid="AMO 5:4">你们当求问我，使你们存活！<verse eid="AMO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 5:5" />不要到<char style="pn">伯特利</char>求问，</para>
  <para style="q1" vid="AMO 5:5">不要去<char style="pn">吉甲</char>，</para>
  <para style="q1" vid="AMO 5:5">不要前往<char style="pn">比尔-谢巴</char>，</para>
  <para style="q1" vid="AMO 5:5">因为<char style="pn">吉甲</char>人必被掳走，</para>
  <para style="q1" vid="AMO 5:5">
    <char style="pn">伯特利</char>将归于无有。<verse eid="AMO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 5:6" />你们当求问耶和华，使你们存活，</para>
  <para style="q1" vid="AMO 5:6">免得他如火冲入<char style="pn">约瑟</char>家，吞噬一切，</para>
  <para style="q1" vid="AMO 5:6">无人能为<char style="pn">伯特利</char>扑灭。<verse eid="AMO 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 5:7" />因为你们把公正变为苦艾，</para>
  <para style="q1" vid="AMO 5:7">把公义丢弃于地！<verse eid="AMO 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8" />他创造了昴星和参星，</para>
  <para style="q1" vid="AMO 5:8">他使死荫变为晨光，</para>
  <para style="q1" vid="AMO 5:8">使白天变为黑夜，</para>
  <para style="q1" vid="AMO 5:8">他召唤海水，把它们倾倒在地面上，</para>
  <para style="q1" vid="AMO 5:8">耶和华是他的名。<verse eid="AMO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 5:9" />他使毁灭忽然临到强者，</para>
  <para style="q1" vid="AMO 5:9">使毁灭临到堡垒。<verse eid="AMO 5:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 5:10" />你们<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">你们——原文作“他们”。</char></note>恨恶在城门口主持公道的人，</para>
  <para style="q1" vid="AMO 5:10">厌恶说话真诚的人。<verse eid="AMO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 5:11" />所以，因你们欺压贫弱者，</para>
  <para style="q1" vid="AMO 5:11">向他强收粮食为税捐，</para>
  <para style="q1" vid="AMO 5:11">你们将建造石砌的房屋却不得住在其中，</para>
  <para style="q1" vid="AMO 5:11">栽种美好的葡萄园却喝不到所出的酒。<verse eid="AMO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 5:12" />我确实知道你们的过犯众多，</para>
  <para style="q1" vid="AMO 5:12">你们的罪恶无数。</para>
  <para style="q1" vid="AMO 5:12">你们苦害义人，收取贿赂，</para>
  <para style="q1" vid="AMO 5:12">你们在城门口屈枉贫穷人。<verse eid="AMO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 5:13" />因此明达人那时静默不语，</para>
  <para style="q1" vid="AMO 5:13">因为这是邪恶的时期。<verse eid="AMO 5:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="AMO 5:14" />你们要寻求善，不要寻求恶，</para>
  <para style="q1" vid="AMO 5:14">好使你们存活；</para>
  <para style="q1" vid="AMO 5:14">这样耶和华万军之神就会与你们同在，</para>
  <para style="q1" vid="AMO 5:14">正如你们所说的。<verse eid="AMO 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 5:15" />你们要憎恨恶事，喜爱美善，</para>
  <para style="q1" vid="AMO 5:15">在城门口确立公正，</para>
  <para style="q1" vid="AMO 5:15">或许耶和华万军之神</para>
  <para style="q1" vid="AMO 5:15">会恩待<char style="pn">约瑟</char>的余剩之民。<verse eid="AMO 5:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16" />因此主耶和华万军之神如此说：</para>
  <para style="q1" vid="AMO 5:16">所有的广场上都会有哀号，</para>
  <para style="q1" vid="AMO 5:16">所有的街道上人们都会说：</para>
  <para style="q1" vid="AMO 5:16">“哀哉！哀哉！”</para>
  <para style="q1" vid="AMO 5:16">他们还召农夫来哀悼，</para>
  <para style="q1" vid="AMO 5:16">请擅长举哀的人来哀号。<verse eid="AMO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 5:17" />所有的葡萄园中也将有哀号，</para>
  <para style="q1" vid="AMO 5:17">因为我要从你们当中经过。</para>
  <para style="q1" vid="AMO 5:17">这是耶和华说的。<verse eid="AMO 5:17" /></para>
  <para style="b" />
  <para style="s">主的日子</para>
  <para style="q1">
    <verse number="18" style="v" sid="AMO 5:18" />盼望耶和华的日子的人有祸了！</para>
  <para style="q1" vid="AMO 5:18">你们为什么盼望耶和华的日子呢？</para>
  <para style="q1" vid="AMO 5:18">那是黑暗无光的日子，<verse eid="AMO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="AMO 5:19" />就像人逃离了狮子又遇见熊，</para>
  <para style="q1" vid="AMO 5:19">回到家中手一扶墙，又被蛇咬。<verse eid="AMO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="AMO 5:20" />难道不是吗？</para>
  <para style="q1" vid="AMO 5:20">耶和华的日子黑暗无光，</para>
  <para style="q1" vid="AMO 5:20">幽暗没有亮光。<verse eid="AMO 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="AMO 5:21" />我恨恶、厌弃你们的节期，</para>
  <para style="q1" vid="AMO 5:21">也不悦纳你们的严肃集会。<verse eid="AMO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="AMO 5:22" />即使你们向我献上燔祭和素祭，</para>
  <para style="q1" vid="AMO 5:22">我也不悦纳；</para>
  <para style="q1" vid="AMO 5:22">你们献上肥畜为平安祭，我也不垂顾。<verse eid="AMO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="AMO 5:23" />让你们歌唱的喧嚣远离我吧！</para>
  <para style="q1" vid="AMO 5:23">你们里拉琴的乐曲，我也不愿听。<verse eid="AMO 5:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="AMO 5:24" />唯愿公正如大水滔滔，</para>
  <para style="q1" vid="AMO 5:24">公义如溪水常流。<verse eid="AMO 5:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="AMO 5:25" />
    <char style="pn">以色列</char>家啊，你们在旷野四十年，何曾向我献过祭物和供物？ <verse eid="AMO 5:25" /><verse number="26" style="v" sid="AMO 5:26" />你们抬着<char style="pn">摩洛</char>的帐幕<note caller="+" style="f"><char style="fr" closed="false">5:26 </char><char style="ft" closed="false">摩洛的帐幕——依据七十士译本；或译作“你们的王撒古特”。</char></note>和你们的星神<char style="pn">迦温</char>的雕像，就是你们为自己造的那些偶像。 <verse eid="AMO 5:26" /><verse number="27" style="v" sid="AMO 5:27" />因此，我必把你们迁徙到<char style="pn">大马士革</char>以外。这是耶和华说的，万军之神是他的名。<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s">安逸的人有祸了</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 6:1" />有祸了！</para>
  <para style="q1" vid="AMO 6:1">你们这些在<char style="pn">锡安</char>骄奢安逸的人，</para>
  <para style="q1" vid="AMO 6:1">在<char style="pn">撒玛利亚</char>山上安然无虑的人，</para>
  <para style="q1" vid="AMO 6:1">以及<char style="pn">以色列</char>家所归向的列强首领们。<verse eid="AMO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 6:2" />你们到<char style="pn">卡勒尼</char>去看看，</para>
  <para style="q1" vid="AMO 6:2">也从那里往<char style="pn">哈马</char>大城去，</para>
  <para style="q1" vid="AMO 6:2">再下到<char style="pn">非利士</char>人的<char style="pn">迦特</char>看看：</para>
  <para style="q1" vid="AMO 6:2">你们比那些王国更优越吗？</para>
  <para style="q1" vid="AMO 6:2">他们的边界比你们的边界更宽广吗？<verse eid="AMO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 6:3" />你们拒绝接受祸患的日子，</para>
  <para style="q1" vid="AMO 6:3">却使不法的统治<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false">统治——原文直译“座位”。</char></note>近在身边。<verse eid="AMO 6:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="AMO 6:4" />你们躺卧象牙床，</para>
  <para style="q1" vid="AMO 6:4">在床铺上悠然惬意；</para>
  <para style="q1" vid="AMO 6:4">你们享用羊群中的羊羔，</para>
  <para style="q1" vid="AMO 6:4">还有牛圈中的牛犊；<verse eid="AMO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 6:5" />你们伴着里拉琴的乐曲欢唱，</para>
  <para style="q1" vid="AMO 6:5">并像<char style="pn">大卫</char>那样为自己设计各样乐器；<verse eid="AMO 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 6:6" />你们大碗喝酒，</para>
  <para style="q1" vid="AMO 6:6">用最好的油抹身，</para>
  <para style="q1" vid="AMO 6:6">毫不为<char style="pn">约瑟</char>的败亡而忧心。<verse eid="AMO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 6:7" />因此，</para>
  <para style="q1" vid="AMO 6:7">现在你们必成为首先被掳走的人，</para>
  <para style="q1" vid="AMO 6:7">悠然惬意的宴乐必消失。<verse eid="AMO 6:7" /></para>
  <para style="s">审判以色列的傲慢</para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8" />主耶和华指着自己起誓，这是万军之神耶和华的宣告：</para>
  <para style="q1" vid="AMO 6:8">我厌恶<char style="pn">雅各</char>的傲慢，</para>
  <para style="q1" vid="AMO 6:8">恨恶他的宫殿，</para>
  <para style="q1" vid="AMO 6:8">我必把这城和其中所充满的</para>
  <para style="q1" vid="AMO 6:8">都交出去。<verse eid="AMO 6:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />那时，就算一处家宅只剩下十个人，他们也要死。 <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />殓葬的亲属把尸体搬起来，从家宅里抬出去，然后问家宅深处的人：“你那里还有死人吗？”</para>
  <para style="p" vid="AMO 6:10">那人说：“没有。”</para>
  <para style="p" vid="AMO 6:10">又说：“安静！绝不要提说耶和华的名。”<verse eid="AMO 6:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 6:11" />看哪，耶和华即将下令，</para>
  <para style="q1" vid="AMO 6:11">大房屋必被拆散，</para>
  <para style="q1" vid="AMO 6:11">小房屋必被打烂。<verse eid="AMO 6:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="AMO 6:12" />马会在岩石上奔跑吗？</para>
  <para style="q1" vid="AMO 6:12">牛会在海中<note caller="+" style="f"><char style="fr" closed="false">6:12 </char><char style="ft" closed="false">海中——或译作“岩石上”。</char></note>耕作吗？</para>
  <para style="q1" vid="AMO 6:12">你们却把公正变为毒草，</para>
  <para style="q1" vid="AMO 6:12">把公义的果实变为苦艾。<verse eid="AMO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 6:13" />你们为<char style="pn">罗迪巴</char>欢呼，说：</para>
  <para style="q1" vid="AMO 6:13">“难道我们不是凭着自己的力量</para>
  <para style="q1" vid="AMO 6:13">夺取了<char style="pn">加宁</char><note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">加宁——意思是“犄角、力量”。</char></note>吗？”<verse eid="AMO 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 6:14" />看哪，我必兴起一国</para>
  <para style="q1" vid="AMO 6:14">攻击你们<char style="pn">以色列</char>家！</para>
  <para style="q1" vid="AMO 6:14">这是万军之神耶和华的宣告。</para>
  <para style="q1" vid="AMO 6:14">他们将压迫你们，</para>
  <para style="q1" vid="AMO 6:14">从<char style="pn">哈马</char>隘口直到<char style="pn">亚拉巴</char>流域。<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s">第一个异象：蝗虫</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />主耶和华让我看到这事：看哪，他塑造了成群的蝗虫，那时第二茬的庄稼刚刚长出来，是王的庄稼收割之后第二茬的庄稼。 <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />等蝗虫吃尽地上的植物，我说：“主耶和华啊，求你赦免！<char style="pn">雅各</char>如此弱小，他怎能经受得住<note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="ft" closed="false">经受得住——或译作“站立得住”；下同。</char></note>呢？”<verse eid="AMO 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3" />耶和华就为此改变心意，耶和华说：“这事不会发生了。”<verse eid="AMO 7:3" /></para>
  <para style="s">第二个异象：火</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />主耶和华又让我看到：看哪，主耶和华呼唤火来责罚他们，火就吞噬巨大的深渊，吞噬<char style="pn">雅各</char>的地业。 <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />我说：“主耶和华啊，求你停手！<char style="pn">雅各</char>如此弱小，他怎能经受得住呢？”<verse eid="AMO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6" />耶和华就为此改变心意，主耶和华说：“这事也不会发生了。”<verse eid="AMO 7:6" /></para>
  <para style="s">第三个异象：铅垂线</para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />他又让我看到：看哪，主站在一道吊着铅垂线的墙上<note caller="+" style="f"><char style="fr" closed="false">7:7 </char><char style="ft" closed="false">吊着铅垂线的墙上——或译作“垂直的墙边”。</char></note>，手里拿着铅垂线。 <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />耶和华对我说：“<char style="pn">阿摩司</char>，你看见了什么？”</para>
  <para style="p" vid="AMO 7:8">我说：“一根铅垂线。”</para>
  <para style="p" vid="AMO 7:8">主说：“看哪，我将要把铅垂线吊在我的子民<char style="pn">以色列</char>当中，我绝不再放过他们。<verse eid="AMO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 7:9" />
    <char style="pn">以撒</char>的高坛都将变得荒凉，</para>
  <para style="q1" vid="AMO 7:9">
    <char style="pn">以色列</char>的圣所都将荒废；</para>
  <para style="q1" vid="AMO 7:9">我必起来用刀剑攻击<char style="pn">耶罗波安</char>家。”<verse eid="AMO 7:9" /></para>
  <para style="s">亚玛谢的陷害</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />那时，<char style="pn">伯特利</char>的祭司<char style="pn">亚玛谢</char>派人到<char style="pn">以色列</char>王<char style="pn">耶罗波安</char>那里说：“<char style="pn">阿摩司</char>在<char style="pn">以色列</char>家中密谋反叛你，这地不能容忍他的任何话语。 <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />因为<char style="pn">阿摩司</char>如此说：‘<char style="pn">耶罗波安</char>将死在刀下，<char style="pn">以色列</char>人必从自己的国土被掳走。’”<verse eid="AMO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12" />
    <char style="pn">亚玛谢</char>对<char style="pn">阿摩司</char>说：“你这先见，走吧，逃到<char style="pn">犹大</char>地去！在那里找饭吃，在那里说神言。 <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />不要继续在<char style="pn">伯特利</char>说神言，因为这里是王的圣所，是国家宫殿。”<verse eid="AMO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14" />
    <char style="pn">阿摩司</char>回应<char style="pn">亚玛谢</char>说：“我原不是先知，也不是先知的门徒，我本来是牧人，我也看管西克莫无花果树。 <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />但耶和华拣选我，使我不再牧放羊群，耶和华对我说：‘你去，向我的子民<char style="pn">以色列</char>说神言！’<verse eid="AMO 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 7:16" />“现在，你要听耶和华的话语。你说：</para>
  <para style="q1" vid="AMO 7:16">‘不要说神言攻击<char style="pn">以色列</char>，</para>
  <para style="q1" vid="AMO 7:16">不要传道攻击<char style="pn">以撒</char>家。’<verse eid="AMO 7:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="AMO 7:17" />因此耶和华如此说：</para>
  <para style="q1" vid="AMO 7:17">你的妻子将在城中卖淫，</para>
  <para style="q1" vid="AMO 7:17">你的儿女必倒在刀下，</para>
  <para style="q1" vid="AMO 7:17">你的土地将被人用量绳瓜分，</para>
  <para style="q1" vid="AMO 7:17">你必死在不洁净之地，</para>
  <para style="q1" vid="AMO 7:17">
    <char style="pn">以色列</char>人必从自己的国土被掳走。”<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s">第四个异象：一筐夏天的果实</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />主耶和华又让我看到：看哪，有一筐夏天的果实。 <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />他说：“<char style="pn">阿摩司</char>，你看见了什么？”</para>
  <para style="p" vid="AMO 8:2">我说：“一筐夏天的果实。”</para>
  <para style="p" vid="AMO 8:2">耶和华对我说：“结局临到了我的子民<char style="pn">以色列</char>，我绝不再放过他们。”<verse eid="AMO 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 8:3" />到那日，圣殿的歌声必变为哀号<note caller="+" style="f"><char style="fr" closed="false">8:3 </char><char style="ft" closed="false">圣殿的歌声必变为哀号——或译作“宫中的歌女必唱哀歌”。</char></note>。这是主耶和华的宣告。将有许多尸体被抛弃在各处，一片死寂。<verse eid="AMO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 8:4" />你们这些人，</para>
  <para style="q1" vid="AMO 8:4">践踏穷人、驱除地上的困苦人，</para>
  <para style="q1" vid="AMO 8:4">你们要听这话！<verse eid="AMO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 8:5" />你们说：</para>
  <para style="q1" vid="AMO 8:5">“新月节什么时候过去，我们好卖粮；</para>
  <para style="q1" vid="AMO 8:5">安息日什么时候过去，我们好开仓卖粮。</para>
  <para style="q1" vid="AMO 8:5">我们要缩小量斗<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">量斗——原文直译“伊法”；相当于22公升的谷物量器。</char></note>，加重秤砣<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">秤砣——原文直译“谢克尔”，是重量单位；后来成为货币单位。1谢克尔=11.4公克。</char></note>，</para>
  <para style="q1" vid="AMO 8:5">用欺诈的天平欺骗人。<verse eid="AMO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 8:6" />我们要用银子买来贫弱者，</para>
  <para style="q1" vid="AMO 8:6">用一双鞋子换取贫穷人，</para>
  <para style="q1" vid="AMO 8:6">把掺杂的粮食卖出去。”<verse eid="AMO 8:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7" />耶和华指着<char style="pn">雅各</char>的傲慢起誓说：</para>
  <para style="q1" vid="AMO 8:7">我永不忘记他们所做的一切！<verse eid="AMO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 8:8" />大地岂不因这些事而颤抖吗？</para>
  <para style="q1" vid="AMO 8:8">其上所有的居民都将悲恸，</para>
  <para style="q1" vid="AMO 8:8">全地都像<char style="pn">尼罗</char>河那样上涨，</para>
  <para style="q1" vid="AMO 8:8">又像<char style="pn">埃及</char>的<char style="pn">尼罗</char>河那样翻涌、下沉。<verse eid="AMO 8:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 8:9" />这是主耶和华的宣告：</para>
  <para style="q1" vid="AMO 8:9">到那日，</para>
  <para style="q1" vid="AMO 8:9">我要使太阳在正午落下，</para>
  <para style="q1" vid="AMO 8:9">使大地在白天变为黑暗。<verse eid="AMO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 8:10" />我要把你们的节期变为哀悼，</para>
  <para style="q1" vid="AMO 8:10">把你们的歌声都变为哀歌，</para>
  <para style="q1" vid="AMO 8:10">使所有的人腰束麻布，</para>
  <para style="q1" vid="AMO 8:10">头上光秃。</para>
  <para style="q1" vid="AMO 8:10">我要使那日像哀悼独生子一样，</para>
  <para style="q1" vid="AMO 8:10">最终都是痛苦的日子。<verse eid="AMO 8:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 8:11" />看哪，日子将到！</para>
  <para style="q1" vid="AMO 8:11">这是主耶和华的宣告。</para>
  <para style="q1" vid="AMO 8:11">我要把饥荒降在这地；</para>
  <para style="q1" vid="AMO 8:11">人饥饿不是因缺粮，</para>
  <para style="q1" vid="AMO 8:11">干渴不是因缺水，</para>
  <para style="q1" vid="AMO 8:11">而是因听不到耶和华的话语。<verse eid="AMO 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 8:12" />他们将从这海到那海四处漂泊，</para>
  <para style="q1" vid="AMO 8:12">从北方到东方往来奔走，</para>
  <para style="q1" vid="AMO 8:12">为要寻求耶和华的话语，</para>
  <para style="q1" vid="AMO 8:12">他们却寻不见。<verse eid="AMO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 8:13" />到那日，</para>
  <para style="q1" vid="AMO 8:13">美丽的少女和年轻的男子</para>
  <para style="q1" vid="AMO 8:13">必因干渴而发昏。<verse eid="AMO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 8:14" />那些指着<char style="pn">撒玛利亚</char>的偶像起誓的，</para>
  <para style="q1" vid="AMO 8:14">他们说：</para>
  <para style="q1" vid="AMO 8:14">“<char style="pn">但</char>支派啊，我指着你们神的生命起誓，</para>
  <para style="q1" vid="AMO 8:14">指着<char style="pn">比尔-谢巴</char>的神明起誓。”</para>
  <para style="q1" vid="AMO 8:14">这些人必仆倒，再也不能起来。<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s">第五个异象：主在祭坛旁发话</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />我看见主站在祭坛旁边，他说：</para>
  <para style="q1" vid="AMO 9:1">“击打柱顶吧，使门槛震动，</para>
  <para style="q1" vid="AMO 9:1">使柱顶砸落在他们所有人头上。</para>
  <para style="q1" vid="AMO 9:1">残留的，我要用刀杀死；</para>
  <para style="q1" vid="AMO 9:1">逃跑的逃不掉，逃亡的不能逃脱。<verse eid="AMO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 9:2" />就算他们钻进阴间，</para>
  <para style="q1" vid="AMO 9:2">我的手也要从那里把他们拽出来；</para>
  <para style="q1" vid="AMO 9:2">就算他们升到天上，</para>
  <para style="q1" vid="AMO 9:2">我也要从那里把他们拉下来。<verse eid="AMO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 9:3" />就算他们躲藏在<char style="pn">迦密</char>山顶，</para>
  <para style="q1" vid="AMO 9:3">我也要在那里搜寻，</para>
  <para style="q1" vid="AMO 9:3">把他们抓出来。</para>
  <para style="q1" vid="AMO 9:3">就算他们从我眼前隐藏到海底，</para>
  <para style="q1" vid="AMO 9:3">我也要在那里吩咐海蛇咬他们。<verse eid="AMO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 9:4" />就算他们在仇敌面前被掳去，</para>
  <para style="q1" vid="AMO 9:4">我也要在那里吩咐刀剑杀戮他们。</para>
  <para style="q1" vid="AMO 9:4">我要定睛在他们身上，</para>
  <para style="q1" vid="AMO 9:4">不是为了赐福，而是为了降灾祸。”<verse eid="AMO 9:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5" />主万军之耶和华触碰大地，</para>
  <para style="q1" vid="AMO 9:5">大地就消融，</para>
  <para style="q1" vid="AMO 9:5">其上所有的居民都将悲恸，</para>
  <para style="q1" vid="AMO 9:5">全地都像<char style="pn">尼罗</char>河那样上涨，</para>
  <para style="q1" vid="AMO 9:5">又像<char style="pn">埃及</char>的<char style="pn">尼罗</char>河那样下沉。<verse eid="AMO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6" />他在天上建造楼阁，</para>
  <para style="q1" vid="AMO 9:6">在大地之上设立穹顶，</para>
  <para style="q1" vid="AMO 9:6">他召唤海水，</para>
  <para style="q1" vid="AMO 9:6">把它们倾倒在地面上，</para>
  <para style="q1" vid="AMO 9:6">耶和华是他的名。<verse eid="AMO 9:6" /></para>
  <para style="b" />
  <para style="s">宣告审判</para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 9:7" />
    <char style="pn">以色列</char>人哪，</para>
  <para style="q1" vid="AMO 9:7">对我来说，你们与<char style="pn">库实</char>人不是一样吗？</para>
  <para style="q1" vid="AMO 9:7">这是耶和华的宣告。</para>
  <para style="q1" vid="AMO 9:7">我难道不是把<char style="pn">以色列</char>从<char style="pn">埃及</char>地带上来，</para>
  <para style="q1" vid="AMO 9:7">也把<char style="pn">非利士</char>人从<char style="pn">迦斐托</char>带上来，</para>
  <para style="q1" vid="AMO 9:7">把<char style="pn">亚兰</char>人从<char style="pn">吉珥</char>带上来吗？<verse eid="AMO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 9:8" />看哪，主耶和华的眼目</para>
  <para style="q1" vid="AMO 9:8">察看那罪恶的国家。</para>
  <para style="q1" vid="AMO 9:8">我要把它从地面上除灭，</para>
  <para style="q1" vid="AMO 9:8">只是我不会把<char style="pn">雅各</char>家彻底除灭。</para>
  <para style="q1" vid="AMO 9:8">这是耶和华的宣告。<verse eid="AMO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 9:9" />看哪，我将要下令，</para>
  <para style="q1" vid="AMO 9:9">我要在列国中筛<char style="pn">以色列</char>家，</para>
  <para style="q1" vid="AMO 9:9">像在筛子里筛谷那样，</para>
  <para style="q1" vid="AMO 9:9">但不会有一粒掉落在地上。<verse eid="AMO 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 9:10" />我子民中的罪人，</para>
  <para style="q1" vid="AMO 9:10">就是那些说“灾祸不会追上我们，</para>
  <para style="q1" vid="AMO 9:10">不会临到我们”的，</para>
  <para style="q1" vid="AMO 9:10">他们都将死在刀下。<verse eid="AMO 9:10" /></para>
  <para style="b" />
  <para style="s">宣告复兴</para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 9:11" />到那日，</para>
  <para style="q1" vid="AMO 9:11">我要重建<char style="pn">大卫</char>倒塌的帐幕，</para>
  <para style="q1" vid="AMO 9:11">修补它的破口。</para>
  <para style="q1" vid="AMO 9:11">我要重建它的废墟，</para>
  <para style="q1" vid="AMO 9:11">建造得像古时的日子那样，<verse eid="AMO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 9:12" />使他们获得<char style="pn">以东</char>的余剩之地<note caller="+" style="f"><char style="fr" closed="false">9:12 </char><char style="ft" closed="false">余剩之地——或译作“余剩之民”。</char></note>，</para>
  <para style="q1" vid="AMO 9:12">以及所有曾被称为我名下的国家。</para>
  <para style="q1" vid="AMO 9:12">这是耶和华的宣告，他必成就这事。<verse eid="AMO 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 9:13" />看哪，这是耶和华的宣告：</para>
  <para style="q1" vid="AMO 9:13">日子将到，</para>
  <para style="q1" vid="AMO 9:13">那时耕作接续收割，</para>
  <para style="q1" vid="AMO 9:13">踹葡萄接续播种；</para>
  <para style="q1" vid="AMO 9:13">大山淌落甜酒，</para>
  <para style="q1" vid="AMO 9:13">小山都被浸透<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false">被浸透——原文直译“消融”。</char></note>。<verse eid="AMO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 9:14" />我要使我流亡的子民<char style="pn">以色列</char>回归<note caller="+" style="f"><char style="fr" closed="false">9:14 </char><char style="ft" closed="false">使我流亡的子民以色列回归——或译作“复兴我子民以色列的继业”。</char></note>，</para>
  <para style="q1" vid="AMO 9:14">他们将重建荒凉的城镇居住。</para>
  <para style="q1" vid="AMO 9:14">他们将栽种葡萄园，喝所出的酒；</para>
  <para style="q1" vid="AMO 9:14">他们将修建果园，吃园中的果实。<verse eid="AMO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15" />我要把他们栽种在自己的土地上，</para>
  <para style="q1" vid="AMO 9:15">他们再也不会</para>
  <para style="q1" vid="AMO 9:15">从我赐给他们的土地上被拔出来。</para>
  <para style="q1" vid="AMO 9:15">这是你的神耶和华说的。<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>