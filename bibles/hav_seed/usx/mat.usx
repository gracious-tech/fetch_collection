<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Nouveau Testament Havu</book>
  <para style="h">MATAYO</para>
  <para style="toc1">oMwazi Mwinja nk'oku Matayo aguyandikaga</para>
  <para style="toc2">Matayo</para>
  <para style="toc3">Mat</para>
  <para style="mt2">oMwazi Mwinja nk'oku Matayo aguyandikaga</para>
  <para style="mt2" />
  <para style="mt1">MATAYO</para>
  <para style="imt">Entangiriro</para>
  <para style="ip">Matayo yi wayandikaga chino gitaabu. Oyu Matayo aliiri mufurhiisa w'amakooli. Baliiri bayirika kandi mpu ye Laawi (Mariko 2.14). Yeesu amuhamagala y'abe muguma w'omu bigirizwa baage ekumi na babiri (Matayo 9.9)</para>
  <para style="ip">Chino gitaabu cha Matayo gishimanyenye endaganyo mpyaahya n'eya miira. Echi gitaabu chiyerekeene oku Yeesu Kirisitu ye Masiiya, ola abaleebi bw'omu ndagano ya miira, balebaga. Kandi anali Mwami mukulu waburhwaga omu mulala gwa Daawudi, mwami w'aBayaahudi. Matayo ayandikaga guno Mwazi mwinja omu gushonda beene baabo, aBayaahudi bayemeere Yeesu nka Mwami na muchunguzi waabo. Aliko eyi anayerekeene kw'ogu Mwazi Mwinja gunali gw'abantu booshi. Oku buzinda bw'echi gitaabu, Yeesu abwira abigirizwa baage oku bagende, bajire abantu b'embaga zooshi bigirizwa baage (Matayo 28.19).</para>
  <para style="ip">Oku murhondero gwa chino gitaabu, Matayo ayerekeene egisisi Yeesu aburhwaga mo, anashambeere oku arhengeere omu lubaga lw'aBayaahudi. Matayo ashambeere elugulu w'okuburhwa kwa Yeesu, n'emyaazi alemaga ayigiriza abantu na ey'alemaga ayigiriza abigirizwa baage omu kubarheganya omu kaasi kw'okubala oMwazi Mwinja. Na kandi ashambeere elugulu w'ebisomereene Yeesu alemaga ajira, n'elugulu w'ogufa lwage oku musalaaba, n'ogufuuka kwaage. Obuzinda bwa chino gitaabu buyerekeene akaasi abigirizwa ba Yeesu bahemerwe kugendekera bajira.</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Egisisi Yeesu Kirisitu aburhwaga mo</para>
  <para style="r">Luuk. 3.23-38</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Chinoola cho gisisi Yeesu <char style="w" lemma="Kirisitu, Masiiya:">Kirisitu</char>, aburhwaga mo: aliiri w'omu mulala gwa mwami Daawudi. Na Daawudi aliiri w'omu mulala gw'Abrahaamu.<verse eid="MAT 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MAT 1:2" />Abrahaamu aburha Isaka.</para>
  <para style="q2" vid="MAT 1:2">Na Isaka aburha Yakobo.</para>
  <para style="q2" vid="MAT 1:2">Na Yakobo aburha Yuuda na beene baabo.<verse eid="MAT 1:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="MAT 1:3" />Na Yuuda aburha Pereesi na Zeera ku mukaage Tamaari.</para>
  <para style="q2" vid="MAT 1:3">Na Pereesi aburha Hesirooni.</para>
  <para style="q2" vid="MAT 1:3">Na Hesirooni aburha Aramu.<verse eid="MAT 1:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="MAT 1:4" />Na Aramu aburha Aminadaabu.</para>
  <para style="q2" vid="MAT 1:4">Na Aminadaabu aburha Nasoni.</para>
  <para style="q2" vid="MAT 1:4">Na Nasoni aburha Salumooni.<verse eid="MAT 1:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="MAT 1:5" />Na Salumooni aburha Bowazi ku mukaage Rahabu.</para>
  <para style="q2" vid="MAT 1:5">Na Bowazi aburha Obedi ku mukaage Ruuta.</para>
  <para style="q2" vid="MAT 1:5">Na Obedi aburha Yeese.<verse eid="MAT 1:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="MAT 1:6" />Na Yeese aburha mwami Daawudi.</para>
  <para style="q2" vid="MAT 1:6">Na Daawudi aburha Salomoono ku muka Uriya.<verse eid="MAT 1:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="MAT 1:7" />Na Salomoono aburha Robowamu.</para>
  <para style="q2" vid="MAT 1:7">Na Robowamu aburha Abiya.</para>
  <para style="q2" vid="MAT 1:7">Na Abiya aburha Asafu<note caller="+" style="f"><char style="fr" closed="false">1.7</char><char style="ft" closed="false">Omu bitaabu biguma bya miira biderhere Asa.</char></note>.<verse eid="MAT 1:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="MAT 1:8" />Na Asafu aburha Yosafaati.</para>
  <para style="q2" vid="MAT 1:8">Na Yosafaati aburha Yoramu.</para>
  <para style="q2" vid="MAT 1:8">Na Yoramu aburha Uziya.<verse eid="MAT 1:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="MAT 1:9" />Na Uziya aburha Yotamu.</para>
  <para style="q2" vid="MAT 1:9">Na Yotamu aburha Ahaazi.</para>
  <para style="q2" vid="MAT 1:9">Na Ahaazi aburha Ezekiya.<verse eid="MAT 1:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="MAT 1:10" />Na Ezekiya aburha Manase.</para>
  <para style="q2" vid="MAT 1:10">Na Manase aburha Amoosi<note caller="+" style="f"><char style="fr" closed="false">1.10 </char><char style="ft" closed="false">Omu bitaabu biguma bya miira biderhere Amooni.</char></note>.</para>
  <para style="q2" vid="MAT 1:10">Na Amoosi aburha Yoziyasi.<verse eid="MAT 1:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="MAT 1:11" />Na Yoziyasi aburha Yekoniya, na beene baabo omu mango aBaisraheeli baheekwaga omu gihugo ch'<char style="w" lemma="Babilooni:">eBabilooni</char>.<verse eid="MAT 1:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="MAT 1:12" />Enyuma y'okoola guheekwa eyoola munda, Yekoniya aburha Shalitiyeeri.</para>
  <para style="q2" vid="MAT 1:12">Na Shalitiyeeri aburha Zorobabeeli.<verse eid="MAT 1:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="MAT 1:13" />Na Zorobabeeli aburha Abiyuudi.</para>
  <para style="q2" vid="MAT 1:13">Na Abiyuudi aburha Eliyakiimu.</para>
  <para style="q2" vid="MAT 1:13">Na Eliyakiimu aburha Azoori.<verse eid="MAT 1:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="MAT 1:14" />Na Azoori aburha Sadooki.</para>
  <para style="q2" vid="MAT 1:14">Na Sadooki aburha Akiimu.</para>
  <para style="q2" vid="MAT 1:14">Na Akiimu aburha Elihuudi.<verse eid="MAT 1:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="MAT 1:15" />Na Elihuudi aburha Eliyezeeri.</para>
  <para style="q2" vid="MAT 1:15">Na Eliyezeeri aburha Mataani.</para>
  <para style="q2" vid="MAT 1:15">Na Mataani aburha Yakobo.<verse eid="MAT 1:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="MAT 1:16" />Na Yakobo aburha Yozefu. Oyo Yozefu ye waliiri eba wa Mariya.</para>
  <para style="q2" vid="MAT 1:16">Na Mariya ye waburhaga Yeesu olaala bayirika <char style="w" lemma="Kirisitu, Masiiya:">Kirisitu</char>.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Ntya, gurhengera oku Abrahaamu guhika ku Daawudi hali bisisi ekumi na bine. Na gurhengera oku Daawudi guhika amango aBaisraheeli baheekagwa eBabilooni, hali bindi bisisi ekumi na bine. Kandi gurhengera oguheekwa eBabilooni guhika ku Kirisitu, hali bindi bisisi ekumi na bine.<verse eid="MAT 1:17" /></para>
  <para style="s">Okuburhwa kwa Yeesu</para>
  <para style="r">Luuk. 2.1-7</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Okuburhwa kwa Yeesu kw'aliiri ntya: Mariya, nyina wa Yeesu, alishambaazizwe na Yozefu. Aliko embere z'obuhya, abonekana okw'ali bukule. Obo bukule abuheekaga kugerera obuhashe bwa Muuka-Mutagatiifu. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Yozefu mushambaaza waage, aliiri muntu okwaneene embere za Nnamahanga, arhalishondere kumukoza eshoni embere z'abantu. Echo charhuma ahiga kumuleka omu bwibisho.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />Yozefu abeere ali akengera kw'ogoola muhigo, <char style="w" lemma="Malahika:">malahika</char> wa Nnaweerhu amubonekera omu biloorho anamubwira ntya: «Yozefu, mugala wa Daawudi, orhayuubahaga gufulusa mukaawe Mariya, kwenge abeere bukule oku buhashe bwa Muuka-Mutagatiifu. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Aburha omwana w'obuzaana, nji wamuyirika Yeesu, kwenge yeewe ye wachungula abantu baage gurhenga omu byaaha byaabo.»<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Ebyoola byooshi byabaaga, y'ebinwa bijirike ebi Nnaweerhu aderhaga ntya kugerera omuleebi:<verse eid="MAT 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="MAT 1:23" />«Omunyere orhashubiraga kumenya omulume nj'aba bukule; nj'aburha omwana w'obuzaana.</para>
  <para style="q1" vid="MAT 1:23">Nji bamuyirika Manuweeri», kw'okuderha ntya: «Nnamahanga ali haguma neerhu.»<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Yozefu abeere asisimuka, ajira ebi <char style="w" lemma="Malahika:">malahika</char> wa Nnaweerhu amurhegekaga, afulusa mukaage. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Aliko arhalyaamaga na Mariya guhika amango aburhaga omwana w'obuzaana. N'oyo mwana, Yozefu amuyirika Yeesu.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">aBanyabwenge bahika guharamya Yeesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Yeesu aburhwaga omu gishagala ch'eBeteleheemu, omu gihugo ch'eYudeeya. Amo mango, mwami Heroode ye waliiri murhegesi. Enyuma z'okuburhwa kwa Yeesu, aBanyabwenge<note caller="+" style="f"><char style="fr" closed="false">2.1 </char><char style="ft" closed="false">aBanyabwenge: Baliiri bantu basomere ebiyekeere enyenyeezi n'ebindi bimoleka omu chaalege.</char></note> barhengeraga eBushoshookero bw'ezuuba bahika omu gishagala ch'eYerusaleema. <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />Baabaza ntya: «Hali omwana waburhirwe mpu ye mwami w'aBayaahudi. Ngahe ali? Rhwalibwene enyenyeezi yaage ebushoshookero bw'ezuuba, ntya ku rhwayinjire kumuharamya.»<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Mwami Heroode abeere ayunva ogoola mwazi, ahahaala haguma n'abantu booshi b'eYerusaleema. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Aja agusha <char style="w" lemma="Mudaahwa:">abadaahwa bakulu</char> booshi n'abigiriza b'amarhegeko, ababaza ngahe <char style="w" lemma="Kirisitu, Masiiya:">Kirisitu</char> alikwaneene aburhirwe. <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Bamushubiza ntya: «Omu gishagala ch'eBeteleheemu omu gihugo ch'eYudeeya. Kwenge by'ebiyandikirwe n'omuleebi ntya:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />‹Wooyo Beteleheemu, gishagala ch'omu gihugo ch'eYudeeya,</para>
  <para style="q1" vid="MAT 2:6">arhali wooyo we mugeeke omu bishagala by'egihugo ch'eYudeeya;</para>
  <para style="q1" vid="MAT 2:6">kwenge emwawe nji harhengera omurhegesi</para>
  <para style="q1" vid="MAT 2:6">nj'alanga Israheeli, lubaga lwani.›»<verse eid="MAT 2:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 2:7" />
    <char style="w" lemma="Heroode:">Heroode</char> aja ahamagala aboola banyabwenge omu bwibisho, anababaziriza egihe eyoola nyenyeezi yabonekaga. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Enyuma abarhuma eBeteleheemu, ababwira ntya: «Mugende mubazirize bwinja emyaazi y'oyoola mwana. Hano muba mwamubwene, mumenyeese yi naani nje yo kumuharamya.»<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Bamalire kuyunviriza mwami, bagenda. Elaala nyenyeezi babaaga babwene eBushoshookero bw'ezuuba, yalema yagenda embere zaabo. Yabeere yahika elugulu w'ahantu omwana aliiri, yayimanga. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Babeere babona eyoola nyenyeezi, basiima bweneene.<verse eid="MAT 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 2:11" />Baaja omu nju, baabona omwana haguma na nyina, Mariya. Bafukama embere z'omwana bamuharamya. Babohoola eshaho zaabo bahemba oyo mwana ehooro, obubaani n'amarashi.<verse eid="MAT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12" />Nnamahanga aja ababuza omu biloorho oku barhachigalukaga emwa mwami <char style="w" lemma="Heroode:">Heroode</char>. Ntyo, baja bagaluka emwabo kugerera eyindi njira.<verse eid="MAT 2:12" /></para>
  <para style="s">Yozefu, Mariya n'omwana Yeesu bashagira eMiisiri</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Abo banyabwenge b'eBushoshookero bw'ezuuba bayuusize kugenda, <char style="w" lemma="Malahika:">malahika</char> wa Nnaweerhu abonekera Yozefu omu biloorho anamubwira ntya: «Yimanga, rhoola omwana na nyina oshaagire <char style="w" lemma="Miisiri">eMiisiri</char>. Obeere yo guhika amango nji nakubwira oku ogaluke, kwenge <char style="w" lemma="Heroode:">mwami Heroode</char> ashondere kuyirhiisa omwana.» <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Yozefu ava ayimanga mw'oboola budufu, arhoola omwana na nyina baaja eMiisiri. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />Abeera yo guhika amango mwami Heroode afaaga. Ebyoola byabaaga yi bijirike ebi Nnaweerhu aderhaga ntya kugerera omuleebi: «Nahamageere mugala waani arhenge eMiisiri<note caller="+" style="f"><char style="fr" closed="false">2.15 </char><char style="ft" closed="false">Osome Oseya 11,1.</char></note>.»<verse eid="MAT 2:15" /></para>
  <para style="s">Abaana b'obuzaana bayirhwa</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />
    <char style="w" lemma="Heroode:">Heroode</char> abeere abona oku abanyabwenge bamurhebekere, akaliha bweneene. Arhuma abantu omu Beteleheemu n'omu bishagala by'eburhambi bw'ahoola, bagende kuyirha abaana booshi b'obuzaana, gurhengera okuburhwa guhika myaaka ebiri. Ajiraga ntyo gukulikirana n'emyaazi abanyabwenge babaaga bamubwirire. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Chaaja chajirika echinwa omuleebi Yeremiya aderhaga ntya:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />«Omulenge gwayunvikeene eRaama,</para>
  <para style="q1" vid="MAT 2:18">Rakeeli yeli alirira abaana baage bweneene;</para>
  <para style="q1" vid="MAT 2:18">arhanashondere asiriirizwe, bulaala barhachiri ho.»<note caller="+" style="f"><char style="fr" closed="false">2.18 </char><char style="ft" closed="false">Osome Yeremiya 31,15.</char></note><verse eid="MAT 2:18" /></para>
  <para style="s1">Yozefu, Mariya na Yeesu barhenga eMiisiri</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Enyuma z'ogufa kwa <char style="w" lemma="Heroode:">Heroode</char>, <char style="w" lemma="Malahika:">malahika</char> wa Nnaweerhu abonekera Yozefu omu biloorho eyo Miisiri. <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />Amubwira ntya: «Yimanga, rhoola omwana na nyina, ogaluke omu gihugo ch'eIsraheeli, kwenge abashondaga kuyirha omwana bafiire.»<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />Yozefu ayimanga, arhoola omwana na nyina, agaluka omu gihugo ch'eIsraheeli.<verse eid="MAT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22" />Aliko Yozefu abeere ayunva oku Arikelaayo ye yimire<char style="w" lemma="Yuuda, Yudeeya">eYudeeya</char> ahaali h'eshe <char style="w" lemma="Heroode:">Heroode</char>, ayuubaha kuja yo. Enyuma z'oguhanuulwa omu biloorho, aja omu gihugo ch'eGalilaaya. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />Aja kulama omu gishagala chiyirikwa Nazareeti, yi bijirike ebyaderhwaga n'abaleebi ntya: «Alema ayirikwa Munazareeti.»<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">Yohaana Mubatiiza ayaamagaza omu mpinga</para>
  <para style="r">
    <ref loc="MRK 1:2-6">Mariko 1.2-6</ref>; <ref loc="LUK 3:1-18">Luuka 3.1-18</ref>; <ref loc="JHN 1:19-23">Yohaana 1.19-23</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Mw'ezoola siku, Yohaana Mubatiiza ahulukira omu mpinga y' <char style="w" lemma="Yuuda, Yudeeya">eYudeeya. Aliiri ayaamagaza ntya</char>: <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />«Muleke ebyaaha byenyu, kwenge obwime bw'empingu buli hoofu!» <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Yohaana y'olaala omuleebi Isaya aderhaga elugulu waage ntya:</para>
  <para style="q1" vid="MAT 3:3">«Muntu muguma oli omu mpinga y'ayaamagaza ntya:</para>
  <para style="q1" vid="MAT 3:3">‹Murheganyize Nnaweerhu enjira,</para>
  <para style="q1" vid="MAT 3:3">mumujirire enjira zilambuukire!›»<note caller="+" style="f"><char style="fr" closed="false">3.3 </char><char style="ft" closed="false">Osome Isaya 40.3.</char></note><verse eid="MAT 3:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 3:4" />Yohaana aliiri ayambala efulema ya kwizwaga n'amooya m'engamiya. Analiiri ayambala omukaba gw'oluhu omu mankinya. Agendaga alya emiguuku n'obuuki. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Abantu bagendaga baaja emunda ali gurhengera omu gishagala ch'eYerusaleema, omu gihugo ch'eYudeeya chooshi n'enyunda zooshi z'olwinji lw'eYorodaani. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Abo bantu baliiri bayemera ebyaaha byaabo embere z'abantu. Na Yohaana aliiri<char style="w" lemma="Bubatiizo:">ababatiiza</char> omu Yorodaani.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Yohaana abeere abona <char style="w" lemma="Bafarisaayo:">aBafarisaayo</char> banene n'<char style="w" lemma="Basadukaayo:">aBasadukaayo</char> bayinja emunda ali yi babatiizwe, ababwira ntya: «Mwe buuko bw'enjoka, nde wababwirire oku mwakagala gushaga obuhane bwa Nnamahanga bwayinjire? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Leero muleme mwayeerekana kugerera ebijiro oku mwalekere ebyaaha byenyu. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Murhachibwiraga mpu: ‹Abrahaamu ye shookuluza weerhu.› Kwenge mbabwirire oku Nnamahanga agahindamula ama mabaale maabe baana b'Abrahaamu! <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Embasha ekola eri hoofu guchiira emirhi oku mizi. Ngasi murhi gurhayaana amalehe menja, gwachiibwa n'ogukabulwa omu muliro.<verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />«Nyoono, ndi <char style="w" lemma="Bubatiizo:">nababatiiza</char> omu menji, omu kuyerekana oku mwalekere ebyaaha byenyu. Aliko hali owayinjire enyuma zaani, yeewe agwerhe obuhashe kundusha. Ntakwaneene chiro kumuhogola ebiraato. Yeewe ye nji wababatiiza omu Muuka-Mutagatiifu n'omu muliro. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Afarhire omu fune zaage engooko y'akuula ebisasara omu ngano. Nj'arhoola engano n'okuzihira omu nguli yaage. Sy'aliko nj'achumika ebisasara omu muliro gurhazima chiro n'ehityu.»<verse eid="MAT 3:12" /></para>
  <para style="s">Yeesu abatiizwa</para>
  <para style="r">
    <ref loc="MRK 1:9-11">Mariko 1.9-11</ref>; <ref loc="LUK 3:21-22">Luuka 3.21-22</ref>; <ref loc="JHN 1:29-34">Yohaana 1.29-34</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Mwamo mango, Yeesu arhengera eGalilaaya ahika oku lwinji lw'eYorodaani, ayegeera Yohaana mpu y'<char style="w" lemma="Bubatiizo:">abatiizwe</char> naye. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Aliko Yohaana ashonda kulahira anamubwira ntya: «Nyoono nye ndagiirire kubatiizwa naawe. Leero gurhe, wooyo we wajire wayinja emunda ndi?» <verse eid="MAT 3:14" /><verse number="15" style="v" sid="MAT 3:15" />Yeesu amushubiza ntya: «Lekaga bibe ntyo bunoola. Kwenge ntya kubihemere rhujire ebikwaneene byooshi.» Yohaana aja ayemeera.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Yeesu abeere amabatiizwa, arhenga omu menji. Ho n'aho, empingu zagichinguula, abona Muuka gwa Nnamahanga nka guuku n'okumugwirira ko. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Omulenge gwarhengera empingu, n'okuderha ntya: «Oyuula ye Mugala waani muzigirwa, nsimiisizwe naye bweneene.»<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Yeesu ageregezwa na Shetaani</para>
  <para style="r">
    <ref loc="MRK 1:12-13">Mariko 1.12-13</ref>; <ref loc="LUK 4:1-13">Luuka 4.1-13</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Enyuma z'aho, Muuka-Mutagatiifu aheeka Yeesu omu mpinga yi Shetaani amugeregeze. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Ayuusize guchibuza kulya siku makumi mane ezuuba n'obudufu, ayunva enzara. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Shetaani ayinja anamubwira ntya: «Akaba onali Mugala wa Nnamahanga, rhegeka amala mabaale mahinduke migati.» <verse eid="MAT 4:3" /><verse number="4" style="v" sid="MAT 4:4" />Yeesu amushubiza ntya: «Biyandikirwe omu Mandiko Matagatiifu ntya: ‹Omuntu arhakalama n'omugati gonyine. Aliko alama na ngasi Chinwa girhenga omu buunu bwa Nnamahanga.›<note caller="+" style="f"><char style="fr" closed="false">4.4 </char><char style="ft" closed="false">Osome Rhegeko 8.3.</char></note>»<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Shetaani amuheeka omu gishagala gitagatiifu ch'eYerusaleema. Amuyimanza elugulu w'eNju ya Nnamahanga, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />anamubwira ntya: «Akaba onali Mugala wa Nnamahanga, gikabula ahashi, kwenge biyaandikirwe ntya:</para>
  <para style="q1" vid="MAT 4:6">‹Nnamahanga nj'arhegeka <char style="w" lemma="Malahika">bamalahika</char> baage,</para>
  <para style="q1" vid="MAT 4:6">nji bakuyankirira omu fune zaabo,</para>
  <para style="q1" vid="MAT 4:6">y'okugulu kwawe gurhasirhalaga oku baale.›»<note caller="+" style="f"><char style="fr" closed="false">4.6 </char><char style="ft" closed="false">Osome Nanga 91.11-12.</char></note><verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Yeesu amushubiza ntya: «Biyandikirwe omu Mandiko Matagatiifu ntya: ‹Orhalemaga wageregeza Nnaweerhu, Nnamahanga wawe.›<note caller="+" style="f"><char style="fr" closed="false">4.7 </char><char style="ft" closed="false">Osome Rhegeko 6.16.</char></note>»<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Shetaani ashuba kumuheeka oku musozi guleheere bweneene, amuyeereka amaami mooshi m'egulu n'obuchire bw'amo maami. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Amubwira ntya: «Biliira byooshi naguha byo ogafukama embere zaani omu kumparamya.» <verse eid="MAT 4:9" /><verse number="10" style="v" sid="MAT 4:10" />Yeesu amushubiza ntya: «Rhenga hano, Shetaani! Kwenge biyandikirwe ntya: ‹Oleme waharamya Nnaweerhu Nnamahanga waawe, onamukolere yenyine.›<note caller="+" style="f"><char style="fr" closed="false">4.10 </char><char style="ft" closed="false">Osome Rhegeko 6.13.</char></note>»<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Oku buzinda, Shetaani aja aleka Yeesu, na <char style="w" lemma="Malahika:">bamalahika</char> bayinja kumukolera.<verse eid="MAT 4:11" /></para>
  <para style="s">Yeesu arhondera akaasi eGalilaaya</para>
  <para style="r">
    <ref loc="MRK 1:14-15">Mariko 1.14-15</ref>; <ref loc="LUK 4:14-15">Luuka 4.14-15</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Yeesu abeere ayunva oku Yohaana bamuhirire omu munyororo, aja eGalilaaya. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Arhenga omu gishagala ch'eNazareeti, aja kulama omu ch'eGaperinaumu eburhambi bw'enyanja y'eGalilaaya, omu gihugo ch'eZabuluni n'eche Nafutaali. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Ajiraga ntyo y'echinwa chijirike ech'omuleebi Isaya aderhaga ntya:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />«Gihugo cha Zabuluni, n'eche Nafutaali,</para>
  <para style="q1" vid="MAT 4:15">gukulikira enjira y'ebwa nyanja, oku lunda lw'olwinji lw'eYorodaani,</para>
  <para style="q1" vid="MAT 4:15">omu gihugo ch'eGalilaaya. Eyo munda y'abarhali Bayaahudi balamire.<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Olubaga lwalilamire omu mwizimya,</para>
  <para style="q1" vid="MAT 4:16">lwabwene obumoleke bunene,</para>
  <para style="q1" vid="MAT 4:16">n'abalilamire omu gihugo ch'omwizimya munene g'olufu,</para>
  <para style="q1" vid="MAT 4:16">nabo obumoleke bwabayinjire!»<note caller="+" style="f"><char style="fr" closed="false">4.16 </char><char style="ft" closed="false">Osome Isaya 9.1-2.</char></note><verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Gurhengera echoola gihe, Yeesu arhondera kuyigiriza ntya: «Muleke ebyaaha byenyu, kwenge obwime bw'empingu bwayegereere.»<verse eid="MAT 4:17" /></para>
  <para style="s">Yeesu ahamagala abigirizwa baage barhanzi</para>
  <para style="r">
    <ref loc="MRK 1:16-20">Mariko 1.16-20</ref>; <ref loc="LUK 5:1-11">Luuka 5.1-11</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Yeesu abeere ali alambagira eburhambi bw'enyanja y'eGalilaaya, abona abashaana babiri ba nda nguma, Simooni bashembulaga Petero na mwene waabo Ndereya. Baliiri barhoza omulaga gwabo omu nyanja. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Yeesu ababwira ntya: «Munkulikire, nabajira bashaana b'abantu.» <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Ho n'aho Baaleka emilaga yaabo, bamukulikira.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Yeesu agerere embere bweneene, abona bandi bashyaana babiri ba nda nguma: Yakobo na mwene waabo Yohaana. Babaaga bali omu bwarho haguma n'eshe wabo Zebedayo, eyi bali bakwiza emilaga yaabo. Abo nabo, Yeesu abahamagala. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Ho n'aho Baaleka obwarho n'eshe wabo, bakulikira Yeesu.<verse eid="MAT 4:22" /></para>
  <para style="s">Yeesu ayigiriza oMwazi Mwinja n'ogufumya abalwala</para>
  <para style="r">
    <ref loc="LUK 6:17-19">Luuka 6.17-19</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Yeesu aliiri agera omu gihugo chooshi ch'eGalilaaya. Aliiri ayigiriza abantu omu <char style="w" lemma="Sinagoogi">masinagoogi maabo</char> n'okubayigiriza oMwazi Mwinja gw'obwime bw'empingu. Analiiri afumya abantu bali balwere ngasi ndwala na ngasi bulema.<verse eid="MAT 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 4:24" />Erenge lyaage lyayandaala omu gihugo ch'eSuriya chooshi. Balimulerheere abantu booshi baliiri balibuka na ngasi ndwala n'abalizimuhirwe, abalilwere egichuli n'abalihunzize. Aboola booshi, Yeesu aliiri abafumya. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Abantu banene baliiri bamukulikira gurhengera omu gihugo ch'eGalilaaya, n'eche Dekapoli, n'omu gishagala ch'eYerusaleema, n'omu gihugo ch'eYudeeya, n'oku shiriza y'olwinji lw'eYorodaani.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Yeesu ayigiriza oku musozi</para>
  <para style="r">
    <ref loc="LUK 6:12-13">Luuka 6.12-13</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Yeesu abeere abona ebigusho by'abantu, azamuukira oku musozi, ayikala, n'<char style="w" lemma="Mwigirizwa:">abigirizwa</char> baage bamuyegeera. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Arhondera kubayigiriza ntya:<verse eid="MAT 5:2" /></para>
  <para style="s">Omugisho gw'okuli</para>
  <para style="r">
    <ref loc="LUK 6:20-26">Luuka 6.20-26</ref></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />«Bagishirwe abakene omu murhima,</para>
  <para style="q1" vid="MAT 5:3">kwenge oBwami bw'empingu buli bwabo!<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Bagishirwe abali balira,</para>
  <para style="q1" vid="MAT 5:4">kwenge basiririzwa!<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Bagishirwe abagirhonda,</para>
  <para style="q1" vid="MAT 5:5">kwenge bahabwa egulu kuba gashambala kaabo!<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Bagishirwe abali nzara n'enyoorha y'okujira ebikwanene embere za Nnamahanga,</para>
  <para style="q1" vid="MAT 5:6">kwenge bayuguswa!<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Bagishirwe ababeera abandi obonjo,</para>
  <para style="q1" vid="MAT 5:7">kwenge nabo baberwa obonjo!<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Bagishirwe abagwerhe omurhima gucheere,</para>
  <para style="q1" vid="MAT 5:8">kwenge babona Nnamahanga!<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Bagishirwe abaleerha omurhuula,</para>
  <para style="q1" vid="MAT 5:9">kwenge bahamagalwa beene Nnamahanga!<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Bagishirwe abali balibuzwa elugulu w'okujira ebikwanene embere za Nnamahanga,</para>
  <para style="q1" vid="MAT 5:10">kwenge oBwami bw'empingu buli bwabo!<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />«Mugishirwe amango abantu bali babadukanga, n'okubalibuza, banababeshere ngasi chinwa chibi elugulu waani. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Muleme mwashagaluka n'oguchishinga, bulaala oluhembo lwenyu luli lunene omu mpingu. Kwenge ntyo ku balibuzaga abaleebi balamaga embere zenyu.»<verse eid="MAT 5:12" /></para>
  <para style="s">Omunyu n'obumoleke bw'egulu</para>
  <para style="r">
    <ref loc="MRK 9:50">Mariko 9.50</ref>; <ref loc="LUK 14:34-35">Luuka 14.34-35</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />«Mwabo muli munyu gw'egulu. Aliko nk'omunyu gwamahwa obununu, bichi byagashuba kugugalulira obununu bwago? Gurhagachilunga chintu, sy'aliko gwanakabulwa embuga n'okulabarhwa n'abantu.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />«Mwabo muli bumoleke bw'egulu. Egishagala chiri oku musozi girhakabishwa.<verse eid="MAT 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 5:15" />«Ntaaye ochaana etara mpu aliyuubike kw'agarhanda, aliko alihanika oku gikondo, lyanamolekera booshi bali omu nju. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Ntyo k'obumoleke bwenyu buleme bwamoleka embere z'abantu, yi babone ebijiro byenyu binja baleme banakuuza Yisho oli omu mpingu.»<verse eid="MAT 5:16" /></para>
  <para style="s">Enyigirizo ziyerekeere eRhegeko lya Muusa</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />«Murhalemaga mwakengeera mpu nayinjaga kuvuna <char style="w" lemma="Rhegeko:">eRhegeko</char> lya Muusa, changwa enyigirizo z'abaleebi. Ntayinjaga gushanda, aliko nayinjire y'ebi byooshi bijirike. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" /><char style="w" lemma="Bibe ntyo:">Okuli</char> mbabwirire okw'egulu n'empingu bichiri ho, nta mparafu nguma changwa agatomo kaguma k'eRhegeko nji byakuulwa guhika byooshi bijirike. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Mw'ama marhegeko, ngasi yeeshi nji wavuna liguma liri nka ligeeke, n'okuyigiriza abandi bantu nabo balivune, nj'aba mugeeke omu Bwami bw'empingu. Aliko olaala nji wamahira omu bijiro, n'okuyigiriza abandi bantu bamahire omu bijiro, nj'aba mukulu omu Bwami bw'empingu. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Kwenge mbabwirire, akaba murhajirire ebikwaneene embere za Nnamahanga kulusha abigiriza b'amarhegeko n'<char style="w" lemma="Bafarisaayo:">aBafarisaayo</char>, nji murhagafa mwajiire omu Bwami bw'empingu.»<verse eid="MAT 5:20" /></para>
  <para style="s">Yeesu ayigiriza elugulu w'oburhe n'bunviikane</para>
  <para style="r">
    <ref loc="MRK 11:25">Mariko 11.25</ref>; <ref loc="LUK 12:57-59">Luuka 12.57-59</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />«Mwayunvirhe oku bashookuluza benyu babwirwaga ntya: ‹Orhayirhaga<note caller="+" style="f"><char style="fr" closed="false">5.21 </char><char style="ft" closed="false">Osome Lubunguluko 20.13.</char></note>. Omuntu wayirhire akwaneene ahanwe.›<verse eid="MAT 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 5:22" />«Aliko nyoono, mbabwirire oku ngasi yeeshi oyunvirhe oburhe oku waabo, akwaneene ahanwe. N'olaala nji wabwira mwene waabo ntya: ‹Orhagwerhe obwenge!›, akwaneene guhirwa omu kabuga keerhu. N'olaala nji wabwira mwene waabo ntya: ‹Oli musire!›, nj'akabulwa omu muliro gw'esiku n'amango.<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />«Leero, nka wagenda gurhulira Nnamahanga entuulo yaawe oku ntuuliro, n'ahoola okayibuka oku mwene wenyu akugwerhe kw'echinwa, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />leka entuulo yaawe ahoola embere z'entuuliro. Galuka oje kuyunviikana naye, n'enyuma oje gurhuula eyo entuulo yaawe.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />«Akaba hali omuntu wagusidaakire, ogihangane oyunviikane naye juba muchiri omu njira muli mwaja kuburana. Buzira ntyo, aguheeka embere z'omuzuuzi. N'omuzuuzi naye akaguhaana omu maboko m'omupoolisi, n'oyo mupoolisi anaguhira omu munyororo. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" /><char style="w" lemma="Bibe ntyo:">Okuli</char> nkubwirire, orhagarhenga omu munyororo orhanahongere olufuranga lw'obuzinda.»<verse eid="MAT 5:26" /></para>
  <para style="s">Enyigirizo ziyerekeere obuhushi</para>
  <para style="r">
    <ref loc="MAT 18:8-9">Matayo 18.8-9</ref>; <ref loc="MRK 9:43">Mariko 9.43</ref>,<ref loc="MRK 9:47-48">47-48</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />«Mwayunviirhe oku byaderhwaga ntya: ‹Orhalemaga wahusha.› <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Aliko nyoono mbabwirire ntya: ‹Ngasi yeeshi walola omukazi omu guchifiija ye, miira ahushaga naye omu murhima gwage.› <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Akonva eliisho lyaawe ly'ekulyo lyagarhuma wajira echaaha, oliyoomole onalikabule hale. Kwenge kuli kw'obulagiirire oku wooyo oguheza chirumbu chiguma chonyine ch'omubiri gwawe, ahaali h'omubiri gooshi gukabulwe omu muliro gw'esiku n'amango. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Akonva efune yaawe y'ekulyo yagarhuma wajira echaaha, oyiche onayikabule hale, kwenge kuli kw'obulagiirire ku wooyo oguheza chirumbu chiguma chonyine ch'omubiri gwawe, ahaali h'omubiri gooshi gukabulwe omu muliro gw'esiku n'amango.»<verse eid="MAT 5:30" /></para>
  <para style="s">Okuyegula omukazi</para>
  <para style="r">
    <ref loc="MAT 19:7-9">Matayo 19.7-9</ref>; <ref loc="MRK 10:4-5">Mariko 10.4-5</ref>,<ref loc="MRK 10:10-12">10-12</ref>; <ref loc="LUK 16:18">Luuka 16.18</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />«Byaderhwaga kandi ntya: ‹Ngasi mulume yeeshi oyegwire mukaage, amuhe amaruba mw'okuyeerekana okw'amuyegwire.›<note caller="+" style="f"><char style="fr" closed="false">5.31 </char><char style="ft" closed="false">Osome Rhegeko 24.1.</char></note> <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Aliko nyoono mbabwirire oku ngasi yeeshi wayeegula mukaage, nka burhali buhemusi bw'obuhushi, eyi amujirire muhushi. N'omulume washabire omukazi bayegwire, oyo mulume naye ahushire.»<verse eid="MAT 5:32" /></para>
  <para style="s">Enyigirizo ziyerekeere endahiro</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />«Mwayunvirhe kandi oku bashookuluza babwirwaga ntya: ‹Orhalemaga wajira endahiro z'obubeeshi, aliko oleme wakenga endahiro zaawe wajirire embere za Nnaweerhu.›<note caller="+" style="f"><char style="fr" closed="false">5.33 </char><char style="ft" closed="false">Osome Balaawi 19.12.</char></note><verse eid="MAT 5:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 5:34" />«Aliko nyoono mbabwirire oku murhalemaga mwajira endahiro. Murhajiraga endahiro oku ziino ly'empingu, kwenge eri nka ntebe y'oBwami bwa Nnamahanga. <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />Murhalemaga mwajira endahiro oku ziino ly'egulu, kwenge liri nka ndabarhiro Nnamahanga ahumuusiza kw'amagulu. Murhalemaga mwajira kandi endahiro oku ziino ly'eYerusaleema, kwenge chiri gishagala gikulu cha Mwami Mukulu. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Orhalemaga wajira endahiro oku rhwe lyaawe, kwenge orhagahindamula oluviiri lwawe luguma kuba luvi changwa kuba lwiragula. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Echinwa chenyu chibe ‹Neechi, ye na neechi›, ‹Nangwa, ye na nangwa.› Kwenge nka muyushwire ebindi binwa kw'ebiila, eyi byarhenga emwa Shetaani.»<verse eid="MAT 5:37" /></para>
  <para style="s">Enyigirizo ziyerekeere okugihoolera</para>
  <para style="r">
    <ref loc="LUK 6:29-30">Luuka 6.29-30</ref></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />«Mwayunvirhe oku byaderhwaga ntya: ‹Eliisho oku liisho, n'elinyo oku linyo.›<note caller="+" style="f"><char style="fr" closed="false">5.38 </char><char style="ft" closed="false">Osome Lubunguluko 21.24; Balaawi 24.20; Rhegeko 19.21.</char></note> <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Aliko nyoono mbabwirire oku akaba omuntu abajirire amabi, murhagihooleraga. Akaba omuntu agushurhire oku rhama ly'ekulyo, onamurhege ely'ekulembe. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Nk'omuntu ashondere kugusidaaka y'akunyege esimiisi yaawe, lekera ye n'egorhe. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Nk'omuntu aguseezeze guheeka omuzigo gwage ku chilometere chiguma, omuhisize go ku bibiri. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Omuntu nk'aguhemere akantu, omuhe ko. N'omuntu nk'ashondere omuhoze, orhamulahiriraga.<verse eid="MAT 5:42" /></para>
  <para style="s">Enyigirizo ziyerekeere abashombanyi</para>
  <para style="r">
    <ref loc="LUK 6:27-28">Luuka 6.27-28</ref>,<ref loc="LUK 6:32-36">32-36</ref></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />«Mwayunvirhe oku byaderhwaga ntya: ‹Oleme wasiima omuturanyi waawe<note caller="+" style="f"><char style="fr" closed="false">5.43 </char><char style="ft" closed="false">Osome Balaawi 19.18.</char></note>, aliko omwanzi waawe yeewe oleme wamushomba.›<verse eid="MAT 5:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 5:44" />«Aliko nyoono mbabwirire ntya: ‹Muleme mwasiima abanzi benyu munaleme mwasaliirira ababalibuza.› <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />Mukajira ntyo, mwaba baana ba Yisho oli omu mpingu, kwenge anakoleeza ezuuba lyaage oku bantu binja n'oku babi. Anarhoza envula oku bantu bakwaneene n'oku barhakwaneene. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Akaba munasiima ababasiima bonyine, luhembo luchi mwagwarha? Abafurhiisa b'amakooli nabo banajira ntyo! <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />N'akaba munalamusa beene benyu bonyine, mwaba eyi gichi mwajirire chilushire abandi? Na abarhamenyere Nnamahanga nabo, banalamusa beene baabo! <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Mujaage mwaba abakwaneene, nk'oku Yisho w'empingu anaba akwaneene.»<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">Yeesu ayigiriza elugulu w'ogurhabaala abakene</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />«Muleme mwachilanga, murhalemaga mwajira ebijiro binja embere z'abantu yi bababone. Kwenge mukajira ntyo, nta luhembo nji mwayankirira emwa Yisho oli omu mpingu.<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />«Nka warhabala abakene, orhalemaga waziha omulizi nk'oku endyaalya zinajira omu <char style="w" lemma="Sinagoogi:">sinagoogi</char> n'omu njira y'abantu baleme bazikuuza. <char style="w" lemma="Bibe ntyo:">Okuli</char> mbabwirire, zikola zigwerhe oluhembo lwazo. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Aliko wooyo, nka warhabala abakene, efune yaawe y'ekulembe erhamenyaga chiro ech'efune yaawe y'ekulyo eri yajira. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Ebyo bijiro binja, oleme wabijira omu bwibisho na Yisho onabona omu bwibisho eby'oli wajira, nj'aguhemba.»<verse eid="MAT 6:4" /></para>
  <para style="s">Enyigirizo ziyerekeere ogusaliira</para>
  <para style="r">
    <ref loc="LUK 11:2-4">Luuka 11.2-4</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />«Amango muli mwasaliira, murhabaaga nka ndyaalya. Kwenge zoowe, zisiima kuyimanga omu masinagoogi maazo n'omu mashanganjira yi zibonekane n'abantu. Okuli mbabwirire oku zikola zigwerhe omukamarho gwazo. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Aliko wooyo amango oli wasaliira, ja omu busiika bwawe. Chinga omulyango onasaliire Yisho orhabonekana. Na Yisho, onabona ebijiro byaawe omu bwibisho, nj'aguhemba.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />«Amango muli mwasaliira, murhalemaga mwaderha ebinwa binene bya busha-busha nk'oku abarhali Bayaahudi banajira. Kwenge boowe, banakengera mpu Nnamahanga abashubiza elugulu w'okuluza ebinwa. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Mwabo murhalemaga mwajira nka boowe, kwenge Yisho ayinji bichi mulagire ko chiro akaba murhaza kumuhema.<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />«Tala gurhe mukwaneene gusaliira:</para>
  <para style="q1" vid="MAT 6:9">‹Daarha oli omu mpingu!</para>
  <para style="q1" vid="MAT 6:9">Eziino lyaawe likuuzwe,<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />obwime bwawe buyinje,</para>
  <para style="q1" vid="MAT 6:10">obulonza bwawe buleme bwajirika omu gulu nk'omu mpingu.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Oleme warhuha ebiryo byeerhu bya ngasi lusiku,<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />oleme warhubabalira amabi meerhu,</para>
  <para style="q1" vid="MAT 6:12">nk'oku neerhu rhunababalira abarhujirire amabi.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />Orhalemaga warhuleka rhwaja omu chigeregezo,</para>
  <para style="q1" vid="MAT 6:13">aliko oleme warhulanga oku Shetaani.</para>
  <para style="q1" vid="MAT 6:13">[Kwenge oBwami, obuhashe n'obukuuze biri byaawe esiku n'amango! Bibe ntyo!]›»<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />«Akonva munababalira abantu amabi maabo, Yisho w'empingu naye abababalira. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Aliko akonva murhalemere mwababalira abantu amabi maabo, Yisho w'empingu naye arhakabababalira amabi menyu.»<verse eid="MAT 6:15" /></para>
  <para style="s">Enyigirizo ziyerekeere oguchilahiza kulya</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />«Amango muli mwachilahiza kulya, murhazinzaga amalanga nka ndyaalya. Zizinza amalanga yi ziyereke abantu oku zachilahiize kulya. <char style="w" lemma="Bibe ntyo:">Okuli</char>, mbabwirire oku zikola zigwerhe oluhembo lwazo. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Aliko wooyo, amango oli wachilahiza kulya, oleme wayooga onasanure enviiri zaawe, onayooge amalanga, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />y'orhayereka abantu oku wachilahize kulya. Aliko echo chijiro chimenyikeene na Yisho orhabonekana. N'oyoola Yisho onabona eby'ojira omu bwibisho aguhemba.»<verse eid="MAT 6:18" /></para>
  <para style="s">Oguchibikira ebikulo omu mpingu</para>
  <para style="r">
    <ref loc="LUK 11:33-34">Luuka 11.33-34</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />«Murhalemaga mwachibikira ebikulo omu gulu, kwenge omushwa changwa egutu binabishereza. N'ebishambo binarhula enju n'okuzimba. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Aliko muleme mwachibikira ebikulo omu mpingu, eyoola munda y'omushwa n'egutu birhabishereza, n'ebishambo birharhula n'okuzimba. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Kwenge ah'ebikulo byaawe biri, ahoola h'omurhima gwawe nago guli.<verse eid="MAT 6:21" /></para>
  <para style="s">Eliisho liri tara ly'omubiri</para>
  <para style="r">
    <ref loc="LUK 11:34-36">Luuka 11.34-36</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />«Eliisho liri tara ly'omubiri. Akonva eliisho lyaawe liri ligumaguma, omubiri gwawe gooshi gwanaba omu bumoleke. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Aliko akonva eliisho lyaawe lilwere, omubiri gwawe gooshi gwanaba omu mwizimya. Leero akonva obumoleke buli omu kalamo kaawe bwagahindamuka mwizimya, ogoola mwizimya gwanaja gwaba munene kulusha.<verse eid="MAT 6:23" /></para>
  <para style="s">Ogukolera Nnamahanga changwa ebikulo</para>
  <para style="r">
    <ref loc="LUK 16:13">Luuka 16.13</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />«Ntaaye wakagala gukolera bannahamwabo babiri. Kwenge akagaya muguma anasiima owindi. Changwa agachishwekera ku muguma anakena n'owindi. Murhakagala gukolera Nnamahanga munakolere ebikulo.<verse eid="MAT 6:24" /></para>
  <para style="s">Okulangaalira Nnamahanga</para>
  <para style="r">
    <ref loc="LUK 12:22-31">Luuka 12.22-31</ref></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />«Cho girhumire mbabwirire ntya: ‹Murhachilunzaga elugulu w'akalamo kenyu mpu bichi mwalya changwa bichi mwanywa, changwa elugulu w'omubiri gwenyu mpu bichi mwayambala.› Akalamo kali k'obulagiirire kulusha ebiryo, n'omubiri kulusha emyambalo. <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Mulole, enyunyi zirhahinga, zirhashaluula zirhanahaka emyaaka omu nguli. Aliko Yisho w'empingu aziliisa. K'arhali mwe muli babulagiirire kuzilusha?<verse eid="MAT 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 6:27" />«Nde mu mwabo wakagala kuyushuula chiro olusiku oku kalamo kaage elugulu w'oguchilunza?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />«Leero bichi birhumire mwachilunza elugulu w'emyambalo? Mulole bwinja gurhe obwaso buyaasa. Burhakola burhanachilukira fulema, <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />aliko mbabwirire oku chiro mwami Solomoono omu buchire bwage booshi, arhayambalaga efulema ekwirire kulusha ogukwira kw'obwaso buguma omu bo. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Ebirhi by'elubala binabonekana zeene n'omuseezi byanakabulwa omu muliro. Chiro akaba ntyo, Nnamahanga anabiyambisa efulema zikwirire bweneene. Leero gurhe arhakabayambisa bwinja bweneene mwe bantu mugwerhe obwemeezi bugeeke?<verse eid="MAT 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31" />«Murhalemaga mwachilunza mpu: ‹Bichi rhwalya, changwa bichi rhwanywa, changwa kandi bichi rhwayambala!› <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Ebyoola byooshi, abarhamenyere Nnamahanga bo banachilunza omu kubishonda. Aliko mwabo Yisho w'empingu ayinji oku mubilagire ko. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Murhange mushonde obwime bwa Nnamahanga n'ebikwaneene embere zaage, naye abayushulira ebyoola bindi byooshi.<verse eid="MAT 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 6:34" />«Murhalemaga mwachilunza elugulu w'ebyaaba omuseezi, kwenge ebyoola byachilibukira byonyine. Ngasi lusiku lugwerhe amaage malibuko maluyeneere.»<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Enyigirizo ziyerekeere oguchira abandi olushinja</para>
  <para style="r">
    <ref loc="LUK 6:37-42">Luuka 6.37-42</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />Yeesu ashuba kuderha ntya: «Murhalemaga mwachiira abandi olushinja yi nenyu murhalemaga mwachirwa lo. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Kwenge nk'oku muchiira abenyu olushinja ku nenyu nji babachira lo.<verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />«Girhumire walola ehirhi hiri omu liisho ly'owenyu, aliko orhakengereere elugulu w'omurhi guli omu ly'emwawe? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Changwa gurhe wakagala kubwira owenyu ntya: ‹Ndeka nkuule ehirhi hikuli omu liisho, noobo omu lyawe muchiri omurhi?› <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />W'endyaalya we, rhanga okuule omurhi guli omu liisho lyawe, wanaja wabona bwinja gurhe wakuula ehirhi hiri omu liisho ly'owenyu.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />«Murhalemaga mwaha embwa ebintu bitagatiifu. Bulaala zakabahindamukira n'okubashenyagula. Kandi murhakabuliraga engulube amagerha menyu magachiiro, kwenge zakamalabarhanga.»<verse eid="MAT 7:6" /></para>
  <para style="s">Oguhema, ogushonda n'ogukongoorha</para>
  <para style="r">
    <ref loc="LUK 11:9-13">Luuka 11.9-13</ref></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />«Muleme mwahema yi muhaabwe, muleme mwashonda yi mubone, muleme mwakongoorha yi muchingulirwe. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Kwenge ngasi yeeshi ohema, anahaabwa. Oshonda, anabona. N'okongoorha, anachinguulirwa. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />Nde mu mwabo, nk'omwana waage amuhemere omugati, akamuha ebaale? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Changwa nk'amuhemere efi, k'akamuha enjoka?<verse eid="MAT 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 7:11" />«Chiro akaba mwabo muli babi, aliko muyinji guha abaana benyu ebintu binja. Leero gurhe Yisho oli omu mpingu agafundwa guhaana ebintu binja oku bamuhemere byo?<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />«Byooshi mushondere abantu babajirire, nenyu mubajirire byo. Ebyoola by'eRhegeko lya Muusa n'ebitaabu by'abaleebi biyigiriza.<verse eid="MAT 7:12" /></para>
  <para style="s">Omulyango gufundereere n'ogugalihire</para>
  <para style="r">
    <ref loc="LUK 13:23-24">Luuka 13.23-24</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />«Mugerere omu mulyango gufundereere. Kwenge omulyango guyerekeere ebwaguhera gugalihire, n'enjira ejire yo egalihire. N'abantu bagerera mw'eyo njira balugire. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Aliko omulyango gujire ebw'akalamo goowe gufundereere. N'enjira eyerekeze yo nayo efundereere. N'abantu bagerera mw'eyo njira bageehere.<verse eid="MAT 7:14" /></para>
  <para style="s">Abaleebi b'obubeeshi bamenyerwa oku bijiro byaabo</para>
  <para style="r">
    <ref loc="LUK 6:43-44">Luuka 6.43-44</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />«Muleme mwachilanga oku baleebi b'obubeeshi. Babayinjira eyi bachijirire nka ntaama, aliko ey'omu mirhima yaabo bali banyambwe bakalihire. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Abo baleebi, mwalema mwabamenyera oku bijiro byaabo. Kwenge abantu barhacha amalehe m'omuzabiibu changwa m'etiini oku mirhi y'emishaaki. <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Ngasi murhi mwinja gunayaana amalehe menja. Na ngasi murhi mubi gunayaana amalehe mabi. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Omurhi mwinja gurhakayaana amalehe mabi, changwa omurhi gubi gurhakayaana amalehe menja. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Ngasi murhi gurhayaana amalehe menja, gunachiibwa n'ogukabulwa omu muliro. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Ntyo, n'abo baleebi b'obubeeshi mwalema mwabamenyera oku bijiro byaabo.»<verse eid="MAT 7:20" /></para>
  <para style="s">Abigirizwa b'okuli ba Yeesu</para>
  <para style="r">
    <ref loc="LUK 6:46">Luuka 6.46</ref>; <ref loc="LUK 13:25-27">13.25-27</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />«Arhali ngasi muntu wambwira ntya: ‹Nnaweerhu! Nnaweerhu!› Nji waaja omu Bwami bw'empingu, aliko olaala yenyine onajira oku Daarha oli omu mpingu ashondere. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Olusiku lw'ogucha olushinja, bantu banene nji bambwira ntya: ‹Nnaweerhu! Nnaweerhu! K'arhali oku ziino lyawe rhwalemaga rhwaleeba, rhwakuula <char style="w" lemma="Muzimu:">abazimu</char> rhwanajira ebisomereene binene?› <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Nji naaja nabashubiza ntya: ‹Ntashubiraga kubamenya! Muje hale naani, mwabo mwe mujira amabi!›»<verse eid="MAT 7:23" /></para>
  <para style="s">Omugani gw'enju ebiri</para>
  <para style="r">
    <ref loc="LUK 6:47-49">Luuka 6.47-49</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />«Ntyo ku ngasi muntu oyunva ebi binwa byaani n'okubihira omu bijiro, ashushire nk'omuntu w'obwenge wayumbakire enju yaage oku baale. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Envula yabeere yarhoga, enyinji zayunjula, n'omuyaga munene gwahuusa n'oguchishenya kw'eyoola nju. Chiro akaba ntyo, erhahenaga, kwenge yaliyumbakirwe oku baale.<verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />«Aliko ngasi muntu oyunva ebinwa byaani arhanabihirire omu bijiro, ashushire nka muntu orhagwerhe obwenge wayumbakire enju yaage oku mushenyi. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Envula yabeere yarhoga, enyinji zayunjula, omuyaga munene gwahuusa n'oguchishenya kw'eyoola nju. Ho n'aho, eyo nju yahena n'ogushandaala yooshi.»<verse eid="MAT 7:27" /></para>
  <para style="s">Obuhashe bwa Yeesu</para>
  <para style="r">
    <ref loc="MRK 1:22">Mariko 1.22</ref>; <ref loc="LUK 4:32">Luuka 4.32</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Yeesu abeere ayuusa kuderha ebyoola binwa, echigusho ch'abantu basoomererwa obulyo bwage bw'okuyigiriza. <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />Basoomerwaga ntyo, kwenge yeewe arhaliiri abayigiriza nka bigiriza baabo b'amarhegeko, aliko aliiri abayigiriza nka muntu ogwerhe obuhashe.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Yeesu afumya omubenzi-benzi</para>
  <para style="r">
    <ref loc="MRK 1:40-45">Mariko 1.40-45</ref>; <ref loc="LUK 5:12-16">Luuka 5.12-16</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Enyuma w'ebyoola, Yeesu ayandagala k'ogoola musozi. Okw'ali ayandagala, echigusho ch'abantu banene bamukulikira.<verse eid="MAT 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 8:2" />Haahulukira mubenzi-benzi muguma, afukama embere za Yeesu. Amubwira ntya: «Nnaweerhu, akaba oshondere, wakancheesa.» <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />Yeesu alambuula efune, amuhuma ko n'okumubwira ntya: «Nshondere, ocheeswe.» Ho n'aho oyo muntu acheeswa<char style="w" lemma="Bibenzi:">ebibenzi</char> byaage. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Oku buzinda, Yeesu amurhegeka ntya: «Ochilange! Ebyo binwa orhabibwiraga chiro n'omuntu muguma! Aliko ogende guchimoleka emw'omudaahwa, onahaane entuulo gukulikirana n'okw'eRhegeko lya Muusa liderhere.»<note caller="+" style="f"><char style="fr" closed="false">8.4 </char><char style="ft" closed="false">Akaba omuntu afumizwe ebibenzi, agendaga achiyerekana emwa badaahwa oku afumire. Omuntu agendaga ajira ntyo, y'ashuba kuyemereerwa kulama haguma n'abandi bantu. Osome Balaawi 13.45-46; 14.1-32.</char></note><verse eid="MAT 8:4" /></para>
  <para style="s">Obwemeezi bw'omukulu w'abasoda b'eKirooma</para>
  <para style="r">
    <ref loc="LUK 7:1-10">Luuka 7.1-10</ref>; <ref loc="JHN 4:46-54">Yohaana 4.46-54</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Yeesu abeere ali aja omu gishagala ch'eGaperinaumu, omukulu muguma w'abasoda b'eKirooma amuyegeera n'okumurhebereza ntya: <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />«Nnaweerhu, omukozi waani ahunzize, analyamire omu nju kwenge ali alibuka bweneene.» <verse eid="MAT 8:6" /><verse number="7" style="v" sid="MAT 8:7" />Yeesu amushubiza ntya: «Nayinja kumufumya.» <verse eid="MAT 8:7" /><verse number="8" style="v" sid="MAT 8:8" />Oyo mukulu w'abasoda b'eKirooma ashubiza ntya: «Nnaweerhu, ntakwaneene oku oje omu mwani. Aliko oderhe chinwa chiguma chonyine, n'omukozi waani afuma! <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Kwenge naani ndi eshiishi w'oburhegesi bw'abandi bakulu. Na ngwerhe abasoda bali eshiishi y'oburhegesi bwani. Nambwira muguma ntya: ‹Genda!› Ho n'aho anagenda. Na nkabwira owindi ntya: ‹Yinja!› Ho n'aho anayinja. N'omuja waani nkamubwira ntya: ‹Jira ntya!›, anajira ntyo.» <verse eid="MAT 8:9" /><verse number="10" style="v" sid="MAT 8:10" />Yeesu abeere ayunva ebyoola binwa, asoomerwa. Abwira abalimukulikire ntya: «<char style="w" lemma="Bibe ntyo:">Okuli</char> mbabwirire oku omu aBaisraheeli booshi, ntashubiraga kubona omuntu ogwerhe obwemeezi bunene buli nka bw'oyu Murooma. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Mbabwirire oku bantu banene nji barhengera ebushoshookero n'ebuzikiro bw'ezuuba. Abo bantu nji basangira haguma n'<char style="w" lemma="Abrahaamu:">Abrahaamu</char>, Isaka na Yakobo omu Bwami bw'empingu. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Aliko abantu balikwaneene kuja mw'obo Bwami, nji bakabulwa embuga omu mwizimya. Eyoola nji balira n'oguhekenya amenyo.»<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Yeesu aja abwira olaala mukulu w'abasoda b'eKirooma ntya: «Gendaga, okw'obwemeezi bwawe buli kubinabaage.» Na mw'ebyo bishanji, oyo mukozi waage afuma.<verse eid="MAT 8:13" /></para>
  <para style="s">Yeesu afumya abalwala banene</para>
  <para style="r">
    <ref loc="MRK 1:29-34">Mariko 1.29-34</ref>; <ref loc="LUK 4:38-41">Luuka 4.38-41</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Enyuma z'ebyoola, Yeesu aja omu nju ya Petero. Abugaana mo nazaala wa Petero alyaamire eyi agwerhe eshuushira. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Yeesu amuhuma oku fune, n'okuva afuma elyo shushira. Oyo mukazi ava ayimanga n'ogurhondera kumurheganyiza ebiryo.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Lyabeere golo, baleerhera Yeesu bantu banene baalifarhirwe n'<char style="w" lemma="Muzimu">abazimu</char>. Yeesu alema akula abo bazimu n'echinwa chonyine. N'abalwala booshi nabo alema abafumya.<verse eid="MAT 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 8:17" />Ajiraga ntyo y'echiila chinwa chijirike, ech'omuleebi Isaya aderhaga ntya:</para>
  <para style="q1" vid="MAT 8:17">«Arhoolere obuzamba bwerhu</para>
  <para style="q1" vid="MAT 8:17">anarhoolere n'endwala zeerhu.»<note caller="+" style="f"><char style="fr" closed="false">8.17 </char><char style="ft" closed="false">Osome Isaya 53.4.</char></note><verse eid="MAT 8:17" /></para>
  <para style="s">Obulyo bw'ogukulikira Yeesu</para>
  <para style="r">
    <ref loc="LUK 9:57-60">Luuka 9.57-60</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Yeesu abeere abona echigusho ch'abantu bamuzungulukire, arhegeka abigirizwa baage ntya: «Rhuyambukire eshiiriza w'enyanja.»<verse eid="MAT 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 8:19" />Mwigiriza muguma w'amarhegeko ava ayinja kumubwira ntya: «Mwigiriza, ngasi hooshi walema waaja, nalema nagukulikira.» <verse eid="MAT 8:19" /><verse number="20" style="v" sid="MAT 8:20" />Yeesu naye amushubiza ntya: «Emitereri egwerhe enkunda elama mo, n'enyunyi zigwerhe enyogo, aliko <char style="w">Mwene oMuntu</char> arhagwerhe ahantu h'oguhumusiza erhwe.»<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Owindi naye omu <char style="w" lemma="Mwigirizwa:">bigirizwa</char> ba Yeesu amubwira ntya: «Nnaweerhu, onyemeerere ntange nje guhamba daarha.» <verse eid="MAT 8:21" /><verse number="22" style="v" sid="MAT 8:22" />Yeesu amubwira ntya: «Oleke abafu baleme bahamba abafu baabo, aliko wooyo onkulikire.»<verse eid="MAT 8:22" /></para>
  <para style="s">Yeesu arhuleeza omulaba</para>
  <para style="r">
    <ref loc="MRK 4:35-41">Mariko 4.35-41</ref>; <ref loc="LUK 8:23-25">Luuka 8.23-25</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Enyuma w'ebyoola, Yeesu azamuukira omu chombo n'<char style="w" lemma="Mwigirizwa:">abigirizwa</char> baage bagenda naye.<verse eid="MAT 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 8:24" />Ho n'aho omulaba gukalihire gwasuuka omu nyanja oku bulyo amenji marhondera guchikabula omu chombo. Aliko Yeesu yeewe, aliiri alyaamire. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Abigirizwa baja bagenda kumuchula, n'okuderha ntya: «Nnaweerhu, rhwazika, orhuchunguule!» <verse eid="MAT 8:25" /><verse number="26" style="v" sid="MAT 8:26" />Yeesu abashubiza ntya: «Bichi birhumire mwayuubaha? Okuli obwemeezi bwenyu bugehere!» Aja ayimanga, akalihira ogo muhuusi n'enyanja. N'endeera nene yaba.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Abo bantu basoomerwa bweneene n'ogurhondera kuderha ntya: «Muntu muchi oyuula, chiro n'omuhuusi n'enyanja nabyo byamukengere?» <figure style="fig" alt="Jésus apaise la tempête" file="DN00435b.tif" size="span" copy="Darwin Dunham" ref="8.27">Yeesu arhuleeza omulaba</figure><verse eid="MAT 8:27" /></para>
  <para style="s">Yeesu afumya bantu babiri bafarhirwe n'abazimu</para>
  <para style="r">
    <ref loc="MRK 5:1-20">Mariko 5.1-20</ref>; <ref loc="LUK 8:26-39">Luuka 8.26-39</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Amango Yeesu ahikaga eshiiriza ly'enyanja, omu gihugo ch'aBageraasi, bantu babiri bafarhirwe n'<char style="w" lemma="Muzimu">abazimu</char> barhengera ebwa shinda n'okuja emunda ali. Bali bakalihire bweneene oku bulyo nta muntu wakagerere mw'eyoola njira. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Abo bantu bayaamira Yeesu ntya: «Ego Mwene Nnamahanga, bichi warhushonda ko? K'oyinjire hanoola gurhulibuza embere egihe gihike?»<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Hoofu n'ahoola, haliiri obuso bunene bw'engulube bwaliiri bwagishondera ebiryo. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Abo bazimu barhebereza Yeesu ntya: «Akaba washonda gurhukuula, orhurhume mu buliira buso bw'engulube.» <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />Yeesu abwira abo bazimu ntya: «Muje mo!» Abo bazimu barhenga mw'aboola bantu babiri banaja mw'ezo ngulube. Ho n'aho oboola buso bwooshi bw'engulube bwachima eyi buli bwalibirha oku musozi n'oguchiroha omu nyanja, bwazika.<verse eid="MAT 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33" />Abangere b'ezo ngulube babeere babona ebyabeere, balibirha n'okuja kubala omu gishagala chooshi ebyajirikire n'ebyabereere bala bantu balifarhirwe n'<char style="w" lemma="Muzimu">abazimu</char>.<verse eid="MAT 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 8:34" />Abantu booshi b'echoola gishagala baja emunda Yeesu ali. Babeere bamubona, bamurhebereza bweneene arhenge omu gihugo chaabo.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">Yeesu afumya omuntu ohunzize</para>
  <para style="r">
    <ref loc="MRK 2:1-12">Mariko 2.1-12</ref>; <ref loc="LUK 5:17-25">Luuka 5.17-25</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Yeesu ashonera omu chombo, ayambuka enyanja n'okuja omu gishagala akuliraga mo. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Abantu baguma bamuleerhera omuntu ohunzize walilyamire oku gipoyi. Yeesu abwene obwemeezi bwabo, abwira oyo muntu ohunzize ntya: «Mwana waani, gihangaana! Ebyaaha byawe byababalirwe!»<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Abigiriza b'amarhegeko baguma baliiri ahoola, barhondera guchiderhesa ntya: «Amagoma».<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Aliko okubona oku Yeesu aliiri ayinji enkengeero zaabo, ababaza ntya: «Girhumire mwakengera kubi ntyo omu mirhima yenyu? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Bichi biyoolohere omu kubwira omuntu ntya: ‹Ebyaaha byaawe byababalirwe›, changwa omu kumubwira ntya: ‹Yimanga, olambagire!› <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Aliko nshondere mumenye oku Mwene oMuntu agwerhe obuhashe bw'okubabalira ebyaaha mu lino gulu.» Yeesu ava abwira ola muntu ohunzize ntya: «Yimanga, rhoola egipoyi chaawe onagaluke eka.» <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Oyo muntu ayimanga, anachigendera eka.<verse eid="MAT 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 9:8" />Abantu babeere baabona ebyoola, bayuubaha bweneene. Bakuuza Nnamahanga waheere abantu obuhashe buli nk'obu.<verse eid="MAT 9:8" /></para>
  <para style="s">Yeesu ahamagala Matayo</para>
  <para style="r">
    <ref loc="MRK 2:13-17">Mariko 2.13-17</ref>; <ref loc="LUK 5:27-32">Luuka 5.27-32</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Yeesu abeere ali arhenga ahoola, abona mufurhiisa muguma w'amakooli oyirikwa Matayo, eyi ayikeere ahantu bafurhiisiza amakooli. Amubwira ntya: «Nkulikira». Matayo ayimanga n'okumukulikira.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Enyuma z'ahoola, Yeesu aja kulya omu nju ya Matayo. Mw'eyo nju, mwaja abandi bafurhiisa b'amakooli n'abandi banyabyaaha. Aboola booshi bayikala kulya ebiryo haguma na Yeesu n'abigirizwa baage.<verse eid="MAT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 9:11" />
    <char style="w" lemma="Bafarisaayo:">aBafarisaayo</char> babeere baabona ebyoola, babwira abigirizwa ba Yeesu ntya: «Girhumire omwigiriza wenyu y'aliira haguma n'abafurhiisa b'amakooli n'abandi banyabyaaha?»<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Yeesu abeere ayunva kw'ebyo, ababwira ntya: «Abagwerhe amagala menja arhali boowe bo banashonda omufumu, aliko abalwala bo banamushonda. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Mugende murhange muchiyigirize eby'ama Mandiko Matagatiifu maderhere: ‹Ntashonda oku muntuulire entuulo, aliko nshondere muleme mwayunvirana obonjo›<note caller="+" style="f"><char style="fr" closed="false">9.13 </char><char style="ft" closed="false">Osome Oseya 6.6.</char></note>, kwenge ntayinjaga guhamagala abakwaneene, aliko nayinjire elugulu w'abanyabyaaha.»<verse eid="MAT 9:13" /></para>
  <para style="s">Yeesu abazwa elugulu w'oguchilahiza kulya</para>
  <para style="r">
    <ref loc="MRK 2:18-22">Mariko 2.18-22</ref>; <ref loc="LUK 5:33-39">Luuka 5.33-39</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Abigirizwa ba Yohaana baaja emunda Yeesu ali n'okumubaza ntya: «Rhwabo n'<char style="w" lemma="Bafarisaayo:">aBafarisaayo</char>, rhunalema rhwachilahiza kulya. Girhuma abigirizwa baawe boowe barhachilahiza kulya?»<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Yeesu abashubiza ntya: «Egihe abantu balalikirwe oku buhya, gurhe bakagala kuyerekana amaganya noobo bachiri haguma na muhya-mulume? Aliko omu siku zayinja, oyo muhya-mulume nj'akuulwa ahagarhi kaabo. Leero mw'ezoola siku yi nji balema baaja bachilahiza kulya.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />«Nta muntu ohangira echiraka gihyaahya oku fulema eshajire. Akaba akajira ntyo, echo chiraka chanabera eyo fulema eshajire. Oku buzinda, eyo fulema eshajire yanachiberekera bweneene.<verse eid="MAT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 9:17" />«Ko n'oko barhabika edivaayi y'omuhyo omu masupa m'oluhu lushajire<note caller="+" style="f"><char style="fr" closed="false">9.17 </char><char style="ft" closed="false">Amasupa m'oluhu: aBayaahudi baliiri bajira amasupa omu oluhu. Mw'amo masupa baliiri babika mo amenji, amarha, edivaayi n'amavurha. Amo masupa, amango malichiri mahyaahya, maliiri marhunda. Aliko amango mamarhondera gushaja, manakomera, elugulu w'oko marhagachirhunda.</char></note>. Nka bajirire ntyo manabereka, n'edivaayi yanasheeshekala, n'amasupa manafa busha. Ahuubwe bahira edivaayi y'omuhyo omu masupa mahyaahya, ntyo edivaayi n'amasupa byanabiikwa bwinja.»<verse eid="MAT 9:17" /></para>
  <para style="s">Yeesu afumya omukazi n'ogufuula omunyere</para>
  <para style="r">
    <ref loc="MRK 5:21-43">Mariko 5.21-43</ref>; <ref loc="LUK 8:40-56">Luuka 8.40-56</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Yeesu abeere achiri ababwira ebyoola binwa, omukulu muguma w'aBayaahudi ayinja. Afukama embere za Yeesu n'okumubwira ntya: «Mwali waani amafa bonabuno. Aliko chiro akaba amafa, oyinje omulambulire kw'efune, y'ashuba kuba mugumaguma.» <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Yeesu ayimanga, yeewe n'abigirizwa baage bakulikira oyo mukulu.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Mw'ebyo bishanji, mukazi muguma waligwerhe myaaka ekumi n'ebiri alwere endwala y'okuva eshagama, ayegeera enyuma za Yeesu. Oyo mukazi ahuma oku mushoojo gw'efulema ya Yeesu, <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />kwenge aliiri achiderhesa ntya: «Nka mpumire konyine oku fulema yaage, nafuma!» <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />Yeesu ava ahindamuka, amubona n'okumubwira ntya: «Mwali waani, gihangaana! Obwemeezi bwawe bwagufumize.» Ho n'aho, oyo mukazi afuma.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Yeesu abeere ahika emw'oyo mukulu w'aBayaahudi. Abugaana yo abantu banene bali bajira olwamo, n'abandi bali baziha emilizi n'okuyimpa enyimpo z'emishibo. N'abandi bantu banene bali balira. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Yeesu ababwira ntya: «Murhenge hano, kwenge oyu munyere arhafiire, alyaamire.» Aliko aboola bantu bamushekera.<verse eid="MAT 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 9:25" />Abantu babeere bahuluswa, Yeesu aja omu nju. Afarhira oyo munyere oku fune, ava ayimanga.<verse eid="MAT 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 9:26" />Ogoola mwazi gwayandaala mw'echo gihugo chooshi.<verse eid="MAT 9:26" /></para>
  <para style="s">Yeesu afumya mpumi ebiri</para>
  <para style="r">
    <ref loc="MAT 20:29-34">Matayo 20.29-34</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Yeesu abeere ali arhenga emw'oyo mukulu w'aBayaahudi, mpumi ebiri zamukulikira eri ziri zabanda enduulu ntya: «Waliha Mugala wa Daawudi! Orhubeere obonjo!»<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Agerere eka, ezoola mpumi zamuyegeera. Yeesu abaza zo ntya: «Ebyo mumpemere, ka mugwerhe obwemeezi oku nakabikola?» Zamushubiza ntya: «Neechi Nnaweerhu.»<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Yeesu azihuma oku meesho. Azibwira ntya: «Nk'oku obwemeezi bwenyu buli kubinabaage.» <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Ameesho maazo maava mazibuuka. Yeesu azirhegeka ntya: «Muchilange, ebyo binwa ntaaye mubibwirage.» <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Aliko zoowe, zagenda ziri zabalira abantu emyaazi ya Yeesu mw'echo gihugo chooshi.<verse eid="MAT 9:31" /></para>
  <para style="s">Yeesu afumya egama</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Ezo mpumi ebiri zabeere ziri zarhenga ahoola, abantu baleerhera Yeesu omuntu muguma omuzimu ajirire gama. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Yeesu ava akuula oyo muzimu. Elyo gama lyaava lyarhondera kuderha. Echigusho ch'abantu basoomerwa bweneene n'okuderha ntya: «Mu chino gihugo chooshi ch'eIsraheeli, murhashubiraga kubonekana echinwa chiri nk'echo chiro n'ehityu!»<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Aliko <char style="w" lemma="Bafarisaayo:">aBafarisaayo</char> boowe baderha ntya: «Yeesu ali akuula abazimu oku buhashe bw'omukulu w'abazimu.»<verse eid="MAT 9:34" /></para>
  <para style="s">Yeesu abaala oMwazi Mwinja omu bishagala</para>
  <para style="r">
    <ref loc="MRK 6:6">Mariko 6.6</ref>; <ref loc="LUK 8:1">Luuka 8.1</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Buzinda bwaho, Yeesu agendekera kugera omu bishagala byooshi ebineneenene n'ebigeekegeeke, eyi ali ayigiriza abantu omu masinagoogi. Aliiri abaala oMwazi Mwinja g'oBwime bw'empingu n'ogufumya endwala zooshi n'obulema booshi.<verse eid="MAT 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 9:36" />Yeesu abeere abona abantu banene, abayunvira obonjo, kwenge baliiri baluhire eyi banalembere. Baliiri nka ntaama zirhagwerhe mungere. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Aja abwira abigirizwa baage ntya: «Emyaaka y'ogushaluula elugire, aliko abakozi bagehere. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Leero, muheme nyina emyaaka arhume abandi bakozi omu myaaka yaage.»<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">Amaziino m'eNtumwa ekumi n'ebiri za Yeesu</para>
  <para style="r">
    <ref loc="MRK 3:13-19">Mariko 3.13-19</ref>; <ref loc="LUK 6:12-16">Luuka 6.12-16</ref>; <ref loc="LUK 9:1-6">9.1-6</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Enyuma w'ebyoola, Yeesu ahamagala abigirizwa baage ekumi na babiri. Abaheereza obuhashe b'ogukuula abazimu n'ogufumya ngasi ndwala na ngasi buzamba. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />N'ama, mo maziino m'ezoola Ntumwa ekumi n'ebiri: omurhanzi ali Simooni oyirikwa Petero na Ndereya mwene waabo, Yakobo na mwene waabo Yohaana bagala ba Zebedayo, <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Firipo na Baritolomaayo, Tomaasi na Matayo mufurhiisa w'amakooli, Yakobo mwene Alufaayo na Tadeeyo, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Simooni w'omu chigusho ch'aBazelooti na Yuuda Isikariyooti ola walenganyaga Yeesu.<verse eid="MAT 10:4" /></para>
  <para style="s">Yeesu arhuma eNtumwa zaage ekumi n'ebiri omu kaasi</para>
  <para style="r">
    <ref loc="MRK 6:7-13">Mariko 6.7-13</ref>; <ref loc="LUK 9:1-6">Luuka 9.1-6</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Ezoola ntumwa ekumi n'ebiri, Yeesu azirhuma. Azirhegeka ntya: «Murhajaaga omu bihugo by'abarhali Bayaahudi, murhanajaga chiro n'omu gishagala chooshi ch'aBasamariya. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Sy'aliko muleme mwagenda emwa Baisraheeli bonyine, kwenge bali nka ntaama zaherere. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />N'amango muli mwalenga yo, mubalire abantu ntya: ‹oBwime bw'empingu buli hoofu!› <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Muleme mwafumya abalwala, munaleme mwafuula abafu, n'ogucheesa ababenzibenzi, munaleme mwakuula abazimu. Oboola mwahabirwe oku busha, nenyu muleme mwahaana oku busha.<verse eid="MAT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 10:9" />«Murhaheekaga olufuranga chiro n'oluguma omu mifuko yenyu. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />Kandi, omu lugenzi lwenyu murhaheekaga eshaho changwa fulema ebiri, changwa ebindi biraato, changwa enkoni. Bulaala omukozi akwaneene omukamarho gwage.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />«Amango muli mwaja omu bishagala bineneneene changwa bigekegeeke, mushonde omuntu oyemeerere kubayankirira. Muhande omu mwage guhika amango mwarhenga mw'echo gishagala. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Enju nji mwaba mwajire mo, mulamuse beene mo omu kuderha ntya: ‹Omurhuula gube haguma nenyu!› <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Akaba abantu ba mw'eyo nju babayankirire, mubalekere ogo murhuula. N'akaba balahire kubayankirira, mugalukane ogo murhuula gwenyu. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />N'akaba abantu ba nju ndebe changwa gishagala chilebe balahire kubayankirira n'okubayunviriza, muchirhengere mo. N'omu gurhenga mo, mukungurhe olujuchu luli oku magulu menyu.<note caller="+" style="f"><char style="fr" closed="false">10.14 </char><char style="ft" closed="false">Omu micho y'aBayaahudi, ogukunguurha olujuuchu lw'oku magulu kuli kuderha okw'abantu balekeene buzira kuyunvikana. Na kandi, kw'aliiri kuderha oku omuntu akalabire olaala arhumwaga ko. Osome Mariko 6.11.</char></note> <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Okuli mbabwirire, oku amango olusiku lw'ogucha olushinja lwahika, beene echo gishagala nji bachirwa olushinja oku bulyo bukalihire bweneene kulusha beene egishagala ch'eSodoomo n'eche Gomoora.»<verse eid="MAT 10:15" /></para>
  <para style="s">Abantu balibuzwa elugulu wa Yeesu</para>
  <para style="r">
    <ref loc="MRK 13:9-13">Mariko 13.9-13</ref>; <ref loc="LUK 21:12-17">Luuka 21.12-17</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />«Muchilange! Mbarhumire nka ntaama ahagarhi ka banyambwe. Ntyo mube benge nka njoka, munachirhonde nka guuku. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Muchilange kwenge abantu balema babaheeka omu kabuga. N'abazuuzi balema babashurhisa enkoni omu masinagoogi maabo. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Ko n'oko balema babaheeka embere z'abarhegesi, n'embere z'abaami yi mube bahamiriza baani, embere zaabo n'embere z'abarhali Bayaahudi. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Aliko amango nji baaba bali babaheeka embere z'abo bakulu, murhalemaga mwachibaza ntya: ‹Bichi rhwaderha, changwa gurhe rhwaderha.› Kwenge mw'ebyo bishanji bye n'ebyo mwahaabwa ebinwa mwaderha. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Arhaali mwabo mwe mwaba muli mwaderha, sy'aliko Muuka gwa Yisho ye nji wabaderhera mo.<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />«Omuntu nj'ayirhiisa mwene waabo, n'eshe w'omwana nj'ayirhiisa omwana waage. Abaana nabo nji balwisa abazeere baabo n'okubayirhiisa. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Abantu booshi nji babashomba elugulu w'eziino lyaani. Aliko olaala nji wagihangana guhika oku buzinda, nj'achungulwa. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Amango nji baaba bali babalibuza omu gishagala chilebe, mwanashagira omu chindi. Okuli, mbabwirire oku murhakamala kuzungula omu bishagala byooshi by'eIsraheeli na Mwene oMuntu arhazigaluka.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />«Omwigirizwa arhakalusha omwigiriza waage, changwa omuja arhakalusha nnahamwabo. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Aliko, biri binja omwigirizwa aleme aba nka mwigiriza waage. N'omuja naye, biri binja aleme aba nka nnahamwabo. Akaba nyina enju bakamuyirika Belizebuuli,<note caller="+" style="f"><char style="fr" closed="false">10.25 </char><char style="fq" closed="false">Belizebuuli </char><char style="ft" closed="false">kuli kuderha mukulu w'abazimu.</char></note> ntyo ku nji bayirika abantu b'omu nju yaage oku maziino mabi!»<verse eid="MAT 10:25" /></para>
  <para style="s">Nnamahanga ye kwaneene kuyubahwa</para>
  <para style="r">
    <ref loc="LUK 12:2-7">Luuka 12.2-7</ref></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />Yeesu ashuba kuderha ntya: «Murhayuubahaga abo bantu. Nta chintu chibishirwe girhakabishuulwa na ntaacho chiri omu bwibisho girhakamenyikana. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Omwazi nababwirire omu mwizimya, muguderhe ezuuba likulu. N'omwazi gulaala bababoheerezaga muguyalagaze n'omulenge munene eyi muyumangire oku nju elugulu. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Murhayuubahaga abantu bakayirha omubiri gonyine, barhakanagala kuyirha omurhima. Aliko muyuubahe Nnamahanga, bulaala yenyine yegwerhe obuhashe b'ogushereza omubiri n'omurhima omu muliro gw'esiku n'amango.»<verse eid="MAT 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 10:29" />«Ka barhaguza ebishwa bibiri oku gicheri chiguma? Aliko, chiro nta chiguma omu byo chagarhibukira ahashi buzira bulonza bwa Yisho. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Leero mwabo, chiro n'oluganjo lw'enviiri zenyu zooshi, Nnamahanga alumenyere. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Cho girhumire murhalemaga mwayuubaha, mugwerhe akamaro kulusha ebishwa binene.»<verse eid="MAT 10:31" /></para>
  <para style="s">Okuyemeera n'okulahira Kirisitu</para>
  <para style="r">
    <ref loc="LUK 12:8-9">Luuka 12.8-9</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />«Ngasi muntu onyemereere embere z'abantu, naani nji namuyemeera embere za Daarha oli omu mpingu. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Aliko ngasi muntu ondahire embere z'abantu, naani nji namulahira embere za Daarha oli omu mpingu.»<verse eid="MAT 10:33" /></para>
  <para style="s">Yeesu ayinjaga kuleerha obushombanyi</para>
  <para style="r">
    <ref loc="LUK 12:51-53">Luuka 12.51-53</ref>; <ref loc="LUK 14:26-27">14.26-27</ref></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />«Murhalemaga mwakengera oku nayinjaga kuleerha omurhuula omu gulu. Nyoono ntayinjaga kuleerha omurhuula, aliko nayinjaga kuleerha entambala. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Kwenge nayinjaga gushombanya omwana n'eshe, omunyere na nyina, omwazaana na nazaala. <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />Abashombanyi b'omuntu nji baaba bantu b'omu mwage.<note caller="+" style="f"><char style="fr" closed="false">10.36 </char><char style="ft" closed="false">Osome Miika 7.6.</char></note><verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />«Omuntu wagasiima eshe changwa nyina kundusha, oyo arhakwaneene kuba waani. N'ola wagasiima omugala changwa omwali kundusha, naye arhakwaneene kuba waani. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Ola orhaheekere omusalaaba gwage n'okunkulikira, arhakwaneene kuba muntu waani.<verse eid="MAT 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 10:39" />«N'ola nji washonda guchungula akalamo kaage nj'agaheza. Aliko olaala nji waaba ahezeze akalamo kaage elugulu waani, nj'ashuba gukabona.»<verse eid="MAT 10:39" /></para>
  <para style="s">Oluhembo lw'abayankirira abigirizwa ba Yeesu</para>
  <para style="r">
    <ref loc="MRK 9:37">Mariko 9.37</ref>,<ref loc="MRK 9:41">41</ref>; <ref loc="LUK 9:48">Luuka 9.48</ref>; <ref loc="LUK 10:16">10.16</ref>; <ref loc="JHN 13:20">Yohaana 13.20</ref></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />«Omuntu obayankirire, eyi ny'ayankirire. N'onyankiriire, eyi ayankiriire ola wantumaga. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Oyankiriire omuleebi, bulaala ali muleebi, nj'ahembwa oluhembo lw'omuleebi. N'oyankiriire omuntu okwaneene, bulaala akwaneene, nj'ahembwa oluhembo lw'omuntu okwaneene.<verse eid="MAT 10:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 10:42" />«Okuli mbabwirire oku ngasi yeeshi nji waha muguma mw'aba badoorho engumbu y'amenji maganyire, bulaala ali mwigirizwa waani, oyo muntu nj'ahaabwa oluhembo lwage.»<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Yohaana Mubatiiza arhuma abigirizwa baage emwa Yeesu</para>
  <para style="r">
    <ref loc="LUK 7:18-35">Luuka 7.18-35</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Yeesu abeere amala gurhegeka bala bigirizwa baage ekumi na babiri, arhenga aho hantu aliiri, aja kuyigiriza n'okubala oMwazi Mwinja omu bishagala by'eGalilaaya.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Amo mango Yohaana Mubatiiza abaaga ali omu munyororo, ayunva ebi Kirisitu aliiri ajira. Arhuma baguma omu bigirizwa baage, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />ababwira ntya: «Mugende kubaza Yeesu ntya: ‹Ka wooyo, w'olaala walikwaneene kuyinja, changwa rhulinge owindi?›» <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />Yeesu abashubiza ntya: «Muje kubalira Yohaana ebi muli mwayunva ko n'ebi muli mwabona ko. <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Bulaala empumi yi zabona, abahunzize yi balambagira, ababenzibenzi yi bacheeswa, ebihuli yi byayunva, abafu yi bafuuka n'abakene yi babalirwa oMwazi Mwinja. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Agishirwe omuntu olaala orhakaleka obwemeezi bwage oku nyoono!»<verse eid="MAT 11:6" /></para>
  <para style="s">Yeesu aderha elugulu wa Yohaana Mubatiiza</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Abo bigirizwa ba Yohaana babeere bagaluka, Yeesu arhondera kubwira olubaga lw'abantu elugulu wa Yohaana ntya: «Bichi mwajaaga kulola omu mpinga? Ka lusheke lushaganyizwe n'omuyaga? Nangwa! <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Bichi mwajaaga kulola? Ka muntu oyambeere emyambalo ekwirire? Nangwa! Abayambeere emyambalo ekwirire balama omu nju z'abaami! <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Bichi si mwajaaga mwaja kulola? Ka muleebi? Neechi! Mbabwirire oku yeewe ali mukulu kulusha omuleebi. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Kwenge oyo Yohaana y'olaala biyandikirwe elugulu waage ntya omu Mandiko Matagatiifu:</para>
  <para style="q1" vid="MAT 11:10">‹Tala! Ntumire entumwa yaani embere zaawe,</para>
  <para style="q1" vid="MAT 11:10">y'agurheganyize enjira.›<note caller="+" style="f"><char style="fr" closed="false">11.10 </char><char style="ft" closed="false">Osome Malaaki 3.1.</char></note><verse eid="MAT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11" />«Okuli, mbabwirire oku omu gulu lyooshi, harhashubiraga kuba omuntu olushire Yohaana Mubatiiza. Aliko oli mugeeke omu Bwami bw'empingu, yeewe ye mukulu kumulusha. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Gurhengera amango Yohaana Mubatiiza aliiri ayaamagaza eChinwa cha Nnamahanga guhika mu zino siku, abantu yi balwisa oBwami bw'empingu. Obo bwami, entwali zo ziri zashonda kuburhoola oku miisi. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Ebyo binwa byooshi byaderhwaga n'abaleebi booshi, n'omu Rhegeko lya Muusa guhika omu gihe cha Yohaana. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />N'akaba mwakagala kuyemeera, mumenye oku omuleebi Eliya waderhwaga oku ayinja, ali Yohaana. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Olaala ogwerhe amarhwi ayunve!»<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />«Abantu b'echiila gisisi nakabashushanya na bichi? Bashushire n'abaana bayikeere embuga eyi bali bajirisana omugalyo omu kuderha ntya:<verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />‹Rhwabazihiire omulizi,</para>
  <para style="q1" vid="MAT 11:17">murhanazinire.</para>
  <para style="q1" vid="MAT 11:17">Rhwabayimpiire enyimpo z'emishiibo,</para>
  <para style="q1" vid="MAT 11:17">murhanalakire!›<verse eid="MAT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 11:18" />«Kwenge Yohaana abeere ayinja, aliiri achilahiza kulya n'okunywa. Abantu balema baderha ntya: ‹Azimuhirwe!› <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Mwene oMuntu ayinjire, ali alya n'okunywa. Abantu bali baderha ntya: ‹Tala! Oyu muntu ali mudambi na kandi ali mulalu! Anali mwira w'abafurhiisa b'amakooli n'abandi bantu banyabyaaha!› Na chiro ntyo, obwenge bunene bwa Nnamahanga buli bwachiyerekana kulengera ebijiro byaage.»<verse eid="MAT 11:19" /></para>
  <para style="s">Ebishagala byalahira kuyemeera Yeesu</para>
  <para style="r">
    <ref loc="MAT 10:15">Matayo 10.15</ref>; <ref loc="LUK 10:12-14">Luuka 10.12-14</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Yeesu aja arhondera gukalihira ebishagala ajiraga mo ebisomereene binene, bulaala abantu b'eyo barhalishondere kuleka ebyaaha. Aderha ntya: <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />«Buhanya oku wooyo gishagala ch'eKoraziini! Na buhanya oku wooyo gishagala ch'eBetesayida! Kwenge najirire ebisomereene emwenyu. Ebyo bisomereene, nka nabijiraga omu gishagala ch'eTiiro n'ech'eSidoona, beene ebyo bishagala bakayambeere ebigunira n'oku gishiga oluvu omu kuyerekana oku balekere ebyaaha byaabo. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Cho girhumire, mbabwirire oku olusiku lw'ogucha olushinja, mwabo nji mwahanwa kulusha abantu b'egishagala ch'eTiiro n'aba ech'eSidoona.<verse eid="MAT 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 11:23" />«Naawe gishagala ch'eGaperinaumu, okengerere oku wazamulwa guhika empingu? Nangwa! Kuyandagazwa ku wayandagazwa guhika ekuzimu. Kwenge ebisomereene byajirikeene omu mwawe, nka byajirikanaga omu gishagala ch'eSodoomo, echo gishagala chakabeere gichiri ho zeene. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Cho girhumire, mbabwirire oku olusiku lw'ogucha olushinja, mwabo nji mwahanwa bweneene kulusha abantu b'egishagala ch'eSodoomo!»<verse eid="MAT 11:24" /></para>
  <para style="s">Yeesu akuuza Nnamahanga</para>
  <para style="r">
    <ref loc="LUK 10:21-22">Luuka 10.21-22</ref></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Mw'amoola mango, Yeesu aderha ntya: «Daarha wee! Wooyo we nyina empingu n'egulu, ngukuzize, bulaala ebi bintu wabibishire abanyabwenge bunene n'abasomi, aliko wabibishuulira abaana badoorho. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Neechi Daarha, ebyoola bikulikirene n'obulonza bwawe.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />«Daarha ampeere byooshi, nta muntu oyinji oMugala nk'arhali Daarha. Kandi nta muntu oyinji Daarha nk'arhali oMugala, na ngasi yeeshi oMugala ashondere kumuyeereka.»<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />«Mweshi mwe muli mwalibuka n'emizigo elemereere, muyinje emwani, naani nabahumuusa. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Muleme mwankenga, munaleme mwakulikira enyigirizo zaani, kwenge nyoono ngwerhe omurhima mwirhonzi. Mukajira ntyo, mwahumuuka. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Ogukulikira enyigirizo zaani kuyanguhire, n'omuzigo nabaheesa gurhalemereere.»<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Yeesu ye Nyina eSaabato</para>
  <para style="r">
    <ref loc="MRK 2:23-28">Mariko 2.23-28</ref>; <ref loc="LUK 6:1-5">Luuka 6.1-5</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Amo mango, lusiku luguma lw'eSaabato, Yeesu aliiri alenga omu mashwa m'engano. Abigirizwa baage baliiri nzara, echo charhuma balema bagenda eyi bali bayaagula emihuli y'engano n'okuyilya.<verse eid="MAT 12:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 12:2" />
    <char style="w" lemma="Bafarisaayo:">aBafarisaayo</char> babeere babona ntyo, babwira Yeesu ntya: «Lola kw'ebiila abigirizwa baawe bali bajira, noobo eRhegeko lyeerhu lirharhuyemereere mpu rhuleme rhwabijira olusiku lw'eSaabato!»<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Yeesu abashubiza ntya: «Ka murhashubiraga gusoma ebi Daawudi ajiraga egihe ayunvaga enzara, yeewe haguma n'abaliiri naye? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Ajaaga haguma nabo omu Nju ya Nnamahanga balya emigati ela abantu babaaga barhuliire Nnamahanga. Noobo, emigati eri nk'eyo barhaliyemereerwe kuyilya, olekere abadaahwa bonyine.<note caller="+" style="f"><char style="fr" closed="false">12.4 </char><char style="ft" closed="false">Osome 1Samweri 21.3-7; Balaawi 24.9.</char></note><verse eid="MAT 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 12:5" />«Na kandi, ka murhashubiraga gusoma omu Rhegeko lya Muusa oku ngasi lusiku lw'eSaabato, abadaahwa banakola omu Nju ya Nnamahanga barhali bakenga eRhegeko liyerekere olo lusiku? Noobo barhali baganjwa oku bajiriire kubi. <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Aliko leero, mbabwirire oku hano, hali omukulu kulusha eNju ya Nnamahanga.<verse eid="MAT 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 12:7" />«Nka mwamenyaga eby'echi chinwa chiderhere ntya: ‹Nshondere muyunvirane obonjo kulusha enterekeero zenyu.›<note caller="+" style="f"><char style="fr" closed="false">12.7 </char><char style="ft" closed="false">Osome Oseya 6.6.</char></note> Murhakalemere mwahana abarhagwerhe bubi. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Kwenge Mwene oMuntu ye Nyina eSaabato.»<verse eid="MAT 12:8" /></para>
  <para style="s">Yeesu afumya omuntu ohunzize efune olusiku lw'eSaabato</para>
  <para style="r">
    <ref loc="MRK 3:1-6">Mariko 3.1-6</ref>; <ref loc="LUK 6:6-11">Luuka 6.6-11</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Yeesu arhenga ahoola, aja omu sinagoogi y'aBayaahudi. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Mw'eyoola sinagoogi, mwaliiri omuntu walihunzize efune. Mwanaliiri abandi bantu bashondaga kugeregeza Yeesu. Baamubaza ntya: «K'eRhegeko lyeerhu liyemerere ogufumya omuntu olusiku lw'eSaabato?» Okumubaza ntyo, kwaliiri gushonda bamulege.<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Yeesu abashubiza ntya: «Nde mu mwabo nk'agwerhe ntaama nguma, n'eyo ntaama egarhogera omu kijokole olusiku lw'eSaabato, k'arhakayigwarha n'okuyikuula mo olo lusiku? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Noobo omuntu ali w'akamaro kulusha entaama! Cho girhumire, biyemereerwe kujira amenja olusiku lw'eSaabato.» <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Yeesu aj'abwira ola muntu w'okuboko guhunzize ntya: «Lambuula efune yaawe.» Naye alambuula ela fune, nayo yashuba kuba ngumanguma nk'eyindi. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" /><char style="w" lemma="Bafarisaayo:">aBafarisaayo</char> baja barhenga ho, banagenda kujirira Yeesu akaligi k'okumuyirha.<verse eid="MAT 12:14" /></para>
  <para style="s">Yeesu ye mukozi Nnamahanga agishogere</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Yeesu abeere akamenya ako kaligi k'aBafarisaayo, agirhengera mw'echo gishagala. Echigusho chinene ch'abantu bamukulikira. Afumya abalwala booshi. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Aliko abarhegeka oku barhamumenyesaga oku bantu. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Byabaaga ntyo, y'echo chinwa chijirike echi Nnamahanga aderhaga kugerera omuleebi Isaya ntya:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />«Mulole! Oyu ye mukozi waani nagishogere,</para>
  <para style="q1" vid="MAT 12:18">yeewe ye muzigirwa waani, eyi nsimiiswa naye!</para>
  <para style="q1" vid="MAT 12:18">Namuha oMuuka gwani,</para>
  <para style="q1" vid="MAT 12:18">nj'abalira abarhali Bayaahudi emyaazi y'okuli.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Arhakajira buhaka na muntu, changwa kujira olwamo.</para>
  <para style="q1" vid="MAT 12:19">na nta muntu nji wayunva omulenge gwage embuga.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Arhakavuna olusheke luchigonyere,</para>
  <para style="q1" vid="MAT 12:20">changwa arhakanazimya etara liri hoofu kuzima.</para>
  <para style="q1" vid="MAT 12:20">Arhajira ebyoola, guhika ayimanze ebinwa byooshi bikwaneene.<verse eid="MAT 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21" />N'eziino lyaage ly'abantu booshi nji balangalira.»<note caller="+" style="f"><char style="fr" closed="false">12.21 </char><char style="ft" closed="false">Osome Isaya 42.1-4.</char></note><verse eid="MAT 12:21" /></para>
  <para style="s">Abantu baderha oku Yeesu ye Belizebuuli</para>
  <para style="r">
    <ref loc="MRK 3:22-27">Mariko 3.22-27</ref>; <ref loc="LUK 11:14-23">Luuka 11.14-23</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Enyuma z'ebyo, baleerhera Yeesu omuntu ofarhirwe n'omuzimu. Oyo muzimu abaga ajirire oyo muntu mpumi kandi nyamugama. Yeesu amufumya, anarhondera kuderha n'okubona. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Eyo myaazi yasomeza echigusho chooshi ch'abantu. Barhondera kuderha ntya: «K'oyu muntu akaba mwene Daawudi?»<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Aliko <char style="w" lemma="Bafarisaayo:">aBafarisaayo</char> babeere bayunva ntyo, baderha ntya: «Oyu muntu ali alibisya abazimu oku buhashe bw'omukulu w'abazimu oyirikwa Belizebuuli!»<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Okubona oku Yeesu aliiri amenyere enkengeero zaabo, ababwira ntya: «Akaba abantu ba bwami buguma bakalwisanya, obo bwami eyi bwamashandala. N'akaba abantu ba gishagala chiguma changwa ba mulala muguma nabo bakalwisanya, abo bantu nabo eyi bamashandala. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />N'akaba Shetaani agachilibisya yeewe yenyine, obwami bwage naye eyi bwamashandala. <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Mwabo muli mwaderha oku ndi nalibisya abazimu oku buhashe bwa Belizebuuli. Leero abantu b'echigusho chenyu nabo balibabalibisya oku buhashe bwa nde? Ntyo, abo bantu benyu bo bayerekana oku mwagirhebekere. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Aliko nyoono ndinalibisya abazimu kugerera obuhashe bwa Muuka gwa Nnamahanga, n'echo cho chiyerekene okw'obwime bwa Nnamahanga bwahikiire ahagarhi kenyu.<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />«Ntaaye wakagala kuja omu nju y'owaabo ogwerhe emisi, mpu amunyege ebintu byaage, nk'arhaza kumushweka. Sy'aliko amango amamushweka, akagala kumunyega ebintu byaage byooshi.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />«Orhali haguma naani, eyi ali mushombanyi waani. N'orhali angwasa kugusha, eyi ali ashandaaza.»<verse eid="MAT 12:30" /></para>
  <para style="s">Omuntu nj'achiirwa olushinja gukulikirana n'ebinwa byaage</para>
  <para style="r">
    <ref loc="MRK 3:28-29">Mariko 3.28-29</ref>; <ref loc="LUK 12:10">Luuka 12.10</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 12:31" />«Cho girhumire mbabwirire okw'abantu nji bababalirwa ebyaaha byaabo byooshi n'ebidusi byaabo byooshi. Aliko, olaala nji wadukanga Muuka-Mutagatiifu, yeewe arhakababalirwa. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Na ngasi yeeshi nji waderha kubi elugulu wa Mwene oMuntu, nj'ababalirwa. Aliko olaala nji waderha kubi elugulu wa Muuka-Mutagatiifu, arhakababalirwa mu lino gulu changwa omu lyayinja.»<verse eid="MAT 12:32" /></para>
  <para style="s">Omurhi n'amalehe maago</para>
  <para style="r">
    <ref loc="MAT 7:16-20">Matayo 7.16-20</ref>; <ref loc="LUK 6:43-45">Luuka 6.43-45</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />«Akaba omurhi guli mwinja, amalehe maago namo mali menja. N'akaba omurhi gubihire, amalehe maago namo maaba mabihire. Kwenge omurhi gumenyikana kugerera amalehe maago. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Mwe buuko bw'enjoka! Gurhe mwe muli babi mwakagala kuderha emyaazi minja? Kwenge obuunu buderha ebiyunjwire omu murhima. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Omuntu mwinja akuula ebintu binja omu murhima gwage mwinja. N'omuntu mubi akuula ebintu bibi omu murhima gwage mubi. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Mbabwirire okw'olusiku lw'ogucha olushinja, abantu nji baburana elugulu w'ebinwa byooshi bya bushaabusha baderhere. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Kwenge kulengera ebinwa byaawe nji waganjwa mushinganyanya na kulengera ebinwa byaawe nji wahanwa.»<verse eid="MAT 12:37" /></para>
  <para style="s">Abigiriza b'amarhegeko n'aBafarisaayo bahema Yeesu echimenyeeso</para>
  <para style="r">
    <ref loc="MAT 16:1-4">Matayo 16.1-4</ref>; <ref loc="MRK 8:11-12">Mariko 8.11-12</ref>; <ref loc="LUK 11:16">Luuka 11.16</ref>,<ref loc="LUK 11:29-32">29-32</ref></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Abigiriza b'amarhegeko baguma n'<char style="w" lemma="Bafarisaayo:">aBafarisaayo</char> baguma baaja babwira Yeesu ntya: «Mwigiriza, rhushondere orhuyereke echimenyeeso chiguma.»<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Yeesu abashubiza ntya: «Abantu b'echi gisisi bali babi na bahemusi embere za Nnamahanga. Bali bashonda echimenyeeso, si ntaacho babona girhali chimenyeeso ch'omuleebi Yoona. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Kwenge nk'oku Yoona ajiraga siku esharhu ezuuba n'obudufu omu nda y'efi nene,<note caller="+" style="f"><char style="fr" closed="false">12.40 </char><char style="ft" closed="false">Osome Yoona 2.1.</char></note> ntyo ku Mwene oMuntu naye amala siku esharhu, zuuba n'obudufu ali omu shinda. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Olusiku lw'ogucha olushinja, abantu b'eNinaawi nji bayimanga embere z'abantu b'echi gisisi n'okubahaniisa, bulaala boowe balekere ebyaaha byaabo byooshi amango bayunvaga enyigirizo za Yoona. Bunoola, hano hali olushire Yoona! <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Kandi olusiku lw'ogucha olushinja, mwamikazi w'eGarhongo<note caller="+" style="f"><char style="fr" closed="false">12.42 </char><char style="ft" closed="false">Osome 1 Baami 10.1-10.</char></note> nj'ayimanga embere z'abantu b'echi gisisi n'okubahaniisa, bulaala yeewe arhengaga omu gihugo cha hale bweneene y'ayinje kuyunviriza obwenge bunene bwa Solomoono. Bunoola, hano hali olushire Solomoono!<verse eid="MAT 12:42" /></para>
  <para style="s">Okugaluka kw'omuzimu omu muntu</para>
  <para style="r">
    <ref loc="LUK 11:24-26">Luuka 11.24-26</ref></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />«Amango omuzimu arhengere omu muntu, anayereera omu mpinga omu gushonda ahantu agahumukira. Akabula ho, <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />anachibwira ntya: ‹Nagaluka omu nju yaani narhengaga mo.› Hano aba amagaluka mo, anayibugana mwanjaale, ebizizwe enarheganyizwe bwinja. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Oku buzinda, anajirhoola bandi bazimu mushanvu babi kumulusha, booshi banaja mw'eyo nju n'okuyikala mo. Oboorhere bw'oyo muntu bwanaba bubi bweneene kulusha obwambere. Ntyo ku nji byaaba oku bantu b'echi gisisi chibi.»<verse eid="MAT 12:45" /></para>
  <para style="s">Nyina wa Yeesu na beene baabo Yeesu</para>
  <para style="r">
    <ref loc="MRK 3:31-35">Mariko 3.31-35</ref>; <ref loc="LUK 8:19-21">Luuka 8.19-21</ref></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Yeesu abeere achiri ashambaala n'echigusho ch'abantu, nyina na beene baabo bahika. Bayimanga embuga, kwenge balishondere kuganiira naye. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Muntu muguma aja abwira Yeesu ntya: [«Nyoko na beene benyu bayimangire embuga. Bali bashonda kuganiira naawe.»]<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />Yeesu amushubiza ntya: «Nde ye nyaama? Na beene beerhu bo bande?» <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Oku buzinda alambuula efune emunda abigirizwa baage bali n'okuderha ntya: «Tala, aba bo beene beerhu na nyaama! <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Kwenge ngasi yeeshi ojira obulonza bwa Daarha oli empingu, oyo ye mwene weerhu, mwali weerhu na nyaama.»<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Omugani guyerekeere omuhinzi</para>
  <para style="r">
    <ref loc="MRK 4:1-9">Mariko 4.1-9</ref>; <ref loc="LUK 8:4-8">Luuka 8.4-8</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Mw'olo lusiku, Yeesu ahuluka omu nju, anagenda kuyikala aha burhambi bw'enyanja. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Abantu banene bamuyegeera. Echo charhuma ashonera omu chombo n'okuyikala mo. Echigusho chooshi ch'abantu chayoorha chiyimangire emushengo.<verse eid="MAT 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 13:3" />Yeesu abayigiriza myaazi minene kulengera emigani. Ababwira ntya: «Haliiri omuhinzi muguma wajaaga kubyaala. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Abeere ali abyaala, embeke ziguma zarhogera aha burhambirhambi bw'enjira. Enyunyi zayinja n'okulya zo. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Ezindi zarhogera omu lukalabuye, ahantu aharhali budaka bunene. Zamera juba kwenge obudaka bwabaaga bugeehere. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Aliko ezuuba lyabeere lyakola, lyaziyoosa. Na kwenge zirhaligwerhe emizi minene, zayuuma. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Ezindi zarhogera omu mishaaki. Eyo mishaaki yabeere yakula, yazifundeeza. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Aliko ezindi mbeke zarhogera omu budaka bwinja. Zabeere zakula, zayeeza amalehe. Ziguma zayeeza amalehe egana, n'ezindi makumi gali ndarhu, n'ezindi makumi masharhu. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Ola ogwerhe amarhwi ayunve!» <figure style="fig" alt="Le semeur " file="DN00470b.tif" size="col" ref="13.9">Omuhinzi wabyaalaga emburho</figure><verse eid="MAT 13:9" /></para>
  <para style="s">Egirhuma Yeesu ayigiriza omu migani</para>
  <para style="r">
    <ref loc="MRK 4:10-12">Mariko 4.10-12</ref>; <ref loc="LUK 8:9-10">Luuka 8.9-10</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Enyuma z'ebyo, abigirizwa ba Yeesu bamuyegeera n'okumubaza ntya: «Waliha! Gichi girhuma onaderha n'abantu omu migani?» <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />Naye abashubiza ntya: «Mwabo mwabishuliirwe okumenya ehwe ly'oBwami bw'empingu. Aliko abandi boowe barhabishuliirwaga okulimenya. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Kwenge omuntu ogwerhe akantu nj'ayushulirwa akandi, naye anagwarha bintu binene. Aliko omuntu orhagwerhe kantu, nj'anyegwa chiro na hila hityu akengerere oku agwerhe. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Echo chogirhuma nderha nabo omu migani. Kwenge abo bantu banalola sy'aliko barhabona, banayunviiriza sy'aliko barhayunva changwa barhamenyerera. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />Leero, byayeneere oku bo ebi binwa omuleebi Isaya aderhaga ntya:</para>
  <para style="q1" vid="MAT 13:14">‹Okuyunva, mwayunva, aliko murhamenyerera.</para>
  <para style="q1" vid="MAT 13:14">Okulola, mwalola, aliko murhabona.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Kwenge aba bantu bajirire emirhima yaabo kuba mizibu,</para>
  <para style="q1" vid="MAT 13:15">bafukire amarhwi maabo,</para>
  <para style="q1" vid="MAT 13:15">banazibize ameesho maabo,</para>
  <para style="q1" vid="MAT 13:15">yi barhabonaga, barhanayunvaga,</para>
  <para style="q1" vid="MAT 13:15">changwa barhampindamukiraga.</para>
  <para style="q1" vid="MAT 13:15">Kwenge akaba bankampindamukire, nakabafumize.›<note caller="+" style="f"><char style="fr" closed="false">13.15 </char><char style="ft" closed="false">Osome Isaya 6.9-10.</char></note><verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />«Aliko mwabo, mugishirwe bulaala ameesho menyu yi mabona na marhwi menyu yi mayunva! <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Okuli mbabwirire, baleebi banene n'abantu banene bakwaneene embere za Nnamahanga, baligifinjire kubona oku bimuli mwabona ko, aliko barhabibonaga ko. Banaligifinjire kuyunva oku bimuli mwayunva ko, aliko barhabiyunvaga ko.<verse eid="MAT 13:17" /></para>
  <para style="s">Yeesu ahuguula omugani guyerekeere omuhinzi</para>
  <para style="r">
    <ref loc="MRK 4:13-20">Mariko 4.13-20</ref>; <ref loc="LUK 8:11-15">Luuka 8.11-15</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />«Mujaage mwayunviriza ech'ogo mugani g'omuhinzi guderhere. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Embeke zarhogeraga aha burhambirhambi bw'enjira, zishushanyizwe n'abantu banayunva eChinwa ch'oBwami bwa Nnamahanga, aliko barhachimenya. Oku buzinda, Shetaani anayinja n'okugikuula omu mirhima yaabo. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Embeke zarhogeraga ahantu h'amabaale, zishushanyizwe n'abantu banayunva eChinwa cha Nnamahanga n'oguchiyankiriira n'obushagaluke bunene. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Aliko, echo Chinwa girhaseera omu mirhima yaabo. Banajira nk'oku chiderhere omu bishanji bigeeke, amango amaganya changwa amalibuko mahikaga elugulu w'eChinwa cha Nnamahanga, ho n'aho banaleka obwemeezi bwabo. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Ezindi mbeke zarhogeraga omu mishaaki, zishushanyizwe n'abantu bayunva eChinwa cha Nnamahanga, aliko amalibuko m'egulu n'enyifinjo zibi z'ebikulo, byanafundeeza cho omu mirhima yaabo, kwanarhuma echo Chinwa girhagwarha amalehe. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Zila mbeke zarhogeraga omu budaka bwinja, zoowe zishushanyizwe n'abantu banayunva eChinwa cha Nnamahanga n'oguchimenya. Oku buzinda, echo Chinwa chanayeeza amalehe omu mirhima yaabo. Baguma banayeeza malehe egana, n'abandi makumi gali ndarhu n'abandi makumi masharhu.»<verse eid="MAT 13:23" /></para>
  <para style="s">Omugani guyerekeere ebirhi bibi</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Yeesu abachiira ogwindi mugani, aderha ntya: «Obwami bw'empingu bushushanyizwe na muntu muguma wabyaalaga emburho nyinja omu shwa lyaage. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Aliko lusiku luguma obudufu, amango abantu booshi babaaga balyaamire, omushombanyi waage ayinja n'okubyaala ebirhi bibi omu ngano, anachigendera. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Engano zabeere zamera n'okuyaasa, ebyo birhi bibi nabyo byabonekana.<verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />«Abaja ba nyina eshwa bayinja kumubwira ntya: ‹Waliha, k'arhali mburho nyinja wabyaalaga omu shwa lyaawe? Ngahe leero ebi birhi bibi birhengeere?› <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />Naye abashubiza ntya: ‹Omushombanyi ye wajirire ntyo.› Abo baja baashuba kumubaza ntya: ‹K'oshondere rhuje kubishigulanga?› <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Aliko abashubiza ntya: ‹Nangwa! Hali okuntu mwakabishigula haguma n'engano. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Mubileke bikulire byooshi haguma guhika amango m'ogushaluula. Amo mango nji nabwira abashaluuzi ntya: "Murhange mushigule ebirhi bibi munabigushe bilundo-bilundo n'okubichumika. N'oku buzinda mugushe engano omu nguli yaani."›»<verse eid="MAT 13:30" /></para>
  <para style="s">Omugani guyerekeere ehibeke hye haradaali</para>
  <para style="r">
    <ref loc="MRK 4:30-32">Mariko 4.30-32</ref>; <ref loc="LUK 13:18-21">Luuka 13.18-21</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Yeesu abachiira guno gwindi mugani, aderha ntya: «oBwami bw'empingu bushushanyizwe n'ehibeke hye haradaali muntu muguma arhoolaga anahibyaala omu shwa lyaage. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Ehyo hibeke hye hityu omu mburho zooshi. Aliko hyabeere hyamera, hyaaba murhi munene kulusha eyindi mirhi yooshi y'omu shwa, oku bulyo enyunyi zinayinja n'okuyumbaka enyoogo zaazo omu marhabi maago.»<verse eid="MAT 13:32" /></para>
  <para style="s">Omugani guyerekeere echachu</para>
  <para style="r">
    <ref loc="LUK 13:20-21">Luuka 13.20-21</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Yeesu ashuba kubachiira ogwindi mugani omu kuderha ntya: «oBwami bw'empingu bushushanyizwe n'echachu mukazi muguma arhoolaga, ayihira omu milengo esharhu y'eshaano omu gukwiza emigati, yooshi yarhunda.»<verse eid="MAT 13:33" /></para>
  <para style="s">Enyigirizo kulengera emigani</para>
  <para style="r">
    <ref loc="MRK 4:33-34">Mariko 4.33-34</ref></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Eyi myaazi yooshi, Yeesu aliiri ayibwira echigusho ch'abantu omu migani. Nta mwazi aderhere nabo buzira gukoleesa emigani. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Aliiri ajira ntyo yi bijirike ebinwa omuleebi aderhaga ntya:</para>
  <para style="q1" vid="MAT 13:35">«Nji nalema naderha nabo omu migani,</para>
  <para style="q1" vid="MAT 13:35">nji nababwira ebinwa byalibishirwe gurhengera okulemwa kw'egulu.»<note caller="+" style="f"><char style="fr" closed="false">13.35 </char><char style="ft" closed="false">Osome Nanga 78.2.</char></note><verse eid="MAT 13:35" /></para>
  <para style="s">Yeesu ahuguula omugani guyerekeere ebirhi bibi</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Yeesu abeere amaseezera echigusho ch'abantu, aja omu nju. Abigirizwa baage bamuyegeera n'okumubwira ntya: «Ogo mugani gw'ebirhi bibi byaliiri omu shwa, orhuhuguulire go.» <verse eid="MAT 13:36" /><verse number="37" style="v" sid="MAT 13:37" />Naye ababwira ntya: «Ola wabyaalaga emburho nyinja, ali Mwene oMuntu. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Eshwa, liri gulu. Na zila mbeke zinja, zishushanyizwe n'abantu b'omu Bwami bwa Nnamahanga. Na bila birhi bibi, bishushanyizwe n'abantu ba Shetaani. <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />N'omushombanyi wabyaalaga ebyo birhi bibi, ali Shetaani. N'eshaluulo, eshushanyizwe n'obuzinda bw'egulu. N'abogushaluula, bashushanyizwe na bamalahika. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Nka kulaala ebirhi bibi binashiguulwa n'ogukabulwa omu muliro, ntyo ku nji byaaba oku buzinda bw'egulu. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Kwenge Mwene oMuntu nj'arhuma bamalahika baage omu Bwami bwage, baje kugusha abantu booshi banarhuma abandi bajira ebyaaha, haguma n'abandi booshi bakola amabi. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Abo bamalahika nji bakabula abo bantu booshi omu chibeeyi ch'omuliro, n'omoola nji balaka n'oguhekenya amenyo. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Aliko abakwaneene nji babaraganya nka zuuba<note caller="+" style="f"><char style="fr" closed="false">13.43 </char><char style="ft" closed="false">Osome Danyeeri 12.3.</char></note> omu Bwami bw'eShe waabo. Olaala ogwerhe amarhwi, ayunve!»<verse eid="MAT 13:43" /></para>
  <para style="s">Omugani g'obuchire bwali bubishirwe</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />«oBwami bw'empingu bushushanyiizwe n'obuchire bwabaga bubishirwe omu shwa. Obo buchire, muntu muguma abubona, anashuba kububisha. Oyo muntu ashagaluka bweneene anaja kuguza ebintu byaage byooshi, oku buzinda agula elyo shwa.<verse eid="MAT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />«oBwami bw'empingu bushushanyiizwe kandi n'omurhimbuuzi muguma walishondeere kugula amagerha m'egichiiro. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Abeere abona eyanga liguma lyagachiiro, aja kuguza ebintu byaage byooshi n'okuligula.»<verse eid="MAT 13:46" /></para>
  <para style="s">Omugani guyerekeere omulaga</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />«oBwami bw'empingu bushushanyiizwe kandi n'omulaga bahiraga omu nyanja, nago gwayirha ngasi buuko bw'efi. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Omulaga gwabeere gwabumba efi, abashaana bagukuluulira emushengo. Oku buzinda, bayikala n'okulondoola efi. Ezikwiriire bazihira omu rhurhanda n'ezirhakwiriire bazikabula. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Leero, nji byaaba ntyo oku buzinda bw'egulu. Bamalahika nji bayinja n'oguhira abantu babi olwabo lunda n'abakwaneene olwabo lunda. <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />Nji bakabula abantu babi omu chibeeyi ch'omuliro, na m'ogoola muliro nji balaka n'oguhekenya amenyo.»<verse eid="MAT 13:50" /></para>
  <para style="s">Omugani guyerekeere ebintu bihyaahya n'ebya miira</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Yeesu abaza abigirizwa baage ntya: «Ka mwayunviirhe ebi binwa byooshi?» Nabo bamushubiza ntya: «Neechi, rhwayunviirhe.»<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Oku buzinda, Yeesu abwira abigirizwa ntya: «Ngasi mwigiriza w'eRhegeko wayigirizwe elugulu w'oBwami bw'empingu, ashushanyiizwe na nyina enju oli wakuula omu buchire bwage ebintu bihyaahya n'ebya miira.»<verse eid="MAT 13:52" /></para>
  <para style="s">Abantu b'eNazareeti balahira Yeesu</para>
  <para style="r">
    <ref loc="MRK 6:1-6">Mariko 6.1-6</ref>; <ref loc="LUK 4:16-24">Luuka 4.16-24</ref></para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Yeesu abeere amamala gucha eyi migani, arhenga ahoola. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Agenda omu gishagala akuliraga mo. Ahikire mo, arhondera kuyigiriza abantu omu sinagoogi yaabo. Abantu basomerwa, barhondera guchibaza ntya: «Ngahe oyu muntu akuliire obwenge bunene nk'obu n'obuhashe b'okujira ebi bigiriginjo? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Oyu k'arhali mugala w'ola mubeeji w'empaho? Nyina k'arhali ye Mariya? Na beene baabo ka barhali Yakobo, Yozefu, Simooni na Yuuda? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Na baali baabo booshi ka rhurhalamire haguma nabo hano? Leero ngahe amakuula ebi byooshi?» <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Oko kw'arhuma barhamuyemeera.</para>
  <para style="p" vid="MAT 13:57">Aliko Yeesu ababwira ntya: «Omuleebi anakengwa ahantu hooshi, aliko anabula olukengo omu gishagala chaage n'omu mulala gwage.»<verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />Yeesu arhajiraga ebisomereene binene eyo munda, kwenge abantu b'eNazareeti balilahire kuyemeera.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Yohaana Mubatiiza ayirhwa</para>
  <para style="r">
    <ref loc="MRK 6:14-29">Mariko 6.14-29</ref>; <ref loc="LUK 9:7-9">Luuka 9.7-9</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Mw'ezoola siku, <char style="w" lemma="Heroode:">Heroode</char> waliyimire omu gihugo ch'eGalilaaya, ayunva baderha elugulu wa Yeesu. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />Abwira abashamuka baage ntya: «Oyu muntu ali Yohaana Mubatiiza wafuukire! Cho girhumire agwarha obuhashe b'okujira ebisomereene.»<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Heroode abaaga ashwekesize Yohaana. Aderha oku bamushweke banamukabule omu munyororo, elugulu wa Herodiya muka Firipo. Oyo Firipo aliiri mwene waabo Heroode. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Kwenge Yohaana alibwiriire Heroode ntya: «eRhegeko lyeerhu lirhakuyemereere okw'oshabe oyu Herodiya!» <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Heroode alishondere kuyirha Yohaana, aliko aliyuubahire abantu, kwenge booshi balirhoolere Yohaana nka muleebi.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Olusiku lukulu l'okuyibuka okuburhwa kwa Heroode lwabeere lwahika, mwali wa Herodiya azina embere z'abalaalikwa. Oko kuzina kwage kwasiimisa bweneene Heroode. <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />Echo charhuma amulaganya kugerera endahiro oku amuha ngasi chintu chooshi ahema. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Oyo munyere abeere ahema nyina ehano, abwira Heroode ntya: «Ompereeze bonabuno erhwe lya Yohaana Mubatiiza oku mbale.»<verse eid="MAT 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9" />Mwami ababazwa bweneene, aliko elugulu w'endahiro ajiraga embere z'abalilalikiirwe, arhegeka okw'oyo munyere ahaabwe erhwe lya Yohaana. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Ava arhuma muntu muguma aje omu munyororo gucha erhwe lya Yohaana. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Baleerha elyo rhwe oku mbale, baliheereza oyo munyere, naye alihekera nyina. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Oku buzinda, abigirizwa ba Yohaana bayinja gurhoola omubiri gwage, banaja kuguhamba. Eyi myaazi, baaja kuyibalira Yeesu.<verse eid="MAT 14:12" /></para>
  <para style="s">Yeesu aliisa bantu hoofu bihumbi birhaano</para>
  <para style="r">
    <ref loc="MRK 6:30-44">Mariko 6.30-44</ref>; <ref loc="LUK 9:10-17">Luuka 9.10-17</ref>; <ref loc="JHN 6:1-14">Yohaana 6.1-14</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Yeesu abeere ayunva ntyo, arhenga ahoola n'echombo, n'okuja yenyine ahantu harhali bantu. Abantu babeere bayunva ntyo, barhenga omu bishagala byaabo, bamukulikira n'amagulu. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Yeesu abeere arhenga omu chombo, abona echigusho chinene ch'abantu, abafiira obonjo, anafumya abalwala baliiri omu bo.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Lyabeere golo, abigirizwa baage bamuyegeera n'okumubwira ntya: «Hano, rhuli omu mpinga bwanayirire. Cho girhumire oleke aba bantu bagende omu bishagala yi bagule ebiryo.» <verse eid="MAT 14:15" /><verse number="16" style="v" sid="MAT 14:16" />Aliko Yeesu ababwira ntya: «Aba bantu, barhakwaneene kugenda. Mwabo mwenyine mubahe ebiryo.» <verse eid="MAT 14:16" /><verse number="17" style="v" sid="MAT 14:17" />Nabo, bamubwira ntya: «Waliha! Rhugwerhe hano migati erhaano na fi ebiri byonyine.» <verse eid="MAT 14:17" /><verse number="18" style="v" sid="MAT 14:18" />Yeesu ababwira ntya: «Munderhere byo hano.»<verse eid="MAT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 14:19" />Yeesu aja arhegeka echigusho ch'abantu bayikale oku byaasi. Arhoola eyo migati erhaano n'ezo fi ebiri, ayerekeza ameesho empingu n'ogukuuza Nnamahanga. Ayichagulanga, anayiha abigirizwa baage. Nabo bayigabira echigusho ch'abantu. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Abo bantu booshi balya n'okuyugurha. Abigirizwa babeere bagusha ebyayoorhaga, byayunjuza rhurhanda ekumi na rhubiri. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Abantu balyaaga ebyo biryo, baliiri hoofu balume bihumbi birhaano, buzira kuganja abakazi n'abaana.<verse eid="MAT 14:21" /></para>
  <para style="s">Yeesu alambagira oku nyanja</para>
  <para style="r">
    <ref loc="MRK 6:45-52">Mariko 6.45-52</ref>; <ref loc="JHN 6:15-21">Yohaana 6.15-21</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Enyuma z'aho, Yeesu arhegeka abigirizwa baage baje omu chombo, banamurhange eshiiriza y'enyanja. Yeewe, ayoorha aseezera echo chigusho ch'abantu.<verse eid="MAT 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 14:23" />Abeere amabaseezera, azamuukira yenyine oku musozi gusaliira Nnamahanga. Obudufu bwahika eyi achiri yo yenyine. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Mw'ebyo bishanji, echombo chabaaga chahikire omu muhengere. Omulaba gwagihulukira embere. N'ogo mulaba gwarhondera kulwisalwisa echo chombo. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />Yabeere miseke, Yeesu aja emunda abigirizwa baage baliiri eyi ali alambagira oku nyanja. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Abigirizwa babeere bamubona ali alambagira oku nyanja, bayuubaha bweneene, banaderha ntya: «Muzimu oliira!» Banarhondera kuyaama elugulu w'obuuba. <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />Ho n'aho Yeesu ababwira ntya: «Mugihe omurhima! Nyoono onoola! Murhayuubahaga.»<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Petero amushubiza ntya: «Nnaweerhu! Akaba okuli onali wooyo, onyemeerere nyinje oku nyanja emunda oli.» <verse eid="MAT 14:28" /><verse number="29" style="v" sid="MAT 14:29" />Yeesu amubwira ntya: «Yinja!» Ho n'aho Petero arhenga omu chombo y'aje emunda Yeesu ali, eyi ali alambagira oku nyanja. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Aliko abeere abona omuhusi gukalihire, ayuubaha, anarhondera kuyika. Aliika omulenge omu kuderha ntya: «Nnaweerhu! Onchungule!» <verse eid="MAT 14:30" /><verse number="31" style="v" sid="MAT 14:31" />Yeesu ava alambuula efune amugwarha. Anamubwira ntya: «Ego muntu w'obwemeezi bugeeke! Charhumaga wayuubaha?»<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />Yeesu na Petero babeere bashonera omu chombo, endeera yaaba. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Abaliiri omu chombo, bafukama embere za Yeesu n'okuderha ntya: «Okuli, oli Mwene Nnamahanga!»<verse eid="MAT 14:33" /></para>
  <para style="s">Yeesu afumya balwala banene eGenezareeti</para>
  <para style="r">
    <ref loc="MRK 6:53-56">Mariko 6.53-56</ref></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Yeesu n'abigirizwa baage babeere bayambuka enyanja, bahika omu gihugo ch'eGenezareeti. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Abantu b'eyo babeere barhegeerera Yeesu, barhuma omwazi ngasi hooshi mw'echo gihugo. Banamuleerhera abalwala booshi. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Bamuyinginga aleke bahume chiro oku mushoojo gw'efulema yaage. Na booshi baguhumaga ko, bafuma.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">Yeesu aderha elugulu w'emigenzo y'aBayaahudi</para>
  <para style="r">
    <ref loc="MRK 7:1-13">Mariko 7.1-13</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Enyuma z'ebyo, <char style="w" lemma="Bafarisaayo:">aBafarisaayo</char> n'abigiriza b'amarhegeko bahikira Yeesu gurhengera eYerusaleema. Baamubaza ntya: <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />«Bichi birhumire abigirizwa baawe barhali bakenga emigenzo ya bashookuluza beerhu? Kwenge boowe, barhali bakalaba efune embere z'okulya gukulikirana n'eyo migenzo!»<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Yeesu abashubiza ntya: «Nenyu, girhumire murhali mwakenga eRhegeko lya Nnamahanga omu gukulikira emigenzo yenyu? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Kwenge Nnamahanga aderhaga ntya: ‹Orhuule wakenga yisho na nyoko.› Kandi aderhere ntya: ‹Ola wadukanga eshe changwa nyina, akwaneene ayirhwe.› <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Aliko mwabo, munaderha oku omuntu akagala kubwira eshe changwa nyina mpu: ‹Echintu nankagurhabere mo, narhuulire cho miira emwa Nnamahanga.› <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Omu kujira ntyo, yi mwaderha ok'omuntu arhalemaga arhabaala eshe changwa nyina. Ntyo, muli mwakena eChinwa cha Nnamahanga elugulu w'ogukulikira emingenzo yenyu.<verse eid="MAT 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 15:7" />«Mwe ndyaalya! Isaya aderhaga okuli, amango aleebaga elugulu wenyu ntya:<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />‹Bano bantu, bali bankenga oku buunu bonyine,</para>
  <para style="q1" vid="MAT 15:8">aliko emirhima yaabo eba hale naani.<note caller="+" style="f"><char style="fr" closed="false">15.8 </char><char style="ft" closed="false">Osome Isaya 29.13.</char></note><verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Kwenge okumparamya banamparamya, kuli kwa busha,</para>
  <para style="q1" vid="MAT 15:9">n'enyigirizo banayigiriza, biri binwa byajirwaga n'abantu.›»<verse eid="MAT 15:9" /></para>
  <para style="s">Ebintu bizingiisa omuntu</para>
  <para style="r">
    <ref loc="MRK 7:14-23">Mariko 7.14-23</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Enyuma z'ebyo, Yeesu ahamagala echigusho ch'abantu. Anababwira ntya: «Murhege amarhwi munayunvirize ebinwa nababwira. <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Echija omu buunu b'omuntu, arhaali cho chimuzingiisa. Aliko chilaala girhenga mo cho chimuzingiisa.»<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Abigirizwa baage baja bamuyegeera n'okumubaza ntya: «K'orhenji okw'ebi binwa waderhere byagayisize <char style="w" lemma="Bafarisaayo:">aBafarisaayo</char>?» <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" />Yeesu abashubiza ntya: «Ngasi mburho yooshi Daarha w'empingu arhabyaalaga nji yashigulwa. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Cho girhumire, mubaleke abo Bafarisaayo! Kwenge bali mpumi ziri zalambagiza ezindi mpumi. Leero, akaba empumi eri yalambagiza eyaabo, booshi oku bali bombi banarhogera omu kijokole.»<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Petero ava amubwira ntya: «Waliha, orhuhuguulire ogo mugani.» <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />Yeesu amushubiza ntya: «Ka nenyu murhaza kuba n'obwenge bw'okumenya? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Ka murhamenyere oku ngasi chooshi chija omu buunu b'omuntu, chinaja omu nda, n'oku buzinda chanarhenga n'okuja omu musarani? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Aliko byooshi birhenga omu buunu, omu murhima mu biba birhengeere. N'ebyo bye bizingiisa omuntu. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Bulaala omu murhima mo murhenga enkengeero zibi zileerha obunizi, obuhushi, obubaraaga, obwizi, obuhamiiriza b'obubeeshi n'okudukangana. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Ebi bye bizingiisa omuntu. Aliko okulya buzira gukalaba efune, gurhakazingiisa omuntu.»<verse eid="MAT 15:20" /></para>
  <para style="s">Obwemeezi b'omukanaana-kazi</para>
  <para style="r">
    <ref loc="MRK 7:24-30">Mariko 7.24-30</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Yeesu abeere arhenga ahoola, aja oku lunda luli hoofu n'egishagala ch'eTiiro n'eche Sidoona. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Abeere ahika yo, Mukanaana-kazi muguma walilamire eyo munda, amuhikira eyi ali amulakiirira omu kuderha ntya: «Nnaweerhu, Mwene Daawudi, ombeere obonjo! Mwali waani, abazimu yi bamulibuza bweneene!»<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Aliko ntaacho Yeesu amushubiize. Oku buzinda, abigirizwa baage bamuyegeera n'okumubwira ntya: «Oyu mukazi ali arhubera erhwe. Omubwire arhenge hano.» <verse eid="MAT 15:23" /><verse number="24" style="v" sid="MAT 15:24" />Yeesu ashubiza ntya: «Ntumirwe oku lubaga lw'aBaisraheeli lonyine, kwenge baali nka ntaama zaherere.»<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Aliko oyo mukazi ayinja n'okuva afukama embere za Yeesu anamubwira ntya: «Nnaweerhu, ontabaale!» <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />Yeesu amushubiza ntya: «Birhali binja gurhoola ebiryo by'abaana n'okubiheereza ebibwana by'embwa.»<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />Oyo mukazi aderha ntya: «Neechi Nnaweerhu! Oderhere okuli. Aliko chiro n'ebibwana by'embwa, binalya orhulyo rhunarhoga oku meeza ma nnahamwabo.» <verse eid="MAT 15:27" /><verse number="28" style="v" sid="MAT 15:28" />Yeesu aja amushubiza ntya: «Mukazi we! Obwemeezi bwawe buli bunene. Cho girhumire bikubeere nk'oku oshondere.» Mw'ebyo bishanji mwali w'oyo mukazi ava afuma.<verse eid="MAT 15:28" /></para>
  <para style="s">Yeesu afumya balwala banene</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Enyuma z'ebyo, Yeesu arhenga eyo munda, agera eburhambirhambi bw'enyanja y'eGalilaaya. Ava azamuukira oku musozi, ayikala okoola. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Bantu banene bweneene baja bamuhikira. Bamuleerhera ebirema n'empumi, banyamugama n'abantu bahunzize, n'abandi balwala banene. Bahira bo booshi embere za Yeesu, naye abafumya. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Abo bantu booshi basoomerwa bweneene kwenge balibwene banyamugama baderha, ebirema byaaba bigumaguma, abahunzize balambagira n'empumi zabona. Banalema bakuuza Nnamahanga w'eIsraheeli.<verse eid="MAT 15:31" /></para>
  <para style="s">Yeesu ayugusya balume bihumbi bine</para>
  <para style="r">
    <ref loc="MRK 8:1-10">Mariko 8.1-10</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Yeesu ahamagala abigirizwa baage, ababwira ntya: «Nabereere aba bantu obonjo, kwenge zeene zikola siku esharhu bali haguma naani eyi barhanagwerhe echo kulya. Ntashondere kubaleka bagende buzira kulya yi barhaholera omu njira n'enzara.»<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Abigirizwa baage bamushubiza ntya: «Hano, rhuli omu mpinga, ngahe rhwaja rhwabona ebiryo by'okuyugusya olu lubaga lungana ha?» <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />Yeesu ababaza ntya: «Mugwerhe migati nga?» Nabo bamushubiza ntya: «Rhugwerhe migati mushanvu n'efi zigeheere, kandi zigekegeeke.»<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Yeesu arhegeka abo bantu booshi oku bayikale. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Arhoola ela migati mushanvu na zila fi, akuuza Nnamahanga, anayichagulanga, ayiheereza abigirizwa baage. Nabo, babigabira echigusho ch'abantu. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Booshi baalya banayugurha. Abigirizwa ba Yeesu babeere bagusha ebisigazo, bayunjuza rhurhanda mushanvu. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Abalyaaga ebyo biryo, baliiri balume bihumbi bine buzira kuganja abakazi n'abaana.<verse eid="MAT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39" />Enyuma z'aho, Yeesu asezera abo bantu, aja omu chombo, anagenda olunda lw'eMagadani.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">aBafarisaayo n'aBasadukaayo bahema Yeesu echimenyeso</para>
  <para style="r">
    <ref loc="MRK 8:11-13">Mariko 8.11-13</ref>; <ref loc="LUK 12:54-56">Luuka 12.54-56</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Lusiku luguma <char style="w" lemma="Bafarisaayo:">aBafarisaayo</char> n'aBasadukaayo bahikira Yeesu yi bamugeregeze. Bamuhema abajirire echimenyeso chiyerekene oku obuhashe bwage okuli burhengereere empingu.<verse eid="MAT 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2" />Yeesu abashubiza ntya: «Omu bishanji by'egolo, munaderha ntya: ‹Ebichu bidukwire, omuseezi, lwaba lusiku lwinja.› <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />N'omu bishanji by'eseezi munaderha ntya: ‹Ebichu byayiragwire, zeene envula yarhoga.›</para>
  <para style="p" vid="MAT 16:3">«Munamenya ebishanji amango mubwene ebichu. Leero, zino siku muli mo, gurhe murhazimenyere? <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Abantu b'echi gisisi bali babi kandi banali ndyaalya embere za Nnamahanga! Bali bahema echimenyeso, aliko nta chimenyeso bayerekwa girhali chila ch'omuleebi Yoona.» Oku buzinda, Yeesu abaleka anachigendera.<verse eid="MAT 16:4" /></para>
  <para style="s">Echachu y'aBafarisaayo n'aBasadukaayo</para>
  <para style="r">
    <ref loc="MRK 8:14-21">Mariko 8.14-21</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Amango abigirizwa ba Yeesu bayambukaga enyanja, baliiri bayibirire guheeka emigati. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Yeesu ababwira ntya: «Mube hoobwe! Muchilange n'echachu<note caller="+" style="f"><char style="fr" closed="false">16.6 </char><char style="ft" closed="false">Echachu </char><char style="ft" closed="false">eba shaano baalagaliza oku shaano y'ogukwiza emigati, y'erhunda. </char></note> y'<char style="w" lemma="Bafarisaayo:">aBafarisaayo</char> n'aBasadukaayo.»<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />Abo bigirizwa barhondera kubwirana ntya: «Aderhere ntyo kwenge rhurhaleerhere emigati.»<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Yeesu amenya ebyoola baliiri babwirana. Echo charhuma ababwira ntya: «Munali bantu b'obwemeezi bugeeke! Gurhe muli mwachiderhesa oku murhagwerhe migati? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Ka murhanaza kumenya? Ka murhayibukire bala bantu bihumbi birhaano, gurhe bayugurhaga ela migati erhaano, na rhurhanda rhunga rhw'emisigala mwagushaga? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Changwa murhayibukire kandi bala bantu bihumbi bine nabo, gurhe bayugurhaga ela migati mushanvu, na rhurhanda rhunga rhw'emisigala mwagushaga? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Bulaala gurhe mukengereere oku ebi naliiri naderha biyerekeere emigati? Naliiri nababwira oku muchilange n'echachu y'aBafarisaayo n'aBasadukaayo.»<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />Abigirizwa baja bamenya oku arhaliiri ababwira bachilange n'echachu y'emigati, sy'aliko aliiri ababwira bachilange n'enyigirizo z'aBafarisaayo n'aBasadukaayo.<verse eid="MAT 16:12" /></para>
  <para style="s">Petero aderha oku Yeesu ye Kirisitu</para>
  <para style="r">
    <ref loc="MRK 8:27-30">Mariko 8.27-30</ref>; <ref loc="LUK 9:18-21">Luuka 9.18-21</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Yeesu abeere ahika olunda lw'eKayizariya Firipi, abaza abigirizwa baage ntya: «Gurhe abantu bali baderha oku nyoono Mwene oMuntu ndi nde?» <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />Bamushubiza ntya: «Baguma bali baderha oku wooyo oli Yohaana Mubatiiza, n'abandi bali baderha oku wooyo oli Eliya, n'abandi bali baderha oku wooyo oli Yeremiya changwa muguma w'omu baleebi ba miira.»<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />Yeesu aja ababaza ntya: «Nenyu muli mwaderha oku nyoono ndi nde?»<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />Simooni Petero amushubiza ntya: «Wooyo oli Kirisitu, Mugala wa Nnamahanga Ozeene.» <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />Yeesu ava amubwira ntya: «Simooni mwene Yoona ogishirwe, kwenge nta muntu wakubishuliire ogu mwazi arhali Daarha oli omu mpingu. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Naani nkubwirire okw'oli Petero, kuli kuderha baale. Na ku linoola baale kunayumbaka echigusho ch'abemeezi baani booshi. N'echo chigusho, obuhashe bw'ekuzimu burhakachihima. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Nji naguha efunguulo z'oBwami bw'empingu. Byooshi nji waaba oli walahira omu gulu, Nnamahanga naye nj'aba ali abilahira. Na byooshi nji waaba wayemereere omu gulu, Nnamahanga naye nj'abiyemeera.»<verse eid="MAT 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20" />Oku buzinda, Yeesu abuza abigirizwa baage oku nta muntu babwirage oku yeewe ye Kirisitu.<verse eid="MAT 16:20" /></para>
  <para style="s">Yeesu aderha elugulu w'ogufa n'ogufuuka kwage</para>
  <para style="r">
    <ref loc="MRK 8:31">Mariko 8.31</ref>; <ref loc="MRK 9:1">9.1</ref>; <ref loc="LUK 9:22-27">Luuka 9.22-27</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Gurhengera mw'amo mango, Yeesu arhondera kubwira abigirizwa baage bwinjabwinja okw'akwaneene kuja eYerusaleema. N'eyo munda abashamuka b'aBayaahudi n'abakulu b'abadaahwa n'abigiriza b'eRhegeko bamulibuza bweneene. N'oku buzinda ayirhwa, n'olusiku lwagasharhu afuuka.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Petero ava aheeka Yeesu eburhambi n'ogurhondera kumukalihira ntya: «Nnaweerhu, Nnamahanga akulange! Ebyo birhaguhikira chiro n'ehityu!» <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />Aliko Yeesu ahindamuka n'okumubwira ntya: «Wooyo Shetaani! Rhenga haburambi bwani, oshondere kungeregeza, kwenge enkengeero zaawe zirharhengeere emwa Nnamahanga, sy'aliko ziri z'omuntu.»<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Yeesu ava abwira abigirizwa baage ntya: «Akaba omuntu ashondere kunkulikira, agihakane yenyine, aheeke omusalaaba gwage anankulikire. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Bulaala omuntu oshondere guchungula akalamo kaage nj'agaheza. Aliko olaala wahaana akalamo kaage elugulu waani, nj'ashuba gukabona. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Kali kamaro gachi omuntu kugwarha ebintu byooshi by'egulu aliko aheze akalamo kaage? Na chintu gichi omuntu akagala kandi guhaana y'achungule akalamo kaage?<verse eid="MAT 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 16:27" />«Kwenge nyoono Mwene oMuntu nji nayinja omu bukuuze bwa Daarha haguma na bamalahika baage. Nji nanahemba ngasi muntu gukulikirana n'ebijiro byaage<note caller="+" style="f"><char style="fr" closed="false">16.27 </char><char style="ft" closed="false">Osome Nanga 62.13.</char></note>. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Okuli mbabwirire oku baguma mw'aba bantu bali hano, barhagafa barhanaza kubona gurhe nyoono Mwene oMuntu ndi nayinja nka Mwami.»<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">Yeesu ahindulwa eshusho</para>
  <para style="r">
    <ref loc="MRK 9:2-10">Mariko 9.2-10</ref>; <ref loc="LUK 9:28-36">Luuka 9.28-36</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Enyuma za siku ndarhu, Yeesu arhoola Petero, Yakobo na Yohaana mwene waabo Yakobo. Azamuka haguma nabo oku musozi guleehere, babera ko bonyine. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Babeere bali kw'ogo musozi, Yeesu ahindulwa eshusho embere zaabo. Eshusho lyaage lyabaraganya nka zuuba. N'emyambalo yaage yahinduka mweru nka bulangashane.<verse eid="MAT 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 17:3" />Ho n'aho, abo bigirizwa babona Muusa na Eliya bali baganiira na Yeesu. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Petero ava abwira Yeesu ntya: «Nnaweerhu, kuli kwinja rhubeere hano. Kandi akaba oshondere, nayumbaka biraaro bisharhu hano, chiguma chaawe, echindi cha Muusa n'echindi cha Eliya.»<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Oku Petero achiri aderha, ho n'aho hahulukiira oluhomo lulangasheene lwabashukulira. Mw'olo luhomo mwayunvikana omulenge guli gwaderha ntya: «Oyu, ye Mwana waani muzigirwa, nsimiswa naye. Mumuyunvirize!» <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />Abo bigirizwa babeere bayunva ogo mulenge, bayuubaha bweneene, bakumbagala, amalanga mahika ahashi. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Aliko Yeesu abayegeera, abahuma ko anababwira ntya: «Muyimange, murhanayuubahaga!» <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Babeere bayinamula ameesho, barhabonaga owindi muntu arhali Yeesu yenyine.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Yeesu n'abigirizwa baage babeere bali bayandagala kw'ogo musozi, abarhegeka ntya: «Ebi mwabwene ko, ntaaye mubibwirage guhika amango nyoono Mwene oMuntu nji nafuuka.»<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Abo bigirizwa baamubaza ntya: «Girhuma abigiriza b'amarhegeko banaderha oku bihemere Eliya arhange ayinje?» <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />Yeesu abashubiza ntya: «Kubinali, bihemere Eliya arhange ayinje kubahugulira ebintu byooshi. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Aliko leero, mbabwirire oku Eliya ahikire miira, sy'aliko abantu barhamurhegeeraga. Banamujirira nk'oku balishondere. Ko n'oko, ku naani Mwene oMuntu, nji bandibuuza.» <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Ho n'aho abo bigirizwa baage, baja bamenya oku Yeesu aliiri abashambalira elugulu wa Yohaana Mubatiiza.<verse eid="MAT 17:13" /></para>
  <para style="s">Yeesu afumya omuzaana walilwere egichuli</para>
  <para style="r">
    <ref loc="MRK 9:14-29">Mariko 9.14-29</ref>; <ref loc="LUK 9:37-43">Luuka 9.37-43</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Yeesu n'abigirizwa baage bagendekera n'olugenzi, banahika ah'echigusho ch'abantu chaliiri. Muntu muguma ayegeera hoofu na Yeesu, afukama embere zaage. <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />Anamubwira ntya: «Nnaweerhu! Oyunvire mugala waani obonjo, kwenge ajira endwala y'egichuli. Obo bulwala bwamulibwize bweneene. Ngasi mango anakumbagala omu muliro n'omu menji. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Nalimulerheere abigirizwa baawe, aliko barhagalire kumufumya.»<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Yeesu abwira abigirizwa baage ntya: «Mwe bantu b'echi gisisi muli babi, murhanagwerhe chiro n'obwemeezi! Nagendekera kubeera nenyu n'okulema nayunviriza ebinwa byenyu guhika mango machi? Munderhere oyo mwana hano!»<verse eid="MAT 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 17:18" />Yeesu akalihira oyo muzimu waliiri m'oyo mwana, n'okuva amurhenga mo. Ho n'aho oyo mwana afuma.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Abigirizwa ba Yeesu baja bamuyegeera ey'ali yenyine n'okumubaza ntya: «Waliha! Gichi charhumaga rhwabo rhwafundwa gukuula oyu muzimu?» <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" />Yeesu abashubiza ntya: «Kwenge obwemeezi bwenyu buli bugeeke. Okuli mbabwirire, chiro nk'obwemeezi bwenyu bwakaba bugeeke nka hiburho higeeke hye haradaali, mwakagala kubwira ogu musozi ntya: ‹Rhenga hano oje haliira› Nago gwanaja ho. Kandi, harhakanaba echintu girhakagalika emwenyu. [<verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />Aliko omuzimu oli ntya arhakakuulwa nk'arhali omu gusaliira n'oguchibuza kulya ebiryo.»]<verse eid="MAT 17:21" /></para>
  <para style="s">Yeesu ashuba kubala elugulu w'ogufa n'ogufuuka kwage</para>
  <para style="r">
    <ref loc="MRK 9:30-32">Mariko 9.30-32</ref>; <ref loc="LUK 9:43-45">Luuka 9.43-45</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Lusiku luguma, amango abigirizwa ba Yeesu baliiri bachigushire omu gihugo ch'eGalilaaya, Yeesu ababwira ntya: «Nyoono Mwene oMuntu nahirwa omu fune z'abantu. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />Nabo bantu nji banyirha, aliko olusiku lwagasharhu, nji nafuuka gurhenga omu bafu.» Abigirizwa baage babeere bayunva ntyo, bababala bweneene.<verse eid="MAT 17:23" /></para>
  <para style="s">Yeesu na Petero bafurha ekooli ly'eNju ya Nnamahanga</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Enyuma z'ebyo, Yeesu n'abigirizwa baage baaja omu gishagala ch'eGaperanahumu. Bahikire mo, abafurhiisa b'amakooli m'eNju ya Nnamahanga bayegeera Petero n'okumubaza ntya: «K'omwigiriza wenyu arhafurha ekooli ly'eNju ya Nnamahanga?» <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />Petero abashubiza ntya: «Neechi analifurha.» Petero abeere aja omu nju, oku arhaza kuderha chintu, Yeesu amubaza ntya: «Simooni, bichi okengereere? Abaami ba lino gulu bafurhiisa amakooli oku bande, ka banafurhisa abaana b'egihugo changwa abahiisi?» <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />Petero amushubiza ntya: «Banafurhisa abahisi bonyine.»</para>
  <para style="p" vid="MAT 17:26">Yeesu aja amubwira ntya: «Abaana b'egihugo barhakwaneene gufurha ekooli. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Aliko, nachiro ntyo, rhurhashondere kugayisa aba bantu. Cho girhumire, oje ebwa nyanja kuloba. N'efi y'oburhanzi wagwarha, oyibumbuule obuunu, wabona mo egicheri ch'efuranga. Echo gicheri, obahe cho omu gufurha ekooli lyaawe n'elyaani.»<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Nde ye mukulu omu Bwami bw'empingu</para>
  <para style="r">
    <ref loc="MRK 9:33-37">Mariko 9.33-37</ref>; <ref loc="LUK 9:46-48">Luuka 9.46-48</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Mw'ebyoola bishanji, abigirizwa ba Yeesu bamuhikira n'okumubaza ntya: «Nde oli mukulu kulusha abaabo omu Bwami bw'empingu?»<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />Yeesu ahamagala omwana mudoorho, amuhira ahagarhi kaabo. <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />Aderha ntya: «Okuli, mbabwirire oku akaba murhahindamwire oboorhere bwenyu n'okuba nk'abaana badoorho, murhakaja omu Bwami bw'empingu. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Leero, ngasi yeeshi ogirhonda nk'oyu mwana mudoorho, oyo ye nji waaba mukulu omu Bwami bw'empingu. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />N'olaala oyankirire omwana mudoorho nk'oyuula oku ziino lyaani, eyi nyoono nyayankirire.»<verse eid="MAT 18:5" /></para>
  <para style="s">Oguchilanga oku mabi</para>
  <para style="r">
    <ref loc="MRK 9:42-48">Mariko 9.42-48</ref>; <ref loc="LUK 17:1-2">Luuka 17.1-2</ref></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />«Mwaba baana badoorho banyemereere, nk'omuntu mulebe abeere mpanvu yogurhuma muguma omu bo ajira echaaha, kwakabeere kwinja kw'oyo muntu gushwekerwa olushyo omu gosi, anakabulwe omu nyanja. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />Buhanya oku gulu, elugulu w'ebintu biyunjwire mo by'okuyoohya abantu bajire ebyaaha! Ebyo bintu bikwaneene kuba ho, aliko buhanya oku muntu bihulukire ko!<verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />«Nk'efune yaawe changwa okugulu kwawe byagarhuma wajira echaaha, obiche onabikabule hale naawe. Kwenge kuli kwinja oku wooyo, oje ahantu h'akalamo k'okuli, ey'ogwerhe kuboko kuguma changwa kugulu kuguma. Kuli kwinja ahali h'okuba n'amaboko mombi changwa amagulu mombi, n'ogukabulwa omu muliro gw'esiku n'amango. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Kandi, nk'eliisho lyaawe lirhumire wajira echaaha, oliyoomole onalikabule hale naawe. Kwenge kuli kwinja oku wooyo, oje ahantu h'akalamo k'okuli, ey'ogwerhe liisho liguma, ahali h'okugwarha ameesho mombi, onakabulwe omu muliro gw'esiku n'amango.»<verse eid="MAT 18:9" /></para>
  <para style="s">Omugani gw'entaama yaherere</para>
  <para style="r">
    <ref loc="LUK 15:3-7">Luuka 15.3-7</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />«Muchilange! Murhalemaga mwabonerera chiro n'omuguma mw'aba baana badoorho, kwenge mbabwirire oku bamalahika baabo barhuula bali esiku zooshi embere za Daarha oli omu mpingu. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />[Kwenge nyoono Mwene oMuntu nayinjaga kunoola gulu yi nchungule balaala baliiri baherere.]<verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />«Bichi mukengereere? Nk'omuntu agwerhe ntaama zaage egana, na nguma omu zo egahera, k'arhaleka zila zindi makumi gali mwenda na mwenda oku musozi y'aje gushonda ela yaherere? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Okuli mbabwirire, nk'ayibwene, ayimogera bwenene kulusha zila zindi makumi gali mwenda na mwenda zirhaliherere. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Ko n'oko, Yisho oli empingu, naye arhashonda chiro n'omuguma mw'aba baana badoorho ahere.»<verse eid="MAT 18:14" /></para>
  <para style="s">Oguhanuula mwene wenyu wajirire amabi</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />«Nka mwene wenyu akujirire kubi, oje emunda ali kumuyeereka obubi bwage eyi muli mwembi mwenyine. Na nk'akuyunviirhe, mwanashuba kuba omu buguma. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Aliko nk'alahire gukuyunva, orhoole muntu muguma changwa babiri, onaje kumulola haguma nabo, yi ngasi chinwa chimenyikane bwinja oku buhamiiriza bwa bantu babiri changwa basharhu.<note caller="+" style="f"><char style="fr" closed="false">18.16 </char><char style="ft" closed="false">Osome Rhegeko 19.15.</char></note> <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Nk'alahire kuyunva abo bantu nabo, omenyese echigusho ch'abemeezi ogo mwazi. Na nk'alahire kubayunva nabo, omurhoole nka muntu orhenji Nnamahanga changwa nk'omufurhiisa w'amakooli.<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />«Okuli, mbabwirire oku byooshi mwalema mwashweka muno gulu, byalema byashwekwa n'omu mpingu, na byooshi mwalema mwashwekuula muno gulu, byalema byashwekuulwa n'omu mpingu.<verse eid="MAT 18:18" /></para>
  <para style="s">Ogusaliira haguma</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />«Okuli, nshubire kubabwira oku muno gulu, nka bantu babiri mu mwabo bayunvikeene omu guhema chintu chilebe, Daarha oli omu mpingu abaha cho. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Kwenge ahantu bantu babiri changwa basharhu bachigushire oku ziino lyaani, naani ndi ahagarhi kaabo.»<verse eid="MAT 18:20" /></para>
  <para style="s">Omugani gw'omukozi walahire kubabalira owaabo</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Enyuma z'ebyo, Petero ayegeera Yeesu n'okumubaza ntya: «Nnaweerhu, nka mwene weerhu ali anjirira amabi, kanga nkwaneene kumubabalira? Ka guhika ku kali mushanvu?» <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" />Yeesu amushubiza ntya: «Nangwa! Ntakubwirire ok'omubabalire kali mushanvu konyine, sy'aliko guhika kali makumi gali mushanvu kali mushanvu.<verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />«Cho girhumire, oBwami bw'empingu bushushanyizwe n'omwami muguma walishondere kumenya oluganjo lw'eminda abakozi baage balikwaneene kumujuha. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Abeere arhondera kujira olo luganjo, bamulerhera mukozi muguma waligwerhe omwinda gwage munene gw'etalanta<note caller="+" style="f"><char style="fr" closed="false">18.24 </char><char style="ft" closed="false">eTalanta zaliiri furanga aBayaahudi baliiri bakoleesa. Talanta nguma yaligwerhe akamaro k'enka erhaano.</char></note> bihumbi ekumi. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Okubona okw'oyo mukozi arhaligwerhe obuhashe bw'okujuha ogo mwinda, nnahamwabo aja arhegeka oku bamuguze, baguze na mukaage, n'abaana baage n'ebintu byooshi aligwerhe, y'ajuhe ogo mwinda. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />Oyo mukozi afukama embere za nnahamwabo n'okumuyinginga ntya: ‹Waliha, nguhemere orhange olinge, nakujuha omwinda gwawe gooshi.› <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Oyo nnahamwabo abeera oyo mukozi obonjo, amubabalira ogo omwinda, ava amuleka agende.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />«Oyo mukozi abeere agenda, abugaana owabo mukozi muguma waligwerhe omwinda gwage gwa bicheri egana by'efuranga. Amufarhira omu gosi n'okumuniguuza. Amubwira ntya: ‹Juha omwinda gwani juba!› <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />Oyo waabo mukozi afukama embere zaage, n'okumuyinginga ntya: ‹Maani, nguhemere orhange olinge! Nakujuha omwinda gwawe!› <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />Aliko alahira, anaja kumuhiriisa omu munyororo guhika amango nj'ajuha omwinda gwage.<verse eid="MAT 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 18:31" />«Abaabo bakozi babeere babona amujirire ntyo, bagaya bweneene. Baaja kubalira ola nnahamwabo byooshi byabeere. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Nnahamwabo aja ahamagaza oyo mukozi, amubwira ntya: ‹Wooyo oli mukozi mubi! Nyoono nalikubabaliire omwinda gwawe gooshi, bulaala walimpemere obonjo! <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Leero wooyo, bulaala gurhe orhababalire owenyu mukozi nka kulaala naani nakubabaliraga?› <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Oyo nnahamwabo agwarha oburhe bunene. Ava aderha oku oyo mukozi akabulwe omu munyororo y'ahanwe, guhika amango ajuha omwinda gwage gooshi.»<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />Oku buzinda, Yeesu aderha ntya: «Nenyu, ntyo ko n'oko Daarha oli empingu nj'abajirira, akaba ngasi muguma wenyu arhalema ababalira abaabo n'omurhima gwage gooshi.»<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Yeesu ayigiriza elugulu w'okuyegula omukazi</para>
  <para style="r">
    <ref loc="MRK 10:1-12">Mariko 10.1-12</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Yeesu abeere amala kuderha eyo myaazi, arhenga omu gihugo ch'eGalilaaya. Aja omu gihugo ch'eYudeeya, oku lwindi lunda l'olwinji lw'eYorodaani. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Bantu banene bweneene bamukulikira eyo munda, n'abaliiri balwala, abafumya.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />
    <char style="w" lemma="Bafarisaayo:">aBafarisaayo</char> baguma bamuyegeera yi bamugeregeze. Baamubaza ntya: «K'eRhegeko lyeerhu liyemereere omulume kuyegula mukaage ku ngasi chibazo?»<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />Yeesu abashubiza ntya: «Ka murhasaga gusoma okw'aMandiko Matagatiifu maderhere ntya: ‹Oku murhondero, Nnamahanga alemaga omulume n'omukazi?›<note caller="+" style="f"><char style="fr" closed="false">19.4 </char><char style="ft" closed="false">Osome Murhondero 1.27.</char></note> <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />Anashuba kuderha ntya: ‹Cho girhumire omulume aleka eshe na nyina, anabeera na mukaage, na bombi banaba mubiri muguma.›<note caller="+" style="f"><char style="fr" closed="false">19.5 </char><char style="ft" closed="false">Osome Murhondero 2.24.</char></note> <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Leero, barhachiba babiri, sy'aliko bamaaba muntu muguma. Cho girhumire, echi Nnamahanga ashwekere, harhabaga chiro n'omuntu wagishwekuula.»<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Abo Bafarisaayo, baashuba kumubaza ntya: «Charhumaga leero Muusa arhegeka oku omulume aleme aha mukaage amaruba m'okulekana egihe ashondere kumuyegula?» <verse eid="MAT 19:7" /><verse number="8" style="v" sid="MAT 19:8" />Yeesu abashubiza ntya: «Muusa abayemeereraga oku muleme mwayegula bakenyu, elugulu w'emirhima yenyu mizibu. Aliko gurhenga oku murhondero, birhaliiri ntyo. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Leero nyoono mbabwirire oku, nk'omuntu alekeene na mukaage, nka burhali buhushi bonyine burhumire, n'ogushuba gushaba owindi, oyo muntu amenye oku ajirire obuhushi.»<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />
    <char style="w" lemma="Mwigirizwa:">Abigirizwa</char> ba Yeesu baaja bamubwira ntya: «Akaba buhushi bonyine bo bwagarhuma omulume alekana na mukaage, gasi ogushaba gurhagwerhe akamaro!» <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" />Yeesu abashubiza ntya: «Abantu booshi barhakagala kuyemeera echi chinwa, barhali balaala bonyine Nnamahanga aheere obuhashe. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Kwenge hali abantu baguma barhagala gushaba, bulaala baburhwaga eyi bali ntazi, abandi bajirirwe ntazi n'abantu, abandi bachijirire bonyine ntazi elugulu w'ogukolera oBwami bwa Nnamahanga. Leero, ola wakagala kuyemeera eyi myaazi, ayiyemeere!»<verse eid="MAT 19:12" /></para>
  <para style="s">Yeesu agisha abaana</para>
  <para style="r">
    <ref loc="MRK 10:13-16">Mariko 10.13-16</ref>; <ref loc="LUK 18:15-17">Luuka 18.15-17</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Abantu baguma baja baleerhera Yeesu abaana, y'abalambulire kw'efune omu kubasalirira. Aliko abigirizwa baage bakalihira abo bantu. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Yeesu aja abwira abo bigirizwa baage ntya: «Muleke abaana bayinje emwani, murhalemaga mwababuza, bulaala abantu bali nk'aba baana bo banyina oBwami bw'empingu.»<verse eid="MAT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 19:15" />Yeesu agisha abo baana omu kubahira kw'efune. Oku buzinda arhenga ahoola.<verse eid="MAT 19:15" /></para>
  <para style="s">Yeesu n'omuchire</para>
  <para style="r">
    <ref loc="MRK 10:17-31">Mariko 10.17-31</ref>; <ref loc="LUK 18:18-30">Luuka 18.18-30</ref>; <ref loc="LUK 13:30">13.30</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Enyuma z'ebyo, muntu muguma ayegeera Yeesu, amubaza ntya: «Mwigiriza, menja machi nkwaneene kujira yi mbone akalamo k'esiku n'amango?» <verse eid="MAT 19:16" /><verse number="17" style="v" sid="MAT 19:17" />Yeesu amushubiza ntya: «Girhumire wambaza elugulu wa menja? Hali muguma yenyine onaba mwinja! Leero, akaba oshondere kuja omu kalamo k'okuli, oleme wakenga amarhegeko ma Nnamahanga.» <verse eid="MAT 19:17" /><verse number="18" style="v" sid="MAT 19:18" />Oyo muntu ashuba kumubaza ntya: «Marhegeko mahe?»</para>
  <para style="p" vid="MAT 19:18">Yeesu amushubiza ntya: «Orhalemaga wayirha, orhalemaga wahusha, orhalemaga wazimba, orhalemaga wahamiriza obubeeshi, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />oleme wakenga yisho na nyoko, onaleme wasiima abandi nk'oku ogisiima wenyine.»<note caller="+" style="f"><char style="fr" closed="false">19.19 </char><char style="ft" closed="false">Osome Lubunguluko 20.12-16; Balaawi 19.18.</char></note><verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />Oyo muntu amubwira ntya: «Ama marhegeko mooshi, gurhenga miira, nanjira nk'oku maderhere. Bichi kandi nkwaneene kujira?»<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Yeesu ashuba kumubwira ntya: «Akaba oshondere kuba muntu okwaneene, ogende, oguze ebintu byaawe byooshi, n' efuranga wabona, ozigabire abakene. Ntyo, waaba wachibikire obuchire empingu. Oku buzinda, ogaluke onkulikire.»<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />Aliko, oyo muntu abeere ayunva ntyo, achigendera ey'agayire bweneene, bulaala aligwerhe obuchire bunene.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Yeesu aja abwira abigirizwa baage ntya: «Okuli mbabwirire oku bikomeere omuchire kuja omu Bwami bw'empingu! <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Mbabwirire kandi oku biyoloheere bweneene engamiya kugera omu hirhule hy'esindani, ahaali h'omuchire kuja omu Bwami bwa Nnamahanga.»<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Abigirizwa baage babeere bayunva ebyo binwa, basoomerwa bweneene. Baabaza ntya: «Nde leero wagachungulwa?»<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Yeesu abaloleereza n'okubabwira ntya: «Ogu mwazi gurhakagalika oku bantu, aliko byooshi byakagalika emwa Nnamahanga.»<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Petero aja amubwira ntya: «Tala! Rhwabo rhwalekere byooshi rhwanagukulikira. Leero bichi nji rhwabona?» <verse eid="MAT 19:27" /><verse number="28" style="v" sid="MAT 19:28" />Yeesu ababwira ntya: «Okuli mbabwirire oku, omu gulu lihyaahya, nyoono Mwene oMuntu nji nayikala oku ntebe yaani y'obukuuze. Nenyu ekumi na babiri, mwankulikiire, nji mwayikala oku ntebe ekumi n'ebiri z'echami, omu gucha eshinja z'amooko ekumi na mabiri m'eIsraheeli.<verse eid="MAT 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 19:29" />«Na ngasi muntu walekere enju yaage, beene baabo n'abaali baabo, eshe na nyina, abaana changwa amashwa, elugulu waani, ayankirira kulusha kali egana. N'oku buzinda, nj'ahaabwa akalamo k'esiku n'amango. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Aliko bantu banene bali b'oburhanzi nji baaba bazinda, na banene bali b'obuzinda, nji baaba b'oburhanzi.»<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">Omugani gw'abakozi omu shwa ly'emizabiibu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />Yeesu ashuba kuderha ntya: «Obwime bw'empingu bushusheene na nyina eshwa ly'emizabiibu wagendaga eseezi kuja gushonda abakozi b'ogukola omu shwa lyaage. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Ayunviikana n'abakozi guha ngasi muguma egicheri<note caller="+" style="f"><char style="fr" closed="false">20.2 </char><char style="ft" closed="false">edinaari zaliiri furanga. Dinaari nguma gwali mukamarho omuntu agahabirwe oku muzizi muguma.</char></note> ch'edinaari oku muzizi. Oku buzinda abarhuma omu shwa lyaage.<verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />«Zabeere zaaba hoofu saa esharhu z'eseezi, ahuluka kandi. Abona abandi bantu omu mbuga barhagwerhe kaasi. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Ababwira ntya: ‹Nenyu, muje gukola omu shwa lyaani ly'emizabiibu. Nabakamasya nk'oku bihemere.› <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Nabo baaja ebwa shwa.</para>
  <para style="p" vid="MAT 20:5">«Zabeere zaaba saa ndarhu z'ezuuba, ashuba guhuluka n'ogurhuma abandi bantu omu shwa lyaage. Zabeere zaaba saa mwenda z'egolo, ashuba kujira ntyo.<verse eid="MAT 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 20:6" />«Zabeere zaaba hoofu saa kumi na nguma z'egolo, ashuba guhuluka n'ogushuba kubona abandi bantu bali omoola mbuga. Ababaza ntya: ‹Girhumire muyimangire hanoola ezuuba lyooshi buzira gukola?› <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />Nabo bamushubiza ntya: ‹Bulaala ntaaye warhuheere akaasi.› Aj'ababwira ntya: ‹Nenyu muje gukola omu shwa lyaani.›<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />«Lyabeere golo, ola nyina eshwa abwira omwimangizi w'akaasi kaage ntya: ‹Hamagala abakozi, onabahe omukamarho gwabo. Aliko, omu kubakamasya, orhonderere oku bala bakozi bayinjaga buzinda, onayuusize oku bala bayinjaga oburhanzi.› <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Bala bakozi bajaaga omu shwa hoofu saa kumi na nguma z'egolo, bahika. Ngasi muguma akamarha gicheri chiguma ch'edinaari.<verse eid="MAT 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 20:10" />«Na Balaala barhonderaga akaasi eseezi, nabo bahika. Bakengeera oku boowe bakamarha chigabi chinene kulusha. Aliko nabo bakamarha ngasi muguma gicheri chiguma ch'edinaari.<verse eid="MAT 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 20:11" />«Abo bakozi babeere bakamarha cho, balundumira nyina eshwa. <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />Baderha ntya: ‹Aba bakozi bayinjaga buzinda, bakolere akaasi ka saa nguma yonyine. Gurhe wakagala kubakamasya kuguma neerhu, noobo rhwabo rhwaluhire n'ogukola olusiku looshi omu zuuba likalihire!› <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />Aliko nyina eshwa ashubiza muguma wabo ntya: ‹Ego mwira waani, ntagukangire. Ka rhurhaali rhuyunvikeene oku wakolera gicheri chiguma ch'edinaari oku muzizi? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Jaaga warhoola omukamarho gwawe, onagende. Byali nsimiisize nyenyine guha omukozi w'obuzinda omukamarho gungana n'ogwawe. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Wooyo okengerere oku ntagwerhe obuhashe b'ogukolesa ebikulo byaani nk'oku nshondere? Changwa ogwerhe obongwa bulaala nyoono ndi muntu mwinja?›»<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />Yeesu ashuba kuderha ntya: «Ntya kubiri, abali bazinda nji baaba barhanzi. N'abali barhanzi nji baaba bazinda.»<verse eid="MAT 20:16" /></para>
  <para style="s">Yeesu aderha obwa gasharhu elugulu w'ogufa n'ogufuuka kwage</para>
  <para style="r">
    <ref loc="MRK 10:32-34">Mariko 10.32-34</ref>; <ref loc="LUK 18:31-34">Luuka 18.31-34</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Lusiku luguma, Yeesu aliiri omu njira ezamukire omu gishagala ch'eYerusaleema. Arhoola entumwa zaage ekumi n'ebiri, aziheka eburhambi. Azibwira ntya: <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />«Muyunve! Rhwabano rhwazamuukira omu gishagala ch'eYerusaleema. Na mw'echo gishagala, nyoono Mwene oMuntu nahirwa omu maboko m'abakulu b'abadaahwa n'abigiriza b'eRhegeko. Abo bantu, bampana yi nyirhwe. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />Banampira omu maboko m'abantu barhali Bayaahudi, nabo banshinyagulira, n'onkushuurha bwenene. N'oku buzinda bambamba oku musalaaba. Aliko oku lusiku lwagasharhu nji nafuuka.»<verse eid="MAT 20:19" /></para>
  <para style="s">Muka Zebedayo ahemera abagala obukulu</para>
  <para style="r">
    <ref loc="MRK 10:35-41">Mariko 10.35-41</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Enyuma w'ebyoola, muka Zebedayo n'abagala bayegeera Yeesu. Oyo mukazi afukama embere zaage omu kumuhema chintu chiguma. <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />Yeesu amubaza ntya: «Bichi oshondere?» Naye amushubiza ntya: «Amango waaba omu Bwami bwawe, orhegeke oku aba baana baani bombi bo bayikalage aha burhambi bwawe. Muguma ekulyo kwawe n'owindi ekulembe kwawe.»<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />Yeesu abashubiza ntya: «Murhamenyere echi muli mwahema. Ka mwakagala kunywa oku ngumbu y'amalibuko nanywa?» Bamushubiza ntya: «Rhwakagala.»<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Yeesu aj'ababwira ntya: «Okuli, eyo ngumbu y'amalibuko, nji mwanayinywa ko. Aliko okuyikaza omuntu ekulyo kwani changwa ekulembe kwani, ebyo birhandolere. Aba nji bayikala ho, Daarha yenyine nj'ahira ho abantu arheganyize.»<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Bala bandi bigirizwa ekumi babeere bayunva eyo myaazi, bagaya bwenene elugulu wa bala baana babiri ba Zebedayo.<verse eid="MAT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 20:25" />Yeesu aja ahamagala abigirizwa baage booshi haguma, n'okubabwira ntya: «Muyinji oku omu bantu barhali Bayaahudi, abaami baabo banarhambula n'erume. N'abakulu baabo banabalibuza. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Aliko, birhalemaga byaba ntyo ahagarhi kenyu. Ahuubwe, oshondere kuba mukulu mu mwabo, abe mukozi wenyu. <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />Kandi, oshondere kuba w'oburhanzi mu mwabo, abe muja wenyu. <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />Kwenge nyoono Mwene oMuntu ntayinjaga mpu baleme bankolera, aliko nayinjire yi ndeme nakolera abandi, n'oguhaana akalamo kaani yi nchungule bantu banene.»<verse eid="MAT 20:28" /></para>
  <para style="s">Yeesu afumya empumi ebiri</para>
  <para style="r">
    <ref loc="MRK 10:46-52">Mariko 10.46-52</ref>; <ref loc="LUK 18:35-43">Luuka 18.35-43</ref>; <ref loc="MAT 9:27-31">Matayo 9.27-31</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Yeesu n'abigirizwa baage, babeere bali barhenga eYeeriko, bantu banene bweneene bamukulikira.<verse eid="MAT 20:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 20:30" />Haliiri mpumi ebiri zaliiri ziyikeere eburhambi bw'enjira. Ezoola mpumi zabeere zayunva oku Yeesu yeri wagera, zayaama ntya: «Nnaweerhu, Mwene Daawudi! Orhubeere obonjo!»<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Echigusho ch'abantu chabeere chayunva ntyo, chazikalihira n'okuzibwira oku zisire. Aliko ezoola mpumi zoowe, zagendekera kuyaama bweneene ntya: «Nnaweerhu, Mwene Daawudi! Orhubeere obonjo!»<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Yeesu ayimanga, azihamagala n'okuzibaza ntya: «Gichi mushondere mbajirirage?» <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />Nazo zamushubiza ntya: «Nnaweerhu, rhwashonda ameesho meerhu mahumuulwe.» <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />Yeesu azibeera obonjo, azihuma oku meesho, ho n'aho ameesho maazo mabona. Nazo zaja zamukulikira.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">Yeesu aja omu gishagala ch'eYerusaleema</para>
  <para style="r">
    <ref loc="MRK 11:1-11">Mariko 11.1-11</ref>; <ref loc="LUK 19:28-40">Luuka 19.28-40</ref>; <ref loc="JHN 12:12-19">Yohaana 12.12-19</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Yeesu n'abigirizwa baage babeere bali hoofu n'egishagala ch'eYerusaleema, bahika omu gishagala ch'eBetefaage, hoofu n'omusozi gw'eMizeyituuni. Yeesu arhuma bigirizwa baage babiri, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />ababwira ntya: «Muje omu gishagala chiri embere zenyu. Hano muchigera mo, mwashimaana epunda n'omwana gwayo, bazishwekere haguma. Ezo punda, muzishwekuule, munazinderhere. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Nakaba muntu mulebe ababazize chintu elugulu w'ezo punda, mumushubize oku Nnaweerhu azilagire ko. Ho n'aho, oyo muntu aja abaleka muziheke.»<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Ebyo byaabaga ntyo, y'echo chinwa chiyenera, echi Nnawerhu aderhaga kugerera omuleebi ntya:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />«Mubwire aBanyasayuuni ntya:</para>
  <para style="q1" vid="MAT 21:5">‹Mulole! Mwami wenyu ayinjire emwenyu,</para>
  <para style="q1" vid="MAT 21:5">ali mwirhonzi, ayikeere oku punda</para>
  <para style="q1" vid="MAT 21:5">n'eyo punda echiri chaana.›»<note caller="+" style="f"><char style="fr" closed="false">21.5 </char><char style="ft" closed="false">Osome Zakariya 9.9.</char></note><verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Abo bigirizwa bagenda, bajira nk'oku Yeesu abarhegekaga. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Baleerha eyo punda n'echaana chaayo. Baasasa oku zo emyambalo yaabo, Yeesu aja ayikala oku yo. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Chigusho chinene ch'abantu baasasa emyambalo yaabo omu njira, abandi bacha emirhabi y'emirhi, banayisasa omu njira. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Bantu banene baliiri balambagira embere zaage n'abaliiri balambagira enyuma zaage, booshi baliiri baderha n'omulenge munene ntya:</para>
  <para style="q1" vid="MAT 21:9">«Akuuzwe Mwene Daawudi!</para>
  <para style="q1" vid="MAT 21:9">Agishwe ola oyinjire oku ziino lya Nnaweerhu!</para>
  <para style="q1" vid="MAT 21:9">Akuuzwe Nnamahanga oli omu mpingu!»<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Yeesu abeere aja omu gishagala ch'eYerusaleema, echo gishagala chooshi chabumba olwamo lunene. Abantu barhondera kubazana ntya: «Oyu ali nde?»<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Echo chigusho ch'abantu chashubiza ntya: «Oyuula ali Yeesu, muleebi w'omu gishagala ch'eNazareeti, omu gihugo ch'eGalilaaya.»<verse eid="MAT 21:11" /></para>
  <para style="s">Yeesu alibisya abarhimbuuzi omu Nju ya Nnamahanga</para>
  <para style="r">
    <ref loc="MRK 11:15-17">Mariko 11.15-17</ref>; <ref loc="LUK 19:45-46">Luuka 19.45-46</ref>; <ref loc="JHN 2:13-17">Yohaana 2.13-17</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Enyuma z'aho, Yeesu aja omu Nju ya Nnamahanga. Alibisya abantu booshi baliiri baguziza n'abaliiri bagulira omu Nju ya Nnamahanga. Ahenya ameeza m'abaliiri bakaaba efuranga, anahenya ebichumbi by'abantu baliiri baguza amaguuku. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Yeesu aja ababwira ntya: «Biyandikirwe omu Mandiko Matagatiifu ntya:</para>
  <para style="q1" vid="MAT 21:13">‹eNju yaani nji yaaba Nju y'amasaala.›</para>
  <para style="q1" vid="MAT 21:13">Aliko mwabo mwayihindamwire kuba hantu h'ebishumuusi!»<note caller="+" style="f"><char style="fr" closed="false">21.13 </char><char style="ft" closed="false">Osome Yeremiya 7.11; Isaaya 56.7.</char></note><verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Empumi n'ebirema bahikira Yeesu mw'eyo Nju ya Nnamahanga. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Aliko abakulu b'abadaahwa n'abigiriza b'eRhegeko lya Muusa babeere babona ebisomereene Yeesu ajiraga, n'okuyunva okw'abaana bali baderha n'omulenge munene omu Nju ya Nnamahanga ntya: «Akuuzwe Mwene Daawudi!», bagaya bwenene. <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Echo charhuma babaza Yeesu ntya: «K'oyunvirhe ebinwa aba baana bali baderha?»</para>
  <para style="p" vid="MAT 21:16">Naye abashubiza ntya: «Neechi! Nayunvirhe! Leero mwabo murhashubiraga gusoma oku Mandiko Matagatiifu maderhere ntya:</para>
  <para style="q1" vid="MAT 21:16">‹Kulengera obuunu bw'abaana badoorho, n'obuunu bw'enjolyaana,</para>
  <para style="q1" vid="MAT 21:16">walema wabala obukuuze bwawe!›<note caller="+" style="f"><char style="fr" closed="false">21.16 </char><char style="ft" closed="false">Osome Nanga 8.2.</char></note>»<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Oku buzinda, Yeesu aleka abo bantu, arhenga mw'echo gishagala ch'eYerusaleema, anaja kulyaama omu gishagala ch'eBetaniya.<verse eid="MAT 21:17" /></para>
  <para style="s">Yeesu avuma omurhi gw'etiini</para>
  <para style="r">
    <ref loc="MRK 11:12-14">Mariko 11.12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Bw'abeere bwacha eseezi, oku Yeesu ali agaluka omu gishagala ch'eYerusaleema, ayunva enzara. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Abona omurhi muguma gw'etiini eburhambi bw'enjira, ayegeera hoofu nago. Aliko arhabonaga ko chiro n'elehe liguma, si ebibabi byonyine. Echo charhuma Yeesu aja avuma ogo murhi ntya: «Gurhondera buno, guhika esiku n'amango, orhahiira okayaana chiro n'elehe!» Ho n'aho ogo murhi gwayuuma.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Abigirizwa ba Yeesu babeere babona ebyoola, basoomerwa bwenene. Baamubaza ntya: «Gurhe ogu murhi gw'etiini gwamayuuma ntya juba?»<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />Yeesu abashubiza ntya: «Okuli mbabwirire oku akaba mugwerhe obwemeezi buzira kuganganwa, mwakagala kujira ebiila najiriire ogu mutiini. Nji mwanagala kubwira ogu musozi ntya: ‹Chikundula ahoola, onaje guchikabula omu nyanja›, n'ebyoola nji byaaba. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />N'akaba mugwerhe obwemeezi, chooshi mwahema Nnamahanga, abaha cho.»<verse eid="MAT 21:22" /></para>
  <para style="s">Ngahe obuhashe bwa Yeesu burhengere?</para>
  <para style="r">
    <ref loc="MRK 11:27-33">Mariko 11.27-33</ref>; <ref loc="LUK 20:1-8">Luuka 20.1-8</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Enyuma z'aho, Yeesu ashuba kuja omu Nju ya Nnamahanga n'ogurhondera kuyigiriza abantu. Abakulu b'abadaahwa n'abashamuka b'aBayaahudi bamuyegeera n'okumubaza ntya: «Ebi bintu oli wajira, oli wabijira oku buhashe buhe? Na nde waguhaaga bo?» <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />Yeesu abashubiza ntya: «Naani, nababaza echibazo chiguma chonyine. Mukanshubiza, naani nababwira oku buhashe bwa nde, ndi najira ebiila. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Obuhashe Yohaana aliiri abatiiza mo abantu, ngahe bwarhengeraga? Mumbwire, akonva bwarhengeraga emwa Nnamahanga changwa emw'abantu!»</para>
  <para style="p" vid="MAT 21:25">Baja mahwe, banabwirana ntya: «Rhugashubiza oku bwarhengeraga empingu, arhubaza ntya: ‹Leero gichi charhumaga murhamuyemeera?› <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Na rhukamushubiza oku bwarhengeraga emw'abantu, rhuyuubahire echi chigusho ch'abantu, kwenge booshi bayinji oku Yohaana aliiri muleebi.»<verse eid="MAT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27" />Elugulu w'echoola, bamushubiza ntya: «Rhurhenji!» Yeesu naye ababwira ntya: «Naani ntababwira oku buhashe buhe ndi najira ebi bintu.»<verse eid="MAT 21:27" /></para>
  <para style="s">Omugani gw'abaana babiri</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />Yeesu ashuba kuderha ntya: «Gurhe mubwene elugulu w'ogu mwazi? Haliiri mulume muguma waligwerhe baana baage babiri. Oyo mulume abwira omwana waage murhanzi ntya: ‹Ego mwana waani, zeene oje gushiiba wakola omu shwa lyeerhu ly'emizabiibu.›» <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />Oyo mwana ashubiza ntya: «Nangwa, ntaaja yo!» Aliko enyuma bugeeke agishuba emurhima, anaja gukola.<verse eid="MAT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30" />«Oyo mulume ava abwira omwana waage mudoorho nk'oku abwiraga ola murhanzi. Oyo mwana ashubiza ntya: ‹Neechi daarha, naaja yo!› Aliko arhajaaga yo.<verse eid="MAT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31" />«Leero mwaba bombi, nde wajirire obulonza bw'eshe?» Bamushubiza ntya: «Omurhanzi.»</para>
  <para style="p" vid="MAT 21:31">Elugulu w'echo, Yeesu aderha ntya: «Okuli mbabwirire, oku abafurhiisa b'amakooli n'abahushi, bo babarhanga kuja omu Bwami bwa Nnamahanga. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Kwenge Yohaana ahikire mwenyu y'abayereke enjira ekwaneene embere za Nnamahanga, murhamuyemeraga. Aliko abafurhiisa b'amakooli n'abahushi, boowe balimuyemereere. Kandi, chiro akaba mwalibwene ebyo byooshi, murhahindamukaga gurhenga omu byaaha byenyu, yi mumuyemeere.»<verse eid="MAT 21:32" /></para>
  <para style="s">Omugani gw'abahinzi babi</para>
  <para style="r">
    <ref loc="MRK 12:1-12">Mariko 12.1-12</ref>; <ref loc="LUK 20:9-19">Luuka 20.9-19</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Yeesu ashuba kuderha ntya: «Muyunvirize ku guno gwindi mugani. Haliiri mulume muguma wahingaga eshwa lyaage ly'emizabiibu. Elyo shwa, alihira ko oluzirhu, ajokola aha balema bakandira amalehe m'emizabiibu. Ayumbakira abalanzi balyo echiraaro chilehere. Amalire kuyunvikana echigabane n'abahinzi baguma, abalama. <figure style="fig" alt="pressoir" file="LB00130B.TIF" size="col" copy="Horace Knowles" ref="21.33">ahantu h'ogukandira amalehe m'emizabiibu</figure><verse eid="MAT 21:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 21:34" />«Amango m'ogushaluula mahikire, nyina eshwa arhuma abaaja baage emunda bala bahinzi bali, yi bamuhe echigabi chaage ch'eshaluulo. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Aliko bala bahinzi bafarha abo baja. Muguma bamushurha bwenene, n'owindi bamuyirha, n'owagasharhu bamuyirha omu kumubanda amabaale. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Oyo nyina eshwa ashuba gurhuma abandi bakozi banene kulusha bala barhanzi. Aliko abo bahinzi babajirira nk'oku bajiriraga bala barhanzi.<verse eid="MAT 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 21:37" />«Oku buzinda, nyina eshwa aja abarhumira omwana waage, aderha ntya: ‹Oyu mwana waani yeewe bamukenga.› <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Aliko abo bahinzi babeere babona oyo mwana waage, baderha ntya: ‹Oyuula, yi walya omwandu gw'eshe. Mujire, rhumuyirhe yi rhuguyorhane.› <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Baja bamugwarha n'okumukululira eburhambi bw'elyo shwa, bamuyirha.»<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />Yeesu aja abaza ntya: «Amango nyina elyo shwa ly'emizabiibu nj'agaluka, gurhe nj'ajira abo bahinzi?» <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />Bamushubiza ntya: «Abo bantu babi, nj'ayirha bo buzira kubayunvira obonjo. N'elyo shwa lyaage, nj'alihaana echigabane oku bandi bahinzi abalema bamuha echaage chigabi ch'eshaluulo.»<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Yeesu aj'ashuba kubabaza ntya: «Ka murhashubiraga gusoma oku Mandiko Matagatiifu maderhere? Biyandikirwe mo ntya:</para>
  <para style="q1" vid="MAT 21:42">‹Ebaale ab'okuyumbaka balahiraga,</para>
  <para style="q1" vid="MAT 21:42">lyo lyahindukire baale linene ly'oku pembe.</para>
  <para style="q1" vid="MAT 21:42">Na Nnaweerhu ye wajiraga ebyoola.</para>
  <para style="q1" vid="MAT 21:42">Na byo biri bisomereene ku rhwabo!›<note caller="+" style="f"><char style="fr" closed="false">21.42 </char><char style="ft" closed="false">Osome Nanga 118.22-23.</char></note><verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />«Cho girhumire, mbabwirire oku mwabo, Nnamahanga nj'abanyega oBwami bwage, n'okubuha abandi bantu abanjibalema bajira obulonza bwage. [<verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Omuntu nji wahenera kw'elyo baale, nj'avunanguka. N'ola nji lyahenera ko, nji lyamuhomboola.]<note caller="+" style="f"><char style="fr" closed="false">21.44 </char><char style="ft" closed="false">Olu lukere lurhali omu bitaabu binene bya miira.</char></note>»<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Abakulu b'abadaahwa n'<char style="w" lemma="Bafarisaayo:">aBafarisaayo</char> babeere bayunva kw'eyo migani ya Yeesu, baja bamenya okw'aliiri aderha elugulu waabo. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Echo charhuma, baja bashonda obulyo bw'okumugwarha, aliko bayuubaha ebigusho by'abantu, bulaala abo bantu baliiri bayemereere oku Yeesu ali muleebi.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Omugani gw'edinye ly'obuhya</para>
  <para style="r">
    <ref loc="LUK 14:15-24">Luuka 14.15-24</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Yeesu agendekera kuderha n'echo chigusho ch'abantu omu migani. Ababwira ntya: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />«oBwami bw'empingu bushushanyizwe na mwami muguma wajiriraga omugala edinye ly'obuhya. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Oyo mwami arhuma abaja baage baje guhamagala abantu bali balaalikirwe oku dinye. Aliko abo bantu barhashondaga guhika. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Aja arhuma abandi baja. Ababwira ntya: ‹Muje kubwira abantu nalaalikaga oku dinye oku: ''Namalire kubaaga enka zaani, n'ezindi nyama zishishire. Muje mwayinja oku dinye, bulaala ebintu byooshi byarheganyizwe.''› <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Aliko aboola balaalikwa, barhalagaga n'ogo mulaali, bachigendera omu byaabo. Muguma aja omu shwa lyaage, n'owindi omu burhimbuuzi bwage. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />N'abandi bagwarha aboola baaja, babashurha bwenene n'okubayirha.<verse eid="MAT 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 22:7" />«Oyo mwami aja ayunva oburhe. Arhuma abasoda baage baje kuyirha aboola biisi, banadwike egishagala chaabo. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Aja abwira abaja baage ntya: ‹Ebiryo by'edinye byahire, aliko abantu nalaalikaga barhali bo balikwaneene kubirya. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Bunoola, mujaage mwaja omu mashanganjira, n'abantu booshi mwabona, mubabwire bayinje oku dinye.› <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Balaala baja, baaja omu njira banagusha abantu booshi babonaga, ababi n'abenja. N'enju y'edinye yayunjula abahisi.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />«Oyo mwami abeere aja omu nju y'alole abahisi, abona muntu muguma orhayambeere omwambalo gw'edinye. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Amubaza ntya: ‹Ego mwira waani, gurhe wajaaga muno buzira kuyambala omwambalo gw'edinye?› Oyo muntu arhashubizaga chintu. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />Elugulu w'echo, oyo mwami aja abwira abakozi baage ntya: ‹Oyu muntu, mumushweke amagulu n'amaboko, muje mwamukabula embuga omu mwizimya! Na mw'ogo mwizimya, mw'alakira n'okulibuka bwenene.› <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />Oku buzinda, Yeesu aderha ntya: ‹Abantu bahamagerwe bali banene, aliko abagishogerwe bali bageeke.›»<verse eid="MAT 22:14" /></para>
  <para style="s">Ogufurha ekooli lya Kayizaari</para>
  <para style="r">
    <ref loc="MRK 12:13-17">Mariko 12.13-17</ref>; <ref loc="LUK 20:20-26">Luuka 20.20-26</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Enyuma z'ebyoola, <char style="w" lemma="Bafarisaayo:">aBafarisaayo</char> baaja akaligi yi bagale gurhega Yeesu kugerera ebinwa byaage. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Bamurhumira abigirizwa baabo baguma, haguma n'abandi b'omu chigusho cha Heroode. Bahika kubaza Yeesu ntya: «Mwigiriza, rhuyinji ok'onaderha ebinwa by'okuli, kandi onayigiriza abantu ebinwa bya Nnamahanga ebi bakwaneene gukulikira nk'oku bihemere. Kandi orhayubaha chiro muntu orhanayuubahiswa n'obukulu bw'omuntu. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Ojaage warhubwira gurhe obwene elugulu w'ogu mwazi: K'erhegeko lyeerhu lirhuyemeerere changwa nangwa okulema rhwafurha ekooli emwa mwami Kayisaari?»<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Aliko okubona Yeesu alimenyere enkengeero zaabo zibi, abashubiza ntya: «Mwe ndyaalya mwe! Girhumire mwantega ntya? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Munyereke olufuranga munahaana omu gufurha ekooli.»</para>
  <para style="p" vid="MAT 22:19">Bamuyeereka egicheri ch'olufuranga.<note caller="+" style="f"><char style="fr" closed="false">22.19 </char><char style="ft" closed="false">Echo chikoroto chaliiri ch'edinaari. Osome Matayo 20.2.</char></note> <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Yeesu ababaza ntya: «Eri shusho n'eri ziino biyandikirwe hano, biri bya nde?» <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />Bamushubiza ntya: «Bya Kayizaari.»</para>
  <para style="p" vid="MAT 22:21">Yeesu aja ababwira ntya: «Muleme mwaha Kayizaari ebiri byaage, na Nnamahanga ebiri byaage.»<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Abo bantu babeere bayunva echo chinwa, basoomerwa bwenene. Bamuleka banachigendera.<verse eid="MAT 22:22" /></para>
  <para style="s">aBasadukaayo babaza Yeesu elugulu w'obufuuke</para>
  <para style="r">
    <ref loc="MRK 12:18-27">Mariko 12.18-27</ref>; <ref loc="LUK 20:27-38">Luuka 20.27-38</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Mw'oloola lusiku lo n'olo, aBasadukaayo baguma nabo bahikira Yeesu. Abo Basadukaayo, bo banaderha oku abafu nji barhafuuka. <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />Bamubaza ntya: «Mwigiriza, Muusa aderhere mpu: ‹Nk'omulume afiire buzira kuburha omwana, mwene waabo akwaneene kuyingira oyo mushumbakazi n'okuburhira nyagufa abaana.› <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Leero ahagarhi keerhu, haliiri barhabana mushanvu ba nda nguma. Efula yashaba omukazi, yafa buzira kuburha. Mudoorho waage ayingira omulamukazi. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Oyo mudoorho waage naye byaaba ntyo. Byanaba ntyo oku wagasharhu guhika oku wamushanvu. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Enyuma z'ogufa kw'abo barhabana booshi, ola mushumbakazi naye afa. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Leero, olusiku abafu nji bafuuka, oyo mukazi nj'aba muka nde? Kwenge bala barhabana mushanvu booshi balimushabire.»<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Yeesu abashubiza ntya: «Mwagirhebekere bwenene, elugulu w'ogurhamenya aMandiko Matagatiifu, changwa obuhashe bwa Nnamahanga. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Kwenge amango abafu nji bafuuka, abalume n'abakazi barhagachishabana. Aliko nji baaba nka bamalahika b'omu mpingu. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />N'oku biyerekeere obufuuke bw'abafu, ka murhashubiraga gusoma ebi binwa Nnamahanga ababwiraga ntya: <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‹Nyoono ndi Nnamahanga w'Aburahaamu, na wa Isaka, na wa Yakobo.›<note caller="+" style="f"><char style="fr" closed="false">22.32 </char><char style="ft" closed="false">Osome Lubunguluko 3.6.</char></note> Yeesu ashuba kuderha ntya: ‹Nnamahanga arhali Nnamahanga w'abafu, aliko ali Nnamahanga w'abazeene!›»<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Abo bantu babeere bayunva ebyo binwa, basoomerwa bweneene elugulu w'enyigirizo za Yeesu.<verse eid="MAT 22:33" /></para>
  <para style="s">Erhegeko likulu</para>
  <para style="r">
    <ref loc="MRK 12:28-34">Mariko 12.28-34</ref>; <ref loc="LUK 10:25-37">Luuka 10.25-37</ref></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />
    <char style="w" lemma="Bafarisaayo:">aBafarisaayo</char> babeere bayunva oku Yeesu ahimire aBasadukaayo omu binwa, baaja enaama. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Mwigiriza w'amarhegeko muguma omu bo, ageregeza Yeesu ntya: <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />«Mwigiriza, omu marhegeko, rhegeko lihe liri likulu omu mooshi?»<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />Yeesu amushubiza ntya: «Osiime Nnaweerhu Nnamahanga waawe n'omurhima gwawe gooshi, n'emisi yaawe yooshi, n'obwenge bwawe booshi.<note caller="+" style="f"><char style="fr" closed="false">22.37 </char><char style="ft" closed="false">Osome Rhegeko 6.5.</char></note> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Elyoola ly'erhegeko likulu bweneene lyo na lirhanzi. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />N'erhegeko lyakabiri nalyo linali nk'elyo lirhanzi, linaderhere ntya: ‹Osiime omuturanyi waawe nk'oku ogisiima wenyine.›<note caller="+" style="f"><char style="fr" closed="false">22.39 </char><char style="ft" closed="false">Osome Balaawi 19.18.</char></note> <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Ama marhegeko mombi mo mahekere ebinwa byooshi biyandikirwe omu Rhegeko lya Muusa n'omu bitaabu by'abaleebi.»<verse eid="MAT 22:40" /></para>
  <para style="s">Kirisitu na Daawudi</para>
  <para style="r">
    <ref loc="MRK 12:35-37">Mariko 12.35-37</ref>; <ref loc="LUK 20:41-44">Luuka 20.41-44</ref></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Abo <char style="w" lemma="Bafarisaayo:">Bafarisaayo</char> babeere bachiri haguma, Yeesu ababaza ntya: <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />«Bichi muganiizize elugulu wa Kirisitu? Oyo Kirisitu, ali mugala wa nde?» Nabo bamushubiza ntya: «Ali mugala wa Daawudi.» <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />Yeesu aj'ashuba kubabaza ntya: «Leero gurhe Daawudi ahamagalaga Kirisitu oku ali Nnaweerhu, noobo oyo Daawudi aliiri ey'ayerekerwe na Muuka-Mutagatiifu? Kwenge Daawudi aderhere ntya:<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />‹Nnaweerhu Nnamahanga abwiraga Nnaweerhu mpu:</para>
  <para style="q1" vid="MAT 22:44">"Yikala ekulyo kwani,</para>
  <para style="q1" vid="MAT 22:44">guhika mpire abanzi baawe eshiishi w'amagulu maawe."›<note caller="+" style="f"><char style="fr" closed="false">22.44 </char><char style="ft" closed="false">Osome Nanga 110.1.</char></note><verse eid="MAT 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 22:45" />«Leero akaba Daawudi ahamagere Kirisitu ‹Nnaweerhu›, nka gurhe Kirisitu agashuba kuba mugala?»<verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />Ntyo, nta muntu waligalire kumushubiza chiro echinwa. Na gurhengera oloola lusiku, harhaliiri chiro n'omuntu washubire kandi kumubaza.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Yeesu akalihira abigiriza b'amarhegeko n'aBafarisaayo.</para>
  <para style="r">
    <ref loc="MRK 12:37-40">Mariko 12.37-40</ref>; <ref loc="LUK 11:39-52">Luuka 11.39-52</ref>; <ref loc="LUK 20:45-47">20.45-47</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Enyuma z'ebyoola, Yeesu aj'abwira echigusho ch'abantu n'abigirizwa baage ntya: <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />«Abigiriza b'amarhegeko n'<char style="w" lemma="Bafarisaayo:">aBafarisaayo</char> bahabirwe akaasi k'okuyigiriza abantu amarhegeko ma Muusa. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Cho girhumire, muhemerwe kulema mwabakenga n'ogukulikira byooshi balema bababwira.</para>
  <para style="p" vid="MAT 23:3">«Aliko, murhalemaga mwakulikira ebijiro byaabo, kwenge ebi banaderha, birhali bibanajira. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Banashanira abandi emizigo elemeerere n'okubahesa yo oku birhugo, aliko boowe barhakagala chiro guhira ko omudoke gwabo. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />Byooshi banalema bajira, banabijira yi babonekane embere z'abantu. Boowe banagalihya orhusanduku banashwekera oku malanga changwa oku maboko.<figure style="fig" alt="Phyilactère" file="HK00274B.TIF" size="col" copy="Horace knowles" ref="23.5">Omuyaahudi oyambeere akasanduku oku malanga</figure> <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Omu dinye, basiima kuyikala oku bichumbi by'olukengo. N'omu masinagoogi maabo, basiima kuyikala oku bichumbi by'embere. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />Na ntyo, banalema basiima abantu baleme babalamusa n'obukenge ahantu h'enshimanaano n'oguhamagalwa ‹Mwigiriza!›<verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />«Aliko mwabo, murhalemaga mwayemera guhamagalwa ‹Mwigiriza!›. Kwenge mweshi muli baguma, munagwerhe mwigiriza muguma yenyine. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Na ntyo, muno gulu murhalemaga mwahamagala omuntu yeeshi ntya: ‹Daarha›, kwenge mugwerhe Sho muguma yenyine, oli omu mpingu. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Murhalemaga mwayemera babahamagala ntya: ‹Waliha!›, kwenge mugwerhe mukulu muguma yenyine, ye Kirisitu. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Leero, oli mukulu mu mwabo, bihemere abe mukozi wenyu. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Ngasi yeeshi ochikuuza, nj'ayandagazwa. Aliko ochiyandagaza yeewe, nj'akuuzwa.»<verse eid="MAT 23:12" /></para>
  <para style="s">Obulyaalya bw'abigiriza b'amarhegeko n'aBafarisaayo</para>
  <para style="r">
    <ref loc="MRK 12:40">Mariko 12.40</ref>; <ref loc="LUK 11:39-52">Luuka 11.39-52</ref>; <ref loc="LUK 20:45-47">20.45-47</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />«Buhanya emwenyu mwe bigiriza b'amarhegeko neenyu <char style="w" lemma="Bafarisaayo:">Bafarisaayo</char>. Mwabo muli ndyaalya! Mulimwachingira abantu enjira y'okuja omu Bwami bw'empingu, noobo mwabo mwenyine murhaja mo. N'amango abantu yibashonda kuja mw'obo Bwami, mwabo muli mwababuza.<verse eid="MAT 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 23:14" />[«Buhanya emwenyu mwe bigiriza b'amarhegeko n'aBafarisaayo, mwe ndyaalya mwe! Munalya ebikulo by'abashumbakazi n'ogusaliira amasaala maleehere y'abantu bababone. Elugulu w'ebyoola, obuhane bwenyu nji bwaba bunene kulusha.]<note caller="+" style="f"><char style="fr" closed="false">23.14 </char><char style="ft" closed="false">Olu lukere lurhali omu bitaabu binene bya miira.</char></note><verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />«Buhanya emwenyu, mwe bigiriza b'amarhegeko n'aBafarisaayo. Mwabo muli ndyaalya! Muli mwazungula egulu lyooshi chiro n'okuyambuka enyanja, yi mujire chiro muntu muguma kuba w'echigusho chenyu. Oyo muntu, mukamubona, munamujira kuba okwaneene guhanwa kabiri kubalusha eyo kuzimu.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />«Buhanya emwenyu, mwe barhegesi, muli mpumi! Munaderha ntya: ‹Nk'omuntu ajirire endahiro kulengera eziino ly'eNju ya Nnamahanga, eyo ndahiro ntaacho emalire. Aliko nk'ajirire endahiro kulengera eziino ly'ehooro eri elugulu w'eyo Nju ya Nnamahanga, oyo muntu akweneene gukola gukulikirana n'endahiro yaage.› <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Mwabo muli bihwinja na kandi muli mpumi! Gichi chiri ch'akamaro kulusha echindi, k'ehooro eri kw'eyo Nju ya Nnamahanga changwa eNju ya Nnamahanga yonyine? Eyo Nju yerhumire eyo hooro yacheeswa! <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Na kandi muli mwaderha ntya: ‹Nk'omuntu ajirire endahiro oku ziino ly'entuuliro, nta bubi. Aliko nk'ajirire endahiro oku ziino ly'entuulo eri kw'eyo ntuuliro, akwaneene gukola gukulikirana n'endahiro yaage.› <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Mwe mpumi! Gichi chiri ch'akamaro kulusha echindi? K'entuulo changwa eyo ntuuliro yenarhuma eyo ntuulo yacheeswa? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Cho girhumire, amango omuntu ajirire endahiro oku ziino ly'entuuliro, eri amanajira endahiro n'oku byooshi biri elugulu wa yo. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />N'ojirire endahiro oku ziino ly'eNju ya Nnamahanga, amajira endahiro kw'eyo Nju ya Nnamahanga, amanajira endahiro oku ziino lya Nnamahanga oli mw'eyo Nju. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />N'olaala ojira endahiro oku ziino ly'empingu, eri ajirire endahiro oku ziino ly'entebe y'echaami ya Nnamahanga, n'oku ziino lya Nnamahanga oyikeere ko.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />«Buhanya emwenyu mwe bigiriza b'amarhegeko nenyu Bafarisaayo! Mwabo muli ndyaalya! Munarhuula chiguma ch'ekumi ch'ebirhi by'obulunge. Aliko muli mwaleka ebintu biri by'akamaro omu Rhegeko, nka kujira ebikwaneene embere za Nnamahanga, ogufiira abandi obonjo n'ogurhahemukira abandi. Ebyo bimwalikwaneene kujira buzira kuleka ebyo bindi. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Mwe barhegesi mpumi! Munashongoola esuusi omu menji menyu m'okunywa, aliko mwanamira engamiya.<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />«Buhanya emwenyu mwe bigiriza b'amarhegeko nenyu Bafarisaayo! Mwabo muli ndyaalya! Munacheesa emugongo gw'egumbu n'embale, aliko omu byo muyunjwire ebintu mwabonaga omu bwizi n'enyifinjo zenyu zibi. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Wooyo Mufarisaayo mpumi! Orhange gucheesa omu ngumbu, na ntyo emugongo gwayo gwanacheeswa.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />«Buhanya emwenyu mwe bigiriza b'amarhegeko nenyu Bafarisaayo! Mwabo muli ndyaalya! Mushushanyizwe nka shinda zishigirwe eshwagara. Ezo shinda, zinabonekana zikwirire embuga, gasi omu zo muyunjwire amagufa m'abafu n'ebindi bintu bibolere. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Nenyu ntyo ku muli. Mubonekana embere z'abantu nka bantu bakwaneene. Aliko muyunjwire obulyaalya n'obubi.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />«Buhanya emwenyu mwe bigiriza b'amarhegeko nenyu Bafarisaayo! Mwabo muli ndyaalya! Munayumbakira eshinda z'abaleebi, n'oguhira obulimbi oku shinda z'abantu bakwaneene. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Kandi muli mwaderha ntya: ‹Nka rhwalamaga omu mango ma bashookuluza beerhu, rhurhakajirire akalengane haguma nabo k'ogusheesha eshagama y'abaleebi.› <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Omu kuderha ntyo, mwayerekeene mwenyine oku muli baana b'abantu basheshaga eshagama y'abaleebi. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Mujaage mwagendekeza n'okuyuusa akaasi bashookuluza benyu barhonderaga! <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />Mwabo muli buuko bw'enjoka! Gurhe mwakagala gufuma obuhane bw'omuliro gw'esiku n'amango? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Cho girhumire, nji nabarhumira abaleebi n'abantu b'obwenge n'abigiriza b'amarhegeko. Mwayirha baguma omu bo, mwabamba abandi oku misalaaba, mwashurha n'abandi enkoni omu masinagoogi menyu n'okubalibisya mu ngasi gishagala. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Mumenye oku eshagama y'abantu booshi bakwaneene bayirhwaga omu gulu buzira bubi, nji yaaba oku marhwe menyu. Oko kuyirhwa kwarhondereraga oku Abeeli waliiri muntu w'okuli guhika okuyirhwa kwa Zakariya, mwene Barakiya, mwayirhiraga omu Nju ya Nnamahanga ahagarhi k'ahantu hatagatiifu n'aha entuuliro.<note caller="+" style="f"><char style="fr" closed="false">23.35 </char><char style="ft" closed="false">Osome Murhondero 4.8; 2 eByaliiri kujirika 24.20-22.</char></note> <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Okuli mbabwirire oku ebi binwa byooshi byaaba oku rhwe ly'abantu ba chino gisisi.»<verse eid="MAT 23:36" /></para>
  <para style="s">Yeesu alirira aBanyayerusaleema</para>
  <para style="r">
    <ref loc="LUK 13:34-35">Luuka 13.34-35</ref></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />«aBanyayerusaleema, aBanyayerusaleema! Mwabo munayirha abaleebi n'okubabanda amabaale bala Nnamahanga anabarhumira. Hanene nalishondere kubagusha nka kula engoko egusha ebyaana byaayo omu byuubi, aliko mwabo murhashondaga! <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Mumenye bwinja oku enju yenyu yalekwa mushaka. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Mbabwirire oku gurhengera zeene murhagachimbona ko guhika amango nji mwaderha ntya: ‹Agishirwe oyuula oyinjire oku ziino lya Nnaweerhu!›<note caller="+" style="f"><char style="fr" closed="false">23.39 </char><char style="ft" closed="false">Osome Nanga 118.26.</char></note>»<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">Yeesu abala omwazi gw'ogushandwa kw'eNju ya Nnamahanga</para>
  <para style="r">
    <ref loc="MRK 13:1-4">Mariko 13.1-4</ref>; <ref loc="LUK 21:5-7">Luuka 21.5-7</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Yeesu abeere ali ahuluka omu Nju ya Nnamahanga, abigirizwa baage bamuhikira yi bamuyeereke gurhe eyo Nju eyumbakirwe. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Aliko Yeesu abashubiza ntya: «Okuli mbabwirire oku ebyo byooshi mubwene hano, harhayoorha chiro ebaale oku lindi. Byooshi nji byashandwa!»<verse eid="MAT 24:2" /></para>
  <para style="s">Ebi nji byahika omu siku z'obuzinda</para>
  <para style="r">
    <ref loc="MRK 13:3-13">Mariko 13.3-13</ref>; <ref loc="LUK 21:7-19">Luuka 21.7-19</ref></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Yeesu abeere ayikeere yenyine oku musozi gw'eMizeyituuni, abigirizwa baage bamuhikira. Bamubaza ntya: «Rhubwirage mango machi ebyo nji byahikira n'echimenyeso gichi nji charhuyeereka amango m'okugaluka kwawe na ech'obuzinda bw'egulu!»<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Yeesu abashubiza ntya: «Mube hoobwe! Harhabaaga omuntu wabarhebeka, <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Kwenge bantu banene nji bayinja omu ziino lyaani. Abo bantu nji balema baderha ntya: ‹Nyoono nye Kirisitu!› Nji banarhebeka bantu banene. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Mw'ezo siku, mwayunva abantu baderha elugulu w'ebiirha ngasi hooshi. Aliko murhayuubahaga, kwenge ebyo byooshi, bikwaneene guhika. Aliko ebyoola, birhaba byayerekeene okw'obuzinda bw'egulu bwahikire. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Egihugo nji chalwisa echindi. N'obwami nji bwalwisa obwindi. N'omu bihugo binene nji mwaba enzara n'omusisi gw'edaho nji gwalema gwagera. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Ebyo byooshi, biri nka murhondero gw'emikero.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />«Abantu nji balema babahaana yi mulibuzwe bweneene munayirhwe. N'abantu b'embaga zooshi nji babagaya elugulu waani. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Mw'ezo siku, bantu banene nji baleka obwemeezi bwabo. Abantu bonyine oku bonyine nji balema balenganyana n'ogushombana. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Baleebi banene b'obubeeshi nji baahulukira. Abo baleebi nji barhebeka bantu banene. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />N'elugulu w'okuluga kw'obubi, obuzigire bw'abantu banene nji bwageeha. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Aliko omuntu nji wagihangaana guhika oku buzinda nj'achungulwa. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />N'ogu Mwazi Mwinja g'oBwime nji gwayamagazwa omu gulu lyooshi, kuba buhamiiriza oku bantu b'embaga zooshi. N'obuzinda bwanaja bwahika.»<verse eid="MAT 24:14" /></para>
  <para style="s">Amalibuko makomeere</para>
  <para style="r">
    <ref loc="MRK 13:14-23">Mariko 13.14-23</ref>; <ref loc="LUK 21:20-24">Luuka 21.20-24</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />«Mw'ezo siku, nji mwabona olaala oyirikwa ntya: "Bubi bw'ogushanda"<note caller="+" style="f"><char style="fr" closed="false">24.15 </char><char style="ft" closed="false">Osome Danyeeri 9.27; 11.31; 12.11.</char></note> ola waderhagwa n'omuleebi Danyeeri ayimangire omu Nju ya Nnamahanga. Oli wasoma eyi myaazi, amenye bichi ederhere.<verse eid="MAT 24:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 24:16" />«Leero, abantu nji baaba bali omu gihugo ch'eYudeeya balibirhire oku misozi. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Akaba omuntu nj'aba ali oku nju elugulu, arhagishonookaga okw'aje gurhoola ebintu omu mwage. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />N'akaba omuntu nj'aba ali omu shwa, arhachigalukaga emwage okw'aje gurhoola efulema yaage.<verse eid="MAT 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 24:19" />«Mw'ezo siku, nji bwaba buhanya bunene oku bakazi nji baaba bali bukule n'oku balaala nji baaba bali bayonsa! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Oko kulibirha kwenyu, muheme Nnamahanga yi nji gurhabaaga amango m'emboho nene changwa olusiku lw'eSaabato. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Kwenge ezo siku nji zaaba z'amalibuko makomeere marhashubiraga kuba gurhengera okulemwa kw'egulu guhika zeene. N'amalibuko mali nk'amo, marhakanachiba. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Ezo siku, nka Nnamahanga arhazigeehyaga, nta muntu chiro n'omuguma wangachungwirwe. Aliko azigeehyeze elugulu w'abantu baage aligishogere.<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />«Mw'ezo siku, nk'omuntu ababwirire ntya: ‹Lola, Kirisitu ali hano!› changwa ‹Ali haliira!› murhamuyemeeraga, <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />kwenge nji harhengera abantu balema baderha obubeeshi oku boowe bo ‹Kirisitu›, haguma n'abaleebi b'obubeeshi. Abo booshi, nji balema bajira ebisomereene n'ebimenyeso y'akonva bigalikeene, barhebeke chiro n'abantu Nnamahanga abaaga agishogere. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Mumenye! Mbabwirire eyi myaazi yooshi embere ehike.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />«Elugulu w'ebyoola, nk'abantu bababwirire ntya: ‹Mulole! Kirisitu y'oliira oli omu mpinga!›, murhajaga yo. Changwa akonva bababwirire ntya: ‹Yooyu achibishire omu busiika!›, murhabayemeeraga. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Kwenge, okuyinja kwani nyoono Mwene oMuntu, nji kwaba nka kulaala omubaraganyo gumoleka omu chalege chooshi.<verse eid="MAT 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 24:28" />«Ahantu hooshi hali omurhumba, ho hagwirira banyunda.»<verse eid="MAT 24:28" /></para>
  <para style="s">Okuyinja kwa Mwene oMuntu</para>
  <para style="r">
    <ref loc="MRK 13:24-27">Mariko 13.24-27</ref>; <ref loc="LUK 21:25-28">Luuka 21.25-28</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />«Enyuma z'amalibuko m'ezo siku,</para>
  <para style="q1" vid="MAT 24:29">ezuuba nji lyahindamuka mwizimya,</para>
  <para style="q1" vid="MAT 24:29">n'omwezi nji gurhachimoleka,</para>
  <para style="q1" vid="MAT 24:29">enyenyeezi nazo, nji zarhoga gurhenga omu chaalege.</para>
  <para style="q1" vid="MAT 24:29">Na byooshi by'obuhashe omu mpingu, nji byashaganywa.<note caller="+" style="f"><char style="fr" closed="false">24.29 </char><char style="ft" closed="false">Osome Isaya 13.10; 34.4.</char></note><verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />«Oku buzinda, echimenyeso ch'okugaluka kwani nyoono Mwene oMuntu, nji chaboneka omu mpingu. N'abantu b'embaga zooshi z'omu gulu, nji baaba omu malibuko. Nji babona oku nyoono Mwene oMuntu, narhenga omu mpingu eyi ndi omu bichu n'obuhashe n'obukuuze bunene. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Omushekera gunene, nji lyabandwa mo. Oku buzinda, nji narhuma bamalahika baani bagende omu nyunda zooshi z'egulu, kugusha abantu baani nagishogere.»<verse eid="MAT 24:31" /></para>
  <para style="s">Omugani gw'omurhi gw'etiini</para>
  <para style="r">
    <ref loc="MRK 13:28-32">Mariko 13.28-32</ref>; <ref loc="LUK 21:29-33">Luuka 21.29-33</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />«Muchiyigirize kulengera omugani gw'omurhi gw'etiini. Ogo murhi, egihe amarhabi maago mashogere, n'ebibaabi byaago byashishire, munaderha okw'echanda chiri hoofu. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Leero, amango nji mwabona ebyo byooshi, mumenye oku nyoono Mwene oMuntu ndi hoofu na nkola ndi oku mulyango. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Okuli, mbabwirire okw'abantu b'echi gisisi nji barhafa booshi embere ebyo byooshi bihike. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Empingu n'egulu nji byagera, aliko ebinwa byaani byoowe, birhakagera chiro n'ehintyu.<verse eid="MAT 24:35" /></para>
  <para style="s">Nnamahanga yenyine oyinji egihe ch'obuzinda</para>
  <para style="r">
    <ref loc="MRK 13:32-37">Mariko 13.32-37</ref>; <ref loc="LUK 17:26-30">Luuka 17.26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />«Aliko nta muntu yeeshi oyinji olo lusiku changwa ebishanji ebyo nji byajirika mo. Chiro n'abamalahika b'empingu, changwa naani Mwene oMuntu rhurhenji, Daarha yenyine ye yinji. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Nk'oku byaliiri omu siku za Noowa, ntyo ku nji byaba amango nyoono Mwene oMuntu nji nagaluka. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Kwenge embere w'ezo siku z'emisuuka minene, abantu baliiri kulya n'okunywa, baliiri gushaba n'ogushabwa, guhika olusiku Noowa ajaaga omu nkuge. <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />Abo bantu, barhamenyaga ebyajirika guhika amango emisuuka minene ebaheeka booshi.</para>
  <para style="p" vid="MAT 24:39">«Ntyo kunjibyaaba amango nyoono Mwene oMuntu nji nagaluka. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Mw'amo mango, bantu babiri nji baaba bali omu shwa, muguma nj'aheekwa n'owindi nj'alekwa. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Bakazi babiri nji baaba bali basha oku lusho luguma, muguma nj'aheekwa n'owindi nj'alekwa.<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />«Boboola mutarame, kwenge murhamenyere olusiku Nnawenyu nj'agaluka mo. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Muyinji bwinja, nyina enju nk'amenyaga ebishanji bihe by'obudufu egishambo chayinja mo kuzimba, ankataramiire n'okulanga enju yaage erhashandwaga. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Cho girhumire, nenyu muyoorhe eyi mugirheganyize, kwenge nyoono Mwene oMuntu nji nagaluka omu bishanji murhamenyere.»<verse eid="MAT 24:44" /></para>
  <para style="s">Omugani gw'omukozi muhemusi n'orhali muhemusi</para>
  <para style="r">
    <ref loc="LUK 12:41-48">Luuka 12.41-48</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />«Nde oli mukozi orhali muhemusi onagwerhe obwenge? Omukozi oli nk'oyo, y'olaala nnahamwabo aheere obwimangizi bw'abandi bakozi baage y'abahe ebiryo oku bishanji bikwaneene. <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Agishwe oyo mukozi, akaba nnahamwabo akagaluka, anamushimaane achiri akola akoola kaasi. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" /><char style="w" lemma="Bibe ntyo:">Okuli</char>, mbabwirire okw'oyo nnahamwabo nj'amujira mwimangizi w'ebikulo byaage byooshi. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Aliko akaba oyo mukozi ali muntu mubi, n'oguchiderhesa omu murhima gwage ntya: ‹Nnahamweerhu alegamire kugaluka.› <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />Anaja arhondera kulema ashuurha abaabo bakozi na kulema alya n'okunywa haguma n'abarhamiizi. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Leero, nnahamwabo nj'agaluka olusiku arhakengereere, n'oku bishanji arhamenyere. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Elugulu w'ebyoola, nnahamwabo nj'amushuurha bweneene n'okumuhana kuguma na kulaala banahana endyaalya. N'oku buzinda, anamukabula ahantu nj'alakira n'okulibuka bweneene.»<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">Omugani gwa banyere ekumi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />«Leero, oBwami b'empingu, nji bwashushanywa n'omugani gw'abanyere ekumi. Abo banyere, barhoolaga amatara maabo yi baaje kuyankirira muhya-mulume. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Barhaano mubo baliiri bihwinja na bandi barhaano baligwerhe obwenge. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Ebyo bihwinja barhoola amatara maabo, aliko barharhoolaga ebitorooli by'oguhira mo. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Aliko abaligwerhe obwenge, barhoola amatara maabo haguma n'ebitorooli omu masupa. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Okubona okw'oyo muhya-mulume alilegamire kuyinja, abo banyere ekumi booshi bahunira n'okuva balyaama.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />«Ahagarhi k'obudufu, omulenge gwayunviikana guderhere ntya: ‹Tala! Muhya-mulume ayinjire! Muhuluke kuja kumuyankirira!› <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />Ho n'aho, abo banyere booshi bazuuka, barheganya amatara maabo.<verse eid="MAT 25:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 25:8" />«Bila bihwinja byabwira abaligwerhe obwenge ntya: ‹Murhuhe oku bitorooli byenyu, bulaala amatara meerhu marhondere kuzima.› <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />Aliko bala baligwerhe obwenge babashubiza ntya: ‹Nangwa! Ebi bitorooli rhugwerhe, birhangarhulumira rhweshi. Muje emw'abarhimbuuzi yi muchigulire ebyenyu.›<verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />«Ebyo bihwinja, byabeere byajire kugula ebitorooli, muhya-mulume ahika. Bala banyere barhaano baligirheganyize miira, baaja omu dinye ly'obuhya haguma naye. Oku buzinda, omulyango gwachingwa.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />«Enyuma z'aho, balaala bandi banyere bahika n'ogurhondera kuderha ntya: ‹Nnaweerhu! Nnaweerhu! Orhuchinguulire!› <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />Aliko muhya-mulume abashubiza ntya: ‹Okuli mbabwirire, ntabamenyere!›»<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />Oku buzinda, Yeesu ashuba kuderha ntya: «Leero mutarame, kwenge murhamenyere olusiku changwa ebishanji nji nagaluka.<verse eid="MAT 25:13" /></para>
  <para style="s">Omugani gw'abakozi basharhu</para>
  <para style="r">
    <ref loc="LUK 19:11-27">Luuka 19.11-27</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />«oBwami bw'empingu, rhwakabushushanya n'omugani gw'omuntu muguma washondaga kubalama. Oyo muntu ahamagala abakozi baage n'okubalekera ebikulo byaage yi babikolese. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Aheereza mukozi muguma talanta erhaano<note caller="+" style="f"><char style="fr" closed="false">25.15 </char><char style="ft" closed="false">Osome 18.24.</char></note>, owindi talanta ebiri, n'owindi talanta nguma. Oyo muntu ajiraga ntyo gukulikirana n'obuhashe bwa ngasi mukozi. Oku buzinda abalama.<verse eid="MAT 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 25:16" />«Ho n'aho, ola mukozi bahaaga talanta erhaano, aja kuzirhimbuula mo. Ayunguka zindi erhaano. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />N'olaala bahaaga talanta ebiri, naye aja kuzirhimbuula mo ayunguka zindi biri. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Aliko, olaala bahaaga talanta nguma, yeewe aja kujokola edaho n'okubisha mo ela talanta ya nnahamwabo.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />«Enyuma w'esiku zinene, oyo nnahamwabo agaluka. Ahamagala abakozi baage yi bamubwire gurhe bakoleseze ebikulo byaage. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Olaala mukozi bahaaga talanta erhaano, aleerha enyungu ya zindi erhaano. Aderha ntya: ‹Nnahamweerhu, wampaaga talanta erhaano, leero tala zindi erhaano ezi nayungukire.›<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />«Nnahamwabo amubwira ntya: ‹Wajirire bwinja! Oli mukozi mwinja orhanali muhemusi. Okubona oku orhabeere muhemusi omu bikulo bigeeke, naaja nakujira mwimangizi w'ebikulo binene. Cho girhumire, oje wayinja oshagaluke haguma na nnahamwenyu!›<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />«Olaala mukozi bahaaga talanta ebiri, naye ahika. Aderha ntya: ‹Nnahamweerhu! Wampaaga talanta ebiri, leero tala zindi talanta ebiri ezi nayungukire.›<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />«Nnahamwabo amubwira ntya: ‹Wajirire bwinja! Oli mukozi mwinja orhanali muhemusi. Okubona oku orhabeere muhemusi omu bikulo bigeeke, naaja nakujira mwimangizi w'ebikulo binene. Cho girhumire, oje wayinja oshagaluke haguma na nnahamwenyu!›<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />«Oku buzinda, ola mukozi bahaaga talanta nguma, naye ahika. Aderha ntya: ‹Nnahamweerhu, nyinji okw'oba muntu mudaarhi, wooyo onashaluula eby'orhabyaalaga, onagusha eby'orhashandaazaga. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Elugulu w'oko, nayuubaha, naja nagenda kubisha etalanta yaawe omu daho. Leero, etalanta yaawe eyi, oyirhoole!›<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />«Nnahamwabo amushubiza ntya: ‹Oli mukozi mubi na mwolokazi! Waliyinji oku nanshaluula ebi ntabyaalaga n'okunangusha ebi ntashandaazaga! <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Leero, walikwaneene kubika ebikulo byaani omu banki, y'olusiku nji nagaluka, mbirhoolere mo haguma n'enyungu ya byo.› <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Oku buzinda, aj'aderha ntya: ‹Mumunyege eyo talanta, munayihe olaala ogwerhe talanta ekumi. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Kwenge omuntu ogwerhe akantu ye nji wayushuulirwa akandi, anaja agwarha binene. Aliko omuntu orhagwerhe kantu, nj'anyegwa chiro na hilaala hityu agwerhe. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Na kandi, oyo mukozi orhagwerhe kamaro mumukabule embuga omu mwizimya. Na mw'ogo mwizimya, abantu nji balira n'okulibuka bweneene.›»<verse eid="MAT 25:30" /></para>
  <para style="s">Oguchirwa olushinja luzinda</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />«Amango nyoono Mwene oMuntu nji nayinja omu bukuuze bwani haguma na bamalahika booshi, nji nayikala oku ntebe yaani y'echaami egwerhe obukuuze. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Abantu b'embaga zooshi nji bashimaanana embere zaani, naani nji nabagusha omu bigusho bibiri nka kulaala omungere analema aberuula entaama n'empene. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Nji nahira entaama oku lunda lwani lw'ekulyo n'empene oku lunda lwani lw'emalembe.<verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />«oMwami nj'aja abwira balaala bali oku lunda lwage lw'okulyo ntya: ‹Muyinje, mwe mwagishirwe na Daarha, muje omu Bwami ali abarheganyize gurhengera okulemwa kw'egulu. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Kwenge amango naliiri nzara mwampa ebiryo, n'amango naliiri nyoorha, mwampa ech'okunywa, n'amango naliiri muhisi, mwanyankirira. <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />N'amango nabaaga mbulire emyambalo, mwampa yo, n'amango naliiri mulwala, mwantabaala, n'amango naliiri omu munyororo, mwayinja kuntangula.›<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />«Abo bakwaneene nji bamushubiza ntya: ‹Nnaweerhu, mango machi rhwakubonaga oli nzara, rhwaguha ebiryo, changwa mango machi rwakubonaga oli nyoorha, rhwaguha ech'okunywa? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Na mango machi rhwakubonaga oli muhisi, rhwanakuyankirira? Changwa mango machi waliiri wabulire emyambalo, rhwaguha yo? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Mango machi rhwakubonaga oli mulwala changwa oli omu munyororo, rhwaja kugurhangula?›<verse eid="MAT 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40" />«Oyo Mwami nj'abashubiza ntya: ‹Okuli mbabwirire oku ebyo byooshi, mwabeere muli mwabijirira oli mudoorho mw'aba beene beerhu, nyoono nye mwalemaga mwabijirira.›<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />«Balaala nji baaba bali oku lunda lwani lw'amalembe, boowe nji nababwira ntya: ‹Murhenge eburhambi bwani, mwabo muvumirwe! Muje omu muliro ogurhakazima esiku n'amango. Ogo muliro gwarheganyizwe miira elugulu wa Shetaani na bamalahika baage! <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Kwenge naliiri nzara, nenyu murhampaga ebiryo, naliiri nyoorha, nenyu murhampaga ech'okunywa. <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Naliiri muhisi, nenyu murhanyankiriraga, nabaaga nabulire emyambalo, nenyu murhampaga yo. Naliiri mulwala na naliiri omu munyororo, nenyu murhayinjaga kuntangula.›<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />«Abo nabo nji bamushubiza ntya: ‹Nnaweerhu! Mango machi rhwakubonaga oli nzara, changwa oli nyoorha, changwa oli muhisi, changwa wabulire emyambalo, changwa oli mulwala, changwa oli omu munyororo, neerhu rhwafundwa kugurhabaala?›<verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />«Mwami nj'abashubiza ntya: ‹Okuli mbabwirire, oku ebi byooshi amango mwabaga murhali mwabijirira oli mudoorho bweneene mw'aba beene beerhu, nyoono nye murhaliiri mwabijirira.›<verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />«Oku buzinda, abo bantu nji baaja ahantu ho buhane bw'esiku n'amango. Aliko abakwaneene boowe, nji baaja omu kalamo k'esiku n'amango.»<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">Akaligi kw'ogufarha n'okuyirha Yeesu</para>
  <para style="r">
    <ref loc="MRK 14:1-2">Mariko 14.1-2</ref>; <ref loc="LUK 22:1-2">Luuka 22.1-2</ref>; <ref loc="JHN 11:45-53">Yohaana 11.45-53</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Yeesu abeere amala kuderha eyo myaazi yooshi, abwira abigirizwa baage ntya: <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />«Muyinji oku hayoorha siku ebiri embere olusiku lukulu lw'ePaasaka luhike. Munayinji oku nyoono Mwene oMuntu nalenganywa yi mbambwe oku musalaaba.»<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Abakulu b'abadaahwa n'abashamuka b'aBayaahudi babuganana emw'omudaahwa mukulu, oyirikwa Kayaafa. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Bajirira Yeesu akaligi k'oku mufarha omu bwibisho yi bamuyirhe. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Aliko baderha ntya: «Rhurhamufarhaga omu olusiku lukulu lw'ePasaka, y'olwamo lurhaba omu lubaga.»<verse eid="MAT 26:5" /></para>
  <para style="s">Omukazi ashiiga Yeesu amarashi oku rhwe</para>
  <para style="r">
    <ref loc="MRK 14:3-9">Mariko 14.3-9</ref>; <ref loc="LUK 7:36-50">Luuka 7.36-50</ref>; <ref loc="JHN 12:1-8">Yohaana 12.1-8</ref></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Yeesu abeere ali omu gishagala ch'eBetaniiya, aja omu nju y'omuntu muguma oyirikwa Simooni. Oyo Simooni aliiri mubenzibenzi. <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />Babeere bali balya, mukazi muguma ayegeera hoofu na Yeesu. Oyo mukazi aligwerhe omukebo<note caller="+" style="f"><char style="fr" closed="false">26.7 </char><char style="ft" closed="false">Ogu mukebo gwabaaga gukwizizwe omu baale ly'akamaro liyirikirwe alubateere.</char></note> guyunjwire amarashi m'agachiiro kanene. Anasheeshera oku rhwe lya Yeesu. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />Abigirizwa ba Yeesu babeere babona ntyo, bagaya bweneene. Baderha ntya: «Girhumire oyu mukazi aheza ama marashi busha? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Ama marashi mankaguzizwe oku gichiiro chinene bweneene, n'efuranga mankagulirwe mo, zagarhabeere abakene!»<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Aliko Yeesu amenya oko kugaya kwabo. Oko kw'arhuma ababaza ntya: «Girhumire mwalunza oyu mukazi ntya? Ka girhali chijiro chinja echi ankolere? <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Abakene baaba haguma nenyu esiku zooshi, sy'aliko nyoono ntaaba haguma nenyu esiku zooshi. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Oyu mukazi anshigire amarashi omu gurheganya oguhambwa kwani. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Okuli mbabwirire oku omu gulu lyooshi, ngasi hantu oMwazi Mwinja nji gwaba guli gwabalwa, nji balema baderha elugulu w'echijiro oyu mukazi ajirire. Elugulu w'oko, oyu mukazi alema ayibukwa.»<verse eid="MAT 26:13" /></para>
  <para style="s">Yuuda ahaana Yeesu</para>
  <para style="r">
    <ref loc="MRK 14:10-11">Mariko 14.10-11</ref>; <ref loc="LUK 22:3-6">Luuka 22.3-6</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Enyuma z'ebyo, muguma omu ntumwa ekumi n'ebiri za Yeesu, oyirikwa Yuuda Isikariyooti, aja emw'abakulu b'abadaahwa. <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />Ababaza ntya: «Bichi mwampa akonva mbahere Yeesu?» Bamuha bicheri makumi masharhu by'efuranga<note caller="+" style="f"><char style="fr" closed="false">26.15 </char><char style="ft" closed="false">Bicheri makumi masharhu byaliiri furanga balemaga bahonga oku muja enka yayirhaga. Osome Lubunguluko 21.32.</char></note>. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Gurhengera amo mango, Yuuda arhondera gushonda obulyo abaheereza mo Yeesu.<verse eid="MAT 26:16" /></para>
  <para style="s">Yeesu alya ePaasaka haguma n'abigirizwa baage</para>
  <para style="r">
    <ref loc="MRK 14:12-17">Mariko 14.12-17</ref>; <ref loc="LUK 22:7-14">Luuka 22.7-14</ref>; <ref loc="JHN 13:21-30">Yohaana 13.21-30</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Olusiku lurhanzi lw'esiku y'edinye y'emigati nzira chachu, abigirizwa ba Yeesu bamuhikira n'okumubaza ntya: «Ngahe oshondere rhugurheganyizage ebiryo by'ePaasaka?» <verse eid="MAT 26:17" /><verse number="18" style="v" sid="MAT 26:18" />Yeesu abashubiza ntya: «Muje omu gishagala, emw'omuntu muguma. Oyo muntu, mumubwire ntya: ‹oMwigiriza aderhere oku egihe aliiri alinga chiri hoofu. Leero, omu mwawe mwalira ePaasaka haguma na bigirizwa baage.›» <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Abo bigirizwa bajira nk'oku Yeesu abarhegekaga, barheganya ebiryo by'ePaasaka.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Lyabeere golo, Yeesu ayikala kulya ebiryo haguma n'entumwa zaage ekumi n'ebiri. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Babeere bali balya, Yeesu aderha ntya: «Okuli, mbabwirire oku muguma mu mwabo andenganya.» <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />Ogo mwazi gwagayisa bweneene abigirizwa. Elugulu w'oko, ngasi muguma arhondera kumubaza ntya: «Nnaweerhu! Ka nyoono?» <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />Yeesu abashubiza ntya: «Ola warhobeza chaligumiza naani omu mbale, ye wandenganya. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Nyoono Mwene oMuntu naafa gukulikirana nk'oku biyandikirwe elugulu waani omu Mandiko Matagatiifu. Aliko, buhanya oku muntu wandenganya! Oyo muntu, kwakabeere kwinja oku yeewe gurhaburhwa!»<note caller="+" style="f"><char style="fr" closed="false">26.24 </char><char style="ft" closed="false">Osome Nanga 22 na Isaya 53.</char></note><verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Yuuda wamulenganya, naye abaza ntya: «Mwigiriza! Ka nyoono?» Yeesu amushubiza ntya: «Wooyo wenyine waderhere!»<verse eid="MAT 26:25" /></para>
  <para style="s">Ebiryo by'okuyibuka Nnaweerhu</para>
  <para style="r">
    <ref loc="MRK 14:22-25">Mariko 14.22-25</ref>; <ref loc="LUK 22:15-20">Luuka 22.15-20</ref>; <ref loc="1CO 11:23-26">1 Bakorinto 11.23-26</ref></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Babeere bachiri baalya, Yeesu arhoola omugati, akuuza Nnamahanga. Aguchagulanga, aguha abigirizwa baage. Aja ababwira ntya: «Murhoole ogu mugati mugulye, kwenge guno guli mubiri gwaani.» <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />Enyuma z'ebyo, arhoola engumbu, akuuza Nnamahanga. Ayiha bo n'okubabwira ntya: «Munywe ko mweshi, <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />kwenge eyila, eri shagama yaani, eyerekeene egihango Nnamahanga ajirire n'olubaga lwage. Eyo shagama yasheshekala omu guchungula bantu banene, yi bababalirwe ebyaaha byaabo. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Mbabwirire oku gurhengera zeene, ntagachinywa divaayi guhika olusiku nji nanywa empyaahya haguma nenyu omu Bwami bwa Daarha.»<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Babeere bamala kuyimpa enyimpo, bazamuukira oku musozi gw'<char style="w" lemma="Muzeituuni">eMizeyituuni</char>.<verse eid="MAT 26:30" /></para>
  <para style="s">Yeesu abala oku Petero amuhakana</para>
  <para style="r">
    <ref loc="MRK 14:27-31">Mariko 14.27-31</ref>; <ref loc="LUK 22:31-34">Luuka 22.31-34</ref>; <ref loc="JHN 13:36-38">Yohaana 13.36-38</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Yeesu aja abwira abigirizwa baage ntya: «Mu buno budufu, mweshi mwandeka. Kwenge biyandikirwe omu Mandiko Matagatiifu ntya:</para>
  <para style="q1" vid="MAT 26:31">‹Nayirha omungere w'entaama,</para>
  <para style="q1" vid="MAT 26:31">n'obuso bw'ezo ntaama nji bwashandaazwa.›<note caller="+" style="f"><char style="fr" closed="false">26.31 </char><char style="ft" closed="false">Osome Zakariya 13.7.</char></note><verse eid="MAT 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 26:32" />«Aliko, amango nji nafuuka, nji nabarhanga eGalilaaya.»<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Petero amubwira ntya: «Chiro akaba abandi booshi bagakuleka, nyoono ntagakuleka chiro n'ehityu!»<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Yeesu amubwira ntya: «Okuli nkubwirire oku mw'obu budufu bwa zeene, embere oluhazi lubike, waaba eyi wamampakana gasharhu.»<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Petero amubwira ntya: «Akaba bimpemere gufiira haguma naawe, nyemereere. Aliko ogukulahira, ntakagala chiro n'ehityu!» Abandi bigirizwa nabo booshi baderha ntyo.<verse eid="MAT 26:35" /></para>
  <para style="s">Yeesu asalira Nnamahanga eGetesemaani</para>
  <para style="r">
    <ref loc="MRK 14:32-42">Mariko 14.32-42</ref>; <ref loc="LUK 22:39-46">Luuka 22.39-46</ref></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Enyuma z'ebyo, Yeesu n'abigirizwa baage baja hantu haguma hayirikwa Getesemaani. Babeere bahika ahoola, Yeesu ababwira ntya: «Murhange muyikale hano, oku ndi naaja halira gusaliira.» <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Yeesu agenda haguma na Petero na bagala babiri ba Zebedayo. Arhondera kuyunva amaganya n'okubabala bweneene omu murhima. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Ava ababwira ntya: «Mbabezwe bweneene omu murhima hoofu n'ogufa! Mubeere hano, munatarame haguma naani.»<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Yeesu aja ashegera ahambere hityu, ayinama guhisa amalanga oku daho. Arhondera gusaliira omu kuderha ntya: «Daarha! Akaba byankagalika, eyi ngumbu y'amalibuko oyigeze hale naani! Aliko nachiro ntyo, birhabaaga nk'oku nyoono nshondere, sy'aliko obulonza bwawe bo bujirikanage.»<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Enyuma, Yeesu agaluka halaala alekaga bala bigirizwa basharhu. Ababugaana bajire ero. Aja abwira Petero ntya: «Murhagalire gutarama haguma naani chiro saa nguma? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Mutarame munasalire yi murhajaaga omu bigeregezo, bulaala omurhima gukomeere, sy'aliko omubiri guli muzamba.»<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Yeesu ashuba kubaleka kandi, agenda gusaliira obwakabiri, aderha ntya: «Daarha wee! Akaba eyi ngumbu y'amalibuko erhakagala kugera hale naani buzira nyoono kuyinywa ko, obulonza bwawe buje bwajirika!»<verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />Abeere agaluka emunda abigirizwa baage baliiri, ababugaana kandi bajire ero, kwenge ameesho maabo maliiri malemereerwe n'ero. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Yeesu ashuba kubaleka anaja gusaliira Nnamahanga obwagasharhu. Asaliira kula ko na kula.<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />Oku buzinda, agaluka emunda abigirizwa baage bali. Ababwira ntya: «Muchilyamire munali mwahumuuka? Mulole! Egihe chahikire, bunoola nyoono Mwene oMuntu nahirwa omu maboko m'abanyabyaaha. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Muyimange, rhugende! Tala, ola wandenganya yoono akola ali hoofu!»<verse eid="MAT 26:46" /></para>
  <para style="s">Yeesu afarhwa</para>
  <para style="r">
    <ref loc="MRK 14:43-50">Mariko 14.43-50</ref>; <ref loc="LUK 22:47-53">Luuka 22.47-53</ref>; <ref loc="JHN 18:2-11">Yohaana 18.2-11</ref></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Yeesu abeere achiri aderha, ho n'aho Yuuda, muguma w'omu ntumwa zaage ekumi n'ebiri ahika. Oyo Yuuda aliiri haguma n'echigusho chinene ch'abantu baligwerhe engoorho n'enkoni. Abo bantu baliiri barhumirwe n'abakulu b'abadaahwa, n'abashamuka b'aBayaahudi. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Yuuda, ola wahanaga Yeesu, aliiri abayerekere echimenyeso akolesa. N'echo chimenyeso chaliderheere ntya: «Ola nahoobera, eyi yooyo, mumufarhe!»<verse eid="MAT 26:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49" />Ho n'aho, Yuuda ayegeera Yeesu. Amubwira ntya: «Mahyo, Mwigiriza!» Oku buzinda amuhoobera. <verse eid="MAT 26:49" /><verse number="50" style="v" sid="MAT 26:50" />Aliko Yeesu amubwira ntya: «Ego mwira waani! Echakuleerhere, ochijire.» Abo bantu baja bafarha Yeesu, banamushweka.<verse eid="MAT 26:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 26:51" />Muntu muguma omu baliiri haguma na Yeesu, ashoshoola engoorho yaage. Ava ayibanda omuja w'omudaahwa mukulu, amushinjibula ogurhwi. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Aliko Yeesu amubwira ntya: «Galula engoorho yaawe omu luuba lwayo. Kwenge booshi banalwa omu gukoleesa engoorho, nabo nji bayirhwa n'engoorho. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Wooyo, orhenji oku nakagala guhema Daarha okw'antabaale, ho n'aho anantumira abamalahika banene kulusha bigusho ekumi na bibiri?<note caller="+" style="f"><char style="fr" closed="false">26.53 </char><char style="ft" closed="false">Ebyo bigusho ekumi na bibiri byaligwerhe hoofu bihumbi makumi gali mushanvu na bibiri by'abasoda.</char></note> <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Aliko nk'antumiire bo, leero gurhe aMandiko Matagatiifu makayeenera? Amo Maandiko maderhere oku eyi myaazi yooshi, ekwaneene kuba ntya!»<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Yeesu aja abaza abo bantu ntya: «Girhumire mwayinja nkufarha n'engoorho n'enkoni, nka kulaala abantu baaja gufarha egishumuusi? Oku ngasi lusiku naliiri nayikala omu Nju ya Nnamahanga eyi ndi nayigiriza abantu, aliko murhanfarhaga. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Ebi byooshi byajirikeene, y'ebinwa byooshi biyeenere ebi abaleebi baderhaga omu Mandiko Matagatiifu.»</para>
  <para style="p" vid="MAT 26:56">Oku buzinda, abigirizwa baage booshi bamuleka, balibirha.<verse eid="MAT 26:56" /></para>
  <para style="s">Yeesu aburana embere z'akabuga gakulu k'aBayaahudi</para>
  <para style="r">
    <ref loc="MRK 14:53-65">Mariko 14.53-65</ref>; <ref loc="LUK 22:54-55">Luuka 22.54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:12-24">Yohaana 18.12-24</ref></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Abo bantu bafarhaga Yeesu, bamuheeka emw'oMudaahwa Mukulu oyirikwa Kayaafa. Eyoola y'abigiriza b'amarhegeko n'abashamuka b'aBayaahudi balichigushire.<figure style="fig" alt="Jésus comparait" file="WA03918b.tif" size="col" ref="26.57">Yeesu aburana embere za Kayaafa</figure> <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Aliko Petero aliiri akulikira Yeesu omu bwibisho guhika aja omu chibuga ch'enju y'oMudaahwa Mukulu. Ayikala embuga haguma n'abalanzi y'abone oku byaaba.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />Abo bakulu b'abadaahwa n'abashamuka booshi b'akabuga gakulu k'aBayaahudi, bashonda obuhamiiriza bw'obubeeshi elugulu wa Yeesu yi bamuyirhe. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Bantu banene bayinja guhamiiriza ebinwa by'obubeeshi elugulu waage. Chiro akaba ntyo, babula echinwa bakagala kuyimangira ko yi bamuyirhe.</para>
  <para style="p" vid="MAT 26:60">Oku buzinda, bantu babiri bahika <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />n'okuderha ntya: «Oyu muntu aderhere ntya: ‹Nangashanda eNju ya Nnamahanga n'ogushuba kuyiyumbaka omu siku esharhu.›»<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />oMudaahwa Mukulu aja ayimanga n'okubaza Yeesu ntya: «Nta chinwa n'echiguma washubize kw'ebi binwa byooshi aba bantu bagusidakire ko?» <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Aliko Yeesu agisirira. Oyo Mudaahwa Mukulu ashuba kumubwira ntya: «Nguhemere oku ziino lya Nnamahanga ozeene, olahire akaba arhali wooyo we Kirisitu, Mugala wa Nnamahanga!» <verse eid="MAT 26:63" /><verse number="64" style="v" sid="MAT 26:64" />Yeesu amushubiza ntya: «Wooyo wenyine wamaderha ko! Leero mbabwirire oku gurhengera buno, mwabona gurhe nyoono Mwene oMuntu nyikeere ekulyo kwa Nnamahanga w'obuhashe. Na ntyo, mwabona gurhe nyinjire gurhenga empingu omu bichu.»<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Oyo mukulu w'abadaahwa, abeere ayunva ntyo, achiberera kw'emyambalo. Aderha ntya: «Oyu muntu adukangire Nnamahanga! Buhamiiriza buchi rhwagishonda? Mulole! Ka murhayunvirhe mwenyine oku amadukanga Nnamahanga? <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Gurhe si mubwene?» Nabo, bamushubiza ntya: «Akwaneene afe!»<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Baguma omu bo, bamuchiira omu malanga n'okumushuurha ebifundo. N'abandi bamushuurha ebigalo, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />n'okumubwira ntya: «Wooyo Kirisitu, leeba nde wagushurhire!»<verse eid="MAT 26:68" /></para>
  <para style="s">Petero alahira Yeesu</para>
  <para style="r">
    <ref loc="MRK 14:66-72">Mariko 14.66-72</ref>; <ref loc="LUK 22:56-62">Luuka 22.56-62</ref>; <ref loc="JHN 18:17">Yohaana 18.17</ref>,<ref loc="JHN 18:25-27">25-27</ref></para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Mw'ebyo bishanji, Petero aliiri ayikeere embuga. Mukozi muguma w'omukazi amuyegeera, anamubwira ntya: «Naawe, waliiri haguma na Yeesu w'eGalilaaya.» <verse eid="MAT 26:69" /><verse number="70" style="v" sid="MAT 26:70" />Aliko Petero ahakana embere z'abantu booshi baliiri ahoola, aderha ntya: «Ebyo washonda kuderha, ntabimenyere!»<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />Enyuma z'ebyo, Petero arhenga ahoola, aja ebwa mulyango g'olugo. Owindi mukozi muguma w'omukazi naye amubona, abwira abantu baliiri ahoola ntya: «Oyu muntu, aliiri haguma na Yeesu w'eNazareeti.» <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />Aliko Petero ashuba kulahira ntya: «Mpakanire okw'oyo muntu ntamuyinji!»<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Enyuma z'ebishanji bigeeke, abantu baliiri baliyimangire aho, bayegeera Petero n'okumubwira ntya: «Okuli, oli muguma waabo, kwenge oluderho lwawe luchiyerekeene bwinja!» <verse eid="MAT 26:73" /><verse number="74" style="v" sid="MAT 26:74" />Petero ava arhondera kuderha ntya: «Akaba nderhere obubeeshi, nvumwe! Nahakanire okw'oyo muntu, nyoono ntamuyinji!» Ho n'aho oluhazi lwabika.<verse eid="MAT 26:74" /></para>
  <para style="p">
    <verse number="75" style="v" sid="MAT 26:75" />Petero ava ayibuka ebinwa Yeesu amubwiraga ntya: «Embere oluhazi lubike, waaba eyi wamampakana gasharhu okw'orhanyinji.» Aja ahuluka n'ogurhondera kulaka n'amaganya manene.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">Yeesu aheekwa embere za Pilaato</para>
  <para style="r">
    <ref loc="MRK 15:1-2">Mariko 15.1-2</ref>; <ref loc="LUK 22:66">Luuka 22.66</ref>; <ref loc="LUK 23:1">23.1</ref>; <ref loc="JHN 18:28">Yohaana 18.28</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Bwabeere bwacha, abakulu b'abadaahwa booshi haguma n'abashamuka b'aBayaahudi, bajira akaligi kw'okuyirha Yeesu. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Echo charhuma bamumina, bamuheeka baaja kumuhaana emw'omurhegesi w'aBarooma oyirikwa Pilaato.<verse eid="MAT 27:2" /></para>
  <para style="s">Yuuda achiniga</para>
  <para style="r">
    <ref loc="MRK 1:18-19">Mariko 1.18-19</ref></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Yuuda walenganyaga Yeesu, abeere abona oku Yeesu ahanirwe ogufa, ababala bweneene omu murhima. Arhoola bila bicheri makumi masharhu by'efuranga, aja kubigalulira abakulu b'abadaahwa n'abashamuka b'aBayaahudi. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />Ababwira ntya: «Najirire echaaha omu guhaana omuntu orhagwerhe bubi oku ayirhwe.» Nabo bamushubiza ntya: «Ebyo birhachirhuloleere, bikola byawe ebyo!»<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Yuuda akabula ebyo bicheri by'efuranga omu Nju ya Nnamahanga. Ava aja guchiniga.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />Abakulu b'abadaahwa barholagula ebyo bicheri by'efuranga, baderha ntya: «Gukulikirana n'eRhegeko lyeerhu, birhahemerwe kubiika ezi furanga omu sanduku y'eNju ya Nnamahanga, kwenge ziri ngulo yashesheere eshagama.»<verse eid="MAT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 27:7" />Elugulu w'echo, bayunviikana oku bazikolese omu kugula eshwa ly'omubumbi muguma, yi baleme bahamba mo abahiisi. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Echo chogirhuma elyo shwa lihamagalwa «Shwa ly'eshagama» guhika zeene.<verse eid="MAT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9" />Ntyo, ebinwa byayenera, eby'omuleebi Yeremiya aderhaga ntya: «Barhoolaga bicheri makumi masharhu by'efuranga, gukulikirana n'engulo abanyaIsraheeli bayunvikanaga elugulu w'erhwe lyaage. <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />Bagula eshwa ly'omubumbi muguma nk'oku Nnaweerhu abaaga ambwirire.»<note caller="+" style="f"><char style="fr" closed="false">27.10 </char><char style="ft" closed="false">Osome Zakariya 11.12-13; Yeremiya 19.1-13, 32.6-9.</char></note><verse eid="MAT 27:10" /></para>
  <para style="s">Pilaato aburanya Yeesu</para>
  <para style="r">
    <ref loc="MRK 15:2-5">Mariko 15.2-5</ref>; <ref loc="LUK 23:2-5">Luuka 23.2-5</ref>,<ref loc="LUK 23:9-10">9-10</ref>; <ref loc="JHN 18:29-38">Yohaana 18.29-38</ref></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Omurhegesi Pilaato abeere ali aburanya Yeesu, amubaza ntya: «Nka wooyo we mwami w'aBayaahudi?» Yeesu amushubiza ntya: «Wooyo we waderhere ko!»<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Enyuma z'aho, abakulu b'abadaahwa n'abashamuka b'aBayaahudi, barhondera kulega Yeesu, aliko ntaacho ashubiize. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Echo charhuma Pilaato ashuba kumubaza ntya: «Ebyo binwa byooshi bali bakulega ko, orhali wabiyunva?» <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Aliko mw'ebyo byooshi, ntaacho Yeesu amushubize. Oko kwarhuma, oyo murhegesi asoomerwa bweneene.<verse eid="MAT 27:14" /></para>
  <para style="s">Yeesu ahanirwa ogufa</para>
  <para style="r">
    <ref loc="MRK 15:6-14">Mariko 15.6-14</ref>; <ref loc="LUK 23:13-23">Luuka 23.13-23</ref>; <ref loc="JHN 18:39-40">Yohaana 18.39-40</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Ngasi lusiku lukulu lw'ePaasaka, omurhegesi alemaga alikuulira olubaga muntu muguma lwaliiri lusiimire. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Mw'ezo siku, haliiri muntu muguma oyirikwa Baraaba, abaaga ashwekerwe omu munyororo. Oyo Baraaba alimenyikeene bweneene elugulu w'obubi bwage.<verse eid="MAT 27:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 27:17" />Abantu babeere bachigushire haguma, Pilaato ababaza ntya: «Nde mushondere mbashwekulire? Baraaba changwa Yeesu oyirikwa Kirisitu?» <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Abazaga ntyo, kwenge aliyinji oku bamulerhere Yeesu elugulu w'obongwa.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Pilaato abeere amayikala oku ntebe yaage y'oguchira ko eshinja, mukaage amurhumira entumwa ederhere ntya: «Orhachihiraga omu myaazi y'oyu muntu okwaneene! Kwenge omu budufu bwa zeene, naloorhaga elugulu waage. Ebyo biloorho byali mbabeze bweneene!»<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Aliko abo bakulu b'abadaahwa n'abashamuka b'aBayaahudi bayoohya echigusho ch'abantu oku baheme Baraaba ashwekuulwe, na Yeesu ayirhwe.<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />Pilaato ashuba kubabaza ntya: «Nde, mw'aba bantu babiri, mushondere mbashwekuulire?» Nabo bamushubiza ntya: «Baraaba.» <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" />Pilaato ashuba kubabaza ntya: «Gurhe njirage oyu Yeesu oyirikwa Kirisitu?» Booshi, oku chaligumiza bashubiza ntya: «Abambwe oku musalaaba!» <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />Pilaato ashuba kubabaza ntya: «Bubi buchi ajirire?» Aliko bagendekera kuderha bweneene ntya: «Abambwe oku musalaaba!»<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Pilaato abeere abona oku nta chinwa chanka chiyunvikana gukulikirana n'okw'olwamo yilwaluga, arhoola amenji, akalaba efune zaage embere z'abantu, aderha ntya: «Eshagama y'oyu muntu erhabaga oku rhwe lyaani! Ebe oku rhwe lyenyu!»<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Abantu booshi bashubiza ntya: «Neechi, eshagama yaage ebe oku rhwe lyeerhu n'oku ly'abaana beerhu!»<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Pilaato ava abashwekuulira Baraaba anarhegeka oku Yeesu ashuurhwe enkoni. Oku buzinda, abaha ye y'abambwe oku musalaaba.<verse eid="MAT 27:26" /></para>
  <para style="s">Abasoda bashekera Yeesu</para>
  <para style="r">
    <ref loc="MRK 15:16-20">Mariko 15.16-20</ref>; <ref loc="LUK 23:11">Luuka 23.11</ref>; <ref loc="JHN 19:2-3">Yohaana 19.2-3</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Enyuma z'ebyo, abasoda b'omurhegesi Pilaato, baheeka Yeesu omu kampi kaabo. Echigusho chooshi ch'abasoda, chaava chamugorha. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Abo basoda bamuhogola emyambalo yaage banamuyambisa egishuuli ch'omuduku. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Baluka echimene n'emirhabi y'emishaaki, bamuyambisa cho oku rhwe. Bamufumbanya olusheke omu fune y'okulyo. Baja balema bafukama embere zaage omu kumushekera ntya: «Mahyo, Mwami w'aBayaahudi!» <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Bamuchiira ko, baava barhoola lula lusheke n'ogurhondera kumushurha lo oku rhwe.<verse eid="MAT 27:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 27:31" />Amango babaaga bamaamala kumushekera, bamuhogola chila gishuuli, bashuba kumuyambisa ela myambalo yaage. Oku buzinda, bamuheeka kumubamba oku musalaaba.<verse eid="MAT 27:31" /></para>
  <para style="s">Yeesu abambwa oku musalaaba</para>
  <para style="r">
    <ref loc="MRK 15:21-32">Mariko 15.21-32</ref>; <ref loc="LUK 23:26-43">Luuka 23.26-43</ref>; <ref loc="JHN 19:16-24">Yohaana 19.16-24</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Abo basoda babeere bali barhenga omu gishagala, babuganana n'omuntu muguma w'omu gishagala ch'eKureene oyirikwa Simooni. Oyo Simooni bamurhegeka aheeke omusalaaba gwa Yeesu.<verse eid="MAT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 27:33" />Babeere bahika ahantu hayirikwa ''Goligoota'', kw'okuderha «Hantu h'empanga», <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />baaha Yeesu edivaayi egwerhe endulo. Aliko abeere ayigonja ko, alahira kuyinywa.<verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />Abo basoda babeere bamala kumubamba oku musalaaba, bagabaana emyambalo yaage omu kuyiyeshera esimbi.<note caller="+" style="f"><char style="fr" closed="false">27.35 </char><char style="ft" closed="false">Osome Nanga 22.18.</char></note> <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Oku buzinda, bayikala ahoola, balanga Yeesu.<verse eid="MAT 27:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 27:37" />N'elugulu w'erhwe lyaage, bahira ho ehipaho hiyandikirwe ko ebinwa byarhumaga bamuhana. Ebyo binwa byaliiri biderhere ntya: «Oyu ye Yeesu, Mwami w'aBayaahudi.»<verse eid="MAT 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 27:38" />Bishumuusi bibiri na byo byaliiri bibambirwe oku misalaaba haguma na Yeesu, muguma oku lunda lw'ekulyo n'owindi oku lunda lw'ekulembe.<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />Abantu baliiri balenga aho, baliiri badukanga Yeesu, n'okuzunguza amarhwe maabo. <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />Bali baderha ntya: «Wooyo, we washondaga gushanda eNju ya Nnamahanga, onashube kuyiyumbaka omu siku esharhu! Leero, akaba onali Mugala wa Nnamahanga, ogichungule wenyine, ochiyandagaze kw'ogu musalaaba!»<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Abakulu b'abadaahwa n'abigiriza b'amarhegeko haguma n'abashamuka b'aBayaahudi, nabo bamushekera ntya: <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />«Aliiri achungula abandi bantu, aliko leero yeewe yenyine agambirwe guchichungula! K'arhali yeewe ye Mwami w'abanyaIsraheeli? Ajage achiyandagaza kw'ogu musalaaba, yi neerhu rhumuyemeere! <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Aliiri alangalira Nnamahanga, na kandi aliiri aderha oku ali Mugala waage. Leero akaba oyo Nnamahanga anamusiima, amuchungule!»<verse eid="MAT 27:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44" />Bila bishumuusi byaliiri bibambirwe oku misalaaba eburhambi bwa Yeesu, na byo byaliiri byamushekera. <figure style="fig" alt="Jésus sur la croix" file="WA03926b.tif" size="col" copy="Graham Wade" ref="27.44">Yeesu oku musalaaba</figure><verse eid="MAT 27:44" /></para>
  <para style="s">Ogufa kwa Yeesu</para>
  <para style="r">
    <ref loc="MRK 15:33-39">Mariko 15.33-39</ref>; <ref loc="LUK 23:44-48">Luuka 23.44-48</ref>; <ref loc="JHN 19:28-30">Yohaana 19.28-30</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Enyuma z'ebyo, omwizimya gwaba oku gulu lyooshi, gurhengera midi guhika aha saa mwenda. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Zabeere hoofu saa mwenda, Yeesu alika omulenge munene, aderha ntya: «Eloyi! Eloyi! Laama sabakatani!» Kw'okuderha ntya: «Nnamahanga waani! Nnamahanga waani! Girhumire wandekeerera?»<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Bantu baguma baliiri ahoola, babeere bayunva oko, baderha ntya: «Ali ahamagala Eliya.» <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Ho n'aho, muguma omu bo, alibirha kuja kuleerha echiraka, achivuvuliza omu divaayi y'enkala. Echo chiraka agishwekera oku lusheke, anachizamuulira Yeesu y'anywe. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Aliko abandi baderha ntya: «Muleke, rhulole akaba Eliya ayinja kumuchungula!»<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Aliko Yeesu ashuba kulika omulenge munene, arhenga m'omuuka.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Ho n'aho, omwenda g'olusika gwalimanikirwe omu Nju ya Nnamahanga, gwasharhuka mo bisharhe bibiri, gurhengera enyanya guhika eshiishi. Egihugo chagera m'omusisi, ebirimbi byabereka. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Eshinda nazo zagichinguula, n'abakwaneene banene babaaga bafiire miira, bafuuka. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Barhenga omu shinda, n'enyuma z'ogufuuka kwa Yeesu, abo bantu baaja omu gishagala gitagatiifu ch'eYerusaleema, n'abantu banene bababona ko.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Omukulu w'abasoda haguma n'abasoda baage baliiri balanga Yeesu, babeere babona omusisi gwagera omu gihugo, na kw'ebyo bindi byooshi byahulukiraga, bayuubaha bweneene. Baja baderha ntya: «Okuli oyu muntu aliiri Mugala wa Nnamahanga!»<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Hale bugeeke n'ahoola, haliiri abakazi banene, baliiri balangiira ebyo byooshi. Abo bakazi bo balikulikire Yeesu gurhengera eGalilaaya, bo banaliiri bamukolera. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Ahagarhi kaabo, haliiri Mariya w'eMagadala, Mariya nyina wa Yakobo na Yozefu haguma na nyina wa beene Zebedayo.<verse eid="MAT 27:56" /></para>
  <para style="s">Yeesu ahambwa</para>
  <para style="r">
    <ref loc="MRK 15:42-47">Mariko 15.42-47</ref>; <ref loc="LUK 23:50-56">Luuka 23.50-56</ref>; <ref loc="JHN 19:38-42">Yohaana 19.38-42</ref></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Lyabeere golo, hahulukira muntu muguma w'omuchire w'omu gishagala ch'eArimateeya, oyirikwa Yozefu. Oyo Yozefu, naye aliiri mwigirizwa wa Yeesu. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Ahikira Pilaato y'amuheme omubiri gwa Yeesu. Pilaato ava arhegeka oku bamuhe go. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Yozefu arhoola ogo mubiri, anaguzingira omu daraape lihyaahya <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />Ahamba go omu shinda yaage mpyaahya. Eyo shinda, alibeere ayichire omu baale. Ahirikira ebaale linene oku mulyango gw'eyo shinda, oku buzinda achigendera. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Mw'ebyo bishanji, Mariya w'eMagadala n'ola windi Mariya, baliiri bayikeere ahoola, embere z'eyo shinda.<verse eid="MAT 27:61" /></para>
  <para style="s">Abasoda balanga eshinda ya Yeesu</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Olo lusiku lo lwaliiri lusiku l'oguchirheganya oku Saabato. Abakulu b'abadaahwa n'<char style="w" lemma="Bafarisaayo:">aBafarisaayo</char> baaja emwa Pilaato, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />bamubwira ntya: «Waliha! Rhuyibukire oku ela ndyaalya y'omulume, egihe yalichiri ngumaguma, yaliderhere ntya: ‹Enyuma z'ogufa kwani, nafuuka oku lusiku lwa gasharhu.› <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Cho girhumire, orhegeke abasoda balange eshinda guhika ezo siku esharhu, y'abigirizwa baage barhayinjaga kuzimba omubiri gwage n'okubwira abantu oku afuukire gurhenga omu bafu. Na ntyo, obo bubeeshi bwanaba bubi kulusha obwambere.» <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />Pilaato ababwira ntya: «Mugwerhe abasoda b'obulanzi! Mubaheeke ebwa shinda, yi baaje kuyilanga nk'oku mushondere.»<verse eid="MAT 27:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66" />Oku buzinda, barhenga ahoola, baaja ebwa shinda. Bahamika lila baale lifukire eshinda, banahira abalanzi ahoola b'okuyilanga.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Ogufuuka kwa Yeesu</para>
  <para style="r">
    <ref loc="MRK 16:1-8">Mariko 16.1-8</ref>; <ref loc="LUK 24:1-11">Luuka 24.1-11</ref>; <ref loc="JHN 1:11-18">Yohaana 1.11-18</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Olusiku lw'eSaabato lwabeere lwagera, emiseke bucha eseezi ly'olusiku lurhanzi lw'eboso, Mariya w'eMagadala haguma n'ola windi Mariya, baaja gurhangula eshinda ya Yeesu. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Ho n'aho haaba omusisi munene omu gihugo. Malahika muguma wa Nnaweerhu ayandagala gurhenga empingu, ayegeera eshinda. Ahirika lila baale eburhambi, anayikala oku lyo. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Oyo malahika alibaraganyize nka mubaraganyo n'emyambalo yaage yali myeeru bweneene nka lubula. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Abo balanzi b'eshinda babeere babona ebyo, bayuubaha bweneene. Bahinda emisisi guhika egihe baaba nka bafu.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />Oyo malahika abwira abo bakazi ntya: «Mwabo, murhayuubahaga, kwenge nyinji oku muli mwashonda Yeesu wabambwaga oku musalaaba. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Arhachiri hano! Afuukire nk'oku abaaga aderhere. Muyinje, muchilolere aha baliiri bamulyamize. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Leero, mugende jubaajuba kubwira abigirizwa baage oku afuukire, anabarhangire miira eGalilaaya. N'eyo munda yi mwamubonera ko. Ebi binalishondere kubabwira!» <figure style="fig" alt="Jesus est ressuscité" file="WA03930b.tif" size="span" copy="Graham Wade" ref="28.7">Yeesu afuukire</figure><verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Abo bakazi baja barhenga ebwa shinda, eyi bagwerhe obuuba, aliko baliiri bashagalukire bweneene. Balibirha kuja kubwira abigirizwa ba Yeesu ogo mwazi.<verse eid="MAT 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9" />Ho n'aho, Yeesu ahulukira bala bakazi, anabalamusa ntya: «Mahyo!» Bamuyegeera, bamugwarha amagulu n'okumuharamya. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Oku buzinda, Yeesu ababwira ntya: «Murhayuubahaga! Muje kubwira beene beerhu oku baaje eGalilaaya. N'eyo munda yi bambonera ko.»<verse eid="MAT 28:10" /></para>
  <para style="s">Abalanzi b'eshinda babala elugulu y'obufuuke bwa Yeesu</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Abo bakazi babeere bachiri bagenda, basoda baguma omu baliiri kulanga eshinda, baaja omu gishagala kubalira abakulu b'abadaahwa emyaazi yooshi yabeere. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Bala bakulu b'abadaahwa bachigusha haguma n'abashamuka b'aBayaahudi yi barhoole omugambi. Baheereza bala basoda efuranga zinene, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />bababwira ntya: «Mwabo mwalema mwaderha ntya: ‹Abigirizwa baage baliyinjire kumuzimba obudufu eyi rhulyaamire.› <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Nk'omurhegesi Pilaato ayunvire ogu mwazi, rhwabo rhwenyine rhwaganiira haguma naye n'okumuyemeeza byooshi byabeere yi ntaacho chibi chibahikirage.» <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Bala basoda barhoola ezo furanga, banajira nk'oku bababwiraga. N'ogu mwazi gwayandaala omu Bayaahudi guhika zeene.<verse eid="MAT 28:15" /></para>
  <para style="s">Yeesu arhuma abigirizwa baage omu kaasi</para>
  <para style="r">
    <ref loc="MRK 16:14-18">Mariko 16.14-18</ref>; <ref loc="LUK 24:36-49">Luuka 24.36-49</ref>; <ref loc="JHN 20:19-23">Yohaana 20.19-23</ref>; <ref loc="ACT 1:6-8">Bijiro 1.6-8</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Enyuma z'ebyo, abigirizwa ekumi na muguma ba Yeesu, baaja eGalilaaya. Bazamukira oku gula musozi Yeesu abaaga abayerekere. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Babeere bamubona, bamuharamya. Aliko baguma omu bo, baganganwa.<verse eid="MAT 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 28:18" />Oku buzinda, Yeesu ayegeera hoofu nabo, ababwira ntya: «Nahabirwe obuhashe booshi omu mpingu n'omu gulu. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Mugende, mujire abantu b'embaga zooshi bigirizwa, mubabatiize oku ziino lya Daarha, ely'oMugala n'elya Muuka-Mutagatiifu. <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />Muleme mwabayigiriza gukenga ebinwa byooshi nabarhegekaga. Munamenye oku nyoono ndi haguma nenyu esiku zooshi guhika oku buzinda bw'egulu.»<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>