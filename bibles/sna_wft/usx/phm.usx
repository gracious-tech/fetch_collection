<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Kuturikihwa kwoBhaibheri muchiKorekore</book>
  <para style="h">Firimoni</para>
  <para style="toc1">Tsamba raPhauro kuna Firimoni</para>
  <para style="toc2">Firimoni</para>
  <para style="toc3">Firim</para>
  <para style="mt2">Tsamba raPhauro kuna</para>
  <para style="mt1">FIRIMONI</para>
  <para style="imt">Kuwidzira</para>
  <para style="ip">Tsamba ripfupi raFirimoni ridonyohwa noNhumwa Phauro (Firimoni 1:1)</para>
  <para style="ip">Phauro anga ari mutorongo paadorinyora, zvinoreva kuti anogona kunge waiva ari kuRoma. Zvino kana waiva kuRoma saka zvinoreva kuti tsamba rakareri ridonyohwa mumakore anenge makumi matanhatu noribodzi mumasure mokuzvahwa kwaKhirisitu, inova nguwa ibodzibodziyo yaadonyora vaKorose.</para>
  <para style="ip">Adonyora tsamba rakareri kumurume anoitiwa Firimoni. Firimoni waiva nhengo yokherekhe uku ari munhu anovaranda vache. Phauro adomunyorera achikumbira kuti areke kuranga Onesimasi muranda wache wanga watiza kubva kuna Firimoni. Pamutemo wovaRoma Firimoni wanga anokodzero yokubaya Onesimasi. Phauro adoshandisa mazvi yokupenzveredza pakukurudzira Firimoni kuti atambire Onesimasi sehama muKhirisitu ndokutoenderera pamberi achipa pfungwa yokuti Onesimasi atendehwe kushanda pabodzi naPhauro (Firimoni 1:13-14).</para>
  <para style="iot">Marongehwo</para>
  <para style="io1">Phauro anomoresa Firimoni (Firimoni 1:1-3)</para>
  <para style="io1">Pakarepo Phauro adodzokumbira adomiririra Onesimasi kuti Firimoni amutambire sehama muna Khirisitu (Firimoni 1:4-21)</para>
  <para style="io1">Phauro anopedzisira nokuisa pachenu chido chache chokumubvakachira nokutumira kumoresa kwache (Firimoni 1:22-25).</para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />Phauro, musungwa nokuda kwaKhirisitu Jesu, naTimoti hama yedu,</para>
  <para style="p" vid="PHM 1:1">Kuna Firimoni mudikani wedu watinoshanda naye <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />naAfiya hanzvadzi yedu nokunaAkipasi muhwi pabodzi naisisu, nokukherekhe iri mumba mako.<verse eid="PHM 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3" />Mutsa norunyararo zvinobva kunaMwari Baba vedu naIshe Jesu Khirisitu.<verse eid="PHM 1:3" /></para>
  <para style="s">Rudo noKutenda kwaFirimoni</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />Ndinotenda Mwari wangu nguwa dzese pandinokurangarira muminamato yangu, <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />ndava ndinonzva zvorudo rako nozvokutenda kwaunako muna Ishe Jesu nokuvatsvene vese, <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />uye ndinonamata kuti kukovera kwako kutenda kusumudzire kuzikana kwozvidonaka zvese zvinova zvedu muna Khirisitu. <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />Nokuti ndidowana mufaro mukuru nokunyaradziwa kubva parudo rako, hama yangu, ndava mwoyo yovatsvene idovandudziwa nokuda kwako.<verse eid="PHM 1:7" /></para>
  <para style="s">Chikumbiro Pamusoro paOnisimo</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />Zvidondodaro, kunyange ndinochivindi muna Khirisitu chokukuraira kuti uite zvinodiwa, <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />asi nondava yokuti ndinokuda ndinotoita zvokukukumbira inipano Phauro, mumiririri<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="fq" closed="false">mumiririri </char><char style="ft" closed="false">yamwe magwaro anoti munhu wakaramba</char></note> pakare musungwa iyezvino nokuda kwaKhirisitu Jesu. <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />Ndinokumbira kwauri nokuda kwomwana wangu, Onesimasi, wandidova baba vache muusungwa hwangu, <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />kare wanga asingakubatsire, asi iyezvino anobatsira tese iwewe nainini.<verse eid="PHM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12" />Ndiri kumutumira kuti adzoke futi kwauri, kunge ndiri kutumira mwoyo wangu chaiwo. <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />Ndaiditsa chaizvo kuti agare neni, kuti andishumire panzvimbo yako pakusungiwa kwangu nokuda kwovhangeri, <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />asi ndanga ndisingade kuita chinhu iwewe usinati wachitendera, kuitira kuti zvidonaka zvaungaite zvireke kuitiwa nokusukumidziwa asi nokuda kwako.<verse eid="PHM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15" />Nokuti pamwe udoparadzanisiwa naye kwokanguwa kadiki kuti udzova naye pakamu nokusingapere, <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />asisiri muranda, asi wava muranda ari nani, hama inodiwa, kunyanya kwandiri nokwauri munyama nomuna Ishe.<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />Saka kana uchinditora semubiyako, mutambire kunge kutambira kwaunondiita inini. <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />Kana zviripo zvaadokutadzira kunyange anochikwerete newe, mbachive changu. <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />Inini, Phauro, ndinonyora zvakarezvi nojanja rangu, ndichazviripa, ndisingataure kuti unochikwerete kwandiri iwewe pachako. <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />Ehe, hama, ndinoda kuwana chinobatsira kubva kwauri muna Ishe. Mutsiridza mwoyo wangu muna Khirisitu.<verse eid="PHM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21" />Mukugutsikana nokutetekera kwako, ndinokunyorera, ndichiziva kuti uchaita zvidopindiridza kukunda zvandinonyaira. <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />Panguwa ibodzibodziyo, ndigadzirire kamuri yovarendo, ndava ndiri kutarisira kuburikidza nominamato yenyu kuperekewa kwamuri.<verse eid="PHM 1:22" /></para>
  <para style="s">Kumoresa kwoKupedzisira</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />Epafurasi musungwa pabodzi naini nokuda kwaKhirisitu ari kukumoresa, <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />naMariko, naArisitako, naDhimasi naRuka, vashandi biyangu.<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />Mutsa waIshe Jesu Khirisitu mbauve nomweya wenyu.<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>