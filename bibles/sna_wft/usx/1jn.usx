<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id">1 JN Kuturikihwa kwoBhaibhiri muchiKorekore</book>
  <para style="h">1 Johwani</para>
  <para style="toc1">Tsamba ra1 Johwani</para>
  <para style="toc2">1 Johwani</para>
  <para style="toc3">1 Joh</para>
  <para style="mt2">Tsamba rokuthanga</para>
  <para style="mt1">raJOHWANI</para>
  <para style="imt">Kuwidzira</para>
  <para style="ip">Tsamba rokuthanga raJohwani ridonyohwa noNhumwa Johwani pamakore yari pakati pomakumi mashano nozana mumasure mokuzvahwa kwaKhirisitu. Johwani haaburike pachenu kuti ndiye munyori, asi chitsauko chokuthanga chinonangidza kuti ipfakazi idoona upenyu nokumuka kwaJesu, (1 Johwani 1:1-3) Mutoo womanyorero yari muna 1 Johwani yanofanana nomanyorero yari muVhangeri ridonyohwa naJohwani. Zvinotendewa kuti Johwani adonyora Vhangeri ridonyohwa naJohwani nomatsamba matatu yanoti, 1 Johwani, 2 Johwani, na3 Johwani paaigara muEfeso.</para>
  <para style="ip">Johwani adonyora tsamba iri kumaKhirisitu vese panguwa kherekhe yaiva nomatambudziko kubva kuchikwata chovanhu chaiitiwa Nositisizimu, zvinoreva Vazivi voZvidosvisvika. Vanhu vakareva vaitenda kuti Jesu wanga ari Mwari adokwana asi asiri munhu chaiye anomuviri wonyama nogazi paanga ari panyika. Nochikonzero chakarechi Johwani anonyora kuti iye ipfakazi idoona upenyu hwaJesu uye kuti manja yache yadobata Jesu (Johwani 1:1-3). Chinangwa chaJohwani pakunyora tsamba rakareri changa chiri chokuita kuti mufaro wache uzazisiwe (1 Johwani 1:4), kudzivirira vatendi kubva pakutadza (1 Johwani 2:1), kudzivirira vatendi kubva padzidziso yomabhwodo (1 Johwani 2:26), nokupasa chokwadi vatendi kuti vadoponesewa (1Johwani 5:13).</para>
  <para style="iot">Marongehwo</para>
  <para style="io1">Johwani anowidzira tsamba rache nokupasa chikonzero chibodzi chaadorinyorera (1 Johwani1:1-4)</para>
  <para style="io1">Anodzotsanangura kuti Mwari ndiye chiedza, futi kuti tinofanira kurarama fanike zvidoitiwa naJesu (1 Johwani 1:5—3:10)</para>
  <para style="io1">Mumasure anotiyeuchidza zvomurairo wokuti tidanane (1Johwani 3:11—5:12)</para>
  <para style="io1">Anopedzisa tsamba rache pana (1Johwani 5:13-21)</para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s">Shoko Roupenyu</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />Izvozviye zvanga zviripo kubva pakuthanga, zvatidonzva nokuona nomeso yedu, zvatidonangara, futi zvatidobata nomanja yedu, zvoshoko roupenyu, <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" />upenyu hudoisiwa pachenu, futi tidohuona, tinopfakaza pamusoro pahwene, tichikuparidzirai upenyu husingapere, hwanga huri muna Baba futi hudodzonangidziwa kwatiri. <verse eid="1JN 1:2" /><verse number="3" style="v" sid="1JN 1:3" />Zvatidoonazvo nokunzva tinokuparidziraiwo, kuti muwadzane naisisu, futi kuwadzana kwakareko mhwedu naBaba noMwanakomana wache, Jesu Khirisitu. <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />Zvakarezvi tiri kuzvinyorera kuti mufaro wedu uzare.<verse eid="1JN 1:4" /></para>
  <para style="s">Mwari Ndiye Chiedza</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />Rakareri ndiro shoko ratidonzva kubva kwaari ratinokuparidzirai, rokuti Mwari ndiye chiedza futi maari hamunai kana norima rese. <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />Kana tichiti tinowadzana naye asi tichitekaira murima, tinenge tichibhwodoka peno, tisingagare muchokwadi, <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />asi kana tichitekaira muchiedza, fanike iye pachake ari muchiedza, tinowadzana pachedu, futi gazi raJesu Mwanakomana wache rinotinatsa pazvitema zvese.<verse eid="1JN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8" />Kana tichiti hatinai zvitadzo, tinenge tichizvinyepera, futi chokwadi hachisi matiri. <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />Kana tikareurira zvitadzo zvedu, iye adotendeka futi adorurama, saka anotiregerera zvitadzo zvedu nokutinatsa pazvese zvisinai kururama. <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />Kana tikati hatinai kutadza, tinomuita womabhwodo, noshoko rache rinenge risiri matiri.<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="s">Khirisitu Mubatsiri Wedu</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />Vana vangu vadiki, ndiri kukunyorerai kuti mureke kutadza, asi pakaita anotadza, tino muretsereri kuna Baba, Jesu Khirisitu, adorurama. <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />Iye pachake ndiye chibairo chinoita kuti zvitadzo zvedu zviregerehwe, aikona zvedu basi, asi zvitadzo zvonyika yese.<verse eid="1JN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3" />Nozvakarezvi tinova nochokwadi chokuti tinomuziva, kana tichichengeta mirairo yache. <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />Wese anoti, “Ndinomuziva,” asi asingaite zvaanoraira, iyeyo ngwomabhwodo, futi chokwadi chinogaraba maari, <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />asi wese anochengeta shoko rache, rudo raMwari ridozara maari. Nozvakarezvi tinoziva kuti tiri maari. <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />Wese anoti anogara maari anofanira kurarama fanike zvidoitiwa naJesu.<verse eid="1JN 2:6" /></para>
  <para style="s">Murairo Mutsva</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />Hama dzangu, ndinonyoraba kwamuri umwe murairo mutsva, asi wokare, murairo wokare ndiro shoko ramudonzva. <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />Kunyange zvidodaipo ndiri kukunyorerai mutemo mutsva, chinova chokwadi maari nomamuri, ndava rima riri kupamwara futi chiedza chochokwadi chaakutovhenekera.<verse eid="1JN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9" />Uyo anoti ari muchiedza asi achizonda hama yache achiri murima wakareyo. <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />Wese anoda hama yache, iyeyo anogara muchiedza, makaremo hamunai chinoguhuna. <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />Asi wese anozonda hama yache, wakareyo ari murima, anotekaira murima, futi anozivaba kwaanoenda, ndava rima ridoputira meso yache.<verse eid="1JN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12" />Ndiri kukunyorerai vana vadiki, ndava zvitadzo zvenyu zvidoregerehwa nopamusaka pozita rache. <verse eid="1JN 2:12" /><verse number="13" style="v" sid="1JN 2:13" />Ndiri kukunyorerai majaha ndava mudokunda adoipa. Ndiri kukunyorerai anababa, ndava munoziva iye wanga aripo kubva pakuthanga.<verse eid="1JN 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 2:14" />Ndinonyora kwamuri vana, ndava munoziva Baba. Ndinonyora kwamuri anababa, ndava munoziva uyo wanga aripo kubva pakuthanga. Ndinonyora kwamuri majaha, ndava mudosimba, apa shoko raMwari rinogara mamuri, futi mudokunda uye adoipa.<verse eid="1JN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />Rekai kuda nyika nozvinhu zviri mairi. Kana umwe akada nyika, rudo raMwari harisi maari. <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />Nokuti zvese zviri munyika zvinoti, kuchiva kwonyama, kuchiva kwomeso nokuzvikudza pakurarama zvinobvaba kuna Baba asi zvinobva munyika. <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />Nyika nokuchiva kwayene zvinopfuura, asi wese anoita kuda kwaMwari anogara nokusingapere.<verse eid="1JN 2:17" /></para>
  <para style="s">Vapikisi waKirisitu</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />Vana, yaanguwa yokupedzisira! Sezvamudonzva kuti Mupikisi waKirisitu ari kuuya, naipopa vapikisi vaKhirisitu vazinji vadouya, Ndizvo zvatinoziva nazvo kuti yaanguwa yokupedzisira. <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />Vadozvikamura kubva kwatiri, ndava vanga vasiri vedu chaivo. Nokuti dai vanga vari vedu chaivo, vaisimbirira naisisu, asi kuenda kwavo kudoisa pachenu kuti mbeduba.<verse eid="1JN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20" />Asi mudozodzewa naiye Mutsvene, futi mese munoziva chokwadi. <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />Handikunyorerei nondava yokuti munozivaba chokwadi, asi kuti munoziva chokwadi futi kuti hapanai mabhwodo yanobva muchokwadi.<verse eid="1JN 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22" />Nyamabhwodo mbani? Nguyo wese anoramba kuti Jesu ndiye Khirisitu. Munhu wakareyo ndiye mupikisi waKirisitu, anoramba Baba noMwanakomana pakamu. <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />Hapanai munhu anaBaba angarambe Mwanakomana, wese anopasa upfakazi kuMwanakomana, wakareyo anaBaba futi.<verse eid="1JN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24" />Itai kuti zvamudonzva kubva pakuthanga zvigare mamuri. Kana zvamudonzva kubva pakuthanga zvagara mamuri, munodzogara muMwanakomana nomuna Baba. <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />Zvakarezvi ndizvo zvaadotivimbisa, upenyu husingapere.<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />Ndinokunyorerai zvinhu zvakarezvi kuitira vaye vanoda kukutsambutsai. <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />Kana muri imi, kuzodzewa kwamudoitiwa naiye kunogara mamuri, futi munodaba kuti pave noangakufundisei. Asi sezvamunofundisiwa zvinhu zvese naiko kuzodzewako, kuri kwochokwadi, aikona kwomabhwodo, sezvakudokufundisai, garai maari.<verse eid="1JN 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28" />Manje vana vanodiwa, garai maari, kuti paanodzooneka tidzova vanochivimbo vasingadzonyara pakuuya kwache. <verse eid="1JN 2:28" /><verse number="29" style="v" sid="1JN 2:29" />Kana muchiziva kuti iye adorurama, munovawo nochokwadi chokuti wese anoita zvidonaka adozvahwa naye.<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="s">Vana VaMwari</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />Onai kukura kworudo ratidopasiwa naBaba, rokuti tiitiwe vana vaMwari! Izvozvi ndizvo zvatiri peno! Chikonzero chinoita kuti nyika isaye kutiziva nyhokuti hainai kumuziva iye. <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />Hama dzinodiwa, izvozvi tiri vana vaMwari, futi hazvinati zvanangidziwa kuti tichava vadoita tini. Asi tinoziva kuti Khirisitu paanooneka, tichafanana naye, ndava tichamuona sezvaadoita chaizvo. <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />Wese anotariro yakarei maari anozvichenesa fanike machenero yaadoita.<verse eid="1JN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4" />Wese anoita zvitadzo anomurandu wokuchora mutemo, chitadzo nghuchora mutemo. <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />Munoziva kuti iye adooneka kuti abise zvitadzo, maari hamunai chitadzo. <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />Hapanai anogara maari anoramba achimbondoita zvitadzo. Hapanai anoramba achimbondotadza kana adomuona kana kumuziva.<verse eid="1JN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7" />Hama dzinodiwa, rekai kutsambutsiwa noumwe munhu. Uyo anoita zvidorurama adorurama, fanike iye adorurama. <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />Uyo anoita zvitadzo ngwajabhurosi, ndava jabhurosi wanga achindoita zvitadzo kubva pakuthanga. Chikonzero Mwanakomana waMwari chaadonangidzihwa pachenu nyhokuti aparadze mabasa yajabhurosi.<verse eid="1JN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9" />Hapanai adozvahwa naMwari anoramba achitadza, ndava mbeu yaMwari inogara maari, anokonaba kutadza ndava adozvahwa naMwari. <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />Ndipo panomutsauko watinoziva nawo vana vaMwari novana vajabhurosi. Wese asingaite zvidorurama haazi mwana waMwari, futi naiyewo anozonda hama yache.<verse eid="1JN 3:10" /></para>
  <para style="s">Dananai</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />Ndava rakareri ndiro shoko ramudonzva kubva pakuthanga, rokuti tinofanira kudanana. <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />Aikona kuita kunge Khaini wanga ari woadoipa, futi adopunza munin'ina’ina wache. Ko adomupunzirei? Adomupunza nondava yokuti mabasa yache pachake yanga yadoipa asi yomunin'ina wache yanga yadonaka.<verse eid="1JN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13" />Hama dzinodiwa, rekai kushamisika kana nyika ichikuzondai. <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" />Tinoziva kuti tabirika kubva muipfa tichienda muupenyu, ndava tinoda hama. Wese asinai rudo anogara muipfa. <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />Wese anozonda hama yache imhondi, futi munoziva kuti hapanai mhondi inoupenyu husingapere. <verse eid="1JN 3:15" /><verse number="16" style="v" sid="1JN 3:16" />Yakareya ndomaziviro yatinoita rudo, kuti Jesu Khirisitu adopasa upenyu hwache pamusaka pedu. Naisisuwo tinofanira kupereka upenyu hwedu nokuda kwohama. <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />Kana munhu anozvinhu zvinobatsira akaona hama yache isinai, akareka kumunzvira tsitsi, rudo raMwari ringagare tini mumunhu wakareyo? <verse eid="1JN 3:17" /><verse number="18" style="v" sid="1JN 3:18" />Vana vadiki, mbatirekei kuda nomazvi kana nokundonyaira basi, asi mbapave nozviito nochokwadi.<verse eid="1JN 3:18" /></para>
  <para style="s">Kushinga Pamberi PaMwari</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />Aya ndomaziviro yatingaite kuti tiri muchokwadi, nokudekhadza mwoyo yedu pamberi pache, <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />pese patinopasiwa mhosva nomwoyo yedu, tinoziva kuti Mwari mukuru kukunda mwoyo yedu, futi anoziva zvinhu zvese. <verse eid="1JN 3:20" /><verse number="21" style="v" sid="1JN 3:21" />Hama vadiwa, kana mwoyo yedu dzisingatipase mhosva, tinochivimbo pamberi paMwari, <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />futi tinotambira kubva kwaari zvese zvatinoruvira, ndava tinochengeta murairo wache tichiita zvinomufadza. <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" />Futi uyu ndiwo murairo wache, wokuti titende kuzita roMwanakomana wache, Jesu Khirisitu, futi kuti tidanane sezvaadotiraira. <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />Vese vanochengeta mirairo yache vanogara maari naiye mavari. Nozvakarezvi tinoziva kuti anogara matiri noMweya waadotipasa.<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s">Mweya Wochokwadi Nomweya Womabhwodo</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />Hama dzangu, rekai kutenda mweya yese yese, asi edzai mweya kuti muzive kana iri yaMwari. Ndava vaporofiti vazinji vomabhwodo vadopinda munyika. <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />Zvakarezvi ndizvo zvamunoziva nazvo Mweya waMwari, mweya wese unopfakaza kuti Jesu Khirisitu adouya panyama ndiye Mweya anobva kuna Mwari, <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />asi mweya wese usingapfakazire Jesu haubve kuna Mwari. Wakareyo ndiwo mweya mupikisi waKirisitu, wamudonzva kuti uchauya, kana naipopano watova munyika.<verse eid="1JN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4" />Imi vana, muri vaMwari, futi mudovakunda, ndava uyo ari mamuri adokuritsa kukunda ari munyika. <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />Ivo mbonyika ndosaka vachinyaira zvomunyika, futi nyika inovatetekera. <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />Tiri vaMwari. Wese anoziva Mwari anotitetekera, asi wese asingabve kunaMwari anotitetekeraba. Tinoziva nozvakarezvi kuti Mweya wochokwadi nomweya womabhwodo ngupi.<verse eid="1JN 4:6" /></para>
  <para style="s">Mwari Rudo</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />Hama dzangu, mbatidananei, ndava rudo runobva kuna Mwari. Wese anorudo adozvahwa naMwari, futi anoziva Mwari. <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />Wese asingade anozivaba Mwari, ndava Mwari rudo. <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />Munozvakarezvi rudo raMwari ridonangidziwa pakati pedu, kuti Mwari adotumira panyika Mwanakomana wache mubodzi, kuti tirarame kuburikidza naye. <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />Rakareri ndiro rudo, aikona kuti tidoda Mwari, asi kuti iye adotida ndokutuma Mwanakomana wache kuti ave chibairo chozvitadzo zvedu.<verse eid="1JN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11" />Hama dzangu, sezvo Mwari adotiditsa daipa, tinofanira kudananawo pakati pedu. <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />Hapanai adomboona Mwari, asi kana tikava norudo pakati pedu, Mwari anogara matiri futi rudo rache rinozazisiwa matiri.<verse eid="1JN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13" />Nozvakarezvi tinoziva kuti tinogara maari naiye anogara matiri, ndava adotipasa Mweya wache. <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />Futi tidoona ndokupasa upfakazi hwokuti Baba vadotuma Mwanakomana wavo kuti ave Muponisi wonyika. <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />Munhu wese anopasa upfakazi hwokuti Jesu Mwanakomana waMwari, Mwari anogara maari, naiyewo muna Mwari. <verse eid="1JN 4:15" /><verse number="16" style="v" sid="1JN 4:16" />Saka tinoziva futi tinotenda rudo raMwari kwatiri.</para>
  <para style="p" vid="1JN 4:16">Mwari rudo, uyo anogara murudo anogara muna Mwari naMwari anogara maari. <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />Munozvakarezvi rudo rinozazisiwa pakati pedu, kuti tive nochivimbo pazuva rokutongewa, ndava fanike zvaadoita iye ndizvo zvatidoitawo panyika ino. <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />Hapanai kucha murudo, asi rudo ridokwana rinodzingidza kucha. Ndava kucha kunochokuita nokutongewa. Wese anocha haanai kukwana parudo.<verse eid="1JN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19" />Tinoda nokuti adothanga kutida. <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />Kana umwe munhu achiti, “Ndinoda Mwari,” achizonda hama yache, anobhwodoka, ndava uyo asingade hama yache yaanoona, haangade Mwari waasinai kuona. <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />Futi murairo wakarewu tidoupasiwa naye, wokuti uyo anoda Mwari mbaadewo hama yache.<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s">Kukunda Kwedu Nyika</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />Wese anotenda kuti Jesu ndiKhirisitu wakareyo adoberekewa naMwari, nowese anoda mubereki anodawo mwana. <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />Tinoziva nozvakarezvi kuti tinoda vana vaMwari, kana tichida Mwari nokutetekera mirairo yache. <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" />Nokuti rakareri ndiro rudo raMwari, kuti tichengete mirairo yache. Futi mitemo yache haireme. <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />Ndava wese adozvahwa naMwari anokunda nyika. Uku ndiko kukunda kunokunda nyika iko kutenda kwedu. <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />Mbani anokunda nyika, kana asiri iyeyo anotenda kuti Jesu ndiye Mwanakomana waMwari?<verse eid="1JN 5:5" /></para>
  <para style="s">Upfakazi Pamusoro PaJesu Khirisitu</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />Iyeyu ndiye adouya nomvura nogazi, Jesu Khirisitu, haanai kundouya nomvura basi, asi adouya nomvura nogazi. Futi Mweya ndiye anopfakaza, nokuti Mweya ndiye Chokwadi. <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />Nokuti pano zvitatu zvinopfakaza. <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />Mweya, mvura nogazi, zvitatu zvakarezvi zvinotenderana. <verse eid="1JN 5:8" /><verse number="9" style="v" sid="1JN 5:9" />Kana tichitambira upfakazi hwovanhu, upfakazi hwaMwari mbukuru kukunda hwovanhu, ndava upfakazi hwache ndohuye hwaadopfakaza pamusoro poMwanakomana wache. <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />Wese anotenda muMwanakomana waMwari anenge achitotambira upfakazi hwakarehu. Wese asingatende Mwari anomuita womabhwodo, ndava haanai kutenda upfakazi hudopasiwa naMwari pamusoro poMwanakomana wache. <verse eid="1JN 5:10" /><verse number="11" style="v" sid="1JN 5:11" />Futi uhu ndihwo upfakazi hwokuti, Mwari adotipasa upenyu husingapere. Upenyu hwakarehu huri muMwanakomana wache. <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />Wese ano Mwanakomana anoupenyu, asi wese asinai Mwanakomana waMwari haanai upenyu.<verse eid="1JN 5:12" /></para>
  <para style="s">Upenyu Husingapere</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />Ndiri kunyora zvakarezvi kwamuri vanotenda muzita roMwanakomana waMwari kuti muzive kuti munoupenyu husingapere. <verse eid="1JN 5:13" /><verse number="14" style="v" sid="1JN 5:14" />Kwakareku ndiko kuvimba kwatinako maari, kuti kana tichikumbira chinhu chipi zvachene chinoenderana nozvaanoda, anotinzva. <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />Futi tikaziva kuti anotinzva panozvese zvatinomuruvira, tinoziva kuti tava nozvese zvatinokumbira.<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />Wese anoona hama yache ichiita chitadzo chisingakonzere ipfa, mbaamunamatire, futi Mwari achamupasa upenyu hunopasiwa avo vanoita zvitadzo zvisingakonzere ipfa. Panochitadzo chinokonzera ipfa, ndinonyairaba kuti anamate pamusoro pochakarecho. <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />Kunyangadza kwese ndicho chitadzo, asi kunochitadzo chisingapinze muipfa.<verse eid="1JN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18" />Tinoziva kuti wese adozvahwa naMwari haarambe achitadza, asi uyo adozvahwa naMwari, anochengetedzewa naye, adoipa haagone kumukanganisa. <verse eid="1JN 5:18" /><verse number="19" style="v" sid="1JN 5:19" />Tinoziva kuti tiri vache Mwari, futi kuti nyika yese iri pasi posimba roadoipa. <verse eid="1JN 5:19" /><verse number="20" style="v" sid="1JN 5:20" />Futi tinoziva kuti Mwanakomana waMwari adouya kotipasa kunzvitsitsa, kuitira kuti timuzive iye anova chokwadi, futi tiri maari iye anova chokwadi, muMwanakomana wache Jesu Khirisitu. Ndiye Mwari wochokwadi noupenyu husingapere.<verse eid="1JN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21" />Vana vadiki, zvichengetei kubva kuzvifananidzo.<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>