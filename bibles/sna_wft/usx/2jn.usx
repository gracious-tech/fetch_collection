<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">Kuturikihwa KwoBhaibhiri MuchiKorekore</book>
  <para style="h">2 Johwani</para>
  <para style="toc1">Tsamba ra2 Johwani</para>
  <para style="toc2">2 Johwani</para>
  <para style="toc3">2 Joh</para>
  <para style="mt2">Tsamba Rochipiri</para>
  <para style="mt1">raJOHWANI</para>
  <para style="imt">Kuwidzira</para>
  <para style="ip">Tsamba rochipiri raJohwani ridonyohwa noNhumwa Johwani pamakore yari pakati pomakore makumi mashano nozana mumasure mokuzvahwa kwaKhirisitu. Johwani pachake haazviise pachenu kuti ndiye munyori wotsamba rakareri, asi anondozviti, mukuru. Panokufanana kudonyanya kuripo pazvinyohwa zvomuna 2Johwani noVhangeri yaJohwani. Izvozvi zvinooneka paanotsindikira murairo waJesu panyaya yorudo, paanoti vanhu mbavadane, kudanana kwacho kunofanira kuenzana nokuda Jesu tichiita zvaanoraira (2 Johwani 1:5-6, Johwani 15:9-10). Vanhu vanotenda kuti Johwani ndiye adonyora Vhangeri rinoitiwa Johwani nomatsamba matatu yanoti 1 Johwani, 2 Johwani na 3 Johwani, panguwa yaanga achigara muEfeso. Johwani adonyora tsamba rakareri kumukadzi wanga anovana vache, futi ari musaruhwa.</para>
  <para style="ip">Pamusoro povana Johwani anofanira kunge waitaura Kherekhe. Chinangwa chaJohwani pakunyora tsamba rakareri, ndochokukurudzira Kherekhe nokuipasa chenjedzo pamusoro povadzidzisi vomabhwodo.</para>
  <para style="iot">Marongehwo</para>
  <para style="io1">Johwani anowidzira tsamba nonzira yokunangidza kuti njaani, futi anomoresa vanoitambira vacho (2 Johwani 1:1-3).</para>
  <para style="io1">Mumasure maizvozvo anokurudzira Kherekhe achiifungisa mutemo mukuru (2 Johwani 1:4-6).</para>
  <para style="io1">Johwani anodzopasa chenjedzo pamusoro povadzidzisi vomabhwodo (2 Johwani 1:7-11).</para>
  <para style="io1">Johwani anodzopedzisa tsamba rache nokusvitsa kwaziso inobva kuKherekhe yokwaanogara (2 Johwani 1:12-13).</para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />Kubva kumukuru</para>
  <para style="p" vid="2JN 1:1">Kumukadzi adosarudziwa naMwari nokuvana vache, vandinoda pachokwadi, aikona inini ndega, asi novese vanoziva chokwadi, <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />ndava chokwadi chacho chinogara matiri futi chichava naisisu nokusingapere.<verse eid="2JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3" />Mutsa, notsitsi norugare, zvinobva kuna Mwari Baba nokuna Jesu Khirisitu, Mwanakomana waBaba, zvichava naisisu muchokwadi nomurudo.<verse eid="2JN 1:3" /></para>
  <para style="s">Chokwadi Norudo</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />Zvidondipasa mufaro mukuru kuwana vamwe vana vako vachitekaira muchokwadi sezvidoraihwa naMwari. <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />Mukadzi, ndinokukumbiritsa zvino, handisi kukunyorera murairo mutsva, asi uye watanga tinawo kubva pakuthanga, wokuti tive vanodanana. <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />Zvino rudo ndiri, rokuti titetekere mirairo yache, fanike zvaudonzva kubva pakuthanga, kuti mutevere rudo.<verse eid="2JN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7" />Nokuti vanyengeri vazinji vadopinda munyika, vanhu vasingatambire kuuya kwaJesu Khirisitu panyama. Wese adodaro munyengeri nomupikisi waKirisitu. <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />Zvichenjererei kuti mureke kupukunyukiwa nozvamudoshandira, asi kuti mupasiwe mubairo udozara. <verse eid="2JN 1:8" /><verse number="9" style="v" sid="2JN 1:9" />Wese anopinimidza pamberi asingagare mudzidziso yaKhirisitu haanai Mwari. Wese anoramba ari mukudzidzisa kwaKhirisitu anovese, Baba noMwanakomana. <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />Kana umwe munhu akauya kwamuri asinai kudzidzisa kwakareku, rekai kumutambira kana kumupinza mumba menyu, <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />wese anomutambira anokovana naye mumabasa yache yadoipa.<verse eid="2JN 1:11" /></para>
  <para style="s">Mazvi Yokupedzisira</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />Kunyange zvazvene ndino zvidowanda zvokukunyorerai, ndinosarura kureka kushandisa pepa noingi, asi ndinotarisira kuuya kuti tinyaire tidonangarana chiso nochiso, kuti mufaro wedu uve udozara.<verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />Vana vomukoma wako adosaruhwa naMwari vanokumoresa.<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>