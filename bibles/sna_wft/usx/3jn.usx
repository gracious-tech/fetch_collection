<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">Kuturikihwa kwoBhaibhiri muchiKoreKore</book>
  <para style="h">3 Johwani</para>
  <para style="toc1">Tsamba ra3 Johwani</para>
  <para style="toc2">3 Johwani</para>
  <para style="toc3">3 Joh</para>
  <para style="mt2">Tsamba rochitatu</para>
  <para style="mt1">raJOHWANI</para>
  <para style="imt">Kuwidzira</para>
  <para style="ip">Tsamba rochitatu raJohwani ridonyohwa noNhumwa Johwani pakati pomakore makumi mashano nomakore zana mumasure mokuzvahwa kwaKhirisitu. Johwani haazvionese pachenu kuti ndiye munyori wacho, asi anondozviti mukuru (3 Johwani 1:1). Anoita zvibodzibodzizvo muna 2 Johwani (3 Johwani 1:1). Zvinotendewa kuti Johwani adonyora Vhangeri raJohwani nomatsamba matatu yanoti, 1 Johwani, 2 Johwani, na 3 Johwani, futi adonyora achigara kuEfeso.</para>
  <para style="ip">Johwani adonyora tsamba rakareri kumutendi anoitiwa Gaiyasi. Waitora Gaiyasi kunge shamwari yache ndokumuraira kuti atambire hama dzochiKhirisitu dzinosvika kudunhu rakarero dziri paurendo.</para>
  <para style="iot">Marongehwo</para>
  <para style="ip">Johwani anowidzira tsamba rache (3 Johwani 1:1) Anokurudzira Gaiyasi nokumuraira kuti atambire varendo murudo (3 Johwani 1:2-8) Johwani anodzonyaira futi pamusoro povarume vairi, Dhiyotirefasi naDhimetiriyasi (3 Johwani 1:9-12)</para>
  <para style="ip">Johwani anodzopedzisa tsamba yache (3 Johwani 1:13-14)</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />Kubva kumukuru</para>
  <para style="p" vid="3JN 1:1">Kumudikani Gaiyasi, wandinoda pachokwadi.<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />Mudikani, ndinonamatira kuti zvese zvikutekairire zvidonaka sematekairiro yadonaka yazviri kuita kumweya wako. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />Nokuti ndidopasiwa mufaro udokungudza padouya vamwe vatendi vachipfakaza pamusoro pomatendekero yaudoita kuchokwadi, vachinyaira kuenderera mberi kwako uchitekaira machiri. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />Handinai mufaro mukuru unokunda wakareyu, kunzva kuti vana vangu vari kurarama muchokwadi.<verse eid="3JN 1:4" /></para>
  <para style="s">Gaiyasi Anorumbidziwa</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />Mudikani, chinhu chidotendeka chauri kuitira hama, zvidonyanya kunaka kana uchizviitira varendo. <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />Vadopfakazira rudo rako pamberi pokherekhe. Ndapota gonekanai navo vatekaire munzira yavo nomutoo unoremekedza Mwari. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />Ndava vadobirika nokuda kwache uye hapanai chavadotambira kubva kunovasingatende. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />Tinofanira kupasa rubatsiro kuno vadodaro kuti tive vanoshanda pabodzi pashoko rochokwadi.<verse eid="3JN 1:8" /></para>
  <para style="s">Dhiyotirefasi naDhemetiriyasi</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />Ndidonyora tsamba kukherekhe, asi Dhiyotirefasi anoda kuzviita wokuthanga haatitambire. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />Saka pandichauya ndipo pandichabiritsa pachenu zvaari kuita, kumwaya mazvi yadoipa pamusoro pedu. Zvisiri zvakarezvi basi, asi anotoramba kutambira vamwe vatendi. Futi adotorambidza vaye vaida kuzviita, ndokutovabiritsa mukherekhe.<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />Mudikani, reka kuteedzera zvidoipa asi zvidonaka. Wese anoita zvidonaka ngwaMwari, wese anoita zvidoipa haanai kuona Mwari.<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />Munhu wese anonyaira zvidonaka pamusoro paDhimetiriyasi, futi nochokwadi pakare chinonyairawo zvidonaka pamusoro pache, anopfakazihwa zvidonaka novanhu vese.<verse eid="3JN 1:12" /></para>
  <para style="s">Kumoresa Kwokupedzisira</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />Ndino zvokukunyorerai zvidowanda, asi handidi kukunyorerai ndichishandisa penzura noingi. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />Ndinotarisira kudzokuona tsotsono, tonyairirana chiso nochiso.<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />Rugare mbarive newe.</para>
  <para style="p" vid="3JN 1:15">Shamwari dziri kuno dziri kukumoresa. Moresa shamwari dzese kwakareko.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>