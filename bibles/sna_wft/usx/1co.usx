<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- Kuturikihwa kwoBhaibhiri muchiKorekore</book>
  <para style="h">1 Vakorinde</para>
  <para style="toc1">Tsamba raPhauro ku1 vaKorinde</para>
  <para style="toc2">1 VaKorinde</para>
  <para style="toc3">1 VaK</para>
  <para style="mt2">Tsamba rokuthanga raPhauro</para>
  <para style="mt1">VAKORINDE</para>
  <para style="imt">Kuwidzira</para>
  <para style="ip">Vakorinde ridonyohwa noNhumwa Phauro kumakore yokumakumi mashano nomashano (55) mumasure mokuberekewa kwaJesu (1 VaKorinde 1:1)</para>
  <para style="ip">Iri ndiro tsamba rokuthanga patsamba dziiri dzatinadzo dzidonyohwa naPhauro kukherekhe yopaKorinde. Kabanga adonyora tsamba iri paanga achigara muEfeso asinati waronga kubvakachira vaKorinde pahwendo hwache hwokuenda nokudzoka kuMesodhoniya (1 VaKorinde 16:5-9).</para>
  <para style="ip">Tsamba iri imhinduro younyerekupe hwanga hwatambihwa naPhauro kubva kunhengo dzokherekhe pamusoro pokuita kusinai kukohoroka kwaiitiwa mukherekhe kwaibatanidzira kupatsanurana noupombwe.</para>
  <para style="ip">Guta roKorinde rainyanya kuzikana nonyaya youpombwe saka hazvishamise kuti kherekhe yokwakareko yaitarisana nonyaya dzidodai. 1 vaKorinde ndiyo tsamba inochitsauko chinozikana kuti nyhorudo (1 VaKorinde 13).</para>
  <para style="iot">Marongehwo</para>
  <para style="io1">Phauro anomoresa vaKorinde nokutenda Mwari pamusoro pavo (1 VaKorinde 1:1-9)</para>
  <para style="io1">Wodzobata nyaya dzokupatsanurana mukherekhe dzaanga wanzva mukherekhe yopaKorinde (1 VaKorinde 1:10—4:21)</para>
  <para style="io1">Chinotevera anobata nyaya youpombwe noyokumhangarirana kumatare (1 VaKorinde 5:1—6:20)</para>
  <para style="io1">Mumasure mozvakarezvo anovapasa rairo pamusoro ponyaya dzokuroorana, kupira zvifananidzo, kunamata paruzinji, zvipo zvomweya nokumuka kuvadopfa (1 VaKorinde 7:1—15:58)</para>
  <para style="io1">Pakupedzisira anopeta nyaya yache achinyaira pamusoro pomunhu nomagariro yache (1 VaKorinde 16)</para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />Phauro, adodaidziwa nokuda kwaMwari kuti ave nhumwa waKhirisitu Jesu, nohama yedu Sositenesi.<verse eid="1CO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 1:2" />Kukherekhe yaMwari iri paKorinde, kuno avo vadoyeresewa muna Khirisitu Jesu, vadodaidziwa kuva vatsvene pabodzi noavo vari kwese kwese vanodaidza zita raIshe wedu Jesu Khirisitu, Ishe wavo nowedu:<verse eid="1CO 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3" />Mutsa norugare zvinobva kuna Mwari Baba vedu nokunaIshe Jesu Khirisitu mbazvive kwamuri.<verse eid="1CO 1:3" /></para>
  <para style="s">Makomborero muna Khirisitu</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />Ndinopasa Mwari kutenda nguwa dzese nokuda kwenyu nondava yonyasha dzaMwari dzamudopasiwa muna Khirisitu Jesu, <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />ndava pazvese mudopfumisiwa maari pakunyaira kwese nokuziva kwese. <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />Futi uchapupu hwenyu pamusoro paKhirisitu hudosimbisiwa mamuri, <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />zvokuti hamunai chamurikusaya pazvipo zvomweya, mudomirira kuratidziwa kwaIshe wedu Jesu Khirisitu. <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />Uyo achakusimbisai kusvika pamagumo, musinai chinoshoreka pazuva raIshe wedu Jesu Khirisitu. <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />Mwari adotendeka, iye wamudodaidziwa naye kuruwadzano roMwanakomana wache, Ishe wedu Jesu Khirisitu.<verse eid="1CO 1:9" /></para>
  <para style="s">Kupesana mukherekhe</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />Ndinokukumbiritsai, hama, nozita raIshe wedu Jesu Khirisitu, kuti mese mubvumirane kuti pakati penyu pareke kuva nokupesana, asi mubatane papfungwa ibodzi nochinangwa chibodzi. <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />Hama dzangu ndidozvinyepewa novoimba yokwaKhuro kuti pano bopoto pakati penyu. <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" />Zvandiri kureva nzvokuti umwe noumwe wenyu anoti, “Inini ndinotevera Phauro,” kana kuti “Ndinotevera Aporo,” kana kuti “Ndinotevera Kefasi,” kana kuti “Ndinotevera Khirisitu.” <verse eid="1CO 1:12" /><verse number="13" style="v" sid="1CO 1:13" />Ko Khirisitu adopatsanuriwa? Ko Phauro adorovehwa nokuda kwenyu? Kana pamwe mudoombekewa muzita raPhauro?<verse eid="1CO 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 1:14" />Ndinotenda kuti hapanai umwe wenyu wandidoombeka kunze kwaKhirisipasi naGayosi, <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />kuti pareke kuva noanoti mudoombekewa muzita rangu. <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" />Ndidoombekawo voimba yaSitefanasi. Hapanai kamu, wandinoziva kuti ndidoombeka. <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />Ndava Khirisitu adonditumaba koombeka asi koparidza vhangeri, aikona nokugona kutaura, kuti muchinjikwa waKhirisitu ureke kutorehwa simba rawene.<verse eid="1CO 1:17" /></para>
  <para style="s">Khirisitu Isimba noUchenjeri hwaMwari</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />Ndava shoko romuchinjikwa mbudzemwa kuna ivo vari kuparara, asi kwatiri vari kuponesewa isimba raMwari. <verse eid="1CO 1:18" /><verse number="19" style="v" sid="1CO 1:19" />Ndava kudonyohwa kuti,</para>
  <para style="q1" vid="1CO 1:19">“Ndichaparadza uchenjeri hwovadochenjera,</para>
  <para style="q2" vid="1CO 1:19">noruzivo rovanoziva ndicharisayisa basa.”<verse eid="1CO 1:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="1CO 1:20" />Muchenjeri ari poi? Mudzidzisi womutemo ari poi? Nyamhoka wanasi ari poi? Anga uchenjeri hwonyika Mwari adohuitaba udzemwa nai?<verse eid="1CO 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 1:21" />Ndava sezvo, muuchenjeri hwaMwari, nyika nouchenjeri hwayene idotadza kuziva Mwari, zvidofadza Mwari kuburikidza noudzemwa hwozvatinoparidza kuti aponese vanotenda. <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />Ndava vaJudha vanopopera minana uye vaGiriki vanotsvaga uchenjeri, <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />asi isisu tinoparidza Khirisitu adorovehwa, chigutsa chinoguhuna kuvaJudha noudzemwa kuno vasiri vaJudha, <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />asi kuno vadodaidziwa, vese vaJudha novaGiriki, Khirisitu isimba raMwari nouchenjeri hwaMwari. <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />Ndava udzemwa hwaMwari hudochenjeretsa kukunda uchenjeri hwovanhu, nokuvhuwa kwaMwari kudosimbitsa kukunda simba rovanhu.<verse eid="1CO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />Hama fungai kudaidziwa kwenyu kuti, mbazinjiba vanga vadochenjera maererano nochipimo chonyika, mbazinjiba vanga vano masimba, mbazinjiba vadozvahwa nochiremera. <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />Asi Mwari adosarudza zvoudzemwa munyika kuti anyadzise vadochenjera, Mwari adosarudza zvidovhuwa munyika kuti anyadzise zvidosimba, <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />Mwari adosarudza zvidoderera nozvinozvidziwa munyika, izvo zvinhu pasina, kuti asaise basa zvinhu zviripo, <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />kuti parege kuva nomunhu angazvikudze pamberi paMwari. <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />Mwari adokuitai kuti muve muna Khirisitu Jesu. Uye Khirisitu adoitiwa naMwari kuti ave uchenjeri hwedu. Khirisitu adotiita kururama, nokuchenesewa uye nokutidzikinura. <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />Nokudaro, fanike kunyohwa kwazvidoitiwa kuti, “Anoda kuzvirumbidza, mbaazvirumbidze muna Ishe.”<verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="s">Shoko raKhirisitu Adorovehwa paMuchinjikwa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />Hama pandidouya kwamuri, handinai kuuya kwamuri ndichikuparidzirai zvidohwanzika zvaMwari, handinai kushandisa kugona kutaura kwovanhu kana mashoko youchenjeri. <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />Ndidosarudza kusaziva chimwe chinhu pakati penyu kunze kwaJesu Khirisitu iye adorovehwa pamuchinjikwa. <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" />Pandidouya kwamuri ndanga ndidoneta ndichitetemera nondava yokucha kukuru, <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />kunyaira kwangu nokuparidza kwangu zvanga zvisiri mumashoko youchenjeri hwokupenzveredza hwokusukumidzira, kunobva pakuchenjera kwovanhu, asi kwokunangidza simba roMweya waMwari. <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />kuti kutenda kwenyu kureke kutsamira pauchenjeri hwomunhu asi musimba raMwari.<verse eid="1CO 2:5" /></para>
  <para style="s">Uchenjeri hwaMwari</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />Asi pakati povakura pamweya tinonyaira shoko rouchenjeri, kana nepo husiri uchenjeri hwanasi kana hwovatongi vanasi, hudomirira kupfuruka. <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />Asi tinotaura uchenjeri hwaMwari hudosvisvika, hudotemewa naMwari kare nyika isinati yavapo nokuda kwokubhwinya kwedu. <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />Hapanai mutongi wonguwa ino adozvinzvitsitsa zvakarezvi, ndava dai vadozvinzvitsitsa, vairoveraba pamuchinjikwa Ishe wokubhwinya. <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />Asi semanyorehwo yazvidoitiwa kuti,</para>
  <para style="q1" vid="1CO 2:9">“Zvisinai ziso ridoona, kana nzeve idonzva,</para>
  <para style="q2" vid="1CO 2:9">kana kuthanga kufungika mumwoyo womunhu,</para>
  <para style="q2" vid="1CO 2:9">ndizvo Mwari zvaadogadzirira vanomuda.”<verse eid="1CO 2:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10" />Mwari adozvinangidza kwatiri kuburikidza noMweya. Ndava Mweya anonzvera zvese kana zvaMwari zviri gwiri. <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />Ndava mbani munhu anoziva mifungo yomunhu kunze kwomweya womunhu uri maari? Ndomwenze daro hapanai munhu anoziva mifungo yaMwari kunze kwoMweya waMwari. <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />Zvino tidotambiraba mweya wonyika, asi Mweya unobva kuna Mwari, kuti tinzvitsitse zvipo zvatidopasiwa pachena naMwari.<verse eid="1CO 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 2:13" />Uye tinotaura izvi mumazvi yasingadzidzisiwe nouchenjeri hwomunhu, asi yanodzidzisiwa noMweya, nokuturikira chokwadi chopamweya kuna ivo vanoMweya. <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />Munhu asiri womweya anotambiraba zvinhu zvoMweya waMwari, ndava mbudzemwa kwaari, anokonaba kuzvinzvitsitsa ndava zvinotsvagitsitsiwa pamweya. <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />Munhu womweya anoongorora zvinhu zvese, asi iye pachake anoongororekaba nomunhu.<verse eid="1CO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CO 2:16" />“Ndava mbani adoziva mufungo waIshe?</para>
  <para style="q2" vid="1CO 2:16">Mbani angamurairire?”</para>
  <para style="m" vid="1CO 2:16">Asi isu tino mufungo waKhirisitu.<verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s">Varanda vaMwari</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />Hama, inini, hama, ndaikonaba kukunyairirai sevanhu vomweya, asi sevanhu vomunyika, sevadiki muna Khirisitu. <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" />Ndidokupasai mukaka, aikona zvokuja zvidosimba, ndava manga munati mava kuzvikona. Kana namanje hamunati mava kukona, <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />ndava muchiri vanhu vonyika. Ndava kana pachinochanje nokudhonzerana pakati penyu, hamusi vanhu vonyika nai? Muchiita kunge vanhuwo zvavo? <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" />Ndava kana umwe achiti, “Inini ndinotevera Phauro,” noumwe achiti, “Inini ndinotevera Aporo,” hamusi vanhuwo zvavo nai? <verse eid="1CO 3:4" /><verse number="5" style="v" sid="1CO 3:5" />Anga Aporo chiiko? Phauro chiiko? Vanondova varanda vadokuitai kuti mutende, sematumihwo yadoitiwa umwe noumwe naIshe. <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" />Inini ndidojara mbeu, Aporo adodiridza, asi Mwari ndiye adokurisa. <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />Saka anotimbikira noanodiridza havasi chinhu, asi anokosha ndiMwari basi anokurisa. <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />Anotimbikira noanodiridza vano chinangwa chibodzi. Asi umwe noumwe achatambira mubairo wache maererano nomashandiro yache. <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />Ndava tiri vashandi pabodzi naMwari, muri munda waMwari,</para>
  <para style="p" vid="1CO 3:9">chivakwa chaMwari. <verse eid="1CO 3:9" /><verse number="10" style="v" sid="1CO 3:10" />Maererano nonyasha dzaMwari dzandidopasiwa, semuvakhi anouseza ndidoronga nheyo, uye umwe munhu ari kuvakha pamusoro payene. Munhu mbaachenjere kuti anovakha tini pamusoro payene. <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />Ndava hapanai imwe nheyo ingarongewe nomunhu kunze kwoyakareyo idorongewa, inova Jesu Khirisitu. <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />Zvino kana munhu achivakha panheyo nondarama, sirivha, mabhwe yanokosha, mapango, mashanga, kana usva, <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />basa romunhu umwe noumwe richanangidziwa. Ndava Musi iwoyo uchariisa pachenu, ndava richanangidziwa nomoto. Moto uchaedza basa ridoitiwa noumwe noumwe kuti ridoita tini. <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />Kana basa ridovakhiwa nomunhu pamusoro ponheyo rikapona, achatambira mubairo. <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />Kana basa romunhu rikatsva, acharasikihwa, asi iye achaponesewa zvache, asi seuye waburiwa mumoto.<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />Munozivaba nai kuti muri imba yaMwari yaMwari uye kuti Mweya waMwari unogara mamuri? <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />Kana munhu achiparadza imba yaMwari yaMwari, Mwari achamuparadza. Ndava imba yaMwari yaMwari itsvene, uye imba yaMwari yacho ndimi vakaremi peno.<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />Munhu mbaarege kuzvinyengedza. Kana munhu pakati penyu achifunga kuti adochenjera munguwa ino, mbaave dzemwa kuti ave adochenjera. <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />Ndava uchenjeri hwonyika ino udzemwa kuna Mwari. Ndava kudonyohwa kuti, “Anobata vadochenjera mumambere yavo,” <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />uye gwaro rinotiwo, “Ishe vanoziva kuti mifungo yovadochenjera hapanai zviripo.” <verse eid="1CO 3:20" /><verse number="21" style="v" sid="1CO 3:21" />Saka hapanai anofanira kuzvirumbidza pamusoro pomunhu. Ndava zvinhu zvese nzvenyu. <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />Angave Phauro kana Aporo kana Kefasi kana nyika kana upenyu kana ipfa kana zvazvino kana zvichauya, zvese nzvenyu, <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />naimipa muri vache Khirisitu, naKhirisitu ngwaMwari.<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s">Nhumwa vaKhirisitu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />Aya ndiyo maonero munhu yaanofanira kutiita, sevaranda vaKhirisitu novachengetedzi vozvidosvisvika zvaMwari. <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />Pakare zvinodiwa kuti vachengetedzi vawanike vadotendeka <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />Asi kwandiri chinhu chidiki maninge kuti nditongewe naimimi kana nodare ripi zvarene rovanhu. Ndava kana nainini pachangu ndinozvitongaba. <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />Handinai chinhu chandinoziva chinopesana pandiri, asi zvakarezvo zvinondisununguraba. Ishe ndivo vanonditonga. <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />Saka rekai kutaura mutongo nguwa isinati yasvika, asi mirirai kusvikira Ishe vauya, ndivo vanodzoisa pachenu zvinhu zviri murima zvidohwanda iyezvino nokudzofukunura zvinangwa zvomwoyo. Ipopo munhu wese achatambira pembedzo yache kubva kuna Mwari.<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />Hama, ndashandisa zvese izvi ndichizvienzanisa inini naAporo, semuenzaniso kwamuri kukudzidzisai zvinoreva mutauro uyu, “Rekai kupindiridza zvidonyorewa” kuti pareke kuva noumwe wenyu anosasuka kufarira umwe achisiya umwe wacho. <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />Anga mbani anokupasa simba rokutonga vamwe? Chii chaunacho chausinai kutambira? Kana udochitambira, unozvikudzirei kunge changa chisiri chipo?<verse eid="1CO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8" />Mudotowana kare zvese zvamunoda! Mudotopfuma kare! Nokusavapo kwedu matova madzimambo! Ndaida kuti dai muri madzimambo zvenyu, kuti tikovane utongi naimimi! <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />Ndava ndinofunga kuti Mwari adotitanika isisu nhumwa kuva vokupedzisira kwomudungwe wovese, kunge vanhu vadotongehwa ipfa, ndava tava chinonangaritsiwa nonyika, nongirozi novanhu. <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />Tiri madzemwa nokuda kwaKhirisitu, asi imimi mudochenjera muna Khirisitu. Tidorukutika, asi imimi mudosimba. Imimi munokudziwa, asi isisu tinozvidziwa. <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />Kusvika zvino tinonzara nonyota, tinotsiku futi tinobutiwa tisinai pokugara, <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" />tinoshanda, tichizvibatira nomaoko yedu. Patinotukaniwa, tinoropafadza, patinotambudziwa, tinotsungirira. <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />Patinofudziwa, tinopindura nounyoro. Tava manyara, futi izvozvi tiri manyara yonyika, panotaihwa tsambwa yese.<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />ndinonyoraba zvakarezvi kuti ndikunyadzisei, asi kuti ndikurairei sevana vangu vanodikana. <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />Ndava kana nepo munozviuru zvovarairiri muna Khirisitu, hamunai anababa vadowanda. Ndava ndidova baba venyu muna Khirisitu Jesu kuburikidza novhangeri. <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" />Ndinokukumbirai, kuti muve vateedzeri vangu. <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />Nokudaro ndidotuma Timoti, mwana wangu anodikana uye adotendeka muna Ishe, kuti akuyeuchidzei nzira dzangu muna Khirisitu, semadzidzisiro yandinodziita kwese mukherekhe dzese.<verse eid="1CO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18" />Vamwe vaakuzvikudza kunge ndisiri kuuya kwamuri. <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />Asi ndichauya kwamuri nokamangu, kana Ishe vachida, ipopo ndichaziva aikona manyairiro chete yovanhu vakareva vanozvikudza, asi norudzi rosimba ravanaro. <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />Ndava umambo hwaMwari hahusi mukutaura asi musimba. <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />Chii chamunoda? Ndiuye kwamuri nomushamu chere, kana norudo mumweya wounyoro?<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s">Upombwe mukherekhe</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />Zviri kutauhwa kuti pakati penyu pano chimina chomushoo usingatambirike kunyange pakati povasingatende. Munhu ari kuita zvobonde nomukadzi wababa vache! <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />Imimi munotozvikudza! Maifaniraba nai kutorira nokudzinga munhu wakareyo pakati penyu? <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />Ndava kana zvangu ndisipo mumuviri pamweya ndiripo, ndatoreva mutongo kare kumurume adoita chinhu chidodai kunge ndiripo. <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />Pamunoungana muzita raIshe wedu Jesu nomweya wangu uripo, nosimba raIshe wedu Jesu riripo, <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />isai munhu wakareyo kuna Sathani kuti muviri uparadziwe, kuti mweya wache uponesewe pazuva raIshe Jesu.<verse eid="1CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />Kuzvikudza kwenyu hakunai kunaka. Hamuzive kuti mbiriso ishoma inokukumutsa mukanyiwa wese? <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />Biritsai mbiriso yokare kuti muve mukanyiwa mutsva, sezvo muri mukanyiwa mutsva usinai mbiriso, nokuti ndozvamava. Ndava Khirisitu hwayana redu rophasika, adoitiwa chibairo. <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />Saka mbatirambei tichipemberera mutambo, aikona nombiriso yokare, mbiriso yokunyangadza noyouipi, asi nomazingwa yasinai mbiriso, iko kuita nomwoyo wese nochokwadi.<verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />Ndidokunyorerai mutsamba rangu kuti mureke kubatana nomhombo dzovanhu, <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />kusiri kureva mhombo dzonyika ino, kana vanonhafu nomatsotsi, kana vanonamata zvifananidzo, ndava zvingatoda kuti mubirike munyika. <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />Asi ndiri kukunyorerai kuti mureke kuwadzana nani zvache anozviti hama kana anomhosva youpombwe kana nhafu, kana munamati wozvifananidzo, mucheri, mumwi, kana tsotsi - rekai kana kutoja naye.<verse eid="1CO 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12" />Ndava ndingatongereiko vari kunze? Ko handiti mbaye vari mukherekhe vamunofanira kutonga? <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />Mwari anotonga vari kunze. “Dzingai munhu wakareyo adoipa kubva pakati penyu.”<verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s">Kumhangarirana kwomaKhirisitu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />Kana mabiyako ano chigumbu nohama, angaende komhangara kuno vasingatende nai panokuti aende kuvatsvene? <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />Munozivaba nai kuti vatsvene vachatonga nyika? Zvino kana nyika ichidzotongewa naimimi, mungavhuwire tumhosva tudikidiki? <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />Munozivaba kuti tichatonga ngirozi? Manje panyaya dzoupenyu huno, zvidotofanira zvidonyanya! <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />Zvino kana muno nyaya dzidodaro, sei muchidziisa pamberi poavo vanoonewa vari vopasipasi nokherekhe? <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />Ndinotaura izvi kuti ndikunyadzisei. Zvingave izvo nai kuti hapanai munhu pakati penyu adochenjera zvidokwana kuti aenzanise pakati pohama? <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />Asi hama inomhangarira hama, pamberi povasingatende! <verse eid="1CO 6:6" /><verse number="7" style="v" sid="1CO 6:7" />Kukwirirana dare kwakareko kwamunoita kunoreva kuti matokundikana kare. Munorekerei kubvuma kudzongewa? Munorekerei kubvuma kubiridzihwa? <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />Asi imimi pachenyu munodzonga muchibiridzira, muchiitira hama zvakarezvo. <verse eid="1CO 6:8" /><verse number="9" style="v" sid="1CO 6:9" />Hamuzive nai kuti vasinai kururama havaji nhaka youmambo hwaMwari? Rekai kunyengedzewa, mhombo, kana vanamati vozvifananidzo, kana mahure, kana ngochani, <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />kana mbavha, kana vanonhafu, kana vanoraradza, kana vanoguhwa, kana matsotsi vanojaba nhaka youmambo hwaMwari. <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />Zvakarezvo ndizvo zvanga zvidoita vamwe venyu. Asi mudoshambidziwa, mudochenesewa, mudoruramisiwa muzita raIshe Jesu Khirisitu nomuMweya waMwari wedu.<verse eid="1CO 6:11" /></para>
  <para style="s">Miviri Yenyu Mbaishandisihwe Kubhwinya kwaMwari</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />“Zvinhu zvese ndidozvibvumihwa,” asi hazvisi zvese zvinobatsira. “Zvinhu zvese ndidozvibvumihwa,” asi handidzoitiwa muranda nochinhu chipi zvachene. <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />“Chokuja chidoitihwa mimba nomimba njochokuja” asi Mwari achaparadza zvese iyo naicho. Muviri haunai kuitihwa upombwe, asi udoitihwa kuti ushumire Ishe, uye naIshe atonge muviri. <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />Mwari adomutsa Ishe achatimutsawo isisu nosimba rache.<verse eid="1CO 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15" />Munozivaba nai kuti miviri yenyu inhengo dzaKhirisitu? Manje ndotora nhengo dzaKhirisitu ndichidziita nhengo dzouhure? Ndizvoba! <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />Munozivaba kuti uyo anozvibatanidza nohure wava nyama ibodzi naro? Ndava, sekunyohwa kwazvidoitiwa kuti, “Vairi vachava nyama ibodzi.” <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />Asi uyo wabatanidziwa naIshe wava mweya mubodzi naye.<verse eid="1CO 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18" />Tizai upombwe. Chitema chese chinoitiwa nomunhu chiri kunze kwomuviri, asi munhu anoita upombwe anotadzira muviri wache. <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" />Munozivaba nai kuti muviri wenyu imba yaMwari yoMweya Mutsvene ari mamuri, wamudopasiwa naMwari? Hamusi venyu, <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />mudotengewa nomutengo. Saka kudzai Mwari mumuviri wenyu.<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s">Mibvunzo Pamusoro poKuroorana</para>
  <para style="m">
    <verse number="1" style="v" sid="1CO 7:1" />Zvino pamusoro pozvamudondiyorera. Zvidonaka kuti murume areke kuroora mukadzi. <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />Asi nokuda kwomuedzo woupombwe, murume wese mbaave nomukadzi wache nomukadzi wese ave nomurume wache. <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />Murume mbaapase mukadzi wache kodzero dzobonde, nomukadzi mbaadarowo kumurume wache. <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />Ndava mukadzi anotongaba muviri wache, asi murume, nzvibodziwo nomurume anotongaba muviri wache, asi mukadzi. <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />Rekai kunyimana kunze kwokunge matobvumirana kwonguwa idiki, kuti muzvipe pakunamata, modzosangana kamu, ndava Sathani angakuedzei kuburikidza nokutadza kuzvibata.<verse eid="1CO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 7:6" />Ndinotaura izvi senzira yokubvumira, aikona murairo. <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />Ndaida kuti dai vese vadoita sezvandiri inini. Asi munhu wese anochipo chache chidotsarukana kubva kuna Mwari, chomushoo udosiyana nochimwe.<verse eid="1CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8" />Kuno vasinai kuroora novajiche ndinoti kwavari hasa kuti varambe vari vega sezvidoita inini. <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />Asi kana vasingakwanise kuzvibata, mbavaroore kana kuroohwa. Ndava hasa kuroora kana kuroohwa panokukangika noshungu.<verse eid="1CO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10" />Kuno vadoroora ndinoraira, aikona inini asi Ishe, kuti mukadzi mbaareke kusiyana nomurume wache <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />asi kana akamusiya, mbaagare wega kana kudzokerana nomurume wache - uye kuti murume mbaareke kuramba mukadzi wache.<verse eid="1CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12" />Kuvamwe vese ndinoti, aikona Ishe, kana hama inomukadzi asingatende, uye achida kugara naye, mbaareke kumuramba. <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />Kana mukadzi anomurume asingatende, uye kana achida kugara naye, mbaareke kumuramba. <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />Ndava murume asingatende anoitiwa mutsvene kuburikidza nomukadzi wache, nomukadzi asingatende anoitiwa mutsvene kuburikidza nomurume wache. Dai zvisiri izvo, vana venyu dai vadosvipa, asi manje mbatsvene. <verse eid="1CO 7:14" /><verse number="15" style="v" sid="1CO 7:15" />Asi kana asingatende wacho wada kusiya, mbazviite daro, padodaropo hama kana hanzvadzi idosungiwaba. Ndava Mwari adotidaidzira runyararo. <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />Mukadzi, uchaziva tini kana uchaponesa murume wako? Murume, uchaziva tini kana uchaponesa mukadzi wako?<verse eid="1CO 7:16" /></para>
  <para style="s">Rarama Sezvaudodaidzihwa naMwari</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />Chete, munhu wese mbaararame upenyu hwaadotumiwa naIshe, huri hwaadodaidzihwa naMwari. Uku ndiko kuraira kwangu mukherekhe dzese. <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />Pano wanga adochecheudziwa kare panguwa yokudaidziwa kwache chere? Mbaareke kutsvaga kubisa zvidzvanga zvokuchecheudziwa. Pano wanga asinai kuchecheudziwa panguwa yokudaidziwa kwache chere? Mbaareke kutsvaga kuchecheudziwa. <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />Ndava kuchecheudziwa kana kusachecheudziwa hakunai basa, asi kuchengeta mitemo yaMwari. <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />Munhu wese mbaagare mumamiriro yaanga ari pakudaidziwa kwache. <verse eid="1CO 7:20" /><verse number="21" style="v" sid="1CO 7:21" />Paudodaidziwa waiva muranda chere? Hazvinai basa. Asi kana uchigona kuwana rusununguko hwako, zvitorere mukana wacho. <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />Ndava uyo adodaidziwa muna Ishe ari muranda munhu adosununguka waIshe. Ndomwenzewo nowanga adosununguka pakudaidziwa wava muranda muna Khirisitu. <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />Mudotengewa nomutengo, rekerai kuva varanda vovanhu. <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />Saka, hama, mamiriro yapi zvayene munhu yadodaidziwa ari naMwari, mbaagare daro.<verse eid="1CO 7:24" /></para>
  <para style="s">Mibvunzo pamusoro poVasinai Kuroorana noVajiche</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />Zvino pamusoro povasinai kuroorewa, handinai murairo waIshe, asi ndinopereka pfungwa yangu seuyo adowana tsitsi nokutendeka kubva kuna Ishe.<verse eid="1CO 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 7:26" />Ndinofunga kuti nokuda kwonhamu iripo zvidonaka kuti munhu agare ari zvaari. <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />Udosungiwa pamukadzi chere? Reka kutsvaga kusununguhwa. Udosununguhwa pamukadzi chere? Reka kutsvaga kuroora. <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />Asi kana ukaroora, haunai kutadza, uye kana musikana akaroohwa haanai kutadza. Asi vanoroorana vano zvinetso zvonyika, inini ndinoda kukubisai pazviri.<verse eid="1CO 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29" />Hama, zvandinoreva, nzvokuti nguwa yasara yava ipfupi maninge kubva zvino, avo vano vakadzi mbavararame kunge vasinai, <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />noavo vanorira kuita kunge vasiri kurira, noavo vanofara kunge vasiri kufara, noavo vanotenga kuita kunge vasinai chinhu, <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />noavo vanoshanda nozvinhu zvonyika kunge vasinai kusungiwa nazvo. Ndava mamiriro yonyika ino yarikupfuura.<verse eid="1CO 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32" />Ndinoda kuti musununguke pakushushikana. Murume asinai kuroora anoshushiwa nonyaya dzaIshe kuti angafadze tini Ishe. <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />Asi murume adoroora anoshushiwa nonyaya dzonyika, kuti angafadze tini mukadzi wache, <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />nozvido zvache zvidogovanika. Uye mukadzi asinai kuroohwa kana musikana anoshushiwa nonyaya dzaIshe, kuti angave tini mutsvene pamuviri nopamweya, asi mukadzi adoroorewa anoshushiwa nonyaya dzonyika, kuti angafadze tini murume wache.<verse eid="1CO 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 7:35" />Ndinonyaira izvi kuti zvikunakirei, aikona kukudzipai, asi kuti zvisumudzire kurongeka kudonaka nokuchengeta kuzvipa kwenyu kuna Ishe kusinai kugovanika.<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />Kana pano anofunga kuti haasi kuita mushe kumhandara yaadokonza, kana ano shungu dzidosimba, uye zvichifanira kudaro, mbaaite zvaarikuda: mbavaroorane, chitemaba. <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />Asi upi zvache wazvipira zvidosimba mumwoyo mache, asinai chinomusukumidza asi achigona kuzvidzora, uye kana wazvisunga mumwoyo mache, kuti areke kumuroora, naiyeyu anoitawo zvidonaka. <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />Saka uyo anoroora waadokonza, anoita zvidonaka, uye anoreka kuroora anoita zvidonakitsa.<verse eid="1CO 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39" />Mukadzi adosungiwa kumurume wache kana murumeyo achiri mupenyu. Kana murume wapfa, wasununguka kuti aroorewe nowaanoda, asi mbaave anotenda muna Ishe basi. <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />Asi pakuona kwangu anonyanyitsa kufara kana akagara adodaro. Uye ndinofunga neniwo ndinoMweya waMwari.<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s">Mubvunzo woKuja Zvidobaihwa Zvifananidzo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />Zvino pamusoro pozvokuja zvidoteterehwa kuzvifananidzo,</para>
  <para style="p" vid="1CO 8:1">tinoziva kuti, “tese tino ruzivo.” Ruzivo runosasura, asi rudo runovakha. <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />Kana munhu achifunga kuti ano chaanoziva, haanati waziva sezvaanofanira kuziva. <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />Asi kana munhu achida Mwari, iye anozikana naye.<verse eid="1CO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4" />Zvino, kana kuri kuja zvokuja zvidoteterehwa kuzvifananidzo, tinoziva kuti “chifananidzo chinhuba,” uye kuti “hakunai Mwari asi iye mubodzi.” <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />Ndava kana varipo vanodaidziwa kuti ana “mwari” kudenga kana panyika, sezvavaripo ana “mwari” vadowanda kana “ishe” vadowanda <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />asi kwatiri kunondova naMwari mubodzi, ivo Baba, kunobva zvinhu zvese isisu tiripo nokuda kwavo, naIshe mubodzi Jesu Khirisitu, zvinhu zvese zviripo kuburikidza naiye uye kuburikidza naiye isisu tiripo.<verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />Zvisinei havasi vese vanokuziva kwakareku. Asi vamwe, nokuda kwokudzorovera zvifananidzo kusvika zvino, vanoja zvokuja kunge zvidoteterehwa kuzvifananidzo zvochaizvo, nohana yavo, isinai kusimba, inosvipisiwa. <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />Zvokuja hazvitiisi papfupi naMwari. Tinokungudzaba kuipa kana tikareka kuja, futi kana tikaja hazvitiite hasa.<verse eid="1CO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9" />Chete chenjerai kuti kusungunuka kwenyu kureke kuva chinoguhuna kuno vanohana isinai kusimba. <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />Ndava kana umwe akakuona, iwe uno ruzivo, uri pathafura muimba yozvifananidzo, angareke nai kuita manyemwe yokuja, zvokuja zvidoteterehwa kuzvifananidzo, kana hana yache isinai kusimba? <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />Nopamusaka poruzivo rako munhu uyu asinai simba anoparara, iri hama idopfihwa naKhirisitu. <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />Paunotadzira hama yako uchikuvadza hana yache pakusaya simba kwayene, kwakareku kutadzira Khirisitu. <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />Nokudaro, kana chandinoja chichikonzera kuwa kwohama yangu, ndichareka kuja nyama, kuti ndireke kukonzera hama yangu kuwa.<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s">Kodzero noBasa roNhumwa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />Ndidosunungukaba nai? Ndiriba nhumwa? Ndidoonaba Jesu Ishe wedu? Ko imipa muriba basa rangu muna Ishe? <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />Kana kuno vamwe ndisiri nhumwa, asi kwamuri imipa ndiri, ndava muri chisimbiso chounhumwa hwangu muna Ishe.<verse eid="1CO 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3" />Kwakareku ndiko kuzvidzivirira kwangu kuno avo vanoda kundiwongorora: <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />Hatinai kodzero chere yokuja nokumwa mudzimba dzenyu? <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />Hatinai kudzero chere yokufamba nomudzimai mutendi, sezvinoita vamwe nhumwa novanin'ina’ina vaIshe naKefasi? <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />Kana kuti Bhanabhasi nainini nhisu basi tisinai kodzero yokurekera basa rinotiraramisa? <verse eid="1CO 9:6" /><verse number="7" style="v" sid="1CO 9:7" />Mbani anoita basa rochiuto achizviripira muhoro wega? Mbani anojara munda womizambiringa asingaje muchero yawene? Mbani anorisa boka asingawane mukaka wacho?<verse eid="1CO 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 9:8" />Ndinoreva izvi kubva pamafungiro yomunhu chere? Ko mutemo unonyairaba zvibodzi bodzizvo? <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" />Ndava mumutemo waMozisi zvidonyohwa kuti, “Reka kusunga muromo wodhonza rinopura mapfunde.” Anga Mwari anohanya nomadhonza nai? <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />Anozvinyairaba nai nondava yedu? Zvidonyorehwa isisu. Ndava anogaura noanopura vanofanira kugaura nokupura vachigurupira kukovehwa chirimwa. <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" />Kana tidojara mbeu yomweya pakati penyu, tikadzokohwa zvenyu zvonyika tinenge tanyanyitsa nai? <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />Kana vamwe vachiti vanokodzero yokutsigihwa naimimi, ko kwatiri idotonyanyitsaba nai?</para>
  <para style="p" vid="1CO 9:12">Zvisinei, hatinai kushandisa kodzero yakareyo, asi tinototsunga pachinhu chipi zvachene panokuisa chipinganidzo panzira yovhangeri yaKhirisitu. <verse eid="1CO 9:12" /><verse number="13" style="v" sid="1CO 9:13" />Hamuzive nai kuti avo vanoshanda basa romuimba yaMwari vanowana kuja kwavo kubva muimba yaMwari, noavo vanoshanda paatari vanokovana nayo zvibairo zvinoisiwa pairi? <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" />Nonzira ibodzi bodziyo, Ishe vadoraira kuti avo vanoparidza vhangeri vanofanira kurarama novhangeri.<verse eid="1CO 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15" />Asi inini handinai kushandisa imwe yokodzero dzakaredzo, naipopa handisi kunyorera kuti ndiwane izvozvo. Ndava ndingatoda kupfa panokuti pave noanonditorera chandinozvirumbidza nacho. <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />Ndava kana ndichiparidza vhangeri, ndinowanaba chokuzvirumbidza nacho. Ndava ndizvo zvandinofanira kuita. Mayanga kwandiri kana ndisingaparidze vhangeri! <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />Ndava kana ndichiita zvakarezvo nokuda kwangu, ndinomubairo, asi kana kusiri kuda kwangu, ndiri kundoita zvandidotumiwa nokuvimbiwa naMwari. <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />Zvino mubairo wangu chii? Nguyu basi: kuti mukuparidza kwangu ndipereke vhangeri mahara, ndisingashandise zvizere kodzero dzangu muvhangeri.<verse eid="1CO 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />Nokuti kana nepo ndidosununguka kubva kuvanhu vese, ndidozviita muranda wovese, kuti ndiuyise vazinji kuna Khirisitu. <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />KuvaJudha ndidoita kunge muJudha, kuti ndiuyise vaJudha, kuno vari pasi pomutemo ndidoita kunge ndiri pasi pomutemo - kana zvangu ndisiri pasi pomutemo - kuti ndiuyise vari pasi pomutemo. <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />Kuno avo vari kunze kwomutemo ndidoita kunge ndiri kunze kwomutemo ndisiri asinai mutemo kuna Mwari asi ndiri pasi pomutemo waKhirisitu kuti ndiuyise vari kunze kwomutemo. <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />Kuno vasinai simba, ndidova asinai simba, kuti ndiuyise vasinai simba kuna Khirisitu. Ndidova zvinhu zvese kuvanhu vese, kuti kana zvichikwanisika ndiponese vamwe.<verse eid="1CO 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 9:23" />Ndinoita zvakarezvi zvese nokuda kwovhangeri, kuti ndikovehwe maropafadzo yarene. <verse eid="1CO 9:23" /><verse number="24" style="v" sid="1CO 9:24" />Munozivaba kuti pamujaho vanotizira vese vanokwikwidzana, asi mubodzi ndiye anotambira mubairo? Saka tizirai kuti muuwane. <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />Wese anokwikwidza anozvirovedza muzvinhu zvese. Ivo vanozviitira kuti vawane korona inopera, asi isisu kuti tizviwanire korona isingapere. <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />Inini handiite chimhanyemhanye, handihwi kunge ndinorova mhepo, <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />asi ndinorovedzera muviri wangu ndichiuita muranda wangu, kuti ndamboparidzira vamwe inini ndireke kudzova asingakodzere.<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s">Chenjedzo paNyaya yoZvifananidzo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />Hama ndinoda kuti muzive, kuti madziteteguru vedu vese vanga vari pasi poguti, uye kuti vese vadopinda nomugungwa, <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />uye kuti vese vadoombekewa mugore nomugungwa sevateveri vaMozisi, <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />uye kuti vese vadoja zvokuja zvibodzibodzi zvomweya <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />uye kuti vese vadomwa zvokumwa zvibodzibodzi zvomweya. Ndava vadomwa paDombo romweya ridovaperekedza, uye Dombo rakarero wanga ari Khirisitu. <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />Zvisinei Mwari haanai kufara novazinji vavo, ndava zvitunha zvavo zvidopararira musango.<verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />Manje zvinhu zvakarezvi ichenjedzo kwatiri, kuti tireke kuda zvidoipa kunge zvavadoita ivo. <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />Rekai kunamata zvifananidzo kunge zvidoitiwa novamwe vacho, semanyorehwo yazvidoitiwa, “Vanhu vadogarikika kuti vaje nokumwa ndokusumuka kuti vatambe.” <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />Hatifaniri kuita upombwe kunge zvidoitiwa novamwe vacho, pachibva papfa zviuru makumi mairi nozvitatu pazuva ribodzi. <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />Hatifaniri kuedza Khirisitu, sevamwe vadomuedza vachibva vaparadziwa nonyoka, <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />kana kunyunyuta, sezvidoitiwa novamwe vavo vakaparadziwa nomuparadzi.<verse eid="1CO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11" />Zvino zvinhu izvi zvidoitika kwavari seyambiro kwatiri, uye zvidonyorehwa kutidzidzisa isisu, tidosvikihwa nomagumo yonguwa.<verse eid="1CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 10:12" />Saka uyo anofunga kuti anomira mbaachenjere kuti areke kuwa. <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />Hapanai muedzo udokubatai usiri wovanhu vese. Mwari adotendeka, haakurekei muchiedzewa zvinokunda simba renyu, asi pabodzi nomuedzo anokupasaiwo nzira yokupunyuka, kuti mugone kukunda.<verse eid="1CO 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />Nokudaro, vadikani vangu, tizai kunamata zvifananidzo. <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />Ndinonyaira sekuvanhu vanonzvitsitsa, tongai mega zvandinoreva. <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" />Mukombe wonhendo watinoropafadza, hakusi kuwadzana mugazi raKhirisitu nai? Zingwa ratinokomora, hakusi kuwadzana mumuviri waKhirisitu nai? <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />Nondava yokuti pano zingwa ribodzi, isisu tiri vazinji tiri muiri mubodzi, ndava tese tinokovana zingwa ribodzi.<verse eid="1CO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18" />Fungai vaIzirairi, ko avo vanoja zvibairo vanokovanaba noatari nai? <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />Zvino ndiri kuti chii? Kuti zvokuja zvidoteterehwa kuzvifananidzo, kana chifananidzo chinhu chere? <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />Neye, asi ndinoti zvinobaihwa novahedheni vanozvibaira mashave aikona Mwari. Zvino ndinodaba kuti muyanane nomashave. <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />Hamungamwire pamukombe waIshe nomukombe womashave. Hamungajire pathafura yaIshe nothafura yomashave. <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />Tinoda kumutsa chanje yaIshe chere? Tinomukunda kusimba chere?<verse eid="1CO 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />“Zvinhu zvese zvinotendehwa,” asi hazvisi zvese zvinobatsira. “Zvinhu zvese zviri pamutemo,” asi hazvisi zvese zvinovakha. <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />Mbakureke kuva nomunhu anondotsvaga zvidonakira iye basi, asi zvidonakira vamwe.<verse eid="1CO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25" />Ijai zvese zvinotengesewa pamusika wonyama pasinai chamunobvunza nokuda kwohana, <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />ndava “nyika njaMwari nozvese zviri mairi.”<verse eid="1CO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27" />Kana umwe wovasingatende akakukoka kaja iwewe uchida kuenda, ndoja chese chaisiwa pamberi pako usinai chaunobvunza nokuda kwohana. <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />Asi kana umwe akati kwauri, “Ichi chidobaihwa zvifananidzo,” chireka kuja nokuda kwomunhu wakunyepa, uye nokuda kwohana, <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />ndinoreva hana yache, aikona yako.</para>
  <para style="p" vid="1CO 10:29">Sei kusungunuka kwangu kuchitongewa nohana youmwe? <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />Kana ndikaja ndichitenda, seiko ndichitongewa pamusoro poichocho chandapasira kutenda?<verse eid="1CO 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31" />Saka kana muchija kana kumwa, kana chese chamunoita, itai zvese kuti Mwari akudziwe. <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />Rekai kugumbura vaJudha kana vaGiriki kana kherekhe yaMwari, <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />sezvandinoedza kufadza vanhu vese muzvinhu zvese zvandinoita, ndisingatsvage zvidondinakira, asi zvidonakira vazinji, kuti vaponesewe.<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1" />Ivai vateveri vangu, sezvandinotevera Khirisitu.<verse eid="1CO 11:1" /></para>
  <para style="s">Kufuga Musoro paKunamata</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />Ndinokurumbidzai ndava munondiyeuka muzvinhu zvese uye munochengetedza dzidziso semapasiro yandidokuitai. <verse eid="1CO 11:2" /><verse number="3" style="v" sid="1CO 11:3" />Asi ndinoda kuti muzive kuti musoro womurume wese ndiKhirisitu, musoro womukadzi murume, nomusoro waKhirisitu ndiMwari. <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />Murume wese anonamata kana kuporofita adofuga musoro anozvidza musoro wache, <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />asi mukadzi wese anonamata kana kuporofita asinai kufuga musoro wache anozvidza musoro wache ndozvibodzi bodzizvo nokunge musoro wache udogerewa. <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />Ndava kana mukadzi asingasunge dhuku, mbaagerewe vhudzi ndipo, asi kana zvichinyadzisa kuti mukadzi agerewe kana kusvuuhwa musoro mbaasunge dhuku. <verse eid="1CO 11:6" /><verse number="7" style="v" sid="1CO 11:7" />Ndava murume anodaba kufuga musoro wache, sezvo ari mufananidzo nokubhwinya kwaMwari, asi mukadzi ndiye kubhwinya kwomurume. <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />Ndava murume haanai kuitiwa kubva kumukadzi, asi mukadzi adobva kumurume. <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />Futi murume haanai kusikihwa mukadzi, asi mukadzi adosikihwa murume. <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />Nochikonzero chakarecho, uye nochikonzero chongirozi, mukadzi achifanira kuva nodhuku mumusoro wache kunangidza kuti ari pasi pomasimba. <verse eid="1CO 11:10" /><verse number="11" style="v" sid="1CO 11:11" />Zvisinei, muna Ishe mukadzi anozvimiriraba pasinai murume kana murume pasinai mukadzi, <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />ndava mukadzi adoitiwa kubva kumurume, zvidodarowo murume anoberekewa nomukadzi, asi zvinhu zvese zvinobva kuna Mwari.<verse eid="1CO 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13" />Wongororai imi pachenyu, zvidokohoroka chere kuti mukadzi anamate kuna Mwari ano musoro usinai kufugiwa? <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />Anga masikihwo pachayo yanokudzidzisaiba nai kuti murume akaita vhudzi rirefu zvinonyadzisa, <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />asi kana mukadzi akava novhudzi rirefu, zvinomupa chiremera? Ndava vhudzi rirefu adoripasiwa kuti rimufukidze. <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />Kana pano anoda kuita mhoka, isisu kana kherekhe dzaMwari, hatinai tsika idodaro.<verse eid="1CO 11:16" /></para>
  <para style="s">Chirairo chaIshe</para>
  <para style="r">(<ref loc="MAT 26:26-29">Mateo 26:26-29</ref>; <ref loc="MRK 14:22-25">Mariko 14:22-25</ref>; <ref loc="LUK 22:14-20">Ruka 22:14-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />Pakuraira kunotevera handikupembedzei, ndava pamunosangana nzvobuyaba asi uyanga. <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />Kuthanga, ndinonzva kuti pamunosangana sekherekhe, pano kukamurana pakati penyu, zvimwe zvacho ndinozvitenda. <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />Pasinai kupokana panofanira kunge pano zvikwata zvidosiyana pakati penyu izvi zvinoita kuti avo vari pachokwadi pakati penyu vazikane. <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />Pamunosangana, hachisi chijo chaIshe chamunoja. <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />Ndava pakuja, munhu wese anondoja zvache, umwe ano nzara, mumwe watokorewa. <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />Chii! Hamunai dzimba kwokujira nokumwira nai? Kana kutoti munozvidza kherekhe yaMwari muchinyadzisa vasinai chavanacho? Ndichati chii kwamuri? Ndikutunhidzei pazviri? Nikisi.<verse eid="1CO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23" />Ndava zvandidotambira kubva kuna Ishe ndizvo zvandidokupasai, kuti Ishe Jesu pausiku hwaadopandukihwa adotora zingwa, <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />paadopereka nhendo, adorikomora, achiti, “Uyu muviri wangu udopasiwa imimi. Itai zvakarezvi muchindiyeuka.” <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />Nzvibodzibodzizvo nomukombe, vabva kuja chijo, adoti, “Mukombe uyu chibvumirano chitsva mugazi rangu. Itai zvakarezvi, pese pamunoumwa, ndiyeukei.”<verse eid="1CO 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 11:26" />Ndava pese pamunoja zingwa rakareri nokumwa mukombe, munoparidza ipfa yaIshe kusvikira wauya. <verse eid="1CO 11:26" /><verse number="27" style="v" sid="1CO 11:27" />Manje wese, anoja zingwa kana kumwa mukombe waIshe nomutoo usingakodzere achava nomhosva yokutadzira muviri nogazi raIshe. <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />Munhu mbaazviwongorore, wodzoja zingwa nokumwa pamukombe. <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />Ndava ani zvache anoja nokumwa nokusacherechedza muviri waIshe anoja nokumwira kuti azvitorere kutongewa. <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />Ndicho chikonzero vazinji venyu vadoneta uye vachihwara, vamwe vadotopfa. <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />Asi kana tikazvitonga tega, tinotongewaba. <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />Asi patinotongewa naIshe, tinorangiwa kuti tireke kudzopasiwa mhosva pabodzi nonyika.<verse eid="1CO 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33" />Saka, hama dzangu, pamunoungana kuti muje, miriranai <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />kana pano anonzara, mbaaje kumba kuti mureke kuunganira kupasiwa mhosva. Pamusoro pozvimwe zvinhu ndichakupasai makwara kana ndauya.<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s">Zvipo zvaMweya Mutsvene</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />Hama dzangu, kana zviri zvipo zvomweya,</para>
  <para style="p" vid="1CO 12:1">ndinodaba kuti muve vasingazive. <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />Munoziva kuti pamanga musati mava vatendi, maitsambutsihwa kuzvifananidzo zvisingataure, muchifambisiwa nonzira dzese dzese. <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />Nokudaro ndinoda kuti munzvitsitse kuti hapanai anotaura noMweya waMwari angati “Jesu mbaashurikidziwe!” uye hapanai angati “Jesu ndiShe” asi noMweya Mutsvene.<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />Zvino pano marudzi yozvipo yadosiyana, asi Mweya mubodzibodzi, <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />uye pano marudzi yokushumira yadosiyana, asi Ishe mubodzibodzi, <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />uye pano marudzi yadosiyana yokushanda, asi ndiMwari mubodzibodzi anopasa kugona zvese muvanhu vese. <verse eid="1CO 12:6" /><verse number="7" style="v" sid="1CO 12:7" />Umwe noumwe adopasiwa kuzururira kwoMweya kuti zvibatsire vese. <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />Kuno umwe adopasiwa naMweya kunyaira kwouchenjeri, kuno umwe kunyaira kworuzivo kuburikidza naMweya mubodzibodzi, <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />kuno umwe kutenda naMweya mubodzibodzi, kuno umwe zvipo zvokuporesa naMweya mubodzibodzi, <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />kuno umwe mabasa yominana, kuno umwe kuporofita, kuno umwe kugona kusiyanisa mweya, kuno umwe marudzi mazinji yondimi, kuno umwe kududzira ndimi. <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />Zvese izvi zvinofemehwa naMweya mubodzibodziyo, anopereka sezvaanoda kumunhu nomunhu.<verse eid="1CO 12:11" /></para>
  <para style="s">Muviri Mubodzi unoNhengo Dzizinji</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />Ndava sezvidondoita muviri kuti mubodzi asi unonhengo dzizinji, dzese dziri nhengo dzomuiri, kana dzidowanda zvadzene, dzinondova muviri mubodzi, ndizvo zvidoita Khirisitu. <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />Ndava noMweya mubodzi tese tidoombekewa mumuviri mubodzi vaJudha kana vaGiriki, varanda kana vadosununguka uye tese tidomwa paMweya mubodzi.<verse eid="1CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14" />Ndava muviri unoumbiwaba nonhengo ibodzi asi dzizinji. <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />Kana tsoka ikati, “Ndava handisi ruoko, handisi womuviri,” zvakarezvo zvinoiitaba kuti ireke kuva chikamu chomuviri. <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />Uye kana nzeve ikati, “Nondava yokuti handisi ziso, handisi womuviri,” zvakarezvo zvinoiitaba kuti ireke kuva chikamu chomuviri. <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />Dai muviri wese waiva ziso, ko kunzva kwaidzova poi? Dai muviri wese waiva nzeve, ko kunuhwidza kwaidzova poi? <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />Asi sezvazviri, Mwari adoronga zvidzu mumuviri, chimwe nochimwe sezvaadoda. <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />Dai zvese chaiva chidzu chibodzi, muviri waidzova poi? <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />Sezvazviri, pano zvidzu zvizinji, asi muviri mubodzi.<verse eid="1CO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21" />Ziso haringati kuruoko, “Handina basa newe,” kana musoro kutsoka, “Handina basa nemi.” <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />Asi kutoti, zvidzu zvomuviri zvinoita kunge zvisinai simba ndizvo zvinokoshesewa, <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />nozvidzu zvomuviri zvatinofunga kuti zvinokudziwa pashoma tinozvikudza maninge, nozvidzu zvedu zvisingatambirike tinozvipa chiremera chikuru, <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />asi zvidzu zvedu zvinotambirika hazvinai kukoshesewa kwazvinoda. Asi Mwari adoronga muviri daro, kupereka kukudziwa kukuru kuzvidzu zvidozvidzika, <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />kuti mumuviri mureke kuva nokupesana, asi kuti nhengo dzichengetane. <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />Kana nhengo ibodzi ikashupika, dzese dzinoshupika, kana nhengo ibodzi ikakudziwa, dzese dzinofara pabodzi.<verse eid="1CO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27" />Zvino muri muviri waKhirisitu uye umwe noumwe wenyu inhengo dzawene. <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" />Uye Mwari adoisa mukherekhe pakuthanga nhumwa, pochipiri vaporofiti, pochitatu vadzidzisi, tevere vaiti vominana, tevere varapi, vabatsiri, vatungamiri, vatauri vomarudzi mazinji yondimi. <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />Vese nhumwa nai? Vese mbaporofiti nai? Vese mbadzidzisi nai? Vese vanoita minana nai? <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />Vese vano zvipo zvokurapa nai? Vese vanotaura nondimi nai? Vese vanoturikira nai? <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />Asi nyanyitsai kuda zvipo zvinokosha.</para>
  <para style="p" vid="1CO 12:31">Uye ndichakunangidzai nzira iri nani.<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="s">Rudo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />Kana ndingataure nondimi dzovanhu nodzongirozi, asi ndisinai rudo, ndandova kufurumidza kwodare kana kwosimbi iri kugon’kugon'ohwa. <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" />Kana ndikaporofita, nokunzvitsitsa zvidosvisvika zvese noruzivo rese, uye kana ndinokutenda kwese, zvokutosudurutsa makomo, asi ndisinai rudo, handisi chinhu. <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />Kana ndikapereka zvese zvandinazvo, nokupa muviri wangu kuti upisiwe, asi ndisinai rudo, hapanai chandinowana.<verse eid="1CO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4" />Rudo runo mwoyo murefu futi runyoro, rudo harinai chanje, harizvikudze kana kuzvitutumadza, <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />harinai mutindi, harinai kwangukwangu, harichengete chigumbu, harikaripekaripe kana kunyangarihwa, <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />rudo harifarire zvidoipa, asi rinofarira chokwadi. <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />Rudo rinotsungirira pazvinhu zvese, rinotenda zvese, rinogurupira pazvinhu zvese, rinochiirira pazvinhu zvese. <verse eid="1CO 13:7" /><verse number="8" style="v" sid="1CO 13:8" />Rudo rinoperaba. Asi kana zviri zviporofiti, zvichapfuruka, kana dziri ndimi dzichapera, kana riri ruzivo, richapfuruka. <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />Ndava ruzivo redu harinai kuzara nochiporofiti chedu hachinai kuzara, <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />asi kana zvidozara zvasvika, zvisinai kuzara zvichapamwara.<verse eid="1CO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 13:11" />Pandaiva mwana, ndaitaura semwana, ndaifunga semwana, ndinokufunga sekwomwana, pandidodzokura ndidosiya zvoudiki. <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />Ndava zvino tinoona zvobuzvi kunge pachiringiriro, asi panguwa iyoyo tichaonana zviso zvidonagarana. Zvino ndinoziva chikamu, panguwa iyoyo ndichaziva zvizere, sekuzikana zvizere kwandinoitiwa.<verse eid="1CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13" />Nokudaro kutenda, tariro, norudo, zvitatu izvi ndizvo zvinogara, asi chikuru chazvene ndiro rudo.<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s">Zvimwe paZvipo zvoMweya</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />Vavarirai kuva norudo, uye ditsitsai zvipo zvomweya, kunyanyitsa kuti muporofite. <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />Ndava anotaura noimwe ndimi haatauri kuvanhu asi kuna Mwari, ndava hapanai anomunzvitsitsa, asi anonyaira muMweya zvidohwanda. <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />Asi kunorimwe divi, anoporofita anotaura kuvanhu kuti vavakhike nokukurudzihwa uye kuti vanyaradziwe. <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />Anotaura nondimi anozvivaka iye, asi anoporofita anovakha kherekhe.<verse eid="1CO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5" />Zvino ndinoda kuti mese mutaure nondimi, asi zvikuru kuti muporofite. Anoporofita mukuru kukunda anotaura nondimi, kunze kwokunge pano mududziri, kuitira kuti kherekhe ivakhike. <verse eid="1CO 14:5" /><verse number="6" style="v" sid="1CO 14:6" />Zvino, hama, kana ndikauya kwamuri ndichitaura nondimi, ndinokubatsirai tini kunze kwokuti nditaure kwamuri kuzururihwa kana ruzivo kana chiporofiti kana dzidziso?<verse eid="1CO 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 14:7" />Kana zvinoridziwa zvisinai upenyu, zvidoita sechinonje, kana kamukubwe, zvikasasiyanisa muririro, munhu angazive tini chirikuridziwa? <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />Kana hwamanda ikareka kupa musiyano, mbani angagadzirire kohwa? <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />Ndomwenze imipa, kana mukataura shoko mundimi dzisingazikane, zvinorehwa zvingazikane tini? Ndava munenge muchitotaura kumhepo. <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />Pasina kupokana pano mitauro mizinji munyika, futi hapanai usinai zvaunoreva, <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />asi kana ndisingazive zvinoreva mutauro, ndichava mubvakure kumutauri nomutauri achiva mubvakure kwandiri. <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />Ndozvazvidoita naimipa, sezvo muchiditsa zvipo zvomweya, tsvagai zvinovakha kherekhe.<verse eid="1CO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13" />Uyo anotaura nondimi mbaanamatire kudzidudzira. <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />Ndava kana ndikanamata nondimi, mweya wangu unonamata asi pfungwa yangu inosaya chibereko. <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />Saka ndoita tini? Ndichanamata nomweya ndodzonamatawo nopfungwa, ndichaimba nomweya ndodzoimbawo nopfungwa. <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />Zvino kana muchirumbidza nomweya, munofunga murendo arimo angati “Ameni” tini kana asingazive zvamuri kutaura? <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />Ndava mungatopa kutenda zvidokwana, asi umwe asiri kuvakhika.<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />Ndinotenda Mwari kuti inini ndinotaura nondimi kukunda mese, <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />zvisinei, mukherekhe ndingatoda kutaura mashoko mashano yanonzvitsitsiwa, kuitira kuti ndidzidzise vamwe, panokuti nditaure nondimi mashoko yasingaverengeke.<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />Hama, rekai kuva kufunga sevana, asi panozvidoipa ivai sevana, uye pakufunga kwenyu muve vakuru. <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" />Mumutemo mudonyohwa,</para>
  <para style="q1" vid="1CO 14:21">“Ndichataura kuvanhu vakareva</para>
  <para style="q2" vid="1CO 14:21">ndichishandisa vanhu vomutauro wodzimwe ndimi</para>
  <para style="q1" vid="1CO 14:21">uye nomiromo yovatohwa</para>
  <para style="q2" vid="1CO 14:21">asi kunyange zvidodaro havasi kudzonditeerera.” Ndizvo zvinonyaira Ishe.<verse eid="1CO 14:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="1CO 14:22" />Saka, ndimi chiratidzo aikona kuvatendi asi kuno vasingatendi, asi kuporofita hakusi kwovasingatende, asi nghovatendi.<verse eid="1CO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 14:23" />Zvino, kana kherekhe yese yaungana, vese vachitaura nondimi, vokunze kana kuti vasingatende vakapinda, vangatotiba munopenga? <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />Asi kana vese vakaporofita, asingatende kana kuti wokunze akapinda, anokomwesewa novese kuti mutadzi, <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />zvidosvisvika zvomwoyo wache zvinoisiwa pachenu, zvokuti, anowa nochiso chache, achinamata Mwari nokuziva kuti, “Mwari ari pakati penyu zvochokwadi.”<verse eid="1CO 14:25" /></para>
  <para style="s">Kurongeka mukherekhe</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />Chiiko zvino, hama? Pamunosangana, umwe noumwe anochimbo, chidzidzo, kuzururihwa, ndimi, kana kududzira. Zvinhu zvese mbazviitihwe kuvaka. <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />Kana pakava noanotaura nondimi mbapandoita vairi chete vakawanditsa vave vatatu, vachiita mubodzi mubodzi panguwa, uye umwe mbaadudzire. <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />Asi kana pasinai anodudzira, vese mbavanyarare mukherekhe, iye azvinyairire uye anyaire kuna Mwari. <verse eid="1CO 14:28" /><verse number="29" style="v" sid="1CO 14:29" />Mbapave novaporofiti vairi kana vatatu vanonyaira, vamwe mbavaongorore zvinonyaihwazvo. <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />Kana kuzururihwa kwapasiwa kunoumwe adogarikika pakarepo, mutauri wokuthanga mbaanyarare. <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />Ndava mese munogona kuporofita mubodzi mubodzi, kuitira kuti vese vadzidze uye vese vakurudzihwe. <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />Uye mweya wovaporofiti unozviisa pasi povaporofiti, <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />ndava Mwari haasi wonyongano asi ngworunyararo.</para>
  <para style="p" vid="1CO 14:33">Asi sezvidoita mukherekhe dzese dzovatsvene, <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />vakadzi mbavagare vadonyarara mukherekhe. Ndava vanotendehwaba kutaura, asi vanofanira kuzviisa pasi, sezvinoreva mutemo. <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />Kana panochavanoda kuziva, mbavabvunze varume vavo kumba. Ndava zvinonyadzisa kuti mukadzi ataure mukherekhe.<verse eid="1CO 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36" />Ko shoko raMwari ridothangiwa naimimi chere? Kana kuti ridondosvika kwamuri imimi basi? <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />Kana pano anofunga kuti muporofiti, kana ngwomweya, anofanira kuona kuti zvandiri kukunyorerai kuraira kwaIshe. <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />Kana aripo asingaone izvi, iye mbaareke kuzikana.<verse eid="1CO 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39" />Saka hama dzangu, nyanyitsai kuda kuporofita, uye rekai kurambidza kutaura nondimi, <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />asi zvinhu zvese mbazviitiwe nonzira idofanira idorongeka.<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s">Kumuka kwoVadopfa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />Zvino ndinoda kukuyeuchidzai, hama, mutoo wandidokuparidzirai vhangeri, ramudotambira, noramudomira mariri, <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />ramunoponesewa naro, kana mukabatitsitsa shoko randidokuparidzirai kunze kwokunge mudotenda zvisipo.<verse eid="1CO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3" />Zvandidotambira zvinokosha ndizvo zvandidokupasai pakuthanga zvokuti: Khirisitu adopfira zvitema zvedu maererano noMagwaro, <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" />kuti adovigiwa, uye kuti adomutsiwa nozuva rochitatu zviri maererano nomagwaro, <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" />uye kuti adozvinangidza kuna Kefasi, pasure kunogumi novairi. <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />Pasure adozvinangidza panguwa ibodzi kuhama dzinodarika mazana mashano, vazinji vacho mbapenyu, kana nepo vamwe vapfa. <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />Ipopo adodzozviratidza kuna Jakobho, pasure kunhumwa vese.<verse eid="1CO 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 15:8" />Pakupedzisira, adozvinangidzawo kwandiri kunge uye adozvahwa nguwa isinati yakwana. <verse eid="1CO 15:8" /><verse number="9" style="v" sid="1CO 15:9" />Ndava ndiri mudiki kunhumwa vese, ndinofaniraba kuitiwa nhumwa, nokuti ndidotambudza kherekhe yaMwari. <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />Asi nonyasha dzaMwari ndiri zvandiri, uye mutsa dzache kwandiri dzanga dzisiri pasina. Panokuti zvidaro, ndidoshanda zvidosimba kukunda ivo vese, kana nepo ndisiri inini, asi mutsa dzaMwari dzanga dzineni. <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />Angave inini kana ivo, izvi ndizvo zvatidoparidza, imimi muchibva mazvitenda.<verse eid="1CO 15:11" /></para>
  <para style="s">Kumuka Kwedu</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />Zvino kana Khirisitu achiparidziwa kuti adomuka kuvadopfa, vamwe venyu vanotaura seiko kuti hakunai kumuka kwovadopfa? <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />Asi kana pasinai kumuka kwovadopfa, kana naKhirisitu haanai kumuka ndipo, <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />kana Khirisitu asinai kumutsiwa, kuparidza kwedu hakunai basa nokutenda kwenyu hakunai basa. <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />Kunyanyitsa isisu tinowanika tiri zvapupu zvaMwari zvomabwodo, ndava tidopupurira Mwari kuti adomutsa Khirisitu, waasinai kumutsa kana zviri izvo kuti vadopfa havamuke. <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />Ndava kana vadopfa vasingamutsiwe, kana Khirisitu haanai kumutsiwa. <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />Kana Khirisitu asinai kumutsiwa, kutenda kwenyu hakunai kabonyo, muchiri muzvitema zvenyu. <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />Naivo vadopfa muna Khirisitu vadotaika. <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />Kana muupenyu huno muri imo chete munotariro yedu muna Khirisitu, tinosiririsa kukunda vanhu vese.<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />Asi zvochaizvo Khirisitu adomuka kuvadopfa, chibereko chokuthanga chovadopfa. <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />Ndava ipfa sezvaidouya nomunhu, kumuka kwovadopfa kudouyawo nomunhu. <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />Nokuti vese zvavanopfa muna Adhamu, ndomwenze kamu muna Khirisitu vese vachava vapenyu. <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />Asi umwe noumwe pazoro rache: Khirisitu chibereko chokuthanga, tevere avo vari vaKhirisitu pakuuya kwache. <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />Ipopo kuguma kwodzouya, paachapereka umambo kuna Mwari Baba kana waparadza utongi kwese noukuru hwese nomasimba. <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />Ndava anofanira kutonga kusvikira waisa vavengi vache vese pasi potsoka dzache. <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />Muvengi wokupedzisira kuparadziwa ipfa. <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />Ndava gwaro rinoti “Mwari adoisa zvinhu zvese pasi potsoka dzache,” Asi kana zvichinzi, “Zvinhu zvese zvidoisiwa pasi pache,” zviri pachenu kuti kunondosara iye nyakuisa zvinhu zvese pasi paKhirisitu. <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />Kana zvinhu zvese zvava pasi pache, ipopo Mwanakomana pachake achavawo pasi paiye nyakuisa zvinhu zvese pasi pache, kuti Mwari ave zvese kumunhu wese.<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />Kana zvisinai kudaro, chii chichaitiwa kuno avo vanoombekehwa adopfa? Kana vadopfa vasingadzomuka, seiko vanhu vachiombekehwa adopfa? <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />Ko isisu seiko tichizviisa panyatwa nguwa yese <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />uye sei ndichinangarana noipfa mazuva yese? Izvi nzvochokwadi sezvandinozvirumbidza nokuda kwenyu muna Khirisitu Jesu Ishe wedu. <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />Kana ndidozviitira vanhu kuti ndidohwa nozvirombo zvomusango paEfeso, zvinondipeiko? Kana vadopfa vasingamutsiwe, “Mbatije nokumwa, ndava mangwana tichapfa.”<verse eid="1CO 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33" />Rekai kunyengedzewa, “Shamwari dzidoipa dzinoodza unhu hudonaka.” <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />Dzokai papfungwa dzidonaka, murekere kumbotadza. Ndava vamwe venyu vanozivaba Mwari. Ndinozvinyaira kuti munyare.<verse eid="1CO 15:34" /></para>
  <para style="s">Muviri Wokumuka</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />Asi umwe angabvunze, “Anga vadopfa vanomuka tini? Vanouya nomuviri udoita tini?” <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />Iwe dzemwa romunhu! Chaunojara hachimere kunze kwokunge chapfa. <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />Futi unojaraba muviri uchavapo, asi mbeu basi, pamwe yogorosi kana yozvimwe. <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />Asi Mwari anoipasa muviri sezvaanosarudza, uye kurudzi rombeu yegayega anoipasa muviri wayene.<verse eid="1CO 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 15:39" />Ndava nyama yese hainai kufanana, asi imwe njomunhu, imwe njomhuka, imwe njotushiri, noimwe njohove.<verse eid="1CO 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40" />Pano miviri yokudenga nomiviri yopanyika, asi kubhwinya kwoyokudenga nghumwe, nokubhwinya kwoyopanyika nghumwe. <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />Pano kubhwinya kwozuva, nokumwe kubhwinya kwomwedzi, uye kumwe kubhwinya nghonyenyedzi, nonyenyedzi inosiyana noimwe nyenyedzi pakubhwinya.<verse eid="1CO 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42" />Zvakarezvo ndizvo zvichaita kumuka kwovadopfa. Muviri udovikiwa uchiora, unomutsiwa uri muviri usingaore. <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />Unovikhiwa uri mukuzvidziwa, unomutsiwa uri mukubhwinya. Unovikhiwa udovhuwa, unomutsiwa uri musimba. <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />Unovikhiwa uri muviri wonyama, unomutsiwa uri muviri womweya. Kana panomuviri wonyama, nomuviri womweya uripowo. <verse eid="1CO 15:44" /><verse number="45" style="v" sid="1CO 15:45" />Saizvozvo kudonyohwa kuti, “Munhu wokuthanga Adhamu adova munhu mupenyu,” Adhamu wokupedzisira adova mweya unopasa upenyu. <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />Asi zvomweya ndizvoba zvidothanga asi zvonyama, pachidzotevera zvomweya. <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />Munhu wokuthanga wanga ari wonyika, adoitiwa noivhu, munhu wochipiri adobva kudenga. <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />Sezvanga zvidoita munhu woivhu, ndizvo zvidoitawo ivo voivhu, uye sezvidoita munhu wokudenga, ndizvo zvidoitawo vokudenga. <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />Sezvatidova nochimiro chomunhu woivhu, tichavawo nochimiro chomunhu wokudenga.<verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />Ndinokuudzai izvi, hama: nyama nogazi zvingagareba nhaka youmambo hwaMwari, kana chinoparara kugara nhaka yochisingaparare.<verse eid="1CO 15:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="1CO 15:51" />Onai! Ndinokuudzai chidosvisvika. Hatingapfe tese, asi tese tichasanduhwa, <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />kundoti ngwezu, kunge kuboira kwoziso, pahwamanda yokupedzisira. Ndava hwamanda icharira, vadopfa vachamuka vasisaparare, uye tichasanduhwa. <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />Ndava muviri uyu unoparara unofanira kusimira kusaparara, nomuviri wakareyu unopfa unofanira kusimira muviri usingapfe. <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" />Kana muviri unoparara wasimira kusaparara, nomuviri unopfa wasimira kusapfa, ipopo pachaitika kutaura kudonyohwa, “Ipfa yamedzewa nokukunda.”<verse eid="1CO 15:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="1CO 15:55" />“Iwe ipfa, kukunda kwako kuri poi?</para>
  <para style="q1" vid="1CO 15:55">Iwe ipfa karumborera kako kari poi?”<verse eid="1CO 15:55" /></para>
  <para style="m">
    <verse number="56" style="v" sid="1CO 15:56" />Kupfonda kwoipfa ndicho chitema, nosimba rochitema ndiwo mutemo. <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />Asi Mwari mbaatendewe! Adotipasa kukunda kuburikidza naIshe wedu Jesu Khirisitu.<verse eid="1CO 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58" />Nokudaro, hama dzangu dzinodikana, mirai mudosimba, pasinai chinokutsukunyutsai, nyanyitsai kuita basa raIshe, muchiziva kuti muna Ishe kushanda kwenyu hakusi kwomahara.<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s">Zvipo Zvovatendi Vanosaya</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />Zvino pamusoro pokuunganidzira vatsvene, itai sezvandidoraira kukherekhe dzopaGaratiya. <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />Pazuva rokuthanga kwosondo rimwe norimwe, umwe noumwe wenyu mbaaise imwe mari padivi maererano nomawaniro yache, moichengeta, kuitira kuti pandinouya parege kudzova nokuunganidza kunodzoitiwa. <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />Uye pandinosvika, ndichatuma nomatsamba avo vamunopupurira kuti vaendese chipo chenyu kuJerusarema. <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />Kana zvidofanira kuti inini ndiendewo, vachabatana nainini.<verse eid="1CO 16:4" /></para>
  <para style="s">Urongwa hwaPhauro</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />Ndichauya kwamuri musure mokupinda nomuMesodhoniya, ndava ndichapinda nomuMesodhoniya, <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />pamwe ndichagara nemi kwonguwa, kana kutosvika pakupera kwochando, kuitira kuti mundibatsire pahwendo hwangu, kwese kwandichaenda. <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />Ndava handidi kukuonai zvino zvomapinda nzira, ndinotarisira kupedza nguwa naimimi, kana Ishe vatendera.<verse eid="1CO 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8" />Asi ndichagara paEfeso kusvika paPendekositi, <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />ndava musuwo mukuru wokuita basa udondizurukira, uye vanopikisana neni mbazinji<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />Kana Timoti wauya, ivai nochokwadi kuti anenge asinai chaanocha pakati penyu, ndava ari kuita basa raIshe, kunge inini. <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />Saka hapanai anofanira kumuzvidza. Asi muendesei panzira yache norugare, kuti adzoke kwandiri, ndava ndiri kumutarisira pabodzi nohama.<verse eid="1CO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12" />Kana iri hama yedu Aporo, ndinomukumbira chaizvo kuti auye kwamuri nodzimwe hama, wanga asingade kuti auye manje. Asi achauya kana wawana mukana.<verse eid="1CO 16:12" /></para>
  <para style="s">Mazvi yoKupedzisira</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />Chenjerai, mumire mudosimba pakutenda, ivai vanhu vadoshinga, ivai nosimba. <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />Zvese zvamunoita mbazviitiwe murudo.<verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15" />Munoziva kuti voimba yaSitefanasi ndivo vaiva vatendi vokuthanga muAkaya, uye vadozvimisira kushumira vatsvene. Ndinokukumbirai, hama, <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />kuti muzviise pasi povanhu vadodaiva nouyo wese anopinda mubasa iri nokushanda pariri.<verse eid="1CO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17" />Ndinofara nokuuya kwaSitefanasi naFotunatusi naAkaikasi, ndava vadopereka zvidosaika kubva kwamuri pamanga musipo, <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />nokuti vadomutsiridza mweya wangu nowenyu. Vanhu vadodarovo mbovaremekedzai.<verse eid="1CO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />Kherekhe dzokuEzhiya dzatumira kwaziso. Akwira naPurisika, pabodzi nokherekhe iri mumba mavo, vatumira kwaziso dzopamwoyo muna Ishe. <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />Hama dzese dzatumira kwaziso.</para>
  <para style="p" vid="1CO 16:20">Moresanai nokutsvodana kutsvene.<verse eid="1CO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21" />Inipano Phauro, ndanyora kwaziso yakarei noruoko rangu chairo.<verse eid="1CO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22" />Kana pano asinai rudo naIshe, mbaashurikidziwe.</para>
  <para style="p" vid="1CO 16:22">Uyai Ishe!<verse eid="1CO 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23" />Mutsa dzaIshe Jesu mbadzive nemi.<verse eid="1CO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24" />Rudo rangu mbarive nemi mese muna Khirisitu Jesu. Ameni.<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>