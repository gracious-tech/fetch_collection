<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="TIT" style="id">- Kuturikihwa kwoBhaibhiri muchiKoreKore</book>
  <para style="h">Tito</para>
  <para style="toc1">Tsamba raPhauro kuna Tito</para>
  <para style="toc2">Tito</para>
  <para style="toc3">Tit</para>
  <para style="mt2">Tsamba raPhauro Kuna</para>
  <para style="mt1">TITO</para>
  <para style="imt">Kuwidzira</para>
  <para style="ip">Tsamba raTito ndorimwe romatsamba manai yadonyohwa naPhauro achinyorera kumunhu pachinzvimbo chokukherekhe. Yamwe matsamba matatu ndiTimoti wokuthanga, Timoti wochipiri naFirimoni. Phauro wanga achinyorera Tito, asi adonyora sekunge tsamba rache raidzoverengewa kuvazinji. Tinogona kuziva zvakarezvi nondava yokuti adotsanangura chinzvimbo chache senhumwa, chinova chinhu changa chichizikana naTito. Phauro anogona kunge adonyora tsamba rakareri pakati ponguwa inenge makore makumi matanhatu nomatatu kusvika makore makumi matanhatu nomashano mumasure mokuzvahwa kwaKhirisitu.</para>
  <para style="ip">Phauro wanga agara waraira Tito kuti atungamirire makherekhe yanga yari pachitsuwa choKhireti. Phauro adonyora tsamba rakareri kuti araire Tito pamusoro pokusarudza nokufundisa vatungamiri vomakherekhe. Adopasa kuraira kubodzibodziko mumatsamba yache kuna Timoti. Tsamba rache rinotsanangura kuti vatungamiriri vokherekhe vanofanira kuremekedzewa zvopamusoro. Makherekhe novatungamiriri vokherekhe vanasi vanofanira kuchenjerera kuti vave nochiyero chinodiwa kuno avo vari muutungamiri.</para>
  <para style="iot">Marongehwo</para>
  <para style="io1">Phauro anoraira Tito kuti agadze vatungamiri vanocha Mwari (Tito 1:1-16)</para>
  <para style="io1">Adodzomuraira pakare kuti afundise vanhu kuti vararame vachicha Mwari (Tito 2:1—3:11)</para>
  <para style="io1">Pakupedzisira Phauro anopedzisa nokukovana naye urongwa hwache nokumoresa (Tito 3:12-15)</para>
  <chapter number="1" style="c" sid="TIT 1" />
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1" />Kubva kuna Phauro, mushandi waMwari noNhumwa yaJesu Khirisitu, yokuingidzira kutenda kwovadosarudziwa naMwari nokuziva kwavo chokwadi chinoenderana nokucha Mwari, <verse eid="TIT 1:1" /><verse number="2" style="v" sid="TIT 1:2" />mutariro youpenyu husingapere, hudovimbisiwa naMwari asinganyepe nguwa isinati yavapo, <verse eid="TIT 1:2" /><verse number="3" style="v" sid="TIT 1:3" />futi panguwa idofanira zvidonangidziwa mushoko rache kuburikidza nokuparidza kwandidovimbiwa nako nokuraira kwaMwari Muponisi wedu.<verse eid="TIT 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="TIT 1:4" />Kuna Tito, mwana wangu chaiye pakutenda kwedu tese.</para>
  <para style="p" vid="TIT 1:4">Mutsa norugare zvinobva kuna Mwari Baba naKhirisitu Jesu Muponisi wedu mbazvive kwauri.<verse eid="TIT 1:4" /></para>
  <para style="s">Basa raTito muKhirete</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5" />Ndosaka ndidokusiya paKhireti kuti upedzise kugadzira zvidosara, nokugadza vakuru vokherekhe muguta rimwe norimwe sekukuraira kwandidokuita, <verse eid="TIT 1:5" /><verse number="6" style="v" sid="TIT 1:6" />mutariri wokherekhe anofanira kuva munhu asinai chaanonenedzehwa, murume womukadzi mubodzi, anovana vanotenda vasingapasiwe mhosva yokusazvidzora kana kuti vanoteereraba. <verse eid="TIT 1:6" /><verse number="7" style="v" sid="TIT 1:7" />Nokuti mutariri wobasa raMwari anofanira kuva munhu asinai chinhu chaanonenedzehwa, anofanira kuva asinai nharo kana anokurumidza kugumbuka kana anokorewa kana anoita botso kana anonhafu yomari, <verse eid="TIT 1:7" /><verse number="8" style="v" sid="TIT 1:8" />asi anobata varendo zvidonaka, anoda zvidonaka, anozvibata, adorurama, mutsvene, futi anozvidzora, <verse eid="TIT 1:8" /><verse number="9" style="v" sid="TIT 1:9" />anofanira kubatitsitsa shoko rochokwadi ridovimbika sezvarinodzidzisiwa, kuitira kuti agone kuraira vamwe nodzidziso idorurama, nokugona kukohorora vanoipikisa.<verse eid="TIT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10" />Nokuti varipo vadowanda vasingateerere, vanotaura zvisinai maturo novanyengedzi, kunyanya vaye voboka rovadochecheudziwa, <verse eid="TIT 1:10" /><verse number="11" style="v" sid="TIT 1:11" />vanofanira kuvhariwa miromo yavo, nokuti vari kugumbura mhuri dzidowanda nokudzidzisa zvavasingafanire asi vanozviitira kuwana pfuma nokusatendeka. <verse eid="TIT 1:11" /><verse number="12" style="v" sid="TIT 1:12" />Umwe muporofiti wavo, adoti, “VaKhirete vanogara vachinyepa, vanenge zvirombo zvidoipa, vanonungo vanonhafu.” <verse eid="TIT 1:12" /><verse number="13" style="v" sid="TIT 1:13" />Kunyaira kwakareku ngwochokwadi. Naizvozvo uvadzume zvidosimba kuti vave vadorurama pakutenda, <verse eid="TIT 1:13" /><verse number="14" style="v" sid="TIT 1:14" />pachinzvimbo chokutetekera kuzvinzano zvochiJudha kana kumirairo yovanhu vanoramba chokwadi. <verse eid="TIT 1:14" /><verse number="15" style="v" sid="TIT 1:15" />Kuno vadochena zvese zvidochena, asi kuno vadoora vasingatende, hakunai chinhu chidochena, asi mifungo yavo nohana dzavo zvidoodzewa. <verse eid="TIT 1:15" /><verse number="16" style="v" sid="TIT 1:16" />Vanoti tinoziva Mwari, asi vanomuramba nozviito zvavo, mbaye vasingadike, vasingateerere, vasinai kukodzera kuita basa ripi zvarene ridonaka.<verse eid="TIT 1:16" /></para>
  <chapter eid="TIT 1" />
  <chapter number="2" style="c" sid="TIT 2" />
  <para style="s">Dzidziso Idorurama</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1" />Asi kana uri iwewe, dzidzisa zvinoenderana nodzidziso idorurama. <verse eid="TIT 2:1" /><verse number="2" style="v" sid="TIT 2:2" />Raira varume vakuru kuti vave vadosvinuka, vanoremekedzeka, vanozvidzora, vadorurama pakutenda, parudo, nopakutsungirira. <verse eid="TIT 2:2" /><verse number="3" style="v" sid="TIT 2:3" />Nonzira ibodzi bodziyo dzidzisa vakadzi vakuru kuti vave nounhu hunoremekedzeka, vareke kuva nomakuhwa kana kuva varanda vokumwa. Vanofanira kudzidzisa zvidonaka, <verse eid="TIT 2:3" /><verse number="4" style="v" sid="TIT 2:4" />kuti vadzidzise vakadzi vochidiki kuti vade varume vavo, nokuda vana vavo, <verse eid="TIT 2:4" /><verse number="5" style="v" sid="TIT 2:5" />kuti vave vanozvidzora, vadochena, vanochengeta imba, vanotsitsi, vanozviisa pasi povarume vavo, kuti shoko raMwari rireke kushorewa.<verse eid="TIT 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6" />Nonzira ibodzibodziyo kurudzira varume vechidiki kuti vave vanozvibata. <verse eid="TIT 2:6" /><verse number="7" style="v" sid="TIT 2:7" />Pazvinhu zvese iwepa pachako unofanira kuvanangidza muenzaniso udonaka pamaitiro yadonaka, futi nangidza kutendeka pakudzidzisa, iva nomugariro unoremekedzeka, <verse eid="TIT 2:7" /><verse number="8" style="v" sid="TIT 2:8" />nokunyaira kudorurama, kusingashoreke, kuitira kuti anopikisana naisisu anyadzisiwe, asaye chinhu chidoipa chokunyaira pamusoro pedu.<verse eid="TIT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9" />Raira varanda kuti vazviise pasi paatenzi vavo, vavafadze pazvinhu zvese vasingaite nharo, <verse eid="TIT 2:9" /><verse number="10" style="v" sid="TIT 2:10" />kana kuvabira, asi vanangidze kutendeka kudonaka kudozara, kuti pazvinhu zvese dzidziso yaMwari Muponisi wedu iyemurike.<verse eid="TIT 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11" />Nokuti mutsa waMwari udooneka unovigira vanhu vese kuponesewa, <verse eid="TIT 2:11" /><verse number="12" style="v" sid="TIT 2:12" />unotidzidzisa kuti tirambe kusanamata Mwari nokuchiva zvonyika, kuti tirarame tidobanganuka, tichizvidzora tidorurama, noupenyu hwoumwari munyika ino yanasi, <verse eid="TIT 2:12" /><verse number="13" style="v" sid="TIT 2:13" />tidomirira tariro idoropafadziwa, yokuoneka kwokubhwinya kwaMwari wedu mukuru naMuponisi Jesu Khirisitu, <verse eid="TIT 2:13" /><verse number="14" style="v" sid="TIT 2:14" />iye adozvipa nokuda kwedu kuti atidzikinure kubva pazvidoipa zvese kuti azvinatsire vanhu vache chaivo, vanoshingairira mabasa yadonaka.<verse eid="TIT 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15" />Nyaira zvinhu zvakarezvi, kurudzira nokutsiura nosimba rese. Mbakureke kuva nomunhu anokuzvidza.<verse eid="TIT 2:15" /></para>
  <chapter eid="TIT 2" />
  <chapter number="3" style="c" sid="TIT 3" />
  <para style="s">Unhu hwomuKhirisitu</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1" />Ufungise vatendi kuti vazviise pasi povatongi novanomasimba, kuti vateerere, vadozvigadzirira kushanda mabasa yese yadonaka, <verse eid="TIT 3:1" /><verse number="2" style="v" sid="TIT 3:2" />vareke kunyaira zvidoipa pamusoro poumwe munhu, vareke kupopotedzana, kuti vave vanyoro, futi kuti varatidze rukudzo kuvanhu vese. <verse eid="TIT 3:2" /><verse number="3" style="v" sid="TIT 3:3" />Nokuti isisu pachedu kare taiva madzemwa, tisingateerere, tichitsambutsiwa, tiri varanda vokuchiva kuzinji nozvinofadza, tichipedzera mazuva yedu pakuva nongetani nokuitirana chanje, tichizondewa novanhu futi tichizondana. <verse eid="TIT 3:3" /><verse number="4" style="v" sid="TIT 3:4" />Asi padooneka kunaka nounyoro hwaMwari Muponisi wedu, <verse eid="TIT 3:4" /><verse number="5" style="v" sid="TIT 3:5" />adotiponesa aikona nokuda kwomabasa yadonaka yatidoita, asi nokuda kwomutsa wache adotiponesa nonzira yokushambidza kwokuzvahwa patsva nokuvandudziwa naMweya Mutsvene, <verse eid="TIT 3:5" /><verse number="6" style="v" sid="TIT 3:6" />waadodurura achiwanza patiri kuburikidza naJesu Khirisitu Muponisi wedu, <verse eid="TIT 3:6" /><verse number="7" style="v" sid="TIT 3:7" />kuti musure mokururamisiwa nomutsa wache tiitiwe vaji vonhaka maererano notariro youpenyu husingapere. <verse eid="TIT 3:7" /><verse number="8" style="v" sid="TIT 3:8" />Kunyaira kwakareku nghokwochokwadi.</para>
  <para style="p" vid="TIT 3:8">Ndinoda kuti iwepa usimbise zvinhu zvakarezvi, kuitira kuti avo vadotenda muna Mwari vachenjere kuva vanoita mabasa yadonaka, zvakarezvi zvidonakitsa futi zvinobatsira vanhu. <verse eid="TIT 3:8" /><verse number="9" style="v" sid="TIT 3:9" />Asi nzvenga mibvunzo youdzemwa, mazita yomadziteteguru, nharo, nonharo pamusoro pomutemo, nokuti zvinobatsiraba futi hazvinai maturo. <verse eid="TIT 3:9" /><verse number="10" style="v" sid="TIT 3:10" />Asi kumunhu anopesanisa, ukamudzuma kabodzi kana kairi, musiirefuti, <verse eid="TIT 3:10" /><verse number="11" style="v" sid="TIT 3:11" />uchiziva kuti munhu adodaro watsambuka futi mutadzi iyeyo, wazvitongera mhosva wega.<verse eid="TIT 3:11" /></para>
  <para style="s">Kuraira Kwokupedzisira</para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12" />Pandinotuma Atemasi kana Tikikasi kwauri, edza nopaunogona napo pese kuuya kwandiri kuNikopori, nokuti ndasarudza kuva kwakareku panguwa yomhepo. <verse eid="TIT 3:12" /><verse number="13" style="v" sid="TIT 3:13" />Ita zvese zvaunokona nokukurumidza kubatsira Zenasi gweta naAporo pahwendo hwavo, uone kuti vanozvese zvavanoda. <verse eid="TIT 3:13" /><verse number="14" style="v" sid="TIT 3:14" />Futi vanhu vedu mbavadzidzewo kuramba vachiita mabasa yadonaka, kuitira kuti vabatsire kupasa zvinhu zvinenge zvichidiwa kamangu, futi voreka kuva vasinai zvibereko.<verse eid="TIT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15" />Vese vandinavo vari kukumoresa. Ndimoresereiwo avo vanotida pakutenda.</para>
  <para style="p" vid="TIT 3:15">Mutsa mbauve nemi mese.<verse eid="TIT 3:15" /></para>
  <chapter eid="TIT 3" />
</usx>