<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- Santhali Project</book>
  <para style="h">आपोस का़मि</para>
  <para style="toc3">आ का़</para>
  <para style="toc2">आपोस का़मि</para>
  <para style="toc1">आपोसतोलकोवाक् का़मिको</para>
  <para style="mt2">प्रेरितहरुको काम</para>
  <para style="mt1">आपोसतोलकोवाक्‌ का़मिको</para>
  <para style="imt">ओपोरोम</para>
  <para style="ip">आपोसतोलकोवाक्‌ का़मिको रेयाक्‌ पुथि दो का़लिसिया़ रेयाक्‌ एतोहोप्‌ रेयाक्‌ का़हनि काना आर चेत्‌लेका जिसु सेरमातेये चालाक्‌ खोन लाहारे आच्‌रेन चेलाकोय ला़इयात्‌को ताहेंकान ओनकागे जेरुसालेम खोन जिहुदिया़, सा़मा़रिया़रे आर ओना खोन बाहरे हा़बिच्‌ चेत्‌लेका पासनावेना नोवा रेयाक्‌ का़हनि काना <char style="xt"><ref loc="ACT 1:8">आ का़ १:८</ref> </char>ओकोय लुक रेयाक्‌ भागे सोमबाते ओल लेत्‌ उनि लुकगे नोवा पुथि होंए ओल आकात्‌आ। उनि दो मित्‌टेन रारानिच्‌ए ताहेंकाना आर उनि दो आ़डि हुसिया़र सालाक्‌ ओलोक्‌ का़मिरे गा़खुड़िया़इ ताहेंकाना। आयाक्‌ भागे सोमबात रेयाक्‌ पुथि आर आपोसतोलकोवाक्‌ का़मिको रेयाक्‌ पुथि, नोवा बानार पुथि दो थेयोफिल ञुतुमान मित्‌टेन जुना़नि होड़ ञुतुमतेये ओललेदा, मेनखान इसा़इ सोमाज, ओकोय दो जुना़नि आर जिहुदिकोवाक्‌ इसा़इ सोमाज ला़गित्‌ हों ओल आकान ताहेंकाना <char style="xt"><ref loc="ACT 1:1">आ का़ १:१</ref> </char></para>
  <para style="ip">नोवा आपोसतोलकोवाक्‌ का़मि पुथि दो मा़सियाक्‌ जोनोम खोन आमदाज ६०-६४ बोछोर तालारे ओल आकान ताहेंकाना। एनते पावल हाजोत खोन छोडावक्‌ लाहारे नोवा पुथि दो मुचा़दोक्‌ काना। तिना़क्‌ होड़कोवाक्‌ मेन लेकाते लुक दो पावल आपोसतोल साँवते साफोर दाड़ानरेये सेलेदोक्‌ कान ताहेंकाना। आर नोवा पुथि दो आनटिओखिया़ ञुतुमान नागराहा खोने ओल आकादा। नोवा पुथि दो लुकाक्‌ भागे सोमबात रेयाक्‌ का़हनिये लाहा इदियेत्‌ काना आर जिसु सेरमातेये चालाक्‌ खोन नोवा रेयाक्‌ एतहोप्‌ होयोक्‌ काना। लुके ओल आकात्‌ बानार पुथि रेयाक्‌ जोस दो मित्‌गे ताहेंकाना। उनियाक्‌ मोने जोङ दो ताहेंकाना जे थेयोफिल आर इसा़इ सोमाज ओकोय दोको साङगे चालाक्‌कान ताहेंकान, ओनकोवाक्‌ पा़तिया़उ ढेर इदिक्‌ आर भोरसारे खा़टि आकानको ताहेन। ओना इया़ते उनि दो जिसुवाक्‌ जोनोम आर इसा़इ धोरोम रेयाक्‌ खा़टितेत्‌ सा़रि सा़रिये ओलकेदा।</para>
  <para style="ip">आपोसतोलकोवाक्‌ पुथि दो एतहोप्‌ का़लिसिया़ रेयाक्‌ ना़मुना आबो तालारेये उदुक्‌एत्‌ काना जेमोन बोन बाडाय जे जिसुरे पा़तिया़उकाते चेत्‌लेका बोन जिवेदोक्‌आ, आर जिसुरे चेत्‌लेका बोन ताहेना। आपोसतोलको रेयाक्‌ पुथि दोए चेत्‌ आबोन काना जे भागे सोमबात पासनाव ओकतेरे चेत्‌लेका सोनोत जिउ रेयाक्‌ दाड़ेरे बोन टेहाडोक्‌आ।</para>
  <para style="iot">मेनाक्‌आक्‌को रेयाक्‌ गुटतेत्‌</para>
  <para style="io1">१. जोतो खोन माड़ाङरे सोनोत जिउ चेलाको चेतानरेये हिजुक्‌ काना आर का़लिसिया़ साङगेक्‌कान<char style="ior"><ref loc="ACT 1:1-8">आपोस का़मि १:१-८</ref> </char></para>
  <para style="io1">२. तायोमते का़लिसिया़रे सानताव एहोप्‌काते जेरुसालेम खोन बाहरे हों पासनावेना <char style="ior"><ref loc="ACT 8:2-12:23">आपोस का़मि ८:२—१२:२३</ref> </char></para>
  <para style="io1">३. इना़ तायोम पावल पा़हिल धाव पोरचार साफोररेये ओडोकोक्‌कान <char style="ior"><ref loc="ACT 12:24-14:28">आपोस का़मि १२:२४—१४:२८</ref> </char></para>
  <para style="io1">४. आरहों जेरुसालेम रेयाक्‌ धोरोम दुपुड़ुप्‌रे नावाँ पा़तिया़उ आकानको ला़गित्‌ चेत्‌को जा़रुड़ाकोकाना ओना खा़टि ला़गित्‌ <char style="ior"><ref loc="ACT 15:1-35">आपोस का़मि १५:१-३५</ref> </char></para>
  <para style="io1">५. इना़ तायोम पावल दोसार धाव भागे सोमबात साफोररेये ओडोकोक्‌कान <char style="ior"><ref loc="ACT 15:36-18:22">आपोस का़मि १५:३६—१८:२२</ref></char></para>
  <para style="io1">६. उनि दो तेसार धाव भागे सोमबात साफोररेये ओडोकोक्‌कान <char style="ior"><ref loc="ACT 18:23-20:38">आपोस का़मि १८:२३—२०:३८</ref> </char></para>
  <para style="io1">७. तायोमते पावल दो जेरुसालेमरेको हाजोतेदे <char style="ior"><ref loc="ACT 21:1-26:32">आपोस का़मि २१:१—२६:३२</ref> </char></para>
  <para style="io1">८. मुचा़त्‌रे पावल रोमतेये इदि ओचोक्‌कान <char style="ior"><ref loc="ACT 27:1-28:31">आपोस का़मि २७:१—२८:३१</ref> </char></para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />पा़हिलाक् पुथिमाञ ओललेत्, ए थियोफिलस, सानामाक्‌को रेयाङ, ओकाको जिसुइ एहोप्‌केत् का़क्‌मि हों आर चेत्आक्‌को हों।<note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="LUK 1:1-4">लु १:१-४</ref></char></note> <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />एन हिलोक् हा़बिच् ओने उनरे आच्ए बाछावान आपोसतोलको सोनोत जिउ होतेतेये हुकुम ओटोवात्‌को तायोम सेरमातेये राकाप् ओचोयेन। <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />ओने आयाक्‌ गुजुक्‌ तायोम ओनको ठेन जिवेत् होंए उदुक्एन आ़डि ओकोच् सा़बुतकोते, पोनगेल दिनकोरे ओनको ठेने ञेल बाड़ा ओचोक्‌कान ताहेंकान, इसोराक् राज रेयाक्‌कोय ला़इयाकोकान ताहेंकान तुलुच्। <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" />आर ओनको तुलुच् जोम ला़गित्‌ दुड़ुप्‌ मित्एनतेये हुकुमात्‌कोवा, जेरुसालेम खोन आलोको सेन हाताड़ोक्, बिचकोम बाबा रेयाक्‌ गोक्‌आक्‌ ता़ङगिगे, ओने ओकाटाक्ए मेतात्‌को, इञ ठेनगेपे आँजोमलेत्।<note caller="+" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="LUK 24:49">लु २४:४९</ref></char></note> <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />“एनते जोहान मा दाक्‌तेये बा़प्‌तिसलेत्‌को, मेनखान आपे दो थोड़ा दिन खानगे सोनोत जिउतेपे बा़प्‌तिस ओचोक्आ।”<note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="MAT 3:11">माथ ३:११</ref>; <ref loc="MRK 1:8">मा़र १:८</ref>; <ref loc="LUK 3:16">लु ३:१६</ref>; <ref loc="JHN 1:33">जोहा १:३३</ref></char></note><verse eid="ACT 1:5" /></para>
  <para style="s">जिसु सेरमा तेये राकाप्एन</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />आदो हेच् जारवायेनतेको कुलि केदेया, “हेंदा प्रोभु, निया़ जोखेच्‌गे राजेम तेङगो रुवा़ड़ा इसराएलको ला़गित्‌?”<verse eid="ACT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7" />उनि दोए मेतात्‌कोवा, “आपेयाक् दो बाङ काना, जोखेच्‌को से ओकतेको बाडाय ला़गित्‌ ओने ओकाको बाबा आयाक्‌ निज एकतिया़रिरेये दोहोआकात्, <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />मेनखान दाड़ेपे ञामा, सोनोत जिउ आपेरेये हेच्‌लेनरे, आर इञरेन गोहापे होयोक्आ, जेरुसालेमरे हों आर गोटा जिहुदा़ आर सा़मा़रिया़रे हों, हें धा़रति मुचा़त् हा़बिच्‌गे।”<note caller="+" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="MAT 28:19">माथ २८:१९</ref>; <ref loc="MRK 16:15">मा़र १६:१५</ref>; <ref loc="LUK 24:47">लु २४:४७</ref>,<ref loc="LUK 24:48">४८</ref></char></note> <verse eid="ACT 1:8" /><verse number="9" style="v" sid="ACT 1:9" />आदो ओनाकोय रोड़केत् खान ओनकोको ञेञेलकान ताहेंकान तुलुच्‌गेये राकाप् ओचोयेना, आर मित्‌टेच् रिमिल दो ओनकोवाक् मेंत्‌ खोने दानाङकेदेया।<note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="MRK 16:19">मा़र १६:१९</ref>; <ref loc="LUK 24:50-51">लु २४:५०-५१</ref> </char></note><verse eid="ACT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10" />आर उनिये चालाक्‌कान जोखेच् सेरमा सेच्‌को कोयोक् उरिच् आकात् ताहेंकानरे, ञेलपे पोंड किचरिच् होरोक्‌ आकात् बार होड़ ओनको आड़ेरेकिन तेङगोयेना, <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />ओने उनकिन किन मेनेत्‌, “ए गा़लिलरेन होड़को, चेत्‌पे तेङगोवाकाना सेरमा सेच्‌ बेक्‌ङगेत् कान दो? नुय जिसु, उनि ओने आपे ठेन खोन सेरमातेये राकाप् ओचोयेन, ओनकागेये हिजुक्आ हापेन चेत् लेका सेरमाते चालाक् कानपे ञेलकेदे।”<verse eid="ACT 1:11" /></para>
  <para style="s">जिहुदा़ बोदोलते माथाये बाछावक्‌कान</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />आदो जेरुसालेमतेको रुवा़ड़ेना जा़इतुनको मेताक्‌ बुरु खोन जेरुसालेम सोरगे मेनाक्, मित् किला़मिटा़र होर सा़ङगिञरे। <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />आरको बोलोयेन खान चेतान कांदहातेको देच्एना, ओने ओकारेको ताहेनकान ताहेंकान, पातरास, जोहान, जाकोब, आ़न्द्रियास, फिलिप, थोमा, बारथोलोमाय, माथाय, आलफायरेन होपोन जाकोब आर दिसा़म भोकति सिमोन आक्‌आँटिच् आर जाकोबरेन होपोन जिहुदा़।<note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="MAT 10:2-4">माथ १०:२-४</ref>; <ref loc="MRK 3:16-19">मा़र ३:१६-१९</ref>; <ref loc="LUK 6:14-16">लु ६:१४-१६</ref></char></note> <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />नोको जोतोगे जारवाकाते मित् मोनते कोयजोङरे जामाड़ आकानको ताहेंकाना, मायजिउको आर जिसुरेन एङगात मा़रिया़म आर उनिरेन बोयहाको साँवते।<verse eid="ACT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />आर ओनाको दिनरे पातरास दो बोयहाको तालारे तेङगोयेनतेये मेनकेदा आयमा होड़ मित् ठेनको ताहेंकाना, आमदाज मित्‌साय बारगेल गान, <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />ए बोयहाको, ओना ओलाक्‌ सोसतोर काथा पुरा़उक् दो जा़रुड़गे ताहेंकाना, ओकाटाक् सोनोत जिउ दो दा़उद मोचातेये रोड़ लाहालेत् जिहुदा़ रेयाङ, ओने उनि जिसु गिरिपतारलेदेकोरेन आक्‌युरिच्ए ताहेंकान।<verse eid="ACT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 1:17" />एनते आलेरे लेखा सेलेत्आकाने ताहेंकाना आर नोवा साप्‌दाप् का़मिरे बाखराय ञामलेत्‌आ। <verse eid="ACT 1:17" /><verse number="18" style="v" sid="ACT 1:18" />उनि दो बा़ड़िच्‌ का़मि रेयाक्‌ कुड़ा़इते ओते किरिञाना आर तुपुच् ञुरेनतेये ठु ओड़ेच्एना, आर उनियाक् जोतो लाच्‌को पोसाक् ओडोकेनताया। <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />आर ओना दो जेरुसालेमरे जोतो ताहेनकोको बाडाय ञामकेदा, ओनाते ओना ओत दो ओनकोवाक् पा़रसिते “आकेलदामा,” मेतात्‌मे “माँयाँम गोडा” ञुमेना।<note caller="+" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="MAT 27:3-8">माथ २७:३-८</ref></char></note><verse eid="ACT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20" />एनते सेरेञको पुथिरे ओल आकाना,</para>
  <para style="q1" vid="ACT 1:20">उनियाक् ताहेन ठा़ँइ दो टोंडाङोक् मा,</para>
  <para style="q2" vid="ACT 1:20">आर ओनारे ओकोय हों आलोको ताहेनमा,</para>
  <para style="m" vid="ACT 1:20">आरहों ओल आकाना,</para>
  <para style="q1" vid="ACT 1:20">उनियाक् हुदा़ दो एटाक् होड़े हातावमा।<note caller="+" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="PSA 69:25">सेरे ६९:२५</ref>; <ref loc="PSA 109:8">१०९:८</ref> </char></note><verse eid="ACT 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 1:21" />ओना इया़ते जा़रुड़गेया, नोको होड़को मोद खोन, ओने ओकोय प्रोभु जिसु आबो तालारेये बोलो ओडोकोक्‌कान ताहेंकान जोखेच् सानाम ओकतेरे आबो साँवतेको ताहें आ़गुवाकान।<note caller="+" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="MAT 3:16">माथ ३:१६</ref>; <ref loc="MRK 1:9">मा़र १:९</ref>; <ref loc="MRK 16:19">१६:१९</ref>; <ref loc="LUK 3:21">लु ३:२१</ref>; <ref loc="LUK 24:51">२४:५१</ref></char></note><verse eid="ACT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 1:22" />जोहान रेयाक्‌ बा़प्‌तिसमा खोन एहोप्‌काते ओना दिन हा़बिच् ओने उनरे आबो ठेन खोने राकाप् ओचोयेन नोको मोद खोन होड़ जा़रुड़गेया जेमोन आले तुलुच् उनियाक् जिवेत् बेरेत्‌एन रेयाक्‌ गोहाय होयोक्।<verse eid="ACT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />आदो बार होड़को तेङगोकेत् किना, बारसाबासको मेताय जोसेफ, ओने उनि जुसतुसे बाहनायेन, आर मा़थिया़। <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />आर कोयकेत्‌तेको मेनकेदा, आम, ए प्रोभु सानामकोरेन ओनतोर बाक्‌डायिच् नुकिन मोदरे उदुक्‌आलेमे बाड़े ओकोयटाक्एम बाछाव आकावाना। <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />नोवा साप्‌दाप् का़मि आर आपोसतोल हुदा़रे ओना ठा़ँइ ञाम ला़गित्‌, ओने ओका खोन जिहुदा़ दोए भिङगड़ा़वेन, आयाक्‌ निज ठा़ँइते सेनजोङा मेनते। <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />आदो उनकिन ञुतुमतेको गुलिबाँटकेदा, आर गुलि दो मा़थिया़ ञुतुमरे पाड़ावेना, आर उनि दो ओनको गेलमित् आपोसतोलको तुलुच्‌ए लेखा मित्एना।<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s">सोनोत जिउ रेयाक्‌ हिजुक्‌</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />आर पेनतेकोस दिन सेटेरेन खान सानामकोगे मित् ठेनको जारवा मित् आकान ताहेंकाना।<note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">लेबि २३:१५-२१</ref>; <ref loc="DEU 16:9-11">देउ १६:९-११</ref></char></note> <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />खान आचकागे सेरमा खोन मित्‌टेच् साडे हेच्एना, हुदहुद हिजुक्‌कान ता़पिस होय रेयाक्‌ लेकानाक्‌गे, आर ओना दो ओनेको दुड़ुप्‌ आकान ताहेंकान गोटा ओड़ाक्ए पेरेच्‌केदा। <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />आर सेङगेल रेयाक्‌ लेकान हा़टिञोक्‌कान आलाङको ओनको ठेन ञेल ञामेना, आर होड़ो होड़ो आप्आत्‌कोवा। <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />आर सानामकोगे सोनोत जिउतेको पेरेच्एना आर एटाक् पा़रसिकोते रोरोड़को एहोप् एना, जिउ रोरोड़ दाड़ेये एमात्‌को लेका।<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />आर जेरुसालेमरे दो जिहुदिको हेच् डेरा आकान ताहेंकाना, बिसवा़सि होड़कोगे, सेरमा लाताररेन मित्‌के मित् जा़तको मोद खोन। <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />आर नोवा साडे आँजोमेन खान गादेल होड़को हेच् जारवायेना, आरको थारबासावेना, एनते मिमित् होड़ आपान आ़पिन निज पा़रसिते रोरोड़कानको आँजोमकेत्‌कोवा। <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />सानामको ठाक एना आर हाहाड़ायेनतेको मेनकेदा, “चेत् नोको जोतो रोरोड़कानको दो गा़लिलरेन दोको बाङ काना? <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />चेकाते ओनको जोतोको आबोवाक् निज जोनोम पा़रसितेको रोड़ेत्‌कान बोन आँजोमेत्‌कोवा? <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />आबो पा़रथिको, मेदिको, एलामिको, मेसोपोटामिया़रे जिहुदा़ आर कापाडोकिया़रे पोनतुस आर आ़सिया़रे <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />फुरुगिया़ आर पामफिलिया़रे, मिसोर आर कुरेने सेनाक् लुबिया़ रेयाक्‌ टोठाकोरे ताहेनको आर उपरिया़ मेनाक्‌बोन रोमि होड़, <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />जिहुदिको हों आर जिहुदि बिसवा़सरे बोलोआकानको हों। क्रेतेरेनको आर आराबिको, आबोवाक् निज पा़रसिते इसोर रेयाक्‌ माराङ का़मिको रोरोड़कानबोन आँजोमेत्‌को दो?” <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />आर जोतोको ठाक आर आकबाकावेनतेको मेपेनेना, “नोवा दो चेत् होयोक्‌ काना?”<verse eid="ACT 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 2:13" />मेनखान आरको दो चिगा़रिकातेको मेनकेदा, नावाँ दारखा रासातेको भुतेड़ आकाना।<verse eid="ACT 2:13" /></para>
  <para style="s">पातरासाक्‌ पोरचार</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />मेनखान पातरास दो ओनको गेलमित्‌को साँवते तेङगोयेनते आँट आड़ाङतेये गालमारावात्‌कोवा, मेनकेदाय, ए आपे जिहुदा़रेन होड़को आर जेरुसालेमरेपे ताहेनकान जोतोको नोवा बाडायजोङपे आर इञाक् काथाको लुतुरातिञपे। <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />आपेपे बुजहा़वेत् लेका नोको होड़ दो बाको बुल आकाना, एनते बासकेयाक् बेर कानगे चोङ। <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />मेनखान नोवा दो जोएल ना़बि होतेते रोड़लेनाक् काथा काना।<verse eid="ACT 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17" />आर मुचा़त् दिनकोरे नोनका होयोक्आ, इसोरे मेनेदा,</para>
  <para style="q2" vid="ACT 2:17">इञरेन जिउ रेयाक्‌ मानवा जा़तरेन जोतोकोञ दुलाकोवा,</para>
  <para style="q1" vid="ACT 2:17">आर आपेरेन होपोनको आर आपेरेन होपोनेराकोको ना़बिया</para>
  <para style="q2" vid="ACT 2:17">आर आपेरेन जुवा़न कोड़ाको दो दोरसोनको ञेला,</para>
  <para style="q2" vid="ACT 2:17">आर आपेरेन मुरुबिको दो कुकमुको ञेला।<note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="JOL 2:28-32">जोए २:२८-३२</ref> </char></note><verse eid="ACT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18" />हें इञरेन गुति आर का़ड़मिको हों,</para>
  <para style="q2" vid="ACT 2:18">ओनाको दिनरे दो इञरेन जिउ रेयाक्‌ इञ दुलाकोवा,</para>
  <para style="q2" vid="ACT 2:18">आर ओनको दो ना़बि काथाको रोड़ा।<verse eid="ACT 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19" />आर इञ दो हाहाड़ावाक्‌को चोट सेरमारे</para>
  <para style="q2" vid="ACT 2:19">आर चिनहा़को लातार ओतरेञ होय ओचोया,</para>
  <para style="q1" vid="ACT 2:19">माँयाँम आर सेङगेल आर तुत् तुत् धुवा़ँगे।<verse eid="ACT 2:19" /></para>
  <para style="q2">
    <verse number="20" style="v" sid="ACT 2:20" />सिञ चाँदो दो ञुततेये फेरावक्आ,</para>
  <para style="q2" vid="ACT 2:20">आर ञिंदा़ चाँदो दो माँयाँमतेगे प्रोभुवाक् दिन आ़उरि सेटेरोक्‌रे</para>
  <para style="q2" vid="ACT 2:20">ओना माराङ आर ठोनोक आनाक् दिनगे<verse eid="ACT 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21" />आर नोनका होयोक्‌आ जाहाँयगे प्रोभुवाक् ञुतुमको दोहायताय, ओनकोगेको बाञचावक्आ।<verse eid="ACT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />ए आपे इसराएल होड़को, नोवाको काथा आँजोमपे, नासारेतरेन जिसु, मित्‌टेन होड़ होतेते सा़बुत ओचोवाकान, दाड़ेयानाक् का़मिको आर हाहाड़ावाक्‌को आर चिनहा़कोते, ओने ओकाको इसोर दो उनि होतेते आपे तालारेये का़मिलेत्, आपे होंपे बाडायकान लेका। <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />नुय होड़ दो इसोराक् निटाक् मेनजोङ आर उनियाक् बाडाय दारामते, आपेयाक् तिरेये सोपरोत ओचोयेना आर आपे दो आ़न बाहरेरेन होड़को होतेते उनिपे कुरुस ओचोकेदेया आरपे गोच्‌केदेया।<note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="MAT 27:35">माथ २७:३५</ref>; <ref loc="MRK 15:24">मा़र १५:२४</ref>; <ref loc="LUK 23:33">लु २३:३३</ref>; <ref loc="JHN 19:18">जोहा १९:१८</ref> </char></note> <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />मेनखान इसोर दो उनिये बेरेत्‌केदेया, मोरोन रेयाक्‌ बेदोन खोन खालासकाते, एनते बाङ होय दाड़ेयाक्आ उनि ओनातेये का़इदा़उ दोहोकोक् दो।<note caller="+" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="MAT 28:5">माथ २८:५</ref>,<ref loc="MAT 28:6">६</ref>; <ref loc="MRK 16:6">मा़र १६:६</ref>; <ref loc="LUK 24:5">लु २४:५</ref></char></note> <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />एनते दा़उद दो उनि रेयाङे मेनेदा,</para>
  <para style="q1" vid="ACT 2:25">प्रोभु दो सिञ सा़टुप् इञ सामाङरेञ दोहोवाकादेया,</para>
  <para style="q2" vid="ACT 2:25">एनते इञ एतोम सेच्‌रे मेनाया, जेमोन आलोञ आकबाकावक्‌, <note caller="+" style="x"><char style="xo" closed="false">2:25</char><char style="xt" closed="false"><ref loc="PSA 16:8-11">सेरे १६:८-११</ref></char></note><verse eid="ACT 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26" />ओना इया़ते इञाक् मोन दो रा़सका़येना</para>
  <para style="q2" vid="ACT 2:26">आर इञाक् आलाङ दो हुला़सेना,</para>
  <para style="q1" vid="ACT 2:26">हें इञाक् होड़मो सुदहा़गे</para>
  <para style="q2" vid="ACT 2:26">आसरे छा़उनिक्आ,<verse eid="ACT 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27" />एनते इञाक् जिवि दो बाम आलायतिञा पातालपुरि ला़गित्‌,</para>
  <para style="q2" vid="ACT 2:27">आर आमरेन सोनोतिच् हों ओहोम एमलेया, सेयाक् ञेल ला़गित्‌<verse eid="ACT 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28" />जियोन रेयाक्‌ होरकोम बाडाय ओचोकेदेञा,</para>
  <para style="q2" vid="ACT 2:28">आर रा़सका़तेम पेरेजिञा आमाक् मेंत्‌हाँ सामाङरे।<verse eid="ACT 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />ए बोयहाको, नोवा काथा दो खा़टिगेञ मेन दाड़ेयाक्‌आ, आ़गिल हापड़ाम दा़उद रेयाङ, बाङमा, उनि दो गोच् होंए गोच्एना आर तोपा होंए तोपा ओचोयेना, आर उनियाक् कोबोर दो तेहेञ हा़बिच् आबो ठेन मेनाक्आ। <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />उनि ना़बिये ताहेंकानते आर बाडाय आकात् ताहेंकानते, बाङमा इसोर दो किरिया़कातेये गोक्‌ आकावादे ताहेंकाना जे उनियाक् बोंस खोन मित् होड़ उनियाक् सिङघा़सोनरेये दुड़ुप्‌काया मेनते।<note caller="+" style="x"><char style="xo" closed="false">2:30 </char><char style="xt" closed="false"><ref loc="PSA 132:11">सेरे १३२:११</ref>; <ref loc="2SA 7:12-13">२ सा ७:१२-१३</ref></char></note> <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />उनि दो ञेल लाहाकाते मा़सियाक् जिवेत् बेरेदोक् रेयाङगेये रोड़लेदा,</para>
  <para style="q1" vid="ACT 2:31">बाङमा पातालपुरि ला़गित्‌ हों बाय आलाय गिडि ओचोलेना</para>
  <para style="q2" vid="ACT 2:31">आर उनियाक् जेल हों सेयाक् बाय ञेललेदा।<note caller="+" style="x"><char style="xo" closed="false">2:31 </char><char style="xt" closed="false"><ref loc="PSA 16:10">सेरे १६:१०</ref></char></note><verse eid="ACT 2:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 2:32" />उनि जिसुगे इसोर दोए जिवेत् बेरेत्‌ केदेया, ओने ओना रेयाक्‌गे आले जोतो गोहाकोकानाले। <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />आदो इसोराक् जोजोम तिते उसुल ओचोयेनते, आर बाबा ठेन खोन सोनोत जिउ रेयाङ गोक्‌आक्‌ ञामकाते, उनि दो नोवाये दुल आदेया, ओने ओकाटाक् आपे ञेल आरपे आँजोमेत्‌कान। <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />एनते दा़उद दो सेरमाते बाय राकाप् लेना बिचकोम आच्‌गेये मेनेदा।<note caller="+" style="x"><char style="xo" closed="false">2:34 </char><char style="xt" closed="false"><ref loc="PSA 110:1">सेरे ११०:१</ref></char></note></para>
  <para style="q1" vid="ACT 2:34">प्रोभु दो इञरेन प्रोभुए मेतादेया,</para>
  <para style="q2" vid="ACT 2:34">इञ एतोम सेच्‌रे बाड़े दुड़ुप्‌मे<verse eid="ACT 2:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ACT 2:35" />आमरेन बा़इरिको आमाक् जाङगा लेबेदोक् गाँडो आ़उरिञ होय ओचोको हा़बिच्।<verse eid="ACT 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36" />ओनाते सानाम इसराएल घारोंजरेनको खा़टिको बाडायमा, जे इसोर दो उनिगे प्रोभु हों आर मा़सि होंए होय ओचोवाकादेया, उनि जिसुगे, ओने ओकोय आपेपे कुरुसलेदे।<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />आदो नोवाको आँजोमकेत् खान ओनतोररेको सोबोक् सेङगेत् एना, आर पातरास आर एटाक् आपोसतोलकोको मेतात्‌कोवा, ए बोयहाको चेत्‌ले चेकाया?<verse eid="ACT 2:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38" />खानगे पातरासे मेतात्‌कोवा, मोन आ़चुरतापे आर आपे मिमित् होड़ जिसु मा़सि ञुतुमते बा़प्‌तिसोक्‌पे, आपेयाक् का़इको इका़क्‌तापे ला़गित्‌, खान सोनोत जिउ रेयाक्‌ दानपे ञामा। <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />एनते गोक्‌आक् दो आपे ला़गित्‌ आर आपेरेन गिदरा़को ला़गित्‌ आर जोतो सा़ङगिञरेनको ला़गित्‌ तिना़क्‌को प्रोभु आबोरेन इसोर दोए होहो सोरजोङ।<verse eid="ACT 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40" />आर ढेर एटाक् काथाकोते गोहाय एम इदिकेदा आरे बिनतियाक्‌कोवा, मेतात्‌कोवाय, “ओचोक्‌पे नोको पेड़ता पिड़हिरेनको खोन।” <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />आर ओकोयको उनियाक् काथाको आङगोचकेदा ओनको दोको बा़प्‌तिस ओचोयेना। आर एन हिलोक् दो पे हाजार गान होड़ ओनको तुलुच्‌को जुटुच्एना<verse eid="ACT 2:41" /></para>
  <para style="s">पा़तिया़वाकानकोवाक्‌ दिना़म दिन रेयाक्‌ जियोन</para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 2:42" />आर जामाड़ आकानको ताहेंयेना, आपोसतोलकोवाक् सिकना़तरे, हेलमेलरे, पिठा़ केचागरे आर कोयजोङरे। <verse eid="ACT 2:42" /><verse number="43" style="v" sid="ACT 2:43" />आर जोतो होड़गे बोतोर चाड़हावात्‌कोवा, आर आ़डि ओकोच् हाहाड़ा का़मि आर चिनहा़को आपोसतोलको होतेते होयेना। <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />आर जोतो पा़तिया़वाकानको दो मित्‌तेको ताहेंयेना, आर सानामाक्‌रेगे रा़सिया़को ताहेंकाना।<note caller="+" style="x"><char style="xo" closed="false">2:44 </char><char style="xt" closed="false"><ref loc="ACT 4:32-35">आ का़ ४:३२-३५</ref></char></note> <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />आर आकोवाक् ओत खेत एमान आर धोन दुरिब आ़खरिञकाते जोतोकोको हा़टिञात्‌कोवा, मिमित् होड़ जा़रुड़ात्‌को लेका। <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />आर दिना़मगे मित् मोनतेको ताहेंयेना कोयजोङ ओड़ाक्‌रे, आर ओड़ाक् ओड़ाक् पिठा़ केचागते, हुला़साते आर सोड़ा मोनेतेको जोम ञुयेत् ताहेंकाना, <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />इसोरको सारहावेकान आर जोतो दिसा़म होड़को ठेनको बा़सुत ओचोक्‌कान तुलुच्। आर प्रोभु दो दिना़मगे बाञचाव ओचोक् कानकोय जुटुच् इदिकेत्‌कोवा।<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s">लेडहा होड़े बोगेयेन</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />आर पातरास आर जोहान दो कोयजोङ ओड़ाक्‌तेकिन राकाप्‌ चालाक्‌कान ताहेंकाना, तारासिञ रेयाक्‌ कोयजोङ घा़ड़िच्‌रे। <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />आर एङगात कुखि खोनगे लेडहाय ताहेंकान मित्‌ होड़को गोक्‌ इदिकायकान ताहेंकाना, ओने उनि दिना़मगे मोजको मेताक्‌ कोयजोङ ओड़ाक्‌ रेयाक्‌ पा़चरि दुवा़रा ठेनको दोहोकायकान ताहेंकाना, कोयजोङ ओड़ाक्‌ते बोलोक्‌कान होड़ ठेन कोय आ़जिजोक् ला़गित्‌। <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />आर उनि दो पातरास आर जोहान कोयजोङ ओड़ाक्‌ते बोलोक्‌ ला़गिदोक्‌काने ञेलकेत्‌किनते कोय ञाम ला़गित्‌ए नेहोंरात्‌किना <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />मेनखान पातरास दो जोहान तुलुच्‌ उनि बेङगेत्‌ उरिच्‌आदेतेये मेनकेदा, “आ़लिञ सेच्‌ बेङगेदमे।” <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />उनि दो उनकिन ठेन खोन जाहानाक्‌ ञाम आसतेये कोयोक्‌ राकाप्‌आत्‌किना। <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />खान पातरासे मेनकेदा, “बा़नुक्‌तिञा रुपा़ आर सोना दो मेनखान ओका मेनाक्‌तिञा ओनाञ एमाम काना, नासारेतरेन जिसु मा़सि ञुतुमते मा ताड़ाममे।” <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />आर जोजोम ति साप्‌केदेतेये बेरेत्‌ केदेया। खानगे उनियाक्‌ जाङगा आर ठोड़ें दो केटेच्‌ गोत्‌एनताया। <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />आर दोन बेरेत्‌एनतेये तेङगोयेना आरे दाँड़ाँ बाड़ाकेदा। आर उनकिन तुलुच्‌ कोयजोङ ओड़ाक्‌तेये बोलोयेना ताड़ाम ताड़ामते आर दोन दोनते आर इसोर सारहावाते <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />आर सानाम होड़ उनिको ञेल केदेया, दाँड़ाँ बाड़ायकान आर इसोर सारहावेदेकान, <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />आरको ओरोम केदेया, बाङमा उनि कानगेयाय ओने उनि कोय ञाम ला़गित्‌ कोयजोङ ओड़ाक्‌ रेयाक्‌ मोज दुवा़रा ठेन दुड़ुप्‌ आकाने ताहेनकान ताहेंकाना, आर उनिरे होयेनाक्‌ इया़ते थारबासाव आरको ठाक एना।<verse eid="ACT 3:10" /></para>
  <para style="s">कोयजोङ ओड़ाक्‌रे पातरासाक्‌ गालमाराव</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />आर उनि दो पातरास आर जोहाने झुटिया़उ आकात्‌किन ताहेंकानरे, जोतो होड़ ओनको ठेनको ञिर जारवायेना, थारबासाव चाबावाकान, सुलेमानाक्‌को मेताक्‌ पिंडा़रे <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />आर पातरास ओनाय ञेलकेत्‌ खान ओनको होड़े रोड़ रुवा़ड़ात्‌कोवा, ए इसराएलरेन होड़को चाक्‌पे हाहाड़ाक्‌ काना नोवा रेयाङ दो? से चाक्‌पे बेङगेत्‌ उरिच्‌ आ़लिञ काना, आपनार दाड़े से आपनाराक्‌ इसोर भोकतिते नुयलिञ ताड़ाम ओचोकेदे लेका? <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />आबराहामरेन इसोर आर इसाहाकरेन इसोर आर जाकोबरेन इसोर, आबोरेन हापड़ामकोरेन इसोरगे आच्‌रेन गुति जिसुइ ठोनोक ओचोआकादेया, ओने ओकोय आपेपे सोपरोतकेदे आर पिला़त सामाङरेपे बाङकेदे उनि दो आड़ाक्‌काय ला़गित्‌ए निटलेत्‌रे हों,<note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="EXO 3:15">एकसो ३:१५</ref> </char></note> <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" />मेनखान आपे दो उनि सोनोतिच्‌ आर भागेयिच्‌पे बाङ केदेया, आरपे खोजकेदा मित्‌टेन खुनिया़ँहि दान लेकातेये एमापेया मेनते।<note caller="+" style="x"><char style="xo" closed="false">३:१४ </char><char style="xt" closed="false"><ref loc="MAT 27:15-23">माथ 2७:१५-२३</ref>; <ref loc="MRK 15:5-14">मा़र १५:५-१४</ref>; <ref loc="LUK 23:13-23">लु २३:१३-२३</ref>; <ref loc="JHN 19:12-15">जोहा १९:१२-१५</ref> </char></note> <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />आर जियोनरेन मा़लिक दोपे गोच्‌ केदेया ओने ओकोय इसोर दो गोच्‌को खोने बेरेत्‌केदे ओने ओना रेयाक्‌गे आले दोले गोहाको कान। <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />आर नुयपे ञेले आरपे बाडायेदेकान होड़ दो उनियाक् ञुतुमगेये दाड़े ओचोकेदेया, जिसुवाक्‌ ञुतुमरे पा़तिया़उक्‌ इया़ते, हें उनि होतेतेयाक् पा़तिया़उगे नोवा पुरा़ निरोपोन दोए एमआकावादेया आपे जोतोको सामाङरे।<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />आदो ए बोयहाको बाडायगेया़ञ बिन बाडायतेपे ओनकालेदा मेनते चेत्‌ लेका आपेरेन मुखिया़को हों। <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />मेनखान इसोर दो ओकाको सानाम ना़बिको मोचातेये जा़हिर लाहालेत्‌ ताहेंकान उनिरेन मा़सि दुके जोमा मेनते नोक्‌ओंय नोनकातेये पुरा़उकेदा। <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />ओनाते मोन आ़चुरतापे, आ़चुर रुवा़ड़ोक्‌पे आपेयाक्‌ का़इको मेटावक्‌आ मेनते। जेमोन प्रोभु ठेन खोन रा़सका़ रेयाक्‌ ओकतेको हिजुक्‌, <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />आर जेमोन आपे ला़गित्‌ निट आकादे मा़सिये कोले, जिसुगे। <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />ओने ओकोय सेरमारे ताहेन दो जा़रुड़कान सानामाक्‌को आ़उरि तेङगो रुवा़ड़ोक् ओकते हा़बिच्‌। ओने ओनाको रेयाङ इसोर दो जुग खोनको ताहेंकान आच्‌रेन सोनोत ना़बिको मोचातेये रोड़ आकात्‌। <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />मोसे दोए मेनलेत्‌गेया एनकाथाय प्रोभु इसोर दो आपेरेन बोयहाको मोद खोन मित्‌टेन ना़बिये तेङगोवापेया, इञ लेकानिच्‌गे उनियाक्‌पे आँजोमताया, सानामाक्‌ ओकाकोय गालमारावापे।<note caller="+" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="DEU 18:15">देउ १८:१५</ref>,<ref loc="DEU 18:18">१८</ref> </char></note> <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />आर नोनका होयोक्आ उनि ना़बि रेयाक्‌ बाय आँजोमताय मित्‌के मित्‌ होड़ दो दिसा़म होड़को ताला खोने माराव उता़रोक्‌आ।<note caller="+" style="x"><char style="xo" closed="false">3:23 </char><char style="xt" closed="false"><ref loc="DEU 18:19">देउ १८:१९</ref>; <ref loc="LEV 23:29">लेबि २३:२९</ref></char></note> <verse eid="ACT 3:23" /><verse number="24" style="v" sid="ACT 3:24" />आर सानाम ना़बिकोगे सामुएल आर उनि तायोमतेनको खोन तिना़क्‌को रोड़ाकात्, ओनको हों नोवाको दिन रेयाक्‌को जा़हिर आकादा। <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />आपेगे ना़बिकोरेन होपोनको कानापे आर ओना बोनदोबोसरेन, ओने ओकाटाक्‌ इसोर दो आपेरेन हापड़ामको तुलुच्‌ए बाँधावकेत्‌, आबराहामे मेतादेरे, आर आम बोंसरेन होतेतेगे धा़रतिरेन सानाम गुसटिको भोरानकोको होयोक्‌आ।<note caller="+" style="x"><char style="xo" closed="false">3:25 </char><char style="xt" closed="false"><ref loc="GEN 12:3">जेने १२:३</ref>; <ref loc="GEN 18:18">१८:१८</ref>; <ref loc="GEN 22:18">२२:१८</ref>; <ref loc="GEN 26:4">२६:४</ref></char></note> <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />आपे ठेन इसोर दो आच्‌रेन गुति तेङगोकेदेतेये कोल केदेया भोरापे ला़गित्‌ आपे मित्‌के मित्‌ होड़ आपेयाक्‌ बा़ड़िच्‌आक्‌को खोनपे आ़चुरोक्‌ते।<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s">पातरास आर जोहान माराङ बा़इसि सामाङरे</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />आर उनकिन दो होड़कोकिन गालमारावाको कान ताहेंकानरे नायकेको कोयजोङ ओड़ाक्‌ पाहराकोरेन सुबेदार आर सा़दुकिको दो उनकिन ठेनको दानदानाव हेच्एना, <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />आ़डिको एदरेयेनते दिसा़म होड़कोकिन चेत्आकोकाना आर जिसुरे गोच्‌को खोन जिवेत् बेरेदोक् रेयाङकिन जा़हिरेत्‌ ताहेंकान इया़ते। <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />आर उनकिनरे हातको लागावकेदा आर दोसार हिलोक् हा़बिच् ला़गित्‌ हाजोतरेको दोहोकात्‌किना, एनते आ़युप् आकान ताहेंकाना। <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />मेनखान काथा आँजोमकेत्‌को मोदरेन ढेर होड़को पा़तिया़वेना, आर हेरेल होपोनको रेयाक्‌ लेखा दो मोंड़ें हाजार गान होयेना,<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />आदो दोसार हिलोक् ओनकोरेन मुखिया़को आर मुरुबिको आर सोसतोर बाडायको दो जेरुसालेमरेको जारवायेना, <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />आर हान्नास माराङ नायके आर कायाफा, आर जोहान आलेकसानदेर आर माराङ नायके गुसटिरेन जोतोको, <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />आर तालारे उनकिन तेङगोकेत्‌किनतेको कुलिकेत्‌किना, “ओका दाड़ेते से ओका ञुतुमते आबेन दो नोवा बेन का़मिकेदा?” <verse eid="ACT 4:7" /><verse number="8" style="v" sid="ACT 4:8" />उनरे पातरास दो सोनोत जिउते पेरेच्एनतेये मेतात्‌कोवा, ए आपे दिसा़म होड़कोरेन मुखिया़को आर मुरुबिको <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />आ़लिञगे मित्‌टेन निजोर होड़रे मित्‌टेच् उपका़र का़मि रेयाङ तेहेञलिन कुलि ओचोक्‌कान खान चेत् लेकाते उनि होड़े बोगे ओचो आकाना मेनते, <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />एनडेखान आपे सानामको आर इसराएलरेन सानाम होड़को बाडायमा, नासारेतरेन जिसु मा़सि ञुतुमते, ओने उनि आपेपे कुरुसलेदे ओकोय इसोर दो गोच्‌को खोने बेरेत्‌केदे, उनि होतेतेगे नुय होड़ दो आपे सामाङरे बोगे आकाने तेङगोवाकाना।<verse eid="ACT 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ACT 4:11" />उनि कानगेयाय धिरि दो,</para>
  <para style="q2" vid="ACT 4:11">ओकाटाक् आपे ओड़ाक् बेक्‌नावकोपे निहा़ँत गिडिकात्, ओनागे कोनाच रेयाक्‌ आसोलाक् होय आकाना।<note caller="+" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="PSA 118:22">सेरे ११८:२२</ref>,<ref loc="PSA 118:23">२३</ref>; <ref loc="DAN 2:34">दानि २:३४</ref>,<ref loc="DAN 2:35">३५</ref></char></note><verse eid="ACT 4:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ACT 4:12" />आर एटाक् जाहाँयरे बाञचाव दो बा़नुक् आनाङ एनते एटाक् ञुतुम हों बा़नुक् आनाङ सेरमा लाताररे, मानवाको तालारे एमआकानाक् ओने ओनातेबो बाञचावक्।<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />आदो पातरास आर जोहान ता़किनाक्‌ दिल ञेलकाते, आर उनकिन दो बिन बिदिया़वान आर साधारोन होड़ कानाकिन मेनते बाडायकाते ओनको दोको हाहाड़ायेना, आदोको ञेल ओरोमकेत्‌किना़ बाङमा उनकिन होड़ दो जिसु साँवते ताहेनकान होड़ कानाकिन मेनते। <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />आर उनि बोगे ओचोवाकान होड़ उनकिन तुलुच्‌ तेङगोवाकानको ञेलकेदेते चेत् हों बाको रोड़ दाराम दाड़ेयादा। <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />आदो बा़इसि खोन ओडोक हाताड़ोक्‌को हुकुमात्‌किनते आको आकोरेको ला़पा़याना। <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />मेनकेदाको, “उनकिन होड़ दो चेत् बोन चेकाकिना? एनते मित्‌टेच् नामडाक चिनहा़गे उनकिन होतेते होय आकाना ओना दो जेरुसालेमरे सानाम ताहेनको ठेन सोरोसगेया, आर बाबोन बाङ दाड़ेयाक् काना। <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />मेनखान दिसा़म होड़को तालारे नोवा बा़ड़ति आलो पासनाव इदिक्आ मेनतेबोन चेहावकिना जेमोन आर दो ओना ञुतुमते ओकोय हों आलोकिन गालमारावाको।”<verse eid="ACT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18" />आदो होहो आ़गुकातेको हुकुमात् किना जेमोन जिसु ञुतुमते दो आलोतेत्‌गेकिन रोड़ बाड़ाय आरकिन चेत्आको। <verse eid="ACT 4:18" /><verse number="19" style="v" sid="ACT 4:19" />मेनखान पातरास आर जोहान दोकिन रोड़ रुवा़ड़ात्‌कोवा, “इसोर बाङकाते आपेयाक्‌गे आँजोमतापे दो इसोर सामाङरे ठिका से बाङा ओना दो आपे बाड़े बिचा़रपे। <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />एनते ओहोलिञ दाड़ेलेया आ़लिञलिञ ञेलआकात् आरलिञ आँजोमाकात्‌आक्‌को बाङ ला़इ दो।” <verse eid="ACT 4:20" /><verse number="21" style="v" sid="ACT 4:21" />खान ओनको दो आरहों बा़ड़ति चेहावकेत्‌किनतेको आड़ाक्‌कात्‌किना, एनते सा़जा़इकिन रेयाक्‌ चेत् हों बाको ञामलेत्‌आ, होड़को इया़ते, सानाम होड़को एनते ओना होय आकानाक् इया़ते इसोरको साबासियायकान ताहेंकान, <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />एनते उनि होड़, ओने ओकोयरे निरोपोन रेयाक्‌ चिनहा़ होयेन, उनि दो पोन गेल सेरमा खोन बा़ड़ति उमेररेने ताहेंकाना।<verse eid="ACT 4:22" /></para>
  <para style="s">पा़तिया़वाकानकोवाक्‌ कोयजोङ</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />आदोकिन आड़ाक् ओचोयेन खान उनकिन दो आपनाररेनको ठेनकिन हेच्एना आरको ला़इयात्‌कोवा माराङ नायकेको आर मुरुबिकोको मेतात्‌किन ताहेंकान। <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />आर ओनको दो ओना आँजोमकेत् खान मित् मोनते इसोर दोहायादेतेको मेनकेदा, ए प्रोभु आम ओने सेरमा आर धा़रति आर जालापुरि आर ओनाकोरे मेनाक् जोतोवाक्एम बेनाव आकात्,<note caller="+" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="EXO 20:11">एकसो २०:११</ref>; <ref loc="NEH 9:6">नेहे ९:६</ref>; <ref loc="PSA 146:6">सेरे १४६:६</ref></char></note> <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />आम ओने सोनोत जिउ होतेते आलेरेन हापड़ाम, आमरेन गुति दा़उद मोचातेम रोड़लेत्, एनकाथाय,</para>
  <para style="q1" vid="ACT 4:25">चेत् इया़ते जिहुदि बाहरेरेनको दोको राङगावेना आर जा़तजा़तरेनको दो आ़उड़िया़क्‌को पोन्‌थाकेदा।<note caller="+" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="PSA 2:1">सेरे २:१</ref>,<ref loc="PSA 2:2">२</ref></char></note><verse eid="ACT 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26" />धा़रतिरेन रापाजको दोको तेङगोयेना आर मुखिया़को दो मित् ठेनको जारवायेना</para>
  <para style="q1" vid="ACT 4:26">प्रोभु उपा़रते आर उनिरेन ओजोक्‌इच् उपा़रते,<verse eid="ACT 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 4:27" />एनते सा़रिगे नोवा नागराहारे आमेम ओजोक्‌केदे आमरेन सोनोत गुति जिसु उपा़रतेको जारवायेना, हेरोद हों आर पोनतियुस पिला़त हों, जिहुदि बाहरेरेनको आर इसराएलरेनको साँवते,<note caller="+" style="x"><char style="xo" closed="false">4:27 </char><char style="xt" closed="false"><ref loc="LUK 23:7-11">लु २३:७-११</ref>; <ref loc="MAT 27:1">माथ २७:१</ref>,<ref loc="MAT 27:2">२</ref>; <ref loc="JHN 18:28">जोहा १८:२८</ref>,<ref loc="JHN 18:29">२९</ref></char></note> <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />ओना का़मिया मेनते ओका आमाक् ति आर आमाक् मोनेये निट लाहावाकात्‌ ताहेंकान। <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />आर नितोक्‌ दो, ए प्रोभु, ओनकोवाक् धामकावको बेङगेत्आताकोम आर आले आमरेन गोलामको बाड़े सोहोत्‌आलेम, पुरा़ सोहोसाते आमाक् काथा रोड़ ला़गित्‌, <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />बोगेको ला़गित्‌ आमाक् तियेम तिया़र तुलुच्‌ आर जेमोन चिनहा़को आर हाहाड़ावाक्‌को होयोक् आमरेन सोनोत गुति जिसु ञुतुमते। <verse eid="ACT 4:30" /><verse number="31" style="v" sid="ACT 4:31" />आदोको कोयकेत् खान ओना जायगा दो दालदालावेना, ओने ओकारेको जारवा आकान ताहेंकान आर जोतोगे सोनोत जिउतेको पेरेच्एना आर सोहोसाते इसोराक् काथाको रोड़ेत् ताहेंकाना।<verse eid="ACT 4:31" /></para>
  <para style="s">पा़तिया़वाकानकोवाक् सा़झिया़ सोमपा़ति</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />आर पा़तिया़वाकान गादेल होड़ दो मित् मोन आर मित् जिविको ताहेंकाना आर मित् होड़ हों बाय मेनलेदा मेनाक्‌तायाक्‌को मोदरे जाहानाक्‌गे आपनारआक् कानताया मेनते, बिचकोम सानामाक्‌गे सा़झिया़ते ताहेंकानताकोवा।<note caller="+" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="ACT 2:44">आ का़ २:४४</ref>,<ref loc="ACT 2:45">४५</ref></char></note> <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />आर आपोसतोलको दो माराङ दाड़े सालाक् गोहाको एमेत्‌ ताहेंकाना, प्रोभु जिसु मा़सिये जिवेत् बेरेत्एन रेयाक्‌, आर ओनको सानामकोरे दाया दो माराङगे ताहेंकाना। <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />ओकोय टोन्‌टाक् होड़ हों ओनको मोदरे दो बाको ताहेंकाना, एनते तिना़क् होड़ ओत बाड़गेयान से जुमिदारको से ओड़ाक् मा़लिकको ताहेंकान, ओनको दो ओनाको आ़खरिञकेदा। <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />आर आ़खरिञेनाक्‌ दामको आ़गुकाते आपोसतोलकोवाक् जाङगा ठेनको दोहोयेत् ताहेंकाना, आर मिमित् होड़ जा़रुड़ाक्‌को लेकाको एम हा़टिञाकोकान ताहेंकाना।<verse eid="ACT 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36" />आदो कुपरोस दिसा़मरेन लेबि खुँटरेन जोसेफ ओकोय दो आपोसतोलको दो बारनाबासको बाहनाकेदे, ओकाटाक् तोरजोमाते दो जिवि राड़ेच्‌रेन होपोन। <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />उनि दो गोडा ताहेंकानतायते ओनाय आ़खरिञकेदा आर टाका आ़गुकाते आपोसतोलकोवाक् जाङगा ठेने दोहोकेदा।<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s">आनानिया़स आर सा़फिरा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />मेनखान आनानिया़स ञुतुमान मित्‌टेन होड़ दो आच् ओड़ाक् होड़ सा़फिरा लागायते दोखोलाक् जुमिये आ़खरिञकेदा, <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />आर दाम रेयाक्‌ आदोम दोए ओको दोहोकेदा ओड़ाक् होड़तेत् होंए बाडाय तुलुच्‌गे, आर तिन उडिच् चोङ आ़गुकाते आपोसतोलकोवाक् जाङगा ठेने दोहोकेदा। <verse eid="ACT 5:2" /><verse number="3" style="v" sid="ACT 5:3" />मेनखान पातरासे मेनकेदा, “हेंदा आनानिया़स चेत् इया़ते सायतान दो आमाक् मोनेरेये राजेना, सोनोत जिवेम एड़ेकेदेया ओना जायगा रेयाक्‌ दाम खोन आदोमेम ओको दोहोजोङ ला़गित्‌ दो? <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />ताहेंकानरे बाङ दो आमाक्‌गे बाङ ताहेंकान आर आ़खरिञरे हों बाङ दो आमाक् एकतिया़रिरे बाङ ताहेंकान? चेकाते नोनकानाक् दोम मोनेयाना? मानवा दो बाम एड़ेआकात्‌कोवा, बिचकोम इसोरगे।”<verse eid="ACT 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 5:5" />आर आनानिया़स दो ओनाको काथा आँजोमकातेये भिनदा़ड़ेना आर जिवि ओडोकएनताया; आर जोतो आँजोमकेत्‌को दो माराङ बोतोर चाड़हावात्‌कोवा। <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />आर जुवा़नको दो बेरेत् एनते उनिको ओयो पोटोमकेदेया आर ओडोक इदिकेदेतेको तोपाकादेया।<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />आर पे घोन्‌टा गान तायोम उनिरेन ओड़ाक् होड़ दो, होय आकानाक् बेगोर बाडायतेये हेच् बोलोयेना।<verse eid="ACT 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 5:8" />आदो पातरास उनिये कुलि केदेया, “ला़इया़ञमे ओना ओत दो इना़क्‌तेगेबेन आ़खरिञकेदा?” उनिये मेनकेदा, “हें इना़क्‌तेगे,”<verse eid="ACT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9" />खान पातरास दो उनिये मेतादेया, “चेकाते आबेन दोबेन मित् मोन आकाना, प्रोभुरेन जिउ बिडा़वे ला़गित्‌? ञेलमे हेरेलमेको तोपाकेदेको रेयाक्‌ जाङगा दो दुवा़र ठेन मेनाक्‌कोवा, आर आम होंको ओडोक इदिमेया,” <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />खानगे उनि दो उन जोखेच्‌गे उनियाक् जाङगा ठेने भिनदा़ड़ेना आर जिवि ओडोकएनताया; आर कोड़ाको हेच् बोलोयेन खान गोच्आकानको ञाम केदेया, आर ओडोक इदिकाते हेरेलतेत् पानतेरेको तोपाकादेया, <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />आर गोटा का़लिसिया़रेनको आर ओनाको आँजोमकेत् खान सानामको माराङ बोतोर चाड़हा़वात्‌कोवा।<verse eid="ACT 5:11" /></para>
  <para style="s">हाहाड़ा का़मिको रेयाक्‌ चिनहा़को</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />आर आपोसतोलको होतेते आयमा चिनहा़को आर हाहाड़ावाक्‌को दिसा़म होड़को तालारे होयेना, आर ओनको सानामकोगे मित् मोनते सुलेमानाक् पिंडा़रेको ताहेंकाना। <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />आर एटाक्‌को दो ओकोय हों ओनको तुलुच्‌ सेलेदोक् बाको दिललेदा मेनखान दिसा़म होड़ दो ओनकोको मानोतेत्‌को कान ताहेंकाना। <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />आर पा़तिया़उक्‌को दो आरतेत् बा़ड़ति प्रोभुरेको जुटुच्‌ इदियेना, गादगाद हेरेल हों आर मायजिउ हों। <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />नुना़क् हा़बिच् जे ओनको दो कुलहिकोरे रुवा़क् हासोक्‌को ओडोक इदिकाते पारकोमको आर आटेत्‌कोरेको दोहोकेत्‌कोवा, जेमोन पातरासे पारोम चालाक्‌रे उनियाक्‌ उमुल हों उमुलतेत् जाहाँयटाक् पाड़ावाको। <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />आर जेरुसालेम बेड़हायतेयाक् नागराहाकोरेन गादेल होड़ होंको हेच् जारवायेना, रुवा़क् हासोक्‌को बेसाफा जिउ होतेते जालाक्‌कानको आ़गुदारावानते आर ओनको दो जोतोगेको बोगे ओचोयेना।<verse eid="ACT 5:16" /></para>
  <para style="s">आपोसतोलको सानताव ओचोक्‌काना</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />आर माराङ नायके दोए तेङगोयेना आर उनि साँवरेन सानामकोगे (ओने सा़दुकि दोलरेनको ताहेंकान) हिसका़तेको पेरेच्‌एना। <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />आर आपोसतोलको साप्‌केत्‌कोवा आर सारकारि हाजोतरेको भोरावकेत्‌कोवा, <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />मेनखान प्रोभुरेन मित्‌टेन दुत दो ञिंदा़ हाजोत ओड़ाक् रेयाक्‌ सिलपिञकोय झिच्‌केदा आर ओनको ओडोक आ़गुकातेये मेतात्‌कोवा <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />“दु चालाक्‌पे आर कोयजोङ ओड़ाक्‌रे दिसा़म होड़को नोवा जियोन रेयाक्‌ सानाम काथा ला़इयाकोपे।”<verse eid="ACT 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 5:21" />आदो ओनाको आँजोमकेत् खान सेतागोक्‌ देलादिलि कोयजोङ ओड़ाक्‌तेको बोलोयेना आर होड़कोको ला़इ चेत्आत्‌कोवा। खान माराङ नायके आर उनि साँवतेनको हेच्‌एनते माराङ बा़इसिरेनको आर इसराएल होपोनकोरेन मुरुबि साभारेन जोतोकोको होहो जारवाकेत्‌कोवा, आर ओनको होहो आ़गु ओचोको ला़गित्‌ हाजोत ओड़ाक्‌ते होड़को कोलकेत्‌कोवा। <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />मेनखान सिपा़हि दो ओंडे सेनकाते हाजोत ओड़ाक्‌रे ओनको बाको ञामलेत्‌कोवा, आदो रुवा़ड़काते नोनकाको ला़इयात्‌कोवा। <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />आले दो हाजोत ओड़ाक् जोतो लेकाते काजाक सिञ आकात्‌ले ञामकेदा आर होरहोको हों दुवा़र ठेन तेङगोवाकान, मेनखानले झिच्‌केत् खान भितरिरे दो चेले हों बाले ञामलेत्‌कोवा। <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />आर कोयजोङ ओड़ाक्‌ पाहराकोरेन सुबेदार आर माराङ नायकेको ओनाको काथाको आँजोमकेत् खान ओनको रेयाङको आँदेसालेयेना, नोवा दो चेत् चोङ होयोक् नाहाँक्‌, <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />खानगे मित् होड़ हेच्‌कातेये ला़इयात्‌कोवा, “ञेलपे ओनको होड़ हाजोतरेपे दोहोलेत्‌को ओनकोमा कोयजोङ ओड़ाक्‌रेको तेङगोवाकान आर दिसा़म होड़को ला़इचेत्आको काना।” <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />खानगे कोयजोङ ओड़ाक्‌ पाहराकोरेन सुबेदार दो सिपा़हि सालाक् सेनकाते ओनकोय आ़गुकेत्‌कोवा। मेनखान जोरमोटते दो बाङ, एनते दिसा़म होड़को बोतोरात्‌कोवा, ओनको ठेनको तिञगोच् ओचोक्आ मेनते।<verse eid="ACT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27" />आदोको आ़गुकेत्‌को खान माराङ बा़इसि सामाङरेको तेङगोकेत्‌कोवा। खानगे माराङ नायकेये कुलिकेत्‌कोवा। <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />आले दो काजाकतेले हुकुमात्‌पेया, नोवा ञुतुमते आलो चेत्‌आको ला़गित्‌ आर ञेलपे, जेरुसालेमपे पेरेच्‌आकादा आपेयाक् सिकना़तते आर नुय होड़ाक् माँयाँम आलेरे पाड़ाव ओचोयपे मोनेयाकादा।<note caller="+" style="x"><char style="xo" closed="false">5:28 </char><char style="xt" closed="false"><ref loc="MAT 27:25">माथ २७:२५</ref></char></note><verse eid="ACT 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29" />आदो पातरास आर आपोसतोलकोको रोड़ रुवा़ड़केदा, मानवाकोवाक् खोन बिचकोम इसोराक्‌गे बातावताय जा़रुड़ा। <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />आबोरेन हापड़ामकोरेन इसोर दो जिसुइ जिवेत् बेरेत्‌ केदेया, ओने उनि आपे कुरुसरे आकाकातेपे गोच्‌लेदे। <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />उनिगे इसोर दो माथा आर बाबाञचाविच्‌ मेनकाते आयाक्‌ जोजोम ति नाखारेये उसुल ओचोकेदेया, इसराएलको मोन आ़चुर आर का़इ इका़ एमाको ला़गित्‌ <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />आर आले दो नोवाको काथारेन गोहाको कानाले, आर सोनोत जिउ हों ओने ओकोय इसोर दो आयाक्‌ बातावेत्‌तायकोय एमआकावात्‌को।<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />मेनखान ओनकोको आँजोमकेत् खान मोनरेको सोबोक् ताप्एना आरको सालहावाना ओनको गोच्‌को ला़गित्‌। <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />मेनखान गामालिएल ञुतुमान मित्‌टेन फा़रिसि होड़ सानाम दिसा़म होड़को ठेन मानोतानिच्, मित्‌टेन आ़न गुरु दो माराङ बा़इसिरे तेङगोयेनतेये हुकुमकेदा, जेमोन ओनको होड़ थोड़ा घा़ड़िच्‌ ला़गित्‌को ओडोकोक्‌। <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />आदोए मेतात्‌कोवा, ए इसराएल होड़को मेन सोनतोर जोङपे, नोको होड़ चेत् पे चेकावाको ला़गिदोक्‌काना। <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />एनते निया़को दिन पा़हिलरे थेयुदासे तेङगोलेना, आच् दो जाहाँय कानाय मेनकाते, ओने उनि तुलुच्‌ लेखारे पोन साय गान होड़को सेलेत् एन खान, उनि दोए गोच् ओचोयेना आर तिनाक्‌को बातावेत्‌ताय ताहेंकान जोतोको छिञछा़तुरेना आरको आ़उड़ियाक् एना। <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />इना़ तायोम गा़लिलरेन जिहुदा़इ तेङगोलेना, होड़ लेखाको जोखेच् आर होड़को आच् सेच्ए झाकरावकेत्‌कोवा, उनि दो आच् होंए मारावेना आर तिना़क्‌को बातावलेत्‌ताए जोतोको दोको छिञछा़तुर एना। <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />आर नितोक् दोञ मेतापेकाना, नोको होड़को खोन साहाड़ाकान ताहेनपे, आर इका़काको पे एनते नोवा सोलहा से नोवा का़मि दो मानवाको सेच् खोनाक् कान खान आच्‌तेगे नासाव मारावक्‌आ।<verse eid="ACT 5:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 5:39" />मेनखान इसोर सेच् खोनाक् कान खान एनडेखान ओहोपे माराव दाड़ेलेकोवा, आर बाङखान इसोर बिरुदरे ला़ड़हा़इको पे होयोक्आ। <verse eid="ACT 5:39" /><verse number="40" style="v" sid="ACT 5:40" />आर आपोसतोलकोको होहो आदेर ओचोकेत्‌कोवा आर दाल उर ओचोकेत्‌कोतेको हुकुमात्‌कोवा, जिसु ञुतुमते आलोको रोड़ बाड़ाया मेनते आदोको आड़ाक्‌कात्‌कोवा। <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />आर ओनको माराङ बा़इसि सामाङ खोनको चालावेना रा़सका़वाते, ञुतुमतेत् खा़तिरते बेमानोत ओचोक् लेकको बुजहा़वेन इया़ते। <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />आर दिना़मगे कोयजोङ ओड़ाक्‌रे आर ओड़ाक् ओड़ाक्‌कोरे चेत्आको आर मा़सि जिसु रेयाङ भागे सोमबात पोपोरचार दो बाङको थिरलेना।<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s">एयाय साप्‌दाप्‌को</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />आर ओनाको दिनरे चेलाको साङगे इदिक्‌कान ताहेंकानरे जुना़नि रोरोड़ जिहुदिकोरे मित्‌टेच् काराच् कुरुजोक्‌ जानामेना, इबरिको उपा़रते दिना़म हिलोक् साप्‌दाप्आकोरे आकोरेन रा़ँडि मायजिउकोको ढिला़उ ओचोक्‌कान ताहेंकान इया़ते। <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />खानगे ओनको गेलबारको दो जोतो चेलाको होहो जारवाकातेको मेतात्‌कोवा, “इसोराक् काथा ढिला़उकाते जोम ञु रेयाक्‌ ले साप्‌दाप्‌ दो बाङ ठिका। <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />ओनाते ए बोयहा मिसराको भागे ञुतुमानको, जिउ आर आ़किलते पेरेच् आकान एयाय होड़ आपे मोद खोन ञाम बाछावकोपे ओने ओनको नोवा कामकाज चेतानरेले धुरा़उकाको, <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />मेनखान आले दो कोयजोङरे आर काथा रेयाक्‌ साप्‌दाप् का़मिरे जामाड़ाकान ले ताहेना।”<verse eid="ACT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5" />आर नोवा काथा दो जोतोको बेसको मेतात्आ, आर इस्टिफानको बाछाव केदेया, बिसवा़स आर सोनोत जिउते पेरेच्आकान मित्‌टेन होड़गे, आर फिलिप आर प्रोखोरुस, आर निकानोर आर तिमोन आर पारमेनास, आनटिओखिया़रेन निकोलासगे जिहुदि बिसवा़सरे बोलोआकान <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />आपोसतोलको सामाङरेको तेङगोकेत्‌को आर ओनको दो कोयकेत्‌तेको चापोकेत्‌कोवा।<verse eid="ACT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7" />आर इसोराक् काथा दो पासनाव इदियेना आर जेरुसालेमरे चेलाकोवाक् लेखा दो आ़डितेत् बाड़हाव इदियेना, आर आ़डि उता़र नायकेको बिसवा़सरेको गोबोलेना।<verse eid="ACT 6:7" /></para>
  <para style="s">इस्टिफानाक् साप्‌ ओचोक्</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />आर इस्टिफान दो भोर आर दाड़ेते पेरेच् आकान, माराङ हाहाड़ावाक्‌को आर चिनहा़को दिसा़म होड़को तालारेये का़मियेत् ताहेंकाना। <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />मेनखान किरिञ छोडाव ओचोवाकानको ओनकोवाक्‌ ञुतुम नोवाको ताहेंकाना कुरेनि, आलेकसान्‌डेरिया़ सुना़गोगरेनको, आर किलिकिया़ आर आ़सिया़रेनको मोदरेनको आदोम आदोमको दो तेङगोयेनते इस्टिफान तुलुच्‌को रेटेपेटेयेना। <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />आर ओनको दो ओना आकेल आर जिउ ओकातेये रोड़ेत् ताहेंकान, बाको तेङगो दाराम दाड़ेयादा। <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />खानगे ओनको दो होड़को तुल राकाप्‌केत्‌कोवा, ओने ओनकोको मेनकेत्, नुय दो मोसे आर इसोर उपा़रते हेक्‌नोसता काथाको रोरोड़कानले आँजोम आकादेया। <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />आर दिसा़म होड़को आर मुरुबिको आर सोसतोर बाडायकोको आ़उला़उकेत्‌कोवा, आर उनि उपा़रते हेच् पाड़ावेनते माराङ बा़इसि सामाङरेको घाचघाचाव इदि केदेया, <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />आर एड़े गोहाको तेङगोकेत्‌कोवा, ओने ओनकोको मेनकेत्, नुय होड़ दो सोनोत ठा़ँइ आर आ़न उपा़रते काथाको रोरोड़ दो बाय थिरुक्‌काना।<note caller="+" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JER 26:11">जिरि २६:११</ref></char></note> <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />एनते रोरोड़ले आँजोम आकादेया, बाङमा नुय नासारेतरेन जिसु दो नोवा ठा़ँये धाङधासेरा आर मोसेये जिमा़आकावात्‌बोन चा़लिकोय फेरावा <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />आर माराङ बा़इसिरे दुड़ुप्‌ आकान सानामको उनि सेच् बेङगेत् उरिच्‌काते उनियाक् मेंत्‌हाँ दो मित्‌टेन दुत रेयाक्‌ मेंत्‌हाँ लेकाको ञेलकेत्‌ताया।<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s">इस्टिफानाक् पोरचार</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />खानगे माराङ नायकेये मेनकेदा, “चेत्‌ नोवाको दो नोनका कानगेया?”<verse eid="ACT 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2" />आदो उनिये मेनकेदा, “ए बोयहा मिसराको आर बाबाको, आँजोमपे, ठोनोकरेन इसोर दो आबोरेन बाबा आबराहाम ठेने सोदोरेना, मेसोपोटामिया़रेये ताहेंकान, हारानरे आ़उरिये बेरेलोक्‌रेगे,”<note caller="+" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="GEN 12:1">जेने १२:१</ref></char></note> <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />आरे मेतादेया, दु ओडोक चालाक्‌मे आमाक् दिसा़म खोन आर आमरेन पेड़ा पा़रभा़को खोन, आर देला इञिञ उदुक् आम दिसा़मते। <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />खानगे उनि दो का़लदिकोवाक् दिसा़म खोन ओडोक हेच्एनते हारानतेये बेरेलेना; आर ओंडे खोन दो आपाततेत्ए गोच्एन तायोम, इसोर दो नोवा दिसा़मतेये उचा़ड़केदेया, ओने ओकारे नितोक् आपेपे बेरेलाकान,<note caller="+" style="x"><char style="xo" closed="false">7:4 </char><char style="xt" closed="false"><ref loc="GEN 11:31">जेने ११:३१</ref>; <ref loc="GEN 12:4">१२:४</ref> </char></note> <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />आर नोवारे चेत् आ़इदा़रि हों बाय एमादेया, हें जाङगा लेबेदोक् ठा़ँइ इना़क् हों बाङ आरे गोक्‌आदेया, नोवा दिसा़म दो उनि आर उनिरेन बोंसे एमाकोवा मेनते, उनिरेन गिदरा़ बाको ताहेंकानतायरे हों।<note caller="+" style="x"><char style="xo" closed="false">7:5 </char><char style="xt" closed="false"><ref loc="GEN 13:15">जेने १३:१५</ref>; <ref loc="GEN 15:18">१५:१८</ref>; <ref loc="GEN 16:1">१६:१</ref>; <ref loc="GEN 24:7">२४:७</ref>; <ref loc="DEU 2:5">देउ २:५</ref>; <ref loc="DEU 11:5">११:५</ref></char></note> <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />आर इसोर दो नोनकाए मेनकेदा, उनिरेन बोंस दो उपरिया़को होयोक्आ मित्‌टेन आ़ना़ड़ि दिसा़मरे आर ओनको दो गोलामको खाटावकोवा, आरको सानतावकोवा पोन साय बोछोर हा़बिच्।<note caller="+" style="x"><char style="xo" closed="false">7:6 </char><char style="xt" closed="false"><ref loc="GEN 15:13">जेने १५:१३</ref>,<ref loc="GEN 15:14">१४</ref>; <ref loc="JER 2:22">जिरि २:२२</ref> </char></note> <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />आर ओना जा़तरेनको; ओने ओनको ठेन गोलामको खाटावक्, ओनको दो इञगेञ बिचा़रकोवा, इसोरे मेनकेदा, आर ओना तायोम दो ओना दिसा़म खोनको ओडोक हिजुक्आ आर इञको सेवावाञा नोवा ठा़ँइरेगे।<note caller="+" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="GEN 15:14">जेने १५:१४</ref>; <ref loc="JER 3:12">जिरि ३:१२</ref></char></note> <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />आर खातना रेयाक्‌ बोनदोबोसे एमादेया। इना़काते इसाहाके जानामेना, आर इरा़ल माँहाँ हिलोक्‌रेये खातनाकेदेया, आर इसाहाक दो, जाकोब जोनोमे एमादेया, आर जाकोब दो गेलबार आ़गिल हापड़ामकोगे।<note caller="+" style="x"><char style="xo" closed="false">7:8 </char><char style="xt" closed="false"><ref loc="GEN 17:10-14">जेने १७:१०-१४</ref>; <ref loc="GEN 21:2-4">२१:२-४</ref>; <ref loc="GEN 25:26">२५:२६</ref>; <ref loc="GEN 29:31-35">२९:३१-३५</ref> </char></note><verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />आर आ़गिल हापड़ामको दो जोसेफको हिसका़वादेते मिसोरतेको आ़खरिञ गोत्‌कादेया; मेनखान इसोर दो उनि तुलुच्‌ए ताहेंकाना,<note caller="+" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="GEN 37:11">जेने ३७:११</ref>,<ref loc="GEN 37:28">२८</ref>; <ref loc="GEN 39:2-3">३९:२-३</ref>,<ref loc="GEN 39:21">२१</ref>; <ref loc="GEN 45:4">४५:४</ref></char></note> <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />आर उनियाक् सानाम दुकको खोने छाडावकेदेया, आर मिसोररेन राज फाराव सामाङरे दाया आर आकेले एमादेया, आर उनि दो चाक्‌लाविच् मेनकातेये दोहोकेदेया। मिसोर चेतानरे आर आयाक्‌ गोटा राज दोङगोल चेतानरेगे।<note caller="+" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="GEN 39:21">जेने ३९:२१</ref>; <ref loc="GEN 41:40">४१:४०</ref>,<ref loc="GEN 41:43">४३</ref>,<ref loc="GEN 41:46">४६</ref>; <ref loc="PSA 105:21">सेरे १०५:२१</ref></char></note> <verse eid="ACT 7:10" /><verse number="11" style="v" sid="ACT 7:11" />आर गोटा मिसोर आर कानानरे आकाल आर कोसटो होयेना आर आबोरेन हापड़ामको दो जोमाक् बाको ञामलेत्‌आ।<note caller="+" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="GEN 41:54">जेने ४१:५४</ref>,<ref loc="GEN 41:55">५५</ref>; <ref loc="GEN 42:1-2">४२:१-२</ref>,<ref loc="GEN 42:5">५</ref></char></note> <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />आर जाकोब दो मिसोररे जोमाक्‌ मेनाक्आ मेनतेये आँजोमकेत् खान आबोरेन हापड़ामको पा़हिल धावे कोलकेत्‌कोवा; <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />आर दोसार धावरे जोसेफ दो आच्‌रेन बोयहाको ठेने ओरोमेना आर जोसेफआक् घारोंजरेनको बाबोतते फाराव राज होंए बाडायकेदा।<note caller="+" style="x"><char style="xo" closed="false">7:13 </char><char style="xt" closed="false"><ref loc="GEN 45:1">जेने ४५:१</ref>,<ref loc="GEN 45:3">३</ref>,<ref loc="GEN 45:16">१६</ref> </char></note> <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />खानगे जोसेफ दो काथा कोलकेत्‌ते आपाततेत्‌ जाकोब आर सानाम पेड़ा पा़रभा़कोय होहो आ़गु ओचोकेत्‌कोवा, एयायगेल मोंड़ें होड़कोगे।<note caller="+" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="GEN 45:9-11">जेने ४५:९-११</ref>,<ref loc="GEN 45:18">१८</ref>,<ref loc="GEN 45:19">१९</ref>; <ref loc="GEN 46:27">४६:२७</ref>; <ref loc="JER 1:5">जिरि १:५</ref>; <ref loc="DEU 10:22">देउ १०:२२</ref></char></note> <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />आर जाकोब दो मिसोरतेये फेड चालावेना; आर उनि आच् होंए गोच्एना आर आबोरेन हापड़ामको हों।<note caller="+" style="x"><char style="xo" closed="false">7:15 </char><char style="xt" closed="false"><ref loc="GEN 45:5-6">जेने ४५:५-६</ref>; <ref loc="GEN 49:33">४९:३३</ref>; <ref loc="JER 1:6">जिरि १:६</ref></char></note> <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />आर सिकेमतेको इदि ओचोयेना आर ओना तोपा दाँदेररेको बाय ओचोयेना ओकाटाक् आबराहाम दो हामोररेन होपोनको ठेन सिकेमरे चा़नि सिकि एमकातेये किरिञलेत्।<note caller="+" style="x"><char style="xo" closed="false">7:16 </char><char style="xt" closed="false"><ref loc="GEN 32:16">जेने ३२:१६</ref>,<ref loc="GEN 32:17">१७</ref>; <ref loc="GEN 33:19">३३:१९</ref>; <ref loc="GEN 49:29-30">४९:२९-३०</ref>; <ref loc="GEN 50:13">५०:१३</ref>; <ref loc="JOS 24:32">जोसु २४:३२</ref> </char></note><verse eid="ACT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />ओकाटाक् इसोर दो आबराहामे गोक्‌ आकावादे ताहेंकान, ओकते सोर इदियेना, तेमोन होड़को मिसोररेको ढेर इदियेना आरको साङगे इदियेना। <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />मिसोररे मित्‌टेच् एटाक् राज आ़उरिये तेङगोक्‌ हा़बिच् ओने उनि जोसेफ बाय बाडायलेदे।<note caller="+" style="x"><char style="xo" closed="false">7:18 </char><char style="xt" closed="false"><ref loc="EXO 1:7-8">एकसो १:७-८</ref> </char></note> <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />उनि दो छोलते आबो जा़तरेनको तुलुच्ए बेवहारकेत्‌ते आबोरेन हापड़ामकोय सानतावकेत्‌कोवा, ओनकोरेन बाले गिदरा़इ गोच् गिडि ओचोकेत्‌को, जेमोन जिवेत् आलोको ताहेन।<note caller="+" style="x"><char style="xo" closed="false">7:19 </char><char style="xt" closed="false"><ref loc="EXO 1:9-10">एकसो १:९-१०</ref>,<ref loc="EXO 1:18">१८</ref>,<ref loc="EXO 1:22">२२</ref> </char></note> <verse eid="ACT 7:19" /><verse number="20" style="v" sid="ACT 7:20" />ओना जोखेच्‌गे मोसेये जानाम एना आर इसोर नोजोररे मोजगेये ताहेंकाना; आर उनि दो आपातआक् ओड़ाक्‌रे पे चाँदोए आ़सुल ओचोयेना। <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />आर उनिये गिडि ओचोयेन खान फाराव होपोनेरात दो उनिये हा़र साँवहाँँकेदेया आर आच्‌रेन होपोन मेनकातेये आ़सुल हाराकेदेया।<note caller="+" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="EXO 2:3-10">एकसो २:३-१०</ref></char></note> <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />आर मोसे दो मिसरिको रेयाक्‌ सानाम आकेले चेत् ओचोयेना आर आयाक्‌ काथाको आर का़मिकोते दाड़ेयानगेये होयेना।<verse eid="ACT 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23" />“मेनखान पोन गेल सेरमा उमेर पुरा़वेनताय खान मोने हेच् आदेया आच्‌रेन बोयहा इसराएल होपोनको हिरिको ला़गित्‌।<note caller="+" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="EXO 2:11">एकसो २:११</ref></char></note> <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />आर मित्‌टेन होड़ बेहोक ओचोक्‌काने ञेलकेदे खान दोदोक्‌इच्ए तेङगोयेना आर उनि दाबाव ओचोक्‌इच् हालाहा़लि ला़गित्‌ उनि मिसरि होडे़ गोच्‌केदेया।<note caller="+" style="x"><char style="xo" closed="false">7:24 </char><char style="xt" closed="false"><ref loc="EXO 2:12">एकसो २:१२</ref></char></note> <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />आरे हुदिसेत्‌ ताहेंकान बाङमा उनिरेन बोयहाकोको बुजहा़वा, इसोर दो उनियाक् तितेगे बाञचावक्ए एमाकोवा मेनते; मेनखान ओनको दो बाको बुजहा़उलाक्आ। <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />आर दोसार हिलोक् बार होड़किन तापामकान ताहेंकानरे उनकिन ठेने हेच्‌ सोरेना, आर सामगेक् ला़गित्‌ सोलहा लेगावात्‌किनतेये मेनकेदा हेंदा हो, बोयहाकान चोङबेन, चेदाक् बेन बा़ड़िजोक् काना?” <verse eid="ACT 7:26" /><verse number="27" style="v" sid="ACT 7:27" />मेनखान सोङगेतेनिच्ए बेहोके कान ताहेंकानिच् दो उनि ढाका पा़सिरकेदेतेये मेनकेदा, “ओकोय बाङ आ़लिञ तालारे मुखिया़ आर बिक्‌चा़रिच्ए दोहोकेत्‌मे? <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />होलानोक् मिसरि होड़ेम गोच्‌केदे लेका इञ हों गोजेञेम मेनजोङकाना?”<note caller="+" style="x"><char style="xo" closed="false">7:28 </char><char style="xt" closed="false"><ref loc="EXO 2:13-14">एकसो २:१३-१४</ref></char></note> <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />खानगे मोसे दो ओना काथा इया़तेये दा़ड़केदा आर मिदिया़न दिसा़मरे उपरिया़इ होयेना, ओंडेगे बारयाय कोड़ा गिदरा़वाना।<note caller="+" style="x"><char style="xo" closed="false">7:29 </char><char style="xt" closed="false"><ref loc="EXO 2:15-22">एकसो २:१५-२२</ref>; <ref loc="EXO 18:3-4">१८:३-४</ref></char></note><verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />“आर पोन गेल सेरमा पुरा़वेन खान मित्‌टेन दुत दो सिना़इ बुरु रेयाक्‌ हाहाङकाररे उनि ठेने ञेल ओचोयेना मित्‌टेन जा़नुम झा़वा़ रेयाक्‌ जोलोक् सेङगेलरे।<note caller="+" style="x"><char style="xo" closed="false">7:30 </char><char style="xt" closed="false"><ref loc="EXO 3:1-10">एकसो ३:१-१०</ref> </char></note> <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />आर मोसे दो ओना घोटना ञेलकातेये हाहाडा़येना; आर ञेल ला़गित्‌ए सेन सोरोक्‌कान ताहेंकानरे प्रोभु रेयाक्‌ आड़ाङ हेच्एना, <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />इञ दो आमरेन हापड़ामकोरेन इसोर आबराहाम आर इसाहाक आर जाकोबरेन इसोरगे।” आर मोसे दो थारथारावेनते ञेञेल बाय दिललेदा। <verse eid="ACT 7:32" /><verse number="33" style="v" sid="ACT 7:33" />खानगे प्रोभु दोए मेतादेया, आमाक्‌ जाङगा खोन खारपा बोजताम; एनते आम ओकारेम तेङगोवाकान ओना जायगा दो सोनोत ओत काना। <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />मिसोररे मेनाक्‌कोतिञ इञरेन पोरजाकोवाक् दुक सासेत इञ ञेलआकात्‌गेया, आर ओनकोवाक् कुहरा़उ दोञ आँजोमाकात्‌गेया आर ओनको छाडावको ला़गित्‌ इञ फेड हेच् आकाना; आर नितोक् दो देला मिसोरतेञ कोलमेया।<verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />उनि मोसे, ओकोयको बाङलेदे, ओनेको मेनलेत्‌, ओकोय बाङ आम दो मुखिया़ आर बिक्‌चा़रिच्ए दोहोकेत्‌मे? उनिगे इसोर दो मुखिया़ मेनकाते हों आर छाक्‌डाविच् मेनकाते होंए कोल केदेया, जा़नुम झा़वा़रे उनि ठेने ञेल ओचोयेन दुत रेयाक्‌ आ़क्‌युररे।<note caller="+" style="x"><char style="xo" closed="false">7:35 </char><char style="xt" closed="false"><ref loc="EXO 2:14">एकसो २:१४</ref> </char></note> <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />उनिगे ओनकोय ओडोक आ़गुकेत्‌कोवा, मिसोर दिसा़मरे आर आराक् जालापुरिरे आर हाहाङकाररे पोनगेल सेरमा हाहाड़ावाक्‌को आर चिनहा़को का़मिकाते।<note caller="+" style="x"><char style="xo" closed="false">7:36 </char><char style="xt" closed="false"><ref loc="EXO 7:3">एकसो ७:३</ref>; <ref loc="EXO 14:21">१४:२१</ref>; <ref loc="NUM 14:33">नुमे १४:३३</ref> </char></note> <verse eid="ACT 7:36" /><verse number="37" style="v" sid="ACT 7:37" />नुयगे उनि मोसे दो, ओने उनि इसराएल होपोनकोय मेतात्‌को, इसोर दो आपेरेन बोयहाको मोद खोन मित्‌टेन ना़बिये तेङगोवापेया, इञ लेकानिच्‌गे।<note caller="+" style="x"><char style="xo" closed="false">7:37 </char><char style="xt" closed="false"><ref loc="DEU 18:15-18">देउ १८:१५-१८</ref></char></note> <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />नुय दो उनि कानगेयाय, ओने उनि हाहाङकाररे का़लिसिया़रेये ताहेंकान उनि दुत, तुलुच्, ओकोय सिना़इ बुरुरे उनिये गालमारावादे। आर आबोरेन हापड़ामको तुलुच्‌ हों, उनिगे, ओकोय आबो एमाबोना मेनते जिवेत् काथाकोय आताङकेत्।<note caller="+" style="x"><char style="xo" closed="false">7:38 </char><char style="xt" closed="false"><ref loc="EXO 19:1-6">एकसो १९:१-६</ref>; <ref loc="EXO 20:1-17">२०:१-१७</ref>; <ref loc="DEU 5:4-22">देउ ५:४-२२</ref>; <ref loc="DEU 9:10-11">९:१०-११</ref></char></note><verse eid="ACT 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39" />ओने उनियाक् बातावताय ला़गित्‌ आबोरेन हापड़ामको दो बाको रेबेन लेन, बिचकोम उनिको ढाका पा़सिरकेदे, आर आकोवाक् ओनतोरते दो मिसोरतेको आ़चुर रुवा़ड़ेन।<note caller="+" style="x"><char style="xo" closed="false">7:39 </char><char style="xt" closed="false"><ref loc="EXO 23:20">एकसो २३:२०</ref>,<ref loc="EXO 23:21">२१</ref>; <ref loc="NUM 14:3">नुमे १४:३</ref>,<ref loc="NUM 14:4">४</ref> </char></note> <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />आर आरोनको मेतादेया, आबो लाहा लाहाते सेनोक् ला़गित्‌ बोङगाको बेनाव आबोनमे, एनते उनि मोसे ओकोय मिसोर दिसा़म खोने ओडोक आ़गुकेत्‌बोन, उनि रेयाङ दो बाबोन बाडाया, चेत् चोङ होयेना।<note caller="+" style="x"><char style="xo" closed="false">7:40 </char><char style="xt" closed="false"><ref loc="EXO 32:1">एकसो ३२:१</ref> </char></note> <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />आदो ओनाको दिनरे मिहुँरेन मित्‌टेन मुरहुत्‌को बेनावाना आर ओना मुठा़नगे दाँड़ेंको सामाङादा, आर माराङ भोज सालाक्‌ आकोवाक् तितेयाक् का़मिकोरेको हेसेच्‌सेकरेच् एना,<note caller="+" style="x"><char style="xo" closed="false">7:41 </char><char style="xt" closed="false"><ref loc="EXO 32:2-6">एकसो ३२:२-६</ref></char></note> <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />मेनखान इसोर दो आ़चुरेनते ओनकोय आलाय गिडिकात्‌कोवा सेरमारेन इपिलको सेवावाको ला़गित्‌, चेत्‌लेका ना़बिको रेयाक्‌ पुथिरे ओलआकान लेका,</para>
  <para style="q1" vid="ACT 7:42">“चेत् तेङगेनोक्‌को आर दाँड़ेंको पे सामाङादिञा</para>
  <para style="q2" vid="ACT 7:42">पोनगेल सेरमा हाहाङकाररे, ए इसराएल घारोंजरेनको?<note caller="+" style="x"><char style="xo" closed="false">7:42 </char><char style="xt" closed="false"><ref loc="JER 7:18">जिरि ७:१८</ref>; <ref loc="JER 8:2">८:२</ref>; <ref loc="JER 19:13">१९:१३</ref></char></note><verse eid="ACT 7:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43" />मोलोक रेयाक्‌ ता़मबुपे गोच्‌केदा आर रोफान बोङगारेन इपिलगे।</para>
  <para style="q2" vid="ACT 7:43">ओनाको मुठा़न ओने ओनाकोपे बेनावान ओनाको</para>
  <para style="q1" vid="ACT 7:43">डोबोक्‌आक्‌ ला़गित्‌ बाबेल ओन पारोम इञ चालोन इदिपेया।”<note caller="+" style="x"><char style="xo" closed="false">7:43 </char><char style="xt" closed="false"><ref loc="AMO 5:25-27">आमो ५:२५-२७</ref></char></note><verse eid="ACT 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />गोहा रेयाक्‌ ता़मबु आबोरेन हापड़ामको ठेन हाहाङकाररे ताहेंकान ताकोवा, चेत्‌लेका मोसे गालमारावादेयिच्ए हुकुमलेत्‌ उनिये ञेललेत् ना़मुना लेकाय बेनावा मेनते।<note caller="+" style="x"><char style="xo" closed="false">7:44 </char><char style="xt" closed="false"><ref loc="EXO 25:9">एकसो २५:९</ref>,<ref loc="EXO 25:10">१०</ref>; <ref loc="EXO 27:21">२७:२१</ref>; <ref loc="NUM 1:50">नुमे १:५०</ref> </char></note> <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />ओने ओकाटाक् आबोरेन हापड़ामको हों आको पा़रिको ञामकातेको आ़गुदाराकेत् जोसुवा़ साँवते, बोङगान होड़ जा़तकोवाक् दिसा़म दोखोलानरे, ओने ओनको इसोर दो आबोरेन हापड़ामकोवाक् मेंत्‌हाँ सामाङ खोने लागा ओडोककेत्‌को, दा़उद रेयाक्‌ ओकते हा़बिच्‌गे।<note caller="+" style="x"><char style="xo" closed="false">7:45 </char><char style="xt" closed="false"><ref loc="JOS 3:14-17">जोसु ३:१४-१७</ref>; <ref loc="JOS 18:1">१८:१</ref>; <ref loc="JOS 23:9">२३:९</ref>; <ref loc="JOS 24:18">२४:१८</ref> </char></note> <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />नुय दो इसोर सामाङरे दायाय ञामकेदा आर जाकोबरेन इसोर ला़गित्‌ ताहेन ठा़ँइ ञामा मेनतेये कोयाना।<note caller="+" style="x"><char style="xo" closed="false">7:46 </char><char style="xt" closed="false"><ref loc="2SA 7:2-16">२ सा ७:२-१६</ref>; <ref loc="1KI 8:17">१ रा ८:१७</ref>,<ref loc="1KI 8:18">१८</ref>; <ref loc="1CH 17:1-14">१ बि १७:१-१४</ref>; <ref loc="2CH 6:1-17">२ बि ६:१-१७</ref> </char></note> <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />मेनखान सुलेमानगे ओड़ाक् दोए बेनावादेया।<note caller="+" style="x"><char style="xo" closed="false">7:47 </char><char style="xt" closed="false"><ref loc="1KI 6:1-38">१ रा ६:१-३८</ref>; <ref loc="2CH 3:1-17">२ बि ३:१-१७</ref></char></note> <verse eid="ACT 7:47" /><verse number="48" style="v" sid="ACT 7:48" />एनरेहों चोट उता़रिच् दो तिते बेनावाक्‌कोरे बाय ताहेनकाना, चेत् लेका ना़बिये मेनेत्‌ काना,<verse eid="ACT 7:48" /></para>
  <para style="pi">
    <verse number="49" style="v" sid="ACT 7:49" />सेरमा दो इञाक् सिङघा़सोन काना आर ओत दो इञाक् जाङगा लेबेदोक् गाँडो,</para>
  <para style="pi" vid="ACT 7:49">चेत् लेकान ओड़ाक्‌पे बेनावाञा, प्रोभुइ मेनेदा, <note caller="+" style="x"><char style="xo" closed="false">7:49 </char><char style="xt" closed="false"><ref loc="ISA 66:1-2">जेसा ६६:१-२</ref> </char></note></para>
  <para style="pi" vid="ACT 7:49">से ओकाटाक् काना इञाक् जिरा़उक् ठा़ँइ दो?<verse eid="ACT 7:49" /></para>
  <para style="pi">
    <verse number="50" style="v" sid="ACT 7:50" />इञाक् तिगे नोवाको सानाम बाङ दो बाय बेनाव आकात्? <verse eid="ACT 7:50" /><verse number="51" style="v" sid="ACT 7:51" />ए आपे केटेच् मोनानको, ओनतोर आर लुतुर गोधड़ोवानको, आपे दो जावगे सोनोत जिउपे बिरुदायकाना; चेत् लेका आपेरेन हापड़ामकोको का़मिलेत्‌, आपे हों ओनकागे।<note caller="+" style="x"><char style="xo" closed="false">7:51 </char><char style="xt" closed="false"><ref loc="EXO 32:9">एकसो ३२:९</ref>; <ref loc="ISA 63:10">जेसा ६३:१०</ref>; <ref loc="NUM 27:14">नुमे २७:१४</ref>; <ref loc="JER 6:10">जिरि ६:१०</ref>; <ref loc="JER 9:26">९:२६</ref></char></note> <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />ना़बिको मोदरेन ओकोयटाक् हाले आपेरेन हापड़ामको दो बाको सानतावलेदेया? हें, ओनको दो गोच् होंको गोच्‌केत्‌कोवा, ओकोय उनि भागेयिच् रेयाक्‌ हिजुक्‌को ला़इ लाहालेत् ताहेंकान, ओने उनि सोपरोतको आर खुखुनकोगे आपे नितपे होयाकान।<note caller="+" style="x"><char style="xo" closed="false">7:52 </char><char style="xt" closed="false"><ref loc="MAT 5:12">माथ ५:१२</ref></char></note> <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />आपे ओकोय दुतको रेयाक्‌ बाँधावाक् मेनकाते आ़नपे आताङाकात्, आर एनहों बापे दोहोआकादा।<verse eid="ACT 7:53" /></para>
  <para style="s">इस्टिफाने तिञगोच् ओचोक्‌कान</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />आदो ओनाको आँजोमकेत् खान आकोवाक् मोनरेको सोबोक् ताप्एन आरको तोगोच् डाटावादेय।<note caller="+" style="x"><char style="xo" closed="false">7:54 </char><char style="xt" closed="false"><ref loc="JOB 6:9">जोब ६:९</ref>; <ref loc="PSA 35:16">सेरे ३५:१६</ref>; <ref loc="PSA 37:12">३७:१२</ref>; <ref loc="PSA 112:10">११२:१०</ref></char></note> <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />मेनखान उनि दो सोनोत जिउते पेरेच्आकान सेरमा सेच् कोयोक्‌केत्‌ते इसोराक् ठोनोके ञेलकेदा, इसोराक् एतोम सेच्‌रे जिसु तेङगोवाकान; <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />आरे मेनकेदा, “ञेलपे इञ दो सेरमा झिच्‌आकान आर मानवा होपोन दो इसोराक् एतोम सेच्‌रे तेङगोवाकान इञ ञेलेकाना।”<verse eid="ACT 7:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57" />मेनखान ओनको दो आँट आड़ाङते होहोकेत्‌ते आकोवाक् लुतुरको तुबेत्‌केत्‌ताकोवा, आर मित् जुमते उनिको झापटावकेदेया; <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />आर नागराहा बाहरेते ओडोक इदिकेदेते धिरितेको तिञकेदेया। आर गोहाको दो सा़उल ञुतुमान मित्‌टेन जुवा़न होड़ाक् जाङगा ठेन आकोवाक्‌ किचरिच्‌को दोहोकेदा। <verse eid="ACT 7:58" /><verse number="59" style="v" sid="ACT 7:59" />आर इस्टिफानको तिञेकान ताहेंकाना, आर उनि दोए कोयेत्‌कान ताहेंकान तुलुच्‌, “ए प्रोभु जिसु इञाक् जिवि आताङ तिञमे।”<note caller="+" style="x"><char style="xo" closed="false">7:59 </char><char style="xt" closed="false"><ref loc="PSA 31:5">सेरे ३१:५</ref></char></note> <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />आर इखड़ुमेनते आँट आड़ाङतेये होहोकेदा, “ए प्रोभु नोवा का़इ दो आलो बाड़ेम लेखावाकोवा,” आर ओनाय मेनकेत् खाने जा़पित् केदा।<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />आर सा़उल दो उनि गोच् ओचोक्‌रे रा़जिगेये ताहेंकाना।</para>
  <para style="s" vid="ACT 8:1">सा़उल का़लिसिया़रेनकोय सानतावेत्‌को</para>
  <para style="p" vid="ACT 8:1">आर एनहिलोक् दो जेरुसालेमरे ताहेंकान का़लिसिया़ उपा़रते माराङ ओकोच् सानताव एहोप् एना; आर आपोसतोलको छाडा सानाम जिहुदा़ आर सा़मा़रिया़ रेयाक्‌ टोठाकोतेको छिञछा़तुर एना, <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />आर इसोर भोकति होड़को दो इस्टिफानको बायकेदेया आर उनि ञुतुमते आ़डिको होमोर हालाङकेदा।<verse eid="ACT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 8:3" />मेनखान सा़उल दो का़लिसिया़ उक्‌जा़ड़तेगेये ताहेंकाना, आर ओड़ाक् ओड़ाक् बोलोकाते हेरेल आर मायजिउको ओर तोत्‌काते हाजोतोक् ला़गित्‌ए सोपरोतेत्‌को ताहेंकाना।<note caller="+" style="x"><char style="xo" closed="false">8:3 </char><char style="xt" closed="false"><ref loc="ACT 22:4-5">आ का़ २२:४-५</ref>; <ref loc="ACT 26:9-11">२६:९-११</ref> </char></note><verse eid="ACT 8:3" /></para>
  <para style="s">सा़मा़रिया़रे भागे सोमबात पोरचारोक्‌काना</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />आर छिञछा़तुरेनको दोको सेन इदियेना भागे सोमबात रेयाक्‌ काथा पोरचार पोरचारते। <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />आर फिलिप दो सा़मा़रिया़ रेयाक्‌ मित्‌टेन नागराहाते फेड सेनेनते ओंडेनको मा़सि रेयाक्‌ए पोरचारात्‌कोवा। <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />आर गादेल होड़को दो फिलिपे ला़इयाकोकान ताहेंकानाक्‌को मित् मोनतेको हेतावादा, ओनेको आँजोमकेत्‌ताय आर उनिये का़मियेत्‌ ताहेंकान चिनहा़कोको ञेलानते। <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />एनते बेसाफा जिउको ताहेंकानताकोवा आयमा होड़को खोन ओनको दो आँट होहोवातेको ओडोकेना; आर आ़डि उता़र मित् काड़ गोच् होड़ आर लेडहाकोको बोगे ओचोयेना। <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />आर ओना नागराहारे आ़डि रा़सका़ होयेना।<verse eid="ACT 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />मेनखान सिमोन ञुतुमान मित् होड़ पा़हिल खोन ओना नागराहारेये ताहेंकाना, ओने उनि दोए गुनियेत् ताहेंकाना आर सा़मा़रिया़रेन होड़कोय ठाक ओचोयेत्‌को ताहेंकान, आच्‌गे मित्‌टेन माराङ होड़े ला़इयोगोक्‌कान ताहेंकानते, <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />उनि दो हुडिञ हापड़ाक् सानामको मानोतायकान ताहेंकाना, ओनेको मेनेत् ताहेंकान, “नुयगे इसोर रेयाक्‌ दाड़े दो, ओने माराङे ञुमोगोक्‌कान।” <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />उनिको गानावएदे ताहेंकाना, एनते आ़डि दिन खोन गुनिकोते ओनकोय ठाक ओचोआकात्‌को ताहेंकाना। <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />मेनखान इसोराक् राज आर जिसु मा़सियाक् ञुतुम रेयाक्‌ भागे सोमबाते पोरचारात्‌कोते फिलिप रेयाक्‌को पा़तिया़वात्‌ताय खानको बा़प्‌तिस ओचोयेना, हेरेल हों आर मायजिउ हों। <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />आर सिमोन आच् होंए पा़तिया़वेना, आर बा़प्‌तिस ओचोयेनते फिलिप तुलुच् जामाड़ाकाने ताहेंयेना, आर चिनहा़को आर माराङ दाड़ेयानाक् का़मिको होयोक्‌कान ञेलतेये ठाकएना।<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />आदो जेरुसालेमरेको ताहेंकान आपोसतोलको आँजोमकेत् खान, बाङमा, सा़मा़रिया़रेनको दो इसोराक् काथाको आताङकेदा, ओनको ठेन पातरास आर जोहानको कोलकेत्‌किना; <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />आर उनकिन दो हेच्एनते बिसवा़सिको ला़गित्‌किन कोयकेदा, जेमोन सोनोत जिउको ञामे। <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />उन हा़बिच् एनते ओनको मोदरेन ओकोयरे हों सोनोत जिउ दो बाय हेच् आकान ताहेंकाना, एकेन प्रोभु जिसु ञुतुमतेको बा़प्‌तिस आकान ताहेंकाना। <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />खानगे पातरास आर जोहान दो ओनकोकिन चापोकेत्‌कोवा आर सोनोत जिउको ञाम केदेया।<verse eid="ACT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18" />आदो आपोसतोलकिन तिकिन चापोवाकोते सोनोत जिवे एमोगोक्‌काना मेनते सिमोने ञेलकेत् खान टाका नेयात्‌किनतेये मेतात्‌किना, <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />“नोवा एकतिया़रि दो देन इञ हों एमा़ञबेन, जेमोन जाहाँयगेञ चापोये सोनोत जिवे ञामे।”<verse eid="ACT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20" />मेनखान पातरास दोए मेतादेया, “आमाक् टाका दो आम साँवते बाड़े नोसटोक् मा एनते इसोर रेयाक्‌ दान दो टाकाते ञामोक्‌काना मेनतेम हुदिसकेत् इया़ते। <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />नोवा काथारे होक से बाखरा दो बा़नुक्‌तामा, एनते आमाक् मोन दो इसोर सामाङरे बाङ सोजहेतामा।<note caller="+" style="x"><char style="xo" closed="false">8:21 </char><char style="xt" closed="false"><ref loc="PSA 78:37">सेरे ७८:३७</ref></char></note> <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />ओनाते आमाक् दुस्‌टा़मि खोन मोन बाड़े आ़चुरताम, आर प्रोभु ठेन नेहोंरजोङमे, पासेच्‌रे पासेच् आमाक् मोन रेयाक्‌ हुदिस दो इका़क्‌तामगे। <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />एनतेञ ञेलेदा, हाड़हात् सिसिर रेयाक्‌ हाड़हात्‌रे आर बा़ड़िच्‌आक्‌को रेयाक्‌ तोनोलरे मेनामा।”<verse eid="ACT 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24" />खानगे सिमोने रोड़ रुवा़ड़केदा, “आबेनगे इञ ला़गित्‌ प्रोभु ठेन नेहोंरोक्‌बेन, जेमोन आबेन बेन रोड़ाकात्‌को दो ओकाटाक् हों इञरे आलो बाड़े पाड़ावक्।”<verse eid="ACT 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25" />आदो उनकिन दो गोहा एम इदिकेत्‌ते जेरुसालेमतेकिन रुवा़ड़ेना, सा़मा़रिकोवाक् आयमा आतोकोरे भागे सोमबात किन पोरचार इदिकेदा।<verse eid="ACT 8:25" /></para>
  <para style="s">फिलिप आर इथुपिया़रेन माराङ एकतिया़रियान होड़</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />आर प्रोभुरेन मित्‌टेन दुत दो फिलिपे मेतादेया, मा बेरेत्‌मे आर दा़खिन सेच् ओना होरते चालाक्‌मे ओकाटाक् जेरुसालेम खोन गाजाते सेनआकान, ओना दो निसुनगेया। <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />आर उनि दो बेरेत् एनतेये चालावेना आर ञेलपे इथुपिया़रेन मित्‌टेन होड़, इथुपिया़ कानदाके रा़निरेन माराङ एकतिया़रियानिच् मित्‌टेन चा़करा़ ओकोय उनियाक् सानाम धोनरेन लोनबोनिच् ए ताहेंकाना। उनि दो जेरुसालेमतेये हेच्‌लेन ताहेंकाना देवा सेवाय ला़गित्‌; <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />आरे रुवा़ड़ चालाक्‌कान ताहेंकानरे आयाक्‌ सादोम गा़डिरे दुड़ुप्‌काते जेसाया ना़बि रेयाक्‌ पुथिये पाड़हावजोङकान ताहेंकाना। <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" />आर जिउ दो फिलिपे मेतादेया, दो सेन सोरोक्‌मे आर ओना सादोम गा़डि साँवतेक्‌मे। <verse eid="ACT 8:29" /><verse number="30" style="v" sid="ACT 8:30" />खानगे फिलिप दो ञिर सोरेनते जेसाया ना़बि रेयाक्‌ पुथि पाड़हावक्‌काने आँजोम केदेया; आदोए मेतादेया, आमेम पाड़हावेत्‌ दोम बुजहा़वेत्‌गेया से?<verse eid="ACT 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31" />खानगे उनि दोए मेनकेदा, चेकातेञ दाड़ेकेया, जाहाँय बाय बुजहा़वा़ञ खान? आर फिलिपे नेहोंरादेया जेमोन देच्‌काते आच् साँवतेये दुड़ुप्‌। <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />आर ओकाटाक्ए पाड़हावेत्‌ ताहेंकान सोसतोर रेयाक्‌ हा़टिञ दो नोक्ओंय नोवा ताहेंकाना,</para>
  <para style="q2" vid="ACT 8:32">भिडि लेका तेङगेनोक्‌ ला़गित्‌ए तिया़क् इदिओचोयेना</para>
  <para style="q2" vid="ACT 8:32">आर भेडा होपोन आच् का़पचियेदेकानिच् सामाङरे हापे आकाने ताहेनकान लेका,</para>
  <para style="q2" vid="ACT 8:32">ओनकागे आयाक्‌ मोचा बाय चाहाप् लेत्‌ताया।<verse eid="ACT 8:32" /></para>
  <para style="q2">
    <verse number="33" style="v" sid="ACT 8:33" />उनियाक् निंधा़न दोसारे उनियाक् बिचा़र दो इदि फाराकेनताया;</para>
  <para style="q2" vid="ACT 8:33">उनि पिड़हिरेनको दो ओकोय ला़इ दाड़ेकेकोवा?</para>
  <para style="q2" vid="ACT 8:33">एनते धा़रति खोन उनियाक् जियोन दो उठा़उक्‌काना।<note caller="+" style="x"><char style="xo" closed="false">8:33 </char><char style="xt" closed="false"><ref loc="ISA 53:7">जेसा ५३:७</ref>,<ref loc="ISA 53:8">८</ref></char></note><verse eid="ACT 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34" />आर उनि चा़करा़ दो फिलिपे मेतादेया, नेहोंराम का़ना़ञ ना़बि दो ओकोय रेयाङ नोवाय रोड़ेदा? आच् रेयाङ से जाहाँय एटागिच् रेयाङ? <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />खान फिलिप दो गालमारावे एहोप्‌केदा आर ओना सोसतोर रेयाक्‌ खोन एहोप्‌काते जिसु रेयाङ भागे सोमबाते ला़इयादेया। <verse eid="ACT 8:35" /><verse number="36" style="v" sid="ACT 8:36" />आर होर होरतेकिन सेनोक्‌कान ताहेंकानरे मित्‌टेच् दाक् जायगा ठेनकिन सेटेरेना; आर चा़करा़ दोए मेनकेदा, “नोक्ओंय चोङ दाक् चेत् आकोट मेनाक्आ इञिञ बा़प्‌तिस ओचोक्‌रे दो?” <verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" />आर फिलिपे मेनकेदा, “आमाक् गोटा मोनतेम पा़तिया़उक्‌कान खान बोगेगे।” आर उनि दो रोड़ रुवा़ड़केत्‌तेये मेनकेदा, “पा़तिया़वाकानगेया़ञ जिसु मा़सि दो इसोररेन होपोन कानाय मेनते”<verse eid="ACT 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 8:38" />आर सादोम गा़डि तेङगोये हुकुमकेदा आर बाना होड़ दाक्‌तेकिन फेड सेनेना, फिलिप हों आर चा़करा़ हों, आदो उनिये बा़प्‌तिसकेदेया। <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />आर दाक् खोन किन राकाप्एन खान प्रोभुरेन जिउ दो फिलिपे इदि केदेया, आर चा़करा़ दो घुरिया़ँ उनि बाय ञेललेदेया, खान रा़सका़वाते आयाक्‌ होरतेये सेन इदियेना। <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />खान फिलिप दो आसदोदरेये ञामेना, आर पारोम चालाक् तुलुच् सानाम नागराहारे भागे सोमबाते पोरचार इदिकेदा, का़इसा़रिया़रे आ़उरिये सेटेरोक् हा़बिच्।<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s">सा़उलाक्‌ जियोन बोदोलोक्‌कान</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />मेनखान सा़उल दो उन हा़बिच् प्रोभुरेन चेलाको धोमकाव आर खुखुन रेयाक्‌ए किसकिसा़उ बाड़ायकान ताहेंकाना, आर उनि दो माराङ नायके ठेने चालावेना। <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />आर दामेसेक रेयाक्‌ सुना़गोगरेनको ञुतुमते चिठिये कोयकेदा, जेमोन ओना होररेन जाहाँयगेये ञामलेको खान, बाङ दो हेरेल होपोनको, बाङ दो मायजिउको, तोलकाते जेरुसालेमतेये आ़गुको।<verse eid="ACT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 9:3" />आर चालाक् चालाक्‌ते दामेसेक ठेने सोरेना। खान आचकागे सेरमा खोन मित्‌टेच् मारसाल उनि बेड़हायते बाम्बेरेना। <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />आर ओतरे भिनदा़ड़ेनते मित्‌टेच् आड़ाङ मेतायकाने आँजोमकेदा, “ए सा़उल, ए सा़उल, चेदाक्‌एम खेदेञकाना?”<verse eid="ACT 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5" />आदोए मेनकेदा, “ओकोय कानाम, प्रोभु?” खानगेये मेतादेया, “इञ दो जिसु का़ना़ञ, ओकोय आमेम खेदेञकान। <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />मेनखान बेरेत्‌मे आर नागराहाते बोलोक्‌मे आदोको ला़इयामा चेत् चेका होयोक्‌तामा मेनते।”<verse eid="ACT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7" />आर उनि तुलुच् चालाक्‌कान ताहेंकान होड़ दोको तेङगो हापेयेना, एनते आड़ाङ माको आँजोमकेत्‌ मेनखान चेले हों बाको ञेलेकान ताहेंकाना। <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />आर सा़उल दो ओत खोने बेरेत्एना, आर मेंत्‌ए बेङगेत्‌केत् खान चेत् हों बाय ञेल दाड़ेयादा, आदो तिया़क्‌केदेते दामेसेकतेको इदि सेटेरकेदेया। <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />आर पे माँहाँ बेगोर ञेञेलकानगेये ताहेंयेना, आर जोम हों बाय जोमलेत्‌आ आर ञु हों बाय ञुलेत्‌आ।<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />आर दामेसेकरे आनानिया़स ञुतुमान मित्‌टेन चेलाय ताहेंकाना, आर प्रोभु दो दोरसोनते उनिये मेतादेया, “ए आनानिया़स।”</para>
  <para style="p" vid="ACT 9:10">आदोए मेनकेदा, “मेना़ञगेया नोक्ओंय ए प्रोभु।”<verse eid="ACT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11" />खानगे प्रोभु उनिये मेतादेया, “मा बेरेत्‌काते सोजहेको मेताक् कुलहिते चालाक्‌मे आर जिहुदा़ ओड़ाक्‌रे सा़उल ञुतुमान ता़रसुसरेन मित्‌टेच् होड़ खोजेमे एनते ञेलमे उनि दोए कोयजोङकाना, <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />आरे ञेलआकादेया, आनानिया़स ञुतुमान मित्‌टेन होड़ बोलोकातेये चापो आकादेया, जेमोने ञेञेल।”<verse eid="ACT 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13" />मेनखान आनानिया़से रोड़ रुवा़ड़केदा, “ए प्रोभु, आ़डि होड़ ठेन खोन नुय होड़ रेयाङ दोञ आँजोम आकादा, आमरेन सोनोतको जेरुसालेमरे तिना़क् बा़ड़िच्ए चेका आकात्‌कोवा; <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />आर नोंडे दो माराङ नायकेको ठेन खोन एकतिया़रि मेनाक्‌ताया, आमाक् ञुतुम दोहायको सानाम तोलको ला़गित्‌”<verse eid="ACT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15" />मेनखान प्रोभु दो उनिये मेतादेया, “चालाक्‌मे एनते उनि दो बाछाव भाजान कानतिञाय, इञाक् ञुतुम जिहुदि बाहरेरेन होड़को आर रापाजको आर इसराएल होपोन सामाङरे इदि सेटेर ला़गित्‌। <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />एनते इञगेञ उदुक्आया, इञाक् ञुतुम इया़ते तिना़क् दुख जोजोम होयोक्‌ताया मेनते।”<verse eid="ACT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17" />खान आनानिया़से चालावेना आर ओना ओड़ाक्‌तेये बोलोयेना, आर तिकिन चापोवादेतेये मेनकेदा, “बोयहा सा़उल प्रोभुइ कोल आकादिञा, उनि जिसुगे, ओने ओकोय आमेम हेच्एन होररे आम ठेने ञेल ओचोयेन, जेमोनेम ञेञेल आर सोनोत जिउतेम पेरेजोक्।” <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />खानगे साटमेनते उनियाक् मेंत्‌ खोन चुया़ँक् लेका फा़न्‌टिल ञुर गोत्एना, आरे ञेल रुवा़ड़केदा आर उनि दो बेरेत्एनतेये बा़प्‌तिस ओचोयेना, <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />आर जोमकेत्‌तेये दाड़ेयेना।</para>
  <para style="s" vid="ACT 9:19">सा़उल दामेसेकरेये पोरचारेत्</para>
  <para style="p" vid="ACT 9:19">आर दामेसेकरे ताहेंकान चेलाको ठेन तिन उडिच्‌ दिन चोय ताहेंयेना, <verse eid="ACT 9:19" /><verse number="20" style="v" sid="ACT 9:20" />आर बिन बिला़मते सुना़गोगकोरे जिसुइ ला़इ सोदोरकेदेया, बाङमा नुयगे इसोररेन होपोन दो।<verse eid="ACT 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 9:21" />आर आँजोमकेत् सानामको दो ठाकेनतेको मेनकेदा, “चेत् नुय दो उनि दोए बाङ काना, ओकोय जेरुसालेमरे नोवा ञुतुम दोक्‌हायकोय सानतावेत्‌को ताहेंकाना आर नोंडे हों नोवा मेनतेगेये हेच्‌लेन ताहेंकाना जेमोन ओनको तोलकाते माराङ नायके ठेने इदिको?”<verse eid="ACT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 9:22" />मेनखान सा़उल दोए दाड़े इदियेना, आर दामेसेकरे बेरेलाकान जिहुदिकोय थारबासाव ओचोकेत्‌कोवा, उनिगे मा़सि कानाय मेनतेये सा़बुतात्‌कोवा।<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />आर ढेर दिन होयेन खान जिहुदिको उनि गोजेको मिलिमिसिया़वाना, <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />मेनखान सा़उल दो ओनकोवाक् पोन्‌थाय बाडाय ञामकेदा। आर ओनको दो गोजेया मेनते फाटोककोरे सिञ ञिंदा़को पाहराआकायको ताहेंकाना, <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />मेनखान उनिरेन चेलाको दो ञिंदा़ इदिकेदेते पा़चरि चोट खोन मित्‌टेन खा़चला़क्‌तेको फेड गोत्‌कादेया।<verse eid="ACT 9:25" /></para>
  <para style="s">सा़उल जेरुसालेमरे</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />आदो सा़उल जेरुसालेमतेये सेटेरेन खान चेलाको तुलुच् सोङगेक्ए कुरुमुटुकेदा, आर सानाम होड़ सा़उलको बोतोरायकान ताहेंकाना, चेला कानाय मेनते बाको पा़तिया़उक्‌कान ताहेंकानते। <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />मेनखान बारनाबास दो सा़उल ए सोङगेकेदेते आपोसतोलको ठेने इदि केदेया, आरे ला़इयात्‌कोवा चेत् लेका उनि दो होररे प्रोभुइ ञेललेदेया, आरे गालमारावादेया आर चेत् लेका दामेसेकरे जिसुवाक् ञुतुमते सोहोसातेये पोरचारलेत्‌आ <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />आर जेरुसालेमरे ओनको तुलुच्ए बोलो ओडोकोक्‌कान ताहेंकाना, प्रोभुवाक् ञुतुमते सोहोसाते पोरचारे एहोप्‌एना। <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />आर जुना़नि रोरोड़ जिहुदिको तुलुच्ए गालमाराव आरे का़फा़रिया़क्‌कान ताहेंकाना, मेनखान ओनको दो गोजे ला़गित्‌को गोटाकेदा। <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />आदो बोयहाको ओनाको बाडाय ञामकेत्‌ खान का़इसा़रिया़तेको इदि केदेया आर ता़रसुसतेको कोल गोत्‌कादेया<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />आर गोटा जिहुदा़ आर गा़लिल आर सा़मा़रिया़ रेयाक्‌ का़लिसिया़रेनको दोको सुलुक निरा़येना, ओनेको बेनाव राकाप् इदिक्‌कान आर प्रोभु रेयाक्‌ बोतोररेको ताड़ामेत्‌ ताहेंकानते आर सोनोत जिउ रेयाक्‌ सोहोत्‌तेको साङगे इदियेना।<verse eid="ACT 9:31" /></para>
  <para style="s">पातरास लुड्‌डा़ आर जोप्‌पारे</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />आदो नोनका होयेना, पातरास गोटा टा़न्‌डिये दाँड़ाँआ़चुरेत् ताहेंकानरे, लुड्‌डा़रेको बेरेलाकान ताहेंकान सोनोत होड़को ठेन होंए हेच्एना। <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />आर ओंडे दो एनिया़स ञुतुमान मित् होड़े ञाम केदेया, ओने उनि इरा़ल सेरमा खोन पारकोमरेये जाड़ावआकान ताहेंकाना, एनते मित् काड़ दो गोच्‌गेये ताहेंकाना। <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />आर पातरास दो उनिये मेतादेया, ए एनिया़स जिसु मा़सिये बोगेयेत्‌मेया, मा बेरेत्‌मे आर आमाक्‌ आटेत्‌ सामटावताम, खानगे उनि दो साटमेनेतेये बेरेत्‌ गोत्‌एना। <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />आर लुड्‌डा़ आर सारोनरेनको, सानामको दो उनिको ञेल केदेया आर प्रोभु सेच्‌को आ़चुरेना।<verse eid="ACT 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />आर जोप्‌पारे मित्‌टेच् मायजिउ चेलाय ताहेंकाना, ञुतुमताय दो ता़बिता, ओना दो जुना़नि तोरजोमाते दोरकास उनि दो भागे का़मिरे आर एमोक्‌रे हों किसा़ँड़े ताहेंकाना। <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />आर ओनाको दिनरे उनि दोए रुवा़ का़हिलेनतेये गोच्एना, आदो उम साफाकेदेते मित्‌टेच् चेतान कांदहारेको दोहोकादेया। <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />लुड्‌डा़ दो जोप्‌पा सोरगेया आर चेलाको दो आर पातरास ओंडे मेनाया मेनतेको आँजोमकेत् खान, बार होड़ उनि ठेन कोलकेत्‌किनतेको नेहोंरादेया, दे आलेठेन हेच् होदोक्‌मे। <verse eid="ACT 9:38" /><verse number="39" style="v" sid="ACT 9:39" />खानगे पातरास दो बेरेत्एनते उनकिन तुलुच्ए चालावेना, आर उनिये सेटेरेन खान चेतान कांदहातेको आ़युर राकाप्‌ केदेया, सानाम रा़ँडि मायजिउको उनि ठेन तेङगोयेनते राक् राक्आते आङगरोप आर किचरिच्‌कोको उदुक्एत् ताहेंकाना। ओने ओनाको दोरकासे बेनावलेत्, ओनको तुलुच्ए ताहेंकानरे। <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />मेनखान पातरास दो सानामको बाहरेतेये ओडोककात्‌कोवा, आर इखड़ुमकातेये कोयकेदा, आर मा़ँड़िं सेच् आ़चुरेनतेये मेनकेदा, ए ता़बिता मा बेरेत्‌मे। खानगे उनि दोए बेङगेत् राकाप्‌केदा आर पातरासे ञेलकेदे खाने बेरेत् दुड़ुप्‌ एना। <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />आदो ति साप्‌कातेये बेरेत्‌ केदेया; आर सोनोतको आर रा़ँडि मायजिउको होहोवात्‌कोते जिवेत्‌गे ओनको सामाङरेये तेङगोकेदेया। <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />आर ओना दो गोटा जोप्‌पारे बाडायेना, आर आ़डि होड़ प्रोभुरेको पा़तिया़वेना। <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />आदो जोप्‌पारे मित्‌टेन हारता रेयाक्‌को का़क्‌मियिच्‌ सिमोन ञुतुमान होड़ ठेन उनि दो ढेर दिने ताहेंयेना।<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s">पातरास आर कोरनेलियुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />का़इसा़रिया़रे दो कोरनेलियुस ञुतुमान मित् होड़े ताहेंकाना, इटा़लिया़को मेताक् पालटोन खातारेन मित्‌टेन सुबेदार, <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />मित्‌टेन इसोर भोकति होड़ आर आच् घारोंजरेनको सुदहा़ इसोर बोतोरायकान होड़गे, उनि दो होड़को आ़डिये एमाकोकान ताहेंकाना आर जावगे इसोर ठेने कोयजोङ कान ताहेंकाना। <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />उनि दो तारासिञ बेर पे बाजा गान ओकते दोरसोनते इसोररेन मित्‌टेन दुत पुसटा़उतेये ञेल केदेया, आच् ठेन बोलोक्‌कान आरे मेतायकान, “ए कोरनेलियुस।” <verse eid="ACT 10:3" /><verse number="4" style="v" sid="ACT 10:4" />खानगे उनिसेच् बोतोर सातालाक्‌ए बेङगेत्‌केत्‌तेये मेनकेदा, “चेत् काना प्रोभु?”</para>
  <para style="p" vid="ACT 10:4">आदो उनिये मेतादेया, “आमाक् कोयजोङ आर रेङगेच्‌ ओरेच्‌को एमाको दान दिक्‌सा़वाक् मेनते इसोर ठेन राकाप्‌ आकानतामा। <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />मा नितोक् दो जोप्‌पाते होड़ कोलकोम, आर पातरासको मेताय सिमोन होहो आ़गु ओचोयेम; <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />उनि दो हारता रेयाक्‌को का़क्‌मियिच्‌ सिमोन ठेने डेराआकान, ओने उनियाक् ओड़ाक् दो जालापुरि आड़ेरेताय।” <verse eid="ACT 10:6" /><verse number="7" style="v" sid="ACT 10:7" />आदो आच् तुलुच् गालमारावकान दुते चालावेन खान गुतिको मोदरेन बार होड़ आर आच्‌रे जामाड़को मोद खोन मित्‌टेन इसोर भोकति पालटोने होहोवात्‌कोवा; <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />आर सानामाक्ए ला़इ बुजहा़वात्‌कोते जोप्‌पातेये कोलकेत्‌कोवा।<verse eid="ACT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />आर दोसार हिलोक् होरतेको चालाक्‌कान आर नागराहा ठेनको सोरोक्‌कान ताहेंकानरे तिकिनोक् देलादिलि पातरास दो कोयजोङ ला़गित्‌ छाततेये देच्एना। <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />आर रेङगेच्‌केदेते जोजोम साना केदेया मेनखानको तेक्‌यारकान ताहेंकानरे उनि दोए धेयान मोगोनेना, <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />आर सेरमा झिच्आकान आर मित्‌टेच् जिनिस फेड हिजुक्‌काने ञेलेत्‌काना, मित्‌टेच् ला़टु पिछा़उड़ि लेकानाक्, ओने पोनोन कोंड तोलआकान ओतरे फेडोक्‌काने ञेलकेदा <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />ओनारे दो जोतो लेकान पोन जाङगावानको, आर ओतरे लेञोक्‌को आर चोटरेन उडा़उक्‌ चेंड़ेंकोको ताहेंकाना। <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />आर मित्‌टेच् आड़ाङ हेच्आदेया, “मा बेरेत्‌मे, ए पातरास, गोच्‌काते जोमकोम।”<verse eid="ACT 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14" />मेनखान पातरास दोए मेनकेदा, “ओहोगे प्रोभु, एनते जाहान छुताक्‌ आर बेसाफावाक् दो तिस हों बा़ञ जोमआकादा,”<verse eid="ACT 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15" />आदो आर दोसार छोट आड़ाङ हेच्आदेया, “ओकाको इसोरे साफावाकात् ओनाको आम दो छुताक्‌ आलोम मेताक्आ।” <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />आर ओनका दो पे धाव होयेना, खान साट मेनते ओना दो सेरमाते राकाप् ओचोयेना।<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />आर पातरास दो आच्ए ञेललेत् दोरसोन चेत्‌काना मेनते मोनेरेये आसबासावआकान ताहेंकाना, ञेलपे कोरनेलियुसे कोललेत्‌को होड़ दो सिमोनाक् ओड़ाक् कुलि कुलिते ञामकाते दुवा़रा ठेनको तेङगोवाकाना, <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />आर होहोकातेको कुलिजोङकाना, पातरासको मेताय सिमोन ओंडेये डेराआकाना से बाङ।<verse eid="ACT 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19" />आर पातरास दो दोरसोन रेयाङे हुदिसजोङकान ताहेंकानरे जिउ दोए मेतादेया ञेलमे पे होड़को ञाम बाड़ायेत्‌मेया। <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />बेरेत्‌काते हिजुक्‌मे आर ओनको साँवते चालाक्‌मे, बेगोर जाहान दिगधा़ते एनते इञगेञ कोल आकात्‌कोवा। <verse eid="ACT 10:20" /><verse number="21" style="v" sid="ACT 10:21" />आदो पातरास ओनको होड़ ठेन फेड सेनकातेये मेतात्‌कोवा, “ञेलपे आपेपे ञाम बाड़ायेदेकानिच् दोञ इञ कानगेया; आपेपे हेच् आकान रेयाक्‌ कारोन दो चेत्?”<verse eid="ACT 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22" />आदोको मेतादेया, कोरनेलियुस, मित्‌टेन सुबेदार, भागे आर इसोर बोतोरायकान होड़ आर जोतो जिहुदि जा़तरेनको ठेन आ़डि मानोतान होड़, उनि दो सोनोत दुत होतेतेये चेहाव ओचोयेना, आच् ओड़ाक्‌ते आमे होहो इदिमे आर आमठेन काथाको आँजोमजोङ ला़गित्‌। <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />आदो पातरास ओनको होहो आदेरकेत्‌कोतेये पेड़ाकेत्‌कोवा।</para>
  <para style="p" vid="ACT 10:23">आदो दोसार हिलोक् बेरेत्‌काते ओनको तुलुच्ए ओडोक चालावेना, आर जोप्‌पारेन बोयहाको मोदरेन आदोम आदोमको उनि साँवतेको चालावेना। <verse eid="ACT 10:23" /><verse number="24" style="v" sid="ACT 10:24" />आर ओना दोसार हिलोक् का़इसा़रिया़तेको बोलोयेना; आर कोरनेलियुस दो ओनकोय ञेल होरेत्‌को ताहेंकाना, आच्‌रेन पेड़ा आर सोररेन गातेको होहो जारवाकाते। <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />आदो पातरासे बोलोक्‌कान ताहेंकान जोखेच् कोरनेलियुस दो उनिये दारामकेदेतेये सेवावादेया। <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />मेनखान पातरास दो उनि बेरेत्‌केदेतेये मेनकेदा, “मा बेरेत्‌मे इञ हों चोञ मानवाकानगे।” <verse eid="ACT 10:26" /><verse number="27" style="v" sid="ACT 10:27" />आर उनि तुलुच् गालमाराव गालमारावतेये बोलोयेना खान, आयमा होड़ हेच् जारवा आकाने ञामकेत्‌कोवा। <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />आरे मेतात्‌कोवा, जिहुदि होड़को ला़गित्‌ दो बाङ गानोक्आक् काना एटाक् जा़तरेनको तुलुच्‌को गातेक्, से ओनको ठेनको बोलो ओडोकोक् दो, मेनखान इञ दो इसोरे उदुक्आकावादिञा ओकोय होड़ हों छुत से बेसाफा आलोञ मेताको ला़गित्‌; <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />ओनातेगे इञ दो बेगोर ढेंसतेञ हेच्एना, होहोवादिञ तोरागे, ओनातेञ कुलिजोङ काना, चेत् मेनतेपे होहो आ़गुवाकादिञा?<verse eid="ACT 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30" />आदो कोरनेलियुसे मेनकेदा, पोन माँहाँ होयोक्‌काना, निया़ बेर लेका, मेताक्‌मे, तारासिञ बेर जोखेच्‌ इञाक् ओड़ाक्‌रेञ कोयजोङकान ताहेंकाना; खानगे ञेलमे, पोंड किचरिच् होरोक्‌ आकात् मित् होड़ इञ सामाङरेये तेङगोयेना, <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />आरे मेनकेदा, ए कोरनेलियुस; आमाक् कोयजोङ दो आँजोमेनतामा आर आमाक् कोय एमोक्‌को दो दिसा़वाकानतामा इसोर सामाङरे। <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />आदो जोप्‌पाते होड़ कोलकोम आर पातरासको मेताय हारता रेयाक्‌को का़क्‌मियिच्‌ सिमोन ओड़ाक्‌रे जालापुरि आड़ेरेये डेराआकाना। <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />खान इना़ घा़ड़िच्‌तेगे आम ठेन होड़िञ कोलकेत्‌कोवा; आरेम हेच्एनते दोम बोगेकेदा। आर नोक्‌ओंय आले सानामकोगे इसोर सामाङरे मेनाक्‌लेया, प्रोभुइ हुकुमाकावात् मे जोतोवाक् आँजोम ला़गित्‌।<verse eid="ACT 10:33" /></para>
  <para style="s">पातरासाक् गालमाराव</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />खानगे पातरास दो रोरोड़ एहोप्एनतेये मेनकेदा, सा़रिया़क्‌काना मेनतेञ बुजहा़उ ओरोमेदा, बाङमा, इसोर दो मेंत्‌हाँ बेङगेत्आक्इच् दोए बाङ काना।<note caller="+" style="x"><char style="xo" closed="false">10:34 </char><char style="xt" closed="false"><ref loc="DEU 10:17">देउ १०:१७</ref> </char></note> <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />बिचकोम मिमित् जा़तरेनकोरे आच्‌को बोतोरायकान आर भागेयाक्‌को का़मियेत्‌ कानकोय आताङेत्‌कोवा। <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />ओना काथा ओकाटाक् इसराएल होपोनकोय कोलात्‌को, सुलुक रेयाक्‌ भागे सोमबात पोरचारात्‌कोते जिसु मा़सि होतेते उनिगे सानामकोरेन प्रोभु। <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />आपे दो ओना काथापे बाडाया, ओकाटाक् गोटा जिहुदा़रे होयेन, गा़लिल खोन एहोप्‌काते जोहाने पोरचारकेत् बा़प्‌तिसमा तायोम; <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />नासारेतरेन जिसु रेयाङगे, चेत्‌लेका इसोर दो सोनोत जिउते आर दाड़ेते उनिये ओजोक्‌केदे; ओने उनि दो दाँड़ाँ दाँड़ाँते भागे का़मिये का़मिकेत् आर सायतान ठेन जोतो जुलुम ओचोक् कानकोय बोगेकेत्‌को एनते इसोर दो उनि तुलुच्ए ताहेंकाना। <verse eid="ACT 10:38" /><verse number="39" style="v" sid="ACT 10:39" />आर आले दो ओनाको सानामाक्‌रेन गोहाको कानाले, ओकाकोय का़मिलेत् जिहुदिकोवाक् दिसा़मरे हों आर जेरुसालेमरे हों; ओने उनि दो गोच् होंको गोच्‌लेदे, कुरुसरे आकाकाते। <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />उनिगे इसोर दो पे माँहाँ हिलोक्‌रेये जिवेत् बेरेत्‌ केदेया आर सोदोरोक् रेयाक्‌ए दानादेया, <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />सानाम होड़को ठेन दो बाङा, मेनखान इसोर होतेते लाहा खोन बाछाव निट आकात्‌को गोहाको ठेन, मेताक् मे, आले ठेनगे, ओने उनि गोच्‌को खोने जिवेत् बेरेत्एन तायोम उनि तुलुच् जोम आरले ञुलेत्। <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />आरे हुकुमात्‌लेया दिसा़म होड़को पोरचाराको आर गोहा एमाको ला़गित्‌, बाङमा उनि कानगेयाय इसोरे निट आकादे, जिवेत् आर गोच्‌कोरेन बिक्‌चा़रिच् दो। <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />उनि रेयाङगे जोतो ना़बिको गोहाको एमेदा, उनिरे पा़तिया़उक् मित्‌के मित् होड़ दो उनियाक् ञुतुमते का़इ इका़को ञामा मेनते।<verse eid="ACT 10:43" /></para>
  <para style="s">जिहुदि बाहरेरेनको सोनोत जिउको ञामकेदे</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />पातरास ओनाको काथाय रोरोड़कान ताहेंकान तुलुच्‌गे काथा आँजोमकानको सानामकोरे सोनोत जिवे फेडेना। <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />आर खातना आकान पा़तिया़उको मोदरे तिना़क् पातरास साँवतेको हेच् आकान ताहेंकानको दोको ठाकएना, जिहुदि बाहरेरेन को हों सोनोत जिउ रेयाक्‌ दान दुल ओडोकएन इया़ते। <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />एनते एटाक्‌ पा़रसिकोते रोरोड़ कान ओनको दो इसोर सारहावेकानको आँजोमकेत्‌कोवा। आदो पातरासे मेनकेदा, <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />नोको, ओकोय आबो लेका सोनोत जिउको ञामआकादे, आलोको बा़प्‌तिसोक्आ मेनते जाहाँय होड़ दाक्ए आकोट दाड़ेकेया? <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />आदोए हुकुमकेदा जेमोन जिसु मा़सि ञुतुमतेको बा़प्‌तिसोक्। खान ओनको दो थोड़ा दिने ताहें ञोगोक्‌आ मेनतेको नेहोंरादेया।<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s">पातरास जेरुसालेमरेये रोड़ दोगोक्‌कान</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />आर आपोसतोलको आर जिहुदा़रे ओनते नोतेको ताहेंकान बोयहाकोको आँजोमकेदा बाङमा जिहुदि बाहरेरेनको हों इसोराक् काथाको आताङाकादा। <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />आर पातरास जेरुसालेमतेये हेच्एन खान खातनारेनको दो उनि तुलुच्‌को रोपोड़ेना, <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />मेनकेदाको आम दो बिन खातना होड़ ठेनेम बोलो ओडोकआकाना आर ओनको तुलुच्एम जोमेदा। <verse eid="ACT 11:3" /><verse number="4" style="v" sid="ACT 11:4" />मेनखान पातरास दो ओड़े ओड़ ला़इ बुजहा़वाको एहोप्‌केत्‌तेये मेनकेदा।<verse eid="ACT 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 11:5" />इञ दो जोप्‌पा नागराहारेञ कोयजोङकान ताहेंकाना, आर दोरसोन दोसारे पाड़ावेनतेञ ञेल केदेया मित्‌टेच् जिनिस फेड हिजुक्‌कान मित्‌टेच् ला़टु पिछा़उड़ि लेकानाक् पोनोन कोंडते तोलआकान सेरमा खोन फेड ओचोक्, आर ओना दो इञ ठेन हा़बिच् सेटेरेना। <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />आर ओना सेच् बेङगेत्‌ उरिच्‌कातेञ आ़रिबा़न्‌धियेत्‌ ताहेंकाना। आर ओतरेन पोन जाङगावानको आर बिर जानवारको आर लेञोक्‌को आर चोटरेन उडा़उक्‌ चेंड़ेंकोञ ञेलकेत्‌कोवा। <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />आर मित्‌टेच् आड़ाङ हों मेता़ञकान इञ आँजोमकेदा, “मा बेरेत्‌मे पातरास गोच्‌काते जोमकोम।” <verse eid="ACT 11:7" /><verse number="8" style="v" sid="ACT 11:8" />मेनखान इञ दोञ मेनकेदा, “ओहोगे प्रोभु, एनते जाहान छुताक्‌ से बेसाफावाक् दो तिस हों इञाक् मोचारे बाङ बोलोआकाना।” <verse eid="ACT 11:8" /><verse number="9" style="v" sid="ACT 11:9" />आदो सेरमा खोन दोसार छोट मित्‌टेच् आड़ाङे रोड़ रुवा़ड़केदा “ओकाको इसोरे साफाआकात्, ओनाको आम दो छुताक्‌ आलोम मेताक्आ।” <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />आर ओनका दो पे छोट होयेना आदो सानामाक् सेरमाते राकाप् रुवा़ड़ेना। <verse eid="ACT 11:10" /><verse number="11" style="v" sid="ACT 11:11" />आर ञेलपे इना घा़ड़िच्‌तेगे पे होड़ आलेले ताहेंकान ओड़ाक् ठेनको तेङगोयेना, ओने ओनको दो का़इसा़रिया़ खोन इञ ठेनको कोल ओचोवाकान ताहेंकान। <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />आर जिउ दो जोप्‌पा खोन का़इसा़रिया़ते ओनको तुलुच् चालाक्ए मेतादिञा, आर बेगोर जाहान दिगधा़क्‌ते। आर इञ तुलुच् दो नोको तुरुइ बोयहा होंको सेनेना, आर उनि होड़ाक् ओड़ाक्‌तेले बोलोयेना। <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />आदो उनिये ला़इयात्‌लेया, चेत् लेका उनि दो दुते ञेललेदे, आच् ओड़ाक्‌रे तेङगोवाकान, आरे मेतायकान, बाङमा जोप्‌पाते होड़ कोलकोम आर पातरासको मेताय सिमोन होहो आ़गु ओचोयेम; <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />उनिगे काथाकोय ला़इयामा, ओने ओकाकोतेम बाञचावक्, आम आर आम घारोंजरेनको जोतोकोगे। <verse eid="ACT 11:14" /><verse number="15" style="v" sid="ACT 11:15" />आर गालमाराव इञ एहोप्‌केत् खानगे सोनोत जिउ दो ओनकोरेये फेडेना, चेत्‌लेका एतोहोप्‌रे आलेरेहों। <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />आर प्रोभुवाक् काथाञ दिसा़केदा एनकाथाय, “जोहान मा दाक्‌तेये बा़प्‌तिसलेत्‌को, मेनखान आपे दो सोनोत जिउतेपे बा़प्‌तिस ओचोक्आ।” <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />ओनाते इसोर इना़ मित् दानगे ओनकोय एमात्‌को खान, चेत् लेका प्रोभु जिसु मा़सिरे बोन पा़तिया़वेनरे आबो होंए एमात्‌ बोन, एनडेखान इञ दो चेलेञ ताहेंकानते इसोर इञ आकोट दाड़ेकेया? <verse eid="ACT 11:17" /><verse number="18" style="v" sid="ACT 11:18" />आदो ओनाकोको आँजोमकेत् खानको हापेयेना, आर इसोर सारहावकेदेतेको मेनकेदा, “जिहुदि बाहरेरेनको हों एनडेखान इसोर दो जियोन ला़गित्‌ मोन आ़चुरे एमआकावात्‌कोवा।”<verse eid="ACT 11:18" /></para>
  <para style="s">आनटिओखिया़रे का़लिसिया़</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />आदो इस्टिफान बाबोत होयेन सानताव इया़ते छिञछा़तुरेनको दो फोयनिकि, आर कुपरोस आनटिओखिया़ हा़बिच्‌को सेन इदियेना, आर आको हों काथा दो बाको ला़इयात्‌कोवा, जिहुदिको छाडा। <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />मेनखान ओनको मोदरेन आदोमको दो कुपरोस आर कुरेनिरेन होड़को ताहेंकाना, ओने ओनको आनटिओखिया़तेको सेटेरेन खान जुना़निको होंको गालमारावात्‌को, आर प्रोभु जिसु रेयाक्‌ भागे सोमबातको पोरचारात्‌कोवा। <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />आर प्रोभुवाक् ति दो ओनको साँवते ताहेंकाना, आर लेखारे दो आयमा होड़गे पा़तिया़वेनते प्रोभु सेच्‌को आ़चुरेना।<verse eid="ACT 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22" />आर ओनको रेयाङ काथा दो जेरुसालेमरे ताहेंकान का़लिसिया़रेनकोको आँजोमकेदा आर ओनको दो बारनाबासको कोल केदेया आनटिओखिया़ते। <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />आर उनि दो ओंडे सेटेरकाते इसोराक् भोर ञेलकेत्‌तेये रा़सका़येना, आर सानामकोय उसकुरकेत्‌कोवा, जेमोन मोने मुरुककाते प्रोभुरे जामाड़ाकानको ताहेन, <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />एनते उनि दो भागे होड़े ताहेंकाना, सोनोत जिउ आर बिसवा़सते पेरेच्आकान आर आ़डि गादेल होड़ प्रोभु ठेनको आ़गु जुटुच्एना।<verse eid="ACT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />आर उनि दो ता़रसुसतेये चालावेना सा़उल ञामे ला़गित्‌ <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />आर ञामकेदेते आनटिओखिया़तेये आ़गु केदेया। आदो गोटा सेरमागे उनकिन दो का़लिसिया़रेनको सोङगेकिन ताहेंयेना, आर ढेर होड़किन चेत्आत्‌कोवा, आर आनटिओखिया़रे चेलाकोको दो पा़हिल धाव क्रिसतानको ञुतुमेना।<verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />आर ओनाको दिनरे ना़बि होड़को दो जेरुसालेम खोन आनटिओखिया़तेको हेच्एना। <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />आर ओनको मोदरेन आगाबुस ञुतुमान मित् होड़े तेङगोयेना, आर जिउ होतेतेये ला़इ लाहाकेदा, गोटा धा़रतिरे माराङ आकाल होयोक् ला़गिदोक्‌ काना मेनते, ओने ओना दो कलोउडियोस ओकतेरे होयेन। <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />खानगे चेलाको दो मिमित् होड़ आकोवाक्‌ दाडे़ लेका जिहुदा़रे ताहेन बोयहा मिसराको गोड़ों ला़गित्‌ दान कोलको निटकेदा, <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />ओने ओनका होंको ओनकाकेत् बारनाबास आर सा़उल तिते मुरुबिको ठेनको कोलकेत्‌।<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s">आपोसतोलको चेतानरे सानताव</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />ओना जोखेच्‌गे हेरोद राज दो का़लिसिया़रेनको आदोम आदोमको सानताव ला़गित्‌ हाते लागावकेदा <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />जोहानरेन बोयहा जाकोब दो तारवाड़ितेये माक्‌गोच् केदेया। <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />आर ओनाते जिहुदिकोको कुसियेने ञेलकेत् खान पातरास होंए साप् जुटुच्‌केदेया, खान बिन ता़ड़ियानाक् पिठा़ पोरोब दिनकोगे ताहेंकाना। <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />आर उनिये साप्‌केदे खान हाजोतरेये दोहोकेदेया, आर पोपोन होड़काते पा़रि पा़रिते होरहोये ला़गित्‌ पालटोनकोय सोपरोतात्‌कोवा आर सेन पारोम पोरोब तायोम दिसा़म होड़को सामाङरे ओडोक आ़गुइये मेनजोङकान ताहेंकाना। <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />ओनाते पातरास दो हाजोतरेये होरहो ओचोक्‌कान ताहेंकाना; मेनखान का़लिसिया़रेनको दो उनि ला़गित्‌ इसोर ठेन दिला़मुंडतेको कोयजोङकान ताहेंकाना।<verse eid="ACT 12:5" /></para>
  <para style="s">पातरास का़द खोने छोडावेन</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />आर हेरोद उनि ओडोक आ़गुइये ला़गिदोक्‌कान ताहेंकानरे इना़ ञिंदा़गे पातरास दो बारया पालटोन तालारे, बारया सिकड़िते तोलआकाने जा़पित् आकात् ताहेंकाना, पाहराकिन दो दुवा़रा ठेन का़द ओड़ाक् किन होरहोकान ताहेंकाना <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />खानगे ञेलपे, प्रोभुरेन मित्‌टेन दुत दो उनि ठेने तेङगो गोत्एना, आर ओना कांदहारे मारसाल बामबेरेना, आर कोखारे पातरास चेटाक्‌केदेतेये एबहेनकेदेया, आरे मेतादेया मा बेरेत् होदोक्‌मे आर सिकड़िकिन दो उनियाक् ति खोन ञुर गोत्एना, <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />आदो दुत उनिये मेतादेया, “मा पाठे केटेजोक्‌मे आर खारपा होरोगताम” आदोए ओनकाकेदा, खाने मेतादेया, “किचरिच् ओयोयताम आर पाँजाञमे,” <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />आदो ओडोक इदिएनतेये पाँजा इदि केदेया, आर बाय बाडायलाक्आ, आर दुत होतेते होयोक् कानाक् दो सा़रि काना मेनते, हुदिसेत् ताहेंकाना, दोरसोनगेये ञेलेत्‌काना मेनते। <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />आदो पा़हिल आर दोसार पाहराकोकिन पारोमकेत्‌को खान नागराहाते सेनोक् मेंड़हेंत् फाटोक ठेनकिन सेटेरेना, आर ओना दो आच्‌तेगे उनकिन ला़गित्‌ झिच् गोत्‌एना, आर ओडोककाते मित्‌टेच् कुलहिकिन सेन पारोमेना, खानगे दुत दो साटमेनतेये बा़गि गोत्आदेया।<figure style="fig" alt="Chains embedded in prison wall" file="hk00204c.tif" size="col" copy="Horace Knowles ©" ref="12:7">जाहाल रेयाक्‌ भितरे बा़इसा़उ आकात् सिकड़िको</figure><verse eid="ACT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11" />आदो पातरास दिसा़ आ़चुरेनताय खाने मेनकेदा, नितोक् दो सा़रिगेञ बाडायकेदा, प्रोभु दो आच्‌रेन दुत कोलकाते हेरोद ति खोन आर जिहुदि होड़कोको ञेल होहोरकान सानामाक् खोने रुखिया़ बाञचावकेदेञा<verse eid="ACT 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12" />आदोए बुजहा़उ ओरोमकेत् खान मा़रकुसको मेताय जोहानरेन एङगात मा़रिया़म ओड़ाक्‌तेये चालावेना ओने, ओकारे आयमा होड़को जारवा आकान आरको कोयजोङकान ताहेंकान। <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />आर दुवा़र रेयाक्‌ सिलपिञे ठोप् ठोप्‌केत् खान रोदा ञुतुमान मित्‌टेन का़ड़मि कुड़ि आक्‌तेने हेच्एना। <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />आर पातरास रेयाक्‌ आड़ाङे ओरोमकेत् खान रा़सका़ते सिलपिञ दो बाय झिच् लाक्आ बिचकोम ञिर बोलोयेनतेये ला़इयात्‌कोवा, “पातरास दो दुवा़र ठेने तेङगोवाकाना मेनते” <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />ओनको दो उनिको मेतादेया, “कुङकिआकानाम।” मेनखान उनि दो तिरित्‌लेकाय मेनकेदा, “ओनका कानगेया मेनते। खानगेको मेनकेदा, तोबे उनिरेन दुत कानाय।”<verse eid="ACT 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16" />मेनखान पातरास दो ठोप् ठोप्‌तेगेये ताहेंयेना। आदोको झिच्‌केत् खानको ञेल केदेया आरको ठाक एना। <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />खान हापे ओचोको ला़गित्‌ तितेये इसा़रावात्‌कोवा आरे ला़इयात्‌कोवा चेत् लेका प्रोभु दो हाजोत खोने ओडोक आ़गु केदेया। आरे मेनकेदा, “नोवाको काथा दो जाकोब ला़इयायपे, आर बोयहाको हों” खान ओडोक चालावेनते मित्‌टेच् एटाक् जायगातेये चालावेना।<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />आदो सिञ मारसालेन खान पालटोनको दो आको तालारे आ़डि आँटको आँदमांदाव चाबायेना, पातरास दोए ओकायना मेनते।<verse eid="ACT 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 12:19" />आर हेरोद दो उनि सेंदरा बाड़ाकेदे खान बाय ञामलेदेते पाहराकोय कुलिकेत्‌कोवा, आर गोच्‌को ला़गित्‌ इदिकोवा मेनतेये हुकुमकेदा। आदो जिहुदा़ खोन का़इसा़रिया़ते सेनकाते ओंडेगेये ताहेंयेना।<verse eid="ACT 12:19" /></para>
  <para style="s">हेरोदाक् गुजुक्</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />उनि दो टुर आर सिदोनरेनको आ़डिये एदरेआकोकान ताहेंकाना, खान ओनको रिया़उ मित्‌काते उनि ठेनको हेच्एना आर राजाक् गितिच्‌ कांदहारेन सोरदार बालासतुसको रा़मजा़उकेदेते सुलुकोक् ला़गित्‌को कोयकेदा, एनते आको दिसा़मरेनको दो राज रेयाक्‌ खोनगे आ़सुलोक्आक्‌को ञामेत्‌ ताहेंकाना<verse eid="ACT 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21" />आदो नेनडा दिनरे हेरोद दो राज किचरिच् होरोक्‌काते सिङघा़सोनरेये दुड़ुप्‌ एना आरे गालमारावात्‌कोवा। <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />आर होड़को दो होहोवातेको मेनकेदा, “नोवा दो इसोराक् आड़ाङकाना, मानवा रेयाङ दो बाङ।” <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />खान इना़ ओकतेरेगे प्रोभुरेन मित्‌टेन दुत दो उनिये घा़ल भिनदा़ड़केदेया, इसोर साबासि बाय एमादे इया़ते, आरको तेजोकेदेते जिवि चालावेनताया।<verse eid="ACT 12:23" /></para>
  <para style="pi">
    <verse number="24" style="v" sid="ACT 12:24" />मेनखान इसोराक् काथा दो पासनाव आर बाड़हाव इदियेना।<verse eid="ACT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25" />आर बारनाबास आर सा़उल दो जेरुसालेम खोनकिन रुवा़ड़ेना, साप्‌दाप् का़मिकिन पुरा़उकेत् खान, आर मा़रकुसको मेताय जोहानकिन आ़गुदाराकेदेया।<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s">सा़उल आर बारनाबासकिन कोल ओचोयेन</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />आर आनटिओखिया़रे ताहेंकान का़लिसिया़रे दो ना़बिको आर चेचेत्‌कोको ताहेंकाना, बारनाबास आर निगेरको मेताय सिमियोन, आर कुरेनिरेन लुकियोस, आर हेरोद साँवतेये आ़सुल हारालेन मानाहेन आर सा़उल। <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />आर प्रोभुको सेवावायकान आरको उपा़सआकात् ताहेंकानरे सोनोत जिवे मेनकेदा, “बारनाबास आर सा़उल बेगार ओडोकआ़ञपे, ओना का़मि ला़गित्‌ ओकाटाक् मेनतेञ होहो आकावात्‌किन।”<verse eid="ACT 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 13:3" />खानगे ओनको दो उपा़स आर कोयकाते आर चापोकेत्‌किनतेको बिदा़ गोत्‌कात्‌किना,<verse eid="ACT 13:3" /></para>
  <para style="s">कुपरोसरे</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />आर उनकिन दो सोनोत जिउ होतेते कोल ओचोयेनते सिलुकिया़तेकिन सेनएना, आर ओंडे खोन दो जाहाजते कुपरोस टा़पुतेकिन चालावेना। <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />आर सालामिसरे सेटेरकाते जिहुदिकोवाक् सुना़गोगकोरे इसोराक् काथाकिन पोरचारकेदा, आर जोहान मा़रकुस हों उनकिनरेन गोक्‌ड़ोयिच्ए ताहेंकाना।<figure style="fig" alt="Front view of a synagogue" file="lb00246c.tif" size="col" copy="Horace Knowles ©" ref="13:5">सामाङ सेच खोन ञेलोक् रे सुना़गोग </figure><verse eid="ACT 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6" />आदो गोटा टा़पु पाफोस हा़बिच् किन सेन पारोमएन खान मित्‌टेन गुनिदार, एड़े ना़बि जिहुदि होड़किन ञाम केदेया, ओने उनियाक् ञुतुम दो बारजिसु। <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />उनि दो सेरगियोस पा़उलुस, दिसा़म चाक्‌लाविच् मित्‌टेन बुजहा़नतार होड़ ठेने ताहेंकाना। नुय दो बारनाबास आर सा़उल होहो आ़गु ओचोकेत्‌किनते इसोराक् काथा आँजोमे खोजकेदा। <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />मेनखान एलुमा़स गुनिदार (एनते ओना काना उनियाक् ञुतुम दो तोरजोमाते) उनकिने ता़किच्‌ दारामकेत् किना, दिसा़म चाक्‌लाविच् बिसवा़स खोन भाङटावेये मेनवानते। <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />मेनखान सा़उल दो ओने उनि पावल होंको मेताय, सोनोत जिउतेये पेरेच्एनते उनिये बेङगेत् उरिच्आदेया। <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />आरे मेनकेदा, “एया आम जोतो फा़सिया़रा आर फोरफुनदिते पेरेच् आकानिच्, सायतानरेन होपोन, जोतो भा़क्‌ला़याक्‌ रेन बा़इरि प्रोभुवाक् सोजहे होरको कोंडयाय दो बाम बा़गिया?”<verse eid="ACT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 13:11" />“नितोक् दो ञेलमे प्रोभुवाक् ति दो आमरे पाड़ावक्आ आरेम काँड़ाँक्आ थोड़ा दिन सिञ चाँदो बाम ञेल दाड़ेयाया।” आर उनिरे दो ञुत हेच्‌ पाड़ावादेया आर हानते नाते टा़मडा़उ बाड़ाये एहोप्‌ एना, जेमोन जाहाँय उनियाक्‌ ति साप्‌कातेको इदिये। <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />खान दिसा़म चाक्‌लाविच् दो ओना होयेनाक् ञेलकातेये पा़तिया़वेना, प्रोभुवाक् सिकना़ततेये भाड़ोयेना।<verse eid="ACT 13:12" /></para>
  <para style="s">पिसिदिया़ रेयाक्‌ आनटिओखिया़रे</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />आदो पाफोस खोन जाहाज लाड़ावकेत्‌ते पावलतेको दो पामफिलिया़ रेयाक्‌ पेरगातेको सेटेरेना, मेनखान जोहान मा़रकुस दो उनकिन खोन बेगारेनते जेरुसालेमतेये रुवा़ड़ेना। <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />आर उनकिन दो पेरगा खोन सेन इदियेनते पिसिदिया़ रेयाक्‌ आनटिओखिया़तेकिन सेटेरेना, आर जिरा़उक् माँहाँ हिलोक् सुना़गोगरे बोलोयेनतेकिन दुड़ुप्‌ एना। <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />आदो आ़न आर ना़बिको रेयाक्‌ पाड़हावेन तायोम सुना़गोगरेन मुखिया़को दो काथा कोलात्‌किनतेको मेनकेदा, “ए बोयहाकिन, होड़को ला़गित्‌ जाहान सिखा़उ पाड़हाव काथा मेनाक्‌ताबेन खान मा रोड़बेन।”<verse eid="ACT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16" />खानगे पावल दोए तेङगोयेना आर तिते इसा़राकेत्‌तेये मेनकेदा, ए आपे इसराएल होड़को आर इसोर बोतोरायकानको आँजोमपे। <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />नोवा इसराएल जा़तरेन इसोर दो आबोरेन हापड़ामकोय बाछावकेत्‌कोताबोना, आर मिसोर दिसा़मरे उपरिया़को ताहेंकानरेगे उनि दोए माराङकेत्‌कोवा आर दाड़ेयान तिते ओंडे खोने ओडोक आ़गुकेत्‌कोवा। <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />आर पोनगेल सेरमा दिन गान हाहाङकाररेये आ़सुललेत्‌को ताहेंकाना। <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />आर कानान दिसा़मरे एयाय जा़तरेनकोय मारावकेत्‌कोते ओनकोवाक् दिसा़मे आ़इदा़रि ओचोवात्‌कोवा।<verse eid="ACT 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 13:20" />आर ओनाकाते पोन साय मोंड़ेंगेल सेरमा गान बिक्‌चा़रकोय एमात्‌कोवा। सामुएल ना़बि हा़बिच्‌। <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />आर इना़काते मित्‌टेन राजको कोयाना, आर इसोर दो किस होपोन सा़उल, बेनजामिन खुँटरेन मित् होड़े एमात्‌कोवा, पोनगेल सेरमा हा़बिच्‌। <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />आर उनिये ओचोक्‌केदे खान ओनकोरेन राज मेनकाते दा़उदे तेङगोकेदेया, ओने ओकोय रेयाक्‌ गोहा होंए एमकेत्, एनकाथाय जा़सा़य होपोन दा़उद इञ ञाम आकादेया, इञाक् मोने लेकान मित्‌टेन होड़, ओने उनि दो इञाक् सानाम मोनेजोङाक्ए पुरा़उ। <verse eid="ACT 13:22" /><verse number="23" style="v" sid="ACT 13:23" />नुय बोंसरेनगे, इसोर दो गोक्‌आक्‌ लेका इसराएलको मित्‌टेन बाबाञचाविच्ए आ़गुवात्‌कोवा, मेताक्‌मे जिसुगे। <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />आर जोहान दो उनिये हिजुक् लाहारे सानाम इसराएलको मोन आ़चुर रेयाक्‌ बा़प्‌तिसमाय पोरचार माड़ाङात्‌कोवा। <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />जोहान दो आयाक्‌ का़क्‌मिए पुरा़उ ला़गिदोक्‌कान ताहेंकानरेये मेनकेदा, ओकोय का़ना़ञ मेनतेपे बादेञकाना? इञ दो उनि दोञ बाङ काना, मेनखान ञेलपे, इञ तायोमते मित्‌टेने हिजुक्‌काना, ओने उनियाक्‌ जाङगा रेयाक्‌ खारपा तोनोल राड़ायताय लेक होंञ बाङकान।<verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />ए बोयहा मिसराको, आबराहामरेन बोंसको आर आपे मोदरेन इसोर बोतोरायकानको आबो ठेनगे नोवा बाञचावक् रेयाक्‌ काथा दो कोल आकाना। <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />एनते जेरुसालेमरे ताहेनको आर ओनकोरेन मुखिया़को दो उनि बाको बाडाय ओरोमलेदेते, आर ना़बिकोवाक्‌ आड़ाङ हों बाङ, ओने जिरा़उक् माँहाँ पिछे पाड़हावक्‌कान उनिको बिचा़र दुसिकेदेते ओनाको पुरा़उकेदा। <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />आर गोच्‌ओचोक् जाहान दोस बाको ञामलेत्‌तायरे हों, पिला़त ठेनको खोजकेदा जेमोने गोच्‌ओचोक्। <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />आर उनि रेयाङ ओल आकानाक्‌ जोतोवाक्‌को पुरा़उकेत् खान, कुरुस खोन फेडकेदेते कोबोररेको बायकेदेया। <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />मेनखान इसोर दो गोच्‌को खोन उनिये जिवेत् बेरेत्‌ केदेया। <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />आर ढेर दिन ओनको ठेने ञेल ओचोयेना, ओने ओनको गा़लिल खोन जेरुसालेमते उनि साँवतेको सेनआकान ताहेंकान, ओने ओनको नित उनिरेन गोहाको कानको दिसा़म होड़को ठेन। <verse eid="ACT 13:31" /><verse number="32" style="v" sid="ACT 13:32" />आर आ़लिञ दो हापड़ामको ठेन होयलेन गोक्‌आक्‌ रेयाक्‌ भागे सोमबातलिञ आ़गुवापे काना। <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />चेत् लेका इसोर दो आबोरेन गिदरा़कोय पुरा़उ उता़रआकावात्‌कोवा, जिसुये बेरेत्‌केदेते, चेत् लेका दोसाराक् सेरेञरे हों ओल आकाना,</para>
  <para style="q1" vid="ACT 13:33">“आम दो इञरेन होपोन कानाम,</para>
  <para style="q2" vid="ACT 13:33">इञगे तेहेञिञ जानामकेत्‌मेया।”</para>
  <para style="m" vid="ACT 13:33">
    <note caller="+" style="f">
      <char style="fr" closed="false">13:33 </char>
      <char style="ft" closed="false">सेरेञको २:७</char>
    </note> <verse eid="ACT 13:33" /><verse number="34" style="v" sid="ACT 13:34" />आर गोच्‌को खोन उनिये बेरेत्‌केदेते सेयाक् ला़गित्‌ आलोय रुवा़ड़ोक्आ मेनते, ओना रेयाङ दो नोनकाय मेन आकादा,</para>
  <para style="q1" vid="ACT 13:34">“इञ दो दा़उद रेयाक्‌ सोनोत भोरकोञ एमापेया,</para>
  <para style="q2" vid="ACT 13:34">ओना खा़टियाक्‌कोगे।”<verse eid="ACT 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 13:35" />ओनाते एटाक् सेरेञरे होंए मेनेदा,</para>
  <para style="q1" vid="ACT 13:35">“आमरेन सोनोतिच् दो बाम सेया ओचोयेया।”<verse eid="ACT 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 13:36" />एनते दा़उद मा आपनार पिड़हिरे इसोराक् मोने लेका गुतिये खाटावेन खाने जा़पित्‌केत्, आर आच्‌रेन हापड़ामको ठेने बाय ओचोयेन, आरे सेयायेन। <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />मेनखान इसोरे बेरेत्‌केदेयिच् दो बाय सेयालेना।<verse eid="ACT 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 13:38" />आदो ए बोयहा मिसराको, नोवा बाडायजोङपे, जिसु होतेतेगे का़इको रेयाक्‌ इका़क् दो आपे ठेन जा़हिरोक्‌काना, <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />आर उनिरेगे मित्‌के मित् पा़तिया़उक्‌को सानामाक्‌को खोनको सा़रि ओचोक्‌काना, ओने ओकाको खोन मोसे रेयाक्‌ आ़नते बापे धोरोम ओचो दाड़ेलेन। <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />ओना इया़ते चेहावक्‌पे, जेमोन ना़बिकोवाक्‌कोरे रोड़ाकान काथा आलो पाड़ावापे।<verse eid="ACT 13:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41" />“ञेलपे, ए आपे निक्‌हा़ँतको, आर भाड़ोक्‌पे,</para>
  <para style="q2" vid="ACT 13:41">आर मोहोर मेटावक्‌पे,</para>
  <para style="q1" vid="ACT 13:41">एनते आपे बिदा़लरे मित्‌टेच्‌ का़मि इञ का़मियेदा,</para>
  <para style="q2" vid="ACT 13:41">मित्‌टेच का़मिगे, ओकाटाक् ओहोगेपे पा़तिया़उलेन, जाहाँये ला़इयापेरे हों।”<verse eid="ACT 13:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />आर उनकिन ओडोक चालाक्‌कान ताहेंकानरे ओनको दोको नेहोंरेना, जेमोन नोवाको काथा दो हिजुक्‌कान जिरा़उक् माँहाँरे होंकिन गालमारावाको। <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />आदो सुना़गोगरेनको भिड़ भाङगावेन खान आ़डि उता़र जिहुदिको आर जिहुदि बिसवा़सरे बोलोआकान इसोर भोकति होड़को पावल आर बारनाबासको पाँजाकेत् किना, आर उनकिन दो गालमारावात्‌कोतेकिन सिखा़उकेत्‌कोवा, दायारे जामाड़ आकान ताहेन ला़गित्‌।<verse eid="ACT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />आर दोसार जिरा़उक् माँहाँ हिलोक् दो गोटा नागराहारेन लेकागेको हेच् जारवायेना, इसोराक् काथा आँजोम ला़गित्‌। <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />मेनखान जिहुदिको दो गादेल होड़को ञेलकेत्‌को खान खिंसतेको पेरेच्एना, आर हेनोसतावाते पावले रोड़ेत् ताहेंकानाक्‌कोको रोड़ दारामकेदा। <verse eid="ACT 13:45" /><verse number="46" style="v" sid="ACT 13:46" />आर पावल आर बारनाबास दो सोहोसाते गालमारावात्‌कोतेकिन मेनकेदा, जा़रुड़ ताहेंकाना, इसोराक् काथा दो आपेगे ला़इ माड़ाङापे, मेनखान ओनापे पेसड़ावेत्‌ते, आर जायजुग जियोन ला़गित्‌ आपेतेगे लेक बापे बुजहा़उक्‌कानते, ञेलपे जिहुदि बाहरेरेनको सेच् लिञ आ़चुरोक् काना। <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />एनते ओनकागे प्रोभु दोए हुकुमाकावात् लेया, बाङमा।</para>
  <para style="pi" vid="ACT 13:47">जिहुदि बाहरेरेनको ला़गित्‌ मित्‌टेच् मारसाल इञ दोहोआकात्‌पेया, जेमोन बाबाञचाव ला़गित्‌एम होयोक् धा़रति मुचा़त् हा़बिच्।<verse eid="ACT 13:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />आदो जिहुदि बाहरेरेनको ओनाको आँजोमकेत् खानको रा़सका़येना, आर प्रोभुवाक् काथाको सारहावकेदा, आरको पा़तिया़वेना, जायजुग जियोन ला़गित्‌ तिना़क् निट आकानको ताहेंकानको, <verse eid="ACT 13:48" /><verse number="49" style="v" sid="ACT 13:49" />आर प्रोभुवाक् काथा दो ओना गोटा टोठारे पासनाव इदियेना। <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />मेनखान जिहुदिको दो नापड़ाक् हुदा़रेन आदोम इसोर भोकति मायजिउको आर नागराहारेन पोरधानकोको उदगा़उकेत्‌कोवा, आर पावल आर बारनाबास उपा़रते खेदको उठा़उकेदा, आर आकोवाक् सिमा़ खोनको लागा ओडोककेत् किना। <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />खान उनकिन दो ओनको उपा़रते आ़किनाक् जाङगा धुड़ि कोटा ओटोकाते इकोनियोमतेकिन चालावेना। <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />आर चेलाको दो रा़सका़ आर सोनोत जिउतेको पेरेच्एना।<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s">इकोनियम रे</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />आर इकोनियोमरे उनकिन दो मित्‌तेगे जिहुदिकोवाक् सुना़गोगतेकिन बोलोयेना आर ओनकोकिन गालमारावात्‌कोवा, ओनाते जिहुदिको आर जिहुदि बाहरेरेनको खोन आ़डि उता़र होड़को पा़तिया़वेना। <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />मेनखान ओनको बेपा़तिया़उक्‌ जिहुदिको दो जिहुदि बाहरेरेनकोवाक् मोनको उसकुर आरको बा़ड़िच्‌केत्‌ताकोवा, बोयहाको बिरुदरे। <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />आदो पावल आर बारनाबास ढेर ञोक् दिन ओंडे किन ताहेंयेना, प्रोभुरे सोहोसाते रोरोड़तेगे, ओने उनि आच्‌ भोर ञामआकात्‌ रेयाक्‌ काथाय गोहावाक्‌कान ताहेंकान उनकिन तिते चिनहा़को आर हाहाड़ावाक्‌कोय होय ओचोकेत्‌ते। <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />मेनखान नागराहारेन गादेल होड़ दोको बार दोलेना, आदोम दो जिहुदिको सेच्‌को ताहेंकाना, आर आदोमको दो आपोसतोलकिन सेच्। <verse eid="ACT 14:4" /><verse number="5" style="v" sid="ACT 14:5" />आदो जिहुदि बाहरेरेनको आर जिहुदिको हों आकोरेन मुखिया़को लागायते उनकिन बेमानोत आर तिञकिन ला़गित्‌को गोटा केदा। <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />आर ओनाकिन बाडाय ञामकेत् खान लुका़उनिया़ रेयाक्‌ नागराहा लुसतरा़ आर डेरबे ओनाकिन बेड़हाय तेयाक् टोठातेकिन दा़ड़केदा। <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />आर ओंडे भागे सोमबातकिन पोरचार केदा।<verse eid="ACT 14:7" /></para>
  <para style="s">लुसतरा़ आर डेरबेरे का़मि</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />आर लुसतरा़रे जाङगा बाङ मुरुकोक्‌ताय मित् होड़े दुड़ुप्‌ आकान ताहेंकाना एङगात कुखि खोन लेडहायिच्‌गे ओने ओकोय तिस हों बाय दाँड़ाँ बाड़ावाकात् ताहेंकाना। <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />उनि दो पावल गालमाक्‌रावकाने आँजोम केदेया, आर नुय दो उनि बेङगेत् उरिच्‌ आदेते आर बोगे ओचोक् ला़गित्‌ बिसवा़स मेनाक्‌ताया मेनतेये ञेलकेत्‌ते, <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />आँट आड़ाङतेये मेनकेदा, “आमाक् जाङगाते सोजहे तेङगोनमे।” खानगे उनि दो दोन बेरेत्एनतेये दाँड़ाँ बाड़ाकेदा। <verse eid="ACT 14:10" /><verse number="11" style="v" sid="ACT 14:11" />आदो गादेल होड़ पावले का़मिकेत्आक्‌को ञेलकेत् खान होहोवाते लुका़उनिया़ पा़रसितेकिन मेनकेदा, “देबको दो मानवा छिनते आबो ठेनको फेड हेच् आकाना।” <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />आर बारनाबास दो जेयुसको ञुमकेदेया, आर पावल दो हेरमेस, उनिगे रोरोड़रे चोलोनतिये ताहेंकान इया़ते। <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />आर जेयुसरेन नायके दो ओने उनियाक् थान दो नागराहा सामाङ ठेन ताहेंकान डाङगराको आर गुतु बाहा मालाको फाटोक ठेन आ़गुकाते गादेल होड़को साँवतेये तेङगेन ला़गिदोक्‌कान ताहेंकाना।<verse eid="ACT 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14" />खान बारनाबास आर पावल आपोसतोलकिन ओनाकिन आँजोमकेत् खान आ़किनाक् किचरिच् ओड़ेच्‌केत्‌ते गादेल होड़को ठेनकिन ञिर जालात्‌एना, आर होहोवातेकिन मेनकेदा, <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />ए हो चेदाक्‌पे नोनकायेदा? आ़लिञ हों चोङ आपे लेका दुक सुक जोजोम मानवा कानगेलिञ, भागे सोमबातलिञ पोरचारापे काना, जेमोन नोवा आ़उड़ियाक्‌को खोन जिवेत् इसोर सेच् पे आ़चुरोक्, ओने उनि सेरमारे आर धा़रति, आर जालापुरि आर ओनाकोरे मेनाक् सानामाक्ए बेनाव आकात्‌।<note caller="+" style="x"><char style="xo" closed="false">14:15 </char><char style="xt" closed="false"><ref loc="EXO 20:11">एकसो २०:११</ref>; <ref loc="DEU 10:17">देउ १०:१७</ref>; <ref loc="PSA 146:6">सेरे १४६:६</ref></char></note> <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />ओने उनि चालावेन पिड़हिरेन सानाम होड़को आको आकोवाक् पा़तिया़उक्‌ रेयाक्‌ होरतेये सेन ओचोवात्‌को। <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />एनरेहों आच् दो बेगोर गोहाते दो बाय ताहेंहेच् आ़गुवाकाना, उनिये भा़ला़इ आ़क्‌गुकान सेरमा खोन जा़ड़िदाक् आर साँवाँय दिनकोय एम आ़गुवापे कान, जोमाक् आर रा़सका़ते आपेयाक् ओनतोरे पुरुनेत्‌तापेया। <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />आर नोवाको काथाते गादेल होड़ आलोको तेङगेनाकिना मेनते आ़डि कुरुमुटुकातेकिन आकोटकेत्‌कोवा।<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />मेनखान आनटिओखिया़ आर इकोनियोम खोन जिहुदि होड़ ओंडेको हेच्एना आर गादेल होड़को रा़मजा़उकेत्‌कोते पावल दो धिरितेको तिञकेदेया, आर नागराहा बाहरेतेको ओर गिडिकादेया, गोच्एनाय मेनतेको बुजहा़उकेत्‌ते। <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />मेनखान चेलाको उनिको तेङगो आ़चुराकादे ताहेंकानरे उनि दो बेरेत्एनते नागराहातेये बोलोयेना आर दोसार हिलोक् दो बारनाबास तुलुच् डेरबेतेये ओडोक चालावेना।<verse eid="ACT 14:20" /></para>
  <para style="s">सुरिया़ खोन आनटिओखिया़ते रुवा़ड़ोक्</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />आर डेरबे रे भागे सोमबात पोरचारकाते ढेरकिन चेलाकेत्‌को खान लुसतरा़, इकोनियोम आर आनटिओखिया़तेकिन रुवा़ड़ेना, <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />आर चेलाकोवाक्‌ मोनकिन दिड़होकेत्‌ताकोवा, आरकिन सिखा़उ पाड़हावकेत्‌कोवा, जेमोन बिसवा़सरे जामाड़ाकानको ताहेन, आर बाङमा आ़डि सानताव तालाते इसोराक् राजते बोलोक् होयोक्‌ताबोना। <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />आदो मिमित् का़लिसिया़रे ओनको ला़गित्‌ मुरुबिकोकिन बाछाव बाहालकेत्‌को खान, उपा़साते कोयकाते प्रोभु ठेनकिन जिमा़केत्‌कोवा, ओने उनिरेको पा़तिया़वाकान।<verse eid="ACT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24" />आर पिसिदिया़ तालाते पारोमकाते पामफिलिया़रेकिन सेटेरेना। <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />आर पेरगारे काथाकिन गालमारावात्‌को खान आतालिया़तेकिन चालावेना। <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />आर ओंडे खोन दो जाहाजते आनटिओखिया़तेकिन चालावेना, ओने ओका खोन इसोराक् दायातेकिन जिमा़ ओचोलेन ओना का़मि ला़गित्‌ ओकाटाक् नितकिन पुरा़उआकात्।<verse eid="ACT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 14:27" />आदो सेटेरकाते का़लिसिया़रेनको जारवाकेत्‌कोतेकिन ला़इयात्‌कोवा तिना़क् इसोर दो आ़किन तुलुच्‌ए का़मिआकात्, आर चेत् लेका जिहुदि बाहरेरेनको बिसवा़स रेयाक्‌ दुवा़रे झिच् आकावात्‌को। <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />आर चेलाको साँवते ढेर दिनकिन ताहेंयेना।<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s">जेरुसालेमरे दुपुड़ुप्‌</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />आर आदोम होड़ दो जिहुदा़ खोन आनटिओखिया़रे हेच्‌काते बिसवा़सिकोको चेत् आकोकान ताहेंकाना, बाङमा मोसेयाक् चा़लिलेका बापे खातना ओचोलेन खान, ओहोपे बाञचाव दाड़ेलेना।<note caller="+" style="x"><char style="xo" closed="false">15:1 </char><char style="xt" closed="false"><ref loc="LEV 12:3">लेबि १२:३</ref></char></note> <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />आदो पावल आर बारनाबास ओनको तुलुच्‌ आ़डि आपठा आ़पठि आरकिन तेखड़ा तेखड़ियेन खानको गोटाकेदा जेमोन पावल आर बारनाबास, आर आको मोदरेन आदोम एटाक्‌को नोवा रेटेपेटे काथा बाबोतरे आपोसतोलको आर मुरुबिको ठेन जेरुसालेमतेको चालाक्,<verse eid="ACT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3" />आदो का़लिसिया़रेनको होतेते इदि गोत् ओचोयेनते ओनको दो फोयनिकिया़ आर सा़मा़रिया़ तालाते होंको सेन पारोमेना, जिहुदि बाहरेरेनको मोनको आ़चुरकेत् रेयाक्‌को ला़इ इदिआत्‌कोते आर सानाम बिसवा़सिको आ़डिको रा़सका़ ओचोकेत्‌कोवा। <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />आर जेरुसालेमको सेटेरेन खान का़लिसिया़रेनको आर आपोसतोलको आर मुरुबिको दो ओनकोको आताङ दाराम केत्‌कोवा सानामाक् किन ला़इयात्‌कोवा, तिना़क् इसोर दो आ़किन तुलुच्ए का़मिआकात्‌आ। <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />मेनखान फा़रिसिकोवाक् सिकना़त दोलरेनको मोद खोन पा़तिया़वाकान आदोम आदोम होड़ दो तेङगोयेनतेको मेनकेदा, ओनको खातना ओचोक्‌को आर मोसे रेयाक्‌ आ़न दोक्‌हो हुकुमाको दो जा़रुड़गेया।<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />आर आपोसतोलको दो नोवा काथा रेयाक्‌ तोजबिजा मेनतेको जारवायेना <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />आर ढेर तेखड़ा तेखड़ि होयेन खान पातरास दो तेङगोयेनतेये मेताक्‌कोवा, ए बोयहा आर मिसराको आपेपे बाडायगेया, एहोप् दिनकोरे चेत् लेका इसोर दो आपेको ताला खोने बाछावाना, जेमोन इञाक् मोचाते जिहुदि बाहरेरेनको भागे सोमबात रेयाक्‌ काथाको आँजोम आरको पा़तिया़उक्।<note caller="+" style="x"><char style="xo" closed="false">15:7 </char><char style="xt" closed="false"><ref loc="ACT 10:1-43">आ का़ १०:१-४३</ref></char></note> <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />आर ओनतोर बाक्‌डायिच् इसोर दो ओनकोय गोहावात्‌कोवा सोनोत जिवे एमात्‌कोते आबोय एमात्‌बोन लेकागे।<note caller="+" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="ACT 2:4">आ का़ २:४</ref>; <ref loc="ACT 10:44">१०:४४</ref></char></note> <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />आर चेत् बेगार बाय दोहोलाक्‌आ आबोन आर ओनको तालारे बिसवा़स होतेते ओनकोवाक् मोने साफाकेत् ताकोते। <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />एनडेखान नितोक् दो चेत् इया़ते इसोरपे बिडा़उएदेया, चेलाकोवाक् तारेनरे मित्‌टेच् आराँड़पे लादे लेगायेत्‌ते ओने ओकाटाक् आबोरेन हापड़ामको हों आर आबो हों बाबोन गोक्‌ दाड़ेयात्? <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />बिचकोमबोन पा़तिया़उ आकाना, प्रोभु जिसुवाक् दायातेबोन बाञचावक्आ ओनको लेकागे।<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />खान गादेल होड़ सानामको थिर हापेयेना, आर बारनाबास आर पावल ला़ला़इकानको आँजोमकेत्‌किना, ओकाको चिनहा़ आर हाहाड़ावाक्‌को इसोर दो जिहुदि बाहरेरेनको तालारे आ़किन होतेये का़मिआकात् <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />आदो उनकिनकिन थिरेन खान जाकोब दो रोड़ रुवा़ड़केत्‌तेये मेनकेदा, ए बोयहा मिसराको आँजोम तिञपे। <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />सिमोने का़इकेदा, चेत् लेका इसोर दो पा़हिल खोन जिहुदि बाहरेरेनकोय बेङगेत्‌आत्‌को जेमोन ओनको मोद खोन आयाक्‌ ञुतुम ला़गित्‌ निज होड़े हातावजोङ। <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />आर नोवा तुलुच् ना़बिकोवाक् काथाको मिदुक्‌काना, ओलआकान लेका<verse eid="ACT 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16" />नोवाको तायोमतेञ आ़चुरोक्आ</para>
  <para style="q2" vid="ACT 15:16">आर दा़उद रेयाक्‌ ताहेनोक्‌आक्‌ इञ बेनाव रुवा़ड़ा,</para>
  <para style="q1" vid="ACT 15:16">ओने ओकाटाक् ला़ँदुड़ आकान, आर ओना रेयाक्‌ धाङधासेराक्‌कोञ बेनाव रुवा़ड़ा,</para>
  <para style="q2" vid="ACT 15:16">आर ओनाञ तेङगो रुवा़ड़ा।<note caller="+" style="x"><char style="xo" closed="false">15:16 </char><char style="xt" closed="false"><ref loc="AMO 9:11-12">आमो ९:११-१२</ref> </char></note><verse eid="ACT 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17" />जेमोन मानवाकोरेन सारेच्‌को दो प्रोभुको ञाम बाड़ाये,</para>
  <para style="q2" vid="ACT 15:17">हें सानाम जिहुदि बाहरेरेनकोगे ओने ओनकोरे इञाक् ञुतुम मेनाक्,<verse eid="ACT 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 15:18" />प्रोभुइ मेनेदा ओने उनि ओनाकोय का़मियेत्, जुग खोन बाडायाक्‌कोगे।<verse eid="ACT 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />ओना इया़ते इञाक् बिचा़र दो नोवाकाना जिहुदि बाहरेरेनको मोद खोन इसोर सेच् आ़चुरोक्‌को दो आलो बोन मुसकिलकोमा। <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />मेनखान बोन चिठियाकोमा, जेमोन मुरहुत् सेवाते भोंडोक् खोन, आर लोटघुटि खोन, आर लिमबा़त्‌ गोच्‌को रेयाक्‌ जेल खोन आर माँयाँम खोन साहाड़ाकानको ताहेन।<note caller="+" style="x"><char style="xo" closed="false">15:20 </char><char style="xt" closed="false"><ref loc="EXO 34:15-17">एकसो ३४:१५-१७</ref>; <ref loc="LEV 17:10-16">लेबि १७:१०-१६</ref>; <ref loc="LEV 18:6-23">१८:६-२३</ref> </char></note> <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />एनते मोसेयाक्‌ आ़न दो सेदाय खोनगे मिमित् नागराहारे पोपोरचारको मेनाक्‌कोताया, जिरा़उक् माँहाँ पिछे सुना़गोगकोरे पाड़हावक्‌ कानतायते।<verse eid="ACT 15:21" /></para>
  <para style="s">जिहुदि बाहरेरेन बिसवा़सिको ठेन चिठि</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />खानगे आपोसतोलको आर मुरुबिको दो गोटा का़लिसिया़रेनको साँवते बेसको मेतात्आ आको मोद खोन होड़ बाछावकाते, पावल आर बारनाबास साँवते आनटिओखिया़तेको कोलको ला़गित्‌। आर बारसाबासको मेताय जिहुदा़, आर सिलास बिसवा़सिको तालारे मुखिया़ होड़किनको बाछावकेत्‌किना। <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />आदो ओलकाते ओनको तितेको कोलकेदा,</para>
  <para style="pi" vid="ACT 15:23">आले आपोसतोलको आर मुरुबि बोयहाको आनटिओखिया़, आर सुरिया़ आर किलिकिया़रे मेनाक्‌पे जिहुदि बाहरेरेन होड़ खोन ओडोक हेच्एन बोयहा मिसराकोले जोहारापे काना। <verse eid="ACT 15:23" /><verse number="24" style="v" sid="ACT 15:24" />आलेले आँजोम आकादा, आले ठेन खोन ओडोक सेन आकान आदोम आदोम होड़ दो काथातेको हादोस आकात्‌पेया, आपेयाक् जिविको दुक ओचोवाकात्‌ तापेया, ओने ओनको आले दो बाले हुकुमाकावात्‌को, <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />ओना इया़ते आले दो मित् मोनोक्‌ते बेसले मेतात्आ जेमोन होड़ बाछावकाते आपे ठेनले कोलकिन, दुला़ड़िया़ बारनाबास आर पावल सोङगेते उनकिन होड़गे। <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />ओने ओकोय आबोरेन प्रोभु जिसु मा़सियाक् ञुतुमते जिविकिन आलाय आकात्‌ता़किन। <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />ओनाते जिहुदा़ आर सिलासले कोल आकात्‌किना, ओने उनकिन आ़किन हों मोचाते इना़कोगेकिन ला़इयापे, ओकाकोले ओल आकात्‌। <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />एनते सोनोत जिउ आर आले हों बेसले मेतात्आ जेमोन बा़ड़ति बोजहा चेत् हों आलोले लादेयापे, नोवाको जा़रुड़ाक् छाडा दो <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />बाङमा “बोङगा सामाङाक्‌को खोन आर माँयाँम खोन, आर लिमबा़त्‌ गोच्‌को रेयाक्‌ जेल खोन आर लोटघुटि खोन साहाड़ाकानपे ताहेन, ओनाको खोन सोनतोराकानपे ताहेन खान बेसगे होयोक्‌तापेया। नापाय ओकोच्‌ते ताहेनपे।”<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />आदोको बिदा़येन खान आनटिओखिया़तेको चालावेना, आर गादेल होड़को जारवाकेत्‌कोते ओना चिठिको एमात्‌कोवा। <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />आर ओनको दो ओना पाड़हावकेत्‌तेको रा़सका़येना जिवि राड़ेच्‌आक् ञुतुमते। <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />आर जिहुदा़ आर सिलास दो आ़किन हों ना़बिकिन ताहेंकानते, आ़डि ओकोच् काथाते बोयहाकोवाक् जिविकिन राड़ेच्‌केत् ताकोवा आरकिन दिड़होकेत्‌कोवा। <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />आदो तिन उडि दिन चोङ ताहेंकान सुलुकते बोयहाको ठेन खोनकिन बिदा़येना आ़किन कोललेत्‌किनको ठेन रुवा़ड़ ला़गित्‌। <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />मेनखान सिलास दो ओंडे ताहेन बेसे मेतात्आ।<verse eid="ACT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 15:35" />आर पावल आर बारनाबास दो आनटिओखिया़रेकिन ताहेंयेना, ढेर एटाक्‌को साँवते प्रोभुवाक् काथाकिन चेत्आकोवा आरकिन पोरचाराको कानगे।<verse eid="ACT 15:35" /></para>
  <para style="s">पावल आर बारनाबास तालारे बेगारोक्‌</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />आदो तिन दिन तायोमते चोङ पावल दो बारनाबासे मेतादेया, देलाङ रुवा़ड़ सेनकाते बिसवा़सिकोलाङ हिरिकोवा मिमित् नागराहारे, ओने ओकाकोरे प्रोभुवाक् काथालाङ जा़हिरलेत्, भाला चेत् लेका मेनाक्‌कोवा। <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />आर बारनाबास दोए मोने आकावान ताहेंकाना, मा़रकुसको मेताय जोहान इदि तोराये ला़गित्‌। <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />मेनखान पावल दो बेसे मेतात्आ उनि ओकोय पामफिलिया़रेये बा़गि ओटोवात्‌किन आर का़मि ला़गित्‌ आ़किन तुलुच्‌ बाय सेनलेन, उनि जेमोन आलोकिन इदि तोराये। <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />नोवा बाबोतरे उनकिन तालारे काथा बाङ जुरिलेनतेकिन बेगारेना, आर बारनाबास दो मा़रकुस इदि तोराकेदेते जाहाजते कुपरोसतेये चालावेना। <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />मेनखान पावल दो सिलास बाछावकेदेतेये ओडोक चालावेना, बिसवा़सिको प्रोभुवाक् दायारेगेको जिमा़केदेते। <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />आर सुरिया़ आर किलिकिया़ तालाते पारोम चालाव इदियेनते का़लिसिया़कोरेनकोय दिड़हो इदिकेत्‌कोवा।<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s">तिमोथि पावल आर सिलास तुलुच्‌ए चालाक्‌कान</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />आर डेरबे आर लुसतरा़ते होंए सेटेरेना, आर ञेलपे, ओंडे दो तिमोथि ञुतुमान मित्‌टेन चेलाए ताहेंकाना, मित्‌टेन पा़तिया़वाकान जिहुदि मायजिउरेन होपोनगे, मेनखान आपाततेत् दो जुना़नि होड़े ताहेंकाना। <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />उनि दो लुसतरा़ आर इकोनियोमरेन बोयहाको ठेन भागे ञुतुम ताहेंकानताया। <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />पावल दो उनि सोङगे इदि तोराये मेनवाना, आर उनि ञामकेदेतेये खातनाकेदेया, ओनाको टोठारेन जिहुदिको इया़ते एनते जोतोगेको बाडायकान ताहेंकाना उनि रेन आपात दो जुना़निये ताहेंकाना मेनते <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />आर नागराहा नागराहा सेन सेनते, ओनाको निटाक् दोहोय ला़गित्‌को जिमा़वात्‌कोवा, ओकाको जेरुसालेमरेन आपोसतोलको आर मुरुबिकोको गोटालेत्। <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />ओनाते का़लिसिया़रेनको दो बिसवा़सरेको केटेच्‌ इदियेना आर लेखारे दिना़मगेको साङगे इदियेना<verse eid="ACT 16:5" /></para>
  <para style="s">तरोआसरे पावलाक् दोरसोन</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />आदो फुरुगिया़ आर गालातिया़ टोठा तालातेको पारोम चालावेना, आ़सिया़रे इसोराक् काथा ला़ला़इ दो सोनोत जिउ होतेतेको माना ओचोयेनते। <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />आर मुसिया़ हा़बिच्‌को सेटेरेन खान बेथानिया़ते चालाक्‌को कुरुमुटु लेगाकेदा, मेनखान जिसुरेन जिउ दो बाय आड़ाक्आत्‌कोवा। <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />आदो मुसिया़ आड़े आड़ेते पारोमेनते तरोआसतेको फेड हेच्एना। <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />आर पावल दो ञिंदा़ मित्‌टेच् दोरसोने ञेलकेदा, मित्‌टेच् मा़किदुनिया़ होड़े तेङगोवाकान, आर नेहोंरायकानतेये मेनेत्, देला मा़किदुनिया़ते पारोम हिजुक्‌पे गोड़ोंवालेमे। <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />आदो ओना दोरसोने ञेलकेत् खान उसा़राते मा़किदुनिया़ते चालाक्‌ले आँटआना, बुजहा़उकेदाले भागे सोमबात पोरचाराको ला़गित्‌ इसोरे होहो आकावात्‌लेया मेनते।<verse eid="ACT 16:10" /></para>
  <para style="s">फिलिपि रे लुदिया़वाक् मोन आ़चुरोक्</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />आदो तरोआस खोन जाहाज लाड़ावकेत्‌ते मित् मोहंडा सामोथराकेतेले चालावेना, आर दोसार हिलोक् दो निया़पोलिसते, <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />आर ओंडे खोन दो फिलिपिते, ओने ओना दो मा़किदुनिया़रे ओना टोठा रेयाक्‌ आसोल नागराहा कान, रोम रेयाक्‌ मित्‌टेच् आतोगे। आर ओना नागराहारे तिन उडि दिन चोङले ताहेंयेना। <verse eid="ACT 16:12" /><verse number="13" style="v" sid="ACT 16:13" />आर जिरा़उक् माँहाँ हिलोक् दो फाटोक बाहरेते गाडा आड़ेतेले चालावेना, ओने ओकारे मित्‌टेच् कोयजोङ ठा़ँइ मेनाक्आ मेनतेले बुजहा़वेत् ताहेंकान आर दुड़ुप्‌काते हेच् जारवा आकान मायजिउकोले गालमारावात्‌कोवा। <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />आर लुदिया़ ञुतुमान मित्‌टेन मायजिउ दोए आँजोमकेत् तालेया। उनि दो थिया़टिरा़ नागराहारेन कुरसे बाहा रोङ किचरिच्‌ आ़खरिञेत्‌ आर इसोर सेवावायकान मित्‌टेन मायजिवे ताहेंकाना, उनियाक् मोन दो प्रोभुइ झिच्‌केत्‌ताया पावले रोड़ेत् ताहेंकानाक्‌को हेतावाक्आ मेनते। <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />आर उनि दो घारोंजरेनको सुदहा़इ बा़प्‌तिसेन खान नेहोंरात्‌लेतेये मेनकेदा, प्रोभुरे पा़तिया़उ आकानिच् पे बुजहा़उ आकादिञ खान देला इञाक् ओड़ाक्‌ते बोलोक्‌ते ओंडे बाड़े ताहेनताबोनपे। आरे जा़रिकेत्‌लेया।<verse eid="ACT 16:15" /></para>
  <para style="s">पावल आर सिलास हाजोतरे</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />आर नोनका होयेना, कोयजोङ ठा़ँइतेले चालाक्‌कान ताहेंकानरे बा़ड़िच् जिवे ताहेंकानताय मित्‌टेन का़ड़मिये ञापामकेत्‌लेया, ओने उनि भाबाते आच्‌रेन किसा़ँड़को आ़डि ओकोच्ए रोजगाराको कान ताहेंकान। <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />उनि दो पावल आर आले पाँजा पाँजातेये होहोयेत् ताहेंकाना, नोको होड़ दो चोट उता़रिच् इसोररेन गोलामको कानाको, ओने ओनको बाञचावक् रेयाक्‌ होरको जा़हिरापेकान। <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />आर नोवा दो ढेर दिने ओनकायेत्‌ ताहेंकाना। खानगे पावल दो आ़डि बा़ड़िच्ए बुजहा़उकेत्‌ते आ़चुरकाते उनि जिवे मेतादेया, जिसु मा़सि ञुतुमतेञ हुकुमाम काना, उनि खोन चालाक्‌मे। आर इना़ घा़ड़िच्‌तेगेये ओडोक सेनएना। <verse eid="ACT 16:18" /><verse number="19" style="v" sid="ACT 16:19" />मेनखान उनिरेन किसा़ँड़को दो आकोवाक् रोजगार रेयाक्‌ आस चाबायेनताकोवा मेनतेको ञेलकेत् खान पावल आर सिलासको साप्‌केत् किना, आर हा़टिया़ टा़न्‌डिते मुखिया़को ठेनको ओर इदिकेत्‌किना। <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />आर हा़किमको ठेनको इदिकेत्‌किनतेको मेनकेदा, नुकिन होड़ दो, ओनेकिन जिहुदिकान, आबोवाक् नागराहाकिन आ़उला़वेदा। <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />आर नोनकान आ़रि चा़लिकिन पोरचारेदा, ओने ओनाको बाक्‌ताव से दोक्‌हो बाङ गानोक् ताबोन, रोमिको कानतेबोन।<verse eid="ACT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 16:22" />आर गादेल होड़ दो मित्‌ते उनकिन उपा़रतेको तेङगोयेना, आर हा़किमको दो किचरिच्‌को पोटोरकेत्‌किनते बेंतते दालकिनको हुकुमकेदा। <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />आर आ़डिको दालकेत् किन खान, हाजोतरेको भोरावकात्‌किना, काजाकते दोहोकिना मेनते का़द ओड़ाक् दोरोगाको हुकुमादेते। <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />ओनकान हुकुमे ञामकेत्‌ते हाजोत ओड़ाक्‌रेये भोरावकात्‌किना, आर उनकिनाक् जाङगा दो हा़ड़ि पाटारेये हुरा़ड़ काजाककेत् ता़किना।<verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />मेनखान ताला ञिंदा़ गान पावल आर सिलास दोकिन कोयजोङकान आर इसोरकिन सेरेञ सारहावायकान ताहेंकाना, आर का़इदिको दोको आतेनेत्‌किन ताहेंकाना। <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />खान आचकागे नुना़क् आँट ओत लाड़ावेना, जे का़द ओड़ाक् रेयाक्‌ नेवको लाड़ावेना, आर इना़ घा़ड़िच्‌तेगे सानाम सिलपिञको दो झिच् गोत्एना, आर सानामकोवाक् तोनोल दो राड़ा गोत्‌एनताकोवा। <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />आर का़द ओड़ाक् दोरोगा दो जा़पित्‌ खोने एबहेनेनते हाजोत रेयाक्‌ सिलपिञ झिच्‌गेये ञेलकेत् खान तारवाड़ि बोच्‌काते आच्‌तेगेये गुजुक् ला़गिदोक्‌कान ताहेंकाना, का़इदिकोको दा़ड़केदा मेनतेये बुजहा़उकेत्‌ते। <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />मेनखान पावल दो आँट आँड़ाङते होहोवातेये मेनकेदा, आपनारते दो आलोम बा़ड़िजोक्आ। एनते जोतो नोंडे मेनाक्‌लेगेया।<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />खानगे दिउहेको कोयकेत्‌तेये ञिर बोलोयेना, आर थारथारावाते पावल आर सिलास सामाङरेये ओमबाक्एना। <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />आर ओडोक आ़गुकेत्‌किनतेये मेनकेदा, हेंदा बाबा, बाञचावक् ला़गित्‌ चेत्‌चेका होयोक्‌तिञा?<verse eid="ACT 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31" />आदोकिन मेनकेदा, प्रोभु जिसुरे पा़तिया़उक् मे आदोम बाञचावक्आ आम आर घारोंजरेनको हों। <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />आर उनकिन दो प्रोभुवाक् काथाकिन गालमारावादेया, उनि ओड़ाक्‌रेन सानामको सेलेत्। <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />आर उनि दो ञिंदा़ इना़ घा़ड़िच्‌गे इदिकेत्‌किनते दाल घावकोय आ़रुप्‌केत्‌ता़किना, आर इना़ तापतेगेको बा़प्‌तिसएना आच् आर आच् घारोंजरेन सानामको। <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />आदो आच् ओड़ाक्‌तेये राकाप् इदिकेत्‌किना, आर जोमाक्ए सामाङात्‌किना, गोटा घारोंजरेनको तुलुच्ए हुला़सेना, इसोररेये पा़तिया़वाकानते।<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />मेनखान सिञ मारसालेन खान हा़किमको सिपा़हि कोलकेत्‌कोतेको रोड़ गोत्‌कादा, उनकिन होड़ दो आड़ाक्‌ गोत्‌काकिनमे।<verse eid="ACT 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 16:36" />आर का़द ओड़ाक् दोरोगा दो ओनाको काथा पावले ला़इयादेया, बाङमा, हा़किमको दो आड़ाक्‌काबेना मेनते काथाको कोल आकादा, दे एनडेखान ओडोकोक्‌ते सुलुकते सेनजोङबेन।<verse eid="ACT 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37" />मेनखान पावल दो ओनकोय मेतात्‌कोवा, दिसा़म होड़को सामाङरेको दाल उरकेत्‌लिञा बिन बिचा़र दुसिते, आ़लिञ ओनेलिञ रोमि पोरजाकान, आर हाजोतरेको खादलेकात् लिञा, आर नितोक् दो ओको ओकोतेको ओडोक गोत्‌कालिञ काना? ओहोगे होयलेना, बिचकोम हेच्‌कातेको ओडोक इदिलिञमा।<verse eid="ACT 16:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38" />आर सिपा़हिको दो नोवाको काथा हा़किमकोको ला़इयात्‌कोवा, आर रोमि पोरजा कानाकिन मेनतेको आँजोमकेत् खान दोको बोतोरेना <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />आर हेच्‌काते इका़को कोयकेदा, आर उनकिन दो सोतोक् ओडोककातेको इदिकेत्‌किनतेको नेहोंरात्‌किना, जेमोन नागराहा खोन दोकिन सेनजोङ। <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />खान उनकिन दो हाजोत खोन ओडोकेनते लुदिया़ ठेनकिन बोलोयेना। आर बोयहाको तुलुच्‌ ञेपेल ञापामेनतेकिन उसकुरकेत्‌कोवा, आर ओंडे खोन किन चालावेना।<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s">थेस्‌सालोनिकिरे</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />आदो पावल आर सिलास आमपलिया़तुस आर आप्‌पोलोनिया़ तालाते दाँड़ाँ इदिकेत्‌ते थेस्‌सालोनिकिरेको सेटेरेना। ओने ओकारे जिहुदिकोवाक् मित्‌टेच् सुना़गोग ताहेंकान। <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />आर पावल दो आयाक्‌ चा़लि लेका ओनको ठेने बोलोयेना आर पे जिरा़उक् माँहाँ हा़बिच् सोसतोर रेयाक्‌ ओनको तुलुच्ए आपठा आ़पठिक्‌कान ताहेंकाना। <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />भेद भाङगाव आरे बुजहा़वात्‌कोते, बाङमा मा़सि दो दुक जोजोम आर गोच्‌को खोन जिवेत् बेरेदोक् जा़रुड़गे ताहेंकानताया मेनकेदाय, नुय जिसु ओने ओकोय रेयाक्‌ इञ ला़इयापेकान उनि कानगेयाय मा़सि दो। <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />आर ओनको मोदरेन आदोमको दोको पा़तिया़वेनते पावल आर सिलास तुलुच्‌को सेलेत्‌एना। आर इसोर भोकति जुना़निको मोदरेन आ़डि गादेल होड़ आर भोदरो मायजिउको मोदरेनको ढेरञोक्‌को हों।<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />जिहुदिको दो हिसका़तेको पेरेच्एना आर बाजार खोन बादमास होड़को माङगावकाते गादेल होड़को जारवाकेत्‌कोवा आर नागराहारे हुलको जानाम ओचोकेदा खानगे जासोनाक् ओड़ाक्‌तेको दानदानाव सेनेना आर ओंडे पावल आर सिलासको तोलास बाड़ाकेत्‌किना। जेमोन तुदरा़ होड़ाक् बा़इसि सामाङरेको ओडोक इदिकिन। <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />मेनखान बाको ञामलेत्‌किन खान जासोन आर आदोम आदोम बोयहाको नागराहा चाक्‌लावको ठेनको घाचघाचाव इदिकेत्‌कोवा, नोनका होहोवाते, नोको धा़रतिको गुलमाल आकात् होड़ दो नोंडे होंको हेच् आकाना। <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />आर जासोन दो ओनकोय आताङ आदेरकेत्‌कोवा। आर ओनको सानामको दो का़इसा़राक् हुकुम बिरुदको का़मिकेदा, ओनेको मेनेत्‌ते बाङमा जिसुको मेताय मित्‌टेच् एटागिच् राज मेनाया। <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />आर ओनाको आँजोमकेत् खान गादेल होड़ आर नागराहा चाक्‌लावको दोको तोरासेना। <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />आर जासोन आर सारेच्‌को जा़मिनको तेङगोकेत्‌कोते ओनको दोको आड़ाक्‌कात्‌कोवा।<verse eid="ACT 17:9" /></para>
  <para style="s">बेरिया़ रे</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />खानगे बोयहाको दो ञिंदा़गे पावल आर सिलास बेरिया़तेको कोल गोत्‌कात्‌किना। उनकिन दो ओंडेकिन सेटेरेन खान जिहुदिकोवाक् सुना़गोगतेकिन चालावेना। <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />नोंडेनको दो थेस्‌सालोनिकिरेनको खोन बा़ड़ति भोदरोगेको ताहेंकाना। नोको दो खाड़ा मोनते काथाको आताङकेदा, आर दिना़म हिलोक् सोसतोरकोको डुँढा़वेत् ताहेंकाना, भाला नोवाको दो ओनका कानगेया से बाङा। <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />ओनाते ओनको मोदरेन आयमा होड़को पा़तिया़वेना, आर मानोतान जुना़नि मायजिउको आर हेरेल होपोनको मोदरेन हों ढेरञोंक्‌गे। <verse eid="ACT 17:12" /><verse number="13" style="v" sid="ACT 17:13" />मेनखान थेस्‌सालोनिकिरेन जिहुदिको दो बेरिया़रे हों इसोराक् काथा पावले ला़इयाको काना मेनतेको बाडाय ञामकेत् खान, ओंडे हों हेच्एनते गादेल होड़ आ़उला़उ आरको तोरास ओचोकेत्‌कोवा। <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />खानगे बोयहाको दो साटमेनते पावलको कोल गोत्‌कादेया, जालापुरि, आड़े हा़बिच्ए चालाक्आ मेनते। मेनखान सिलास आर तिमोथि दो बेरिया़रेकिन ताहेंयेना। <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />आर पावल इक्‌दिको दो आथेंस हा़बिच्‌को इदि सेटेरकादेया। आर सिलास आर तिमोथि आच्‌ठेन उसा़राकिन हेच् होदोक्आ मेनते हुकुमको ञामकेत् खानको रुवा़ड़ चालावेना।<verse eid="ACT 17:15" /></para>
  <para style="s">पावल आथेंस रे</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />आदो पावल आथेंसरे उनकिने ता़ङगियेत्‌किन ताहेंकानरे, उनियाक् जिउ दो आच् भितरिरे जालजालावेनताया, नागराहा मुरहुत्‌कोते पेरेच्‌ आकाने ञेलकेत्‌ते। <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />ओनाते सुना़गोगरे जिहुदिको आर इसोर भोकतिको तुलुच्ए आपठा आ़पठिक्‌कान ताहेंकाना, आर हाट टा़न्‌डिरे दिना़म हिलोक् ञापामोक्‌कानको तुलुच् हों<verse eid="ACT 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 17:18" />आदो इपिकिउरि आर इसतोइक पोंडेतको मोदरेन आदोम उनि तुलुच्‌को ञापामेना। आर आदोमको दोको मेनकेदा, चेत् बाङ रोरोड़ सानायदेकान, नुय बोकोड़ बोकोड़िच् दो एटाक्‌को दोको मेनकेदा, आ़ना़डि बोङगाकोरेन ला़इ जा़क्‌हिरिच् लेकाय आ़इका़उक् काना एनते उनि दो जिसु आर जिवेत् बेरेदोक् रेयाक्‌ए पोरचारेत्‌ ताहेंकाना। <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />आदो उनि सोङगेकाते आरेयोपागोसतेको इदि केदेया, मेनकेदाको, बाडाय दाड़ेकेयाले, आमेम ला़येत्‌कान नोवा नावाँ सिकना़त दो चेत्‌काना मेनते? <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />एनते आ़ना़ड़ियाक्‌कोम आँजोमाले काना, ओनाते बाक्‌डाय सानायेत्‌लेया, ओनाको रेयाक्‌ माने दो चेत्‌काना मेनते <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />सानाम आथेंसरेनको आर ओंडे बासाआकान उपरिया़को दो जाहान सालास काथा ला़ला़इ से आँजोम छाडा आर जाहान एटागाक् ला़गित्‌ दो आकोवाक् गोटा आ़जा़उड़ि ओकतेको खेमावेत्‌कान ताहेंकाना।<verse eid="ACT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />आदो पावल आरेयोपागोस तालारे तेङगोयेनतेये मेनकेदा, ए आथेंसरेन होड़को जोतोवाक्‌कोरे बा़ड़ति देब माक्‌नावको लेकाञ ञेलेत्‌पेया। <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />एनतेञ सेन पारोमोक्‌रे आर आपेपे सेवावाक्‌ कानाक्‌कोञ आ़रिबा़न्‌धियेत् ताहेंकानरे मित्‌टेच् पिंड होंञ ञामकेदा, ओने ओनारे नोवा ओलाक् ताहेंकाना, बाङ बाडाय आकादेयिच् इसोर ला़गित्‌। आदो एनडेखान ओकाटाक् बिन बाडायतेपे सेवावाकोकान, ओनागे इञ दोञ ला़इयापे काना। <verse eid="ACT 17:23" /><verse number="24" style="v" sid="ACT 17:24" />इसोर ओने उनि धा़रति आर ओनारे मेनाक् जोतोवाक्‌कोय बेनाव आकात्। उनि दो सेरमा आर धा़रतिरेनको प्रोभु हुया़ँते तिते बेनावाक् कोयजोङ ओड़ाक्‌कोरे दो बाय ताहेनकाना।<note caller="+" style="x"><char style="xo" closed="false">17:24 </char><char style="xt" closed="false"><ref loc="1KI 8:27">१ रा ८:२७</ref>; <ref loc="ACT 7:48">आ का़ ७:४८</ref> </char></note> <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />आर मानवाकोवाक् तिते हों बाय साप्‌सोर ओचोक्‌काना, जाहानाक् जा़रुड़ायकान लेका, आच्‌गे सानामाक्‌को जियोन आर साँहेंत् आर सानामाक्ए एमाकोकानते। <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />आर उनि दो मित्‌टेन खोनगे मानवाकोवाक् मित्‌के मित् जा़तरेनको गोटा धा़रतिरेनको ताहेना मेनतेये बेनाव आकात्‌कोवा, ओनकोवाक् ताहेन ठा़ँइ रेयाक्‌ सिमा़को होंए बाँधाव आकादा। <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />जेमोन इसोरको ञाम बाड़ाये, पासेच्‌रे पासेच्‌ टा़मडा़उ आरको ञामकेदेगे, आबो मिमित् होड़ खोन सा़ङगिञरे बा़नुगिच्‌ रेहों।<verse eid="ACT 17:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 17:28" />एनते उनिरेगे जिवेत्‌बोन ताहेनकाना, आर बोन लाड़ावक्‌काना, आर मेनाक्‌बोना।</para>
  <para style="m" vid="ACT 17:28">आपेरेन आदोम आदोम सेरेञ जोक्‌ड़ावकोको मेन आकात् लेका,</para>
  <para style="q1" vid="ACT 17:28">बाङमा उनिरेन बोंस हों एनते कानगेयाबोन,<verse eid="ACT 17:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="ACT 17:29" />एनडेखान इसोररेन बोंसकानतेबोन, नोवा मेमेन दो बाङ लेकताबोना, बाङमा इसोरतेत् दोए, सोना से रुपा़ से धिरि लेकाना, ओने ओका मानवा रेयाक्‌ का़रिगोल आर हुदिस बुनदिसतेको कुँदा़उआकात् मुठा़न कान। <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />ओनाते इसोर दो बिन बाक्‌डाय रेयाक्‌ ओकतेकोय ञेल गोत्‌कात्‌ते, नितोक् दो मानवाकोय हुकुमाको काना, सानाम टा़न्‌डिरेन इसतोक होड़को मोनको आ़चुरताकोवा मेनते। <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />एनते मित्‌टेच् दिने नेन्‌डावाकादा ओने उनरे धा़रतिरेनको सा़रियाक्‌तेये बिचा़रको मित् होड़ होतेते ओने उनिये टारहाव आकादे, ओने ओना रेयाक्‌गे सानाम होड़े सा़बुत आकावात्‌को, गोच्‌ खोन उनिये जिवेत् बेरेत्‌केदेते।<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />आदो गोच्‌को जिवेत् बेरेदोक् रेयाक्‌को आँजोमकेत् खान, आदोमको दोको लानदा धुत्‌आदेया, मेनखान एटाक्‌को दोको मेनकेदा, नोवाको रेयाङ दो आरहोंले आँजोमतामा। <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />ओनकाकाते पावल दो ओनको ताला खोने ओडोक चालावेना। <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />मेनखान आदोमको दो उनि साँवेनतेको पा़तिया़वेना, ओनको मोदरेगे आरेयोपागोसरेन डियनुसियस, दामारिस ञुतुमान मित्‌टेन मायजिउ आर साँवते आर आरको होंको ताहेंकाना।<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s">कोरिन्‌थिरे पावल</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />ओनाको तायोम उनि दो आथेंस खोन ओडोक चालावेनते कोरिन्‌थि रेये सेटेरेना। <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />आर आ़कविला़ ञुतुमान मित्‌टेन जिहुदिये ञाम केदेया, जानामते पोनतुसरेन होड़गे, ओने उनि सोर दिनगे आच् ओड़ाक् होड़ प्रिसकिला़ साँवते इटा़लिया़ खोने हेच् आकान ताहेंकान, एनते कलोउडियोसे हुकुमाकात्‌ ताहेंकाना, सानाम जिहुदिको रोम खोनको ओडोक चालाक्आ मेनते। <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />आर उनकिन ठेने चालावेना, आर मित् लेकानाक्‌गे का़मि ताहेंकानताकोते उनकिन ठेने ताहेंयेना, आरको का़मिकान ताहेंकाना, एनते ता़मबु बेक्‌नावकोको ताहेंकाना। <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />आर जिरा़उक् माँहाँ पिछे सुना़गोगरे होड़को तुलुच्‌ए गालमारावाकोकान ताहेंकाना, आर जिहुदि आर जुना़निकोय बुजहा़उ ओरोम ओचोयेत्‌को कान ताहेंकाना।<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />मेनखान सिलास आर तिमोथि मा़किदुनिया़ खोनकिन फेड हेच्एन खान, पावल दो इसोराक् काथातेये उदगा़उ ओचोयेनते, जिसुगे मा़सिकानाय मेनते जिहुदिकोय गोहावात्‌कोवा। <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />आर ओनको दो तेङगो दाराम आरको हेनोसतावादे खान, आयाक्‌ किचरिच् कोटाकेत्‌तेये मेतात्‌कोवा, आपेयाक् माँयाँम दो आपेयाक् बोहोक्‌रेगे पाड़ावक् मा, इञ दोञ मिरिदोसगेया, आर नित खोन जिहुदि बाहरेरेन जा़तरेनको ठेनिञ चालाक्आ। <verse eid="ACT 18:6" /><verse number="7" style="v" sid="ACT 18:7" />आदो ओंडे खोन फेड सेनेनते तितुस जुसतुस ञुतुमान मित् होड़ाक् ओड़ाक्‌तेये बोलोयेना मित्‌टेन इसोर सेक्‌वा होड़गे, ओने उनियाक् ओड़ाक् दो सुना़गोगरे भिड़ा़वाकान ताहेंकान। <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />आर सुना़गोगरेन मुखिया़ क्रिसपुस दो आच् घारोंजरेनको सानामको सेलेत् प्रोभुरेये पा़तिया़वेना, आर कोरिन्‌थिको मोदरेन ढेर होड़ आँजोमकातेको पा़तिया़वेना, आरको बा़प्‌तिसएना।<verse eid="ACT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />आर प्रोभु दो ञिंदा़ मित्‌टेच् दोरसोनते पावले मेतादेया, आलोम बोतोरोक्आ मेनखान रोड़मे, आर आलोम हापेक्‌आ। <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />एनते इञगे आम साँवते मिना़ञा, एनते आम हा़नमे ला़गित्‌ दो ओकोय हों दिल बाको एमा, एनते नोवा नागराहारे आ़डि उता़र होड़ मेनाक्‌कोतिञा। <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />आदो मित् सेरमा तुरुइ चाँदो ओंडे ओनको तालारे इसोराक् काथा चेत्आकोकाने ताहेंयेना।<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />मेनखान गा़लियो दो आखायारेन चाक्‌लाविच्‌ए ताहेंकान जोखेच्, जिहुदिको दो मित् जोमकावते पावल उपा़रतेको तेङगोयेना, आर बिक्‌चा़र दुड़ुप्‌आक्‌ सामाङरे इदिकेदेतेको मेनकेदा। <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />नुय होड़ दो आ़न रेयाक्‌ धारा खोन उलटा़ इसोर सेवावाय ला़गित्‌ होड़कोय आ़ंडिच्एत्‌कोवा।<verse eid="ACT 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14" />खान पावले रोरोड़ ला़गिदोक् कान ताहेंकानरे गा़लियो दो जिहुदिकोय मेतात्‌कोवा, ए जिहुदिको, नोवा दो जाहान बेहोकाक् से दुसटा़मियाक् बा़ड़िच्‌ ताहेन खान, जा़रुड़गेञ आँजोमकेतापेया होनाङ। <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />मेनखान काथा रेयाक्‌ आर ञुतुमको आर आपेयाक् आ़न रेयाक्‌ रेटेपेटे कान खान एनडे खान आपेतेगे ञेलजोङपे ओनकानाक्‌को रेयाङ बिक्‌चा़रिच् होयोक् ला़गित्‌, इञ दो मोन बा़नुक्‌तिञा <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />आदो बिक्‌चा़र दुड़ुप्‌आक्‌ ठेन खोने लागा ञिरकेत्‌कोवा। <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />खानगे ओनको सानामको दो सुना़गोगरेन मुखिया़ सोसथेनेस साप्‌काते बिक्‌चा़र दुड़ुप्‌आक्‌ सामाङरेको दाल केदेया। आर गा़लियो दो ओनाको चेत् हों बाय मेंत् लुतुरादा।<verse eid="ACT 18:17" /></para>
  <para style="s">पावल आनटिओखिया़तेये रुवा़ड़ोक्</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />आर पावल दो आरहों ढेरञोक् दिन ओंडे ताहेंकाते बोयहाको ठेन खोन बिदा़येनते जाहाजते सुरिया़तेये चालावेना, आर उनि साँवते प्रिसकिला़ आर आ़कविला़ हों, आर केनखिरया़रेये मुंडरा़येना, एनतेये मानानआकावान ताहेंकाना।<note caller="+" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="NUM 6:18">नुमे ६:१८</ref></char></note> <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />आदो एफेसुसरेको सेटेरेन खान आर उनकिन दो ओंडेये बा़गि ओटोवात्‌किना, मेनखान आच् दो सुना़गोगरे बोलोयेनते जिहुदिको तुलुच्‌ए आपठा आ़पठियेना। <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />आर बा़ड़ति दिने ताहेना मेनतेको नेहोंरेन खान बाय रेबेनलेना। <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />बिचकोम ओनको ठेन खोन बिदा़येनतेये मेनकेदा, इसोरे मेनले खान आपे ठेनिञ रुवा़ड़ हिजुक्आ, आदो जाहाजते एफेसुस खोने चालावेना।<verse eid="ACT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 18:22" />आर का़इसा़रिया़रेये फेडएन खान जेरुसालेमते राकाप् सेनकाते का़लिसिया़रेनकोय जोहारात्‌कोते आनटिओखिया़तेये चालावेना। <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />आर तिना़क् दिन चोङ ताहेंकाते ओंडे खोने ओडोक चालावेना, आदो मित् मोहंडा गालातिया़ टोठा आर फुरुगिया़ तालातेये सेन इदियेना, आर सानाम चेलाकोय दिड़हो इदिकेत्‌कोवा।<verse eid="ACT 18:23" /></para>
  <para style="s">आपोलोस एफेसुस आर कोरिन्‌थि</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />आर आपोलोस ञुतुमान मित्‌टेन जिहुदि होड़ जानामते दो आलेकसान्‌डेरिया़ रेन, रोरोड़रे मित्‌टेन गा़खुड़ होड़ एफेसुसरेये सेटेरेना। उनि दो सोसतोरको बेस बाडाय होड़े ताहेंकाना। <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />उनि दो प्रोभु रेयाक्‌ होर रेयाङे ला़इ चेत् आकोकान ताहेंकाना, आर जिउरेये हेडेजोक्‌कान ताहेंकानते जिसु रेयाक्‌को ठिक ठिके गालमाराव आर चेत् आकोकान ताहेंकाना। मेनखान एकेन जोहान रेयाक्‌ बा़प्‌तिसगेये बाडाय आकात् ताहेंकाना। <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />आर उनि दो सुना़गोगरे सोहोसाते रोरोड़े एहोप् एना। आदो प्रिसकिला़ आर आ़कविला़ उनिकिन आँजोमकेदे खान, आ़किन ठेनकिन इदि केदेया, आर इसोराक् होर रेयाक्‌ आरतेत्‌ ठिक ठिक किन ला़इ बुजहा़वादेया। <verse eid="ACT 18:26" /><verse number="27" style="v" sid="ACT 18:27" />आर आखायाते पारोम चालाक्ए मेनवान खान, बिसवा़सिको दो उनिको उसकुर केदेया, आर चेलाकोको ओलात्‌कोवा जेमोनको आताङ दारामे, उनि दो ओंडे सेटेरेनते दायाते पा़तिया़वाकानको आ़डिये गोड़ोंवात्‌कोवा। <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />एनते उनि दो सोदोरते होड़ सामाङरे जिहुदि होड़को दो जिदा़जिदे भागावकेत्‌कोवा, जिसुगे मा़सिकानाय मेनते सोसतोरको खोन सोदोरतेये सा़बुतात्‌कोवा।<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s">पावल एफेसुसरे</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />आर नोनका होयेना, आपोलोस कोरिन्‌थिरेये ताहेंकानरे, पावल दो चेतान टोठाको तालाते दाँड़ाँ इदिकाते एफेसुसतेये हेच्एना, आर तिन उडि चेलाको चोय ञामकेत्‌कोवा <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />आरे मेतात्‌कोवा, “पा़तिया़वेनरे सोनोत जिउपे ञामकेदा?”</para>
  <para style="p" vid="ACT 19:2">आदोको मेतादेया, “सोनोत जिउ मेनाया से बाङा ओना दो आँजोम हों बाले आँजोमाकात्‌आ।”<verse eid="ACT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3" />खानगेये मेनकेदा, “एनडेखान ओकाटाक्‌तेपे बा़प्‌तिसएना?” मेनकेदाको “जोहान रेयाक्‌ बा़प्‌तिसमाते।”<verse eid="ACT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4" />आदो पावले मेनकेदा, “जोहानाक् बा़प्‌तिसमा दो का़इ खोन आ़चुर रेयाक्‌ ताहेंकाना। उनि दो इसराएलकोय मेतात्‌कोवा, जिसु ओकोय दो इञ तायोमतेये हिजुक्‌कान उनिरे पा़तिया़उक्‌पे।” <verse eid="ACT 19:4" /><verse number="5" style="v" sid="ACT 19:5" />आर ओनाको आँजोमकेत् खान, प्रोभु जिसु मा़सि ञुतुमतेको बा़प्‌तिस ओचोयेना। <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />आर पावल ओनकोय चापोकेत्‌को खान सोनोत जिउ दो ओनकोरेये हेच्एना, आर एटाक्‌ पा़रसिकोतेको रोड़केदा आरको ना़बिकेदा। <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />आर ओनको दो जोतोते गेलबार गान हेरेल होपोनको ताहेंकाना।<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />आर उनि दो सुना़गोगरे बोलोकाते पे चाँदो दिन हा़बिच् सोहोसातेये रोड़ेत् ताहेंकाना आर इसोराक् राज रेयाक्‌ ला़इ बुजहा़वाको आरे रा़मजा़वेत्‌को कान ताहेंकाना। <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />मेनखान आदोमको दोको केटेच्‌ इदियेन आर बाको पा़तिया़उलेनते, खान गादेल होड़को सामाङरे ओना होर बा़ड़िच्‌को मेतात्‌ते, ओनको खोन साहाड़ेनते चेलाकोय बेगारकेत्‌कोवा, आर दिना़म हिलोक् तुरानुस रेयाक्‌ इसकुलरेये ला़इ बुजहा़वाको कान ताहेंकाना। <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />आर ओनका दो बार सेरमा हा़बिच् होय इदियेना, ओनाते आ़सिया़रे ताहेंकान सानामको प्रोभुवाक् काथाको आँजोमकेदा, जिहुदिको हों आर जुना़निको हों।<verse eid="ACT 19:10" /></para>
  <para style="s">इसकेवा रेन होपोनको</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />आर दाड़े का़मिको, बाङ होय बाड़ाक्आक्‌कोगे इसोर दो पावल तितेये का़मियेत् ताहेंकाना। <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />नुना़क् हा़बिच् जे रुगिको ठेन उनियाक् होड़मो खोन गामछाको आर उरमा़ल किचरिच्‌कोको इदियेत् ताहेंकाना, आर रोगको खोनको बोगेक्‌कान ताहेंकाना आर बा़ड़िच् जिउकोको ओडोक चालाक्‌कान ताहेंकाना।<verse eid="ACT 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 19:13" />मेनखान आदोम आदोम देसपोडा हुक्‌सित्‌ झाजाड़ जिहुदिको हों बा़ड़िच् जिउको ताहेंकानताको होड़कोरे प्रोभु जिसुवाक् ञुतुम ञुम लेगाकेत्‌तेको मेनकेदा, “पावले पोरचारेदे कान जिसु ञुतुमतेञ हुकुमाम काना।” <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />आर इसकेवा ञुतुमान जिहुदि माराङ नायकेरेन एयाय गोटेच् होपोनको ताहेंकाना। ओकोयको ओनकायेत् ताहेंकान।<verse eid="ACT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 19:15" />खान उनि बा़ड़िच् जिउ दो रोड़ रुवा़ड़ात्‌कोतेये मेतात्‌कोवा, “जिसुञ बाडायेदेया आर पावल होंञ ओरोमएदेया, मेनखान आपे दोपे ओकोयकाना?”<verse eid="ACT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 19:16" />खानगे उनि होड़ ओकोयरे बा़ड़िच् जिवे ताहेंकान, उनि दो ओनकोरे दोन लादेयेनते जोतोगेये आ़धिनकेत्‌कोवा, आर ओनकोय भिनदा़ड़केत्‌कोवा, ओनाते ओनको दो ओड़ेच् किचरिच् सालाक् आर घा़लकाते ओना ओड़ाक् खोनको ञिर ओडोकेना।<verse eid="ACT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 19:17" />आर ओना दो एफेसुसरे ताहेंकान सानामको ठेन बाडायेना, जिहुदिको ठेन हों आर जुना़निको ठेन हों आर ओनको सानामकोरे बोतोर पाड़ावेना, आर प्रोभु जिसुवाक् ञुतुम दो माराङेना <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />आर पा़तिया़वाकानको मोदरेन ढेर होड़ हेच्‌काते आको आकोवाक् ओनकान का़मिकोको आङगोच आरको ला़इ सोदोरकेत्‌ताकोवा। <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />आर ढेर होड़ ओकोयको गुनि बाड़ायेत्‌ ताहेंकान आकोवाक् पुथिको आ़गु जारवाकाते सानाम होड़को सामाङरेको जेरेत् गिडिकेदा, आर ओनाको रेयाक्‌ दामको हिसा़बकेत् खान, मोंडे़ंगेल हाजार चा़नि टाका होयेना। <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />ओने ओनका लेका दाड़ेते प्रोभुवाक् काथा दो पासनाव आर नामडाक इदियेना,<verse eid="ACT 19:20" /></para>
  <para style="s">एफेसुस रे गुलमाल</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />आदो ओनाको होय बाड़ायेन तायोम पावल दो जिउरेये निटआना मा़किदुनिया़ आर आखाया दाँड़ाँ पारोमकाते जेरुसालेमते चालाक् ला़गित्‌ आरे मेनकेदा, “ओंडेञ सेनलेन तायोम दो रोम हों ञेञेलगे होयोक् तिञा।” <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />आर का़मि सोहोत्‌आय कानको मोदरेन बार होड़ तिमोथि आर एरासतुस, मा़किदुनिया़ते कोलकेत्‌किनते आच् दो थोड़ा दिन आ़सिया़रेगेये ताहेंञोंक् एना।<verse eid="ACT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />मेनखान ओना जोखेच्‌ होरतेत् रेयाङ आ़डि गुलमाल होयलेना। <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />एनते देमेतिरयोस ञुतुमान मित् होड़ सोनहारगे, ओकोय आरतेमिस रेयाक्‌ रुपा़ कोयजोङ ओड़ाक्‌कोय बेनावेत् ताहेंकान, उनि दो का़रिगोलको आ़डिये रोजगार ओचोयेत्‌को कान ताहेंकाना। <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />उनि दो ओनको आर ओना लेकानाक् का़क्‌मिको जोमकाव जारवाकेत्‌कोतेये मेनकेदा, “ए हो बाडायगेयापे आबो दो नोवा का़मितेगेबोन लाबेत्‌काना मेनते। <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />आर ञेल आरपे आँजोमेदा एकेन एफेसुसरे दो बाङ, मेनखान गोटा आ़सिया़रे लेकागे नुय पावल दो रा़मजा़उकाते आयमा होड़े भानटाव आकात्‌कोवा, ओनेये मेनेत्‌ते बाङमा तिते बेनावको दो इसोरको बाङ काना। <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />आर नोवा बेपार दुसा़उक् ताबोना, एकेन नोवा रेयाक्‌ बोतोर दो बाङ काना, बिचकोम माराङ देब आरतेमिस रेयाक्‌ कोयजोङ ओड़ाक्‌ हों चेत् हों बाङ लेखाक्आ आर उनियाक् माराङ साबासि दो ञुरहा़क्आ, ओने उनि गोटा आ़सिया़रेन आर धा़रतिरेनकोको सेवावायकान।”<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />आदो ओना आँजोमकेत्‌ते एदरेतेको पेरेच्‌एन खान आँदोड़ातेको होहोकेदा, “माराङगेयाय एफेसिकोरेन आरतेमिस दो।” <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />आर नागराहा दो आ़उला़उ चाबायेना, आर रिया़उ मित्‌कातेको गादगादाव बोलोयेना आर पावल साँवते दाँड़ाँकिन मा़किदुनिया़रेन गा़युस आर आ़रिसतारखुस आखड़ातेको झुटिया़उ इदि तोराकेत् किना। <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />आर पावल दो ठा़उरा़ होड़को ठेन बोलोक्ए मेनवान खान, चेलाको दो बाको सेन ओचोवादेया। <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />आर आ़सिया़रेन मुखिया़को मोदरेन हों आदोमको दो उनिरेन गातेको ताहेंकानते, उनि ठेन काथाको कोलकेत्‌तेको नेहोंरादेया, जेमोन आखड़ाते आलोय सेन आलायोक्। <verse eid="ACT 19:31" /><verse number="32" style="v" sid="ACT 19:32" />आर आदोमको दो मित् लेका आर आदोमको दो एटाक् लेकाको होहोयेत्‌ ताहेंकाना; एनते जारवा आकान होड़ दोको आ़उला़उ सा़तआकान ताहेंकाना, आर जोतो लेकागे बाको बाडायकान ताहेंकाना चेत् ला़गित्‌ चोङको जारवा आकान। <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />आदो गादेल होड़को मोदरेन आदोमको दो आलेकसानदेरको सिखा़उकेदेया, जिहुदिको उनिको ढाका लाहाकेदेते। आर आलेकसानदेर दो तिते इसा़राकेत्‌ते जारवा होड़को ठेन रोड़ दोगोक्‌ए मेनजोङकान ताहेंकाना। <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />मेनखान जिहुदि होड़ कानाय मेनतेको बाडाय ओरोमकेदे खान सानामको मित् आड़ाङते बार घोन्‌टा गानको होहोकेदा, “माराङगेयाय एफेसिकोरेन आरतेमिस दो।”<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />आदो नागराहारेन हा़किम गादेल होड़कोय थिर ओचोकेत्‌को खाने मेनकेदा, “ए एफेसिको, ओकोय हाले बाय बाडाय काना, जे एफेसुस नागराहारेनको दो माराङ आरतेमिसाक् कोयजोङ ओड़ाक्‌ आर जुपितेर, सेरमा खोन ञुरहा़वाक् मुठा़न होरहोको कानाको मेनते? <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />ओनाको रोड़ एसेदोक्आक् दो बाङकानते, आपे दो थिरकोक् लेकतापेया, आर जाहानाक् हुरमुट दो आलोपे का़मिया। <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />एनते नुकिन होड़ नोंडेपे आ़गुवाकात्‌किना ओकोय कोयजोङ ओड़ाक्‌ लुलुटकिन होंकिन बाङकान आर आबोरेन देब हेनोसताकिन होंकिन बाङकान। <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />आदो देमेतिरयोस आर उनि साँवतेन का़रिगोलको जाहाँय उपा़रते जाहान काथा मेनाक्‌ताको खान, एनडेखान का़चा़हा़रि खुला़गेया; आर हा़किमको हों मेनाक्‌कोगेया; ला़लिस मा। <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />मेनखान जाहान एटाक् काथा रेयाक्‌ पे खोजकान खान एनडेखान ओना दो आ़न बाँधावक् बा़इसिरे छिन्‌डा़उक्आ। <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />एनते तेहेञ रेयाक्‌ हुलमाल बाबोतरे ला़लिसाबो रेयाक्‌ बोतोर मेनाक्आ, ओना रेयाक्‌ चेत् कारोन हों बा़नुक्‌ते, आर नोवाबो ञिर जारवा आकान रेयाक्‌ जोबाबदिहि बाबोन एम दाड़ेयाक्‌ते।” <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />आदो नोनकाए रोड़केत् खान जारवा आकान होड़कोय बिदा़कात्‌कोवा।<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s">मा़किदुनिया़ आर आ़सिया़ सेच्‌</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />आदो ओना हुलमाल थिरेन तायोम पावल दो चेलाको होहो आ़गु ओचोकातेये उसकुरकेत्‌कोवा, आर ओनको बिदा़ जोहारात्‌कोते मा़किदुनिया़ते सेनोक् ला़गित्‌ए ओडोक चालावेना। <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />आर ओनाको टोठा तालातेये सेन इदियेना आर ढेर काथातेये उसकुरकेत्‌कोते जुना़नितेये चालावेना। <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />आर पे चाँदो ओंडेये खेमावकेत् खान, आर जाहाजते सुरिया़तेये चालाक् ला़गिदोक्‌कान ताहेंकानरे जिहुदिको उनि उपा़रतेको मित् सा़तेना उनि जालसा़जिये ला़गित्‌ खान, मा़किदुनिया़ तालाते रुवा़ड़ चालाक्‌गेये गोटावाना। <verse eid="ACT 20:3" /><verse number="4" style="v" sid="ACT 20:4" />आर बेरिया़रेन पुरोस होपोन सोपातेर दो उनि सोङगेते आ़सिया़ हा़बिच्ए चालावेना, आर नोकोको हों, थेस्‌सालोनिकिको मोदरेन आ़रिसतारखुस आर सेकुनदुस, देरबेरेन गा़युस आर आर आ़सिया़रेन तुखिकुस आर तरोफिमुस आर तिमोथि। <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />आर ओनको दो सेन लाहाकाते तरोआसरे आलेको ता़ङगिकेत्‌लेया। <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />मेनखान आले दो बिन ता़ड़ियानाक्‌ पिठा़ पोरोब दिनको तायोम फिलिपि खोन जाहाजतेले चालावेना, आर मोंड़ें माँहाँते ओनको ठेन तरोआसतेले सेटेरेना आर ओंडे दो एयाय माँहाँले ताहेंयेना।<verse eid="ACT 20:6" /></para>
  <para style="s">मुचा़त् धाव तरोआसतेये चालावेन</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />आर हापता रेयाक्‌ पा़हिल हिलोक् पिठा़ केचाग ला़गित्‌ले हेच् जारवा आकान ताहेंकानरे, पावल दो दोसार हिलोक् ओडोक चालाक्ए मेनजोङकान ताहेंकानते, ओनकोय गालमारावात्‌कोवा, आर ताला ञिंदा़ हा़बिच्ए गालमाराव इदिकेदा। <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />आर ओना चेतान कांदहारे, ओने ओकारेले जारवा आकान ताहेंकान, आयमा दिउहेको जोलोक्‌कान ताहेंकाना। <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />आर एथुकुस ञुतुमान मित्‌टेन जुवा़न होड़ दो खिड़कि दुवा़ररे दुड़ुप्‌ आकान ताहेंकाना। आदो पावल दो आ़डि घा़ड़िच्‌ए गालमाराव इदियेत् ताहेंकानते, उनि दो आ़डि दुद्ड़ुमकेदेतेये जा़पित् ला़थिया़वेन खान तेसार माहला खोने ञुरहा़येना आर गोच्‌गेको तुल राकाप्‌ केदेया। <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />खानगे पावल दो फेडेनते उनिये ताबेर लोटोमकेदेया, आर उनि हा़ड़ुप्‌केदेतेये मेनकेदा, “आलोपे का़वा़रा़वा़क्आ, एनते जिवि दो मेनाक्‌गेताया।” <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />आदो राकाप् सेनेनते पिठा़इ केचाक्‌केदा, आरे जोमकेदा, आर ढेर घा़ड़िच्‌ आङगा मारसालोक् हा़बिच्ए गालमारावात्‌कोवा, आदोए ओडोक चालावेना। <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />आर उनि कोड़ा दो जिवेत्‌गेको आ़गु केदेया, आर आ़डितेत् जिवि राड़ेच्‌एन ताकोवा।<verse eid="ACT 20:12" /></para>
  <para style="s">तरोआस खोन मिलेतुस हा़बिच्‌</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />मेनखान आले दो जाहाज ठेन सेन लाहायेनते जाहाजते आससोसतेले मोहंडायेना, ओंडे पावल देजेले मेनवान ताहेंकानते, एनते ओनकागेये निट आकात् ताहेंकाना, आच् दो ओत ओततेये चालाक् ला़गिदोक्‌कान ताहेंकानते। <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />आदो आससोसरे आले तुलुच्ए ञापामेन खानले देच्‌ केदेया आर मितेलेनेतेले हेच्एना। <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />आर ओंडे खोन जाहाजते चालावेनते दोसार हिलोक् दो खियोस मोहंडारेले सेटेरेना; आर ओना दोसार हिलोक् दो सामोस ठेनले तेङगोञोक्‌केदा आर ओना दोसार हिलोक् दो मिलेतुसरेले सेटेरेना। <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />एनते पावल दो जाहाजते एफेसुस कोञे ओटोकात्ए निट आकात् ताहेंकाना, जेमोन आ़सिया़रे दिन खेक्‌माव आलो होयोक्‌ताय; एनतेये उसा़रायेत् ताहेंकाना, होय दाड़ेयाक् खान जेमोन पेनतेकोस हिलोक् दो जेरुसालेमरेये ताहेन।<verse eid="ACT 20:16" /></para>
  <para style="s">एफेसुस रेन मुरुबिको ला़गित्‌ पावलाक् मुचा़त् पोरचार</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />आर मिलेतुस खोन एफेसुसते काथा कोलकेत्‌ते का़लिसिया़रेन मुरुबिकोय होहो आ़गुकेत्‌कोवा। <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />आर उनि ठेनको हेच्एन खाने मेतात्‌कोवा।</para>
  <para style="p" vid="ACT 20:18">आपेपे बाडाया, आ़सिया़रेञ बोलोयेन पा़हिल हिलोक् खोन जावगे चेत्‌लेका आपे तुलुच् इञ बेवहार आ़गुवाकादा। <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />प्रोभु ठेन गोलाम इञ खाटावेना, आ़डि निंधा़न मोनते, मेंत्‌दाक् जोरो जोरोते, आर जिहुदिकोवाक् बा़ड़िच् पोन्‌था पाड़ावादिञ बिडा़उको सालाक्। <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />इञ दो जाहान पोरहोवानाक्‌गे ला़इ सोदोरापे आर चेत् आपे बा़ञ पा़चलेना, सोदोररे आर ओड़ाक् ओड़ाक्‌रे, <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />इसोर सेच् मोन आ़चुर रेयाक्‌ आर आबोरेन प्रोभु जिसु मा़सिरे पा़तिया़उक् रेयाक्‌ जिहुदिको हों आर जुना़निको हों गोहाञ एम इदियात्‌कोते। <verse eid="ACT 20:21" /><verse number="22" style="v" sid="ACT 20:22" />आर नितोक् दो ञेलपे इञ दो सोनोत जिउतेञ तोलआकान जेरुसालेमतेञ चालाक् काना, ओंडे चेत्‌को चोङ पाड़ावा़ञ, ओना दो बिन बाडायतेगे <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />सोनोत जिउ दो नागराहा पिछे गोहावा़ञकानतेये मेता़ञ काना, बाङमा तोनोलको आर सानतावकोको ता़ङगिएदिञ काना। <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />मेनखान इञाक् जिवि दो आपनार ला़गित्‌ दामानाक्‌ बा़ञ मेताक् काना, खा़जुक इञाक् साफोर इञ पुरा़उ दा़ड़ेयाक्, आर ओना साप्‌दाप् का़मि हों, ओकाटाक् प्रोभु जिसु ठेन खोन इञ ञामआकात्, मेताक् मे इसोराक् दाया रेयाक्‌ भागे सोमबात रेयाक्‌ गोहा एमोक्।<note caller="+" style="x"><char style="xo" closed="false">20:24 </char><char style="xt" closed="false"><ref loc="2TI 4:7">२ ति ४:७</ref></char></note><verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />आर नितोक् दो ञेलपे इञिञ बाडाया, आपे जोतोको, ओने आपे तालारे दाँड़ाँ दाँड़ाँते राजोसटि रेयाक्‌ इञ पोरचारकेत्, आर दो इञाक् मेंत्‌हाँ बापे ञेला। <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />ओना इया़ते तेहेञ इञ गोहावापे काना, जे इञ दो सानाम होड़कोवाक् माँयाँम खोन इञ मिरिदोसगेया। <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />एनते इसोराक् गोटा मोने रेयाक्‌ ला़इ सोदोरापे दो बा़ञ पा़चलेना। <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />आपनार ला़गित्‌ सोनतोरोक् पे, आर गोटा खा़ड़रेनको ला़गित्‌ हों, ओने ओनको तालारे सोनोत जिउ दो होहोरहोको मेनकातेये दोहोआकात्‌पे इसोराक् का़लिसिया़रेनको गुपिकोवा मेनते, ओने ओका आच् निज माँयाँमतेये किरिञान। <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />इञिञ बाडाया, इञ सेन तायोम चाङके हुनडा़रको आपे तालारेको बोलोक्आ, ओनको दो खा़ड़रेनको बाको माँयाँवाकोवा। <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />आर आपे मोद खोनगे होड़कोको तेङगोना, ओने ओनको पेड़तावाक्‌कोको रोड़, चेलाको आको तायोमते झाकरावको ला़गित्‌। <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />ओना इया़ते जागवारआकाय ताहेनपे, नोवा दिसा़काते, जे पे बोछोर हा़बिच् सिञ ञिंदा़ मेंत्‌दाक् जोरो जोरोते आपे मित्‌के मित्‌ होड़ चेहावपे दो बा़ञ थिरलेना।<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />आर नितोक् दो इसोर ठेन आर उनियाक् दाया रेयाक्‌ काथारेञ जिमा़कापे काना, ओने उनि दोए बेनाव इदि दाड़ेयापे आर सानाम सोनोतको तालारे आ़इदा़रिये एम दाड़ेयापे। <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />ओनकोवाक् हों रुपा़ से सोना से किचरिच् बा़ञ लालोचआदा। <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />आपेपे बाडाया, इञ आर सोङगेतेनको जा़रुड़ालेयाक्‌को ला़गित्‌ दो निया़ तिगेकिन खाटावलेना। <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />इञ दो सानामाक्‌रेञ का़मि उदुक्आत्‌पेया, ओनका मेहनोतकाते निजोरको गोड़ोंवाको लेक ताबोना मेनते, आर जेमोन प्रोभु जिसुवाक् काथाबो दिसा़य चेत् लेका आच्‌गेये मेनकेत्, “बिचकोम हाक्‌ताव खोन एमोक्‌गे भागेया।”<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />आदो ओनाकोय रोड़केत् खान इखड़ुमेनते ओनको सानामको साँवतेये कोयकेदा। <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />आर सानामकोगे हुँक हुँकको राक्‌केदा आर पावल कोकेकेदेतेको चोक्‌ चोक्आदेया। <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />ढेरकायते दो ओना काथा इया़तेको भाबनायेनते ओनेये मेनलेत्, बाङमा इञाक् मेंत्‌हाँ आर दो बापे ञेला। आदो जाहाज हा़बिच् को इदि गोत्‌कादेया।<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s">पावल जेरुसालेमतेये सेनोक् कान</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />आदो ओनको ठेन खोनले बिदा़येन खान जाहाज लाड़ावकाते मित् मोहंडा सेन इदियेनते कोसतेले हेच्एना, आर दोसार हिलोक् दो रोडोसते आर ओंडे खोन दो पाताराते <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />आर फोयनिकिया़ते पारोम चालाक् ला़गिदोक्‌कान मित्‌टेन जाहाजले ञामकेत्‌ते, ओनारे देच्एनतेले लाड़ावकेदा, <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />आर कुपरोसले ञेल ञामकेत् खान, ओने कोञे ओटोकात्‌ते जाहाजते सुरिया़ सेच्‌ले चालावेना, आर तुररेले फेडेना; एनते ओंडेगे जाहाज रेयाक्‌ माल फेड जा़रुड़ ताहेंकाना। <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />आदो चेलाकोले सुटिक ञामकेत्‌कोते, ओंडे एयाय माँहाँले ताहेंयेना; आर ओनको दो जिउ होतेते पावलको मेतादेया, जेमोन जेरुसालेमते दो आलोय सेनोक्। <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />आदो ओनाको दिनले ताहें पुरा़वेन खान, ओडोकेनतेले चालाव इदियेना आर सानामकोगे, मायजिउको आर गिदरा़को साँवते नागराहा बाहरे हा़बिच्‌को इदि गोत्‌कात्‌लेया, आर जालापुरि ढिपरे इखड़ुमेनतेले कोयाना। <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />आर बिदा़क् जोपोहार बाड़ाकाते जाहाजरेले देच्‌एना आर ओनको दो आकोवाक् ओड़ाक्‌तेको रुवा़ड़ेना।<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />आदो तुर खोन तोलेमाइसरेले सेटेरेनते जाहाजते दाड़ान दोले मुचा़त्‌केदा आर बिसवा़सिकोले जोहारात्‌कोवा आर ओनको ठेन मित् दिनले ताहेंयेना। <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />आर दोसार हिलोक् दो ओडोकेनते का़इसा़रिया़तेले हेच्एना, आर भागे सोमबात पोपोरचारिच् फिलिप ओड़ाक्‌ते बोलोकाते उनि ठेनले ताहेंयेना, उनि दो ओनको एयायको मोदरेने ताहेंकाना ओकोय दो जेरुसालेमरे गोक्‌ड़ो ला़गित्‌को बाछाव ओचोलेन। <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />आर उनिरेन पोनया होपोनेराको ताहेंकानताया, कुँवा़ँरि कुड़िको, ओने ओनकोको ना़बि बाड़ायेत् ताहेंकान <verse eid="ACT 21:9" /><verse number="10" style="v" sid="ACT 21:10" />आदो ओंडे ढेर दिनले ताहेंकानरे, आगाबुस ञुतुमान मित्‌टेन ना़बि जिहुदिया़ खोने हेच्एना। <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />आर उनि दो आले ठेन हेच्एनते पावलाक् पाठेक्‌आक् साप्‌काते आयाक्‌ जाङगा आर ति तोलकातेये मेनकेदा, “सोनोत जिउ नोनकाय मेनेदा, नोवा पाठेक्‌आक्‌ ओकोयाक् काना, उनि दो जिहुदिको जेरुसालेमरे नोनकागेको तोलेया, आर जिहुदि बाहरेरेनकोवाक् तिरेको सोपरोतेया।”<verse eid="ACT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12" />नोवा ओनाकोले आँजोमकेत् खान, आले हों आर ओंडेनको हों जेरुसालेमते आलोय राकाप् चालाक्आ मेनते उनि ले नेहोंरादेया। <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />खानगे पावले रोड़ रुवा़ड़केदा, चेत्‌पे चेकायेदा, राराक् कान आर इञाक् मोनपे गेजेरेत् तिञ दो? एनते इञ दो तोल ओचोक् मोतोच् दो बाङ, बोरोङ प्रोभु जिसुवाक् ञुतुम खा़तिरते जेरुसालेमरे गोच् ओचोक् होंञ सापड़ावगेया।<verse eid="ACT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 21:14" />आदो बाय रेबेनलेनतेले थिर हापेयेना, मेनकेदाले प्रोभुवाक् मोने बाड़े पुरा़उक् मा।<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />आर ओनाको दिन तायोम दो मोटरा झोटराकाते जेरुसालेमतेले राकाप् सेनएना। <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />आर का़इसा़रिया़रेन आदोम आदोम चेलाको हों आले तुलुच्‌को चालावेना, ओनको दो कुपरोसरेन मानासोन ञुतुमान मित्‌टेन मारे चेला ठेनको इदि केत्‌लेया, ओने उनि ठेनगेले डेराक् ला़गिदोक्‌कान ताहेंकान।<verse eid="ACT 21:16" /></para>
  <para style="s">पावल जाकोबे हिरियेदे</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />जेरुसालेमरेले सेटेरेन खान, बिसवा़सिको दो आ़डि रा़सका़तेको आताङ दारामकेत्‌लेया। <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />आर दोसार हिलोक् पावल दो आले साँवते जाकोब ठेने बोलोयेना, आर सानाम मुरुबिको दो ओंडेको हेच्एना। <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />आर जोहार बाड़ावात्‌को खान एके एकेतेये ला़इ इदिकेदा, ओकाको इसोर दो जिहुदि बाहरेरेनको तालारे आयाक्‌ साप्‌दाप् का़मि होतेतेये का़मिआकात् ताहेंकान। <verse eid="ACT 21:19" /><verse number="20" style="v" sid="ACT 21:20" />आर ओनको दो ओनाको आँजोमकेत् खान इसोरको सारहावकेदेया, आरको मेतादेया, जिहुदिको मोदरेन पा़तिया़उ आकानको हाजार हाजार मेनाक्‌कोवा, आर सानामकोगे आ़न ला़गित्‌ आँटोक्‌को कानाको। <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />आर आम रेयाङको ला़इ तिया़क् आकावात्‌कोवा, बाङमा आम दो जिहुदि बाहरेरेनको तालारे मेनाक्‌को सानाम जिहुदिको मोसे खोन भिङगड़ा़उक् एम चेत्आको काना, ओनेम मेनेत्‌ते, आकोरेन गिदरा़को आलोको खातनाकोमा आर चा़लि लेका हों आलोको सेनोक्‌मा। <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />आदो चेत्? आमेम हेच् आकान मेनते खा़टिगेको आँजोमा नाहाँक्‌। <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />ओना इया़ते आलेले मेतामकान लेकायमे, आले ठेन पोन होड़ मेनाक्‌कोवा, ओकोयको मानान आकात्।<note caller="+" style="x"><char style="xo" closed="false">21:23 </char><char style="xt" closed="false"><ref loc="NUM 6:13-21">नुमे ६:१३-२१</ref> </char></note> <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />ओनको इदि तोराकोते ओनको तुलुच्‌ साफा सोनोतोक्‌मे, आर ओनको लागावाको खोरोच एमोक्‌मे, जेमोन बोहोक्‌को होयोक्‌, आदो सानामकोको बाडाया, आम रेयाक्‌को ला़इ ओचो आकानाक् दो आ़उड़ियाक्‌गेया, बिचकोम आम आपनार हों आ़न दोहोकातेम चोलोनेदा मेनते। <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" />मेनखान पा़तिया़उ आकान जिहुदि बाहरेरेनको दो आलेगे नोवा निटकातेले चिठियात्‌कोवा, बाङमा, ओनको दो बोङगा सामाङाक्‌को खोन, माँयाँम खोन, लिमबा़त्‌ गोच्‌कोवाक् जेल खोन, लोटघुटि खोन साहाड़ाकानको ताहेन।<note caller="+" style="x"><char style="xo" closed="false">21:25 </char><char style="xt" closed="false"><ref loc="ACT 15:29">आ का़ १५:२९</ref> </char></note><verse eid="ACT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />खानगे पावल दो ओनको होड़ इदि तोराकेत्‌कोते दोसार हिलोक् ओनको तुलुच्‌ साफा सोनोतेनते कोयजोङ ओड़ाक्‌रेये बोलोयेना, आर साफा सोनोतोक्‌ दिनको पुरा़उक् रेयाक्‌ए ला़इ सोदोरकेदा, ओनको मिमित् होड़ ञुतुमते दान आ़उरि सामाङोक् हा़बिच्।<verse eid="ACT 21:26" /></para>
  <para style="s">कोयजोङ ओड़ाक्‌रे पावले साप् ओचोयेन</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />आर ओनाको एयाय दिन पुरा़उक् ला़गिदोक्‌कान ताहेंकानरे, आ़सिया़रेन जिहुदिको दो कोयजोङ ओड़ाक्‌रे पावलको ञेलकेदे खान, जोतो गादेल होड़को आ़उला़उकेत्‌कोवा, आर उनिरे हातको लागावकेदा, नोनका होहोवाते, <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />“ए इसराएल होड़को गोड़ोंवाबोनपे हों, नुय कानगेयाय उनि होड़ दो ओने उनि आबोरेन होड़को आर आ़न आर नोवा ठा़ँइ उपा़रते गोटा टा़न्डि सानामकोय चेत्आकोकान, आर ओना छाडा जुना़निको हों कोयजोङ ओड़ाक्‌रेये आदेरलेत्‌कोते नोवा सोनोत ठा़ँये भोंडआकादा।” <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" />(लाहारे एनते ओनको दो उनि तुलुच्‌ नागराहारे एफेसिरेन तरोफिमुसको ञेललेदेया आरको बुजहा़वेत् ताहेंकाना, पावल दो उनि कोयजोङ ओड़ाक्‌तेये आ़गु आदेरलेदेया मेनते)<note caller="+" style="x"><char style="xo" closed="false">21:29 </char><char style="xt" closed="false"><ref loc="ACT 20:4">आ का़ २०:४</ref></char></note><verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />आर गोटा नागराहा गुलमालावेना, आर होड़को ञिर जारवायेना, आर पावलको साप्‌केदेते कोयजोङ ओड़ाक्‌ खोनको ओर ओडोक केदेया, आर साटमेनते दुवा़रकोको सिञकादा। <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />आर उनिको गोजे ला़गिदोक्‌कान ताहेंकानरे पालटोन खातारेन माराङ सुबेदार दो खोबोर सेटेरादेया, गोटा जेरुसालेम आ़उला़उ आकाना मेनते। <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />खानगे उनि दो इना़ तापतेगे पालटोनको आर सुबेदारकोवानते ओनको ठेने ञिर सेनएना, आदो माराङ सुबेदार आर पालटोनकोको ञेलकेत्‌को खान पावल दादालको थिरेना।<verse eid="ACT 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 21:33" />खानगे माराङ सुबेदार दो सेन सोरकातेे उनिये गिरिपतारकेदेया, आर बारया सिकड़िते तोलेये हुकुमकेदा, आरे कुलिआना, “ओकोय कानाय आर चेत्ए चेकावाकादा” मेनते। <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />आर गादेल होड़को मोदरेन आदोम दो मित् लेकाको होहोयेत् ताहेंकाना, आदोम दो एटाक्‌ लेका, आदो गुलमाल इया़ते खा़टितेत् बाय बाडाय ञाम दाड़ेयात् खाने हुकुमकेदा, जेमोन पालटोन गाड़तेये इदि ओचोक्। <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />आर सिड़हिको ठेने सेटेरेन खान पालटोनको होतेते गोक्‌ ओचोक् होयेनताया, गादेल होड़कोवाक् जुलुम इया़ते; <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />एनते गादेल होड़ दो पाँजा पाँजातेको होहो आ़गुयेत् ताहेंकाना, “गोच् गिडिकायमे नुय दो।”<verse eid="ACT 21:36" /></para>
  <para style="s">गादेल होड़को तालारे पावलाक् नेहोंर काथा</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />आर पालटोन गाड़तेको आदेरे ला़गिदोक्‌कान ताहेंकानरे, पावल दो माराङ सुबेदारे मेतादेया, “आम तुलुच्‌ मित्‌टेन काथाञ रोड़केया?” आदोए मेनकेदा, “जुना़नि पा़रसिम बाडाया? <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />एनडेखान उनि मिसरि दोम बाङ काना, ओने उनि नोवाको दिन लाहारे हुलकाते डा़कुको मोदरेन पोन हाजार होड़ हाहाङकारतेये इदिकेत्‌को?”<verse eid="ACT 21:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39" />मेनखान पावले मेनकेदा, “इञ दो ता़रसुसरेन जिहुदि होड़ का़ना़ञ, किलिकिया़ रेयाक्‌ मित्‌टेच् नामडाक नागराहारेनगे, आर इञ नेहोंराम काना, नोको होड़ गालमारावाको ला़गित्‌ आड़ाक्आञमे।”<verse eid="ACT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40" />आदोए आड़ाक्आदे खान, पावल दो सिड़हिरे तेङगोकाते होड़को तितेये इसा़रावात्‌कोवा, आर आ़डि थिर ठिककाते, इबरि पा़रसितेये गालमारावात्‌कोवा।<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />ए बोयहाको आर बाबाको, “नितोक् आपे ठेनिञ रोड़ दोगोक्‌ कानाक् आँजोमतिञपे।”<verse eid="ACT 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 22:2" />आर इबरि पा़रसितेये गालमारावाकोकानको आँजोमकेदे खान, आरतेत्‌गेको थिरेना; आदोए मेनकेदा,<verse eid="ACT 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3" />इञ दो जिहुदि होड़ का़ना़ञ, किलिकिया़ रेयाक्‌ ता़रसुसरेञ जानामलेना, मेनखान नोवा नागराहारेञ आ़सुल हारावाकाना, गामालिएलाक् जाङगा ठेन, हापड़ामकोवाक् आ़न काजाकते सेनाक् इञ चेत् ओचोलेना, इसोर ञुतुमते आँटोक्‌इच्‌ इञ ताहेंकाना, चेत् लेका तेहेञ दिन आपे होंपे आँटोक् कान। <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" />आर नोवा होररेनकोञ खेदलेत्‌कोवा, गुजुक् हा़बिच्‌गे हेरेल हों आर मायजिउको हों तोलकेत्‌कोते हाजोतरेञ जिमा़कात्‌कोवा। <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />ओना रेयाङ मा माराङ नायके, आर गोटा मुरुबिको बा़इसिरेनको होंको गोहा दाड़ेयाक्‌, ओने ओनको खोनगे बोयहाको ला़गित्‌ चिठिकोञ ञामलेत् दामेसेकतेञ चालाक्‌कान ताहेंकाना, ओंडेनको हों तोलकाते जेरुसालेमते आ़गुको ला़गित्‌, जेमोनको सा़जा़इ ओचोक्।<verse eid="ACT 22:5" /></para>
  <para style="s">पावल आयाक्‌ मोन आ़चुरोक् रेयाङे ला़इयेदा</para>
  <para style="r">(<ref loc="ACT 9:1-19">आपोस का़मि ९:१-१९</ref>; <ref loc="ACT 26:12-18">२६:१२-१८</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />आदो नोनका होयेना, चालाक् चालाक्‌ते दामेसेकइञ सोरोक्‌कान ताहेंकानरे, तिकिन जोखेच् आचकागे सेरमा खोन मित्‌टेच् माराङ मारसाल इञ बेड़हायते बामबेरएना। <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />आर ओतरेञ भिनदा़ड़गोत् एनते मित्‌टेच् आड़ाङ मेता़ञकान इञ आँजोमकेदा, ए सा़उल, ए सा़उल, चाक्‌एम खेदेञकाना? <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />आदोञ रोड़ रुवा़ड़केदा, ए प्रोभु, आम दोम ओकोय काना? उनि दोए मेतादिञा, इञ दो नासारेतरेन जिसुगे, ओने आमेम खेदेञकान। <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />आर इञ साँवते ताहेंकानको दो मारसाल ञेल माको ञेललेत्‌गे, मेनखान इञे गालमारावादिञिच् रेयाक्‌ आड़ाङ दो बाको आँजोमलाक्आ। <verse eid="ACT 22:9" /><verse number="10" style="v" sid="ACT 22:10" />आदोञ मेनकेदा, ए प्रोभु, चेत् इञ चेकाया? खानगे प्रोभु दोए मेतादिञा, मा बेरेत्‌काते दामेसेकते चालाक्‌मे, आर ओंडेगे सानामाक्एम ला़इ ओचोक्आ, ओने ओनाकोम का़मिया मेनते निट आकावात्‌मे। <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />आर ओना मारसाल रेयाक्‌ ठोनोक इया़ते बा़ञ ञेञेलकान ताहेंकानते इञ सोङगेतेनकोको तिया़क् इदिकेदिञते दामेसेकरेञ सेटेरेना।<verse eid="ACT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12" />आर आनानिया़स मित् होड़, आ़न लेकाते इसोर भोकति होड़गे, ओने उनि ओंडे गिरा़बास आकान सानाम जिहुदिको ठेन भागे ञुतुम ताहेंकानताय। <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />उनि दो इञ ठेने हेच्एना, आर इञ सोररे तेङगोकातेये मेतादिञा, ए बोयहा सा़उल, मा ञेञेलमे। आर इना़ घा़ड़िच्‌तेगेञ बेङगेत्आदेया, <verse eid="ACT 22:13" /><verse number="14" style="v" sid="ACT 22:14" />खानगे उनि दोए मेनकेदा, आबोरेन हापड़ामकोरेन इसोर दो आमे बाछाव आकात्‌मेया, जेमोन उनियाक् मोनेम बाडाय आर भा़क्‌ला़यिच्एम ञेले, आर उनियाक् मोचा खोन आड़ाङेम आँजोमताय। <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />एनते उनि ला़गित्‌ सानाम होड़को सामाङरे जिसु बाबोतरे आमेम ञेल आरेम आँजोमाकात्‌आक्‌को रेयाक्‌ गोहाम होयोक्‌आ। <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />आर नितोक् दो चेत्एम बिला़मेदा? मा बेरेत्‌ते बा़प्‌तिस ओचोक्‌मे, आर आमाक् का़इको आ़रुप् गिडिताम, उनियाक् ञुतुम दोहायाक्‌ते।<verse eid="ACT 22:16" /></para>
  <para style="s">जिहुदि बाहरेरेनको पोरचाराको ला़गित्‌ पावले होहो ओचोक्‌कान</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />आर नोनका होयेना जेरुसालेमतेञ रुवा़ड़ेनते कोयजोङ ओड़ाक्‌रे कोयजोङकान ताहेंकानरे दोरसोन दोसारेञ पाड़ावेना। <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />आर मेता़ञकान इञ आँजोम केदेया, मा उसा़रायमे आर जेरुसालेम खोन ओडोक होदोक्‌मे, एनते ओनको दो इञ रेयाङ आमाक् गोहा दो बाको आङगोचा। <verse eid="ACT 22:18" /><verse number="19" style="v" sid="ACT 22:19" />आदोञ मेनकेदा, ए प्रोभु, आकोको बाडाया, इञ दो आमरे पा़तिया़उक्‌कोञ दाल हाजोतेत्‌को आर मिमित् सुना़गोगरे ओनकोञ दाल उर ओचोयेत्‌को ताहेंकाना। <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />आर आमरेन गोहा इस्टिफानाक् माँयाँम जोरो ओचोयेनरे, इञ हों ओंडेञ तेङगोवाकान ताहेंकाना, आर ओनारे रा़जिगेञ ताहेंकाना। आर उनि गोगोच्‌कोवाक् किचरिच्‌कोञ होरहोवाकात् ताहेंकाना। <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />खानगे उनि दोए मेतादिञा, दो चालाक्‌मे, एनते इञ दो आ़डि सा़ङगिञ जिहुदि बाहरेरेनको ठेनिञ कोलमेया।<verse eid="ACT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />आर ओना काथा हा़बिच्‌को आँजोम इदिकेत्‌ताया, खानगे आँटते होहोवातेको मेनकेदा, धा़रति खोन ओचोक् गिडिकायपे नोनकानिच्‌ दो एनते जिवेत्ए ताहेन लेक दोए बाङ काना। <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />आर ओनको दोको रा़गा़उ रा़गा़वेत् ताहेंकाना आर आकोवाक्‌ किचरिच्‌कोको चापात् गिडियेत् आर चोटते धुड़िको उडिया़वेत् ताहेंकाना <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />खान माराङ सुबेदार दोए हुकुमकेदा, पालटोन गाड़तेये आदेर ओचोक् आर चा़रना़वेतेये पुछा़र ओचोक्आ मेनते, जेमोने बाडाय दाड़ेयाक्, चेत् कारोनते उनि बिरुदरे ओनकोको होहोयेत् ताहेंकाना। <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />मेनखान चा़रना़वे ला़गित्‌को तोलेकान ताहेंकानरे पावल दो सोररे तेङगोवाकान सुबेदारे मेतादेया, रोमि होड़ बिन बिचा़र दुसिते चा़रना़वे रेयाक्‌ हुकुम मेनाक्‌तापेया?<verse eid="ACT 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26" />आदो सुबेदार ओनाय आँजोमकेत् खान माराङ सुबेदार ठेन सेनेनते ओना ला़इयादेतेये मेतादेया, चेत्एम चेकाय ला़गिदोक्‌काना? नुय होड़ माय रोमिकान चोङ।<verse eid="ACT 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27" />खान माराङ सुबेदार दो उनि ठेन हेच् एनतेये मेतादेया, “ला़इया़ञमे, रोमि कानाम?” आर उनि दोए मेनकेदा, “हें कानगेया़ञ”<verse eid="ACT 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28" />खानगे माराङ सुबेदारे रोड़ रुवा़ड़केदा, “इञ दो आ़डि उता़र टाका एमकाते नोवा पोरजा होक इञ ञाम आकावाना।” आदो पावले रोड़ रुवा़ड़केदा, “मेनखान इञ दो जानामते रोमरेन पोरजा का़ना़ञ।” <verse eid="ACT 22:28" /><verse number="29" style="v" sid="ACT 22:29" />खानगे चा़रना़वेते पुछा़रे ला़गिदोक्‌कानको दो साटमेनतेको इका़कादेया, आर माराङ सुबेदार होंए बोतोरेना, रोमि कानायमेनतेये बाडायकेत्‌ते आर उनिये तोल ओचोवाकादे ताहेंकान इया़ते।<verse eid="ACT 22:29" /></para>
  <para style="s">पावल माराङ बा़इसि सामाङरे</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />मेनखान दोसार हिलोक् दो जिहुदिको चेत् रेयाक्‌को बोहोक्एदेया, ओना रेयाक्‌ खा़टितेत्‌ बाडाय ञाम ला़गित्‌ए मोनेयानते पावले राड़ाकेदेया, आर माराङ नायकेको आर गोटा माराङ बा़इसिरेनको हेच् जारवाक्ए हुकुमात्‌कोवा आर पावल फेड इदिकेदेते ओनको सामाङरेये तेङगोकेदेया।<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />आर पावल दो माराङ बा़इसिरेनको सेच् बेङगेत् उरिच्‌कातेये मेनकेदा, “ए बोयहाको, इञ दो सानाम लेकाते नापाय इसोर सामाङरे भागे साँवबाक्‌डायतेञ चोलोन आ़गुवाकादा।” <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />आदो माराङ नायके आनानिया़स दो सोररे तेङगोवाकानकोय हुकुमात्‌कोवा, मोचारे थापाये ला़गित्‌। <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />खानगे पावल दो उनिये मेतादेया, इसोर दो आमे थापामेया, ए आम पोताव आकात् भित। आम दोम दुड़ुप्‌ आकाना, आ़न लेकाते बिचा़रिञ ला़गित्‌, आर आ़न बेबाक्‌तावते उलटा़वेम हुकुमेदा थापा ओचोञ ला़गित्‌?<note caller="+" style="x"><char style="xo" closed="false">23:3 </char><char style="xt" closed="false"><ref loc="MAT 23:27-28">माथ २३:२७-२८</ref></char></note><verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />आदो सोररे तेङगोवाकानकोको मेनकेदा, “इसोररेन माराङ नायकेयेम बेमानोतायकाना?”<verse eid="ACT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5" />आदो पावले मेनकेदा, बा़ञ बाडायलाक्आ, बोयहा माराङ नायके कानाय मेनते दो एनते ओल आकाना, आम जा़तरेन जाहाँय मुखिया़ रेयाङ बा़ड़िच् दो आलोम रोड़ा।<note caller="+" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="EXO 22:28">एकसो २२:२८</ref> </char></note><verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />मेनखान पावले बाडायकेत् खान, मित् दोल दो सा़दुकिको, आर एटाक् दोल दो फा़रिसिको कानाको मेनते, माराङ बा़इसिरे होहोवातेये मेनकेदा, “ए बोयहाको इञ दो फा़रिसि होड़ का़ना़ञ, फा़रिसिकोरेन होपोनगे, आर गोच्‌को खोन जिवेत् बेरेदोक् रेयाङ आस इया़ते इञ दोञ बिचा़र ओचोक्‌आकाना।”<note caller="+" style="x"><char style="xo" closed="false">23:6 </char><char style="xt" closed="false"><ref loc="ACT 26:5">आ का़ २६:५</ref>; <ref loc="PHP 3:5">फिलि ३:५</ref></char></note><verse eid="ACT 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7" />आदो नोवाए रोड़केत् खान फा़रिसिको आर सा़दुकिको तालारे रेटेपेटे जानामेनते बा़इसिरेनको दोको बार हा़टिञेना। <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />एनते सा़दुकिको दोको मेना जिवेत् बेरेदोक् हों बा़नुक्आनाङ, आर दुत आर जिउको हों बा़नुक्‌कोवा, मेनखान फा़रिसिको दो नोवा जोतोगेको आङगोचा।<note caller="+" style="x"><char style="xo" closed="false">23:8 </char><char style="xt" closed="false"><ref loc="MAT 22:23">माथ २२:२३</ref>; <ref loc="MRK 12:18">मा़र १२:१८</ref>; <ref loc="LUK 20:27">लु २०:२७</ref> </char></note> <verse eid="ACT 23:8" /><verse number="9" style="v" sid="ACT 23:9" />मेनखान आ़डि माराङ गुलमाल होयेना, आर फा़रिसिको दोलरेन आदोम आदोम सोसतोर बाडायको तेङगोयेनतेको रापठा रा़पठियेना, मेनकेदाको, “चेत् बा़ड़िच् हों बाले ञामेदा, उनि होड़रे दो, मित्‌टेन जिउ से दुतगेये गालमारावादे खान, आदो चेत्?”<verse eid="ACT 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10" />आदो रोपोड़ झोगोड़ आँट इदियेन खान माराङ सुबेदार दो पावलको ओर चिरा़ बोतेच्‌के बोतोरते पालटोनकोय हुकुमात्‌कोवा, जेमोन फेड चालाक्‌ते ओनको ताला खोन उनिको रेच् आ़तकिरे आर पालटोन गाड़तेको इदिये।<verse eid="ACT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11" />आर एन हिलोक् ञिंदा़ प्रोभु दो उनि ठेन तेङगोयेनतेये मेतादेया, दिल जोङमे, एनते जेरुसालेमरे इञ रेयाङ गोहाम एम आकात् लेका, रोमरे हों गोहा एमोक् होयोक्‌तामा।<verse eid="ACT 23:11" /></para>
  <para style="s">पावल गोजे रेयाक्‌ पोन्‌था</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />आर सिञ मारसालेन खान जिहुदिको दोको मिलिमिसिया़वाना, आर एकराड़ेनतेको सारापाना, जोम हों बाको जोमा आर ञु हों बाको ञुया, पावल आ़उरिको गोजे हा़बिच्। <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />आर ओनको दो पोनगेल खोन बाड़तिको ताहेंकाना, ओने ओनको बा़ड़िच् पोन्‌था साजावरेको ताहेंकान। <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />आर ओनको दो माराङ नायकेको आर मुरुबिको ठेन चालावेनतेको मेनकेदा, आले दो आपनारतेगेले साराप आकावाना, चेत् हों बाले चेकाया, पावल आ़उरिले गोजे हा़बिच्। <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />ओना इया़ते नितोक् आपे दो माराङ बा़इसिरेनको लागायते माराङ सुबेदार दोहायायपे, जेमोन आपे ठेने आ़गुये, आच् काथाय उनि रेयाङ आरतेत् बेस ओकोच्‌तेपे बिचा़र छिन्‌डा़उ ला़गित्‌, आर आले दो उनि आ़उरिये सेटेरोक्‌रेगे गोजे ला़गित्‌ तेयार मेनाक्‌लेगेया।<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />मेनखान पावल भा़गना़ततेत् दो ओनकोको ताँड़ाँगोक्‌ रेयाक्‌ए आँजोम ञामकेदा, आर सेनकाते पालटोन गाड़ते बोलोयेनते पावले ला़इयादेया। <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />खानगे पावल दो मित्‌टेन सुबेदार होहो सोरकेदेतेये मेतादेया, नुय कोड़ा दो माराङ सुबेदार ठेन इदियेम, एनते चेत् काथा चोङ ला़इयाय रेयाक्‌ मेनाक्‌ताया। <verse eid="ACT 23:17" /><verse number="18" style="v" sid="ACT 23:18" />आदो उनि सोङगेकेदेते माराङ सुबेदार ठेने इदि केदेया, आरे मेनकेदा, हाजोतिच् पावल दो आच् ठेन होहोवादेतेये खोजकेदा, नुय कोड़ा आम ठेनिञ आ़गुया मेनते, चेत् काथा चोङ ला़इयाम ला़गित्‌ मेनाक्‌तायते।<verse eid="ACT 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19" />खान माराङ सुबेदार दो उनियाक् ति साप्‌काते एसकाररेये इदिकेदेतेये कुलि केदेया, चेत् काथा मेनाक्‌तामा, ला़इया़ञ ला़गित्‌?<verse eid="ACT 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20" />आदोए मेनकेदा, जिहुदिको दोको रिया़उ मित् आकाना नेहोंराम ला़गित्‌ जेमोन गापा पावल दो माराङ बा़इसिते ओनको ठेनेम इदिये, उनि रेयाक्‌ आरतेत्‌ बेस ओकोच्‌तेम कुलिजोङ ला़गित्‌। <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />आम दो आलोम रा़मजा़उक्‌आ, एनते ओनको मोदरेन पोनगेल खोन बाड़ति होड़को ताँड़ाँक्आय काना, ओने ओनको आपनारतेको सापड़ावाकाना, जोम हों आलोको जोम, आर ञु हों आलोको ञुयमा, उनि आ़उरिको गोजे हा़बिच्, आर नितोक् दोको सापड़ावगेया, एकेन आम ठेन खोन काथाको ञेल होहोरकाना।<verse eid="ACT 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22" />आदो माराङ सुबेदार उनि कोड़ा बिदा़केदेतेये का़जिया़ँउकादेया, ओकोय हों आलोम ला़इयाकोवा नोवाकोम ला़इ सोदोर आकावादिञा मेनते।<verse eid="ACT 23:22" /></para>
  <para style="s">पावल का़इसा़रिया़तेको इदिकेदे</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />आर सुबेदारको मोदरेन बार होड़ होहो सोरकेत्‌किनतेये मेतात्‌किना, बार साय पालटोन तेयारकोबेन का़इसा़रिया़ हा़बिच् चालाक्आ मेनते आर एयायगेल आसवारिको, आर बार साय बोरलोमानको, ञिंदा़ रेयाक्‌ आरे बाजा ओकतेरे, <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />आर सादोमको तेयारकाको ला़गित्‌ए मेतात्‌किना, जेमोन पावलको देच् इदियेते दिसा़म चाक्‌लाविच् फेलिक्‌स ठेनको बाञचाव सेटेरकाय, <verse eid="ACT 23:24" /><verse number="25" style="v" sid="ACT 23:25" />आर नोक्‌ओंय नोनकान मित्‌टेच् चिठिये ओलकेदा।<verse eid="ACT 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 23:26" />कलोउडियोस लुसियोस ठेन खोन आ़डि मानोतान फेलिक्‌स दिसा़म चाक्‌लाविच् ला़गित्‌, जोहार। <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />नुय होड़ दो जिहुदिको साप्‌लेदेया, आरको गोजे ला़गिदोक्‌कान ताहेंकाना, खान इञ दो पालटोनको सालाक्‌ सेन होत् एनतेञ रुखिया़केदेया, रोमि होड़ कानाय मेनतेञ बाडायकेत्‌ते। <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />आर ओकाटाक् इया़तेको बोहोक्‌एदेया, ओना रेयाङ कारोन बाक्‌डाय इञ मेनवानते ओनकोवाक् माराङ बा़इसितेञ इदि केदेया। <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />आर इञ बुजहा़उ ञामकेदा आकोवाक् आ़न रेयाक्‌ रेटेपेटे बाबोतरेको बोहोक्एदेया मेनते, मेनखान गोजे से तोले लेक दो बाको बोहोक्‌लेदेया। <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />मेनखान उनि होड़ उपा़रते बा़ड़िच् पोन्‌थाको बेनावकेदा मेनतेको सोदोरादिञ खान, इना़ तापतेगे आम ठेनिञ कोल गोत्‌कादेया, आर बा़दिको होंञ हुकुमात्‌कोवा, आम सामाङरे उनि उपा़रते मेनाक्‌ताकोवाक्‌को रोड़ा मेनते।<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />आदो पालटोनको दो हुकुमात्‌को ताहेंकान लेका, पावल इदितोराकेदेते ञिंदा़गे आनटिपाटरिसतेको सेटेरकेदेया। <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />मेनखान दोसार हिलोक् दो आसवारिकोगे उनि सोङगेतेको सेन इदि ओचोवात्‌कोवा, आर आरको दो पालटोन गाड़तेको रुवा़ड़ेना। <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />आर ओनको दो का़इसा़रिया़रे सेटेरकाते दिसा़म चाक्‌लाविच् ओना चिठि एमायते पावल हों उनि सामाङरेको हा़जिरकेदेया। <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />आदो पाड़हावकेत् खान, ओका दिसा़मरेन कानाय मेनतेये कुलि केदेया, आदो किलिकिया़रेन कानाय मेनतेये चेत्‌केत् खाने मेनकेदा, <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />आमरेन बा़दि होंको हेच्‌लेन खान इञ आँजोमतामा, आर हेरोद रेयाक्‌ दोलानरेको होरहोयेया मेनतेये हुकुमकेदा।<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s">पावल बिरुदरे मुद्दा़</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />आदो मोंड़ें माँहाँ तायोमते माराङ नायके आनानिया़स दो आदोम आदोम मुरुबिको, आर मित्‌टेन उकिल तेरतुलुस सोङगेकाते का़इसा़रियातेये हेच्एना। आर ओनको दो पावल उपा़रते दिसा़म चाक्‌लाविच ठेनको दा़रसा़उकेत्आ।<verse eid="ACT 24:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 24:2" />आदो पावलको होहोवादे खान तेरतुलुस दो नोनका मेनकाते दुहमा़ते एहोप्‌केदा, आम होतेते आ़डि निरा़इले ञामेदा, आर नोको जा़तरेनको ला़गित्‌ आमाक् दोहायते आ़डि लेकान बा़ड़िच्आक्‌को खोनको सुधा़र ओचोक्‌काना। <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />ओना दो सानाम ओकते आर गोटा टा़न्‌डिगेले आङगोचेदा, “ए आ़डि मानोतान फेलिक्‌स, आ़डि गुन मानाव जोहार।” <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />मेनखान जेमोन बा़ड़ति आलोञ आ़उझा़ड़मे, नेहोंराम काना़ञ, जिवि हाताड़काते मित्‌ बार काथाम आँजोमताले। <verse eid="ACT 24:4" /><verse number="5" style="v" sid="ACT 24:5" />एनते नुय होड़ दो मित्‌टेन भिक्‌ङगड़ा़उ होड़ कानाय मेनतेले बाडाय ञाम केदेया, आर गोटा धा़रतिरे सानाम जिहुदिको तालारे मित्‌टेच् हुलमाल सिसिरजा़विच्, आर नासारिया़ सिकना़त दोलरेन आ़क्‌युरिच्‌गे। <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />उनि दो कोयजोङ ओड़ाक्‌ भोंडे मेनवान ताहेंकाना, आदोले साप्‌ केदेया। <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />मेनखान माराङ सुबेदार लुसियोस दोए हेच्एना, आर आलेयाक् ति खोन जोबोरगेये ओडोक इदि केदेया। <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />जुदि उनिगेम कुलिले खान, नोवाको सानामाक्एम बाडाय दाड़ेकेया, ओने ओकाको रेयाक्‌ ले बोहोक्एदेकान। <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />जिहुदिको दो उनियाक् काथाको सुहियादा आर ओनका कानगेया मेनतेको मेनकेदा।<verse eid="ACT 24:9" /></para>
  <para style="s">फेलिक्‌स सामाङरे पावलाक् रोड़ दोगोक्‌</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />आर दिसा़म चाक्‌लाविच् दो रोड़ा मेनतेये इसा़रावादे खान, पावल दो रोड़ रुवा़ड़केत्‌तेये मेनकेदा। ढेर सेरमा खोन नोको जा़तरेनको ला़गित्‌ बिक्‌चा़रिच्एम ताहें हेच् आकान इञ बाडायेत्‌ते, हिया़ खालासकातेञ रोड़ दोगोक्‌ काना। <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />एनते आमेम बाडाय ञाम दाड़ेयाक्आ, जे गेलबार दिन खोन बा़ड़ति दो बा़ञ होयोक्‌काना, इञ दो सेवा ला़गित्‌ जेरुसालेमतेञ राकाप् सेनलेना। <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />आर जिहुदिको दो कोयजोङ ओड़ाक्‌रे जाहाँय तुलुच्‌ आपठा आ़पठिक्‌कान से गादेल होड़ आ़उला़वेत्‌को बाको ञामलेदिञा, सुना़गोगरे हों बाङ, आर नागराहारे हों बाङ। <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />आर ओनाको दो सा़बुत हों बाको सा़बुत दाड़ेयामा, ओने ओकाको रेयाक्‌को बोहोक्एदिञकान <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />मेनखान नोवा दो आम ठेनिञ आङगोचेदा, जे ओना होर लेकाते, ओने ओकाटाक् सिकना़त दोलको मेताक्‌कान, ओना लेकाते हापड़ामकोरेन इसोर इञ सेवावायकान, आ़न लेकातेयाक्‌को आर ना़बिकोवाक्‌कोरे ओलआकान सानामाक्‌कोरेञ पा़तिया़उक्‌कानते। <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />इसोररे आस मेनाक्‌तिञते, ओने ओना नोको आको होंको ञेल होहोरकान, मेताक्‌मे बोगे आर बा़ड़िच्‌को होंको जिवेत् बेरेदोक्‌आ हापेन। <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />ओनाते होंञ कुरुमुटुएदा जेमोन इसोर आर मानवाको सेच् सिञ सा़टुप् इञाक् साफा साँवबाक्‌डायाक् दो बिन ता़क्‌किच्आक्‌गे ताहेनतिञ। <verse eid="ACT 24:16" /><verse number="17" style="v" sid="ACT 24:17" />आदो ढेर सेरमा तायोम इञ जा़तरेनको ला़गित्‌ एमाक् दान आ़क्‌गुञ हेच्‌लेना, आर सामाङाक्‌को हों।<note caller="+" style="x"><char style="xo" closed="false">24:17 </char><char style="xt" closed="false"><ref loc="ACT 21:17-28">आ का़ २१:१७-२८</ref> </char></note> <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />आदो ओनको सेलेत् कोयजोङ ओड़ाक्‌रे पुरुछुनकानको ञामकेदिञा, गादेल होड़ानते हों बाङ आर हुलमालाते हों बाङ। <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />मेनखान आ़सिया़रेन आदोम आदोम जिहुदिको ताहेंकाना, ओने ओनको नोंडे आम सामाङरे हा़जिरोक् आर बोहोगिञ लेकताको, इञ उपा़रते जाहानाक् मेनाक्‌ताको खान। <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />से नोको आकोगेको मेनमा, माराङ बा़इसि सामाङरेञ तेङगोलेन जोखेच् इञरे चेत् दोसको ञामलाक्आ। <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />निया़ मित्‌टेन काथा छाडा, ओने ओनको तालारे तेङगोकाते होहोवातेञ मेनलेत्, बाङमा गोच्‌को रेयाक्‌ जिवेत् बेरेदोक् बाबोतरे तेहेञ दिन आपे सामाङरेञ बिचा़र ओचोक्‌काना।<note caller="+" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="ACT 23:6">आ का़ २३:६</ref></char></note><verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />मेनखान फेलिक्‌स दो ओना होरते रेयाक्‌ बेस ओकोच्‌तेये बाडायकान ताहेंकानते दिने ठेलावकेत्‌ताकोवा, नोवा मेनकाते, लुसियोस माराङ सुबेदारे हेच्‌लेनरेगे आपेयाक् दोञ छिन्‌डा़उतापेया। <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />आर सुबेदारे हुकुमादेया, जेमोन पावले होरहोये आर थोड़ा आवसान माछाये दोहोये, आर जेमोन उनिरेन जाहाँयगे साप्‌सोराय ला़गित्‌ आलोय मानाको।<verse eid="ACT 24:23" /></para>
  <para style="s">पावल फेलिक्‌स आर द्रुसिला सामाङरे</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />मेनखान तिन दिन तायोमते चोङ फेलिक्‌स दोए हेच्एना, आच् ओड़ाक्‌ होड़ द्रुसिला़ साँवते, ओने उनि जिहुदिये ताहेंकान, आर पावले होहो आ़गु ओचोकेदेते मा़सि जिसुरे पा़तिया़उक् रेयाङे आँजोमकेत्‌ताया। <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />आर भा़क्‌ला़इ आर सामबड़ावक् आर दाराकान बिचा़र रेयाङे गालमारावेत् ताहेंकानरे, फेलिक्‌स दो बोतोरेनतेये रोड़ रुवा़ड़केदा, नितोक् दो मा सेन हाताड़ोक्‌मे। ओपसोर इञ ञामलेनरेञ होहोवामा नाहाँक्‌। <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />उनि दो आस होंए आसोक्‌कान ताहेंकाना, पावल दो टाकाय एमाया मेनते, ओना इया़ते आ़डि धाव उनि होहोवायते उनि तुलुच्ए गालमारावकान ताहेंकाना।<verse eid="ACT 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27" />मेनखान बार सेरमा दिन पुरा़वेन खान फेलिक्‌स बोदोलते पोरकियोस फेसतुसे बाहालेना, आर फेलिक्‌स दो जिहुदिको ठेन बा़सुत ओचोक् रेयाक्‌ मोने ताहेंकानतायते पावल तोलगेये बा़गि ओटोवादेया।<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s">पावल दो का़इसा़रे दोहायायकाना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />आदो फेसतुस ओना टोठारेये सेटेरेन खान, पे माँहाँ तायोम का़इसा़रिया़ खोन जेरुसालेमतेये राकाप् चालावेना। <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />आर माराङ नायकेको आर जिहुदिकोरेन आसोल होड़को दो पावल उपा़रतेको दा़रसा़उकेदा, <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />आर उनि उपा़रते कोयानतेको नेहोंरेना, जेमोन जेरुसालेमते उनिये आ़गु ओचोये। ओनको दो एनते होररे उनि गोजेया मेनते ताँड़ाँक्आयको निट आकावान ताहेंकाना। <verse eid="ACT 25:3" /><verse number="4" style="v" sid="ACT 25:4" />मेनखान फेसतुसे रोड़ रुवा़ड़केदा, बाङमा, पावल दो का़इसा़रिया़रेये हाजोतआकाना, आर आच् हों सोर दिन खानगे ओंडेये चालाक्आ। <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />ओना इया़ते मेनकेदाय, “आपे मोदरेन एकतिया़रियानको इञ सोङगेतेको चालाक्‌मा, आर उनि होड़रे जाहान बेठिकाक् मेनाक् खानको बोहोगेमा।”<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />आदो ओनको तालारे इरा़ल से गेल दिन गान ताहेंकाते का़इसा़रिया़तेये चालावेना। आर दोसार हिलोक् दो बिक्‌चा़र दुड़ुप्‌आक्‌रेये दुडुप्एनते पावल आ़गुये ला़गित्‌ए हुकुमकेदा। <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />आर उनिये हेच्एन खान, जेरुसालेम खोन हेच् आकान जिहुदिको उनि बेड़हायते तेङगो आ़चुरेनते आ़डि ओकोच् मुसकिल मुसकिलाक् का़सुरकोको बोहोक्‌केदेया, ओने ओनाको बाको सा़बुत दाड़ेयात्। <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />आर पावल दो रोड़ दोक्एनतेये मेनकेदा, बाङ दो जिहुदिकोवाक् आ़न रेयाक्‌, बाङ दो कोयजोङ ओड़ाक्‌ रेयाक्‌, आर बाङ दो का़इसा़र रेयाक्‌, चेत्‌गे बा़ञ का़सुरआकादा।<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />मेनखान फेसतुस दो जिहुदिको कुसि ओचोकोवा मेनकाते पावले रोड़ रुवा़ड़ादेया, जेरुसालेमते राकाप् सेनोक् सानायेत्‌मेया, ओंडे इञ सामाङरे नोवाको रेयाक्‌ बिचा़र ओचोक् ला़गित्‌?<verse eid="ACT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10" />मेनखान पावल दोए मेनकेदा, का़इसा़राक्‌ बिक्‌चा़र दुड़ुप्‌आक्‌ सामाङरेञ तेङगोवाकाना, नोंडेगेञ बिचा़र ओचोक्आ। जिहुदिको दो चेत् हों बा़ञ बेहोक आकात्‌कोवा, आर ओना दो आम हों बेस ओकोच्एम बाडाया। <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />आदो इञ बेहोक आकान खान, आर गोच्‌ ओचोक् लेक जाहानाक् इञ का़मिआकात् खान, आलोञ गोच्‌ ओचोक् दो बा़ञ खोजकाना, मेनखान नोकोको बेहोक एदिञकानाक्‌को दो चेत् हों बाङकान खान, एनडेखान ओकोय हों ओनको ठेन ओहोय जिमा़ दाड़ेलिञा। का़इसा़रगेञ दोहायाय काना।<verse eid="ACT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12" />खानगे फेसतुस दो बिचा़र गोक्‌ड़ोको तुलुच्‌ गालमारावकेत्‌तेये रोड़ रुवा़ड़ादेया, का़इसा़रेम दोहायाकावादेया; का़इसा़र ठेनगेम चालाक्आ।<verse eid="ACT 25:12" /></para>
  <para style="s">राजा आ़ग्रिप्‌पा आर बेरनिस सामाङरे पावल</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />आर थोड़ा दिन तायोमते आ़ग्रिप्‌पा राज आर बेरनिस दो का़इसा़रिया़रेकिन सेटेरेना फेसतुस ञापामे ला़गित्‌। <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />आर ढेर दिन ओंडेकिन ताहेंयेन खान फेसतुस दो पावल रेयाङ राज ला़इ तिया़क् आदेतेये मेनकेदा, मित्‌टेन होड़ मेनाया, फेलिक्‌स होतेते का़इदिये बा़गि ओटोआकान। <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />ओने उनि रेयाङ जेरुसालेमरेञ ताहेंकानरे जिहुदिकोरेन माराङ नायकेको आर मुरुबिकोको दा़रसा़उआदिञ आर उनि उपा़रते सा़जा़इ रेयाक्‌ हुकुमको कोयकेत्, <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />ओनको दोञ रोड़ रुवा़ड़ात्‌कोवा, जाहाँय होड़ सोपरोते रेयाक्‌ चा़लि दो रोमिकोवाक् बा़नुक् आनाङ बोहोक्एदियिच् आर बोहोक्‌को आ़उरिको सामकासा़टिक आर बोहोक्एदेयाक् रेयाङ रोड़ दोगोक्‌ ला़गित्‌ आ़त आ़उरिये ञाम हा़बिच्। <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />आर नोंडेको हेच्एन खान बेगोर दिन ठेलावते दोसार हिलोक्‌गे बिक्‌चा़र दुड़ुप्‌आक्‌रे दुड़ुप्‌एनतेञ हुकुमकेदा, पावल आ़गुये ला़गित्‌। <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />उनि रेयाङ दो बा़दिकोको तेङगोयेन खान, इञिञ ओहमालेत् लेकान बा़ड़िच्आक् दो चेत् हों बाको दुहमा़तलेदा, <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />मेनखान आकोवाक् देवा सेवा रेयाक्‌ उनि तुलुच्‌को रोपोड़कान ताहेंकाना। आर मित्‌टेन गोच्एन जिसु रेयाक्‌, ओने उनि रेयाङ पावल दो काजाकतेये मेनकेत्, जिवेत्‌गेयाय मेनते। <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />आदो नोवाको तोदारा़त रेयाक्‌ इञ आसबासावेन खानिञ कुलि केदेया, बाङ दो जेरुसालेमते सेनकाते ओंडे ओनाको रेयाङ बिचा़र ओचोया मेनते सानाको मेनाक्‌तापेया? <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />मेनखान पावल दो माहाराज ठेन बिचा़रोक् ला़गित्‌ होरहो दोहो ओचोक्ए दोहायकेत् खान, का़इसा़र ठेन आ़उरि कोले हा़बिच्‌ होरहो दोहोये इञ हुकुमकेदा।<verse eid="ACT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22" />खान आ़ग्रिप्‌पा दो फेसतुसे मेतादेया, “इञ हों उनि होड़ रेयाक्‌ दो आँजोम सानाएदिञा उनिये मेनकेदा, गापाम आँजोमताया।”<verse eid="ACT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />आदो दोसार हिलोक् आ़ग्रिप्‌पा आर बेरनिस दो आ़डि ठोसोक् साजकातेकिन हेच्एना, आर मुखिया़ सुबेदारको आर नागराहारेन आसोल होड़को तुलुच्‌ साभा ठा़ँइरेञ बोलोयेन खान फेसतुसे हुकुमकेत्‌ते पावलको आ़गु केदेया। <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />आर फेसतुसे मेनकेदा, ए आ़ग्रिप्‌पा राज आर नोंडे आले तुलुच्‌ मेनाक्‌पे सानाम होड़को उनि होड़को ञेले काना, नुय रेयाङ दो जोतो जिहुदिको जेरुसालेमरे आर नोंडे हों नोनका होहोवातेको आरदासआकात्आ, नुय आरदो जिवेत् ताहेन लेक दोए बाङ काना। <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />मेनखान इञ दोञ बुजहा़उ ञामकेदा, गोच्ओचोक्‌ लेक दो चेत् हों बाय का़मि आकादा मेनते, आर आच्‌गे माहाराजे दोहायायते कोल गोत्‌कायिञ निटकेदा। <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />नुय रेयाक्‌ आबोरेन मा़लिक ठेन ओल ला़गित्‌ खा़टियाक् दो चेत् हों बा़नुक्‌तिञा, ओना इया़ते आपे सामाङरेञ आ़गुवाकादा, आर आसोकायते आम सामाङरे ए आ़ग्रिप्‌पा राज, जेमोन कुलि बाड़ाकाते ओल ला़गित्‌ जाहानाक् इञ ञाम, <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />एनते का़इदि होड़ कोलकायरे उनि उपा़रते ला़लिस रेयाक्‌ कारोन बाङ उदुग दो इञ बुजहा़उरे बेबुजाक् काना।<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s">आ़ग्रिप्‍पा सामाङरे पावलाक् रोड़ दोगोक्‌</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />खानगे आ़ग्रिप्‌पा दो पावले मेतादेया, “आपनार रेयाङ रोरोड़ इञ आड़ाक् आम काना।” आदो पावल ति तिया़रकाते रोड़ दोगोक्‌ए एहोप् एना।<verse eid="ACT 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 26:2" />ए आ़ग्रिप्‌पा राज जिहुदिको ओकाकोको बोहोक् आकादिञा ओनाको रेयाङ तेहेञ आम सामाङरेञ रोड़ दोगोक्‌कानते भा़गान इञ बुजहा़उक् काना <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />ढेरकायते आम दो जिहुदिको रेयाङ सानाम चा़लिको आर रेटेपेटेक्‌आक्‌कोम बाडायकानते, ओनातेञ नेहोंराम काना जिवि हाताड़काते आँजोमकातिञमे बाड़े<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />जुवा़न जोखेच् खोन इञाक् चालचोलोन ओकाटाक् एतोहोप् खोन इञ जा़तरेनको तालारे आर जेरुसालेमरे ताहेंकानतिञ ओना दो सानाम जिहुदिकोको बाडायगेया। <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />पा़हिल खोन इञ रेयाक्‌को बाडाय आ़गुवाकात्‌आ, गोहा एमोक्‌को मेनले खान बाङमा, आलेयाक्‌ धोरोम रेयाक्‌ काजाक उता़र खुँट लेकाते फा़रिसि धोरोमरेञ चालचोलोनेत् ताहेंकाना।<note caller="+" style="x"><char style="xo" closed="false">26:5 </char><char style="xt" closed="false"><ref loc="ACT 23:6">आ का़ २३:६</ref>; <ref loc="PHP 3:5">फिलि ३:५</ref> </char></note> <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />आर नितोक् दो नोंडेञ तेङगोवाकाना आ़गिल हापड़ामको ठेन इसोररे गोक्‌लेत् रेयाक्‌ आस गुना़क्‌ते बिचा़र ओचोक्आ मेनते। <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />ओने ओना गोक्‌आक्‌गे आलेरेन गेलबार खुँटको दो सिञ ञिंदा़ दिला़मुंडते इसोर सेवावायते आकोरे पुरा़उक्‌को आसोक्‌कान ए राज, ओना आस रेयाङगे जिहुदिको दोको बोहोक् आकादिञा। <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />चेत् इया़ते बिन पा़तिया़उक् दोपे मेतात्‌काना, इसोर गोच्‌कोय जिवेत् बेरेत्‌एत्‌को खान?<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />इञ मा आपनार इञ बुजहा़उलेत् ताहेंकान बाङमा, नासारेतरेन जिसुवाक् ञुतुम उपा़रते आ़डि ओकोच् का़क्‌मिगे लेकतिञा।<note caller="+" style="x"><char style="xo" closed="false">26:9 </char><char style="xt" closed="false"><ref loc="ACT 8:3">आ का़ ८:३</ref>; <ref loc="ACT 22:4-5">२२:४-५</ref></char></note> <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />आर जेरुसालेमरे होंञ ओनकालेत्‌गेया, आर माराङ नायकेको ठेन एकतिया़रि ञामकाते सोनोतको मोदरेन आ़डि होड़ हाजोतकोरेञ काबहाड़लेत्‌कोवा, आर ओनकोको गोच्ओचोक्‌कान ताहेंकानरे हों रा़जिगेञ ताहेंकाना। <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />आर सानाम सुना़गोगकोरे आ़डि धाविञ सा़जा़इकेत्‌कोते जिसु रेयाङ हेनोसता रोड़ ओचोकोवा मेनतेञ जोरमोटेत्‌को ताहेंकाना, आर ओनको उपा़रते बेबा़ड़िच् बा़उला़हायेनते बिदेस रेयाक्‌ नागराहाको हा़बिच् सेनकातेञ खेदेत्‌को ताहेंकाना।<verse eid="ACT 26:11" /></para>
  <para style="s">पावल आयाक्‌ मोन आ़चुरोक् रेयाङे ला़इयेत्</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />आर ओना ला़गित्‌गे माराङ नायकेको ठेन खोन एकतिया़रि आर पारवानाआनते दामेसेकतेञ चालाक्‌कान ताहेंकानरे, <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />तिकिन जोखेच् होररे, ए राज सेरमा खोन मित्‌टेच् मारसाल इञ ञेलकेदा, सिञ चाँदो रेयाक्‌ खोन हों बा़ड़ति झाक झाकगे, इञ आर इञ सोङगेते चालाक्‌कानको बेड़हायते बाम्बेरेना। <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />आर आले सानामको ओतरेले भिनदा़ड़ेना खान, मित्‌गोटेन आड़ाङ इबरि पा़रसिते मेता़ञकान इञ आँजोमकेदा, “ए सा़उल, ए सा़उल, चेदाक्एम खेदेञ काना? आरजानरे फान्‌दाय दो आम ला़गित्‌ हाक्‌रोनाक्‌ काना।” <verse eid="ACT 26:14" /><verse number="15" style="v" sid="ACT 26:15" />आदोञ मेनकेदा, “ओकोय कानाम ए प्रोभु?” खानगे प्रोभु दोए मेनकेदा, “इञ दोञ जिसु काना, ओने आमेम खेदेञकान। <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />मेनखान बेरेत्‌मे आर आमाक् जाङगाते तेङगोनमे, एनते नोवा ला़गित्‌गे आम ठेनिञ ञेल ओचो आकाना, जेमोन गुति आर गोहा इञ बाछाव बाहालमे, ओनाको ला़गित्‌ ओनाको खा़तिरते आम ठेनिञ ञेल ओचोक् हापेन। <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />आरिञ रुखिया़मेया, आम जा़तरेनको खोन, आर जिहुदि बाहरेरेनको खोन हों, ओने ओनको ठेन होंञ कोलेत्‌मे, <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />ओनकोवाक् मेंत्‌ सा़ड़ ओचोयताको ला़गित्‌, जेमोन ञुत खोन मारसाल सेच्‌ सायतानाक् एकतिया़रि खोन इसोर सेच्‌को आ़चुरोक् जेमोन का़इ रेयाक्‌ इका़ इञरे पा़तिया़उक्‌ होतेते सोनोत ओचोवाकानको तालारे बाखराको ञाम।”<verse eid="ACT 26:18" /></para>
  <para style="s">पावल आयाक्‌ का़मि रेयाङे ला़इयेत्‌</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />ओनाते, ए आ़ग्रिप्‌पा राज सेरमा खोनाक् ओना ञेलाक् बेबाक्‌ताविच् दो बा़ञ होयलेना। <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />बिचकोम पा़हिलते दामेसेकरेनको आर जेरुसालेमरेनको, आर इना़ काते दो गोटा जिहुदा़ दिसा़मरेनको आर जिहुदि बाहरेरेनको होंञ ला़इ सा़डेयात्‌कोवा, जेमोन मोनको आ़चुर आर इसोर ठेनको रुवा़ड़ोक् आर मोन आ़चुर लेक का़मिकोको का़मिते। <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />ओनाको गुना़क्‌तेगे कोयजोङ ओड़ाक्‌रेञ ताहेंकानरे, जिहुदिको दो साप्‌केदिञते गोजेञको कुरुमुटुयेत् ताहेंकाना। <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />आदो इसोर ठेन खोन गोड़ोंञ ञामकेत्‌ते तेहेञ दिन हा़बिच् इञ तेङगोवाकाना, हुडिञ आर हापड़ाक्‌को गोहाञ एमाकोकान, बाङमा ना़बिको हों आर मोसे हों ओकाटाक् होयोक्‌गेया मेनतेको रोड़ाकात्, ओना छाडा एटागाक् दो चेत् हों बा़ञ रोड़ेदा। <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />एनकाथाय मा़सि दो दुक जोजोम होयोक्‌गेताया आर गोच्‌को खोन पा़हिलते जिवेत् बेरेत् आकानिच् हुया़ँते मारसाल ला़इ साक्‌डेयिच्ए होयोक्आ, जिहुदिको ला़गित्‌ हों आर जिहुदि बाहरेरेन होड़को ला़गित्‌ हों।<note caller="+" style="x"><char style="xo" closed="false">26:23 </char><char style="xt" closed="false"><ref loc="1CO 15:20">१ कोरि १५:२०</ref></char></note><verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />आदो उनि ओनकाए रोड़ दोगोक्‌कान ताहेंकानरे, फेसतुस दो आँट आड़ाङतेये मेनकेदा, “बा़उला़हा आकानाम, पावल आमाक् आ़डि उता़र बिदिया़तेम बा़उला़हा आकाना।”<verse eid="ACT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25" />मेनखान पावले मेनकेदा, “बा़ञ बा़उला़हा आकाना, ए मानोतान फेसतुस, मेनखान सा़रियाक् आर आकेल तेयाक् काथाकोगेञ रोड़ेदा। <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />एनते राज दो नोवाकोय बाडायगेया, आर उनि ठेन सोहोसातेगेञ रोड़ेत्‌आ। एनतेञ पा़तिया़उ आकाना नोवाको मोद खोन ओकाटाक् हों उनि खोन दो बाङ ओको आकाना मेनते, नोवा मा एनते कोचारे मा बाङ चोङ होयाकान। <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />ए आ़ग्रिप्‌पा राज ना़बिकोम पा़तिया़वाताको काना? इञिञ बाडाया पा़तिया़वाताको कानगेयाम मेनते।”<verse eid="ACT 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28" />खानगे आ़ग्रिप्‌पा दो पावले मेतादेया, “आर थोड़ागान ला़इतेगेम रा़मजा़उ ओचोकिञा क्रिसतानोक् ला़गित्‌?”<verse eid="ACT 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29" />आदो पावले मेनकेदा, “इसोर ठेनिञ कोयेदा जेमोन थोड़ातेत्‌रे हों से ढेरतेत्‌रे हों आम एसकार मोतो दो बाङ, बिचकोम तेहेञ दिनको आँजोमेत्‌तिञ सानामकोगे इञ लेकाको होयोक्‌मा, नोवा सिकड़ि छाडा।”<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />आदो राजे बेरेत्एना आर दिसा़म चाक्‌लाविच् आर बेरनिस आर ओनको साँवते दुड़ुप्‌लेनको हों। <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />आरको सा चालावेनते आको मोदरे गालमारावकातेको मेनकेदा, “नुय होड़ दो गोच् ओचोक् से तोल ओचोक्‌ लेक दो चेत् हों बाय चेकायेत्‌काना।” <verse eid="ACT 26:31" /><verse number="32" style="v" sid="ACT 26:32" />आर आ़ग्रिप्‌पा दो फेसतुसे मेतादेया, “नुय होड़ दोए आड़ाक् ओचो दाड़ेकोक्‌गेया, का़इसा़र आलोय दोहायाय खान होनाङ।”<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s">पावल रोमतेये इदिओचोक् कान</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />आदो इटा़लिया़ते जाहाजतेले चालाक्‌गे गोटायेन खान पावल आर आदोम एटाक् का़इदिको हों आ़गुसतुस पालटोन खातारेन जुलिया़स ञुतुमान सुबेदार ठेनको जिमा़कात्‌कोवा <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />आर आ़सिया़ ढिप ढिपतेयाक् जायगाकोते चालाक् ला़गिदोक्‌कान ताहेंकान आदरामुतियुम रेयाक्‌ मित्‌टेच् जाहाजरे देच्एनते जाहाजले लाड़ावकेदा, आर आ़रिसतारखुस ञुतुमानाक् थेस्‌सालोनिकिरेन मित्‌टेन मा़किदुनिया़रेन होड़ हों आले साँवतेये ताहेंकाना। <verse eid="ACT 27:2" /><verse number="3" style="v" sid="ACT 27:3" />आर दोसार हिलोक् दो सिदोनरेले तेङगोञोक्‌केदा, आर जुलिया़स दो पावल तुलुच् दाया सालाक्ए बेवहारकेत्‌ते गातेको ठेन चालाक्‌आ मेनतेये सेन ओचोवादेया जेमोन उनियाक् जा़रुड़ोक्‌आक्‌को गोड़ोंवाय। <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />आदो ओंडे खोन जाहाज लाड़ावकाते कुपरोस आड़े आड़ेतेले चालाव इदियेना, सानाम सेच् खोने होयेत् ताहेंकान इया़ते <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />आर किलिकिया़ आर पामफिलिया़ आड़े आड़ेतेयाक् जालापुरि पारोमकाते लुकिया़ आर मुरा़तेले सेटेरेना। <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />आर सुबेदार दो इटा़लिया़ते चालाक्‌कान आलेकसान्‌डेरिया़ रेयाक्‌ मित्‌टेच् जाहाज ओंडेये ञामकेत्‌ते ओनारेये देच्‌केत्‌लेया।<verse eid="ACT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 27:7" />आर ढेर दिन बा़इ बा़इतेले चालाव इदियेनते बेरिया़रे कनिदुस मुहा़ँमुहिंले सेटेरेन खान होय बाय सेन लाहा ओचोवात्‌लेते क्रेते आड़े आड़ेतेले चालाव इदियेना, सालमोने मुहा़ँमुहिंते। <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />आर बेरिया़रे ओना आड़े आड़ेते सेन इदियेनते भागे बोंदोरको मेताक् मित्‌टेच जायगातेले सेटेरेना, ओने ओना सोररे लासाया नागराहा ताहेंकाना।<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />आदो ढेर दिन खेमावेन, आर ओना जोखेच् जाहाजते दाड़ान दो मुहिन रेयाक्‌ ओकते ताहेंकानते उपा़स दिनको दो पारोम आकान ताहेंकाना, पावल दोए चेहावकेत्‌कोवा, <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />मेतात्‌कोवाय, ए हो इञिञ ञेलेदा, जाहाजते सेन इदि दो भाराभाट आर ढेर लोकसान रेयाक्‌गे होयोक्आ एकेन माल सामानको आर जाहाज रेयाक्‌ दो बाङ, मेनखान आबोवाक् जिवि ला़गित्‌ हों। <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />मेनखान सुबेदार दो पावले रोड़केत्आक्‌को खोन दो बिचकोम जाहाज चाक्‌लाविच् आर जाहाजरेन मा़लिक रेयाक्‌गे बा़ड़तिये पा़तिया़वात्‌ताकिना। <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />आर ओना बोंदोर दो राबाङ दिन टालाव ला़गित्‌ सुबिता बाङ ताहेंकानते, ढेर होड़ ओंडे खोन जाहाज चालाव मेनतेको साझाकेदा, जेमोन जाहाँलेकाकाते फोयनिकेते सेटेरकाते ओंडे राबाङ दिनको खेमाव। ओना दो क्रेते रेयाक्‌ बोंदोर काना आर दा़खिन पा़छिम आर उता़र पा़छिम सेच् सामाङाकाना।<verse eid="ACT 27:12" /></para>
  <para style="s">जालापुरिरे बिरबाँव</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />आर दा़खिन खोन हिसित् हिसित्ए होयकेत् खान आकोको आसआकान ताहेंकानाक्‌को ञामकेदा मेनते बुजहा़उकाते लोङगोर ओर राकाप्‌केत्‌ते क्रेते ढिप फेड फेडतेको चालाव इदिकेदा। <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />मेनखान थोड़ा तायोम खानगे एयोराकोलोनको मेताक् बिरबाँव ओत खोन राकाप् हेच्‌एना। <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />आर जाहाज दो आ़तकिर इदि ओचोयेन आर होय बाय सामबड़ाव दाड़ेयात् खानले आड़ाक्‌ गोत्‌कादा आरले डोयला़उ इदियेना। <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />आर का़उदा़को मेताक् मित्‌टेच हुडिञ टा़पु आड़ेरे सेनकाते आ़डि कोसटोते ला़उका़ले साप् टारहाव दाड़ेयादा। <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />आर ओनाको ओर राकाप्‌केत्‌ खान बाराहिकोको लागावकेत्‌ते लातार सेच् जाहाजको तोल आ़चुरकेदा, आर सुरतिस बा़लगादारे गा़डिया़उक् बोतोरते बादोमतेत् दोको राड़ा फेडकादा आर ओनकागेले डोयला़उ इदियेना। <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />आर बिरबाँवते आ़डि बा़ड़िच्‌ले हारोनोक्‌कान ताहेंकानते दोसार हिलोक् दो मालको ओडोक गिड़िकाक्‌को एहोप्‌केदा। <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />आर तेसार हिलोक् दो आको तिते जाहाज रेयाक्‌ साज सामान होंको चाडो गिडिकेदा। <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />आर ढेर दिन हा़बिच् सिञ चाँदो हों बाङ आर इपिलको हों बाङको ञेल ञामलेनते, आ़डि माराङ बिरबाँव लागावाकान ताहेंकानते सेसरे आले बाञचावक्‌ रेयाक्‌ जोतो आस दो छुटा़वेनतालेया।<figure style="fig" alt="Ship being wrecked in a storm" file="lb00219c.tif" size="col" copy="Horace Knowles ©" ref="27:18">होय आ़ँधिते उनुमोक्‌ कान जाहाज</figure><verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />आर ढेर दिन हा़बिच्‌ बिन जोमगेको ताहेंयेन खान पावल दो ओनको तालारे तेङगोयेनतेये मेनकेदा, ए हो आपे दो इञाक् काथा आँजोम आर क्रेते खोन जाहाज आलो लाड़ावगे लेक ताहेंकानतापेया, आदो होनाङ नोवा भाराभाट आर लोकसान दो ओहो होयलेना। <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />आर नितोक्‌ दो खा़तिरोक्‌आ मेनतेञ सोलहावापेकाना, एनते आपेको मोदरे ओकोयाक् जिवि हों बाङ लोकसानोक्आ, जाहाज छाडाकाते दो। <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />एनते तेहेञ ञिंदा़गे उनि इसोर, ओने उनिरेन कानिञ ओने उनि सेवा होंञ सेवावायकान, उनिरेनगे मित्‌टेन दुत इञ ठेन तेङगोयेनतेये मेनकेदा, <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />आलोम बोतोरोक्आ, ए पावल का़इसा़र सामाङरे तेङगोन होयोक्‌गेतामा, आर ञेलमे इसोर दो आम साँवते जाहाजतेको चालाक्‌कान सानामकोय दान आकावात्‌मेया। <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />ओना इया़ते ए बाबाको खा़तिरोक्‌पे इसोर इञ पा़तिया़वाय काना, ओका लेकाय ला़इ आकावादिञ ओनकागे होयोक्आ मेनते। <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />मेनखान ओका टा़पुरे चोङ ढाङोक् होयोक्‌ ताबोना।<verse eid="ACT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />मेनखान गेलपोनाक् ञिंदा़ होयेन खान, आदरिया़ जालापुरिरे ओनते नोतेले डेवलाव बाड़ाय कान ताहेंकानरे, ताला ञिंदा़ गान जाहाज चाक्‌लावकोको ओनमानकेदा, जे ओका दिसा़म ठेन चोङको सोरोक्‌कान। <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />आर दाक् जोक्‌खा सा़हुल चाडोकेत्‌ते मित्‌इसि पुरुसको ञामकेदा, आर थोड़ा तोफातरे आरहोंको जोखाकेत् खान गेलमोंड़ें पुरुसको ञामकेदा। <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />आदो चा़टा़इनिरे ढाङोक्‌को बोतोरेनते जाहाज तायोम सेच् पोनया लोङगोरको चाडोकेदा, आर सिञ मारसालोक्‌ ला़गित्‌को कोयकेदा। <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />आदो जाहाज चाक्‌लावको दो जाहाज खोन दा़ड़जोङको कुरुमुटुकेत्‌ते जाहाज सामाङसेच्‌ खोन लोङगोर चाडोया मेनते जाहाज रेयाक्‌ ला़उका़ दो जालापुरिरेको फेडकेदा, <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />खान पावल दो सुबेदार आर पालटोनकोय मेतात्‌कोवा, नोको होड़ जाहाजरे बाको ताहेंलेन खान आपे दो ओहोपे बाञचाव दाड़ेलेना <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />खानगे पालटोन दो ला़उका़ रेयाक्‌ बाराहि बाबेरको सामाक्‌ तोपाक्‌केत्‌ते ओना दोको आड़ाक् गोत्‌कादा।<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />आर आ़उरि मारसालोक्‌रेगे पावल दो सानामको जोम ञुजोङ ला़गित्‌ नेहोंरात्‌कोतेये मेतात्‌कोवा। तेहेञ दो गेलपोनाक् दिन काना, ओने ञेल होर ञेल होरते उपा़सतेगेपे ताहें आ़गुवाकान, चेत् हों बापे जोमआकात्‌ते। <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />ओना इया़तेञ सोलहावापे काना जोम ञु जोङपे, एनते ओना दो आपेयाक् रुखिया़क् ला़गित्‌गे, एनते आपे मोदरे ओकोयाक् बोहोक् रेयाक्‌ मिच्‌टेच उप्‌ हों बाङ ञुरहा़क्आ <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />आर ओनकाए मेनकेत् खान पिठा़इ हालाङकेदा, आर सानामको सामाङरे इसोरे गुनमानाव जोहारादेया, आर केचाक्‌काते जोजोमे एहोप् एना। <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />आदो सानामकोको खा़तिरेना आर आको होंको जोम ञुकेदा। <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />आर जाहाजरे दो जोतोते बार साय एयायगेल तुरुइ होड़ले ताहेंकाना।<verse eid="ACT 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 27:38" />आरको जोमबियेन खान जालापुरिरे गुहुमको गिडिकेत्‌ते जाहाजको रावालकेदा,<verse eid="ACT 27:38" /></para>
  <para style="s">जाहाज रा़पुत्‌एन</para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />आदो सिञ मारसालेन खान ओना दिसा़म दो बाको ओरोमलाक्‌आ मेनखान मित्‌टेच्‌ दोरयाँव कुचला़को ञेल ञामकेदा आरको सोलहावाना, दाड़ेयाक्‌ खान जाहाज दो ओंडेगेबो इदि ढाङा <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />आदो बेड़हायते लोङगोरकोको ओचोक्‌ गिडिकेत्‌ते ओना दो जालापुरिरेको बा़गियादा आर उनरेगे पाटवार रेयाक्‌ तोनोल होंको राड़ाकेदा आर होय ञाम ला़गित्‌ लाहा बादोम राकाप्‌केत्‌ते ओना मित्‌ साँव घुटु सेच्‌को मोहंडायेना। <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />मेनखान बारया जालापुरि रेयाक्‌ दोमुहा़ँनि ठेनको पाड़ावेनते जाहाज दोको चालाव ढाङकेदा आर जाहाज सामाङसेच्‌ दो गा़डिया़उ उरिच्एना, मेनखान तायोम सेच्‌ दो ढेव रेयाक्‌ ता़पिसते रा़पुदोक् एहोप्‌एना। <verse eid="ACT 27:41" /><verse number="42" style="v" sid="ACT 27:42" />आर पालटोनको दोको निटकेदा, जेमोन का़इदिकोको गोच्‌को, बाङखान पासेच्‌ जाहाँय पायरा ओडोककातेये दा़ड़ बोतेच्‌के। <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />मेनखान सुबेदार दो पावल बाञचावे ला़गित्‌ मोन ताहेंकानतायते ओनकोको मेनवानाक् खोने आकोटकेत्‌कोवा, आरे हुकुमकेदा, जेमोन पायरा दाड़ेयाक्‌को दो दोन चाडोक्‌ते लाहारे घुटुको तिया़ग। <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />आर सारेच्‌को आदोमको दो जाहाज रेयाक्‌ तोखताको से आर जाहानाक्‌को साप्‌काते सानामकोगे घुटुतेको बाञचाव राकाप्‌ एना।<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s">मा़लटा़ रे</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />आरले बाञचाव राकाप्एन खानले बाडायकेदा, ओना टा़पु दो मा़लटा़को मेताक्आ मेनते। <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />आर ओंडेन होड़को दो आ़डितेत्‌को माँयाँवाक्‌लेया, आर दाक्ए जा़ड़ियेत्‌कान आर राबाङकान ताहेंकान इया़ते सेङगेल जोलकेत्‌ते आले जोतोकोको आताङ दारामकेत्‌लेया <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />मेनखान पावल दो ढेर ञोक् झुरि सामटावकेत्‌रे सेङगेलरेये ठेकावकेत् खान मित्‌टेच्‌ बिसान बिञ दो सेङगेल दाँकते ओडोकेनते उनियाक् तिरेये बेदहावेना। <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />खानगे ओंडेन होड़ दो उनियाक् तिरे उनि बिञ ढिलवा़ङ आकान ञेलकेदेतेको मेपेनेना, “धोरागे खुनिया़ँहि कानाय नुय होड़ दो जालापुरि खोने बाञचाव ओडोक आकान रेहों होक बिक्‌चा़रिच् दो जिवेत् बाय ताहें ओचोवाय काना।” <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />मेनखान उनि दो उनि बिञ सेङगेलरेये इरचि गिडि गोत्‌कादेया आर आच् दो चेत् हों बाय हा़नलेना। <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />मेनखान ओनको दोको ञेल होहोरकान ताहेंकाना उनि दोए भारावक्आ आर बाङखान आचकागे गोच् भिनदा़ड़ गोदोक्आ नाहाँक्, आर ढेर घा़ड़ि ञेल होर ञेल होरते उनिरे चेत् हों बाङ होयोक्‌कान ञेलकेत् खान हुदिस आ़चुरकातेको मेनकेदा, “नुय दो मित्‌टेन देब कानाय।”<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />आर ओना जायगा आडेपासे दो पुबलियुस ञुतुमानिच् ओना टा़पुरेन नापड़ाक् होड़ रेयाक्‌ ओत ताहेंकाना, आर उनि दो आताङ आदेरकेत्‌लेते पे माँहाँ आ़डि मोजतेये पेड़ाकेत्‌लेया। <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />आर नोनका होयेना, पुबलियुस आपात दो रुवा़ आर सुलतेये जाड़ावआकान ताहेंकाना, आर उनि ठेन बोलोयेनते पावल दो कोयकाते उनिरे तिकिन चापोवादेतेये बोगे केदेया। <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />आर ओनका होयेन खान ओना टा़पुरेन सारेच् रुगिको होंको हेच्एना आरको बोगे ओचोयेना। <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />आर ओनको दो आ़डि मानोतको मानोतकेत्‌लेया, आर ओंडे खोन जाहाजतेले चालाक् जोखेच् जा़रुड़ोक्आक्‌को जाहाजरेको बोजाव गोत्आत्‌लेया।<verse eid="ACT 28:10" /></para>
  <para style="s">मा़लटा़ खोन रोमते</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />आदो पे चाँदो तायोम आले दो आलेकसान्‌डेरिया़ रेयाक्‌ मित्‌टेन जाहाजरेले देच्‌एना, ओने ओकाटाक्‌ ओना टा़पुरे राबाङ दिनले टालाव आकात् ताहेंकान ओना दो “जावा देबकिनाक् मुठा़नते” चिनहा़प आकान ताहेंकाना। <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />आर सुरा़कुस आतोरे जाहाज तेङगोकेत्‌ते पे माँहाँ ओंडेले ताहेंयेना। <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />आर ओंडे खोन आ़चुर चालावेनते रेगियुम नागराहारेले सेटेरेना, आर मित् दिन तायोम दा़खिन सेच् खोने होयकेत्‌ते दोसार हिलोक् दो पुटेयोलितेले हेच्‌एना। <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />ओंडे दो बिसवा़सिकोले ञामकेत्‌कोवा आरको नेहोंरात्‌लेते ओनको ठेन एयाय माँहाँले ताहेंयेना आर ओनकाते रोमतेले हेच्एना। <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />आर ओंडे खोन बिसवा़सिको दो आले रेयाक्‌को आँजोमकेत् खान आले दाक्‌रामको हेच्एना, आ़प्‌पियोस हाट आर पे सा़रा़इ हा़बिच्‌, पावल दो ओनकोय ञेलकेत्‌को खान इसोरे गुन मानाव जोहारादेया आरे खा़तिरजोमायेना।<verse eid="ACT 28:15" /></para>
  <para style="s">रोम रे</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16" />आर रोमतेले बोलोयेन खान, पावल दो आच् होरहोयेदिकान पालटोन तुलुच्‌ एसकारगेको ताहें ओचोवादेया।<figure style="fig" alt="Chains embedded in prison wall" file="hk00242c.tif" size="col" copy="Horace Knowles ©" ref="28:16">रोम नागराहा रेयाक् डाहार ञेलोक्‌रे‌</figure><verse eid="ACT 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />आर पे माँहाँ तायोम उनि दो जिहुदिको मोदरेन ओंडे ताहेंकान नापड़ाक् नापड़ाक् होड़कोय होहो जारवाकेत्‌कोवा आदोको हेच् जारवायेन खाने मेतात्‌कोवा ए बोयहाको, इञ दो आबो जा़तरेनको से हापड़ामकोवाक् चा़लि बिरुदरे चेत् हों बा़ञ चेकाआकात्‌रे हों एनरेहों जेरुसालेम खोन का़इदिकाते रोमिकोवाक् तिरेञ सोपरोत ओचोयेना। <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />आर ओनको दो इञको कुलि बाड़ाकेदिञ खान आड़ाक्‌का़ञको मेनवाना, गोच् ओचोक् लेक चेत् दोस हों इञरे बाङ ताहेंकान इया़ते <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />मेनखान जिहुदिकोको रोड़ दारामकेत् खान का़इसा़र दोहायाय ला़गित्‌ जा़रुड़ होयेनतिञा मेनखान इञ जा़तरेनको जाहानाक् बोहोक्‌को ला़गित्‌ ताहेंकानतिञा, ओना इया़ते बाङा।<note caller="+" style="x"><char style="xo" closed="false">28:19 </char><char style="xt" closed="false"><ref loc="ACT 25:11">आ का़ २५:११</ref> </char></note> <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />आदो नोवा कारोनतेगे आपे तुलुच् ञेपेलोक् आर गालमारावापेया मेनतेञ होहो आ़गु ओचोवाकात्‌पेया, एनते इसराएलको रेयाक्‌ आस जिसु खा़तिरतेगे नोवा सिकड़िते दोञ तोल आकान।<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />खानगेको मेतादेया, आले दो आम रेयाङ जिहुदा़ खोन चिठिको हों बाले ञामआकादा, आर बोयहाको मोदरेन ओकोय हों नोंडे हेच्‌काते आम रेयाक्‌ जाहानाक् बा़ड़िच् दो बाको रोड़ाकादा। <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />मेनखान आमाक् मोन रेयाक्‌ आम ठेन खोन आँजोम दो ठिकले मेताक्‌काना, एनते नोवा सिकना़त दोल रेयाङ दो आलेले बाडाया, सानाम टा़न्‌डिगे रोड़ दारामोक्‌काना।<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />आदो मित्‌टेच् दिन नेन्‌डावादेते ढेर होड़ उनि ठेन उनियाक् डेरातेको हेच्एना ओने ओनको सेताक् खोन आ़युप् हा़बिच्‌ए गालमारावात्‌को इसोराक् राज रेयाक्‌ गोहा एमकाते आर मोसे रेयाक्‌ आ़न खोन हों आर ना़बिकोवाक् खोन हों जिसु रेयाक्‌ए बुजहा़वाकोकान ताहेंकानते। <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />आर आदोमको दो रोड़ेनाक्‌कोतेको धिरपुरेना, आर आदोमको दो बाको पा़तिया़वादा। <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />आदो आको आकोरे काथा एपड़ेयेनताकोतेको चालाव बाड़ायेना, पावल मित् काथाय रोड़केत्‌ते बाङमा सोनोत जिउ दो जेसाया ना़बि होतेते आपेरेन हापड़ामको ठेन ठिकगेये रोड़लाक्आ। <verse eid="ACT 28:25" /><verse number="26" style="v" sid="ACT 28:26" />एनकाथाय,</para>
  <para style="q1" vid="ACT 28:26">“दु नोको जा़तरेनको ठेन सेनकाते मेताकोम,</para>
  <para style="q1" vid="ACT 28:26">आँजोम दोपे आँजोमगेया, मेनखान बापे बुजहा़वा,</para>
  <para style="q2" vid="ACT 28:26">आर ञेल दोपे ञेञेलगेया, मेनखान बाङगेपे ओरोमा।<note caller="+" style="x"><char style="xo" closed="false">28:26 </char><char style="xt" closed="false"><ref loc="ISA 6:9">जेसा ६:९</ref>,<ref loc="ISA 6:10">१०</ref> </char></note><verse eid="ACT 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27" />एनते नोको होड़ाक् मोन दो दा़रिया़येन ताकोवा</para>
  <para style="q2" vid="ACT 28:27">आर लुतुर दो गोधड़ोयेनताकोवा,</para>
  <para style="q2" vid="ACT 28:27">आर मेंत् दोको जा़पित् आकात्‌ताकोवा,</para>
  <para style="q1" vid="ACT 28:27">जेमोन मेंत्‌ते आलोको ञेल</para>
  <para style="q2" vid="ACT 28:27">आर लुतुरते आलोको आँजोम,</para>
  <para style="q2" vid="ACT 28:27">आर मोनते आलोको बुजहा़उ</para>
  <para style="q1" vid="ACT 28:27">आरको आ़चुर रुवा़ड़ोक्</para>
  <para style="q2" vid="ACT 28:27">आर इञ बोगे बोतेच्‌केको।”<verse eid="ACT 28:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28" />आदो पावले मेन जुटुच्‌केदा ओना इया़ते बाडाय जोङपे, इसोराक्‌ बाबाञचाव सोमबात दो जिहुदि बाहरेरेनको ठेनगे कोल आकाना, आर ओनकोको आँजोमा। <verse eid="ACT 28:28" /><verse number="29" style="v" sid="ACT 28:29" />आदो नोवाको काथाय रोड़केत् खान जिहुदिको दोको आपान आ़पिनेना, आको आकोरे ढेरको आपठा आ़पठिक्‌ कानते।<verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />आर पावल दो बार सेरमा पुरा़ पुरि आयाक्‌ भाड़ा ओड़ाक्‌रेये ताहेंयेना, आर आच् ठेन हिजुक्‌कान सानामकोय आताङ दारामेत्‌को ताहेंकाना। <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />आर इसोराक् राज रेयाक्‌ए पोरचाराको कान आर प्रोभु जिसु मा़सि रेयाङे चेत्आको कान ताहेंकानते, आ़डि सोहोसाते आर बिन बोतोरते।<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>