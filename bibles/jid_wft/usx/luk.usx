<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LUK" style="id">LUKA- BUU</book>
  <para style="h">LUK LUKA- BUU</para>
  <para style="toc1">LUK LUKA- BUU</para>
  <para style="toc2">LUK LUKA- BUU</para>
  <para style="toc3">LUK LUKA- BUU</para>
  <para style="mt1">LUK LUKA- BUU</para>
  <chapter number="1" style="c" sid="LUK 1" />
  <para style="s">Mimilan tre</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1" />Riwa a he nji kigbu wa ban wari la tre wanyi riwa wa he rimi mbi, <verse eid="LUK 1:1" /><verse number="2" style="v" sid="LUK 1:2" />a tsra bibi riwa wa to kyawa wa gbuchi wawa wa tindu Izhi wa la ta. <verse eid="LUK 1:2" /><verse number="3" style="v" sid="LUK 1:3" />Ritu me hu dza kongye tsra ri gbuchi, nga me to a bi riwa me ngan riwu yiyiri, a wu rinkon Tiyofalus, <verse eid="LUK 1:3" /><verse number="4" style="v" sid="LUK 1:4" />ritu riwa wu to kpunji kya wanyi bibi riwa wa la wa riwu.<verse eid="LUK 1:4" /></para>
  <para style="s">Wa la Tre Ngɨzhi Yohana Nji ri Sonnjitu Mma</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5" />Riwa Hiridus a he chu Yudiya, wati nji ri riwa wa yo wu ri Zakariya, riwa a ran tindu Izhi rimi ko Abiya. A gran vɨra ri rimi gɨzhi Haruna, riwa nde wan a he Alisabatu. <verse eid="LUK 1:5" /><verse number="6" style="v" sid="LUK 1:6" />Ngamba wa he wa dindi kusi Izhi, Wa ran hu tre Izhi ri wa doka wan ri bibi zren riwa wa ran yosi riwa ran. <verse eid="LUK 1:6" /><verse number="7" style="v" sid="LUK 1:7" />Ama wana he ri miri ran ritu Alisabatu a son ri wulo; ngamba wa kunchon.<verse eid="LUK 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8" />Chachu ri Zakariya a ran ti ndu Izhi riwa a he rimi ndu mba ivi ndu mba ka kɨma ye, <verse eid="LUK 1:8" /><verse number="9" style="v" sid="LUK 1:9" />a he ritu bibi riwa wa ndu Izhi wa ka dzi, mgbe ka ku ri tu wan riwa ari ran gra ri tra Izhi ran huu mumu ri miwhi raro. <verse eid="LUK 1:9" /><verse number="10" style="v" sid="LUK 1:10" />Ngha riwa wa hu mumu ri miwhi raro-a wa ye, ikpanji wa ki wari ri bre ri ra,<verse eid="LUK 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 1:11" />Imba ivren ri ndu Izhi ri ka ye ri wu, a kri ku wo ri wan bubu bre riwa wa huu mumu ntsen. <verse eid="LUK 1:11" /><verse number="12" style="v" sid="LUK 1:12" />Riwa Zakariya a tou, ka suu sron sisiri ka tiu. <verse eid="LUK 1:12" /><verse number="13" style="v" sid="LUK 1:13" />Ama ivren ri ndu Izhi-a ka tre riwu, &lt;&lt; Ran ti sisiri ran, Zakariya; Izhi kpa ibrewen. Iwa wen Alisabatu ri ngɨzhi vren riwu, wuyo nde wan ri Yohana <verse eid="LUK 1:13" /><verse number="14" style="v" sid="LUK 1:14" />Wu ŋgiri wuri ti kiŋklan sron, nji kigbu wa ti kiŋklan sron ri ngɨzhi wan. <verse eid="LUK 1:14" /><verse number="15" style="v" sid="LUK 1:15" />Ritu ari he rinkon nji kusi Bachi. A ran so hi ko ikya riwa ari no hwa ran. Wa shou ri Yuu ri Tsɨtsɨri tu ka a he rimi nne yi wan. <verse eid="LUK 1:15" /><verse number="16" style="v" sid="LUK 1:16" />Ngha ari kɨma wanji Israila kigbu ye ri Bachi Izhi mba. <verse eid="LUK 1:16" /><verse number="17" style="v" sid="LUK 1:17" />Ari gbuchi hi kusi Izhi rimi wu ri gbengbren bibi riwa Iliya, Ari kɨma sron wa ti ye ri miri mba, nga ran kɨma wawa wana wo tre ran no wa hu to wa dindi ti, ran fe nji riwa wa mɨlan ki ri Izhi.<verse eid="LUK 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18" />Imba Zakariya ka tre ri vren rindu Izhi-a ri, &lt;&lt; Me ti rise meri to nganyi? Ga ame me kunchon, iwa ri ko won ngawen ti vi hari.&gt;&gt;<verse eid="LUK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19" />Imba ivren rindu Izhi ka tre riwu ri, &lt;&lt; Ame me he Jibrilu ri ndu Izhi riwa a kri kusi Izhi, meri lawu tre dindi riwa ari ye ri wu. <verse eid="LUK 1:19" /><verse number="20" style="v" sid="LUK 1:20" />Ingye ngha wu soŋgbi , wuran to tre ran, tse chachu riwa kyawa wanyi wa ti ritu riwa wuran kpa yɨme tre won ran, itre nyi ri he ri vi wan.&gt;&gt;<verse eid="LUK 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21" />Inji wa ka ki ran gben Zakariya wari ku ti sisiri ko ngye nye ngɨzhi wu rimi tra bre. <verse eid="LUK 1:21" /><verse number="22" style="v" sid="LUK 1:22" />Riwa a zhu ra, a ran to tre riwa ran. Imba waka to ri a he ra nye wa ti ri wu ri wu rimi tra Izhi, mba ka gra tsro ri wo ama a ran ran to tre rinyu ran.<verse eid="LUK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23" />Tse riwa ivi ndu Zakariya a kre, tse ka hi ko. <verse eid="LUK 1:23" /><verse number="24" style="v" sid="LUK 1:24" />Kugon vi wamba, iwa wan Alisabatu ka he nne. Imba ran son rimi ko hari huwa ton, ran ran tre ri, <verse eid="LUK 1:24" /><verse number="25" style="v" sid="LUK 1:25" />&lt;&lt; Ka nyi yen Izhi a ti rimo rivi riwa a ya wen ri si lo sron, ritu wa a zhu rimon ri ya riwa a fe kusi nji.&gt;&gt;<verse eid="LUK 1:25" /></para>
  <para style="s">Wa La tre Ngɨji Yeso</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26" />Ri huwa ri tanren Izhi a ti vren ri nduwan Jibrilu hi ri meme Galili, riwa wayo ri Nazarat, <verse eid="LUK 1:26" /><verse number="27" style="v" sid="LUK 1:27" />ri vɨranze riwa wa kau no nji riwa wana yo wu ri Yusufu, riwa a he wa gɨzhi Doda, inde vra kae Meriyamu. <verse eid="LUK 1:27" /><verse number="28" style="v" sid="LUK 1:28" />Tse ivren rindu Izhi ke riwu, ran tre, &lt;&lt; No sisiron no he riwu, a wu riwa wa chu wu! Bachi he riwu.&gt;&gt;<verse eid="LUK 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29" />Ama Meriyamu ka ti sisiri bran ritu tre-a, a son ndu ri mɨren ri ichi bibitan nye nganyi. <verse eid="LUK 1:29" /><verse number="30" style="v" sid="LUK 1:30" />Ivren rindu Izhi ka tre riwu ri, &lt;&lt; Ran ti sisiri ran, Meriyamu, wu fe zon riwo Izhi. <verse eid="LUK 1:30" /><verse number="31" style="v" sid="LUK 1:31" />Wuhe nne, wu ngɨzhi vren, wu yonde wan ri Yeso <verse eid="LUK 1:31" /><verse number="32" style="v" sid="LUK 1:32" />Ari he riŋko, wa yo wu ri ivren Izhi rinkon riwa wana gbre wu san nde. Bachi Izhi ri no kpanchison riwa giwan Doda, <verse eid="LUK 1:32" /><verse number="33" style="v" sid="LUK 1:33" />ari ngɨzhi wa gɨzhi Yakubu riwa a ran kre , ndu chu wan a ran kre ran.&gt;&gt; <verse eid="LUK 1:33" /><verse number="34" style="v" sid="LUK 1:34" />Imba Meriyamu ka tre ri vren rindu Izhi, &lt;&lt; Ari ti se ran he nganyi, riwa me ran to ronron ran? &gt;&gt;<verse eid="LUK 1:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35" />Ivren rindu Izhi ka tre riwu ri,&lt;&lt; Iyu ri Tsitsri ri gɨzhi ritu wen, gbengbren nji riwa wa gbresan wan ri kau. Ritu kamba Tsitsri nji riwa wan gɨzhi u-a, wa yo-u ri ivren Izhi. <verse eid="LUK 1:35" /><verse number="36" style="v" sid="LUK 1:36" />Ingye vayi wen Alisabatu ngawen a he nne hua tanren ri nji ri nchon wan, wawu riwa wa yo wu ri iwa ri wa a son ri wɨlo. <verse eid="LUK 1:36" /><verse number="37" style="v" sid="LUK 1:37" />Ba tre Izhi riwa ari tre riwa a ran kri ran.&gt;&gt;<verse eid="LUK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38" />&lt;&lt;Imba Meriyamu ka tre,&gt;&gt; To ama me he gran riwa Izhi, no he bibi riwa Izhi tɨtr mo.&gt;&gt; Imba ivren rindu Izhi ka tsiri riwu.<verse eid="LUK 1:38" /></para>
  <para style="s">Meriyamu a hi ri Alisabatu</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39" />Rimi vi wanyi Meriyamu a wurunde gbagbla, a hi ri meme riwa a ti tita, ri gbu ri meme Yauza. <verse eid="LUK 1:39" /><verse number="40" style="v" sid="LUK 1:40" />A gra riko Zakariya ran chi Alisabatu. <verse eid="LUK 1:40" /><verse number="41" style="v" sid="LUK 1:41" />Riwa Alisabatu a wo chi Meriyamu, Ivren nghe ka chu bran rimi nne wan. wa ka shu Alisabatu ri wu ri Tsitsri. <verse eid="LUK 1:41" /><verse number="42" style="v" sid="LUK 1:42" />Hari ka nzu ran Gbangban ran tre, &lt;&lt;A wu wuhe wa ri alibraka rimi mba, ivren rimi nghe wen ngawen he ri alibraka! <verse eid="LUK 1:42" /><verse number="43" style="v" sid="LUK 1:43" />Wati rise ko bibi ndindi ti nyin fe wen, hari riwa iyi Bachi ri ye ri me? <verse eid="LUK 1:43" /><verse number="44" style="v" sid="LUK 1:44" />Ritu riwa me wo ran wen ri chi ri tonwon, tse ivren nghe ka ka chu bran rimi nghe won ritu kinklan sron. <verse eid="LUK 1:44" /><verse number="45" style="v" sid="LUK 1:45" />Alibraka ri he ri wa riwa a kpanyɨme, don wa shu kyawa riwa Bachi a tindu no wa la riwu!&gt;&gt;<verse eid="LUK 1:45" /></para>
  <para style="s">Ise Meriyamu ri gbre.</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46" />Imba Meriyamu ka tre:</para>
  <para style="q1" vid="LUK 1:46">&lt;&lt; Isron won ri gbre wu Bachi,<verse eid="LUK 1:46" /></para>
  <para style="q2">
    <verse number="47" style="v" sid="LUK 1:47" />Izhi riwa a kpawen chuwo riwu nye Iyu won ri ti kinklan sron.<verse eid="LUK 1:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LUK 1:48" />Ritu riwa wawu nye to kunyɨren wa ri ndu wan</para>
  <para style="q2" vid="LUK 1:48">Ingye gbunji wa nza wawu</para>
  <para style="q1" vid="LUK 1:48">Wa tre ri mo me he wa ri alibraka ku si viri.<verse eid="LUK 1:48" /></para>
  <para style="q2">
    <verse number="49" style="v" sid="LUK 1:49" />Ritu wawu riwa a he ri gbengbren, Kyawa wa wa kpokpolo riwa a ti ri mo,</para>
  <para style="q2" vid="LUK 1:49">inde wan he Tsitsri nde. <verse eid="LUK 1:49" /><verse number="50" style="v" sid="LUK 1:50" />Ri nzan hi ri nzan,</para>
  <para style="q2" vid="LUK 1:50">ari losron ri wawa wa ti sisiri wan. <verse eid="LUK 1:50" /><verse number="51" style="v" sid="LUK 1:51" />Rigra kyawa riwa a ti,</para>
  <para style="q2" vid="LUK 1:51">Wawa wa sentu, wawa ri wiwɨri mba a vɨra wa.<verse eid="LUK 1:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52" />A zhu ri wa chu ri kpanchimba.</para>
  <para style="q2" vid="LUK 1:52">Ran nzu wawa wa kunyiren.<verse eid="LUK 1:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53" />Wawa iyon ri tiwa a no wa hwɨshi ri kyawa ama ran zu wawa wa he ri wo hi ngamba.<verse eid="LUK 1:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54" />A zon wa ndu wan Israila,</para>
  <para style="q2" vid="LUK 1:54">Ritu riwa ari taka ri lo siron wan.<verse eid="LUK 1:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55" />A shu tre wan riwa ti watimba,</para>
  <para style="q2" vid="LUK 1:55">Nga Ibrahi ri wa gɨzhi wan, riwa a ran kre ran.&gt;&gt;<verse eid="LUK 1:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56" />Meriyamu ka son ri Alisabatu ti huwa tra, ko ran bru hi ko.<verse eid="LUK 1:56" /></para>
  <para style="s">Iŋgɨji Yohana nji ri son nji ri ima</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57" />Ivi ngɨzhi Alisabatu a ti, ka ngɨzhi vren ron. <verse eid="LUK 1:57" /><verse number="58" style="v" sid="LUK 1:58" />Tse wa kusan wan ri miri vayi wan waka wo bibi riwa Bachi a to lo sron wan bran, hari wari zon-u ti kinklan sron.<verse eid="LUK 1:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 1:59" />Riwa ivi ri tandɨra waka ye wari fon vren-a nzhu. Wana hi ran yonde wan ri nde tiwan, zakariya, <verse eid="LUK 1:59" /><verse number="60" style="v" sid="LUK 1:60" />Ama iyi wan ka kawan iri,&lt;&lt; Yohana nye wa yo wu.&gt;&gt; <verse eid="LUK 1:60" /><verse number="61" style="v" sid="LUK 1:61" />Waka tre riwu, &lt;&lt; Ai injo ŋbi ran he ri bibi nde nyi ran.&gt;&gt;<verse eid="LUK 1:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 1:62" />Waka tsro tiwan ri bibi tre wa hanton, iri no de nde riwa ari wa nowa no vren- a. <verse eid="LUK 1:62" /><verse number="63" style="v" sid="LUK 1:63" />Rimba ka tre riwa ri nowa no wawu kya ri ngha, mba ka ngha ri, &lt;&lt; Inde wan he Yohana.&gt;&gt; Wawu mba waka ti sisiri. <verse eid="LUK 1:63" /><verse number="64" style="v" sid="LUK 1:64" />Imba ka fe nyu irɨme wan kasi ran gbuchi ran tre ranran gbre Izhi. <verse eid="LUK 1:64" /><verse number="65" style="v" sid="LUK 1:65" />Imba sisiri ka ti wa kusan mba wawu wa ka gra tre tre shu ko wɨji tan rimi gbu riwa a he ri tita ri Yudiya. <verse eid="LUK 1:65" /><verse number="66" style="v" sid="LUK 1:66" />Wa nji wawu wa wo tre a wari ngɨzhi ri sron wari tre ri &lt;&lt; Ingye nye vi vren nyin ri he ?&gt;&gt; Don gbengbren Izhi he riwu.<verse eid="LUK 1:66" /></para>
  <para style="s">Ise Zakariya</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67" />Imba Iyu Tsitsri ka shu tiwan Zakariya ka tre: <verse eid="LUK 1:67" /><verse number="68" style="v" sid="LUK 1:68" />&lt;&lt; Bachi Izhi riwa Israila, Riwu nye igibree,</para>
  <para style="q2" vid="LUK 1:68">Ritu riwa a ya nziri ran kpan Izhi wan chuwo.<verse eid="LUK 1:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69" />A nzuu nji riwa ari kpawa chuwo ri Izhi riwa a he ri nkpen gbre ritu mbu,</para>
  <para style="q2" vid="LUK 1:69">Riwa a Juu ri gɨzhi gran wan Doda<verse eid="LUK 1:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70" />Bibi rimiren riwa a zhu rinyu wawa wa la tre Izhi wan wa Tsitsri mba<verse eid="LUK 1:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71" />A kpata chuwo riwo wa kpan fu mbu,</para>
  <para style="q2" vid="LUK 1:71">ita ri ri wawa wa kamba ri ta-<verse eid="LUK 1:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72" />ritu tsro lo sron riwa a ti ri wa ti timbu</para>
  <para style="q2" vid="LUK 1:72">a taka tre riwa a kadzi rɨme ri Tsitsri ritu mba,<verse eid="LUK 1:72" /></para>
  <para style="q2">
    <verse number="73" style="v" sid="LUK 1:73" />wawu nye he shiji riwa a ti ri timbu Ibrahi.<verse eid="LUK 1:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="LUK 1:74" />Ritu riwa a kpata ri chuwo riwo wa kpan fu mbu,</para>
  <para style="q2" vid="LUK 1:74">ki hu kiran ti sisiri ran,<verse eid="LUK 1:74" /></para>
  <para style="q2">
    <verse number="75" style="v" sid="LUK 1:75" />tsede ri Tsitsri ri dindi ti kusi wan, wawu ri vi mbu.<verse eid="LUK 1:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76" />&lt;&lt;A wu, vi vren nyin, wa tre riwu ri wuhe nji riwa wu la tre Izhi riwa wa gbre wu;</para>
  <para style="q2" vid="LUK 1:76">wu gbuchi hi kusi Bachi wuri mɨlan nkon wan ti,<verse eid="LUK 1:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77" />la nji tre wan ri kpawa chuwo.</para>
  <para style="q2" vid="LUK 1:77">wato ika meme ti mba rega,<verse eid="LUK 1:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78" />ritu ikpa lo sron riwa Izhi mbu,</para>
  <para style="q2" vid="LUK 1:78">ri shu nye ikpan ri bu mbre ri zhu rita rishu mu nye fa ari kpan ri ta,<verse eid="LUK 1:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79" />ran kpan tsro wawa wa son ri mi bu.</para>
  <para style="q2" vid="LUK 1:79">ri wawa wa son ri nyu kuu,</para>
  <para style="q1" vid="LUK 1:79">don zhu rita ri nkon son sisiron.&gt;&gt;<verse eid="LUK 1:79" /></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80" />Tse Yohana vi vren-a ka gbron ran senkpa rimi wu, a son ri ji hari chachu riwa ari tsro tuwan ri Israila.<verse eid="LUK 1:80" /></para>
  <chapter eid="LUK 1" />
  <chapter number="2" style="c" sid="LUK 2" />
  <para style="s">Iŋgɨji Yeso</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1" />Ri vi wa ichu Kaisar Augustus a dɨbu iri nowa bla ko ngha riwa a he ri ndoza kpanchi wan. <verse eid="LUK 2:1" /><verse number="2" style="v" sid="LUK 2:2" />Rinyi nye a he bla ri gbuchi riwa wa ti ri zamani kiriniyas, ri wa a he rinkon meme suriya. <verse eid="LUK 2:2" /><verse number="3" style="v" sid="LUK 2:3" />Ko ngha no hi gbu mba nowa hi bla.<verse eid="LUK 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4" />Yusufu ngawen ka wurunde ri gbu Nazara ri meme Galili, ran hi meme Yudiya ran hi gbu Doda riwa wa yo wu ri Batalami (ritu riwa a he ri gɨzhi wa Doda nye ri nne mba). <verse eid="LUK 2:4" /><verse number="5" style="v" sid="LUK 2:5" />A hi nowa ngha nde wan ri Meriyamu, riwa a su ran gran wu nga wa ran gben vren. <verse eid="LUK 2:5" /><verse number="6" style="v" sid="LUK 2:6" />Riwa wa he ri muu tse ivi ngɨzhi wan ka ti. <verse eid="LUK 2:6" /><verse number="7" style="v" sid="LUK 2:7" />Ka ngɨzhi vren wan ri gbuchi, ran kau ri tsro ri sho vren, ran kau yo rimi tra yawo rimi bubu riwa wa sro ri riwa, ritu riwa wana fe tra ri kuru ran.<verse eid="LUK 2:7" /></para>
  <para style="s">Wa kɨshu Ntɨma ri wa miri ko Izhi</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8" />Ri ŋɨma meme-a wa kishu ntɨma wari wa kru ri ra ŋgbende, wa ran gben ntɨma mba ri chu. <verse eid="LUK 2:8" /><verse number="9" style="v" sid="LUK 2:9" />Tse ivren ndu Izhi ri ka kri kusan mba, lgbresan Izhi kakpan kagon mba, wa ka ti sisiri branbran. <verse eid="LUK 2:9" /><verse number="10" style="v" sid="LUK 2:10" />Imba lvren ndu Izhi ka tre ri,&lt;&lt; Ran ti sisiri ran yi, ngye me ngɨzhi tre dindi ye ri yi ri kinklan sron kigbu, riwa ari he wa nji iwawu. <verse eid="LUK 2:10" /><verse number="11" style="v" sid="LUK 2:11" />Ritu riwa wa ngɨzhi nji wa ari kpayi chuwo ri gbu Doda, riwa wawu nye he nji rikpa nji chuwo, Bachi. <verse eid="LUK 2:11" /><verse number="12" style="v" sid="LUK 2:12" />Ingye bibi kya riwa bi to een, bi to vi vren-a wa kau ri tsro ri sho-gbosho, a kru rimi tra yawo rimi bubu riwa wa sro riwa.&gt;&gt;<verse eid="LUK 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13" />Ba labari tse ngye ikpa miri ndu Izhi wa kagbamu wari ran gbre Izhi, wari ran tre,<verse eid="LUK 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 2:14" />&lt;&lt; Igbre he wa Izhi, rimi shu wulu riwa wa gbre wu han, ran nowa kinklan sron branbran.&gt;&gt;<verse eid="LUK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15" />Riwa imirindu Izhi wa kawa don wari bru hi shu, imba wa kɨshu ntɨma waka tre ri kamba ri,&lt;&lt;ki hi to kya riwa a ti ri Batalami zizan, riwa Bachi a la ri ta.&gt;&gt;<verse eid="LUK 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16" />Wa ka hi gbagbla, wa ri ka fe wa Meriyamu mba Yusufu, ri vi vren-a ka a kru ri tra yawo rimi bubu riwa wa sro ri ri wa. <verse eid="LUK 2:16" /><verse number="17" style="v" sid="LUK 2:17" />Riwa wato, wari la bibi tre riwa wa lawa ritu vren-a, <verse eid="LUK 2:17" /><verse number="18" style="v" sid="LUK 2:18" />Wawu wawa wa wo wari gra ti sisiri ritu kya riwa wa kɨshu ntɨma wa la wa. <verse eid="LUK 2:18" /><verse number="19" style="v" sid="LUK 2:19" />Meriyamu ka ngɨzhi kya wa riwa wa la ran ran taka wan ri sron. <verse eid="LUK 2:19" /><verse number="20" style="v" sid="LUK 2:20" />Wa kɨshu ŋtiman-a waka bru hi, wari si gbre Izhi wari zon nde, ritu kya riwa wawo, wari to, bibi riwa wa lawa.<verse eid="LUK 2:20" /></para>
  <para style="s">Wa Ngɨji Yeso hi ri tra Bre</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21" />Riwa ivi ri tandɨra a ye riwa wa fon Yeso nzhu, waka yonde wan ri Yeso inde riwa ivren rindu Izhi a la ri ko ivren-a kagon ri nne.<verse eid="LUK 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 2:22" />Riwa ivi Tsitsrimba a ye ritu bla tre Musa, waka ngɨzhi Yeso ye Urushelima, wari kau no Izhi. <verse eid="LUK 2:22" /><verse number="23" style="v" sid="LUK 2:23" />Bibi riwa a he rimi ngha bla tre Izhi ri, &lt;&lt;Ivren ri gbuchi riwa wa ngɨzhi, wa tre ri a he Tsitsri ri Izhi,&gt;&gt; <verse eid="LUK 2:23" /><verse number="24" style="v" sid="LUK 2:24" />Wari tsiri-u ritu kya riwa wa zi ri mbe Izhi ri, &lt;&lt;Inguu hari nga inguu ri ko hari.&gt;&gt;<verse eid="LUK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25" />Imba nji ri a he ri Urushelima riwa, inde wan a he Saminu riwa a he nji dindi, a ran hu Izhi, a ran ti nbiye riwa ari to Israila, Iyu Tsitsri ka he riwu. <verse eid="LUK 2:25" /><verse number="26" style="v" sid="LUK 2:26" />Tsitɨri Wu a gbuchi lau ri, a ran kuu ran tse a to Bachi Kristo. <verse eid="LUK 2:26" /><verse number="27" style="v" sid="LUK 2:27" />Tsitiri Wu a ran tru, ka gra rimi tra Izhi. Riwa wati wan wa ngɨzhi vren-a Yeso gra, wati riwu bibi riwa waka tre zi, <verse eid="LUK 2:27" /><verse number="28" style="v" sid="LUK 2:28" />Imba Saminu ka ban wu ngɨzhi ran ngɨri ri Izhi, ran tre:<verse eid="LUK 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29" />&lt;&lt;Zizan nye, a wu riwa wu ngɨzhi ko, ka miriko wen chuwo ri sikpa,</para>
  <para style="q2" vid="LUK 2:29">Ritu bibi kya riwa wu la,<verse eid="LUK 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30" />Riwa me to kpachuwo wen ndende,<verse eid="LUK 2:30" /></para>
  <para style="q2">
    <verse number="31" style="v" sid="LUK 2:31" />Riwa wu mɨlan zi ri kusi gbunji wawu,<verse eid="LUK 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32" />Ikpan riwa ari tsro nji nkon wen,</para>
  <para style="q2" vid="LUK 2:32">nga gbre wa nji Israila.&gt;&gt;<verse eid="LUK 2:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33" />Wa yiwan mba Tiwan waka ti sisiri ritu kya riwa wa tre ri tuwan. <verse eid="LUK 2:33" /><verse number="34" style="v" sid="LUK 2:34" />Imba Saminu ka ti lɨwu dindi sro riwa, ran tre ri Meriyamu iyi Yeso: &lt;&lt; Wu to vren nyi, kigbu wari wa kpa Izhi, kigbu wari wa kamba riwu rimi Israila, nga ritu alama riwa wa kamba riwu, <verse eid="LUK 2:34" /><verse number="35" style="v" sid="LUK 2:35" />Ritu rimɨren sron wanji kigbu wa he Een, a wu ngawen njigban ri yɨra sron wen.&gt;&gt;<verse eid="LUK 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36" />Iwa rindu Izhi a he inde wan a he Hannatu, ivren Fanuwela, riwa a he ri gɨzhi Asha. A kunchon ngbazhi ran; a son gran ri se tamgban riwa wa ban u ri vɨru wa wan, <verse eid="LUK 2:36" /><verse number="37" style="v" sid="LUK 2:37" />riwa iron wan akuu ka son wari kɨbo hari se setandira don nza. A ran ran ka tra Izhi ran don ran, a ran hu Izhi ri chu ri mibreri ibrenga vulaima. <verse eid="LUK 2:37" /><verse number="38" style="v" sid="LUK 2:38" />Imba kaye ran ye ngɨri ri Izhi nga ran tre tre vi vren-a ri nji wawa wa sɨrenton wari wo kpa Urushelima chuwo.<verse eid="LUK 2:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39" />Kugon riwa wa kre kon ngye ritu bla tre riwa Izhi, waka bru hi meme Galili wari hi gbu mba Nazarat. <verse eid="LUK 2:39" /><verse number="40" style="v" sid="LUK 2:40" />Vi vren-a ka gbron, ran senkpa, ran he ri to ti Ndindi riwa Izhi a he ri wu.<verse eid="LUK 2:40" /></para>
  <para style="s">Yeso Vɨren-ze a Gra ri Tɨra Izhi</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41" />Ri se ri se wati wan waye waka hi ri Urushalima riwa wati iro ri za gran. <verse eid="LUK 2:41" /><verse number="42" style="v" sid="LUK 2:42" />Riwa Yeso a ti se wuru don hari, waka ban wu hi ri bubu ro ritu kya riwa wasi ti. <verse eid="LUK 2:42" /><verse number="43" style="v" sid="LUK 2:43" />Riwa wa kre ro mba, wari ran ye, ivren-a ka son ri Urushelima watiwan wa ran to ran. <verse eid="LUK 2:43" /><verse number="44" style="v" sid="LUK 2:44" />Wawa wa zɨren jiakuu, wa yonga ri a he rimi mba wa si lanji bla rimi miri vayimba ri wa kpan mba. <verse eid="LUK 2:44" /><verse number="45" style="v" sid="LUK 2:45" />Riwa wana fe ran, waka hi ri Urushelima, wari si wa-u bla. <verse eid="LUK 2:45" /><verse number="46" style="v" sid="LUK 2:46" />Imba ri vi ri tre waka fe rimi tra Izhi ka a son ri tsutus wa tsro, ran ran sirenton, ran ran miyen wa miyen. <verse eid="LUK 2:46" /><verse number="47" style="v" sid="LUK 2:47" />Wa wa wa wou wati sisiri bibi to wan riwa a to ri nyime miyen wan. <verse eid="LUK 2:47" /><verse number="48" style="v" sid="LUK 2:48" />Riwa wa to waka ti sisiri, mba iyiwan ka tre riwa, &lt;&lt; A wu vren won ingye ti ko wu tita kawa? Kpunji ki si wa-u mbu tiwen rimi sron time.&gt;&gt;<verse eid="LUK 2:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49" />Imba Yeso ka mɨyen wa,&lt;&lt; Ingye ti ko bi si wa wen? Ashe bi ran to a he lele nowen me ti ndu Tiwon ran?&gt;&gt; <verse eid="LUK 2:49" /><verse number="50" style="v" sid="LUK 2:50" />Ama wa ka ran to tu tre riwa a lawa ran.<verse eid="LUK 2:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51" />Imba ka bru hi Nazarat iwawa, ran ran kpa tre mba iyi wan a ngɨzhi kyawa wanyi ri sron wan wawuu. <verse eid="LUK 2:51" /><verse number="52" style="v" sid="LUK 2:52" />Yeso ka gbron rimi to kyawa, nga senkpa ran fe zon ri Izhi nga wanji.<verse eid="LUK 2:52" /></para>
  <chapter eid="LUK 2" />
  <chapter number="3" style="c" sid="LUK 3" />
  <para style="s">Yohana nji ri Sonnji ri Mma a Mɨlan Nkon ti</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1" />Ri se ri wuru don ton riwa chu kaisar Tibariyas, Buntus Bilatu a he chu Yudiya Hirudus a he chu Galili, vayiwan Filibu a he chu ituriya ri Tarakunitas, nga lisaniya a he chu Abiliya, <verse eid="LUK 3:1" /><verse number="2" style="v" sid="LUK 3:2" />ri vi riwa Hanana mba kayafa, wa wa rinkon wa ndu Izhi, itre Izhi ka ye ri Yahaya ivren zakariya ri ji. <verse eid="LUK 3:2" /><verse number="3" style="v" sid="LUK 3:3" />Imba Yohana ka hu bubu nyu nne urdu wawu, ran ran tre tre Izhi, ri nji nowa ka meme ti mba chuwo nowa son wa ri ima, don nowa ka mememti mba rega riwa, <verse eid="LUK 3:3" /><verse number="4" style="v" sid="LUK 3:4" />Bibi riwa wa ngha ri mbe ishaya nji ri la tre Izhi ri,</para>
  <para style="q1" vid="LUK 3:4">&lt;&lt; Njo a ran yo rimi ji ri tre ri, mɨlan nkon Izhi ti,</para>
  <para style="q2" vid="LUK 3:4">no wa nkon wan noi ndɨri,<verse eid="LUK 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5" />&lt;Wa shu wa ŋfɨron bla,</para>
  <para style="q2" vid="LUK 3:5">bla wa tita ri wa gashi wa ziiwa.</para>
  <para style="q1" vid="LUK 3:5">Bubu riwa wawa wa kɨwan wa no he sron hi</para>
  <para style="q2" vid="LUK 3:5">Wa hu ri nkon riwa wana hu wa ran.<verse eid="LUK 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6" />Inji wawu wato kpachuwo riwa Izhi.&gt;&gt;<verse eid="LUK 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7" />Ritu kamba, Yohana a tre ri nji riwa ari ye riwa ran son wa ri ima, &lt;&lt; Biyi wa wan wa ntson! ŋnga layi noyi tsiri ri tu fu Izhi riwa ari ye yi? <verse eid="LUK 3:7" /><verse number="8" style="v" sid="LUK 3:8" />Ti kya riwa ari tsro ri bi ka meme ti ŋbi chuwo, ran gbuchi tre mba ri sronbi ri ibrai nye he timbi ran. Mi layi Izhi he ri gbengbren riwa ari ngɨzhi miri ri Ibrahi zu ri tita wanyin. <verse eid="LUK 3:8" /><verse number="9" style="v" sid="LUK 3:9" />Ko zizan wa ka nyu gla yo ri nchi konkron ritu inde konkron riwa a ran de kɨlo dindi ran wa ka tsen taga wari ban wu ta yo ri wuru.&gt;&gt;<verse eid="LUK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10" />Imba ikpanji-a waka mɨye Yohana ri, &lt;&lt; Ingye nye ki ti?&gt;&gt;<verse eid="LUK 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11" />Ka kpa nyime riwa ri, &lt;&lt;Inji riwa a he ri tsro hari, ka kari no nji riwa a ran he riwu ran, nji riwa a he ri la no wawu ngawen no ti kamba.&gt;&gt;<verse eid="LUK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12" />Wawa wa kpa nkɨren ri meme wa ye ri nowa son wawa rimi ima ngawen, waka tre riwu, &lt;&lt; A wu nji ri tsro, ngye nye kiti?&gt;&gt; <verse eid="LUK 3:12" /><verse number="13" style="v" sid="LUK 3:13" />Yohana ka tre riwa,&lt;&lt; Ran kpa han kya riwa wa tre no yi kpa ran.&gt;&gt;<verse eid="LUK 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 3:14" />Wa lokpa wari waka miyen, &lt;&lt; Ko kita fa, ki ti rise?&gt;&gt;Mba ka kpa nyme riwa,</para>
  <para style="p" vid="LUK 3:14">&lt;&lt;Ran vu njo kyawan ra, ko bi no sisiri ran, biyi de ka sron bi yo ri kya riwa bi kpa ri huwa ŋbi.&gt;&gt;<verse eid="LUK 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15" />Riwa a he wawu nji wa yo sron, wawu mba wa ri rimɨreri sron ritu Yohana, ko aya he wawu nye he nji ri kpa nji chuwo. <verse eid="LUK 3:15" /><verse number="16" style="v" sid="LUK 3:16" />Imba Yohana ka kpa yɨme riwa wawu mba ran tre,&lt;&lt; Ame de ri ima nye me vu yi ri son, ama nji ri riye riwa a han wen riwa ko ntan zawan me ran to siwu ran. wawu nye ri son yi ri ima ri wu Tsitsri, nga ri wuru. <verse eid="LUK 3:16" /><verse number="17" style="v" sid="LUK 3:17" />Bibɨre ri zen kpi wan he ri wo wan, ari se bubu penpiren, ran vu wɨlo alikama sro ri wuron wan, ama nfon wan ari gon wu ri wuru riwa a ran yɨwi ran.&gt;&gt; <verse eid="LUK 3:17" /><verse number="18" style="v" sid="LUK 3:18" />Ri bibi nowen tre wari kigbu nye, Yohana a tre tre Izhi ri nji. <verse eid="LUK 3:18" /><verse number="19" style="v" sid="LUK 3:19" />Ama ichu Hirudus ,riwa yoana a tre fu riwu ritu wa vayi wan Hirudiya, ri ngbron meme ti riwa a ti, <verse eid="LUK 3:19" /><verse number="20" style="v" sid="LUK 3:20" />Imba Hirudus ka bru tren yoana ri tra trenji.<verse eid="LUK 3:20" /></para>
  <para style="s">Ison Yeso ri Mma</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21" />Riwa wa son ji ri ima wawumba, wari son Yeso ri ima ngawen, riwa a bre Izhi, mba ishu wuru ka bu. <verse eid="LUK 3:21" /><verse number="22" style="v" sid="LUK 3:22" />Iyu Ri Tsitsri ka ye riwu ri bibi kpa riwa a zhu nguu mba waka wo ran rishu a tre, &lt;&lt;A wu nye wuhe vren won riwa me yɨwe u, me ti kinklan sron riwu bran bran.&gt;&gt;<verse eid="LUK 3:22" /></para>
  <para style="s">Watiti Yeso</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23" />Riwa Yeso a gbuchi ran tsro, a he ri se setra wa ban u ri, a he vren Yusufu nye, Riwa a he vren Heli <verse eid="LUK 3:23" /><verse number="24" style="v" sid="LUK 3:24" />Heli ivren Matal, Matal Vɨren Lawi, Lawi Ivren Malki, Malki ivren Yanna, Yanna Ivren Yusufu, <verse eid="LUK 3:24" /><verse number="25" style="v" sid="LUK 3:25" />Yusufu vren Matatiya, Matatiya ivren Amos, Amos ivren Nahum, Nahum ivren Hasili, Hasili ivren Najaya, <verse eid="LUK 3:25" /><verse number="26" style="v" sid="LUK 3:26" />Najaya ivren Maata, Maata ivren Matatiya, Matatiya ivren Shimeya, Shimeya ivren Yusufu, Yusufu ivren Yauza, <verse eid="LUK 3:26" /><verse number="27" style="v" sid="LUK 3:27" />Yauza ivren Yowana, Yowana ivren Rafaya, Refaya ivren Zarubabel, Zarubabel ivren Shealtiyel, Sheyaltiyel ivren Niri, <verse eid="LUK 3:27" /><verse number="28" style="v" sid="LUK 3:28" />Niri ivren Malki, Malki ivren Addi, Addi ivren Kosama, Kosama ivren Almadama, Almadama ivren Er, <verse eid="LUK 3:28" /><verse number="29" style="v" sid="LUK 3:29" />Er ivren Yosi, Yosi ivren Eliyeza, Eliyeza ivren Yorima, Yorima ivren Matat, Matat ivren Lawi, <verse eid="LUK 3:29" /><verse number="30" style="v" sid="LUK 3:30" />Lawi ivren Saminu, Saminu ivren Yauza, Yauza ivren Yusufu, Yusufu ivren Yohana, Yohana ivren Eliyakim, <verse eid="LUK 3:30" /><verse number="31" style="v" sid="LUK 3:31" />Eliyakim ivren Matata, Matata ivren Natan, Natan ivren Doda, <verse eid="LUK 3:31" /><verse number="32" style="v" sid="LUK 3:32" />Doda ivren Yesse, Yesse ivren Obida, Obida ivren Boaza, Boaza ivren Salmon, Salmon ivren Nashon, <verse eid="LUK 3:32" /><verse number="33" style="v" sid="LUK 3:33" />Nashon ivren Amminadab, Amminadab ivren Aram Aram ivren Hesruna, Hesruna ivren Feresa, Feresa ivren Yauza, <verse eid="LUK 3:33" /><verse number="34" style="v" sid="LUK 3:34" />Yauza ivren Yakubu Yakubu ivren Ishaku, Ishaku ivren Ibrahim Ibrahim ivren Tera, Tera ivren Naor, <verse eid="LUK 3:34" /><verse number="35" style="v" sid="LUK 3:35" />Nahor ivren Serug, Serug ivren Reyu, Reyu ivren Feleg, Feleg ivren Eba, Eba ivren Shela, <verse eid="LUK 3:35" /><verse number="36" style="v" sid="LUK 3:36" />Shela ivren Kenan, Kenan ivren Arfakshad, Arfakshad ivren Shem, Shem ivren Nuhu, Nuhu ivren Lamek, <verse eid="LUK 3:36" /><verse number="37" style="v" sid="LUK 3:37" />Lamek ivren Metusela, Metusela ivren Anuhu, Anuhu ivren Yared, Yared ivren Maalel, Maalel ivren Kenan, <verse eid="LUK 3:37" /><verse number="38" style="v" sid="LUK 3:38" />Kenan ivren Enosh, Enosh ivren Shitu, Shitu ivren Adamu, nga Adamu Ivren Izhi.<verse eid="LUK 3:38" /></para>
  <chapter eid="LUK 3" />
  <chapter number="4" style="c" sid="LUK 4" />
  <para style="s">Wa Tsɨra Yeso</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1" />Yeso a zhu ri ba Urdu ye ri wu Tsitsri wan shu ri sron. Iyu ri tsɨtsɨri ka ran joo no hi ji, <verse eid="LUK 4:1" /><verse number="2" style="v" sid="LUK 4:2" />Hari vi senza memenji a tsra u. Rimi vi wayyin a ran ri kyari ran. Riwa ivi wayin wa kre iyon ka tiwu.<verse eid="LUK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3" />Memenji ka tre riwu, &lt;&lt;inde wuhe vren Izhi wuka no tita nyi no kɨma ti juju yɨmo.&gt;&gt;<verse eid="LUK 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4" />Yesu ka kpa yɨme ran tre, &lt;&lt;A he rimi ngha ri, &lt;Aran he ritu ri juju yɨmo nye ŋkaŋshe nji ri nawo ran.&gt;&gt;&gt;<verse eid="LUK 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5" />Imba memenji-a ka ngɨzhi wu hi bubu ri ri shu, ran tsɨro-u bibi riwa ŋgbugburu mme he. <verse eid="LUK 4:5" /><verse number="6" style="v" sid="LUK 4:6" />Memenji ka tre, &lt;&lt;A wu nye me nowu kpa kyawa nyi nowa he ri wo wen, ri wa nkpen mba, ritu riwa wa kau nowen, me ye me ka no nji riwa me su. <verse eid="LUK 4:6" /><verse number="7" style="v" sid="LUK 4:7" />Inde wu kɨbu ngbazhu rimo wa he wame wawu.&gt;&gt;<verse eid="LUK 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8" />Yeso ka kpa yɨwen riwu ri, &lt;&lt;A he rimi ngha ri, &lt;ka tuwen no Izhi wen wawu ri kankshe wan nye wu kɨbu ngbazhu riwu.&gt;&gt;&gt;<verse eid="LUK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9" />Memenji ka bru ban wu hi ri Urushelima, ran ngɨzhi u hon ritu bubu riwa a zen han rimi tra Izhi, ran tre riwu, &lt;&lt;Inde wu he vren Izhi, wuka zhu nyi zaku rɨmeme. <verse eid="LUK 4:9" /><verse number="10" style="v" sid="LUK 4:10" />A he rimi ngha ri, &lt;Izhi ri no miriko wan ritu wen nowa mɨlau ngɨzhi &gt; <verse eid="LUK 4:10" /><verse number="11" style="v" sid="LUK 4:11" />wa ndzu wu ban shu ri wo mba, don noran kɨbu za ri tita ran.&gt;&gt;&gt;<verse eid="LUK 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12" />Imba Yeso ka yɨme riwu ri, &lt;&lt;A tre ri, &lt;Ran tsra Bachi Izhi wen ran.&gt;&gt;&gt;<verse eid="LUK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13" />Kugon riwa Memenji a kre bibi tsra wan wawu, ran kau chuwo ri vi tsawen ri.<verse eid="LUK 4:13" /></para>
  <para style="s">Yeso a Gbuchi Tindu ri Galili</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14" />Imba Yeso a bru hi ri meme Galili, gbengbren wu ka he ri wu. Itre wan a shan kagon gbu wawu. <verse eid="LUK 4:14" /><verse number="15" style="v" sid="LUK 4:15" />Imba ka sondu tsro rimi tra Izhi mba, wawu mba waka ran no nkpen.<verse eid="LUK 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16" />Imba Yeso ka ye ri Nazara bubu riwa a son ran gbron, ka gra riri tre Izhi chachu son vɨri mba bibi riwa a ran ti. Imba ka wurunde riwa ari kɨra. <verse eid="LUK 4:16" /><verse number="17" style="v" sid="LUK 4:17" />Wa ka no mba Ishaya nji ri la tre Izhi, ka bu mbe<verse eid="LUK 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18" />&lt;&lt;Iyu Bachi he ri me,</para>
  <para style="q2" vid="LUK 4:18">Riwa ari gban wen nowen</para>
  <para style="q2" vid="LUK 4:18">bla tre Izhi ri wawa wana he ri kya ran.</para>
  <para style="q1" vid="LUK 4:18">A ti wen ndu nowen hi tre tre Izhi ri nji ritu ka wawa wa lowa chuwo,</para>
  <para style="q2" vid="LUK 4:18">nga me ri bu si wa mfɨyen,</para>
  <para style="q1" vid="LUK 4:18">me ri kpa wawa wa chan wa,<verse eid="LUK 4:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="LUK 4:19" />Me ri tre tre nzan riwa tilɨbu riwa Izhi.&gt;&gt;<verse eid="LUK 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20" />Imba ran kambe-a ka no nji riwa ari tindu Izhi, ran kuson. Isi kon ngha ri tra Izhi-a ka he ritu wan, <verse eid="LUK 4:20" /><verse number="21" style="v" sid="LUK 4:21" />Imba ka gbuchi tre riwa,&lt;&lt; Luwa itre nyi gra ri ton mbi.&gt;&gt;<verse eid="LUK 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22" />Wawu mba waka yii, wari ti sisiri tre wan ri dindi ti riwa a la, hari wari tre,&lt;&lt; Rinyi ran he vren Yusufu ran.&gt;&gt;<verse eid="LUK 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23" />Yeso ka tre riwa,&lt;&lt; Lele bi lawen tu tre nyi,&lt;Nji ri den nji, den ngawen kpa chuwo.&gt; Nga bi tre rimo, Ikya riwa kiwo riwa wuti ri kafarnaum, ti ri gbu mbi nyi mana,<verse eid="LUK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 4:24" />Ka tre nganga ri, &lt;&lt;kpunji tre me layi,&gt;&gt; Ba nji ri la tre, &lt;&lt;Izhi riwa wa a kpa nyɨme riwu ri gbu mba, <verse eid="LUK 4:24" /><verse number="25" style="v" sid="LUK 4:25" />Ama me layi kpunji tre, ri nzan Iliya mba wa-kɨwo wa he kigbu ri Israila wato ri vi riwa iwulu a ran ye ran ti se tra ri huwa tanren, riwa iyon ri bran a gra ri meme-a wawu. <verse eid="LUK 4:25" /><verse number="26" style="v" sid="LUK 4:26" />Ri kamba wa ka ran ti Iliya nbu ri ko riri mba ran, tse iwa ri kankshi wan ri zarifat riwa meme sidon riwa iron wan a kuu. <verse eid="LUK 4:26" /><verse number="27" style="v" sid="LUK 4:27" />Ri nzan Elisha nji tindu Izhi, nga wa nkpuzhu kigbu wa he ri Israila, ba ko riri riwa wa tsɨri-u ara Naama nji Suriya, nkankshe wan.&gt;&gt;<verse eid="LUK 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28" />Riwa wawo kamba, gbunji riwa wa rimi tra Izhi wa ka tifu riwu branbran, <verse eid="LUK 4:28" /><verse number="29" style="v" sid="LUK 4:29" />Waka wurunde wari ngɨzhi wu hi ri kugon gbu, hari wari ngɨzhi wu ka zhu ritu ngbɨlu riwa wa mme gbu mba ritu wan, riwa wa ta yo ri behen wan. <verse eid="LUK 4:29" /><verse number="30" style="v" sid="LUK 4:30" />Ama Yeso ka ga wa dzu ri tsutsumba ran hi ngawan.<verse eid="LUK 4:30" /></para>
  <para style="s">Nji ri ri Meme Bɨzhi</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31" />Imba ke ri kafarnaum, ri gbu ri riwa wayo ri meme Galili a ran tsro wa chachu sonvɨri <verse eid="LUK 4:31" /><verse number="32" style="v" sid="LUK 4:32" />Wa ka ti sisiri tsɨrowan ritu riwa kpunji tre a he rimi wan.<verse eid="LUK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 4:33" />Rimi tra Izhi-a nji ri a he riwa a he ri bɨzhi shnji Imba ka zu ran gbangban ran tre. <verse eid="LUK 4:33" /><verse number="34" style="v" sid="LUK 4:34" />&lt;&lt;Iya kao! Ingyebi wa ri ta, Yeso nji ri Nazara? Wu ye riwa wa wuuta nye? Meto nji riwa wuhe, Wu he ri Tsitsri wan nye riwa Izhi.&gt;&gt;<verse eid="LUK 4:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35" />Imba Yeso ka yɨra ngha ran tre, &lt;&lt; Son ngbangbi! kawu don!&gt;&gt; Kugon riwa ibɨji meme a kawu ta ga ri tsutsu mba, a kau don, a ran sen-u ran.<verse eid="LUK 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36" />Rimba sisiri ka vuwa wawumba, wa ka tre ri kamba ri, &lt;&lt;Itre bibi tan nye? ngye ngha, ari he bibi riwa a tre, nga ari tre ba sisiri, ari zu bɨzhi wa shnji kuma wa zhu.&gt;&gt; <verse eid="LUK 4:36" /><verse number="37" style="v" sid="LUK 4:37" />Itre ka yɨra gra kagon gbu.<verse eid="LUK 4:37" /></para>
  <para style="s">Yeso a Kpa Kpanji wa lilo Chuwo</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38" />Imba ka wurunde rimi tra Izhi ran hi ko Bitrus. Iyi Bitrus ka ran fama ri meme nbɨzhu, Imba waka bre wu ritu wan. <verse eid="LUK 4:38" /><verse number="39" style="v" sid="LUK 4:39" />Imba ka kri ritu wan, ran yira lilo nbɨzhu ngha, ka kawu chuwo, me ron ka wurunde ran gbuchi ran tindu riwa.<verse eid="LUK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40" />Ri yawuru a ran ti, wawa wa ri wa lilo, wa lilo kankan, waka ngɨzhi wa ye riwu. Imba ka kpawa chuwo. <verse eid="LUK 4:40" /><verse number="41" style="v" sid="LUK 4:41" />Ibɨji waka zhu ri kpa nji kigbu, wa ran kpa-gɨro wari tre ri,&lt;&lt;A wu wu he vren Izhi nye!&gt;&gt;Ama a tre fu riwa nga ran nowa ran tre ran, ritu wa to ri a he Kristo.<verse eid="LUK 4:41" /></para>
  <para style="s">Yeso a Bla tre Izhi ri Tra Bre Izhi</para>
  <para style="r">(Mark 1.35-39)</para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42" />Riwa imibrea kpan Yeso ka zhu ra, Imba ikpanji waka ran wa-u, waka ye riwu. Wana wa wari kri ri wu noran kawa don ran. <verse eid="LUK 4:42" /><verse number="43" style="v" sid="LUK 4:43" />Ama Yeso ka tre riwa ri,&lt;&lt; A bi riwa me hi meri tre tre Izhi ri ngbron gbu wari ngawen, ritu rinyi nye wa ti wen ndu ye.&gt;&gt; <verse eid="LUK 4:43" /><verse number="44" style="v" sid="LUK 4:44" />Imba ka sondu tre tre Izhi ri tra Izhi ri meme Galili.<verse eid="LUK 4:44" /></para>
  <chapter eid="LUK 4" />
  <chapter number="5" style="c" sid="LUK 5" />
  <para style="s">Iyo Miriko Wan wa Gbuchi</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1" />Chachu ri Yeso kukri ri nyu nne nji wa kagbamu ri wu ritu riwa wawa wa ri wo tre Izhi, wawu Yeso ka kri rinyu nne Janisarata. <verse eid="LUK 5:1" /><verse number="2" style="v" sid="LUK 5:2" />Imba ka to nvuima wari hari wa tsitsa, rinyu nne, wavu lamba waka zhu rimi mba wari ran ngla jiji ri vu lambe mba. <verse eid="LUK 5:2" /><verse number="3" style="v" sid="LUK 5:3" />Imba Yeso ka gra rimi ri rimimba, riwa Bitrus, ran ibreu, ri bubu wan no tru nvuma ban kusi jɨo rinyu ima. Ran gra tsɨrowa tre ri kpanji rimi nghɨma.<verse eid="LUK 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4" />Riwa a kre tre-a, ran tre ri Bitrus, &lt;&lt;Turu nvuima wen hi bubu riwa a ti ron, bi ri ta jiji ri vu lambe mbi tayo bi ri gbi lambe zhu riima.&gt;&gt; <verse eid="LUK 5:4" /><verse number="5" style="v" sid="LUK 5:5" />Bitrus ka tre riwu ri, &lt;&lt;A wu Njiriko, tu richu ki sondu tiya, kiran vu kya ran ama tunde wu tre, me ta jiji rivu lambe won yo.&gt;&gt;<verse eid="LUK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 5:6" />Riwa wa tayo waka vu lambe kigbu tata hari jiji ri vu lambe mba ka gbuchi ran gbon. <verse eid="LUK 5:6" /><verse number="7" style="v" sid="LUK 5:7" />Waka yo wa kpan ndu mba riwa wa ri nvu ima ri han nowa ye zon wawa, waka ye, wari vu wa lambe shu nvu ima ngamba wari ran wa wari den Bachi.<verse eid="LUK 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 5:8" />Riwa Bitrus a to kamba, ran ku kusi Yeso ran tre, &lt;&lt;A wu Bachi, ame me he ngha riwa wu kri kusan won, ritu riwa me he nji ri meme ti.&gt;&gt; <verse eid="LUK 5:8" /><verse number="9" style="v" sid="LUK 5:9" />Ritu riwa wawu Bitrus ri wawa wa he wawa wa hu, waka ti sisiri ritu lambe riwa wa gbi zhu, <verse eid="LUK 5:9" /><verse number="10" style="v" sid="LUK 5:10" />a he kamba nye Yakubu ri Yohana imiri Zabadi, ikpan ndu Bitrus.</para>
  <para style="p" vid="LUK 5:10">Yeso ka tre ri Bitrus, &lt;&lt;Ran ti sisiri ran rinyi hi kusi bi ran vu nji ron.&gt;&gt; <verse eid="LUK 5:10" /><verse number="11" style="v" sid="LUK 5:11" />Riwa wa vu nvuima mba ye ri nyura wari ka konge chuwo wari hu.<verse eid="LUK 5:11" /></para>
  <para style="s">Yeso a Kpa nji ri Nkpuzhu Chuwo</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12" />Chachu ri Yeso a he rimi gbu ri, tse nji ri kae ri lilo nkpuzhu a han gbengbren wan ka ye, riwa a to Yeso ran ku kusi wan, ran ibreu ri, &lt;&lt;A wu Bachi, nde wu kpa nyɨme ri wuhe ri gbengbren riwa wu kpa wen chuwo.&gt;&gt;<verse eid="LUK 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13" />Imba Yeso ka nɨma wo ran ibreu wo ran tre ri, &lt;&lt;Me kpa yɨme, lilo mba kre,&gt;&gt; Imba me ron lilo nkpuzhu-a ka kado.<verse eid="LUK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 5:14" />Yeso ka fen u ton iri no ran la njo ran, ran lawu &lt;&lt;Tse de hi ri nji riwa ari tindu ri Izhi no to-u, nga wuri ti hadaya ritu riwa wa kpa-u chuwo, nga ritu riwa nowa to ngawen, bibi riwa Musa a lawa.&gt;&gt;<verse eid="LUK 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15" />Ama itre Yeso ka kawan ran yɨra shu gbu hari ikpanji wa ka kamba ran ye ritu wa ri wou. nga kpa chuwo ritu lilo mba. <verse eid="LUK 5:15" /><verse number="16" style="v" sid="LUK 5:16" />Ama wawu ka ran sonma nkan ri bubu riwa njo ran he ran, ran bre Izhi.<verse eid="LUK 5:16" /></para>
  <para style="s">Yeso a Kpa Nji ri Lilo Klukpa Chuwo</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17" />Chachu ri riwa a ran tsro, wawa wa kɨra doka Musa, nga wawa wa tsro doka riwa a zhu ri vi gbu wawa wa kagon Galili nga Judiya mba Jerusalem, wa ki ri bubu wan. Nga gbengbren Bachi a he riwu a ri kpa wa lilo chuwo. <verse eid="LUK 5:17" /><verse number="18" style="v" sid="LUK 5:18" />Inji wari wa ban nji ri lilo klukpa ri ntanbɨri wati kukuri riwa wa ngiji-u gra rimi ko wari kau yo kusi Yeso. <verse eid="LUK 5:18" /><verse number="19" style="v" sid="LUK 5:19" />Riwa wa wa bubu gyen riwa wa ngɨzhi wu gra ritu nji wa kigbu, wa ka hon shu ritu ko wari kau yo zu tutra yo ri tsutsunji, ri kusi Yeso.<verse eid="LUK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 5:20" />Riwa Yeso a to kpanyɨme mba, a tre, &lt;&lt;Ikpan won, wa ka meme ti wen chuwo riwu.&gt;&gt;<verse eid="LUK 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21" />Wa hu doka Musa nga wawa wa tsro doka wa gra taka ri kanba,&lt;&lt;Rinyi he ngha riwa a ye kpande ri time? Ngha ri ka meme ti nji chuwo imba Izhi kankɨshi wan ba?&gt;&gt;<verse eid="LUK 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22" />Yeso a to kya riwa wa takaa ran mɨyen wa, &lt;&lt;Ngye ti ko bi taka bibi kya wa nyi rimi siron mbi? <verse eid="LUK 5:22" /><verse number="23" style="v" sid="LUK 5:23" />Ritan nye he huri nowa tre ri,&lt;Wa ka meme ti mbi chuwo yi,&gt; Ka wa tre,&lt;wurunde bi ri zɨren&gt;? <verse eid="LUK 5:23" /><verse number="24" style="v" sid="LUK 5:24" />Ama bi to ri ivren Izhi he ri gbengbren ri meme riwa ari kameme ti chuwo.&gt;&gt;A tre ri nji riwa a klukpa,&lt;&lt;Me lau, wurunde, ban ntanbɨri wen wuri hi ko.&gt;&gt; <verse eid="LUK 5:24" /><verse number="25" style="v" sid="LUK 5:25" />Rimba ka mɨren wurunde kusimba, ran ban kya riwa a ran kru ritu wan ran hi ko ri kinklan sron ri gbresan nde Izhi. <verse eid="LUK 5:25" /><verse number="26" style="v" sid="LUK 5:26" />Ko ngha kana ti mamaki ran gbre Izhi, wa ka ti sisiri mgbazhi ran, waka tre ri, &lt;&lt;Ruwa ki to kyawa wa sisiri!&gt;&gt;<verse eid="LUK 5:26" /></para>
  <para style="s">Iyo Lawi</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27" />Kugon kamba, ka to nji ri riwa ari kpa nkɨren meme, inde wan a he lawi, a son mme, a ran tindu bubu kpa nkɨren meme. , Yeso ka tre riwu, &lt;&lt;Hu wen.&gt;&gt; <verse eid="LUK 5:27" /><verse number="28" style="v" sid="LUK 5:28" />Lawi ka ka kongye don iwawu, ran wurunde hu.<verse eid="LUK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29" />Imba lawi ka ti bi ri ri tsawen ri kowan, mba nji wa kpa nkɨren meme waka ki wari ran ri ri iwanji wari. <verse eid="LUK 5:29" /><verse number="30" style="v" sid="LUK 5:30" />Imba wa wa wato doka Musa waka tre zhuzhu tre ri miriko wan wari tre ri,&lt;&lt;Ingye ti ko bi ri ri ri wawa wa kpa nkɨren meme nga wa meme ti?&gt;&gt;<verse eid="LUK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31" />Yeso ka yɨme riwa ran tre,&lt;&lt;Wawa wa ri si kpa he risikpa wana wa wa den lilo ran, ara wawa wa lo lilo nye wa wa wa den. <verse eid="LUK 5:31" /><verse number="32" style="v" sid="LUK 5:32" />Me ran ye ritu yo wa dindi ti ran, tsede ritu wa meme ti, nowa ka meme ti mba chuwo.<verse eid="LUK 5:32" /></para>
  <para style="s">Wa Mɨyen Yeso Ritu Vu La Mma</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33" />Waka tre riwu, &lt;&lt;Imiri ko Yohana wa vu ima ran bla vi, wa ri ran bre Izhi, imɨriko wa tsro doka Musa, ama riwa me wari ri wari so.&gt;&gt;<verse eid="LUK 5:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34" />Tse Yeso ka tre riwa, &lt;&lt;Wato biyi bi to no kpa nji riwa a kpa wa sa nowa vu la ima ka nji riwa a kpa wasa he? <verse eid="LUK 5:34" /><verse number="35" style="v" sid="LUK 5:35" />Ama ivi riye riwa wa ban nji riwa wa ban nji riwa a kpa wa sa joo. Rimba nye wa vu la ima.&gt;&gt;<verse eid="LUK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36" />Ran bru tre kɨbu tre riwa, ran tre, &lt;&lt;Ban nji riwa ari gbon tsro sisa ran ka wɨran lagba tsro riwu, nde wa ti, ai ari gbon nghɨma tsro sisa, itsɨro sisa ri gbon nghɨma tsro sisa ran bi ri lagba tsro ran. <verse eid="LUK 5:36" /><verse number="37" style="v" sid="LUK 5:37" />Nga ba njo riwa ari sro nfɨrɨi rimi vaja wa ri kɨmon. nde ma wa sro, tse nfɨri hi ri sisa ri yira vaja wa a ka rega, wa vaja waka time. <verse eid="LUK 5:37" /><verse number="38" style="v" sid="LUK 5:38" />Nfɨrɨi, ai tse vaja wa sa. <verse eid="LUK 5:38" /><verse number="39" style="v" sid="LUK 5:39" />Ba nji riwa ari wa ran son nfɨrɨi kugon ri wa a so sisa, don ran tre ri, &lt;Ai ri kɨmo wan bi han,&gt;&gt;<verse eid="LUK 5:39" /></para>
  <chapter eid="LUK 5" />
  <chapter number="6" style="c" sid="LUK 6" />
  <para style="s">Bachi ri Chachu son Vɨri</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1" />Chachu ri a he chachu son vɨri Yeso a gra zu ri zhu alikama, imiriko wan waka vu tu wari ran won riwo mba wa ran tan wɨlo. <verse eid="LUK 6:1" /><verse number="2" style="v" sid="LUK 6:2" />Tse wa tsro doka musa waka tre, &lt;&lt; ngye ti ko bi ti kya riwa a ran bi nowa ti chachu son vɨri ran?&gt;&gt;<verse eid="LUK 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3" />Yeso ka kpa yɨme ran tre, &lt;&lt; A zhu ka bi ran kɨra to zari ran ikya riwa Doda a ti ri vi riwa iyon a ran tiu wawa wa kpan zɨren wan? <verse eid="LUK 6:3" /><verse number="4" style="v" sid="LUK 6:4" />Bibi riwa a gra ri tra Izhi, a ban juju yɨmo riwa kpan zɨren wan riwa a ran bi riwa kon ngha ri ri ran tse wa tindu Izhi ŋkaŋkshimba?&gt;&gt; <verse eid="LUK 6:4" /><verse number="5" style="v" sid="LUK 6:5" />Imba Yeso ka tre riwa,&lt;&lt; Ai, Ivren Izhi wawu nye he Bachi ri chachu son vɨri.&gt;&gt;<verse eid="LUK 6:5" /></para>
  <para style="s">Inji ri Lilo Kɨlu wo</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6" />Chachu son vɨri ri nganga a gra rimi tra Izhi, ran ran tsro, nji ri a he rimi mba ri wa iwo wan ri ku wori a gblu kado. <verse eid="LUK 6:6" /><verse number="7" style="v" sid="LUK 6:7" />Tse wa tsro tre Izhi ri wa tsro doka Musa waka yo si wari to ko ari den nji chachu son vɨri, don wari ka ngɨzhi wu hi ri wa sron mmo. <verse eid="LUK 6:7" /><verse number="8" style="v" sid="LUK 6:8" />Ama Yeso ka to sron mba.Tse ka miyen nji riwa a gblu wo,&lt;&lt; Wulu kri ri kusi ko ngha.&gt;&gt; Imba ka wurunde ran kri ri bubu wan.<verse eid="LUK 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 6:9" />Imba Yeso ka tre riwa, &lt;&lt; Me mɨyen yi, a bi nowa ti dindi chachu son vɨri ka nowa ti meme ti? Nowa kpa nji chuwo ka nowa wuu?&gt;&gt;<verse eid="LUK 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 6:10" />Imba ka ya wa wawu, ran tre ri nji-a&lt;&lt; De wo wen.&gt;&gt;Ka de, iwowan ka bru ran ye bubu wan. <verse eid="LUK 6:10" /><verse number="11" style="v" sid="LUK 6:11" />Imba isron mba ka time branbran, wa ka tre ri tsutsu mba ikya riwa wati ri Yeso.<verse eid="LUK 6:11" /></para>
  <para style="s">Imiri Ndu Izhi Wuru Donhari</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12" />Rimi vi wamu Yeso a hi kusan gashi ri wa ari bre Izhi, ran son ti chu ran bre Izhi. <verse eid="LUK 6:12" /><verse number="13" style="v" sid="LUK 6:13" />Riwa imibrea kpan, Ka yo miri ko wan ye, Ran chu wuru don hari rimi mba, riwa wa he wa imirindu Izhi: <verse eid="LUK 6:13" /><verse number="14" style="v" sid="LUK 6:14" />Sima riwa a yo wu ri Bitrus, Vayi wan Andɨru, Yakubu, Yohana, Filibu, Batalomi, <verse eid="LUK 6:14" /><verse number="15" style="v" sid="LUK 6:15" />Matiyu, Toma, Yakubu ivren Haifa, Ri Saminu riwa wa yo wu ri zaloti, <verse eid="LUK 6:15" /><verse number="16" style="v" sid="LUK 6:16" />Ri Yauza ivren Yakubu, nga Yauza iskariyoti, riwa a reri Yeso.<verse eid="LUK 6:16" /></para>
  <para style="s">Yeso a Tsro wa ran Kpanji chuwo</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17" />Rimba ka gɨzhi ye riwa mirindu wan ran kri ri bubu kɨshu nji. Ga gbunji wana hu, nga kpanji wa kigbu bran riwa wa zhu ri meme Yudiya, ri Urushelima, nga Yaŋke meme Taya ri Sidon riwa a he ri nyu ba, wawa wa ye riwa wa wo, wari kpawa chuwo ri wa lilo mba. <verse eid="LUK 6:17" /><verse number="18" style="v" sid="LUK 6:18" />Wawa wa bɨzhi wa shnji wa nowa ya wa ka kpa wa chuwo. <verse eid="LUK 6:18" /><verse number="19" style="v" sid="LUK 6:19" />Wawu nji wana wa wari bre wu wo, ritu wa gbengbren a ran zhu ri kpa wan, ka kpa wa chuwo iwawu.<verse eid="LUK 6:19" /></para>
  <para style="s">Kinklan Sɨron nga Shnji Sɨron</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20" />Imba Yeso ka nzu tu, ran ya miriko wan ran tre,</para>
  <para style="q1" vid="LUK 6:20">&lt;&lt; Dindi wan ri ran hu yi, bi yi wa ya,</para>
  <para style="q2" vid="LUK 6:20">don kpanchison Izhi he wambi.<verse eid="LUK 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21" />Dindi wan ri ran hu yi biyi wawa iyon ri tiyi zizan,</para>
  <para style="q2" vid="LUK 6:21">don wa hushi ri yi.</para>
  <para style="q1" vid="LUK 6:21">Dindi wan rina huyi biyi wa bi yi zizan,</para>
  <para style="q2" vid="LUK 6:21">don bi nza.<verse eid="LUK 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LUK 6:22" />Dindi wan ri ran huyi inde nji wa kamba ri yi,</para>
  <para style="q2" vid="LUK 6:22">i wa nga nghɨren yi zi</para>
  <para style="q2" vid="LUK 6:22">gran wari kɨrayitu,</para>
  <para style="q3" vid="LUK 6:22">Wari shɨma nde mbi ritu Vɨren Nji.<verse eid="LUK 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 6:23" />&lt;&lt;Ti kinklan sron chachu nyi, bi ri nza ritu kinklan sron, ngye ngha, ife ri ndu mbi kigbu ri shu kamba nye wati watimba ri wa ti ri wa la tre Izhi.<verse eid="LUK 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24" />&lt;&lt; Iya mbi, biyi wa wa bi he ri wo,</para>
  <para style="q2" vid="LUK 6:24">don bi gbuchi fe wa bi.<verse eid="LUK 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25" />&lt;&lt;Iya mbi, biyi wawa bi hushi zizan,</para>
  <para style="q2" vid="LUK 6:25">don iyon ri ti yi, iya mbi,</para>
  <para style="q1" vid="LUK 6:25">biyi wawa bi ndza zizan,</para>
  <para style="q2" vid="LUK 6:25">don bi ti shnji sron, bi ri yi.<verse eid="LUK 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="LUK 6:26" />&lt;&lt;Iya mbi inde ko ngha ri tre dindi ri tu mbi,</para>
  <para style="q2" vid="LUK 6:26">kamba nye wati watimba watice ti watindu Izhi.<verse eid="LUK 6:26" /></para>
  <para style="s">Inyɨme wa kpanfu</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27" />&lt;&lt; Ama me layi, biyi wa wo wen, yɨme wa kpanfu mbi, ti dindi ti ri wawa wa kamba riyi, <verse eid="LUK 6:27" /><verse number="28" style="v" sid="LUK 6:28" />Ti rɨbu dindi sro wawa wa kɨra yi tu, wawa wa no yi ya, bi ka bre Izhi riwa. <verse eid="LUK 6:28" /><verse number="29" style="v" sid="LUK 6:29" />Inji riwa a wuru-u ri takpana, wuka kɨma ku ri hawan no nji riwa a vu-u tsro ri ka nbɨzhu ra wu ka chu tsro wen no. <verse eid="LUK 6:29" /><verse number="30" style="v" sid="LUK 6:30" />Inji riwa a bre wu, wu ka no, nji riwa a vu-u kpi wen ra, ran wau ran. <verse eid="LUK 6:30" /><verse number="31" style="v" sid="LUK 6:31" />Ikya riwa bi wa nowa ti ri yi, bi yi ti ri nji wari ngawen.<verse eid="LUK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32" />Inde bi yɨme wa kpan bi ri kankshi mba, ife ri ndu mbi he ngye? Ai, ko wa meme ti ma wa yɨme wa kpan mba. <verse eid="LUK 6:32" /><verse number="33" style="v" sid="LUK 6:33" />Nga inde wawa wa ti dindi ri yi nye bi ti dindi ti riwa, ife ri ndu ngye nye bi he riwu? Ai ko wa meme ti ma wa he kamba. <verse eid="LUK 6:33" /><verse number="34" style="v" sid="LUK 6:34" />Inde kuma wa wa bi ya iri wawa nye han yi ko bi nowa la, ife ri ndu mbi ri he ngye nye? Ai ko wa meme ti ngawen wa ya no wa meme ti nowa han wa tsra. <verse eid="LUK 6:34" /><verse number="35" style="v" sid="LUK 6:35" />Ama kpa yɨme ri wa kpanfu mbi, bi ri ran ti dindi ti riwa, no wa la ran yo sron rimi han ran. Lada mbi ri kigbu, bi he miri nji riwa wa gbresan, don wawu he nji ri dindi ti ri wawa wana ŋgiri ran ri wa meme ti. <verse eid="LUK 6:35" /><verse number="36" style="v" sid="LUK 6:36" />He wawa wa lo sron bibi riwa Bachi ri lo sron.<verse eid="LUK 6:36" /></para>
  <para style="s">Ran Bla Tre Ritu njo ran</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37" />Yeso a tre,&lt;&lt;Ran bla ri njo ran, biyi nga wan wana bla riyi ran. Ran ya njo ri meme ya ran, bi yi ngawen wana ti riyi ran, ka meme ti nji chuwo wa, biyi ngawen wa ka wambi chuwo riyi. <verse eid="LUK 6:37" /><verse number="38" style="v" sid="LUK 6:38" />Biyi de, biyi ngawe wa noyi rimi vangho ri tsra kpi riwa a sho kpe kpe, ari kri tu nzuruu, ari ran rega, wa ka riwa ari rega sro riyi ri nkon tsro bi. ngongo riwa wu tsra ri wu wawu nye wa tsra riyi.&gt;&gt;<verse eid="LUK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39" />Ka lawa tre kɨbu-kɨbu ri: &lt;&lt;Nji ri nfɨyen ri ngɨzhi nji fiwen zɨren? Wawa ngamba wana ku ri juju ran? <verse eid="LUK 6:39" /><verse number="40" style="v" sid="LUK 6:40" />Ivren rindu ran han nji ri ko wan ran. Ama ko ngha wa tsro wu bran ari he ka wawu nji ri kowan.<verse eid="LUK 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41" />Ingye ti ko wu ya vi giga riwa a he ri si vayi wen wuri ka kpolo wan riwa a he ri si wen don? <verse eid="LUK 6:41" /><verse number="42" style="v" sid="LUK 6:42" />Wu tise wuri to tre ri vayi wen ri, &lt;Vayi won, de me chu vi giga wu risi wen,&gt; Alali a wu ri tuwen wuran to kpolo wan riwa a he ri si wen ran? A wu memenji! Tse wu gbuchi chu kpolo giga riwa a he ri si wen ko wuri to vi giga riwa a he ri si vayiwen.&gt;&gt;<verse eid="LUK 6:42" /></para>
  <para style="s">Konkron ri Kɨlo wan</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43" />&lt;&lt;Konkron dindi ran ri kɨlo meme kɨlo ran, nga meme konkron a ran ri kɨlo dindi kɨlo ran. <verse eid="LUK 6:43" /><verse number="44" style="v" sid="LUK 6:44" />Ritu nganyi ko konkron ritan wa tou ritu bibi kɨlo wan. Ai wana ri kyen kɨlo mbuwa ri kpa nchon ran, ko ka ikilo ŋkiron ri ro ri kpa riwa ari ran. <verse eid="LUK 6:44" /><verse number="45" style="v" sid="LUK 6:45" />Inji ri dindi rimi tsutsu sron wan nye ari ti kya dindi, nga meme ri zhu ri tsutsu sron wa ari ti meme kya. Ai, ikya riwa a he ri sron nji nye ari ngɨzhi zhu ri ra.&gt;&gt;<verse eid="LUK 6:45" /></para>
  <para style="s">Wa Mme wa Wiwɨri ri wa Nkpɨran</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46" />&lt;&lt; Ritu ngye ko bi yowen ri Bachi, Bachi,&gt;&gt; Ama bi ran ri ti kya riwa me la ri yi ran? <verse eid="LUK 6:46" /><verse number="47" style="v" sid="LUK 6:47" />Ko ngha riwa ari ye rɨme, ran ri wo tre won, ran ri tindu riwu, me tsro yi bibi wan. <verse eid="LUK 6:47" /><verse number="48" style="v" sid="LUK 6:48" />A he bibi nji riwa ari mme ko, a shi mme ti ron ran zi nchi mme ritu han riwa iwulu a ye imba kashu ima ri yiwo ka ye ran kɨbu ko-a a ran chu ko-a ran ritu wa mme ritu han. <verse eid="LUK 6:48" /><verse number="49" style="v" sid="LUK 6:49" />Ama nji riwa a wo tre won, ran ran tindu riwa ran, a he bibi nji riwa a mme ritu meme nzan, a ran zin chi wan ran. ima yɨwo a ye ran kɨbu-u, iko-a ka zi gbru!&gt;&gt;<verse eid="LUK 6:49" /></para>
  <chapter eid="LUK 6" />
  <chapter number="7" style="c" sid="LUK 7" />
  <para style="s">Yeso a Kpa Vɨrendu Rinkon wa Lokpa chuwo</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1" />Riwa Yeso a kre la tre ri nji wawa wa ki ran wou, Ka gra ri Kaparnau. <verse eid="LUK 7:1" /><verse number="2" style="v" sid="LUK 7:2" />Ri Bubu wan a, rinkon wa lokpa ri Roma ri a he riwa ivren ko wan a ran he ri si ran ka he hure ri nkon kuu. Rinkon wa lokpa ri Roma ka ran su vren ko wan-a bran bran. <verse eid="LUK 7:2" /><verse number="3" style="v" sid="LUK 7:3" />Riwa a wo tre Yeso, ka ti wa rinkon wa nji Yahuda wari ndu hi ritu no wa bre wu no ye ran no vren ndu wan si. <verse eid="LUK 7:3" /><verse number="4" style="v" sid="LUK 7:4" />Wa rinkon nji Yahuda-a waka hi ri Yeso, waka bre wu bran bran, wa ri tre ri, &lt;&lt;Nji nyin a a he rewa wu zon wu, <verse eid="LUK 7:4" /><verse number="5" style="v" sid="LUK 7:5" />ritu a nyime wa nji mbu hari ran mme tra Izhi rita.&gt;&gt;<verse eid="LUK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 7:6" />Mba Yeso ka hu wa hi. Riwa a he wɨreri ko-a, rinkon wa lokpa ri Roma-a ka ti wa kpanwan ndu nowa lawu ri:&gt;&gt; Bachi, ran kpa sron wen time ran, ritu me ran he riwa wu ye rimi ko won ran. <verse eid="LUK 7:6" /><verse number="7" style="v" sid="LUK 7:7" />Me ran tsra riwa me ye kusi wen ran ama wu tre ri nyu ka kre, ivren ndu won ri fe si. <verse eid="LUK 7:7" /><verse number="8" style="v" sid="LUK 7:8" />Ame ma me ti ndu ri gbengbren nji ri, nga ri wa lokpa kusan won, me ya tre ri ri, &lt;Hi,&gt; Ari hi. Iri me ya tre wu &lt;Ye,&gt; Ari ye. Me la ti won ri, ti kya nganyi ari ti.&gt;&gt;<verse eid="LUK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9" />Ri wa Yeso a wo kamba, mamaki ka vu. ka kɨma ran la nji wawa wa hu, &lt;&lt;mi la yi yi, rimi Israila mi ran fe nji rimi ikpanyime ri senkpa ka rinyi zari ran.&gt;&gt; <verse eid="LUK 7:9" /><verse number="10" style="v" sid="LUK 7:10" />Riwa wawa wa ti wa ndu wa kɨma ran hi kamba ri ko rinkon wa lokpa ri Roma a, wa ka to ka ivren ndu a ka fe si.<verse eid="LUK 7:10" /></para>
  <para style="s">Yeso a ta Vɨren Wa ri Kɨbo Shɨme.</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11" />Aran bran vi ran, Yeso ka hi ri gbu ri wa yo ri Nyi, imirindu wan ri kpanji waka hu hi. <verse eid="LUK 7:11" /><verse number="12" style="v" sid="LUK 7:12" />Riwa wa hi hyure ri nkon gra ri mi gbu, wa ka to nji wari wa ran ye ri kɨmo vrenze ri, riwa iyi wan ngɨzhi wu wawu kankɨshi wan, iron yi wan ka kuu. Ikpanji ri gbu wa ngɨzhi wu ran tinkon. <verse eid="LUK 7:12" /><verse number="13" style="v" sid="LUK 7:13" />Ri wa Bachi a to iwa- a, ka lo sron ka la wu, &lt;&lt;Ran yi ran.&gt;&gt;<verse eid="LUK 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 7:14" />Ka hi ran bre wo ri akpati kɨmo a, nga nji wawa wa ngɨzhi kɨmo-a, wa ka kukiri. Yeso ka tre &lt;&lt;Ivɨvenze, mi lawu ri, wurunde!&gt;&gt; <verse eid="LUK 7:14" /><verse number="15" style="v" sid="LUK 7:15" />Imba ivren riwa a kuu-a ka wurunde ran kuson, ka gbuchi ran tre. Yeso ka ka vren-a ka no yi wan.<verse eid="LUK 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16" />Sisiri ka ti wa, waka gbresan nde Izhi wa ran tre ri, &lt;&lt;lele, rinkon wa la tre Izhi ri ka wurunde rimi mbu, Izhi ye ritu ran zon wa nji wan.&gt;&gt; <verse eid="LUK 7:16" /><verse number="17" style="v" sid="LUK 7:17" />Itre kya riwa Yeso a ti-a, a hi ko kutan ri gran gbu nji Yahuda nga wa kusan mba.<verse eid="LUK 7:17" /></para>
  <para style="s">Yeso Nga Yohana Nji ri vu Nji Sontu ri Mma</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18" />Riwa imirindu nji ri vu nji son tu ri ima wa lawu kya mba, ka yo ti hari rimi mba, <verse eid="LUK 7:18" /><verse number="19" style="v" sid="LUK 7:19" />ka ti wa ndu hi ri Bachi, no wa mɨyen, &lt;&lt;A wu nye riwa wu ye ka ki yosi ri njo ri nkan?&gt;&gt;<verse eid="LUK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20" />Iwa wa ke ri bubu Yeso, wa ka tre, &lt;&lt;Yohana nji ri vu nji son tu ri ima wawu ti ta ndu, ki mɨyen wu, &lt;ka a wu nye wu ye-a, ka ki yosi ri njo ri nkan?&gt;&gt;<verse eid="LUK 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21" />Ri vi nyi riwa Yeso a no kpanji wawa wa he ri lilo nga Iyu meme, ran no wa nfyen wa to tsu. <verse eid="LUK 7:21" /><verse number="22" style="v" sid="LUK 7:22" />Yeso ka lawa ri, &lt;&lt;Bi kɨma hi ri la Yohana kya riwa bi wo, bi ri to, wa nfɨyen wa ran to tsu, wa nkpuzhu wa ka ran zɨren, wawa wa he ri lilo ntan kpa waka fe si, wa maŋgbi wa ran wo tre, wa ran ta wawa wa ku shɨme wa ran la wa dindi tre ri raro. <verse eid="LUK 7:22" /><verse number="23" style="v" sid="LUK 7:23" />Dindi ri he ritu nji riwa a ran kɨbu za ritu won ran Izhi ri ka wo wan ri dindi ka sro ko ŋnga riwa a ran ti shaka kpanyɨme wan riwa a he ri wu ritu wan ran!&gt;&gt;<verse eid="LUK 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24" />Wawa Yohana a tiwa ndu waka hi kamba, Yeso ka gbuchi ran la gbunji tre ritu Yohana, ran ran tre ri &lt;&lt;Ngye bi ka to rimi ji? Bi hi bubu to gbundo giga riwa gungu a tru wu taga? <verse eid="LUK 7:24" /><verse number="25" style="v" sid="LUK 7:25" />Ko, iya ngye nye bi hi bubu ya? Nji riwa a su tsro dindi? Aran kamba ran, wawa wa su tsro wa ti nkɨren wawa wa son ri tra bla tre chu. <verse eid="LUK 7:25" /><verse number="26" style="v" sid="LUK 7:26" />Ko, iri ngye nye bi ka ya? Nji ri la tre Izhi? Me layi mba, a han nji ri la tre Izhi. <verse eid="LUK 7:26" /><verse number="27" style="v" sid="LUK 7:27" />Rinyin nye he riwa itre wan he rimi ngha ran tre,</para>
  <para style="q1" vid="LUK 7:27">&lt;Ngye ngha me ti nji ri ndu a hi kusi wen,</para>
  <para style="q2" vid="LUK 7:27">ri wa a ri milan nkon ti ri wu ri ko wuri ye.&gt;<verse eid="LUK 7:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="LUK 7:28" />Mi layi, rimi wawa riwa mba wa ngɨzhi, ba riwa a han Yohana, doka ri kamba riwa a han wa ti ri shu wawu ri kpanchison Izhi a han.&gt;&gt; <verse eid="LUK 7:28" /><verse number="29" style="v" sid="LUK 7:29" />A wu riwa wuwo ri nye, ri wawa wa kpa nkɨren ri meme, waka kpanyɨme ri nkon Izhi wawu nye a tsra ritu mba nye waka vuwa son tu ima wa Yohana. <verse eid="LUK 7:29" /><verse number="30" style="v" sid="LUK 7:30" />Ama Farisa ri wawa wa tsro doka Musa waka kamba ritu kya riwa Izhi ka zi ri wa. Waka kamba ri no Yohana no ran vuwa son tu ima ran.<verse eid="LUK 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31" />Yeso ka tre,&lt;&lt;Ko ringye, nye, me ka yi nji wa zizan kabru? Wa he nji bibi tan? <verse eid="LUK 7:31" /><verse number="32" style="v" sid="LUK 7:32" />Wa he ka imiri wawa waki ri richu, wa ri yo kamba ri,</para>
  <para style="q1" vid="LUK 7:32">&lt;&lt;&lt;Ki nvɨri ngba ri yi,</para>
  <para style="q2" vid="LUK 7:32">bi ran ngulu ran,</para>
  <para style="q1" vid="LUK 7:32">ki chuse kuu ri yi,</para>
  <para style="q2" vid="LUK 7:32">bi ka mbi ri yi.&gt;<verse eid="LUK 7:32" /></para>
  <para style="m">
    <verse number="33" style="v" sid="LUK 7:33" />Riwa Yohana ri vu nji son tu ri ima a ye a ran ri ri ran, a ran so nfrihi ran, Ama bi ran tre ri, &lt;Ai a he ri ibɨji.&gt; <verse eid="LUK 7:33" /><verse number="34" style="v" sid="LUK 7:34" />Ama riwa Ivren Nji a ye ran ran ri, ran ran so, bi ran tre ri, &lt;Bi to a ri ri ran so bran bran, ikpan wa kpa nkɨren ri meme ri wa ti meme ti!&gt; <verse eid="LUK 7:34" /><verse number="35" style="v" sid="LUK 7:35" />Ama wiwiri wa tou tsra ritu imiri wan.&gt;&gt;<verse eid="LUK 7:35" /></para>
  <para style="s">Iwa ri ti Memeti a Gban Yeso Nyen</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36" />Nji Farisa ri a yo Yeso ri no hi ran riri ri ko wan, Yeso ka hi ran kuson riwa a ri riri a. <verse eid="LUK 7:36" /><verse number="37" style="v" sid="LUK 7:37" />Ri gbu a, iwa ri a he ri ti meme ti riwa a wo ri Yeso ri ri ri ko nji Farisa, ka ngɨzhi vi gbanran ima ri miwi raro wati wu ri tita onis ri nye ri miwi raro riwa a ti nkɨren bran bran. <verse eid="LUK 7:37" /><verse number="38" style="v" sid="LUK 7:38" />A ye ran kukri kugon Yeso, ri bubu za wan, ran ran yi. Riwa ima si wan a wɨyen ran ku ri za wan, mba ka ka nfu tu wan ran gban ri za Yeso, a ran gban za wan ran ka nyu wan ran bre ri za wan, rimba ka gban nye riro- a ri wu.<verse eid="LUK 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 7:39" />Riwa nji Farisa ka to kya riwa iwa-a a ran ti, ka tre ri sironwa, &lt;&lt;Nji nyin ran he nji ri la tre Izhi nye ran to ko iwa nyi a he ngha nye. Iwa nyi a he ri wa a ri bre wu wo ran kuma to ri a he iwa ri ti meme ti.&gt;&gt;<verse eid="LUK 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40" />Yeso ka la ri nji Farisa, &lt;&lt;Siman, mi he ri kya riwa misu miri lawu.&gt;&gt;</para>
  <para style="p" vid="LUK 7:40">Wawu ka tre ri, &lt;&lt;No la, nji ri tsro.&gt;&gt;<verse eid="LUK 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41" />Yeso ka tre, &lt;&lt;wati nji ri a ran hu nji hari wari ila nkɨren, iri wana hu gbigba ton, nga iri wa ran hu ise ton. <verse eid="LUK 7:41" /><verse number="42" style="v" sid="LUK 7:42" />Riwa wa ran to han ran, mba ka kadon ri wa haha mba. Ko, ri to wen ŋnga ri suwu han?&gt;&gt;<verse eid="LUK 7:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43" />Siman ka la wu ri, &lt;&lt;Ri to won, riwa wa ka nkɨren ri bran don ri wu,&gt;&gt; Yeso ka tre wu, &lt;&lt;Ri wu la tsra.&gt;&gt;<verse eid="LUK 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 7:44" />Ka nzu si ya wa-a, ran la Siman, &lt;&lt;Wu to iwa nyi? Me gra ri ko wen, wu ran nowen ima me ngɨla kpɨreran, ama wa wu a ngɨla za rimo ri ima si wan ran seu ri nfutu wan. <verse eid="LUK 7:44" /><verse number="45" style="v" sid="LUK 7:45" />Wu ran so nyu won riwa me gra ko wen ran, Ama riwa mi gra ri nyi a ran ka ŋnga nyu ri za won chuwo ran. <verse eid="LUK 7:45" /><verse number="46" style="v" sid="LUK 7:46" />Wu ran gban nye ri mo ri tu ran, ama wawu a gban nye ri mɨui raro rimo ri za. <verse eid="LUK 7:46" /><verse number="47" style="v" sid="LUK 7:47" />Ritu kamba me lawu, meme ti wan wa ri bran a, wa ka rega riwu. ritu a ti su ri bran bran. Riwa wa kadon ri wu tsitsa wan, wawu isu wan a he tsawen.&gt;&gt;<verse eid="LUK 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48" />Mba Yeso ka la wa-a ri, &lt;&lt;Wa ka meme ti wen rega riwu.&gt;&gt;<verse eid="LUK 7:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49" />Nji riwa wa ran ri ri wawa wa ka ran tre ri kamba ri&lt;&lt; Nyin a he ŋnga nye riwa a ri ka meme ti nji rega?&gt;&gt;<verse eid="LUK 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50" />Ama Yeso ka tre ri wa-a, &lt;&lt;Ikpanyɨme wen kpa wu chuwo, hi ngawen, no Izhi nowu sisiron.&gt;&gt;<verse eid="LUK 7:50" /></para>
  <chapter eid="LUK 7" />
  <chapter number="8" style="c" sid="LUK 8" />
  <para style="s">Imba Wawa Wa Hu Yeso</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1" />Kugon rinyi, Yeso ka zɨren hi ri nchon gbu, ran la bla tre dindi ri wa Kpanchi Izhi. Imiri ndu wan Wuru donhari wa ka he ri wu. <verse eid="LUK 8:1" /><verse number="2" style="v" sid="LUK 8:2" />Ngha mba wa ri wa wa kpa wa chuwo ri meme bɨzhi nga ri meme lilo: Mariyamu riwa wa yowu ri Madalin riwa ibɨji tangban wa zhu rimi kpa wan. <verse eid="LUK 8:2" /><verse number="3" style="v" sid="LUK 8:3" />Yonana wa Kuza, nga nji rinkon wa ndu riko Hirudus, Suzanatu, nga ngbɨron wari Mba wa nyi wa ran zon wa ri kya riwa wa he ri wu. <verse eid="LUK 8:3" /><verse number="4" style="v" sid="LUK 8:4" />Riwa gbugbu nji wa ka kabru tu nga nji wa ka ran ye ri Yeso ri gbu ri gbu, ka la wa tre ikɨbu. <verse eid="LUK 8:4" /><verse number="5" style="v" sid="LUK 8:5" />&lt;&lt;Nji ri ron ka hi riwa a ri chu iwɨlo kpi, wa ri wa joku ri nkon, wa ka chan wa, nga chenchen wa tan wa ri. <verse eid="LUK 8:5" /><verse number="6" style="v" sid="LUK 8:6" />Wa ri wa joku ri tu han, nga wa riwa wa gbron, imbe mba ka huu ritu a ran fe bubu si ran. <verse eid="LUK 8:6" /><verse number="7" style="v" sid="LUK 8:7" />Iwɨlo wa ri wa joku ri mi nchon, ka gbron riwu ran ima mbe mba to. <verse eid="LUK 8:7" /><verse number="8" style="v" sid="LUK 8:8" />Nga iwɨlo wari wa joku rimi meme dindi. ka zhu ran de kɨlo, iso gbigba ri han kya riwa wa chu.&gt;&gt;</para>
  <para style="p" vid="LUK 8:8">Riwa a tre nga nyi, ka yo, &lt;&lt;Riwa a he ton ri wo, no wo.&gt;&gt; <verse eid="LUK 8:8" /><verse number="9" style="v" sid="LUK 8:9" />Miriko wan wa mɨyen ngye nye ikɨbu tre nyin a he <verse eid="LUK 8:9" /><verse number="10" style="v" sid="LUK 8:10" />A tre, &lt;&lt;Ito kya riwa a he riri ri kpanchison Izhi wa ka no yi, ama wari me la wa ikɨbu ikɨbu ritu wa to, wari ran wo ama wa ran vu ngɨzhi ran.&gt;<verse eid="LUK 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11" />Ngye bibi kya riwa itre Ikɨbu kɨbu a he een: ikɨlo-a he tre Izhi. <verse eid="LUK 8:11" /><verse number="12" style="v" sid="LUK 8:12" />Iwɨlo riwa wa joku ri nkon wa he wawa wa wo, nga meme nji ka ye ran ban tre mba ri sron mba, riwa ran kpa nyɨme wa ri kpa wa chuwo ran. <verse eid="LUK 8:12" /><verse number="13" style="v" sid="LUK 8:13" />Riwa wa ku ri tu han wa he wawa wa kpa tre ri ngɨri ri tu wa wo, ama wawa wa ran he ri ŋjan ran. Wa kpa nyɨme ri vi ti wan, ama ri nde wa itsra ye wa ku joku. <verse eid="LUK 8:13" /><verse number="14" style="v" sid="LUK 8:14" />Ikɨlo ri wa a joku ri nchon a he ri wa wa wo, ama ri wa wa hu nkon mba iya ri su kyawa wa ro ri gbungblu me ka nowa wana gbron ran. <verse eid="LUK 8:14" /><verse number="15" style="v" sid="LUK 8:15" />Ama ikɨlo riwa a ku ri meme dindi a he riwa a he sron dindi, riwa wa wo tre Izhi, wari ngɨzhi wu, wa vu sron wa ri de iwɨlo dindi.<verse eid="LUK 8:15" /></para>
  <para style="s">Ikpan Wulu ri Bubu Kɨri Wan</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16" />&lt;&lt;Njo ran yo wulu ran ka zi ri vaja nga ran ka zi ri za bubu kru ran ri ka zi ri bubu zi, ri wawa nye wa ri to kpan. <verse eid="LUK 8:16" /><verse number="17" style="v" sid="LUK 8:17" />Ikya ri ran ri riri riwa wa ran tou ran, nga ikya riwa wa kau ti riwa wana bu wu zhu ri ra ran. <verse eid="LUK 8:17" /><verse number="18" style="v" sid="LUK 8:18" />Mɨlan to bibi riwa wu sɨren ton. njo riwa a he wu wa no bran, njo ri wa a ran he wu ran, Ikya ri wa a he wu wa kpa ri wo wan.&gt;&gt;<verse eid="LUK 8:18" /></para>
  <para style="s">Iyi Yeso ri Mɨri Vayi Wan</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19" />Mba iyi Yeso nga vayi wan wa ka ye to, ama wa ran ye huehyureri wu ran ritu gbugbu nji. <verse eid="LUK 8:19" /><verse number="20" style="v" sid="LUK 8:20" />Njo ka la wu, &lt;&lt;Iyi wen nga vayi wen wa he ra wawa wari to wu.&gt;&gt; <verse eid="LUK 8:20" /><verse number="21" style="v" sid="LUK 8:21" />Ka la, iyi won nga vayi won wa he wawa wa wo tre Izhi wa ri tindu ri wu.<verse eid="LUK 8:21" /></para>
  <para style="s">Yeso A no Ngungu Wulu no Kɨri</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22" />Chachu ri Yeso a gra rimi nvuima iwa miriko wan. A tre riwa, &lt;&lt;de ki hi ku gran nne.&gt;&gt; Waka wurunde hi ri gran riwan. <verse eid="LUK 8:22" /><verse number="23" style="v" sid="LUK 8:23" />Wa rimi hi tse ngha ka vu. Ngungu ri iwo wulu ka ran ti, nghɨma mba kana wa ran sho ri ima hari waka he rimi sisiri.<verse eid="LUK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 8:24" />Waka hi wari shɨme u, wari tre, &lt;&lt;Njiriko, Njiriko ki kuu!&gt;&gt;</para>
  <para style="p" vid="LUK 8:24">Ka shɨme, ran yɨra ngha ri gungu nga sɨra wulu mba ngungu nga ima waka kullu, bubu ka he yoon. <verse eid="LUK 8:24" /><verse number="25" style="v" sid="LUK 8:25" />Ka tre riwa, &lt;&lt;Ikpa nyɨme mbi he mme?&gt;&gt;Waka tsri wari wɨri kpa, wari tre ri kamba, &lt;&lt;Ngha nye nyi hari gungu nga ima wa wo doka wan? wawa ngawen wa wo-u.&gt;&gt;<verse eid="LUK 8:25" /></para>
  <para style="s">Ikpa Nji Riwa a he ri Meme Bɨzhi Chuwo</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26" />Waka zhu ri meme Garasina riwa wa rugran nne zhu ri meme Galili <verse eid="LUK 8:26" /><verse number="27" style="v" sid="LUK 8:27" />Riwa Yeso a gɨzhi ri nyu nne tse nji ri riwa a he ri bɨzhi ka zhu rimi gbu ran fe wu ri kon. A ban vi riwa a ran su tsro ran, nga a ran ran son iko ran, tse ri bubu riwa wa no nji yɨwi. <verse eid="LUK 8:27" /><verse number="28" style="v" sid="LUK 8:28" />Riwa a to Yeso ran ban gro kpa, ran joku kusi wan, ran nzu ran ri,&lt;&lt; Ngye nye wu wa ri me, Yeso, Ivren Izhi riwa wa gbre wu? Me bre wu, ran nowen ya ran!&gt;&gt; <verse eid="LUK 8:28" /><verse number="29" style="v" sid="LUK 8:29" />A tre nganyi don Yeso no zu shnji bɨzhi jio riwawu don ritu riwa ibɨji a ran vu bla vi, Wa ye waka lo-u yo ri tra. wa lou ri che ama ka su che, meme bɨzhi ka zu hi ji. <verse eid="LUK 8:29" /><verse number="30" style="v" sid="LUK 8:30" />Yeso ka miyen-u ri,&lt;&lt; Inde wen he ngha?&gt;&gt; Ka tre,&lt;&lt;Tuli&gt;&gt;, Ritu ibɨji wa gra riwu kigbu. <verse eid="LUK 8:30" /><verse number="31" style="v" sid="LUK 8:31" />Ibɨji wa ka bre wu bran ri no ran no wawa no wa ku ri bubu kuu ran. <verse eid="LUK 8:31" /><verse number="32" style="v" sid="LUK 8:32" />To, ri bubu wan dushu wa ko waka kigbu wa ran ri ri ri benhen gashi, wa ka bre wu no kpa yɨme riwa nowa gra rimi mba ka kpa yɨme riwa. <verse eid="LUK 8:32" /><verse number="33" style="v" sid="LUK 8:33" />Imba wa bɨzhi wa ka don wari gra rimi wa dushu wa ko-a gre ke wa dushu wa ko wa ka gre gra ban mi nne wari kuu. <verse eid="LUK 8:33" /><verse number="34" style="v" sid="LUK 8:34" />Riwa imiri wa kɨshu dushu wa ko wato kya riwa a he, wari wurutsu, wari la tre-a ri wa nchon gbu ri tsitsa gbu. <verse eid="LUK 8:34" /><verse number="35" style="v" sid="LUK 8:35" />Imba wanji waka zhu riwa wato kya riwa a ti. Riwa wa ye ri Yeso, wa ri ye fe nji riwa wa bɨzhi wa zhu rikpa wan, a son ri kusi Yeso, a su tsro, ituwan kae riri mba waka ti sisiri. <verse eid="LUK 8:35" /><verse number="36" style="v" sid="LUK 8:36" />Wawa ikya nyi a he kusi mba, waka la wa bibi riwa wa zhu ri bɨzhi rikpa nji-a. <verse eid="LUK 8:36" /><verse number="37" style="v" sid="LUK 8:37" />Nji wa meme Garasina wawu waka bre Yeso no kawawa don, ritu riwa sisiri a vu wa. Imba ka gra rimi nvuima ran bru hi ngawan.<verse eid="LUK 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 8:38" />Inji riwa ibɨji wa gra riwu-a, a bre wu no nowawu nkon riwa wawu ri hu nowa zɨren mba-u Ama ka kawu chuwo ran tre, <verse eid="LUK 8:38" /><verse number="39" style="v" sid="LUK 8:39" />&lt;&lt; Bru hiko, wuri la kpolo kyawa riwa Izhi ti riwu.&gt;&gt; Ka hi bla bubu tan rimi gbu la wa kyawa riwa Yeso a ti riwu.<verse eid="LUK 8:39" /></para>
  <para style="s1">Iku Vruwa Mba Wa ri Lilo</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40" />Imba riwa Yeso a bru ye, nji waka tre wu ri ye, don wa ran gben ye wan. <verse eid="LUK 8:40" /><verse number="41" style="v" sid="LUK 8:41" />Mba nji ri wana yo-u ri Yairus, nji rinkon ri tra Izhi, a ye ran joku kusi Yeso, ran bre wu no hi ko wan. <verse eid="LUK 8:41" /><verse number="42" style="v" sid="LUK 8:42" />A he ri vruwa riri, riwa a he rise wuru don hari, a he ri nyu kuu.</para>
  <para style="p" vid="LUK 8:42">Riwa Yeso a ran hi ngawan, ikpanji waka ran ima-u <verse eid="LUK 8:42" /><verse number="43" style="v" sid="LUK 8:43" />Iwa ri riwa ise wan a he wuru don hari a ran zhu yi njo rimi mba ka ran ya no si ran. <verse eid="LUK 8:43" /><verse number="44" style="v" sid="LUK 8:44" />A ju ri Yeso kugon ran bre wo ri nyu tsro wan, ri mba iyi- a ka kukiri.<verse eid="LUK 8:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 8:45" />Yeso ka tre,&lt;&lt; Nnga nye ibrewen wo? &gt;&gt; Riwa waka tɨron wawu mba, Bitrus ka tre,&lt;&lt; Iti ko, Ikpanji wa ran ima-u.&gt;&gt;<verse eid="LUK 8:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46" />Ama Yeso ka tre,&lt;&lt; Njo ibrewen wo, ritu mi to gbengbren zhu ri kpa won.&gt;&gt;<verse eid="LUK 8:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 8:47" />Riwa Iwa-a a to kamba ran ri tuwan, ran chiwi hi ran gra wɨri kpa, ran ku kru kusi wan, a ju ri tuwan ri kusi gbunji ran la kya riwa wawu ibretsiro wan wo ri tu wan, ri bibi riwa a fe si. <verse eid="LUK 8:47" /><verse number="48" style="v" sid="LUK 8:48" />Ka la wu ri,&lt;&lt; Ivɨra won ikpanyɨme wen a kpawu chuwo. Hi ri si kpa.&gt;&gt;<verse eid="LUK 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49" />Riwa Yeso a he rimi tre, nji ri ka zhu ri ko nji riko Izhi ran tre,&lt;&lt; Ivira wen a kuu,&gt;&gt;Ran vu ya sro ŋnga ri nji ri tsro ran.&gt;&gt;<verse eid="LUK 8:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50" />Ama riwa Yeso a wo kamba, ka nyɨme ran tre ri nji rinkon ri tra Izhi,&lt;&lt; Ran ti sisiri ran ikpanyɨme wen nkankshe, a ri fe si.&gt;&gt;<verse eid="LUK 8:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51" />Riwa a gra ri ko-a a ran nyɨme no njo no gra ran, ka ra Bitrus ri Yohana, ri Yakuba, nga ti mba iyi vra. <verse eid="LUK 8:51" /><verse number="52" style="v" sid="LUK 8:52" />Waka kamba ran ti shnji siron wari ran yi ritu wan. Ama Yeso ka tre, &lt;&lt; Bi ka yi chuwo. Ivira-a a ran kuu ran, ari kruna.&gt;&gt;<verse eid="LUK 8:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53" />Waka ran ndza Yeso, ritu wa to ri a kuu. <verse eid="LUK 8:53" /><verse number="54" style="v" sid="LUK 8:54" />Ama Yeso ka vu wo vra ka nzu ran tre ri,&lt;&lt; Ivɨra won, wurunde.&gt;&gt; <verse eid="LUK 8:54" /><verse number="55" style="v" sid="LUK 8:55" />Ivɨri wan ka bru ye, ka wurunde, ka lawa ri nowa no ri no ri. <verse eid="LUK 8:55" /><verse number="56" style="v" sid="LUK 8:56" />Wa ti vra waka ti mamaki, ama Yeso ka lawa ri nowa ran la njo ran ikya riwa a ti.<verse eid="LUK 8:56" /></para>
  <chapter eid="LUK 8" />
  <chapter number="9" style="c" sid="LUK 9" />
  <para style="s">Yeso a ti Miriko wan Wurudon hari Ndu</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1" />Chachu ri Yeso a yo miriko wan kabru, ran nowa senkpa nga nkon no wa zu wu meme ban kpata wa ri de sikpa lilo. <verse eid="LUK 9:1" /><verse number="2" style="v" sid="LUK 9:2" />Na ti wa ndu nowa tre tre kpanchison Izhi ri shu wa ri de si ri wawa wa he ri lilo. <verse eid="LUK 9:2" /><verse number="3" style="v" sid="LUK 9:3" />Yeso la wa.&lt;&lt;Ran ban kya hi ri mi zeren nyin ran ko kpala ran, ban kpo ran, ran ban ri ko nkɨren ran ko itsɨro ri yo ngha ran. <verse eid="LUK 9:3" /><verse number="4" style="v" sid="LUK 9:4" />ka wa no yi kya ri ko ri wa bi gra, ki ri bubu wan hi chachu riwa bi ka gbu don. <verse eid="LUK 9:4" /><verse number="5" style="v" sid="LUK 9:5" />Ngha Ka nji wa gbu wa ran kpa yi ran kpo wuru za ŋbi ko bi ka gbu mba don.&gt;&gt; <verse eid="LUK 9:5" /><verse number="6" style="v" sid="LUK 9:6" />Imirindu wan wurunde wa ri gra ri gbu ri gbu, wa ran dɨbu tre dindi ritu Izhi wa ran no kpa nji si ko kutan. <verse eid="LUK 9:6" /><verse number="7" style="v" sid="LUK 9:7" />Iwa ichu Hirudus a wo kya wa a ri hi, Ka ti shnji siron bran ritu wari wana tre Yohana kuu ran wurunde. <verse eid="LUK 9:7" /><verse number="8" style="v" sid="LUK 9:8" />Wari wa ka tre Iliya a ye nga wari wa tre ri wa ndu Izhi wa gbangban wa ye ri si. <verse eid="LUK 9:8" /><verse number="9" style="v" sid="LUK 9:9" />Ama Hiridus ka tre,&lt;&lt; Me chu tu Yohana ri a he ngha riwa me wo kya ritu wan?&gt;&gt;Awa ran to wu Yeso.<verse eid="LUK 9:9" /></para>
  <para style="s">Yeso a no Nji Ngo Ton ri</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10" />Riwa wa ndu Yeso wa kɨma ye wa ri la Yeso kya wa hi wa ka ti. Yeso ka vu wa hi ngawan, wa bru ban kon ri tu wa hi gbu ri wa wa yo Batsaida. <verse eid="LUK 9:10" /><verse number="11" style="v" sid="LUK 9:11" />Ama Igbu nji wo ngamba wa ri wurunde Yeso ka kpa wa ri nkon ye ran la wa tre kpanchison ri wa Bachi ran no si ri wawa wa su si.<verse eid="LUK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12" />Ri yawulu miri ndu wan wuru don hari wa ye wa ri tre, &lt;&lt;No gbunji wamba no wa hi ri gbu riwa wa kagon mba wari wa kya riwa wa ri nga bubu riwa wa kru, ritu bubu riwa ki he nji wa ran he ri bubu riwa ki he nyin ran. &gt;&gt;<verse eid="LUK 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13" />Ama Yesu Ka tre wa ri,&lt;&lt; Bi yi no wa kya no wa ri,&gt;&gt;</para>
  <para style="p" vid="LUK 9:13">Wa ka nyɨme ri,&lt;&lt;Ngbrewuru yɨmo ton nga ŋgibrelambe hari se kode ki hi kiri reri ye no gbunji.&gt;&gt; <verse eid="LUK 9:13" /><verse number="14" style="v" sid="LUK 9:14" />Igbu roron ngo ton wa he ri bubu wan.</para>
  <para style="p" vid="LUK 9:14">Ama Yeso Ka tre ri imirindu wan,&lt;&lt; Nowa kuson mme nji se titon.&gt;&gt; <verse eid="LUK 9:14" /><verse number="15" style="v" sid="LUK 9:15" />Miriko wan wa ti bibi riwa a la wa, ko ŋnga ka son ri mme. <verse eid="LUK 9:15" /><verse number="16" style="v" sid="LUK 9:16" />Imba Yeso a ban ŋkpon juju yɨwo ton nga lambe hari na ndzu ban shu, ran ngɨri ran kpɨru wa. Imba ka kano imirindu wan nowa ka no gbunji. <verse eid="LUK 9:16" /><verse number="17" style="v" sid="LUK 9:17" />Wawu mba wa ri wari hwɨshi, nga mirindu wan waka vu zhuzhu wan sho sisen wuru don hari riwa wa don gbron wan.<verse eid="LUK 9:17" /></para>
  <para style="s">Itre Bitrus ritu yeso</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18" />Chachu ri Yeso a ran bre ri yayɨbi wza mirindu wan waka he ri wu ri bubu wan, ka mɨyen wa,&lt;&lt;Igbunji-a wa tre ame me he ŋnga?&gt;&gt; <verse eid="LUK 9:18" /><verse number="19" style="v" sid="LUK 9:19" />Imirindu wan wa tre,&lt;&lt;Wari wa tre ri wu he Yohana nji ri vu nji sontu ri ima, nga wari wa tre Iliya, nga wari mba, ri wu he wa la tre Izhi wa sen wawa wa zhu ji.&gt;&gt; <verse eid="LUK 9:19" /><verse number="20" style="v" sid="LUK 9:20" />&lt;&lt; Bi yi fa? &gt;&gt;Yeso amɨye wa,&lt;&lt;Biyi bi tre me he ŋnga?&gt;&gt;</para>
  <para style="p" vid="LUK 9:20">Bitrus ka tre,&lt;&lt; A wu Kristo wa Izhi.&gt;&gt;<verse eid="LUK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21" />Yeso ka fen wa miriko wan ton no wa ran la njo ran. <verse eid="LUK 9:21" /><verse number="22" style="v" sid="LUK 9:22" />Yeso Ka tre,&lt;&lt;Ame vren nji me so ya kyawa kɨgbu, nga wa rinkon wa kamba ri me, rinkon wa la tre Izhi nga wa tsro doka Musa, kuma wa wuu wen ri vi ri tra me tashɨme.&gt;&gt; <verse eid="LUK 9:22" /><verse number="23" style="v" sid="LUK 9:23" />Imba Yeso a tre ri gbunji &lt;&lt; Nji ri wa ari hu wen, No kawan ri tuwan ran ban konkron riwa wa kpanwu bla vi ran hu wen. <verse eid="LUK 9:23" /><verse number="24" style="v" sid="LUK 9:24" />Nji riwa ari wa ran kpa tuwan chuwo a ran fe ran, ama nji riwa a kawan ri ngawan ari fe. <verse eid="LUK 9:24" /><verse number="25" style="v" sid="LUK 9:25" />Bi ngye ri wa nji ri fe ri meme gbu wawu ran kuu? <verse eid="LUK 9:25" /><verse number="26" style="v" sid="LUK 9:26" />Nji riwa a ti shan ran kawan ri la tre won, ivren nji ri tishan wan ka a ye kusi nkpen wan nga nkpen Tiwan nga mirindu wan. <verse eid="LUK 9:26" /><verse number="27" style="v" sid="LUK 9:27" />Mi la yi janji, wari ŋbi wawa wa kuki ri nyin wa ran kuu ran tse wa to Kpanchison Izhi.&gt;&gt;<verse eid="LUK 9:27" /></para>
  <para style="s">Isran kpawan Yeso</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28" />A he vi tandara riwa Yeso a tre kya wamba, a ban Bitrus, Yohana nga Yakubu, wari hi bubu bre Izhi ri tu ngblu. <verse eid="LUK 9:28" /><verse number="29" style="v" sid="LUK 9:29" />Riwa a ran bre Izhi, isi wan ka sran, itsɨro wan ka he kinklan pwa ka ishanwulu ndzan. <verse eid="LUK 9:29" /><verse number="30" style="v" sid="LUK 9:30" />Ri bubu wan, Musa nga Iliya, <verse eid="LUK 9:30" /><verse number="31" style="v" sid="LUK 9:31" />Waka ye rimi gbre ri kpen, wa ran tre ri Yeso, wa ran tre ritu hi ngawan, ari he bibi riwa wa ka zi ri Urushelima. <verse eid="LUK 9:31" /><verse number="32" style="v" sid="LUK 9:32" />Bitrus nga wa kpan zɨren wan wa ran kru ngha, ama riwa wa shɨme ngha wa to gbre Yeso wan nga nji hari waka ki ri wu. <verse eid="LUK 9:32" /><verse number="33" style="v" sid="LUK 9:33" />Riwa nji-a wa ka Yeso ran don, Bitrus ka tre ri wu, Itiko, a bi riwa ki he ri nyin. Ri nowa ti bru ti tra iri riwa Musa nga ri riwa Iliya.&lt;&lt;A ran to kya riwa a ran tre ran. <verse eid="LUK 9:33" /><verse number="34" style="v" sid="LUK 9:34" />Riwa Bitrus a ran tre, ikpawulu ka zhu ran kawa ti, wa ti sisiri riwa wa gra ri kpawulu-a. <verse eid="LUK 9:34" /><verse number="35" style="v" sid="LUK 9:35" />Iran ka zhu ri kpa wulu ye, ran tre, Rinyi he vren won, riwa me chu; sɨrenton ri wu.&gt;&gt; <verse eid="LUK 9:35" /><verse number="36" style="v" sid="LUK 9:36" />Riwa iran a tre, waka to ri Yeso he ri kankshiwan. Imiriko wan wa ngɨzhi tre-a ri sron mba, wa ran la njo kya riwa wa to ran.<verse eid="LUK 9:36" /></para>
  <para style="s">Yeso Kpa Vɨren Riwa a he ri Meme Bɨzhi chuwo</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37" />Ivi ri han wan, riwa wa gɨzhi ri tu ngblu, ikpanji waka fe Yeso. <verse eid="LUK 9:37" /><verse number="38" style="v" sid="LUK 9:38" />Nji ri rimi mba ka yo wu ri.&lt;&lt;Nji ri tsro, me bre wu no ya vren won, ritu wawu nye he vren won nkankshi wan. <verse eid="LUK 9:38" /><verse number="39" style="v" sid="LUK 9:39" />Ibɨji-a risi hon wu,ari son ka kpagɨro ba yo sron. Ibɨji-a risi wuruu, ikpawan risi wɨri, nyu wan risi funfon. Aran ri kau chuwo ran tse a kpa time. <verse eid="LUK 9:39" /><verse number="40" style="v" sid="LUK 9:40" />Me ibremiriko wen nowa zuu wa zhu, ama wa ran ya ran.&gt;&gt;<verse eid="LUK 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41" />Yeso a tre wa, &lt;&lt;Biyi wa bi ran senkpa ri tre won ran, ri son won ri yi bran bran bi ran towan ran shi tan bi to kya? Ban vren wen ye ri me?&gt;&gt;<verse eid="LUK 9:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42" />Kau riwa ivren-a a ran ye, ibɨji-a ka ban wu taga ri meme. Ama Yeso ka yɨra ŋnga ri wu meme a, ran no si nga ran ka vren-a no tiwan. <verse eid="LUK 9:42" /><verse number="43" style="v" sid="LUK 9:43" />Wawu mba waka ti mamaki ritu nkpen Izhi.</para>
  <para style="p" vid="LUK 9:43">Riwa wana ti mamaki ritu kya riwa Yeso a ti, ka tre ri miri nduwan, <verse eid="LUK 9:43" /><verse number="44" style="v" sid="LUK 9:44" />Ku ki kpen bi ri wo kya riwa mi la yi: Ame Ivren nji me hi bubu gra iwo meme nji. <verse eid="LUK 9:44" /><verse number="45" style="v" sid="LUK 9:45" />Ama imiriko wan wana to kya riwa a ran tre ritu wan ran. A he riwa ri yayɨbi, ritu nowa ran tou ran, nga wa ran ti sisiri ri bubu mɨyeu.<verse eid="LUK 9:45" /></para>
  <para style="s">Ngha he Rinkon?</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46" />Ijan nyu ka wulude ri wa miriko wan ritu ngha ri he rinkon. <verse eid="LUK 9:46" /><verse number="47" style="v" sid="LUK 9:47" />Yeso, riwa a to rimɨren mba, ka ban vren tsitsa ri ran no kri kusan wan. <verse eid="LUK 9:47" /><verse number="48" style="v" sid="LUK 9:48" />A tre wa,&lt;&lt; Nji riwa a kpa vren tsitsa rimi nde won ame nye a kpa; nga nji riwa a kpa wen a kpa nji riwa a tiwen ndu. Nji riwa a he krenkpen rimi mbi wawu nye he rinkon.&gt;&gt;<verse eid="LUK 9:48" /></para>
  <para style="s">Wu he wa Yeso ka wu kawen riwu</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49" />&lt;&lt;Nji ri ko,&gt;&gt;Yohana a yo, &lt;&lt;Ki to nji ri ari zu bɨzhi rimi nde wen ki wa ki ri zu, ritu a ran he ri rimi mbu ran.&gt;&gt; <verse eid="LUK 9:49" /><verse number="50" style="v" sid="LUK 9:50" />&lt;&lt;Ran zu ran,&gt;&gt; Yeso a tre ri wa,&lt;&lt;Nji riwa a ran kawan ri yi ran a he wa mbi.&gt;&gt;<verse eid="LUK 9:50" /></para>
  <para style="s">Wa gbu Samariya wa kamba ri Yeso</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51" />Riwa ivi a ran ti riwa a ran wa ran hi ri shu, Yeso ka tika riwa ari hi Urushelima. <verse eid="LUK 9:51" /><verse number="52" style="v" sid="LUK 9:52" />Ka ti wa ndu wan no wa ran hi, riwa wa hi ri gbu samariya wari wa kya ki riwu. <verse eid="LUK 9:52" /><verse number="53" style="v" sid="LUK 9:53" />Ama nji wa gbu wa ran kpaa ran, ritu a ran hi ri Urushelima. <verse eid="LUK 9:53" /><verse number="54" style="v" sid="LUK 9:54" />Riwa miriko wan Yakubu nga Bitrus wa to ri nyi wa mɨyen,&lt;&lt; Bachi, wu wa ki yo wulu ri shu no ye meme na wuu wa?&gt;&gt;v 55 Ama Yeso ka kɨwan ya wa ran fen wa ton ritu kya riwa wa ti. <verse eid="LUK 9:54" /><verse number="56" style="v" sid="LUK 9:56" />Imba Yeso nga miriko wa wa ka hi gbu ri.<verse eid="LUK 9:56" /></para>
  <para style="s">Nji wawa wa Hu Yeso</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57" />Riwa wa he rimi zɨren ri nkon, Nji ri ka tre ri Yeso,&lt;&lt; Ame me hu hi ri bubu ri wa wu hi.&gt;&gt;<verse eid="LUK 9:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58" />Yeso ka lau,&lt;&lt; wa chi wa he ri bubu kru nga chenchen wa he bubu kii, ama vren nji ran he ri bubu riwa ari ka tu wan yo.&gt;&gt;<verse eid="LUK 9:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59" />Yeso ka tre ri nji ri,&lt;&lt; Hu wen.&gt;&gt;Ama nji a ka tre,&lt;&lt;Bachi, nowen hi miri ban tiwon no yɨwi.&gt;&gt;<verse eid="LUK 9:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60" />Yeso ka tre wu, &lt;&lt;No wawa wa kuu nowa no wawa wa kuu yɨwi, ama a wu hi wuri la tre kpanchison Izhi.&gt;&gt;<verse eid="LUK 9:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61" />Nganga iri ka tre,&lt;&lt; Ame me wuu, Bachi, ama nowen me kɨma hi miri la wa ko won ri.&gt;&gt;<verse eid="LUK 9:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62" />Yeso ka tre,&lt;&lt;Njo ran hon son ritu nghɨma ri ron ran yagon ran, a ran tsra riwa ari tindu ri Kpanchison ran.&gt;&gt;<verse eid="LUK 9:62" /></para>
  <chapter eid="LUK 9" />
  <chapter number="10" style="c" sid="LUK 10" />
  <para style="s">Yeso a ti Setaŋkpan don hari ndu</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1" />Riwa Yeso a zhu se taŋkpan don hari nga wari ran ti wa ndu wan hiha, no wa gbuchi ran hi ri gbu nga bubu riwa a ran wa ran hi. <verse eid="LUK 10:1" /><verse number="2" style="v" sid="LUK 10:2" />A lawa,&lt;&lt;Yeso ka tre isɨren kigbu, ama wa ndu wa he fiwen. Mɨyen Bachi ri sɨren no tru wa ndu sro rimi rɨma. <verse eid="LUK 10:2" /><verse number="3" style="v" sid="LUK 10:3" />Hi! Me ti yi ndu ri hi ka iwulu kpan rimi wa Yawu wa ji. <verse eid="LUK 10:3" /><verse number="4" style="v" sid="LUK 10:4" />Ran ban kpo ko ntan za ran, ran ban vi ri tre ri njo ri nkon ran.<verse eid="LUK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 10:5" />&lt;&lt; Ka bi gra ri ko, gbuchi tre,&lt;Kinklan sron ri ko nyin.&gt; <verse eid="LUK 10:5" /><verse number="6" style="v" sid="LUK 10:6" />Ka nji ri kinklan sron he ri ko a, kinklan sron mbi ri sonvɨri ri wu, ka a ran he kamba ran, ari kɨma ye ri yi. <verse eid="LUK 10:6" /><verse number="7" style="v" sid="LUK 10:7" />Ku ki ri ko mba, ri bi ri so kya riwa wa no yi, wa ndu wa kpa kɨshi ndu mba. ran zhu ri ko hi ri ko ran.<verse eid="LUK 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 10:8" />&lt;&lt;Ka bi gra ri gbu ka wa kpa yi, ri kya riwa wa no yi. <verse eid="LUK 10:8" /><verse number="9" style="v" sid="LUK 10:9" />No wa si wawa wa he lilo,&lt;&lt; Kpanchison Bachi a he huehyureri yi.&gt; <verse eid="LUK 10:9" /><verse number="10" style="v" sid="LUK 10:10" />Ka bi gra rimi gbu wa ran kpa yi ran, hi ri nkon gbu bi ri tre, <verse eid="LUK 10:10" /><verse number="11" style="v" sid="LUK 10:11" />&lt;Ko iwulu ri meme gbu mbi riwa a he za mbu ki kpo sro yi. Ama to ri nyin: Kpanchison Izhi he huehyure.&gt; <verse eid="LUK 10:11" /><verse number="12" style="v" sid="LUK 10:12" />Me la yi, a ri he bibi riwa bi wou ri vi sidon han ri gbu.<verse eid="LUK 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13" />&lt;&lt; Iya mbi, korasinu! Iya mbi, Batsaida! Ikya dindi riwa a he yi, wawu nye wa ti ri Taya nga sidon, wa ri kpa Izhi tu sisen mu, wa ki ri mgbanjan tsro nga nton. <verse eid="LUK 10:13" /><verse number="14" style="v" sid="LUK 10:14" />Ama a ri he ri vu sron ri Taya nga sidon chachu bla tre han bi yi. <verse eid="LUK 10:14" /><verse number="15" style="v" sid="LUK 10:15" />Bi yi, kafarnaum, wa ndzu yi hi ban shu? Onhon, wa gɨzhi wu ban mme. <verse eid="LUK 10:15" /><verse number="16" style="v" sid="LUK 10:16" />&lt;&lt;Nji riwa a wo yi a wo wen. nji riwa a kawan ri yi a kawan ri me; ama nji riwa a kawan ri me a kawan ri nji riwa a tiwen ndu.&gt;&gt; <verse eid="LUK 10:16" /><verse number="17" style="v" sid="LUK 10:17" />Nji se taŋkpan don hari wa bru ye ri ngɨri wari tre, &lt;&lt;Bachi, kau ri ibɨji ngawen wa ka ngamba de rimi nde wen.&gt;&gt; <verse eid="LUK 10:17" /><verse number="18" style="v" sid="LUK 10:18" />Yeso ka tre wa, &lt;&lt;Me to meme nji joku ka nzan zhu ri shu. <verse eid="LUK 10:18" /><verse number="19" style="v" sid="LUK 10:19" />Tomba, me no yi senkpa bran riwa bi chan iwan nga iran bi ri he senkpa bran han kpan fu mbi, ikya ran ti yi ran. <verse eid="LUK 10:19" /><verse number="20" style="v" sid="LUK 10:20" />Ama mi la yi ran ngɨri ritu Iyu wa ka noyi ran, ama ngɨri ritu wa ŋnga nde mbi ri shu.&gt;&gt; <verse eid="LUK 10:20" /><verse number="21" style="v" sid="LUK 10:21" />Ri chachu mba Yeso a shuu ri ngɨri ritu Wu Tsitsri, ran tre, &lt;&lt;Me gbre wu, A ti, Bachi ri shu nga meme, ritu wu ka kyawa wa nyin ka rii ri wa wiwɨri nga wawa wa to kya riwa a he kusi, ran ka tsro miri wa tsitsa. A wu a ti, rinyin a he sisron wen. <verse eid="LUK 10:21" /><verse number="22" style="v" sid="LUK 10:22" />&lt;&lt; Wawu kyawa wa he ri me riwa A ti kawa zi ri wo won. Njo ran to ri A ti he ngha ran ara ivren nga wawa ivren a su ran bu tre a riwu.&gt;&gt; <verse eid="LUK 10:22" /><verse number="23" style="v" sid="LUK 10:23" />Yeso a kɨma hi ri miriko wan ran tre ri yayɨbi, &lt;&lt;Ife he nji riwa isi wan to kya riwa bi to. <verse eid="LUK 10:23" /><verse number="24" style="v" sid="LUK 10:24" />Me la yi ri ikpa wawa wa la tre Izhi nga wa chu wa ran su wari to kya riwa bi to mba ama wana tou ran, wari wo kya riwa bi wo ama wa ran wo ran.&gt;&gt;<verse eid="LUK 10:24" /></para>
  <para style="s">Ikɨbu Tɨreritu nji Samariya Dindi</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25" />Chachu riwa wa tsro doka Musa wa wulude wari tsra Yeso.&lt;&lt;Nji ri tsro,&gt;&gt; Ka mɨyen,&lt;&lt;Me ti ngye me ri fe reriwa a ran kre ran?&gt;&gt; <verse eid="LUK 10:25" /><verse number="26" style="v" sid="LUK 10:26" />&lt;&lt; Ngye nye wa ŋnga rimi doka?&lt;&lt;Yeso ka tre. Bi kɨrau se?&gt;&gt; <verse eid="LUK 10:26" /><verse number="27" style="v" sid="LUK 10:27" />Inji-a ka tre:&lt;&lt;&lt;Nyɨme Izhi wen ri sron wen ri idɨri wen ri senkpa wen nga ri rimɨren wen&gt;&gt;&gt;, Nga,&lt;Yɨme wa kusan wen bibi riwa wu yɨme ngawen.&lt;&lt;&gt; <verse eid="LUK 10:27" /><verse number="28" style="v" sid="LUK 10:28" />&lt;&lt;Bi la tsra,&gt;&gt;Yeso ka tre.&lt;&lt;Ti ngamba bi ri sonbi.&gt;&gt; <verse eid="LUK 10:28" /><verse number="29" style="v" sid="LUK 10:29" />Ama nji-a a ran wa ran tsro wa ri wawu ti tsra, ka mɨyen Yeso ri,&lt;&lt;Nga ngye he ri kusan won?&gt;&gt; <verse eid="LUK 10:29" /><verse number="30" style="v" sid="LUK 10:30" />Yeso ka lawa ri:&lt;&lt;Nji ri a zhu ri Urushelima ran hi ri Yariko, ka gra riwo wa yɨbi. Wa gbon tsro wan, wari vu kongye wan hi ngamba, wa tsii wari hi kamba, chuwo ka ran wa ran kuu. <verse eid="LUK 10:30" /><verse number="31" style="v" sid="LUK 10:31" />Rinkon wa ndu Izhi ri ka ran hi ku bubu wan, riwa a to nji-a, ka hu nghɨma nkon riwan hi ngawan. <verse eid="LUK 10:31" /><verse number="32" style="v" sid="LUK 10:32" />Nga, nji Leviyawa ri, riwa a ri bubu wan ran to nji-a, ka vu yɨwa hu ku nghɨma nkon riwan. <verse eid="LUK 10:32" /><verse number="33" style="v" sid="LUK 10:33" />Ama nji samariya a ran hi zɨren, ran ye bubu ri wa nji-a he; riwa a to nji-a, ka lo sron. <verse eid="LUK 10:33" /><verse number="34" style="v" sid="LUK 10:34" />Ka ye ri wu ran lo njon wan-a riwu, ran zhu nghe mba ima ri ro ran sro riwu. ka ban nji-a sa ri nghɨma wan,ran gɨzhi hi ri ko riwa wa kpa tsɨren ki <verse eid="LUK 10:34" /><verse number="35" style="v" sid="LUK 10:35" />Ri vi ri hari wan ka ban dinari hari ka no wawa wa ya tsɨren-a.&lt;Ya wu,&gt;Ka tre, ka me kɨma ye, me noyi ngbron kya riwa bi wuu.&gt;<verse eid="LUK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36" />Imba Yeso ka miyen wa ri&lt;&lt;Nga rimi tra wanyi wu to a he wa kukpan nji riwa a gra riwo wa yɨbi-a?&gt;&gt; <verse eid="LUK 10:36" /><verse number="37" style="v" sid="LUK 10:37" />Wa tsro doka Musa waka tre,&lt;&lt;Nji riwa a ya ri si losron.&gt;&gt;</para>
  <para style="p" vid="LUK 10:37">Yeso ka lau,&lt;&lt;Hi bi ri ti bibi wan.&gt;&gt;<verse eid="LUK 10:37" /></para>
  <para style="s">Yeso ri ko Martha Ngha Mary</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38" />Riwa Yeso ri miriko wan wa he nkon ran hi, ka ye ri gbu ri riwa iwa ri nde wan a he Matta ka bu nkon ko wan ri wu. <verse eid="LUK 10:38" /><verse number="39" style="v" sid="LUK 10:39" />Ka he ri vayi wan wa ran yo wu ri mariya, riwa a son kusi Bachi ran wo kya riwa a ran tre. <verse eid="LUK 10:39" /><verse number="40" style="v" sid="LUK 10:40" />Ama Martha ka ran damu ritu a ran ti ri. Ka ye ri Yeso ran mɨyen,&lt;&lt;Bachi, wu ran damu riwa vayi won kawen don mi ti ndu ri kankshi won ran? La wu no zon wen!&gt;&gt; <verse eid="LUK 10:40" /><verse number="41" style="v" sid="LUK 10:41" />&lt;&lt;Matta, Matta! Bachi ka nyɨme,&lt;&lt;Wu damu ritu wuri kpa sron time ritu kyawa kigbu, <verse eid="LUK 10:41" /><verse number="42" style="v" sid="LUK 10:42" />ama ikya riri ari wa. Maremu a chu kya dindi riwa wana ba wu ran.&gt;&gt;<verse eid="LUK 10:42" /></para>
  <chapter eid="LUK 10" />
  <chapter number="11" style="c" sid="LUK 11" />
  <para style="s">Yeso a ran Tsro wa Bre</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1" />Ivi ri Yeso a ran bre ri bubu ri. Riwa a kre, rimi miri ko wan iri ka miye wu ,&lt;&lt; Bachi tsro ta bibi ri wa ki bre bibi riwa Yohana a tsro miri kowan.&gt;&gt;<verse eid="LUK 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2" />A tre,&lt;&lt; ka bi bre, bi ka tre:</para>
  <para style="q1" vid="LUK 11:2">&lt;A ti mbu riwa wu he ri shu,</para>
  <para style="q1" vid="LUK 11:2">tsitsɨrehen de wen,</para>
  <para style="q1" vid="LUK 11:2">kpanchi son we no ye.<verse eid="LUK 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3" />Ye ti chi ritu mbu no ta ri ri bla vi<verse eid="LUK 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4" />Ka meme ti mbu rega, bibi riwa kita ki ka meme ti</para>
  <para style="q2" vid="LUK 11:4">wari rega.</para>
  <para style="q1" vid="LUK 11:4">ran no ngɨzhi ta gra ri bubu meme ti ran.&gt;&gt;<verse eid="LUK 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 11:5" />Imba Yeso ka tre ri wa,&lt;&lt;wari tre iri imimbi he ri kpan, a hi ri wu ri chu ran tre ikpan wan no wen nkpon juju yɨmo tra ri shi, <verse eid="LUK 11:5" /><verse number="6" style="v" sid="LUK 11:6" />Ikpan won ri zhu bubu zeɨren ye ri me, mi ran he kya riwa me no ran,<verse eid="LUK 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 11:7" />&lt;&lt;Ikpan wan ka kpa nyɨme rimi tra ri, ran chu wen kpa ran, me tren nkon ye ki ta iwa miri won ki kru nna-e, me ran to wurunde meri nou kyari ngana. <verse eid="LUK 11:7" /><verse number="8" style="v" sid="LUK 11:8" />Me la yi a ran wurunde ran no juju yɨwon ran ritu a he kpan wan ran ama ritu ichu a ti riwa a kri riwu ri tu nji-a ri wurunde ran no bran bibi riwa ari wa.<verse eid="LUK 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 11:9" />&lt;&lt; Me layi, sondu bre wa no yi. sondu wa bi fe, sondu wɨru nkon wa bu riyi. <verse eid="LUK 11:9" /><verse number="10" style="v" sid="LUK 11:10" />Inji riwa a wa ari fe, nji riwa a bre wa no, nji riwa a wɨru nkon wa bu riwu.<verse eid="LUK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 11:11" />&lt;&lt;Nga rimi mbi biyi wa ti , riwa ivren wen ri mɨyen wu lambe wuka no manzɨrama? <verse eid="LUK 11:11" /><verse number="12" style="v" sid="LUK 11:12" />Ko inde a mɨyen ŋchen wuka no iran? <verse eid="LUK 11:12" /><verse number="13" style="v" sid="LUK 11:13" />To bi yi ri wa bi he wa meme bi no miri mbi kyawa wa dindi ama A ti mbi rishu ari no Wu wan ri Tsitsri no wawa wa bre wu!&gt;&gt;<verse eid="LUK 11:13" /></para>
  <para style="s">Yeso ri Balzabul</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14" />Chachu ri Yeso a ran zhu ri mangbi bɨzhi ri kpa nji ri, Riwa ibɨji-a zhu tse nji-a ka tre, ikpanji waka ti sisri. <verse eid="LUK 11:14" /><verse number="15" style="v" sid="LUK 11:15" />Inji wari wa tre,&lt;&lt; A he Balzabul, ichu wa bɨzhi ari zu bɨzhi <verse eid="LUK 11:15" /><verse number="16" style="v" sid="LUK 11:16" />Wari waye tsra Yeso ri no tsro wawa kya kpokpolo riwa ari nowawa nowa to gbengbren wan ri shu.<verse eid="LUK 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 11:17" />Ama Yeso a to ri mɨren mba, ran tra riwa,&lt;&lt;Ndu kpanchi riwa aga ti hari ritu ŋgu, kpanchi-a ran kri ran. nga nganyi inde iko riwa a ga ti heri ri ngamba, iko-a ri zi. <verse eid="LUK 11:17" /><verse number="18" style="v" sid="LUK 11:18" />Inde memenji ga ngawan ti hari ran ri tingu ri tuwan, ari ri tise ko kpanchi wan ri senkpa? Bi tre ri ri gbengbren balzabul nye me zhu bɨzhi. <verse eid="LUK 11:18" /><verse number="19" style="v" sid="LUK 11:19" />Inde ri gbengbren balzabul nye me zhu bɨzhi, to imiri ko mbi fa ri mgbemgɨren ngha nye wa zhu wamba? Imiri ko mbi nye wa bla tre riyi. <verse eid="LUK 11:19" /><verse number="20" style="v" sid="LUK 11:20" />Ama inde rimi gbengbren Izhi nye me zhu ri bɨzhi, ashe kpanchi Izhi ye riyi nye mba.<verse eid="LUK 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21" />&lt;&lt;Inde nji ri senkpa mɨlan ngawan ti, ran ri gben ko wan, Ikpa wa ko wan waki piyan <verse eid="LUK 11:21" /><verse number="22" style="v" sid="LUK 11:22" />Ama inde nji riwa a han ri senkpa ye ran han gbengbren wan, ari vu kpi wan riwa ari ya si riwa hi ngawan ran ka ga nji kpi-a riwa a vu ri ku.<verse eid="LUK 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23" />&lt;&lt;Nji riwa a ran he ri me ran a he meme nji won, riwa a ran vu kabru ri me ran, a ri vu vɨra.<verse eid="LUK 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24" />&lt;&lt;Riwa meme bɨzhi zhu rimi kpa nji, a ri bru hi ri kpa nji riwa a zhu ye, ran wa bubu son vɨri. Inde a ran fe bubu ran ari tre ri, tsiri me bru hi kowon ri sen. <verse eid="LUK 11:24" /><verse number="25" style="v" sid="LUK 11:25" />Inde a ye ran ye fe ikya ran he rimi ko wan-a ran, <verse eid="LUK 11:25" /><verse number="26" style="v" sid="LUK 11:26" />Ari bru hi ran hi vu meme bɨzhi wa senkpa tangban ye ran ye son rimi ko-a. Ari senkpa han ri gbuchi.&gt;&gt;<verse eid="LUK 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27" />Riwa Yeso a ran tre tre nyi, iwa ri rimi kpanji ka nzu ran, &lt;&lt;Dindi wan ri he wa riwa a ngɨzhi wu ran shou hari wu gbron.&gt;&gt;<verse eid="LUK 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28" />Yeso ka tre ri,&lt;&lt;Dindi wan ri he wawa wawo tre won wari tindu riwu.&gt;&gt;<verse eid="LUK 11:28" /></para>
  <para style="s">Alama riwa Yonana</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29" />Riwa nji wana kabru ri Yeso, ka gbuchi tre,&lt;&lt;Nzan wa zizan wa meme nzan wa wa nowa tsro wa alama kyawa, ama wana lawa kyawa ran tsede bibi riwa Yonana. <verse eid="LUK 11:29" /><verse number="30" style="v" sid="LUK 11:30" />Bibi riwa Yonana a he alama ri nji wa nineba, nganyi nye Ivren Nji ri he ri nji wanzan nyi. <verse eid="LUK 11:30" /><verse number="31" style="v" sid="LUK 11:31" />Chachu bla tre, ichu mba ri gbu sheba ri wurunde iwa wanzan nyi ran tsro wa ri wana ti tsra ran don a zhu kpata mu ye riwa ari ye wo tre riwa Solomu. ngye riwa a han Solomu ri wanyi. <verse eid="LUK 11:31" /><verse number="32" style="v" sid="LUK 11:32" />Chachu bla tre, wanji Niniba wa wurunde iwa wanzan nyi ran lawa ri wana ti tsra ran, ritu riwa wawo tre Izhi ri nyu Yonana wari ka meme timba chuwo to ngye nji riwa a han Yonana een.<verse eid="LUK 11:32" /></para>
  <para style="s">Ikpan Wulu ri Kpa</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33" />&lt;&lt;Wa ran ri ban wuru ri kpan ka zi ri za didan ran tsede nowa ka zi ritu wan no ran tsro wa ko no wa ran to kpantsu. <verse eid="LUK 11:33" /><verse number="34" style="v" sid="LUK 11:34" />Isi wen he kpan wuru ri kpa, inde isi bi. Ikpan wuru ri he kpa wawu. Ama inde isi wen time ikpa wawu ri ti bu. <verse eid="LUK 11:34" /><verse number="35" style="v" sid="LUK 11:35" />Itu ka wa, ikpan riwa wu ri wu he bu: <verse eid="LUK 11:35" /><verse number="36" style="v" sid="LUK 11:36" />Inde ikpa wen he ri kpan, bubu ri ran he ri bu ran, a ri kpan wawu, bibi riwa fitila.&gt;&gt;<verse eid="LUK 11:36" /></para>
  <para style="s">Yeso a Su wa Tsro Doka Musa nga Farisa che</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37" />Riwa Yeso a kre, nji Farisa ri ka yo wu iri no hi ran ri ri ri ko wan, a hi ran ka son ritu ri ri. <verse eid="LUK 11:37" /><verse number="38" style="v" sid="LUK 11:38" />Riwa nji Farisa to Yeso a ran gla wo ko ran ri ri ran tse ka ti hu. <verse eid="LUK 11:38" /><verse number="39" style="v" sid="LUK 11:39" />Imba Bachi ka tre wu, &lt;&lt;Bi yi Farisa bi ngɨla kugon vigba, ama bi yi bi he ri meme ti ri, isron ri sen nji ri meme ti. <verse eid="LUK 11:39" /><verse number="40" style="v" sid="LUK 11:40" />Biyi wa mkpɨran! Ashe a ran he Izhi nye riwa ti mi ran ti ra ran. <verse eid="LUK 11:40" /><verse number="41" style="v" sid="LUK 11:41" />Ama bi de tsrakya riwa a he ri nvangho mbi ikya ran meme riyi ran.<verse eid="LUK 11:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42" />Iya mbi Farisa, bi no Izhi iwulu ri kya riwa bi fe, igbɨron vunvu ri Lambu, ama bi kambi ri bla dindi nga Bachi, &lt;&lt;Bi ri ti kya bi ti wu rarumu bi ka ri kawa don ri.&gt;&gt; <verse eid="LUK 11:42" /><verse number="43" style="v" sid="LUK 11:43" />&lt;&lt;Iya mbi Farisa, ritu bi wa bubu son dindi ri ko Izhi, ri chi nji ri bubu richu.&gt;&gt; <verse eid="LUK 11:43" /><verse number="44" style="v" sid="LUK 11:44" />&lt;&lt; Iya mbi, ritu bi he ka bubu gyuru ri wa a bu nyu, riwa nji wa zeren ritu wan, wa ran to ran.&gt;&gt;<verse eid="LUK 11:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45" />Inji ri wa sro Doka Musa ka tre wu, &lt;&lt;Inji ri tsro, ri wa wu tre kya wa yin, wu kɨra ta tu ngawen.&gt;&gt;<verse eid="LUK 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46" />Yeso ka kpa nyime ran tre,&lt;&lt;bi ka ron kpi ri chan nji wato, doka riwa wa ron ri no wa ban, ama bi ran yo vren wo riri riwa bi zon wa.<verse eid="LUK 11:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 11:47" />Iya mbi ri wa bi mme bubu gyuru wa la tre Izhi riwa wa ti mbi wa wuu. <verse eid="LUK 11:47" /><verse number="48" style="v" sid="LUK 11:48" />Biyi ritu mbi bi to bi ri kpa nyime bibi riwa wa ti watimbi wa ti. wa wuu wa tsro tre Izhi, nga biyi bi mme bubu gru riwa. <verse eid="LUK 11:48" /><verse number="49" style="v" sid="LUK 11:49" />Ritu kya nyi, Izhi rimi to wan a tre,&lt; Ame me ti wandu wa la tre Izhi nga wandu Izhi, Wa wuu wari, wari wa nowa ya.&gt; <verse eid="LUK 11:49" /><verse number="50" style="v" sid="LUK 11:50" />Ritu nganyɨn wa bla tre ri nji wa nzan nyin ritu wuu riwa wa ti ri wa la tre Izhi wa hu tu riwa wa ti mgbumgbɨlu mme, <verse eid="LUK 11:50" /><verse number="51" style="v" sid="LUK 11:51" />zhu ri yii Habila, hi ri wa Zakariya, riwa wa wuu ri tsutsu bubu kri ri tre tre Izhi nga bubu tsɨtsɨri ri tra Izhi. Een, me la yi, wa bla tre ri wa nzanyi ritu wanyi wawu!<verse eid="LUK 11:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52" />&lt;&lt;Iya mbi wa tsro Doka Musa, ritu bi ngɨzhi ronron nkon ri tra ri to. Biyi ri tumbi bi ran gra ran, nga bi ri zu wawa wa su wari gra.&gt;&gt;<verse eid="LUK 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53" />Riwa Yeso a ka bubu wan don, wa tsro Doka Musa ri Farisa, wa gbuchi ran wau ri tre ri mɨyen ri kyawa kigbu, <verse eid="LUK 11:53" /><verse number="54" style="v" sid="LUK 11:54" />wa ran wa no yɨwa nyu ri tre riwa wari don vu.<verse eid="LUK 11:54" /></para>
  <chapter eid="LUK 11" />
  <chapter number="12" style="c" sid="LUK 12" />
  <para style="s">Ifenton Nga No Senkpa</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1" />Riwa ikpa nji wa kigbu wa ran chan ngamba za, Yeso ka gbuchi ran tre ri miriko wan, a tre: &lt;&lt;Biyi ti rereri mumu ri kpakpi fu riwa Farisa, ritu gyuru nji mba. <verse eid="LUK 12:1" /><verse number="2" style="v" sid="LUK 12:2" />Ba kya riwa wa kawu riwa wa ran bu ran, Ko kya riwa ari rii riwa wa ran tou ran <verse eid="LUK 12:2" /><verse number="3" style="v" sid="LUK 12:3" />Ikya riwa wu tre ri yayibi wa wou rira, ikya riwa wu tre ri titon ri mimi tra wa dɨbu wu ritu tra. <verse eid="LUK 12:3" /><verse number="4" style="v" sid="LUK 12:4" />&lt;&lt;Me la yi, wa kpan won, ran kɨlu nji riwa wa wuu kpa nga wari ran ya ti kya ngana. <verse eid="LUK 12:4" /><verse number="5" style="v" sid="LUK 12:5" />Me tsro yi nji riwa bi kɨlu: Kɨlu wawu riwa ari ya wuu kpa ran he ri gbengbren riwa ari ban wu, een, me la yi, kulu wawu. <verse eid="LUK 12:5" /><verse number="6" style="v" sid="LUK 12:6" />Wana reri ngye ton ri kubu hari ran? Ko riri rimi mba Bachi ran kadon ran. <verse eid="LUK 12:6" /><verse number="7" style="v" sid="LUK 12:7" />Njanji, infutu mbi ngawen a he ri bla wan. Ran ti sisiri ran; nkpen mbi a bran han riwa gye.<verse eid="LUK 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8" />Me la yi, ko ngha riwa a nyime rɨme ri kusi nji, Ivren Nji ri nyime wu ri kusi miriko Izhi. <verse eid="LUK 12:8" /><verse number="9" style="v" sid="LUK 12:9" />Ama nji riwa a kawan ri me kusi nji wa kamba riwu kusi miriko Izhi. <verse eid="LUK 12:9" /><verse number="10" style="v" sid="LUK 12:10" />Inji riwa ari tretre meme ri tu Ivren Nji wa kadon ri wu, ama nji riwa tretre meme ritu Iyu Tsitsri wa ran kadon riwu ran.<verse eid="LUK 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11" />&lt;&lt; Ka wa ngɨzhi yi hi ri tra Izhi, wa rinkon, ran tika ritu bibi riwa bi kpa kambi chuwo ko kya riwa bi tre ran, <verse eid="LUK 12:11" /><verse number="12" style="v" sid="LUK 12:12" />Iyu Tsitsri ri tsro yi kya riwa bi tre ri vi mba.&gt;&gt;<verse eid="LUK 12:12" /></para>
  <para style="s">Ikɨbutre ri wa nji ri wa a he ri Wo, ama a ran wɨri ran</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13" />Njo rimi kpa nji-a ka tre wu ri, &lt;&lt;Nji ri tsro, la vayi won no ga kpi timbu ran no wen wa mo.<verse eid="LUK 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14" />Yeso ka tre ri,&lt;&lt;Nji, njo ran chu wen me he nji ri bla tre rimi mbi ko nji ri ga kpi ri yi mbi vayiwen ran?&gt;&gt; <verse eid="LUK 12:14" /><verse number="15" style="v" sid="LUK 12:15" />Imba ka la riwa,&lt;&lt;Ya tsu! He wa ya tsu ritu kya riwa a he ri yawɨlo si; ivɨri nji a ran he ritu ikpa kpi riwa a he riwu ran.&gt;&gt;<verse eid="LUK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16" />Yeso ka la wa ikɨbu tre wan:&lt;&lt;Nji ri wo ri a he riwa izhu wan a zhu ri kpi dindi. <verse eid="LUK 12:16" /><verse number="17" style="v" sid="LUK 12:17" />A tre ngawan ri,&lt; me ti ngye? Me ran he ri wa wɨron bran riwa me ka ri won sro ran.&gt;<verse eid="LUK 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 12:18" />&lt;&lt;Imba ka tre, &lt;Ngye kya riwa me ti. Me zii wɨron won me ri mme ri bran wan, rimi wan nye me ka wa kpiwon ki rimi wan. <verse eid="LUK 12:18" /><verse number="19" style="v" sid="LUK 12:19" />Me tre ri ngawon, &lt;&lt;Wu he ri kpi kigbu riwa wu ri wa ri se kigbu riwa wa ye, ran ri, wuri ran so nga wuri son ri sisron.&lt;&lt;&gt;<verse eid="LUK 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 12:20" />&lt;&lt;Ama Izhi ka tre wu, a wu nji riwa wuran he ri wiwɨri ran! Ichu nyin me ban vɨri wen, Meri to ko ŋnga nye ari ri kyawa riwa wu kawa ki ri ngawen?&gt; <verse eid="LUK 12:20" /><verse number="21" style="v" sid="LUK 12:21" />Yeso a kre tre-a iri,&lt;&lt;Ngye bibi riwa ari he ri nji riwa a vu kpi ki ri ngawan ama kusi Izhi a ran he ri kyari ran.&gt;&gt;<verse eid="LUK 12:21" /></para>
  <para style="s">Ran ti Shnji Sɨron Ran</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22" />Yeso ka tre ri mirindu wan:&lt;&lt;Me la yi, ran ti shnji sron ritu vɨri mbi, ikya riwa bi ri; ka ritu kpa mbi, ko itsɨro riwa bi su. <verse eid="LUK 12:22" /><verse number="23" style="v" sid="LUK 12:23" />Isron mbi han ri, nga ikpa han tsro. <verse eid="LUK 12:23" /><verse number="24" style="v" sid="LUK 12:24" />To Lazaŋku: wa ran chu ran wa ran sɨren ran, wa ran he ri tra ri sro kpi ko iwuron; ama Izhi ri nowa ri. Bi han wa chenchen! <verse eid="LUK 12:24" /><verse number="25" style="v" sid="LUK 12:25" />Itaka bran rimi mbi ran ka vi ri yo ŋnga riwu ran? <verse eid="LUK 12:25" /><verse number="26" style="v" sid="LUK 12:26" />Tunda wu ran he ri gbengbren ri ti vi kya nyin ran, ritu ngye wu taka ritu ngbron mba?<verse eid="LUK 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 12:27" />&lt;&lt;To bibi riwa ikɨbu ri gbron, ko solomu riwa a su tsro wa dindi ka bibi mba. <verse eid="LUK 12:27" /><verse number="28" style="v" sid="LUK 12:28" />Ka a he kamba nye Izhi ri su tsro ri giga wa ji, riwa a he ri nyin luwa, nga mibrewaka vu wa sro rimi wulu, riwa me ri he se riwa ari su tsro riwu, biyi wa fifi kpanyɨme! <verse eid="LUK 12:28" /><verse number="29" style="v" sid="LUK 12:29" />Biyi ngawen ran ti shnji sron ritu kya riwa bi ri ko bi so ran, ran tika ritu wan ran. <verse eid="LUK 12:29" /><verse number="30" style="v" sid="LUK 12:30" />Wa ti gbugblu wa ŋgbuŋgbulume wa ti kya wa mba, Iti mbi ri shu to bi wa kya wamba. <verse eid="LUK 12:30" /><verse number="31" style="v" sid="LUK 12:31" />Ama wa kpanchison Izhi ri mimɨlan, kyawa wa he bran ri yi. <verse eid="LUK 12:31" /><verse number="32" style="v" sid="LUK 12:32" />&lt;&lt;Ran ti sisɨri ran, igbu miri wa tsitsa, A ti mbi ri ngɨri ri no yi kya rimi kpanchi. <verse eid="LUK 12:32" /><verse number="33" style="v" sid="LUK 12:33" />Bi reri wa kya mbi, bi ri zon wawa wa ran he riwu ran. Bi fe kpo nkɨren riwa a ran ri kunchon ran, wato bibi wo riwa a ran kre ran ri shu, bubu riwa wa yɨbi wa ran gra ri bubu wan ran, iwɨshu wa ran ya rewa ran. <verse eid="LUK 12:33" /><verse number="34" style="v" sid="LUK 12:34" />Bubu riwa wa kyawa wen wa he, ri bubu wan nye isron wen he ngawen.<verse eid="LUK 12:34" /></para>
  <para style="s">Kuki ri ya Tsu</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35" />&lt;&lt;Su kpi mbi ki ran gben ndu Izhi nga bi ri no wulu mbi ran ri no ran yɨbi ran, <verse eid="LUK 12:35" /><verse number="36" style="v" sid="LUK 12:36" />Ka nji riwa wa gben nji ri ko mba no zhu ri ko gran, ka a ye ran wuru nkon waka chegbla bu nkon ri wu. <verse eid="LUK 12:36" /><verse number="37" style="v" sid="LUK 12:37" />Ari bi ri miriko wawa nji riko mba ri ye ran fe wa wa ki ri gben. Me La yi kpunji, a ri su kpi ritu riwa ari ti ndu, ran nowa son ran riri ritu kpanchi, ran ran ti hidima riwa. <verse eid="LUK 12:37" /><verse number="38" style="v" sid="LUK 12:38" />Ari bi ri wa ndu riwa nji riko mba a ye to wa ki wari gben. ka a ye ri tsutsu chu. <verse eid="LUK 12:38" /><verse number="39" style="v" sid="LUK 12:39" />To ri nyin: Wari tre nji riko ri to vi riwa nji ri yibi ri ye, a ran nowa yɨra ko wan gra ran. <verse eid="LUK 12:39" /><verse number="40" style="v" sid="LUK 12:40" />Biyi ngawen mɨlan ki ran gben, ritu bi ran to vi riwa ivren nji ri ye ran.&gt;&gt; <verse eid="LUK 12:40" /><verse number="41" style="v" sid="LUK 12:41" />Bitrus ka miyen Yeso, &lt;&lt;Bachi, wu la ta ikɨbu tre rita, ka ri gbu nji? <verse eid="LUK 12:41" /><verse number="42" style="v" sid="LUK 12:42" />Bachi ka nyime, &lt;&lt;Nngan he dindi ran wɨri nji, riwa nji riko wan ri yo no he riwa ari ran no wa ndu wan nkɨren riri mba ri vi riwa a tsra? <verse eid="LUK 12:42" /><verse number="43" style="v" sid="LUK 12:43" />A ri bi ri nji ri ndu riwa iti ko wan ye fe ka ari tindu. <verse eid="LUK 12:43" /><verse number="44" style="v" sid="LUK 12:44" />Me la yi kpunji, a ri kau yo no he rinkon wawu kya riwa a he riwu. <verse eid="LUK 12:44" /><verse number="45" style="v" sid="LUK 12:45" />To idan a he riwa nji ri ndu tre ri ngawan, &lt;Njiriko wan a ri son rimu bran a ran ye gbagbla ran,&gt; Ran ku ri tsi wadu miri ron ri miri mba wa ndu ran ri ran so ran hua. <verse eid="LUK 12:45" /><verse number="46" style="v" sid="LUK 12:46" />Itiko nji ri ndu mba ri ye chachu riwa a ran yo sron ran, nga ri vi riwa a ran to ran, ari yɨra kpa ri gbagba,ran kau yo ri wawa wa ran ngɨzhi amana ran.<verse eid="LUK 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47" />Wawu nji ri ndu-a riwa a to sron nji riko wan, ran ran mɨlan son ran, a ran hu kyan riwa a lawu ran, ari no ya bran bran. <verse eid="LUK 12:47" /><verse number="48" style="v" sid="LUK 12:48" />Ama ivrenriko riwa a ran to sron tiko wan ran, nga ran ti kya riwa a ka no ya, wa no ya tsawen. A wu riwa wa nou kya bran. A wu riwa wa ka kya ri bran sa riwu wo, ikya riwa a bran han nye wa wau ri wo wen.&gt;&gt;<verse eid="LUK 12:48" /></para>
  <para style="s">Yeso a Ngɨzhi Ga Ye</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49" />&lt;&lt; Me ye riwa me ngɨzhi wulu ye ri gbungblume, isu won wari kyen wulu yo. <verse eid="LUK 12:49" /><verse number="50" style="v" sid="LUK 12:50" />Me he ri sontuima riwa wa ti ri mo, me vu ngɨzhi gbengben tse wa tiu kre ri mo! <verse eid="LUK 12:50" /><verse number="51" style="v" sid="LUK 12:51" />Bi yonga me ngɨzhi sisron nye ye ri gbungblume? onhon, me la yi kpunji, ara nga. <verse eid="LUK 12:51" /><verse number="52" style="v" sid="LUK 12:52" />Ivi zizan hi kusi nji ton rimi ko riri wa ga ngamba ti hari, itra wa tifu ri hari, nga hari wa tifu ri tra. <verse eid="LUK 12:52" /><verse number="53" style="v" sid="LUK 12:53" />Ngayin nye wa ga, Iti ri kawan ri vren wan, ivren ri kawan ri tiwan, iyi ri kawan ri vuruwa wan, vuruwa ri kawan ri yiwan iyi roron ri kawan ri iwa vren wan, iwa vren ri kawan ri wako wa ron wan.&lt;&lt;<verse eid="LUK 12:53" /></para>
  <para style="s">Ito vi</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54" />Yeso a tre ri gbu nji: &lt;&lt;ka bi to iwowulu ri zhu kusi nzan bi ka tre ri, &lt;Iwulu ri ye,&gt; Nga iwulu-a ri ye. <verse eid="LUK 12:54" /><verse number="55" style="v" sid="LUK 12:55" />Ka gungu ri fu hi kusi yawulu, bi ka tre, &lt;Ari ti gbaji,&gt; Nga ari ti gbaji. <verse eid="LUK 12:55" /><verse number="56" style="v" sid="LUK 12:56" />Biyi wa gyuru! bi ya to bibi riwa ishu ri meme he, ko ngye ti ko bi ran ya to bibi ndzan ri zizan ran?<verse eid="LUK 12:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57" />&lt;&lt;Ngye ti bi ran to bla tre ri ngambi riwa a tsra ran? <verse eid="LUK 12:57" /><verse number="58" style="v" sid="LUK 12:58" />Nowa tre, Ka biyi nga nji riwa a ngɨzhi yi hi bubu bla tre bi zɨren ri hi, tse bi ri ti bi ri ran jan nyu zhu ri nkon, ritu no ran ngɨzhi yi hi ri kusi nji ri bla tre ran. Nji ri bla tre ri kayi yo riwo nji wa lokpa, nji wa lokpa ri ka yi sro ri tra riwa wa tren nji. <verse eid="LUK 12:58" /><verse number="59" style="v" sid="LUK 12:59" />Me la yi, bi ran zhu ran, tse bi han kre wawu ko kyari ran don ran.<verse eid="LUK 12:59" /></para>
  <chapter eid="LUK 12" />
  <chapter number="13" style="c" sid="LUK 13" />
  <para style="s">Ka Memeti Chuwo ko wu ka Kuu</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1" />Iwa nji wari wa ye wa ri la wu tre ritu wa nji Galili riwa Bilatu a tre no wa wuu wa har iyi mba waka kabru riwu wa ti ban mba ri wu. <verse eid="LUK 13:1" /><verse number="2" style="v" sid="LUK 13:2" />Yeso a kpa nyime ri wa ran tre,&lt;&lt; Bi to kya wa nji Galili wati meme ti han ngbron wa nji Galili riwa wa to ya ngayin? <verse eid="LUK 13:2" /><verse number="3" style="v" sid="LUK 13:3" />Me la yi a ran he kamba ran. Inde bi ran ka meme ti mbi chuwo ran, bi yi ngawen bi kuu. <verse eid="LUK 13:3" /><verse number="4" style="v" sid="LUK 13:4" />Ko bi to nji wuru don tandɨra wawa itra a joku wa wa kuu ri Siluwam bi to kama wa ti meme ti han ngbɨron nji wa Urushelima? <verse eid="LUK 13:4" /><verse number="5" style="v" sid="LUK 13:5" />Me la yi a ran he ngamba ran. Inde bi ran ka meme ti mbi chuwo ran bi yi ŋgwen bi kuu.&gt;&gt;<verse eid="LUK 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6" />Imba Yeso ka la kɨbu tre: &lt;&lt;Nji ri a sen konkron mbwa ri ju wan, a hi ri bubu wa kɨlo wan ri tu wan, ama ka ran fe ko ri ran. <verse eid="LUK 13:6" /><verse number="7" style="v" sid="LUK 13:7" />Imba Yeso Ka tre nji riwa ari ya zhu-a, a ke ise tra zizan riwa me si ye ri nyin ritu miri wa kɨlo mbwa nyin ama me ran fe kyari ran. Tsen taga! Ritu ngye ka ari ra bubu kri?&gt;<verse eid="LUK 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 13:8" />&lt;&lt;&lt;Rinkon nji,&gt;Nji-a ka tre, &lt;ka wu chuwo ri se ri yo ngha, Me shiwu kagon miri sro taki riwu. <verse eid="LUK 13:8" /><verse number="9" style="v" sid="LUK 13:9" />Ka a kɨlo seri, ka bi! ama ka a ran kɨlo ran, tsen taga.&gt;&gt;&gt;<verse eid="LUK 13:9" /></para>
  <para style="s">Iwa ri Nkpuzhu a fe si Chachu son viri</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10" />Chachu son viri Yeso a ran tsro rimi itra Izhi ri, <verse eid="LUK 13:10" /><verse number="11" style="v" sid="LUK 13:11" />iwa ri a he riwa Iyu a no kru lilo ri se wuru don tandɨra. A son ri si a ran he ri senkpa riwa ari wurunde ran. <verse eid="LUK 13:11" /><verse number="12" style="v" sid="LUK 13:12" />Riwa Yeso a to wu, ka yowu ye kusi ran tre wu ri,&lt;&lt;Iwa, me siwu jo rimim lilo mba.&gt;&gt; <verse eid="LUK 13:12" /><verse number="13" style="v" sid="LUK 13:13" />Ka ban wo yo ritu, ka fe si ri bubu wan ran kɨma ran gbre Izhi.<verse eid="LUK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14" />Ama nji rinkon ri tra Bachi ka ti fu ritu Yeso a no si ri wa ri lilo chachu son vɨri, ka tre ri gbu nji,&lt;&lt;Ivi tanren he riwa wa ti ndu. Ye bi ri ye fe si ri chachu wa mba, a ran he chachu son vɨri ran.<verse eid="LUK 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15" />Imba Bachi ka nyime riwu ri,&lt;&lt;Bi yi wa gyuru nji! Ko ngha rimi mbi chachu son vri a ran ri sii nghɨma wan hi no so ima ran? <verse eid="LUK 13:15" /><verse number="16" style="v" sid="LUK 13:16" />Aran he ri iwa nyin, ivɨra Ibrahi, riwa meme nji ri yo ya ise wuru don tandɨra, Ka fe si chachu son vɨri ri meme bɨzhi ran?&gt;&gt; <verse eid="LUK 13:16" /><verse number="17" style="v" sid="LUK 13:17" />Riwa a Yeso a tre ngayin, wa kpan fu wan ishan ka ti wa, ikpa nji waka he ri kinklan sron ritu kya riwa a ran ti.<verse eid="LUK 13:17" /></para>
  <para style="s">Ikɨbu Tre Ritu Iwɨlo Masta</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18" />Yeso ka myen,&lt;&lt;Kpanchison Izhi he rise? me kau kabru ri ngye? <verse eid="LUK 13:18" /><verse number="19" style="v" sid="LUK 13:19" />A he ka iwɨlo su, riwa nji ri a ban ran ka chu ri rɨma wan. A gbron ran kɨma ti konkron, nga chenchen wa shu wa ti ko mba riw&gt;&gt; nganga Yeso ka bru mɨyen, &lt;&lt; Me ka kpanchison Izhi kabru ri ngye?<verse eid="LUK 13:19" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 13:21" />A he ka mumu riwa iwa ban pɨsi no kigbu rimi flawa tse no kpa fu kagon wa wu.<verse eid="LUK 13:21" /></para>
  <para style="s">Nkon Wɨrewɨre</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22" />Yeso a zɨren hi rimi nchongbu ri vigbu, ran tsro wa riwa a he nkon ran hi Urushelima. <verse eid="LUK 13:22" /><verse number="23" style="v" sid="LUK 13:23" />Inji ri ka mɨyen wu, &lt;&lt;Bachi, nji fiwen nye wa kpawa chuwo?&gt;&gt;</para>
  <para style="p" vid="LUK 13:23">Ka tre riwa ri, <verse eid="LUK 13:23" /><verse number="24" style="v" sid="LUK 13:24" />&lt;&lt; Ti bibi riwa wu ri gra hu nkon ri wɨrewɨre, ritu nji kigbu, Me la yi, wa su wari gra ama wana ya gra ran. <verse eid="LUK 13:24" /><verse number="25" style="v" sid="LUK 13:25" />Idan nji riko wulunde ran ka nkon, bi kukiri ri ra bi ri ran wuru nkon bi ri ran bre, &lt;nji rinkon, bu nkon ri ta.&gt;</para>
  <para style="p" vid="LUK 13:25">&lt;&lt;Ama ari nyɨme ran tre, Me ran to yi ran ko bubu riwa bi zhu ye ran.&gt;<verse eid="LUK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 13:26" />&lt;&lt; Imba bi tre, &lt;Ki ri kiri so ri wu, nga wu tsro ri gbu mbu.&gt; <verse eid="LUK 13:26" /><verse number="27" style="v" sid="LUK 13:27" />&lt;&lt;Ama Yeso ri tre, &lt;Me ran to yi ran ko bubu riwa bi zhu ye ran. Tsiri kon don wen, biyi wa meme ti!&gt; <verse eid="LUK 13:27" /><verse number="28" style="v" sid="LUK 13:28" />&lt;&lt;Wa ran yi ri bubu wan, wari ran tan ŋirin, ka bi to Ibrahi, Ishaku nga Yakubu ri wandu ri kpanchison Izhi, ama biyi kyumbi bi vu ngambi ta rega. <verse eid="LUK 13:28" /><verse number="29" style="v" sid="LUK 13:29" />Nji wa ye kugbo wa ye kusi zan, wa ye ku Yawulu wari wa ye kushu, wari kpa bubu dindi ri kpanchison Izhi. <verse eid="LUK 13:29" /><verse number="30" style="v" sid="LUK 13:30" />Nji wawa wa he kugon wa he kusi, riwa wa he kusi wa he kugon.&gt;&gt;<verse eid="LUK 13:30" /></para>
  <para style="s">Yeso a Losron ritu Urushelima</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31" />Chachu mba Farisa wari wa ye ri Yeso wa ri tre wu, &lt;&lt;Ka bubu nyi don wu ri hi bubu ri nkan. Hirudus riwa ran wuu.&lt;&lt; <verse eid="LUK 13:31" /><verse number="32" style="v" sid="LUK 13:32" />Yeso ka la wa ri, &lt;&lt;Hi la yawu ri ji wamba, Me zu bɨzhi nga me ri den nji kpachuwo lowa mba mbre, nga ri vi ri tra wan me kre ndu won.&gt; <verse eid="LUK 13:32" /><verse number="33" style="v" sid="LUK 13:33" />Ko rimi ngye, me he rimi hi luwa mba mibrenge vi ri mibrewan- ritu kpunji wan ba nji ri la tre Izhi ri riwa ari kuu ri gran ra Urushelima! <verse eid="LUK 13:33" /><verse number="34" style="v" sid="LUK 13:34" />&lt;&lt;A wu Urushelima, Urushelima, a wu riwa wu wuu nji ri la tre Izhi bi ri vu miri mbi kɨshuti, ka kuko riwa a vu miri wan kɨshuti ri ngban wan, ama bi ran su ran! <verse eid="LUK 13:34" /><verse number="35" style="v" sid="LUK 13:35" />Ya, iko mbi wa kadon riyi. Me la yi, bi ran to wen ngaran tse bi tre, &lt;Dindi wan ri he nji riwa a ye rimi nde Bachi.&gt;&gt;&gt;<verse eid="LUK 13:35" /></para>
  <chapter eid="LUK 13" />
  <chapter number="14" style="c" sid="LUK 14" />
  <para style="s">Yeso ri Ko Farisa</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1" />Chachu son vɨri ri, Yeso a hi ko riwa ari ri ri ri ko nji Farisa, ka mɨlan ya. <verse eid="LUK 14:1" /><verse number="2" style="v" sid="LUK 14:2" />Kusi wan nji ri a he ri lilo hu kpa. <verse eid="LUK 14:2" /><verse number="3" style="v" sid="LUK 14:3" />Yeso ka mɨyen Farisa nga wa tsro doka Musa, &lt;&lt;A bi riwa wa den nji chachu son vɨri?<verse eid="LUK 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 14:4" />Ama nji-a waka ki gbangbi. ka ndzu nji-a zi nde, ka den ran no hi ngawan. <verse eid="LUK 14:4" /><verse number="5" style="v" sid="LUK 14:5" />Imba Yeso ka mɨyen wa nji-a, &lt;&lt;Ngan rimi mbi ka ivren wan ko nghɨma wan ri joku rimi juju chachu son vɨri a ran gra ran ban wu jo ran?&gt;&gt; <verse eid="LUK 14:5" /><verse number="6" style="v" sid="LUK 14:6" />Wa ran he kya riwa wa tre ran. <verse eid="LUK 14:6" /><verse number="7" style="v" sid="LUK 14:7" />Riwa Yeso a to ri wa tsɨren-a wa ban bubu son ri nkpen ri kpanchi-a, ka la wa tre kɨbu kɨbu: <verse eid="LUK 14:7" /><verse number="8" style="v" sid="LUK 14:8" />&lt;&lt;Ka njo a yowu hi ri bubu ro gran, ran gbuchi son ri bubu ri nkpen ran, ka mbari nji ri nkpen ari ya ye. <verse eid="LUK 14:8" /><verse number="9" style="v" sid="LUK 14:9" />Ka a he kamba, nji riwa a yo yi ye ri ye ran tre ri yi, &lt;No nji nyin bubu son mbi.&gt; Ngha rimi shan wu kɨma hi ri bubu son wen. <verse eid="LUK 14:9" /><verse number="10" style="v" sid="LUK 14:10" />Ama Ka wa yowu nye, ban bubu tsitsa wan, ka nji riwa a yo wu ye, ari tre riwu, &lt;Ikpan, wulunde hi ri bubu dindi wan.&gt; Imba wu he ri nkpen ri kusi wa ngbron nji ri bubu wan. <verse eid="LUK 14:10" /><verse number="11" style="v" sid="LUK 14:11" />Nji riwa a no ngawan nkpen wa gbre wu, nga nji riwa a gbre ngawan wa no nkpen.&gt;&gt;<verse eid="LUK 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12" />Imba Yeso ka tre ri nji riwa a yo wu ye ri ro, &lt;&lt;Ka wu no wa ri ri ji ko iri ri yawulu, ran yo kpanwen, vayi wen ko wa gɨzhi wen, ko wa kukpan wen; ka wa ti, wawa ngawen wa yo wu hi wuri ti zhula riwa wa ti riwu. <verse eid="LUK 14:12" /><verse number="13" style="v" sid="LUK 14:13" />Ka wu yo ro, wuka yo wawa wa ran he ri kyari ran. wa lilo ndzu kpɨre, wa nkpuzhu, wa nfyen, <verse eid="LUK 14:13" /><verse number="14" style="v" sid="LUK 14:14" />nga wu fe dindi. Ko riwa wa ran he ri kya riwa wa han wu ran, waka han wu ri vi riwa wa ti dindi ti wa tashɨme.&gt;&gt;<verse eid="LUK 14:14" /></para>
  <para style="s">Ikɨbu Tre Riwa nchon Ro</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15" />Riwa nji ri rimi wawa wa ki riwu ri bubu son ka wo kamba, ka tre ri Yeso, &lt;&lt;Ife he ri nji riwa ari ri ri ri bubu ro ri kpanchison Izhi.&gt;&gt;<verse eid="LUK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16" />Yeso ka la ri, &lt;&lt;Nji ri a ran mɨlan bubu ro ran ti nga ran yo wa nji bran. <verse eid="LUK 14:16" /><verse number="17" style="v" sid="LUK 14:17" />Ri vi ri ro-a ka ti vrenko wan ri wawa wa yo wa ye ro-a,&lt;Ye, wa mɨlan ko ngye ti.&gt; <verse eid="LUK 14:17" /><verse number="18" style="v" sid="LUK 14:18" />Wawu nji riwa wa yowa wa kpuchi ran tre ri wa ran fe nkon ran, Ri gbuchi a tre, me rebubu, dole me hi miri to. <verse eid="LUK 14:18" /><verse number="19" style="v" sid="LUK 14:19" />&lt;&lt;Ri han wan ka tre, &lt;Me relando ri ron ti wuru, kuma me he ri nkon ri hi bubu tsra wa ri to. Bubwo nowen nkon.&gt; <verse eid="LUK 14:19" /><verse number="20" style="v" sid="LUK 14:20" />&lt;&lt;Iri nga ka tre, me gran wa sisa me ran ya ye ran.&gt; <verse eid="LUK 14:20" /><verse number="21" style="v" sid="LUK 14:21" />&lt;&lt;Ivren ri ndu ka bru ye ran la ri njiriko wan. Nji ri ko-a ka tifu ran la ivren ndu wan, &lt;Hi ra gbagbla ri wɨri bubu nga ri gbu wuri yo nji wa ya, yo wa nkpuzhu, yo wa nfɨyen. yo wa tambere.&gt; <verse eid="LUK 14:21" /><verse number="22" style="v" sid="LUK 14:22" />Imba ka tre,&lt;&lt;&lt;Nji rinkon,&gt;Ivren ndu tre, &lt;&lt;Ikya riwa wu mɨyen mi ti wu, ama hari zizan ngbɨron wa he.&gt; <verse eid="LUK 14:22" /><verse number="23" style="v" sid="LUK 14:23" />&lt;&lt;Imba njiriko ka la ivren ndu wan ri, &lt;Hi ri nkon nga gbu wu ri nowa ye rimi, bibi riwa iko won no shu. <verse eid="LUK 14:23" /><verse number="24" style="v" sid="LUK 14:24" />Yeso ka tre, me la yi kpunji, ko nji riri riwa me yo wa ye ri bi to ri ro won-a!&gt; &gt;&gt;<verse eid="LUK 14:24" /></para>
  <para style="s">Ikya wu ti ri he Virenko</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25" />Igbu nji bran wana hi zɨren ri Yeso, ka kɨma ya wa ran tre: <verse eid="LUK 14:25" /><verse number="26" style="v" sid="LUK 14:26" />&lt;&lt;Inde nji riwa ari ye rɨme nga ran ran kawan ri iti wan nga iyi wan ran, iwan wan nga miri, vayi wan roron nga vayi wan vɨruwa-een, kau ri ngawan-ana ya he vren kowon ran. <verse eid="LUK 14:26" /><verse number="27" style="v" sid="LUK 14:27" />Ngha wawu riwa a ran ban Nkpon konkron wan ran huwen ran a ran he vrenko won ran. <verse eid="LUK 14:27" /><verse number="28" style="v" sid="LUK 14:28" />&lt;&lt;Nowa tre iri rimi mbi riwa ran nme ko. Aran ri gbuchi kuson ran bla to kya riwa ari wuu ran to ko a he ri nkren riwa ari nme kre? <verse eid="LUK 14:28" /><verse number="29" style="v" sid="LUK 14:29" />Ka a zi nchi tra ran ran ya mme kre ran, ko ngha riwa a to ari nza-u, <verse eid="LUK 14:29" /><verse number="30" style="v" sid="LUK 14:30" />wa tre, &lt;Nji nyi a gbuchi ran mme ama a ran ya mme kre ran.&gt; <verse eid="LUK 14:30" /><verse number="31" style="v" sid="LUK 14:31" />&lt;&lt;Ko ichu ri ari hi ku ri ichu ri. Aran kuson ran bla to ko a he ri wa klukpa ngo wuru riwa waya tiku ri wawa wa he ngo iseari? <verse eid="LUK 14:31" /><verse number="32" style="v" sid="LUK 14:32" />Ka a ran ya ran, ari tru wari nowa hi ngbɨron mba wa ki kpata wari ran bre riwa wa ki sisron. <verse eid="LUK 14:32" /><verse number="33" style="v" sid="LUK 14:33" />Bibi wan nme, ko ngha rimi mbi riwa a ran de kongye riwa a he riwu ran a ran riya he vrenko won ran. <verse eid="LUK 14:33" /><verse number="34" style="v" sid="LUK 14:34" />&lt;&lt;Ima bi, ama ka a zhu rowan, ari ti rise ran bru ngɨzhi rowan ye nganga? <verse eid="LUK 14:34" /><verse number="35" style="v" sid="LUK 14:35" />Ima-a ran bi riwa ari he meme ko taki meme ran; wa kawu rega. &lt;&lt;Nji riwa a he ton ri wo no wo.&gt;&gt;<verse eid="LUK 14:35" /></para>
  <chapter eid="LUK 14" />
  <chapter number="15" style="c" sid="LUK 15" />
  <para style="s">Ikɨbu Tre Ritu ntɨma riwa a Kado</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1" />Imba wa kpa nkɨren meme nga meme ti Wa shu ngamba tu ki ri bubu wan wa ri wo-u, <verse eid="LUK 15:1" /><verse number="2" style="v" sid="LUK 15:2" />ama wa Farisa nga wa tsro doka Musa wa ran ti zhuzhu tre wari ran tre,&lt;&lt;Nji nyi a kpa wa meme ti ran ri ri ri wa.&gt;&gt;<verse eid="LUK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 15:3" />Imba Yeso ka la wa tre kɨbu kɨbu: <verse eid="LUK 15:3" /><verse number="4" style="v" sid="LUK 15:4" />&lt;&lt; Iri mbi he ri ntɨma se wuru, iri rimi mba kado, to tse wu ka se chu wa chuwo wuri wa riwa a kado ran? <verse eid="LUK 15:4" /><verse number="5" style="v" sid="LUK 15:5" />Inde a fe wu ari ban wu gran ri to ran ngiri <verse eid="LUK 15:5" /><verse number="6" style="v" sid="LUK 15:6" />nga ran hi ko. Ran yo wa kpan wan ri wa kusan wan ran tre wa,&lt; Zon wen ngiri, itu mi fe itɨwan won riwa kado.&gt; <verse eid="LUK 15:6" /><verse number="7" style="v" sid="LUK 15:7" />Yeso ka tre, bibi ri, kinklan sron ri he itu nji ri meme ti riri ri wa a ka meme ti wan chuwo a han nji se chu wa don chu wa wa sron dindi riwa wa ngamba ri ka meme ti mba chuwo.<verse eid="LUK 15:7" /></para>
  <para style="s">Itre kɨbu ri Nkren riwa a Kado</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8" />&lt;&lt; Ko ka iwa ritan ri he ri nkren jɨbɨo wuru inde riri kado, a ran yo wuru ran vu ko, ran sondu wa-u, hari ran fe wu ran? <verse eid="LUK 15:8" /><verse number="9" style="v" sid="LUK 15:9" />Inde a fe, tse ka vu kpan wan ri wa kusan wan, ran tre riwa ri,&lt;Ti kinklan sron ri me, ritu me fe kubu won riwa a kado-a.&gt; <verse eid="LUK 15:9" /><verse number="10" style="v" sid="LUK 15:10" />Nganyi nye me la yi, a he kya ri kinklan sron ri wa ndu Izhi inde nji ri meme ti riri ka meme ti wan chuwo.&gt;&gt;<verse eid="LUK 15:10" /></para>
  <para style="s">Itre kɨbu ritu Ivren riwa a Kado</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11" />Yeso a bru tre,&lt;&lt; Inji ri a he ri miri ronron hari. <verse eid="LUK 15:11" /><verse number="12" style="v" sid="LUK 15:12" />Ivren tsitsa ka tre ri tiwan, A ti, no wen san won kpi won,&gt; Tse Iti wan ka yowa ran ga kpi wan riwa.<verse eid="LUK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 15:13" />&lt;&lt;Kugon vi tsawen, Ivren tsitsa-a ka vu kpi wan kabru, ran kunkon hi zɨeren kpata. Imun a ka vu kpi wan reran zɨren ntran ri wu kre. <verse eid="LUK 15:13" /><verse number="14" style="v" sid="LUK 15:14" />Riwa a ri kpi wan kre, inchon yon ri ka gbu tse iya ka vuu. <verse eid="LUK 15:14" /><verse number="15" style="v" sid="LUK 15:15" />A hi ran ka fe vren gbu ri waka ban wu hi no ho dushu ri ko. <verse eid="LUK 15:15" /><verse number="16" style="v" sid="LUK 15:16" />Ka wa ran vu ri dushu ri ko riwa wa rega ri mme, ama ba njo riwa a no kyari<verse eid="LUK 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 15:17" />&lt;&lt;Riwa isron wan a ye bubu riri, ka tre, &lt;Nji bren riwa wa tindu ri wo tiwon wa he ri iri hari wari dongbron, ama ga ame me son ri nyi ri kuu yon! <verse eid="LUK 15:17" /><verse number="18" style="v" sid="LUK 15:18" />Me bru hi ri tiwon me la wu a ti me ti meme ti riwu nga ri Bachi Izhi. <verse eid="LUK 15:18" /><verse number="19" style="v" sid="LUK 15:19" />Me ran he riwa wu yo wen ri ivren wen ran; no wen me he ka wandu wen riwa wa tindu riwu.&gt;&gt;&gt; <verse eid="LUK 15:19" /><verse number="20" style="v" sid="LUK 15:20" />Imba ka wulunde ran wa tiwan hi.</para>
  <para style="p" vid="LUK 15:20">&lt;&lt;Ama riwa wayin a walude na hi Iti wan. Ri wa he kpa, Ti wan iwa iti wan a to wu ka he kiŋklan sron ri wu na tsutsu ka vu vren wan ran sonwon igban na mau ŋgyun.<verse eid="LUK 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 15:21" />&lt;Ivren-a ka tre riwu. &lt;A ti,&gt; me ti meme ti ri Izhi nga ri wu. Ame me ran he ri wa wu yo wen ri ivren wen ran. <verse eid="LUK 15:21" /><verse number="22" style="v" sid="LUK 15:22" />&lt;&lt; Iti wan a tre wandu wan, chegbla hi bi ri ban tsro dindi ye su riwu. Ama ban zube son wu riwo nga ntan za son wu riza. <verse eid="LUK 15:22" /><verse number="23" style="v" sid="LUK 15:23" />Hi vu nkɨshu riwa a ti nju bi ri wuu. ki ti ri dindi kiri ti ro. <verse eid="LUK 15:23" /><verse number="24" style="v" sid="LUK 15:24" />ritu ivren won a kuu ama zizan a he ri renganga.&gt; Imba waka gra ri ngiri bran.<verse eid="LUK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25" />&lt;&lt;A he riwa ivren wan rinko a he fili. Riwa a ye wɨreri ko, ka wo ngangan ri ro. <verse eid="LUK 15:25" /><verse number="26" style="v" sid="LUK 15:26" />tse Ka yo wandu ri ko tiwan ri ran miyen kya riwa ari dzren. <verse eid="LUK 15:26" /><verse number="27" style="v" sid="LUK 15:27" />&lt; Vayi wen ye,&gt; A tre riwu,&lt;nga iti wen chu nkɨshu ri wuu ritu a to wu a ye ko ri si kpa.&gt;<verse eid="LUK 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28" />&lt;&lt; Ivren rinkon a tifu bran ran kawan ri gra ko. riwa iti wan ka ye rira ran bre wu. <verse eid="LUK 15:28" /><verse number="29" style="v" sid="LUK 15:29" />Ama ka nyɨme ri tiwan,&lt; Tomba! Ikpa se riwa ki he mbu ri son ngɨzhi ri wu me ran kaa wo tre wen ngbaji ran. Ama wu ran no wen vren yawo zari to ran riwa miri ngɨri ri wa kpan won. <verse eid="LUK 15:29" /><verse number="30" style="v" sid="LUK 15:30" />Ama riwa ivren nyi riwa a ti vava ri kpi wen ri wa ntran ye ko, wu wuu nchon ntɨma riwu!&gt;<verse eid="LUK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 15:31" />&lt;&lt;&lt;Ivren won,&gt; Iti wan a tre, &lt; wu he me ko shitan, nga ko ngye riwa me he riwu a he wa me. <verse eid="LUK 15:31" /><verse number="32" style="v" sid="LUK 15:32" />Ama a he ki ti kinklan sron ki ri ngɨri, ritu riwa vayi wen a kuu ama a bru ye ri si; a kado ama ki fe.&gt;&gt;&gt;<verse eid="LUK 15:32" /></para>
  <chapter eid="LUK 15" />
  <chapter number="16" style="c" sid="LUK 16" />
  <para style="s">Yeso a tsro ritu nji ri ya ndu riwa wana kpanyɨme riwu ran</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1" />Yeso a tre ri miriko wan:&lt;&lt; Wa ti nji ri a he wo bran ivren rindu wan a kpa kpi nji riko wan ran ti vava. <verse eid="LUK 16:1" /><verse number="2" style="v" sid="LUK 16:2" />Imba nji riko wan ka yo vren ndu wan ran miyen-u,&lt;ngye me wo nji wa tre ritu wen? bla nduwen riwa wuti rimo, ritu wuran bru he vren rindu won ngana.&gt;<verse eid="LUK 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 16:3" />&lt;&lt;Ivren ko wan ka tre ri ngawan, &lt;ko me ti se zizan? Nji riko won ri zu wen rindu won. Me ran senkpa riwa me ron ran nga meti shan riwa me bre. <verse eid="LUK 16:3" /><verse number="4" style="v" sid="LUK 16:4" />Zizan me to kya ri wa me ti, ka me hi nji wa kpa wen gra ri ko mba.&gt;<verse eid="LUK 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5" />&lt;&lt;Imba kayo wawa nji riko wan ri hu wa la yɨri-yɨri ran mɨyen nji ri mimɨlan,&lt;Inji riko won ri huu ibren?&gt;<verse eid="LUK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 16:6" />Ka tre ri,&lt;&lt;&lt;Galo gbigba tandɨra ri nye atile,&gt; Ivren rindu-a ka no ban mbe ila wan ran lau ri son me gbagbla wuri ngha wuri no noe gbigba nza.&gt;<verse eid="LUK 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 16:7" />Ka miye ri han wan,&lt; Ibren nye nji riko won ri huu?&gt;</para>
  <para style="p" vid="LUK 16:7">&lt;&lt;&lt;Ivren rindu Ka tre, ikpo ngori ri alikama, ka tre riwu ri ban mbe wen wuri kɨmau ti no he gbigba tandɨra<verse eid="LUK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 16:8" />Riwa nji riko wan a wo kya riwa a ti, ka gbre nji ritu wiwɨri riwa a ti. Ritu wawa wa ran to Izhi ri mgbungbɨlume nyi wati wiwɨri ri nji han wawa wa son ri kpan tsu. <verse eid="LUK 16:8" /><verse number="9" style="v" sid="LUK 16:9" />Yeso ka tre riwa, tindu ri nkren riwa bi he ri wu bi ri zon nji wari riwu ritu wari he kpan mbi, ritu ka wu kuu Izhi nga mirindu wan wa kpa yi ri shu riwa bi ki wawa ri mmu.<verse eid="LUK 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 16:10" />&lt;&lt;Inji riwa a kpa nyɨme ri kya riwa a he fiwen, wu kpa nyɨme ri kya ri bran nga nji riwa a ran kpa nyɨme ritu kya ri fiwen ran, a ran kpanyɨme ri kya riwa a bran ran. <verse eid="LUK 16:10" /><verse number="11" style="v" sid="LUK 16:11" />Inde bi ran kpanyɨme ri wo riwa Izhi noyi ri mgbungbɨlume nyi ran, bi to ari noyi wo ri kpunji tre? <verse eid="LUK 16:11" /><verse number="12" style="v" sid="LUK 16:12" />Inde bi ran kpa nyɨme ri kpi njo ran, ngha ri no yi kpi wambi.<verse eid="LUK 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13" />&lt;&lt;Ivren riko ran to ngɨzhi wati ko ti hari ran tsede ka hu ri ran kawan ri iri, wuran to nyɨme Izhi mba kubu ri ka riri ran.&gt;&gt;<verse eid="LUK 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14" />Farisa wari wawa wa nyɨme ri nkren wa wo tre nyi wa ri tanfɨyon ri Yeso. <verse eid="LUK 16:14" /><verse number="15" style="v" sid="LUK 16:15" />Yeso Ka tre ri Farisa,&lt;&lt; bi wa Bi ri no nji nowa to ri bi he tsitsri nji ama Izhi to sron mbi. Ritu ikya riwa bi to ri a bi ama kusi Izhi a ran bi ran.<verse eid="LUK 16:15" /></para>
  <para style="s">Itsɨro sro ngha</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16" />&lt;&lt; Doka riwa Izhi a no Musa nga wawa imiri wandu Izhi wa ngha hi ri vi riwa Yohana a ye. kugon riwa Yohana a ye, itre dindi ritu kpanchison Izhi a ye, ko ngha ka ran sontuwan rimi wan. <verse eid="LUK 16:16" /><verse number="17" style="v" sid="LUK 16:17" />Ari he huɨri ri shuwulu mba meme nowa kado riwa vi wɨlo tre rimi Doka no kado.<verse eid="LUK 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18" />&lt;&lt; Inji riwa a zu wa wan ran gran wa ri a kuru ri wa nji, nga nji riwa a gran wa riwa a zhu riko ronron a kru ri ron won njo.<verse eid="LUK 16:18" /></para>
  <para style="s">Nji ri wo Ngha Lazarus</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19" />Yeso a bru tre,&lt;&lt;Inji ri wo riwa a suu tsro riwa a ti renga a ran to ro wan bla vi. <verse eid="LUK 16:19" /><verse number="20" style="v" sid="LUK 16:20" />Ri nkon ko nji riwa a he ri wo nji ri a ran ibreriwa nde wan a he lazarus, a he ri njon kagon kpa wan <verse eid="LUK 16:20" /><verse number="21" style="v" sid="LUK 16:21" />a ran yo sron ran ri kya riwa a zhu ri tebɨru nji ri wo rega. ka hu ri yawu wa ye ran ren njon wan-a.<verse eid="LUK 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22" />&lt;&lt; Ivi a ye riwa nji riya a kuu nga wandu Izhi waka ban wu hi ri bubu riwa Ibrahi a he. Inji ri wo ngawen ka kuu nga wa no yɨbi. <verse eid="LUK 16:22" /><verse number="23" style="v" sid="LUK 16:23" />Ri bubu riwa wawa wa kuu wari ki ri gben chachu bla tre, nji riwo-a a ran so ya bran, ka nzu tu ran to Ibrahi nga Lazarus kusan wan. <verse eid="LUK 16:23" /><verse number="24" style="v" sid="LUK 16:24" />Ka yo wu, &lt;A ti Ibrahi, ya wen ri si losron wuri ti Lazarus ndu no son vren wo ri ima ran huen yo ri mo ri rɨme, ritu me so ya ri bubu ri nyi.&gt;<verse eid="LUK 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25" />Ama Ibrahi ka tre, &lt;Ivren won, tika rivi riwa wu he ri si wu ran ri ro wan ama Lazarus a ran to ya, ziza ari to ro wan nga a wu wu to ya. <verse eid="LUK 16:25" /><verse number="26" style="v" sid="LUK 16:26" />Kugon rimba, ri tsutsumbu ri wu nchon juju he ritu wawa wa he kunyi wana ya ye kumba ran nga wawa wa he kunyi wa ran ya ye kunyi ran.<verse eid="LUK 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 16:27" />Imba,&lt;&lt;Nji ri wo-a Ka nyime,&lt; Me bre wu, a ti Ibrahi, ti lazarus ndu hi ri ko tiwon, <verse eid="LUK 16:27" /><verse number="28" style="v" sid="LUK 16:28" />ritu me he ri mirivayi ton. No fen wa ton, ritu nowa ran ye ri bubu riwa me he nyi ran iya bran ri bubu wan.&gt;<verse eid="LUK 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29" />Ama,&lt;&lt; Ibrahi ka tre, &lt;Wa miri vayi wen wa to Doka Musa nga mbe riwa imirindu Izhi wa ngha nowa mirivayi wan nowa wo kya riwa wa lawa.&gt;<verse eid="LUK 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 16:30" />Ama nji ri wo-a ka tre ri Ibrahi,&lt;Onhon, rimba ran tsra ran, ka njo ri a kuu ran bru hi riwa ran fen wa ton wa ka meme ti mba chuwo.&gt;<verse eid="LUK 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 16:31" />Ama,&lt;&lt;A ti Ibrahi Ka tre, idan wana wo Musa nga wa ndu Izhi ran, ko ngha ran tashɨme ri bubu gyuru ran lawa wana kpanyɨme ran.&gt;&gt;&gt;<verse eid="LUK 16:31" /></para>
  <chapter eid="LUK 16" />
  <chapter number="17" style="c" sid="LUK 17" />
  <para style="s">Ihan Ndu ti Memeti</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1" />Yeso a tre ri miriko wan:&lt;&lt;Kayawa riwa a no nji nowa ti meme ti wa ye, iya nji riwa ari ngɨzhi kyawa wamba ye. <verse eid="LUK 17:1" /><verse number="2" style="v" sid="LUK 17:2" />A ri bi riwu nowa lou ri nɨran rito wari kawu tayo rimi nne riwa ari no vren tsitsa no ti meme ti. <verse eid="LUK 17:2" /><verse number="3" style="v" sid="LUK 17:3" />Ya ngambi yi. &gt;&gt; inde vayi mbi ti meme ti, wuka gbi wu nvunvuton, nde a wou, wuka kachuwo riwu. <verse eid="LUK 17:3" /><verse number="4" style="v" sid="LUK 17:4" />Idan a ti meme ti riwu ŋkpa tagban ri mi vi riri,ran bru ye riwu ŋkpa tangban na tre, &lt;mi ran tingana,&gt; Wuka kachuwo riwu.&gt;&gt; <verse eid="LUK 17:4" /><verse number="5" style="v" sid="LUK 17:5" />Wa la tre Izhi waka tre ri Izhi, &lt;&lt;No kpa nyime mbu no chiwi hi kusi.&gt;&gt; <verse eid="LUK 17:5" /><verse number="6" style="v" sid="LUK 17:6" />Yeso ka la wa,&lt;&lt;Ka bi he ri kpa nyɨme fiwen ka iwɨlo suu, wu ya tre ri kpolo konkron nyin, &lt;Gbi ngawen wuri hi chu ngawen rimi nne,&gt; Nga ari wo tre wen. <verse eid="LUK 17:6" /><verse number="7" style="v" sid="LUK 17:7" />Ka iri mbi a he vren ko ari ron ko a ri ya tɨman. Ari ya tre riwu ri no ye kuson ran riri? <verse eid="LUK 17:7" /><verse number="8" style="v" sid="LUK 17:8" />Aran tre ri,&lt; Ti ri ri mo wuri kri gben wen mi ri mi ri so ri ko a wu wuri ri wuri so&gt;? <verse eid="LUK 17:8" /><verse number="9" style="v" sid="LUK 17:9" />Ari ngɨri ri vren ndu wen ritu a ti kya riwa wu lawu no ti riwu? <verse eid="LUK 17:9" /><verse number="10" style="v" sid="LUK 17:10" />Ka a wu ngawen, ka wu ti kya riwa wa tre riwu no ti, wu tre ri,&lt;Ritu ngye ko wa ngɨri ri ta, ki ti ndu mbu nye,&gt;&gt;&gt;<verse eid="LUK 17:10" /></para>
  <para style="s">Yeso a Den wa lilo Nkpuzhu Wuru</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11" />Aran hi ri Urushelima, Yeso ka ran zɨren ran hi ri tsɨtsu gbu Samariya nga Galili: <verse eid="LUK 17:11" /><verse number="12" style="v" sid="LUK 17:12" />Riwa Yeso a ran hi rimi gbu, nji wuru riwa wa he ri lilo nkpuzhu waka fe. Waka ki kpata riwu <verse eid="LUK 17:12" /><verse number="13" style="v" sid="LUK 17:13" />Ngha waka yo wu gbangban,&lt;&lt;Yeso, Nji rinko, toya mbu!&gt;&gt; <verse eid="LUK 17:13" /><verse number="14" style="v" sid="LUK 17:14" />Riwa Yeso ka towa, ka tre,&lt;&lt; Hi, ka kambi tsro nji ri la tre Izhi.&gt;&gt; Riwa waka hi, waka tsɨri wa. <verse eid="LUK 17:14" /><verse number="15" style="v" sid="LUK 17:15" />Imba iri rimi mba, riwa a to ri wawu fe den, ka bru ye, ran ran gbresan nde Izhi gbangban. <verse eid="LUK 17:15" /><verse number="16" style="v" sid="LUK 17:16" />Ka kɨbu ngbazhu ri ŋdaza Yeso ran ran ngɨri riwu nji-a a he samariye nye. <verse eid="LUK 17:16" /><verse number="17" style="v" sid="LUK 17:17" />Yeso ka miyen, &lt;&lt;Wa ran tsɨri yi ŋgibrewuru-a ran? mgbron chu wa wa he kutan?<verse eid="LUK 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 17:18" />Wa ran fe iri riwa ari bru ye ran ye gbresan nde Izhi ran kara itsɨren-a?&gt;&gt;<verse eid="LUK 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 17:19" />Imba Yeso ka tre ri nji-a,&lt;&lt;Wurunde wuri hi, ikpaŋyɨme wen nowu si.&gt;&gt;<verse eid="LUK 17:19" /></para>
  <para style="s">Iye ri Kpanchison Izhi</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20" />Chachu ri, Farisa waka mɨyen iri shitan nye Kpanchison Izhi nyin ri ye, Yeso ka tre,&lt;&lt;Kpanchison Izhi ran he kya riwa wa tou ri si ran,<verse eid="LUK 17:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 17:21" />Wana ran tre, a he ri nyin ka a he rimu ran, Kpanchisin Izhi-a he rimi ŋbi rimba. <verse eid="LUK 17:21" /><verse number="22" style="v" sid="LUK 17:22" />Ŋba Yeso ka bru tre ri miri ko wan, ivi ri ye riwa bi wa bi ri to ivi riwa bi ki wawa vren nji bi ran to ran.<verse eid="LUK 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 17:23" />Nji wa la yi, ngye a he een, ngye wu een, ran hi riwa ran, ran huwa ran. <verse eid="LUK 17:23" /><verse number="24" style="v" sid="LUK 17:24" />Ivren Nji ri vi wan ari ye ka irinzan, riwa ari kpan wɨri zhu ri ŋju nyi hi ri ŋju mu. <verse eid="LUK 17:24" /><verse number="25" style="v" sid="LUK 17:25" />Ari gbuchi to ya branbran wa kamba ri wu ri ndzan nyin.<verse eid="LUK 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 17:26" />Ka riwa a he ri vi Nuhu, kamba nye ari he ri vi riwa Ivren Nji. <verse eid="LUK 17:26" /><verse number="27" style="v" sid="LUK 17:27" />Nji wa ran ri, wari ran so, wari ran gran wari ran de gran hi ri vi riwa Nuhu a gra rimi nvu ima. ishu ima ka ye ran vu wa kre. <verse eid="LUK 17:27" /><verse number="28" style="v" sid="LUK 17:28" />A he kamba ri vi lutu. Nji wa ri wari so, wa rewari ka re, wa chu wari nme. <verse eid="LUK 17:28" /><verse number="29" style="v" sid="LUK 17:29" />Riwa ivi riwa lutu a ka Saduma don, iwulu ri tita wulu ka zhu rishu ye ran wuu wa kre. <verse eid="LUK 17:29" /><verse number="30" style="v" sid="LUK 17:30" />&lt;&lt; Ari he ngayin ri vi riwa ivren nji zhu ri ngawan. <verse eid="LUK 17:30" /><verse number="31" style="v" sid="LUK 17:31" />Chachu mba njo riwa a he ri ra ko wan, ri kpi wan rimi wan, a ran hi ran bru vuwa ran. kambame, njo ran zhu ran bru kɨma hi ritu kyari wan ran. <verse eid="LUK 17:31" /><verse number="32" style="v" sid="LUK 17:32" />Taka wa lutu! <verse eid="LUK 17:32" /><verse number="33" style="v" sid="LUK 17:33" />Nji riwa a ran sɨreri rewan a ran fe wu ran, nga nji riwa a sɨreri rewan ari fe wu. <verse eid="LUK 17:33" /><verse number="34" style="v" sid="LUK 17:34" />Me la yi, ri chu mba nji hari wa kru ri bubu riri, ama wa ban ri wari ka ri don. <verse eid="LUK 17:34" /><verse number="35" style="v" sid="LUK 17:35" />Mba hari wa ran kon haha mba, ama wa ban ri wari ka iri don. <verse eid="LUK 17:35" /><verse number="36" style="v" sid="LUK 17:36" />Ronron hari wana ron ri zhu, ama wa ban ri wari ka iri don. <verse eid="LUK 17:36" /><verse number="37" style="v" sid="LUK 17:37" />&lt;&lt;Rimi nyin, Bachi? Imirikowan Waka mɨyen. ka lawa,&lt;&lt;Ri bubu riwa ikɨmo he, bubu wan nye izitakpa wa ki.&gt;&gt;<verse eid="LUK 17:37" /></para>
  <chapter eid="LUK 17" />
  <chapter number="18" style="c" sid="LUK 18" />
  <para style="s">Itre Kɨbu Riwa Iwa ri Kɨbo ri Bre</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1" />Mba Yeso ka la miriko wan ikɨbu tre ri nowa ran ibrebɨla vi no wa ran kumbɨra ran. <verse eid="LUK 18:1" /><verse number="2" style="v" sid="LUK 18:2" />Ka tre:&lt;&lt;Ri gbu riwa wa ti nji ri bla tre ri riwa a ran kɨlu sisɨri Izhi nga a ran to nji kya ran. <verse eid="LUK 18:2" /><verse number="3" style="v" sid="LUK 18:3" />Iwa ri a he riwa iron wan a kuu, ka ran ye ri wu, ran tre,&lt;Gra rimi mba wawa kpan fu won.<verse eid="LUK 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 18:4" />&lt;&lt;Ka ban vi ran kawan. Mba ran bru tre ri sron wan, &lt;ko riwa riwa me ran kɨlu Izhi ran, me ran ri ya nji ran, <verse eid="LUK 18:4" /><verse number="5" style="v" sid="LUK 18:5" />Ri tu iwa ri kɨbo-a ka ran dami won, me ti bibi riwa wa kpa tre-a ka no, ri tu no ran ye bla vi ran!&gt;&gt;&gt; <verse eid="LUK 18:5" /><verse number="6" style="v" sid="LUK 18:6" />Mba Bachi ka tre,&lt;&lt;Wo kya riwa nji ri bla tre ri che a tre. <verse eid="LUK 18:6" /><verse number="7" style="v" sid="LUK 18:7" />Ko Izhi a ran ti kya dindi ri miri wan riwa a chu wa ran, riwa wa yi riwu ri ji ri chu ran? Ari kawa chuwo ngamba? <verse eid="LUK 18:7" /><verse number="8" style="v" sid="LUK 18:8" />Me la yi, ari to bibi riwa wa zonwa, ri gbagbla. Ka Ivren Nji ye, ari fe yosron ri gbungblume?&gt;&gt;<verse eid="LUK 18:8" /></para>
  <para style="s">Itre Kɨbu riwa nji Farisa nga nji ri Kpa nkren ri Meme</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9" />Mba ka nowa kɨbu tre ri wawa wa kpa nyime ri kamba wari ban wari ri wa ran he kya ran, Yeso ka la tre kɨbu-a: <verse eid="LUK 18:9" /><verse number="10" style="v" sid="LUK 18:10" />&lt;&lt;Nji hari wa hi tra Bachi wa ri bre, iri a he Farisa, nga iri wan ka he nji ri kpa nkɨren meme. <verse eid="LUK 18:10" /><verse number="11" style="v" sid="LUK 18:11" />Mba Farisa ka krinde ran ibreritu ngawan:&lt; Izhi, me ngɨri riwu ritu me ran he ka ngbron nji wa yɨwi-a ran, wa ti meme ti, wa wa mba nji ko ka nji ri kpa nkɨren ri meme. <verse eid="LUK 18:11" /><verse number="12" style="v" sid="LUK 18:12" />Me vu lama ŋkpa hari ri sati nga meri chu iri rimi ngbɨre wuru ri wawu kya riwa me fe.&gt;<verse eid="LUK 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13" />&lt;&lt;Ama nji ri kpa nkɨren meme a kri kpata. Ka ran ndzu si ya shu ran, ka wɨru wo ri gbobre ran tre,&lt;Izhi, ya wen ri si lo sron, nji ri meme ti.&gt;<verse eid="LUK 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 18:14" />Imba Yeso katre,&lt;&lt;Me la wu ri nji nyi, a hi ko ri shnji sron ran, a ran he ka iri wan riwa wa kpa tre ka no. Ko ŋnga riwa a gbre ngawan wa no nkpen nga nji riwa a no ngawan nkpen wa gbre wu.&gt;&gt;<verse eid="LUK 18:14" /></para>
  <para style="s">Imiri wa Tsitsa Nga Yeso</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15" />Nji wa ran ngɨzhi miri wa tsitsa hi ri Yeso riwa ari bre wa wo. Riwa imiriko wan wa to ngamba, waka fen wa ton. <verse eid="LUK 18:15" /><verse number="16" style="v" sid="LUK 18:16" />Mba Yeso ka yo miri-a ye ri ngawan ran tre, &lt;&lt;No miri wa tsitsa nowa ye ri me, ran zuwa ran, ritu kpanchison Izhi a he riwa bibi mba nye. <verse eid="LUK 18:16" /><verse number="17" style="v" sid="LUK 18:17" />Me lau kpunji tre, ko ŋnga riwa a ran kpa kpanchison Izhi ka miri wa tsitsa ran, a ran gra rimi kpanchison Izhi ran.&gt;&gt;<verse eid="LUK 18:17" /></para>
  <para style="s">Ichu ri wo</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18" />Nji ri ngɨzhi nji ri ka miyen wu ri,&lt;&lt;Nji ri tsro dindi, ngye nye me ti miri fe reriwa a ran kre ran?&lt;&lt;<verse eid="LUK 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19" />Yeso ka tre&lt;&lt;Ngye ti wu yo wen nji dindi?&lt;&lt; Yeso ka nyime. &gt;&gt;Ba njo riwa a bi a ra Izhi nkankɨshi wan. <verse eid="LUK 18:19" /><verse number="20" style="v" sid="LUK 18:20" />Wu to kya riwa doka tre:&lt;Ran kru wa njo ran, ran wuu njo ran, ran ban kya njo ran, ran de tre che ran, no tiwen nga yiwen nkpen.&gt;&gt;&gt; <verse eid="LUK 18:20" /><verse number="21" style="v" sid="LUK 18:21" />&lt;&lt; Ala Yeso tre, ka me he vren me kiyaye kyawamba <verse eid="LUK 18:21" /><verse number="22" style="v" sid="LUK 18:22" />Riwa Yeso a wo ngamba, ran tre riwu, &lt;&lt;Wu ran he riwa a he kyari wu ran he wu ran. Re kpi wen wawu rika no wawa wana he kya ran, wufe wo ri shu wuru. Wu ka ye, ri wu wan.&gt;&gt; <verse eid="LUK 18:22" /><verse number="23" style="v" sid="LUK 18:23" />Riwa a wo nganyi, Ka tifu, ritu a he nji riwa a he ri wo branbran <verse eid="LUK 18:23" /><verse number="24" style="v" sid="LUK 18:24" />Yeso ka yawu ran tre,&lt;&lt;A ri he iya riwa nji ri wo ari gra ri Kpanchison Izhi <verse eid="LUK 18:24" /><verse number="25" style="v" sid="LUK 18:25" />Aran he iya no rakumi no gra ri bwo yɨwe, riwa nji wo no gra kpanchison Izhi&lt;&lt; <verse eid="LUK 18:25" /><verse number="26" style="v" sid="LUK 18:26" />Nji riwa wa wo nganyi wa mɨyen,&lt;&lt;Ngha ri fe jibu wo?&gt;&gt; <verse eid="LUK 18:26" /><verse number="27" style="v" sid="LUK 18:27" />Yeso ka tre,&lt;&lt;Ikya riwa a han nji ari wu ri Izhi.&gt;&gt; <verse eid="LUK 18:27" /><verse number="28" style="v" sid="LUK 18:28" />Bitrus ka tre ri wu, wo,&lt;&lt;ki ka kyawamba don ki ri huu!&gt;&gt; <verse eid="LUK 18:28" /><verse number="29" style="v" sid="LUK 18:29" />&lt;&lt;Me la yi kpunji tre,&gt;&gt;Yeso ka tre riwa, &lt;&lt; njo ran ka ko wan, wa miri vayi wan wati wan miri wan ritu kpanchison Izhi, <verse eid="LUK 18:29" /><verse number="30" style="v" sid="LUK 18:30" />a ran fe kigbu bran zizan nga, kusi ari fe reriwa a ran kre ran.&gt;&gt;<verse eid="LUK 18:30" /></para>
  <para style="s">Yeso a La tre kuu Wan nkpa ri tra wan</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31" />Yeso ka vu miriko wan wuru don hari hi rigran ran lawa,&lt;&lt;ki hi ri urushelima, nga kya riwa wa la tre ritu Vɨren Nji riwa ari he. <verse eid="LUK 18:31" /><verse number="32" style="v" sid="LUK 18:32" />Wa kawu no aluma: wa tingun riwu wa no ya, wa junten sro, nga wa ri wuu. <verse eid="LUK 18:32" /><verse number="33" style="v" sid="LUK 18:33" />Ri vi tra a ri wulunde.&gt;&gt; <verse eid="LUK 18:33" /><verse number="34" style="v" sid="LUK 18:34" />Mirindun wan wa ran to kya Yeso ari tre ran.Ikya to wan wa ka ri riwa, nga wa ran to kya wa ari tre ran.<verse eid="LUK 18:34" /></para>
  <para style="s">Yeso ka den nji ri nfien kpa chuwo</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35" />Riwa Yeso a ran ye Yariko, nji ri nfiyen kason ri nghɨma nkon ran ran bre. <verse eid="LUK 18:35" /><verse number="36" style="v" sid="LUK 18:36" />Mba ka wo ran gbunji wana hi, ka miyen ri ngye ri hi. <verse eid="LUK 18:36" /><verse number="37" style="v" sid="LUK 18:37" />Wa ka lawu, &lt;&lt;Yeso nji Nazare a ka ri hi.&gt;&gt; <verse eid="LUK 18:37" /><verse number="38" style="v" sid="LUK 18:38" />Ka yo, &lt;&lt;Yeso vren Doda, losron ri me!&gt;&gt; <verse eid="LUK 18:38" /><verse number="39" style="v" sid="LUK 18:39" />Nji wawa wa he kusi wan wa fen wu ton ran tre no songbi, ama ka kpagro bran, &lt;&lt;Ivren Doda, losron ri me! &gt;&gt; <verse eid="LUK 18:39" /><verse number="40" style="v" sid="LUK 18:40" />Yeso ka kukri ran tre nowa ngɨri nji-a ye no.Riwa a ye hyure, Yeso ka miyen, <verse eid="LUK 18:40" /><verse number="41" style="v" sid="LUK 18:41" />&lt;&lt;Ngye nye me ti ri wu?&gt;&gt;</para>
  <para style="p" vid="LUK 18:41">Ka nyɨme ri,&lt;&lt;Bachi, me su me ri to tsu nganga.&gt;&gt; <verse eid="LUK 18:41" /><verse number="42" style="v" sid="LUK 18:42" />Yeso ka tre riwu, &lt;&lt; Kpa to si wen; Ikpanyɨme wen kpa-u chuwo.&gt;&gt; <verse eid="LUK 18:42" /><verse number="43" style="v" sid="LUK 18:43" />Ri bubu wan ka fe siwan ran hu Yeso, gbresan nde Izhi. Ka ikpanji wa to, waka gbresan nde Izhi ngawen.<verse eid="LUK 18:43" /></para>
  <chapter eid="LUK 18" />
  <chapter number="19" style="c" sid="LUK 19" />
  <para style="s">Zaka Nji ri kpa Nkɨren ri Meme</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1" />Riwa Yeso a ran hi ri Yariko. <verse eid="LUK 19:1" /><verse number="2" style="v" sid="LUK 19:2" />Nji ri a he nde wan a he zakka; a he chu kpa nkɨren ri meme nga ran he ri wo. <verse eid="LUK 19:2" /><verse number="3" style="v" sid="LUK 19:3" />A wa ran to ko ngha he Yeso, ama ritu a he nji nkpuzhu ka ya to-u ran, ritu ikpanji. <verse eid="LUK 19:3" /><verse number="4" style="v" sid="LUK 19:4" />Mba ka wulutsu gbuchi ran hi ran hon shu konkron ritu ran tou, ritu Yeso ran ye ri ku bubu wan.<verse eid="LUK 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 19:5" />Riwa Yeso ka ye ri bubu wan, ka ya shu ran tre wu, &lt;&lt; Zaka, gɨzhi ye me gbagbla. Me son ri ko wen ruwa.&gt;&gt; <verse eid="LUK 19:5" /><verse number="6" style="v" sid="LUK 19:6" />Mba ka gɨzhi ye mme gbagbla ran kpa ri ŋgiri.<verse eid="LUK 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 19:7" />Wawu nji wa ka to nganyi wari ran tre murunyu,&lt;&lt;Ri ko nji ri&lt; meme ti nye ari kuson.&gt;&gt;&gt;<verse eid="LUK 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8" />Imba zaka ka wurunde krinde ran tre ri Bachi,&lt;&lt;Ya, Bachi! ri nyin nga zizan me ga wa kpiwon ka no wawa wa ran he ri wu ran, ka me sen njo rimi ko ngye, me bru ka nowa ti nkpanza riwa me kpa.&gt;&gt;<verse eid="LUK 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9" />Yeso ka lawu, luwa ikya dindi gra ri ko wen, ritu nji nyin, ngawen, a he vren Ibrahi. <verse eid="LUK 19:9" /><verse number="10" style="v" sid="LUK 19:10" />Ritu ame Ivren Nji me ye riwa me wa nga meri kpa kyawa riwa wa kado.&gt;&gt;<verse eid="LUK 19:10" /></para>
  <para style="s">Ikɨbu tre ri nfan wuru</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11" />Riwa nji wa ran wo kya,Yeso ka ran lawa kɨbu tre-a, ritu a he huireri Urushelima nji waka yonga kpanchison Izhi ri zhu ri bubu wan meron. <verse eid="LUK 19:11" /><verse number="12" style="v" sid="LUK 19:12" />Yeso ka tre,&lt;&lt; Nji ri a hi gbu ri kpata riwa nowa no chu ko no bru ye. <verse eid="LUK 19:12" /><verse number="13" style="v" sid="LUK 19:13" />Ka yo miriko wan wuru ran nowa nfan. ran tre wa,&lt; ti ndu ri nfan nyi,&gt;Ka tre,&lt; tse me bru ye.&gt;<verse eid="LUK 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 19:14" />&lt;&lt; Mba nji wa gbu mba wa kamba riwu wari tru nji wari hi riwu ran tre,&lt; Ki ran ri nyɨme no nji nyi no he chu mbu ran.&gt;<verse eid="LUK 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15" />&lt;&lt; Waka no chu, ka bru ye ko. Ran ti ndu nowa yo miriko wan riwa a nowa nkɨren, ritu ran to ngye nye wa fe sro ngha rimi wan. <verse eid="LUK 19:15" /><verse number="16" style="v" sid="LUK 19:16" />Ri gbuchi ka ye ran tre, &lt;&lt;Nji rinkon, ivrenko wen fe nfan wuru sro ngha ritu wan.&gt; <verse eid="LUK 19:16" /><verse number="17" style="v" sid="LUK 19:17" />&lt;&lt;A bi ngamba, vren ko dindi!&gt; Nji ri ko wan ka tre. Ritu riwa wu ti kpunji ri kya riwa a he fiwen, me no igbu wuru nowa he wo wen.&gt; <verse eid="LUK 19:17" /><verse number="18" style="v" sid="LUK 19:18" />Ri hari wan ka ye ran tre, &lt;Nji rinkon, ivren riko wen fe nfan ton sro ngha.&gt; <verse eid="LUK 19:18" /><verse number="19" style="v" sid="LUK 19:19" />Nji riko wan ka tre,&lt;A wu ngɨzhi gbu ngibreton.&gt; <verse eid="LUK 19:19" /><verse number="20" style="v" sid="LUK 19:20" />&lt;&lt;Nga vrenko ri ka ye ran tre, &lt;Nji rinkon, ngye nfan wen een, me ka loyo ri lagbatsɨro. <verse eid="LUK 19:20" /><verse number="21" style="v" sid="LUK 19:21" />Me ti sisɨri wen, ritu wu he nji riwa wu ti sron. Wu ban kya riwa wu ran kayo ran nga wuri sɨren kya riwa wu ran chu ran.<verse eid="LUK 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 19:22" />&lt;&lt;Nji riko wan ka tre, &lt;Me bla tre ri wu ritu tre wen, a wu meme vɨreŋ riko! wu to, me he nji ri ti sron, me ban kya riwa me ran kayo ran, me sɨren kya riwa me ran chu ran? <verse eid="LUK 19:22" /><verse number="23" style="v" sid="LUK 19:23" />Ngye ti wu ran ka nfan won yo ri bubu zi nfan ran, bibi riwa ka me kɨma ye, me ka kpa nfan won ri riba ran?&gt; <verse eid="LUK 19:23" /><verse number="24" style="v" sid="LUK 19:24" />&lt;&lt;Imba ka tre ri nji wawa wa krinde ri bubu wan, &lt;kpa nfan wan ri wu wuri ka no nji riwa a he ri ngibrewuru.&gt; <verse eid="LUK 19:24" /><verse number="25" style="v" sid="LUK 19:25" />Wa ka tre ri wu ri, &lt;Inji rinkon, a he nfan wuru! <verse eid="LUK 19:25" /><verse number="26" style="v" sid="LUK 19:26" />&lt;&lt;Ama nji riko Ka tre, me la yi nji riwa a he wu wa no branbran, nga nji riwa a ran he kya ran, kau riwa a he riwu wa kpa. <verse eid="LUK 19:26" /><verse number="27" style="v" sid="LUK 19:27" />Ikpan fu won riwa wa ran nyɨme me he chu mba ran-ŋgɨji wa ye nyi riwa wa wuu wa ri kusi won.&gt;&gt;&gt;<verse eid="LUK 19:27" /></para>
  <para style="s">Yeso a ye Urushelima to chu</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28" />Riwa Yeso ka tre nyi, ka hi ri Urushelima. <verse eid="LUK 19:28" /><verse number="29" style="v" sid="LUK 19:29" />Riwa a he huɨreri Betafaji nga Batani ri wa a he gashi riwa wa yo ngblu zaitun, ka ti miriko wan hari ndu, ran la wa, <verse eid="LUK 19:29" /><verse number="30" style="v" sid="LUK 19:30" />&lt;&lt; Hi ri gbu riwa a he kusi nbi, ka bi gra mi wan, bi to jaki wa lowu, riwa njo ri a ran gbuchi hon wu to ran siwu ri ngɨzhi wu ye nyi <verse eid="LUK 19:30" /><verse number="31" style="v" sid="LUK 19:31" />Ka njo minye yi ngye ti bi siwu? La-u ri Yeso iri no wa ngɨzhi wu ye.&gt;&gt; <verse eid="LUK 19:31" /><verse number="32" style="v" sid="LUK 19:32" />Wawa a ti wa ndun wa to a he ngaba riwa a la wa. <verse eid="LUK 19:32" /><verse number="33" style="v" sid="LUK 19:33" />Wa ran si jaki, nji wan ka minye wa, &lt;&lt;Bi si jaki ri ngye.&gt;&gt; <verse eid="LUK 19:33" /><verse number="34" style="v" sid="LUK 19:34" />Wa ka tre, &lt;&lt; Yeso tre no wa ngɨzhi ye.&lt;&lt; <verse eid="LUK 19:34" /><verse number="35" style="v" sid="LUK 19:35" />Wa ka ngɨzhi ye no Yeso, wa ka si tsro mba ritu jaki riwa wa ka no Yeso son ritu wan <verse eid="LUK 19:35" /><verse number="36" style="v" sid="LUK 19:36" />Riwa a ran hi nji wa ka luwa tsro mba ri nkon. <verse eid="LUK 19:36" /><verse number="37" style="v" sid="LUK 19:37" />Riwa a ye hyure ri bubu wan riwa nkon a gre hi ri ngbɨlu zetum, ikpa wawu miriko wan waka ran ngiri ran gbresan nde Izhi ri ran gbangban ritu kya wa sisiri riwa wa to: <verse eid="LUK 19:37" /><verse number="38" style="v" sid="LUK 19:38" />&lt;&lt;</para>
  <para style="q1" vid="LUK 19:38">Dindi hu chu riwa a ye rimi nde Bachi!&gt;&gt;Wa</para>
  <para style="q2" vid="LUK 19:38">Isisron ri shuwulu nga nkpen ritu tu wan!&gt;&gt;<verse eid="LUK 19:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39" />Wa Farisa wari ri kpanji wa tre ri Yeso ri,&lt;&lt;Nji ri tsro, fen wa miriko wen ton!&lt;&lt; <verse eid="LUK 19:39" /><verse number="40" style="v" sid="LUK 19:40" />&lt;&lt; Me la yi,&lt;&lt;Yeso ka tre,&lt;&lt; Ka wa ki ngbin, tita wa yii.&gt;&gt; <verse eid="LUK 19:40" /><verse number="41" style="v" sid="LUK 19:41" />Riwa a ye whewhyureri Urushelima ran to gbu, ka yii ritu wan <verse eid="LUK 19:41" /><verse number="42" style="v" sid="LUK 19:42" />ran tre,&lt;&lt;ka biyi, kau biyi yi ri vi nyi ikya riwa ari ngɨzhi Riwa bi tre zizan bi to kya wa ari ngɨzhi sisron ye. Zizan wa ka ri riyii. <verse eid="LUK 19:42" /><verse number="43" style="v" sid="LUK 19:43" />Ivi riye ritu mbi riwa wa kpan fu wa ari me rekankan ran ka yi yo ri tsutsu nga wa ri kagon ko kutan. <verse eid="LUK 19:43" /><verse number="44" style="v" sid="LUK 19:44" />Wa sɨren wu yo me, a wu ri miri wan ri kankan. Wa ran ka wu chuwo ritu tita ri ran, don bi ran to vi Bachi ye wan ran.&gt;&gt;<verse eid="LUK 19:44" /></para>
  <para style="s">Yeso a tsɨri tra bre</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45" />Ka gra rimi tra bre ran dzu wa rekpi, <verse eid="LUK 19:45" /><verse number="46" style="v" sid="LUK 19:46" />ka tre ri wa ri&lt;&lt;A he rimi ngha ri Izhi tre ri, &lt;Iko won ri he ko ri bre.&gt;Ama bi maishe wan a he ko wa yɨbi.&gt;&gt; <verse eid="LUK 19:46" /><verse number="47" style="v" sid="LUK 19:47" />Rivi rivi a ran to wa ri tra nji wa la tre Izhi ran wa wu wa ri wu. <verse eid="LUK 19:47" /><verse number="48" style="v" sid="LUK 19:48" />Mba wa ka ran fe kon ti wu ran, nji gbugblu wa sɨrenton ran wo tre wan.<verse eid="LUK 19:48" /></para>
  <chapter eid="LUK 19" />
  <chapter number="20" style="c" sid="LUK 20" />
  <para style="s">Wa Ran Nyɨme Nkpen Yeso ran</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1" />Chachu ri riwa Yeso a ran tsro nji ri tra Bachi a ran bla tre Izhi, rikon w Firist nga wa tsro doka Musa, nga ri wa rinkon waka ye riwu <verse eid="LUK 20:1" /><verse number="2" style="v" sid="LUK 20:2" />nga wari tre ri &lt;&lt;La ta, ri nyɨme ngha nye wu ti bibi kya wa nyi?&lt;&lt;Ngha nye no senkpa mba?&gt;&gt;<verse eid="LUK 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 20:3" />Yeso Ka tre,&lt;&lt; Me miyen yi ngawen. La wen, <verse eid="LUK 20:3" /><verse number="4" style="v" sid="LUK 20:4" />Ison tu ima riwa Yohana a he ri shu nye ka a he ri nji?&gt;&gt;<verse eid="LUK 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5" />Wa ka tre ri ngamba wari tre, &lt;&lt; Ka ki tre,&lt; a zhu ri shu,&gt; Ari mɨyen, ngye ti bi ran nyɨme ri wu ran?&gt; <verse eid="LUK 20:5" /><verse number="6" style="v" sid="LUK 20:6" />Ka ki tre,&lt;Ri nji,&gt; Wawu nji wa tata ri tita, ritu wa to ri Yohana a he nji ri de tre Izhi.&gt;&gt;<verse eid="LUK 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 20:7" />Waka nyɨme,&lt;&lt; Ki ran to bubu riwa a zhu ye ran.&gt;&gt;<verse eid="LUK 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8" />Yeso ka tre wa ri,&lt;&lt; Ame ngawen me ran la yi ri bibi senkpa ngha me ti kya wa nyi ran.&gt;&gt;<verse eid="LUK 20:8" /></para>
  <para style="s">Itre kɨbu riwa nji ri ron</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9" />Nga ran hi ran ri la nji ikɨbu tre:&lt;&lt; Nji ri a chu rɨma, ran ka no wa ron haya ran hi wizhi ri kpata. <verse eid="LUK 20:9" /><verse number="10" style="v" sid="LUK 20:10" />Ivi sɨren ka ti ka ti vren ko wan ndu ri wa ron no wa kpa kɨlo konkron ri zhu. wa ron wa ka tsi wa ri zu hi ngawan ri wo kpokpo. <verse eid="LUK 20:10" /><verse number="11" style="v" sid="LUK 20:11" />Ka bru ti vren ko wan ri ndu, waka bru tsi ngawan nga wa ri no hi ri wo kpokpo. <verse eid="LUK 20:11" /><verse number="12" style="v" sid="LUK 20:12" />A ran bru ti nji ri tra ndu hi, wa ka ji wu jiwo wa ri ka wu taga.<verse eid="LUK 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 20:13" />&lt;&lt; Nji ri rɨma-a ka tre,&lt; Me ti se? Me ti vren won ndu, riwa me nyɨme wu; waya to nkpen wan.&gt;<verse eid="LUK 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 20:14" />&lt;&lt;Riwa wa ron wa ka tou, wa ka tre ri ngamba. &lt;Ngye nji ri ri gado een,&gt;Waka tre. &lt;Ki wuu, gado wan ri he wambu.&gt; <verse eid="LUK 20:14" /><verse number="15" style="v" sid="LUK 20:15" />Wa ka kawu taga kugon zhu-a wa ri wuu.</para>
  <para style="p" vid="LUK 20:15">Yeso ka miyen,&lt;&lt; Ngye nye nji ri luwan a ri ti riwa? <verse eid="LUK 20:15" /><verse number="16" style="v" sid="LUK 20:16" />Ari ye ran wuu nji wa luwan-a ran ka luman ka no wa njo ri nkan.&gt;&gt;</para>
  <para style="p" vid="LUK 20:16">Riwa nji wa wo nganyin, wa tre &lt;&lt;No Izhi ran no rinyi no ran he ran!&gt;&gt; <verse eid="LUK 20:16" /><verse number="17" style="v" sid="LUK 20:17" />Yeso ka ya wa ran miyen,&lt;&lt; A he ngye ri wa wa nghan nganyi:</para>
  <para style="q1" vid="LUK 20:17">&lt;Tita riwa nji ri mme kawan riwu ri a ran he kyari ran</para>
  <para style="q2" vid="LUK 20:17">wawu nye ri he tita ri senkpa riwa a ngɨzhi ko.&gt;<verse eid="LUK 20:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="LUK 20:18" />Ko ŋnga riwa a ku ritu tita-a ari chon ti zhuzhu, ama nji riwa tita-a ku ritu wan ari chon ti mumu.<verse eid="LUK 20:18" /></para>
  <para style="s">Han Nkɨren ri Meme no kaisar</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19" />Wa tsro Doka Musa nga rinkon wa la tre Izhi wa wa nkon riwa wa vu hi tren ri bubu wan, ritu wa to ri a tre tre kɨbu-a ritu mba nye. Ama wa ran ran ti sisɨri nji. <verse eid="LUK 20:19" /><verse number="20" style="v" sid="LUK 20:20" />Farisa waka ran yo si ri wu, wa tru wa ya tsu, wawa wa kɨma ngamba zhu ka wa he wa kpunji. Wana su wari vu Yeso ri kya riwa ari tre bibi riwa wa kawu ka no nji rinkon. <verse eid="LUK 20:20" /><verse number="21" style="v" sid="LUK 20:21" />Waya tsu wa ka myen, &lt;&lt; Nji ri tsro, ki to wu la nga wu ri tsro kya ri wa a bi nga wu ran tsro kya ri wa a bi nga wu ran tsro kan kan ran tsro nkon Bachi njaji. <verse eid="LUK 20:21" /><verse number="22" style="v" sid="LUK 20:22" />A bi ri ta ki han nkren meme no kaisar ka a ran he nga mba ran? <verse eid="LUK 20:22" /><verse number="23" style="v" sid="LUK 20:23" />A to meme ti mba ran tre riwa, <verse eid="LUK 20:23" /><verse number="24" style="v" sid="LUK 20:24" />&lt;&lt;Tsro wen nfan ri zinariya nyi. Isi nga nde wa ngha nye he ri tu wan?&gt;&gt;</para>
  <para style="p" vid="LUK 20:24">Waka la wu ri, &lt;&lt;Riwa Kaisar.&gt;&gt; <verse eid="LUK 20:24" /><verse number="25" style="v" sid="LUK 20:25" />&lt;&lt;Kaisar, wa ka la. Ran tre ri wa, No kaisar kya riwa a he wa kaisar; nga no Izhi kya riwa a he wa Izhi.&gt;&gt; <verse eid="LUK 20:25" /><verse number="26" style="v" sid="LUK 20:26" />Wa ran fe kya ri wa wa fe ran ri kya a tre ri gbu nji wa ka ti alajibi nga a tre, wa ka son kpen.<verse eid="LUK 20:26" /></para>
  <para style="s">Mɨyen tre ritu Wurunde nji ri wa wa ku</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27" />Wa ri wa he sadukiyawa, ri wa wa tre wurunde ri bubu gru a ran he ran, wa ka ye ri Yeso wa ri myen tre. <verse eid="LUK 20:27" /><verse number="28" style="v" sid="LUK 20:28" />&lt;&lt; Nji ri tsro wa ka tre,&lt;Musa ngha ri wa vayi nji ri wa vayi wan ku ran ka wan don ran he vren ran, nji ba ka mam wa ri kɨuo ran fe vren ri vayi wan. <verse eid="LUK 20:28" /><verse number="29" style="v" sid="LUK 20:29" />Imiri vayi wari tangban wa he. Ri gbuchi a gran wa ran kuu a ran he vren ran. <verse eid="LUK 20:29" /><verse number="30" style="v" sid="LUK 20:30" />Ri hari wan ka gran wa-a ran ku ba vren, <verse eid="LUK 20:30" /><verse number="31" style="v" sid="LUK 20:31" />nga ri tra wan ka gran wu, nji taŋkpan wa ku, wa ran he ri miri ran. <verse eid="LUK 20:31" /><verse number="32" style="v" sid="LUK 20:32" />Iwa-a ka kuu ngawen <verse eid="LUK 20:32" /><verse number="33" style="v" sid="LUK 20:33" />Ri wurunde wawa wa ku wari tashɨme iwa-a ri he wa ngha, tunde itangban-a wa gran wu?&gt;&gt; <verse eid="LUK 20:33" /><verse number="34" style="v" sid="LUK 20:34" />Yeso ka tre, nji wa nzanyi wa gran nga wa ri no wa gran. <verse eid="LUK 20:34" /><verse number="35" style="v" sid="LUK 20:35" />Ama wa ri riwa wa ke mba wa ke riwa wa ki nzan ri wulunde riwa wa, ku wa ran kpa mba ran nga wa ran no wa kpa ran, <verse eid="LUK 20:35" /><verse number="36" style="v" sid="LUK 20:36" />nga wa ran kuu nga ran, wa to miriko , wa he imiri Bachi, wa ri he imiri wa wulunde ri wa wurunde ri chachu vi ri ta shɨme. <verse eid="LUK 20:36" /><verse number="37" style="v" sid="LUK 20:37" />Ama Inde tre wa ri wulunde ri ji, Musa tɨro kiuwon wa wulunde, a yo Bachi nji Ibrahim nga Bachi ri wa Ishaku, nga Bachi riwa Yakub nga wan. <verse eid="LUK 20:37" /><verse number="38" style="v" sid="LUK 20:38" />A ran he Bachi ri kɨuwon ran, a he ri si, riwu wawu wa he ri si. <verse eid="LUK 20:38" /><verse number="39" style="v" sid="LUK 20:39" />Wa ri imri wa ŋŋya wa ka tre nji ri ŋnga wu tre dindi. <verse eid="LUK 20:39" /><verse number="40" style="v" sid="LUK 20:40" />nga jo ka na ti sron ran myen tre kya nga ran.<verse eid="LUK 20:40" /></para>
  <para style="s">Wa rikon Adini wa ran to de myen ran</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41" />Yeso ka tre ri wa a he se bi tre kristi a he vren Doda? <verse eid="LUK 20:41" /><verse number="42" style="v" sid="LUK 20:42" />Doda kyuwan tre riimri mba zabura,</para>
  <para style="q1" vid="LUK 20:42">&lt;Bachi tre ri Bachi won:</para>
  <para style="q2" vid="LUK 20:42">Son ku wo ri won<verse eid="LUK 20:42" /></para>
  <para style="q2">
    <verse number="43" style="v" sid="LUK 20:43" />me ka ka wa fu wan ti za tubru ri don za wan.<verse eid="LUK 20:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="LUK 20:44" />Doda ka yo wu Bachi. A he se ko biyi bi yo ri vren wan?<verse eid="LUK 20:44" /></para>
  <para style="s">Yeso a gbi Vunvunto wa rinkon adinai</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45" />Riwa nji wawu wa ran sren ton, Yeso ka tre ri miri ndu wan, <verse eid="LUK 20:45" /><verse number="46" style="v" sid="LUK 20:46" />Ti rere ri nji wa tsro doka Musa, wa su wari nga giwan wa ri ran zen ri tro guglo nga wa ri giwen wa ran ri bubu ri chu nga wa ri son ri bubu bi wa ri kon ri tra nji nga bubu wa no nji kpan ri ro. <verse eid="LUK 20:46" /><verse number="47" style="v" sid="LUK 20:47" />Wa ri mba wa ran mba wa ku, nga wa ri wa bre ti. Bibi nji wa so ya branbran.<verse eid="LUK 20:47" /></para>
  <chapter eid="LUK 20" />
  <chapter number="21" style="c" sid="LUK 21" />
  <para style="s">Iwa ri kɨbo a de kya Riwa a he wu Wawu</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1" />Yeso a nzu si ya shu, ran to nji wa wa he kya ri wo wa sro nkɨren Izhi mba rimi bubu zi nkɨren ri tra Izhi. <verse eid="LUK 21:1" /><verse number="2" style="v" sid="LUK 21:2" />Ran to ngawen iwa ri kɨbo riwa a ran he kya ran ka sro nini hari. <verse eid="LUK 21:2" /><verse number="3" style="v" sid="LUK 21:3" />Yeso a tre,&lt;&lt; Me la yi kpunji Iwa ri kɨbo nyi a sro bran han ngbron nji. <verse eid="LUK 21:3" /><verse number="4" style="v" sid="LUK 21:4" />Wawunji wa de rimi bran riwa wa he wu; wa ri kɨbo a de rimi kya riwa a ran he wu rimi nfan riwa ma ran.&gt;&gt;<verse eid="LUK 21:4" /></para>
  <para style="s">Yeso a Tre Bibi zi Riwa ari fe Tɨra Izhi</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5" />Imiri ndu wan wari wa taka tre dindi ritu tra riwa wa mme nga kya riwa wa de ritu Bachi ama Yeso ka tre, <verse eid="LUK 21:5" /><verse number="6" style="v" sid="LUK 21:6" />&lt;&lt;Wu to tita wa nyi? Ivi ri ye riwa ko riri wa ran ka don ritu ri ran; wawu mba wa kawa ta rega.&gt;&gt; <verse eid="LUK 21:6" /><verse number="7" style="v" sid="LUK 21:7" />Nji wa miyen Yeso ri&lt;&lt;Nji ri tsro,&gt;&gt;Wa ka mɨyen, &lt;&lt;shitan kya wa nyi wa ti? Ngye nye ri he riwa ki to ri kyawa wa nyin wa ti?&gt;&gt; <verse eid="LUK 21:7" /><verse number="8" style="v" sid="LUK 21:8" />Yeso ka tre: &lt;&lt;Mɨlan ya ran no wa njo gyuru yi ran. Wari wa ye rimi nde won, wari tre ri &lt;wa he ame,&gt; Nga, &lt;Ivi ye hyure.&gt; Ran hu wa ran. <verse eid="LUK 21:8" /><verse number="9" style="v" sid="LUK 21:9" />Ka bi wo tre ku ri wa nyu, ran ti sisɨri ran kyawa wa nyi wa gbuchi he ri, ama ikre vi ran ye rina. <verse eid="LUK 21:9" /><verse number="10" style="v" sid="LUK 21:10" />Imba Yeso ka tre riwa: Mgbungbɨlume ri wulunde ri mgbungbɨlume, kpanchison ri wulunde ri kpanchison. <verse eid="LUK 21:10" /><verse number="11" style="v" sid="LUK 21:11" />Meme wa ri bran a ri chu iyon ri lilo kan kan, nga kya wa ti sisɨri nga alamu bran ri shuwulu. <verse eid="LUK 21:11" /><verse number="12" style="v" sid="LUK 21:12" />Ri kya wa nyin no wa gbuchi ti wa vu yi wa ri no yi ya. Wa ka yi no wa rɨra bla tre nga tre riwa tre nji wa ngɨzhi ye ri chu nga wa rinkon wa gbu wawu ri nde won. <verse eid="LUK 21:12" /><verse number="13" style="v" sid="LUK 21:13" />Rinyi ri he nkon la tre won. <verse eid="LUK 21:13" /><verse number="14" style="v" sid="LUK 21:14" />Nghamba ran no sron mbi time ran ri wa bi tre bi ri kpa ngambi chuwo ran. <verse eid="LUK 21:14" /><verse number="15" style="v" sid="LUK 21:15" />Me no yi la tre ri whiwuri, ri wa wa kpan fu mbi wa ran to ran. <verse eid="LUK 21:15" /><verse number="16" style="v" sid="LUK 21:16" />Wa ti mbi, wa yi mbi, wa vayi mbi ri igi mbi, wa kpan mbi wa kayi de, wa wu wari rimi mbi. <verse eid="LUK 21:16" /><verse number="17" style="v" sid="LUK 21:17" />Nji wawu wa kamba ri yi ritu won. <verse eid="LUK 21:17" /><verse number="18" style="v" sid="LUK 21:18" />Ama mfu tu mbi ri a ran ti kya ran. <verse eid="LUK 21:18" /><verse number="19" style="v" sid="LUK 21:19" />Kɨri gbegbe ari kpayi chuwo. <verse eid="LUK 21:19" /><verse number="20" style="v" sid="LUK 21:20" />Ka bi to wa lokpa wa kagon Urushelima, bi ka to ri ikre wan ye hyure. <verse eid="LUK 21:20" /><verse number="21" style="v" sid="LUK 21:21" />Ri wawa wa he ri meme Yudiya, no wa wulutsu hi ri tu ngbɨlu, no wawa wa he ri gbu nowa tsirinkon, nga no wawa wa he ri nchon gbu ran hi ri gbu tsisa ran. <verse eid="LUK 21:21" /><verse number="22" style="v" sid="LUK 21:22" />Ivi ri tsra riwa wa de ya Izhi bibi riwa wa ngha ri mbe Izhi. <verse eid="LUK 21:22" /><verse number="23" style="v" sid="LUK 21:23" />Ari he ri ya riwa wa he nne nga wawa wa sho vren rigon. Iya ri ye bran ri nji ŋgbugbɨlume. <verse eid="LUK 21:23" /><verse number="24" style="v" sid="LUK 21:24" />Wa wuu wa ri ku nga wa ri vu wa yo ri tra wa tren ri mgbungbɨlume. Urushelima wa he ri wo wa gran hi ri vi mba. <verse eid="LUK 21:24" /><verse number="25" style="v" sid="LUK 21:25" />&lt;&lt;Alamu wa he ri ji, iwua nga ntsen nga wa gbungblume wa so ya ri tu shinkpin ima. <verse eid="LUK 21:25" /><verse number="26" style="v" sid="LUK 21:26" />Nji wa kukɨwon ritu sisɨri nga joku sron kya ri wa gbungblu me ri ran chu. <verse eid="LUK 21:26" /><verse number="27" style="v" sid="LUK 21:27" />Ri vi mba wato vren nji riye rimi kpa wulu ri gbengbren nga gbre. <verse eid="LUK 21:27" /><verse number="28" style="v" sid="LUK 21:28" />Idan kya wamba wa gbuchi he, wu walunde wuri nzu woban shu, ritu ikpa wan chuwo a ye hyure.&gt;&gt;<verse eid="LUK 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29" />A lawa tre kɨbu ri,&lt;&lt; Bi ya nchi konkron mbwa ri ngbron inchi konkron. <verse eid="LUK 21:29" /><verse number="30" style="v" sid="LUK 21:30" />Idan wa gbuchi zhu mbe, biyi ritu mbi bi to ri isuu ye hyure. <verse eid="LUK 21:30" /><verse number="31" style="v" sid="LUK 21:31" />Ko ri ngamba, idan wu to kya wamba wa ti, Wu to ri kpanchi son ri shu he hyure. <verse eid="LUK 21:31" /><verse number="32" style="v" sid="LUK 21:32" />&lt;&lt; Me la yi kpunji, nzan wa nyi a ran kuu ran se wawu kya wamba wa ti. <verse eid="LUK 21:32" /><verse number="33" style="v" sid="LUK 21:33" />Ishu ri meme ri kre ama itre won ran kre ran. <verse eid="LUK 21:33" /><verse number="34" style="v" sid="LUK 21:34" />&lt;&lt;Mɨlan ya, no sron mbi ran yɨba ri so wa kpi ri huwa, ri kya wa meme nyi, ivi-a ri kre ritu wen ama wu ran to ran ka tɨroku. <verse eid="LUK 21:34" /><verse number="35" style="v" sid="LUK 21:35" />A ri ye ku ri tu wawu nji riwa wa son ri si ŋgbuŋbɨlu me. <verse eid="LUK 21:35" /><verse number="36" style="v" sid="LUK 21:36" />Kɨma vi mbi ran ya, bi ri ibreko bi to jɨbu wo wawu kya ri wa a ri wa ran ti, nga bi riya kri kusi Vɨren Nji.&gt;&gt; <verse eid="LUK 21:36" /><verse number="37" style="v" sid="LUK 21:37" />Bla vi riwa Yeso a ran tsro ri tra bre Izhi, nga ko wani yawulu a ran zhu ri ra ran tsro nji ran kru mibreŋŋran ritu gashi Zaitun. <verse eid="LUK 21:37" /><verse number="38" style="v" sid="LUK 21:38" />nga wawu nji wa ka ye ri bu mibrewa ri wawu ri tra bre Izhi.<verse eid="LUK 21:38" /></para>
  <chapter eid="LUK 21" />
  <chapter number="22" style="c" sid="LUK 22" />
  <para style="s">Yauza Iskariyoti a Nyɨme ri Re ri Yeso</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1" />Riwa iro riwa wa yo ri wana sro mumu ri kpa fu ran riwa wa yo wu ri irro ri za gran a ye, <verse eid="LUK 22:1" /><verse number="2" style="v" sid="LUK 22:2" />Wa rinkon wandu Izhi nga wa tsro doka Musa wa ran wa nkon riwa wa wuu ama wa ka ran ti sisɨri gbugbu nji. <verse eid="LUK 22:2" /><verse number="3" style="v" sid="LUK 22:3" />Mba shaitan ka gra ri Yauza Iskariyoti, iri rimi wuru don hari-a. <verse eid="LUK 22:3" /><verse number="4" style="v" sid="LUK 22:4" />Mba Yauza ka hi ran tre ri wa rinkon ndu Izhi nga wa rinkon wav gben ri tra Izhi bibi riwa ri reri wu riwa. <verse eid="LUK 22:4" /><verse number="5" style="v" sid="LUK 22:5" />Wa ka ngɨri, wa ri ka tre zi riwa wa no nkren. <verse eid="LUK 22:5" /><verse number="6" style="v" sid="LUK 22:6" />A nyɨme, ran wa nkon riwa ari ka Yeso no wa ka nji wa ran he ran.<verse eid="LUK 22:6" /></para>
  <para style="s">Iri ri kremkpen</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7" />Riwa ivi ri ri ri mumu riwa ari kpa kpi fu a ye, wato, a he vi ri han ŋkɨshu ri ro ri za gran. <verse eid="LUK 22:7" /><verse number="8" style="v" sid="LUK 22:8" />Imba Yeso ka ti Bitrus nga Yoaya ndu ran la wa,&lt;&lt;hi ri mɨlan bubu ti ri ta ri wa ki ri ri ro za gran.&gt;&gt;<verse eid="LUK 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 22:9" />&lt;&lt;Ri me nye ki mɨlan bubu ti?&gt;&gt;Wa ka miyen Yeso.<verse eid="LUK 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 22:10" />Yeso ka tre,&lt;&lt; I bi gra mbi ri gbu, bi to nji ri a ngɨzhi gbanran ima. Hu hi rimi ko riwa a gra, <verse eid="LUK 22:10" /><verse number="11" style="v" sid="LUK 22:11" />bi tre nji ri ko ri,&lt;Nji ri tsro a mɨye, bubu tra ri wa me ri jibi ri mirindu won?&gt; <verse eid="LUK 22:11" /><verse number="12" style="v" sid="LUK 22:12" />Wawu ri tsro yi bubu tra, ri shu riwa wa vu kpi sro mi wan. Bubu wan nye bi mɨlan ti.&gt;&gt;<verse eid="LUK 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 22:13" />Bitrus mba Yohana wa ka hi, wa ri to kpi ri wa Yeso a la wa, mba waka mɨlan bubu ri ri za gran ti.<verse eid="LUK 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14" />Ri wa ivi a ti, ka son ran ri bi ri, imiri ndu wan waka he riwu. <verse eid="LUK 22:14" /><verse number="15" style="v" sid="LUK 22:15" />nga Yeso ka la ri wa, &lt;&lt; Me wa meri ri ri ri za gran iwayi ko me ri so ya. <verse eid="LUK 22:15" /><verse number="16" style="v" sid="LUK 22:16" />Me la yi me ran bru ri ri ran tse wa shuu ri kpachison Izhi.&gt;&gt;<verse eid="LUK 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 22:17" />Mba ka ban vaŋŋon, ran ngɨri ran tre,&lt;&lt;kpa ima inabi nyi bi ri so. <verse eid="LUK 22:17" /><verse number="18" style="v" sid="LUK 22:18" />Me la yi me ran bru so ima inabi nyi ngana, tse kpanchison Izhi ye.&gt;&gt;<verse eid="LUK 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19" />A ban juju yɨwon ran ngɨri nga ran wa, ran tre,&lt;&lt; Ngye kpa won me no yi, ti nganyi ri ran tika won.&gt;&gt;<verse eid="LUK 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 22:20" />Riwa wa ri kre, ka ban vanŋŋon, rinyi he sisa tre nye riwa wati ritu yii won riwa wa de ritu mbi. <verse eid="LUK 22:20" /><verse number="21" style="v" sid="LUK 22:21" />Ama ngye iwo nji riwa a ri ka wen reari ri rɨme rimi vigba riri. <verse eid="LUK 22:21" /><verse number="22" style="v" sid="LUK 22:22" />Ivren nji a ri hi ka bibi riwa wa tre. Ama iya nji riwa a ka Yeso re.&gt;&gt; <verse eid="LUK 22:22" /><verse number="23" style="v" sid="LUK 22:23" />Waka ran mɨyen ngamba rimi mba ko a he ngha rimimba ri ti nganyi.<verse eid="LUK 22:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24" />Imba ijanyu ka wurunde ri tsutsu mba ritu ngha nye ri he rinkon rimimba. <verse eid="LUK 22:24" /><verse number="25" style="v" sid="LUK 22:25" />Imba Yeso ka lawa,&lt;&lt; wachu wa wa wa ran to Izhi ran wa tsro wa sen kpa, wa bla mba wa no wa tre riwa ri wa he wa zon nji. <verse eid="LUK 22:25" /><verse number="26" style="v" sid="LUK 22:26" />Ama Yeso ka lawa ri, biyi ran he ngamba ran. Ara riwa a he ri bran rimi mbi no he ka tsitsa, nji rinkon no he riwa a ri tindu rnji. <verse eid="LUK 22:26" /><verse number="27" style="v" sid="LUK 22:27" />Ŋnga he rinkon, riwa a he ritu tebɨru ka riwa ari ri ri? Aran he riwa a he ri tebɨru ran? Ama a ran he ame Yeso me he rimi mbi ka riwa a ri tindu ri yi. <verse eid="LUK 22:27" /><verse number="28" style="v" sid="LUK 22:28" />Bi he wawa wa he rɨme ri tsra riwa wa tsra wen. <verse eid="LUK 22:28" /><verse number="29" style="v" sid="LUK 22:29" />Bibi riwa A ti won no wen kpanchison, ngamba nye me no yi ŋgbeŋgbiren. <verse eid="LUK 22:29" /><verse number="30" style="v" sid="LUK 22:30" />Don riwa bi ri bi ri so ri me ri bubu ri ri kpanchison won, nga bi ri ki ran ri bla tre ri gɨzhi wuru don hari ri Israila.<verse eid="LUK 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31" />Yeso a yo&lt;&lt; Sima, Sima, wo wen, meme nji wa ran zenyi ka alikama, bibi riwa nji ri ron ri zen alikama jo ri meme wɨlo. <verse eid="LUK 22:31" /><verse number="32" style="v" sid="LUK 22:32" />Ama me bre Izhi ri wu, Bitrus, ri tu no kpa yɨmewen no ran kunyɨren ran. ka wu kɨma gon, no miri vayin wen senkpa.&gt;&gt;<verse eid="LUK 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33" />Bitrus ka la wu ri,&lt;&lt; Bachi me mɨlanson riwa me huu hi rimi tre ri trenji, ko ri nkon kuu.&gt;&gt;<verse eid="LUK 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34" />Yeso ka tre ri,&lt;&lt; Me lawu, Bitrus, kafi no kuko no tɨbu, wu tɨron to wen timkpa tra.&gt;&gt;<verse eid="LUK 22:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35" />Yeso a bru tre miriko wan ri,&lt;&lt; inde meti yi ndu nkren ranhe ri kpo mbi ran, ran gɨzhi kpo ran, ran gɨzhi za ran ikyari he riwa bi ran he riwu ran?&gt;&gt;Onhon&lt;&lt;Waka nyɨme.<verse eid="LUK 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36" />Ka lawa ri,&lt;&lt; Ama zizan idan bi he ri kpo bi ka ngɨzhi idan bi ran he ri takobi ran bi ka reri tsro mbi bi ri re. <verse eid="LUK 22:36" /><verse number="37" style="v" sid="LUK 22:37" />Me layi mba, lele no wa ye tsra ivito tre nyi ritu won ri wa bla yo rimi wa ti meme ti. Ritu ikya riwa wa tre ritu won, no vi wan no ye.&lt;&lt; <verse eid="LUK 22:37" /><verse number="38" style="v" sid="LUK 22:38" />Imiri ndu wa waka tre,&lt;&lt; Ya, Bachi ngye ŋgibretakobi har,&lt;&lt; mba mican,&lt;&lt; Ka lawa.<verse eid="LUK 22:38" /></para>
  <para style="s">Yeso a bre Izhi ritu ngbɨlu</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39" />Yeso ka zhu ran hi ritu ngblu zatun, Bibi riwa ari si hi, imiri ndu wan waka hu hi. <verse eid="LUK 22:39" /><verse number="40" style="v" sid="LUK 22:40" />Ri wa wa Yeso a ke bubu wan. Ka tre ri wa ri,&lt;&lt; Bi tre bibi riwa wa ran ku rimi tsɨreran.&gt;&gt; <verse eid="LUK 22:40" /><verse number="41" style="v" sid="LUK 22:41" />Imba Yeso ka lawa don ran hi ri gran, ran ku ngbazhu, ran bre Izhi.<verse eid="LUK 22:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 22:42" />A tre,&lt;&lt; A ti idan wu nyɨme wu ka ban konkron ya nyi ri mo; ri kamba, a ran he ti won ran, Ara iwa me nyee wa hu.&gt;&gt; <verse eid="LUK 22:42" /><verse number="43" style="v" sid="LUK 22:43" />Imba Iyu Izhi ka zhu ri shu ye kusi wan ran no senkpa. <verse eid="LUK 22:43" /><verse number="44" style="v" sid="LUK 22:44" />Ritu riwa a he nimi ya ka bre ri yɨo siron, Ikshi ka zhu ran wɨyen ran ku meme ka iwɨlo yii.<verse eid="LUK 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45" />Riwa a bre Izhi kre ran wa miri ndu wan ye, A ye towa ka kumna, ri tu shnji sron. <verse eid="LUK 22:45" /><verse number="46" style="v" sid="LUK 22:46" />&lt;&lt;Ritu ngye bi kru nna? Ka miyen wa.Wurunde bi ri ibreritu noyi ran ku rimi tsra ran.&gt;&gt;<verse eid="LUK 22:46" /></para>
  <para style="s">Wa ka Yeso no wa wa vu</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47" />Ri wa a ran tre ikpanji waka ye, nga nji riwa wa yowu ri Yauza, ri rimi wuru don hari, a tsro wa nkon hi. A wa ri reri sɨmo ngɨzhi?&gt;&gt; <verse eid="LUK 22:47" /><verse number="48" style="v" sid="LUK 22:48" />Yeso ka mɨyen wu,&lt;&lt; Yauza, Wu ka wen ri reri sɨmo ngɨzhi?<verse eid="LUK 22:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49" />Wawa wa ran hu Yeso wa to kya riwa a ran hi waka tre ri,&lt;&lt;Bachi ki tsen wa ri njingban?&gt;&gt; <verse eid="LUK 22:49" /><verse number="50" style="v" sid="LUK 22:50" />Iri rimimba ka chu njingban ran ka sɨren wu vunvu ton kuwori taga. <verse eid="LUK 22:50" /><verse number="51" style="v" sid="LUK 22:51" />Ama Yeso ka nyɨme, &lt;&lt;bi kawa chuwo ngamba&gt;&gt;Ran ban ton a ka ngha ri wu nga ran no si. <verse eid="LUK 22:51" /><verse number="52" style="v" sid="LUK 22:52" />Imba Yeso ka tre ri chu gbu, nji wa gben bubu bre, nga wa rinkon, wawa wa zu ri wu, &lt;&lt;Ame mi zɨren ri wawa wa wanyu, riwa bi ye ri njigban ri gbagbla ka bi zu nji ri yɨwi. <verse eid="LUK 22:52" /><verse number="53" style="v" sid="LUK 22:53" />Bla vi mi ran he riyi ri bubu bre, Ama bi ran ban wo yo wen ran. Ama ngye vi riwa ichu ri he.<verse eid="LUK 22:53" /></para>
  <para style="s">Bitrus a Kawan ritu to Izhi</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54" />Mba wa ka vu wari ngɨzhi wu hi ri ko chu gbu. Bitrus ka ran huwa ri gran. <verse eid="LUK 22:54" /><verse number="55" style="v" sid="LUK 22:55" />Riwa wa yo wulu rimi tsutsu ko-a wa ri kuki rɨme wawu Bitrus ka son ri wa me. <verse eid="LUK 22:55" /><verse number="56" style="v" sid="LUK 22:56" />Ivɨra rindu ri mi ko-a ka chu si to Bitrus ka a kuson, ka milawu ya ran tre &lt;&lt;nji yin wa wa wa.&gt;&gt; <verse eid="LUK 22:56" /><verse number="57" style="v" sid="LUK 22:57" />Ama ka kawan. &lt;&lt;Iwamba, me ran to wu ran&lt;&lt;Waka lawa <verse eid="LUK 22:57" /><verse number="58" style="v" sid="LUK 22:58" />Ivi ka bankusi nfɨwen nji ri ka to Bitrus ran tre, &lt;&lt;A wu ngawen wu he ri wa&lt;&lt; Bitrus ka tre, &lt;&lt;nji mba, ki ran he mbuwu ra&gt;&gt;v 59 Riwa wa ka bankusi, nji ri ka bru ye ran tre, &lt;&lt;mi layi nji nyi wa he mbawu, ritu wawa wa zhu Galili&gt;&gt; <verse eid="LUK 22:58" /><verse number="60" style="v" sid="LUK 22:60" />Ama Bitrus ka tre, &lt;&lt;nji mba mi ran to kya riwa wu tre ritu wan ran&gt;&gt;A ran tre kre ran igbako ka tɨbu <verse eid="LUK 22:60" /><verse number="61" style="v" sid="LUK 22:61" />Yeso ka nzu si ran ya Bitrus, mba Bitrus ka taka tre riwa Yeso a lawu. &lt;&lt;Wu kawen ri towen ti ŋkpa tra ri ko igbako ri tɨbu.&gt;&gt; <verse eid="LUK 22:61" /><verse number="62" style="v" sid="LUK 22:62" />Bitrus ka zhu hi ri ra ran yi bran bran.<verse eid="LUK 22:62" /></para>
  <para style="s">Wa Tindan ri Yeso</para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63" />Nji riwa wa ran gben Yeso waka ran nza wu wari ran tsi. <verse eid="LUK 22:63" /><verse number="64" style="v" sid="LUK 22:64" />Wa ka lo Yeso si wari miyen &lt;&lt;Wu ya lata nji riwa a wuru wu?&lt;&lt; <verse eid="LUK 22:64" /><verse number="65" style="v" sid="LUK 22:65" />Wa ka ran tre tre meme riwu wari ran kɨra tu<verse eid="LUK 22:65" /></para>
  <para style="s">Yeso Kusi wa Rinkon</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66" />Iwa mibreka kpan, wa rinkon wa bla tre waka kabru, nga wawu chu riwa wa ngɨzhi Yeso ye kusi wan. <verse eid="LUK 22:66" /><verse number="67" style="v" sid="LUK 22:67" />&lt;&lt;Idan wu he kristi wa ka lata, &lt;&lt;Idan mi layi, bi ran kpa nyime ri me ran. <verse eid="LUK 22:67" /><verse number="68" style="v" sid="LUK 22:68" />Kuma Idan mi mɨyen yi bi ran ya nyɨme ri me ran. <verse eid="LUK 22:68" /><verse number="69" style="v" sid="LUK 22:69" />Ama zhu zizan ban kusi Ivren Nji ri son ri bubu ngbengbɨren ku wori Izhi.&gt;&gt; <verse eid="LUK 22:69" /><verse number="70" style="v" sid="LUK 22:70" />Wa wu mba waka miyen, &lt;&lt;A wu nye wu he Vɨren Izhi?&gt;&gt;Yeso Ka lawa ri, &lt;&lt; Bi la tsra tre ri ame mi he.&gt;&gt; <verse eid="LUK 22:70" /><verse number="71" style="v" sid="LUK 22:71" />Mba wa tre, &lt;&lt;ngye ti ki wa bla kya? ki wo ri nyu wan-e.&gt;&gt;<verse eid="LUK 22:71" /></para>
  <chapter eid="LUK 22" />
  <chapter number="23" style="c" sid="LUK 23" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1" />Ikpanji-a waka wulunde kusi wari ngɨzhi Yeso hi kusi Bilatu. <verse eid="LUK 23:1" /><verse number="2" style="v" sid="LUK 23:2" />Mba wa ka gbuchi wa wu ri tre ran tre,&lt;&lt;ki fe nji nyi a kpa nji mbu ri pisi ran ri lawa nowa ran han nkɨren meme no Kaisar nga ran tre ri wawu a he Bachi, Chu.&gt;&gt; <verse eid="LUK 23:2" /><verse number="3" style="v" sid="LUK 23:3" />Bilatu ka miyen Yeso ri,&lt;&lt;A wu nye wu he chu nji Yahuda?&gt;&gt;Yeso ka nyime ran tre, kamba nye bi tre.&gt;&gt; <verse eid="LUK 23:3" /><verse number="4" style="v" sid="LUK 23:4" />Bilatu ka la ri rinkoŋ wa ndu Izhi nga kpanji.&lt;&lt;Ame me ran fe kya meme ritu nji nyin ran.&gt;&gt; <verse eid="LUK 23:4" /><verse number="5" style="v" sid="LUK 23:5" />Ama waka kamba tre,&lt;&lt;A kpa wa ran pisi ri tsro wan ri meme nji Yahuda, ri tsro wan. A gbu chi ri meme Galili ran ye nyi.&gt;&gt; <verse eid="LUK 23:5" /><verse number="6" style="v" sid="LUK 23:6" />Riwa a wo ngamba, Bilatu ka mɨyen ri ka nji a he nji Galili nye. <verse eid="LUK 23:6" /><verse number="7" style="v" sid="LUK 23:7" />Riwa a to ri Yeso zhu ri bubu riwa Hirudus he ri kpanchison, ka tru Yeso hi ri Hirudus, riwa wawu ngawen a he ri Urushelima. <verse eid="LUK 23:7" /><verse number="8" style="v" sid="LUK 23:8" />Riwa Hirudus a to Yeso, a ngɨri bran, ritu sisen mu a ran gben ran to wu. Ritu kya riwa a wo ri tu wan, a yo sron ran to wu ri ti kya riwa ari de sisɨri. <verse eid="LUK 23:8" /><verse number="9" style="v" sid="LUK 23:9" />Hirudus ka ran miyen wu mɨyen kigbu, ama Yeso ka ran kpanyɨme ri wu ran. <verse eid="LUK 23:9" /><verse number="10" style="v" sid="LUK 23:10" />Wa rinkon wa tsro tre Izhi nga wa tsro doka Musa waka zhu ye kusi wa ri wa wari wuu ri tre. <verse eid="LUK 23:10" /><verse number="11" style="v" sid="LUK 23:11" />Hirudus nga wa lokpa wan wa ka kpa tsɨri, wari ban nchon tsro chu ka su ri wu, wa ri ngɨzhi wu bru hi ri Bilatu.<verse eid="LUK 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 23:12" />Chachu nyin nye riwa Hirudus nga Bilatu wa he kpan ngamba, riwa wa ran he kpan nfu kamba. <verse eid="LUK 23:12" /><verse number="13" style="v" sid="LUK 23:13" />Bilatu a vu wa rinkon wa tsro tre Izhi nga wa rinkon nji nga gbunji wawu, <verse eid="LUK 23:13" /><verse number="14" style="v" sid="LUK 23:14" />A la riwa ri, &lt;&lt;Bi ngɨzhi nji nyin ye no wen ri a kpanji ri pisi. Ko me ya to ri kusi mbi, me ran fe wu ri meme ti riwa bi tre ritu wan ran. <verse eid="LUK 23:14" /><verse number="15" style="v" sid="LUK 23:15" />Hirudus ngawen kyari ngawen ran. Ikya riwa a sa ka bru ngɨzhi wu ye rita; Ba kya riwa nji mba ti riwa a ke riwa wa wuu. <verse eid="LUK 23:15" /><verse number="16" style="v" sid="LUK 23:16" />Ritu ngamba me tsi ri gbagba me ri chu wu wo.&gt;&gt; <verse eid="LUK 23:16" /><verse number="17" style="v" sid="LUK 23:17" />Ko kabru ro ri rugran bibi tan Bilatu ri ka nji ri rimi wawa wa vu wa tren ri bubu tren nji. <verse eid="LUK 23:17" /><verse number="18" style="v" sid="LUK 23:18" />Wawu mba waka kpagɨro wari tre,&lt;&lt;Ri no wa ngɨzhi wu hi wuu, wa ri ka Barabas chuwo ta!&gt;&gt; <verse eid="LUK 23:18" /><verse number="19" style="v" sid="LUK 23:19" />Barabas a he nji ri riwa wa kawu ta yo ri tra tren nji, ritu wa nyu riwa a he rimi gbu ri, waka wuu nji. <verse eid="LUK 23:19" /><verse number="20" style="v" sid="LUK 23:20" />Bilatu ka ran bru tre riwa ritu a ran su ran ka yeso chuwo. <verse eid="LUK 23:20" /><verse number="21" style="v" sid="LUK 23:21" />Mba wa ka ran kpagɨro wa ran tre,&lt;&lt;No wa kpan wu ri tu konkron! No wa kpan wu ri tu konkron!&gt;&gt; <verse eid="LUK 23:21" /><verse number="22" style="v" sid="LUK 23:22" />Bilatu ka bru la riwa, ri la ri tra,&lt;&lt;Ri nkon ri tan? Meme ti ritan a ti? Ko me ran fe wu ri meme ti kya ran. Ritu ngamba, me tsi ri gbagba me ri chu wu wo.&gt;&gt; <verse eid="LUK 23:22" /><verse number="23" style="v" sid="LUK 23:23" />Ama waka ran fu wulu, ikpanji-a wa kamba ran tre ŋgbangban ri, nowa kpan wu ri tu konkron, ikuzinba ka wɨrewa. <verse eid="LUK 23:23" /><verse number="24" style="v" sid="LUK 23:24" />Mba Bilatu ka ka zi ri nowa ti kya riwa wa su riwu. <verse eid="LUK 23:24" /><verse number="25" style="v" sid="LUK 23:25" />A chu nji riwa wa vu tren ritu a ran wa nyu ran wuu nji, Ama ran ka Yeso no wa ri nowa to kya riwa wa ti riwu.<verse eid="LUK 23:25" /></para>
  <para style="s">Wa vu Yeso Kpan ritu Konkron.</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26" />Riwa wa ngɨzhi Yeso ran hi, mba wa ka to nji ri wa yo wu ri Saminu, a zhu ri gbu mba ran ye, waka ban konkron ka lo ri wu no ngɨzhi ran hu Yeso. <verse eid="LUK 23:26" /><verse number="27" style="v" sid="LUK 23:27" />Ikpanji waka ran hu Yeso, nga mba wari riwa wa ran yi, wa ran ti shnji sron ri tu wan. <verse eid="LUK 23:27" /><verse number="28" style="v" sid="LUK 23:28" />Yeso ka kɨma si ya wa ran la wa ri,&lt;&lt;Bi yi mirimba Urushelima, ran yi ritu won ran; Yi ri nga mbi nga miri mbi. <verse eid="LUK 23:28" /><verse number="29" style="v" sid="LUK 23:29" />Ivi ri ye riwa bi tre, &lt;Iwo dindi he ritu mba wawa wa kuu ngɨzhi, wa ran ngɨzhi zari to ran, wa ran so sisan mba to zari ran!&gt; <verse eid="LUK 23:29" /><verse number="30" style="v" sid="LUK 23:30" />Nghamba nye wa la gblu,&lt;Ku joku ritu mbu!&gt; Nga no ngbɨlu, &lt;No ka ta!&gt; <verse eid="LUK 23:30" /><verse number="31" style="v" sid="LUK 23:31" />Idan bi ti kya wamba ka konkron wa he ri shushu ri, a ri he ri se ka konkɨron-a kɨlu?&gt;&gt; <verse eid="LUK 23:31" /><verse number="32" style="v" sid="LUK 23:32" />Nji hari riwa wa yɨwi, wa kawa kabru wa ri ngɨzhi wa hi ri bubu wuu. <verse eid="LUK 23:32" /><verse number="33" style="v" sid="LUK 23:33" />Riwa wa ke ri bubu riwa wa yo ri ŋgboro tu, mba nye waka kpan Yeso nga wa yɨbi hari-a, iri ku wori nga ri ku wota <verse eid="LUK 23:33" /><verse number="34" style="v" sid="LUK 23:34" />Yeso ka tre ri,&lt;&lt;A ti, ka meme ti mba chuwo ri wa, ritu wa ran to kya riwa wa ti ran.&gt;&gt;Waka gbon tsro wan ran ta ngbe ritu wan. <verse eid="LUK 23:34" /><verse number="35" style="v" sid="LUK 23:35" />Nji riwa wa ki ri bubu wan, wa ran ya. Wa rinkon waka wɨyen no, wari tre,&lt;&lt;A kpa wari chuwo, ko, no kpa ngawan chuwo mana, idan a he kristo riwa Izhi riwa a chu wu!&gt;&gt; <verse eid="LUK 23:35" /><verse number="36" style="v" sid="LUK 23:36" />Wa lokpa waka wɨyen no, wa ri chiwi hi ran, <verse eid="LUK 23:36" /><verse number="37" style="v" sid="LUK 23:37" />wa ri tre, &lt;&lt;Idan a wu wu he chu nji Yahuda nye, ko, wuka kpa ngawen chuwo ran!&gt;&gt; <verse eid="LUK 23:37" /><verse number="38" style="v" sid="LUK 23:38" />Waka ŋnga zi ritu wan riwa a tre ri, &lt;&lt;Ri nyin nye a he chu nji Yahuda.&gt;&gt; <verse eid="LUK 23:38" /><verse number="39" style="v" sid="LUK 23:39" />Rimi wa yɨbi hari riwa wa kpan wa ka tre ri,&lt;&lt;Wawu-a, a ran a wu nye wu he Bachi ran? Ko, wu ran kpa ngawen chuwo wu ri kpata chuwo me ran!&gt;&gt;<verse eid="LUK 23:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40" />Ama ri hari wan ka nyɨme ran tre vayi wan, ran tre, &lt;&lt;A wu ko sisiri Izhi wu ran ri ti ran? Ka tre, a wu riwa wu fe hukunchi riri mbi wu. <verse eid="LUK 23:40" /><verse number="41" style="v" sid="LUK 23:41" />Iwa mbu tsira ri ta, ri tu meme ti ri wa ki ti. Ko wawu nji mba a ran ti ko kya ran.&gt;&gt; <verse eid="LUK 23:41" /><verse number="42" style="v" sid="LUK 23:42" />A ran bru tre, &lt;&lt;A wu Yeso, taka won ka wu hi ri kpanchison wen.&gt;&gt; <verse eid="LUK 23:42" /><verse number="43" style="v" sid="LUK 23:43" />Yeso ka la wu ri,&lt;&lt;Me la wu kpunji, luwa wu son ri me ri bubu ri raro.&gt;&gt;<verse eid="LUK 23:43" /></para>
  <para style="s">Ikuu Yeso</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44" />Ri gbege ji, ibu a ka gbungblu me wa wu, hari hi ri krefi tra ri yawulu. <verse eid="LUK 23:44" /><verse number="45" style="v" sid="LUK 23:45" />Ikpantsu ka kɨma ti bu, itsɨro riwa wa ka nkon ri tra Izhi ka yɨra ti hari. <verse eid="LUK 23:45" /><verse number="46" style="v" sid="LUK 23:46" />Yeso ka bu nyu tre,&lt;&lt;A ti! Ri wo wen me ka ivɨri won ri de.&gt;&gt; Riwa a tre ngamba , ran vɨri ri wawu ran kuu. <verse eid="LUK 23:46" /><verse number="47" style="v" sid="LUK 23:47" />Riwa rinkon wa lokpa Roma ka to kya riwa a he, ran gbresan nde Izhi ran tre,&lt;&lt; Kpunji tre nji nyi ran ti meme ti kya ran!&gt;&gt; <verse eid="LUK 23:47" /><verse number="48" style="v" sid="LUK 23:48" />Riwa ikpanji wawa wa he ri bubu wan, ri wawa wa ye bubu ya wa to kya riwa a he, waka kɨma ran hi kamba wari ran wuruwo ri gbobre. <verse eid="LUK 23:48" /><verse number="49" style="v" sid="LUK 23:49" />Wawu nji riwa wa to Yeso nga mba hari riwa wa hu zhu ri Galili, wa ki kpata wari ran ya kya riwa a ri hi.<verse eid="LUK 23:49" /></para>
  <para style="s">Iban Yeso no yɨbi</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50" />Nji ri wa yo wu ri Yusufu, nji Arimatiya, a he gbu nji Yahuda, a he nji rinkon rimi wa rinkon gbu, a he nji dindi. <verse eid="LUK 23:50" /><verse number="51" style="v" sid="LUK 23:51" />Wawu a ran yɨme ri kya riwa wa ti ran, a zhu ri gbu Yudiya ri gbu Arimatiya a ran gben ye kpanchison riwa Izhi. <verse eid="LUK 23:51" /><verse number="52" style="v" sid="LUK 23:52" />Yusufu nye a hi ri Bilatu ran wa nowa ka kɨmo Yeso no wawu kpa hi no yɨwi. <verse eid="LUK 23:52" /><verse number="53" style="v" sid="LUK 23:53" />A ngɨzhi wu ye ri me ran nyewu ri tsro, ran ngɨzhi wu ka no yɨbi ri bubu ben ri bwo tita riwa wa ran no njo yɨbi ri bubu wan to ran. <verse eid="LUK 23:53" /><verse number="54" style="v" sid="LUK 23:54" />A he ri yawulu chachu vi ri ton, nga ivi ri sonviri a ran ye <verse eid="LUK 23:54" /><verse number="55" style="v" sid="LUK 23:55" />Mba riwa wa hu zhu ri Galili, waka hu Yusufu wa ri to bubu riwa wa ka Yeso no yɨwi nga wari to bibi riwa wa kakɨmo Yeso yo rimi wan. <verse eid="LUK 23:55" /><verse number="56" style="v" sid="LUK 23:56" />Waka bru hi ngamba wari ka wa nye ri miwi raro.</para>
  <para style="p" vid="LUK 23:56">Ama Chachu son vɨri-a waka ki vɨri bibi riwa wa tre-a.<verse eid="LUK 23:56" /></para>
  <chapter eid="LUK 23" />
  <chapter number="24" style="c" sid="LUK 24" />
  <para style="s">Yeso a Wulunde ri Bubu Gyuru</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1" />Ri vi ri mɨlan ri sati, mba-a wa ka ban nye-a ri mɨuɨ raro riwa wa mɨlan ti-a wari hi ri bubu gyuru Yeso. <verse eid="LUK 24:1" /><verse number="2" style="v" sid="LUK 24:2" />Waka to wa nyi tita taga ri nyun bubu gyuru, <verse eid="LUK 24:2" /><verse number="3" style="v" sid="LUK 24:3" />ama riwa mba-a wa gra ri bubu gyuru, wana to kɨmo Bachi Yeso ran. <verse eid="LUK 24:3" /><verse number="4" style="v" sid="LUK 24:4" />Riwa wa ran ti mamaki ritu wan, ri bubu wan nji hari ri tsro riwa a ran kpan riri ka iwulu wa ki kusan bubu gyuru. <verse eid="LUK 24:4" /><verse number="5" style="v" sid="LUK 24:5" />Rimi sisɨri mba wa ka kɨbu tu me, ama nji-a waka tre wa, &lt;&lt;Ritu ngyen ko bi wa wawa wa he ri si rimi wawa wa kuu? <verse eid="LUK 24:5" /><verse number="6" style="v" sid="LUK 24:6" />Yeso ran he nye ran, a tashɨme! tika bibi riwa a layi, riwa a he ri yi ri Galili: <verse eid="LUK 24:6" /><verse number="7" style="v" sid="LUK 24:7" />&lt;Ivren Nji wa vu no wo wa meme ti, wa ri kpanwu ri konkron nga ri vi ri tra wan a ri wulunde nganga.&gt;&gt;&gt; <verse eid="LUK 24:7" /><verse number="8" style="v" sid="LUK 24:8" />Imba waka tika tre wan. <verse eid="LUK 24:8" /><verse number="9" style="v" sid="LUK 24:9" />Riwa waka zhu ri bubu gyuru ye ngamba, wa ri la ri ngbɨron miriko wan wuru don ri nga ri ngbɨron nji. <verse eid="LUK 24:9" /><verse number="10" style="v" sid="LUK 24:10" />A he Meremu Magadaliya, ri Yuwana, ri Meremu iyi Yakubu, ri ngbɨron nji riwa wa he riwa wa la ri mirindu Izhi. <verse eid="LUK 24:10" /><verse number="11" style="v" sid="LUK 24:11" />Ama waka ran nyɨme ri kya riwa mba-a wa tre ran, ritu itre mba-a a ran he dindi riwa ran. <verse eid="LUK 24:11" /><verse number="12" style="v" sid="LUK 24:12" />Bitrus ka walunde ran wulutsu hi ri bubu gyuru. Ran dran, ran to tsro wa kru tu ngamba, ran hi ngawan, ran tika nkankɨshi wan a he ngye ri ti nga nyi.<verse eid="LUK 24:12" /></para>
  <para style="s">Nkon ri hi Imuwasu</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13" />Chachu vi-a riwa wa ran hi ri gbu riwa wa yo ri Imuwasu, a he meli tangban zhu ri Urushelima. <verse eid="LUK 24:13" /><verse number="14" style="v" sid="LUK 24:14" />Waka ran tre ri ngamba ritu kya riwa a ti. <verse eid="LUK 24:14" /><verse number="15" style="v" sid="LUK 24:15" />Riwa waka ran tre ri ngamba, Yeso ritu wan ka ye ran zɨren riwa; <verse eid="LUK 24:15" /><verse number="16" style="v" sid="LUK 24:16" />Wa ran to a he wa wu ran.<verse eid="LUK 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 24:17" />A miyen wa, &lt;&lt;Bi tre ritu ngye riwa bi zɨren ri hi? Wa&gt;&gt; ka ku kri, ri si mba mme. <verse eid="LUK 24:17" /><verse number="18" style="v" sid="LUK 24:18" />Iri rimi mba, nde wan a he kiliyobas, ka miyen, &lt;&lt;Wu he riwa wu ye Urushelima wu ran to kya a ri ti ri vi wa nyi ran?&gt;&gt; <verse eid="LUK 24:18" /><verse number="19" style="v" sid="LUK 24:19" />Ka miyen ri&lt;&lt;Ikya ngye?&gt;&gt;</para>
  <para style="p" vid="LUK 24:19">&lt;&lt;Ritu Yeso nji Nazare,&gt;&gt; Wa ka tre. &lt;&lt;A he nji ri ndu Izhi, gbengbren rimi tre ri kya dindi ri si Izhi nga nji wawu. <verse eid="LUK 24:19" /><verse number="20" style="v" sid="LUK 24:20" />Ama chu w Firist nga wa rikon mbu wa ka wu nowa wuu, nga wa kpa wu ri konkron. <verse eid="LUK 24:20" /><verse number="21" style="v" sid="LUK 24:21" />Ama ki yo sron ri a he nji riwa a ri kpa Israila chuwo. Ngha ngye han ngamba, a he vi tra riwa ikya wa nyi wa ti. <verse eid="LUK 24:21" /><verse number="22" style="v" sid="LUK 24:22" />Mba bu wari wa no ta mamaki. Waka hi bubu gyuru mbamibrenyi. <verse eid="LUK 24:22" /><verse number="23" style="v" sid="LUK 24:23" />Ama wa ka ran to kpa wan ran. Wa ye wa ri la ta wa to waayi miriko Izhi, riwa wa tre a he si. <verse eid="LUK 24:23" /><verse number="24" style="v" sid="LUK 24:24" />Imba wa kpan mbu wari wa ka hi ri bubu gyuru wa ri to ka a he bibi riwa mba-a wa la ta, ama wa ran to Yeso ran.&gt;&gt;<verse eid="LUK 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25" />Yeso ka tre wa, &lt;&lt;Bi he nji wawa bi ran to kya ran, nga reresron ri nyɨme kya wandu Izhi wa tre! <verse eid="LUK 24:25" /><verse number="26" style="v" sid="LUK 24:26" />Bi ran to ri Yeso ri so ya ri ko ran fe gbre wanyi ran?&gt;&gt; <verse eid="LUK 24:26" /><verse number="27" style="v" sid="LUK 24:27" />A gbuchi ri Musa nga miriwa ndu Izhi, a la wa kya wa tre ri ngha mbe tre ritu wan.<verse eid="LUK 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28" />Riwa wa ye huehyureri vi gbu, Yeso ka ti ka a ri hi kpata. <verse eid="LUK 24:28" /><verse number="29" style="v" sid="LUK 24:29" />Wa ka fu wulu riwu,&lt;&lt;Son ri ta, ya wulu a ti, ivi a ye.&gt;&gt; Ka son ri wa. <verse eid="LUK 24:29" /><verse number="30" style="v" sid="LUK 24:30" />Riwa a son riwa bubu son, ran ban jujuyɨmo, ran ngɨri, ran chiwa ka no wa. <verse eid="LUK 24:30" /><verse number="31" style="v" sid="LUK 24:31" />Imba isi mba ka bu waka to wu, nga ka kado ri si mba <verse eid="LUK 24:31" /><verse number="32" style="v" sid="LUK 24:32" />Wa ka miyen ngamba, &lt;&lt;Isron mbu a ran ti kinklan ngawen ran riwa a tre ri ngamba ri nkon nga ran bu mbe tre Izhi rita ran?&gt;&gt;<verse eid="LUK 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 24:33" />Wa ka wulunde wa ri ye Urushelima. Mba wa ka fe nji wuru don ri nga riwa wa he riwa, wa ka kabru ri ngamba <verse eid="LUK 24:33" /><verse number="34" style="v" sid="LUK 24:34" />nga wa tre, &lt;&lt;A he njanji! Bachi a wulunde nga ran ye ri Sima.&gt;&gt; <verse eid="LUK 24:34" /><verse number="35" style="v" sid="LUK 24:35" />Imba imiriko wan hari wa ka la kya a ti ri nkon, nga bibi kya wa to Yeso ti riwa a chiwa jujuyɨmo.<verse eid="LUK 24:35" /></para>
  <para style="s">Yeso a ye ri Miri wa ko wan</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36" />Riwa imiriko wan wa ran tre ritu kya nyi , Yeso ri tu wan ka ku kri ri wa ran tre wa, &lt;&lt;No sisron no he ri yi.&gt;&gt;<verse eid="LUK 24:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37" />Wa ka ti sisɨri, wa ri yonga wa to bɨzhi. <verse eid="LUK 24:37" /><verse number="38" style="v" sid="LUK 24:38" />Yeso ka tre riwa, &lt;&lt;Ngye ti bi ti fu, nga ngye ti bi nyɨme ri sron mbi ran? <verse eid="LUK 24:38" /><verse number="39" style="v" sid="LUK 24:39" />Yeso ka tre, to ndawo won nga za won. A he a me. Bre wen wo to, ibɨji ran he ri nɨma kpa ran nga kuku, ri wa bi to me he riwu.&gt;&gt; <verse eid="LUK 24:39" /><verse number="40" style="v" sid="LUK 24:40" />Riwa Yeso a tre nganyi, ka tsro wa wo nga za wan. <verse eid="LUK 24:40" /><verse number="41" style="v" sid="LUK 24:41" />Imiri wan wa ran kpayɨme ran ritu ngɨri ri mamaki, ka mɨyen wa,&lt;&lt;Bi he kya ri nyi ri wa ki ri?&gt;&gt; <verse eid="LUK 24:41" /><verse number="42" style="v" sid="LUK 24:42" />Wa ka no vi ŋkpon lambe riwa wa sron, <verse eid="LUK 24:42" /><verse number="43" style="v" sid="LUK 24:43" />waka ban ran ka ri ku si mba.<verse eid="LUK 24:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44" />Yeso ka tre wa,&lt;&lt;Ngye kya riwa me la yi ri chu wa me he ri yi ko ngye ri he bibi ri wa a he ritu won riwa a he rimi doka Musa, wa la tre Izhi nga Zabura.&gt;&gt;<verse eid="LUK 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45" />Imba Yeso ka bu sron mba ritu wa ri to tre mbe wan. <verse eid="LUK 24:45" /><verse number="46" style="v" sid="LUK 24:46" />Ka la wa, &lt;&lt;Ngye kya wa ngha, Nji ri kpa nji chuwo a ri so ya ran ta shɨme ri vi ri tra, <verse eid="LUK 24:46" /><verse number="47" style="v" sid="LUK 24:47" />nga imiriko wan wa tsro ritu ikameme ti chuwo nga kameme ti chuwo ri la tre Izhi ri nde wan ri wawu mgbungbɨlume, gbuuchi ri Urushelima. <verse eid="LUK 24:47" /><verse number="48" style="v" sid="LUK 24:48" />Wu he shada won ri kya wa nyi riwa wa ti. <verse eid="LUK 24:48" /><verse number="49" style="v" sid="LUK 24:49" />Yeso ka tre,me ti Wu Tsitsri ndu ri yi kya riwa iti won ka zi ri sron wan, ama ki ri Urushelima ri, Izhi ye ri itsɨro ri gbengbren ran ka su ri yi.&gt;&gt;<verse eid="LUK 24:49" /></para>
  <para style="s">Wa Ban Yeso hi Shuwulu</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50" />Riwa Yeso a vu wa zhu hi ri Batani, ka nzu wo wan ran ti lɨwu dindi sro wa. <verse eid="LUK 24:50" /><verse number="51" style="v" sid="LUK 24:51" />Riwa a ti lɨwu dindi sro wa, a ka wa don wa ban wu hi shu wulu. <verse eid="LUK 24:51" /><verse number="52" style="v" sid="LUK 24:52" />Imba waka gbre wu wa ri bru ye ri Urushelima ri ngɨri branbran. <verse eid="LUK 24:52" /><verse number="53" style="v" sid="LUK 24:53" />Nga waka ran son ri tra Izhi, ran gbre Izhi.<verse eid="LUK 24:53" /></para>
  <chapter eid="LUK 24" />
</usx>