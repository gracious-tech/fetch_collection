<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2PE" style="id">- BUU</book>
  <para style="h">2PE - BUU</para>
  <para style="toc1">2PE - BUU</para>
  <para style="toc2">2PE - BUU</para>
  <para style="toc3">2PE - BUU</para>
  <para style="mt1">2PE</para>
  <chapter number="1" style="c" sid="2PE 1" />
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1" />Imbe nyi zhu ri me Sima Bitrus, ivren ri ko Yeso Kristo</para>
  <para style="p" vid="2PE 1:1">Me ngan hi ri yi wawa bi fe ndindi ti riwa Izhi mbu nga Yeso Kristo riwa a kpata chuwo ran no yi yosron ka iwa mbu.<verse eid="2PE 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2" />No Izhi no ti lɨbu ndindi sro ri yi, ri son si sron kigbu ritu to Izhi nga Yeso Bachi mbu.<verse eid="2PE 1:2" /></para>
  <para style="s">Ison Riwa a Bi ri wa hu Kristo</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3" />Izhi rimi gbengbren wan a no ta kya riwa ki wa iwawu ritu no ta ki son bibi riwa wa hu Zhu. Kyawa wanyi iwawu wa he wa mbu nye ritu no ta ki no sisron rimi mkpen wan ri kpunji wan. <verse eid="2PE 1:3" /><verse number="4" style="v" sid="2PE 1:4" />Ritu rinyi nye Izhi no ta de nga chanchon ka tre dzi wawa wa bi ya ritu mba, bi to kabru riwa rimi gbengbren wan, bi ri jɨbu rimi meme ti riwa a he ri mgbumgblume riwa meme mbye ri ngɨzhi ye. <verse eid="2PE 1:4" /><verse number="5" style="v" sid="2PE 1:5" />Ritu nganyi ti kya riwa bi ti bi ri fon ndindi sro ngan rimi kpa nyɨme mbi, rimi ndindi ti mbi no to no he ngan; <verse eid="2PE 1:5" /><verse number="6" style="v" sid="2PE 1:6" />Rimi to mbi, no vu tu mbi no he ngan ri vu mbi, no vu sron mbi no he ngan, ri vu sron no bibi sron riwa Izhi no he ngan; <verse eid="2PE 1:6" /><verse number="7" style="v" sid="2PE 1:7" />Ri bibi sron riwa Izhi no nyime mbi riwa wa hu Izhi rimi hu Izhi no nyɨme mbi no he ngan. <verse eid="2PE 1:7" /><verse number="8" style="v" sid="2PE 1:8" />Ngye bibi kyawa riwa bi wa-a-en, riwa ka bi he ri wu kigbu, wa no yi he ri senkpa ran ngɨzhi kyawa wa ndindi ye sron ngan ri yi rimi to Bachi mbu Yeso Kristo. <verse eid="2PE 1:8" /><verse number="9" style="v" sid="2PE 1:9" />Ama bi ran he ri wa ran bi ran ri to bran ran biyi bi he wa mfiyen nye bi ri kpa wurusu ri Yeso ri ngla yi rimi meme ti mbi ri sen.<verse eid="2PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10" />Biyi miri vayi, son ndu ran ti ndu riwa bi ti riwa ari tsro ri bi he rimi wawa Izhi chu wa, iti ngamba bi ran kɨbu dza bi ri joku ri yosron mbi ri Izhi ran. <verse eid="2PE 1:10" /><verse number="11" style="v" sid="2PE 1:11" />Izhi ri bu nkon ri shu ri yi no yi gra rimi kpanchison riwa a ran kre ran riwa Bachi mbu nga Yeso Kristo riwa a kpata chuwo.<verse eid="2PE 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12" />Me wa me ri ran sonndu ran taka ri yi ritu kyawa wanyi, ko riwa bi to wa-e, nga wa ki mgbemgben rimi kpunji. <verse eid="2PE 1:12" /><verse number="13" style="v" sid="2PE 1:13" />Ri to won, a tsra riwa me vri, me sonndu ran taka kyawa wa nyi ri yi. <verse eid="2PE 1:13" /><verse number="14" style="v" sid="2PE 1:14" />Ri tu me to ri me gon ri kuu, bibi riwa Bachi mbu Yeso Kristo la ri mo. <verse eid="2PE 1:14" /><verse number="15" style="v" sid="2PE 1:15" />Ri ngamba ame Bitrus me ti ri senkpa won me ri no yi ran tika kyawa wanyi bla vi kugon kuu won.<verse eid="2PE 1:15" /></para>
  <para style="s">Wawa wa to Mkpen Kristo</para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16" />Ki ran ran wa ki ri la cholonchon ritu gbengbren Bachi mbu Yeso Kristo nga ri bru ye wan ran, ki to mkpen wan ri si mbu. <verse eid="2PE 1:16" /><verse number="17" style="v" sid="2PE 1:17" />A kpa mkpen wan ri A ti mbu Izhi ka ki he ri bubu wan riwa iraan a zhu ri wawu Ti mbu ri mkpen ye ri wu ri,&lt;&lt;Rinyi nye he ivren won riwa me nyɨme-u bran, ari no wen sisron !&gt;&gt; <verse eid="2PE 1:17" /><verse number="18" style="v" sid="2PE 1:18" />Kita kyumbu ki wo raan riwa a zhu ri shu ye-a ka ki he iwawa ri tu mgblu ri tsitsri.<verse eid="2PE 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19" />Kita ki yo sro ritu tre riwa wa la tre Izhi wa la-a, ari bi riwa bi sren ton riwu ritu a he ka ikpan wulu rimi bu tse i mi bre kpan nga kpan ri sron mbi. <verse eid="2PE 1:19" /><verse number="20" style="v" sid="2PE 1:20" />Ri kre wan wawu a he riwa bi to ri ila tre ri kusi ri ran he ri mbe Izhi riwa a zhu rinyu wa la tre Izhi kyumba ran. <verse eid="2PE 1:20" /><verse number="21" style="v" sid="2PE 1:21" />Ila tre ri kusi ran ri zhu ri sron nji ran, ama iyu Izhi nye ri gra rimi sron nji ko waka la tre riwa a kpa ri Izhi.<verse eid="2PE 1:21" /></para>
  <chapter eid="2PE 1" />
  <chapter number="2" style="c" sid="2PE 2" />
  <para style="s">Wa Tsro ri Che</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1" />Ama wa la tre Izhi wa che wa ran zhu rimi wa nji wa hu Izhi, ngamba me wa tsro wa che wa zhu rimi mbi. Wa ngiji dzi tsu ye, doka wa che, wari kamba ri nji riwa a kpa wa chuwo rimi gran ri meme ti, ri ngamba wa ngiji dzi tsu ye ri ngamba. <verse eid="2PE 2:1" /><verse number="2" style="v" sid="2PE 2:2" />Ri ngamba, ikigbu mba wa hu nkon mba riwa shan nga ritu kya riwa wa ti imgbron mba wa tre tre meme ritu nkon ri kpunji. <verse eid="2PE 2:2" /><verse number="3" style="v" sid="2PE 2:3" />Rimi nyɨme tumba wa ri ti che mba ri wiwiri wari kpa kya wa mbi. Ama Izhi kawan ri wa sisen mu, ikuu mba he ri nkon ri gben wa!<verse eid="2PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4" />Izhi ran ka wa miri ko wan chuwo ran inde wa ti meme ti, ama a kawa ta yo rimi juju riwa a ti bu, ri bubu riwa wa lo wa ri che ri gben chachu bla tre. <verse eid="2PE 2:4" /><verse number="5" style="v" sid="2PE 2:5" />Izhi ran ka wa sen chuwo ran, ama a ngɨzhi shu ima ye ri mgbumgblume ritu wawa wa ran hu Izhi ran, wawa a kpawa chuwo nye wa he Nuhu, ri wa a tre tre ri kpunji nga nji tamgban riwa wa nawo <verse eid="2PE 2:5" /><verse number="6" style="v" sid="2PE 2:6" />Izhi a gon gbu Sodon nga Gomora ri wulu ran kɨma wa dzi riwa wa ran to wari taka; <verse eid="2PE 2:6" /><verse number="7" style="v" sid="2PE 2:7" />Ran kpa Lo tu nji ri dindi chu wa riwa meme ti wawa wa ran to Izhi ran a kpa sron wan time. <verse eid="2PE 2:7" /><verse number="8" style="v" sid="2PE 2:8" />Wawu Lo tu nji ri ndindi-a a son rimi mba bla vi a ran lo ri sron riwa a ran wo bibi meme ti mba. <verse eid="2PE 2:8" /><verse number="9" style="v" sid="2PE 2:9" />Izhi to bibi riwa ari kpa wa ti ndindi ti chuwo rimi tsra mba nga bibi riwa ari lo wa meme ti dzi ri ndoza so yaa ran gben chachu bla tre. <verse eid="2PE 2:9" /><verse number="10" style="v" sid="2PE 2:10" />Aran ri lo sron ri wawa wa hu meme ti mba ran, iya ri timbiye nga wawa wa tsiri kpanchi Izhi.</para>
  <para style="p" vid="2PE 2:10">Inji wa tsro ri che nyi wa kpo ngamba ri tsiri nji, wa ran ri ti sisiri wa miri ko zhi ran; tsede wa kra wa tu. <verse eid="2PE 2:10" /><verse number="11" style="v" sid="2PE 2:11" />Kau ri miri ko Izhi, wawa wa he ri gbengbren ri senkpa han wa tsro ri che nyi, wa ran ngan wa tsro ri che nyi ri kratu ri kusi Bachi ran. <verse eid="2PE 2:11" /><verse number="12" style="v" sid="2PE 2:12" />Ama wa la tre Izhi ri che nyi wa he ka inɨma ji wa fu, wa hu kya riwa ikpa mba la wa kakre wawa wa ngɨzhi wa ritu wa ri vu wa wuu, wa kra kya riwa wa ran to-u bran ran. Wa wuu wa ka inɨma ji.<verse eid="2PE 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2PE 2:13" />Izhi ri no wa yaa bran ritu wa no nji wa ri yaa wa nyɨme wa ri ran ti kyawa meme ri rira, ritu nganyi wa kpa nde mbi time wari ngɨzhi shan ye ri yi. <verse eid="2PE 2:13" /><verse number="14" style="v" sid="2PE 2:14" />Wa sondu wa mba riwa wa kru ri wa, wa ran ri son vri ri ti meme ti ran; wa gyuru wawa ikpa nyɨme mba ri Kristo ran senkpa ran, nga wa ri no wa ti meme ti, wa su tumba bran ritu meme ti mba riwa wa ti-a. Izhi ri no wa yaa-e. <verse eid="2PE 2:14" /><verse number="15" style="v" sid="2PE 2:15" />Wa kamba ri ti kya ndindi nga wari gra ri ti bibi meme ti riwa Balaam ivren Beyo a ti ri sen, riwa a ran ti kyawa meme ritu ran fe nkren. <verse eid="2PE 2:15" /><verse number="16" style="v" sid="2PE 2:16" />Ngha wa yiranghan ritu meme ti wan, lankpron ka tre ri wu ka iraan nji ran no bibi ti wan ka wa la tre Izhi ka wa sra-a chuwo.<verse eid="2PE 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17" />Wa tsro ri che wanyi wa he ka isi ima riwa a klu, wa he gbu riwa gungu ri fu wa pis, ritu ngamba, Izhi ka bubu ri ti bu mgbimgbi ka dzi ri wa. <verse eid="2PE 2:17" /><verse number="18" style="v" sid="2PE 2:18" />Wa kpo ngamba ri kukulu ikpo ngamba ri mkpran, nga wari ri tindu ri mbye mba ri kpa wa ri vu wa jɨbu rimi wa nji wawa wa ti meme ti. <verse eid="2PE 2:18" /><verse number="19" style="v" sid="2PE 2:19" />Wa Lo tre dzi ri wa no wa sontu mba ama wawa kyumba wa he gran meme ti nga senji ritu ki he gran kongye riwa ari tsro ta nkon. <verse eid="2PE 2:19" /><verse number="20" style="v" sid="2PE 2:20" />Me tre rimba ritu wawa wa tsro ri cha ritu wa zhu dzu ri meme ti ri mgbumgblume nyi riwa a kpa zren nji time, rinyi ti nganyi ritu wa ka Yeso Kristo riwa a he Bachi mbu nji riwa ari kpa nji chuwo nga zizan wa bru gra rimi meme ti mba nga meme ti mba-a nye ri tsro wa nkon, wa he me ri kre wan han riwa wa ran he ri mimɨlan. <verse eid="2PE 2:20" /><verse number="21" style="v" sid="2PE 2:21" />Ran bi riwa ri wawa wari ran to nkon ndidi ran han riwa wa to wari kɨma gon ti-u ritu yo tsro nkon riwa wa tsro meme nkon riwa wa tsro wa. <verse eid="2PE 2:21" /><verse number="22" style="v" sid="2PE 2:22" />Ikya riwa a ye riwa a tsro ri itre kɨbu kɨbu wanyi-a la wa kpunji:&lt;&lt;Yawu ran bru ren kya riwa a so ki ran,&gt;&gt;Nga,&lt;&lt;Dushu ri ko riwa wa sukpa ari bru hi ran ka gra rimi bɨzhe.&gt;&gt;<verse eid="2PE 2:22" /></para>
  <chapter eid="2PE 2" />
  <chapter number="3" style="c" sid="2PE 3" />
  <para style="s">Ivi Riwa Bachi ri ye</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1" />Biyi wa kpan won, rinyi he mbe ri haha riwa me no yi me ngan rimi mbe wa nyi ngamba ritu no ran taka ri yi ritu no yi mɨlan taka ritu kya wanyi. <verse eid="2PE 3:1" /><verse number="2" style="v" sid="2PE 3:2" />Me wa no yi taka bi ri to kya riwa wa la tre Izhi wa tsitsri wa tre mgbamgbanmu, nga kya riwa Bachi riwa a kpata chu wa a tre dzu ri nyu wa ndu Izhi. <verse eid="2PE 3:2" /><verse number="3" style="v" sid="2PE 3:3" />Ri gbuchi, me wa me ri taka ri yi ri rimi kre vi, nji wari wa he riwa wa nza wari ti ko meme ngye riwa wa wa. <verse eid="2PE 3:3" /><verse number="4" style="v" sid="2PE 3:4" />Rinyi nye ri he janyu mba,&lt;&lt;A kadzi ri wawu ri ye ko a he minyi? Wa ti wa timbu wa kuu-e ama ko ngaa kawan he bibi riwa a he zhu ri vi riwa wa ti mgbumgblume.&gt;&gt; <verse eid="2PE 3:4" /><verse number="5" style="v" sid="2PE 3:5" />Wa ti rinye wari kamba ri kpunji riwa Izhi a de sisen muu, nga shu imba meme riwa Izhi ti wa, a ti meme ri ima, iima ka kagon nme. <verse eid="2PE 3:5" /><verse number="6" style="v" sid="2PE 3:6" />Imba ka tindu ri nchn ima-a nye ran vu mgbumgblume iwu hi ngawan. <verse eid="2PE 3:6" /><verse number="7" style="v" sid="2PE 3:7" />Ritu tre Izhi-a nye ishu ri meme wawa wa he zizan wa ka-u dzi ri gben wu riwa wa ti-u dzi ri gben wawa wa ran kpa Izhi ran hi chachu riwa wa bla tre, riwa wa huu wa ri wu.<verse eid="2PE 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8" />Ama bi yi miri vayi ran kpa wurusu ri kya nyi ran, ivi riri a he ka ise ngo ri ri Bachi nga see ngo ri a he ka ivi riri kusi Bachi. <verse eid="2PE 3:8" /><verse number="9" style="v" sid="2PE 3:9" />Bachi ran ri ti rererimi kya riwa a kadzi ri wawu ri ti ran, tsede ari vu sron ri yi a ran ri wa no ko ri no kuu ran, ama no ko ngan no ka meme ti chuwo. <verse eid="2PE 3:9" /><verse number="10" style="v" sid="2PE 3:10" />Ama ivi riwa Izhi ri ye ka nji ri yibi. Chachu wan ishu ri ka la ri raan mgbamgban, wa kya wa wa rimi wa wa gon wa meme ri kyawa wawa wa he rimi wan wa kado.<verse eid="2PE 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2PE 3:11" />Tunde ko ngye riwa a kagon mbu ri shan kado, ko milan ki bibi ri tsitsri nga son bibi riwa wa hu Izhi. <verse eid="2PE 3:11" /><verse number="12" style="v" sid="2PE 3:12" />Bi ki ri gben vi ye Izhi, ivi-a ri ngɨzhi dzi shu ri wuru ye, ko ngye ri shan ritu gbaji wuru. <verse eid="2PE 3:12" /><verse number="13" style="v" sid="2PE 3:13" />Ama ki gben kya riwa Izhi ka dzi: ri shu sisa nga meme sisa bubu riwa ndindi ti he ri koo.<verse eid="2PE 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14" />Ri ngamba, biyi wa kpan won, ritu bi gben kyawa wanyi no wa ye, mɨlan ki bi ri ti kya riwa a tsra ritu no Izhi ri to yi ri tsitsri chachu riwa kristo ri bru ye, bibi ri wa Izhi ri to ri bi he ri son ri sikpa ri wu. <verse eid="2PE 3:14" /><verse number="15" style="v" sid="2PE 3:15" />Taka ri ivu sron riwa Bachi ri ta a he ritu ki fe kpachuwo, bibi riwa vayi mbu Bulus ngan ri yi ri wiwiri riwa Izhi no. <verse eid="2PE 3:15" /><verse number="16" style="v" sid="2PE 3:16" />Rimi mbe Bulus riwa a ngan wawu a ngan bibi wan nye riwa a ran la wa ritu kyawa wanyi, kyawa wawa wa ngan rimi mbe wan, wa he ri yaa to riwa wawa wa ran to kyari ran, nga wawa wa ran vu sron mba ran wa la tre riwa a ran tsra ran, bibi riwa wati rimi mbe wari riwa a ngɨzhi wa yo ri kuu.<verse eid="2PE 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 3:17" />Ritu ngamba biyi miri vayi tu nde bi to kyawa wanyi-e mɨlan ki riwa bi ran hu tre wa meme ti bi joku rimi nkon mbi. <verse eid="2PE 3:17" /><verse number="18" style="v" sid="2PE 3:18" />Ama son ndu ran gbron rimi ndindi ti nga too riwa Bachi, nji riwa ari kpata chuwo Yeso Kristo no nkpen no he wawa, zizan hi ri kre wan, no he ngamba.<verse eid="2PE 3:18" /></para>
  <chapter eid="2PE 3" />
</usx>