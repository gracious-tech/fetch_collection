<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- BUU</book>
  <para style="h">Matiu</para>
  <para style="toc1">Matiu</para>
  <para style="toc2">Matiu</para>
  <para style="toc3">Mat</para>
  <para style="mt1">Matiu</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Bubu riwa Yeso Zhu (Luke 3.23-38)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Bubu riwa Yeso Kristo a zhu ye ri ko vren Doda, igi Ibrahi nye mba: <verse eid="MAT 1:1" /><verse number="2" style="v" sid="MAT 1:2" />Ibrahi a he ti Ishaku, Ishaku a he ti Yakubu, Yakubu a he ti Yahuda, nga miri vayi wan, <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />Yahuda a he ti Feresa ri Zera, iyi mba a he Tamar, Feresa a he ti Hesruna, Hesruna a he ti Aram, <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />Aram a he ti Aminadab, Aminadab a he ti Nashon, Nashon a he ti Salmon, <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />Salamon a he ti Boaza, iyi wan a he Raaba, Boaza a he ti Obida, iyi Obida a he Ruda, Obida a he ti Yese, <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />Yese a he ti chu Doda, Doda a he ti Sulemanu riwa iyi wan riwa he waa Yuriya, <verse eid="MAT 1:6" /><verse number="7" style="v" sid="MAT 1:7" />Sulemanu a he ti Rehobowan, Rehobowan ka he ti Abiya, Abiya ka ngɨzhi Asa, <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />Asa a ngɨzhi Yehoshafat, Yehoshafat ka ngɨzhi Yoram, Yoram ka ngɨzhi Azariya, <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Azariya ka ngɨzhi Yotan, Yotan ka ngɨzhi Ahaz, Ahaz ka ngɨzhi Hezekiya <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Hezekiya a he ti Manase, Manase a he ti Amon, Amon ka he ti Yosiya, <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />Yosiya a he ti Yekoniya ri miri vayi wan ri vi riwa wa vu wa hi Babila, <verse eid="MAT 1:11" /><verse number="12" style="v" sid="MAT 1:12" />Riwa wa vu wa hi Babila, Yakoniya ka he ti Sheyaltiyel, Sheyaltiyel ka ngɨzhi Zarubabel, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />Zarubabel a he ti Abiwudu, Abiwudu a he ti Eliyakim, Eliyakim a he ti Adzuro, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />Adzuro a he ti Saduku, Saduku a he ti Akimu, Akimu a he ti Aliyudu, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Aliyudu a he ti Aliyaza, Aliyaza a he ti Matana, Matana a he ti Yakubu, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />Yakubu a he ti Yusufu iron Meremu riwa a a he ti Yeso.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Imba nye vu ritu Ibrahi hi ritu Doda, wa gɨzhi wuru donza, zhu ri Doda rivi wa wa vuwa hi gran ri Babila iwulu donza nga wuru donza riwa wa wulutsu hu ye ri vi Yeso.<verse eid="MAT 1:17" /></para>
  <para style="s">Ngɨzhi Yeso Kristo (Luke 2.1-7)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Ingye bibi riwa wa ngɨzhi Yeso: Yusufu a ran wa Meremu riwa ari kpa ti waa, ko nowa gran, Iyu Tsitsri ka gra wu ka he ne. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Yusufu a he nji tsitsri riwa a ran nyɨme ran noo shan ran, a wa ran ka-u chuwo ri yayibi. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />Riwa a he rimi tika, imba Izhi ka tre ivren ri ndu Bachi a ye riwu rimi raa, ran tre, &lt;&lt;Yusufu ivren Doda, ran ti tsitsri ran, ban Meremu kati wa wen, inne mba a zhu ri Yuu Tsitsri ri ari ngɨzhi vren. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Wu yo nde wan ri Yeso, ritu riwa a ri kpa nji chuwo ri meme ti mba.&gt;&gt;<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Ri nyi a he nganyi ritu no nji no wa to kya riwa Izhi a tre dzu nyu nji ri la tre wan iri, <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />&lt;&lt;Ivra riwa a ran to ronron zari ran, a ri he ne, a ri ngɨzhi vren, inde wan ri he Imanuwe&gt;&gt; Riwa ari la ri, &lt;&lt;Izhi he ri ta.&gt;&gt;<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Riwa Yusufu a shɨme na, a ti kya riwa ivren ri ndu Izhi a tre ri wu no ti, ran ban Meremu hi ko wan ka he waa wan. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Ama wana kru ri ngamba ran hari ka ngɨzhi vren, Ka yo nde wan ri Yeso.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Izren wa wiwiri wa ka tre ri Yeso</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Riwa wa ngɨzhi Yeso ri meme Batalami riwa wa yo wu ri Yudiya, ri vi riwa Hiridus a he chu. Wa to ntsen huwa riwa a zhu kusi nzan ye ri Urushalima <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />wari miyen ri, &lt;&lt;Ichu nji Yahuda riwa wa ngɨzhi ri Batalami he ri minyi? Ritu ki to ntsen wan kusi nzan, Ki ye riwa ki noo mkpen wan.&gt;&gt;<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Riwa lchu Hiridus a wo nganyi ran ti fu bran bran, iwa wa gbu Urushalima wawu. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Imba ka yo wa de tre Izhi ri nji ri wa wa tsro doka Musa, ran miyen wa, &lt;&lt;Ri bubu gru nye wa ngɨzhi Kristo?&gt;&gt;.<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />Wa ka la wu ri, &lt;&lt;Rimi Batalami ri meme Yudiya,&gt;&gt; nganyi nye nji ri la tre Izhi a tre:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />&lt;A wu, Batalami, ri meme Yauza,</para>
  <para style="q2" vid="MAT 2:6">wa ran bla yo rimi wa chu wari bran ri meme Yahuza ran;</para>
  <para style="q1" vid="MAT 2:6">rimi wen nye ichu ri zhu riwa</para>
  <para style="q2" vid="MAT 2:6">ari ngɨzhi wa nji wan wa lsraila.&gt;&gt;<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Imba Ichu Hiridus ka yo wawa wa to ntsen huwa ran miyen wa ri yayibi ivi riwa ntsen huwa a kri. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Ka ti wa ndu hi ri Batalami ran tre, &lt;&lt;Hi ri miyen wa bubu riwa ivren-a he. i bi to bi ka ye la mo me ri hi tre ri wu ngawen.&gt;&gt;<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Riwa wa wo tre chu wari hu nkon mba inga ntsen huwa riwa wa to-u ri kusi nzan wa hu dza ntsen huwa ran hi, ntsen huwa ka kri ri bubu riwa ivren a he. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Riwa wa to ntsen huwa wa ka ngiri bran bran. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Riwa wa gra ri ko-a waka to vi vren imba yi wan Meremu, waka kɨbumgbazhu wari si kpimba wari noo wa tita wakpan rirri nga tulari mur imba luban. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Ama imba wa lawa ri mi raa i no wa ran bru hi ri chu Hiridus ngaran nga Wa ka hu nkon ri nkan hi gbu mba.<verse eid="MAT 2:12" /></para>
  <para style="s">Wa Wulutsu Gra ri Masar</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Riwa wa wulunde, ivren ri la tre ndu Izhi ka ye ri Yusufu rimi raa, ran tre riwu ri,&lt;&lt;Wulunde ri ban vren mba imba yi wan ri wulutsu hi ri gbu Masar ri son rimba sai me la ri wu, ritu Hiridus ri wa vren-a riwa ari wuu.&gt;&gt; <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Imba Yusufu ka ban vren-a imba yi wan ran gra ri gbu Masar. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />Yusufu a son rimi Masar hari kuu Hiridus. Rinyi a he ritu no tre riwa Bachi a tre dzu ri nyun nji ri la tre ri kusi, &lt;&lt;Rimi gbu Masar nye me yo vren won.&lt;&lt;<verse eid="MAT 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Riwa Hiridus a to ri wa to ntsen huwa wa gyuru wawu, isron wan ka time, imba ka de doka iri no wa wuu miri wawa wa ke see hari ban kugon ri gbu Batalami hari ri kusan wan, tse ri vi riwa wa to huwa waye la wawu. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Imba nye itre riwa Irimiya a ran la waka to a tsra:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />&lt;&lt;Imba iran ka zhu ri Rama,</para>
  <para style="q2" vid="MAT 2:18">waka ti shinji sron wari yii bran bran.</para>
  <para style="q1" vid="MAT 2:18">Raila ka yii miri wan; ran ka wo gyuru ritu wa kuu.&lt;&lt;<verse eid="MAT 2:18" /></para>
  <para style="s">Bru Hi ri Nazara</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Kugon riwa Hiridus a kuu, ivren ko Izhi ka ye ri Yusufu ri raa ri Masar <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />ran tre ri,&lt;&lt; Wulunde, wuri ban vren mba ri wawu yiwan wuri hi ri meme Israila, ritu wawa wa wa wari wuu vren mba wa kuu-e.&lt;&lt; <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />Imba ka wulunde ran ban vren imba yiwan ran hi gbu Israila. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Riwa Yusufu a wo ri Akilayus nye he chu ri gbu Judiya ri meme iko tiwan, ran ti sisiri riwa ritu wa la-u rimi raa, ran ban gon hi rimi gbu Galili <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />nga ran ka son ri gbu riwa wayo ri Nazarat, imba nye ikya riwa nji ri tindu Izhi a ran la ka ye tsra: &lt;&lt;Wa yo-u ri nji Nazarat.&gt;&gt;<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">Yohana a Milan Nkon ti</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Ri vi riwa a vu yɨba Yohana nji ri vunji sontu ri iima ka ye, ran ran tretre Izhi ri kuklu meme riwa Yudiya. <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />Ran tre ri, &lt;&lt;Ka meme ti mbi chuwo, ritu kpanchison ri shu he hwire.&gt;&gt; <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Yohana nye a he nji riwa Ishaya nji ri la tre Izhi a tre,</para>
  <para style="q1" vid="MAT 3:3">&lt;&lt;Njo ri kpagro ri ji,</para>
  <para style="q1" vid="MAT 3:3">&lt; Milan nkon ti ri Bachi;</para>
  <para style="q2" vid="MAT 3:3">no nkon wan no hi ndiri!&gt;&gt;&gt;<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Itsro Yohana riwa wa wuran wu ri nfu rakomi; a lo tiri wan kagon ri ntan, nga la wan a he dzi mba iima ton. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Imba wa nji Urushelima ri Yudiya wawu mba, nga wa meme nyu ne Wurdu, waka sondu ran ye ri wu. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Ka vu wa ran sontu ri iima ri ne Wurdu riwa wa ran la meme ti mba.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Ama riwa a to kpanji Farisa nga Sadukiyawa wa ye ritu riwa wa son wa tu ri iima, ka tre ri wa, &lt;&lt;Biyi wa meme manzɨrama! Ingan la yi no yi tsutsu ritu fu Izhi riwa ari ye? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Ritu ngayin, bi tsro ta kya riwa ari la ta ri bi ka meme ti mbi chuwo. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Nga ran to mba ri bi tre ri ngambi ri, Ibrahi he timbi ran. Me layi ri rimi tita wanyi Izhi ri ndzu wa no wa he gɨzhi Ibrahi! <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Igla riga he ri nchi konkron riwa a ran klo wulo dindi ran, wa tsen taga wari ta yo rimi wulu.<verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />&lt;&lt;Me son yi tu iima ri iima ritu ka meme ti mbi chuwo. kugon won nji riwa ari ye a han wen, ko ntan dza wan ima me ran to ndzuu ran. Ari vu yi sontu ri iima ri Yuu Tsitsri nga ri wulu. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Bibɨre wan he riwo wan, nga ari milan hwi wan ti, ran vu wɨlo kpi wan sro rimi wuron ran gon nfon wan ri wulu riwa wana to yibi ran.&gt;&gt;<verse eid="MAT 3:12" /></para>
  <para style="s">Ison Yeso tu ri Mma.</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Imba Yeso ka zhu ri Galili ye ri ne Wurdu riwa Yohana ri son-utu ri iima. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Yohana a wa ran kawan, ran tre ri, &lt;&lt;Ame riwa me wa no vu wen sontu ri iima, ko wu ye ri me no wen son-u tu ri iima?&gt;&gt;<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Ama Yeso ka tre riwu, &lt;&lt;No he ngamba zizan, ari bi ki ti don no njanji tre no he.&gt;&gt;Imba yoana ka nyime ran vuu sontu rimi iima.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Riwa Yohana a vu Yeso sontu ri iima, riwa a zhu rimi iima, ri vimba nye ishu wulu ka bu, nga ka to Yuu Izhi ka kan ka ngu ran son ran kpan ritu wan. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Ngha iran ka zhu ri shu ran tre ri, &lt;&lt;Rinyi he vren won, riwa me nyime-u, ari siwen sron ri wu.&gt;&gt;<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Itsra Yeso</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Imba, Iyu Izhi a ngizhi Yeso hi ri tsutsu ji no meme nji no tsra-u <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Kugon riwa a vu la iima vi senza richu senza, iyon kana ti-u. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Imba nji ri tsra nji-a kaye ran ye fe Yeso ran tre riwu ri &lt;&lt;Inde wu he vren Izhi wu ka kɨma tita nyi ti ri.&gt;&gt;<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Yeso ka tre riwu ri, &lt;&lt; A he rimi nga ri, a ran he ri, &lt;iri nkankshe nye nji ri nawo ran, ama ri wɨlo tre riwa a zhu ri nyu Izhi ye.&gt;&gt;&gt;<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Imba memenji-a ka ban wu hi rimi nchon tsitsri gbu ran ka-u dzi ri bubu riwa a dzen rimi tra bre Izhi, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />ran tre wu ri,&lt;&lt;Inde wuhe vren Izhi, dza ku ri meme, ki to a he rimi mbe Izhi,</para>
  <para style="q1" vid="MAT 4:6">&lt;Izhi ri la miri wandu wan ri &lt;</para>
  <para style="q2" vid="MAT 4:6">no wa rau wuran kɨbu dza ri tita ran.&gt;&gt;&gt;<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Yeso ka nyɨme ran tre ri wu ri&lt;&lt; Wa ngan ri mbe Izhi ngawen ri, &lt;Ran tsra Bachi Izhi wen ran.&gt;&gt;<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Nganga, memenji-a ka bru ban Yeso hi ri mgblu ri zen ran tsro-u mgbumgblume ri bubu wan ran tre riwu. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />memenji Ka tre ri,&lt;&lt; Gbugbu kyawa wanyi me kawa no-u, inde wu kɨbu mgbazhu wuri gbresan won.&gt;&gt;<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Yeso ka tre riwu ri, &lt;&lt;Tsirinkon memenji! Imbe Izhi tre ri, &lt;Kibu Mgbazhu ri Izhi wen wawu ri kankshiwan nye ti ndu ri wu!&gt;&gt;&gt;<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Imba memenji-a ka kawu don, nga mirindu Izhi wa ka ye wari ti ndu ri riwu.<verse eid="MAT 4:11" /></para>
  <para style="s">Yeso a Gbuchi Ndu wan ri Galili</para>
  <para style="r">(Mark 1.14,15; Luke 4.14,15)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Riwa Yeso a wo ri Yohana he rimi tra tren nji ka bru ye ri gbu Galili. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Riwa a ka Nazara don, ran ka son ri Kapanahun, riwa a he kusan nchon ne ri meme Zabulum mba Naftali. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Riwa ari tsra ri tre kya riwa wa tre hu nyu Ishaya nji ri la tre Izhi,<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />&lt;&lt;Meme Zabulum nga meme Naftali,</para>
  <para style="q2" vid="MAT 4:15">ri nkon riwa a hi ne riwa a he ri gran ne Yodan, Galili riwa wa ran kpa Izhi ran!<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Wa nji wawa wa rimi bu</para>
  <para style="q2" vid="MAT 4:16">wa ka to nchon kpantsu.</para>
  <para style="q1" vid="MAT 4:16">Ritu wawa waki ri meme-a ri iyu kuu</para>
  <para style="q2" vid="MAT 4:16">ikpan tsu ka kpan riwa.&gt;&gt;<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Ritu mba nye Yeso ka gra ri bla tre Izhi: &lt;&lt;Ka meme ti chuwo, ritu kpanchison ri shu ye hwire!&gt;&gt;<verse eid="MAT 4:17" /></para>
  <para style="s">Yeso a Yo wa Vu Lambe ti Nza</para>
  <para style="r">(Mark 1.16-20; Luke 5.1-11)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Riwa Yeso a ran zren kusan ne ri Galili, a to nji wari nji hari riwa wa miri vayi, Sima riwa wa ran yowu ri Bitrus nga vayi wan Andarawus, wa ta kali mba ranyo rimi ne, don wa he wa vu lambe. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Yeso ka tre wa ri,&lt;&lt;Ye hu wen, me tsro yi bibi riwa bi vu nji.&gt;&gt; <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Imba waka ka kali mba chuwo wari hu.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Yeso a ran hi, a to nji hari miri vayi ngamba Yakubu ivren Zabadi nga vayi wan Yahaya. Wa he ri nvuima ri tinba Zabadi, wa ran milan kali ri vu lambe ran ti. Yeso ka yo wa, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />wa ka miren hu wari ka nvuima mba nga timba don.<verse eid="MAT 4:22" /></para>
  <para style="s">Yeso a Tsro ran Den wa Lilo</para>
  <para style="r">(Luke 6.17-19)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Yeso a gra gbu Galili ran tsro wa rimi tra Izhi mba, a ran dɨbu tre dindi ri tra bre riwa ka ran den ko lilo bibitan riwa wana lo nji. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Itre wan ka kagbamu rimi gbu suriya, imba nji waka ngɨzhi wa lilo kan kan ye riwu, wawa wana to ya bran bran, wawa meme nji wa gra riwa, wawa wana ku kpinkpi nga wawa wa ri lilo ri klu kpa, ka den wa chuwo. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Ikpanji waka hu hi ri meme Galili ri gbu wuru nga Urushalilma imba Yudiya hi ri gran nchon ne Urdu.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Ibla tre ritu Tita</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Riwa Yeso a to kpanji wa bran, ran hon son ritu gashi, imiriko wan waka ye riwu, <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />imba ka gra tsro wa ran tre:<verse eid="MAT 5:2" /></para>
  <para style="s">Ingiri Ri Kpunji</para>
  <para style="r">(Luke 6.20-23)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />&lt;&lt;Dindi wan ri ran hu wawa wato iku nyɨren mba rimi Yuu;</para>
  <para style="q2" vid="MAT 5:3">ritu kpanchison ri shu ri he wamba!<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />&lt;&lt;Dindi wan rina hu wawa wa he ri shnji sron;</para>
  <para style="q2" vid="MAT 5:4">ritu Izhi ri no wa sisron!<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />&lt;&lt;Dindi ri ran hu wawa wa ka ngamba yo hwiri;</para>
  <para style="q2" vid="MAT 5:5">wa fe kya riwa Izhi ka dzi ri wa!<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />&lt;&lt;Dindi ri ran hu wawa wati nbiye ti ndindi ti;</para>
  <para style="q2" vid="MAT 5:6">ritu wa han wa kya riwa isron mba ri wa!<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />&lt;&lt;Dindi wan ri ran hu wawa wa lo sron ri wari;</para>
  <para style="q2" vid="MAT 5:7">ritu wa lo wari sron ngawen!<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />&lt;&lt;Dindi wan rina hu wa tsitsri ri sron;</para>
  <para style="q2" vid="MAT 5:8">ritu wa wato Izhi!<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />&lt;&lt;Dindi wan ri ran hu wawa wa ka sron kabru;</para>
  <para style="q2" vid="MAT 5:9">ritu wa yo wa ri imiri Izhi!<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />&lt;&lt;Dindi wan rina hu wawa wa so yaa rimi ti dindi ti ritu Izhi;</para>
  <para style="q2" vid="MAT 5:10">ritu Kpanchison ri shu ri he wamba!<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />&lt;&lt;Dindi wan rina hu yi inde nji wa kra yi tu, wati yi yaa, wari tiyi ko meme ti bibi tan ri tuwon. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Ti kinklan sron bi ri to ro wan bran bran ritu ife mbi ri kigbu rishu mu, ritu bibi mba nye wati wa la tre Izhi wawa wa gbuchi ri yi.<verse eid="MAT 5:12" /></para>
  <para style="s">Iima nga Kpan Wulu</para>
  <para style="r">(Mark 9.50; Luke 14.34,35)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />&lt;&lt; Biyi nye bi he iima riwa mgbumgblume. Ama ka iro iima zhu kre, wa tise wari milan-u ti no ro ri? Ba kya riwa wa ti riwu ri, tsede no wa kau rega no nji no wa chan ri dza. <verse eid="MAT 5:13" /><verse number="14" style="v" sid="MAT 5:14" />&lt;&lt;Biyi nye bi he kpan tsu ri mgbumgblume. Igbu riwa wa mme ri tu gashi a ran ri rii ran. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Wa ran ri ban wulu ri kpan ka dzi ri dza didan ran; tsede no wa ka dzi ritu bubu kri wan, no ran tsro ko nga rimi ko. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />No kpan mbi no ran kpan ran tsro nji kusi, don no nji no wa ran to dindi ndu mbi wari gbresan nde timbu riwa a he ri shu.<verse eid="MAT 5:16" /></para>
  <para style="s">Itsro ritu Doka</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />&lt;&lt;Ran tomba ka me ye ritu riwa me gban nye ri doka Musa nga tsro Wa la tre ri kusi ran. Me ran ye ritu miri ban wa zho ran, ama no wa he kpunji. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Kpunji tre me layi, kami no shuwulu ri meme no wa zii, ko iwɨlo tre riri riwa Izhi ran kado ran, tse wa shu kongye. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Nji riwa a ka ko vi krenkpen doka tre Izhi riri taga ran tsro nji kamba, wawu nye ri he krenkpen nji ri shuwulu. Inji riwa a hu doka Izhi ran tsronji, wa tre riwu ri a he rinkong nji rishu wulu. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Ame me layi, inde dindi ti mbi ran han riwa wa Farisa nga wa tsro doka Musa ran, bi ran gra ri ko Izhi ran.<verse eid="MAT 5:20" /></para>
  <para style="s">Itsro ritu Fu</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />&lt;&lt;Bi wo riwa wa la nji risen ri, &lt;Ran wuu nji ran, nji riwa a wuu nji wa no ya.&gt; <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Ama ame me layi ri ko nga riwa a ti fu ri vayi wan wa no ya. Nganga, ko ngha riwa a kra vayi wan tu ri, &lt;Nkpranchi!&gt; Wa ngɨzhi wu hi kusi wa sron mmo bla tre. Inde nji riwa kɨra vayi wan tu ri &lt;wuhe kuklu&gt;Wa vu yo ri ko wulu. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />Ritu ngamba, inde wuhi bubu de kya ri bubu de kpi ri tra Izhi wuri taka ri wu he ri shnji sron ri vayi wen, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />wu tika de wen chuwo wuri hi bru milan tre mbi ti ri vayiwen ri, ko wuri ye de kpi wen.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />&lt;&lt;Dzon tu imbi kpan fu wen riwa a ngɨzhi-u ri hi tra moo. Ti-u ka bi he nkon imbi-u ran noo no ngizhi-u gra riwo wa bla tre ran, nji ri bla tre ri ka kau no wa lokpa, wa lokpa wa ka kau yo ri tra tren nji. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Me lau kpunji tre, wuran zhu rimi tre nyi ran, tse wu han kre pien-pien.<verse eid="MAT 5:26" /></para>
  <para style="s1">Ikru ri Waa Nji</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />&lt;&lt;Wu wo riwa wa tre ri, &lt;Ran kru ri waa njo ran.&gt; <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Ame me la yi: nji riwa a ya wa ri sron mbiye a kru ri wamba rimi sron wan. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />lnde isi wen ri ka wu yo ri nou ti meme ti, ran ya kya mba ran! Ari bi riwu riwa nghima kpa wen kuri ran he ran riwa wa tru yo rimi wulu wawu. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Inde iwo wen ri no ti meme ti, han u taga. A ri bi no wo wen ri no ran he ran riwa mgbron kpawen ri gra rimi wulu.<verse eid="MAT 5:30" /></para>
  <para style="s1">Itsro ritu wuu Gran</para>
  <para style="r">(Matthew 19.9; Mark 10.11,12; Luke 16.18)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />&lt;&lt; Itre Izhi tre ri mbe wan ri, &lt;Inji riwa a wu gran waa wan ran no mbe ri wuu gran.&gt; <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Ame me layi nji riwa a wu gran waa wan,a yo rimi riwa njo nkan ri kru ri wu, nga nji riwa a gran waa riwa a wuu gran wan ari kru ri waa nji.<verse eid="MAT 5:32" /></para>
  <para style="s1">Itsro ritu Iban Shizhi</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />&lt;&lt;Nganga bi wo riwa wa tre ri nji gbangban mu ri, &lt;Wuran shizhi ri che ran, shi zhi wen riwa wu ban ri Izhi wen.&gt; <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Me tre ri yi ran shizhi ran, ko ri shuwulu, ritu riwa a he bubu son Izhi; <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />ko ri meme, riwa a he bubu yo dza wan ko ri Urushalima, ritu riwa a he nchon gbu riwa wa chu wa rinkon. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Ran shi shizhi ri tu wen ran, rtu riwa wuran to ti nfu tu wen riri no han kinklan ko shnji ran <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />No yɨme wen no he nyɨme wen no,&lt; ka,&gt; Wen lkya ri wa a han rinyi a ju ri meme ji.<verse eid="MAT 5:37" /></para>
  <para style="s">Itsro Ritu Tizhula</para>
  <para style="r">(Luke 6.29,30)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />&lt;&lt;Bi wo riwa wa tre, &lt;Isi ritu si, nga nghiri ritu nghiri&gt; <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Me tre riyi ran kri ri nji riwa a ri ti meme ti ran inde njo wuru-u ri takparan ri kuwo ri kɨma kuri wan no. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Ngha nji riwa a ngɨzhi-u hi ri bubu bla tre ritu ran vu-u tsro wen ra, wu ka no ngɨzhi kau ri tsro ri kakpa ngawen. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Inde njo riwa a yo-u no zren ri mile ri hi ri wu mile hari. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />No nji riwa a bre wu, ran kɨma gon ti nji riwa a bre la ri wu ran.<verse eid="MAT 5:42" /></para>
  <para style="s">Nyɨme wa kpanfu wen</para>
  <para style="r">(Luke 6.27,28,32-36)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />&lt;&lt;Bi wo riwa itre Izhi tre, &lt;Nyɨme wa kpan son bi, bi ri kambi ri wa kpanfu mbi.&gt; <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Ama me la yi: nyɨme ri wa kpanfu mbi, bi ri bre Izhi ri wawa wa no yi yaa, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />iwa bi he miri Timbi ri shu. Ari no nji no fren ri wa meme ri wa dindi, ran de wulu ri wa meme ti. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Inde wu wawa wa nyɨme wu, wu fe ngye? A ran he wa meme ti nye wati kamba ran? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Ngha inde wu chi miri vayi we nkankshe, wutingye han mgbron nji? Aran he wawa wara to ji nye wati ngamba ran? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />He zhanzhan bibi riwa A ti mbi ri shu he.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">Itsro ritu wa wa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />&lt;&lt;Yeso a tre ti rere ri ndindi ti mbi no nji no wa to ran, bi. Bi ti kamba bi ran kpa kya ndindi rishu ran.<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />&lt;&lt;I wu zon wa wa wa wa, ran noji no nji no wa wo bibi riwa wa wa wati ri kpa wati rimi tre Izhi nga kanran ritu no nji no wa to ran. Me layi kpunji tre, wa kpa kya mba. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Inde wu no wawa wa wa, ran no wori wen no to kya riwa iwo ta ri to ran, <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />don no de wen no he ri riri, no tiwen, riwa ari to kya riwa wati ri riri no no wu fe ri ndu wen.<verse eid="MAT 6:4" /></para>
  <para style="s">Itsro Ritu Bre</para>
  <para style="r">(Luke 11.2-4)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />&lt;&lt; Inde bi, ran he bibi wawa wa bre ri tossi ran bre, ran he bibi wawa wa wari no nji no wa ran to kya riwa wati rimi tre Izhi inga nkon ritu no nji ran to wawa. Me layi kpunji tre, bibi mba wa kpa lada mba wawu-e. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Inde bi bre, bi ka gra rimi tɨra mbi, bi ki kankon bi ri bre Ti mbi riwa wana to-u ran. Imba A ti wen riwa ari to kya riwa wati ri riri, ari nou ife ri ndu wen. <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />&lt;&lt;Inga inde bi bre Izhi, ran zizan ran tre ritu kya riri ka wawa wana to Izhi ran, don wato mba kari wawo wa ritu riwa wa tre kigbu. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />ran he bibi mba ran, don Ati mbi to kya riwa bi wa ko bi ri mɨyen.<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />Ingye, bibi bre riwa bi bre nye-en:</para>
  <para style="q1" vid="MAT 6:9">&lt;Ati mbu riwa a he ri shu:</para>
  <para style="q2" vid="MAT 6:9">No tsitsri nde wen no fe gbre;<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Kpanchison wen wen no ye:</para>
  <para style="q2" vid="MAT 6:10">ikya riwa huwa no wati ri gbungblume, bibi riwa wati ri shu.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />no ta ri riwa ki ri ruwa.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />Ka meme timbu rega rita,</para>
  <para style="q2" vid="MAT 6:12">bibi riwa ki ka meme ti riwa wati rita rega ngawen.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />ran ka ta chuwo ki hi ri bubu riwa ari nota yiwasi ran,</para>
  <para style="q2" vid="MAT 6:13">ama kpata chuwo riwo wa meme ti.<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />Inde bi ka meme ti wawa watiriyi rega, A ti mbi riwa a he ri shu ri ka meme timba rega riyi ngawen. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Ama inde bi ran kameme ti wari rega ran, Ati mbi ngawen ran ka meme timbi rega ran.<verse eid="MAT 6:15" /></para>
  <para style="s">Itsro ritu Ivu la Ima</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />&lt;&lt;Inde bi vu la ma, ran no njo no to riwu vu la ma bibi riwa wa ti timba no nji no wato ran, ran shui si noji nowa to ri wu vu zhi ran. Me layi kpunji tre, wa fe fe mbi nye mba. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Ama inde wu vu zhi, sro nye ritu wen wuri ngla si wen, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />no nji no wa ran to ri wu vu zhi ran, ama no ra Tiwen, riwa wana to-u ran, nga Tiwen, riwa ari to kya riwa wati ri yayibi ri no-u ife ri ndu wen.<verse eid="MAT 6:18" /></para>
  <para style="s">Zi kpi mbi rishu</para>
  <para style="r">(Luke 12.33,34)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />&lt;&lt;Ran kshu kpi mbi ti ri meme nyi ran, bubu riwa wa igon wa kpa time riyi, nga bubu riwa wayibi wa yira gra wari yibi ran. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />kshu kpi mbi ti ri shu ribubu riwa wa igon iwa kyawa wana rikpa time ran, inga bubu riwa wayibi wana-yɨra wari gra wari yibi ran. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Ri bubu riwa wu zi kpi wen, bubu wan nye isron wen he.<verse eid="MAT 6:21" /></para>
  <para style="s">Iwulu riwa Kpa</para>
  <para style="r">(Luke 11.34-36)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />&lt;&lt;Isi wen he ka ikya ri wa ari de kpan rikpa kpa, lnde isi wen wa bi ikpa wen wawu ri he ri kpan. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Inde isi wen wana bi ran, ikpa wen wawu ri he ri bu. Inde ikpan riwa a he ri wu ti bu ibran bu mba ri bran rise!<verse eid="MAT 6:23" /></para>
  <para style="s">Izhi nga Wa Kpi</para>
  <para style="r">(Luke 16.13; <ref loc="MAT 12:22-31">12.22-31</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />&lt;&lt;Ba njo riwa ari tindu rnji wako hari ri ntoŋ riri tsede no ka ri don ran yɨme ri, ko wu kari taga wuri nji ri. Wu ran to njiwa Ji imba kubu ran.<verse eid="MAT 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />&lt;&lt;Ritu ngamba me layi, no sron bi no ran ti me ritu kya riwa bi ri ka bi so ran, ko ritu kpa mbi ikya riwa bi sɨsu, rembi ran han la ran, nga kpa mbi ran han tsro risu ran? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />To wa chenchen wa shu mba, wana ri chu ko sɨren ko zi kya ri wɨron ran, ndu ri kamba Ati mbi riwa a he ri shu ri no wa ri. Biyi bi ran han wa ri nkpen ran? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Ŋnan riminbi, ritu shnji sron wan ari fon vi sron nga ri ngwan?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />&lt;&lt;Ko ingye ti ko shnji sron mbi ritu tsro ri sɨsu? To bibi riwa wa kɨbu kyawa waji wa gbron. Wa wa wa ran ri tindu kyari ran, <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Wawu ri kamba me layi, ko sulemanu ri kpi wen wa wa wa ban si, a ran su tsro zari riwa a han wambe zari ran. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Inde kamba nye he bibi riwa nji ri su tsro ndindi ri wa giga wa ji wawa wa riwa ruwa mbambɨre ka tawa sro ri wulu, a ran no yi tsro risu riwa a han wamba wawu ran. Biyi wa kpa nji ri nvinvɨri? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />&lt;&lt;Biyi ran shnji sron ran &lt;bi ri tre ri ko ki ringye? Ko ki songye? Ko ki sɨsungye? <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Rinyi nyi nyen he kya riwa wawa wana hu Izhi ran wa yo sron mba ri wu, Ati mbi riwa a he ri shu-wuru to ri biyi bi wa wa. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Biyi wa kpanchi son wan ri gbuchi ri kpunji tre wan, gbugbu kyawa wanyi wa ka sron ngan ri yi ngawen. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Ritu ngamba, ran ti shnji sron ritu mbɨre ran, imbɨre no taka ritu ngawan ko vi ritan he ri bibi ya wan.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Ran bla tre ritu wari ran</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />&lt;&lt; Ki na bla riwa ran wa wa ngawen wa bla retas. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />In kon wa wu bla wari a wu ga, wen wa bla wu, nga gongo wa wu tsra wari, gongo a wa tsra wu.<verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />Ingye ti wu ya vi giga wa a he si vayi wen, Inga wuna ya kpolo ri wa a he si wen ran? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Wu ti se wu la vayi wen, &lt;Me ban giga wa a he si wen,&gt; nga a wu giga he si wen? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />A wu meme nji gbuchi chu konkron wa a he si wen ri ku wo ri chu wa vayi wen.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />&lt;&lt;Na no yawu kya wa a he tsɨtsɨ ran. Na ta wuyen yowu dushu ri ko ran ari chan na ban tiyi meme.<verse eid="MAT 7:6" /></para>
  <para style="s">Bre, wa, wuru kon</para>
  <para style="r">(Luke 11.9-13)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />&lt;&lt;Na bre, wa noyi, na wa bi fe, ran wuru kon wa bu ri yi. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Inji wa a bre, wa no, nji wa a ri wa a ri fe, nji wa a wuru nkon wa bu wu.<verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />&lt;&lt;To in nga imi mbi wa ivren wan bre wu ngbuzhu a ri ban tita no? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Ko a bre wu lambe, a ri ban wan no? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />To biyi wa bi he meme nji ma, bi to kya wa ndindi wa bi no wa, bre ati mbu wa a he chu wa a ri de kyawa wa dindi in jin wa, wa bre wu!<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />&lt;&lt;Ikya wa bi wa no jin nowa tiyi biyi tiwa ngawen, niyin he tre wandu Izhi ri musa.<verse eid="MAT 7:12" /></para>
  <para style="s">Nkon ri fifi,</para>
  <para style="r">(Luke 13.24)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />&lt;&lt;Gra nkon ri wa a he fiwen ko ri wa a bu bran bran a he hi ri ko ku, ikon fiwen a he hi iko Izhi. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Iko wa he hi dindi surun, a he ko ri ya, iri wa wu, wa he fiwen.<verse eid="MAT 7:14" /></para>
  <para style="s">Konkron ri miri wan</para>
  <para style="r">(Luke 6.43,44)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />&lt;&lt;Wa tretre Izhi wache ya meme nji wa tre itsro ri che iwa, wa ye ntan ntima ama rimi sron mba wa zhu yawu waji riwa wa ji ri yon. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Bi to wa ritu kya riwa wa ti, nchon ran ri klo inabi ran ko ka no nchon no klo mbwa ran? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Nganyi konkron dindi ri klo bi ga meme konkron in klo wan ri he meme. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Konkron dindi a ran klo meme ran, meme konkron na klo dindi ran. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Konkron wa a ran klo dindi ran, wa tsen tse iwulu wa ri gon. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Ri klo ba wato bibi mba.<verse eid="MAT 7:20" /></para>
  <para style="s">Me ran Tou Ran</para>
  <para style="r">(Luke 13.25-27)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />Inji wa wa tre, Bachi, Bachi wa gra ko Bachi ran, tse nji wa ti kya dindi wa tibu ri shu. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Chachu mba, nji gbugbu wa tre, &lt;Bachi, Bachi! A ran he kita nye wa kɨi bla tre wen ki ri dzu bɨzhi rimi nde wen ran. <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />In nyi a tre mina to yi zari ran, &lt;ka wen don biyi wa ti ndu meme!&gt;<verse eid="MAT 7:23" /></para>
  <para style="s">Wa mme ko Hari</para>
  <para style="r">(Luke 6.47-49)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />&lt;&lt;Ka nji wa ri wu tre no, a he wa mu nga a ti kya wa bi, wa tre wuri bibi ji wa a mme kowan ri tu tita. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Riwa iwulu ye iima shu, gungu ti na ri wa ba ko, ran joku ran wa mi in han.<verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />&lt;&lt;Inji wa a wo tre wu, a ran tindu ri wu ra a he ka nji wa ame ko ri meme nza. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Riwa iwulu a ku, iba ka shu, inga ngungu kati iko ka joku bran!&gt;&gt;<verse eid="MAT 7:27" /></para>
  <para style="s">Gbengbren Yeso</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Riwa vren nji wa kre tre wan, igbu nji wa ye wa to. <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />Ki to ka a he nji, wa ari tsro tre wa Bachi a ran he ka nji riwa ari tsro tre Musa ran.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Yeso a no wa mkpuzhu si</para>
  <para style="r">(Mark 1.40-45; Luke 5.12-16)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Yeso a gɨzhi ri tu tita gbunji wa hu. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Ijin ri wa a ti mkpuzhu a ye ku ngbazhu bre wu, a tre,&lt;&lt; Bachi riwu nyime nuwen si kpa.&gt;&gt; <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />Yeso aban wo wan bre wu, na tre mi nyime, fe si iwa nkpunzhu ka kre. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Yeso a tre wu,&lt;&lt;Wo, ran la njo kya ran ri wu he nji ri bre Bachi nde ngiri wen no wa to ri tuba bibi wa Musa a la.&gt;&gt;<verse eid="MAT 8:4" /></para>
  <para style="s1">Yeso a de si ri Ivren jin rikon</para>
  <para style="r">(Luke 7.1-10)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Yeso a gra Kafanahum rinkon wa lokpa ri ka ye wa zon riwu ran tre, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />&lt;&lt; A wu tibuwawu ivren ri ndu won kru ko a ari lo lilo wu kpa,ari so yo bran,bran.&gt;&gt;<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Yeso a tre wu, me hi miri no si.<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Rinkon wa lokpa ka kpa yɨme ran tre,&lt;&lt;Me ran tsra riwa wu ye ri ko won ran riwu tre nji riwa ari tindu mmo ri fe sii. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Ame ma me he wo nji ri, inga wa lokpa wari wa ri wo won ime tre riwu, &lt;Hi,&gt; Ka hi, ri mu &lt;Ye&gt; Ka ye, &lt;ti kya kati.&gt;&gt;<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Yeso a wo nganyi ka no mamaki,&lt;&lt; ka tre miriko wan, mi la yi vi ku ri gbu Israila mi ran fe wa sengba kongye ran. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Me layi nji brabran wa ye kugbo, kushu wa wari ri Ibrahi, Ishaku, nga Yakubu iko won ishu. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Imiri wa wa wa washu iwa kamba wa ta wa saro ibu bubu wa wana yi wan ri tan nyiri.&gt;&gt; <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />Yeso ka tre ri nji ri lokpa roma, &lt;&lt;Hi ngawen, a he ngye wen surun wen wa wu ti.&gt;&gt;</para>
  <para style="p" vid="MAT 8:13">Ivren wen fe si.<verse eid="MAT 8:13" /></para>
  <para style="s1">Yeso a no nji kigbu si</para>
  <para style="r">(Mark 1.29-34; Luke 4.38-41)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Riwa Yeso a gra ko Bitrus, ka to iyi Bitrus a kru ri tsiri nbɨzhu. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />A bre wo kpa wan nbɨzhu ka kado, ka wurunde na tidu wan.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Yawulu a ti, wa vu jin bran bran ye wa, wa he lilo bɨzhi bran bran ri tre wan, ka dzu bɨzhi kyawa ri kpa mba. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Ri ngye a he nuwa la tre annabi ishaya a tre, &lt;&lt;Ri tuwan a ban lilo mba na ban meme wa lilo mbu wawu.&gt;&gt;<verse eid="MAT 8:17" /></para>
  <para style="s">Iya riwa wa rimi hu Yeso</para>
  <para style="r">(Luke 9.57-62)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Riwa Yeso a tuo gbu nji Bran, bran kagon wan ka la wa nu wa hi kugran mu <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />nji ri riwa a to doka Musa ka ye na tre wu.&lt;&lt;Inji ri tsro,&gt;&gt; ka tre ri &lt;&lt;Me wuu hi bubu wa wu hi&gt;&gt; <verse eid="MAT 8:19" /><verse number="20" style="v" sid="MAT 8:20" />Yeso ka tre, &lt;&lt;Wa yawu wa ji ri bu ba, chenchen wa he ko mba, ama ame ivren ji me ran he bubu sun ran&gt;&gt;<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Rimi miriko wan ran tre, nji ri ko, chu wen wo min wa, wa wu nji ri ko,&lt;&lt; ka wu chuwo me ban ti won no yibi ko miri ye.&gt;&gt; <verse eid="MAT 8:21" /><verse number="22" style="v" sid="MAT 8:22" />Yeso ka tre wu,&lt;&lt;Hu wen,&gt;&gt;Nga ka wawa no wa meme ti chuwo no wa no ngamba yɨbi kyumba don no wa no ngamba yi wen. &gt;&gt;<verse eid="MAT 8:22" /></para>
  <para style="s">Yeso a tre nchon ngungu wuru</para>
  <para style="r">(Mark 4.35-41; Luke 8.22-25)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Wa a gra vuima, imri ko wan wa wu. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Ga chan wu wulu a wulunde ri ma, wa ka he rijen ma, wa wulunde ri tru vuma, a ran kru na. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Miri ko wan, wa ka hi ran tashime wa ri tre,&lt;&lt;Bachi kpata chu wa, ki ku.&gt;&gt;<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Yeso ka tre riwa,&lt;&lt;Ingye ti ko bi ti fu, Biyi wa fifi kpa yɨme!&gt;&gt;Ka wulunde ran tre fu ri ngungu nga ne-a imba bubu ka kulu!<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Riwa nji wa to kya riwa a ti bi wa ka ti mamaki sisiri wa ri miyen ngye he ngha wa? gungu ga ma kukri!<verse eid="MAT 8:27" /></para>
  <para style="s">Yeso a kpa wa lilo bɨzhi hari chuwo</para>
  <para style="r">(Mark 5.1-20; Luke 8.26-39)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Riwa a hi gra meme wa yo wa nji Garasina nji hari wa wa he lilo bɨzhi wa zhu bubu gru. Wa ri fe wati sisiri, branbran njo ka ran hu ko mba ran. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Wa kpagɨro wari tre, &lt;&lt;Ingye wu wa ri ta a wu ivren Izhi? Wu ye riwa wu no ta ya iwa ivi na ti ri na?&gt;&gt;<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Iko a fon bran ri bubu wa, wa he ri dushu wako wana riri. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Ibɨzhi a bre Yeso ri,&lt;&lt; nga wu dzu ta hi ra tru ta yo ikpa dushu.&gt;&gt;<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Yeso a tre wa &lt;&lt;Hi,&gt;&gt;Wa ka zhu wa ri hi kpa dushu, wa tsutsu,wari wagra ma wa ri ku.<verse eid="MAT 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33" />Iwa wa ho dushu wa tsutsu gra gbu wa ka la nji ikya riwa ti a ti kabru ri jin wa, wa he lilo bɨzhi. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Igbu wawu wa wulunde hi wa fe Yeso wa, wa to vren Bachi wa Bre wu no ka gbu meme mba don na hi ngawan.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">Yeso a kpa wa lilo klukpa chuwo</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Riwa Yeso a gra ri nghɨma hi gra gbu wan. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Wa ban nji riwa a he lilo klukpa, kru ri bla. Riwa Yeso a to ikpanyɨme mba senkpa. wan ran tre, &lt;&lt; Ivren won ran kpa sron wen time ran. wa ka meme wen ti wen chuwo wu.&gt;&gt;<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Riwa wa nganyi, wa tsro doka Musa waka tre ri kamba ri, &lt;&lt;Inji nyi ri Izhi ri time.&gt;&gt;<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Yeso a to rimɨren mba ran mɨye wa, &lt;&lt; Itu ngye meme tre he resron mbi? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Ritan han wu, wa tre, &lt;Wa ka meme ti wen chuwo wu,&gt; Ka wa tre, &lt;wurunde hi ngawen?&gt; <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Ama me wa no yi to ri ivren nji he ri senkpa riwa ari ka meme ti nji chuwo ri mgbumgburu mme.&lt;&lt; Imba ran tre ri nji ri lilo gblu kpa no wurunde ran ban ntabɨri wan ran hi ngawen ko.&gt;&gt;<verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />Ngha nji-a ka wurunde na ban ntabɨri wan ran hi ko. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Riwa gbu nji wato nganyi tse sisiri ka ti wa, wa ka ŋgiri ri Izhi wari no jin wa gbre ti mbu, riwa a no nji gbengbren.<verse eid="MAT 9:8" /></para>
  <para style="s">Yeso a yo Matiu</para>
  <para style="r">(Mark 2.13-17; Luke 5.27-32)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Riwa Yeso a hi kusi a to nji riwa wa yo wu ri Matiu a son meme ri bubu wa kpa nkɨren ri meme. &lt;&lt;Hu wen.&gt;&gt;Ka la wu, wurunde na hu.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Riwa Yeso a na ri ri ri ko Matiu, nga wa kpa nkɨrememe nga wa timeme ti wa ye bran bran wa ki wawa ri miriko wan. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Riwa nji Farisa wa ka tre ri imiri ko wan wa miye ngye ti ijin ri ko mbi ari riri iwa wa kpa nkɨren meme ri wa ti meme ti? <verse eid="MAT 9:11" /><verse number="12" style="v" sid="MAT 9:12" />Riwa Yeso a wo ngamba ka tre riwa, &lt;&lt;Wa sikpa wa ran wa nji ri den ran ara wa lilo. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Hi bi ri tsro kya riwa rinyi ri tre, &lt;Me wa lo sron nye riyi, a ran he sɨroyi ran.&gt; Me ran ye ritu yo wa dindi ti ran, mi ye ritu yo wa ti meme ti.&gt;&gt;<verse eid="MAT 9:13" /></para>
  <para style="s">Wa Miyen Yeso Ritu Vunyu</para>
  <para style="r">(Mark 2.18-22; Luke 5.33-39)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Riwa imri ko Yahaya wa ye ri Yeso wari tre, &lt;&lt;ngye ti ko kita wa Farisa ki vunyu ama miriko wen wa ran ri vunyu ran?&gt;&gt;<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Nga Yeso ka tre wa, &lt;&lt;Inde nji riwa a kpawa sisa he riwa kpan wan ngye ri nowa vunyu? Tse chachu riwa nji ri kpa wa sa ran he ran ko wa vunyu.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />&lt;&lt;Wa ran ban tsro sisa nga lagba tsro ran don sisa ma tsro ri kpa lagba wan gbon bran bran. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Wa ran sro nfrihi rimi gbanran wa kɨmo ran. Inde wa sro rimi gbanran wa kɨmo wa yira. nfri hi ri rega. Gbanran wa time. Nfiri hi no ka sro rimi gbanran sisa, ri ngamba nye wana rasa ngamba ran. &gt;&gt;<verse eid="MAT 9:17" /></para>
  <para style="s">Ivɨra Yayirus mba wa riwa a ran zhu yi riwa a bre wo ri nyu tsro Yeso</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Riwa Yeso a he mi tre nganyi, rikon wa Lokpa ri ka ye ran kɨbu ngbazhu kusi Yeso ran tre, &lt;&lt;Vɨra won kuu zizan ye wuri bre wu wo, ari wurunde.&gt;&gt; <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Imba Yeso ka wurunde ri wa miriko wan ran hu.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Nga iwa ri wa a ti se wuru don hari riwa a ran zhu yi, ka ye kugon wan ran bre nyu tsro wan wo. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />A tre ri,&lt;&lt;Ko me bre wo tsro wen megyen me fe si.&gt;&gt;<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Yeso ka kɨma ya ran tou. Na tre ri wu, &lt;&lt;Hi ngawen, ikpa nyime wen a no wu si.&gt;&gt; Imba nye ka fe si.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Riwa Yeso a hi ri ko rinkon wa Lokpa, ran to wa nvɨri rangan ri kpanji riwa wana kagbamu. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Yeso ka tre,&lt;&lt;Don nkon. Ivɨra yin ran kuu ran, ari kruna.&gt;&gt;Wan nzawu ri tsɨri. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Riwa wa dzu wa zhu ra, imba Yeso ka gra ran vu ri wo, imba ivɨra ka wurunde. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Itre a ka shan gra rimi gbu.<verse eid="MAT 9:26" /></para>
  <para style="s">Yeso a den wa nfyen ri wa hanton</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Riwa Yeso a ka bubu wan chuwo, imba wafiyen hari wa hu wari kpagɨro yo-u wari tre, &lt;&lt;To lo sron mbu, a wu vren Doda.&gt;&gt;<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Riwa Yeso a gra ri ko wa nfiyen waka ye riwu, ka tre ri wa, &lt;&lt; Bi kpa nyɨme me kpa yi chuwo?&gt;&gt;Wa ka tre wu, &lt;&lt;Een Bachi.&gt;&gt;<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Imba ka bre wo ri si mba ran tre, &lt;&lt;A he kpanyɨme sron mbi, wa kpa yi chuwo.&gt;&gt; <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Imba isi mba ka bu. Ama Yeso ka gbi wa vumvuton bran bran ran tre, &lt;&lt;Nowa ran la njo tre nyi ran.&gt; <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Ama wa ka zhu wari si la tre-a ri gbu wawu.<verse eid="MAT 9:31" /></para>
  <para style="s">Yeso a no Nji riwa aran ran tre ran no tre</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Riwa wa ran hi ngamba, nji ri riwa a he ri ibɨji a ran ya tre ran waka ngɨzhi wu ye ri Yeso. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Riwa wa zhu ri bɨzhi mangbi-a ka gra tre.Imba ikpanji waka tre ri, &lt;&lt;Wa ran to bibi tin nyi zari ri Israila ran.&gt;&gt;<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Ama Farisa wa tre,&lt;&lt; A ri tindu ri senkpa meme bɨzhi nye ran zhu ri bɨzhi.&gt;&gt;<verse eid="MAT 9:34" /></para>
  <para style="s">Yeso a lo sron ri wa Nji</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Imba Yeso a hu wa gbu ri bran ri wa tsitsa, ran ran tsro ri tɨra bre, a tretre dindi ritu tɨra kpanchi riko Izhi, ran ran den nji kpa chuwo rimi lilo kankan. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Riwa a to nji wa kabru bran bran, imba waka losron, don wa to ya, njo ran he riwa ari zon wa ran, ka ntɨma wawa wa ran he rnji ri kɨshu wa ran. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Ka tre ri mɨriko wan ri, &lt;&lt;Isɨren kigbu bran bran ama wa sɨren wa ran bre ran. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Ritu ngamba, bi bre Izhi, noo no wa sɨren kpi nowa ye sɨren kpi riwu.&gt;&gt;<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">Yeso a ti Wuru don Hari Ndu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Yeso a yo miriko wan wuru don hari ran nowa gbengbren riwa wa dzu bɨzhi, wari ran den ko lilo bibitan. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Ngye inde miriko wan-a een: Sima riwa, wa yowu Bitrus, ri vayi wa Andarawus, nga Yakubu vren Zabadi, nga vayi wan Yahaya; <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Nga Filibu, nga Batalomi, nga Toma, nga Matiu riwa a ran kpa nkɨre meme, nga Yakubu ivren Halfa, nga Taddiyus; <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />nga Siman nji kaana, nga Yahuza lskariyoti wa a reri Yeso.<verse eid="MAT 10:4" /></para>
  <para style="s">Yeso</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Imba Yeso a ti a ti wuru don hari ndu ran la wa, ri &lt;&lt;Ran hi bubu riwa wa ran to Izhi ran, nga gbu Samariya. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Tsede bi ka hi ri ntɨma wa Israila wawa wa kado. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Inde bi he rimi hi, bi ka ran tretre: &lt;kpanchison ri shu a ye hure!&gt; <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Den wa lilo kpa chuwo, wawa wa kuu tawa shɨme, den wa lilo mkpuzhu, zhu ri wa bɨzhi. Izhi a no yi gbengbren Kukulu, biyi ngawen no wari gbengbren kukulu ngawen. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Ran ban tita, wa nkɨren ran, ko tita wa kpan ri kpo nbi ran; <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />Ran ngɨzhi kpo ran, ko tsro hari, ko ntanza ko kpala ritu zɨren mbi, don nji rindu he riwa wa no kya riwa ari wa.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />Igbu ko vi gbu wa bi hi wa nji dindi imi mba bi ri son wa wa tse chachu riwa iwulunde mbi ye. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Bi gra ko bi ka chiwa. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Inde iko-a kpayɨme, ichi mbi ka gɨzhi riwa, ama inde wa ran kpa chi mbi ran ichi mbi ka bru ye ri yi. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Inji riwa a ran kpa yi ran, ko a kawan ri wo tre mbi, bi ka kpo wuru ri gbu mba ko ri komba rega wa. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Kpunji tre me la yi, chachu bla ari he huri ri meme Sadom mba Gomora ri wawa wa kamba ri kpa tre Izhi. <verse eid="MAT 10:15" /><verse number="16" style="v" sid="MAT 10:16" />Me tiyi ndu ka ntɨma rɨi rimi wawa wa zhu yawu wa ji, ritu kamba ti wiwiri ka wawa, wawa wa ran wutsu ka nguu.<verse eid="MAT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 10:17" />&lt;&lt;Ti rereri nji,wa ngɨzhi yi hi riko wa bla tre, wa bla tre wa tsiyi ri gbagba ri tɨra bre mba. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Ngha wa vuyi hi kusi nji wa rinkon ri Roma ri wa chu ritu won don bi ri la tre raro kusi mba ri kusi wawa wana he wa tsro tre musa ran. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Inde wa vu yi, no sron mbi ran time ritu kya riwa bi tre ran, wa no yi kya riwa bi tre ri vi wan, <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />don a ran he biyi nye bi tre ran, iyu Izhi mbi nye ri tre dzu ri nyu mbi.<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />&lt;&lt;Vayi ri de vayi wan no wa wuu, A ti ri de vren wan, imiri wa ran ki sikpa ri wa timba ran wa wankon no wa wuu timba. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Ko ngha ri kawan ri yi ritu nde won, ama nji riwa a vu sron hi ri kre wan wa kpa chuwo. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Iwa no yi ya ri gbu ri, bi ka wulutsu hi ri gbu ri kusi, kpunji wan me layi, kafi noyi zɨren bla gbu Israila Ivren Izhi ri bru ye.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />&lt;&lt;Ba vren riko riwa a han nji ri tsɨiro wan, ko no wa tre ri gran han nji ri ko wan. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />A tsra riwa ivren ri bla no he ka itiko wan, gran kuma no he ka itiko wan har nowa yo nji riko Baalzabul, to nji wa ko wan fa!<verse eid="MAT 10:25" /></para>
  <para style="s">Wawu riwa wa Ti Sisiri wan</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />&lt;&lt;Riti kamba, ran ti sisiri mba ran, ba kya riwa a he ri bu riwa wa ran sɨra yo ri ra ran. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Ikya riwa me layi ri yayibi, bi ka la no kongha no wo. Ikya riwa wa layi ri ton bi ka hon shu bi ri lanji. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Ran ti sisɨri wawa wa wuu kpa ri kankɨshe ran, tsede bi ka ti sisɨri Izhi riwa ari wuu kpa mba sron riko wuru. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />To bibi riwa wa gye wa he mba, wana he kyawa riwa wa bran ran, ama kubu riri ri to re-u. Ama inde a joku kuu, Izhi mbi rishu a to don a nyɨme wa. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Nfu ri tu mbu a he rimi bla. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Ritu ngamba ran ti sisiri ran, bi he dindi han wa gye!<verse eid="MAT 10:31" /></para>
  <para style="s">Inyɨme nga wawen ri Kristo</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />&lt;&lt;Inji riwa no jin nowa towen, ame ngawen me no tiwon ri shu no to wu ngawen. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Ama nji riwa a kawan rɨme kusi nji, ame ngawen me kawon riwu kusi tiwon riwa a he shu.<verse eid="MAT 10:33" /></para>
  <para style="s">Aran Si sron ran Ama Inji Ngban</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />Ran tomba ka me ye ritu riwa me ngɨzhi sisron ye ri yi ran me ran ye ritu si sron ran, tsede iku. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Ame me ye Riwa me yo fu ri tsutsu ti mba vren, vruwa mba yiwan, Iwa vren wan ri yi wa vren wan; <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />lnji wa ko wen nye wa kpan fu wen.<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />Yeso tre ri, &lt;&lt; Inji wa a nyɨme tiwan han wen ko iyiwan han wen, a ran he wa mo ran; <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />nga nji riwa a ran ban nkponkɨron wan ran hu wen ran, a ran he wa mon ran. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Inji riwa ari wa ran kpa kama chuwo a ran fe ran, ama nji riwa a hon sron wan ritu won ari fe wu.<verse eid="MAT 10:39" /></para>
  <para style="s">Indu ri Fe</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />&lt;&lt;Inji riwa a kpa yi a kpa wen nye, nga nji wa a kpa wen, a kpa Tiwon Izhi riwa a ti wen ndu. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Inji wa a kpa nji ri la tre Izhi ritu a he nji ri la tre Izhi ari fe ife ri ndu riwa nji ri la tre Izhi nga nji riwa a kpa nji ri tsitsri ritu a he nji ri tsitsri ari fe ife ri ndu riwo nji ri tsitsri. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Inji riwa a no ivren won vi kya riwa a he fiwen gyen ko a he vagho ima riri ri si nye ritu a he vrenriko won, me layi kpunji tre a ran hon fe ife ri ndu wan ran.&gt;&gt;<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Yeso Nga Yohana ri Son nji tu Ima</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Riwa Yeso a kɨre bubu no miriko wan tre ran ran kɨra ran ran tsro wa ri gbu mba ran kɨra bubu bla ran ran tsro ri gbu Galili.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Riwa Yohana a wo kya wa Yeso ti <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />ka ti miriko wa ndu nowa ye, a wu ngawen wu ye, ka ki yosi ritu njo nkan?&gt;&gt; <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />Yeso ka lawa, &lt;&lt;Hi bi ri la Yahaya kya wa bi wo bi ri to. <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Wa nfyen wa to tsu, wa nkpuzhu wa zɨren, wa hanton wa wa tre nga wa ya wa wo tre Izhi. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Dindi wan ri hu nji riwa a ran ka ko wan don ritu won ran.&gt;&gt;<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Wa hi mba Yeso ka tre ri gbunji tre Yohana ran tre bi ka ya kya nji wa miriko Yohana ran hi Yeso kana ta nji tre ritu Yohana ran tre bi ka ya inge ri ji? Ka bi ka ri ya giga riwa ngu ngu a fu rega? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Ka ran he ngamba ran bi ka ya ngye? nji wa a su tsro dindi? wa wa su tsro dindi wa son ri tɨra bla tre chu. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Bi hi riwa bi to ngye? Bi hi bi to nji ri ndu Izhi? Mi layi Yohana han wa ndu Izhi. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Rinyi nye he ritu nji riwa wa ngha: &lt;Mi ti wa ndu won ndu hi gbuchi no wa milan nko ran ti riwu.&gt; <verse eid="MAT 11:10" /><verse number="11" style="v" sid="MAT 11:11" />Me la yi kpunji tre: Rimi wa mba wawa wa ngɨzhi wa njo riwa a bran han Yohana nji ri vunjisontu ima ran; ama Yohana a he fifi rimi kpanchison ri shu a han Yohana. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Ye ri vi Yohana ri son nji tu ima hari ye zizan kpanchi son ri shu zhu ye wa meme ti wayo ta yaa ye zizan. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Wa ga tre Musa, wa tre Musa wa tretre iti Yohana <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />I bi kpa wen wa wu nye a he tu iliya riwa a hi ran ye. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Ri wa a he ri ton ri wo, ka wo.<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />&lt;&lt;Ki tsra wa nzan zizan rise? wa he ka miri wa wa ki bubu re kpi wa ran yo wari: <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />&lt; Ki nviri ngba ri yi, nga bi ran ngulu ran; ki chuse ri yi kuu bi ran yi kuu ran.&gt;<verse eid="MAT 11:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18" />Riwa Yahaya a ye, a ran ri ko ran so ran nji wa ka tre ri, &lt;A he ri ibɨji.&gt; <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Vren Nji ye ran ran ri ran ran so, waka tre, &lt;Nji nyi ri zizan ri ran so bran, ran he kpan nji ri kpa nkɨren ri meme! nga nji wa meme ti.&gt;&gt;<verse eid="MAT 11:19" /></para>
  <para style="s">Igbu wawa wa ran kpanyime ran</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Yeso a gbuchi ran ven ri gbu ri bran a ran ritu ndu dindi, riwa a ti ama wa ran ka meme ti mba chuwo ran <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />&lt;&lt; Iya mbi bi yi wa nji Korazi iya mbi bi yi Batsaida! Inde indu ri de sisiri ri wa wa ti mi mbi, wari ti wu ri Tyre nga Sidon, wa ri ka memeti chuwo sisen mu rimi tsro ri nyi kuu nga nton <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Ama Me la yi kpunji, chachu bla tre wato losron wa Taya ri sidon han yi. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Biyi wa meme, Kafarnhu, a he riwa wa gbresan mbi hi ri shu nye? Aran he ngamba ran, wa kpa yi tsiri, hari chachu kuu. Wari tre ri kyawa wa de sisiri riwa me ti ri yi bibi riwa me ti ri Sodom, ran kri hari ye ri vi ri luwa nyin <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Ama me la yi a ri he huri ri Sodon ri vi bla tre Izhi han ri yi.&gt;&gt;<verse eid="MAT 11:24" /></para>
  <para style="s">Ye ri me bi ri son Vɨri</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Ri chachu mba Yeso ka tre,&lt;&lt;Me gbre wu, A ti, Bachi ri shu nga meme, ritu bi ri kyawa wamba ri nji wa wiwɨri nga wa to kya, nga bi ri ka wa ri ri miri wa tsitsa. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Een, A ti, ritu rinyi a he dindi ro wen.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />&lt;&lt;Kongye Iti won ka wa yo ri wo won. Njo ran to ivren ran tse Iti, nga njo ran to Iti ran tse ivren nga wawa ivren-a su ran bu tsro wu.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />Ye ri me wawu biyi riwa bi he ri iya, nga wa meme ti ame me noyi vɨri <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Ban kpi won ri ngawen wuri koya ri me, ritu me he rere miri he huri ri sron, nga wu fe son vri ri sron wen. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Ritu ikpi won he huri ran ran ron ran.&gt;&gt;<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Bachi ri Chachu Son Vɨri</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Ri vi ri chachu son vɨri,Yeso a gra dzu ri zhu alikama chachu sonvɨri. Iyon ka vu Miriko wan imba imiri ko waka tan wari ran tan. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Riwa nji Farisa wa to ngamba, wa ri tre wu,&lt;&lt;Ya! Imiriko wen wa ti kya riwa a ran bi riwa no wati chachu sonvɨri ran.&gt;&gt;<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Ka tre wa,&lt;&lt; Bi ran kɨra kya riwa Doda a ti zari riwa iyon a tiwu, ikya riwa wa ti wawa kpan zɨren wan? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />A gra ri ko Izhi ran ri ri riwa wa kɨma-u zi riwa a ran bi nowa ri ran, nga wa kpan wan. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Ka bi ran kɨra mbe Musa zari ran, bibi riwa chachu son vɨri,wa ti ndu Izhi wa yɨbasi ri ko Izhi chachu son vɨri, riwa wa ran yɨbasi ran? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Me la yi, ikya riwa a han ko Izhi he nyin. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Bi ri to tu kya riwa itre mba he, bi ri ran kpa nji riwa a ran to kya ran time ran <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Ritu Ivren Nji a he Bachi riwa chachu son vɨri.&gt;&gt;<verse eid="MAT 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Imba ka gra rimi tɨra Izhi mba. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />nji ri riwa a kɨlu nkon a he bubu wan. wa ran wa kya riwa wa vu Yeso ri wu, waka miyen wu, &lt;&lt;A bi nowa den chachu son vɨri?&gt;&gt; <verse eid="MAT 12:10" /><verse number="11" style="v" sid="MAT 12:11" />A miye wa ri,&lt;&lt;ngan rimi mbi inde ntɨma wan ku ri mi juju chachu son vɨri a ran vu ran chu wu zho rimi juju ran? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />wana kan ji kaburu mba ntɨma ran.&gt;&gt; <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />A tre lnji-a,&lt;&lt; nowen wo wen.&gt;&gt;Ka de wo wan inba wo wan ka bi bibi riwa iri wan a he. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Ama wawa wato doka Musa wa ka zhu tre ri ngamba ritu bibi riwa wa wuu Yeso.<verse eid="MAT 12:14" /></para>
  <para style="s">Ichu Vɨren ri ndu Izhi</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Riwa Yeso a to ngamba ran wulunde ri bubu wan <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Ka dzu wa no wa na la jo kya wa a ti ran. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Don no wa shu tre riwa Ishaya nji ri la tre Izhi a tre ri, <verse eid="MAT 12:17" /><verse number="18" style="v" sid="MAT 12:18" />&lt;&lt;Ngye nji ri wa me chu wu, riwa me nyɨme wu, isron wo ri si riwu, me yo wu ri wo wan, ri gbungblume nyi. <verse eid="MAT 12:18" /><verse number="19" style="v" sid="MAT 12:19" />Me ran ven ran, mi ran tre gbangban ran, njo ran wo ran won ri ra ran. <verse eid="MAT 12:19" /><verse number="20" style="v" sid="MAT 12:20" />konkron riwa a nime a ran tren-u ran, Iwulu riwa agon ri yɨbi a ran yɨwi wu ran. A ri no kpunji no ban kusi. <verse eid="MAT 12:20" /><verse number="21" style="v" sid="MAT 12:21" />Gbungblume wa yo sron mba ri nde wan.<verse eid="MAT 12:21" /></para>
  <para style="s">Yeso nga Baalzabul</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Waka ngɨzhi nji riwa a he ri ibɨji ran ti nfɨyen ran he mangbi, Yeso ka no ran tre na to tsu. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Wawu nji waka ti sisiri ran tre, &lt;&lt;Ri nyi nye riwa a he vren Doda?&gt;&gt; <verse eid="MAT 12:23" /><verse number="24" style="v" sid="MAT 12:24" />Riwa Farisa wa wo kya riwa a ti, waka tre, &lt;&lt; Aran ti ndu ri senkpa Baalzabul ivren chu ibɨji, ran dzu ibɨji.&gt;&gt; <verse eid="MAT 12:24" /><verse number="25" style="v" sid="MAT 12:25" />Yeso a to taka mba ran tre riwa, &lt;&lt;Igbu riwa inyu mba ran he riri ran a ri joku, iko riwa wa ga kamba ti hari a ri joku. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Inde meme nji ri dzu meme nji, ari he wa wanyu ri ngamba nye mba. <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Inde ri senkpa Baalzabul nye me dzu bɨzhi, ri senkpa ŋnga nye nji mbi wa dzu mba zhu? Ka mba wawa nye wa he wa bla tre mbi. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Nde ame ri senkpa Izhi nye me zhu bɨzhi, kpanchison Izhi a ye ri yi.<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />Inde bi wa bi ri gra riko nji ri senkpa bi ri vu kpi wan, tse bi vu lo ko bi fe nkon gra bi ri vu kpi wan.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />Nji riwa a ran he ri me ran, a ran nyime wen ran, nga nji riwa a ran ka ka bru ri me ran a ri vu vɨra nye mba. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Me la yi, nde bi ti meme ti ri kpa nde nji ti me, me kayi chuwo, ama nde bi kpa nde wu Izhi ti me wa ran ka meme ti mbi chuwo yi ran. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Nji wa ti meme ti ri vren nji, wa ka meme ti wan chuwo. Ama nji ri wa a tre meme ritu wu tsitsri wa ran ka meme ti wan chuwo ran ko zizan ko iviri.<verse eid="MAT 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />Mɨlan konkron ti no bi, no klo wan no bi, kpa konkron ti me no klo wan no ti me. Konkron dindi wa to wu ritu klo wan. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />&lt;&lt;Bi yi meme wan. wa ti se wa ri wo tre dindi ri nyu mbi. Rimi sron nye itre ri zhu dzu nyu ye ra. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Nji wa meme wa tretre meme, nji wa dindi wa tretre dindi. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Me layi kpunji, meme tre riwa bi tre wa miye yi chachu bla tre Izhi. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Itre wen nye ri kpa wu chu wo, nga tre wen nye ri kpa wu time.<verse eid="MAT 12:37" /></para>
  <para style="s">Igba Nkon riwa Jona</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Farisa ri wa tsro doka Musa wa tre riwu ri,&lt;&lt;Ki wa ki ri to kyawa wa sisiri ri wu.&gt;&gt;<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Yeso ka la wa ri, &lt;&lt; Biyi wa meme ti wa nnzan nyi wawa wari to kya riwa ari tsro riwa nowa to kyawa wa de sisiri ama wa ran to kyari ran tsede nowa to riwa Yunana nji ri la tre Izhi. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Ri wa Yunana a ti vi tɨra ri chu tɨra rimi nne nchon lambe, ngamba nye ivren nji ri ti vi tɨra rimi meme. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Wan nji Nineve wa wurunde ki nde ri chachu bla tre Izhi ri wa nnzan nyi wari kre wa ritu riwa wa ka meme timba chuwo ri tretre Izhi riwa Yunana, nga riwa a han Yunana a he ri nyi. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Nkpen wa ri kusi yawuru ri zhu chachu bla tre wawa wannzan wa zizan wari zi rega; a zhu kusi yawuru ye ran wo tre Solomu riwa a he ri wiwɨri, ama riwa a to han Solomu he ri wa.<verse eid="MAT 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />&lt;&lt;Inde meme wu zhu rikpanji, ran kari wa bubu riwa ari son vɨri ka a ran fe ran. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Imba ari tre, &lt;Me bru hi ko riwa me kadon.&gt;Inde a ye, ran ran fe njo ran, wa vu tsu wan penpiren wari vukpi mɨlan ki. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Imba ari hi ran vu ngbɨron tangban riwa wa meme han, wa gra hi wari ki bubu wan. nga kre wan ri meme han ri mimilan. Kamba nye ari he ri wa meme nnzan nyi.&gt;&gt;<verse eid="MAT 12:45" /></para>
  <para style="s">Iyi Yeso Nga Miri vayi wan</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Riwa Yeso a ran tre ri kpanji, iyi wan nga mirivayi wan wa ki ri ra, wa ran wa wari tre riwu. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Inji ri ka lawu, &lt;&lt; Iyi wen iwa mirivayi wen wa wa ri kana,wa wa wari tre ri wu.&gt;&gt;<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />A tre riwu, &lt;&lt;Ko nghan he yi won, nga wa nghan wa mirivayi won?&gt;&gt; <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />A tsro wo ri miriko wan, ran tre, &lt;&lt;Ingye iyi won nga wa mirivayi won een. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Inji riwa a ti kya riwa A ti won ri shu tre wawu nye he vayi won vruwa vrenron nga yi.&gt;&gt;<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Ikɨbu tre Nji ri Chu Kpi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Ri chachu mba Yeso a zhu ri mi ko hi ra, ran son ri nyu ŋne. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Iwa kpanji wa ki kagon wan ri nyu ima ka wurunde gra son ri nghɨma ran ka wa don ri nyu ima. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />A la wa kyawa kigbu ri tre kɨbu-kɨbu ran tre, &lt;&lt;Inji ri ron hi zhu bubu chu kpi. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Riwa a ran hi kpi, iwɨlo wari waka ku ritu nkon, wa chenchen waye tan ri. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Wari waku ritu tita, bubu riwa a ran ti meme bran ran, a zhu mbe gbagbla, ritu riwa meme wa ran ziri ran. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Ama inde iji zhu, wa ka pho, nga wari ku ritu riwa wana he ri nga ran. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Ngbron wɨlo kpi wa rega ri tsutsu nchon, ri wa wa gbron wari ma wa to. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Nganga iwɨlo wari wa ku ritu meme dindi, riwa ari klo wari tise sewuru, ise tanren ka ise tɨra ri kya riwa wu chu. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Inji riwa a he ton, no wo.&gt;&gt;<verse eid="MAT 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Imiriko wan waka ye riwu wari miyen, &lt;&lt;Ingye ti ko wu tre kɨbu-kɨbu ri nji?&gt;&gt;<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />Ka tre riwa, &lt;&lt;wa no yi tonchi kpanchison ri shu, ama a ran riwa ran. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Inji riwa a he wo, no sron ngha ari he riwu kigbu. Inji riwa a ran he riwu ran, ko vi kya riwa a he riwu wa vuu ra. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Ngye kya riwa ari no wen me tre kɨbu-kɨbu een: Wa ya, ama bi ran ri to ran, bi sɨrenton ama bi ran ri wo ran. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />Itre Ishaya a he bibi riwa a tre-a:</para>
  <para style="q1" vid="MAT 13:14">&lt;Bi ran sɨrenton hi ri kre vi ran ,</para>
  <para style="q2" vid="MAT 13:14">bi ran ya ama bi ran wo whi wan ran.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Isron nji wa nyi he mgbɨngbindri, a he ri ya riwa wawo ri ton mba, nga,wa gyuru si mba.</para>
  <para style="q2" vid="MAT 13:15">Iri gyen wari to ri simba, wa wo ri tonba,</para>
  <para style="q2" vid="MAT 13:15">wa to ri sron mba wa kɨma,nga ame me den wa.<verse eid="MAT 13:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16" />Ama dindi wan ri he wa simbi ritu wa to, nga wa tonbi ritu wa wo. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Me layi kpunji tre, nji wa la tre Izhi kigbu ri wa dindi sron wa wa wari to kya riwa bi to ama wana to ran,nga wa wa wari wo kya riwa bi wo ama wa ran wo ran.<verse eid="MAT 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />&lt;&lt;Sɨrenton mba bi ri wo kya riwa kɨbu tre riwa nji ri chu kpi ri tre: <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Inde nji ri wo tre ritu kpanchison ran ran to tuwan ran, meme nji ye ran ye ban kya riwa wa chu ri sron wan. Rinyi he chu kpi riwa wa chu ri nkon. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Riwa a kpa kpi riwa a ku ri tu tita a he nji riwa a wo tre ran kpa mkpa riri ri kinklan sron. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Ama ritu riwa a ran he ri nja ran, ari son fiwen. Inde iya ye ritu tre, ari ku rega gbagbla. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Riwa a kpa kpi riwa a ku ritu nchon a he riwa inde a wo tre, iya ri meme riyin ri gyuru ri wa iwo ri mau to ran dzu ri klo, <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Ama wawu riwa a kpa kpi riwa a ku ri meme ri ndindi a he nji riwa a wo tre ran to tuwan ari de bi ri, ari de nkpa se wuru, se tanren, ka nkpa se tɨra ri kya riwa a chu.&gt;&gt;<verse eid="MAT 13:23" /></para>
  <para style="s">Ikɨbu Tɨreritu Giga</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Yeso a la wa ikɨbu tre ri;&lt;&lt;Kpanchison ri shu a he ka nji riwa a chu wɨlo kpi dindi ri zhu. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Ama riwa ko ngha ri kru nna, ikpanfu wan ye ran chu giga rimi wan ran hi ngawan. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Inde alikama zhu ran ti tu mba giga ri zhu ngawen.<verse eid="MAT 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27" />Inji riwa a ri tindu riwu ye ran miye-u ri, &lt;Njiriko, wuran chu kya dindi ri zhu wen ran? Ko ritan nye alikama wazhu ye?&gt;<verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />&lt;Ikpanfu nye ti ri nyi,&gt;A tre. &lt;Inji ri ndu wan ka miye, Wu wa nota ki hi gbi rega?&gt;<verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />&lt;Chuwo,&gt; A tre ritu ngye bi ka ri gbi giga, bi gbi ka bru ri bi kpi dindi. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Nowa gbron kabru tse chachu sɨren. chachu mba nye me la wa sɨren: Gbuchi la giga bi ri lo wa sro wuru nowa hu, ran vu alikama sro ri wɨron won.<verse eid="MAT 13:30" /></para>
  <para style="s">Itre wɨlo su ri mumu ri kpa kpi fu</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />A lawa tre ri kɨbu-kɨbu,&lt;&lt; kpanchi ri shu a he ka wɨlo su ri mumu riwa ka chu ri zhu wan. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Ko riwa a he krenkyen wen han wɨlo kpi mbi, ama ari gbron, a wɨloga han ngbron konkron rimi zhu riwa chenchen wa shu wa ye wari ki ri wo wan.&gt;&gt;<verse eid="MAT 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />A bru la wa tre ri kɨbu kɨbu:&lt;&lt; Kpanchison shu a zhu mumu riwa ari kpa kpi fu riwa iwa ban kabruri nchon mumu hari wa kabru ri ngamba.&gt;&gt;<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Yeso a la tre wa nyi kɨbu-kɨbu ri kpa nji; a ran la wa kyari ran tse ri kɨbu-kɨbu. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Ngamba nye ka he</para>
  <para style="q1" vid="MAT 13:35">&lt;&lt;Ikya riwa wa la tre Izhi wa tre,</para>
  <para style="q2" vid="MAT 13:35">Ame me bu nyu won ri kɨbu tre chachu riwa wati mme.&gt;&gt;<verse eid="MAT 13:35" /></para>
  <para style="s">Ila tre giga rimi alikama</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Imba ka ka nji don ran gra ri ko.Wa miriko wan waka ye riwu wari tre,&lt;&lt; Mɨlan la ta tu tre ri giga rimi zhu.&gt;&gt;<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Ka kpa nyɨme ri,&lt;&lt;Inji riwa a chu kpi he Vɨren Nji, <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Izhu he gbungblume, nga wɨlo dindi he miri wa kpanchison. Ngha giga wa miri wa meme, <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />nga nji riwa a chu wa a he meme nji, isɨren he kre vi, nga wa sɨren wa he miri wandu Izhi.<verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />&lt;&lt;Bibi riwa wa gbi giga wari huu wuru, ka mba nye ari he chachu kre vi. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Ivren nji ri tre miri ko wan zhu, wa ron giga ji rimi kpanchi son wan ko ngye riwa ari no nji yiwasi nga wawa wa ti meme ti. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Wa tawa sro rimi nchon wulu, rinyi nye wa yi wari ran tan nyiri. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Imba wawa wati dindi ti wa kpan ka Izhi rimi Kpanchi Timba. Wo yi,Inji riwa a he riton, no wo.<verse eid="MAT 13:43" /></para>
  <para style="s">Ikɨbu tre ri bubu zi kpi riwa a he ri riri</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />&lt;&lt;Kpanchi son ri shu he ka bubu zi kpi riwa wa kau ri meme inde nji fe, ari kau ri nganga, nga ran kau rewawu ri kinklan sron rimi kya riwa a fe rimi rɨwan. <verse eid="MAT 13:44" /><verse number="45" style="v" sid="MAT 13:45" />&lt;&lt;Nganga, kpanchi rishu a he ka nji riwa a he ri wo ari wa kyawa wa wa kpan ririri. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Riwa a fe kya ri kpan ririri, ran vu kya riwa a he ri wa ran reu.<verse eid="MAT 13:46" /></para>
  <para style="s">Ikɨbutre riwa She ri Vu Lambe</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />&lt;&lt;Nganga, kpanchison rishu a he ka ishe riwa wa ban yo ri nchon nne no vu ko bibi lambe ritan iwawu. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Riwa lambe wa sho, wa vu lambe wa gbi zhu ri nyu nne mba wa ki meme wari la lambe wa dindi ri sisen, ama wa ka wa meme wan rega. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Ingye bibi riwa ari he chachu kre vi nye een Izhi ri ti miri wandu wan ye wari zhu meme joo rimi wa dindi <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />Wari ta wa sro rimi nchon wulu, bubu riwa wana yi wari ran tan nyiri. <verse eid="MAT 13:50" /><verse number="51" style="v" sid="MAT 13:51" />Yeso ka miyen wa,&lt;&lt;Bi to tu tre wanyi iwawu mba?&lt;&lt;A ka lawu&lt;&lt;Enn.&gt;&gt;<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Imba Yeso ka tre riwa,&lt;&lt;ko ngha riwa ari tsro doka riwa wa lau tre ritu kpanchi rishu a he ka nji riko riwa a vu kpi wa sisa ri wa kɨmo joo ri tre rimi kpi.&gt;&gt;<verse eid="MAT 13:52" /></para>
  <para style="s">Inji ri la tre Izhi riwa a ran he ri Nkpen ran</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Riwa Yeso a lawa tre wa kɨbukɨbu nyi kɨre, ri mba ran ban kusi hi. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />A ran ye rimi gbu wan,a gbuchi ran tsro wa rimi tɨra bre mba, waka ti kinklan sron.&lt;&lt;Rimi nyi nye nji fe bibi wiwɨri ri kyawa wade gbengbren?&gt;&gt; Wari mɨyen. <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />&lt;&lt;Ri nyi ran he vren nji riwa ari kpan mbɨre konkron ran? Inde yi wan ran he meri ran imiri vayi wan wa ran he Yakubu, Yusufu, Sima nga Yauza ran? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Imiri vayi wan mirimba wa ran he ri ta ran? ko ri minyi nye nji nyi fe kyawa. wanyi?&gt;&gt; <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Waka tifu riwu. Ama Yeso ka tre riwa, &lt;&lt;Ara ri gbu nji ri la tre Izhi nye nga ko wan riwa wa tsiri.&gt;&gt; <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Ngha a ran ti kyawa wa de sisɨri bran ran ritu riwa wana he wa kpa nyɨme ran.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Ikuu Yohana nji ri vu nji Son tu ri Mma</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Ri vi wan Hirudus a wo bibi ngɨzhi tre hi ritu Yeso. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />Ran tre ri wa tindu riwu,&lt;&lt;Ri nyi nye he Yohana nji ri vuu nji son tu ima; a ta shɨme! Ritu kamba nye gbengbren kyawa wa de sisiri wa tindu ri wu.&gt;&gt; <verse eid="MAT 14:2" /><verse number="3" style="v" sid="MAT 14:3" />Zizan Hiridus a vu Yohana nji ri sonji tu ima tren ri bre Izhi ran ritu Hirudiya iwa vayi wan Filibu, <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />ritu riwa Yohana nji ri son nji tu ima a tre riwu:&lt;&lt;Aran tsra riwa ari gran hirudiya ran.&gt;&gt; <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Hiridus a ran wa ran wuu Yohana, ama a ti sisiri nji ritu wa ban wu a he wa ndu Izhi.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Chachu tika vi ngɨzhi Hirudus Ivɨra Hirudiya a ngɨlu riwa ri bubu ro a ran no Hirudus sisron bran bran <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />imba ka shɨiji ri wawu ri no vra ikya riwa a bre. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Imba iyi wan ka lawu, ran tre,&lt;&lt; Ri no chu tu Yohana nji ri vu nji son tu ima no wawu.&gt;&gt; <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Isron chu ka time, ama ritu shiji riwa a shi ri nyu wan, ka lawa no wa no kya riwa a mɨyen. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />ka ti ndu hi ri ko riwa wa tren nji waka wiyen tu Yohana. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Waka ngɨzhi tu Yohana rimi tereye no vra ka ngɨzhi ka no yiwan. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Imri ndu Yohana wa ye wari ban kɨmo Yohana hi ka no yɨbi.Wari hi wa ka la Yeso.<verse eid="MAT 14:12" /></para>
  <para style="s">Yeso a Ho nji Ngo Ton.</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Riwa Yeso a wo kamba, ka wurunde ri bubu wan, a gra rimi nvu ima ran hi bubu riwa ba njo ri bubu wan. Riwa wa wo ngamba, ikpanji-a waka wulunde wa ri huu ri za. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Riwa Yeso a zhu rimi nvuima ran to kpanji wa ki. Ka ya wa ri sii losron ran no wawa wana he ri si ran no wa si.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Iwa yawulu a ti, imiri ko wan waka wawu ye wa ri tre,&lt;&lt;Bubu nyi njo ran he ri bubu wan ran, ga yawulu ti. No kpanji nyi nowa hi ko wari wa kya ri ri.&gt;&gt;<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Yeso ka la wa, &lt;&lt; Aran he riwa wa hi kamba ran, bi wa kya nowa ri.&gt;&gt;<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />Waka lawu ri,&lt;&lt;ki he ri ngbɨre jujuyɨmo ton ri lambe hari.<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />Ka tre ri,&lt;&lt;Ngɨzhi wa ye no wen.&gt;&gt; <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Imba ka la wa ri no wa nji-a nowa kuki ritu giga. Riwa a ban jujuyimo mgbɨre ton ri lambe hari-a, ran ndzu wa ban shu, ran ngiri ri Izhi, ran chu wa jujuyimo, ran si no miriko wan, Imiriko wan wa si no wanji. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Wawumba waka ri wari hushi, nga miriko wan waka vu susu wan shu rimi sisen wuru don hari riwa wa kadon. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Ikpa ronron riwa wa ri wa he ngo ton ama wa ran bla mba ri miri.<verse eid="MAT 14:21" /></para>
  <para style="s">Yeso a Dzren ritu Nchon ima.</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Ka no miriko wan waka gra rimi nvu ima wari rugran ri ko wawu ka no kpanji waka hi ngamba. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Kugon riwa a chu wa wo na ka hon ritu tita wawu nkankɨshi wan don ran bre Izhi. Hari yawulu ka he ri bubu wan nkankɨshi wan, <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Ama nghɨma ka he ri tsutsu ima, ama kana shi ritu riwa ngungu a ran tru ran hi kusi wan.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />Ri bu mbre Yeso ka wulunde zren ritu ima riwa ari fe miriko wan.<verse eid="MAT 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 14:26" />Riwa imiriko wan wa to a ran zɨren ritu ima, wa tre ri,&lt;&lt;A he bɨzhi nye&gt;&gt;Wari kpagɨro ritu sisiri.<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Imba meron Yeso ka tre riwa,&lt;&lt;Ba kya! A he ame. Ran ti sisiri ran yi.&gt;&gt;<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Imba Bitrus ka kpanyɨme ran tre ,&lt;&lt;Bachi, inde a he a wu nye, to wuka nowen me ye riwu ritu ima.<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />Ka tre , &lt;&lt;ye,&lt;&lt;Imba Bitrus ka zhu rimi nvu ima , ran zɨren ritu ima hi ri Yeso. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Ama riwa a to ka ngungu senkpa ran ti sisiri riwa a ran yibi tu ri ima ran kpagɨro, ran tre ,&lt;&lt;A wu Bachi, kpawenchuwo!&gt;&gt;<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Ri bubu wan Yeso ka nɨme wo ran vu, ran lawu ri,&lt;&lt;A wu ri fifi yosron, ritu ngye ti wu ran nyime rɨme ran?&gt;&gt;<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />Riwa wa gra rimi nvuima-a, ngungu ka ran gbla kri. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Wawa wa he rimi nvu ima waka kɨbu ngbazhu ri wu, ran tre, A wu wu he vren Izhi kpunji.&gt;&gt;<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Riwa wa rugran hi Janisarat. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Riwa nji wa gbu wato ri a he Yeso, wa ti ndu hi ri gbu wawa wa kagon gbu. Nji waka vu wawa wa ran he si ran ngji ye ri wu. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Waka bre wu ri no wa lilo nowa bre wo ri nyu tsro wan, wawa wa bre wo ri nyu tsro wan waka fe si.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">Wa Tsro wa wa Ti wa Ti</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Imba Farisa wari nga wa-tsro doka wa zhu ri Urushelima ye ri Yeso wari miyen ri, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />&lt;&lt;Ingye ti ko imiriko wen wana hu doka tre wa rinkon ran? Wa ran ri ngɨla wo ko wari ri ri ran!&gt;&gt;<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Yeso ka tre, &lt;&lt;Ingye ti ko bi kambi ri hu nkon Izhi ritu nkon wa timbi? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Izhi ka tre ri, &lt;No wa tiwen ri wa yiwen mkpen&gt; Inji riwa a lanyu ri tiwan ko iyi wan waka wuu. <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Ama biyi bi tre ri, inde njo tre ri tiwan ka iyi wan,&lt;Wawu kya riwa bi hi ran fe ri meme ka no Izhi,&gt; <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Imba nye ritu nkon watimbi bi kambi ri hunkon Izhi. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Biyi wa gyuru nji! Ishaya a tre tsra ritu mbi ri:<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />&lt;&lt;Gbunji wayin wa tretre won dzu ri nyu,</para>
  <para style="q2" vid="MAT 15:8">Ama wa kpata ri me rimi sron mba.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Wa huwen ri kuklu;</para>
  <para style="q2" vid="MAT 15:9">ritu tsro riwa nji nye wa tsro riwa nji.&gt;&gt;<verse eid="MAT 15:9" /></para>
  <para style="s">Kyawa wa kpa nji zuu</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Yeso a yo kpanji ran tre ri,&lt;&lt;sɨrenton bi ri wo. <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Ikya riwa a gra dzu nyu nji a ran ri kpa &lt;time&gt; Ran, ama ikya riwa a zhu dzu nyu, wawu nye rikpa nji &lt;Time. &gt;&gt;<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Imiriko wan waka ye ri wu wari miyen ri ,&lt;&lt;Wuto ri itre riwa wutre mba, nji Farisa wawo wari tifu?&gt;&gt;<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Imba ivren Izhi ka tre wa ri &lt;&lt;Ikya riwa Ati won riwa a he ri shu ran sen ran wa ya chu wu ri njanchi. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Chu wa wo; wa ti nfyen; ka nji rinfyen ngji nji rinfyen, wawumba wa ku ri juju.&gt;&gt;<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Imba Bitrus ka mɨyen wu,&lt;&lt;La ta tu tre riwa wu tre.&gt;&gt;<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />&lt;&lt;Yeso ka miyen wa ri,&lt;&lt;Kau biyi ngawen bi ran to tu wan ran. <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />&lt;&lt;Biyi bi ran to ri ikya riwa a gra rimi nne dzu ku nyu ari bru zhu ban ra ran? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Ama ikya riwa a zhu rimi ye ra dzu ku nyu a zhu rimi sron, nga ikya wa nye wa kpanji time. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Meme rimɨren ri zhu rimi sron nye ye rira, nga ikɨruwanji, ri yibi, ri ti che tnji (ila kya riwa wuran to ran)nga kpande time. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Wayin nye wa kpa nji &lt;time;&gt; Kuma a ran he iri kya riwo ji nye ri kpanji time ran.&gt;&gt;<verse eid="MAT 15:20" /></para>
  <para style="s1">Yosron riwa Wa</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Yeso a wurunde mba hi ri meme Taya mba sidon. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Imba iwa ivɨra kaana ri ka ye riwu ran dzu ran ran tre ri, &lt;&lt;Bachi, Ivren Doda, to losron won shi! Meme bɨzhi ri wuru vɨra won ari to ya.&gt;&gt;<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Imba ka ran tre kya ran. Imiriko wan waka ye wari bre wu ri, &lt;&lt;Zuu no hi ngawan, ari hantaton ri yi wan.&gt;&gt;<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Imba Yeso ka tre riwa ri, &lt;&lt;Wati wen ndu ye ri wa Israila wawa wa kado nye rinkɨshe.&gt;&gt;<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Ama iwa-a kaye ran kɨbumgbazhu ku si wan.&lt;&lt; Bachi, zon wen&gt;&gt; Ka tre.<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Ka tre riwu ri,&lt;&lt;Aran bi nowa no yawu ri riwa miri ran.&gt;&gt;<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />&lt;&lt;Een, Bachi,&gt;&gt;Iwa-a ka tre,&lt;&lt;Kau yawu ngawen wa ri juzhu ri riwa a ku zhu ri kpanchi tiko wan.&gt;&gt;<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Imba Yeso ka tre riwu ri, &lt;&lt;Iwariko, yosron wen senkpa! Ikya riwa wu mɨyen wa no wu.&gt;&gt;Imba lilo vira wan ka kɨre.<verse eid="MAT 15:28" /></para>
  <para style="s1">Yeso a no Nji ngo nza ri</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Yeso ka wurunde rimba ran hu nyu nne Galili. Ran hon tu gashi ran kuson ri meme. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Ikpanji kigbu waka ye riwu, waye ri wawa wana tambereri wa gbolo gon, ri wa nfyen, riwa hanton ri ngbɨron wari kigbu wa kawa ki ri kusi wan ka den wa kpa chuwo.<verse eid="MAT 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 15:31" />Hari nji waka ti sisɨri riwa wato wa hanton wa tre inga wawa wana ti kpɨreran wana dzren,wa mfyen waka ran to tsu, wawumba waka gbresan nde Izhi ri Lsraila.<verse eid="MAT 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Yeso ka yo miriko wan ran tre riwa ri,&lt;&lt;Inji wanyi wa lowen sron, ritu ivi mba ri tɨra ruwa riwa wa he rɨme rinyi iwa wana he ri ikya riwa wa ri ran. Me ran su miri nowa hi ngamba ri iyon ran, nowa ran ku nyiren ri nkon ran.&gt;&gt;<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Imiriko Yeso waka tre riwu ri,&lt;&lt;ko ki fe jujuyɨmo bran ri minyi ri ji nyi riwa ki no kpanji wanyi nowa ri?&gt;&gt;<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Yeso ka miyen wa, &lt;&lt; Imkpon bren nye bi he ri wu?&gt;&gt;</para>
  <para style="p" vid="MAT 15:34">&lt;&lt;Imkpon tangban, waka la wu Nga vi lambe fiwen.&gt;&gt;<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Imba Yeso ka la ri kpanji nowa ki ri meme. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Imba ka ban ŋkpon tangban ri lambe-a, ran ngiri, ran chu wa wa ran ka no miriko wan, wa ka kpa ran ga nji. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Wawumba wari hwɨshi, hari wari vu ngbɨron jɨujɨu wan shu sisen tangban riwa wa ri don ngbron. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Wawa wari-a wa han ngo nza ban de mba ri miri mba.<verse eid="MAT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39" />Riwa a kanji chuwo, a wurunde gra ri nvu ima ran ka hi ri meme magadan.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">Iwa to kya riwa wato</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Wa nji Farisa ri Sadukiyawa wa ye ri Yeso wari tsra-u nga wari mɨye ri no tsro wawa kyawa ri shu. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Yeso ka tre riwa ri, &lt;&lt;Inde yawulu ti, bi tre,&lt; Ishuwulu ri he samban, ikpawulu ri sɨren,&gt; <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Ri imbɨre ka bi to ishuwulu sɨren, bi ya tre,&lt;Luwa iwulu ri ti wo.&gt;Bi ya to bibi riwa ishuwulu he, ama bi ran ya to bibi kya wa zizan ran. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Biyi meme nji wa zizan, wa ri amana, wa su wari to alama kyari, ama ikyari ran he riwa wa tsro wa ran, ara bibi kya riwa Yohana.&gt;&gt;Imba ka kawa don ran hi ngawan.<verse eid="MAT 16:4" /></para>
  <para style="s">Mumu ri kpakpi fu riwa Farisa ri Sadukyawa</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Riwa wa ru nne-a hi gran mu, imiriko wan waka ti wurusu ri jujuyɨmo. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Yeso ka tre riwa ri. &lt;&lt;Ti rere, mɨlan ya mumu wa Farisa ri Sadukiyawa riwa ari kpa kpi fu.&gt;&gt;<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />Waka tre ri kamba ri, &lt;&lt;A he ritu kiran ngɨzhi jujuyɨmo kya ye ran.&gt;&gt; <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />Yeso ka mɨyen wa, &lt;&lt;Milan ya tre mba, biyi wa wa ikpanyime mbi he fiwen, ritu ngye ko bi tre ri kambi ritu riwa bi ran he ri jujuyɨmo ran? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Hari zizan bi ran to ran, bi ran taka nkpon jujuyɨmo ton riwa nji ngo ton, nga sisen ngbɨrebɨren riwa bi vu kaburu? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Ka nkpon jujuyɨmo tamgban riwa ki no ji ngo nza, nga ngbɨrebɨren riwa bi vu shu ri sisen ki? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />A he rise ko bi ran to ri me ran ri tre riyi ritu jujuyɨmo-a ran? Ama bi milan ki ritu mumu ri fu kpi Farisa ri Sadukyawa?&gt;&gt; <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Imba imiriko wan waka to ri a ran ri tre riwa ritu nowa milan ya mumu riwa ari kpa kpi fu riwa wa nji Sadukya ri Farisa ran, ama ari tre riwa ritu bibi tsro mba ri che riwa wa tsro.<verse eid="MAT 16:12" /></para>
  <para style="s">Bitrus a tre ritu Yeso he ngha</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Riwa Yeso a ye ri meme kaisariya Filibi, imba ka miyen miri ko wan ri, &lt;&lt;Nghan nye biyi bi tre ri ivren nji he?&gt;&gt;<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />Waka tre riwu ri, &lt;&lt;Wari wa tre ri wuhe Yohana riwa ari son nji ri ima, wari ri wuhe Iliya, ama wari wa kamba ri tre ri wuhe Irimiya ko kuma rimi wawa wa la tre Izhi.&gt;&gt;<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />&lt;&lt; Ko biyi fa?&gt;&gt;Ka miyen,&lt;&lt;Bi tre ri me he ngan?&gt;&gt; <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />Ngha Bitrus ka tre ri, &lt;&lt;A wu wuhe kristo, ivren Izhi riwa ari vɨri.&gt;&gt; <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />Yeso ka tre riwu ri &lt;&lt;A wu wuhe nji ri tilɨbu, a wu Sima ivren Yonana, a ran he nji nye a lawu tre nyi ran, a he Ti won riwa a he ri shu. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Nga me lawu ri wa yo-u ri Bitrus nga ritu tita nye me mme tɨra bre Izhi, nga nkon Hades a ran senkpa han ran. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Me no-u ronronkon ri kpanchison shuwuru; ko ngye riwa bi lo-u rɨmeme ari kri kamba ri shuwuru, inga kya riwa bi si-u ri meme, wa si-u ri shuwuru.&gt;&gt; <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Imba ka gbi wa vunvuton iri nowa ran la njo ri wawu nye he kristo ran.<verse eid="MAT 16:20" /></para>
  <para style="s">Yeso a la tre kuu wan</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Tu chachu mba ban kusi Yeso ka gbuchi ran la mirindu wan ri a he dole no wawu no hi Urushalima ran soya ritu kyawa riwo wa rinkon, wa rinkon wa la tre Izhi nga ri wawa wa tsro tre doka Musa, nga iri dole wa wuu wawu ama ari ti vi tɨra ran tashɨme. <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />Bitrus a ban wu hi ri gran ran ŋŋro-u. &lt;&lt;Onhon, Bachi.&gt;&gt;Ka tre. &lt;&lt;Ikya nyin ran ti-u ran!&gt;&gt;<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Yeso a kɨma ran tre ri Bitrus, &lt;&lt;Tsirinkon donwen, shetan! A wu wu he ŋkpon tita ri kɨbu za ri mo; wu ran he ri kya riwa Izhi rimi sron wen ran, ara kyawa wa nji.&gt;&gt;<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Imba Yeso ka tre ri mirindu wan ri, &lt;&lt;Inde nji riwa ari hu wen, dole no kawan ri ngawan ran ban konkron wan riwa wa kpan wu riwu ran huwen. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Inji riwa ari wa ran kpa ngawan chuwo a ran fe wu ran, ama nji riwa a ran fe rai wan ritu won ari fe wu. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Bi wan ri he ngye wu fe kyawa wa ngbungbɨlu me nyin wawumba, wuri ran fe ivɨri wen ran? Ko ka wu ban ngye nye sran ivɨri wen? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Ivren nji ri ye ri gbre Ti wan ri miriko wan, Ari no ko ngan ife ri ndu wan ri bibi kya riwa ko ngan ti. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Me layi kpunji tre, wari wawa waki nyi wana to kuu ran hari no Ivren Nji no ye rimi kpanchison wan.&gt;&gt;<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">Isran Kpa Yeso</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Kugon vi tanren Yeso a ban Bitrus, Yakubu, nga Yohana vayi Yakubu ran ngɨzhi wa hon hi gashi riwa a zen bran, waka hon kyumba. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Imba nye ka sran kpa wan kusi mba. Isi wan ka kpan ka ji, itsro wan ka kpan kinklan ka kpan wuru. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Imba wa ka to Musa nga Iliya, wa ran tre iwa Yeso.<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />Bitrus ka tre ri Yeso ri, &lt;&lt;Bachi, a bi nota ki he ri nyi. Inde wuto a bi, me ti bru ti tɨra ri wame, iri wa Musa nga Iliya.&gt;&gt;<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Riwa a he rimi tre, ikpan wuru ka kɨshu wa ti, nga ran tre ka zhu ri kpawuru ran tre,&lt;&lt;Ri nyi a he vren won, riwa me nyɨme wu; ri wu me fe sisron. Sɨrenton ri wu!&gt;&gt;<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Riwa miri ndu wa wo nga nyi, wa ka ku susi ri me, sisiri ka ti wa. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Ama Yeso ka ye ran bre wawo. &lt;&lt;Wurunde,&gt;&gt;A tre&lt;&lt; ran ti sisiri ran.&gt;&gt; <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Riwa wa ya shu, wa ran to njo ran ara Yeso.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Riwa wa ran ye ri gashi, Yeso ka tre riwa ri, &lt;&lt;Ran la njo kya riwa bi to ran, tse chachu riwa Ivren Izhi a wurunde ri bubu gyuru.&gt;&gt;<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Mirindu wan waka miye ri, &lt;&lt;Ngye nye wa tsro doka Musa ri no Iliya no gbuchi ye?&gt;&gt;<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Yeso ka tre ri, &lt;&lt;Bi milan to, Iliya riwa ari milan kongye ti. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Ama ame me layi, lliya riga ye-e, ama wa ran to-u ran, ama wa ti kya riwa wasu riwu-e. Rimi nkon riri nye ivren nji ri soya ri womba.&gt;&gt; <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Imba nye imirindu wan waka to ri ari tre riwa ritu Yohana nji riwa ari sonji tu ri ima.<verse eid="MAT 17:13" /></para>
  <para style="s">Ikpa Vɨran riwa a he ri Lilo Bɨzhi Chuwo</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Riwa wa ye ri kpa nji, nji ri ka chiwi ye ri Yeso ran kɨbu ngbazhu kusi wan. <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />&lt;&lt;Bachi, ya vren won ri si lo sron.&gt;&gt; A tre, &lt;&lt;Ari ku kpinkpi, ari to ya bran. Ari ye ka ku ri wuru ka rimi ima. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Me ngɨzhi-u ye ri mirindu wen, wa ran to den chuwo ran.&gt;&gt;<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />&lt;&lt;Yeso ka tre riwa ri, biyi wawa bi ran kpa nyime ran nga wa sentu wa ndzan nyin,&gt;&gt;Yeso ka tre,&lt;&lt;shitan me son ri yi? shitan me vu sron ri yi? Ngɨzhi vren mba ye ri me.&gt;&gt; <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Yeso ka tre fu ri meme bɨzhi, nga ibɨji-a ka zhu jo rikpa vren-a, ka fe sii ri bubu wan.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Imba imirindu wan waka ye ri Yeso ri yayibi wari miye ri, &lt;&lt;Ingye ti ko kita kiran to dzu bɨzhi zhu ran?&gt;&gt;<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />Ka tre riwa ri, &lt;&lt;Yosron mbi he fiwen, me layi kpunji tre, ka yosron a tsra wɨlo su, bi to la ri ngbɨlu, chiwi rinyi hi mmu nga ari chiwi hi. Ikya ri ran han gbengbren wen ran.&gt;&gt; <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />Ama, bibi nyin a ran zhu ran tse ri bre Izhi nga vulaima.&gt;&gt;<verse eid="MAT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Riwa waye kabruri Galili, ka lawa ri, &lt;&lt;Wa ban Vɨren nji no wa riwo nji. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />Wa wuu-u. Nga a ari tashɨme ri vi ri tɨra.&gt;&gt;Imirindu wan waka ti shnji sron.<verse eid="MAT 17:23" /></para>
  <para style="s">Nkɨren meme ri ko Izhi</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Riwa Yeso nga mirindu wan wa zhu ri gbu kafarnaum, wawa wa kpa nkɨren meme wa ye ri Bitrus wa ri mɨyen,&lt;&lt;Wa tsro tre mbi wa ran ri han nkɨren ri ko Izhi ran?&gt;&gt;<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />&lt;&lt;Een, ari han,&gt;&gt; A nyime.</para>
  <para style="p" vid="MAT 17:25">Riwa Bitrus a ye rimi ko, Yeso ka gbuchi tre ri. &lt;&lt;ltaka wen he ngye Sima?&gt;&gt; A miyen.&lt;&lt;Ri ngha nye wa chu wa meme wa kpa ndu nga nkɨren ri wa miri mba ka ri wari? &gt;&gt;<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />&lt;&lt;Bitrus ka tre riwa ri,&gt;&gt;</para>
  <para style="p" vid="MAT 17:26">Ka nyime,&lt;&lt;Waka chu miri joo,&gt;&gt;Yeso ka lawu <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />&lt;&lt;Ama ritu riwa kiran kpa sɨromba time ran, hi ri nchon nne wuri yongɨron, Ban Lambe riwa wu gbuchi vuu; wuri bu nyu wan wuto bibi nkɨren. Ban wu ka nowa ri nkɨren wa mo ri wa me.&gt;&gt; No wa.<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Rinkon ri Kpanchison ri Shu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Ri vi riwa imiriko Yeso wa ye riwu wari miye ri, &lt;&lt;Ngha nye wa to nkpen wan rimi shu wuru?&gt;&gt;<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />Yeso a yo vi vren ri ran ban wu lawa ri. <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />Me layi kpunji tre: &lt;&lt;Inde bi ran sran bi ri he ka imiri wa tsitsa nyi ran, bi ran gra ri ko Izhi ran. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Nji riwa a ka ngawan yo ka vren nyi wawu nye rɨe rinkon ri kpanchison ri shu.<verse eid="MAT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 18:5" />&lt;&lt; Nga nji riwa a kpa vi vren nganyi rimi nde won, a kpa wen. <verse eid="MAT 18:5" /><verse number="6" style="v" sid="MAT 18:6" />Ama inde njo yo miri wa tsitsa wawa wa nyime wen ri meme ti ari bi no wa ban tita nɨran lo-u ri to wari ban wu tayo rimi ron ima ri chon ne.<verse eid="MAT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />&lt;&lt;Iya mgbumgburu mme ritu kya riwa ari yo nji nowa ti meme ti! kyawa wanyi wa ye ama iyya nji riwa kyawa wanyi wa dzu riwo mba nye ye! <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Inde iwo ka iza wen ri yo-u no ti meme ti, a bi wu ka chu wu joo. Ari bi riwu no ran he ri wo hari nga ikpɨre hari ran wuri gra riko Izhi riwa wu he riwo ama wu ran fe gra ri ko Izhi ran, waka ta-u yo ri wuru ri gbuchi. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Inde isi wen nye ri nowu no ti meme ti, kyen-u chu taga, ari bi riwa wu gra ri ko Izhi ri si riri riwa wu gra ri si hari ama waka ta-u yo rimi wuru.<verse eid="MAT 18:9" /></para>
  <para style="s">Ikɨbu tre ntɨma riwa a kado</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />&lt;&lt; Me layi, nojo ran yɨme ran tsɨri ri rimi miri wanyi ran me layi, wa ndu Izhi ri mi shuwuru bla vi wa ya si Ti won riwa a he ri shuwuru. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />Don bi to Ivren Nji ye ritu riwa ari kpa kya riwa a kado chuwo.<verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />&lt;&lt;Inde nji he ri twan sse-wuru, nga ri rimimba kado, a ran ka sse-chuwa don chu wa chuwo ran hi wa ririmba ye ran? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Inde a fe ririmba, me layi a ri ti kinklan sron ri riri mba han sse-chuwa don chu wa riwa wana kado ran. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Bibi wan yen Ati mbi riwa a he rishu a ran bi no ri rimi miri watsitsa no time ran.<verse eid="MAT 18:14" /></para>
  <para style="s">Vayi riwa a ti meme ti ri vayi wan.</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />&lt;&lt; Ka vayi wen vren ron ti meme ti riwu, wu ka wa-u hi biyi imbiwu, wuri lawu, inde a wo wu, wu kpa chuwo nyemba. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Ama inde a ka wan ri wo-u, wu ka no nji ri ko nji hari no wa wo yi don no wa wo zon-u don nowa he hari ka tɨra, <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Inde a kawo wa, wuka la wa hu Izhi, inde abrukawan ri wo kau wa hu Izhi wuka kɨmau-ti meme nji.<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />Me no-u ronronkon ri kpanchison shuwuru; ko ngye riwa bi lo-u rɨmeme ari kri kamba ri shuwuru, inga kya riwa bi si-u ri meme, wa si-u ri shuwuru.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />&lt;&lt;Nganga, me layi, inde biyi harimbi bi bre ritu kya riri Ati won riwa a he ri shu ri ti riyi. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Inde bubu riwa nji hari ka itɨra waki ri tre rimi nde won, me he ri wa.&gt;&gt;<verse eid="MAT 18:20" /></para>
  <para style="s">Ikɨbu tre nji riwa a ran ri Iosron ran.</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Bitrus ka wa Yeso ye ran miye ri &lt;&lt;Bachi, nkpa bren nye riwa vayi won ri ti meme ti rimo ko me ki ka meme ti wan chuwo ri wu? Iso tamgban?&gt;&gt;<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Yeso ka kpa nyɨme ri wu, &lt;&lt;Me la wu a ran he iso tamgban nkankshe ran, a he so se tamgban don tamgban.<verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />&lt;&lt; Wati misali kpanchison ri shu Izhi ri bibi chu riwa a hi bubu bla kpi wan riwa a ke riwo nji riwa a he vren ko wan. &gt;&gt; <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Riwa a gra bla, nji riwa wa hu talenti ngo wuru wa ngɨzhi wu ye ri wu. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Riwa a ran to han ran, nji wa ari hu ka tre ri no wa vu wa mba wa ri miri wan ri kya riwa a he ri wu no wa vu rewari kpa han ila wan.<verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />&lt;&lt;Imba ivren kowan ka kɨbu mgbazhu kusi wan. Ran bre wu.&lt; vu sron rɨme,&gt;&lt; Me han-u kongye.&gt; <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Imba, nji ri kowan ka lo sron riwu ran tre wu ri no wurunde hi kawan, wawu ka don ri wu.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />&lt;&lt;Ama riwa vren kowan a hi kawan, ran ka fe nji riwa wawu ri hu kɨren dinari ngo se wuru ran pɨwan ngɨzhi ran gra gbi wu ri,&lt; Han wen kya riwa me hu-u.<verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />&lt;&lt;Imba lkpan wan ka kɨbu mgbazhu ran bre wu,&lt; vu sron rɨme, me han-u.&gt;<verse eid="MAT 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30" />&lt;&lt;Ama nji ka kawan ran ngɨzhi ka tren ri tɨra riwa wa tren nji ara a han nkɨren a kɨre. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Riwa ngbromba wawo kya riwa a ti wari ka ila nji ri kowan kya riwa a ti wawu ritu riwa isron mba a time.<verse eid="MAT 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32" />&lt;&lt; Imba, nji rikowan ka yo-u gra rimi.&lt; Ran tre ri a wu meme nji,&gt;Ran tre,&lt;Me ka ila riwa me hu-u chuwo wu ritu riwa wu bre wen. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Wuri ran lo sron ri kpan wen bibi riwa me lo sron ri wu ran?&gt; <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Iguko wan ko ti fu ran kau ti wa mmo riwo no wa no ya hari tse a han ila riwa a ri-a wawu.<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />Yeso a kre tre nyi ri&lt;&lt;Bibi nyi nye riwa A ti won riwa a he rishu ri ti ritu ko ngha, tsede inde wu ka vayi wen chuwo gra ri sron.&gt;&gt;<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">I wu Gran</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Riwa Yeso a kre tre wan, ran wurunde ka Galili don ran hi meme Judiya ri ku gran nne Urdu. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Imba ikpanji waka wau ye, ka den wa chuwo ri bubu wan.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Wa nji Farisa wari waka ye ri wa riwa wa tsra-u. Wa miyen-u ri, &lt;&lt;A bi no nji no wu gran wan ritu ko meme ti ngye riwa iwa wan ti?&gt;&gt;<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />Yeso ka la wa ri,&lt;&lt;Bi ran bla to zari ran, Iri ri mimilan Izhi a ti wa mba ronron,? <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />Ran tre,&lt; ritu nganyi nye nji ri ka ti wan mba yi wan don ran ka kawa ngha ri wa wan, ngamba wa he ka nji riri&gt; <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Imba wa ran he hari ngana wa riri. lkya riwa nji ka kabru, no njo no ran ga wa ti nkan ran.&gt;&gt;<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />&lt;&lt; Ingye nye ti, wa ka miyen Musa a de doka ri noji no de mbe ri wu gran ri wa wan ran dzu jɨo ri ko?&gt;&gt;<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Yeso ka tre ri, &lt;&lt;Musa a no yi nyime no yi dzu mba mbi ritu kpekpe sron mbi. Ama a ran he kamba ri mimilan ran. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Me layi ri inde nji riwa a dzu wa wan, tsede ritu a ran ti kya riwa no wa no ti ri ko gran ran, ran gran wa risa a kiru ri wa nji.&gt;&gt;<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Imiri ko wan waka tre riwu ri &lt;&lt;I kya nyi rɨe ngayin ritu wa mba ronron, ari bi nowa ran gran ran.&gt;&gt;<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Yeso ka tre riwa,&lt;&lt;Aran he ko ngha nye ri kpa tre nyi ran, ara wawa wa kpa nyɨme riwu. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Wari wa ki ri wɨlo ritu ngɨzhi wa kamba; wari ronron wa ti wa kamba; nga wa ri ti kamba kyumba ritu kpanchison ri shu. Inji riwa ari kpa ri nyɨn no kpa.&gt;&gt;<verse eid="MAT 19:12" /></para>
  <para style="s">Imiri wa tsitsa nga Yeso</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Imba wa ka ngɨzhi miri watsitsa ye ri Yeso no ti rɨbu dindi sro ran riwa ama miriko wan waka tre fu ri wawa wa ngɨzhi wa ye.<verse eid="MAT 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14" />Imba Yeso ka tre ri wa ri &lt;&lt;Ka miri wa tsitsa chuwo nowa ye rɨme, ran dzu wa ran, ritu kpanchison ri shu he wa bibi mba nye.&gt;&gt; <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Imba ka ti rɨbu dindi sro wa ran hi ngawan.<verse eid="MAT 19:15" /></para>
  <para style="s">Ivɨerenze Riwa a he ri Wo</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Imba nji ri ka ye ri Yeso ran mɨye-u ri, &lt;&lt;Nji ri tsro, ngye dindi me ti riwa meran vɨri ba son vɨri?&gt;&gt;<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />Yeso ka miyen ri,&lt;&lt;Ritu ngye nye wu miyen nji riwa a bi? &lt;&lt;ara nji riri nye riwa a bi. ka wu wa wu ri gra ri bubu wan wuka hu tre riwa Izhi tre.&gt;&gt;<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />&lt;&lt;Wa tan nye?&lt;&lt; Nji-a ka miyen.</para>
  <para style="p" vid="MAT 19:18">Yeso ka la riwu ri,&lt;&lt;Ran wunji ran, ran kru ri wanjo ran, ran yɨwi ran, ran la kya riwa wu ran to ran. <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />no wa ti wen mba yiwen mkpen,Ngha wuri nyime wa kusan wen bibi riwa wu yɨme tuwen.&gt;&gt;<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />Inji-a ka tre ri, &lt;&lt;Me ti wa wawumba, Ngye don ri mo?&gt;&gt;<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Yeso ka tre riwu ri, &lt;&lt;Ka wu wa wuri he jɨyan jɨyan, hi, wuri vu kya riwa wuhe riwu ka rewuri ka no wawa wa ran he ri kya ran, wufe bubu riwa wu zi kpi ri shu. Wuri ye, hu wen.&gt;&gt;<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />Riwa ivren ndze a wo tre-a ka hi ngawan rimi fu, ritu a he ri wo. <verse eid="MAT 19:22" /><verse number="23" style="v" sid="MAT 19:23" />Imba Yeso ka tre ri miriko wan ri &lt;&lt;me layi kpunji, ari he ri ya riwa nji riwa a he riwo no gra ri ko Izhi. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Nganga me layi, a ri he ri ya no lamkpron gra zhu ri bwo yɨwe riwa nji ri wo no gra ri ko Izhi.&gt;&gt;<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Riwa imiriko wan wa wo tre-a wari ti sisɨri bran bran,wari miyeu ri, &lt;&lt; ko ngha nye ri nnawo?&gt;&gt;<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Yeso ka ya wa ran tre ri &lt;&lt;Inde a he ri nji a ran ti ran, ama inde ri Izhi nye ko ngye ri he hɨri.&gt;&gt;<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Bitrus ka tre riwu ri,&lt;&lt;Ki ka kongye mbu don ki ri huu! Ngye nye riwa kita ki fe?&gt;&gt;<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Yeso ka tre riwa ri, &lt;&lt;Me layi kpunji tre ivi ndzan wa sisa, riwa Ivren nji ri son ri kpanchi riwa wana gbresan, biyi wa wa bi huwen bi son ritu kpanchi wuru don hari bi ri ran bla tre riwa nji wa Israila. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Nga nji riwa a ka ko don ka miri vayi ronron ko mirimba ko Ti, ko yi ko miri ko wan meme ritu won ari fe bibi wan so se wuru, ran fe son hari hi rinkon kuu wan. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Ama wari wa wa wa ri gbuchi wawa nye wa ri kugon, wawa wa ri kugon wai ri gbuchi.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">Wa ndu ri zhu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />&lt;&lt; Kpanchison ri shu a he bibi nji ri ko riwa a zhu ri mbambɨre ran vuu wandu no wa tindu ri wu ri zhu klonkɨron ri ro. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Yeso a yɨme iri wawu ri no wa kɨren dinari riri ri ji ran tru wa hi ri zhu wan.<verse eid="MAT 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3" />Ri kɨrefi chu wa ka zhu ran ka to wari waki kuklu rinyu richu. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Rantre riwa ri &lt;Biyi hi riwa rizhu won ngawen, me han yi kya riwa a tsra.&gt; <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Imba waka hi Ka bru zhu nganga ri ji ri kɨrefi hari, ran bru ti kamba me. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Riwa yawulu a ti ka bru zhu ran fe ka wari wa ki, ran miyen wa &lt;Ingye ti ko bi ki kuklu kuu ji?&gt; <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />Wa ka tre riwu ri,&lt;Ritu riwa injo ran vu ta ndu ran.&lt;Biyi nga wen hi bi ri ti ndu ri zhu won.&gt;<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />&lt;&lt;Riwa yawuru a ti, nji ri ri ma ka tre ri nji riwa a ka zhu chuwo ri wo wan,&lt; Yo wandu wuri han wa nkɨren ndu mba, gbuchi ri wa wa waye kugon hi riwa wa wa ye gbuchi.&gt;<verse eid="MAT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9" />Wandu wa wa waye ri kɨrefi hari waka fe kɨren dinari yiyiri ko ngha mba. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Riwa wa wa wa vuwa ye ri mimilan wa yonga wa wa wa kpa han wa wa waye kugon, ama wa ka kpa bibi riri me. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Riwa wa kpa nkɨren-a wari gra ti fu rnji ri rɨma-a. <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />&lt;Wanyi watindu ri awa riri, watre ri ki tindu kuu ji pii ki so yaa iji hu-ta.&gt;<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />Ka kpa yɨme ri ri imi mba,&lt;Ikpan won wo&gt;, ra tre ri&lt;Me ran sen-u ran. yo me tsra reriwu ritu dinari riri <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Kpa nkren wen wuri hi kawen. Ame me yɨme me ri no wa wa waye kugon bibi riwa me no-u. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Me ran heri gbengbren riwa me ti kya riwa meti ri nkɨren won ran? Ka wu tifu ritu dindi ti won?<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />&lt;&lt;Wawunye ri gbuchi ri he ri kugon, ri kugon ri he ri gbuchi.&gt;&gt;<verse eid="MAT 20:16" /></para>
  <para style="s">Yeso a La Ku Wan nganga</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Riwa Yeso a ran hi Jerusalem, wa ka zɨren iwa mɨriko wan wuru-don-hari ran yowa ri gran ran tre ri, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />&lt;&lt;Ki hi ri Jerusalem, wa ka vren nji reri rinkon wa ti ndu Izhi nga wa tsro doka. wa wuu <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />wari kɨwan-u hi ri wawa wana to Izhi ran no wa ti-u ndan wari tsɨ wari kpan-u ri konkron. Ri mi vi ri tɨra a ri tashɨme!&gt;&gt;<verse eid="MAT 20:19" /></para>
  <para style="s">Ibre riwa ya</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Imba iyi mɨri Zabadi kaye ri Yeso ri mɨri wan, wari kɨbu ngbazhu, kusi wan wari bre wu.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />Ka miyen wa ri,&lt;&lt;Bi wa ngye nye?&gt;&gt;</para>
  <para style="p" vid="MAT 20:21">Iwa-a ka tre ri,&lt;&lt;Me wa no zon mɨri wanyi rimo no ri no son ku wotawen iri ka son kuwori wen ri kpanchison wen ri shu.&gt;&gt;<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />Yeso ka tre riwa ri &lt;&lt;Bi ran to kya riwa bi bre ran. bi to so vagho riwa me so?&gt;&gt;</para>
  <para style="p" vid="MAT 20:22">Wa ka tre,&lt;&lt; Ri ki to so.&gt;&gt;<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Yeso ka tre riwa ri,&lt;&lt;Bi to so ri mi vagho won, ama ison kuwo ri won ko ka wo ta won ran he ri me ran, bubu wanyi wa riwa A ti won nye mɨlan ti zi.&gt;&gt;<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Riwa miriko wan wuru wa wo kamba wa ri ti ifu ri mirivayi hari bi. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Yeso kayowa kabru ran tre ri, &lt;&lt;Bi to wa chu mbi wawa wana to Izhi ran wa tsro wa gbengbren,wa ye he ki imba wa wa nowa ya. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Aran he kamba ri tsitsunbi ran ama nji riwa ari wa ran he rinkon rimi mbi, le le no he nji riwa ari ti ndu riyi, <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />lnji riwa a ri wa ran he rinkonbi to no he nji riwa a he gran mbi, <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />bibi riwa Yeso ngawen a ye a ran ritu riwa iji wa gbre riwa ran, tsede no wawu mu no ti ndu riwa ri wa, ran bru de tuwan ri tunji kigbu.&gt;&gt;<verse eid="MAT 20:28" /></para>
  <para style="s">Wan nfyen hari wa to tsu</para>
  <para style="r">(Mark 10.46-52; Luke 18.35-43)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Riwa Yeso nga wa miri kowan wa ka Jeriko ran don, ikpa nji waka hu. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Wa nfɨyen hari waka ki kusan kon, riwa wa wo ri Yeso ri hi kawan wari kpagro,&lt;&lt;Bachi, ivren Doda to lo sron mbu.&gt;&gt;<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Inji waka yirawan ngha wari tre riwa, ki mgbi, ama wa ka kpagro mgbanban,&lt;&lt;Bachi, ivren Doda, to lo sron mbu!&gt;&gt;<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Yeso ka kukri ran yo wa.&lt;&lt;Bi wa me tingye riyi?&gt;&gt;A miyen wa.<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />Wa ka tre ri wu,&lt;&lt; Bachi, kiwa Kiri to tsu.&gt;&gt;<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Wa ka lo Yeso sron, ka bre wa wo ri simba mba wa ka to tsu wari hu.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">Yeso a Gra ri Urushelima</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Riwa wa ye weweren ri urushelima wa ye ri Betafaji, bubu iwa wa yo Tita zaitun, ivren Bachi ka ti miri ko wan hari (2), <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />A tre wa,&lt;&lt;gra ri gbu mu ri wa a he kusi mbi, Ri gra mbi bi to lakpron wa Lo zi, ri vren wan, Siwa bi ri ngɨzhin ye no wen. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Ka njo miyen yi kya, La wu ivren Bachi no wa jin ye, wa wu kawa chuwo.&gt;&gt;<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Ri nganyi a he no tre ri wa shu igyun ijin ri ndu shi <verse eid="MAT 21:4" /><verse number="5" style="v" sid="MAT 21:5" />&lt;&lt;A tre ivra ri wa gbu zion,to, lchu wen ye ri wu, lele nga a hon lagbron, ran he ku Langbron.&gt;&gt;<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Miriko wan wa hi wa ka ti kyar ri wa a la wa a. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Wa gbi langbron mba vren wan ye ri tro itu wan, ri kpi itu mba. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Igba gbu jin wa stroo tsro wa vuvu kuku ri ri kon. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Ikpa nji riwa wa gbuchi hi wu nga ijin ri wa,wa wu wa kpagro, Hosanna ri tu vren Doda&lt;&lt;Dindi he wa wo ri wa ye ri a Bachi Hosanna he bran bran.&gt;&gt;<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Riwa ivren Bachi a gra ri Jerusalem lgbu wa wu ka stran, wa ka miyen,&lt;&lt;A he ngha nye.&gt;&gt;<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Igbu nji waka nghen wen&lt;&lt;A he vren Bachi ndu nji ri wa a ju Nazare ri Galili.&gt;&gt;<verse eid="MAT 21:11" /></para>
  <para style="s1">Yeso ri ko Bre</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Yeso a gra ri tɨra Izhi ran dzu nji wawa wa ran rekpi wa ka ran re. A ban kpanchi riwa wa ran rewa Kpi ka rega wa sran nkɨren ka su si ran dzu nguu no hi ngamba. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />A he ri ngha ri,&lt;&lt;A tre ri wa,&lt;iko won wa yo iko ri bre,&gt; Ama bi ka wu ti ko wa yibi.&gt;&gt;<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Nji ri nfyen nga nji wa nkpuju ye riwu ri tɨra Izhi, ka no wa sii <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Ama lchu wa bre nga wa to tre wa to kya riwa ri bran riwa a ti nga imiri wa kpagɨro ri tɨra bre, &lt;&lt;Hosana ri tu vren Doda,&gt;&gt;Wa ki kpekpe.<verse eid="MAT 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16" />&lt;&lt;Wu wo kya riwa imiri wayin wa tre?&gt;&gt;Waka miyen Yeso ri.</para>
  <para style="p" vid="MAT 21:16">&lt;&lt;Een,&gt;&gt;Yeso ka nyime, &lt;Wu ran kɨra ran? &lt;Ri nvɨrenyun miri wa tsitsa nga wawa wa ma sisan&gt;&gt;&gt;<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />A kawa don na hi kura gbu ri Batani, ri bubu ri wa a ka kru.<verse eid="MAT 21:17" /></para>
  <para style="s">Iklom mbwa a klu</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Ri bubu bre, riwa aku nkon ri hi gbu, iyon ka ti wu, <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Ka to konkron mbwa riwa a kri kusan nkon, ka hi kusan wan ran ran fe klo kya ri tu wan ran ka ra mvumvu wan. Ka tre ri konkron-a ri wu ran klo ngaran, imba konkron ka kɨlu ran kpo vu vu rega.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Riwa miriko wan wa to kya riwa a ti, a lowa sron.&lt;&lt;A hese konkron kpo vunvu gbagbla.&gt;&gt;<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />Yeso ka la wa, &lt;&lt;Mi la yi kpunji, ldan wu he ri yosron wuran ti shaka ran, wu la konkron wen ri kya mi tre ran, a ran he kyar ri wa bi to kon kono rana, lbi tre no ngblu no wen hi ari wii ti ka kawen ta yo ma a ri he ngamba. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Idan wu nyime, wu kpa kya riwa wu miyen ri bre. &gt;&gt;<verse eid="MAT 21:22" /></para>
  <para style="s1">Wana kpanyime ri tsro Yeso ran</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Yeso a gra ri tɨra bre, ran ran tsro, rinkon wa la tre Izhi nga rinkon jin wa gbu wa ye wu&lt;&lt;Ri senkpa nye wu ti kyar wa nyi&gt;&gt; Wa miyen &lt;&lt;Ngye no wu gbengbren?&gt;&gt;<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Yeso ka tre, &lt;&lt; Mi miyen wu ldan bi la wen kpunji mi la yi ri ngye nye mi ti kya wa nyin. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Yohana ri nji ri son nji tu ri ima-a shu mi yin? A shan shuu ka a shon ri nji&gt;&gt; wa tre ngamba we &lt;&lt;Idan ki tre a shaun shuu, ari miyen ta &lt;ngye ti ki ran nye wen ri wu ran,&gt; <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Yeso ka tre a shan ri jin ki ti sisri jin wa tre Yohana a he ran ndu nji.&gt;&gt;<verse eid="MAT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27" />Wa la ri, &lt;&lt;wa wa wana to ran.&gt;&gt;Wa wu ka tre &lt;&lt; Ame ma me na la yi ri gbengbren ngha mi ti kyar wa yin ran.<verse eid="MAT 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />&lt;&lt;Wu to se? nji ri a he miri hari. ka hi ri gbuchi ran tre lvren won hi ju wu ri ti ndu ri zhu won.<verse eid="MAT 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29" />&lt; Ame me ran hi ran a tre&gt; ka bru tre wawu ri hi.<verse eid="MAT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30" />&lt;&lt;Iti wan ka hi ri vren ri hari ran tre ri wu, ka tre ri me hi ama ka ran hi ran.<verse eid="MAT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31" />&lt;&lt;Imi mirin hari wa nyi, ri tan a ti kyar riwa Iti wan lawu?</para>
  <para style="p" vid="MAT 21:31">Ri gbuchi wa tre,&lt;&lt;Ri gbuchi wa tre. Yeso ka tre ri wa, &lt;&lt;mi la yi janji,ijin riwa ri kpa kɨren meme nga iwa ri wa ari ti ntana wa gra ri ko Bachi ko biyi bi ka fe. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Yohana a ye ri yi ri wa a ri la yi nkon dindi bi yi bi ran nye wen ri wu ran, ama ijin ri kpa klen mema nga iwa ri ti tana wa kpa wu.<verse eid="MAT 21:32" /></para>
  <para style="s">Itre Kɨbu riwa wa ya Juu Njo</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />To itre kɨbu ri nganga wa ti nji rikon ri a ron zhu konkron, ran rawu ran shi juju kagon wan ran kuma men kankan kɨshu wu ti itu gben. A no nji wa riwa ri la wa ran hi gbu wa ri. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Riwa Ivi sɨren a ye huehyure,Riwa nga a ti ka ti gran wan ndu hi wa u wan no wa kpa ma lnabi.<verse eid="MAT 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35" />Wa shu wa vu gran rimi mba wa ri tsi ri wa ri wuri rimi ba wa ri ta ri ri tita. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Ka bru ti wa ri ndu hi han ri gbuchi, wa ka tsi wa nganga. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Ka to ngaba ran ti vren wan ndu hi ran tre, bi to kpen vren won.<verse eid="MAT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38" />&lt;&lt; Ama riwa wa zhu wa to vren nji ri rima wa tre ngamba, Ai rewa ahe vren ri wa ri wa lshu ri he wa ma waka wuu kiri ka shun ti wa bu. <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Wa vu wa ri ban wu taga kuma wa ri wuu.<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />&lt;&lt;To Ati ko wa zhu-a ye ngye ari ti wa?&gt;&gt;<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />&lt;&lt;Wa tre wu&lt;&lt;Ari ti meme ri wa ari kuma wu wa ran ban rɨma no nji riwa ron wa ri no wama chachu vi ri sɨren.&gt;&gt;<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Yeso a tre,&lt;&lt;Agba, bi ran kɨra ri nghan ran A tre, ri wa men wa kamba, wawu gyen he tita ri wa a bi me riwa he ndu ti ban Bachi nyen, Ri ta wa to kya dindi.<verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />&lt;&lt;Mi la yi wa kpan su Bachi ri wo bi no wa gbu wari ri wa wa ti kyar ri dindi. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Ri wa wa joku ritu tita a ri chon kprukpru Ama riwa tita joku ritu wan, wawu nye ri kon ka mumu.<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />A wa rinkon La tre Izhi riwa Farisa wa wo tre ri wa a tre, wato ari tre ri wawagyeu. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Ama wa wawu wa vu, ama wa ti sisiri jin itu wa wa wa ban wu ka ijin ndu Bachi.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Ikɨbutre ri bubu ro gran</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Yeso a bru tre ri wa ri kɨbu nganga, ran tre: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />&lt;&lt;kpanchison ri shu he ka ichu riwa a milan bubu ro ri gran ti ri vren wan. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />A ti nji ri ndu wan ndu no hi ran yo nji wawa a yo wa ye ri bubu ro ri gran, ama wa kamba ri ye.<verse eid="MAT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4" />Nganga a bru ti wa ndu wan wari ndu ran tre, &lt;Hi bi ri la ri wa ki yo wa-a ri ki tiri ki ri gben wa: Lado won nga ntɨwan rigra, wawu, wa milan kongye ti ri gben. Ye ro-a shi.&gt;<verse eid="MAT 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5" />Ama wa kamba, wa ri hi kamba, nji ri a hi zhu wan, nji ri ka hi richu wan. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Mgbron mba wa vu wa ndu wan, wa ri tiwa ya wa ri wu wa. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Ichu a tifu. Ran ti wa lokpa ndu wa hi wa ri tiwa ya wari wuu gbu pienpien. Wa gon ko mba kpukpɨru.<verse eid="MAT 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8" />Iwa ka tre ri gran wan, iro-a fa a bi bran bran, ama nji riwa ki yo wa, wa ran he riwa wa ye ro-a ran. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Hi rimi gbu ri wɨri gbu bi yo nji riwa bi to wa nowa ye ro-a. <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Imba gran wa ka zhu gra ri wɨri ri wɨri wari yo nji wawa wa fe wa wawu, ri wa meme ri wa dindi, imba itɨra gran ka shu ri nji.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />&lt;&lt;Riwa ichu a gra riwa ari to nji wa ro gran, a to nji ri a su tsro ri wa a ran su bibi tsro ri ro gran ran. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Ka tre wu ikpan won, wu ti se wuri gra ri nyi wu ran su tsro ri ro gran ran?&gt;Nji-a ka ran tre kya ran.<verse eid="MAT 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13" />Ichu ka tre wawa wa ye gran nowa,&lt; Lowu wo ri za, wari ta yo ri ra, rimi bu, bubu riwa ari ran yi ri tan nyiri.&gt;&gt;&gt;<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />&lt;&lt;Wayo nji kigbu, ama ngbron mba nye wa chu wa.&gt;&gt;<verse eid="MAT 22:14" /></para>
  <para style="s">Ihan Nkɨren Meme no Kesra</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Farisa wa hi waka shutu ti wa ri tre bibi riwa wa vuu Yeso rimi tre wan. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Wa ti miriko mba ndu ri wu ri nji Hirudus.&lt;&lt; Nji ri Tsro,&gt;&gt; Wa mɨyen,&lt;&lt;Ki to wu he nji ri kpunji. Wu tsro tre Izhi ri kpunji, wu ran la tinkan ran, wu ran ri sɨrenton ko wa he wa ngha ran. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />To la ta kya riwa wu to, a bi ki han nkɨren meme ka no Kaisar kase?&gt;&gt;<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Ama Yeso, a to meme rimɨren mba, ran tre wa, &lt;&lt; Biyi wa gyuru nji Ingye ti bi wa bi ri tsra wen? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Tsro wen nkɨren riwa bi han me to. &gt;&gt;Wa ka no kɨren-a, <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />ka miyen wa, &lt;&lt;Riwa a he wu ngha ri nkɨen nyi? Nga a he nde ngha ri nkɨren nyi?&gt;&gt;<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />Wa tre,&lt;&lt; Kaisar,&gt;&gt; Yeso ka tre riwa, &lt;&lt;To no Kaisar kya riwa a he wa Kaisar,&gt; Bi ri no Izhi kya riwa a he wa Izhi.&gt;&gt;<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Riwa wa wo rinyi wari ti sisiri. waka ka wu don wari ri hi nganba.<verse eid="MAT 22:22" /></para>
  <para style="s">Imiyen ritu Ta-shɨme</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Chachu mba wa nji Sadukiyawa, wawa wa tre, itashime ran he ran, wa ye ri wu, wa ri minye, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />Wa tre, &lt;&lt;Nji ri tsro,&gt;&gt;wa tre ri &lt;&lt;Musa a la ta iri inde nji kuu, a ran ngɨzhi vren ran, vayi wan ka ban wa wan ran ngɨzhi vren riwu: <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Zizan imiri vayi tangban rimi mbu. Ri gbuchi a gran ran kuu, riwa a ran he ri imiri ran, a ka wa wan don ri vayi wan. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Ikya nyi a fe vayi ri han nga ri tɨra, hari hi ri ri tangban. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Ri kre wan, iwa-a a kuu, <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Ri nyi, chachu wulunde, iwa ngha nye iwa ri he rimi tangban? riwa wawu mba wa gran wu&gt;&gt;<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Yeso ka kpa nyɨme,&lt;&lt;Bi yɨwa si bi ran to mbe ngha gbengbren Izhi ran. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Ri tashɨme ko no nji nowa gran ka nowa de gran; wa he ka imirindu Izhi ri shu wuru. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Itre ta shɨme ri kuu bi ran kɨra kya riwa Izhi tre yi ran, <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />&lt;Ame me he Izhi wa Ibrahim, Izhi riwa Ishaku, nga Izhi riwa Yakubu&gt; Wa wu ran he Izhi riwa a kuu ran ama Izhi riwa ari vɨri.&gt;&gt;<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Riwa nji wa wo tre Izhi, nyi wari ti fu ritu tsro wan.<verse eid="MAT 22:33" /></para>
  <para style="s">Inchon Doka</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Riwa Farisa wa wo itre Yeso a no Sadukiyawa wa ki mgbi, wari ka tu mba kabru. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Iri rimi mba a he nji ri wa a to doka bran bran, a tsra wu ri miyen nyɨ.<verse eid="MAT 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 22:36" />&lt;&lt; Nji ri tsro, doka ritan nye han rimi mba?&gt;&gt; <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />Yeso a tre wu:&lt;&lt;&lt;Nyime Bachi Izhi wen ri sron wen nga ri sron wen ri rimɨrewen.&gt; <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Riwanyi nye a he tre ri gbuchi nga doka rigra. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Ri hari he ka wawu: &lt;Nyime wa kusan wen bibi riwa wu nyɨme ngawen.&gt; <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Doka nga wa la tre Izhi wawu klo ki ri tre wa nyɨn.&gt;&gt;<verse eid="MAT 22:40" /></para>
  <para style="s">Kristo he Vɨren Ngha</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Ri wa Farisa wa kabru, Yeso ka mɨye wa, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />&lt;&lt; Irimɨren mbi he se ritu Kristo? A he vren ngha?&gt;&gt;</para>
  <para style="p" vid="MAT 22:42">Wa ka tre,&lt;&lt; A he vren Doda.&gt;&gt;<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Ka tre ri wa ri,&lt;&lt;Ko a he se Doda, ri tre dzu ri wu wa yo wu&lt; Bachi?&gt; Don a tre,<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />&lt; Bachi a tre ri Bachi wo.</para>
  <para style="q2" vid="MAT 22:44">&lt;&lt; Son kuwori won</para>
  <para style="q1" vid="MAT 22:44">tse me ka wa kpanfu wen yo</para>
  <para style="q2" vid="MAT 22:44">ri ndo za wen.&gt;<verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Inde Doda yo wu ri &lt;Bachi,&gt;Ari ti se ran he vren wan?&gt;&gt; <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Ko njo ran tre kya ran, tu chachu mba njo hi ku si njo ran bru miyen wu kyari ran.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Yeso a Fe nton wa Tsro Doka Musa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Imba Yeso a tre ri gbunji nga ri miriko wan <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />&lt;&lt;Nji wa tsro doka nga Farisa wa son ri kpanchi Musa. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Itu kamba bi ti kya riwa wa tre no yi ti. Ama ran ti kya riwa wa ti ran. Ritu wa ran ri ti kya riwa wa tsro ran. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Wa lo kpi ri wa a ron, wa ya bran wa ri tuba wana riwa wari ban jo ran.<verse eid="MAT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5" />&lt;&lt;Ndu mba wa ti ritu no si nji nowa to: wa fon ngha mbe Izhi lo ka klo ri chi gyuru ri nyu tsro mba ari zen ban mme; <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Wa wa bubu son dindi ri bubu ro, nga ri bubu ro nga ri bubu son ri dindi ri tɨra bre Izhi; <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />Wa su no wa ran tre ri wa ri richu nga no wa ran yo wa ri njiriko.<verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />&lt;&lt;Ama ran nyɨme no nji no wa yo yi ri njiriko he riri gyen kuma biyi bi he miri vayi. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Na yo njo ri &lt;A ti&gt;Ri gbungblume nyi ran, ritu a ti he riri nye ri gbungblume. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Ran no njo no yo yi ri wa rikon ran, don warikon riri ki he wu, a he Kristo. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Ama nji riwa he rikon yi, wawu nye ari he gran mbi. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Riwa a ngɨzhi ngawan ye mme wa ndzu wu ban shu, nji ri wa a ka ngawan yo huri wa gbre wu.<verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />&lt;&lt;Iya mbi bi yi wa tsro doka Musa nga Farisa, Biyi wa che! Bi yo nde kpanchison ri shu ri si. Bi kumbi bi ran gra ran, bi ran kuma bi ran no wawa wa su wari gra nowa gra ran. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />Iya mbi, biyi wa tsro doka Musa nga Farisa, bi gra ri ko mba wa kɨbo bi ri gyuru wa ri bre Izhi ri che. wa no ya bran bran.<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />Iya mbi wa tsro Doka Musa nga Farisa , Bi hi zɨren ri mme nga ri nne ri ngu,ama ka a ye riri, bi ka kɨma wu ti hari ko ka han biyi miri meme nji riwa bi he.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />&lt;&lt; Iya mbi, wa zɨren ri wa nfɨen! Bi tre, a ran he kyari ran; ama nji riwa a shiiji ri tita ri nkɨreko Izhi, ari lou ri shiiji wan <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Biyi wa nfyen wa ti nkpran! ngye a han: zinariya, ka iko Izhi riwa tsatsara zinariya (ikɨren)? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Biyi bi tre ngawen, &lt;ka nji riwa a shiiji ri iko Izhi, a ran he kya ran; ama nji riwa a shiiji ri ide ri iko Izhi, a vu <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Biyi wa nfɨyen! Ritan he rinkon: ide, ka iko Izhi riwa ari kpa bubu pisi? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Don kamba, nji riwa a shiiji ri bubu a shii ri ko ngye riwa a he rimi wan. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Ngha nji riwa a shiiji ri tɨra bre han shiiji ri wu nga ri nji riwa a he rimi wan. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Ngha nji riwa a shiiji ri shuwulu a shii ri Kpanchi Izhi nga nji riwa a son to wan.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />&lt;&lt;Iya mbi, wa tsro doka Musa nga Farisa, biyi wa tiche! bi shuu ko de zaka bi ri wa kpi bran bran, ama bi yi wa nyen bi ka kya dindi, ri he tre dindi bi ri he ri wa. Wa nyɨme ri yi. Wa nyi nyen a bi bi ri he ri wu. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Bi yi wa nfyen wa bi gbu nji zeren, bi ta wa meme bran bran, ama bi ran to ran tse bi wa fifi wa nji.<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />&lt;&lt;Iya mbi, wa tsro doka Musa nga Farisa, biyi wa che! Bi ngɨla kugon vaŋɲon mbi nvangho, ama imi wan shu ri ngye ri su tumbi. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Biyi wa nfɨyen wa Farisa! Gbuchi ran ngɨla mi vigba nga nvangho nga ira wan ri ngɨla ngawen.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />&lt;&lt;Iya mbi wa tsro doka Musa nga Farisa nga wa che! i he ka bubu gyuru riwa wa gban kugon ri nye ari kpan ku ra ama imi wan ri he gigla. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Ari he bibi wan, ri kura wan wu zhu ri nji ka nji dindi ama ri ku ra wan ari he gyuru ri meme ti.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />&lt;&lt;Iya mbi, wa tsro doka Musa nga Farisa, Biyi wa gyuru nji! Bi mme bubu gyuru ri nji ri la tre Izhi nga bi ri milan wu ti nji ri dindi ti. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Ngha bi tre, ka ki ri vi wa timbu,ki ri ran yo wo ri wa rimi wuu wa la tre Izhi ran. <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />A to bi la tre ritu ngambi ri bi he miri wawa wa wuu nji ri la tre Izhi. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Imba bi hi bi ri kre kya riwa wa ti timbi wa gbuchi ti!<verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />Bi yi wa manzɨrama! Biyi wa meme manzɨrama! Bi tise bi ri jɨbu ri ka yi sro ri wulu, <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Ritu ngayin me tru wa la tre Izhi nga wa wiwɨri nga wa tsro. Warimba bi wuu wa bi ri kpan wa ri tu konkron; nga wari mba bi tsi wa ri tɨra Izhi mba nga bi ri dzu wa ri gbu hi ri gbu. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Ritu wen bi he wa ti tsɨri yii riwa wa ka rega ri gbungblume, ri yii wa tsɨri Habila hi ri yii ri Zakariya ivren Berikiya, riwa wa wuu ri tsutsu Ko Izhi nga iko Izhi <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Me layi kpunji tre, ikya wa nyi wa ye ri nnzan nyi.<verse eid="MAT 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />&lt;&lt;Biyi Urushalima, Urushalima, Bi yi wa wu nji wa la tre nga bi ri cho wawa wa ti wandu ye ri yi, nkpu bren me wa miri vu miri mbi kɨshuti ri bubu ri, ka kuko riwa a vu miri wan kishuti ri ngban wan, ama biyi bi ran su ran. <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Tomba, njo ran he ri mi ko wen ran. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Ame mi la yi, bi ran bru to wen ngaran, tse chachu riwa bi tre, &lt;dindi ri hu nji riwa a ye rimi nde Bachi.&gt;&gt;<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">Yeso a la bibi Zii riwa ari fe Ko Izhi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Yeso a ka ko Izhi don ra zɨren ran hi ngawan imiriko wan waka ye ri wu wa ri yo hankeli wan hi ri mme wan. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />&lt;&lt;Bi to kya wa nyi wawu mba?&gt;&gt;Yeso ka mɨyen. &lt;&lt;Me la yi kpunji, ngbɨretita ri ran kri ritu ri ran; wa tru wa rega mme wawu.&gt;&gt;<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Riwa Yeso a son A son ritu Tita zetun mba miriko wan waka ye, riwuri kankshe, wari tre,&lt;&lt; La ta, shitan nye kyawa wanyi wa ti? Ngye ri to ri nyi nye ki to kiri to ri iye wen ye, nga kre nzan?&gt;&gt; <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />Yeso ka nyɨme:&lt;&lt;Mɨlan ya ran no wa gyuru yi ran. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Ritu gbunji wa ye rimi nde won, wari tre, Me he Kristo,&gt; Ngha wa gyuru wari kigbu. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Bi wo tre kuu nga juju tre kuu, ama to wa mba bi ran milan ki ran. kyawa wamba dole wa ye,ama ikɨre wan ran ye ran. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />lgbu wa wa nga kpanchi mba kpanchi. Igɨju meme nga ri he ko kutan. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Wawu kya wanyi wa he ilo ngɨzhi ri mimilan.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />&lt;&lt;Wa vu yi ka no wa nowa tiyi ya hi ga kuu mbi,nga gbungblume wa kamba ri yi ritu won. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Ri vi mba Ikpa nji wa kɨma don nkon ri yosron nga wa ka ngamba rewari ran kamba ri ngamba, <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />ikpa wa la tre Izhi wa che wa zhu wari gyuru kpanji. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Ritu ti meme ti mbi, isu wa wari ri gbron rere, <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Ama nji iwa a son kpen hi klo wan a ri nanwo. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Wa tretre Bachi kpan chi shu ri gbungblu nji no wa wo wawu nye lvi ri kre (matsanaciyar waala iya bran bran.)<verse eid="MAT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />Kawa imbi to kya meme ndu ri de shan ri wa Annabi Daniye a la &lt;&lt;Wa kɨreri wu wu ri bubu Tsra Tsra ri jin ri kana a to.&gt;&gt; <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />Iwa tse jin ri wa wa ri meme Yudiya wa tsutsu gra itu tita. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />No njo rimi ko wan ran ran hi mimi tɨra ran ban kya zhu rimi ko-a ran. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Ran no njo ri ra no bru hi ran ban kya wan ri ran. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Iya mbi biyi wa mba riwa bi he nne nga wawa wa no miri sisan! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Bre ritu no tsutsu ri vi mba no ran he chachu son viri ran. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Nji wa so ya ri chachu mba nga ikya ri ran ti nganyi ngaran. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Mba wa fon vi fiwen ba, njo ranvu yɨba ran. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />Ri vi mba Ka njo tre yi, &lt;Ya, ngye won! ko &lt;Ngye ŋnga wu won! ran kpanyɨme ran.<verse eid="MAT 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 24:24" />Ritu Kristo wa che nga wa la tre Izhi wa che wa ye wari ti kya wa ti sisiri ritu wari gyuru kau ri wawa wa chu wa. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />To, me la yi gbagbla.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />&lt;&lt; Ka njo la wu, &lt;Ngye ŋnga wu ri mu wu ri mu won,ju rimi itsu kuklu,&gt; Ran ju ra ran; ko &lt;ngye ŋnga wu won rimi tɨra,&gt;Ran nyɨme wu ran. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Ka ishan wulu riwa ari zhu ri kusio nnzan ari kpan hi ri kusi yawulu, kamba nye ari he ye Vɨren Nji. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Bubu riwa ikɨmo he, bubu wan nye iziboka wa ki.<verse eid="MAT 24:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />&lt;&lt;Ri bubu wan meron kugon ya ri vi-a</para>
  <para style="q1" vid="MAT 24:29">&lt;&lt;iji ri gra ri bu,</para>
  <para style="q2" vid="MAT 24:29">iwua ran kpan ngaran;</para>
  <para style="q1" vid="MAT 24:29">ntsen shu wa zhu ku ri mme,</para>
  <para style="q2" vid="MAT 24:29">nga ishu rina chu ngawan.kpan<verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />&lt;&lt;Ri vi mba alama ri ye Vɨren Nji ri ye zhu ri shu, nga gbungblume ti shnji sron. wa to Vɨren Nji riye zhu ri shuwulu, ri gbengbren ri nkpen. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Ngha ari ti miriko wan ndu ri nvɨri ngbuju yo, nga wa vu wawa a lawa ki gran ri gran nza, ju ri kɨreri shu hi kuri wan.<verse eid="MAT 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />&lt;&lt;Ban za bibi klo mbwa. ka wu to ka ari kɨbu nga vunvu wan wa gbuchi ri ye ra mba wuka to ri isu ye hyure. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Ko ri kamba, ka wu to kya wamba, wuka to ri a ye hyure, ye ri nyun nkon. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Nganyi mi la yi lvi in na kado ran tse kyar wa yin a ti <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Ishu ri meme wa yitu ama itre won ran yitu ran.<verse eid="MAT 24:35" /></para>
  <para style="s">Injo na to vi ko chachu ran.</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />&lt;&lt;Ba nji riwa a to chachu vi ko awa, ko miriko wan ri shu, ko Ivren wan, ama tsede Iti wan, <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Bibi riwa a he ri vi Nuhu, ngamba nye ari he ri chachu riwa Ivren Nji ri ye. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Ri vi kami no ima no vu nji, nji wana ri wari ran so, hari hi ri vi riwa Nuhu a gra rimi nkpon konkron riwa a shen. <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />wa ran to ri ikyari kamba ri ti ran tse chachu riwa ima ka ye ran vu wa hi ngawen. Nghamba nye iye Vɨren Nji ri he. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Ronron hari wa he ri zhu wa ban ri wari ka ri hari wan don <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Imba hari wana kon niran wa ban ri wari ka ri wa ka ri hari wan don.<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />&lt;&lt;Ritu kamba bi milan ki ritu bi ran to chachu riwa Bachi ri ye. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Ama ri to ri mba: Ka njiriko ran to vi ri tsuitsu chu riwa nji ri yɨbi ri ye ri ko wan, riwa milan ya no wa ran gra riko wan wari yɨra ko-a ran. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />A wu ngawen wu milan son, ritu Ivren Nji ri ye ri vi riwa wuran yo sron ran.<verse eid="MAT 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />&lt;&lt;Ŋnga he ri kpunji nga ri wiwɨri nji ri ndu, riwa njiriko ka wu yo rinkon wa ndu ri ko wan no nowa ri vi riwa a tsra? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Ari bi ri virendu riwa itiko zhu mu ye ran fe ka ari ti kamba. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Me la yi kpunji, ari kawu yo riko ri wawu kyawa riwa a he riwu. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Ama nowa tre ri ivren ndu he meme nji ran tre ri itiko won ri son ri bubu riwa a hi, <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />Ran gra tsi ngbɨron wa ndu ran ri ran so ri wa so hi. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Itiko ivren ri ndu ri ye ri vi riwa a ran to ran. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Ari chiwa susu ran kawu zi ri bubu riwa wa ti che wa ki, bubu riwa wara yi wari ran tan nghiri.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">Itre kɨbu mirimba wuru</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />&lt;&lt;Ri vi mba kpanchison ri shu ari he ka mirimba wuru wawa wa ran to ronron zari ran riwa wa ban wuru mba wari hi bubu zon ron wa sa nkon. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Iton rimi mba wa he wa timkpɨran nga ton wa he wa wiwɨri. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Wawa wati mkpɨran wa ban wuru mba wa ran sro nye ran. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Wa wiwɨri wa ngɨzhi nye mba ri gbanran kabruri wuru mba. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Iron wasa a wu vi ri bubu ye, wawu mba wa ka ki kumbɨra wari kruna.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />&lt;&lt; Ri tsutsu chu wa ka wo yo:&lt;Ngye&gt;Iro wasa ri ye een! Juu ye bi ri zon-u ri nko!&gt;<verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />Imba mirimba waa wa ka wurunde wari milan wurumba ti. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Wa ti mkpɨran-a wa ka mɨye wa wiwɨri,&lt; no wa ti nye mba no wawa; iwulu mba ri yɨwi.&gt;<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />Wa ka tre ri &lt;onhon,&gt;Aran tsrata wayi ran. Hi bi ri rewa mbi.&gt;<verse eid="MAT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10" />&lt;&lt;Riwa wa he nkon ri hi bubu renye, iron wasa ka ye. mirimba waa wawa wa kɨma ngamba ti wa ka gra riwu rimi tɨra logran. Nga wa ka kankon.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />&lt;&lt;Imba wa ri wa ka ye kugon. &lt;Nji rinkon! Nji rinkon!&gt;A tre.&lt;Bu nkon rita!&gt;<verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />&lt;&lt;Ama ka tre,&lt;Me layi kpunji tre, me ran toyi ran.&gt;<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />&lt;&lt;Mɨlan kambi ki, ritu bi ran to vi wan ko chachu wan ran.<verse eid="MAT 25:13" /></para>
  <para style="s">Ikɨbu tre nkɨren</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />&lt;&lt;Nganga, ari he ka nji riwa ari hi bubu zɨren, ran yo miriko wan ran ka kpi wan tiwa yo. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Iri a no sule ton ri nkɨren, nga ri wan a no sule hari, nga ri sule riri, ri ko ngha ri to wan. Ran hi bubu zɨren wan. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Nji riwa wa kpa sule ton a ka tindu ri nkɨren wan ran fe sule ton sro ngha. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Imba ngawen, nji riwa a kpa sule hari ka ti ndu ri wu ran fe sule hari sro ngha. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Ama nji riwa a kpa sule riri a shi juju ran ka nkɨren nji riko wan ri.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />&lt;&lt;Kugon riwa a ban vi bran nji ri komba ka ye bubu riwa a ri kpa kpi wan riwa. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Nji riwa a kpa sule ton ka fe ton sro ngha. Ran tre, &lt;Nji riko,&gt;,&lt;No wen sule ton. Me fe sule ton sro ngha.&gt;<verse eid="MAT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21" />&lt;&lt; Nji riko wan a tre, a bi, vren riko ndind! Wu to ti ritu kyawa fiwen; Me yo-u rinkon ri kyawa kigbu. ye ti kinklan sron nji riko wan.<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />Nji riwa a kpa sule hari ka ye ngawen.&lt;Nji riko,&gt;A tre,&lt;wu no wen sule hari; me fe hari sro ngha.<verse eid="MAT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23" />&lt;&lt; Nji riko wan ka tre,&lt;A bi vren riko ndindi! Wu kpa nyɨme ri kyawa tsawen me yo-u rinkon kyawa kigbu. Ye ti kinklan sron ri nji riko wen!&gt;<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />&lt;&lt; Imba nji riwa a kpa sule riri ka ye.&lt;Nji riko,&gt;A tre, me to wu he nji riwa wuti bran wu sɨren bubu riwa wu ran chu ran nga wu ka kabruri bubu riwa wu ran sɨra bi ran. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Imba me ti sisɨri me ri ngɨzhi sule wen ka ri ri meme. Tomba, ngye ikya wen een.&gt;<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />Njiriko wan ka tre, &lt;A wu meme nji sankonchi vren riko!&gt; Ashe wu to ri me sɨren ri bubu riwa me chu ran nga me ri ka kabruri bubu riwa me ran sɨra ran? <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />A he riwa wuri ka nkɨren won zi ri wɨron nkɨren, nde me bru ye me ri kpa nkɨren won ri han ngamba.<verse eid="MAT 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28" />Kpa nkɨren mba riwu ka no nji riwa a he ri sule wuru. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Nji riwa a he wu wa no sro ngha, nga ari he riwu bran. Nji riwa a ran he riwu ran, ko kya wa a he ri wu wa kpa ri wo wan. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Ka meme vrenriko mba taga ri ra, rimi bu, bubu riwa wa yi wari tan nyiri.<verse eid="MAT 25:30" /></para>
  <para style="s">Ntɨma nga Yawo</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />&lt;&lt; Inde Vɨren Nji ye ri nkpen wan, nga imirindu Izhi riwu, ari son kpanchison wan ri shu ri nkpen wan. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Mgbumgburu me wa ka bru kusi wan, ari ga nji ti nkan bibi riwa nji ri kɨshu ntɨma ri ga yawo iwa ntɨma ti nkan. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Ari ka ntɨma ki kuwo ri ran ka yawo ki kuwo ta.<verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />&lt;&lt; Imba ichu ri tre ri wawa wa he kuwo ri, &lt;Ye, biyi wa ti won ti luwu dindi sro ri yi; kpa gado mbi, kpanchison riwa wa milan ti zi riyi tu chachu riwa wa ti mme. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Riwa iyon a ran ti wen wu no wen kya me ri, ilama a ran ti wen wu nowen ima me so, me ye tsɨren wu ka yowen gra riko, <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Me ran wa tsro wu ka no wen tsro wen, me ran lo wu ka den wen, me he ri tɨra tren wu ye to wen.&gt;<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />Wa tsitsri wa tre riwu,&lt;Bachi, shitan ki to-u ka iyon riti-u ki ri no-u la, ka ri la ima ki ri no-u ima so? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Shitan ki to-u, wu ye tsɨren ki kpa-u gra riko, ka wu wa tsro ki ka no-u? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Shitan ki to-u ka wu lo nga ka wu he ri tɨra tren ki ri ye tre riwu? <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Ichu ri tre, &lt;Me layi kpunji tre, ikya riwa bi ti rimi miri vayi won riwa a he fiwen, bi ti rimo.&gt;<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />&lt;&lt;Imba ari tre ri wawa wa he ku wota,&lt; tsiri nkon mo, biyi wawa wa la nyu riyi, gra rimi wuru riwa wa ka zi ri meme nji ri miriko wan. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Riwa iyon a ran ti wen bi ran no wen kya me ri ran, ilama a ran ti wen wu ran no wen ima me so ran, <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Me ye tsɨren wu ki ran no wen gra riko ran, me ran wa tsro bi ki ran nowen tsro ran, me ran lo me ri he ri tɨra tren bi ran ye ya wen to ran.&gt;<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />Wa wa ngawen wa tre ri, &lt;Bachi, shitan ki to-u iyon a ran ti-u ka la ima, tsɨren, ka wa tsro ka wu lo, ka wu he ri tɨra tren riwa ki ran ye zon-u ran?&gt;<verse eid="MAT 25:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45" />Ari tre,&lt;Me layi kpunji tre, ikya riwa bi ran ti ri ri rimi riwa a he fifi rimi wanyi ran, bi ran ti ri mo ran.&gt;<verse eid="MAT 25:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46" />&lt;&lt;Imba Izhi ri vu wawa wa timeme ti hi ri bubu so ya riwa a ran yitu ran, ama ari vu wawa wa ti dindi ti nga wa tsitsri hi wa son ri wu riwa a ran yitu ran.&gt;&gt;<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">Wa Rinkon wa shutu ti Ritu Yeso</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Riwa Yeso a kre tre wawu, ran tre ri miriko wan, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />&lt;&lt;Bi to, chachu zagran don vi hari riwa wa de Vɨren Nji nowa kpan-u ri konkron.<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Imba wa rinkon ndu Izhi nga wa rinkon nji wa kabruri ko chu rinkon wandu Izhi, riwa nde wan a he kayafa, <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />nga wa kabrutu riwa wa vu Yeso wari wuu. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />&lt;&lt;Ama a ran he ri vi Ro ran,&lt;&lt; Wa ka tre,&lt;&lt; Nji wa wanyu ran.&gt;&gt;<verse eid="MAT 26:5" /></para>
  <para style="s">Wa gban Yeso Nyen ri Batani</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Riwa Yeso a he ri Batani riko nji riwa wa ran yo-u ri Sima nji ri mkpuzhu, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />imba iwa ri ka ye riwu ri vi mgbu ri ri nye ri mɨuyi raro riwa a ti nkɨren bran, ran ka sro wu tu ka a ran ri ri.<verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />Riwa miriko wan wa to kamba wari tifu wari tre. &lt;&lt;To bibi kpa nkɨren time mu wonri?&gt;&gt;Wa tre, <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />&lt;&lt;A he wa wari ka nye-a rewari ka nkɨren wan no wa ya.&lt;&lt;<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Riwa Yeso a to nganyi ran tre ri wa,&lt;&lt;Ngye ti ko bi kpa sron mbi ri time ritu kya riwa iwa nyi ti? A ti kya dindi nye rimo. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Bla vi bi he ri nji wanyi, ama a ran he bla vi nye ki he iwayi ran. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Riwa a sro nye ri mɨuyi raro ri kpa won nyi, a ti rinyi ritu riwa wa no wen yibi. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Me la yi kpunji tre, bubu riwa wa tretre Izhi ri mgbumgburu me nyi wawu, ikya riwa a ti nyi wa la tre wan, wa ri ran ti ka wan.&gt;&gt;<verse eid="MAT 26:13" /></para>
  <para style="s">Yahuda a Nyɨme riwa ari ka Yeso Re</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Iri rimi wuru don hari riwa wa yo-u ri Yahuda Iskariyoti, a hi wa rinkon wandu Izhi <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />wari mɨyen,&lt;&lt;Bi no wen ngye nde me ka-u noyi?&gt;&gt; Wa bla ngbɨre sule se tɨra no. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Imba Yahuda ka wa nkon riwa ari ka wu no wa.<verse eid="MAT 26:16" /></para>
  <para style="s">Iri ri yawɨru riwa Yeso</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Chachu vi ri gbuchi ri ri ri riwa wa ran sro mumu riwa a ran kpakpi fu ran, miriko Yeso wa ye ri wu wari mɨyen,&lt;&lt; wu wa ki milan bubu tan ti riwu riwa wu riri ri za gran?&gt;&gt;<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Ka tre wa,&lt;&lt;Hi rimi gbu ri nji ri wuri la wu,&lt;Nji ri tsro tre: Ivi won ye hyure. Me hi bubu riri ri za gran ri miriko won ri ko wen.&gt;&gt;&gt; <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Imba imiriko Yeso waka ti kya riwa Yeso a tre nowa ti wari milan ri rizagran ti.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Riwa yawulu a ti, Yeso ka ran riri ri Miriko wan wuru don hari. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Riwa Wa ran ri ri, ka tre,&lt;&lt;Me layi kpunji, iri rimi mbi ri tɨron wen.&gt;&gt;<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Waka ti shnji sron wari ran tre wu yiyɨri, &lt;&lt;Kpunji tre a ran he Ame ran, Bachi?&gt;&gt;<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />Yeso ka tre,&lt;&lt;Nji riwa a son wo ri me rimi vigba ri me wawu nye ri tɨron wen. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Ivren Nji ri hi bibi riwa a he ri ŋnga ritu wan. Ama iya nji riwa ari tɨron Vɨren Nji! Ari bi riwu riwa wari ran ngɨzhi wu ran.&gt;&gt;<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Imba Yauza, riwa ari tɨron wu, ka tre ri, &lt;&lt;Kpunji tre a ran he Ame ran, Nji ri tɨro?&gt;&gt;</para>
  <para style="p" vid="MAT 26:25">Yeso ka nyime,&lt;&lt;Een, a he a wu.<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Riwa wana ri ri, Yeso ka ban jujuyimo ran ngɨri, ran chiwa, ran ka no miriko wan, ran tre,&lt;&lt;Ban bi ri ka ri; rinyi he kpa won.&gt;&gt; <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />Imba ka ban vagho, ran ngiri ran ka nowa, ran tre,&lt;&lt;So rimi wan, wawu mbi.&gt;&gt; <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Rinyi he iyi won ri katredzi,riwa a rega ri nji kigbu ritu ka meme ti chuwo. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Me la yi, Me ran bru so ima riro nyi riyi ngana tse chachu mba riwa Me so ri sisa riyi ri kpanchison tiwon.&gt;&gt;<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Riwa waka chuse, wa ka hi ri gashi Zaitun.<verse eid="MAT 26:30" /></para>
  <para style="s">Yeso a la riwa Bitrus ri Kɨmagon ti wu</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Imba Yeso ka lawa, &lt;&lt;Ri chu nyi wawu mbi bi joku ritu won, ritu a he ri ŋnga: &lt;Me wuru nji ri kɨshu ntɨma, nga igbu ntɨma wa pisi.&gt;<verse eid="MAT 26:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />Ama ka me tashɨme, Me gbuchi ran hi ri yi ri Galili.&gt;&gt;<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Bitrus ka tre wu,&lt;&lt; Ko wa joku wawu mba ritu wen, Ame me ran Joku ran&gt;&gt;<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />&lt;&lt;Me layi kpunji, Yeso ka nyɨme ri, ri chu nyi, kafi no gbako no tɨbu, wu tɨron wen tinkpa tɨra.&gt;&gt;<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Ama Bitrus ka tre wu, &lt;&lt;Ko me kuu riwu, Me ran tɨron wu ran.&gt;&gt;Ngha gbron miriko wan waka tre bibi wan.<verse eid="MAT 26:35" /></para>
  <para style="s">Yeso a Bre Izhi ri Gatsemani</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Imba Yeso nga miriko wan waka hi ri bubu ri wa yo wu ri Gatsemani, nga ka tre riwa, &lt;&lt;Kuki rinyi me hi ri mu miri bre Izhi ri.&gt;&gt; <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Ka ban Bitrus nga miri Zabadi hari hu ngawan hi, nga ran gra ti shnji sron ran damu bran. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Imba ka tre wa, &lt;&lt;Ivɨri won ri so ya bran ri shnji sron hari ke ri nyu kuu. Ki ri nyi bi ri ran ya ri me.&gt;&gt;<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Riwa wa hi kusi, ka ku susi ri mme ran bre Izhi,&lt;&lt;A ti Won, ka ari bi, wuka ban vagho ya nyi jo rimo. Aran ri ti won ran, ama riwa me.&gt;&gt;<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Imba ka kɨma ye ri miriko wan ran ye fe wa ka wa kru nna. &lt;&lt;Biyi bi ran ya ki ran gben rɨme ran ri awa ri ran?&gt;&gt;A miyen Bitrus. <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />&lt;&lt; Mɨlan ki bi ri bre bibi riwa bi ran ku rimi tsra ran. Iyu risu, ama ikpa ran he gbengbren ran.&gt;&gt;<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />A hi ran bru bre Izhi ri nkpa ri hari wan, &lt;&lt;A ti Won, ka wa ran ban vagho ya nyi jo rimo ran tse Me so, no ti wen no ti.&gt;&gt;<verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />Riwa a kɨma ye, ran bru ye fe wa ka wa kru nna, ritu isi mba a ron. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Ka bru kawa don ran hi ri bubu ri nkpa ri tɨra wan, ran bru tre bibi wan.<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />Imba ka zhu iko Izhi ye ri miriko wan nga ran tre wa,&lt;&lt;Bi he rimi kru nna bi ri ki vɨri ri? Ya, ivi ye hyure, nga Ivren Nji wa ka wu no wa meme ti. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Wurunde, bi ye ki! Ngye nji riwa a ka wen nowa chiwi ye een!&lt;&lt;<verse eid="MAT 26:46" /></para>
  <para style="s">Wa Vu Yeso</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Riwa a he rimi tre,Yauza, iri rimi miriko wan wuru don hari, ka ye. Gbunji waka hu ye ri njingban nga ngbolo, wa tiwa ndu zhu ri rinkon w Firist nga wa rinkon wa nji-a. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Nji riwa a ka Yeso nowa-a tre zi riwa, &lt;&lt;Nji riwa me so nyu wan mbari; bi ka vu.&lt;&lt; <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Ri bubu wan waka chiwi hi kusan Yeso, Yauza ka tre, &lt;&lt;Me chi wu, Nji ri tsro!&lt;&lt;Ngha ran so nyu wan.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Yeso ka tre,&lt;&lt;Ikpan, ti kya riwa wu ye ritu wan.&lt;&lt;</para>
  <para style="p" vid="MAT 26:50">Imba nji-a ka chiwi he kusi, ran vu Yeso. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Ri kamba, iri rimi wawa wa hu Yeso a ye ri nji ngban wan, ran ka sɨren nji ri ndu rinkon ri la tre Izhi-a nvunvuto taga.<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />Yeso ka tre ri wu, &lt;&lt;Ka njingba wen yo rimi ko wan,&lt;&lt; &lt;&lt;Ritu nji riwa a wu nji ri nji ngba wawu ri ku ri nji ngban. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Bi yonga meran ya yo tiwon ran, nga ari wo wen ran tru mirindu wan no wa ye zonwen ran? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Ama ka me ti kamba wa ti se wari to kya riwa wa tre ari ti rɨme nganyi?&gt;&gt;<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Ima Yeso ka tre wa ri gbunji ri, ise ko bi ye bubu vu wen ri ngolo ka me he nji ri yɨbi? Ko woni vi me si ye tsro tre Izhi ri tɨra Izhi kuma bi towen ama bi ran ya vu wen ran. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Ama kya wayin he riwa itre wa la tre Izhi riwa a he ri ngha no ye. Imba imiriko wan waka ti fu wari hi kamba.&gt;&gt;<verse eid="MAT 26:56" /></para>
  <para style="s">Yeso Kusi Warinkon</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Wawa wa vu Yeso wa ban wu hi ri Kaiaphas, rinkon Firist, bubu riwa wa tsro doka nga wa rinkon wa shu ngamba ki. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Ama Bitrus ka ran hu ri kpata, hari hi ri ko wawu rinkon Firist. A gra kuson ri wa gben don ran to kya riwa wa ti.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />Wa rinkon wa bla tre nga wa rinko wa ran wa wari fe njo riwa a ri tre ri che ritu Yeso bibi riwa wari wuu. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Ama wana fe wu ri kyari ran, ko riwa wa tre ri che kigbu wa ye kusi.</para>
  <para style="p" vid="MAT 26:60">Ri kre wan nji hari wa zhu ye kusi <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />wa tre,&lt;&lt; Nji nyi tre,&lt;Me ya zi iko Izhi riwa Izhi meri bru mme rimi vi tɨra.&gt;&gt;&gt;<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Rinkon Firist a wulunde ran tre ri Yeso, Rinyi he tre ngye nye riwa nji wanyi wa ngɨzhi riye ritu wen?&gt;&gt; <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Ama Yeso ka son ngbangbi. Rinkon Firist ka tre wu ri,&lt;&lt;Me shiji ri wu ri Izhi ri vɨri: La ta ko a wu nye wu he Kristo, Ivren Izhi.&gt;&gt;<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Yeso ka nyɨme, &lt;&lt;Een, a he bibi riwa bi tire, ama me tre ri yi wawumbi: Ivi ri bi to Vren Nji kuson ri wori riwa Rigrawan riwa Izhi zhu ri shu wulu ye.&gt;&gt;<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Imba nji rinkon wa bla tre ka gbon tsro wan ran tre,&lt;&lt;A tretre meme ritu Izhi! Ritu ngye ko bi wa wa kiri kugon wan ri? Ya, zizan bi wo tre kpande time! <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Ngye bi to?&lt;&lt; Wa nyɨme wari tre, A he riwa ki wu.&gt;&gt;<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Tse wa ju nten bwa ri si, wa ri zɨran wu ri nvɨyeke. Wari kuma wa wuruu <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />wa ri tre&lt;&lt;Tɨrekɨbu rita, Kristo. Ngha nye wɨru wu?&gt;&gt; (Mark 14.66-72; Luke 22.56-62; John 18.15-18,25-27)<verse eid="MAT 26:68" /></para>
  <para style="s">Bitrus a Tɨron Yeso (Mark 14.66A72; Luke 22.56-62; John 18.15-18,25-27)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Bitrus a son ri nkokanran ko riwa wa bla tre-a, tse ivɨra ri ndu ri ka ye ri wu. Ran tre,&lt;&lt;A wu ngawen wu he ri Yeso ri Galili.&gt;&gt;<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Ama ka tɨron wu kusi mba wawu. ka tre, &lt;&lt;Me ran to kya riwa bi tre ritu wan ran.&gt;&gt;<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />Imba ka zhu hi ri nyu nkon, bubu riwa ivɨra ri ka bi ri to wu ran la nji ri bubu wan ri,&lt;&lt;Nji nyi wa he mba Yeso ri Nazaret.&lt;&lt;<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Ka bru tsri-u wu nganga, ri shiji:&lt;&lt;Me ran to nji-a ran!&lt;&lt;<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Kugon fiwen vi, tse wawa wa ki ri bubu wan waka ye ri Bitrus wari tre, &lt;&lt;kpunji tre wu he ri rimi mba, don bibi tre wen a ŋŋran wu yo ra.&gt;&gt; <verse eid="MAT 26:73" /><verse number="74" style="v" sid="MAT 26:74" />Imba ka gbuchi ran lanyu ri ngawan nga ran shiji ri wa, &lt;&lt;Ame me ran to nji nyi &gt;&gt;</para>
  <para style="p" vid="MAT 26:74">Ri bubu wan igbakuko ka tɨbu.<verse eid="MAT 26:74" /></para>
  <para style="p">
    <verse number="75" style="v" sid="MAT 26:75" />Imba Bitrus ka tika tre riwa Yeso a tre:&lt;&lt; Kafi no gbako no tɨbu, wu tɨron wen tinkpa tɨra.&gt;&gt; Ngha Bitrus ka zhu hi ri ra ran yimasi bran.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">Yahuda a Kɨlo Nghawan ri Konkron</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Ri wa mbre a kpan wa rikon w Firist ri wa rikon riko gbu jin wa kuki wa ri tre tu vren Bachi no wan wuu. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Tse wa lo wu, wa ban wu hi, wa kan kawu no chu Bilatu.<verse eid="MAT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Riwa Yahuda riwa wa ka rewu a to Yeso wa fon ban tre ba ri iwa wa wuu ka ban klen ri wa a kpa no rikon w Firist nga gbu wa rikon gbu wawu. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />&lt;&lt;Me ti meme a tre,&gt;&gt; Me reri wamba ran.&lt;&lt;Imba he gye ri ts, wa lawu, imba he kya ri wa a gan wu.&gt;&gt;<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Wawu Yahuda ka ka kɨren sro ri ko Izhi nga ran ka klo ngawan.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />Ichu bla tre ka ban kɨren ran tre <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Kugon riwa a wa ke ri bubu katredzi ritu wan, wa ti ndu ri nkɨren wari re bubu wari kɨma wu ti bubu gru wa gran. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Ika he wa yo bubu a meme yin har luwa. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />A he tre ri wa Jeremiya wan ndu Izhi a tre.&lt;&lt;Wa ban kɨren se tra ri wa tro wu wa jin isɨsrela, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />wa ka kɨren a le meme ri me ri,a ka lkya Bachi a La wu.&gt;&gt;<verse eid="MAT 27:10" /></para>
  <para style="s">Yeso kusi Bilatu</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Yeso a kri kusi rinkon ri gbu nga rinkon ri gbu ka miyen wu, &lt;&lt;A wu chu ri wa nji Yahuda.&lt;&lt;Ame,a he kawu tre,vren Bachi ka tre.<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Ichu priest nga wa ri nkon wa ngyawu ka na no wan giwen rn. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Chu min,&lt;&lt;wu na wo kyar ri wa La itu wen ran.&gt;&gt; <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Vɨren Bachi na sa kya ri wa ran ko kyar wa tre tu wan ran ka no rinkon ri gbu Lo sron.<verse eid="MAT 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Ko ri ro ri dza gran ritan riwa rinkon ri gbu Roma risi ju nji riwa jibu nji wa miyen ri no wa chu chuwo ri tra tren. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Ivi mba wa he ri meme nji wa yibi hari (2) ame Barabas <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Riwa jin wa kabru lchu ka min wa.&lt;&lt;Jin ri tan bi wa mi chu wu sho yi Banaba vren Bachi ri wa wa yo Kristi.&gt;&gt; <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Mi to a he ti ngu ri wa ka vren Bachi no yin.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Nga pilate a son bubu son, iwa wan ka tiw ,&lt;&lt;Na yo wo wen ri tu jin ba iwa a ran ti meme kya ran,mi ti ya ri chu Luwa itu jin ba.&lt;&lt; Ichu nga wa rikon gbu wa min wa gbu no.&gt;&gt;<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Ichu nga wa rikon gbu wa miyen wa gbu no wa tre Banaba no wa chu shon wa ri wuu vren Bachi.<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />&lt;&lt;Wa bru no ritan ri mi hari wa yin no wa chu shon.&lt;&lt;Wa min jin ri kpanchi gbu.<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />&lt;&lt;Mi ti se ri vren Bachi iwa wa yo wu Kristi?&lt;&lt;Wawu ba wa tre no wa &lt;&lt;wuu vren Bachi.&gt;&gt;<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />&lt;&lt;Ngye? Meme gyen a ti?&lt;&lt;Iko ritan a ti gyen meme&lt;&lt;A miyen a ti sen wa kpagro wa ri tre wuu.&lt;&lt;<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Riwa Bilatu a to a ran vu tu mba ran, wa wulude ri wagyun ka to ngamba na tima gla wo wan ku si jin gbu siwu wawu na tre.&lt;&lt;Ame fa,mi shu won no ri yi jin ri wa a ti dindi mba han ruwa bi.&gt;&gt; <verse eid="MAT 27:24" /><verse number="25" style="v" sid="MAT 27:25" />Imba nji waa wawu waka kpa yɨme wari tre,&lt;&lt;Alaki yiwan no he ri tu mbu ri wa miri mbu!&gt;&gt;<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Wa chu Banaba shu wa, Ama wa ki no wa riwa vren Bachi no wa wuu.<verse eid="MAT 27:26" /></para>
  <para style="s">Wa lokpa wa Nza Yeso</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Imba soldiers wa ban vren Bachi gra ri ko chu wa vu gbu jin ki ri wa wa soldier tu ba. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Wa ju kpi ri wu, wa ri ban jangɨlan tsro ri su riwu, <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />wa ri chiwi takala chon, wa ri ka sun wu itu, wa ri ban kpala no ku wu Ri wa ri kɨbu ngbazhu kusi wan, wa ri tir tre kuklu wa ri tre.&lt;&lt;No soror wen kre bran, chu nji Yahuda.&gt;&gt; <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Wa juten stro,wa ri kpa kpala, wa ri wuru tu. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Riwa wa tre kuklu kre, tse wa kan gbon jansla tro, wa tro wa ma su wu, wa ri jiwu hi ri bubu kpau wu.<verse eid="MAT 27:31" /></para>
  <para style="s">Wa kpan Yeso</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Wa kon ri hi, wa ka fe nji ri Sayirin nde wan Sima wawu wa vu ri gbengbren no ban konkron vren Bachi <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Riwa wa ka shu ri bubu ri wa wa yo kuku tu. <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Wa ka ban ma inabi ka vren ri gbanran ri kya ri ri no so, <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Riwa wa kpa wu,wa ka chu tsro wan chawa ga ngamba. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Wa ku ki ri gben wu. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Wa ka kpan konkron ri tu wan wa ri ngha kya riwa a ti, ri wayin he vren Bachi, chu nji Yahuda: <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Wa ka kpa wa yibi hari ri wawu vren Nji ri ku wo ri, iri ku wo ta. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />i wa zeren wana hi wana tre kratu riwa a ran bi ran har ri wutu <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />wana tre,&lt;&lt;A wu ri wa wu tre wu dzi tra bre, wu ga men rimi vi tara (3), sran tuwen mana, Den a wu vren Bachi gɨzhi ye meme.&gt;&gt;<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Ngamba wa rikon w Firist ri nji wa ngha tre Bachi nga wa tsro doka ri kon gbu wana tre ritu vren Bachi ri, <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />&lt;&lt;Kpa wari chuwo nou kpa tun wan chuwo. A he chu lsraila, No gɨzhi ri tu konkron zizan, ki ta ki nyɨme ri wu. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Ka a nyɨme ri Bachi, to,no Bachi no kpa chuwo zizan, ka a tre a nyɨme ri rituwan, Don a tre wa wu he vren Bachi!&gt;&gt; <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Ri nji wa yibi hari ri wa wa kpan wa ri wu, wa na kra wu tu ka jin wana kra wu tu a.<verse eid="MAT 27:44" /></para>
  <para style="s">Ikuu Yeso</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Ri gbege zhi lbu a ka meme gbu wawu hari ye karafin tra tse vren Bachi ka yo na tre gbugblu a ti ngye ti wu ka wen don. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Ivi ri awa chu wa (9) ti vren Bachi kpagro bran bran, &lt;&lt;Na yo Eloi, Eloi, lama sabatani&gt;&gt;Re wa he,&lt;&lt;Bachi wo,ngye ti wu kawen don.&gt;&gt;<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Riwa jin wari wa ki wana wo kya ri wa a tre,&lt;&lt;wa ka tre a ri yo Iliya.&gt;&gt; <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Iwa ri mi hari ka wulunde na ban soso sun ma ri ti ngban, na sun ma ran ka no so na ka no so. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Ngbron ba wa tre,&lt;&lt;kawu chuwo ki ri to ka kiya ri ye ran kpa chuwo.&gt;&gt; <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />Yeso ka bru yi gbangban nga ran chu vri ri kre wan.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Lagba tsro riwa a he nkon ka gbon ti hari ri shu har ye kugbo meme ka giga, ti ta kuma wa ka yara. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Bubu ben bran bran wa ka bu wa dindi riwa wa he ri bubu gru waka wulude ri si. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Wa ka shu bran bran ri bubu ben riwa a wulude ri bubu gru wa ka gra lkpan tsri sri gbu wa ka La jin bran bran.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Riwa ri jin rikon wa gben nga ri wa wa he bubu gben vren Bachi wa to tsiri meme ri kya ri wa a ti,sisiri ka ti wa, wa ka tie,&lt;&lt;ja jin ri yin a he vren Bachi.&gt;&gt;<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Akwai mba wari wa he kpata mu wa ri ya ri wa wa wu vren Bachi ri gbu Galili,wara ti ndu wu. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Rimi mba Meremu Magadaliya, nga Meremu lyi Yakubu nga Yusufu,nga miri Zabadi.<verse eid="MAT 27:56" /></para>
  <para style="s">Wa no Yeso Yibi</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Riwa yawulu a ti nji riwa a he wo nde wan he Yusufu, wawu ma a he miriko vren Bachi. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />A hi chu Bilatu na bre wu no wa ban kowon vren Bachi no roawou, chu Bilatu ko tre no wa ban no. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Yusufu ka ban wu, na ka wu yo ri tsro ri wa wa milan wu ti a gba gbengben, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />a ka wu yo ri bubu gru sisa, ri gun bubu gru, na ka wu. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Maryamu Magadali ya nga ri Meremu wa ku son ku si bubu gru.<verse eid="MAT 27:61" /></para>
  <para style="s">Wa Gben Rinyu Bubu bre</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Ri mbre kugon chachu shiri,wa rikon wa sro yi ri nji Farisa wa ku ki kon Bilatu. <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />Wa tre ri,&lt;&lt;A wu nji rikon, &lt;tika nji ri gyuru nji yin, tun ka he si ka tre kugon vi tra wawu ri wulude ri bubu gru. <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Ki bre wu ritu a tre wawu ku, kugon vi tra wawu ri wulunde no wa gben bubu gru susa na mon miri ko wan no wa ye a wu ran wa ri tre nji ri a wulunde ran lgyuru nji ri kugon rinyi a ri he meme han ri gbuchi.&gt;&gt; <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />&lt;&lt;Bilatu ka tre wa a he ngamba chu wa Lokpa, bi ri hi no wa gben bubu gru bibi senkpa bi he wu.&gt;&gt; <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Wa ka hi waka gben bubu gru, wa ka ngan itu tita, wa kuma stru wa Lokpa no wa gben.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Itashɨme Yeso ri bubu Gyuru</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Riwa chachu son vɨri a vu yɨba, ri vi ri mimilan sati, meremu magadaliya nga meremu riwan, waka hi ri bubu to bubu gyuru.<verse eid="MAT 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2" />Wati gɨzhu meme ri, nga ivren ndu Izhi ri ka ka zhu ri shu ye mme nga, ritu ri bubu gyuru, ran tru tata-a ran kuson ritu wan. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Iye wan a he ka iwɨrinnzan, isɨro wan a he kinklan pɨya pɨya. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Wawa wa ran gben waka ti sisiri wari ki ka ikɨmo.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />Nji ri ndu Izhi ka la mba-a, &lt;&lt;Ran ti sisisri ran, don me to ri bi wa Yeso, riwa wa kpan wu ri konkron. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Aran he ran; a tashɨme.Ye bi ri to bubu riwa a kru. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Bi hi gbagbla bi ri la mirindu wan: &lt;A tashɨme ri kuu nga a gbuchi ri hi riyi ri Galili. Ri bubu wan bi tou.&gt; Zizan me la yi.&gt;&gt;<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Imba mba-a waka wulunde chegbla ka bubu gyuru don, wa ran ti sisiri ama ri kinklan sron, wari tsutsu hi bubu la miriko wan. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Ri bubu wan Yeso ka fe wa.&lt;&lt;Me chi yi,&lt;&lt;Ka tre.Wa ye ri me, wari shɨmo kpɨre ngɨzhi nga wari gbresan wan. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Imba Yeso ka la wa ri, &lt;&lt;Ran ti sisiri ran hi bi ri la miri vayi won no wa hi ri Galili; ri bubu wan wa to wen.&gt;&gt;<verse eid="MAT 28:10" /></para>
  <para style="s">Itre Hi wa Gben</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Ka mba-a wa he ri nkon rɨi, wa gben wari waka hi rimi gbu wari ka la rinkon wa la tre Izhi ikya riwa a ti. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Riwa rinkon wa la tre Izhi wa vu ngamba ki wawa wa rinkon wari kadzi ri, wa no wa klukpa nkɨren kigbu, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />wari lawa ri,&lt;&lt;Bi la ri, &lt;Imiriko wan wa ye ri chu wari yɨwi wu hi ngamba ka ki ran kru nna.&gt; <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Ka itre nyin ke ri rinkon ri meme, ki no sisron kiri kpa yi chuwo ri iya. <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Imba wa klukpa waka ban nkɨren wari ti bibi riwa wa la wa nowa ti. Ngha itre-a ka hi ko kutan ri wa nji Yahuda ye ri vi nyin.<verse eid="MAT 28:15" /></para>
  <para style="s">Yeso a ti Wuru don ri Ndu</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Imba imiriko wan wuru don ri-a wa hi ri Galili, ritu ngbɨlu riwa a lawa no wa hi. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Riwa wa tou, wa gbre wu; ama wari wana nyime riwu ran. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Imba Yeso ka ye riwa ran tre, &lt;&lt;Wawu nkpen ri shu nga ri nme wa kau no wen. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Ritu kamba hi bi ri la wa gbungblu nme, sonwatu ri ima rimi nde Ti nga riwa vren nga riwa iyu tsitsri, <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />nga bi ri tsro wa kya riwa me layi, nga kpunji me he ri yi ko shitan, hi ri vi kre nzan.&gt;&gt;<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>