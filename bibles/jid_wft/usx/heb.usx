<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- BUU</book>
  <para style="h">HEB - BUU</para>
  <para style="toc1">HEB - BUU</para>
  <para style="toc2">HEB - BUU</para>
  <para style="toc3">HEB - BUU</para>
  <para style="mt1">HEB - BUU</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s">Itre Izhi riwa a zhu ri vren wan</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />Ri sen Izhi a tre ri wati wa nji Yahuda rimi nkon nkankan kan nga ri vi nkankankan dzu ri nyu wa la tre Izhi. <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />Ama ri vi ri krenkpen wan nyi a tre ri ta dzu ri vren wan. Dzu riwo vren-a nye Izhi ti kongye wawu nye wa chu ritu no kongye no he wa ma. <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />Ivren wan nye he kpan ri mkpen riwa Izhi kpunji bibi riwa Izhi he wa tsra mba Izhi a ngizhi ko ngye ritu tre riwa a he ri gbengbren kugon riwa a tsri ta zho rimi meme ti mbu ran son ri kuwori wan riwa a he ri mkpen wawu.<verse eid="HEB 1:3" /></para>
  <para style="s">Ivren Izhi han wa miri ko Izhi</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4" />Ri ngamba nye a fe rinkon riwa a han wa miri ko Izhi bibi nde riwa wa no a han iwawu. <verse eid="HEB 1:4" /><verse number="5" style="v" sid="HEB 1:5" />Ritu wa miri ko Izhi ri ran he riwa Izhi ya-u zari ri,&lt;&lt;Wu he vren won nye riwa me he ti wen&gt;&gt;</para>
  <para style="q1" vid="HEB 1:5">Ko ka njo riwa wa tre ri wu ri,&lt;&lt;Me he ti wan wawu ri he vren won.&gt;&gt;<verse eid="HEB 1:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 1:6" />Ama riwa a hi ran ti vren wan ri gbuchi rimi mgbumgblume a tre ri,&lt;&lt;No wa miri ko Izhi wawu no wa no mkpen.&gt;&gt;<verse eid="HEB 1:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 1:7" />Ingye kya riwa Izhi a tre ritu miri ko ri,&lt;&lt;Izhi ri ye ka kɨma wa miri ko wan ti ka nyunguu, nga wa ndu wan wa he ka irɨme wulu.&gt;&gt;<verse eid="HEB 1:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />Ama Izhi a tre ritu vren wan ri,</para>
  <para style="q1" vid="HEB 1:8">&lt;&lt;Kpanchi son wen a wu Izhi a ran kre ran!</para>
  <para style="q2" vid="HEB 1:8">Dindi ti nye he kpala ri wa wu son ri kpanchi wen ri wu.<verse eid="HEB 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 1:9" />Indu ndindi nye wu wa meme ti wu kawen riwu iwawu!</para>
  <para style="q1" vid="HEB 1:9">Ritu ngamba Izhi wan riwa a gban wu ri nye ri kinklan sron nga a no-u mkpen han wa kpan wen.&gt;&gt;<verse eid="HEB 1:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10" />A tre ri:</para>
  <para style="q1" vid="HEB 1:10">&lt;&lt;Zhu ri mimɨlan wan A wu Bachi a wu nye wu dzi nchi gbungblume nga ishu wa he wo ndu wen nye.<verse eid="HEB 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 1:11" />Wa kre ama a wu wu he wa ku nchon ka itsro <verse eid="HEB 1:11" /><verse number="12" style="v" sid="HEB 1:12" />Wu nye wa ka ŋɨma tsro wa sran wa bibi riwa wa sran tsro ri llo ama a wu wuran ri sran ran wa se wen wa ran kre ran.&gt;&gt;<verse eid="HEB 1:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />Izhi a ran tre ri miri ko wan dzari ri,</para>
  <para style="q1" vid="HEB 1:13">&lt;&lt;Kuson ri bubu mkpen kuwori won no wen me no wa kpan fu</para>
  <para style="q2" vid="HEB 1:13">wen dzi ri ndodza wen wuri chan wa ri dza ran.&gt;&gt;<verse eid="HEB 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14" />Kpunji wan wa miri ko Izhi wawu wa hu wu wa ndu nye Izhi ri ye ti wa ndu no wa dzon wawa wa fe kpa chuwo riwa Izhi.<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s">Inchon Kpachuwo</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />Ritu nganyi a he riwa ki ka sron mba ri kyawa wawa ki wo ritu no wa ran gyuru ta ki ka nkon don ran. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />Indu riwa wa ti wa miri ko Izhi ri wa titimbu ye ri ta a fe ta, nji riwa a kawan ri wo-u ko ka a ran tindu riwu ran a fe yaa riwa a tsra ri kawo wan. <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />Ko ki tise kiri fe nchon kpachuwo inde ki ka nchon kpachuwo la wa? Wawa wa wo tre wan wa la ta ri a he kpunji nye. <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />Ngha wawu Izhi nye riwa a la tre wan sron ngan ritu riwa wa la-a ri bibi kyawa no wa don to kyawa wa sisiri kankankan ri ide riwa wu ga dzu riwo wu Tsitsri bibi riwa a ka dzi.<verse eid="HEB 2:4" /></para>
  <para style="s">Kristo riwa a tsro ta Nkon kpachuwo</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />Gran riwa ari ye nyi riwa ki tre ri tu wan zizan a ran he miriko Izhi nye Izhi son ri kpanchi son wan ran. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />Ri ngamba no njo no la ri bubu ri riwa wa ngan tre Izhi ri:</para>
  <para style="q1" vid="HEB 2:6">&lt;&lt;Inji he ngye a wu Izhi hari riwa wu yo rimi rimɨren wen nji he ngye riwa wu mɨlan-u ya nganyi?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />Wu yo rimi rinkon riwa a nghɨren wa miriko wen;</para>
  <para style="q2" vid="HEB 2:7">rimi vi tsawen wu nye-u ri mkpen ri rinkon.&gt;&gt;<verse eid="HEB 2:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 2:8" />Ngha wu ka ko ngye dzi ri ndoza gbengbren wan.&lt;&lt;</para>
  <para style="m" vid="HEB 2:8">A tre ri Izhi ka kongye dzi ri wo nji ikyari ran he riwa Izhi ran hon no nji gbengbren ritu wan ran ko zizan ki ran ri to bibi ri to bibi ri wa nji ri ngɨzhi kpanchi son ritu wa kyawa. <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />Ama ikya riwa ki to nye he Yeso riwa rimi vi tsawen wa yo ri kpanchi riwa a nghɨren wa miri ko Izhi zizan wa nye-u ri mkpen ri rinkon ritu riwa a so yaa riwa kuu ritu wanji wawu ritu ndindi ti Izhi. <verse eid="HEB 2:9" /><verse number="10" style="v" sid="HEB 2:10" />Izhi nye ti ko ngye, wawu nye ri ya ko ngye. Ritu nganyi inde Izhi ri ngizhi miri wan kigbu ye no wa fe mkpen a bi riwa ari no rinkon riwa ari kpachuwo nga mkpen. Ritu Yeso nye ngizhi kpachuwo ye ri nji.<verse eid="HEB 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11" />A tsiri nji ri meme ti mba,nga wawa wa tsiri wa wawu mba wari he ri ti riri. Ritu wan nye Yeso ran ri ti shan riwa ari yo wa ri wa miri vayi wan ran. <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />A tre ri Izhi ri:</para>
  <para style="q1" vid="HEB 2:12">&lt;&lt;Me yo sron won ri Izhi;</para>
  <para style="q2" vid="HEB 2:12">Me gbre nde wen ri kusi nji.&gt;&gt;<verse eid="HEB 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />A bru tre ri, &lt;&lt;Me yo sron ri Izhi.&gt;&gt;Ran bru tre ri,&lt;&lt;Ingye ame nga miri ri wa Izhi no wen wa-en.&gt;&gt;<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />Ritu nganyi, imiri nji wanyi wa he inɨma mba yii, no he riri riwa rimi kpa. Yeso a ti nganyi ritu kuu wan riwa ari wuu nji riwa a he ri mgemgbren kuu ri wo wan wa to meme nji, <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />nga ngamba nye ran sii nji wawa wa klu kuu lo wa hari sisiri nyi kɨma wa ti gran ri son mba. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />Aran he miri ko wan nye ari dzon wa ran, ama igɨzhi Ibrahi nye ari dzon wa. <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />Ritu wan nye wa kɨma-u ti ka miri vayi wan ko ri nkon ritan, ritu ran he rinkon wa Ti Baan, riwa wa kpa nyime ri wu nga ri riwa ari ka nchi nji rimi ndu wan ri Izhi. Ri ngamba nye ri no zhi ri ka meme ti wa nji chuwo riwa. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />Ngha zizan ari dzon wawa wa tsra wa, ritu wawu kyuwan wa tsra-u nga ran so yaa.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s">Yeso han Musa</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />Ritu nganyi imiri vayi won wa tsitsri biyi wawa Yeso yo yi ri shu-a ngawen! Taka ritu Yeso riwa wawu he nji riwa wa ti-u ndu rinkon wa ndu Izhi riwa ki tre ritu wan. <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />A kpanyime ri riwa a chu wu bibi riwa Musa a kpa nyime ri ndu wan rimi wa nji riwa Izhi. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />Inji riwa a mme ko a bi ya han ko-a, ngamba nye Yeso he riwa wa no gbre han Musa. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />Ritu, ko ko ritan he ri nji riwa a mee, ama a he Izhi nye mee ko ngye. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />Musa a kpa nyime ri ndu wan riwa gran rimi wa nji riwa Izhi nga ran ti shada ritu kyawa riwa wa la kusi. <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />Ama Kristo a kpa nyime ritu wawu he vreri wa wa no gbengbren ritu wa nji riwa Izhi kita nga kita nye ki he wa nji wan inde ki kii rimi vu sron kiri ri yo sron rimi kya riwa ki yo sron riwa.<verse eid="HEB 3:6" /></para>
  <para style="s">Ison Vri Riwa wa Hu Izhi</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />Ritu ngamba, bibi riwa Iyu Izhi a tre,</para>
  <para style="q1" vid="HEB 3:7">&lt;&lt;Ruwa inde wu wo raan Izhi,<verse eid="HEB 3:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8" />ran ti mgbimgbi sron riwa bi ri ka wo tre bibi riwa wa titimbi</para>
  <para style="q2" vid="HEB 3:8">chachu riwa wa tsra wen ri ji ran.<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />Izhi a tre ri,&lt;&lt;Ri muu nye wati wa ti mbi wa tsra wen koo riwa wato wandu riwa me ti ise senza.<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />Wawu nye a no wen me ti fu ri wanzan mu me ri tre ri,&lt;Bla vi wa kamba ri me ri sron mba wa ran to wa nkon won ran&gt;<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />Imba me ti fu meri shizhi ri, &lt;Wa ran gra ri bubu son vri won ran!&gt;&gt;&gt;<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />Imiri vayi won ti bi ri to ri no ri rimi mbi riwa meme ti nga ika kpa nyɨme rimi sron wan no noo kɨma gon ti Izhi riwa ari vri ran. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />Ama ran no ngambi tre ri de senkpa ti ndu ri ko vi ritan riwa itre Izhi tre ri,&lt;&lt;Luwa,&gt;&gt; Ritu no ri mbi no ran ti mgbimgbi sron ritu gru ri meme ti. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />Kita wawa ki kabru tu ri Kristo nye inde ikpa nyɨme mbu he mgbemgben ri mimɨlan hi ri kre wan.<verse eid="HEB 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 3:15" />Bibi riwa Imbe Izhi tre:</para>
  <para style="q1" vid="HEB 3:15">&lt;&lt;Ruwa inde bi wo raan Izhi,</para>
  <para style="q2" vid="HEB 3:15">ran ti mgbimgbi sron bibi riwa wa Ti watimbi wa he</para>
  <para style="q2" vid="HEB 3:15">riwa wa wanyu ri Izhi-a ran.&gt;&gt;<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />Wa ngan nye wa wo raan Izhi wa ri kamba ti mgbimgbi ri wu? Ama wawa nye wa he wanji wawa Musa a no nji wa zhu ri meme Masara <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />Wa ngan nye wawa Izhi ti fu ri wa hari tse se-nza? Aran ti fu ri wawa wa ti meme ti, riwa a no wa wa kuu ri mi ji. <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />Wa ngan nye Izhi shizhi ri tu mba iri wana gra rimi son vri wan ran? A he wawa wa ka wo tre wan nye. <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />Ritu nganyi ki to ri ika kpa nyɨme nye no wa ran to gra ri sonvri nyi ran.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />Zizan riwa Izhi katredzi riwa sonvri he ye zizan de ki ti rerebran no ri rimi mbi no ran hon gra ran. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />Ki gbuchi wo tre Izhi ri raro bibi riwa wawa ngawen wa wo, ama itre Izhi riwa wa wo a ran ti ndu kyari ri wa ran, ritu wa ran kpa ri sron riri ran. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />Ama kita wawa ki kpa nyɨme, kita nye ki gra ri sonvri-a kiri ran taka tre Izhi-a riwa ari tre ri,</para>
  <para style="q1" vid="HEB 4:3">&lt;&lt;Imba me ti fu meri shizhi ri:</para>
  <para style="q2" vid="HEB 4:3">&lt;Wa ran gra ri bubu sonvri won ran!&gt;&gt;&gt;</para>
  <para style="m" vid="HEB 4:3">Izhi a tre ngayin ko ri wa a tre ka a ti ndu wan kre tu ri vi ri wa a ti gbungblume. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />Wa ngan ri bubu ri rimi mbe Izhi ritu vi ri tamgban ri:&lt;&lt;Ri vi ri tamgban Izhi a son vri ri mi ndu wan iwawu.&gt;&gt; <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />Ama ye zizan wa bru tre tre-a ri,&lt;&lt;Wa ran gra ri son vri won ran ko tsawen.&gt;&gt; <verse eid="HEB 4:5" /><verse number="6" style="v" sid="HEB 4:6" />Ri sen wa tretre Izhi ri raro ritu son vri nyi, ama wawa wa tre tre-a ri wa ran gra ran ritu riwa wa ran kpa nyɨme ran. To zizan ka ivi he riwa wari wa gra ri son vri nye. <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />Ingye Izhi bru mɨlan vi ri ti riwa a yo,&lt;&lt;Ruwa.&gt;&gt;A tre ritu vi-a nye kugon se kigbu dzu ri nyu Doda bibi riwa ingha tre Izhi:</para>
  <para style="q1" vid="HEB 4:7">Ka bi wo raan Izhi luwa,</para>
  <para style="q2" vid="HEB 4:7">ran ti mgbimgbi sron ran.&gt;&gt;<verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />Wari tre ri Joshuwa a no wa nji Izhi vri nyi, Izhi ran bru tre tre kugon ritu vi ri nkon ran. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />Ri nyi tsro ri ye zizan ison vri ri vi tangban ritu wa nji Izhi-a he ri. <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />Wawa wa gra ri ye zizan ison vri ri vi tangban ritu wa nji Izhi-a he ri. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />Ritu ngamba no ta ki senkpa kiri gra ri son vri nyi. No njo no ran hon fe gra bibi wawa wa ka kpanyɨme ran.<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />Kpunji itre Izhi he ri sii a he ri sen kpa ti ndu isenkpa wan han njingban riwa a he ri nyiri nghɨma hari. Ari tsen gra rimi kpa nji ran ga Yuu imba vri nga wa gbre ri raan tu Hari ari to irimiren riwa a he rimi sron. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />Ikyari ran he rimi kya riwa Izhi ti riwa a he ri ri-ri ri wu ran; ko ngye he ri huo ri kusi Izhi nga kusi gbengbren wan. Wawu nye ki bla kya riwa ki ti sro kusi wan.<verse eid="HEB 4:13" /></para>
  <para style="s">Yeso nye he rinko nji ri ndu Izhi</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />To, riwa ki he ri nchon rinkon nji ri ndu Izhi ari miyen Yeso ivren Izhi riwa a hi ri shu kusi Izhi no ta ki ngiji kpa nyɨme mbu mgbemgben bran. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />Nchon rinkon nji ri ndu Izhi mbu nyi a ran he njo riwa a hon to ku nyiren mbu ran onhon wawu he nji riwa wa tsra-u ri ko nkon ritan riwa wa ye wa ka tsra ta ama a ran ti meme ti ran. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />Ritu nganyi no ta ki vu sron ki ri ye kusan kpanchi son Izhi wato bubu ndindi ti ritu ki ri kpa dzon ki ri fe ndindi ti riwa ari dzon ta ri vi riwa ki wa.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />Wa ye waka chu nchon nji ri ndu Izhi ri mi miri vayi wan nye ritu no ti ndu ri Izhi ri nyu mgbron nji wawu nye ri ti baan ritu meme ti. <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />Tu riwa wawu ri tu wan a he ri ku nyiren ari to hu ri rimi zren mba. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />Ritu ku nyiren wan-a a he riwa no no Ti Baan a ran meme ti wa nji ri kankshe ran ama ritu meme ti wan ngawen. <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />Injo ran he riwa ari chu ndu riwa a bi nyi kyuwan nji ri to he nchon rinkon nji ri ndu Izhi inde Izhi yo wu bibi riwa wa yo Aruna.<verse eid="HEB 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5" />Nghamba nye Kristo ran no ngawan mkpen riwa a he nchon nji ri Ti Baan ran ritu ngamba nye Izhi tre riwu ri,</para>
  <para style="q1" vid="HEB 5:5">&lt;&lt;Wu he vren won ruwa me he ti wen.&gt;&gt; <verse eid="HEB 5:5" /><verse number="6" style="v" sid="HEB 5:6" />A bru tre ri w; Izhi ri ri,</para>
  <para style="q1" vid="HEB 5:6">&lt;&lt;Wu he nji ri Ti Baan hi ri kre wan ritu bibi tre riwa Maikizedek.&gt;&gt;<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />Ri wa Yeso a he ri gbungblume, a bre Izhi ri wa bre ri yii ri bran ri ima si ran bre Izhi ri wa ari to kpa chuwo rimi kuu. Ritu wawu he nji ri wo tre nye rimi sisiri Izhi Izhi a kpa ibrewan. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />Ko riwa Yeso he vren Izhi nye a fe tsro ri wo tre ri nkon yaa riwa a so. <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />Kugon riwa a mɨlason, ran he nchi son riwa kpa chuwo riwa a ran kre ran ri wawa wa wo tre wan. <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />Ritu nganyi nye Izhi a nye-u no he nchon nji riwa ari Ti Baan ritu tre Makizedek.<verse eid="HEB 5:10" /></para>
  <para style="s">Nghɨron ritu kɨma gon ti Yosron</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />Ki he ri kyawa kigbu riwa ki wa ki ri la ritu tre nyi ama a he ri yaa riwa ki ghɨren ri yi ritu riwa bi ran ri chichi to ran. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />Zizan nganyi a he riwa biyi bi ri he wa tsro ama yi zizan bi wa no njo no bru tsro yi sro riwa a he hwɨri dzu ri tre Izhi bi ran tsra riwa bi ri ri riwa a senkpa rina tse ima sisan nkankshe. <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />Inji riwa sisan nye he ri wan a he vren ŋenŋen nye a ran to kya ri ritu tsro riwa a tsra ri na. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />Ama iri riwa a senkpa a he riwa wawa wa gbron wanyi wa wawa wa mima rimi tindu ri rimɨren mba bla vi hari wa to meme nga ndindi ti nkan.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />Ritu nganyi, no ta ki ran hi kusi ri tsro ri gbuchi riwa ki kpa ritu Kristo, riwa ki he wawa ki ti kya kre-kre. No ran he ri hari zizan ki dzi nchi ri tsro ritu ikpanyime ri Izhi, nga ri ka meme ti chuwo ri bi wa kyawa riwa wa ngɨzhi nji hi zhu ri kuu; <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />ri tsro ritu son nji tu ri ima, nga ri yo wo ri ndindi ti, nga riwa tashime ri kuu, nga bla tre ri chachu kre vi. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />No ta ki ban kusi! Nga ingye kya riwa ki ti-en, inde Izhi nyɨme.<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />Wawa wa kɨma gon ti kpanyime mba,a ran he riwa wa bru tre ri no wa ka meme ti mba chuwo ngaran. Wanyi wa ngɨzhi wa ye dzari rimi kpan riwa Izhi,wa fe wa nde bibi riwa shu, wa fe robo mba rimi Yuu Tsitsri; <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />wa bre ro tre Izhi nga gbengbren nzan riwa ari ye-a. <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />Ri ngamba, wa kɨma gon ti kpanyɨme mba! Aran he riwa wa bru tre iri no wa bru tre ri wawa wa ka meme ti mba chuwo ngaran, ritu wa bru kpa vren Izhi nye, wa no shan ri kusi nji.<verse eid="HEB 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7" />Meme riwa ari so ima wulu riwa ari ku bla mbɨre, ari zhu mbe wawa wa de wulo ri wawa wa ron-u, rinyi nye he meme riwa ari kpa ndindi ri ri Izhi.<verse eid="HEB 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 6:8" />Ama inde meme ri zhu ri nchon nga meme giga, a ran bi ran nye mba. Meme nyi Izhi ti hure riwa ari la nyu ri wu. Ri kre wan ari gon wu ri wulu.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />Ama imiri vayi won, ko riwa ki tre bibi tre nyi, ki ran hon he ri nyɨme ri biyi bi kpa ndindi riwa a bi han wawa wa he ikpachuwo mbi. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />Izhi ran he nji meme ran, a ran ka wa ndu mbi riwa bi ti chuwo ran, nga nyɨme riwa bi tsro-u ri vi riwa bi dzon wa hu Izhi ran, bibi riwa bi ri ye zizan <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />Ki wa no yi wawu mbi sonndu senmima ngambi hi ri vi ri kre wan, ritu bi ri fe kyawa wanyi riwa bi yo sron rimi mba. <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />Ran he wa sankon ran, ama ti bibi wawa wa kpanyɨme, kpa kya riwa Izhi katredzi iri wawu ri ti ri wa.<verse eid="HEB 6:12" /></para>
  <para style="s">Ikatre dzi ri kpunji riwa Izhi</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />Ri vi riwa Izhi a katredzi ri Ibrahi, a katre dzi ri shizhi. A zhizhi ri ngawan ritu riwa injo ran tsra ri wawu Izhi riwa Izhi a shizhi ri wu ran. <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />Izhi a tre ri&lt;&lt;Me kadzi ri sron won ri me yo wo ndindi ri yi, nga me no wa gɨzhi mbi no wa kigbu bran.&gt;&gt; <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />Kugon riwa Ibrahi a vu sron bran bran, imba ka kpa kya riwa Izhi a ran katredzi ri wu-a. <verse eid="HEB 6:15" /><verse number="16" style="v" sid="HEB 6:16" />Inji wa ye waka shizhi ri nji riwa a han wawa ri mkpen. Ishizhi ri tsro tre riwa Izhi kadzi dzu ri wo kya riwa ari dzu janyu. <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />Ritu Izhi a wa ran tsro wawa wa ri gado katre wan dzi riwa iti sisiri ran he rimi wan ran, isron wan riwa a ran ri sran-u ran, tse itre wan riwa kadzi-a dzu ri shizhi. <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />Izhi a ti nganyi, ritu kyawa hari wanyi wawa wa ran ri sran wa ran, riwa Izhi ran ri hon nyɨme ri wa ran. Rinyi riwa a he kya riwa a ri fen ta ton, kita wawa ki wulutsu hi ri bubu riwa ki fe kpachuwo, a bi no ta ki yo sron rimi kya riwa ki ngɨzhi-u ri mgbemgben. <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />Iyo sron mbu nyi wawu nye ri kɨri rimi sron mbu riwa ki ran ti sisiri ka i hon yo sron ran. Wawu nye ri gra ri mimi mu, hi kugon nghima tsro rimi tra Izhi ri shu. <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />Yeso wawu nye he ri gbuchi riwa a gra ri bubu nyi ritu mbu, a he nji rinkon ri ndu Izhi ri hi ri kre wan bibi tre riwa Makizedek a tre.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s">Mechizebe Inji ri Ti Baan</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />Mechizebe nyi a he chu Salim nye nga ran he nji ri Ti Baan riwa Izhi ri shu. Riwa Ibrahi a zhu ri bubu riwa a han gbengbren wa chu ngbɨre nza ran ye, Mechizebe ka fe wu ran ti lɨbu sroo, <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />nga Ibrahi ka ri rimi wuru ri kya riwa fe ri bubu ku.(Itu nde Mechizebe ri mimilan a he &lt;&lt;Ichu ri ndindi ti;&gt;&gt; Ngha ritu a he chu ri Salim, inde wan ka he &lt;&lt;Chu ri si sron.&gt;&gt;)<verse eid="HEB 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 7:3" />Mechizebe a ran he ri ti ka iyi ka bubu riwa a zhu ran; a ran he ri chachu riwa wa ngɨzhi-u nga chachu kuu wan ran. A he ka ivren Izhi; a he nji ri Ti Baan ri wawu. <verse eid="HEB 7:3" /><verse number="4" style="v" sid="HEB 7:4" />To bibi rinkon riwa a he mba. Ibrahi Iti wa ti mbu a no iri rimi wuru ri kya riwa a fe ri bubu tiku. <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />Ritu kya riwa doka a tre ri, Igɨzhi Lawi wawa wa he wa Ti Baan nye wa ye waka kpa gbu ri rimi gbu wulu ri wa nji, wa to, ri wo miri vayi mba, ko riwa wawa wa he gɨzhi Ibrahi ngawen. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />Ama Mechizebe, riwa a ran zhu ri bubu riri iwawa ran, a kpa gbu ri rimi wuru riwo Ibrahi, nga ran ti lɨbu sro ri Ibrahi riwa wawu nye wa ka tre dzi ritu wan. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />Ihon vu sron ran he ran, nji riwa ari ti tɨlu sro nji a han nji riwa ari kpa tɨlu. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />Riwa wawa wa Ti Baan ronron wawa wa kuu nye wa kpa iri rimi wuru; Ama riwa Mechizebe, wawa wa vɨri nye wa kpa ri rimi wuru, bibi riwa imbe Izhi tre. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />Nga wa to tre ri Lawi ri tu wan (riwa igɨzhi wan nye a ran kpa Zaka) a de zaka wan hu ri wo Ibrahi. <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />Wa to tre ngamba ritu chachu riwa Ibrahi wa dzon ngamba mba Mechizede wa ran ngizhi Lawi rina, ama a he ri mi nne wa titiwan. <verse eid="HEB 7:10" /><verse number="11" style="v" sid="HEB 7:11" />To bibi ti riwa wa Ti Baan bibi riwa Lawi a ye ri doka Musa bibi riwaq wa no Israilawa. Wa ri tre ri indu wa Ti Baan riwa wa gɨzhi Lawi a ri to ngizhi son tsra ye ran ran he riwa wa Ti Baan wari nkan wari bru ye ran, riwa a he bibi wa Makizedek, a ran bibi wa Haruna ran. <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />Ka ndu wa Ti Baan sran, doka ngawen ri sran. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />Wawu Bachi mbu riwa wa tre kyawa wanyi ritu wan, a zhu ri gɨzhi ri nkan nye. Injo rimi gɨzhi wan a ran ti ndu wa ti Baan to zari ran. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />A he ri rira ri Bachi zhu ri gɨzhi Yahuda; nga Musa a ran tre kya ritu wan ran riwa a ran tretre ritu wa ti Baan.<verse eid="HEB 7:14" /></para>
  <para style="s">Yeso he nji ri Ti Baan bibi wa Makizedek</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15" />Itre nyi a zhu ngaa ri tsu shizhi bran riwa nji ri Ti Baan ri nka a zhu, riwa a zhu Mechizebe. <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />Rinyi a ran he nji ri Ti Baan ritu doka ri ka rimi nkon riwa gɨzhi ran, ama ritu gbengbren ri son riwa nji ran ri kuu ran. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />Itre Izhi a tre ri, &lt;&lt;A wu wu he nji ri Ti Baan riwa wuran kuu ran, ritu dzi tre Mechizebe. <verse eid="HEB 7:17" /><verse number="18" style="v" sid="HEB 7:18" />Wa ka baan ri sen dzi ri gran nye mba, ritu a ran he ri gbengbren nga ka ri ndu ran. <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />Ibaan riwa Musa ran tsra riwa ari no kyari no kri mgban ran. Wawu nye no wa milan kya riwa a bi han riwa ki yo sron ri wu ritu ki ri ye kusan Izhi. <verse eid="HEB 7:19" /><verse number="20" style="v" sid="HEB 7:20" />Izhi a dzi tre nyi ri shizhi. Imgbron wa Ti Baan waka gra ri tindu mba a ran ri shizhi ran. <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />Ama Yeso a he nji ri Ti Baan nye ri shizhi Izhi riwa a shi ri, &lt;&lt;Bachi a gbuchi shizhi, a ran sran sron wan ran: &lt;Bachi a tre ri a wu wu he nji ri Ti Baan riwa a ran kuu ran.&lt;&lt; <verse eid="HEB 7:21" /><verse number="22" style="v" sid="HEB 7:22" />Ritu shizhi nyi nye riwa Yeso a he nji riwa a ka tre riwa a bi han dzi. <verse eid="HEB 7:22" /><verse number="23" style="v" sid="HEB 7:23" />Wa Ti Baan wa sen wa kigbu ritu ikuu ran ri no wa ban kusi ri ndu mba ran. <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />Ama Yeso a ngɨzhi kpanchi wan riwa wa Ti Baan riwa a ran kuu ran, ritu wawu rituwan-a ran. <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />Ritu ngamba a to ti, luwa imbambre, ari kpa nji wawa wa ye hwɨreri Izhi dzu ri wo wan, ritu riwa a ran ri kuu ran, nga ari ban kusi ri bre Izhi ritu mba. <verse eid="HEB 7:25" /><verse number="26" style="v" sid="HEB 7:26" />Yeso nye he rinkon wa Ti Baan nyi riwa ki wa. Wawu nye he nji ri tsitsri; riwa a ran ti meme ti kyari ran, wa chu wu zho rimi wa ti meme ti wari no mkpen han ko ngye riwa a he ri shu. <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />Wawu ran he ka wa rinkon wa Ti Baan mu ran; a ran ri wa Ti Baan bla vi ran, riwa a ran ri tsri ngawan ritu meme ti wan ko ran Ti Baan ritu meme ti wa nji. Wawu a gbuchi Ti Baan wan mkpa riri gyen ri vi riwa a ka tu wa de. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />Ritu iban riwa Musa riwa wa chanchon chu riwa wa Ti Baan ri tsutsu wawa wa ŋeren nye. Ama ika tre dzi riwa Izhi a ka dzi ri shizhi, a ye zhu kugon riwa wa de doka. Ritu ika tre dzi nye wa ka nye vra-a riwa wa kɨma-u ti nji riwa a tsra hi chachu riwa a ran kre ran.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s">Yeso Nyen He Nji ri Ti Baan Ri Ndindi</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />Itu tre mbu iwawu he ri ki he ri rinkon nji ri Ti Baan riwa ari son kuwori kpanchison nji ri mkpen ri shu mu. <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />Wawu rinkon nji ri Ti Baan nyi ri ti ndu ri Tsitsri Bubu riwa a he bubu son zhi riwa Bachi ri tu wan nye ka wu dzi a ran he nji ran. <verse eid="HEB 8:2" /><verse number="3" style="v" sid="HEB 8:3" />Waye wa ka nyee ko rinkon nji ri Ti Baan ritu riwa ari de ide riwa wa de ri Ti Baan. Nghamba nye a bi riwa rinkon nji ri Ti Baan ri wambu no he ri kya riwa ari ka de. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />Wari tre ri a he ri mgbumgblume nye ran ran he nji ri Ti Baan ran ko tsa, ritu nji wa sro wa ran he riwa wana de ide ritu baan riwa wa wa yo, wa Ti Baan wari wa de ide mba bibi riwa doka Musa. <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />Wa Ti Baan wa ye waka Ti Baan ri bubu riwa a he ri Tsitsri riwa a zhu nga bibi riwa a he ri shu. A he ri vi riwa Musa a hi ran ti bru riwa Izhi ri son, wa ŋoron ri, &lt;&lt;To ri wu milan ko ngye ti no zhu kya riwa wa tsro-u ri no ti ritu tita.&gt;&gt; <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />Ama zizan wa no Yeso ndu Ti Baan riwa a bi han bibi riwa ikatre dzi, riwa Yeso ka-u dzi ri tsutsu wa nji riwa a bi han. Ika tre dzi nyi riwa a bi han a bi ritu riwa wa ti-u ri bubu riwa wa bi han. <verse eid="HEB 8:6" /><verse number="7" style="v" sid="HEB 8:7" />Wari tre ri ika tre dzi ri gbuchi, ran ku nyiren ran, wari ran wa riwa a ka hu ran. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />Ama Izhi a to meme ti mba riwa a tre ri, &lt;&lt;Bachi tre ri, ivi ri ye, riwa me milan ka tre dzi ri sisa ti ri wa nji Israila nga wa nji Yahuda. <verse eid="HEB 8:8" /><verse number="9" style="v" sid="HEB 8:9" />Rinyi ran he ka ikatre dzi riwa me ti ri wa titimba ran, ri vi riwa me vu wa me ri hu riwa zhu ri meme Masara. Ritu riwa wana kpa nyime ri ika tre dzi won ran imba me ka wa chuwo, Bachi a tre. <verse eid="HEB 8:9" /><verse number="10" style="v" sid="HEB 8:10" />Ngye ika tre dzi riwa me ti ri wanji Israila kugon vi nyi een, Bachi a tre, me yo baan won rimi sron mba, me ngaan wa dzi ri sron mba. Me he Izhi mba, wawa wa he wa nji won. <verse eid="HEB 8:10" /><verse number="11" style="v" sid="HEB 8:11" />Wa ran wa wari tsro ngamba ran, ko ka no ri no tre ri vayi wan ri &lt;To Bachi,&gt; Ritu wawumba wa to wen, zhu ri tsitsa mba hi ri rinkon mba. <verse eid="HEB 8:11" /><verse number="12" style="v" sid="HEB 8:12" />Me ka meme ti mba chuwo ri wa, me ran bru taka meme ti mba ran.&gt;&gt; <verse eid="HEB 8:12" /><verse number="13" style="v" sid="HEB 8:13" />Riwa Izhi a tre nganyi ritu ka tre dzi ri sisa, a kɨma ri gbuchi ti ri kimo nye mba; nga ko ngye riwa a he ri sen, riwa ari kunchon, a ran ri wu vi ran, ari kado.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s">IgibreRi mgblume Ngha ri Shu</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />Ikatredzi ri mimilan a he ri bibi ti mba ri gbre nga bubu gbre ri ngblume ngawen. <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />Wa ti bru ssri ri tra ri mimilan riwa wa ran yo-u ri bubu ri Tsitsri. Rimi wan nye konkron riwa wa dzi wulu ritu wan wa he nga kpanchi riwa wa ka jujuyimo riwa wa no Izhi ka dzi ri tu wan. <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />Kugon bubu ri han wan riwa wa ka-u ri tsro a he bru riwa wa yo-u ri bubu riwa a he Tsitsri han. <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />Rimi wan wan wa ti bubu ri ri azurfa riwa wa ran gon nye ri miwhi raro nga akpati ri katredzi riwa wa ka-u ri azurfa nga vaja ri azurfa ri manaa ri mi wan, nga kpala Haruna riwa a zhu ri vumvu ri kpa wan, nga tita ri ngan hari riwa wa ngan doka ri tu wan. <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />Ri tu akpati-a kyawa wa he ri tu wan wawa wa he ri mgban riwa a tsro ri gbre Izhi he ri bubu wan, wa bu mgban mba ka bubu riwa wa ka meme tim rega ri nji. Ama zizan ran he vi riwa wa la kongye ran. <verse eid="HEB 9:5" /><verse number="6" style="v" sid="HEB 9:6" />Ingye bubu riwa wa kyawa-a wa he-en. Wa Ti Baan wa si gra hi rimi Tenti bubu ri mimilan bla vi wa ri ran ti ndu mba ri bubu wan, <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />ama wa rinkon wa Ti Baan kakre nye wa gra ran hi rimi Tenti ri mi, nga a ran ti ngamba ri mkpa riri kakre ri se. Ari ban yii riwa ari no Izhi ri nyu ngawan nga meme ti riwa nji wa ti riwa wa ran to ri wawa wa ti meme ti nye ran. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />Iyu Tsitsri a tsro ri rira ritu kyawa wanyi iri nkon hi ri bubu riwa a he Tsitsri han ran bu rina ri riwa Tenti ri mimilan kukri ri nde ri. <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />Rinyi he bibi riwa a ri vi ri zizan. A tsro ri ide nga Ti Baan ri nɨma riwa wa no Izhi ran ri no sron nji ri gbre no tsra ran, <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />tunde wa ti ri iri, iima ri so, nga wa ro ri tsrii. Wanyi wa he bibi ti riwa kpa nye wawu, riwa wa ti tse chachu vi riwa Izhi ri zhu ri doka sisa. <verse eid="HEB 9:10" /><verse number="11" style="v" sid="HEB 9:11" />Ama Kristo a gbuchi ye ka Rinkon wa Baan riwa kyawa wa ndindi riwa wa he ri nyi-e. bru riwa ari tindu ri bubu wan a han nga ran tsra; a ran he tenti riwa nji nye ti-u ran, woto a ran he mgbron ti mgbumgblume nyi ran. <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />Riwa Kristo a gra hu ri tenti-a hi ri bubu riwa a he Tsitsri han, a ran ban yii yawo mba wa buu lando ran Ti Baan ri wu ran; ama, a ban yii ngawan nga ran kpa kpachuwo riwa a ran kre ran ri ta. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />Iyii yawo nga wa buu lando nga nton riwa konkron mba riwa wa shen wa bwa ri nji wa tsafi riwa wa ran he tsitsri ran, nga rinyi tsri wa ran ban zuu mba ri tsafi mba-a zho ri wa. <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />Riwa rinyi he kpunji, ko ari he ri se ri kre riwa Kristo! Hu ri Yuu riwa ara kre ran a ka ngawan no Izhi ka ti Baan riwa a tsra. Iyii wan ri tsri sron mbu ri tsafi riwa a ran dzon ta ran, ritu ki ri hu Izhi riwa ari vri. <verse eid="HEB 9:14" /><verse number="15" style="v" sid="HEB 9:15" />Ritu nganyi Kristo nye he nji riwa a milan katredzi ri sisa ti, ritu wawa Izhi nye yo wa no wa fe tilɨbu riwa a ran kre ran riwa Izhi a la ri wawu ri de. Rinyi ri to he ritu ikuu a he riwa a kpa nji chuwo ri meme ti mba riwa ikatredzi ri mimilan a zhu. <verse eid="HEB 9:15" /><verse number="16" style="v" sid="HEB 9:16" />Ri tre gado ari bi no wa tsro ri nji ri kado-a kuu ri, <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />gado ran he kyari ran ka nji ri gado he ri si ri; tse a kuu ri ko ari ti ndu. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />Ritu wan nye ko ikatredzi ri mimilan a ye tindu ritu a ye ri yii. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />Ri mimilan, Musa a tsro doka ri nji wawu bibi riwa a he rimi doka. Imba ran ban yii yawo imba wa buu lando, ran psi-u ri ima, nga ran ban rikpama mba nfu ntɨma samban ran kan son ran nzii-u ritu mbe doka nga wa nji wawu. <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />Ran tre ri,&lt;&lt;Rinyi nye he yii riwa a lo doka riwa Izhi tre ri ki hu.&gt;&gt; <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />Nghamba nye ngawen Musa a nzii yii-a ri Bru ri Tsitsri-a nga ri tu kyawa riwa wa ra tindu ri wu ran gbre. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />Nghamba nye, bibi riwa Doka tre ri wa tsri kongye ri yii, nga wa ka meme ti riga i wa bwa yii kakre.<verse eid="HEB 9:22" /></para>
  <para style="s">ITi Baan Kristo ban Memeti Rega</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />Kyawa wa mba, wawa wa he bibi riwa wa ndindi wan ri shu, wa tsri wa bibi mba. Ama kyawa wa shu kyumba wa wa Ti Baan wa ndindi han. <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />Ritu Kristo a ran hi ri bubu Tsitsri riwa nji nye ti-u, riwa a he bibi ri kpunji wan ran. A hi ri shu kyuwan, bubu riwa a zhu ri nyu mbu ri kusi Izhi. <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />Rinkon wa Ti Baan wa nji Yahuda a ran hi ri Bubu riwa a he Tsitsri han ri se ri se ri yii nɨma. Ama Kristo a ran hi bubu wan ran ka ngawan de ri nkpu kigbu ran, <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />ritu ran so yaa ti nkpu kigbu zhu ri vi riwa wa ti mgbumgblume. Riwa, zizan riwa inzan ri vi wawu wa ye hure riwa wa kre, a zhu ri nkpa riri meron, ran zhu meme ti hu ri ka ngawan de. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />Ko ngaa ri kuu nkpu ri, nga kugon rimba Izhi ri bla tre ri ko ngaa. <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />Nghamba nye mee wa ka Kristo de ri Ti Baan ritu ban meme ti wa nji kigbu. Ari zhu ri kpu ri han, a ran ritu meme ti ngaran, ama ritu ran kpa wawa wa ki ri gben chuwo.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />Doka nji Yahuda he alama ri kyawa wa ndindi riwa wa ye kusi a ran wawa nye wa he kyawa-a kpunji ran. A he bibi Ti Baan nye wa si sro wa se ri se. Ari he ri se ko Doka ri wa hu ri Ti Baan ri no wa nji wawa wa ye ri Izhi no wa son tsra? <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />I wa tsri wa hu Izhi ri meme ti mba, wa ran he ri meme ti ngaran, nga wa ran ran Ti Baan ngaran. <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />Bibi riwa a he, isro riwa wa sro se ri se a he ritu no he taka ti nji ritu meme ti mba. <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />Ritu iyii buu lando nga wa yawo ran ri ban meme ti zho ran. <verse eid="HEB 10:4" /><verse number="5" style="v" sid="HEB 10:5" />Ritu rimba, riwa Kristo a ran wa ran ye rimi mgbumgblume, a la Izhi ri: &lt;&lt;Wu ran ri wa Ti Baan imba de ran, ama wu milan kpa ti dzi ri mo. <verse eid="HEB 10:5" /><verse number="6" style="v" sid="HEB 10:6" />ITi Baan ri gon wa nɨma ri tenti ritu ka meme ti rega ran ri sii-u sron ran. <verse eid="HEB 10:6" /><verse number="7" style="v" sid="HEB 10:7" />Ngha me tre ri, &lt;Ingye ame-e, Izhi, me ye me ri ti kya riwa wu wa, bibi riwa a he rimi ngan ritu won rimi Doka.&gt;&gt;&gt; <verse eid="HEB 10:7" /><verse number="8" style="v" sid="HEB 10:8" />Ri mimilan a tre ri, &lt;&lt;Wa Ti Baan nga wa de nga Ti Baan riwa wa vanghon ri tu tenti nga wa Ti Baan riwa ari ban meme ti rega a ran ri si-u sron ran.&gt;&gt; A tre nganyi ritu ko ri riwa wa Ti Baan wanyi wa sro wa bibi riwa Doka Musa a tre nye. <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />Imba ka tre ri,&lt;&lt; Izhi ingye ngaa ame-e, me ye riwa me ti kya riwa wu wa.&gt;&gt;Imba Izhi ka ban Ti Baan ri kimo zho ran ka Ti Baan riwa Kristo ri bubu riwa wa he. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />Ritu Yeso Kristo a ti kya riwa Izhi a wa no ti, wa tsrii ta ri wawu ri rimi meme ti ri ide riwa a de kpa ngawan kyuwan ri nkpu riri meron. <verse eid="HEB 10:10" /><verse number="11" style="v" sid="HEB 10:11" />Ko nji ri Ti Baan wa nji Yahuda ritan a ti bibi ndu nyi bla vi nga ran sro wa bibi yii yii-a ri kpu kigbu; ama isro nyi ran ri to ban meme ti rega ran. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />Ama Kristo a Ti Baan riri gyen kakre riwa a ran kre ran ritu meme ti, nga ran son kuwo ri riwa Izhi. <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />Ri bubu wan nye ka gben ara Izhi a ka wa kpan fu wan ki ri ndodza. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />Ri Ti Baan riri-a, a no wawa wa tsri wa-a no wa sonson riwa a tsra riwa a ran yitu ran. <verse eid="HEB 10:14" /><verse number="15" style="v" sid="HEB 10:15" />Ngha Iyu Tsitsri ngawen a tre ritu mbu. Ri mimilan a tre ri: <verse eid="HEB 10:15" /><verse number="16" style="v" sid="HEB 10:16" />&lt;&lt; Bachi a tre ri , rinyi nye he katredzi riwa me ti ri wa ri vi riwa ari ye: me ka doka won dzi ri sron mba nga me ri ngan ri rimɨren mba.&gt;&gt; <verse eid="HEB 10:16" /><verse number="17" style="v" sid="HEB 10:17" />Ngha ka tre ri, &lt;&lt;Me ran taka meme ti mba ngaran.&gt;&gt; <verse eid="HEB 10:17" /><verse number="18" style="v" sid="HEB 10:18" />Ka wa ka wanyi chuwo, ide riwa ari ban meme ti rega ran ri he ngaran.<verse eid="HEB 10:18" /></para>
  <para style="s">No ta ki Ye Hure ri Izhi</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />Imiri vayi won, nkon he huri ri ta riwa ki gra ri Bubu riwa a he Tsitsri Han ritu kuu Yeso. <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />A bu nkon ri sa ri ta, nkon ri vri, hu ri tsro ri ka nkon, ari miyen ikpa wan kyuwan. <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />Ki he ri nji ri Ti Baan riwa iko Izhi he ri wo wan nye. <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />No ta ki ye hɨreri Izhi ri sron kinklan nga yosron ri kpunji, ri sron riwa wa tsri-u rimi sisiri nga kpa riwa wa ngla-u ri ima riwa a kpan. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />No ta ki kri mgbemgben rimi yosron riwa ki la, ritu wawu Izhi riwa a katredzi ran ri sran sron ran. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />No ta ki ran ya ngambu, ki ran dzon ngambu kiri nyɨme ngambu kiri ran ti ndindi ti. <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />Ki ran ka kabrutu ri ngambu chuwo bibi riwa wari wa ti ran. Tsede ki sondu ran nghɨron ngambu, riwa bi to ri ikre vi Bachi ri ye hure. <verse eid="HEB 10:25" /><verse number="26" style="v" sid="HEB 10:26" />ITi Baan ri riwa ari ban meme ti rega ran he ngaran i ki sondu ri ti meme ti kugon riwa wa la ta kpunji. <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />Riwa ki gben rimi sisiri ibla tre riwa ari ye nga chon wulu riwa ari huu wawa wa kamba ri Izhi! <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />Inji riwa a kpa Doka Musa time wa ran losron riwu ran wa wuu-u, ka wa fe shada nji hari ko no wa han ritu wan. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />Ko wawa wa kamba tsri Vren Nji fa? wawa wa ban Iyii katredzi riwa Izhi riwa a tsri wa rimi meme ti? wawa wa kra Yuu ri losron tu? Ya bibi meme yaa bibi tan nye riwa wa no wa! <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />Ritu ki to nji riwa a tre ri, &lt;&lt;Me ti zhula, me bru han&gt;&gt; nga riwa a bru tre ngawen ri, &lt;&lt;Bachi ri bla tre ri wa nji wan.&gt;&gt; <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />A he kya ri sisiri no nji no ku ri wo Izhi riwa ari vri! <verse eid="HEB 10:31" /><verse number="32" style="v" sid="HEB 10:32" />Taka bibi riwa a he ri yi ri sen. Ri vi wa mba, kugon riwa ikpan wulu Izhi a tsro yi, bi vu sron ri yaa riwa bi so, ama iso yaa-a ka ran han gbengbren mbi ran. <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />Ri vi wari wa ran kra yi tu ri rira, wari ran no yi yaa ri kusi wa nji, nga ri vi wari yo sron riwa bi kabrutu ri wawa wa no wa bibi ya nyi. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />Bi so yaa ri wawa wa tren wa ri tra tren nji, nga riwa wa vu yi wa kpi mbi raa, bi vu sron ri ngiri, ritu bi to ri bi he ri kya riwa a han, riwa a ran ri kre ran. <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />Ran ka vu sron mbi chuwo ran, ritu ari ye ri nchon lada. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />A he riwa bi vu sron, ritu bi ri ti kya riwa Izhi rim wa nga bi ri kpa kya riwa a kadzi ri wawu ri no yi. <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />Ritu, bibi riwa imbe Izhi tre ri:&lt;&lt;Aran ban vi bran ran, nga wawu riwa ari ye a ran wuu vi ran. <verse eid="HEB 10:37" /><verse number="38" style="v" sid="HEB 10:38" />Wa nji won wa ndindi ti, wa kpanyɨme wari son; ama ka injo rimi mba kɨma gon, a ran si wen sron ri wu ran.&gt;&gt; <verse eid="HEB 10:38" /><verse number="39" style="v" sid="HEB 10:39" />Ki ran he wa nji wawa wa kɨma gon nga wari kado ran. kita de ki he ri yosron nga ki fe kpachuwo.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s">Yosron</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />No he ri yo sron a he ri no nyɨme ri kya riwa wu yosron ritu wan, no nyime ri kya riwa wu ran to-u ran. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />A he ritu yosron wa nji wa sen nye ko wa fe gbre ri Izhi. <verse eid="HEB 11:2" /><verse number="3" style="v" sid="HEB 11:3" />A he ritu yosron nye ko ki to ri wa ti mgbumgblume ri tre Izhi nye, ritu kya riwa ki to-u wa ti-u rimi kya riwa ki ran ri to-u ran. <verse eid="HEB 11:3" /><verse number="4" style="v" sid="HEB 11:4" />A he ritu yosron nye a no Habila no ti Baan riwa a han wa Kayinu. Ritu yosron wan nye a fe gbre ri Izhi, ritu wawu Izhi kyuwan a nyɨme de wan. Ritu yosron wan nye Habila a kawan tre, ko ri riwa a kuu. <verse eid="HEB 11:4" /><verse number="5" style="v" sid="HEB 11:5" />Yosron nye a no Enok ran kuu ran. Tsede wa ban wu hi ri shu ri Izhi, nga injo ka ran to-u ran, ritu Izhi a ban wu hi shu. Imbe Izhi tre ri Enok a sii Izhi sron ri ko wa ban wu hi ri shu. <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />Inji riwa a ran he ri yosron ran a ran sii Izhi sron ran, ritu nji riwa ari ye ri Izhi tse a he ri yosron ri Izhi he nga ran no wawa wa wa-u lada. <verse eid="HEB 11:6" /><verse number="7" style="v" sid="HEB 11:7" />A he ritu yosron nye Nuhu a wo fe nton riwa Izhi a fen wu ritu kyawa wawa wa ye kusi riwa a ran to wa ran. A wo tre Izhi ran kpan nvuma riwa wawu nga wa ko wan wa jɨbuwo. Ri ngamba nye, iima a vu mgbumgblume, nga Nuhu ka fe ndindi ti ri Izhi riwa a he ritu yosron. <verse eid="HEB 11:7" /><verse number="8" style="v" sid="HEB 11:8" />A he ritu yosron nye Ibrahi a hu tre Izhi riwa Izhi a yo-u no hi ri meme riwa a kadzi ri wawu no. a ka meme wan don, a ran to bubu riwa ari hi ran. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />Ritu yosron nye a son ri meme riwa Izhi a kadzi ri wu. A ran son ri wa bru, bibi riwa Ishaku mba Yakubu riwa wa fe bibi katredzi riri ri-a ri Izhi. <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />Ibrahi a ran gben nchon gbu riwa Izhi a milan-u mme, igbu riwa wa dzi wa nchi mba ri wawu. <verse eid="HEB 11:10" /><verse number="11" style="v" sid="HEB 11:11" />A he yosron nye a no Ibrahi a he a ti, ko ri riwa a kunchon bran nga Saratu ngawen ka ran ngɨzhi miri ran. A kpanyɨme ri Izhi ri a ran ri sran kya riwa a tre ri wawu ri ti ran. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />Ko ri riwa Ibrahi a he ri nkon kuu, zhu ri nji riri nyi wa fe gɨzhi kigbu ka intsen hwa ri shuwulu, wa kigbu ka meme nzan ri nyu ne riwa wa ran to bla ran. <verse eid="HEB 11:12" /><verse number="13" style="v" sid="HEB 11:13" />A he rimi yosron nye wawu nji wanyi wa kuu. Wa ran kpa kyawa wawa Izhi a tre ri wawu ri no wa-a ran, ama ri kpata riwa wa to wa wa ye kpa wa ri nkon, nga wari nyɨme ri wa he tsren nga wa ri gran mgbumgblume. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />Wawa wa tre ngamba a tsro ri wa wa meme ri tumba. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />Wa ran ri sondu taka meme riwa wa kadon ran; wa ri tre ri wa taka, wari fe nkon riwa wa bru kɨma hi ngamba. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />Tsede, a he meme ri shu nye riwa a bi han nye wa ran wa. Ngha Izhi ran ri ti shan ri no wa yo wawu ri Izhi mba ran, ritu a milan meme ri ti dzi ri wa. <verse eid="HEB 11:16" /><verse number="17" style="v" sid="HEB 11:17" />A he ritu yosron nye Ibrahi a ka vren wan Ishaku de ri Ti Baan riwa Izhi a tsra-u. A he wawu Ibrahi nye riwa Izhi a katredzi ri wu, ama ka kawan ran wa ran ka vren wan riri-a de ri Ti Baan. <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />Izhi a tre ri wu ri, &lt;&lt;A he ritu Ishaku nye wu fe wa gɨzhi riwa me katre dzi.&gt;&gt; <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />Ibrahi a yonga ri Izhi ri to ta wawa wa kuu shime nga, wa to tre ri Ibrahi kpa Ishaku zhu ri kuu nye. <verse eid="HEB 11:19" /><verse number="20" style="v" sid="HEB 11:20" />A he ritu yosron nye Ishaku a katredzi ri ti lɨbu sro Yakubu mba Isuwa ritu kyawa wawa wa ye kusi. <verse eid="HEB 11:20" /><verse number="21" style="v" sid="HEB 11:21" />A he yosron nye a no Yakubu a tilɨbu sro miri Yusufu wawu mba ri ko ran kuu. A klo kri ri tu kpala wan ran gbre Izhi. <verse eid="HEB 11:21" /><verse number="22" style="v" sid="HEB 11:22" />A he ritu yosron nye Yusufu, riwa a ran wa ran kuu, ka tre ritu riwa wa nji Israila wa ka meme Masar don, nga ran la wa kya riwa wa ti ri kimo wan. <verse eid="HEB 11:22" /><verse number="23" style="v" sid="HEB 11:23" />A he ritu yosron nye riwa wa Ti Musa wa ka-u rii ri hwa tra kugon riwa wa ngizhi-u. Wa to riwa a bi vren, nga wa ran ran ti sisiri riwa wa kamba ri hu doka chu ran. <verse eid="HEB 11:23" /><verse number="24" style="v" sid="HEB 11:24" />A he ritu yosron nye riwa Musa a gbron, ka wan ri no wa ran yo wawu ri ivren vra chu ran. <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />A chu ran so yaa ri wa nji Izhi riwa ari ri ro ri meme ti ri vi tsawen. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />Ritu a yosron wan ran so yaa ritu Kristo riwa a han kyawa wa ndindi ri meme Masar, ritu a yo si ri kyawa wawa ari fe wa kusi. <verse eid="HEB 11:26" /><verse number="27" style="v" sid="HEB 11:27" />A he ritu yosron nye Musa a wulunde ka Masar don ran ran ti sisiri fu chu. a vu sron ritu a to Izhi riwa wa ran ri to-u ran, ran kawan ri kɨma ya gon. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />A he ritu yosron nye a no no zhu ri ro ri dzagran ran no wa nzii yii wa nkon tra, ritu no Vren ko Kuu no ran wuu miri wa mimilan riwa wa nji Israila ran. <verse eid="HEB 11:28" /><verse number="29" style="v" sid="HEB 11:29" />A he ritu yosron nye wa nji Israila wa ru nchon ne ka wa zren ri meme kuklu; ama riwa wa nji Masar wa wa wari ru, iima ka miyen wa kre. <verse eid="HEB 11:29" /><verse number="30" style="v" sid="HEB 11:30" />A he ritu yosron nye kankan Yeriko a joku kugon riwa wa nji Israila wa zren kagon wan vi tamgban. <verse eid="HEB 11:30" /><verse number="31" style="v" sid="HEB 11:31" />A he ritu yosron nye wa ran wuu Raab iwa ri ntran-a ri wawa wa kamba ri hu tre Izhi-a ran, ritu a milan kpa wawa wa bre ran ya meme Israila. <verse eid="HEB 11:31" /><verse number="32" style="v" sid="HEB 11:32" />Ko me tre ngye ri? me ran he ri vi riwa me tre ritu Gidiyon, Barak, Samson nga Yafta nga Doda nga Samela nga wa Ti Baan. <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />Ritu yosron we ti ku ri meme wawu nga wa ri ri. Wa ti kya riwa a tsra nga wari kpa kya riwa Izhi a katredzi ritu wan. Wa gru wa nyun wa chen, <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />Wa no nzan wulu no yibi, wari no nji mgban ka ran to gra wa ran. Ikpa mba a kuu ama wa no ngamba senkpa; wa senkpa ri nyun ku nga wari han gbengbren wa klukpa wa tsren. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />Ritu yosron wa mba wawa wa miri vayi mba wa kuu wa tashime. Wari, wa kamba ri kpa sontumba, wa kuu ritu de yaa ritu wa ri tashime ri son riwa a bi han. <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />Wa wyen no wari nga wari tsi wari ri gbagba, nga wa ri lo wari ri che wari vu wa hi ri tra tren nji. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />Wa ta wa ri tita, han wari ti hari, wa wu wari ri nji mgban. wari ran kagon ri wa ntan ntɨma ko yawo, wa ran he ri kyari ran, wa ran no wa yaa. <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />Gbungblume ka ran ro ri wa ran! Wa shan ran zren ka wawa iku dzu wa ri meme riwa konkron ko ima ran he ri bubu wan ran nga ri tu wa mgblu, wa ran son rimi ran tita nga rimi wa bwo ri meme. <verse eid="HEB 11:38" /><verse number="39" style="v" sid="HEB 11:39" />Wawu nji wa nyi wa sii Izhi sron ritu yosron mba, ama waka kuu wa ran fe kya riwa Izhi a tre ri wawu ri no wa-a ran, <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />Rinyi a hu ritu Izhi a ka kya riwa a bi han ka dzi ri ta. A ran wa no wa ngizhi wa hi ri son tsra ri nkankshe mba a ran ri kita rimi mba ran.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s">Izhi A ti Mbu</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />Ritu ngamba, ri riwa ki he ri nji kigbu riwa wa tre tre ndindi ritu mbu riwa wa kagon mbu ki. No ta ki chu kya riwa ari a raa nkon ri ta, nga meme ti riwa a ngɨzhi ta mgbemgben, nga ki ri hu kya riwa a he kusi mbu ri yo sron. <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />No ta ki yo si mbu ri Yeso riwa ri wawu nye yosron mbu he ri wu zhu ri mimilan he ri kre wan. A ran chu sron wan zho ritu konkron riwa wa kpan-u ran! Ritu kinklan sron riwa a ran gben, a ran taka ko ikuu wan ri tu konkron ri he kya ri shan ri wawu ran, nga zizan a son ri kuwo ri kpanchi Izhi. <verse eid="HEB 12:2" /><verse number="3" style="v" sid="HEB 12:3" />Taka bibi yaa riwa a so; bibi riwa a vu sron riwa wa meme ti wa kamba ri wu! Ran wu ngambi kpa bi ri chu sron mbi zho ran. <verse eid="HEB 12:3" /><verse number="4" style="v" sid="HEB 12:4" />Ritu yo sron mbi riwa bi kambi ri meme ti ran ke riwa bi chu sron mbi zho no wa wuu yi rina. <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />Bi kpa wulusu ri kya riwa Izhi a tre ri yii ka imiri wan?</para>
  <para style="q1" vid="HEB 12:5">&lt;&lt;Ivren won, srenton ka Izhi ghɨron,</para>
  <para style="q2" vid="HEB 12:5">nga ran chu sron zho ka a la-u kya riwa wu ran ti tsra ran.<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />Ritu Bachi ri ŋoron ko nghaa riwa a nyɨme wu,</para>
  <para style="q2" vid="HEB 12:6">ran no ko nghaa riwa a kpa ka ivren wan yaa.&gt;&gt;<verse eid="HEB 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />Vu sron rimi yaa riwa bi so-a no bibi riwa a ti ri no vren yaa; iyaa mbi ri tsro ri Izhi ri no yi yaa ka bi he miri wan. Ivren ritan he riwa iti wan ran no yaa to dzari ran? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />I wa ran no yi yaa ran, bibi riwa imiri wan wa he ran, woto mba bi ran he miri ran kpunji, ama bi he miri wawa wa ngizhi wa ri ko. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />Ya wa ti mbu wa kpa, wa no ta yaa nga ki no wa nkpen. Ko mba ki ran ka ngambu no wa Ti mbu wa wu ki ri fe vri ran! <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />Wa Ti mbu wa wu wa no ta yaa ri vi tsa wen, bibi riwa wa to a bi ri wa; ama Izhi ri no ta yaa ritu no dzon ta, ritu ki ri fe kabru rimi tsitsri wan. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />I wa no ta yaa, ari he ri ta ri vi wan mba ka ikya riwa no kpa sron mbu time, a ran kinklan sron ran. Ama ban kusi, wawa wa no wa bibi yaa-a wa fe son sisron nga son ri ndindi ti.<verse eid="HEB 12:11" /></para>
  <para style="s">Ide Tre nga Fen Ton</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />Ritu ngamba, ndzu wo mbi wawa wa ran senkpa ran ban shu, nga bi ri no gbre mbi wawa wa ran senkpa ran-a senkpa! <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />Sondu ran dzren ri nkon riwa a he ndrii, ritu wawa wa he ri lilo mkpuzhu no wa ran dru ran ama no wan fe si. <verse eid="HEB 12:13" /><verse number="14" style="v" sid="HEB 12:14" />Ti bi ri son ri sikpa ri ko nga, nga bi ri son son ri tsitsri, ritu nji riwa a ran he ri tsitsri ran a ran to Bachi ran. <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />Milan ya ritu kɨma gon ti ndindi ti Izhi. No njo no ran he ka nchi konkron riwa a rii riwa a gbron ran ngɨzhi dzi tsu ye ri ntson wan ran. <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />No njo no ran kɨma he ngungu ko ka ran hon he ri tsitsri ka Isuwa ran, riwa ritu nvangho ri riri a kan mkpen wan riwa vren ri mimilan ka re. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />Kugon rimba, bi to ri a ran wa ran kpa tilibu wan riwa ti wan; ama a kɨma he ngawan, ritu a ran fe nkon riwa ari sran kya riwa a ti-a ran, ko ri riwa a wa-u ri yii ima si. <verse eid="HEB 12:17" /><verse number="18" style="v" sid="HEB 12:18" />Bi ran ye ran, bibi riwa wa nji Israila wa ye ran, ko bi ri Bre mgblu ri Sinai ri nchon nzan wulu wan to ran, ko bi ri ya bubu riwa a he shnji gbingbi, ko ka nchon wo wulu, <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />ko ka inviri mkpuzhu, ko iran. Ka nji wa wo ran-a, waka bre ri wa ran wa wari wo tre ri ngaran, <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />ritu wa ran vu sron hu tre riwa wa kadzi ran riwa a tre ri, &lt;&lt;Ko wa ri tre ri inɨma nji nye bre wo ri ngblu, wa taa ri tita wuu.&gt;&gt; <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />Ikya riwa wa ta a no wa sisri bran riwa a no Musa no tre ri,&lt;&lt;Ikpa won ri wiri ritu sisri!&gt;&gt; <verse eid="HEB 12:21" /><verse number="22" style="v" sid="HEB 12:22" />Ama, bi ye ri tu Nchon Ngblu ri Siyona nye nga ri nchon gbu riwa Izhi riwa ari vri, Urishelima ri shuwulu, nga wa miri ko Izhi kigbu bran bran. <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />Bi ye ri bubu kabrutu ri kinklan sron riwa vren Izhi ri mimilan, riwa wa nde wan wa ngan wa ri shu wulu. Bi ye ri Izhi, riwa wawu nye he nji ri bla tre ri ko nga, nga ri wu wa nji wa ndindi wawa wa ti ndindi ti. <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />Bi ye ri Yeso, riwa a milan katredzi ri sisa ka dzi, nga nzii yii riwa a la ri ari de kyawa wa ndindi han bibi riwa iyii Habila.<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />Bi milan ya, nga ran kambi ri wo wawu riwa a tre kya ran. Wawa wa kamba ri wo wawu riwa a de tre ndindi ri mgbumgblume wa ran jibu wo ran. ko mba ari he ri ta ri se iki kɨma gon ti wawu riwa a zhu ri shu nye ye! <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />Iran wan a gɨzhu mgbumgblume ri vi-a, ama zizan a la ri, &lt;&lt;Me ran gɨzhu mgbumgblume nkankshe ran me gɨzhu shuwulu ngawen.&gt;&gt; <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />Itre-a &lt;&lt;Ri nkpa ri nganga&gt;&gt; A tre ri rira tsro ri kyawa wawa wa ti wa gɨzhu wa ri zhu wa, ritu wawa wa ran gɨzhu wa don. <verse eid="HEB 12:27" /><verse number="28" style="v" sid="HEB 12:28" />A he riwa ki ngiri ritu ki fe kpanchison riwa a ran gɨzhu ran. No ta ki ngiri nga ki kɨbu mgbazhu ri Izhi ri nkon riwa ari si-u sron, ki ri no mkpen nga ti sisri wan; <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />kpunji tre Izhi he wulu riwa ari gon.<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s">Bibi Riwa Wu Si Izhi Sron</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />Sondu ran nyime ngambi bibi riwa imiri vayi wa hu Izhi wa ti. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />Taka bi ri kpa tsren rimi ko mbi. Wari wa ti bibi mba wa ran to ri wawa wa kpa miri ko Izhi nye ran. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />Taka wawa wa he ri tra tren nji no he mba ka bi he ri wa ri tra tren ngawen. Taka wawa wa so yaa, no he ka wu so yaa riwa wa so-a ngawen. <verse eid="HEB 13:3" /><verse number="4" style="v" sid="HEB 13:4" />Gran he riwa wawubi bi no ngambi mkpen, nga no ronron nga wa no wa ran la ngamba kpunji. Izhi ri bla tre ri wawa wa zren ntran wari ri kru ngamba. <verse eid="HEB 13:4" /><verse number="5" style="v" sid="HEB 13:5" />No sron mbi no he kpata ri nyime nkren, nga bi ri ngiri ri kya riwa bi he ri wu. Ritu Izhi tre ri,&lt;&lt;Me ran ka yi don ran; me ran ka yi raga ran.&gt;&gt; <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />No ta ran ti sisiri ran, nga ki ri tre ri:</para>
  <para style="q1" vid="HEB 13:6">&lt;&lt;Bachi he dzon won,</para>
  <para style="q2" vid="HEB 13:6">me ran ti sisri ran.</para>
  <para style="q1" vid="HEB 13:6">Injo ran ti wen kyari ran.&gt;&gt;<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />Taka wa rinkon mbi wa sen, wawa wa la yi tre Izhi ri sen. Taka ban gon bibi son riwa wa son nga wari kuu, nga bi ri he ri bibi kpanyɨme mba. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />Yeso Kristo he wawu-a nye he luwa, mbɨre, nga hi ri kre vi. <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />Ran no wa bibi tsro wawa wa he sisa ri yi no wa no yi kɨma ka nko riwa a tsra don ran. A bi riwa bi kpa senkpa rimi ri wo ndindi ti Izhi, nga bi ri ran hu tre ritu ri; wawa wa hu bibi tre nyi-a a ran dzon wa ran. <verse eid="HEB 13:9" /><verse number="10" style="v" sid="HEB 13:10" />Wa Ti Baan wawa wa ti ndu ri Tenti riwa nji Yahuda wa ran he ri gbengbren riwa wa ri kya rimi Ti Baan ri tra bubu ibre mbu ran. <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />Rinkon wa Ti Baan wa nji Yahuda ri si ngɨzhi yii wa nɨma ye ri Bubu riwa a he ri Tsitsri han ran ka de ritu wa meme ti; ama wa nɨma wawa wa sren wa to-a wa ka wa gon ro kugon bubu kabrutu. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />Ritu ngamba nye Yeso a kuu ri kugon gbu ngawen, ritu ran tsri wa nji rimi meme ti ri yii wan. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />Ritu ngamba , no ta ki hi ri wu ri kugon bubu riwa wa kabru tu-a. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />Ritu igbu bubu ri son hi ran he ri ta ri mgbumgblu me ran; ki wa gbu riwa ari ye kusi. <verse eid="HEB 13:14" /><verse number="15" style="v" sid="HEB 13:15" />No ta ki sondu ran Ti Baan ri gbɨre ri Izhi hu ri Yeso, riwa a he ide riwa wa ka de ri nvurenyu riwa a la ri a he Bachi. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />Ran ti wulusu ri ti ndindi ti nga dzon ngambi ran, ritu rinyi nye he Ti Baan riwa ari sii Izhi sron.<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />Hu tre wa rinkon mbi nga bi ri hu kya riwa wa tre ri yi.Wa ran ri son vri ran ritu ya vri mbi, riwa wa wa bla ndu mba no Izhi. I bi hu tre, wa tin ndu mba ri kinklan sron; i bi ran hu ran tre wa wa ti ri shnji sron, nga ri mba ran dzon wu ran. <verse eid="HEB 13:17" /><verse number="18" style="v" sid="HEB 13:18" />Sondu ran bre zhi ri ta, ki to ri sron mbu ri isron mbu he riri, ritu ki wa ki ri ti kya riwa a bi ri ko vi ri tan. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />Ngha me bre yi ri ngaa no yi bre Izhi no bru ti wen ndu ye ri yi a ran ban vi ran.<verse eid="HEB 13:19" /></para>
  <para style="s">Bre ri Krenmkpen</para>
  <para style="p">
    <verse number="20-21" style="v" sid="HEB 13:20-21" />Izhi a ta Bachi mbu Yeso shime ri bubu gru riwa a he nji ri kishu ntɨma ndindi ritu ka yii wan rega, riwa wa lo katredzi riwa a ran kre ran. No Izhi riwa ari de si sron no no yi ko kya ndindi bibi tan riwa bi wa ritu bi ri ti kya riwa ari wa, nga no wawu Izhi hu ri Yeso Kristi no ti kya ri ta riwa ari si Izhi sron. Ngha no mkpen riwa a ran kre ran no he wa Kristo! No he ngamba.<verse eid="HEB 13:20-21" /></para>
  <para style="s">Itre ri Krenkpen</para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />Me bre yi miri vayi won ronron nga mirimba, no yi sren ton ri vu sron ri tre ri de senkpa nyi; ritu mbe nyi riwa me ngan ri yi a ran tiglo ran. <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />Me wa no yi to ri wa chu vayi mbu Timoti zho rimi tra tren nji. A chichi ye gbagbla, ki ye imbu-u ki to yi. <verse eid="HEB 13:23" /><verse number="24" style="v" sid="HEB 13:24" />La wa rinkon mbi nga wa hu Izhi wawu ri ki chi wa. Wa miri vayi wawa wa he ri Italiya wa chi yi. <verse eid="HEB 13:24" /><verse number="25" style="v" sid="HEB 13:25" />No ndindi ti Izhi no he ri yi wawu.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>