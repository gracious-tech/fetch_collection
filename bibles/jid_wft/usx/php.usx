<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- BUU</book>
  <para style="h">PHP - BUU</para>
  <para style="toc1">PHP - BUU</para>
  <para style="toc2">PHP - BUU</para>
  <para style="toc3">PHP - BUU</para>
  <para style="mt1">PHP - BUU</para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="s">Ichi Bulus</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />Zhu ri Bulus Tmoti riwa wa he gran Krisro Yeso dzu riwa wa he tsitsri rimi kristo Yeso riwa wa he ri Filibi ri mgbron nji ri wa wa mɨlan ya hu Izhi nga wawa wa ti ndu wan. <verse eid="PHP 1:1" /><verse number="2" style="v" sid="PHP 1:2" />Ndindi nga sisron riwa zhi a ti mbu ri Bachi Yeso Kristo no he ri yi wawu.<verse eid="PHP 1:2" /></para>
  <para style="s">Ngɨri nga Bre</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />Me ngɨri Izhi ri vi ri wa me tika mbi. <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />Rimi ibrewon wawu ri yi me si bre ri sron kinklan, <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />ritu bi katu kabru ri tre zhi riwa a gbuchi zhu ri ri ri ye zizan, <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />ri yo sron nga nyi, ritu nji riwa a gbuchi ti ndu dindi ri wu ari ngɨwu kre ri ri Kristo Yeso.<verse eid="PHP 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 1:7" />A tre ri me si taka ri yi nga nyi wawu mbi ritu bi he ri sron won ritu wawu mbi bi kabrutu ri me rimi dindi Izhi ri vi riwa wa tre wen ri tra trn nga la tre ri ro riwa a he janji ri nga mba. <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />Izhi nye a he shada won a to bibi kya riwa me ti mbiye mbi wawu ri nye Kristo Yeso. <verse eid="PHP 1:8" /><verse number="9" style="v" sid="PHP 1:9" />Ibre won a he no nyɨme mbi no ran bran bran nga ri to Izhi nga ito riwa a he to bran, <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />Ri nyi a ri zon yi bi ri to chu kya riwa a bi han ritu vi riwa Kristo ri ye bi ri son ri tsitsri riwa kyari ran sa yi kpan ran, <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />Bi ri she ri wɨlo dindi riwa a ye dzu ri Yeso Kristo ri mkpen nga gbre Izhi.<verse eid="PHP 1:11" /></para>
  <para style="s">Itren Bulus ritu ro tre Izhi a shan bran kusi</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />Imiri vayi ron-ron ri miri mba me wa bi ri to ikya riwa a ti ri me no he tre ri ro riwa a ri shan, <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" />Wa klu kpa ri ko chu ri mgbron nji wa to ri wa tre wen ri tra tre ritu Kristo nye. <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />Itren won riwa wa tre ri tra tre miri vayi won riwa wa bran rimi Bachi wa fe sen kpa ri shada tre Izhi riwa wa ran ti sisri ran, <verse eid="PHP 1:14" /><verse number="15" style="v" sid="PHP 1:15" />Wari wa bla tre Kristo ritu ti ngun ri nyɨme tu nye, ama wa ri wa ti ritu dindi. <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />Wa nyi nye riwa wa bla tre Izhi ri to dindi wa bla tre ritu nyɨme nye ritu wa to wa tre wen ritu me kpa tre dindi chuwo riwa a ro nye. <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />Wa mba nye wa bla tre Izhi ritu Kristo rimi nyɨme ritu mba nga a ran ri nyɨme mba ran. Ri nyɨme ritu mba nye me son me ran so yaa ri tra tre. <verse eid="PHP 1:17" /><verse number="18" style="v" sid="PHP 1:18" />To a ran he kya ran ikya riwa a he nga ko a he bibi tan ko ri ti sron che ko ri ti kpanji, wa bla tre Izhi ritu Kristo nye ri nyi a ri no wen me ti sron kinklan. Een me son ran gbuchi ti sron kiklan. <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />Ri nga mba me to ritu ibre mbi nga ri zon wu Kristo Yeso ri kre wato wa wa ri ka wen chuwo. <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />Mi ti mbiye nga me ri yo sron me ri ran katu won no ri shan rimi ndu Bachi ran ama me ri tre ri shu senkpa sron rimi kya wa wu riwa me ti no Kristo no fe kpan zizan ri ko naa ri vi ri mi won ko mi he ri si ko me kuu. <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />Ritu won ime sonri i ritu Kristo nyn ime kuu a he wa wu riba nye. <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />Ime son imi kpa me i ndu riwa a ri bi Ama me ran to bibi tan riwa me chu ran. <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />A he ri yaa riwa me chu me nyɨme me ri kuu nga me ri he i Kristo ritu a ri bi bran mon. <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />Ama a he riwa me son rimi kpa riwa a ri bi riyi. <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />Ritu a he kpunji ri mon nyyin, me to me son ri yi wawu bi ri bru mgbron rimi kinklan sron rimi yo sron mbi. <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />Riwa me he ri yi nganga bi kpo ngambi rimi Kristo Yeso a ri bran ritu won. <verse eid="PHP 1:26" /><verse number="27" style="v" sid="PHP 1:27" />Bi ka milan son bibi ro tre dindi riwa Kristo ri ngamba ko me ye to yi ko me ran bru ye ran me wo tre mbi sron mbi riri ritu yo sron tre ri ro, <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />Ran ti sisri nkpan fu mbi ran bibi nyi a he janji ri yi ritu wa kuu ama ri hi janji kpa yi chuwo nye. bibi janji nga nyi a zhu ri Izhi. <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />Ritu ti dindi riwa a ti ri yi ritu Kristo a ran ritu bi kpa nyɨme ri wu nkɨshe ran ama bi ri so yaa ritu wan. <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" />Bi ri so yaa bibi riwa bi to me so bi si ri wo me so ye zizan.<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="s">????</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />Bi fe nɨron ritu bi he riwa Kristo nyn ko bi fe si sron ritu kpa nyɨme wan ko bi ran kabrutu rimi wu ko bi he ri kpa nyɨme ri lo sron rimi mbi? <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />I bi he bibi kya wa nyi me ibreyi bi ri no sron wen no sho ri kinklan sron no sho ri son mbi ri tika riri ri nyɨme riri ri nufi riri <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />Ran ti ngun nga kpo nga wen ran ama ka tu wen yo me nga ri ban tu vayi wan han wa me. <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />Ko ngaa no ran milan kya wan ti ran nsɨshe ran ama no milan vayi wan ti nga wen. <verse eid="PHP 2:4" /><verse number="5" style="v" sid="PHP 2:5" />No wawu mbi ban rereKristo Yeso. <verse eid="PHP 2:5" /><verse number="6" style="v" sid="PHP 2:6" />Kristo a he Izhi janji Ama a ran ban tu wan tra ri Izhi ran. <verse eid="PHP 2:6" /><verse number="7" style="v" sid="PHP 2:7" />Ritu ngamba a ran ban tu wan he kyari ran ran ban kpa nji to gran riwa wa ti wu ka nji. <verse eid="PHP 2:7" /><verse number="8" style="v" sid="PHP 2:8" />Ngha wa ri ban wu to nji a ka tu wan yo me ran hu tre ka zi ri tu kuu kuu ritu konkron. <verse eid="PHP 2:8" /><verse number="9" style="v" sid="PHP 2:9" />Ritu ngamba izhi no kpen han ko ngiye ran no nde riwa a han ko nde riwa. <verse eid="PHP 2:9" /><verse number="10" style="v" sid="PHP 2:10" />Rit nde Yeso nyi nji wawu wa ku ngbazhu ri shu wulu ri meme ri ndodza gbungblume, <verse eid="PHP 2:10" /><verse number="11" style="v" sid="PHP 2:11" />Ko rɨme ngaa a ri shada ri yoo Kristo Bachi nye ritu wa no Izhi a ti kpan.<verse eid="PHP 2:11" /></para>
  <para style="s">Ran ti kya ri janyu raan</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />Ritu ngamba wa kpan won riwa bi hu tre ka ziri vi ri vi ime ran he ri si won ran riwa me ran he ran ran ti ndu kpa chuwo wn ri sisri, <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />ritu zhi riti ndu rimi sron mbi no kya wa a ndi no wa sho ritu wan.<verse eid="PHP 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 2:14" />Ran ti kya ri janyu ran. <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />ritu bi ri ran he wa ti meme ti ran riwa bi he tsitsri miri Izhi riwa wa ran he ri ikan ran bi son ri nzan wa meme riwa son mba a ran bi ran bubu riwa bi kpa rimi mba ka bibi kpan ri ghungblume, <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />riwa wu ngɨzhi tre vri gbengben nga me ri kpo ngawon ri vi Kristo riwa me ran wulutsu ka me ran ti ndu kuki ran. <verse eid="PHP 2:16" /><verse number="17" style="v" sid="PHP 2:17" />Ama riwa bi wa wen ride so ritu sro yii nga ndu riwa a ri ye rimi yo sron mbi, me ngɨri ri yi wa mbi. <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />Bi yi ngawen ngɨri ri me.<verse eid="PHP 2:18" /></para>
  <para style="s">Timoti nga Abaforiditus</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />Me yo sron rimi Bachi Yeso ritu me ti Timoti ye ri yi gbagbla ritu a me ngawe me ri fe senkpa ri wo tre mbi. <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />Me ran he ri njo to wawu riwa a ri milan yi ngɨshi bran to wawu ri ti ran. <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />Ko ngaa ri ya tu wan ri kya i wa a bi ama a ran kya wawa wa Yeso Kristo ran. <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />Ama bi to bibi nji riwa Timoti he a ti he a ti ndu ri me to vren rimi bla tre ri ro. <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />Me yo sron ritu me ti wu ndu gbagbla me ri to bibi kya wawa wa hi ri me. <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />Ngha me yo sron ri Bachi a me me ye gbagbla. <verse eid="PHP 2:24" /><verse number="25" style="v" sid="PHP 2:25" />Ama me taka a bi riwa bi no abadoritus no bru ye vayi won ikpa ndu won lo kpa riwa bi ti wu ndu no milan ya wen. <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />A si ti mbye a ri to wawu mbi a lo sron bran ritu riwa bi wo a ran he si kpa ran. <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />Kpunji tre a lo to a ri kuu ama ka lo Izhi sron ritu wan a ran he wawu ngɨshi wan ran ri a me ngawen ran ran he nga mba ran sron shnji ran bran ri mon. <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />Ritu nga ngi me yo sron me ri ti wu ndu bi ri ngiri riwa bi bru to-u no lo sron won no von rega. <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />Bi ka kpa ri ngiri bran ritu Bachi no bibi mba kpen. <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />A ti hure riwa ran kuu ritu ti ndu Kristo a ri de vri wan ritu no zon wen bibi riwa bi ran to zon wen ran.<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s">Ngiri ri kpa nyɨme</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />Ri kre wan, tre miri vayi won, ngiri rimi kabrutu mbi ri Bachi. Me wa me ri bru ngha bibi kya riwa me ngha dzari, nga ari dzon yi ka me ngha. <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />Milan ya wawa wa ti kyawa wa meme ti, yawu wa mu, wawa wa sondu ri fon kpa. <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />A he kita, a ran wawa ran, wawa wa fon wa nju ri kpunji, ritu ki gbre Izhi ritu Yuu wan takpe rimi son mbu rimi kabrutu ri Kristo Yeso. Ki ran yo sron mbu rimi ti riwa nji ran. <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />Ko riwa me to yo sron rimi kyawa wamba. I iri mbi to ri wawu ri yo sron rimi bibi ti nji, ame me to yo sron han. <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" />Wa fon wen nju ka me ke sati riri gyen, ame me he ngɨzhi Israila nye, riwa rɨme Benjami, ivren Ibraniyawa ri kpunji. Ritu hu doka Musa ame me he ngɨzhi nji Farisa nye, <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" />nga me ran yo sron ritu no wa hu Izhi yaa. Kau no wa tre ri nji wan ri ti ndindi ti ri hu tre Doka Musa, Ame me ran ti meme ti ran. <verse eid="PHP 3:6" /><verse number="7" style="v" sid="PHP 3:7" />Ama ikya riwa a ran he ndindi ri mo ri sen ama zizan me ban wu a ran he kya ri mo ran ritu Kristo. <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />Aran he kyawa wamba nye ka kre ran; Me ban kongye ri a he kya ri ran ritu kya riwa a he ndindi, ito riwa Bachi won Kristo Yeso. Ritu wan me ka kongye rega; Me ban wa wana he kya ri ran, ritu me ri fe Kristo, <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />nga me ri kabrutu ri wu ri kongye. me ran he ri ndiditi ri wa mo ran, bibi riwa wa fe wu ritu hu Doka Musa. Me ran he ri ndindi ti riwa wa de hu ri yosron ri Kristo ran, ndindi ti riwa a zhu ri Izhi nga a he ritu yosron. <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />Ikya riwa me wa a he me ri to Kristo nga me ri to gbengbren ri tashime wan, me dzon wu rimi so yaa wan nga me ri he ka wawu rimi kuu, <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />ri yosron ri ame kyuwon me tashime ri kuu.<verse eid="PHP 3:11" /></para>
  <para style="s">Itsutsu hu kuwa riwa wu yo kusi</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />Me ran ban mba ri me tari ko ri kongye won tsra ran. Me sondu ri dzran ta ri kya riwa Kristo Yeso a ta ri ri me he ri ngawan. <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />To biyi wa kpan won, me ran taka ri me tari-e mbana; Ikya riri riwa me ti, a he riwa me kpawulusu ri kyawa riwa a he kugon won nga me ri ti bibi riwa me vu kya riwa a he kusi won. <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />Ri ngamba, me tsutsu hi ndri ritu me ri fe kya riwa a he kusi won bibi riwa me ri tari kya riwa wa kadzi, riwa a he yo Izhi hu ri Kristo Yeso he ri vri ri shu. <verse eid="PHP 3:14" /><verse number="15" style="v" sid="PHP 3:15" />Wawumbu wawa ki gbron rimi wu ki he ri bibi ti riri-a. Ama i wari mbi wa he ri bibi ti rinkan, Izhi ri nghɨran yo ri yi. <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />Ikya ri bran rimi wan a he no ta ki hu bibi nkon riwa ki hu ye zizan. <verse eid="PHP 3:16" /><verse number="17" style="v" sid="PHP 3:17" />Sondu ran hu bibi ti won, biyi wa kpan won. srenton ri wawa wa hu bibi ti riwa a tsra riwa ki yo ri yi. <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />Me la yi kyanyi kigbu ri sen, nga zizan me bru ri la yi ri ima si: wari wa kigbu wawa ison kɨma wa he kpanfu kuu Kristo ri to konkron. <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />Ikre mba ri he ri ko wulu, ritu wa zhi mba nye wa he kya riwa wa nyime wa. wa kpo ngamba ritu kya riwa a he shan riwa, nga wa taka ritu kyawa riwa a he wa gbungblume. <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />Kita ki he wa nji wa shu, nga ki ki ri gben nji ri kpata chuwo, Bachi mbu Yeso Kristo, no zhu ri shu ye. <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />Ari sran kpa mbu riwa nji nga ran kɨma-u he ka riwa ma ri kpen, ari ti ndu ri gbengbren riwa ari to ngɨzhi ko ngye ye ri kpanchison wan.<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="s">Doka</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />Ri ngamba, biyi miri vayi won, wawa me nyɨme yi nga bibi riwa me ti vi hari me ran to yi ran! Bibi riwa bi no wen kinklan sron, nga bibi riwa me kpo ngawon ritu mbi! Biyi ki gbengben rimi son mbi ri Bachi.<verse eid="PHP 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />A wu Yudiya nga Sintiki, bubwo mbi, me bre yi, nyɨme ri ngambi ka miri vayi rimi sombi ri Bachi. <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />Nga a wu ngawen, ikpan ndu won ri kpunji, me wa wuri dzon mba wanyi; ritu wa dzon wen bran rimi la tre Izhi, nga ri Kleme ri wawa wa ngbɨron ndu won, wawa nde mba he rimi mbe Izhi ri vɨri.<verse eid="PHP 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4" />Bi sundu ran ti kinklan sron rimi kabru tu mbi ri Bachi. Me bru ri layi ti kinklan sron.<verse eid="PHP 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 4:5" />Tsro rere sron ri ko ngha. Bachi gon ri ye. <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />Ran taka ritu ko kyari ran, ama rimi bre Izhi mbi miyen Izhi kya riwa bi wa, sondu ran miyen ri ngiri ri sron. <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />Nga sisron Izhi, riwa a han bibi to riwa nji, ari kɨma sron wen dzi rimi kabrutu ri Kristo Yeso.<verse eid="PHP 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8" />Ri kre wan, biyi wa kpan won, no sron mbi no sho ri kyawa dindi nga wawa wa he riwa wa gbre wa: kyawa wa kpunji, ri nkpen, ri tsitsiri, ro nyime nga ri gbre. <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />Ti bibi kya riwa mi tsro yi nga bi ri kpa ri wo won, kahu ri riwa me tre nga riwa mi ti. Nga wawu Izhi riwa a ano ta si sron ri he ri yi.<verse eid="PHP 4:9" /></para>
  <para style="s">Ingiri Ritu Ide</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />Rimi son won ri kabru tu ri Bachi a he kya ri kinklan sron bran ri mo riwa kugon riwa vi bran riwa wu bru he vi riwa wu tsro ri wu nyime wen. Mi ran ri miyen ri wu kawen ri nyime wen ngaran, wu ran he ri vi riwa wu tsro wen ran nyen. <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />Nga mi ran ri tre nganyin ritu wa kamba ri me ran, ritu mi to bibi riwa mi ngiri ri kya riwa mi he ri wu. <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />Mi to bibi riwa mi son ko ri riwa mi ran he ri kya ri ran nga bibi riwa mi son ri riwa mi he ri wa kyawa bran. Mi to tu kya wanyi bibi riwa ka mi hi kokutan, ri ko shitan, ko mi ri hwishi ko ka min ri son ri yon, ko miri he ri wu bran ko ka tsawen. <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />Mi he ri gbengbɨren riwa ko iya bibi tan ran ye, ri gbengbɨren riwa Kristo Non wen.<verse eid="PHP 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14" />Ama a bi bran riwa bi dzon wen ri vi riwa mi he rimi ya. <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />Biyi wa nji Filibiya bi milan to riwa mi ka gbu Makidoniya don gbagbla ri vi bla Tre ri Dindi, ara biyi nye bi he wa hu Izhi riwa bi dzon wen; ara biyi nye be he wawa be dzon wen ri wa kyawa. <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" />A han nkpa riri riwa mi ran he ri ri gbu Tasalonika be tru wa dzon ye no wen. <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />Aran he ritu mi wa miri fe wa kyawa ran; ama, mi wa no Izhi no tilɨbu sro yi ritu dzon riwa bi dzon wen. <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />Ngye gha mbe ri kongye riwa bi no wen nga a kigbu bran! Me he ri kongye riwa mi wa zizan riwa Abaforiditus ngɨzhi kyawa riwa bi no ye no wen. Wa he ka ide ri hwi raro riwa wa no Izhi, ti baan riwa a tsra nga ran si Izhi sron. <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />Nga Izhi ri no yi kyawa bran hu ri Kristo Yeso, Izhi ri no yi ko ngye riwa bi wa. <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />NO gbre he wa Izhi nga Ati mbu hi ri kre vi! No he ngamba.<verse eid="PHP 4:20" /></para>
  <para style="s">Ichi Ri Krenkpen</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />Ichi hi ri ko nji Izhi ritan wawa wa he wa Kristo Yeso. Wa hu Izhi wawa wa he ri me ri nyi wa chi yi. <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />Wa nji Izhi wawu rinyi wa chi yi, azizan wawa wa he ri ko chu Kesa. <verse eid="PHP 4:22" /><verse number="23" style="v" sid="PHP 4:23" />No dindi ti Bachi Yeso Kristo no he ri yi wawu.<verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>