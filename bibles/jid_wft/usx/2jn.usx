<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- BUU</book>
  <para style="h">2JN - BUU</para>
  <para style="toc1">2JN - BUU</para>
  <para style="toc2">2JN - BUU</para>
  <para style="toc3">2JN - BUU</para>
  <para style="mt1">2JN</para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />Ame Yohana rinkon nji nye</para>
  <para style="p" vid="2JN 1:1">Me ngan mbe nyi ri hu ri wo wari ko nga miri wan hi ri wa hu Izhi riwa a chu yi nga wawa wa kpanyɨme ri wu. Riwa me nyɨme yi ri kpunji a ran ame nkankshe ran, ama nga wawa wa to kpunji ngawen, <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />ritu kpunji he rimi sron mbu nga ari son rita hi ri kre wan:<verse eid="2JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3" />No ndindi ti riwa Izhi A ti nga Yeso Kristo ivren A ti, no yi ndindi ti, losron, sisron; no wa he wambu rimi kpunji nga nyɨme.<verse eid="2JN 1:3" /></para>
  <para style="s">Kpunji Ngha Nyɨme</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />Me ti kinklan sron bran riwa me fe miri wen wari wa son rimi kpunji bibi riwa A ti la ta ki ti. <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />Me ngan rinyi miri taka ri yi biyi wa kpan won iri ki nyɨme ngambu. Rinyi ran he tre sisa ran ama a he riwa ki wo-u ri mimilan. <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />Inyɨme he kya riwa Izhi la ta nga a la ta ki nyɨme ngambu, bibi riwa ki wo ri mimilan. <verse eid="2JN 1:6" /><verse number="7" style="v" sid="2JN 1:7" />Me tre nganyi ritu wa gyuru nji kigbu wa zhu ri gbungblume wa kamba ri Yeso Kristo a ye rɨme kpa nye, bibi nji wamba wa he wa gyuru nji nga wa he kpan fu Kristo. <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />Milan yaa ritu bi ri ran ka fe kya riwa bi sondu ri ti ndu ritu bi ri fe kya rimi wan ran, ama bi ri fe kya bran rimi wan. <verse eid="2JN 1:8" /><verse number="9" style="v" sid="2JN 1:9" />Nji riwa a kawan ri wo tsro riwa Kristo, ran ti kyari nkan, a ran he ri kabrutu ri Izhi ran; ama ko ngaa riwa a hu tsro Kristo ari he ri kabru tu ri A ti nga vren wan Yeso. <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />Ka njo ye ri yi nga ran ran ri tsro yi tsro riwa Kristo ran bi ka ran kpa hi ri ko mbi ran. <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />Nji riwa a kpa bibi nji-a, ari ti meme ti riwa ari ti-a ngawen.<verse eid="2JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />Me he ri ngbron tre bran riwa me la yi ama me ran ri wa miri ngan rimi mbe mba nklan ri ngan ka kre ran; tsede me wa miri ye tre ri yi si ri si, ritu no kinklan sron mbu no bran.<verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />Imiri vayi wen wawa wa hu Izhi wa tre ri yi.<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>