<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">MRKUS; BUU</book>
  <para style="h">MRK MARKUS; BUU</para>
  <para style="toc1">MRK MARKUS; BUU</para>
  <para style="toc2">MRK MARKUS; BUU</para>
  <para style="toc3">MRK MARKUS; BUU</para>
  <para style="mt1">MRK MARKUS; BUU</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">Yohana nji ri son nji tu ri ima a Milan Nkon ti</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Rinyi nye he tre ri ro ritu Yeso Kristo ivren Izhi.<verse eid="MRK 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 1:2" />A gbuchi bibi riwa Ishaya nji ri la tre Izhi a ngan ri:</para>
  <para style="q1" vid="MRK 1:2">&lt;&lt;Izhi a tre ri me ti vren ri ndu won no ye gbuchi ri yi,</para>
  <para style="q2" vid="MRK 1:2">ran bu nkon ri yi.&gt;&gt; <verse eid="MRK 1:2" /><verse number="3" style="v" sid="MRK 1:3" />&lt;&lt;</para>
  <para style="q1" vid="MRK 1:3">Iran ri yo ri tsutsu ji ri,</para>
  <para style="q1" vid="MRK 1:3">&lt;Milan nkon ti ri Bachi,</para>
  <para style="q2" vid="MRK 1:3">bi mɨlan nkon wan ti riwa ari hu.&gt;&gt;&gt;<verse eid="MRK 1:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MRK 1:4" />Yohana nji ri son nji tu ri ima a zhu ri ji ran ran tre tre Izhi no nji no wa ka meme ti chu wa no wa son wa tu ri ima wa ri ka meme ti mba rega ri wa. <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Inji wawu kugran Yahudiya, nga nji wawu ri Urushalima wa gbundo ran ye ri wu wa ran la meme ti mba wa ri ka wa ran rega nga vu wa son tu ri ima ri ba ne Juda. <verse eid="MRK 1:5" /><verse number="6" style="v" sid="MRK 1:6" />Yohana a su tsro riwa wa ti ri nfu ntɨma ri ji, nga ran lo tri ri nchanwa ri ntan iri wan a he lamgblan mba ima ton. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Yohana a la nji ri,&lt;&lt;Inji ri ri ye riwa a han wen, riwa me ran ke riwa me sii zhizhi ntan dza wan ran. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Me son yi tu ri ima ri ima, ama wawu ri son yi rimi wu Tsitsri.&gt;&gt;<verse eid="MRK 1:8" /></para>
  <para style="s">Ison Yeso tu Ima nga shetan a Tsra-u</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Chachu ri Yeso a zhu ri Nazaret ri Galili nga wa son-u tu ri ima ri ba nne judan. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />Riwa Yeso a Zhu ri ima ran ye raa, ka to ishuwulu ka bu nga iyu Izhi riwa a he ka nguu ka ye kuson ri tu wan. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />Ngha iran ka zhu shu ye ri,&lt;&lt;A wu wu he vren won riwa me nyɨme wu, me ti kinklan sron ri wu branbran.&gt;&gt;<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />Ri bubu wan Iyu Izhi riwa a he ri wu ka ngizhi wu hi ri tsutsu ji bubu riwa giga ran he ran, <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />riwa a son ri bubu wan ti vi senza, meme nji ka sondu ran tsra-u, a son iwawa nɨma ji wa fu nga miri ko Izhi waka ye dzon wu.<verse eid="MRK 1:13" /></para>
  <para style="s">Yeso a Yo Wa Ndu wan wa Gbuchi</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />Kugon riwa wa vu Yohana yo rimi tra tren, Yeso ka hi ri Galili ran ran la tre dindi riwa Izhi. <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />Aran la wa ri,&lt;&lt;Ivi ye hwire.&gt;&gt;Ran bru tre ri,&lt;&lt;Kpanchi Izhi ye hure meme ti mbi chuwo bi ri kpa nyɨme ri tre dindi!&gt;&gt;<verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />Riwa Yeso a ran vu yɨba ri nyu nne ri Galili, imba ka to Sima nga vayi wan Andarawus wa ran ta tsro ri vu lambe ritu wa he wa vu lambe. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Yeso ka la wa ri,&lt;&lt;Hu wen ame me kɨma yi he nji wawa wa ngɨzhi nji ye ri me.&gt;&gt; <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />R i bubu wan waka ka kpi ri vu lambe mba don wari hu Yeso.<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />Riwa a hwi hi kusi tsawen ka to miri vayi hari wawa nde mba a he Yakubu ivren Zabadi nga vayi wan Yohana wa he rimi nvuima, wa mɨlan tsro ri vu lambe mba ran ti. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Ri bubu wan ka yo wa, wa ka ti mba Zabadi don rimi nvu ima nga miri ndu wawa wa vu wa wari hu.<verse eid="MRK 1:20" /></para>
  <para style="s">Yeso a dzu meme Yuu</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Yeso nga miri ndu wan wa hi ri Kafarnaum, riwa ivi son vri a ye, Yeso ka gra rimi tra Izhi ran ran tsro wa. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />Inji wawa wa wo-u waka ti sisiri ritu tsro riwa a ran tsro ritu a tsro wa ka nji riwa a he ri gbengbren, a ran bibi wa tsro doka Musa ran. <verse eid="MRK 1:22" /><verse number="23" style="v" sid="MRK 1:23" />Ri mba nji ri ri meme Yuu ka ye rimi tra ri kabrutu nji Yahuda ran ran kpagro, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />&lt;&lt;Yeso ri Nazaret ngye nye wu wa ri ta? Ka wu ye wuri wuu ta nye? me to ri wu he nji ri Tsitsri riwa Izhi nye!&gt;&gt; <verse eid="MRK 1:24" /><verse number="25" style="v" sid="MRK 1:25" />Yeso ka tre ri,&lt;&lt;Somgbi wu ri zhu ri kpa nji mba!&gt;&gt; <verse eid="MRK 1:25" /><verse number="26" style="v" sid="MRK 1:26" />Iyu meme-a ka dzan nji-a kpa ran no kpagro nga ka zhu ri kpa wan.<verse eid="MRK 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 1:27" />Inji wawu wa ti sisiri wari ran miyen ngamba ri,&lt;&lt;Rinyi he ngye nye a he tsro ri sisa nye? Inji nyi he ri gbengbren ri la meme wu tre waka ti sisiri wan!&gt;&gt; <verse eid="MRK 1:27" /><verse number="28" style="v" sid="MRK 1:28" />Ngha ri bubu wan itre Yeso ka shan gra ko kutan kagon gbu Galili.<verse eid="MRK 1:28" /></para>
  <para style="s">Yeso a den Nji Kigbu</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Ri zhu wa Yeso nga miri wa ndu wan ri tre Izhi, wawa ri Yakubu nga Yohana waka kunkon hi ri ko Bitrus nga Andarawus. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Iyi wa Bitrus a kru ri blaa ran ran tsri mbzhu, nga riwa Yeso a zhu ri bubu wan, waka la-u ritu wan. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />A hi kusan wan, ran ndzu-u wo dzi nde, imbzhu-a ka kau chuwo nga ka ti ndu ri wa. <verse eid="MRK 1:31" /><verse number="32" style="v" sid="MRK 1:32" />Riwa iji a ku nga yawulu ka ti, nji waka ngiji wa lilo nga wawa wa he ri bɨzhi ye ri wu. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Inji wawu waka ye kabru ri nkon ko riwa Yeso a he-a. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Yeso a den nji kigbu wawa wa he ri lilo kankankan. Ran zhu bɨzhi kigbu zho ri nji kigbu, a ran no wa bɨzhi no wa tre kya ri ran ritu wa to ko wawu he ngan.<verse eid="MRK 1:34" /></para>
  <para style="s">Yeso a hi ri bubu bre Izhi ri nkankshe wan</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Ri bubu mbre, ka ibu a ti, Yeso ka wulunde, ran ka ko don ran hi ri bubu riwa a he yoon, bubu riwa ari bre Izhi. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Imba Sima nga wawa wa he wawa waka zhu hi ri bubu wa Yeso, <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />Ngha riwa wa fe wu, waka tre ri,&lt;&lt;Ko ngaa ri wa-u.&gt;&gt;<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />Ama Yeso ka tre ri wa ri&lt;&lt;Ki hi ri gbu wa kusi mu me ri bla tre Izhi ri wa ngawen. Ritu wan nye me ye!&gt;&gt; <verse eid="MRK 1:38" /><verse number="39" style="v" sid="MRK 1:39" />Ka dzren kagon gbu Galili ran ran tre tre Izhi ri tra Izhi mba nga ran dzu wa bɨzhi zho ri kpa nji.<verse eid="MRK 1:39" /></para>
  <para style="s">Inji ri Lilo Mkpuzhu</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Inji ri lilo Mkpuzhu a ye kɨbu mgbazhu ri kusi Yeso ran bre ri,&lt;&lt;Ka wu nyɨme, wu to tsri won bibi riwa lilo won ri kre penpren.&gt;&gt;<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />Imba ka lo Yeso sron ka nɨme wo ran bre wu ran tre ri wu ri,&lt;&lt;Me nyɨme meri tsri-u he nji ri tsitsri!&gt;&gt; <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Ri bubu wan lilo mkpuzhu-a ka ka wu chuwo, ka he nji ri tsitsri.<verse eid="MRK 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 1:43" />Rimba Yeso ka no hi nga wan ri nghɨron tre ri senkpa ri: <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />&lt;&lt;Milan ya ran la njo ran, ama hi tsro tu wen ri wa sro yii nga wu ri hu kya riwa Musa a tre no wa ti ritu ti tsitsri, ti ngamba bibi riwa wu tsro nji iri wu fe si!&gt;&gt; <verse eid="MRK 1:44" /><verse number="45" style="v" sid="MRK 1:45" />Ama ka hi ran gra bla tre-a ran ran shan tre kya riwa a ti kagon, a ti ran no Yeso a ran to gra ri kokutan ri rira ngaran ka son ri bubu riwa njo ran he ri bubu wan ran. Ngha nji wa sondu zhu ko kutan ran ye ri wu.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">Yeso a Den nji ri Klukpa</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Kugon vi hari, riwa Yeso a bru hi ri kafarnaum, nji waka wo iri a ye ko. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Imba nji kigbu waka kabru sho kokutan, nkon ri hu ka ran he ran kau ri ran ngawen, nga Yeso ka ran bla tre Izhi ri wa. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Inji wari waka ye ri wu wa ngɨzhi nji ri lilo klukpa ye ri wu, wawa wa ban wu ye wa he nji nza. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Ritu nji wa kigbu ri wu wa ran fe nkon riwa wa hi hure ri wu ran, ri ngamba waka hon tu tra riwa Yeso a he rimi wan, wa ruu tu tra-a waka gra ri nji ri lilo klukpa wari ka-u yo ri tu blaa wan ri kru-a. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />Riwa Yeso a to kpanyɨme mba, Yeso ka tre ri nji ri klukpa-a ri,&lt;&lt;Ivren won, wa ka meme ti wen rega ri wu,&gt;&gt;<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />Wa tsro doka Musa wari wawa wa ki ri bubu wan waka ran rimɨren ri sron mba ri, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />&lt;&lt;Ritu ngye ko nji nyi ri tre meme ritu Izhi? Ari tsri Izhi nye nji ri tsitsri riwa ari to ka meme nji rega?&gt;&gt;<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />Ri bubu wan Yeso ka to kya riwa wa rimɨren ritu wan ri sron mba nga ran tre wa ri,&lt;&lt;Ritu ngye ko bi rimɨren bibi mba? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />A he hwɨri riwa wa tre ri nji ri lilo klulpa-a ri,&lt;Wa ka meme ti wan rega ri wu &gt; Ka wa tre&lt;Wulu kri nde ban kpala wen wuri zren?&gt;&gt; <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Yeso ka tre ri nji ri lilo klukpa ri me no yi to ri ivren nji he ri gbengbren ri ka meme ti rega ri mgbumgblume.&gt;&gt; <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />Me la-u wulu kri nde ban blaa wen wuri hi ko! <verse eid="MRK 2:11" /><verse number="12" style="v" sid="MRK 2:12" />Riwa wa ki ran ya nji-a ka wulu kri nde, ran ban blaa wan ran hi ngawan a nzu wa sron wawu mba waka gbre Izhi, ran tre ri&lt;&lt;Ki ran to bibi kya nyi zari ran!&gt;&gt;<verse eid="MRK 2:12" /></para>
  <para style="s">Yeso a yo Lawi</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Yeso ka bru hi ri nyu nne Galili Ijɨbu nji wa ka ye ri wu nga ka gra ri tsro. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Riwa Yeso a ran hi, ka to Lawi ivren Halfa a son ri bubu riwa wa kpa nkran ri meme Yeso ka tre wu ri,&lt;&lt;Hu wen.&gt;&gt;Ngha Lawi ka wulunde ran hu.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />Riwa Yeso a ran ri ri ri yawulu ri ko lawi wa kpa nkren ri meme kigbu nga, Wa meme ti Wa ran ri ri ri wu nga miri ndu wan, ritu wari kigbu rimi mba wa he wawa wa hu. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />Riwa wa tsro doka wawa wa he Farisa wa to-u a ran ri ri ri wa memeti Ngha wa kpa nkren ri meme wa miyen miri ndu Izhi&lt;&lt;Ritu ngye ko ari ri ri ri wa kpa nkren ri meme nga wa meme ti?&gt;&gt; <verse eid="MRK 2:16" /><verse number="17" style="v" sid="MRK 2:17" />Yeso a wo wa ran tre ri,&lt;&lt;Inji wawa wa he si wa ran ri hi tra gbugblu ran ama tsede wawa wa ran he si ran me ran ye bubu yo wawa we ti tsra ran ama wawa wa ti meme ti.&gt;&gt;<verse eid="MRK 2:17" /></para>
  <para style="s">Imiyen ritu vula Ima</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Chachu ri imiri ko Yohana nji ri son nji tu ri ima nga wa nji Farisa wa ran vula ima nji wari waka ye wari miyen Yeso ri,&lt;&lt;Ahe rise ko imiri ndu Yohana nga Farisa wa vula ima, ama iwa me wa ran ri vula ima ran?&gt;&gt;<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />Yeso ka tre wa ri,&lt;&lt;A ri he se no wa kpan nji ri ro wa no wa vula ima ka a he ri wa? wa ran vula ima ran, tunde ari he ri wa. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Ama wari ye riwa wa ban nji ri ro wa-a zho ri wa ri vi wan nye wa vula ima.<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />&lt;&lt;Inji ran tindu ri ŋɨma tsro ri sisa ran wuran ngaan ri tsro ri kɨmo ran ka a ti ngamba iŋɨma ri sisisa-a ri ŋɨren zho ri kpa ri kɨmo-a ran kpa ri kɨmo-a meme ri bubu ya. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />Injo ran sro nfri rimi vaja riwa wa sro hi rimi wan ran, ritu ihi ri kpa vaja-a yɨra nga ri vaja-a nga hi-a wa rega. Tsede no wa sro nfrɨi rimi vaja ri sa.&gt;&gt;<verse eid="MRK 2:22" /></para>
  <para style="s">Imiyen ritu Chachu Sonvri</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Chachu son vri ri Yeso iwa miri ndu wan wa ran zren rimi zhu alikama, imiri ndu wan waka wɨro wɨlo alikama-a ran tan. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />Farisa waka tre ri Yeso ri,&lt;&lt;Ya, ingye ti ko wa ti kya riwa a ran tsra ran chachu sonvri?&gt;&gt;<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />Yeso ka tre ri&lt;&lt;Bi ran kra kya riwa Doda a ti ka wawu nga wa kpan riwa iyon a ran ti wa nga wa ran wa kya ri ri ran? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />Ri vi Abiyatar rinkon wa ndu Izhi a gra ri ko Izhi ran ri jujuyɨmo ri tsitsri riwa wa ka dzi ri rinkon wan n ndu Izhi nga ran fon wari no wa kpan ndu wan.&gt;&gt;<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />Imba ka tre wa ri,&lt;&lt;Wa ti vi ri son vri ri nji nye, a ran nji ri vi ri son vri ran. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />Ivren Nji he Bachi ka hu ri riwa vi sonvri ngawen.&gt;&gt;<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Imba Yeso ka bru hi ri tra Izhi ran ka fe nji ri lilo klu wo ri ri bubu wan. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Inji wari wa he ri bubu wan ritu wari wa nkon vu Yeso ri meme ti, imba waka ju si ran ya wari to ko ari den nji-a chachu sonvri. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />Yeso ka tre nji ri lilo kluwo-a ri,&lt;&lt;Wulunde ye kukri nde ri kusi ko ngaa.&gt;&gt;<verse eid="MRK 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 3:4" />Imba Yeso ka miyen wa ri&lt;&lt;Ingye nye doka mbu tre ki ti chachu vi sonvri? A tre ri ki ti ndindi ti ka ki ti meme ti, ki kpa nji chuwo ka ki ka nji chuwo no kuu?&gt;&gt; Ama waka ran tre kya ran.<verse eid="MRK 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 3:5" />Yeso ka ti fu ri wa a ndzu si ya wa ama ka losron ri wa ritu kpekpe sron mba. imba ka tre ri nji ri lilo kluwo-a ri,&lt;&lt;Nɨme wo wen.&gt;&gt;Nji-a ka nɨme wo wan ran fe si. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />Imba wa nji Farisa waka zhi raa wari fe wa nji Hirudus wa ri kabru tu ritu riwa wa wu Yeso<verse eid="MRK 3:6" /></para>
  <para style="s">Inji kigbu wa hu Yeso hi ri Nyu Nne</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Yeso nga miri ndu wan wa hi ngamba ri nyu nne Galili nga ijɨbu nji waka hu wari wa zhu ri Galili nga wari wa zhu ri Yudiya. <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />Wari wa zhu ri Urushalima wari waka zhu ri ŋɨma gbu Edom, nga wari wa zhu ri gran ba nne ri Yodan nga wa nji gbu Taya nga Sidon nji wanyi wawu wa ye ri Yeso ritu wa wo kya riwa a ran ti. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />Ritu nji wa kigbu Yeso ka la miri ndu wan ri no wa mɨlan mvu ima ri dzi ri wawu, bibi riwa nji wa ran kɨshu-u ti bran ran. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />Yeso a den nji kigbu, nga wa lilo kigbu wa sondu ran nɨran nkon ran ye ri wu ritu wari bre wu wo. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Ka Iyu meme-a wa to Yeso waka kɨbu mgbazhu Kusi wan wari ran kpagro ri,&lt;&lt;A wu wu he vren Izhi nye.&gt;&gt; <verse eid="MRK 3:11" /><verse number="12" style="v" sid="MRK 3:12" />Ama Yeso ka fen wa ton ri no wa ran la nji ko wawu he ngaa ran.<verse eid="MRK 3:12" /></para>
  <para style="s">Yeso a Juu wa Ndu wan Wuru Don hari</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Imba Yeso ka hon hi ri tu ngblu ran yo nji wawa ari wa no wa ti ndu ri wu, nga waka ye ri wu. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />A zhu nji wurudon hari riwa a yo nde mba ri wa ndu wari, wawa wa ki vi wawu nga wawu ri ka ti wa ndu no wa hi bla tre Izhi, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />nga wari he ri gbengbren riwa wa dzu bɨzhi zhu ri nji. <verse eid="MRK 3:15" /><verse number="16" style="v" sid="MRK 3:16" />Ingye ngaa wa wuru don hari wawa a zhu wa-a-en Sima riwa a yonde wan ri Bitrus; <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />Yakubu Ivren Zabadi nga vayi wan Yonana wawa a yo nde mba ri Buwanajis, woto imiri nzan; <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />Andarawus, ri Filibu ri Batalomi Matiyu Toma Yakubu ivren Halta, Taddiyus, Sima nji riwa a ka gbu wan don, <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />nga Yahuda Iskariyoti riwa a ree ri wu.<verse eid="MRK 3:19" /></para>
  <para style="s">Yeso nga Baalzabul Ichu meme bɨzhi</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Imba Yeso ka hi ko, nga nji kigbu wa bru ye kabru riwa Yeso nga wa ndu wan wa ran fe nkon riwa wa ri ri ran. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Riwa wako wan wa wo ritu wan wa zhu hi ritu wari vu, ritu nji wana tre ri,&lt;&lt;Ari sra nye.&gt;&gt;<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />Wa tsro doka wari wawa wa zhu ri Urushalima wana tre ri,&lt;&lt;A he ri chu wa meme bɨzhi ri kpa wan! A he chu wa bɨzhi nye no gbengbren ri dzu bɨzhi.&gt;&gt;<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />Imba Yeso ka yo wa ye ri ngawan ran tre wa ri tre ri kɨbu-kɨbu ri,&lt;&lt;shetan ri ti se ran dzu meme nji? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />Ka kpanchi ga ti hari, wa he kpan fu ngamba. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />Ka iko wa ga ngamba ti hari wa he kpan fu ngamba. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Ka meme nji yo ngawan kusi, a ran ri to ban kusi ran ikre wan ri ye nye mba. <verse eid="MRK 3:26" /><verse number="27" style="v" sid="MRK 3:27" />Yeso a tre ri, nji ran ri to gra ri ko nji riwa a senkpa ran vu kpi wan ran, tsede a vu lo ri zhizhi ri ko ari to yɨbi kpi wan. <verse eid="MRK 3:27" /><verse number="28" style="v" sid="MRK 3:28" />Me la yi kpunji ri wa ka meme ti wawa wa ti meme ti rega ri wa nga meme tre riwa wa tre <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />Ama ko ngaa riwa a tretre meme ritu Yuu Tsitsri wa ran ka meme ti wan rega ri wu ran ritu a ti meme ti riwa a ran kre ran.&gt;&gt; <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />Yeso a tre nganyɨn ritu nji wari wana tre ri,&lt;&lt;A he ri Yuu meme.&gt;&gt;<verse eid="MRK 3:30" /></para>
  <para style="s">Iyi Yeso nga miri vayi wan.</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Imba iyi Yeso nga miri vayi wan wa ye ri bubu wan wa kuki ri ra ko riwa Yeso a he rimi wan wari ti nji ri ndu no hi ran yo Yeso no ye. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Inji kigbu wa kuson kagon wan nga wa la-u ri,&lt;&lt;Wayi wen nga wa miri vayi wen wa he ra wa wa wari to-u.&gt;&gt;<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />Yeso ka miyen wa ri,&lt;&lt;Wa ngaa wa he yi won nga miri vayi won?&gt;&gt;<verse eid="MRK 3:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 3:34" />Imba ka ya wawa wa kuki ri meme kagon wan ran tre ri,&lt;&lt;Wanyi nye wa he wa yi won nga miri vayi won! <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Inji riwa a ti kya riwa Izhi ri wa wawu nye he miri vayi won nga yi won.&gt;&gt;<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">Ikɨbu tre Ritu Nji ri Chu Kpi</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />Chachu ri nganga, Yeso ka bru ran tsro ri nyu nne Galili, nji wawa wa kɨshu-u ti wa kigbu ka gra rimi mvu ima-a ran kuson rimi wan nga ijɨbu nji-a waka kuki ri tu gashi ri nyu nne-a. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />Yeso ka tsro wa kyawa bran ri kɨbu-kɨbu, nga rimi tsro wan ka tre ri. <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />&lt;&lt;Biyi wo wen! Wa ti nji ri riwa a hi ri bubu chu wɨlo kpi. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />Riwa a he rimi hi wɨlo kpi-a wari waka ku ri nkon riwa wa hu, nga chenchen waka ye tan wa ri. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Iwɨlo wari waka ku ri bubu meme riwa a ti tita ka zhumbe gbagbla ritu meme ri bubu wan a ran bran ran. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />Imba riwa nji a chu ka zhumbe tsitsa wan ritu inja mba a ran gra meme bran ran. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />wari mba wa ku rimi nchon, riwa wa gbron inchon ka ima wa to wa ka ran to ti wɨlo ran. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Ama wari wa ku ri bubu meme ndindi wari zhu mbe, wari gbron nga wari ti wɨlo, wari wa ti wɨlo setra, wari wa tiwɨlo setanren nga wari wa ti wɨlo gbigba ri.&gt;&gt;<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />Imba Yeso ka tre ri,&lt;&lt;Inji riwa a he ri ton ri wo no wo.&gt;&gt;<verse eid="MRK 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Riwa Yeso a he ri nkankshi wan, wari wawa wa wo-u waka ye ri wu nga miri ndu wan wuru don hari nga wari miyen iri no ŋɨran nchi kɨbutre-a ri wawa. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Yeso ka la wa ri,&lt;&lt;Biyi wa ŋɨran nchi kpanchi Izhi&gt;&gt; ri yi-e. &lt;&lt;Ama wawa wana he rimi mbi ran wa wo tre-a ri kɨbukɨbu. <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />Ritu,</para>
  <para style="q1" vid="MRK 4:12">&lt;Wa sondu ran ya ama wa ran too ran,</para>
  <para style="q2" vid="MRK 4:12">wa sondu ran wo ama wana to tu wan ran;</para>
  <para style="q1" vid="MRK 4:12">Ko no wa kɨma ye ri Izhi nga no ka meme ti mba rega ri wa!&gt;&gt;&gt;<verse eid="MRK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Yeso ka tre wa ri,&lt;&lt;Bi ran to tre kɨbu nyi ran?Ko bi ti se bi ri to tre kɨbu-kɨbu riwa me la yi? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Inji ri hi wɨlo kpi-a a he tre Izhi nye ari hi. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Inji wari wa he ka iwɨlo kpi riwa a ku ri nkon riwa wa hu ka wa wo tre Izhi meme nji ri ye ran ye ban ngawan. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Ngbron nji wari wa he ka iwɨlo kpi riwa wa ku ri bubu tita ka wa wo tre Izhi, wa kpa ri ngɨri. <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />Ama a ran ri gra rimi sron mba bran ran, nga wa ran ri ti vi hari ran. Rimba ka iyaa ye riwa ritu tre Izhi wa chichi joku. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Ngbron nji wari wa chu rimi nchon. Wawa nye wa wo tre Izhi, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />ama wa tika ritu kya wa riwa wa wa, inyɨme kyawa wa mgbumgblume a ye ran ima tre Izhi-a to a ran ti wɨlo ran. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />Ama mgbron nji wari wa he ka iwɨlo kpi riwa wa chu ri bubu meme ndindi. Wa wo tre Izhi-a wari kpa a nga wari ti wɨlo wari wa ti wɨlo se tra wari iwɨlo setanren nga wari iwɨlo gbigba ri.&gt;&gt;<verse eid="MRK 4:20" /></para>
  <para style="s">Iwulu ri tu Didan</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />Yeso ka tre ri wa ri,&lt;&lt;Njo ran yo wulu ran kadzi ri ndoza didan ko ri ndodza bla ri kru ran? A ran he ngamba ran tsede ari ka-u dzi ri tu bubu kri wan? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />Kongye riwa wa ka-u wa ban wu zhu raa, nga kongye riwa wa kau wa ŋɨren yo raa. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Wo wen, nji riwa a he ri ton no wo.&gt;&gt;<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />Ka bru tre ri wa ri,&lt;&lt;Mɨlan ya kya riwa bi wo! ikya riwa wu ti ri njo, Izhi ri ti ri wu han kya riwa wu ti ri njo. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />Wawa wa he ri kyawa wa bru sro ngaa ri wa; nga wawa wa ran he ri kyari ran wa kpa vi riwa wa he ri wu. &gt;&gt;<verse eid="MRK 4:25" /></para>
  <para style="s">Ikɨbu tre Ritu Wilo kpi Riwa a Zhumbe</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Yeso ka bru tre,&lt;&lt;Kpanchi Izhi he nganyi nye. Inji ri hi wɨlo kpi ri zhu wan. <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />Ri ji nga ri chu, ka ari kru nna ko a he ri si, iwɨlo kpi ri zhu ran gbron, ama a ran ri to ko a ti se ran. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Meme ri tuwan nye ri no wɨlo kpi no gbron nga ran ti wɨlo, ari gbuchi zhu ri dagbu ri ko ran ye ti wɨlo. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />Ka iwɨlo kpi-a wiri, nji ri rɨma ri gra sren kpi-a ri riji, ritu ivi ri sren kpi ye.&gt;&gt;<verse eid="MRK 4:29" /></para>
  <para style="s">Ikɨbu tre ritu Wilo kpi riwa a he ka Isuu</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Yeso ka bru miyen wa ri,&lt;&lt;Ki tre ri kpanchi son Izhi he ri se? ka ri kɨbu tre bibi tan nye ki ka-u kabru? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />A he nganyi nye nji ri ban wɨlo konkron riwa a he kremkpen rimi wɨlo kpi ri mgbumgblume nga ran ka chu ri meme. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />Kugon vi hari ari gbron ran kɨma he nchon wɨlo rimi wɨlo kpi. Ari ti nchon ganran riwa chenchen wa ye kuki ri wu wan.&gt;&gt;<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />Yeso a ti ndu ri tre kɨbu-kɨbu kigbu ran bla tre wan ri wa bibi riwa wa too. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />Kongye riwa ari tre ri wa a ran tindu ri kɨbu tre. Ama ka a he ri nkankshi wan nga wa miri ndu wan, ari ŋɨran ko ngye ri wa.<verse eid="MRK 4:34" /></para>
  <para style="s">Yeso a yira Wowulu ngaa ka Kukri</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Ri chachu vi mba riwa yawulu a ti Yeso ka tre ri miri ndu wan ri,&lt;&lt;No wa ru gran hi ri ku gran nne kumu.&gt;&gt; <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />Imba wa miri ndu wan waka ka jɨbu nji-a don, wari hi gra ri nvuma riwa Yeso a gra son rimi wan-e, nga waka ban wu hi ri wawa rimi wan ngbron mvu ima ka gbuchi ran sho ri ima. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Ri bubu wan inchon gungu ka fu, nga ishi ima ka gbuchi ran kɨbu mvu mam-a, ka gbuchi ran sho ri ima. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />Yeso a he ri kugon mvu ima-a a ran kru nna ran ka tu wan yo ri tsro ri yo tu, imiri ndu wan waka shɨme-u ran tre ri,&lt;&lt;Inji ri tsro, a ran dren sron riwa ki wa kiri kuu ran?&gt;&gt; <verse eid="MRK 4:38" /><verse number="39" style="v" sid="MRK 4:39" />Yeso ka wulunde kri nde ran tre ri ngungu ri,&lt;&lt;Kukri kpen!&gt;&gt;Imba ngungu-a ka kukri nga ko kutan ka he yoon.<verse eid="MRK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 4:40" />Imba Yeso ka tre ri miri ndu wan ri,&lt;&lt;Ritu ngye ko bi ti sisiri? Bi kambi ran he ri Yosron ran?&gt;&gt;<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />Ama wa ti sisri bran wari ran tre ri ngamba ri,&lt;&lt;Inji nyi he ngaa nye? Kau ri ngungu nga shi ima wa wo tre wan?&gt;&gt;<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">Inji ri La tre Izhi ran he ri mkpen ri gbu wan ran</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Yeso nga miri ndu wan wa ka ruu gran nne ri Galili hi ri gbu Garasina. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Ri gɨzhi Yeso rimi mvu ima, nji ri lilo meme bɨzhi riwa a zhu ri bubu no nji yɨbi ka ye ri Yeso. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />Inji-a a ran kru ri bubu riwa wa no nji yɨbi, injo a ran to lo-u ri che ran. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />Ritu riwa wa sondu ran lo-u wo nga dza ka suu che ran rega. Injo ka ran to vu lo ri che nga ran. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Bla vi ri chu nga ri ji a ran zren rimi bubu riwa wa ban nji ri no yɨbi-a, nga ritu gashi ka ran kpagro ran ran dru ngawan kpa ri tita.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />Riwa nji-a a to Yeso ri kpata, ka wulunde ri tsu ran ye kɨbu mgbazhu ri kusi wan. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />Inji-a ka Kpagro mgbamgban ran tre ri&lt; Yeso, Ivren Izhi riwa a he ri mkpen bran ingye nye wu wa ri me? Me bre rimi nde Izhi ran no wen Yaa ran!&gt;&gt; <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />Inji-a ka tre ngamba ritu Yeso a tre ri wu ri,&lt;&lt;A wu Yuu meme mba zhu zho ri kpa nji nyɨn!&gt;&gt;<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />Imba Yeso ka miyen-u ri,&lt;&lt;Inde wen he ngaa?&gt;&gt;</para>
  <para style="p" vid="MRK 5:9">Ka tre ri,&lt;&lt;Nde won he ijɨbu, ritu ki kigbu ri kpa nji nyi.&gt;&gt; <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />Ngha ka sondu ran bre Yeso ri no ran dzu wawa zho ri bubu nyi ran.<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />Ijɨbu dushu wa ko wari wa ran ri ri ri kpa mgblu hwɨreri bubu wan. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />Iyu meme-a ka bre Yeso ri,&lt;&lt;No ta ki hi gra ri kpa dushu wa ko wamu wuri no ta ki kii ri mi mba.&gt;&gt; <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />Yeso ka nyɨme, imba Iyu meme-a waka hi gra rimi kpa dushu wa ko-a. Ijɨbu dushu wa ko-a wa he ngo hari nye, imba waka wulunde gbagbla wari gre hi wari ka ku rimi nne wari kuu.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />Inji wawa wa ran kɨshu dushu wa ko-a waka tsutsu hi ri gbu ri bran nga gbu wa tsitsa, wari kasi bla tre kya riwa a ti wa kusan mba nga ikpa nji waka gre ye wari ye to kya riwa a ti. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Riwa wa ye ri Yeso waka to nji riwa a he ri ijɨbu meme bɨzhi ka kuson ri tsro ri kpa wan ri tu wan riri, waka ti sisiri. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Wawa wa to kya riwa a ti ri nji ri lilo meme bɨzhi nga wa dushu wa ko-a, waka ran la wawa wa ye ri bubu wan. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />Imba nji-a wa gra bre Yeso ri no ka meme mba don ri wa.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />Riwa Yeso a ran gra rimi mvu ima-a, nji ri meme bɨzhi ka bre Yeso ri no wawu hu hi ngawan. <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />Ama Yeso a ran nyɨme ri wu ran, ama ran tre ri,&lt;&lt;Bru hi ko wuri la miri vayi wen bibi kya riwa Bachi ti ri wu nga bibi rereriwa a ti ri wu.&gt;&gt; <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />Imba nji-a ka hi ngawan ran hi gra rimi gbu wuru ran gra ri la wa kya riwa Yeso ti ri wawu. Ngha nji waka ran ti sisiri.<verse eid="MRK 5:20" /></para>
  <para style="s">Yeso a ta Vra Riwa a Kuu Shɨme ran Den Waa ri Lilo</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Riwa Yeso a kɨma hi ri gran nne ri kuri wan, ijɨbu nji waka kagon wan ri nyu nne-a. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Inji ri rimi wa rinkon ri tra bubu kabru nji Yahuda ri riwa wa yo nde wa ri Yayirus, ka ye ri bubu riwa a to Yeso ran kɨbu mgbazhu ri kusi wan. <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />Ka sondu ran bre Yeso ri,&lt;&lt;Ivra won tsitsa a ran he si ran me bre wu ritu wu ri ye bre wu wo no fe si ran son ri sii.&gt;&gt; <verse eid="MRK 5:23" /><verse number="24" style="v" sid="MRK 5:24" />Imba Yeso ka hu wa hi ri ko-a. Ijɨbu nji waka hu wari ran ima-u. <verse eid="MRK 5:24" /><verse number="25" style="v" sid="MRK 5:25" />Iwa ri a he ri bubu wan riwa a ran zhu yii ri se wurudon hari. <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />Iwa-a a so yaa bran ri wo wawa wa de gbugblu nga ran wuu kongye riwa a he ri wu kre ritu riwa no fe si ama lilo-a ka sondu ran sro nga. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />Riwa iwa-a a wo tre Yeso ka dzu rimi jɨbu nji-a ran ye zhu kugon Yeso nga ran bre wo ri nyun tsro Yeso, <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />ritu a ran rimɨren rimi kpa wan ri,&lt;&lt;Ko wawu bre wo ri tsro wan kakre wawu ri fe sii.&gt;&gt; <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />Ri bubu wan izhu yii-a ka kukri nga ka wo rimi kpa wan iri wa den wawu.<verse eid="MRK 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 5:30" />Ri bubu wan Yeso ka wo ri kpa wan ri gbengbren ri zhu rimi kpa wan. Ka kɨma ya jɨbu nji ran miyen ri, &lt;&lt;ingha ri bre wo ri tsro won?&gt;&gt;<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />Imiri ndu wan waka tre ri,&lt;&lt;Wu to bibi riwa ijɨbu nji wa kagon wen ki, wu ri ri mɨyen ri ingaa bre wu wo?&gt;&gt; <verse eid="MRK 5:31" /><verse number="32" style="v" sid="MRK 5:32" />Ama Yeso ka sondu ran ya kagon ritu ran to ko ingaa nye bre wu wo. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />Imba iwa-a riwa a to kya riwa wa ti ri wu ka ye kɨbu mgbazhu kusi Yeso raa ran wiri kpa ritu sisiri, nga ran la Yeso kpunji tre iri wawu nye bre wu wo. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Yeso ka tre wu ri,&lt;&lt;Ivra won ikpanyɨme wen kpa-u chuwo. Hi ngawen ri sii kpa wa den kpa chuwo rimi lilo wen.&gt;&gt;<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />Riwa Yeso a ran tre nganyi, nji wari wa zhu ri ko Yayirus rinkon ri tra kabrutu riwa nji Yahuda wa ye wari tre ri,&lt;&lt;Ivra wen kuu ko ngye ti wu kawen ri wa tre ri nji ri tsro?&gt;&gt;<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />Yeso ka ran srenton ri kya riwa wa tre ran, ama ka la nji rinkon ri tra bubu kabrutu riwa nji Yahuda-a ri,&lt;&lt;Ran ti sisiri ran; kpanyɨme kakre.&gt;&gt; <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />Yeso a ran no njo no hu hi ri ko Yayirus ran ara Bitrus, ri Yakubu nga Yonana vayi Yakubu. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Riwa wa ke ri ko Yayirus Yeso ka to wa kpagro wari ri yii ko kutan. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Yeso ka gra rimi ko-a ran tre ri wa ri,&lt;&lt;Ritu ngye ko bi yii bi ri ri kpagra ko kutan? Ivra nyi ran kuu ran ari kru nna nye.&gt;&gt; <verse eid="MRK 5:39" /><verse number="40" style="v" sid="MRK 5:40" />Imba waka nza-u ri tsri, ka dzu wa zhu raa wawu ran yo ti vra-a ri yi vra-a nga wa miri ndu wan wawa wa he ri wu ri bubu wan, nga wari gra rimi tra riwa ivra-a he rimi wan. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />Yeso ka vu wo vra-a ran tre ri,&lt;&lt;Talita kumi!&gt;&gt;Riwa ari tre ri,&lt;&lt; Vi vra, walunde.&gt;&gt; <verse eid="MRK 5:41" /><verse number="42" style="v" sid="MRK 5:42" />Ri bubu wan ivra-a ka wulunde ran zren. Ise wan a he wuru don hari riwa a ti ngamba a waka gra ti sisiri bran bran. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Yeso ka fen wa ton ri no wa ran la njo kya riwa a ti ran, ran la wa ri no wa wa kya no ri.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">Wa Gbu Nazaret wa Kamba ri Yeso</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Imba Yeso a ka bubu wan don ran hi ri gbu wan, imiri ndu wan waka hu hi. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Riwa ivi sonvri ka ye, Yeso ka gbuchi ri tsro rimi tra bubu kabrutu nji Yahuda, nga riwa wa wo-u, waka gra ti sisiri wari ran tre ri,&lt;&lt;Inji nyi fe kyawa wa nyi ri minyi nye,&lt;&lt;Wiwiri bibi tan nye wa no riwa ari ti bibi kyawa wa de sisiri nyi ri wu? <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />Aran he nji ri kpan ko-a nye ran? A ran he vren Meremu nga vayi Yakubu ri Yusufu Yahuda nga Sima a ran miri vayi wan miri mba nye wa he ri ta rinyi ran,&gt;&gt; Imba waka ti fu ri wu. <verse eid="MRK 6:3" /><verse number="4" style="v" sid="MRK 6:4" />Yeso ka tre ri wa ri &lt;&lt;Wa no wa la tre Izhi mkpen ri ko kutan ara ri gbu wan ri miri vayi wan nga rimi ko wan nye wa ran ri no mkpen ran.&gt;&gt; <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />Yeso ka tre riwa ri &lt;&lt;Wa no wa la tre Izhi mkpen ri ko kutan ara ri gbu wan ri miri vayi wan nga rimi ko wan nye wa ran ri no mkpen ran.&gt;&gt; <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Yeso a ti sisiri ritu riwa wa ran he ri kpanyɨme ran.</para>
  <para style="s" vid="MRK 6:6">Yeso a ti Miri Ndu wan Wurudon hari Ndu</para>
  <para style="p" vid="MRK 6:6">Imba Yeso ka gra ri gbu ri gbu ran ran tsro. <verse eid="MRK 6:6" /><verse number="7" style="v" sid="MRK 6:7" />Imba Yeso ka yo miri ndu wan wuru don hari ran ti wa ndu wan hiha, ran no wa gbengbren ritu meme wu. <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />Ka la wa ri,&lt;&lt;Ran ban kyari ngɨzhi ritu hi zren mbɨ-a ran ne, ara kpala, ran ban kpo ri bre nkren ran, ran ban ri ran nga ran ban ko nkren ka ri kpo mbi ran. <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />Ama bi son ntan dza ka kre, ran ban tsro ri yonga ri riwa bi sun ri kpa ran. <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Iko riwa bi gra rimi wan bi ka ki ri bubu wan hi ri vi riwa bi ka gbu don. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />Bubu riwa bi hi wa kamba ri kpa yi, ko wa kamba ri wo yi, bi ka ka bubu wan don bi ri kpo meme ri mgbazhu mbi rega ri bubu wan ritu no he fen ton ri wa.&gt;&gt; <verse eid="MRK 6:11" /><verse number="12" style="v" sid="MRK 6:12" />Nghamba nye wa wulunde wari gra la tre Izhi iri no nji no wa ka meme ti mba chuwo. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />Wa zhu ri meme bɨzhi bran nga wari den wa lilo, wa gban nye ri tsitsri ri wa waka fe sii.<verse eid="MRK 6:13" /></para>
  <para style="s">Ikuu Yohana nji ri son nji tu ri ima.</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />Ichu Hirudus a wo tre-a riwa a shan ban kokutan. Wari wa tre ri,&lt;&lt;A he kɨmo Yohana nji ri son nji tu ima nye wa tashɨme ri kuu, ritu wan nye a he ri gbengbren ri ti wa kyawa wa de sisiri mba. &gt;&gt; <verse eid="MRK 6:14" /><verse number="15" style="v" sid="MRK 6:15" />Wari wa tre ri,&lt;&lt;A he iya nji ri la tre Izhi nye.&gt;&gt;Ngha wari wa bru tre ri,&lt;&lt;A he nji ri la tre Izhi ri nkan rimi wa la tre Izhi wa sen nye.&gt;&gt; <verse eid="MRK 6:15" /><verse number="16" style="v" sid="MRK 6:16" />Riwa Hirudus a wo tre-a ka tre ri,&lt;&lt;A he Yohana nye riwa me hwen-u tu-a nye wa ta shɨme ri kuu.&gt;&gt; <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />Hirudus ri tuwan a no wa wa vu Yohana nga ran lo-u yo ri tra tren. Hirudus a ti nga nyi ritu Hirudiya, iwa vayi wan Filibu, riwa wawu Hirudus a gran wu. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Ritu Yohana a ran la Hirudus ri sen iri,&lt;&lt;A ran bi riwa wu gran wa vayi wen ran.&gt;&gt; <verse eid="MRK 6:18" /><verse number="19" style="v" sid="MRK 6:19" />Hirudiya a he ri fu Yohana rimi sron wan, riwa a ran wa ran wuu Yohana ama a ran fe nkon ran, <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />ritu Hirudus a ran ti sisiri Yohana, a to ri a he nji ri dindi ti nga nji ri tstsri, nga ran milan-u ngɨzhi. A sondu ran suu Hirudus sron ka a wo Yohana ri tre ri wu ama ka hu ri nga mba a ran sii-u sron ka a wo tre wan. <verse eid="MRK 6:20" /><verse number="21" style="v" sid="MRK 6:21" />Ri kre wan Hirudiya a fe nkon chachu taka vi ngɨzhi Hirudus, a ro ritu wa hakimi wan ri wa chu, ri wa rinkon wa klukpa wan nga wa rinkon wa gbu Galili <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />Riwa ivra Hirudiya a gra ran nglu ri kusi Hirudus nga wa tsren wan. Ichu Hirudus ka miyen vra-a ri&lt;&lt;Ingye nye wu wa me ti ri wu? kongye riwa wu miyen, me ti-u ri wu.&gt;&gt; <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Kau ri shizhi ichu a shi ri vra-a ri,&lt;&lt;Ko ngye riwa wu miyen me no-u, ko ran he iŋɨma kpanchi son won nye.&gt;&gt; <verse eid="MRK 6:23" /><verse number="24" style="v" sid="MRK 6:24" />Ivra-a ka zhu hi raa ran miyen yi wan ri,&lt;&lt;Ingye nye me miyen,&gt;&gt; Iyi wan ka tre ri,&lt;&lt;Miyen tu Yohana nji ri son nji tu ri ima.&gt;&gt;<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />Ri bubu wan ka wulutsu bru hi ri chu ran ka la-u ri,&lt;&lt;Me wa zizan-en wuri no wen tu Yohana nji ri son nji tu ri ima rimi bibɨre!&gt;&gt; <verse eid="MRK 6:25" /><verse number="26" style="v" sid="MRK 6:26" />Ri wo ngamba, ichu ka ti shnji sron bran, ama ritu shizhi riwa a shi nga ritu wa tsren wan-a a ran wa ran ka ŋyo-u ran. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Ka ti nji ri ndu wan ndu hi iri no hi ran ngɨzhi tu Yohana ye, nji-a ka hi ran ka hwen tu Yohana ri tra tren, <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />a ngɨzhi-u rimi bibɨre ye ran ka no vra-a, wawu vra-a ka kpa ka no yi wan. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />Riwa miri ndu Yohana wa wo ngamba, waka ye wari ban kɨmo Yohana hi ka no yɨbi.<verse eid="MRK 6:29" /></para>
  <para style="s">Yeso a No Nji Ngo Ton Rii</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Wa ndu Yeso wawa a ti wa ndu ri sen wa kɨma hi ri wu wari la kya riwa wawa wa ti nga kya riwa wawa wa tsro. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Inji kigbu wa ran ye wari ran hi riwa wa ndu wan a ran fe nkon riwa wa ri kya ran, Yeso ka la wa ri.&lt;&lt;Biyi ye ki hi ki ri bubu riwa njo ran he ri bubu wan ran, ritu bi ri son vri tsawen.&gt;&gt; <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />Imba waka gra ri mvu ima wa ri hi ri bubu riwa injo ran he ri bubu wan ran ara wawa nkankshi mba. <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />Ama riwa wa ka bubu wan ran don nji wari kigbu waka to wa tse wari hu ri kutu gashi wari ran tsutsu ri dza zhu ri wa gbu wari ka zhu ri bubu wan ko wawa. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />Ri zhu Yeso ri bubu wan tse ka to ijɨbu nji wa ki ri bubu wan nga waka loo sron, ritu wa he ka intɨma wawa wa ran he ri nji ri kɨshu wa ran ka gra ri tsro wa kyawa kigbu. <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />Ri zhu Yeso ri bubu wan tse ka to ijɨbu nji wa ki ri bubu wan nga waka lo sron, ritu wa he ka intɨma wa wa wa ran he ri nji ri kɨshu wa ran ka gra ri tsro wa kyawa kigbu. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />Ama Yeso ka nyɨme wa ran tre ri, Biyi no wa kya riwa wa ri wa ka tre wu ri ki hi reri ri nkren kigbu riwa wa ndu nyi kiri ka no wa ri?&gt;&gt; <verse eid="MRK 6:36" /><verse number="37" style="v" sid="MRK 6:37" />Ama Yeso ka nyɨme wa ran tre ri,&lt;&lt; Biyi no wa kya riwa wa ri &gt;&gt;Wa ka tre wu ri, &lt;&lt;Ki hi reri ri nkren kigbu riwa wa ndu ri hwa tandra nyi kiri ka no wa ri?&gt;&gt; <verse eid="MRK 6:37" /><verse number="38" style="v" sid="MRK 6:38" />Yeso ka tre ri wa ri,&lt;&lt;Jujuyɨmo bren bi he ri wu?Hi bi ri ya to, riwa wa ka ya wa ye la-u ri, jujuyɨmo hari nye nga lambe hari.&gt;&gt; <verse eid="MRK 6:38" /><verse number="39" style="v" sid="MRK 6:39" />Imba Yeso ka no miri ndu wa no wa no nji no wa kuki ri tu shushu giga ri gbu gbu. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Imba waka kuki ri gbu ri gbu, wari wa he ngbɨre gbigba ri nga wari wa he ngbɨre seton.&gt;&gt; <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />Yeso ka ban jujuyɨmo ton-a nga lambe hari-a ran nzu-u ban shu, ran ngɨri ri Izhi, ran fran ran no miri ndu wan wa ngɨzhi hi ran ga nji nga ran ga lambe hari-a wawu ri nji. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Ijɨbu nji-a waka ri wari hwɨshi, <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />hari wari tan zhuzhu wan shu rimi sisen wuru don hari. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Inji wawa wa ri ri-a wa he ronron ngo ton nye.&gt;&gt;<verse eid="MRK 6:44" /></para>
  <para style="s">Yeso a Zren ri tu Mma</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Ri bubu wan Yeso ka no miri ndu wan wa gra rimi mvu ima wari gbuchi rugran nne ran hi ri Batsaida. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Kugon riwa a no wa jɨbu nji-a hi ngamba, ka hon ri tu gashi riwa ari bre Izhi. <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />Riwa yawulu a ti, mvu ima-a ka he ri tsutsu ima nne-a, nga Yeso ka he ritu gashi nkankshi wan. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />Riwa Yeso a to miri ndu wan wa ran so yaa ri tru mvu ima ritu ngungu a ran fu wa, a he ri bubu mibrenye, nga wa to-u a ri ye ri wa, a ran zren ri tu ima nne, ka ti zhu ka ari vu wa yɨba. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />Ama riwa wa to-u ari zren ri tu ima tse waka yonga a he zhinji nye waka kpagro. <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />Ritu wawu mba wa to-u wari ti sisiri. Ri bubu wan Yeso ka tre ri wa ri &lt;&lt;Vu sron ran ti sisiri ran a he ame nye.&gt;&gt; <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />Imba Yeso ka gra ri wa rimi mvu ima-a nga ngungu-a ka ku kri. Tse sisiri ka ti wa wawu mba, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />ritu wa ran to tu no nji ŋgo ton jujuyɨmo nga lambe-a ran, isron mba a ran to tu tre wan ran. <verse eid="MRK 6:52" /><verse number="53" style="v" sid="MRK 6:53" />Riwa wa Yeso nga miri ndu wan wa ru gran nne-a waka hi gɨzhi ri gbu Janisarat, wari lo mvu ima-a ri nyun nne. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Ri zhu mba rimi mvu ima-a ri bubu wan nji waka to iri a he Yeso nye. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />Waka sondu ran tsutsu ri ko kutan ri gbu wari sondu ran vu wa lilo rimi bubu kru mba ran ye ri bubu riwa wa wo ri Yeso he ri bubu wan. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Ngha ko kutan riwa Yeso hi ri vi gbu ka nchon gbu, ko ri zhu nji wa vu wa lilo mba hi ri bubu richu wari ran bre Yeso ri no wa lilo-a no wa bre wo ri nyu tsro wan, wawa wa bre wu wo wa fe sii wa wu mba.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">Ikya riwa a he tsitsri ngan kya riwa a ran he tsitsri ran.</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />Farisa wari nga wa tsro doka Musa wawa wa zhu ri Urushalima wa ye, kagon Yeso ki nga, <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />wa ri to ri imiri ndu wan wari wa ri ri ri wo riwa a ,&lt;&lt;ti zhii.&gt;&gt; Wa tre ritu wo riwa wa ran ngla-u bibi riwa ki ti ran. <verse eid="MRK 7:2" /><verse number="3" style="v" sid="MRK 7:3" />Ingye Farisa nga mgbron nji Yahuda wa ran ri ri ri ran tse wa milan wo ngla bibi ti wa rinkon mba. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />Ka wa zhu ri richu ye, wa ran ri ri ran tse wa ngla kpa ri nga wa hu bibi ti wari kigbu riwa wa hu, woto wa ngla vaŋo ri so ima, wa rii nga vaja.<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />Farisa nga wa tsro doka Musa waka miyen Yeso ri,&lt;&lt;Ritu ngye ko wa mirindu wan wa ran ri hu tre wa rinkon ran wa ri ri ri wo ji?&gt;&gt;<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />Yeso ka nyɨme wa ri,&lt;&lt;Ishaya nji ri la tre ri kusi a la tsra ritu biyi wa meme sron; bibi riwa a he rimi ngan ri,</para>
  <para style="q1" vid="MRK 7:6">&lt;Inji wa nyɨme tre won dzu nyun nye ka kre wa no wen mkpen ama isron mba he kpata ri me.<verse eid="MRK 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 7:7" />Wa gbre wen ri kukulu kakre itsro mba he ritu bibi ti nji zhu mba ka a he tre Izhi!&gt;<verse eid="MRK 7:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MRK 7:8" />Bi ka tre Izhi dzi ri gran bi ri ri hu tre riwa nji.&gt;&gt;<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />Yeso ka tre wa ri,&lt;&lt;Bi kambi ri hu tre Izhi ritu bi ri hu riwa wa titimbi nye! <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />Musa a tre ri,&lt;No tiwen mba yi wen mkpen,&gt;Nga,&lt;Inji riwa a kra ti wan ko yi wan ritu no wa wuu-u.&gt; <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />Ama bi tre ri a tsra riwa ka wa tiwan wa miyen-u kya a ran no wa ran, ritu a ka dzi ri sron wan iri wawu ri ka no Izhi ikya riwa a hi ran ka ran no wa, <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />Ri ngamba bi dzu ri dzon wa ti wan. <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />Ri ngamba nye bi wu tre Izhi ritu bi ri tsro wari bibi ti mbi, ngamba nye bi ti kyawa kigbu.&gt;&gt;<verse eid="MRK 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />Yeso ka bru yo jɨbu nji ran la wa ri,&lt;&lt;Biyi wo wen wawu mbi nga bi ri to. <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />Aran kya riwa a gra ri kpa nji nye ri kpaa zuu Kusi Izhi ran, ama ikya riwa a zhu ri nyu nji nye ri kpa zuu Kusi Izhi.&gt;&gt; <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />Inji riwa a he ri ton ri wo no wo.<verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />Riwa Yeso a ka jɨbunji-a don ran gra ri ko, imri ndu wan waka miyen-u ri no la wawa tu tsro nye. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Yeso ka miyen wa ri,&lt;&lt;Biyi ngawen bi ran to ran me, <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />ritu a ran rimi sron wen nye ari gra ran ama rimi nne wen nye, nga ran zhu ri nyun wan &gt;&gt;Rimi tre nye Yeso tsro iri ko ri bibi tan ran zuu Ri ku si Izhi ran.<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />Yeso ka bru tre ri,&lt;&lt;Ikya riwa a zhu ri nyu nji nye ri kpa zuu. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />Ritu rimi sron nji nye meme rimɨren ri zhu ye ntran, ri yɨbi nga wuu nji mba kru mba nji, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />Imbye, nga meme ti, nga gyuru nji, nga sron ri ro riwa a ran he ri shan ran, nga ti huu, nga kpa nde time, nga ndzu tu, nga ti mkpran. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />Meme kyawa wa nyi wa zhu rimi sron nji nye ye, nga wa ri kpa nji zuu.&gt;&gt;<verse eid="MRK 7:23" /></para>
  <para style="s">Yosron Wa riwa a he waa Yudiya ran</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Imba Yeso ka wulunde ran hi ri gran meme Taya. A gra ri ko a ran wa no njo no to ran Ama igra wan a ran he ri yayɨbi ngaran. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />Ri bubu wan iwa ri riwa ivra wan tsitsa a he ri lilo meme Yuu ka wo tre Yeso ran ye kɨbu mgbazhu ri kusi wan. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Iwa mba a he wa Heleni nye, wa ngɨzhi-u ri Finikiya ri gbu Suriya a bre Yeso ri no dzu meme bɨzhi zho ri vra wan. <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />Yeso ka la ri wu ri, no miri no wa ri hwɨshi ri, a ran tsra riwa ki vu ri miri ka sro ri yawu ran. &gt;&gt;<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />Iwa-a ka nyɨme ran tre ri,&lt;&lt;A he ngamba nye Bachi, ama ko yawu wa ye waka ye tan zhuzhu wan riwa a rega ri&gt;&gt; <verse eid="MRK 7:28" /><verse number="29" style="v" sid="MRK 7:29" />Yeso ka la-u ri ,&lt;&lt;Ritu nyɨme nyi riwa wu he ri wu, bru hi ko, meme bɨzhi ka vra wen don!<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />Ka bru hi ko ran ka to vra wan-a kru ri blaa, nga meme Yuu-a ka ka-u don.<verse eid="MRK 7:30" /></para>
  <para style="s">Yeso a den Mangbi nga Mangbi</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Yeso ka zhu ri gbu Taya ran hu ku Sidon hi ri nne ri Galili ri nkon a hu ri gbu wuru. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Ri bubu wan wa ngiji nji ri riwa a ran ran to tre ran ye ri wu nga wari bre Yeso ri no bre wu wo no fe sii.<verse eid="MRK 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 7:33" />Yeso ka ban mangbi-a hi ri gran bubu riwa nji wa ran bran ran, ka son miri wo ri ton. Ka zhu nten ran ibrenji-a wo ri rɨme. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Ka ndzu tu ban shu ran gbi vri wan ran tre nji-a ri,&lt;&lt;Iffata!&gt;&gt;Ari tre ri,&lt;&lt;No bu.&gt;&gt; <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />Riwa a tre ngamba iton nji-a ka bu, ikya riwa a lo rɨme wan a ka si, nga nji-a ka gra tre ran bi<verse eid="MRK 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 7:36" />Kau ri riwa Yeso a fen wa ton ri no wa ran la njo ran. Ama riwa a ran fen wa ton wawa waka sondu ran vra tre-a. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Inji wa ti sisiri bran, wari tre ri,&lt;&lt;A ti ko ngye tsra,&gt;&gt;&lt;&lt;A no mangbi wa wo tre nga ran no mangbi wa to tre.&gt;&gt;<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">Yeso a no nji ngo nza ri</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />Chachu ri, ijɨbu nji wa bru ye kabrutu. Riwa wa ran he ri kya riwa wa ri ran, Yeso ka yo miri ndu wan ran la wa ri, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />&lt;&lt;Me losron ri nji wanyi ivi ri tra luwa wa he ri me nga wa ran he ri kya riwa wa ri ran. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />Ka me no wa hi ngamba ri yon, wari mba wa joku ri nkon ritu wari mba wa zhu ri nkon kpata.&gt;&gt;<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />Imiri ndu wan waka nyɨme wari tre ri,&lt;&lt;Ri tsutsu ji nyi ki fe ri ri minyi riwa ari ke jɨbu nji wanyi?&gt;&gt;<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />Yeso ka miyen wa ri&lt;&lt;Bi he ri jujuyɨmo bren waka tre ri.&gt;&gt;</para>
  <para style="p" vid="MRK 8:5">&lt;&lt;Ngbɨre tangban.&gt;&gt;<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />Yeso ka la jɨbu nji-a ri no wa kuki ri meme. Ka ban jujuyɨmo tangban-a ran ndzu ban shu ran ngɨri ri Izhi, ran fran ga miri ndu wan waka kpa ran ga nji nga waka ga nji wawu. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />Wa he ri vi lambe tsawen, ka ngɨri ri Izhi ritu lambe-a ngawen ran tre no wa ka ga nji. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Ko ngaa ka ri ran hwɨshi nga miri ndu Yeso wa tan zhuzhu wan riwa wa kadon ka shu rimi sisen tangban. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />Inji wawa wa ri ri-a wa he ngo nza nga ka no wa hi ngamba, <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />Waka gra rimi mvu ima iwawa miri ndu wan wari hi ri Dalmanuta.<verse eid="MRK 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />Farisa wa ye wari gra miyen Yeso ri wa wa wari tsra Yeso, wa miyen-u ri no ti kya riwa ari tsro gbengbren wan. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />Yeso ka vri a chu vri ran tre ri&lt;&lt;Ritu ngye ko biyi nji wa nzan nyi bi wa bi ri to kya ri de sisiri? Kpunji tre me layi biyi nji wa nza nyi wa ran la yi ko kya ri ran.&gt;&gt; <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />Imba Yeso ka ka wa don ri bubu wan ran ka gra rimi mvu ima ran rugran hi k u gran ri wan.<verse eid="MRK 8:13" /></para>
  <para style="s">Mumu ri kpa kpi fu riwa Farisa nga wa Hirudus</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Imiri ndu Yeso waka ti wulusu wari ran ngɨzhi jujuyɨmo bran ran ara ngbɨre riri gyen riwa a he rimi mvu ima. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />Yeso ka gbi wa ton ran tre ri,&lt;&lt;Bi ti rere milan ya mumu ri kpa kpi tu riwa Farisa nga Hirudus.&gt;&gt;<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />Imiri ndu wan waka ran tre ri ngamba ri,&lt;&lt;Ka ritu riwa ki ran he ri jujuyɨmo nye ran ko ari tre nganyi?&gt;&gt;<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />Riwa Yeso a wo kya riwa wa tre ka miyen wa ri,&lt;&lt;Ingye ti ko bi tre ritu bi ran he ri jujuyɨmo ran? ye zizan bi ran to ran isron mbi he kpekpe? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />Bi he ri si ama bi ran ri to tsu ran? nga bi he ri ton ama bi ran ri wo tre ri wu ran? Bi ran ri taka ran? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />Ri vi riwa me chiwa jujuyɨmo ton no nji ngo ton-a bi vu mgbron wan shu rimi sisen bren? Waka nyɨme ri,&gt;&gt;</para>
  <para style="p" vid="MRK 8:19">&lt;&lt;Sisen wuru don hari!&gt;&gt;<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />&lt;&lt;Ngha ri vi riwa me chiwa jujuyɨmo tamgban no nji ngo nza-a bi vu mgbron zhuzhu wan shu ri sisen bren?&gt;&gt;Waka tre ri,&lt;&lt;Sisen tamgban.&gt;&gt;<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />Yeso ka bru miyen wa ri,&lt;&lt;Ye zizan bi kambi ran to ran?&gt;&gt;<verse eid="MRK 8:21" /></para>
  <para style="s">Yeso a den nji ri mfyen ri meme Batsaida</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Riwa Yeso wa ye zhu ri Batsaida nji wa ri wa ngɨzhi nji ri mfyen ri ye ri Yeso wari bre wu ri no ibrenji ri mfyen a wo no fe to tsu. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Yeso ka vu wo nji ri mfyen ran ngɨzhi-u hi ri kugon gbu ban wo sa-u ran miyen-u ri,&lt;&lt;Wu to kyari zizan?&gt;&gt; <verse eid="MRK 8:23" /><verse number="24" style="v" sid="MRK 8:24" />Inji ri mfyen-a ka nzu si ya ran tre ri,&lt;&lt;Me to nji ama wa he ka konkron wa zren.&gt;&gt;<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />Yeso ka bru sawo ri nji-a ri sii nganga nji-a ka bu si ya ran to ko ngye ka kpan. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Yeso ka la-u ri no kɨma hi ko ran la-u ri no bru hu ku vi gbu ngaran.&gt;&gt;<verse eid="MRK 8:26" /></para>
  <para style="s">Bitrus a la ri Yeso he Kristo</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Riwa Yeso nga miri ndu wan wa he ri nkon hi meme Kaisariya Filibi, ri nkon riwa wa ran hi Yeso ka miyen wa ri,&lt;&lt;Inji wa ban wen ri me he ngaa nye?&gt;&gt;<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />Waka nyɨme ri,&lt;&lt;Wari wa tre ri wu he Yohana nji ri son nji tu ima nye, nga wari wa tre ri wu he iri rimi wa la tre Izhi nye.&gt;&gt;<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />Yeso ka miyen wa ri,&lt;&lt;Ko biyi bi tre ri me he ngaa?&gt;&gt;Bitrus ka tre ri,&lt;&lt;A wu wu he Kristo nye.&gt;&gt;<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />Yeso ka fen wa ton ri no wa ran la njo kya ritu wan ran.<verse eid="MRK 8:30" /></para>
  <para style="s">Yeso a la tre Kuu Wan</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Imba Yeso ka gra tsro miri ndu wan bibi riwa ivren nji ri so yaa bran bran nga wa wa rinkon gbu, rinkon wa sro yii,ri wa tsro doka Musa wa kamba ri wu nga wa wu-u ari ti vi tra ran tashɨme. <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Yeso a tre tre nyi ri riri nga Bitrus ka hu hi ri gran ran ka si tre.<verse eid="MRK 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33" />Ama Yeso ka ndzu si ya mgbron miri ndu wan ran tre Bitrus ri,&lt;&lt;Tsirinkon don wen a wu meme nji!&gt;&gt;Ran tre ri irimɨren wan he wa nji a ran wa Izhi ran.&gt;&gt;<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />Imba Yeso ka yo jɨbu nji ye kabru ri miri ndu wan ran la wa ri,&lt;&lt;Inji riwa ari wa ran hu wen, no kawan ri ngawan ran ban mkpon konkron wan ran hu wen. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />Inji riwa ari wa ran kpa nga wan chuwo a ran fe kpa chuwo ran, nji riwa a hon vri wan ritu won nga ritu tre raro-a, ari fe kpaa chuwo. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Ingye nye ri he bi wan ka wu fe kongye ri mgbumgblume nyi wu ri ran fe vri ran? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Ingye nye nji ri to de ri nyu vri wan? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />Inji riwa a tishan won ran tishan tre won ri nzan nyi riwa a ran ri ngɨzhi to Izhi riwa wa ran to-u ran, nga ti meme ti bran, ame ivren nji me tishan wen ngawen ri vi riwa me ye ri mkpen ti won ri miri ko Izhi wa tsitsri.&gt;&gt;<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Yeso ka la wa ri,&lt;&lt;Kpunji tre me layi, wari rimi mbi wa ran kuu ran tse kpanchi Izhi ye ri gbengbren wan.&gt;&gt;<verse eid="MRK 9:1" /></para>
  <para style="s">Isran kpa Yeso</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />Kugon vi tanren Yeso ka gbu Bitrus ri Yakubu nga Yohana hi ri tu mgblu, ri bubu wan wa he nkankshe mba, wa he ri bubu wan ikpa Yeso ka sran kinklan pyapya ri kusi mba wawu. <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />Itsro wan ka kɨma he kinklan ran ran kpan riri bibi ri wa injo ran ri to ngla-u no he ngamba ri mgbumgblume nyi ran. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Tse wa la tre ri kusi hari lliya nga Musa waka zhu ri wa wari ran tre ri Yeso.<verse eid="MRK 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5" />Bitrus ka tre ri Yeso ri,&lt;&lt;Inji ri tsro a bi riwa ki he ri nyi no ta ki ti bru ti tra, iri ri he wa me iri ri he wa Musa nga ri ka he wa lliya.&gt;&gt; <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />Aran to kya riwa ari tre ran nye ritu wawu ri mgbron mba wa ran ti sisiri bran.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />Ikpawulu ka zhu ran ye ka wa si, iraan ka zhu rimi kpa wulu-a ye ri,&lt;&lt;Rinyi he vren won riwa me nyɨme-u, bi wo-u!&gt;&gt;<verse eid="MRK 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 9:8" />Ri bubu wan waka ndzu si ya wa ran to njo ngaran ka ra Yeso.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />Riwa wa ran gre ri tu mgblu, Yeso ka gbi wa ton ran tre ri no wa ran la njo kya ri wa wa to ran tse chachu riwa ivren nji tashɨme ri bubu gru. <verse eid="MRK 9:9" /><verse number="10" style="v" sid="MRK 9:10" />Wa ka tre-a chuwo wari ran miyen ngamba ri ingye nye Yeso ri tre ritu,&lt;&lt;Tashɨme ri bubu gru.&gt;&gt;<verse eid="MRK 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11" />Ngha imiri ndu Yeso waka miyen-u ri,&lt;&lt;Ritu ngye ko wa tsro doka Musa wa tre ri Iliya ri gbuchi ye ri?&gt;&gt;<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />Yeso ka la wa ri,&lt;&lt;Kpunji tre nye Iliya ri gbuchi ye ran milan kongye ti ri. Ama a ran he rimi ngan mbe Izhi iri ivren nji ri so yaa bran nga wa kamba ri wu ran? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Ama me la yi Iliya-a riga ka ye-e nga nji wa ti-u kya riwa isron mba su bibi riwa wa ngan ri mbe ritu wan. &gt;&gt;<verse eid="MRK 9:13" /></para>
  <para style="s">Yeso a Den Vren ri Lilo Meme Yuu</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Riwa wa Yeso nga miri ndu wan wa bru ye fe mgbron mba tse waka to jɨbu nji wa kagon ki wa tsro doka Musa waka ran jan nyu ri wa. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Riwa ijɨbu nji-a wa nzu si to Yeso waka ti sisiri bran, waka wulunde tsutsu ye tre ri wu.<verse eid="MRK 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 9:16" />Yeso ka miyen wa ri,&lt;&lt;Bi janyu ngye iwawa?&gt;&gt;<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />Inji ri rimi jɨbu nji-a ka tre ri,&lt;&lt;Inji ri tsro me ngɨzhi vren won ye ri wu ritu a he ri lilo meme wu a ran ri to tre ran. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Ri vi riwa lilo-a wulunde ri wu, ari ban wu taga ri meme ari no si funfon ri nyu ran ran tan ŋɨri, nga ran ran nɨme ngawan. Me miyen miri ndu wen no wa chu meme yu zho waka ran to ti-u ran.&gt;&gt;<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />Yeso ka tre wa ri,&lt;&lt;Biyi nji wa nzan nyi wawa bi ran he ri kpanyɨme ran, me son ri yi hi shitan nye? Me vu sron ri yi hi ri shitan? Ngɨzhi vren-a ye no wen.&gt;&gt;<verse eid="MRK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 9:20" />Waka ngɨzhi vren-a ye ri Yeso, riwa iyu meme-a a to Yeso, ka wuru vren-a taga ri meme ikpa wan ka ran wɨri, inyu wan ka ran funfon.<verse eid="MRK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21" />Yeso ka miyen ti vren-a ri,&lt;&lt;Tu shitan nye ikya nyi vu?&gt;&gt; Ngha iti vren-a ka tre ri,&lt;&lt;A vu tu ri vren.&gt;&gt; <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />&lt;&lt;Ari si wuru-u taga rimi wulu ko rimi ima, ritu ran wu-u nye. Ama ka wu to ti kyari wuka losron ri ta wu ri dzon ta.&gt;&gt;<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />Yeso ka la-u ri,&lt;&lt;Ritu ngye ko wu miyen ri ko me to ti? Ko ngye ri he hwri ri nji riwa a kpanyɨme.&gt;&gt;<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />Ri bubu wan iti vren-a ka nzu ran ran tre ri,&lt;&lt;Me he ri kpanyɨme; dzon wen no kpanyɨme won no bran!&gt;&gt;<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />Riwa Yeso a to jɨbu nji wa ran ye hyure ri wu ri tsu ka yira meme yu ngaa ri,&lt;&lt;A wu meme wu mba riwa wu dzu vren nji ri tre me wa no zhu ka-u don ran bru ye gra wu ri kpa ngaran.&gt;&gt;<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />Meme yu ka kpagro ran gɨzhu vren-a bran ran zhu hi ngawan ivren-a ka kru ka ikɨmo, ijɨbu nji-a wa ran tre ri,&lt;&lt;Ivren-a kuu.&gt;&gt; <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Ama Yeso ka vu wo ran nzu-u ka wulunde son nde.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />Riwa Yeso a gra rimi ko, imiri ndu wan waka miyen-u ri yayɨbi ri,&lt;&lt;Ritu ngye ko kita ki ran to dzu yu ran?&gt;&gt;<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />Yeso ka la wa ri,&lt;&lt;Bibi wu nyi ran ri zhu ran tse ri bre Izhi.&gt;&gt;<verse eid="MRK 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Yeso iwawa miri ndu wan wa ka bubu wan don wari hu ku meme Galili, Yeso ka ran wa no njo to bubu riwa wa he ran, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />ritu a ran tsro miri ndu wan ri,&lt;&lt;Wa ka vren nji de ri wo nji, wa wu-u nga ari ti vi tra ran tashɨme.&gt;&gt; <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />Ama wa ran to tu kya riwa a ran tre ritu wan ran nga wa ran ti sisiri riwa wa miyen-u.<verse eid="MRK 9:32" /></para>
  <para style="s">Inga Nyen he Rinkon?</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />Riwa wa Yeso nga miri ndu wan Waka zhu ri Kafarnaum. Riwa Yeso a gra ri ko ka miyen miri ndu wan ri&lt;&lt;Ritu ngye nye bi si janyu ri nkon?&gt;&gt; <verse eid="MRK 9:33" /><verse number="34" style="v" sid="MRK 9:34" />Ama waka ki mgbi yoon ritu wa janyu ri nkon ko ingaa nye he rinkon rimi mba.<verse eid="MRK 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 9:35" />Yeso ka kuson meme, ran yo miri ndu wan waru don hari ye ri ngawan ran la wa ri,&lt;&lt;Inji riwa ari wa ran he ri mimilan, dole no kɨma ngawan ti krenkpen wawu no ti ndu ri ko ngaa.&gt;&gt;<verse eid="MRK 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36" />Yeso ka ban vren tsitsa ka dzi ri tsutsu mba. Ka ban wu sa mgban ran la wa ri. <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />&lt;&lt;Inji riwa a kpa vren tsitsa ka ri nyi rimi nde won a he ame nye a kpa, nji riwa a kpa wen a ran ame nye a kpa ran a he nji riwa a ti wen ndu nye a kpa.<verse eid="MRK 9:37" /></para>
  <para style="s">Nji Riwa a ran Yo ta Kusi ran a he Wambu</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />Ri bubu wan Yohana ka la-u ri&lt;&lt;Inji ri tsro ki to nji ri ri zhu bɨzhi rimi nde wen, nga ki dzu ritu a ran he wambu ran.&gt;&gt;<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />Yeso ka tre wa ri,&lt;&lt; Ran dzu ran.&lt;&lt;Injo ran ti kya ri de sisiri rimi nde won ran bru tre tre meme ritu won ri bubu wan ran, <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />Inji riwa a ran yo ta kusi ran a he wambu. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />Me la yi kpunji tre, nji riwa a no yi ima ri so rimi nde won ritu bi he wa Kristo, me la yi a ran hon fe kya ran.<verse eid="MRK 9:41" /></para>
  <para style="s">Kyawa wa no Nji no ti Memeti</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />&lt;&lt;A ri he kya ri losron ri nji riwa ari no ri rimi miri wa tsitsa nyi wawa wa kpa nyime ri me nyi no ti meme ti ari bi han ri wu no wa ban nɨran ri kon ka lo ri wu ri to wari ban wu ta yo rimi ima ri nne. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />Ka iwo wen ri no-u ti meme ti wuka han-u taga, ari bi riwa wu hi ko Izhi ri wo riri riwa wu he ri wo hari wuri hi ko wulu riwa wa ran to yɨbi-u ran. <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />Ri bubu wan ikpanji wawa wa ri nji wa ran ri kuu ran iwulu ran ri huu wa ran. <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />Ngha ka idza wen ri no-u ti meme ti wu ka han-u taga ari bi riwa wu gra ri ko Izhi ri dza riri riwa wu gra ri ko wulu ri dza hari. <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />Ri bubu wan kpanji wawa wa ri nji wa ran ri kuu ran iwulu ran ri huu wa ran. <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />Ka isi wen ri no-u ti meme ti wuka chu wu taga. Ritu ari bi riwa wu hi ko Izhi ri si riri riwa wu gra ko wulu ri sii hari, <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />ri bubu wan, &lt;kpaji wawa wa ri nji wa ran ri kuu ran,&gt;</para>
  <para style="q2" vid="MRK 9:48">nga iwulu ran ri hu wa ran nga wa ran to yɨbi wulu-a ran.&gt;<verse eid="MRK 9:48" /></para>
  <para style="m">
    <verse number="49" style="v" sid="MRK 9:49" />Wa tsri ko ngaa ri wulu bibi riwa wa tsri sro yi ri maa.<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />&lt;&lt;Imaa bi, ama ka iro wan zhu zho wu ti ri se wu ri kɨma-u nbru ro nganga? Imaa ri sron mbi bi ri kii ri sikpa ri ngambi.&gt;&gt;<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">Yeso a Tsro Ritu Wuu Gran</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Rimba Yeso ka ka Kafanahum don ran hi kugran Yodan inga ijɨbu nji wa bru kabru ri wu ka ran tsro wa bibi riwa a si ti<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />Farisa wari waka ye ri wu ritu wari tsra-u, waka miyen-u ri,&lt;&lt;Bibi riwa a he ri doka Musa ari bi no nji no dzu wa wa wan?&gt;&gt;<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />Yeso ka nyɨme wari&lt;&lt;Doka ritan nye Musa no yi?&gt;&gt;<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />Waka la-u ri,&lt;&lt;Musa la ri nji to ngan mbe ri wuu gran no wa wan ran dzu no hi nga wan.&gt;&gt;<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />Yeso ka tre wa ri,&lt;&lt;Ritu sentu mbi nye Musa ngan doka mba ri yi, <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />ama ri mimɨlan ti wa kyawa wa mgbumgblume,&lt; Izhi a ti wa iwa mba ronron.&gt; <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />&lt;Ritu ngamba nji ri ka tiwan nga yi wan don ran ka ngawan ngan ri wa wan.&gt;&gt; <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />Ri mba hari mba wa he riri a ran he ka wa hari ngaran.&gt;&gt; <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Ritu ngamba, ikya riwa Izhi kawa kabru, no njo no ran ga wa ran.<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />Riwa wa he rimi ko imiriko wan waka miyen-u ritu tre nyi. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />Yeso ka tre wa ri,&lt;&lt;Inji riwa a ka wa wan chuwo ran kpa wari nkan, ari ti meme ti ri kru ri wa riwa a ran he wama ran-nye mba. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />nga inde iwa ka ron wan don ran gran ronron ri nkan ari ti meme ti ri kru ri ronron riwa a ran he wa ma ran nye mba.&gt;&gt;<verse eid="MRK 10:12" /></para>
  <para style="s">Yeso a ti Lɨbu Ndindi sro Miri wa Tsitsa</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Inji wa sondu ngiji miri wa tsitsa ran ye ri no Yeso ti lɨbu ndindi sro wa, ama imiri ndu wan wa ka ven ri wa. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />Riwa Yeso a to ngamba ran ti fu ri wa ran tre ri,&lt;&lt;Ka miri wa tsitsa chuwo no wa ye ri me, ran dzu wa ran ritu kpanchi riwa zhi he wa bibi mba nye. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />Kpunji tre me layi, nji riwa a ran kpa kpanchi Izhi bibi riwa ivren tsitsa ri ti ran, a ran gra rimi wan ran.&gt;&gt; <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Imba ka vu miri-a ran ran bre wa wo, ran ran ti lɨbu ran sro wa.<verse eid="MRK 10:16" /></para>
  <para style="s">Inji riwa a he ri woo</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Riwa Yeso a hi ran hi ri Urushalima, ivrenze ri ka wurutsu ye kɨbu mgbazhu kusi wan ran miyen-u ri,&lt;&lt;Inji ri tsro ndindi, me ti se ko me rivri riwa a ran kre ran?&gt;&gt;<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />Inba Yeso ka miyen-u ri,&lt;&lt;Ingye ti ko wu tre ri me he nji ri ndindi? Injo ran he ndindi ran ara Izhi nye he ndindi ri nkankshe. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />Wu to wa doka riwa wa tre:&lt;Ran wuu nji ran ran waa wa njo ran ran yibi ran, ran la kya riwa wuran to-u ran, ran sen njo ran,no ti wen mba yii wen mkpen.&gt;&gt;&gt;<verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />Inji-a ka tre ri,&lt;&lt;Inji ri tsro me ti wamba ka me he vren.&gt;&gt;<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />Yeso ka ya-u ri ya ri nyime ran tre ri,&lt;&lt;Ikya riri nye don riwu. Hi wu ri reri kyawa wawa wu he ri wa wuri ga wa wa wa ran he ri kya ran wu fe kyawa kigbu ri shu ko wuri ye hu wen.&gt;&gt;<verse eid="MRK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 10:22" />Riwa nji-a a wo ngamba isron wan ka time, ka hi ngawan ri shnji sron ritu a he nji riwa a he ri wo bran bran.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />Imba Yesu ka ya miri ndu wan ran tre ri,&lt;&lt;Ari he hwiri ri nchon nɨma no gra ri bwo yɨbe riwa wawa wa he ri wo no wa gra ri ko Izhi!&gt;&gt;<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />Imiri ndu wan waka ti sisiri tre-a ama Yeso ka bru tre riwa ri,&lt;&lt;Biyi miri won, ari he ri yaa bran riwa nji no gra ri ko Izhi! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />Ari he ri yaa no gra ri bwo yɨwe riwa nji ri wo ri gra ri ko Izhi.&gt;&gt;<verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />Ri wo nganyi imirindu Yeso waka ti sisri, wari ran miyen ngamba,&lt;&lt;Inde ngamba nye, ko ingaan nye ri jɨbu?&gt;&gt;<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />Yeso a ya wa ran tre,&lt;&lt;Rinyi ri nji, ari he ri yaa, ama ri Izhi ari he hwɨri.&gt;&gt;<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />Bitrus ka nzu raan ran tre ri,&lt;&lt;Ki ka ko ngye mbu chuwo kiri hu-u.&gt;&gt;<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />Yeso ka tre ri,&lt;&lt;Inji riwa a ka ko wan don ka imiri vayi wan, ka iyi wan ka iti wan, ka imiri wan ka wa zhu wan ritu won nga ritu tre won ri raro, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />ikya riwa ari fe ri nzan nyi, ari han mkpa ngo-ri riwa wa ko, ri miri vayi, ri wa ti, ri miri, ri wa zhu, ama ri yaa ri ngamba ri vi riwa ari ye ari fe vri riwa a ran kre ran. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />Inji kigbu wawa wa he wa gbuchi wa he wa kugon nga wa kugon wa he wa gbuchi.&gt;&gt;<verse eid="MRK 10:31" /></para>
  <para style="s">Yeso a bru Tre Ritu Kuu wan</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />Yeso nga miri ndu wan wana hi Urushalima Yeso a gra kusi mba, waw wa ran hu waka ti sisiri ka bru ŋeren wuru don hari-a ran gbuchi ran. <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />Yeso ka tre ri,&lt;&lt;Ki hi Urushalima wa ka ka vren nji ree ri wa rinkon nga wa tsro tre doka wa bla tre ri kuu ri wu wari ka-u reri wawa wana to Izhi ran, <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />Wa tiu ndan wari junten sro wari tsi ri gbagba, wari wuu-u ama kugon vi tra ari ta-shɨme.<verse eid="MRK 10:34" /></para>
  <para style="s">Iibre wa Yakubu mba Yohana</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Imba imiri Zabadi Yakubu mba Yohana waka ye ri Yeso wari tre ri,&lt;&lt;Inji ri tsro ki wa kiri bre wu kyari.&gt;&gt;<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />Yeso ka tre ri,&lt;&lt;Bi wa me ti se ri yi?&gt;&gt;<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />Waka tre ri wu ri,&lt;&lt;Ki bre wu iri kpanchison wen ri mkpen, no ri mbu no son kuwo ri wen, nga ri ka son kuwota wen.&gt;&gt;<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />Ama Yeso ka tre ri wa ri,&lt;&lt;Bi ran to kya riwa bi bre ran bi to ri vaghon ri yaa riwa me so-a? Ka bi ŋɨwen no wa son yi tu ri ima bibi riwa wa ti ri mo?&gt;&gt;<verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />Wa ka kpanyɨme riwu ri,&lt;&lt;Een ki to ti.&gt;&gt; Yeso ka tre riwa,&lt;&lt;Bi so ri vaghon riwa me so Ngha wa son yi tu ri ima bibi riwa wa son wen, <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />ama ison ri kuwota ri kuwori won ran he gbengbren wamon ran bubu nyi he ri wa wa ka-u dzi ri wawa wa ka dzi wa nye.&gt;&gt;<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />Riwa ngbron imiri ndu Izhi wuru-a wa wo tre-a waka ti fu ri wa Yakubu mba Yonana. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />Yeso ka yo wa ran tre ri wa ri,&lt;&lt;Bi to ri wana he nji Yahuda ran, wawa wa to wa ri kpanchi wa si tsro wa nji mba gbengbren, wa rinkon mba ngawen wa tsro wa nji mba gbengbren. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />Ama a ran he ngamba nye ari he ri tsutsu mbi ran, ri ngamba nji riwa ari wa ran he rinkon rimi mbi no he nji riwa ari ti ndu ri yi, <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />nga nji riwa ari wa ran he rinkon rimi mbi no he gran ko ngan. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Ivren nji ran ye ritu no wa ti ndu ri wu ran ama ritu riwa ari ti ndu ri nji nga a de ngawan ritu ran kpa nji chuwo iwawu.&gt;&gt;<verse eid="MRK 10:45" /></para>
  <para style="s">Yeso a Den Batalomi Nji ri mfyen</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Riwa wana zhu ri Yeriko wawu iwa miri ndu wan nga mgbron nji kigbu, nji ri mfyen ri ka son ri kusan nkon ran ran ibrekpi inde wan a he Batimawus, ivren Timawus. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />Riwa a wo ri Yeso nji ri Nazara ri ye ran ndzu ran tre ri,&lt;&lt;A wu Yeso vren Doda to lo sron won!&gt;&gt;<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />Wari waka yira ngan iri no son gbi, ama ka kawan ran nzu ran ran tre ri,&lt;&lt;Ivren Doda to lo sron won!&gt;&gt;<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />Imba Yeso ka kukri ran tre ri,&lt;&lt;Yo-u ri mon yi&gt;&gt;Waka yo nji ri mfyen wari tre riwu ri,&lt;&lt;Ŋgiri wulunde, Yeso ri yo-u.&gt;&gt; <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />Imba ka ran wɨro wulunde ran ka tsro ri ka mbɨzhuu wan taga ran ye ri Yeso.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />Yeso ka miye ri,&lt;&lt;Wu wa me ti ngye ri wu.&gt;&gt;</para>
  <para style="p" vid="MRK 10:51">&lt;&lt;Inji ri mfyen-a ka tre ri, Inji tsro me wa men to tsu.&gt;&gt;<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />Imba Yeso ka tre ri wu,&lt;&lt;Hi ngawen ikpanyɨme wen kpa-u chuwo.&gt;&gt;Ri bubu ka to tsu meron ra hu Yeso waka hi ngamba.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">Yeso a Gra ri Urushalima ka Ichu</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Riwa wa ye hwri ri Urushalima, ri gbu Betafaji nga Batani, ri bubu mgblu konkron Zaitun, Yeso ka ti miri ndu wan hari ndu, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />Yeso ka tre wa ri, &lt;&lt;Hi ri gbu riwa a he kusi mbi mba, ri gra mbi ri bubu wan bi to vren lamkpron wa lo dzi riwa wa ran hon wu zari ran. Bi sii-u bi ri ngɨzhi ye. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />Ka injo miyen yi ri, &lt;Bi ti ngye nye ngamba?&gt;Bi ka la-u ri,&lt;Bachi ri wa ran ti ndu ri wu ran bru ngɨzhi ye. <verse eid="MRK 11:3" /><verse number="4" style="v" sid="MRK 11:4" />Imba wa ka hi wari to vren lamkpron-a wa lo-u kusi ko ri kusan nkon riwa wa ran sii-u, <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />imba wawa wa he kusan mba waka miyen wa ri,&lt;&lt;Ingye ti? Bi sii vren lamkpron mba?&gt;&gt; <verse eid="MRK 11:5" /><verse number="6" style="v" sid="MRK 11:6" />Waka kpa nyɨme bibi riwa Yeso a tre ri wa-a, imba waka chu wa wo no wa hi ngamba ri vren lamkpron-a. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Riwa wa ngiji vren jaki-a ye no Yeso wari zhu wa tsro mba lɨba ri gon wan Yeso ka hon son ri tu wan. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Imba nji kigbu wa ka wa tsro mba lɨwa ri wu ritu nkon nga wari waka tsen mvumvu rimi rɨma den ri wu ri nkon. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Wawa wa he kusi nga wawa wa he kugon wan wa ran kpagro iri,</para>
  <para style="q1" vid="MRK 11:9">&lt;&lt;Igbre he wa Izhi!</para>
  <para style="q1" vid="MRK 11:9">ilɨbu ndindi wan ri he wa nji riwa ari ye rimi nde Bachi<verse eid="MRK 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10" />No Izhi ti lɨbu ndindi ri kpanchi son A ti mbu Doda riwa ari ye, igibree wa Izhi ri shu.&gt;&gt;<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />Riwa Yeso a gra ri Urushalima ran hi rimi tra ri bre Izhi ran ya kagon ko ngye a he, riwa yawuru a ti-e ka zhuu ran ka bru hi ri Batani iwa miri ndu wan.<verse eid="MRK 11:11" /></para>
  <para style="s">Yeso a la Nyu ri konkron Mbwa</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Ri mibreri han wan riwa wa wulunde zhu ri Batani iyon ka ti Yeso. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Riwa a to konkron mbwa ri riwa a ti mvumvu huu, ran kunkon hi ka a klo. Ama riwa a ka zhu ri bubu wan a ran to kyari ran ara mvumvu kuklu ritu riwa a ran he vi riwa imbwa ri klo ran nye. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Imba ka tre ri konkron mbwa-a ri,&lt;&lt;Injo ran bru ri klo wen ngaran hi ri kre vi!&gt;&gt;</para>
  <para style="p" vid="MRK 11:14">Imiri ko wan waka wo kya riwa a tre.<verse eid="MRK 11:14" /></para>
  <para style="s">Yeso a he ri Tra Bre</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Ri gra mba ri Urushalima, Yeso ka gra rimi tra riwa wa bre Izhi rimi wan ran gra dzu wawa wa ree wari ri ree riwu nga ran tru kpanchi wawa wa sran nkren rega nga kpanchi wawa wa ree ri wa nguu. <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />Ngha ran dzu nji wawu no njo no ran ban kyari ran dzu kusan tra riwa wa bre Izhi rimi wan ran. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Imba ran tsro wa nji ri,&lt;&lt;A he rimi ngan ri,&lt;Waa tre Ri iko won he ko ri bre Izhi iwa wawa wana to Izhi ran.&gt; Bi tan kɨma-u ti raan bubu son wa yɨwi.&gt;&gt;<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />Wa rinkon ndu Izhi nga wawa wa tsro doka waka wo tre nyi wari gra wa nkon riwa wa wu Yeso ama wa klu-u ritu ikpa nji wawa wa kabru ri bubu wan wari ri wo tsro riwa ari tsro wa. <verse eid="MRK 11:18" /><verse number="19" style="v" sid="MRK 11:19" />Riwa yawuru a ti Yeso nga miri ndu wan waka zhu ri mi gbu.<verse eid="MRK 11:19" /></para>
  <para style="s">Konkron Mbwa a kuu</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Riwa waka ran hi ri mibrewaka to konkron mbwa ri wa Yeso a lanyu riwu-a ka kuu kau ri nja wan. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Bitrus ka taka, imba ran tre ri Yeso,&lt;&lt;Inji ri tsro, to-en! Imbwa riwa wu lanyu riwu-a klu!&gt;&gt;<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />Yeso ka kpa nyɨme riwu ri,&lt;&lt;Kpa nyɨme ri Izhi. <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />Kpunji tre me la yi inde nji kpa nyime ri Izhi ari to tre ri tita ri no wurunde ta ngawan yo rimi nne inde a ran tre ri sron hari ran a ri he bibi riwa a tre-a. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Ritu ngamba ame me layi ko ngye riwa bi bre ri sron riri, yo sron ri bi fe wu, ari he wa mbi. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />Ngha bla vi riwa bi ki ri bre Izhi nga wu to ri bi he ri fu njo ri sron mbi bi ka ka meme ti mba chuwo ri wa ritu no Timbi riwa a he ri shu no ka meme ti mbi chuwo ri yi.&gt;&gt; <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />Ama bi ran ri ka meme ti wari rega riwa ran a ti mbi riwa a he ri shu ngawen a ran ka meme ti mbi rega ri yi ran<verse eid="MRK 11:26" /></para>
  <para style="s">Wa miyen Yeso Ritu Mgbemgbren wan.</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Riwa wa Yeso nga miri kowan wa bru ye ri Urushalima, Yeso nga wa ran zren rimi tra ri bre Izhi, rinkon wa sro yii nga wawa wa tsro doka Musa, ri wa rinkon wari waka ye ri wu wari miyen ri, <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />&lt;&lt;Ri mgbembren ngaan nye wu ti kyawa wanyi? Ngha ngaa nye no-u ri no ti wa?&gt;&gt; <verse eid="MRK 11:28" /><verse number="29" style="v" sid="MRK 11:29" />Yeso ka nyɨme ri wa ri,&lt;&lt;Me miyen yi tre ri, ka bi la wen, ame ngawen me layi gbengbren nji riwa me ti kyawa wanyi ri wu. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />La wen yi, Yohana a son nji tu ri ima ri gbengbren ngan, a he ri gbengbren Izhi ka a he ri gbengbren nji?&gt;&gt; <verse eid="MRK 11:30" /><verse number="31" style="v" sid="MRK 11:31" />Waka gra ri janyu ri ngamba,&lt;&lt;Ko ki tre rise ka ki tre ri a he ri gbengbren &lt;Izhi ari tre ri ko ngye ti ko bi ran kpanyɨme ri wu ran?&gt; <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Ama ki to tre ri a he gbengbren nye? Wa ti sisiri kya riwa nji wa ti ri wa ritu nji wawu wa ban ri Yohana he nji ri la tre Izhi riwa ari ye kusi nye. <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />Wa ka kpanyɨme ri Yeso ri,&lt;&lt;Ki ran to ran&gt;&gt; Yeso ka tre riwa ri,&lt;&lt;Ame ngawen me ran layi ko ri gbengbren ngan nye me ti bibi kyawa wanyi ran.&gt;&gt;<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">Itre nji ri ron riwa a tre ritu chu kpi ri zhu</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Imba Yeso ka tre rimi kɨbu tre ri,&lt;&lt;Inji ri a he riwa a chu konkron mbwa rimi rɨma wan, ran ti jaa ka-u ran shi juju riwa ari shiwi ima klo konkron-a ri mi wan, nga ran me vi tra riwa a dzen ritu gben. A ka zhu-a no wa ron wari no wa ran ran ron ngawen ri, imba ran hi gbu ri. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />Riwa ivi ri ken klo konkron ri ro a ye, nji riwa a no wa rɨma no wa raan ron-a ka ti vren ko wan hi ri wawa wa kpa rima ri ron-a iri no wa hi kpa klo konkron inabi-a ye no wawu. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Ama wawa wa kpa rɨma-a waka vu wari tsi wari tru bru hi ri wo kuklu. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Imba ka bru tru vren ri ko wan ri hi ri wa waka tsi dzu tu wari no shan. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />Inji ri rɨma-a ka bru ti vren ri ko wan ri hi wanji wa-a waka wuu. Nghamba ka ti wari kigbu hi wawa wa ri zhu-a waka tsi wari wuu wari mba.<verse eid="MRK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6" />Hari zizan ka don nji ri riwa a he mgbala vren wan riri ri kremkpen wawu, ran tre ri wa ri,&lt;Wa to mkpen vren won.<verse eid="MRK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7" />Ama wawa wa kpa zhuu-a wa ka tre ri ngamba ri,&lt;Ye ki wuu no gado ti wan no kri rita, <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />Waka vu wari wuu, wari ban kɨmo wan taga kugon gɨzhi riwa wa me kagon zhuu-a.<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />&lt;&lt;Yeso ka miye wa ri, Ko nji riwa a no wa zhuu-a ri ti se?&gt;&gt;Ari ye ran wuu wawa a ran ka rɨma no wa-a ran ka rɨma-a no wari nkan. <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />Ashe bi ran kra mbe riwa wa ngan ri,</para>
  <para style="q1" vid="MRK 12:10">&lt;Tita riwa wa mme wa kamba ri wu</para>
  <para style="q2" vid="MRK 12:10">wawu nye he ri ndu rimi mme han iwawu.<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />Rinyi he iti Izhi nye,</para>
  <para style="q2" vid="MRK 12:11">a he kya ri sisiri nye kusi mbu.&gt;&gt;&gt;<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />Imba wa rinkon nji Yahuda waka wa nkon riwa wa vuu ritu riwa wa to ri ari tre tre ritu mba nye, ama wa ti sisiri nji ri ngamba nye waka chu wo wari hi ngamba.<verse eid="MRK 12:12" /></para>
  <para style="s">Imiyen Ritu Nkren Meme riwa Kaisar</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />A he chachu ri, waka ti Farisa wari ri wanji Hiridus, iri no wa hi wari wa-u ri tre bibi riwa ari yɨwa nyu. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />Riwa wa ye zhu, waka tre ri wu ri,&lt;&lt;Inji ri tsro ki to wu he nji riwa a he ri kpunji nye, wa nji wawu wa he riri ri wu wu ran ri ya mkpen nji ri han nji ri ran wu tsro tre nkon Izhi ri kpunji, la ta a bi no ta ki han nkren meme ki no kesra riwa a he nchon chu ri roma ka a ran bi ran ki han, ka kiran han ran?&gt;&gt; <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />Ama Yeso ka to meme ti mba riwa wa he riwu rimi sron mba ran tre riwa ri,&lt;&lt;Ingye ti ko bi wa no wen me yɨba nyu? Ngɨzhi nkren riwa bi han nkren meme ye me to.&gt;&gt; <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />Waka ngɨzhi nkren ri ye no ka miyen wa ri,&lt;&lt;Iyu nga nde nga nye ri kpa nkren-a &gt;&gt;Waka tre ri wu ri,</para>
  <para style="p" vid="MRK 12:16">&lt;&lt;A he wa kesra nye.&gt;&gt;<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />Imba Yeso ka la wa ri,&lt;&lt;Ka kya riwa a he wa kesra no kesra bi ri ka kya riwa a he wa Izhi no Izhi.</para>
  <para style="p" vid="MRK 12:17">Imba itre-a ka no wa sisiri bran.&gt;&gt;<verse eid="MRK 12:17" /></para>
  <para style="s">Imiyen ritu Tashɨme Rimi kuu</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />Imba wanji Sadukiyawa wari wawa wa tre ri itashɨme ran he ran, Yeso ka miye-u ri. <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />&lt;&lt;A wu nji ri tsro, Musa ngan ri ta ri ka vayi nji kuu ka waa wan don a ran ngɨzhi ran, vayi wan ka ban wa vayi wan ti waa wan ran ngji miri ri vayi wan riwa a kuu-a. <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Inji wari wa he riwa wa he miri vayi ngamba wa he tamgban. Ri gbuchi a gran waa, a kuu ka wa wan don ri wɨlo. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Ri han ka kpa wa-a wawu ngawen ka kuu ba vren, ri tra wan ngawen a he ngamba. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />A he ngamba tatamgban mba iri a ran ka vren don kugon ran ikre wan iwa-a ka kuu. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Ka wa tashɨme ari he waa ngaa rimi mba? Riwa wawumba wa gran wu.&gt;&gt;<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />Imba Yeso ka kpanyɨme ri wa ri,&lt;&lt;Ai, irimɨren mbi ran tsra ran ritu riwa bi ran to ingan tre riwa Izhi ran nga biyi bi ran to gbengbren Izhi ran. <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />Ri vi riwa wawa wa kuu wa tashɨme ronron wa ran gran ran, nga mba wana ka wa de ri gran ran, ama wa he ka wandu Izhi wawa wa he ri shu nye. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />Ritu tre tashɨme-a ko bi ran kra to zari ri mbe Musa ran wa ngan ri mimilan tre konkron shushu riwa ari wulu ri,&lt;Ame nye me he Izhi riwa Ibrahi ri wa Ishaku nga riwa Yakubu? <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Wawu he Izhi riwa ari viri a ran he Izhi wa kuu ran bi yɨba nchon si.&gt;&gt;<verse eid="MRK 12:27" /></para>
  <para style="s">Doka ri Gra</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Inji riwa ari tsro doka ri a ye ka wa jannyu ri ngamba. Riwa a to ri Yeso no wa nyime riwa a tsra ka miyen-u ri,&lt;&lt;Doka ritan nye riwa a han ngbron mba iwawu?&gt;&gt;<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />Yeso ka kpanyɨme riwa ri,&lt;&lt;Doka riwa a bran han nye he ri no yi&lt;Wo wen biyi israila Bachi Izhi mbu a he Bachi riri nye. <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />Nyime ri Izhi wen ri sron wen wawu, ri dri wen wawu, ri rimɨren wen wawu nga ri senkpa wen wawu.&gt;&gt; <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />Riwa a bran he rinyi he ri, nyime kpan son wen bibi riwa wu nyɨme ngawen&gt;Doka ri ran he riwa a han doka wanyi ran.&gt;&gt;<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />Imba nji riwa ari tsro doka ka tre ri Yeso ri,&lt;&lt;A wu nji riwa wu la tre-a tsra Bachi he riri nye njo ran he ran ara wawu. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />No wa nyɨme-u ri dri iwawu, nga rimɨre ri senkpa iwawu, wuri nyime ngawen, rinyi han bibi sroyi riwa huhu nga ti wa wa han.&gt;&gt;<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />Riwa Yeso a to ka nji ri tsro doka tre ri wawu ri tre ri wiwɨri ran tre ri wu ri, &lt;&lt;Wu he kusan kpanchi riwa Izhi ri shu.&gt;&gt;</para>
  <para style="p" vid="MRK 12:34">Kugon rimba njo a ran vu sron ran bru miyen-u miyen ri ngaran ri ngaran,<verse eid="MRK 12:34" /></para>
  <para style="s">Imiyen ritu Kristo</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />Riwa Yeso a ran tsro wa doka, ka miyen wa ri a tise wari tre ri Kristo he vren Doda nye? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />Doda ri tu wan, dzu riwo Yuu Tsitsri a tre ri,&lt;&lt;Bachi a tre ri Bachi won ri kuson ku wori won tse me ka yo ri wo wa kpan fu wen&gt; <verse eid="MRK 12:36" /><verse number="37" style="v" sid="MRK 12:37" />Doda ri tu wan a yo Kristo ri,&lt;Bachi.&gt;Ko Kristo ri tise ko ran he vren Doda?&gt;&gt;<verse eid="MRK 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />Rimi tsro wan Yeso a tre,&lt;&lt;Ti rereri wawa wa tsro doka wawa wa he wawa wa wa su tsro wa ri bran wari ran ŋren kagon wa waa no nji no wa ran chi wawa rimi richu. <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />Ngha wa wa no wa ran no wa bubu son wa ndindi rimi tra Izhi nga ri bubu riwa nji wa kabru ran ri roo. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />Wawa wa he wawa wa wa wari ri kpi mba wawa wa ron mba wa kuu wari ri wa wari bre Izhi ban vi ritu no nji don ka wawa a wa no wa yaa riwa a bran han.&gt;&gt;<verse eid="MRK 12:40" /></para>
  <para style="s">Ide riwa Waa ri Kɨbo</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Riwa Yeso a son rimi tra Izhi ri kpati riwa wana sro de a ran ya bibi riwa wana sro nkren kigbu. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Imba iwaa ri riwa a he waa ri yaa iron wan a kuu a ye riwa ari sro mgibrenini hari riwa wana tsra ri kubu riri ran <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />Imba Yeso ka yo miri ndu wan ran tre riwa ri,&lt;&lt;Kpunji tre me la yi, ikya riwa iwa ri yaa nyi sro rimi kpti ri kpa nkren nyi riwa iron wan kuu-a a han wa mgbron nji wawu. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />Wawu mba wa de rimi kigbu kya riwa wa he ri wu nye, ama wawu a de wama rimi yaa wan nye, a de iwawu kpunji kya riwa a yo sron ri wu nye a de&gt;&gt;<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">Yeso a a la tre ri Kusi Ritu Idzi Bubu Bre riwa Izhi</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Riwa Yeso a ran zhu rimi bubu bre ivren ndu wan ri ka miyen-u ri,&lt;&lt;Inji ri tsro to bibi riwa tita wamu wa wɨloga nga bibi mme wamu wawa wa de sisiri mu!&gt;&gt;<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />Yeso ka tre wu ri,&lt;&lt;Wu to bibi mme wa mu wawu mba wa zi wa rega wawu mba, iri ran ri kri ri tu vayi wan ran.&gt;&gt;<verse eid="MRK 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Riwa Yeso a son ritu mgblu ri konkron zaitun riwa a kɨmasi ran ya bubu bre ri Bitrus, Yakubu, ri Yohana nga Andarawus waka miyen-u ri yayɨbi ri, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />&lt;&lt;La ta shitan nye kyawa wa nyi wa ti wa, ingye nye ri tsro riwa ki to ri kyawa wamba wa gon ri ye?&gt;&gt;<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />Yeso ka tre wa ri,&lt;&lt;Milan ya ran no njo no gyuru yi ran.&gt;&gt; <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />Wa nji kigbu wa ye rimi nde won wari tre ri,&lt;Wawa nye wa he wawu&gt;Ngha wari gyuru nji kigbu. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />Ka bi wo tre kuu ko wa tre ritu kuu bi ran no sron mbi no wulunde ran ritu ikre vi ran ye nye mba ran. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />Igbu wari wa yo gbu wari kusi, nga kpanchison wari wa yo kpanchison wari kusi, izi meme ri he ri bubu wari nga iyon ri he bran. Ama kya wa wamba wa ran he yaa riwa ari ye-a nye mba ran, ari he ka ilo riwa waa riwa ari ngɨzhi vren.<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />&lt;&lt;Biyi kyumbi bi milan ya ritu wa vu yi hi ri tra bla tre nga wa tsi yi ri tra Izhi bi kuki ri kusi wa rinkon nga wa chu ritu bi ri la tre ri ro ritu won. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Ama wa tre tre Izhi ri ko nga ri ko no kre vi no ye. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />Ngha ka wa vu yi hi ri tra bla tre, bi ka ran tika ritu kya riwa a ye ri yi sron ritu a ran he biyi nye bi tre ran,ama Iyu Tsitsri nye.<verse eid="MRK 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12" />&lt;&lt;Vayi ri ka vayi wan no wa no wa wuu, iti ri ka vren wan de no wa wuu. Imiri wa yo wa ti mba kusi wari no wa ri no wa wuu wa. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />Ko ngaa ri kawan ri yi ritu nde won, ama nji riwa a vu sron hi ri kre wan ari fe kpa chuwo.<verse eid="MRK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />&lt;&lt;Ka bi to &lt;kya riwa a zuu riwa ari ngɨzhi dzi a ran tsra ran&gt; No nji riwa ari kra no to nga no wawa wa he ri gran Yudiya no wa tsutsu hi ri tu mgblu. <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />Injo riwa he ritu tra no ran gɨzhi ye rimi ko ritu ran ban kya zhu ri wu ran. <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />Inji riwa a he ri zhu no ran bru hi ko ritu ran ye ban tsro wan ran. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />Iyaa mba wawa wa he nne, nga wawa wa sho miri gon ri chachu. <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Bi bre Izhi no kyawa wanyi no wa ran ye ri ko no su no ye ran. <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />Ri vi wa nyi wa so yaa bran riwa wana so to zari ran tu chachu riwa Izhi a gbuchi ti mgbumgblume hari ye zizan wa ran bru tu bibi wan ran hari hi ri kre vi. <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />Wari tre ri Bachi ran fon vi a rega ran, injo ri ran ran jɨbu wo ran. Ama ritu lo sron ri wawa a zhu wa-a a fon vi a rega. <verse eid="MRK 13:20" /><verse number="21" style="v" sid="MRK 13:21" />Ri chachu mba ka injo tre yi ri,&lt;Ya, ingye nga Kristo-on ,&gt;Ko ka ran tre ri ya ingye ngaa wawu-on ran kpanyɨme ri wu ran <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Wa Kristo wa che nga wa la tre ri kusi wa che wa zhu nga wari ti kyawa wa de sisiri ritu no wa gyuru nji hari wawa Izhi zhu wa-a nkon ran he ri wa. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Ritu ngamba bi milan ya, me la yi kongye ri ko no vi no ye. <verse eid="MRK 13:23" /><verse number="24" style="v" sid="MRK 13:24" />&lt;&lt;Ri vi mba kugon yaa riwa ari ye-a&lt;&lt;Iji ri kɨma ti bu nga huwa ran ri kpan ran;<verse eid="MRK 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="MRK 13:25" />Intsen huwa wa zhu ran joku ri meme nga kyawa wa shu wa ran kugbulu.&gt;<verse eid="MRK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 13:26" />&lt;&lt;Imba ivren nji ri zhu ri kpa wulu ri gbengbren nga mkpen. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Ngha ari ti miri ko wan ndu no wa ye vu wawa a zhu wa ri mgbumblume kabru, ri kunggo nza ri mgbumgblume.<verse eid="MRK 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />&lt;&lt;Zizan biyi to kya ritu konkron mbwa, ka ganran wan wa sran wari ri zhu ri vunvu risa bi to ri issu ye hwɨre nye mba. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Nghamba me ka bi to kyawa wa mba wa ye bi ka to ri ivi ye hwɨre nye mba. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Kpunji tre me la yi, nji wa nzan nyi wa ran kuu ran tse kyawa wanyi wa ye ri. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Ishuwulu imba mgbumgblume wa kre ama itre won ran ri kre ran.<verse eid="MRK 13:31" /></para>
  <para style="s">Injo Ran to Vi ka Chachu ran</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />Injo ran to vi ko chachu riwa kyawa wanyi wa ti ran, ko miri ko wan, ko ivren wan ran to ran ara wawu nye to vi-a. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />Biyi milan ya bi ri milan ki ritu bi ran to vi ria ivi-a ri ye ran <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />Ari he ka nji riko riwa a ri hi ri bubu zren ran ka miri ndu wan don no wa ran ya ko, ka ari kunkon ari no ko nga ndu wan riwa ari ti nga ran la nji riwa ari gben ri nyun nkon ko iri no milan ran ya. <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />&lt;&lt;Ritu ngamba bi ka milan ki ritu bi ran to vi riwa nji ri ko mbi ri bru ye ran, ko ri Yawulu ko ri tsutsu chu, ko ka kuko tɨbu ko ka ri mbambre. <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />No ran ye fe yi ka bi kru nna ran. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />Ikya riwa me tre ri yi, me tre ri ko ngaa ngawen.&lt;Biyi milan ki!&gt;&gt;&gt;<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">Wa rinkon wa nji Yahuda wa kabrutu riwa wa vu Yeso</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />A don vi hari riwa wa roro ri dza gran nga ro ri kpa kpi fu ran tse wa rinkon wa sro yii nga wa tsro doka Musa, riwa wa vu Yeso ri yayɨbi wari wuu-u. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />Ama wa tre ri&lt;&lt;No ran he ri vi ri roro dza gran ran ritu nji wa wulunde ri wanyun.&gt;&gt;<verse eid="MRK 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />Yeso a he ri Batani ko nji riwa wa ran yo-u ri Sima riwa a he ri lilo ntan kpa, riwa Yeso a ran ri ri tse iwa ri ka ye ri mgbu ri riwa wa ti-u ri tita onis, a sro nye ri hwi raro riwa a ti nkren bran sho rimi wan riwa wa ti-u ri konkron nardi zalla, iwa-a ka yira nyun mgbu-a ran ka nye-a bwa Yeso ri tu.<verse eid="MRK 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 14:4" />Inji wari wawa wa he ri bubu wan waka ti fu wari ran tre ri ngamba ri,&lt;&lt;Ritu ngye ko wa kpa nye nyi ri time ngayin? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />Wa ri ka nye-a rebibi riwa wa ri fe nkren bran riwa wa han wa ndu ri vi gbigba tra nga wa ri no wa yaa ran bi.&gt;&gt;Imba waka tre wa-a bran bran.<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />Ama Yeso ka tre ri wa ri,&lt;&lt;Ka-u chuwo! ritu ngye ko bi nyan-u sron? A he kya ndindi nye a ti ri mo. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />Wa yaa wa he ri yi bla vi, bi to dzon wa ko ri shitan ri wa bi wa bi ri dzon wa. Ama a ran he bla vi nye bi fe wen ran. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />A ti kya riwa a tsra ri gbengbren wan. A bwa nye-a mo ri kpa ritu riwa wa no wen yɨbi. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Me la yi kpunji tre, ko kutan ri mgbumgblume nyi riwa wa la tre wan dindi nyi, wa ran taka kya riwa iwa nyi ti ri mo.&gt;&gt; <verse eid="MRK 14:9" /><verse number="10" style="v" sid="MRK 14:10" />Imba Yahuda Iskariyo riwa a he ri rimi miri ndu Yeso wurudonhari ka hi ri rinkon wa sro yii riwa ran ka Yeso reri wa. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Riwa wa wo ngamba waka ngɨri bran bran wari la-u ri wa no nkren, Yahuda ka gra wa nkon riwa ari ka Yeso reri wa.<verse eid="MRK 14:11" /></para>
  <para style="s">Yeso a Ri ri ri yawulu iwa Miri Ndu Wan</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Ri vi ri mimilan ri ro ri dza gran ri jujuyɨmo riwa a ran he ri mumu ri kpa kpi fu ran a he vi riwa sro yi ri vren ntɨma ri roro ri dza gran, imba imiri ndu wan waka miyen Yeso ri,&lt;&lt;Ri minyi nye wu wa ki hi milan bubu ri ri roro ri dza gran ti ri wu?&gt;&gt;<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />Imba ka ti miri ndu wan hari ndu ran la wa ri,&lt;&lt;Hi rimi gbu ri bubu wan bi to nji ri a ngɨzhi vaja ri ima ari fe yi. bi ka hu-u. <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />Iko riwa bi gra bi ka miyen nji ri ko-a ri,&lt;Inji ri tsro ri miyen ri itra riwa wawu nga miri ndu wan wa ri ri ri roro dza gran he kutan?&gt; <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />Wawu ri tsro yi kpolo tra ri ri shu riwa wa mɨlan ti kre-e ritu roro-a. Ri bubu wan nye bi mɨlan bubu ti.&gt;&gt; <verse eid="MRK 14:15" /><verse number="16" style="v" sid="MRK 14:16" />Imba imiri ndu Yeso waka wulunde wa ri gra rimi nchon gbu wari ka fe kyawa riwa Yeso tre ritu wan-a imba waka mɨlan bubu ri ri-a ti. <verse eid="MRK 14:16" /><verse number="17" style="v" sid="MRK 14:17" />Riwa Yawulu a ti, Yeso nga miri ndu wan wurudonhari-a waka hi ri ko-a. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Riwa wa ran ri ri-a Yeso ka tre wa ri,&lt;&lt;Kpunji tre me la yi, iri rimi mbi wawa bi ri ri ri me ri nyi ri ka wen re.&gt;&gt;<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />Imiri ndu wan waka ti fu wari ran miyen-u yɨyyɨri ri &lt;&lt;Ka a he ame kya?&gt;&gt;<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />&lt;&lt;Yeso ka nyɨme ri wa ri,&lt;&lt;A he ri rimi mbi wurudon hari wanyi riwa ki son wo ri vaŋo riri imbu-u nye. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Ivren nji ri kuu bibi riwa a he rimi ngan ritu wan! Ama iyaa nji riwa ari ka vren nji de! Ari bi ri wu riwa wari ran ngɨzhi-u ran.&gt;&gt;<verse eid="MRK 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Riwa wa he rimi ri ri Yeso ka ban jujuyɨmo ran ngiri ri Izhi nga ran chiwa ran ka no wa miri ndu wan ran tre ri,&lt;&lt;Kpa yi, rinyi he ka ikpa won nye.&gt;&gt;<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />Ngha kugon rimba Yeso ka ban vaŋo ri ima ri ro-a ran ngɨri ri Izhi ritu wan nga ran ka no wa miri ndu wan-a, nga wawu mba waka so rimi wan.<verse eid="MRK 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 14:24" />Yeso ka tre ri,&gt;&gt;Ri nyi he yii won nye, iyii riwa wa katre dzi ri ari rega ritu nji ki gbu. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />&lt;&lt;Me la yi kpunji tre ri, me ran bru so ima ri ro nyi ngaran tse chachu riwa me so ri sisa wan ri kpanchison Izhi. <verse eid="MRK 14:25" /><verse number="26" style="v" sid="MRK 14:26" />kugon riwa wa chuse ri gbre mba waka zhu wari hi ri mgblu ri konkron zaitun.<verse eid="MRK 14:26" /></para>
  <para style="s">Yeso a tre Ritu Riwa Bitrus ri Tron Wawu.</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />Yeso ka tre ri miri ndu wan ri,&lt;&lt;Wawu mbi bi wulutsu ka wen don bibi riwa wa ngan ri mbe iri,&lt;Wawu ri wuu nji ri kɨshu ntɨma nga intɨma wa pisi.&gt; <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" />Ama kugon riwa me tashɨme me gbuchi hi ri yi ri Galili.&gt;&gt; <verse eid="MRK 14:28" /><verse number="29" style="v" sid="MRK 14:29" />Bitrus ka tre ri,&lt;&lt;Ko wari ka-u don wawu mba, ame me ran ka-u don ran.&gt;&gt; <verse eid="MRK 14:29" /><verse number="30" style="v" sid="MRK 14:30" />Yeso ka tre ri Bitrus ri,&lt;&lt;Kpunji tre me la-u, ri chu nyi wu tron nyun won ti mkpa tra ri ko no kuko no tɨbu <verse eid="MRK 14:30" /><verse number="31" style="v" sid="MRK 14:31" />Ama Bitrus ka sondu ran tre ri,&lt;&lt;Ko wari ri wuu wawu, wawu ran tron nyun Yeso ran.&gt;&gt;</para>
  <para style="p" vid="MRK 14:31">Ngha mgbron mba waka tre ngambame.<verse eid="MRK 14:31" /></para>
  <para style="s">Yeso a bre Izhi ri Getsemani</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Yeso nga miri ndu wan wa ye zhu ri bubu ri riwa wa yo-u ri Getsemani bubu riwa wa shibi wɨlo konkron Zaituu, Yeso ka tre ri miri ndu wan ri,&lt;&lt;Biyi kuki ri nyi me hi bubu bre Izhi.&gt;&gt; <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Yeso ka yo Bitrus Yakubu nga Yohana ri ngawan nga ka gra ri tika nga shnji sron. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Yeso ka tre ri wa ri,&lt;&lt;Shnji sron riwa a he ri mo ri sron ari to wuu wen, bi kuki ri nyi bi ri ran ya.&gt;&gt; <verse eid="MRK 14:34" /><verse number="35" style="v" sid="MRK 14:35" />Riwa Yeso a hwi hi kusi tsawen ran joku ri mme ran bre Izhi ri ran bi wari ban vi yaa nyi ri mo. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />&lt;&lt;Yeso ka tre ri, Abba, A ti won ikyari ran ri na-u wo ran, wu ban vaŋo yaa nyi zho ri mo, ri ngamba wu ti kya riwa a bi ri wu a ran kya riwa a bi ri mo ran.&gt;&gt;<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />Kugon rimba Yeso ka bru ye ran ye fe miri ndu wan hari-a ka wa krunna ka tre ri Bitrus ri,&lt;&lt;Bitrus bi kru nna ngye? Ko wu ran to gben ri vi tsawen ran? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />Milan ran ya bi ri ran bre Izhi ritu bi ri ran joku ri tsra ran, iyu ri wa ran ti kya ama ikpa ran he ri senkpa ran.&gt;&gt; <verse eid="MRK 14:38" /><verse number="39" style="v" sid="MRK 14:39" />Yeso ka bru hi ri bubu bre Izhi ran bre bibi riwa a bre ri sen-a. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Imba Yeso ka bru ye ran ye ran fe miri ndu wan ka wa kru nna nganga ritu inna a sho ri wa ri sii nga wa ran to kya riwa wa tre ri wu ran. <verse eid="MRK 14:40" /><verse number="41" style="v" sid="MRK 14:41" />Riwa a hi ran bru ye ri mkpa ri tra ran tre wa ri,&lt;&lt;Bi kambi ri kru nna ri ka bi son vri nye? A kre ron! Ivi ye riwa wa ka vren nji no wa meme ti. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />Wulunde ki hi, ingye ngaa nji riwa ari kawen reri ye-on!&gt;&gt;<verse eid="MRK 14:42" /></para>
  <para style="s">Wa vu Yeso</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />Riwa Yeso a he rimi tre tse Yahuda iri rimi miri ndu wan wurudon hari a ye iwawa nji kigbu wa ngɨzhi wa njimgban nga kpala a he wa rinkon wa sro yii nga wa tsro doka Musa nye wa ti wa ndu ye ri Yeso. <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />Yahuda nji riwa ari ka Yeso re-a ka la wa dzi iri,&lt;&lt;Inji riwa wawu smo ngɨzhi mbari ka a he wawu nye bi ka vu bi ri milan-u ngɨzhi.&gt;&gt; <verse eid="MRK 14:44" /><verse number="45" style="v" sid="MRK 14:45" />Riwa Yahuda a ye zhu ri Yeso ran tre ri wu ri,&lt;&lt;Inji ri tsro!&gt;&gt; Ngha ran smo ngɨzhi. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Imba nji-a waka vu Yeso wari ngɨzhi-u mgbemgben. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Imba nji ri rimi nji wawa wa ki ri Yeso riwa a kri hyure ri wu ka chu njimgban ran ka sren mvumvu ton vren ndu nji rinkon wa sro yii-a taga. <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />Yeso ka tre wa ri,&lt;&lt;Bi zhu ri wa njimgban nga wa kpala bi ri ye vu wen ka me he nji ri yɨbi? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />Ingye ti ko bi ran vu wen ri bubu bre riwa Izhi riwa me he ri yi me ri ran tsro ran? Ama kyawa wa nyi wa ti ritu no tre Izhi riwa a tre ritu won no ye ke.&gt;&gt; <verse eid="MRK 14:49" /><verse number="50" style="v" sid="MRK 14:50" />Ri bubu wan imiri ndu wan waka ka-u don wari tsutsu. <verse eid="MRK 14:50" /><verse number="51" style="v" sid="MRK 14:51" />Ivren nze ri a hu Yeso ran hi a ran suu tsro wan ri wu tsro riwa ka ka kpa wan ri wu riwa nji-a wa wa wari vu vren-a, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />ama ka sii ŋɨma tsro wan-a don wa ri wo ran tsutsu ri mgbamgbre.<verse eid="MRK 14:52" /></para>
  <para style="s">Wa ngɨzhi Yeso hi kusi wa rinkon</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Waka ngɨzhi Yeso hi ri kusi rinkon wa sro yii nga mgbron wa rinkon wa sro yi-a nga wa tsro doka Musa waka shutu ki ri bubu wan. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />Inga Bitrus ka ran hu Yeso ri kpata, hari hi ri ko rinkon wa sro yii-a ri bubu wan ka son ri wawa wa gben ran ran so gbaji wulu.<verse eid="MRK 14:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55" />Wa rinkon wa sro yii-a waka ran wa wari fe kyari riwa ari tsro ri Yeso ti meme ti ritu no wa wuu-u ama wa ran fe kyari ran. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Inji kigbu wa la tre ri che ritu Yeso, ama nyu mba ari he riri ran.<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />Kugon rimba nji wari waka wulunde kri nde wari la tre ri che ritu Yeso ri: <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />&lt;&lt;Ki wo a tre ri,&lt;Wawu ri zii bubu bre riwa nji wa mme nga kugon vi tra wawu ri mme risa.&gt;&gt;&gt; <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Ka hu ri ngamba inyu mba ka ran ye ri ri ran.<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />Imba rinkon wa sro yii-a ka wulunde kri nde ran miyen Yeso ri,&lt;&lt;Wu ran he kya riwa wa tre ritu tre riwa wa tre ritu wen nyi ran? Itre riwa wa tre ritu wen ran?&gt;&gt; <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />Ama Yeso ka songbi a ran la-u kya ri ran.</para>
  <para style="p" vid="MRK 14:61">Ngha rinkon wa sro yi-a ka bru miyen Yeso ri,&lt;&lt;Ka a wu nye wu he Kristo ivren Izhi ri tilɨbu?&gt;&gt;<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />Yeso ka tre ri,&lt;&lt;Me he wawu nga wu to vren nji ri kuson kuwori bubu gbengbren riwa Izhi nga ari zhu ri kpa wulu ri shu ye.&gt;&gt;<verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />Imba rinkon wa sro yii-a ka gbon tsro wan ran tre ri,&lt;&lt;Itre ngye wu he ri wu?&gt;&gt; <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />&lt;&lt;Bi wo riwa a kpa nde time ri Izhi, ko bi to ki ti-u ri se?&gt;&gt;Wawu mba waka tre ri no wawa wuu. <verse eid="MRK 14:64" /><verse number="65" style="v" sid="MRK 14:65" />Wari mba wa gbuchi ran sru nten ran sro Yeso wari lo-u si wari ran tsii wa ran tre ri,&lt;&lt;La ta nji riwa a wuru-u!&gt;&gt;Ngha wawa wa gben wa sondu ran tsii.<verse eid="MRK 14:65" /></para>
  <para style="s">Bitrus a tron to Yeso</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Bitrus ka son meme ri ko riwa wa vu Yeso hi imba vra ri ndu ri rimi wawa wa ti ndu ri ko rinkon wa sro yii-a ka ye i bubu wan. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />Riwa a to Bitrus ri so nzan wulu ka milan-u ya ran tre wu ri,&lt;&lt;A wu ngawen wu he ri Yeso nji Nazareti.&gt;&gt;<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />Ama Bitrus ka tron ran tre ri&lt;&lt;Wawu ran to kya riwa ari tre mba ran.&gt;&gt;Imba Bitrus ka wulunde hi ran ka kuson ri tra nkon ri ko-a, nga ri bubu wan kuko ka tɨbu.<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />Riwa ivra-a ka bru to-u ri bubu wan, ka bru la wawa wa kukri ri bubu wan ri,&lt;&lt;Ri nyi he ri rimi mba nye.&gt;&gt; <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Bitrus ka bru tron nganga. Kugon vi tsawen wawa wa hi hwɨreri Bitrus wa ka tre wu ri,&lt;&lt;Kpunji tre wu he iwawa nye. ka wu ran he nji Galili nye ran.?&gt;&gt;<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />Ama Bitrus ka ran shizhi ran ran la nyun ri ngawan ri kusi mba, a ran tre ri,&lt;&lt; Wawu ran to nji riwa wa tre ritu wan ran.&gt;&gt; <verse eid="MRK 14:71" /><verse number="72" style="v" sid="MRK 14:72" />Ri bubu wan kuko ka tɨbu ri mkpa ri hari Yeso a la-u ri,&lt;&lt;Ko no kuko no tɨbu ti mkpa hari wu tron nyun won ti mkpa tra.&gt;&gt;Riwa a taka tre riwa Yeso a la-u-a ikpa wan ka ku ka gra yii.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">Wa ngɨzhi Yeso hi ri kusi Bilatu</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Ri bubu mibrewa rinkon wa sro yii nga wa rinkon wa kpanchi wa tsro doka Musa nga mgbron wa rinkon wa kabrutu wa vu Yeso wari ngɨzhi-u hi ri kusi Bilatu.<verse eid="MRK 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2" />Bilatu ka miyen Yeso ri,&lt;&lt;A wu nye wu he chu nji Yahuda?&gt;&gt;</para>
  <para style="p" vid="MRK 15:2">Yeso ka tre wu ri,&lt;&lt;Nghamba nye wu tre.&gt;&gt;<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />Wa rinkon wa sro yii waka vu Yeso ti meme ti kigbu. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Imba Bilatu ka bru miyen Yeso ri,&lt;&lt;To wa tre tre ri kigbu ritu wen ko wu ran tre kyari ran?&gt;&gt;<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />Ama ye zizan Yeso ran bru tre kya ran nga Bilatu ka ran ndzu sron ritu wan.<verse eid="MRK 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Ikya riwa ichu Bilatu ri si ti ka ivi ro ri dza gran ye ari chu nji wawa wa tren wa ri tra tren chu wo bibi riwa nji wa bre wu iri no ti. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Inji ri a he riwa inde wan a he Barabas riwa wa lo-u yo ri tra tren iwawa wa wanyu wa wa wa wuu nji ri chachu riwa iwanyu a wulunde. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Ijɨbu nji waka hi ri Bilatu wari miyen iri no ti bibi riwa ari si ti.<verse eid="MRK 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 15:9" />Bilatu ka tre ri wa ri,&lt;&lt;Bi wa me chu nji Yahuda chuwo ri yi?&gt;&gt; <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Ritu a to iri wa rinkon wa sro yi wa ka Yeso de ritu ngu nye. <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />Ama wa rinkon wa sron yii waka tre jɨbu nji iri no wa tre ri no chu Bilatu no chu Barabas nye chuwo riwa ari chu Yeso.<verse eid="MRK 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 15:12" />Bilatu ka miyen wa ri,&lt;&lt;Ko bi wa me ti se ri riwa bi tre ri a he chu nji Yahuda!&gt;&gt;<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />Waka ndzu ran wari tre ri,&lt;&lt;No wa kpan-u ritu konkron!&gt;&gt;<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />Bilatu ka miyen wa ri&lt;&lt;Ritu ngye nye? Memeti bibi tan nye a ti?&gt;&gt;Imba waka bru ndzu ran reri,&lt;&lt;No wa kpan-u ri tu konkron!&gt;&gt;<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />Ritu riwa Bilatu a ran wa ran sii nji sron ka chu Barabas chuwo ri wa imba ka no wa ti Yeso ri gbagba wari ngɨzhi-u hi ka kpan ri tu konkron.<verse eid="MRK 15:15" /></para>
  <para style="s">Wa klukpa wa ti Yeso Ndan</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Wa klukpa waka ban Yeso hi ri tra bla tre chu gbu nga wari yo ngbron wa klukpa. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />Waka suu bibi tsro riwa wa chu ri wu, waka ti ntan bibi riwa chu ri nchon wari ka son ri Yeso ri tu. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />Wa gra ri chi Yeso ri,&lt;&lt;No vi wen no ban kusi, a wu chu nji Yahuda!&gt;&gt; <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />Wa sondu ran wuru-u ri kpala ri tu wari zhu nten ran sro nga wari ran kɨbu mgbazhu iri wa no mkpen. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Riwa wa ti-u Yeso ndan kre wari zhu tsro riwa wa chu zho ri wu nga wari vu tsro wama suu ri wu wari ngɨzhi-u hi ri ra riwa wa kpan-u ri konkron.<verse eid="MRK 15:20" /></para>
  <para style="s">Wa kpan Yeso ritu konkron.</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />Riwa wa he nkon ran hi,waka to nji ri ri nkon riwa nde wan a he Sima, a he nji Sayirin iti Alekzanda nga Rufus a zhu ri vi gbu ran ye, wa klukpa waka vu ri no ban konkron riwa wa kpan Yeso riwu. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />Waka ngɨzhi Yeso hi ri bubu ri wa yo-u ri Golgota itu wan he bubu mgborotu. <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />Ri bubu wan nye wa kabru ima ri mgban nga gbɨre riwa wa yo-u ri muri, ama Yeso a kawan ri so. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Imba waka kpan Yeso ri konkron wari gbon tsro wan wari ta mgbe ritu wari to ko iŋɨma ritan nye ko ngaa ri fe.<verse eid="MRK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 15:25" />A he ri mibrenye wa kpan yeso ritu konkron. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />Ritu konkron riwa wa kpan Yeso wa ngan kya riwa a ti iri,&lt;&lt;ICHU YAHUDAWA.&gt;&gt; <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />Ngha wari kpan wa yɨbi hari ri wu, iri a he ku wo ri nga ri ka he ku wo ta wan. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />Rinyi nye he ke tre riwa a tre ri,&lt;&lt;Wa bla Yeso yo rimi wawa wa ti meme ti.&gt;&gt; <verse eid="MRK 15:28" /><verse number="29" style="v" sid="MRK 15:29" />Inji wawa wa ran vu yɨba ri bubu wan wa ran tre tre ri tsri, wari ran wu tu wari ran tre ri,&lt;&lt;A wu riwa wu dzi bubu bre Izhi wuri mme rimi vi tre, <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />kpa ngawen chuwo wuri gɨzhi ye mme!&gt;&gt;<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />Nghamba ngawen wa rinkon wa sro yii nga wa tsro doka Musa wa sondu ran ti Yeso ndan ri,&lt;&lt;A kpa wari chuwo ama a ran to kpa ngawan chuwo ran. <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />No Kristo ichu Israila nyi no gɨzhi ri tu konkron ye mme riwa ki to kiri kpanyɨme.&gt;&gt;Wa yɨbi wawa wa kpan wa iwawa Yeso ngawen wa tre tre meme ri wu.<verse eid="MRK 15:32" /></para>
  <para style="s">Ikuu Yeso</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Ri gbege ji ibuu ka ka ji hi ri yawulu. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Ri yawulu-a Yeso ka ndzu ran ran tre ri,&lt;&lt;Eloi, Eloi, lama sabatani? a wu Izhi won ritu ngye ko wu kɨma gon ti wen?&gt;&gt;<verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />Riwa wawa wa he ri bubu wan waka wo ngamba wari tre ri,&lt;&lt;Wo ari iliya nji ri la tre Izhi.&gt;&gt;<verse eid="MRK 15:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 15:36" />Iri rimi mba ka tsutsu ye ran son soso rimi ima mgban ran ka no Yeso ri no so ran tre ri,&lt;&lt;Chu wu wo no Iliya no ye gɨzhi ri mme ran.&gt;&gt;<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />Imba Yeso ka ndzu ran mgbamgban ran ndzu vri nga ran kuu.<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />Itsro ri ka nkon tra ka yɨra ri shu ye ri mme. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />Riwa rinkon wa klukpa riwa a kri kusi Yeso ka to bibi riwa Yeso a kuu-a nga ran tre ri,&lt;&lt;Kpunji tre nye nji nyi a he vren Izhi nye.&gt;&gt;<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />Mba wari wa ki kpata wari ran ya ngawan. A he wa meremu ri gbu magadala nga meremu iyi Yakubu tsitsa Yusufu nga salomi. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />Ri Galili nye imba-a wa ran hu Yeso wari ran ti ndu riwu Imba wari ngawen wawa wa ye iwawa Yeso zhu ri Urushalima wa he ri bubu wan ngawen.<verse eid="MRK 15:41" /></para>
  <para style="s">No Yeso Yɨbi</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Riwa yawulu ka ti riwa imibreri han wan ri he vi sonvri. <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />Inji riwa inde wan a he Yusufu a zhu ri Arimatiya ye a he ri rimi wa rinkon ri tre Izhi riwa a he ri rereriwa a ran yosron no kpan hi ri Bilatu ran ibreiri no wa ka kɨmo Yeso no wawu. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />Bilatu ka ndzu sron riwa a wa ri Yeso kuu-e ka yo rinkon wa klukkpa-a ran miyen-u ri ko Yeso kuu-e. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Riwa a wo ri nyu nji ri klukpa-a ka no Yusufu no ban kɨmo Yeso. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />Yusufu ka reŋɨma tsro kinklan, ran gɨzhi ri kɨmo Yeso ran ka yo rimi bubu gru riwa wa shi-u ri kpa tita nga ran nyi tita ri ye ka nyun bubu gru. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />Meremu ri gbu magadala nga meremu iyi Yusufu waka ki ran ya bubu riwa wa ka kɨmo Yeso ka ye ri bubu wan.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">Itashɨme Yeso ri Bubu Gru</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Riwa ivi son vɨri a vuyɨba Meremu Magadaliya, nga Meremu iyi Yakubu, ri Solomi ngawen wa ka renye ri mɨwi raro riwa wa hi wa ri gban kpa Yeso ri wu. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Ri bubu mbɨre rimi vi ri gbuchi ri vi tangban ri mibrewaka he nkon ri hi bubu gru. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />Waka miyen ngamba ri,&lt;&lt;Ingaa ri nyiin tita ri nyun bubu gru?&gt;&gt; <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />Ama riwa wa ndzu tu ya, wa ka to wa nyi tita riwa a wologa-a yo ri kusan. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />Riwa wa ka gra ri bubu gru, waka to vren nze ri a suu tsro kinklan ran son ku wo ri, nga waka ti sisri.<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />Ka tre ri,&lt;&lt;Ran ti sisiri ran, bi wa Yeso nji Nazaret riwa wa kpan-u ri konkron-a nye. A tashɨme! A ran he ri nyi ran.Ya bubu riwa wa ka-u yo mba.&gt;&gt; <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Ama hi, bi ri la miri ndu wan, ri Bitrus, &lt;A gbuchi hi ri meme Galili ri yi. Ri bubu wan nye bi to-u bibi riwa a la yi.&gt;&gt;&gt;<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />Imba waka ka bubu gru don ri tsu nga wari ti sisiri wari ran tre ri njo ri nkon ran ritu wa ran ti sisiri.<verse eid="MRK 16:8" /></para>
  <para style="s">Yeso a zhu ri Meremu Magadaliya</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />Kugon riwa Yeso a tashɨme ri vi ri gbuchi ri vi tamgban, a gbuchi tsro ngawan ri Meremu Magadaliya, riwa a zhu meme bɨzhi tangban zhu riwu ri kpa wan. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Wawu nye a hi ran la ri wawa wa he wawa nga wawa wa ran ti shnji sron nga wari ran yi. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Ama riwa wa wo ri Yeso he ri si riwa a to-u, wa kamba ri kpa nyɨme ri wu.<verse eid="MRK 16:11" /></para>
  <para style="s">Yeso a zhu ri Miri ndu wan Hari</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />Kugon rimba Yeso ka zhu ri nji hari ri kpa kankankan riwa wa ran hi ri gbu ri. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Waka bru ye wa ri la ngbron mba, ama wawa ngawen wa ran kpa nyɨme ran.<verse eid="MRK 16:13" /></para>
  <para style="s">Yeso a zhu ri Miri ko wan Wuru don ri</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Kugon rimba Yeso ka ye zhu ri miri ndu wan wurudon ri riwa wa ran ri ri; ka yɨra wa ngaa ritu ika kpanyɨme nga sentu mba ri kamba ri wo wawa wa to wawu kugon riwa wawu a tashɨme. <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />Rimba ka tre riwa ri,&lt;&lt;Hi rimi mgbumgblume wawu bi ri la tre ndindi ri nji wawu. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />Inji riwa kpanyɨme nga wa son-u tu ri ima ari fe kpa chuwo, Ama nji riwa a kawan ri kpanyɨme ari so yaa. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />Ngha wa ti kya wa de sisiri nyi ri wawa wa kpanyɨme ri nde won, wa zhu meme wu wa tre ri rɨme nkan-nkan; <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />Wa ban manzɨrama ri wo mba, ko bibi ima ntson bibi tan riwa wa so, a ran kpa wa time ran; wa ka wo mba sa ri tu nji riwa a ran he si kpa ran, ari fe si kpa.&gt;&gt;<verse eid="MRK 16:18" /></para>
  <para style="s">Wa ban Yeso hi ri Shu</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />Kugon riwa Bachi Yeso a nghɨron wa, wa ka ban wu hi shu wulu a ka son ri wo ri riwa Izhi <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Imiri ndu wan waka hi wari ran la tre ndindi ri mgbumgblume, Bachi ka ran dzon wa, wa ran ti kya riwa a ri de sisiri riwa a no wa ran ti ri tre.<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>