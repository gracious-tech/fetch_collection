<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- BUU</book>
  <para style="h">GAL - BUU</para>
  <para style="toc1">GAL - BUU</para>
  <para style="toc2">GAL - BUU</para>
  <para style="toc3">GAL - BUU</para>
  <para style="mt1">GAL - BUU</para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />Imbe nyi zhu ri ame Bulus, nji ri ndu Izhi, a ran he nji ri ndu nji ran, a ran dzu ri wo njo,tsede dzu ri wo Bachi Yeso, nga Ti mbu Izhi, riwa a ta Yeso shɨme rimi Kuu, <verse eid="GAL 1:1" /><verse number="2" style="v" sid="GAL 1:2" />ame ri ngbron miri vayi won, wawu wawa wa he ri me.</para>
  <para style="p" vid="GAL 1:2">Hi ri wa hu Izhi ri meme Galatiya. ri Galatiya.<verse eid="GAL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3" />Ki ibreno dindi ti ri son sisron riwa timbu Izhi nowa he riyi, nga riwa Bachi Yeso Kristo, <verse eid="GAL 1:3" /><verse number="4" style="v" sid="GAL 1:4" />riwa a ka ngawan de ritu meme ti mbu riwa a kpa to chuwo ri meme son ri nzannyi, bibi nyɨme Timbu, Izhi. <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />Gbresan he wama hi ri kre wan.<verse eid="GAL 1:5" /></para>
  <para style="s">Itre Izhi ri Nkan ran he Ran</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />Me ti sisri ritu riwa bi chichi kɨma gon ti nji riwa a yo yi, ritu dindi ti riwa Kristo, bi kɨma ri hu tre Izhi ri nkon, <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />riwa a ran he tre Izhi ran wawu, ritu riwa wari wa wa wari kpayi pisi no tre Kristo no ran he ran. <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />Ama ko kita, ko nji ri ndu Izhi ri shu,inde njo mbu ri tre tre ri nkan ri wa ki tre ri yi, ka fe ti nyu! <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />Bibi riwa ki tre nye, me bru tre nganga. Inde njo ri layi tre ri han kya riwa bi kpa rita, ka fe la nyu!<verse eid="GAL 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10" />To, ame me wa nyɨme wa nji nye, ka riwa Izhi? ka me wa me ri no wanji sisron? Wari tre ri me wa no nji sisron nye, meri ran he vren ndu kristo ran.<verse eid="GAL 1:10" /></para>
  <para style="s">Izhi Nyen a Yo Bulus</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />Me wa no yi to, imiri vayi, itre Izhi riwa me la yi a ran he riwa nji ran. <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />Ritu riwa a ran he ri nji nye me fe wu ran, nga a ran he tsro nye wa tsro wen ran, ama a he Yeso Kristo nye a bu ri mo.<verse eid="GAL 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13" />Bi wo bibi meme ti won riwa me ran ti rimi nji Yahuda, riwa me no wa hu Izhi ya ba lo sron, me ri wa me kpaa tɨme. <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" />Me hi kusi han wa nzan won ri nji Yahuda rimi tre Izhi mba nga me ri yo sron rimi bibi ti riwa watitimbu. <verse eid="GAL 1:14" /><verse number="15" style="v" sid="GAL 1:15" />Ama Izhi riwa a chu wen tu chachu riwa wa ngɨzhi wen, ran yo wen rimi dindi ti wan, ran ngɨri <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />ritu riwa ari tsro vren wan rimo riwa me tre tre wan rimi wawa wa ran to Izhi ran, ame Bulus me ran wa ghɨron rinjo ran <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />nga me hi Urushelima riwa me to wawa wa gbuchi he mirindu Izhi rimo ran, ama me ka wulunde hi rimi gbu Larabawa me ri bru ye ri Damasiku.<verse eid="GAL 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 1:18" />Imba kugon se tra, me ka hon hi Urushelima riwa me to Kefas, meri ka ti vi wurudon ton riwu. <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />Ama meran to ko riri rimi wandu Izhi ran ara Yakubu, vayi Bachi. <verse eid="GAL 1:19" /><verse number="20" style="v" sid="GAL 1:20" />Ikya riwa me ngaa ri yi a he kpunji wan, ko Izhi to ri meran ri tiche ran. <verse eid="GAL 1:20" /><verse number="21" style="v" sid="GAL 1:21" />Kugon rimba meka hi ri meme Suriya mba Kilikiya. <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />Ama wawa wa hu Kristo ri meme Yudiya, wana to wen si ri si rina. <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />Tsede wa wo wa tre, &lt;&lt;Shawulu nji riwa a ran nota ya, ngye ngaa zizan ari la tre ri kpanyɨme riwa a ran zi-u risen.&gt;&gt; <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />Imba waka gbre Izhi ritu me kpa Izhi.<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s">Ngbɨron Wa Ndu Izhi wa Kpa Bulus</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />Kugon se wuru don nza me bru hi ri Urushelima, ri vi nyi kita mbu Banaba. Me ban Tatusi hu ngawon. <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />Me hi ritu riwa Izhi a bu ri mo no wen me hi. Riwa me son ri wa rinkon ndu Izhi ri Yayɨbi, me la wa wawa wa ran he nji Yahuda ran tre Izhi ritu me ran wa no ndu riwa meti riwa me ti no he kuklu ran, <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />Ikpan zren won Titusi riwa a he wa nji Helene wa ran vu ri no fon nzhu ran. <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />Me tre riwa ri yayɨbi ritu wari mba wa ti che ri wawa wa he wa hu Izhi ama a ran he ngamba ran. Wa ti ngamba ritu wari to nchimbu wari kɨma ta ti gran. <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />Ki ran srenton ri wa ran ritu ki wa no kpunji tre Kristo no hi kusi ri tumbi.<verse eid="GAL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6" />Wa rinkon ri Urushelima wawa wa tsro mbi wa no wa nkpen wa ran yo kya cha rimi kya riwa ki tre ran ritu Izhi ran ri ya ta ri kpa ran ama ari ya sron mbu, wa rinkon mbi wa ran yo kyari cha ta rimi tre riwa ki tsro ran. Ama wawa wa ran ban wa ri wa kyari, ko wa he riri rimo ritu Izhi ran ri sutu ran. <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />Riwa wa to ka Izhi yo wen no wen tre tre wan ri wawa wana he nji Yahuda ran bibi riwa Izhi a yo Bitrus no ngɨzhi tre Izhi hi no wa nji Yahuda. <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />Ritu gbengbren riwa Izhi no wen Bitrus me he nji ri la tre Izhi ri ri nji Yahuda bibi riwa a he ri me nji ri tre tre Izhi ri wawa wana hu Izhi ran. <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />Yakubu, Bitrus nga Yohana, wawa wa to ri Izhi no wen dindi ti wari vuwo ri me nga Banaba no tsro ri kita ki he kpandu ngambu iwawa. Imba, ki kpa nyɨme ri kita ki tindu ri wawa wa ran he nji Yahuda ran wawa wa hi ri wawa wa he nji Yahuda. <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />Irimiren mba he ri ki zon wawa wana he ri kya ran ikya a nye ki sondu taka riwa ki ti.<verse eid="GAL 2:10" /></para>
  <para style="s">Bulus a Ven ri Bitrus ri Antakiya</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />Wo kya riwa a ti kusi nji ritu kya riwa a ti a ran tsra ran. <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />Bitrus a ran ri ri ri wawa wa ran huu Izhi ran ama riwa Yakubu a to wa huu Izhi wari wa Urusheima tse Bitrus ka ka riri ri wawa wa ran he nji Yahuda ran chuwo ritu a ran ti sisiri no wa ran tre ri ari kabru tu ri wawa wa ran fon nju ran. <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />Nghamba nji Yahuda wawa wa kpa Izhi waka gra ti meme ti bibi riwa Bitrus, wari gbi Banaba yo ri bibi kya riwa wa ti. <verse eid="GAL 2:13" /><verse number="14" style="v" sid="GAL 2:14" />Riwa ame Bulus me to wa gbuchi to wa ran ti bibi kya riwa Izhi a ran tsra ri kpunji tre riwa Izhi ran, me ka tre ri Bitrus nga kusi mba iwawu, &lt;&lt;A wu wu he nji Yahuda ama wuti kya ka wu ran he nji Yahuda ran. wu ti se wuri vu wawa wa ran he nji Yahuda ran ri gbengbren no wa ti kya riwa nji Yahuda wa ti?&gt;&gt;<verse eid="GAL 2:14" /></para>
  <para style="s">Wa Nji Yahuda ri Wawa wa ran he Nji Yahuda Ran wa fe Kpachuwo ritu Kpanyime</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15" />&lt;&lt;Kita mbuu wa ngɨzhi ta ri nji Yahuda, a ran he wawa wa kamba ri kpa Izhi wari ri ti meme ti ran. <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" />Ki to, wa ran ri kpanji ritu ndu wan ran ama ritu kpanyɨme wan rimi Yeso kristo, kita ngawen ki fe kpanyɨme rimi Yeso a ran he ritu hu doka Musa ran.Ritu ritu wa doka nye wa kpanji ran. <verse eid="GAL 2:16" /><verse number="17" style="v" sid="GAL 2:17" />Inde ki wa no wa kpa ta rimi kabru tu ri Izhi ri kpa Yeso wa tre ri ki he wa meme ti, a he riwa wa tre ri kristo ri nyɨme meme ti Aran ngmba ran! <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />Inde me gbuchi bru ri mme ritu kya riwa me ran zi-u, rimba tsro ri me he nji riwa a kpa doka time, <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />Ame me kawon ri doka Musa me ri hu Kristo. <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />Wa kpan wen mbu Yeso ame me ran he ri si ngaran ama Yeso he ri si rimi won. Ihe riwa me he zizan, me he ri yo sron rimi vren Izhi riwa a nyɨme wen ran ka sron wan de ritu won. <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />Me ran kawon ri dindi ti riwa Izhi ti rimo inde ki tre ri nji ri fe nkpen ri Izhi ritu hu doka Musa ka ikuu Yeso he kuklu!&gt;&gt;<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s">Ibla tre ka Ikpanyɨme</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />Biyi nkpranchi wa nji Galatiya! Nghaa nye gyuru yi? Kusi mbi nye wa kpan Yeso kristo ri konkron ka kuu. <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />Ikya riri nye me wa meri minye yi. Bi fe Yuu Izhi ritu hu doka Musa nye ka ritu kpanyɨme ri tre riwa bi wo? <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />Bi gbuchi ti-u ri Yuu Izhi ko zizan bi wa bi ri kre wu ri gbengbren mbi? <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />Iya riwa bi ti-a a he kukulu nye? ka bi ti ya nyi bran kukulu nye! <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />Izhi no yi Yuu wan nga bi ti kyawa wa de sisiri ritu doka Musa nye, ka bi wo tre dindi nye ko bi ri kpa nyɨme?<verse eid="GAL 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6" />Nghamba nye Ibrahi: &lt;&lt;A kpa nyɨme ri Izhi, ritu ngamba nye Izhi a kɨma-u ti nji ri dindi kusi wan.&gt;&gt; <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" />A he riwa bi to ri wawa wa kpa nyɨme ri Izhi wa he miri Ibrahi nye. <verse eid="GAL 3:7" /><verse number="8" style="v" sid="GAL 3:8" />Rimi mbe Izhi nye wa tre ri Izhi ri ngɨzhi wawa wa ran he nji Yahuda ran ye ri nkon ritu kpa nyɨme. Sisenmu wa la tre raro ri Ibrahi ri,&lt;&lt;Ritu wen nye mgbumgblu me wawu wa fe lɨbu dindi.&gt;&gt; <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />Wawa wa kpa nyɨme waka ti lɨbu dindi sro riwa iwa Ibrahi nji ri wa a yosron ri Izhi.<verse eid="GAL 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10" />Wawa wa yo sron ri doka Musa wa wawa wa lanyu ri wa, ritu a he rimi mbe ri,&lt;&lt;Inji riwa a ran kri ri kya riwa a he rimi doka riwa Musa ngaan ri mbe wan ran a he nji riwa Izhi lanyu ri wu nye.&gt;&gt; <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" />A kri ri ra gbende ri injo ran ri fe lɨbu riwo Izhi ritu hu doka ran tsede,&lt;&lt;Inji riwa ari ti dindi ritu kpa nyɨme ri Izhi nye ri son si.&gt;&gt; <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" />Doka ran he ritu yo sron ran, ritu a tre,&lt;&lt;Inji riwa a ti ndu riwu ritu wan nye ari son ri si.&gt;&gt; <verse eid="GAL 3:12" /><verse number="13" style="v" sid="GAL 3:13" />Kristo kpata chuwo rimi ila nyu ri doka Musa riwa a he la nyu ritu mbu, ritu a he rimi ngaa ri,&lt;&lt;Inji riwa kpan-u ri konkron, a he nji riwa wa la nyu riwu.&gt;&gt; <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />Wati rinyi ritu no ndindi ti riwa wano ibrai nofe wawa wana he nji Yahuda ran zu riwo kristo Yeso, kita nga riwa yo sron mba riwa wa ka tre Izhi.<verse eid="GAL 3:14" /></para>
  <para style="s">Ibla tre ri ka tre zi</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />To, imiri vayi no wen me tsra kyari ri yi ri son ri bla vi. Bibi riwa inde wa kau zi njo ran yo kyari cha ran. <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />Ika tre dzi wa tre ri Ibrahi nye nga nji ri rimi wan. Itre Izhi ran tre ri&lt;&lt;Wa gɨzhi ran,&gt;&gt;Nufi wanji Ama&lt;&lt;Ri gɨzhi wen,&gt;&gt;Nufi nji riri riwa a he kristo. <verse eid="GAL 3:16" /><verse number="17" style="v" sid="GAL 3:17" />Ingye kya riwa me tre-en, doka nyi ri wa a ye kugon ri se gbigba nza ri setra, a ran gban tre riwa wa kadzi mgbamgbanmu riwa a ri kau chuwo ran. <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" />Inde ide nyi ye zu ri doka nye ka ara ye ri nkon ika tre zi ri Ibrahi riwa Izhi a de ran ama ritu ika tre zi riwa Izhi a ti ri Ibrahi nye a no de nyi. <verse eid="GAL 3:18" /><verse number="19" style="v" sid="GAL 3:19" />A he ngamba wa ngɨzhi doka ye ritu ngye? Wa ti ritu no tsro ri kya riwa wa ti ran he ri nkon ran wa zi doka ritu no kri hi ri vi riwa wa ngɨzhi Ibrahi ri ye, ritu ika tre zi a Izhi a ti ri Ibrahi nye. Doka wandu Izhi nye wa ngɨzhi ye, ri Musa riwa a he ri tsutsumba. <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />Inji ri tsutsumba ran he ritu riri ran ama Izhi he riri nye.<verse eid="GAL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21" />Zizan doka Musa ri kawan ri ka tre zi riwa Izhi? Onhon! Nde nji kpa doka riwa ari kpawa chuwo ko ngaan ran mɨlan son wan ti ran son zhanzhan kusi Izhi. <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />Ama itre Izhi tre ri mgbumgblume he rimi meme ti, ide riwa wa ka tre dzi ritu yo sron Yeso Kristo riwa wa no wawa wa kpa nyɨme. <verse eid="GAL 3:22" /><verse number="23" style="v" sid="GAL 3:23" />Ama kafi no vi yo sron no ye doka a tre ta zi ka wa bre shitan tse iyo sron riwa ari ye zhuu raa. <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />Imba ki hu doka tse riwa Kristo a ye ritu riwa ki he dindi kusi Izhi ri yo sron. <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />Zizan riwa ivi ri yo sron ri Yeso ye ki ran he riwo doka ngaran.<verse eid="GAL 3:25" /></para>
  <para style="s">Imiri Izhi</para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26" />Bi he miri Izhi wawu mbi ri yo sron rimi Yeso Kristo. <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />Ritu biyi wawu wawa wa son yi ri ima rimi Kristo zizan wa suu tsro Kristo ri yi. <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />Itre nji Yahuda ko wawa wa ran to Izhi ran ko gran ri wawa wa ran he gran ran, ko ronron ko mba wawu mbi bi he riri ri Yeso Kristo. <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" />Inde bi he wa Kristo bi he wa gɨzhi Ibrahi nga bi kpa kya riwa Izhi ka zi iri ari ti.<verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />Ama zizan ikya riwa me la yi ivren riwa ari vu kpi tiwan a ran han gran ran, ko riwa ari ngɨzhi ko ngye. <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />Riwa a he vren, nji wari wa he riwa wa ngɨzhi-u hi chachu riwa iti wan a ka dzi. <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />A he ngamba ri ta riwa ki he ri miri, ki he gran ri bibi ti ri mgbumgblu mme. <verse eid="GAL 4:3" /><verse number="4" style="v" sid="GAL 4:4" />Ama riwa ivi a ye, Izhi ka ti vren wan ndu, riwa iwa a ngɨzhi-u, riwa wa ngɨzhi-u ri mi doka, <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" />ritu no kpa wawa wa he rimi doka Musa chuwo no ta ki he miri Izhi. <verse eid="GAL 4:5" /><verse number="6" style="v" sid="GAL 4:6" />Tunde bi he miri nye, Izhi a ti Yuu vren wan ye rimi sron mbu ari yo,&lt;&lt;A ti, A ti.&gt;&gt; <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />Ritu ngamba wu ran he gran ngaran ama ivren wen nye. Tunde wu he vren, to Izhi kɨma-u ti nji riwa wu ri gado.<verse eid="GAL 4:7" /></para>
  <para style="s">wa nji Galatiya wa lo Bulus Sron</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />Risen bi ran to Izhi ran bi ran hu Izhi riwa bi ran to-u ran riwa wa ran he kyari ran. <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />Ama zizan riwa bi to Izhi, ko wari tre ri Izhi to yi bi ti se bi ri bru kɨma hi ri bibi ti riwa a ran zon yi ri kyari ran riwa me tre me bru huu? <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />Bi hu wa vi ri huwa nga wa se mba sron mbi! <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />Me ti sisiri mbi, ritu me ran ti ndu kuklu ritu mbi ran.<verse eid="GAL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12" />Me ibreyi, miri vayi he bibi riwa me he, me he bibi riwa bi he bi ri ran ti kya meme ri mo zari ran. <verse eid="GAL 4:12" /><verse number="13" style="v" sid="GAL 4:13" />Bi taka ritu me ran he ri si ran me tre tre Izhi ri yi ri ye won ri gbuchi. <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />Ko ri riwa lilo won bi ran seke ran, ama bi ran tsri wen ka bi shɨma wen ran tsede bi kɨma wen ti ka me he vren ri ndu Izhi, nga ka me he Yeso Kristo kyuwan <verse eid="GAL 4:14" /><verse number="15" style="v" sid="GAL 4:15" />Biyi bi ti kinklan sron bran ri me, ko ingye ti ko bi ran ri ti kinklan sron ri me ngaran? Ame kyuwon me tre ri bi ri kɨma sron mbi no wen. <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />Zizan me kɨma he kpanfu mbi ritu riwa me la yi kpunji tre?<verse eid="GAL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17" />Inji wanyi wa yosron ri yi ama ikya riwa a he ri sron mba he kya riwa wa wa a he riwa wa wari ga ta iwayi ritu wa wa no sron mbi no he riri ri wa mba. <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />Zizan a bi riwa inde wu to kya riwa a bi wu ka ti-u, a ran he tse me he ri yi ran. <verse eid="GAL 4:18" /><verse number="19" style="v" sid="GAL 4:19" />Biyi miri won wa ti se me bru ri so ya ritu mbi ka iwa riwa ari yi nne ri so ko no Kristo no gbron ri sron mbi, <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />wa ri tre ri me he iwayi zizan me ri la yi tre nyi ritu won.<verse eid="GAL 4:20" /></para>
  <para style="s">Ajaratu Ngha Saratu</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />Bi yi wawa bi hu doka Musa bi ran ri wo kya riwa doka Musa ri la ran? <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />A he ngaa ri Ibrahi he ri miri hari iri he vren riwa gran a ngɨzhi nga riwa a he riwa iwa wan riwa a gran wu ngɨzhi. <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />Ivren riwa a ngɨzhi riwa a he gran a he bibi riwa wa gɨzhi ko ngaan, ama riwa Bachi a tre zi wawu nye riwa iwa wan ri ko a ngɨzhi.<verse eid="GAL 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 4:24" />Kyawa wanyi wa he kɨbu tre nye, imba hari wanyi wa he ikatre dzi nye Ajaratu he wa riwa a ngɨzhi miri wan rimi vi ri graan nga a he ka itre riwa wa kadzi ritu Sinai <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />Ajaratu he ka tita ri Sinai nye ri meme larabawa. Wawu nye he bibi ri Urushelima ri zizan, ritu wawu ri miri wan wa he graan nye. <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />Ama Urushelima riwa a he ri shu kita wawa ki hi ri bubu wan ki fe son vri nga a he yii mbu Saratu. <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />Itre Izhi tre ri:</para>
  <para style="q1" vid="GAL 4:27">&lt;&lt;A wu wa riwa wu son ri wulo ti kinklan sron riwa wu ran ngɨzhi ran kpa gro wuri yi gbangban,</para>
  <para style="q2" vid="GAL 4:27">a wu riwa wu ran yi nne zari ran;</para>
  <para style="q1" vid="GAL 4:27">ritu iwa riwa kamba riwa a han riwa a he ri miri,</para>
  <para style="q2" vid="GAL 4:27">han riwa a he ri ronron.&gt;&gt;<verse eid="GAL 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28" />Zizan biyi miri vayi kita ngawen ki ran he miri wawa wa he ka Ishaku riwa Izhi a ka tre zi ritu wan. <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />Bibi riwa a he risen, wawu vren riwa wa ngɨzhi-u rimi bibi riwa wa ngɨzhi ko ngaan a no riwa wa ngɨzhi-u rimi gbengbren Yuu, ngamba nye a he zizan. <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />Ama ngye itre Izhi tre?&lt;&lt;Zu waa ri gran mba vren wan, ritu ivren riwa a he graan a ran ri gado ri vren riwa wa gran yi wan ran.&gt;&gt; <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />Ritu ngamba miri vayi kita ki ran he miri wa riwa a he graan ran ama ki he miri waa riwa wa gran wu.<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="s">Ison Ri Tuwen Rimi Kristo</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />Ritu son tumbu nye Kristo kpa ta chuwo kuklu, ki mgbemgben, ran bru kɨma ngambi gra ri son ri graan ngaran.<verse eid="GAL 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2" />Wo wen ame Bulus me la yi inde bi no wa fon yi nju ka bibi ti riwa nji Yahuda wati, ari he iri Kristo ran he kyari ri yi ran. <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />Ronron wawa wa fon wa nju iwawu, me fen yi ton no yi hu doka Musa. <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />Wawa wa wa wari hu Izhi zu ri hu doka Musa wa ka nkon Kristo chuwo wa ran he rimi dindi ti riwa Izhi ran. <verse eid="GAL 5:4" /><verse number="5" style="v" sid="GAL 5:5" />Ama kita wawa ki he wa Yeso nye ki yo sron ri Yeso ki ri gben riwa ki kpa kya riwa Iyu Izhi la ta ri ki yo sron. <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />Kita wawa ki he ri Yeso, ko wa fon wu nzhu ko wa ran fon wu nzhu ran rimba ran he kyari ran ama ki yo sron mbu zu ri nyɨme ngambu.<verse eid="GAL 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7" />Bi ran he ri kpa nyɨme bran bran, ko ngye nye zu yi ri kpa kpunji tre zizan? <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />Ikɨma hi gon mbi ran zhu ri Izhi ran. <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" />&lt;&lt;Vi mumu ri kpa kpi fu nye ri no nchon mumu no fu,&gt;&gt; Bibi riwa wa tre. <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />Me kpa nyɨme riyi rimi Izhi me he ri yo sron ritu mbi riwa bi ran hu tre ri nkan ran nji riwa ari kpa sron mbi time ko a he ngaan, a ri to ya riwo Izhi. <verse eid="GAL 5:10" /><verse number="11" style="v" sid="GAL 5:11" />Imiri vayi won, i me kawon si tre tre Izhi hi ri ifon nju he no wa fon, ritu ngye ko wa no wen ya? Ka rimba he kpunji, to itre tre kpan Kristo ri konkron ran ngɨzhi janyu ye ran. <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />Ran bi riwa wawa wa kpa sron mbi ri time no wa kamba ran hi, no wa kamba hi wari yira ngamba. <verse eid="GAL 5:12" /><verse number="13" style="v" sid="GAL 5:13" />Biyi miri vayi wa yo yi ritu son ri tumbi, ama ran no son tumbi no he kya riwa ari no yi ti kya ri nyɨme sron mbi ran, tsede bi ka hu ngambi ri nyɨme ngambi. <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />Ritu doka wawu wa kau zi ri wulo tre riri:Iri,&lt;&lt;Kpa nyɨme ri nji ri kusan wen bibi riwa wu kpa nyɨme ri ngawen.&gt;&gt; <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />Inde bi kambi ri no ngambi ya bi ri ri tan ngambi nyiri mɨlan ya, bi ka kpa nga mbi time.<verse eid="GAL 5:15" /></para>
  <para style="s">Izren Rimi Yuu</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />Ikya riwa me tre ri no Yuu no tsro-u nkon sonwen, riwa wu ran no nyɨme sron wen ri kpa no kpa nyɨme ri sron ri meme ti ri wa nji ran. <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" />Ikya riwa isron mbu riwa kpa ri wa Iyu Izhi ran ri nyɨme, ikya riwa Iyu Izhi nyɨme isron ri kpa ran nyɨme-u ran ikya hari wa nyi wa he kpan nfu ngamba nga rinyi wu ran to ti kya riwa wu wa wuri ti ran. <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />Inde Iyu Izhi ngɨzhi yi ri zren, ka bi ran he rimi doka Musa ran nye mba.<verse eid="GAL 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19" />Indu riwa kpa ri kri ri rira, wato wa ikru miri nze iwa miri mba, meme zren, nga meme ti; <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />ritu Izhi riwa bi ran to-u ran, iya tsu, ri iyo ngambi kusi, ijanyu, ri nngu, ifu nga nyɨme tuwen, iwanyu ri tsutsu, ison nkankan. <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />iti huu, hi, iti ntran nga ngbron bibi mba. Me fen yi ton bibi riwa me ti risen ri wawa wa ti bibi kyawa wanyi, wana fe bubu son ri ko Izhi ran.<verse eid="GAL 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22" />Ama Iyu Izhi ri ngɨzhi nyɨme, kinklan sron, ri sisron, ivusron, dindi ti, iti kya ribi, iti tsra, <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />iti rerenga vu tu. Wawa wa ti bibi kyawa wa nyi doka Musa ran vu wa ran. <verse eid="GAL 5:23" /><verse number="24" style="v" sid="GAL 5:24" />Wawa wa he riwa Yeso Kristo nye wa ka meme ti mba chuwo ri meme timba nye mba riwa a he ri kpa kankankan. <verse eid="GAL 5:24" /><verse number="25" style="v" sid="GAL 5:25" />Tunde ki kii rimi Yuu, no son mbu no he bibi riwa gbengbren Yuu. <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />Ki ran no nzu tu mbu gyuru ta ran, kiri ran wa ngambu nyu, ran ti huu ri ngambu ran.<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="s">Ti Dindi Ti ri Ko Ngha</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />Miri vayi ka bi vu njo ri bubu ti meme ti, biyi wawa bi he rimi Yuu Izhi bi ka ngɨzhi-u ye ri nkon ri reretre, bi ri milan ya ngambi ritu riwa biyi ngawen bi ran zii gra rimi wan ran. <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />Ban yaa ngambi, rimi nganyi nye bi hu doka riwa Kristo. <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />Inde njo tre ri wawu he kyari, ama a ran he kyari ran, ari gyuru ngawan nye. <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />Ko ngaa ka tsra tuwan to, inde a to a bi, imba nye ari kpongawan ritu kya riwa ari ti kyuwan a a ti, a ran tsra ri kya njo rinkan ran, <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />Ko nga he ri kpi riwa ari ban. <verse eid="GAL 6:5" /><verse number="6" style="v" sid="GAL 6:6" />Ko ngaa riwa a kpa tre Izhi, ari ga kya wan wa dindi ri nji riwa a tsra-u.<verse eid="GAL 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7" />Ran no wa gyuru yi ran: Ritu wa ran ri ti Izhi ndan ran. Inji ri sren kya riwa a chu. <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />Izhi ri no wawa ikpa mba tsro wa kya ri nowa ti ya. Ama wawa wa Yuu Izhi sisron wa son hi ri kre ri Izhi ritu kya riwa Iyu Izhi ri ti ri wa. <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />Ki ran kumbra ri ti dindi ti ran, ritu ki sondu ran sren, inde ki ran kumbra ran. <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />Ritu ngamba ki ran dzon ko ngaa, inde a bi, a zizan wawa wa hu Izhi.<verse eid="GAL 6:10" /></para>
  <para style="s">Ikre Ngha Fe nton</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />To bibi kpolo ngaa riwa me ngaa ri yi ri wo won!<verse eid="GAL 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 6:12" />Inji wawa wa wa wari tsro ri wawa wa to rimi kpa, wawa nye wa wa wari vuyi to rimi gbengbren ri no yi fon nju, ritu wa wurutsu so yaa ri kpan konkron riwa wa kpan Kristo. <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />Ko wawa wa fon wa nzhu wa ran hu doka ran isu mba nye wa wa wa no wa fon yi nzhu wa ri ka don kpo ngamba ri yi ritu riwa wa fon yi nzhu. <verse eid="GAL 6:13" /><verse number="14" style="v" sid="GAL 6:14" />Ama ame me ran kpo ngawon ritu kyari ran, tsede,ritu kpan Bachi mbu Yeso Kristo, riwa ritu kuu wan ri tu konkron me ka kyawa wa mgbumgblu mme don, nga mgbumgblu ka wen don. <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />Ko ifon nzhu, ko a ran fon nzhu ran, a ran he kyari ri mo ran, ikya riwa a he wuwu nye he kya riwa ngɨzhi-u sisa. <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />Me bre Izhi no isisron ri losron ri wawa wa hu gba nyi iwawu, wato wa nji Israila riwa Izhi. <verse eid="GAL 6:16" /><verse number="17" style="v" sid="GAL 6:17" />Ri kre wan, no njo no ran bru ngaa wen ran ritu wa nkpan riwa wa he ri kpa won riwa ari tsro ri ame me he nji ri tindu ri Yeso. <verse eid="GAL 6:17" /><verse number="18" style="v" sid="GAL 6:18" />Wa kpan won, Me ibreno dindi ti Izhi no he ri yi wawu mbi, no he ngamba.<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>