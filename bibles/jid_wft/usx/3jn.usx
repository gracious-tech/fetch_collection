<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- BUU</book>
  <para style="h">3JN - BUU</para>
  <para style="toc1">3JN - BUU</para>
  <para style="toc2">3JN - BUU</para>
  <para style="toc3">3JN - BUU</para>
  <para style="mt1">3JN</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />Ame Yohana nji rinkon ri tra Izhi,</para>
  <para style="p" vid="3JN 1:1">Me ngan mbe nyi ri no-u a wu kpan won Gayus, riwa me nyɨme-u ri kpunji.<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />A wu kpan won me ibreritu wu ri fe son ri sikpa ri gbengbren bibi riwa wu he ri wu rimi Yuu. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />Me ti kinklan sron bran riwa me to miri vayi wa hu Izhi wari wawa wa ye la wen bibi dindi ti wen riwa wu he ri wu ritu kpunji nga bibi riwa wu sondu ran zren rimi kpunji-a. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />Ikyari ran no wen kinklan sron bran bibi riwa me wo ri imiri won wa son rimi kpunji ran.<verse eid="3JN 1:4" /></para>
  <para style="s">Wa Gbre Gayus</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />A wu kpan won, wu ti dindi ti rimi ndu riwa wu ti ri wa hu Izhi-a, kau ri riwa wa he tsren ri wu. <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />Wa ye la ri tre Izhi ri nyi bibi nyɨme riwa wu he ri wu. Bubwo wen sondu ran dzon wa rimi zren mba riwa ari sii Izhi sron. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />Ritu wa hi zren mba ritu wari la tre Kristo nye, wa ran ri wa dzon kya ri wawa wa ran ri hu Izhi-a ran. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />Ritu ngamba a bi riwa kita wa hu Izhi ki dzon bibi nji wanyi ritu kiri he wa kpan ndu mba rimi kpunji.<verse eid="3JN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />Me ngan mbe nyi no wa hu Izhi ritu wan, ama Diyotarifis riwa ari wa ran he kusi ko ngaa, a kawan ri wo kya riwa me tre. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />Ka me ye ri yi, me ŋɨran nchi Diyotarifis ri yi ritu meme ti wan riwa ari ti nga tre meme riwa ari tre ritu mbu ri blamu, nga kran ta. A kawan ri kpa miri vayi wa hu Izhi wawa wa ye nga ran dzu wawa wa ran wa wari kpa wa ran dzu wa zho rimi tra Izhi.<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />Biyi wa kpan won wawa me nyɨme yi, ran ti bibi kya riwa a meme ran, ama bi ti kya riwa a bi. Nji riwa a ti kya riwa a bi a he riwa Izhi. Nnji riwa ari ti meme ti a ran to Izhi ran. <verse eid="3JN 1:11" /><verse number="12" style="v" sid="3JN 1:12" />Ko ngaa ri tretre dindi ritu Dimitiriyus nga ritu kpunji kyuwan nga kita ngawen ki la kya riwa a ti. Ngha ki tre tre mbu ritu wan, nga bi to kya riwa ki tre a he kpunji.<verse eid="3JN 1:12" /></para>
  <para style="s">Ichi ri Krenkpen</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />Me he ri tre bran riwa me la yi, ama me ran ri wa no he ri tita ri ngha mba nklan ri ngan ka kre ran. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />Aran bran vi ran me wa miri to yi nga ki ri tre isi ri si.</para>
  <para style="p" vid="3JN 1:14">No dindi ti no he ri yi wa kpan mbi ri nyi wa chi yi chi wa kpan wawa wa he ri mba yi yiri mba.<verse eid="3JN 1:14" /></para>
  <chapter eid="3JN 1" />
</usx>