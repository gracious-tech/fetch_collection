<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- BUU</book>
  <para style="h">1CO - BUU</para>
  <para style="toc1">1CO - BUU</para>
  <para style="toc2">1CO - BUU</para>
  <para style="toc3">1CO - BUU</para>
  <para style="mt1">1CO - BUU</para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />Imbe nyi zhu ri ame Bulus, riwa wa chu wen no wen me he nji ri ndu Yeso Kristo, nga vayi mbu Sastanisu ngawen ri tre ri yi. <verse eid="1CO 1:1" /><verse number="2" style="v" sid="1CO 1:2" />Me ngan mbe nyi ri no yi biyi wawa bi kabru ri hu Izhi ri Koranti Izhi kayi dzi ri gran ritu no yi he riri rimi Kristo Yeso, a yo yi ritu no yi he wa Tstsri ri wau Izhi ko kutan wari ri bre Bachi Yeso Kristo, Bachi mba nga wambu ngawen:<verse eid="1CO 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3" />Me ibreno A ti mbu Izhi nga Bachi Yeso Kristo ri no yi dindi ti nga sisron.<verse eid="1CO 1:3" /></para>
  <para style="s">Bulus a Ngiri ri Izhi</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />Me sondu ri ngiri ri Izhi ritu mbi riwa a ti dindi ti ri yi dzu riwo Yeso Kristo. <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />Ritu riwa bi katu mbi kabru ri Kristo bi kpa kyawa wa dindi wawu. Ari no yi bi to tre ritu kyawa wa Yuu, nga bi ri he ri gbengbren ri to kya riwa Izhi la yi. <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />Ngye bibi riwa Izhi tsro yi ri tre riwa a layi ritu Kristo he kpunji. <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />Izhi no yi kongye riwa bi wa, ritu ngamba bi ran hon he ri de riwa Yuu ran, bi ri gben ri mbiye riwa bi to Bachi mbu Yeso Kristo ngari. <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />Ari no yi gbengbren hi ri kre wan, ritu bi ran he ri meme ti kyari ri vi riwa Bachi mbu Yeso Kristo ri kɨma ye. <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />Izhi he riwa ari ti kya riwa a tre dzi, wawu nye yo yi no yi kabru tu ri vren wan Yeso Kristo Bachi mbu.<verse eid="1CO 1:9" /></para>
  <para style="s">Iki Kaankan Rimi wa hu Izhi</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />Me ibreyi, miri vayi, rimi nde Bachi mbu Yeso Kristo no yi nyɨme ri ngambi wawu ri kya riwa bi tre nga rimɨrembi no he riri. Ran ga ngambi ran tsede bi ka katu mbi kabru, bi ri ki ri rimɨren riri. <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />Imiri vayi won mirimba ri miriron, wari ri ko Kuluwi wa lawen iri bi wanyu ri ngambi. <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" />Ikya riwa me tre he ri, wari rimi mbi wa tre ri,&lt;&lt;Wawa wa he riwa Bulus;&gt;&gt;Wari wa ri tre ri,&lt;&lt;Wawa wa he riwa Apolo nye;&gt;&gt;Nga wari wa tre ri, &lt;&lt;Wawa wa he wa Kefas,&gt;&gt; Nganga, wari wa tre ri,&lt;&lt; Ki he wa Kristo.&gt;&gt;<verse eid="1CO 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 1:13" />Ko enron, wa ga Yeso ti kaan kan? Bulus nye kuu ri tumbi? Ka wa son yi tu ri ima ri nde won Bulus? <verse eid="1CO 1:13" /><verse number="14" style="v" sid="1CO 1:14" />Me ngiri ri Izhi riwa me ran son njo mbi tu ri ima ran ara nji hari, wa Kirbus mba Gayus wawa nye me son wa tu ri ima, <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />Ritu ngamba injo ran tre ri wa son yi tu ri ima rimi nde wan ran. <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" />Me taka ri me son nji wa ko Istifanus tu ri ima, ama kugon wanyi me ran to ko me bru son njo tu ri ima ngaran. <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />Kristo ran ti wen ndu ri me son njo tu ri ima ran. A ti wen ndu ye no wen ye la wa tre ri raro. A ran he tre ritu wiwiri nji ran, ritu no wa ran tsri kuu Kristo ritu konkron ran.<verse eid="1CO 1:17" /></para>
  <para style="s">Kristo he Wiwiri nga Mgbemgbren Izhi</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />Tre konkron riwa wa kpan Yeso ritu wan a he tre kuklu ri wawa wa ti meme ti nga wa ri he ri nkon kuu, ama a he gbengbren Izhi nye ritu mbu, kita wawa wa kpata ri chuwo: <verse eid="1CO 1:18" /><verse number="19" style="v" sid="1CO 1:19" />A he rimi mbe Izhi ri:</para>
  <para style="q1" vid="1CO 1:19">&lt;&lt;Me dzi wiwiri nji wa wiwiri.&gt;&gt;<verse eid="1CO 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 1:20" />Inji wa wiwiri wa he rɨme? Wawa wa tsro doka Musa wa he kutan? Izhi tsro ri wiwiri ri mgbumbrume nyi he mkpɨranchi. <verse eid="1CO 1:20" /><verse number="21" style="v" sid="1CO 1:21" />Ritu Izhi rimi wiwiri wan a tre ri wa wiwiri wana to Izhi rimi wiwiri mba ran ari bi ri Izhi no kpa wawa wa kpa nyɨme ri tre wan riwa ki bla wari wa kpa ri a he tre kuklu. <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />nji Yahuda wa wa wari to kyawa wa de sisiri, nga Helunawa wa wa wari fe wiwiri, <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />ama kita ki tre tre ritu Kristo riwa wa kpan-u ritu konkron, tre Izhi he tita riwa a ra nkon ri nji Yahuda nga ran he kuklu ri wawa wana he nji Yahuda ran. <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />Ama Izhi chu nji wari no wa kpanyɨme riwu, warimba wa nji Yahuda nga wari wana he nji Yahuda ran wawa wa kpa nyime ri Izhi wato ri Kristo nye he mgbemgbe nkon riwa Izhi riwa ari kpa wa chu wo, nga wiwiri riwa Izhi. <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />Ama imkpran riwa Izhi a han wiwiri riwa nji, nga ika senkpa Izhi a han senkpan nji.<verse eid="1CO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />Imiri vayi taka kya riwa bi ran he riwa wa yo yi tsawen rimi mbi wa he ri wiwiri riwa nji, a ran he kigbu mbi nye bi he wa rinkon ritu nji ran, nga tsawen rimi mbi nye wa miri wa rinkon. <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />Ama Izhi ri chu kya riwa a he ri mgbumgbrume nyi ri a he mkpen, ritu no shan no ti wa. wiwiri Izhi ri chu kyawa wawa nji wato ri wana senkpa ritu no no wa senkpa shan. <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />Kyawa wawa nji wa ban wa wana he kyawa ran, wawa nye Izhi ri ban wa tindu ri wa. <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />Izhi ti kya nyi ritu no njo ran kpo ngawan kusi Izhi ran. <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />Izhi nye riwa a kayi kabru ri Kristo riwa a he rita wawu ri Izhi, ri ngamba nye, ndindi ti mbu, Tsitsri nga kpa ta chuwo. <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />Ritu bibi riwa a he ri ngan,&lt;&lt;No nji riwa ari kpo ngawan no kpo ngawan ri Bachi.<verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />Riwa ame Bulus me ye ri yi, miri vayi, me ran tre wɨlo tre wa wɨloga ka tre riwa a he ri yaa ran, nga me ran tre ri yi ka me to han gbron nji ran riwa me tre tre Izhi ri yayibi ri yi. <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />Riwa me ka zi ri riwa me he ri yi me ran tre ritu kyari ran tsede tre Yeso Krsito riwa a kuu ritu konkron ran kpa nji chuwo. <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" />Riwa me he ri yi ri Koranti, a kuu wen kpa a ran wiriwen kpa ritu sisiri. <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />Riwa me tre tre Izhi riyi me ran layi wiwiri won ran, nga me ran jan nyu ri wɨreyi ran tsede Iyu Tsitsri ri tsro yi ri nkon ri mgbemgibreri tre riwa me tre-a a he kpunji tre. <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />Riwa no yo sron mbi no he ritu wiwɨri nji ran tsede no he ritu gbengbren Izhi<verse eid="1CO 2:5" /></para>
  <para style="s">Wiwiri Riwa Izhi</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />Ama inde ki he ri wawa wa yikpa rimi tre Izhi, ki ka wa tre ri wiwɨri riwa Izhi ama a ran he wiwɨri ri nganyi a ran he ka riwa wa chu wa zizan ran, wa chu wamba wawa wa he ri kpanchi wawa wana he ri gbengbren ngaran. <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />Ama ki tretre wiwiri riwa Izhi riwa a ran he ri yayibi-a, ki la ritu ti Izhi riwa ari no ta mkpen riwa ki son ri si ko no Izhi no ti mgbumgblu me, a wa ran ti kyawa wanyi rita. <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />Ichu njo ran he ri mgbumgbrume nyi riwa a to ti Izhi ran, ritu wari tre wa to kya riwa Izhi a ran ti wari ran kpan Bachi riwa a he ri mkpen ritu konkron ran. <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />Ama, bibi riwa imbe Izhi la ta,</para>
  <para style="q1" vid="1CO 2:9">&lt;&lt;Isi ran to ran, nga ton ran wo zari ran,</para>
  <para style="q2" vid="1CO 2:9">ka injo ran taka zari riwa kyawa wawu riwa Izhi ti wa ri nji wawa wa nyɨme-u ran.&gt;&gt;<verse eid="1CO 2:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10" />Ama zizan Izhi tsro ta kyawa wanyi zhu riwo Yuu ritu wawu Yuu nye ri ŋraanchi kyawa wawu, Kyawa wa Izhi wawa wa he ri yaa to. <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />Ngha nye rito mɨren riwa a he rimi sron nji ri, inde a ran he Yuu nji-a ran? Ngamba nye a he, injo ran he riwa ari to ren ne Izhi ran tsede Yuu Izhi kyuwan. <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />Ki ran kpa Yuu ri mgbumgbru mme ran ama ki kpa Yuu Tsitsri riwa Izhi riwa ki to kyawa wawu riwa Izhi no ta ritu dindi ti wan. <verse eid="1CO 2:12" /><verse number="13" style="v" sid="1CO 2:13" />Rinyi nye he tre riwa ki la mgbron nji, a ran he tsro wɨlo tre riwa wa tsro ta ri wiwiri nji ran, ama iwɨlo tre riwa Iyu Tsitsri tsro ta ki la ri nji wa Tsitsri nji tre ri kpunji riwa Iyu la ta. <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />Inji riwa a ran he ri Yuu Tsitsri ran, a ran, wa ran wa ran wo ritu kya wa riwa Iyu Izhi ngaran yo ri ra ran, ritu kyawa wa-a wa kuklu riwu, nji riwa a ran hu Izhi ran a ran to kyawa wamba ran, ritu nji ri ya to ran kpanyime ri kyawa wanyi inde Iyu Tsitsri zon-u. <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />Inji wawa wa he ri Yuu Tsitsri wa to kongye. Ama nji wawa wa ran he ri Yuu ran wana to bla tre ri wawa wa ri Yuu ran. <verse eid="1CO 2:15" /><verse number="16" style="v" sid="1CO 2:16" />Ritu a he ri ngan ri,&lt;&lt;Injo ri to kya riwa a he ri sron Izhi? Injo ri to sron Izhi?&gt;&gt; Ama ki he ri sron riwa Izhi.<verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s">Wa Ndu Izhi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />Imiri vayi rimi hu Izhi, riwa me ye ri yi, me ran tre ri yi ka wawa wa he ri Yuu Tsitsri riwa ari tsro wa gba nkon ran, tsede me tre ri yi ka wawa wa ran kpa Izhi ran, me tre ri yi ngamba ritu bi kpa Izhi sisa gyen ri. <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" />Me no yi tre Izhi ri huiri ka bibi riwa iyii ri no vren sisan. Me ran tre riyi ri bibi tre riwa a he yaa to ran ritu bi ran tsra riwa bi kpa tsro-a rina ko zizan, bi ran tsra riwa bi kpa tsro nyi rina. <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />Me tre ri yi ngamba ritu hari zizan bi yo sron ri bibi kya riwa isron mbi ri wa, bi ti huu ri ngambi, bi ri ri janyu ri ngambi, rinyi ran tsro ri bi ki ka nji wa mgbumgbrume nyi ran? Bi ran ri ti ka nji wawa wana to Izhi ran? <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" />Inde njo mbi tre ri,&lt;&lt;Me huu Bulus,&lt;&lt;Nga wari rimi mbi wa tre ri,&lt;&lt;Me he wa Apolo,&lt;&lt; Rimba ran tsro ri bi he ka mgbron wawa wati meme ti ran?<verse eid="1CO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5" />Zizan me wa no yi to bibi nji riwa ame Bulus nga Apolo ki he ki he wa ndu Izhi inkankshe Izhi no ta ndu no ta ki tsro yi nkon riwa bi kpanyɨme ri Yeso, haambu ki ti ndu riwa Izhi no ta ki ti. <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" />Ame Bulus me chu wɨlokpi-a, nga Apolo nye bwa ima, ama Izhi nye no no zhuu-mbe. <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />Ri ngamba, nji riwa a chu wɨlokpi, nga nji riwa a bwa ima, wa ran he kyari ran, ama Izhi a han ritu wawu nye no mbe-a no zhu. <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />Inji riwa a chu ri nji riwa a bwa ima irimɨremba he riri ama ko ngan rife kya ritu bibi ndu riwa a ti. <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />Ame Bulus nga Apolo ki he ka wa ndu Izhi, biyi wanji Korantus nye bi he ka zhu riwa Izhi, bi yi bi he koo riwa a he wa Izhi.<verse eid="1CO 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 3:10" />Ri ndindi riwa Izhi no wen, me dzi nchi tra ka nji riwa a to tu ndu mme, nga njo ri nkan nye ri mme ritu wan, ko ngan riwa ari mme no mɨlan ya mme riwa ari mme. <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />Injo ran he riwa ari dzinchi mme ri nkan han riwa Yeso Kristo dzi ran. <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />Inde njo mme ritu nchi tra nyi riwa a tindu ri zanariya nga ri azurfa nga tita wa kpan riirii, ama inde wandu Izhi wa ran tindu mba tsra ran, wa he ka wa mme ko wawa wa tindu ri kpi mme wawa wa he huiri woto wa, konkron, ri mgbakpu nga giga, <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />chachu ri ko ngan rito bibi ndu riwa ko ngan ti ritu chachu riwa Yeso ri ye, ari no kyawa wanyi no wa he ri rira, iri Izhi ye ri wuru, nga iwulu ri tsra bibi ndu-a riwa ko ngan ti. <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />Inde indu nji riwa a ti a bi, ari kpa ife ri ndu wan. <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />Inde indu nji-a time, nji-a riti asara ko inde a fe kpachuwo, ama ari zhu ka a dzu rimi wulu nye zhu.<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />Bi ran to ri biyi kyumbi bi he Tsitsri bubu son riwa Izhi riwa ari son rimi mbi ran?<verse eid="1CO 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 3:17" />Inde njo kpa bubu Tsitsri riwa Izhi ri son time, Izhi ri kpa nji-a time, ritu bubu son Izhi he Tsitsri, nga biyi nye bi he bubu Tsitsri riwa Izhi-a.<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />Ran gyuru ngambi ran. Inde iri rimi mbi a yonga wawu wɨri bibi ti ri nzan nyi, ari he nji ri&lt;&lt;Mkpɨran&lt;&lt;Ritu riwa Izhi ri kɨma-u ti nji ri wiwɨri. <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />Wiwɨri ri mgbumgblume nyi he mkpɨran kusi Izhi. Bibi riwa wa ngan ri:&lt;&lt;Wari wa yonga wawa wa wiri, ama Izhi ri tindu ri wiwɨri sron mba, ran ko wa,&lt;&lt; <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />Nga tre wanyi ngawen wa he rimi ngan ri mbe Izhi:&lt;&lt;Bachi to ri irimɨren wa wiwɨri he kukulu.&lt;&lt; <verse eid="1CO 3:20" /><verse number="21" style="v" sid="1CO 3:21" />Ritu ngamba no njo no ran kpo ngawan ritu nji ran ritu ko ngye he wambi. <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />Ko Bulus, ko Apolo, ko Kefas ka mgbumgblume, ko vɨri, ko kuu ko zizan ko kusi, ikya wa wanyi wa wambi wawu, <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />biyi bi he wa Kristo nga Kristo he wa Izhi.<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s">Wandu Kristo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />Ri ngamba biyi nji ban ta ri ki he wandu Kristo nye, Izhi ti ta ndu no ta ki la tsro riwa a ran la njo zari rina. <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />Ikya riwa wa wa ri bibi nji wanyi a he riwa no wa tindu mba ri sron riri. <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />Me ran ti sisiri riwa bi tsra wen ran, ko no wa tsra wen kusi wa bla tre, ritu ame kyuwon me ran tsra ngawon ran. <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />Me milan nduwon ti ama rimba ran he kya riwa meti tsra kusi Izhi ran a he Izhi nye riwa ari tsra wen. <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />Ri ngamba, ran bla ri njo ko no vi bla no ye ran, son gben chachu riwa Bachi ri ye, ari ngaran kya riwa a he ri bu ye raa, ari ngaran kya riwa a he ri sron ko ngan ye raa Bubu wan nye Izhi ri la ko ngan bibi bi ndu riwa a ti.<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />Zizan, miri vayi, me ti kyawa wanyi ri ngawon ri Apolo ritu mbi no yi to ri ta ikya riwa wa tre ri,&lt;&lt;Ran tre kya riwa a han kya riwa wa ngan ri mbe Izhi ran.&gt;&gt;Rimba, bi ran kpo ngambi ritu nji ri tsro ri, bi ri tsri nji ri tsro ri ran. <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />Ingan la-u ri wu han mgbron nji? Ingye nye riwa wu he riwu riwa Izhi ran no-u ran? Inde wu nyɨme ri Izhi nye no-u ko ngye riwa wu he riwu, ko wu kpo ngawen ngye ka wana no-u nye ran?<verse eid="1CO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8" />Bi riga ka fe ko ngye riwa bi wa! Bi he ri wo-e bi he wa chu! Kita wandu Izhi ki ran zhu ri kpanchi mba rina wari ran tre ri wu he chu kiri he wa chu ri wu ngawen! <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />Rimi to won, Izhi no ta ki he wa kremkpen, a zhu ka ki he ka wa yibi wawa wa ngiji wa hi mpwan ri bubu wuu wa kusi ko ngan. Ikpanji ri wa yata, nji wa meme nga wa ndu Izhi ri shu wa ya kya riwa ari fe ta. <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />Bi yonga ki he wa mkpran riwa ki kii ri Kristo! Ama bi ya mba ka bi wiri bran ritu riwa bi he wa Kristo! bi ya ka kiran he ri gbengbren ran! <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />Ko zizan, ki ran he ri kya riwa a milan wo riwa ki ri kiri so ran nga wa tsro mbu wa ku-lagba, nji wa zizan ri no ta yaa, ki ran he ri koo ri tumbu ran. <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" />Ki sondu ri tindu ri wo mbu iwa lanyu rita ki ka ti lɨbu sro wa, iwa no ta yaa kika vu sron, <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />Inde nji wa tre meme ri tumbu kika tre tre ndindi ritu mba hari zizan nji wati rita ka ki ran he kyari ran, wati ritu ka ki he itsu riwa wa vu rega.<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />Me ran ngan mbe nyi ritu riwa me no yi shan ran, ama ritu riwa me fen yi ton ritu bi he ka imiri won wawa me kpa nyɨme riwa. <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />Ko inde bi ri he ri wau Izhi kigbu bi ran he ri wati bran ran, me he ka A ti nye ri yi ritu ame nye riwa me gbuchi ngɨzhi tre raro riwa Yeso Kristo ye ri yi. <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" />Ritu ngamba me ibreyi no yi hu dza won. <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />Ritu nganyi nye me ti Timoti ndu no ye ri yi ri korantus, me nyɨme riwu ka a he vren won wawu he nji ri hu Izhi. Ari taka ri yi bibi zren won rimi Yeso Kristo riwa a nyɨme ri kya riwa me tsro nji wa hu Izhi ri ko minyi riwa me hi.<verse eid="1CO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18" />Wari mbi wa gra kpo ngamba ka me ran bru ye ri yi ri Korantus nga ran. <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />Ama me chichi ye ri yi ri Korantus imba nye me to kyuwon nji wawa wa kpo ngamba me ri to kya riwa wa tre ama gbengbren ngye nye riwa wa ri wa. <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />Kpanchi son Izhi ran he tre ri nyu nye ran ama a he ri gbengbren. <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />Zizan, ri nkon ritan nye bi wa me ti ri yi inde me ye? Bi wa no wen me ye ri yii ri gbagba ka bi wa no wen me tre ri yi ri wu ri nyɨme nga rere?<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s">Inoya ritu Krumba Nji</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />Inji wari wa lawen ri, nji wari rimi mbi wa he ri meme ti ri kru ri mba nji, ikya riwa wa ti-a, ko nji wawa wana ri hu Izhi ran wana ti-u ran, nji ri rimi mbi ari kru ri waa ti wan. <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />Bi tanji ri kpongambi ri wu, Ingye ti ko bi ran yi ritu meme ti nji ran? Ingye ti ko bi ran chu zho rimi mbi ran? <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />Ko riwa me ran he ri yi ran, ama me he ri yi rimi Yuu, nga me gbuchi kadzi bibi yaa riwa me no nji riwa a ti meme ti, ame me tre ka nji riwa a he ri yi ri mba. <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />Inde bi kabru rimi nde Bachi mbu Yeso me he ri yi rimi Yuu won, nga gbengbren Bachi mbu Yeso a he ri yi. <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />Me wa no yi ka nji mba no meme nji ritu no wa kpandu meme ti wan ri kpaa time ri wa iyu wan ri fe kpa chuwo rimi vi riwa Bachi ri ye.<verse eid="1CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />Ran kpongambi ran, ritu meme nji he rimi mbi ri nji ri meme ti riri rimi mbi ri no mgbron nji no wa ti meme ti ran? <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />zhu meme ti mbi zho ritu bi ri he wa Tsitsri bibi riwa bi he Tsitsri riwa Izhi. Ritu Kristo ka ngawan de ri tu mbu bibi ntɨma ri ro ri dza gran. <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />Ritu nganyi, de ki ran roro mbu ri dza gran a ran ri mumu ri kpa kpi fu ran, ki ka ti meme ti ki chuwo ki ri ti kyawa riwa a he Tsitsri, ki sondu ran ti kya ri kpunji kiri ran la kpunji tre.<verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />Me ngan no yi ri, no yi ran kabru tu ri wa wa mba ran. <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />Men ran tre ritu wawa wana hu Izhi ran, wana ti meme ti ri wa mba ran, ka wawa wa sutu mba, ko wawa wa hu zhi riwa wana to-u ran, inde ki wa ki ri ka meme ti wanyi chuwo tse de bi ka ka mgbumgblume nyi don. <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />Ingye ikya riwa me tre-a een, ran wu vi ri nji riwa a tre ri wawu he kpan hu Izhi wen ama a kawan ri wa mba, ran ri hu Izhi ran, nga ran ri tre tre meme ritu nji, ko nji riwa ari hua hi ran ri sen nji. Ran ri kyari ri bibi nji nyi ran.<verse eid="1CO 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12" />Aran he ndu won riwa me bla tre ri wawa wa ran hu Izhi ran, ama biyi bla tre ri wawa wa rimi tre Izhi mbi wawa wa ti meme ti. <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />Izhi kyuwan nye ri bla tre ri wawa wa ran ri huu ran, ritu ngamba,&lt;&lt;Ran no nji wa meme ti no wa kabru tu riwu ran.&gt;&gt;<verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s">Biyi wa hu Izhi ran ngɨzhi tre mbi hi ri wawa wana to Izhi ran</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />Ran ngɨzhi tre riwa a he ri tsutsu mbi wa hu Izhi hi ri wawa wa ran hu Izhi ran no wa bla ri yi ran, tsede bi ka milan ti ri ngambi. <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />Bi ran to ri biyi wa hu Izhi nye bi bla tra ri wawa wana hu Izhi ran, tunde biyi nye bi bla tre ri wawa wana hu Izhi ran, ko ngye ti ko bi ran milan vi tre riwa a he ri tsutsu mbi ti ran? <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />Bi ran to ri kita nye ki bla tre ri miri ndu Izhi ran? Nghamba a ran he riwa bi milan tre riwa a he rimi mbi ti ran? <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />Inde tre he ri tsutsu mbi, ingye ti ko bi ngɨzhi ri hi ri tra wa bla tre riwa wana to Izhi ran. <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />Me ngan rinyi ritu me wa meri noyi shan ritu riwa bi ngɨzhi tre mbi hi no wawa wana to Izhi ran no wa bla riyi bi ti ka njo ran he ri wiwɨri rimi mbi riwa ari bla tre riyi ran. <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />Ama vayi ri ngɨzhi tre vayi wan hi ri wawa wana to Izhi ran.<verse eid="1CO 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7" />Bi janyu ri ngambi kusi wa bla tre, rimba tsro ri bi ran he ka wa hu Izhi ran ari bi riwa no wa ti meme ti ri yi, ko ka inde njo ri hu Zhu yibi kya ri yi, ran ngɨzhi hi ri wa bla tre ran. <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />Ama wari mbi wa ti meme ti wari yibi kpi mgbromba, nga wanji wawa bi ti meme ti riwa wa wa mgbɨrombi wa hu Izhi,<verse eid="1CO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 6:9" />Bi kpa-wurusu iri wa meme ti wana fe gra ri kpanchi son riwa Izhi ran? no njo ran gyuru yi ran, nji wawa wati meme ti ri kru ri waa nga wawa wa hu zhi riwa wana to-u ran, ri wawa wa kru ri mba nji, nga ronron wawa wa kru ri ngamba ronron, <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />wanji wawa wa yibi kyawa, wanji wawa wa wa kyawa han kya riwa wa wa ka wanji wawa wa zizan so kya wa huwa ri wanji wawa wa kra ngamba tu nga wawa wa sen wari. nji wanyi wa ran fe gra ri kpanchi son Izhi ran. <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />Rinyi nye he kya riwa wari mbi wa he, ama zizan Izhi Tsiri yi, wa kɨma yi he Tsitsri nga Izhi milan yi ti kusi ngawan, Izhi ti rimba dzu ri Yeso Kristo, nga ri Yuu riwa Izhi mbu.<verse eid="1CO 6:11" /></para>
  <para style="s">Tindu ri kpa mbi ritu Mkpen Izhi</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />Injo ri tre ri, &lt;&lt; Izhi no wen nkon me ti kongye.&gt;&gt; Een, ama a ran he kongye nye bi ri yi ran. Me to ri Izhi no wen me ti kon ngye ama me ran no kyari no kɨme wen ti gran wan ran. <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />Inji ri nkan ri tre ri, &lt;&lt;Ila he ritu nne nye wa ti-u, nga nne he ritu la.&gt;&gt;Een, ama Izhi ri ngɨzhi kremba ye haha mba ikpa ran he ritu kru ri wa riwa a ran he wame ran, ama ritu no ta ki hu Bachi ri wu, Bachi ri wa no ta ki ti kya riwa a bi ri kpa mbu. <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />Izhi ta Bachi shɨme rimi kuu, ari tata shɨme rimi kuu ngawen rimi gbengbren wan. <verse eid="1CO 6:14" /><verse number="15" style="v" sid="1CO 6:15" />Bi to ri ikpambi a he nɨma kpa wa Kristo? Me ban nɨma Kristo kɨma ti kpa ri ti ntran, On-hon! <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />Ka bi ran to ri nji riwa a ka ngawan ngan ri ntran a he riri imba-u nye ran? Imbe Izhi tre ri,&lt;&lt;Ngamba wa he kpa riri.&gt;&gt; <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />Ama wawu riwa a ka ngawan kabru ri Bachi ari he riri riwu rimi Yuu wan.<verse eid="1CO 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18" />Ka wa mba chuwo ko meme ti ri bibitan riwa nji ti a ran vu kpa wan ran, ama Inji kru ri wa riwa a ran he wa me ran, a ti meme ti ri kpa wan. <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" />Bi ran to ri ikpa mbi he bubu son riwa Yuu Tsitsri; riwa ari son rimi wan riwa Izhi no yi ran? Bi ran he ri tumbi ran ama bi he wa Izhi, <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />Izhi reyi ri Yii vren wan Yeso tindu ri kpa mbi ritu no Izhi mkpen wan.<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s">Imiyen ritu Gran</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />Zizan ritu miyen riwa bi ngan rimo ritu tre gran, a ran bi riwa no nji no gran ran. <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />Ama ritu izren vaa bran, a bi no ko ronron ngan no he ri wa wan, nga ko waa ritan no he ri ron wan. <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />No roron no ran kawan ri kabru kpa ri waa wan ran nga no waa ngawen no ran ka ngawan ŋyon ron wan ran , kon ngan rimi-mba no no vayi wan riwa ari wa no milan-u. <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />Ikpa wa ran he wa ma nkshewan ran, a he wa ron wan ngawen, nga kpa ronron ran he wa ranron nkashewan ran a he wa waa wan ngawen. <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />Ran ka ngambi nyon ngambi ran tsede bi kpa nyɨme ngambi ritu bi ri bre Izhi ko bi ri bru kabru bi ri wa ngambi. No meme nji no ran gyuru yi ritu hon vu sron ran. <verse eid="1CO 7:5" /><verse number="6" style="v" sid="1CO 7:6" />Me la rinyi ritu me ran noyi doka ran ama ritu me ŋoron yi nye. <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />Ran bi biyi ronron bi ri he bibi riwa me he, ama ko ngan he ri bibi riwa Izhi no, a no ko ngan ri bibi wa ma.<verse eid="1CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8" />Zizan, biyi wa mba wawa bi ran gran ran nga mba wa kɨbo, me tre ri ari bi riwa bi sondu ran ki bibi riwa me son. <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />Ama inde wu ran vu sron ran, wu ka gran. A bi no gran riwa mbye ri gon wu sron.<verse eid="1CO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10" />Zizan ri wawa wa gran me he ri doka riwa Bachi: No wa no ran ka ron wan don ran. <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />Ama inde a ka ron wan don, no son ko ka bru gran ron wan, nga no ronron no ran dzu waa wan ran.<verse eid="1CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12" />Ri wari ame me tre kyuwon, a ran he Bachi ran: Inde nji ri hu Izhi a gran waa ri wa a ran kpa Izhi ran nga a nyɨme riwa wa ki mba-u ka ran dzu ran. <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />Nga inde iwa ri hu Izhi a gran ronron riwa a ran to Izhi ran a kpa nyɨme riwa wa ki mba-u, ka ran dzu ran <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />Nji ri wa a ran kpa Izhi ran wa kpa ka ti Tsitsri ritu waa wan riwa ari kpa Izhi, nga wa ri wa a ran kpa Izhi ran, Izhi ri kpa ti Tsitri ritu ron wan inde rinyi ran he nganyi ran, imirin mba wa he ka imirin nji wawa wana he wa hu Izhi ran, ama bibi riwa a he Izhi ri kpa wa.<verse eid="1CO 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 7:15" />Ri ngamba inde nji riwa a ran he nji ri hu Izhi ran riwa ran ka nji ri hu Izhi don, no he ngamba. Ri bibi mba, nji ri hu Izhi, ko a he waa ka ronron, ari to ti; Izhi yo yi no yi ki ri sikpa <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />Wu tise wuri to waa ri hu Izhi, riwa wuran to kpa ron wen chuwo ran? ka a wu nji ri hu Izhi wuto wu ran to kpa waa wen chuwo ran?<verse eid="1CO 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />Ko no ngan no son bibi riwa Bachi ka-u dzi bibi riwa bi he riwa Izhi a yo yi. Bibi wan nye me tsro nji wa hu Izhi wawu. <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />A wu riwa wu kpa Izhi-e, ran ka nkon Izhi chuwo ran, inde nji riwa a kpa wa ran bru tre tre Izhi ri wu ngaran Inji riwa a ran kpa Izhi ran no ran ban ngawan ri wawu kpa Izhi. <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />Ri fon nzhu, ri hon fon nzhu ran he kyari ran, Ikya riwa ari wa nye he ri ki hu doka wan. <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />No ko ngan mbi no he bibi riwa a he ri vi riwa Izhi a yo-u. <verse eid="1CO 7:20" /><verse number="21" style="v" sid="1CO 7:21" />Bi ran he gran riwa Izhi a yo yi? No sron mbi no ran time ran inde a he njanji bi ka ran kpa sron mbi time ran ama inde nji ri ko mbi kayi chuwo inoyi hi ngambi, bi ka hi. <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />Inji riwa Bachi a yo-u ti gran ri nkon Izhi a ran he gran ngaran a he riwa Izhi. Ri ngamba, nji riwa Kristo yo-u a he gran Yeso. <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />Izhi reyi ri yii Yeso; biyi ran he gran riwa nji ran. <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />Imiri vayi won wa hu Izhi ko ngan mbi no kabru tu ri Izhi bibi riwa bi ran he riwa Izhi a yo yi.<verse eid="1CO 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />Zizan bibi riwa bi ngan no wen ritu wawa wa ran gran ran: Me ran he ri doka riwa a zhu ri Izhi ran, ama me de tre won ka iri riwa ari lo sron Bachi. <verse eid="1CO 7:25" /><verse number="26" style="v" sid="1CO 7:26" />Ritu bibi yaa riwa a he zizan, a bi riwa bi ki bibi riwa bi he. <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />Inde wu he ri waa wuka ran wuu gran wan ran, inde wuran he ri waa ran, ran gran ran. <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />Ama inde wu gran, a ran he meme ti ran, nga inde ivra gran, a ran ti meme ti ran. Ama me kpayi chuwo ri bibi yaa riwa a he ri ko gran. <verse eid="1CO 7:28" /><verse number="29" style="v" sid="1CO 7:29" />Imiri vayi won wa hu Izhi, ingye kya riwa me tre-en, ivi ran don ngaran, zizan hi kusi, wawa wa ran he ri mba ran no wa ki ka wa ran gran ran. <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />Ko ri kinklan sron, ko ri shnji sron, no wawa wa reno he ka wa ran rekya ran. <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />Ran kpo ngambi ritu kyawa wa mgbumgburume nyi ran, kyawa wawa wa he rimi wan gon ri kre.<verse eid="1CO 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32" />Me wa no yi ran kpa sron mbi time ran nji riwa a ran gran ran ri yo sron wan rimi ndu Bachi ritu ari wa ran sii Bachi sron. <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />Ama nji riwa a gran ari yo sron ritu kyawa wa mgbumgburu me, ritu ari wa ran no waa wan sii sron, <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />isron wan ga ti hari, ri ngamba riwa a ran gran nga ran ko ka a ran gran zari rina ari de sron wan ri Bachi rimi kpa nga rimi Yuu, ama iwa riwa a gran ari ri yo sron ritu kyawa wa mgbumgburume nga bibi riwa ari sii ron wan sron. <verse eid="1CO 7:34" /><verse number="35" style="v" sid="1CO 7:35" />Me tre tre nyi ritu me wa me dzon yi nye, me ran ri wa meri yo yi ri gbengbren ran tsede me wa no yi ti kya riwa a tsra ran bi, nga no yi ka ngambi de ri ndu Bachi, bi ri ran don kyari dzi ran.<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />Ama inde nji to a bi riwa ari gran kpan wan vruwa ritu riwa yaa riwa ari vu nga vi riwa a vu ri yiwa, a tsra a ran he meme ti ran, no wa gran ngamba. <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />Inde a ka dzi ri sron wan iwawu ran gran ran nga ari vu sron, ika gran wan bi. <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />Inji riwa a gran a ti tsra ama nji riwa a ran gran ran, a ti tsra han. <verse eid="1CO 7:38" /><verse number="39" style="v" sid="1CO 7:39" />Iwaa riwa a gran a ran ri sontu wan ran tse ron wan kuu ko ari hi ran gran njo riwa a he nji ri hu Izhi. <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />Ama rimi wamon ari bi no ran gran ngaran, me ya me no yi tre rimi Yuu Izhi nye riwa me tre nganyi.<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s">Iri Riwa wa ti ri zhi Riwa wa ran To-u ran</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />Zizan, de ki tre ritu ri riwa wati-u ri zhi riwa wana to-u ran, bi yonga ko ngan no nyime ri to mbi. Ito ri ya no ta ki kpo ngambu, a he nyɨme nyi riwa a no ta wa hu Izhi gbengbren. <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />Inji riwa a ri ya ka wawu to kyari, hari zizan a ran to kya riwa a he riwa ari to rina. <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />Ama nji riwa a nyɨme Izhi, Izhi to-u.<verse eid="1CO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4" />Ritu ri ri riwa wa ti ri zhi riwa wana to-u ran, ki to ri izhi riwa wana to-u ran he kya riwa a ran ri viri ran, ki to ri Izhi he riri. <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />Ko riwa wari wa wawa wa yo wa ri,&lt;&lt;wa zhi &gt;&gt;Ko ri shu ko ri meme, nga ko riwa wari wa riwa wa yo wa ri&lt;&lt;wa Bachi &gt;&gt;Nga&lt;&lt;Wa Bachi,&gt;&gt; <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />a zizan, Izhi riri riwa ki he riwu, A ti, riwa wawu nye he kyawa iwawu nga ritu wan nye ki he, nga Bachi riri nye riwa a he, Yeso Kristo, riwa ritu wan wa ti kyawa nga ritu wan nye ki he.<verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />Ama a ran he ko ngan nye to kpunji nyi ran nji wari wa ka ngamba no zhi riwa wa ran to-u ye rimi vi nyi, inde wa ri bibi ri nyi, waka bru taka iri wawa wa ri ri riwa a he riwa zhi riwa wa ran to-u ran, isron mba ran no wa ran, a kpa wa zuu sron. <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />Ama ila ran ri ngɨzhi ta hi kusan Izhi ran, ki ran hon he ri kyari ran inde ki kambu ri ri-u, ko ka inde ki ri a ran sro kyari ngan rita ran.<verse eid="1CO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9" />Ama ti rereri son tu mbi ritu no miri vayi mbi wa hu Izhi wawa wana senkpa rimi kpanyɨme mba ran no wa joku ran. <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />Ritu inde wawa wato ri wuhe ri to wu riri ri tra zhi riwa wa ran to-u ran ashe rimba ran no wa gbengbren no wa ri ri riwa wa ti ri zhi riwa wa ran to-u ran? <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />Ri ngamba, ito wen riwa wu to ari no vayi wen riwa Kristo kuu ritu wan no joku kuu. <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />Inde wu ti meme ti ri wa hu Izhi ritu wu dzon wa no wa ti kya riwa a ran bi ran, wu ti meme ti ri Kristo nye mba. <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />Inde iri ri nye ri no vayi won ri hu Izhi no joku, me ran tan nɨma riwa ari no joku ran.<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s">Lada nga Ndu nji ri Ndu Izhi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />Ame me ran sontu won ran? Me ran he nji rindu Izhi nga me to Yeso Bachi mbu? Biyi bi he sii won rimi ndu won riwa Bachi. <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />Ko wari wa tre ri ame me ran he nji rindu Izhi ran, biyi bi to! Ritu son mbi ri kabru tu ri Izhi, biyi kyumbi bi to bi ri nyɨme ri me he nji ri ndu Izhi.<verse eid="1CO 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3" />Inde nji wa shɨma wen ri nganyi nye me kpa ngawon chuwo. <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />Ashe, ki ran he ri gbengbren riwa wa no ta ri ri so ritu ndu wan ran? <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />Kiran he riwa ki ngɨzhi wa hu Izhi ye ri ta bibi riwa mgbron wa ndu Izhi nga miri vayi Bachi wa ti nga bibi riwa Kefas a ti ran? <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />Ko ka ara Banaba nga ame ri kankshe nye riwa ki tindu ki ri ri ri ngambu?<verse eid="1CO 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 9:7" />Ingan ri tindu wa lokpa ran ri ri ngawan? Ingan ri sen konkron ri rɨma wan ran ran kyen klo wan ri ran? Ingan ri ho gɨzhi lando ran ran so ima sisan mba ran? <verse eid="1CO 9:7" /><verse number="8" style="v" sid="1CO 9:8" />Bi ya risi mbi me la tre nyi ri tre ri nne kuklu? Itsro Musa ran la nganyi ran? <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" />Ritu riwa wa ngan ri mbe doka Musa ri,&lt;&lt;Ran ka nyu lando ri bubu riwa ari jo wɨlo kpu ran.&lt;&lt;Ara lando nye Izhi ri tre ritu mba? <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />Aran he ki ta nye ari tre rita ran? Een, a he rita nye a ngan. Ai, a bi riwa nji ri ron ri nji ri joo no wa yo sron rimi fe san wamba rimi kpi wa zhu. <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" />Inde ki yo tre riwa Yuu rimi sron mbi, to, a he kya ri kinklan sron no ta ki fe rimi kya riwa biyi bi fe ki yo nyu. <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />Inde wari wa fe zon nyi ri yi, ashe a ran he riwa kita ki fe ri yi han ran?</para>
  <para style="p" vid="1CO 9:12">Ama ki ran tindu ri gbengbren nyi ran, ama ki vu sron ri ko ngye ritu riwa no ran kukri ri ndu tre tre Yeso Kristo ran. <verse eid="1CO 9:12" /><verse number="13" style="v" sid="1CO 9:13" />Ashe bi ran to ri wawa wa ti ndu ri tra Izhi wa fe ri mba riwa wa ri ran? wawa wa kri ri bubu kri ri bla tre Izhi, ri bubu wan nye wa fe wamba ran. <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" />Ri ngamba Bachi tre ti wawa wa bla tre Izhi no wa fe ri mba ri bubu wan.<verse eid="1CO 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15" />Ama me ran miyen kya riwa me ri fe riyi ran, ko ka me ngan rinyi zizan ritu me ri kpa kyawa ka ti wamo ran. Me gbuchi kuu ri njo ran kɨma kpo ngawon yo rimi kya ri kuklu ran. <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />Inde me tre tre Izhi, rimba ran no wen me kpo ngawon ran. A he dole me bla tre Izhi inde me kawon me to yaa! <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />Inde me ti ndu nyi ri su sron won me fe lada, ama inde a ran he ri nyɨme sron won ran, wa ka ngan wen riwo nye mba. <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />Ingye nye ri he fe won: Rimi tre tre Izhi won me tre kuklu, me ran wa no wa no wen kya rimi ndu bla tre Izhi ran.<verse eid="1CO 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />Ko riwa me ran he gran ko njo ran, ama me kɨma ngawon ti gran ko ngan ritu riwa me ngɨzhi nji kigbu ye. <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />Me kɨma he ka nji Yahuda ritu riwa me ri vu tu mba wawa wa ri ndoza doka Musa, me he ka wawa wa he rimi doka Musa ama me ran he rimi doka ran, me tre ngamba ritu me ri ngɨzhi wa ye ri Kristo. <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />Ri ngamba, riwa me ti ndu ri wawa wana to Izhi ran, me he ka wawa, ku gran doka wawa wana to Izhi ran ritu meri ngɨzhi wa ye ri Izhi, rinyi ran he ri me ka won ri huu doka Izhi ran, ama me he ri ndoza doka riwa Kristo. <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />Ri tsutsu wawa ikpa nyɨme mba ran senkpa ran, me he ka wawa ritu riwa me ri ngɨzhi wa ye nkon Izhi imba me he kyawa wawu ri nji bibi riwa me to kpa wari mba chuwo. <verse eid="1CO 9:22" /><verse number="23" style="v" sid="1CO 9:23" />Kyawa wanyi wawu me ti wa ritu tre Izhi, riwa me fe ndindi ti.<verse eid="1CO 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 9:24" />Kpunji, bi to ri nji kigbu wa rinɨran tsutsu ama nji riwa a gbuchi wawu nye ri rii? Nghamba a wu tsutsu bibi riwa wu rii. <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />Wawa wa wa wari roro ri rinɨran wa yo tu mba ri ti-u bla vi ritu wari fe kya ri mgbumgburume, ama ki ta ki wa kya riwa Izhi nye ri de riwa a ran ri time ran. <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />To ame me ran ri rinɨran won ndandan ran ama me rinɨran riwa me fe kya rimi wan. <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />Me wuu kpa won ritu me ri kpa wari chuwo ritu no ran ye chachu wan waka kawen taga ran.<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s">Bulus a fe nton wa hu Izhi ritu zhi riwa Wa ran To-u ran</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />Me wa ri no yi taka biyi wa kpan won wa hu Izhi, ikya riwa a fe wati mbu wawa wa hu Musa ikpa wuru a kawa waka ruu gran nchon nne ri sren pyan. <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />Rimi kpa wuru ri nchon nne ri sren-a waka son wa tu ri ima riwa wa hu Musa. <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />Wa ka ri ri riwa Yuu iwawu mba <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />nga wari so ima riwa a zhu rimi tita-a riwa a hu wa hi, tita-a a he Kristo nye. <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />Ama Izhi a ran ti kinklan sron ri wari mba ran, wa ka wuu wa rega ri ji.<verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />Zizan kyawa wanyi wa he fen ton rita riwa ki ran ti meme ti bibi riwa wawa wati-a ran. <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />Ran he wa hu zhi riwa wana too ran bibi riwa warimba wa he ran bibi riwa a he rimi ngan,&lt;&lt;Inji wa ki ri mme ritu ri wari so nga wari wulunde nglu.&gt;&gt; <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />Ki ran yo tu mbu rimi wa mba bibi riwa wa rimba wati, riwa nji ngo see hari don tra waka kuu ri chu riri ran. <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />Ki ran tsra Bachi bibi riwa wari mba wati iwan ka wuu wa ran. <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />Ki ran tre mkpuzhu bibi riwa wamba wa ti nga wari kpa kuu riwo wuu nji.<verse eid="1CO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11" />Kyawa wanyi wa he nganyi ritu no mgbron mba no wa to, wa ngan dzi ritu no he fen ton ri ta, ki he huɨreri tre kre vi. <verse eid="1CO 10:11" /><verse number="12" style="v" sid="1CO 10:12" />A wu riwa wu yaa ka wu kri mgbemgben, ti rereritu no ran joku ran! <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />Itsra ri ran he riwa a fe yi zari, riwa wana ti-u ri nji zari ran. Izhi he riwa ari ti tsra, a ran chuwo no wa tsra yi ri tsra riwa a han gbengbren mbi ran, ama ritu tsra nyi nye bi fe nkon riwa ari no yi vu sron.<verse eid="1CO 10:13" /></para>
  <para style="s">Iri riwa zhi Riwa wa ran To-u ran Ngha ri Bachi ri yawulu</para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />Ritu ngamba, bi yi wa kpan won, kaa hu zhi riwa bi ran to-u ran chuwo. <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />Me tre ri yi ritu riwa bi he wa wiwɨri mɨlan ya kyumbi ikya riwa me tre. <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" />Vaŋon nyi ri wa ki ngɨri ri Izhi ritu wan ashe, a ran he kabru nye ri yii Kristo ran? Juju yɨmo nyi riwa ki sii ri chu wa, ashe a ran he kabru nye ri kpa Kristo ran? <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />Ritu mkpon juju yɨmo nyi he riri nye, ashe, kita wawa ki kigbu ikpa riri nye ki he ama kita wawu mbu mkpon juju yɨmo riri nye ki ri.<verse eid="1CO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18" />Kɨma ya wanji Israila: Wana he wawa wa ri ri rimi sroyii wa ran he riri ri ngamba rimi ri ri sroyii riwa wati-u ri Izhi ri bubu bre ran. <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />Ingye nye me tre ri nyi ikya riwa wa han ri zhi riwa wa ran to-u ran nye he kya ri kpunji wan? ka izhi riwa wa ran to-u ran nye he kya ri? <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />On-hon, me tre ri, ikya riwa wawa wa hu zhi riwa wana to-u ran wa han no bɨzhi, a ran he Izhi ran, me ran wa noyi kabru tu ri wa bɨzhi ran. <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />Bi ran so ima ri vagho riwa Bachi bi ri so ima ri vagho riwa bɨzhi ran; bi ran riri ritu kpanchi Bachi bi ri bru riri ritu kpanchi wa bɨzhi ran. <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />Ki ran wa ki ri no Izhi fu ran, kiri no ti huu ran, ki ran tre mba ri ki senkpa han Izhi ran.<verse eid="1CO 10:22" /></para>
  <para style="s">Isontu wa hu Izhi</para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />&lt;&lt;Wa no ta ki ti kon gye riwa ki ti&gt;&gt;Ama a ran he ko ngye wawu bi ran.&lt;&lt; Wa no ta ki ti ko ngye&gt;&gt;Ama a ran he ko ngye ri dzon ran. <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />No njo no ran wa bi ngawan ran tsede no wa bi mgbron nji.<verse eid="1CO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25" />Tan nɨma riwa wu to wa reri wu ri richu ran miye ran ritu rimɨren sron, <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />Ritu, bibi riwa imbe Izhi ri tre ri,&lt;&lt;Meme ri ko ngye riwa a he rimi wan he wa Bachi.&gt;&gt;<verse eid="1CO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27" />Inde nji riwa a ran kpa Izhi ran yo-u iri no ye ri ri ri koo wan, wu nyɨme wuri hi ri kya riwa a kadzi kusi wen, ran miyen kyari ri rimɨren sron wen ran. <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />Ama inde injo tre riyi ri,&lt;&lt; Iri nyi he riwa wati-u ri zhi riwa wana to-u ran,&gt;&gt; Ran ri la mba ran, ritu nji riwa a la-u nga rimɨren sron wen, <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />Me tre ritu rimɨren sron wan, a ran wambi ran.To, iri mbi ri tre ri, Ritu ngye nye ko irimɨren sron nji ri ri dzuu no ran ti kya riwa isron wan ri waa ran? <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />Inde me ngɨri ritu ri won no njo no ran wa wen nyu ritu ri riwa me ngɨri ritu wan ran. <verse eid="1CO 10:30" /><verse number="31" style="v" sid="1CO 10:31" />Ko ngye bi ti, ri kya riwa bi ri, nga bi ri so ti ko ngye ritu mkpen Izhi. <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />Son bibi son riwa a ran ngɨzhi kɨbu dza ye ri tsutsu nji Yahuda nga wawa wana he nji Yahuda ran ko ri tsutsu wa hu Izhi. <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />Bibi riwa me wa meri sii nji sron iwawa rimi ko ngye riwa me ti, me ran ri wa ritu ngawon ran ama ritu kpa nji riwa wa fe kpa chuwo.<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="nb">
    <verse number="1" style="v" sid="1CO 11:1" />Biyi hu dza won bibi riwa me hu dza Kristo.<verse eid="1CO 11:1" /></para>
  <para style="s">No Mba no wa Ka Tu mba</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />Me gbre yi ritu riwa bi taka kya riwa me tsro yi, bi ri ri ngɨzhi tsro riwa me tsro yi.<verse eid="1CO 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 11:3" />Ama me wa ri no yi to ri rinkon ko ngan he Kristo, rinkon waa he ron wan, nga Izhi he rinko ritu Kristo. <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />Inde nji ri tre tre Izhi ri tsro ritu, ka njo ka tsro ritu ran ri gbre Izhi wan, a no Kristo shan nye mba. <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />Ama Iwa riwa ari bre Izhi ri tu kuklu a no ron wan shan, a ran he nkan ri waa riwa a vu mgbolo ran. <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />inde iwa ran ka ngwan ri tsro ritu ran, ka kron tu wan; ama inde ari he shan riwu riwa ari kron tu, no ka tu wan ri tsro. <verse eid="1CO 11:6" /><verse number="7" style="v" sid="1CO 11:7" />No ronron no ran katu wan ri tsro ran, inde a he ka Izhi ri mkpen wan; ama iwa nye he mkpen ronron. <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />Wana ti ronron zhu ri kpa wa ran, ama wa ti wa zhu ri kpa ronron; <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />Ngwen Izhi ran ti nji ri gbuchi no zon waa ran, ama a ti waa iri no zon ronron <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />Ritu ngamba nye a bi no wa no he ri tsro ritu wan ritu wa ndu zhi,<verse eid="1CO 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 11:11" />Ndu ringamba rimi Bachi iwa ran son ritu wan ri ronron ran, ko ka ronron ri son ritu wan ri waa. <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />A he bibi riwa wa ngɨzhi waa zhu ri kpa ronron, bibi wan nye me, wa ngɨzhi ronron zhu ri kpa waa nga ko wa ringye wa zhu ri Izhi. <verse eid="1CO 11:12" /><verse number="13" style="v" sid="1CO 11:13" />Biyi kyumbi no yi mɨlan ya, a bi no waa no bre Izhi ri tu hwoo? <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />Ri ngamba, inde ronron ka mfu tu wan chuwo ran ran kron ran, a he kya ri shan, <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />ama ritu iwa ka mfu tu wan chuwo a he kya riwa ari kpa bi, wati mfutu wan dzen ritu no ka-u tu. <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />Ama inde njo riwa a ran jannyu ritu tre katu ri ko izren ri tu kuklu, kita wa hu Izhi ki ran to bibi ti ri ti nkan ran.<verse eid="1CO 11:16" /></para>
  <para style="s">Iri Bachi ri Yawuru</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />Ritu doka nyi, me ran gbre yi bran ran ritu ikabru tu mbi ran he ritu ndindi ti ran, ama ritu meme ti. <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />Ri gbuchi, me wo ri rimi kabru mbi inyu mbi ran he riri ringambi ran ame me kpa nyɨme ri kya riwa wo-a ri a he njanji. <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />A he riwa no janyu no he rimi mbi ritu no wa ka don to wa kpunji tinkan. <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />Inde bi kabru tu ri bubu riri, a ran he ritu riwa bi taka ritu riri ri yawulu riwa Bachi ran, <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />Rimi ri ri mbi, ko ngan ri yo tu wan ri bubu ri wama nga ri iyon ri ti nga ri so ran ri hwa. <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />Bi ran he ri ko riwa bi ri bi ri so ran? Ka bi tsri wa hu Izhi bi ri no wa shan nga wawa wa ran he ri kya ran? Bi wa no wen me tre ri se? Me tre ri bi ti tsra onhon, ame me ran gbre yi ran!<verse eid="1CO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23" />Ikya riwa me no yi nyi me kpa ri Izhi nye a ban juju yɨwon, <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />ran ngiri ri Izhi, ran chu wa ran tre,&lt;&lt;Rinyi he kpa won, riwa a he ritu mbi, ran ti nganyi ritu bi ri ran taka won.&gt;&gt; <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />Nghambame kugon jujuyɨmo, ka ban vanŋon-a ran tre ri,&lt;&lt;Vaghon nyi he katre dzi nye riwa Izhi rimi yii won, ran ti nganyi riwa bi so, bi ri ran taka won.&gt;&gt; <verse eid="1CO 11:25" /><verse number="26" style="v" sid="1CO 11:26" />Rinyi he ri inde bi ri bi ri ri so rimi vaghon nyi bi tre tre kuu Yeso nye mba hi chachu riwa ari ye.<verse eid="1CO 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 11:27" />Inde nji riwa a ri ko a so rimi vaghon nyi ri ti meme ti rimi sron wan, a tsri kpa Kristo ri yii wan yaa nye mba. <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />Ritu ngamba a bi no yi tsra ngambi to ko bi ri ri jujuyɨwo nyi nga bi ri so ri vaghon nyi. <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />Inji riwa a ri ra so rimi vaghon nyi riwa a ran mila sron wan ya ran a ban ya dzi ngawan ritu. <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />Ritu wan nye wari mbi wa ran sen kpa ran, wari wa lo nga wari wa kuu. <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />Inde ki tsra nganbu ri, wa ran no njo yaa ran. <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />Ama inde Bachi nye ri no ta yaa, ari ti ritu no ta ki ran he rimi wawa wa no wa yaa ri mgbumgblume nyi ran. <verse eid="1CO 11:32" /><verse number="33" style="v" sid="1CO 11:33" />Imiri vayi won wa hu Izhi, inde bi kabru riwa bi ri ri, bi ka gben ngambi. <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />Inde iyon ri ti njo rimi mbi, no ri kya hwishi ri ko ran ye ritu no Izhi no ran no yi yaa ritu tre mkpuzhu mbi riwa bi kabru tu ran.</para>
  <para style="p" vid="1CO 11:34">Ritu mgbron kyawa, me la yi bibi riwa bi ti inde me bru ye.<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s">Ide ri Yuu Tsitsri</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />Zizan, imiri vayi won wa hu Izhi, ritu tre riwa de Yuu ri Tsitsri, me ran wa no yi son ri bu ran. <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />Bi to ri vi riwa bi ran he wa hu Izhi rina, wa gyuru yi, bi ka gra hu zhi riwa a ran ri vri ran, <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />Me wa no yi to ri, ba njo riwa Iyu Izhi ri no tre ka tre ri,&lt;&lt;Yeso he nji riwa wa lanyu riwu,&gt;&gt;Nga njo ran to tre ri,&lt;&lt;Yeso he Bachi nye,&gt;&gt;Tsede nji riwa a he ri Yuu Tsitsri. <verse eid="1CO 12:3" /><verse number="4" style="v" sid="1CO 12:4" />Zizan, ide wa he kankan-kan ama Iyu riri nye ri de wa. <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />Nkon ndu Izhi wa he kankankan riwa wa ti ndu ama Bachi riri nye wa ti riwu. <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />Inde wa he kankankan, ama Izhi riri nye ri de gbengbren ri ti wa wawu.<verse eid="1CO 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 12:7" />Izhi ri no ko ngan ito son riwa Yuu Tsitsri, ritu no dzon ko ngan. <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />Iri wa no de ri tsro ri wiwiri dzu riwo Yuu Tsitsri, iri wa no de ri tsro ri to dzu riwo wa Yuu-a, <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />nga iri wa no de ri yo-sron dzu ri wo wawu Yuu-a me, nga ri fe ide wan ri den nji kpa chuwo dzu ri wo Yuu-a me, <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />Iri fe de ri ti kyawa wa de sisiri, iri ide ri la tre riwa ari ye kusi, nga ri fe ri to Yuu tinkan, iri kuma ide riwa tre rɨme kankankan nga ri fe de ri laa tre riwa rɨme wari. <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />Wanyi wawu Iyu riri nye ri ti wa, ran ri ga wa ri ko ngan riwa a nyɨme-u.<verse eid="1CO 12:11" /></para>
  <para style="s">Ikpa riri ri Gbɨre kigbu</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />Bibi riwa ikpa he riri, ran he ri gbɨre kigbu, riwa igibrekpaa wa kigbu, wa he kpaa riri nye ngamba nye he ri Kristo. <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />Ritu kita wawumbu wa son ta ri ima rimi Yuu riri hi ri kpaa riri, ko nji Yahuda nye, ko wawa wa ran he nji Yahuda ran, ko graan nye ko imiri wa no ta ki so rimi Yuu riri iwawu mbu.<verse eid="1CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14" />Ikpaa ran he gbɨre riri ran, ama a he ri wa gbɨre kigbu. <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />Wari tre ri ikpɨreri tre ri,&lt;&lt;Ritu ame me ran he woo ran, ritu ngamba me ran he rimi gbrekpa ran.&gt;&gt;Rinyi ran no no ran he rimi gbɨrekpa ran. <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />Nghamba me, inde iton tre ri,&lt;&lt;Ame me ran he si ran, ritu ngamba me ran he gbrekpa ran,&gt;&gt;Rimba ran no no hon he gbɨrekpa ran. <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />Wari tre ri ikpaa wawu he sii nye, me ri wo tre ringye? Ikpa wawu ran he ton, me ri ran wo hwi ri ngye? <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />Ama Izhi ri kɨma ko gbɨre ritan ti ri kpa bibi riwa a waa no he. <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />Wari tre ri igbɨrekpa he riri, imgbron kpaa ran he ri minyi? <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />Igibrekpaa wa he kigbu, ama ikpa he riri nye<verse eid="1CO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21" />Isi no ran la woo ri,&lt;&lt;Ikya ran kata kabru imbu-u ran!&gt;&gt;Ko ka, no tu no la wa za ri,&lt;&lt;Ikya ri ran ka ta kabru iwayi ran!&gt;&gt; <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />Aran he ngamba ran, igibreiwa wa kpa wa tsiri, nga wa ri ri ya wa ka wa ran he kyari ran, wawa nye wa bi han ko ritan rimi mba, <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />Igbɨrekpa riwa ki yonga wa ran tsra ri mgbromba ran ki ye ki no wari mba mkpen han ri ngamba no wa mkpen han. Ri ngamba, wa gbɨre mbi wawa wana bi ya ran wa ya wa ri bi han mgbron mba, <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />Igbɨrewawa wa bi ya wana ri ti kya sro ngan riwa ran, ama Izhi milankpa ti riwa a mɨlan igibreriwa a ran he kyari ran-a no bi han wa. <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />Ritu no wa gbɨre no wa ran ga ngamba ti nkan ri kpa ran tsede no gbɨre no wa milan ngamba ngɨzhi, mɨlan ngɨzhi riwa a he riri. <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />Ritu ngamba inde igbɨreri fe lilo, wawu mba wa fe llo, inde wa gbɨre ri wa ti kinklan sron, tse wa ka ti kinklan sron iwawu mba. <verse eid="1CO 12:26" /><verse number="27" style="v" sid="1CO 12:27" />Biyi bi he ka ikpa Kristo nye, ko ngan rimi mbi he gbɨre kpa wan nye. <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" />Rimi wa nji wa hu Izhi, Izhi no wa ndu wan nga wawa wati kyawa ri de sisiri, tse wawa wa fe de ri den nji kpa chuwo, ri wawa wa dzon nji, ri wawa wa ya ndu wa hu Izhi, ri wawa wa tre ri rɨme gbu nji kankan-kan. <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />Wawuu nye wa he wa ndu Izhi? Wawuu nye wa he wa la tre Izhi? Wawuu nye wa he wawa wa tsro? Ka iwawuu nye wati kyawa wa de sisiri? <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />Wawuu nye wa he ri de ri den nji kpa chuwo? wawuu nye wa he ri de tre ri rɨme kankan-kan? Wawuu nye wa he ri de ri la tre nji wari riwa wa tre? <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />Ama ti mbiye de riwa a bran han, me tsro yi nkon riwa a bi han iwawu.<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="s">Inyɨme</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />Inde wu to tre ri rɨme wari nkan ka ri rɨme miri ndu Izhi ama wu ran he ri nyɨme ran, wu he ka ishee riwa ki wo ran wan kuklu, a ran ri la kya ri ran. <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" />Inde ki to la tre Izhi riwa ari ye kusi, ki ri to kyawa krekre ama inde ki ran he ri nyɨme mgbron nji ran, ari tsro ri me ran he kyari ran. <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />Wari tre ri me ka kyawa won wawu no wawa wana he ri kyari ran, ko ka meri ka kpa won no wa no wa gon, ama me ran he ri nyɨme ran, me ran fe kyari ran ari he kuklu. <verse eid="1CO 13:3" /><verse number="4" style="v" sid="1CO 13:4" />Inji riwa a he ri nyɨme ari vu sron, iyɨme ran ti ngu ran, iyɨme ran kpongawan ran, inyɨme ran ri sentu ran. <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />Aran ri nzu tu ran, a ran ri nyime ngawan ran, a ran ri chichi ti fu ran, a ran ri suu tu ran, a ran ri ngɨzhi njo ri sron ran. <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />Inyɨme ran ri to ro meme ti ran ama ari to ro la kpunji tre. <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />Iyɨme ri de vu sron rimi kon ngye ri ikpa nyɨme rimi ko ngye, ari de yo sron ri ko ngye, nga vu dri rimi ko ngye.<verse eid="1CO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8" />Inyɨme ran ri kre ran iya tre ri kusi ri kre, tre wa rɨme ri kukri, ikpantu ri kre. <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />Kpunji tre, ikpantu mbu ran bran ran nga tre Izhi riwa ki la, kiran ri to lau kre ran. <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />Ama inde chachu riwa Kristo ri ye, ko ngye riwa a ran tsra ran ari kre. <verse eid="1CO 13:10" /><verse number="11" style="v" sid="1CO 13:11" />Riwa me he ri vren, me ran tre ka ivreta-ka ka ivren nga meri ran kpa tre ka ivren. Zizan riwa me he rinkon me ka kya riwa vren chuwo. <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />Ritu zizan me ya a ran ri kpan bran ran ritu me ya ri dzu kya ri ya sii, Zizan meto tsawen nye, meto-u kre-kre iwawu bibi riwa Izhi to wen kre- kre. <verse eid="1CO 13:12" /><verse number="13" style="v" sid="1CO 13:13" />Zizan, kyawa tra wanyi wa he, ri ikpanyɨme, ri yo sron nga nyɨme, ama inyɨme nye han waa wawu.<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s">Ide ri rɨme kankan-kan nga la tre ri kusi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />Yo sron mbi ri nyɨme bran bran bi ri timbye ri de riwa Yuu Tsitsri, a zizan ide Yuu ri la tre riwa ari ye kussi. <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />Inji riwa ari tre rɨme ri nkon ari tre ri Izhi a ran ri tre ri wa nji ran ritu njo ran wo kya riwa ari tre ran. Ari tre kyawa riwa Izhi wawa wa ri-ri dzu riwo Yuu Tsitsri. <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />Ama nji riwa ari la tre Izhi riwa ari no nji si sron ran no wa gbengbren nga ran ŋoron wa. <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />Inji riwa ari tre rimi rɨme wari nkan ari zon ngawan nye, ama riwa ari la tre Izhi ari no wa hu Izhi gbengbren nye mba. <verse eid="1CO 14:4" /><verse number="5" style="v" sid="1CO 14:5" />Inji riwa ari tre tre Izhi a han nji riwa ari tre rimi rɨme ri nkan nji riwa ari la tre riwa Izhi han nji riwa ari tre rɨme ri nkan tsede inde a tre ran la tuwa ritu no nji no wa wo wari fe senkpa.<verse eid="1CO 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 14:6" />Zizan imiri vayi, inde me ye meri ri layi tre riwa a he ri rɨme kan kan kan riwa Bachi no wen ri riwa me ngɨzhi ye no yi. <verse eid="1CO 14:6" /><verse number="7" style="v" sid="1CO 14:7" />A he ngamba nga ngungu wa si ri vi riri wati see wari to bibi ran mba ti nkan inde wa ran mɨlan wa tsi ran? <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />Inde wana mɨlan wuru nkiwi ran ko ngan ri zhu ri wa ari hi ku? <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />Nghamba nye ari he ri yi tse bi mɨlan tre nzɨra-nzira ko wa ka wo, inde a ran he ngamba ran ari zhu ka wu tre ri nkankshi wen nye mba. <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />Irɨme kankan-kan wa he ri mgbumgblume nga wawu mba wawa wa tre wa to tu wan. <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />Ama me he ka itsren inde me ran ri wo kya riwa nji riwa ari tre-a ri tre ran, ngawen ri he tsren ri me. <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />Nghamba nye ari he ri yi inde bi timbiye riwa bi fe de Yuu Tsitsri bi ka ti bi ri de senkpa mbi riwa ari no wa hu Izhi gbengbren.<verse eid="1CO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13" />Inji riwa ari tre ri rɨme ri nkan, no bre Izhi no Izhi no Yuu riwa ari ran la kya riwa ari tre. <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />Ama inde me bre ri rɨme ri nkan, Iyu won nye ri ibreama isron won ran ri to kya riwa me tre ran. <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />Ko me tise, me ibrerimi Yuu won, meri tre ri sron won, me chu se ri Yuu won, meri chuse ri sron won. <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />Inde wu ngɨri ri Izhi ri Yuu nkankshe rimi sron wen, imgbron nji wa ti see wari nyɨme ibrewen wari dzon gbre Izhi tunde wa ran wo kya riwa wu tre ran? <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />Ri riwa wu ngiri ri Izhi bran bran, ama a ran dzon njo ri ran.<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />Me ngiri ri Izhi riwa me tre ri rɨme wari han yi. <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />Ama rimi kabru tu wa hu Izhi a bi han ri mon ri wa me tre wɨlo tre mgibreton riwa wa to-u riwa ari zon wa han riwa me tre wɨlo tre ngo wuru kuma wana to kya riwa me tre ran.<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />Miri vayi ran taka ka imiri wa tsitsa, tsede rimi meme ti, he ka imiri wawa wana to kyari ran, ama ki ri rimɨren bibi wa wa rinkon. <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" />A he rimi ngan ri mi tsro bibi riwa Izhi tre:</para>
  <para style="q1" vid="1CO 14:21">&lt;&lt;Me tre ri wa nji won zhu ri nyun nji wa wa wa</para>
  <para style="q2" vid="1CO 14:21">tre rɨme kanka, nga zhu ri ntan nyu,</para>
  <para style="q1" vid="1CO 14:21">ri ngamba wana sren ton rɨme ran,</para>
  <para style="q2" vid="1CO 14:21">Bachi tre nganyi,&gt;&gt;<verse eid="1CO 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22" />Bi to ri tre rimi rɨme wari nkan a he mesali ri wawa wana to Izhi ran, ama ila tre riwa ari ye kusi he ritu wawa wa hu Izhi nye. <verse eid="1CO 14:22" /><verse number="23" style="v" sid="1CO 14:23" />Ritu ngamba inde wa hu Izhi wa kabru wari ri bre ri rɨme wari kankan-kan, tse wari wawa wa ran hu Izhi ran waye wo kya riwa bi ti, wa tre ri bi sra. <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />Ama inde nji ri la tre Izhi he rimi la tre riwa nji ri la tre riwa ari ye kusi, tse nji riwa a ran hu Izhi ran, ko nji riwa a ran to kya riwa wa ti ran ye gra, tse tre ko ngan bre, hari a wa ka meme ti chuwo. <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />Wa ngaran nchi sron wawa wa ran hu Izhi ran zhu ri ra, ngamba nye wari la ri wawu kɨbu mgbazhu ran tre ri,&lt;&lt;Izhi he ri yi njanji,&gt;&gt;<verse eid="1CO 14:25" /></para>
  <para style="s">IibreIzhi ri Nkon Riwa a Tsra</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />Imiri vayi me wa meri layi, inde bi kabru riwa bi bre Izhi, iri he ri de riwa chuse, iri he ri de riwa tsro, iri he ri de riwa raa, iri he ri de ri tre ri rɨme nkankan-nkan, nga ri he ri de ri la tu tre ri rɨme kan-kan-a wanyi wawu ri he ritu no zon wa hu Izhi no wa gbron rimi Yuu Tsitsri. <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />Inde wanjo wa tre ri rɨme ri nkan, no wa ran han hari ko itra ran, no wa hu yiyiri, nga no njo ri nkan no la kya riwa wa tre-a. <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />Ama inde njo ran he riwa ari la tre-a rimi tra bre Izhi ran, ko ngan ka son ri mgbamgbi ran ran bre Izhi rimi sron wan nga Izhi wan. <verse eid="1CO 14:28" /><verse number="29" style="v" sid="1CO 14:29" />No wa la tre Izhi hari ka tre no wa la tre riwa Izhi, no wari no wa ki wari mɨlan ya kya riwa wa tre. <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />Inde nji ri he rimi tre tse iraa ye ri nji ri, tse nji riwa ari tre-a no son mgbamgbi wari wo kya riwa nji riwa a raa tre Izhi-a no la kya riwa a ra-a ri. <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />Wawu mbi bi to la tre riwa ari ye kusi riwa ko ngan ri fe tsro nga gbengbren rimi wan. <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />Wawa wa la tre riwa a zhu ri Izhi ye riwa wa Yuu mba nye ri dzon wa, nga wa ka ki gben ngamba. <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />Izhi mbu ran he Izhi riwa ari gyuru nji ran ama a he Izhi riwa ari ngɨzhi son ri si sron ye.</para>
  <para style="p" vid="1CO 14:33">Nghamba nye a he rimi wa hu Izhi ri Tsitsri, <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />No mba no wa ki mgbi rimi kabrutu wa hu Izhi ritu wa ran no wa no wa tre ran bibi riwa doka nji Yahuda kri, no wa ran he rinkon ran ama no wawa no wa de mkpen. <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />Inde wa he ri kya riwa wa wa wari wo no wa miyen wa ron mba ri ko, ritu a he kya ri shan nye no waa no tre rimi wa hu Izhi.<verse eid="1CO 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36" />Ritu mbi nye tre Izhi gbuchi? Ka ri yi nye ari kre? <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />Inde njo ri to ka wawu he nji riwa ari la tre Izhi, no to ri ikya riwa me ngan ri no yi a he doka nye riwa a zhu ri Bachi. <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />Ama inde a ran srenton ri tre won ran wawu Izhi ngawen ri kawan ri wu.<verse eid="1CO 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39" />Ritu ngamba miri vayi, ran timbiye riwa bi ran la tre Izhi riwa ari ye kusi, ran dzu wawa wa tre ri rɨme kan-kan-kan ran. <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />Ko ngye no he rimi milan ti nga ri nkon riwa a bi.<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s">Itashɨme Kristo kugon kuu wan</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />Zizan biyi miri vayi won wa hu Izhi, me wa meri la yi tre raro, riwa bi kpa nga riwa iyo sron mbi kri ritu wan mgbemgben. <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />Ritu bibi tre riwa me layi nyi nye riwa bi fe kpa chuwo, inde bi mɨlan-u ngɨzhi bibi riwa bi wo, inde a ran he ngamba ran ikpanyime bi he kuklu nye.<verse eid="1CO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3" />Me no yi kya riwa me kpa, riwa a bi hari riwa a he rimi ngan: ri Kristo kuu ritu meme ti mbu, <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" />Nga wa ban wu no yibi nga ka ta shɨme ri kugon vi tra bibi riwa a he rimi ngan, <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" />Riwa a zhu ri Kefas nga wa ndu Izhi wuru don hari. <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />Kugon rimba a zhu ri miri vayi wawa wa han gbigba ton riwa wa he hari ye riwa ama wa ri mba wa kuu. <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />Ri mba ka zhu ri vayi wan riwa wa yo-u ri Yakubu nga mgbron wa ndu Izhi. <verse eid="1CO 15:7" /><verse number="8" style="v" sid="1CO 15:8" />Ri kre wan wawu, a zhu rimo ngawen, ko riwa me ran ke riwa me to-u ran. <verse eid="1CO 15:8" /><verse number="9" style="v" sid="1CO 15:9" />Ame nye me he kremkpen rimi wa ndu Izhi riwa me ran tsra riwa wa yo wen ri me he nji ri ndu Izhi ran, ritu riwa me no wa hu Izhi yaa. <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />Ama ritu ndindi ti riwa Izhi me he kya riwa me he nga ndindi riwa a ti ri mon a ran he kukulu ran, hari me han ko ngan rimi ndu Izhi, ama a ran he ame nye ran ama ritu ndindi ti Izhi riwa a he rimi sron won. <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />Ko ame, ko a he wawa riwa ki la tre Izhi wawu nye kya riwa bi kpanyɨme.<verse eid="1CO 15:11" /></para>
  <para style="s">Itashɨme wa Kuu</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />Zizan riwa ki tre tre ta shɨme ingye ti ko wari mbi wa kamba ri tre ri itashɨme ran ri he ran? <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />Inde bi tre ri itashɨme ran he ran, a tsro ri Kristo ran tashɨme ran nye mba. <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />Wari tre ri Kristo ran tashɨme ran, tre tre Izhi mbu he kuklu nga kpanyime mbi ri Izhi he kukulu. <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />Ari he che ritu wandu Izhi, ritu ki tre ri Izhi ta Kristo shime ri bubu gru, ama rimba ran he kpunji ran inde itashɨme ri kuu ran he ran. <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />Inde wari tre ri wa ran ta wa kuu shɨme ran, Yeso ran ran kuu ran ta shɨme ran. <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />Inde Kristo ran tashɨme ran, ikpa nyɨme mbi ran he kuklu, hari zizan bi ri he rimi meme ti mbi. <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />Wari tre ri itashɨme ran he ran, wawa wa kuu rimi yo sron ri Kristo wari gra ri ko wuru nye. <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />Inde yosron mbu ri Kristo ran he ritu sonmbu ri mgbumgbrume nyi ri kankshe, ki ri he kya ri lo sron han mgbron nji.<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />Ama rinyi nye ri no nji no wa kpa nyɨme ri wawa wa kuu rimi Yeso wa tashɨme. <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />Bi to, riwa ikuu ye zhu ri nji riri ngamba nye itashɨme ri zhu ri nji riri. <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />Ko ngan kuu ritu ki he gɨzhi Adamu, ngamba nye ri tashɨme ritu Kristo. <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />Igba hu tre ri wa ki hu rimi tashɨme Kristo nye a he riwa a gbuchi tashme, imba wawa wa he wa Krisro wa tashɨme chachu riwa a ye. <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />Kugon rimba ikre vi ri ye, Kristo ri han gbengbren wawa wa ri kpanchi nga wa doka ri gbengbren. <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />Wawu Kristo ri son ri kpanchi son wan, ran to ri wawu no wa kpan fu wan shan ran ko wa rega. <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />Wa kpanfu wawa wa wuu wa ri krenmkpen nye he kuu. <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />Mbe Izhi tre ri,&lt;&lt;Izhi kɨma kon ngye yo ri ndoza kpanchi son wan.&gt;&gt; Ran tre ri,&lt;&lt;Inde a tre ri ko ngye he ri ndoza gbengbren wan,&gt;&gt;Rimba ran nyaan Izhi kyuwan riwa a no Kristo gbengbren ritu ko ngye ran. <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />Inde Izhi kɨma ko ngye yo ri ndoza wan, wawu Yeso ngawen he ri ndoza Izhi riwa a kɨma ko ngye yo ri ndoza wan, ritu no A ti Izhi no to ri wawu he ko ngye.<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />Inde a ran he ngamba ran, nji wa nyi wa ti ngye, wawa wa son wa ri ima ri nyu wawa wa kuu? Inde wana ta wawa wa kuu shɨme ran ko ngye ti ko wa son nji tu ri ima ri nyu mba? <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />Ngye ti ko ki yo ngambu ri yaa bla vi? <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />Me shizhi imiri vayi, me sondu to kuu bla vi, a he ri rira bibi kpongawon ritu kya riwa Bachi Yeso Kristo ti ri yii. <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />Inde me taku ri wa nji Afisa wawa wa he ka nɨma ji, ri bibi rimɨren nji riba won ri he ngye? Inde hari wa ran ta wawa wa kuu shɨme ran,</para>
  <para style="q1" vid="1CO 15:32">&lt;&lt;Ba tse kika son ndu gra ri ri ri so ba,</para>
  <para style="q2" vid="1CO 15:32">tunde imibreki kuu.&gt;&gt;<verse eid="1CO 15:32" /></para>
  <para style="m">
    <verse number="33" style="v" sid="1CO 15:33" />Ran no wa gyuru yi ran: Ritu&lt;&lt;Memeti ri kpa ndindi ti time.&gt;&gt; <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />Milan taka ritu kya riwa a tsra bi ri ka ti meme ti chuwo, me tre rinyi ritu no shan tiyi, ritu wari mbi wana to Izhi ran.<verse eid="1CO 15:34" /></para>
  <para style="s">Itashime kpa</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />Ama injo ri miyen,&lt;&lt;Ikɨmo ri tise ran wurunde? ikpa bibi tan nye wa wurunde ri wu?&gt;&gt; <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />Imiyen ri mkpran bibi tan! Inde wu chu wɨlo bikpi ri meme a ran ri zhu mbe ran tsede a kuu ri ka zhu mbe. <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />Nga kya riwa wu chu ri meme a ran he wawu mba nye ri zhu mbe ri mkpomkpon ran, iwɨlo wan nye ri zhu mbe ko inde a he alikama ko bibi bi ri nkan. <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />Izhi ri no kpa riwa a wa no he, ari no ko wɨlo ritan bibi kpaa riwa a he. <verse eid="1CO 15:38" /><verse number="39" style="v" sid="1CO 15:39" />Inɨma kpa wana he bibi riri ran: Inji wa he ri bibi wamba nkan, inɨma ji wa he ri bibi wamba, chenchen ri bibi wamba nga lambe wa he ri bibi wamba nkan. <verse eid="1CO 15:39" /><verse number="40" style="v" sid="1CO 15:40" />Ikpa wari wa he ri shu nga wari wa he ri meme, ama imkpen riwa kpa ri shu a he nkan ri bibi kpa ri meme. <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />Igbɨreriwa ji he nkan nga riwa hwa he nkan, iwa wa ntsen wa he nkan, ikpan mba wa he kankan kan. <verse eid="1CO 15:41" /><verse number="42" style="v" sid="1CO 15:42" />Nghamba nye ari he ri tashɨme ri kuu, wa no ta yɨwi ri kpa mbu ri meme ama wa ta wa shɨme wa ki ba yii tu. <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />Inde wa no kpa yɨwi, ari meme ran ran sen kpa ran, ama inde a tashɨme ari bi ran senkpa; <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />inde wa no kpa yɨwi ari he kpa nji ama inde ari wurunde ari wuru rimi Yuu, inde ikpa riwa ki to-u ri he, ngamba ngawen ikpa ri Yuu ri he. <verse eid="1CO 15:44" /><verse number="45" style="v" sid="1CO 15:45" />Imbe tre Izhi tre ri,&lt;&lt;Adamu nji ri gbuchi wa ti-u a he nji riwa ari vɨri.&gt;&gt;Wawu Adamu ri kremkpen a he Kristo. Adamu ri krenkpen he Yuu ri de vɨri. <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />Ikya riwa a gbuchi ye a he kpa, nga kpa ri Yuu ka ye kugon. <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />Adamu ri gbuchi riwa wa ti-u ri meme, Kristo nji ri hari zhu ri shu. <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />Wawa wa ti wa ri meme wa he ka Adamu wawa wati wa ri meme, wawa wa zhu ri shu wa he ka wawa wa zhu ri shu. <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />Bibi riwa ki he ka wawa wa he ri meme ngamba nye ki he ka nji riwa a zhu ri shu-a. <verse eid="1CO 15:49" /><verse number="50" style="v" sid="1CO 15:50" />Ikya riwa me tre ri yi miri vayi, ki ran hi ri shu ri kpa mbu ran, ritu ki kuu ri kpa mbu nyi nga ari gla. <verse eid="1CO 15:50" /><verse number="51" style="v" sid="1CO 15:51" />Ama de me ngaran tre nyi riwa a tre ri a ran wawu mbu nye ki kuu ran tsede wawu mbu wa sran ta kpa. <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />Wawa wa ku ari vi riri riwa i wa mvɨri rangan ri kremkpen wawa wa kuu wa wa tawa shɨme ri sii nga kita wawa ki he ri sii wa sran ta kpa ngawen. <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />Ritu ikɨmon wawa wa kuu wa tawa shɨme ri sii riwa wana kuu ngaran, ikpa mbu riwa kiran kuu ran wa sran wa. <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" />Ka ikpa nyi riwa wa gla a sran ngawan ti kpa ri wa a ran gla ran, nga kpa riwa a kuu nyi a ri kɨma ti kpa riwa a ran ku ngaran, mba tre ri wa a he ri nga a ri zhu ra Izhi ri ban kuu zho ri ta, ikuu ran he ri mgbenbren ri tu mbu nga ran.&gt;&gt;<verse eid="1CO 15:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="1CO 15:55" />&lt;&lt;Ikuu, ikpande wen ri he ri mi yin?</para>
  <para style="q2" vid="1CO 15:55">gbengbren wen he ri mi nyi.&gt;&gt;<verse eid="1CO 15:55" /></para>
  <para style="m">
    <verse number="56" style="v" sid="1CO 15:56" />Ritu meme ti mbu nye ki kuu, nga ritu doka Izhi nye ki to ri ki ti meme ti. <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />Ama ki ngiri ri Izhi riwa a no ta ki kpa nde ritu meme ti nga kuu dzu riwo Bachi mbu Yeso Kristo. <verse eid="1CO 15:57" /><verse number="58" style="v" sid="1CO 15:58" />Biyi miri vayi won wa hu Izhi, vu sron mgbemgben, sondu ran tindu ri Bachi mbi tunde bi to ri indu riwa bi ti ri Bachi ran he kuklu ran.<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s">Idzon Ritu wa hu Izhi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />Zizan ritu ngan riwa bi ngan ritu nkren riwa wa kabru wari dzon wa hu Izhi ri Yahudiya: Ti kya riwa me la wa hu Izhi ri Galatiya nowa ti. <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />Bla vi ri Ladi, ko ngan mbi ri ka vi nkren ran dzi, rimi kya riwa bi fe don inde me ye me ka ran bru minye nkren ri yi nga ran. <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />Inde me ye zhu riyi me no wawa bi nyɨme ri wa mbe riwa wa ngɨzhi zon mbi hi no wa ri Urishelima. <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />Inde a bi no ame me hi, wawa wa ka hu wen hi.<verse eid="1CO 16:4" /></para>
  <para style="s">Bulus a hi Ran hi Zren</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />Me ye ri yi kugon riwa me hu ri gbu Makidoniya ritu ku bubu wan nye me hu. <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />Me ya son ri yi zhu ri su, ritu bi ri hu wen ran hi ko kutan riwa me hi. <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />Zizan me ran to yi ri nkankshe me ri bru hi ngawon ran, me wa me ri wuu vi ri yi bran inde Izhi kpa nyɨme. <verse eid="1CO 16:7" /><verse number="8" style="v" sid="1CO 16:8" />Me son ri Afisa hi ri vi ro ri Fentikos. <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />Ritu zizan wa bu nkon ndu ri ndindi rimo riwa me ti, ama wa meme wa kigbu.<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />Inde Timoti ye bi ka mɨlan-u ngɨzhi ri mkpen ritu wawu ri tindu Izhi bibi riwa ame me ti. <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />No njo no ran tsiri Timoti ran, ama zon-u rimi zren wan ri si sron, ritu a ri bru ye ri me. Me ya nkon wan ri mgbron miri vayi wa hu Izhi.<verse eid="1CO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12" />Ritu tre vayi mbu Apolo, me bre wu ri no bru ye ri yi ri mgbron wa hu Izhi. Ama a ran wa ran ye zizan ran, ama ari ye ri vi riwa a to a bi.<verse eid="1CO 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />Milan ki bi ri vu sron mbi ri kpanyɨme, ŋwesii bi ri senkpa. <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />ko ngye riwa bi ti bi ka ti-u rimi nyɨme.<verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15" />Bi to nji wa ko Istifanus, wawa nye wa gbuchi kpa Izhi ri meme Akaya, wari de tumba riwa wati ndu ri wa Tsitsri, <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />Me ibreyi no yi ti kya riwa wanji wa tre ri no yi ti, ri wawa wa he wa kpan so yaa mbu. <verse eid="1CO 16:16" /><verse number="17" style="v" sid="1CO 16:17" />Me ti kinklan sron ri ye Istifanas, ri Fatunatus, ri Akaikus ritu riwa wati ndu rimo rinyu mbi. <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />Iye mba si wen sron ri wambi ngawen bibi nji wanyi a bi no wa milan wa ngɨzhi.<verse eid="1CO 16:18" /></para>
  <para style="s">Ichi Bulus ri Krenkpen</para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />Wa hu Izhi wa meme Asiya wa chi yii Akila ri Briskila, ri wau Izhi wawa wa kabru ri komba wa milan ri chi yi ritu Bachi. <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />Miri vayi wawu wa chi yi. Chi ngambi ri bibi chi ri Tsitsri. <verse eid="1CO 16:20" /><verse number="21" style="v" sid="1CO 16:21" />Ame Bulus nye me ngan chi nyi ri wo won. <verse eid="1CO 16:21" /><verse number="22" style="v" sid="1CO 16:22" />Inji riwa a ran nyɨme Izhi ran a he nji riwa wa la nyu riwu, no Bachi mbu no chichi ye. <verse eid="1CO 16:22" /><verse number="23" style="v" sid="1CO 16:23" />Ndindi Bachi Yeso no he ri yi, me nyɨme yi wawu rimi nde Yeso. <verse eid="1CO 16:23" /><verse number="24" style="v" sid="1CO 16:24" />Me chi yi wawu ichi ri nyɨme ritu ndindi ti Yeso Kristo.<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>