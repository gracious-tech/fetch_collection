<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- BUU</book>
  <para style="h">JHN - BUU</para>
  <para style="toc1">JHN - BUU</para>
  <para style="toc2">JHN - BUU</para>
  <para style="toc3">JHN - BUU</para>
  <para style="mt1">JHN - BUU</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">Iwɨlo tre Riwa ari de Vɨri</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />Ri mimɨlan iwɨlo tre-a a he, iwɨlo tre-a a he imba Izhi, iwɨlo tre-a a he Izhi nye. <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />Wawu nye ri mimɨlan a he mba Izhi.<verse eid="JHN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 1:3" />Dzu ri wo wan nye Izhi a ti kyawa wawu, ikya ri a ran he riwa wa hon ti riwu ran rimi kyawa wawa wa ti wa. <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />Rimi wɨlo tre-a nye ivɨri a he nga wawu viri-a nye a he kpan tsu mbu. <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />Ikpan-a sondu ri kpan rimi bu nga ibuu ran han gbengbren wan ran.<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />Inji ri a he riwa wana yo-u ri Yonana riwa Izhi a ti-u ndu. <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />Riwa a ye ri bubu la tre ritu kpan tsu-a nga ran tsro wanji wawu no wa wo wari kpanyɨme. <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />Aran he Yonana nye a he kpan tsu-a ran, ama a ye riwa ari la tre ritu kpan tsu-a nye <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />Ikpan ri ri kpunji he riwa ari ye mgbumgblume nyi riwa ari kpan tsro ko ngaa. <verse eid="JHN 1:9" /><verse number="10" style="v" sid="JHN 1:10" />Sisenmu iwɨlo tre-a a he rimi mgbumgblume, wa ti mgbumgblume-a dzu ri wo wari ama mgbumglume-a a ran to-u ran. <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />A ye ri wa nji wa gbu wan, ama wa nji wan wa ran kpa ran. <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />Ama wa nji wawa wa kpa tre wan, wari kpanyɨme ri tre wan, a no wa gbengbren no wa he miri Izhi. <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />Wa ran he miri bibi riwa wa ngɨzhi wa bibi riwa iwa mba ronron wa kabrutu ko wari ngɨzhi ran, a ran ritu mbye ri kpa riwa nji ri ti ko ran ngɨzhi ran, ama Izhi kyuwan nye he Ti mba.<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />Iwɨlo tre-a he nji, a son rimi mbu ki to mkpen wan, imkpen riwa a he wama riwa wawu ri nkankshe he ri wu riwa a zhu ri Izhi, riwa a sho ri ndindi ti nga kpunji.<verse eid="JHN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />Yohana a tre ritu wan mgbamgban ri,&lt;&lt;Rinyi nye he nji riwa me tre tre ritu wan riwa me tre ri yi ri la nji nyi nye he nji riwa me tre riyi ri,&lt;Inji riwa ari ye kugon won a han wen ritu a he ka wana ngɨzhi wen rina.&gt;&gt;&gt;<verse eid="JHN 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16" />Ri kigbu ndindi ti Yeso nye a ti lɨbu dindi sro ritu wawu ari sondu ti lɨbu ri ta bla vi. <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />Izhi a de doka dzu riwo Musa, ama a de ndindi ti nga kpunji dzu riwo Yeso Kristo. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />Injo ran to Izhi ri si zari ran, ivren wan riwa ari son kuwo ri wan nkankshi wan riwa wa tsra mba Izhi nga ran he mba ti wan wawu nye la ta bibi riwa Izhi he.<verse eid="JHN 1:18" /></para>
  <para style="s">Itre Yonana nji ri Son nji tu ri Mma</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />Ingye itre Yonana riwa nji Yahuda wa Urushelima wa ti wa sro yii nga Lawiyawa ndu ri wu wari miyen ri,&lt;&lt;A wu wuhe ngan?&gt;&gt; <verse eid="JHN 1:19" /><verse number="20" style="v" sid="JHN 1:20" />Yonana a ran tron ran, a la wa ri,&lt;&lt;Aran he ama nye me he Bachi ran.&gt;&gt;<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />Waka miyen-u ri,&lt;&lt;Ko wu he ngaa? Wu he Iliya?&gt;&gt;Ka tre ri,&lt;&lt;Me ran he wawu ran&gt;&gt;Waka miyen ri, &lt;&lt;A wu nye wuhe nji ri la tre Izhi-a? ka bru tre ri&lt;&lt;Onhon&gt;&gt;<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />Waka tre riwu,&lt;&lt;Ko wu he ngaa? La ta kya riwa ki hi kiri la wawa wa tita ndu. Wa yo-u ri ngan?&gt;&gt;<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />Yonana ka nyɨme ri wa ri la tre riwa ari ye kusi riwa Ishaya a la ri,</para>
  <para style="q1" vid="JHN 1:23">&lt;&lt;Ame nye me he raan riwa ari yo rimi ji ri,</para>
  <para style="q2" vid="JHN 1:23">&lt;&lt;Mɨlan nkon ti yi ritu no Bachi no dzu.&gt;&gt;&gt;<verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />Farisa wawa wa ti wa ndu. <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />Waka miyen Yonana ri,&lt;&lt;I wuran he Kristo ran, wuran he Iliya ran wuran he nji ri la tre Izhi-a ran ko wu tise wuri ri son nji tu ri ima?&gt;&gt;<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />Yonana ka la wa ri,&lt;&lt;Ame me son yi tu ri ima ama nji ri he rimi mbi riwa bi ran to-u ran. <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />Wawu nye riwa ari ye kugon won, riwa ame me ran tsra riwa me sii zhizhi ntan za wan ran.&gt;&gt;<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />Kyawa wanyi a he ri Batani nye wa ti wa kugran nne wurudu bubu riwa Yonana a ran son nji tu ri ima.<verse eid="JHN 1:28" /></para>
  <para style="s">Yeso nye he vren Ntɨma riwa Izhi</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />Ri mibreri han wan Yonana ka to Yeso ri ye ri wu imba ran la wari,&lt;&lt;To ntɨma riwa Izhi riwa a ban meme ti mgbumgblume iwawu. <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />Wawu nye riwa me layi ri,&lt;Inji ri ri ye kugon won riwa a han wen wawu a he ka wana ngɨzhi wen rina.&gt; <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />Ri mimɨlan ame meran to ran ama a ye ri son nji tu ri ima ritu no wa tsro-u ri wa nji Israila.&gt;&gt;<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />Imba Yonana a la tre-a ri,&lt;&lt;Me to Yuu riwa a zhu nguu gɨzhi riye ran son ri tu wan. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />Ri mimɨlan me ran to-u ran ara Izhi riwa a ti wen ndu no wen son nji tu ri ima wawu nye tre ri mo ri,&lt;Inji riwa wu to Yuu gɨzhi ri ye ran ye son ritu wan, to wawu nye riwa ari son nji tu ima ri Yuu ri Tsitsri.&gt; <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />Ame Yohana me to ngamba nye a he me ri tre ri rinyi he vren Izhi nye.&gt;&gt;<verse eid="JHN 1:34" /></para>
  <para style="s">Imiri ndu Yeso ri Gbuchi</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />Ri mibreri han wan Yonana nga miri ndu wan hari wa kuki. <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />Imba Yonana a to ka Yeso a ye ran ka ran hi ran tre ri,&lt;&lt;To ntɨma Izhi won&gt;&gt;<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />Riwa imiri ndu Yohana hari-a wa wo tre Yonana waka hu Yeso. <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />Riwa Yeso a kɨma ya gon wan, imba ka to ka wa hu wawu ran minye wa ri,&lt;&lt;Bi wa ngye?&gt;&gt;Waka tre ri wu ri,&lt;&lt;Rabbi&gt;&gt;Iwɨlo tre nyi he ri nji ri tsro,&lt;&lt;Wu son ri tan nye?&gt;&gt; <verse eid="JHN 1:38" /><verse number="39" style="v" sid="JHN 1:39" />Imba Yeso ka tre riwa ri,&lt;&lt;Ye rɨme bi ri to.&gt;&gt;Ri ji yawulu krefi nza, imiri ndu wan waka hi wari ka to bubu riwa ari son wari ki iwawa chachu wan.<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />Andarawus vayi sima Bitrus a he rimi miri ndu wan hari wawa wa hu Yeso kugon riwa wa wo tre Yohana ritu Yeso. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />imba Andarawus ka gbuchi wa vayi wan Sima ran tre ri wu ri,&lt;&lt;Ai ki fe Kristo-e.&gt;&gt;Inji riwa ari dzon. <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />Ran ngɨzhi vayi wan Sima hi ri Yeso ka ya-u ran tre ri,&lt;&lt;A wu nye wu he sima ivren Yonana? Wa,&gt;&gt;Yo-u ri Kefasi. Ko ka Bitrus riwa ari minye,&lt;&lt;Tita&gt;&gt;<verse eid="JHN 1:42" /></para>
  <para style="s">Yeso a yo Filibu nga Nataniyel</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />Ri mibreri hari wan, Yeso kana wa ran hi Galili imba ka fe Filibu ran tre riwu ri,&lt;&lt;Hu wen.&gt;&gt;<verse eid="JHN 1:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 1:44" />Filibu a he nji ri gbu Batsaida nye igbu riwa Andarawus mba Bitrus wa ki ri bubu wan. <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />Filibu ka fe Nataniyel ran tre riwu ri,&lt;&lt;Ki fe nji riwa wa ngaa tre wan rimi doka Musa nga wa mbe wa la tre zhi, wawu nye he Yeso nji Nazara ivren Yusufu.&gt;&gt;<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />Imba Nataniyel ka miyen ri injo ndindi ri to zhu ri Nazara nyi? Filibu ka tre ri wu ri,</para>
  <para style="p" vid="JHN 1:46">&lt;&lt;Ye wuri ye to mba.&gt;&gt;<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />Yeso a to Nataniyel a ran ye ri wawu ran tre ri,&lt;&lt;Kɨma ya nji israila ri kpunji riwa a ran he ri che ri nne wan ran.&gt;&gt;<verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />Imba Nataniyel ka miye Yeso ri,&lt;&lt;Wu ti se ko wuri to wen?&gt;&gt;Yeso ka tre riwu ri,&lt;&lt;Me to-u kawu he ri konkron mbuwa, ko no Filibu no yo-u.&gt;&gt;<verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />Imba Nataniyel ka tre ri Yeso ri,&lt;&lt;Inji ri tsro, a wu nye wu he vren Izhi, a wu nye wu he chu wa nji Israila.&gt;&gt;<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />Yeso a tre ri Nataniyel ri,&lt;&lt;Wu kpanyɨme ritu me la-u ri me to-u ka wuhe ri nchi konkron mbuwa? Aran raa rimba ran, wu to kyawa wawa wa han rimba.&gt;&gt; <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />Yeso ka lawa sron ngan ri,&lt;&lt;Kpunji tre me la yi, bi to shu wulu ri bu, imiri ko Izhi wa hon wari gɨzhi ri tu won Vren Nji.&gt;&gt;<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">Iro ri Gran ri Kana riwa Galili</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />Ri vi ri tra wan waka ti ro ri ri gran ri Kana riwa Galili iyi Yeso ka he ri bubu gran. <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />Wa yo Yeso nga mirindu wan ri bubu ro gran <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />Riwa iima raro ri ro ri gran a kre, iyi Yeso ka tre riwu ri,&lt;&lt;Iima raro kre.&gt;&gt;<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />Yeso ka tre riwu ri,&lt;&lt;Iya itre nyi ran he wa me ran, ai ivi won ran ti rina.&gt;&gt;<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />Iyi Yeso ka tre ri wa ndu wan ri,&lt;&lt;Ikya riwa Yeso tre ri no yi ti, bi ka ti wu.&gt;&gt;<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />Nji Yahuda wa he ri bibi tsri ngamba riwa wa ti ritu ngamba wa ri mbuwari tanren wawa wa me wa ri tita ki ri bubu wan, ko ritan rimi mba ri ri galo gbigba ri.<verse eid="JHN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 2:7" />Imba Yeso ka tre ri wawa wa tindu ri,&lt;&lt;Fon ima sho ri mbuwari wanyi.&gt;&gt;Waka shu mbuwari wa-a ri ima,<verse eid="JHN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 2:8" />Ngha Yeso ka la wa ri,&lt;&lt;To zizan vu hi no nji riwa a he nji ri ro gran.&gt;&gt;Wa ka vu ima-a ka no nji ri ro gran, <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />iima-a ka kɨma ti ima raro nji riwa a ran ya ro ri gran ka pireso tsawen. Wawu kana to bubu riwa iima raro-a zhu ye ran, ama wawa wa ti ndu-a wa to bubu riwa iima-a zhuu ye, imba ka yo ron wasa-a ri gran, <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />ran tre riwu ri,&lt;&lt;Ai ko ngan ri gbuchi de ima ri roo ri, kugon riwa nji wa so wari hua ko ari ngɨzhi riwa a ran bi tsra ri rigbuchi ran yi ama a wu wu rii ima ndindi-a tse zizan!&gt;&gt;<verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />Rinyi nye a he kya ri de sisiri ri gbuchi riwa Yeso a ti-a ti kya nyi ri kana riwa Galili; bubu riwa wa tsro mkpen wan, imiri ndu wan waka kpa nyɨme riwu.<verse eid="JHN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />Kugon rinyi, Yeso nga yi wan ri miri vayi wan, nga miri ndu wan waka hi ri gbu Kafarnau wari ka ki ti vi hari ri bubu wan.<verse eid="JHN 2:12" /></para>
  <para style="s">Yeso a hi ri Ko Izhi</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />Riwa ivi ro dza gran riwa Youdawa a ye hwri, imba Yeso ka hi ri Urushelima. <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />Ri kana ko Izhi-a a fe nji wa ran reri wa lando, intɨma, inguu wa ko nga wawa wa sran nkren wa ki ritu tebru mba. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />Imba Yeso ka chan gbagba ri zhizhi ran dzu wa wawu rimi ko Izhi, ka hu ri wa ntɨma ri wa lando nga ran tru wa kpanchi mba riwa wa sran nkren-a rega, ran vu nkren mba vra rega. <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />Yeso ka tre ri wawa wa rewa nguu wa ko-a ri,&lt;&lt;Vu wa zho ri nyi! Ran kɨma ko ti won ti bubu reri kpi ran!&gt;&gt;<verse eid="JHN 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 2:17" />Imiri ndu wan waka taka kya riwa wa ngan rimi tre Izhi ri,&lt;&lt;Inyɨme riwa me nyɨme ko wen, a wu Izhi, ari huu wen ka iwulu.&gt;&gt;<verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />Imba wa rinko nji Yahuda waka myen Yeso ri,&lt;&lt;Ko wu ti ngye riwa ari de sisiri riwa wu tsro ta riwa a no-u ti kyawa wanyi ?&lt;&lt;<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />Yeso ka nyɨme ri,&lt;&lt;Dzi ko Izhi nyi, nga rimi vi tra me bru mme nganga.&gt;&gt;<verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />Wa rinkon wa nji Yahuda waka minye Yeso ri,&lt;&lt;Wu bru mme rimi vi tra? A ban vi senza don tanren riwa wa mme tra ibrenyi!&gt;&gt;<verse eid="JHN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21" />Ama iko riwa Yeso ri tre-a a he kpa wan nye. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />Ka wa ta Yeso shɨme rimi kuu, imiri ndu wan waka taka kya riwa Yeso a tre-a wari kpa nyɨme ri tre Izhi riwa wa ngan-a, nga tre riwa Yeso a la.<verse eid="JHN 2:22" /></para>
  <para style="s">Yeso to Sron ko Nghaa</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />Ri vi riwa Yeso a he ri Urushelima ritu ro ri dza gran, nji kigbu waka kpanyɨme riwu ritu kyawa wa de sisiri riwa wa to a ti wa. <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />Ama Yeso a ran ka sron wan no wa ran ritu a to ren nne mba kre. <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />Yeso a ran wa riwa injo ran la-u kyari ritu mba ran, ritu wawu a gbuchi to kya riwa a he rimi sron mba.<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">Yeso Imba Nikodimu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />Wa ran yo nji ri ri Nikodimu, riwa a he rɨme gɨzhi Farisa, wawu a he rinkon rimi nji Yahuda. <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />Inji nyi a ye ri Yeso ri chu, ran tre ri wu ri,&lt;&lt;Inji ri tsro, ki to ri wu he nji ri tsro nye riwa Izhi tru-u ye. Kito injo ran to ti kyawa wa de sisiri nganyi ran tse nji riwa Izhi he riwu.&gt;&gt; <verse eid="JHN 3:2" /><verse number="3" style="v" sid="JHN 3:3" />Yeso ka tre ri wu ri,&lt;&lt;Kpunji tre me la ri wu: injo ran ri to gra ri kpanchison Izhi ran tse wa bru ngiji-u.&gt;&gt;<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />Nikodimu ka miye-u ri,&lt;&lt;Wa tise ko wari ngɨzhi nji riwa a kunchon nganga?A ri bru gra rimi nne yi wan no wa bru ngiji-u ri mkpa ri hari?&gt;&gt;<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />Yeso ka tre riwu ri,&lt;&lt;Me la-u kpunji tre ri injo ran gra ri kpanchison Izhi ran tse wa ngɨzhi-u ri ima nga Yuu. <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />Ikya riwa nji ngiji-u a he nji, ama ikya riwa Izhi ngiji-u a he Yuu nye. <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />Ran ti sisiri ritu riwa me tre yi ri tse wa bru ngɨzhi yi wawu mbi ran. <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />Ngungu ri fu bubu riwa isron wan wa; wu ye wuka wo chu wan riwa ari chu, ama wura to bubu riwa a zhu ran, ko wu ri to bubu riwa ari hi ran. Nghamba nye a he ri ko ngaa riwa Iyu nye ngɨzhi.&gt;&gt;<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />Nikodimu ka miyen Yeso ri,&lt;&lt;Ari tise ko ran he ngamba?&gt;&gt;<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />Yeso ka nyɨme ri Nikodimu ri,&lt;&lt;A wu wu he rinkon nji ri tsro ri Israila, nga wu ran to kyawa wanyi ran? <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />Kpunji tre me la-u, ki tre kya riwa ki to ri si nye, kiri ri la yi kya riwa ki to, ka hu ri ngamba bi kambi ri kpa kya riwa ki la yi. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />Me tre ri yi ritu bibi kyawa wawa wa ri mgbumgblume nyi, ama bi ran kpa nyɨme ran ko bi tise ko bi ri kpa nyɨme ka me la yi kyawa wawa wa ri shu? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />Ngha njo ran hon hi shu dzari rina, ara ame vren nji ri kankshi won riwa me gɨzhi ri zhu ri shu mu ye.&gt;&gt;<verse eid="JHN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14" />Bibi riwa Musa a nzu kya riwa a zhu manzɨrama ban shu rimi ji, ngamba nye wa nzu vren nji, <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />ritu nji riwa a kpa nyɨme ri wu ari fe son riwa a ran ri kre ran. <verse eid="JHN 3:15" /><verse number="16" style="v" sid="JHN 3:16" />Ritu Izhi nyɨme mgbumgblume bran a tanji ka vren wan wɨlo riri de, ritu ko ngan riwa a kpanyɨme ri wu no ran kuu ran, ama no fe vri riwa a ran ri kre ran. <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />Izhi a ran tru vren wan ye mgbumgblume ritu no ye bla tre ri wa ran, ama ritu no mgbumgblume no fe kpachuwo ritu wan. <verse eid="JHN 3:17" /><verse number="18" style="v" sid="JHN 3:18" />&lt;&lt;Wawa wa kpanyɨme ri vren Izhi wa ran bla tre ri wu ran. Ama nji riwa a ran kpa nyɨme ri wu ran wa bla tre ri wu-e, ritu riwa a ran kpa nyɨme ri nde vren Izhi ngbɨreriri-a ran. <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />Ngye bibi riwa ibla tre-a he-en, ikpan gra ri mgbumgblume, ama nji wa kpanyɨme ri bu han kpan ritu ikya riwa wa ti iwawu wa he riwa bu nye. <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />Inji riwa ari ti kya riwa a ran tsra ran, ari kawan ri kpan tsu a ran ye ri tsu ri kpan ran ritu no meme ti wan no ran ngaran yo ri raa ran. <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />Ama nji riwa ari ti ndindi ti ari ye ri tsu kpan ritu no wa to ritu ikya riwa ari ti a he ri dzon Izhi nye.&gt;&gt;<verse eid="JHN 3:21" /></para>
  <para style="s">Itre Yonana ritu Yeso</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />Kugon rinyi, Yeso ri miri ndu wan wa hi ri meme Yudiya, a son ri wa ri bubu wan ri vi hari ran son nji tu ri ima. <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />Yohana a ran son nji tu ima ri Aino kusan Salimi ritu iima a he bran ri bubu wan. Inji wa ka sondu ran ye ri wu ka ran son wa tu ri ima. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />Ikya nyi a ti ri ko wa yo Yohana rimi ko trenji. <verse eid="JHN 3:24" /><verse number="25" style="v" sid="JHN 3:25" />Imba imiri ndu Yohana wari waka gra ri janyu ri nji Yahuda ri ritu tre ngla wa kpi nga tsiri. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />Imba imiriko Yohana wa ye riwu wari tre ri,&lt;&lt;Inji ri tsro, nji riwa bi ran he imbi-u kugran nne ri Urdu ri wa a wu ri tu wen wu tre ritu wan? To ngye ngan ari son nji tu ri ima-on, kpunji ko ngan ri hi ri wu.&gt;&gt; <verse eid="JHN 3:26" /><verse number="27" style="v" sid="JHN 3:27" />Yohana ka tre riwa ri,&lt;&lt;Injo ran ri fe kya ran tsede Izhi ka no. <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />Biyi kyumbi bi he to riwa me wa me ri tre ri,&lt;A ran he ame nye me he Kristo ran ama wa ti wen ndu nye no wen me gbuchi ran ye riwu.&gt; <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />Ri roo ri gran, ronron nye he ri waa sa-a ikpan ron waa riwa a he ri bubu gran ari son kpen ran wo kya riwa iron wasa ri tre. Ari ti kinklan sron inde iron waasa tre a wo ran wan, ri ngamba nye kinklan sron won ri tsra, <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />Wawu Yeso ri kri mgbemgben riwa ari sho ri mkpen nga ame me gɨzhi ri mkpen-won.<verse eid="JHN 3:30" /></para>
  <para style="s">Wawu riwa a zhu ri Shu Ye</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />Yeso riwa a zhu ri shu a han ko ngan, riwa a zhu ri mgbumgblume, ritu ari tre tre wan riwa ri mgbumgblume nye.Ama wawu riwa a zhu ri shu a han ko ngaa. <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />Ritu wawu ri la kya riwa a wo ran to nye, ri ngamba injo ran he riwa a kpa tre wan ran. <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />Ama nji riwa a kpa tre wan, a tsro ri Izhi he ri kpunji tre. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />Wawu riwa Izhi ti-u ndu ye, ari la tre Izhi nye ritu Izhi no Yuu wan riwa a ran he ri yitu ran. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />A ti vren nyɨme-u ran ka ko ngye chuwo wu ri wo wan. <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />Inji riwa a kpanyɨme ri vren-a a he ri son riwa a ran kre ran; nji riwa a kawan ri vren-a a ran son ran tsede ifu Izhi ri he ri wu.&gt;&gt;<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">Yeso imba Waa Samariya ri</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />Riwa wa nji Farisa wa wo ri Yeso ri fe mirindu ran ri son wa tu ri ima ri han Yohana. <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />Ama a ran he Yeso nye a ran son wa tu ima ri tuwan ran a he mirindu wan nye. <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />Rwa Yeso a wo tre-a, ran ka meme Yudiya don, ran bru hi Galili; <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />riwa a he nkon ran hi Galili ran hu ku Samariya. <verse eid="JHN 4:4" /><verse number="5" style="v" sid="JHN 4:5" />Imba ka ye ri gbu ri rimi Samariya riwa wa yo nde wan ri Saika, igbu-a a he kusan ŋɨma meme riwa Yakubu a ka no vren wan Yusufu riwa a he sisienmu. <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />Ri bubu wan nye juju ima Yakubu riwa wa shi a he. Riwa Yeso a kumbra ri zren ka kuson ri kusan ima riwa wa shi-a. Rinyi a he ri gbege ji nye.<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />Imba iwaa ri ka ye riwa a he vra Samariya a ye riwa ari fon ima, Yeso ka tre riwu ri,&lt;&lt;Ti ima no wen me so.&gt;&gt;<verse eid="JHN 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 4:8" />Imirindu wan wa hi mi gbu bubu riwa wa reri.<verse eid="JHN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />Iwa Samariya-a ka tre ri Yeso ri,&lt;&lt;A wu riwa wuhe nji ri Yudiya wu tise wuri ibrewen ima ame riwa me he waa Samariya?&gt;&gt;Ritu ikyari ran ka wa nji Yahuda kabru iwa Smariyawa ran.<verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />Yeso ka tre ri wu ri,&lt;&lt;Wari tre ri wu to de riwa Izhi nga nji riwa ari tre riwu ri,&lt;No we ima&gt; Wuri bre wu, wawu ran no-u ima riwa ari no-u vri.&gt;&gt; <verse eid="JHN 4:10" /><verse number="11" style="v" sid="JHN 4:11" />Iwa-a ka tre ri Yeso ri,&lt;&lt;Inji ri nkon&lt;&lt;, Wu ran he ri kya ri ta ima ran iima nyi kyen ron wu fe ima ri de vɨri ri minyi? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />Wu han timbu Yakubu riwa a ka ima don rita ki fon wawu ri kankshi wan ri miri wan ri wa ntɨma wan wawa wa so ima rimi wan?&gt;&gt;<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />Yeso ka tre riwu ri,&lt;&lt;Inji riwa a so ima mba ila ri bru ti-u. <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />Ama nji riwa ari so ima riwa ame me de ilaa ran bru ti-u ngaran hi ri kren vi iima riwa me no ari he sii ima riwa ari ran zhu rimi wan riwa a ran kre ran.&gt;&gt; <verse eid="JHN 4:14" /><verse number="15" style="v" sid="JHN 4:15" />Imba iwa-a ka tre riwu ri,&lt;&lt;Inji rinkon no wen ima-a ritu no laa no ran bru ti wen ngaran, nga riwa men ran bru ye rinyi meri fon ima nga ran.&gt;&gt; <verse eid="JHN 4:15" /><verse number="16" style="v" sid="JHN 4:16" />Yesu ka tre riwu ri,&lt;&lt;Hi wuri yo ron wen bi ri ye inyi.&gt;&gt;<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />Imba iwa-a ka tre ri,&lt;&lt;Ai me ran he ri ronron ran, Yeso ka tre ri,&lt;&lt;Wu la kpunji tre riwa wu tre ri wu ran he ri ronron ran. <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />Ritu kpunji ri kpunji wawu he ri wu gran ronron ti ton, riwa bi he imbi-u dzidzan a ran he ron wen ran.&gt;&gt;<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />Iwa-a ka ka tre ri Yeso ri,&lt;&lt;A wu nji ri nkon, me to wuhe nji ri la tre Izhi. <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />Wati mbu wa kɨbu mgbazhu ri Izhi ri mgblu nyi. Ama biyi nji Yahuda bi tre ri a he ri Urushelima nye a he riwa wa kɨbu mgbazhu ri Izhi.&gt;&gt; <verse eid="JHN 4:20" /><verse number="21" style="v" sid="JHN 4:21" />Yeso ka tre ri wu ri,&lt;&lt;Iwa riko kpa nyɨme ri kya riwa me la wu, ivi riye riwa nji wana kɨbu mgbazhu ri A ti ritu gashi nyi ka Urushelima ran, <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />Biyi wa nji Samariya bi ran to kya riwa bi kɨbu mgbazhu riwu ran. Ama kita nji Yahuda ki to kya riwa ki kɨbu mgbazhu riwu ritu ikpa chuwo zhu ri nji Yahuda nye. <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />Ama ivi ri ye nga a ye-e riwa wawa wa hu Izhi ri sron riri wa kɨbu mgbazhu ri Bachi ri sron riri ritu ti riwa bibi wanyi nye no wa kɨbu mgbazhu ri wawu. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />Izhi he Yuu nye ri wawa wa kɨbu mgbazhu riwu no wa kɨbu mgbazhi riwu rimi Yuu nga rimi kpunji.&gt;&gt;<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />Iwa-a ka tre ri Yeso ri,&lt;&lt;Me to Kristo ari ye ri wa tre riwu ri a he Kristo iaye ari lata kon ngye.&gt;&gt;<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />Yeso ka tre riwu ri,&lt;&lt;Ama riwa me tre riwu nye me he wawu.&gt;&gt;<verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />Riwa wa kre tre-a nga mirindu wan waka ye wa ti sisiri riwa wa to ka ari tre mba waa. Ama injo a ran he riwa ari miyen-u ri,&lt;&lt; Wu wa ngye ka wu tre ngye imbi-u?&gt;&gt;<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />Iwa-a ka ka mbuwari wan chuwo ri bubu wan ran gra rimi gbu ran la nji ri, <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />&lt;&lt;Ye yi ye to nji riwa a la wen kyawa wawa me ti wa dzari! ka aya he nji nyi nye he Kristo?&gt;&gt; <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />Imba wan nji waka zhu ri ko wawu ye ri Yeso. <verse eid="JHN 4:30" /><verse number="31" style="v" sid="JHN 4:31" />Wa he rimi ngamba, imirindu Yeso waka bre wu,&lt;&lt;Inji ri tsro ri bi ri.&gt;&gt; <verse eid="JHN 4:31" /><verse number="32" style="v" sid="JHN 4:32" />Ama Yeso ka tre ri wa ri,&lt;&lt;Me he ri bi ri ri riwa me ri riwa bi ran to kyari ri tu wan ran.&gt;&gt; <verse eid="JHN 4:32" /><verse number="33" style="v" sid="JHN 4:33" />Imba imrindu wan waka miye ngamba ri,&lt;&lt;Ka injo ngiji rii ye no kya?&gt;&gt; <verse eid="JHN 4:33" /><verse number="34" style="v" sid="JHN 4:34" />Yeso ka tre ri wa ri,&lt;&lt;Irii won nye&lt;&lt; He no wen ti kya riwa A ti won ti wen ndu no wen ye ti-u, no wen ti ndu wan kre. <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />Aran don huwa nza nye riwa wa sren kpi ran? Ama me la yi mɨlan ya wa zhu mbi wa wiri wari he ri sren ron. <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />Inji wa sren wa fe wamba nga ran kɨma nji riwa wa he ka ikpi riwa wa ki hi ri vri riwa a ran kre ran, ritu no nji riwa a chu nga nji riwa a sren wa ngɨri haha mba. <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />Ri nyi nye ikɨbu tre nyi he kpunji iri,&lt;Inji ri ri chu nga nji ri ri sren. <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />Me ti yi ndu no yi sren kya riwa bi ran so yaa ritu wan ran wari wa so yaa biyi bi ye rii rimi yaa riwa wa ti-a.&gt;&gt;<verse eid="JHN 4:38" /></para>
  <para style="s">Wa Nji Samariya wa Kpanyɨme</para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />Wanji Samariya kigbu wa kpa nyɨme riwu ritu tre wan riwa iwaa-a a la,&lt;&lt;A la we ko ngye riwa me ti-u dzari.&gt;&gt; <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />Riwa wa nji Samariya wa ye riwu waka bre wu ri no son ri wawa, nga ka son ri wa ti vi hari. <verse eid="JHN 4:40" /><verse number="41" style="v" sid="JHN 4:41" />Wa nji kigbu waka kpa nyɨme ri Yeso ritu tre wan.<verse eid="JHN 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 4:42" />Imba wanji Samariya waka tre ri waa ri,&lt;&lt;Zizan ki kpa nyɨme a ran he ritu kya riwa wu la ta ri ka nkshe ran ritu kita ngawen ki wo ri tumbu, ki ri kpa nyɨme ri wawu nji nyi nye ri kpa mgbumgblume nyi chuwo.&gt;&gt;<verse eid="JHN 4:42" /></para>
  <para style="s">Yeso a Den Vren nji Rinkon Kpa chuwo</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />Kugon vi hari-a Yeso a wulunde ri meme Samariya ran ka hi Galili. <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />Ritu Yeso ri tuwan a tre dzari ri,&lt;&lt;Inji ri la tre Izhi ran ri fe mkpen ri gbu wan ran.&gt;&gt; <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />Riwa a ka zhu ri Galili wa nji Galili waka kpa woo hari ritu wawa nga wen wa hi ro ri dza gran ri Urushelima, waka to kya riwa Yeso a ti wa iwawu.<verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />Imba Yeso ka bru kɨma hi ri kana riwa Galili ri bubu riwa a kɨma ima nji ti ima ri roo. Ri bubu wan nji ri kon meme ri a he riwa ivren wan a ran he ri sii ran ri Kafarnau. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />Riwa nji-a a wo ri Yeso a zhu ri ri Yudiya ri Galili imba ka hi riwu ran bre wu ri no hi ran den vren wan riwa a ran he ri nyu kuu. <verse eid="JHN 4:47" /><verse number="48" style="v" sid="JHN 4:48" />Yeso ka kpanyɨme riwu ri,&lt;&lt;Inde bi ran to kya ri de sisiri nga kya riwa bi to risi ran bi ran ri kpanyɨme ran ko tsawen.&gt;&gt; <verse eid="JHN 4:48" /><verse number="49" style="v" sid="JHN 4:49" />Inji rinkon ri meme-a ka tre ri Yeso ri,&lt;&lt;Inji ri nkon ye kɨi ritu no vren won no ran kuu ran.&gt;&gt; <verse eid="JHN 4:49" /><verse number="50" style="v" sid="JHN 4:50" />Yeso ka tre riwu ri,&lt;&lt;Hi ngawen ivren wen ri nawo.&gt;&gt; Inji-a ka kpanyɨme ri kya riwa Yeso a la-u-a ran hi ngawan. <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />Riwa a he rimi hi ko wan imba imiriko nji-a waka ye fe wu ri nkon wari tre riwu ri,&lt;&lt;Ivren wen fe sii.&gt;&gt; <verse eid="JHN 4:51" /><verse number="52" style="v" sid="JHN 4:52" />Imba ka miyen wa ri ivi ritan nye a gbuchi ran fe sii? Wa ka tre ri wu ri,&lt;&lt;Irren ri ji nye ikpa-a a ka-u chuwo. <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />Imba A ti vren-a ka to ri a he tsra ri vi riwa Yeso a la-u-a ri,&lt;&lt;Hi, ivren wan ri nawo.&gt;&gt;Inji-a nga wa ko wan wawu waka kpanyɨme ri Yeso. <verse eid="JHN 4:53" /><verse number="54" style="v" sid="JHN 4:54" />Rinyi nye a he kya ri de sisiri ri hari riwa Yeso a ti kugon riwa a ka Yudiya don ran hi Galili.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">Yeso a den nji ri lilo mkpuzhu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />Kugon rimba, Yeso ka hi ri Urushelima ritu roro ri tsitsri vi riwa nji Yahuda. <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />Ri Urushelima juju ima ri nyun nkon tra ri riwa wa yo wu ri nkon ntɨma riwa wa ti bru mgbɨreton kagon wan riwa inde wan ri rɨme Hibruniyawa a he Betazda. <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />Rimi bru nye wa lilo wa mfyen, wa mkpuzhu nga wa gblu kpa kigbu wasi kakru ri bubu wan. <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />Imiri ko Izhi wasi ye ri bubu wan ri vi ri vi wari ran chu ima-a nga nji riwa a ye gra rimi ima-a gbuchi ko bibi lilo bibitan riwa a he ri wu ari fe si. <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />Inji ri lilo ri a he riwa a ti se setra don tandra a ran to zren ran. <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />Riwa Yeso a to-u ka a kakru imba ran to ri a ti vi hari ri bubu wan,Yeso ka miyen-u ri,&lt;&lt;Wu wa wuri fe si?&gt;&gt;<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />Inji ri lilo-a ka nyɨme ri Yeso ri,&lt;&lt;A wu nji rinkon me ran he ri nji riwa ari dzon wen no wen me hi gra rimi juju ima-a ri vi riwa wa miri ko Izhi wa chu ima-a ran, ka me wa meri gra in jo ri nkan ri ye gra gbuchi ri moo.&gt;&gt;<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />Imba Yeso ka la-u ri,&lt;&lt;Wulunde kri nde wu ri ban blaa wen wuri zren.&gt;&gt; <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />Ri bubu wan nji-a ka fe sika ban blaa wan ran zren.</para>
  <para style="p" vid="JHN 5:9">Ama chachu wan a he chachu sonvri riwa nji Yahuda. <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />Imba nji Yahuda-a waka tre ri nji riwa wa den kpa chuwo ri,&lt;&lt;Luwa he vi son vri bibi riwa doka Musa tre ri a ran tsra riwa wu ban blaa wen luwa ran.&gt;&gt;<verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />Inji-a riwa wa den ka lawa ri,&lt;&lt;Inji kiwa a den wen nye la wen ri me ban blaa won meri hi ngawon.&gt;&gt;<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />Waka miyen-u ri&lt;&lt;Ingaa nye he nji mba riwa a tre ri no ban blaa wen wuri zren?&gt;&gt;<verse eid="JHN 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13" />Ama nji-a ka ran to ran ritu Yeso a kado gra rimi jɨbu nji.<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />Ri vi ban kusi tsawen Yeso ka fe nji-a ri ko Izhi ran tre wu ri,&lt;&lt;To mba, wu to wu fe si-e, ka ti meme ti chuwo ritu no kya riwa a meme han rimba no ran fe wu ran.&gt;&gt;<verse eid="JHN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15" />Imba nji-a ka hi ran ka la wa rinkon wa nji Yahuda ri Yeso nye den wawu.<verse eid="JHN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 5:16" />Imba wa rinkon wa nji Yahudan waka gra no Yeso yaa ritu riwa a ran den nji ri chachu vi sonvri. <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />Ama Yeso ka la wa ri,&lt;&lt;Bibi riwa A ti won ri sondu ti ndu ame ngawen me ti ngamba.&gt;&gt;<verse eid="JHN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18" />Itre Yeso ka no nji Yahuda-a wa wa wari wuu Yeso wa tre ri a ran ritu a ka wan ri hu doka ri vi sonvri katre ran ama a he ri Izhi he A ti wan nye ko a ka ngawan ri kabru ri Izhi nye mba.<verse eid="JHN 5:18" /></para>
  <para style="s">Mgbemgbren riwa Vren</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />Yeso ka tre wa ri,&lt;&lt;Me la yi kpunji ivven ran to ti kya ri tuwan ran ari ya kya riwa iti wan ti ri ko ran ti bibi wan. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />A ti ri nyɨme vren ran ri tsro-u kya riwa wawu ri tu wan ri ti ari tsrou ndu wawa wa han wanyi ritu bi ri ti sisiri. <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />Bibi riwa A ti ri ta nji shɨme ri kuu ran no wa vri ngamba nye ivren ngawen ri de vri ri nyi riwa isron wan nyɨme-u. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />A ti ran ri bla tre ri njo ran ama a no vren gbengbren wawu ri bla tre ri ko ngaa, <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />ritu no ko ngaa no vren wen mkpen bibi riwa wa no A ti nji riwa a ran no vren wan mkpen ran a ran no A ti riwa a ti vren wan ndu ye ran.<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />&lt;&lt;Me la yi kpunji tre nji riwa ari wo tre won nga ran ri kpanyɨme ri Izhi riwa a ti wen ndu ari fe vri riwa a ran kre ran, wa ran no yaa ran ritu a jɨbu ri kuu ran gra rimi vri. <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />Me la yi kpunji tre ivi ri ye riwa a ye-e riwa wawa wa kuu wa wo rann vren Izhi nga wawa wa wo wa son ri sii. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />Bibi riwa A ti ri tuwan he nchi vri nye ngamba nye a no vren wan no he nchi vri ngawen. <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />Ngha Izhi no gbengbren ri bla tre-a ritu a he vren nji nye. <verse eid="JHN 5:27" /><verse number="28" style="v" sid="JHN 5:28" />Ran ti sisiri ritu tre nyi ran, ritu ivi ri ye riwa wawa wa he ri bubu gru wa wo ran wan, <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />wari zhuu ri bubu gru ye, wawa wa ti kya ndindi wa tashɨme wari son ri si, ama wawa wa ran ti kya riwa a tsra ran wa tashɨme nga wa no wa yaa.<verse eid="JHN 5:29" /></para>
  <para style="s">Itre Ritu Yeso</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30" />&lt;&lt;Ame ri tu won me ran to ti kyari ran me bla tre won bibi riwa Izhi la wen me bla. Ritu a ran ti won nye me hu ran, ama a he ti nji riwa a ti wen ndu nye me hu.<verse eid="JHN 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />&lt;&lt;Ka me la tre ritu ngawon a ran he riwa a tsra ran. <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />Ama nji ri he riwa ari la tre ritu won nga me to ri itre-a riwa ari tre ritu won ri he kpunji. <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" />&lt;&lt;Bi ti Yohana ndu nga a la tre ri kpuunji. <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />Kau ri ngamba me ran yosron ri la trenji ran me tre rimba ritu no nji no wa fe kpachuwo. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />Yohana a he ka iwulu a ran gon ran ran kpan nga bi ran wa bi ri ri ro kpan wulu wan vi tsawen. <verse eid="JHN 5:35" /><verse number="36" style="v" sid="JHN 5:36" />Ama me he ri nji riwa ari tre ritu won riwa a han riwa Yohana a tre ritu won: Ikya riwa me ti riwa A ti won no wen me ti rinyi he kya riwa ari tre ritu won nga ran tsro ri A ti won ti wen ndu. <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />Ngha A ti riwa a ti wen ndu wawu nga wen a tre ritu won. Bi ran wo wan zari to ran ko ka bi to si wan to ran, <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />nga bi ran ngɨzhi tre wan ri sron ran ritu bi ran kpanyɨme ri nji riwa a ti-u ndu ran. <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />Bi kra mbe Izhi ritu bi yonga bi fe vɨri riwa a ran ri kre ran. Ngha imbe-a tre ritu won, <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />Kau ri ngamba bi kambi ri ye ri me bi ri fe vɨri.<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />&lt;&lt;Me ran ri wa gbɨre riwa nji ran. <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />Ama me to bibi nji riwa bi he nga me to ri bi ran nyɨme Izhi ri sron mbi ran. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />Me ye ri gbengbren A ti won ama bi kambi ri kpa wen; nma ka injo ri nkan ye ri gbengbren riwa ma bi kpa nji-a, <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />Bi wa bi ri kpa gbɨre ri ngambi ama bi ran ri wa bi ri kpa gbɨre ri nji riwa wawu ri nkanshi wan he Izhi ko, bi ti ri se ko bi ri kpanyɨme ri me, <verse eid="JHN 5:44" /><verse number="45" style="v" sid="JHN 5:45" />&lt;&lt;Ran yonga ri ame nye me ngɨzhi tre mbi hi la A ti won ran Musa riwa bi yosron mbi ri wu wawu nye ri ngɨzhi tre mbi hi. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />Wari tre ri bi kpanyɨme ri Musa, bi ri kpany;ime ri me ngawen r itu a ngan kyawa ritu won. <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />Ama riwa bi ran kpanyɨme ri kya riwa a ngan ran ko bi ti se bi ri kpanyɨme ri kya riwa me tre?&gt;&gt;<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">Yeso a no nji ngo ton ri</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />Kugon rinyi Yeso a hi ri gran nne ri Galili riwa wa yo-u ri nne Tiberias ngaw een. <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />Ijɨbu nji waka hu ritu wa wo bibi kya ri de sisiri riwa a den wa lilo. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />Yeso ka hi ri tu gashi ran ka son iwawa miri ndu wan. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />Ivi ro ri dza gran ka ye hwɨre.<verse eid="JHN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 6:5" />Yeso ka nzu si ya ran to jɨbu nji wana ye ri wu imba ka miyen Filibu ri,&lt;&lt;Ri minyi nye ki fe ri bran riwa ki no nji wa nyi wawu mba?&gt;&gt; <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />A tre rinyi ritu ran tsra Filibu nye, ama rimi sron wan a to kya riwa ari ti-e.<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />Filibu ka nyɨme ri,&lt;&lt;Ko no ko ngaa no fe tsawen, ari ban nkren gbigba hari riwa ki rejujuyɨmo bran!&gt;&gt;<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />Iri rimi miri ndu wan riwa inde wan a he Andarawus vayi sima Bitrus, ka tre ri, <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />&lt;&lt;Ivren ri tsitsa he nyi riwa a he ri jujuyɨmo mgbɨreton nga lambe hari. Ama a ran ri ke nji wanyi wawau ran.&gt;&gt;<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />Yeso ka la miri ndu wan ri,&lt;&lt;No nji wamba no wa son mme.&gt;&gt;Ri bubu wan giga a he imba nji-a waka kuki ri meme nji wawa wa he ri bubu wan wa he ronron ngo ton. <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />Yeso ka ban juju yɨmo-a ran ngɨri ri Izhi ran ka ga nji wawa wa he ri bubu wan, ngamba nye a ti ri lambe-a me nga wawu mba waka ri bran bibi riwa wa wa.<verse eid="JHN 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 6:12" />Riwa wa hwɨshi wawumba Yeso ka la miri ndu wan ri,&lt;&lt;Taan zhuzhuwan riwa a dongbron, no ta ran no time ran.&gt;&gt; <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />Imba imiri ndu Yeso waka tan zhuzhu wan rimi mgbɨreton riwa nji wa ri don, wa tan shu rimi sisen wuru don hari.<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />Ri to kya ri de sisri nyi riwa Yeso a ti nji ri bubu wan waka tre ri,&lt;&lt;Kpu nji tre rinyi he nji ri la tre Izhi riwa ari ye ri mgbumgblume!&gt;&gt; <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />Riwa Yeso a to ri nji-a wa ran wa wari ye vu ri gbengbren no he chu imba ka bru hi ri tu gashi ri nkankshi wan.<verse eid="JHN 6:15" /></para>
  <para style="s">Yeso a Zren ritu Mma</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />Riwa Yawulu a ti imiri ndu Yeso waka gre hi ba nne, <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />Ri bubu wan nye bubu ka gbuchi ran ti bu, nga Yeso ka ran ye ri wa ri nyu nne rina imba imiri ndu wan waka gra rimi mvu ima wari ran rugran ran hi kafarau. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />Imba inchon gungu ka ran tifu ran kpa ima ran pisi. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />Imiri ndu wan-a wa tru mvu ima-a hi ri bubu riwa a ke dza gbigba tanren hi ri tamgban, imba waka to Yeso ri dzren ri tu ima, a ran ye ku bubu mvu ima-a nga wawa wa ran ti sisiri. <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />Yeso ka tre wa ri,&lt;&lt;Ran ti sisiri ran a he ame nye!&gt;&gt;<verse eid="JHN 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 6:21" />Imba waka nyɨme no gra rimi mvu ima-a nga ri bubu wan waka to ka mvu ima-a ka zhu ri bubu riwa wa hi.<verse eid="JHN 6:21" /></para>
  <para style="s">Inji wa wa Yeso</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />Riwa imbɨrea kpan imgbron nji wawa wa kuki ri gran nna-a waka milan ya wari to iri a he mvu ima riri nye riwa a ye ri bubu wan. Wa to iri Yeso a ran gra rimi mvu ima-a ri miri ndu wan ran, imiri ndu wan nkankshi mba nye wa hi. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />Ama mvu ima wari wa zhu ri Tibariya ye kukri kusan bubu riwa nji wa ri juju yɨmo-a, kugon riwa Bachi a ngɨri ri Izhi. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />Riwa ijɨbu nji-a wa to ri Yeso nga miri ndu wan wa ran he ri bubu wan ran, waka gra imi wa mvu ima-a wari hi ri Kafarnau wari ran wa Yeso.<verse eid="JHN 6:24" /></para>
  <para style="s">Yeso he ka Jujuyɨmo ri de vɨri</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />Riwa nji-a wa fe Yeso ri gran nne-a waka tre ri wu ri,&lt;&lt;Inji ri tsro shitan nye wu ye ri nyi?&gt;&gt;<verse eid="JHN 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26" />Yeso ka nyɨme ri wa ri,&lt;&lt;Me la yi kpunji tre bi wa wen ritu bi ri jujuyɨmo nga bi ri fe kya riwa bi wa, a ran ritu bi to kya ri de sisiri riwa me ti ran. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />Ran ti ndu ritu ri riwa ari time ran, ama bi ti ndu ritu ri riwa ari son hi ri kre vi. Rinyi nye he ri riwa ivren nji ri no yi, ritu Izhi A ti a no wen gbengbren me ti wa.&gt;&gt;<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />Imba waka miyen-u ri,&lt;&lt;Ki tiri se kiri to kya riwa Izhi ri wa ki ti?&gt;&gt; <verse eid="JHN 6:28" /><verse number="29" style="v" sid="JHN 6:29" />Yeso ka nyɨme ri wa ri,&lt;&lt;Ikya riwa Izhi ri wa no yi ti a he no yi kpanyɨme ri nji riwa wawu ti-u ndu.&gt;&gt;<verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />Waka tre ri wu ri,&lt;&lt;Ikya ri de sisiri bibi tan nye wu ti riwa ki to kiri kpanyɨme ri wu? Ingye nye wu ti.? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />Wa ti wa timbu wa ri manaa ri tsutsu ji bibi riwa itre Izhi tre ri,&lt;Izhi no wa juju yɨmo riwa a zhu ri shu no wa ri&gt;&gt;&gt;<verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />Yeso ka tre ri wa,&lt;&lt;Me la yi kpuji &lt;&lt;Ikya riwa Musa a kano yi a ran he juju yɨmo zhu ri shu ran, a he Ati won riwa a no yi juju riwa a zhu ri shu. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />Jujuyɨmo riwa Izhi de a he wawu riwa a zhu ri shu ye ran ye de vri ri mgbumgblu me.&gt;&gt;<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />Riwa wa wo ngamba, imba waka miyen ri&lt;&lt;Inji rinkon no ta tuju yɨmo nyi bla vi.&gt;&gt;<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />Yeso ka tre ri wa ri,&lt;&lt;Ame nye me he jujuyɨmo riwa ari no-u vri, wawa wa ye ri kpanyɨme ri me ilama ran ti wa ran. <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />Zizan me la yi ri bi to wen ama bi ran kpanyɨme ri me ran. <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />Ko ngaa riwa A ti won no wen, ari ye ri me, ame me ran dzuu ran. <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />Ritu me zhu rishu ye me ri ti kyawa riwa mo ran, ama kyawa riwa nji riwa a ti wen ndu ye. <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />Ngha ikya riwa nji riwa a ti wen ndu ye ri wa a he ri me ran no ko njo rimi wawa a ka wa no wen no kado ran, ama me ta wa shɨme ri kre vi. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />Ikya riwa A ti won ri wa a he iri no ko ngaa riwa a ti wen ran kpanyɨme ri wu no vri riwa a ran kre ran nga me ta wa shɨme ri chachu kre vi.&gt;&gt;<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />Nji Yahuda wawa wa he ri bubu wan waka gra muru nyu ritu a tre ri,&lt;&lt;Ame me he jujuyɨmo riwa a zhu ri shu ye me.&gt;&gt; <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />Imba wa nji-a waka tre ri,&lt;&lt;Inji nyi ran he Yeso ivren Yusufu riwa ki to ti wan kiri to yi wan ran, ko ari ti se ran la ta zizen ri wawu zhu ri shu ye?&gt;&gt;<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />Yeso ka nyɨme ri wa ri,&lt;&lt;Ka muru nyu rimi ngambi chuwo. <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />Inji wa ran ye ri me ran, tse A ti riwa a ti wen ndu gbi wa ye ri me nga ame me ta wa shɨme chachu kre vri. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />Wa la tre Izhi nye wa tsro wa&gt;Ko ngaa riwa a wo tre A ti ran ti ndu ri wu ari ye ri me. <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />Rinyi ran he ri ko ngaa to A ti ran, wawu riwa a zhu ri Izhi nye ka kre to A ti. <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />Me la yi kpunji tre, nji riwa a kpanyɨme ri me, a he ri vri riwa a ran kre ran. <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />Ame me he jujuyɨmo ri vri <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />Wa titimbi wa ri manaa ri tsutsu ji ama wa kuu, <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />Ama juju yɨmo riwa a zhu ri shu ye a he bibi riwa ka nji riwa a ri-u a ran ri kuu ran. <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />Ame me he jujuyɨmo ri vri riwa a zhu ri shu ye, ka wu ri jujuyɨmo nyi wu son hi ri kre vri, jujuyɨmo riwa me no yi nyi a he ka ikpa won nye, riwa me de ritu no mgbumgblu me no wa fe vri.&lt;&lt;<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />Imba nji Yahuda-a waka gra ri janyun ri fu ri ngamba wari tre ri,&lt;&lt;Inji nyi ri ti se ran no ta nɨma kpa wan tan?&gt;&gt;<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />Yeso ka tre ri wa ri,&lt;&lt;Me la yi kpunji ka bi ran tan nɨma vren nji nga bi ri so yii wan ran bi ran fe vri ri sron mbi ran. <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />Wawa wa tan nɨma won nga wari so yii won wa fe vri riwa a ran kre ran nga me ta wa shɨme ri chachu kre vi. <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />Wawa wa tan nɨma won nga wari so yii won wa son ri me nga ame me son rimi mba. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />Wawa wa tan nɨma won nga wari so yii won wa son ri me nga ame me son rimi mba. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />Bibi riwa A ti riwa ari vri ti wen ndu nga ritu wan nye me vri ngawen ngamba nye me nji riwa a tan nɨma won ari fe vri ritu won. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />Rinyi nye he jujuyɨmo riwa a zhu ri shu ye a ran bibi riwa wa titimbi wa ri ama wa kuu-a ran, wawa wa ri, jujuyɨmo nyi wa fe vri riwa a ran kre ran.&gt;&gt;<verse eid="JHN 6:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59" />Yeso a tre rinyi riwa a ran tsro ri bubu kabrutu nji Yahudari ri Kafanaum.<verse eid="JHN 6:59" /></para>
  <para style="s">Itre vri riwa a ran Kre ran</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />Wawa wa ran huu waka wo nganyi wari tre ri,&lt;&lt;Itsro nyi senkpa, ingaa ri sren ton riwu?&gt;&gt;<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />Yeso riwa a to iri wa muru nyun ri ngamba ritu wan imba ka miyen wa ri&lt;&lt;Itsro nyi no yi wa bi ri kambi ri me? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />Ko isron mbi ri he se ka bi to ivren nji bru kɨma ri hi ri bubu riwa a zhu ye? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />Iyu Izhi nye ri de vri. Ikpa ran he ri gbengbren nji ran ri ti kyari ran itre riwa me tre ri yi he wu Izhi nye nga vri. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />Ama wari mbi wa he wawa wa ran kpanyɨme ran.&gt;&gt;Ritu ri mimɨlan Yeso a to wawa wana kpanyɨme ri wu ran nga nji riwa ari ka wawu re. <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />Yeso ka bru tre ngaa ri wa ri,&lt;&lt;Ritu rinyi nye me tre ri injo ran ri to ye ri me ran tse A ti won no wa gbengbren no wa ye.&gt;&gt;<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />Ritu rinyi nye wawa wa hu Yeso kigbu wa kɨma gon ti-u, wa ran hu Yeso ngaran. <verse eid="JHN 6:66" /><verse number="67" style="v" sid="JHN 6:67" />Ka miyen miri ndu wan wuru don hari-a ri,&lt;&lt;Ngha biyi ngawen bi wa bi ri hi ngambi me?&gt;&gt;<verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />Sima Bitrus ka nyɨme ri,&lt;&lt;Bachi ri ngaa nye ki hi?Wu he ri tre riwa ari de vri riwa a ran kre ran. <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />Ngha zizan ki kpanyɨme ri wu he ri Tsitsri riwa a zhu ri Izhi ye.&gt;&gt; <verse eid="JHN 6:69" /><verse number="70" style="v" sid="JHN 6:70" />Yeso ka tre ri wa ri,&lt;&lt;Me zhu yi wuru don hari-a, ama iri mbi he meme nji!&gt;&gt; <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />Aran tre ritu Yahuda ivren Sima Iskariyo ritu wawu nye ri ka wen reko riri riwa a he rimi miri ndu Yeso wuru don hari.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">Yeso nga miri Vayi wan</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />Kugon rinyi Yeso a zren rimi gbu Galili a ran wa ran zren rimi gbu Yudiya ran ritu wa rinkon Yahuda wa wa wari wuu-u. <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />Ivi ri roro wa nji Yahuda a ye hwɨre, <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />Imba imri vayi Yeso waka tre ri wu ri,&lt;&lt;Ka bubu nyi don wuri hi ri Yudiya ritu no miri ndu wen no wa to kya riwa wu ti. <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />Inji wa ran ri rii kya riwa wa ti ran ka wa wa no ko ngaa no to wa. Riwa wu ti kyawa wanyi no mgbumgblume wawu no wa to-u!&gt;&gt; <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />Kau ri miri vayi wan ngawen wa ran kpanyɨme ri wu ran.<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />Yeso ka tre ri wa ri,&lt;&lt;Ivi won ran ye rina ama riyi ko vi ritan tsra ri yi. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />Mgbumgblume wa ran kamba ri yi ran, ama wa kamba ri me ritu me bibi meme ti riwa ari ti. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />Biyi hi ri bubu ro-a me ran ri hi ri bubu ro-a ran ritu ivi won ran tsra rina.&gt;&gt; <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />Yeso tre tre-a ran son ri Galili.<verse eid="JHN 7:9" /></para>
  <para style="s">Yeso ri bubu roro wa nji Yahuda</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />Kugon riwa imiri vayi Yeso wa hi ri bubu ro-a Yeso ka hi ri bubu wan ngawen ama a ran hi ri rira ran a hi ri yayɨbi. <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />Wa rinkon wa nji Yahuda-a wa ran wa Yeso ri bubu ro-a waka miyen ri,&lt;&lt;A he minyi?&gt;&gt;<verse eid="JHN 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12" />Rimi jɨbu nji-a nji wari wa ran tre ri yayɨbi ritu Yeso wari wa ran tre ri,&lt;&lt;A he nji dindi nga wari wa tre iri oon ari gyuru nji nye.&gt;&gt; <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />Ama injo a ran tre ritu wan zhu ran ran ritu wa ran ti sisiri wa rinkon wa nji Yahuda.<verse eid="JHN 7:13" /></para>
  <para style="s">Yeso a Tsro ri Bubu ro riwa nji Yahuda</para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />Iro-a a gon ran kre Yeso ka gra ri ko Izhi ran gra tsro. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />Wa rinkon wa Yauawa waka ti sisiri bran wari tre ri,&lt;&lt;A he rise ko nji nyi he ri bibi ti nyi riwa a ran kra-u ran?&gt;&gt;<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />Yeso ka nyɨme riwa ri,&lt;&lt;Itsro won ran he wa mo ran. A zhu ri nji riwa a ti wen ndu. <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />Ka injo ri yo sron wan ran ti kya riwa Izhi ri wa ari to ri itsro won zhu ri Izhi nye ka me tre ri wa mo. <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />Inji riwa ari tre riwa wiwiri wan ari ti ritu ran kpa gbɨre ri ngawan no nji riwa a ti-u ndu wawu he nji ri kpunji ikyari ri che ran he ri wu ran. <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />Musa a ran no yi doka Izhi ran? Ama injo a ran hu doka wan ran ritu ngye ko bi wa bi ri wuu wen?<verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />Ijɨbu nji-a waka nyɨme wu ri,&lt;&lt;Wu he ri bɨzhi Ingaa ri wa ran wuu-u?&gt;&gt;<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />Yeso ka tre riwa ri,&lt;&lt;Me ti kya ri de sisiri riri nga wawu mbi bi ti sisiri. <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />Ama ritu ngamba Musa a no yi fon nju ri miri mbi, rinyi a ran zhu ri wawu Musa nye ye ran ama a zhu ri wa ti watimbi bi fon nju ri miri mbi ronron ri chachu son vri. <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />Zizan ka wa fon vren nju ri chachu son vri ritu no wa ran ka hu doka Musa ran, ritu ngye ko bi ti fu ri me ritu me den nji ri lilo chachu son vri? <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />Ka bla tre ritu kya riwa bi to ri si chuwo bi ri bla tre ri kpunji.&gt;&gt;<verse eid="JHN 7:24" /></para>
  <para style="s">Yeso he Kristo nye</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />A kri ri bubu ri nji Urushelima waka miyen ri,&lt;&lt;Rinyi ran he nji riwa wa wa wari wuu-u-a ran? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />Ingye ngaa-u-en ari tre ri rira nga wa ran ri tre kya ri wu ran, nji Yahuda wa nyɨme iri a he Kristo? <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />Ki to bubu riwa nji nyi zhu ye, ama ka Kristo ri ye injo ran to bubu riwa a zhu ye ran.&lt;&lt;<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />Riwa Yeso a he rimi tsro ri tra bubu bre Izhi, ka tre mgbamgban ri,&lt;&lt;Een bi to wen nga bi ri to bubu riwa me zhu, me ran he rinyi ri tuwon ran ama wawu riwa a ti wen ndu a he kpunji biyi bi ran to-u ran, <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />ama ame me to-u ritu me zhu ri wu nye nga wawu ti wen ndu.<verse eid="JHN 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30" />Ri bubu wan wa wa wari vu Yeso ama injo a ran to bre wu wo ran ritu ivi wan a ran keran, <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />Ka hu ri ngamba wari rimi jɨbu nji a waka yosron ri wu wari tre ri,&lt;&lt;Ka Kristo ye ari ti kya wa de sisiri han nji nyi?&gt;&gt;<verse eid="JHN 7:31" /></para>
  <para style="s">Wa Vu Yeso</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />Farisa wa wo kya riwa ijɨbu nji-a wa ran tre ritu wan. Rinkon wa sro yii nga Farisa waka tru nji ri gben ri tra bubu ibreiri no hi ran vu Yeso. <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />Yeso ka tre ri,&lt;&lt;Me he ri yi ri vi tsa wen gyen nga me hi ri nji riwa a ti wen ndu. <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />Bi wa wen ama bi ran fe wen ran nga bubu riwa me he bi ran to ye ri bubu wan ran.<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />Wa rinkon nji Yahuda waka ran tre ri ngamba ri,&lt;&lt;Ri minyi nye nji nyi ri hi riwa ari tre ri ki ran fe wawu ran? Ari hi ri bubu riwa wa nji mbu wa shan ka ki rimi Helenawa nga wari ri tsro wa nji Helenawa? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />Ari tre ritu ngye nye iri,&lt;Bi wa wen ama bi ran fe wen ran&gt;Ngha &lt;Bubu riwa me he bi ran to hi ri bubu wan ran?&gt;&gt;<verse eid="JHN 7:36" /></para>
  <para style="s">Iima riwa ari de Vri</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />Chachu vi ri kremkpen riwa wa kre ro-a Yeso ka kri ran tre ri raan mgbamgban ri,&lt;&lt;Ka ila ima ri ti njo no ye ri me ran ye so. <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />Inji riwa a kpanyɨme ri me bibi riwa imbe Izhi tre &lt;Ibaa riwa ima ri de vri-a ri gmo kagon wan.&gt;&gt;&gt; <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />Ri ngamba ara tre ritu wu riwa wawa wa kpanyɨme ri wu wa ye kpa ivi ri ti ri vi-a wa ran no wa Yuu ran ritu wa ran gbre Yeso rina.<verse eid="JHN 7:39" /></para>
  <para style="s">Igaa Rimi wa Nji</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />Riwa ijɨbu nji wa wo tre Yeso, waka tre ri,&lt;&lt;Kpunji tre nji nyi he nji ri la tre Izhi nye?&gt;&gt;<verse eid="JHN 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41" />Wari waka tre ri,&lt;&lt;A he Kristo nye.&gt;&gt;Wari waka bru miyen nganga ri,&lt;&lt; Kristo ran zhu ri Galili. <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />Imbe Izhi a ran tre ri Kristo ri zhu ri gɨzhi wa chu Doda nga ri Batalami igbu riwa Doda ri son nye ye ran?&gt;&gt; <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />Imba isron jɨbu nji-a ka ga ti hari ritu Yeso <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />Wari wa wa wari vu-u ama injo aran to bre wu wo ran.<verse eid="JHN 7:44" /></para>
  <para style="s">Ika kpanyɨme wa Rinkon wa nji Yahuda</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />Ri kre wan nji wawa wana gben ri tra bubu ibrewaka bru hi ri wa rinkon wa sro yii nga Farisa wari miyen wa ri,&lt;&lt;Ritu ngye ko bi ran ngɨzhi-u gra rimi tra ran?&gt;&gt;<verse eid="JHN 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />Wa gben wa tre ri,&lt;&lt;Injo ran tre bibi riwa nji nyi tre zari ran.&gt;&gt;<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />Farisa waka miyen wa ri.&lt;&lt;Bi wa bi ri tre ri a gyuru yi ngawen?&gt;&gt; <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />&lt;&lt;Bi to rimi wa rinkon ko Farisa riwa a kpanyɨme ri wu zari? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />Ijɨbu nji wanyi wa ran to doka Musa ran ilaa nyu Izhi a he ri wa.&gt;&gt;<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />Iri rimi Farisa inde wan a he Nikodemus riwa a hi ri Yeso ri sen. A tre ri mgbron mba ri, <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />&lt;&lt;Bibi riwa doka mbu he, ki ran ri no nji Yaa ko kiri wo tre wan ko ingye nye a ti ran.&gt;&gt; <verse eid="JHN 7:51" /><verse number="52" style="v" sid="JHN 7:52" />Waka nyɨme ri,&lt;&lt;A wu nga wen wu he nji Galili? Kra mbe Izhi wu to ri nji ri la tre Izhi ran zhu ri Galili to zari ran.&gt;&gt;<verse eid="JHN 7:52" /></para>
  <para style="s">Iwaa riwa Wa Vu wa Mba Ronron</para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 7:53" />Imba ko ngaa ka hi ko wan<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s">Iwaa riwa Wa Vu wa Mba Ronron</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />Imba ko nga ka kɨma hi ko, ama Yeso a hi ri mgblu konkron Atile. <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />Ri bubu mibreri han wan Yeso ka bru hi ri ko Izhi. Inji wawu waka kagon wan ki, nga ka son meme ran gbuchi ran tsro wa. <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />Wa tsro doka Musa nga Farisa waka ngɨzhi waa ri riwa wa vu wa ran kru ngamba, imba nji-a waka no kukri ri kusi mba wawu, <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />nga waka tre ri Yeso ri, &lt;&lt;Inji ri tsro, wa vu waa nyi wa kru ngamba imba nji ri.&gt;&gt; <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />Doka Musa la ri bibi waa mba wa taa ri tita wuu, &lt;&lt;Ko a wu wu tre ri se?&gt;&gt; <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />Wa tre nganyi ritu wa ri ka don vu Yeso ri meme ti, ama Yeso ka dran ran ran ngan ri meme ri vren wo wan. <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />Riwa wa sondu ran miyen Yeso tre, ka nzu tu ran tre ri wa ri,&lt;&lt;Ingaa rimi mbi riwa a ran ti meme ti to zari ran no wawu no gbuchi ta waa-a ri tita.&gt;&gt; <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />Ka bru dran ri meme nganga ran ran ngan ri meme. <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />Riwa wa wo nganyi, waka shan kado yiyiri gbuchi ri wa rinkon hi ri wa kremkpen. Ka don Yeso ri nkankshi wan nga waa-a ri tsutsu jɨbu nji-a wa kukri. <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />Yeso ka nzu tu nde ran miyen waa-a ri,&lt;&lt;Iwaa, wawa wa wa-u ri tre-a wa he minyi?&gt;&gt; <verse eid="JHN 8:10" /><verse number="11" style="v" sid="JHN 8:11" />Iwaa-a ka tre ri, &lt;&lt;Inji rinkon, ba ko ri mba.&gt;&gt;Yeso ka tre ri waa-a ri, &lt;s&lt;Ame ngawen me ran wuu-u ran, hi ngawen ama ran bru ti meme ti ngaran.&gt;&gt;<verse eid="JHN 8:11" /></para>
  <para style="s">Yeso nye he Kpan Wulu Mgbumgblume</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />Yeso ka bru tre ri wa nji Farisa nganga ri, &lt;&lt;Ame nye me he kpan wulu mgbumgblume. Inji riwa a hu wen ari fe kpan ri vri nga a ran dzren rimi bu ran.&gt;&gt; <verse eid="JHN 8:12" /><verse number="13" style="v" sid="JHN 8:13" />Farisa waka la Yeso ri, &lt;&lt;Zizan, wu tre ritu ngawen; itre wen-a ran he kpunji ran.&gt;&gt; <verse eid="JHN 8:13" /><verse number="14" style="v" sid="JHN 8:14" />Yeso ka lawa ri,&lt;&lt;Itre riwa me tre ritu ngawon wa he kpunji nye, ko ri riwa me tre kyukyu won nye. A he ritu me to bubu riwa me zhu nga bubu riwa me hi, ama biyi bi ran to ran. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />Bi bla tre mbi bibi to riwa nji; ama ame me ran bla ri ko njo ran. <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />Ama wari tre ri me ti ngamba nye, ibla tre won ran he ri kpunji, ritu me ran he ri nkankshi won rimi wan ran; ki he imbu A ti riwa a ti wen ndu. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />A he rimi ngan doka mbi ri, itre riwa nji hari wa tre ritu wan ari he kpunji. <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />Ame me tre ritu ngawon, nga A ti riwa a ti wen ndu ri tre ritu won.&gt;&gt; <verse eid="JHN 8:18" /><verse number="19" style="v" sid="JHN 8:19" />Waka miyen Yeso ri, &lt;&lt;A ti wen he minyi? Yeso ka nyɨme ri wa ri, bi ran to wen ran ko bi ti se ko bi ri to A ti won, wari tre ri bi to wen bi ri to A ti won ngawen.&gt;&gt; <verse eid="JHN 8:19" /><verse number="20" style="v" sid="JHN 8:20" />Yeso a tre tre wanyi riwa a ran tsro ri ko Izhi, rimi tra hwi bubu riwa wa dzi nkren beko. Ngha injo ka ran to vu Yeso ran ritu ivi wan a ran ye ri ran.<verse eid="JHN 8:20" /></para>
  <para style="s">Bi ran to Hi ri Bubu Riwa me Hi ran</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />Yeso ka bru tre ri wa nganga ri,&lt;&lt;Me hi ngawon; nga bi wa wen, ama bi kuu rimi meme ti mbi. Bi ran ri to hi ri bubu riwa me hi ran.&gt;&gt; <verse eid="JHN 8:21" /><verse number="22" style="v" sid="JHN 8:22" />Imba wa rinkon wa nji Yahuda waka tre ri, &lt;&lt;A tre ri ki ran to hi ri bubu riwa wawu ri hi ran. Ari hi bubu wuu ngawan nye?&gt;&gt; <verse eid="JHN 8:22" /><verse number="23" style="v" sid="JHN 8:23" />Yeso ka nyɨme ri wa ri,&lt;&lt;Biyi bi he wa mgbumgblume ri meme nyi, ama ame me zhu ri shushu muu nye. Bi he wa mgbumgblume nyi, ama ame me ran he wa mgbumgblume ran. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />Ritu wan nye me la yi ri bi kuu rimi meme ti mbi. Ngha bi kuu rimi meme ti mbi ka bi ran kpanyɨme ri &lt;Me he nji riwa me tre ri me he ran.&gt;&gt;&gt; <verse eid="JHN 8:24" /><verse number="25" style="v" sid="JHN 8:25" />Waka miyen Yeso ri,&lt;&lt;A wu wu he ngaa nye?&gt;&gt; Yeso ka la ri,&lt;&lt;Ingye nye me la yi ri mimɨlan. <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />Kyawa kigbu wa he riwa me tre ritu mbi, nga kyawa kigbu riwa me no yi yaa ritu mba. Ama me la nji kya riwa me wo ri nji riwa a ti wen ndu kakre, nga ari la kpunji tre nye.&gt;&gt; <verse eid="JHN 8:26" /><verse number="27" style="v" sid="JHN 8:27" />Ama wa ran to ri Yeso ri tre ri wa ritu A ti nye ran. <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />Imba Yeso ka tre ri wa ri,&lt;&lt;Ka bi nzu vren nji ban shu, bi to ri &lt;Me he nji riwa me tre ri me he&gt;; Imba bi to ri me ran ri ti kya ri gbengbren won ran, ama me tre kya riwa A ti la wen ri me tre. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />Ngha A ti riwa a ti wen ndu a he ri me; a ran ka wen don ri nkankshi won ran, ritu me ti kya riwa ari si-u sron bla vi.&gt;&gt; <verse eid="JHN 8:29" /><verse number="30" style="v" sid="JHN 8:30" />Riwa Yeso a ran tre kyawa wanyi, nji kigbu wa kpanyɨme ri wu.<verse eid="JHN 8:30" /></para>
  <para style="s">Kpunji ri Kpa-u Chuwo</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />Imba Yeso ka tre ri wawa wa kpanyɨme ri wu ri, &lt;&lt;Ka bi hu tsro won, ka bi he miri ndu won ri kpunji. <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />Imba bi to kpunji, nga kpunji mba ri kpa yi chuwo.&gt;&gt; <verse eid="JHN 8:32" /><verse number="33" style="v" sid="JHN 8:33" />Waka tre ri Yeso ri,&lt;&lt;Kita ki he gɨzhi Ibrahi nye, nga ki ran he gran njo zari to ran. Ko ingye nye wu tre ritu ri, &lt;Ki fe kpachuwo&gt;?&lt;&lt; <verse eid="JHN 8:33" /><verse number="34" style="v" sid="JHN 8:34" />Yeso ka tre ri wa ri, &lt;&lt;Me la yi kpunji tre: nji riwa ari sondu ti meme ti a he gran meme ti. <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />Gran ran ri he vren ri ko iwawu ran, ama ivren ri he vren rimi ko hi ri kre vi. <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />Ka ivren kpa-u chuwo, imba wu fe kpachuwo kpunji. <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />Me to ri bi he gɨzhi Ibrahi. Ama bi kambi riwa bi ri wuu wen, ritu bi ran kpa tsro won ran. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />Me tre ritu kya riwa A ti tsro wen, ama biyi tre ritu kya riwa a ti mbi la yi.&gt;&gt;<verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />Waka tre ri wu ri,&lt;&lt;Iti mbu he Ibrahi.&gt;&gt;</para>
  <para style="p" vid="JHN 8:39">Yeso ka tre wa ri, &lt;&lt;Ka bi tre ri bi he miri Ibrahi kpunji, bi ri ti bibi kya riwa wawu ri ti. <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />Me he nji riwa me la yi kpunji tre riwa me wo ri Izhi, ama bi kambi riwa bi ri wuu wen. Ibrahi a ran ti kyari ngamba ran. <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />Bi ti kya riwa a ti mbi ti.&gt;&gt;Waka nyɨme wu ri, &lt;&lt;Izhi kyuwan nye he A ti riwa ki he ri wu, nga ki he miri wan wa kpunji.&gt;&gt;<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />Yeso ka tre ri wa ri, &lt;&lt;Wari tre ri Izhi he A ti mbi kpunji, bi ri nyɨme wen, ritu ame me zhu ri Izhi nye ye nga zizan me he ri nyi. Me ran ye ri gbengbren won nye ran, ama wawu nye ti wen ndu. <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />Ritu ngye ko bi ran ri to kya riwa me tre ran? A he ritu bi ran ri wo kya riwa me tre ran. <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />Bi he miri a ti mbi, Meme Nji, nga bi ri ri wa bi ri ti kya riwa a nyɨme-u. Zhu ri mimɨlan a he nji ri wuu nji nga a ran hu kpunji to zari ran, ritu kpunji a ran he ri sron wan ran. Ri vi riwa ari la tre ri che ari tsro bibi ti wan nye, ritu a he nji ri che nga a ti wa che ngawen. <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />Ama me la yi kpunji tre, nga ritu wan nye bi ran kpanyɨme ri me ran. <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />Ingaa rimi mbi ri tsro ri me ti meme ti? Me la yi kpunji tre ko ritu ngye ko bi ran kpanyɨme ri me ran? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />Inji riwa he riwa Izhi ari wo tre Izhi. Ama biyi bi ran wo ran ritu bi ran he wa Izhi ran.&gt;&gt;<verse eid="JHN 8:47" /></para>
  <para style="s">Yeso Ngha Ibrahi</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />Wa nji Yahuda waka miyen Yeso ri,&lt;&lt;Ki ran tre tsra ran riwa ki tre ri wu he nji Samariya nga wu ri he ri bɨzhi ran?&gt;&gt;<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />Yeso ka nyɨme wa ri,&lt;&lt;Me ran he ri bɨzhi ran, me no A ti won mkpen, ama biyi bi ran ri no wen mkpen ran. <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />Me ran ri wa mkpen ri ngawon ran. Ama nji ri he riwa ari wa ri mo, nga wawu nye ri bla tre. <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />Me la yi kpunji tre: nji riwa a wo tre won a ran kuu ran.<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />Nji Yahuda-a waka tre ri wu ri, &lt;&lt;Zizan ki to ri wu he ri bɨzhi kpunji! Ibrahi kuu, nga wa la tre Izhi wa kuu, ama wu tre ri nji riwa a wo tre wen a ran kuu ran. <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />A ti mbu Ibrahi kuu, nga wa la tre Izhi wa kuu, a wu wu han wa? A wu wu ban ngawen ri wu he ngaa nye?&gt;&gt; <verse eid="JHN 8:53" /><verse number="54" style="v" sid="JHN 8:54" />Yeso ka nyɨme ri wa ri,&lt;&lt;Wari tre ri me wa mkpen ri ngawon, imkpen-a ran he ri kuklu. Inji riwa ari no wen mkpen a he A ti won, wawu riwa bi tre ri a he Izhi mbi. <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />Bi ran to-u zari ran, ama ame me to-u. Wari tre ri me tre ri me ran to-u ran, me ri he nji ri che ka biyi. Ama ame me to-u, nga meri hu tre wan. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />A ti mbi Ibrahi a ngɨri ritu riwa ari to vi riwa me ye; a to-u ran ti kinklan sron.&gt;&gt; <verse eid="JHN 8:56" /><verse number="57" style="v" sid="JHN 8:57" />Wa rinkon wa nji Yahuda-a waka tre ri wu ri,&lt;&lt;Wu ran ke se seton ran ama wu to Ibrahi?&gt;&gt; <verse eid="JHN 8:57" /><verse number="58" style="v" sid="JHN 8:58" />Yeso ka tre ri wa ri,&lt;&lt;Me la yi kpunji tre, ame me he ka wa ran ngɨzhi Ibrahi rina!&gt;&gt; <verse eid="JHN 8:58" /><verse number="59" style="v" sid="JHN 8:59" />Imba waka vu tita riwa wa ta Yeso, ama Yeso ka rii ngawan ran ka ko Izhi don.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">Yeso a den nji riwa wa ngɨzhi-u ri mfyen</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />Riwa Yeso a ran zren, ka to nji ri wa ngɨzhi-u ri mfyen. <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />Imiri ndu wan waka miyen ri,&lt;&lt;Inji ri tsro, meme ti ngaa nye no wa ngɨzhi nji nyi ri mfyen? A he meme ti wan nye ka iwa wa tiwan?&gt;&gt; <verse eid="JHN 9:2" /><verse number="3" style="v" sid="JHN 9:3" />Yeso ka nyɨme ri wa ri,&lt;&lt;Aran he ritu nji nyi, ka wa ti wan wa ti meme ti nye no ti nfyen ran, ama wa ngɨzhi-u ri nfyen ritu no wa tsro gbengbren Izhi ritu wan. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />A he nganyi ki sondu ran ti ndu nji riwa a ti ta ndu ka nji ran ku rina, ichu he ri nkon ri ye riwa njo ran to ti ndu ngaran. <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />Riwa me he ri mgbugblume nyi, ame mi he kpan wulu mgbumgblume.&gt;&gt;<verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />Kugon riwa Yeso a tre nganyi, ran zhu nten sro ri meme ran san meme riwu ka fon meme riwa a san-a ran ka gban ri nji-a ri si, <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />ran la-u ri,&lt;&lt;Hi wuri ngla si wen ri juju ima ri siluwam.&gt;&gt;Itu nde-a he,&lt;&lt;Indu.&gt;&gt;Imba nji-a ka hi ran ka ngla si wan ka bru ye ko isi wan ka ran kpan ka ran to tsu.<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />Wa kukpan wan nga wawa wa sasi to-u ari si bre ri sen waka tre ri,&lt;&lt;Rinyi ran he nji riwa ari si son ran bre ran?&gt;&gt;<verse eid="JHN 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 9:9" />Wari waka tre ri,&lt;&lt;A he wawu ama imgbron mba waka tre ri onhon a ran he wawu ran, a zhu wawu nye.&gt;&gt;Imba nji-a kyuwan ka tre ri,&lt;&lt;A he ame nye.&gt;&gt;<verse eid="JHN 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10" />Waka miyen-u ri,&lt;&lt;A he ri se ko wu to tsu zizan?&gt;&gt;<verse eid="JHN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11" />Ka nyɨme ri wa ri,&lt;&lt;Inji riwa inde wan he Yeso nye a san meme ran ka gban mo ri si ran la wen ri me hi ngla si ri ima Siluwam, imba me ka hi me ri ngla si-a nga isi won ka bu me ran to tsu.&gt;&gt;<verse eid="JHN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12" />Waka miyen-u ri&lt;&lt;A he ri minyi?&gt;&gt; ka nyɨme ri wa ri, &lt;&lt;Me ran to ran,&gt;&gt;<verse eid="JHN 9:12" /></para>
  <para style="s">Farisa wa wa Nchi tu Den Nji ri Mfyen-a</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />Imba waka ngɨzhi nji riwa a ran ti mfyen ri sen-a hi ri wa nji Farisa. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />Ivi riwa Yeso a san meme ran den nji ri mfyen-a a he chachu vi son vri. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />Farisa waka miyen nji riwa a ran ti nfyen nganga ri a ti se ko isi wan bu. Ka la wa ri,&lt;&lt;A gban meme ri mo ri si, nga me ngla si, nga zizan me to tsu.&gt;&gt;<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />Imba Farisa wari waka tre ri,&lt;&lt;Inji riwa a ti kyanyi a ran zhu ri Izhi nye ye ran ritu a ran hu doka ri vi son vri ran.&gt;&gt;Ama wari waka nyime ri,&lt;&lt;Inji ri meme ti ri tise ran ti kya ri de sisiri bibi nye?&gt;&gt;Irimɨren mba ka ga ti hari.<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />Imba Farisa waka bru miyen nji-a ri,&lt;&lt;Wu tre ri a den ri lilo mfyen wen, ko wu tre se ritu wan? Inji-a ka tre ri a he nji ri la tre Izhi.&gt;&gt;<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />Wa rinkon nji Yahuda wa ran kpanyɨme ri nji riwa a ti mfyen ri sen ran nga zizan ari to tsu tse riwa wa yo wa ti nji-a, <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />wari miyen wa ri,&lt;&lt;Rinyi he vren mbi? Bi tre ri wa ngɨzhi-u ri mfyen ko a ti se ko ran ri to tsu zizan?&gt;&gt;<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />Wa ti wan waka nyɨme ri wa ri,&lt;&lt;Ki to ri a he vren mbu nga ki ri to ri wa ngɨzhi-u ri mfyen. <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />Ama ki ran to ko a ti ri se ran ri to tsu zizan ran, ko ka kiri to ko ingaa nye den kpachuwo ri mfyen ran. Biyi miyen-u kyuwan wawu ran he vren ran, nga ari nyɨme ri tu wan!&gt;&gt; <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />Wa ti wan wa tre nganyi ritu wa ran ti sisiri wa rinkon nji Yahuda riwa wa ka dzi ri nji riwa a kpanyɨme ri Yeso a he Kristo wa dzuu zho ri tra bubu kabru nji Yahuda. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />Ritu wan nye wa ti wan waka tre ri,&lt;&lt;Aran he vren ran biyi miyen-u!&gt;&gt;<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />Wa bru yo nji riwa wa ngɨzhi-u ri mfyen-a ri mkpa ri han wari miyen ri,&lt;&lt;Rimi nde Izhi shizhi ri wu la ta kpunji tre! Ki to iri nji riwa a den mba a he nji ri meme ti.&gt;&gt;<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />Inji-a ka la wa ri,&lt;&lt;Me ran to ran ko a he nji ri meme ti. ikya riri nye me to me ran he nji ri mfyen ama zizan me to tsu.&gt;&gt;<verse eid="JHN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26" />Waka miyen-u ri,&lt;&lt;Ingye nye a ti ri wu? A ti ri se ran den ri lilo mfyen wen-a?&gt;&gt;<verse eid="JHN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27" />Ka nyɨme wa ri,&lt;&lt;Me gbuchi la yi-e ama bi ran wo wen bi ri kpanyɨme ran ritu ngye ko bi wa me bru la yi? Ka bi wa bi ri he ka miri ndu wan ngawen?&gt;&gt;<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />Imba wa rinkon wa nji Yahuda waka kra-u tu bran wari tre ri,&lt;&lt;A wu nye wu he vren ndu wan ama kita ki he miri ndu Musa. <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />Ki to ri Izhi a tre ri Musa, ama kita ki ran to ko nji mba zhu kutan ye ran!&gt;&gt;<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />Iji-a ka la wa ri,&lt;&lt;Rinyi he kya ri ndzu sron! Bi ran to bubu riwa a zhu ye ran ama a den wen ri lilo mfyen won. <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />ki to ri Izhi ran ri wo wa meme ti ran ama ari wo nji riwa ari gbre wu nga ran ri hu tre wan. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />Zhu ri mimɨlan mgbumgblume injo ran wo zari ri injo den nji riwa wa ngɨzhi-u ri mfyen to dzari ran. <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />Wari tre ri nji nyi ran zhu ri Izhi nye ye ran ran ran to ti kyari nganyi ran.&gt;&gt;<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />Waka nyɨme riwu ri,&lt;&lt;A wu riwa wa ngɨzhi-u rimi meme ti, wu wa wuri tsro ta nye mba? Ngha wari dzu zhu ri bubu kabrutu nji Yahuda.<verse eid="JHN 9:34" /></para>
  <para style="s">Imfyen rimi Yuu</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />Riwa Yeso a wo ri wa dzu nji-a zho ri tre bubu kabrutu nji Yahuda-a ka wa-u ran fe wu ran miyen-u ri,&lt;&lt;Wu kpanyɨme ri me ivren Nji?&gt;&gt;<verse eid="JHN 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36" />Imba nji-a ka tre ri,&lt;&lt;Inji rinkon, la wen ko a he ngaa nye bibi riwa me kpanyɨme ri wu!&gt;&gt;<verse eid="JHN 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37" />Yeso ka tre ri wu ri,&lt;&lt;Wu to-u-e nga wawu nye bi tre mbi-u zizan,&gt;&gt;<verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />Inji-a ka tre ri,&lt;&lt;Inji rinkon, me kpa nyɨme!&gt;&gt; Ngha ran kɨbumgbazhu ri kusi Yeso.<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />Yeso ka tre ri,&lt;&lt;Me ye rimi mgbumgblume nyi miri bla tre ritu no wa mfyen no wa to tsu nga no wawa wa to tsu no wa ti mfyen.&gt;&gt;<verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />Farisa wari wawa wa he a ran tre ngamba, nga wari wa miyen ri,&lt;&lt;Wu miyen ri kita ngawen ki ti mfyen mee?&gt;&gt;<verse eid="JHN 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41" />Yeso ka nyɨme wa ri,&lt;&lt;Wari tre ri bi he wa mfyen nye bi ri ran he wa meme ti ran, ama riwa bi tre ri bi to tsu bi he wa meme ti nye mba.&gt;&gt;<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">Ikɨbu tre ritu nji ri kɨshu ntɨma</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />Yeso a tre ri,&lt;&lt;Me layi kpunji tre nji riwa a ran gra ri tra ho ntɨma dzu ku nkon tra ran, ran dzu ku ŋɨma ri nkan a he nji ri yɨbi nga nji ri vi nji kpi ra. <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />Inji riwa a gra dzu ku nkon tra wawu he nji ri kɨshu ntɨma. <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />Inji ri gben ri nkon tra ho ntɨma ari bu nkon ri wu intɨma-a wa wo raan wan riwa ari yo wa ntɨma wan ri nde mba nga ran kɨshu wa zhi ri raa. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />Ka a kɨshu wa zhu ri ran ari hi kusi mba nga intɨma-a wa ran hu kugon ritu wa to raan wan. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />Wa ran hu njo ri nkan ran tsede wa ran klu-u ritu wa ran to raan wan ran.&gt;&gt;<verse eid="JHN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6" />Yeso a la wa kɨbu tre nye ama wa ran to tu wan ran.<verse eid="JHN 10:6" /></para>
  <para style="s">Yeso Nji ri Kɨshu Ntɨma Ndindi</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />Imba Yeso ka bru tre nganga ri,&lt;&lt;Me la yi kpunji tre, me he nkon riwa ntɨma wa gra dzu. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />Wawu wawa wa gbuchi ye ri mo wa he wa yɨbi nga wa vu kpi ra ama intɨma wa ran wo wa ran. <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />Me he nkon, wawa wa hu ri me gra wa fe kpachuwo wa gra rimi nga wari zhu raa hi wa kya ri ri. <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />Inji ri yɨbi ri ye ritu ran yɨbi ran wuu nga ran kpa kongye time. Ame me ye ritu no ko ngaa no fe viri riwa a ran kre ran.<verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />&lt;&lt;Yeso a tre ri ame me he nji ri kɨshu ntɨma dindi riwa ari wa ran kuu ritu ntɨma wan. <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />Ka nji riwa a ran he nji riwa wa ban wu no kɨshu ntɨma nga a ran he ri ntɨma ran ka a to yawu ri ji ri ye ari tsutsu ran ka ntɨma wan don yawu ri ji ri vu ntɨma ri ran kpa mgbron mba pisi. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />Inji riwa wa ban wu ritu wa ban wu ban nye nga a ran taka ritu nɨma-a ran. <verse eid="JHN 10:13" /><verse number="14-15" style="v" sid="JHN 10:14-15" />Me he nji ri kɨshu ntɨma dindi. Bibi riwa A ti to wen ame me to A ti ngawen, ngamba nye ngawen me to ntɨma won nga wawa ngawen wa to wen nga me wa miri kuu ritu mba. <verse eid="JHN 10:14-15" /><verse number="16" style="v" sid="JHN 10:16" />Imgbron ntɨma won wari wa he riwa wa ran he ri tra ho nyi ran me hi ngɨzhi wa ye no wa he igbu riri nga nji ri kɨshu riri.<verse eid="JHN 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17" />&lt;&lt;A ti nyɨme wen ritu me wa miri ka vri won de ritu riwa me bru kpa nganga. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />Inji ran ban vri won hi ngawan ran me ka-u de ri su son won nga me he ri mgbemgbrn riwa me bru kpaa rinyi nye he kya riwa A ti won la wen me ti-u.&gt;&gt;<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />Isron wa nji Yahuda ka bru ga ti hari ritu tre wan nyi. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />Wari kigbu mba wa ran tre ri,&lt;&lt;A he ri bɨzhi! Ari sra ritu ngye ko ki sren ton ri wu?&gt;&gt;<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />Ama mgbron mba wa ran tre ri,&lt;&lt;Inji riwa a he ri bɨzhi ran ri tre nganyi ran wa ti ri se ko ibɨzhi ri no nji ri mfyen no to tsu?&gt;&gt;<verse eid="JHN 10:21" /></para>
  <para style="s">Nji Yahuda wa Kamba ri Yeso</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />A he ri vi riwa isi a ran ti nga wa ran roro ri tika vi riwa wa ka tra ibreran no Izhi ri Urushalima. <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />Yeso a ran zrenri ri tra nkon ri wa solomu ri tra bre, <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />Inji waka kagon wan wa ri miyen ri,&lt;&lt;Hi shitan nye wu sondu kata dzi ri sron hari? La ta kpunji tre a wu nye wu he Kristo&gt;&gt;<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />Yeso ka nyɨme ri,&lt;&lt;Me gbuchi la yi ama bi ran kpanyɨme ri me ran kyawa riwa me ti ri gbengbren A ti won a tre ritu won, <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />ama bi ran kpanyɨme ri me ran ritu bi ran he rimi wa ntɨma won ran. <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />Intɨma won wa wo raan won nga wari hu wen. <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />Me no wa vɨri riwa a ran kre ran nga wa ran kuu ran, injo ran kpa wa riwo won ran. <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />Ikya riwa A ti won no wen a han kongye, nga injo ran ri kpa wa ri wo wan ran. <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />A ti won nga ame ki he riri.&gt;&gt;<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />Imba wa nji Yahuda-a wa bru vu tita riwa wa ta Yeso. <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />Yeso ka la wa ri,&lt;&lt;Me ti kyawa wa dindi bran ri si mbi riwa A ti won no wen me ti, ko ritu ritan nye rimi mba bi wa bi ri ta wen ri tita ritu wan?&gt;&gt;<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />Waka nyime ri,&lt;&lt;Ki ran ri wa kiri ta-u ri tita ritu kya ndindi riwa wu ti nye ran ama ritu tretre meme ritu Izhi. A wu wu he nji nye ama wu wa wuri kɨma ngawen he ka Izhi!&gt;&gt;<verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />Yeso ka nyɨme ri wa,&lt;&lt;A he rimi ngan rimi Doka mbi ri, Izhi tre ri,&lt;&lt;Bi he zhi wawa bi ran to wa ran nye.&gt; <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />Ki to ri ikya riwa imbe Izhi tre a he kpunji nga Izhi yo nji wamba ri izhi riwa wana to wa ran nji wawa wa ka tre wan no wa. <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />Ama A ti chu wen nga ran ti wen ndu hi ri mgbumgblume, ko ari he se ko bi tre ri me tretre meme ritu me tre ri me he vren Izhi? <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />Ran kpanyɨme ri me ran, ka me ran ri ti kya riwa A ti won wa me ti ran. <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />Ama ka me ti wa ko bi ran kpanyɨme ri me ran bi kpanyɨme ri ndu won ritu bi ri to ri A ti won he ri me nga ame ngawen me he ri A ti won.&gt;&gt; <verse eid="JHN 10:38" /><verse number="39" style="v" sid="JHN 10:39" />Nganga wa bru ran wa wari vu Yeso ama ka jɨbu ri wo mba.<verse eid="JHN 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40" />Yeso ka bru kɨma rugran hi ri Ba Yodan ri bubu riwa Yohana a ran son nji tu ri ima ri gbuchi ran son ri bubu wan. <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />Inji kɨgbu waka ye ri wu wari tre ri,&lt;&lt;Yohana ran ti kya ri de sisiri ran, ama ko ngye riwa a tre ritu nji nyi a he kpunji.&gt;&gt; <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />Ngha nji kigbu ri bubu wan waka kpanyɨme ri Yeso.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">Ikuu lazaru</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />Inji ri nye a ran lo, nde wan a he lazaru riwa a zhu ri Batani igbu wa meremu ri vayi wan vru wa marta. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />Meremu nye riwa vayi wan lazaru riwa a lo wawu nye a gban dza Bachi ri nye ri ro ran se za wan ri nfutu wan. <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />Ri mba ka ti miri vayi wan mirimba ndu no wa la Yeso,&lt;Bachi &gt; Ikpan wen riwa wu nyɨme ri wu ri lo.<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />Riwa Yeso a wo nganyi ran tre, lilo nyi a ran ri wuu Lazaru ran, onhon a he ri nkpen Izhi riwa ivren Izhi ri fe nkpen rimi wan.&gt;&gt;<verse eid="JHN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5" />Yeso ri nyɨme ri marta nga vayi wan vruwa ri lazaru. <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />Rwa Yeso a wo ri lazaru a ran he ri si kpa ran ka bru son ri bubu riwa a he ti vi hari. <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />Ngha ran la miri ndu wan ri ki bru hi ri gbu Yudiya.<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />Miri ndu wa ka tre ri wu,&lt;&lt;A wu nji riko ivi-ri nyi nye Yaudiwa wa wa nkon wa ri ta-u ri tita wu bru hi gbu nga ri!&gt;&gt;<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />Yeso ka tre riwa ri, &lt;&lt;A ran he awa wurudon hari nye ri vii riri ran? Ko ngaa ri zren ri kpan Izhi a ran kɨbu dza ran ritu ari to kpan mgbumgbulu me nye. <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />Ama ko ngaan ri zren ri chu a ri kɨbu dza ritu ikpan tsu a ran he ri wu ran!&gt;&gt; <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />Kugon riwa a tre nganyi ran bru la wa miri ndu wan ikpan mbu lazaru a kru naa ama me hi miri shɨme-u.<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />Imiri ndu wan wa ka tre ri,&lt;Bachi a he kruna nye, ari fe si kpa.&gt;<verse eid="JHN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13" />Yeso a ran tre ritu kuu wan, ama imiri ndu wan wa yonga a ri tre ritu kruna ri son vri. <verse eid="JHN 11:13" /><verse number="14" style="v" sid="JHN 11:14" />Imba Yeso ka la wa a he njanji,&lt;Lazaru a kuu, <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />nga ritu mbi me ngiri, me ran he bubu wan ran ritu bi ri kpa nyɨme ama ki hi ri wu.&gt;&gt;<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />Mba Toma riwa wa yo-u ivren ri ngareka tre ri mgbron miri ndu ri,&lt;Ki hi ngawan, ki ri kuu ri wu.&gt;<verse eid="JHN 11:16" /></para>
  <para style="s">Itashɨme Yeso Ngha Vɨri</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />Riwa Yeso ka zhu bubu wan, ka to Lazaru a ti vi nza ri bubu gru. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />Batani a he hyure-hyureri Urushalima a ri he ka mile hari, <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />nji Yahuda branbran wa ka ye ritu wa ri no Marta nga Maryamu isi stron ritu kuu vayi mba.<verse eid="JHN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20" />Riwa Marta a wo Yeso ri ye a zhu raa ran dzon wu ri nkon ama Meremu ka son rimi ko. <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />&lt;Bachi,&gt;Marta ka tre ri Yeso he ri nyi vayi won ran ran kuu ran. <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />Ama me to ri zizan Izhi ri no-u kya riwa wu miyen:&gt;&gt;<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />Yeso ka tre ri wu vayi wen ri wulunde.<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />Marta ka tre ri Yeso,&lt;&lt;Me to a ri wulunde ri wa kuu ri vi riwa ari kre.&gt;&gt;<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />Yeso ka tre riwu ri, &lt;&lt;Ame nye me he tashɨme wawa wa kuu, nji riwa a kpanyɨme ri me, ko a kuu a ri son vri, <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />nga nji riwa a kpanyɨme ri me a ran kuu ran. Wu kpanyɨme ri rinyi?&gt;&gt;<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />Marta ka tre ri Yeso ri,&lt;&lt; Bachi me kpa nyɨme ri a wu wu he Kristo ivren Izhi wa wu nye riwa a ri ye ri mgbumgbulu me.&gt;&gt;<verse eid="JHN 11:27" /></para>
  <para style="s">Yeso a Yii</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />Riwa a tre nganyi Marta ka bru ye ran yo vayi wan vruwa Meremu ri gran nji ri tsro a he ri nyi ka yonga ari mɨyen wu. <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />Riwa Meremu a wo nga mba ka wulunde gbagbla ran hi ri wu. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />Yeso a ran hi ri gbu ri ran a he ri bubu riwa Marta a fe wu. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />Riwa nji Yahuda wa he ri Marta ri ko wa ran no si sron wa ka to Meremu a wulunde gbagbla zhu ko wa ka hu ran yonga a ri hi bubu gru nye riwa a ri yi kuu wan.<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />Riwa Meremu a zhu bubu riwa Yeso he, ka to-u ran joku ri kusi wan ran tre ri wu,&lt;&lt;A wu Bachi, riwa wu ri he, vayi won ran ran kuu ran.&gt;&gt;<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />Riwa Yeso a to-u a ran yii nji Yahuda riwa wa ye riwa ngawen wa ran yii, ka lo stron. <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />Yeso ka tre riwa,&lt;&lt;Bi ka-u yo ri menyi?&gt;&gt;Wa ka tre ri wu,&lt;&lt;A wu Bachi ye wu ri to.&gt;&gt;<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />Imba Yeso ka yii ima si. <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />Ri mba nji Yahuda wa ka tre,&lt;&lt;To bibi riwa a nyɨme ri Lazaru.&gt;&gt;<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />Ama wa ri rimi mba waka tre, &lt;&lt;A ran he wa wu riwa a bu si nji riwa a ti nfyen ran? ritu ngye ko a ran kpa Lazaru chuwo ri kuu ran?&gt;&gt;<verse eid="JHN 11:37" /></para>
  <para style="s">Yeso a ta Lazaru Shɨme ri Kuu</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />Rimba isron Yeso ka time, ka ye bubu gru, bubu gru a he tita nye wa ka nyun wan ri wu. <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />Yeso ka tre ri Marta vayi Lazaru riwa a kuu-a ri, &lt;&lt;Ban tita-a zho!&gt;&gt; Ka tre ri, &lt;&lt;Bachi, ari mɨwi gigla. A ti vi nza riwa wa no yɨbi!&gt;&gt;<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />Ri mba Yeso ka tre ri wu ri,&lt;&lt;Me ran la wu ran riwu kpa nyɨme wu to nkpen Izhi ran?&gt;&gt;<verse eid="JHN 11:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 11:41" />Mba wa ka tru tita yo gran Yeso ka zun si ban shu ran tre,&lt;&lt;A wu A ti me ngɨri riwu riwa wu wo wen. <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />Me to wu si wo wen chachu, ama me tre rinyi ritu nji wawa wa kri nde riwa no wa kpa nyɨme a wu nye wu ti wen ndu.&gt;&gt; <verse eid="JHN 11:42" /><verse number="43" style="v" sid="JHN 11:43" />Riwa a tre nganyi Yeso ka kpagro yo-u ri,&lt;&lt;Lazaru shɨme ye!&gt;&gt; <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />Ngha Lazaru ka shɨme ye ri tsro kuu riwa wa nye-u, wa nye si wan ri tsro, Yeso ka tre,&lt;&lt;Si tsro mba zho ri wu nga bi ri no hi ngawan.&gt;&gt;<verse eid="JHN 11:44" /></para>
  <para style="s">Wa wa wari Wuu Yeso</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />Ikigbu nji Yahuda wawa wa ye ri Meremu wa ka to kya riwa Yeso a ti wa ka kpanyɨme ri wu. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />Ama wa ri rimi mba wa ka hi ri Farisa, wa ka la wa bibi kya riwa Yeso ti. <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />Imba wa rikon ndu Izhi nga Farisa wa ka shutu kabru wa ri tre,&lt;&lt;Ngye ki ti nye ri wa nji nyi a ri ti kya wa wa ti sisiri nga nyi-a? <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />I ki ka-u chuwo nganyi ko ngaa ri kpa nyɨme ri wu nga Romawa wa ye wa ri kpa gbu mbu nga wa ri vu nji mbu.<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />Ama iri rimi mba riwa nde wan a he Kayafa riwa a he rinkon wa sro yii ri se wan ka tre,&lt;&lt;Bi ran to kya wawu ran! <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />Bi ran to ran riwa a bi ri yi no nji riri no kuu ri tu nji wawu riwa a ri han nji mgbugblu me no wa kuu.&gt;&gt; <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />Kayafa a ran tre nganyi ritu wawu ran, ama, ritu wawu a he rinkon nji wa sro yii ri se wan, a la tre ri kusi ri kuu ritu wa nji Yahuda, <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />nga a ran ritu mba kakre ran, ama ritu ran ngɨzhi wa hu Izhi wawa wa kado ye kabru ri bubu ri.<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />Zhu ri vi-a wa rinkon wa nji Yahuda wa wa wari wuu Yeso. <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />Ritu ngamba Yeso a ran bru zren ri nji Yahuda ri rira ran, ama a wulunde ri bubu wan ran hi gbu riwa a he ri nyu ji, ran gra hi ri gbu riwa nde wan a he Ifraimu. Bubu wan nye a ka son iwawa miri ndu wan. <verse eid="JHN 11:54" /><verse number="55" style="v" sid="JHN 11:55" />Riwa ivi a ti no nji Yahuda no wa za gran ikpa nji wa ka hi ri gbu Uruhalima riwa wa ngla ngamba ri ko wari dza gran. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />Wa si wa Yeso, nga riwa wa kabru rimi ko Izhi, wari ran tre ri ngamba ri,&lt;&lt;Bi to se? A ri ye ri vi ri ro nyi?&gt;&gt; <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />Ama rinkon wa sro yii nga Farisa wa la wa ri ka njo to bubu riwa Yeso he ka ye la, ritu wari vu.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">Wa gban nye ri Yeso ri Batani</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />Iro ri dzagran a don vi tanren imba Yeso ka hi ri gbu Batani bubu riwa Lazaru nji riwa Yeso a ta shɨme rimi kuu a ran son. <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />Ri bubu wan wa ka zhu la ri yawulu riwa Marta nye a ran ga la-a; Lazaru a he rimi wawa wa son ran ri ri-a ri Yeso <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />Imba Meremu ka ban nye ri kpangu raro riwa a ti ree riwa wa ti-u ri nardi ran gban wu ri Yeso ri dza wan ko ran ka mfutu wan gban wu wa kpɨrewan inguu raro riwa nye-a ka shu ko-a wawu. <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />Ama Yahuda Iskariyoti iri rimi mirindu Yeso riwa wawu nye ri ka Yeso re, <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />&lt;&lt;Ingye ti wa ka nye mu reri nkren kigbu riwa lebra ri fe rimi vi ngo tra wari ka nkren-a no wawa wati yaa ran?&gt;&gt; <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />Yahuda a tre tre nyi a ran ritu riwa a nyɨme wawa wati-u yaa ran, ama ritu riwa a he nji ri yibi wati yaa wawu nye a ran ngji kpo riwa wa sro nkren mba, ari ye ka ye yibi rimi nkrn-a.<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />Yeso ka tre ri,&lt;&lt;Ka-u chuwo a ka-u dzi ritu riwa a kɨma bubu riti ri gben vi riwa wa no wen yɨwi. <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />Ai bla vi bi he iwa wawa wana ri kyari ran ama a ran he bla vi nye bi he ri me ran.&gt;&gt;<verse eid="JHN 12:8" /></para>
  <para style="s">Wa shutu riwa wa Wuu Lazaru</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />Riwa ishutu nji Yahuda kigbu wa wo iri Yeso a he ri bubu wan, wari wa ran ye ritu Yeso ri kankshe ran ama ritu riwa wa to Lazaru riwa Yeso a ta shɨme ri mi kuu ngawen. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />Imba wa rinkon wa sro yii waka shutu riwa wa wuu Lazaru ngawen, <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />ritu Lazaru nye nji Yahuda kigbu wa ka wa ndu Izhi don wari kpanyɨme ri Yeso.<verse eid="JHN 12:11" /></para>
  <para style="s">Yeso a Gra ri Urushelima Ka Ichu</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />Ri mibreri wan nji kigbu wawa wa ye ri ro ri dza gran wa wo ri Yeso he nkon ri hi Urushelima.<verse eid="JHN 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 12:13" />Waka vu wa mfran rii wari zhu wari zon-u ri nkon wa nzu raan wari ran tre ri,</para>
  <para style="q1" vid="JHN 12:13">&lt;&lt;Igibree wa Izhi!&gt;&gt;</para>
  <para style="q1" vid="JHN 12:13">&lt;&lt;Ndindi wan he wa riwa ari ye rimi nde Bachi!&gt;&gt;</para>
  <para style="q1" vid="JHN 12:13">&lt;&lt;Ndidi wan he wa chu Israila!&gt;&gt;<verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />Riwa Yeso a fe vren lamkpron ri ran hon bibi riwa wa ngaa ri,<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />&lt;&lt;Ran ti sisiri ran biyi wa nji gbu Siyona,</para>
  <para style="q2" vid="JHN 12:15">ingye ichu mbi ri ye,</para>
  <para style="q2" vid="JHN 12:15">ritu lamkpron mba.&gt;&gt;<verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />Ri mimɨlan imiri ndu wan wana to tu wan ran ama kugon riwa wa no Yeso mkpen, waka taka ri wa nganngan nyi ritu wan nga kyawa-a wa he bibi riwa wa ngaa-a.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />Wa nji wawa wa he ri wa ri vi riwa a yo Lazaru ri no zhu rimi bubu gru, waka sondu ran la nji kya riwa Yeso a ti. Wa nji wawa wa he iwa ri vi riwa a yo Lazaru ri no zhu rimi bubu gru waka sondu ran la nji kya riwa Yeso a ti. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />Inji kigbu wa hi bubu kpa ri nkon ritu wari don wo kyawa wa de sisiri riwa a ti. <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />Farisa wa ka tre ri ngamba ri,&lt;&lt;To mba yi, kiran ri vu tu nji nyi ran, to mgbumgblume wawu wa hu.&gt;&gt;<verse eid="JHN 12:19" /></para>
  <para style="s">Helenawa wari wa wa Yeso</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />Rimi wawa wa ye ro-a riwa wa ye kɨbu mgbazhu ri Izhi Helanawa wari wa he. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />Wa ka ye ri Filibu nji ri Batsaida riwa Galili waka tre riwu ri,&lt;&lt;Inji rinkon ki wa ki to Yeso.&gt;&gt;<verse eid="JHN 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22" />Filibu a hi ran ka la Andarawus, imba wawa ngamba waka hi wari ka la Yeso. <verse eid="JHN 12:22" /><verse number="23" style="v" sid="JHN 12:23" />Imba Yeso ka tre ri wa ri,&lt;&lt;Ivi ti riwa wa gbre vren nji. <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />Kpunji tre me la yi, inde wana chu wɨlo alikama no kuu ri meme ran ari son ri kankshi wan. Ama inde a kuu nye ko ari de miri bran. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />Inji riwa a nyɨme sron wan ari hon-u, nji riwa a kawan ri sron wan ritu won ri mgbumgblume nyi a ka-u ri ri dzi riwa ari fe wu hi riwa a ran kre ran. <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />Inji riwa a ri hu wen a he no hu wen hi bubu riwa me he, nji riwa ari hu wen ari son ri me, A ti won ri no ko ngan riwa ari hu wen mkpen.<verse eid="JHN 12:26" /></para>
  <para style="s">Yeso a tre ritu Kuu wan</para>
  <para style="pi">
    <verse number="27" style="v" sid="JHN 12:27" />Zizan ari kri wen ri sron ingye nye me tre enron? Me tre ri,&lt;A wu A ti ban vi nyi zho ri mo?&gt;Onhon, ai me ye ri sen ritu vi nyi nye. <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />A wu A ti, no nde wen mkpen!&gt;&gt;</para>
  <para style="p" vid="JHN 12:28">Imba iran ka zhu ri shu ran tre,&lt;&lt;Ai me gbuchi no mkpen-e, me bru no mkpen sro ngaan.&gt;&gt;<verse eid="JHN 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29" />Riwa nji wawa wa ki ri bubu wa wo raan-a,&lt;&lt;Inzan ka yira.&gt;&gt;Wari waka tre ri,&lt;&lt;Ivren ko Izhi nye tre ri wu.&gt;&gt;<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />Yeso ka tre ri wa ri,&lt;&lt;Iraan nyi ye ritu mbi nye, a ran he ritu won ran. <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />Zizan nye wa bla tre ri mgbumgblume nga zizan nye wa dzi nji ri kpanchison ri nji wa mgbumgblume nyi. <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />Kugon riwa wa nzu wen zho ri meme, me gbi wa nji wawu hi ri ngawon.&gt;&gt; <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />Yeso a la nganyi ritu riwa ari tsro bibi kuu wan riwa ari he.<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />Inji waka tre ri Yeso ri,&lt;&lt;Doka mbu la ta ri Kristo ran kuu ran hari hi, ko wu tise wuri tre ri wa nzu vren nji? Ingaan nye he vren nji-a?&gt;&gt;<verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />Yeso ka tre riwa ri, &lt;&lt;Ikpan he ri yi ri vi tsawen zren yi tu ka ikpan he ri yi no bu no ran fe yi ran, nji riwa ari zren rimi bu a ran to bubu riwa ari hi ran. <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />Kpanyɨme ri kpan-a tu ka bi he ri wu, ritu no yi he miri wa kpan.&gt;&gt;</para>
  <para style="s" vid="JHN 12:36">Nji Yahuda wa Sondu ri Kamba ri Yeso</para>
  <para style="p" vid="JHN 12:36">Kugon riwa Yeso a tretre nyi ran kɨma ngawan tsriri ri wa. <verse eid="JHN 12:36" /><verse number="37" style="v" sid="JHN 12:37" />Ko riwa Yeso a si ti kyawa wa de sisiri kigbu kusi mba ri ngamba wa ran kpanyɨme ri wu ran, <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />Rinyi a he ngamba ritu no kya riwa Ishaya, nji ri la tre ri kusi a tre ri,</para>
  <para style="q1" vid="JHN 12:38">&lt;&lt;A wu Bachi ingan kpanyɨme ri tre mbu? Ngha ri ngan nye wa tsro mkpen Bachi,&gt;&gt;<verse eid="JHN 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39" />Ri ngamba wana kpanyɨme ran bibi riwa Ishaya a bru tre ri bubu ri ri,<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />&lt;&lt;A kɨma wa ti mfiyen, nga ran kpan</para>
  <para style="q1" vid="JHN 12:40">sron wari ritu no wa</para>
  <para style="q2" vid="JHN 12:40">ran to ri simba wari to rimi sron hari</para>
  <para style="q2" vid="JHN 12:40">wari kɨma ye ri me no wen den wa kpa chuwo.<verse eid="JHN 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41" />Ishaya nji ri la tre Izhi a tre nganyi ritu riwa a to mkpen Yeso nga ran la tre wan.<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />Ringamba wa rinkon nji Yahuda waka kpanyɨme ri Yeso. Ama ritu sisiri a ti wa Farisa wana tre ri wa rimi tra riwa wawa wa kpa nyɨme ri Yeso ran, ritu no wa ran dzu wa rimi bubu kabru tu nji Yahuda ran. <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />Ritu wa wa no ji no wa ran gbre wawa han riwa Izhi ri gbre wawa.<verse eid="JHN 12:43" /></para>
  <para style="s">Itre Yeso ri Bla tre</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />Yeso ka nzu raan ran tre ri,&lt;&lt;Inji riwa a kpanyɨme ri me, a ran he ame nye a kpanyɨme ri me ran, ama nji riwa a ti we ndu nye a kpanyɨme ri wu. <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />Inji riwa aya wen, a to nji riwa a ti wen ndu ye. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />Me ye ka ikpan rimi mgbumgblume ritu nji riwa a kpanyɨme ri me no ran son rimi bu ran. <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />&lt;&lt;Inji riwa a wo tsro won ran ran hu ran, a ran he ame nye me bla tre ri wu ran, a ran he ritu nowen ye bla tre ri mgbumgblume nye me ye ran, ama ritu no wen ye kpa mgbumgblume chuwo nye. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />Inji riwa a kawan ri me nga a ran kpa tre won ran a he ri nji riwa ari bla tre ri wu, itre riwa me tre wawu nye ri bla tre ri wu chachu kre vi, <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />Kyawa wawa me tre a ran zhu ri me ran, A ti won riwa a ti wen ndu nye ri la wen kya riwa me la, ri tre riwa me tre. <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />Ngha me to ivri riwa a ran kre ran ari fe ri mgbemgbɨren ri wa A ti de. Ritu ngamba ikya riwa me la, me la tsra ri kya riwa A ti la wen no wen me la.&gt;&gt;<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">Yeso a ngla miri ndu wan dza</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />Ko iri ivi wan ye riwa Yeso ri ka mgbumgblume don ran hi ri A ti, a sondu ran nyɨme wawa wa he ri mgbumgblume, wawa wa he wa ma a nyɨme wa hi ri kre wan. <verse eid="JHN 13:1" /><verse number="2" style="v" sid="JHN 13:2" />Riwa Yeso nga mirindu wan wa he rimi ri ri yawulu meme nji a kadzi ri sron Yahuda ivren Sima Iskaroti riwa ari ka Yeso re. <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />Yeso a to ri A ti no gbengbren ritu kongye; a to ri wawu zhu ri Izhi nga ari bru hi ri Izhi. <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />Imba ka wulunde ri kpanchi riwa wa ri ri, ran chu tsro wan ri ka mbzhu zho ran ban tawulo lo ri tri. <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />I mba ka sro ima rimi tsuutsu ri ngla wo ran gra ngla miri ndu wan dza ran se wa dza ri tawulo riwa a lo ri tri-a.<verse eid="JHN 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 13:6" />Riwa Yeso a ye ri Sima Bitrus riwa a tre ri,&lt;&lt;A wu Bachi nye wu ngla wen dza?&gt;&gt;<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />Yeso ka nyɨme ri,&lt;&lt;Wu ran to kya riwa me ti zizan ran, ama wu to-u mbari.&gt;&gt;<verse eid="JHN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8" />Bitrus ka la-u ri,&lt;&lt;Wu ran ngla wen dza ran.&gt;&gt;</para>
  <para style="p" vid="JHN 13:8">Yeso ka tre wu ri,&lt;&lt;I me ran ngla-u dza ran, wu ran he vren ndu won ngaran.&gt;&gt;<verse eid="JHN 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9" />Sima Bitrus ka tre ri,&lt;&lt;Bachi ran ngla wen dza kakre ran wu ngla wen wo nga tu ngawen!&gt;&gt;<verse eid="JHN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10" />Yeso ka tre ri,&lt;&lt;Wawa wa sukpa-e wa he tsitsri nga a ran he riwa wa ngla ngamba ngaran, wa ngla dza kakre, wawu mbi bi he tsitsri ara nji riri.&gt;&gt; <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />Yeso a gbuchi to nji riwa ari ka wawu re-e; ritu wan nye ka tre ri,&lt;&lt;Wawu mbi bi he tsitsri ara nji riri.&gt;&gt;<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />Kugon riwa Yeso a ngla wa dza kre, ka ban tsro wan ri ka mbzhu bru suu nga ran bru hi ri bubu wan riwa wa ran ri ri, ka miyen wa ri,&lt;&lt;Bi to kya riwa me ti ri yi-a?&gt;&gt; <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />&lt;&lt;Bi yo wen ri nji ri tsro nga Bachi nga a tsra riwa bi ti ngamba ritu ingye kya riwa me he mba. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />Ame Bachi mbi nga nji ri tsro me ngla yi dza, biyi ngawen ngla dza ngambi. <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />Me ti bibi nyi ri yi ritu bi ri ti kya riwa me ti ri yi. <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />Me la yi kpunji tre: Gran ran ri han tiko wan ran, nga ivren ri ndu ran han nji riwa a ti-u ndu ran. <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />Zizan riwa bi to kpunji nyi, kinklan sron mbi ri he ri se ka bi ti ndu ri wu! <verse eid="JHN 13:17" /><verse number="18" style="v" sid="JHN 13:18" />&lt;&lt;Me ran ri tre ritu wawu mbi ran; me to wawa me zhu wa. Ama itre Izhi ri ye ke riwa a tre ri,&lt;Inji riwa ari ri ri ri me ari kɨma gon ti wen.&gt; <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />Me la rinyi zizan ri ko no ye ritu ka a ye bi kpanyɨme ri&lt;Me he riwa me he.&gt;&gt; <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />Me la yi kpunji tre, nji riwa a kpa nji riwa me ti-u ndu a kpa wen ngawen nga nji riwa a kpa wen a kpa nji riwa me ti-u ndu.&gt;&gt;<verse eid="JHN 13:20" /></para>
  <para style="s">Yeso a tre ritu nji riwa ari ka-u re</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />Kugon riwa Yeso a tre rinyi ka loo ri sron ka tre zhu ri raa ri,&lt;&lt;Me la yi kpunji tre: Iri rimi mbi ri ka wen re.&gt;&gt;<verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />Imiri ndu wan waka ran ya ngamba, ari tre ritu ngaa nye. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />Iri rimi miri ndu-a riwa Yeso a nyɨme-u a son hwi Yeso. <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />Sima Bitrus ka tsro-u wo ran tre ri,&lt;&lt;Miyen-u ri ingaa nye ari tre ritu wan.&gt;&gt;<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />Imba ivren ndu-a ka hwi hi ri Yeso ran miyen-u ri,&lt;&lt;Bachi, a he ngaa nye ?&gt;&gt;<verse eid="JHN 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26" />Yeso ka nyɨme ri,&lt;&lt;Me son mkpon jujuyɨmo ri mi vaŋo nji riwa me ka no wawu nye he nji-a.&lt;&lt;Imba ka ban mkpon jujuyɨmo-a ran ka son rimi vaŋo-a ran ka no Yahuda, ivren Sima Iskaroti. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />Riwa Yahuda a kpa juju yɨmo-a meme nji ka gra ri sron wan, Yeso ka tre ri Yahuda ri,&lt;&lt;Ikya riwa wu wa wuri ti wuka ti-u gbagbla!&gt;&gt; <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />Rimi mba ri bubu riri-a injo a ran miyen ritu ngye nye Yeso a tre rinyi ri wu ran. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />Riwa a he Yahuda nye he nji ri ngɨzhi kpo nkren, wari rimi miri ndu-a wa yonga Yeso la-u ri no hi ran rekyawa riwa wa wa ri bubu ro-a nye ko ka no wa yaa kyari rimi nkren-a. <verse eid="JHN 13:29" /><verse number="30" style="v" sid="JHN 13:30" />Yahuda ka kpa mkpon jujuyɨmo-a ran zhu hi ri raa meron. Ri vi wan ichu a ti.<verse eid="JHN 13:30" /></para>
  <para style="s">Doka Sisa</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />Kugon riwa Yahuda a hi ngawan Yeso ka tre ri,&lt;&lt;Ziza wa ŋɨran mkpen vren nji zhu zizan, wa ŋɨran mkpen Izhi zhu hu ri wu. <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />Ka Izhi fe gbre hu ri vren wan, Izhi ri no vren wan gbɨre ri tutu wan ri bubu wan ari fe gbre.<verse eid="JHN 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 13:33" />Biyi miri won wawa me nyɨme yi, me ran son ri yi bran vi ngaran bi wa wen ama me la yi zizan ikya riwa me wa rinkon wa nji Yahuda ri,&lt;Bi ran to hi ri bubu riwa me hi ran.&gt;&gt; <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" />Ngha zizan me no yi doka sisa, nyɨme ngambi. Bibi riwa me nyɨme yi, biyi ngawen bi nyɨme ngambi. <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />Ka bi nyɨme ngambi imba ko ngaa ri to ri bi he miri ndu won.&gt;&gt;<verse eid="JHN 13:35" /></para>
  <para style="s">Yeso a la ritu riwa Bitrus ri tron nyun wan.</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />Sima Bitrus ka miyen-u ri,&lt;&lt;Wu hi kutan nye Bachi?&lt;&lt;Yeso ka nyɨme ri wu ri,&gt;&gt;svWu ran ri to hu wen hi ri bubu riwa me hi ran, ama mbari wu hu wen hi.&gt;&gt; <verse eid="JHN 13:36" /><verse number="37" style="v" sid="JHN 13:37" />Bitrus ka miyen-u ri &lt;&lt;Bachi ritu ngye ko me ran hu-u zizan ran? me milan kri riwa me kuu ritu wen!&gt;&gt; <verse eid="JHN 13:37" /><verse number="38" style="v" sid="JHN 13:38" />Yeso ka nyɨme ri,&lt;&lt;Kpunji tre nye wu wa wu ri kuu ritu won? Me la-u kpunji tre ko no kuko tɨbu wu tron wen ti mkpa tra ri wu ran to wen ran.<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">Yeso Nyen he Nkon hi ri A ti</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />Yeso ka la miri ndu wan ri,&lt;&lt;Ran no sron mbi time ran yosron ri Izhi nga bi ri yosron ri me ngawen. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />Itra wa kigbu ri ko ti won nga me hi bubu milan bubu ri ti ri yi ran ran he ngamba ran me ri ran la yi ran. <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />Ngha kugon riwa me hi meri milan bubu ti ri yi me bru ye me ri ye vu yi hi ri ngawon, ritu bi ri he ri bubu riwa me he. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />Bi to nkon riwa a hu hi ri bubu riwa me hi.&gt;&gt;<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />Toma ka la Yeso ri,&lt;&lt;Bachi, ki ran to bubu riwa wu hi ran, ko ki ti se kiri to nkon hi ri bubu wan?&gt;&gt;<verse eid="JHN 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6" />Yeso ka nyɨme ri wa ri,&lt;&lt;Ame me he nkon nga kpunji nga ame nye me de vɨri, injo ran hi ri A ti won ran tse a hu ri me. <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />Yeso ka tre ri wa ri, zizan riwa bi to wen,&lt;&lt; Bi to A ti won ngawen nga zizan ban kusi bi to-u nga bi ri ya-u.&gt;&gt;<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />Imba Filibu ka tre wu ri,&lt;&lt;Bachi ikya riwa ki wa ri wu wawu a he ri no tsro ta A ti.&gt;&gt;<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />Yeso ka nyɨme ri,&lt;&lt;Sisenmu riwa ki he iwa yi wawu mbi ama wu ran to wen ran a wu Filibu? Inji riwa a to wen a to A ti, ritu ngye ko wu tre ri me,&lt;Tsro ta A ti&gt;? <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />A wu Filibu wu ran Yosron ri bi he ri me a he ri A ti nga A ti ngawen he ri me ran? Yeso ka tre ri miri ndu wan ri,&lt;&lt;I tre riwa me tre ri yi-a a ran zhu ri me nye ran A ti riwa a he ri me wawu nye ti ndu wan.&gt;&gt; <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />Yosron ri me riwa me tre ri me he ri A ti nga A ti he ri me ka a ran he ngamba ran kpayɨme ri kyawa riwa me ti wa. <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />Me la yi kpunji tre wawa wa yosron ri me wa ti kya riwa me ti wa, wa ti kyawa wa rigra ngawen ritu me hi ri A ti. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />Ko ngye riwa bi miyen rimi nde won me no yi ritu no nde Izhi no fe gbre hu ri vren wan. <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />Ko ngye ri wa bi miyen rimi nde won me no yi.<verse eid="JHN 14:14" /></para>
  <para style="s">Ika tre dzi ri Yuu Tsitsri</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />Ka bi nyɨme wen, bi hu tre won. <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />Me miyen A ti nga ari no-u nji ri dzon ri nganga riwa ari he ri wu hi ri kre vi. <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />Nji ri dzon a he Yuu riwa ari ŋran kpunji ritu Izhi ri mgbumblume ran ri to kpaa ran ritu a ran to-u ran ama bi yi bi to-u ritu a he ri yi nga ran he rimi mbi<verse eid="JHN 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 14:18" />Ka me hi bi ran he nkankshi mbi ran; me bru ye ri yi. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />Ri vi tsawen mgbumglume ran to wen ngaran ama biyi bi to wen nga ritu me nawo biyi ngawen bi nawo. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />Ka ivi-a ye bi to ri me he ri A ti nga biyi bi he ri me bibi riwa ame me he ri yi.<verse eid="JHN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 14:21" />&lt;&lt;Wawa wa kpa tre won wari ti ndu ri wu wawa nye wa he wawa wa nyɨme wen. Ame ngawen me nyɨme wa nga me ri ŋɨran nga won ri wa.<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />Yahuda ama a ran Iskariyoti ran a tre ri,&lt;&lt;Bachi ari he se ko wu ŋiran ngawen ri ta nga a ran mgbumgblume ran?&gt;&gt;<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />Yeso ka nyɨme ri wu ri,&lt;&lt;Wawa wa nyɨme wen wa hu tsro won. A ti won ri nyɨme wa nga A ti won nga ame ki ye ri wa kiri son ri wa. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />Wawa wa ran wo tsro won ran nga tsro riwa bi wo a ran he wa mo ran ama a zhu ri A ti riwa a tiwen ndu.<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />&lt;&lt;Me la yi rinyi ka me he ri yi ri. <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />Inji ri dzon Iyu Tsitsri riwa A ti ri tru ye rimi nde won ari tsro yi ko ngye nga ran no yi taka wawu kya riwa me la yi.<verse eid="JHN 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />&lt;&lt;Me ka yi don ri sisron Isisron nye me no yi a ran bibi riwa mgbumgblu me wa no yi nye me no yi ran. Ra ti tika ran nga ran ti sisiri ran. <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />Bi wo wen me layi ri,&lt;Me kayi ri don ama me bru ri ye ri yi.&gt;Ka bi nyɨme wen bi ti kinklan sron ritu me hi ri A ti ritu wawu han wen. <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />Me la yi rinyi ko no ye zhu, ritu ka a ye bi ka kpanyɨme. <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />Me ran tre ri yi bran ngaran ritu nji ri kpanchi ri mgbumgblume ri ye. Aran he ri gbengbren ritu wan ran, <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />ama mgbumgblume ri to ri me nyɨme A ti ritu wan nye me ti kongye bibi riwa a tre me ti.</para>
  <para style="p" vid="JHN 14:31">&lt;&lt;Wulunde ki ka bubu nyi don.<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">Yeso nye he konkron inabi ri kpunji</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />&lt;&lt;Ame me he konkron inabi ri kpunji nga A ti won he nji ri ya konkron-a. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />Ari tren ganran riwa a he ri kpa won riwa a ran ri klo ran taga nga ran milan ganran riwa ari klo ti bibi ri wa ari bi ran klo sro ngaa. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />Wa tsri yi-e ritu tsro riwa me no yi. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />Son rimi kabru tu ri me nga ame me son rimi kabrutu riyi. Ganran konkron inabi ran ri to klo ri ri tu wan ran ari ti ngamba ritu a son rimi konkron-a. Ri ngamba nye me bi ran ri to klo wɨlo ran tse bi son ri me.<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />&lt;&lt;Ame me he konkron inabi inga biyi bi he ganran wan wawa wa son ri me nga ame me son ri wa wa klo wi lo kigbu bi ran to ti kya ka me ran he ri yi ran. <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />Wawa wa ran son ri me ran wa kawa rega ka ganran riwa wa ka rega a kɨlu bibi ganran mba wa ka wa rega imi wulu wari gon wa. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />I wu son rɨme nga ka wu to tre won he rimi sron wen imba ko ngye riwa wu wa wu fe wu. <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />Wa to mkpen A ti won ritu bibi klo wɨlo kigbu riwa bi klo nga ri ngamba nye bi to he wa u won.<verse eid="JHN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 15:9" />Me nyɨme yi bibi riwa A ti nyɨme wen son rimi nyɨme won. <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />I bi hu tre won bi he rimi nyɨme won bibi riwa me hu tre A ti won nga meri son rimi nyɨme wan. <verse eid="JHN 15:10" /><verse number="11" style="v" sid="JHN 15:11" />&lt;&lt;Me tre nganyi yi ritu no kinkan sron won no he ri yi nga no kinklan sron tsra. <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />Itre won he ri: Nyɨme ngambi bibi riwa me nyɨme yi. <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />Inyɨme ri bran riwa wu he ri wu ri wa kpan wen a han riwa wu ka vri wen de ritu mba. <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />Ngha bi he kpan won i bi hu tre won, <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />Me ran ri yo yi iri gran ngara, ritu gran wa ran to kya riwa iti ko mba ri ti ran, Ara me yo yi ri wa kpan won ritu me la yi ri wa kpan won ritu me la yi kongye riwa me wo ri A ti won. <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />Biyi bi ran chu wen ran, ame me chu yi meri no yi hi bi ri klo wɨlo kigbu ka konkron bibi wɨlo wawa wa vu sron hi ri vi riwa a ran kre ran. Ngha ngamba nye A ti ri no yi kya riwa bi miyen rimi nde won. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />Rinyie he tre won riwa me no yi, iri ri no yi nyɨme ngambi.<verse eid="JHN 15:17" /></para>
  <para style="s">Mgbumgblume kawan ri wa hu Yeso</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />&lt;&lt;Ka mgbumgblume kawan ri yi bi ka taka ri a kawan ri me ri gbuchi. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />I bi ri he wa mgbumgblume, mgbumgblume ran nyɨme yi ka wa ma. Ama me chu yi ri mgbumgblume nyi nga bi ran he wa ma ran, ritu wan nye mgbumgblume kawan ri yi. <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />Taka kya riwa me la yi ri.&lt;Gran wa ran ri han ti ko mba ran.&gt;Yi ya ngawen; ka wa hu tsro won wa hu wambi ngawen. <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />Ama wa ti kyawa wa nyi ritu bi he wa mo; ritu wa ran to nji riwa a tiwen ndu ran. <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />Wari tre ri me ran ye la wa tre Izhi ran wari ran vu wa ri meme ti ran. Ama zizan wa ran he ri tre kya riwa wa tre ritu meme ti mba ran. <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />Inji riwa a kawan ri me a kawan ri A ti won ngawen. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />Wari tre ri me ran ti kya riwa injo ti zari to ran wari ran he ri meme ti ran ama zizan wa to kya riwa me ti nga wari kamba ri me nga A ti. <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />Rinyɨn a he ritu no tre riwa wa ngan ri doka mba no ye he kpunji,&lt;Wa kamba ri me a ran ritu kyari ran. <verse eid="JHN 15:25" /><verse number="26" style="v" sid="JHN 15:26" />&lt;&lt;Me no nji ri dzon no zhu ri A ti ye ri yi wawu nye he Yuu ri kpunji ri wa ari zhu ri A ti, wawu nye ri tre ritu won. <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />Ngha biyi ngawen bi tre ritu won ritu bi he ri me zhu ri mimɨlan.<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />&lt;&lt;Me tre rinyi ri yi ritu bi ri ran ban gon rimi kpanyɨme mbi ran. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />Wa dzu yi rimi wa tra bubu kabru tu nji Yahuda ivi ri ye riwa wawa wa wuu yi wari yonga ri wa wa wa hu Izhi. <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />Inji wa ti kyawa wanyi ri yi ritu wa ran to A ti ko ame ran. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />Ama me la yi ri nyi ritu i ivi ye riwa wa ti kyawa wanyi bi ka taka kya ri wa me layi. Ran la yi kya wanyi ri mimɨlan ran ritu me he ri yi.<verse eid="JHN 16:4" /></para>
  <para style="s">Indu Yuu Tsitsri</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5" />Ama zizan me hi ri nji riwa a ti wen ndu ama ba njo rimi minyi ran. <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />Ngha zizan riwa me la yi isron mbi sho ri shnji sron. <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />Ama me la yi kpunji tre a bi riwa me hi ritu i me ran hi ran nji ri dzon yi-a ran ye ri yi ran. Ama ka me hi me ti-u ndu ri yi. <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />Ngha i a ye ari no nji wa mgbumgblume no wa to ri irimɨren mba ritu meme ti nga kya riwa a tsra nga bla tre Izhi. <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />Irimɨren mba ritu meme ti ran tsra ran ritu wa ran kpanyɨme ri me ran; <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />Wa ran rimɨren tsra ritu kya riwa a tsra ran ritu me hi ri A ti nga bi ran to wen ngaran; <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />Wa ran rimɨren tsra ritu bla tre ran ritu wa gbuchi bla tre ri wa rinkon wa mbgumgblume nyi-e. <verse eid="JHN 16:11" /><verse number="12" style="v" sid="JHN 16:12" />&lt;&lt;Me he ri kyawa kigbu riwa me la yi, ama zizan ari naa yi wo ri bubu ngɨzhi. <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />Ka Iyu-a ye ari ŋɨran kpunji ritu Izhi, ari tsro yi nkon kpunji. Aran ri tre ri gbengbren wan ran ama ari tre ritu kya riwa a wo nye nga ari la yi kyawa riwa ari ye. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />Inji ri dzon ri no wen mkpen ritu ari ban kya riwa me tre ran la yi. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />Ikya riwa A ti he ri wa ri sron; ritu wan nye me tre ri Iyu ri ban kya riwa me no ran la yi.<verse eid="JHN 16:15" /></para>
  <para style="s">Shnji sron nga kinklan sron.</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />&lt;&lt;Kugon vi tsawen bi ran to wen ran nga kugon vi tsawen bi to wen.&gt;&gt;<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />Wari rimi miri ndu-a waka miyen ngamba ri,&lt;&lt;Rinyi ri tre ritu ngye nye? A la ta ri ki ran to wawu ran ri vi tsawen nga ra tre ri ki to wawu kugon vi tsawen; nga ran bru tre vi,&lt;A he ritu me hi ri A ti.&gt; <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />Ingye nye&lt;Ivi tsawen&gt; Nyin ri tre ritu wan? Ki ran to kya ri wa ari tre ritu wan ran!&gt;&gt;<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />Yeso a to ri wa wa wari miyen wawu tre imba ka la wa ri,&lt;&lt;Me tre ri,&lt;Ri vi tsawen bi ran to wen ran nga ri kugon vi tsawen bi to wen &gt;Wawu nye bi miyen ngambi ritu wan? <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />Me la yi kpunji tre bi yi ri shnji sron ama mgbumglume ri ngɨri bi ti shnji sron ama shnji sron mbi ri kɨma ti kinklan sron. <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />Ka iwaa gon ri ngɨzhi ari ti shnji sron ritu ivi wan ye, ama ka a ngɨzhi vren-a ari kpawulusu ri Yaa riwa a so-a ritu a ti kinklan sron ritu wa ngɨzhi vren ye ri mgbumgblume. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />Nghamba nye a he ri yi Zizan bi ti shnji sron ama me bru to yi nga isron mbi ri sho ri ngɨri bibi ngɨri riwa injo ran to ban wu zho ri yi ran. <verse eid="JHN 16:22" /><verse number="23" style="v" sid="JHN 16:23" />&lt;&lt;Ka ivi mba ye, bi ran miyen wen kyari ran me la yi kpunji tre A ti ri no yi kya riwa bi miyen rimi nde won. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />Ye zizan bi ran miyen wen kya ri rimi nde won rina, miyen nga bi fe wu ritu no kinklan sron mbi no kigbu.<verse eid="JHN 16:24" /></para>
  <para style="s">Ihan Mgbemgbren mgbumgblume.</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />&lt;&lt;Me ti ndu ri tre kɨbukɨbu me ri la yi kya wanyi. Ama ivi ri ye riwa me ran ti ndu ri tre kɨbukɨbu nga ran ama me tre ri yi ri riraa ritu A ti. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />Ka ivi-a ye bi miyen-u rimi nde won; nga me ran tre ri me miyen-u ri yi ran, <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />ritu wawu A ti kyuwan nyɨme yi. A nyɨme yi ritu biyi bi nyɨme wen nga bi ri yosron ri me dzu ri A ti nye. <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />Ame me zhu ri A ti nye ye me gra ri mgbumgblume ri don meri bru ri hi ri A ti.&gt;&gt;<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />Imba imri ndu Yeso waka tre ri wu ri,&lt;&lt;Zizan wu tre ri riraa wu ran ti ndu ri tre kɨbukɨbu ngaran. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />Ki to zizan ri wu to kongye, wu to nyɨme tre ri ko no njo no miyen-u. Rinyɨn no ta ki nyɨme ri wu zhu ri Izhi nye.&gt;&gt; <verse eid="JHN 16:30" /><verse number="31" style="v" sid="JHN 16:31" />Yeso ka nyɨme ri wa ri,&lt;&lt;Bi kpanyɨme zizan? <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />Ivi riye nga a ye zhu-e riwa wawumbi bi shan, ko ngaa mbi ri hi ko wan nga me he ri nkankshi won. Ama me ran he ri nkannkshi won kpunji ran ritu A ti ri he ri me. <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />Me la yi rinyi ritu bi ri he ri sisron ritu kabru tu ri me. Mgbumgblume ri no yi so Yaa Ama bi vu sron ritu me han gbengbren mgbumgblume-e.&gt;&gt;<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">Yeso a bre Izhi ri miri ndu wan.</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />Kugon riwa Yeso a tre nganyi kre, ka nzu si ya shu ran tre,&lt;&lt;A ti won, ivi-a ye-e. No vren wen mkpen ritu no wawu ngawen no no-u mkpen. <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />Ritu wu no gbengbren ritu nji wawu, ritu no wa fe vɨri riwa a ran kre ran. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />Rinyi nye he vɨri riwa a ran kre ran-a ri tre ritu no wa to-u Izhi ri kpunji ka kre, nga no wa to Yeso Kristo riwa wu ti-u ndu ye. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />Me no-u mkpen ri meme me ri kre ndu riwa wu no wen me ti. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />A ti no wen mkpen ri kusi wen zizan, bibi mkpen riwa ki he ri wu ka wa ran ti mgbumgblume nyɨn rina.<verse eid="JHN 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />&lt;&lt;Me no wawa wu ka wa no wen ri mgbumglume no wa to-u, wa he wa me nga wu ka wa no wen wa hu tre wen, <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />nga zizan wa to ri ko ngye riwa wu ka no wen a zhu ri wu nye. <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />Me la wa tre riwa wu la wen, nga wa kpa, nga wa to ri kpunji tre nye me zhu ri wu, nga wari kpanyɨme ri wu ti wen ndu.<verse eid="JHN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9" />&lt;&lt;Me bre Izhi ri wa, me ran bre Izhi ri mgbumgblume ran, ama ri wawa wu ka wa no wen ritu wa he wa me. <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />Kongye riwa me he ri wu a he wa me, nga kongye riwa wu he ri wu a he wa mo, nga me fe mkpen ritu mba. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />Ngha zizan me ye ri wu, me ran he wa mgbumglume ngran, ama wa he ri mgbumgblume. A ti ri Tsitsri; milan wa kadzi ri gbengbren nde wen inde riwa wu no wen ritu no wa he riri bibi riwa kita mbu-u ki he riri. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />Riwa me he ri wa me milan wa kadzi ri mgemgbren nde wen inde riwa wu ka no wen, me milan wa ya nga ko ri rimi mba ka ran kado ran, ka ra nji riwa wa ka dzi ri ari kado bibi riwa itre mbe Izhi no he kpunji. <verse eid="JHN 17:12" /><verse number="13" style="v" sid="JHN 17:13" />Ngha zizan me ye ri wu nga me tre kya nyi ri mgbumgblume ritu no wa fe kinklan sron bran ri sron mba. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />Me la wa tre wen nga mgbumgblume wa kamba ri wo ritu wa ran he wa mgbumgblume ran bibi riwa ame me ran he wa mgbumgblume ran. <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />Me ran bre wu ritu wu ri ban wa zho ri mgbumgblume ran, ama me bre wu wuri milan wa ki ritu memenji. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />Bibi riwa me ran he wa mgbumgblume ran, wawa ngawen wa ran he wa mgbumgblume ran. <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />Ka wa dzi nkan no wa he Tsitsri rimi kpunji wen ritu itre wen he kpunji. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />Me ti wa ndu hi ri mgbumgblume bibi riwa wu ti wen ndu hi rimi mgbumgblume. <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />Ritu mba nye me tsri ngawon ritu no wa tsri wa ri kpunji ri wu.<verse eid="JHN 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />&lt;&lt;Me ran bre Izhi ri wa kakre ran, ama nga ri wawa wa yosron ritu tre mba riwa wa la wa. <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />Me ibreritu riwa no wa he riri wawu mba. A ti no wa he rimi mbu bibi riwa wu he rimi won nga ame ngawen me he rimi wen. No wa he riri bibi riwa mgbumgblume ri kpa nyɨme ri wu ti wen ndu. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />Me no wa bibi mkpen riwa wu no wen bibi riwa wa he riri bibi riwa kita mbu-u ki he riri. <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />Ame me he rimi mba nga a wu wu he rimi won bibi riwa mgbumgblume ri to iri wu ti wen ndu nga wu ri nyɨme wa bibi riwa wu nyɨme wen.<verse eid="JHN 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24" />&lt;&lt;A ti, wu ka wa no wen nga me wa no wa he ri me ri bubu riwa me he bibi riwa no wa to mkpen won imkpen riwa wuwu ka no wen ritu wu nyɨme wen ri ko wati mgbumgblume. <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />A ti ri ndindi ti, mgbumglume ran to-u ran ama ame me to-u, nga wa to ri wu ti wen ndu. <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />Me no wa to-u, nga me sondu ran ti ngamba ritu bibi nyɨme riwa wu he ri wu ri mo no he ri wa ngawen nga ritu ame ngawen me he rimi mba.&gt;&gt;<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">Wa vu Yeso</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />Kugon riwa Yeso a kre bre Izhi, wawu nga miri ndu wan waka rugran wɨloba ri Kidron hi kugran ri wan, izhu ri a he ri kugran ba nga Yeso nga miri ndu wan waka hi ri mi bubu wan. <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />Yahuda ivren ndu riwa a ka Yeso rea to bubu wan ritu Yeso nga miri ndu wan wa kabru ri bubu wan. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />Imba Yahuda ka hi ri zhu-a wawu nga gbu wa klukpa riwa Roma nga wa gben ri tra bubu bre Izhi wawa wa rinkon wa sro yii nga Farisa wa ti wa ndu wa ngɨzhi wa kpi ku nga wa wulu pitila nga tochi. <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />Yeso a to kongye riwa ari fe wu, imba ka hwi hi kusi ran miyen wa ri,&lt;&lt;Ingaa nye bi wa?&lt;&lt;<verse eid="JHN 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5" />Waka tre ri,&lt;&lt;Yeso nji Nazaret&lt;&lt;Yahuda riwa a ka Yeso re-a ka kri ri wa ri bubu wan. <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />Riwa Yeso a tre ri wa ri,&lt;&lt;A he a me nye.&gt;&gt;Waka chiwi ban gon wari ku ri meme. <verse eid="JHN 18:6" /><verse number="7" style="v" sid="JHN 18:7" />Yeso ka bru miyen wa nganga ri,&lt;&lt;Ingaa nye bi wa?&gt;&gt;Waka tre ri,&lt;&lt;Yeso nji Nazaret nye.&gt;&gt;<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />Yeso ka la wa ri,&lt;&lt;Me gbuchi la yi-e ri a he ame nye ka ame nye bi wa bi ka no ngbron nji no wai ngamba.&gt;&gt; <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />A tre ngamba ritu kya riwa a tre-a no he kpunji,&lt;&lt;A ti ko ri rimi wawa wu ka wa no wen ran kado ran.&gt;&gt;<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />Sima Bitrus riwa a he ri njimgban ka chu wu ran ka sren mvumvuton gran rinkon wa sro yii-a ri kuwo ri taga inde gran a he Malkus.<verse eid="JHN 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 18:11" />Yeso ka la Bitrus ri,&lt;&lt;ka njimgba wen ka son rimi raan wan, wu yonga me ran so rimi vaŋo ri yaa riwa A ti ka no wen-a ran?&gt;&gt;<verse eid="JHN 18:11" /></para>
  <para style="s">Wa ngɨzhi Yeso hi kusi Hannana rinkon wa sro yii</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />Imba wa klukpa wa Roma iwawa wa rinkon mba nga wa gben wa nji Yahuda waka vu Yeso wa lo-u ri zhizhi, <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />nga wa ngɨzhi-u hi ri Hannana. A he ti waa Kayafa nye riwa a he rinkon wa sro yii ri se wan. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />A he wawu Kayafa nye a ŋoron wa rinkon wa nji Yahuda-a ri a bi no nji riri no kuu ritu nji wawu.<verse eid="JHN 18:14" /></para>
  <para style="s">Bitrus a tron to Yeso</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />Sima Bitrus nga vrenndu ri waka hu Yeso. Rinkon wa sro yii-a a to vren ndu ri wan-a branbran, imba ka hu Yeso hi ri kana ko nji rinkon wa sro yii-a, <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />ama Bitrus a kri ri raa ri nyu nkon ko-a. Imba ivren ndu ri wan a ka bru ye raa ran ye tre ri vra-a ri nyun nkon ko-a ran ngɨzhi Bitrus hi rimi ko-a. <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />Ivra riwa a he ri nyun nkon ko-a ka miyen Bitrus ri,&lt;&lt;A wu ngawen wu ran he rimi miri ndu nji mu-a ran;&gt;&gt;Bitrus ka tre ri,&lt;&lt;Onhon me ran he rimi mba ran.&gt;&gt;<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />Isi a ran ti, imba wa ndu nga wa gben waka mme kɨreri meme wari sro kla wulu rimi wan wari ki kagon wan ran so gbaji wulu. imba Bitrus ka hi ri wa ran kri ran so gbaji wulu riwa ngawen.<verse eid="JHN 18:18" /></para>
  <para style="s">Rinkon wa sro yi a ran miyen Yeso</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />Rinkon wa sro yii a miyen Yeso ritu miri ndu wan nga tsro wan. <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />Yeso ka nyɨme riwu ri,&lt;&lt;Me sondu ran tre ri rira ri ko ngaa itsro won wawu wa he ri tra bubu kabru tu nji Yahuda nga ri tra bubu bre Izhi ri bubu riwa nji wawu wa ye kabru tu ri bubu wan me ran la yi kya ri yayɨbi zari ran. <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />Ritu ngye bi miyen wen? miyen nji wawa wa wo wen, wawa wa to kya riwa me tre.&gt;&gt;<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />Riwa Yeso a tre rinyi, iri rimi wa gben ka wuruu, ran tre ri rinkon wa sro yii ngamba!&gt;&gt;<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />Yeso ka nyɨme wa ri,&lt;&lt;Ka me tre kya riwa a ran tsra ran bi ka la ko ngaa ri nyi ikya riwa a he. Ama ka tre riwa me tre a tsra ko ritu ngye ko wu wuru wen?&gt;&gt;<verse eid="JHN 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24" />Imba Hannana ka bru no wa ngɨzhi-u ri lilo hi ri Kayafa rinkon wa sro yi.<verse eid="JHN 18:24" /></para>
  <para style="s">Bitrus a Bru Tron to Yeso ri Mkpa ri Han</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />Bitrus a kawan kri ri bubu wan ran nzawo wulu. Imba wari waka tre ri wu ri,&lt;&lt; A wu wu ran he ri rimi miri wandu nji nyi ran?&gt;&gt;Bitrus ka tron ri, &lt;&lt;Onhon, wawu ran he ri wa ran.&gt;&gt;<verse eid="JHN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26" />Ye zizan Bitrus ka kawan kri ri kusan wulu ran so gbaji wulu imba ngbron mba waka la-u ri,&lt;&lt;Wu ran he ri rimi miri ndu nji mu ran.?&gt;&gt; <verse eid="JHN 18:26" /><verse number="27" style="v" sid="JHN 18:27" />Bitrus ka tron nganga ri,&lt;&lt; Onhon&gt;&gt;Ngha kuko ka tɨbu.<verse eid="JHN 18:27" /></para>
  <para style="s">Wa ngɨzhi Yeso hi kusi Bilatu</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />Ri babuu mbɨre wa ban Yeso ri ko Kayafa hi ri trankon bla tre riwa rikon gbu, wa rinkon wa nji Yahuda wa ran gra rimi tra nkon bla tre-a ran ritu wa ran wa wari tsri ngamba ri kusi Izhi bibi riwa waka to ri ri ri dza gran. <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />Bilatu ka hi ri wa ri raa ran miyen wa ri,&lt;&lt;Bi vu nji nyi ri meme ti bibi tan nye?&gt;&gt;<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />Waka nyɨme ri wu ri,&lt;&lt;Wari tre ri a ran ti meme ti kyari ran ki ri ran ngɨzhi-u ye ri wu ran.&lt;&lt; <verse eid="JHN 18:30" /><verse number="31" style="v" sid="JHN 18:31" />Bilatu ka tre wa ri,&lt;&lt;Biyi kyumbi ban wu hi bi ri tsra-u bibi riwa doka mbi tre.&gt;&gt;Nji Yahuda waka nyɨme wu ri,&lt;&lt;Ki ran he ri gbengbren riwa ki wu njo ran.&gt;&gt; <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />Rinyi a ti ritu no tre Yeso no tsra riwa a tre ritu bibi kuu riwa wawu ri kuu. <verse eid="JHN 18:32" /><verse number="33" style="v" sid="JHN 18:33" />Bilatu ka bru hi rimi trankon wan ran miyen Yeso ri&lt;&lt;A wu nye wu he chu nji Yahuda?&gt;&gt; <verse eid="JHN 18:33" /><verse number="34" style="v" sid="JHN 18:34" />Yeso ka nyɨme wu ri,&lt;&lt;Imiyen nyi zhu ri wu nye ka injo ri nkan la-u ritu won?&gt;&gt; <verse eid="JHN 18:34" /><verse number="35" style="v" sid="JHN 18:35" />Bilatu ka nyɨme ri,&lt;&lt;Wu yonga me he nji Yahuda? A he wa nji wa nyi nga rinkon wa sro yii nye wa ka-u ka no wen, ingye nye wu ti?&gt;&gt; <verse eid="JHN 18:35" /><verse number="36" style="v" sid="JHN 18:36" />Yeso ka tre ri,&lt;&lt;Kpanchison won ran he wa mgbumgblume nyɨn ran wari tre ri kpanchison won he wa mgbumgblume nyi wawa wa hu wen wari ran no wa kawen no wa rinkon wa nji Yahuda ran, onhon, kpanchison won ran he wa mgbumgblume ran!&gt;&gt; <verse eid="JHN 18:36" /><verse number="37" style="v" sid="JHN 18:37" />Imba Bilatu ka miyen-u ri,&lt;&lt;A wu wu he chu nye?&gt;&gt;Yeso ka nyɨme ri wu ri,&lt;&lt;A wu kyuwen nye wu tre ri me he chu, wa ngɨzhi wen ye ri mgbumgblume ritu kya riri nye ritu me ri tre ritu kpunji, nji riwa a he wa kpunji-a ri wo wen.&gt;&gt; <verse eid="JHN 18:37" /><verse number="38" style="v" sid="JHN 18:38" />Bilatu ka miyen ri,&lt;&lt;Ngha ingye nye he kpunji-a?&gt;&gt;Imba Bilatu ka bru hi ri raa ri wa nji-a ran tre wa ri,&lt;&lt;Me ran fe nji nyi ri meme ti kyari riwa me wuu-u ran.&gt;&gt;<verse eid="JHN 18:38" /></para>
  <para style="s">Wa Kazdi riwa wa Wuu Yeso</para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 18:39" />Wa nyɨme riwa wa wuu Yeso <verse eid="JHN 18:39" /><verse number="40" style="v" sid="JHN 18:40" />Waka nyɨme ri wu ri kpagro ri,&lt;&lt;Onhon a ran wawu ran! ki wa no wa chu Barabas nye wo!&gt;&gt;Barabas a he nji ri yɨbi nye.<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />Imba Bilatu ka no wa tsi Yeso ri gbagba. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />Wa klukpa waka ti tsrotu ri ri ganran nchon nga wari ka son ri wu ri Yeso ri tu, imba wari ban tsro ri bibi wa chu ri ima klo mgbada kasuu ri wu, <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />nga wari ye tre wu ri,&lt;&lt;No vi wen no ban kusi a wu chu wa nji Yahuda!&gt;&gt;Ngha wari hon hi wari ka wuru-u.<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />Bilatu ka bru hi ri wa ri raa nganga ran tre ri jɨbu nji-a ri,&lt;&lt;Ya me ngɨzhi-u ye no yi ri raa rinyi no yi to ri me ran vu nji nyi ri meme ti kyari ran.&gt;&gt; <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />Imba Yeso ka zhu ri raa ri tsrotu wa chu riwa wa ti-u ri nchon nga tsro bibi wa tre wa ri,&lt;&lt;Ingye nji a-en!&gt;&gt;<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />Riwa rinkon wa sro yii nga wa wa gben ri tre bubu bre Izhi wa to-u waka kpagro ri,&lt;&lt;Kpan-u ri konkron! Kpaa-u ri tu konkoron!&gt;&gt;Bilatu ka tre wa ri,&lt;&lt;Biyi ban wu inga bi ri kpan-u ri tu konkron ame me ran vu ri meme ti kya ran&gt;&gt;<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />Ijɨbu nji-a waka nyɨme ri,&lt;&lt;Ki he ri doka riwa a tre ri a he riwa wa wuu ritu a ban ngawan ri wawu he vren Izhi.&gt;&gt;<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />Riwa Bilatu a wo tre-a ka ti Sisiri bran. <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />Ka bru hi ri trankon ran miyen Yeso ri,&lt;&lt;Wu zhu kutan nye ye?&gt;&gt; Ama Yeso ka ran nyɨme ri wu ran. <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />Bilatu ka tre ri wu ri,&lt;&lt;Wu ran tre ri me ran? Taka ri me he ri gbengbren riwa me kpa-u chuwo nga me ri no wa kpan-u ri tu konkron?&gt;&gt;<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />Yeso ka nyɨme wu ri,&lt;&lt;Wu he ri gbengbren ri tu won kakre ritu Izhi nye ka no-u nji riwa a ka wen no-u a ti meme ti han-u.&gt;&gt;<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />Riwa Bilatu a wo ngamba ka wa nkon riwa ari kpa Yeso chuwo. Ama ijɨbu nji-a waka kpagro ri,&lt;&lt;Ka wu kpaa chuwo rimba ri tsro ri wu ran he kpan Kaisar ran! Inji riwa a ban ngawan ri wawu he chu ari wanyu!&gt;&gt;<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />Riwa Bilatu a wo kya riwa ikpanji wa tre, ka ngɨzhi Yeso hi ri raa ran son ri tu kpanchi riwa rinkon wa bla tre ri son ri bubu riwa wa yo-u ri,&lt;&lt;Tita ri chan tra.&gt;&gt;Ri rɨme Aramaya a he,&lt;&lt;Gabata.&gt;&gt; <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />Chachu a he chachu vi ro ri dza gran a he hwɨreri tsutsu zhi, Bilatu ka la nji ri,&lt;&lt;Ingye ngaa ichu mbi-en!&gt;&gt;<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />Waka ran kpagro ri,&lt;&lt;No wa wuu-u no wa wuu-u! No wa kpan-u ri tu konkoron!&lt;&lt;Bilatu ka miyen wa ri,&lt;&lt;Bi wa me kpan chu mbi ri tu konkron?&lt;&lt;</para>
  <para style="p" vid="JHN 19:15">Wa chu wa sro yii waka nyɨme ri,&lt;&lt;Ki ran he ri ichu ri nkan ran ara ichu Kaisar!&gt;&gt;<verse eid="JHN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16" />Imba Bilatu ka ka Yeso no wa no wa kpan-u ri tu konkron. Imba waka ban Yeso hi ngamba<verse eid="JHN 19:16" /></para>
  <para style="s">Wa Kpan Yeso ri tu Konkron</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17" />Yeso ka ba konkron riwa wa kpanu-a ran ye ri bubu ri wa yo-u ri,&lt;&lt;Bubu mgborotu.&gt;&gt;Wa yo bubu ri rɨme Aramaya ri,&lt;&lt;Golgota&gt;&gt; <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />Ri bubu wan nye wa kpan Yeso wari kpan nji hari wari ri wu, wa kpan wa kuwo haha mba nga wari ka Yeso yo ri tsutsu mba.<verse eid="JHN 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 19:19" />Bilatu ka ngan mbe ran ka kpan ri tu konkron-a, angan ri,&lt;&lt;Yeso nji ri Nazaret, ichu Yahudawu.&gt;&gt; <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />Ikpanji waka kra ngan-a, ritu bubu riwa wa kpan Yeso ri tu konkron he hwɨreri gbu, wa nganngan-a ri rɨme Aramaya ri rɨme Roma nga ri rɨme Helenawa. <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />Wa chu wa sro yii wa la Bilatu ri,&lt;&lt;Ran ngan ri ichu nji Yahuda ran tsede wu ka ngan ri nji nyi tre ri ame me he chu nji Yahuda.&gt;&gt; <verse eid="JHN 19:21" /><verse number="22" style="v" sid="JHN 19:22" />Bilatu ka tre ri&lt;&lt;Ikya riwa me ngan a kukri.&gt;&gt;<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />Kugon riwa wa klukpa wa kpan Yeso ri tu konkron, wa ban tsro wan wari yɨra-u ti ŋɨma nza, ko ngaa ri wama nga wari ban guglo tsro wan riwa wa ran wuran-u ran ama wa lo-u ri shu ye ri meme. <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />Wa klukpa-a wa tre ri ngamba ri,&lt;&lt;Kiran gbon ran ama ki tamgbe ri wu kiri to ko ingaa ri ri.&gt;&gt;Rinyi a he ritu no tre mbe Izhi no tsra,&lt;&lt;Wa yɨra tsro wan ga ngamba nga wari tamgbe ritu tsro won.&gt;&gt;Ngha ingye kya riwa wa klukpa-a wa ti-en.<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />Wawa wa kri kusan konkron riwa wa kpan Yeso wa he wa yi Yeso nga vayi yi wan Meremu iwaa Kilobas nga Meremu riwa a zhu ri Magadala. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />Riwa Yeso a to yi wan nga vren ndu wan riwa a nyɨme-u imba ka la yi wan ri,&lt;&lt;Iwaa, ingye vren wen-een.&gt;&gt;<verse eid="JHN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27" />Ngha ran la vren ndu wan ri,&lt;&lt;A he yi wen nye.&gt;&gt;Zhu ri chachu wan ivren ndu Yeso ka ban wu hi no son ri ko wan<verse eid="JHN 19:27" /></para>
  <para style="s">Ikuu Yeso</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />Yeso a to ri ri vi-a kongye ri kre-e nga no tre mbe Izhi no tsra ka tre ri,&lt;&lt;Ila ima ri ti wawu.&gt;&gt; <verse eid="JHN 19:28" /><verse number="29" style="v" sid="JHN 19:29" />Imgbu ri a he ri bubu wan riwa iima inabi riwa a ti mgban, wa son soso rimi ima ri mgban-a wari ka son ri kpala izob wari ngɨzhi hi ri Yeso ri nyu. <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />Yeso ka so ima ri mgban-a ran tre ri,&lt;&lt;A kre!&gt;&gt;Imba ka son tu gɨzhi ran ka vɨri wan chuwo.<verse eid="JHN 19:30" /></para>
  <para style="s">Wa tɨbu Yeso ri Mashi Ri San</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />Imba wa rinkon wa nji Yahuda waka miyen Bilatu ri no chu wawa wo no wa nzuu kpɨrewawa wa kpan Yeso iwawa-a nga wa ri gɨzhi ri kɨmo mba ri meme wa miyen rinyi ritu a he chachu juma nga wana wa no kɨmo-a no wa ke chachu vi son vri ran ritu ivi son vri riwa ari ye a he vi tsitsri. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />Imba wa klukpa-a waka tren nji ri mimilan dza nga nji ri han wan wawa wa kpanwa iwa Yeso. <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />Ama riwa wa ye ri Yeso, waka to iri a kuu-e imba wa ran tren Yeso kpɨreran. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />Imba iri rimi wa kulukpa-a ka tɨbu Yeso ri mashi ri san ri bubu wan iyii imba ima ka zhu. <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />Nji riwa a to kya riwa a ti-a nye a tre rinyi ritu biyi ngawen bi ri kpa nyɨme ri ikya riwa a tre a he kpunji nga a to ri a tre kpunji nye. <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />Rinyi a he ritu no tre mbe Izhi no he kpunji&lt;&lt;Wa ran tren kuku wan ri ran.&gt;&gt; <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />Imbe tre Izhi ri a bru tre ri,&lt;&lt;Inji wa ya wawu riwa wa tɨbu-u a.&gt;&gt;<verse eid="JHN 19:37" /></para>
  <para style="s">No Yeso Yɨbi</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />Kugon rinyi, Yusufu riwa a zhu ri Arimatiya a he rimi miri ndu Yeso nye ama a he ri yayɨbi ritu a ran ti sisiri wa rinkon wa nji Yahuda, a bre Bilatu ri ko ari no wawu kɨmo Yeso hi ngawan, Bilatu ka nyɨme ri wu ka ban kɨmo Yeso hi ngawan. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />Nikodimus nji riwa a hi ri bubu to Yeso ri chu, wa hi imba Yusufu, a ngɨzhi kpi wa mɨwi raro mur nga alos ri gbanran riwa ari ke kilo setra. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />Inji hari-a Nikodimus nga Yusufu waka ban kɨmo Yeso wari nye-u ri ŋɨma tsro lilin nga kpi wa mɨwi raro ri bibi ti mba wa nji Yahuda riwa wa no nji yɨbi. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />Izhu ri a he ri bubu riwa wa wuu Yeso, rimi zhu-a wa ti bubu gru ri riwa wa ran yonji rimi wan to ran. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />Tunde a he vi ri ko ivi sonvri nga ritu bubu gru a he hyure ri bubu wan, waka ka kɨmo Yeso yo ri bubu wan.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">Itashɨme Yeso ri Bubu Gru</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />Ri bubu mibrechachu vi sonvri, riwa ibu ka ti ri, Meremu Magadaliya ka hi ri bubu gru ran ka to ka wa ban tita ri nyu bubu gru zho. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />Imba ka wulu ri tsu ye ri Sima Bitrus nga vren ndu riwa Yeso nyɨme-u, ran la wa ri,&lt;&lt;Wa ban Bachi zho ri bubu gru, nga ki ran to bubu riwa wa ka-u yo ran.&gt;&gt;<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3" />Imba Bitrus nga vren ndu-a waka hi ri bubu gru. <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />Haha mba wa ran tsutsu ama ivren ndu-a ka tsutsu han Bitrus ran gbuchi ka zhu ri bubu gru. <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />A dran ya ran to ŋɨma tsro lilin riwa wa ka Yeso, ama a ran gra rimi wan ran. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />Ri bubu wan Sima Bitrus ka ye kugon ran ye gra ri bubu gru ran to nghima tsro lilin-a kru ri bubu wan, <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />nga tsro riwa wa nye Yeso ri wu ri tu ka he ri ŋɨma ku ri nkan, a ran he ri bubu ri imba nghima tsro lilin-a a he ran. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />Imba ivren ndu Yeso riwa a gbuchi ka zhu-a ka gra ri bubu gru ngawen; ran ka to ran kpanyɨme. <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />Wa kamba ran to tu tre mbe Izhi riwa a tre ri Yeso ri tashime ri bubu gru ran. <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />Imba imiri ndu Yeso waka bru hi ngamba ko.<verse eid="JHN 20:10" /></para>
  <para style="s">Yeso a zhu ri Meremu ri Magadaliya</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />Meremu ka kri ri nyu bubu gru ran ran yi. Riwa a he rimi yi, ka dran ran ya bubu gru <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />ran to miri ko Izhi hari wa son ri tsro kinklan ri bubu riwa ikɨmo Yeso a ran he, iri a kri kutu nga riwan ka kri ku dza. <verse eid="JHN 20:12" /><verse number="13" style="v" sid="JHN 20:13" />Waka miyen-u ri,&lt;&lt;Iwaa, ngye ti ko wu yi?&gt;&gt;Ka la wa ri, &lt;&lt;Wa ban Bachi hi ngamba, nga me ran to bubu riwa wa ka-u dzi ran!&gt;&gt; <verse eid="JHN 20:13" /><verse number="14" style="v" sid="JHN 20:14" />Imba ka kɨma ran to Yeso kukri ri bubu wan, ama a ran to ri a he Yeso nye ran. <verse eid="JHN 20:14" /><verse number="15" style="v" sid="JHN 20:15" />Yeso ka miyen Meremu ri, &lt;&lt;Iwaa, ingye ti ko wu yi? Ingaa nye wu wa-u?&gt;&gt; Ka yonga mba a he nji riwa ari bwa ima ri wa konkron, imba ran tre ri wu ri, &lt;&lt; Ka wu ban wu hi ngawen nji rinko, la wen bubu riwa wu ka-u yo no wen me hi ban wu.&gt;&gt; <verse eid="JHN 20:15" /><verse number="16" style="v" sid="JHN 20:16" />Yeso ka tre wu ri, &lt;&lt;Meremu&gt;&gt; Maremu ka kɨma si hi ri wu ran tre ri rɨme Aramiyan ri, &lt;&lt;Rabani&gt;&gt;, Ituwan he ri, &lt;&lt;Inji ri tsro.&gt;&gt;<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />Yeso ka la-u ri, &lt;&lt;Ran ngɨzhi wen ran, ritu me ran hi ri A ti won ri shu mu rina. Ama bru hi ri wa miri vayi won wuri la wa ri, me bru kɨma ri hi ri wawu riwa a he A ti won ran he A ti mba ngawen, a he Izhi won ran he Izhi mba ngawen.&gt;&gt; <verse eid="JHN 20:17" /><verse number="18" style="v" sid="JHN 20:18" />Ri mba Meremu riwa a zhu ri Magadaliya ka hi ri wa miri ndu Izhi ran la wa ri,&lt;&lt; Wawu ka to Bachi.&gt;&gt;Ngha kya riwa Bachi la wawu.<verse eid="JHN 20:18" /></para>
  <para style="s">Yeso a Zhu ri Miri Ndu wan</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />Ri Yawulu chachu ladi ivi ri gbuchi rimi sati, nga miri ko Yeso waka kabru tu ki wari ka wa nkon tra, ritu wa ran ti sisiri wa rinkon wa nji Yahuda. Imba Yeso ka ye ran ye kukri ri wa ran tre ri, &lt;&lt;No sisron no he ri yi.&gt;&gt; <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />Kugon riwa Yeso a tre nganyi, ka tsro wa ndawo wan nga blasan wan. Imiri ndu wan waka ti kinklan sron branbran riwa wa to Bachi. <verse eid="JHN 20:20" /><verse number="21" style="v" sid="JHN 20:21" />Yeso ka bru tre wa nganga, &lt;&lt;No sisron no he ri yi. Bibi riwa A ti won ti wen ndu, ame ngawen me ti yi ndu.&gt;&gt; <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />Imba Yeso ka fu vɨri wan sro wa ran tre ri, &lt;&lt;Biyi kpa Yuu Tsitsri. <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />I bi ka meme ti wa nji rega ri wa, wa ka meme ti mba rega, ka bi ran ka meme ti wa nji rega ri wa ran, wa ran ka rega ri wa ran.&gt;&gt;<verse eid="JHN 20:23" /></para>
  <para style="s">Yeso Ngha Toma</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />Imba Toma riwa a he ri rimi miri ndu Yeso wuru don hari-a riwa (wa yo-u ri ngare), a ran he riwa ri vi riwa Yeso a ye wawu a ran he ri wa ran. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />Imba imgbron miri ndu Yeso waka la-u ri,&lt;&lt;Ki to Bachi!&gt;&gt;Toma ka la wa ri, &lt;&lt;I me ran to bwo bubu riwa wa kpan-u ri wo-a me ri son wo rimi wan nga ri blasan wan-a ran, me ran kpanyɨme ran.&gt;&gt; <verse eid="JHN 20:25" /><verse number="26" style="v" sid="JHN 20:26" />Kugon vi tandɨra, imiri ndu Yeso wa he rimi tra-a, nga Toma ka he ri wa. Nkon wa he ri ka, ama Yeso ka ye kukri ri wa ran tre ri, &lt;&lt;No sisron no he ri yi!&gt;&gt; <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />Imba Yeso ka la Toma ri, &lt;&lt;Yo vren wo wen ri nyi, nga wu ri ya wo won; wuri nɨme wo wen yo ri blasan won. Chu sron wen ri hari zho wu ri kpanyɨme!&gt;&gt; <verse eid="JHN 20:27" /><verse number="28" style="v" sid="JHN 20:28" />Toma ka kpanyɨme ri, &lt;&lt;Bachi won nga Izhi won!&gt;&gt; <verse eid="JHN 20:28" /><verse number="29" style="v" sid="JHN 20:29" />Imba Yeso ka la-u ri,&lt;&lt;Wu kpanyɨme ritu wu to wen nye? Dindi ti ri he wa wawa wa ran to wen ran ama wa kpanyɨme!&gt;&gt;<verse eid="JHN 20:29" /></para>
  <para style="s">Itu Nghan Mbe Nyin</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />Ri kusi miri ndu wan, wawu Yeso a ti kyawa wa de sisiri riwa wa ran ngan wa rimi mbe nyi ran. <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />Ama wa ngan wanyi ritu bi ri kpanyɨme ri Yeso he Kristo, ivren Izhi, nga dzu ri wu bi fe vɨri.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">Yeso a zhu ri Miri Ndu wan Tamgban</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />Kugon rimba, Yeso a bru zhu ri miri ndu wan nganga ri nyu nne Tibariya ri Galili. Ingye ngaa bibi riwa a zhu ri wa-a-en. <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />Sima Bitrus, Toma (riwa wa yo-u ri ngare), Nataniyel riwa a zhu ri meme Kana ri Galili, ivren Zabadi, nga miri ndu Yeso hari wawa wa he iwawa. <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />Sima Bitrus ka la mgbron mba ri, &lt;&lt;Me hi ri bubu vu lambe.&gt;&gt; Waka la-u ri,&lt;&lt;Kita ngawen ki hu-u.&gt;&gt;Imba waka zhu wari ka gra ri mvu ma-a wari hi, ama ri chu chachu mba wa ran vu kyari ran. <verse eid="JHN 21:3" /><verse number="4" style="v" sid="JHN 21:4" />Riwa inzan a ran zhu, Yeso ka kukri ri nyun nne, ama imiri ndu wan wana to ri a he Yeso nye ran. <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />Imba ka miyen wa ri, &lt;&lt;Imiri nze, bi ran vu kyari ran?&gt;&gt; Waka nyɨme ri, &lt;&lt; Ko kyari ran.&gt;&gt; <verse eid="JHN 21:5" /><verse number="6" style="v" sid="JHN 21:6" />Yeso ka la wa ri, &lt;&lt;Ta tsro ri vu lambe yo ku nghima wo ri mvu ima mbi nga bi vu lambe wari.&gt;&gt;Imba waka ta tsro ri vu lambe-a yo wa ran to gbi wu zhu raa ngaran, ritu a vu lambe kigbu. <verse eid="JHN 21:6" /><verse number="7" style="v" sid="JHN 21:7" />Imba ivren ndu Yeso riwa a nyɨme-u ka la Bitrus ri, &gt;&gt;A he Bachi nye.&lt;&lt;Riwa Bitrus a wo ri a he Bachi nye, ka ban tsro ri ka kpa wan ka nye ngawan ran, ran dza ku rimi ima. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />Imgbron miri ndu Yeso waka ye ri nyun nne-a rimi mvu ima-a, wari ran gbi tsro ri vu lambe riwa a sho ri lambe. Wa ran he kpata ri nyu nne-a ran, a he dza gbigba ri nye hi ri bubu riwa wa ran he. <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />Riwa wa zhu ri nyu nne-a, waka to klawulu ri lambe ri tu wan nga vi jujuyɨmo. <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />Imba Yeso ka la wa ri,&lt;&lt;Ngɨji lambe wari rimi riwa bi vu-a ye.&gt;&gt;<verse eid="JHN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11" />Sima Bitrus ka dza hon ri tu mvu ma-a ran gbi tsro ri vu lambe-a riwa a sho ri lambe wa wuloga rimi wan, lambe-a wa he gbigba ri ri seton don tra, ama kau ri kigbu lambe-a itsro ri vu lambe-a a ran gbon ran. <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />Yeso ka tre wa ri, &lt;&lt;Ye ri ri yi.&gt;&gt;Njo rimi wa miri ndu wan ka ran to miyen-u ri,&lt;&lt; Wu he ngaa ran?&gt;&gt; Ritu wa to ri a he Bachi nye. <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />Imba Yeso ka ye ran ban jujuyɨmo, nga ran ka no wa, nga ran ban lambe ngawen ran ka no wa. <verse eid="JHN 21:13" /><verse number="14" style="v" sid="JHN 21:14" />Rinyi nye a he mkpa ri tra riwa Yeso a zhu ri miri ndu wan kugon riwa a tashime ri bubu kuu.<verse eid="JHN 21:14" /></para>
  <para style="s">Yeso Ngha Bitrus</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />Kugon riwa wa ri ri kre, Yeso ka la Sima Bitrus ri, &lt;&lt;Sima ivren Yohana, wu nyɨme wen han bibi riwa ngbron nji wa nyɨme wen?&gt;&gt; Ka nyɨme ri, &lt;&lt;Een Bachi, wu to bibi riwa me nyɨme.&gt;&gt; Yeso ka tre wu ri, &lt;&lt;No wa ntɨma won ri.&gt;&gt; <verse eid="JHN 21:15" /><verse number="16" style="v" sid="JHN 21:16" />Imba Yeso ka bru tre wu ri mkpa ri hari, &lt;&lt;Sima ivren Yohana, wu nyɨme wen? &gt;&gt;Sima Ka nyɨme ri, &lt;&lt;Een Bachi, wu to ri me nyɨme-u.&gt;&gt; Yeso ka tre wu ri, &lt;&lt;Ho ntɨma won ri mo.&gt;&gt; <verse eid="JHN 21:16" /><verse number="17" style="v" sid="JHN 21:17" />Yeso ka bru tre wu ri mkpa ri tra ri, &lt;&lt;Sima ivren Yohana, wu nyɨme wen han bibi riwa imgbron nji wa nyɨme wen?&gt;&gt;Bitrus ka ti fu ritu Yeso miyen wawu ri mkpa ri tra ri,&lt;&lt; Wu nyɨme wen?&gt;&gt;Imba Ka tre wu ri, &lt;&lt; Bachi, wu to ko ngye; wu to ri me nyɨme-u!&gt;&gt; Yeso ka tre wu ri, &lt;&lt;Ho ntɨma won ri mo. <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />Me la-u kpunji tre: riwa wu ran he ri nze wen, wu to wulunde hi ri ko kutan riwa wu wa wuri hi; ama riwa wu kunchon, wu nime wo nga wu ri su tsro wen, injo ri nkan ran suu kpi ri wu ran ngɨzhi-u hi ri bubu riwa wu ran wa wuri hi ran.&gt;&gt; <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />Yeso a tre nganyi ritu no tsro bibi kuu riwa Bitrus ri kuu riwa ari ngɨzhi mkpen ye ri Izhi. Imba Yeso ka tre ri wu ri, &lt;&lt;Hu wen!&gt;&gt;<verse eid="JHN 21:19" /></para>
  <para style="s">Yeso Ngha Vren Ndu wan ri</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />Bitrus ka kɨma ya kugon ran to vren ndu riwa Yeso nyɨme-u-a ri hu wawa, wawu nye a he hyure ri Yeso riwa wa ran ri ri ri ro ri dza gran ran miyen Yeso ri, &lt;&lt;Bachi, ingaa nye ri ka-u re?&gt;&gt; <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />Riwa Bitrus a to vren ndu wan riwa a nyɨme-u-a , ka miyen Yeso ri,&lt;&lt;Bachi, ko nji nyi fa?&gt;&gt; <verse eid="JHN 21:21" /><verse number="22" style="v" sid="JHN 21:22" />Yeso ka nyɨme ri wu ri,&lt;&lt; Ka me tre no son hi ri vi riwa me bru ye, rimba ri he ngye ri wu? Hu wen!&gt;&gt; <verse eid="JHN 21:22" /><verse number="23" style="v" sid="JHN 21:23" />Imba itre ka shan kagon rimi wawa wa hu Yeso ri ivren ndu Yeso ran kuu ran. Ama Yeso a ran tre ri a ran kuu ran; a tre ri,&lt;&lt;Ka me wa no son hi ri vi riwa me bru ye, rimba he ngye ri wu?&gt;&gt; <verse eid="JHN 21:23" /><verse number="24" style="v" sid="JHN 21:24" />A he vren ndu riwa a tre ritu kya wanyi, nga ran ngan wa dzi; nga ki to ri ikya riwa a ngan he kpunji.<verse eid="JHN 21:24" /></para>
  <para style="s">Ikre Wan</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />Zizan, imgbron kyawa kigbu wa he wawa Yeso a ti wa. Wari tre wa ngan wa dzi yiyiri, me ran to ko mgbumgblume wawu ri to ngɨzhi mbe riwa wa ngan ran.<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>