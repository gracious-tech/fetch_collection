<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Dawuro Full Bible Latin Version</book>
  <para style="h">1 Yohaannisa Kiitaa</para>
  <para style="toc1">Yohaannisi S'aafeedda Koyro Kiitaa</para>
  <para style="toc2">1 Yohaannisa Kiitaa</para>
  <para style="toc3">1 Yoh.</para>
  <para style="mt1">Yohaannisi</para>
  <para style="mt2">S'aafeedda Koyro Kiitaa</para>
  <para style="imt">Geluwaa</para>
  <para style="ip">Yesuusi kiitteedda Yohaannisi s'aafeedda koyro kiitay, laa"u huup'e k'ofatuwaa oyk'k'eedda; hewanttukka: nabbabiyaawanttoo S'oossaannanne Aa na'aa Yesuusi Kiristtoosanna ittippetetsay de'anaadan mentsetsanaassanne ha ittippetetsaa d'ayissanaw danddayiyaa worddo timirttiyaappe unttunttu haakkana mala, minisiide akeekissanaassa. He wode denddeedda worddo timirttii «Iitatetsay pulttiyaawe ha nuuni de'iyaa wolk'k'aama alamiyaanna gakettiyaa gaketsaanna gidiyaa diraw, S'oossaa Na'ay Yesuusi mulekka asaa gidanaw woy, asatetsaa eeshshay aw de'anaw danddayenna» yaagiyaawaa. He asttamaaratuu, «Atotetsaa guussay alamiyaa de'oo un"ettiyaawaappe la"a kesiyaawaa» yaagiino. Hewaa bollaakka k'ay «Iitaanne keekaa shaakkiide oyk'k'iyaawaa woy, hara asaw siik'uwaa bessiyaawaa gidooppekka, atotetsaana unttuntta gatsiyaabay baawa» yaagiino.</para>
  <para style="ip">S'aafii ha timirttiyaa ek'ettiide, «Yesuusi Kiristtoosi polo asaa; Yesuusan ammaniyaawanttunne S'oossaa siik'iyaawanttu ubbay barenttu giddonkka ittuu ittuwaanna siik'ettanaw bessee» yaagiide odeedda.</para>
  <para style="iot">Shemppatuwaa Ubbatoo Imetteedda K'antsa K'ofatuwaa</para>
  <para style="io1">Geluwaa <char style="ior"><ref loc="1JN 1:1-4">1:1-4</ref></char></para>
  <para style="io1">Poo'uwaanne d'umaa <char style="ior"><ref loc="1JN 1:5-2:29">1:5—2:29</ref></char></para>
  <para style="io1">S'oossaa naanaanne s'alahiyaa naanaa <char style="ior"><ref loc="1JN 3:1-24">3:1-24</ref></char></para>
  <para style="io1">Tumuwaanne baletsuwaa <char style="ior"><ref loc="1JN 4:1-6">4:1-6</ref></char></para>
  <para style="io1">Siik'uwaa oosuwaa <char style="ior"><ref loc="1JN 4:7-21">4:7-21</ref></char></para>
  <para style="io1">S'ooniyaa ammanuwaa <char style="ior"><ref loc="1JN 5:1-21">5:1-21</ref></char></para>
  <chapter number="1" style="c" sid="1JN 1"/>
  <para style="s">De'uwaa K'aalaa</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1"/>Nuuni koyiruwaappe doommiide de'iyaa, nu ayifiyaan be'iide, nu kushiyan Aa bochchi be'eedda de'uwaa k'aalaabaa hinttenttoo s'aafeetto. Nuuni Aa be'eeddo; nu kushiikka Aa bochchi be'eedda.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="JHN 1:1">Yoh. 1:1</ref></char></note> <verse eid="1JN 1:1"/><verse number="2" style="v" sid="1JN 1:2"/>He de'uu k'onc'c'ina, nuuni Aa be'iide, aabaa hinttenttoo markkatteetto; k'ay S'oossaa Aawuwaa matan de'iyaa nuw k'onc'c'eedda med'inaa de'uwaabaa hinttenttoo odeetto.<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="JHN 1:14">Yoh. 1:14</ref></char></note> <verse eid="1JN 1:2"/><verse number="3" style="v" sid="1JN 1:3"/>K'ay nuunanna hinttenttoo ittippetetsay de'ana mala, nuuni be'eeddawaanne siseeddawaa hinttenttoo odeetto; nuw Aawuwaananne Aa Na'aa Yesuusi Kiristtoosanna ittippetetsay de'ee. <verse eid="1JN 1:3"/><verse number="4" style="v" sid="1JN 1:4"/>Nuuni nu nashechchay polettana mala, hawaa hinttenttoo s'aafeetto.<verse eid="1JN 1:4"/></para>
  <para style="s">S'oossay Poo'uwaa</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5"/>Nuuni S'oossaa na'aappe sisiide, hinttenttoo odiyaa kiitay, «S'oossay poo'uwaa; aan d'umay mulekka baawa» yaagiyaawaa. <verse eid="1JN 1:5"/><verse number="6" style="v" sid="1JN 1:6"/>Nuuni nuw aanana ittippetetsay de'ee giide d'umaan de'ooppe, nu haasayaaninne nu oosuwaan worddoteetto. <verse eid="1JN 1:6"/><verse number="7" style="v" sid="1JN 1:7"/>Shin poo'uwaan I de'iyaawaadan, nuunikka poo'uwaan de'ooppe, nuw ittoo ittuwaanna ittippetetsay de'ee; k'ay Aa Na'aa, Yesuusi Kiristtoosa suutsay nagaraa ubbaappe nuuna geeshshee.<verse eid="1JN 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8"/>Nuuni nagaraa ootsibeykko gooppe, nuurekka nuuna c'immeetto; nuunan tumatetsaykka baawa. <verse eid="1JN 1:8"/><verse number="9" style="v" sid="1JN 1:9"/>Shin nuuni S'oossaw nu nagaraa paas'ooppe, I nu nagaraa atto gaanawunne nu bayizzo oosuwaa ubbaappe nuuna geeshshanaw, ammanettiyaawaanne tumuwaa ootsiyaawaa. <verse eid="1JN 1:9"/><verse number="10" style="v" sid="1JN 1:10"/>Nuuni nagaraa ootsibeykko gooppe, S'oossaa wordduwaa geetto; Aa k'aalaykka nu wozanaan de'enna.<verse eid="1JN 1:10"/></para>
  <chapter eid="1JN 1"/>
  <chapter number="2" style="c" sid="1JN 2"/>
  <para style="s">Kiristtoosi Nuw Gaannatiyaawaa</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1"/>Ta naatoo, nagaraa hintte ootsennaadan, taani hawaa hinttenttoo s'aafay; shin ooninne nagaraa ootsooppe, Aawuwaa matan nuw gaannatiyaa Yesuusi Kiristtoosi, S'illuu, de'ee. <verse eid="1JN 2:1"/><verse number="2" style="v" sid="1JN 2:2"/>K'ay nuuni nu nagaraa atto geetettussaa Kiristtoosa baggana demmeetto; Kiristtoosi yarshshetteeddawe asaa ubbaa nagaraa digganaassappe attin, nu nagaraa s'alalaa digganaassa gidenna.<verse eid="1JN 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3"/>Nuuni S'oossaa azazuwaa naagooppe, tumu Aa eriyaawaa hewan shaakkanaw danddayeetto. <verse eid="1JN 2:3"/><verse number="4" style="v" sid="1JN 2:4"/>Itti uray, «Taani Aa eray» giide, k'ay Aa azazuwaa naagennan aggooppe, he uray wordduwaa; tumatetsaykka aan baawa. <verse eid="1JN 2:4"/><verse number="5" style="v" sid="1JN 2:5"/>Shin Aa k'aalaw azazettiyaa oona gidooppenne, he uray S'oossaa siik'iyaawe tumu poletteedda. Nuuni S'oossaan de'iyaawaa hawe nuuna erissee. Hewekka, <verse eid="1JN 2:5"/><verse number="6" style="v" sid="1JN 2:6"/>«Taani, S'oossaan de'ay» giyaa ooninne Kiristtoosi de'eeddawaadan de'anaw bessee.<verse eid="1JN 2:6"/></para>
  <para style="s">Ooratsa Azazuwaa</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7"/>Ta siik'atoo, taani hinttenttoo koyiruwaappe de'iyaa ec'a azazuwaa s'aafayppe attin, ooratsa azazuwaa s'aafikke; he ec'a azazuu hintte siseedda k'aalaa.<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="JHN 13:34">Yoh. 13:34</ref></char></note> <verse eid="1JN 2:7"/><verse number="8" style="v" sid="1JN 2:8"/>Gidooppekka, taani hinttenttoo laa'entsuwaa ooratsa azazuwaa s'aafay; he azazuwaa tumatetsaykka Kiristtoosaninne hinttenan beettee. Ayaw gooppe, d'umay d'ayee; tumu poo'uu ha"i poo'ee.<verse eid="1JN 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9"/>Poo'uwaan de'ay giidde, bare ishaa is's'iyaa ooninne hanno gakkanawukka d'umaan de'ee. <verse eid="1JN 2:9"/><verse number="10" style="v" sid="1JN 2:10"/>Bare ishaa siik'iyaa ooninne poo'uwaan de'ee; he uran hara uraa d'ubbiyaabay ayaynne baawa. <verse eid="1JN 2:10"/><verse number="11" style="v" sid="1JN 2:11"/>Shin bare ishaa is's'iyaa ooninne d'umaan de'ee; d'umaan hamettee. D'umay Aa ayfiyaa k'ook'issi wotseedda diraw, hak'a binttonne erenna.<verse eid="1JN 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1JN 2:12"/>Ta naatoo, S'oossay Kiristtoosa suntsaa diraw,</para>
  <para style="q2" vid="1JN 2:12">hintte nagaraa atto yaageedda diraw,</para>
  <para style="q2" vid="1JN 2:12">taani hinttenttoo s'aafay.<verse eid="1JN 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="1JN 2:13"/>Aawotoo, koyiruwaappe de'iyaawaa hintte ereedda diraw,</para>
  <para style="q2" vid="1JN 2:13">hinttenttoo s'aafay.</para>
  <para style="q1" vid="1JN 2:13">Yalagatoo,</para>
  <para style="q2" vid="1JN 2:13">s'alahiyaa kaappuwaa hintte s'ooneedda diraw,</para>
  <para style="q2" vid="1JN 2:13">hinttenttoo s'aafay.</para>
  <para style="q2" vid="1JN 2:13">Guutsa naatoo, S'oossaa Aawuwaa hintte ereedda diraw,</para>
  <para style="q2" vid="1JN 2:13">hinttenttoo s'aafay.<verse eid="1JN 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="1JN 2:14"/>Aawotoo, koyiruwaappe de'iyaawaa hintte ereedda diraw,</para>
  <para style="q2" vid="1JN 2:14">hinttenttoo s'aafay.</para>
  <para style="q1" vid="1JN 2:14">Yalagatoo,</para>
  <para style="q2" vid="1JN 2:14">hintte mino gidiyaa dirawunne</para>
  <para style="q1" vid="1JN 2:14">S'oossaa k'aalay hinttenan de'iyaa diraw,</para>
  <para style="q2" vid="1JN 2:14">k'ay s'alahiyaa kaappuwaa hintte s'ooneedda diraw,</para>
  <para style="q2" vid="1JN 2:14">hinttenttoo s'aafay.<verse eid="1JN 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15"/>Ha alamiyaa woy alamiyaan de'iyaa ayaanne siik'oppite. Hintte ha alamiyaa siik'ooppe, S'oossaa siik'uu hinttenan baawa. <verse eid="1JN 2:15"/><verse number="16" style="v" sid="1JN 2:16"/>Ayaw gooppe, ha alamiyaan de'iyaa ubbabay, hewekka: asatetsaa amuu, ayifiyaan s'eelliide kajjeeliyaawenne bare de'iyaawaan c'eek'ettiyaawe ha alamiyaappe yeeddawaappe attin, S'oossaappe yibeenna. <verse eid="1JN 2:16"/><verse number="17" style="v" sid="1JN 2:17"/>Ha alamiinne ha alamiyaan Asay amottiyaa ubbabay aad'd'ana. Shin S'oossay geeddawaa ootsiyaa uray med'inaw de'ana.<verse eid="1JN 2:17"/></para>
  <para style="s">Kiristtoosa Ek'ettiyaawaappe Naagettiyaawaa</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18"/>Ta naatoo, wodiyaa wurssetsay matatteedda; Kiristtoosa ek'ettiyaawe sintsaappe yaanawaa hintte siseeddawaadan, haray atto ha"ikka Aa ek'ettiyaawanttu c'oratuu denddeeddino. Hewaa diraw, wodiyaa wurssetsay matatteeddawaa nuuni hewan ereetto. <verse eid="1JN 2:18"/><verse number="19" style="v" sid="1JN 2:19"/>Ha ek'ettiyaawanttu nu bagga gidenna diraw, nu giddoppe keseeddino; ayaw gooppe, unttunttu nu bagga gidiyaabaa gidinttonne, nu giddon de'ana; shin unttunttuppe ooninne nu bagga gidennawe erettana mala, nu giddoppe keseeddino.<verse eid="1JN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20"/>Shin Kiristtoosi hintte bolla Geeshsha Ayaanaa gusseedda; k'ay hintte ubbay tumuwaa eriita. <verse eid="1JN 2:20"/><verse number="21" style="v" sid="1JN 2:21"/>Tumuwaa hintte eriyaa dirawunne k'ay tumuwaan wordduu ayaynne bayinnawaa hintte eriyaa diraw, taani hinttenttoo s'aafayppe attin, tumuwaa hintte erenna diraw s'aafikke.<verse eid="1JN 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22"/>Yesuusi Oketteedda Kiristtoosa gidiyaawaa erikke giyaa uraappe attin, wordduu oonee? Hewe S'oossaa Aawuwaanne Na'aa erikke giyaawe Kiristtoosa ek'ettiyaawaa. <verse eid="1JN 2:22"/><verse number="23" style="v" sid="1JN 2:23"/>S'oossaa Na'aa erikke giyaa oonanne S'oossaa Aawuukka erenna; S'oossaa Na'aa eray giyaa oonanne k'ay S'oossaa Aawuukka eree.<verse eid="1JN 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24"/>Hewaa diraw, koyiruwaappe hintte siseeddawaa hintte wozanaan minisiide naagite. Koyiruwaappe siseeddawaa hintte naagooppe, hinttenttoo k'ay S'oossaa Na'aannanne S'oossaa Aawuwaana ittippetetsay de'ana. <verse eid="1JN 2:24"/><verse number="25" style="v" sid="1JN 2:25"/>K'ay Kiristtoosi bare huup'ew nuw immana geeddawe med'inaa de'uwaa.<verse eid="1JN 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26"/>Taani hawaa hinttenttoo he hinttena baletsiyaa asatuwaa diraw s'aafaad. <verse eid="1JN 2:26"/><verse number="27" style="v" sid="1JN 2:27"/>Shin Kiristtoosi hintte bolla bare Geeshsha Ayaanaa gusseedda. Geeshsha Ayyaanay hinttenan de'iyaa diraw, ooninne hinttena tamaarissana koshshenna; ayaw gooppe, Aa Geeshsha Ayyaanay hinttena ubbabaa tamaarissee. I tamaarissiyaawe tumuwaappe attin wordduwaa gidenna. Hewaa diraw Ayaanaa Geeshsha timirttew azazetiidde, Kiristtoosanna ittipetetsaan de'ite.<verse eid="1JN 2:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28"/>Ta naatoo, k'ay I k'onc'c'iyaa wode, nuuni yashshi bayinnawantta gidanaadaaninne, Aa yuussaa gallassi Aa sintsan nuuni yeellatennaadan, aanana ittippetetsaan de'ite. <verse eid="1JN 2:28"/><verse number="29" style="v" sid="1JN 2:29"/>Kiristtoosi s'illo gidiyaawaa hintte erooppe, s'illobaa ootsiyaa ubbay S'oossaa na'aa gidiyaawaa eranaw bessee.<verse eid="1JN 2:29"/></para>
  <chapter eid="1JN 2"/>
  <chapter number="3" style="c" sid="1JN 3"/>
  <para style="s">S'oossaa Naanatuwaa</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1"/>Nuuni S'oossaa naanatuwaa geetettiide s'eesettana mala, S'oossay nuuna ay keenaa siik'eeddenttonne be'ite. Nuuni tumukka Aa naanatuwaa. Ha alamii S'oossaa erenna diraw, nuunakka erenna.<note caller="-" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="JHN 1:12">Yoh. 1:12</ref></char></note> <verse eid="1JN 3:1"/><verse number="2" style="v" sid="1JN 3:2"/>Ta siik'atoo, ha"i nuuni S'oossaa naanatuwaa; nuuni ayaa hananentto biro erettibeenna; shin Kiristtoosi k'onc'c'iyaa wode, nuuni Aa malatanawaa ereetto. Ayaw gooppe, I tumu Aa gidiyaawaa nuuni kumentsan be'ana. <verse eid="1JN 3:2"/><verse number="3" style="v" sid="1JN 3:3"/>K'ay Kiristtoosa be'ana giide nashechchan naagiyaa ooninne Kiristtoosi geeshsha gideeddawaadan, barena geeshshee.<verse eid="1JN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4"/>Nagaraa ootsiyaa ubbay S'oossaa higgiyaa mentsee; ayaw gooppe, nagaray S'oossaa higgiyaa mentsussaa. <verse eid="1JN 3:4"/><verse number="5" style="v" sid="1JN 3:5"/>Kiristtoosi asaa nagaraa d'ayissanaw k'onc'c'eeddawaa hintte eriita; aan nagaray baawa.<note caller="-" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="JHN 1:29">Yoh. 1:29</ref></char></note> <verse eid="1JN 3:5"/><verse number="6" style="v" sid="1JN 3:6"/>Kiristtoosan de'iyaa ooninne nagaraa ootsiidde de'enna; k'ay nagaraa ootsiidde de'iyaa ooninne Aa be'ibeenna woy eribeenna.<verse eid="1JN 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7"/>Ta naatoo, ooninne hinttena baletsoppo. Kiristtoosi s'illo gidiyaawaadan, s'illobaa ootsiyaa uray s'illuwaa. <verse eid="1JN 3:7"/><verse number="8" style="v" sid="1JN 3:8"/>S'alahiyaa kaappuu koyiruwaappe nagaraa ootseedda diraw, nagaraa ubbaa wode ootsiyaa uray s'alahiyaa kaappuwaassa; hewaa diraw, S'oossaa Na'ay s'alahiyaa kaappuwaa oosuwaa d'ayissanaw k'onc'c'eedda. <verse eid="1JN 3:8"/><verse number="9" style="v" sid="1JN 3:9"/>S'oossaa naanatuwaa gidiyaa ubbay S'oossaa med'etay unttunttun de'iyaa diraw, nagaraa ubbaa wode ootsikkino; k'ay S'oossay unttunttu Aawuwaa gidiyaa diraw, nagaraa ootsanaw danddaykkino. <verse eid="1JN 3:9"/><verse number="10" style="v" sid="1JN 3:10"/>S'oossaa naanatuu gidduwaaninne s'alahiyaa kaappuwaa naanatuwaa giddon de'iyaa dummatetsay hawaan erettee; s'illobaa ootsennawanttunne woy bare ishaa siik'ennawanttu ooninne S'oossaa naanatuwaa gidikkino.<verse eid="1JN 3:10"/></para>
  <para style="s">Ittuu Ittuwaanna Siik'ettiyaawaa</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11"/>Ayaw gooppe, koyiruwaappe hintte siseedda kiitay, «Ittuu ittuwaanna siik'ettanaw bessee» yaagiyaawaa.<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="JHN 13:34">Yoh. 13:34</ref></char></note> <verse eid="1JN 3:11"/><verse number="12" style="v" sid="1JN 3:12"/>Nuuni K'aayeela mala gidanaw bessena. K'aayeeli s'alahiyaa kaappuwaassa; hewaa gido diraw, bare ishaa wod'eedda. I bare ishaa ayaw wod'eeddee? I ootseedda oosuu iita gidina, Aa ishay ootseedda oosuu lo"a gideedda diraw wod'eedda.<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="GEN 4:8">Dom. 4:8</ref></char></note><verse eid="1JN 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13"/>Taanaadan S'oossaa kaalliyaawanttoo, ha sa'aa Asay hinttena is's'ooppe, ooratsabaa gooppite. <verse eid="1JN 3:13"/><verse number="14" style="v" sid="1JN 3:14"/>Nuuni ammaniyaawantta siik'iyaa diraw, hayk'uwaappe de'oo pinneeddawaa ereetto; ammaniyaawantta siik'enna uray ooninne hayk'uwaa giddon de'ee. <verse eid="1JN 3:14"/><verse number="15" style="v" sid="1JN 3:15"/>Ammaniyaawantta is's'iyaa ooninne shemppuwaa wod'eeddawaa; k'ay shemppuwaa wod'eeddawaan med'inaa de'uu bayinnawaa hintte eriita. <verse eid="1JN 3:15"/><verse number="16" style="v" sid="1JN 3:16"/>Kiristtoosi bare shemppuwaa nu diraw aatsiide immeeddawaan siik'uu ayentto nuuni ereeddo; nuunikka ammaniyaawanttu diraw, nu shemppuwaa aatsiide immanaw bessee. <verse eid="1JN 3:16"/><verse number="17" style="v" sid="1JN 3:17"/>Shin dure Asay ooninne bare ishay metootiyaawaa be'iide, aw k'arettennaan is's'ooppe, bare wozanaan S'oossaa siik'ay gaanaw waan danddayii? <verse eid="1JN 3:17"/><verse number="18" style="v" sid="1JN 3:18"/>Ta naatoo, nuuni oosuwaaninne tumatetsaan siik'ettoytteppe attin, c'oo haasayan woy bolla doonaan siik'ettanaw bessena.<verse eid="1JN 3:18"/></para>
  <para style="s">S'oossaa Sintsan Ammanettiide Ek'k'iyaawaa</para>
  <para style="p">
    <verse number="19-20" style="v" sid="1JN 3:19-20"/>Nuuni tumuwaa baggan de'iyaawaa hewan erana; k'ay nu wozanay nu bolla pirddiyaa wode ubbaan, S'oossaa sintsan tumatetsaa nuuna hewan erissee. Ayaw gooppe, S'oossay nu wozanaappe wolk'k'aama; k'ay I ubbabaa eree.<verse eid="1JN 3:19-20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 3:21"/>Ta siik'atoo, nu wozanay nu bolla pirddennawaa gidooppe, nuuni S'oossaa sintsan yayyokko. <verse eid="1JN 3:21"/><verse number="22" style="v" sid="1JN 3:22"/>Nuuni Aa azazuwaa naagiyaa dirawunne Aa nashechchiyaabaa ootsiyaa diraw, woossiyaa ubbabaa aappe akkeetto. <verse eid="1JN 3:22"/><verse number="23" style="v" sid="1JN 3:23"/>S'oossaa azazuu hawaa: Kiristtoosi nuuna azazeeddawaadankka, S'oossaa Na'aa Yesuusi Kiristtoosa suntsan nuuni ammananaadaaninne ittuu ittuwaanna siik'ettanaadan S'oossay nuuna azazeedda. <verse eid="1JN 3:23"/><verse number="24" style="v" sid="1JN 3:24"/>S'oossaa azazuwaa naagiyaa ooninne S'oossaa giddon de'ee; S'oossaykka Aa giddon de'ee; S'oossay nuw immeedda Aa Ayaanaa baggana I nu giddon de'iyaawaa nuuni ereetto.<verse eid="1JN 3:24"/></para>
  <chapter eid="1JN 3"/>
  <chapter number="4" style="c" sid="1JN 4"/>
  <para style="s">Tumanchcha Ayyaanaanne Worddo Ayaanaa</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1"/>Ta siik'otoo, S'oossaa Ayyaanay taanan de'ee giyaa ubbaa ammanoppite; shin unttunttun de'iyaa ayyaanay S'oossaappeeyye woy gidennentto paac'c'ite. Ayaw gooppe, c'ora worddo nabatuu ubbasaa beeddino. <verse eid="1JN 4:1"/><verse number="2" style="v" sid="1JN 4:2"/>S'oossaa Ayaana gidiyaawaa hintte hawaan erana; «Yesuusi Kiristtoosi asaa gidiide yeeddawaa ammanay» giyaa oonaninne de'iyaa ayyaanay ubbay S'oossaappe yee. <verse eid="1JN 4:2"/><verse number="3" style="v" sid="1JN 4:3"/>K'ay Kiristtoosi asaa gidiide yeeddawaa ammanay geenawaa ayyaanay ubbay S'oossaappe yibeenna; aan Kiristtoosa ek'ettiyaa ayyaanay de'ee. Hintte hewe yaanawaa kase siseeddita; I haray atto ha"ikka ha alamiyaan de'ee.<verse eid="1JN 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4"/>Ta naatoo, hintte S'oossawantta; hintte giddon de'iyaa Geeshsha Ayyaanay ha alamiyaan de'iyaa ayyaanaappe daro wolk'k'aamiyaa diraw, worddo nabatuwaa hintte s'ooneeddita. <verse eid="1JN 4:4"/><verse number="5" style="v" sid="1JN 4:5"/>Unttunttu ha alamiyaa asaa gidiyaa diraw, ha alamiyaabaa haasayiino; ha alamiyaa asaykka unttunttu haasayaa sisee. <verse eid="1JN 4:5"/><verse number="6" style="v" sid="1JN 4:6"/>Nuuni S'oossawantta; S'oossaa eriyaa ooninne nuuni giyaawaa sisee. S'oossaa erenna ooninne nuuni giyaawaa sisenna. Nuuni tumu ayyaanaanne worddo ayaanaa hewan shaakkeetto.<verse eid="1JN 4:6"/></para>
  <para style="s">S'oossay Siik'uwaa</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7"/>Ta siik'atoo, siik'uu S'oossaappe yiyaa diraw, ane ittuu ittuwaanna siik'ettoytte. Siik'ettiyaa ooninne S'oossaa naanaa; S'oossaakka eriino. <verse eid="1JN 4:7"/><verse number="8" style="v" sid="1JN 4:8"/>S'oossaa eeshshay siik'o gidiyaa diraw, siik'enna uray ooninne S'oossaa erenna. <verse eid="1JN 4:8"/><verse number="9" style="v" sid="1JN 4:9"/>S'oossay nuuna bare siik'uwaa hawaan besseedda; nuuni Aa baggana de'uwaa demmana mala, bare itti Na'aa ha alamiyaa kiitteedda. <verse eid="1JN 4:9"/><verse number="10" style="v" sid="1JN 4:10"/>Siik'uwaa giyaawe hawaa; S'oossay nuuna siik'iide, nuuni nu nagaraappe maarotetsaa demmeedda bare Na'aa nuw kiitteeddappe attin, nuuni Aa siik'eeddawaanna gidenna.<verse eid="1JN 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11"/>Ta siik'otoo, S'oossay nuuna hawaadan siik'eeddawaa gidooppe, nuunikka ittuu ittuwaanna siik'ettanaw bessee. <verse eid="1JN 4:11"/><verse number="12" style="v" sid="1JN 4:12"/>S'oossaa ooninne mulekka be'ibeenna; nuuni ittuu ittuwaanna siik'ettooppe, S'oossay nu giddon de'ee; Aa siik'uukka nu giddon poletteedda.<verse eid="1JN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13"/>S'oossay bare Ayaanaa nuw immeedda diraw, nuuni S'oossaa giddon de'iyaawaanne ikka nu giddon de'iyaawaa ereetto. <verse eid="1JN 4:13"/><verse number="14" style="v" sid="1JN 4:14"/>S'oossaa Aawuu bare Na'aa ha alamiyaa ashshiyaawaa gidanaw kiitteeddawaa nuuni be'iide markkatteetto. <verse eid="1JN 4:14"/><verse number="15" style="v" sid="1JN 4:15"/>Yesuusi S'oossaa Na'aa gidiyaawaa markkattiyaa O gidduwaaninne S'oossay de'ee; ikka S'oossaa giddon de'ee. <verse eid="1JN 4:15"/><verse number="16" style="v" sid="1JN 4:16"/>S'oossay nuuna siik'iyaawaa nuuni nu huup'ew ereettonne ammaneetto.</para>
  <para style="p" vid="1JN 4:16">S'oossay siik'uwaa. Siik'uwaan de'iyaa ooninne S'oossaa giddon de'ee; S'oossaykka Aa giddon de'ee. <verse eid="1JN 4:16"/><verse number="17" style="v" sid="1JN 4:17"/>Nu de'uu ha alamiyaan Kiristtoosi de'eeddawaa mala gidiyaa diraw, pirddaa gallassi nuuni yayyena mala, siik'uu nu giddon poletteedda. <verse eid="1JN 4:17"/><verse number="18" style="v" sid="1JN 4:18"/>Siik'uwaan yashshi baawa; gaasuukka tumu siik'uu yashshaa kessi olee. Yashshaynne muray ittippe biyaa diraw, yayyiyaa uraa siik'uu kumentsaa gidenna.<verse eid="1JN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19"/>S'oossay koyro nuuna siik'eedda diraw, nuuni Aa siik'eeddo. <verse eid="1JN 4:19"/><verse number="20" style="v" sid="1JN 4:20"/>Ooninne, «Taani S'oossaa siik'ay» giidde bare ishaa is's'ooppe, I wordduwaa. Ayaw gooppe, be'eedda bare ishaa siik'ennawe be'ibeenna S'oossaa siik'anaw waan danddayii? <verse eid="1JN 4:20"/><verse number="21" style="v" sid="1JN 4:21"/>K'ay Kiristtoosi nuw immeedda azazuu hawaa; S'oossaa siik'iyaa uray bare ishaakka siik'anaw bessee.<verse eid="1JN 4:21"/></para>
  <chapter eid="1JN 4"/>
  <chapter number="5" style="c" sid="1JN 5"/>
  <para style="s">Ha Alamiyaa S'ooniyaawaa</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1"/>Oketteedda Kiristtoosa yaagiide, Yesuusa ammaniyaa ubbay S'oossaa naanaa; k'ay S'oossaa Aawuwaa siik'iyaa ooninne Aa naanatuwaakka siik'ee. <verse eid="1JN 5:1"/><verse number="2" style="v" sid="1JN 5:2"/>Nuuni S'oossaa siik'iyaawaaninne Aa azazuwaa naagiyaawaan, S'oossaa naanatuwaa siik'iyaawaa ereetto. <verse eid="1JN 5:2"/><verse number="3" style="v" sid="1JN 5:3"/>Ayaw gooppe, nuuni S'oossaa siik'iyaawe Aa azazuwaa naagiyaawaa; Aa azazuukka dees'o gidenna. <verse eid="1JN 5:3"/><verse number="4" style="v" sid="1JN 5:4"/>Ayaw gooppe, S'oossaa Na'aa gidiyaa ooninne ha alamiyaa s'oonanaw danddayee; nuunikka ha alamiyaa s'oonanawe nu ammanuwaana. <verse eid="1JN 5:4"/><verse number="5" style="v" sid="1JN 5:5"/>Ha alamiyaa s'oonanaw danddayiyaawe oonee? Yesuusi S'oossaa Na'aa gidiyaawaa ammaniyaawaa s'alalay s'oonana.<verse eid="1JN 5:5"/></para>
  <para style="s">Kiristtoosawaa Markkatteeddawaa</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6"/>S'ink'k'ataa haatsaannanne hayk'uwaa suutsaanna yeeddawe hawaa; ikka Yesuusi Kiristtoosa; haatsaannanne suutsaanna<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="fk" closed="false">Haatsaannanne suutsaanna: </char><char style="ft" closed="false">Yesuusi ha alamiyaa yiidde s'ink'k'ataa haatsaa s'alalaana gidennaan bare hayk'uwaa suutsaan yeedda. Hewaa guussay I asaa kushiyaan s'ammak'ettussa s'alalaa gidennaan, ha alamiyaan hayk'k'eedda guussaa.</char></note> I yeeddawaappe attin, haatsaa s'alalaanna yibeenna. Geeshsha Ayyaanay tuma gidiyaa diraw, hewe tuma gidiyaawaa I bare huup'ew markkattee. <verse eid="1JN 5:6"/><verse number="7" style="v" sid="1JN 5:7"/>Ayaw gooppe, heezzu markkatuu de'iino. <verse eid="1JN 5:7"/><verse number="8" style="v" sid="1JN 5:8"/>Hewanttu, S'oossaa Ayaanaa, haatsaanne suutsaa; ha heezzatuu ittuu ittuwaawaa p'alk'k'ikkino. <verse eid="1JN 5:8"/><verse number="9" style="v" sid="1JN 5:9"/>Nuuni Asay markkattiyaawaa ammanooppe, S'oossay markkattiyaawe asaawaappe loytsi aad'd'ee; ayaw gooppe, S'oossay bare Na'aabaa markkatteedda markkatetsay hawaa. <verse eid="1JN 5:9"/><verse number="10" style="v" sid="1JN 5:10"/>S'oossaa Na'aa ammaniyaa uraa wozanaan ha markkatetsay de'ee. S'oossaa ammanenna uray ooninne S'oossay bare Na'aw markkatteedda markkatetsaa ammanibeenna diraw, S'oossaa wordduwaa gee.<verse eid="1JN 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 5:11"/>Simmi markkatetsay hawaa; S'oossay nuw med'inaa de'uwaa immeedda; hewekka Aa Na'aan de'ee. <verse eid="1JN 5:11"/><verse number="12" style="v" sid="1JN 5:12"/>S'oossaa Na'ay de'iyaa oossinne de'uu de'ee; S'oossaa Na'ay baynna oossinne de'uu baawa.<verse eid="1JN 5:12"/></para>
  <para style="s">Med'inaa De'uwaa</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13"/>S'oossaa Na'aa suntsan ammaniyaa hinttenttoo med'inaa de'uu de'iyaawaa hintte erana mala, hawaa hinttenttoo s'aafaad. <verse eid="1JN 5:13"/><verse number="14" style="v" sid="1JN 5:14"/>S'oossay koyyiyaawaadan, ayinne nuuni Aa woossooppe, I sisiyaawaa nuuni eriyaa diraw, Aa sintsan yayyokko. <verse eid="1JN 5:14"/><verse number="15" style="v" sid="1JN 5:15"/>Nuuni woossiyaa ubbaan I sisiyaawaa erooppe, nuuni Aa woosseeddawaa I zaareeddawaa ereetto.<verse eid="1JN 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16"/>Ooninne hayk'uu bessena nagaraa bare ishay ootsishshin be'ooppe, S'oossaa woossanaw bessee; hayk'uu bessena nagaraa ootseeddawanttoo S'oossay de'uwaa immana. Hayk'uu bessiyaa nagaray de'ee; taani hinttena hewoo S'oossaa woossite giikke. <verse eid="1JN 5:16"/><verse number="17" style="v" sid="1JN 5:17"/>Bayizzo oosuu ubbay nagaraa; shin hayk'uu bessena nagaray de'ee.<verse eid="1JN 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18"/>S'oossaa naanay ooninne nagaraa ubbaa wode ootsennawaa nuuni ereetto. Ayaw gooppe, S'oossaa Na'ay unttuntta naagee; K'ay s'alahiyaa kaappuukka unttuntta k'ohanaw danddayenna. <verse eid="1JN 5:18"/><verse number="19" style="v" sid="1JN 5:19"/>Nuuni S'oossawantta gidiyaawaanne ha alamii ubbay s'alahiyaa kaappuwaan moodetteeddawe ereetto.<verse eid="1JN 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20"/>Nuuni tumu S'oossaa eranaadan, S'oossaa Na'ay yeeddawaanne nuw akeekaa immeeddawaa ereetto. Nuuni tumu S'oossaa giddon, Aa Na'aa Yesuusi Kiristtoosa giddon de'eetto; I tumu S'oossaanne med'inaa de'uwaa.<verse eid="1JN 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21"/>Ta naatoo, eek'atuwaappe hintte huup'iyaa naagite.<verse eid="1JN 5:21"/></para>
  <chapter eid="1JN 5"/>
</usx>
