<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Dawuro Full Bible Latin Version</book>
  <para style="h">Leemisuwaa</para>
  <para style="toc1">Leemisuwaa Mas'aafaa</para>
  <para style="toc2">Leemisuwaa</para>
  <para style="toc3">Lem.</para>
  <para style="mt1">Leemisuwaa Mas'aafaa</para>
  <para style="imt">Geluwaa</para>
  <para style="ip">Leemisuwaa Mas'aafay hiillaa haasayaaninne leemisuwaa haasayan giigeedda oosuwaanne ammanuwaa timirttiyaa. I daro bagga asaa de'uwaan hachchi hachchi gakketiyaa hanotuwaabaa odee. Koyiro doomiiddekka, «Aad'd'eeda eratetsaw doometsay S'oossaw yayyiyaawaa» yaagi hassayissiidde doommee. I tamaarissiyaawe ammanuwaa wogaan Asay ootsanabaa s'alala gidennaan, Asay bare hachchi hachchi de'uwaan hananaw bessiyaa lo"o eeshshaanne ootsanaw bessiyaa lo"o oosuwaa gujjiide tamaarissee. Ha mas'aafaa giddon ashkketetsaaban, asaw k'arettiyaawaaninne ammanettiyaawaan daro timirttii leemisuwaan imetteedda.</para>
  <para style="iot">Shemppatuwaa Ubbatoo Imetteedda K'antsa K'ofatuwaa</para>
  <para style="io1">Leemisatwaa Wootiide Go'etanentto <char style="ior"><ref loc="PRO 1:1-7">1:1-7</ref></char></para>
  <para style="io1">Aad'd'eeda Eratetsaa Koyanaadan Imetteedda Mak'k'uwaa <char style="ior"><ref loc="PRO 1:8-7:27">1:8—7:27</ref></char></para>
  <para style="io1">Aad'd'eeda Eratetsaa Sabbiidde Odeteedda Mazimuriyaa <char style="ior"><ref loc="PRO 8:1-9:18">8:1—9:18</ref></char></para>
  <para style="io1">Solomona Leemisatwaa <char style="ior"><ref loc="PRO 10:1-29:27">10:1—29:27</ref></char></para>
  <para style="io1">Aguura Haasayaa <char style="ior"><ref loc="PRO 30:1-33">30:1-33</ref></char></para>
  <para style="io1">Liimu'eela Daaya Bare Na'aa Tamarisseedda Timirttiyaa <char style="ior"><ref loc="PRO 31:1-31">31:1-31</ref></char></para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="s">Leemisatwaa Wooti Go"etanentto</para>
  <para style="r">(<ref loc="PRO 1:1-7">1:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />Hawanttu Israa'eeliyaa Kaatiyaa Daawita na'aa Solomona leemisatwaa.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="1KI 4:32">1 Kat. 4:32</ref></char></note> <verse eid="PRO 1:1" /><verse number="2" style="v" sid="PRO 1:2" />Leemisatuu Asay aad'd'eedda eratetsaa, seeraanne era haasayaa akeekanaw maaddiino. <verse eid="PRO 1:2" /><verse number="3" style="v" sid="PRO 1:3" />Unttunttu aad'd'eeda eratetsan, de'ana de'uwaa, s'illotetsaa, suure pirddaanne suuretetsaa tamaarissiyaawantta, <verse eid="PRO 1:3" /><verse number="4" style="v" sid="PRO 1:4" />boozatoo akeeka, wodallatoo eratetsaanne wozanaamatetsaa immiyaawantta. <verse eid="PRO 1:4" /><verse number="5" style="v" sid="PRO 1:5" />Aad'd'eeda eranchchatuu ha leemisatwaa sisiide, eraa gujjiino; akeekanchcha asatuukka lo"o zoriyaa akkiino. <verse eid="PRO 1:5" /><verse number="6" style="v" sid="PRO 1:6" />Hewaadan leemisatwaanne unttunttu biletsaa, aad'd'eeda eranchchatuwaa haasayaanne unttunttu k'an"ishetuwaa akeekanaw danddayettee.<verse eid="PRO 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 1:7" />Aad'd'eeda eratetsaw doometsay Med'inaa Godaw yayyiyaawaa; shin boozatuu aad'd'eeda eratetsaanne seeraa kad'iino.<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="JOB 28:28">Yob. 28:28</ref>; <ref loc="PSA 111:10">Maz. 111:10</ref>; <ref loc="PRO 9:10">Lem. 9:10</ref></char></note><verse eid="PRO 1:7" /></para>
  <para style="s">Aad'd'eedda Eratetsaa Koyanaadan Imetteedda Zoriyaa</para>
  <para style="r">(<ref loc="PRO 1:1-7:27">Lem. 1:1—7:27</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 1:8" />Ta na'aw, ne aabu zoriyaa sisa; ne daaya tamaarissiyaawaakka dogoppa. <verse eid="PRO 1:8" /><verse number="9" style="v" sid="PRO 1:9" />Hewe ne huup'iyaw bonchcho kallachchaa; ne k'ood'iyawukka habiliyaa gidanawaa.<verse eid="PRO 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 1:10" />Ta na'aw, neena nagaranchchatuu baletsooppe, eeno gooppa. <verse eid="PRO 1:10" /><verse number="11" style="v" sid="PRO 1:11" />Unttunttu neena, «Nuunana dendda; asaa wod'anaw k'osettiide naagoytte; gaasuu d'ayooppenne s'illotuwaa wod'anaw k'osetti uttoytte; <verse eid="PRO 1:11" /><verse number="12" style="v" sid="PRO 1:12" />Si'oolii mittiyaawaadan, nuunikka unttuntta pas'a de'ishiina mittoytte; nuuni unttuntta c'iimmo ollaan oliyaa asatuwaadan ootsana. <verse eid="PRO 1:12" /><verse number="13" style="v" sid="PRO 1:13" />Nuuni al"o miishshaa ubbaa demmana; nu golliyaakka omooduwaan kuntsana; <verse eid="PRO 1:13" /><verse number="14" style="v" sid="PRO 1:14" />nuunanna zuppetuwan demmeeddawaakka ittippe gishettana» yaagana.<verse eid="PRO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 1:15" />Ta na'aw, unttunttunna ogiyaa hamettoppa; ne gediyaa unttunttu loossuwaa yed'isoppa. <verse eid="PRO 1:15" /><verse number="16" style="v" sid="PRO 1:16" />Ayaw gooppe, unttunttu iitabaa ootsanaw wos's'iino; asaa suutsaa gussanaw elleelliino. <verse eid="PRO 1:16" /><verse number="17" style="v" sid="PRO 1:17" />Kafuu s'eellishshin, Aa oyk'k'anaw dabbaa yeggiyaawe ayinne maaddenna. <verse eid="PRO 1:17" /><verse number="18" style="v" sid="PRO 1:18" />Shin unttunttu barenttu suutsaa gussanaw barenttoo wos'imadiyaa mic'c'iino; barenttu shemppuwaa wod'anaw k'osetti uttiino. <verse eid="PRO 1:18" /><verse number="19" style="v" sid="PRO 1:19" />Bonk'k'iyaan go"aa demmiyaa ubbatuwaa wurssetsay hewaa mala; hewe izaawu shemppuwaa akkee.<verse eid="PRO 1:19" /></para>
  <para style="s">Aad'd'eeda Eratetsaa Is's'ooppe Neena Era!</para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 1:20" />Aad'd'eeda eratetsatta ogiyaan s'eesaw; gutaran bare k'aalaa d'ok'k'u ootsaade sissaw.<note caller="-" style="x"><char style="xo" closed="false">1:20-21 </char><char style="xt" closed="false"><ref loc="PRO 8:1-3">Lem. 8:1-3</ref></char></note> <verse eid="PRO 1:20" /><verse number="21" style="v" sid="PRO 1:21" />Aad'd'eeda eratetsatta Asay shiik'iyaa sa'aan ek'k'aade s'eesaw; katamaa geliyaa penggiyaan ek'k'aade,<verse eid="PRO 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 1:22" />«Hinttenoo, akeekay pac'c'eeddawanttoo, hintte akeekaa pac'aa awude gakkanaw dosiitee? K'iliic'iyaawanttoo, k'iliic'iyaawan awude gakkanaw nashettiitee? Boozatoo, eratetsaa awude gakkanaw is's'iitee? <verse eid="PRO 1:22" /><verse number="23" style="v" sid="PRO 1:23" />Ta seeraakko simmooppe; taani ta eraa hintte bolla gussana; ta k'aalaakka hinttena tamaarissana. <verse eid="PRO 1:23" /><verse number="24" style="v" sid="PRO 1:24" />Taani s'eeseedda wode, hintte koyennan is's'eeddita; taani kushiyaa mic'c'inakka, ooninne akeekibeenna. <verse eid="PRO 1:24" /><verse number="25" style="v" sid="PRO 1:25" />Ta zoriyaa ubbaa kad'eeddita; ta seeraakka akkibeyikkita. <verse eid="PRO 1:25" /><verse number="26" style="v" sid="PRO 1:26" />Hewaa diraw, hinttena metuu gakkiyaa wode, taani hintte bolla miic'c'ana; hinttena bashshay gakkiyaa wode, taani k'iliic'ana. <verse eid="PRO 1:26" /><verse number="27" style="v" sid="PRO 1:27" />Dagamay uushuwaadan hintte bolla yiyaa wode, metuu gotiyaadan hintte bolla yiyaa wode, tuggaynne waayii hintte bolla gakkiyaa wode, taani hinttena k'iliic'ana.<verse eid="PRO 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 1:28" />«He wode unttunttu taana s'eesana; shin taani koyikke; unttunttu taana minisiide koyana; shin demmikkino. <verse eid="PRO 1:28" /><verse number="29" style="v" sid="PRO 1:29" />Ayaw gooppe, unttunttu eratetsaa is's'eeddino; Med'inaa Godaw yayyiyaawaa dooribeykkino. <verse eid="PRO 1:29" /><verse number="30" style="v" sid="PRO 1:30" />Ta zoriyaa akkibeyikkino; ta seera ubbaakka kad'eeddino. <verse eid="PRO 1:30" /><verse number="31" style="v" sid="PRO 1:31" />Hewaa diraw, unttunttu barenttu ootseedda oosuwaa ayifiyaa maana; barenttu k'oppeedda k'ofaa ayifiyaakka kallana. <verse eid="PRO 1:31" /><verse number="32" style="v" sid="PRO 1:32" />Akeekay pac'c'eeddawantta aad'd'eeda eratetsaappe haakkiyaawe wod'ee; boozatuwaa sheneko giyaawe d'ayissee. <verse eid="PRO 1:32" /><verse number="33" style="v" sid="PRO 1:33" />Shin taani odiyaawaa sisiyaawanttu ubbay woppu giide, saro de'ana; metuwaa hirggaappekka shemppana» yaagaw.<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s">Aad'd'eeda Eratetsaappe Beettiyaa Anjjuwaa</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 2:1" />Ta na'aw, neeni ta giyaawaa akkooppe, ta azazuwaakka ne giddon minjjooppe, <verse eid="PRO 2:1" /><verse number="2" style="v" sid="PRO 2:2" />aad'd'eedda eratetsaa hayzzooppe, ne wozanaappe akeekooppe, <verse eid="PRO 2:2" /><verse number="3" style="v" sid="PRO 2:3" />eratetsaa s'eesooppe, akeekaakka d'ok'k'u ootsaade s'eesa. <verse eid="PRO 2:3" /><verse number="4" style="v" sid="PRO 2:4" />Asay biraa woy k'oseedda miishshaa koyiyaawaadan, neeni eratetsaa koyya. <verse eid="PRO 2:4" /><verse number="5" style="v" sid="PRO 2:5" />He wode neeni Med'inaa Godaw yayyee giyaawe ayentto akeekana; S'oossaakka loytsaade erana. <verse eid="PRO 2:5" /><verse number="6" style="v" sid="PRO 2:6" />Ayaw gooppe, Med'inaa Goday aad'd'eedda eratetsaa immee; aappe eratetsaynne akeekay beettee. <verse eid="PRO 2:6" /><verse number="7" style="v" sid="PRO 2:7" />I suuretoo maaddiyaa zoriyaa minjjee; tooshii bayinnan hamettiyaawanttookka I gonddalliyaa. <verse eid="PRO 2:7" /><verse number="8" style="v" sid="PRO 2:8" />Tumuwaa pirddaa ogiyaa naagee; barew ammanettiyaawanttu ogiyaakka naagee.<verse eid="PRO 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 2:9" />He wode neeni s'illotetsaa, suure pirddaa, suuretetsaanne lo"o oosuwaa ubbaa erana. <verse eid="PRO 2:9" /><verse number="10" style="v" sid="PRO 2:10" />Ayaw gooppe, aad'd'eedda eratetsay ne wozanaa gelana; eratetsaykka ne shemppoo nashshechcha gidana. <verse eid="PRO 2:10" /><verse number="11" style="v" sid="PRO 2:11" />Neena adussi k'oppiyaawe naagana; akeekayikka neena naagana. <verse eid="PRO 2:11" /><verse number="12" style="v" sid="PRO 2:12" />Aad'd'eeda eratetsay neena iita asatuwaa ogiyaappe naagana; geellabaa haasayiyaawanttuppe ashshana. <verse eid="PRO 2:12" /><verse number="13" style="v" sid="PRO 2:13" />Unttunttu nagaraa d'uman de'anaw, s'illotetsaa ogiyaa aggiino. <verse eid="PRO 2:13" /><verse number="14" style="v" sid="PRO 2:14" />Iitaa ootsiyaawaan nashettiino; geellaban hashshu giino. <verse eid="PRO 2:14" /><verse number="15" style="v" sid="PRO 2:15" />Unttunttu ootsiyaawe mirk'k'etsaa; unttunttu de'uukka geella.<verse eid="PRO 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 2:16" />Aad'd'eeda eratetsay woshumiyaa mishiratippenne sheleeshshiyaa k'aalan haasayiyaa laggetsattippe neena ashshana. <verse eid="PRO 2:16" /><verse number="17" style="v" sid="PRO 2:17" />Iza bare na'atetsaa asinaa aggaw; bare S'oossaa sintsan c'aak'k'eteedda c'aak'uwaakka dogaw. <verse eid="PRO 2:17" /><verse number="18" style="v" sid="PRO 2:18" />Izi golle biyaawe hayk'k'anaw biyaawaa; izi ogii hayk'k'oo kaaletsee. <verse eid="PRO 2:18" /><verse number="19" style="v" sid="PRO 2:19" />Iikko biyaa oonikka guyye simmenna; de'uwaa ogiyaakka demmenna. <verse eid="PRO 2:19" /><verse number="20" style="v" sid="PRO 2:20" />Hewaa aggade, neeni lo"o asatuwaa leemisuwaa kaala; s'illo asatuwaa de'uwaakka k'ulla. <verse eid="PRO 2:20" /><verse number="21" style="v" sid="PRO 2:21" />Ayaw gooppe, suure asatuunne tooshii bayinna asatuu biittan gam"iide de'ana. <verse eid="PRO 2:21" /><verse number="22" style="v" sid="PRO 2:22" />Shin iitatuu biittaappe d'ok'ollettana; ammanttennawanttukka shodettiide d'ayana.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s">S'oossan Ammanettiyaawaa</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 3:1" />Ta na'aw, taani neena tamaarissiyaawaa dogoppa; ta azazotuwaakka ne wozanaan wotsa. <verse eid="PRO 3:1" /><verse number="2" style="v" sid="PRO 3:2" />Ayaw gooppe, unttunttu ne laytsaa adussana; ishalo de'uwaanne sarotetsaa new gujjana. <verse eid="PRO 3:2" /><verse number="3" style="v" sid="PRO 3:3" />Aggena siik'uunne tumatetsay neeppe haakkoppino; unttuntta ne k'ood'iyaan k'achcha; ne wozanaankka unttuntta s'aafa. <verse eid="PRO 3:3" /><verse number="4" style="v" sid="PRO 3:4" />Yaatooppe, neeni S'oossaanne asaa sintsan sabettananne nashettana.<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="LUK 2:52">Luk'. 2:52</ref></char></note><verse eid="PRO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 3:5" />Ne polo wozanaan Med'inaa Godaa ammanetta; ne akeekan zemppoppa. <verse eid="PRO 3:5" /><verse number="6" style="v" sid="PRO 3:6" />Neeni ootsiyaa oosuwaa ubbaan Aa sintsaya; I neena suure ogiyaa kaaletsana. <verse eid="PRO 3:6" /><verse number="7" style="v" sid="PRO 3:7" />Neena ne huup'iyaan aad'd'eeda eranchcha kessoppa; Med'inaa Godaw yayya; iitaappekka haakka.<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="ROM 12:16">Rom. 12:16</ref></char></note> <verse eid="PRO 3:7" /><verse number="8" style="v" sid="PRO 3:8" />Hewe ne bollaa pas'a wotsana; ne mek'etsaakka minisana. <verse eid="PRO 3:8" /><verse number="9" style="v" sid="PRO 3:9" />Med'inaa Godaa ne duretetsan bonchcha; koyiro ayifeedda katsaa ubbaappekka s'eeraa aw immiyaawan Aa bonchcha. <verse eid="PRO 3:9" /><verse number="10" style="v" sid="PRO 3:10" />Yaatooppe, ne yeesetuwaan katsay kumana; ne baatsaakka ayife woyniyaa eessay kumiide palahana.<verse eid="PRO 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 3:11" />Ta na'aw, Med'inaa Godaa seeraa kad'oppa; I neena seeriyaa wodekka lanc'c'oppa.<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="JOB 5:11">Yob. 5:11</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">3:11-12 </char><char style="xt" closed="false"><ref loc="HEB 12:5-6">Ibr. 12:5-6</ref></char></note> <verse eid="PRO 3:11" /><verse number="12" style="v" sid="PRO 3:12" />Ayaw gooppe, aawuu bare siik'iyaa na'aa seeriyaawaadan, Med'inaa Goday bare dosiyaa uraa seeree.<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="REV 3:19">Sas'. 3:19</ref></char></note> <verse eid="PRO 3:12" /><verse number="13" style="v" sid="PRO 3:13" />Aad'd'eeda eratetsaa demmiyaa uray, akeekaakka barewaa ootsiyaa uray anjjetteedawaa. <verse eid="PRO 3:13" /><verse number="14" style="v" sid="PRO 3:14" />Ayaw gooppe, aappe demmiyaa go"ay work'k'aappenne biraappe demmiyaa go"aappe aad'd'eenne keekee. <verse eid="PRO 3:14" /><verse number="15" style="v" sid="PRO 3:15" />Aad'd'eeda eratetsay ink'k'uwaappe loytsi al"ee; neeni demmanaw amottiyaa ubbay aad'd'eeda eratetsaanna likkettenna. <verse eid="PRO 3:15" /><verse number="16" style="v" sid="PRO 3:16" />Aad'd'eeda eratetsay ne laytsaa adussee; I new duretetsaanne bonchchuwaa gujjee. <verse eid="PRO 3:16" /><verse number="17" style="v" sid="PRO 3:17" />Aa ogetuu nashechchiyaa ogetuwaa; Aa loossuwaa ubbaykka saruwaa. <verse eid="PRO 3:17" /><verse number="18" style="v" sid="PRO 3:18" />I barena oyk'k'iyaawanttoo de'uwaa mitsaa; Aa minisi oyk'k'iyaa ubbatuukka anjjetteedawantta.<verse eid="PRO 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 3:19" />Med'inaa Goday bare aad'd'eeda eratetsan sa'aa med'd'eedda; bare akeekankka salotuwaa miniseedda. <verse eid="PRO 3:19" /><verse number="20" style="v" sid="PRO 3:20" />Aa eratetsan shaafatuu goggiino; shaaratuuwaappekka iray bukkee.<verse eid="PRO 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 3:21" />Ta na'aw, lo"o aad'd'eeda eratetsaanne adussi k'oppiyaawaa naaga; unttunttu neeppe shaakkettoppino. <verse eid="PRO 3:21" /><verse number="22" style="v" sid="PRO 3:22" />Unttunttu new de'uwaa gidana; unttunttu new ishaluwaanne nashshechchaa de'uwaa immana. <verse eid="PRO 3:22" /><verse number="23" style="v" sid="PRO 3:23" />He wode neeni ne ogiyaan hirggi bayinnan hamettana; ne gediikka d'ubettenna. <verse eid="PRO 3:23" /><verse number="24" style="v" sid="PRO 3:24" />Neeni giseedda wode, yayakka; gisaadekka mal"o gem"ishshuwaa gem"ishana. <verse eid="PRO 3:24" /><verse number="25" style="v" sid="PRO 3:25" />Akeekenan gakkiyaa bashshaw, woy iitatuu d'ayiyaa d'ayoo yayakka. <verse eid="PRO 3:25" /><verse number="26" style="v" sid="PRO 3:26" />Ayaw gooppe, Med'inaa Goday new ammanettiyaawaa gidana; ne gediikka p'iriyaan oyk'ettennaadan, I neena naagana.<verse eid="PRO 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 3:27" />New wolk'k'ay de'ishiina, metooteeddawoo lo"obaa ootsiyaawaa aggoppa. <verse eid="PRO 3:27" /><verse number="28" style="v" sid="PRO 3:28" />Ha"i new de'ishiina, ne shooroo, «Simmaade ya; taani new wontti immana» yaagoppa. <verse eid="PRO 3:28" /><verse number="29" style="v" sid="PRO 3:29" />Neenan ammanettiide, ne matan de'ishiina, ne shooruwaa bolla iitabaa ootsanaw k'oppoppa. <verse eid="PRO 3:29" /><verse number="30" style="v" sid="PRO 3:30" />Neena naak'k'ibeenna asaa, c'oo moottoppa. <verse eid="PRO 3:30" /><verse number="31" style="v" sid="PRO 3:31" />Sugetsaa ootsiyaa asatuwaa k'ulloppa; unttunttu iita oosuwaakka kaalloppa. <verse eid="PRO 3:31" /><verse number="32" style="v" sid="PRO 3:32" />Ayaw gooppe, Med'inaa Goday iitaa ootsiyaawantta is's'ee; shin suuretuwaa I uloppe siik'ee. <verse eid="PRO 3:32" /><verse number="33" style="v" sid="PRO 3:33" />Med'inaa Godaa shek'ay iitaa ootsiyaawanttu soyina; shin Aa anjjuu suurebaa haniyaawanttu soyina. <verse eid="PRO 3:33" /><verse number="34" style="v" sid="PRO 3:34" />Otorettiide k'iliic'iyaawantta S'oossaykka k'iliic'ee; shin barentta kawushshiyaawantta nashshee.<note caller="-" style="x"><char style="xo" closed="false">3:34 </char><char style="xt" closed="false"><ref loc="JAS 4:6">Yak'. 4:6</ref>; <ref loc="1PE 5:5">1 P'es'. 5:5</ref></char></note> <verse eid="PRO 3:34" /><verse number="35" style="v" sid="PRO 3:35" />Aad'd'eeda eranchchatuu bonchchuwaa demmana; shin boozatuu kawushshana.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s">C'inc'c'atetsaappe Beetiyaa Go"aa</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 4:1" />Ta naatoo, hintte aabbu zoriyaa sisite; loytsi hayzzite; yaatooppe, hintte akeekana. <verse eid="PRO 4:1" /><verse number="2" style="v" sid="PRO 4:2" />Taani hinttew lo"o timirttiyaa immiyaa diraw, ta timirttiyaa aggoppite. <verse eid="PRO 4:2" /><verse number="3" style="v" sid="PRO 4:3" />Taani ta huup'iyankka ta aabboo na'aa; ta aatiwukka Aa siik'iyaa mes's'i itti na'aa. <verse eid="PRO 4:3" /><verse number="4" style="v" sid="PRO 4:4" />Ta aabbu taana tamaarissiidde, hawaadan yaageedda; «Taani odiyaawe new gelo; ta azazuwaa naaga; yaatooppe, neeni pas'a de'ana. <verse eid="PRO 4:4" /><verse number="5" style="v" sid="PRO 4:5" />Aad'd'eeda eratetsaanne akeekaa demma; taani new odeeddawaa dogoppa; ta k'aalaappe kesoppa. <verse eid="PRO 4:5" /><verse number="6" style="v" sid="PRO 4:6" />Aad'd'eeda eratetsaw zokkiyaa zaaroppa; ayaw gooppe, I neena ashshana; Aa siik'a; I neena naagana. <verse eid="PRO 4:6" /><verse number="7" style="v" sid="PRO 4:7" />Aad'd'eeda eratetsay ubbaappe aad'd'iyaa diraw, aad'd'eeda eratetsaa demma. Akeekay ne de'iyaawaa ubbaa wurssi akkooppekka Aa demma. <verse eid="PRO 4:7" /><verse number="8" style="v" sid="PRO 4:8" />Neeni Aa bonchcha; ikka neena d'ok'k'u d'ok'k'u ootsana; neeni Aa oyk'k'ooppe, I neena bonchchana. <verse eid="PRO 4:8" /><verse number="9" style="v" sid="PRO 4:9" />I ne huup'iyaan sabaa kalachchaa wotsana; bonchcho kalachchaa immana» yaageedda.<verse eid="PRO 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 4:10" />Ta na'aw, sisa; taani giyaawaakka akka; ne de'uwaa laytsaykka aduk'k'ana. <verse eid="PRO 4:10" /><verse number="11" style="v" sid="PRO 4:11" />Taani neena aad'd'eeda eratetsaa ogiyaa kaaletsana; suure loossuwaanakka afana. <verse eid="PRO 4:11" /><verse number="12" style="v" sid="PRO 4:12" />Neeni hamettiyaa wode, ne hamettiyaasan d'ubbiyaawe de'enna; wos's'ooppekka d'ubettakka. <verse eid="PRO 4:12" /><verse number="13" style="v" sid="PRO 4:13" />Tamaareeddawaa hassaya, yeddoppa; timirttii new de'uwaa gideedda diraw, loytsa naaga. <verse eid="PRO 4:13" /><verse number="14" style="v" sid="PRO 4:14" />Nagaranchchatuwaa ogiyaa yed'd'oppa; iita asatuwaa ogiyaankka hamettoppa; <verse eid="PRO 4:14" /><verse number="15" style="v" sid="PRO 4:15" />aappe haakka; an hamettoppa; aappe guyye simma; yaataade ne ogiyaan ba. <verse eid="PRO 4:15" /><verse number="16" style="v" sid="PRO 4:16" />Ayaw gooppe, unttunttu iitabaa ootsana gakkanaw, gem"ishshanaw danddaykkino; unttunttu asaa d'ubbennan unttuntta gem"ishuu afena. <verse eid="PRO 4:16" /><verse number="17" style="v" sid="PRO 4:17" />Unttunttu nagaraa ukitsaadan miino; sugetsaa oosuwaakka ushshaadan ushiino.<verse eid="PRO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 4:18" />S'illotuwaa ogii seeta gallassay gakkanaw, gujji gujji poo'iyaa wontta s'alk'k'iyaa mala. <verse eid="PRO 4:18" /><verse number="19" style="v" sid="PRO 4:19" />Shin nagaranchchatuwaa ogii d'ip'p'i go d'umaa mala; unttunttu wooti d'ubettinttokka erikkino.<verse eid="PRO 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 4:20" />Ta na'aw, taani odiyaawaa sisa; taani odiyaawaakka loytsaade hayzza. <verse eid="PRO 4:20" /><verse number="21" style="v" sid="PRO 4:21" />Taani odeeddabatu ne ayifiyaappe geemmoppino; unttuntta ne wozanaan wotsa. <verse eid="PRO 4:21" /><verse number="22" style="v" sid="PRO 4:22" />Ayaw gooppe, unttuntta demiyaa asaw ubbaw de'uwaa immiino; unttunttu bollawukka pas'atetsaa immiino. <verse eid="PRO 4:22" /><verse number="23" style="v" sid="PRO 4:23" />Ubbabaappekka ne wozanaa minisaade naaga; ayaw gooppe, de'uu aappe pulttee. <verse eid="PRO 4:23" /><verse number="24" style="v" sid="PRO 4:24" />Ne doonaappe gene haasayaa digga; worddo haasayaa ne doonaappe digga. <verse eid="PRO 4:24" /><verse number="25" style="v" sid="PRO 4:25" />Sitti gaade sintsaw s'eella; ne ayifii ne sintsan de'iyaawaa tishshi ootsiide s'eello. <verse eid="PRO 4:25" /><verse number="26" style="v" sid="PRO 4:26" />Ne gediyaw hamettiyaa ogiyaa suurissa; suure ogiyaa s'alalan hametta.<note caller="-" style="x"><char style="xo" closed="false">4:26 </char><char style="xt" closed="false"><ref loc="HEB 12:13">Ibr. 12:13</ref></char></note> <verse eid="PRO 4:26" /><verse number="27" style="v" sid="PRO 4:27" />Suure ogiyaappe ushechcha haddirssa gooppa; ne gedii iitasaa beennaadan naaga.<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s">Woshumaappe Haakka</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 5:1" />Ta na'aw, ta aad'd'eeda eratetsaa hayzza; ne haytsaa ta akeekaakko yegga. <verse eid="PRO 5:1" /><verse number="2" style="v" sid="PRO 5:2" />Yaatooppe, adussa k'ofay new de'ana; ne haasayaykka ne eratetsaa k'onc'c'issana.<verse eid="PRO 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 5:3" />Woshumiyaa mac'c'a mishirati ins's'arssaappe eessaa ililuu s'okee; I haasayay oyssaappekka aad'd'i shuggee. <verse eid="PRO 5:3" /><verse number="4" style="v" sid="PRO 5:4" />Shin iza wurssetsan godare uutsaadan c'ammaw; laa"u baggan k'ans's'iyaa mashshaadan k'ans's'iyaano; <verse eid="PRO 5:4" /><verse number="5" style="v" sid="PRO 5:5" />I gedetuu hayk'k'uwaakko duge biino; I hametay sitti ootsiide, duufuwaa afee. <verse eid="PRO 5:5" /><verse number="6" style="v" sid="PRO 5:6" />Iza de'uwaa ogiyaa k'oppukku; I ogetuu geella; shin geella gidiyaawaakka Aa erukku.<verse eid="PRO 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 5:7" />Ta naatoo, ha"ikka taani odiyaawaa sisite; taani giyaawaappe kesoppite. <verse eid="PRO 5:7" /><verse number="8" style="v" sid="PRO 5:8" />Woshumiyaa mac'c'a mishirati heeraa booppite; I golliyaa penggiyaakko shiik'oppite. <verse eid="PRO 5:8" /><verse number="9" style="v" sid="PRO 5:9" />Hewe d'ayooppe, hintte hinttenttu bonchchuwaa haratoo aatsiide immana. Hinttenttu hinttenttu yalagatetsan mek'etsi bayinna asatuwaa kushiyan hayk'k'ana. <verse eid="PRO 5:9" /><verse number="10" style="v" sid="PRO 5:10" />Hinttenttu mas'uwaa allaga asatuu akkana. Hintte daaburiide shiishsheeddawe hara asaw gidanawaa. <verse eid="PRO 5:10" /><verse number="11" style="v" sid="PRO 5:11" />Wurssetsan hintte ashuunne hintte asatetsay gilk'k'ina, hintte olana. <verse eid="PRO 5:11" /><verse number="12" style="v" sid="PRO 5:12" />K'ay hawaadan yaaganita; «Taan timirttiyaa ayaw is's'aaditaashsha! Ta wozanaykka seeraa ayaw kad'eeddeeshsha! <verse eid="PRO 5:12" /><verse number="13" style="v" sid="PRO 5:13" />Taani taana tamaarissiyaawanttu odeeddawaa akkabeyikke; taana zoriyaawanttu zoriyaakka hayzzabeykke. <verse eid="PRO 5:13" /><verse number="14" style="v" sid="PRO 5:14" />Hewaa diraw, taani Asay shiik'eedda shiik'uwaan, akeekenan kawushshanaw de'ay» yaagana.<verse eid="PRO 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 5:15" />Ne machchatiw amaneteedawaa gida; izi s'alala siik'a. <verse eid="PRO 5:15" /><verse number="16" style="v" sid="PRO 5:16" />Hara mac'c'aanippe yeletteedda ne naanatuu, new lo"obaa ootsikkino. <verse eid="PRO 5:16" /><verse number="17" style="v" sid="PRO 5:17" />Unttunttu neena maaddanaw dic'c'ino; allaga gidoppino.<verse eid="PRO 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 5:18" />Hewaa diraw ne machchattina nashetta; yalagatetsan neeni akkeedda ne machchatippe nashechchaa koya. <verse eid="PRO 5:18" /><verse number="19" style="v" sid="PRO 5:19" />Lo"iyaa gaaratidaaninne nashechchiyaa gen"atiidan, I d'antsay ubbaa wodekka neena alo; ubbaa wode I siik'uu neena omooddo. <verse eid="PRO 5:19" /><verse number="20" style="v" sid="PRO 5:20" />Ta na'aw, woshumiyaa mishirata neena ayaw omoodday? Hara asaa machchato ayaw k'oommay?<verse eid="PRO 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 5:21" />Ayaw gooppe, Asay ootsiyaawaa ubbaa Med'inaa Goday be'ee; I hamettiyaa loossuwaa ubbaa s'eellee. <verse eid="PRO 5:21" /><verse number="22" style="v" sid="PRO 5:22" />Nagaranchchaa I ootseedda nagaray oyk'k'ee. Aa nagaraa gitii Aa k'achchee. <verse eid="PRO 5:22" /><verse number="23" style="v" sid="PRO 5:23" />I bare boozatetsan haleedda; bare huup'iyaa naagibeenna diraw hayk'k'eedda.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s">Hachchi Hachchi De'oo Maaddiyaa Timirttiyaa</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 6:1" />Ta na'aw, neeni miishshaa tal"eedda ne shooroo waase geleeddawaa gidooppe, neeni erenna uraw ne kushiyaa bak'k'aade geppeeddawaa gidooppe, <verse eid="PRO 6:1" /><verse number="2" style="v" sid="PRO 6:2" />neeni geppeedda gefaa gitiyaan geleeddawaa gidooppe, ne doonaappe keseedda k'aalan oyk'k'etteeddawaa gidooppe, <verse eid="PRO 6:2" /><verse number="3" style="v" sid="PRO 6:3" />simmi neeni ne shooruwaa kushiyan gelaadda. Hewaa diraw, ta na'aw, hewaappe kesanaw koyooppe, elle ne shooruwaa golle ba; waasetetsaa I ne bollappe wotsana mala, awuddashaade Aa woossa. <verse eid="PRO 6:3" /><verse number="4" style="v" sid="PRO 6:4" />Hawaa ootsennan de'aadde gem"ishshoppa; shemppuwaakka shemppoppa. <verse eid="PRO 6:4" /><verse number="5" style="v" sid="PRO 6:5" />Shankkanchchatuwaappe gen"atta kessa akkiyaawaadan, dabaappe kafatta attiyaawaadan, ne huup'iyaa ashsha.<verse eid="PRO 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 6:6" />Neenoo azallaw, k'aac'otuwaakko ba; unttunttuppe tamaara. Yaatiide aad'd'eeda eranchcha gida. <verse eid="PRO 6:6" /><verse number="7" style="v" sid="PRO 6:7" />K'aac'otuwaa oosissanaw, kaappuu woy unttuntta mooddiyaawe baawa; <verse eid="PRO 6:7" /><verse number="8" style="v" sid="PRO 6:8" />shin barenttoo maanabaa boniyaan minjjiino; katsaa c'akkiyaa wodekka barenttoo koshshiyaa k'umaa shiishshiino. <verse eid="PRO 6:8" /><verse number="9" style="v" sid="PRO 6:9" />Neenoo azallaw, neeni awude gakkanaw gem"ishshay? Ne gem"ishshuwaappekka awude dendday? <verse eid="PRO 6:9" /><verse number="10" style="v" sid="PRO 6:10" />Neeni k'aykka guutsaa gisaassa; guutsaa gem"ishshaassa; kushiyaa shiishsha akkaade, guutsaa shemppaasa.<note caller="-" style="x"><char style="xo" closed="false">6:10-11 </char><char style="xt" closed="false"><ref loc="PRO 24:33-34">Lem. 24:33-34</ref></char></note> <verse eid="PRO 6:10" /><verse number="11" style="v" sid="PRO 6:11" />Yaatiyaa wode hiyyeesatetsay panggaadan, pac'ay olaa miishshaa oyk'k'eedda asaadan, ne bolla yaana.<verse eid="PRO 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 6:12" />Iita asaynne balaa asay, yuuyyi yuuyyiide wordduwaa odee; <verse eid="PRO 6:12" /><verse number="13" style="v" sid="PRO 6:13" />I bare ayifiyaan sim"ee; bare gediyaan bessee; bare birad'd'iyan s'orssee. <verse eid="PRO 6:13" /><verse number="14" style="v" sid="PRO 6:14" />Aa wozanaan geellatetsay de'ee; I iitabaa k'oppee; ubbaa gedekka I walassaa med'd'ee. <verse eid="PRO 6:14" /><verse number="15" style="v" sid="PRO 6:15" />Hewaa gaasuwaan bashshay akeekenan Aa bolla yaana; I hassayennan me"ana; me"iidekka pas'enna.<verse eid="PRO 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 6:16" />Med'inaa Goday is's'iyaa usuppun yewotuu de'iino; I laappuntsiyaawaa iissi is's'ee:<verse eid="PRO 6:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 6:17" />kad'iide s'eelliyaa ayifiyaa,</para>
  <para style="q2" vid="PRO 6:17">Worddotiyaa ins's'arssaa,</para>
  <para style="q2" vid="PRO 6:17">geeshsha asatuwaa suutsaa gussiyaa kushiyaa,<verse eid="PRO 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 6:18" />iitabaa mak'k'iyaa wozanaa,</para>
  <para style="q2" vid="PRO 6:18">iitabaakko elleelliide wos's'iyaa gediyaa,<verse eid="PRO 6:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 6:19" />wordduwaa bolla wordduwaa gujji gujjiide odiyaa worddo markkaa,</para>
  <para style="q2" vid="PRO 6:19">ishatuwaa giddon walassaa med'd'iyaa asaa.<verse eid="PRO 6:19" /></para>
  <para style="s">Woshumiyaa Asay Murettenan Attena</para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 6:20" />Ta na'aw, ne aabbu azazuwaa pola; ne aata neena tamaarisseeddawaakka aggoppa; <verse eid="PRO 6:20" /><verse number="21" style="v" sid="PRO 6:21" />unttuntta ubbaa gede ne wozanaan oyk'k'a; ne k'ood'iyankka k'achcha. <verse eid="PRO 6:21" /><verse number="22" style="v" sid="PRO 6:22" />Neeni hamettiyaa wode, unttunttu neena kaaletsana; neeni gisiyaa wode, unttunttu neena naagana; neeni beegottiyaa wodekka, unttunttu neena zorana. <verse eid="PRO 6:22" /><verse number="23" style="v" sid="PRO 6:23" />Ayaw gooppe, ha azazotuu s'omppiyaa; timirttetuukka poo'uwaa; k'ay seeraykka de'uwaakko afiyaa ogiyaa. <verse eid="PRO 6:23" /><verse number="24" style="v" sid="PRO 6:24" />Ha azazotuunne ha timirttetuu iita mac'c'aanippenne hara mishiratti sheleeshshiyaa ins's'arssaappe neena naagana. <verse eid="PRO 6:24" /><verse number="25" style="v" sid="PRO 6:25" />I malaa ne wozanaan amottoppa; I ayfiyaa lo"otetsan omoodettoppa. <verse eid="PRO 6:25" /><verse number="26" style="v" sid="PRO 6:26" />Itti attuma Asay c'aaratto itti ukitsaa gatiyaan demmanaw danddayee; shin asinay de'iyaa mishirattinna woshummussay shemppuwaa wod'isee. <verse eid="PRO 6:26" /><verse number="27" style="v" sid="PRO 6:27" />Itti Asay tamaa idimmina, Aa mayuu meetettennaan attanaw danddayii? <verse eid="PRO 6:27" /><verse number="28" style="v" sid="PRO 6:28" />Itti Asay tamaa bonk'k'uwaa yed'd'i hamettina, Aa gedii s'uugettennan attanee? <verse eid="PRO 6:28" /><verse number="29" style="v" sid="PRO 6:29" />Asaa machchattikko geliyaa uray hewaakka mala; izo bochchiyaa ubbay murettenan attena. <verse eid="PRO 6:29" /><verse number="30" style="v" sid="PRO 6:30" />Kayisuu koshatiide, barew maanaw wuu"ooppe, Asay Aa kad'enna. <verse eid="PRO 6:30" /><verse number="31" style="v" sid="PRO 6:31" />Shin I oyk'k'etteeddawaa gidooppe, laappun dakkuwaa c'iggana; bare soo miishshaa ubbaakka immana. <verse eid="PRO 6:31" /><verse number="32" style="v" sid="PRO 6:32" />Shin woshumiyaa Asay wozana pac'a; he uray bare shemppuwaa bayzzee. <verse eid="PRO 6:32" /><verse number="33" style="v" sid="PRO 6:33" />Madus's'ananne tooshetana. Ubbaa wodekka I boretiide de'ana. <verse eid="PRO 6:33" /><verse number="34" style="v" sid="PRO 6:34" />Ayaw gooppe, mac'c'a mishirati asinay mishettiide, hank'k'uwaa suullana; bare haluwaa kessiyaa wode, aw k'arettenna. <verse eid="PRO 6:34" /><verse number="35" style="v" sid="PRO 6:35" />I ayaa ac'aakka akkena; ay keeshshaa imuukka Aa hank'k'uwaa doshissenna.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="s">Woshumiyaa Mishirati C'imuwaa</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 7:1" />Ta na'aw, ta k'aalaa naaga; ta azazuwaakka ne garssan k'osa. <verse eid="PRO 7:1" /><verse number="2" style="v" sid="PRO 7:2" />New pas'a de'anaw ta azaziyaawaa ootsa; ta timirttiyaakka ne ayifiyaa buluwaadan naaga. <verse eid="PRO 7:2" /><verse number="3" style="v" sid="PRO 7:3" />Hassayissiyaawaadan unttuntta ne birad'd'etuwaan k'achcha; ne wozanaankka s'aafa. <verse eid="PRO 7:3" /><verse number="4" style="v" sid="PRO 7:4" />Aad'd'eeda eratetsaa ne michchatidan, akeekaakka ne mata dabbuwaadan s'eella. <verse eid="PRO 7:4" /><verse number="5" style="v" sid="PRO 7:5" />Unttunttu neena c'aaratiyaa mishiratippenne bare k'aalan sheleeshshiyaa hara mishiratippe naagana.<verse eid="PRO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 7:6" />Itti gallassi taani ta golliyaa maskkootiyaanna kare s'eellaad; <verse eid="PRO 7:6" /><verse number="7" style="v" sid="PRO 7:7" />wozanaa kuntsibeenna wodalla naanatuwaa be'aad. Unttunttu giddoppe ittuu loytsi booza. <verse eid="PRO 7:7" /><verse number="8" style="v" sid="PRO 7:8" />He wodallay ogiyaanna biide, itti woshummiyaa mac'c'a mishirati golliyaa mataana aad'd'eedda; I golle afiyaa ogiyaakko pinniide, I golliyaa heeraan hamettee. <verse eid="PRO 7:8" /><verse number="9" style="v" sid="PRO 7:9" />He wode sa'ay k'ammanaw lem"ilem"ee. <verse eid="PRO 7:9" /><verse number="10" style="v" sid="PRO 7:10" />Hewaappe guyyiyaan, mishirata Aa demmaaddu. Iza c'aaratoo gidiyaawaa izi mayuu erissee. Iza asaa c'immanaw k'oppaade kesaaddu. <verse eid="PRO 7:10" /><verse number="11" style="v" sid="PRO 7:11" />Iza s'alanne yeellay bayinna mac'c'a asaa; son woppu gaade uttukku. <verse eid="PRO 7:11" /><verse number="12" style="v" sid="PRO 7:12" />Iza itti gede ogiyaan, itti gede geyaan, dabaabaa ubbaan ek'k'aade naagaw.<verse eid="PRO 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 7:13" />Aa he na'aa k'oommaade yeraaddu; iza Aa ayifiyaa yeelli baynan tishshi ootsa s'eellaade hawaadan yaagaaddu; <verse eid="PRO 7:13" /><verse number="14" style="v" sid="PRO 7:14" />«Taani ta yarshshuwaa yarshshaade, ta k'anggetsaa ha"i gatsa simmay. <verse eid="PRO 7:14" /><verse number="15" style="v" sid="PRO 7:15" />Yaataade neena s'omoosanaw kesaad; neena loytsa koyaad; ha"i simmi demmaad. <verse eid="PRO 7:15" /><verse number="16" style="v" sid="PRO 7:16" />Taani Gibs'eppe yeedda, alleek'k'eedda anssoolaa ta hiis'an yeggaad. <verse eid="PRO 7:16" /><verse number="17" style="v" sid="PRO 7:17" />Taani Kawaraa, almmuniyaanne k'arafaa geetettiyaa k'imaamatuwaappe kesseedda shittuwaa ta hiis'an c'ac'c'afaad. <verse eid="PRO 7:17" /><verse number="18" style="v" sid="PRO 7:18" />Haaya; ane wonttana gakkanaw siik'uwaa aloytte; k'oomettiidekka nashettoytte; <verse eid="PRO 7:18" /><verse number="19" style="v" sid="PRO 7:19" />ayaw gooppe, ta asinay son gidenna; haako sa'aa beedda. <verse eid="PRO 7:19" /><verse number="20" style="v" sid="PRO 7:20" />Miishshaa k'arc'c'iitaa kuntsi akkiide beedda diraw, agenay doyssana gakkanaw golle simmenna» yaagaaddu.<verse eid="PRO 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 7:21" />Bare mal"o haasayan Aa sheleeshshaaddu; bare liik'o ins's'arssan c'immaaddu. <verse eid="PRO 7:21" /><verse number="22" style="v" sid="PRO 7:22" />Yaatina, ellekka I izo kaalliide, bi aggeeda. Booray shukkiyaasaa laagettiyaawaadan, gaaray elleelliide p'iriyaan geliyaawaadan, <verse eid="PRO 7:22" /><verse number="23" style="v" sid="PRO 7:23" />tooray Aa wozanaa c'addiyaawaadan haneedda. Dabbaa giddo geleedda kafuwaa malateedda. Hawe ubbay Aa shemppuwaa bayzzanaw haniyaawaa eribeenna.<verse eid="PRO 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 7:24" />Ta naanaw, ane ha"i sisite; ta doonaappe kesiyaa k'aalaakka hayzzite. <verse eid="PRO 7:24" /><verse number="25" style="v" sid="PRO 7:25" />Ne k'ofay he mac'c'a mishiratina booppo; I ogiyaan gelaade balettoppa. <verse eid="PRO 7:25" /><verse number="26" style="v" sid="PRO 7:26" />Aa c'addaade oleeddawanttu unddeneeddawantta; Aa wod'eeddawanttukka loytsi dara. <verse eid="PRO 7:26" /><verse number="27" style="v" sid="PRO 7:27" />I soyay duufuwaakko afiyaa ogiyaa; he ogii duge hayk'k'uwaa geessuwaa kaaletsee.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s">Aad'd'eeda Eratetsaa Sabbiide Odeedda Mazimuriyaa</para>
  <para style="r">(<ref loc="PRO 8:1-9:18">8:1—9:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 8:1" />Tumu aad'd'eeda eratetsatta s'eesekkee?<note caller="-" style="x"><char style="xo" closed="false">8:1-3 </char><char style="xt" closed="false"><ref loc="PRO 1:20-21">Lem. 1:20-21</ref></char></note> Akeekayikka bare k'aalaa d'ok'k'u ootsenee? <verse eid="PRO 8:1" /><verse number="2" style="v" sid="PRO 8:2" />Ogiyaa doonaan de'iyaa zoozetuwaa bollanne ogetuu dantsettiyaasan iza ek'k'aw; <verse eid="PRO 8:2" /><verse number="3" style="v" sid="PRO 8:3" />dirssaa penggiyaa matan, katamaa geliyaa penggiyaan ek'k'aade, bare k'aalaa d'ok'k'u ootsaade, hawaadan yaagaw; <verse eid="PRO 8:3" /><verse number="4" style="v" sid="PRO 8:4" />«Hinttenoo asatoo, taani hinttena s'eesay; taani asaa ubbaa s'eesay. <verse eid="PRO 8:4" /><verse number="5" style="v" sid="PRO 8:5" />Hinttenoo akeekay pac'c'eeddawanttoo, hiillaa demmanaw tamaarite. Hinttenoo boozatoo, akeekaa demmite. <verse eid="PRO 8:5" /><verse number="6" style="v" sid="PRO 8:6" />Taani daro lo"obaa odiyaa diraw sisite; taani suurebaa odanaw ta metershshaa dooyyay. <verse eid="PRO 8:6" /><verse number="7" style="v" sid="PRO 8:7" />Ta doonay tumuwaa haasayee; ta metershshay worddobaa is's'ee. <verse eid="PRO 8:7" /><verse number="8" style="v" sid="PRO 8:8" />Ta doonay haasayiyaawe ubbay tuma; geella woy mirk'k'etsaa gidenna. <verse eid="PRO 8:8" /><verse number="9" style="v" sid="PRO 8:9" />Akeekay de'iyaa uraw ta haasayay likke; eray de'iyaawanttoo ta haasayay k'onc'c'e.<verse eid="PRO 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 8:10" />«Biraa aggiide, ta zoriyaa doorite; bertte work'k'aakka aggiide, eratetsaa doorite. <verse eid="PRO 8:10" /><verse number="11" style="v" sid="PRO 8:11" />Ayaw gooppe taani, aad'd'eeda eratetsatta, ink'k'uwaa giyaa daro al"o shuchchaappekka aad'd'ay; neeni amottiyaawe ubbaykka taananna laggetanaw danddayenna.<verse eid="PRO 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 8:12" />«Taw, aad'd'eeda eratetsatiw akeekay de'ee; eratetsaykka adussa k'ofaykka taananna ittippe de'iino. <verse eid="PRO 8:12" /><verse number="13" style="v" sid="PRO 8:13" />Med'inaa Godaw yayyiyaawe iitatetsaa is's'iyaawaa; taani otoruwaanne ayyuwaa is's'ay; iitasaa afiyaa ogiyaanne wordduwaa haasayaa dosikke. <verse eid="PRO 8:13" /><verse number="14" style="v" sid="PRO 8:14" />Zoriinne lo"o eray tawantta; akeekayinne wolk'k'aynne taw de'iino. <verse eid="PRO 8:14" /><verse number="15" style="v" sid="PRO 8:15" />Kaatetuu taanan kawutiino; k'ay mooddiyaawanttu suure higgiyaa taanan kessiino. <verse eid="PRO 8:15" /><verse number="16" style="v" sid="PRO 8:16" />Kaappatuu taani maaddina, asaa mooddino; sa'aan gadiyaa mooddiyaa wolk'k'aama asatuwaa ubbaakka taani maadday.<verse eid="PRO 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 8:17" />«Taani taana siik'iyaawantta siik'ay; taana minisiide koyiyaawanttukka demmana. <verse eid="PRO 8:17" /><verse number="18" style="v" sid="PRO 8:18" />Duretetsaynne bonchchuu taananna de'iino; wurenna ak'uunne injjii ta mataana. <verse eid="PRO 8:18" /><verse number="19" style="v" sid="PRO 8:19" />Hintte taappe demmiyaa ayfii bertte work'k'aappenne ta c'arshshay muushissi kesseedda biraappe aad'd'ee. <verse eid="PRO 8:19" /><verse number="20" style="v" sid="PRO 8:20" />Taani s'illotetsaa ogiyaan hamettay; suure pirddaa loossuwaana aad'ay. <verse eid="PRO 8:20" /><verse number="21" style="v" sid="PRO 8:21" />Taana siik'iyaawanttoo taani mas'uwaa immana; unttunttu golliyaakka taani miishshan kuntsana.<verse eid="PRO 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 8:22" />«Med'inaa Goday taana bare oosuwaa ubbaappe koyiro med'd'eedda;<note caller="-" style="x"><char style="xo" closed="false">8:22 </char><char style="xt" closed="false"><ref loc="REV 3:14">Sas'. 3:14</ref></char></note> benippekka Aa oosoo doometsay taana. <verse eid="PRO 8:22" /><verse number="23" style="v" sid="PRO 8:23" />Beni wode, biittay sa'ay med'ettanaappe kase taani suntsettaad. <verse eid="PRO 8:23" /><verse number="24" style="v" sid="PRO 8:24" />Wolk'k'aama abbatuu bayinna wode, haatsaa pulttotuu d'uu"ibeenna wode, he wode taani yelettaad. <verse eid="PRO 8:24" /><verse number="25" style="v" sid="PRO 8:25" />Deretuunne detsatuu med'ettanaappe kase taani yelettaad. <verse eid="PRO 8:25" /><verse number="26" style="v" sid="PRO 8:26" />Med'inaa Goday sa'aanne sa'aan de'iyaa gadetuwaa ubbaa med'd'anaappe kase, woy itti kop'p'e gidiyaa baanay alamiyaan oosettanaappe kase taani yelettaad.<verse eid="PRO 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 8:27" />«Med'inaa Goday salotuwaa mic'c'eedda wodenne wolk'k'aama abbatuwaappe bollana de'iyaa saluwaa giigisseedda wode, taani yaan de'ay. <verse eid="PRO 8:27" /><verse number="28" style="v" sid="PRO 8:28" />Med'inaa Goday shaaretuwaa bollan wotseedda wode, wolk'k'aama abbaa pulttotuwaa d'uusseedda wode, <verse eid="PRO 8:28" /><verse number="29" style="v" sid="PRO 8:29" />abbaa haatsatuu barenttoo imetteedda zawaappe pinniide, bollaw aad'd'ennaadan, I unttuntta azazeedda wode, sa'aa baasuwaa I baaseeda wode, taani yaan de'ay. <verse eid="PRO 8:29" /><verse number="30" style="v" sid="PRO 8:30" />He wode taani Aa matan eretteedda oosanchcha; ubbaa gallassi taani nashechchan kumay; tawukka Aa sintsan nashettay. <verse eid="PRO 8:30" /><verse number="31" style="v" sid="PRO 8:31" />I med'd'eeddawe ubbay, sa'aykka asaa naanatuukka taana nashechchiino.<verse eid="PRO 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="PRO 8:32" />«Ha"ikka simmi ta naatoo, sisite; taani odiyaawaadan ootsiyaawanttu anjjetteedawantta. <verse eid="PRO 8:32" /><verse number="33" style="v" sid="PRO 8:33" />Ta timirttiyaa sisite; aad'd'eeda eranchcha gidite; siseeddawaa sheneko gooppite. <verse eid="PRO 8:33" /><verse number="34" style="v" sid="PRO 8:34" />Taana sisiyaa uray, hachchi hachchi ta penggen beettiyaa uray, ta golle geliyaasankka naagiyaa uray anjjetteedawaa. <verse eid="PRO 8:34" /><verse number="35" style="v" sid="PRO 8:35" />Taana demmiyaawe de'uwaa demmee; Med'inaa Godaappe I sabaa demmee. <verse eid="PRO 8:35" /><verse number="36" style="v" sid="PRO 8:36" />Shin taana demmennaan aggiyaa uray barena k'ohee; taana is's'iyaa ubbatuu, hayk'k'uwaa siik'iino» yaagaw.<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s">Aad'd'eeda Eratetsaanne Boozatetsaa</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 9:1" />Aad'd'eeda eratetsatta bare golliyaa kees's'aaddu; he golliyaw laappun tuussatuwaa essaaddu. <verse eid="PRO 9:1" /><verse number="2" style="v" sid="PRO 9:2" />Iza bare giigissiyaa shoobiyaw mod'd'o mehiyaa shukkaaddu; woyniyaa eessaakka agaade giigissaaddu. Maaddaa sintsaw aatsaadu. <verse eid="PRO 9:2" /><verse number="3" style="v" sid="PRO 9:3" />Yaataade asaa s'eesanaw bare k'oomatuwaa kiittaaddu. K'oomatuu katamaw d'ok'k'a sa'aan ek'k'iide, <verse eid="PRO 9:3" /><verse number="4" style="v" sid="PRO 9:4" />«Hinttenoo, eray pac'c'eeddawanttoo hawaa gelite!» yaageeddino. Boozatuwaakka Iza hawaadan yaagaaddu; <verse eid="PRO 9:4" /><verse number="5" style="v" sid="PRO 9:5" />«Haa yiite; ta k'umaa miite; taani ageeda woyniyaa eessaakka ushite! <verse eid="PRO 9:5" /><verse number="6" style="v" sid="PRO 9:6" />boozatetsaa aggiide, de'uwaan de'ite; akeekaa ogiyaan hamettite» yaagaw.<verse eid="PRO 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 9:7" />K'iliic'iyaa uraa seeriyaa Asay barew boriyaa akkee; iita uraa zoriyaawekka barew k'ohettee. <verse eid="PRO 9:7" /><verse number="8" style="v" sid="PRO 9:8" />K'iliic'iyaa uraa zoroppa; I neena is's'ana. Aad'd'eeda eranchcha uraa zora; I neena dosana. <verse eid="PRO 9:8" /><verse number="9" style="v" sid="PRO 9:9" />Aad'd'eeda eranchcha uraa tamaarissa; yaatooppe, I kasewaappekka aad'd'eeda eranchcha gidanawaa. S'illo uraakka tamaarissa; yaatooppe I eraa gujjana.<verse eid="PRO 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 9:10" />Aad'd'eeda eratetsaw doometsay Med'inaa Godaw yayyiyaawaa; Geeshsha S'oossaa eriyaawe akeekiyaawaa.<note caller="-" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="JOB 28:28">Yob. 28:28</ref>; <ref loc="PSA 111:10">Maz. 111:10</ref>; <ref loc="PRO 1:7">Lem. 1:7</ref></char></note> <verse eid="PRO 9:10" /><verse number="11" style="v" sid="PRO 9:11" />Taanan ne laytsay darana; ne de'uwaa laytsaykka aduk'k'ana. <verse eid="PRO 9:11" /><verse number="12" style="v" sid="PRO 9:12" />Neeni aad'd'eeda eranchcha gidooppe, ne huup'iyaw go'ettaasa. Neeni k'iliic'iyaawaa gidooppekka, ne huup'iyaw k'ohettaasa.<verse eid="PRO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 9:13" />Booza mishirata walassaa daraw; iza barena naagenawunno. Iza ayinne erukku. <verse eid="PRO 9:13" /><verse number="14" style="v" sid="PRO 9:14" />Iza bare karen, woy katamaw d'ok'k'a sa'aan oydiyaan uttaw. <verse eid="PRO 9:14" /><verse number="15" style="v" sid="PRO 9:15" />Suure barenttu ogiyaa oyk'k'iide biyaa asaa s'eesaade, <verse eid="PRO 9:15" /><verse number="16" style="v" sid="PRO 9:16" />«Hinttenoo, eray pac'c'eeddawanttoo, taakko haa yiite» yaagaw. Akeekay bayinnawaakka, <verse eid="PRO 9:16" /><verse number="17" style="v" sid="PRO 9:17" />«Wuu"iide ushiyaa haatsay mal"ee; geeman miyaa k'umaykka nashechchee» yaagaw. <verse eid="PRO 9:17" /><verse number="18" style="v" sid="PRO 9:18" />Shin I hayk'k'eedda Asay yaan de'iyaawaa, izi imatsatuukka duufuwaa c'iimmo giddon de'iyaawaa erenna.<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s">Solomona Leemisatwaa</para>
  <para style="r">(<ref loc="PRO 10:1-29:27">10:1—29:27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1" />Hawanttu Solomona leemisatwaa. Aad'd'eeda eranchcha na'ay bare aawuwaa nashechchee; shin booza na'ay bare aato kayyoyee.<verse eid="PRO 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 10:2" />Nagaran demmeedda miishshay go"enna; shin s'illotetsay hayk'k'uwaappe ashshee.<verse eid="PRO 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 10:3" />Med'inaa Goday s'illotuwaa koshshayissenna; shin nagaranchchatuwaa amuwaa polissenna.<verse eid="PRO 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 10:4" />Azallatetsay mank'k'issee; shin minniide ootsiyaawe dureyee.<verse eid="PRO 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 10:5" />Aad'd'eeda eranchcha uray katsaa boniyaan shiishshee; shin katsaa c'akkiyaa wode gem"ishshiyaa uray kawushee.<verse eid="PRO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 10:6" />S'illo Asay anjjettee; shin nagaranchchaa doonaa makkalay kamee.<verse eid="PRO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 10:7" />S'illuwaa suntsay anjjuwaan s'eesettiidde de'ee; shin nagaranchchatuwaa suntsay dogettee.<verse eid="PRO 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 10:8" />Aad'd'eeda eranchchatuu azazeeddawaa ootsiino; shin boozatetsan c'oo doonatiyaawanttu bashshaw biino.<verse eid="PRO 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 10:9" />Suure Asay saro de'ee; shin geella uray bare bayzzuwaan oyk'k'ettee.<verse eid="PRO 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 10:10" />Asaa bolla sim"iyaa uray metuwaa ayee.</para>
  <para style="p" vid="PRO 10:10">Boozatetsan c'oo doonatiyaawanttu bashshaw biino.<verse eid="PRO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 10:11" />S'illuwaa haasayay de'uwaa pulttiyaa; shin nagaranchchaa haasayay makkalatetsa gentsee.<verse eid="PRO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 10:12" />Is'uu palumiyaa dentsetsee; shin siik'uu bayzzuwaa ubbaa paydenna.<note caller="-" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="JAS 5:20">Yak'. 5:20</ref>; <ref loc="1PE 4:8">1 P'es'. 4:8</ref></char></note><verse eid="PRO 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 10:13" />Wozanaama Asay aad'd'eeda eran haasayee; shin booza uray s'am"an shoc'ettee.<verse eid="PRO 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 10:14" />Aad'd'eeda eranchchatuu eraa dagayiino; shin booza haasayaa haasayiyaa uray barena bayzzee.<verse eid="PRO 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 10:15" />Duriyaa miishshay diretteedda katamaa mala, bare godaa naagee; shin hiyyeesatetsay hiyyeesaa d'ayissee.<verse eid="PRO 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 10:16" />S'illo uraa Aa lo"o oosuu de'oo kaaletsee; shin iita uraa wurssetsay muruwaa ahee.<verse eid="PRO 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 10:17" />Seerina eeno giyaa uray de'uwaa ogiyaan hamettee; shin seerina is's'iyaa uray balee.<verse eid="PRO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 10:18" />Is's'iidde bare is's'iyaawaa erissenna uray worddanchcha; zigirssaa laaliyaa uraykka booza.<verse eid="PRO 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 10:19" />Daro haasayaa giddon nagaray d'ayenna; shin bare doonaa shiishshi akkiyaa uray aad'd'eeda eranchcha.<verse eid="PRO 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 10:20" />S'illuwaa ins's'arssay tigetteedda geeshsha biraa mala; shin iita uraa k'ofaw gatii guutsa.<verse eid="PRO 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 10:21" />S'illo uraa haasayay daro asaa go"ee; shin boozatuu barenttu wozanaa pac'an hayk'k'iino.<verse eid="PRO 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 10:22" />Med'inaa Godaa anjjuu dure kessee; I he duretetsan metuwaa walakkenna.<verse eid="PRO 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 10:23" />Booza uraw iitabaa ootsiyaawe kaassa mala; shin wozanaama uray aad'd'eeda eratetsan nashettee.<verse eid="PRO 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 10:24" />Iita uray hirggeeddabay Aa bolla gakkanawaa; shin s'illuu amotteeddawe imettanawaa.<verse eid="PRO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 10:25" />Gotuu denddiide aad'd'oode, nagaranchchatuu pitetti d'ayino; shin s'illotuu med'inaw minniide de'ana.<verse eid="PRO 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 10:26" />C'aalay achchaa zil"issiyaawaadaaninne c'uway ayifiyaa poogiyaawaadan, azalla uraa kiittiyaawe yiloyee.<verse eid="PRO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 10:27" />Med'inaa Godaw yayyiyaawe laytsaa adussee; shin nagaranchcha uraa laytsay k'aammee.<verse eid="PRO 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 10:28" />S'illo uray sintsanna nashechchay yaana giide naagee; shin iita uray sintsanna yaana giide naagiyaawe ayaynne baawa.<verse eid="PRO 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 10:29" />Med'inaa Godaa ogii s'illotoo bak'ati attiyaa sa'aa; shin iitaa ootsiyaawanttoo bashshaa.<verse eid="PRO 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 10:30" />S'illotuu de'iyaasaappe shodettikkino; shin iitatuu biittaa bolla de'ikkino.<verse eid="PRO 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 10:31" />S'illo Asay aad'd'eeda eratetsaa haasayee; shin geellabaa haasayiyaa ins's'arssay k'ans's'ettana.<verse eid="PRO 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="PRO 10:32" />S'illo Asay bessiyaa haasayaa eree; shin iita Asay geella haasayee.<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 11:1" />Med'inaa Goday wordduwaa miizaanan likkiyaawantta is's'ee; shin likke miizaanan likkiyaawanttun nashettee.<verse eid="PRO 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 11:2" />Otoruu yiyaa wode kawushshatetsay yee; shin ashkketetsaana aad'd'eeda eratetsay yee.<verse eid="PRO 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 11:3" />S'illotuwaa unttunttu suuretetsay kaaletsee; shin ammanettennawantta unttunttu geellatetsay d'ayissee.<verse eid="PRO 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 11:4" />Hank'k'uwaa gallassi duretetsay go"enna; shin s'illotetsay hayk'k'uwaappe ashshee.<verse eid="PRO 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 11:5" />Borii bayinna uraa ogiyaa Aa s'illotetsay suurissee; shin iita uray bare iitatetsan kunddee.<verse eid="PRO 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 11:6" />Suuretuwaa unttunttu s'illotetsay ashshee; shin ammanettennawantta unttunttu amuu p'ire gidiide oyk'k'ana.<verse eid="PRO 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 11:7" />Iita Asay hayk'k'iyaa wode, I naagiyaa hidootaykka aanana ittippe hayk'k'ee; I bare wolk'k'an c'eek'ettiyaawe ubbaykka d'ayee.<verse eid="PRO 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 11:8" />S'illuu metuwaappe attee; Aa diraw iitaa bolla metuu yee.<verse eid="PRO 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 11:9" />S'oossaa erenna bitanii bare doonaan asaa d'ayissee; shin s'illotuu eran attiino.<verse eid="PRO 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 11:10" />S'illotuu bonchchettiyaa wode, katamay nashettee; k'ay iitatuu hayk'k'iyaa wode, hashshu gee.<verse eid="PRO 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 11:11" />S'illotuwaa anjjuwaa gaasuwaan katamay dic'c'ee; shin iita uraa haasayay katamaa d'ayissee.<verse eid="PRO 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 11:12" />Bare shooruwaa kad'iyaa uraw wozanay baawa; shin akeekanchcha uray c'o"u gee.<verse eid="PRO 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 11:13" />Zigiriyaa Asay s'uuraa laalee; shin ammanettiyaa Asay s'uuraa gentsee.<verse eid="PRO 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 11:14" />Kaaletsiyaawe d'ayooppe, kawutetsay kunddee; shin daro zoriyaawanttu de'ooppe, saruu de'ee.<verse eid="PRO 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 11:15" />Erenna uraw waase gidiyaa Asay tumuwaappe metootana; hewaappe waase gidennaan is's'iyaawe lo"a.<verse eid="PRO 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 11:16" />Uluu keeka mishirata bonchchettaw; shin mek'etsaa iita Asay duretetsaa s'alala durettee.<verse eid="PRO 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 11:17" />Keeka Asay barew lo"obaa ootsee; shin mek'etsaa iita Asay barena k'ohee.<verse eid="PRO 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 11:18" />Iita Asay demmiyaa miishshay c'imiyaa miishshaa; shin s'illotetsaa zeriyaa uray tumu woytuwaa c'akkana.<verse eid="PRO 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 11:19" />S'illotetsan minniide de'iyaa uray pas'a de'ana; shin iitatetsaa kaalliyaa uray hayk'k'ana.<verse eid="PRO 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 11:20" />Med'inaa Goday iita k'ofay de'iyaa asatuwaa is's'ee; shin suure hamettiyaawanttun nashettee.<verse eid="PRO 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 11:21" />Iita Asay murettenan attena; shin s'illotuu attanawantta.<verse eid="PRO 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 11:22" />Adussa k'ofi bayinna puulanchcha mac'c'a mishirati puulay guduntsaa siid'iyaan aatseedda work'k'aa alleek'k'uwaa mala.<verse eid="PRO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 11:23" />S'illotuwaa amuwaa poluu lo"o s'alala; shin iitatuwaa amuwaa poluu hank'k'uwaa s'alala.<verse eid="PRO 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 11:24" />Itti itti asatuu barenttu miishshaa asaw c'oo laaliino; shin unttunttu ak'uu yaa daree. Hara asatuu k'ay barenttu miishshaw loytsi uuzetiino; shin unttunttu ak'uu haa pac'c'ee.<verse eid="PRO 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 11:25" />Keeka Asay durettana; haratuwaa maaddiyaa Asay maadettana.<verse eid="PRO 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 11:26" />Katsay al"ina zal"anaw minjjiyaa uraa Asay shek'k'ee. Shin bare katsaa Asay koyiyaa wode zil"iyaa asaa anjjee.<verse eid="PRO 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 11:27" />Lo"obaa minisiide koyiyaa uray nashshechchaa demmee; shin iitabaa koyiyaa uraa iitabay demmee.<verse eid="PRO 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 11:28" />Bare duretetsan ammanettiyaa Asay kunddana; shin s'illotuu balgguwaa mitsaadan daashana.<verse eid="PRO 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 11:29" />Bare soo asaa bolla c'abbuwaa dentsiyaa uray go'ettanabay ayaynne baawa. Boozatuukka aad'd'eeda eranchchatoo k'ooma gidana.<verse eid="PRO 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 11:30" />S'illo Asay de'uwaa ayifiyaa ayifiyaa mitsaa mala; shemppuwaa ashshiyaawanttu aad'd'eedda eranchchatuwaa.<verse eid="PRO 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 11:31" />S'illotuu sa'aan barenttu oosuwaa gatiyaa akkiyaawaa gidooppe, iitatuunne nagaranchchatuu barenttu oosoo akkana gatii waan daranddeeshsha!<note caller="-" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="1PE 4:18">1 P'es'. 4:18</ref></char></note><verse eid="PRO 11:31" /></para>
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 12:1" />Seeriyaawaa dosiyaa uray eratetsaa dosee; shin seeraa is's'iyaa uray donc'c'illowaa.<verse eid="PRO 12:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 12:2" />Lo"o Asay Med'inaa Godaappe sabaa demmee; shin Med'inaa Goday iitatuwaa pirddee.<verse eid="PRO 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 12:3" />Asaa iitatetsay minisiide essenna; shin s'illotuwaa s'ap'uu k'aas's'enna.<verse eid="PRO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 12:4" />Wozanaama mishirata bare asinaw kallachchaa mala; shin bare asinaa kawushshiyaa mishirata Aa mek'etsaa miyaa ajaajjiyaa mala.<verse eid="PRO 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 12:5" />S'illotuwaa k'ofay suure; shin iitatuwaa zorii c'imuwaa.<verse eid="PRO 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 12:6" />Iitatuwaa haasayay asaa wod'anaassa; shin s'illotuwaa haasayay unttuntta ashshee.<verse eid="PRO 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 12:7" />Iita asatuu kunddana; unttunttoo zeretsaykka de'enna; shin s'illotuwaa zeretsay minniide de'ana.<verse eid="PRO 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 12:8" />Asay bare aad'd'eeda eratetsaa keeshshaa galatettee; shin geella k'ofay de'iyaa Asay kad'ettee.<verse eid="PRO 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 12:9" />Dure asaa malatiide, metuwaan de'iyaa asaappe c'oo asaa malatiide, ootsiidde bare de'uwaa sugiyaa Asay keeka.<verse eid="PRO 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 12:10" />S'illo Asay bare mehiyaw k'arettee; shin iita asaa keekatetsaw mek'etsi baawa.<verse eid="PRO 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 12:11" />Bare biittaa minisi ootsiyaa uray katsaa kallee; shin patsennabaa yederssiyaa uraw akeekay pac'c'eeddawaa.<verse eid="PRO 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 12:12" />Iitatuu nagaranchcha asatuwaa omooduwaa akkanaw amottiino; shin s'illotuwaa s'ap'uu daashiide de'ana.<verse eid="PRO 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 12:13" />Iita asaa Aa doonaappe keseedda haasayay p'ire gidiide oyk'k'ee; shin s'illuu metuwaappe kessi akkee.<verse eid="PRO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 12:14" />Asay bare doonaappe kesiyaa k'aalan lo"obaa kallee; bare ootseedda oosuwaa gatiyaakka akkee.<verse eid="PRO 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 12:15" />Booza Asay biyaa buussay aw Aa huup'iyaan likke malatee; shin aad'd'eeda eranchcha Asay zoriyaa sisee.<verse eid="PRO 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 12:16" />Booza uraa hank'k'uu ellekka erettee; shin c'inc'c'a Asay boriyaa kad'iide aad'd'ee.<verse eid="PRO 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 12:17" />Tumuwaa haasayiyaa Asay suurebaa odee; shin wordduwaa markkay wordduwaan odee.<verse eid="PRO 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 12:18" />Akeekenan haasayiyaa haasayay c'ubiyaadan c'addee; shin aad'd'eeda eranchchaa ins's'arssay patsee.<verse eid="PRO 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 12:19" />Worddo haasayay guutsa wodiyaassa; shin tumo haasayay med'inaw de'ana.<verse eid="PRO 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 12:20" />Iitaa k'oppiyaawanttu wozanaan c'imuu de'ee; shin sarobaa zorettiyaawanttu wozanaan nashechchay kumee.<verse eid="PRO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 12:21" />S'illotuwaa metuu gakkenna; shin iitatoo metoppe attina, harabay de'enna.<verse eid="PRO 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 12:22" />Med'inaa Goday worddanchchatuwaa is's'ee; shin tumanchcha asatuwaan I nashettee.<verse eid="PRO 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 12:23" />C'inc'c'a Asay bare eraa k'osee; shin boozatuu barenttu boozatetsaa odiino.<verse eid="PRO 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 12:24" />Minniide ootsiyaa uray deriyaa mooddee; shin azallay moodettee.<verse eid="PRO 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 12:25" />Hirggiyaawe asaa nashshechchaa diggee; shin lo"otetsaanna de'iyaa haasayay Aa nashechchee.<verse eid="PRO 12:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 12:26" />S'illo Asay bare shooruwaa zoriidde, suure ogiyaa kaaletsee; shin iitatuwaa ogii tumuwaappe haassee.<verse eid="PRO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 12:27" />Azalla Asay shankkatiide aheedda ashuwaa katsenna; shin min ootsiide demeedda uray bare duretaw bonchchuwaa immee.<verse eid="PRO 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 12:28" />S'illotetsaa ogiyaan de'uu de'ee; he ogiyaan hayk'k'uu baawa.<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 13:1" />Eranchcha na'ay bare aawuwaa seeraa sisee; shin k'iliic'iyaawe seeraa sisenna.<verse eid="PRO 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 13:2" />Asay bare doonaappe kesiyaa k'aalan lo"obaa akkee; shin ammanttennawanttu makkalabaa amottiino.<verse eid="PRO 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 13:3" />Bare doonaa naagiyaa uray bare shemppuwaa naagee; shin ellekka haasayiyaa uray barena d'ayissee.<verse eid="PRO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 13:4" />Azallay amottee; shin ayaanne demmenna; shin minniide ootsiyaawanttu kallana.<verse eid="PRO 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 13:5" />S'illo asatuu wordduwaa haasayaa is's'iino. Shin iita asatuwaa haasayay yeellayeenne kawushshee.<verse eid="PRO 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 13:6" />Suure de'uwaa de'iyaa uraa Aa s'illotetsay naagee; shin nagaranchchaa Aa nagaray kunddisee.<verse eid="PRO 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 13:7" />Barena dure malatissiyaa Asay de'ee; shin aw ayaynne baawa; haray k'ay barena hiyyeesaa malatissiyaawe de'ee; shin aw daro duretay de'ee.<verse eid="PRO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 13:8" />Asay bare shaluwaan bare shemppuwaa wozanaw danddayee; shin hiyyeesaa yashissiyaawe baawa.<verse eid="PRO 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 13:9" />S'illotuwaa s'omppii pooc'umi poo'ee; shin iitatuwaa s'omppii to'ana.<verse eid="PRO 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 13:10" />Otoruu walassaa yelee; shin zoriyaa akkiyaawanttu aad'd'eeda eranchcha.<verse eid="PRO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 13:11" />Daaburi bayinnan demmeedda miishshay ellekka d'ayee; shin min ootsiide demmeedda duretay, dari dariide bee.<verse eid="PRO 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 13:12" />Koyiyaawe polettennaan gam"iyaawe kayyoyee; shin amotteeddawe polettiyaawe nashechchee.<verse eid="PRO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 13:13" />Zoriyaa kad'iyaa uray metuwaan gelee; shin azazuwaa bonchchiyaa uray saruwaan de'ana.<verse eid="PRO 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 13:14" />Aad'd'eeda eranchchay immiyaa timirttii de'uwaa pultto; hewe Asay hayk'k'uwaa p'iriyaappe kessi akkanaw maaddee.<verse eid="PRO 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 13:15" />Akeekay de'iyaa uray bonchchetee; shin ammanettennan aggiyaawe bashshaw afee.<verse eid="PRO 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 13:16" />C'inc'c'a Asay ubbay eran ootsee; shin boozay bare boozatetsaa k'onc'c'issee.<verse eid="PRO 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 13:17" />Asay kiitteedda iita kiitanchchay, metuwaan geliino; shin ammantsiyaa asatuu kiitteeddawe, sarotetsaa ahiino.<verse eid="PRO 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 13:18" />Seeraa is's'iyaa Asay hiyyeeseenne yeellatee; shin seerina sisiyaa uray bonchchetee.<verse eid="PRO 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 13:19" />Amotteeddawaa demmiyaawe loytsi nashechchee; shin iitatuu iitaappe haakkanaw koyikkino.<verse eid="PRO 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 13:20" />Aad'd'eeda eranchcha asatuwaana hamettiyaa Asay aad'd'eeda eranchcha gidee; shin booza asatuwaana hamettiyaa Asay metuwaan gelee.<verse eid="PRO 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 13:21" />Nagaranchchatuwaa iita kaac'ay kaallee; shin s'illotuu lo"o oosuwaa woytuwaa akkana.<verse eid="PRO 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 13:22" />Lo"o Asay bare naanatuwaa naanatuwaa laatissee; shin nagaranchchaa duretay s'illoo dagattee.<verse eid="PRO 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 13:23" />Hiyyeesaa goshshay daro katsaa ayifanaw danddayee; shin suure pirdday pac'c'eeddawaa gaasuwaan d'ayee.<verse eid="PRO 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 13:24" />K'ayis'eeriyaan wad'd'anaw k'arettiyaa uray bare na'aa is's'ee; shin bare na'aa siik'iyaa uray minniide seeree.<verse eid="PRO 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 13:25" />S'illuu Aa uluu kallana gakkanaw mee; shin nagaranchchay koshattee.<verse eid="PRO 13:25" /></para>
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 14:1" />Aad'd'eeda eranchcha mishirata bare golliyaa kees's'aw; shin boozata bare golliyaa bare kushiyan kolaw.<verse eid="PRO 14:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 14:2" />Suure hamettiyaa Asay Med'inaa Godaw yayyee; shin bare ogiyaa geellayiyaa asay Med'inaa Godaa kad'ee.<verse eid="PRO 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 14:3" />Booza haasayay Aa zokkiyaw S'am"aa ayee; shin aad'd'eeda eranchchatuwaa ins's'arssay unttuntta naagee.<verse eid="PRO 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 14:4" />Booratuu bayinna saan yeesii mela de'ee; shin new goshiyaa wolk'k'aama booratuu de'ooppe, ne yeesiyaan katsay kumee.<verse eid="PRO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 14:5" />Ammanettiyaa markkay ubbaa gede tumuwaa odee; shin wordduwaa markkay wordduwaa s'alala haasayee.<verse eid="PRO 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 14:6" />K'iliic'iyaawe aad'd'eeda eratetsaa koyee; shin demmenna; akeekay de'iyaa Asay eratetsaa demmanawe Aa waayissenna.<verse eid="PRO 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 14:7" />Booza asaappe haakka; ayaw gooppe, neeni Aa haasayaappe eraa demmakka.<verse eid="PRO 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 14:8" />C'inc'c'a Asay bare ootsiyaawaa eriyaa diraw, aad'd'eeda eranchcha; shin booza Asay ayinne erennankka eriyaawaa malatiyaa diraw c'immee.<verse eid="PRO 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 14:9" />Boozatuu nagaraa ootsiide, kayyottiyaawaa aggiide k'iliic'iino; shin suuretuu barenttu nagaray atto geetettanawaa koyiino.<verse eid="PRO 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 14:10" />Bare wozanaa kayyuwaa izaawu eree; Aa nashechchaakka ooninne aanana kos's'enna.<verse eid="PRO 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 14:11" />Iitatuwaa Gollii kolettenna; shin suuretuwaa gollii minniide de'ana.<verse eid="PRO 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 14:12" />Asaw likke malatiyaa ogii de'ee; shin biina, Aa wurssetsay hayk'k'uwaan kessi yeggee.<note caller="-" style="x"><char style="xo" closed="false">14:12 </char><char style="xt" closed="false"><ref loc="PRO 16:25">Lem. 16:25</ref></char></note><verse eid="PRO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 14:13" />Miichchankka wozanay kayyotti eree; nashshechchaa wurssetsaykka kayyuwaa gidanaw danddayee.<verse eid="PRO 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 14:14" />Iita Asay bare iita oosuwaa gatiyaa akkana; lo"o asaykka bare lo"o oosuwaa gatiyaa akkana.<verse eid="PRO 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 14:15" />Booza Asay ubbaa ammanee; shin c'inc'c'ay akeekiide tanggee.<verse eid="PRO 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 14:16" />Aad'd'eeda eranchcha asay Med'inaa Godaa yayyee; iitaappekka haakkee; shin boozay alaalle geenanne elleellee.<verse eid="PRO 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 14:17" />Elle hank'k'ettiyaa asatuu booza oosuwaa ootsiino. Shin c'inc'c'atuu danddayanchcha.<verse eid="PRO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 14:18" />Boozatuu barenttu boozatetsaa gatiyaa akkiino; shin c'inc'c'atuu eratetsaa kallachchaadan wotsanawantta.<verse eid="PRO 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 14:19" />Iita asatuu lo"o asatuwaa sintsan hokkiide, maarotaa woosana. Nagaranchchatuukka s'illotuwaa penggiyaan hokkana.<verse eid="PRO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 14:20" />Hiyyeesay bare shooruwankka dosettenna; shin duretoo daro laggetuu de'iino.<verse eid="PRO 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 14:21" />Bare shooruwaa kad'iyaa Asay nagaraa ootsee; shin hiyyeesaa maaddiyaawe anjjetteedawaa.<verse eid="PRO 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 14:22" />Iitabaa mak'ettiyaawanttu baliino gidikkinoo? Shin lo"obaa ootsanaw halchchiyaawanttu tumatetsaanne aggena siik'uwaa demmiino.<verse eid="PRO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 14:23" />Minniide ootsiyaawaan ubbaan go"ay de'ee; shin c'oo mela haasayay hiyeesatetsaa s'alala ayee.<verse eid="PRO 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 14:24" />Aad'd'eeda eranchchatoo unttunttu duretetsay kallachchaa; shin boozatuu barenttu boozatetsaa gujji gujjiide booziino.<verse eid="PRO 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 14:25" />Tumu markkay shemppuwaa ashshee; shin wordduwaa markkay baletsee.<verse eid="PRO 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 14:26" />Med'inaa Godaw yayyiyaa uraw mino geessuu de'ee. I Aa naanatookka bak'atiide attiyaa sa'aa gidanawaa.<verse eid="PRO 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 14:27" />Med'inaa Godaw yayyiyaawe de'uwaa pultto; hewaa diraw, Med'inaa Godaw yayiyaawe hayk'k'uwaa p'iriyaappe ashee.<verse eid="PRO 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 14:28" />Kaatiyaa gitatetsay I mooddiyaa asaa c'oratetsaana; shin I mooddiyaa Asay d'ayooppe, ikka patsenna.<verse eid="PRO 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 14:29" />Danddayanchcha asaw wolk'k'aama akeekay de'ee; shin elle hank'k'ettiyaa Asay bare boozatetsaa k'onc'c'issee.<verse eid="PRO 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 14:30" />Woppu geedda wozanay bollaa pas'a wotsee; shin k'anaatii bollaw ajaajjiyaa harggiyaa mala.<verse eid="PRO 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 14:31" />Hiyyeesatuwaa naak'k'iyaa Asay unttuntta Med'd'eeddawaa c'ashee; shin metootanchchatoo keekkiyaa Asay S'oossaa bonchchee.<verse eid="PRO 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="PRO 14:32" />Iitatuu barenttu iita oosuwaan kunddana; shin s'illotuu barenttu suuretetsan hayk'k'uwaappe naagettana.<verse eid="PRO 14:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="PRO 14:33" />Akeekanchcha asaa wozanaan aad'd'eeda eratetsay kumeedda; shin boozatuu aad'd'eeda eratetsaa ayaanne erikkino.<verse eid="PRO 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="PRO 14:34" />S'illotetsay itti kawutetsaa asaa d'ok'k'u d'ok'k'u ootsee; shin nagaray ay asanne kawushshee.<verse eid="PRO 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="PRO 14:35" />Kaatii eranchcha k'ooman nashettee; shin yeellayiyaa oosuwaa ootsiyaa k'oomaa hank'k'ettee.<verse eid="PRO 14:35" /></para>
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 15:1" />Liik'o zaaruu hank'k'uwaa zarbbissee; shin poddolla k'aalay hank'k'uwaa dentsetsee.<verse eid="PRO 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 15:2" />Aad'd'eeda eranchchaa ins's'arssay eraa loytsee; shin boozatuwaa doonay boozatetsaa pulttee.<verse eid="PRO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 15:3" />Med'inaa Godaa ayifetuu ubbasaa s'eelliino; iitaa ootsiyaawanttakka lo"uwaa ootsiyaawanttakka be'iino.<verse eid="PRO 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 15:4" />Liik'o haasayay de'uwaa mitsaa mala; shin c'imiyaa haasayay ayaanaa mentsee.<verse eid="PRO 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 15:5" />Booza Asay bare aawuwaa seeraa kad'ee; shin bare aawuwaa seeraa akkiyaa Asay c'inc'c'a.<verse eid="PRO 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 15:6" />S'illo uraa golliyaan daro miishshay de'ee; shin iitaw geliyaa miishshay metuwaa ayee.<verse eid="PRO 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 15:7" />Aad'd'eeda eranchchatuwaa doonay eraa zeree; shin boozatuwaa wozanay hewaa mala gidenna.<verse eid="PRO 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 15:8" />Med'inaa Goday iitatuwaa yarshshuwaa shenetee; shin suuretuwaa woosay Aa nashechchee.<verse eid="PRO 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 15:9" />Med'inaa Goday iita asatuwaa hemetaa shenetee; shin s'illotetsaa kaalliyaawantta I siik'ee.<verse eid="PRO 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 15:10" />Suure ogiyaa aggeeda asaa iita muruu naagee; seeraa is's'iyaa Asay hayk'k'ee.<verse eid="PRO 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 15:11" />Duufuunne bashshay Med'inaa Godaa sintsan k'onc'c'iyaan beettiino. Yaatina, asaa wozanaa k'ofay waan aappe geemmanee?<verse eid="PRO 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 15:12" />K'iliic'iyaa Asay seeriyaawaa dosenna; aad'd'eeda eranchchatuwaappekka zoriyaa oochchenna.<verse eid="PRO 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 15:13" />Wozanay nashetina, som"ii poo'ee; shin wozanay kayyotooppe, he ayaanay me"ee.<verse eid="PRO 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 15:14" />Akeekiyaa wozanay de'iyaa Asay eratetsaa koyee; shin boozatuu barenttu boozatetsan nashettiino.<verse eid="PRO 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 15:15" />Hiyyeesatuwaa de'uu ubbaa gallassikka baas'e. Shin nashetiyaa asatuu ubbaa gedekka barenttu de'uwaan aliino.<verse eid="PRO 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 15:16" />Walassay de'iyaa wolk'k'aama ak'uwaappe Med'inaa Godaa yashshatetsay de'iyaa guutsabay keeka.<verse eid="PRO 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 15:17" />Walassay de'iyaa saan mod'd'o ashuwaa maanaappe siik'uu de'iyaa saan santsaa miyaawe keeka.<verse eid="PRO 15:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 15:18" />Hank'k'ettiyaa Asay walassaa kessee; shin hank'k'ettanaw elleellenna Asay walassaa irs's'issee.<verse eid="PRO 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 15:19" />Azalla uraa metuu Aa ogiyaa ubbaan aguntsa dirssaa mala; shin suure uraa ogii dembbaa.<verse eid="PRO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 15:20" />C'inc'c'a na'ay bare aawuwaa nashechchee; shin booza na'ay bare aato kad'ee.<verse eid="PRO 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 15:21" />Wozani bayinna Asay bare boozatetsan nashettee; shin wozanaama Asay likkebaa ootsee.<verse eid="PRO 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 15:22" />Zoretay d'ayooppe, halchcheeddawe polettenna; daro zoriyaawanttu de'iyaa saan halchcheeddawe polettee.<verse eid="PRO 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 15:23" />Ooshetteeddawoo likke zaaruwaa zaariyaawe he uraa nashechchee; haasayaa likke wodiyaan haasayiyaawe ayiba lo"obee!<verse eid="PRO 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 15:24" />Aad'd'eeda eranchchay bollaw kaaletsiyaa de'uwaa ogiyaan hametteeppe attina, duge duufuwaa wotsiyaa ogiyaan hamettenna.<verse eid="PRO 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 15:25" />Med'inaa Goday otoranchchatuwaa golliyaa kolana; shin am"atii zawaa naagee.<verse eid="PRO 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 15:26" />Med'inaa Goday iitatuwaa k'ofaa shenetee; shin geeshsha k'aalay Aa nashechchee.<verse eid="PRO 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 15:27" />Wordduwaan wod'iyaa demmanaw jaamiyaa Asay bare soo asaa bolla metuwaa ayee; shin mattaayiyaa is's'iyaa Asay pas'a de'ana.<verse eid="PRO 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 15:28" />S'illo Asay haasayanaappe kasetiide k'oppee; shin iitatuwaa ins's'arssay palabaa pulttee.<verse eid="PRO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 15:29" />Med'inaa Goday iitatuwaappe haakkee; shin s'illotuwaa woosaa sisee.<verse eid="PRO 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 15:30" />Pashikkiide s'eelliyaa s'eelay wozanaa nashechchee; mishiraachchuwaa oduukka bollaa patsee.<verse eid="PRO 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 15:31" />De'uwaa immiyaa zoriyaa sisiyaa Asay aad'd'eeda eranchchatuwaana ittippe de'ana.<verse eid="PRO 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="PRO 15:32" />Seeraa is's'iyaa Asay barena k'ohee; shin seeraa akkiyaa Asay akeekaa demmee.<verse eid="PRO 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="PRO 15:33" />Med'inaa Godaw yayyiyaawe asaa aad'd'eeda eratetsaa tamaarissee; bonchchettana koyeedda Asay koyiro barena kawushshanaw koshshee.<verse eid="PRO 15:33" /></para>
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 16:1" />Asay bare wozanaan halchchee; shin likke zaaruu Med'inaa Godaappe beettee.<verse eid="PRO 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 16:2" />Asay ootsiyaa oosuwaa ubbay aw likke malatee; shin Med'inaa Goday koyiro dendduwaa k'ofaa yiggi s'eellee.<verse eid="PRO 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 16:3" />Ne ootsiyaawaa ubbaa hadaraa Med'inaa Godaw imma; yaatooppe, neeni halchcheeddawe polettana.<verse eid="PRO 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 16:4" />Med'inaa Goday med'd'eeddawaa ubbaa bare halchchoo med'eedda; haninttokka makkalanchchatuwaa wurssetsay bayetsaa.<verse eid="PRO 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 16:5" />Med'inaa Goday otorettiyaa ubbaa shenetee; unttunttu murettenan attikkino.<verse eid="PRO 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 16:6" />Aggena siik'uwaaninne ammanettiyaawaan nagaray atto geetettee; Asay Med'inaa Godaw yayyiyaawaan iitabaa ootsennan naagettee.<verse eid="PRO 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 16:7" />Asaa hametay Med'inaa Godaa nashechchiyaawaa gidooppe, he uraw bare morkkatuwaanakka saro de'anaadan, S'oossay ootsee.<verse eid="PRO 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 16:8" />S'illotetsan beettiyaa guutsabay wordduwaan demmiyaa daro wod'iyaappe keeka.<verse eid="PRO 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 16:9" />Asay bare wozanaan bare ootsanabaa halchchee; shin halchchuu Med'inaa Goday maaddina polettee.<verse eid="PRO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 16:10" />Kaatii S'oossaappe akkeedda maatan pirddee; pirddiidde I balena.<verse eid="PRO 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 16:11" />Miizaanatuunne makkiyaa miishshatuu ammantsiyaawantta gidanaadan, Med'inaa Goday koyee; zal"iyaawaa ubbaan c'imuu de'ennaadan koyee.<verse eid="PRO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 16:12" />Kaatetuu bayzzuwaa oosuwaa shenetiino; ayaw gooppe, unttunttu kawutetsaa araatay s'illotetsan ek'k'ee.<verse eid="PRO 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 16:13" />Kaatetuu s'illo ins's'arssan nashettiino; tumuwaa haasayiyaawanttakka dosiino.<verse eid="PRO 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 16:14" />Kaatiyaa hank'k'uu hayk'k'uwaa kiitanchchaa mala; shin aad'd'eeda eranchcha Asay hank'k'uwaa irs's'issanaw awuddashee.<verse eid="PRO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 16:15" />Kaatiyaa som"ii pashikkooppe, hewe simmi de'uwaa. I nashshiyaawe bad'd'eesaa iraa ahiyaa shaariyaa mala.<verse eid="PRO 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 16:16" />Aad'd'eeda eratetsaa demmiyaawe work'k'aa demmiyaawaappe keeka; akeekaa demmiyaawe biraa demmiyaawaappekka aad'd'ee.<verse eid="PRO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 16:17" />Suuretuu biyaa ogii iitay de'iyaasaappe haakuwaana aatsee; bare hemetaa naagiyaa uray bare shemppuwaa naagee.<verse eid="PRO 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 16:18" />Otoruwaa geeduwaa bashshay kaallee; ayyuwaa geeduwaakka kunddetsay kaallee.<verse eid="PRO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 16:19" />Ayyiyaawanttuna zuppetiide, omooduwaa shaakki akkanaappe ashkke gidiide, hiyyeesiide de'iyaawe keeka.<verse eid="PRO 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 16:20" />Med'inaa Godaa k'aalaa loytsiide hayzziyaa uraw I ootsiyaawe ubbay injjetana; S'oossan ammanettiyaa uray anjjetteedawaa.<verse eid="PRO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 16:21" />Bare k'ofaan aad'd'eeda eranchcha gideedda Asay akeekanchcha geetettee; lo"o k'aalay eratetsaa gujjee.<verse eid="PRO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 16:22" />C'inc'c'a uraw eratetsay de'uwaa pulttuwaa mala; shin boozatuwaa seeriyaawe c'oo wodiyaa wurssiyaawaa.<verse eid="PRO 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 16:23" />Aad'd'eeda eranchcha Asay haasayanaappe kasetiide k'oppee; Asay akkiyaa haasayaa haasayee.<verse eid="PRO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 16:24" />Lo"o k'aalay eessaa ililuwaadan mal"ee; bollaakka maaddeenne patsee.<verse eid="PRO 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 16:25" />Asaw suure malatiyaa ogii de'ee; shin wurssetsan hayk'k'oo gatsee.<note caller="-" style="x"><char style="xo" closed="false">16:25 </char><char style="xt" closed="false"><ref loc="PRO 14:12">Lem. 14:12</ref></char></note><verse eid="PRO 16:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 16:26" />Koshay Asay minniide ootsanaadan dentsetsee.<verse eid="PRO 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 16:27" />Iita Asay iitabaa halchchee; Aa haasayaykka s'uuggiyaa tamaa mala.<verse eid="PRO 16:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 16:28" />Geella Asay walassaa dentsee; zigiriyaa Asay ammanettiyaa laggetuwaa shaakkee.<verse eid="PRO 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 16:29" />Makkala Asay bare shooruwaa c'immee; lo"o gidenna ogiyaw I Aa kaaletsee.<verse eid="PRO 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 16:30" />Bare ayifiyaa sim"iyaa Asay geellabaa k'oppee; bare mettershshaa sa"iide manddiyaa Asay iitabaa polee.<verse eid="PRO 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 16:31" />Puulummeedda huup'ii bonchcho kallachchaa; hewekka beettiyaawe s'illo de'uwaa de'ina.<verse eid="PRO 16:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="PRO 16:32" />Wolk'k'aama asaa gidiyaawaappe, hank'k'ettanaw elleellenna asaa gidiyaawe lo"a; daro katamatuwaa oliide oyk'k'iyaawaappe, Asay bare huup'iyaa mooddiyaawe aad'd'ee.<verse eid="PRO 16:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="PRO 16:33" />Asay saamaa yeggee; shin Med'inaa Goday ubbabaa wurssetsaa k'achchee.<verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 17:1" />Walassay de'iyaa saan de'iyaa wolk'k'aama gibiraappe saruunne woppay de'iyaa saan mela ukitsaa pok'uwaa miyaawe keeka.<verse eid="PRO 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 17:2" />C'inc'c'a k'oomay bare godaa na'aa patsenna laafaa mooddee; yaatiide ishatuwaanna ittippe laattee.<verse eid="PRO 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 17:3" />Work'k'aynne biray taman paac'ettiyaawaadan, Med'inaa Goday asaa wozanaa paac'c'ee.<verse eid="PRO 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 17:4" />Iita Asay iita uraa haasayaa sisee; worddanchchaykka makkalaa oduwaa hayzzee.<verse eid="PRO 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 17:5" />Hiyyeesatuwaa bolla k'iliic'iyaa Asay unttuntta med'd'eedda S'oossaa boree; hara asaa gakkiyaa metuwaan nashetiyaa Asay murettenan attena.<verse eid="PRO 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 17:6" />Naanatuwaa naanatuu c'imeedda asatoo kallachchaa; aawotuunne aayetuu barenttu naanaatoo bonchcho.<verse eid="PRO 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 17:7" />Daro lo"o haasayay booza uraw giigenna; hewaappekka aad'uwaa wordduwaa haasayay asaa mooddiyaawoo giigenna.<verse eid="PRO 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 17:8" />Mattayiyaa immiyaawoo mattaayii bitaa mala; I simmeedda sa'aa ubbay aw injjetee.<verse eid="PRO 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 17:9" />Naak'ettiide bare naak'uwaa gentsiyaa uray siik'uwaa koyee; shin yewuwaa zaari zaariide wooc'iyaa uray, ammanettiyaa laggetuwaa shaakkee.<verse eid="PRO 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 17:10" />Boozay s'eetu gede lissuwaan shoc'ina eriyaawaappe akeekay de'iyaa Asay c'oo seerina eray aad'd'ee.<verse eid="PRO 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 17:11" />Iita Asay makkalabaa s'alala koyee; hewaa diraw, mek'etsi bayinna kaappuu Aa bolla kiitettana.<verse eid="PRO 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 17:12" />Boozatetsay oyk'k'eedda uraanna gakketiyaawaappe maratuwaa bonk'k'i akki diggeedda maahattina gakketiyaawe keeka.<verse eid="PRO 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 17:13" />Lo"uwaa ootseeddawaa kushiyaa iitaa zaariyaa uraw iitay Aa sooppe ubbakka kichchenna.<verse eid="PRO 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 17:14" />Walassay doommiidde, zeeruwaa d'uussiyaa haatsaa mala; hewaa diraw, walassaappe kasetaade palumiyaa agga.<verse eid="PRO 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 17:15" />Nagaranchchaa s'illissiyaawenne s'illuwaa bolla pirddiyaawe unttunttu laa"uukka Med'inaa Godaa sheneyiyaa oosuwaa.<verse eid="PRO 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 17:16" />Akeekaakka demanaw amuu aw bayinnaan de'ishshin, booza kushiyan de'iyaa Miishshay Aa ayaa maadanne?<verse eid="PRO 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 17:17" />Laggii ubbaa wodekka siik'ee; ishaykka metuwaa wode maaddanaw yelettee.<verse eid="PRO 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 17:18" />Akeekay pac'c'eedda Asay erenna uraa ac'uwaa c'igganaw waasiyaa gelee.<verse eid="PRO 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 17:19" />Walassaa dosiyaa Asay nagaraa dosee; ubbaa gede c'eek'ettiyaa Asay bayetsaa bare bolla s'eesee.<verse eid="PRO 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 17:20" />Geella k'ofay de'iyaa Asay lo"obaa demmenna; c'immiyaawaa haasayiyaa asaykka metuwaan gelee.<verse eid="PRO 17:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 17:21" />Booza na'aa yeleedda aawuu kayyottee; booza na'aa aawoo nashechchay baawa.<verse eid="PRO 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 17:22" />Wozanay nashettiyaawe asaw lo"o d'ale; shin kayyottiyaa ayaanay asaw wolk'k'aa d'ayissee.<verse eid="PRO 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 17:23" />Iita Asay pirddaa geellayanaw geeman mattaayiyaa akkee.<verse eid="PRO 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 17:24" />Akeekay de'iyaa uray aad'd'eeda eratetsaa sintsan wotsiide bee; shin booza ayifii biittaa sa'aa yuushshuwaa yuuyyiide s'eellee.<verse eid="PRO 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 17:25" />Booza na'ay bare aawuwaa kayyoyee; barena yeleedda aatokka zil"issee.<verse eid="PRO 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 17:26" />S'illo asaa muriyaawe, suure asaakka dechchiyaawe lo"a gidenna.<verse eid="PRO 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 17:27" />Amareeda k'aalaa haasayiyaa Asay eranchcha; woppa ayyaanay de'iyaa asaykka akeekanchcha.<verse eid="PRO 17:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 17:28" />Booza uray c'o"u gooppenne bare doonaa barooppe, eranchcha malatee.<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 18:1" />Shaakkettanaw koyiyaa Asay bare amuwaa kaallee; lo"o era ubbaakka p'alk'k'ee.<verse eid="PRO 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 18:2" />Boozay bare k'ofaa k'onc'c'issanawaa s'alala dosiyaawaappe attina, hara asaappe era akkanaw dosenna.<verse eid="PRO 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 18:3" />Iitatetsay yiyaa wode, kad'ii, kawushshaynne yeellay Aa kaalliide yi aggiino.<verse eid="PRO 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 18:4" />Asaa doonaappe kesiyaa haasayay c'iimmo haatsaa mala; aad'd'eeda eratetsaa pulttuukka goggiyaa haatsaa mala.<verse eid="PRO 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 18:5" />Bayzzanchchaa maaddiide, s'illuwaa pirddaa geellayiyaawe lo"a gidenna.<verse eid="PRO 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 18:6" />Booza Asay bare haasayan walassaa dentsee; Aa doonaappe kesiyaa k'aalay Aa bolla s'am"aa s'eesee.<verse eid="PRO 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 18:7" />Booza asay, haasayiidde barena k'ohee; Aa haasayay gitiyaa gidiide, Aa oyk'k'ee.<verse eid="PRO 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 18:8" />Zigirssaa k'aalay mal"o k'umaa mala; nashechchiide duge ganjjiyaa gakkee.<verse eid="PRO 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 18:9" />Bare ootsiyaa oosuwaan azalliyaa Asay bayzziyaa uraappe ayinne dummatenna.<verse eid="PRO 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 18:10" />Med'inaa Godaa suntsay mino gimbbiyaa mala; s'illo Asay yaa wos's'iide saro attana.<verse eid="PRO 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 18:11" />Shin dure asatoo unttunttu duretetsay yuushshuu gimbbetteedda katamaa mala; unttunttu k'ofaan unttunttu duretetsay mino dirssaadan unttuntta naagiyaawaa malatee.<verse eid="PRO 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 18:12" />Asay kunddanaappe kase Aa wozanay otorettee; bonchchettiyaawaappekka bare huup'iyaa zik'k'i ootsiyaawe sintsatee.<verse eid="PRO 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 18:13" />Sisennan de'iiddi zaariyaawe, hewe he uraw boozatetsanne yeella.<verse eid="PRO 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 18:14" />Asaa ayyaanay harggiyaa danddayanaadan maaddee; shin ayyaanay me"eretti kichchooppe, Aa ooni danddayanee?<verse eid="PRO 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 18:15" />Akeekanchcha asatuu tamaaranaw loytsi koyiino; aad'd'eeda eray de'iyaawaakka hayzziino.<verse eid="PRO 18:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 18:16" />Immiyaawe immiyaawoo ogiyaa dooyee; wolk'k'aama asaanakka erissee.<verse eid="PRO 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 18:17" />Kasetiide daannan mootiyaa uray baaligaaray yiide Aa oochchana gakkanaw, ubbaa gedekka he uray s'illuwaa malatee.<verse eid="PRO 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 18:18" />Saamaa yeggiyaawe palumiyaa te"ee; laa"u wolk'k'aama baaligaaratuwaakka shaakkee.<verse eid="PRO 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 18:19" />Naak'etteedda ishay gimbbetteedda katamaappe aad'd'iide minnee; Aa palumiikka birataa gordduwaa mala.<verse eid="PRO 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 18:20" />Bare doonaan haasayeeddawaappe Asay bare ganjjiyaa kuntsee; bare ins's'arssaappe keseeddawaan kallee.<verse eid="PRO 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 18:21" />Neeni haasayeeddawe neena wotsee woy wod'ee; hewaa diraw, neeni ne haasayaa gaasuwaan yiyaawaa akkanaw de'aassa.<verse eid="PRO 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 18:22" />Machchato demmeedda Asay lo"obaa demmeedda; he uray Med'inaa Godaankka nashettee.<verse eid="PRO 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 18:23" />Hiyyeesaa Asay awuddashiide haasayee; shin durii peenuk'k'eetiide zaaree.<verse eid="PRO 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 18:24" />Daro laggii de'iyaa Asay d'ayana; shin ishaappe aad'd'iide ammantsiyaa laggii de'ee.<verse eid="PRO 18:24" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 19:1" />Worddo haasayaa haasayiyaa boozaappe bare de'uwaan tooshii bayinna hiyyeesaa Asay keeka.<verse eid="PRO 19:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 19:2" />Eri bayinna seelay lo"a gidenna; hamettiidde elleelliyaa uraykka wora bee.<verse eid="PRO 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 19:3" />Itti itti Asay bare boozatetsan bare de'uwaa bayzzee; yaatiide k'ay Med'inaa Godaa bolla yilotee.<verse eid="PRO 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 19:4" />Duretetsay daro laggetuwaa gujjee; shin hiyyeesatetsay de'iyaa laggetuwaakka duutsee.<verse eid="PRO 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 19:5" />Worddo markkay murettenan beenna; wordduwaa haasayiyaawanttukka kessi akkikkino.<verse eid="PRO 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 19:6" />Daro Asay mooddiyaa asaa sintsa koyee; c'oo immiyaa uraanna Asay ubbay dabbotee.<verse eid="PRO 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 19:7" />Hiyyeesaa asaa Aa ishatuu ubbay is's'iino; hewaappekka aad'uwaa Aa laggetuu aappe haakkiino; I unttuntta awuddashiide kaallinakka, unttunttu Aa gatsi oytsikkino.<verse eid="PRO 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 19:8" />Aad'd'eeda eratetsaa demmiyaawe barena siik'ee; akeekaa karihi ootsi oyk'k'iyaawe lo"obaa demmee.<verse eid="PRO 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 19:9" />Worddo markkay murettenan attena; wordduwaa haasayiyaawekka d'ayana.<verse eid="PRO 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 19:10" />Booza uraw ishalo de'uu bessena; hewaappekka ayilii kaappotuwaa mooddiyaawe iitaa daree.<verse eid="PRO 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 19:11" />Aad'd'eeda eratetsay asaw danddayaa immee; bayzzeedda uraw atto giyaawekka bonchchissee.<verse eid="PRO 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 19:12" />Kaatiyaa hank'k'uu gaammuwaa guduwaa mala; shin Aa sabay maataa aac'issiya ketterssaa mala.<verse eid="PRO 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 19:13" />Booza na'ay bare aawuwaa d'ayissee; walassanchcha machchatakka gollii ubba gede s'okiyaa s'okuwaa mala.<verse eid="PRO 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 19:14" />Itti Asay golliyaanne mas'uwaa bare aawuwaappe laattanaw danddayee; shin akeekanchcha machchato Med'inaa Goday immee.<verse eid="PRO 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 19:15" />C'oo zolppakkattiyaa uraw gem"ishuu yee; oosuwaa ootsenna Asay koshattee.<verse eid="PRO 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 19:16" />Azazuwaa naagiide ootsiyaa asay, bare shemppuwaa naagee; shin sheneko giyaa Asay hayk'k'ee.<verse eid="PRO 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 19:17" />Hiyyeesaw keekkiyaa Asay Med'inaa Godaw tal"ee; I he lo"o oosuwaa ac'uwaa c'iggee.<verse eid="PRO 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 19:18" />Simmiyaa hidootay de'ishiina, ne naanatuwaa seera; seerana d'ayooppe, neeni unttuntta bayzzaadda.<verse eid="PRO 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 19:19" />Hank'k'uwaa suulliyaa Asay bare gatiyaa akko; Aa agga; neeni Aa ashshiyaawaa gidooppe, harattuwaakka neeni Aa hewaadan ootsanawe attena.<verse eid="PRO 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 19:20" />Zoriyaa sisa; timirttiyaakka akka. Yaatooppe, neeni wurssetsan aad'd'eeda eranchcha gidanassa.<verse eid="PRO 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 19:21" />Asay darobaa halchchee; shin Med'inaa Goday geeddawe polettee.<verse eid="PRO 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 19:22" />Asaappe koyettiyaawe aggena siik'uwaa; worddanchcha gidanaappe hiyyeesaa gidiyaawe keeka.<verse eid="PRO 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 19:23" />Med'inaa Godaw yayyiyaawe de'oo kaaletsee; aw yayyiyaa Asay kalliide de'ee; iitabaykka Aa bochchenna.<verse eid="PRO 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 19:24" />Itti itti Asay daro azalla; wos'iyaan tusheedda sooluwaakka pude baaranaw waayettee.<verse eid="PRO 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 19:25" />Neeni k'iliic'iyaawaa shoc'ooppe, akeekay pac'c'eeddawe c'inc'c'atetsaa tamaarana; akeekanchcha asaa neeni seerooppe, I eratetsaa demmana.<verse eid="PRO 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 19:26" />Bare aawuwaa bonk'k'iyaa na'ay, bare aatokka sooppe kessiide yederssiyaa na'ay, he na'ay yeellaanne kawushshaa ahiyaa na'aa.<verse eid="PRO 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 19:27" />Ta na'aw, neeni zoriyaa sisiyaawaa aggeedawaa gidooppe, eraw zokkiyaa zaaraadda.<verse eid="PRO 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 19:28" />Worddo markkay suure pirddaa bolla k'iliic'ee; iita asaa doonay iitatetsaa gujjiide mittee.<verse eid="PRO 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 19:29" />K'iliic'iyaawanttoo pirdday, boozatookka wad'ay koshshee.<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 20:1" />Daro matsoyiyaa ushshaa ushiyaawe daro bidiseenne walassee; matsottiyaa Asay wozanay pac'c'eedda asaa.<verse eid="PRO 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 20:2" />Kaatiyaa hank'k'uu gaammuwaa gudetsaa mala; Aa yiloyiyaa Asay bare shemppuwaa bolla pirddee.<verse eid="PRO 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 20:3" />Palumiyaappe gas'an de'iyaawe aawoo bonchcho; shin booza Asay ubbay walak'ettanaw elleellee.<verse eid="PRO 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 20:4" />Azalla goshshanchchay wodiyaa naagiide goshenna; hewaa diraw, katsaa c'akkiyaa wode I woossee; shin ayaakka demmenna.<verse eid="PRO 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 20:5" />Asaa wozanaa halchchuu c'iimmo ollaa giddon de'iyaa haatsaa mala; shin wozanaama Asay hewaa duuk'k'iide kessee.<verse eid="PRO 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 20:6" />Daro asatuu barenttu keekkatetsaa odiino; shin tumu ammanettiyaa asaa demmanawe oonee?<verse eid="PRO 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 20:7" />S'illo Asay tooshii bayinna de'uwaa de'ee; Aa kaalliide, Aa naanatuukka anjjetteedawantta.<verse eid="PRO 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 20:8" />Kaatii pirddanaw bare kawutetsaa araatan utteedda wode, iita ubbaa bare ayifiyaan hark'k'iide kessee.<verse eid="PRO 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 20:9" />«Ta wozanaa geeshshaad; taanan nagarikka baawa» yaaganaw danddayiyaa Asay de'aneeshsha?<verse eid="PRO 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 20:10" />Med'inaa Goday wordduwaa miizaanan yiggiyaawanttanne likke gidennaban makkiyaawantta is's'ee.<verse eid="PRO 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 20:11" />Na'ay geeshshanne suure gidiyaawe I ootsiyaa oosuwaan erettee.<verse eid="PRO 20:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 20:12" />Sisiyaa haytsaanne s'eelliyaa ayifiyaanne, unttuntta laa"uwaakka Med'inaa Goday med'd'eedda.<verse eid="PRO 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 20:13" />Gem"ishuwaan ne wodiyaa wurssoppa; neeni hiyyeessana. Beegotta; yaatooppe, neeni katsaa kallana.<verse eid="PRO 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 20:14" />Shammiyaa asay, «K'ohee! K'ohee!» yaagee; shin beeddawaappe guyyiyaan, «geluwaan shamaad» yaagiidde c'eek'ettee.<verse eid="PRO 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 20:15" />Eray kumeedda haasayay work'k'aappekka ink'k'uwaa giyaa daro al"o shuchchaappekka aad'd'eeda al"obaa.<verse eid="PRO 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 20:16" />Erenna asaw waasiyaa geliyaa uraa mayuwaa k'aari akkite; imatsaa asaw waasiyaa geliyaa uraa mayuwaa oyk'k'ite.<verse eid="PRO 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 20:17" />Wordduwaan demmeedda katsay asaa mal"ee; shin ak'i kesiidde, doonaa giddon shafiyaadan hanee.<verse eid="PRO 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 20:18" />Zoriyaa akkaade ne halchchiyaawaa halchcha; zoriyaa akkenan de'aadde olaw booppa.<verse eid="PRO 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 20:19" />Zigiriyaa Asay s'uuraa gentsenna; hewaa diraw, odanchcha uraanna gakkettoppa.<verse eid="PRO 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 20:20" />Asay bare aawuwaa woy bare aato shek'k'ooppe, Aa de'uwaa s'omppiyaa d'ip'p'i go d'uman to'ana.<verse eid="PRO 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 20:21" />Koyruwan ellekka shiik'eedda ak'uu wurssetsan anjjettenna.<verse eid="PRO 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 20:22" />New iitaa ootseedda uraw, «taanikka aw iitaa ootsana» gooppa; Med'inaa Godaan ammanettaade naaga; I neena ashshana.<verse eid="PRO 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 20:23" />Med'inaa Goday laa"u k'ommo miizaanatuwaa shenetee; wordduwaa miizaanatuukka Aa nashechchikkino.<verse eid="PRO 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 20:24" />Asay baanaw bessiyaa ogiyaa Med'inaa Goday kaaletsee; yaatina, Asay bare de'uwaan baana ogiyaa wootiide akeekanaw danddayii?<verse eid="PRO 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 20:25" />Ittibaa elleelliide, «Hawaa taani S'oossaw immaad» gi diggiyaawenne guyyeppe zink'k'ottiyaawe, hewe asaa oyk'k'iyaa p'ire.<verse eid="PRO 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 20:26" />Aad'd'eeda eranchcha kaatii makkalanchchatuwaa shaakkiide eree; I unttuntta k'arettennaan muree.<verse eid="PRO 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 20:27" />Asaa ayyaanay Med'inaa Godaw s'omppiyaa; hewaa diraw, I nu giddo asatetsaa ubbaa pilggi s'eellee.<verse eid="PRO 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 20:28" />Aggena siik'uunne ammanettiyaawe kaatiyaa naagiino; Aa kawutetsaa araatay aggena siik'uwaan minnee.<verse eid="PRO 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 20:29" />Yalagatuwaa bonchchuu unttunttu wolk'k'aa; c'imatookka unttunttu puuluntsay unttunttoo bonchchuwaa.<verse eid="PRO 20:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 20:30" />Mino muruu iitatetsaa shoddee; wad'd'iyaawe iita wozanaa laammanaw danddayee.<verse eid="PRO 20:30" /></para>
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 21:1" />Kaatiyaa wozanay Med'inaa Godaa kushiyaanna; I Aa wozanaa goggiyaa haatsaa zaariyaawaadan, bare koyeeddasaa zaaree.<verse eid="PRO 21:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 21:2" />Asay ootsiyaawe ubbay izaawoo likke malatee; shin Med'inaa Goday Aa wozanaa k'ofaa paac'c'ee.<verse eid="PRO 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 21:3" />Yarshshuwaa yarshshiyaawaappekka aatsiide, s'illobaanne suurebaa ootsiyaawaa Med'inaa Goday dosee.<verse eid="PRO 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 21:4" />Iitatuu otorettiyaawaaninne ayyiyaawan erettiino; hewekka nagaraa.<verse eid="PRO 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 21:5" />Mino oosanchchaa halchchuu dureyee; shin elleelliyaa ubbay hiyyeessana.<verse eid="PRO 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 21:6" />Worddotiide dagayeedda duretay penttuwaa suuluwaadan d'ayee; hewaa koyiyaawanttu hayk'k'uwaa koyiino.<verse eid="PRO 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 21:7" />Iitatuu suurebaa ootsanaw is's'iyaa diraw, unttunttu makkala oosuu unttuntta akkiide bee.<verse eid="PRO 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 21:8" />Bayzzanchchatuu geella ogiyaan hamettiino; shin geeshshatuu suurebaa ootsiino.<verse eid="PRO 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 21:9" />Walak'ettiyaa machchattinna itti golliyaan de'iyaawaappe he golliyaa kashaan de'iyaawe keeka.<verse eid="PRO 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 21:10" />Iitatuu iitabaa ootsanaw amottiino; barenttu shoorotoo k'arettikkino.<verse eid="PRO 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 21:11" />K'iliic'iyaawe mureteedda wode, wozanay pac'c'eedda uray aad'd'eeda eraa tamaaree; k'ay wozanaama uray tamaariide, eraa demmee.<verse eid="PRO 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 21:12" />S'illo S'oossay iitatuwaa son oosettiyaawaa ubbaa be'ee; unttuntta aatsi yeggiide d'ayissee.<verse eid="PRO 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 21:13" />Hiyyeesaa waasuwaa sisanaappe giide, bare haytsaa tuc'c'iyaa uray, ikka waassana; alliyaawe d'ayana.<verse eid="PRO 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 21:14" />Geeman immiyaa imuu hank'k'uwaa doshissee. Afilaa gidduwaana immeedda mattaayii suulo hank'k'uwaa irs's'issee.<verse eid="PRO 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 21:15" />Suure pirdday pirddetteedda wode, hewe s'illoo nashshechchaa; shin iitaa ootsiyaawanttoo dagama.<verse eid="PRO 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 21:16" />Akeeka ogiyaappe haddireedda uraa hayk'k'uu naagee.<verse eid="PRO 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 21:17" />Aad'o injjiyaan de'ana giyaa uray mank'k'ee; woyniyaa eessaanne zayitiyaa dosiyaa Asay durettenna.<verse eid="PRO 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 21:18" />Itti itti gedenne S'oossaa asatuwaa ashshanaw iita asatuu muretiino; ammanettena asatuukka suure asatuwaa diraw muretiino.<verse eid="PRO 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 21:19" />Walak'ettiyaanne yilotiyaa machchattinna de'anaappe bazzuwaan de'iyaawe keeka.<verse eid="PRO 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 21:20" />Wozanaama uraa son mal"o k'umaynne oyssay minjjettee; shin booza Asay barew de'iyaawaa ubbaa mi diggee.<verse eid="PRO 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 21:21" />S'illotetsaanne aggena siik'uwaa koyiyaa uraa laytsay aduk'k'ee; k'ay he uray s'illotetsaanne bonchchuwaa demmee.<verse eid="PRO 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 21:22" />Wozanaama Asay wolk'k'aama olanchchatuu de'iyaa katamaa oliide oyk'k'ee; unttunttu ammanetteeda mino geessuwaakka laalee.<verse eid="PRO 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 21:23" />Bare doonaanne bare ins's'arssaa naagiyaa Asay barena metuwaappe naagee.<verse eid="PRO 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 21:24" />Otorettiyaanne ayyiyaa Asay k'iliic'iyaawaa geetettee; I otoranchcha gideedda diraw, asaw k'oppenna.<verse eid="PRO 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 21:25" />Azallaa amuu wod'ee; ayaw gooppe, I ootsanaw koyenna.<verse eid="PRO 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 21:26" />Azallay gallassaa kumentsaa darobaa demmanaw amottee; shin s'illuu barew ashshenan immee.<verse eid="PRO 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 21:27" />S'oossay iitatuwaa yarshshuwaa shenetee; hewaappekka unttunttu aw iita k'ofaan shiishshiyaa yarshshuwaa aatsi shenetee.<verse eid="PRO 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 21:28" />Worddo markkay d'ayana; shin k'oppiide akeekan haasayiyaa uraa haasayay akettana.<verse eid="PRO 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 21:29" />Iita Asay tawaa s'alalay likke gee; shin suure Asay yuushshi k'oppee.<verse eid="PRO 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 21:30" />Asay bare aad'd'eeda eratetsan, akeekaaninne zoriyaan Med'inaa Godaana ek'ettanaw danddayenna.<verse eid="PRO 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 21:31" />Olaw paraa kooranaw danddayettee; shin olaa s'oonissiyaawe Med'inaa Godaa.<verse eid="PRO 21:31" /></para>
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 22:1" />Lo"o suntsay daro duretetsaappe aad'd'ee; sabettiyaawekka biraappenne work'k'aappe aad'd'ee.<verse eid="PRO 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 22:2" />Duriyaanne mank'k'uwaa ubbaakka Med'inaa Goday med'd'eedda; hewan unttunttu laa"uukka k'ara.<verse eid="PRO 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 22:3" />C'inc'c'a Asay iitaa be'iide, k'osetti aatsee; shin akeekay pac'c'eedda Asay metuwaan geliide k'ohettee.<verse eid="PRO 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 22:4" />Neeni ashkke gidooppenne Med'inaa Godaw yayyooppe, duretetsaa, bonchchuwaanne de'uwaa demmana.<verse eid="PRO 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 22:5" />Iita uraa ogiyaan aguntsayinne p'irii de'ee; shin barena naagiyaa Asay unttunttuppe haakkee.<verse eid="PRO 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 22:6" />Na'ay waaniide de'ana bessintto tamaarissa; yaatooppe, I c'imiidekka hewaa aggena.<verse eid="PRO 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 22:7" />Durii hiyyeesaa mooddee; tal"i akkeedawe tal"iyaa immeeddawoo ayile gidee.<verse eid="PRO 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 22:8" />Nagaraa zeriyaa uray waayiyaa c'akkee; haratuwaa I tuggayiyaa tugga s'am"ay me"enna.<verse eid="PRO 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 22:9" />Keeka Asay bare k'umaappe hiyyeesaw c'oo immiyaa diraw anjjettana.<verse eid="PRO 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 22:10" />K'iliic'iyaa asaa kessa diggooppe, palumii, walassaynne borii kichchana.<verse eid="PRO 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 22:11" />Neeni wozanaa geeshshatetsaanne keekaa haasayaa dosooppe, kaatii neenana dabbotee.<verse eid="PRO 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 22:12" />Med'inaa Goday eretetsaa naagee; shin worddanchchatuwaa k'aalaa I aatsi yeggee.<verse eid="PRO 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 22:13" />Booza asay, «Taani kare kesooppe, gaammuu taana maana; taana ogiyaan Asay wod'ana» yaagee.<verse eid="PRO 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 22:14" />Woshumiyaa mac'c'a mishirati doonay c'iimmo ollaa mala; Med'inaa Goday hank'k'etteedda uray Aa giddon kunddee.<verse eid="PRO 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 22:15" />Na'aa wozanaa azallatetsay bak'k'i oyk'k'ee; shin k'ayis'eeriyaan muriyaawe aappe haassee.<verse eid="PRO 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 22:16" />Barew mas'uwaa gujjana giide, hiyyeesaa naak'k'iyaawe duriyaw imuwaa immiyaawe laa"uukka hiyyeessana.<verse eid="PRO 22:16" /></para>
  <para style="s">Hattamu Aad'd'eeda Eraa Haasayatuwaa</para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 22:17" />Ne haytsaa haa yeggaade, aad'd'eeda eranchchay odiyaawaa sisa; ne wozanaakka ta eraakko zaara. <verse eid="PRO 22:17" /><verse number="18" style="v" sid="PRO 22:18" />Ayaw gooppe, unttuntta ne wozanaan wotsooppenne ne doonaankka unttunttu ubbaa hassayooppe, neeni nashettana. <verse eid="PRO 22:18" /><verse number="19" style="v" sid="PRO 22:19" />Ne ammanuu Med'inaa Godaan gidana mala, taani neena hachchi tamaarissaad. <verse eid="PRO 22:19" /><verse number="20" style="v" sid="PRO 22:20" />Taani new zoriinne eratetsay de'iyaa hattamu leemisatwaa s'aafoweshi! <verse eid="PRO 22:20" /><verse number="21" style="v" sid="PRO 22:21" />Neena kiitteeddawoo neeni likke zaaruwaa zaarana mala, taani neena tumatetsaa tamaarissaad.<verse eid="PRO 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 22:22" />Hiyyeesatoo ayaynne bayinna diraw, unttunttuwaa bonk'k'oppa; chilootankka metootanchchatuwaa maataa d'ayissoppa.<verse eid="PRO 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 22:23" />Ayaw gooppe, Med'inaa Goday unttunttu diraw mootettana; unttuntta bonk'k'eeddawanttakka I bonk'k'ana.<verse eid="PRO 22:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 22:24" />Hank'k'ettiyaa uraanna laggetoppa; hank'k'ettanaw elleelliyaa uraannakka zuppetoppa.<verse eid="PRO 22:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 22:25" />Neeni Aa hanuwaa meezetooppe, guyyeppe agganaw danddayakka.<verse eid="PRO 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 22:26" />Asaw ac'uwaa ta k'ans's'ana gaade waasiyaa geloppa.<verse eid="PRO 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 22:27" />Neeni k'ans's'iyaawe d'ayooppe, ne gisiyaa hiis'ay attenan, new de'iyaabay ubbay aketana.<verse eid="PRO 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 22:28" />Ne mayzza aawotuu tokkeedda beni zawaa shoddoppa.<verse eid="PRO 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 22:29" />Bare oosuwaa loohatetsan ootsiyaa asaa be'aaddi? I kaatetoo ootseeppe attina, c'oo asatoo ootsenna.<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 23:1" />Neeni asaa mooddiyaawaanna ittippe k'umaa maanaw utteedda wode, ne sintsan de'iyaawaa loytsaade akeeka. <verse eid="PRO 23:1" /><verse number="2" style="v" sid="PRO 23:2" />Neeni daro yora asaa gidooppe, naagetta. <verse eid="PRO 23:2" /><verse number="3" style="v" sid="PRO 23:3" />I neena paac'c'anaw danddayiyaa diraw, aad'd'eeda mal"o k'umaw yawunettoppa.<verse eid="PRO 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 23:4" />Durettanaw daaburoppa; hewaa mala keesiyaa agganaw c'inc'c'a gida. <verse eid="PRO 23:4" /><verse number="5" style="v" sid="PRO 23:5" />Hewaa mala duretetsay neeni s'eellishshin d'ayana; k'efiyaa kessiide arggantsawaadan, saluwaa paallana.<verse eid="PRO 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 23:6" />Uuziyaa k'umaa mooppa; Aa mal"o k'umaakka maanaw amottoppa. <verse eid="PRO 23:6" /><verse number="7" style="v" sid="PRO 23:7" />Malatissanaw I neena, «Ma; usha» yaageeppe attina, Aa wozanay neenanna de'enna. <verse eid="PRO 23:7" /><verse number="8" style="v" sid="PRO 23:8" />Neeni meedda laafa k'umaa c'ooshana; ne galataykka mela gidana.<verse eid="PRO 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 23:9" />Boozaw lo"obaa haasayoppa; ayaw gooppe, ne aad'd'eeda era haasayaa I kad'ana.<verse eid="PRO 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 23:10" />Beni zawaa shoddoppa; k'ay aawuu bayinna naanatuwaa gadiyaa zawaa sugoppa; <verse eid="PRO 23:10" /><verse number="11" style="v" sid="PRO 23:11" />ayaw gooppe, unttuntta ashshiyaa S'oossay mino; I unttunttu diraw neenana mootettana.<verse eid="PRO 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 23:12" />Ne asttamaarii new odiyaawaa hayzza; ne haytsaakka eraa k'aalaakko zaara.<verse eid="PRO 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 23:13" />Na'aa seerennan aggoppa; neeni Aa k'ayis'eeriyaan wad'd'ooppe, I hayk'k'enna. <verse eid="PRO 23:13" /><verse number="14" style="v" sid="PRO 23:14" />Neeni Aa k'ayis'eeriyaan wad'd'ooppe, Aa shemppuwaa hayk'k'uwaappe ashshaasa.<verse eid="PRO 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 23:15" />Ta na'aw, neeni ne wozanaan aad'd'eeda eranchcha gidooppe, ta wozanaykka nashettana; <verse eid="PRO 23:15" /><verse number="16" style="v" sid="PRO 23:16" />ne ins's'arssay suurebaa haasayooppe, ta wozanay nashettee.<verse eid="PRO 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 23:17" />Nagaranchchatuwaa k'anaattoppa; shin ubbaa gede Med'inaa Godaw yayyiyaawaa aggoppa. <verse eid="PRO 23:17" /><verse number="18" style="v" sid="PRO 23:18" />Yaatooppe new sintsanaw sa'ay keekkana; ne hidootaykka d'ayenna.<verse eid="PRO 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 23:19" />Ta na'aw, sisa; wozanaama gida; ne wozanaa suure ogiyaan wotsa. <verse eid="PRO 23:19" /><verse number="20" style="v" sid="PRO 23:20" />Daro woyniyaa eessaa ushiyaawanttunanne ashuwaa muussaw yaaretiyaawanttuna zuppetoppa; <verse eid="PRO 23:20" /><verse number="21" style="v" sid="PRO 23:21" />ayaw gooppe, matsottiyaawanttunne yoranchchatuu mank'k'ana; gem"ishshuwaa daruu asaa wureedda c'urk'k'aa mayzzisee.<verse eid="PRO 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 23:22" />Neena yeleedda ne aabbu odiyaawaa sisa; ne aatakka ec'eedda wode kad'oppa. <verse eid="PRO 23:22" /><verse number="23" style="v" sid="PRO 23:23" />Tumuwaa, aad'd'eeda eratetsaa, timirttiyaanne akeekaa shammappe attina, ubbakka zal"oppa. <verse eid="PRO 23:23" /><verse number="24" style="v" sid="PRO 23:24" />S'illo na'aa aabbu loytsi nashettana; wozanaama na'aa yeleedda uraykka an hashshu gaana. <verse eid="PRO 23:24" /><verse number="25" style="v" sid="PRO 23:25" />Ne aabbunne ne aata nashetino; neena yeleeddaanakka hashshu gu.<verse eid="PRO 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 23:26" />Ta na'aw, ta zoriyaa hayzza; taani haniyaawaadan hana. <verse eid="PRO 23:26" /><verse number="27" style="v" sid="PRO 23:27" />Ayaw gooppe, woshumiyaa mishirata c'iimmo ollaa mala; c'aaratuwaa oyk'k'iyaa machchatakka un"a ollaa mala. <verse eid="PRO 23:27" /><verse number="28" style="v" sid="PRO 23:28" />Aa paannuwaadan k'osetta uttaade naagaw; ammanettena attuma asaa asaa giddon darissaw.<verse eid="PRO 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 23:29" />«Woo!» giyaa waasuu oossee? Kayyuu oossee? Walassay oossee? Zuuzuntsay oossee? Gaasuu bayinnan madus's'iyaawe oossee? Ayifii zo"iyaawe oossee? <verse eid="PRO 23:29" /><verse number="30" style="v" sid="PRO 23:30" />Woynniyaa eessaa ushiidde gam"iyaawanttussa gidennee? Walaketteedda woyniyaa eessaa ushi ushi be'iyaawanttussa gidennee? <verse eid="PRO 23:30" /><verse number="31" style="v" sid="PRO 23:31" />Woynniyaa eessay zo"eedda wode, Aa malay birilliyaa giddon p'ooliyaa wode, ushishin walalattiidde geliyaa wode, Aa s'eelloppa. <verse eid="PRO 23:31" /><verse number="32" style="v" sid="PRO 23:32" />Wurssetsan I shooshshaadan dukkee; mulumuk'k'e shooshshaadankka bare yishshaa puukkee. <verse eid="PRO 23:32" /><verse number="33" style="v" sid="PRO 23:33" />Ne ayifii be'i erennawaa be'ana; ne wozanaykka suure k'oppanawunne haasayanaw danddayenna. <verse eid="PRO 23:33" /><verse number="34" style="v" sid="PRO 23:34" />Neeni abbaa giddon hobbii k'aatsiyaa markkabiyaa s'eeran giseedda uraa mala gidana. <verse eid="PRO 23:34" /><verse number="35" style="v" sid="PRO 23:35" />Neeni, «Unttunttu taana dechcheeddino; shin taani k'ohettabeykke. Unttunttu taana wad'd'eeddino; shin taw erettibeenna. Hara ushshaa ushanaw taani awude denddandditaashsha?» yaagana.<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 24:1" />Ta na'aw, iita asatuwaa mala gidaarikkitaashsha gooppa; unttunttunna dabbotanawukka amottoppa; <verse eid="PRO 24:1" /><verse number="2" style="v" sid="PRO 24:2" />ayaw gooppe, unttunttu ubbaa gede makkalabaa mak'ettiino; barenttu ins's'arssan geniyaabaa haasayiino.<verse eid="PRO 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 24:3" />Gollii aad'd'eeda eratetsan kees'ettee; akeekankka minnee. <verse eid="PRO 24:3" /><verse number="4" style="v" sid="PRO 24:4" />Eray de'ooppe, k'ol"uu al"obaaninne lo"oban ubbaan kumee.<verse eid="PRO 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 24:5" />Wozanaama uraw wolk'k'aama wolk'k'ay de'ee; eranchcha asaykka minotetsaa gujjee. <verse eid="PRO 24:5" /><verse number="6" style="v" sid="PRO 24:6" />Neeni olaw kesanaappe kasetaade halchchuwaa halchchanaw koshshee; daro zoriyaawanttu zoriyaan s'oonuu beettee.<verse eid="PRO 24:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 24:7" />Boozay aad'd'eeda eratetsaa akeekanaw danddayenna; hak'a yaa'ankka odiyaawe ayinne baawa.<verse eid="PRO 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 24:8" />Iitaa ootsanaw halchchiyaa uray genanchcha geetettana. <verse eid="PRO 24:8" /><verse number="9" style="v" sid="PRO 24:9" />Boozatetsaa k'ofay nagaraa; Asay k'iliic'iyaawaa is's'ee.<verse eid="PRO 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 24:10" />Neeni metuwaa gallassi laafooppe, ne wolk'k'ay guutsa giyaawaa.<verse eid="PRO 24:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 24:11" />Hayk'k'anaw bessenaan, hayk'k'oo pirddiide afiyaawantta ashsha; wod'ana haniyaa wode c'o"u gaade s'eelloppa. <verse eid="PRO 24:11" /><verse number="12" style="v" sid="PRO 24:12" />Neeni, «Nuuni hawaa eribeykko» yaagooppe, wozanaa eriyaawe I be'ennee? Ne de'uwaa naagiyaawe erennee? Asaa ubbaw Aa oosuwaa oosuwaadan zaarennee?<verse eid="PRO 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 24:13" />Ta na'aw, eessaa ma; eessay lo"a. Eessaa ililuu goggoc'c'uwaan mal"ee. <verse eid="PRO 24:13" /><verse number="14" style="v" sid="PRO 24:14" />Aad'd'eeda eratetsaykka hewaa mala; I ne shemppoo mal"o gidiyaawaa era. Neeni Aa demmiyaawaa gidooppe, sintsanna yaana hidootay newaa; neeni akkana gaade hidootan naagiyaawekka d'ayenna.<verse eid="PRO 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 24:15" />S'illuwaa golliyaanne mas'uwaa bonk'k'anaw k'oppiyaa iita asaadan hanoppa. <verse eid="PRO 24:15" /><verse number="16" style="v" sid="PRO 24:16" />S'illo Asay laappun gede kunddooppekka denddee; shin iitatuu metuwaan d'ayana.<verse eid="PRO 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 24:17" />Ne morkkii kunddiyaa wode nashettoppa; I d'ubettiyaa wodekka, «Hashshu!» gooppa. <verse eid="PRO 24:17" /><verse number="18" style="v" sid="PRO 24:18" />Neeni nashetooppe, Med'inaa Goday hewaa be'iide nashettena; Aa hank'k'ettiyaawaakka aggi aggana.<verse eid="PRO 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 24:19" />Iitaa ootsiyaawanttu diraw hirggoppa; unttunttu mala gidaarikkitaashsha gooppa. <verse eid="PRO 24:19" /><verse number="20" style="v" sid="PRO 24:20" />Ayaw gooppe, iita uraw sintsanna yaana hidootay baawa; iitatuwaa s'omppiikka to'ana.<verse eid="PRO 24:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 24:21" />Ta na'aw, Med'inaa Godawunne kaatiyaw yayya; unttunttoo makkaliyaawanttunakka zuppetoppa. <verse eid="PRO 24:21" /><verse number="22" style="v" sid="PRO 24:22" />Ayaw gooppe, hewaa mala asatuwaa k'oppenna metuu gakkee; kaatiyaappenne S'oossaappe yaana metuwaa oonee eriyaawe?<verse eid="PRO 24:22" /></para>
  <para style="s">Hara Aad'd'eeda Eraa Haasayatuwaa</para>
  <para style="m">
    <verse number="23" style="v" sid="PRO 24:23" />Aad'd'eeda eranchchatuu gujjiidekka hawaadan yaageeddino:</para>
  <para style="p" vid="PRO 24:23">Pirddiidde maaddiyaawe lo"a gidenna. <verse eid="PRO 24:23" /><verse number="24" style="v" sid="PRO 24:24" />Bayzzanchchaa, «Neeni bayzzabaakka» yaagiyaa daannaa Asay shek'k'ana; kawutetsatuukka Aa is's'ana. <verse eid="PRO 24:24" /><verse number="25" style="v" sid="PRO 24:25" />Bayzzanchchaa muriyaawanttu loytsi nashettananne anjjettana.<verse eid="PRO 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 24:26" />Suure zaaruwaa zaariyaawe dabbotoo malaataa mala.<verse eid="PRO 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 24:27" />Kasetaade ne gadiyaa ootsa; katsaakka zera; hewaappe guyyiyaan, ne golliyaa kees's'a.<verse eid="PRO 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 24:28" />Ne shooruwaa bolla gaasuu bayinnan markkattoppa; ne doonaankka c'immoppa. <verse eid="PRO 24:28" /><verse number="29" style="v" sid="PRO 24:29" />«I taw ootseeddawaadan, taani aw ootsana; taani aw Aa oosuwaa kushiyaa zaarana» yaagoppa.<verse eid="PRO 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 24:30" />Taani itti gallassi, itti azallanne akeekay pac'c'eedda bitaniyaa gaden de'iyaa woyniyaa turaa gidduwaana aad'aad. <verse eid="PRO 24:30" /><verse number="31" style="v" sid="PRO 24:31" />Aad'd'iyaa wode, aguntsayinne sharafay goozi wotseedda; yuushshuwaan Shuchchaa gimbbiikka koleti kichcheedda. <verse eid="PRO 24:31" /><verse number="32" style="v" sid="PRO 24:32" />Taani Aa be'eedda wode, k'oppaad; taani be'eeddawaappe timirttiyaa tamaaraad. <verse eid="PRO 24:32" /><verse number="33" style="v" sid="PRO 24:33" />Neeni guutsaa lip'p'i ga; guutsaa gem"ishsha; ne kushiyaakka shiishshaade guutsaa shemppa akka.<note caller="-" style="x"><char style="xo" closed="false">24:33-34 </char><char style="xt" closed="false"><ref loc="PRO 6:10-11">Lem. 6:10-11</ref></char></note> <verse eid="PRO 24:33" /><verse number="34" style="v" sid="PRO 24:34" />Hewaappe guyyiyaan, hiyyeesatetsay paannuwaadan yaana; pac'aykka olaa miishshaa oyk'k'eedda asaadan puttu gaana.<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="s">Solomon S'aafeedda Hara Leemisatwaa</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1" />Hawanttukka k'ay, Yihudaa Kaatiyaa Hizk'k'iyaasa asatuu duuk'k'iide s'aafeedda Solomona leemisatwaa.<verse eid="PRO 25:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 25:2" />S'uuraa gentsiyaawe S'oossaw bonchcho; s'uuraa pilggiide kessiyaawe k'ay kaatetoo bonchcho.<verse eid="PRO 25:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 25:3" />Salotuwaa d'ok'k'atetsaanne sa'aa c'iimmatetsaa Asay gakkennawaadan, kaatetuwaa k'ofaakka Asay eranaw danddayenna.<verse eid="PRO 25:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 25:4" />Biraappe k'itaa digga; hewaappe guyyiyaan, wogaac'ii k'os's'iide, lo"obaa kessana.<verse eid="PRO 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 25:5" />Kaatiyaa sintsappe iitatuwaa digga; yaatooppe, Aa kawutetsaa araatay s'illotetsan min ek'k'ana.<verse eid="PRO 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 25:6" />Kaatiyaa sintsa aad'd'iyaa wode c'eek'ettoppa; wolk'k'aama asatuwaappe gidduwaan sa'aa koyoppa.<note caller="-" style="x"><char style="xo" closed="false">25:6-7 </char><char style="xt" closed="false"><ref loc="LUK 14:8-10">Luk'. 14:8-10</ref></char></note> <verse eid="PRO 25:6" /><verse number="7" style="v" sid="PRO 25:7" />Neeppe gitatiyaa asaw sa'aa immanaw kaappuu neena dentsina kawushiyaawaappe, kaappuu neena, «Hawaakko d'ok'k'u ga» giyaawe new keeka.<verse eid="PRO 25:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 25:8" />Ne ayifiyaan be'eeddawaa markkattanaw dabaabaa baanaw elleelloppa; ayaw gooppe, neeni markkatta simmina, hara Asay ne markkatetsay balaa gidiyaawaa k'onc'c'issooppe, neeni yeellatana. <verse eid="PRO 25:8" /><verse number="9" style="v" sid="PRO 25:9" />Neeppenne ne shooruwaappe gidduwaan palumii med'ettooppe, aanana haasayaade ne palumiyaa wurssa. Hara asaa s'uuraa k'onc'c'issoppa. <verse eid="PRO 25:9" /><verse number="10" style="v" sid="PRO 25:10" />Hewe d'ayooppe, neeni odiyaawaa siseedda Asay neena kawushshana; hewan ne suntsay laa"entso simmennaadan bayana.<verse eid="PRO 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 25:11" />Koshshiyaa wodiyaan haasayetteedda likke k'aalay biraa bolla tigeedda work'k'aa alleek'k'uwaa mala.<verse eid="PRO 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 25:12" />Hayzziyaa uraa eranchcha Asay zoriyaa zorii haytsaan wotseedda work'k'aa woy geeshsha work'k'aappe ootseedda alleek'k'uwaa mala.<verse eid="PRO 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 25:13" />Katsaa c'akkiyaa boniyaan irs's'a haatsay ushina aliyaawaadan, kiittina ammanettiyaa Asay barena kiittiyaawantta nashechchee.<verse eid="PRO 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 25:14" />Immennabaa «Immana» yaagiidde c'eek'ettiyaa Asay iray bayinna shaariyaanne c'arkkuwaa mala.<verse eid="PRO 25:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 25:15" />Danddayanchcha Asay deriyaa mooddiyaawoo odiide amantsee; liik'o k'aalay mek'etsaa aad'd'iidde gelee.<verse eid="PRO 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 25:16" />Eessaa demmooppe, kallana gakkanaw ma; shin darissooppe, neeni c'ooshana. <verse eid="PRO 25:16" /><verse number="17" style="v" sid="PRO 25:17" />Neena uufiide is's'ennaadan, ne shooruwaa golle ubbaa gede booppa.<verse eid="PRO 25:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 25:18" />Bare shooruwaa bolla wordduwaan markkattiyaa Asay gatimay, mashshaynne k'ara aday asaa k'ohiyaawaa keeshshaa k'ohee.<verse eid="PRO 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 25:19" />Metuwaa wode ammanettena uran zemppiyaawe k'aas's'iyaa matan c'oommiyaawaanne sileedda gediyaan hamettiyaawaa mala.<verse eid="PRO 25:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 25:20" />Kayyotti utteedda asaw yetsaa yes's'iyaawe meeguwaa gallassi mayuwaa k'aariyaawaanne madutsaa bolla c'aalabaa tigiyaawaa mala.<verse eid="PRO 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 25:21" />Ne morkkii koshattooppe, miza; saamettooppe, ushsha.<note caller="-" style="x"><char style="xo" closed="false">25:21-22 </char><char style="xt" closed="false"><ref loc="ROM 12:20">Rom. 12:20</ref></char></note> <verse eid="PRO 25:21" /><verse number="22" style="v" sid="PRO 25:22" />Ayaw gooppe, neeni hewaa ootsiyaawe Aa huup'iyaan tamaa bonk'k'uwaa kaashiide k'oliyaawaa mala. Med'inaa Godaykka new woytana.<verse eid="PRO 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 25:23" />Dolahaa bagga c'arkkuu iraa ahiyaawaadan, zigirssay hank'k'uwaa ayee.<verse eid="PRO 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 25:24" />Walak'ettiyaa machchattinna itti golliyaan de'anaappe golliyaa kashaan de'iyaawe keeka.<verse eid="PRO 25:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 25:25" />Daabureedda uray irs's'a haatsaa ushiide aliyaawaadan, haakko biittaappe yiyaa lo"o oduu nashechchee.<verse eid="PRO 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 25:26" />Iita asaa sintsaan kunddiyaa s'illo Asay bulluk'k'eteedda pulttuwaanne bayeedda ollaa haatsaa mala.<verse eid="PRO 25:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 25:27" />Daro eessaa miyaawe lo"a gidenna; hewaadankka, bare bonchchuwaa koyiyaawe bonchchissenna.<verse eid="PRO 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 25:28" />Bare huup'iyaa naagenna Asay dirssay me"eedda katamaa mala.<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 26:1" />Boniyaan shachchay, katsaa c'akkiyaa wodiyaankka iray koshshennawaadan, boozaw bonchchuu koshshenna.<verse eid="PRO 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 26:2" />Kafotuu yaanne haanne paalliide, asaa k'ohennawaadan, gaasuu bayinnan shek'k'iyaa shek'ay asaa gakkenna.<verse eid="PRO 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 26:3" />Paraw lissuwaa, hariyaw paas'oruwaa koshshiyaawaadan, boozaa zokkiyaw wad'aa koshshee.<verse eid="PRO 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 26:4" />Booza uraw Aa boozatetsaadan zaaroppa; zaarooppe neenikka Aa mala gidana.<verse eid="PRO 26:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 26:5" />Booza uraw Aa boozatetsaadan zaara; hewe d'ayooppe, I barena eranchchaadan paydana.<verse eid="PRO 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 26:6" />Booza asaa bolla kiitaa kiittiyaawe bare gediyaa k'ans's'iyaawaanne wod'iyaawaa ushiyaawaa mala.<verse eid="PRO 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 26:7" />Booza uraa leemisuu wobba uraa gediyaa mala maaddenna.<verse eid="PRO 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 26:8" />Booza uraa bonchchiyaa Asay shuchchaa yambbarshshaa bolla k'achchi wotsiide yuushshiyaa asaa mala.<verse eid="PRO 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 26:9" />Booza uraa leemisuu matsotteedda Asay bare kushiyaa c'addeedda aguntsaa kessanaw baas'etiyaawaa mala.<verse eid="PRO 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 26:10" />Booza asaa woy barew ogiyaanna aad'd'iyaa asaa oosoo k'as'ariyaa Asay demmeedda asaa ubbaa c'addanaadan wonddaafiyaa dukkiyaa asaa mala.<verse eid="PRO 26:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 26:11" />Kanay bare c'ooshshaa guyye simmiide miyaawaadan, boozay bare boozatetsaa oosuwaa zaari zaari ootsee.<verse eid="PRO 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 26:12" />Barekka barena, «Taani aad'd'eeda eranchchaa» giyaa asaa be'aaddi? Aappe booza uraw sintsappe lo"o hidootay de'ee.<verse eid="PRO 26:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 26:13" />Azallay, «Ogiyaan gaammuu de'ee; yashshiyaa gaammuu aakko ogiyaan yuuyyee» yaagee.<verse eid="PRO 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 26:14" />Penggii bare maas'afiyaan yaanne haanne k'aas's'iyaawaadan, azallaykka bare hiis'an yaanne haanne aad'd'i wod'd'ee.<verse eid="PRO 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 26:15" />Itti itti asatuu daro azalla; unttunttu haray attina, wos'iyaan tusheedda sooluwaakka pude baaranaw daaburiino.<verse eid="PRO 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 26:16" />Azalla Asay markkaanna odiyaa laappun eranchchatuwaappekka barena aad'd'eeda eranchcha giide k'oppee.<verse eid="PRO 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 26:17" />Barena gatsiyaawe bayinna saan palamaw aad'd'iyaa Asay ogiyaanna biyaa kanaa haytsaa oyk'k'iyaa asaa mala.<verse eid="PRO 26:17" /></para>
  <para style="p">
    <verse number="18-19" style="v" sid="PRO 26:18-19" />Bare shooruwaa, «Taani kaassaw ootsaad» yaagiide c'immiyaa asay, gooyiide tamaa s'iifaa oliyaa, woy wod'iyaa c'ubiyaa dentsiyaa asaa mala.<verse eid="PRO 26:18-19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 26:20" />Mitsay wurooppe, tamay to'ee; zigiriyaawe d'ayooppe, walassay attee.<verse eid="PRO 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 26:21" />S'iis'untsay bonk'k'uwaa darissiyaawaadaaninne mitsay tamaa darissiyaawaadan, palumanchcha Asay walassaa darissee.<verse eid="PRO 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 26:22" />Zigirssaa k'aalay mal"o k'umaa mala; nashechchiide duge ganjjiyaa gakkee.<verse eid="PRO 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 26:23" />Wozanaan iitabay de'ishiina, bare ins's'arssan c'imuwaa k'aalaa haasayiyaa Asay biran sheeshsheedda urk'k'aa miishshaa mala.<verse eid="PRO 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 26:24" />Lo"o malatiyaa iita Asay bare wozanaan de'iyaa iitatetsaa bare nashsho haasayan gentsee. <verse eid="PRO 26:24" /><verse number="25" style="v" sid="PRO 26:25" />Aa wozanaan laappun tunatetsay kumi utteedda diraw, I lo"o k'aalaa haasayooppekka Aa ammanoppa. <verse eid="PRO 26:25" /><verse number="26" style="v" sid="PRO 26:26" />Bare morkketetsaa I gentsooppekka, I ootsiyaa iitatetsay shiik'uwaan k'onc'c'ana.<verse eid="PRO 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 26:27" />Haratoo ollaa bookkiyaa uray he ollaan barew kunddana; haratuu bolla shuchchaa gonddorssiyaa uraa bolla he shuchchay simmiide gonddorettana.<verse eid="PRO 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 26:28" />Worddotiyaa ins's'arssay bare k'oheedda asatuwaa is's'ee; c'imiyaa haasayay bayetsaa aheeppe attin, harabaa ahenna.<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 27:1" />Wontti hananabaan c'eek'ettoppa; wontti ahanabaa neeni erakka.<note caller="-" style="x"><char style="xo" closed="false">27:1 </char><char style="xt" closed="false"><ref loc="JAS 4:13-16">Yak'. 4:13-16</ref></char></note><verse eid="PRO 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 27:2" />Neena hara Asay galatooppe attina, neeni neena neerekka galatoppa; Asay ne diraw markkattoppe attina, neeni ne keekkatetsaa odoppa.<verse eid="PRO 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 27:3" />Shuchchay wolk'k'aama tookuwaa; shafetuwaa tookkiyaawekka dees'ee; shin booza uray dentsiyaa walassay unttunttu laa"uwaappekka dees'ee.<verse eid="PRO 27:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 27:4" />Hank'k'oo k'areti baawa; yiluukka bayzziyaa di'uwaa mala; shin k'anaatiyaan ubbaa gatsoppo.<verse eid="PRO 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 27:5" />Geemmeedda siik'uwaappe baliyaa wode k'onc'c'iyaan seeriyaawe keeka.<verse eid="PRO 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 27:6" />Morkkii neena daro gede yeriyaawaappe siik'uu neena dechchiyaawe keeka.<verse eid="PRO 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 27:7" />Kalleedda uraa eessaa ililuu iitee; shin koshateedda uraa c'ammiyaabaykka mal"ee.<verse eid="PRO 27:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 27:8" />Bare golliyaa aggiide yuuyyiyaa asay, bare golliyaappe haakkaade paalliyaa kafatti mala.<verse eid="PRO 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 27:9" />Shittuunne sawiyaa is'aanay asaa nashechchiyaawaadan, siik'uwaa laggiyaa zoriikka nashechchee.<verse eid="PRO 27:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 27:10" />Ne siik'o laggiyaanne ne aawuwaa siik'o laggiyaa aggoppa; neena meteedda wode ne ishaa golle booppa. Haakuwaan de'iyaa ishaappe matan de'iyaa shooruu keeka.<verse eid="PRO 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 27:11" />Ta na'aw, neeni aad'd'eeda eranchcha gida. Yaatintto taani nashettananne taana boriyaawanttu ooshaakka zaarana.<verse eid="PRO 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 27:12" />C'inc'c'a Asay metuu yiyaa wode be'iide k'osettee; shin akeekay pac'c'eedda Asay sitti gi biide, metuwaan gelee; yaatiide guyyeppe ayee ana yaagee.<verse eid="PRO 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 27:13" />Erenna asaw waasiyaa geliyaa uraa mayuwaa k'aari akkite; imatsaa asaw, waasiyaa geleedda uraa mayuwaa oyk'k'ite.<verse eid="PRO 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 27:14" />Wontta guuran bare k'aalaa d'ok'k'u ootsiide, bare shooruwaa sarotiyaawe Aa shek'k'iyaawaa mala.<verse eid="PRO 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 27:15" />Walak'ettaade duus's'enna machchatanne iray bukkiyaa wode s'okiide aggena gollii itti mala. <verse eid="PRO 27:15" /><verse number="16" style="v" sid="PRO 27:16" />C'arkkuwaa te"anaw woy zayitiyaa c'uuc'c'uumiide oyk'k'anaw danddayettennawaadan, izo c'o"u ootsanaw danddayettenna.<verse eid="PRO 27:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 27:17" />Biratay birataa poshiyaawaadan, Asay ittuu ittuwaappe tamaaree.<verse eid="PRO 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 27:18" />Balasiyaa giyaa mitsatto ishalissiide naageedda uray I ayifiyaa maana; barena ayisseeddaawaa kabboyiyaa k'oomay bonchchettana.<verse eid="PRO 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 27:19" />Haatsay masttootiyaadan som"uwaa bessiyaawaadan, asaa wozanay izaaw eeshshaa bessee.<verse eid="PRO 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 27:20" />Hayk'uunne bashshay kalli erikkino; hewaadankka, asaa ayfii kallenna.<verse eid="PRO 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 27:21" />Biraynne work'k'ay taman paac'ettiide geeyiyaawaadan, asaykka bare akkiyaa galatan paac'ettee.<verse eid="PRO 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 27:22" />Booza asaa katsanna udulan yeggaade, udula mitsan c'addintto, aappe boozatetsay kichchenna.<verse eid="PRO 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 27:23" />Ne dorssatuu de'iyaa hanotaa loytsaade era; ne mehiyaa wudiyaakka wozanaappe heemma. <verse eid="PRO 27:23" /><verse number="24" style="v" sid="PRO 27:24" />Ayaw gooppe, duretetsay med'inaw de'enna; kallachchaykka yeletaappe yeletaw aad'd'ennan agganaw danddayee. <verse eid="PRO 27:24" /><verse number="25" style="v" sid="PRO 27:25" />Mela maatay buuc'etteeddawaappe, aac'a maatay keseeddawaappenne deriyaa bollan de'iyaa maatay shiik'eeddawaappe guyyiyaan, <verse eid="PRO 27:25" /><verse number="26" style="v" sid="PRO 27:26" />dorssatuwaa isikiyaappe neeni new mayiyaawaa kessana; amareeda deeshshatuwaa zal"eedda birankka new gadiyaa shammana. <verse eid="PRO 27:26" /><verse number="27" style="v" sid="PRO 27:27" />Attiyaa deeshshatuwaa maatsay new, ne soo asawunne ne mac'c'a k'oomatoo k'uma gidanawaa.<verse eid="PRO 27:27" /></para>
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 28:1" />Iitatuu ooninne yederssennan bak'atiino; shin s'illotuu gaammuwaa mala s'ala.<verse eid="PRO 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 28:2" />Itti kawutetsay makkalanchcha gidooppe, Aa mooddiyaawanttu laametti laametti mooddino. Shin kaaletsiyaawanttu aad'd'eeda eranchchaanne akeekanchcha gidiyaa wode, mino gidiide, daro wodiyaa takkee.<verse eid="PRO 28:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 28:3" />Hiyyeesatuwaa uk'k'unniyaa daannay katsaa d'ayissiyaa wolk'k'aama iraa mala.<verse eid="PRO 28:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 28:4" />Higgiyaa bonchchenna uray bayzzanchchaa sabbee; shin higgiyaa bonchchiyaawe bayzzanchchatuwaa k'ofaa p'alk'k'ee.<verse eid="PRO 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 28:5" />Iita asatoo suure pirddaabay gelenna; shin Med'inaa Godaw goyinniyaawanttoo ubbabaykka gelee.<verse eid="PRO 28:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 28:6" />Geella asaa gidiide, dure gidiyaawaappe suure asaa gidiide, hiyyeesaa gidiyaawe keeka.<verse eid="PRO 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 28:7" />Higgiyaa naagiyaa wodallay akeekanchcha. Shin patsenna shufurotuwaanna zuppetiyaawe bare aawuwaa yeellayee.<verse eid="PRO 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 28:8" />Miishshaa dichchaw immiyaawaaninne yeluwaan durettiyaa Asay he mas'uwaa hiyyeesatoo keekkiyaa asaw shiishshee.<verse eid="PRO 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 28:9" />Higgiyaa sisanaappe giide, bare haytsaa wora zaariyaa uraa woosay S'oossaa sheneyiyaawaa.<verse eid="PRO 28:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 28:10" />Suuretuwaa iita ogiyaa kaaletsiyaa uray bare bookkeedda ollaan barew kunddana; shin geeshsha Asay lo"obaa laattana.<verse eid="PRO 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 28:11" />Dure Asay barena aad'd'eeda eranchcha giide k'oppee; shin akeekay de'iyaa hiyyeesay Aa paac'c'ee.<verse eid="PRO 28:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 28:12" />S'illotuu s'ooneedda wode, Asay ubbay nashettee; shin iitatuu maataa oyk'k'eedda wode, Asay k'osettee.<verse eid="PRO 28:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 28:13" />Bare nagaraa gentsiyaa uray aac'enna; shin paas'iyaawenne nagaraa aggiyaawe maarettanawaa.<verse eid="PRO 28:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 28:14" />Med'inaa Godaw ubbaa gede yayyiyaa Asay anjjetteedawaa; shin bare wozanaa guzuntsiyaa Asay metuwaan gelana.<verse eid="PRO 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 28:15" />Hiyyeesaa asaa mooddiyaa iita daannay gudiyaa gaammuwaanne koshateedda babark'k'iyaa mala.<verse eid="PRO 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 28:16" />Wozani pac'c'eedda daannay bare asaa naak'k'ee; shin asaa naak'k'iyaawaa is's'iyaawe daro laytsaa mooddana.<verse eid="PRO 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 28:17" />Asaa wod'eedda Asay hayk'k'ana gakkanaw bak'atiidde de'ee; Aa ooninne shiishshi akkena.<verse eid="PRO 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 28:18" />Borii bayinnan hamettiyaa uray k'ohettennan attanawaa; shin geella Asay itti kutsan kunddana.<verse eid="PRO 28:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 28:19" />Bare gadiyaa ootsiyaa uray katsaa kallee. Shin shufurotuwaa kaalliyaa uray ubbaa gede hiyyeesiide de'ee.<verse eid="PRO 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 28:20" />Ammanetteeda uray daro anjjettana; shin durettanaw jaamiyaawe murettenan attena.<verse eid="PRO 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 28:21" />Shaakkiide maaddiyaawe lo"enna; shin Asay guutsa ukitsaa diraw giidekka, balabaa ootsiino.<verse eid="PRO 28:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 28:22" />Uuzetiyaa uray durettanaw jaamee; barena hiyyeesatetsay oyk'k'anawaakka erenna.<verse eid="PRO 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 28:23" />Asaa c'oo sabbiyaa uraappe seeriyaa uray guyyeppe galatettee.<verse eid="PRO 28:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 28:24" />Bare aawuwaappenne bare aattippe wuu"iide, «Taani ayinne nagaraa ootsabeykke» yaagiyaa uraynne bayzziyaa uray itti mala.<verse eid="PRO 28:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 28:25" />Uuzetiyaa uray walassaa dentsee; shin Med'inaa Godaan ammanettiyaawe kallee.<verse eid="PRO 28:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 28:26" />Barenan ammanettiyaa Asay booza; shin aad'd'eeda eratetsan hamettiyaawe saro de'ee.<verse eid="PRO 28:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 28:27" />Hiyyeesaw immiyaa uraw pac'c'enna; shin unttuntta be'anaappe giide c'iilimmiyaawe shek'aa akkana.<verse eid="PRO 28:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 28:28" />Iita asatuu suntsettiyaa wode, Asay k'osettee; shin unttunttu d'ayiyaa wode, s'illotuu c'orattiino.<verse eid="PRO 28:28" /></para>
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 29:1" />Daro gede seerina is's'iide, morggii d'uleedda uray hassayennan me"ana; he uraw pas'uukka baawa.<verse eid="PRO 29:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 29:2" />S'illo asatuu suntsettiyaa wode Asay nashettee; shin iitatuu biittaa mooddiyaa wode Asay oolee.<verse eid="PRO 29:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 29:3" />Aad'd'eeda eraa dosiyaa Asay bare aawuwaa nashechchee; shin woshummiyaa mac'c'a asatuwaa heeraan yuuyyiyaa Asay bare miishshaa wurssee.<verse eid="PRO 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 29:4" />Tumuwaa pirddiyaa kaatii bare kawutetsaa woppu ootsee; shin mattaayiyaa maanaw yoratiyaawe bare kawutetsaa bayzzee.<verse eid="PRO 29:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 29:5" />Bare shooruwaa sabbiide haasayiyaa uray, Aa gediyaw gitiyaa yeggee.<verse eid="PRO 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 29:6" />Iita Asay gitii oyk'k'iyaawaadan, bare nagaran oyk'ettee; shin s'illo Asay nashettanawunne yes's'anaw danddayee.<verse eid="PRO 29:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 29:7" />S'illo Asay hiyyeesaa maataa bonchchee; shin iita Asay hewaa mala eraa ubbakka erenna.<verse eid="PRO 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 29:8" />K'iliic'iyaawanttu kataman walassaa dentsiino; shin aad'd'eeda eranchcha asatuu hank'k'uwaa irs's'isiino.<verse eid="PRO 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 29:9" />Aad'd'eeda eranchcha Asay booza asaa pirdda golle afooppe, boozay hank'k'etteenne k'id'ee; aw yaatooppe saruu d'ayee.<verse eid="PRO 29:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 29:10" />Suutsaa gussanaw jaamiyaa asatuu suure asaa is's'iino; k'ay s'illo asaakka wod'anaw koyiino.<verse eid="PRO 29:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 29:11" />Booza Asay bare hank'k'uwaa yeddi bessee; shin aad'd'eeda era Asay bare hank'k'uwaa mittee.<verse eid="PRO 29:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 29:12" />Itti suntsetteedda uray wordduwaa oduwaa akkooppe, Aa oosanchchatuu ubbay iita kesiino.<verse eid="PRO 29:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 29:13" />Hiyyeesaynne asaa naak'k'iyaa Asay ittibaa kos's'iino; unttunttu laa"ookka ayifiyaa Med'inaa Goday s'eelissee.<verse eid="PRO 29:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 29:14" />Itti kaatii hiyyeesaw suure pirddooppe, I bare kawutetsan gam"ana.<verse eid="PRO 29:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 29:15" />K'ayis'eeriinne seeray naanaatoo aad'd'eedda eraa immee; shin yedan dic'c'eedda na'ay bare aato kawushshee.<verse eid="PRO 29:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 29:16" />Iita asatuu dariyaa wode, nagaray daree; shin s'illotuu unttunttu kunddetsaa be'ana.<verse eid="PRO 29:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 29:17" />Ne na'aa seera; yaatooppe, I new saruwaa immana; I neena nashshechchana.<verse eid="PRO 29:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 29:18" />S'oossay kaaletsiyaa kaalesuwaa akkena derii yeda; shin higgiyaa naagiyaa uray anjjetteedawaa.<verse eid="PRO 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 29:19" />K'oomay c'o odo s'alan seeretti erenna; oduu aw gelinttokka I azazettena.<verse eid="PRO 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 29:20" />Elleellee elleellee haasayiyaa uraa be'a erayishsha? Aappe booza uraw sintsanaw daro hidootay de'ee.<verse eid="PRO 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 29:21" />Ne k'oomaw na'atetsaappee doommina, I koyiyaawaa ubbaa aw imma meezeyooppe, itti gallassi new de'iyaawaa ubbaa akkanaw I kajjeelanawe attena.<verse eid="PRO 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 29:22" />Hank'k'etiyaa Asay walassaa dentsetsee; elle yilotiyaa Asay daro nagaraa ootsee.<verse eid="PRO 29:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 29:23" />Otoruu asaa kawushshee; shin hokkiyaa ayyaanay de'iyaa Asay bonchchetee.<verse eid="PRO 29:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 29:24" />Kayisuwaanna shaakkiyaa uray barena is's'iyaa asaa; I dabaaban tumuwaa odooppekka muretee; tumuwaa odana d'ayooppe k'ay, S'oossay Aa murana.<verse eid="PRO 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 29:25" />Asaw yayyiyaawe he uraw p'ire gidee; shin Med'inaa Godaan ammanettiyaa Asay saro de'ee.<verse eid="PRO 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 29:26" />Darotuu suntsatetsay de'iyaa asatuwaa awuddashiino; shin suure pirdday Med'inaa Godaa mataappe beettee.<verse eid="PRO 29:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 29:27" />S'illotuu nagaranchchatuwaa shenetiino; nagaranchchatuukka suure uraa shenetiino.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="s">Aguuri Haasayaa</para>
  <para style="r">(<ref loc="PRO 30:1-33">30:1-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />Hawaappe kaalliide s'aafetteeddawe Yaak'a na'ay Aguuri haasayeedda haasayaa. He bitanii Iteelassinne Ukaalaw hawaa haasayeedda. <verse eid="PRO 30:1" /><verse number="2" style="v" sid="PRO 30:2" />Tumu taani ay asaappekka booza daray; asaw de'iyaa akeekay taw baawa. <verse eid="PRO 30:2" /><verse number="3" style="v" sid="PRO 30:3" />Taani aad'd'eeda eraa tamaarabeykke; Geeshsha S'oossaabaakka ayaanne erikke. <verse eid="PRO 30:3" /><verse number="4" style="v" sid="PRO 30:4" />Saluwaa pude kesiide, duge wod'd'eeddawe oonee? C'arkkuwaa bare kushiyaan oyk'k'eeddawe, haatsaa bare afilaan yiic'eeddawe, sa'aa gas'aa Aa sa'aan sa'aan wotseeddawe oonee? Ane erooppe Aa suntsaa taw oda. Aa na'aa oona gay?<verse eid="PRO 30:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 30:5" />S'oossay odiyaa k'aalay ubbay tuma; barekko bak'atiide biyaa ubbaw I gonddalle. <verse eid="PRO 30:5" /><verse number="6" style="v" sid="PRO 30:6" />Aa k'aalaa bolla ayaanne gujjoppa; gujjooppe I neena seerana; neeni worddanchcha gidiyaawaakka I k'onc'c'issana.<verse eid="PRO 30:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 30:7" />Abeet Med'inaa Godaw, taani neena laa"ubatuwaa oochchay; taani hayk'k'ana gakkanaw, unttuntta taana diggoppa. <verse eid="PRO 30:7" /><verse number="8" style="v" sid="PRO 30:8" />Koyiruwaan, taani asaa c'immennaadaaninne wordduwaa haasayennaadan taana naaga; laa"entsuwaan, taw koshshiyaa keeshshaa k'umaa immappe attina, taana dure woy mank'k'o kessoppa. <verse eid="PRO 30:8" /><verse number="9" style="v" sid="PRO 30:9" />Hewe d'ayooppe, dure gidaade, «Med'inaa Goday oonee?» gaade neena kaddana; woy mank'k'o gidaade, wuu"ana; yaataade ta S'oossaa suntsaa borisana.<verse eid="PRO 30:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 30:10" />Neena shek'k'ena malanne I shek'k'ina new gometenna mala, k'oomaa Aa godaan moottoppa.<verse eid="PRO 30:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 30:11" />Barenttu aawotuwaa shek'k'iyaanne barenttu aayetuwaa anjjenna asatuu de'iino. <verse eid="PRO 30:11" /><verse number="12" style="v" sid="PRO 30:12" />Daro tunaa tuni uttiide, barentta geeshshaadan paydiyaa asatuu de'iino. <verse eid="PRO 30:12" /><verse number="13" style="v" sid="PRO 30:13" />Otoruwaa kumeedda asatuunne asaa kad'iide s'eelliyaa asatuu de'iino. <verse eid="PRO 30:13" /><verse number="14" style="v" sid="PRO 30:14" />Unttunttu achchay mashshaa mala gidina, unttunttu goggoc'c'uukka golooduwaa mala gidina, hiyyeesatuwaanne metootanchchatuwaa naak'k'iide, unttunttuwaa bonk'k'iyaa asatuu de'iino.<verse eid="PRO 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 30:15" />Ullatsatiw laa"u mac'c'a naanatuu de'iino. Unttunttu, «Hamma! Hamma!» yaagiide waassiino. Ubbakka kalli erenna heezzubatuu de'iino; oyddentsuu k'ay ubbaa, «Gidana» gi erenna.<verse eid="PRO 30:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 30:16" />Hewanttukka:</para>
  <para style="q2" vid="PRO 30:16">duufuwaa,</para>
  <para style="q2" vid="PRO 30:16">maynne mac'c'a asaa,</para>
  <para style="q2" vid="PRO 30:16">haatsi kalissi erenna mela biittaanne,</para>
  <para style="q1" vid="PRO 30:16">«Taw gidana!» gi erenna tamaa.<verse eid="PRO 30:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 30:17" />Bare aawuwaa k'iliic'iyaa na'aa ayifiyaa, bare aata c'imina kad'iyaa na'aa ayifiyaa, zanggaaraan de'iyaa k'uurotuu wooc'ana; Aa ashuwaa ankkotuu maana.<verse eid="PRO 30:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 30:18" />Taana heezzubatuu maalalissiino; oyddentsuu ubbaa taw gelenna.<verse eid="PRO 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 30:19" />Hewanttukka:</para>
  <para style="q2" vid="PRO 30:19">arggantsay saluwaana paalliyaa paaluwaa,</para>
  <para style="q2" vid="PRO 30:19">shooshshay shuchchaa bollaanna sololiyaa sololetsaa,</para>
  <para style="q2" vid="PRO 30:19">markkabii abbaa bollan solddiyaa soldduwaanne</para>
  <para style="q2" vid="PRO 30:19">wodallaynne gellayatta siik'uwaa doommiyaa doometsaa.<verse eid="PRO 30:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 30:20" />Woshumiyaa mishirata haniyaa hanuukka hewaa mala. Aa muussaa maw; shin meeddawaappe guyyiyaan, bare doonaa k'uc'c'a diggaade, «Taani ayinne bayzzabeykke» yaagaw.<verse eid="PRO 30:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 30:21" />Heezzu yewotuwaan biittay k'aas's'ee; oyddentsuwaa ubbaa tookkanawukka danddayibeenna.<verse eid="PRO 30:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 30:22" />Hewanttukka:</para>
  <para style="q2" vid="PRO 30:22">ayilii kaateteedda wode,</para>
  <para style="q2" vid="PRO 30:22">boozay katsaa kalleedda wode,<verse eid="PRO 30:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 30:23" />asay is's'eedda mishirata asinaa geleedda wodenne,</para>
  <para style="q2" vid="PRO 30:23">mac'c'a k'oomata bare godatto laatteedda wode med'ettiyaa hanotaa.<verse eid="PRO 30:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 30:24" />Sa'aa bolla oyddu guutsa med'etatuu de'iino; shin unttunttu loytsi aad'd'eeda eranchcha.<verse eid="PRO 30:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 30:25" />Hewanttukka:</para>
  <para style="q2" vid="PRO 30:25">C'unc'c'alletuwaa, c'unc'c'alletuu wolk'k'ay bayinna med'etaa;</para>
  <para style="q2" vid="PRO 30:25">shin barenttoo miyaawaa boniyaan shiishshiide, minjjiino.<verse eid="PRO 30:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 30:26" />Guppalletuwaa, guppalletuu guutsa wolk'k'ay de'iyaawantta;</para>
  <para style="q2" vid="PRO 30:26">shin barenttu golliyaa shuchchaa kooppuwan kees's'iino.<verse eid="PRO 30:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 30:27" />Booletuwaa, booletoo kaatii baawa;</para>
  <para style="q2" vid="PRO 30:27">shin unttunttu ubbaykka maaran zattiino.<verse eid="PRO 30:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 30:28" />Zaretuwaa, zaratuu kushiyan oyk'k'inakka oyk'ettiino;</para>
  <para style="q2" vid="PRO 30:28">shin unttunttu haray attina, kaatiyaa gollenkka de'iino.<verse eid="PRO 30:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 30:29" />Barenttu maataa bessiidde hamettiyaa heezzu med'etatuu de'iino; oyddentsuukka lo"o hemetaa hamettee.<verse eid="PRO 30:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 30:30" />Hewanttukka:</para>
  <para style="q2" vid="PRO 30:30">do'aa ubbaappe minniyaanne yayyiide bak'ati erenna gaammuwaa;<verse eid="PRO 30:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 30:31" />aayetuwaa giddon ayyiidde hamettiyaa awure kuttuwaa,</para>
  <para style="q2" vid="PRO 30:31">deeshsha orggiyaanne,</para>
  <para style="q2" vid="PRO 30:31">bare olanchchatuwaa giddon ek'k'iyaa kaatiyaa.<verse eid="PRO 30:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="PRO 30:32" />Neeni boozaade otoretteeddawaa gidooppenne, iitabaa ootsanaw halchcheeddawaa gidooppe, ane takki gaade k'oppa.<verse eid="PRO 30:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="PRO 30:33" />Maatsaa bukkiyaawe oyssaa kessiyaawaadan, siid'iyaa yimppiyaawekka suutsaa ahiyaawaadan, hewaadan hank'k'uwaa dentsetsiyaawe walassaa ayee.<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="s">Limu'eela Daaya Bare Na'aa Tamaarisseedda Timitittiyaa</para>
  <para style="r">(<ref loc="PRO 31:1-31">31:1-31</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />Hawaappe kaalliide s'aafetteedda haasayay, Kaatiyaa Limu'eela aata Kaatiyaa Limu'eela tamaarisseeddawaa.<verse eid="PRO 31:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 31:2" />«Laa ta na'aw, ta uluwaappe wod'd'eeddawoo, taani shiik'ettaade yeleeddawoo, <verse eid="PRO 31:2" /><verse number="3" style="v" sid="PRO 31:3" />mac'c'a asan ne wolk'k'aa wurssoppa; he kaatetuwaa bayzziyaa mac'c'a asatuwaan ne akataa d'ayissoppa.<verse eid="PRO 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 31:4" />«Limu'eelaa, hawe kaatetoo bessena; woyniyaa eessaa ushiyaawe kaatetoo bessena; matsoyiyaa ushshaa ushiyaawe asaa bolla suntsetteeddawanttoo bessena. <verse eid="PRO 31:4" /><verse number="5" style="v" sid="PRO 31:5" />Unttunttu ushiyaa wode higgiyaa baliino; naak'etteedda asaa maataa sheneko giino. <verse eid="PRO 31:5" /><verse number="6" style="v" sid="PRO 31:6" />Matsoyiyaa ushshaa hayk'k'ana haniyaa urawunne sa'ay iiteedda uraw immite. <verse eid="PRO 31:6" /><verse number="7" style="v" sid="PRO 31:7" />Unttunttu barenttu mank'k'otetsaanne barenttu tugga de'uwaa dogana mala ushino.<verse eid="PRO 31:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 31:8" />«Barenttu metuwaa odanaw danddayennawanttu diraw neeni oda; maaddiyaawe bayinnawanttu maataa diraw neeni dendda. <verse eid="PRO 31:8" /><verse number="9" style="v" sid="PRO 31:9" />Unttunttoo suure pirddaa pirdda; hiyyeesatuwaanne metootanchchatuwaa maataa naaga» yaagaade tamaarissaaddu.<verse eid="PRO 31:9" /></para>
  <para style="s">Wozanaama Machchato</para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 31:10" />Wozanaama machchato ooni demmanaw danddayii? Ink'k'uwaa giyaa al"o shuchchaappekka iza al"aw. <verse eid="PRO 31:10" /><verse number="11" style="v" sid="PRO 31:11" />I asinay izo ubbabankka ammanee; aw de'anaw bessiyaawaappe ayaynne pac'c'enna. <verse eid="PRO 31:11" /><verse number="12" style="v" sid="PRO 31:12" />Aa bare de'uwaa laytsaa ubbaan aw lo"obaappe attina, iitabaa ootsukku.<verse eid="PRO 31:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 31:13" />Suufiyaanne layinuwaa Aa koyaadde, nashetaade bare kushiyan ootsaw. <verse eid="PRO 31:13" /><verse number="14" style="v" sid="PRO 31:14" />Aa zal"anchchatuwaa markkabatuwaa mala; bare k'umaa haakko biittaappe ayaw. <verse eid="PRO 31:14" /><verse number="15" style="v" sid="PRO 31:15" />Aa bare soo asaw k'umaa katsanawunne bare mac'c'a k'oomatoo oosuwaa gishanaw, sa'ay biro k'amma de'ishiina denddaw. <verse eid="PRO 31:15" /><verse number="16" style="v" sid="PRO 31:16" />Gadiyaa Aa koyaadde shammaw; bare kushiyan ootsaade demmeedda shaluwaan woyniyaa turaa tokkaw.<verse eid="PRO 31:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 31:17" />Aa gooba oosanchcha gidiyaawaa s'alala gidennaan, minonne c'inc'c'a asaa. <verse eid="PRO 31:17" /><verse number="18" style="v" sid="PRO 31:18" />Aa bare wod'iyaa demmanaw minnaade zal"aw; Aa ootsaadde k'amissiyaa diraw, bare s'omppiyaa elle toyissukku. <verse eid="PRO 31:18" /><verse number="19" style="v" sid="PRO 31:19" />Aa bare sinddiriitan suk'k'aade, bare afilaa daddaw.<verse eid="PRO 31:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 31:20" />Aa hiyyeesatoonne metootanchchatoo barewaappe c'oo immaw.<verse eid="PRO 31:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 31:21" />I soo Asay ubbay ho"iyaa mayuwaa mayyeedda diraw, shachchay bukkintto, Aa hirggukku. <verse eid="PRO 31:21" /><verse number="22" style="v" sid="PRO 31:22" />Arssaa bollan hiis's'iyaa mayuwaa sikkaw; liinuwaappe dadetteedda ochchaa teeraa malatiyaa mayuwaakka barew mayyaw.<verse eid="PRO 31:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 31:23" />Gadiyaa c'imatuu shiik'iyaa dubbushan I asinay bonchchetteedda asaa.<verse eid="PRO 31:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 31:24" />Liinuwaappe mayuwaanne sak'k'iyaa ootsa ootsaade, zal"anchchatoo zal"aw.<verse eid="PRO 31:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 31:25" />Iza minonne bonchcho asaa; yiyaa laytsatoo iza ubbakka hirggukku. <verse eid="PRO 31:25" /><verse number="26" style="v" sid="PRO 31:26" />Aad'd'eeda eran Aa haasayaw; ammantsiyaa zorii I ins's'arssaappe kesee. <verse eid="PRO 31:26" /><verse number="27" style="v" sid="PRO 31:27" />Aa bare soo asaa de'uwaa injjeyanaw ubbaa gede oosuwaa ootsaadde de'aw; azalla hanuu I bollan beetti erenna.<verse eid="PRO 31:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 31:28" />Izi naanatuu denddi ek'k'iide, izo nashshiino; Izi asinaykka izo galatiidde, <verse eid="PRO 31:28" /><verse number="29" style="v" sid="PRO 31:29" />«Lo"obaa ootseedda daro mac'c'a asatuu de'iino; shin neeni unttunttu ubbaappe aad'd'aasa» yaagee.<verse eid="PRO 31:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 31:30" />Malaa lo"otetsay allaalle kessenna; puulikka d'ayana; shin Med'inaa Godaw yayyiyaa mishirata, iza galatettanaw bessaw. <verse eid="PRO 31:30" /><verse number="31" style="v" sid="PRO 31:31" />Aa ootseeddabaw ubbaw iw izi kushiyaa zaarite; iza ootseedda oosuu ubbay dabaaban izo galatisso.<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>