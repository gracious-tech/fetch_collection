<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="SNG" style="id">- Dawuro Full Bible Latin Version</book>
  <para style="h">Siik'uwaa Sabaa</para>
  <para style="toc1">Siik'uwaa Sabbiyaa Mas'aafaa</para>
  <para style="toc2">Siik'uwaa Sabaa</para>
  <para style="toc3">Sik'.</para>
  <para style="mt1">Siik'uwaa Sabbiyaa Mas'aafaa</para>
  <para style="imt">Geluwaa</para>
  <para style="ip">«Siik'uwaa Sabbiyaa Mas'aafay» siik'uwaa timirttiyaa k'oriide shiishsheeddawaa. Ha gins's'atuwaappe dariyaa baggatuu mazimuriyaa malan s'aafetteeddino; unttunttu attumawe mac'c'aaniw, mac'c'awunna k'ay attumawoo s'aafeeddawantta. Ha mas'aafay itti itti biletsatuwaan «Siik'uwaa Sabaa» woy «Mazamuriyaa Ubbaappe Aad'd'iyaa Mazimuriyaa» geetettiide erettee. Hara biletsatuwaan k'ay «Solomona Mazimuriyaa» geetettiide erettee. Ayaw gooppe, Ibrayiss's'e k'aalan s'aafetteedda mas'aafay Solomon s'aafeedda giide odiyaa diraassa.</para>
  <para style="ip">Ha mazamurii Kiristtoosappenne woosa golliyaappenne gidduwaan de'iyaa gakkettussaa bessiyaa leemisatwaa oyk'k'eeddawaa. Shin Ayihudatuu, «S'oossaappenne Israa'eeliyaa asaappe gidduwaan de'iyaa gakkettussaa bessiyaa leemisatwaa oyk'k'iyaa mas'aafaa» giino.</para>
  <para style="iot">Shemppatuwaa Ubbatoo Imetteedda K'antsa K'ofatuwaa</para>
  <para style="io1">Siik'uu Woynniyaa Eesaappe aad'd'ee <char style="ior"><ref loc="SNG 1:1-2:7">1:1—2:7</ref></char></para>
  <para style="io1">Siik'uu Ubbaa Yewuwaa Loytsee <char style="ior"><ref loc="SNG 2:8-3:5">2:8—3:5</ref></char></para>
  <para style="io1">Soyzzuwaabaa <char style="ior"><ref loc="SNG 3:6-4:5">3:6—4:5</ref></char></para>
  <para style="io1">Soyzzuwaa Ittippetetsaa <char style="ior"><ref loc="SNG 4:6-5:16">4:6—5:16</ref></char></para>
  <para style="io1">Siik'uu Ubbaappe Dooretee <char style="ior"><ref loc="SNG 6:1-7:6">6:1—7:6</ref></char></para>
  <para style="io1">Taaninne Neeninne S'alalay <char style="ior"><ref loc="SNG 7:7-8:4">7:7—8:4</ref></char></para>
  <para style="io1">Siik'uwaa Sabaa <char style="ior"><ref loc="SNG 8:5-14">8:5-14</ref></char></para>
  <chapter number="1" style="c" sid="SNG 1"/>
  <para style="s">Siik'uu Woynniyaa Eesaappe Aad'd'ee</para>
  <para style="r">(<ref loc="SNG 1:1-2:7">1:1—2:7</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 1:1"/>Mazamuriyaa ubbaappe aad'd'iyaa Solomona mazamurii hawaa.<verse eid="SNG 1:1"/></para>
  <para style="sp">Wodoratta:</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2"/>«Ne siik'uu woyniyaa eessaappe aad'd'i nashechchiyaa diraw,</para>
  <para style="q2" vid="SNG 1:2">ne mettershshan zaara zaaraadekka taana yera.<verse eid="SNG 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3"/>Ne okettiyaa shittuu wooti sawii!</para>
  <para style="q2" vid="SNG 1:3">Ne suntsay s'eesettiyaa wodekka ayaa nashechchii!</para>
  <para style="q2" vid="SNG 1:3">Geelayotuu neena siik'iyaawe hewaassa.<verse eid="SNG 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4"/>Taana neenana akkaade ba. Haaya, ane laa"uu ittippe wos's'oytte!</para>
  <para style="q2" vid="SNG 1:4">Ta kaatiyaw, taana ne siiris'aa gelissa» yaagaaddu.</para>
  <para style="sp" vid="SNG 1:4">Yerusaalame mac'c'a asatuu:</para>
  <para style="q1" vid="SNG 1:4">Aban nuuni ay keeshshaa nashetteeddo!</para>
  <para style="q2" vid="SNG 1:4">Nuuni Aa siik'uwaa woyniyaa eessaappekka aatsiide nashetto.</para>
  <para style="q2" vid="SNG 1:4">Tumukka mac'c'a Asay ubbay neena siik'anaw bessee yaageeddino.<verse eid="SNG 1:4"/></para>
  <para style="s">Wodoratta:</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5"/>Hinttenoo, Yerusaalame mac'c'a asatoo, sisite,</para>
  <para style="q2" vid="SNG 1:5">taani karetsa; gidooppenne, malanchcha.</para>
  <para style="q2" vid="SNG 1:5">Ta karetsatetsay K'eedaare dunkkaaniyaa mala;</para>
  <para style="q2" vid="SNG 1:5">shin ta malay Solomona kaatiyaa golliyaa gaariddotuwaa mala.<verse eid="SNG 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6"/>Ta malaa kares'isseeddawe s'uuggiyaa aawaa;</para>
  <para style="q2" vid="SNG 1:6">taani karetsa gideedda diraw, taana kad'oppa.</para>
  <para style="q2" vid="SNG 1:6">Ta ishatuu, ta aatti naanatuu taananna walak'ettiide,</para>
  <para style="q2" vid="SNG 1:6">taana woyniyaa turaa naaganchcha ootseeddino;</para>
  <para style="q2" vid="SNG 1:6">yaatina, taani taana naagabeykke.<verse eid="SNG 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7"/>Ta siik'ow, ane taw oda;</para>
  <para style="q2" vid="SNG 1:7">ne dorssaa wudiyaa neeni heemmiyaawe hak'anee?</para>
  <para style="q2" vid="SNG 1:7">Gallassi awaappe ne unttuntta shemppisiyaawe hak'anee?</para>
  <para style="q2" vid="SNG 1:7">Neena demmanaw ne laggetuwaa wudiyaa kaalaade,</para>
  <para style="q2" vid="SNG 1:7">ayaw yuushshanchcha mac'c'a asaa gidoo? yaagaaddu.<verse eid="SNG 1:7"/></para>
  <para style="sp">Yerusaalame mac'c'a asatuu:</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8"/>Hanne, mac'c'a asaa ubbaappe aad'd'a lo"iyaa malanchchatee!</para>
  <para style="q2" vid="SNG 1:8">Sa'aa erana d'ayooppe, dorssay beedda sa'aa kaalaade ba;</para>
  <para style="q2" vid="SNG 1:8">ne deeshsha maratuwaakka hentsanchchatuwaa dunkkaaniyaa matan heemma.<verse eid="SNG 1:8"/></para>
  <para style="sp">Woddallay</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9"/>Ta siik'k'atee!</para>
  <para style="q2" vid="SNG 1:9">Gibs'e kaatiyaa paraa gaariyaa goochchiyaa paratuwaa giddon de'iyaa maggaayatiidan lo"aasa.<verse eid="SNG 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10"/>Abeet, ne haytsaan goolakkattiyaa alleek'k'uwaana shiik'iide,</para>
  <para style="q2" vid="SNG 1:10">ne gac'uu ayaa lo"ii! Ne ziizziikka ink'k'uwaan alleek'k'etteedawaa.<verse eid="SNG 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11"/>Nuuni new biran alleek'k'etteedda,</para>
  <para style="q2" vid="SNG 1:11">work'k'aa alleek'k'uwaa oosissana yaageeddino.<verse eid="SNG 1:11"/></para>
  <para style="sp">Wodoratta:</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12"/>Kaatii maaddan utti de'ishshin,</para>
  <para style="q2" vid="SNG 1:12">ta shittuwaa sawuu golliyaa giddo ubbaan toshukku geedda.<verse eid="SNG 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13"/>Ta siik'uu ta d'antsatuwaappe gidduwaan shemppiyaa wode,</para>
  <para style="q2" vid="SNG 1:13">Aa peenuu k'arc'c'iitiyaana de'iyaa kawaraadan sawee.<verse eid="SNG 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14"/>Ta siik'uu Enggaade geetettiyaa woyniyaa sa'aan doleedda,</para>
  <para style="q2" vid="SNG 1:14">bazzuwaa c'iishshaa mala yaagaaddu.<verse eid="SNG 1:14"/></para>
  <para style="sp">Wodallay:</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15"/>Ta siik'k'atee, neeni waata lo"ay! Neeni waata lo"ay!</para>
  <para style="q2" vid="SNG 1:15">Ne ayifetuu harap'p'iyaa ayfiyaadan lo"iino yaageedda.<verse eid="SNG 1:15"/></para>
  <para style="sp">Wodoratta:</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16"/>Ta siik'ow, neeni ayaa lo"ay! Ayaa nashechchay;</para>
  <para style="q2" vid="SNG 1:16">nu arssayikka aac'eedda maataadan nashechchiyaawaa.<verse eid="SNG 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17"/>Nu golliyaa zaaruu zigaa; kaaraykka s'iidan dadetteeddawaa yaagaaddu.<verse eid="SNG 1:17"/></para>
  <chapter eid="SNG 1"/>
  <chapter number="2" style="c" sid="SNG 2"/>
  <para style="sp">Wodoratta:</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1"/>Taani, «Saaroona giyaa sa'aan doliyaa c'iishshaanne,</para>
  <para style="q2" vid="SNG 2:1">wombban doliyaa lo"o c'iishshaa mala» yaagaaddu.<verse eid="SNG 2:1"/></para>
  <para style="sp">Wodallay:</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2"/>Ee ta siik'k'atta mac'c'a asaa giddon s'eelliyaa wode,</para>
  <para style="q2" vid="SNG 2:2">aguntsaa giddon beettiyaa lo"o c'iishshaa malataw yaageedda.<verse eid="SNG 2:2"/></para>
  <para style="sp">Wodoratta:</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3"/>Ta siik'uu hara wodallatuwaa giddon s'eelliyaa wode,</para>
  <para style="q2" vid="SNG 2:3">woran de'iyaa appiliyaa giyaa mitsaa malatee;</para>
  <para style="q2" vid="SNG 2:3">taana loytsi nashechchina, Aa kuwaa giddon uttaad;</para>
  <para style="q2" vid="SNG 2:3">Aa ayifii miina, taana loytsi mal"ee.<verse eid="SNG 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4"/>I taana k'umaa miyaa aakko wuyggiyaa gelisseedda;</para>
  <para style="q2" vid="SNG 2:4">bare siik'uwaa banddiraadan ta bolla d'ok'k'u d'ok'k'u ootseedda.<verse eid="SNG 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5"/>Taani Aa siik'uwaan okettaade harggeedda diraw,</para>
  <para style="q2" vid="SNG 2:5">zabiibiyaa ayifiyaa taana miziide ministe;</para>
  <para style="q2" vid="SNG 2:5">appiliyaa taana miziide, ta wolk'k'aa kuntsite.<verse eid="SNG 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6"/>Bare haddirssa kushiyaa taana borkkotisseedda;</para>
  <para style="q2" vid="SNG 2:6">bare ushechcha kushiyan taana k'oommeedda.<verse eid="SNG 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7"/>Hinttenoo Yerusaalame yalaga mac'c'a asaw,</para>
  <para style="q2" vid="SNG 2:7">siik'uu barew dosiide denddana gakkanaw,</para>
  <para style="q2" vid="SNG 2:7">Aa hintte beegotsena mala,</para>
  <para style="q2" vid="SNG 2:7">taani hinttena gen"etuwaaninne bazzuwaa dogetuwaan c'allay.<verse eid="SNG 2:7"/></para>
  <para style="s">Siik'uu Ubbaa Yewuwaa Loytsee</para>
  <para style="r">(<ref loc="SNG 2:8-3:5">2:8—3:5</ref>)</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8"/>Sisite, hewe ta siik'uwaa kooshshaa! Be'ite deriyaana piriidde,</para>
  <para style="q2" vid="SNG 2:8">zoozetuwaa bollaanna s'onggettiidde gakkeedda!<verse eid="SNG 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9"/>Ta siik'uu wushaa mala; woy gen"iyaa maraa malatee.</para>
  <para style="q2" vid="SNG 2:9">Be'ite, I nu golliyaa dirssaa matan ek'k'eedda;</para>
  <para style="q2" vid="SNG 2:9">maskkootiyaanna golle s'eellee;</para>
  <para style="q2" vid="SNG 2:9">gaaridduwaa garssaanakka luus's'ay s'eellee.<verse eid="SNG 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10"/>Ta siik'uu taana hawaadan yaagee; Ta siik'k'atee, dendda!</para>
  <para style="q2" vid="SNG 2:10">Ta malanchchatee, haaya! Ittippe ane boytte.<verse eid="SNG 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11"/>Be'a, balgguu aad'd'eeda; iraykka ek'k'eedda.<verse eid="SNG 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12"/>Biittan c'iishshay c'iisheedda; yetsaa yes's'iyaa aginayikka gakkeedda;</para>
  <para style="q2" vid="SNG 2:12">harap'p'iyaa yetsay nu biittan sisettee.<verse eid="SNG 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13"/>Balasii ayifiyaa doommeedda; woynnii c'iisheedda;</para>
  <para style="q2" vid="SNG 2:13">Aa c'iishshaa sawuu biittan toshukku gee.</para>
  <para style="q2" vid="SNG 2:13">Hewaa diraw, ta siik'k'atee, dendda; ta malanchchatee, haaya;</para>
  <para style="q2" vid="SNG 2:13">ane ittippe boytte yaagee yaagaaddu.<verse eid="SNG 2:13"/></para>
  <para style="sp">Wodallay:</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14"/>Neeni aafuwaa doonaa zaallaa za'an k'osetteedda harap'p'atti mala;</para>
  <para style="q2" vid="SNG 2:14">ane itti gede taana ne som"uwaa bessa; ne kooshshaakka sisa.</para>
  <para style="q2" vid="SNG 2:14">Ayaw gooppe, ne kooshshay taana k'aretsee;</para>
  <para style="q2" vid="SNG 2:14">ne som"uukka daro lo"ee yaageedda.<verse eid="SNG 2:14"/></para>
  <para style="sp">Yerusaalame Wodorotuu:</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15"/>Nu woynnii c'iisheedda; hewaa diraw,</para>
  <para style="q2" vid="SNG 2:15">nu woyniyaa gidduwaa bayzziyaa worakanatuwaa,</para>
  <para style="q2" vid="SNG 2:15">he k'eeri worakanatuwaa p'iriyaa wotsiide oyk'k'ite yaageeddino.<verse eid="SNG 2:15"/></para>
  <para style="sp">Wodoratta:</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16"/>Ta siik'uu tawaa; taanikka aano;</para>
  <para style="q2" vid="SNG 2:16">c'iishshaa giddon I bare wudiyaa heemmee.<verse eid="SNG 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17"/>K'amma d'umay k'aarettanaw, wontta c'arkkuu c'arkkanaw,</para>
  <para style="q2" vid="SNG 2:17">ta siik'ow, gen"iyaadan woy yalaga doggiyaadan,</para>
  <para style="q2" vid="SNG 2:17">aafotiya deriyaana wos's'aade haa simma yaagaaddu.<verse eid="SNG 2:17"/></para>
  <chapter eid="SNG 2"/>
  <chapter number="3" style="c" sid="SNG 3"/>
  <para style="sp">Wodoratta:</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1"/>K'amma kumentsaa ta hiis'an gisaade,</para>
  <para style="q2" vid="SNG 3:1">ta siik'uwaa demmanaw amottaad; minisaade koyaad;</para>
  <para style="q2" vid="SNG 3:1">shin demmanaw danddayabeykke.<verse eid="SNG 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2"/>Katamaa giddon de'iyaa aakonne s'untsa ogetuwaa ubbaan yuuyyaad;</para>
  <para style="q2" vid="SNG 3:2">ta siik'uwaa demmanaw koyaad; minisaade koyaad;</para>
  <para style="q2" vid="SNG 3:2">shin demmanaw danddayabeykke.<verse eid="SNG 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3"/>Katamaa yuuyyi naagiyaawanttu taana demmeeddino;</para>
  <para style="q2" vid="SNG 3:3">taanikka, Ta siik'uwaa be'eeditee? yaagaade unttuntta oochchaad.<verse eid="SNG 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4"/>Unttunttuppe yaa aad'anne ta siik'uwaa demma aggaad.</para>
  <para style="q2" vid="SNG 3:4">I taappe kessi akkenaadan, minisaade oyk'k'aad;</para>
  <para style="q2" vid="SNG 3:4">ta daayi golle akka afaad; ta yeletteedda kifiliyaa gelissaad.<verse eid="SNG 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5"/>Hinttenoo Yerusaalame yalaga mac'c'a asaw,</para>
  <para style="q2" vid="SNG 3:5">siik'uu barew dosiide denddana gakkanaw,</para>
  <para style="q2" vid="SNG 3:5">Aa hintte beegotsena mala,</para>
  <para style="q2" vid="SNG 3:5">taani hinttena gen"etuwaaninne bazzuwaa dogetuwaan c'allay yaagaaddu.<verse eid="SNG 3:5"/></para>
  <para style="s">Soyzzuwaabaa</para>
  <para style="r">(<ref loc="SNG 3:6-4:5">3:6—4:5</ref>)</para>
  <para style="sp">Yerusaalame Wodorotuu:</para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6"/>Hawe bazzuwaana yiyaawe, c'uwaa tuussaa malatiyaawe,</para>
  <para style="q2" vid="SNG 3:6">peenuukka zal"anchchaa is'aanaadaaninne kawaraadan,</para>
  <para style="q2" vid="SNG 3:6">sawiyaawe I oonee?<verse eid="SNG 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7"/>Hewaa be'ite, Solomona paraa gaarii yee;</para>
  <para style="q2" vid="SNG 3:7">he paraa gaarii Israa'eeliyaappe dooretteedda wolk'k'aamatuu,</para>
  <para style="q2" vid="SNG 3:7">usuppun tammu tooranchchatuu ajabeedino.<verse eid="SNG 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8"/>Unttunttu ubbaykka mashshaa oyk'k'etsaa meezeteeddawanttanne,</para>
  <para style="q2" vid="SNG 3:8">olankka paac'etteeddawantta.</para>
  <para style="q2" vid="SNG 3:8">K'amman gakkana metuwaa ek'ettanaw,</para>
  <para style="q2" vid="SNG 3:8">unttunttu ittuu ittuu mashshaa gis's'iide giigeeddawantta.<verse eid="SNG 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9"/>Kaatiyaa Solomon paraa gaariyaa giddon,</para>
  <para style="q2" vid="SNG 3:9">barew uttiyaa kawutetsaa araataa giigisseedda.</para>
  <para style="q2" vid="SNG 3:9">I araataa Liibaanoosa asaappe aheedda mitsaappe oosisseedda.<verse eid="SNG 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10"/>Araataa tuussatuu biran sheeshetteeddino;</para>
  <para style="q2" vid="SNG 3:10">gedii work'k'aan alleek'k'etteedda;</para>
  <para style="q2" vid="SNG 3:10">uttiyaasay Yerusaalame wodoratuu ochchaa teeraa malatiyaa k'ac'inan,</para>
  <para style="q2" vid="SNG 3:10">siik'uwaan daddeedda afilaan kameteedda yaageeddino.<verse eid="SNG 3:10"/></para>
  <para style="sp">Wodoratta:</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 3:11"/>Hinttenoo, S'iyoone wodoratoo, Kaatiyaa Solomona be'anaw haayite!</para>
  <para style="q2" vid="SNG 3:11">I loytsi nashetteedda, Aa bullachchaa gallassi Aa aata Aa huup'iyaan,</para>
  <para style="q2" vid="SNG 3:11">wotseedda kallachchaa wotsiide utteedda yaagaaddu.<verse eid="SNG 3:11"/></para>
  <chapter eid="SNG 3"/>
  <chapter number="4" style="c" sid="SNG 4"/>
  <para style="sp">Wodallay:</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1"/>Ta siik'k'atee, neeni ayaa malanchchatii! Neeni woota lo"ay!</para>
  <para style="q2" vid="SNG 4:1">Ne ayifetuu ne som"uwaa kammiyaa sharbbe gidduwaana be'iyaa wode,</para>
  <para style="q2" vid="SNG 4:1">harap'p'iyaadan lo"iino.</para>
  <para style="q2" vid="SNG 4:1">Ne binnaanay Gala'aade Deriyaappe wod'd'iyaa deeshshaa wudiyaa mala.<verse eid="SNG 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2"/>Ne achchay meedettiide, haatsaan meec'etteedda ubbaykka manttiyaa yeliyaa,</para>
  <para style="q2" vid="SNG 4:2">unttunttu giddon maynii bayinna dorssaa wudiyaa mala.<verse eid="SNG 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3"/>Ne mettershshatuu zo'o k'ac'inaa mala;</para>
  <para style="q2" vid="SNG 4:3">ne haasayiyaa wode daro nashechchiino.</para>
  <para style="q2" vid="SNG 4:3">Ne laa"u gac'otuwaa sharbbiyaa gidduwaana s'eelliyaa wode,</para>
  <para style="q2" vid="SNG 4:3">itti roomaaniyaa laa"u kessi p'alk'k'eeddawaa malatiino.<verse eid="SNG 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4"/>Ne k'ood'ii olaa miishshaa kak'k'anaw gimbbeedda,</para>
  <para style="q2" vid="SNG 4:4">Daawita adussa gimbbiyaa malatee;</para>
  <para style="q2" vid="SNG 4:4">he gimbbii sha"u mino olanchchatuwaa gonddallii kak'ettina,</para>
  <para style="q2" vid="SNG 4:4">alleek'k'etti utteedda.<verse eid="SNG 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5"/>Ne d'antsatuu manttiyaa yeletteedda,</para>
  <para style="q2" vid="SNG 4:5">wora c'iishshaa giddon miyaa gen"iyaa maratuwaa malatiino.<verse eid="SNG 4:5"/></para>
  <para style="s">Soyzzuwaa Ittipetetsaa</para>
  <para style="r">(<ref loc="SNG 4:6-5:16">4:6—5:16</ref>)</para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6"/>K'ammay wonttanaw, kuway kichchanaw,</para>
  <para style="q2" vid="SNG 4:6">karbbiyaa deriyaanne is'aanaa zooziyaa baade shemppashshana.<verse eid="SNG 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7"/>Ta siik'k'atee, ne asatetsay ubbaykka malanchcha;</para>
  <para style="q2" vid="SNG 4:7">neenan wotsiyaawe ayaynne baawa.<verse eid="SNG 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8"/>Ta mushurattee, Liibaanoosa Deriyaappe wod'd'a.</para>
  <para style="q2" vid="SNG 4:8">Gaammuunne maahii geessuu Amaana Deriyaappe,</para>
  <para style="q2" vid="SNG 4:8">Saniira Deriyaappenne Hermmoone kiikiyaappe wod'd'a.<verse eid="SNG 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9"/>Ta siik'uwaa michchato gidiyaa ta siik'attee!</para>
  <para style="q2" vid="SNG 4:9">Ne ayifiyaa s'eeluunne ne k'ood'iyaa alleek'k'uu,</para>
  <para style="q2" vid="SNG 4:9">ta wozanaa nashshechchan gooshsheedda.<verse eid="SNG 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10"/>Ta siik'uwaa michchato gidiyaa ta mushurate!</para>
  <para style="q2" vid="SNG 4:10">Ne siik'uu taana ayaa nashechchii!</para>
  <para style="q2" vid="SNG 4:10">Ne siik'uu woyniyaa eessaappe aad'd'i nashechchee;</para>
  <para style="q2" vid="SNG 4:10">ne shittuu ubbabaappekka aad'd'iide sawee.<verse eid="SNG 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11"/>Ta mushurattee, ne mettershshaanna eessaa ililuu s'okee.</para>
  <para style="q2" vid="SNG 4:11">Ne doonaappe eessaynne maatsay pulttee;</para>
  <para style="q2" vid="SNG 4:11">ne mayuu Liibaanoosa s'iidday sawiyaawaadan sawee.<verse eid="SNG 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12"/>Ta siik'uwaa michchato gidiyaa ta mushurati yuushshuu,</para>
  <para style="q2" vid="SNG 4:12">direttiide naagettiyaa ataakilttiyaa sa'aa mala.</para>
  <para style="q2" vid="SNG 4:12">Yuushshuu gimbbetteedda pulttuwaa,</para>
  <para style="q2" vid="SNG 4:12">maatafay attametteedda goggiyaa haatsaa mala.<verse eid="SNG 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13"/>Ne ataakilttetuwaa giddon: roomaanii,</para>
  <para style="q2" vid="SNG 4:13">dooretteedda ataakilttiyaa ayifetuu,</para>
  <para style="q2" vid="SNG 4:13">heenayinne narddoosiyaa giyaawanttu de'iino.<verse eid="SNG 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 4:14"/>Hewaadankka k'ay narddoosii,</para>
  <para style="q2" vid="SNG 4:14">laadii, sawuwaa maataynne k'arafay,</para>
  <para style="q2" vid="SNG 4:14">hewaadankka is'aanaadan sawiyaabatuu de'iino;</para>
  <para style="q2" vid="SNG 4:14">hewaadankka k'ay karbbii,</para>
  <para style="q2" vid="SNG 4:14">godare uutsaa c'iishshaynne dumma dumma k'imaamiyaa ataakilttetuu mokkiino.<verse eid="SNG 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15"/>Neeni ataakilttiyaa sa'aa aliyaa pulttuwaa mala;</para>
  <para style="q2" vid="SNG 4:15">de'uwaa haatsay beettiyaa ollaa mala;</para>
  <para style="q2" vid="SNG 4:15">Liibaanoosa Deriyaappe goggiyaa shaafaa mala yaageedda.<verse eid="SNG 4:15"/></para>
  <para style="sp">Wodoratta:</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16"/>Huup'issa bagga c'arkkoo, dendda!</para>
  <para style="q2" vid="SNG 4:16">Gedissa bagga c'arkkoo, haaya!</para>
  <para style="q2" vid="SNG 4:16">Ta ataakilttiyaa bolla c'arkka! Aa sawuu hewan toshukku go.</para>
  <para style="q2" vid="SNG 4:16">Ta siik'uu bare ataakilttiyaa giddo yo.</para>
  <para style="q2" vid="SNG 4:16">Daro mal"iyaa teeratuwaa mo yaagaaddu.<verse eid="SNG 4:16"/></para>
  <chapter eid="SNG 4"/>
  <chapter number="5" style="c" sid="SNG 5"/>
  <para style="sp">Wodallay:</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1"/>Ta siik'o michchatto gidiyaa ta mishiratte,</para>
  <para style="q2" vid="SNG 5:1">be'a; taani ta ataakilttiyaa giddo gelaad.</para>
  <para style="q2" vid="SNG 5:1">Ta karbbiyaanne ta shittuwaa c'iishshaa k'oray.</para>
  <para style="q2" vid="SNG 5:1">Eessaa ukitsaa yolttayaade may.</para>
  <para style="q2" vid="SNG 5:1">Ta woyniyaa eessaanne ta maatsaa ushay yaageedda.</para>
  <para style="sp" vid="SNG 5:1">Yerusaalame Wodoratuu:</para>
  <para style="q1" vid="SNG 5:1">Hinttenoo, Aa laggetoo, siik'uwaa alana gakkanaw ushite yaageeddino.<verse eid="SNG 5:1"/></para>
  <para style="sp">Wodoratta:</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2"/>Taani k'amma gem"ishaad; shin ta wozanay beegotti utteedda.</para>
  <para style="q2" vid="SNG 5:2">Ta akumuwaan ta siik'uu hawaadan yaagiidde,</para>
  <para style="q2" vid="SNG 5:2">penggiyaa k'os's'iina sisaad; Ta mushurattee, ta siik'k'atee,</para>
  <para style="q2" vid="SNG 5:2">neenan wotsiyaawe bayinna ta harap'p'atte, taw kariyaa dooyaa;</para>
  <para style="q2" vid="SNG 5:2">ta huup'ii ketterssaan ka"eedda.</para>
  <para style="q2" vid="SNG 5:2">Ta binnaanaykka k'amma puusiyaan narkkakkeedda yaagee.<verse eid="SNG 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3"/>Taani, Ta mayuwaa k'aara diggaad; zaara mayyooyye?</para>
  <para style="q2" vid="SNG 5:3">Ta gediyaa meec'etta kichchaad; zaaraadde urk'k'ayooyye? yaagaad.<verse eid="SNG 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4"/>Ta siik'uu ifitsaa s'oo'iyaanna bare kushiyaa golle yeddeedda;</para>
  <para style="q2" vid="SNG 5:4">ta wozanay Aa diraw poddi poddee.<verse eid="SNG 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5"/>Yaatina, ta siik'oo kariyaa dooyanaw denddaad.</para>
  <para style="q2" vid="SNG 5:5">Kariyaa dooyiyaa kulbbuwaa taani oyk'k'iyaa wode,</para>
  <para style="q2" vid="SNG 5:5">ta kushiyaappe karbbii, ta birad'd'iyaappe shittuu s'okee.<verse eid="SNG 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6"/>Ta siik'oo kariyaa dooyaad; shin dooyiyaa wode I baawa bi kichcheedda.</para>
  <para style="q2" vid="SNG 5:6">Aa kooshshaa sisanaw loytsi amottaad.</para>
  <para style="q2" vid="SNG 5:6">Mintsaade Aa koyaad; shin demmanaw danddayabeykke.</para>
  <para style="q2" vid="SNG 5:6">S'eegaad; shin taw koyibeenna.<verse eid="SNG 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7"/>Yuuyyiide katamaa naagiyaawanttu taana demmiide,</para>
  <para style="q2" vid="SNG 5:7">wad'd'eeddinonne madutseeddino;</para>
  <para style="q2" vid="SNG 5:7">katamaa dirssaa naagiyaawanttu ta k'umayuwaa k'aari akkeeddino.<verse eid="SNG 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8"/>Hinttenoo Yerusaalame geelayotoo, ta siik'uwaa demmooppe,</para>
  <para style="q2" vid="SNG 5:8">taani Aa siik'uwaappe denddeeddawaan harggiyaawaa,</para>
  <para style="q2" vid="SNG 5:8">hadaraa, aw odite yaagaaddu.<verse eid="SNG 5:8"/></para>
  <para style="sp">Yerusaalame Wodoratuu:</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9"/>Neenoo, mac'c'a asaa ubbaappe aad'd'eeda malanchchatee!</para>
  <para style="q2" vid="SNG 5:9">Ne siik'uu tumu haratuwaappe waan dummatii?</para>
  <para style="q2" vid="SNG 5:9">Neeni hawaa keeshshaa nuuna c'alliyaawe,</para>
  <para style="q2" vid="SNG 5:9">I haratuwaappe dummatiyaawe ayaanee? yaageeddino.<verse eid="SNG 5:9"/></para>
  <para style="sp">Wodoratta:</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10"/>Ta siik'uu daro lo"iyaawaanne mina;</para>
  <para style="q2" vid="SNG 5:10">tammu sha"u attuma asaa giddon Aa mali baawa.<verse eid="SNG 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11"/>Aa huup'ii work'k'aa luliyaa malatee;</para>
  <para style="q2" vid="SNG 5:11">Aa binnaanaykka lo"anne k'uuruwaa mala karetsa.<verse eid="SNG 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12"/>Aa ayifii shaafaa lank'k'iyaan ek'k'eeddanne,</para>
  <para style="q2" vid="SNG 5:12">maatsan meec'etteeddawaa malatiyaa harap'p'etuwaa malatee.<verse eid="SNG 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13"/>Aa gac'otuukka sawuwaa maataynne,</para>
  <para style="q2" vid="SNG 5:13">k'imaamii toketteedda atakilttiyaadan lo"iino;</para>
  <para style="q2" vid="SNG 5:13">Aa mettershshatuu karbbiyaa shittuu s'okiyaa wora c'iishshaadan lo"iino.<verse eid="SNG 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14"/>Aa kushetuu ink'k'uwaan alleek'k'etteedda work'k'aa s'am"aadan lo"iino;</para>
  <para style="q2" vid="SNG 5:14">Aa asatetsay samppeeriyaa giyaa ink'k'uwaan alleek'k'etteedda,</para>
  <para style="q2" vid="SNG 5:14">danggarssaa achchaa mala.<verse eid="SNG 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15"/>Aa gedetuu work'k'aa baasuwaan toketteedda,</para>
  <para style="q2" vid="SNG 5:15">ibinabaradiyaa tuussaa malatiino;</para>
  <para style="q2" vid="SNG 5:15">Aa malay zigan alleek'k'etteedda Liibaanoosa asaa mala.<verse eid="SNG 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16"/>Aa doonay eessaadan mal"ee. I ubbaannakka lo"iyaawaa.</para>
  <para style="q2" vid="SNG 5:16">Hinttenoo Yerusaalame wodoratoo,</para>
  <para style="q2" vid="SNG 5:16">ta siik'uunne ta laggii hawaa malatee yaagaaddu.<verse eid="SNG 5:16"/></para>
  <chapter eid="SNG 5"/>
  <chapter number="6" style="c" sid="SNG 6"/>
  <para style="ms">Siik'uu Ubbaappe Doorettee</para>
  <para style="mr">(<ref loc="SNG 6:1-7:6">6:1—7:6</ref>)</para>
  <para style="sp">Yerusaalame Wodorotuwaa:</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1"/>Mac'c'a asaa ubbaappe malanchchatee!</para>
  <para style="q2" vid="SNG 6:1">Ne laggii hak'a beedee? Nuunikka neenana ittippe koyanaw,</para>
  <para style="q2" vid="SNG 6:1">I beedda sa'aa nuw oda yaageeddino.<verse eid="SNG 6:1"/></para>
  <para style="sp">Wodoratta:</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2"/>Ta siik'uu dorssaa wudiyaa heemmanawunne,</para>
  <para style="q2" vid="SNG 6:2">lo"iyaa c'iishshaa shiishshanaw,</para>
  <para style="q2" vid="SNG 6:2">shittuwaa sawuwaa maatay de'iyaa ataakilttiyaa giddo wod'd'eedda.<verse eid="SNG 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3"/>Taani ta siik'uwaanno; ta siik'uukka tawaa.</para>
  <para style="q2" vid="SNG 6:3">I c'iishshaa giddon wudiyaa heemmee yaagaaddu.<verse eid="SNG 6:3"/></para>
  <para style="sp">Wodallay:</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4"/>Ta siik'k'atee! Neeni Tirs's'a katamay lo"iyaawaadan lo"aasa;</para>
  <para style="q2" vid="SNG 6:4">Yerusaalamedan daro lo"aasa; banddiraa oyk'k'iide,</para>
  <para style="q2" vid="SNG 6:4">salppiyaan biyaa olanchchay yashshiyaawaadan yashshaasa.<verse eid="SNG 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5"/>Hayyanaa ne ayifiyaa taappe wora zaaraarikkii,</para>
  <para style="q2" vid="SNG 6:5">ayaw gooppe, unttunttu taana waayissiino.</para>
  <para style="q2" vid="SNG 6:5">Ne binnaanay Gala'aade Deriyaappe wod'd'iyaa deeshshaa wudiyaa malatee.<verse eid="SNG 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6"/>Ne achchay meec'ettiide kesiyaa, ubbaykka manttiyaa yeliyaa,</para>
  <para style="q2" vid="SNG 6:6">unttunttu giddon maynii bayinna dorssaa wudiyaa mala.<verse eid="SNG 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7"/>Ne laa"u gac'otuwaa sharbbiyaa gidduwaana s'eelliyaa wode,</para>
  <para style="q2" vid="SNG 6:7">laa"u kesseedda roomaaniyaa teeraa malatiino.<verse eid="SNG 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8"/>Usuppun tammu mac'c'a kaatetuunne usuppun tammu baakkotuu,</para>
  <para style="q2" vid="SNG 6:8">k'ay payduu bayinna wodorotuu taw de'iino.<verse eid="SNG 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9"/>Shin ta harap'p'atta, ta tooshii bayinnaana, Aa taw dumma.</para>
  <para style="q2" vid="SNG 6:9">Aa bare aatissikka mes's'i ittinno;</para>
  <para style="q2" vid="SNG 6:9">izo yeleedda aatakka ayaappenne aatsaade izo siik'aw.</para>
  <para style="q2" vid="SNG 6:9">Wodorotuukka izo s'eelliide, Hanna anjjetteedaano yaagiino.</para>
  <para style="q2" vid="SNG 6:9">Mac'c'a kaatetuukka baakkotuukka izo sabbiino.<verse eid="SNG 6:9"/></para>
  <para style="sp">Yerusaalame Wodoratuwaa</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10"/>Hanna wontta s'alk'k'iyaadan doliyaana, aginaadan poo'iyaanna,</para>
  <para style="q2" vid="SNG 6:10">awaadan c'addiyaana, banddiraa oyk'k'iide salppiyaan biyaa olanchchaadan,</para>
  <para style="q2" vid="SNG 6:10">yashshiyaanna iza oonee? yaagiino.<verse eid="SNG 6:10"/></para>
  <para style="sp">Wodallay</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11"/>Taani wombban toketteedda mitsatuu lic'uwaa be'anaw,</para>
  <para style="q2" vid="SNG 6:11">woyniyaa turay aac'eedenttonne k'ay roomaaniikka c'iisheeddenttonne s'eellanaw,</para>
  <para style="q2" vid="SNG 6:11">duge ataakilttiyaa sa'aa wod'd'ay.<verse eid="SNG 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12"/>Taani akeekenan de'ishiina, ta amuu taana afiide,</para>
  <para style="q2" vid="SNG 6:12">ta kaatiyaa matan, paraa gaariyan taana utisseedda yaageedda.<verse eid="SNG 6:12"/></para>
  <para style="sp">Yerusaalame Wodorotuwaa:</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13"/>Neenoo Shulaame biittaappe yeeddawunne, haaya;</para>
  <para style="q2" vid="SNG 6:13">haa simma! Neena nu loytsiide s'eelana; haa simma! yaageeddino.</para>
  <para style="sp" vid="SNG 6:13">Wodoratta:</para>
  <para style="q1" vid="SNG 6:13">Daro asaa sintsan yes's'iyaa asaadan, taakko ayaw s'eelliitee? yaagaaddu.<verse eid="SNG 6:13"/></para>
  <chapter eid="SNG 6"/>
  <chapter number="7" style="c" sid="SNG 7"/>
  <para style="sp">Wodallay:</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1"/>Kaatiyaa naattidan lo"iyaanee!</para>
  <para style="q2" vid="SNG 7:1">Ne gedetuu neeni nas'alaa c'aammaa wotsi de'ishshin be'iyaa wode,</para>
  <para style="q2" vid="SNG 7:1">ayaa lo"iino! Ne sheechchii eranchcha wogaac'ii k'os's'iide,</para>
  <para style="q2" vid="SNG 7:1">loytsi alleek'k'isseeda ink'k'uwaa malatee.<verse eid="SNG 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2"/>Ne gul"ay woyniyaa eessay kumeedda birilliyaa malatee;</para>
  <para style="q2" vid="SNG 7:2">ne s'eessaa yuushshuu c'iishshan k'ashetteedda zarggaa mirk'k'iyaa malatee.<verse eid="SNG 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3"/>Ne d'antsatuu manttiyaa yeletteedda, gen"ati maratuwaa malatiino.<verse eid="SNG 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4"/>Ne k'ood'ii danggarssaa zaaliyaan alleek'k'etteedda adussa gimbbiyaa mala.</para>
  <para style="q2" vid="SNG 7:4">Ne ayifii wolk'k'aama Haseboona katamaa penggiyaa matan de'iyaa,</para>
  <para style="q2" vid="SNG 7:4">zeeruwaa haatsaa malatee.</para>
  <para style="q2" vid="SNG 7:4">Ne siid'ii Damask'k'o s'eelissiide gimbbeedda Liibaanoosa gimbbiyaa malatee.<verse eid="SNG 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5"/>Ne huup'ii K'armmeloosa asaa malatee;</para>
  <para style="q2" vid="SNG 7:5">ne olassa binnaanay k'ac'inaa s'aatsaa malatee;</para>
  <para style="q2" vid="SNG 7:5">kaatiyaakka ne huup'iyaa datsay nashechcheedda.<verse eid="SNG 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6"/>Ta siik'k'atee, ne ayaa lo"ay! Ne ayaa malanchchatii!</para>
  <para style="q2" vid="SNG 7:6">Ne siik'uu taana ayaa nashechchii!<verse eid="SNG 7:6"/></para>
  <para style="s">Taaninne Neeninne S'alalay</para>
  <para style="r">(<ref loc="SNG 7:7-8:4">7:7—8:4</ref>)</para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7"/>Ne geesay zambbaa geesaa malatee.</para>
  <para style="q2" vid="SNG 7:7">Ne d'antsay zambbaa ayifiyaa wurc'c'uwaa malatee.<verse eid="SNG 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8"/>Taani, Ha zambbaa gi"ana; Aa maratuwaa oyk'k'ana yaagaad.</para>
  <para style="q2" vid="SNG 7:8">Ne d'antsay woyniyaa teeraa wurc'c'uwaa mala;</para>
  <para style="q2" vid="SNG 7:8">k'ay ne siid'iyaanna kesiyaa peenuu appiliyaa ayifiyaadan sawee.<verse eid="SNG 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 7:9"/>Ne yeruu mettershshatuwaappenne achchaappe gidduwaana,</para>
  <para style="q2" vid="SNG 7:9">walalattiidde geliyaa woyniyaa mala.</para>
  <para style="sp" vid="SNG 7:9">Wodoratta:</para>
  <para style="q1" vid="SNG 7:9">Ubbaappe aad'd'iide mal"iyaa</para>
  <para style="q2" vid="SNG 7:9">woyniyaa eessaa mala yaageedda.<verse eid="SNG 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10"/>Taani ta al"o siik'uwaanno; ikka taana amottee.<verse eid="SNG 7:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="SNG 7:11"/>Ta siik'ow, haaya; laa"uu katamaappe kesiide biide,</para>
  <para style="q2" vid="SNG 7:11">gas'ariyan ak'oytte; k'ammaa laa"uu hewan aatsana.<verse eid="SNG 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12"/>Wontta guuran ane woyniyaa turaa giddo boytte;</para>
  <para style="q2" vid="SNG 7:12">woyniyaa turay c'iisheeddentto, c'iishshiide ayifiyaa dors's'os's'eedenttonne,</para>
  <para style="q2" vid="SNG 7:12">k'ay roomaaniikka ayifeeddentto ane be'oytte.</para>
  <para style="q2" vid="SNG 7:12">Taani ta siik'uwaa neena hewan bessana.<verse eid="SNG 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13"/>Inkkoyiyaa ayifiyaa sawuunne hara nashechchiyaa ataakilttiyaa ayifii,</para>
  <para style="q2" vid="SNG 7:13">nu karen besseedda; ta siik'oo!</para>
  <para style="q2" vid="SNG 7:13">Ha ayifetuwaappe teereeddawanttanne ooratsa mas'eeddawantta,</para>
  <para style="q2" vid="SNG 7:13">new ashsha wotsaad.<verse eid="SNG 7:13"/></para>
  <chapter eid="SNG 7"/>
  <chapter number="8" style="c" sid="SNG 8"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1"/>Ne taw allaga gidennaan ta daayi d'antsaa d'ammeedda ta ishaa gidaarikkiishsha!</para>
  <para style="q2" vid="SNG 8:1">Yaatintto taani neena ogiyaan demmaade shiishsha akka yerina,</para>
  <para style="q2" vid="SNG 8:1">taana ooninne borennashin.<verse eid="SNG 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2"/>Taana tamaarisseedda ta daay golle taani neena kaaletsaade,</para>
  <para style="q2" vid="SNG 8:2">ta daayi k'ol"o gelissa aginaa,</para>
  <para style="q2" vid="SNG 8:2">hewan taana ne siik'uwaabaa tamaarisseeddawaa gidaarikkii;</para>
  <para style="q2" vid="SNG 8:2">roomaaniyaa gum"eedda mal"iyaawaa,</para>
  <para style="q2" vid="SNG 8:2">lo"iyaa woyniyaa eessaa taani neena hewan ushshaarikkitaa.<verse eid="SNG 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3"/>Taana hewan ne haddirssa k'eesiyaa borkkotissaade,</para>
  <para style="q2" vid="SNG 8:3">ne ushechcha kushiyan taana k'oommeeddawaa gidaarikkii.<verse eid="SNG 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4"/>Hinttenoo Yerusaalame wodoratoo,</para>
  <para style="q2" vid="SNG 8:4">Siik'uu bare wodiyaan denddanaw, k'aasetsi dentsetsennaadan,</para>
  <para style="q2" vid="SNG 8:4">ta hinttew hadaraa gay yaagaaddu.<verse eid="SNG 8:4"/></para>
  <para style="s">Siik'uwaa Sabaa</para>
  <para style="r">(<ref loc="SNG 8:5-14">8:5-14</ref>)</para>
  <para style="sp">Yerusaalame Wodorotuu:</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5"/>Bare siik'uwaa hashiyaan zemppaade,</para>
  <para style="q2" vid="SNG 8:5">bazzuwaappe yiyaana hanna oonee? yaageeddino.</para>
  <para style="sp" vid="SNG 8:5">Wodoratta:</para>
  <para style="q1" vid="SNG 8:5">Beni ne aata neena bannikka yeleedda,</para>
  <para style="q2" vid="SNG 8:5">appiliyaa lank'k'iyaan ne gisa de'ishshin,</para>
  <para style="q2" vid="SNG 8:5">neena ta k'aaseretsaade dentsaad.<verse eid="SNG 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6"/>Med'inaa siik'uwaan taana ne wozanaa bolla attama;</para>
  <para style="q2" vid="SNG 8:6">ne k'esiyankka maatafaadan, ta s'alalaa oyk'k'a.</para>
  <para style="q2" vid="SNG 8:6">Ayaw gooppe, siik'uu hayk'k'uwaa mala mina;</para>
  <para style="q2" vid="SNG 8:6">mishuukka duufuwaa mala mek'etsaa iita;</para>
  <para style="q2" vid="SNG 8:6">Aa lac'uukka S'oossaa tamaa lac'uwaa mala.<verse eid="SNG 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7"/>Haatsaa daruu siik'uwaa tamaa toyissanaw danddayenna;</para>
  <para style="q2" vid="SNG 8:7">di'uukka meec'c'iide afanaw danddayenna.</para>
  <para style="q2" vid="SNG 8:7">Asay siik'uwaa shammanaw barew de'iyaa ak'uwaa ubbaa immooppekka,</para>
  <para style="q2" vid="SNG 8:7">siik'uu shaluwaan shamettenna diraw,</para>
  <para style="q2" vid="SNG 8:7">asay hewaa kad'ee yaagaaddu.<verse eid="SNG 8:7"/></para>
  <para style="sp">Wodoratti Ishatuu:</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8"/>Nuw tiraan d'antsay uttibeenna michchata de'aw;</para>
  <para style="q2" vid="SNG 8:8">asinay izo oochchooppe, nuuni iw ootsanawe ayee?<verse eid="SNG 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9"/>Iza gimbbiyaa dirssaa gidintto, nuuni I bolla wochchiyaa adussa,</para>
  <para style="q2" vid="SNG 8:9">biraa gimbbiyaa gimbbana; Aa dirssaa pengge gidintto,</para>
  <para style="q2" vid="SNG 8:9">zigaa sank'k'aan izo doodissana yaageeddino.<verse eid="SNG 8:9"/></para>
  <para style="sp">Wodoratta:</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10"/>Hekko taani dirssaa gimbbiyaa;</para>
  <para style="q2" vid="SNG 8:10">ta d'antsaykka gimbbiyaa bolla gimbbetteedda wochchiyaa saa;</para>
  <para style="q2" vid="SNG 8:10">hewaa diraw, taani ta siik'uwaanna de'iyaa wode, I taanan nashettee.<verse eid="SNG 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11"/>Solomonew Ba'aali-Hamoonan woynnii toketteedda shoyk'ay de'ee;</para>
  <para style="q2" vid="SNG 8:11">he woyniyaa gidduwaa ootsiyaawanttoo keraa immeedda.</para>
  <para style="q2" vid="SNG 8:11">Keraa akkeedawanttu teeran go'etteeddawaa diraw,</para>
  <para style="q2" vid="SNG 8:11">huup'iyaan huup'iyaan sha"u biraa aw ahiino.<verse eid="SNG 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12"/>Shin taw ta buzo woynnii toketteedda shoyk'ay de'ee;</para>
  <para style="q2" vid="SNG 8:12">Solomona, neeni sha"u biraa akka;</para>
  <para style="q2" vid="SNG 8:12">ataakilttiyaa ootsiyaawanttu laa"u s'eetu biraa akkino yaagaaddu.<verse eid="SNG 8:12"/></para>
  <para style="sp">Wodallay:</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13"/>Neenoo, ataakilttiyaa giddon de'iyaa ta siik'k'atee,</para>
  <para style="q2" vid="SNG 8:13">ne kooshshaa laggetuwaa sissanaw koyiino;</para>
  <para style="q2" vid="SNG 8:13">ne kooshshaa taana sisa yaageedda.<verse eid="SNG 8:13"/></para>
  <para style="sp">Wodoratta:</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14"/>Ta siik'ow, taakko ellekka haaya!</para>
  <para style="q2" vid="SNG 8:14">Sawiyaa maatay mokkiyaa deretuwaa bollaanna,</para>
  <para style="q2" vid="SNG 8:14">guppiyaa gen"iyaa woy doggiyaa maratuwaa malataade yaagaaddu.<verse eid="SNG 8:14"/></para>
  <chapter eid="SNG 8"/>
</usx>
