<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- Dawuro Full Bible Latin Version</book>
  <para style="h">Mazimuriyaa</para>
  <para style="toc1">Mazimuriyaa Mas'aafaa</para>
  <para style="toc2">Mazimuriyaa</para>
  <para style="toc3">Maz.</para>
  <para style="mt1">Mazimuriyaa Mas'aafaa</para>
  <para style="imt">Geluwaa</para>
  <para style="ip">Daawita Mazimurii (Mazimuriyaa Mas'aafay) Geeshsha Mas'aafaa giddon Mazimuriyaanne woosa mas'aafaa gidiide erettee. Ha mas'aafaa giigisseeddawanttu adussa wodetuwaa giddon beetteedda dumma dumma asatuwaa. Itti itti mazimuretuwaa Kaatii Daawite s'aafeeddawe ammanettee. Ha mazimuretuwaanne ha woosatuwaa shiishshiide, barenttu goyinuwaa wodiyaan go'ettiiddi gam"eeddawanttu Israa'eeliyaa asatuwaa. Guyyeppe gam"iidde barenttu Geeshsha mas'aafatuwaa giddon gelisseeddino.</para>
  <para style="ip">Hawanttu ayyaanaappe s'aafetteedda gins's'atuu c'ora k'ommo; unttunttukka galatiyaanne S'oossaw goyinniyaa gins's'atuwaa, S'oossay maaddana mala, naagana malanne saro wotsana mala woossiyaa woosatuwaa, nagaraappe maarettanaw shiishshiyaa woosatuwaa, S'oossaa anjjuwaabaa odiyaa galataa sabatuwaanne morkkatuwaa murana mala S'oossaw odiyaa maganatuwaa. Ha woosatuu itti uray barekka woosseedda woosatuwaanne c'ora Asay ittippe woosseedda woosatuwaa. Unttunttuppe ittuu ittuu itti uraa wozanaan sisetteedda seelaa k'onc'c'issiyaawantta. Haratuu k'ay S'oossaa Asay ubbay koyiyaawaanne asaw ubbaw sisettiyaa hanotatuwaa bessiyaawantta.</para>
  <para style="ip">Yesuusi tamaarissiidde mazimuriyaa mas'aafaappe bochchi bochchi akkiide tamaarisseedda. Ooratsa C'aak'k'uwaa s'aafeeddawanttukka an s'aafetteeddawaappe barenttu s'aafiyaa mas'aafaa giddo gelisseeddino. Woosa gollatta ek'k'oodeppe doommaade, Mazimuriyaa Mas'aafaa goyinuwaa wogaw go'ettiyaa wolk'k'aama minjjuwaabaadan paydaw.</para>
  <para style="iot">Shemppatuwaa Ubbatoo Imetteedda K'antsa K'ofatuwaa</para>
  <para style="io1">Koyro Mas'aafaa <char style="ior"><ref loc="PSA 1-41">Maz. 1—41</ref></char></para>
  <para style="io1">Laa"entso Mas'aafaa<char style="ior"><ref loc="PSA 42-72">Maz. 42—72</ref> </char></para>
  <para style="io1">Heezzentso Mas'aafaa<char style="ior"><ref loc="PSA 73-89">Maz. 73—89</ref> </char></para>
  <para style="io1">Oyddentso Mas'aafaa<char style="ior"><ref loc="PSA 90-106">Maz. 90—106</ref></char></para>
  <para style="io1">Ichcheshentso Mas'aafaa<char style="ior"><ref loc="PSA 107-150">Maz. 107—150</ref> </char></para>
  <chapter number="1" style="c" sid="PSA 1" />
  <para style="ms">Koyro Mas'aafaa</para>
  <para style="mr">(<ref loc="PSA 1-41">1—41</ref>)</para>
  <para style="s">Lo"o Asaanne Iita Asaa Hametaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1" />Iitatuwaa zoriyaan beennawe,</para>
  <para style="q2" vid="PSA 1:1">woy nagaranchchatuwaa ogiyaan ek'k'ennawe,</para>
  <para style="q2" vid="PSA 1:1">k'iliic'iyaawanttu shiik'uwaan uttennawe,</para>
  <para style="q2" vid="PSA 1:1">hewe anjjetteedawaa.<verse eid="PSA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2" />Shin Med'inaa Godaa higgiyan I nashettee;</para>
  <para style="q2" vid="PSA 1:2">Aa higgiyaa gallassinne k'amma k'oppee.<verse eid="PSA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3" />Hewe goggiyaa haatsaa s'ap'uwaan tokettiide,<note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="JER 17:8">Erm. 17:8</ref></char></note></para>
  <para style="q2" vid="PSA 1:3">ayifiyaa aginaan ayifiyaa,</para>
  <para style="q2" vid="PSA 1:3">bare haytsaakka k'ok'k'ofenna mitsaa mala.</para>
  <para style="q2" vid="PSA 1:3">I ootsiyaa ubbay aw hanee.<verse eid="PSA 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4" />Shin iitatuu hewaa mala gidikkino;</para>
  <para style="q2" vid="PSA 1:4">c'arkkuu pitti afiyaa suullaa mala.<verse eid="PSA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5" />Hewaa diraw, iitatuwaa bolla S'oossay pirddana;</para>
  <para style="q2" vid="PSA 1:5">nagaranchchatuukka s'illotuwaa shiik'uwaan ek'k'ikkino.<verse eid="PSA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6" />Ayaw gooppe, Med'inaa Goday s'illotuwaa ogiyaa eree;</para>
  <para style="q2" vid="PSA 1:6">shin iitatuwaa ogii d'ayana.<verse eid="PSA 1:6" /></para>
  <chapter eid="PSA 1" />
  <chapter number="2" style="c" sid="PSA 2" />
  <para style="s">S'oossaan Dooreteedda Kaatiyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1" />Amanenawanttu ayaw denddiinoo?<note caller="-" style="x"><char style="xo" closed="false">2:1-2 </char><char style="xt" closed="false"><ref loc="ACT 4:25-26">Kit. 4:25-26</ref></char></note></para>
  <para style="q2" vid="PSA 2:1">K'ay kawutetsatuu ayaw patsennabaa mak'ettiinoo?<verse eid="PSA 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2" />Sa'aa kaatetuu denddeeddino;</para>
  <para style="q2" vid="PSA 2:2">asaa mooddiyaawanttu ittippe shiik'eeddino.</para>
  <para style="q2" vid="PSA 2:2">Unttunttu Med'inaa Godaa bollanne</para>
  <para style="q2" vid="PSA 2:2">I okkeeddawaa bolla ittippe shiik'eeddino.<verse eid="PSA 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3" />Unttunttu, «Nuuni unttunttu sanssalataa duutsoytte;</para>
  <para style="q2" vid="PSA 2:3">unttunttu nuuna k'achchiyaawaakka wora oloytte» yaagiino.<verse eid="PSA 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4" />Saluwaan bare araatan utteeddawe</para>
  <para style="q2" vid="PSA 2:4">unttunttu bolla miic'c'ee;</para>
  <para style="q1" vid="PSA 2:4">Goday unttunttu bolla k'iliic'ee.<verse eid="PSA 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5" />I bare hank'k'uwaan unttuntta seeree;</para>
  <para style="q2" vid="PSA 2:5">bare wolk'k'aama hank'k'uwaan unttuntta yashissee.<verse eid="PSA 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6" />Goday, «Taan ta geeshsha deriyaa S'iyoone bolla</para>
  <para style="q2" vid="PSA 2:6">ta kaatiyaa kawutsaad» yaagee.<verse eid="PSA 2:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 2:7" />He kaatii, «Taan Med'inaa Godaa higgiyaa awaayana;<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="ACT 13:37">Kit. 13:37</ref>; <ref loc="HEB 1:5">Ibr. 1:5</ref>; <ref loc="HEB 5:5">5:5</ref></char></note></para>
  <para style="q2" vid="PSA 2:7">I taana, ‹Neeni ta na'aa;</para>
  <para style="q2" vid="PSA 2:7">taani hachchi new aawuwaa gidaaddi.<verse eid="PSA 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8" />Neeni taana oochcha;</para>
  <para style="q2" vid="PSA 2:8">Taani kawutetsaa ubbaa new immana;</para>
  <para style="q2" vid="PSA 2:8">sa'aa ubbay nebaa gidanawaa.<verse eid="PSA 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9" />Neeni birataa s'am"an unttuntta mentsereetsana;<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="REV 2:26-27">Sas'. 2:26-27</ref>; <ref loc="REV 12:5">12:5</ref>; <ref loc="REV 19:15">19:15</ref></char></note></para>
  <para style="q2" vid="PSA 2:9">Unttuntta neeni urk'k'aa miishshaa mentsiyaawaadan liik'issana› yaagee» yaageedda.<verse eid="PSA 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10" />Hewaa diraw, hinttenoo kaatetoo, eeyattoppite;</para>
  <para style="q2" vid="PSA 2:10">ha sa'aa mooddiyaawanttoo, hinttena naagite!<verse eid="PSA 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11" />Med'inaa Godaw yashshatetsan ootsite;</para>
  <para style="q2" vid="PSA 2:11">kokkorssaan azazettite.<verse eid="PSA 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12" />S'oossay hank'k'ettina, ogiyaan hintte d'ayennaadan suure wozanaan aw goynnite;</para>
  <para style="q2" vid="PSA 2:12">ayaw gooppe, Aa hank'k'uu ellekka ees's'i kesana.</para>
  <para style="q1" vid="PSA 2:12">Bak'ati an k'osetti attiyaa ubbatuu anjjetteedawantta.<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="2SA 15:13-17:22">2 Sam. 15:13—17:22</ref></char></note><verse eid="PSA 2:12" /></para>
  <chapter eid="PSA 2" />
  <chapter number="3" style="c" sid="PSA 3" />
  <para style="d">Bare na'aa Abeseloomappe bak'ateedda wode Daawita mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1" />Abeet Med'inaa Godaw, ta morkketuu ayaa c'oratteeddinoo!</para>
  <para style="q2" vid="PSA 3:1">Ta bolla aappunatuu denddiinoo!<verse eid="PSA 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2" />Darotuu, «S'oossay Aa ashshenna» yaagiide</para>
  <para style="q2" vid="PSA 3:2">tawaa haasayiino.<verse eid="PSA 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3" />Shin abeet Med'inaa Godaw, Neeni ta yuushshuwaan gonddalle.</para>
  <para style="q2" vid="PSA 3:3">Taana bonchchissiyaawenne ta suntsaa d'ok'k'u ootsiyaawe neenattee.<verse eid="PSA 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4" />Taani ta k'aalaa d'ok'k'issaade Med'inaa Godaakko waassay.</para>
  <para style="q2" vid="PSA 3:4">Bare geeshsha deriyaappe taw I zaaree.<verse eid="PSA 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5" />Med'inaa Goday taana naagiyaa diraw,</para>
  <para style="q2" vid="PSA 3:5">taani gisaade gem"ishaynne beegottay.<verse eid="PSA 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6" />Taani taana dooddiide denddeedda,</para>
  <para style="q2" vid="PSA 3:6">tammu sha"aa asatookka yayyikke.<verse eid="PSA 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7" />Abeet Med'inaa Godaw, dendda!</para>
  <para style="q2" vid="PSA 3:7">Abeet ta S'oossaw, taana ashsha!</para>
  <para style="q1" vid="PSA 3:7">Ayaw gooppe, neeni ta morkkatuwaa ubbaa goggoc'c'uwaa shoc'aadda;</para>
  <para style="q2" vid="PSA 3:7">iitatuwaa achchaakka mentsaadda.<verse eid="PSA 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8" />Ashshuu S'oossaawaa;</para>
  <para style="q2" vid="PSA 3:8">S'oossaw, ne asaa neeni anjja.<verse eid="PSA 3:8" /></para>
  <chapter eid="PSA 3" />
  <chapter number="4" style="c" sid="PSA 4" />
  <para style="s">Maadoo Omarssi Shiik'iyaa Woosaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Diitsatuwaan Yes'etteedda, Daawita Mazimuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 4:1" />Abeet taana s'illissiyaa S'oossaw,</para>
  <para style="q2" vid="PSA 4:1">taani neena s'eesiyaa wode, taw koya.</para>
  <para style="q2" vid="PSA 4:1">Taani un"etteedda wode, taana shemppissaadda.</para>
  <para style="q2" vid="PSA 4:1">Taw neeni k'arettaade ta woosaa sisa.<verse eid="PSA 4:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2" />Hinttenoo asatoo, awude gakkanaw ta bonchchuwaa kawushshiitee?</para>
  <para style="q2" vid="PSA 4:2">Shori bayinnabaakka awude gakkanaw hintte siik'iitee?</para>
  <para style="q1" vid="PSA 4:2">Wordduwaa awude gakkanaw c'addi oyk'k'i kaalliitee?<verse eid="PSA 4:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3" />Shin Med'inaa Goday S'oossaa asatuwaa</para>
  <para style="q2" vid="PSA 4:3">barew dummay wotseeddawaa hintte erite.</para>
  <para style="q1" vid="PSA 4:3">Taani Med'inaa Godaa s'eesiyaa wode,</para>
  <para style="q2" vid="PSA 4:3">I taw sisee.<verse eid="PSA 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4" />Hank'k'ettite, shin hintte hank'k'uwaan nagaraa ootsoppite.<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="EPH 4:26">Efe. 4:26</ref></char></note></para>
  <para style="q2" vid="PSA 4:4">Hiis'an gisiyaa wode,</para>
  <para style="q2" vid="PSA 4:4">hintte wozanaa biditenne sirp'p'i giite.<verse eid="PSA 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5" />Likke yarshshuwaa yarshshitenne</para>
  <para style="q2" vid="PSA 4:5">Med'inaa Godaan ammanettite.<verse eid="PSA 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6" />Darotuu, «Nuuna lo"obaa bessanawe oonee?» yaagiino.</para>
  <para style="q2" vid="PSA 4:6">Abeet Med'inaa Godaw, neeni nuuna keeka ayifiyaan s'eella.<verse eid="PSA 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7" />Neeni ta wozanaan wolk'k'aama nashshechchaa kuntsaadda.</para>
  <para style="q2" vid="PSA 4:7">Hewenne, katsaa ayifiinne ooratsa woyniyaa eessay,</para>
  <para style="q2" vid="PSA 4:7">barenttoo darina nashetiyaa nashechchaappekka dariyaawaa.<verse eid="PSA 4:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8" />Abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 4:8">ne s'alalay taana saruwaan naaga wotsiyaa diraw,</para>
  <para style="q2" vid="PSA 4:8">taani gisaade sarotetsaan gem"ishshay.<verse eid="PSA 4:8" /></para>
  <chapter eid="PSA 4" />
  <chapter number="5" style="c" sid="PSA 5" />
  <para style="s">Wontta Woosaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Suusullatuwaan Yes'etteedda, Daawita Mazimuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 5:1" />Abeet Med'inaa Godaw, taani odiyaawaa hayzza;</para>
  <para style="q2" vid="PSA 5:1">ta ooliyaanne sisa.<verse eid="PSA 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2" />Ta kaatiyawunne ta S'oossaw,</para>
  <para style="q2" vid="PSA 5:2">Taana maadda gaade ta neekko waassiyiyaa diraw,</para>
  <para style="q2" vid="PSA 5:2">ta woosaa sisa.<verse eid="PSA 5:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3" />Abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 5:3">wontta wontta guuran neeni ta k'aalaa sisaasa.</para>
  <para style="q1" vid="PSA 5:3">Wontta wontta guuran taani ta woosaa ne sintsa shiishshaade,</para>
  <para style="q2" vid="PSA 5:3">neeni taw immiyaa zaaruwaa akkana gaade naagay.<verse eid="PSA 5:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4" />Neeni iitatetsan nashettena S'oossaa;</para>
  <para style="q2" vid="PSA 5:4">iitabay neenana de'enna.<verse eid="PSA 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5" />C'eek'ettiyaawanttu ne sintsan ek'k'ikkino;</para>
  <para style="q2" vid="PSA 5:5">iitabaa ootsiyaa ubbatuwaa neeni is's'aa.<verse eid="PSA 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 5:6" />Wordduwaa haasayiyaawanttakka neeni d'ayissaasa.</para>
  <para style="q2" vid="PSA 5:6">Suutsaa gussiyaawanttanne c'immiyaa asatuwaa,</para>
  <para style="q1" vid="PSA 5:6">S'oossay shenetee.<verse eid="PSA 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7" />Shin taani ne maarotaa daruwaan</para>
  <para style="q2" vid="PSA 5:7">ne golliyaa gelana.</para>
  <para style="q1" vid="PSA 5:7">Ne Geeshsha Golliyaakko simmaade,</para>
  <para style="q2" vid="PSA 5:7">new yashshatetsan goyinnana.<verse eid="PSA 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8" />Abeet Med'inaa Godaw, Taana ne s'illotetsan kaaletsa;</para>
  <para style="q2" vid="PSA 5:8">ta morkkatuwaa diraw gaade,</para>
  <para style="q2" vid="PSA 5:8">ne ogiyaa ta sintsan suurisa.<verse eid="PSA 5:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9" />Unttunttu doonaappe kesiyaawe ammantsenna.<note caller="-" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="ROM 3:13">Rom. 3:13</ref></char></note></para>
  <para style="q2" vid="PSA 5:9">Unttunttu wozanaankka genii kumeedda;</para>
  <para style="q2" vid="PSA 5:9">unttunttu doonay dooyetteedda duufuwaa mala;</para>
  <para style="q2" vid="PSA 5:9">Unttunttu barenttu ins's'arssan c'immiino.<verse eid="PSA 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10" />Abeet S'oossaw, unttuntta neeni pirdda;</para>
  <para style="q2" vid="PSA 5:10">unttunttu kobay unttuntta akki bo.</para>
  <para style="q1" vid="PSA 5:10">Unttunttu nagaray daro gideedda diraw,</para>
  <para style="q2" vid="PSA 5:10">neeni unttuntta yederssa;</para>
  <para style="q2" vid="PSA 5:10">ayaw gooppe, unttunttu ne bolla makkaleeddino.<verse eid="PSA 5:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11" />Shin neekko bak'ati k'osetti attiyaa ubbay nashetino;</para>
  <para style="q2" vid="PSA 5:11">unttunttu ubbaa gede nashshechchan yes's'ino.</para>
  <para style="q1" vid="PSA 5:11">Neenikka unttuntta naagana;</para>
  <para style="q2" vid="PSA 5:11">ne suntsaa siik'iyaa ubbatuu neenan loytsi nashetino.<verse eid="PSA 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12" />Ayaw gooppe, abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 5:12">tumukka neeni s'illuwaa anjjaasa.</para>
  <para style="q1" vid="PSA 5:12">Neeni gonddallii kammiyaawaadan ne keekkatetsan Aa kammaasa.<verse eid="PSA 5:12" /></para>
  <chapter eid="PSA 5" />
  <chapter number="6" style="c" sid="PSA 6" />
  <para style="s">Un"o Wodiyaan Shiik'eedda Woosaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Diitsatuwaan Yes'etteedda, Daawita Mazimuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1" />Abeet Med'inaa Godaw, ne hank'k'uwaan taana seeroppaarikkii;<note caller="-" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="PSA 38:1">Maz. 38:1</ref></char></note></para>
  <para style="q2" vid="PSA 6:1">woy ne yiluwaan taana muroppaarikkii.<verse eid="PSA 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2" />Abeet Med'inaa Godaw, taani labbanneedda diraw,</para>
  <para style="q2" vid="PSA 6:2">taana maaraarikkii.</para>
  <para style="q1" vid="PSA 6:2">Abeet Med'inaa Godaw, ta wozanay madus's'o diraw, taana patsa.<verse eid="PSA 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3" />Ta shemppatta daroppe un"ettaaddu;</para>
  <para style="q2" vid="PSA 6:3">shin S'oossaw, taana maaddanaw neeni awude gakkanaw gam"ay?<verse eid="PSA 6:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4" />Abeet S'oossaw, neeni simmaade, taana ashsha;</para>
  <para style="q2" vid="PSA 6:4">ne maarotaa daruwaan taana kessa akka.<verse eid="PSA 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5" />Hayk'k'eedda uray ooninne neena hassayenna;</para>
  <para style="q2" vid="PSA 6:5">duufuwaan neena galatiyaawe baawa.<verse eid="PSA 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6" />Taani ooliyaan daaburaad;</para>
  <para style="q2" vid="PSA 6:6">K'amma ubbaan taani yeekkaade, ta hiis'aa irs's'issaad;</para>
  <para style="q2" vid="PSA 6:6">ta borkkotsaakka ta afotsaan muusuud'issaad.<verse eid="PSA 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7" />Ta morkkatuwaa ubbaa gaasuwaan taani afos's'eedda diraw,</para>
  <para style="q2" vid="PSA 6:7">ta ayifii galjjeedda;</para>
  <para style="q2" vid="PSA 6:7">ta ayifii demmennaan is's'eedda.<verse eid="PSA 6:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8" />Med'inaa Goday taani yeekkiyaa yeekuwaa siseedda diraw,</para>
  <para style="q2" vid="PSA 6:8">Hinttenoo, iitaa ootsiyaa ubbatoo,</para>
  <para style="q2" vid="PSA 6:8">gede taappe shaakettite.<note caller="-" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="MAT 7:23">Mat. 7:23</ref>; <ref loc="LUK 13:27">Luk'. 13:27</ref></char></note><verse eid="PSA 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9" />Med'inaa Goday ta watiwatuwaa siseedda;</para>
  <para style="q2" vid="PSA 6:9">Med'inaa Goday ta woosaanne sisee.<verse eid="PSA 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10" />Ta morkke ubbatuu yeellatinonne tuggatino.</para>
  <para style="q2" vid="PSA 6:10">Unttunttu k'oppennaan yeellatiide, guyye simmino.<verse eid="PSA 6:10" /></para>
  <chapter eid="PSA 6" />
  <chapter number="7" style="c" sid="PSA 7" />
  <para style="s">Yedesaa Wodiyaan S'illo Asaa Woosaa</para>
  <para style="d">Biiniyaama Zariyaa Kuuzawaa Daawite, S'oossaakko Zilaaleedda Zilaassaa.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 7:1" />Abeet Med'inaa Godaw, ta S'oossaw, taani neekko bak'ataade k'osettay.</para>
  <para style="q1" vid="PSA 7:1">Taana yederssiyaa ubbatuwaappe neeni taana ashsha akka.<verse eid="PSA 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2" />Neeni taana ashshenabaa gidooppe,</para>
  <para style="q2" vid="PSA 7:2">Unttunttu taana gaammuwaadan bonk'k'iide,</para>
  <para style="q2" vid="PSA 7:2">ooninne ashshenan mentsereetsana.<verse eid="PSA 7:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3-4" style="v" sid="PSA 7:3-4" />Abeet Med'inaa Godaw ta S'oossaw,</para>
  <para style="q2" vid="PSA 7:3-4">Taani asaa naak'k'eeddawaa gidooppe,</para>
  <para style="q1" vid="PSA 7:3-4">Hewenne ta laggiyaw lo"uwaa diraw iitaa zaareeddawaa gidooppenne,</para>
  <para style="q2" vid="PSA 7:3-4">Woy gaasuu bayinnan ta morkkiyaa bonk'k'eeddawaa gidooppe,</para>
  <para style="q1" vid="PSA 7:3-4">Hawaa mala yewotuwaappe ittuwaanne taani ootseeddawaa gidooppe,<verse eid="PSA 7:3-4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 7:5" />ta morkkii taana yederssiide oyk'k'o.</para>
  <para style="q2" vid="PSA 7:5">Taana sa'aan yed'ereetso;</para>
  <para style="q2" vid="PSA 7:5">yaatiide, taana biittaan oli basho.<verse eid="PSA 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6" />Abeet Med'inaa Godaw, ne hank'k'uwaan dendda ek'k'a;</para>
  <para style="q2" vid="PSA 7:6">ta morkkatuwaa ees's'iyaa hank'k'uwaa bolla dendda.</para>
  <para style="q1" vid="PSA 7:6">Ta S'oossaw Godaw, beegotta; tumuwaa pirdda.<verse eid="PSA 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7" />Kawutetsatuwaa shiik'uu ne yuushshuwaan shiik'o;</para>
  <para style="q2" vid="PSA 7:7">neeni unttunttuppe bollaanna gidaade haana.<verse eid="PSA 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 7:8" />Med'inaa Goday kawutetsatuwaa bolla pirddee.</para>
  <para style="q2" vid="PSA 7:8">Abeet Med'inaa Godaw, taw ta s'illotetsaadan pirdda;</para>
  <para style="q1" vid="PSA 7:8">Abeet Ubbaappe D'ok'k'aw, ta suuretetsaadan pirddaa.<verse eid="PSA 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9" />K'ofaanne wozanaa biddaade eriyaa s'illo S'oossaw,<note caller="-" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="REV 2:23">Sas'. 2:23</ref></char></note></para>
  <para style="q2" vid="PSA 7:9">iitatuwaa geniyaa neeni d'ayissa.</para>
  <para style="q1" vid="PSA 7:9">Shin s'illuwaa sarotan minisa wotsa.<verse eid="PSA 7:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10" />Wozanaa s'illuwaa ashshiyaa S'oossay</para>
  <para style="q2" vid="PSA 7:10">taw gonddalle.<verse eid="PSA 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11" />S'oossay s'illuwaa pirddiyaawaa;</para>
  <para style="q2" vid="PSA 7:11">I hachchi hachchi hank'k'ettiyaa S'oossaa.<verse eid="PSA 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12" />Asay bare nagaraa paas'iide simmennaan is's'ooppe,</para>
  <para style="q2" vid="PSA 7:12">S'oossay bare mashshaa leefee;</para>
  <para style="q1" vid="PSA 7:12">I bare wonddaafiyaa giigissee.<verse eid="PSA 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13" />I bare wod'iyaa olaa miishshatuwaa giigissee;</para>
  <para style="q2" vid="PSA 7:13">Tamaa lac'uwaadan p'ooliyaa bare wonddaafiyaa tooraa giigissee.<verse eid="PSA 7:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14" />Iitatetsaa shahaareedda,</para>
  <para style="q2" vid="PSA 7:14">geniyaa shahaara shahaareeddawe, wordduwaa yelee.<verse eid="PSA 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15" />Hara asatoo ollaa bookkeedda asay</para>
  <para style="q2" vid="PSA 7:15">bare bookkeedda ollaan barew kunddee.<verse eid="PSA 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16" />I ahiyaa genii Aa huup'iyaw simmee.</para>
  <para style="q2" vid="PSA 7:16">Aa makkalaynne Aa huup'iyaw simmee.<verse eid="PSA 7:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17" />Med'inaa Godaa s'illotetsaa diraw,</para>
  <para style="q2" vid="PSA 7:17">taani Aa galatana;</para>
  <para style="q1" vid="PSA 7:17">K'ay Ubbaappe D'ok'k'iyaa Med'inaa Godaa suntsaw,</para>
  <para style="q2" vid="PSA 7:17">taani galataa yes's'ana.<verse eid="PSA 7:17" /></para>
  <chapter eid="PSA 7" />
  <chapter number="8" style="c" sid="PSA 8" />
  <para style="s">S'oossaa Anggay Med'etaa Bollan</para>
  <para style="d">Zammaaretuwaa Kaappoo Suusullatuwaan Yes'etteedda, Daawita Mazimuriyaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1" />Abeet Med'inaa Godaw, nu S'oossaw,</para>
  <para style="q2" vid="PSA 8:1">ne suntsay sa'aa ubbaa bollan ayaa bonchchetteeddeeshsha!</para>
  <para style="b" vid="PSA 8:1" />
  <para style="q1" vid="PSA 8:1">Neeni ne bonchchuwaa salotuwaappe bollan</para>
  <para style="q2" vid="PSA 8:1">d'ok'k'u d'ok'k'u ootsa wotsaadda.<verse eid="PSA 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2" />Neeni ne morkkatuwaa diraw,</para>
  <para style="q2" vid="PSA 8:2">Ne baaligaaraanne new manddiyaawaa sirp'p'i ootsanaw,</para>
  <para style="q2" vid="PSA 8:2">guutsa naanatuwaa doonaan</para>
  <para style="q2" vid="PSA 8:2">d'ammiyaa naanatuwaa doonaan galataa kuntsaadda.<note caller="-" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="MAT 21:16">Mat. 21:16</ref></char></note><verse eid="PSA 8:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3" />Neeni ne birad'd'etuwaan med'd'eedda ne salotuwaa,</para>
  <para style="q2" vid="PSA 8:3">Sa'aan sa'aan neeni wotseedda aginaanne</para>
  <para style="q2" vid="PSA 8:3">s'oolinttetuwaa taani be'iyaa wode,<verse eid="PSA 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4" />neeni asaabaa k'oppanaw Asay ayee?<note caller="-" style="x"><char style="xo" closed="false">8:4 </char><char style="xt" closed="false"><ref loc="JOB 7:17-18">Yob. 7:17-18</ref>; <ref loc="PSA 144:3">Maz. 144:3</ref>; <ref loc="HEB 2:6-8">Ibr. 2:6-8</ref></char></note></para>
  <para style="q2" vid="PSA 8:4">Woy neeni aw hirgganaw I ayee?<verse eid="PSA 8:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5" />Aa neeni S'oossaappe amareedawaa guutsaadda;</para>
  <para style="q2" vid="PSA 8:5">Bonchchuwaanne gitatetsaa kalachchaa Aa huup'iyaan wotsaadda.<verse eid="PSA 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6" />Aa neeni ne med'd'eedda med'etetsaa ubbaa bollan</para>
  <para style="q2" vid="PSA 8:6">mooddiyaawaa ootsaade suntsaadda;<note caller="-" style="x"><char style="xo" closed="false">8:6 </char><char style="xt" closed="false"><ref loc="1CO 15:27">1 K'or. 15:27</ref>; <ref loc="EPH 1:22">Efe. 1:22</ref>; <ref loc="HEB 2:8">Ibr. 2:8</ref></char></note></para>
  <para style="q2" vid="PSA 8:6">ubbabaa Aa gediyaappe garssanna wotsaadda.<verse eid="PSA 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7" />Dorssatuwaanne booratuwaa, sa'aa do'atuwaanne,<verse eid="PSA 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 8:8" />saluwaa kafotuwaa, abbaa moletuwaanne,</para>
  <para style="q2" vid="PSA 8:8">abbay goggiyaasan wad'd'iyaawantta ubbaakka</para>
  <para style="q1" vid="PSA 8:8">Aa moodissaadda.<verse eid="PSA 8:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9" />Abeet S'oossaw, nu S'oossaw, ne suntsay</para>
  <para style="q2" vid="PSA 8:9">sa'aa ubbaan ayaa bonchchetteeddeeshsha!<verse eid="PSA 8:9" /></para>
  <chapter eid="PSA 8" />
  <chapter number="9" style="c" sid="PSA 9" />
  <para style="s">Iitaa Bollan Pirddaa</para>
  <para style="d">Zammaaretuwaa Kaappoo, «Na'aa Hayk'uwaan» Yes'etteedda, Daawita Mazimuriyaa.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 9:1" />Abeet Med'inaa Godaw, taani neena ta kumentsaa wozanaappe galatana;</para>
  <para style="q1" vid="PSA 9:1">Neeni ootseedda maalalissiyaa</para>
  <para style="q2" vid="PSA 9:1">ne oosuwaa ubbaakka odana.<verse eid="PSA 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2" />Neenan nashettananne hashshu gaana.</para>
  <para style="q1" vid="PSA 9:2">Ubbaappe D'ok'k'iyaa S'oossaw,</para>
  <para style="q2" vid="PSA 9:2">taani ne suntsaw galataa yes's'ana.<verse eid="PSA 9:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3" />Ta morkketuu guyye simmiyaa wode,</para>
  <para style="q2" vid="PSA 9:3">ne sintsappe d'ubetti d'ayana.<verse eid="PSA 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4" />Neeni taw s'illo pirddaa pirddaadda;</para>
  <para style="q1" vid="PSA 9:4">Neeni s'illotetsan pirddaadde,</para>
  <para style="q2" vid="PSA 9:4">ne kawutetsaa araatan uttaadda.<verse eid="PSA 9:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5" />Neeni kawutetsaa seeraadda;</para>
  <para style="q2" vid="PSA 9:5">iitatuwaakka d'ayissaadda.</para>
  <para style="q1" vid="PSA 9:5">Neeni unttunttu suntsaa med'i med'inawukka k'uc'c'a diggaadda.<verse eid="PSA 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6" />Morkketuu med'inaa d'ayuwaa d'ayeeddino;</para>
  <para style="q2" vid="PSA 9:6">k'ay unttunttu katamatuwaa ubbaanna d'ok'olla diggaadda.</para>
  <para style="q1" vid="PSA 9:6">Unttunttu ubbaanna dogetti atteeddino.<verse eid="PSA 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7" />Shin Med'inaa Goday med'inaw kaatetiide de'ee;</para>
  <para style="q2" vid="PSA 9:7">I bare kawutetsaa araataa pirddaw giigisseedda.<verse eid="PSA 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8" />Ha sa'aa s'illotetsan pirddana;</para>
  <para style="q2" vid="PSA 9:8">asatuwaakka suuretetsaan pirddana.<verse eid="PSA 9:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9" />Med'inaa Goday un"etteeddawanttoo bak'ati attiyaawaa;</para>
  <para style="q2" vid="PSA 9:9">meto wodiyaankka geli attiyaa geessuwaa.<verse eid="PSA 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10" />Ne suntsaa eriyaawanttu neenan ammanettiino;</para>
  <para style="q2" vid="PSA 9:10">ayaw gooppe, Med'inaa Godaw, neeni neena koyiyaawantta yegga agga beykka.<verse eid="PSA 9:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11" />S'iyoone Deriyan kaateti utteedda Med'inaa Godaw galataa yes's'ite.</para>
  <para style="q2" vid="PSA 9:11">I ootseedda ubbabaakka asaa ubbaw odite.<verse eid="PSA 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12" />Ayaw gooppe, suutsaa gussiyaawanttoo</para>
  <para style="q2" vid="PSA 9:12">haluwaa kessiyaa S'oossay</para>
  <para style="q2" vid="PSA 9:12">naak'etteeddawanttu waasuwaa sheneko geena.<verse eid="PSA 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13-14" style="v" sid="PSA 9:13-14" />Abeet Med'inaa Godaw, S'iyoone asaa kariyaan taani ek'k'aade,</para>
  <para style="q2" vid="PSA 9:13-14">Ne galataa odana malanne</para>
  <para style="q2" vid="PSA 9:13-14">hewan ne atotetsaan loytsi nashettana mala,</para>
  <para style="q2" vid="PSA 9:13-14">ta morkketuu taana yederssiyaawaa be'a.</para>
  <para style="q1" vid="PSA 9:13-14">Neeni ne maarotaan, hayk'k'uwaappe taana ashsha.<verse eid="PSA 9:13-14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15" />Kawutetsatuu barenttu bookkeedda ollaan barenttoo kunddeeddino.</para>
  <para style="q2" vid="PSA 9:15">Unttunttu k'osi wotseedda p'irii unttunttu gediyaa oyk'k'eedda.<verse eid="PSA 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16" />Med'inaa Goday bare s'illo pirddan barew eretteedda;</para>
  <para style="q2" vid="PSA 9:16">iita Asay bare kushiyan ootseedda oosuwaa p'iriyaan oyk'k'etteedda.<verse eid="PSA 9:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17" />Iitatuu duufuwaa baana;</para>
  <para style="q2" vid="PSA 9:17">S'oossaa dogiyaa kawutetsatuu ubbaykka unttunttudan hanana.<verse eid="PSA 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18" />Hiyyeesay ubbaa gede dogetti attena;</para>
  <para style="q2" vid="PSA 9:18">woy metootanchchay wotseedda hidootay med'inaw d'ayenna.<verse eid="PSA 9:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19" />Abeet Med'inaa Godaw, Asay ne bolla denddiide,</para>
  <para style="q2" vid="PSA 9:19">bare wolk'k'aan c'eek'ettenna mala, neeni dendda!</para>
  <para style="q1" vid="PSA 9:19">Ne sintsan kawutetsatuwaa bolla neeni pirddaa.<verse eid="PSA 9:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20" />Abeet Med'inaa Godaw, unttuntta neeni yashissa;</para>
  <para style="q2" vid="PSA 9:20">unttunttu asaa gidiyaawaa neeni unttuntta erissa.<verse eid="PSA 9:20" /></para>
  <chapter eid="PSA 9" />
  <chapter number="10" style="c" sid="PSA 10" />
  <para style="s">Pirddaa Demanaw Shiik'eedda Woosaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1" />Abeet Med'inaa Godaw, ayaw haakkaade ek'k'ay?</para>
  <para style="q2" vid="PSA 10:1">Metuwaa wodiyaan ayaw neeni geemmay?<verse eid="PSA 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2" />Bare otoruwaan iita Asay hiyyeesaa shankkatee.</para>
  <para style="q2" vid="PSA 10:2">Unttunttu barenttu pala mak'k'uwaan barenttoo oyk'k'ettino.<verse eid="PSA 10:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3" />He iitay bare wozanaa iita amuwaan c'eek'ettee;</para>
  <para style="q2" vid="PSA 10:3">yoranchchay Med'inaa Godaa bolla iita k'aalaa haasayeenne kaddee.<verse eid="PSA 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4" />Iitay bare otoruwaan S'oossaa koyenna;</para>
  <para style="q2" vid="PSA 10:4">bare k'ofa ubbankka S'oossaa ayinne koyenna.<verse eid="PSA 10:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5" />Ubbabay aw ubbaa wodekka kumee;</para>
  <para style="q2" vid="PSA 10:5">I otoruwaa p'ees's'alee.</para>
  <para style="q1" vid="PSA 10:5">Ne higgii aw gelenna;</para>
  <para style="q2" vid="PSA 10:5">bare morkkatuwaa bollan I k'iliic'ee.<verse eid="PSA 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6" />Bare wozanaan I, «Taana ayaynne k'aatsenna.</para>
  <para style="q2" vid="PSA 10:6">Taana ubbakka metuu gakkenna» yaagiide k'oppee.<verse eid="PSA 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7" />Aa doonaan shek'ay,</para>
  <para style="q2" vid="PSA 10:7">wordduunne manddetsay kumeedda.<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="ROM 3:14">Rom. 3:14</ref></char></note></para>
  <para style="q1" vid="PSA 10:7">Bare ins's'arssan genebaanne iitabaa haasayanaw elleellee.<verse eid="PSA 10:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8" />Heeraan k'osettiyaasan I zuggiide uttee.</para>
  <para style="q2" vid="PSA 10:8">Bare wod'iyaawaa wod'anaw k'osetti naagiidde,</para>
  <para style="q2" vid="PSA 10:8">wolk'k'ay bayinna ashkketuwaa s'eellee.<verse eid="PSA 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 10:9" />Bare k'osettiyaasan geemmiide,</para>
  <para style="q2" vid="PSA 10:9">hiyyeesaa oyk'k'anaw gaammuwaadan zuggee.</para>
  <para style="q1" vid="PSA 10:9">I hiyyeesaa oyk'k'iide, bare p'iriyaan goochchiide afee.<verse eid="PSA 10:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10" />Yaatina, wolk'k'ay bayinna hiyyeesay shoc'etee;</para>
  <para style="q2" vid="PSA 10:10">nippi geenne he minuwaan s'oonettee.<verse eid="PSA 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11" />I bare wozanaan, «S'oossay taana dogi kichcheedda.</para>
  <para style="q2" vid="PSA 10:11">Bare som"uwaa taappe gentsi kichcheedda;</para>
  <para style="q2" vid="PSA 10:11">ubbakka I be'enna» yaagee.<verse eid="PSA 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12" />Abeet Med'inaa Godaw, dendda.</para>
  <para style="q2" vid="PSA 10:12">S'oossaw, ne kushiyaa d'ok'k'u ootsaade dentsa;</para>
  <para style="q2" vid="PSA 10:12">hiyyeesaa dogoppa.<verse eid="PSA 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13" />Nagaranchcha uray bare wozanaan,</para>
  <para style="q2" vid="PSA 10:13">S'oossaa ayaw kad'ii?</para>
  <para style="q1" vid="PSA 10:13">Bare k'ofankka, «S'oossay taana murena»</para>
  <para style="q2" vid="PSA 10:13">ayaw yaagii?<verse eid="PSA 10:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14" />Shin S'oossaw, neeni tumukka be'aasa;</para>
  <para style="q2" vid="PSA 10:14">metuwaakka waayiyaakka s'eellaasa.</para>
  <para style="q1" vid="PSA 10:14">Neeni ubbaa wode nuuna maaddanaw giiga uttaadda.</para>
  <para style="q2" vid="PSA 10:14">Yii'atoo neeni maaduwaa.</para>
  <para style="q1" vid="PSA 10:14">K'ohetteeddawe neeni maaddanaadan barena new sheed'd'e.<verse eid="PSA 10:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15" />Geniyaawanttu wolk'k'aa neeni wurssa;</para>
  <para style="q2" vid="PSA 10:15">Iita asatuwaakka hewaadda ootsa.</para>
  <para style="q1" vid="PSA 10:15">Laa"entso unttunttu giddon iitatetsay beettena mala unttuntta mura.<verse eid="PSA 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16" />Med'inaa Goday med'i med'inaw kaatetiide de'ee;</para>
  <para style="q2" vid="PSA 10:16">hara kawutetsatuu Aa biittaappe d'ayana.<verse eid="PSA 10:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17" />Abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 10:17">neeni barentta kawushshiyaawanttu amuwaa sisaasa.</para>
  <para style="q1" vid="PSA 10:17">Neeni unttuntta mintsetsaasa.<verse eid="PSA 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18" />Yi'atoone un"etteeddawanttoo tumuwaa pirddaa;</para>
  <para style="q2" vid="PSA 10:18">sa'aan de'iyaa asay, unttuntta yashissenna mala,</para>
  <para style="q1" vid="PSA 10:18">Unttunttu waasuwaa sisaasa.<verse eid="PSA 10:18" /></para>
  <chapter eid="PSA 10" />
  <chapter number="11" style="c" sid="PSA 11" />
  <para style="s">S'illotuwaa C'eek'uwaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Daawita Mazimuriyaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 11:1" />Taani Med'inaa Godaa giddon bak'ata k'osetta attay.</para>
  <para style="q2" vid="PSA 11:1">Yaatina, hintte taana ayaw,</para>
  <para style="q2" vid="PSA 11:1">«Kafuwaadan ne deriyaa bak'ata» yaagiitee?<verse eid="PSA 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2" />Hekko nagaranchchatuu,</para>
  <para style="q2" vid="PSA 11:2">wozanaa geeshshatuwaa d'uman c'addanaw,</para>
  <para style="q2" vid="PSA 11:2">barenttu wonddaafiyaa bak'etsaa bollan pootsaa toliino.<verse eid="PSA 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3" />Baasuu bayiyaa wode,</para>
  <para style="q2" vid="PSA 11:3">s'illuu ayaa ootsanaw danddayii?<verse eid="PSA 11:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4" />Med'inaa Goday bare Geeshsha sa'aan de'ee;</para>
  <para style="q2" vid="PSA 11:4">bare saluwaa kawutetsaa araatan,</para>
  <para style="q1" vid="PSA 11:4">Med'inaa Goday asaa s'eellee;</para>
  <para style="q2" vid="PSA 11:4">S'oossaa ayifii asaa biddee.<verse eid="PSA 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5" />Med'inaa Goday s'illuwaa biddee.</para>
  <para style="q2" vid="PSA 11:5">Shin iitatuwaanne kobabaa siik'iyaawantta</para>
  <para style="q1" vid="PSA 11:5">I loytsi is's'ee.<verse eid="PSA 11:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6" />S'oossay iitatuwaa bollan ees's'iyaa tamaa bonk'k'uwaanne</para>
  <para style="q2" vid="PSA 11:6">ees's'iyaa diiniyaa bukissana.</para>
  <para style="q1" vid="PSA 11:6">D'ayssiyaa gotiyaa c'arkkuwaan unttuntta murana.<verse eid="PSA 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7" />Med'inaa Goday s'illo gideedda diraw,</para>
  <para style="q2" vid="PSA 11:7">s'illotetsaa dosee.</para>
  <para style="q1" vid="PSA 11:7">Suure asatuu Aa sintsa be'ana.<verse eid="PSA 11:7" /></para>
  <chapter eid="PSA 11" />
  <chapter number="12" style="c" sid="PSA 12" />
  <para style="s">Iita Alamiyaappe Attanaw Shiik'eedda Woosaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Diitsaan Yes'etteedda, Daawita Mazimuriyaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 12:1" />Med'inaa Godaw, nuuna maaddaarikkii?</para>
  <para style="q2" vid="PSA 12:1">Ayaw gooppe, S'oossaa Asay ubbakka baawa;</para>
  <para style="q2" vid="PSA 12:1">asaa giddon ammanettiyaawe d'ayikichcheedda.<verse eid="PSA 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2" />Ubbaa wodekka ittuu ittoo wordduwaa haasayiino;</para>
  <para style="q2" vid="PSA 12:2">ittuu ittuwaa sheleeshshiyaa ins's'arssan baletsuwaan haasayiino.<verse eid="PSA 12:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3" />Abeet Med'inaa Godaw, ha sheleeshshiyaa doonaa bara.</para>
  <para style="q2" vid="PSA 12:3">Otoruwaan c'eek'ettiyaa ins's'arssaa ubbaa neeni c'igga olaa.<verse eid="PSA 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4" />Unttunttu, «Nuuni nu ins's'arssan s'oonana;</para>
  <para style="q2" vid="PSA 12:4">nu mettershay nuwaa; nu goday oonee?» yaagiino.<verse eid="PSA 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5" />Med'inaa Goday, «Hiyyeesatuu un"etteedda dirawunne,</para>
  <para style="q2" vid="PSA 12:5">Metootanchchatuwaa ooliyaa diraw,</para>
  <para style="q2" vid="PSA 12:5">ha"i taani denddana.</para>
  <para style="q2" vid="PSA 12:5">Taani unttunttu amottiyaa sarotetsaan unttuntta wotsana» yaagee.<verse eid="PSA 12:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6" />S'oossaa k'aalatuu walakki bayinna geeshshatuwaa;</para>
  <para style="q2" vid="PSA 12:6">c'ooc'iyaa taman laappun gede tigetteedda biraadan geeyyeeddawantta.<verse eid="PSA 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7" />Abeet Med'inaa Godaw, neeni unttuntta sarotetsaan naaganne</para>
  <para style="q2" vid="PSA 12:7">hawaa mala asaappe med'inaw unttuntta ashsha.<verse eid="PSA 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8" />Asaa gidduwaan iitay bonchchetteedda wode,</para>
  <para style="q2" vid="PSA 12:8">iitatuu ubbaa saanna simeretteeddino.<verse eid="PSA 12:8" /></para>
  <chapter eid="PSA 12" />
  <chapter number="13" style="c" sid="PSA 13" />
  <para style="s">Bare S'oossan Amaneteedda Asaa Woosaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Daawita Mazimuriyaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1" />Abeet Med'inaa Godaw, awude gakkanaw neeni taana dogay?</para>
  <para style="q2" vid="PSA 13:1">Med'inaw taana dogay?</para>
  <para style="q2" vid="PSA 13:1">Awude gakkanaw neeni taappe geemmayi?<verse eid="PSA 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2" />Taani ta k'ofaanna baas'etiyaawe</para>
  <para style="q2" vid="PSA 13:2">awude gakkanaassee?</para>
  <para style="q1" vid="PSA 13:2">Ubbaa gallassi kayyuu ta wozanaan de'anawe</para>
  <para style="q2" vid="PSA 13:2">awude gakkanaassee?</para>
  <para style="q1" vid="PSA 13:2">Ta morkketuu ta bolla goobanawe</para>
  <para style="q2" vid="PSA 13:2">awude gakkanaassee?<verse eid="PSA 13:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3" />Med'inaa Godaw ta S'oossaw, haa taakko s'eellaade,</para>
  <para style="q2" vid="PSA 13:3">taw zaara.</para>
  <para style="q1" vid="PSA 13:3">Ta ayifiyaa poo'issaade,</para>
  <para style="q2" vid="PSA 13:3">hayk'k'uwaappe taana ashsha.<verse eid="PSA 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4" />«Nuuni Aa s'ooneeddo» yaagiide,</para>
  <para style="q2" vid="PSA 13:4">ta morkketuu c'eek'ettennaadan te"a.</para>
  <para style="q1" vid="PSA 13:4">Ta kunddetsan unttunttu nashettenaadan digga.<verse eid="PSA 13:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5" />Shin aggena ne maarotaan taani ammanettay;</para>
  <para style="q2" vid="PSA 13:5">neeni taana ashshiyaa diraw, taani nashettay.<verse eid="PSA 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6" />Med'inaa Godaw, taani new yes's'ana;</para>
  <para style="q2" vid="PSA 13:6">ayaw gooppe, neeni taw keekkaadda.<verse eid="PSA 13:6" /></para>
  <chapter eid="PSA 13" />
  <chapter number="14" style="c" sid="PSA 14" />
  <para style="s">S'oossay Bayna Asatuwaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Daawita Mazimuriyaa.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 14:1" />Eeyyatuu barenttu wozanaan,<note caller="-" style="x"><char style="xo" closed="false">14:1-3 </char><char style="xt" closed="false"><ref loc="ROM 3:10-12">Rom. 3:10-12</ref></char></note> «S'oossay baawa» yaagiino.</para>
  <para style="q1" vid="PSA 14:1">Unttunttu de'uu bayeedda.</para>
  <para style="q2" vid="PSA 14:1">Unttunttu sheneyiyaawaa ootsiino;</para>
  <para style="q2" vid="PSA 14:1">lo"iyaawaa ootsiyaa Asay baawa.<verse eid="PSA 14:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2" />S'oossaa koyiyaa eranchchatuu de'inttonne</para>
  <para style="q2" vid="PSA 14:2">be'anaw, Med'inaa Goday saluwaappe duge asaa s'eellee.<verse eid="PSA 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3" />Shin ubbaykka wora simmeeddino;</para>
  <para style="q2" vid="PSA 14:3">ubbaykka ubbaanna go"ennabaa gideeddino.</para>
  <para style="q1" vid="PSA 14:3">Lo"iyaawaa ootsiyaa ooninne baawa;</para>
  <para style="q2" vid="PSA 14:3">haray atto ittuunne baawa.<verse eid="PSA 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4" />Med'inaa Goday, «Hawanttu ta asaa,</para>
  <para style="q2" vid="PSA 14:4">asay k'umaa miyaawaadan bonk'k'i miino.</para>
  <para style="q1" vid="PSA 14:4">Iita asatuu tumu ayaanne akeekikkino?</para>
  <para style="q2" vid="PSA 14:4">Unttunttu taana woossikkino» yaageedda.<verse eid="PSA 14:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5" />Shin S'oossay s'illo asatuwaana de'iyaa diraw,</para>
  <para style="q2" vid="PSA 14:5">iitatuu hewan dagamana.<verse eid="PSA 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6" />Unttunttu hiyyeesatuwaa k'ofaa halissiino;</para>
  <para style="q2" vid="PSA 14:6">shin Med'inaa Goday hiyyeesatuu bak'atiide, k'osetti attiyaa sa'aa.<verse eid="PSA 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7" />Israa'eeliyaw atotetsay S'iyooneppe yeerennee!</para>
  <para style="q2" vid="PSA 14:7">Med'inaa Goday unttunttu de'uwaa zaariyaa wode,</para>
  <para style="q1" vid="PSA 14:7">Yaak'ooba zeretsay nashettana;</para>
  <para style="q2" vid="PSA 14:7">Israa'eeliyaa Asay nashshechchaa pooc'u gaana.<verse eid="PSA 14:7" /></para>
  <chapter eid="PSA 14" />
  <chapter number="15" style="c" sid="PSA 15" />
  <para style="s">S'oossay Asaappe Koyiyaawe Ayee?</para>
  <para style="d">Daawita mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1" />Abeet S'oossaw, ne dunkkaaniyaan gam"anawe oonee?</para>
  <para style="q2" vid="PSA 15:1">Ne geeshsha deriyaan neenana de'anawe oonee?<verse eid="PSA 15:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2" />Suure de'uwaa de'iyaawaa,</para>
  <para style="q2" vid="PSA 15:2">S'illobaa ootsiyaawaa,</para>
  <para style="q2" vid="PSA 15:2">bare wozanaappe tumuwaa haasayiyaawaa,<verse eid="PSA 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 15:3" />hara asaa suntsaa bayzzenawaa,</para>
  <para style="q2" vid="PSA 15:3">Bare laggiyaa bolla iitabaa ootsennawaa,</para>
  <para style="q2" vid="PSA 15:3">bare shooruwaa zigirennawaa;<verse eid="PSA 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4" />Med'inaa Godaan is's'etteedda asatuwaa kad'iyaawe,</para>
  <para style="q2" vid="PSA 15:4">Shin S'oossaw yayyiyaa asatuwaa bonchchiyaawe,</para>
  <para style="q2" vid="PSA 15:4">bare c'aak'k'eeddawaa ayaa dees'inakka poliyaawe,<verse eid="PSA 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5" />bare miishshaa dichchaw immennawe,</para>
  <para style="q2" vid="PSA 15:5">S'illo asatuwaa k'ohanaw</para>
  <para style="q2" vid="PSA 15:5">mattaayiyaa akkenawe.</para>
  <para style="b" vid="PSA 15:5" />
  <para style="q2" vid="PSA 15:5">Ha yewotuwaa ootsiyaawe,</para>
  <para style="q2" vid="PSA 15:5">med'inawukka k'aas's'enna.<verse eid="PSA 15:5" /></para>
  <chapter eid="PSA 15" />
  <chapter number="16" style="c" sid="PSA 16" />
  <para style="s">S'oossay Ta Laataa</para>
  <para style="d">Daawita woosaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1" />Abeet S'oossaw,</para>
  <para style="q2" vid="PSA 16:1">taani neekko bak'ateedda diraw, taana naaga.<verse eid="PSA 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2" />Taani Med'inaa Godaw, «Neeni ta Godaa;</para>
  <para style="q2" vid="PSA 16:2">Neeppe attin, hara lo"uu taw baawa» yaagay.<verse eid="PSA 16:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3" />Sa'aan de'iyaa geeshshatuu</para>
  <para style="q2" vid="PSA 16:3">ay mala galatetteeddino!</para>
  <para style="q1" vid="PSA 16:3">Ta nashechchay ubbay unttunttunna ittippe gidiyaawaa.<verse eid="PSA 16:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4" />Worddo s'oossatuwaa kaalliyaawanttu</para>
  <para style="q2" vid="PSA 16:4">barenttu bolla metuwaa darissiino.</para>
  <para style="q1" vid="PSA 16:4">Shin taani unttunttu worddo s'oossatoo yarshshikke;</para>
  <para style="q2" vid="PSA 16:4">taani unttunttu suntsaa s'eesikke.<verse eid="PSA 16:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5" />Ta Med'inaa Godaw, ta de'uwaa laataynne s'uu'ay neena;</para>
  <para style="q2" vid="PSA 16:5">taana koshshiyaa ubbaa neeni taw immaasa.</para>
  <para style="q1" vid="PSA 16:5">Ta de'uwaa saamay neena.<verse eid="PSA 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6" />Neeni taw wad'd'eedda saamay ay keeshshaa lo"ee!</para>
  <para style="q2" vid="PSA 16:6">Ee ta laatay tumuwaappe lo"a!<verse eid="PSA 16:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7" />Taana zoriyaa Med'inaa Godaa galatay;</para>
  <para style="q2" vid="PSA 16:7">bilahekka ta wozanay taana seeree.<verse eid="PSA 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8" />Taani ubbaa gede Med'inaa Godaa taappe sintsayay<note caller="-" style="x"><char style="xo" closed="false">16:8-11 </char><char style="xt" closed="false"><ref loc="ACT 2:25-28">Kit. 2:25-28</ref></char></note></para>
  <para style="q2" vid="PSA 16:8">I taappe ushechcha baggana de'iyaa diraw,</para>
  <para style="q2" vid="PSA 16:8">taani hirggikke.<verse eid="PSA 16:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9" />Hewaa diraw, ta wozanay nashettee;</para>
  <para style="q2" vid="PSA 16:9">ta shemppuukka hashshu gee.</para>
  <para style="q1" vid="PSA 16:9">Ta bollaykka hirggi bayinnan de'ee.<verse eid="PSA 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10" />Taana Si'ooliyaw aatsaade immakka;<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="ACT 13:35">Kit. 13:35</ref></char></note></para>
  <para style="q2" vid="PSA 16:10">neeni ne geeshsha musissakka.<verse eid="PSA 16:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11" />Neeni taana de'uwaa ogiyaa bessaasa.</para>
  <para style="q2" vid="PSA 16:11">Taani ne matan de'ina, ta nashechchay polettee;</para>
  <para style="q2" vid="PSA 16:11">ne ushechcha baggana injjii med'inaw de'ee.<verse eid="PSA 16:11" /></para>
  <chapter eid="PSA 16" />
  <chapter number="17" style="c" sid="PSA 17" />
  <para style="s">Geeshsha Asaa Woosaa</para>
  <para style="d">Daawita woosaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 17:1" />Abeet Med'inaa Godaw, ta s'illo oochchiyaawaa sisa;</para>
  <para style="q2" vid="PSA 17:1">ta waasuwaa hayzza.</para>
  <para style="q2" vid="PSA 17:1">Taani c'immenna ins's'arssaappe woossiyaa woosaakko,</para>
  <para style="q2" vid="PSA 17:1">ne haytsaa zaara.<verse eid="PSA 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2" />Ta shatintsay ne sintsappe yo;</para>
  <para style="q2" vid="PSA 17:2">ne ayifii likke gidiyaawaa s'eello.<verse eid="PSA 17:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3" />Neeni k'amman taana s'omoosaadda;</para>
  <para style="q2" vid="PSA 17:3">ta wozanaa paac'c'aadda.</para>
  <para style="q1" vid="PSA 17:3">Shin ta bollappe ayinekka demmakka.</para>
  <para style="q2" vid="PSA 17:3">Ta ins's'arssaykka balettibeena.<verse eid="PSA 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4" />Taani hara asatuwaadan iita k'aalaa haasayikke;</para>
  <para style="q2" vid="PSA 17:4">taani ne azazuwaa naagiyaa diraw, gene ogiyaa kaallabeykke.<verse eid="PSA 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5" />Ta gedii d'ubettenna mala,</para>
  <para style="q2" vid="PSA 17:5">ta tangguu ne ogiyaappe gas'aa kesibeenna.<verse eid="PSA 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6" />Abeet S'oossaw, neeni sisiyaa diraw,</para>
  <para style="q2" vid="PSA 17:6">taani neena woossay.</para>
  <para style="q1" vid="PSA 17:6">Ne haytsaa taakko zaaraadde,</para>
  <para style="q2" vid="PSA 17:6">taani new odiyaawaa hayzza.<verse eid="PSA 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7" />Barenttu morkkatuwaappe bak'atiyaawantta</para>
  <para style="q2" vid="PSA 17:7">ne ushechcha kushiyan k'osaade ashshiyaawoo,</para>
  <para style="q2" vid="PSA 17:7">ne lo"otetsaa maalalissiyaa ogiyaan bessa.<verse eid="PSA 17:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8" />Ne ayifiyaa c'iruwaadan taana naaga;</para>
  <para style="q2" vid="PSA 17:8">ne k'efiyaa giddon taana k'osa.<verse eid="PSA 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9" />Taana un"i wotseedda iitatuwaappenne</para>
  <para style="q2" vid="PSA 17:9">dooddi wotseedda s'ala morkkatuwaa kushiyaappe</para>
  <para style="q2" vid="PSA 17:9">taana k'osa.<verse eid="PSA 17:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10" />Unttunttoo k'areti baawa;</para>
  <para style="q2" vid="PSA 17:10">otoruwaan haasayiino.<verse eid="PSA 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11" />Taani biyaasa'aa ubbaan unttunttu taana dooddiino.</para>
  <para style="q2" vid="PSA 17:11">Taana biittan aatsi yegganaw s'eelliino.<verse eid="PSA 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12" />Unttunttu barenttoo miyaawaa koyiyaa gaammotuwaa mala;</para>
  <para style="q2" vid="PSA 17:12">geeman zuggi naagiyaa wodalla gaammotuwaa mala.<verse eid="PSA 17:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13" />Abeet Med'inaa Godaw, dendda.</para>
  <para style="q2" vid="PSA 17:13">Ta morkkatuwaanna ek'ettaade s'oona;</para>
  <para style="q2" vid="PSA 17:13">ne mashshaan iitatuwaappe taana ashsha akka.<verse eid="PSA 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14" />Abeet Med'inaa Godaw, hawaa mala asaappe,</para>
  <para style="q2" vid="PSA 17:14">Unttunttu kaac'ay ha sa'aa de'uwaa s'alala gidiyaa asaappe</para>
  <para style="q2" vid="PSA 17:14">ne kushiyan taana ashsha.</para>
  <para style="q2" vid="PSA 17:14">Neeni unttunttoo minjjeedda boshaan unttuntta mura;</para>
  <para style="q2" vid="PSA 17:14">he boshaynne unttunttu naanaatoo gidiide,</para>
  <para style="q2" vid="PSA 17:14">unttunttu naanatuwaa naanatookka palaho.<verse eid="PSA 17:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15" />Shin taani s'illotetsan ne som"iyaa be'ana.</para>
  <para style="q2" vid="PSA 17:15">Taani denddiyaa wode, ne mala be'aade nashettana.<verse eid="PSA 17:15" /></para>
  <chapter eid="PSA 17" />
  <chapter number="18" style="c" sid="PSA 18" />
  <para style="s">S'oonuwaa Mazimuriyaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda Daawita Mazimuriyaa. Med'inaa Goday Aa Morkkiyaappenne Saa'oola Kushiyaappe Ashsheeda Wode Daawite Med'inaa Godaw Ha Yetsaa Yes's'eedda</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 18:1" />Abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 18:1">ta wolk'k'aw, taani neena siik'ay.<verse eid="PSA 18:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2" />Med'inaa Goday taw wogga zaallaa;</para>
  <para style="q2" vid="PSA 18:2">Taani olaappe naagettiyaa miis'aa;</para>
  <para style="q1" vid="PSA 18:2">I taana ashshiyaawaa.</para>
  <para style="q2" vid="PSA 18:2">Ta S'oossay taani aakko bak'atiyaa ta wogga zaallaa.</para>
  <para style="q1" vid="PSA 18:2">I ta gonddalliyaa; I taana ashshiyaa wolk'k'aa;</para>
  <para style="q2" vid="PSA 18:2">I taani k'osetta attiyaa sa'aa.<verse eid="PSA 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3" />Galatay bessiyaa Med'inaa Godaa taani s'eesay;</para>
  <para style="q2" vid="PSA 18:3">I ta morkkatuwaappe taana ashshee.<verse eid="PSA 18:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4" />Hayk'uwaa wodoruu taana k'achcheeda;</para>
  <para style="q2" vid="PSA 18:4">bashshay di'uwaadan taana dagantseedda.<verse eid="PSA 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5" />Duufuwaa wodoruu taana k'achcheedda;</para>
  <para style="q2" vid="PSA 18:5">hayk'k'uu p'iriyaadan taana oyk'k'eedda.<verse eid="PSA 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6" />Taana metuu iissina, Med'inaa Godaa s'eesaad;</para>
  <para style="q2" vid="PSA 18:6">«Taana maadda» gaade ta S'oossaw waassaad.</para>
  <para style="q1" vid="PSA 18:6">I bare Geeshsha Sa'aan ta kooshshaa siseedda;</para>
  <para style="q2" vid="PSA 18:6">taani waasseedda waasuu Aa haytsaan wod'd'eedda.<verse eid="PSA 18:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7" />Wod'd'ina S'oossay hank'k'etteedda diraw,</para>
  <para style="q2" vid="PSA 18:7">Biittay yiik'k'iyiik'k'iide k'aas's'eedda;</para>
  <para style="q2" vid="PSA 18:7">deretuwaa s'ap'uu gaji gajiide kokkoreedda.<verse eid="PSA 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8" />Aa siid'iyaappe hank'k'uwaa c'uway c'uwatteedda;</para>
  <para style="q2" vid="PSA 18:8">Aa doonaappe miyaa tamaa lac'uunne s'uuggiyaa bonk'k'uu keseedda.<verse eid="PSA 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9" />Saluwaa I p'alk'k'iide, duge wod'd'eedda;</para>
  <para style="q2" vid="PSA 18:9">he wode Aa gediyaappe garssaana sik'imeteedda shaarii de'ee.<verse eid="PSA 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10" />K'efiyaana de'iyaa kiitanchchaa kiruubiyan uttiide paalleedda;</para>
  <para style="q2" vid="PSA 18:10">c'arkkuwaa k'efiyaa akkiide elleelleedda.<verse eid="PSA 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11" />Barena d'uman kammeedda;</para>
  <para style="q2" vid="PSA 18:11">Aa dunkkaanii iraanna sik'imeteedda shaariyaa.<verse eid="PSA 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12" />Aa sintsan de'iyaa wolk'k'aama poo'uwaappe</para>
  <para style="q2" vid="PSA 18:12">shachchaynne tamaa lac'uu keseedda;</para>
  <para style="q1" vid="PSA 18:12">Kesiide sik'imeteedda shaariyaa aad'd'iidde beedda.<verse eid="PSA 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13" />K'ay Med'inaa Goday guuguntsaadan saluwaappe guummeedda;</para>
  <para style="q2" vid="PSA 18:13">Ubbaappe D'ok'k'iyaa S'oossay walk'k'antsaaninne tamaa lac'uwaan k'onc'c'eedda.<verse eid="PSA 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14" />Bare wonddaafiyaa c'ubiyaa yeddiide,</para>
  <para style="q2" vid="PSA 18:14">Bare morkkatuwaa laaleedda;</para>
  <para style="q2" vid="PSA 18:14">walk'k'antsaa poo'uwaa kiittiide, unttuntta yedersseedda.<verse eid="PSA 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15" />Abeet Med'inaa Godaw, neeni seereedda wodenne,</para>
  <para style="q2" vid="PSA 18:15">Hank'k'ettaade peenuk'eedda wode,</para>
  <para style="q2" vid="PSA 18:15">abbaa haatsay giseedda biittay beetteedda.</para>
  <para style="q2" vid="PSA 18:15">K'ay sa'aa baasuukka k'onc'c'eedda.<verse eid="PSA 18:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16" />S'oossay bollappe kushiyaa duge yeddiide,</para>
  <para style="q2" vid="PSA 18:16">taana oyk'k'eedda;</para>
  <para style="q2" vid="PSA 18:16">c'iimmo haatsaappe taana kesseedda.<verse eid="PSA 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17" />I taana ta wolk'k'aama morkkiyaappenne,</para>
  <para style="q2" vid="PSA 18:17">taana is's'iyaawanttuppe ashsheeda.</para>
  <para style="q1" vid="PSA 18:17">Ayaw gooppe, unttunttu taw loytsi daro wolk'k'aama.<verse eid="PSA 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18" />Ta waayiyaa gallassi unttunttu ta bolla denddeeddino;</para>
  <para style="q2" vid="PSA 18:18">shin Med'inaa Goday taana zemppissiyaawaa.<verse eid="PSA 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19" />I taana aakko sa'aa kesseedda;</para>
  <para style="q2" vid="PSA 18:19">taanan nashetteedda diraw, taana ashsheeda.<verse eid="PSA 18:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20" />Ta s'illotetsaadan Med'inaa Goday taw c'iggeedda;</para>
  <para style="q2" vid="PSA 18:20">ta kushiyaa geeshshatetsaadan I taw zaareedda.<verse eid="PSA 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21" />Taani Med'inaa Godaa ogiyaa kaalaad;</para>
  <para style="q2" vid="PSA 18:21">taani ta S'oossaa aggade wora babeykke.<verse eid="PSA 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22" />Taani Aa higgiyaa ubbaa naagaad;</para>
  <para style="q2" vid="PSA 18:22">Aa wogaa poliyaawaa aggabeyikke.<verse eid="PSA 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23" />Taani Aa sintsan suure de'aaddi;</para>
  <para style="q2" vid="PSA 18:23">taani taana nagaraappe naagaad.<verse eid="PSA 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24" />Hewaa diraw, Med'inaa Goday taw ta s'illotetsaadaaninne</para>
  <para style="q2" vid="PSA 18:24">ta kushii Aa sintsan geeshsha gidiyaawaadan zaareedda.<verse eid="PSA 18:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25" />Abeet S'oossaw, ammanettiyaawanttoo neeni ammanettiyaawaa;</para>
  <para style="q2" vid="PSA 18:25">suuretoo neenikka suure.<verse eid="PSA 18:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26" />Geeshshatoo neenikka geeshsha;</para>
  <para style="q2" vid="PSA 18:26">shin geellatoo neeni c'inc'c'a.<verse eid="PSA 18:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27" />Barentta hokisiyaawantta ashshaasa;</para>
  <para style="q2" vid="PSA 18:27">shin barentta d'ok'k'issiyaawantta neeni zik'k'issaasa.<verse eid="PSA 18:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28" />Abeet Med'inaa Godaw, neeni ta s'omppiyaa poo'issaasa;</para>
  <para style="q2" vid="PSA 18:28">ta S'oossay poo'issina, ta d'umay kichchee.<verse eid="PSA 18:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29" />Ne maaduwaan taani ta morkke wotaadaratuwaa olay;</para>
  <para style="q2" vid="PSA 18:29">ta S'oossan taani unttunttu miis'aa s'eeraana guppa aad'd'ay.<verse eid="PSA 18:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30" />S'oossaa ogii suure.</para>
  <para style="q2" vid="PSA 18:30">Med'inaa Godaa k'aalay geeshsha.</para>
  <para style="q1" vid="PSA 18:30">Aakko bak'atiyaa ubbatoo I gonddalle.<verse eid="PSA 18:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31" />S'oossaappe attina, hara Med'inaa Goday baawa;</para>
  <para style="q2" vid="PSA 18:31">nu S'oossaappe attina, hara wogga zaalli baawa.<verse eid="PSA 18:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32" />Taw wolk'k'aa immiyaawenne</para>
  <para style="q2" vid="PSA 18:32">ta ogiyaa saro ootsiyaawe S'oossaattennee.<verse eid="PSA 18:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33" />I ta gediyaa gen"iyaa gediyaadan minisee;<note caller="-" style="x"><char style="xo" closed="false">18:33 </char><char style="xt" closed="false"><ref loc="HAB 3:19">Imb. 3:19</ref></char></note></para>
  <para style="q2" vid="PSA 18:33">taana d'ok'k'a sa'atuwaan sarotetsaan wotsee.<verse eid="PSA 18:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34" />I ta kushiyaa olaa meezeyee;</para>
  <para style="q2" vid="PSA 18:34">Hewaa diraw, taani ta k'esiyaan</para>
  <para style="q2" vid="PSA 18:34">naasiyaa giyaa birataa wonddaafiyaa dafaade dukkay.<verse eid="PSA 18:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35" />Taana ashshiyaa ne gonddalliyaa neeni taw immaadda.</para>
  <para style="q2" vid="PSA 18:35">Ne ushechcha kushii taana zemppissee;</para>
  <para style="q2" vid="PSA 18:35">ne lo"o oytsay taana d'ok'k'isee.<verse eid="PSA 18:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36" />Ta hamettiyaasaa aassaasa;</para>
  <para style="q2" vid="PSA 18:36">hewaa diraw, ta gedii halis's'ibeena.<verse eid="PSA 18:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37" />Ta morkkatuwaa taani yederssa oyk'k'aad;</para>
  <para style="q2" vid="PSA 18:37">taani unttuntta d'ayissennan de'aadde guyye simmabeykke.<verse eid="PSA 18:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38" />Taani unttuntta laa"entso denddennaadan shoc'aad;</para>
  <para style="q2" vid="PSA 18:38">unttunttu ta gediyaan kunddeeddino.<verse eid="PSA 18:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39" />Olaw taana wolk'k'aa danc'c'isaadda;</para>
  <para style="q2" vid="PSA 18:39">taananna gaaddatiyaawantta taw gulbbatissaadda.<verse eid="PSA 18:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40" />Ta morkkatuwaa ta sintsappe guyye bak'atissaada;</para>
  <para style="q2" vid="PSA 18:40">taana is's'iyaawantta taani d'ayissaad.<verse eid="PSA 18:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41" />Barentta maaddana mala waasseeddino,</para>
  <para style="q2" vid="PSA 18:41">shin ooninne unttuntta ashshibeenna.</para>
  <para style="q1" vid="PSA 18:41">Med'inaa Godaakka unttunttu s'eeseeddino,</para>
  <para style="q2" vid="PSA 18:41">shin I unttunttoo koyibeenna.<verse eid="PSA 18:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42" />C'arkkuu pittiide afiyaa baanaadan taani unttuntta liik'issaad;</para>
  <para style="q2" vid="PSA 18:42">ogiyaan de'iyaa urk'k'aadankka unttuntta yed'd'aad.<verse eid="PSA 18:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43" />Makkala asaappe taana ashshaadda.</para>
  <para style="q2" vid="PSA 18:43">Taana kawutetsatuwaa bollan suntsaadda;</para>
  <para style="q2" vid="PSA 18:43">taani erenna Asay taw moodeteedda.<verse eid="PSA 18:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 18:44" />Unttunttu ta woriyaa sisiide, taw azazettiino;</para>
  <para style="q2" vid="PSA 18:44">allaga dere asaykka ta sintsan hokkiino.<verse eid="PSA 18:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45" />Unttunttu wozanaa kahaa aggiino.</para>
  <para style="q2" vid="PSA 18:45">Barenttu naagettiyaa miis'aappe kokkoriidde yiino.<verse eid="PSA 18:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46" />Med'inaa Goday de'ee!</para>
  <para style="q2" vid="PSA 18:46">S'oossay, ta wogga zaallay galatetto!</para>
  <para style="q1" vid="PSA 18:46">Taana ashshiyaa S'oossay d'ok'k'u d'ok'k'u go!<verse eid="PSA 18:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47" />I ta haluwaa kessiyaa S'oossaa;</para>
  <para style="q2" vid="PSA 18:47">kawutetsatuwaa taappe garssaana moodissiyaawaa;<verse eid="PSA 18:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 18:48" />ta morkkatuwaappe taana ashshiyaawaa.</para>
  <para style="q2" vid="PSA 18:48">Abeet S'oossaw, neeni taananna gaaddatiyaawanttu bollan</para>
  <para style="q2" vid="PSA 18:48">taana d'ok'k'u d'ok'k'u ootsaasa;</para>
  <para style="q2" vid="PSA 18:48">Makkalanchcha asatuwaappe neeni taana ashshaasa.<verse eid="PSA 18:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49" />Hewaa diraw, taani neena kawutetsatuwaa giddon galatana;<note caller="-" style="x"><char style="xo" closed="false">18:49 </char><char style="xt" closed="false"><ref loc="ROM 15:9">Rom. 15:9</ref></char></note></para>
  <para style="q2" vid="PSA 18:49">taani Med'inaa Godaa suntsaa sabbana.<verse eid="PSA 18:49" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50" />S'oossay bare kaatiyaw s'oonuwaa bollan s'oonuwaa immee.</para>
  <para style="q2" vid="PSA 18:50">Bare okkeedda, Daawitewunne Aa zeretsaw,</para>
  <para style="q2" vid="PSA 18:50">lo"otetsaa med'inaw bessee.<verse eid="PSA 18:50" /></para>
  <chapter eid="PSA 18" />
  <chapter number="19" style="c" sid="PSA 19" />
  <para style="s">S'oossay S'illotetsaa Awaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Daawita Mazimuriyaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1" />Salotuu S'oossaa bonchchuwaa haasayiinonne</para>
  <para style="q2" vid="PSA 19:1">salotuwaa gufantsuu I bare kushiyan ootseeddawaa awaayee.<verse eid="PSA 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2" />Itti gallassay yenkko gallassaw hewaa odee;</para>
  <para style="q2" vid="PSA 19:2">itti k'ammaykka yenkko k'ammaw eratetsaa k'onc'c'issee.<verse eid="PSA 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3" />Haasayi woy k'aalay baawa;</para>
  <para style="q2" vid="PSA 19:3">unttunttu kooshshaykka sisettenna.<verse eid="PSA 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4" />Gidooppekka, unttunttu haasayaa kooshshay sa'aa ubbaan laaletteedda;<note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="ROM 10:18">Rom. 10:18</ref></char></note></para>
  <para style="q2" vid="PSA 19:4">unttunttu k'aalaykka sa'aa gas'aa gakkeedda.</para>
  <para style="b" vid="PSA 19:4" />
  <para style="q1" vid="PSA 19:4">S'oossay away de'iyaa sa'aa saluwaan giigisseedda.<verse eid="PSA 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 19:5" />Nashettiide kare sooppe kesiyaa mishiraadan,</para>
  <para style="q2" vid="PSA 19:5">Wotsaa naasiyaw giigeedda wotsanchchaadan,</para>
  <para style="q2" vid="PSA 19:5">away wontta wontta kesee.<verse eid="PSA 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6" />Away itti bagga saluwaa gas'aappe mokkiide,</para>
  <para style="q2" vid="PSA 19:6">hara bagga saluwaa gas'aa gakkanaassi bee;</para>
  <para style="q1" vid="PSA 19:6">Aa ho"uwaappe geemmiyaawe ayaynne baawa.<verse eid="PSA 19:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7" />Med'inaa Godaa higgii suure;</para>
  <para style="q2" vid="PSA 19:7">shemppuwaa zaaree.</para>
  <para style="q1" vid="PSA 19:7">Med'inaa Goday odiyaawe ammanettiyaawaa;</para>
  <para style="q2" vid="PSA 19:7">akeekay pac'c'eeddawanttoo eratetsaa immee.<verse eid="PSA 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8" />Med'inaa Godaa wogay likke;</para>
  <para style="q2" vid="PSA 19:8">wozanaa nashechchee.</para>
  <para style="q1" vid="PSA 19:8">Med'inaa Godaa azazuu geeshsha;</para>
  <para style="q2" vid="PSA 19:8">wozanaa poo'issee.<verse eid="PSA 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9" />Med'inaa Godaw yayyiyaawe geeshshatetsaa;</para>
  <para style="q2" vid="PSA 19:9">hewe med'inawukka ek'k'iid de'iyaawaa.</para>
  <para style="q1" vid="PSA 19:9">Med'inaa Godaa pirdday tumanne s'illuwaa.<verse eid="PSA 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10" />Work'k'aappenne walakki bayinna work'k'aappe aad'd'iide dosettee;</para>
  <para style="q2" vid="PSA 19:10">eessaappenne eessaa ililuwaappe aad'd'i mal"ee.<verse eid="PSA 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11" />K'ay taana ne k'oomaa naagettanaadan zoree;</para>
  <para style="q2" vid="PSA 19:11">ne higgiyaa naaguu daro go"ee.<verse eid="PSA 19:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12" />Bare huup'iyaa balaa demmiyaawe oonee?</para>
  <para style="q2" vid="PSA 19:12">Abeet S'oossaw, geemmeedda nagaraappe taana geeshsha.<verse eid="PSA 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13" />K'ay taani, ne k'oomay,</para>
  <para style="q2" vid="PSA 19:13">S'alan nagaraa ootsennaadan,</para>
  <para style="q2" vid="PSA 19:13">neeni taana naaga.</para>
  <para style="q2" vid="PSA 19:13">Taana nagaraw moodisoppa;</para>
  <para style="q2" vid="PSA 19:13">he wode taani suure gidaade,</para>
  <para style="q2" vid="PSA 19:13">wolk'k'aama bayzzuwaappe geeyana.<verse eid="PSA 19:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14" />Abeet Med'inaa Godaw, ta wogga zaallaw,</para>
  <para style="q2" vid="PSA 19:14">taana wozeeddawoo,</para>
  <para style="q1" vid="PSA 19:14">Ta doonaappe kesiyaa k'aalaynne</para>
  <para style="q2" vid="PSA 19:14">ta wozanaa k'ofay neena nashechchiyaawaa gido.<verse eid="PSA 19:14" /></para>
  <chapter eid="PSA 19" />
  <chapter number="20" style="c" sid="PSA 20" />
  <para style="s">Kaatiyaw Woosaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Daawita Mazimuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 20:1" />Neeni metooteedda wode Med'inaa Goday ne woosaa siso;</para>
  <para style="q2" vid="PSA 20:1">Yaak'ooba S'oossaa suntsay neena miniso.<verse eid="PSA 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2" />Bare Geeshsha Sa'aappe new maaduwaa kiitto;</para>
  <para style="q2" vid="PSA 20:2">S'iyooneppe neena zemppisso.<verse eid="PSA 20:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3" />Ne yarshshuwaa ubbaa I new hassayo;</para>
  <para style="q2" vid="PSA 20:3">ne s'uuggiyaa yarshshuwaan nashetto.<verse eid="PSA 20:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4" />Ne wozanaa amuwaa new immo;</para>
  <para style="q2" vid="PSA 20:4">ne halchchuwaa ubbaa polo.<verse eid="PSA 20:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5" />Ne s'oonuwaa diraw, nuuni nashshechchaw hombboc'ana;</para>
  <para style="q2" vid="PSA 20:5">nu S'oossaa suntsan nu banddiraa d'ok'k'u ootsana.</para>
  <para style="q1" vid="PSA 20:5">Neeni woosseeddawaa ubbaa Med'inaa Goday new immo.<verse eid="PSA 20:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6" />Med'inaa Goday bare dooreedda kaatiyaw</para>
  <para style="q2" vid="PSA 20:6">s'oonuwaa immiyaawaa taani biro eray.</para>
  <para style="q1" vid="PSA 20:6">I bare geeshsha saluwaan sisana;</para>
  <para style="q2" vid="PSA 20:6">bare ushechcha kushiyan wolk'k'aama s'oonuwaa aw immana.<verse eid="PSA 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7" />Ittuu ittuu barenttu olaa paray goochchiyaa gaariyan,</para>
  <para style="q2" vid="PSA 20:7">Haratuu barenttu paran c'eek'ettiino;</para>
  <para style="q2" vid="PSA 20:7">shin nuuni Med'inaa Godaa nu S'oossaa wolk'k'an c'eek'etteetto.<verse eid="PSA 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8" />Unttunttu d'ubettiide kunddana;</para>
  <para style="q2" vid="PSA 20:8">shin nuuni denddiide, min ek'k'ana.<verse eid="PSA 20:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9" />Abeet Med'inaa Godaw, kaatiyaw s'oonuwaa imma;</para>
  <para style="q2" vid="PSA 20:9">nuuni neena s'eesiyaa wode sisa.<verse eid="PSA 20:9" /></para>
  <chapter eid="PSA 20" />
  <chapter number="21" style="c" sid="PSA 21" />
  <para style="s">S'oonuwaa Diraw Galataa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Daawita Mazimuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1" />Abeet Med'inaa Godaw, kaatii ne minotetsan hashshu gee;</para>
  <para style="q2" vid="PSA 21:1">neeni immeedda s'oonuwaan I ayaa nashettii!<verse eid="PSA 21:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2" />Neeni Aa wozanaa amuwaa aw immaadda;</para>
  <para style="q2" vid="PSA 21:2">k'ay I neena bare ins's'arssan oochcheeddawaa diggabaakka.<verse eid="PSA 21:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3" />Neeni lo"o anjjuwaan Aa mokkaasa;</para>
  <para style="q2" vid="PSA 21:3">geeshsha work'k'aa kallachchaa Aa huup'iyaan wotsaasa.<verse eid="PSA 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4" />Neeni de'uwaa aw immanaadan neena woosseedda;</para>
  <para style="q2" vid="PSA 21:4">Aw c'ora laytsaanne adussa de'uwaa immaadda.<verse eid="PSA 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5" />Neeni s'oonuwaa immeedda diraw,</para>
  <para style="q2" vid="PSA 21:5">Aa bonchchuu daree; gitatetsaanne anggaa aw immaadda.<verse eid="PSA 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6" />Neeni aw med'inaa anjjuwaa immaasa;</para>
  <para style="q2" vid="PSA 21:6">neeni ittippe de'iyaawaan Aa nashechchaasa.<verse eid="PSA 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7" />Kaatii Med'inaa Godaan ammanettee.</para>
  <para style="q2" vid="PSA 21:7">Ubbaappe D'ok'k'iyaa S'oossaa lo"otetsaa diraw,</para>
  <para style="q1" vid="PSA 21:7">I k'aas'enna.<verse eid="PSA 21:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8" />Ne kushii ne morkkatuwaa ubbaa kutuutana;</para>
  <para style="q2" vid="PSA 21:8">ne ushechchay neena is's'iyaawantta demmana.<verse eid="PSA 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9" />Neeni k'onc'c'iyaa wode,</para>
  <para style="q2" vid="PSA 21:9">unttuntta c'ooc'iyaa tamaadan s'uuggana.</para>
  <para style="q1" vid="PSA 21:9">Med'inaa Goday bare hank'k'uwaa suuluwaan unttuntta mittana;</para>
  <para style="q2" vid="PSA 21:9">Aa tamaykka unttuntta mi d'ayissana.<verse eid="PSA 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10" />Neeni unttunttu naanatuwaa biittaappe,</para>
  <para style="q2" vid="PSA 21:10">unttunttu zeretsaakka asaa giddoppe d'ayissana.<verse eid="PSA 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11" />Ne morkketuu ne bolla shiik'inonne</para>
  <para style="q2" vid="PSA 21:11">iitabaa mak'ettiino; shin polikkino.<verse eid="PSA 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12" />Ayaw gooppe, neeni unttuntta ne wonddaafiyaa pootsan dukkanaw baabisana;</para>
  <para style="q2" vid="PSA 21:12">guyye zaaraadde bak'atissana.<verse eid="PSA 21:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13" />Abeet Med'inaa Godaw, ne minotetsan d'ok'k'u d'ok'k'u ga;</para>
  <para style="q2" vid="PSA 21:13">ne wolk'k'aa diraw new galataa mazimuriyaa yes's'eetto.<verse eid="PSA 21:13" /></para>
  <chapter eid="PSA 21" />
  <chapter number="22" style="c" sid="PSA 22" />
  <para style="s">S'illo Asaa Metuwaanne Hidootaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Daawita Mazimuriyaa. Wontta Guuraa «Gen"iyaa» Yetsaadaan Yes'etteedda Daawita Mazimuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1" />Ta S'oossaw, ta S'oossaw, taana ayaw aggaadii?<note caller="-" style="x"><char style="xo" closed="false">22:1 </char><char style="xt" closed="false"><ref loc="MAT 27:46">Mat. 27:46</ref>; <ref loc="MRK 15:34">Mar. 15:34</ref></char></note></para>
  <para style="q2" vid="PSA 22:1">Taana maadda gaade taani new watiwatiyaa wode,</para>
  <para style="q2" vid="PSA 22:1">ayaw taappe haakkay?<verse eid="PSA 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2" />Abeet ta S'oossaw, gallassan ubbaan taani new waassay;</para>
  <para style="q2" vid="PSA 22:2">shin neeni taw allakka.</para>
  <para style="q1" vid="PSA 22:2">K'amman ubbankka new waassay,</para>
  <para style="q2" vid="PSA 22:2">shin woppaa demmikke.<verse eid="PSA 22:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3" />Gidooppenne, neeni geeshsha.</para>
  <para style="q2" vid="PSA 22:3">Israa'eeliyaa galatay ne araataa yuushshuwaan de'ee.<verse eid="PSA 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4" />Kase nu aawotuu neenan ammanetteedino;</para>
  <para style="q2" vid="PSA 22:4">neenan ammanettina, neeni unttuntta ashshaada.<verse eid="PSA 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5" />New waassiide atteeddino;</para>
  <para style="q2" vid="PSA 22:5">neenan ammanettiide yeellatibeykkino.<verse eid="PSA 22:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6" />Shin taani asaa gidikke; taani gus'uniyaa.</para>
  <para style="q2" vid="PSA 22:6">Taani asan kad'etteeddawaanne k'iliic'etteeddawaa.<verse eid="PSA 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7" />Taana be'iyaa ubbatuu k'id'iino;<note caller="-" style="x"><char style="xo" closed="false">22:7 </char><char style="xt" closed="false"><ref loc="MAT 27:39">Mat. 27:39</ref>; <ref loc="MRK 15:29">Mar. 15:29</ref>; <ref loc="LUK 23:35">Luk'. 23:35</ref></char></note></para>
  <para style="q2" vid="PSA 22:7">unttunttu taana s'iti s'eelliinonne barenttu huup'iyaa k'aatsiino.<verse eid="PSA 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8" />Yaatooppe, «I Med'inaa Godaan ammanetteedda;<note caller="-" style="x"><char style="xo" closed="false">22:8 </char><char style="xt" closed="false"><ref loc="MAT 27:43">Mat. 27:43</ref></char></note></para>
  <para style="q2" vid="PSA 22:8">ayaw Aa ashshennee?</para>
  <para style="q1" vid="PSA 22:8">Med'inaa Goday Aa dosooppe,</para>
  <para style="q2" vid="PSA 22:8">ane Aa ashsho» yaagiino.<verse eid="PSA 22:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9" />Gidooppenne, taana ta aatti uluwaappe suure yeliseeddawe neena;</para>
  <para style="q2" vid="PSA 22:9">ta aatti d'antsaa d'ammiyaa wodekka taani ammanettanaadan ootsaadda.<verse eid="PSA 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10" />Taani yelettoodeppe doommaade neenan dic'c'aad;</para>
  <para style="q2" vid="PSA 22:10">ta aatti uluwaappe doommaadekka, neeni ta S'oossaa.<verse eid="PSA 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11" />Metuu taakko matiyaa dirawunne</para>
  <para style="q2" vid="PSA 22:11">taana maaddiyaawe bayinna diraw,</para>
  <para style="q1" vid="PSA 22:11">Ha"i neeni taappe haakkoppa.<verse eid="PSA 22:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12" />Daro morkketuu koruma booratuwaadan taana dooddiino;</para>
  <para style="q2" vid="PSA 22:12">k'ayc'c'iyaa Baasaane biittaa booratuwaadan taana dooddiino.<verse eid="PSA 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13" />Mentsereetsiyaanne gudiyaa gaammuwaadan</para>
  <para style="q2" vid="PSA 22:13">barenttu doonaa ta bolla hanggiino.<verse eid="PSA 22:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14" />Taani haatsaadan goggaad;</para>
  <para style="q2" vid="PSA 22:14">ta mek'etsatuu barenttu kuushshaappe koletteeddino.</para>
  <para style="q1" vid="PSA 22:14">Ta wozanay eessaa muk'aaddaa mala,</para>
  <para style="q2" vid="PSA 22:14">ta giddon seeri wuree.<verse eid="PSA 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15" />Ta k'ood'ii kon"aadan melee;</para>
  <para style="q2" vid="PSA 22:15">ta ins's'arssay kookkiyaana oyk'k'ettee.</para>
  <para style="q1" vid="PSA 22:15">Neeni taana hayk'k'eedda asaadan baanan yeggaadda.<verse eid="PSA 22:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16" />Kanatuu taana te"eeddino;</para>
  <para style="q2" vid="PSA 22:16">iita asatuu ta yuushshuwaan dooddeeddino.</para>
  <para style="q1" vid="PSA 22:16">Ta kushetuwaanne ta gedetuwaa c'addiino.<verse eid="PSA 22:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17" />Ta mek'etsatuwaa ubbaa taan payday.</para>
  <para style="q2" vid="PSA 22:17">Ta morkketuu taana s'eelliinonne derek'k'iino.<verse eid="PSA 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18" />Ta mayuwaa shaakki akkiino;<note caller="-" style="x"><char style="xo" closed="false">22:18 </char><char style="xt" closed="false"><ref loc="MAT 27:35">Mat. 27:35</ref>; <ref loc="MRK 15:24">Mar. 15:24</ref>; <ref loc="LUK 23:34">Luk'. 23:34</ref>; <ref loc="JHN 19:24">Yoh. 19:24</ref></char></note></para>
  <para style="q2" vid="PSA 22:18">ta adussa mayuwaan saamaa yeggiino.<verse eid="PSA 22:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19" />Abeet Med'inaa Godaw, neeni taappe haakkoppa.</para>
  <para style="q2" vid="PSA 22:19">Abeet ta wolk'k'aw, taana maaddanaw ellekka haaya.<verse eid="PSA 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20" />Taana mashshaappe ashsha;</para>
  <para style="q2" vid="PSA 22:20">ta uushshuwan de'iyaa kanatuwaa wolk'k'aappe ashsha.<verse eid="PSA 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21" />Gaammotuwaa doonaappe taana ashsha;</para>
  <para style="q2" vid="PSA 22:21">k'ayc'c'iyaa bazzuwaa booratuwaa kac'iyaappe taana naaga.<verse eid="PSA 22:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22" />Taani ne suntsaa ta ishatoo odana;<note caller="-" style="x"><char style="xo" closed="false">22:22 </char><char style="xt" closed="false"><ref loc="HEB 2:12">Ibr. 2:12</ref></char></note></para>
  <para style="q2" vid="PSA 22:22">maabaraa shiik'uwaankka neena galatana.<verse eid="PSA 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23" />Hinttenoo, Med'inaa Godaw yayyiyaawanttoo, Aa galatite.</para>
  <para style="q2" vid="PSA 22:23">Hinttenoo, Yaak'ooba zeretsatoo,</para>
  <para style="q2" vid="PSA 22:23">ubbaykka Aa bonchchite.</para>
  <para style="q2" vid="PSA 22:23">Hinttenoo, Israa'eeliyaa zeretsatoo,</para>
  <para style="q2" vid="PSA 22:23">ubbatuukka bonchchuwaan aw yayyite.<verse eid="PSA 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24" />I naak'etteeddawantta kad'enna;</para>
  <para style="q2" vid="PSA 22:24">unttuntta gakkeedda k'ohuwaa taw ay metee geena.</para>
  <para style="q1" vid="PSA 22:24">Bare som"uwaa unttunttuppe gentsenna;</para>
  <para style="q2" vid="PSA 22:24">shin unttunttu maadoo aakko waassiyaa wodiyaan,</para>
  <para style="q2" vid="PSA 22:24">unttunttu waasuwaa sisee.<verse eid="PSA 22:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25" />Taani neeni ootseedda lo"o oosuwaa diraw,</para>
  <para style="q2" vid="PSA 22:25">kuntseedda shiik'uwaan galatana.</para>
  <para style="q1" vid="PSA 22:25">Taani shiik'etteeddawaa new yayyiyaa asaa sintsan gatsana.<verse eid="PSA 22:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26" />Hiyyeesatuu miide kallana.</para>
  <para style="q2" vid="PSA 22:26">Med'inaa Godaa koyiyaawanttu Aa galatana.</para>
  <para style="q1" vid="PSA 22:26">Unttunttu med'inaw de'ana.<verse eid="PSA 22:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27" />Sa'aa gas'aa gakkanaw Asay ubbay</para>
  <para style="q2" vid="PSA 22:27">hassayiide, Med'inaa Godaakko simmana.</para>
  <para style="q1" vid="PSA 22:27">Asaa zare ubbay aw goyinnana.<verse eid="PSA 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28" />Ayaw gooppe, kaatetiyaa maatay Med'inaa Godaawaa;</para>
  <para style="q2" vid="PSA 22:28">kawutetsatuwaa I mooddee.<verse eid="PSA 22:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29" />Sa'aan de'iyaa dure asatuu ubbay</para>
  <para style="q2" vid="PSA 22:29">aw goyinnana.</para>
  <para style="q1" vid="PSA 22:29">Barentta hayk'k'uwaappe ashshanaw danddayennawanttunne</para>
  <para style="q2" vid="PSA 22:29">baanaw laamettiyaawanttu ubbatuu aw gulbbatana.<verse eid="PSA 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30" />Yiyaa zeretsay aw kiitettana;</para>
  <para style="q2" vid="PSA 22:30">asay Godaa oosuwaa yiyaa yeletaw odana.<verse eid="PSA 22:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31" />Biro yelettibeenna asaykka Aa s'illotetsaa odana.</para>
  <para style="q2" vid="PSA 22:31">«S'oossay bare asaa ashsheedda» yaagiyaawe odettana.<verse eid="PSA 22:31" /></para>
  <chapter eid="PSA 22" />
  <chapter number="23" style="c" sid="PSA 23" />
  <para style="s">Lo"o Hentsanchchaa</para>
  <para style="d">Daawita mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1" />Med'inaa Goday ta hentsanchchaa;</para>
  <para style="q2" vid="PSA 23:1">taw ayaynne pac'c'enna.<verse eid="PSA 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 23:2" />Taana aac'a k'ooruwaan shemppissee;<note caller="-" style="x"><char style="xo" closed="false">23:2 </char><char style="xt" closed="false"><ref loc="REV 7:17">Sas'. 7:17</ref></char></note></para>
  <para style="q2" vid="PSA 23:2">woppu geedda haatsaakko laaggee.<verse eid="PSA 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 23:3" />Ta de'uwaa ooras's'isee.</para>
  <para style="q2" vid="PSA 23:3">Bare suntsaa diraw, taana s'illotetsaa ogiyaan kaaletsee.<verse eid="PSA 23:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4" />Neeni ta S'oossay taananna de'iyaa diraw,</para>
  <para style="q2" vid="PSA 23:4">Taani d'ip'p'i go d'umaa zanggaaraa gidduwaanna booppekka,</para>
  <para style="q2" vid="PSA 23:4">iitabaw yayyikke.</para>
  <para style="q2" vid="PSA 23:4">Ne gatimaynne ne guufii taana mintsetsiino.<verse eid="PSA 23:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5" />Ta morkkatuwaa sintsan taw gibiraa makkaadda.</para>
  <para style="q2" vid="PSA 23:5">Taana mokkaad, ta huup'iyaa zayitiyaa okkaadda.</para>
  <para style="q1" vid="PSA 23:5">Ta wanc'c'ay palahiide goggana gakkanaw kuntsaadda.<verse eid="PSA 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6" />Ne keekkatetsaynne maarotetsay</para>
  <para style="q2" vid="PSA 23:6">ta de'uwaa laytsaa ubbaan tumuwaappe taana kaallana.</para>
  <para style="q1" vid="PSA 23:6">Taani Med'inaa Godaa golliyaan med'inaw de'ana.<verse eid="PSA 23:6" /></para>
  <chapter eid="PSA 23" />
  <chapter number="24" style="c" sid="PSA 24" />
  <para style="s">Geeshsha Golliyaa Geluwaa Mazimuriyaa</para>
  <para style="d">Daawita mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1" />Sa'aynne sa'aan kumeeddawe ubbay Med'inaa Godaawaa;<note caller="-" style="x"><char style="xo" closed="false">24:1 </char><char style="xt" closed="false"><ref loc="1CO 10:26">1 K'or. 10:26</ref></char></note></para>
  <para style="q2" vid="PSA 24:1">biittaynne biittan de'iyaabay ubbay aawaa.<verse eid="PSA 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2" />Ayaw gooppe, sa'aa wolk'k'aama abbaa bollan I hiis's'eedda;</para>
  <para style="q2" vid="PSA 24:2">c'iimmo haatsaa bollan minisiide essee.<verse eid="PSA 24:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3" />Med'inaa Godaa deriyaa gi"anawe oonee?</para>
  <para style="q2" vid="PSA 24:3">Aa geeshsha sa'aan ek'k'anawe oonee?<verse eid="PSA 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4" />Aa kushii nagaraappe geeyyeeddawaa,</para>
  <para style="q2" vid="PSA 24:4">Aa wozanay geeshsha gideeddawaa,<note caller="-" style="x"><char style="xo" closed="false">24:4 </char><char style="xt" closed="false"><ref loc="MAT 5:8">Mat. 5:8</ref></char></note></para>
  <para style="q2" vid="PSA 24:4">eek'aw goyinnennawaa,</para>
  <para style="q2" vid="PSA 24:4">wordduwaan c'aak'k'ennawaa.<verse eid="PSA 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5" />I Med'inaa Godaappe anjjuwaa akkana;</para>
  <para style="q2" vid="PSA 24:5">ashshiyaa S'oossaappe I s'illotetsaa pirdddaa akkana.<verse eid="PSA 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6" />S'oossaakko s'eelliyaa asaynne</para>
  <para style="q2" vid="PSA 24:6">Yaak'ooba S'oossaa sintsa koyiyaa Asay hawanttu mala.<verse eid="PSA 24:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7" />Penggetuu dooyettite! Bonchcho kaatii gelana mala;</para>
  <para style="q2" vid="PSA 24:7">beni penggatuu Aa nashechchaan mokkite!<verse eid="PSA 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8" />He bonchcho kaatii oonee?</para>
  <para style="q2" vid="PSA 24:8">Minuunne wolk'k'aamay Med'inaa Godaatee!</para>
  <para style="q1" vid="PSA 24:8">Olawukka I wolk'k'aama Med'inaa Godaatee!<verse eid="PSA 24:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9" />Penggetuu dooyettite! Bonchcho kaatii gelana mala;</para>
  <para style="q2" vid="PSA 24:9">beni penggatuu Aa nashechchaan mokkite!<verse eid="PSA 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10" />Ha bonchcho kaatii oonee?</para>
  <para style="q2" vid="PSA 24:10">Ha bonchcho kaatii saluwaa med'etetsatuwaa Med'inaa Godaatee!<verse eid="PSA 24:10" /></para>
  <chapter eid="PSA 24" />
  <chapter number="25" style="c" sid="PSA 25" />
  <para style="d">Daawite Mazimuriyaa<note caller="+" style="f"><char style="fr" closed="false">25:0 </char><char style="ft" closed="false">K'oppennabay Gakkiyaa Wode Shiik'iyaa Woosaa.</char></note></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 25:1" />Abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 25:1">ta shemppuwaappe neena woossay.<verse eid="PSA 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2" />Abeet ta S'oossaw, taani neenan ammanettay;</para>
  <para style="q2" vid="PSA 25:2">taana yeellayoppa; ta morkkatuwaa haytsaa kessoppa.<verse eid="PSA 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3" />Neenan hidootaa ootsiyaawanttu yeellatikkino;</para>
  <para style="q2" vid="PSA 25:3">shin gaasuu bayinnan geniyaawanttu yeellatana.<verse eid="PSA 25:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4" />Abeet Med'inaa Godaw, taana ne ogiyaa bessa;</para>
  <para style="q2" vid="PSA 25:4">ne ogiyaa taana tamaarissa.<verse eid="PSA 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5" />Neeni taana ashshiyaa S'oossaa gidiyaa diraw,</para>
  <para style="q2" vid="PSA 25:5">ne tumatetsan taana kaaletsaanne tamaarissa.</para>
  <para style="q1" vid="PSA 25:5">Gallassaa kumentsan taani neenan hidootaa ootsay.<verse eid="PSA 25:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6" />Abeet Med'inaa Godaw, beniideppe de'iyaa ne k'aretaanne</para>
  <para style="q2" vid="PSA 25:6">ne keekatetsaa hassaya.<verse eid="PSA 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7" />Ta yalagatetsaa nagaraanne bayzzuwaa hassayoppa.</para>
  <para style="q2" vid="PSA 25:7">Abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 25:7">ne keekatetsaanne lo"otetsaa hassaya.<verse eid="PSA 25:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8" />Med'inaa Goday keekkanne suure;</para>
  <para style="q2" vid="PSA 25:8">hewaa diraw, nagaranchchatuwaa bare ogiyaa tamaarissee.<verse eid="PSA 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9" />Ashkketuwaa suuretetsan kaaletsee;</para>
  <para style="q2" vid="PSA 25:9">ashkketuwaa bare ogiyaa tamaarissee.<verse eid="PSA 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10" />Med'inaa Godaa c'aak'uwaanne Aa awaayuwaa naagiyaawanttoo</para>
  <para style="q2" vid="PSA 25:10">Aa ogii ubbay tumatetsaanne keekatetsaa.<verse eid="PSA 25:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11" />Abeet Med'inaa Godaw, ta nagaray loytsi dara;</para>
  <para style="q2" vid="PSA 25:11">gidooppekka, ne suntsaa diraw, atto yaaga.<verse eid="PSA 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12" />Med'inaa Godaw yayyiyaa Asay oonee?</para>
  <para style="q2" vid="PSA 25:12">I dooriide kaalana ogiyaa S'oossay Aa tamaarissana.<verse eid="PSA 25:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13" />I ubbaa gedekka lo"o de'ussaa de'ana;</para>
  <para style="q2" vid="PSA 25:13">Aa zeretsatuu biittaa laattana.<verse eid="PSA 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14" />Med'inaa Goday barew yayyiyaawanttoo,</para>
  <para style="q2" vid="PSA 25:14">bare s'uuraa shaakkiyaawaa;</para>
  <para style="q1" vid="PSA 25:14">I unttunttoo bare c'aak'uwaakka k'onc'c'issee.<verse eid="PSA 25:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15" />Med'inaa Goday ta gediyaa p'iriyaappe kessiyaa diraw,</para>
  <para style="q2" vid="PSA 25:15">ta ayifii maadoo ubbaa gede aakko s'eellee.<verse eid="PSA 25:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16" />S'oossaw, taani taarekka de'iyaa k'ohetteedda asaa gidiyaa diraw,</para>
  <para style="q2" vid="PSA 25:16">haa taakko simma; ne maarotetsaa taana bessa.<verse eid="PSA 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17" />Taw hirggay dareedda;</para>
  <para style="q2" vid="PSA 25:17">ta metuwaappe taana neeni woza.<verse eid="PSA 25:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18" />Ta metuwaanne ta tuggaa neeni be'a.</para>
  <para style="q2" vid="PSA 25:18">Ta nagaraa ubbaa atto ga.<verse eid="PSA 25:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19" />Ta morkketuu ay keeshshaa dareeddenttonne be'a;</para>
  <para style="q2" vid="PSA 25:19">unttunttu taana wod'anaadan is's'iyaawaa s'eella.<verse eid="PSA 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20" />Neeni taana naaga; neeni taana ashsha;</para>
  <para style="q2" vid="PSA 25:20">taani neekko bak'ateedda diraw, taana yeellayoppa.<verse eid="PSA 25:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21" />Taani neenan hidootaa ootseedda diraw,</para>
  <para style="q2" vid="PSA 25:21">suuretetsaynne tumatetsay taana naago.<verse eid="PSA 25:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22" />Abeet S'oossaw, Israa'eeliyaa asaa</para>
  <para style="q2" vid="PSA 25:22">unttunttu metuwaa ubbaappe neeni ashsha.<verse eid="PSA 25:22" /></para>
  <chapter eid="PSA 25" />
  <chapter number="26" style="c" sid="PSA 26" />
  <para style="s">Geeshsha Asaa Woosaa</para>
  <para style="d">Daawita mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1" />Abeet Med'inaa Godaw, taani suuretetsan hametteedda dirawunne,</para>
  <para style="q2" vid="PSA 26:1">sid'ii bayinnan Med'inaa Godaa ammanetteeda diraw,</para>
  <para style="q2" vid="PSA 26:1">taw pirddaa.<verse eid="PSA 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2" />Abeet Med'inaa Godaw, taana paac'c'a, taana bidda;</para>
  <para style="q2" vid="PSA 26:2">ta wozanaa s'omoosa.<verse eid="PSA 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3" />Ayaw gooppe, aggena ne siik'uu ta sintsan de'ee;</para>
  <para style="q2" vid="PSA 26:3">taani ne tumatetsaa ogiyaan hamettay.<verse eid="PSA 26:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4" />Taani c'immiyaa asatuwaana ittippe uttikke;</para>
  <para style="q2" vid="PSA 26:4">lo"a malatiyaa iitatuwaa maabaran gelikke.<verse eid="PSA 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5" />Iitaa ootsiyaa asatuwaa shiik'uwaa taani is's'ay;</para>
  <para style="q2" vid="PSA 26:5">makkalanchchatuwaanna ittippe uttikke.<verse eid="PSA 26:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6" />Abeet Med'inaa Godaw, taani k'ohabeennawaa bessanaw</para>
  <para style="q2" vid="PSA 26:6">ta kushiyaa meec'c'ay.</para>
  <para style="q1" vid="PSA 26:6">New yarshshiyaa sa'aa yuuyyay;<verse eid="PSA 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7" />ne galataa yetsaa yes's'aynne</para>
  <para style="q2" vid="PSA 26:7">neeni ootseedda ooratsabaa ubbaa oday.<verse eid="PSA 26:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8" />Abeet Med'inaa Godaw, neeni de'iyaa golliyaa,</para>
  <para style="q2" vid="PSA 26:8">ne bonchchuu ak'iyaa sa'aa taani dosay.<verse eid="PSA 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9" />Taana nagaranchchatuwaanna ittippe pittoppa;</para>
  <para style="q2" vid="PSA 26:9">woy asaa wod'iyaawanttunna ittippe d'ayissoppa.<verse eid="PSA 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10" />Unttunttu kushiyan iita halchchuu de'ee;</para>
  <para style="q2" vid="PSA 26:10">k'ay unttunttu ushechcha kushiyan mattaayii kumi utteedda.<verse eid="PSA 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11" />Shin taana gidooppe, taani suuretetsan hamettay.</para>
  <para style="q2" vid="PSA 26:11">Taana woza; taw k'aretta.<verse eid="PSA 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12" />Ta gedii dembba sa'aan ek'k'eedda;</para>
  <para style="q2" vid="PSA 26:12">taani wolk'k'aama shiik'uwaan Med'inaa Godaa galatana.<verse eid="PSA 26:12" /></para>
  <chapter eid="PSA 26" />
  <chapter number="27" style="c" sid="PSA 27" />
  <para style="s">S'oossaanna De'iyaa Asaa Ammanuwaa</para>
  <para style="d">Daawita mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1" />Med'inaa Goday taw poo'onne taana ashshiyaawaa;</para>
  <para style="q2" vid="PSA 27:1">yaatina, taani ow yayyanitaa?</para>
  <para style="q2" vid="PSA 27:1">Med'inaa Goday ta de'uu naagettiyaa miis'aa;</para>
  <para style="q2" vid="PSA 27:1">yaatina, taani ow dagammanitaa?<verse eid="PSA 27:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2" />Iita asatuu, ta is's'iyaawanttunne ta morkketuu</para>
  <para style="q2" vid="PSA 27:2">taana wod'anaw taakko wos's'iyaa wode,</para>
  <para style="q1" vid="PSA 27:2">Unttunttu barenttoo d'ubettiide kunddana.<verse eid="PSA 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3" />Morkkiyaa tooray taana dooddinttokka</para>
  <para style="q2" vid="PSA 27:3">ta wozanay yayyena.</para>
  <para style="q1" vid="PSA 27:3">Olay ta bolla dooddinttokka,</para>
  <para style="q2" vid="PSA 27:3">taani Med'inaa Godan ammanettay.<verse eid="PSA 27:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4" />Taani Med'inaa Godaa ittibaa oochchaad;</para>
  <para style="q2" vid="PSA 27:4">Taani hewaa koyaad;</para>
  <para style="q2" vid="PSA 27:4">hewenne, taani ta de'uwaa laytsaa ubbaan,</para>
  <para style="q2" vid="PSA 27:4">Med'inaa Godaa golliyaan de'anawaa;</para>
  <para style="q2" vid="PSA 27:4">k'aykka taani Med'inaa Godaa lo"otetsaa be'anawaanne</para>
  <para style="q2" vid="PSA 27:4">Aa Golliyaan Aa koyanawaa.<verse eid="PSA 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5" />Hewaa diraw, metuwaa gallassan</para>
  <para style="q2" vid="PSA 27:5">I taana bare de'iyaa saan gentsana;</para>
  <para style="q2" vid="PSA 27:5">bare dunkkaaniyaan I taana k'osi ashshana.</para>
  <para style="q2" vid="PSA 27:5">I taana d'ok'k'a shuchchaa bollan essana.<verse eid="PSA 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6" />He wode taani taana dooddeedda ta morkkatuwaappe,</para>
  <para style="q2" vid="PSA 27:6">gitataade d'ok'k'u d'ok'k'u yaagana.</para>
  <para style="q1" vid="PSA 27:6">Taani Aa dunkkaaniyaan nashetaade yarshshuwaa yarshshana.</para>
  <para style="q2" vid="PSA 27:6">Taani Med'inaa Godaw diis's'ananne yes's'ana.<verse eid="PSA 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7" />Abeet Med'inaa Godaw, taani neena s'eesiyaa wode,</para>
  <para style="q2" vid="PSA 27:7">Neeni taw koya;</para>
  <para style="q2" vid="PSA 27:7">taw k'aretta; taana sisa.<verse eid="PSA 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8" />Neeni, «Ta sintsa koyite» geedda wode,</para>
  <para style="q2" vid="PSA 27:8">Ta wozanay, «Abeet Med'inaa Godaw, eeno;</para>
  <para style="q2" vid="PSA 27:8">taani ne sintsa koyana» yaageedda.<verse eid="PSA 27:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9" />Ne sintsa taappe gentsoppa.</para>
  <para style="q2" vid="PSA 27:9">Taana maaddeeddawoo, taana ne k'oomaa</para>
  <para style="q2" vid="PSA 27:9">hank'k'ettaade guyye zaaroppa.</para>
  <para style="q2" vid="PSA 27:9">Abeet taana ashshiyaa S'oossaw,</para>
  <para style="q2" vid="PSA 27:9">taana oloppanne aggoppa.<verse eid="PSA 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10" />Ta aawuunne ta aata taana agginttonne</para>
  <para style="q2" vid="PSA 27:10">Med'inaa Goday taana shiishshi akkana.<verse eid="PSA 27:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11" />Abeet Med'inaa Godaw, ne ogiyaa taana tamaarissa;</para>
  <para style="q2" vid="PSA 27:11">ta morkkatuwaa diraw, taana suure ogiyaa kaaletsa.<verse eid="PSA 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12" />Taana naassiyaa worddo markkatuu ta bolla iitatetsaan denddeedda diraw,</para>
  <para style="q2" vid="PSA 27:12">taana ta morkkatuwaa amoo aatsaade immoppa.<verse eid="PSA 27:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13" />Med'inaa Godaa keekkatetsaa taani pas'a de'aadde be'anawaa ammanay.<verse eid="PSA 27:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14" />Med'inaa Godaan hidootaa wotsa;</para>
  <para style="q2" vid="PSA 27:14">minnaadenne wozanaamaade, Med'inaa Godaan hidootaa wotsa.<verse eid="PSA 27:14" /></para>
  <chapter eid="PSA 27" />
  <chapter number="28" style="c" sid="PSA 28" />
  <para style="s">Maaduwaa Demanaw Woosaanne Galataa</para>
  <para style="d">Daawita mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1" />Abeet Med'inaa Godaw, ta zaallaw, taani neena s'eesay;</para>
  <para style="q2" vid="PSA 28:1">taani neena s'eesina, taw sisa is's'oppa.</para>
  <para style="q2" vid="PSA 28:1">Ne c'o"u gooppe,</para>
  <para style="q2" vid="PSA 28:1">taani duufuwaa beedda asatuwaa mala giday.<verse eid="PSA 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2" />«Maaddo» gaade taani neena s'eesiyaa wodenne</para>
  <para style="q2" vid="PSA 28:2">ne Ubbaappe Geeshsha Dunkkaaniyaakko zaaraadde,</para>
  <para style="q2" vid="PSA 28:2">ta kushiyaa mic'c'iyaa wode,</para>
  <para style="q2" vid="PSA 28:2">neeni ta watiwatuwaa sisa.<verse eid="PSA 28:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3" />Iitaa ootsiyaa iita asatuwaana taana gatsaade oyk'k'oppa;</para>
  <para style="q2" vid="PSA 28:3">Hewanttu barenttu wozanaan kobabaa k'oppi uttiide,</para>
  <para style="q2" vid="PSA 28:3">barenttu doonaan barenttu shooruwaanna sarobaa haasayiyaawantta.<verse eid="PSA 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4" />Unttunttu oosuwaadaaninne unttunttu oosuwaa iitatetsaadan,</para>
  <para style="q2" vid="PSA 28:4">unttunttoo c'igga;<note caller="-" style="x"><char style="xo" closed="false">28:4 </char><char style="xt" closed="false"><ref loc="REV 22:12">Sas'. 22:12</ref></char></note></para>
  <para style="q2" vid="PSA 28:4">unttunttu kushii ootseeddabaw unttunttoo zaara.</para>
  <para style="q2" vid="PSA 28:4">Unttunttoo bessiyaa iitaa unttunttoo zaara.<verse eid="PSA 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5" />Unttunttu S'oossaa oosuwaanne Aa kushii med'd'eeddawaa</para>
  <para style="q2" vid="PSA 28:5">dosennan is's'eedda diraw, S'oossay unttuntta kolana;</para>
  <para style="q2" vid="PSA 28:5">zaariide unttuntta ubbakka kees's'enna.<verse eid="PSA 28:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6" />Ta watiwatuwaa siseedda diraw, Med'inaa Goday galatetto.<verse eid="PSA 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7" />Med'inaa Goday taw wolk'k'anne gonddalle;</para>
  <para style="q2" vid="PSA 28:7">Ta wozanay an ammanettee;</para>
  <para style="q2" vid="PSA 28:7">hewan taani maadettaad.</para>
  <para style="q2" vid="PSA 28:7">Hewaa diraw, ta wozanay an nashettee;</para>
  <para style="q2" vid="PSA 28:7">taani yetsan Aa sabbana.<verse eid="PSA 28:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8" />Med'inaa Goday bare asaw wolk'k'aa;</para>
  <para style="q2" vid="PSA 28:8">I bare okkeedda kaatiyaa ashshiyaa miis'aa.<verse eid="PSA 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9" />S'oossaw, ne asaa ashsha;</para>
  <para style="q2" vid="PSA 28:9">new gidiyaawantta anjja.</para>
  <para style="q1" vid="PSA 28:9">Unttuntta heemmiyaawe neena gida;</para>
  <para style="q2" vid="PSA 28:9">neeni unttuntta med'inawukka tookka.<verse eid="PSA 28:9" /></para>
  <chapter eid="PSA 28" />
  <chapter number="29" style="c" sid="PSA 29" />
  <para style="s">S'oossaa Kooshshaa Wolk'k'aa</para>
  <para style="d">Daawita mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 29:1" />Hinttenoo saluwaan de'iyaa med'etatoo,</para>
  <para style="q2" vid="PSA 29:1">Med'inaa Godaabaa odite;</para>
  <para style="q1" vid="PSA 29:1">«Bonchchuunne wolk'k'ay Med'inaa Godaawaa» giide odite.<verse eid="PSA 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2" />Med'inaa Godaa bonchcho suntsaa galatite;</para>
  <para style="q2" vid="PSA 29:2">Aa geeshshatetsaa puulaw Med'inaa Godaw goyinnite.<verse eid="PSA 29:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3" />Med'inaa Godaa guntsay haatsatuwaa bollan sisettee.</para>
  <para style="q2" vid="PSA 29:3">Bonchcho S'oossay guuguntsaadan guummee;</para>
  <para style="q1" vid="PSA 29:3">Med'inaa Goday wolk'k'aama haatsatuwaa bollan guummee.<verse eid="PSA 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4" />Med'inaa Godaa guntsay wolk'k'aama;</para>
  <para style="q2" vid="PSA 29:4">Med'inaa Godaa guntsay, «Hoola!» giissiyaawaa.<verse eid="PSA 29:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5" />Med'inaa Godaa guntsay zigatuwaa mentsereetsee;</para>
  <para style="q2" vid="PSA 29:5">Liibaanoosa giyaa biittan de'iyaa zigatuwaakka,</para>
  <para style="q1" vid="PSA 29:5">Med'inaa Goday mentsereetsee.<verse eid="PSA 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6" />Liibaanoosa deretuwaa galo maraadan buraak'issee;</para>
  <para style="q2" vid="PSA 29:6">Siriyoona giyaa wolk'k'aama deriyaa Mentsaadan p'is's'illissee.<verse eid="PSA 29:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7" />Med'inaa Godaa kooshshay,</para>
  <para style="q2" vid="PSA 29:7">walk'k'antsaa wolk'k'amissee.<verse eid="PSA 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8" />Med'inaa Godaa kooshshay bazzuwaa k'aatsee;</para>
  <para style="q2" vid="PSA 29:8">Med'inaa Goday K'aadeesa Bazzuwaa k'aatsee.<verse eid="PSA 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9" />Med'inaa Godaa kooshshay wolatuwaa k'aatsee;</para>
  <para style="q2" vid="PSA 29:9">mitsaa haytsaakka k'ok'k'ofee.</para>
  <para style="q1" vid="PSA 29:9">Yaatina, I de'iyaa sa'aan de'iyaawanttu,</para>
  <para style="q2" vid="PSA 29:9">«Bonchchuu S'oossaw gido» yaagiino.<verse eid="PSA 29:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10" />Med'inaa Goday di'uwaa haatsaa bolla bare kawutetsaa araataa wotsiide utteedda;</para>
  <para style="q2" vid="PSA 29:10">Med'inaa Goday bare kawutetsaa araatan uttiide,</para>
  <para style="q2" vid="PSA 29:10">med'inaw kaateteedda.<verse eid="PSA 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11" />Med'inaa Goday bare asaw wolk'k'aa immee.</para>
  <para style="q2" vid="PSA 29:11">Med'inaa Goday bare asaa sarotetsaan anjjee.<verse eid="PSA 29:11" /></para>
  <chapter eid="PSA 29" />
  <chapter number="30" style="c" sid="PSA 30" />
  <para style="s">Galataa Woosaa</para>
  <para style="d">Daawita mazimuriyaa, Geeshsha Golliyaa anjjissiyaa gallassi yes's'eeddawaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1" />Abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 30:1">neeni taana c'iimmuwaappe kesseedda dirawunne</para>
  <para style="q2" vid="PSA 30:1">ta morkkatuwaan, «Hashshu aw» giissabeenna diraw,</para>
  <para style="q2" vid="PSA 30:1">Taani neena d'ok'k'u d'ok'k'u ootsana.<verse eid="PSA 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2" />Abeet Med'inaa Godaw ta S'oossaw,</para>
  <para style="q2" vid="PSA 30:2">neeni taana maaddanaadan, taani neena s'eesaad;</para>
  <para style="q2" vid="PSA 30:2">neeni taana patsaadda.<verse eid="PSA 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3" />Abeet Med'inaa Godaw, taana duufuwaa beennaadan naagaadda;</para>
  <para style="q2" vid="PSA 30:3">Duge c'iimmo ollaan gelennaadan,</para>
  <para style="q2" vid="PSA 30:3">neeni taana pas'a ashshaada.<verse eid="PSA 30:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4" />Hinttenoo S'oossaa asatoo, Med'inaa Godaw yes's'ite;</para>
  <para style="q2" vid="PSA 30:4">Aa geeshsha suntsaakka galatite.<verse eid="PSA 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5" />Aa hank'k'uu guutsa wodiyaassa,</para>
  <para style="q2" vid="PSA 30:5">shin Aa keekkatetsay de'uwaa laytsaa ubbaassa.</para>
  <para style="q1" vid="PSA 30:5">K'amma yeekiidde ak'ooppe,</para>
  <para style="q2" vid="PSA 30:5">wontta zaway baynna nashshechchaa gidee.<verse eid="PSA 30:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6" />Taani woppan de'iyaa wode,</para>
  <para style="q2" vid="PSA 30:6">«Simmi taani ubbakka k'aas's'ikke» yaagaad.<verse eid="PSA 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7" />Abeet Med'inaa Godaw, neeni taw keekkeedda wode,</para>
  <para style="q2" vid="PSA 30:7">taana wolk'k'aama deriyaadan minisaade essaadda.</para>
  <para style="q1" vid="PSA 30:7">Shin neeni ne sintsa wora zaareedda wode,</para>
  <para style="q2" vid="PSA 30:7">taani dagamaad.<verse eid="PSA 30:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8" />Abeet Med'inaa Godaw, taani neena s'eesaaddi;</para>
  <para style="q2" vid="PSA 30:8">taani Med'inaa Godaakko maarotetsaw hawaadan yaagaade woossaaddi;<verse eid="PSA 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9" />«Taani hayk'k'iyaawaappe woy</para>
  <para style="q2" vid="PSA 30:9">duufuwaan geliyaawaappe ayaa demmanii?</para>
  <para style="q1" vid="PSA 30:9">Baanaw laametteedda Asay neena galatii?</para>
  <para style="q2" vid="PSA 30:9">Neeni ammanettiyaawaa odii?<verse eid="PSA 30:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10" />Abeet Med'inaa Godaw, taana neeni sisa;</para>
  <para style="q2" vid="PSA 30:10">taw k'aretta.</para>
  <para style="q1" vid="PSA 30:10">Abeet Med'inaa Godaw, neeni taw maaduwaa gida» yaagaad.<verse eid="PSA 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11" />Ta yeekuwaa yetsaw laammaadda.</para>
  <para style="q2" vid="PSA 30:11">Kayyuwaa mayuwaa taappe k'aaraade,</para>
  <para style="q2" vid="PSA 30:11">nashshechchaa taana mayzzaadda.<verse eid="PSA 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12" />Hewaa diraw, taani neena</para>
  <para style="q2" vid="PSA 30:12">sabbanaappe attina, c'o"u giikke.</para>
  <para style="q1" vid="PSA 30:12">Abeet Med'inaa Godaw ta S'oossaw,</para>
  <para style="q2" vid="PSA 30:12">taani neena med'inawukka galatana.<verse eid="PSA 30:12" /></para>
  <chapter eid="PSA 30" />
  <chapter number="31" style="c" sid="PSA 31" />
  <para style="s">Metuwaa Wode Woosaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Daawita Mazimuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1" />Abeet Med'inaa Godaw, taani neekko bak'atay;</para>
  <para style="q2" vid="PSA 31:1">awudenne taana yeellayoppa.</para>
  <para style="q2" vid="PSA 31:1">Ne s'illotetsan taana ashsha.<verse eid="PSA 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2" />Ne haytsaa taakko yegga;</para>
  <para style="q2" vid="PSA 31:2">ellekka taana ashsha.</para>
  <para style="q1" vid="PSA 31:2">Neeni taani geemmiyaa zaallaanne</para>
  <para style="q2" vid="PSA 31:2">taana ashshiyaa mino geessuwaa taw gida.<verse eid="PSA 31:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3" />Ee, neeni taw zaallaanne geessuwaa;</para>
  <para style="q2" vid="PSA 31:3">ne suntsaa diraw, neeni taana kaaletsanne ne ogiyaa bessa.<verse eid="PSA 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4" />Neeni taw geemmiyaa sa'aa gidiyaa diraw,</para>
  <para style="q2" vid="PSA 31:4">unttunttu taw k'osi wotseedda p'iriyaappe taana neeni naaga.<verse eid="PSA 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5" />Abeet Med'inaa Godaw, tumuwaa S'oossaw,</para>
  <para style="q2" vid="PSA 31:5">Taani ta shemppuwaa ne kushiyan wotsay;<note caller="-" style="x"><char style="xo" closed="false">31:5 </char><char style="xt" closed="false"><ref loc="LUK 23:46">Luk'. 23:46</ref></char></note></para>
  <para style="q2" vid="PSA 31:5">neeni taana woza.<verse eid="PSA 31:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6" />Patsenna eek'atoo goyinniyaawantta taani is's'ay;</para>
  <para style="q2" vid="PSA 31:6">shin taani Med'inaa Godaan ammanettay.<verse eid="PSA 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7" />Ta metuwaa neeni be'eedda dirawunne</para>
  <para style="q2" vid="PSA 31:7">ta tuggaa neeni ereedda diraw,</para>
  <para style="q1" vid="PSA 31:7">Taani aggena ne siik'uwaan nashettananne</para>
  <para style="q2" vid="PSA 31:7">nashshechchan nooc'u gaana.<verse eid="PSA 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8" />Neeni taana morkkiyaa kushiyan aatsaade immabaakka;</para>
  <para style="q2" vid="PSA 31:8">ta gedetookka la"atetsaa immaadda.<verse eid="PSA 31:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9" />Abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 31:9">taani metuwaan geleedda diraw, taw k'aretta.</para>
  <para style="q1" vid="PSA 31:9">Taani daro mishetteedda diraw, taani metuwaan,</para>
  <para style="q2" vid="PSA 31:9">ta ashuukka, ta shemppuukka daabureedda.<verse eid="PSA 31:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10" />Mishuwaa daruwaan ta de'uu c'ireedda;</para>
  <para style="q2" vid="PSA 31:10">ta laytsatuukka oolishin wureeddino.</para>
  <para style="q1" vid="PSA 31:10">Metuwaa daruwaan ta wolk'k'ay is's'ina;</para>
  <para style="q2" vid="PSA 31:10">ta mek'etsatuukka arggaac'eeddino.<verse eid="PSA 31:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11" />Ta morkkatuwaa ubbaw k'id'd'iyaa gidaaddi</para>
  <para style="q2" vid="PSA 31:11">taani ta shoorotoo yeellaa,</para>
  <para style="q1" vid="PSA 31:11">Taana eriyaawanttookka yashissiyaawaa gidaaddi.</para>
  <para style="q2" vid="PSA 31:11">Ogiyaan taana be'eeddawanttukka taappe bak'atiino.<verse eid="PSA 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12" />Taani hayk'k'eeddawaadan dogettaad;</para>
  <para style="q2" vid="PSA 31:12">me"ina oleedda otuwaa mala gidaaddi.<verse eid="PSA 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13" />Taani darotuwaa saasuketsaa sisaad;</para>
  <para style="q2" vid="PSA 31:13">dagamay ubbaa saani de'ee.</para>
  <para style="q1" vid="PSA 31:13">Unttunttu ta bolla shiik'inonne taana wod'anaw mak'ettiino.<verse eid="PSA 31:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14" />Shin Med'inaa Godaw, taani neenan ammanettay,</para>
  <para style="q2" vid="PSA 31:14">Neeni ta S'oossaa yaagay.<verse eid="PSA 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15" />Ta de'uwaa laytsay ne kushiyaanna.</para>
  <para style="q2" vid="PSA 31:15">Taana yederssiyaa ta morkkatuwaa kushiyaappe taana neeni ashsha.<verse eid="PSA 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16" />Ne k'oomaa bollan ne som"uwaa poo'issa;</para>
  <para style="q2" vid="PSA 31:16">aggena ne siik'uwaan taana ashsha.<verse eid="PSA 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17" />Abeet Med'inaa Godaw, taani neena s'eesiyaa diraw</para>
  <para style="q2" vid="PSA 31:17">taana yeellayoppa.</para>
  <para style="q1" vid="PSA 31:17">Shin iitatuu yeellatino;</para>
  <para style="q2" vid="PSA 31:17">unttunttu duufuwaan geliide, sirp'p'i giino.<verse eid="PSA 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18" />Otoruwaaninne kad'iyaan s'illotuwaa bolla</para>
  <para style="q2" vid="PSA 31:18">s'aliide haasayiyaa diraw,</para>
  <para style="q1" vid="PSA 31:18">Unttunttu worddotiyaa doonaa c'o"u ootsa.<verse eid="PSA 31:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19" />New yayyiyaawanttoo neeni minjjeeddanne</para>
  <para style="q2" vid="PSA 31:19">neekko bak'atiyaawanttoo asaa sintsan,</para>
  <para style="q2" vid="PSA 31:19">neeni ootseedda ne keekkatetsay ayaa daree!<verse eid="PSA 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20" />Neeni unttuntta ne sintsan geema sa'aan gentsaade,</para>
  <para style="q2" vid="PSA 31:20">asaa mak'k'uwaappe ashshaasa.</para>
  <para style="q1" vid="PSA 31:20">Neeni unttuntta ne dunkkaaniyaan k'osaade,</para>
  <para style="q2" vid="PSA 31:20">iita ins's'arssaappe ashshaasa.<verse eid="PSA 31:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21" />Taani morkkii dooddeedda katamaa giddon de'iyaa wode,</para>
  <para style="q2" vid="PSA 31:21">I taana malalissiyaa bare aggena siik'uwaa besseedda diraw,</para>
  <para style="q1" vid="PSA 31:21">Med'inaa Goday galatetto.<verse eid="PSA 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22" />Taani dagamaade,</para>
  <para style="q2" vid="PSA 31:22">«Taani ne sintsaappe kichchaad» yaagaad.</para>
  <para style="q1" vid="PSA 31:22">Shin taana maaddana mala, neena s'eeseedda wode,</para>
  <para style="q2" vid="PSA 31:22">ta waasuwaa neeni sisaadda.<verse eid="PSA 31:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23" />Hinttenoo, S'oossaa asatoo, Med'inaa Godaa siik'ite.</para>
  <para style="q2" vid="PSA 31:23">Med'inaa Goday ammanettiyaawantta naagee;</para>
  <para style="q2" vid="PSA 31:23">shin otoranchchatoo unttunttu gatiyaa wurssi c'iggee.<verse eid="PSA 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24" />Hinttenoo, Med'inaa Godaan hidootaa ootsiyaawanttoo,</para>
  <para style="q2" vid="PSA 31:24">minnitenne wozanaamite.<verse eid="PSA 31:24" /></para>
  <chapter eid="PSA 31" />
  <chapter number="32" style="c" sid="PSA 32" />
  <para style="s">Nagaraa Paas'ussaanne Maarotaa Demussaa</para>
  <para style="d">Daawite Akeekaan S'aafeedda Timirttiyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1" />Aa bayzzuu atto geetetteeddanne</para>
  <para style="q2" vid="PSA 32:1">Aa nagaray kameteedda uray anjjetteedawaa.<note caller="-" style="x"><char style="xo" closed="false">32:1-2 </char><char style="xt" closed="false"><ref loc="ROM 4:7-8">Rom. 4:7-8</ref></char></note><verse eid="PSA 32:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2" />Med'inaa Goday Aa iitatetsaa paydenna asaynne</para>
  <para style="q2" vid="PSA 32:2">Aa k'ofaan baletsu bayinna Asay anjjetteeddawaa.<verse eid="PSA 32:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3" />Ta nagaraa paas'ennan de'aadde,</para>
  <para style="q2" vid="PSA 32:3">Taani gallassaa kumentsaa ooleeddawoo</para>
  <para style="q2" vid="PSA 32:3">ta asatetsay daabureedda.<verse eid="PSA 32:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4" />Gallassinne k'amma ne kushii ta bolla dees'eedda.</para>
  <para style="q2" vid="PSA 32:4">Haatsay boniyaa awaan meliide wuriyaawaadan,</para>
  <para style="q2" vid="PSA 32:4">ta wolk'k'ay wureedda.<verse eid="PSA 32:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5" />Taani ta nagaraa new paas'aad;</para>
  <para style="q2" vid="PSA 32:5">Ta iitatetsaakka neeppe gentsabeykke;</para>
  <para style="q1" vid="PSA 32:5">«Ta bayzzuwaa Med'inaa Godaw paas'ana» gaad.</para>
  <para style="q2" vid="PSA 32:5">Yaatina, neeni taana dees'eedda nagaraa atto yaagaadda.<verse eid="PSA 32:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6" />Hewaa diraw, S'oossaa asaa gidiyaa ooninne,</para>
  <para style="q2" vid="PSA 32:6">neeni beettiyaa wode, neena woosso.</para>
  <para style="q1" vid="PSA 32:6">Wolk'k'aama haatsay kuntsiyaa wode,</para>
  <para style="q2" vid="PSA 32:6">tumuwaappe he uraa gakkenna.<verse eid="PSA 32:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7" />Neeni taw k'osettiyaa sa'aa;</para>
  <para style="q2" vid="PSA 32:7">neeni taana metuwaappe naagaasa.</para>
  <para style="q1" vid="PSA 32:7">Atotetsaa yetsaa yes's'iyaawantta ta yuushshuwaan wotsaadda.<verse eid="PSA 32:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8" />S'oossay, «Taani neena erissananne,</para>
  <para style="q2" vid="PSA 32:8">neeni baanaw bessiyaa ogiyaa neena tamaarissana;</para>
  <para style="q1" vid="PSA 32:8">Taani neena zorananne naagana.<verse eid="PSA 32:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9" />Bis'aalaaninne puuluwaan oyk'k'ettennan azazettena,</para>
  <para style="q2" vid="PSA 32:9">wozanay bayinna bak'uluwaadan</para>
  <para style="q2" vid="PSA 32:9">woy paraadan hintte hanoppite» yaagee.<verse eid="PSA 32:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10" />Iitatoo tuggay darana;</para>
  <para style="q2" vid="PSA 32:10">shin Med'inaa Godaan ammanettiyaawantta,</para>
  <para style="q2" vid="PSA 32:10">aggena siik'uu dooddana.<verse eid="PSA 32:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11" />Hinttenoo, s'illotoo,</para>
  <para style="q2" vid="PSA 32:11">Med'inaa Godaan nashetitenne «Hashshu!» giite;</para>
  <para style="q2" vid="PSA 32:11">hinttenoo, wozanaa suuretoo, nashshechchaw yes's'ite.<verse eid="PSA 32:11" /></para>
  <chapter eid="PSA 32" />
  <chapter number="33" style="c" sid="PSA 33" />
  <para style="s">Maariyaa S'oossaa Sabussaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1" />Hinttenoo, s'illotoo Med'inaa Godaw nashshechchan yes's'ite;</para>
  <para style="q2" vid="PSA 33:1">suure asatuu Aa galatanaw bessee.<verse eid="PSA 33:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2" />Maasink'k'uwaa diis's'iidde,</para>
  <para style="q2" vid="PSA 33:2">Med'inaa Godaa galatite;</para>
  <para style="q2" vid="PSA 33:2">tammu bak'etsaan waas'etteedda diitsaakka aw diis's'ite.<verse eid="PSA 33:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3" />Ooratsa yetsaa yes's'ite;</para>
  <para style="q2" vid="PSA 33:3">loytsi diis's'iidde, k'aalaa d'ok'k'issiide yes's'ite.<verse eid="PSA 33:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4" />Med'inaa Godaa k'aalay suuriyaa;</para>
  <para style="q2" vid="PSA 33:4">I ootsiyaa oosuwaa ubbay ammanettiyaawaa.<verse eid="PSA 33:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5" />Med'inaa Goday s'illotetsaanne tumu pirddaa dosee;</para>
  <para style="q2" vid="PSA 33:5">aggena Aa siik'uu sa'aa kumeedda.<verse eid="PSA 33:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6" />Med'inaa Godaa k'aalan salotuu med'etteeddino.</para>
  <para style="q2" vid="PSA 33:6">Aa doonaappe kesiyaa shemppuwaan</para>
  <para style="q2" vid="PSA 33:6">unttunttun de'iyaa med'etatuukka oosetteeddino.<verse eid="PSA 33:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7" />Wolk'k'aama abbaa haatsaa I ittisaan eelisseedda;</para>
  <para style="q2" vid="PSA 33:7">he c'iimmo haatsaa minjjaa sa'aan zeereedda.<verse eid="PSA 33:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8" />Sa'aa ubbay Med'inaa Godaa yayyo;</para>
  <para style="q2" vid="PSA 33:8">sa'aan de'iyaa Asay ubbay Aa bonchcho.<verse eid="PSA 33:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9" />Ayaw gooppe, I haasayina haneedda;</para>
  <para style="q2" vid="PSA 33:9">I azazina, minniide ek'k'eedda.<verse eid="PSA 33:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10" />Med'inaa Godaa erenna kawutetsatuwaa zoretaa S'oossay laalee;</para>
  <para style="q2" vid="PSA 33:10">unttunttu halchchuwaakka mela kesee.<verse eid="PSA 33:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11" />Med'inaa Godaa halchchuu med'inaw ek'k'iide de'ee;</para>
  <para style="q2" vid="PSA 33:11">Aa wozanaa k'ofaykka yeletaa ubbaa gakkanaw de'ee.<verse eid="PSA 33:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12" />S'oossay Med'inaa Godaa gideedda kawutetsay,</para>
  <para style="q2" vid="PSA 33:12">I baressa ootsiide dooreedda Asay anjjetteedawaa.<verse eid="PSA 33:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13" />Med'inaa Goday saluwaana duge s'eelliide,</para>
  <para style="q2" vid="PSA 33:13">asaa ubbaa be'ee.<verse eid="PSA 33:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14" />S'oossay bare de'iyaasaappe sa'aan de'iyaa ubbaa s'eellee.<verse eid="PSA 33:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15" />I unttunttu ubbaa wozanaa med'd'eedda;</para>
  <para style="q2" vid="PSA 33:15">unttunttu ootsiyaawaa ubbaa eree.<verse eid="PSA 33:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16" />Kaatii bare wotaadaraa c'oratetsan attena;</para>
  <para style="q2" vid="PSA 33:16">olanchchay bare wolk'k'aa minotetsan kessi akkena.<verse eid="PSA 33:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17" />Olaa paray s'oonissana giide naagiyaawe mela;</para>
  <para style="q2" vid="PSA 33:17">I bare wolk'k'aa minotetsan ashshanaw danddayenna.<verse eid="PSA 33:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18" />Med'inaa Godaa ayifetuu aw yayyiyaanne</para>
  <para style="q2" vid="PSA 33:18">aggena Aa siik'uwaan hidootaa ootsiyaa asatuwaa bollaanna.<verse eid="PSA 33:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19" />Hewenne, unttuntta hayk'k'uwaappe ashshanaassanne</para>
  <para style="q2" vid="PSA 33:19">koshaa wodiyaan pas'a wotsanaassa.<verse eid="PSA 33:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20" />Nuuni Med'inaa Godaan hidootaa ootseetto;</para>
  <para style="q2" vid="PSA 33:20">I nuuna maaddiyaawaanne nu gonddalliyaa.<verse eid="PSA 33:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21" />Nuuni Aa geeshsha suntsan ammanettiyaa diraw,</para>
  <para style="q2" vid="PSA 33:21">nu wozanay an nashettee.<verse eid="PSA 33:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22" />Abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 33:22">nuuni neenan hidootaa ootsiyaawaadan,</para>
  <para style="q2" vid="PSA 33:22">aggena ne siik'uu nuunanna gido.<verse eid="PSA 33:22" /></para>
  <chapter eid="PSA 33" />
  <chapter number="34" style="c" sid="PSA 34" />
  <para style="s">S'oossay Pirddiyaawaa Gidowoo Sabussaa</para>
  <para style="d">Barena yedersseedda Abimeleeka sintsappe gooyiyaawaa malatiide beedda wode, Daawita mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1" />Taani Med'inaa Godaa ubbaa wode galatana;</para>
  <para style="q2" vid="PSA 34:1">Aa galatay ay wodenne ta doonaappe pac'c'enna.<verse eid="PSA 34:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2" />Taani Med'inaa Godaan c'eek'ettay;</para>
  <para style="q2" vid="PSA 34:2">naak'etteeddawanttu hewaa sisiide nashetino.<verse eid="PSA 34:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3" />Taananna gidiide, Med'inaa Godaa gitayite.</para>
  <para style="q2" vid="PSA 34:3">Ane ittippe Aa suntsaa d'ok'k'u d'ok'k'u ootsoytte.<verse eid="PSA 34:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4" />Taani Med'inaa Godaa koyaad;</para>
  <para style="q2" vid="PSA 34:4">I taw zaareedda;</para>
  <para style="q2" vid="PSA 34:4">taani yayyiyaawaa ubbaappe taana I ashsheedda.<verse eid="PSA 34:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5" />Neekko s'eelliyaawanttu nashettiino;</para>
  <para style="q2" vid="PSA 34:5">unttunttu som"ii ubbakka yeellatenna.<verse eid="PSA 34:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6" />Ha hiyyeesaa bitanii waasseedda;</para>
  <para style="q2" vid="PSA 34:6">Med'inaa Goday Aa waasuwaa siseedda;</para>
  <para style="q1" vid="PSA 34:6">Aa metuwaa ubbaappe Aa ashsheedda.<verse eid="PSA 34:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7" />Med'inaa Godaa kiitanchchay Aa yayyiyaa asatuwaa naagee;</para>
  <para style="q2" vid="PSA 34:7">I unttunttu yuushshuwaan gidiide, unttuntta ashshee.<verse eid="PSA 34:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8" />Med'inaa Goday keeka gidiyaawaa s'eelli be'ite.<note caller="-" style="x"><char style="xo" closed="false">34:8 </char><char style="xt" closed="false"><ref loc="1PE 2:3">1 P'es'. 2:3</ref></char></note></para>
  <para style="q2" vid="PSA 34:8">Aakko bak'atiyaa Asay anjjetteeddawaa.<verse eid="PSA 34:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9" />Hinttenoo, Aa geeshsha asatoo, Med'inaa Godaw yayyite;</para>
  <para style="q2" vid="PSA 34:9">ayaw gooppe, aw yayyiyaa ubbatoo ayaynne pac'c'enna.<verse eid="PSA 34:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10" />Gaammotuukka miyaawe d'ayina koshshatiino;</para>
  <para style="q2" vid="PSA 34:10">shin Med'inaa Godaa koyiyaawanttoo lo"obay pac'c'enna.<verse eid="PSA 34:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11" />Ta tamaaretoo, haa yiite; sisite;</para>
  <para style="q2" vid="PSA 34:11">Med'inaa Godaa yashshaa taani hinttena tamaarissana.<verse eid="PSA 34:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12" />Lo"o de'uwaa de'anawunne</para>
  <para style="q2" vid="PSA 34:12">keekkabaa be'ana mala,<note caller="-" style="x"><char style="xo" closed="false">34:12-16 </char><char style="xt" closed="false"><ref loc="1PE 3:10-12">1 P'es'. 3:10-12</ref></char></note></para>
  <para style="q2" vid="PSA 34:12">bare laytsay aduk'k'anaw koyiyaa Asay oonee?<verse eid="PSA 34:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13" />Ne ins's'arssay iitabaa haasayennaadan,</para>
  <para style="q2" vid="PSA 34:13">ne doonaykka c'immeenaadan te"a.<verse eid="PSA 34:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14" />Iitaappe shaaketta; lo"obaa ootsa;</para>
  <para style="q2" vid="PSA 34:14">sarotetsaa loytsa koyaadde kaala.<verse eid="PSA 34:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15" />Med'inaa Godaa ayifii s'illotuwaakko s'eellee;</para>
  <para style="q2" vid="PSA 34:15">k'ay Aa haytsaykka unttunttu waasuwaa hayzzee.<verse eid="PSA 34:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16" />Unttuntta hassayissiyaawaa biittaappe d'ayissana mala,</para>
  <para style="q2" vid="PSA 34:16">Med'inaa Goday iitaa ootsiyaawantta,</para>
  <para style="q2" vid="PSA 34:16">bare hank'k'uwaa som"uwaan s'eellee.<verse eid="PSA 34:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17" />S'illotuu waassiino;</para>
  <para style="q2" vid="PSA 34:17">Med'inaa Goday unttunttu waasuwaa sisee.</para>
  <para style="q1" vid="PSA 34:17">I unttunttu metuwaa ubbaappe ashshee.<verse eid="PSA 34:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18" />Med'inaa Goday wozanay me"eeddawanttoo mataana;</para>
  <para style="q2" vid="PSA 34:18">k'ay barenttu hidootaa k'ans's'eeddawantta ashshee.<verse eid="PSA 34:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19" />S'illo asaa metuu dara;</para>
  <para style="q2" vid="PSA 34:19">shin Med'inaa Goday Aa he ubbaappe ashshee.<verse eid="PSA 34:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20" />S'oossay Aa mintsi naagiyaa diraw,<note caller="-" style="x"><char style="xo" closed="false">34:20 </char><char style="xt" closed="false"><ref loc="JHN 19:36">Yoh. 19:36</ref></char></note></para>
  <para style="q2" vid="PSA 34:20">Aa mek'etsaappe ittuunne me"enna.<verse eid="PSA 34:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21" />Iitatuwaa iitatetsay wod'ana;</para>
  <para style="q2" vid="PSA 34:21">s'illotuwaa is's'iyaawanttu pirddettana.<verse eid="PSA 34:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22" />Med'inaa Goday bare k'oomatuwaa ashshee.</para>
  <para style="q2" vid="PSA 34:22">Aakko bak'atiide ooninne pirddettenna.<verse eid="PSA 34:22" /></para>
  <chapter eid="PSA 34" />
  <chapter number="35" style="c" sid="PSA 35" />
  <para style="s">Naak'eteedda Asaa Woosaa</para>
  <para style="d">Daawita Mazimuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1" />Abeet Med'inaa Godaw, taananna ek'ettiyaawanttuna neeni ek'etta;</para>
  <para style="q2" vid="PSA 35:1">taananna olettiyaawanttuna neeni oletta.<verse eid="PSA 35:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2" />Gonddalliyaanne hara olaa miishshaa oyk'k'aade,</para>
  <para style="q2" vid="PSA 35:2">taana maaddanaw dendda.<verse eid="PSA 35:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3" />Taana yederssiyaawanttu bollan</para>
  <para style="q2" vid="PSA 35:3">ne tooraanne mashshaa dentsa.</para>
  <para style="q1" vid="PSA 35:3">Taana, «Taani neena ashshiyaawaa» yaaga.<verse eid="PSA 35:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4" />Ta shemppuwaa wod'anaw koyiyaawanttu,</para>
  <para style="q2" vid="PSA 35:4">yeellatinonne kawushino;</para>
  <para style="q2" vid="PSA 35:4">ta bolla iitabaa mak'ettiyaawanttu kawushiide guyye simmino.<verse eid="PSA 35:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5" />Med'inaa Godaa kiitanchchay unttuntta yederssiyaa wode,</para>
  <para style="q2" vid="PSA 35:5">unttunttu c'arkkuwaa sintsan de'iyaa suullaadan hanino.<verse eid="PSA 35:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6" />Med'inaa Goda kiitanchchay,</para>
  <para style="q2" vid="PSA 35:6">unttuntta dechchana haniyaa wode,</para>
  <para style="q2" vid="PSA 35:6">unttunttu ogii d'umaanne halitsaa gido.<verse eid="PSA 35:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7" />C'oo taana oyk'k'anaw barenttu p'iriyaa wotseeddino;</para>
  <para style="q2" vid="PSA 35:7">k'aykka c'oo taana kunddisanaw ollaa bookkeeddino.<verse eid="PSA 35:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8" />Erennan de'ishiina, unttunttu bollan bashshay puttu go.</para>
  <para style="q2" vid="PSA 35:8">Unttunttu wotseedda p'irii unttuntta oyk'k'o;</para>
  <para style="q2" vid="PSA 35:8">unttunttu bashshaa ollaan kunddino.<verse eid="PSA 35:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9" />He wode taani Med'inaa Godaan nashettana;</para>
  <para style="q2" vid="PSA 35:9">I ashsheeda diraw, taani nashshechchaa nooc'u gaana.<verse eid="PSA 35:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10" />Ta kumentsaa asatetsay neena,</para>
  <para style="q2" vid="PSA 35:10">«Abeet Med'inaa Godaw, ne mali oonee?</para>
  <para style="q1" vid="PSA 35:10">Hiyyeesaa wolk'k'aama kushiyaappe wotsa akkaasa.</para>
  <para style="q2" vid="PSA 35:10">Hiyyeesaanne metootanchchaa bonk'k'i miyaawanttu kushiyaappe ashshaasa» yaagana.<verse eid="PSA 35:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11" />Wordduwaa markkattiyaawanttu ta bolla denddiino.</para>
  <para style="q2" vid="PSA 35:11">Taani erennaban taana mootiino.<verse eid="PSA 35:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12" />Taani lo"uwaa ootseeddawaa kushiyaa iitaa zaariino;</para>
  <para style="q2" vid="PSA 35:12">yaatina, taani taarekka ataad.<verse eid="PSA 35:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13" />Shin taani unttunttu harggeedda wode,</para>
  <para style="q2" vid="PSA 35:13">maak'aa mayyaad; ta asatetsaa s'oomaan daaburssaad.</para>
  <para style="q1" vid="PSA 35:13">Ta woossay zaaruwaa demenan atteedda.<verse eid="PSA 35:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 35:14" />Ta huup'iyaa zik'k'i ootsaade, ta dabboo,</para>
  <para style="q2" vid="PSA 35:14">woy ta ishaw yeekkiyaawaadan yeekkaad.</para>
  <para style="q1" vid="PSA 35:14">Itti Asay bare aattiw kayyottiyaawaadan ta huup'iyaa oyk'k'aade,</para>
  <para style="q2" vid="PSA 35:14">yeekkaade hamettaad.<verse eid="PSA 35:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15" />Shin unttunttu taani d'ubetteeddawaan nashettiide,</para>
  <para style="q2" vid="PSA 35:15">ta bolla shiik'eeddino.</para>
  <para style="q1" vid="PSA 35:15">Taani erenna gaasuwaan taana wad'd'iide,</para>
  <para style="q2" vid="PSA 35:15">aguwaa is's'eeddino.<verse eid="PSA 35:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16" />Iita Asay k'iliic'iyaawaadan unttunttu taana k'iliic'iino;</para>
  <para style="q2" vid="PSA 35:16">unttunttu yilotiide, barenttu achchaa garc'c'eeddino.<verse eid="PSA 35:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17" />Abeet S'oossaw, neeni awude gakkanaw</para>
  <para style="q2" vid="PSA 35:17">c'o"u gaade s'eellay?</para>
  <para style="q1" vid="PSA 35:17">Unttunttu iita oosuwaappe taana ashsha;</para>
  <para style="q2" vid="PSA 35:17">ha gaammotuwaa mala asatuwaappe ta al"o shemppuwaa ashshaa.<verse eid="PSA 35:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18" />He wode gita shiik'uwaan taani new galataa immana;</para>
  <para style="q2" vid="PSA 35:18">c'ora asaa shiik'uwaan taani neena sabbana.<verse eid="PSA 35:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19" />Gaasuu baynnaan taana morkkiyaawanttu nashettoppino;<note caller="-" style="x"><char style="xo" closed="false">35:19 </char><char style="xt" closed="false"><ref loc="PSA 69:4">Maz. 69:4</ref>; <ref loc="JHN 15:25">Yoh. 15:25</ref></char></note></para>
  <para style="q2" vid="PSA 35:19">taana c'oo is's'iyaawanttu ta bolla sim"etoppino.<verse eid="PSA 35:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20" />Unttunttu sarobaa haasayiyaawaa aggiide,</para>
  <para style="q2" vid="PSA 35:20">Biittan c'o"u giide de'iyaa asatuwaa bollan</para>
  <para style="q2" vid="PSA 35:20">wordduwaa med'd'iide haasayiino.<verse eid="PSA 35:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21" />Unttunttu barenttu ins's'arssaa ta bolla k'arayiide,</para>
  <para style="q2" vid="PSA 35:21">«Ee, ee, neeni ootseeddawaa</para>
  <para style="q2" vid="PSA 35:21">nuuni nu ayifiyaan be'eeddo» yaagiino.<verse eid="PSA 35:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22" />Abeet Med'inaa Godaw, neeni hawaa be'aade;</para>
  <para style="q2" vid="PSA 35:22">c'o"u gooppa.</para>
  <para style="q1" vid="PSA 35:22">Abeet S'oossaw, neeni taappe haakkoppa.<verse eid="PSA 35:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23" />Abeet ta Godaw, ta S'oossaw,</para>
  <para style="q2" vid="PSA 35:23">Ta diraw dendda; beegota</para>
  <para style="q2" vid="PSA 35:23">ta doonaa gidaade mootetta.<verse eid="PSA 35:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24" />Abeet Med'inaa Godaw, ta S'oossaw,</para>
  <para style="q2" vid="PSA 35:24">ne s'illotetsan taana shatintsaa;</para>
  <para style="q2" vid="PSA 35:24">ta morkkatuwaa nashechchoppa.<verse eid="PSA 35:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25" />Unttunttu barenttoo, «Hashshu, hashshu,</para>
  <para style="q2" vid="PSA 35:25">nuuni nu wozanaan amotteeddawaa gatseeddo.</para>
  <para style="q1" vid="PSA 35:25">Nuuni Aa mitteeddo» gaanaadan ootsoppa.<verse eid="PSA 35:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26" />Ta waayiyaan nashettiyaawanttu ubbay</para>
  <para style="q2" vid="PSA 35:26">yeellatinonne kawushino.</para>
  <para style="q1" vid="PSA 35:26">Ta bollan otorettiyaawanttu</para>
  <para style="q2" vid="PSA 35:26">yeellaanne kawushshaa mayno.<verse eid="PSA 35:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27" />Taani shatimmiyaawaa dosiyaawanttu</para>
  <para style="q2" vid="PSA 35:27">nashettiide, «Hashshu!» giino.</para>
  <para style="q1" vid="PSA 35:27">Unttunttu ubbaa gede, «Bare k'oomaa sarotetsaan</para>
  <para style="q2" vid="PSA 35:27">nashetiyaa Med'inaa Goday gitato» yaagino.<verse eid="PSA 35:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28" />Gallassaa kumentsan ta ins's'arssay,</para>
  <para style="q2" vid="PSA 35:28">ne s'illotetsaabaanne ne galataabaa odana.<verse eid="PSA 35:28" /></para>
  <chapter eid="PSA 35" />
  <chapter number="36" style="c" sid="PSA 36" />
  <para style="s">Nagaranchcha Iitatetsaanne S'oossaa Lo"otetsa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Med'inaa Godaa K'oomaa Daawita Mazimuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1" />Iita Asay bare wozanaan de'iyaa iitatetsaa kooshshaa hayzzee.<note caller="-" style="x"><char style="xo" closed="false">36:1 </char><char style="xt" closed="false"><ref loc="ROM 3:18">Rom. 3:18</ref></char></note></para>
  <para style="q2" vid="PSA 36:1">S'oossaw yayyiyaawe Aa k'ofaan baawa.<verse eid="PSA 36:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2" />Ayaw gooppe, I barena loytsi nashshee;</para>
  <para style="q2" vid="PSA 36:2">hewoo I bare nagaraa demmanawunne is's'anaw danddayenna.<verse eid="PSA 36:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3" />Aa doonaappe kesiyaa haasayay geniyaanne wordduwaa.</para>
  <para style="q2" vid="PSA 36:3">Aad'd'eeda eraabaanne lo"obaa ootsiyaawaa I aggeeda.<verse eid="PSA 36:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4" />I bare hiis'an de'iiddekka geniyaabaa ootsanaw halchchee.</para>
  <para style="q2" vid="PSA 36:4">I lo"o gidenna ogiyaan ek'k'eedda;</para>
  <para style="q1" vid="PSA 36:4">I iitabaa is's'enna.<verse eid="PSA 36:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5" />Abeet Med'inaa Godaw, aggena ne siik'uu salotuwaa gakkee;</para>
  <para style="q2" vid="PSA 36:5">ne tumatetsaykka bolla shaariyaadan d'ok'k'ee.<verse eid="PSA 36:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6" />Ne s'illotetsay ubbaappe d'ok'k'a deretuwaa mala;</para>
  <para style="q2" vid="PSA 36:6">ne pirddaykka ubbaappe zik'k'a c'iimmaa mala.</para>
  <para style="q1" vid="PSA 36:6">Abeet Med'inaa Godaw, neeni asaakka do'aakka naagaasa.<verse eid="PSA 36:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7" />Abeet S'oossaw, aggena ne siik'uu ayiba al"obee!</para>
  <para style="q2" vid="PSA 36:7">Asay ne k'efiyaa giddo bak'ati attee.<verse eid="PSA 36:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8" />Unttunttu ne soo gidon palaho maaddappe miide kalliino;</para>
  <para style="q2" vid="PSA 36:8">ne keekkatetsaa shaafaappe neeni unttuntta ushshaasa.<verse eid="PSA 36:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9" />Ayaw gooppe, de'uwaa pulttuu ne matan de'ee;</para>
  <para style="q2" vid="PSA 36:9">Ne poo'uwaan nuuni poo'uwaa be'eetto.<verse eid="PSA 36:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10" />Neena eriyaawantta neeni siik'iyaa siik'uwaanne</para>
  <para style="q2" vid="PSA 36:10">suuretoo keekkiyaa keekaa aggoppa.<verse eid="PSA 36:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11" />Otoranchcha gedii taana yed'd'oppo;</para>
  <para style="q2" vid="PSA 36:11">nagaranchchatuwaa kushii taana yederssoppo.<verse eid="PSA 36:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12" />Iita asatuu kunddeeddawantta be'ite;</para>
  <para style="q2" vid="PSA 36:12">unttunttu kunddeeddino; denddanawukka danddaykkino.<verse eid="PSA 36:12" /></para>
  <chapter eid="PSA 36" />
  <chapter number="37" style="c" sid="PSA 37" />
  <para style="s">Iitatuwaanne Lo"atuwaa Wurssetsaa</para>
  <para style="d">Daawita Mazimuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1" />Iitaa ootsiyaawanttu diraw yilotoppa.</para>
  <para style="q2" vid="PSA 37:1">Nagaraa ootsiyaawantta k'anaattoppa.<verse eid="PSA 37:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2" />Ayaw gooppe, unttunttu maataadan ellekka melana;</para>
  <para style="q2" vid="PSA 37:2">shulleedda bonc'c'iyaadan unttunttu k'ok'k'ofetana.<verse eid="PSA 37:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3" />Neeni Med'inaa Godaan ammanetta; lo"obaa ootsa.</para>
  <para style="q2" vid="PSA 37:3">Yaataade biittan palahina de'a.<verse eid="PSA 37:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4" />Med'inaa Godaan nashetta;</para>
  <para style="q2" vid="PSA 37:4">I new ne wozanaa amuwaa immana.<verse eid="PSA 37:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5" />Ne ogiyaa hadaraa Med'inaa Godaw imma.</para>
  <para style="q2" vid="PSA 37:5">An ammanetta; I new ootsana.<verse eid="PSA 37:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6" />I ne s'illotetsaa wontta s'alk'k'iyaadan,</para>
  <para style="q2" vid="PSA 37:6">k'ay ne yewuwaa pirddaa gallassaa seeta awaadan poo'issana.<verse eid="PSA 37:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7" />Med'inaa Godaa sintsan c'o"u gaade,</para>
  <para style="q2" vid="PSA 37:7">I ootsanaw, danddayan naaga.</para>
  <para style="q1" vid="PSA 37:7">Unttunttu iita halchchuu polettina,</para>
  <para style="q2" vid="PSA 37:7">duretteedda asatuwaa bolla yilotoppa.<verse eid="PSA 37:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8" />Hank'k'uwaa agga; yiluwaappe te'etta.</para>
  <para style="q2" vid="PSA 37:8">Yilotoppa; ayaw gooppe, hewe metuwaan yeggee.<verse eid="PSA 37:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9" />Iitaa ootsiyaawanttu d'ok'ollettiide d'ayana;</para>
  <para style="q2" vid="PSA 37:9">shin Med'inaa Godaan hidootaa ootsiyaawanttu biittaa laattana.<verse eid="PSA 37:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10" />Iitaa ootsiyaawanttu guutsa wodiyaappe guyyiyaan de'ikkino;</para>
  <para style="q2" vid="PSA 37:10">neeni unttuntta koyinttokka unttunttu beettikkino.<verse eid="PSA 37:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11" />Shin ashkketuu biittaa laattana;<note caller="-" style="x"><char style="xo" closed="false">37:11 </char><char style="xt" closed="false"><ref loc="MAT 5:5">Mat. 5:5</ref></char></note></para>
  <para style="q2" vid="PSA 37:11">unttunttu gitaa sarotetsaan nashettiide de'ana.<verse eid="PSA 37:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12" />Iita Asay s'illo asaa bolla mak'etteenne</para>
  <para style="q2" vid="PSA 37:12">bare achchaa garc'c'ee.<verse eid="PSA 37:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13" />Shin Goday iitatuwaa bollan miic'c'ee;</para>
  <para style="q2" vid="PSA 37:13">ayaw gooppe, unttunttu pirddaa gallassay yiyaawaa I eree.<verse eid="PSA 37:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14" />Iita asatuu hiyyeesatuwaanne metootanchchatuwaa ungganawunne</para>
  <para style="q2" vid="PSA 37:14">suuretetsan hamettiyaawantta wod'anaw,</para>
  <para style="q1" vid="PSA 37:14">Barenttu mashshaa shoddeeddinonne</para>
  <para style="q2" vid="PSA 37:14">barenttu wonddaafiyaa dafeeddino.<verse eid="PSA 37:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15" />Shin unttunttu mashshay unttunttu wozana ayifiyaan gelana;</para>
  <para style="q2" vid="PSA 37:15">unttunttu wonddaafiikka me"ana.<verse eid="PSA 37:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16" />S'illoo de'iyaa guutsabay</para>
  <para style="q2" vid="PSA 37:16">c'ora iita asatoo de'iyaa darobaappe lo"a.<verse eid="PSA 37:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17" />Ayaw gooppe, iitatuwaa wolk'k'ay me"ana;</para>
  <para style="q2" vid="PSA 37:17">shin s'illotuwaa Med'inaa Goday zemppissee.<verse eid="PSA 37:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18" />Suure asatuwaa ogiyaa Med'inaa Goday eree;</para>
  <para style="q2" vid="PSA 37:18">unttunttu laataykka med'inaw unttunttuwaa gidana.<verse eid="PSA 37:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19" />Iita wodiyaan suure asatuu yeellatikkino;</para>
  <para style="q2" vid="PSA 37:19">koshaa wodiyaan unttunttu kallana.<verse eid="PSA 37:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20" />Shin iita asatuu hayk'k'ana.</para>
  <para style="q2" vid="PSA 37:20">Med'inaa Godaa morkketuu gam"enna dembbaa c'iishshaa mala;</para>
  <para style="q2" vid="PSA 37:20">unttunttu c'uwaadan d'ayana.<verse eid="PSA 37:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21" />Iita Asay tal"i akkiide c'iggena;</para>
  <para style="q2" vid="PSA 37:21">shin s'illo Asay k'arettiide immee.<verse eid="PSA 37:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22" />Med'inaa Godaan anjjetteedawanttu biittaa laattana;</para>
  <para style="q2" vid="PSA 37:22">shin shek'k'etteeddawanttu d'ok'olletti d'ayana.<verse eid="PSA 37:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23" />Asaa ogii Med'inaa Godaa nashechchooppe,</para>
  <para style="q2" vid="PSA 37:23">Goday Aa tangguwaa kaaletseenne minisee.<verse eid="PSA 37:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24" />I d'ubettooppekka kunddenna;</para>
  <para style="q2" vid="PSA 37:24">ayaw gooppe, Med'inaa Goday Aa kushiyaa oyk'k'iide zemppisee.<verse eid="PSA 37:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25" />Taani kase yalaga; ha"i simmi c'imaad;</para>
  <para style="q2" vid="PSA 37:25">shin s'illo Asay c'oo attina,</para>
  <para style="q2" vid="PSA 37:25">woy Aa naanatuu miyaawaa d'ayi woosishin,</para>
  <para style="q2" vid="PSA 37:25">taani ubbakka be'a erikke.<verse eid="PSA 37:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26" />I ubbaa wodekka keeka;</para>
  <para style="q2" vid="PSA 37:26">c'oo tal"ee.</para>
  <para style="q1" vid="PSA 37:26">Aa naanatuukka haratoo anjjo gidanawantta.<verse eid="PSA 37:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27" />Iitaappe haakka; lo"obaa ootsa.</para>
  <para style="q2" vid="PSA 37:27">Yaatooppe, neeni adussa laytsaa de'ana.<verse eid="PSA 37:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28" />Ayaw gooppe, Med'inaa Goday s'illobaa dosee.</para>
  <para style="q2" vid="PSA 37:28">S'oossaa asatuwaa I aggena;</para>
  <para style="q2" vid="PSA 37:28">s'illotuu med'inaw naagettiino.</para>
  <para style="q2" vid="PSA 37:28">Shin iitatuwaa zeretsay d'ok'ollettana.<verse eid="PSA 37:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29" />S'illotuu biittaa laattananne</para>
  <para style="q2" vid="PSA 37:29">yaan med'inaw de'ana.<verse eid="PSA 37:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30" />S'illuwaa doonay aad'd'eeda eraa odee;</para>
  <para style="q2" vid="PSA 37:30">Aa ins's'arssaykka s'illobaa haasayee.<verse eid="PSA 37:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31" />Aa S'oossaa higgii Aa wozanaan de'ee;</para>
  <para style="q2" vid="PSA 37:31">Aa gediikka aappe halis's'ena.<verse eid="PSA 37:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32" />Iita Asay s'illo asaa wochcheenne</para>
  <para style="q2" vid="PSA 37:32">wod'anaw koyee.<verse eid="PSA 37:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33" />Shin Med'inaa Goday s'illo asaa Aa kushiyan aggena;</para>
  <para style="q2" vid="PSA 37:33">pirddaw ek'k'iyaa wodekka Aa bolla pirddissenna.<verse eid="PSA 37:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34" />Med'inaa Godaan hidootaa wotsaade, Aa ogiyaa naaga.</para>
  <para style="q2" vid="PSA 37:34">Neeni biittaa laattana mala,</para>
  <para style="q1" vid="PSA 37:34">I neena darssana.</para>
  <para style="q2" vid="PSA 37:34">Iita asatuu d'ok'ollettiide d'ayishina,</para>
  <para style="q2" vid="PSA 37:34">neeni be'ana.<verse eid="PSA 37:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35" />Taani itti dagantsiyaa iita bitaniyaa,</para>
  <para style="q2" vid="PSA 37:35">wolaadan daasheeddawaa be'aad.<verse eid="PSA 37:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36" />Shin taani he saanna</para>
  <para style="q2" vid="PSA 37:36">simmaade aad'd'iyaa wode I d'ayeedda;</para>
  <para style="q1" vid="PSA 37:36">Koyinakka I beettibeenna.<verse eid="PSA 37:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37" />Ane lo"o asaa akeeka; suure asaa be'a;</para>
  <para style="q2" vid="PSA 37:37">ayaw gooppe, saro asaw poluu lo"ana.<verse eid="PSA 37:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38" />Shin bayzzanchchatuu ubbaa d'ayana;</para>
  <para style="q2" vid="PSA 37:38">iitatuwaa poluukka d'ok'olletti d'ayana.<verse eid="PSA 37:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39" />S'illotuwaa atotetsay Med'inaa Godaappe yee;</para>
  <para style="q2" vid="PSA 37:39">metuwaa wode I unttunttoo naagetti attiyaa sa'aa.<verse eid="PSA 37:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40" />Med'inaa Goday s'illotuwaa maaddeenne ashshee.</para>
  <para style="q2" vid="PSA 37:40">Unttunttu aakko bak'ateedda diraw,</para>
  <para style="q1" vid="PSA 37:40">I unttuntta iitatuwaappe wotsi akkeenne ashshee.<verse eid="PSA 37:40" /></para>
  <chapter eid="PSA 37" />
  <chapter number="38" style="c" sid="PSA 38" />
  <para style="s">Un"eteedda Asaa Woosaa</para>
  <para style="d">Daawita hassayissiyaawaa mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1" />Abeet Med'inaa Godaw, ne hank'k'uwaan taana seeroppa;</para>
  <para style="q2" vid="PSA 38:1">ne yiluwaan taana muroppa.<verse eid="PSA 38:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2" />Ne wonddaafiyaa pootsay taana c'addi diggeeddino;</para>
  <para style="q2" vid="PSA 38:2">ne kushiikka taana naak'k'i oyk'k'eedda.<verse eid="PSA 38:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3" />Neeni lanc'c'eedda diraw, ta bollay pas'a gidena;</para>
  <para style="q2" vid="PSA 38:3">ta nagaraa diraw, ta asatetsay sara gidenna.<verse eid="PSA 38:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4" />Ta iitatetsay di'uwaadan taana muukkeedda;</para>
  <para style="q2" vid="PSA 38:4">denddenna wolk'k'aama tookuwaadan taw dees'eedda.<verse eid="PSA 38:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5" />Taani nagaraa ootseedda eeyyatetsaa diraw,</para>
  <para style="q2" vid="PSA 38:5">ta madutsay giishshaa oyk'k'iide s'ink'k'eedda.<verse eid="PSA 38:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6" />Taan hokkaadinne k'uunnaad.</para>
  <para style="q2" vid="PSA 38:6">Gallassaa kumentsaa yeekkaade peeshaad.<verse eid="PSA 38:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7" />Ta ashuwaa mishuu s'uuggee;</para>
  <para style="q2" vid="PSA 38:7">ta bollay pas'a gidena.<verse eid="PSA 38:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8" />Taani daaburaaddinne nippi gaad;</para>
  <para style="q2" vid="PSA 38:8">ta wozanay diddik'iyaa diraw oolay.<verse eid="PSA 38:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9" />Abeet S'oossaw, ta amuu ubbay new erettee;</para>
  <para style="q2" vid="PSA 38:9">taani ooliyaawe neeppe geemmibeenna.<verse eid="PSA 38:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10" />Ta wozana ayifiyaan diddik'ee;</para>
  <para style="q2" vid="PSA 38:10">ta wolk'k'ay is's'ina;</para>
  <para style="q1" vid="PSA 38:10">Ta ayifiikka s'eelaa is's'eedda.<verse eid="PSA 38:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11" />Ta maytsaa diraw,</para>
  <para style="q2" vid="PSA 38:11">ta shoorotuukka ta laggetuukka haakuwaan ek'k'eeddino.</para>
  <para style="q1" vid="PSA 38:11">Ta dabbotuukka taappe haakkeeddino.<verse eid="PSA 38:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12" />Taana wod'anaw koyiyaawanttu,</para>
  <para style="q2" vid="PSA 38:12">barenttu p'iriyaa taw yeggiino.</para>
  <para style="q1" vid="PSA 38:12">Taana k'ohanaw koyiyaawanttu,</para>
  <para style="q2" vid="PSA 38:12">«ek'k'ashsha; nuuni neena demmana» yaagiide,</para>
  <para style="q2" vid="PSA 38:12">manddiinonne gallassaa kumentsaa ta bolla yaa'iino.<verse eid="PSA 38:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13" />He wode taani tulle asaa mala, sisikke;</para>
  <para style="q2" vid="PSA 38:13">taani duude asaa mala, doonaanne pokikke.<verse eid="PSA 38:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14" />Ee, taani sisennanne</para>
  <para style="q2" vid="PSA 38:14">doonay zaarenna asaa mala.<verse eid="PSA 38:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15" />Shin abeet Med'inaa Godaw, taani neenan hidootaa ootsay.</para>
  <para style="q2" vid="PSA 38:15">Abeet Med'inaa Godaw, ta S'oossaw, neeni taw zaaruwaa immana.<verse eid="PSA 38:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16" />Taani S'oossaa, «Ta gedii d'ubettina,</para>
  <para style="q2" vid="PSA 38:16">unttunttu, ‹Aw hashshu› gaanaadaaninne</para>
  <para style="q2" vid="PSA 38:16">ta bolla c'eek'ettanaadan ootsoppa» yaagay.<verse eid="PSA 38:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17" />Taani kunddana hanay;</para>
  <para style="q2" vid="PSA 38:17">ta sakuukka taana yeddennan is's'eedda.<verse eid="PSA 38:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18" />Taani ta iita oosuwaa paas'ay;</para>
  <para style="q2" vid="PSA 38:18">taani ta nagaraa gaasuwaan kayyotay.<verse eid="PSA 38:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19" />Ta morkketuu goobanne wolk'k'aama;</para>
  <para style="q2" vid="PSA 38:19">taana c'oo is's'iyaawanttu c'ora.<verse eid="PSA 38:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20" />Taani lo"obaa ootsina,</para>
  <para style="q2" vid="PSA 38:20">taw iitaa zaariyaa asatuu,</para>
  <para style="q1" vid="PSA 38:20">Taani lo"obaa kaalliyaa diraw, taana ek'k'etiino.<verse eid="PSA 38:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21" />Abeet Med'inaa Godaw, taana yeggoppa.</para>
  <para style="q2" vid="PSA 38:21">Abeet ta S'oossaw, taappe neeni haakkoppa.<verse eid="PSA 38:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22" />Abeet Med'inaa Godaw, taana ashshiyaawoo,</para>
  <para style="q2" vid="PSA 38:22">taana maaddanaw elleella.<verse eid="PSA 38:22" /></para>
  <chapter eid="PSA 38" />
  <chapter number="39" style="c" sid="PSA 39" />
  <para style="s">Metuu Gakka Asaa Paas'etsaa</para>
  <para style="d">Daawite Zammaaretuwaa Kaappuwaa Juddutoo Yes's'eedda Amanuwaa K'aalaa (1 Od. 25:3)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 39:1" />Taani, «Ta ins's'arssan nagaraa ootsennaadan,</para>
  <para style="q2" vid="PSA 39:1">ta ogiyaa naagana.</para>
  <para style="q2" vid="PSA 39:1">Iita asatuu ta sintsan de'iyaa wode,</para>
  <para style="q2" vid="PSA 39:1">ta doonaa barana» yaagaad.<verse eid="PSA 39:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2" />Shin taani duudiyaadan c'o"u gaad;</para>
  <para style="q2" vid="PSA 39:2">taani haray atto lo"obaa haasayiyaawaakka aggina,</para>
  <para style="q1" vid="PSA 39:2">Ta waayii yaa dareedda.<verse eid="PSA 39:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 39:3" />Ta wozanay ta garssan seeleedda;</para>
  <para style="q2" vid="PSA 39:3">ta k'ofay poddu giide, ees's'i keseedda.</para>
  <para style="q2" vid="PSA 39:3">Yaatina, ta ins's'arssan hawaadan yaagaad:<verse eid="PSA 39:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4" />«Abeet Med'inaa Godaw, ta de'uwaa wurssetsaanne</para>
  <para style="q2" vid="PSA 39:4">ta de'anaw atteedda gallassaa taana bessa.</para>
  <para style="q1" vid="PSA 39:4">K'ay ta de'uu wuranaw ay keeshshaa elleellintto, taana erissa.<verse eid="PSA 39:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5" />Neeni ta laytsaa s'ii takkaad'e keeshshaa kessaadda.</para>
  <para style="q2" vid="PSA 39:5">Ta laytsay ne sintsan bayinnawaa mala;</para>
  <para style="q2" vid="PSA 39:5">tumuwaappe Asay ubbay itti gede shemppiyaa c'arkkuwaa mala.<verse eid="PSA 39:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6" />Tumuwaappe Asay eeshuwaadan hamettee;</para>
  <para style="q2" vid="PSA 39:6">tumuwaappe c'oo mela simerettee.</para>
  <para style="q1" vid="PSA 39:6">I mas'uwaa shiishshee; shin akkana asaa erenna.<verse eid="PSA 39:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7" />«Abeet Godaw, ha"i simmi,</para>
  <para style="q2" vid="PSA 39:7">taani naagiyaawe ayee?</para>
  <para style="q1" vid="PSA 39:7">Taani hidootaa ootsiyaawe neenana.<verse eid="PSA 39:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8" />Ta bayzzuwaa ubbaappe taana ashsha;</para>
  <para style="q2" vid="PSA 39:8">eeyyatuwaan taana tooshissoppa.<verse eid="PSA 39:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9" />Hawaa ubbaa ootseeddawe</para>
  <para style="q2" vid="PSA 39:9">neena gidiyaa diraw, taani duudaad;</para>
  <para style="q1" vid="PSA 39:9">Doonaanne pogabeykke.<verse eid="PSA 39:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10" />Ne boshaa ta bollaappe dentsa.</para>
  <para style="q2" vid="PSA 39:10">Ne kushiyaa minotetsaa gaasuwaan taani daaburaad.<verse eid="PSA 39:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11" />Neeni asaa Aa nagaraa diraw, seeraasanne muraasa;</para>
  <para style="q2" vid="PSA 39:11">Aa al"o shemppuwaa bil"aadan wurssaasa.</para>
  <para style="q1" vid="PSA 39:11">Tumuwaappe Asay ubbay itti gede c'arkkiyaa c'arkkuwaa mala.<verse eid="PSA 39:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12" />«Abeet Med'inaa Godaw, ta woosaa sisa;</para>
  <para style="q2" vid="PSA 39:12">taana maaddanaw ta waasuwaa hayzza.</para>
  <para style="q1" vid="PSA 39:12">Ta afotsaa c'o"u gooppa;</para>
  <para style="q2" vid="PSA 39:12">ayaw gooppe, taani ta aawotuwaa ubbaadan betenne imatsaa gidaade,</para>
  <para style="q2" vid="PSA 39:12">neenana de'ay.<verse eid="PSA 39:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13" />Taani shaakkettanaappenne d'ayanaappe,</para>
  <para style="q2" vid="PSA 39:13">kasetaade nashettana mala,</para>
  <para style="q2" vid="PSA 39:13">ha"i taana agga» yaagaad.<verse eid="PSA 39:13" /></para>
  <chapter eid="PSA 39" />
  <chapter number="40" style="c" sid="PSA 40" />
  <para style="s">Galataa Mazimuriyaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Daawita Mazimuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1" />Taani Med'inaa Godaa danddayan naagaad;</para>
  <para style="q2" vid="PSA 40:1">I taakko simmiide, ta waasuwaa siseedda.<verse eid="PSA 40:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2" />Bashshaa ollaappe, halitsiyaa urk'k'aappe taana kesseedda.</para>
  <para style="q2" vid="PSA 40:2">Ta gediyaa zaallaa bollan esseedda;</para>
  <para style="q2" vid="PSA 40:2">k'ay ta hametsaakka saruwaa ootseedda.<verse eid="PSA 40:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3" />I ta doonaan ooratsa yetsaa wotseedda;</para>
  <para style="q2" vid="PSA 40:3">he yetsaynne, «Nu S'oossay galatetto» yaagiyaawaa.</para>
  <para style="q1" vid="PSA 40:3">Darotuu be'iide, yayananne Med'inaa Godan ammanettana.<verse eid="PSA 40:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4" />Med'inaa Godaa barew ammanettiyaawaa ootseedda asay,</para>
  <para style="q2" vid="PSA 40:4">otoranchchatuwaakko s'eelennawenne,</para>
  <para style="q2" vid="PSA 40:4">worddanchchatuwaakko simmenna Asay anjjetteeddawaa.<verse eid="PSA 40:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5" />Abeet Med'inaa Godaw, ta S'oossaw,</para>
  <para style="q2" vid="PSA 40:5">neeni daro malalissiyaabaa ootsaadda;</para>
  <para style="q1" vid="PSA 40:5">Neenana likkettiyaawe ooninne baawa!</para>
  <para style="q2" vid="PSA 40:5">Neeni nuw k'oppeedda lo"o k'ofaa</para>
  <para style="q2" vid="PSA 40:5">ooninne paydanaw danddayenna.</para>
  <para style="q2" vid="PSA 40:5">Hewe taani odina, wuriyaawaa gidenna.<verse eid="PSA 40:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6" />Neeni yarshshuwaanne imuwaa koyabaakka;<note caller="-" style="x"><char style="xo" closed="false">40:6-8 </char><char style="xt" closed="false"><ref loc="HEB 10:5-7">Ibr. 10:5-7</ref></char></note></para>
  <para style="q2" vid="PSA 40:6">shin sisana mala, taw haytsaa dooyaadda.</para>
  <para style="q1" vid="PSA 40:6">S'uuggiyaa yarshshuwaanne nagaraa yarshshuwaa neeni koyabaakka.<verse eid="PSA 40:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7" />Hewaappe guyyiyaan taani, «S'aatsaa mas'aafan</para>
  <para style="q2" vid="PSA 40:7">tabay s'aafetteeddawaadan, taani yaad.<verse eid="PSA 40:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8" />Abeet ta S'oossaw, taani neeni koyiyaawaa ootsanaw dosay;</para>
  <para style="q2" vid="PSA 40:8">ne higgii ta wozanaa giddon de'ee» yaagaad.<verse eid="PSA 40:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9" />Wolk'k'aama shiik'uwaan taani, «Ne s'illotetsaa»</para>
  <para style="q2" vid="PSA 40:9">mishiraachchuwaa odana.</para>
  <para style="q1" vid="PSA 40:9">Abeet Med'inaa Godaw, neeni eriyaawaadankka,</para>
  <para style="q2" vid="PSA 40:9">taani ta doonaan odiyaawaa aggabeyikke.<verse eid="PSA 40:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10" />Taani ne s'illotetsaa ta wozanaa giddon k'osabeykke;</para>
  <para style="q2" vid="PSA 40:10">neeni ammanettiyaawaanne ashshiyaawaa odaad.</para>
  <para style="q1" vid="PSA 40:10">K'ay aggena ne siik'uwaanne ne tumatetsaa,</para>
  <para style="q2" vid="PSA 40:10">ne wolk'k'aama shiik'uwaappe gentsabeykke.<verse eid="PSA 40:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11" />Abeet Med'inaa Godaw, ne maarotetsaa taappe haassoppa.</para>
  <para style="q2" vid="PSA 40:11">Aggena ne siik'uunne ne tumatetsay</para>
  <para style="q2" vid="PSA 40:11">taana ubbaa wode naago.<verse eid="PSA 40:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12" />Ayaw gooppe, paydu bayinna iitabay taana dooddeedda.</para>
  <para style="q2" vid="PSA 40:12">Ta iitatetsay taana gakkiide goozeedda;</para>
  <para style="q2" vid="PSA 40:12">taani s'eellanaw danddaykke.</para>
  <para style="q2" vid="PSA 40:12">Ta iita oosuu ta huup'iyaa binnaanaappe dareedda;</para>
  <para style="q2" vid="PSA 40:12">ta wozanay ta giddon seereedda.<verse eid="PSA 40:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13" />Abeet Med'inaa Godaw, taana ashshanaw eeno ga;</para>
  <para style="q2" vid="PSA 40:13">abeet Med'inaa Godaw, taana maaddanaw elleella.<verse eid="PSA 40:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14" />Taana wod'anaw koyiyaawanttu</para>
  <para style="q2" vid="PSA 40:14">ubbakka yeellatinonne kawushino.</para>
  <para style="q1" vid="PSA 40:14">Taani k'ohettannawaa amottiyaawanttu</para>
  <para style="q2" vid="PSA 40:14">kawushiide guyye simmino.<verse eid="PSA 40:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15" />Ta bolla, «Aw hashshu! Hashshu!»</para>
  <para style="q2" vid="PSA 40:15">geeddawanttu s'oonetteedda diraw, yeellatino.<verse eid="PSA 40:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16" />Shin neena koyiyaa ubbatuu,</para>
  <para style="q2" vid="PSA 40:16">neenan nashetinonne hashshu giino.</para>
  <para style="q1" vid="PSA 40:16">K'ay ne atotetsaa dosiyaawanttu ubbatuu,</para>
  <para style="q2" vid="PSA 40:16">«Med'inaa Goday gitato!» yaagino.<verse eid="PSA 40:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17" />Taani hiyyeessanne metootanchchaa;</para>
  <para style="q2" vid="PSA 40:17">tawaa Goday k'oppo.</para>
  <para style="q1" vid="PSA 40:17">Taana maaddiyaawenne ashshiyaawe neena;</para>
  <para style="q2" vid="PSA 40:17">abeet ta S'oossaw, gam"oppa.<verse eid="PSA 40:17" /></para>
  <chapter eid="PSA 40" />
  <chapter number="41" style="c" sid="PSA 41" />
  <para style="s">Hargganchcha Asaa Woosaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Daawita Mazimuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1" />Hiyyeesaw k'oppiyaa Asay anjjetteedawaa;</para>
  <para style="q2" vid="PSA 41:1">metuwaa gallassi Med'inaa Goday Aa ashshee.<verse eid="PSA 41:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2" />Med'inaa Goday Aa naagiide, pas'a wotsee.</para>
  <para style="q2" vid="PSA 41:2">Inne biittaa bollan anjjetteedawaa gidee;</para>
  <para style="q1" vid="PSA 41:2">S'oossay Aa Aa morkkatuwaa amoo aatsiide immenna.<verse eid="PSA 41:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3" />Med'inaa Goday Aa harggiyaa hiitsan de'ishiinakka maaddee;</para>
  <para style="q2" vid="PSA 41:3">I sakkettinakka, Aa patsee.<verse eid="PSA 41:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4" />Taana gidooppe, taani, «Abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 41:4">taani neena naak'k'eedda diraw, taana maara;</para>
  <para style="q1" vid="PSA 41:4">Harggiyaappekka taana patsa» yaagaad.<verse eid="PSA 41:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5" />Ta morkketuu iitaban taana haasayiidde,</para>
  <para style="q2" vid="PSA 41:5">«I awude hayk'k'anddeeshsha?</para>
  <para style="q1" vid="PSA 41:5">K'ay Aa suntsaykka awude d'ayanddeeshsha?» yaagiino.<verse eid="PSA 41:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6" />Taana be'anaw yiyaa ooninne taw worddobaa odee;</para>
  <para style="q2" vid="PSA 41:6">bare wozanaan taana zigiriyaawaa biddee.</para>
  <para style="q1" vid="PSA 41:6">Hewaappe guyyiyaan, kare kesiide,</para>
  <para style="q2" vid="PSA 41:6">yaanne haanne oduwaa laalee.<verse eid="PSA 41:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7" />Taana is's'iyaa ubbatuu</para>
  <para style="q2" vid="PSA 41:7">ittippe ta bollan saasukkiino;</para>
  <para style="q1" vid="PSA 41:7">«Iitabay Aa bolla gakkee» giide k'oppiino.<verse eid="PSA 41:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8" />Unttunttu «Aa iita harggii oyk'k'eedda;</para>
  <para style="q2" vid="PSA 41:8">I he giseeddasaappe ubbakka denddenna» yaagiino.<verse eid="PSA 41:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9" />Haray attina, taani ammanettiyaa ta siik'o laggii,<note caller="-" style="x"><char style="xo" closed="false">41:9 </char><char style="xt" closed="false"><ref loc="MAT 26:23">Mat. 26:23</ref>; <ref loc="MRK 14:18">Mar. 14:18</ref>; <ref loc="LUK 22:21">Luk'. 22:21</ref>; <ref loc="JHN 13:18">Yoh. 13:18</ref></char></note></para>
  <para style="q2" vid="PSA 41:9">taani barsseeddawe ta kushiyaa sa"eedda.<verse eid="PSA 41:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10" />Shin abeet Med'inaa Godaw, neeni taana maara;</para>
  <para style="q2" vid="PSA 41:10">taani unttunttu kushiyaa kesanaadan,</para>
  <para style="q2" vid="PSA 41:10">taana harggiyaa hiitsaappe dentsa.<verse eid="PSA 41:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11" />Neeni taanan nashettanawaa taani eray;</para>
  <para style="q2" vid="PSA 41:11">Ayaw gooppe, ta morkkii taana,</para>
  <para style="q2" vid="PSA 41:11">s'ooniide gayrena.<verse eid="PSA 41:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12" />Neeni taana ta suuretetsaa diraw zemppisaadda;</para>
  <para style="q2" vid="PSA 41:12">ne sintsan taana med'inaw wotsaadda.<verse eid="PSA 41:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13" />Med'inaa Goday, Israa'eeliyaa S'oossay,</para>
  <para style="q2" vid="PSA 41:13">med'inaappe med'inaa gakkanaw galatetto.<note caller="-" style="x"><char style="xo" closed="false">41:13 </char><char style="xt" closed="false"><ref loc="PSA 106:48">Maz. 106:48</ref></char></note></para>
  <para style="b" vid="PSA 41:13" />
  <para style="q1" vid="PSA 41:13">Amen"i. Amen"i.<verse eid="PSA 41:13" /></para>
  <chapter eid="PSA 41" />
  <chapter number="42" style="c" sid="PSA 42" />
  <para style="ms">Laa"entso Mas'aafaa</para>
  <para style="mr">(<ref loc="PSA 42-72">42—72</ref>)</para>
  <para style="s">Yedesaa Wode Woosaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, K'oore Naanatuwaa Akeekaa Timirttiyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1" />Gaaray goggiyaa haatsaa laamotiyaawaadan,</para>
  <para style="q2" vid="PSA 42:1">Abeet S'oossaw, hewaadan taanikka neena laamotay.<verse eid="PSA 42:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2" />«Taani baade, S'oossaa sintsa</para>
  <para style="q2" vid="PSA 42:2">be'anawe awudeeshsha?» gaade,</para>
  <para style="q1" vid="PSA 42:2">S'oossaa, de'uwaa S'oossaa be"anaw saamettay.<verse eid="PSA 42:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3" />Asatuu ubbaa gede, «Ne S'oossay hak'an de'ii?»</para>
  <para style="q2" vid="PSA 42:3">yaagiyaa wode, taw gallassinne k'amma ta afotsay k'uma gideedda.<verse eid="PSA 42:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4" />Taani unttunttu baalaa bonchchanaw,</para>
  <para style="q2" vid="PSA 42:4">shiik'eedda daro asaa gidduwaana</para>
  <para style="q2" vid="PSA 42:4">salppiyaan hombboc'ishiinanne</para>
  <para style="q2" vid="PSA 42:4">galataa yetsaa yes's'ishin,</para>
  <para style="q1" vid="PSA 42:4">S'oossaa golle kaaletseeddawaa k'oppiyaa wode,</para>
  <para style="q2" vid="PSA 42:4">ta wozanay kayyottiidde, giddon seereedda.<verse eid="PSA 42:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5" />Ta shemppattee, taani ayaw kayyottaytaa?</para>
  <para style="q2" vid="PSA 42:5">K'ay ayaw jabbakattayttaa?</para>
  <para style="q1" vid="PSA 42:5">Taani S'oossan hidootaa wotsana.</para>
  <para style="q2" vid="PSA 42:5">Ayaw gooppe, taani biro</para>
  <para style="q2" vid="PSA 42:5">taana ashshiyaawaanne ta S'oossaa galatana.<verse eid="PSA 42:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6" />Ta wozanay kayyotteedda; hewaa diraw,</para>
  <para style="q2" vid="PSA 42:6">taani Yorddaanoosa biittan, Hermmoone d'ok'k'an,</para>
  <para style="q1" vid="PSA 42:6">Miizaare Deriyan ek'k'aade neena hassayay.<verse eid="PSA 42:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7" />Ne soossuwaa guntsan c'iimmuu c'iimmaw s'eesee;</para>
  <para style="q2" vid="PSA 42:7">K'ay ne beetaynne ne hobbii ubbay</para>
  <para style="q2" vid="PSA 42:7">ta bollaanna goggeedda.<verse eid="PSA 42:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8" />Gallassi Med'inaa Goday aggena bare siik'uwaa taw kiittee.</para>
  <para style="q2" vid="PSA 42:8">K'ammakka Aa yetsay taananna de'ee;</para>
  <para style="q2" vid="PSA 42:8">he yetsaykka taani ta de'uwaa S'oossaa woossiyaa woosaa.<verse eid="PSA 42:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9" />S'oossaa, ta wogga zaallaa taani,</para>
  <para style="q2" vid="PSA 42:9">«Ayaw taana dogaadii?</para>
  <para style="q1" vid="PSA 42:9">Taani ayaw ta morkkiyaan naak'ettaade kayyotaade hamettoo?» yaagay.<verse eid="PSA 42:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10" />Ta morkketuu taana,</para>
  <para style="q2" vid="PSA 42:10">«Ne S'oossay hak'an de'ii?» yaagiide,</para>
  <para style="q2" vid="PSA 42:10">ta mek'etsaa mentsiide boriino.<verse eid="PSA 42:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11" />Ta shemppattee, taani ayaw kayyottaytaa?</para>
  <para style="q2" vid="PSA 42:11">K'ay ayaw jabbakattayttaa?</para>
  <para style="q1" vid="PSA 42:11">S'oossan hidootaa wotsana.</para>
  <para style="q2" vid="PSA 42:11">Ayaw gooppe, taani ha"ikka</para>
  <para style="q2" vid="PSA 42:11">taana ashshiyaawaanne ta S'oossaa galatana.<verse eid="PSA 42:11" /></para>
  <chapter eid="PSA 42" />
  <chapter number="43" style="c" sid="PSA 43" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1" />Abeet S'oossaw, taana shatintsaa.</para>
  <para style="q2" vid="PSA 43:1">S'oossaa erenna asatuwaana ta mootuwaa neeni mootetta.</para>
  <para style="q1" vid="PSA 43:1">C'immiyaa iita asatuwaappe taana neeni ashsha.<verse eid="PSA 43:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2" />S'oossaw, taani naagetta attiyaa miis'ay neena.</para>
  <para style="q2" vid="PSA 43:2">Neeni taana ayaw aggay? Taani ayaw ta morkkiyaan,</para>
  <para style="q2" vid="PSA 43:2">naak'ettaade kayyotaadde hamettoo?<verse eid="PSA 43:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3" />Ne poo'uwaanne ne tumuwaa taw kiitta;</para>
  <para style="q2" vid="PSA 43:3">unttunttu taana kaaletsino.</para>
  <para style="q1" vid="PSA 43:3">Ne geeshsha deriyaa neeni de'iyaasaa afino.<verse eid="PSA 43:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4" />He wode taani ta S'oossaa yarshshuwaa sa'aa,</para>
  <para style="q2" vid="PSA 43:4">taana nashechchiyaa S'oossaakko baana.</para>
  <para style="q1" vid="PSA 43:4">Abeet S'oossaw, ta S'oossaw,</para>
  <para style="q2" vid="PSA 43:4">taani diitsaa diis's'aade, neena sabbana.<verse eid="PSA 43:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5" />Ta shemppattee, taani ayaw kayyottaytaa?</para>
  <para style="q2" vid="PSA 43:5">K'ay ayaw jabbakattayttaa?</para>
  <para style="q1" vid="PSA 43:5">Taani S'oossan hidootaa wotsana.</para>
  <para style="q2" vid="PSA 43:5">Ayaw gooppe, taani biro</para>
  <para style="q2" vid="PSA 43:5">taana ashshiyaawaanne ta S'oossaa galatana.<verse eid="PSA 43:5" /></para>
  <chapter eid="PSA 43" />
  <chapter number="44" style="c" sid="PSA 44" />
  <para style="s">S'oossay Naaganaadan Woosaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, K'oore Naanatuwaa Akeeka Timirttiyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1" />Abeet S'oossaw, aad'd'eeda wodiyaan,</para>
  <para style="q2" vid="PSA 44:1">neeni ootseeddawaa nuuni nu haytsaan siseeddo,</para>
  <para style="q2" vid="PSA 44:1">nu aawotuwaa wodiyaankka ne ootseeddawaa nuw odeeddino.<verse eid="PSA 44:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2" />Kawutetsatuwaa neeni ne kushiyan laaggaade kessaadda;</para>
  <para style="q2" vid="PSA 44:2">nu aawotuwaa unttunttu biittan tokkanaw;</para>
  <para style="q2" vid="PSA 44:2">hara kawutetsatuwaa muraadda;</para>
  <para style="q2" vid="PSA 44:2">shin ne asatuwaa aasaadda.<verse eid="PSA 44:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3" />Unttunttu barenttu mashshaan oliide,</para>
  <para style="q2" vid="PSA 44:3">he biittaa kessibeykkino;</para>
  <para style="q1" vid="PSA 44:3">Unttunttu barenttu kushiyaa minotetsan s'oonibeykkino.</para>
  <para style="q2" vid="PSA 44:3">Shin neeni unttuntta siik'eedda diraw,</para>
  <para style="q2" vid="PSA 44:3">unttunttu ne ushechcha kushiyaa,</para>
  <para style="q2" vid="PSA 44:3">ne k'esiyaanne ne sintsa poo'uwaa wolk'k'an s'ooneeddino.<verse eid="PSA 44:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4" />Yaak'ooba asaw s'oonuwaa azaziyaa,</para>
  <para style="q2" vid="PSA 44:4">ta kaatiinne ta S'oossay neena.<verse eid="PSA 44:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5" />Neenan gidiide, nu morkkatuwaa nuuni sugi olana;</para>
  <para style="q2" vid="PSA 44:5">ne suntsan nu ek'etiyaawantta nuuni yed'd'ana.<verse eid="PSA 44:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6" />Taani ta tooraan ammanettikke;</para>
  <para style="q2" vid="PSA 44:6">ta mashshaykka taana ashshenna.<verse eid="PSA 44:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7" />Shin neeni nuuna nu morkkatuwaappe ashshaada;</para>
  <para style="q2" vid="PSA 44:7">k'ay nuuna is's'iyaawantta neeni kawushshaadda.<verse eid="PSA 44:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8" />Nuuni ubbaa wode S'oossan c'eek'etteetto;</para>
  <para style="q2" vid="PSA 44:8">ne suntsaw med'inaw galataa immana.<verse eid="PSA 44:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9" />Shin ha"i neeni nuuna aggaada; kawushshaadda;</para>
  <para style="q2" vid="PSA 44:9">nu tooraa asaana ittippe olaa baakka.<verse eid="PSA 44:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10" />Nu morkkatuwaa sintsaappe nuuna bak'k'atissaadda;</para>
  <para style="q2" vid="PSA 44:10">nu ek'k'etiyaawanttu nubaa bonk'k'eeddino.<verse eid="PSA 44:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11" />Neeni nuuna dorssatuwaadan shukaw aatsaade immaadda;</para>
  <para style="q2" vid="PSA 44:11">k'ay kawutetsatuwaa giddon nuuna laalaadda.<verse eid="PSA 44:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12" />Neeni ne asaa hirayisuwaan zal"aadda;</para>
  <para style="q2" vid="PSA 44:12">ayaa wod'iyaanne demmabeykka.<verse eid="PSA 44:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13" />Neeni nuuna nu shoorotuu boriyaawaa,</para>
  <para style="q2" vid="PSA 44:13">k'ay nu heeraan de'iyaawanttu k'iliic'iyaawaanne miic'c'iyaawaa ootsaadda.<verse eid="PSA 44:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14" />Neeni nuuna kawutetsatuwaa giddon tossaa kessaadda;</para>
  <para style="q2" vid="PSA 44:14">nuuna unttunttu barenttu huup'iyaa k'aatsi k'aatsi k'id'iyaawaa ootsaadda.<verse eid="PSA 44:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15" />Taani gallassaa kumentsan tooshettaad.</para>
  <para style="q2" vid="PSA 44:15">Ta som"iyaa yeellay kammeedda.<verse eid="PSA 44:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16" />Taana shek'k'iyaawanttunne boriyaawanttu gaasuwaan,</para>
  <para style="q2" vid="PSA 44:16">Taanna morkkiyaawanttunne manddiyaawanttu gaasuwaana.<verse eid="PSA 44:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17" />Nuuni neena dogibeennawaa gidooppekka,</para>
  <para style="q2" vid="PSA 44:17">woy ne c'aak'uwaa mentsibeenawaa gidooppekka,</para>
  <para style="q1" vid="PSA 44:17">Hawe ubbay nu bolla haneedda.<verse eid="PSA 44:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18" />Nu wozanay neeppe guyye simmibeenna;</para>
  <para style="q2" vid="PSA 44:18">nu gedii ne ogiyaappe gas'aa kesibeenna.<verse eid="PSA 44:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19" />Shin neeni nuuna mentsereetsaade do'aa giddon yeggaadda;</para>
  <para style="q2" vid="PSA 44:19">d'ip'p'i go d'uman kammaadda.<verse eid="PSA 44:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20" />Nu S'oossaa suntsaa nuuni dogeeddentto,</para>
  <para style="q2" vid="PSA 44:20">hara s'oossaa woossanaw nuuni nu kushiyaa mic'c'eeddentto,<verse eid="PSA 44:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21" />Wozanaan geemmeedda s'uuraa S'oossay eriyaa diraw,</para>
  <para style="q2" vid="PSA 44:21">I hawaa biddiide demmennee?<verse eid="PSA 44:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22" />Shin ne diraw, gallassaa ubbaan nuuna wod'iino;<note caller="-" style="x"><char style="xo" closed="false">44:22 </char><char style="xt" closed="false"><ref loc="ROM 8:36">Rom. 8:36</ref></char></note></para>
  <para style="q2" vid="PSA 44:22">shukkanaw afiyaa dorssaadan paydeteeddo.<verse eid="PSA 44:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23" />Abeet Med'inaa Godaw, dendda! Ayaw gem"ishay?</para>
  <para style="q2" vid="PSA 44:23">Beegotta! Med'inaw nuuna aggoppa.<verse eid="PSA 44:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24" />Ne som"uwaa nuuppe ayaw gentsay?</para>
  <para style="q2" vid="PSA 44:24">Nu k'ohuwaanne nu un"aa ayaw dogay?<verse eid="PSA 44:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25" />Nuuni baanan duge oletteeddo;</para>
  <para style="q2" vid="PSA 44:25">nu asatetsaykka biittaana oyk'k'etteedda.<verse eid="PSA 44:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26" />Abeet S'oossaw, dendda! Nuuna maadda!</para>
  <para style="q2" vid="PSA 44:26">Aggena ne siik'uwaa diraw, nuuna woza.<verse eid="PSA 44:26" /></para>
  <chapter eid="PSA 44" />
  <chapter number="45" style="c" sid="PSA 45" />
  <para style="s">Siik'uwaa Timirttiyaa</para>
  <para style="d">K'oore Naanatuu Zammaaretuwaa Kaappoo C'iishshaa Waatsa Giyaa Waatsan Yes's'eedda Yetsaa. Akeekan S'aafetteedda Siik'uwaa Yetsaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1" />Taani ta yetsaa kaatiyaa sisana,</para>
  <para style="q2" vid="PSA 45:1">ta wozanay lo"o k'ofaa pulttee;</para>
  <para style="q2" vid="PSA 45:1">ta ins's'arssay lo"o s'aafiyaa asaa bi'iriyaa mala.<verse eid="PSA 45:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2" />Asaa ubbaappe neeni malanchchanne;</para>
  <para style="q2" vid="PSA 45:2">ne haasayay nashetsiyaawaa gidana mala,</para>
  <para style="q1" vid="PSA 45:2">S'oossay neena med'inaw anjjeedda.<verse eid="PSA 45:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3" />Wolk'k'aama kaatiyaw,</para>
  <para style="q2" vid="PSA 45:3">ne mashshaa ne s'eessan danc'c'a;</para>
  <para style="q2" vid="PSA 45:3">bonchchuunne gitatetsay newaa.<verse eid="PSA 45:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4" />Ne tumatetsaa, ashkketetsaanne s'illotetsaa diraw,</para>
  <para style="q2" vid="PSA 45:4">ne anggaa mayyaade, s'oonanaw piriis'a.</para>
  <para style="q1" vid="PSA 45:4">Ne ushechcha kushii malalissiyaabaa besso.<verse eid="PSA 45:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5" />Ne pootsay k'ara;</para>
  <para style="q2" vid="PSA 45:5">unttunttu kaatiyaa morkkatuwaa wozana ayifiyaa c'addino.</para>
  <para style="q1" vid="PSA 45:5">Kawutetsatuu ne gediyaan kunddino.<verse eid="PSA 45:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6" />Abeet S'oossaw,</para>
  <para style="q2" vid="PSA 45:6">ne kawutetsaa araatay med'i med'inaw de'ee;<note caller="-" style="x"><char style="xo" closed="false">45:6-7 </char><char style="xt" closed="false"><ref loc="HEB 1:8-9">Ibr. 1:8-9</ref></char></note></para>
  <para style="q2" vid="PSA 45:6">ne kawutetsaa s'am"aykka suuretetsaa s'am"aa.<verse eid="PSA 45:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7" />Neeni s'illotetsaa siik'aasa;</para>
  <para style="q2" vid="PSA 45:7">geelatetsaa is's'aa.</para>
  <para style="q1" vid="PSA 45:7">S'oossay, ne S'oossay, neena</para>
  <para style="q2" vid="PSA 45:7">ne laggetuwaappe aatsiide,</para>
  <para style="q2" vid="PSA 45:7">nashshechchaa zayitiyaa okkeeddawe hewaassa.<verse eid="PSA 45:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8" />Kawaraan, godare uutsaaninne birggudiyaan,</para>
  <para style="q2" vid="PSA 45:8">ne mayuu ubbay pushakketteedda.</para>
  <para style="q1" vid="PSA 45:8">Danggarssaa zaaliyaan alleek'k'etteedda,</para>
  <para style="q2" vid="PSA 45:8">ne kawutetsaa golliyaan diis's'iyaawanttu neena nashechchiino.<verse eid="PSA 45:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9" />Kaatiyaa golliyaan de'iyaa mac'c'a asatuwaa giddon,</para>
  <para style="q2" vid="PSA 45:9">kaatetuwaa mac'c'a naanatuu de'iino;</para>
  <para style="q2" vid="PSA 45:9">kaatata geeshsha work'k'aan alleek'k'ettaade,</para>
  <para style="q2" vid="PSA 45:9">neeppe ushechcha baggan ek'k'aaddu.<verse eid="PSA 45:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10" />Ta naattee, sisa; hayzza;</para>
  <para style="q2" vid="PSA 45:10">ne haytsaa haa yegga.</para>
  <para style="q1" vid="PSA 45:10">Ne zariyaanne ne aawuwaa golliyaa doga.<verse eid="PSA 45:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11" />Ne pulaa kaatii amottee;</para>
  <para style="q2" vid="PSA 45:11">I new goda gidiyaa diraw, aw azazetta.<verse eid="PSA 45:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12" />S'iroosa Asay iziw imotaa akkiide yaana;</para>
  <para style="q2" vid="PSA 45:12">duretuu neena awuddashana.<verse eid="PSA 45:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13" />Kaatiyaa naatta kaatiyaa golliyaa giddon waata lo"ay!</para>
  <para style="q2" vid="PSA 45:13">Izi bullachchaa mayuukka work'k'aa k'ac'inan dadetteedda.<verse eid="PSA 45:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14" />Bare alleek'k'o mayuwaa mayyaade, kaatiyaakko moyzzetaw;</para>
  <para style="q2" vid="PSA 45:14">Izi lagge naanatuu wodorotuu,</para>
  <para style="q2" vid="PSA 45:14">izo kaalliide, Aa sintsa aheeddino.<verse eid="PSA 45:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15" />Unttunttu nashettiiddenne hombboc'iidde yiide,</para>
  <para style="q2" vid="PSA 45:15">kaatiyaa golliyaa geliino.<verse eid="PSA 45:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16" />Kaatiyaw, ne aawotuwaa kotaa ne naanatuu akkana.</para>
  <para style="q2" vid="PSA 45:16">Neeni unttuntta biittaa ubbaa bollan suntsana.<verse eid="PSA 45:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17" />Taani ne suntsay yeletaa ubbaan hassayettanaadan ootsana.</para>
  <para style="q2" vid="PSA 45:17">Hewaa diraw, Asay med'i med'inaw neena galatana.<verse eid="PSA 45:17" /></para>
  <chapter eid="PSA 45" />
  <chapter number="46" style="c" sid="PSA 46" />
  <para style="s">S'oossay Nuunana De'ee</para>
  <para style="d">Zammaaretuwaa Kaappoo K'oore Naanatuu Immina Yes'etteedda, Wodoro Naanaa Yetsaa Hiilan S'aafetteedda Yetsaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1" />S'oossay nuuni naagetti attiyaa saanne nuw wolk'k'aa.</para>
  <para style="q2" vid="PSA 46:1">Nuuna metuu gakkiyaa wode,</para>
  <para style="q2" vid="PSA 46:1">maaddanaw I ubbaa gede matan de'ee.<verse eid="PSA 46:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2" />Hewaa diraw, biittay k'aas's'inttokka,</para>
  <para style="q2" vid="PSA 46:2">woy deretuu abban kunddinttokka,</para>
  <para style="q1" vid="PSA 46:2">Nuuni yayyokko.<verse eid="PSA 46:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3" />Abbaa beetay guummiide, hoommuwaa mayninttokka,</para>
  <para style="q2" vid="PSA 46:3">Aa wolk'k'aama hobbiyan deretuu yiik'k'iyiik'k'inttokka,</para>
  <para style="q2" vid="PSA 46:3">nuuni yayyokko.<verse eid="PSA 46:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4" />Itti shaafay de'ee.</para>
  <para style="q2" vid="PSA 46:4">He shaafay goggiide, S'oossaa katamaa,</para>
  <para style="q1" vid="PSA 46:4">Ubbaappe D'ok'k'iyaa S'oossay de'iyaa geeshsha sa'aa nashechchee.<verse eid="PSA 46:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5" />S'oossay Aa giddon de'iyaa diraw,</para>
  <para style="q2" vid="PSA 46:5">he katamay k'aas's'enna.</para>
  <para style="q1" vid="PSA 46:5">Wontta guuran S'oossay Aa maaddana.<verse eid="PSA 46:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6" />Gadiyaa Asay shabbarettee;</para>
  <para style="q2" vid="PSA 46:6">kawutetsatuu k'aas's'iino.</para>
  <para style="q1" vid="PSA 46:6">S'oossay bare k'aalaa sisseedda wode, sa'ay seeree.<verse eid="PSA 46:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7" />Med'etetsaa Ubbaa Goday nuunanna de'ee;</para>
  <para style="q2" vid="PSA 46:7">Yaak'ooba s'oossay nuuni k'osetti attiyaa sa'aa.<verse eid="PSA 46:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8" />Haa yiite; Med'inaa Goday oosuwaa s'eellite;</para>
  <para style="q2" vid="PSA 46:8">I sa'aan aheedda bashshaa be'ite.<verse eid="PSA 46:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9" />I sa'aa gas'aa gakkanaw de'iyaa olaa te"ee;</para>
  <para style="q2" vid="PSA 46:9">wonddaafiyaa mentsee;</para>
  <para style="q2" vid="PSA 46:9">tooraa mentsee;</para>
  <para style="q2" vid="PSA 46:9">gonddalliyaakka taman s'uuggee.<verse eid="PSA 46:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10" />Woppu giite; taani S'oossaa gidiyaawaa erite.</para>
  <para style="q2" vid="PSA 46:10">Taani kawutetsatuwaa giddon d'ok'k'ay.</para>
  <para style="q1" vid="PSA 46:10">K'ay biittaa bollankka d'ok'k'ay.<verse eid="PSA 46:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11" />Ubbaappe Wolk'k'aama Med'inaa Goday nuunanna de'ee;</para>
  <para style="q2" vid="PSA 46:11">Yaak'ooba S'oossay nuuni k'osetti attiyaa sa'aa.<verse eid="PSA 46:11" /></para>
  <chapter eid="PSA 46" />
  <chapter number="47" style="c" sid="PSA 47" />
  <para style="s">S'oossay Alamiyaa Ubbaa Kaatiyaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, K'oore Naanatuwaa Mazimuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 47:1" />Kawutetsatuu ubbay hintte kushiyaa bak'k'ite;</para>
  <para style="q2" vid="PSA 47:1">k'aalaa d'ok'k'u ootsiide, S'oossaw galataa yes's'ite.<verse eid="PSA 47:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2" />Ubbaappe D'ok'k'iyaa Med'inaa Goday yayettanaw bessee;</para>
  <para style="q2" vid="PSA 47:2">sa'aa ubbaa bollan I wolk'k'aama kaatiyaa.<verse eid="PSA 47:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3" />Gadiyaa asaa nuuppe garssaana,</para>
  <para style="q2" vid="PSA 47:3">kawutetsatuwaakka nu gediyaappe garssaana wotsiide,</para>
  <para style="q1" vid="PSA 47:3">Nuw moodissee.<verse eid="PSA 47:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4" />I nuw laattiyaa biittaa dooreedda;</para>
  <para style="q2" vid="PSA 47:4">he biittay, I siik'iyaa Yaak'ooba zaratuu c'eek'ettiyaawaa.<verse eid="PSA 47:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5" />S'oossay pude kawutetsaa araataa keseedda.</para>
  <para style="q2" vid="PSA 47:5">Med'inaa Goday pude kesiyaa wode,</para>
  <para style="q2" vid="PSA 47:5">nashshechchaa hombboc'etsaynne malakataa punnay sisetteedda.<verse eid="PSA 47:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6" />S'oossaa sabbite; ee, Aa sabbite.</para>
  <para style="q2" vid="PSA 47:6">Nu kaatiyaa sabbite; ee, Aa sabbite.<verse eid="PSA 47:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7" />S'oossay sa'aa ubbaa kaatiyaa gidiyaa diraw,</para>
  <para style="q2" vid="PSA 47:7">galataa sabaa sabbite.<verse eid="PSA 47:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8" />S'oossay bare geeshsha kawutetsaa araatan utteedda;</para>
  <para style="q2" vid="PSA 47:8">S'oossay kawutetsatuwaa ubbaa mooddee.<verse eid="PSA 47:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9" />Kawutetsatuwaa kaappatuu,</para>
  <para style="q2" vid="PSA 47:9">Abrahaama S'oossaa asatuwaana ittippe shiik'iino.</para>
  <para style="q1" vid="PSA 47:9">Ayaw gooppe, sa'aan de'iyaa wolk'k'aamatuu ubbay S'oossaassa;</para>
  <para style="q2" vid="PSA 47:9">I loytsi d'ok'k'u geedda.<verse eid="PSA 47:9" /></para>
  <chapter eid="PSA 47" />
  <chapter number="48" style="c" sid="PSA 48" />
  <para style="s">S'oossaa Katamati S'iyoono</para>
  <para style="d">K'oraaha naanatuwaa mazamuriyaa; yetsaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1" />Med'inaa Goday wolk'k'aama.</para>
  <para style="q2" vid="PSA 48:1">Nu S'oossaa kataman Aa geeshsha deriyaan aad'd'o galatay aw bessee.<verse eid="PSA 48:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2" />S'oossaa deriyaa S'iyoone d'ok'k'anne lo"a.<note caller="-" style="x"><char style="xo" closed="false">48:2 </char><char style="xt" closed="false"><ref loc="MAT 5:35">Mat. 5:35</ref></char></note></para>
  <para style="q2" vid="PSA 48:2">Pudehaa baggana de'iyaa</para>
  <para style="q1" vid="PSA 48:2">He wolk'k'aama kaatiyaa katamay sa'aa ubbaw nashshechchaa.<verse eid="PSA 48:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3" />He katamaa gimbbiyaa giddon,</para>
  <para style="q2" vid="PSA 48:3">barenan saro Asay de'iyaawaa S'oossay besseedda.<verse eid="PSA 48:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4" />Kaatetuu barenttu tooranchchatuwaanna ittippe shiik'eeddino;</para>
  <para style="q2" vid="PSA 48:4">S'iyoone olanaw yeeddino.<verse eid="PSA 48:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5" />Aa be'iide, maalalettiidinne dagammiide,</para>
  <para style="q2" vid="PSA 48:5">bak'ateeddino.<verse eid="PSA 48:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6" />Unttunttu hewan de'ishiina,</para>
  <para style="q2" vid="PSA 48:6">unttuntta yashshaa kokkorssay oyk'k'eedda;</para>
  <para style="q2" vid="PSA 48:6">oytsay oyk'k'eedda mishirattiidan un"eteeddino.<verse eid="PSA 48:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7" />Away doliyaa bagga wolk'k'aama c'arkkuwaan,</para>
  <para style="q2" vid="PSA 48:7">me"iyaa Tarsseese markkabiyaadan unttunttu kokkoreeddino.<verse eid="PSA 48:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8" />Nuuni siseeddawaadankka,</para>
  <para style="q2" vid="PSA 48:8">Ubbaappe Wolk'k'aama Med'inaa Godaa kataman,</para>
  <para style="q2" vid="PSA 48:8">nu S'oossaa kataman, I ootseeddawaa be'eeddo.</para>
  <para style="q2" vid="PSA 48:8">S'oossay he katamaa med'inaw minisi essee.<verse eid="PSA 48:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9" />Abeet S'oossaw, ne Geeshsha Golliyaa giddon</para>
  <para style="q2" vid="PSA 48:9">aggena ne siik'uwaa k'oppeeddo.<verse eid="PSA 48:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10" />Abeet S'oossaw, ne suntsaadankka,</para>
  <para style="q2" vid="PSA 48:10">ne galatay sa'aa gas'aa gakkeedda.</para>
  <para style="q1" vid="PSA 48:10">Ne ushechcha kushii s'illotetsaan kumeeddawaa.<verse eid="PSA 48:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11" />Ne pirddaa diraw,</para>
  <para style="q2" vid="PSA 48:11">S'iyoone Asay nashettee;</para>
  <para style="q1" vid="PSA 48:11">Yihudaa mootsatuukka nashettiino.<verse eid="PSA 48:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12" />S'iyoone yuushshuwaan hamettite;</para>
  <para style="q2" vid="PSA 48:12">I yuushshuwaan yaanne haanne simerettite.</para>
  <para style="q1" vid="PSA 48:12">I wochchiyaa sa'aa paydite.<verse eid="PSA 48:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13" />Yiyaa yeletaw odanaadan,</para>
  <para style="q2" vid="PSA 48:13">izi gimbbiyaa akeekitenne izi aakko gimbbiyaa s'omoosite.<verse eid="PSA 48:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14" />Hintte, «Med'i med'inaw</para>
  <para style="q2" vid="PSA 48:14">ha S'oossay nu S'oossaa;</para>
  <para style="q1" vid="PSA 48:14">I nuuna hayk'k'ana gakkanaw kaaletsana» yaagiide odite.<verse eid="PSA 48:14" /></para>
  <chapter eid="PSA 48" />
  <chapter number="49" style="c" sid="PSA 49" />
  <para style="s">Duretaan Amanetussay Hada Gidussaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, K'oore Naanatuwaa Mazimuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 49:1" />Hinttenoo, asatoo, ubbatuukka hawaa sisite.</para>
  <para style="q2" vid="PSA 49:1">Hinttenoo, sa'aan de'iyaawanttoo,</para>
  <para style="q2" vid="PSA 49:1">ubbatuukka hawaa hayzzite.<verse eid="PSA 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2" />D'ok'k'ay zik'k'aykka,</para>
  <para style="q2" vid="PSA 49:2">durii mank'k'uukka sisite.<verse eid="PSA 49:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3" />Ta wozanaa k'ofay c'iimma;</para>
  <para style="q2" vid="PSA 49:3">ta doonay aad'd'eeda eratetsaa haasayee.<verse eid="PSA 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4" />Ta haytsaa leemisuwaakko yeggana;</para>
  <para style="q2" vid="PSA 49:4">diitsaa diis's'aade,</para>
  <para style="q1" vid="PSA 49:4">Taani Aa biletsaa k'onc'c'issana.<verse eid="PSA 49:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5" />Meto gallassay yiyaa wodiyaaninne baletsiyaa morkketuu,</para>
  <para style="q2" vid="PSA 49:5">taana dooddiyaa wode,</para>
  <para style="q1" vid="PSA 49:5">Taani ayaw yayyaytaa?<verse eid="PSA 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6" />Ta morkketoo,</para>
  <para style="q2" vid="PSA 49:6">Barenttu de'iyaawan ammanettiyaawanttoonne</para>
  <para style="q2" vid="PSA 49:6">barenttu duretetsaa daruwaan c'eek'k'iyaawanttoo</para>
  <para style="q2" vid="PSA 49:6">ayaw yayyaytaa?<verse eid="PSA 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7" />Ay asaynne barena wozanaw,</para>
  <para style="q2" vid="PSA 49:7">woy bare shemppuwaa gatiyaa S'oossaw c'igganaw danddayenna.<verse eid="PSA 49:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8" />Ayaw gooppe, asaa shemppuwaa gatii al"a.</para>
  <para style="q2" vid="PSA 49:8">Ay gatiyaa c'igginakka gidena.<verse eid="PSA 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9" />I med'inaw de'anaadan,</para>
  <para style="q2" vid="PSA 49:9">woy I hayk'k'ennaadan ootsanaw gakkenna.<verse eid="PSA 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10" />Eeyyatuunne boozatuu hayk'k'iyaawaadan,</para>
  <para style="q2" vid="PSA 49:10">aad'd'eeda eranchchatuukka d'ayiyaawaanne</para>
  <para style="q2" vid="PSA 49:10">barenttu mas'uwaa haratoo yeggiide biyaawaa</para>
  <para style="q2" vid="PSA 49:10">asay ubbay be'ee.<verse eid="PSA 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11" />Unttunttu barenttu biittaa barenttuwaa giinakka,</para>
  <para style="q2" vid="PSA 49:11">duufuu med'inaw unttunttu gollenne yeletaappe yeletaa gakkanaw</para>
  <para style="q2" vid="PSA 49:11">unttunttu de'iyaa sa'aa gidanawaa.<verse eid="PSA 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12" />Asay ay gitatooppekka pas'a attena;</para>
  <para style="q2" vid="PSA 49:12">I do'aadan hayk'k'ana.<verse eid="PSA 49:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13" />Barekka barenttu huup'iyaan ammanettiyaawanttu kaac'aynne</para>
  <para style="q2" vid="PSA 49:13">unttunttu k'aalaa tuma giyaawanttu wurssetsay hawaa.<verse eid="PSA 49:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14" />Shukaw dooretteedda dorssatuwaadan,</para>
  <para style="q2" vid="PSA 49:14">unttunttu duufoo dooretteeddino;</para>
  <para style="q1" vid="PSA 49:14">Hayk'k'uu unttunttu hentsanchchaa gidanawaa.</para>
  <para style="q2" vid="PSA 49:14">Suuretuu wontta unttunttu duufuwaa bolla hamettana;</para>
  <para style="q2" vid="PSA 49:14">unttunttu barenttu de'iyaa golliyaappe haakkiide, duufuwaan wook'k'ana.<verse eid="PSA 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15" />Shin S'oossay taana wozana;</para>
  <para style="q2" vid="PSA 49:15">I ta shemppuwaa hayk'k'uwaa wolk'k'aappe ashshana.<verse eid="PSA 49:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16" />Asay durettiyaa wodenne,</para>
  <para style="q2" vid="PSA 49:16">Aa bonchchuu dariyaa wode yayyoppa.<verse eid="PSA 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17" />Ayaw gooppe, I hayk'k'iidde,</para>
  <para style="q2" vid="PSA 49:17">Ayinne akkiide beenna;</para>
  <para style="q1" vid="PSA 49:17">Aa duretay aanana ittippe duufuwaa beenna.<verse eid="PSA 49:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18" />Asay pas'a de'iyaa wodiyaan,</para>
  <para style="q2" vid="PSA 49:18">«Taw kumeedda» gooppenne,</para>
  <para style="q2" vid="PSA 49:18">ubbabay aw giigeedda diraw galatettooppenne,<verse eid="PSA 49:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 49:19" />Simmiide poo'uwaa be'enna bare mayzza aawotuwaana gakkettee.<verse eid="PSA 49:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20" />Eri bayinnan gitateedda Asay do'aadan hayk'k'ana.<verse eid="PSA 49:20" /></para>
  <chapter eid="PSA 49" />
  <chapter number="50" style="c" sid="PSA 50" />
  <para style="s">Tumo Goynaa</para>
  <para style="d">Asaafa mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1" />Wolk'k'aama S'oossay, Med'inaa Goday haasayee.</para>
  <para style="q2" vid="PSA 50:1">Away doliyaasaappe wulliyaasaa gakkanaw</para>
  <para style="q2" vid="PSA 50:1">sa'aan de'iyaa asaa s'eesee.<verse eid="PSA 50:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2" />Puulay kumentsaa lo"a gidiyaa S'iyooneppe S'oossay poo'ee.<verse eid="PSA 50:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3" />Nu S'oossay yaana; c'o"u geena.</para>
  <para style="q2" vid="PSA 50:3">Ees's'iyaa tamay Aa sintsaana;</para>
  <para style="q2" vid="PSA 50:3">wolk'k'aama gotii Aa yuushshuwaana.<verse eid="PSA 50:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4" />S'oossay bare asaa pirddiidde,</para>
  <para style="q2" vid="PSA 50:4">salotuwaanne sa'aa s'eesee.<verse eid="PSA 50:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5" />«Yarshshuwaa yarshshiyaawaan,</para>
  <para style="q2" vid="PSA 50:5">taananna c'aak'k'eteedda S'oossaa asatuwaa,</para>
  <para style="q2" vid="PSA 50:5">taakko shiishshite» yaageedda.<verse eid="PSA 50:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6" />S'oossay pirddiyaawaa gidiyaa diraw,</para>
  <para style="q2" vid="PSA 50:6">salotuu Aa s'illotetsaa odiino.<verse eid="PSA 50:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7" />«Ta asaw, sisa! Taani new oday.</para>
  <para style="q2" vid="PSA 50:7">Israa'eeliyaa asaw, taani ne bolla markkattay.</para>
  <para style="q1" vid="PSA 50:7">Taani S'oossaa, ne S'oossaa.<verse eid="PSA 50:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8" />Ne yarshshuwaa dirawunne</para>
  <para style="q2" vid="PSA 50:8">neeni ubbaa gede shiishshiyaa s'uuggiyaa yarshshuwaa diraw,</para>
  <para style="q1" vid="PSA 50:8">Taani neena seerikke.<verse eid="PSA 50:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9" />Hewaadankka, ne dirssaappe korumatuwaa,</para>
  <para style="q2" vid="PSA 50:9">woy ne sikkuwaappe deeshshatuwaa akkanaw koyikke.<verse eid="PSA 50:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10" />Ayaw gooppe, woraan de'iyaa do'atuu ubbatuu tawantta;</para>
  <para style="q2" vid="PSA 50:10">sha"u deriyaa bollan de'iyaa mehetuukka tawantta.<verse eid="PSA 50:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11" />Taani d'ok'k'a deriyaan de'iyaa kafotuwaa ubbaa eray;</para>
  <para style="q2" vid="PSA 50:11">dembban de'iyaa med'etetsatuu tawantta.<verse eid="PSA 50:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12" />Taana koshinttonne, taani new odikke:</para>
  <para style="q2" vid="PSA 50:12">ayaw gooppe, sa'aynne sa'aan kumeeddawe ubbay tawaa.<verse eid="PSA 50:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13" />Taani korumatuwaa ashuwaa mayttaa?</para>
  <para style="q2" vid="PSA 50:13">Woy deeshshatuwaa suutsaa ushaytaa?<verse eid="PSA 50:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14" />Hewaa diraw, S'oossaw,</para>
  <para style="q2" vid="PSA 50:14">neeni immiyaa yarshshuu galataa gido;</para>
  <para style="q1" vid="PSA 50:14">Ubbaappe D'ok'k'iyaa S'oossaw ne k'anggetsaa gatsa.<verse eid="PSA 50:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15" />Yaataade, metuwaa gallassi taana s'eesa.</para>
  <para style="q2" vid="PSA 50:15">Taani neena ashshana; neenikka taana bonchchana» yaagee.<verse eid="PSA 50:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 50:16" />Shin S'oossay iita asaa hawaadan yaagee;</para>
  <para style="q2" vid="PSA 50:16">Ta higgiyaa neeni zaara zaaraadde ayaw oday?</para>
  <para style="q1" vid="PSA 50:16">Woy ta c'aak'uwaa ne doonaan ayaw haasayay?<verse eid="PSA 50:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17" />Neeni ta timirttiyaa is's'aadda;</para>
  <para style="q2" vid="PSA 50:17">ta k'aalaakka haytsaa bollaanna aatsaada.<verse eid="PSA 50:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18" />Neeni kayisuwaa be'eedda wode,</para>
  <para style="q2" vid="PSA 50:18">aanana dabbotaadda;</para>
  <para style="q1" vid="PSA 50:18">Shaarmus'iyaawanttu maabaran gelaadda.<verse eid="PSA 50:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19" />Neeni ne doonaa iitabaa haasayanaw billa yeddaasa.</para>
  <para style="q2" vid="PSA 50:19">Ne ins's'arssaykka wordduwaa haasayaa meezeteedda.<verse eid="PSA 50:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20" />Ne utteeddasaan ne ishaa iissaade haasayaadda;</para>
  <para style="q2" vid="PSA 50:20">ne aatti na'aa zigiraasa.<verse eid="PSA 50:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21" />Neeni hawaa ubbaa ootsiyaa wode,</para>
  <para style="q2" vid="PSA 50:21">taani c'o"u geedda diraw,</para>
  <para style="q1" vid="PSA 50:21">Taanakka ne mala gaade k'oppaadda.</para>
  <para style="q2" vid="PSA 50:21">Shin ha"i taani neena seeraynne</para>
  <para style="q2" vid="PSA 50:21">ne balaa ne sintsan payday.<verse eid="PSA 50:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22" />«Hinttenoo, S'oossaa dogiyaawanttoo, hawaa akeekite.</para>
  <para style="q2" vid="PSA 50:22">Hewe d'ayooppe, taani hinttena mentsereetsana;</para>
  <para style="q2" vid="PSA 50:22">he wode hinttena ashshiyaawe baawa.<verse eid="PSA 50:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23" />Taw galataa immiyaa Asay taana bonchchee.</para>
  <para style="q2" vid="PSA 50:23">Bare ogiyaa suurissiyaa asaa</para>
  <para style="q2" vid="PSA 50:23">taani S'oossaa atotetsaa bessana» yaagee.<note caller="-" style="x"><char style="xo" closed="false">50:23</char><char style="xt" closed="false"><ref loc="2SA 12:1-15">2 Sam. 12:1-15</ref></char></note><verse eid="PSA 50:23" /></para>
  <chapter eid="PSA 50" />
  <chapter number="51" style="c" sid="PSA 51" />
  <para style="s">Maarotetsaa Demanaw Shiik'eedda Woosaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Berssaabina sharmus'eedda Hanotaa Timbbitiyaa Odiyaa Naataani Aw odiide Simmina, Daawita Mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1" />Abeet S'oossaw, aggena ne siik'uwaadan taana maara;</para>
  <para style="q2" vid="PSA 51:1">ne k'aretaa daruwaadan ta bayzzuwaa k'uc'c'a.<verse eid="PSA 51:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2" />Ta iitatetsaappe taana mule meec'c'a;</para>
  <para style="q2" vid="PSA 51:2">ta nagaraappe taana geeshsha.<verse eid="PSA 51:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3" />Ayaw gooppe, ta bayzzuwaa taani eray;</para>
  <para style="q2" vid="PSA 51:3">ta nagaray ubbaa gede ta sintsaana.<verse eid="PSA 51:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4" />Taani neena, ne s'alala naak'k'aad;<note caller="-" style="x"><char style="xo" closed="false">51:4 </char><char style="xt" closed="false"><ref loc="ROM 3:4">Rom. 3:4</ref></char></note></para>
  <para style="q2" vid="PSA 51:4">ne ayifiyaa sintsan iitabaa ootsaad.</para>
  <para style="q1" vid="PSA 51:4">Hewaa diraw, haasayaaddekka neeni likke;</para>
  <para style="q2" vid="PSA 51:4">pirddaaddekka neeni s'illuwaa.<verse eid="PSA 51:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5" />Taani yelettoodeppekka tumu nagaranchcha;</para>
  <para style="q2" vid="PSA 51:5">ta aatti uluwaan biro attiyaa wodeppe doommaadekka,</para>
  <para style="q2" vid="PSA 51:5">taani nagaranchcha.<verse eid="PSA 51:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6" />Hekko neeni wozana giddo tumatetsaa koyaasa;</para>
  <para style="q2" vid="PSA 51:6">hewaa diraw, ne aad'd'eeda eratetsaa ta garssan tamaarissa.<verse eid="PSA 51:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7" />Hiisoop'p'iyaa giyaa bonc'c'iyaan neeni taana geeshsha;</para>
  <para style="q2" vid="PSA 51:7">taani geeyana.</para>
  <para style="q1" vid="PSA 51:7">Taana meec'c'a;</para>
  <para style="q2" vid="PSA 51:7">taani shachchaappe aad'd'aade boos's'ana.<verse eid="PSA 51:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8" />Neeni taana nashshechchaanne</para>
  <para style="q2" vid="PSA 51:8">hashshu giyaawaa sisa;</para>
  <para style="q2" vid="PSA 51:8">neeni taana mentsereetseeddabaa gidooppekka,</para>
  <para style="q2" vid="PSA 51:8">zaaraadde nashshechchaa.<verse eid="PSA 51:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9" />Ta nagaraappe ne sintsa wora zaara;</para>
  <para style="q2" vid="PSA 51:9">ta iitatetsaa ubbaa k'uc'c'a.<verse eid="PSA 51:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10" />Abeet S'oossaw, geeshsha wozanaa ta giddon med'd'a;</para>
  <para style="q2" vid="PSA 51:10">minisiyaa ayaanaa ta giddon ooratsa.<verse eid="PSA 51:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11" />Taana ne sintsaappe oloppa;</para>
  <para style="q2" vid="PSA 51:11">ne Geeshsha Ayaanaa taappe akkoppa.<verse eid="PSA 51:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12" />Ne atotetsaa nashshechchaa taw zaaraadde imma;</para>
  <para style="q2" vid="PSA 51:12">taani new eeno gaade azazettanaadan,</para>
  <para style="q2" vid="PSA 51:12">Taana zemppissa.<verse eid="PSA 51:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13" />He wode taani bayzzanchchatuwaa ne ogiyaa tamaarissana;</para>
  <para style="q2" vid="PSA 51:13">he nagaranchchatuunne neekko simmana.<verse eid="PSA 51:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14" />Abeet S'oossaw, taana ashshiyaa S'oossaw,</para>
  <para style="q2" vid="PSA 51:14">suutsaa gusseedda nagaraappe taana ashsha;</para>
  <para style="q1" vid="PSA 51:14">He wode ta ins's'arssay ne s'illotetsaabaa yes's'ana.<verse eid="PSA 51:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15" />Abeet Godaw, ta doonaa dooyaa;</para>
  <para style="q2" vid="PSA 51:15">yaatooppe, ta ins's'arssay ne galataa awaayana.<verse eid="PSA 51:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16" />Neeni yarshshuwaan nashetantto ta new shiishshanashin,</para>
  <para style="q2" vid="PSA 51:16">neeni yarshshuwaan nashetakka.<verse eid="PSA 51:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17" />S'oossaw yarshshiyaa yarshshuu</para>
  <para style="q2" vid="PSA 51:17">ashkke ayaanaa; abeet S'oossaw,</para>
  <para style="q1" vid="PSA 51:17">«Nagaraa ootsennan aggaarikkitaashaa» giyaa,</para>
  <para style="q2" vid="PSA 51:17">me"eedda wozanaa neeni kad'akka.<verse eid="PSA 51:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18" />Abeet S'oossaw, ne dosuwaan S'iyooniw keeka;</para>
  <para style="q2" vid="PSA 51:18">Yerusaalame gimbbetuwaa gimbba.<verse eid="PSA 51:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19" />He wode s'illo yarshshuwaan,</para>
  <para style="q2" vid="PSA 51:19">S'uuggiyaa yarshshuwaaninne,</para>
  <para style="q2" vid="PSA 51:19">mehiyaa ashuwaa wurssi s'uuggiyaa yarshshuwaan neeni nashettana.</para>
  <para style="q2" vid="PSA 51:19">K'ay korumatuu ne yarshshiyaasan yarshshettana.<note caller="-" style="x"><char style="xo" closed="false">51:19 </char><char style="xt" closed="false"><ref loc="1SA 22:9-10">1 Sam. 22:9-10</ref></char></note><verse eid="PSA 51:19" /></para>
  <chapter eid="PSA 51" />
  <chapter number="52" style="c" sid="PSA 52" />
  <para style="s">Iitatuwaa Wurssetsaa Kaac'aa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Eedooma biittaa asaa gidiyaa Doyik'i Saa'oolakko biide, «Daawite Abimeleeka golle beedda» yaagiide odiide simmina Daawita Akeeka Timirttiyaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 52:1" />Neenoo, wolk'k'aama bitaniyaw,</para>
  <para style="q2" vid="PSA 52:1">S'oossaa asatuwaa bolla iitabaa ootsiyaawaadan,</para>
  <para style="q2" vid="PSA 52:1">gallassaa ubbaan ayaw c'eek'ettay?<verse eid="PSA 52:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2" />Neenoo, worddobaa haniyaawoo,</para>
  <para style="q2" vid="PSA 52:2">neeni haratuwaa d'ayissanaw mak'ettaasa.</para>
  <para style="q1" vid="PSA 52:2">Ne ins's'arssay kuussa mak'k'iliyaa mala.<verse eid="PSA 52:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3" />Neeni lo"uwaappe iitaa siik'aasa;</para>
  <para style="q2" vid="PSA 52:3">k'ay tumuwaa haasayiyaawaappe,</para>
  <para style="q2" vid="PSA 52:3">wordduwaa haasayiyaawaa dosaasa.<verse eid="PSA 52:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4" />Neenoo, worddanchchaw,</para>
  <para style="q2" vid="PSA 52:4">neeni k'ohiyaa k'aalaa ubbaa siik'aasa.<verse eid="PSA 52:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5" />Shin S'oossay neena med'inaw d'ayissana.</para>
  <para style="q2" vid="PSA 52:5">I neena dafananne ne golliyaappe bonk'k'iide kessana;</para>
  <para style="q1" vid="PSA 52:5">I neena pas'a de'iyaawanttu giddoppe d'ok'ollana.<verse eid="PSA 52:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6" />S'illotuu hawaa be'iide yayana.</para>
  <para style="q2" vid="PSA 52:6">Unttunttu hawaadan yaagiide, ne bolla miic'c'ana;<verse eid="PSA 52:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7" />«S'oossaa barew geessuwaa ootsibeenna,</para>
  <para style="q2" vid="PSA 52:7">bare duretetsaa daruwaan ammanetteeda,</para>
  <para style="q1" vid="PSA 52:7">Iita oosuwaan minneedda bitaniyaa</para>
  <para style="q2" vid="PSA 52:7">hawaa be'ite!» yaagana.<verse eid="PSA 52:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8" />Shin taani S'oossaa golliyaan aac'iya wogaraa mala.</para>
  <para style="q2" vid="PSA 52:8">Aggena Aa siik'uwaan taani med'i med'inaw ammanettay.<verse eid="PSA 52:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9" />Neeni ootseedda diraw,</para>
  <para style="q2" vid="PSA 52:9">Ta neena galatana,</para>
  <para style="q2" vid="PSA 52:9">taani neeni keeka gidiyaa diraw ne suntsaan hidootaa wotsay.</para>
  <para style="q2" vid="PSA 52:9">Taani S'oossaa asatuwaa sintsan neena sabbana.<verse eid="PSA 52:9" /></para>
  <chapter eid="PSA 52" />
  <chapter number="53" style="c" sid="PSA 53" />
  <para style="s">Asaa Iitatetsaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Daawita Akeekaa Timirttiyaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 53:1" />Boozatuu barenttu wozanaan,<note caller="-" style="x"><char style="xo" closed="false">53:1-3 </char><char style="xt" closed="false"><ref loc="ROM 3:10-12">Rom. 3:10-12</ref></char></note></para>
  <para style="q2" vid="PSA 53:1">«S'oossay baawa» yaagiino.</para>
  <para style="q2" vid="PSA 53:1">Unttunttu de'uu bayeedda.</para>
  <para style="q2" vid="PSA 53:1">Unttunttu sheneyiyaabaa ootsiino;</para>
  <para style="q2" vid="PSA 53:1">lo"iyaabaa ootsiyaa Asay baawa.<verse eid="PSA 53:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2" />S'oossaa koyiyaa eranchchatuu de'inttonne be'anaw,</para>
  <para style="q2" vid="PSA 53:2">S'oossay saluwaappe duge asaa s'eellee.<verse eid="PSA 53:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3" />Unttunttu ubbaykka S'oossaappe haakkeeddino;</para>
  <para style="q2" vid="PSA 53:3">ubbaykka ittippe tuneeddino.</para>
  <para style="q1" vid="PSA 53:3">Lo"uwaa ootsiyaa Asay baawa;</para>
  <para style="q2" vid="PSA 53:3">haray atto ittuunne baawa.<verse eid="PSA 53:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4" />S'oossay, «Hawanttu ta asaa bonk'k'i miyaa iita asatuu</para>
  <para style="q2" vid="PSA 53:4">tumu ayinne erikkinoo?</para>
  <para style="q1" vid="PSA 53:4">Unttunttu taana woossikkino» yaagee.<verse eid="PSA 53:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5" />Unttunttu kase dagammi erennawaa keeshshaa dagamana.</para>
  <para style="q2" vid="PSA 53:5">Ayaw gooppe, S'oossay bare asaa morkkiyaawanttu mek'etsaa laalana.</para>
  <para style="q1" vid="PSA 53:5">S'oossay unttuntta kad'eedda diraw, unttunttu yeellatana.<verse eid="PSA 53:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6" />Israa'eeliyaw atotetsay S'iyooneppe yeerennee!</para>
  <para style="q2" vid="PSA 53:6">S'oossay bare asaa omooduwaa zaariyaa wode,</para>
  <para style="q1" vid="PSA 53:6">Yaak'ooba zaratuu nashettana;</para>
  <para style="q2" vid="PSA 53:6">Israa'eeliyaa Asay nashshechchaw pooc'u gaana.<verse eid="PSA 53:6" /></para>
  <chapter eid="PSA 53" />
  <chapter number="54" style="c" sid="PSA 54" />
  <para style="s">Morkkiyaa Kushiyaappe Attanaw Shiik'eedda Woosaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Ziifan de'iyaa asatuu Saa'oolakko biide, «Daawite nu biittan k'osetteedda» yaagiide odiide simmina Daawite Akeekan Diis's'eedda Timirttiyaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1" />Abeet S'oossaw, ne suntsan taana ashsha;</para>
  <para style="q2" vid="PSA 54:1">ne wolk'k'an taana shatintsaa.<verse eid="PSA 54:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2" />Abeet S'oossaw, ta woosaa sisa;</para>
  <para style="q2" vid="PSA 54:2">ta doonaa haasayaa hayzza.<verse eid="PSA 54:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3" />Otoranchchatuu ta bolla denddiino;</para>
  <para style="q2" vid="PSA 54:3">dagantsiyaa asatuu taana wod'anaw koyiino.</para>
  <para style="q1" vid="PSA 54:3">Unttunttu S'oossaa alaalle giikkino.<verse eid="PSA 54:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4" />Hekko S'oossay taana maaddiyaawaa;</para>
  <para style="q2" vid="PSA 54:4">Goday taana zemppissiyaawaa.<verse eid="PSA 54:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5" />Abeet S'oossaw, ta morkketoo unttunttu iitatetsaa zaara.</para>
  <para style="q2" vid="PSA 54:5">Neeni ammanettiyaawaa gidiyaawaadan,</para>
  <para style="q2" vid="PSA 54:5">unttuntta d'ayissa.<verse eid="PSA 54:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6" />Abeet Med'inaa Godaw, taani ta sheniyaan new yarshshana;</para>
  <para style="q2" vid="PSA 54:6">neeni keeka gidiyaa diraw,</para>
  <para style="q1" vid="PSA 54:6">Taani ne suntsaa galatana.<verse eid="PSA 54:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7" />Ayaw gooppe, neeni taana</para>
  <para style="q2" vid="PSA 54:7">ta metuwaa ubbaappe ashshaadda;</para>
  <para style="q1" vid="PSA 54:7">Ta morkketuu s'oonettiyaawaa ta ayifiyaan be'aad.<verse eid="PSA 54:7" /></para>
  <chapter eid="PSA 54" />
  <chapter number="55" style="c" sid="PSA 55" />
  <para style="s">Laggetsay Kaddeedda Asaa Woosaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Daawite Akeekan Diis's'eedda Diitsaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 55:1" />Abeet S'oossaw, ta woosaa sisa;</para>
  <para style="q2" vid="PSA 55:1">ta maganaa ay metee gooppa.<verse eid="PSA 55:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 55:2" />Hayzza; ta woosaa sisa;</para>
  <para style="q2" vid="PSA 55:2">Ta k'ofay taana waayissina,</para>
  <para style="q2" vid="PSA 55:2">taani shabbarettaad.<verse eid="PSA 55:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 55:3" />Hewenne, ta morkkatuwaa kooshshaappenne,</para>
  <para style="q2" vid="PSA 55:3">iitatuwaa naak'uwaappe denddeeddawaana.</para>
  <para style="q1" vid="PSA 55:3">Unttunttu ta bolla metuwaa ahiinonne</para>
  <para style="q2" vid="PSA 55:3">barenttu hank'k'uwaan taana morkkiino.<verse eid="PSA 55:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4" />Ta wozana ayifiyaan diddik'ee;</para>
  <para style="q2" vid="PSA 55:4">hayk'k'uwaa hirggay taana maashiseedda.<verse eid="PSA 55:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5" />Taana yashshaynne kokkorssay oyk'k'eedda;</para>
  <para style="q2" vid="PSA 55:5">dagamay taana wod'i diggeedda.<verse eid="PSA 55:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6" />Taani, «Taw harap'p'iyaadan k'efii de'eerenneeshsha.</para>
  <para style="q2" vid="PSA 55:6">Yaanintto taani paalla baade shemppana shin;<verse eid="PSA 55:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7" />taani haakkaade baana shin;</para>
  <para style="q2" vid="PSA 55:7">Bazzuwaan de'ana shin.<verse eid="PSA 55:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8" />Taani gotiyaappenne uushuwaappe,</para>
  <para style="q2" vid="PSA 55:8">attiyaasaa elleellaade gakkana shin» yaagaad.<verse eid="PSA 55:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9" />Abeet S'oossaw, taani katamaa giddon</para>
  <para style="q2" vid="PSA 55:9">walassaanne wad'etaa be'eedda diraw,</para>
  <para style="q1" vid="PSA 55:9">Iitatuwaa haasayaa bulluuk'k'a.<verse eid="PSA 55:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10" />Iitatuu gallassinne k'amma,</para>
  <para style="q2" vid="PSA 55:10">gimbbiyaa yuuyyiino;</para>
  <para style="q1" vid="PSA 55:10">Iitatetsaynne kobay katamaa giddon de'ee.<verse eid="PSA 55:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11" />Bashshay Aa giddon de'ee;</para>
  <para style="q2" vid="PSA 55:11">naak'uukka c'imuukka Aa gutaraappe shaakkettenna.<verse eid="PSA 55:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12" />Taana boriyaawe ta morkkiyaa gidenna;</para>
  <para style="q2" vid="PSA 55:12">gidintto taani danddayana.</para>
  <para style="q1" vid="PSA 55:12">Ta bolla c'eek'ettiyaawe taana is's'iyaawaa gidenna;</para>
  <para style="q2" vid="PSA 55:12">gidintto taani aappe k'osettana.<verse eid="PSA 55:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13" />Shin hawaa ubbaa ootsiyaawe asaa,</para>
  <para style="q2" vid="PSA 55:13">ta laggiyaa,</para>
  <para style="q1" vid="PSA 55:13">Ta dabbuwaanne ta siik'uwaa.<verse eid="PSA 55:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14" />Nuuni ittuu ittuwaanna ulobaa haasayeeddo;</para>
  <para style="q2" vid="PSA 55:14">nuuni S'oossaa golliyaan asaana ittippe simeretteeddo.<verse eid="PSA 55:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15" />Ta morkketuu wodii gakkennan hayk'k'ino;</para>
  <para style="q2" vid="PSA 55:15">unttunttu pas'a moogettino.</para>
  <para style="q1" vid="PSA 55:15">Ayaw gooppe, iitatetsay</para>
  <para style="q2" vid="PSA 55:15">unttunttu giddoninne unttunttu de'iyaa saan de'ee.<verse eid="PSA 55:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16" />Shin taani S'oossaa s'eesay;</para>
  <para style="q2" vid="PSA 55:16">Med'inaa Goday taana ashshee.<verse eid="PSA 55:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17" />Wontta, gallassinne omarssi</para>
  <para style="q2" vid="PSA 55:17">taani waassananne ta metuwaa aw odana;</para>
  <para style="q1" vid="PSA 55:17">I taana sisana.<verse eid="PSA 55:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18" />Darotuu taana morkkooppekka,</para>
  <para style="q2" vid="PSA 55:18">I taana olaa tooraappe ashshee.<verse eid="PSA 55:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19" />Benippe kawutetsaa araatan utteedda S'oossay,</para>
  <para style="q2" vid="PSA 55:19">ta woosaa sisiide barenttu ogiyaa laammennawanttanne</para>
  <para style="q2" vid="PSA 55:19">barew yayyenawantta,</para>
  <para style="q2" vid="PSA 55:19">I kawushshana.<verse eid="PSA 55:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20" />Ta laggii bare dabbotuwaa k'ohanaw,</para>
  <para style="q2" vid="PSA 55:20">bare kushiyaa dentseedda;</para>
  <para style="q2" vid="PSA 55:20">unttunttunna c'aak'k'eteedda c'aak'uwaa koleedda.<verse eid="PSA 55:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21" />Aa haasayay oyssaappekka aad'd'eeda shuga;</para>
  <para style="q2" vid="PSA 55:21">shin bare wozanaan morkkeedda.</para>
  <para style="q1" vid="PSA 55:21">Aa k'aalatuu zayitiyaappekka aad'd'iide wololatiino;</para>
  <para style="q2" vid="PSA 55:21">shin kuussa mashshaadan k'ans's'eeddino.<verse eid="PSA 55:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22" />Ne tookuwaa Med'inaa Godaan wotsa;</para>
  <para style="q2" vid="PSA 55:22">I neena zemppissana.</para>
  <para style="q1" vid="PSA 55:22">S'oossay awudenne s'illotuu</para>
  <para style="q2" vid="PSA 55:22">shabbarettanaadan ootsenna.<verse eid="PSA 55:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23" />Shin Abeet S'oossaw, neeni</para>
  <para style="q2" vid="PSA 55:23">iita asatuwaa c'iimmo ollaan duge olana.</para>
  <para style="q1" vid="PSA 55:23">Suutsaa gussiyaawanttunne c'immiyaawanttu,</para>
  <para style="q2" vid="PSA 55:23">barenttu de'ana laytsaw baggaanne de'ikkino;</para>
  <para style="q1" vid="PSA 55:23">Shin taani neenan ammanettana.<note caller="-" style="x"><char style="xo" closed="false">55:23 </char><char style="xt" closed="false"><ref loc="1SA 21:13-15">1 Sam. 21:13-15</ref></char></note><verse eid="PSA 55:23" /></para>
  <chapter eid="PSA 55" />
  <chapter number="56" style="c" sid="PSA 56" />
  <para style="s">S'oossaan Zemppuwaa Woosaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Piliss's'eema asatuu Aa Gaate Giyaa Katamaan Omoodeedda Wode, Daawita Mazimuriyaa. Haako Saan Wolaa Bollan Utteedda Dogomattissi Geetettiide Suusulliyaan Yes'etteedda Mazimuriyaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 56:1" />Abeet S'oossaw, asatuu taana yederssiyaa dirawunne</para>
  <para style="q2" vid="PSA 56:1">gallassaa ubbankka ta morkketuu taana un"etseedda diraw,</para>
  <para style="q2" vid="PSA 56:1">taw k'aretta.<verse eid="PSA 56:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2" />Ta morkketuu gallassaa ubbaan</para>
  <para style="q2" vid="PSA 56:2">taana yederssiino;</para>
  <para style="q1" vid="PSA 56:2">C'oratuu otoruwaan taana un"etsiino.<verse eid="PSA 56:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3" />Taani yayyeedda wode,</para>
  <para style="q2" vid="PSA 56:3">neenan ammanettay.<verse eid="PSA 56:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 56:4" />Taani S'oossan ammanettay;</para>
  <para style="q2" vid="PSA 56:4">Taani Aa k'aalaa galatiyaa S'oossan</para>
  <para style="q2" vid="PSA 56:4">ammanettaynne yayyikke.</para>
  <para style="q2" vid="PSA 56:4">Asay taana ayaa ootsanee?<verse eid="PSA 56:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5" />Gallassaa ubbaan ta morkketuu,</para>
  <para style="q2" vid="PSA 56:5">taw metuwaa med'd'iino;</para>
  <para style="q1" vid="PSA 56:5">Unttunttu ubbaa gede taw iitabaa k'oppiino.<verse eid="PSA 56:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6" />Unttunttu ta bolla mak'ettiino;</para>
  <para style="q2" vid="PSA 56:6">kuukuliide wochchiinonne</para>
  <para style="q2" vid="PSA 56:6">ta ogiyaa naagiino;</para>
  <para style="q2" vid="PSA 56:6">taana wod'anaw koyiino.<verse eid="PSA 56:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7" />Unttunttu iitatetsaa diraw, unttuntta yeddoppa;</para>
  <para style="q2" vid="PSA 56:7">ne hank'k'uwaan he asatuwaa zik'k'i ootsa.<verse eid="PSA 56:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8" />Neeni taani toyilakattowaa paydaadda.</para>
  <para style="q2" vid="PSA 56:8">Taani woyssa afotsaa gussaadditantto, neeni eraasa.</para>
  <para style="q1" vid="PSA 56:8">Unttunttu ne mazggobiyaan de'ikkinoo?<verse eid="PSA 56:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9" />Taani neena s'eesiyaa wode,</para>
  <para style="q2" vid="PSA 56:9">ta morkketuu guyye simmana.</para>
  <para style="q1" vid="PSA 56:9">S'oossay ta bagga gidiyaawaa taani eray.<verse eid="PSA 56:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10" />Taani Aa k'aalaa galatiyaa S'oossay,</para>
  <para style="q2" vid="PSA 56:10">taani Aa k'aalaa galatiyaa Med'inaa Godaa,<verse eid="PSA 56:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11" />taani he S'oossan ammanettay; yayyikke.</para>
  <para style="q2" vid="PSA 56:11">Asay taana ay ootsanee?<verse eid="PSA 56:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12" />Abeet S'oossaw, taani,</para>
  <para style="q2" vid="PSA 56:12">new shiik'etteeddawaa ootsana;</para>
  <para style="q1" vid="PSA 56:12">Hewaa galataa yarshshuwaa taani new immana.<verse eid="PSA 56:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13" />Ayaw gooppe, neeni taana hayk'k'uwaappe,</para>
  <para style="q2" vid="PSA 56:13">ta gediyaa kunddetsaappe ashshaada.</para>
  <para style="q1" vid="PSA 56:13">Hewaa diraw, I pas'a de'iyaawanttu bollan poo'issiyaa poo'uwaan</para>
  <para style="q2" vid="PSA 56:13">S'oossaa sintsan taani hamettay.<note caller="-" style="x"><char style="xo" closed="false">56:13 </char><char style="xt" closed="false"><ref loc="1SA 22:1">1 Sam. 22:1</ref>; <ref loc="1SA 24:3">24:3</ref></char></note><verse eid="PSA 56:13" /></para>
  <chapter eid="PSA 56" />
  <chapter number="57" style="c" sid="PSA 57" />
  <para style="s">Maaduwaa Demanaw Shiik'eedda Woosaa</para>
  <para style="d">Zammaaretuwaa Kaappoo, Gonggolo giddoppe Saa'oolappe bak'atiide bi simmina Daawita Woosaa. «D'ayssoppa» Geetettiyaa Woosaan Yes'etteedda Woosaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 57:1" />Taana maara; abeet S'oossaw, taana maara;</para>
  <para style="q2" vid="PSA 57:1">taani neekko bak'atay.</para>
  <para style="q1" vid="PSA 57:1">Bashshay aad'd'ana gakkanaw,</para>
  <para style="q2" vid="PSA 57:1">ne k'efiyaa giddon bak'ataade attay.<verse eid="PSA 57:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2" />Taani Ubbaappe D'ok'k'iyaa S'oossaw,</para>
  <para style="q2" vid="PSA 57:2">taw ubbabaa ootsiyaa S'oossaw waassay.<verse eid="PSA 57:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3" />S'oossay saluwaappe maaduwaa kiittiide, taana ashshana;</para>
  <para style="q2" vid="PSA 57:3">taana naak'k'iyaawantta kawushshana;</para>
  <para style="q1" vid="PSA 57:3">S'oossay aggena bare siik'uwaanne</para>
  <para style="q2" vid="PSA 57:3">bare tumatetsaa taw kiittana.<verse eid="PSA 57:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4" />Taani ta morkkatuwaa giddon,</para>
  <para style="q2" vid="PSA 57:4">asaa bonk'k'iide miyaa gaammuwaa malatuwaa giddon de'ay.</para>
  <para style="q1" vid="PSA 57:4">Unttunttu achchay tooraanne wonddaafiyaa mala;</para>
  <para style="q2" vid="PSA 57:4">unttunttu ins's'arssay kuussa mashshaa mala.<verse eid="PSA 57:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5" />Abeet S'oossaw, neeni salotuwaappe bollaanna d'ok'k'u d'ok'k'u ga;</para>
  <para style="q2" vid="PSA 57:5">ne bonchchuu sa'aa ubbaa bolla de'o.<verse eid="PSA 57:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6" />Unttunttu ta gediyaw p'iriyaa wotseeddino;</para>
  <para style="q2" vid="PSA 57:6">taani metootaade hokkaad.</para>
  <para style="q1" vid="PSA 57:6">Unttunttu ta ogiyaan ollaa bookkeeddino;</para>
  <para style="q2" vid="PSA 57:6">shin he ollaan barenttoo kunddeeddino.<verse eid="PSA 57:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7" />Ta wozanay minniide de'ee;</para>
  <para style="q2" vid="PSA 57:7">Abeet S'oossaw, ta wozanay minniide de'ee.</para>
  <para style="q1" vid="PSA 57:7">Taani new yes's'ananne neena sabbana.<verse eid="PSA 57:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8" />Ta shemppattee, beegotta!</para>
  <para style="q2" vid="PSA 57:8">Diitsawunne maasink'k'oo, beegottite!</para>
  <para style="q1" vid="PSA 57:8">Taanikka wontta guuraanna beegottana.<verse eid="PSA 57:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9" />Abeet S'oossaw, taani neena asaa giddon galatana;</para>
  <para style="q2" vid="PSA 57:9">k'ay kawutetsaa giddon neena sabbana.<verse eid="PSA 57:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10" />Ayaw gooppe, aggena ne siik'uu wolk'k'aama;</para>
  <para style="q2" vid="PSA 57:10">salotuwaa gakkeedda.</para>
  <para style="q1" vid="PSA 57:10">Ne tumatetsaykka bolla shaariyaadan d'ok'k'ee.<verse eid="PSA 57:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11" />Abeet S'oossaw,</para>
  <para style="q2" vid="PSA 57:11">salotuwaappe bollaanna d'ok'k'u d'ok'k'u ga!</para>
  <para style="q1" vid="PSA 57:11">Ne bonchchuu sa'aa ubbaa bolla gido.<verse eid="PSA 57:11" /></para>
  <chapter eid="PSA 57" />
  <chapter number="58" style="c" sid="PSA 58" />
  <para style="s">S'oossay Nagaranchchatuwaa Muranaadan <optbreak />Shiik'o Woosaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Daawita Woossa. «D'ayssoppa» Geetettiyaa Mazimuriyaa waas'uwaan Yes'etteedda Woosaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 58:1" />Hinttenoo deriyaa mooddiyaawanttoo,</para>
  <para style="q2" vid="PSA 58:1">tumuwaappe likkiyaa haasayiitee?</para>
  <para style="q1" vid="PSA 58:1">Asaa ubbaa giddon s'illuwaa pirddiitee?<verse eid="PSA 58:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2" />Gidena, hintte wozanaan iitabaa halchchiita;</para>
  <para style="q2" vid="PSA 58:2">biittan hintte kushii makkalabaa ootseedda.<verse eid="PSA 58:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3" />Iita Asay aatti uluwaappe doommiide balee;</para>
  <para style="q2" vid="PSA 58:3">yelettoodeppe doommiide,</para>
  <para style="q1" vid="PSA 58:3">Bayzzeenne wordduwaa haasayee.<verse eid="PSA 58:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4" />Unttunttu shooshshaadan yishshaana de'iino;</para>
  <para style="q2" vid="PSA 58:4">Tulle hassuwaadan haytsaa tuc'c'eeddino.<verse eid="PSA 58:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5" />Bitiyaawe ay keeshsha hiilanchcha gidooppekka,</para>
  <para style="q2" vid="PSA 58:5">hasuu Aa saasuketsaa sisenna.<verse eid="PSA 58:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6" />Abeet S'oossaw, unttunttu achchaa</para>
  <para style="q2" vid="PSA 58:6">unttunttu gappataa giddon mentsa;</para>
  <para style="q2" vid="PSA 58:6">abeet Med'inaa Godaw, gaammotuwaa kasiliyaa d'ukka.<verse eid="PSA 58:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7" />Unttunttu goggi d'ayiyaa haatsaadan d'ayino.</para>
  <para style="q2" vid="PSA 58:7">Unttunttu barenttu wonddaafiyaa dukkiyaa wode,</para>
  <para style="q2" vid="PSA 58:7">pootsaa s'eeran c'addiyaa ayifii d'ayo.<verse eid="PSA 58:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8" />Unttunttu muushiide saasso kesiyaa d'aad'd'iyaadan hanino;</para>
  <para style="q2" vid="PSA 58:8">aatti uluwaappe boshettiide yeletteedda,</para>
  <para style="q2" vid="PSA 58:8">poo'uwaa be'enna na'aadan hanino.<verse eid="PSA 58:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9" />Unttunttu aguntsa gidiide daashanaappe kase,</para>
  <para style="q2" vid="PSA 58:9">unttunttu biro puutiyaan de'ishshin,</para>
  <para style="q1" vid="PSA 58:9">S'oossay unttuntta bare hank'k'uwaan d'ayissana.<verse eid="PSA 58:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10" />Haluwaa kessiyaawaa be'iyaa wode,</para>
  <para style="q2" vid="PSA 58:10">s'illotuu nashettana.</para>
  <para style="q1" vid="PSA 58:10">Iitatuwaa suutsan barenttu gediyaa meec'ettana.<verse eid="PSA 58:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11" />He wode asay,</para>
  <para style="q2" vid="PSA 58:11">«Tumukka s'illotoo woytuu de'ee;</para>
  <para style="q2" vid="PSA 58:11">tumukka sa'aa bolla pirddiyaa S'oossay de'ee» yaagana.<note caller="-" style="x"><char style="xo" closed="false">58:11 </char><char style="xt" closed="false"><ref loc="1SA 19:11">1 Sam. 19:11</ref></char></note><verse eid="PSA 58:11" /></para>
  <chapter eid="PSA 58" />
  <chapter number="59" style="c" sid="PSA 59" />
  <para style="s">Iitatuwaa Ek'etiide Shiik'o Woosaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Daawita wod'anaw Aa golliyaa naagana mala Saa'ooli asatuwaa kiitti simmina Daawita Mazimuriyaa. «D'ayssoppa» Giidde Diitsaa Giigissuwaan Yes'etteedda Woosaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 59:1" />Abeet ta S'oossaw, ta morkkatuwaappe taana ashsha;</para>
  <para style="q2" vid="PSA 59:1">ta bolla denddiyaawanttuppe taana naaga.<verse eid="PSA 59:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2" />Iita ootsiyaawanttuppe taana ashsha akka;</para>
  <para style="q2" vid="PSA 59:2">suutsaa gussiyaa asatuwaappe taana ashsha.<verse eid="PSA 59:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3" />Abeet S'oossaw, unttunttu taana wod'anaw</para>
  <para style="q2" vid="PSA 59:3">kuukuliide naagiyaawaa be'a!</para>
  <para style="q1" vid="PSA 59:3">He wolk'k'aama iita asatuu ta bolla yaa'iino.</para>
  <para style="q2" vid="PSA 59:3">Abeet Med'inaa Godaw, ta bayzzuwaa diraw</para>
  <para style="q2" vid="PSA 59:3">woy ta nagaraa diraw gidenna.<verse eid="PSA 59:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4" />Unttunttu taana olanaw wotsaa jaamiyaawe,</para>
  <para style="q2" vid="PSA 59:4">ta balaa diraassa gidenna.</para>
  <para style="q1" vid="PSA 59:4">Beegotta, taakko haa yaade be'a.<verse eid="PSA 59:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5" />Abeet Ubbaappe Wolk'k'aama Med'etaa Ubbaa Godaa S'oossaw,</para>
  <para style="q2" vid="PSA 59:5">Israa'eeliyaa S'oossaw,</para>
  <para style="q2" vid="PSA 59:5">kawutetsatuwaa ubbaa pirddanaw beegotta;</para>
  <para style="q2" vid="PSA 59:5">makkalaa ootsiyaawantta maaroppa.<verse eid="PSA 59:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6" />Unttunttu omarssan simmiino;</para>
  <para style="q2" vid="PSA 59:6">kanatuwaadan boc'c'iidde, katamaa giddon yuuyyiino.<verse eid="PSA 59:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7" />Hekko, unttunttu barenttu doonaan haasayiide salikkino;</para>
  <para style="q2" vid="PSA 59:7">unttunttu ins's'arssay mashshaa mala.</para>
  <para style="q1" vid="PSA 59:7">Unttunttu biro, «Ooninne sisenna» giide k'oppiino.<verse eid="PSA 59:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8" />Shin abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 59:8">neeni unttunttu bolla miic'c'aasa;</para>
  <para style="q2" vid="PSA 59:8">kawutetsatuwaa ubbaa bolla k'iliic'aasa.<verse eid="PSA 59:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9" />S'oossaw, neeni taw k'osetta attiyaa sa'aa gidiyaa diraw,</para>
  <para style="q2" vid="PSA 59:9">taani ne wolk'k'an ammanettay.<verse eid="PSA 59:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 59:10" />Ta S'oossay aggena bare siik'uwaan taakko yaana;</para>
  <para style="q2" vid="PSA 59:10">ta S'oossay ta morkkatuwaa s'ooniyaawaa I taana bessana.<verse eid="PSA 59:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11" />Ta asatuu doggenna mala, neeni unttuntta wod'oppa.</para>
  <para style="q2" vid="PSA 59:11">Abeet S'oossaw, nu gonddalliyaw,</para>
  <para style="q2" vid="PSA 59:11">ne wolk'k'an unttuntta laalaade s'oona.<verse eid="PSA 59:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12" />Unttunttu barenttu doonaa nagaraa dirawunne</para>
  <para style="q2" vid="PSA 59:12">barenttu ins's'arssaa k'aalaa diraw,</para>
  <para style="q2" vid="PSA 59:12">barenttu otoruwaan oyk'k'ettino.</para>
  <para style="q2" vid="PSA 59:12">Unttunttu shek'aa dirawunne unttunttu haasayiyaa wordduwaa diraw,<verse eid="PSA 59:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 59:13" />ne hank'k'uwaan unttuntta d'ayissa.</para>
  <para style="q2" vid="PSA 59:13">S'oossay Yaak'ooba zaratuwaa mooddiyaawaanne</para>
  <para style="q2" vid="PSA 59:13">sa'aa gas'aa gakkanaw de'iyaa biittaa mooddiyaawaa Asay erana mala,</para>
  <para style="q2" vid="PSA 59:13">unttuntta mule attenaadan d'ayissa.<verse eid="PSA 59:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14" />Ta morkketuu omarssan simmiino;</para>
  <para style="q2" vid="PSA 59:14">kanatuwaadan boc'c'iidde,</para>
  <para style="q2" vid="PSA 59:14">katamaa giddon yuuyyiino.<verse eid="PSA 59:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15" />Unttunttu miyaawaa demanaw toyilakattiino;</para>
  <para style="q2" vid="PSA 59:15">kallana d'ayooppe laawiino.<verse eid="PSA 59:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16" />Shin taani ne wolk'k'aa sabbana;</para>
  <para style="q2" vid="PSA 59:16">wontta aggena ne siik'uwaabaa yes's'ana.</para>
  <para style="q1" vid="PSA 59:16">Ayaw gooppe, neeni taw ta waayiyaa gallassi,</para>
  <para style="q2" vid="PSA 59:16">taani bak'ata attiyaa saanne k'osetta attiyaasaa gidaadda.<verse eid="PSA 59:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17" />Abeet taw wolk'k'aa gideedda S'oossaw,</para>
  <para style="q2" vid="PSA 59:17">taani neena sabbana.</para>
  <para style="q1" vid="PSA 59:17">Ayaw gooppe, taani k'osetta attiyaa sa'aynne</para>
  <para style="q2" vid="PSA 59:17">aggena siik'uwaa taana bessiyaa S'oossay neena.<note caller="-" style="x"><char style="xo" closed="false">59:17 </char><char style="xt" closed="false"><ref loc="2SA 8:13">2 Sam. 8:13</ref>; <ref loc="1CH 18:12">1 Od. 18:12</ref></char></note><verse eid="PSA 59:17" /></para>
  <chapter eid="PSA 59" />
  <chapter number="60" style="c" sid="PSA 60" />
  <para style="s">S'oossay Ashiyaawaa K'onc'c'issiyaa Woosaa</para>
  <para style="d">Zammaaretuwaa Kaappuu, Daawite, Masp'p'es'oomiyaaninne Sobaalan de'eedda Sooriyaa asatuwaana oletteedda wodenne, Yoo'aabi guyye simmiide Mas'iniyaa Zanggaaraan tammanne laa"u sha"u Eedoome asaa wod'eedda wode, Daawite timirttiyaw s'aafeedda woossa. Adilliyaa C'iishshaa Waatsaa. Markkatetsaa Woosaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 60:1" />Abeet S'oossaw, neeni nuuna aggaada;</para>
  <para style="q2" vid="PSA 60:1">nuuna mentsaadda.</para>
  <para style="q1" vid="PSA 60:1">Neeni nuuna hank'k'ettaadda;</para>
  <para style="q2" vid="PSA 60:1">shin ha"i nuukko simma.<verse eid="PSA 60:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2" />Neeni biittaa k'aatsaadanne za'issaadda;</para>
  <para style="q2" vid="PSA 60:2">biittay kokkoriyaa diraw, neeni Aa za'uwaa bara.<verse eid="PSA 60:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3" />Neeni ne asaa metuwaa bessaadda;</para>
  <para style="q2" vid="PSA 60:3">neeni nuuna ganddigaarissiyaa woyniyaa ushshaadda.<verse eid="PSA 60:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4" />New yayyiyaawanttu,</para>
  <para style="q2" vid="PSA 60:4">barenttu morkkiyaa wonddaafiyaappe attana mala,</para>
  <para style="q2" vid="PSA 60:4">malaa immaadda.<verse eid="PSA 60:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5" />Neeni siik'iyaawanttu attana mala,</para>
  <para style="q2" vid="PSA 60:5">ne ushechcha kushiyan nuuna ashsha;</para>
  <para style="q2" vid="PSA 60:5">neeni nuw alla.<verse eid="PSA 60:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6" />S'oossay bare geeshsha sa'aan hawaadan yaageedda;</para>
  <para style="q2" vid="PSA 60:6">«Taani s'oonaade Sekeema biittaa shaakkana;</para>
  <para style="q2" vid="PSA 60:6">k'ay Sukkoota zanggaaraa likkana.<verse eid="PSA 60:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7" />Gala'aade tawaa; Minaasekka taassa;</para>
  <para style="q2" vid="PSA 60:7">Efireemi ta huup'iyaa naagiyaa k'oobiyaa;</para>
  <para style="q1" vid="PSA 60:7">Yihuday ta kawutetsaa s'am"aa.<verse eid="PSA 60:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8" />Moo'aabe taani meec'ettiyaa kuyis'aaruwaa;</para>
  <para style="q2" vid="PSA 60:8">Eedoomi tawaa gidiyaawaa erissanaw ta c'aammaa Aa bolla wotsay;</para>
  <para style="q1" vid="PSA 60:8">Taani Piliss's'eema s'oonaade gereeray» yaageedda.<verse eid="PSA 60:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9" />Gimbbetteedda katamaakko, taana oonee afanawe?</para>
  <para style="q2" vid="PSA 60:9">Eedooma gakkanaw taana oonee kaaletsanawe?<verse eid="PSA 60:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10" />Abeet S'oossaw, nuuna aggeedawe neena gidikkii?</para>
  <para style="q2" vid="PSA 60:10">Abeet S'oossaw, neeni nu tooranchchatuwaanna olaw kesakka.<verse eid="PSA 60:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11" />Asaa maaduu patsenna diraw,</para>
  <para style="q2" vid="PSA 60:11">morkkiyaanna olettanaw neeni nuuna maadda.<verse eid="PSA 60:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12" />S'oossaa wolk'k'an nu morkkatuwaa nuuni s'oonana;</para>
  <para style="q2" vid="PSA 60:12">nu morkkatuwaa yed'd'anawe Aa.<verse eid="PSA 60:12" /></para>
  <chapter eid="PSA 60" />
  <chapter number="61" style="c" sid="PSA 61" />
  <para style="s">Naaganaadan Shiik'o Woosaa</para>
  <para style="d">Daawite Zammaaretuwaa Kaappoo Diitsaan Yes's'eedda Mazimuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 61:1" />Abeet S'oossaw, neeni ta waasuwaa sisa;</para>
  <para style="q2" vid="PSA 61:1">ta woosaa hayzza.<verse eid="PSA 61:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2" />Ta wozanay hidootaa k'ans's'o wode,</para>
  <para style="q2" vid="PSA 61:2">Taani biittaa gas'aappe neena s'eesay.</para>
  <para style="q1" vid="PSA 61:2">Taappe d'ok'k'iyaa zaallaakko, taana kaaletsa.<verse eid="PSA 61:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3" />Ayaw gooppe, neeni taw geessuwaanne</para>
  <para style="q2" vid="PSA 61:3">taani ta morkkatuwaappe naagettiyaa gimbbiyaa dirssaa.<verse eid="PSA 61:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4" />Taani ne dunkkaaniyaan med'inaw de'arikkitaa!</para>
  <para style="q2" vid="PSA 61:4">taani ne k'efiyaa hap'aa giddon saro attarikkitaa!<verse eid="PSA 61:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5" />Abeet S'oossaw, neeni ta k'anggetsaa sisaadda.</para>
  <para style="q2" vid="PSA 61:5">Ne suntsaa yayyiyaawanttu</para>
  <para style="q2" vid="PSA 61:5">laattiyaa laataa tawukka immaadda.<verse eid="PSA 61:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6" />Kaatiyaa laytsaa adussa;</para>
  <para style="q2" vid="PSA 61:6">I yeletaappe yeletaa gakkanaw de'o.<verse eid="PSA 61:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7" />I S'oossaa sintsan med'inaw kaateto;</para>
  <para style="q2" vid="PSA 61:7">aggena ne siik'uwaaninne ne tumatetsan Aa naaga.<verse eid="PSA 61:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8" />Yaatiyaawaa gidooppe, taani</para>
  <para style="q2" vid="PSA 61:8">ta k'anggetsaa gallassan gallassan gatsaadde,</para>
  <para style="q2" vid="PSA 61:8">ne suntsaa ubbaa gede sabbana.<verse eid="PSA 61:8" /></para>
  <chapter eid="PSA 61" />
  <chapter number="62" style="c" sid="PSA 62" />
  <para style="s">Hidootay S'oossaa Bolla S'alalan</para>
  <para style="d">Daawite Zammaaretuwaa Kaappuwaa Juddutoo Yes's'eedda Mazimuriyaa.</para>
  <para style="r">(<ref loc="1CH 25:3">1 Od. 25:3</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 62:1" />S'oossaa s'alalan taani shemppuwaa demmaad;</para>
  <para style="q2" vid="PSA 62:1">ta atotetsay aappe yee.<verse eid="PSA 62:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2" />Aa s'alalay ta zaallaanne ta atotetsaa;</para>
  <para style="q2" vid="PSA 62:2">I taani k'osetta attiyaa sa'aa gidiyaa diraw,</para>
  <para style="q2" vid="PSA 62:2">ayinne hirggikke.<verse eid="PSA 62:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3" />Woddiyaa godaanne k'aas's'iyaa dirssaa malatiyaa asaa wod'anaw,</para>
  <para style="q2" vid="PSA 62:3">hintte awude gakkanaw denddiitee?<verse eid="PSA 62:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4" />Unttunttu Aa bonchcho sa'aappe</para>
  <para style="q2" vid="PSA 62:4">Aa wotsanawaa s'alala koyiino;</para>
  <para style="q2" vid="PSA 62:4">unttunttu wordduwaan nashettiino.</para>
  <para style="q2" vid="PSA 62:4">Barenttu doonaan anjjiino;</para>
  <para style="q2" vid="PSA 62:4">shin barenttu wozanaan shek'iino.<verse eid="PSA 62:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5" />Ta shemppatta S'oossaa s'alalan shemppuwaa demmaaddu;</para>
  <para style="q2" vid="PSA 62:5">taani hidootan naagiyaawe aappe yee.<verse eid="PSA 62:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6" />Aa s'alalay ta zaallaanne ta atotetsaa;</para>
  <para style="q2" vid="PSA 62:6">I taani k'osetta attiyaa sa'aa gidiyaa diraw,</para>
  <para style="q2" vid="PSA 62:6">ayinne hirggikke.<verse eid="PSA 62:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7" />Ta atotetsaynne ta bonchchuu S'oossaanna;</para>
  <para style="q2" vid="PSA 62:7">I ta mino zaallaanne ta geessuwaa.<verse eid="PSA 62:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8" />Asaw, ubbaa wode S'oossan ammanettite;</para>
  <para style="q2" vid="PSA 62:8">I nuw geessuwaa gidiyaa diraw,</para>
  <para style="q2" vid="PSA 62:8">hintte wozanaa k'ofaa aw odite.<verse eid="PSA 62:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9" />Asay ubbay itti gede shemppiyaa c'arkkuwaa mala;</para>
  <para style="q2" vid="PSA 62:9">d'ok'k'ina zik'k'ina, Asay mela.</para>
  <para style="q1" vid="PSA 62:9">Miizaaniyaan wotsinakka unttunttu ayinne dees'ikkino;</para>
  <para style="q2" vid="PSA 62:9">unttunttu itti gede shemppiyaa c'arkkuwaappekka kawushiino.<verse eid="PSA 62:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10" />Makkalan shiishshowaan ammanettoppite;</para>
  <para style="q2" vid="PSA 62:10">wuu'i shiishshiide durettanaw halchchoppite.</para>
  <para style="q1" vid="PSA 62:10">Hintte duretetsay darooppekka,</para>
  <para style="q2" vid="PSA 62:10">hintte wozanaa Aa bolla wotsoppite.<verse eid="PSA 62:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11" />S'oossay itti gede odeedda, taani</para>
  <para style="q2" vid="PSA 62:11">laa"u yewuwaa sisaad; «Wolk'k'ay S'oossaassa.<verse eid="PSA 62:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 62:12" />Aggena siik'uu Godaawaa» yaageedda.<note caller="-" style="x"><char style="xo" closed="false">62:12 </char><char style="xt" closed="false"><ref loc="JOB 34:11">Yob. 34:11</ref>; <ref loc="JER 17:10">Erm. 17:10</ref>; <ref loc="MAT 16:27">Mat. 16:27</ref>; <ref loc="ROM 2:6">Rom. 2:6</ref>; <ref loc="REV 2:23">Sas'. 2:23</ref></char></note></para>
  <para style="q2" vid="PSA 62:12">Abeet S'oossaw, neeni asaa ubbaw</para>
  <para style="q1" vid="PSA 62:12">Aa oosuwaadan oosuwaadan zaarana.<note caller="-" style="x"><char style="xo" closed="false">62:12 </char><char style="xt" closed="false"><ref loc="1SA 23:14">1 Sam. 23:14</ref></char></note><verse eid="PSA 62:12" /></para>
  <chapter eid="PSA 62" />
  <chapter number="63" style="c" sid="PSA 63" />
  <para style="s">S'oossaa Koyussaa</para>
  <para style="d">Yihudaa Bazzuwaan de'iyaa wode Daawita mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1" />Abeet S'oossaw, neeni ta S'oossaa;</para>
  <para style="q2" vid="PSA 63:1">ta wozanay neena laamotee;</para>
  <para style="q2" vid="PSA 63:1">ta ashuukka neena amottee.</para>
  <para style="q1" vid="PSA 63:1">Meli za"eedda, haatsi bayinna biittaadan</para>
  <para style="q2" vid="PSA 63:1">ta kumentsaa asatetsay neena saamettee.<verse eid="PSA 63:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2" />Taani neena geeshsha sa'aan be'aad;</para>
  <para style="q2" vid="PSA 63:2">ne wolk'k'aakka ne bonchchuwaakka taani be"aad.<verse eid="PSA 63:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3" />Aggena ne siik'uu de'uwaappe lo"iyaa diraw,</para>
  <para style="q2" vid="PSA 63:3">ta ins's'arssay neena bonchchana.<verse eid="PSA 63:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4" />Ta de'uwaa laytsan taani neena galatana;</para>
  <para style="q2" vid="PSA 63:4">ne suntsan ta kushiyaa pude mic'c'ana.<verse eid="PSA 63:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5" />Asay lo"o k'umaa kalliyaawaadan,</para>
  <para style="q2" vid="PSA 63:5">ta shemppatta neenan kallana.</para>
  <para style="q1" vid="PSA 63:5">Taani ta ins's'arssan nashshechchaa yetsan neena galatana.<verse eid="PSA 63:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6" />Taani ta gisuwaan neena hassayay;</para>
  <para style="q2" vid="PSA 63:6">k'ammaa ubbaan nebaa k'oppay;<verse eid="PSA 63:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7" />ayaw gooppe, neeni taana maadeeddawaa.</para>
  <para style="q2" vid="PSA 63:7">Taani ne k'efiyaa kuwaan uttaade, nashshechchaw yes's'ay.<verse eid="PSA 63:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8" />Taani ne mata shiik'a uttay;</para>
  <para style="q2" vid="PSA 63:8">ne ushechcha kushii taana oyk'k'iide naagee.<verse eid="PSA 63:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9" />Shin taana wod'ana koyiyaawanttu,</para>
  <para style="q2" vid="PSA 63:9">biittaa garssa c'iimmo sa'aan moogettana.<verse eid="PSA 63:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10" />Unttunttu mashshaw aad'd'iide imettana;</para>
  <para style="q2" vid="PSA 63:10">unttunttu babark'k'iyaa kaate gidana.<verse eid="PSA 63:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11" />Shin kaatii S'oossan nashettana.</para>
  <para style="q2" vid="PSA 63:11">S'oossaa suntsan c'aak'k'iyaa ubbay Aa galatana;</para>
  <para style="q2" vid="PSA 63:11">shin wordduwaa haasayiyaawanttu doonay gorddettana.<verse eid="PSA 63:11" /></para>
  <chapter eid="PSA 63" />
  <chapter number="64" style="c" sid="PSA 64" />
  <para style="s">Naaganaadan Shiik'o Woosaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Daawita mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1" />Abeet S'oossaw, taani maganniyaa maganaa neeni sisa.</para>
  <para style="q2" vid="PSA 64:1">Taani ta morkketoo yayaad; taana ashsha.<verse eid="PSA 64:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2" />Iitatuwaa mak'k'uwaappenne,</para>
  <para style="q2" vid="PSA 64:2">iitaa ootsiyaawanttu shiik'uwaappe taana gentsaa.<verse eid="PSA 64:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3" />Unttunttu barenttu ins's'arssaa mashshaadan leefeeddino;</para>
  <para style="q2" vid="PSA 64:3">k'ay marzze k'aalatuwaa,</para>
  <para style="q2" vid="PSA 64:3">wonddaafiyaa pootsaadan dukkanaw giigisseeddino.<verse eid="PSA 64:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4" />Unttunttu k'osettiide,</para>
  <para style="q2" vid="PSA 64:4">barenttu wonddaafiyaa s'illo asaa bolla dafiino;</para>
  <para style="q2" vid="PSA 64:4">akeekay bayinnan dukkiino; unttunttu yayyikkino.<verse eid="PSA 64:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5" />Unttunttu barenttu iita mak'k'oo ittuu ittuwaa mintsetsiino;</para>
  <para style="q2" vid="PSA 64:5">barenttu p'iriyaa k'osiyaasaa zorettiino.</para>
  <para style="q1" vid="PSA 64:5">Unttunttu, «nuuna ooni be'anee?» yaagiino.<verse eid="PSA 64:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6" />Unttunttu iitabaa mak'ettiidde,</para>
  <para style="q2" vid="PSA 64:6">«Nuuni lo"o mak'k'uwaa mak'etteeddo» yaagiino.</para>
  <para style="q1" vid="PSA 64:6">Hewenne, asaw wozanaynne kahay c'iimma gidiyaawaa bessee.<verse eid="PSA 64:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7" />Shin S'oossay unttuntta bare wonddaafiyaan dukkana;</para>
  <para style="q2" vid="PSA 64:7">unttunttu akeekenan madus's'ana.<verse eid="PSA 64:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8" />Unttunttu mak'k'uwaa diraw,</para>
  <para style="q2" vid="PSA 64:8">I unttuntta d'ayissana;</para>
  <para style="q2" vid="PSA 64:8">unttuntta be'iyaa ubbay huup'iyaa k'aatsana.<verse eid="PSA 64:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9" />He wode Asay ubbay S'oossaw yayana;</para>
  <para style="q2" vid="PSA 64:9">Aa oosuwaabaa odananne zaari zaariide k'oppana.<verse eid="PSA 64:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10" />S'illotuu Med'inaa Godaan nashetinonne,</para>
  <para style="q2" vid="PSA 64:10">aakko bak'atiide attiino;</para>
  <para style="q2" vid="PSA 64:10">wozanaa suuretuu ubbay galatino.<verse eid="PSA 64:10" /></para>
  <chapter eid="PSA 64" />
  <chapter number="65" style="c" sid="PSA 65" />
  <para style="s">Galataa Mazimuriyaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Daawita mazamuriyaa, Sabaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1" />Abeet S'oossaw, S'iyoonen new galatay bessee;</para>
  <para style="q2" vid="PSA 65:1">nuuni new shiik'etteeddawaakka gatsana.<verse eid="PSA 65:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2" />Abeet woosaa sisiyaawoo,</para>
  <para style="q2" vid="PSA 65:2">asay ubbay neekko yaana.<verse eid="PSA 65:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3" />Nu nagaray nuuna muukkeedda wode,</para>
  <para style="q2" vid="PSA 65:3">ne nuw atotetsaa immaadda.<verse eid="PSA 65:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4" />Neeni dooreeddanne ne chilootan uttanaw</para>
  <para style="q2" vid="PSA 65:4">mataa shiishshiyaa Asay anjjetteeddawaa.</para>
  <para style="q1" vid="PSA 65:4">Nuuni ne son, Geeshsha Dunkkaaniyaan</para>
  <para style="q2" vid="PSA 65:4">de'iyaa lo"oban kumeeddo.<verse eid="PSA 65:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5" />Abeet nuuna ashshiyaa S'oossaw,</para>
  <para style="q2" vid="PSA 65:5">maalalissiyaa ne s'illo oosuwaan neeni nuw allaasa.</para>
  <para style="q1" vid="PSA 65:5">Sa'aa gas'aappe gas'aa gakkanaw,</para>
  <para style="q2" vid="PSA 65:5">haakko abbatuwaappekka hefintsan de'iyaa asaa ubbaw,</para>
  <para style="q2" vid="PSA 65:5">ammanettiyaawe neena.<verse eid="PSA 65:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6" />Neeni neena wolk'k'aa danc'c'isaade;</para>
  <para style="q2" vid="PSA 65:6">wolk'k'aama deretuwaa ne minotetsan essaadda.<verse eid="PSA 65:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7" />Neeni abbaa kooshshaanne,</para>
  <para style="q2" vid="PSA 65:7">beetaa guntsaa sirp'p'i ootsaasa;</para>
  <para style="q2" vid="PSA 65:7">k'ay Asay denddiyaa dendduwaa irs's'issaasa.<verse eid="PSA 65:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8" />Hewaadan neeni ootseedda malaataa diraw,</para>
  <para style="q2" vid="PSA 65:8">sa'aa gas'aa gakkanaw de'iyaa Asay ubbay new, «Hoola!» gee.</para>
  <para style="q1" vid="PSA 65:8">Away mokkiyaasaappe wulliyaasaa gakkanaw de'iyaa asaa ubbaa nashechchaadda.<verse eid="PSA 65:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9" />Neeni biittaa naagaade iraa bukissaasa;</para>
  <para style="q2" vid="PSA 65:9">yaataade daro tu'eyaasa.</para>
  <para style="q1" vid="PSA 65:9">Asaw katsay mokkana mala,</para>
  <para style="q2" vid="PSA 65:9">S'oossaa pulttotuu haatsaan kumeeddino;</para>
  <para style="q2" vid="PSA 65:9">hewaadan ootsaade neeni giigissaadda.<verse eid="PSA 65:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10" />Kaachaa wod'ana malanne guulluwaa shugissana mala,</para>
  <para style="q2" vid="PSA 65:10">neeni yafaran haatsaa kuntsaassa;</para>
  <para style="q2" vid="PSA 65:10">katsay mokkana mala anjjaasa.<verse eid="PSA 65:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11" />Laytsaa kalo laytsaa ootsaasa;</para>
  <para style="q2" vid="PSA 65:11">neeni aad'd'iyaa sa'ay ubbay kumi palahee.<verse eid="PSA 65:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12" />Neeni hentsaa sa'aa maatan kuntsaassa;</para>
  <para style="q2" vid="PSA 65:12">zoozetuwaakka nashshechchaa danc'c'isaasa.<verse eid="PSA 65:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13" />Neeni hentsaa gadiyaa dorssaa wudiyaa mayzzaasa;</para>
  <para style="q2" vid="PSA 65:13">zanggaaraa biittaakka katsaa kuntsaa.</para>
  <para style="q1" vid="PSA 65:13">Unttunttu nashshechchaw hombboc'iinonne yes's'iino.<verse eid="PSA 65:13" /></para>
  <chapter eid="PSA 65" />
  <chapter number="66" style="c" sid="PSA 66" />
  <para style="s">Ittipetetsaa Galataa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda Sabaa, mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 66:1" />Sa'aan asaa ubbaw, hintte k'aalaa d'ok'k'issiide,</para>
  <para style="q2" vid="PSA 66:1">nashshechchan S'oossaa galatite.<verse eid="PSA 66:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 66:2" />«S'oossaa suntsay bonchchetto!» giide yes's'ite;</para>
  <para style="q2" vid="PSA 66:2">bonchcho galataa aw immite.<verse eid="PSA 66:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3" />S'oossaw hawaadan yaagite;</para>
  <para style="q2" vid="PSA 66:3">«Ne oosotuu waan malalissiyaawanttee!</para>
  <para style="q1" vid="PSA 66:3">Ne wolk'k'ay dareedda diraw,</para>
  <para style="q2" vid="PSA 66:3">ne morkketuu yashshaw ne sintsan kokkoriino.<verse eid="PSA 66:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4" />Sa'aan de'iyaa ubbatuu new goyinniino;</para>
  <para style="q2" vid="PSA 66:4">neena sabbiino;</para>
  <para style="q2" vid="PSA 66:4">ne suntsaw galataa yes's'iino» yaagite.<verse eid="PSA 66:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5" />Haayite; S'oossay ootseeddawaa be'ite;</para>
  <para style="q2" vid="PSA 66:5">I asaa giddon maalalissiyaa oosuwaa ootseedda.<verse eid="PSA 66:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6" />I abbaa haatsaa shaakeedda;<note caller="-" style="x"><char style="xo" closed="false">66:6 </char><char style="xt" closed="false"><ref loc="EXO 14:21">Kes. 14:21</ref>; <ref loc="JOS 3:14-17">Iya. 3:14-17</ref></char></note></para>
  <para style="q2" vid="PSA 66:6">k'ay beni nu aawotuu yorddaanoosa shaafaa,</para>
  <para style="q2" vid="PSA 66:6">barenttu gediyaan hamettiide, mela biittaan pinneeddino.</para>
  <para style="q2" vid="PSA 66:6">Hewan I ootseeddabaan nuuni nashetteeddo.<verse eid="PSA 66:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7" />I bare wolk'k'an med'inaw mooddee.</para>
  <para style="q2" vid="PSA 66:7">Kawutetsatuwaa bare ayifiyaan s'eellee;</para>
  <para style="q2" vid="PSA 66:7">hewaa diraw, makkaliyaawanttu Aa bolla denddoppino.<verse eid="PSA 66:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8" />Asatoo, nu S'oossaa galatite;</para>
  <para style="q2" vid="PSA 66:8">hintte Aa galatiyaa galatay sisetto.<verse eid="PSA 66:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9" />I nuuna pas'a wotseedda;</para>
  <para style="q2" vid="PSA 66:9">nuuni kunddennaadan naageedda.<verse eid="PSA 66:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10" />Abeet S'oossaw, neeni nuuna paac'c'aadda;</para>
  <para style="q2" vid="PSA 66:10">biraa geeshshanaw taman paac'iyaawaadan,</para>
  <para style="q2" vid="PSA 66:10">nuuna geeshshaadda.<verse eid="PSA 66:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11" />Neeni nuuna p'iriyaan gelissaadda.</para>
  <para style="q2" vid="PSA 66:11">Nu zokkuwaankka dees'obaa toossaadda.<verse eid="PSA 66:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12" />Morkketuu nu huup'iyaan togganaadan ootsaadda.</para>
  <para style="q2" vid="PSA 66:12">Nuuni haatsaa gidduwaananne tamaa gidduwaana aad'd'eedo;</para>
  <para style="q2" vid="PSA 66:12">shin ha"i nuuna ishaliyaa sa'aa ahaadda.<verse eid="PSA 66:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13" />Taani s'uuggiyaa yarshshuwaanna ne golliyaa gelaade,</para>
  <para style="q2" vid="PSA 66:13">ta k'anggiyaa new gatsana.<verse eid="PSA 66:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14" />Taani metooteedda wode,</para>
  <para style="q2" vid="PSA 66:14">ta doonaan shiik'etteedda k'anggiyaa,</para>
  <para style="q2" vid="PSA 66:14">ta ins's'arssaappe keseeddawaa, taani gatsana.<verse eid="PSA 66:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15" />Taani new s'uuggiide yarshshiyaa,</para>
  <para style="q2" vid="PSA 66:15">dorssaa orggetuwaa shiishshana.</para>
  <para style="q1" vid="PSA 66:15">Koruma booratuwaanne deeshsha orggetuwaa new yarshshana;</para>
  <para style="q2" vid="PSA 66:15">he yarshshotuwaa c'uway saluwaa gakkana.<verse eid="PSA 66:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16" />Hinttenoo, S'oossaw yayyiyaawanttoo,</para>
  <para style="q2" vid="PSA 66:16">ubbatuu haa yiide, sisite.</para>
  <para style="q1" vid="PSA 66:16">S'oossay taw ootseeddawaa taani hinttew odana.<verse eid="PSA 66:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17" />Ta k'aalaa d'ok'k'u ootsaade taani S'oossaa woossaad;</para>
  <para style="q2" vid="PSA 66:17">ta ins's'arssan aw galataa shiishshaad.<verse eid="PSA 66:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18" />Taani ta wozanaan nagaraa gentseeddentto,</para>
  <para style="q2" vid="PSA 66:18">Goday taana sisenna.<verse eid="PSA 66:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19" />Shin S'oossay tumuwaappe taana siseedda;</para>
  <para style="q2" vid="PSA 66:19">ta woosaakka hayzzeedda.<verse eid="PSA 66:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20" />S'oossay ta woosaa is's'ibeenna diraw,</para>
  <para style="q2" vid="PSA 66:20">k'ay aggena bare siik'uwaa taw diggibeenna diraw, galateetto.<verse eid="PSA 66:20" /></para>
  <chapter eid="PSA 66" />
  <chapter number="67" style="c" sid="PSA 67" />
  <para style="s">Galataa Mazimuriyaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Diitsaan Waas'eteedda Mazimuriyaa, sabaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 67:1" />S'oossay nuw k'arettonne nuuna anjjo;</para>
  <para style="q2" vid="PSA 67:1">bare som"iyaa nu bollan poo'isso.<verse eid="PSA 67:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2" />Ne ogetuu ha sa'aa bollan,</para>
  <para style="q2" vid="PSA 67:2">ne ashshiyaa wolk'k'aykka,</para>
  <para style="q2" vid="PSA 67:2">kawutetsatuwaa ubbaa gidduwaan erettino.<verse eid="PSA 67:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3" />Abeet S'oossaw, Asay neena galato;</para>
  <para style="q2" vid="PSA 67:3">asay ubbay neena galato.<verse eid="PSA 67:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4" />Kawutetsatuu ubbay, «Hashshu!» giide,</para>
  <para style="q2" vid="PSA 67:4">nashshechchaw yiino.</para>
  <para style="q1" vid="PSA 67:4">Ayaw gooppe, neeni asaa s'illotetsan pirddaasa;</para>
  <para style="q2" vid="PSA 67:4">k'ay sa'aan de'iyaa kawutetsatuwaa kaaletsaasa.<verse eid="PSA 67:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5" />Abeet S'oossaw, Asay neena galato;</para>
  <para style="q2" vid="PSA 67:5">asay ubbay neena galato.<verse eid="PSA 67:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6" />Biittay katsaa mokkeedda;</para>
  <para style="q2" vid="PSA 67:6">S'oossay, nu S'oossay nuuna anjjeedda.<verse eid="PSA 67:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7" />S'oossay nuuna anjjeedda.</para>
  <para style="q2" vid="PSA 67:7">Sa'aa gas'aa gakkanaw de'iyaa Asay ubbay aw yayyo.<verse eid="PSA 67:7" /></para>
  <chapter eid="PSA 67" />
  <chapter number="68" style="c" sid="PSA 68" />
  <para style="s">S'oonuwaa Mazimuriyaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Daawite s'aafeedda mazamuriyaa, yetsaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 68:1" />S'oossay denddo; Aa morkketuu laalettino.</para>
  <para style="q2" vid="PSA 68:1">Aa is's'iyaawanttu Aa sintsaappe bak'attino.<verse eid="PSA 68:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2" />C'uway c'arkkuwaan punettiyaawaadan,</para>
  <para style="q2" vid="PSA 68:2">neeni unttuntta punna d'ayssa.</para>
  <para style="q1" vid="PSA 68:2">Muk'aadday taman muushiyaawaadan,</para>
  <para style="q2" vid="PSA 68:2">iitatuu S'oossaa sintsappe d'ayino.<verse eid="PSA 68:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3" />Shin s'illotuu hashshu giino;</para>
  <para style="q2" vid="PSA 68:3">S'oossaa sintsan nashetino;</para>
  <para style="q2" vid="PSA 68:3">nashshechchan ililino.<verse eid="PSA 68:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4" />S'oossaw yes's'ite; Aa suntsaa sabbite.</para>
  <para style="q2" vid="PSA 68:4">Shaariyaa bollan gaalifiyaawaa d'ok'k'u d'ok'k'u ootsite kessite;</para>
  <para style="q1" vid="PSA 68:4">Aa suntsay Med'inaa Godaa;</para>
  <para style="q2" vid="PSA 68:4">Aa sintsan nashettite.<verse eid="PSA 68:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5" />S'oossay bare de'iyaa geeshsha sa'aan,</para>
  <para style="q2" vid="PSA 68:5">aawuu bayinna naanaatoo aawuwaa;</para>
  <para style="q2" vid="PSA 68:5">k'ay asinay hayk'k'eedda mac'c'a asatoo daana.<verse eid="PSA 68:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6" />S'oossay barekka de'iyaawanttoo golle asaa immee.</para>
  <para style="q2" vid="PSA 68:6">K'asho golliyaan de'iyaawantta biliide,</para>
  <para style="q2" vid="PSA 68:6">unttuntta ishaluwaan wotsee.</para>
  <para style="q2" vid="PSA 68:6">Shin makkalanchchatuu meleedda biittan de'iino.<verse eid="PSA 68:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7" />Abeet S'oossaw, neeni ne asaa kaaletseedda wode,</para>
  <para style="q2" vid="PSA 68:7">neeni unttunttunna mela bazzuwaa beedda wode,<verse eid="PSA 68:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8" />Siina Deriyan k'onc'c'eedda S'oossaa sintsan,</para>
  <para style="q2" vid="PSA 68:8">Israa'eeliyaa S'oossaa sintsan biittay k'aas's'eedda;</para>
  <para style="q2" vid="PSA 68:8">salotuu iraa duge tigeeddino.<note caller="-" style="x"><char style="xo" closed="false">68:8 </char><char style="xt" closed="false"><ref loc="EXO 19:18">Kes. 19:18</ref></char></note><verse eid="PSA 68:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9" />Abeet S'oossaw, neeni iraa darissaade bukissaadda;</para>
  <para style="q2" vid="PSA 68:9">mela biittaa zaaraadde ooratsaadda.<verse eid="PSA 68:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10" />Ne asaykka yaan utteedda.</para>
  <para style="q2" vid="PSA 68:10">Abeet S'oossaw, ne keekkatetsan,</para>
  <para style="q2" vid="PSA 68:10">hiyyeesatoo koshshiyaabaa giigissaade immaadda.<verse eid="PSA 68:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11" />Goday kiitaa kiitteedda;</para>
  <para style="q2" vid="PSA 68:11">he kiitaa afeeda mac'c'a asatuu dara.<verse eid="PSA 68:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12" />Unttunttu, «Morkke kaatetuunne</para>
  <para style="q2" vid="PSA 68:12">unttunttu tooranchchatuu guyye bak'ateeddino;</para>
  <para style="q2" vid="PSA 68:12">son atteeda mac'c'a asatuu omooduwaa shaakketteeddino.<verse eid="PSA 68:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13" />Unttunttu, P'ooliyaa work'k'aa k'efiyaana de'iyaa,</para>
  <para style="q2" vid="PSA 68:13">biraappe med'etteedda harap'p'iyaa misiliyaa,</para>
  <para style="q2" vid="PSA 68:13">omooduwaa demmoode, hinttenttu,</para>
  <para style="q2" vid="PSA 68:13">dorssaa sikuwaa giddon ayaw giseedditee?» yaageeddino.<verse eid="PSA 68:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14" />Ubbaa Danddayiyaa S'oossay,</para>
  <para style="q2" vid="PSA 68:14">kaatetuwaa laaleedda wode,</para>
  <para style="q1" vid="PSA 68:14">S'almmoona asaa bolla shachchaa bukisseedda.<verse eid="PSA 68:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15" />Baasaane deretuu wogga wolk'k'aama deretuwaa;</para>
  <para style="q2" vid="PSA 68:15">baasaane deretuu daro s'eeratuu de'iyaawantta.<verse eid="PSA 68:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16" />Daro s'eeratuu de'iyaa deretoo,</para>
  <para style="q2" vid="PSA 68:16">S'oossay baressa ootsanaw dooreedda asaa,</para>
  <para style="q2" vid="PSA 68:16">hintte ayaw k'anaatiide s'eelliitee?</para>
  <para style="q2" vid="PSA 68:16">Med'inaa Goday aan med'inaw de'anawaa.<verse eid="PSA 68:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17" />S'oossaa olaa paraa gaaretuu</para>
  <para style="q2" vid="PSA 68:17">tammu sha"aaninne sha"u gede sha"an paydetiyaawantta;</para>
  <para style="q2" vid="PSA 68:17">Goday Siinaa deriyaappe bare geeshsha sa'aa yeedda.<verse eid="PSA 68:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18" />Omoodetteedda darotuwaa akkiide,</para>
  <para style="q2" vid="PSA 68:18">I pude d'ok'k'aa keseedda.<note caller="-" style="x"><char style="xo" closed="false">68:18 </char><char style="xt" closed="false"><ref loc="EPH 4:8">Efe. 4:8</ref></char></note></para>
  <para style="q1" vid="PSA 68:18">Asaappe, haray atto makkalanchcha asaappekka imuwaa akkeedda.</para>
  <para style="q2" vid="PSA 68:18">Med'etaa Ubbaa Goday yaan de'ana.<verse eid="PSA 68:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19" />Gallassaan gallassaan nu tookuwaa tookkiyaa Goday,</para>
  <para style="q2" vid="PSA 68:19">nuuna ashiyaa S'oossay galatetto.<verse eid="PSA 68:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20" />Ee, nu S'oossay nuuna ashshiyaa S'oossaattee!</para>
  <para style="q2" vid="PSA 68:20">Hayk'k'uwaappe attiyaawe,</para>
  <para style="q1" vid="PSA 68:20">Ubbaa Mooddiyaa Med'inaa Goday ashshinada.<verse eid="PSA 68:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21" />S'oossay tumuwaappe bare morkkatuwaa,</para>
  <para style="q2" vid="PSA 68:21">guuggiyaa kinchchana;</para>
  <para style="q2" vid="PSA 68:21">nagaraa ogiyaan hamettiyaa,</para>
  <para style="q2" vid="PSA 68:21">goofaranchchatuwaa huup'iyaa p'alk'k'ana.<verse eid="PSA 68:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22" />Goday yaageedda; «Taani hintte morkkatuwaa,</para>
  <para style="q2" vid="PSA 68:22">Baasaaneppe zaaraadde ahana;</para>
  <para style="q2" vid="PSA 68:22">taani unttuntta c'iimmo abbaa giddoppe kessaade guyye ahana.<verse eid="PSA 68:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23" />Hewenne, neeni ne morkkatuwaa,</para>
  <para style="q2" vid="PSA 68:23">suutsaa gidduwaana c'olbbaya yed'd'aade hamettanaassanne;</para>
  <para style="q2" vid="PSA 68:23">ne kanatuukka morkkiyaa suutsaappe,</para>
  <para style="q2" vid="PSA 68:23">barenttu gishuwaa ins's'arssan laac'c'anaassa» yaageedda.<verse eid="PSA 68:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24" />Abeet S'oossaw, ne salppii,</para>
  <para style="q2" vid="PSA 68:24">ta S'oossaa ta kaatiyaa salppii,</para>
  <para style="q2" vid="PSA 68:24">Geeshsha Golliyaa geliyaa wode ubbaw beettee.<verse eid="PSA 68:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25" />Yes's'iyaawanttu sintsaana; diis's'iyaawanttu guyyenna;</para>
  <para style="q2" vid="PSA 68:25">k'ay karabuwaa bak'k'iyaa wodorotuu gidduwaana.<verse eid="PSA 68:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26" />Unttunttu, «S'oossaa kuntseedda shiik'uwaan galatite;</para>
  <para style="q2" vid="PSA 68:26">hinttenoo, Israa'eeliyaa zeretsatoo,</para>
  <para style="q1" vid="PSA 68:26">Med'inaa Godaa galatite» yaagiino.<verse eid="PSA 68:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27" />He salppiyaan ubbaappe teefatiyaa,</para>
  <para style="q2" vid="PSA 68:27">Biiniyaama zaratuu koyiro beettiino.</para>
  <para style="q1" vid="PSA 68:27">Kaalliide Yihudaa kaappatuu barenttu c'itaana de'iino;</para>
  <para style="q2" vid="PSA 68:27">wurssetsan Zaabiloona Kaappatuunne Nifttaaleema kaappatuu beettiino.<verse eid="PSA 68:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28" />Abeet S'oossaw, ne wolk'k'aa k'onc'c'issa.</para>
  <para style="q2" vid="PSA 68:28">Abeet nuw ootseedda S'oossaw,</para>
  <para style="q2" vid="PSA 68:28">ne minotetsaa bessa.<verse eid="PSA 68:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29" />Hewaa diraw, Yerusaalamen de'iyaa</para>
  <para style="q2" vid="PSA 68:29">ne Geeshsha Golliyaa kaatetuu yiide,</para>
  <para style="q2" vid="PSA 68:29">new imotaa immana.<verse eid="PSA 68:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30" />Do'aadan mak'k'aa giddon de'iyaa Gibs'e asatuwaa neeni seera.</para>
  <para style="q2" vid="PSA 68:30">Booratuwaanne maratuwaa wudiyaa,</para>
  <para style="q2" vid="PSA 68:30">malatiyaa kawutetsatuwaa neeni yederssa.</para>
  <para style="q2" vid="PSA 68:30">Unttunttu gulbbatiide, barenttu biraa new immana gakkanaw,</para>
  <para style="q2" vid="PSA 68:30">neeni unttuntta seera.</para>
  <para style="q2" vid="PSA 68:30">Olettanaw yeemottiyaa asatuwaa laala.<verse eid="PSA 68:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31" />Kiitetteedda kaappatuu Gibs'eppe yaana;</para>
  <para style="q2" vid="PSA 68:31">Top'p'ata bare kushiyaa elle S'oossaakko mic'c'ana.<verse eid="PSA 68:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32" />Hinttenoo, sa'aa kawutetsatoo,</para>
  <para style="q2" vid="PSA 68:32">S'oossaw yes's'ite;<verse eid="PSA 68:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33" />salotuwaan, benippe de'iyaa salotuwaan biyaa Godaa sabbite.</para>
  <para style="q2" vid="PSA 68:33">Sisite! I bare kooshshaa,</para>
  <para style="q2" vid="PSA 68:33">bare wolk'k'aama guntsaa kiittee.<verse eid="PSA 68:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34" />S'oossaa wolk'k'aabaa awaayite;</para>
  <para style="q2" vid="PSA 68:34">Aa anggay Israa'eeliyaa bollaanna;</para>
  <para style="q1" vid="PSA 68:34">Aa wolk'k'aykka saluwaana.<verse eid="PSA 68:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35" />S'oossay bare Geeshsha Golliyaappe k'onc'c'oode, Maalalisee.</para>
  <para style="q2" vid="PSA 68:35">Israa'eeliyaa S'oossay bare asaw minotetsaanne wolk'k'aa immee.</para>
  <para style="q1" vid="PSA 68:35">Med'inaa Goday galatetto.<verse eid="PSA 68:35" /></para>
  <chapter eid="PSA 68" />
  <chapter number="69" style="c" sid="PSA 69" />
  <para style="s">Maaduwaa Demanaw Shiik'o Woosaa</para>
  <para style="d">Zammaaretuwaa Kaappoo, C'iishshaa Waatsaa Giyaa Waas's'uwaan Yes'eteedda Daawita Mazimuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 69:1" />Abeet S'oossaw, taana ashsha;</para>
  <para style="q2" vid="PSA 69:1">ayaw gooppe, haatsay taw k'ood'iyaa gakkeedda.<verse eid="PSA 69:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2" />Gedii ek'k'iyaa sa'ay bayinna c'ariyaan muukettaad;</para>
  <para style="q2" vid="PSA 69:2">c'iimmo haatsaa giddo gelaad;</para>
  <para style="q2" vid="PSA 69:2">haatsaa zuluu ta bolla baana hanee.<verse eid="PSA 69:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3" />Maadoo waassaade daaburay;</para>
  <para style="q2" vid="PSA 69:3">ta kottoniikka meleedda.</para>
  <para style="q1" vid="PSA 69:3">Ta S'oossay allee gaade s'eellishin,</para>
  <para style="q2" vid="PSA 69:3">ta ayifii galjjeedda.<verse eid="PSA 69:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4" />Taana c'oo is's'iyaawanttu,</para>
  <para style="q2" vid="PSA 69:4">ta huup'iyaa binnaanaappe dara.<note caller="-" style="x"><char style="xo" closed="false">69:4 </char><char style="xt" closed="false"><ref loc="PSA 35:19">Maz. 35:19</ref>; <ref loc="JHN 15:25">Yoh. 15:25</ref></char></note></para>
  <para style="q1" vid="PSA 69:4">Wordduwaan taana morkkiyaawanttunne,</para>
  <para style="q2" vid="PSA 69:4">d'ayissanaw koyiyaawanttu dareeddino.</para>
  <para style="q1" vid="PSA 69:4">Taani wolk'k'antsa akkabeena miishshaa taana c'iggisiino.<verse eid="PSA 69:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5" />Abeet S'oossaw, ta bayzzuwaa eeyyatetsaa neeni eraasa;</para>
  <para style="q2" vid="PSA 69:5">taani ootseedda nagaray neeppe k'osettenna.<verse eid="PSA 69:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6" />Abeet Godaw, Ubbaappe Wolk'k'aama Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 69:6">neena hidootan naagiyaawanttu,</para>
  <para style="q2" vid="PSA 69:6">ta gaasuwaan yeellatoppino.</para>
  <para style="q2" vid="PSA 69:6">Abeet Israa'eeliyaa S'oossaw, neekko shiik'iyaawanttu</para>
  <para style="q2" vid="PSA 69:6">ta gaasuwaan kawushoppino.<verse eid="PSA 69:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7" />Taani boriyaa danddayeeddawenne</para>
  <para style="q2" vid="PSA 69:7">ta som"ii yeellaa mayyeeddawe ne diraassa.<verse eid="PSA 69:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8" />Taani ta ishatoo imatsaa,</para>
  <para style="q2" vid="PSA 69:8">k'ay ta aatti naanaatoo allaga gidaaddi.<verse eid="PSA 69:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9" />Taani ne golliyaw seelettiyaa seelay,</para>
  <para style="q2" vid="PSA 69:9">taana tamaadan guuddee;<note caller="-" style="x"><char style="xo" closed="false">69:9 </char><char style="xt" closed="false"><ref loc="JHN 2:17">Yoh. 2:17</ref>; <ref loc="ROM 15:3">Rom. 15:3</ref></char></note></para>
  <para style="q2" vid="PSA 69:9">neena boriyaawanttu borii ta bolla wod'd'eedda.<verse eid="PSA 69:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10" />Taani s'oomaade, ta huup'iyaa kawushsheeddawe,</para>
  <para style="q2" vid="PSA 69:10">taw k'iliic'uwaa gideedda.<verse eid="PSA 69:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11" />Taani kayyuwaa mayuwaa mayyeedda wode,</para>
  <para style="q2" vid="PSA 69:11">unttunttoo tossaw gidaaddi.<verse eid="PSA 69:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12" />Katamaa Penggiyaan uttiyaawanttu taana k'iliic'iino;</para>
  <para style="q2" vid="PSA 69:12">matsottiyaawanttu tabaa yetsaa kessiino.<verse eid="PSA 69:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13" />Shin abeet Med'inaa Godaw, taana gidooppe,</para>
  <para style="q2" vid="PSA 69:13">taani neena woossay.</para>
  <para style="q1" vid="PSA 69:13">Abeet S'oossaw, ne dosiyaa wodiyaan,</para>
  <para style="q2" vid="PSA 69:13">aggena ne siik'uwaa daruwaan,</para>
  <para style="q2" vid="PSA 69:13">neeni ashana geeddawaadan taw zaaruwaa imma.<verse eid="PSA 69:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14" />C'ariyaan muukettenaadan taana ashsha.</para>
  <para style="q2" vid="PSA 69:14">Taana is's'iyaawanttuppe,</para>
  <para style="q2" vid="PSA 69:14">c'iimmo haatsatuwaappe neeni kessa akka.<verse eid="PSA 69:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15" />Haatsaa di"uwaan taana afissoppa;</para>
  <para style="q2" vid="PSA 69:15">woy c'iimmo olaan taana mitissoppa;</para>
  <para style="q2" vid="PSA 69:15">woy duufuwaa doonaa ta bolla gorddisoppa.<verse eid="PSA 69:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16" />Abeet Med'inaa Godaw, aggena ne siik'uwaa keekkatetsaadan,</para>
  <para style="q2" vid="PSA 69:16">taw zaaruwaa imma.</para>
  <para style="q1" vid="PSA 69:16">Ne k'aretaa daruwaadan taakko simma.<verse eid="PSA 69:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17" />Taappe ne k'oomaappe ne som"uwaa gentsoppa;</para>
  <para style="q2" vid="PSA 69:17">taani waayettiyaa diraw, taw elle zaaruwaa imma.<verse eid="PSA 69:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18" />Neeni taakko shiik'a; taana woza;</para>
  <para style="q2" vid="PSA 69:18">ta morkkatuwaappe taana la"a kesa.<verse eid="PSA 69:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19" />Taani boriyaa, yeellaanne,</para>
  <para style="q2" vid="PSA 69:19">kawushshaa akkeeddawaa neeni eraasa.</para>
  <para style="q1" vid="PSA 69:19">Ayaw gooppe, ta morkkatuwaa ubbaa neeni be'aasa.<verse eid="PSA 69:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20" />Borii ta wozanaa pas'ennaadan mentso diraw;</para>
  <para style="q2" vid="PSA 69:20">hidoota k'ans's'aad.</para>
  <para style="q1" vid="PSA 69:20">Taw k'arettiyaawaa koyaad.</para>
  <para style="q2" vid="PSA 69:20">Shin ittuunne baawa;</para>
  <para style="q2" vid="PSA 69:20">taana mintsetsiyaa asaa s'eellaad; shin demmabeykke.<verse eid="PSA 69:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21" />Taani koshateedda wode,</para>
  <para style="q2" vid="PSA 69:21">taw c'ammiyaa k'umaa aatseeddino.<note caller="-" style="x"><char style="xo" closed="false">69:21 </char><char style="xt" closed="false"><ref loc="MAT 27:48">Mat. 27:48</ref>; <ref loc="MRK 15:36">Mar. 15:36</ref>; <ref loc="LUK 23:36">Luk'. 23:36</ref>; <ref loc="JHN 19:28-29">Yoh. 19:28-29</ref></char></note></para>
  <para style="q1" vid="PSA 69:21">Taani saametteedda wode,</para>
  <para style="q2" vid="PSA 69:21">taw c'aala woyniyaa eessaa immeeddino.<verse eid="PSA 69:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22" />Unttunttu miyaa samppay unttunttoo p'ire gido.<note caller="-" style="x"><char style="xo" closed="false">69:22-23 </char><char style="xt" closed="false"><ref loc="ROM 11:9-10">Rom. 11:9-10</ref></char></note></para>
  <para style="q2" vid="PSA 69:22">Unttunttu yarshshuwaa yarshshiidde,</para>
  <para style="q2" vid="PSA 69:22">miyaa gibiray unttunttoo gitiyaa gido.<verse eid="PSA 69:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23" />S'eellennaadan unttunttu ayifii goozetto;</para>
  <para style="q2" vid="PSA 69:23">unttunttu gaaduwaa ubbaa gede kokkorssa.<verse eid="PSA 69:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24" />Ne hank'k'uwaa unttunttu bolla tiga;</para>
  <para style="q2" vid="PSA 69:24">ne suulo hank'k'uu unttuntta yederssiide oyk'k'o.<verse eid="PSA 69:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25" />Unttunttu kambbuu mela de'o;<note caller="-" style="x"><char style="xo" closed="false">69:25 </char><char style="xt" closed="false"><ref loc="ACT 1:20">Kit. 1:20</ref></char></note></para>
  <para style="q2" vid="PSA 69:25">unttunttu dunkkaaniyaan ooninne de'oppo.<verse eid="PSA 69:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26" />Ayaw gooppe, unttunttu,</para>
  <para style="q2" vid="PSA 69:26">neeni mureeddawantta yederssiino;</para>
  <para style="q2" vid="PSA 69:26">k'ay neeni dechcheeddawanttu tuggaabaa</para>
  <para style="q2" vid="PSA 69:26">dentsiide haasayiino.<verse eid="PSA 69:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27" />Neeni unttunttu nagaraa bolla</para>
  <para style="q2" vid="PSA 69:27">nagaraa gujjanaadan agga;</para>
  <para style="q2" vid="PSA 69:27">ne maarotetsaappe unttuntta ayaynne gakkoppo.<verse eid="PSA 69:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28" />Unttunttu de'uwaa mas'aafaappe k'uc'ettino;<note caller="-" style="x"><char style="xo" closed="false">69:28 </char><char style="xt" closed="false"><ref loc="EXO 32:32">Kes. 32:32</ref>; <ref loc="REV 3:5">Sas'. 3:5</ref>; <ref loc="REV 13:8">13:8</ref>; <ref loc="REV 17:8">17:8</ref></char></note></para>
  <para style="q2" vid="PSA 69:28">s'illo asaana mazggabettoppino.<verse eid="PSA 69:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29" />Taani sakettaadenne tuggataade de'ay.</para>
  <para style="q2" vid="PSA 69:29">Abeet S'oossaw, taana ashshaade,</para>
  <para style="q2" vid="PSA 69:29">saro sa'aan wotsa.<verse eid="PSA 69:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30" />Taani S'oossaa suntsaa yetsan galatana;</para>
  <para style="q2" vid="PSA 69:30">galataa imuwaan Aa darssana.<verse eid="PSA 69:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31" />Hewekka, booraa yarshshiyaawaappe</para>
  <para style="q2" vid="PSA 69:31">woy kac'aama korumaa yarshshiyaawaappe</para>
  <para style="q2" vid="PSA 69:31">aad'd'iide, Med'inaa Godaa nashshechchana.<verse eid="PSA 69:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32" />Naak'etteeddawanttu taana S'oossay,</para>
  <para style="q2" vid="PSA 69:32">ashsheedawaa be'iide nashetino.</para>
  <para style="q1" vid="PSA 69:32">Hinttenoo S'oossaakko shiik'iyaawanttoo,</para>
  <para style="q2" vid="PSA 69:32">hintte wozanay minetto.<verse eid="PSA 69:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33" />Ayaw gooppe, Med'inaa Goday hiyyeesatuwaa sisee;</para>
  <para style="q2" vid="PSA 69:33">k'asho golliyaan de'iyaa bare asaakka kad'enna.<verse eid="PSA 69:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34" />Saluunne sa'ay, k'ay abbayinne</para>
  <para style="q2" vid="PSA 69:34">Aa giddon wos's'i k'aas's'iyaa ubbatuu S'oossaa galatino.<verse eid="PSA 69:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35" />Ayaw gooppe, S'oossay S'iyoone ashshana;</para>
  <para style="q2" vid="PSA 69:35">Yihudaa katamatuwaa zaariide kees's'ana.</para>
  <para style="q1" vid="PSA 69:35">Aa Asay yaan de'ananne he biittay unttunttussa gidanawaa.<verse eid="PSA 69:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 69:36" />Aa k'oomatuwaa naanatuu he biittaa laattana;</para>
  <para style="q2" vid="PSA 69:36">Aa suntsaa siik'iyaawanttu yaan de'ana.<verse eid="PSA 69:36" /></para>
  <chapter eid="PSA 69" />
  <chapter number="70" style="c" sid="PSA 70" />
  <para style="s">Un"aa Waasuwaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Daawita hassayissiyaawaa mazamuriyaa.</para>
  <para style="r">(<ref loc="PSA 40:13-17">40:13-17</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1" />Abeet S'oossaw, taana ashshanaw eeno ga;</para>
  <para style="q2" vid="PSA 70:1">abeet Med'inaa Godaw, taana maaddanaw elleella.<verse eid="PSA 70:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2" />Taana wod'anaw koyiyaawanttu</para>
  <para style="q2" vid="PSA 70:2">yeellatinonne kawushino.</para>
  <para style="q1" vid="PSA 70:2">Taani k'ohettannawaa amottiyaawanttu,</para>
  <para style="q2" vid="PSA 70:2">kawushiide guyye simmino.<verse eid="PSA 70:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3" />Ta bolla, «Aw hashshu! Hashshu!»</para>
  <para style="q2" vid="PSA 70:3">geeddawanttu s'oonetteedda diraw yeellatino.<verse eid="PSA 70:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4" />Shin neena koyiyaa ubbatuu,</para>
  <para style="q2" vid="PSA 70:4">neenan nashetinonne hashshu giino.</para>
  <para style="q1" vid="PSA 70:4">K'ay ne atotetsaa dosiyaawanttu ubbatuu,</para>
  <para style="q2" vid="PSA 70:4">«S'oossay gitato!» yaagino.<verse eid="PSA 70:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5" />Taani hiyyeessanne metootanchchaa;</para>
  <para style="q2" vid="PSA 70:5">abeet S'oossaw, elle taakko haaya.</para>
  <para style="q1" vid="PSA 70:5">Taana maaddiyaawenne ashshiyaawe neena;</para>
  <para style="q2" vid="PSA 70:5">abeet Med'inaa Godaw, gam"oppa.<verse eid="PSA 70:5" /></para>
  <chapter eid="PSA 70" />
  <chapter number="71" style="c" sid="PSA 71" />
  <para style="s">S'oossaa Maaduwaa Demanaw Shiik'o Woosaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1" />Abeet Med'inaa Godaw, taani neekko bak'atay;</para>
  <para style="q2" vid="PSA 71:1">awudenne taana yeellayoppa.<verse eid="PSA 71:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2" />Ne s'illotetsaan taana wotsa akka;</para>
  <para style="q2" vid="PSA 71:2">ne haytsaa taakko yeggaade, taana ashsha.<verse eid="PSA 71:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3" />Neeni taw ubbaa wode geemmiyaa mino zaallaanne,</para>
  <para style="q2" vid="PSA 71:3">taana ashshiyaa mino geessuwaa gida.</para>
  <para style="q1" vid="PSA 71:3">Ta attana mala ne azaza.</para>
  <para style="q2" vid="PSA 71:3">Ee, neeni ta zaallaanne ta geessuwaa.<verse eid="PSA 71:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4" />Abeet ta S'oossaw, iitatuwaa kushiyaappe,</para>
  <para style="q2" vid="PSA 71:4">Iitaa ootsiyaawanttuppenne</para>
  <para style="q2" vid="PSA 71:4">k'areti bayinna asatuwaa wolk'k'aappe taana ashsha.<verse eid="PSA 71:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5" />Ayaw gooppe, abeet Ubbaa Mooddiyaa Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 71:5">neeni taani hidootan naagiyaawaanne</para>
  <para style="q2" vid="PSA 71:5">ta yalagatetsaa wodiyaappe doommaade,</para>
  <para style="q2" vid="PSA 71:5">taani ammanettiyaawaa gidaadda.<verse eid="PSA 71:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6" />Taani yelettiyaa wodiyaappe doommaade neenan zemppaad;</para>
  <para style="q2" vid="PSA 71:6">ta aatti uluwaappe wod'd'oodeppe doommaade,</para>
  <para style="q2" vid="PSA 71:6">neeni taana naagaadda.</para>
  <para style="q2" vid="PSA 71:6">Ubbaa gedekka ta galatay neessa.<verse eid="PSA 71:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7" />Neeni taw bak'ata attiyaa wolk'k'aama sa'aa gideedda diraw,</para>
  <para style="q2" vid="PSA 71:7">ta de'uu daro asaw leemiso gideedda.<verse eid="PSA 71:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8" />Gallassaa ubbaan ta doonay,</para>
  <para style="q2" vid="PSA 71:8">ne galataaninne ne bonchchuwaan kumeedda.<verse eid="PSA 71:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9" />Taani c'imeedda wodiyaan taana oloppa;</para>
  <para style="q2" vid="PSA 71:9">ta wolk'k'ay is's'eedda wodiyaan taana aggoppa.<verse eid="PSA 71:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10" />Ayaw gooppe, ta morkketuu ta bolla haasayiino,</para>
  <para style="q2" vid="PSA 71:10">Taana wod'anaw koyiyaawanttu</para>
  <para style="q2" vid="PSA 71:10">ittippe shiik'iide mak'ettiino.<verse eid="PSA 71:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11" />Unttunttu, «S'oossay Aa aggeedda;</para>
  <para style="q2" vid="PSA 71:11">yederssiide Aa oyk'k'eetto.</para>
  <para style="q1" vid="PSA 71:11">Ayaw gooppe, Aa ashshanawe ooninne baawa» yaagiino.<verse eid="PSA 71:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12" />Abeet S'oossaw, taappe neeni haakkoppa.</para>
  <para style="q1" vid="PSA 71:12">Abeet ta S'oossaw, taana maaddanaw elleella.<verse eid="PSA 71:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13" />Taana mootiyaawanttu yeellatiide d'ayino.</para>
  <para style="q2" vid="PSA 71:13">Taana k'ohanaw koyiyaawanttu,</para>
  <para style="q2" vid="PSA 71:13">yeellaanne kawushshaa mayino.<verse eid="PSA 71:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14" />Shin taana gidooppe,</para>
  <para style="q2" vid="PSA 71:14">ubbaa gede neena hidootan naagana.</para>
  <para style="q1" vid="PSA 71:14">Taani gujja gujjaade neena galatana.<verse eid="PSA 71:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15" />Woyissentto likkiyaa erana d'ayooppekka,</para>
  <para style="q2" vid="PSA 71:15">ta doonay gallassaa ubbaan ne s'illotetsaabaanne</para>
  <para style="q2" vid="PSA 71:15">ashshiyaa ne oosuwaabaa odana.<verse eid="PSA 71:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16" />Taani Ubbaa Mooddiyaa Med'inaa Godaa wolk'k'an yaana;</para>
  <para style="q2" vid="PSA 71:16">ne s'alalay s'illo gidiyaawaa awaayana.<verse eid="PSA 71:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17" />Abeet S'oossaw, neeni,</para>
  <para style="q2" vid="PSA 71:17">ta yalagatetsaappe doommaade taana tamaarissaadda.</para>
  <para style="q1" vid="PSA 71:17">Ha"i gakkanaw taani ne malalissiyaa oosuwaabaa oday.<verse eid="PSA 71:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18" />Abeet S'oossaw, ne wolk'k'aanne ne minotetsaa,</para>
  <para style="q2" vid="PSA 71:18">yiyaa yeletaa ubbaw odana gakkanaw,</para>
  <para style="q2" vid="PSA 71:18">taani c'imaade puulummooppekka taana aggoppa.<verse eid="PSA 71:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19" />Abeet S'oossaw, ne s'illotetsay,</para>
  <para style="q2" vid="PSA 71:19">bolla saluwaa gakkeedda.</para>
  <para style="q1" vid="PSA 71:19">Abeet wolk'k'aamabaa ootseedda S'oossaw,</para>
  <para style="q2" vid="PSA 71:19">ne mali ooninne baawa.<verse eid="PSA 71:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20" />Neeni ta bolla daro metuwaa ahaada;</para>
  <para style="q2" vid="PSA 71:20">gidooppenne, neeni ta de'uwaa zaaraadde ooras's'isana;</para>
  <para style="q2" vid="PSA 71:20">neeni taana biittaa gido c'iimmo olaa gelenaadan naagana.<verse eid="PSA 71:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21" />Neeni ta bonchchuwaa kasewaappe darissana;</para>
  <para style="q2" vid="PSA 71:21">neeni taana zaaretsaadekka mintsetsana.<verse eid="PSA 71:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22" />Abeet ta S'oossaw, ne tumatetsaa diraw,</para>
  <para style="q2" vid="PSA 71:22">taani neena diitsaan galatana.</para>
  <para style="q1" vid="PSA 71:22">Abeet Israa'eeliyaa geeshshaw,</para>
  <para style="q2" vid="PSA 71:22">taani maasink'k'uwaan neena sabbana.<verse eid="PSA 71:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23" />Taani diis's'aade, nashshechchaw ta k'aalaa d'ok'k'u ootsaade yes's'ana;</para>
  <para style="q2" vid="PSA 71:23">neeni taana ashsheeda diraw, taani neena sabbana.<verse eid="PSA 71:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24" />Ta ins's'arssay ne s'illo oosuwaabaa ubbaa gallassi odana;</para>
  <para style="q2" vid="PSA 71:24">ayaw gooppe, taana k'ohanaw koyiyaawanttu,</para>
  <para style="q2" vid="PSA 71:24">yeellateeddinonne kawusheeddino.<verse eid="PSA 71:24" /></para>
  <chapter eid="PSA 71" />
  <chapter number="72" style="c" sid="PSA 72" />
  <para style="s">Kaatiyaw Shiik'o Woosaa</para>
  <para style="d">Solomona Yetsaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1" />Abeet S'oossaw, kaatii ne suuretetsan pirddanaadan,</para>
  <para style="q2" vid="PSA 72:1">neeni Aa tamaarissa;</para>
  <para style="q2" vid="PSA 72:1">nu kaatiyaw ne s'illotetsaa imma.<verse eid="PSA 72:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2" />Yaatooppe, I ne asaw s'illotetsan pirddo;</para>
  <para style="q2" vid="PSA 72:2">naak'etteeddawanttookka suuretetsaan daannato.<verse eid="PSA 72:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3" />Deretuu sarotetsaa ayifiyaa,</para>
  <para style="q2" vid="PSA 72:3">zoozetuukka s'illotetsaa ayifiyaa ne asaw ayifino.<verse eid="PSA 72:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4" />He kaatii asaa giddon naak'etteeddawanttu diraw mootetto;</para>
  <para style="q2" vid="PSA 72:4">hiyyeesatuwaa I ashsho;</para>
  <para style="q2" vid="PSA 72:4">uk'k'unniyaawantta I mentsereetso.<verse eid="PSA 72:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5" />Awaynne aginay de'iyaa wode ubbaan,</para>
  <para style="q2" vid="PSA 72:5">yeletaappe yeletaa gakkanaw, Asay aw yayiino.<verse eid="PSA 72:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6" />Kaatii shoyk'an bukkiyaa iraanne</para>
  <para style="q2" vid="PSA 72:6">gadiyaa kalissiyaa iraa mala gido.<verse eid="PSA 72:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7" />I de'iyaa laytsaa ubbaan s'illuu daashana;</para>
  <para style="q2" vid="PSA 72:7">aginay d'ayana gakkanaw sarotetsay darana.<verse eid="PSA 72:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8" />Abbaappe abbaa gakkanaw,</para>
  <para style="q2" vid="PSA 72:8">k'ay Efiraas'iisa Shaafaappe sa'aa gas'aa gakkanaw I mooddo.<note caller="-" style="x"><char style="xo" closed="false">72:8 </char><char style="xt" closed="false"><ref loc="ZEC 9:10">Zak. 9:10</ref></char></note><verse eid="PSA 72:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9" />Bazzuwaa asatuu aw hokkino;</para>
  <para style="q2" vid="PSA 72:9">Aa morkketuu baana laac'c'ino.<verse eid="PSA 72:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10" />Tarsseesanne haatsaan dooddetteedda biittaa kaatetuu,</para>
  <para style="q2" vid="PSA 72:10">aw giiraa giirino.</para>
  <para style="q1" vid="PSA 72:10">Sheebanne Saaba kaatetuu,</para>
  <para style="q2" vid="PSA 72:10">aw imotaa ayino.<verse eid="PSA 72:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11" />Kaatetu ubbay aw gulbbatino;</para>
  <para style="q2" vid="PSA 72:11">kawutetsatuu ubbay aw kiitettino.<verse eid="PSA 72:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12" />Aa s'eesiyaa hiyyeesatuwaa, naak'etteeddawanttanne</para>
  <para style="q2" vid="PSA 72:12">maaddiyaawe bayinnawantta I ashshee.<verse eid="PSA 72:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13" />Hiyyeesatoonne mank'k'otoo I k'arettee;</para>
  <para style="q2" vid="PSA 72:13">hiyyeesatuwaa shemppuwaa ashshee.<verse eid="PSA 72:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14" />Unttuntta naak'uwaappenne makkalaappe I wozee.</para>
  <para style="q2" vid="PSA 72:14">Unttunttu suutsay Aa sintsan al"a.<verse eid="PSA 72:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15" />Kaatii shemppuwaa gam"o;</para>
  <para style="q2" vid="PSA 72:15">Sheeba biittaa work'k'ay aw imetto.</para>
  <para style="q1" vid="PSA 72:15">Pac'c'ennan aw woosay woosetto;</para>
  <para style="q2" vid="PSA 72:15">gallassaa ubbaan I anjjetto.<verse eid="PSA 72:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16" />Biittan daro katsay mokko;</para>
  <para style="q2" vid="PSA 72:16">deretuu katsaan kamettino.</para>
  <para style="q1" vid="PSA 72:16">Biittay Liibaanoose derii mokkiyaawaadan katsaa mokko;</para>
  <para style="q2" vid="PSA 72:16">maatay dembbaa kumiyaawaadan Asay katamaa kumo.<verse eid="PSA 72:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17" />Kaatiyaa suntsay med'inaw de'o;</para>
  <para style="q2" vid="PSA 72:17">away de'eedda keeshshaa ubbaan s'eegettiidde, gam"o.</para>
  <para style="q1" vid="PSA 72:17">Asay ubbay Aa baggana anjjettana;</para>
  <para style="q2" vid="PSA 72:17">kawutetsatuu ubbay Aa, «Anjjetta» yaagiide anjjana.<verse eid="PSA 72:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18" />Malalissiyaabaa barekka ootsiyaa Med'inaa Godaa S'oossaw,</para>
  <para style="q2" vid="PSA 72:18">Israa'eeliyaa S'oossaw galatay gido.<verse eid="PSA 72:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19" />Aa bonchcho suntsay med'inaw galatetto;</para>
  <para style="q2" vid="PSA 72:19">Aa bonchchuu sa'aa ubbaa kumo.</para>
  <para style="q1" vid="PSA 72:19">Amen"i. Amen"i.<verse eid="PSA 72:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20" />Issey na'aa Daawita woosay hawaan poletteedda.<verse eid="PSA 72:20" /></para>
  <chapter eid="PSA 72" />
  <chapter number="73" style="c" sid="PSA 73" />
  <para style="ms">Heezzentso Mas'aafaa</para>
  <para style="mr">(<ref loc="PSA 73-89">73—89</ref>)</para>
  <para style="s">S'illo Pirddaa S'oonuwaa</para>
  <para style="d">Asaafa Yetsaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1" />S'oossay Israa'eeliyaw tumuwaappe lo"a;</para>
  <para style="q2" vid="PSA 73:1">wozanaa geeshshatoo I keeka.<verse eid="PSA 73:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2" />Shin taana gidooppe, ta gedii,</para>
  <para style="q2" vid="PSA 73:2">d'ubettanaw guutsaa atteedda;</para>
  <para style="q2" vid="PSA 73:2">ta gedii halis's'anaw mateedda.<verse eid="PSA 73:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3" />Ayaw gooppe, iita asatoo sarotetsay de'iyaawaa be'aade,</para>
  <para style="q2" vid="PSA 73:3">he otoranchchatuwaa duretetsaan taani k'anaataad.<verse eid="PSA 73:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4" />Unttunttoo tuggi baawa.</para>
  <para style="q2" vid="PSA 73:4">Unttunttu bollay pas's'anne mina.<verse eid="PSA 73:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5" />Unttunttu hara Asay tuggatiyaawaadan tuggatikkino;</para>
  <para style="q2" vid="PSA 73:5">unttunttu hara asaawaadan metuwaan shoc'ettibeykkino.<verse eid="PSA 73:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6" />Hewaa diraw, unttunttu otoruwaa,</para>
  <para style="q2" vid="PSA 73:6">alleek'k'uwaadan k'ood'iyaan aatsiino;</para>
  <para style="q2" vid="PSA 73:6">makkalaa afilaadan mayiino.<verse eid="PSA 73:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7" />Unttunttu wozanay iitabaa pulttee.</para>
  <para style="q2" vid="PSA 73:7">Unttunttu k'ofay iita halchchuwaa kumeedda.<verse eid="PSA 73:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8" />Unttunttu k'iliic'iinonne iitabaa haasayiino;</para>
  <para style="q2" vid="PSA 73:8">unttunttu barenttu otoruwaan,</para>
  <para style="q2" vid="PSA 73:8">haratuwaa un"etsanaw naassiino.<verse eid="PSA 73:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9" />Unttunttu saluwaan de'iyaa S'oossaa,</para>
  <para style="q2" vid="PSA 73:9">barenttu doonaan c'ashiino.</para>
  <para style="q1" vid="PSA 73:9">Sa'aan de'iyaa asaa bollakka,</para>
  <para style="q2" vid="PSA 73:9">barenttu ins's'arssan otoruwaa haasayiino.<verse eid="PSA 73:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10" />Haray atto, S'oossaa asaykka unttunttukko simmana;</para>
  <para style="q2" vid="PSA 73:10">unttunttu odiyaawaakka elle ammanana.<verse eid="PSA 73:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11" />Unttunttu, «S'oossay nubaa ayinne erenna;</para>
  <para style="q1" vid="PSA 73:11">Ubbaappe D'ok'k'iyaa S'oossay ayinne be'enna» yaagiino.<verse eid="PSA 73:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12" />Simmi iitatuu hawaa mala;</para>
  <para style="q2" vid="PSA 73:12">Unttunttu ubbaa gedekka injjetina de'iino;</para>
  <para style="q2" vid="PSA 73:12">unttunttu gujji gujji duretiino.<verse eid="PSA 73:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13" />Yaatooppe, taani ta wozanaa geeshsha ootseeddawenne</para>
  <para style="q2" vid="PSA 73:13">taani ta s'illotetsaa bessanaw,</para>
  <para style="q2" vid="PSA 73:13">ta kushiyaa meec'etteeddawe tumuwaappe mela.<verse eid="PSA 73:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14" />Gallassaa kumentsan taani metuwaan shoc'ettaad;</para>
  <para style="q2" vid="PSA 73:14">wonttan wonttan murettaad.<verse eid="PSA 73:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15" />Taani iitatuwaadan, unttunttu giyaawaa geeddentto,</para>
  <para style="q2" vid="PSA 73:15">taani ne asaw ammanettennawaa gidana.<verse eid="PSA 73:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16" />Taani ha ubbaa yewuwaa eranaw k'oppiyaa wode,</para>
  <para style="q2" vid="PSA 73:16">taw erettenna dees'obaa gideedda.<verse eid="PSA 73:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17" />Shin taani S'oossaa geeshsha sa'aa geleedda wode,</para>
  <para style="q2" vid="PSA 73:17">iitatuwaa wurssetsa kaac'aa akeekaad.<verse eid="PSA 73:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18" />Unttuntta neeni tumuwaappe halis's'iyaa sa'aan utissaasa;</para>
  <para style="q2" vid="PSA 73:18">neeni unttuntta kunddissaasanne bayzzaasa.<verse eid="PSA 73:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19" />Unttunttu akeekenan d'ayeeddino;</para>
  <para style="q2" vid="PSA 73:19">dagamaan ittuu attenan mule wureeddino.<verse eid="PSA 73:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20" />Itti Asay beegottiyaa wode,</para>
  <para style="q2" vid="PSA 73:20">I akumuwaan be'eeddabay dogettiyaawaadan,</para>
  <para style="q2" vid="PSA 73:20">abeet Godaw, neeni denddiyaa wode,</para>
  <para style="q2" vid="PSA 73:20">unttunttu dogetana.<verse eid="PSA 73:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21" />Taani yiloteedda wodenne</para>
  <para style="q2" vid="PSA 73:21">ta wozanaan seeletteedda wode,<verse eid="PSA 73:21" /></para>
  <para style="q2">
    <verse number="22" style="v" sid="PSA 73:22" />ayinne akeekenan donc'c'illaad;</para>
  <para style="q2" vid="PSA 73:22">taani ne sintsan miizza mala gidaaddi.<verse eid="PSA 73:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23" />Shin taani ubbaa gedekka neenana de'ay;</para>
  <para style="q2" vid="PSA 73:23">ta ushechcha kushiyaa neeni oyk'k'aadda.<verse eid="PSA 73:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24" />Ne zoriyaan taana kaaletsaasa;</para>
  <para style="q2" vid="PSA 73:24">hewaappe guyyiyaan neeni taana bonchchoo afana.<verse eid="PSA 73:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25" />Taw saluwaan neeppe attina,</para>
  <para style="q2" vid="PSA 73:25">haray ooni de'ii?</para>
  <para style="q1" vid="PSA 73:25">Taani neeppe attina,</para>
  <para style="q2" vid="PSA 73:25">sa'aan harabaa ayaanne amottikke.<verse eid="PSA 73:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26" />Ta wolk'k'aynne ta wozanay daaburanaw danddayee;</para>
  <para style="q2" vid="PSA 73:26">shin S'oossay ta wozanaa minisiyaawaanne,</para>
  <para style="q2" vid="PSA 73:26">med'inaw taana gakkeedda saamaa.<verse eid="PSA 73:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27" />Neeppe haakkiyaawanttu d'ayana;</para>
  <para style="q2" vid="PSA 73:27">neena amanetenawantta ubbaa neeni wurssana.<verse eid="PSA 73:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28" />Shin taana gidooppe,</para>
  <para style="q2" vid="PSA 73:28">taani S'oossaa matan de'iyaawe taw lo"a.</para>
  <para style="q1" vid="PSA 73:28">Taani Ubbaa Mooddiyaa Med'inaa Godaa,</para>
  <para style="q2" vid="PSA 73:28">taw bak'ata attiyaa sa'aa ootsaad.</para>
  <para style="q1" vid="PSA 73:28">Hewaa diraw, Aa oosuwaa ubbaa taani odana.<verse eid="PSA 73:28" /></para>
  <chapter eid="PSA 73" />
  <chapter number="74" style="c" sid="PSA 74" />
  <para style="s">Gadii La"a Kesanaadan Shiik'o Woosaa</para>
  <para style="d">Aasaafi Akeekaan S'aafeedda Timirttiyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 74:1" />Abeet S'oossaw, neeni nuuna med'inaw ayaw aggaadii?</para>
  <para style="q2" vid="PSA 74:1">Ne hank'k'uu ne k'ooruwaan de'iyaa dorssatuwaa bolla,</para>
  <para style="q2" vid="PSA 74:1">ayaw suulleedee?<verse eid="PSA 74:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2" />Neeni beni dooreedda asaa, neeni</para>
  <para style="q2" vid="PSA 74:2">new buzo ootsaade wozeedda zaratuwaa hassaya.</para>
  <para style="q1" vid="PSA 74:2">Neeni de'eedda S'iyoone deriyaa k'oppa.<verse eid="PSA 74:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3" />Ane ne Geeshsha Gollii koleteedda sa'aa yaade s'eella.</para>
  <para style="q2" vid="PSA 74:3">Morkketuu aani de'iyaabaa ubbaa d'aysseeddino.<verse eid="PSA 74:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4" />Ne morkketuu ne Geeshsha Golliyaa giddon,</para>
  <para style="q2" vid="PSA 74:4">«Nuuni s'ooneeddo» yaagiide gereereeddino.</para>
  <para style="q1" vid="PSA 74:4">S'oonuwaa malaataa yaagiide, barenttu banddiraa esseeddino.<verse eid="PSA 74:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5" />Unttunttu mitsaa k'ans's'anaw barenttu kalttaa,</para>
  <para style="q2" vid="PSA 74:5">d'ok'k'u ootsiide, ek'k'eedda asatuwaadan haneeddino.<verse eid="PSA 74:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6" />Unttunttu masetteedda sank'k'aa ubbaa,</para>
  <para style="q2" vid="PSA 74:6">barenttu kalttaaninne madooshaaninne mentsi yeggeeddino.<verse eid="PSA 74:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7" />Geeshsha Golliyaa taman s'uuggiide d'ayisseeddino;</para>
  <para style="q2" vid="PSA 74:7">new goyinniyaa sa'aa tunisseeddino.<verse eid="PSA 74:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8" />Barenttu wozanaan, «Unttuntta nuuni,</para>
  <para style="q2" vid="PSA 74:8">ubbaanna d'ayssana» yaagiide k'oppeeddino.</para>
  <para style="q1" vid="PSA 74:8">Biittan Asay S'oossaw goyinniyaa sa'aa ubbaa taman s'uuggeeddino.<verse eid="PSA 74:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9" />He wode mallay nuw imettennan is's'eedda;</para>
  <para style="q2" vid="PSA 74:9">timbbitiyaa odiyaawe ittuunne baawa.</para>
  <para style="q1" vid="PSA 74:9">Hawaadan haniide, woyissa wodiyaa de'anentto,</para>
  <para style="q2" vid="PSA 74:9">eriyaa Asay nu giddon ittuunne baawa.<verse eid="PSA 74:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10" />Abeet S'oossaw, ne morkketuu,</para>
  <para style="q2" vid="PSA 74:10">woyissa wodiyaa ne bolla k'iliic'anee?</para>
  <para style="q1" vid="PSA 74:10">Unttunttu ne suntsaa med'inaw borannee?<verse eid="PSA 74:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11" />Ne kushiyaa shiishsha akkaade ayaw gam"ay?</para>
  <para style="q2" vid="PSA 74:11">Ne ushechcha kushiyaa ne k'umayuwaappe kessaade unttuntta d'ayssa.<verse eid="PSA 74:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12" />Gidooppenne, abeet S'oossaw,</para>
  <para style="q2" vid="PSA 74:12">neeni benippekka ta kaatiyaa;</para>
  <para style="q2" vid="PSA 74:12">neeni biittaa bolla atotetsaa ahaada.<verse eid="PSA 74:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13" />Ne wolk'k'aama wolk'k'aan neeni abbaa shaakkaadda;</para>
  <para style="q2" vid="PSA 74:13">Aa giddon de'iyaa dawiyaa huup'iyaa neeni k'os's'aadda.<verse eid="PSA 74:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14" />Leewaataana giyaa dawiyaa huup'iyaa k'os's'aade,</para>
  <para style="q2" vid="PSA 74:14">Aa ashuwaa bazzuwaan de'iyaa med'etatoo,</para>
  <para style="q2" vid="PSA 74:14">k'uma ootsaade immeeddawe neena.<note caller="-" style="x"><char style="xo" closed="false">74:14 </char><char style="xt" closed="false"><ref loc="JOB 41:1">Yob. 41:1</ref>; <ref loc="PSA 104:26">Maz. 104:26</ref>; <ref loc="ISA 27:1">Isa. 27:1</ref></char></note><verse eid="PSA 74:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15" />Neeni pulttotuwaa dooyaa yeddaadda;</para>
  <para style="q2" vid="PSA 74:15">ubbaa gede goggiyaa shaafatuwaa k'ay melissaadda.<verse eid="PSA 74:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16" />Gallassay newaa; k'ammaykka newaa;</para>
  <para style="q2" vid="PSA 74:16">k'ay awaanne aginaa unttunttu sa'aan wotseeddawe neena.<verse eid="PSA 74:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17" />Biittaw zawaa wotseeddawe,</para>
  <para style="q2" vid="PSA 74:17">balgguwaanne boniyaa med'eeddawe neena.<verse eid="PSA 74:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18" />Shin abeet Med'inaa Godaw, ne morkketuu,</para>
  <para style="q2" vid="PSA 74:18">neena wooti k'iliic'eeddinontto,</para>
  <para style="q2" vid="PSA 74:18">booza asatuu ne suntsaa wooti boreeddinontto hassaya.<verse eid="PSA 74:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19" />New moodettiyaawanttu shemppuwaa</para>
  <para style="q2" vid="PSA 74:19">iita morkketoo aatsaade immoppa.</para>
  <para style="q1" vid="PSA 74:19">Metootanchchatuwaa med'inaw dogoppa.<verse eid="PSA 74:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20" />Nu biittan de'iyaa d'uma sa'ay ubbay,</para>
  <para style="q2" vid="PSA 74:20">makkalanchchatuwaan kumeedda diraw,</para>
  <para style="q2" vid="PSA 74:20">neeni nuw c'aak'k'eedda c'aak'uwaa k'oppa.<verse eid="PSA 74:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21" />Naak'etteeddawantta yeellayoppa;</para>
  <para style="q2" vid="PSA 74:21">hiyyeesatuunne metootanchchatuu ne suntsaa galatino.<verse eid="PSA 74:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22" />Abeet S'oossaw, dendda; ne yewuwaa mootetta.</para>
  <para style="q2" vid="PSA 74:22">Gezo asatuu gallassaa ubbaan,</para>
  <para style="q2" vid="PSA 74:22">ne bolla k'iliic'eeddawaa hassaya.<verse eid="PSA 74:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23" />Ne morkketuu ne bolla waassiyaa waasuwaanne</para>
  <para style="q2" vid="PSA 74:23">neena is's'iyaawanttu,</para>
  <para style="q2" vid="PSA 74:23">pac'i bayinnan k'iliic'iyaa k'iliic'uwaa dogoppa.<verse eid="PSA 74:23" /></para>
  <chapter eid="PSA 74" />
  <chapter number="75" style="c" sid="PSA 75" />
  <para style="s">S'oossay Pirddiyaawaa Gidussaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Aasaafi. «D'ayssoppa» Geetettiyaa Diitsaa waatsan Yes's'eedda Yetsaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 75:1" />New galataa immeeto; abeet S'oossaw, neena galateetto;</para>
  <para style="q2" vid="PSA 75:1">«Ne suntsay woggaa» giide awaayeetonne,</para>
  <para style="q2" vid="PSA 75:1">malalissiyaa ne oosuwaa ubbaa odeetto.<verse eid="PSA 75:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2" />S'oossay, «Dooraade keereedda gallassi,</para>
  <para style="q2" vid="PSA 75:2">suure pirddaa pirddanawe taana.<verse eid="PSA 75:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3" />Sa'aynne an de'iyaawanttu ubbay k'aas's'inakka,</para>
  <para style="q2" vid="PSA 75:3">Aa tuusaa minisa essiyaawe taana.<verse eid="PSA 75:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4" />Taani otoranchchatuwaa, Otorettoppite yaagay;</para>
  <para style="q2" vid="PSA 75:4">iitatuwaakka, Hintte kac'iyaa dentsoppite.<verse eid="PSA 75:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5" />Hintte kac'iyaa d'ok'k'issi bessoppite;</para>
  <para style="q2" vid="PSA 75:5">zaatturiide haasayoppite yaagay» yaagee.<verse eid="PSA 75:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6" />Bonchchuu away doliyaasaappe</para>
  <para style="q2" vid="PSA 75:6">woy wulliyaasaappe</para>
  <para style="q2" vid="PSA 75:6">woy bazzuwaappe yeenna.<verse eid="PSA 75:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7" />Shin pirddiyaawe S'oossaa;</para>
  <para style="q2" vid="PSA 75:7">I ittuwaa bolla pirddee;</para>
  <para style="q2" vid="PSA 75:7">ittuwaa shatintsee.<verse eid="PSA 75:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8" />Med'inaa Godaa kushiyan itti wanc'c'ay de'ee;</para>
  <para style="q2" vid="PSA 75:8">he wanc'c'ay S'oossaa hank'k'uwaa woyniyaa eessan kumi utteedda.</para>
  <para style="q1" vid="PSA 75:8">I hewaappe ushshaa tigina,</para>
  <para style="q2" vid="PSA 75:8">sa'aan de'iyaa iita asatuu hewaa ushana;</para>
  <para style="q2" vid="PSA 75:8">unttunttu orc'c'uwaakka ashshenan c'inggisiide ushana.<verse eid="PSA 75:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9" />Shin taani Yaak'ooba S'oossaabaa odananne</para>
  <para style="q2" vid="PSA 75:9">med'inaw Aa sabbana.<verse eid="PSA 75:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10" />I iita asatuwaa kac'iyaa ubbaa mentsana,</para>
  <para style="q2" vid="PSA 75:10">shin s'illotuwaa kac'ii d'ok'k'u d'ok'k'u gaana.<verse eid="PSA 75:10" /></para>
  <chapter eid="PSA 75" />
  <chapter number="76" style="c" sid="PSA 76" />
  <para style="s">S'oossaa S'oonuwaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Diitsaa Waatsan Yes'etteedda, Asaafa mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 76:1" />S'oossay Yihudaan eretteeddawaa;</para>
  <para style="q2" vid="PSA 76:1">Aa suntsay Israa'eeliyaan wolk'k'aama.<verse eid="PSA 76:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2" />Aa dunkkaanii Saleemana;</para>
  <para style="q2" vid="PSA 76:2">I de'iyaasay S'iyoonena.<verse eid="PSA 76:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3" />I, hewan s'onggettiyaa,</para>
  <para style="q2" vid="PSA 76:3">morkkatuwaa wonddaafiyaa c'ubiyaa, gonddalliyaa, mashshaanne</para>
  <para style="q2" vid="PSA 76:3">hara olaa miishshatuwaa mentsereetseedda.<verse eid="PSA 76:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4" />Abeet S'oossaw, ne bonchchuu ay keeshshaa gitee!</para>
  <para style="q2" vid="PSA 76:4">Neeni ne morkkatuwaa s'oonaade,</para>
  <para style="q2" vid="PSA 76:4">deriyaappe simmiyaa wode,</para>
  <para style="q2" vid="PSA 76:4">ne anggay ayiba yashshiyaawe!<verse eid="PSA 76:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5" />Gooba tooranchchatuu,</para>
  <para style="q2" vid="PSA 76:5">barenttoo de'iyaawaa ubbaa bonk'k'etti kichcheeddino.</para>
  <para style="q1" vid="PSA 76:5">Ha"i simmi unttunttu,</para>
  <para style="q2" vid="PSA 76:5">wolk'k'aama gem"ishshuwaa gem"isheeddino;</para>
  <para style="q2" vid="PSA 76:5">unttunttuppe ittuunne bare kushiyaa dentsibeenna.<verse eid="PSA 76:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6" />Abeet Yaak'ooba S'oossaw, neeni seereedda wode,</para>
  <para style="q2" vid="PSA 76:6">paraa asatuunne paratuu kunddo saan atteeddino.<verse eid="PSA 76:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7" />Shin abeet S'oossaw, neeni yashshaasa!</para>
  <para style="q2" vid="PSA 76:7">Ne hank'k'uu suulleedda wode,</para>
  <para style="q2" vid="PSA 76:7">ne sintsan oonee ek'k'anawe?<verse eid="PSA 76:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8" />Neeni pirddaa saluwaappe sisseedda wode,</para>
  <para style="q2" vid="PSA 76:8">sa'aan de'iyaa Asay yayyiide, c'o"u geedda.<verse eid="PSA 76:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9" />Neeni sa'aan k'ohetteeddawantta ashshanaw,</para>
  <para style="q2" vid="PSA 76:9">pirddaw denddeedda wode, hewe haneedda.<verse eid="PSA 76:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10" />Asaa hank'k'uu dareedda keeshshaa neeni galatettaasa.</para>
  <para style="q2" vid="PSA 76:10">Olaappe atteedda asatuu ubbay,</para>
  <para style="q2" vid="PSA 76:10">ne baalaa gallassatuwaa bonchchana.<verse eid="PSA 76:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11" />Med'inaa Godaw, hintte S'oossaw,</para>
  <para style="q2" vid="PSA 76:11">shiik'ettite, hewaakka gatsite.</para>
  <para style="q1" vid="PSA 76:11">Hinttenoo shooro kawutetsatoo,</para>
  <para style="q2" vid="PSA 76:11">yayettanaw bessiyaawoo immotaa ahite.<verse eid="PSA 76:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12" />I kaappotuwaa otoruwaa kawushshee;</para>
  <para style="q2" vid="PSA 76:12">wolk'k'aama kaatetuwaakka I yashissee.<verse eid="PSA 76:12" /></para>
  <chapter eid="PSA 76" />
  <chapter number="77" style="c" sid="PSA 77" />
  <para style="s">Mintsetsuwaa Woosaa</para>
  <para style="d">Aasaafi Zammaaretuwaa Kaappoo Juddutoo Yes's'eedda, mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1" />Taani S'oossaw magannay;</para>
  <para style="q2" vid="PSA 77:1">taana siso gaade taani S'oossaa woossay.<verse eid="PSA 77:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2" />Taani ta metuwaa gallassi Godaa koyay.</para>
  <para style="q2" vid="PSA 77:2">K'amman taani shemppennan ta kushetuwaa aakko mic'c'ay;</para>
  <para style="q2" vid="PSA 77:2">gidooppenne, taani minettanaw danddaykke.<verse eid="PSA 77:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3" />Taani S'oossaabaa k'oppiyaa wode, oolay;</para>
  <para style="q2" vid="PSA 77:3">taani aabaa yuushsha k'oppiyaa wode,</para>
  <para style="q2" vid="PSA 77:3">ta shemppuu daaburee.<verse eid="PSA 77:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4" />Neeni k'amma ubbaa taana gem"ishshuwaa diggaade ahissaasa.</para>
  <para style="q2" vid="PSA 77:4">Taani loytsa hirggiyaa diraw,</para>
  <para style="q2" vid="PSA 77:4">haasayanaw danddaykke.<verse eid="PSA 77:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5" />Taani aad'd'eedda gallassatuwaa k'oppay;</para>
  <para style="q2" vid="PSA 77:5">kase laytsatuwaakka hassayay.<verse eid="PSA 77:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6" />Taani k'ofaa sheekkaade ak'ay;</para>
  <para style="q2" vid="PSA 77:6">ta wozanay yuushshi k'oppiyaa wode,</para>
  <para style="q1" vid="PSA 77:6">Taani ta huup'iyaa hawaadan yaagaade oochchay;<verse eid="PSA 77:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7" />«Goday nuuna med'inaw aggi bashanee?</para>
  <para style="q2" vid="PSA 77:7">Zaaretsiide I nuuna keekaa bessennee?<verse eid="PSA 77:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8" />Aa siik'uu atteedee?</para>
  <para style="q2" vid="PSA 77:8">I geeddawe hawaappe sintsanaw sa'aan ootsenee?<verse eid="PSA 77:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9" />S'oossay maariyaawaa dogeeddee?</para>
  <para style="q2" vid="PSA 77:9">Bare k'aretaakka hank'k'uwaan laammeedee?» yaagaade oochchay.<verse eid="PSA 77:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10" />K'aykka taani, «Taana k'oheeddawe,</para>
  <para style="q2" vid="PSA 77:10">Ubbaappe D'ok'k'iyaa S'oossaa ushechcha kushii,</para>
  <para style="q2" vid="PSA 77:10">kaseppe maaddiyaa maaduwaa aggeedawaa» yaagay.<verse eid="PSA 77:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11" />Med'inaa Godaw, ne oosotuwaa taani k'oppana.</para>
  <para style="q2" vid="PSA 77:11">Ee; neeni beni wode,</para>
  <para style="q2" vid="PSA 77:11">ootseedda malalissiyaabatuwaa ubbaa taani hassayana.<verse eid="PSA 77:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12" />Ne ootseeddawaa ubbaa,</para>
  <para style="q2" vid="PSA 77:12">taani zaara zaaraadde k'oppana;</para>
  <para style="q2" vid="PSA 77:12">ne wolk'k'aama oosotuwaa ubbaa taani yuushsha k'oppana.<verse eid="PSA 77:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13" />Abeet S'oossaw, ne ogii geeshsha;</para>
  <para style="q2" vid="PSA 77:13">ay s'oossinne nu S'oossaa mala wolk'k'aama gidenna.<verse eid="PSA 77:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14" />Neeni malalissiyaabaa ootsiyaa S'oossaa.</para>
  <para style="q2" vid="PSA 77:14">Asaa giddon ne wolk'k'aa k'onc'c'issiyaawaa.<verse eid="PSA 77:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15" />Ne asaa, Yaak'oobanne Yooseefo zeretsatuwaa,</para>
  <para style="q2" vid="PSA 77:15">ne k'esiyaan wozaadda.<verse eid="PSA 77:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16" />Abeet S'oossaw, haatsatuu neena be'eeddino;</para>
  <para style="q2" vid="PSA 77:16">haatsatuu neena be'iide yayyeeddino.</para>
  <para style="q1" vid="PSA 77:16">Abbaa c'iimmatuukka kokkoreeddino.<verse eid="PSA 77:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17" />Shaaretuu iraa duge zaariide tigeeddino;</para>
  <para style="q2" vid="PSA 77:17">guuguntsay saluwaan guummeedda.</para>
  <para style="q1" vid="PSA 77:17">Ne walk'k'antsay yaan haan walk'k'ammeedda.<verse eid="PSA 77:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18" />Ne guuguntsay guntsay gotiyaa giddon kooshummeedda;</para>
  <para style="q2" vid="PSA 77:18">ne walk'k'antsaa p'ooletsay sa'aa poo'isseedda.</para>
  <para style="q1" vid="PSA 77:18">Biittaykka gaji gajiide kokkoreedda.<verse eid="PSA 77:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19" />Neeni abbaa gidduwaana hamettaasa;</para>
  <para style="q2" vid="PSA 77:19">c'iimmo abbaa gidduwaana aad'aassa;</para>
  <para style="q2" vid="PSA 77:19">gidooppenne, ne gedii yed'd'eedda sa'ay beettena.<verse eid="PSA 77:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20" />Musenne Aaroona kushiyan</para>
  <para style="q2" vid="PSA 77:20">neeni ne asaa dorssaa wudiyaadan kaaletsaadda.<verse eid="PSA 77:20" /></para>
  <chapter eid="PSA 77" />
  <chapter number="78" style="c" sid="PSA 78" />
  <para style="s">S'oossaanne Aa Asaa</para>
  <para style="d">Aasaafi Akeekaan S'aafeedda Timirttiyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1" />Ta asaw, taani hinttena tamaarissiyaawaa sisite;</para>
  <para style="q2" vid="PSA 78:1">ta doonaappe kesiyaa k'aalaa hayzzite.<verse eid="PSA 78:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2" />Taani unttunttoo haasayiyaa wode,</para>
  <para style="q2" vid="PSA 78:2">leemisuwaan haasayay;<note caller="-" style="x"><char style="xo" closed="false">78:2 </char><char style="xt" closed="false"><ref loc="MAT 13:35">Mat. 13:35</ref></char></note></para>
  <para style="q2" vid="PSA 78:2">beniideppe geemmeedda yewotuwaa k'onc'c'issana.<verse eid="PSA 78:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3" />Nuuni siseeddanne ereedda yewotuwaa,</para>
  <para style="q2" vid="PSA 78:3">k'ay nu aawotuu nuw odeedda yewotuwaa haasayana.<verse eid="PSA 78:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4" />He yewotuwaa nuuni unttunttu naanatuwaappe k'osokko;</para>
  <para style="q2" vid="PSA 78:4">Med'inaa Godaw bessiyaa galataa,</para>
  <para style="q1" vid="PSA 78:4">Aa wolk'k'aanne malalissiyaa Aa oosuwaa,</para>
  <para style="q2" vid="PSA 78:4">yiyaa yeletawukka nuuni odana.<verse eid="PSA 78:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5" />I Yaak'ooba zaretoo azazuwaa,</para>
  <para style="q2" vid="PSA 78:5">Israa'eeliyaa asaw higgiyaa immeedda.</para>
  <para style="q1" vid="PSA 78:5">Kase nu aawotuu barenttu naanatuwaa,</para>
  <para style="q2" vid="PSA 78:5">he higgetuwaa tamaarissana mala azazeedda.<verse eid="PSA 78:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6" />Hewenne, kaalliyaa yeletay,</para>
  <para style="q2" vid="PSA 78:6">he biro yelettana naanatuu eranaadaananne</para>
  <para style="q2" vid="PSA 78:6">unttunttukka barenttu naanaatoo odanaadaana.<verse eid="PSA 78:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7" />Yaatina, he naanatuu S'oossan amanetanaadan;</para>
  <para style="q2" vid="PSA 78:7">I ootseeddabaakka dogennaaddaaninne</para>
  <para style="q1" vid="PSA 78:7">Aa azazuwaa naaganaadaana.<verse eid="PSA 78:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8" />Unttunttu kase barenttu aawotuwaadan wozana muumenne</para>
  <para style="q2" vid="PSA 78:8">makkalanchcha asaa gidennaaddaaninne</para>
  <para style="q1" vid="PSA 78:8">S'oossan ek'k'ennanne ammanettena yeletaa gidenaaddaana.<verse eid="PSA 78:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9" />Efireema asatuu, olaw,</para>
  <para style="q2" vid="PSA 78:9">wonddaafiyaanna pootsaa giigissiide,</para>
  <para style="q2" vid="PSA 78:9">olaa gallassi guyye simmeeddino.<verse eid="PSA 78:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10" />Unttunttu S'oossaa c'aak'uwaa naagibeykkino;</para>
  <para style="q2" vid="PSA 78:10">Aa higgiyaadan hamettennan is's'eeddino.<verse eid="PSA 78:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11" />Unttunttu I ootseedda wolk'k'aama oosuwaanne</para>
  <para style="q2" vid="PSA 78:11">unttuntta I besseedda malaataa dogeeddino.<verse eid="PSA 78:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12" />I unttunttu aawotuwaa sintsan Gibs'e biittan,</para>
  <para style="q2" vid="PSA 78:12">S'o'aane Dembban malaataa ootseedda.<note caller="-" style="x"><char style="xo" closed="false">78:12 </char><char style="xt" closed="false"><ref loc="EXO 7:8-12:32">Kes. 7:8—12:32</ref></char></note><verse eid="PSA 78:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13" />Abbaa shaakkiide, gidduwaana unttuntta pintseedda;<note caller="-" style="x"><char style="xo" closed="false">78:13 </char><char style="xt" closed="false"><ref loc="EXO 14:21-22">Kes. 14:21-22</ref></char></note></para>
  <para style="q2" vid="PSA 78:13">I haatsaa shaakkiide,</para>
  <para style="q2" vid="PSA 78:13">yaanne haanne shaakkiide godaadan esseedda.<verse eid="PSA 78:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14" />I unttuntta gallassi shaariyaan,<note caller="-" style="x"><char style="xo" closed="false">78:14 </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">Kes. 13:21-22</ref></char></note></para>
  <para style="q2" vid="PSA 78:14">k'amma tamaa poo'uwaan kaaletseedda.<verse eid="PSA 78:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15" />I bazzuwaan zaallaa p'alk'k'iide,<note caller="-" style="x"><char style="xo" closed="false">78:15-16 </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">Kes. 17:1-7</ref>; <ref loc="NUM 20:2-13">Pay. 20:2-13</ref></char></note></para>
  <para style="q2" vid="PSA 78:15">c'iimmuwaappe daro haatsaa unttuntta ushsheedda.<verse eid="PSA 78:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16" />Zaallaappe haatsaa pulttissiide,</para>
  <para style="q2" vid="PSA 78:16">shaafaadan duge gogisseedda.<verse eid="PSA 78:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17" />Shin unttunttu Aa bolla nagaraa oosuwaa gede gujjeeddino;</para>
  <para style="q2" vid="PSA 78:17">Ubbaappe D'ok'k'iyaa S'oossaa bolla,</para>
  <para style="q2" vid="PSA 78:17">bazzuwaan makkaleeddino.<verse eid="PSA 78:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18" />Barenttu amotteedda k'umaa oochchiyaawan</para>
  <para style="q2" vid="PSA 78:18">S'oossaa eriidde paac'c'eeddino.<note caller="-" style="x"><char style="xo" closed="false">78:18-31 </char><char style="xt" closed="false"><ref loc="EXO 16:2-15">Kes. 16:2-15</ref>; <ref loc="NUM 11:4-23">Pay. 11:4-23</ref>, <ref loc="NUM 11:31-35">31-35</ref></char></note><verse eid="PSA 78:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19" />Unttunttu S'oossaa bolla hawaadan yaagiide haasayeeddino;</para>
  <para style="q2" vid="PSA 78:19">«Bazzuwaan S'oossay nuw k'umaa aatsanaw danddayii?<verse eid="PSA 78:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20" />Zaallaa shoc'ina, pulttuu kesiide,</para>
  <para style="q2" vid="PSA 78:20">shaafay goggeedda;</para>
  <para style="q2" vid="PSA 78:20">shin ukitsaa I nuw immanaw danddayii?</para>
  <para style="q2" vid="PSA 78:20">Woy bare asaw ashuwaa immanaw danddayii?» yaageeddino.<verse eid="PSA 78:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21" />Med'inaa Goday hewaa siseedda wode,</para>
  <para style="q2" vid="PSA 78:21">unttunttu bolla daro hank'k'etteedda.</para>
  <para style="q1" vid="PSA 78:21">Yaak'ooba zaratuwaa bolla tamay ees's'eedda;</para>
  <para style="q2" vid="PSA 78:21">Israa'eeliyaa bolla Aa hank'k'uu dari dari beedda.<verse eid="PSA 78:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22" />Ayaw gooppe, unttunttu S'oossan ammanibeykkino;</para>
  <para style="q2" vid="PSA 78:22">woy I ashshiyaawaan ammanettibeykkino.<verse eid="PSA 78:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23" />Gidooppenne, I bolla saluwaa azaziide,</para>
  <para style="q2" vid="PSA 78:23">saluwaa penggiyaa dooyeedda.<verse eid="PSA 78:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24" />Unttunttu maanaw, unttunttoo mannaa bukisseedda;<note caller="-" style="x"><char style="xo" closed="false">78:24 </char><char style="xt" closed="false"><ref loc="JHN 6:31">Yoh. 6:31</ref></char></note></para>
  <para style="q2" vid="PSA 78:24">saluwaa k'umaa unttunttoo immeedda.<verse eid="PSA 78:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25" />Kiitanchchatuwaa ukitsaa Asay meedda;</para>
  <para style="q2" vid="PSA 78:25">S'oossay unttunttoo k'umaa darissiide immeedda.<verse eid="PSA 78:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26" />Away doliyaa bagga c'arkkuu c'arkkanaadan ootseedda;</para>
  <para style="q2" vid="PSA 78:26">bare wolk'k'an gedissa bagga c'arkkuwaa dentsetseedda.<verse eid="PSA 78:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27" />I asaw ashuwaa baanaa keeshshaa kiitteedda;</para>
  <para style="q2" vid="PSA 78:27">paalliyaa kafotuwaa abbaa doonaa shafiyaa keeshshaa bukisseedda.<verse eid="PSA 78:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28" />Unttunttu de'iyaa saan,</para>
  <para style="q2" vid="PSA 78:28">dunkkaaniyaa yuushshuwaan wod'd'eeddino.<verse eid="PSA 78:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29" />Unttunttu amotteeddawaa unttunttoo immeedda;</para>
  <para style="q2" vid="PSA 78:29">unttunttu miide, barenttu ganjjiyaa kuntseeddino.<verse eid="PSA 78:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30" />Shin unttunttu barenttu amotteedda ashuwaa kallennan de'ishiin,</para>
  <para style="q2" vid="PSA 78:30">ashuu unttunttoo biro doonaan de'ishiin,<verse eid="PSA 78:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31" />S'oossaa hank'k'uu unttunttu bolla wod'd'eedda;</para>
  <para style="q2" vid="PSA 78:31">unttunttu giddoppe mino asatuwaanne</para>
  <para style="q2" vid="PSA 78:31">Israa'eeliyaappe yalaga asatuwaa wod'eedda.<verse eid="PSA 78:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32" />Hawe ubbay haninakka,</para>
  <para style="q2" vid="PSA 78:32">unttunttu nagaraa ootsiyaawaa aggibeykkino.</para>
  <para style="q1" vid="PSA 78:32">Bare malaataa ubbaa ootsinakka, ammanibeykkino.<verse eid="PSA 78:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33" />Hewaa diraw, I unttunttu gallassatuwaa c'arkkuwaadan,</para>
  <para style="q2" vid="PSA 78:33">unttunttu laytsatuwaakka akeekenan d'ayisseedda.<verse eid="PSA 78:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34" />S'oossay unttunttuppe wod'iyaa wode,</para>
  <para style="q2" vid="PSA 78:34">atteedawanttu nagaraa paas'iide,</para>
  <para style="q2" vid="PSA 78:34">S'oossaa mintsi koyeeddino.<verse eid="PSA 78:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35" />Unttunttu S'oossay unttunttoo zaallaa gideeddawaanne</para>
  <para style="q2" vid="PSA 78:35">Ubbaappe D'ok'k'iyaa S'oossay,</para>
  <para style="q2" vid="PSA 78:35">unttuntta woziyaawaa gideeddawaa hassayeeddino.<verse eid="PSA 78:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36" />Shin unttunttu barenttu ins's'arssan aw worddotiide,</para>
  <para style="q2" vid="PSA 78:36">barenttu doonaan c'immeeddino.<verse eid="PSA 78:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37" />Unttunttu wozanay S'oossan ek'k'enna;</para>
  <para style="q2" vid="PSA 78:37">I unttunttunna c'aak'k'eteedda c'aak'uwaa ammanettikkino.<verse eid="PSA 78:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38" />Shin I unttuntta maariyaawe;</para>
  <para style="q2" vid="PSA 78:38">unttunttu iitatetsaa atto geedda.</para>
  <para style="q1" vid="PSA 78:38">Unttuntta d'ayissibeenna; daro gede bare hank'k'uwaa te"eedda;</para>
  <para style="q2" vid="PSA 78:38">bare hank'k'uwaa uullaa ubbaanna unttunttu bolla yeddibeenna.<verse eid="PSA 78:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39" />Ayaw gooppe, unttunttu ashuwaa s'alala gidiyaawaanne</para>
  <para style="q2" vid="PSA 78:39">yaa c'arkkeeddasaappe haa simmenna,</para>
  <para style="q2" vid="PSA 78:39">c'arkkuwaa mala gidiyaawaa hassayeedda.<verse eid="PSA 78:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40" />Unttunttu bazzuwaan Aa bolla aappu gede makkaleeddinoo!</para>
  <para style="q2" vid="PSA 78:40">Mela bazzuwaan aappu gede lanc'c'isseeddino!<verse eid="PSA 78:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41" />Unttunttu zaari zaariide, S'oossaa paac'c'eeddino;</para>
  <para style="q2" vid="PSA 78:41">Israa'eeliyaa Geeshshaa hank'k'etseeddino.<verse eid="PSA 78:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42" />Unttunttu Aa wolk'k'aabaa dogeeddino;</para>
  <para style="q2" vid="PSA 78:42">I unttunttu morkkatuwaappe wozeedda gallassaa,<verse eid="PSA 78:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43" />I Gibs'e biittan malaataa,</para>
  <para style="q2" vid="PSA 78:43">S'o'aane Dembban malalissiyaabaa,</para>
  <para style="q2" vid="PSA 78:43">ootseedda wodiyaa hassayibeykkino.<verse eid="PSA 78:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44" />Unttunttu shaafaa haatsatuwaa suutsaw laammeedda;<note caller="-" style="x"><char style="xo" closed="false">78:44 </char><char style="xt" closed="false"><ref loc="EXO 7:17-21">Kes. 7:17-21</ref></char></note></para>
  <para style="q2" vid="PSA 78:44">hewaa diraw, Gibs'e asatuu,</para>
  <para style="q2" vid="PSA 78:44">he shaafatuwaappe ushanaw danddayibeykkino.<verse eid="PSA 78:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45" />Unttuntta waayissiyaa uduns's'etuwaanne</para>
  <para style="q2" vid="PSA 78:45">unttunttu biittaa bayzziyaa shed'd'atuwaa kiitteedda.<note caller="-" style="x"><char style="xo" closed="false">78:45 </char><char style="xt" closed="false"><ref loc="EXO 8:1-6">Kes. 8:1-6</ref>, <ref loc="EXO 8:20-24">20-24</ref></char></note><verse eid="PSA 78:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46" />Unttunttoo doleedda katsaa gonddoo,<note caller="-" style="x"><char style="xo" closed="false">78:46 </char><char style="xt" closed="false"><ref loc="EXO 10:12-15">Kes. 10:12-15</ref></char></note></para>
  <para style="q2" vid="PSA 78:46">unttunttu ootsiide daabureeddawaa booliyaw immeedda.<verse eid="PSA 78:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47" />Unttunttu woyniyaa turaa shachchan,</para>
  <para style="q2" vid="PSA 78:47">unttunttu balasiyaa giyaa mitsaakka c'arkkuwaan d'ayisseedda.<note caller="-" style="x"><char style="xo" closed="false">78:47-48 </char><char style="xt" closed="false"><ref loc="EXO 9:22-25">Kes. 9:22-25</ref></char></note><verse eid="PSA 78:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48" />Unttunttu miizzatuwaa shachchan wod'eedda;</para>
  <para style="q2" vid="PSA 78:48">unttunttu dorssaa wudiyaa,</para>
  <para style="q2" vid="PSA 78:48">d'uuk'k'iyaa walk'k'antsan mereessi wursseedda.<verse eid="PSA 78:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49" />Unttunttu bolla bare suulliyaa hank'k'uwaa,</para>
  <para style="q2" vid="PSA 78:49">lanc'c'iyaanne is'uwaa,</para>
  <para style="q2" vid="PSA 78:49">bayzziyaa kiitanchchatuwaa c'uguwan yeddeedda.<verse eid="PSA 78:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50" />Bare hank'k'uwaa aatsi yeddeedda.</para>
  <para style="q2" vid="PSA 78:50">Unttuntta iita harggiyaw aatsiide immeeddappe attina,</para>
  <para style="q2" vid="PSA 78:50">hayk'k'uwaappe ashshibeenna.<verse eid="PSA 78:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51" />Gibs'en yeletteedda bayira naanatuwaa ubbaa wod'eedda.<note caller="-" style="x"><char style="xo" closed="false">78:51 </char><char style="xt" closed="false"><ref loc="EXO 12:29">Kes. 12:29</ref></char></note></para>
  <para style="q2" vid="PSA 78:51">Kaama dunkkaaniyaan de'iyaa koyro naanatuwaa ubbaa wursseedda.<verse eid="PSA 78:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52" />Shin I bare asaa dorssaadan kesseedda;<note caller="-" style="x"><char style="xo" closed="false">78:52 </char><char style="xt" closed="false"><ref loc="EXO 13:17-22">Kes. 13:17-22</ref></char></note></para>
  <para style="q2" vid="PSA 78:52">wudiyaadan bazzuwaan heemmeedda.<verse eid="PSA 78:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53" />I unttuntta saruwaan kaaletseedda;</para>
  <para style="q2" vid="PSA 78:53">hewaa diraw, unttunttu yayyibeykkino;</para>
  <para style="q2" vid="PSA 78:53">shin unttunttu morkkatuwaa abbay muukkeedda.<note caller="-" style="x"><char style="xo" closed="false">78:53 </char><char style="xt" closed="false"><ref loc="EXO 14:26-28">Kes. 14:26-28</ref></char></note><verse eid="PSA 78:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54" />Yaatiide I unttuntta bare geeshsha biittaa,</para>
  <para style="q2" vid="PSA 78:54">bare ushechcha kushiyan s'ooneedda deriyaa aheedda.<note caller="-" style="x"><char style="xo" closed="false">78:54 </char><char style="xt" closed="false"><ref loc="EXO 15:17">Kes. 15:17</ref>; <ref loc="JOS 3:14-17">Iya. 3:14-17</ref></char></note><verse eid="PSA 78:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55" />I unttunttu sintsaappe kawutetsatuwaa laaggiide,</para>
  <para style="q2" vid="PSA 78:55">unttunttu biittaa shaakkiide,<note caller="-" style="x"><char style="xo" closed="false">78:55 </char><char style="xt" closed="false"><ref loc="JOS 11:16-23">Iya. 11:16-23</ref></char></note></para>
  <para style="q1" vid="PSA 78:55">Israa'eeliyaa zaretoo gisheedda.</para>
  <para style="q2" vid="PSA 78:55">Bare asaa unttunttu golliyaan wotseedda.<verse eid="PSA 78:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56" />Gidooppenne, Ubbaappe D'ok'k'iyaa S'oossaa bolla makkaliide,</para>
  <para style="q2" vid="PSA 78:56">Aa paac'c'eeddino.<note caller="-" style="x"><char style="xo" closed="false">78:56 </char><char style="xt" closed="false"><ref loc="JDG 2:11-15">Dat. 2:11-15</ref></char></note></para>
  <para style="q1" vid="PSA 78:56">Aa azazuwaakka naagibeykkino.<verse eid="PSA 78:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57" />Unttunttu barenttu aawotuwaadan,</para>
  <para style="q2" vid="PSA 78:57">makkalanchchatuwaanne kaddanchchatuwaa gideeddino.</para>
  <para style="q1" vid="PSA 78:57">Geella tooraadan wora wod'd'eeddino.<verse eid="PSA 78:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58" />Unttunttu barenttu goyinniyaa d'ok'k'a sa'atuwaan Aa yiloyeeddino;</para>
  <para style="q2" vid="PSA 78:58">barenttu eek'atuwaan Aa k'anaatisseeddino.<verse eid="PSA 78:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59" />Yaatina, S'oossay hawaa sisiide hank'k'etteedda;</para>
  <para style="q2" vid="PSA 78:59">Israa'eeliyaa mulekka kad'eedda.<verse eid="PSA 78:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60" />Seelon I de'eedda sa'aa,</para>
  <para style="q2" vid="PSA 78:60">asaa giddon I de'eedda bare dunkkaaniyaa aggeeda.<note caller="-" style="x"><char style="xo" closed="false">78:60 </char><char style="xt" closed="false"><ref loc="JOS 18:1">Iya. 18:1</ref>; <ref loc="JER 7:12-14">Erm. 7:12-14</ref>; <ref loc="JER 26:6">26:6</ref></char></note><verse eid="PSA 78:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61" />S'oossaa wolk'k'awunne bonchchoo, malaataa gideedda,</para>
  <para style="q2" vid="PSA 78:61">Taabootaa morkkatuwaa kushiyan aatsiide omoodisseedda.<note caller="-" style="x"><char style="xo" closed="false">78:61 </char><char style="xt" closed="false"><ref loc="1SA 4:4-22">1 Sam. 4:4-22</ref></char></note><verse eid="PSA 78:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62" />I bare asaw hank'k'etteedda;</para>
  <para style="q2" vid="PSA 78:62">I unttuntta mashshaw aatsiide immeedda.<verse eid="PSA 78:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63" />Unttunttu wodallatuu ubbay olan hayk'k'eeddino;</para>
  <para style="q2" vid="PSA 78:63">yaatina, unttunttu wodorotuu asinaa gelennaan atteeddino.<verse eid="PSA 78:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64" />Unttunttu k'eesatuu mashshaan wureeddino.</para>
  <para style="q2" vid="PSA 78:64">Gidooppenne, unttunttu machchetuu,</para>
  <para style="q2" vid="PSA 78:64">barenttu asinatoo yeekkenaadan digetteeddino.<verse eid="PSA 78:64" /></para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65" />Hewaappe guyyiyaan, Goday gem"ishuwaappe</para>
  <para style="q2" vid="PSA 78:65">woy woyniyaa eessaa matsuwaappe beegottiyaa asaadan beegotteedda.<verse eid="PSA 78:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66" />I bare morkkatuwaa guyye zaariide shoc'eedda;</para>
  <para style="q2" vid="PSA 78:66">unttuntta med'inaw yeellayeedda.<verse eid="PSA 78:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67" />Yooseefo dunkkaaniyaa kad'eedda;</para>
  <para style="q2" vid="PSA 78:67">Efireema zariyaa dooribeenna.<verse eid="PSA 78:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68" />Shin I Yihudaa zariyaanne</para>
  <para style="q2" vid="PSA 78:68">siik'iyaa S'iyoone deriyaa dooreedda.<verse eid="PSA 78:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69" />Hewan I bare Geeshsha Golliyaa saluwaadan d'ok'k'an kees's'eedda;</para>
  <para style="q2" vid="PSA 78:69">sa'aadan med'inaw esseedda.<verse eid="PSA 78:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70" />Bare k'oomaa Daawita dooriide,</para>
  <para style="q2" vid="PSA 78:70">dorssaa wudiyaa heemmiyaa saappe akkeedda.<note caller="-" style="x"><char style="xo" closed="false">78:70-71 </char><char style="xt" closed="false"><ref loc="1SA 16:11-12">1 Sam. 16:11-12</ref>; <ref loc="2SA 7:8">2 Sam. 7:8</ref>; <ref loc="1CH 17:7">1 Od. 17:7</ref></char></note><verse eid="PSA 78:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71" />Dorssaa heemmishin, bare asaa Yaak'ooba,</para>
  <para style="q2" vid="PSA 78:71">bare buzuwaa Israa'eeliyaa hentsanaw akkiide aheedda.<verse eid="PSA 78:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72" />Yaatina, Daawite unttuntta suure wozanaappe heemmeedda;</para>
  <para style="q2" vid="PSA 78:72">k'ay bare hiillaa kushiyan kaaletseedda.<verse eid="PSA 78:72" /></para>
  <chapter eid="PSA 78" />
  <chapter number="79" style="c" sid="PSA 79" />
  <para style="s">Gadiyaa La"atetsaw Shiik'eedda Woosaa</para>
  <para style="d">Asaafa mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 79:1" />Abeet S'oossaw, Ayhuda gidena asatuu ne biittaa bolla laateeddino.</para>
  <para style="q2" vid="PSA 79:1">Ne Geeshsha Golliyaa tunisseeddino;<note caller="-" style="x"><char style="xo" closed="false">79:1 </char><char style="xt" closed="false"><ref loc="2KI 25:8-10">2 Kat. 25:8-10</ref>; <ref loc="2CH 36:17-19">2 Od. 36:17-19</ref>; <ref loc="JER 52:12-14">Erm. 52:12-14</ref></char></note></para>
  <para style="q2" vid="PSA 79:1">Yerusaalame kolereetseeddino.<verse eid="PSA 79:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2" />Unttunttu ne k'oomatuwaa anhaa,</para>
  <para style="q2" vid="PSA 79:2">saluwaa kafoo k'uma ootsiide, immeeddino.</para>
  <para style="q1" vid="PSA 79:2">K'ay ne geeshshatuwaa ashuwaa sa'aa do'atoo immeeddino.<verse eid="PSA 79:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3" />Unttunttu suutsaa Yerusaalame yuushshuwaan,</para>
  <para style="q2" vid="PSA 79:3">haatsaadan gusseeddino;</para>
  <para style="q2" vid="PSA 79:3">unttunttu anhaa moogiyaawe d'ayeedda.<verse eid="PSA 79:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4" />Nu shoorotoo nuuni shek'k'iyaawaa gideeddo;</para>
  <para style="q2" vid="PSA 79:4">nu heeraan de'iyaawanttu,</para>
  <para style="q2" vid="PSA 79:4">miic'c'iyaawaanne k'id'iyaawaa gideeddo.<verse eid="PSA 79:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5" />Abeet Med'inaa Godaw, hawe awude gakkanaw hananee?</para>
  <para style="q2" vid="PSA 79:5">Neeni med'inaw hank'k'ettay?</para>
  <para style="q1" vid="PSA 79:5">Ne k'anaatiyaa hank'k'uu tamaadan ees's'anee?<verse eid="PSA 79:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6" />Neena erenna asatuwaa bollanne</para>
  <para style="q2" vid="PSA 79:6">ne suntsaa s'eesenna kawutetsatuwaa bolla ne hank'k'uwaa gussa.<verse eid="PSA 79:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7" />Ayaw gooppe, unttunttu Yaak'ooba zeretsatuwaa wod'eeddinonne</para>
  <para style="q2" vid="PSA 79:7">unttunttu de'iyaasaa bayzzeeddino.<verse eid="PSA 79:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8" />Kase nu aawotuwaa iitatetsaa nu bolla paydoppa.</para>
  <para style="q2" vid="PSA 79:8">Ellekka ne maarotaa nuw kiitta;</para>
  <para style="q2" vid="PSA 79:8">ayaw gooppe, nuuni loytsi metooteeddo.<verse eid="PSA 79:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9" />Abeet nuuna ashshiyaa S'oossaw,</para>
  <para style="q2" vid="PSA 79:9">ne suntsaa bonchchuwaa diraw, nuuna maadda.</para>
  <para style="q1" vid="PSA 79:9">Ne suntsaa diraw, nuuna ashsha;</para>
  <para style="q2" vid="PSA 79:9">nu nagaraa atto yaaga.<verse eid="PSA 79:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10" />Asatuu ayaw, «Unttunttu S'oossay hak'an de'ii?» yaaganee?</para>
  <para style="q2" vid="PSA 79:10">Ne k'oomatuwaa suutsaa unttunttu gusseeddawaa haluwaa,</para>
  <para style="q2" vid="PSA 79:10">neeni kessiyaawaa nuuni s'eellishin,</para>
  <para style="q2" vid="PSA 79:10">unttunttu gidduwaan k'onc'c'issa.<verse eid="PSA 79:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11" />K'ashetteedda asatuwaa oolii ne sintsa gakko.</para>
  <para style="q2" vid="PSA 79:11">Hayk'oo pirddetteeddawantta ne wolk'k'aa gitatetsaadan ashsha.<verse eid="PSA 79:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12" />Abeet S'oossaw, nu shooro kawutetsatuu neena boreeddawaa,</para>
  <para style="q2" vid="PSA 79:12">haluwaa laappun kushiyaa unttunttu kiwuwaan idintsa.<verse eid="PSA 79:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13" />He wode nuuni ne asatuu, ne wudiyaa dorssatuu,</para>
  <para style="q2" vid="PSA 79:13">med'inaw galataa new immana;</para>
  <para style="q2" vid="PSA 79:13">yeletaappe yeletaa gakkanaw neena zaari zaariide galatana.<verse eid="PSA 79:13" /></para>
  <chapter eid="PSA 79" />
  <chapter number="80" style="c" sid="PSA 80" />
  <para style="s">Israa'eeliyaa Kawutetsay Zaari <optbreak />Ek'k'anaadan Shiik'o Woosaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Aasaafi Yes's'eedda, C'iishshaa Giyaa waatsan Yes'eteedda mazamuriyaa, markkatetsaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 80:1" />Abeet Israa'eeliyaa hentsanchchaw,</para>
  <para style="q2" vid="PSA 80:1">Yooseefo asaa wudiyaadan kaaletsiyaawoo,<note caller="-" style="x"><char style="xo" closed="false">80:1 </char><char style="xt" closed="false"><ref loc="EXO 25:22">Kes. 25:22</ref></char></note></para>
  <para style="q2" vid="PSA 80:1">Kiruubetuwaa giyaa kiitanchchatuwaappe,</para>
  <para style="q2" vid="PSA 80:1">bollaanna de'iyaa araatan utteeddawoo, poo'a, neeni nuuna sisa.<verse eid="PSA 80:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 80:2" />Efireema, Biiniyaamanne Minaase sintsan k'onc'c'a.</para>
  <para style="q2" vid="PSA 80:2">Ne wolk'k'aa dentsaade nuuna ashshanaw haaya.<verse eid="PSA 80:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3" />Abeet S'oossaw, nuuna zaara;</para>
  <para style="q2" vid="PSA 80:3">nuuni attanaadan, ne som"uwaa nuw poo'issa.<verse eid="PSA 80:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4" />Abeet Ubbaappe Wolk'k'aama Med'etaa Ubbaa Godaw, S'oossaw,</para>
  <para style="q2" vid="PSA 80:4">ne asaa woosaa bolla awude gakkanaw hank'k'ettay?<verse eid="PSA 80:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5" />Neeni unttuntta yeekuwaa k'umaadan mizaadda;</para>
  <para style="q2" vid="PSA 80:5">k'ay afotsaa haatsaadan ushshaadda.<verse eid="PSA 80:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6" />Nu shoorotuu nu biittaa akkanaw,</para>
  <para style="q2" vid="PSA 80:6">barenttu gidon walak'ettanaadan ootsaadda;</para>
  <para style="q2" vid="PSA 80:6">nu morkketuu nu bolla miic'c'eeddino.<verse eid="PSA 80:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7" />Abeet Ubbaappe Wolk'k'aama S'oossaw, nuuna zaara;</para>
  <para style="q2" vid="PSA 80:7">nuuni attanaadan, ne som"uwaa nuw poo'issa.<verse eid="PSA 80:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8" />Neeni Gibs'eppe woyniyaa anuwaa ahaada;</para>
  <para style="q2" vid="PSA 80:8">ayihuda gidena asatuwaa yederssaadda, unttunttu biittaan Aa tokkaadda.<verse eid="PSA 80:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9" />Neeni woraa butsaadda;</para>
  <para style="q2" vid="PSA 80:9">yaatina, s'ap'uwaa yeddi daashiide,</para>
  <para style="q2" vid="PSA 80:9">biittaa ubbaa gakkeedda.<verse eid="PSA 80:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10" />Deretuu Aa kuwan,</para>
  <para style="q2" vid="PSA 80:10">Libaanoosa zigatuu Aa tashetuwaan kameteeddino.<verse eid="PSA 80:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11" />Bare tashetuwaa Meediteraane Abbaa gakkanaw,</para>
  <para style="q2" vid="PSA 80:11">k'ay bare s'eeratuwaa Efiraas'iisa Shaafaa gakkanaw yeddeedda.<verse eid="PSA 80:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12" />Yaatina, ogiyaanna aad'd'iyaa ubbay,</para>
  <para style="q1" vid="PSA 80:12">Aa ayifiyaa duutsanaadan,</para>
  <para style="q2" vid="PSA 80:12">Aa yuushshuwaan de'iyaa gimbbiyaa ayaw kolaadii?<verse eid="PSA 80:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13" />Bazzuwaa guduntsay Aa bolla duriide bayzzee;</para>
  <para style="q2" vid="PSA 80:13">k'ay gaden wos's'i k'aas's'iyaa med'etatuu ubbay Aa miino.<verse eid="PSA 80:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14" />Abeet Med'etaa Ubbaa S'oossaw,</para>
  <para style="q2" vid="PSA 80:14">neeni nuukko simma.</para>
  <para style="q1" vid="PSA 80:14">Saluwaana duge s'eellaade be'a;</para>
  <para style="q2" vid="PSA 80:14">ha woyniyaa naaga.<verse eid="PSA 80:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 80:15" />I ne ushechcha kushii tokkeedda s'ap'uwaa;</para>
  <para style="q2" vid="PSA 80:15">neeni new gaade dichcheedda puutiyaa.<verse eid="PSA 80:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16" />Ne morkketuu ne woyniyaa butseeddino;</para>
  <para style="q2" vid="PSA 80:16">taman s'uuggeeddino.</para>
  <para style="q1" vid="PSA 80:16">Hewaa diraw, neeni unttuntta ne hank'k'uwaa suuluwaan d'ayissa.<verse eid="PSA 80:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17" />Ne kushii, ne ushechchan de'iyaa asaa,</para>
  <para style="q2" vid="PSA 80:17">neeni new gaade dichcheedda asaa naago.<verse eid="PSA 80:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18" />Yaatooppe, nuuni neeppe guyye simmokko.</para>
  <para style="q1" vid="PSA 80:18">Nuuna pas'a wotsa; ne suntsaa nuuni galatana.<verse eid="PSA 80:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19" />Abeet Ubbaappe Wolk'k'aama Med'inaa Godaa S'oossaw,</para>
  <para style="q2" vid="PSA 80:19">nuuna zaara; nuuni attanaadan,</para>
  <para style="q2" vid="PSA 80:19">ne som"uwaa nuw poo'issa.<verse eid="PSA 80:19" /></para>
  <chapter eid="PSA 80" />
  <chapter number="81" style="c" sid="PSA 81" />
  <para style="s">Baalaa Mazimuriyaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Suusulatuwaan Yes'etteedda, Asaafi s'aafeeddawaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1" />Nuw wolk'k'aa gidiyaa S'oossaw,</para>
  <para style="q2" vid="PSA 81:1">hintte k'aalaa d'ok'k'u ootsiide yes's'ite;</para>
  <para style="q2" vid="PSA 81:1">Yaak'ooba S'oossaa sabbite.<verse eid="PSA 81:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2" />Yetsaa doommite; karabuwaa bak'k'ite;</para>
  <para style="q2" vid="PSA 81:2">diitsaaninne maasink'k'uwaan lo"a yetsaa sissite.<verse eid="PSA 81:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3" />Aginay s'eeriya wodenne,</para>
  <para style="q2" vid="PSA 81:3">aginay doyssiyaa wode</para>
  <para style="q2" vid="PSA 81:3">baalaa gallassan malakataa punnite.<note caller="-" style="x"><char style="xo" closed="false">81:3 </char><char style="xt" closed="false"><ref loc="NUM 10:10">Pay. 10:10</ref></char></note><verse eid="PSA 81:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4" />Hawe Israa'eeliyaw higgiyaa;</para>
  <para style="q2" vid="PSA 81:4">Yaak'ooba S'oossaappe imetteedda woga.<verse eid="PSA 81:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5" />Gibs'e biittaa I shoc'eedda wode,</para>
  <para style="q2" vid="PSA 81:5">Yooseefo asaw ha wogaa awaayeedda.</para>
  <para style="q1" vid="PSA 81:5">Taani erenna kooshshaa hawaadan yaagiyaawaa sisaad.<verse eid="PSA 81:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6" />«Hintte hashiyaappe tookuwaa wotsaad;</para>
  <para style="q2" vid="PSA 81:6">hintte kushiyaa s'uubiyaappe shemppissaad.<verse eid="PSA 81:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7" />Hintte metuwaa wode taana s'eeseeddita;</para>
  <para style="q2" vid="PSA 81:7">hinttena ashshaad;<note caller="-" style="x"><char style="xo" closed="false">81:7 </char><char style="xt" closed="false"><ref loc="EXO 17:7">Kes. 17:7</ref>; <ref loc="NUM 20:13">Pay. 20:13</ref></char></note></para>
  <para style="q2" vid="PSA 81:7">taani guumiyaa shaariyaa giddon geemmeeddasaappe hinttena allaad.</para>
  <para style="q2" vid="PSA 81:7">Mariiba giyaa pulttuwaa matan taani hinttena paac'c'aad.<verse eid="PSA 81:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8" />Ta asaw, taani hinttena seeriyaawaa sisite;</para>
  <para style="q2" vid="PSA 81:8">ha"i Israa'eelatoo, hayzzeerikkite!<verse eid="PSA 81:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9" />Hintte giddon allaga s'oossi de'oppo;<note caller="-" style="x"><char style="xo" closed="false">81:9-10 </char><char style="xt" closed="false"><ref loc="EXO 20:2-3">Kes. 20:2-3</ref>; <ref loc="DEU 5:6-7">Zar. 5:6-7</ref></char></note></para>
  <para style="q2" vid="PSA 81:9">hara s'oossaw goyinnoppite.<verse eid="PSA 81:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10" />Taani, Med'inaa Godaa hintte S'oossaa,</para>
  <para style="q2" vid="PSA 81:10">hinttena Gibs'e biittaappe kessaade aheeddawaa.</para>
  <para style="q1" vid="PSA 81:10">Ne doonaa loytsa hangga;</para>
  <para style="q2" vid="PSA 81:10">taani neena darssaade barssana.<verse eid="PSA 81:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11" />«Shin ta asatuu ta k'aalaa sisibeykkino;</para>
  <para style="q2" vid="PSA 81:11">Israa'eelatuu taw azazettibeykkino.<verse eid="PSA 81:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12" />Hewaa diraw, taani unttunttu barenttu k'ofaa kaallana mala,</para>
  <para style="q2" vid="PSA 81:12">eeno geena wozanaw aatsaade immaad.<verse eid="PSA 81:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13" />Ta Asay taana siseedentto,</para>
  <para style="q2" vid="PSA 81:13">Israa'eelatuu ta ogiyaa kaalleedentto ayee de'ii!<verse eid="PSA 81:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14" />Taani unttunttu morkkiyaa elle s'oonana shin;</para>
  <para style="q2" vid="PSA 81:14">unttunttu baaligaaraatuwaa bolla ta kushiyaa wotsana shin.<verse eid="PSA 81:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15" />Med'inaa Godaa is's'iyaawanttu Aa sintsan hokkana,</para>
  <para style="q2" vid="PSA 81:15">unttunttu muruukka med'inaassa gidanawaa.<verse eid="PSA 81:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16" />Taani hinttena lo"o zarggaa mizana;</para>
  <para style="q2" vid="PSA 81:16">k'ay eessaa, shuchchaa gonggoluwaappe kalissana» yaagee.<verse eid="PSA 81:16" /></para>
  <chapter eid="PSA 81" />
  <chapter number="82" style="c" sid="PSA 82" />
  <para style="s">S'oossay Ubbaappe Bolla</para>
  <para style="d">Asaafa mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1" />S'oossay saluwaa shiik'uwaa shiishshee.</para>
  <para style="q2" vid="PSA 82:1">S'oossatuwaa giddon hawaadan yaagiide pirddee;<verse eid="PSA 82:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2" />«Hintte awude gakanaw geella pirddaa pirddiitee;</para>
  <para style="q2" vid="PSA 82:2">laa"entso iitatuwaa bagga gidoppite.<verse eid="PSA 82:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3" />Hiyyeesatoonne aawuu bayinnawanttoo mootettite;</para>
  <para style="q2" vid="PSA 82:3">mank'k'onne naak'etteedda asatuwaa maataa naagissite.<verse eid="PSA 82:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4" />Daaburanchchatuwaanne metootanchchatuwaa ashshite;</para>
  <para style="q2" vid="PSA 82:4">iitatuwaa kushiyaappe unttuntta wotsi akkite.<verse eid="PSA 82:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5" />«Hintte ayinne erikkitanne ayinne akeekikkita;</para>
  <para style="q2" vid="PSA 82:5">hintte d'uman hamettiita.</para>
  <para style="q1" vid="PSA 82:5">S'illotetsay d'ayina, biittay yiik'k'iyiik'k'ee.<verse eid="PSA 82:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6" />Taani hinttena, ‹Hintte s'oossatuwaa;<note caller="-" style="x"><char style="xo" closed="false">82:6 </char><char style="xt" closed="false"><ref loc="JHN 10:34">Yoh. 10:34</ref></char></note></para>
  <para style="q2" vid="PSA 82:6">hintte ubbaykka Ubbaappe D'ok'k'iyaa S'oossaa naanatuwaa.<verse eid="PSA 82:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7" />Gidooppenne, hintte Asay hayk'k'iyaawaadan hayk'k'ana.</para>
  <para style="q2" vid="PSA 82:7">K'ay hara kaappatuu kunddeeddawaadan,</para>
  <para style="q2" vid="PSA 82:7">hinttekka kunddana› yaagay» yaagee.<verse eid="PSA 82:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8" />Abeet S'oossaw, dendda; sa'aa pirddaa;</para>
  <para style="q2" vid="PSA 82:8">kawutetsay ubbay newaa.<verse eid="PSA 82:8" /></para>
  <chapter eid="PSA 82" />
  <chapter number="83" style="c" sid="PSA 83" />
  <para style="s">Israa'eeliyaa Morkketuwaa Bolla Shiik'eedda Woosaa</para>
  <para style="d">Asaafa mazamuriyaa, yetsaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 83:1" />Abeet S'oossaw, c'o"u gooppa;</para>
  <para style="q2" vid="PSA 83:1">sirp'p'i gooppa;</para>
  <para style="q2" vid="PSA 83:1">abeet S'oossaw, muumoppa.<verse eid="PSA 83:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2" />Be'a! Ne morkketuu ne bolla denddiino;</para>
  <para style="q2" vid="PSA 83:2">neena is's'iyaawanttu ne bolla makkaliino.<verse eid="PSA 83:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3" />Unttunttu ne asaa bollan geeman yaa'iino;</para>
  <para style="q2" vid="PSA 83:3">neeni siik'iyaa asatuwaa bolla mak'ettiino.<verse eid="PSA 83:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4" />Unttunttu, «Haayite, unttunttu kawutetsaa d'ayissoytee;</para>
  <para style="q2" vid="PSA 83:4">Israa'eeliyaa giyaa suntsaa,</para>
  <para style="q2" vid="PSA 83:4">med'inaw hassayettennaadan ootsoytte» yaagiino.<verse eid="PSA 83:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5" />Unttunttu itti wozana gidiide,</para>
  <para style="q2" vid="PSA 83:5">ittippe mak'ettiinonne,</para>
  <para style="q2" vid="PSA 83:5">ne bolla c'aak'uwaa c'aak'k'etiino.<verse eid="PSA 83:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6" />C'aak'k'etiyaawanttunne</para>
  <para style="q2" vid="PSA 83:6">Eedoomanne Isimaa'eela asatuwaa,</para>
  <para style="q1" vid="PSA 83:6">Moo'aaba zaratuwaanne Aggaari zaratuwaa;<verse eid="PSA 83:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7" />Gebaala asatuwaa, Amoona asatuwaa,</para>
  <para style="q2" vid="PSA 83:7">Amaaleek'a asatuwaa,</para>
  <para style="q1" vid="PSA 83:7">Piliss's'eema asatuwaanne S'iiroosa asatuwaa.<verse eid="PSA 83:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8" />Asoore asatuukka unttunttunna ittippe gakketeeddino;</para>
  <para style="q2" vid="PSA 83:8">Asooratuukka Loos'e zaretoo wolk'k'aama maaduwaa gideeddino.<verse eid="PSA 83:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9" />Neeni Midiyaama asatuwaa bollanne</para>
  <para style="q2" vid="PSA 83:9">Sisaaranne Yaabina bolla,</para>
  <para style="q1" vid="PSA 83:9">K'iishoona Shaafaan ootseeddawaadan unttunttu bolla ootsa.<note caller="-" style="x"><char style="xo" closed="false">83:9 </char><char style="xt" closed="false"><ref loc="JDG 4:6-22">Dat. 4:6-22</ref>; <ref loc="JDG 7:1-23">7:1-23</ref></char></note><verse eid="PSA 83:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10" />Unttunttu Enddooren d'ayeeddino;</para>
  <para style="q2" vid="PSA 83:10">unttunttu anhay moogettennan biittan wook'k'eedda.<verse eid="PSA 83:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11" />Unttunttu kaappotuwaa,</para>
  <para style="q2" vid="PSA 83:11">neeni Oreebanne Za'eeba ootseeddawaadan ootsa;<note caller="-" style="x"><char style="xo" closed="false">83:11 </char><char style="xt" closed="false"><ref loc="JDG 7:25">Dat. 7:25</ref>; <ref loc="JDG 8:12">8:12</ref></char></note></para>
  <para style="q2" vid="PSA 83:11">unttuntta mooddiyaawantta</para>
  <para style="q2" vid="PSA 83:11">neeni Zebaahanne S'almmunaa'a d'ayisseeddawaadan d'ayissa.<verse eid="PSA 83:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12" />Hewanttunne, «Nuuni S'oossaa asaa biittaa</para>
  <para style="q2" vid="PSA 83:12">nuw buzotana» yaageeddawantta.<verse eid="PSA 83:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13" />Abeet ta S'oossaw, unttuntta baanaadan laala;</para>
  <para style="q2" vid="PSA 83:13">c'arkkuu afiyaa suullaadan ootsa.<verse eid="PSA 83:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14" />S'aragay wora miide wurssiyaawaadan,</para>
  <para style="q2" vid="PSA 83:14">tamaa lac'uu deriyaa mayiyaawaadan,<verse eid="PSA 83:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 83:15" />hewaadankka ne uushuwaan unttuntta yederssa;</para>
  <para style="q2" vid="PSA 83:15">ne gotiyaan unttuntta dagantsa.<verse eid="PSA 83:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16" />Abeet Med'inaa Godaw, Asay ne suntsaa koyana mala,</para>
  <para style="q2" vid="PSA 83:16">neeni unttunttu som"uwaa yeellaa mayzza.<verse eid="PSA 83:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17" />Unttunttu med'inaw yeellatinonne hirggino;</para>
  <para style="q2" vid="PSA 83:17">kawushiide d'ayino.<verse eid="PSA 83:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18" />Ne suntsaykka Med'inaa Godaa gidiyaawaa,</para>
  <para style="q2" vid="PSA 83:18">ne s'alalay Ubbaappe D'ok'k'a S'oossaa,</para>
  <para style="q2" vid="PSA 83:18">sa'aa ubbaa mooddiyaawaa unttunttu erino.<verse eid="PSA 83:18" /></para>
  <chapter eid="PSA 83" />
  <chapter number="84" style="c" sid="PSA 84" />
  <para style="s">S'oossaa Golliyaa Laamotussaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Suusulatuwaan Yes'etteedda, K'oore Naanatuu S'aafeedda Mazimuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 84:1" />Abeet Ubbaappe Wolk'k'aama Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 84:1">neeni de'iyaasay ayaa lo"ii!<verse eid="PSA 84:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2" />Taani Med'inaa Godaa Geeshsha Golliyaa Dabaabaa laamotay;</para>
  <para style="q2" vid="PSA 84:2">ta kumentsaa asatetsay de'uwaa S'oossaw nashshechchan yes's'ee.<verse eid="PSA 84:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3" />Abeet Ubbaappe Wolk'k'aama Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 84:3">ta kaatiyaw, ta S'oossaw,</para>
  <para style="q2" vid="PSA 84:3">new yarshshiyaa sa'aa matan,</para>
  <para style="q2" vid="PSA 84:3">suunniyaa kafatta barew de'iyaasaa demmaaddu.</para>
  <para style="q1" vid="PSA 84:3">Harap'p'attakka barew k'uuk'k'ulliyaa golliyaa yaan kees's'aaddu.<verse eid="PSA 84:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4" />Ne Geeshsha Golliyaan de'iyaawanttunne</para>
  <para style="q2" vid="PSA 84:4">med'inaw neena sabbiyaawanttu anjjetteedawantta.<verse eid="PSA 84:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5" />Wolk'k'aa neeppe demmiyaawanttu,</para>
  <para style="q2" vid="PSA 84:5">barenttu wozanaan S'iyoone afiyaa ogiyaa baanaw</para>
  <para style="q2" vid="PSA 84:5">amottiyaawanttu anjjetteedawantta.<verse eid="PSA 84:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6" />Yeekuwaa zanggaaraanna unttunttu aad'd'iyaa wode,</para>
  <para style="q2" vid="PSA 84:6">he sa'ay pulttuwaa kesee.</para>
  <para style="q1" vid="PSA 84:6">Bad'd'eesaa iraykka bukkiide,</para>
  <para style="q2" vid="PSA 84:6">yaan del"iyaa gisissee.<verse eid="PSA 84:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7" />Unttunttu biyaa wode, wolk'k'aa gujji gujjiide baana.</para>
  <para style="q2" vid="PSA 84:7">Unttunttu S'oossaa sintsan S'iyoonen beettana.<verse eid="PSA 84:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8" />Abeet Ubbaappe Wolk'k'aama Med'inaa Godaw S'oossaw,</para>
  <para style="q2" vid="PSA 84:8">ta woosaa neeni sisa.</para>
  <para style="q1" vid="PSA 84:8">Abeet Yaak'ooba S'oossaw, hayzza.<verse eid="PSA 84:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9" />Abeet S'oossaw, nu gonddalliyaa be'a;</para>
  <para style="q2" vid="PSA 84:9">neeni dooreedda kaatiyaa ne keeka ayifiyaan s'eella.<verse eid="PSA 84:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10" />Taani hara sa'aan sha"u gallassaa de'anaappe</para>
  <para style="q2" vid="PSA 84:10">S'oossaa golliyaan itti gallassaa de'iyaawe lo"a.</para>
  <para style="q1" vid="PSA 84:10">Iitatuwaa dunkkaaniyaan de'anawaappe</para>
  <para style="q2" vid="PSA 84:10">ta S'oossaa golliyaa penggiyaa naagiyaawe taw lo"a.<verse eid="PSA 84:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11" />Med'inaa Goday S'oossay nuw gonddallenne poo"uwaa;</para>
  <para style="q2" vid="PSA 84:11">Med'inaa Goday nuw bonchchuwaanne keekkatetsaa immee.</para>
  <para style="q1" vid="PSA 84:11">Suuretetsan hamettiyaawantta I lo"obaa ubbaa diggenna.<verse eid="PSA 84:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12" />Abeet Ubbaappe Wolk'k'aama Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 84:12">neenan ammanettiyaawanttu anjjetteedawantta.<verse eid="PSA 84:12" /></para>
  <chapter eid="PSA 84" />
  <chapter number="85" style="c" sid="PSA 85" />
  <para style="s">Asaa Sarotetsaw Shiik'eedda Woosaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, K'oraaha naanatuwaa mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1" />Abeet Med'inaa Godaw, neeni ne biittaw keekkaadda;</para>
  <para style="q2" vid="PSA 85:1">Yaak'ooba asaa omooduwaappe zaaraadda.<verse eid="PSA 85:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2" />Neeni ne asaa naak'uwaa atto gaadda;</para>
  <para style="q2" vid="PSA 85:2">unttunttu nagaraa ubbaa kamaadda.<verse eid="PSA 85:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3" />Neeni ne hank'k'uwaa ubbaa aggaada;</para>
  <para style="q2" vid="PSA 85:3">ne hank'k'uwaa suuluwaappekka simmaadda.<verse eid="PSA 85:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4" />Abeet nuuna ashshiyaa S'oossaw,</para>
  <para style="q2" vid="PSA 85:4">nuuna guyye zaara.</para>
  <para style="q1" vid="PSA 85:4">Neeni nuw hank'k'eteeddawaa agga.<verse eid="PSA 85:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5" />Neeni nuuna med'inaw hank'k'ettay?</para>
  <para style="q2" vid="PSA 85:5">Ne hank'k'uwaa yeletaa ubbaa gakkanaw gam"isay?<verse eid="PSA 85:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6" />Ne Asay neenan nashettana mala,</para>
  <para style="q2" vid="PSA 85:6">nuuna ooratsa.<verse eid="PSA 85:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7" />Abeet Med'inaa Godaw, aggena ne siik'uwaa nuuna bessa;</para>
  <para style="q2" vid="PSA 85:7">neeni nuuna ashsha.<verse eid="PSA 85:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8" />Taani Med'inaa Goday S'oossay odiyaawaa sisana.</para>
  <para style="q2" vid="PSA 85:8">Nuuni nu booza ogiyaa guyye baana d'ayooppe,</para>
  <para style="q1" vid="PSA 85:8">I nuw, bare asaw, «Sarotetsaa immana» giide odee.<verse eid="PSA 85:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9" />Tumukka S'oossaw yayyiyaawantta ashshanaw</para>
  <para style="q2" vid="PSA 85:9">I matan de'ee;</para>
  <para style="q2" vid="PSA 85:9">hewenne, Aa bonchchuu nu biittan de'anaassa.<verse eid="PSA 85:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10" />Aggena siik'uunne tumatetsay</para>
  <para style="q2" vid="PSA 85:10">ittippe gakkettana.</para>
  <para style="q1" vid="PSA 85:10">S'illotetsaynne sarotetsay,</para>
  <para style="q2" vid="PSA 85:10">ittippe yerettana.<verse eid="PSA 85:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11" />Tumatetsay sa'aappe pude kesana;</para>
  <para style="q2" vid="PSA 85:11">S'oossaa s'illotetsay saluwaappe duge s'eelana.<verse eid="PSA 85:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12" />Ee, Med'inaa Goday keekkabaa immana;</para>
  <para style="q2" vid="PSA 85:12">nu biittaykka lo"o katsaa mokkana.<verse eid="PSA 85:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13" />S'illotetsay S'oossaappe sintsanna heemettana;</para>
  <para style="q2" vid="PSA 85:13">aw ogiyaa giigissana.<verse eid="PSA 85:13" /></para>
  <chapter eid="PSA 85" />
  <chapter number="86" style="c" sid="PSA 86" />
  <para style="s">Metuwaa Wode Woosaa</para>
  <para style="d">Daawite woosseedda woosaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1" />Abeet Godaw, taani hiyyeessanne,</para>
  <para style="q2" vid="PSA 86:1">metootanchchaa asaa gidiyaa diraw,</para>
  <para style="q2" vid="PSA 86:1">ta waasuwaa sisaade, taw alla.<verse eid="PSA 86:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2" />Taani S'oossaa asaa gidiyaa diraw,</para>
  <para style="q2" vid="PSA 86:2">taana pas'a wotsa.</para>
  <para style="q1" vid="PSA 86:2">Neenan ammanettiyaa taana, ne k'oomaa ashsha.</para>
  <para style="q2" vid="PSA 86:2">Neeni ta S'oossaa.<verse eid="PSA 86:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3" />Abeet S'oossaw, taani gallassaa ubbaa</para>
  <para style="q2" vid="PSA 86:3">neekko waassiyaa diraw,</para>
  <para style="q2" vid="PSA 86:3">taw k'aretta.<verse eid="PSA 86:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4" />Abeet S'oossaw, taani ta shemppuwaappe</para>
  <para style="q2" vid="PSA 86:4">neena woossiyaa diraw,</para>
  <para style="q2" vid="PSA 86:4">taana, ne k'oomaa nashshechchaa.<verse eid="PSA 86:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5" />Abeet S'oossaw, neeni keekkanne atto giyaawaa;</para>
  <para style="q2" vid="PSA 86:5">neena s'eesiyaa ubbaw ne siik'uu dara.<verse eid="PSA 86:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6" />Abeet Med'inaa Godaw, ta woosaa sisa;</para>
  <para style="q2" vid="PSA 86:6">taani watiwatiyaa watiwatuwaa hayzza.<verse eid="PSA 86:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7" />Neeni taw alliyaa diraw,</para>
  <para style="q2" vid="PSA 86:7">ta metuwaa gallassan taani neekko waassay.<verse eid="PSA 86:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8" />Abeet Godaw, s'oossatuwaa giddon ne mali baawa;</para>
  <para style="q2" vid="PSA 86:8">ne oosuwaa mala oosuukka baawa.<verse eid="PSA 86:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9" />Abeet Godaw, neeni med'd'eedda kawutetsaa Asay ubbay yiide,<note caller="-" style="x"><char style="xo" closed="false">86:9 </char><char style="xt" closed="false"><ref loc="REV 15:4">Sas'. 15:4</ref></char></note></para>
  <para style="q2" vid="PSA 86:9">ne sintsan gulbbatana; unttunttu ne suntsaa bonchchana.<verse eid="PSA 86:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10" />Ayaw gooppe, neeni wolk'k'aama;</para>
  <para style="q2" vid="PSA 86:10">neeni malalissiyaabaa ootsaasa.</para>
  <para style="q1" vid="PSA 86:10">Ne s'alalay S'oossaa.<verse eid="PSA 86:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11" />Abeet Med'inaa Godaw, taani ne tumuwaan hamettana mala,</para>
  <para style="q2" vid="PSA 86:11">taana ne ogiyaa tamaarissa.</para>
  <para style="q1" vid="PSA 86:11">Taani ne suntsaw yayana mala,</para>
  <para style="q2" vid="PSA 86:11">taw itti wozanaa imma.<verse eid="PSA 86:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12" />Abeet Godaw ta S'oossaw, taani neena,</para>
  <para style="q2" vid="PSA 86:12">ta kumentsaa wozanaappe galatana.</para>
  <para style="q1" vid="PSA 86:12">Ne suntsaa med'inaw bonchchana.<verse eid="PSA 86:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13" />Ayaw gooppe, ne siik'uu taw dara;</para>
  <para style="q2" vid="PSA 86:13">neeni taana duufuwaan geliyaawaappe ashshaada.<verse eid="PSA 86:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14" />Abeet Godaw, otoranchcha asatuu ta bolla denddeeddino;</para>
  <para style="q2" vid="PSA 86:14">dagantsiyaa asatuwaa c'uguu taana wod'anaw koyee.</para>
  <para style="q1" vid="PSA 86:14">Unttunttu neena alaalle giikkino.<verse eid="PSA 86:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15" />Shin abeet Godaw, neeni</para>
  <para style="q2" vid="PSA 86:15">k'arettiyaanne maariyaa S'oossaa;</para>
  <para style="q2" vid="PSA 86:15">hank'k'ettanaw gam"aasa;</para>
  <para style="q2" vid="PSA 86:15">siik'uunne ammanettussay dariyaawaa.<verse eid="PSA 86:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16" />Taakko simmaade taw k'aretta.</para>
  <para style="q2" vid="PSA 86:16">Ne k'oomaw wolk'k'aa imma;</para>
  <para style="q2" vid="PSA 86:16">ne k'oomati na'aa taana ashsha.<verse eid="PSA 86:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17" />Abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 86:17">ne keekkatetsaa malaataa taana bessa.</para>
  <para style="q1" vid="PSA 86:17">Neeni taana maaddeeddawaanne mintsetseeddawaa be'iyaa wode,</para>
  <para style="q2" vid="PSA 86:17">taana is's'iyaawanttu hewan yeellatana.<verse eid="PSA 86:17" /></para>
  <chapter eid="PSA 86" />
  <chapter number="87" style="c" sid="PSA 87" />
  <para style="s">Yerusaalame Sabaa</para>
  <para style="d">K'oraaha naanatuwaa mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1" />Med'inaa Godaa katamay geeshsha deriyaan kees'etteedda.<verse eid="PSA 87:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 87:2" />Med'inaa Goday S'iyoone penggetuwaa,</para>
  <para style="q2" vid="PSA 87:2">Yaak'oobi de'iyaa sa'aa ubbaappe aatsiide dosee.<verse eid="PSA 87:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3" />Hanee S'oossaa katamatee,</para>
  <para style="q2" vid="PSA 87:3">ne diraw bonchchetteeddabay,</para>
  <para style="q2" vid="PSA 87:3">hawaadan yaagi odettee:<verse eid="PSA 87:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4" />«Taana eriyaa kawutetsatuwaa gidoppe,</para>
  <para style="q2" vid="PSA 87:4">Gibs'enne Baabloone gatsa mazggobana;</para>
  <para style="q1" vid="PSA 87:4">Piliss's'eeme, S'iiroosenne Toop'p'iyaa asay,</para>
  <para style="q2" vid="PSA 87:4">yaan yeletteeddino.»<verse eid="PSA 87:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5" />S'oossay, «Kawutetsaa ubbay S'iyoonen yeletteeddawaa» yaagana.</para>
  <para style="q2" vid="PSA 87:5">Ubbaappe D'ok'k'iyaa S'oossay izo minisana.<verse eid="PSA 87:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6" />Med'inaa Goday asaa s'aafiyaa mazggobiyaan,</para>
  <para style="q2" vid="PSA 87:6">«Hawe S'iyoonen Yeletteeddawaa» yaagiide s'aafana.<verse eid="PSA 87:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7" />Unttunttu yes's'iide duriidde,</para>
  <para style="q2" vid="PSA 87:7">«Nu anjjuu ubbay S'iyooneppe pulttee» yaagana.<verse eid="PSA 87:7" /></para>
  <chapter eid="PSA 87" />
  <chapter number="88" style="c" sid="PSA 88" />
  <para style="s">Maaduwaa Demanaw Shiik'o Waasuwaa</para>
  <para style="d">Zammaaretuwaa Kaappoo, K'oraaha naanatuwaa mazamuriyaa, Maaduwaa Woossa, Ezirahiyaa Hemaane Akeekan S'aafeedda Timirttiyaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 88:1" />Abeet Med'inaa Godaw, taana ashshiyaa S'oossaw,</para>
  <para style="q2" vid="PSA 88:1">taani gallassi new waassay;</para>
  <para style="q2" vid="PSA 88:1">k'ammakka ne sintsan yeekkay.<verse eid="PSA 88:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2" />Ta woosay ne sintsa gakko;</para>
  <para style="q2" vid="PSA 88:2">ne haytsaa ta waasuwaakko zaara.<verse eid="PSA 88:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3" />Ayaw gooppe, ta de'uu metuwaan kumeedda;</para>
  <para style="q2" vid="PSA 88:3">taani hayk'k'ana mataad.<verse eid="PSA 88:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4" />Taani duufuwaan geliyaa asatuwaana paydetaad;</para>
  <para style="q2" vid="PSA 88:4">wolk'k'ay bayinna asaa gidaaddi.<verse eid="PSA 88:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5" />Taani anhatuwaa giddon aggeeda asaa mala;</para>
  <para style="q2" vid="PSA 88:5">wod'iide duufuwaan yeggeedda asatuwaa mala.</para>
  <para style="q1" vid="PSA 88:5">Taani ne ubbaa dogeedda,</para>
  <para style="q2" vid="PSA 88:5">ne maaduwaappe haakkeedda asatuwaa mala.<verse eid="PSA 88:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6" />Neeni taana c'iimmo ollaan,</para>
  <para style="q2" vid="PSA 88:6">hirkki d'uma sa'aan yeggaadda.<verse eid="PSA 88:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7" />Ne hank'k'uu taana dees'ee;</para>
  <para style="q2" vid="PSA 88:7">ne hank'k'uwaa beetay taana ubbaanna muukkeedda.<verse eid="PSA 88:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8" />Neeni ta dabbotuwaa taappe haassaadda;</para>
  <para style="q2" vid="PSA 88:8">unttunttoo taana sheneyiyaawaa ootsaadda.</para>
  <para style="q1" vid="PSA 88:8">Taani dooddettaad;</para>
  <para style="q2" vid="PSA 88:8">kessa akkanawukka danddaykke.<verse eid="PSA 88:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 88:9" />Abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 88:9">kayyuwaa gaasuwaan ta ayifetuu galjjeeddino.</para>
  <para style="q1" vid="PSA 88:9">Ubbaa gallassi taani neekko waassay;</para>
  <para style="q2" vid="PSA 88:9">ta kushiyaa neekko mic'c'aad.<verse eid="PSA 88:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10" />Neeni hayk'k'eeddawanttoo</para>
  <para style="q2" vid="PSA 88:10">malalissiyaabaa ootsay?</para>
  <para style="q2" vid="PSA 88:10">unttunttu denddiide neena galatiino?<verse eid="PSA 88:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11" />Aggena ne siik'uu</para>
  <para style="q2" vid="PSA 88:11">duufuwaa giddon haasayettii?</para>
  <para style="q2" vid="PSA 88:11">neeni ammanettiyaawekka bayetsaa sa'aan odettii?<verse eid="PSA 88:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12" />Ne malalissiyaa oosuukka d'uman erettii?</para>
  <para style="q2" vid="PSA 88:12">woy ne s'iltotetsay dogetteedda asatuwaa biittan de'ii?<verse eid="PSA 88:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13" />Abeet Med'inaa Godaw, taani neekko waassay;</para>
  <para style="q2" vid="PSA 88:13">wonttaan wonttaan ta woosay ne sintsa gakkee.<verse eid="PSA 88:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14" />Abeet Med'inaa Godaw, taana neeni ayaw aggay?</para>
  <para style="q1" vid="PSA 88:14">Ne som"uwaa taappe ayaw gentsay?<verse eid="PSA 88:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15" />Yalagatetsaappe doommaade,</para>
  <para style="q2" vid="PSA 88:15">taani tuggataaddinne hayk'k'ana mataad.</para>
  <para style="q1" vid="PSA 88:15">Taani new dagamaade hiidootaa k'ans's'aad.<verse eid="PSA 88:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16" />Ne suulliyaa hank'k'uu ta bolla uushoteedda;</para>
  <para style="q2" vid="PSA 88:16">ne dagamay taana bayzzeedda.<verse eid="PSA 88:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17" />Unttunttu gallassaa ubbaa di'uwaadan taana dooddeeddino;</para>
  <para style="q2" vid="PSA 88:17">taana muukkeeddino.<verse eid="PSA 88:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18" />Neeni ta laggetuwaanne ta siik'otuwaa taappe haassaadda;</para>
  <para style="q2" vid="PSA 88:18">d'umaa s'alalay taw dabbo.<note caller="-" style="x"><char style="xo" closed="false">88:18 </char><char style="xt" closed="false"><ref loc="1KI 4:31">1 Kat. 4:31</ref></char></note><verse eid="PSA 88:18" /></para>
  <chapter eid="PSA 88" />
  <chapter number="89" style="c" sid="PSA 89" />
  <para style="s">Metuwaa Mazimuriyaa</para>
  <para style="d">Ezirahiyaa Etaana Akeekan S'aafetteedda Timirttiyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 89:1" />Abeet Med'inaa Godaw, aggena ne siik'uwaabaa,</para>
  <para style="q2" vid="PSA 89:1">taani med'inaw yes's'ana.</para>
  <para style="q1" vid="PSA 89:1">S'oossay ammanettiyaawaa gaade,</para>
  <para style="q2" vid="PSA 89:1">yeletaa ubbaw ta doonaan awaayana.<verse eid="PSA 89:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2" />Taani aggena ne siik'uu med'inaw ek'k'eeddawaanne</para>
  <para style="q2" vid="PSA 89:2">neeni ne tumatetsaa saluwaadan minisaade esseeddawaa odana.<verse eid="PSA 89:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3" />Neeni, «Taani dooreeddawaana c'aak'uwaa c'aak'k'etaad.</para>
  <para style="q2" vid="PSA 89:3">Ta k'oomaa Daawitaw hawaadan yaagaade c'aak'k'aad;<verse eid="PSA 89:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4" />‹Taani ne zeretsaa med'inaw kawutsana;<note caller="-" style="x"><char style="xo" closed="false">89:4 </char><char style="xt" closed="false"><ref loc="2SA 7:12-16">2 Sam. 7:12-16</ref>; <ref loc="1CH 17:11-14">1 Od. 17:11-14</ref>; <ref loc="PSA 132:11">Maz. 132:11</ref>; <ref loc="ACT 2:30">Kit. 2:30</ref></char></note></para>
  <para style="q2" vid="PSA 89:4">ne kawutetsaa araataa yeletaa ubbaw minisana› » yaagaadda.<verse eid="PSA 89:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5" />Abeet Med'inaa Godaw, salotuu,</para>
  <para style="q2" vid="PSA 89:5">ne malalissiyaa oosuwaa odino;</para>
  <para style="q2" vid="PSA 89:5">ne ammanettiyaawaa kiitanchchatuwaa shiik'uu odino.<verse eid="PSA 89:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6" />Saluwaan Med'inaa Godaana likkettanaw danddayiyaawe oonee?</para>
  <para style="q2" vid="PSA 89:6">Saluwaa med'etetsatuwaa giddon k'ay Med'inaa Godaa mali oonee?<verse eid="PSA 89:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7" />Geeshshatuwaa shiik'uwaa giddon S'oossay yayetteeddawaa.</para>
  <para style="q2" vid="PSA 89:7">Barena dooddeeddawanttu ubbaappe aad'd'iide, loytsi dagantsiyaawaa.<verse eid="PSA 89:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8" />Abeet Ubbaappe Wolk'k'aama Med'inaa Godaw, S'oossaw,</para>
  <para style="q2" vid="PSA 89:8">neenaadan wolk'k'aamay oonee?</para>
  <para style="q1" vid="PSA 89:8">Abeet Med'inaa Godaw, neeni ubbabankka ammanettiyaawaa.<verse eid="PSA 89:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9" />Neeni bul"akettiyaa abbaa wolk'k'aa azazaasa.</para>
  <para style="q2" vid="PSA 89:9">Denddiyaa beetaakka c'o"u ootsaasa.<verse eid="PSA 89:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10" />Neeni Ra'aaba giyaa abbaa dawiyaa,</para>
  <para style="q2" vid="PSA 89:10">wod'i yegeeddawaadan mentsereetsaadda;</para>
  <para style="q2" vid="PSA 89:10">ne morkkatuwaa ne wolk'k'aama k'esiyaan laalaadda.<verse eid="PSA 89:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11" />Salotuu newantta; sa'aykka newaa;</para>
  <para style="q2" vid="PSA 89:11">biittaanne an kumeedda ubbabaa neeni med'aadda.<verse eid="PSA 89:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12" />Huup'issaanne gedissaa neeni med'd'aadda;</para>
  <para style="q2" vid="PSA 89:12">Taabooranne Hermmoone giyaa wolk'k'aama deretuu</para>
  <para style="q2" vid="PSA 89:12">nashshechchan ne suntsaa sabbiino.<verse eid="PSA 89:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13" />New wolk'k'aama k'eesii de'ee;</para>
  <para style="q2" vid="PSA 89:13">ne kushii mina;</para>
  <para style="q2" vid="PSA 89:13">ne ushechchay wolk'k'aama.<verse eid="PSA 89:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14" />S'illotetsaynne suure pirdday</para>
  <para style="q2" vid="PSA 89:14">ne kawutetsaa araataw baaso.</para>
  <para style="q1" vid="PSA 89:14">Aggena siik'uunne tumatetsay ne sintsaan biino.<verse eid="PSA 89:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15" />Abeet Med'inaa Godaw, nashechchaan ililiyaawanttunne</para>
  <para style="q2" vid="PSA 89:15">ne som"uwaa poo'uwaan hamettiyaawanttu anjjetteedawantta.<verse eid="PSA 89:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16" />Ne suntsan gallassaa ubbaa nashettiino;</para>
  <para style="q2" vid="PSA 89:16">ne s'illotetsaa diraw,</para>
  <para style="q2" vid="PSA 89:16">unttunttu neena d'ok'k'u d'ok'k'u ootsiino.<verse eid="PSA 89:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17" />Unttunttu c'eek'ettiyaa wolk'k'ay neena;</para>
  <para style="q2" vid="PSA 89:17">ne nashshuwaan nu kac'ii d'ok'k'u d'ok'k'u yaageedda.<verse eid="PSA 89:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18" />Nu gonddallii, nu Med'inaa Godaassa;</para>
  <para style="q2" vid="PSA 89:18">nu kaatiikka, Israa'eeliyaa geeshsha saa.<verse eid="PSA 89:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19" />Beni neeni ne ammanetteeda asatoo,</para>
  <para style="q2" vid="PSA 89:19">itti gede akumuwaan odaadda;</para>
  <para style="q1" vid="PSA 89:19">«Asaa gidoppe dooreeddawoo kawutetsaa araataa immaadda.<verse eid="PSA 89:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20" />Ta k'ooma Daawita kaate kesaad;<note caller="-" style="x"><char style="xo" closed="false">89:20 </char><char style="xt" closed="false"><ref loc="1SA 13:14">1 Sam. 13:14</ref>; <ref loc="ACT 13:22">Kit. 13:22</ref>; <ref loc="1SA 16:12">1 Sam. 16:12</ref></char></note></para>
  <para style="q2" vid="PSA 89:20">ta geeshsha zayitiyaan okaade.<verse eid="PSA 89:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21" />Ta kushii aanana de'ana;</para>
  <para style="q2" vid="PSA 89:21">ta k'esiikka Aa mintsana.<verse eid="PSA 89:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22" />Aa ay morkkiinne s'oonenna;</para>
  <para style="q2" vid="PSA 89:22">ay iita asaynne Aa toochchenna.<verse eid="PSA 89:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23" />Taani Aa morkkatuwaa Aa sintsan kinchchereetsana;</para>
  <para style="q2" vid="PSA 89:23">Aa is's'iyaawantta shoc'a yeggana.<verse eid="PSA 89:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24" />Ta tumatetsaynne ta aggena siik'uu</para>
  <para style="q2" vid="PSA 89:24">aanana ittippe gidana.</para>
  <para style="q1" vid="PSA 89:24">Ta suntsan Aa kac'ii d'ok'k'u d'ok'k'u gaana.<verse eid="PSA 89:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25" />Taani Aa kawutetsaa Medetiraaniyaa Abbaa gakkanaw aassana;</para>
  <para style="q2" vid="PSA 89:25">Aa zawaakka,</para>
  <para style="q1" vid="PSA 89:25">Efiraas'eesenne S'egiroose Shaafaa gakkanaw aassana.<verse eid="PSA 89:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26" />Daawite taana, ‹Neeni ta aawuwaa,</para>
  <para style="q2" vid="PSA 89:26">ta S'oossaanne taana ashshiyaa zaallaa› yaagiide s'eesana.<verse eid="PSA 89:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27" />Taani Aa bayira na'aa ootsana;<note caller="-" style="x"><char style="xo" closed="false">89:27 </char><char style="xt" closed="false"><ref loc="PSA 1:5">1:5</ref></char></note></para>
  <para style="q2" vid="PSA 89:27">sa'aan de'iyaa kaatetuwaa ubbaappe Aa darssana.<verse eid="PSA 89:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28" />Taani aggena ta siik'uwaa</para>
  <para style="q2" vid="PSA 89:28">aw med'inaw naagana.</para>
  <para style="q1" vid="PSA 89:28">Taani aanana k'aalaa c'aak'uwaa mintsana.<verse eid="PSA 89:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29" />Taani Aa zeretsaa med'inaw minisaade essana;</para>
  <para style="q2" vid="PSA 89:29">Aa kawutetsaa araataakka saluwaadan gam"etsana.<verse eid="PSA 89:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30" />«Shin Aa zeretsatuu ta higgiyaa aggooppe,</para>
  <para style="q2" vid="PSA 89:30">k'ay unttunttu ta wogaadan hamettennan is's'ooppe,<verse eid="PSA 89:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 89:31" />unttunttu ta awaayuwaa shaarooppe,</para>
  <para style="q2" vid="PSA 89:31">ta azazuwaa naagana d'ayooppe,<verse eid="PSA 89:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 89:32" />taani unttunttu nagaraa diraw gatiman,</para>
  <para style="q2" vid="PSA 89:32">unttunttu iitatetsaa diraw, lissuwaan,</para>
  <para style="q2" vid="PSA 89:32">shoc'aade murana.<verse eid="PSA 89:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33" />Shin taani aggena ta siik'uwaa aappe akkikke;</para>
  <para style="q2" vid="PSA 89:33">woy taani aw ammanettiyaawaa aggikke.<verse eid="PSA 89:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34" />Taani unttunttunna c'aak'k'eteedda c'aak'uwaa kolikke;</para>
  <para style="q2" vid="PSA 89:34">ta doonaappe keseedda k'aalaa laammikke.<verse eid="PSA 89:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35" />«Itti gedekka med'inaw</para>
  <para style="q2" vid="PSA 89:35">ta geeshshatetsaan c'aak'k'a diggaad;</para>
  <para style="q1" vid="PSA 89:35">Daawitew worddotikke.<verse eid="PSA 89:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36" />Hewenne, Aa zeretsay med'inaw de'ana;</para>
  <para style="q2" vid="PSA 89:36">Aa kawutetsaa araataykka ta sintsan awaadan gam"ana.<verse eid="PSA 89:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37" />Saluwaan ammanettiyaa markka gidiyaa aginaadan,</para>
  <para style="q2" vid="PSA 89:37">he kawutetsay med'inaw min ek'k'i de'ana» yaagaadda.<verse eid="PSA 89:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38" />Shin ha"i neeni</para>
  <para style="q2" vid="PSA 89:38">okkaade kaateyeeddawaa bolla daro hank'k'ettaadda;</para>
  <para style="q1" vid="PSA 89:38">Aa is's'aaddanne aggaada.<verse eid="PSA 89:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39" />Neeni ne k'oomaanna c'aak'k'eteedda c'aak'uwaa kaddaadda;</para>
  <para style="q2" vid="PSA 89:39">Aa kallachchaa baanan olaade tunissaadda.<verse eid="PSA 89:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40" />Neeni Aa katamaa gimbbiyaa ubbaa laalaadda;</para>
  <para style="q2" vid="PSA 89:40">I naagettiyaa miis'aa ubbaa bayzzaadda.<verse eid="PSA 89:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41" />Ogiyaanna aad'd'iyaa ubbatuu Aa bonk'k'eeddino;</para>
  <para style="q2" vid="PSA 89:41">I bare shoorotoo k'iliic'oo gideedda.<verse eid="PSA 89:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42" />Neeni Aa morkketoo s'oonuwaa immaadda;</para>
  <para style="q2" vid="PSA 89:42">unttuntta ubbatuwaa nashechchaadda.<verse eid="PSA 89:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43" />Neeni Aa mashshaa s'eeraa k'alam"aadda;</para>
  <para style="q2" vid="PSA 89:43">neeni olan Aa maaddabaakka.<verse eid="PSA 89:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44" />Neeni Aa kawutaa s'am"aa</para>
  <para style="q2" vid="PSA 89:44">Aa kushiyaappe wotsa akkaada;</para>
  <para style="q2" vid="PSA 89:44">k'ay Aa kawutetsaa araataa biittan olaadda.<verse eid="PSA 89:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45" />Neeni Aa yalagatetsaa wodiyaa k'aamisaadda;</para>
  <para style="q2" vid="PSA 89:45">k'ay Aa yeellaa mayzzaadda.<verse eid="PSA 89:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46" />Abeet Med'inaa Godaw, awude gakkanaw k'onc'c'ikkii?</para>
  <para style="q2" vid="PSA 89:46">Neeni med'inaw geemmay?</para>
  <para style="q1" vid="PSA 89:46">Ne hank'k'uu tamaadan awude gakkanaw ees's'anee?<verse eid="PSA 89:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47" />Ta laytsay ay keeshshaa k'antsentto k'oppa;</para>
  <para style="q2" vid="PSA 89:47">asaa ubbaa c'oo mela med'd'aadii?<verse eid="PSA 89:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48" />Asay hayk'k'ennan c'oo de'anaw waan danddayii?</para>
  <para style="q1" vid="PSA 89:48">K'ay duufuwaan gelennaadan,</para>
  <para style="q2" vid="PSA 89:48">barena ashshanaw waan danddayii?<verse eid="PSA 89:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49" />Abeet Godaw, neeni ne tumatetsan Daawitew c'aak'k'eedda,</para>
  <para style="q2" vid="PSA 89:49">aggena beni ne siik'uu hak'an de'ii?<verse eid="PSA 89:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50" />Abeet Godaw, ne k'oomay</para>
  <para style="q2" vid="PSA 89:50">woyssa boretteeddentto neeni hassaya.</para>
  <para style="q1" vid="PSA 89:50">Taani asaa ubbaa boriyaa woota danddayaadditantto k'oppa.<verse eid="PSA 89:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51" />Abeet Med'inaa Godaw, morkketuu k'iliic'eeddino;</para>
  <para style="q2" vid="PSA 89:51">neeni dooraade okkeedda kaatiyaa,</para>
  <para style="q2" vid="PSA 89:51">tangguwaan tangguwaan k'iliic'eeddawaa k'oppa.<verse eid="PSA 89:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52" />Med'inaa Goday med'i med'inaw galatetto!</para>
  <para style="q2" vid="PSA 89:52">Amen"i. Amen"i.<verse eid="PSA 89:52" /></para>
  <chapter eid="PSA 89" />
  <chapter number="90" style="c" sid="PSA 90" />
  <para style="ms">Oyddentso Mas'aafaa</para>
  <para style="mr">(<ref loc="PSA 90-106">90—106</ref>)</para>
  <para style="s">Asaa Na'aa De'uwaa</para>
  <para style="d">S'oossaa Asay Muse woosseedda woosaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1" />Godaw, neeni yeletaa ubbaan,</para>
  <para style="q2" vid="PSA 90:1">nuuni de'iyaa sa'aa gidaadda.<verse eid="PSA 90:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2" />Deretuu med'ettanaappe kase,</para>
  <para style="q2" vid="PSA 90:2">woy neeni sa'aa ootsanaappe kase,</para>
  <para style="q2" vid="PSA 90:2">med'inaappe med'inaa gakkanawukka neeni S'oossaa.<verse eid="PSA 90:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3" />Neeni asaa naanatuwaa, «Asaa naatoo,</para>
  <para style="q2" vid="PSA 90:3">guyye biittaw simmite» yaagaade,</para>
  <para style="q2" vid="PSA 90:3">unttuntta guyye unttunttu med'etteedda biittaw zaaraasa.<verse eid="PSA 90:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4" />Sha"u laytsay new zini aad'd'o gallassaa mala;<note caller="-" style="x"><char style="xo" closed="false">90:4 </char><char style="xt" closed="false"><ref loc="2PE 3:8">2 P'es'. 3:8</ref></char></note></para>
  <para style="q2" vid="PSA 90:4">woy k'ammaa giddoppe itti saatiyaa mala.<verse eid="PSA 90:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5" />Neeni asaa k'oppennaan di'uwaadan afaasa.</para>
  <para style="q2" vid="PSA 90:5">Unttunttu akumuwaa mala;</para>
  <para style="q2" vid="PSA 90:5">wontta wontta doliyaa maataa mala.<verse eid="PSA 90:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6" />He maataykka wontta wode dic'c'iide c'iishshee;</para>
  <para style="q2" vid="PSA 90:6">omarssiyaa wode shulli melee.<verse eid="PSA 90:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7" />Nuuni ne yiluwaan wureeddo;</para>
  <para style="q2" vid="PSA 90:7">ne hank'k'uwaa suuluwaan dagammeeddo.<verse eid="PSA 90:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8" />Neeni nu iita oosuwaa</para>
  <para style="q2" vid="PSA 90:8">ne sintsan wotsaadda;</para>
  <para style="q2" vid="PSA 90:8">k'ay nu geemmeedda nagaraa</para>
  <para style="q2" vid="PSA 90:8">ne sintsa poo'uwaakko aatsaada.<verse eid="PSA 90:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9" />Nu gallassaa ubbay ne hank'k'uwaan aad'd'eeda;</para>
  <para style="q2" vid="PSA 90:9">nu laytsaa itti ooliyaadan wurisseeddo.<verse eid="PSA 90:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10" />Nu de'uwaa laytsay laappun tamma;</para>
  <para style="q2" vid="PSA 90:10">woy minnooppe, hosppun tamma;</para>
  <para style="q2" vid="PSA 90:10">hewekka metuwaanne tugga.</para>
  <para style="q2" vid="PSA 90:10">Nu laytsay ellekka aad'd'ee;</para>
  <para style="q2" vid="PSA 90:10">nuunikka ellekka kichcheetto.<verse eid="PSA 90:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11" />Ne hank'k'uwaa wolk'k'aa eriyaawe oonee?</para>
  <para style="q2" vid="PSA 90:11">ne hank'k'uwaa suuluu yashshiyaawaa.<verse eid="PSA 90:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12" />Hewaa diraw, nu laytsaa bessiyaawaadan,</para>
  <para style="q2" vid="PSA 90:12">go"etana mala aad'd'eeda eraa nuuna tamaarissa.<verse eid="PSA 90:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13" />Abeet Med'inaa Godaw, ne hank'k'uu awude gakkanaassee?</para>
  <para style="q2" vid="PSA 90:13">Hayanaa; ne k'oomatoo k'aretta!<verse eid="PSA 90:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14" />Nu laytsaa ubbaan</para>
  <para style="q2" vid="PSA 90:14">nuuni nashettanaadaaninne yes's'anaadan,</para>
  <para style="q2" vid="PSA 90:14">wontta wontta aggena ne siik'uwaan nuuna kalissa.<verse eid="PSA 90:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15" />Neeni nuuna metoyeedda gallassatuwaa keeshshaanne</para>
  <para style="q2" vid="PSA 90:15">nuuni tuggaa be'eedda laytsatuwaa keeshshaa,</para>
  <para style="q2" vid="PSA 90:15">nuuna nashshechchaa.<verse eid="PSA 90:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16" />Nuw ne k'oomatoo ne oosuu k'onc'c'o;</para>
  <para style="q2" vid="PSA 90:16">ne bonchcho wolk'k'ay unttunttu naanaatoo beetto.<verse eid="PSA 90:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17" />Godaa nu S'oossaa keekkatetsay nu bollan gido;</para>
  <para style="q2" vid="PSA 90:17">nu kushiyaa oosuwaa nuw suurissa.</para>
  <para style="q1" vid="PSA 90:17">Ee, nu kushiyaa oosuwaa suurissa.<verse eid="PSA 90:17" /></para>
  <chapter eid="PSA 90" />
  <chapter number="91" style="c" sid="PSA 91" />
  <para style="s">S'oossay Nuuna Naagiyaawaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 91:1" />Ubbaappe D'ok'k'iyaa S'oossan naagettiide de'iyaawe,</para>
  <para style="q2" vid="PSA 91:1">Ubbaappe Wolk'k'aama S'oossaa kuwaa giddon ak'ee;<verse eid="PSA 91:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2" />Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 91:2">«Neeni taw geessuwaanne bak'ata attiyaa sa'aa;</para>
  <para style="q2" vid="PSA 91:2">neeni taani ammanitsiyaa ta S'oossaa» yaagana.<verse eid="PSA 91:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3" />I neena shankkanchchatuwaa gitiyaappekka,</para>
  <para style="q2" vid="PSA 91:3">wod'i wurssiyaa iita harggiyaappekka ashshana.<verse eid="PSA 91:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4" />I bare baalletuwaan neena kammana;</para>
  <para style="q2" vid="PSA 91:4">Aa k'efetuwaa garssa neeni bak'ataade k'osetta attana.</para>
  <para style="q1" vid="PSA 91:4">Aa ammanettussay new gonddalle.<verse eid="PSA 91:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5" />Neeni k'amma dagantsiyaabaw,</para>
  <para style="q2" vid="PSA 91:5">woy gallassi s'onggettiyaabaw yayakka;<verse eid="PSA 91:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6" />woy d'uman oyk'k'iyaa harggiyaw,</para>
  <para style="q2" vid="PSA 91:6">woy gallassaa seetan wurssiyaa iita harggiyaa hirggakka.<verse eid="PSA 91:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7" />Sha"ay ne miyyiyaan,</para>
  <para style="q2" vid="PSA 91:7">k'ay tammu sha"ay neeppe ushechcha baggana kunddana;</para>
  <para style="q2" vid="PSA 91:7">shin neena ayaynne bochchenna.<verse eid="PSA 91:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8" />Neeni ne ayifiyaa s'alalaan s'eelana;</para>
  <para style="q2" vid="PSA 91:8">iitatuu murettiyaawaakka be'ana.<verse eid="PSA 91:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9" />Med'inaa Godaa neeni new bak'ata attiyaa sa'aa ootseedda dirawunne,</para>
  <para style="q2" vid="PSA 91:9">Ubbaappe D'ok'k'iyaa S'oossaa new,</para>
  <para style="q2" vid="PSA 91:9">de'iyaa sa'aa ootseedda diraw,<verse eid="PSA 91:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10" />iitabay neena bochchenna;</para>
  <para style="q2" vid="PSA 91:10">boshaykka ne golliyaa shiik'enna.<verse eid="PSA 91:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11" />Ayaw gooppe, ne ogiyaan ubbaan</para>
  <para style="q2" vid="PSA 91:11">neena naagana mala,<note caller="-" style="x"><char style="xo" closed="false">91:11 </char><char style="xt" closed="false"><ref loc="MAT 4:6">Mat. 4:6</ref>; <ref loc="LUK 4:10">Luk'. 4:10</ref></char></note></para>
  <para style="q1" vid="PSA 91:11">S'oossay bare kiitanchchatuwaa azazana.<verse eid="PSA 91:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12" />Ne gedii shuchchaan d'ubettenna mala,<note caller="-" style="x"><char style="xo" closed="false">91:12 </char><char style="xt" closed="false"><ref loc="MAT 4:6">Mat. 4:6</ref>; <ref loc="LUK 4:11">Luk'. 4:11</ref></char></note></para>
  <para style="q2" vid="PSA 91:12">kiitanchchatuu barenttu kushiyan neena dentsana.<verse eid="PSA 91:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13" />Neeni gaammuwaanne shooshshaa bollan heemettana;<note caller="-" style="x"><char style="xo" closed="false">91:13 </char><char style="xt" closed="false"><ref loc="LUK 10:19">Luk'. 10:19</ref></char></note></para>
  <para style="q2" vid="PSA 91:13">k'ay wodalla gaammuwaanne wod'iyaa shooshshaa neeni yed'd'ana.<verse eid="PSA 91:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14" />Med'inaa Goday hawaadan yaagee;</para>
  <para style="q2" vid="PSA 91:14">«I taana siik'eedda diraw,</para>
  <para style="q2" vid="PSA 91:14">taani Aa ashshana.</para>
  <para style="q2" vid="PSA 91:14">I ta suntsaa ereedda diraw,</para>
  <para style="q2" vid="PSA 91:14">taani Aa naagana.<verse eid="PSA 91:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15" />I taana s'eegiyaa wode,</para>
  <para style="q2" vid="PSA 91:15">taani aw koyana.</para>
  <para style="q1" vid="PSA 91:15">Metuwaan taani aanana ittippe gidana;</para>
  <para style="q2" vid="PSA 91:15">taani Aa ashshananne bonchchana.<verse eid="PSA 91:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16" />Taani Aa laytsaa adussaade kalissana;</para>
  <para style="q2" vid="PSA 91:16">ta atotetsaa Aa bessana» yaagee.<verse eid="PSA 91:16" /></para>
  <chapter eid="PSA 91" />
  <chapter number="92" style="c" sid="PSA 92" />
  <para style="s">Galataa Mazimuriyaa</para>
  <para style="d">Mazimuriyaa, Sambbata Gallassaw yes's'iyaawaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 92:1" />Med'inaa Godaa galatiyaawe lo"a.</para>
  <para style="q2" vid="PSA 92:1">Abeet Ubbaappe D'ok'k'iyaa S'oossaw,</para>
  <para style="q2" vid="PSA 92:1">ne suntsaa sabbiyaawe lo"a.<verse eid="PSA 92:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2" />Wonttan aggena ne siik'uwaa,</para>
  <para style="q2" vid="PSA 92:2">k'amman ne ammanettiyaawaa gidiyaawaa awaayiyaawe lo"a.<verse eid="PSA 92:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3" />Tammu bak'etsaan waas'etteedda diitsaanne,</para>
  <para style="q2" vid="PSA 92:3">maasink'k'uwaan diis's'iyaawe lo"a.<verse eid="PSA 92:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4" />Ayaw gooppe, Abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 92:4">ne wolk'k'aama oosuwaan</para>
  <para style="q2" vid="PSA 92:4">taana nashechcheedda diraw,</para>
  <para style="q2" vid="PSA 92:4">ne kushiyaa oosuwaa diraw,</para>
  <para style="q2" vid="PSA 92:4">taani nashshechchaw yes's'ay.<verse eid="PSA 92:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5" />Abeet Med'inaa Godaw, ne oosuu ay keeshshaa gitee!</para>
  <para style="q2" vid="PSA 92:5">Ne k'ofay ay keeshshaa c'iimmee!<verse eid="PSA 92:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6" />Eeyya Asay eranaw danddayenna;</para>
  <para style="q2" vid="PSA 92:6">donc'c'illeedda asaykka akeekanaw danddayenna.<verse eid="PSA 92:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7" />Hewenne, iitatuu maataadan dic'c'ooppekka,</para>
  <para style="q2" vid="PSA 92:7">iitaa ootsiyaa ubbatuu daashooppekka,</para>
  <para style="q2" vid="PSA 92:7">unttunttu med'inaw d'ayana.<verse eid="PSA 92:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8" />Shin abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 92:8">neeni med'inaw ubbaappe d'ok'k'a.<verse eid="PSA 92:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9" />Abeet Med'inaa Godaw, ne morkketuu d'ayanawaanne</para>
  <para style="q2" vid="PSA 92:9">iitaa ootsiyaa ubbatuu tiskki gaanawaa nuuni eretto.<verse eid="PSA 92:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10" />Ta kac'iyaa bazzuwaa mentsaa kac'iyaadan d'ok'k'issaadda;</para>
  <para style="q2" vid="PSA 92:10">lo"o zayitiyaa taana okkaadda.<verse eid="PSA 92:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11" />Ta morkketuu s'oonetteeddawaa ta ayifiyaan be'aad;</para>
  <para style="q2" vid="PSA 92:11">ta iita morketuwaa waasuwaa ta haytsaan sisaad.<verse eid="PSA 92:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12" />S'illotuu zambbaadan daashana;</para>
  <para style="q2" vid="PSA 92:12">k'ay Liibaanoosa zigaadan dic'c'ana.<verse eid="PSA 92:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13" />Unttunttukka Med'inaa Godaa dabaaban toketteedda mitsaa mala;</para>
  <para style="q2" vid="PSA 92:13">unttunttu nu S'oossaa Geeshsha Golliyaan daashana.<verse eid="PSA 92:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14" />Unttunttu ec'iidekka ayifana;</para>
  <para style="q2" vid="PSA 92:14">unttunttu med'inaw irs's'anne pas'a.<verse eid="PSA 92:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15" />Unttunttu, «Med'inaa Goday suure;</para>
  <para style="q2" vid="PSA 92:15">I taw wogga zaallaa; iitatetsi aan baawa» yaagana.<verse eid="PSA 92:15" /></para>
  <chapter eid="PSA 92" />
  <chapter number="93" style="c" sid="PSA 93" />
  <para style="s">S'oossay Kaatiyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1" />Med'inaa Goday kaateteedda!</para>
  <para style="q2" vid="PSA 93:1">Med'inaa Goday Bonchchuwaa mayyeedda;</para>
  <para style="q2" vid="PSA 93:1">wolk'k'aa danc'c'eedda.</para>
  <para style="q2" vid="PSA 93:1">Sa'ay minniide ek'k'eedda; ubbakka k'aas's'enna.<verse eid="PSA 93:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2" />Ne kawutetsaa araatay beniideppe ek'k'eedda;</para>
  <para style="q2" vid="PSA 93:2">neeni med'inaadeppe de'aassa.<verse eid="PSA 93:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3" />Abeet Med'inaa Godaw, c'iimmo shaafatuu guummeedda;</para>
  <para style="q2" vid="PSA 93:3">c'iimmo shaafatuu bare guntsaa d'ok'k'u ootseedda.<verse eid="PSA 93:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4" />Saluwaan de'iyaa Med'inaa Goday daro haatsaa guntsaappekka,</para>
  <para style="q2" vid="PSA 93:4">abbaa betatuwaappekka aad'd'eeda wolk'k'aama.<verse eid="PSA 93:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5" />Abeet Med'inaa Godaw, neeni odeeddabay ammanettiyaawaa;</para>
  <para style="q2" vid="PSA 93:5">ne gollii med'inaw geeshshatetsaan aleek'k'ana.<verse eid="PSA 93:5" /></para>
  <chapter eid="PSA 93" />
  <chapter number="94" style="c" sid="PSA 94" />
  <para style="s">S'oossay Ubbaa Bolla Pirddiyaawaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1" />Abeet Med'inaa Godaw, neeni kushiyaa c'igetiyaa S'oossaa.</para>
  <para style="q2" vid="PSA 94:1">Abeet kushiyaa c'igetiyaa S'oossaw, ne bonchchuwaa bessa.<verse eid="PSA 94:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2" />Abeet sa'aa pirddiyaawoo, dendda;</para>
  <para style="q2" vid="PSA 94:2">otoranchchatoo bessiyaa muruwaa imma.<verse eid="PSA 94:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3" />Abeet Med'inaa Godaw, awude gakkanaw gam"anee?</para>
  <para style="q2" vid="PSA 94:3">Iitatuu awude gakkanaw nashettanee?<verse eid="PSA 94:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4" />Iitaa ootsiyaa ubbatuu,</para>
  <para style="q2" vid="PSA 94:4">barenttu otoro k'aalaa haasayiino;</para>
  <para style="q2" vid="PSA 94:4">unttunttu c'eek'ettiino.<verse eid="PSA 94:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5" />Abeet Med'inaa Godaw, unttunttu ne asaa liik'k'issiino;</para>
  <para style="q2" vid="PSA 94:5">ne laattaa naak'k'iino.<verse eid="PSA 94:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6" />Unttunttu am"etuwaanne betetuwaa wod'iino;</para>
  <para style="q2" vid="PSA 94:6">aawuu bayinnawanttakka wod'iino.<verse eid="PSA 94:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7" />Yaatiide unttunttu, «Med'inaa Goday nuuna be'enna;</para>
  <para style="q2" vid="PSA 94:7">Yaak'ooba S'oossay akeekena» yaagiino.<verse eid="PSA 94:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8" />Hinttenoo, asaa giddoppe aad'd'eeda dammatoo, akeekite!</para>
  <para style="q2" vid="PSA 94:8">Hinttenoo eeyyatoo, awude eranchcha gidanitee?<verse eid="PSA 94:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9" />Haytsaa med'eedda S'oossay sisennee?</para>
  <para style="q2" vid="PSA 94:9">Ayifiyaa med'd'eeddawe be'ennee?<verse eid="PSA 94:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10" />Kawutetsaa seeriyaawe murennee?</para>
  <para style="q2" vid="PSA 94:10">Asaa eraa tamaarissiyaawe barew erennee?<note caller="-" style="x"><char style="xo" closed="false">94:10 </char><char style="xt" closed="false"><ref loc="1CO 3:20">1 K'or. 3:20</ref></char></note><verse eid="PSA 94:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11" />Med'inaa Goday asaa k'ofay mela gidiyaawaa eree.<verse eid="PSA 94:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12" />Abeet Med'inaa Godaw, neeni seeriyaawenne</para>
  <para style="q2" vid="PSA 94:12">ne higgiyaappe tamaarissiyaa Asay anjjetteedawaa.<verse eid="PSA 94:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13" />Iitatuu kunddiyaa ollay bookettana gakkanaw,</para>
  <para style="q2" vid="PSA 94:13">metuu gakkiyaa gallassan neeni Aa shemppissaasa.<verse eid="PSA 94:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14" />Med'inaa Goday bare asaa aggena;</para>
  <para style="q2" vid="PSA 94:14">I bare laattaa aggena.<verse eid="PSA 94:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15" />Pirdday simmiide s'illo pirddaa gidanawaa;</para>
  <para style="q2" vid="PSA 94:15">wozanaa suuretuu ubbay he s'illo pirddaa maaddana.<verse eid="PSA 94:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16" />Makkalanchchatuwaa bolla</para>
  <para style="q2" vid="PSA 94:16">ta diraw denddiyaawe oonee?</para>
  <para style="q1" vid="PSA 94:16">Iitaa ootsiyaawanttuna</para>
  <para style="q2" vid="PSA 94:16">ta diraw ek'etteeddawe oonee?<verse eid="PSA 94:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17" />Med'inaa Goday taana maaddennentto,</para>
  <para style="q2" vid="PSA 94:17">taani ellekka duufuwaan gelaade sirp'p'i gaana shin.<verse eid="PSA 94:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18" />Abeet Med'inaa Godaw, taani,</para>
  <para style="q2" vid="PSA 94:18">«Ta gedii halis's'ee» yaageedda wode,</para>
  <para style="q2" vid="PSA 94:18">aggena ne siik'uu taw zemppo gideedda.<verse eid="PSA 94:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19" />Taana hirggay wod'iyaa wode,</para>
  <para style="q2" vid="PSA 94:19">neeni taana woppu ootsaade nashechchaasa.<verse eid="PSA 94:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20" />Higgiyaa baletsiyaa geella daannatuwaana</para>
  <para style="q2" vid="PSA 94:20">neeni zuppetay?<verse eid="PSA 94:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21" />S'illotuwaa wod'anaw unttunttu ittippe tobbetiino;</para>
  <para style="q2" vid="PSA 94:21">suuretuwaa bolla hayk'k'uwaa pirddiino.<verse eid="PSA 94:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22" />Gidooppenne, Med'inaa Goday taani bak'ata atteeda sa'aa;</para>
  <para style="q2" vid="PSA 94:22">ta S'oossay taani k'osettiyaa zaallaa.<verse eid="PSA 94:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23" />Unttunttu iitatetsaa diraw, I unttuntta murana;</para>
  <para style="q2" vid="PSA 94:23">unttunttu nagaraa diraw, I unttuntta d'ayissana;</para>
  <para style="q2" vid="PSA 94:23">ee, Med'inaa Goday nu S'oossay unttuntta d'ayissana.<verse eid="PSA 94:23" /></para>
  <chapter eid="PSA 94" />
  <chapter number="95" style="c" sid="PSA 95" />
  <para style="s">Gallassaa Gallassaa Mazimuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1" />Haayite; ane Med'inaa Godaa sabboytte.</para>
  <para style="q2" vid="PSA 95:1">Nuuna ashshiyaa zaallaw nashshechchaw yes's'oytte.<verse eid="PSA 95:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2" />Aa sintsa galataanna shiik'oytte.</para>
  <para style="q2" vid="PSA 95:2">Galataa yetsaa nashshechchan yes's'oytte.<verse eid="PSA 95:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3" />Ayaw gooppe, Med'inaa Goday wolk'k'aama S'oossaa,</para>
  <para style="q2" vid="PSA 95:3">s'oossatuwaa ubbaa bolla wolk'k'aama kaatiyaa.<verse eid="PSA 95:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4" />Biittaa c'iimmatuu Aa kushiyan de'iino;</para>
  <para style="q2" vid="PSA 95:4">deriyaa huup'etuukka aawaa.<verse eid="PSA 95:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5" />Abbaa haatsaykka aawaa;</para>
  <para style="q2" vid="PSA 95:5">hewaa I med'd'eedda;</para>
  <para style="q2" vid="PSA 95:5">mela biittaakka Aa kushii ootseedda.<verse eid="PSA 95:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6" />Haayite; hokkiide ane aw goyinnoytte;</para>
  <para style="q2" vid="PSA 95:6">nuuna med'd'eedda Med'inaa Godaa sintsan gulbbatoytte.<verse eid="PSA 95:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7" />Ayaw gooppe, I nu S'oossaa.<note caller="-" style="x"><char style="xo" closed="false">95:7-8 </char><char style="xt" closed="false"><ref loc="HEB 3:15">Ibr. 3:15</ref>; <ref loc="HEB 4:7">4:7</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">95:7-11 </char><char style="xt" closed="false"><ref loc="HEB 3:7-11">Ibr. 3:7-11</ref></char></note></para>
  <para style="q2" vid="PSA 95:7">Nuuni Aa k'ooruwaan de'iyaa asatuwaa;</para>
  <para style="q2" vid="PSA 95:7">nuuni I heemmiyaa Aa dorssaa wudetuwaa.</para>
  <para style="b" vid="PSA 95:7" />
  <para style="q2" vid="PSA 95:7">S'oossay hinttena giyaawaa hachchi sisite!<verse eid="PSA 95:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 95:8" />«Kase hintte mayzza aawotuu,</para>
  <para style="q2" vid="PSA 95:8">Mariiba giyaa sa'aan haneeddawaadan,<note caller="-" style="x"><char style="xo" closed="false">95:8 </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">Kes. 17:1-7</ref>; <ref loc="NUM 20:2-13">Pay. 20:2-13</ref></char></note></para>
  <para style="q2" vid="PSA 95:8">he gallassi Maasa Bazzuwaan is's'eeddawaadan,</para>
  <para style="q2" vid="PSA 95:8">hinttekka zoriyaa akkenan is's'oppite.<verse eid="PSA 95:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9" />Unttunttu ta oosuwaa be'iidekka,</para>
  <para style="q2" vid="PSA 95:9">taana ek'k'eteeddinonne paac'c'eeddino.<verse eid="PSA 95:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10" />Taani he yeletaa oytamu laytsaa shaatettaad;</para>
  <para style="q2" vid="PSA 95:10">‹Unttunttu ubbaa wode barenttu wozanaan baliino;</para>
  <para style="q2" vid="PSA 95:10">unttunttu ta ogiyaa eribeykkino yaagaad.<verse eid="PSA 95:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11" />Hewaadankka k'ay, taani hank'k'etta c'aak'k'aade,<note caller="-" style="x"><char style="xo" closed="false">95:11 </char><char style="xt" closed="false"><ref loc="NUM 14:20-23">Pay. 14:20-23</ref>; <ref loc="DEU 1:34-36">Zar. 1:34-36</ref>; <ref loc="DEU 12:9-11">12:9-11</ref>; <ref loc="HEB 4:3-5">Ibr. 4:3-5</ref></char></note></para>
  <para style="q2" vid="PSA 95:11">Unttunttu ta shemppuwaasaa ubbakka gelikkino› yaagaad» yaagee.<verse eid="PSA 95:11" /></para>
  <chapter eid="PSA 95" />
  <chapter number="96" style="c" sid="PSA 96" />
  <para style="s">S'oossay Ubbaappe Bolla Kaatiyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1" />Med'inaa Godaw ooratsa yetsaa yes's'ite;</para>
  <para style="q2" vid="PSA 96:1">sa'aan de'iyaa asay, ubbay Med'inaa Godaw yes's'ite.<verse eid="PSA 96:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2" />Med'inaa Godaw yes's'ite; Aa suntsaa sabbite;</para>
  <para style="q2" vid="PSA 96:2">I ashshiyaa mishiraachchuwaa gallassaan gallassaan odite.<verse eid="PSA 96:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3" />Kawutetsaa giddon Aa bonchchuwaa,</para>
  <para style="q2" vid="PSA 96:3">asaa ubbaa giddon Aa malalissiyaa oosuwaabaa awaayite.<verse eid="PSA 96:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4" />Ayaw gooppe, Med'inaa Goday wolk'k'aama;</para>
  <para style="q2" vid="PSA 96:4">gita galatay aw bessee.</para>
  <para style="q1" vid="PSA 96:4">S'oossatuwaa ubbaappe aad'd'iide I yayettanaw bessee.<verse eid="PSA 96:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5" />Hara asaa s'oossatuu ubbay eek'atuwaa;</para>
  <para style="q2" vid="PSA 96:5">shin Med'inaa Goday salotuwaa med'd'eedda S'oossaa.<verse eid="PSA 96:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6" />Bonchchuunne anggay Aa yuushshuwaan de'ee;</para>
  <para style="q2" vid="PSA 96:6">minotetsaynne puulay Aa Geeshsha Golliyaan de'ee.<verse eid="PSA 96:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7" />Hinttenoo, asaa zaretoo ubbatoo,</para>
  <para style="q2" vid="PSA 96:7">Med'inaa Godaabaa odite;<note caller="-" style="x"><char style="xo" closed="false">96:7-9 </char><char style="xt" closed="false"><ref loc="PSA 29:1-2">Maz. 29:1-2</ref></char></note></para>
  <para style="q1" vid="PSA 96:7">«Bonchchuunne wolk'k'ay Med'inaa Godaassa» giide odite.<verse eid="PSA 96:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8" />«Bonchchuu Aa suntsaassa»</para>
  <para style="q2" vid="PSA 96:8">giide Med'inaa Godaabaa odite.</para>
  <para style="q1" vid="PSA 96:8">Yarshshuwaa akkiide, Aa dabaabaa gelite.<verse eid="PSA 96:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9" />Aa geeshshatetsaa puulan Med'inaa Godaw goyinnite;</para>
  <para style="q2" vid="PSA 96:9">biittan de'iyaa asaa ubbaw, Aa sintsan kokkorite.<verse eid="PSA 96:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10" />Kawutetsatuwaa giddon, «Med'inaa Goday kaateteedda!</para>
  <para style="q2" vid="PSA 96:10">Sa'ay min ek'k'eedda; ubbakka k'aas's'enna.</para>
  <para style="q1" vid="PSA 96:10">I asaa bolla suuretetsan pirddana» yaagite.<verse eid="PSA 96:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11" />Salotuu nashetino; sa'aykka hashshu go;</para>
  <para style="q2" vid="PSA 96:11">abbayinne Aa giddon kumeeddawe guummo.<verse eid="PSA 96:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12" />Shoyk'aynne shoyk'an de'iyaa ubbay nashetto!</para>
  <para style="q2" vid="PSA 96:12">Woran de'iyaa mitsaa ubbaykka nashshechchan Aa sintsan yes's'ana.<verse eid="PSA 96:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 96:13" />Ayaw gooppe, Med'inaa Goday yee;</para>
  <para style="q2" vid="PSA 96:13">I sa'aa bollan pirddanaw yee;</para>
  <para style="q1" vid="PSA 96:13">I ha sa'aa bolla s'illotetsan,</para>
  <para style="q2" vid="PSA 96:13">asaa bollakka tumatetsan pirddana.<verse eid="PSA 96:13" /></para>
  <chapter eid="PSA 96" />
  <chapter number="97" style="c" sid="PSA 97" />
  <para style="s">S'oossay Ubbaappe Bolla</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1" />Med'inaa Goday kawuteedda.</para>
  <para style="q2" vid="PSA 97:1">Sa'aan de'iyaa Asay nashetto;</para>
  <para style="q2" vid="PSA 97:1">haakko haatsaan dooddetto saan de'iyaa asatuukka nashetino.<verse eid="PSA 97:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2" />Shaariinne d'ip'p'i go d'umay Aa dooddeedda.</para>
  <para style="q2" vid="PSA 97:2">S'illotetsaynne tumatetsay Aa kawutetsaa araataw baaso.<verse eid="PSA 97:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3" />Tamay aappe sintsanna bee;</para>
  <para style="q2" vid="PSA 97:3">Aa dooddeedda morkkatuwaa s'uuggee.<verse eid="PSA 97:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4" />Aa walk'k'antsay sa'aa poo'issee;</para>
  <para style="q2" vid="PSA 97:4">biittay hewaa be'iide kokkoree.<verse eid="PSA 97:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5" />Med'inaa Godaa sintsan, sa'aa ubbaa Godaa sintsan</para>
  <para style="q2" vid="PSA 97:5">wogga deretuu eessaa muk'aaddaadan muushiino.<verse eid="PSA 97:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6" />Salotuu Aa s'illotetsaa awaayiino;</para>
  <para style="q2" vid="PSA 97:6">asay ubbay Aa bonchchuwaa be'ee.<verse eid="PSA 97:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7" />Worddo s'oossatoo goyinniyaawanttunne</para>
  <para style="q2" vid="PSA 97:7">he go"enna eek'atuwaan c'eek'ettiyaawanttu ubbay yeellatino.</para>
  <para style="q1" vid="PSA 97:7">S'oossatuu ubbay S'oossaw gulbbatino.<verse eid="PSA 97:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8" />Abeet Med'inaa Godaw, S'iyoone asay,</para>
  <para style="q2" vid="PSA 97:8">ne s'illo pirddaa sisiide nashettee;</para>
  <para style="q1" vid="PSA 97:8">Yihudaa katamatuwaa asaykka hashshu gee.<verse eid="PSA 97:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9" />Abeet Med'inaa Godaw, neeni sa'aa ubbaappe d'ok'k'aasa;</para>
  <para style="q2" vid="PSA 97:9">s'oossatuwaa ubbaappe neeni d'ok'k'u gaasa.<verse eid="PSA 97:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10" />Med'inaa Godaa siik'iyaawanttu iitaa is's'ite.</para>
  <para style="q2" vid="PSA 97:10">I barew amanetiyaa asatuwaa shemppuwaa naagee;</para>
  <para style="q2" vid="PSA 97:10">k'ay unttuntta iitatuwaa kushiyaappe ashshee.<verse eid="PSA 97:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11" />S'illotoo poo'uu poo'ee;</para>
  <para style="q2" vid="PSA 97:11">wozanaa suuretoo nashechchay de'ee.<verse eid="PSA 97:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12" />Hinttenoo s'illotoo, Med'inaa Godaan nashettite;</para>
  <para style="q2" vid="PSA 97:12">Aa geeshsha suntsaa galatite.<verse eid="PSA 97:12" /></para>
  <chapter eid="PSA 97" />
  <chapter number="98" style="c" sid="PSA 98" />
  <para style="s">S'oossay Alamiyaa Mooddiyaawaa</para>
  <para style="d">Mazimuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1" />Med'inaa Godaw ooratsa yetsaa yes's'ite;</para>
  <para style="q2" vid="PSA 98:1">ayaw gooppe, I malalissiyaabaa ootseedda.</para>
  <para style="q1" vid="PSA 98:1">Aa ushechcha kushiinne Aa geeshsha k'eesii</para>
  <para style="q2" vid="PSA 98:1">aw s'oonuwaa immeedda.<verse eid="PSA 98:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2" />Med'inaa Goday bare s'oonuwaa erisseedda;</para>
  <para style="q2" vid="PSA 98:2">I ashshiyaawaa kawutetsatoo k'onc'c'isseedda.<verse eid="PSA 98:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3" />I Israa'eeliyaa soo asaa siik'iyaawaanne</para>
  <para style="q2" vid="PSA 98:3">unttunttoo ammanettiyaawaa hassayeedda.</para>
  <para style="q1" vid="PSA 98:3">Sa'aa gas'aa gakkanaw de'iyaa Asay ubbay</para>
  <para style="q2" vid="PSA 98:3">nu S'oossay ashiyaawaa be'eedda.<verse eid="PSA 98:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4" />Sa'aa bollan de'iyaa asaa ubbay,</para>
  <para style="q1" vid="PSA 98:4">Med'inaa Godaw nashshechchan yes's'ite;</para>
  <para style="q2" vid="PSA 98:4">k'aalaa d'ok'k'u ootsiide, nashshechchaa sabaa sabbite.<verse eid="PSA 98:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5" />Diitsaa Med'inaa Godaw diis's'ite;</para>
  <para style="q2" vid="PSA 98:5">diitsaaninne yetsan S'oossaa sabbite.<verse eid="PSA 98:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6" />S'urumbbaanne lookkuwaa punniidde,</para>
  <para style="q2" vid="PSA 98:6">nashshechchan Med'inaa Godaa nu kaatiyaa sintsan hombboc'ite.<verse eid="PSA 98:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7" />Abbayinne abbaa giddon kumeeddawe ubbay guummo.</para>
  <para style="q2" vid="PSA 98:7">Sa'aynne sa'aa bollan de'iyaa ubbay yes's'o.<verse eid="PSA 98:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8" />Shaafatuu ittippe barenttu kushiyaa bak'k'ino.</para>
  <para style="q2" vid="PSA 98:8">K'eeri deretuu Med'inaa Godaa sintsan ittippe nashshechchan yes's'ino.<verse eid="PSA 98:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9" />Ayaw gooppe, I sa'aa bollan daannatanaw yee.</para>
  <para style="q2" vid="PSA 98:9">I ha sa'aa bolla s'illotetsan,</para>
  <para style="q2" vid="PSA 98:9">asaa bollakka suuretetsan daannatana.<verse eid="PSA 98:9" /></para>
  <chapter eid="PSA 98" />
  <chapter number="99" style="c" sid="PSA 99" />
  <para style="s">S'oossay S'illuwaanne Geeshsha</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1" />Med'inaa Goday kawuteedda!<note caller="-" style="x"><char style="xo" closed="false">99:1 </char><char style="xt" closed="false"><ref loc="EXO 25:22">Kes. 25:22</ref></char></note> Hewoo asatuu kokkorino.</para>
  <para style="q2" vid="PSA 99:1">Kiruubetuwaappe gidduwaan kawutetsaa araataa bolla utteedda;</para>
  <para style="q2" vid="PSA 99:1">hewoo biittay k'aas's'o;<verse eid="PSA 99:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2" />Med'inaa Goday S'iyoonen wolk'k'aama;</para>
  <para style="q2" vid="PSA 99:2">kawutetsaa ubbaappe I d'ok'k'u d'ok'k'u geedda.<verse eid="PSA 99:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3" />Daroppe yashshiyaa Aa wolk'k'aama suntsaa,</para>
  <para style="q2" vid="PSA 99:3">unttunttu ubbay galatino.</para>
  <para style="q1" vid="PSA 99:3">I geeshsha!<verse eid="PSA 99:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4" />Neeni, wolk'k'aama kaatii, likke pirddaa dosaasa.</para>
  <para style="q2" vid="PSA 99:4">Neeni Yaak'ooba asaw suuretetsaa minisaadda.</para>
  <para style="q1" vid="PSA 99:4">S'illotetsaanne likke pirddaa essaadda.<verse eid="PSA 99:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5" />Med'inaa Godaa nu S'oossaa d'ok'k'u d'ok'k'u ootsite;</para>
  <para style="q2" vid="PSA 99:5">Aa gedii yed'd'iyaasaan guufanniide aw goyinnite.</para>
  <para style="q1" vid="PSA 99:5">I geeshsha!<verse eid="PSA 99:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6" />Musenne Aaroone Aa k'esetuwaa gidduwaappe laa"atuwaa;</para>
  <para style="q2" vid="PSA 99:6">Sameelikka Aa suntsan woosseeddawanttuppe ittuwaa.</para>
  <para style="q1" vid="PSA 99:6">Unttunttu Med'inaa Godaw waasseeddino;</para>
  <para style="q2" vid="PSA 99:6">ikka unttunttoo alleeda.<verse eid="PSA 99:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7" />I shaariyaa tuussaa gidduwaana unttunttoo haasayeedda;<note caller="-" style="x"><char style="xo" closed="false">99:7 </char><char style="xt" closed="false"><ref loc="EXO 33:9">Kes. 33:9</ref></char></note></para>
  <para style="q2" vid="PSA 99:7">unttunttu I immeedda higgiyaanne wogaa naageeddino.<verse eid="PSA 99:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8" />Abeet Med'inaa Godaw, nu S'oossaw,</para>
  <para style="q2" vid="PSA 99:8">neeni unttunttu woosaa sisaadda.</para>
  <para style="q1" vid="PSA 99:8">Neeni unttunttu iitatetsaa diraw mureeddawaa gidooppekka,</para>
  <para style="q2" vid="PSA 99:8">unttunttoo atto geedda S'oossaa.<verse eid="PSA 99:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9" />Med'inaa Godaa nu S'oossaa, d'ok'k'u d'ok'k'u ootsite;</para>
  <para style="q2" vid="PSA 99:9">Aa geeshsha deriyaa bollan aw goyinnite;</para>
  <para style="q2" vid="PSA 99:9">ayaw gooppe, Med'inaa Goday nu S'oossay geeshsha!<verse eid="PSA 99:9" /></para>
  <chapter eid="PSA 99" />
  <chapter number="100" style="c" sid="PSA 100" />
  <para style="s">S'oossaa Galatanaadan Shiik'eedda S'eessaa</para>
  <para style="d">Galataa immiyaa mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1" />Sa'aan de'iyaa asaa ubbaw,</para>
  <para style="q2" vid="PSA 100:1">Med'inaa Godaw hintte k'aalaa d'ok'k'u ootsiide yes's'ite.<verse eid="PSA 100:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 100:2" />Med'inaa Godaw nashshechchan ootsite;</para>
  <para style="q2" vid="PSA 100:2">nashshechchaa yetsaanna Aa sintsa shiik'ite.<verse eid="PSA 100:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3" />Med'inaa Goday S'oossaa gidiyaawaa erite;</para>
  <para style="q2" vid="PSA 100:3">nuuna med'd'eeddawe Aa; nuuni aawantta.</para>
  <para style="q1" vid="PSA 100:3">Nuuni Aa asatuwaanne Aa k'ooruwaan de'iyaa dorssatuwaa.<verse eid="PSA 100:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4" />Aa penggiyaa galataana,</para>
  <para style="q2" vid="PSA 100:4">Aa dabaabaa sabaanna gelite;</para>
  <para style="q1" vid="PSA 100:4">Aa galatitenne Aa suntsaa sabbite.<verse eid="PSA 100:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5" />Ayaw gooppe, Med'inaa Goday keeka.<note caller="-" style="x"><char style="xo" closed="false">100:5 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1 Od. 16:34</ref>; <ref loc="2CH 5:13">2 Od. 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Izr. 3:11</ref>; <ref loc="PSA 106:1">Maz. 106:1</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Erm. 33:11</ref></char></note></para>
  <para style="q2" vid="PSA 100:5">Aggena Aa siik'uu med'inaassa;</para>
  <para style="q1" vid="PSA 100:5">I yeletaappe yeletaa gakkanaw ammanettiyaawaa.<verse eid="PSA 100:5" /></para>
  <chapter eid="PSA 100" />
  <chapter number="101" style="c" sid="PSA 101" />
  <para style="s">Kaatii S'oossaw Geliyaa K'aalaa C'aak'uwaa</para>
  <para style="d">Daawita mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1" />Taani aggena siik'uwaabaanne s'illo pirddaabaa yes's'ana;</para>
  <para style="q2" vid="PSA 101:1">abeet Med'inaa Godaw, taani new yes's'ana.<verse eid="PSA 101:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2" />Taani suure ogiyaabaa k'oppana.</para>
  <para style="q2" vid="PSA 101:2">Neeni taakko awude yaan?</para>
  <para style="q1" vid="PSA 101:2">Taani ta golliyaan suuretetsan hamettana.<verse eid="PSA 101:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3" />Taani ta ayifiyaan pokkobaa s'eellikke.</para>
  <para style="q2" vid="PSA 101:3">S'oossaappe wora simmeedda asatuwaa oosuwaa is's'ay;</para>
  <para style="q2" vid="PSA 101:3">unttunttu mulekka taananna gidikkino.<verse eid="PSA 101:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4" />Wozanaa geellatetsay taappe haakko;</para>
  <para style="q2" vid="PSA 101:4">iitatetsaa taani erikke.<verse eid="PSA 101:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5" />Geeman bare shooruwaa zigiriyaawaa,</para>
  <para style="q2" vid="PSA 101:5">taani sirp'p'i ootsana.</para>
  <para style="q1" vid="PSA 101:5">Otorettiyaanne ayyiyaa asaa taani danddaykke.<verse eid="PSA 101:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6" />Unttunttu taananna de'ana mala,</para>
  <para style="q2" vid="PSA 101:6">biittaa bolla de'iyaa ammanettiyaawantta,</para>
  <para style="q2" vid="PSA 101:6">taani keeka ayifiyaan s'eellay.</para>
  <para style="q1" vid="PSA 101:6">Suuretetsan hamettiyaa Asay taw kiitettana.<verse eid="PSA 101:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7" />C'immiyaawe ta golliyaan de'enna;</para>
  <para style="q2" vid="PSA 101:7">wordduwaa haasayiyaawe ta sintsan gam"enna.<verse eid="PSA 101:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8" />Biittan de'iyaa iita asaa ubbaa,</para>
  <para style="q2" vid="PSA 101:8">taani gallassi gallassi d'ayissana;</para>
  <para style="q2" vid="PSA 101:8">iitaa ootsiyaawantta ubbaa,</para>
  <para style="q2" vid="PSA 101:8">taani Med'inaa Godaa katamaappe d'ok'ollana.<verse eid="PSA 101:8" /></para>
  <chapter eid="PSA 101" />
  <chapter number="102" style="c" sid="PSA 102" />
  <para style="s">Metuwaa bolla De'iyaa Asaa Woosaa</para>
  <para style="d">Med'inaa Godaa Sintsaan barena Dogiide Bare Kayyuwaa gussiyaa Wode, Tuggateedda Asay woosseedda woosaa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1" />Abeet Med'inaa Godaw, ta woosaa sisa;</para>
  <para style="q2" vid="PSA 102:1">ta waasuu neekko gakko.<verse eid="PSA 102:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2" />Ta waayiyaa gallassi,</para>
  <para style="q2" vid="PSA 102:2">ne som"uwaa taappe gentsoppa.</para>
  <para style="q1" vid="PSA 102:2">Ne haytsaa taakko yegga;</para>
  <para style="q2" vid="PSA 102:2">taani new waassiyaa wode, taana ellekka alla.<verse eid="PSA 102:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3" />Ayaw gooppe, ta laytsay c'uwaadan d'ayee;</para>
  <para style="q2" vid="PSA 102:3">ta mek'etsaykka tamaa bonk'k'uwaadan ees's'ee.<verse eid="PSA 102:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4" />Ta wozanay shoc'i yeggeedda mela maataadan hanaad;</para>
  <para style="q2" vid="PSA 102:4">k'umaykka taw meetettenna.<verse eid="PSA 102:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5" />Taani ta k'aalaa d'ok'k'u ootsaade oolay;</para>
  <para style="q2" vid="PSA 102:5">ta galbbay mek'etsaanna oyk'k'etteedda.<verse eid="PSA 102:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6" />Taani bazzuwaan de'iyaa ankkuwaa mala,</para>
  <para style="q2" vid="PSA 102:6">woy koleteedda golliyaan de'iyaa guttuwaa mala.<verse eid="PSA 102:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7" />Taani gisina, gem"ishuu yeenna;</para>
  <para style="q2" vid="PSA 102:7">taani golliyaa huup'iyaan barekka utteedda kafuwaa mala.<verse eid="PSA 102:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8" />Ta morkketuu gallassaa ubbaan taana c'ashiino;</para>
  <para style="q2" vid="PSA 102:8">taana k'iliic'iyaawanttu ta suntsan shek'iino.<verse eid="PSA 102:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9" />Taani bidintsaa k'umaadan may;</para>
  <para style="q2" vid="PSA 102:9">k'ay ta afotsaa ta ushshaanna walakkay.<verse eid="PSA 102:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10" />Neeni taana pude dentsaade,</para>
  <para style="q2" vid="PSA 102:10">ne hank'k'uwaa diraw wora olaadda.<verse eid="PSA 102:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11" />Ta de'uwaa laytsay omarssa kuwaa mala;</para>
  <para style="q2" vid="PSA 102:11">taani maataadan shulay.<verse eid="PSA 102:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12" />Shin abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 102:12">neeni kawutetsaa araatan med'inaw uttaadda;</para>
  <para style="q2" vid="PSA 102:12">ne suntsaykka yeletaappe yeletaa gakkanaw hassayettana.<verse eid="PSA 102:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13" />Neeni denddaade, S'iyoonew k'aretta;</para>
  <para style="q2" vid="PSA 102:13">ayaw gooppe, neeni izo maariyaa wodii gakkeedda;</para>
  <para style="q2" vid="PSA 102:13">hawe neeni dooreedda wodiyaa.<verse eid="PSA 102:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14" />Iza koletteeddawaa gidooppekka,</para>
  <para style="q2" vid="PSA 102:14">ne k'oomatuu izo siik'iino.</para>
  <para style="q1" vid="PSA 102:14">Iza bayeeddawaa gidooppekka,</para>
  <para style="q2" vid="PSA 102:14">unttunttu iziw k'arettiino.<verse eid="PSA 102:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15" />Kawutetsatuu Med'inaa Godaa suntsaw yayana;</para>
  <para style="q2" vid="PSA 102:15">sa'aa kaatetuu ubbay Aa anggaw dagamana.<verse eid="PSA 102:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16" />Ayaw gooppe, Med'inaa Goday S'iyoone zaaretsi kees's'iide,</para>
  <para style="q2" vid="PSA 102:16">I bare gitatetsaa bessana.<verse eid="PSA 102:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17" />I puteesatuwaa woosaa sisana;</para>
  <para style="q2" vid="PSA 102:17">unttunttu waasuwaa kad'enna.<verse eid="PSA 102:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18" />Biro yelettana asatuu Med'inaa Godaa galatana mala,</para>
  <para style="q2" vid="PSA 102:18">hawe yiyaa yeletaw s'aafetto.<verse eid="PSA 102:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19" />Med'inaa Goday d'ok'k'an de'iyaa bare geeshsha sa'aappe duge s'eelleedda;</para>
  <para style="q2" vid="PSA 102:19">I saluwaappe duge sa'aa s'omooseedda.<verse eid="PSA 102:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20" />Hewenne, k'ashetteedda asatuwaa ooliyaa sisanaassanne</para>
  <para style="q2" vid="PSA 102:20">hayk'k'oo pirddetteedda asatuwaa billanaassa.<verse eid="PSA 102:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21" />Hewaa diraw, Med'inaa Godaa suntsay S'iyoonen odettananne</para>
  <para style="q2" vid="PSA 102:21">Aa galatay Yerusaalamen awaayetana.<verse eid="PSA 102:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22" />Asaynne kawutetsay ittippe shiik'iide,</para>
  <para style="q2" vid="PSA 102:22">Med'inaa Godaw he wode goyinnana.<verse eid="PSA 102:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23" />I taani yalagatetsan de'iina,</para>
  <para style="q2" vid="PSA 102:23">ta wolk'k'aa wursseedda;</para>
  <para style="q2" vid="PSA 102:23">ta laytsaa k'antsayeedda.<verse eid="PSA 102:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24" />Yaatina, taani, «Abeet ta S'oossaw,</para>
  <para style="q2" vid="PSA 102:24">ta laytsay biro giddottiyaa wode,</para>
  <para style="q2" vid="PSA 102:24">taana afoppa» yaagay.</para>
  <para style="b" vid="PSA 102:24" />
  <para style="q2" vid="PSA 102:24">Abeet S'oossaw, neeni yeletaappe yeletaa gakkanaw de'aassa.<verse eid="PSA 102:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25" />Neeni beni sa'aa med'd'aadda;<note caller="-" style="x"><char style="xo" closed="false">102:25-27 </char><char style="xt" closed="false"><ref loc="HEB 1:10-12">Ibr. 1:10-12</ref></char></note></para>
  <para style="q2" vid="PSA 102:25">saluukka ne kushiyaa oosuwaa.<verse eid="PSA 102:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26" />Hewanttu ubbay d'ayana; shin neeni de'ana;</para>
  <para style="q2" vid="PSA 102:26">unttunttu ubbaykka afilaadan wurana.</para>
  <para style="q1" vid="PSA 102:26">Neeni unttuntta c'urk'k'a afilaadan laammana;</para>
  <para style="q2" vid="PSA 102:26">unttunttukka aad'd'ana.<verse eid="PSA 102:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27" />Shin neeni neenakka; ne laytsay ubbaa wurenna.<verse eid="PSA 102:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28" />Nuuni ne k'oomatuwaa;</para>
  <para style="q2" vid="PSA 102:28">nu naanatuu sarotetsaan de'ana.</para>
  <para style="q1" vid="PSA 102:28">Unttunttu zeretsaykka ne sintsan minniide ek'k'ana.<verse eid="PSA 102:28" /></para>
  <chapter eid="PSA 102" />
  <chapter number="103" style="c" sid="PSA 103" />
  <para style="s">S'oossaa Siik'uwaa</para>
  <para style="d">Daawite s'aafeeddawaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1" />Ta shemppattee, Med'inaa Godaa galataa!</para>
  <para style="q2" vid="PSA 103:1">Ta kumentsaa asatetsaw, Aa geeshsha suntsaa galataa.<verse eid="PSA 103:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2" />Ta shemppattee, Med'inaa Godaa galataa!</para>
  <para style="q2" vid="PSA 103:2">I new ootseedda keekkatetsaa ubbaa dogoppa.<verse eid="PSA 103:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3" />I ne nagaraa ubbaa atto gee;</para>
  <para style="q2" vid="PSA 103:3">I ne harggiyaa ubbaappe neena patsee.<verse eid="PSA 103:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4" />I neena duufuwaan gelennaadan ashshee;</para>
  <para style="q2" vid="PSA 103:4">aggena siik'uwaaninne maarotaan neena anjjee.<verse eid="PSA 103:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5" />Arggantsaadan neeni yalagana mala,</para>
  <para style="q2" vid="PSA 103:5">I ne de'uwaa ubbaan neena lo"obaa kalissee.<verse eid="PSA 103:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6" />Med'inaa Goday naak'etteeddawanttoo</para>
  <para style="q2" vid="PSA 103:6">s'illobaa ootseenne suuriyaan pirddee.<verse eid="PSA 103:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7" />I bare ogiyaa Musa,</para>
  <para style="q2" vid="PSA 103:7">bare oosuwaa Israa'eeliyaa asaw erisseedda.<verse eid="PSA 103:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8" />Med'inaa Goday k'arettiyaawaanne maariyaawaa;<note caller="-" style="x"><char style="xo" closed="false">103:8 </char><char style="xt" closed="false"><ref loc="JAS 5:11">Yak'. 5:11</ref></char></note></para>
  <para style="q2" vid="PSA 103:8">I hank'k'ettanaw elleellennawaanne</para>
  <para style="q2" vid="PSA 103:8">aggena siik'uu daruwaa.<verse eid="PSA 103:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9" />I ubbaa gede seerenna; med'inaw hank'k'ettenna.<verse eid="PSA 103:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10" />I nuuna nu nagaraadan ootsibeenna;</para>
  <para style="q2" vid="PSA 103:10">nu iitatetsaadan nuw zaaribeenna.<verse eid="PSA 103:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11" />Saluu sa'aappe d'ok'k'iyaawaadan,</para>
  <para style="q2" vid="PSA 103:11">Med'inaa Godaw yayyiyaawanttoo aggena Aa siik'uu dara.<verse eid="PSA 103:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12" />Away doliyaasaappe away wulliyaasay haakkiyaawaadan,</para>
  <para style="q2" vid="PSA 103:12">Med'inaa Goday nu bayzzuwaa nuuppe haassee.<verse eid="PSA 103:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13" />Aawuu bare naanaatoo k'arettiyaawaadan,</para>
  <para style="q2" vid="PSA 103:13">Med'inaa Goday barew yayyiyaawanttoo k'arettee.<verse eid="PSA 103:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14" />Ayaw gooppe, nuuni ayaappe med'etteeddentto I eree;</para>
  <para style="q2" vid="PSA 103:14">nuuni biittaa gidiyaawaa I akeekee.<verse eid="PSA 103:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15" />Asaa gidooppe, Aa de'uu maataa mala;</para>
  <para style="q2" vid="PSA 103:15">I bazzuwaa c'iishshaadan c'iishshee;<verse eid="PSA 103:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16" />c'arkkuu Aa bolla c'arkkina d'ayeedda;</para>
  <para style="q2" vid="PSA 103:16">I doleedda sa'ay erettenna.<verse eid="PSA 103:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17" />Shin Med'inaa Godaw yayyiyaawanttoo,</para>
  <para style="q2" vid="PSA 103:17">aggena Aa siik'uu med'inaappe med'inaa gakkanaassa.</para>
  <para style="q1" vid="PSA 103:17">Aa s'illotetsaykka na'aa na'aw gakkanaassa.<verse eid="PSA 103:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18" />Aa c'aak'uwaa naagiyaawanttussanne</para>
  <para style="q2" vid="PSA 103:18">Aa azazuwaa polanaw hassayiyaawanttussa.<verse eid="PSA 103:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19" />Med'inaa Goday salotuwaan bare kawutetsaa araataa esseedda;</para>
  <para style="q2" vid="PSA 103:19">Aa kawutetsay ubbaa mooddee.<verse eid="PSA 103:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20" />Hinttenoo, Aa kiitanchchatoo,</para>
  <para style="q2" vid="PSA 103:20">Aa azazuwaa poliyaa wolk'k'aamatoo,</para>
  <para style="q1" vid="PSA 103:20">I giyaawaa sisisiyaawantto,</para>
  <para style="q2" vid="PSA 103:20">Med'inaa Godaa galatite!<verse eid="PSA 103:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21" />Hinttenoo saluwaan de'iyaa minotoo,</para>
  <para style="q2" vid="PSA 103:21">Aa sheniyaa ootsiyaa k'oomatoo,</para>
  <para style="q1" vid="PSA 103:21">Med'inaa Godaa galatite!<verse eid="PSA 103:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22" />Hinttenoo,</para>
  <para style="q2" vid="PSA 103:22">I mooddiyaa sa'aa ubbaa med'etatoo,</para>
  <para style="q2" vid="PSA 103:22">ubbaykka Med'inaa Godaa galatite!</para>
  <para style="b" vid="PSA 103:22" />
  <para style="q2" vid="PSA 103:22">Ta shemppattee, Med'inaa Godaa galataa!<verse eid="PSA 103:22" /></para>
  <chapter eid="PSA 103" />
  <chapter number="104" style="c" sid="PSA 104" />
  <para style="s">S'oossaw Shiik'iyaa Galataa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1" />Ta shemppattee, Med'inaa Godaa galataa!</para>
  <para style="q2" vid="PSA 104:1">Abeet Med'inaa Godaw ta S'oossaw, neeni ay keeshshaa gitee!</para>
  <para style="q1" vid="PSA 104:1">Neeni bonchchuwaanne anggaa mayyaadda.<verse eid="PSA 104:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2" />Poo'uwaa afilaadan gullotaadda.</para>
  <para style="q2" vid="PSA 104:2">Neeni saluwaa dunkkaaniyaadan tolaadda.<verse eid="PSA 104:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 104:3" />Ne golliyaa saluwaa guufantsuwaa bollan kees's'aasa.</para>
  <para style="q2" vid="PSA 104:3">Shaariyaa paraa gaariyaa kessaasa;</para>
  <para style="q2" vid="PSA 104:3">c'arkkuwaa k'efiyaan toggaasa.<verse eid="PSA 104:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4" />Neeni c'arkkotuwaa ne kiitanchchaa,<note caller="-" style="x"><char style="xo" closed="false">104:4 </char><char style="xt" closed="false"><ref loc="HEB 1:7">Ibr. 1:7</ref></char></note></para>
  <para style="q2" vid="PSA 104:4">tamaa lac'uwaakka ne k'ooma kessaasa.<verse eid="PSA 104:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5" />Neeni sa'aa Aa baasuwaa bolla essaadda;</para>
  <para style="q2" vid="PSA 104:5">I med'i med'inawukka k'aas's'enna.<verse eid="PSA 104:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6" />Wolk'k'aama abbay biittaa bollan afilaadan mic'etteedda;</para>
  <para style="q2" vid="PSA 104:6">haatsay wolk'k'aama deretuwaa kammeedda.<verse eid="PSA 104:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7" />Shin ne godetina haatsatuu bak'ateeddino;</para>
  <para style="q2" vid="PSA 104:7">ne azazuwaa sisiide, elleelleeddino.<verse eid="PSA 104:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8" />Unttunttu wogga deretuwaappe duge zanggaaraa,</para>
  <para style="q2" vid="PSA 104:8">neeni unttunttoo giigiseedda sa'aa goggeeddino.<verse eid="PSA 104:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9" />Haatsatuu simmiide biittaa kammennaadan,</para>
  <para style="q2" vid="PSA 104:9">unttunttu aad'd'anaw danddayenna zawaa essaadda.<verse eid="PSA 104:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10" />Neeni pulttotuwaa zanggaaraan pulttissaasa;</para>
  <para style="q2" vid="PSA 104:10">unttunttu haatsay deretuwaa gidduwaana goggee.<verse eid="PSA 104:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11" />Goggiyaawaappe bazzuwaa do'atuu ubbay ushiino;</para>
  <para style="q2" vid="PSA 104:11">denbbaa haretuu barenttu saamuwaa aappe aliino.<verse eid="PSA 104:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12" />Saluwaa kafotuu he haatsaa matan barenttu golliyaa kees's'iide,</para>
  <para style="q2" vid="PSA 104:12">tashiyaa giddon yes's'iino.<verse eid="PSA 104:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13" />Neeni wolk'k'aama deretuwaa bollan</para>
  <para style="q2" vid="PSA 104:13">saluwaappe iraa bukissaasa;</para>
  <para style="q2" vid="PSA 104:13">biittakka ne kushiyaa oosuwaa ayifiyaan kalissaasa.<verse eid="PSA 104:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14" />Neeni mehiyaw maataa,</para>
  <para style="q2" vid="PSA 104:14">asaw katsaa mokissaasa.</para>
  <para style="q1" vid="PSA 104:14">Hewenne, Asay biittaa ootsiide,</para>
  <para style="q2" vid="PSA 104:14">biittaappe katsaa demanaassa.<verse eid="PSA 104:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 104:15" />Asaa wozanaa nashechchiyaa woyniyaa,</para>
  <para style="q2" vid="PSA 104:15">som"uwaa shic'issiyaa zayitiyaanne</para>
  <para style="q2" vid="PSA 104:15">wolk'k'aa kuntsiyaa k'umaa mokissaassa.<verse eid="PSA 104:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16" />Med'inaa Godaa mitsatuu,</para>
  <para style="q2" vid="PSA 104:16">I tokkeedda Liibaanoosa zigatuu,</para>
  <para style="q2" vid="PSA 104:16">daro iraa ushiino.<verse eid="PSA 104:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17" />Unttunttun kafotuu barenttu golliyaa kees's'iino;</para>
  <para style="q2" vid="PSA 104:17">k'oolletuukka s'iidaa bolla kees's'iide de'iino.<verse eid="PSA 104:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18" />D'ok'k'a deretuwaa bollan gaaratuu de'iino;</para>
  <para style="q2" vid="PSA 104:18">k'ay guppalletuu Shuchchaa gonggoluwaan k'osettiino.<verse eid="PSA 104:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19" />Wodiyaa payduwaa erissana mala,</para>
  <para style="q2" vid="PSA 104:19">neeni aginaa med'd'aadda.</para>
  <para style="q1" vid="PSA 104:19">Away bare wulliyaa wodiyaa eree.<verse eid="PSA 104:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20" />Neeni k'ammaa med'd'aadda;</para>
  <para style="q2" vid="PSA 104:20">d'uman do'ay ubbay kesee.<verse eid="PSA 104:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21" />Wodalla gaammotuu shankkatiidde gudiino;</para>
  <para style="q2" vid="PSA 104:21">unttunttu barenttoo miyaawaa S'oossaappe koyiino.<verse eid="PSA 104:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22" />Away kesiyaa wode,</para>
  <para style="q2" vid="PSA 104:22">guyye simmiide barenttu geessuwaan gisiino.<verse eid="PSA 104:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23" />He wode Asay bare oosoo kesee;</para>
  <para style="q2" vid="PSA 104:23">sa'ay k'ammana gakkanaw ootsee.<verse eid="PSA 104:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24" />Abeet Med'inaa Godaw, ne oosuu ay keeshshaa daree!</para>
  <para style="q2" vid="PSA 104:24">Ne aad'd'eeda eratetsan neeni unttunttu ubbaa med'd'aadda;</para>
  <para style="q2" vid="PSA 104:24">sa'ay neeni med'd'eeddawan kumeedda.<verse eid="PSA 104:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25" />Abbay hinin hewesh; I wolk'k'aamanne aakko;</para>
  <para style="q2" vid="PSA 104:25">payduu bayinna k'aas's'iyaa med'etatuwaan,</para>
  <para style="q2" vid="PSA 104:25">gitatuwaaninne guutsatuwaan kumiide de'ee.<verse eid="PSA 104:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26" />Hewaa bollan markkabatuu biino;<note caller="-" style="x"><char style="xo" closed="false">104:26 </char><char style="xt" closed="false"><ref loc="JOB 41:1">Yob. 41:1</ref>; <ref loc="PSA 74:14">Maz. 74:14</ref>; <ref loc="ISA 27:1">Isa. 27:1</ref></char></note></para>
  <para style="q2" vid="PSA 104:26">k'ay neeni med'd'eedda Leewaataana giyaa dawii an kaa'ee.<verse eid="PSA 104:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27" />Neeni unttuntta koshshiyaa wodiyaan</para>
  <para style="q2" vid="PSA 104:27">unttunttoo k'umaa immana mala,</para>
  <para style="q2" vid="PSA 104:27">unttunttu ubbay neena s'eelliino.<verse eid="PSA 104:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28" />Neeni unttunttoo immina, unttunttu mas'iino;</para>
  <para style="q2" vid="PSA 104:28">neeni ne kushiyaappe yeggina,</para>
  <para style="q2" vid="PSA 104:28">unttunttu lo"obaa kalliino.<verse eid="PSA 104:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29" />Neeni ne som"uwaa gentsiyaa wode dagammiino.</para>
  <para style="q2" vid="PSA 104:29">Ne shemppuwaa neeni akkiyaa wode hayk'k'iide,</para>
  <para style="q2" vid="PSA 104:29">barenttu biittaw simmiino.<verse eid="PSA 104:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30" />Shin neeni ne shemppuwaa kiittiyaa wode,</para>
  <para style="q2" vid="PSA 104:30">haratuu med'ettiino; biittaakka ooratsaasa.<verse eid="PSA 104:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31" />Med'inaa Godaa bonchchuu med'inaw de'o;</para>
  <para style="q2" vid="PSA 104:31">Med'inaa Goday bare oosuwaan nashetto.<verse eid="PSA 104:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32" />I biittaa s'eellina, biittay k'aas's'ee;</para>
  <para style="q2" vid="PSA 104:32">k'ay I deretuwaa bochchina, deretuu c'uwattiino.<verse eid="PSA 104:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33" />Taani ta de'uwaa ubbaan Med'inaa Godaw yes's'ana;</para>
  <para style="q2" vid="PSA 104:33">taani de'eedda laytsaa ubbaan ta S'oossaa sabbana.<verse eid="PSA 104:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34" />Taani Med'inaa Godaan nashettiyaa diraw,</para>
  <para style="q2" vid="PSA 104:34">ta k'ofay Aa nashechcho.<verse eid="PSA 104:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35" />Nagaranchchatuu biittaappe d'ayino;</para>
  <para style="q2" vid="PSA 104:35">hawaappe sintsaw iitatuu de'oppino.</para>
  <para style="b" vid="PSA 104:35" />
  <para style="q1" vid="PSA 104:35">Ta shemppattee, Med'inaa Godaa galataa! Med'inaa Godaa galatite!<verse eid="PSA 104:35" /></para>
  <chapter eid="PSA 104" />
  <chapter number="105" style="c" sid="PSA 105" />
  <para style="s">Maalalisiyaa Israa'eeliyaa Taarikiyaa</para>
  <para style="r">(<ref loc="1CH 16:8-22">1 Od. 16:8-22</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1" />Med'inaa Godaa galatite; Aa suntsaa s'eesite.</para>
  <para style="q2" vid="PSA 105:1">I ootseeddawaa kawutetsatuwaa gidduwaan erissite.<verse eid="PSA 105:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2" />Aa sabbite; galataa yetsaa aw yes's'ite.</para>
  <para style="q2" vid="PSA 105:2">Aa malalissiyaa oosuwaa ubbabaa odite.<verse eid="PSA 105:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3" />Aa geeshsha suntsan c'eek'ettite;</para>
  <para style="q2" vid="PSA 105:3">Med'inaa Godaa koyiyaa wozanatuu nashetino.<verse eid="PSA 105:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4" />Med'inaa Godaanne Aa wolk'k'aa s'omoosite;</para>
  <para style="q2" vid="PSA 105:4">ubbaa gede Aa sintsa koyite.<verse eid="PSA 105:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 105:5" />I ootseedda malalissiyaabaa,</para>
  <para style="q2" vid="PSA 105:5">Aa malaataanne I pirddeedda pirddaa hassayite.<verse eid="PSA 105:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 105:6" />Hinttenoo,</para>
  <para style="q2" vid="PSA 105:6">Aa k'oomaa Abrahaama zeretsatoo,</para>
  <para style="q2" vid="PSA 105:6">dooretteedda Yaak'ooba naatoo.<verse eid="PSA 105:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7" />I Med'inaa Godaa nu S'oossaa;</para>
  <para style="q2" vid="PSA 105:7">Aa tumo pirddaykka sa'aa ubbaa bollaanna.<verse eid="PSA 105:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8" />I bare c'aak'uwaa med'inaw,</para>
  <para style="q2" vid="PSA 105:8">bare azazeedda k'aalaa sha"u yeletaa gakkanaw naagee.<verse eid="PSA 105:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9" />Hewenne, I, Abrahaamana c'aak'k'eteedda c'aak'uwaa,<note caller="-" style="x"><char style="xo" closed="false">105:9 </char><char style="xt" closed="false"><ref loc="GEN 12:7">Dom. 12:7</ref>; <ref loc="GEN 17:8">17:8</ref>; <ref loc="GEN 26:3">26:3</ref></char></note></para>
  <para style="q2" vid="PSA 105:9">Yisaak'aw c'aak'k'eedda c'aak'uwaa,<verse eid="PSA 105:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10" />Yaak'oobaw woga,<note caller="-" style="x"><char style="xo" closed="false">105:10-11 </char><char style="xt" closed="false"><ref loc="GEN 28:13">Dom. 28:13</ref></char></note></para>
  <para style="q2" vid="PSA 105:10">Israa'eeliyawukka med'inaa c'aak'uwaa</para>
  <para style="q2" vid="PSA 105:10">ootsiide miniseedda.<verse eid="PSA 105:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11" />Hawaadan yaageedda;</para>
  <para style="q2" vid="PSA 105:11">«New Kanaane biittaa immana;</para>
  <para style="q1" vid="PSA 105:11">I ne zeretsatoo laata gidana» yaageedda.<verse eid="PSA 105:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12" />S'oossaa asatuu payduwaan s'ii guutsanne</para>
  <para style="q2" vid="PSA 105:12">Kanaane biittan bete gidiide de'iyaa wode,<verse eid="PSA 105:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13" />itti gadiyaappe hara gadiyaa,</para>
  <para style="q2" vid="PSA 105:13">itti kawutetsaappe hara kawutetsaa yuuyyeeddino.<verse eid="PSA 105:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14" />S'oossay unttuntta ooninne naak'k'anaw immibeenna;<note caller="-" style="x"><char style="xo" closed="false">105:14-15 </char><char style="xt" closed="false"><ref loc="GEN 20:3-7">Dom. 20:3-7</ref></char></note></para>
  <para style="q2" vid="PSA 105:14">unttunttu diraw kaatetuwaa seeriidde,<verse eid="PSA 105:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15" />«Taani okkeeddawantta bochchoppite;</para>
  <para style="q2" vid="PSA 105:15">ta timbbitiyaa odiyaawantta k'ohoppite» yaageedda.<verse eid="PSA 105:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16" />S'oossay biittan koshaa yeddiide,<note caller="-" style="x"><char style="xo" closed="false">105:16 </char><char style="xt" closed="false"><ref loc="GEN 41:53-57">Dom. 41:53-57</ref></char></note></para>
  <para style="q2" vid="PSA 105:16">unttunttu katsaa ubbaa d'ayisseedda.<verse eid="PSA 105:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17" />Shin I bare asaa ashshanaw,<note caller="-" style="x"><char style="xo" closed="false">105:17 </char><char style="xt" closed="false"><ref loc="GEN 37:28">Dom. 37:28</ref>; <ref loc="GEN 45:5">45:5</ref></char></note></para>
  <para style="q2" vid="PSA 105:17">itti bitaniyaa Gibs'e kiitteedda;</para>
  <para style="q2" vid="PSA 105:17">he bitanii ayille gidiide zal"eteedda Yooseefa.<verse eid="PSA 105:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18" />Aa gedetuu birataan k'ashetteeddino;<note caller="-" style="x"><char style="xo" closed="false">105:18-19 </char><char style="xt" closed="false"><ref loc="GEN 39:20-40:23">Dom. 39:20—40:23</ref></char></note></para>
  <para style="q2" vid="PSA 105:18">unttunttu Aa sanssalatan k'achcheeddino.<verse eid="PSA 105:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19" />I kase odeeddawe polettana gakkanaw,</para>
  <para style="q2" vid="PSA 105:19">Med'inaa Godaa k'aalay Aa paac'c'eedda.<verse eid="PSA 105:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20" />Gibs'e kaatii kiittiide k'asho golliyaappe keseedda,<note caller="-" style="x"><char style="xo" closed="false">105:20 </char><char style="xt" closed="false"><ref loc="GEN 41:14">Dom. 41:14</ref></char></note></para>
  <para style="q2" vid="PSA 105:20">Gadiyaa mooddiyaawe billeedda.<verse eid="PSA 105:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21" />Ikka, Aa bare golliyaw godaa ootseeddanne.<note caller="-" style="x"><char style="xo" closed="false">105:21 </char><char style="xt" closed="false"><ref loc="GEN 41:39-41">Dom. 41:39-41</ref></char></note></para>
  <para style="q2" vid="PSA 105:21">Barew de'iyaawaa ubbaa bolla suntseedda.<verse eid="PSA 105:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22" />Barew waanna kaappotuwaa azazana malanne</para>
  <para style="q2" vid="PSA 105:22">bare c'imatuwaa zorana mala maatayeedda.<verse eid="PSA 105:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23" />Hewaappe guyyiyaan, Israa'eelii Gibs'e geleedda,<note caller="-" style="x"><char style="xo" closed="false">105:23 </char><char style="xt" closed="false"><ref loc="GEN 46:6">Dom. 46:6</ref>; <ref loc="GEN 47:11">47:11</ref></char></note></para>
  <para style="q2" vid="PSA 105:23">Yayk'k'oobe Kaame biittan bete gidiide de'eedda.<verse eid="PSA 105:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24" />Med'inaa Goday bare asaa daro c'orayeedda;<note caller="-" style="x"><char style="xo" closed="false">105:24-25 </char><char style="xt" closed="false"><ref loc="EXO 1:7-14">Kes. 1:7-14</ref></char></note></para>
  <para style="q2" vid="PSA 105:24">unttunttu morkkatuwaappe unttuntta aatsiide mintsetsee.<verse eid="PSA 105:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25" />I Gibs'e Asay bare asaa is's'anaadaaninne</para>
  <para style="q2" vid="PSA 105:25">bare k'oomatuwaa c'immanaadan ootseedda.<verse eid="PSA 105:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26" />Hewaappe guyyiyaan, bare k'oomaa Musanne<note caller="-" style="x"><char style="xo" closed="false">105:26 </char><char style="xt" closed="false"><ref loc="EXO 3:1-4:17">Kes. 3:1—4:17</ref></char></note></para>
  <para style="q2" vid="PSA 105:26">bare dooreedda Aaroona unttunttukko kiitteedda.<verse eid="PSA 105:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27" />Unttunttu Gibs'e asatuwaa sintsan S'oossaa malaataa,</para>
  <para style="q2" vid="PSA 105:27">Kaame biittan ooratsabaa ootseeddino.<verse eid="PSA 105:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28" />S'oossay d'umaa kiittiide,<note caller="-" style="x"><char style="xo" closed="false">105:28 </char><char style="xt" closed="false"><ref loc="EXO 10:21-23">Kes. 10:21-23</ref></char></note></para>
  <para style="q2" vid="PSA 105:28">he biittaa d'umisseedda;</para>
  <para style="q2" vid="PSA 105:28">shin Gibs'e asatuu Aa azazuwaa is's'eeddino.<verse eid="PSA 105:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29" />I Unttunttu haatsaa suutsaw laammiide,<note caller="-" style="x"><char style="xo" closed="false">105:29 </char><char style="xt" closed="false"><ref loc="EXO 7:17-21">Kes. 7:17-21</ref></char></note></para>
  <para style="q2" vid="PSA 105:29">moletuwaa wod'eedda.<verse eid="PSA 105:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30" />Unttunttu biittaa ubbaa,<note caller="-" style="x"><char style="xo" closed="false">105:30 </char><char style="xt" closed="false"><ref loc="EXO 8:1-6">Kes. 8:1-6</ref></char></note></para>
  <para style="q2" vid="PSA 105:30">kaatiyaa golliyaakka shed'd'ii kumeedda.<verse eid="PSA 105:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31" />I azazina, uduns's'iinne biinnii<note caller="-" style="x"><char style="xo" closed="false">105:31 </char><char style="xt" closed="false"><ref loc="EXO 8:16-17">Kes. 8:16-17</ref>, <ref loc="EXO 8:20-24">20-24</ref></char></note></para>
  <para style="q2" vid="PSA 105:31">unttunttu biittaa ubbaa bolla sham"isham"eedda.<verse eid="PSA 105:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32" />Unttunttu biittaa bollan iraa diraw</para>
  <para style="q2" vid="PSA 105:32">shachchaa walk'k'antsaanna bukisseedda.<note caller="-" style="x"><char style="xo" closed="false">105:32-33 </char><char style="xt" closed="false"><ref loc="EXO 9:22-25">Kes. 9:22-25</ref></char></note><verse eid="PSA 105:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33" />I unttunttu woyniyaa turaanne</para>
  <para style="q2" vid="PSA 105:33">balasiyaa giyaa mitsaa shoc'eedda;</para>
  <para style="q2" vid="PSA 105:33">unttunttu biittan de'iyaa mitsaakka kinchchereetseedda.<verse eid="PSA 105:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34" />I azazina, booliinne</para>
  <para style="q2" vid="PSA 105:34">payduu bayinna bumbburetsay keseedda.<note caller="-" style="x"><char style="xo" closed="false">105:34-35 </char><char style="xt" closed="false"><ref loc="EXO 10:12-15">Kes. 10:12-15</ref></char></note><verse eid="PSA 105:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35" />Unttunttu biittan doleedda katsaa ubbaa meedda;</para>
  <para style="q2" vid="PSA 105:35">sa'aappe irs's'abaa ubbaakka mi d'ayisseedda.<verse eid="PSA 105:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36" />S'oossay Gibs'e asatuwaa golle bayira naanatuwaa ubbaa wod'eedda;<note caller="-" style="x"><char style="xo" closed="false">105:36 </char><char style="xt" closed="false"><ref loc="EXO 12:29">Kes. 12:29</ref></char></note></para>
  <para style="q2" vid="PSA 105:36">koyiro yeletteedda ubbaa d'ayisseedda.<verse eid="PSA 105:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37" />Hewaappe guyyiyaan, I Israa'eeliyaa asaa</para>
  <para style="q2" vid="PSA 105:37">work'k'aanne biraa alleek'k'uwaana kesseedda;<note caller="-" style="x"><char style="xo" closed="false">105:37-38 </char><char style="xt" closed="false"><ref loc="EXO 12:33-36">Kes. 12:33-36</ref></char></note></para>
  <para style="q2" vid="PSA 105:37">unttunttu giddoppe kunddiide atteedawe ooninne baawa.<verse eid="PSA 105:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38" />Gibs'e asatuu unttunttoo daro yayyeedda diraw,</para>
  <para style="q2" vid="PSA 105:38">unttunttu keseeddawaan nashetteeddino.<verse eid="PSA 105:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39" />S'oossay unttuntta kammanaw shaariyaa mic'c'eedda;<note caller="-" style="x"><char style="xo" closed="false">105:39 </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">Kes. 13:21-22</ref></char></note></para>
  <para style="q2" vid="PSA 105:39">k'amma unttunttoo poo'issanaw tamaa giigisseedda.<verse eid="PSA 105:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40" />Unttunttu miyaawaa oochchina,</para>
  <para style="q2" vid="PSA 105:40">akkaa malatiyaa kafotuwaa unttunttoo yeddeedda;<note caller="-" style="x"><char style="xo" closed="false">105:40 </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">Kes. 17:1-7</ref>; <ref loc="NUM 20:2-13">Pay. 20:2-13</ref></char></note></para>
  <para style="q2" vid="PSA 105:40">unttuntta saluwaa k'umaa kalisseedda.<verse eid="PSA 105:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41" />I shuchchaa p'alk'k'ina,</para>
  <para style="q2" vid="PSA 105:41">haatsay pultteedda;</para>
  <para style="q2" vid="PSA 105:41">shaafaadan bazzuwaan goggeedda.<verse eid="PSA 105:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42" />I bare k'oomaa Abrahaamaw,</para>
  <para style="q2" vid="PSA 105:42">geleedda geeshsha k'aalaa hassayeedda.<verse eid="PSA 105:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43" />I bare asaa nashshechchan,</para>
  <para style="q2" vid="PSA 105:43">bare dooreeddawantta ililssan kesseedda.<verse eid="PSA 105:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44" />I unttunttoo hara asatuwaa biittaa immeedda;<note caller="-" style="x"><char style="xo" closed="false">105:44 </char><char style="xt" closed="false"><ref loc="JOS 11:16-23">Iya. 11:16-23</ref></char></note></para>
  <para style="q2" vid="PSA 105:44">unttunttu haratuu daabureedda goshshaa laatteeddino.<verse eid="PSA 105:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45" />Hewaa I ootseeddawe unttunttu Aa wogaa</para>
  <para style="q2" vid="PSA 105:45">naaganaadaananne Aa higgiyaa ootsanaadaana.</para>
  <para style="b" vid="PSA 105:45" />
  <para style="q1" vid="PSA 105:45">Med'inaa Godaa galatite!<verse eid="PSA 105:45" /></para>
  <chapter eid="PSA 105" />
  <chapter number="106" style="c" sid="PSA 106" />
  <para style="s">S'oossay Bare Asaw Bessiyaa Keekatetsaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1" />Med'inaa Godaa galatite!<note caller="-" style="x"><char style="xo" closed="false">106:1 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1 Od. 16:34</ref>; <ref loc="2CH 5:13">2 Od. 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Izr. 3:11</ref>; <ref loc="PSA 100:5">Maz. 100:5</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Erm. 33:11</ref></char></note></para>
  <para style="q2" vid="PSA 106:1">I keeka gidiyaa dirawunne,</para>
  <para style="q2" vid="PSA 106:1">aggena Aa siik'uu med'inaawaa gidiyaa diraw,</para>
  <para style="q2" vid="PSA 106:1">Med'inaa Godaa galatite.<verse eid="PSA 106:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2" />Med'inaa Goday ootseedda wolk'k'aama oosuwaa odanaw,</para>
  <para style="q2" vid="PSA 106:2">woy Aa galataa ubbaa k'onc'c'issanaw, danddayiyaawe oonee?<verse eid="PSA 106:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3" />Pirddaa naagiyaawanttunne,</para>
  <para style="q2" vid="PSA 106:3">ubbaa gede s'illobaa ootsiyaawanttu anjjetteeddawantta.<verse eid="PSA 106:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4" />Abeet Med'inaa Godaw, neeni ne asaw keekkiyaa wode,</para>
  <para style="q2" vid="PSA 106:4">taanakka k'oppa;</para>
  <para style="q2" vid="PSA 106:4">unttuntta neeni ashshiyaa wode,</para>
  <para style="q2" vid="PSA 106:4">tawukka alla.<verse eid="PSA 106:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5" />Hewenne, ne dooreedda asaw,</para>
  <para style="q2" vid="PSA 106:5">sa'ay lo"ina, taani be'anaadaana;</para>
  <para style="q2" vid="PSA 106:5">ne asaa nashshechchaa taanikka nashettanaadaaninne</para>
  <para style="q2" vid="PSA 106:5">newanttunna ittippe taanikka galatanaadaana.<verse eid="PSA 106:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6" />Nuuni nu aawotuwaadan nagaraa ootseeddo;</para>
  <para style="q2" vid="PSA 106:6">bayzzobaanne iitabaa ootseeddo.<verse eid="PSA 106:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7" />Nu aawotuu Gibs'en de'iyaa wode,</para>
  <para style="q2" vid="PSA 106:7">ne malalissiyaa oosuwaa k'oppibeykkino.<note caller="-" style="x"><char style="xo" closed="false">106:7 </char><char style="xt" closed="false"><ref loc="EXO 14:10-12">Kes. 14:10-12</ref></char></note></para>
  <para style="q1" vid="PSA 106:7">Aggena ne siik'uwaa darotetsaa unttunttu hassayibeykkino;</para>
  <para style="q2" vid="PSA 106:7">Zo'o Abbaa lank'k'iyaan ne bolla makkaleeddino.<verse eid="PSA 106:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8" />Gidooppekka I bare suntsaa diraw,</para>
  <para style="q2" vid="PSA 106:8">bare wolk'k'aama wolk'k'aa erissanaw unttuntta ashsheeda.<verse eid="PSA 106:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9" />I Zo'o Abbaa azazina, abbay meleedda;<note caller="-" style="x"><char style="xo" closed="false">106:9-12 </char><char style="xt" closed="false"><ref loc="EXO 14:21-31">Kes. 14:21-31</ref></char></note></para>
  <para style="q2" vid="PSA 106:9">bazzuwaan kaaletsiyaawaadan,</para>
  <para style="q2" vid="PSA 106:9">c'iimmaa gidduwaana unttuntta kaaletsiide pintseedda.<verse eid="PSA 106:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10" />I unttuntta is's'iyaawanttu kushiyaappe ashsheeda;</para>
  <para style="q2" vid="PSA 106:10">morkkatuwaa kushiyaappe unttuntta wozeedda.<verse eid="PSA 106:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11" />Unttunttu morkkatuwaa haatsay mitteedda;</para>
  <para style="q2" vid="PSA 106:11">unttunttuppe ittuunne attibeena.<verse eid="PSA 106:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12" />He wode Israa'eelatuu Aa k'aalaa ammaneeddino;<note caller="-" style="x"><char style="xo" closed="false">106:12 </char><char style="xt" closed="false"><ref loc="EXO 15:1-21">Kes. 15:1-21</ref></char></note></para>
  <para style="q2" vid="PSA 106:12">Aa sabbeeddino.<verse eid="PSA 106:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13" />Gidooppenne, unttunttu I ootseeddawaa</para>
  <para style="q2" vid="PSA 106:13">ellekka dogeeddino.</para>
  <para style="q1" vid="PSA 106:13">Aa zoriyaa naagennan barenttu koyeeddawaa ootseeddino.<verse eid="PSA 106:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14" />Bazzuwaan de'iiddi, unttunttu</para>
  <para style="q2" vid="PSA 106:14">daroppe amotteeddino;<note caller="-" style="x"><char style="xo" closed="false">106:14-15 </char><char style="xt" closed="false"><ref loc="NUM 11:4-34">Pay. 11:4-34</ref></char></note></para>
  <para style="q2" vid="PSA 106:14">k'ay mela biittaan S'oossaa paac'c'eeddino.<verse eid="PSA 106:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15" />Hewaadan I unttunttu woosseeddawaa immeedda;</para>
  <para style="q2" vid="PSA 106:15">shin unttunttu shemppoo gilk'k'atetsaa kiitteedda.<verse eid="PSA 106:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16" />Asatuu bazzuwaan barenttu dunkkaaniyaan de'iiddi,</para>
  <para style="q2" vid="PSA 106:16">Musanne Med'inaa Godaw dummateedda,</para>
  <para style="q2" vid="PSA 106:16">k'oomaa Aaroona k'anaateedda wode,<note caller="-" style="x"><char style="xo" closed="false">106:16-18 </char><char style="xt" closed="false"><ref loc="NUM 16:1-35">Pay. 16:1-35</ref></char></note><verse eid="PSA 106:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17" />biittay dooyettiide Daataana mitteedda;</para>
  <para style="q2" vid="PSA 106:17">Abiiraam Aa golliyaa asatuwaana moogeedda.<verse eid="PSA 106:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18" />K'ay unttunttu maabaraa giddon tamay ees's'ina,</para>
  <para style="q2" vid="PSA 106:18">lac'uu he iita asatuwaa s'uuggeedda.<verse eid="PSA 106:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19" />Koreeba Deriyan de'iiddi,</para>
  <para style="q2" vid="PSA 106:19">work'k'aa muushisiide maraa misiliyaa med'd'eeddino;<note caller="-" style="x"><char style="xo" closed="false">106:19-23 </char><char style="xt" closed="false"><ref loc="EXO 32:1-14">Kes. 32:1-14</ref></char></note></para>
  <para style="q2" vid="PSA 106:19">he misiliyaw goyinneeddino.<verse eid="PSA 106:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20" />Unttunttu barenttu bonchcho S'oossaa</para>
  <para style="q2" vid="PSA 106:20">maataa miyaa miizzaa misiliyaan laammeeddino.<verse eid="PSA 106:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21" />Unttunttu barena ashsheeda S'oossaa dogeeddino;</para>
  <para style="q2" vid="PSA 106:21">I Gibs'en wolk'k'aama oosuwaa,<verse eid="PSA 106:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22" />Kaame biittan malalissiyaabaanne,</para>
  <para style="q2" vid="PSA 106:22">Zo'o Abban, «Hoola!» giissiyaabaa ootseedda.<verse eid="PSA 106:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23" />Hewaa diraw, S'oossay unttuntta d'ayissana geedda;</para>
  <para style="q2" vid="PSA 106:23">shin d'ayissenna mala, Aa hank'k'uwaa zaaranaw,</para>
  <para style="q1" vid="PSA 106:23">S'oossay dooreedda Muse gidduwaan ek'k'eedda.<verse eid="PSA 106:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24" />Hewaappe guyyiyaan, unttunttu</para>
  <para style="q2" vid="PSA 106:24">Aa k'aalaa ammanenna diraw,</para>
  <para style="q2" vid="PSA 106:24">he lo"o biittaa kad'eeddino.<note caller="-" style="x"><char style="xo" closed="false">106:24-26 </char><char style="xt" closed="false"><ref loc="NUM 14:1-35">Pay. 14:1-35</ref></char></note><verse eid="PSA 106:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25" />Unttunttu barenttu dunkkaaniyaa giddon</para>
  <para style="q2" vid="PSA 106:25">zuuzummeeddinonne</para>
  <para style="q1" vid="PSA 106:25">Med'inaa Godaa k'aalaw azazettibeykkino.<verse eid="PSA 106:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26" />Hewaa diraw, I unttuntta bazzuwaan agganawaa,</para>
  <para style="q2" vid="PSA 106:26">Bare kushiyaa dentsiide c'aak'k'eedda.<verse eid="PSA 106:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27" />Unttunttu zeretsaa kawutetsatuwaa giddon agganawunne</para>
  <para style="q2" vid="PSA 106:27">biittan unttuntta laalanaw c'aak'k'eedda.<note caller="-" style="x"><char style="xo" closed="false">106:27 </char><char style="xt" closed="false"><ref loc="LEV 26:33">Wog. 26:33</ref></char></note><verse eid="PSA 106:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28" />Hewaappe guyyiyaan, unttunttu Pa'ooran de'iyaa Ba'aala eek'aw,</para>
  <para style="q2" vid="PSA 106:28">goyinniyaawanttunna ittippe gakketeeddino;<note caller="-" style="x"><char style="xo" closed="false">106:28-31 </char><char style="xt" closed="false"><ref loc="NUM 25:1-13">Pay. 25:1-13</ref></char></note></para>
  <para style="q2" vid="PSA 106:28">shemppuu bayinna eek'atoo yarshshetteedda yarshshuwaa meeddino.<verse eid="PSA 106:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29" />Unttunttu barenttu oosuwaan Med'inaa Godaa hank'k'etseeddino;</para>
  <para style="q2" vid="PSA 106:29">unttunttu giddon iita harggii wod'd'eedda.<verse eid="PSA 106:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30" />Shin Piinhaasi denddiide,</para>
  <para style="q2" vid="PSA 106:30">unttunttu bayzzuwaa pirddina,</para>
  <para style="q2" vid="PSA 106:30">iita harggii unttunttu bollaappe kichcheedda.<verse eid="PSA 106:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31" />Hewenne, yeletaappe yeletaa gakkanaw,</para>
  <para style="q2" vid="PSA 106:31">med'inaw aw s'illotetsaa gidiide paydeteedda.<verse eid="PSA 106:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32" />Mariiba pulttuwaa matan Med'inaa Godaa hank'k'etseeddino;<note caller="-" style="x"><char style="xo" closed="false">106:32-33 </char><char style="xt" closed="false"><ref loc="NUM 20:2-13">Pay. 20:2-13</ref></char></note></para>
  <para style="q2" vid="PSA 106:32">unttunttu gaasuwaan Muse bolla metuu gakkeedda.<verse eid="PSA 106:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33" />Ayaw gooppe, unttunttu Aa hank'k'etseeddino;</para>
  <para style="q2" vid="PSA 106:33">Muse doonaappe bessena k'aalay keseedda.<verse eid="PSA 106:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34" />Med'inaa Goday d'ayissite giina,</para>
  <para style="q2" vid="PSA 106:34">unttunttu Kanaane asatuwaa d'ayissibeykkino.<note caller="-" style="x"><char style="xo" closed="false">106:34-36 </char><char style="xt" closed="false"><ref loc="JDG 2:1-3">Dat. 2:1-3</ref>; <ref loc="JDG 3:5-6">3:5-6</ref></char></note><verse eid="PSA 106:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35" />Hewaappekka, unttunttu he asatuwaana</para>
  <para style="q2" vid="PSA 106:35">geletti akkettiide, walaketteeddinonne;</para>
  <para style="q2" vid="PSA 106:35">unttunttu de'uwaa wogaa kaalleeddino.<verse eid="PSA 106:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36" />S'oossaa asatuu unttunttu eek'aw goyinneeddino;</para>
  <para style="q2" vid="PSA 106:36">hewenne, unttunttoo p'ire gideedda.<verse eid="PSA 106:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37" />Unttunttu barenttu attumanne mac'c'a naanatuwaa</para>
  <para style="q2" vid="PSA 106:37">s'alahetoo yarshsheeddino.<note caller="-" style="x"><char style="xo" closed="false">106:37 </char><char style="xt" closed="false"><ref loc="2KI 17:17">2 Kat. 17:17</ref></char></note><verse eid="PSA 106:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38" />Unttunttu, s'illo suutsaa</para>
  <para style="q2" vid="PSA 106:38">Kanaane eek'atoo yarshsheeddino;</para>
  <para style="q2" vid="PSA 106:38">barenttu attumanne mac'c'a naanatuwaa suutsaa gusseeddino;<note caller="-" style="x"><char style="xo" closed="false">106:38 </char><char style="xt" closed="false"><ref loc="NUM 35:33">Pay. 35:33</ref></char></note></para>
  <para style="q2" vid="PSA 106:38">he suutsan biittay tuneedda.<verse eid="PSA 106:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39" />Hewaadan unttunttu barenttu oosuwaan tuneeddinonne,</para>
  <para style="q2" vid="PSA 106:39">sharmus'aadan unttunttu barenttu S'oossaw ammanettennan is's'eeddino.<verse eid="PSA 106:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40" />Hewaa diraw, Med'inaa Godaa hank'k'uu,</para>
  <para style="q2" vid="PSA 106:40">Aa asaa bolla ees's'i keseedda;<note caller="-" style="x"><char style="xo" closed="false">106:40-46 </char><char style="xt" closed="false"><ref loc="JDG 2:14-18">Dat. 2:14-18</ref></char></note></para>
  <para style="q1" vid="PSA 106:40">I barewantta sheneteedda.<verse eid="PSA 106:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41" />I unttuntta hara gadiyaa asatuwaa kushiyan aatsiide immeedda;</para>
  <para style="q2" vid="PSA 106:41">unttunttu is's'eeddawanttu unttuntta mooddeeddino.<verse eid="PSA 106:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42" />Unttunttu morkketuu unttuntta naak'k'eeddinonne</para>
  <para style="q2" vid="PSA 106:42">barenttu sheniyaadan ayisseedino.<verse eid="PSA 106:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43" />I unttuntta daro gede ashsheedda;</para>
  <para style="q2" vid="PSA 106:43">shin unttunttu makkalaw danc'c'i denddeeddino;</para>
  <para style="q2" vid="PSA 106:43">barenttu nagaraa gaasuwaan d'ayeeddino.<verse eid="PSA 106:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44" />Gidooppenne, I unttunttu waasseedda waasuwaa sisiide,</para>
  <para style="q2" vid="PSA 106:44">unttunttu waayiyaa k'oppeedda.<verse eid="PSA 106:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45" />I unttunttu diraw, bare c'aak'uwaa hassayeedda;</para>
  <para style="q2" vid="PSA 106:45">aggena bare siik'uwaa daruwaadan unttuntta maareedda.<verse eid="PSA 106:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46" />Unttuntta omoodeedda ubbay unttunttoo k'arettanaadan ootseedda.<verse eid="PSA 106:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47" />Abeet Med'inaa Godaw, nu S'oossaw, nuuna ashsha.<note caller="-" style="x"><char style="xo" closed="false">106:47-48 </char><char style="xt" closed="false"><ref loc="1CH 16:35-36">1 Od. 16:35-36</ref></char></note></para>
  <para style="q2" vid="PSA 106:47">Nuuni ne geeshsha suntsaa galatanaadaaninne</para>
  <para style="q2" vid="PSA 106:47">ne bonchchuwaan c'eek'ettanaadan,</para>
  <para style="q2" vid="PSA 106:47">kawutetsatuwaa giddoppe nuuna shiishsha.<verse eid="PSA 106:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48" />Med'inaa Goday, Israa'eeliyaa S'oossay</para>
  <para style="q2" vid="PSA 106:48">med'inaappe med'inaa gakkanaw galatetto!</para>
  <para style="q1" vid="PSA 106:48">Asay ubbay, «Amen"i!» go.</para>
  <para style="b" vid="PSA 106:48" />
  <para style="q2" vid="PSA 106:48">Med'inaa Godaa galatite!<verse eid="PSA 106:48" /></para>
  <chapter eid="PSA 106" />
  <chapter number="107" style="c" sid="PSA 107" />
  <para style="ms">Ichcheshentso Mas'aafaa</para>
  <para style="mr">(<ref loc="PSA 107-150">107—150</ref>)</para>
  <para style="s">Metuwaa Ubbaappe Ashiyaa S'oossaa Galatite</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1" />Med'inaa Godaa galatite!<note caller="-" style="x"><char style="xo" closed="false">107:1 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1 Od. 16:34</ref>; <ref loc="2CH 5:13">2 Od. 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Izr. 3:11</ref>; <ref loc="PSA 100:5">Maz. 100:5</ref>; <ref loc="PSA 106:1">106:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Erm. 33:11</ref></char></note> Ayaw gooppe,</para>
  <para style="q2" vid="PSA 107:1">I keeka; aggena Aa siik'uu med'inaassa.<verse eid="PSA 107:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2" />Med'inaa Goday ashsheedawanttunne,</para>
  <para style="q2" vid="PSA 107:2">morkkatuwaa kushiyaappe wozeeddawanttu,</para>
  <para style="q2" vid="PSA 107:2">hewaadan giide haasayino.<verse eid="PSA 107:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3" />Unttuntta I biittatuwaappe,</para>
  <para style="q2" vid="PSA 107:3">away doliyaasaappenne wulliyaasaappe,</para>
  <para style="q2" vid="PSA 107:3">huup'issanne gedissa baggappe</para>
  <para style="q2" vid="PSA 107:3">shiishsheeddawantta.<verse eid="PSA 107:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4" />Unttunttuppe ittuu ittuu bazzuwaa biittan yuuyyeeddino.</para>
  <para style="q2" vid="PSA 107:4">Barenttu de'iyaa katamaa biyaa ogiyaa,</para>
  <para style="q2" vid="PSA 107:4">demmanaw danddayibeykkino.<verse eid="PSA 107:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5" />Unttunttu koshateeddinonne saametteeddino;</para>
  <para style="q2" vid="PSA 107:5">unttunttu yibbaateeddino.<verse eid="PSA 107:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6" />Unttunttu metooteedda wode,</para>
  <para style="q2" vid="PSA 107:6">Med'inaa Godaw waasseeddino;</para>
  <para style="q1" vid="PSA 107:6">I unttuntta unttunttu waayiyaappe ashsheeda.<verse eid="PSA 107:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7" />Unttunttu de'ana katamaa gakkanaw,</para>
  <para style="q2" vid="PSA 107:7">I unttuntta sitta ogiyaanna kaaletseedda.<verse eid="PSA 107:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8" />Aggena Aa siik'oonne,</para>
  <para style="q2" vid="PSA 107:8">I asaw ootseedda malalissiyaabaw,</para>
  <para style="q2" vid="PSA 107:8">unttunttu Med'inaa Godaa galatino.<verse eid="PSA 107:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9" />Ayaw gooppe, I saametteeddawantta alee;</para>
  <para style="q2" vid="PSA 107:9">Koshatteeddawanttakka lo"obaa kalissee.<verse eid="PSA 107:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10" />Unttunttuppe ittuu ittuu</para>
  <para style="q2" vid="PSA 107:10">d'ip'p'i go d'umaa giddon utteeddino;</para>
  <para style="q1" vid="PSA 107:10">Unttunttu birataa sanssalatan waayetteeddino.<verse eid="PSA 107:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11" />Ayaw gooppe, unttunttu S'oossaa k'aalaw makkaleeddinonne,</para>
  <para style="q2" vid="PSA 107:11">Ubbaappe D'ok'k'iyaa S'oossaa zoriyaa kad'eeddino.<verse eid="PSA 107:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12" />I unttuntta tugga oosuwaan daabursseedda;</para>
  <para style="q2" vid="PSA 107:12">unttunttu kunddeeddino;</para>
  <para style="q2" vid="PSA 107:12">shin unttuntta maaddiyaawe d'ayeedda.<verse eid="PSA 107:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13" />Unttunttu metooteedda wode, Med'inaa Godaw waasseeddino;</para>
  <para style="q2" vid="PSA 107:13">I unttuntta unttunttu waayiyaappe ashsheedda.<verse eid="PSA 107:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14" />Bareto d'umaappekka kesseedda;</para>
  <para style="q2" vid="PSA 107:14">unttunttu k'ashetteedda birataa sanssalataakka duutseedda.<verse eid="PSA 107:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15" />Aggena Aa siik'oonne</para>
  <para style="q2" vid="PSA 107:15">I asaw ootseedda malalissiyaawoo</para>
  <para style="q2" vid="PSA 107:15">unttunttu Med'inaa Godaa galatino.<verse eid="PSA 107:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16" />Ayaw gooppe, I nahaasiyaappe oosetteedda penggiyaa mentseedda;</para>
  <para style="q2" vid="PSA 107:16">Birataa kulbbuwaakka d'ukkeedda.<verse eid="PSA 107:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17" />Unttunttuppe ittuu ittuu booza gideeddino;</para>
  <para style="q2" vid="PSA 107:17">Barenttu ootseedda nagaraa gaasuwaaninne,</para>
  <para style="q2" vid="PSA 107:17">barenttu iitatetsaa gaasuwaan tuggateeddino.<verse eid="PSA 107:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18" />Unttunttu k'uma ubbaa shenetiide,</para>
  <para style="q2" vid="PSA 107:18">hayk'k'oo mateeddino.<verse eid="PSA 107:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19" />Unttunttu metooteedda wode, Med'inaa Godaw waasseeddino;</para>
  <para style="q2" vid="PSA 107:19">I unttuntta unttunttu waayiyaappe ashsheeda.<verse eid="PSA 107:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20" />I bare k'aalaa kiittiide, unttuntta patseedda;</para>
  <para style="q2" vid="PSA 107:20">duufuwaan geliyaawaappe ashsheeda.<verse eid="PSA 107:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21" />Aggena Aa siik'oonne</para>
  <para style="q2" vid="PSA 107:21">I asaw ootseedda malalissiyaawoo</para>
  <para style="q2" vid="PSA 107:21">unttunttu Med'inaa Godaa galatino.<verse eid="PSA 107:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22" />Unttunttu aw galataa yarshshuwaa yarshshino;</para>
  <para style="q2" vid="PSA 107:22">K'ay nashshechchaa yetsan I ootseeddawaa odino.<verse eid="PSA 107:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23" />Unttunttuppe ittuu ittuu,</para>
  <para style="q2" vid="PSA 107:23">markkabiyaan wolk'k'aama abbaa bollan beeddino.</para>
  <para style="q1" vid="PSA 107:23">Unttunttu he wolk'k'aama abbaa bolla barenttu oosuwaa ootsiyaawantta.<verse eid="PSA 107:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24" />Unttunttu Med'inaa Godaa oosuwaa,</para>
  <para style="q2" vid="PSA 107:24">I c'iimmaa garssan ootseedda malalissiyaabaa be'eeddino.<verse eid="PSA 107:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25" />I azaziide, gotiyaa dentseedda;</para>
  <para style="q2" vid="PSA 107:25">abbaa hobbii k'aas's'eedda.<verse eid="PSA 107:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26" />Unttunttu pude saluwaa c'ugudetteeddino;</para>
  <para style="q2" vid="PSA 107:26">hewaappe duge c'iimmaa wod'd'eeddino.</para>
  <para style="q1" vid="PSA 107:26">He iita metuu gakkina, unttunttu wozanay toyyu geedda.<verse eid="PSA 107:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27" />Unttunttu matsotteedda asaadan</para>
  <para style="q2" vid="PSA 107:27">d'ubettiide ganddigaareeddino;</para>
  <para style="q2" vid="PSA 107:27">unttunttu eraykka jolleedda.<verse eid="PSA 107:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28" />Unttunttu metooteedda wode, Med'inaa Godaw waasseeddino;</para>
  <para style="q2" vid="PSA 107:28">I unttuntta unttunttu waayiyaappe ashsheeda.<verse eid="PSA 107:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29" />I gotiyaa c'o"u ootseedda;</para>
  <para style="q2" vid="PSA 107:29">abbaa beetaakka sirp'p'i ootseedda.<verse eid="PSA 107:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30" />C'o"u geedda diraw,</para>
  <para style="q2" vid="PSA 107:30">unttunttu nashetteeddino;</para>
  <para style="q1" vid="PSA 107:30">S'oossay unttuntta unttunttu amotteedda katamaa aheedda.<verse eid="PSA 107:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31" />Aggena Aa siik'oonne</para>
  <para style="q2" vid="PSA 107:31">I asaw ootseedda malalissiyaabaw</para>
  <para style="q2" vid="PSA 107:31">unttunttu Med'inaa Godaa galatino.<verse eid="PSA 107:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32" />Unttunttu Aa asatuwaa shiik'uwaan d'ok'k'u d'ok'k'u ootsino;</para>
  <para style="q2" vid="PSA 107:32">k'ay c'imatuwaa shiik'uwaan Aa galatino.<verse eid="PSA 107:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33" />S'oossay shaafatuwaa melisseedda;</para>
  <para style="q2" vid="PSA 107:33">pulttotuukka goggennaadan te"eedda.<verse eid="PSA 107:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34" />Hewan de'iyaa asatuwaa iitatetsaa diraw,</para>
  <para style="q1" vid="PSA 107:34">Mokkiyaa aradda biittaakka,</para>
  <para style="q2" vid="PSA 107:34">mokkenna mela biittaw laammeedda.<verse eid="PSA 107:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35" />I zaariide mela bazzuwaan haatsay eellanaadan,</para>
  <para style="q2" vid="PSA 107:35">k'ay mela biittan pulttuu d'uuk'k'anaadan ootseedda.<verse eid="PSA 107:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36" />Kosheteeddawantta he sa'aan wotseedda;</para>
  <para style="q2" vid="PSA 107:36">unttunttu barenttoo de'iyaa katamaa kees's'eeddino.<verse eid="PSA 107:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37" />Unttunttu barenttu goshshan zeriide,</para>
  <para style="q2" vid="PSA 107:37">woyniyaa tokkiide,</para>
  <para style="q2" vid="PSA 107:37">daro murutaa shiishsheeddino.<verse eid="PSA 107:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38" />I unttuntta anjjina, unttunttu loytsi c'oratteeddino;</para>
  <para style="q2" vid="PSA 107:38">unttunttu mehiyaakka guutsibeenna.<verse eid="PSA 107:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39" />Asatuu s'oonettiyaa wodenne unttunttu uk'k'unnaa,</para>
  <para style="q2" vid="PSA 107:39">metuwaanne kayyuwaa gaasuwaan kawushiyaa wode,<verse eid="PSA 107:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40" />S'oossay kaappotuwaa kad'eeddawaa bessee;</para>
  <para style="q2" vid="PSA 107:40">ogii bayinna bazzuwaan toyilakattanaadan I unttuntta ootsee.<verse eid="PSA 107:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41" />Shin I hiyyeesatuwaa tuggaappe kessiide,</para>
  <para style="q2" vid="PSA 107:41">unttunttu golle asaa dorssaa wudiyaadan c'orayee.<verse eid="PSA 107:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42" />Suure asatuu I ootsiyaawaa be'iide nashettiino;</para>
  <para style="q2" vid="PSA 107:42">shin iita asatuu ubbay c'o"u giino.<verse eid="PSA 107:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43" />Aad'd'eeda Eranchcha gidiyaawe ha yewuwaa k'oppo;</para>
  <para style="q2" vid="PSA 107:43">Med'inaa Godaa aggena siik'uwaa akeeko.<verse eid="PSA 107:43" /></para>
  <chapter eid="PSA 107" />
  <chapter number="108" style="c" sid="PSA 108" />
  <para style="s">Wontta Sabaanne Galataa</para>
  <para style="d">Daawita mazamuriyaa, yetsaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1" />Abeet S'oossaw, ta wozanay minniide de'ee.</para>
  <para style="q2" vid="PSA 108:1">Taani new ta kumentsaa wozanaappe yes's'ananne neena sabbana.<verse eid="PSA 108:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2" />Diitsawunne maasink'k'oo beegottite!</para>
  <para style="q2" vid="PSA 108:2">Taanikka wontta guuraanna beegottana.<verse eid="PSA 108:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3" />Abeet Med'inaa Godaw, taani neena asaa giddon galatana;</para>
  <para style="q2" vid="PSA 108:3">k'ay kawutetsaa giddon neena sabbana.<verse eid="PSA 108:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4" />Ayaw gooppe, aggena ne siik'uu wolk'k'aama;</para>
  <para style="q2" vid="PSA 108:4">saluwaappe bollaw aad'd'ee.</para>
  <para style="q1" vid="PSA 108:4">Ne tumatetsaykka bolla shaariyaadan d'ok'k'ee.<verse eid="PSA 108:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5" />Abeet S'oossaw, salotuwaappe bollaanna</para>
  <para style="q2" vid="PSA 108:5">d'ok'k'u d'ok'k'u ga!</para>
  <para style="q1" vid="PSA 108:5">Ne bonchchuu sa'aa ubbaa bolla gido.<verse eid="PSA 108:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6" />Neeni siik'iyaawanttu attana mala,</para>
  <para style="q2" vid="PSA 108:6">ne ushechcha kushiyan nuuna ashsha;</para>
  <para style="q2" vid="PSA 108:6">neeni taw alla.<verse eid="PSA 108:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7" />S'oossay bare geeshsha sa'aan hawaadan yaageedda;</para>
  <para style="q2" vid="PSA 108:7">«Taani s'oonaade Sekeema biittaa shaakkana;</para>
  <para style="q2" vid="PSA 108:7">k'ay Sukkoota zanggaaraa gishana.<verse eid="PSA 108:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8" />Gala'aade tawaa; Minaasekka taassa;</para>
  <para style="q2" vid="PSA 108:8">Efireemi ta huup'iyaa ashshiyaa k'oobiyaa;</para>
  <para style="q1" vid="PSA 108:8">Yihuday ta kawutetsaa s'am"aa.<verse eid="PSA 108:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9" />Moo'aabe taani meec'ettiyaa kuyis'aaruwaa;</para>
  <para style="q2" vid="PSA 108:9">Eedoomi tawaa gidiyaawaa erissanaw</para>
  <para style="q2" vid="PSA 108:9">ta c'aammaa Aa bolla wotsay.</para>
  <para style="q2" vid="PSA 108:9">Taani Piliss's'eema s'oonaade gereeray» yaageedda.<verse eid="PSA 108:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10" />Gimbbetteedda katamaakko, taana oonee afanawe?</para>
  <para style="q2" vid="PSA 108:10">Eedooma gakkanaw taana oonee kaaletsanawe?<verse eid="PSA 108:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11" />Abeet S'oossaw, nuuna aggeedawe neena gidikkii?</para>
  <para style="q2" vid="PSA 108:11">Abeet S'oossaw, neeni nu tooranchchatuwaanna olaw kesakka.<verse eid="PSA 108:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12" />Asaa maaduu patsenna diraw,</para>
  <para style="q2" vid="PSA 108:12">morkkiyaanna olettanaw neeni nuuna maadda.<verse eid="PSA 108:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13" />S'oossaa wolk'k'an nuuni nu morkkatuwaa s'oonana;</para>
  <para style="q2" vid="PSA 108:13">nu morkkatuwaa yed'd'anawe Aa.<verse eid="PSA 108:13" /></para>
  <chapter eid="PSA 108" />
  <chapter number="109" style="c" sid="PSA 109" />
  <para style="s">Morkkiyaa Bolla Shiik'o Woosaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Daawite s'aafeedda mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1" />Abeet taani galatiyaa S'oossaw,</para>
  <para style="q2" vid="PSA 109:1">neeni taw c'o"u gooppa.<verse eid="PSA 109:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2" />Ayaw gooppe, iita worddanchcha asatuu,</para>
  <para style="q2" vid="PSA 109:2">barenttu doonaa ta bolla dooyeeddino;</para>
  <para style="q2" vid="PSA 109:2">unttunttu worddo ins's'arssan ta bolla haasayiino.<verse eid="PSA 109:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3" />Unttunttu is'o k'aalaanna taana dooddiino;</para>
  <para style="q2" vid="PSA 109:3">gaasuu bayinnan taananna oletiino.<verse eid="PSA 109:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4" />Taani unttuntta siik'aynne unttunttoo woossay;</para>
  <para style="q2" vid="PSA 109:4">gidooppekka, unttunttu taana mootiino.<verse eid="PSA 109:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5" />Taani lo"uwaa ootsina,</para>
  <para style="q2" vid="PSA 109:5">unttunttu taw iitaa zaariino;</para>
  <para style="q2" vid="PSA 109:5">taani unttuntta siik'ina, unttunttu taana is's'iino.<verse eid="PSA 109:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6" />Ta morkkiyaa bolla iita daannaa suntsaa;</para>
  <para style="q2" vid="PSA 109:6">mootanchchay Aa ushechchan ek'k'o.<verse eid="PSA 109:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7" />Aa biddiyaa wode, I bayzzanchcha gidiide beetto;</para>
  <para style="q2" vid="PSA 109:7">Aa woosaykka aw simmiide gometo!<verse eid="PSA 109:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8" />Aa laytsay k'aammo;<note caller="-" style="x"><char style="xo" closed="false">109:8 </char><char style="xt" closed="false"><ref loc="ACT 1:20">Kit. 1:20</ref></char></note></para>
  <para style="q2" vid="PSA 109:8">Aa suntsatetsaakka haray akko!<verse eid="PSA 109:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9" />Aa naanatuu aawuwaa d'ayiide yii"ino;</para>
  <para style="q2" vid="PSA 109:9">Aa machata am"e gidu!<verse eid="PSA 109:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10" />Aa naanatuu yuuyyi yuuyyiide woossino;</para>
  <para style="q2" vid="PSA 109:10">barenttu de'iyaa onaappekka yederssettino!<verse eid="PSA 109:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11" />Aa mas'uwaa ubbaa ac'oo oyk'k'o;</para>
  <para style="q2" vid="PSA 109:11">I daaburiide kesseeddabaa ubbaa allagay bonk'k'o!<verse eid="PSA 109:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12" />Ooninne aw keekkabaa ootsoppo,</para>
  <para style="q2" vid="PSA 109:12">woy aawuwaa d'ayeedda Aa naanaatoo k'arettoppo!<verse eid="PSA 109:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13" />Aa naanatuu ubbay wuri d'ayino;</para>
  <para style="q2" vid="PSA 109:13">kaalliyaa yeletaan Aa suntsay dogetto.<verse eid="PSA 109:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14" />Aa aawotuwaa nagaray Med'inaa Godaa sintsan k'ofetto;</para>
  <para style="q2" vid="PSA 109:14">Aa aatti nagaray ubbakka k'uc'ettoppo!<verse eid="PSA 109:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15" />He nagaray ubbaa gede Med'inaa Godaa sintsan beetto;</para>
  <para style="q2" vid="PSA 109:15">unttuntta hassayissiyaawe sa'aappe d'ok'olletti kichcho!<verse eid="PSA 109:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16" />Ayaw gooppe, I</para>
  <para style="q2" vid="PSA 109:16">keekkabaa ootsanaw ubbakka k'oppibeenna;</para>
  <para style="q2" vid="PSA 109:16">hiyyeesatuwaa, metootanchchatuwaanne</para>
  <para style="q2" vid="PSA 109:16">wozanay madus's'eeddawantta yederssiide wod'eedda.<verse eid="PSA 109:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17" />I shek'k'anaw doseedda diraw,</para>
  <para style="q2" vid="PSA 109:17">ikka shek'k'etteeddawaa gido!</para>
  <para style="q1" vid="PSA 109:17">I anjjanaw dosenna diraw,</para>
  <para style="q2" vid="PSA 109:17">anjjuu aappe haakko!<verse eid="PSA 109:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18" />I shek'k'iide salenna;</para>
  <para style="q2" vid="PSA 109:18">Aa shek'ay haatsaadan Aa bollaa katso!</para>
  <para style="q1" vid="PSA 109:18">Zayitiyaadan Aa mek'etsan gelo!<verse eid="PSA 109:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19" />Afilaadan Aa kammo;</para>
  <para style="q2" vid="PSA 109:19">sak'k'iyaadan ubbaa gede Aa s'eessan de'o!<verse eid="PSA 109:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20" />Hawe taana mootiyaawanttoonne</para>
  <para style="q2" vid="PSA 109:20">taana iitan zigiriyaawanttoo,</para>
  <para style="q1" vid="PSA 109:20">Med'inaa Goday immiyaa woytuwaa gido!<verse eid="PSA 109:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21" />Shin abeet Ubbaa Mooddiyaa Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 109:21">ne suntsaa diraw, taana maadda.</para>
  <para style="q1" vid="PSA 109:21">Aggena ne siik'uwaanne</para>
  <para style="q2" vid="PSA 109:21">ne keekkatetsaa diraw, taana ashsha.<verse eid="PSA 109:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22" />Ayaw gooppe, taani</para>
  <para style="q2" vid="PSA 109:22">hiyyeessanne metootanchchaa asaa;</para>
  <para style="q2" vid="PSA 109:22">ta wozanaykka maduns's'eedda.<verse eid="PSA 109:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23" />Taani omarssa kuwaadan d'ayana hanay;</para>
  <para style="q2" vid="PSA 109:23">taani booliyaadan k'ok'k'ofettay.<verse eid="PSA 109:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24" />S'oomishin ta gulbbatay is's'eedda;</para>
  <para style="q2" vid="PSA 109:24">ta bollaykka laafee.<verse eid="PSA 109:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25" />Taana mootiyaawanttoo k'iliic'iyaawaa gidaaddi;<note caller="-" style="x"><char style="xo" closed="false">109:25 </char><char style="xt" closed="false"><ref loc="MAT 27:39">Mat. 27:39</ref>; <ref loc="MRK 15:29">Mar. 15:29</ref></char></note></para>
  <para style="q2" vid="PSA 109:25">unttunttu taana be'iide, barenttu huup'iyaa k'aatsiino.<verse eid="PSA 109:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26" />Abeet Med'inaa Godaw ta S'oossaw, taana maadda;</para>
  <para style="q2" vid="PSA 109:26">aggena ne siik'uwaadan taana ashsha.<verse eid="PSA 109:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27" />Abeet Med'inaa Godaw, hewe</para>
  <para style="q2" vid="PSA 109:27">ne kushiyaa gideeddawaanne</para>
  <para style="q2" vid="PSA 109:27">hewaa neeni ootseeddawaa ta morkketuu erino.<verse eid="PSA 109:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28" />Unttunttu taana shek'k'ooppenne,</para>
  <para style="q2" vid="PSA 109:28">neeni taana anjja!</para>
  <para style="q1" vid="PSA 109:28">Ta bolla denddiyaawanttu yeellatino;</para>
  <para style="q2" vid="PSA 109:28">shin taana ne k'oomaa nashshechchaa.<verse eid="PSA 109:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29" />Taana mootiyaawanttu kawushshaa mayno;</para>
  <para style="q2" vid="PSA 109:29">barenttu yeellaakka kutaadan k'umayino.<verse eid="PSA 109:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30" />Taani ta ins's'arssan Med'inaa Godaa daroppe galatana;</para>
  <para style="q2" vid="PSA 109:30">daro Asay shiik'eeddasaan Aa galatana.<verse eid="PSA 109:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31" />Ayaw gooppe, I hiyyeesaa diraw mootettee;</para>
  <para style="q2" vid="PSA 109:31">hayk'k'oo pirddiyaa asaappekka Aa ashshee.<verse eid="PSA 109:31" /></para>
  <chapter eid="PSA 109" />
  <chapter number="110" style="c" sid="PSA 110" />
  <para style="d">S'oossay Dooreedda Kaatiyaa Daawite s'aafeedda mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1" />Med'inaa Goday ta Godaa,<note caller="-" style="x"><char style="xo" closed="false">110:1 </char><char style="xt" closed="false"><ref loc="MAT 22:44">Mat. 22:44</ref>; <ref loc="MRK 12:36">Mar. 12:36</ref>; <ref loc="LUK 20:42-43">Luk'. 20:42-43</ref>; <ref loc="ACT 2:34-35">Kit. 2:34-35</ref>; <ref loc="1CO 15:25">1 K'or. 15:25</ref>; <ref loc="EPH 1:20-22">Efe. 1:20-22</ref>; <ref loc="COL 3:1">K'ol. 3:1</ref>; <ref loc="HEB 1:13">Ibr. 1:13</ref>; <ref loc="HEB 8:1">8:1</ref>; <ref loc="HEB 10:12-13">10:12-13</ref></char></note></para>
  <para style="q2" vid="PSA 110:1">«Taani ne morkkatuwaa neeni gediyaan</para>
  <para style="q2" vid="PSA 110:1">yed'd'a ek'k'iyaawaa ootsana gakkanaw,</para>
  <para style="q2" vid="PSA 110:1">hawaan taappe ushechcha baggana utta» yaageedda.<verse eid="PSA 110:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2" />Med'inaa Goday ne minotetsaa s'am"aa S'iyooneppe kiittana;</para>
  <para style="q2" vid="PSA 110:2">yaatina, «Ne morkkatuwaa moodda!» yaagana.<verse eid="PSA 110:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3" />Neeni ne morkkatuwaanna olettiyaa gallassi,</para>
  <para style="q2" vid="PSA 110:3">ne Asay eeno gaana.</para>
  <para style="q1" vid="PSA 110:3">Wontta guura ketterssaadan,</para>
  <para style="q2" vid="PSA 110:3">ne wodalla Asay neekko geeshsha deretuwaan shiik'ana.<verse eid="PSA 110:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4" />Med'inaa Goday, «Malkka S'edek'i k'eesiyaa gideeddawaadan,</para>
  <para style="q2" vid="PSA 110:4">neenikka med'inaw k'eesiyaa gidana» yaagiide c'aak'k'eedda;</para>
  <para style="q1" vid="PSA 110:4">I bare k'ofaa laammenna.<note caller="-" style="x"><char style="xo" closed="false">110:4 </char><char style="xt" closed="false"><ref loc="HEB 5:6">Ibr. 5:6</ref>; <ref loc="HEB 6:20">6:20</ref>; <ref loc="HEB 7:17">7:17</ref>, <ref loc="HEB 7:21">21</ref></char></note><verse eid="PSA 110:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5" />Goday ne ushechchan de'ee;</para>
  <para style="q2" vid="PSA 110:5">bare hank'k'uwaa gallassi I kaatetuwaa kinchchereetsana.<verse eid="PSA 110:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6" />Kawutetsaa bolla I pirddana;</para>
  <para style="q2" vid="PSA 110:6">olaa dembbatuwaakka anhaa s'alala ootsana;</para>
  <para style="q2" vid="PSA 110:6">sa'aan ubbaan de'iyaa kaatetuwaa I mentsereetsana.<verse eid="PSA 110:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7" />Kaatii ogiyaa matan de'iyaa haatsaa pulttuwaappe ushiide,</para>
  <para style="q2" vid="PSA 110:7">I bare huup'iyaa d'ok'k'u ootsana.<verse eid="PSA 110:7" /></para>
  <chapter eid="PSA 110" />
  <chapter number="111" style="c" sid="PSA 111" />
  <para style="s">S'oossaw Shiik'iyaa Galataa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1" />Med'inaa Godaa galatite! Suuretuu shiik'iyaa shiik'uwaan,</para>
  <para style="q2" vid="PSA 111:1">taani ta polo wozanaappe Med'inaa Godaa galatana.<verse eid="PSA 111:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2" />Med'inaa Godaa oosotuu ay keeshshaa gitee!</para>
  <para style="q2" vid="PSA 111:2">Unttunttun nashettiyaawanttu ubbay unttuntta k'oppanaw bessee.<verse eid="PSA 111:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3" />Aa oosotuu bonchchuwaaninne</para>
  <para style="q2" vid="PSA 111:3">anggan kumeeddawantta.</para>
  <para style="q1" vid="PSA 111:3">Aa s'illotetsaykka med'inaw de'ee.<verse eid="PSA 111:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4" />I bare malalissiyaa oosotuu,</para>
  <para style="q2" vid="PSA 111:4">hassayettanaadan ootseedda.</para>
  <para style="q1" vid="PSA 111:4">Med'inaa Goday k'arettiyaawaanne maariyaawaa.<verse eid="PSA 111:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5" />Barew yayyiyaawanttoo k'umaa I immee;</para>
  <para style="q2" vid="PSA 111:5">I bare c'aak'uwaa med'inawukka k'oppee.<verse eid="PSA 111:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6" />Allagatuwaa biittaa immiyaawan</para>
  <para style="q2" vid="PSA 111:6">I bare oosuwaa wolk'k'aa bare asaa besseedda.<verse eid="PSA 111:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7" />Aa kushiyaa oosotuu tumanne likke;</para>
  <para style="q2" vid="PSA 111:7">Aa wogatuukka ubbay ammanettiyaawantta.<verse eid="PSA 111:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8" />Unttunttunne med'i med'inaw ek'k'iide de'iyaawantta;</para>
  <para style="q2" vid="PSA 111:8">tumatetsaaninne suuretetsan imetteeddawantta.<verse eid="PSA 111:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9" />I bare asaa woziide kesseedda;</para>
  <para style="q2" vid="PSA 111:9">I bare c'aak'uwaa unttunttunna med'inaw wotseedda.</para>
  <para style="q1" vid="PSA 111:9">Aa suntsay geeshshanne, «Hoola!» giissiyaawaa.<verse eid="PSA 111:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10" />Eratetsaw koyiruu Med'inaa Godaw yayyiyaawaa;<note caller="-" style="x"><char style="xo" closed="false">111:10 </char><char style="xt" closed="false"><ref loc="JOB 28:28">Yob. 28:28</ref>; <ref loc="PRO 1:7">Lem. 1:7</ref>; <ref loc="PRO 9:10">9:10</ref></char></note></para>
  <para style="q2" vid="PSA 111:10">Aa wogaa ootsiyaawanttoo lo"o akeekay de'ee.</para>
  <para style="q1" vid="PSA 111:10">S'oossay med'inaw galatetto!<verse eid="PSA 111:10" /></para>
  <chapter eid="PSA 111" />
  <chapter number="112" style="c" sid="PSA 112" />
  <para style="s">Lo"o Asaa Nashechchaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1" />Med'inaa Godaa galatite! Med'inaa Godaw yayyiyaanne,</para>
  <para style="q2" vid="PSA 112:1">Aa azazuwaa polanaw daroppe nashetiyaa asay,</para>
  <para style="q2" vid="PSA 112:1">anjjetteedawaa.<verse eid="PSA 112:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2" />Aa naanatuu biittan wolk'k'aama gidana;</para>
  <para style="q2" vid="PSA 112:2">suure asatuwaa yeletay anjjettana.<verse eid="PSA 112:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3" />Shaluunne duretetsay Aa golliyaan de'ee;</para>
  <para style="q2" vid="PSA 112:3">Aa s'illotetsaykka med'inaw de'ana.<verse eid="PSA 112:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4" />Suure asaw,</para>
  <para style="q2" vid="PSA 112:4">keeka, s'illonne k'arettiyaa asatoo,</para>
  <para style="q2" vid="PSA 112:4">d'umaa giddon poo'uu poo'ee.<verse eid="PSA 112:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5" />Keekatetsan c'oo tal"iyaa uraw,</para>
  <para style="q2" vid="PSA 112:5">bare oosuwaa suuretetsan ootsiyaa uraw,</para>
  <para style="q2" vid="PSA 112:5">keekabay yaana.<verse eid="PSA 112:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6" />S'illo Asay awudenne kunddenna;</para>
  <para style="q2" vid="PSA 112:6">med'inaw I hassayettana.<verse eid="PSA 112:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7" />Iitabaa I sisooppekka dagammenna;</para>
  <para style="q2" vid="PSA 112:7">ayaw gooppe, Aa wozanay k'aas's'ena;</para>
  <para style="q1" vid="PSA 112:7">Med'inaa Godaan I ammanettee.<verse eid="PSA 112:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8" />Aa wozanay s'ala gidiyaa diraw,</para>
  <para style="q2" vid="PSA 112:8">ubbakka I yayyena;</para>
  <para style="q2" vid="PSA 112:8">wurssetsan bare morkketuu s'oonettina be'ana.<verse eid="PSA 112:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9" />I hiyyeesaa asaw darissiide immeedda;<note caller="-" style="x"><char style="xo" closed="false">112:9 </char><char style="xt" closed="false"><ref loc="2CO 9:9">2 K'or. 9:9</ref></char></note></para>
  <para style="q2" vid="PSA 112:9">k'ay Aa s'illotetsay med'inaw de'ee;</para>
  <para style="q1" vid="PSA 112:9">Aa kac'ii bonchchuwaan d'ok'k'u gee.<verse eid="PSA 112:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10" />Iita Asay hewaa be'iide yilotee;</para>
  <para style="q2" vid="PSA 112:10">achchaa garc'c'iide, c'oo d'ayee.</para>
  <para style="q1" vid="PSA 112:10">Iita asaa amuu c'oo attanawaa.<verse eid="PSA 112:10" /></para>
  <chapter eid="PSA 112" />
  <chapter number="113" style="c" sid="PSA 113" />
  <para style="s">S'oossaa Keekkatetsaa K'onc'c'issiyaa Galataa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1" />Med'inaa Godaa galatite! Hinttenoo Med'inaa Godaa k'oomatoo,</para>
  <para style="q2" vid="PSA 113:1">Med'inaa Godaa suntsaa galatite!<verse eid="PSA 113:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2" />Med'inaa Godaa suntsay hachcheppe med'inaa gakkanaw galatetto!<verse eid="PSA 113:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3" />Away doliyaasaappe biide</para>
  <para style="q2" vid="PSA 113:3">wulliyaasaa gakkanawukka Med'inaa Godaa suntsay galatetto!<verse eid="PSA 113:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4" />Med'inaa Goday kawutetsaa ubbaappe bollaanna mooddiyaawaa;</para>
  <para style="q2" vid="PSA 113:4">Aa bonchchuukka salotuwaappe d'ok'k'iyaawaa.<verse eid="PSA 113:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5" />Med'inaa Godaa nu S'oossaa mali oonee?</para>
  <para style="q1" vid="PSA 113:5">I bolla d'ok'k'an kawutetsaa araatan utteedda.<verse eid="PSA 113:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6" />I salotuwaanne sa'aa s'eellanaw</para>
  <para style="q2" vid="PSA 113:6">duge hokkee.<verse eid="PSA 113:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7" />I hiyyeesaa baanaappe d'ok'k'u ootsee;</para>
  <para style="q2" vid="PSA 113:7">metootanchchaakka bidintsaa pituwaappe dentsee.<verse eid="PSA 113:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8" />Bare asaa mooddiyaawanttunna utissee.<verse eid="PSA 113:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9" />Maynne mishirato naanatuwaa aato ootsiide,</para>
  <para style="q2" vid="PSA 113:9">nashechchiide I golliyaan izo bonchchissee.</para>
  <para style="p" vid="PSA 113:9">Med'inaa Godaa galatite!<verse eid="PSA 113:9" /></para>
  <chapter eid="PSA 113" />
  <chapter number="114" style="c" sid="PSA 114" />
  <para style="s">Paasigaa Mazimuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1" />Israa'eeliyaa Asay Gibs'e biittaappe keseedda wode,<note caller="-" style="x"><char style="xo" closed="false">114:1 </char><char style="xt" closed="false"><ref loc="EXO 12:51">Kes. 12:51</ref></char></note></para>
  <para style="q2" vid="PSA 114:1">Yaak'ooba golliyaa asay,</para>
  <para style="q2" vid="PSA 114:1">allaga k'aalan haasayiyaa asaa yeggiide beedda wode,<verse eid="PSA 114:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2" />Yihudaa Asay Godaw geeshsha asaa gideedda;</para>
  <para style="q2" vid="PSA 114:2">Israa'eeliyaa asaykka aw moodeteeddino.<verse eid="PSA 114:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3" />Zo'o Abbay hewaa be'iide bak'ateedda;<note caller="-" style="x"><char style="xo" closed="false">114:3 </char><char style="xt" closed="false"><ref loc="EXO 14:21">Kes. 14:21</ref>; <ref loc="JOS 3:16">Iya. 3:16</ref></char></note></para>
  <para style="q2" vid="PSA 114:3">Yorddaanoosa Shaafaykka guyye simmeedda.<verse eid="PSA 114:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4" />Deretuu deeshshatuwaadan buraak'eeddino;</para>
  <para style="q2" vid="PSA 114:4">zoozetuukka dorssaa maraadan guferetteeddino.<verse eid="PSA 114:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5" />Abbaw, neena bak'atisseedawe ayee?</para>
  <para style="q2" vid="PSA 114:5">Yorddaanoosa Shaafaw, ayaw guyye simmaaddii?<verse eid="PSA 114:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6" />Hinttenoo deretoo, deeshshatuwaadan</para>
  <para style="q2" vid="PSA 114:6">ayaw buraak'eedditee?</para>
  <para style="q1" vid="PSA 114:6">Hinttenoo zoozatoo, dorssaa maraadan,</para>
  <para style="q2" vid="PSA 114:6">ayaw guferetteeditee?<verse eid="PSA 114:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7" />Neenoo biittaw, Godaa sintsan,</para>
  <para style="q2" vid="PSA 114:7">Yaak'ooba S'oossaa sintsan kokkora.<verse eid="PSA 114:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8" />I Shuchchaa zeereeto haatsaa kesseeddawaa;<note caller="-" style="x"><char style="xo" closed="false">114:8 </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">Kes. 17:1-7</ref>; <ref loc="NUM 20:2-13">Pay. 20:2-13</ref></char></note></para>
  <para style="q2" vid="PSA 114:8">zaallaa, haatsaa pulttuwaa ootseeddawaa.<verse eid="PSA 114:8" /></para>
  <chapter eid="PSA 114" />
  <chapter number="115" style="c" sid="PSA 115" />
  <para style="s">Itti Tumu S'oossaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1" />Abeet Med'inaa Godaw, nu gishsha gidenna;</para>
  <para style="q2" vid="PSA 115:1">nu gishsha gidennaan, aggena ne siik'owunne</para>
  <para style="q2" vid="PSA 115:1">ne tumatetsaa diraw, ne suntsaa bonchcha.<verse eid="PSA 115:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2" />Kawutetsatuu ayaw,</para>
  <para style="q2" vid="PSA 115:2">«Unttunttu S'oossay hak'an de'ii?» giinoo?<verse eid="PSA 115:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3" />Nu S'oossay saluwaana;</para>
  <para style="q2" vid="PSA 115:3">I bare doseeddawaa ay gidooppekka ootsee.<verse eid="PSA 115:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4" />Shin unttunttu eek'atuu biraanne work'k'aa;<note caller="-" style="x"><char style="xo" closed="false">115:4-8 </char><char style="xt" closed="false"><ref loc="PSA 135:15-18">Maz. 135:15-18</ref>; <ref loc="REV 9:20">Sas'. 9:20</ref></char></note></para>
  <para style="q2" vid="PSA 115:4">unttunttu asaa kushiyaan med'etteeddawantta.<verse eid="PSA 115:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5" />Unttunttoo doonay de'ee; shin haasayikkino;</para>
  <para style="q2" vid="PSA 115:5">ayifii de'ee; shin s'eellikkino.<verse eid="PSA 115:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6" />Unttunttoo haytsay de'ee; shin sissikkino;</para>
  <para style="q2" vid="PSA 115:6">siid'ii de'ee; shin singgikkino.<verse eid="PSA 115:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7" />Unttunttoo kushii de'ee; shin oyk'k'i erikkino;</para>
  <para style="q2" vid="PSA 115:7">gediikka de'ee; shin hamettikkino;</para>
  <para style="q2" vid="PSA 115:7">unttunttu barenttu pillanttiyaanna kooshshaa sissikkino.<verse eid="PSA 115:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8" />Unttuntta med'd'iyaawanttunne,</para>
  <para style="q2" vid="PSA 115:8">unttunttun ammanettiyaawanttu ubbay unttunttu mala gidino.<verse eid="PSA 115:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9" />Hinttenoo, Israa'eeliyaa asatoo,</para>
  <para style="q2" vid="PSA 115:9">Med'inaa Godaan ammanettite!</para>
  <para style="q1" vid="PSA 115:9">I hinttena maaddiyaawaanne hintte gonddalliyaa.<verse eid="PSA 115:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10" />Hinttenoo, Aaroona golliyaa asatoo,</para>
  <para style="q2" vid="PSA 115:10">Med'inaa Godaan ammanettite!</para>
  <para style="q1" vid="PSA 115:10">I hinttena maaddiyaawaanne hintte gonddalliyaa.<verse eid="PSA 115:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11" />Hinttenoo, Med'inaa Godaw yayyiyaawanttoo,</para>
  <para style="q2" vid="PSA 115:11">Med'inaa Godaan ammanettite!</para>
  <para style="q1" vid="PSA 115:11">I hinttena maaddiyaawaanne hintte gonddalliyaa.<verse eid="PSA 115:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12" />Med'inaa Goday nuuna k'oppee; I nuuna anjjana.</para>
  <para style="q2" vid="PSA 115:12">I Israa'eeliyaa asatuwaa anjjana.</para>
  <para style="q1" vid="PSA 115:12">I Aaroona golliyaa asatuwaa anjjana.<verse eid="PSA 115:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13" />Med'inaa Godaw yayyiyaawantta,</para>
  <para style="q2" vid="PSA 115:13">guutsatuwaakka gitatuwaakka I gatso anjjana.<note caller="-" style="x"><char style="xo" closed="false">115:13 </char><char style="xt" closed="false"><ref loc="REV 11:18">Sas'. 11:18</ref>; <ref loc="REV 19:5">19:5</ref></char></note><verse eid="PSA 115:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14" />Med'inaa Goday hinttenakka hintte naanatuwaakka darisso!<verse eid="PSA 115:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15" />Saluwaanne sa'aa med'd'eedda Med'inaa Godaan anjjettite!<verse eid="PSA 115:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16" />Bolla d'ok'k'a saluu Med'inaa Godaawaa;</para>
  <para style="q2" vid="PSA 115:16">shin sa'aa I asaw immeedda.<verse eid="PSA 115:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17" />Hayk'k'eeddawanttu, duufuwaan c'o"u geeddawanttu,</para>
  <para style="q2" vid="PSA 115:17">Med'inaa Godaa galatikkino.<verse eid="PSA 115:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18" />Shin nuuni, pas'a de'iyaawanttu,</para>
  <para style="q2" vid="PSA 115:18">hachcheppe doommiide</para>
  <para style="q2" vid="PSA 115:18">med'inaa gakkanaw Med'inaa Godaa galateetto.</para>
  <para style="b" vid="PSA 115:18" />
  <para style="q1" vid="PSA 115:18">Med'inaa Godaa galatite!<verse eid="PSA 115:18" /></para>
  <chapter eid="PSA 115" />
  <chapter number="116" style="c" sid="PSA 116" />
  <para style="s">Hayk'k'uwaappe Atteedda Asaa Galataa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1" />I ta kooshshaanne ta watiwatuwaa siseedda diraw,</para>
  <para style="q2" vid="PSA 116:1">taani Med'inaa Godaa siik'ay.<verse eid="PSA 116:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2" />I bare haytsaa taakko yeggeedda diraw,</para>
  <para style="q2" vid="PSA 116:2">taani pas'a de'eedda keenan ubbaan Aa s'eesana.<verse eid="PSA 116:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3" />Hayk'k'uu p'iriyaadan taana oyk'k'anaw haneedda;</para>
  <para style="q2" vid="PSA 116:3">moogettana hirggay taana iisseedda.</para>
  <para style="q1" vid="PSA 116:3">Taana un"ay toleedda.<verse eid="PSA 116:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4" />He wode taani, «Abeet Med'inaa Godaw, hadaraa!</para>
  <para style="q2" vid="PSA 116:4">Taana ashsha» yaagaade Med'inaa Godaa suntsaa s'eesaad.<verse eid="PSA 116:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5" />Med'inaa Goday keekkanne s'iluwaa;</para>
  <para style="q2" vid="PSA 116:5">nu S'oossay k'arettiyaawaa.<verse eid="PSA 116:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6" />Med'inaa Goday ashikke wozanay de'iyaawantta naagee;</para>
  <para style="q2" vid="PSA 116:6">taani metooteedda wode, I taana ashsheeda.<verse eid="PSA 116:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7" />Ta shemppattee, simmi woppu ga;</para>
  <para style="q2" vid="PSA 116:7">ayaw gooppe, Med'inaa Goday new keekeedda.<verse eid="PSA 116:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8" />Med'inaa Goday taana hayk'k'uwaappe,</para>
  <para style="q2" vid="PSA 116:8">ta ayifiyaa afotsaappe,</para>
  <para style="q2" vid="PSA 116:8">ta gediyaakka d'ubiyaappe ashsheedda.<verse eid="PSA 116:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9" />Hewaa diraw, taani,</para>
  <para style="q2" vid="PSA 116:9">pas'a de'iyaawanttu giddon,</para>
  <para style="q2" vid="PSA 116:9">Med'inaa Godaa sintsan hamettay.<verse eid="PSA 116:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10" />Taani, «Taana un"ay toleedda» giyaa wodekka,<note caller="-" style="x"><char style="xo" closed="false">116:10 </char><char style="xt" closed="false"><ref loc="2CO 4:13">2 K'or. 4:13</ref></char></note></para>
  <para style="q2" vid="PSA 116:10">ta ammanuwaa aggabeyikke.<verse eid="PSA 116:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11" />Taani dagamaade, «Asay ubbay wordduwaa» yaagaad.<verse eid="PSA 116:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12" />I taw keekkeedda keekkatetsaa diraw,</para>
  <para style="q2" vid="PSA 116:12">taani Med'inaa Godaw ay c'igganaw danddayayitaa?<verse eid="PSA 116:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13" />Taani s'uu'aa woyniyaa eessaa galataw shiishshaade,</para>
  <para style="q2" vid="PSA 116:13">I taana asho diraw,</para>
  <para style="q1" vid="PSA 116:13">Med'inaa Godaa suntsaa s'eesana.<verse eid="PSA 116:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14" />Aa asaa ubbaa sintsan</para>
  <para style="q2" vid="PSA 116:14">taani k'anggiyaa Med'inaa Godaw gatsana.<verse eid="PSA 116:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15" />Geeshshatuwaa hayk'k'uu Med'inaa Godaa sintsan,</para>
  <para style="q2" vid="PSA 116:15">loytsi daroppe bonchchetteeddawaa.<verse eid="PSA 116:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16" />Abeet Med'inaa Godaw, taani ne k'oomaa;</para>
  <para style="q2" vid="PSA 116:16">ee, taani ne k'oomaa, ne k'oomati na'aa.</para>
  <para style="q1" vid="PSA 116:16">Taana k'ashuwaappe neeni billaada.<verse eid="PSA 116:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17" />Abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 116:17">taani galataa yarshshuwaa new yarshshana;</para>
  <para style="q2" vid="PSA 116:17">ne suntsaa s'eesana.<verse eid="PSA 116:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18" />Asaa ubbaa sintsan,</para>
  <para style="q2" vid="PSA 116:18">taani k'anggeteedda k'anggetsaa Med'inaa Godaw gatsana.<verse eid="PSA 116:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19" />Hewaakka taani gatsanawe,</para>
  <para style="q2" vid="PSA 116:19">Yerusaalamen de'iyaa Med'inaa Godaa golliyaa dabaabaanna.</para>
  <para style="b" vid="PSA 116:19" />
  <para style="q1" vid="PSA 116:19">Med'inaa Godaa galatite!<verse eid="PSA 116:19" /></para>
  <chapter eid="PSA 116" />
  <chapter number="117" style="c" sid="PSA 117" />
  <para style="s">Galataa S'eessaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1" />Kawutetsatoo ubbatoo, Med'inaa Godaa galatite!<note caller="-" style="x"><char style="xo" closed="false">117:1 </char><char style="xt" closed="false"><ref loc="ROM 15:11">Rom. 15:11</ref></char></note></para>
  <para style="q2" vid="PSA 117:1">Asay ubbay, Aa gitayite!<verse eid="PSA 117:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2" />Ayaw gooppe, aggena Aa siik'uu nuw wolk'k'aama;</para>
  <para style="q2" vid="PSA 117:2">Med'inaa Goday med'inawukka ammanettiyaawaa.</para>
  <para style="b" vid="PSA 117:2" />
  <para style="q1" vid="PSA 117:2">Med'inaa Godaa galatite!<verse eid="PSA 117:2" /></para>
  <chapter eid="PSA 117" />
  <chapter number="118" style="c" sid="PSA 118" />
  <para style="s">S'oonoo Shiik'o Galataa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1" />Med'inaa Godaa galatite! Ayaw gooppe, I keeka.<note caller="-" style="x"><char style="xo" closed="false">118:1 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1 Od. 16:34</ref>; <ref loc="2CH 5:13">2 Od. 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Izr. 3:11</ref>; <ref loc="PSA 100:5">Maz. 100:5</ref>; <ref loc="PSA 106:1">106:1</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Erm. 33:11</ref></char></note></para>
  <para style="q2" vid="PSA 118:1">Aggena Aa siik'uu med'inaawaa.<verse eid="PSA 118:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2" />Israa'eeliyaa asay,</para>
  <para style="q2" vid="PSA 118:2">«Aggena Aa siik'uu med'inaawaa» yaago.<verse eid="PSA 118:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3" />Aaroona golliyaa asay,</para>
  <para style="q2" vid="PSA 118:3">«Aggena Aa siik'uu med'inaawaa» yaago.<verse eid="PSA 118:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4" />Med'inaa Godaw yayyiyaawanttu ubbay,</para>
  <para style="q2" vid="PSA 118:4">«Aggena Aa siik'uu med'inaawaa» yaagino.<verse eid="PSA 118:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5" />Taani un"etteedda wode Med'inaa Godaw waassaad;</para>
  <para style="q2" vid="PSA 118:5">I ta waasuwaa alliide, taana la"a kesseedda.<verse eid="PSA 118:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6" />Med'inaa Goday taananna de'iyaa diraw,</para>
  <para style="q2" vid="PSA 118:6">taani yayyikke.<note caller="-" style="x"><char style="xo" closed="false">118:6 </char><char style="xt" closed="false"><ref loc="HEB 13:6">Ibr. 13:6</ref></char></note></para>
  <para style="q1" vid="PSA 118:6">Asi taana ay ootsii?<verse eid="PSA 118:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7" />Med'inaa Goday taana maaddanaw taananna de'ee;</para>
  <para style="q2" vid="PSA 118:7">ta morkketuu s'oonetteeddawantta taani be'ana.<verse eid="PSA 118:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8" />Asan ammanettiyaawaappe,</para>
  <para style="q2" vid="PSA 118:8">Med'inaa Godaakko bak'atiyaawe lo"a.<verse eid="PSA 118:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9" />Daannatuwaan ammanettiyaawaappe,</para>
  <para style="q2" vid="PSA 118:9">Med'inaa Godaakko bak'atiyaawe lo"a.<verse eid="PSA 118:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10" />Kawutetsatuu ubbay taana dooddi oyk'k'eeddino;</para>
  <para style="q2" vid="PSA 118:10">shin Med'inaa Godaa suntsan taani unttuntta s'oonaad.<verse eid="PSA 118:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11" />Unttunttu taana dooddeeddino;</para>
  <para style="q2" vid="PSA 118:11">ubba saanna dooddi oyk'k'eeddino;</para>
  <para style="q2" vid="PSA 118:11">shin Med'inaa Godaa suntsan taani unttuntta s'oonaad.<verse eid="PSA 118:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12" />Unttunttu matsay doodiyaawaadan,</para>
  <para style="q2" vid="PSA 118:12">ta yuushshuwaan dooddeeddino.</para>
  <para style="q1" vid="PSA 118:12">Shin aguntsay taman ees's'iyaawaadan</para>
  <para style="q2" vid="PSA 118:12">ees's'i d'ayeeddino.</para>
  <para style="q1" vid="PSA 118:12">Med'inaa Godaa suntsan taani unttuntta s'oonaad.<verse eid="PSA 118:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13" />Taana sugi yeggina, kunddana hanay;</para>
  <para style="q2" vid="PSA 118:13">shin Med'inaa Goday taana maaddeedda.<verse eid="PSA 118:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14" />Med'inaa Goday taw wolk'k'anne minotetsaa;<note caller="-" style="x"><char style="xo" closed="false">118:14 </char><char style="xt" closed="false"><ref loc="EXO 15:2">Kes. 15:2</ref>; <ref loc="ISA 12:2">Isa. 12:2</ref></char></note></para>
  <para style="q2" vid="PSA 118:14">I taana ashshiyaawaa gideedda.<verse eid="PSA 118:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15" />Olaa s'ooniide simmiyaa asay,</para>
  <para style="q2" vid="PSA 118:15">s'illotuwaa dunkkaaniyaan hombboc'iidde, giyaawaa sisite.</para>
  <para style="q1" vid="PSA 118:15">Unttunttu, «Med'inaa Godaa ushechcha kushii wolk'k'aamabaa ootseedda!<verse eid="PSA 118:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 118:16" />Med'inaa Godaa ushechcha kushii s'oonuwaa immeedda!</para>
  <para style="q2" vid="PSA 118:16">Med'inaa Godaa ushechcha kushii wolk'k'aamabaa ootseedda!» yaagiino.<verse eid="PSA 118:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17" />Taani hayk'k'ikke;</para>
  <para style="q2" vid="PSA 118:17">pas'a de'ananne Med'inaa Goday ootseeddawaa awaayana.<verse eid="PSA 118:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18" />Med'inaa Goday taana iita muruwaa muree;</para>
  <para style="q2" vid="PSA 118:18">shin hayk'k'oo aatsiide immibeenna.<verse eid="PSA 118:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19" />Taani giddo gelaade Med'inaa Godaa galatana mala,</para>
  <para style="q2" vid="PSA 118:19">Geeshsha Golliyaa penggetuwaa ane taw dooyite.<verse eid="PSA 118:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20" />Hawe Med'inaa Godaa penggiyaa;</para>
  <para style="q2" vid="PSA 118:20">ha penggiyaanna s'illotuwaa s'alalay geliino.<verse eid="PSA 118:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21" />Neeni taana siseedda dirawunne</para>
  <para style="q2" vid="PSA 118:21">s'oonuwaa immeedda diraw,</para>
  <para style="q2" vid="PSA 118:21">taani neena galatay.<verse eid="PSA 118:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22" />Gimbbiyaawanttu kad'iide is's'eedda shuchchay,<note caller="-" style="x"><char style="xo" closed="false">118:22 </char><char style="xt" closed="false"><ref loc="LUK 20:17">Luk'. 20:17</ref>; <ref loc="ACT 4:11">Kit. 4:11</ref>; <ref loc="1PE 2:7">1 P'es'. 2:7</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">118:22-23</char><char style="xt" closed="false"><ref loc="MAT 21:42">Mat. 21:42</ref>; <ref loc="MRK 12:10-11">Mar. 12:10-11</ref></char></note></para>
  <para style="q2" vid="PSA 118:22">godaa s'ap'uwaa minisiyaa, ubbaappe aad'd'iyaa shuchchaa gideedda.<verse eid="PSA 118:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23" />Hawe Med'inaa Goday ootseeddawaa;</para>
  <para style="q2" vid="PSA 118:23">k'ay nu ayifiyawukka malalissiyaawaa.<verse eid="PSA 118:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24" />Hawe gallassay Med'inaa Goday med'eedda gallassaa.</para>
  <para style="q2" vid="PSA 118:24">Ane nuuni an nashettoyttenne ililoytte.<verse eid="PSA 118:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25" />Abeet Med'inaa Godaw, ha"i nuuna ashshaarikkii!</para>
  <para style="q2" vid="PSA 118:25">Abeet Med'inaa Godaw, ha"i nuw injjeyaarikkii!<note caller="-" style="x"><char style="xo" closed="false">118:25 </char><char style="xt" closed="false"><ref loc="MAT 21:9">Mat. 21:9</ref>; <ref loc="MRK 11:9">Mar. 11:9</ref>; <ref loc="JHN 12:13">Yoh. 12:13</ref></char></note><verse eid="PSA 118:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26" />Med'inaa Godaa suntsan yiyaa Asay anjjetteedawaa gido!<note caller="-" style="x"><char style="xo" closed="false">118:26 </char><char style="xt" closed="false"><ref loc="MAT 21:9">Mat. 21:9</ref>; <ref loc="MAT 23:39">23:39</ref>; <ref loc="MRK 11:9">Mar. 11:9</ref>; <ref loc="LUK 13:35">Luk'. 13:35</ref>; <ref loc="LUK 19:38">19:38</ref>; <ref loc="JHN 12:13">Yoh. 12:13</ref></char></note></para>
  <para style="q2" vid="PSA 118:26">Nuuni Med'inaa Godaa Geeshsha Golliyaappe hinttena anjjeetto.<verse eid="PSA 118:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27" />Med'inaa Goday S'oossaa; I nu bollan poo'isseedda.</para>
  <para style="q2" vid="PSA 118:27">Irs's'a tashiyaa oyk'k'iide, ayaana gallassaa bonchchite;</para>
  <para style="q2" vid="PSA 118:27">yarshshuwaa bollan de'iyaa kac'iyaakko aad'd'ite.<verse eid="PSA 118:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28" />Neeni ta S'oossaa; taani neena galatana.</para>
  <para style="q2" vid="PSA 118:28">Neeni ta S'oossaa; taani neena gitayana.<verse eid="PSA 118:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29" />Med'inaa Godaa galatite! Ayaw gooppe, I keeka;</para>
  <para style="q2" vid="PSA 118:29">aggena Aa siik'uu med'inaawaa.<verse eid="PSA 118:29" /></para>
  <chapter eid="PSA 118" />
  <chapter number="119" style="c" sid="PSA 119" />
  <para style="s">S'oossaa Higgiyaw Imetteedda Sabaa</para>
  <para style="qa">Alef</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1" />Barenttu ogiyaan tooshii bayinnawanttunne,</para>
  <para style="q2" vid="PSA 119:1">Med'inaa Godaa higgiyaadan hamettiyaawanttu,</para>
  <para style="q2" vid="PSA 119:1">anjjetteedawantta.<verse eid="PSA 119:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2" />I odeeddawaa ootsiyaawanttunne</para>
  <para style="q2" vid="PSA 119:2">barenttu kumentsaa wozanaappe Aa siik'iyaawanttu,</para>
  <para style="q2" vid="PSA 119:2">anjjetteeddawantta.<verse eid="PSA 119:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3" />Unttunttu balabaa ootsikkino;</para>
  <para style="q2" vid="PSA 119:3">S'oossaa ogiyaan hamettiino.<verse eid="PSA 119:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4" />Ne wogaw ammanettiide naagana mala,</para>
  <para style="q2" vid="PSA 119:4">neeni nuuna azazaadda.<verse eid="PSA 119:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5" />Ne awaayoo azazettiyaawan</para>
  <para style="q2" vid="PSA 119:5">ta ogii minnanaadan amottay.<verse eid="PSA 119:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6" />Yaatooppe, ne azazuwaa ubbaa hayzzaadde,</para>
  <para style="q2" vid="PSA 119:6">taani ubbakka yeellatikke.<verse eid="PSA 119:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7" />Ne s'illo pirddaa tamaaraade,</para>
  <para style="q2" vid="PSA 119:7">taani neena suure wozanaappe galatana.<verse eid="PSA 119:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8" />Taani ne awaayuwaadan ootsana;</para>
  <para style="q2" vid="PSA 119:8">taana ubbakka yeggoppa.<verse eid="PSA 119:8" /></para>
  <para style="qa">Beet</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9" />Yalagay bare ogiyaa geeshsha ootsiide</para>
  <para style="q2" vid="PSA 119:9">wooti naaganaw danddayii?</para>
  <para style="q1" vid="PSA 119:9">Ne k'aalay giyaawaadan de'ooppe danddayee.<verse eid="PSA 119:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10" />Taani ta polo wozanaappe neena koyay;</para>
  <para style="q2" vid="PSA 119:10">ne azazotuwaappe wora hamettennaadan taana naaga.<verse eid="PSA 119:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11" />Taani neena naak'k'ennaadan</para>
  <para style="q2" vid="PSA 119:11">ne k'aalaa ta wozanaan wotsaad.<verse eid="PSA 119:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12" />Abeet Med'inaa Godaw, neeni galatetta!</para>
  <para style="q2" vid="PSA 119:12">Ne awaayuwaa taana tamaarissa.<verse eid="PSA 119:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13" />Ne doonaappe keseedda pirddaa ubbaa,</para>
  <para style="q2" vid="PSA 119:13">taani ta ins's'arssan oday.<verse eid="PSA 119:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14" />Duretetsan nashettiyaawaadan,</para>
  <para style="q2" vid="PSA 119:14">taani neeni odeedda k'aalan nashetay.<verse eid="PSA 119:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15" />Ne wogatuwaa zaara zaaraadde k'oppaynne</para>
  <para style="q2" vid="PSA 119:15">ne ogiyaa loytsa akeekay.<verse eid="PSA 119:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16" />Taani ne awaayuwaan nashetay;</para>
  <para style="q2" vid="PSA 119:16">ne k'aalaakka taani dogikke.<verse eid="PSA 119:16" /></para>
  <para style="qa">Gaameel</para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17" />Taani pas'a de'ana malanne</para>
  <para style="q2" vid="PSA 119:17">ne k'aalaw azazettana mala,</para>
  <para style="q2" vid="PSA 119:17">taw ne k'oomaw keekabaa ootsa.<verse eid="PSA 119:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18" />Ne higgiyaa giddon de'iyaa malalissiyaa tumatetsaa,</para>
  <para style="q2" vid="PSA 119:18">taani be'ana mala, ta ayifiyaa dooyaa.<verse eid="PSA 119:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19" />Taani ha sa'aan imatsaa;</para>
  <para style="q2" vid="PSA 119:19">ne azazotuwaa taappe gentsoppa.<verse eid="PSA 119:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20" />Taani ubbaa wode,</para>
  <para style="q2" vid="PSA 119:20">ne pirddaa loytsa laamotay.<verse eid="PSA 119:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21" />Otorettiyaawanttu, shek'k'etteeddawantta,</para>
  <para style="q2" vid="PSA 119:21">ne azazuwaappe wora hamettiyaawantta,</para>
  <para style="q2" vid="PSA 119:21">neeni seeraasa.<verse eid="PSA 119:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22" />Taani neeni odeeddawaa ootseedda diraw,</para>
  <para style="q2" vid="PSA 119:22">unttunttu boriyaanne unttunttu kad'iyaa ta bollaappe digga.<verse eid="PSA 119:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23" />Haray atto kaappatuu shiik'iide,</para>
  <para style="q2" vid="PSA 119:23">ta bolla mak'ettooppekka,</para>
  <para style="q2" vid="PSA 119:23">taani, ne k'oomay, ne awaayuwaa zaara zaaraadde k'oppana.<verse eid="PSA 119:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24" />Neeni odeedda k'aalatuu taana nashechchiino;</para>
  <para style="q2" vid="PSA 119:24">unttunttu taana zoriino.<verse eid="PSA 119:24" /></para>
  <para style="qa">Daalees'i</para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25" />Taani hayk'k'ana hanay;</para>
  <para style="q2" vid="PSA 119:25">neeni geedda k'aalaadan ta shemppuwaa ashsha.<verse eid="PSA 119:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26" />Taani ta ogiyaawaa new odina,</para>
  <para style="q2" vid="PSA 119:26">neeni taana sisaadda;</para>
  <para style="q2" vid="PSA 119:26">simmi, ne awaayuwaa taana tamaarissa.<verse eid="PSA 119:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27" />Ne wogaa ogiyaa taana akeekissa;</para>
  <para style="q2" vid="PSA 119:27">malalissiyaa ne oosuwaa</para>
  <para style="q2" vid="PSA 119:27">taani zaara zaaraadekka k'oppana.<verse eid="PSA 119:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28" />Kayyuu dareeddawaan ta shemppuu daabureedda;</para>
  <para style="q2" vid="PSA 119:28">neeni geedda k'aalaadan taana minisa.<verse eid="PSA 119:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29" />Worddo ogiyaa taappe haassa;</para>
  <para style="q2" vid="PSA 119:29">ne aad'd'o keekkatetsan ne higgiyaa taana tamaarissa.<verse eid="PSA 119:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30" />Tumuwaa ogiyaa dooraad;</para>
  <para style="q2" vid="PSA 119:30">ne pirddaa hayzzaad.<verse eid="PSA 119:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31" />Abeet Med'inaa Godaw, taani</para>
  <para style="q2" vid="PSA 119:31">neeni odeeddawaa minisa oyk'k'aad;</para>
  <para style="q2" vid="PSA 119:31">simmi taana yeellayoppa!<verse eid="PSA 119:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32" />Neeni ta wozanaa la"a keseedda diraw,</para>
  <para style="q2" vid="PSA 119:32">taani ne azazuwaa ogiyaan wos's'ay.<verse eid="PSA 119:32" /></para>
  <para style="qa">He</para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33" />Abeet Med'inaa Godaw, ne awaayuwaa biletsaa</para>
  <para style="q2" vid="PSA 119:33">taana tamaarissa;</para>
  <para style="q2" vid="PSA 119:33">taani wurssetsay gakkanaw Aa naagana.<verse eid="PSA 119:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34" />Taani ne higgiyaa naagana malanne</para>
  <para style="q2" vid="PSA 119:34">ta kumentsaa wozanaappe taani aw azazettana mala,</para>
  <para style="q2" vid="PSA 119:34">neeni taw akeekaa imma.<verse eid="PSA 119:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35" />Ne azazuwaa ogiyaan taana kaaletsa;</para>
  <para style="q2" vid="PSA 119:35">ayaw gooppe, taani an nashetay.<verse eid="PSA 119:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36" />Ta wozanaa amuwaakko gidennaan,</para>
  <para style="q2" vid="PSA 119:36">neeni odeedda k'aalaakko zaara.<verse eid="PSA 119:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37" />Patsennabaa s'eellenna mala,</para>
  <para style="q2" vid="PSA 119:37">ta ayifetuwaa te"a;</para>
  <para style="q2" vid="PSA 119:37">ne ogiyaan ta de'uwaa ooratsa.<verse eid="PSA 119:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38" />Neeni yayetana mala,</para>
  <para style="q2" vid="PSA 119:38">neeni gelo k'aalaa taw,</para>
  <para style="q2" vid="PSA 119:38">ne k'oomaw pola.<verse eid="PSA 119:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39" />Yashshiyaa boriyaa taappe digga.</para>
  <para style="q1" vid="PSA 119:39">Ne pirdday ay mala lo"ee!<verse eid="PSA 119:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40" />Taani ne wogaa naaganaw amottay;</para>
  <para style="q2" vid="PSA 119:40">neeni s'illuwaa gidiyaa diraw,</para>
  <para style="q2" vid="PSA 119:40">ta de'uwaa ooratsa.<verse eid="PSA 119:40" /></para>
  <para style="qa">Waw</para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41" />Abeet Med'inaa Godaw, aggena ne siik'uwaa taana bessa;</para>
  <para style="q2" vid="PSA 119:41">neeni geedda k'aalaadan taana ashsha.<verse eid="PSA 119:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42" />Taani ne k'aalan ammanettiyaa diraw,</para>
  <para style="q2" vid="PSA 119:42">taana boriyaawanttoo zaaranaw danddayay.<verse eid="PSA 119:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43" />Taani ne pirddan nashshechchaa ootsiyaa diraw,</para>
  <para style="q2" vid="PSA 119:43">ta ins's'arssaappe tumatetsaa k'aalaa d'ayissoppa.<verse eid="PSA 119:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44" />Taani ubbaa gede, med'i med'inawukka</para>
  <para style="q2" vid="PSA 119:44">ne higgiyaw azazettana.<verse eid="PSA 119:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45" />Taani ne wogaa poliyaa diraw,</para>
  <para style="q2" vid="PSA 119:45">aakuwaan hamettana.<verse eid="PSA 119:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46" />Taani kaatetuwaa sintsan ek'k'aade,</para>
  <para style="q2" vid="PSA 119:46">neeni odeeddabaa odaadde yeellatikke.<verse eid="PSA 119:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47" />Taani dosiyaa ne azazotuwaan nashettay<verse eid="PSA 119:47" /></para>
  <para style="q2">
    <verse number="48" style="v" sid="PSA 119:48" />Taani siik'iyaa ne azazotuwaa bonchchay;</para>
  <para style="q2" vid="PSA 119:48">ne awaayuwaakka zaara zaaraadde k'oppana.<verse eid="PSA 119:48" /></para>
  <para style="qa">Zaw</para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49" />Neeni taw, ne k'oomaw,</para>
  <para style="q2" vid="PSA 119:49">immeedda k'aalaa k'oppa;</para>
  <para style="q2" vid="PSA 119:49">he k'aalan taani hidootaa ootsay.<verse eid="PSA 119:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50" />Neeni, «Taani neena pas'a wotsana»</para>
  <para style="q2" vid="PSA 119:50">geedda k'aalay ta tuggaa wode taana mintsetseedda.<verse eid="PSA 119:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51" />Otoranchchatuu taana likkiyaappe aatsiide shek'iino;</para>
  <para style="q2" vid="PSA 119:51">shin taani ne higgiyaappe sher"i giikke.<verse eid="PSA 119:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52" />Abeet Med'inaa Godaw, beniideppe de'iyaa ne pirddaa taani hassayay;</para>
  <para style="q2" vid="PSA 119:52">hewan taani minetay.<verse eid="PSA 119:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53" />Iitatuu ne higgiyaw azazettenawaa be'ina,</para>
  <para style="q2" vid="PSA 119:53">yiluu taana wod'eedda.<verse eid="PSA 119:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54" />Taani de'iyaa allaga biittan,</para>
  <para style="q2" vid="PSA 119:54">ne awaayuu taw yetsaa gideedda.<verse eid="PSA 119:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55" />Abeet Med'inaa Godaw, taani k'amma ne suntsaa k'oppay;</para>
  <para style="q2" vid="PSA 119:55">ne higgiyaakka naagay.<verse eid="PSA 119:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56" />Ne wogaw azazettiyaawe taw anjjo gideedda.<verse eid="PSA 119:56" /></para>
  <para style="qa">Heet</para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57" />Abeet Med'inaa Godaw, taana gakkeedda saamay neena;</para>
  <para style="q2" vid="PSA 119:57">taani ne k'aalaw azazettana yaagay.<verse eid="PSA 119:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58" />Taani ta kumentsaa wozanaappe neena woossay.</para>
  <para style="q1" vid="PSA 119:58">Neeni geedda k'aalaadan taw k'aretta.<verse eid="PSA 119:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59" />Taani ta ogiyaa akeeka s'eellaade,</para>
  <para style="q2" vid="PSA 119:59">neeni odeeddabaakko simmaad.<verse eid="PSA 119:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60" />Taani ne azazuwaa naaganaw,</para>
  <para style="q2" vid="PSA 119:60">elleellanaappe attina takkikke.<verse eid="PSA 119:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61" />Iitatuu taana wodoruwaan k'achchooppekka,</para>
  <para style="q2" vid="PSA 119:61">taani ne higgiyaa dogabeykke.<verse eid="PSA 119:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62" />Ne s'illo pirddaa diraw, neena galatanaw,</para>
  <para style="q2" vid="PSA 119:62">taani k'amma bilahe dendday.<verse eid="PSA 119:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63" />Taani new yayyiyaawanttu ubbawunne</para>
  <para style="q2" vid="PSA 119:63">ne wogaa naagiyaawanttoo dabbo.<verse eid="PSA 119:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64" />Abeet Med'inaa Godaw, sa'ay</para>
  <para style="q2" vid="PSA 119:64">aggena ne siik'uwaan kumeedda;</para>
  <para style="q2" vid="PSA 119:64">ne awaayuwaa taana tamaarissa.<verse eid="PSA 119:64" /></para>
  <para style="qa">S'eet</para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65" />Abeet Med'inaa Godaw, ne geedda k'aalaadan,</para>
  <para style="q2" vid="PSA 119:65">taw ne k'oomaw keekkabaa ootsaadda.<verse eid="PSA 119:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66" />Taani ne azazotuwaan ammanettiyaa diraw,</para>
  <para style="q2" vid="PSA 119:66">lo"o pirddaanne eratetsaa taana tamaarissa.<verse eid="PSA 119:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67" />Taani murettanaappe kase wora hamettaad;</para>
  <para style="q2" vid="PSA 119:67">shin ha"i ne k'aalaw azazettay.<verse eid="PSA 119:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68" />Neeni keeka; neeni keekkabaa ootsaasa;</para>
  <para style="q2" vid="PSA 119:68">ne awaayuwaa taana tamaarissa.<verse eid="PSA 119:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69" />Otoranchchatuu taana wordduwaa okkiino;</para>
  <para style="q2" vid="PSA 119:69">shin taani ne wogaa ta kumentsaa wozanaappe naagana.<verse eid="PSA 119:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70" />Unttunttu wozanay ubbakka donc'c'illowantta;</para>
  <para style="q2" vid="PSA 119:70">shin taani ne higgiyan nashetay.<verse eid="PSA 119:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71" />Taani muretteeddawe taw lo"eedda;</para>
  <para style="q2" vid="PSA 119:71">ayaw gooppe, ne awaayuwaa tamaaranaw taana maaddeedda.<verse eid="PSA 119:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72" />Daro sha"u work'k'aappenne biraappe,</para>
  <para style="q2" vid="PSA 119:72">ne doonaappe keseedda higgii taw aad'd'ee.<verse eid="PSA 119:72" /></para>
  <para style="qa">Yod</para>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73" />Taana ne kushii med'd'eeddanne giigisseedda.</para>
  <para style="q2" vid="PSA 119:73">Ne azazuwaa taani tamaarana mala,</para>
  <para style="q2" vid="PSA 119:73">taw akeekaa imma.<verse eid="PSA 119:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74" />Taani ne k'aalan hidootaa wotsiyaa ootseedda diraw,</para>
  <para style="q2" vid="PSA 119:74">new yayyiyaawanttu taana be'iide nashetino.<verse eid="PSA 119:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75" />Abeet Med'inaa Godaw, ne pirdday s'illa gidiyaawaanne</para>
  <para style="q2" vid="PSA 119:75">neeni amaneteedawaa gido diraw taana mureeddawaa eray.<verse eid="PSA 119:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76" />Neeni taw ne k'oomaw geedda k'aalaadan,</para>
  <para style="q2" vid="PSA 119:76">aggena ne siik'uu taana miniso.<verse eid="PSA 119:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77" />Taani pas'a de'ana mala, taw k'aretta;</para>
  <para style="q2" vid="PSA 119:77">ayaw gooppe, ne higgii taana nashechchee.<verse eid="PSA 119:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78" />Otoranchchatuu wordduwaan</para>
  <para style="q2" vid="PSA 119:78">taana mootiyaa diraw, yeellatino.</para>
  <para style="q1" vid="PSA 119:78">Taana gidooppe, taani ne wogatuwaa</para>
  <para style="q2" vid="PSA 119:78">zaara zaaraadde k'oppay.<verse eid="PSA 119:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79" />New yayyiyaawanttunne,</para>
  <para style="q2" vid="PSA 119:79">neeni odeeddabaa eriyaawanttu ubbay,</para>
  <para style="q2" vid="PSA 119:79">taakko yiino.<verse eid="PSA 119:79" /></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80" />Taani yeellatenna mala,</para>
  <para style="q2" vid="PSA 119:80">ne awaayoo azazettiyaawan</para>
  <para style="q2" vid="PSA 119:80">tooshii bayinnawaa gidaarikkitaa!<verse eid="PSA 119:80" /></para>
  <para style="qa">Kaaf</para>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81" />Neeni taana ashshana mala,</para>
  <para style="q2" vid="PSA 119:81">taani naagaadde daaburay;</para>
  <para style="q2" vid="PSA 119:81">taani ne k'aalan hidootaa ootsay.<verse eid="PSA 119:81" /></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82" />Neeni geedda k'aalay polettina</para>
  <para style="q2" vid="PSA 119:82">be'anaw s'eelliidde, ta ayifii galjjeedda.</para>
  <para style="q1" vid="PSA 119:82">Taani, «Neeni taana awude mintsetsaniishsha?» yaagay.<verse eid="PSA 119:82" /></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83" />C'uwaan kak'k'eedda ogoruwaa gidaade gunddaad;</para>
  <para style="q2" vid="PSA 119:83">gidooppenne, ne awaayuwaa balikke.<verse eid="PSA 119:83" /></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84" />Taani ne k'oomay awude gakkanaw naagoo?</para>
  <para style="q1" vid="PSA 119:84">Taana yederssiyaawantta neeni awude pirddanii?<verse eid="PSA 119:84" /></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85" />Ne higgiyaa naagenna otoranchchatuu,</para>
  <para style="q2" vid="PSA 119:85">taana kuddissana giide, taw ollaa bookkiino.<verse eid="PSA 119:85" /></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86" />Ne azazotuu ubbay ammantsiyaawantta.</para>
  <para style="q2" vid="PSA 119:86">Taana asatuu wordduwaan yederssiyaa diraw,</para>
  <para style="q2" vid="PSA 119:86">ha"i taana maadda!<verse eid="PSA 119:86" /></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87" />Unttunttu taana wod'i diggeeddinoshin;</para>
  <para style="q2" vid="PSA 119:87">taani ne wogaa aggabeyikke.<verse eid="PSA 119:87" /></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88" />Aggena ne siik'uwaan ta de'uwaa naaga;</para>
  <para style="q2" vid="PSA 119:88">hewenne, neeni ne doonaappe odeeddawaa taani naaganaassa.<verse eid="PSA 119:88" /></para>
  <para style="qa">Laameed</para>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89" />Abeet Med'inaa Godaw, ne k'aalay med'inaassa;</para>
  <para style="q2" vid="PSA 119:89">ikka saluwaan minniide de'ee.<verse eid="PSA 119:89" /></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90" />Neeni yeletaappe yeletaa gakkanaw ammanettiyaawaa.</para>
  <para style="q2" vid="PSA 119:90">Neeni ha sa'aa baasaade essaadda;</para>
  <para style="q2" vid="PSA 119:90">ikka minniide de'ee.<verse eid="PSA 119:90" /></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91" />Neeni geeddawaadan ubbabaykka</para>
  <para style="q2" vid="PSA 119:91">hachchi gakkanaw minniide de'ee;</para>
  <para style="q2" vid="PSA 119:91">ayaw gooppe, ubbatuukka ne k'oomatuwaa.<verse eid="PSA 119:91" /></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92" />Ne higgii taana nashechchiyaabaa gidenentto,</para>
  <para style="q2" vid="PSA 119:92">ta tuggaa wode taani d'ayana shin.<verse eid="PSA 119:92" /></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93" />Ne wogaa ubbakka dogikke;</para>
  <para style="q2" vid="PSA 119:93">ayaw gooppe, neeni an taana pas'a wotsaadda.<verse eid="PSA 119:93" /></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94" />Taani newaattee; taana ashsha;</para>
  <para style="q2" vid="PSA 119:94">ayaw gooppe, taani ne wogaa naaganaw koyay.<verse eid="PSA 119:94" /></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95" />Iitatuu taana d'ayissanaw kuukuliide naagiino;</para>
  <para style="q2" vid="PSA 119:95">shin taani neeni odeeddawaa k'oppay.<verse eid="PSA 119:95" /></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96" />Polo geetettobaw ubbabaw zaway de'iyaawaa taani be'aad;</para>
  <para style="q2" vid="PSA 119:96">shin ne higgiyaw zaway baawa.<verse eid="PSA 119:96" /></para>
  <para style="qa">Meem</para>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97" />Taani ne higgiyaa waata dosayttaa!</para>
  <para style="q1" vid="PSA 119:97">Gallassaa kumentsaa taani k'oppiyaawe Aa.<verse eid="PSA 119:97" /></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98" />Ne azazotuu ubbaa wodekka taananna de'iyaa diraw,</para>
  <para style="q2" vid="PSA 119:98">unttunttu taana ta morkkatuwaappe aad'd'eeda eranchcha kessiino.<verse eid="PSA 119:98" /></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99" />Taani neeni odeeddawaa k'oppiyaa diraw,</para>
  <para style="q2" vid="PSA 119:99">taana tamaarisseedda ubbaappekka aad'd'eeda akeekay taw de'ee.<verse eid="PSA 119:99" /></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100" />Taani ne wogaw azazettiyaa diraw,</para>
  <para style="q2" vid="PSA 119:100">c'imatuwaappe aatsaade akeekay.<verse eid="PSA 119:100" /></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101" />Taani ne k'aalaw azazettanaw koyiyaa diraw,</para>
  <para style="q2" vid="PSA 119:101">ta gediyaa iita ogiyaa ubbaappe naagaad.<verse eid="PSA 119:101" /></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102" />Neeni taana tamaarisseedda diraw,</para>
  <para style="q2" vid="PSA 119:102">taani ne pirddaappe wora babeykke.<verse eid="PSA 119:102" /></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103" />Ne k'aalay ayaa mal"ii!</para>
  <para style="q2" vid="PSA 119:103">Eessaa ililuwaappekka aad'd'iide,</para>
  <para style="q2" vid="PSA 119:103">ta doonaan mal"ee.<verse eid="PSA 119:103" /></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104" />Ne wogaappe akeekaa demmaad;</para>
  <para style="q2" vid="PSA 119:104">hewaa diraw, taani geella ogiyaa ubbaa is's'ay.<verse eid="PSA 119:104" /></para>
  <para style="qa">Noon</para>
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105" />Ne k'aalay ta gediyaw s'omppiyaa,</para>
  <para style="q2" vid="PSA 119:105">ta ogiyawukka poo'uwaa.<verse eid="PSA 119:105" /></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106" />Ne s'illo pirddaadan de'anaw,</para>
  <para style="q2" vid="PSA 119:106">taani c'aak'k'eedda c'aak'uwaa mintsana.<verse eid="PSA 119:106" /></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107" />Taani daro tuggataad;</para>
  <para style="q2" vid="PSA 119:107">abeet Med'inaa Godaw, neeni geedda k'aalaadan</para>
  <para style="q2" vid="PSA 119:107">taana pas'a wotsa.<verse eid="PSA 119:107" /></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108" />Abeet Med'inaa Godaw, ta doonaappe kesiyaa galataa, yarshshuwaa akka;</para>
  <para style="q2" vid="PSA 119:108">taana pirddaa tamaarissa.<verse eid="PSA 119:108" /></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109" />Ta shemppu metuwaa bollaa de'inttokka,</para>
  <para style="q2" vid="PSA 119:109">taani ne higgiyaa dogikke.<verse eid="PSA 119:109" /></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110" />Iitatuu taw gitiyaa yeggeeddino;</para>
  <para style="q2" vid="PSA 119:110">shin taani ne wogaappe sher"i gabeykke.<verse eid="PSA 119:110" /></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111" />Neeni odeeddabay med'inaw tawaa;</para>
  <para style="q2" vid="PSA 119:111">ee, I ta wozanaw nashshechchaa.<verse eid="PSA 119:111" /></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112" />Taani med'inaw, wurssetsaa gakkanaw</para>
  <para style="q2" vid="PSA 119:112">ne awaayuwaadan ootsanaw k'achchaad.<verse eid="PSA 119:112" /></para>
  <para style="qa">Samkket</para>
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113" />Taani laa"u k'ofay de'iyaa asatuwaa is's'ay;</para>
  <para style="q2" vid="PSA 119:113">shin ne higgiyaa siik'ay.<verse eid="PSA 119:113" /></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114" />Neeni taw k'osetta attiyaa saanne</para>
  <para style="q2" vid="PSA 119:114">ta gonddalliyaa;</para>
  <para style="q2" vid="PSA 119:114">taani ne k'aalan hidootaa ootsay.<verse eid="PSA 119:114" /></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115" />Taani ta S'oossaa azazuwaa naagana mala,</para>
  <para style="q2" vid="PSA 119:115">hinttenoo, iitabaa ootsiyaawanttoo,</para>
  <para style="q2" vid="PSA 119:115">taappe haakkite!<verse eid="PSA 119:115" /></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116" />Neeni geedda k'aalaadan taana minisa;</para>
  <para style="q2" vid="PSA 119:116">yaatooppe, taani pas'a de'ana.</para>
  <para style="q1" vid="PSA 119:116">Taani hidootan naagiyaaban taana yeellayoppa.<verse eid="PSA 119:116" /></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117" />Taana zemppissa; yaatooppe,</para>
  <para style="q2" vid="PSA 119:117">taani saro de'ana;</para>
  <para style="q2" vid="PSA 119:117">taani ubbaa wode ne awaayuwaa hayzzana.<verse eid="PSA 119:117" /></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118" />Ne awaayuwaappe wora biyaawantta ubbaa neeni akkakka;</para>
  <para style="q2" vid="PSA 119:118">unttunttu c'imuu c'oo mela.<verse eid="PSA 119:118" /></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119" />Sa'aan de'iyaa iitatuwaa ubbaa</para>
  <para style="q2" vid="PSA 119:119">neeni pituwaadan paydaasa;</para>
  <para style="q2" vid="PSA 119:119">hewaa diraw, taani neeni odeeddabaa siik'ay.<verse eid="PSA 119:119" /></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120" />Ta bollay new yayyiide kokkoreedda;</para>
  <para style="q2" vid="PSA 119:120">taani ne pirddaw yayyay.<verse eid="PSA 119:120" /></para>
  <para style="qa">Ee</para>
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121" />Likkebaanne s'illobaa ootsaad;</para>
  <para style="q2" vid="PSA 119:121">Taana uk'k'unniyaawanttoo oloppa.<verse eid="PSA 119:121" /></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122" />Taana ne k'oomaa maaddanaw waase gida;</para>
  <para style="q2" vid="PSA 119:122">Taana otoranchchatuwaan uk'k'unnissoppa.<verse eid="PSA 119:122" /></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123" />Neeni, «neena ashshana»</para>
  <para style="q2" vid="PSA 119:123">geedda s'illo k'aalaa polo gaade naagishin,</para>
  <para style="q2" vid="PSA 119:123">ta ayifii galjjeedda.<verse eid="PSA 119:123" /></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124" />Taw, ne k'oomaw, neeni</para>
  <para style="q2" vid="PSA 119:124">aggena ne siik'uwaadan ootsa;</para>
  <para style="q2" vid="PSA 119:124">ne awaayuwaakka taana tamaarissa.<verse eid="PSA 119:124" /></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125" />Taani ne k'oomaa;</para>
  <para style="q2" vid="PSA 119:125">neeni odiyaabaa taani erana mala,</para>
  <para style="q2" vid="PSA 119:125">akeekaa taw imma.<verse eid="PSA 119:125" /></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126" />Abeet Med'inaa Godaw, asatuu</para>
  <para style="q2" vid="PSA 119:126">ne higgiyaa mentseedda diraw,</para>
  <para style="q2" vid="PSA 119:126">neeni pirddana wodii ha"a.<verse eid="PSA 119:126" /></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127" />Taani ne azazuwaa</para>
  <para style="q2" vid="PSA 119:127">work'k'aappe aatsaade siik'ay;</para>
  <para style="q1" vid="PSA 119:127">Ee, geeshsha work'k'aappekka aatsaade siik'ay.<verse eid="PSA 119:127" /></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128" />Hewaa diraw, taani</para>
  <para style="q2" vid="PSA 119:128">ne wogatuu ubbay giyaawaadan hamettay;</para>
  <para style="q2" vid="PSA 119:128">geella ogiyaa ubbaa taani is's'ay.<verse eid="PSA 119:128" /></para>
  <para style="qa">Pe</para>
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129" />Neeni odeeddabay malalissiyaabaa;</para>
  <para style="q2" vid="PSA 119:129">hewaa diraw, taani aw azazettay.<verse eid="PSA 119:129" /></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130" />Ne k'aalaa biletsay poo'uwaa immee;</para>
  <para style="q2" vid="PSA 119:130">akeekay pac'c'eeddawanttoo akeekaa immee.<verse eid="PSA 119:130" /></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131" />Taani ne azazoo,</para>
  <para style="q2" vid="PSA 119:131">daro saamettaade ta doonaa dooyay.<verse eid="PSA 119:131" /></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132" />Haa taakko simma;</para>
  <para style="q2" vid="PSA 119:132">ne suntsaa siik'iyaawanttu ubbaw</para>
  <para style="q2" vid="PSA 119:132">neeni ootsiyaawaadan tawukka k'aretta.<verse eid="PSA 119:132" /></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133" />Neeni geedda k'aalaadan</para>
  <para style="q2" vid="PSA 119:133">ta hemetaa suurissa;</para>
  <para style="q2" vid="PSA 119:133">ay nagaraynne taana mooddoppo.<verse eid="PSA 119:133" /></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134" />Taani ne wogaw azazettanaw,</para>
  <para style="q2" vid="PSA 119:134">taana uk'k'unneeddawanttu kushiyaappe woza.<verse eid="PSA 119:134" /></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135" />Ta bolla, ne k'oomaa bolla,</para>
  <para style="q2" vid="PSA 119:135">ne som"uwaa poo'issa;</para>
  <para style="q2" vid="PSA 119:135">ne awaayuwaakka tamaarissa.<verse eid="PSA 119:135" /></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136" />Ne higgiyaw Asay azazettibeena diraw,</para>
  <para style="q2" vid="PSA 119:136">ta ayifiyaappe afotsay shaafaadan goggee.<verse eid="PSA 119:136" /></para>
  <para style="qa">S'aade</para>
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137" />Abeet Med'inaa Godaw, neeni s'illuwaa;</para>
  <para style="q2" vid="PSA 119:137">ne pirddaykka likke.<verse eid="PSA 119:137" /></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138" />Neeni odeeddabay</para>
  <para style="q2" vid="PSA 119:138">s'illuwaanne ubbaa ammanettiyaawaa.<verse eid="PSA 119:138" /></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139" />Ta morkketuu ne k'aalaa toochcheedda diraw,</para>
  <para style="q2" vid="PSA 119:139">ne k'aalaa mishuu ta gomppan ees's'i keseedda.<verse eid="PSA 119:139" /></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140" />Neeni geedda k'aalay daroppe ammanettiyaawaa;</para>
  <para style="q2" vid="PSA 119:140">taani, ne k'oomay Aa siik'ay.<verse eid="PSA 119:140" /></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141" />Taani guutsanne kad'etteedda asaa;</para>
  <para style="q2" vid="PSA 119:141">gidooppenne, taani ne wogaa dogikke.<verse eid="PSA 119:141" /></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142" />Ne s'illotetsay med'inaw de'ee;</para>
  <para style="q2" vid="PSA 119:142">ne higgiikka tuma.<verse eid="PSA 119:142" /></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143" />Metuunne tuggay taana gakkeedda;</para>
  <para style="q2" vid="PSA 119:143">shin ne azazotuu taana nashechchiino.<verse eid="PSA 119:143" /></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144" />Neeni odeeddabay med'inawukka s'illuwaa;</para>
  <para style="q2" vid="PSA 119:144">taani pas'a de'ana mala, akeekaa taw imma.<verse eid="PSA 119:144" /></para>
  <para style="qa">K'of</para>
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145" />Abeet Med'inaa Godaw, kumentsaa wozanaappe,</para>
  <para style="q2" vid="PSA 119:145">new waassaad; taw alla.</para>
  <para style="q1" vid="PSA 119:145">Taanikka ne awaayuwaa azazettana.<verse eid="PSA 119:145" /></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146" />Taani new waassaad; taana ashsha;</para>
  <para style="q2" vid="PSA 119:146">taanikka neeni odeeddabaa ootsana.<verse eid="PSA 119:146" /></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147" />S'alk'k'ii dolenna guuran denddaade,</para>
  <para style="q2" vid="PSA 119:147">«Taana maadda» gaade new waassay.</para>
  <para style="q1" vid="PSA 119:147">Neeni taw geedda k'aalan hidootaa ootsay.<verse eid="PSA 119:147" /></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148" />Ne k'aalaabaa zaara zaaraadde k'oppanaw,</para>
  <para style="q2" vid="PSA 119:148">k'amma utta ak'ay.<verse eid="PSA 119:148" /></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149" />Abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 119:149">aggena ne siik'uwaa diraw, tawaa sisa;</para>
  <para style="q2" vid="PSA 119:149">ne s'illo pirddaadan taana pas'a wotsa.<verse eid="PSA 119:149" /></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150" />Iitabaw taana yederssiyaawanttu,</para>
  <para style="q2" vid="PSA 119:150">taakko mateeddino;</para>
  <para style="q2" vid="PSA 119:150">unttunttu ne higgiyaappe haakkiino.<verse eid="PSA 119:150" /></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151" />Shin abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 119:151">neeni ta matan de'aassa;</para>
  <para style="q2" vid="PSA 119:151">ne azazotuu ubbaykka tuma.<verse eid="PSA 119:151" /></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152" />Taani benippe doommaade,</para>
  <para style="q2" vid="PSA 119:152">neeni odeeddabaa tamaaraad;</para>
  <para style="q1" vid="PSA 119:152">Aa neeni med'inaw minisa essaadda.<verse eid="PSA 119:152" /></para>
  <para style="qa">Reesh</para>
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153" />Ta tuggaa be'aade, taana ashsha;</para>
  <para style="q2" vid="PSA 119:153">ayaw gooppe, taani ne higgiyaa dogabeykke.<verse eid="PSA 119:153" /></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154" />Ta diraw mootettaade taana woza;</para>
  <para style="q2" vid="PSA 119:154">neeni geedda k'aalaadan taana pas'a wotsa.<verse eid="PSA 119:154" /></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155" />Ne awaayuwaa unttunttu akkena diraw,</para>
  <para style="q2" vid="PSA 119:155">atotetsay iitatuwaappe haakuwaan de'ee.<verse eid="PSA 119:155" /></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156" />Abeet Med'inaa Godaw, ne k'aretay dara;</para>
  <para style="q2" vid="PSA 119:156">ne s'illo pirddaadan taana pas'a wotsa.<verse eid="PSA 119:156" /></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157" />Ta morkketuunne taana yederssiyaawanttu dara;</para>
  <para style="q2" vid="PSA 119:157">shin taani neeni odeeddawaappe sher"i giikke.<verse eid="PSA 119:157" /></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158" />Unttunttu ne azazotuwaa naagenna diraw,</para>
  <para style="q2" vid="PSA 119:158">taani kaddiyaawantta be'aade shenetaad.<verse eid="PSA 119:158" /></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159" />Abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 119:159">taani ne wogaa siik'iyaa siik'uwaa k'oppa;</para>
  <para style="q2" vid="PSA 119:159">aggena ne siik'uwaadan taana pas'a wotsa.<verse eid="PSA 119:159" /></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160" />Ne k'aalay koyiroppekka tuma;</para>
  <para style="q2" vid="PSA 119:160">ne s'illo pirdday ubbaykka med'inaw de'ee.<verse eid="PSA 119:160" /></para>
  <para style="qa">Shiin</para>
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161" />Kaappatuu taana c'oo yederssiino;</para>
  <para style="q2" vid="PSA 119:161">shin ta wozanay ne k'aalaw yayyee.<verse eid="PSA 119:161" /></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162" />Darobaa omoodeedda Asay nashettiyaawaadan,</para>
  <para style="q2" vid="PSA 119:162">neeni geedda k'aalan taani nashetay.<verse eid="PSA 119:162" /></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163" />Taani wordduwaa is's'aynne shenetay;</para>
  <para style="q2" vid="PSA 119:163">shin ne higgiyaa siik'ay.<verse eid="PSA 119:163" /></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164" />Ne s'illo pirddaa diraw,</para>
  <para style="q2" vid="PSA 119:164">taani neena gallassan laappu gede galatay.<verse eid="PSA 119:164" /></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165" />Ne higgiyaa siik'iyaawanttoo</para>
  <para style="q2" vid="PSA 119:165">kumentsaa sarotetsay de'ee;</para>
  <para style="q2" vid="PSA 119:165">unttuntta ubbakka ayaynne d'ubbanaw danddayenna.<verse eid="PSA 119:165" /></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166" />Abeet Med'inaa Godaw, taani</para>
  <para style="q2" vid="PSA 119:166">ne atotetsaa hidootaan naagay;</para>
  <para style="q2" vid="PSA 119:166">ne azazotuwaakka ootsay.<verse eid="PSA 119:166" /></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167" />Taani neeni odeeddabaa naagay;</para>
  <para style="q2" vid="PSA 119:167">taani daroppe Aa siik'ay.<verse eid="PSA 119:167" /></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168" />Taani ne wogawunne</para>
  <para style="q2" vid="PSA 119:168">neeni odeeddawoo azazettana;</para>
  <para style="q2" vid="PSA 119:168">ayaw gooppe, ta ogiyaa ubbaa neeni be'aasa.<verse eid="PSA 119:168" /></para>
  <para style="qa">Taw</para>
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169" />Abeet Med'inaa Godaw, ta waasuu,</para>
  <para style="q2" vid="PSA 119:169">ne sintsa gakko;</para>
  <para style="q2" vid="PSA 119:169">neeni geedda k'aalaadan taw akeekaa imma.<verse eid="PSA 119:169" /></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170" />Ta watiwatuu ne sintsa gakko;</para>
  <para style="q2" vid="PSA 119:170">neeni geedda k'aalaadan taana ashsha.<verse eid="PSA 119:170" /></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171" />Neeni ne awaayuwaa</para>
  <para style="q2" vid="PSA 119:171">taana tamaarissiyaa diraw,</para>
  <para style="q2" vid="PSA 119:171">ta doonaappe galatay pulttana.<verse eid="PSA 119:171" /></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172" />Ne azazotuu ubbay s'illo gidiyaa diraw,</para>
  <para style="q2" vid="PSA 119:172">ta ins's'arssay ne k'aalaabaa yes's'ana.<verse eid="PSA 119:172" /></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173" />Taani ne wogaa dooreedda diraw,</para>
  <para style="q2" vid="PSA 119:173">ne kushii taana maaddanaw giigeeddawaa gido.<verse eid="PSA 119:173" /></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174" />Abeet Med'inaa Godaw, neeni</para>
  <para style="q2" vid="PSA 119:174">taana ashshana mala laamotay;</para>
  <para style="q2" vid="PSA 119:174">ne higgiikka taana nashechchee.<verse eid="PSA 119:174" /></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175" />Taani neena galatana mala,</para>
  <para style="q2" vid="PSA 119:175">taana pas'a wotsa;</para>
  <para style="q2" vid="PSA 119:175">ne pirddaykka taana maaddo.<verse eid="PSA 119:175" /></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176" />Taani bayeedda dorssaadan bichchaaray;</para>
  <para style="q2" vid="PSA 119:176">taana ne k'oomaa koya;</para>
  <para style="q2" vid="PSA 119:176">ayaw gooppe, taani ne azazuwaa dogabeykke.<verse eid="PSA 119:176" /></para>
  <chapter eid="PSA 119" />
  <chapter number="120" style="c" sid="PSA 120" />
  <para style="s">C'imiyaawanttuppenne Worddotuwaappe <optbreak />Attanaw Shiik'o Woosaa</para>
  <para style="d">Pudetsaa kesiidde yes's'eedda yetsaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1" />Ta waayiyaa wode taani Med'inaa Godaa s'eesaad;</para>
  <para style="q2" vid="PSA 120:1">I taw koyeedda.<verse eid="PSA 120:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2" />Abeet Med'inaa Godaw, worddotiyaa doonatuwaappenne,</para>
  <para style="q2" vid="PSA 120:2">c'immiyaa ins's'arssatuwaappe taana ashsha.<verse eid="PSA 120:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3" />Hinttenoo worddanchchatoo,</para>
  <para style="q2" vid="PSA 120:3">S'oossay hinttena waatanddeeshsha?</para>
  <para style="q1" vid="PSA 120:3">Simmi harabaa ayaa gujjanddeeshsha?<verse eid="PSA 120:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4" />Tooranchchatuwaa pootsaa k'aran I hinttena c'addanawaa;</para>
  <para style="q2" vid="PSA 120:4">tamaa bonk'k'uwaan I hinttena s'uuggana.<verse eid="PSA 120:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5" />Aayye taanoo! Hinttenana de'iyaawe Mesheka</para>
  <para style="q2" vid="PSA 120:5">woy K'eedaare asaana de'iyaawaa mala iita.<verse eid="PSA 120:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6" />Sarotetsaa is's'iyaa asatuwaana</para>
  <para style="q2" vid="PSA 120:6">taani daro wodiyaa de'aaddi.<verse eid="PSA 120:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7" />Taani saro asaa;</para>
  <para style="q2" vid="PSA 120:7">shin taani sarotetsaabaa haasayiyaa wode,</para>
  <para style="q2" vid="PSA 120:7">unttunttu olaawaa haasayiino!<verse eid="PSA 120:7" /></para>
  <chapter eid="PSA 120" />
  <chapter number="121" style="c" sid="PSA 121" />
  <para style="s">S'oossay Nuuna Naagiyaawaa</para>
  <para style="d">Pudetsaa kesiidde yes's'eedda yetsaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1" />Taani d'ok'k'u gaade wogga deretuwaa s'eellay;</para>
  <para style="q2" vid="PSA 121:1">taw maaduu hak'appe yanddeeshsha?<verse eid="PSA 121:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2" />Taw maaduu</para>
  <para style="q2" vid="PSA 121:2">saluwaanne sa'aa med'd'eedda Med'inaa Godaappe yee.<verse eid="PSA 121:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3" />I ne gediyaa halis'issenna;</para>
  <para style="q2" vid="PSA 121:3">neena naagiyaawe gem"ishenna.<verse eid="PSA 121:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4" />Israa'eeliyaa naagiyaawe,</para>
  <para style="q2" vid="PSA 121:4">ubbakka gisennanne gem"ishenna.<verse eid="PSA 121:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5" />Med'inaa Goday neena naagiyaawaa.</para>
  <para style="q2" vid="PSA 121:5">Med'inaa Goday new ushechcha baggana gidiide,</para>
  <para style="q2" vid="PSA 121:5">neena kuwayiyaawaa.<verse eid="PSA 121:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6" />Gallassi neena away meenna;</para>
  <para style="q2" vid="PSA 121:6">k'ammakka aginay neena k'ohenna.<verse eid="PSA 121:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7" />Med'inaa Goday k'ohiyaawaa ubbaappe neena naagana;</para>
  <para style="q2" vid="PSA 121:7">I ne shemppuwaa naagana.<verse eid="PSA 121:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8" />Med'inaa Goday ne buussaa, ne yuussaa,</para>
  <para style="q2" vid="PSA 121:8">hachcheppe med'inaa gakkanaw naagana.<verse eid="PSA 121:8" /></para>
  <chapter eid="PSA 121" />
  <chapter number="122" style="c" sid="PSA 122" />
  <para style="s">Yerusaalamiw Shiik'eedda Sabaa</para>
  <para style="d">Pudetsaa kesiidde yes's'eedda yetsaa, Daawite s'aafeeddawaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1" />Unttunttu taana, «Ane Med'inaa Godaa golliyaa boytte» yaagina,</para>
  <para style="q2" vid="PSA 122:1">taani nashetaad.<verse eid="PSA 122:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2" />Neenoo Yerusaalame katamatee,</para>
  <para style="q2" vid="PSA 122:2">nuuni ne penggetuwaanna geliide ek'k'eeddo!<verse eid="PSA 122:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3" />Yerusaalame katamay,</para>
  <para style="q2" vid="PSA 122:3">dantsetiide minni kees'etteedda katamaa.<verse eid="PSA 122:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4" />Med'inaa Godaa awaayuwaadan,</para>
  <para style="q2" vid="PSA 122:4">Israa'eeliyaa zaratuu,</para>
  <para style="q1" vid="PSA 122:4">Med'inaa Godaa galatanaw yiyaa katamay hawaa.<verse eid="PSA 122:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5" />Daawita zeretsaappe kaateteeddawanttu</para>
  <para style="q2" vid="PSA 122:5">barenttu asaw pirddanaw yaan utteeddino.<verse eid="PSA 122:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6" />Yerusaalame sarotetsaw</para>
  <para style="q2" vid="PSA 122:6">hawaadan yaagiide woossite;</para>
  <para style="q1" vid="PSA 122:6">«Neena siik'iyaawanttoo</para>
  <para style="q2" vid="PSA 122:6">unttunttu ootsiyaawe ubbay suuro!<verse eid="PSA 122:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7" />Ne gimbbetuwaa giddon saruu de'o!</para>
  <para style="q2" vid="PSA 122:7">Ne geesatuwaakka bochchiyaabay d'ayo!» yaagiide woossite.<verse eid="PSA 122:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8" />Ta ishatuwaanne ta dabbotuwaa diraw gaade,</para>
  <para style="q2" vid="PSA 122:8">«Ne giddon saruu de'o!» yaagay.<verse eid="PSA 122:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9" />Med'inaa Godaa nu S'oossaa golliyaa diraw gaade,</para>
  <para style="q2" vid="PSA 122:9">taani Yerusaalame durettanaw woosana.<verse eid="PSA 122:9" /></para>
  <chapter eid="PSA 122" />
  <chapter number="123" style="c" sid="PSA 123" />
  <para style="s">Maarotaa Demanaw Shiishsho Woosaa</para>
  <para style="d">Pudetsaa kesiidde yes's'eedda yetsaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1" />Neenoo, kawutetsaa araatan saluwaan utteeddawoo,</para>
  <para style="q2" vid="PSA 123:1">taani pude neekko s'eellay.<verse eid="PSA 123:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2" />K'oomay bare godaa kushiyaa s'eelliyaawaadaaninne</para>
  <para style="q2" vid="PSA 123:2">k'oomata bare godatti kushiyaa s'eelliyaawaadan,</para>
  <para style="q2" vid="PSA 123:2">hewaadankka I nuuna maarana gakkanaw,</para>
  <para style="q2" vid="PSA 123:2">nu ayifii Med'inaa Godaakko, nu S'oossaakko, s'eellee.<verse eid="PSA 123:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3" />Nuuna maara; abeet Med'inaa Godaw, nuuna maara.</para>
  <para style="q2" vid="PSA 123:3">Ayaw gooppe, nuw kad'ii dareedda.<verse eid="PSA 123:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4" />Nuuni ishaluwaan de'iyaawanttu shek'aanne</para>
  <para style="q2" vid="PSA 123:4">otoranchchatuwaa kad'iyaa kalleeddo.<verse eid="PSA 123:4" /></para>
  <chapter eid="PSA 123" />
  <chapter number="124" style="c" sid="PSA 124" />
  <para style="s">S'oossay Israa'eeliyaa Ashiyaawaa</para>
  <para style="d">Pudetsaa kesiidde yes's'eedda yetsaa, Daawite s'aafeeddawaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1" />Med'inaa Goday nu bagga gidennentto, nuuni waananeeshsha?</para>
  <para style="q2" vid="PSA 124:1">Israa'eeliyaa asatuu zaaruwaa hawaadan yaagiide zaariino;<verse eid="PSA 124:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2" />«Med'inaa Goday nu bagga gidennentto,</para>
  <para style="q2" vid="PSA 124:2">nu bollan Asay denddeedda wode,<verse eid="PSA 124:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 124:3" />unttunttu nu bollan hank'k'uwaa suulliide,</para>
  <para style="q2" vid="PSA 124:3">nuuna pas'a mittana shin.<verse eid="PSA 124:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4" />Di'uu nuuna meec'c'iide;</para>
  <para style="q2" vid="PSA 124:4">shaafaa haatsay nuuna muukkana shin;<verse eid="PSA 124:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5" />kuntso haatsay nuuna maana shin» yaagino.<verse eid="PSA 124:5" /></para>
  <para style="b" />
  <para style="q2">
    <verse number="6" style="v" sid="PSA 124:6" />Nuuna nu morkkatuwaa matan,</para>
  <para style="q2" vid="PSA 124:6">s'oonissibeenna Med'inaa Goday galatetto.<verse eid="PSA 124:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7" />Nuuni shankkanchchatuwaa p'iriyaappe,</para>
  <para style="q2" vid="PSA 124:7">kafuu kessi akkiyaawaadan kessi akkeeddo.</para>
  <para style="q1" vid="PSA 124:7">P'irii me"eedda, nuunikka kessi akki atteedo!<verse eid="PSA 124:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8" />Nu maaduu</para>
  <para style="q2" vid="PSA 124:8">saluwaanne sa'aa med'd'eedda Med'inaa Godaa suntsaappe yee.<verse eid="PSA 124:8" /></para>
  <chapter eid="PSA 124" />
  <chapter number="125" style="c" sid="PSA 125" />
  <para style="s">S'oossay Bare Asaw Waase</para>
  <para style="d">Pudetsaa kesiidde yes's'eedda yetsaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1" />Med'inaa Godaan ammanettiyaawanttu k'aas's'anaw danddayenna,</para>
  <para style="q2" vid="PSA 125:1">med'inaw de'iyaa S'iyoone deriyaa mala.<verse eid="PSA 125:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2" />Deretuu</para>
  <para style="q2" vid="PSA 125:2">Yerusaalame katamaa yuushshuwaan de'iyaawaadan,</para>
  <para style="q2" vid="PSA 125:2">hachcheppe med'inaa gakkanaw,</para>
  <para style="q2" vid="PSA 125:2">Med'inaa Goday bare asaa yuushshuwaan de'ee.<verse eid="PSA 125:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3" />S'illotuu barenttu kushshiyaa iitatetsaw dentsenna mala,</para>
  <para style="q2" vid="PSA 125:3">iitatuwaa ayissuwaa s'am"ay,</para>
  <para style="q2" vid="PSA 125:3">s'illotoo imetteedda biittaa bollan gam"enna.<verse eid="PSA 125:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4" />Abeet Med'inaa Godaw, keeka asatoonne,</para>
  <para style="q2" vid="PSA 125:4">wozanaa suure asatoo keekkabaa ootsa.<verse eid="PSA 125:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5" />Barenttu geella ogiyaa simmiyaawantta,</para>
  <para style="q2" vid="PSA 125:5">Med'inaa Goday iitaa ootsiyaawanttuna ittippe mura.</para>
  <para style="q1" vid="PSA 125:5">Israa'eeliyaw saruu gido!<verse eid="PSA 125:5" /></para>
  <chapter eid="PSA 125" />
  <chapter number="126" style="c" sid="PSA 126" />
  <para style="s">Omooduwaappe Simmeeddawanttu Mazimuriyaa</para>
  <para style="d">Pudetsaa kesiidde yes's'eedda yetsaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1" />Med'inaa Goday nuuna omoodetteeddawantta zaariide,</para>
  <para style="q2" vid="PSA 126:1">S'iyoone aheedda wode, nuw akumuwaa malateedda.<verse eid="PSA 126:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2" />He wode nuuni daro nashetti, miic'c'iide,</para>
  <para style="q2" vid="PSA 126:2">nashshechchaa yetsaa yes's'eeddo.</para>
  <para style="q1" vid="PSA 126:2">Yaatina, hara kawutetsatuu barenttu giddon,</para>
  <para style="q2" vid="PSA 126:2">«Hawanttoo Med'inaa Goday wolk'k'aamabaa ootseedda» yaageeddino.<verse eid="PSA 126:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3" />Tumukka Med'inaa Goday nuw wolk'k'aamabaa ootseedda;</para>
  <para style="q2" vid="PSA 126:3">nuunikka loytsi nashetteeddo.<verse eid="PSA 126:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4" />Abeet Med'inaa Godaw, Neegeeba Bazzuwaan iraa bukissaade,</para>
  <para style="q2" vid="PSA 126:4">shaafaa haatsaa zaara kuntsiyaawaadan,</para>
  <para style="q2" vid="PSA 126:4">nuwukka nu kaac'aa ooratsa.<verse eid="PSA 126:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5" />Yeekkiide zereeddawanttu,</para>
  <para style="q2" vid="PSA 126:5">nashshechchan yes's'iidde c'akkana.<verse eid="PSA 126:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6" />Zeretsaa tookkiide, yeekkiidde beeddawanttu,</para>
  <para style="q2" vid="PSA 126:6">nashshechchaa yetsaa yes's'iidde,</para>
  <para style="q2" vid="PSA 126:6">mirk'k'iyaa tookkiide simmana.<verse eid="PSA 126:6" /></para>
  <chapter eid="PSA 126" />
  <chapter number="127" style="c" sid="PSA 127" />
  <para style="s">S'oossaan Ammanetanaaddan Imetteedda Zoriyaa</para>
  <para style="d">Pudetsaa kesiidde yes's'eedda yetsaa, Solomon s'aafeeddawaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1" />Med'inaa Goday golliyaa kees's'ana d'ayooppe,</para>
  <para style="q2" vid="PSA 127:1">kees's'iyaawanttu c'oo mela daaburiino.</para>
  <para style="q1" vid="PSA 127:1">Med'inaa Goday katamaa naagana d'ayooppe,</para>
  <para style="q2" vid="PSA 127:1">naagiyaawanttu c'oo mela naagiino.<verse eid="PSA 127:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2" />Neeni wontta guuran denddiyaawe,</para>
  <para style="q2" vid="PSA 127:2">omarssi k'amissaade gisiyaawe,</para>
  <para style="q2" vid="PSA 127:2">k'umaw hirggaade tuggatiyaawe c'oo mela;</para>
  <para style="q2" vid="PSA 127:2">ayaw gooppe, S'oossay bare siik'iyaawanttoo shemppuwaa immee.<verse eid="PSA 127:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3" />Naanay Med'inaa Godaappe imettiyaa imotaa;</para>
  <para style="q2" vid="PSA 127:3">yelotuu tumuwaappe woytuwaa.<verse eid="PSA 127:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4" />Itti uray bare yalagatetsan yeleedda attuma naanatuu,</para>
  <para style="q2" vid="PSA 127:4">olanchchaa kushiyan de'iyaa tooratuwaa mala.<verse eid="PSA 127:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5" />He k'arc'c'iitan de'iyaa wonddaafiyaa tooratuwaadan,</para>
  <para style="q2" vid="PSA 127:5">daro naanatuu de'iyaa Asay anjjetteeddawaa.</para>
  <para style="q1" vid="PSA 127:5">Ayaw gooppe, I bare morkkatuwaanna,</para>
  <para style="q2" vid="PSA 127:5">katamaa penggiyaan mootettiyaa wode, ubbakka s'oonettenna.<verse eid="PSA 127:5" /></para>
  <chapter eid="PSA 127" />
  <chapter number="128" style="c" sid="PSA 128" />
  <para style="s">S'oossaw Azazetussaan Beetiyaa Anjjuwaa</para>
  <para style="d">Pudetsaa kesiidde yes's'eedda yetsaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1" />Med'inaa Godaw yayyiyaawanttunne,</para>
  <para style="q2" vid="PSA 128:1">Aa ogiyaan hamettiyaawanttu ubbay anjjetteedawantta.<verse eid="PSA 128:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2" />Neeni ne daaburaa ayifiyaa maana;</para>
  <para style="q2" vid="PSA 128:2">neeni nashettananne new lo"o gidana.<verse eid="PSA 128:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3" />Ne machata ne son ayifiyaa dorkkokkeedda,</para>
  <para style="q2" vid="PSA 128:3">woyniyaa turaa mala gidana.</para>
  <para style="q1" vid="PSA 128:3">Ne naanatuukka ne gaytaa yuushshuwaan,</para>
  <para style="q2" vid="PSA 128:3">wogaraa puutiyaa mala gidana.<verse eid="PSA 128:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4" />Med'inaa Godaw yayyiyaa asay</para>
  <para style="q2" vid="PSA 128:4">tumuwaappe hewaadan anjjettana.<verse eid="PSA 128:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5" />Med'inaa Goday neena S'iyooneppe anjjo!</para>
  <para style="q2" vid="PSA 128:5">Neeni de'eedda laytsaa ubbaan</para>
  <para style="q1" vid="PSA 128:5">Yerusaalame lo"otetsaa neena besso.<verse eid="PSA 128:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6" />Ne naanatuwaa naanatuwaa be'a!</para>
  <para style="b" vid="PSA 128:6" />
  <para style="q2" vid="PSA 128:6">Israa'eeliyaw saruu gido!<verse eid="PSA 128:6" /></para>
  <chapter eid="PSA 128" />
  <chapter number="129" style="c" sid="PSA 129" />
  <para style="s">Israa'eelii Morkkiyaappe Attanaw Shiishsho Woosaa</para>
  <para style="d">Pudetsaa kesiidde yes's'eedda yetsaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1" />Israa'eeliyaa Asay hawaadan yaago;</para>
  <para style="q2" vid="PSA 129:1">«Unttunttu ta yalagatetsaadeppe doommiide,</para>
  <para style="q2" vid="PSA 129:1">taana uk'k'inneeddino.<verse eid="PSA 129:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2" />Ee, unttunttu ta yalagatetsaadeppe doommiide,</para>
  <para style="q2" vid="PSA 129:2">taana uk'k'inneeddino;</para>
  <para style="q2" vid="PSA 129:2">shin unttunttu taana d'ayissibeykkino.<verse eid="PSA 129:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3" />Ta zokkiyaa k'ays's'eeriyaan shoc'i shoc'iide,</para>
  <para style="q2" vid="PSA 129:3">gosheedda shoyk'aa malatisseeddino» yaago.<verse eid="PSA 129:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4" />Shin Med'inaa Goday s'illo gideeddawe</para>
  <para style="q2" vid="PSA 129:4">iitatuwaa k'ashuwaappe taana billi yeddeedda.<verse eid="PSA 129:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5" />S'iyoone is's'iyaa ubbay,</para>
  <para style="q2" vid="PSA 129:5">yeellatiide guyye simmo.<verse eid="PSA 129:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6" />Golliyaa huup'iyaan mokkiide,</para>
  <para style="q2" vid="PSA 129:6">dic'c'anaappe kasetiide meliyaa maataa mala gido.<verse eid="PSA 129:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7" />He maataa buuc'c'anaw kushiyaan dankkiyaawe,</para>
  <para style="q2" vid="PSA 129:7">woy mirk'k'iyaa k'achchiyaawe ooninne baawa.<verse eid="PSA 129:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8" />He ogiyaanna aad'd'iyaawanttu,</para>
  <para style="q2" vid="PSA 129:8">«Med'inaa Goday wolk'k'aa immo» giina, c'akkiyaawanttu,</para>
  <para style="q1" vid="PSA 129:8">«Med'inaa Goday anjjo» giyaawe de'enna.<verse eid="PSA 129:8" /></para>
  <chapter eid="PSA 129" />
  <chapter number="130" style="c" sid="PSA 130" />
  <para style="s">Maaduwaa demanaw Shiik'eedda Woosaa</para>
  <para style="d">Pudetsaa kesiidde yes's'eedda yetsaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1" />Abeet Med'inaa Godaw, taani metuwaa c'iimman de'aadde,</para>
  <para style="q2" vid="PSA 130:1">neekko waassay.<verse eid="PSA 130:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 130:2" />Abeet Godaw, ta kooshshaa sisa;</para>
  <para style="q2" vid="PSA 130:2">taani watiwatiyaa watiwatuwaa ne haytsay hayzzo.<verse eid="PSA 130:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3" />Abeet Med'inaa Godaw, neeni,</para>
  <para style="q2" vid="PSA 130:3">nu nagaraa mazggobiyaan s'aafeeddentto,</para>
  <para style="q2" vid="PSA 130:3">abeet Godaw, won ooni pirddaappe attanaw danddayii?<verse eid="PSA 130:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4" />Shin nuuni neena bonchchiidde azazettana mala,</para>
  <para style="q2" vid="PSA 130:4">nuw atto yaagaasa.<verse eid="PSA 130:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5" />Taani Med'inaa Godaa naagay;</para>
  <para style="q2" vid="PSA 130:5">ee, taani Aa laamotaan naagay;</para>
  <para style="q1" vid="PSA 130:5">Aa k'aalankka hidootaa ootsay.<verse eid="PSA 130:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6" />Sa'ay awude wonttanddeeshsha</para>
  <para style="q2" vid="PSA 130:6">giide naagiyaa k'amma zabaynyatuwaappe aad'd'aade,</para>
  <para style="q2" vid="PSA 130:6">taani unttunttuppekka aatsaade,</para>
  <para style="q2" vid="PSA 130:6">Godaa laamotaan naagay.<verse eid="PSA 130:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7" />Israa'eeliyaa asaw, Med'inaa Godaan hidootaa ootsite;</para>
  <para style="q2" vid="PSA 130:7">ayaw gooppe, aggena siik'uu Med'inaa Godaana;</para>
  <para style="q2" vid="PSA 130:7">k'ay I ubbaa gede asaa ashshanaw koyee.<verse eid="PSA 130:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8" />Israa'eeliyaa asaa</para>
  <para style="q2" vid="PSA 130:8">unttunttu nagaraa ubbaappe ashshanawe Aa.<note caller="-" style="x"><char style="xo" closed="false">130:8 </char><char style="xt" closed="false"><ref loc="MAT 1:21">Mat. 1:21</ref>; <ref loc="TIT 2:14">Tit. 2:14</ref></char></note><verse eid="PSA 130:8" /></para>
  <chapter eid="PSA 130" />
  <chapter number="131" style="c" sid="PSA 131" />
  <para style="s">S'oossaan Ammanettussaa</para>
  <para style="d">Pudetsaa kesiidde yes's'eedda yetsaa, Daawite s'aafeeddawaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1" />Abeet Med'inaa Godaw, taani wozanaan ayyiyaawaa aggaad;</para>
  <para style="q2" vid="PSA 131:1">ta ayfiyaan otoruwaan s'eelabeykke.</para>
  <para style="q1" vid="PSA 131:1">Wolk'k'aamabaw woy eranaw danddayenna</para>
  <para style="q2" vid="PSA 131:1">malalissiyaabaw taani hirggikke.<verse eid="PSA 131:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2" />Hewaa aggade d'antsaa duus's'eedda na'ay</para>
  <para style="q2" vid="PSA 131:2">bare aatti matan c'o"u giyaawaadan,</para>
  <para style="q2" vid="PSA 131:2">taani c'o"u gaad.</para>
  <para style="q2" vid="PSA 131:2">Ee, woppu geedda na'aadan taani woppu gaad.<verse eid="PSA 131:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3" />Israa'eeliyaa asaw, hachcheppe</para>
  <para style="q2" vid="PSA 131:3">med'inaa gakkanaw Med'inaa Godaan hidootaa ootsite.<verse eid="PSA 131:3" /></para>
  <chapter eid="PSA 131" />
  <chapter number="132" style="c" sid="PSA 132" />
  <para style="s">Geeshsha Golliyaa Sabbanaw Shiik'o Mazimuriyaa</para>
  <para style="d">Pudetsaa kesiidde yes's'eedda yetsaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1" />Abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 132:1">Daawitanne I danddayeedda metuwaa k'oppa.<verse eid="PSA 132:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2" />Med'inaa Godaw I c'aak'k'eeddawaa,</para>
  <para style="q2" vid="PSA 132:2">Yaak'ooba s'oossaw, Wolk'k'aamaw</para>
  <para style="q1" vid="PSA 132:2">I hawaadan yaagiide geppeeddawaa hassaya;<verse eid="PSA 132:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3" />«Hawaappe guyiyaan taani ta golle gelikke,</para>
  <para style="q2" vid="PSA 132:3">woy ta hiis'an gisikke.<verse eid="PSA 132:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 132:4" />Taani ta ayifiyaa c'iilimmikke,</para>
  <para style="q2" vid="PSA 132:4">woy gem"ishikke.<verse eid="PSA 132:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 132:5" />Hewenne, taani Med'inaa Godaw sa'aa,</para>
  <para style="q2" vid="PSA 132:5">Yaak'ooba S'oossaw, Wolk'k'aamaw</para>
  <para style="q2" vid="PSA 132:5">de'iyaasaa giigissana gakkanaassa» yaageedda.<verse eid="PSA 132:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6" />Hekko, nuuni Taabootaabaa,</para>
  <para style="q2" vid="PSA 132:6">Efiraatan siseeddo;<note caller="-" style="x"><char style="xo" closed="false">132:6-10 </char><char style="xt" closed="false"><ref loc="2CH 6:41-42">2 Od. 6:41-42</ref></char></note></para>
  <para style="q1" vid="PSA 132:6">Yi'aariima giyaa biittaan Aa nuuni demmeeddo.<verse eid="PSA 132:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7" />Nuuni, «Ane I de'iyaasaa boytte;</para>
  <para style="q2" vid="PSA 132:7">Aa gedii yed'd'iyaasaan guufanniide,</para>
  <para style="q2" vid="PSA 132:7">aw goyinneetto» yaageeddo.<verse eid="PSA 132:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8" />Abeet Med'inaa Godaw, dendda!</para>
  <para style="q2" vid="PSA 132:8">Ne minotetsaw mallaa gidiyaa ne Taabootaanna,</para>
  <para style="q2" vid="PSA 132:8">ne Geeshsha Golliyaa gelaade de'a.<verse eid="PSA 132:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9" />Ne k'eesatuu s'illotetsaa mayno;</para>
  <para style="q2" vid="PSA 132:9">ne asatuu nashshechchaw yes's'ino.<verse eid="PSA 132:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10" />Ne k'oomaa Daawita diraw,</para>
  <para style="q2" vid="PSA 132:10">neeni okkeedda kaatiyaa aggoppa.<verse eid="PSA 132:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11" />Med'inaa Goday Daawitaw laamettena c'aak'uwaa</para>
  <para style="q2" vid="PSA 132:11">hawaadan yaagiide c'aak'k'eedda;<note caller="-" style="x"><char style="xo" closed="false">132:11 </char><char style="xt" closed="false"><ref loc="2SA 7:12-16">2 Sam. 7:12-16</ref>; <ref loc="1CH 17:11-14">1 Od. 17:11-14</ref>; <ref loc="PSA 89:3-4">Maz. 89:3-4</ref>; <ref loc="ACT 2:30">Kit. 2:30</ref></char></note></para>
  <para style="q1" vid="PSA 132:11">«Ne gulbbataappe yeletteedda ne naanatuwaappe ittuwaa</para>
  <para style="q2" vid="PSA 132:11">taani kawutsana.<verse eid="PSA 132:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12" />Ne naanatuu ta c'aak'uwaanne</para>
  <para style="q2" vid="PSA 132:12">taani tamaarissiyaa timirttiyaa naagooppe,</para>
  <para style="q2" vid="PSA 132:12">unttunttu naanatuukka ne kawutetsaa araatan med'inaw uttana» yaageedda.<verse eid="PSA 132:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13" />Med'inaa Goday S'iyoone dooreedda;</para>
  <para style="q2" vid="PSA 132:13">barew de'iyaasaa ootsanawukka amottiide,</para>
  <para style="q2" vid="PSA 132:13">hawaadan yaageedda;<verse eid="PSA 132:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14" />«Hawe taw med'inaw de'iyaa sa'aa;</para>
  <para style="q2" vid="PSA 132:14">taani amotteedda diraw, hawaan uttana.<verse eid="PSA 132:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15" />Taani daro katsaa immaade S'iyoono anjjana;</para>
  <para style="q2" vid="PSA 132:15">izin de'iyaa hiyyeesatuwaakka k'umaa kalissana.<verse eid="PSA 132:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16" />Izin de'iyaa k'eesetuwaakka</para>
  <para style="q2" vid="PSA 132:16">taani atotetsaa mayzzana;</para>
  <para style="q2" vid="PSA 132:16">izin S'oossaa asatuukka nashshechchaw yes's'ana.<verse eid="PSA 132:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17" />«Ha sa'aan,</para>
  <para style="q2" vid="PSA 132:17">Daawita zeretsaappe ittuwaa kawutsana;<note caller="-" style="x"><char style="xo" closed="false">132:17 </char><char style="xt" closed="false"><ref loc="1KI 11:36">1 Kat. 11:36</ref></char></note></para>
  <para style="q2" vid="PSA 132:17">taani okkeedda kaatiyaa kawutetsaa gam"etsana.<verse eid="PSA 132:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18" />Taani Aa morkkatuwaa yeellaa mayzzana;</para>
  <para style="q2" vid="PSA 132:18">shin Aa huup'iyaan de'iyaa kawutetsaa kallachchay p'oolana» yaageedda.<verse eid="PSA 132:18" /></para>
  <chapter eid="PSA 132" />
  <chapter number="133" style="c" sid="PSA 133" />
  <para style="s">Ishatuwaa Siik'oo Shiik'eedda Sabaa</para>
  <para style="d">Pudetsaa kesiidde yes's'eedda yetsaa, Daawite s'aafeeddawaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1" />Ishatuu ittippetetsan de'iyaawe ayiba lo"obeenne nashechchiyaabee!<verse eid="PSA 133:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2" />Hewe huup'iyaa okkina, buuchchaanna goggiyaa,</para>
  <para style="q2" vid="PSA 133:2">Aaroona buuchchaanna goggiide</para>
  <para style="q1" vid="PSA 133:2">Aa mayuwaa morggiyaa gakkiyaa al"o zayitiyaa mala.<verse eid="PSA 133:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3" />Hewe Hermmoone deriyaa ketterssay,</para>
  <para style="q2" vid="PSA 133:3">S'iyoone Deretuwaa gakkiyaawaa mala.</para>
  <para style="q1" vid="PSA 133:3">Med'inaa Goday hewan anjjuwaa, med'inaa de'uwaa immeedda.<verse eid="PSA 133:3" /></para>
  <chapter eid="PSA 133" />
  <chapter number="134" style="c" sid="PSA 134" />
  <para style="s">S'oossaa Galatussaa</para>
  <para style="d">Pudetsaa kesiidde yes's'eedda yetsaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1" />Hinttenoo Med'inaa Godaa k'oomatoo,</para>
  <para style="q2" vid="PSA 134:1">Med'inaa Godaa golliyaan k'amma ootsiyaawanttoo,</para>
  <para style="q2" vid="PSA 134:1">ubbaykka haa yiide, Med'inaa Godaa galatite.<verse eid="PSA 134:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2" />Geeshsha Golliyaan hintte kushiyaa mic'c'iide,</para>
  <para style="q2" vid="PSA 134:2">Med'inaa Godaa galatite.<verse eid="PSA 134:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3" />Saluwaanne sa'aa med'd'eedda Med'inaa Goday,</para>
  <para style="q2" vid="PSA 134:3">hinttena S'iyooneppe anjjo.<verse eid="PSA 134:3" /></para>
  <chapter eid="PSA 134" />
  <chapter number="135" style="c" sid="PSA 135" />
  <para style="s">Galataa Mazimuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1" />Med'inaa Godaa galatite!</para>
  <para style="b" vid="PSA 135:1" />
  <para style="q1" vid="PSA 135:1">Hinttenoo Med'inaa Godaa k'oomatoo,</para>
  <para style="q2" vid="PSA 135:1">Med'inaa Godaa suntsaa galatite!<verse eid="PSA 135:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2" />Hinttenoo Med'inaa Godaa golliyaa giddon,</para>
  <para style="q2" vid="PSA 135:2">nu S'oossaa golliyaa dabaaban ek'k'eeddawanttoo,</para>
  <para style="q1" vid="PSA 135:2">S'oossaa galatite!<verse eid="PSA 135:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3" />Med'inaa Goday keeka gidiyaa diraw,</para>
  <para style="q2" vid="PSA 135:3">Med'inaa Godaa galatite!</para>
  <para style="q1" vid="PSA 135:3">I lo"a gidiyaa diraw,</para>
  <para style="q2" vid="PSA 135:3">Aa suntsaa sabbite!<verse eid="PSA 135:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4" />Med'inaa Goday Yaak'ooba bare huup'ew,</para>
  <para style="q2" vid="PSA 135:4">Israa'eeliyaa asaakka barew buzo ootsiide dooreedda.<verse eid="PSA 135:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5" />Med'inaa Goday wolk'k'aama gidiyaawaanne</para>
  <para style="q2" vid="PSA 135:5">nu Goday s'oossatuwaa ubbaappe d'ok'k'iyaawaa,</para>
  <para style="q2" vid="PSA 135:5">taani eray.<verse eid="PSA 135:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6" />Saluwankka saankka,</para>
  <para style="q2" vid="PSA 135:6">abbatuwaaninne unttunttu c'iimmotuwaa ubbaa giddonkka,</para>
  <para style="q1" vid="PSA 135:6">Med'inaa Goday bare doseeddawaa ubbaa ootsee.<verse eid="PSA 135:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7" />Iraa tooko shaariyaa sa'aa gas'aappe I dentsee;</para>
  <para style="q2" vid="PSA 135:7">I iraanna walk'k'antsaa kiittee;</para>
  <para style="q2" vid="PSA 135:7">bare minjjiyaa sa'aappe c'arkkuwaa kessee.<verse eid="PSA 135:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8" />Gibs'e biittan asaa naanatuwaappenne,</para>
  <para style="q2" vid="PSA 135:8">mehiyaa maraappe,</para>
  <para style="q2" vid="PSA 135:8">bayira yeletteeddawantta wod'eedda.<verse eid="PSA 135:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9" />Neenoo Gibs'ee, Par"oonanne Aa k'oomatuwaa muranaw,</para>
  <para style="q2" vid="PSA 135:9">hinttenttu gidon ooratsabaanne malalissiyaabaa yeddeedda.<verse eid="PSA 135:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10" />I daro kawutetsatuwaa bayzzeedda;</para>
  <para style="q2" vid="PSA 135:10">wolk'k'aama kaatetuwaakka wod'eedda.<verse eid="PSA 135:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11" />Amooretuwaa kaatiyaa Sihoona,</para>
  <para style="q2" vid="PSA 135:11">Baasaane kaatiyaa Ooganne,</para>
  <para style="q2" vid="PSA 135:11">Kanaane kaatetuwaa ubbaa wod'eedda.<verse eid="PSA 135:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12" />Unttunttu biittaa bare asatuwaa,</para>
  <para style="q2" vid="PSA 135:12">Israa'eelatuwaa laatisseedda.<verse eid="PSA 135:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13" />Abeet Med'inaa Godaw, ne suntsay med'inaw de'ana;</para>
  <para style="q2" vid="PSA 135:13">yeletaappe yeletaa gakkanaw Med'inaa Goday hassayettana.<verse eid="PSA 135:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14" />Med'inaa Goday bare asaw pirddana;</para>
  <para style="q2" vid="PSA 135:14">I bare k'oomatoo k'arettana.<verse eid="PSA 135:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15" />Gadiyaa asatuwaa eek'atuu asaa kushii</para>
  <para style="q2" vid="PSA 135:15">biraappenne work'k'aappe med'd'eeddawantta.<note caller="-" style="x"><char style="xo" closed="false">135:15-18 </char><char style="xt" closed="false"><ref loc="PSA 115:4-8">Maz. 115:4-8</ref>; <ref loc="REV 9:20">Sas'. 9:20</ref></char></note><verse eid="PSA 135:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16" />Unttunttoo doonay de'ee, shin haasayikkino;</para>
  <para style="q2" vid="PSA 135:16">ayifii de'ee, shin s'eellikkino.<verse eid="PSA 135:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17" />Haytsay de'ee, shin sissikkino;</para>
  <para style="q2" vid="PSA 135:17">unttunttu doonaan shemppuu baawa.<verse eid="PSA 135:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18" />Unttuntta med'd'eeddawanttunne,</para>
  <para style="q2" vid="PSA 135:18">unttunttun ammanettiyaawanttu,</para>
  <para style="q2" vid="PSA 135:18">ubbay unttunttudan hanino.<verse eid="PSA 135:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19" />Israa'eeliyaa golliyaa asatoo,</para>
  <para style="q2" vid="PSA 135:19">Med'inaa Godaa galatite;</para>
  <para style="q1" vid="PSA 135:19">Aaroona golliyaa asatoo,</para>
  <para style="q2" vid="PSA 135:19">Med'inaa Godaa galatite;<verse eid="PSA 135:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20" />Leewiyaa golliyaa asatoo,</para>
  <para style="q2" vid="PSA 135:20">Med'inaa Godaa galatite;</para>
  <para style="q1" vid="PSA 135:20">Med'inaa Godaw yayyiyaawanttoo,</para>
  <para style="q2" vid="PSA 135:20">ubbay Med'inaa Godaa galatite.<verse eid="PSA 135:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21" />Yerusaalamen de'iyaa Med'inaa Goday</para>
  <para style="q2" vid="PSA 135:21">S'iyoonen galatetto!</para>
  <para style="b" vid="PSA 135:21" />
  <para style="q1" vid="PSA 135:21">Med'inaa Godaa galatite!<verse eid="PSA 135:21" /></para>
  <chapter eid="PSA 135" />
  <chapter number="136" style="c" sid="PSA 136" />
  <para style="s">Galataa Mazimuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1" />Med'inaa Godaa galatite! Ayaw gooppe, I keeka;<note caller="-" style="x"><char style="xo" closed="false">136:1 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1 Od. 16:34</ref>; <ref loc="2CH 5:13">2 Od. 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Izr. 3:11</ref>; <ref loc="PSA 100:5">Maz. 100:5</ref>; <ref loc="PSA 106:1">106:1</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="JER 33:11">Erm. 33:11</ref></char></note></para>
  <para style="q2" vid="PSA 136:1">aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2" />S'oossatuwaa S'oossaa galatite!</para>
  <para style="q2" vid="PSA 136:2">Aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3" />Godatuwaa Godaa galatite!</para>
  <para style="q2" vid="PSA 136:3">Aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4" />Aa s'alalay wolk'k'aama malalissiyaabaa ootsee;</para>
  <para style="q2" vid="PSA 136:4">aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5" />Bare aad'd'eeda eran I salotuwaa med'd'eedda;<note caller="-" style="x"><char style="xo" closed="false">136:5 </char><char style="xt" closed="false"><ref loc="GEN 1:1">Dom. 1:1</ref></char></note></para>
  <para style="q2" vid="PSA 136:5">aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6" />Biittaa haatsaa bollan mic'c'eedda;<note caller="-" style="x"><char style="xo" closed="false">136:6 </char><char style="xt" closed="false"><ref loc="GEN 1:2">Dom. 1:2</ref></char></note></para>
  <para style="q2" vid="PSA 136:6">aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7" />Wolk'k'aama poo'otuwaa med'd'eedda;<note caller="-" style="x"><char style="xo" closed="false">136:7-9 </char><char style="xt" closed="false"><ref loc="GEN 1:16">Dom. 1:16</ref></char></note></para>
  <para style="q2" vid="PSA 136:7">aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8" />Away gallassi mooddanaadan ootseedda;</para>
  <para style="q2" vid="PSA 136:8">aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9" />Aginayinne s'oolinttetuu</para>
  <para style="q2" vid="PSA 136:9">k'amma mooddanaadan ootseedda;</para>
  <para style="q2" vid="PSA 136:9">aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10" />I Gibs'e biittan bayiratuwaa wod'eedda;<note caller="-" style="x"><char style="xo" closed="false">136:10 </char><char style="xt" closed="false"><ref loc="EXO 12:29">Kes. 12:29</ref></char></note></para>
  <para style="q2" vid="PSA 136:10">aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11" />Israa'eeliyaa asaa,</para>
  <para style="q2" vid="PSA 136:11">Gibs'eppe kaaletsiide kesseedda;<note caller="-" style="x"><char style="xo" closed="false">136:11 </char><char style="xt" closed="false"><ref loc="EXO 12:51">Kes. 12:51</ref></char></note></para>
  <para style="q2" vid="PSA 136:11">aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12" />Bare mino kushiyan,</para>
  <para style="q2" vid="PSA 136:12">bare wolk'k'aama k'esiyaan hawaa ootseedda;</para>
  <para style="q2" vid="PSA 136:12">aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13" />Zo'o Abbaa shaakki yegeedda;<note caller="-" style="x"><char style="xo" closed="false">136:13-15 </char><char style="xt" closed="false"><ref loc="EXO 14:21-29">Kes. 14:21-29</ref></char></note></para>
  <para style="q2" vid="PSA 136:13">aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14" />Israa'eeliyaa asaa,</para>
  <para style="q2" vid="PSA 136:14">he abbaa gidduwaana pintseedda;</para>
  <para style="q2" vid="PSA 136:14">aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15" />Gibs'e kaatiyaanne Aa olanchchatuwaa</para>
  <para style="q2" vid="PSA 136:15">Zo'o Abban muukisseedda;</para>
  <para style="q2" vid="PSA 136:15">aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16" />I bare asaa kaaletsiide,</para>
  <para style="q2" vid="PSA 136:16">bazzuwaana aatseedda;</para>
  <para style="q2" vid="PSA 136:16">aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17" />Wolk'k'aama kaatetuwaa shoc'eedda;</para>
  <para style="q2" vid="PSA 136:17">aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18" />Eretteedda kaatetuwaa wod'eedda;</para>
  <para style="q2" vid="PSA 136:18">aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19" />Amooretuwaa kaatiyaa Sihoona wod'eedda;<note caller="-" style="x"><char style="xo" closed="false">136:19 </char><char style="xt" closed="false"><ref loc="NUM 21:21-30">Pay. 21:21-30</ref></char></note></para>
  <para style="q2" vid="PSA 136:19">aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20" />K'ay Baasaane kaatiyaa Ooga wod'eedda;<note caller="-" style="x"><char style="xo" closed="false">136:20 </char><char style="xt" closed="false"><ref loc="NUM 21:31-35">Pay. 21:31-35</ref></char></note></para>
  <para style="q2" vid="PSA 136:20">aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21" />Yaatiide unttunttu biittaa bare asaa laatisseedda;</para>
  <para style="q2" vid="PSA 136:21">aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22" />Bare k'oomaa Israa'eeliyaa laatisseedda;</para>
  <para style="q2" vid="PSA 136:22">aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23" />I nuuni kawusheedda wodekka nuuna k'oppeedda;</para>
  <para style="q2" vid="PSA 136:23">aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24" />Nuuna nu morkkatuwaappe ashsheeda;</para>
  <para style="q2" vid="PSA 136:24">aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25" />Med'etaa ubbaw k'umaa immee;</para>
  <para style="q2" vid="PSA 136:25">aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26" />Saluwaa S'oossaa galatite!</para>
  <para style="q2" vid="PSA 136:26">Aggena Aa siik'uu med'inaawaa.<verse eid="PSA 136:26" /></para>
  <chapter eid="PSA 136" />
  <chapter number="137" style="c" sid="PSA 137" />
  <para style="s">Omooduwaan De'iyaa Israa'eeliyaa Yeekuwaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1" />Baabloone shaafatuwaa matan uttiide,</para>
  <para style="q2" vid="PSA 137:1">nuuni S'iyoone k'oppeedda wode yeekkeeddo.<verse eid="PSA 137:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2" />He sa'aan nuuni,</para>
  <para style="q2" vid="PSA 137:2">nu diitsaa haatsaa matan dic'c'iyaa mitsaa bolla kak'k'eeddo.<verse eid="PSA 137:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3" />Nuuna omoodeedda asatuu,</para>
  <para style="q2" vid="PSA 137:3">nuuni yes's'iide, unttuntta nashshechchana mala,</para>
  <para style="q1" vid="PSA 137:3">«S'iyoone yetsaappe ittuwaa ane nuw yes's'ite» yaageeddino.<verse eid="PSA 137:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4" />Med'inaa Godaa yetsaa, nuuni,</para>
  <para style="q2" vid="PSA 137:4">allaga biittan wooti yes's'anee?<verse eid="PSA 137:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5" />Yerusaalame katamatee, taani neena dogooppe,</para>
  <para style="q2" vid="PSA 137:5">ta ushechcha kushii bare oosuwaa dogo.<verse eid="PSA 137:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6" />Taani neena hassayennan aggooppenne</para>
  <para style="q2" vid="PSA 137:6">ta nashshechchaa ubbaappe aatsaade Yerusaalame dosennan aggooppe,</para>
  <para style="q2" vid="PSA 137:6">ta ins's'arssay kookkiyaana oyk'k'etto.<verse eid="PSA 137:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7" />Abeet Med'inaa Godaw, Yerusaalame omoodettiyaa gallassi,</para>
  <para style="q2" vid="PSA 137:7">Eedooma asatuu ootseeddawaa hassaya;</para>
  <para style="q2" vid="PSA 137:7">unttunttu, «kolite! kolite!</para>
  <para style="q2" vid="PSA 137:7">Hirkki s'ap'uwaa gakkanaw laalite!» yaageeddawaa dogoppa.<verse eid="PSA 137:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8" />Baabloone biittaw, neenikka bayana!<note caller="-" style="x"><char style="xo" closed="false">137:8 </char><char style="xt" closed="false"><ref loc="REV 18:6">Sas'. 18:6</ref></char></note></para>
  <para style="q2" vid="PSA 137:8">Neeni nu bollan ootseedda iita oosuwaa,</para>
  <para style="q2" vid="PSA 137:8">ne bolla ootsiyaawe anjjetteedawaa.<verse eid="PSA 137:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9" />Ne guutsa naanatuwaa oyk'k'iide,</para>
  <para style="q2" vid="PSA 137:9">zaallaa bolla shoc'iyaawe anjjetteedawaa.<verse eid="PSA 137:9" /></para>
  <chapter eid="PSA 137" />
  <chapter number="138" style="c" sid="PSA 138" />
  <para style="s">Galataa Woosaa</para>
  <para style="d">Daawite S'aafeeddawaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1" />Abeet Med'inaa Godaw, taani ta kumentsaa wozanaappe neena galatana;</para>
  <para style="q2" vid="PSA 138:1">s'oossatuwaa sintsan neena sabbana.<verse eid="PSA 138:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2" />Ne Geeshsha Golliyaakko simmaade,</para>
  <para style="q2" vid="PSA 138:2">new goynaade, aggena ne siik'uwaanne ne tumatetsaa diraw,</para>
  <para style="q2" vid="PSA 138:2">taani ne suntsaa galatay;</para>
  <para style="q2" vid="PSA 138:2">ayaw gooppe, neeni ne suntsaanne ne k'aalaa,</para>
  <para style="q2" vid="PSA 138:2">ubbaappe aatsaade d'ok'k'u ootsaadda.<verse eid="PSA 138:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3" />Taani s'eeseedda gallassi taw koyaadda;</para>
  <para style="q2" vid="PSA 138:3">ne minotetsan taana minisaadda.<verse eid="PSA 138:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4" />Abeet Med'inaa Godaw, sa'aan de'iyaa kaatetuu ubbay,</para>
  <para style="q2" vid="PSA 138:4">neena galatino;</para>
  <para style="q2" vid="PSA 138:4">ayaw gooppe, unttunttu ne doonaappe keseedda k'aalaa siseeddino.<verse eid="PSA 138:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5" />Med'inaa Godaa bonchchuu wolk'k'aama gidiyaa diraw,</para>
  <para style="q2" vid="PSA 138:5">unttunttu Med'inaa Godaa ogiyaawaa yes's'ana.<verse eid="PSA 138:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6" />Med'inaa Goday bolla d'ok'k'an de'ooppekka,</para>
  <para style="q2" vid="PSA 138:6">hiyyeesatuwaa keeka ayifiyaan s'eellee.</para>
  <para style="q1" vid="PSA 138:6">Shin otoranchchatuwaa I haakuwaan eree.<verse eid="PSA 138:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7" />Taani metuwaa gidduwaana hamettooppekka,</para>
  <para style="q2" vid="PSA 138:7">neeni taana de'uwaan naagaasa.</para>
  <para style="q1" vid="PSA 138:7">Ta morkkatuwaa hank'k'uwaa bolla ne kushiyaa mic'c'aasa;</para>
  <para style="q2" vid="PSA 138:7">ne ushechchan taana ashshaasa.<verse eid="PSA 138:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8" />Med'inaa Goday taw giide k'oppeeddawaa polana;</para>
  <para style="q2" vid="PSA 138:8">abeet Med'inaa Godaw, aggena ne siik'uu med'inaawaa.</para>
  <para style="q1" vid="PSA 138:8">Ne kushiyaa oosuwaa agga aggoppa.<verse eid="PSA 138:8" /></para>
  <chapter eid="PSA 138" />
  <chapter number="139" style="c" sid="PSA 139" />
  <para style="s">Ubbaa Eriyaa S'oossaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Daawite s'aafeedda mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1" />Abeet Med'inaa Godaw, neeni taana biddaade eraadda.<verse eid="PSA 139:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2" />Taani awude uttinttonne</para>
  <para style="q2" vid="PSA 139:2">awude ek'k'intto, neeni eraasa;</para>
  <para style="q2" vid="PSA 139:2">neeni ta k'ofaa ubbaa haakuwaan eraasa.<verse eid="PSA 139:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3" />Taani biyaasaanne,</para>
  <para style="q2" vid="PSA 139:3">shemppiyaa sa'aa s'omoosaasa;</para>
  <para style="q2" vid="PSA 139:3">ta ogetuwaa ubbaa neeni eraasa.<verse eid="PSA 139:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4" />Abeet Med'inaa Godaw, taani ta ins's'arssan</para>
  <para style="q2" vid="PSA 139:4">itti k'aalaa haasayanaappe kasetaade,</para>
  <para style="q2" vid="PSA 139:4">neeni ta k'ofaa ubbaa eraasa.<verse eid="PSA 139:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5" />Neeni ta yuushshuwaan de'aassa;</para>
  <para style="q2" vid="PSA 139:5">ne kushiyan taana naagaasa.<verse eid="PSA 139:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6" />Ne eray taana loytsi malalissee;</para>
  <para style="q2" vid="PSA 139:6">taani akeekanaw danddayiyaasaappe d'ok'k'a.<verse eid="PSA 139:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7" />Taani ne Ayaanappe hak'a baanaw danddayayitaa?</para>
  <para style="q2" vid="PSA 139:7">Woy ne sintsaappe hak'a bak'atanaw danddayayitaa?<verse eid="PSA 139:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8" />Pude saluwaa kesooppe,</para>
  <para style="q2" vid="PSA 139:8">neeni yaan de'aassa!</para>
  <para style="q1" vid="PSA 139:8">Duge Si'ooliyaa wod'd'inttokka,</para>
  <para style="q2" vid="PSA 139:8">neeni yaan de'aassa.<verse eid="PSA 139:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9" />Away mokkiyaasaa bagga paallaade booppe,</para>
  <para style="q2" vid="PSA 139:9">woy away wulliyaasaa baggan haakkaade de'ooppe,<verse eid="PSA 139:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10" />he saankka ne kushii taana kaaletsee;</para>
  <para style="q2" vid="PSA 139:10">ne ushechcha kushii taana zemppissee.<verse eid="PSA 139:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11" />Taani, «D'umaw, taana gentsaa;</para>
  <para style="q2" vid="PSA 139:11">poo'uwaa, k'ammaw laametta» yaaginttokka,<verse eid="PSA 139:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 139:12" />d'umaa daruu new d'umenna;</para>
  <para style="q2" vid="PSA 139:12">k'ammay gallassaadan poo'ee;</para>
  <para style="q2" vid="PSA 139:12">ayaw gooppe, new d'umay poo'uwaa mala.<verse eid="PSA 139:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13" />Neeni ta giddo asatetsaa ubbaa med'd'aadda;</para>
  <para style="q2" vid="PSA 139:13">ta aatti uluwaan taana neeni waas'a med'aadda.<verse eid="PSA 139:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14" />Neeni taana malalissiyaabaanne ooratsabaa ootsaade med'd'eedda diraw,</para>
  <para style="q2" vid="PSA 139:14">taani neena galatay.</para>
  <para style="q1" vid="PSA 139:14">Ne oosotuu malalissiyaawantta!</para>
  <para style="q2" vid="PSA 139:14">Taani k'ay hewaa wurssaade eray.<verse eid="PSA 139:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15" />Taani geema sa'aan med'ettiyaa wode,</para>
  <para style="q2" vid="PSA 139:15">ta mek'etsatuu neeppe geemmibeyikkino.</para>
  <para style="q1" vid="PSA 139:15">Ta bollay ta aatti uluwaa c'iimmaa giddon</para>
  <para style="q2" vid="PSA 139:15">hiillan alleek'k'ettiide oosettiyaa wode,<verse eid="PSA 139:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 139:16" />yelettibeenna ta asatetsaa ne ayifii be'eedda.</para>
  <para style="q2" vid="PSA 139:16">Biro ittuunne doomettennan de'ishshin,</para>
  <para style="q2" vid="PSA 139:16">taw neeni giigiseedda gallassatuu ubbatuu</para>
  <para style="q2" vid="PSA 139:16">ne mazggobiyaan s'aafetteeddino.<verse eid="PSA 139:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17" />Abeet S'oossaw,</para>
  <para style="q2" vid="PSA 139:17">ne k'ofatuu ayaa c'oratteeddinoo!</para>
  <para style="q1" vid="PSA 139:17">Unttuntta eranawe ayaa waayissii!<verse eid="PSA 139:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18" />Taani unttuntta paydintto,</para>
  <para style="q2" vid="PSA 139:18">unttunttu shafiyaappe darana shin.</para>
  <para style="q1" vid="PSA 139:18">Taani beegottiyaa wode,</para>
  <para style="q2" vid="PSA 139:18">ha"ikka neenana de'ay.<verse eid="PSA 139:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19" />Abeet S'oossaw, neeni iitatuwaa wod'aaddintto ayee de'ii!</para>
  <para style="q2" vid="PSA 139:19">Suutsaa gussiyaa asatuu taappe haakkino!<verse eid="PSA 139:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20" />Unttunttu ne bolla iitabaa haasayiino;</para>
  <para style="q2" vid="PSA 139:20">ne morkketuu ne suntsaa bayzziino.<verse eid="PSA 139:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21" />Abeet Med'inaa Godaw, neena is's'iyaawantta</para>
  <para style="q2" vid="PSA 139:21">taani is's'ikkitaa?</para>
  <para style="q1" vid="PSA 139:21">Ne bolla denddiyaawantta</para>
  <para style="q2" vid="PSA 139:21">taani shenetikkitaa?<verse eid="PSA 139:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22" />Taani unttuntta ubbaa is's'ay;</para>
  <para style="q2" vid="PSA 139:22">unttuntta taani ta morkkatuwaadan payday.<verse eid="PSA 139:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23" />Abeet S'oossaw,</para>
  <para style="q2" vid="PSA 139:23">taana biddaade, ta wozanaa era;</para>
  <para style="q2" vid="PSA 139:23">taana paac'c'aade, ta un"etiyaa k'ofaa era.<verse eid="PSA 139:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24" />Ane taanan iitabay de'ooppe s'eella;</para>
  <para style="q2" vid="PSA 139:24">med'inaa ogiyaan taana kaaletsa.<verse eid="PSA 139:24" /></para>
  <chapter eid="PSA 139" />
  <chapter number="140" style="c" sid="PSA 140" />
  <para style="s">Iitatuwaa Bolla Shiik'eedda Woosaa</para>
  <para style="d">Zammaaretuwaa Kaappoo Yes'etteedda, Daawite s'aafeedda mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1" />Abeet Med'inaa Godaw, iita asatuwaappe taana ashsha;</para>
  <para style="q2" vid="PSA 140:1">makkalanchcha asatuwaappe taana naaga.<verse eid="PSA 140:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2" />Unttunttu ubbaa wode,</para>
  <para style="q2" vid="PSA 140:2">iitabaa ootsanaw mak'ettiino;</para>
  <para style="q2" vid="PSA 140:2">ubbaa gallassikka,</para>
  <para style="q2" vid="PSA 140:2">walassaa dentsetsanaw k'oppiino.<verse eid="PSA 140:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3" />Unttunttu barenttu ins's'arssaa shooshshaawaadan k'arayiino;<note caller="-" style="x"><char style="xo" closed="false">140:3 </char><char style="xt" closed="false"><ref loc="ROM 3:13">Rom. 3:13</ref></char></note></para>
  <para style="q2" vid="PSA 140:3">unttunttu doonaappe asaa wod'iyaa hasuwaa shooshshaa yishshaa mala haasayay kesee.<verse eid="PSA 140:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4" />Abeet Med'inaa Godaw, iita asatuwaa kushiyaappe,</para>
  <para style="q2" vid="PSA 140:4">taana ashsha;</para>
  <para style="q2" vid="PSA 140:4">ta gediyaa k'as's'anaw k'oppiyaa makkalanchcha asatuwaappe taana naaga.<verse eid="PSA 140:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5" />Otoranchcha asatuu taw diizzaa giigisseeddino;</para>
  <para style="q2" vid="PSA 140:5">gitiyaa hiis's'eeddino;</para>
  <para style="q2" vid="PSA 140:5">taana oyk'k'anaw p'iriyaa ogiyaan wotseeddino.<verse eid="PSA 140:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6" />Taani Med'inaa Godaa, «Neeni ta S'oossaa» yaagay.</para>
  <para style="q2" vid="PSA 140:6">Abeet Med'inaa Godaw, taani watiwatiyaa watiwatuwaa sisa.<verse eid="PSA 140:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7" />Abeet Ubbaa Mooddiyaa Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 140:7">taana ashshiyaa minoo,</para>
  <para style="q2" vid="PSA 140:7">olaa gallassi taw gonddale gidaadda.<verse eid="PSA 140:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8" />Abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 140:8">iitatoo unttunttu amuwaa immoppa;</para>
  <para style="q2" vid="PSA 140:8">unttunttu iita mak'k'uwaa polissoppa.<verse eid="PSA 140:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9" />Ta morkkatuwaan taana s'oonissoppa;</para>
  <para style="q2" vid="PSA 140:9">unttunttu doonaappe kesiyaa iitabay unttunttoo simmo.<verse eid="PSA 140:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10" />Unttunttu bolla s'uuggiyaa bonk'k'uu k'oletto;</para>
  <para style="q2" vid="PSA 140:10">unttunttu taman olettino;</para>
  <para style="q2" vid="PSA 140:10">hewaappe laa"entso denddenna olan oletino.<verse eid="PSA 140:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11" />Zigiriyaawantta biittay tookkoppo;</para>
  <para style="q2" vid="PSA 140:11">makkalanchcha asatuwaa iitabay shankkatiide oyk'k'o.<verse eid="PSA 140:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12" />Med'inaa Goday hiyyeesatoo pirddiyaawaanne,</para>
  <para style="q2" vid="PSA 140:12">metootanchchatuwaa maataa naagisiyaawaa eray.<verse eid="PSA 140:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13" />Tumuppe s'illotuu ne suntsaa galatana;</para>
  <para style="q2" vid="PSA 140:13">suure asatuu ne sintsan de'ana.<verse eid="PSA 140:13" /></para>
  <chapter eid="PSA 140" />
  <chapter number="141" style="c" sid="PSA 141" />
  <para style="s">Omarssa Woosaa</para>
  <para style="d">Daawite s'aafeedda mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1" />Abeet Med'inaa Godaw, taani neena s'eesay;</para>
  <para style="q2" vid="PSA 141:1">taana maaddanaw elleella.</para>
  <para style="q1" vid="PSA 141:1">Taani neekko waassiyaa wode, ta kooshshaa sisa!<verse eid="PSA 141:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2" />Ta woosay is'aanaa c'uwaadan,</para>
  <para style="q2" vid="PSA 141:2">ne sintsa shiik'o;<note caller="-" style="x"><char style="xo" closed="false">141:2 </char><char style="xt" closed="false"><ref loc="REV 5:8">Sas'. 5:8</ref></char></note></para>
  <para style="q2" vid="PSA 141:2">taani ta kushiyaa mic'c'iyaawe,</para>
  <para style="q2" vid="PSA 141:2">new omarssa yarshshuwaa mala gido.<verse eid="PSA 141:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3" />Abeet Med'inaa Godaw, ta doonaa naagiyaawaa wotsa;</para>
  <para style="q2" vid="PSA 141:3">ta mettershshatuwaa penggiyaan zabayinyaa essa.<verse eid="PSA 141:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4" />Bayzzuwaa ootsiyaa asatuwaanna,</para>
  <para style="q2" vid="PSA 141:4">iita oosuwaa ootsenna mala,</para>
  <para style="q2" vid="PSA 141:4">ta wozanaa iitabaakko zaaroppa.</para>
  <para style="q2" vid="PSA 141:4">Unttunttu gibiraakka taana muzoppa.<verse eid="PSA 141:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5" />S'illo Asay taana aggena siik'uwaan</para>
  <para style="q2" vid="PSA 141:5">seeranawunne muranaw danddayee;</para>
  <para style="q2" vid="PSA 141:5">unttunttu taana bak'k'ooppe hewe ta huup'iyaan zayitiyaa okkiyaawaa mala;</para>
  <para style="q2" vid="PSA 141:5">ayaw gooppe, taani ubbaa gedekka</para>
  <para style="q2" vid="PSA 141:5">iitatuwaa oosuwaa bolla woossay.<verse eid="PSA 141:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6" />Unttunttu daannatuu zaallaa aafuwaana,</para>
  <para style="q2" vid="PSA 141:6">duge olettiyaa wode,</para>
  <para style="q2" vid="PSA 141:6">ta k'aalay tuma gidiyaawaa unttunttu Asay erana.<verse eid="PSA 141:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7" />Biittay goshetiyaawaadaaninne</para>
  <para style="q2" vid="PSA 141:7">guullu me"eretiyaawaadan</para>
  <para style="q2" vid="PSA 141:7">unttunttu mek'etsaykka duufuwaa doonaan laalettana.<verse eid="PSA 141:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8" />Abeet Ubbaa Mooddiyaa Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 141:8">ta ayifii neena s'eellee;</para>
  <para style="q2" vid="PSA 141:8">taani neekko bak'ataade attay;</para>
  <para style="q2" vid="PSA 141:8">taana hayk'oo aatsaade immoppa.<verse eid="PSA 141:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9" />Unttunttu taw wotseedda gitiyaappenne,</para>
  <para style="q2" vid="PSA 141:9">iitaa ootsiyaawanttu p'iriyaappe taana naaga.<verse eid="PSA 141:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10" />Taan saro aad'd'iyaa wode,</para>
  <para style="q2" vid="PSA 141:10">iitatuu barenttu wotseedda gitiyaan oyk'k'ettino.<verse eid="PSA 141:10" /></para>
  <chapter eid="PSA 141" />
  <chapter number="142" style="c" sid="PSA 142" />
  <para style="s">S'oossaa Maaduwaa Demanaw Shiik'eedda Woosaa</para>
  <para style="d">Akeekan S'aafetteedda Daawita Timirttiyaa, Gonggolo giddon de'iyaa wode Aa woosaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1" />Ta k'aalaa d'ok'k'u ootsaade, Med'inaa Godaw waassay.</para>
  <para style="q2" vid="PSA 142:1">Ta k'aalaa d'ok'k'u ootsaade,</para>
  <para style="q2" vid="PSA 142:1">Med'inaa Godaw watiwatay.<verse eid="PSA 142:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2" />Ta k'ohuwaa ubbaa aw magannay;</para>
  <para style="q2" vid="PSA 142:2">ta metuwaa ubbaa aw oday.<verse eid="PSA 142:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3" />Taani hidoota k'ans's'ana matiyaa wode, neeni ta ogiyaa eraasa.</para>
  <para style="q2" vid="PSA 142:3">Taani hamettiyaa ogiyaan taw gitiyaa k'osi wotseeddino.<verse eid="PSA 142:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4" />Taani ta yuushshuwaa s'eelliyaa wode,</para>
  <para style="q2" vid="PSA 142:4">taana maaddiyaawe ittuunne baawa;</para>
  <para style="q2" vid="PSA 142:4">taani k'osetta attiyaa sa'ay baawa;</para>
  <para style="q2" vid="PSA 142:4">taana naagiyaawekka baawa.<verse eid="PSA 142:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5" />Abeet Med'inaa Godaw, taani,</para>
  <para style="q2" vid="PSA 142:5">new hawaadan gaade waassay;</para>
  <para style="q1" vid="PSA 142:5">«Neeni taani bak'ataade attiyaa sa'aa;</para>
  <para style="q2" vid="PSA 142:5">taani pas'a de'ishshin, taana gakkeedda saamay neena» yaagay.<verse eid="PSA 142:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6" />Taani loytsa metootiyaa diraw,</para>
  <para style="q2" vid="PSA 142:6">ta waasuwaa hayzza.</para>
  <para style="q1" vid="PSA 142:6">Taana yederssiyaawanttu,</para>
  <para style="q2" vid="PSA 142:6">taw loytsi wolk'k'aameedda diraw,</para>
  <para style="q2" vid="PSA 142:6">taana unttunttuppe ashsha.<verse eid="PSA 142:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7" />Taani ne suntsaa galatana mala,</para>
  <para style="q2" vid="PSA 142:7">taana k'ashuwaappe billa.</para>
  <para style="q1" vid="PSA 142:7">Neeni taw keekiyaa diraw,</para>
  <para style="q2" vid="PSA 142:7">s'illotuu ta yuushshuwaan shiik'ana.<verse eid="PSA 142:7" /></para>
  <chapter eid="PSA 142" />
  <chapter number="143" style="c" sid="PSA 143" />
  <para style="s">S'oossaa Maaduwaa Demanaw Shiik'eedda Woosaa</para>
  <para style="d">Daawite s'aafeedda mazamuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1" />Abeet Med'inaa Godaw, ta woosaa sisa; ta watiwatuwaa hayzza.</para>
  <para style="q2" vid="PSA 143:1">Neeni s'illuwaanne ammanettiyaawaa gidiyaa diraw,</para>
  <para style="q2" vid="PSA 143:1">taw zaaruwaa imma.<verse eid="PSA 143:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2" />Ne sintsan s'illo gidana Asay baawa;<note caller="-" style="x"><char style="xo" closed="false">143:2 </char><char style="xt" closed="false"><ref loc="ROM 3:20">Rom. 3:20</ref>; <ref loc="GAL 2:16">Gal. 2:16</ref></char></note></para>
  <para style="q2" vid="PSA 143:2">hewaa diraw, taana ne k'oomaa pirddaw shiishshoppa.<verse eid="PSA 143:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3" />Taana ta morkkii yederssiide,</para>
  <para style="q2" vid="PSA 143:3">biittaana gatsi kinchchereetseedda;</para>
  <para style="q2" vid="PSA 143:3">beni hayk'k'eedda asatuwaadan taana d'uman wotseedda.<verse eid="PSA 143:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4" />Hewaa diraw, taani hidootaa k'ans's'aad;</para>
  <para style="q2" vid="PSA 143:4">ta wozanaykka yibbaateedda.<verse eid="PSA 143:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5" />Taani beni wodetuwaa hassayay;</para>
  <para style="q2" vid="PSA 143:5">neeni ootseedda oosuwaa ubbaa zaara zaaraadde k'oppaynne</para>
  <para style="q2" vid="PSA 143:5">ne kushii ootseeddawaa akeekay.<verse eid="PSA 143:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6" />Taani ta kushiyaa neekko mic'c'aad;</para>
  <para style="q2" vid="PSA 143:6">mela biittay haatsaa koyiyaawaadan,</para>
  <para style="q2" vid="PSA 143:6">ta shemppuu neena saamettee.<verse eid="PSA 143:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7" />Abeet Med'inaa Godaw, taw zaaruwaa immanaw elleella!</para>
  <para style="q2" vid="PSA 143:7">Taani hidootaa k'ans's'aad.</para>
  <para style="q1" vid="PSA 143:7">Taani duge duufuwaan geliyaa asatuwaa mala gidennaadan,</para>
  <para style="q2" vid="PSA 143:7">ne som"uwaa taappe gentsoppa.<verse eid="PSA 143:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8" />Taani neena ammanettiyaa diraw,</para>
  <para style="q2" vid="PSA 143:8">wontta wontta aggena ne siik'uwaa taana bessa.</para>
  <para style="q1" vid="PSA 143:8">Taani ta shemppuwaappe neena woossiyaa diraw,</para>
  <para style="q2" vid="PSA 143:8">taani baanaw bessiyaa ogiyaa taana tamaarissa.<verse eid="PSA 143:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9" />Abeet Med'inaa Godaw, taani neekko bak'ateedda diraw,</para>
  <para style="q2" vid="PSA 143:9">taana ta morkkatuwaappe ashsha.<verse eid="PSA 143:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10" />Neeni ta S'oossaa gidiyaa diraw,</para>
  <para style="q2" vid="PSA 143:10">taani ne sheniyaa ootsana mala, taana tamaarissa;</para>
  <para style="q2" vid="PSA 143:10">lo"o Ayyaanan taana suure ogiyaa kaaletsa.<verse eid="PSA 143:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11" />Abeet Med'inaa Godaw, ne suntsaa diraw, taana ashsha;</para>
  <para style="q2" vid="PSA 143:11">ne s'illotetsan taana metuwaappe kessa.<verse eid="PSA 143:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12" />Aggena ne siik'uwaan ta morkkatuwaa wod'a;</para>
  <para style="q2" vid="PSA 143:12">ta baaligaaratuwaa ubbaa d'ayissa;</para>
  <para style="q2" vid="PSA 143:12">ayaw gooppe, taani ne k'oomaa.<verse eid="PSA 143:12" /></para>
  <chapter eid="PSA 143" />
  <chapter number="144" style="c" sid="PSA 144" />
  <para style="s">S'oonuwaa Mazimuriyaa</para>
  <para style="d">Daawite s'aafeeddawaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1" />Med'inaa Goday, ta zaallay galatetto! I ta kushiyaa olaw,</para>
  <para style="q2" vid="PSA 144:1">ta birad'd'etuwaakka tooraw loohissee.<verse eid="PSA 144:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2" />I taana siik'iyaa S'oossaanne ta geessuwaa;</para>
  <para style="q2" vid="PSA 144:2">I ta miis'aanne taana ashshiyaawaa.</para>
  <para style="q1" vid="PSA 144:2">I ta gonddalliyaanne taani bak'ataade attiyaa sa'aa.</para>
  <para style="q2" vid="PSA 144:2">Kawutetsatuwaa I taw moodissiyaawaa.<verse eid="PSA 144:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3" />Abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 144:3">neeni aw k'oppiyaa Asay I ayee?<note caller="-" style="x"><char style="xo" closed="false">144:3 </char><char style="xt" closed="false"><ref loc="JOB 7:17-18">Yob. 7:17-18</ref>; <ref loc="PSA 8:4">Maz. 8:4</ref></char></note></para>
  <para style="q1" vid="PSA 144:3">Neeni naagetiyaa asaa na'ay ayee?<verse eid="PSA 144:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4" />Asay itti gede c'arkkiyaa c'arkkuwaa mala;</para>
  <para style="q2" vid="PSA 144:4">Aa gallassatukka aad'd'iyaa kuwaa mala.<verse eid="PSA 144:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5" />Abeet Med'inaa Godaw, ne saluwaa daakaade duge wod'd'a!</para>
  <para style="q2" vid="PSA 144:5">Wogga deretuwaa bochcha; unttunttukka c'uwattino!<verse eid="PSA 144:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6" />Walk'k'antsaa yeddaade ne morkkatuwaa laala!</para>
  <para style="q2" vid="PSA 144:6">Ne wonddaafiyaa pootsaa yeddaade unttuntta yederssa!<verse eid="PSA 144:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7" />Bollaanna ne kushiyaa duge yeddaade,</para>
  <para style="q2" vid="PSA 144:7">taana c'iimmo haatsatuwaappe goochchaade kessa;</para>
  <para style="q2" vid="PSA 144:7">allaga asatuwaa kushiyaappe taana wotsa akka.<verse eid="PSA 144:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8" />Unttunttu tumuwaa haasayikkino,</para>
  <para style="q2" vid="PSA 144:8">C'aak'k'iiddekka wordduwaa haasayiino.<verse eid="PSA 144:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9" />Abeet S'oossaw, taani</para>
  <para style="q2" vid="PSA 144:9">new ooratsa yetsaa yes's'ana;</para>
  <para style="q2" vid="PSA 144:9">tammu bak'etsaan waas'etteedda diitsaan new diis's'ana.<verse eid="PSA 144:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10" />Kaatetoo s'oonuwaa immaasa;</para>
  <para style="q2" vid="PSA 144:10">ne k'oomaa Daawita ashshaasa.<verse eid="PSA 144:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11" />Taana iitaa mashshaappe ashshaasa;</para>
  <para style="q2" vid="PSA 144:11">allaga asatuwaa kushiyaappe taana wotsa akka.</para>
  <para style="q1" vid="PSA 144:11">Unttunttu tumuwaa haasayana giide c'aak'k'iiddekka,</para>
  <para style="q2" vid="PSA 144:11">wordduwaa haasayiino.<verse eid="PSA 144:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12" />Nu attuma naanatuu,</para>
  <para style="q2" vid="PSA 144:12">barenttu yalagatetsan dolk'k'idolk'k'iide,</para>
  <para style="q2" vid="PSA 144:12">dic'c'iyaa mitsaa mala gidino.</para>
  <para style="q2" vid="PSA 144:12">Nu mac'c'a naanatuukka kaatiyaa golliyaa zooziyaan,</para>
  <para style="q2" vid="PSA 144:12">alleek'k'oo esseedda tuuk'iyaa mala gidino.<verse eid="PSA 144:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13" />Nu diyyetuu,</para>
  <para style="q2" vid="PSA 144:13">daro dumma dumma k'ommo katsaan kumino;</para>
  <para style="q2" vid="PSA 144:13">nu dembbatuwaan de'iyaa dorssatuu sha"aa,</para>
  <para style="q2" vid="PSA 144:13">tammu sha"aa yelino.<verse eid="PSA 144:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 144:14" />Nu miizzatuu birassino;</para>
  <para style="q2" vid="PSA 144:14">unttunttu sal"eesenan yelettiide c'orattino.</para>
  <para style="q1" vid="PSA 144:14">Nu ogetuwaan dagama waasuu sisettoppo.<verse eid="PSA 144:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15" />Ha yewuu tumu haniyaa asatuu,</para>
  <para style="q2" vid="PSA 144:15">anjjetteeddawantta.</para>
  <para style="q1" vid="PSA 144:15">Unttunttu S'oossay Med'inaa Godaa gidiyaa asatuu</para>
  <para style="q2" vid="PSA 144:15">anjjetteeddawantta.<verse eid="PSA 144:15" /></para>
  <chapter eid="PSA 144" />
  <chapter number="145" style="c" sid="PSA 145" />
  <para style="s">Galataa S'oossaw</para>
  <para style="d">Daawite s'aafeedda galataa sabaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1" />Abeet ta S'oossaw, ta kaatiyaw, taani neena gitayananne,</para>
  <para style="q2" vid="PSA 145:1">ne suntsaa med'i med'inaw galatana.<verse eid="PSA 145:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2" />Taani neena ubbaa gallassi sabbana;</para>
  <para style="q2" vid="PSA 145:2">ne suntsaakka med'i med'inaw galatana.<verse eid="PSA 145:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3" />Med'inaa Goday wolk'k'aama; d'ok'k'a galatay aw bessee.</para>
  <para style="q2" vid="PSA 145:3">Aa gitatetsay asaa k'ofaappe aad'd'ee.<verse eid="PSA 145:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4" />Itti yeletay hara yeletaw</para>
  <para style="q2" vid="PSA 145:4">neeni ootseeddawaa odana;</para>
  <para style="q2" vid="PSA 145:4">ne malalissiyaa oosotuwaakka awaayana.<verse eid="PSA 145:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5" />Unttunttu ne bonchchuwaanne</para>
  <para style="q2" vid="PSA 145:5">ne anggaa gitatetsaabaa haasayana;</para>
  <para style="q2" vid="PSA 145:5">taanikka ne malalissiyaa oosuwaa</para>
  <para style="q2" vid="PSA 145:5">zaara zaaraadde k'oppana.<verse eid="PSA 145:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6" />Asay, «Hoola!» giissiyaa ne oosuwaa wolk'k'aabaa haasayana;</para>
  <para style="q2" vid="PSA 145:6">taanikka ne gitatetsaa awaayana.<verse eid="PSA 145:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7" />Unttunttu ne keekkatetsaa daruwaa odana;</para>
  <para style="q2" vid="PSA 145:7">ne s'illotetsaabaakka yes's'ana.<verse eid="PSA 145:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8" />Med'inaa Goday k'arettiyaawaanne maariyaawaa;</para>
  <para style="q2" vid="PSA 145:8">I hank'k'ettanaw elleellennawaanne;</para>
  <para style="q2" vid="PSA 145:8">danddayanchchanne aggena siik'uu dariyaawaa.<verse eid="PSA 145:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9" />Med'inaa Goday ubbaw keeka;</para>
  <para style="q2" vid="PSA 145:9">I bare med'd'eedda ubbaw k'arettiyaawaa.<verse eid="PSA 145:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10" />Abeet Med'inaa Godaw,</para>
  <para style="q2" vid="PSA 145:10">ne med'etaa ubbay neena galatana;</para>
  <para style="q2" vid="PSA 145:10">ne asatuu ubbaykka neena sabbana.<verse eid="PSA 145:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11" />Unttunttu ne kawutetsaa bonchchuwaabaa haasayana;</para>
  <para style="q2" vid="PSA 145:11">ne wolk'k'aabaa odana.<verse eid="PSA 145:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12" />Hewenne, ne wolk'k'aama oosuwaabaanne</para>
  <para style="q2" vid="PSA 145:12">ne kawutetsaa bonchchuwaa anggaabaa</para>
  <para style="q2" vid="PSA 145:12">asaa erissana.<verse eid="PSA 145:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13" />Ne kawutetsay med'inaa kawutetsaa;</para>
  <para style="q2" vid="PSA 145:13">ne maatay yeletaa ubbaa gakkanaassa.</para>
  <para style="b" vid="PSA 145:13" />
  <para style="q1" vid="PSA 145:13">Med'inaa Goday bare geedda k'aalaw ubbaw ammanettiyaawaa;</para>
  <para style="q2" vid="PSA 145:13">I bare oosuwaa ubbaan k'arettiyaawaa.<verse eid="PSA 145:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14" />Med'inaa Goday hokkeeddawantta ubbaa zemppissee;</para>
  <para style="q2" vid="PSA 145:14">kunddeeddawantta ubbaa dentsee.<verse eid="PSA 145:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15" />Ubbaa ayifii neekko s'eellee;</para>
  <para style="q2" vid="PSA 145:15">unttuntta koshshiyaa wodiyaan neeni unttunttoo k'umaa immaasa.<verse eid="PSA 145:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16" />Neeni ne kushiyaappe imma;</para>
  <para style="q2" vid="PSA 145:16">pas'a de'iyaawantta ubbaa amuwaa alaa.<verse eid="PSA 145:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17" />Med'inaa Goday bare ogiyaan ubbaan s'illuwaa;</para>
  <para style="q2" vid="PSA 145:17">I bare oosuwaa ubbaan k'arettiyaawaa.<verse eid="PSA 145:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18" />Med'inaa Goday barena s'eesiyaa ubbaw,</para>
  <para style="q2" vid="PSA 145:18">tumuwaan barena s'eesiyaa ubbaw matan de'ee.<verse eid="PSA 145:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19" />I barew yayyiyaawanttu ubbaw,</para>
  <para style="q2" vid="PSA 145:19">amuwaa kuntsee.</para>
  <para style="q1" vid="PSA 145:19">K'ay I unttunttu waasuwaa sisiide,</para>
  <para style="q2" vid="PSA 145:19">unttuntta ashshee.<verse eid="PSA 145:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20" />Med'inaa Goday barena siik'iyaawantta ubbaa naagee;</para>
  <para style="q2" vid="PSA 145:20">shin iitatuwaa ubbaa d'ayissana.<verse eid="PSA 145:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21" />Taani ta doonaan Med'inaa Godaa galatana.</para>
  <para style="q2" vid="PSA 145:21">Med'etaa ubbay Aa geeshsha suntsaa</para>
  <para style="q2" vid="PSA 145:21">med'i med'inaw galato!<verse eid="PSA 145:21" /></para>
  <chapter eid="PSA 145" />
  <chapter number="146" style="c" sid="PSA 146" />
  <para style="s">Maadda S'oossaw Galataa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1" />Med'inaa Godaa galatite!</para>
  <para style="b" vid="PSA 146:1" />
  <para style="q2" vid="PSA 146:1">Ta shemppattee Med'inaa Godaa galataa!<verse eid="PSA 146:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2" />Ta de'uwaa laytsaa ubbaan,</para>
  <para style="q2" vid="PSA 146:2">taani Med'inaa Godaa galatana;</para>
  <para style="q2" vid="PSA 146:2">taani de'eedda keenan ubbaan</para>
  <para style="q2" vid="PSA 146:2">ta S'oossaa sabbana.<verse eid="PSA 146:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3" />Asay ashshanaw danddayenna diraw,</para>
  <para style="q2" vid="PSA 146:3">asaa kaappatuwaan ammanettoppite.<verse eid="PSA 146:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4" />Unttunttu shemppuu kesiyaa wode,</para>
  <para style="q2" vid="PSA 146:4">unttunttu biittaw simmiino;</para>
  <para style="q2" vid="PSA 146:4">unttunttu halchchuu ubbay</para>
  <para style="q2" vid="PSA 146:4">he gallassikka atti aggee.<verse eid="PSA 146:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5" />Yaak'ooba S'oossay maaddiyaa uraynne</para>
  <para style="q2" vid="PSA 146:5">Med'inaa Godaa bare S'oossaa barew hidootaa ootsiyaa uray,</para>
  <para style="q2" vid="PSA 146:5">anjjetteeddawaa.<verse eid="PSA 146:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6" />Med'inaa Goday saluwaanne sa'aa,</para>
  <para style="q2" vid="PSA 146:6">wolk'k'aama abbaanne Aa giddon de'iyaawaa ubbaa,</para>
  <para style="q2" vid="PSA 146:6">med'd'eeddawaa;<note caller="-" style="x"><char style="xo" closed="false">146:6 </char><char style="xt" closed="false"><ref loc="ACT 4:24">Kit. 4:24</ref>; <ref loc="ACT 14:15">14:15</ref></char></note></para>
  <para style="q2" vid="PSA 146:6">I med'inawukka ammanettiyaawaa.<verse eid="PSA 146:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7" />I naak'etteeddawanttoo pirddiyaawaa;</para>
  <para style="q2" vid="PSA 146:7">koshateeddawanttoo k'umaa immiyaawaa.</para>
  <para style="b" vid="PSA 146:7" />
  <para style="q1" vid="PSA 146:7">Med'inaa Goday k'ashetteeddawantta billee;<verse eid="PSA 146:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 146:8" />Med'inaa Goday k'ook'etuwaa s'eelissee.</para>
  <para style="q2" vid="PSA 146:8">Med'inaa Goday kunddeeddawantta dentsee;</para>
  <para style="q1" vid="PSA 146:8">Med'inaa Goday s'illotuwaa siik'ee.<verse eid="PSA 146:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9" />Med'inaa Goday betetuwaa naagee.</para>
  <para style="q2" vid="PSA 146:9">Am"etuwaanne aawuu bayinna naanatuwaa maaddee;</para>
  <para style="q2" vid="PSA 146:9">shin iitatuwaa ogiyaa baletsee.<verse eid="PSA 146:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10" />Med'inaa Goday med'inaw kaatetee.</para>
  <para style="q2" vid="PSA 146:10">S'iyoonee, ne S'oossay,</para>
  <para style="q2" vid="PSA 146:10">yeletaappe yeletaa gakkanaw kaatetana.</para>
  <para style="b" vid="PSA 146:10" />
  <para style="q2" vid="PSA 146:10">Med'inaa Godaa galatite!<verse eid="PSA 146:10" /></para>
  <chapter eid="PSA 146" />
  <chapter number="147" style="c" sid="PSA 147" />
  <para style="s">Ubbaa Danddayiyaa S'oossaw Shiik'iyaa Galataa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1" />Med'inaa Godaa galatite! Nu S'oossaa sabbiyaawe lo"a;</para>
  <para style="q2" vid="PSA 147:1">Aa sabbiyaawe nashechchiyaabaanne bessiyaawaa.<verse eid="PSA 147:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2" />Med'inaa Goday Yerusaalame ooratsana;</para>
  <para style="q2" vid="PSA 147:2">Israa'eeliyaa asatuwaappe beteeddawanttakka shiishshana.<verse eid="PSA 147:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3" />Wozanay me"eeddawantta I patsee;</para>
  <para style="q2" vid="PSA 147:3">unttunttu madutsaakka I k'achchee.<verse eid="PSA 147:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4" />I s'oolinttetuwaa</para>
  <para style="q2" vid="PSA 147:4">unttunttu payduwaan eree;</para>
  <para style="q2" vid="PSA 147:4">unttuntta ubbaakka unttunttu suntsan suntsan s'eesee.<verse eid="PSA 147:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5" />Nu Goday wolk'k'aama; Aa wolk'k'ay dara;</para>
  <para style="q2" vid="PSA 147:5">Aa akeekay likkiyaappe aad'd'iyaawaa.<verse eid="PSA 147:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6" />Med'inaa Goday naak'etteeddawantta zemppissee;</para>
  <para style="q2" vid="PSA 147:6">shin iitatuwaa biittan duge olee.<verse eid="PSA 147:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7" />Med'inaa Godaw galataa yetsaa yes's'ite;</para>
  <para style="q2" vid="PSA 147:7">nu S'oossaw diitsaa diis's'ite.<verse eid="PSA 147:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8" />I saluwaa shaariyaa kamee;</para>
  <para style="q2" vid="PSA 147:8">sa'aw iraa bukissee;</para>
  <para style="q2" vid="PSA 147:8">k'eeri deretuwaa bolla maataa mokissee.<verse eid="PSA 147:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9" />Mehetoonne waassiyaa k'uuruwaa maratoo,</para>
  <para style="q2" vid="PSA 147:9">miyaawaa I immee.<verse eid="PSA 147:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10" />I nashettiyaawe paratuwaa wolk'k'aaninne,</para>
  <para style="q2" vid="PSA 147:10">tooranchchatu minotetsan gidenna.<verse eid="PSA 147:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11" />Med'inaa Goday barew yayyiyaawanttuninne</para>
  <para style="q2" vid="PSA 147:11">aggena Aa siik'uwaan,</para>
  <para style="q2" vid="PSA 147:11">barenttu hidootaa wotseeddawanttun nashettee.<verse eid="PSA 147:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12" />Yerusaalame katamatee, Med'inaa Godaa galataa!</para>
  <para style="q2" vid="PSA 147:12">S'iyoonee, ne S'oossaa galataa!<verse eid="PSA 147:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13" />Ayaw gooppe, I,</para>
  <para style="q2" vid="PSA 147:13">ne penggiyaa kulbbatuwaa minisee;</para>
  <para style="q2" vid="PSA 147:13">ne giddon de'iyaa ne asaakka anjjee.<verse eid="PSA 147:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14" />I ne zawaa sarotetsaan naagee;</para>
  <para style="q2" vid="PSA 147:14">neena loytsi lo"iyaa zarggaa kalissee.<verse eid="PSA 147:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15" />I bare kiitaa sa'aw kiittee;</para>
  <para style="q2" vid="PSA 147:15">Aa k'aalaykka elle gakkee.<verse eid="PSA 147:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16" />I shachchaa bullukkuwaadan mic'c'ee;</para>
  <para style="q2" vid="PSA 147:16">ketterssaa bidintsaadan laalee.<verse eid="PSA 147:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17" />I bare wolk'k'aama shachchaa</para>
  <para style="q2" vid="PSA 147:17">shuchchaadan duge olee.</para>
  <para style="q1" vid="PSA 147:17">He meeguwaan ek'k'anaw ooninne danddayenna.<verse eid="PSA 147:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18" />I bare k'aalaa kiittiide,</para>
  <para style="q2" vid="PSA 147:18">shachchaa muushissee.</para>
  <para style="q1" vid="PSA 147:18">I c'arkkuwaa c'arkkissina, haatsay goggee.<verse eid="PSA 147:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19" />I bare k'aalaa Yaak'ooba zeretsaw,</para>
  <para style="q2" vid="PSA 147:19">bare awaayuwaanne pirddaa</para>
  <para style="q1" vid="PSA 147:19">Israa'eeliyaa asaw awaayee.<verse eid="PSA 147:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20" />I hara kawutetsaa asaw,</para>
  <para style="q2" vid="PSA 147:20">hawaa ootsibeenna;</para>
  <para style="q2" vid="PSA 147:20">unttunttu Aa pirddaa erikkino.</para>
  <para style="b" vid="PSA 147:20" />
  <para style="q2" vid="PSA 147:20">Med'inaa Godaa galatite!<verse eid="PSA 147:20" /></para>
  <chapter eid="PSA 147" />
  <chapter number="148" style="c" sid="PSA 148" />
  <para style="s">Med'etay Ubbay S'oossaa Galato</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1" />Med'inaa Godaa galatite!</para>
  <para style="b" vid="PSA 148:1" />
  <para style="q2" vid="PSA 148:1">Salotuwaan de'iyaawanttoo, Med'inaa Godaa galatite;</para>
  <para style="q2" vid="PSA 148:1">bolla d'ok'k'an de'iyaawanttoo, Aa galatite.<verse eid="PSA 148:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2" />Hinttenoo, Aa kiitanchchatoo,</para>
  <para style="q2" vid="PSA 148:2">ubbatuu Aa galatite.</para>
  <para style="q1" vid="PSA 148:2">Saluwaan de'iyaa Aa olanchchatoo,</para>
  <para style="q2" vid="PSA 148:2">ubbatuu Aa galatite.<verse eid="PSA 148:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3" />Awaw, aginaw, Aa galatite;</para>
  <para style="q2" vid="PSA 148:3">poo'iyaa s'oolinttetoo, ubbatoo Aa galatite.<verse eid="PSA 148:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4" />Hinttenoo, ubbaappe bolla d'ok'k'an de'iyaa salotoo,</para>
  <para style="q2" vid="PSA 148:4">Aa galatite.</para>
  <para style="q1" vid="PSA 148:4">Saluwaappe bollaanna de'iyaa haatsatoo,</para>
  <para style="q2" vid="PSA 148:4">Aa galatite.<verse eid="PSA 148:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5" />Unttunttu ubbatuu Med'inaa Godaa suntsaa galatino;</para>
  <para style="q2" vid="PSA 148:5">ayaw gooppe, I azazina,</para>
  <para style="q1" vid="PSA 148:5">Unttunttu ubbaykka med'etteeddino.<verse eid="PSA 148:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6" />I unttuntta med'i med'inaw</para>
  <para style="q2" vid="PSA 148:6">unttunttu sa'aan sa'aan wotseedda.</para>
  <para style="q1" vid="PSA 148:6">Unttunttu ubbakka is's'anaw danddayenna azazuwaa I unttunttoo immeedda.<verse eid="PSA 148:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7" />Sa'aan de'iyaawanttoo, Med'inaa Godaa galatite!</para>
  <para style="q2" vid="PSA 148:7">Abban de'iyaa med'etatoo, wolk'k'aama abbaa c'iimmatoo,</para>
  <para style="q2" vid="PSA 148:7">ubbatuukka Aa galatite.<verse eid="PSA 148:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8" />Hinttenoo, walk'k'antsaw,</para>
  <para style="q2" vid="PSA 148:8">shachchaw, shaariyaw, c'aaganaw,</para>
  <para style="q1" vid="PSA 148:8">Aa azazuwaa poliyaa gotiyaw,</para>
  <para style="q2" vid="PSA 148:8">Ubbatuukka Aa galatite.<verse eid="PSA 148:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9" />Hinttenoo, deretoo, zoozetoo,</para>
  <para style="q2" vid="PSA 148:9">Miyaa ayifiyaa ayifiyaa mitsatoo, zigatoo,</para>
  <para style="q2" vid="PSA 148:9">ubbatuukka Aa galatite.<verse eid="PSA 148:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10" />Mehetoo, do'atoo,</para>
  <para style="q2" vid="PSA 148:10">sa'aanna gooshettiyaa med'etatoo,</para>
  <para style="q2" vid="PSA 148:10">paalliyaa kafotoo,</para>
  <para style="q2" vid="PSA 148:10">Ubbatuukka Aa galatite.<verse eid="PSA 148:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11" />Sa'aa kaatetoo, kawutetsaa asatoo,</para>
  <para style="q2" vid="PSA 148:11">kaappatoo, asaa mooddiyaawanttoo,</para>
  <para style="q1" vid="PSA 148:11">Ubbatuukka Aa galatite.<verse eid="PSA 148:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12" />Wodallatoo, wodoratoo,</para>
  <para style="q2" vid="PSA 148:12">c'imatoo, naanaatoo,</para>
  <para style="q1" vid="PSA 148:12">Ubbatuukka Aa galatite!<verse eid="PSA 148:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13" />Unttunttu ubbatuu Med'inaa Godaa suntsaa galatino;</para>
  <para style="q2" vid="PSA 148:13">Ayaw gooppe, Aa suntsay ubbaappe bollaanna de'iyaawaa;</para>
  <para style="q1" vid="PSA 148:13">Aa bonchchuu salotuwaappekka sa'aappekka bollaanna d'ok'k'an de'ee.<verse eid="PSA 148:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14" />Aa bagga gidiyaa, aw matattiyaa Israa'eeliyaa asatuu,</para>
  <para style="q2" vid="PSA 148:14">Aa galatana mala, I unttuntta minisee.</para>
  <para style="b" vid="PSA 148:14" />
  <para style="q1" vid="PSA 148:14">Med'inaa Godaa galatite!<verse eid="PSA 148:14" /></para>
  <chapter eid="PSA 148" />
  <chapter number="149" style="c" sid="PSA 149" />
  <para style="s">S'oonuwaa Mazimuriyaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1" />Med'inaa Godaa galatite! Med'inaa Godaw ooratsa yetsaa yes's'ite!</para>
  <para style="q2" vid="PSA 149:1">Ammaniyaawanttu shiik'uwaan Aa sabbite!<verse eid="PSA 149:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2" />Israa'eeliyaa asatuu</para>
  <para style="q2" vid="PSA 149:2">barentta med'd'eeddawaan nashetino.</para>
  <para style="q1" vid="PSA 149:2">S'iyoone asatuu barenttu kaatiyaan loytsi nashetino.<verse eid="PSA 149:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3" />Duriidde, karabuwaa bak'k'iiddenne,</para>
  <para style="q2" vid="PSA 149:3">diitsaa diis's'iidde, Aa suntsaa sabbino.<verse eid="PSA 149:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4" />Ayaw gooppe, S'oossay bare asan nashettee;</para>
  <para style="q2" vid="PSA 149:4">Naak'etteeddawanttoo s'oonuwaa immiide,</para>
  <para style="q1" vid="PSA 149:4">I unttuntta bonchchee.<verse eid="PSA 149:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5" />Asatuu barenttu s'oonuwaan nashetino;</para>
  <para style="q2" vid="PSA 149:5">k'amman ubbaan nashshechchaw yes's'ino.<verse eid="PSA 149:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6" />Unttunttu doonaan S'oossaa galatay,</para>
  <para style="q2" vid="PSA 149:6">unttunttu kushiyankka laa"u bagga kuussa mashshay de'o.<verse eid="PSA 149:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7" />Hewekka, unttunttu kawutetsatoo,</para>
  <para style="q2" vid="PSA 149:7">haluwaa kessanaassanne asatuwaa muranaassa.<verse eid="PSA 149:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8" />Unttunttu kaatetuwaa sanssalatan,</para>
  <para style="q2" vid="PSA 149:8">unttunttu olaa gadaawatuwaakka birataan k'achchanaassanne,<verse eid="PSA 149:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9" />unttunttu bolla s'aafetteedda pirddaa polanaassa.</para>
  <para style="q2" vid="PSA 149:9">Hewe S'oossaa asatuwaa ubbaw s'oonuwaa.</para>
  <para style="b" vid="PSA 149:9" />
  <para style="q1" vid="PSA 149:9">Med'inaa Godaa galatite!<verse eid="PSA 149:9" /></para>
  <chapter eid="PSA 149" />
  <chapter number="150" style="c" sid="PSA 150" />
  <para style="s">S'oossaa Galatite</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1" />Med'inaa Godaa galatite!</para>
  <para style="b" vid="PSA 150:1" />
  <para style="q2" vid="PSA 150:1">Aa geeshsha sa'aan S'oossaa galatite;</para>
  <para style="q2" vid="PSA 150:1">Aa wolk'k'aama saluwaan Aa galatite.<verse eid="PSA 150:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2" />Aa wolk'k'aama oosatuwaa diraw, Aa galatite;</para>
  <para style="q2" vid="PSA 150:2">ubbaappe aad'd'iyaa Aa gitatetsaadan Aa galatite.<verse eid="PSA 150:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3" />Malakataa punniidde, Aa galatite;</para>
  <para style="q2" vid="PSA 150:3">Diitsaanne maasink'k'uwaa diis's'iidde,</para>
  <para style="q1" vid="PSA 150:3">Aa galatite.<verse eid="PSA 150:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4" />Darbbiyaa bak'k'iiddenne duriide,</para>
  <para style="q2" vid="PSA 150:4">Aa galatite;</para>
  <para style="q1" vid="PSA 150:4">Diitsaa diis's'iiddinne lookkuwaa punniidde, Aa galatite.<verse eid="PSA 150:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5" />Dawalaa k'aatsiidde, Aa galatite;</para>
  <para style="q2" vid="PSA 150:5">dawalaa shoc'iide, Aa galatite.<verse eid="PSA 150:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6" />Pas'a shemppatuu ubbatuu,</para>
  <para style="q2" vid="PSA 150:6">Med'inaa Godaa galatino!</para>
  <para style="b" vid="PSA 150:6" />
  <para style="q1" vid="PSA 150:6">Med'inaa Godaa galatite!<verse eid="PSA 150:6" /></para>
  <chapter eid="PSA 150" />
</usx>