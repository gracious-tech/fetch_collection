  <para style="io2">Geeshsha Golliyaa Oosuwaa <char style="ior"><ref loc="1KI 5:1-8:66">5:1—8:66</ref></char></para>
  <para style="io2">Wurssetsaa Laytsatuwaa <char style="ior"><ref loc="1KI 9:1-11:43">9:1—11:43</ref></char></para>
  <para style="io1">Shaaketteedda Kawutetsaa <char style="ior"><ref loc="1KI 12:1-22:53">12:1—22:53</ref></char></para>
  <para style="io2">Pudehaa Yaratuwaa Makkalaa <char style="ior"><ref loc="1KI 12:1-14:20">12:1—14:20</ref></char></para>
  <para style="io2">Yihudaanne Israa'eeliyaa Kaatetuwaa <char style="ior"><ref loc="1KI 14:21-16:34">14:21—16:34</ref></char></para>
  <para style="io2">Nabiyaa Eelaassa <char style="ior"><ref loc="1KI 17:1-19:21">17:1—19:21</ref></char></para>
