<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JON" style="id">- Terjemahan Bahasa Dusun Malang</book>
  <para style="toc3">Yun.</para>
  <para style="toc1">YUNUS</para>
  <para style="toc2">Yunus</para>
  <para style="mt1">YUNUS</para>
  <chapter number="1" style="c" sid="JON 1" />
  <para style="s">Yunus Mo Tumun Terau TUHAN</para>
  <para style="pi">
    <verse number="1" style="v" sid="JON 1:1" />Hulet pirman TUHAN tong nabi Yunus anak Amitai, ngunau ti: <verse eid="JON 1:1" /><verse number="2" style="v" sid="JON 1:2" />"Buat! Tulak nu tong Niniwe, leu sa gaya aro, mara lukun ire bahwa TUHAN sagar nguhukum ire, gana kadaat ire haot hampe tong-Ku.<verse eid="JON 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 1:3" />Tapi Yunus bat pukuyo arepne de tong Tarsis, oro neke tama TUHAN.Yunus tulak tong Yapo tahui halu tei anai isa kapal, sa kakan tulak tong Tarsis. Yunus mayat prah pangalanne, tahui mamai kapal hiyo de balayar dadayo lukun ire tong Tarsis oro neke tama TUHAN.<verse eid="JON 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 1:4" />Tapi TUHAN pikinau riwut barat tong tahik, tahui jari riwut barat, gana hiyo kapal hiyo migisit bedah rakai. <verse eid="JON 1:4" /><verse number="5" style="v" sid="JON 1:5" />Anak buah kapal jari takut bebene, sining tenga nerau dewane, tahui ire nampi tong huang tahik mehe muatan kapal hiyo de peneanne. Tapi Yunus haot minau tong huang ruangan kapal sa paling hane tahui kading tei hiyo, tahui mandre rerek.<verse eid="JON 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 1:6" />Hulet jurumudi kapal, bakahalu lukun ne tahui paner: "Ngunau awe leon nu mandre ngunau hiyo kererek? Sele! Bodoa lukun dewanu! Behe dewanu hiyo inuh awat taka, de taka mo jangan."<verse eid="JON 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JON 1:7" />Tahui paner ire isa lukun sa mehe: "Ayu taka gawi pangantah, de taka tanau, gana oha hiye taka tinipan jangan ti." Tahui ire ngantah Yunus sa kuno antah.<verse eid="JON 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JON 1:8" />Ire kuhui lukun Yunus: "Wara lukun kamin, kuno hiye taka tinipan jangan ti? Hiye gawinu teke awe nu hulet, hiye negrinu lukun teke awe sukunu?"<verse eid="JON 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 1:9" />Samut Yunus lukun ire: "Ku lun Ibrani. Ku patuh lukun TUHAN, Allah sa ampun langit, sa haot gawi tahik lukun bawo."<verse eid="JON 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 1:10" />Lun hiyo jari tamam takut, tahui paner lukun Yunus: "Hiye sa haot dakawi nu?" Gana lun hiyo tanau, kuno ne pukuyo arepne oro neke tama TUHAN. Gana hal hiyo haot dawara Yunus lukun ire.<verse eid="JON 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JON 1:11" />Tane pudi ire: "Ngunau awe leon kamin gawi nu, de tahik tau lempoi lukun mo manyarang kamin eso, gana tahik makin ngulupuat."<verse eid="JON 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JON 1:12" />Samut Yunus lukun ire: "Engkat bo ku, lampi ku tong huang tahik, maka tahik sagar jari lempoi lukun mo manyarang kon eso, gana ku tanau, kuno ku ti riwut barat pehes manyarang kon." <verse eid="JON 1:12" /><verse number="13" style="v" sid="JON 1:13" />Tahui batanyu lun hiyo hampe oreng uyat tulang de oit kapal hiyo waleng tong pampang, tapi ire mo inuh gana tahik makin ngulupuat manyarang ire.<verse eid="JON 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JON 1:14" />Tahui bodoa ire lukun TUHAN sa sanambah Yunus, uhui ire: "Oh TUHAN, ada Nu nonop kamin bajangan, kuno nyawa lun ti lukun ada Nu pitipan tong kamin raha lun sa mo basala, gana Nu TUHAN, haot gawi ngunau sa kanakan Nu." <verse eid="JON 1:14" /><verse number="15" style="v" sid="JON 1:15" />Tahui ire ngengkat Yunus, nampi ne tong huang tahik, tahik tahui teno ngulupuat. <verse eid="JON 1:15" /><verse number="16" style="v" sid="JON 1:16" />Anak buah kapal hiyo jari tamam takut lukun TUHAN tahui ngokoi eha sa teneleng dela TUHAN, lukun bajanyi.<verse eid="JON 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JON 1:17" />Munan pangakan TUHAN hulet erai bulot kenah gaya sa nelen Yunus sengkewelum. Yunus muneng tei huang sanai kenah hiyo telu andrau telu malem kengelane.<verse eid="JON 1:17" /></para>
  <chapter eid="JON 1" />
  <chapter number="2" style="c" sid="JON 2" />
  <para style="s">Doa Yunus</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 2:1" />Bodoa Yunus tong TUHAN Allahne, neke huang sanai kenah hiyo. <verse eid="JON 2:1" /><verse number="2" style="v" sid="JON 2:2" />Uhuine,</para>
  <para style="q1" vid="JON 2:2">"Huang kasasatku, ku nerau TUHAN, tahui Ne nyamut ku,</para>
  <para style="q2" vid="JON 2:2">teke botuk dinia lun matei ku mingkiak,</para>
  <para style="q2" vid="JON 2:2">tahui Nu keringo eau wawaku.<verse eid="JON 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JON 2:3" />Haot Nu monting ku tong uneng sa lalem,</para>
  <para style="q2" vid="JON 2:3">tong puhet tahik,</para>
  <para style="q2" vid="JON 2:3">tahui ku sinimpun awi ranu;</para>
  <para style="q2" vid="JON 2:3">kahai kulupuat lukun umak Nu ngililing ku.<verse eid="JON 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JON 2:4" />Tahui ku bapaner: haot tunulak ku neke tama mate-Nu.</para>
  <para style="q2" vid="JON 2:4">Behe ku tau neau eso blai-Nu sa barasih.<verse eid="JON 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JON 2:5" />Kahai ranu haot ngapungku, ngantam umurku, tahik ngililing;</para>
  <para style="q2" vid="JON 2:5">lut tahik ngililit utekku.<verse eid="JON 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JON 2:6" />Tei hane gunung. Ku leteng tei hane tane, jawongne nyawalang tei likut ku,</para>
  <para style="q2" vid="JON 2:6">de sekekelane. Hayak hiyolei Nu pakamai umurku.</para>
  <para style="q2" vid="JON 2:6">Teke huang luang ogang, Oh TUHAN, Allahku.<verse eid="JON 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JON 2:7" />Rahat aheng ku uyuh mole tei huang ku,</para>
  <para style="q2" vid="JON 2:7">tirikingatku lukun TUHAN tahui hampe doaku tong Nu,</para>
  <para style="q2" vid="JON 2:7">tong huang blai-Nu sa barasih.<verse eid="JON 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JON 2:8" />Ire sa basaput lukun berhala awe bugunai,</para>
  <para style="q2" vid="JON 2:8">ire sa noyak Tuhan sa sasi ire lukun bukuh.<verse eid="JON 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JON 2:9" />Tapi ku kuhui syukur lukun TUHAN sagar ngokoi kurban tong Tuhan,</para>
  <para style="q2" vid="JON 2:9">hiye sa kanajanji ku sagar panayat.</para>
  <para style="q2" vid="JON 2:9">Kasalamatan naan neke TUHAN!"<verse eid="JON 2:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="JON 2:10" />Libas hiyo bipirman TUHAN lukun kenah hiyo, tahui kenah hiyo nua Yunus tong pampang.<verse eid="JON 2:10" /></para>
  <chapter eid="JON 2" />
  <chapter number="3" style="c" sid="JON 3" />
  <para style="s">Yunus Botobat</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 3:1" />Tahui TUHAN bipirman lukun Yunus de sa kurueh kaline, ngunau ti: <verse eid="JON 3:1" /><verse number="2" style="v" sid="JON 3:2" />"Buat, tulak tong Niniwe, leu sa gaya aro, tahui pahampe lukun ire wesen sa dokoi-Ku tongnu."<verse eid="JON 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 3:3" />Kinsen Yunus, tahui tulak tong Niniwe, susuai lukun pirman TUHAN. Niniwe isa lei sa mengagumkan gayane, telu andrau pangalan luasne. <verse eid="JON 3:3" /><verse number="4" style="v" sid="JON 3:4" />Malai Yunus huluk tong huang leu hiyo erai andrau alan kongorone, tahui ne mara: "Epat pulu andrau eso maka Niniwe sagar kanabalik kinibilei."<verse eid="JON 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 3:5" />Lun Niniwe prasaya lukun Allah, tahui ire patau de puasa neke lun sa tuha hampe sa nikia, pakai kain kabung.<verse eid="JON 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 3:6" />Hayak hampe kabar hiyo tong raja leu Niniwe, minau ne neke takhtane, delepakne jubahne, tahui sunuruwoune kain kabung, tahui ne maharung tei munan belenun. <verse eid="JON 3:6" /><verse number="7" style="v" sid="JON 3:7" />Tahui munan singku raja lukun pajabatne nyingku lukun kuhui tei Niniwe ngunau ti:</para>
  <para style="pi" vid="JON 3:7">"Mirisia lukun eha pemelum, lembu, sapi, lukun kaming domba mo tau kuman hiye-hiye, lukun mo tau kinum ranu. <verse eid="JON 3:7" /><verse number="8" style="v" sid="JON 3:8" />Harus kongoreng mirisia busuruwou kain kabung. Kongoreng eha pemelum sunuruwou kain kabung. Tahui ire bodoa tong Allah, sining kulun waleng neke hadatne, lukun neke kangasar sa haot dawine. <verse eid="JON 3:8" /><verse number="9" style="v" sid="JON 3:9" />Behe Allah sagar meneser neke kasangit-Ne sa mentur menar hiyo, de taka mo bajangan.<verse eid="JON 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 3:10" />Hayak Allah neau gawi ire hiyo, ngunau awe ire bapaling neke hadat ire, tahui meneser Allah gana bajangan sa haot daransana-Ne tong ire, tahui Ne mo jari nguhukum ire.<verse eid="JON 3:10" /></para>
  <chapter eid="JON 3" />
  <chapter number="4" style="c" sid="JON 4" />
  <para style="s">Yunus balajar insap, gana Allah sasi bangsa-bangsa sa Lain</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 4:1" />Tapi hal hiyo mla pikiket aheng Yunus, tahui sangit ne. <verse eid="JON 4:1" /><verse number="2" style="v" sid="JON 4:2" />Tahui bodoa ne tong TUHAN, uhui ne: "Oh TUHAN, maka haot ku kuhui hal hiyo, rahat ku eso tei negri ku? Hiyo ganane, ku hono pukuyo arep ku neke Tarsis, gana ku tanau, TUHAN Allah sa penu kumurah aheng lukun pangahi mo golek sangit. TUHAN pangahi lukun bukuh tahui sa meneser gana jangan sa kakan punuhulet-Ne. <verse eid="JON 4:2" /><verse number="3" style="v" sid="JON 4:3" />Jari hayak ti, oh TUHAN go bo nyawa ku, gana keleh ku matei neke ku welum."<verse eid="JON 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 4:4" />Samut TUHAN: "Tau nu sangit?"<verse eid="JON 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 4:5" />Yunus haot losek melah leu hiyo tahui muneng tei tuhi Timur. Ne gawi suruap tei hiyo, tahui maharung huang suruap hiyo. Kandrei hiye sa sagar jari munan leu Niniwe. <verse eid="JON 4:5" /><verse number="6" style="v" sid="JON 4:6" />Tahui TUHAN Allah putumu erai poneng pumule sa pidium Yunus, de Yunus tihibur neke kingiket ahengne.<verse eid="JON 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JON 4:7" />Kiat andrau Allah gawi erai bulot lungkung, sa kuman wakat pumule hiyo tahui layo. <verse eid="JON 4:7" /><verse number="8" style="v" sid="JON 4:8" />Libas mate andrau hulet, Allah puhulet riwut sa malayong neke tuhi Timur. Yunus migisit pisan kuno kai andrau sa malayong ngunau sunuru kuno utekne, Yunus manyarah uhuine: "Kelehku matei neke ku welum."<verse eid="JON 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 4:9" />Tahui uhui Allah lukun Yunus: "Kuno hiye nu sangit gana pumule hiyo?"</para>
  <para style="p" vid="JON 4:9">Samutne: "Tau ku sangit hampe matei.<verse eid="JON 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 4:10" />Tahui uhui TUHAN: "Nu kararo pumule hiyo, sa dodoho nu awe heka putumu pumule hiyo, sa tumu huang erai malem tei kiat andraune layo. <verse eid="JON 4:10" /><verse number="11" style="v" sid="JON 4:11" />Ngunau awe Ku mo dat sehu, gana Niniwe leu sa gaya hiyo. Naan saratus ruempulu ribu lun sa mo tau ngebeda hiye sa asuh lukun hiye sa dat.<verse eid="JON 4:11" /></para>
  <chapter eid="JON 4" />
</usx>