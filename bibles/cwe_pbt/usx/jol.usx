<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- Kwere Bible Version</book>
  <para style="h">Yoeli</para>
  <para style="toc1">Yoeli</para>
  <para style="toc2">Yoeli</para>
  <para style="toc3">Yoel</para>
  <para style="mt">Yoeli</para>
  <para style="imt">Ulongozi</para>
  <para style="ip">Chitabu chino china ulotezi wa Yoeli. Haimanyika ng'hani kusonhela Yoeli hebu Pesueli tati yake. Muna Ibibiliya yose, Yoeli katambuligwa muna ichitabu chino na chitabu cha Sang'hano za Watumigwa (Sang'hano za Watumigwa 2:17-21). Wasomi hawavimanyile Yoeli kakala zuwaki hebu chitabu chino chandikigwa zuwaki. Chitabu cha Yoeli chotambula isi ya Yuda na bululu da Yelusalemu, ivo yodahika kasang'hanila uko.</para>
  <para style="ip">Fana walotezi wamwenga wengi muna Ibibiliya, Yoeli kolonga kusonhela nhaguso ikwiza kwa wanhu wa zisi zose na isi ya Yuda. Komulongela chila munhu yasame na yainyendenyende na yamzahile Mulungu (sula ya 2:12). Maabaho Mndewa Mulungu kokwika chilagano cha kuwagidila Muhe wake wanhu wose (sula ya 2:28). Mtumigwa Petili kagong'onda kuwa chilagano chino chifikizigwa muna didugila da Pentekosite (Sang'hano za Watumigwa 2:17).</para>
  <para style="iot">Mbuli zilimuno</para>
  <para style="io">1. Sula ya 1-2:17 zolonga kusonhela hulo da nzige muna iisi.</para>
  <para style="io">2. Sula ya 2:13-3:21 zolonga kuwa Mulungu kezawakombola wanhu wake na isi yawo.</para>
  <chapter number="1" style="c" sid="JOL 1" />
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1" />Mndewa Mulungu kamulongela Yoeli mwana wa Pesueli,<verse eid="JOL 1:1" /></para>
  <para style="s">Nzige wokwingila muna iisi</para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 1:2" />“Tegelezeni mbuli ino, mweye walangulizi wa Yuda,</para>
  <para style="q" vid="JOL 1:2">kingeni digutwi mweye mose womukala muna iisi.</para>
  <para style="q" vid="JOL 1:2">Vino mbuli fana zino zimulawililani mweye hebu wasaho zenu?”<verse eid="JOL 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOL 1:3" />Walongeleni wanenu mbuli ino,</para>
  <para style="q" vid="JOL 1:3">wanenu wawalongele wanawo.</para>
  <para style="q" vid="JOL 1:3">Iviya wanawo wawalongele nyelesi zawo zikwiza.<verse eid="JOL 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOL 1:4" />Madali ya nzige wagwila muna imimea,</para>
  <para style="q" vid="JOL 1:4">mimea ilekigwe na nzige idigwa na mbalangulu,</para>
  <para style="q" vid="JOL 1:4">mimea ilekigwe na mbalangulu idigwa na ngeda,</para>
  <para style="q" vid="JOL 1:4">mimea ilekigwe na ngeda idigwa na viduludulu.<verse eid="JOL 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOL 1:5" />Mweye wang'waji lamkeni mulile,</para>
  <para style="q" vid="JOL 1:5">mweye mukoligwa divai, mulawe masozi,</para>
  <para style="q" vid="JOL 1:5">kwaviya muhokigwa zabibu zose kulawa muna imilomo yenu.<verse eid="JOL 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOL 1:6" />Dali da nzige waibananga isi yetu,</para>
  <para style="q" vid="JOL 1:6">wana nguvu na madali makulu yodumbiza.</para>
  <para style="q" vid="JOL 1:6">Meno yawo yalinga fana meno ya simba,</para>
  <para style="q" vid="JOL 1:6">saya zawo zilinga fana saya za simba zike.<verse eid="JOL 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOL 1:7" />Wabananga mizabibu yetu,</para>
  <para style="q" vid="JOL 1:7">na waja minhini yetu,</para>
  <para style="q" vid="JOL 1:7">wabandula magome na wayasa hasi,</para>
  <para style="q" vid="JOL 1:7">waleka matambi yabule mayani.<verse eid="JOL 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOL 1:8" />Lileni fana viya mndele yaiyawale guniya,</para>
  <para style="q" vid="JOL 1:8">viyomulilila mulume yolonda kumsola.<verse eid="JOL 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 1:9" />Nhosa za mhule na nhosa za ving'waji hazigaligwa muna ikaye ya Mndewa Mulungu.</para>
  <para style="q" vid="JOL 1:9">Wakulu wa nhambiko womsang'hanila Mndewa Mulungu wolila.<verse eid="JOL 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOL 1:10" />Migunda isigala yabule chinhu chochose,</para>
  <para style="q" vid="JOL 1:10">isi yolila,</para>
  <para style="q" vid="JOL 1:10">kwaviya vinhu vihandigwe vibanangigwa,</para>
  <para style="q" vid="JOL 1:10">divai haipatika na mavuta habule.<verse eid="JOL 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 1:11" />Ngano na shayili vinangigwa vose,</para>
  <para style="q" vid="JOL 1:11">mweye walimaji, lileni,</para>
  <para style="q" vid="JOL 1:11">mweye ndolezi wa mizabibu, laveni masozi,</para>
  <para style="q" vid="JOL 1:11">kwaviya mavuno yose muna iisi yaga.<verse eid="JOL 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 1:12" />Mizabibu iholola,</para>
  <para style="q" vid="JOL 1:12">minhini yose inyala,</para>
  <para style="q" vid="JOL 1:12">mikomamanga na mitende na michungwa inyala,</para>
  <para style="q" vid="JOL 1:12">mibiki yose ya matunda inyala.</para>
  <para style="q" vid="JOL 1:12">Iviya kudeng'helela kwa wanhu kunyala.<verse eid="JOL 1:12" /></para>
  <para style="s">Wanhu wotangigwa kusama</para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 1:13" />Mweye wakulu wa nhambiko,</para>
  <para style="q" vid="JOL 1:13">valeni maguniya mulile,</para>
  <para style="q" vid="JOL 1:13">lileni mweye womusang'hana hana ulupango.</para>
  <para style="q" vid="JOL 1:13">Ingileni muna ikaye ya Mulungu mulile ichilo chose!</para>
  <para style="q" vid="JOL 1:13">Kwaviya nhosa za mhule na nhosa za ving'waji hazigaligwa muna ikaye ya Mulungu wenu.<verse eid="JOL 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 1:14" />Walongeleni wanhu wafunge kuja,</para>
  <para style="q" vid="JOL 1:14">wagonekeni wanhu weze kuna umting'hano welile.</para>
  <para style="q" vid="JOL 1:14">Waduganyeni walangulizi na wanhu wokala muna iisi,</para>
  <para style="q" vid="JOL 1:14">muna ikaye ya Mndewa Mulungu, Mulungu wenu.</para>
  <para style="q" vid="JOL 1:14">Umo mukamulilile Mndewa Mulungu.<verse eid="JOL 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOL 1:15" />Siku iyo chizagaya ng'hani!</para>
  <para style="q" vid="JOL 1:15">Kwaviya siku ya Mndewa Mulungu yahabehi,</para>
  <para style="q" vid="JOL 1:15">yokwiza hamwe na kunangigwa kulawa kwa Mulungu Yeli na Udahi.<verse eid="JOL 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 1:16" />Ndiya zetu zibanangigwa kuno cholola,</para>
  <para style="q" vid="JOL 1:16">na habule munhu yodeng'helela muna ikaye ya Mulungu wetu.<verse eid="JOL 1:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="JOL 1:17" />Mbeyu zowola hana uulongo,</para>
  <para style="q" vid="JOL 1:17">madungu yasigala yabule chinhu,</para>
  <para style="q" vid="JOL 1:17">vibanda va kwikila ndiya vibeneka,</para>
  <para style="q" vid="JOL 1:17">kwaviya baho habule ngano.<verse eid="JOL 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOL 1:18" />Lola wanyama viwolila kwa usungu!</para>
  <para style="q" vid="JOL 1:18">Mabumbila ya ng'ombe yoyunguya yozahila ndiya,</para>
  <para style="q" vid="JOL 1:18">mbali habule mgina,</para>
  <para style="q" vid="JOL 1:18">iviya mabumbila ya ng'hondolo yogaya.<verse eid="JOL 1:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="JOL 1:19" />Mndewa Mulungu, nokulamba weye,</para>
  <para style="q" vid="JOL 1:19">moto ukomeleza mgina kuchuwala,</para>
  <para style="q" vid="JOL 1:19">milambi ya moto itimbula mibiki kuna imigunda.<verse eid="JOL 1:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 1:20" />Wanyama wa kumbago wokuhuwila weye,</para>
  <para style="q" vid="JOL 1:20">kwaviya vizanda vinyala,</para>
  <para style="q" vid="JOL 1:20">na moto ulunguza mgina kuchuwala.<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" sid="JOL 2" />
  <para style="s">Siku ya Mndewa Mulungu ya kutagusa</para>
  <para style="q">
    <verse number="1" style="v" sid="JOL 2:1" />Toweni mhalati kuna umulima Sayuni,</para>
  <para style="q" vid="JOL 2:1">guteni nyangi kuna umulima wangu welile,</para>
  <para style="q" vid="JOL 2:1">Gudemekeni mweye wanhu wa Yuda,</para>
  <para style="q" vid="JOL 2:1">kwaviya siku ya Mndewa Mulungu ya kutagusa yokwiza,</para>
  <para style="q" vid="JOL 2:1">siku iyo yahabehi!<verse eid="JOL 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 2:2" />Siku iyo ya ziza didumbiza,</para>
  <para style="q" vid="JOL 2:2">siku iyo ya mawingu na ziza totolo.</para>
  <para style="q" vid="JOL 2:2">Bumbila kulu dokwiza,</para>
  <para style="q" vid="JOL 2:2">fana zuwa vodilawa uchanyha ya milima.</para>
  <para style="q" vid="JOL 2:2">Mbuli iyo hailawilile umwaka na haizalawilila kwa nyelesi zose zikwiza.<verse eid="JOL 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOL 2:3" />Fana moto viutimbula,</para>
  <para style="q" vid="JOL 2:3">bumbila ijo dobananga chila chinhu chili kuulongozi na kuchisogo,</para>
  <para style="q" vid="JOL 2:3">na habule chinhu chondachisigale.</para>
  <para style="q" vid="JOL 2:3">Kuulongozi kowofosa kulinga fana chizi cha Edeni,</para>
  <para style="q" vid="JOL 2:3">mbali wahakomeleza kufosa kosigala bwilingu muhala.<verse eid="JOL 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOL 2:4" />Nzige wawo walinga fana falasi,</para>
  <para style="q" vid="JOL 2:4">wokimbila fana watowang'hondo wakwelafalasi.<verse eid="JOL 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOL 2:5" />Viwozumha kuna zinhembeti za milima,</para>
  <para style="q" vid="JOL 2:5">wobuma fana viya matololi ya kubululigwa na falasi,</para>
  <para style="q" vid="JOL 2:5">wobuma fana moto wa mayani yanyalile.</para>
  <para style="q" vid="JOL 2:5">Wobuma fana magalu waisasale kwa ng'hondo.<verse eid="JOL 2:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="JOL 2:6" />Wanhu viwowawona wawo viwokwiza,</para>
  <para style="q" vid="JOL 2:6">vihanga vawo voyauka kwa kudumba.<verse eid="JOL 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOL 2:7" />Wokimbila fana magalu wa ng'hondo,</para>
  <para style="q" vid="JOL 2:7">wokwela uchanyha ya ng'huta fana watowang'hondo.</para>
  <para style="q" vid="JOL 2:7">Wose wohita kuulongozi dimwe kwa dimwe,</para>
  <para style="q" vid="JOL 2:7">habule hata imwe yobaguka.<verse eid="JOL 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOL 2:8" />Habule yomsung'ha miyage,</para>
  <para style="q" vid="JOL 2:8">wose wosondelela inzila.</para>
  <para style="q" vid="JOL 2:8">Wofosa hata one wahatowigwa na silaha,</para>
  <para style="q" vid="JOL 2:8">habule chinhu cha kuwakimilila.<verse eid="JOL 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 2:9" />Woditowa bululu,</para>
  <para style="q" vid="JOL 2:9">wozumha uchanyha ya ng'huta,</para>
  <para style="q" vid="JOL 2:9">wokwela na kwingila muna yamazonzo fana wabavi.<verse eid="JOL 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOL 2:10" />Isi yowagudemekela,</para>
  <para style="q" vid="JOL 2:10">ulanga wotingisika,</para>
  <para style="q" vid="JOL 2:10">zuwa na mwezi vogumigwa ziza,</para>
  <para style="q" vid="JOL 2:10">nhondo nazo hazibung'hula.<verse eid="JOL 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 2:11" />Mndewa Mulungu kodilanguliza bumbila jake kwa dizi kulu,</para>
  <para style="q" vid="JOL 2:11">kwaviya watowang'hondo wake wengi ng'hani,</para>
  <para style="q" vid="JOL 2:11">womtegeleza hawapeteka.</para>
  <para style="q" vid="JOL 2:11">Siku ya Mndewa Mulungu ya kutagusa ng'hulu na yodumbiza ng'hani!</para>
  <para style="q" vid="JOL 2:11">Yelihi yodaha kuifunyila umoyo?<verse eid="JOL 2:11" /></para>
  <para style="s">Kumbwelela Mulungu</para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 2:12" />Mbali Mndewa Mulungu kolonga, “Hata sambi modaha kunibwelela kwa mizoyo yenu yose,</para>
  <para style="q" vid="JOL 2:12">kwa kufunga na kulila.”<verse eid="JOL 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 2:13" />Sekemudege mawalo yenu kwa kulagusa usungu,</para>
  <para style="q" vid="JOL 2:13">mbali mizoyo yenu yolondeka iwe ya unyendanyenda.</para>
  <para style="q" vid="JOL 2:13">Mbweleleni Mndewa Mulungu, Mulungu wenu.</para>
  <para style="q" vid="JOL 2:13">Yeye kana ubazi na ulondo wa kufunya umoyo,</para>
  <para style="q" vid="JOL 2:13">hapata ludoko himahima,</para>
  <para style="q" vid="JOL 2:13">kanoga ng'hani koisasala kugalula magesa yake muladi sekeyataguse.<verse eid="JOL 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 2:14" />Yodahika Mndewa Mulungu, Mulungu wako kezagalula magesa yake.</para>
  <para style="q" vid="JOL 2:14">Iviya kezamtemelani mate kwa kumwing'hani ndiya,</para>
  <para style="q" vid="JOL 2:14">muladi mudahe kumulavila nhosa za ving'waji na mhule.<verse eid="JOL 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOL 2:15" />Toweni mhalati uko Sayuni!</para>
  <para style="q" vid="JOL 2:15">Waduganyeni wanhu hamwe,</para>
  <para style="q" vid="JOL 2:15">uwalongele wafunge kuja.<verse eid="JOL 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 2:16" />Muwaduganye wanhu wose,</para>
  <para style="q" vid="JOL 2:16">muusafye mting'hano wose,</para>
  <para style="q" vid="JOL 2:16">waduganyeni walala na wana na ving'hele.</para>
  <para style="q" vid="JOL 2:16">Msola na msoligwa walawe muna iviheleto vawo.<verse eid="JOL 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 2:17" />Walongele wakulu wa nhambiko womsang'hanila Mndewa Mulungu walile hagati ya lupango na hanhu ha kwingilila muna Ikaye ya Mulungu.</para>
  <para style="q" vid="JOL 2:17">Walonge, “Weye Mndewa Mulungu, uwawonele ubazi wanhu wako.</para>
  <para style="q" vid="JOL 2:17">Sekeuwaleke wanhu wa zisi zimwenga wawehule na wawaseke kwa kulonga, ‘Mulungu wawo kakulihi?’ ”<verse eid="JOL 2:17" /></para>
  <para style="s">Mulungu koitemela mate isi</para>
  <para style="q">
    <verse number="18" style="v" sid="JOL 2:18" />Maabaho Mndewa Mulungu kawona wivu kwa ichimu cha isi yake,</para>
  <para style="q" vid="JOL 2:18">ivo kawawonela ubazi wanhu wake.<verse eid="JOL 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOL 2:19" />Mndewa Mulungu kawedika wanhu wake kawalongela,</para>
  <para style="q" vid="JOL 2:19">“Nizamgalilani ndiya na divai na mavuta,</para>
  <para style="q" vid="JOL 2:19">mwizakwiguta vinhu ivo,</para>
  <para style="q" vid="JOL 2:19">na sizamgumani chinyala kwa wanhu wa zisi zimwenga.<verse eid="JOL 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 2:20" />Nizawawinga wehi wolawa ubanzi wa kasikazi,</para>
  <para style="q" vid="JOL 2:20">nizawabalasa mbaka kuna dibwilingu,</para>
  <para style="q" vid="JOL 2:20">watowang'hondo weli kuulongozi nizawasa muna ibahali ya Munyu,</para>
  <para style="q" vid="JOL 2:20">na weli kuchisogo nizawasa muna ibahali ya Meditelaniya.</para>
  <para style="q" vid="JOL 2:20">Mitufi yawo izalava vundo na izanung'ha ng'hani.”</para>
  <para style="q" vid="JOL 2:20">Kwaviya Mndewa Mulungu katenda mbuli ng'hulu.<verse eid="JOL 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOL 2:21" />Mndewa Mulungu katenda mbuli ng'hulu,</para>
  <para style="q" vid="JOL 2:21">ivo walongeleni wanhu wa isi wadeng'helele na sekewadumbe.<verse eid="JOL 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOL 2:22" />Sekemudumbe, mweye wanyama wa kumbago,</para>
  <para style="q" vid="JOL 2:22">kwaviya mgina wa kudibwilingu wolava miche,</para>
  <para style="q" vid="JOL 2:22">mibiki yokwima matunda,</para>
  <para style="q" vid="JOL 2:22">minhini na mizabibu yokwima ng'hani.<verse eid="JOL 2:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="JOL 2:23" />Mweye wanhu wa Sayuni, deng'heleleni,</para>
  <para style="q" vid="JOL 2:23">msangalileni Mndewa Mulungu, Mulungu wenu,</para>
  <para style="q" vid="JOL 2:23">kwaviya yeye komgalileni mvula yoilondeka,</para>
  <para style="q" vid="JOL 2:23">kagala mvula,</para>
  <para style="q" vid="JOL 2:23">mvula ya masika na mvula ya vuli fana viya umwaka.<verse eid="JOL 2:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOL 2:24" />Hanhu ha kubetela hezamema ngano,</para>
  <para style="q" vid="JOL 2:24">hanhu ha kukamila hezamema divai na mavuta.<verse eid="JOL 2:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOL 2:25" />Nizambwelezelani chila chinhu chidigwe na nzige na ngeda na mbalangulu,</para>
  <para style="q" vid="JOL 2:25">bumbila kulu donimgalileni.<verse eid="JOL 2:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOL 2:26" />Mwizapata ndiya nyingi ya kwiguta,</para>
  <para style="q" vid="JOL 2:26">mwizaditogoza zina jangu niye Mndewa Mulungu, Mulungu wenu,</para>
  <para style="q" vid="JOL 2:26">yonimtendeleni mbuli za mwazanyo,</para>
  <para style="q" vid="JOL 2:26">wanhu wangu hawezakwehuligwa kaidi.<verse eid="JOL 2:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOL 2:27" />Mweye Waisilaili mwizavimanya kuwa niye nahagati yenu,</para>
  <para style="q" vid="JOL 2:27">iviya niye Mndewa Mulungu niiyo Mulungu wenu, habule imwenga.</para>
  <para style="q" vid="JOL 2:27">Wanhu wangu hawezagumigwa chinyala kaidi.<verse eid="JOL 2:27" /></para>
  <para style="s">Mndewa Mulungu kowagalila wanhu Muhe wake</para>
  <para style="q">
    <verse number="28" style="v" sid="JOL 2:28" />Maabaho nizawagalila wanhu wose muhe wangu,</para>
  <para style="q" vid="JOL 2:28">wanenu wa chilume na wanenu wa chike wezalotela na walala wezalota nzozi,</para>
  <para style="q" vid="JOL 2:28">wabwanga wenu wezawona malaguso.<verse eid="JOL 2:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOL 2:29" />Iviya nizaweng'ha muhe wangu wasang'hani wenu wa chilume na wa chike.<verse eid="JOL 2:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="JOL 2:30" />Nizatenda mbuli za mwazanyo muna iisi na kuulanga,</para>
  <para style="q" vid="JOL 2:30">kwizalawilila damu na moto na yosi dikwela uchanyha.<verse eid="JOL 2:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JOL 2:31" />Zuwa dizagalusigwa kuwa ziza,</para>
  <para style="q" vid="JOL 2:31">mwezi wizakuwa mdung'hu fana damu.</para>
  <para style="q" vid="JOL 2:31">Mbuli izo zizalawilila ing'hali hainafika siku iyo ng'hulu ya Mndewa Mulungu ya kutagusa yoidumbiza,<verse eid="JOL 2:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JOL 2:32" />Mndewa Mulungu kezamkombola munhu yoyose yompula yamtaze,</para>
  <para style="q" vid="JOL 2:32">kwaviya kuna umulima Sayuni na uko Yelusalemu kwizakuwa na wanhu wondawakomboligwe,</para>
  <para style="q" vid="JOL 2:32">fana Mndewa Mulungu viyalongile.</para>
  <para style="q" vid="JOL 2:32">Mndewa Mulungu kawasagula waja wokomboligwa.<verse eid="JOL 2:32" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" sid="JOL 3" />
  <para style="s">Mndewa Mulungu kowahumiza wanhu wa zisi zose</para>
  <para style="q">
    <verse number="1" style="v" sid="JOL 3:1" />Tegelezeni, siku ziya na lusita luja,</para>
  <para style="q" vid="JOL 3:1">nizawatemela mate kaidi wanhu wa Yuda na Yelusalemu.<verse eid="JOL 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 3:2" />Nizawaduganya wanhu wa zisi zose,</para>
  <para style="q" vid="JOL 3:2">nizawagala kuna dikolongo da Yehoshafati.</para>
  <para style="q" vid="JOL 3:2">Uko nizawahumiza kwa ichimu cha wanhu wangu weli uhazi wangu,</para>
  <para style="q" vid="JOL 3:2">kwaviya wawapwililisa Waisilaili muna izisi zimwenga na waigola isi yangu.<verse eid="JOL 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOL 3:3" />Iviya wawatowela mhiya wanhu wangu,</para>
  <para style="q" vid="JOL 3:3">na wawachuuza wabwanga muladi wapate malaya,</para>
  <para style="q" vid="JOL 3:3">na wawachuuza wandele muladi wapate divai wang'we.<verse eid="JOL 3:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4" />Mweye wanhu wa Tilo na Sidoni na wanhu wa zisi zose za Filisiti, molonda choni kumwangu? Vino monilihilizila kwa mbuli zonitendile? Nizambwelezelani himahima mbuli zomunitendele. <verse eid="JOL 3:4" /><verse number="5" style="v" sid="JOL 3:5" />Kwaviya musola hela na zahabu yangu, musola vinhu vangu vinogile na muvingiza muna zikaye za milungu yenu. <verse eid="JOL 3:5" /><verse number="6" style="v" sid="JOL 3:6" />Muwachuuza wanhu wa Yuda na wanhu wa Yelusalemu kwa Wagiliki. Muwahamiza kutali na zisi zawo. <verse eid="JOL 3:6" /><verse number="7" style="v" sid="JOL 3:7" />Nizawatenda walawe hanhu homuwachuuze. Nizamulihilizani kwa chila chinhu chimuwatendele. <verse eid="JOL 3:7" /><verse number="8" style="v" sid="JOL 3:8" />Nizawachuuza wanenu wa chilume na wanenu wa chike kwa wanhu wa Yuda, nawo wezawachuuzila wanhu wa isi ya Sheba ili kutali ng'hani. Niye Mndewa Mulungu nilonga.<verse eid="JOL 3:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="JOL 3:9" />Wagong'ondeleni wanhu wa zisi mbuli zino,</para>
  <para style="q" vid="JOL 3:9">muisasale kwa ng'hondo na muwatange magalu,</para>
  <para style="q" vid="JOL 3:9">watowang'hondo weze kuitowa.<verse eid="JOL 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOL 3:10" />Noleni magembe yenu yagaluke kuwa mazele,</para>
  <para style="q" vid="JOL 3:10">na sengo zenu zigaluke kuwa migoha,</para>
  <para style="q" vid="JOL 3:10">maabaho munhu nyondenyonde yalonge, “Niye galu.”<verse eid="JOL 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 3:11" />Mweye wanhu wa zisi zose na banzi zose, izoni himahima,</para>
  <para style="q" vid="JOL 3:11">muiduganye hamwe.</para>
  <para style="q" vid="JOL 3:11">Weye Mndewa Mulungu, wahulumuse watowang'hondo wako.<verse eid="JOL 3:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="JOL 3:12" />Wanhu wa zisi weze kuna dikolongo da Yehoshafati,</para>
  <para style="q" vid="JOL 3:12">kwaviya nizakala uko kuwahumiza wanhu wa zisi zili banzi zose.<verse eid="JOL 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 3:13" />Sasaleni sengo, kwaviya ndiya kumgunda ziva.</para>
  <para style="q" vid="JOL 3:13">Izoni mukame zabibu, kwaviya zimema.</para>
  <para style="q" vid="JOL 3:13">Wihi wawo uiyoha fana divai imemile ng'hani.<verse eid="JOL 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 3:14" />Lung'husesa lwa wanhu wamema muna dikolongo da nhaguso.</para>
  <para style="q" vid="JOL 3:14">Kwaviya siku ya Mndewa Mulungu ya kutagusa yahabehi.<verse eid="JOL 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOL 3:15" />Zuwa na mwezi vigumigwa ziza,</para>
  <para style="q" vid="JOL 3:15">nhondo nazo hazibung'hula.<verse eid="JOL 3:15" /></para>
  <para style="s">Mulungu kowatemela mate wanhu wake</para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 3:16" />Mndewa Mulungu koduma kulawa Sayuni ili uko Yelusalemu,</para>
  <para style="q" vid="JOL 3:16">dizi jake dotenda ulanga na isi vitingisike.</para>
  <para style="q" vid="JOL 3:16">Mbali Mndewa Mulungu kowagombela wanhu wake,</para>
  <para style="q" vid="JOL 3:16">kowakaliza Waisilaili.<verse eid="JOL 3:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="JOL 3:17" />Maabaho mwizavimanya kuwa niye Mndewa Mulungu, Mulungu wenu,</para>
  <para style="q" vid="JOL 3:17">nokala Sayuni, mulima wangu welile,</para>
  <para style="q" vid="JOL 3:17">Yelusalemu dizakuwa bululu jelile,</para>
  <para style="q" vid="JOL 3:17">wanhu wa zisi zimwenga hawezadisola kaidi.<verse eid="JOL 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOL 3:18" />Siku iyo milima izalagaza divai ili mulile,</para>
  <para style="q" vid="JOL 3:18">vilima vizakilima maziwa,</para>
  <para style="q" vid="JOL 3:18">vizanda vose vili muna iisi ya Yuda vizalava mazi mengi.</para>
  <para style="q" vid="JOL 3:18">Nzasa zizalawilila muna ikaye ya Mndewa Mulungu</para>
  <para style="q" vid="JOL 3:18">na kudimemeza mazi kolongo da Shitimu.<verse eid="JOL 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOL 3:19" />“Isi ya Misili izakuwa matongo,</para>
  <para style="q" vid="JOL 3:19">na isi ya Edomu izakuwa bwilingu,</para>
  <para style="q" vid="JOL 3:19">Kwaviya wawatowa wanhu wa Yuda welibule ubananzi.<verse eid="JOL 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 3:20" />Mbali isi ya Yuda na Yelusalemu zizakuwa na wanhu siku zose na nyelesi zose.<verse eid="JOL 3:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOL 3:21" />Niye Mndewa Mulungu nokala Sayuni,</para>
  <para style="q" vid="JOL 3:21">nizawalihiliza wanhu wakomile.”<verse eid="JOL 3:21" /></para>
  <chapter eid="JOL 3" />
</usx>