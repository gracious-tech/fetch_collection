<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="OBA" style="id">- Kwele Bible Version</book>
  <para style="h">Obadia</para>
  <para style="toc1">Obadia</para>
  <para style="toc2">Obadia</para>
  <para style="toc3">Oba</para>
  <para style="mt">Obadia</para>
  <para style="imt">Ulongozi</para>
  <para style="ip">Chitabu chino china ulotezi wa Obadia. Usenga wa Obadia ni ulonzi wa nhaguso kusonhela wanhu wa isi ya Edomu wakalile welesi wa Esau. Wasomi hawavimanyile fana chitabu chino chandikigwa zuwaki. Mbali yodahika kuwa nhaguso iyo ilongeke yobwelela lusita Babeli viitekile Yelusalemu na isi ya Edomu haiitazile isi ya Isilaili. Yodahika chitabu chandikigwa habehi ya 600 KK.</para>
  <para style="ip">Mwanduso Obadia kogong'onda nhaguso kwa isi ya Edomu muhala. Maabaho Obadia kohanganya zisi zose muna inhaguso ino, msitali wa 15. Kuuhelelo Obadia kolonga kuwa siku dimwe wanhu watekigwe wa Isilaili wezabwelezigwa muna iisi yawo.</para>
  <para style="iot">Mbuli zilimuno</para>
  <para style="io">1. Nhaguso yogong'ondwa kwa isi ya Edomu muna umsitali 1-14.</para>
  <para style="io">2. Yolonga viya zisi zose zizatagusigwa kwa udugi wawo na Waisilaili watekigwe wezabwela na kukala muna iisi yawo na iviya wezatawala isi ya Edomu muna umsitali 15-21.</para>
  <chapter number="1" style="c" sid="OBA 1" />
  <para style="s">Mulungu kowatagusa wanhu wa Edomu</para>
  <para style="q">
    <verse number="1" style="v" sid="OBA 1:1" />Zino niizo mbuli ziyalagusigwe Obadia.</para>
  <para style="q" vid="OBA 1:1">Mbuli ziyalongile Mndewa Mulungu kusonhela isi ya Edomu.</para>
  <para style="b" vid="OBA 1:1" />
  <para style="q" vid="OBA 1:1">Chihokela usenga kulawa kwa Mndewa Mulungu,</para>
  <para style="q" vid="OBA 1:1">msenga katumigwa kwa wanhu wa zisi zimwenga yalonge, “Inukeni, chihite chikaitowe na isi ya Edomu.”<verse eid="OBA 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="OBA 1:2" />Mndewa Mulungu kailongela isi ya Edomu,</para>
  <para style="q" vid="OBA 1:2">“Nizamtendani muwe mbugilambugila muna izisi zimwenga,</para>
  <para style="q" vid="OBA 1:2">mwizazehigwa ng'hani.<verse eid="OBA 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="OBA 1:3" />Udugi wa mizoyo yenu umvwizilani.</para>
  <para style="q" vid="OBA 1:3">Kwaviya mabululu yenu makulu yana mhongono za mabwe makulu ng'hani na madala,</para>
  <para style="q" vid="OBA 1:3">na ukazi wenu kuna imilima,</para>
  <para style="q" vid="OBA 1:3">mweye moilongela wenyewo,</para>
  <para style="q" vid="OBA 1:3">‘Vino yelihi yodaha kuchihulumusa?’ ”<verse eid="OBA 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="OBA 1:4" />Mndewa Mulungu kolonga, “One muhaguluka uchanyha fana masumula,</para>
  <para style="q" vid="OBA 1:4">na kuzenga visanza venu baho hana zinhondo,</para>
  <para style="q" vid="OBA 1:4">niye nizamuhulumusani.<verse eid="OBA 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="OBA 1:5" />One wabavi waheza kumwenu ichilo,</para>
  <para style="q" vid="OBA 1:5">wobawa chinhu chiwolonda muhala.</para>
  <para style="q" vid="OBA 1:5">Wanhu wokwaha zabibu, wowasigazila ngayengaye.</para>
  <para style="q" vid="OBA 1:5">Mbali mweye mwizanangigwa ng'hani.<verse eid="OBA 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="OBA 1:6" />Mweye welesi wa Esau vinhu venu vihokigwa.</para>
  <para style="q" vid="OBA 1:6">Ngama zenu zose zifisigwe zitoligwa na zisoligwa.<verse eid="OBA 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="OBA 1:7" />Wose woilumba na mweye wezamuwingani mbaka kuna zimhaka.</para>
  <para style="q" vid="OBA 1:7">Mbwiya zenu wezamvwizilani na kumuhumani.</para>
  <para style="q" vid="OBA 1:7">Waja woja gate hamwe na mweye, wezamtegelani mtego,</para>
  <para style="q" vid="OBA 1:7">mbali hamudaha kuumanya.”<verse eid="OBA 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="OBA 1:8" />Mndewa Mulungu kolonga,</para>
  <para style="q" vid="OBA 1:8">“Siku iyo nizawananga wanhu wovimanya weli muna iisi ya Edomu.</para>
  <para style="q" vid="OBA 1:8">Nizawananga wabala weli kuna ivilima va Esau.<verse eid="OBA 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="OBA 1:9" />Weye bululu da Temani, magalu wako wezadumba,</para>
  <para style="q" vid="OBA 1:9">na chila munhu kezagwisigwa hasi kuna umulima wa Esau na kukomigwa.<verse eid="OBA 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="OBA 1:10" />Kwa ichimu cha mbuli zihile zimuwatendele ndugu zenu welesi wa Yakobo,</para>
  <para style="q" vid="OBA 1:10">mwizagumigwa chinyala na mwizanangigwa siku zose.<verse eid="OBA 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="OBA 1:11" />Mwima kutali molola wageni viwasolile utajili wa Yelusalemu,</para>
  <para style="q" vid="OBA 1:11">na wanhu wa zisi zimwenga viwengile muna zinyivi zake.</para>
  <para style="q" vid="OBA 1:11">Waigolela vinhu va Yelusalemu kwa kutowa mhiya,</para>
  <para style="q" vid="OBA 1:11">na mweye mukala fana wawo.<verse eid="OBA 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="OBA 1:12" />Sigambemuwadununze ndugu zenu muna isiku ya uzidilwa wawo.</para>
  <para style="q" vid="OBA 1:12">Iviya mweye sigambemudeng'helele lusita wanhu wa Yuda viwanangigwe,</para>
  <para style="q" vid="OBA 1:12">na sigambemuigode ng'hani muna isiku ya magayo yawo.<verse eid="OBA 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="OBA 1:13" />Sigambemwingile muna dibululu da wanhu wangu muna isiku ya uzidilwa wawo.</para>
  <para style="q" vid="OBA 1:13">Iviya sigambemuwazehe muna isiku ya magayo yawo,</para>
  <para style="q" vid="OBA 1:13">na sigambemuwahoke vinhu vawo muna isiku ya kunangigwa kwawo.<verse eid="OBA 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="OBA 1:14" />Sigambemwime muna zinzila mhanda na kuwakoma Waisilaili wakalile wokimbila.</para>
  <para style="q" vid="OBA 1:14">Hebu sigambemuwagwile waja wakimbile viwakalile wogazigwa.<verse eid="OBA 1:14" /></para>
  <para style="s">Siku ya Mndewa Mulungu ya kutagusa</para>
  <para style="q">
    <verse number="15" style="v" sid="OBA 1:15" />“Siku ya Mndewa Mulungu ya kutagusa yahabehi kwa zisi zose.</para>
  <para style="q" vid="OBA 1:15">Fana vimuwatendele wamwenga niivo vondamutendeligwe.</para>
  <para style="q" vid="OBA 1:15">Mwizalihigwa kwa sang'hano zimutendile.<verse eid="OBA 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="OBA 1:16" />Fana viya vimung'wile nhungo ya nhaguso yangu kuna umulima wangu welile,</para>
  <para style="q" vid="OBA 1:16">niivo zisi zose vondazigendelele kung'wa.</para>
  <para style="q" vid="OBA 1:16">Iviya wezahupika fana viya hawawile baho.<verse eid="OBA 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="OBA 1:17" />Mbali kuna umulima wa Sayuni kwizakuwa na wanhu wondawakomboligwe,</para>
  <para style="q" vid="OBA 1:17">iviya mulima Sayuni wizasafyigwa.</para>
  <para style="q" vid="OBA 1:17">Welesi wa Yakobo wezabwela na kuisola isi yawo ihokogwe.<verse eid="OBA 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="OBA 1:18" />Welesi wa Yakobo wizakuwa fana moto</para>
  <para style="q" vid="OBA 1:18">na welesi wa Yosefu wizakuwa milambi ya moto.</para>
  <para style="q" vid="OBA 1:18">Iviya welesi wa Esau wizakuwa fana mabuwa yanyalile,</para>
  <para style="q" vid="OBA 1:18">wezakwaka na kutakamila.</para>
  <para style="q" vid="OBA 1:18">Hezasigala munhu yoyose muna uwelesi wa Esau.”</para>
  <para style="q" vid="OBA 1:18">Mndewa Mulungu kolonga ivo.<verse eid="OBA 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="OBA 1:19" />Waja wokala uko Negebu wezausola mulima wa Esau</para>
  <para style="q" vid="OBA 1:19">na wanhu wa isi ya mabawe wezaisola isi ya Wafilisiti</para>
  <para style="q" vid="OBA 1:19">na kukala muna imigunda ya Efulaimu na Samalia.</para>
  <para style="q" vid="OBA 1:19">Wanhu wa kabila da Benyamini wezaisola isi ya Gileadi.<verse eid="OBA 1:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="OBA 1:20" />Bumbila da Waisilaili wakalile kuuhami,</para>
  <para style="q" vid="OBA 1:20">wezabwela na kukala mwiisi ya Kanaani mbaka Salepita.</para>
  <para style="q" vid="OBA 1:20">Wanhu wa Yelusalemu wakalile kuuhami uko Sefaladi,</para>
  <para style="q" vid="OBA 1:20">wezayasola mabululu ya Negebu.<verse eid="OBA 1:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="OBA 1:21" />Wakombolaji wezakwela uchanyha ya Mulima Sayuni</para>
  <para style="q" vid="OBA 1:21">muladi kuutawala mulima wa Esau.</para>
  <para style="q" vid="OBA 1:21">Maabaho Mndewa Mulungu kezakuwa mfalume na kutawala.<verse eid="OBA 1:21" /></para>
  <chapter eid="OBA 1" />
</usx>