<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- Kwele Bible Version</book>
  <para style="h">Nahumu</para>
  <para style="toc1">Nahumu</para>
  <para style="toc2">Nahumu</para>
  <para style="toc3">Nah</para>
  <para style="mt">Nahumu</para>
  <para style="imt">Ulongozi</para>
  <para style="ip">Chitabu chino china malaguso ya Nahumu. Usenga wa Nahumu ukala usonhela Ashulu. Koitanga isi ino “Ninawi”, dikala zina da bululu dikulu da isi iyo. Ashulu ukala ufalume uhumile na kuwaduta wanhu wa ufalume wa kasikazi ya Isilaili kuutumwa. Kwaviya Nahumu katambula vidigwile bululu da Sebesi (sula ya 3:8), chodaha kuvimanya kuwa kalotela hagati ya mwaka 663 KK, lusita Sebesi viigwile na mwaka 612 KK, lusita Ninawi viigwile.</para>
  <para style="ip">Usenga wa Nahumu ni kuwa Mulungu kezawatagusa wahasanyi. Ingawa Mulungu hengilwa ludoko himahima, kana nguvu (sula ya 1:3). Kalonga kuwa bululu da Ninawi na isi ya Ashulu vihagwile na wanhu wawo wahasoligwe mateka. Ino ikala mbuli inogile kwa wanhu wa Yuda (sula ya 1:15).</para>
  <para style="iot">Mbuli zilimuno</para>
  <para style="io">1. Sula ya 1:1-8 yofambula kuwa Mulungu mwene haki na kolihiza chisasi.</para>
  <para style="io">2. Sula ya 1:9 mbaka sula ya 3 zofambula kusonhela nhaguso ya Ninawi na Ashulu.</para>
  <chapter number="1" style="c" sid="NAM 1" />
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1" />Mbuli ya Mulungu iyalongile kusonhela wanhu wa bululu da Ninawi. Chitabu cha mbuli ziyalagusigwe Nahumu mkaya wa Elikoshi.<verse eid="NAM 1:1" /></para>
  <para style="s">Mndewa Mulungu kowatagusa wanhu wa Ninawi</para>
  <para style="q">
    <verse number="2" style="v" sid="NAM 1:2" />Mulungu kana wivu na kolihiliza chisasi.</para>
  <para style="q" vid="NAM 1:2">Mndewa Mulungu kolihiliza chisasi na kana ludoko,</para>
  <para style="q" vid="NAM 1:2">Mndewa Mulungu kowalihilizila chisasi wehi wake.</para>
  <para style="q" vid="NAM 1:2">Kowawonela ludoko wehi wake.<verse eid="NAM 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="NAM 1:3" />Mndewa Mulungu hapata ludoko himahima,</para>
  <para style="q" vid="NAM 1:3">mbali kana nguvu.</para>
  <para style="q" vid="NAM 1:3">Hezawalekelela wabananzi!</para>
  <para style="q" vid="NAM 1:3">Mndewa Mulungu yahamala kufosa, beho na vulavumbi volawilila,</para>
  <para style="q" vid="NAM 1:3">mawingu yalinga fana matimbwisi yotimuligwa na magulu yake.<verse eid="NAM 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="NAM 1:4" />Koikalikila bahali na koinyaza.</para>
  <para style="q" vid="NAM 1:4">Kozinyaza nyanda zose.</para>
  <para style="q" vid="NAM 1:4">Iviya kozinyaza nyanda za Bashani na Kalimeli,</para>
  <para style="q" vid="NAM 1:4">na maluwa ya Lebanoni yonyala.<verse eid="NAM 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="NAM 1:5" />Milima yogudemeka haulongozi wake,</para>
  <para style="q" vid="NAM 1:5">na vilima vogudemeka.</para>
  <para style="q" vid="NAM 1:5">Zisi zose zomgudemekela,</para>
  <para style="q" vid="NAM 1:5">zisi zose na vinhu vose viliumo vogudemeka.<verse eid="NAM 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="NAM 1:6" />Habule yodaha kwima haulongozi wa ludoko lwa Mndewa Mulungu.</para>
  <para style="q" vid="NAM 1:6">Habule yodaha kufunyila umoyo ludoko lwake lukulu.</para>
  <para style="q" vid="NAM 1:6">Yeye kolwitila ludoko lwake lukwaka fana moto,</para>
  <para style="q" vid="NAM 1:6">na kotula miluwe.<verse eid="NAM 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="NAM 1:7" />Mndewa Mulungu kanoga,</para>
  <para style="q" vid="NAM 1:7">yeye niiyo mhongono ya kukimbilila lusita lwa uzidilwa.</para>
  <para style="q" vid="NAM 1:7">Yeye kowakaliza wanhu wose wokimbilila kumwake.<verse eid="NAM 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NAM 1:8" />Mbali kezawananga wanhu wa Ninawi kwa gombo,</para>
  <para style="q" vid="NAM 1:8">kowasondelela wehi wake na kuwawinga mbaka kuna diziza.<verse eid="NAM 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NAM 1:9" />Vino mweye momulungila choni Mndewa Mulungu?</para>
  <para style="q" vid="NAM 1:9">Yeye kezakimilila malungilo ya waja womulema,</para>
  <para style="q" vid="NAM 1:9">muladi sekewamuleme kaidi.<verse eid="NAM 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="NAM 1:10" />Wezatimbuligwa fana chibago cha miwa,</para>
  <para style="q" vid="NAM 1:10">na kukoligwa kwa upele wawo.</para>
  <para style="q" vid="NAM 1:10">Wezanangigwa fana mabuwa yanyalile.<verse eid="NAM 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="NAM 1:11" />Weye bululu da Ninawi, kumwako kulawa munhu yailungile kutenda mbuli zihile kusonhela Mndewa Mulungu,</para>
  <para style="q" vid="NAM 1:11">yoyolava magesa yehile.<verse eid="NAM 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="NAM 1:12" />Mbali Mndewa Mulungu kolonga, “Ingawa Waashulu wengi ng'hani na wana nguvu,</para>
  <para style="q" vid="NAM 1:12">wezagwisigwa na kunangigwa.</para>
  <para style="q" vid="NAM 1:12">Ingawa nimgazani mweye wanhu wangu,</para>
  <para style="q" vid="NAM 1:12">sizamgazani kaidi.<verse eid="NAM 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="NAM 1:13" />Sambi nikanha nila zenu na nizakanha nzabi zenu.”<verse eid="NAM 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="NAM 1:14" />Mndewa Mulungu kalamula vino kusonhela Ninawi,</para>
  <para style="q" vid="NAM 1:14">“Hwizapata wana wa kuhazi zina jako.</para>
  <para style="q" vid="NAM 1:14">Nyang'hiti zako za kutambikila zisongoligwe na nyang'hiti za kutambikila zitendigwe na chuma cha kulumbula,</para>
  <para style="q" vid="NAM 1:14">nizazibena umo muna zikaye za milungu yako.</para>
  <para style="q" vid="NAM 1:14">Nizakusasalila leme jako,</para>
  <para style="q" vid="NAM 1:14">kwaviya weye hufaya chochose.”<verse eid="NAM 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="NAM 1:15" />Lola uchanyha kuna umulima,</para>
  <para style="q" vid="NAM 1:15">kuna magulu ya munhu yogala mbuli zinogile,</para>
  <para style="q" vid="NAM 1:15">munhu yogong'onda mbuli ya tindiwalo.</para>
  <para style="q" vid="NAM 1:15">Wanhu wa Yuda tendeni madugila yenu,</para>
  <para style="q" vid="NAM 1:15">iviya mufikize vilaho venu.</para>
  <para style="q" vid="NAM 1:15">Wanhu wotenda mbuli zihile hawezamtowani kaidi,</para>
  <para style="q" vid="NAM 1:15">mbali wezanangigwa ng'hani.<verse eid="NAM 1:15" /></para>
  <chapter eid="NAM 1" />
  <chapter number="2" style="c" sid="NAM 2" />
  <para style="s">Bululu da Ninawi dizanangigwa</para>
  <para style="q">
    <verse number="1" style="v" sid="NAM 2:1" />Mweye wanhu wa Ninawi,</para>
  <para style="q" vid="NAM 2:1">mwihi wenu kokwiza kumgwilani,</para>
  <para style="q" vid="NAM 2:1">Ivo kalizeni mhongono zenu na nzila zenu.</para>
  <para style="q" vid="NAM 2:1">Isasaleni kuitowa,</para>
  <para style="q" vid="NAM 2:1">duganyeni watowang'hondo.<verse eid="NAM 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="NAM 2:2" />Mndewa Mulungu kowabwelezela welesi wa Yakobo nguvu zawo,</para>
  <para style="q" vid="NAM 2:2">iviya kezawabwelezela Waisilaili hishima yawo.</para>
  <para style="q" vid="NAM 2:2">Kwaviya wanhu wa Yuda na Isilaili wahokigwa na wehi wawo,</para>
  <para style="q" vid="NAM 2:2">na mibiki yawo ibenigwa yamatambi.<verse eid="NAM 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="NAM 2:3" />Ngao za wehi wawo zitendigwa ndung'hu,</para>
  <para style="q" vid="NAM 2:3">watowang'hondo wavala mawalo madung'hu ng'hani,</para>
  <para style="q" vid="NAM 2:3">matololi yawo ya kubululigwa na falasi yomelemeta fana milambi ya moto.</para>
  <para style="q" vid="NAM 2:3">Migoha ya mibiki ya mielezi yomelemeta.<verse eid="NAM 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="NAM 2:4" />Matololi ya kubululigwa na falasi yogala sindo mwiinzila,</para>
  <para style="q" vid="NAM 2:4">yohita himahima muna dikulugumbi,</para>
  <para style="q" vid="NAM 2:4">yowoneka fana viya miwenge,</para>
  <para style="q" vid="NAM 2:4">yogenda himahima fana lumwemwe.<verse eid="NAM 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="NAM 2:5" />Wowatanga wakulu wa watowang'hondo wawo,</para>
  <para style="q" vid="NAM 2:5">viwohita woikwala.</para>
  <para style="q" vid="NAM 2:5">Wohita kuing'huta himahima,</para>
  <para style="q" vid="NAM 2:5">woiyoha muladi wahite kuwakimilila.<verse eid="NAM 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="NAM 2:6" />Nyivi za lamba zivuguligwa,</para>
  <para style="q" vid="NAM 2:6">kaye ya chifalume igwa.<verse eid="NAM 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="NAM 2:7" />Nyivi za bululu zivuguligwa zose,</para>
  <para style="q" vid="NAM 2:7">wanhu wasoligwa mateka.</para>
  <para style="q" vid="NAM 2:7">Wake zawo wotenda matanga na wolila fana mhugi,</para>
  <para style="q" vid="NAM 2:7">na woitowa muna zimhambaga kwa usungu.<verse eid="NAM 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NAM 2:8" />Bululu da Ninawi dilinga fana lamba ditulike na mazi yake yolawa himahima,</para>
  <para style="q" vid="NAM 2:8">wanhu wake wokimbila chaka.</para>
  <para style="q" vid="NAM 2:8">Dizi dotanga, “Imeni! Imeni!”</para>
  <para style="q" vid="NAM 2:8">Mbali habule hata imwe yobwela hachisogo.<verse eid="NAM 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NAM 2:9" />Soleni hela zitekigwe,</para>
  <para style="q" vid="NAM 2:9">soleni zahabu itekigwe.</para>
  <para style="q" vid="NAM 2:9">Ngama yake yabule uhelelo.</para>
  <para style="q" vid="NAM 2:9">Kuna vinhu vingi va hela nyingi.<verse eid="NAM 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="NAM 2:10" />Bululu da Ninawi dinangigwa na disigala matongo muhala,</para>
  <para style="q" vid="NAM 2:10">wanhu wake wafa moyo,</para>
  <para style="q" vid="NAM 2:10">nguvu ziwamala na meso yawo yaweweseka kwa kudumba.<verse eid="NAM 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="NAM 2:11" />Lelo dakulihi tuka da simba,</para>
  <para style="q" vid="NAM 2:11">dowoifisa wanasimba?</para>
  <para style="q" vid="NAM 2:11">Vino hanhu baho ha simba hakala vilihi?</para>
  <para style="q" vid="NAM 2:11">Hanhu howokala wanasimba habule munhu yodaha kuwasinhusa?<verse eid="NAM 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="NAM 2:12" />Simba lume diwasasalila wanage nyama ifaya.</para>
  <para style="q" vid="NAM 2:12">Diwagwilila mazike ya simba ukala wake.</para>
  <para style="q" vid="NAM 2:12">Dimemeza muna dituwa jake wanyama woyawagwilile.<verse eid="NAM 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="NAM 2:13" />Niye Mndewa Mulungu Nili na Udahi nizaitowa na mweye.</para>
  <para style="q" vid="NAM 2:13">Matololi yenu ya kubululigwa na falasi nizayatimbula kwa moto,</para>
  <para style="q" vid="NAM 2:13">na zele dizawakanha wanasimba wenu.</para>
  <para style="q" vid="NAM 2:13">Sizamulekelani musake muna iisi.</para>
  <para style="q" vid="NAM 2:13">Madizi ya wasenga wenu hayezahulikika kaidi.<verse eid="NAM 2:13" /></para>
  <chapter eid="NAM 2" />
  <chapter number="3" style="c" sid="NAM 3" />
  <para style="s">Bululu da Ninawi dotagusigwa</para>
  <para style="q">
    <verse number="1" style="v" sid="NAM 3:1" />Dizagaya bululu dimemile wanhu wokoma wayawo,</para>
  <para style="q" vid="NAM 3:1">dimemile uvwizi na ubavi,</para>
  <para style="q" vid="NAM 3:1">hadileka kuhoka vinhu.<verse eid="NAM 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="NAM 3:2" />Tegeleza viya balati vidilanha,</para>
  <para style="q" vid="NAM 3:2">tegeleza sindo za maguludumu,</para>
  <para style="q" vid="NAM 3:2">sindo za falasi wokimbila ng'hani,</para>
  <para style="q" vid="NAM 3:2">na mbumo wa matololi ya kubululigwa na falasi.<verse eid="NAM 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="NAM 3:3" />Mkwelafalasi yahakwela,</para>
  <para style="q" vid="NAM 3:3">zele na migoha vomelemeta,</para>
  <para style="q" vid="NAM 3:3">wanhu wakomigwe wengi ng'hani,</para>
  <para style="q" vid="NAM 3:3">wanhu woikwala muna imitufi haipeteka.<verse eid="NAM 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="NAM 3:4" />Weye Ninawi kuwa fana malaya,</para>
  <para style="q" vid="NAM 3:4">weye mndele wa uhawi kuwakwega wanhu,</para>
  <para style="q" vid="NAM 3:4">kuwatenda wanhu wa zisi nyingi kuwa watumwa kwa umalaya wako,</para>
  <para style="q" vid="NAM 3:4">na kuwakwega wanhu wa zisi nyingi kwa uhawi wako.<verse eid="NAM 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="NAM 3:5" />Niye Mndewa Mulungu Nili na Udahi nolonga,</para>
  <para style="q" vid="NAM 3:5">“Nizaitowa na weye,</para>
  <para style="q" vid="NAM 3:5">nizakuda walo jako mbaka kuna iditwi,</para>
  <para style="q" vid="NAM 3:5">muladi wanhu wa zisi zimwenga wawone lukuli lwako,</para>
  <para style="q" vid="NAM 3:5">falume zimwenga ziwone chinyala chako.<verse eid="NAM 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="NAM 3:6" />Nizakwasila unyolodo,</para>
  <para style="q" vid="NAM 3:6">nizakwehula na kukuguma chinyala.<verse eid="NAM 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="NAM 3:7" />Wanhu wose wondawakuwone wezakukimbila kuno wolonga,</para>
  <para style="q" vid="NAM 3:7">‘Bululu da Ninawi dinangigwa,</para>
  <para style="q" vid="NAM 3:7">yelihi yondayadililile?</para>
  <para style="q" vid="NAM 3:7">Yelihi yondayadigume moyo?’ ”<verse eid="NAM 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NAM 3:8" />Vino weye bululu da Ninawi kofaya ng'hani kufosa bululu da Sebesi,</para>
  <para style="q" vid="NAM 3:8">dizengigwe mumgwazo wa lwanda lwa Naili?</para>
  <para style="q" vid="NAM 3:8">Bululu da Sebesi dizingigwa na mazi,</para>
  <para style="q" vid="NAM 3:8">bahali ikala mhongono yake,</para>
  <para style="q" vid="NAM 3:8">mazi yakala ng'huta yake.<verse eid="NAM 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NAM 3:9" />Isi ya Kushi na Misili zoditaza bululu da Sebesi,</para>
  <para style="q" vid="NAM 3:9">iviya ditazigwa na isi ya Puti na Libia.<verse eid="NAM 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="NAM 3:10" />Mbali bululu da Sebesi disoligwa mateka,</para>
  <para style="q" vid="NAM 3:10">wanhu wake wagalilgwa kuuhami.</para>
  <para style="q" vid="NAM 3:10">Wanage wahondigwa mumgwazo wa kulugumbi.</para>
  <para style="q" vid="NAM 3:10">Wanhu wake wohishimika wogoligwa kwa kuwatowela mhiya,</para>
  <para style="q" vid="NAM 3:10">na walangulizi wake wose wazingilizigwa minyololo.<verse eid="NAM 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="NAM 3:11" />Mweye wanhu wa bululu da Ninawi iviya mwizakoligwa,</para>
  <para style="q" vid="NAM 3:11">mwizamkimbila mwihi na mwizageza kuifisa.<verse eid="NAM 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="NAM 3:12" />Weye Ninawi, mhongono zako zose zilinga fana mibiki ya nhini ili na nhini zivile,</para>
  <para style="q" vid="NAM 3:12">ihatingisika, nhini zolagalilila muna umulomo wa munhu yoja.<verse eid="NAM 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="NAM 3:13" />Lola watowang'hondo wako,</para>
  <para style="q" vid="NAM 3:13">wodumba fana wanaake.</para>
  <para style="q" vid="NAM 3:13">Nyivi za bululu jako zivuguligwa kwa wehi wako,</para>
  <para style="q" vid="NAM 3:13">Moto utimbula mhalalingwe zake.<verse eid="NAM 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="NAM 3:14" />Deha mazi uisasale kuzingigwa na ng'hondo.</para>
  <para style="q" vid="NAM 3:14">Gangamiza mhongono zako.</para>
  <para style="q" vid="NAM 3:14">Sasala ulongo kwa kubojoga,</para>
  <para style="q" vid="NAM 3:14">Sasala tanuli da kusomela matafali.<verse eid="NAM 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="NAM 3:15" />Uko moto wizakutimbula,</para>
  <para style="q" vid="NAM 3:15">na zele dizakukanha.</para>
  <para style="q" vid="NAM 3:15">Dizakukomeleza fana nzige viwoja.</para>
  <para style="q" vid="NAM 3:15">Mongezeke fana nzige,</para>
  <para style="q" vid="NAM 3:15">Mongezeke fana mbalangulu!<verse eid="NAM 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="NAM 3:16" />Wachuuzi wako wawa wengi kufosa nhondo za kuulanga,</para>
  <para style="q" vid="NAM 3:16">mbali walinga fana nzige woleka isi ilibule chinhu,</para>
  <para style="q" vid="NAM 3:16">sambi wasegela fana nzige viwoguluka.<verse eid="NAM 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="NAM 3:17" />Vinyandama wako walinga fana mbalangulu,</para>
  <para style="q" vid="NAM 3:17">wakulu wako wa watowang'hondo walinga fana bumbila da nzige,</para>
  <para style="q" vid="NAM 3:17">lusita lwa chihuhwe wokala muna zing'huta.</para>
  <para style="q" vid="NAM 3:17">Zuwa dihalawa woguluka,</para>
  <para style="q" vid="NAM 3:17">mbali habule yovimanya kowohita.<verse eid="NAM 3:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="NAM 3:18" />Weye mfalume wa Ashulu,</para>
  <para style="q" vid="NAM 3:18">wadimi wako wogona,</para>
  <para style="q" vid="NAM 3:18">vinyandama wako wokukila.</para>
  <para style="q" vid="NAM 3:18">Wanhu wako wapwililika kuna imilima,</para>
  <para style="q" vid="NAM 3:18">habule munhu wa kuwaduganya.<verse eid="NAM 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="NAM 3:19" />Habule chinhu cha kuhonya vilonda vako,</para>
  <para style="q" vid="NAM 3:19">vilonda vako vokutenda udanganike.</para>
  <para style="q" vid="NAM 3:19">Wanhu wohulika mbuli zako wosekelela.</para>
  <para style="q" vid="NAM 3:19">Vino yelihi haumanyile usede wako ulibule uhelelo?<verse eid="NAM 3:19" /></para>
  <chapter eid="NAM 3" />
</usx>