<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TH" style="id">- Devgarhia New Testament</book>
  <para style="ide">UTF-8</para>
  <para style="rem">Copyright Information: Creative Commons Attribution-ShareAlike 4.0 License</para>
  <para style="h">१ थेसलोनिकी</para>
  <para style="toc1">थेसलोनिके शहरके मण्डलीहे पावलके सुरुक चिट्ठी</para>
  <para style="toc2">१ थेसलोनिकी</para>
  <para style="toc3">१ थेस.</para>
  <para style="mt1">थेसलोनिके शहरके मण्डलीहे पावलके सुरुक चिट्ठी</para>
  <para style="mt2">१ थेसलोनिकी</para>
  <para style="is">लिखुइया</para>
  <para style="ip">पावल कना निउतरह्या दुईचो अपनहे यी चिट्ठीहे लिखुइया मै हुइतुँ कहिके कले बा (<char style="xt"><ref loc="1TH 1:1">१:१</ref>; <ref loc="1TH 2:18">२:१८</ref></char>)। सिलास और तिमोथी पावलके दोसर प्रचार यात्रामे ओकर संगसंगे रहिँत (<char style="xt"><ref loc="1TH 3:2">३:२</ref>,<ref loc="1TH 3:6">६</ref></char>)। जब ओइने यी मण्डलीहे सुरुवात करल रहिँत (निउ. १७:१-९) तब ऊ वहाँसे गैलक थोरिक दिन पाछे वहाँक विश्वासीनहे यी चिट्ठी लिखल रहे। थेसलोनिके शहरमे पावलके ख्रीष्टियन सेवा फरछ्वार रुपमे यहूदिनहे किल नै होके गैर-यहूदिनहे फेन छुअल। मण्डलीमे बहुत्ते गैर-यहूदी मूर्ति पुज्ना पृष्ठभूमिसे आइल रहिँत। पर उ जबानक यहूदिनके यी समस्या नै रहिन (१ थेस. १:९)।</para>
  <para style="is">लिख्लक मिति और ठाउँ</para>
  <para style="ip">लगभग ई. स. ५१</para>
  <para style="ip">पावल थेसलोनिके शहरके मण्डलीहे अपन सुरुक चिट्ठी कोरिन्थ शहरमेसे लिखल रहे।</para>
  <para style="is">भेटुइया</para>
  <para style="ip">१ थेस. १:१ यी चिट्ठीहे पह्रुइया मनैनहे चिन्हाइत, “थेसलोनिके शहरके मण्डलीक नाउँ” पर सामान्य रुपमे यी चिट्ठी सक्कु ओहोँर रहल विश्वासीनसे बात करत।</para>
  <para style="is">उद्देश्य</para>
  <para style="ip">यी चिट्ठी लिख्नक पावलके उद्देश्य रहिस कि लावा विश्वासीनहे परीक्षक समयमे हौसला देहे सेके (<char style="xt"><ref loc="1TH 3:3-5">३:३-५</ref></char>)। और परमेश्वर परायण जीवनहे निर्देश देहे सेके (<char style="xt"><ref loc="1TH 4:1-12">४:१-१२</ref></char>)। और ख्रीष्टके फेनदोस्रे फिर्ता अइनासे पहिले मुना विश्वासीनहे भविष्यक बारेमे भरोसा देहे सेके (<char style="xt"><ref loc="1TH 4:13-18">४:१३-१८</ref></char>) अथवा कुछ नैतिक और व्यवहारिक विषयमे ओइन्के सुधार करे सेके।</para>
  <para style="iot">किताबके विभाजन</para>
  <para style="io1">१. धन्यवाद <char style="ior"><ref loc="1TH 1:1-10">१:१-१०</ref> </char></para>
  <para style="io1">२. निउतरह्यनके कामक प्रतिरक्षा <char style="ior"><ref loc="1TH 2:1-3:13">२:१-३:१३</ref> </char></para>
  <para style="io1">३. थेसलोनिके शहरके मण्डलीक प्रबोधन <char style="ior"><ref loc="1TH 4:1-5:22">४:१-५:२२</ref> </char></para>
  <para style="io1">४. अन्तिम प्राथना और आशीर्वाद <char style="ior"><ref loc="1TH 5:23-28">५:२३-२८</ref> </char></para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />यी चिट्ठी पावल, सिलास और तिमोथीक ओहोँरसे हो। यी थेसलोनिके शहरके मण्डलीहे लिखगिल बा, जोन मण्डली परमेश्वर बाबा और प्रभु येशू ख्रीष्टसे सम्बन्धित बा। मै प्राथना करतुँ कि परमेश्वर तुहुरिन्केमे अनुग्रह करिँत और तुहुरिन्हे शान्ति दिँत।<verse eid="1TH 1:1" /></para>
  <para style="s">थेसलोनिके शहरके विश्वासीनके लग धन्यवाद</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />हम्रे प्राथनामे हरदम तुहुरिन्हे सम्झथी, और हम्रे परमेश्वरहे तुहुरिन सक्कुहुनके लग धन्यवाद देथी। <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />और जब हम्रे अपन बाबा परमेश्वरसे प्राथना कर्थी ते हमार प्रभु येशू ख्रीष्टमे तुहुरिन्के उ काम हरदम याद कर्ती रथी, जोन काम तुहुरे विश्वासके कारण करथो। और दोसुर जहनकेमे प्रेम देखाइक लग जोन तुहुरे कड़ा मेहनत करथो। तुहुरे सतावट सहथो। काकरेकी तुहुरे प्रभु येशू ख्रीष्टके फिर्ता अइना आशा करथो। <verse eid="1TH 1:3" /><verse number="4" style="v" sid="1TH 1:4" />हे मोरिक विश्वासी भैयो, हम्रे जन्थी कि परमेश्वर मनैनहे प्रेम करथाँ, तुहुरिन्हे अपन मनै बनाइक लग चुन्ले बताँ। <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />काकरेकी येशू ख्रीष्टके बारेमे हमार खुशीक खबर तुहुरिन्के थेन बोलीमे किल नै आइल। पर पवित्र आत्मक शक्तिसे पूरा रुपमे पक्का होके आइल बा; तुहुरे मजासे जन्थो कि तुहुरिन्के फाइदक लग हम्रे तुहुरिन्के थेन कसिके रही। <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" />तुहुरे हमार और प्रभुक अनुशरण कर्ले बतो। तुहुरिन्केमे बरवार दुःख रहे, पर तुहुरे उ सन्देशहे स्वागत कर्लो, जोन सन्देश पवित्र आत्मासे देगिल बा। <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />तबेकमारे माकेडोनिया प्रदेश और अखैया प्रदेशके सक्कु विश्वासीनके लग तुहुरे नमूना बन्लो। <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />काकरेकी तुहुरिन्के थेनसे परमेश्वरके वचन माकेडोनिया प्रदेश और अखैया प्रदेशमे किल प्रचार नै करगिल हो। पर हरेक ठाउँ जहाँ हम्रे जैथी, वहाँ हम्रे मनैनहे परमेश्वरमे तुहुरिन्के विश्वासके बारेमे हम्रिहिन्हे बताइत भेटैथी। तबेकमारे हम्रिहिन्हे तुहुरिन्के बारेमे दोसुर जहनहे कुछु फेन बतैना जरुरी नै हो। <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />काकरेकी ओइने अप्निहीँ दोसुर जहनहे बतैथाँ, कि जब हम्रे तुहुरिन्के थेन अइली ते तुहुरे कसिके हमार स्वागत करलो। और यी फेन बतैथाँ, कि कसिके तुहुरे मूर्तिनसे दूर होके परमेश्वरके ओहोँर घुम्लो, ताकि तुहुरे जित्ती और सच्चा परमेश्वरके सेवा करो। <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />और हुँकार छावक स्वर्गमेसे फिर्ता अइना असरा हेर्ती रहो, जिहिहे परमेश्वर मुअलमेसे फेनदोस्रे जिवैलाँ। अर्थात येशूहे, जे हम्रिहिन्हे परमेश्वरके उ न्यायसे बँचाइत, जोन आइक लग बा।<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="s">थेसलोनिके शहरमे पावलके सेवा</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />हे मोरिक विश्वासी भैयो, तुहुरे अप्निहीँ जन्थो कि हम्रे तुहुरिन्के थेन अइना फाइदाजनक रहल। <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" />और तुहुरे अप्निहीँ जन्थो कि पहिले हम्रे फिलिप्पी शहरमे दुःख सहली। तभुन फेन परमेश्वर हम्रिहिन्हे असिन साहस देलाँ कि तुहुरिन्के शहरके मनैनसे बहुत विरोध हुइलमे फेन हम्रे तुहुरिन्हे परमेश्वरके खुशीक खबर सुनैली। <verse eid="1TH 2:2" /><verse number="3" style="v" sid="1TH 2:3" />काकरेकी हमार उपदेश ना धोखा देके, ना ते गलत विचारसे, और ना ते छल कपटसे हो। <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />जसिके परमेश्वर हम्रिहिन्हे योग्य मानके खुशीक खबर सौँपल बताँ। तबेकमारे हम्रे मनैनहे नै हो, पर हमार मनहे जँचुइया परमेश्वरहे खुशी बनाइक लग हम्रे उपदेश देथी। <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />तुहुरे जन्थो कि हम्रे तुहुरिन्से मस्का लगैना काम नै कर्ली, और हम्रे धन भेटाइक लग तुहुरिन्से असिके नै कर्ली। परमेश्वर गवाही देथाँ कि हम्रे असिन नै रही। <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />हम्रे मनैनसे आदर नै चाहतिही, और ना ते तुहुरिन्से और ना कौनो दोसुर जहनसे। बेन ख्रीष्टके निउतरह्या हुइलक कारण तुहुरिन्से सहायता भेटैना हमार अधिकार रहे। <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" />पर जसिके एकथो दाई अपन लर्कनहे पालपोष करत, ओस्तेके हम्रे तुहुरिन्के थेन रहिके तुहुरिन्हे माया और दया देखाइल बती। <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />हम्रे तुहुरिन्हे अतरा माया करी कि हम्रे तुहुरिन्के संग परमेश्वरके खुशीक खबर किल बाँटे नै चहली। पर तुहुरिन्के लग हम्रे अपन जीवने देहक लग तयार हुइल रही। काकरेकी हम्रे तुहुरिन्हे बहुत प्रेम करी। <verse eid="1TH 2:8" /><verse number="9" style="v" sid="1TH 2:9" />हे मोरिक विश्वासी भैयो, हम्रे रातदिन कामधन्धा कर्ती तुहुरिन्के बिच्चेम परमेश्वरके खुशीक खबर प्रचार कर्ली। ताकि हमार जरुरीहे पूरा करक लग तुहुरिन्हे कुछु देहे ना परे कहिके हम्रे मेहनत और दुःख कर्ली कना बातहे तुहुरे सम्झथो। <verse eid="1TH 2:9" /><verse number="10" style="v" sid="1TH 2:10" />तुहुरे अप्निहीँ साँखी बतो, और परमेश्वर फेन साँखी बताँ, कि तुहुरे सक्कु विश्वासीनके संग हमार स्वभाव कतरा सच्चा, धार्मिक और निर्दोष रहे। <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />तुहुरे जन्थो कि जसिके एकथो बाबा अपन लर्कनसे व्यवहार करत। ओस्तेके हम्रे फेन तुहुरिन्मेसे हरेक जहनहे उपदेश दि। उत्साहा दि और सम्झाई, <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />कि तुहुरे असिन जीवन जिओ जिहिसे परमेश्वरहे खुशी मिल्थिन। जे तुहुरिन्हे अपन राज और महिमामे बलैथाँ। <verse eid="1TH 2:12" /><verse number="13" style="v" sid="1TH 2:13" />तबेकमारे हम्रे फेन हरदम परमेश्वरहे धन्यवाद देथी, कि जब तुहुरे उ सन्देश सुन्लो, जोन हम्रे तुहुरिन्के बिच्चेम प्रचार कर्ली। ते तुहुरे उहिहे मनैनके नै, पर परमेश्वरके वचन समझके स्वीकार करलो। और यी वचन परमेश्वरेके हो। और आब तुहुरे जे-जे ख्रीष्टकेमे विश्वास करथो, तुहुरिन्केमे परमेश्वरके यी वचन काम करता। <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" />हे मोरिक विश्वासी भैयो, तुहुरे ओस्तेहेँ सतावट सहलो, जसिन परमेश्वरके मण्डलीन सहलाँ। जोन मण्डली यहूदिया प्रदेशमे ख्रीष्ट येशूमे बताँ। और तुहुरे अपने मनैनसे दुःख सहलो, जसिके ओइने अपने मनै अर्थात यहूदिनसे दुःख सहलाँ। <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" />उ यहूदिनके प्रभु येशूहे और परमेश्वरके अगमवक्तनहे फेन मुवाँदरलाँ, और हम्रिहिन्हे सतैलाँ, और परमेश्वर ओइन्से खुशी नै हुइँत; और ओइने सक्कु मनैनके विरोध करथाँ। <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />और जब हम्रे गैर-यहूदिनसे ओइन्के मुक्तिक बारेमे बात बत्वैथी ते ओइने हम्रिहिन्हे रोक्थाँ। असिके ओइने अपन पापमे पाप थप्ती जैथाँ, जबसम कि अन्त्यमे परमेश्वर ओइन्हे दण्ड ना दैदिँत।<verse eid="1TH 2:16" /></para>
  <para style="s">थेसलोनिके शहरके मनैनहे भेँटा करना पावलके इच्छा</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />हे मोरिक विश्वासी भैयो, जब थोरिक समयक लग हम्रे तुहुरिन्के संग नै रही। तभुन फेन हम्रे जबफेन तुहुरिन्के बारेमे सोँची। और तुहुरिन्हे हेरक लग हम्रिहिन्हे खोब मन लागे ते हम्रे तुहुरिन्हे भेँटा करना खोब कोशिस कर्ली। <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />तबेकमारे हम्रे अर्थात मै पावल घनी-घनी तुहुरिन्के थेन आई खोज्नु, पर शैतान हम्रिहिन्हे रोकदेहल। <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />हमार आशा, या आनन्द या गर्व करना मुकुट के हो? यी सक्कु तुहुरेहे हुइतो, जबसम हमार प्रभु येशू ख्रीष्ट फेनदोस्रे फिर्ता नै अइहीँ। <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />हमार गौरव और आनन्द तुहुरे हुइतो।<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />तबेकमारे हम्रे तुहुरिन्हे बिना देख्ले रहे नै सेक्ली। तब् हम्रे एथेन्स शहरमे रुकल पलिरना ठिक सम्झली। <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />और तिमोथी जे ख्रीष्टके खुशीक खबरमे हमार भैया हो, और परमेश्वरके सेबक हो। हम्रे उहिहे तुहुरिन्के थेन यी कारणसे पठैली कि ऊ तुहुरिन्हे बल्गर बनाए। और तुहुरिन्के विश्वासके बारेमे तुहुरिन्हे उत्साहा देहे। <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />ताकि केऊ यी दुःखके कारण डगमगा नाजाए। काकरेकी तुहुरे अप्निहीँ जानतोहो कि हम्रिहिन्हे दुःख उठाई परी। <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />काकरेकी पहिले फेन जब हम्रे तुहुरिन्के थेन रही। तब् हम्रे तुहुरिन्हे कहि कि हम्रिहिन्हे दुःख उठाई परी। और ओस्तेहेँ हुइल बा। और उ तुहुरिन्हे पतै बा। <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />तबेकमारे जब तुहुरे कसिन बतो कना बिना जन्ले मै रहे नै सेक्नु। तब परीक्षा करुइया शैतान तुहुरिन्के परीक्षा ते ना करल बा। और असिन हुई कलेसे हमार मेहनत बेकार होजाई कना मोरिक मनमे डर रहे। और असिन ना होए कहिके मै तिमोथीहे तुहुरिन्के विश्वासके हाल जानक लग तुहुरिन्के थेन पठैनु।<verse eid="1TH 3:5" /></para>
  <para style="s">तिमोथीक नानल खबर</para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6" />पर अब्बे तिमोथी तुहुरिन्के थेनसे हमार थेन आके तुहुरिन्के विश्वास और प्रेमके खुशीक खबर हम्रिहिन्हे सुनाइल। ऊ हम्रिहिन्हे यी फेन बताइल कि तुहुरे हम्रिहिन्हे जबफेन प्रेमसे याद करथो। और जसिके हम्रे तुहुरिन्हे भेँटा करे चहथी, ओस्तेके तुहुरे फेन हम्रिहिन्से भेँटा करे चहथो। <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />हे मोरिक विश्वासी भैयो, तबेकमारे हम्रे अपन कष्ट और दुःखमे फेन तुहुरिन्के बारेमे तिमोथीक थेनसे यी सुनके हौसल बती कि तुहुरे अपन विश्वासमे बल्गर बतो। <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />तुहुरे प्रभुमे बल्गर बतो कहिके पता पैना हमार लग लावा जीवन भेटाइल हस हो। <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />तुहुरिनेके कारण हम्रे हमार परमेश्वरके आघे आनन्द मनैथी। यकर बद्लामे हम्रे परमेश्वरहे जतरा फेन धन्यवाद देलेसे फेन उ कम रहत। <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />हम्रे हरदम प्राथना कर्ती रथी कि हम्रे फेनदोस्रे तुहुरिन्से भेँटा करे आई सेकी। ताकि प्रभु येशू ख्रीष्टमे आकुर बल्गरसे विश्वास करनामे तुहुरिन्के सहायता करे सेकी।<verse eid="1TH 3:10" /></para>
  <para style="s">मण्डलीक लग प्राथना</para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />हम्रे प्राथना कर्थी कि हमार बाबा परमेश्वर और प्रभु येशू तुहुरिन्से भेँटा करे तुहुरिन्के थेन आइक लग हमार डगर बनादिँत। <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />और हम्रे प्राथना कर्थी कि जसिके हम्रे तुहुरिन्हे प्रेम कर्थी, ओस्तेके एकदोसुर जहनहे प्रेम करक लग प्रभु येशू तुहुरिन्हे सहायता करिँत। और दोसुर जहनमे फेन तुहुरिन्के प्रेम बह्रे। और प्रभु तुहुरिन्के प्रेमहे बह्राइँत। और तुहुरिन्केमे हमार प्रेमहे फेन बह्राइँत। <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />हम्रे प्राथना कर्थी कि हमार प्रभु येशू तुहुरिन्के मनहे असिन बल्गर बनाइँत, कि जब हमार प्रभु येशू अपन पवित्र मनैनके संग फेनदोस्रे फिर्ता अइहीँ। तब ऊ परमेश्वर बाबक आघे तुहुरिन्हे पवित्र और निर्दोष ठहराई सेकिँत।<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="s">परमेश्वरहे खुशी बनैना</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />निष्कर्षमे, हे मोरिक विश्वासी भैयो, हम्रे तुहुरिन्हे बिन्ती करती और तुहुरिन्हे येशू ख्रीष्टमे सम्झाइती कि तुहुरे असिके जीवन जिओ, जिहिसे परमेश्वर खुशी हुइथाँ, जसिके हम्रे तुहुरिन्हे सिखाइल बती। तुहुरे पैलेहेँसे असिके जिअतो और हम्रे तुहुरिन्हे अस्तेहेँके करक लग आकुर फेन उत्साहा देहती। <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />तुहुरे जन्थो कि जोन आदेश हम्रे तुहुरिन्हे देली, उ आदेश प्रभु येशूक थेनसे आइल।<verse eid="1TH 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TH 4:3" />परमेश्वरके इच्छा यहे बतिन कि तुहुरे पवित्र बनो और व्यभिचार ना करो। <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />तुहुरिन्मेसे हरेक जाने अपन शरीरहे नियन्त्रण करे सिखे परत, असिन चिजके हस जोन चिजहे पवित्र और आदरसे देखजाइत। <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />और परमेश्वरहे नै चिहिन्ना अविश्वासी मनैनके हस तुहुरे अपन कामुक्तक इच्छक गुलाम ना बनो। <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />असिके करके तुहुरिन्हे अपन विश्वासी भैयक विरोधमे पाप करे नै परत, और ना ते ओकर फाइदा उठैना चाही। काकरेकी प्रभु येशू ओइन्हे दण्ड दिहीँ जेने असिन सक्कु काम करथाँ, जोन काम ना करहो कहिके हम्रे तुहुरिन्हे पहिले फेन चेतावनी देले रही। <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />काकरेकी परमेश्वर हम्रिहिन्हे अशुद्ध जीवन जिअक लग नै, पर पवित्र जीवन जिअक लग बलैले बताँ। <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />तबेकमारे जे यी आदेशहे अस्वीकार करत कलेसे ऊ मनैयाहे नै होके परमेश्वरहे अस्वीकार करत, जे अपन पवित्र आत्मा तुहुरिन्हे देहत। <verse eid="1TH 4:8" /><verse number="9" style="v" sid="1TH 4:9" />पर विश्वासी भैयनकेमे कर्लक प्रेमके बारेमे तुहुरिन्के लग लिखे परना मोरिक कौनो जरुरी नै हो। काकरेकी एकदोसर जहनहे प्रेम करना तुहुरे अप्निहीँ परमेश्वरसे सिख्लो। <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />तुहुरे पैलेहेँसे विश्वासी भैयनकेमे अपन प्रेम देखैले बतो, जेने माकेडोनिया प्रदेशमे रथाँ। पर हे मोरिक विश्वासी भैयो, मै तुहुरिन्हे बिन्ती करतुँ कि तुहुरे आकुर बहरती जाऊ। <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />और जसिके हम्रे तुहुरिन्हे आज्ञा देले बती, ओस्तेहेँके तुहुरे शान्तिसे अपन जीवन जिओ। और दोसुर जहनके मामलामे हस्तक्षेप ना करो, और अपने हाँथेलेके मेहनत करो। <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />ताकि तुहुरे हरेक दिन कसिन व्यवहार देखैथो कहिके उ मनै देखिँत, जेने विश्वास नै करथाँ, ओइने तुहुरिन्के आदर करिँत। तब तुहुरिन्हे अपन जरुरी पूरा करक लग केक्रोमे निर्भर हुई नै परी।<verse eid="1TH 4:12" /></para>
  <para style="s">प्रभुक फेनदोस्रे अइना</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />हे मोरिक विश्वासी भैयो, हम्रे चहथी कि तुहुरे यी जानलेऊ कि उ विश्वासीनके संग का हुइहिन, जेने पैलेहेँ मुसेकल बताँ। ताकि असिन ना होए, कि तुहुरे फेन दोसुर अविश्वासी मनैनके हस शोक मनाऊ। जेनहे आशा नै हुइतिन, कि मुके सेकके ओइने फेनदोस्रे जित्ती होजिहीँ।<verse eid="1TH 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 4:14" />काकरेकी यदि हम्रे विश्वास कर्थी कि येशू मुलाँ और फेनदोस्रे जिगिलाँ कलेसे ओस्तेहेँके उ विश्वासीनहे फेन परमेश्वर येशूक संग फिर्ता नन्हीँ, जेने पैलेहेँ मुसेकल बताँ।<verse eid="1TH 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 4:15" />काकरेकी हम्रे प्रभु येशूक वचन अनुसार तुहुरिन्हे यी कथी कि जब प्रभु येशू फेनदोस्रे फिर्ता अइहीँ। तब जोन विश्वासीन पैलेहेँ मुसेकल बताँ, ओइने हम्रिहिन्से आघे येशूसे भेँटा हुइहीँ।<verse eid="1TH 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 4:16" />काकरेकी प्रभु येशू ख्रीष्ट अप्निहीँ स्वर्गमेसे उत्रिहीँ। उ समयमे येशू बरवार आवाजमे आदेश दिहीँ, और प्रधान स्वर्गदूत जोरसे बोली, और परमेश्वरके तुरही फुँकजाजाई। और पहिले ओइने जित्ती होके उठ्हीँ, जोन विश्वासीन मुसेकल बताँ।<verse eid="1TH 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 4:17" />तब् हम्रे जेने जित्ती और बँचल रबी, हम्रे फेन ओइन्के संग बद्रीमे उठाजिबी। और हमार भेँटा आकाशमे प्रभु येशूसे हुई, और उ समयसे सदादिन हम्रे प्रभुक संग रबी।<verse eid="1TH 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TH 4:18" />तबेकमारे यी बातसे तुहुरे एकदोसर जहनहे उत्साहा देती रहो।<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />पर हे मोरिक विश्वासी भैयो, तुहुरिन्हे प्रभु येशू फेनदोस्रे फिर्ता अइहीँ कना बारेमे लिख्ना जरुरी नै हो। <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" />काकरेकी तुहुरे मजासे जन्थो, कि प्रभुक दिन ओस्तेके आई, जसिके रातके चोरवा आइत। <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />जब मनै कहे भिरल रहिहीँ कि सक्कु चिज मजै बा, और कौनो संकट नै हो। तब उ समयमे एकफाले ओइने बरवार दुःखके अनुभव करहीँ। यी ओस्तेहेँके एकफाले हुई, जसिके कौनो एकथो पैनाहाँ जन्नी मनैयाहे एकफाले बेथा लागजिथिस। और ओइने उ बरवार दुःखसे बँचे नै सेक्हीँ।<verse eid="1TH 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 5:4" />पर हे मोरिक विश्वासी भैयो, तुहुरे ते अंधारमे नै हुइतो, कि प्रभुक अइना दिन चोरवा आई हस तुहुरिन्के बिना तयार हुइले आजाए। <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />काकरेकी तुहुरे सक्कु जाने ओजरारके सन्तान और दिनके सन्तान हुइतो और रातसे और अंधारसे हमार कौनो सम्बन्ध नै हो। <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />तबेकमारे हम्रिहिन्हे अविश्वासीनके हस सुत्ले रहे नै परत। असिन ना होए कि प्रभुक अइना दिन हम्रे बिना तयारीक भेटाजाई। पर हम्रिहिन्हे जागल पलिरहे परत, और अप्निहीँ सचेत हुई परत। <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />काकरेकी जेने सुत्थाँ ओइने रातके सुत्थाँ। और जेने मदुवा रथाँ ओइने रातेके मतवार हुइथाँ। <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" />काकरेकी हम्रे दिनके सन्तान हुइती, तबेकमारे हम्रे अपनहे नियन्त्रण करे परत। विश्वास और प्रेमहे घाललेऊ, जेने ओस्तेहेँके हमार रक्षा करथाँ जसिके एकथो कवच सैनीकके रक्षा करत। और हम्रिहिन्हे यी आशा बा कि हम्रे सदाकालके दण्डसे बँचगिल बती, और हम्रिहिन्हे मुक्ति मिलगिल बा। और यी आशा उ खोप्रिहीक हस हो, जोन सैनीकहे रक्षा करत। <verse eid="1TH 5:8" /><verse number="9" style="v" sid="1TH 5:9" />काकरेकी परमेश्वर हम्रिहिन्हे यी कारणसे नै चुन्लाँ कि ऊ अपन क्रोधसे हम्रिहिन्हे दण्ड दिँत। पर हम्रे अपन प्रभु येशू ख्रीष्टसे मुक्ति भेटाइक लग ठहरागिल बती। <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />येशू ख्रीष्ट हमार लग यी कारणसे मुलाँ, ताकि चाहे हम्रे जित्ती रही चाहे हम्रे मुजाई, जब ऊ फिर्ता अइहीँ ते हम्रे हरदम हुँकार संग रहे सेकी। <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />तबेकमारे तुहुरे एकदोसर जहनहे उत्साहा देऊ, और एकदोसुर जहनहे बल्गर बनाऊ, जसिके तुहुरे करत फेन बतो।<verse eid="1TH 5:11" /></para>
  <para style="s">आखिरी शिक्षा</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />हे मोरिक विश्वासी भैयो, हम्रे तुहुरिन्हे बिन्ती करती, कि जेने तुहुरिन्के लग खोब मेहनत करथाँ। और जेने प्रभुमे तोहाँर अगुवन हुइताँ। और जेने तुहुरिन्हे सल्लाहा देथाँ। ओइन्के आदर करो। <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />ज्या चिज ओइने तोहाँर लग करथाँ, ओकर कारण ओइन्के तुहुरे खोब आदर करो। और ओइन्हे खोब प्रेम करो। और तुहुरे आपसमे एकदोसुर जहनसे झगरा जिन करो। <verse eid="1TH 5:13" /><verse number="14" style="v" sid="1TH 5:14" />और हे मोरिक विश्वासी भैयो, हम्रे तुहुरिन्से बिन्ती करती, कि ओइन्हे चेतावनी देऊ, जेने अल्छि बताँ। और ओइन्हे उत्साहा देऊ, जेने डरपोँक बताँ। जेने कमजोर बताँ, ओइन्के सहायता करो, और सक्कुहुनके संग सहनशीलता देखाऊ। <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />ध्यान देऊ, कि केऊ फेन किहुहे खराबीक बदला खराबी ना करे; पर तुहुरिन्हे हरदम एकदोसुर जहनके लग और सक्कुहुनके लग भलाइक काम करना कोशिस करे परत। <verse eid="1TH 5:15" /><verse number="16" style="v" sid="1TH 5:16" />हरदम आनन्दित रहो। <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />निरन्तर प्राथना कर्ती रहो। <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />हरेक परस्थितिमे परमेश्वरहे धन्यवाद देऊ, काकरेकी तुहुरिन्के लग प्रभु येशूमे परमेश्वरके इच्छा यहे हो। <verse eid="1TH 5:18" /><verse number="19" style="v" sid="1TH 5:19" />पवित्र आत्मक कामहे ना रोको। <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />परमेश्वरसे मनैनकेमे प्रकट करगिलक अगमवाणीहे अस्वीकार जिन करो। <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />यी सन्देश परमेश्वरके ओहोँरसे हो कि नै कहिके जानक लग तुहुरे हरेक सन्देशहे विचार करो। और मजा सन्देशहे स्वीकार करो और ओकर पालन करो। <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />सक्कु मेरके खराबीसे दूर रहो।<verse eid="1TH 5:22" /></para>
  <para style="s">आशीर्वाद</para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />शान्ति देहुइया परमेश्वर तुहुरिन्हे पूरा रुपसे पवित्र कराइँत; तुहुरिन्के पूरा आत्मा, प्राण और शरीर प्रभु येशू ख्रीष्टके फेनदोस्रे फिर्ता नै आइतसम निर्दोष और सुरक्षित पलिरहे। <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />जे तुहुरिन्हे बलाइल ऊ विश्वासयोग्य बताँ। काकरेकी ऊ तुहुरिन्हे पवित्र हुइक लग बलाइल बताँ कलेसे ऊ तुहुरिन्हे पवित्र हुइक लग योग्य फेन बनैहीँ। <verse eid="1TH 5:24" /><verse number="25" style="v" sid="1TH 5:25" />हे मोरिक विश्वासी भैयो, हमार लग प्राथना करो। <verse eid="1TH 5:25" /><verse number="26" style="v" sid="1TH 5:26" />सक्कु विश्वासी भैयनहे पवित्र चुम्मासे नमस्कार करो। <verse eid="1TH 5:26" /><verse number="27" style="v" sid="1TH 5:27" />मै तुहुरिन्हे प्रभुमे आदेश देहतुँ कि यी चिट्ठी पहरके सक्कु विश्वासी भैयनहे सुनादेऊ। <verse eid="1TH 5:27" /><verse number="28" style="v" sid="1TH 5:28" />हमार प्रभु येशू ख्रीष्टके अनुग्रह तुहुरिन्केमे पलिरहे।<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>