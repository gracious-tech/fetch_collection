<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- DEUKHARIYA Tharu New Testament</book>
  <para style="ide">UTF-8</para>
  <para style="rem">Copyright Information: Creative Commons Attribution-ShareAlike 4.0 License</para>
  <para style="h">२ तिमोथी</para>
  <para style="toc1">तिमोथीहे पावलके दोसर चिट्ठी</para>
  <para style="toc2">२ तिमोथी</para>
  <para style="toc3">२ तिमो.</para>
  <para style="mt1">तिमोथीहे पावलके दोसर चिट्ठी</para>
  <para style="mt2">२ तिमोथी</para>
  <para style="is">लिखुइया</para>
  <para style="ip">रोमके झेलमेसे छुटके और अपन चौथा प्रचार यात्रक पाछे पावल फेनदोस्रे नीरो सम्राटके अधिनमे बन्दी बनागिल रहे। यहे चौथै प्रचार यात्रामे पावल तिमोथीहे सुरुक चिट्ठी लिखल रहे। तिमोथीहे दोसर चिट्ठी लिखेबेर ऊ फेनदोस्रे झेलमे रहे। सुरुकचो जब पावल कैदी बनागिल रहे, तब ऊ एकथो केरायक मकानमे नजरबन्द रहे (निउ. २८:३०)। पर यी समयमे ऊ कालकोठ्रीमे रहे (<char style="xt"><ref loc="2TI 4:13">४:१३</ref></char>)। एकथो साधारण कैदीक हस ऊ सिँक्रीलेके बँधल रहे (<char style="xt"><ref loc="2TI 1:16">१:१६</ref>; <ref loc="2TI 2:9">२:९</ref></char>)। पावल जाने कि ओकर काम पूरा होगिल बतिस, और ओकर ओरैना समय आगिल बतिस (<char style="xt"><ref loc="2TI 4:6-8">४:६-८</ref></char>)।</para>
  <para style="is">लिख्लक मिति और ठाउँ</para>
  <para style="ip">लगभग ई. स. ६६-६७</para>
  <para style="ip">यी चिट्ठी लिखेबेर पावल दोसुरचो झेलमे परल रहे। और आब ऊ खाली अपन शहिद हुइना आसरा हेरतेहे।</para>
  <para style="is">भेटुइया</para>
  <para style="ip">यी चिट्ठीहे मुख्य रुपमे पह्रुइया तिमोथी ते रहे, पर ऊ पक्कै फेन यी चिट्ठी मण्डलीहे फेन पह्राइल रहे।</para>
  <para style="is">उद्देश्य</para>
  <para style="ip">यी चिट्ठी लिख्नक पावलके यहे उद्देश्य रहिस कि तिमोथीहे अन्तिमचो हौसैना और नमस्कार करना ताकि जोन काम पावल उहिहे सौँपल बा, उहिहे ऊ बिना डरैले (<char style="xt"><ref loc="2TI 1:3-14">१:३-१४</ref></char>) ध्यान केन्द्रित होके (<char style="xt"><ref loc="2TI 2:1-26">२:१-२६</ref></char>), और लगनशील होके करे (<char style="xt"><ref loc="2TI 3:14-17">३:१४-१७</ref>; <ref loc="2TI 4:1-8">४:१-८</ref></char>)।</para>
  <para style="iot">किताबके विभाजन</para>
  <para style="io1">१. सेवकाईक लग उत्साहा <char style="ior"><ref loc="2TI 1:1-18">१:१-१८</ref> </char></para>
  <para style="io1">२. सेवकाईक आदर्श <char style="ior"><ref loc="2TI 2:1-26">२:१-२६</ref> </char></para>
  <para style="io1">३. झूँटा शिक्षक विरोधमे चेतावनी <char style="ior"><ref loc="2TI 3:1-17">३:१-१७</ref> </char></para>
  <para style="io1">४. अन्तिम नमस्कार और आशीर्वाद <char style="ior"><ref loc="2TI 4:1-22">४:१-२२</ref> </char></para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />मै पावल यी चिट्ठीहे लिखतुँ। परमेश्वर महिन्हे यी कारणसे चुन्लाँ कि मै ख्रीष्ट येशूक निउतरह्या बनुँ, ताकि मै यी सन्देशहे प्रचार करे सेकुँ कि परमेश्वर सदाकालके जीवन देहक लग वाचा कर्ले बताँ। उ जीवन येशू ख्रीष्टके संग हम्रे एकतामे रलेसे आइत। <verse eid="2TI 1:1" /><verse number="2" style="v" sid="2TI 1:2" />हे तिमोथी, मै तुहिन्हे यी चिट्ठी लिखतुँ, और तुँ मोरिक लग एकथो दुलार छावा हस हुइतो। मै प्राथना करतुँ कि परमेश्वर बाबा और हमार प्रभु येशू ख्रीष्ट तोहाँरमे अनुग्रह करिँत, और दया और शान्ति तुहिन्हे मिल्ती रहे।<verse eid="2TI 1:2" /></para>
  <para style="s">विश्वासयोग्य पलिरना प्रोत्साहन</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />जबफेन मै परमेश्वरसे प्राथना करथुँ, तब हरदम मै तोहाँर नाउँ लेके तोहाँरिक लग प्राथना करथुँ, और तोहाँर लग परमेश्वरहे धन्यवाद देथुँ। यी वहे परमेश्वर हुइँत, जेकर आराधना शुद्ध विवेकसे मै और मोरिक पुर्खन कर्ली। <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />जब मै तुहिन्हे छोरके दूर जाइतुहुँ, तब तुँ कतरा रुइल रहो कहिके महिन्हे याद पलि बा। मै तुहिन्हे भेँटा करे चहथुँ। काकरेकी जब हम्रे भेँटा हुइबी, तब महिन्हे बहुत खुशी लागी। <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" />तोहाँरिक दाई युनिसके येशू ख्रीष्टमे रहल सच्चा विश्वासके बारेम महिन्हे याद बा। तोहाँर नानी लोइसकेमे फेन ओस्तेहेँ विश्वास रहिन, और महिन्हे विश्वास बा कि तोहाँर थेन फेन ओस्तेहेँ विश्वास बा। <verse eid="2TI 1:5" /><verse number="6" style="v" sid="2TI 1:6" />तबेकमारे मै तुहुरिन्हे याद कराइतुँ, कि उ वरदानहे फेनदोस्रे निखारो, जोन वरदानहे परमेश्वर तुहिन्हे तब्बेहेँ दैदेले रहिँत, जब मै तोहाँर मुन्टामे अपन हाँथ धारल रहुँ। <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />काकरेकी परमेश्वर हम्रिहिन्हे डरपोँक नै बनैलाँ, बेन हुँकार आत्मा हमार मनहे बल्गर बनैथिन। हम्रिहिन्हे दोसुर जहनहे प्रेम करक लग सहायता करथाँ, और हम्रिहिन्हे अपनहे अप्निहीँ नियन्त्रण करे सेक्ना शक्ति देथाँ। <verse eid="2TI 1:7" /><verse number="8" style="v" sid="2TI 1:8" />तबेकमारे दोसुर मनैनहे प्रभु येशू ख्रीष्टके बारेमे बताइक लग ना लजाऊ। और ना ते तुँ यी बातमे लजैहो कि मै हुँकार सेवा कर्लक कारण झेलमे बतुँ। बेन तुँ उ शक्तिक प्रयोग करहो। जोन शक्ति परमेश्वर तुहिन्हे देथाँ। और खुशीक खबरके लग जोन दुःख मै सहतुँ ओम्ने तुँ महिन्हे साथ देऊ। <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />परमेश्वर हम्रिहिन्हे मुक्ति देलाँ। और हम्रिहिन्हे पवित्र जीवन जिअक लग बलैलाँ। हम्रे मजा काम कर्ली कहिके ऊ हम्रिहिन्हे नै बलैलाँ। पर अपन योजना और उ अनुग्रहक अनुसार बलैलाँ। परमेश्वर यी संसारहे बनैनासे आघे येशू ख्रीष्टहे यी संसारमे पठाके अपन कृपा देखैना योजना पैलेहेँसे बनालेले रहिँत। <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />पर आब हमार मुक्तिदाता येशू ख्रीष्ट आगिल बताँ और हम्रिहिन्हे अपन अनुग्रह देखैले बताँ। मृत्युक शक्तिहे ऊ नाश करदेले बताँ, और हम्रिहिन्हे देखैले बताँ कि खुशीक खबरके माध्यमसे सदाकालके जीवनके लग एकथो डगर बा। और हम्रे उ शरीरमे सदाकालके लग जित्ती रबी जोन शरीर कबु नै सरी। <verse eid="2TI 1:10" /><verse number="11" style="v" sid="2TI 1:11" />यहे खुशीक खबरके लग प्रचारकके रुपमे परमेश्वर महिन्हे चुन्ले बताँ, और निउतरह्या और गुरुक रुपमे फेन महिन्हे चुन्ले बताँ। <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />मै प्रभु येशू ख्रीष्टके बारेमे मनैनहे प्रचार करथुँ, तबेकमारे मै फेन झेलमे दुःख सहतुँ। पर यी बातसे महिन्हे लाज नै हो। काकरेकी मै ख्रीष्टहे चिहिन्थुँ, जेकरमे मै भरोसा कर्ले बतुँ। और महिन्हे पक्का विश्वास बा कि जबसम ख्रीष्ट फिर्ता नै अइहीँ, तबसम परमेश्वर उ चिजहे रक्षा करहीँ, जोन चिज ऊ महिन्हे देले बताँ। <verse eid="2TI 1:12" /><verse number="13" style="v" sid="2TI 1:13" />पक्का करो कि तुँ उ सच्चा शिक्षाहे नमूना हस सम्हारके धर्ले रबो, जोन शिक्षा तुँ महिन्से सुन्ले बतो। और असिके तुँ विश्वास और प्रेमसे करहो, काकरेकी तुँ ख्रीष्ट येशूक संग एकतामे बतो। <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />और हमारमे रना पवित्र आत्मक माध्यमसे तुहिन्हे देगिलक सच्चाइक रक्षा करो। <verse eid="2TI 1:14" /><verse number="15" style="v" sid="2TI 1:15" />तुँ जन्थो कि एशिया प्रदेशमे रहुइयन बहुत्ते विश्वासीन महिन्हे छोरदेले बताँ, ओम्नेमेसे फुगेलस और हर्मोगेनस हुइँत। <verse eid="2TI 1:15" /><verse number="16" style="v" sid="2TI 1:16" />ओनेसिफरसके घरानाहे प्रभु दया करिँत, काकरेकी ऊ महिन्हे भेँटा करे आइल, और बहुत्तेचो महिन्हे सहायता करल। और झेलमे महिन्हे भेँटा करे अइनामे ऊ नै लजाइल। <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />पर जब ऊ रोम शहरमे आइल, तब महिन्हे ऊ सक्कु ठाउँमे खोजल और महिन्हे भेँटा करल। <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />न्यायक दिन ओनेसिफरसहे प्रभु अपन महान दया देखाँइत। तुँ मजासे जन्थो कि ऊ एफिसस शहरमे महिन्हे कतरा सहायता करल।<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />तबेकमारे हे मोरिक छावा तिमोथी, अपनहे तुँ अप्निहीँ उत्साहा देऊ, यी जानके कि परमेश्वर तुहिन्हे उ अनुग्रह देले बताँ, जोन अनुग्रह येशू ख्रीष्टके ओहोँरसे किल आइत। <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />मै बहुत्ते मनैनके आघे ख्रीष्टके बारेमे सन्देश सिखैथुँ कहिके तुँ बहुत्तेचो सुनल बतो। तबेकमारे जेनकेमे तुँ भरोसा करे सेक्थो, और जेने दोसुर जहनहे फेन यी सन्देशहे सिखाइक लग योग्य बताँ, वहे विश्वासीनहे तुँ सही सन्देश सिखाऊ कना मै चहथुँ। <verse eid="2TI 2:2" /><verse number="3" style="v" sid="2TI 2:3" />जसिके एकथो सिपाही धीरजतासे युद्धक मैदानमे आफतहे सहत, ओस्तेके तुहिन्हे फेन आफतहे सहे परी, जसिके हम्रे ख्रीष्ट येशूक लग दुःख सहथी। <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />एकथो सिपाही जे सेनामे काम करत, ऊ एक्केथो समयमे कौनो दोसुर मेरिक काम नै करी। काकरेकी ऊ अपन हाकिमहे खुशी बनाई चाहत। <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />और यदि केऊ कौनो खेलमे भाग लेके प्रतिस्पर्धा करत कलेसे ऊ तबसम ईनाम जिते नै सेकत, जबसम ऊ नियम अनुसार नै खेलत। <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />बालीक सुरुक हिस्सा सक्कुहुनसे आघे उहिहे मिले परत, जोन किसान मेहनत करत। <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />यी विषयमे सोँचो कि यी उदाहरण तुहिन्हे का सिखाइत, और प्रभु तुहिन्हे यी सक्कु बात बुझ्नामे तुहिन्हे सहायता करहीँ। <verse eid="2TI 2:7" /><verse number="8" style="v" sid="2TI 2:8" />ख्रीष्ट येशू के हुइँत कहिके जबफेन सम्झले रहहो। ऊ दाऊद रज्वक खानदानके हुइँत। और परमेश्वर हुँकिन्हे मुअलमेसे जिवैलाँ। और यी वहे खुशीक खबरके अनुसार बा जोन खुशीक खबर मै मनैनहे प्रचार करथुँ। <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />काकरेकी मै परमेश्वरके खुशीक खबर प्रचार करथुँ, तबेकमारे मै एकथो अपराधीक दुःख सहतुँ। पर खुशीक खबरहे फैल्नासे केऊ फेन रोके नै सेकी। <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />तबेकमारे परमेश्वरके चुनगिलक मनैनके फाइदक लग मै सारा दुःख सहथुँ, ताकि ओइने फेन येशू ख्रीष्टमे विश्वास करिँत, और बँचाजाई सेकिँत। और उ महिमाहे भेटाइँत, जोन महिमा हरदम पलिरहत।<verse eid="2TI 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="2TI 2:11" />यी बातमे विश्वास करे सेकजाइत कि यदि हम्रे ख्रीष्टके संग मुगिल बती कलेसे, हुँकार संग जित्ती फेन हुइबी।<verse eid="2TI 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="2TI 2:12" />यदि हम्रे हुँकार लग दुःख सहथी कलेसे, (रज्वनके हस) हम्रे हुँकार संग राज फेन कर्बी।</para>
  <para style="q" vid="2TI 2:12">पर यदि हम्रे यी बातमे अस्वीकार कर्बी कि हम्रे हुँकिन्हे चिहिन्थी कलेसे,</para>
  <para style="q" vid="2TI 2:12">ऊ फेन हम्रिहिन्हे अस्वीकार करहीँ।<verse eid="2TI 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="2TI 2:13" />यदि हम्रे ख्रीष्टकेमे बफादार नै हुइती कलेसे फेन ऊ हमारमे बफादार रहिहीँ।</para>
  <para style="p" vid="2TI 2:13">काकरेकी ऊ ज्या बोल्थाँ, वहे करहीँ।<verse eid="2TI 2:13" /></para>
  <para style="s">परमेश्वरके ओहोँरसे नियुक्त हुइल कामदार</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />अपन मनैनमेसे किहुहे फेन यी बात बिस्राई ना देहो, जोन बात मै तुहिन्हे बतैनु। और परमेश्वरहे एकथो साँखीक रुपमे धारके तुँ ओइन्हे चेतावनी देहो कि ओइने शब्दक अर्थमे वादविवाद ना करिँत। असिन वादविवादसे केक्रो फाइदा नै हुइत। बेन उ बातसे सुनुइया मनैनहे नोकसान किल हुइथिन। <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />तुँ जतरा कर्रा मेहनत करे सेक्थो ओत्रेहे करो। ताकि परमेश्वर तुहिन्हे एकथो असिन कामदारके रुपमे पूरा रुपसे स्वीकार करे सेकिँत, जोन कामदारहे अपन कामके कारण लजाई नै पर्थिस, और जे सच्चा सन्देशहे सही तरिकासे सिखाइत। <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />पर अधर्मी और बिनाकामक बात बत्वैनासे बँचल रहहो। काकरेकी परमेश्वरके भक्ति नै हुइना व्यर्थक बातमे ध्यान ना देऊ। असिन बातचित मनैनहे परमेश्वरसे दूर लैजाइत। <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />ओइन्के बात फैलजिहिन और मनैनहे नोकसान पुगैहिन, जसिके एकथो खुल्ला रुपमे रहल खटरा फैलत, और दोसुर मनैयाहे संक्रमण करत। ओइन्मेसे हुमेनियस और फिलेतस फेन अस्तेहेँ बताँ। <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />ओइने सच्चाइमे विश्वास करना बन्द करदेले बताँ। ओइने कथाँ कि परमेश्वर पैलेहेँ मुअल विश्वासीनहे सदाकालके जीवन देहक लग फेनदोस्रे जिवादेले बताँ। ओकर प्रतिफलके रुपमे ओइने कौनो-कौनो विश्वासीनहे ख्रीष्टमे विश्वास करनासे रोकदेले बताँ। <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" />तभुन फेन परमेश्वरके मनै एकथो घरक जग हस हुइताँ, जोन नै हिलत अथवा ओइने हरदम विश्वासमे पलिरथाँ। यी जगमे यी शब्द लिखल रहत: “प्रभु जन्थाँ कि हुँकार मनै के-के हुइँत।” और यी बात फेन कि “जे-जे परमेश्वरके आराधना करथाँ, ओइने खराबी करना बन्द करदेहे परत।” <verse eid="2TI 2:19" /><verse number="20" style="v" sid="2TI 2:20" />भारी घरेम सोन और चाँदीक भाँरा किल नै रहत। पर कठ्वा और माटिक भाँरा फेन रहत; कौनो भाँरक प्रयोग विशेष मौकामे प्रयोग करजाइत। और दोसुर भाँरक प्रयोग साधारण कामके लग प्रयोग करजाइत। <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />अस्तेके जोन विश्वासी अपनहे सक्कु खराब काममेसे अल्गे कर्ली कलेसे ओकर जीवन पवित्र रहिहिस। और एकथो कौनो महा महिँगा भाँरक हस रहिहिस, जोन भाँरा विशेष मौकामे प्रयोग करजाइत। यहे कारणसे ऊ अपन मलिक्वक लग प्रयोग करे सेक्ना मेरिक रही। <verse eid="2TI 2:21" /><verse number="22" style="v" sid="2TI 2:22" />तबेकमारे उ पापी इच्छासे बँचो, जोन इच्छा जवान मनैनहे अपन ओहोँर तानत। धार्मिकता, विश्वास, प्रेम और शान्तिक पाछे लागो, ओइन्के संग जेने शुद्ध मनसे परमेश्वरके आराधना करथाँ। <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />पर तुहुरे मूर्खता और अज्ञानतासे भरल वाद-विवादसे दूरे रहहो। काकरेकी यिहिसे झगरा किल हुइत कहिके तुँ जन्थो। <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />और प्रभुक सेबकहुँक्रे झगराहा नै हुई परत। और ऊ सक्कुहुनकेमे दयालु हुई परत। परमेश्वरके वचनहे फरछ्वार तरिकासे सिखैनामे सिपार हुई परत। और विरोध करुइया मनैनके कलक बात सहे सेक्ना हुई परत। <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />और उहिहे नम्रतासे ओइन्हे सुधारे परत, जेने ओकर विरोध करथाँ। शायद परमेश्वर ओइन्हे ओइन्के मन बदल्नामे सहायता करदेथाँ कि! ताकि ओइने फेन ख्रीष्टके बारेमे सच्चाइहे जाने सेकिँत। <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />तब ओइने फरछ्वार तरिकासे सोँचे सेक्हीँ। और ओइने शैतानके फन्दामेसे उम्के सेक्हीँ। जोन फन्दा एकथो जाल हस हो। शैतान ओइन्हे फँसालेले बतिन, ताकि अपन चाहल अनुसार ऊ ओइन्हे करवाई सेके।<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s">अन्तिम दिनके लग चेतावनी</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />आब मोरिक कहल बातमे ध्यान देऊ, कि यी संसारके अन्तिम दिनमे महा कर्रा-कर्रा समय आई। <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />काकरेकी मनै अपनहे किल माया करहीँ। रुपिया-पैँसक लाल्ची रहिहीँ। अपनहे अप्निहीँ सक्कुहुनसे भारी मन्हीँ। घमण्ड करहीँ। परमेश्वरके निन्दा करहीँ। दाई-बाबनके कलक नै मन्हीँ। दोसुर जहनके गुन कर्लक बिस्राजिहीँ। परमेश्वरके आदर नै करहीँ। <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />दोसुर जहनहे नै सोगैहीँ। दोसुर जहनहे माफ नै करहीँ। दोसुर जहनहे दोष लगैहीँ। ओइन्के विवेकमे खराब-खराब विचार रहिहीन। खत्थाहा रहिहीँ। मजा कामहे घृणा करहीँ। <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />दोसुर जहनसे विश्वासघात करहीँ। लापरवाही करहीँ। और घमण्डी रहिहीँ। और परमेश्वरहे प्रेम नै करहीँ, पर सुख-विलासहे रोजिहीँ। <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />ओइने परमेश्वरहे देखावती सम्मान करहीँ। पर परमेश्वरके शक्ति ओइन्के खराबसे ओइन्के जीवनहे बदलना बातहे ओइने अस्वीकार करहीँ। असिन मनैनसे कौनो मेरिक सम्बन्ध ना धरहो। <verse eid="2TI 3:5" /><verse number="6" style="v" sid="2TI 3:6" />असिन काम करुइया मनैनमेसे कौनो-कौनो मनै दोसुर जहनके घर जैथाँ, और मूर्ख जन्नी मनैनहे पूरा रुपमे कब्जा करलेथाँ। जोन जन्नी मनैनके मन ओइन्के पापके कारण बोझसे डबल रथिन, और जेने सक्कु मेरिक इच्छक अधिनमे रथाँ। <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />उ जन्नी मनै हरदम लावा-लावा बात सिख्ती रथाँ। पर ओइने ख्रीष्टके बारेमे सच्चा शिक्षाहे कबु नै बुझे सेक्थाँ। <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />यी झूटा शिक्षा देहुइयन सच्चाइक विरोध करथाँ, जसिके यान्नेस और याम्ब्रेस मोशक विरोध कर्ले रहिँत। ओइन्के दिमाग भ्रष्ट बतिन। और ओइने जात्तिकमे ख्रीष्टकेमे भरोसा नै करथाँ। <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />पर ओइन्के सफलता थोरचुन समयक लग किल रहिहीन। काकरेकी जसिके यान्नेस और याम्ब्रेस मूर्ख रहिँत कहिके मनै जानलेले रहिँत। ओस्तेहेँके हरेक जाने यने मूर्ख बताँ कहिके जानलिहीँ।<verse eid="2TI 3:9" /></para>
  <para style="s">तिमोथीहे पावलके आदेश</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />पर हे तिमोथी, तुँ पक्कै फेन जन्थो कि मै का सिखैथुँ। और कसिके जिथुँ, मोरिक जीवनके लक्ष्य का हो, और मै केम्ने विश्वास करथुँ। तुँ जन्थो कि मै सहथुँ। और सक्कुहुनहे प्रेम करथुँ। मै कर्रा समयहे सहल बतुँ। <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" />महिन्हे मनै सतैलाँ, ओकर कारण मै खोब दुःख सहनु। और तुँ उ डरलग्तिक बातके बारेमे जन्थो, जोन बात मनै महिन्हे एन्टिओखियामे, आइकोनियनमे और लुस्त्रा शहरमे करलाँ। और कसिके मै वहाँ सतावटहे सहनु। तभुन फेन उ सक्कुहुनसे प्रभु महिन्हे छुटैलाँ। <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />तुँ मजासे जन्थो कि मनै उ सक्कु मनैनहे सतैहीँ, जेने ख्रीष्ट येशूक अनुयायीनके रुपमे जीवन जिए चहथाँ। <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />और खराब और धोखा देहुइया मनै आकुर धेउर दुष्ट काम करहीँ। ओइने दोसुर मनैनहे धोखा दिहीँ, और अप्ने फेन दोसुर मनैनसे धोखा खैहीँ। <verse eid="2TI 3:13" /><verse number="14" style="v" sid="2TI 3:14" />हे तिमोथी, जोन बात मनै तुहिन्हे सिखैलाँ जेनकेमे तुँ विश्वास करथो, उ बातहे विश्वासयोग्यसे पकरले रहहो। तुहिन्हे पता बा कि यी सच्चा बात तुहिन के सिखाइल। <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />जब तुँ छुटिमुती लौँदा रहो, तब्बेहेँसे तुँ पवित्र शास्त्रहे पहरलो, जिहिसे तुहिन्हे यी बुझक लग सहायता हुइत कि जब तुँ ख्रीष्ट येशूमे विश्वास करथो, तब परमेश्वर तुहिन्हे बँचैथाँ। <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />सारा पवित्र शास्त्र परमेश्वरके ओहोँरसे हो। मनैनहे सच्चा सिद्धान्त सिखाइक लग, गलत काम करुइया मनैनहे चेतावनी देहक लग, मनैनके नेंग्ना गलत डगरहे सुधारक लग, एकथो मजा जीवन कसिके जिए परत कहिके मनैनहे देखाइक लग हम्रे यी पवित्र शास्त्रमे लिखल बातके प्रयोग करे सेक्थी। <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />ताकि परमेश्वरके सेवा करुइया मनैया सक्कु मेरके मजा काम करक लग तयार और सिपार हुई सेके।<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />जब येशू ख्रीष्ट एकथो रज्वक रुपमे राज करक लग अइहीँ। तब येशू जित्ती और मुअल दुनु मेरिक मनैनके न्याय करहीँ। तबेकमारे परमेश्वर और ख्रीष्टहे साँखीक रुपमे धारके मै तुहिन्से विनम्रतासे आग्रह करतुँ, <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />कि तुँ परमेश्वरके वचन प्रचार करो। और चाहे परस्थिति मजा रहे, चाहे खराब रहे परमेश्वरके वचन प्रचार करक लग तुहिन्हे हर समय तयार रहे परी। तुँ मनैनके गल्तीहे बतादेऊ, और ओइने पाप कर्लक कारण ओइन्हे दाँतो। पर तुँ मनैनहे उत्साहा फेन देहे परी, और तुँ यी सक्कु चिज धिरजतासे करहो, और ध्यानसे सिखैहो। <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />काकरेकी एकथो असिन समय आई, जब मनै सच्चा शिक्षाहे स्वीकार नै करहीँ। पर ओइने अपन इच्छाहे किल पूरा करहीँ। और ओइने असिन गुरुनके खोजी करहीँ, जेने ओइन्से वहे बात किल बत्वैहीन, ज्या बात ओइने सुने चहिहीँ। <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />ओइने सच्चा बात नै सुन्हीँ, पर झूँटा और बनाइल कहानीहे सुन्हीँ। <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />पर तुहिन्हे ज्या होगिलेसे फेन तुहिन्हे शान्त रहे परी। और तुहिन्हे जतरा दुःख हुइलेसे फेन तुहिन्हे सहे परी। और परमेश्वरके सेबकके रुपमे तुहिन्हे उ सक्कु काम करे परी, जोन काम ऊ तुहिन्हे करक लग देले बताँ। <verse eid="2TI 4:5" /><verse number="6" style="v" sid="2TI 4:6" />मै तुहिन्हे यी सक्कु आज्ञा देहतुँ, काकरेकी मोरिक जीवन और मोरिक जीवनके बलिदानमेसे हुइलक परमेश्वरके काम दुनु ओराई लागल बा। और मै जन्थुँ कि झत्तेहेँ मै मुजिम। <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />जसिके एकथो सिपाही युद्धमे कबु लरना नै छोरत, ओस्तेहेँके मै फेन ख्रीष्टके लग मेहनत करना नै छोर्नु। जोन काम ख्रीष्ट महिन्हे करक लग देले रहिँत, उ कामहे मै पूरा करदेले बतुँ। मै अन्तिम समयसम विश्वासयोग्य पलिरनु। <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />आब परमेश्वर स्वर्गमे मोरिक लग एकथो ईनाम धर्ले बताँ। काकरेकी मै असिन जीवन जिअल बतुँ, जसिन जीवन हुँकिन्हे मन पर्थिन। मै अपन जीवन धार्मिकतासे जिअल बतुँ। जोन दिन ऊ फिर्ता अइहीँ, वहे दिन उ ईनाम महिन्हे परमेश्वर दिहीँ, जे धर्मी न्यायधीश हुइँत। पर ऊ महिन्हे किल ईनाम नै दिहीँ, पर उ सक्कुहुनहे दिहीँ, जेने हुँकार फिर्ता अइना असरा हेरतताँ।<verse eid="2TI 4:8" /></para>
  <para style="s">व्यक्तिगत सन्देश</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />तुँ एकदम झत्तेहेँ मोरिक थेन अइना कोशिस करहो। <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" />काकरेकी डेमास यी संसारके चिजहे प्रेम करल और महिन्हे छोरदेले बा। और ऊ थेसलोनिके शहरमे चलगिलस। और क्रेसेन्स भैया गलातिया प्रदेशमे चलगिल बा। और तीतस भर दलमातिया प्रदेशमे चलगिल बा। <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" />लूका किल मोरिक संग बा। और जब तुँ अइबो ते तुँ मर्कूसहे फेन अपन संग लयन्हो। काकरेकी यहाँ मोरिक सेवक काममे महिन्हे ऊ सहयोग करे सेकी। <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" />पर तुखिकसहे मै एफिसस शहरमे पठाइल बतुँ। <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" />और जब तुँ फिर्ता अइबो कलेसे मोरिक कोट लेके अइहो, जोन मै त्रोआस शहरके कार्पसके घरेम छोरले बतुँ। मोरिक काम लग्ना कागजात फेन लयन्हो। विशेष करके उ कागजात जोन भेँरिक छालालेके बनल बा। <verse eid="2TI 4:13" /><verse number="14" style="v" sid="2TI 4:14" />तामा, काँसक और लोहक भाँरा बनुइया अलेक्जेन्डर महिन्हे बहुत सतैले बा। प्रभु उहिहे ओकर खराब कामके दण्ड दिहिस। <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />तुँ फेन उहिसे सावधान रहहो। काकरेकी ऊ ख्रीष्टके बारेमे हमार शिक्षक खोबे विरोध कर्ले बा। <verse eid="2TI 4:15" /><verse number="16" style="v" sid="2TI 4:16" />जब सुरुकचो मै अदालतमे अपन बात फरछ्वाई गैल रहुँ, तब महिन्हे केऊ फेन साथ नै देहल। पर सक्कु जाने महिन्हे छोरके चलगिलाँ। यी बातके लग परमेश्वर ओइन्हे दोषी ना ठहराइन। मै प्राथना करतुँ कि यी बातके लग परमेश्वर ओइन्हे माफ कर्दिन कि ओइने महिन्हे एक्केली छोरदेलाँ! <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />पर प्रभु मोरिक संग रहिँत और ऊ महिन्हे शक्ति देलाँ। ताकि महिन्से परमेश्वरके सन्देशके घोषणा पूरा रुपमे पूरा होजाए, और वहाँ रहल सक्कु गैर-यहूदी मनै यी प्रचारहे सुने सेकिँत। और भुँखाइल सिंहनके मुहेमेसे बँचाइल हस ऊ महिन्हे मुनासे बँचैला। <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />और प्रभु महिन्हे सक्कु खराब कामसे छुटैहीँ। ऊ महिन्हे बँचाके स्वर्गमे लैजिहीँ, जहाँ ऊ रज्वक रुपमे राज करथाँ। हुँकार महिमा सदासर्वदा हुइती रहे। आमेन! (यकर मतलब हुइत, अस्तेहेँ होए।)<verse eid="2TI 4:18" /></para>
  <para style="s">आखिरी अभिवादन</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />प्रिस्किला और ओकर थरवा अकिलासहे और ओनेसिफरसके परिवारहे मोरिक ओहोँरसे अभिवादन कहिदेहो। <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" />इरास्तस अभिनसम कोरिन्थ शहरमे पलिबताँ, और त्रोफिमसहे मै मिलेटस शहरमे छोर्ले बतुँ, काकरेकी ऊ बेमार रहिँत। <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />जार छेँक अइनासे पैलेहेँ अइना पूरा कोशिस करहो। और यहाँ रहुइया सक्कु विश्वासी भैयन तुहिन्हे अभिवादन पठैले बताँ। और युबुलस, पुडेस, लेनस और क्लौडिया यने फेन तुहिन्हे अभिवादन पठैले बताँ। <verse eid="2TI 4:21" /><verse number="22" style="v" sid="2TI 4:22" />मै प्राथना करतुँ कि प्रभु तोहाँर संग पलिरहिँत, और हुँकार अनुग्रह फेन तोहाँर संग पलिरहे।<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>