<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- DEUKHARIYA Tharu New Testament</book>
  <para style="ide">UTF-8</para>
  <para style="rem">Copyright Information: Creative Commons Attribution-ShareAlike 4.0 License</para>
  <para style="h">हिब्रू</para>
  <para style="toc1">हिब्रूनके लग चिट्ठी</para>
  <para style="toc2">हिब्रू</para>
  <para style="toc3">हिब.</para>
  <para style="mt1">हिब्रूनके लग चिट्ठी</para>
  <para style="mt2">हिब्रू</para>
  <para style="is">लिखुइया</para>
  <para style="ip">हिब्रूक चिट्ठीक लेखक एकथो रहस्य बा। गोड्गात विद्वानहुँक्रे पावलहे यकर लेखक मन्थाँ, पर यकर लेखक अज्ञाते बा। औरे कौनो फेन किताब असिन नै हो, जोन विश्वासीनके लग असिन सुग्घुरसे ख्रीष्टहे प्रधान पुजारी जनाइत। ऊ हारुनके पुजारी हुइनासे फेन भारी हुइँत, और वहे परमेश्वर प्रदत्त विधान और अगमवक्तनके पूर्ति हो। यी किताब ख्रीष्टहे हमार विश्वासके कर्ता और सिद्ध करुइया हुइँत कहिके जनाइत (हिब. १२:२)।</para>
  <para style="is">लिख्लक मिति और ठाउँ</para>
  <para style="ip">लगभग ई. स. ६४-७०</para>
  <para style="ip">यी चिट्ठी लिख्लक ठाउँ यरुशलेम रहे-येशू स्वर्गमे जाके सेक्लाँ ते और इजरायलके मन्दिर ध्वस्त हुइनासे आघे।</para>
  <para style="is">भेटुइया</para>
  <para style="ip">यी चिट्ठी मुख्य रुपमे उ यहूदिनहे लिखगिल रहे जेने ख्रीष्टहे स्वीकार करलेले रहिँत। ओइने पुरान नियमहे मजासे जानित पर ओइने परीक्षामे रहिँत ताकि फेनदोस्रे यहूदी विचारमे चलजाइँत या खुशीक खबरहे यहूदी चलनके बनादिँत। एकथो सुझाव यी फेन हो कि यी मनै “धेउर संख्यामे पुजारी रहिँत, जेने ख्रीष्टियन विश्वासहे अप्नाइल रहिँत” (निउ. ६:७)।</para>
  <para style="is">उद्देश्य</para>
  <para style="ip">यी चिट्ठीहे लिखुइया अपन श्रोतनहे हौसाइल बा कि ओइने स्थानीय यहूदी शिक्षनहे छोरके येशूसे स्वामिभक्ति निभाइँत। और ओइने देखाइँत कि ख्रीष्ट येशू महान बताँ। परमेश्वरके छावा स्वर्गदूतनसे, पुजारीनसे, पुरान नियमके अगुवनसे या दोसुर कौनो फेन धरमसे भारी हुइँत। क्रूसमे मुके और फेनदोस्रे जित्ती होके येशू विश्वासीनके उद्धार और सदाकालके जीवनहे पक्का करथाँ। हमार पापके लग ख्रीष्टके बलिदान सिद्ध और परिपूर्ण रहिन। विश्वास परमेश्वरके लग ग्रहणयोग्य बा। हम्रे परमेश्वरके आज्ञनहे मानके अपन विश्वास प्रकट कर्थी।</para>
  <para style="iot">किताबके विभाजन</para>
  <para style="io1">१. ख्रीष्ट येशू स्वर्गदूतनसे भारी <char style="ior"><ref loc="HEB 1:1-2:18">१:१-२:१८</ref> </char></para>
  <para style="io1">२. येशू इजरायलके विधान और पुरान वाचासे भारी हुइँत <char style="ior"><ref loc="HEB 3:1-10:18">३:१-१०:१८</ref> </char></para>
  <para style="io1">३. विश्वासयोग्य ठहरना और कष्ट सहे सेक्नक बोलावत <char style="ior"><ref loc="HEB 10:19-12:29">१०:१९-१२:२९</ref> </char></para>
  <para style="io1">४. अन्तिम सम्बोधन और नमस्कार <char style="ior"><ref loc="HEB 13:1-25">१३:१-२५</ref> </char></para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s">स्वर्गदूतनसे भारी छावा</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />पुरान समयमे अगमवक्तनके माध्यमसे बहुतचो और कैयोमेरसे परमेश्वर हमार बाबा-पुर्खनसे बोल्लाँ। <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />पर यी ओरैना-ओरैना दिनमे परमेश्वर अपन छावक माध्यमसे हम्रिहिन्से बोलल बताँ। परमेश्वर अपन छावक माध्यमसे संसारके सृष्टि करलाँ और ऊ अपन छावाहे सक्कु चिजके उत्तराधिकारी नियुक्त करलाँ। <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />येशूए परमेश्वरके महिमक प्रतिबिम्ब और परमेश्वरेके स्वभावके वास्तविक प्रतिरूप हुइताँ, और पूरा विश्वहे अपन शक्तिशाली वचनसे सम्हरथाँ। जब ऊ मनैनके पापहे माफी करे सेकजाए कहिके अपन काम ओरवैलाँ। तबजाके ऊ महिमित परमेश्वरके दाहिन पाँजर उच्च आदरके ठाउँमे बैठ्गिलाँ।<verse eid="HEB 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4" />तबेकमारे परमेश्वर अपन छावाहे स्वर्गदूतनसे फेन बरवार नाउँ देलाँ, जिहिसे हम्रे जाने सेक्थी कि परमेश्वरके छावा स्वर्गदूतनसे भारी हुइँत।<verse eid="HEB 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="HEB 1:5" />कौनो फेन स्वर्गदूतहे परमेश्वर असिके नै कलाँ,</para>
  <para style="q" vid="HEB 1:5">“तैँ मोरिक छावा हुइते<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="fq" closed="false">मोरिक छावा हुइते </char><char style="ft" closed="false">भजनसंग्रह २:७ </char><char style="fp" closed="false">२ शमूएल ७:१४</char></note>,</para>
  <para style="q" vid="HEB 1:5">आज मै घोषणा करतुँ कि तैँ मोरिक छावा हुइते।”</para>
  <para style="q" vid="HEB 1:5">ओकर पाछे ऊ अपन कौनो फेन स्वर्गदूतहे असिके नै कलाँ,</para>
  <para style="q" vid="HEB 1:5">“मै ओकर बाबा हुइम, और ऊ मोरिक छावा होजाई।”<verse eid="HEB 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 1:6" />और परमेश्वर बरका छावाहे संसारमे पठैनासे आघे ऊ फेनदोस्रे कहतताँ,</para>
  <para style="q" vid="HEB 1:6">“मोरिक सारा स्वर्गदूतनके उहिएहे आराधना करिँत।”<verse eid="HEB 1:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 1:7" />स्वर्गदूतनके बारेमे परमेश्वर कहतताँ,</para>
  <para style="q" vid="HEB 1:7">“मोरिक इच्छा अनुसार मै स्वर्गदूतनहे बयाल,</para>
  <para style="q" vid="HEB 1:7">अथवा आगिक मोँजा हस बनाई सेक्थुँ, स्वर्गदूतनके मोरिक सेवा करुइयन किल हुइँत।”<verse eid="HEB 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HEB 1:8" />पर अपन छावक बारेमे भर परमेश्वर कथाँ,</para>
  <para style="q" vid="HEB 1:8">“हे परमेश्वर, तोरिक राज सदासर्वदक लग पलिरही,</para>
  <para style="q" vid="HEB 1:8">और तैँ न्यायसे राज कर्बे।<verse eid="HEB 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HEB 1:9" />ठिक काम करना तुहिहे मन परत, और खराब कामहे तैँ घृणा कर्थे।</para>
  <para style="q" vid="HEB 1:9">तबेकमारे मै, तुहुरिन्के परमेश्वर तुहुरिन्हे तुहुरिन्के संघरियनमेसे रोजल बतुँ। मै तुहुरिन्हे बरे आनन्दसे अलग कर्ले बतुँ।”<verse eid="HEB 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 1:10" />परमेश्वर अपन छावक बारेमे असिके फेन कले बताँ,</para>
  <para style="q" vid="HEB 1:10">“हे प्रभु, सुरुवातमे तैँ संसारहे सृष्टि कर्ले,</para>
  <para style="q" vid="HEB 1:10">और आकाशमे रहल सक्कु चिज तैँ बनैले।<verse eid="HEB 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HEB 1:11" />ओइने ते नाश होजिहीँ, पर तैँ सदासर्वदा जित्ती पलिरबे।</para>
  <para style="q" vid="HEB 1:11">ओइने बिनाकामक होजिहीँ,<verse eid="HEB 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HEB 1:12" />चदरीहस ओइन्हे तैँ बित्यैथे,</para>
  <para style="q" vid="HEB 1:12">लुग्गा बद्ले हस ओइने बदलजिहीँ।</para>
  <para style="q" vid="HEB 1:12">पर तैँ कब्बु नै बदल्थे।</para>
  <para style="q" vid="HEB 1:12">और तैँ हरदम जित्ती पलिरबे।”<verse eid="HEB 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 1:13" />परमेश्वर कबु कौनो स्वर्गदूतहे असिके नै कलाँ,</para>
  <para style="q" vid="HEB 1:13">“तुँ मोरिक दाहिन हाँथेओहोँर सम्मानके ठाउँमे बैठो,</para>
  <para style="q" vid="HEB 1:13">जबसम मै तोहाँर दुश्मनहुँक्रिहिनहे</para>
  <para style="q" vid="HEB 1:13">पूरा रुपमे तोहाँर अधिनमे ना नानदिऊँ।”<verse eid="HEB 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14" />स्वर्गदूतनके उद्देश्य का हुइतिन ते? ओइने ते परमेश्वरके सेवा करुइयन किल हुइँत। परमेश्वर ओइन्हे मुक्ति भेटुइया मनैनके रेखदेख करक लग पठैथाँ।<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s">चेतावनी</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />तबेकमारे हमार सिख्लक बात पालन करक लग बहुत ध्यान देहे परत। तब हम्रे सच्चाइसे दूर नै जैबी। <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />परमेश्वर स्वर्गदूतनके माध्यमसे बोल्लक नियम-कानुन सच्चा साबित हुइल बा, और जे-जे यकर उलंघन करलाँ और पालन नै करलाँ, ओइने परमेश्वरसे दण्ड भेटैलाँ। <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />तबेकमारे यदि यी बरवार मुक्तिहे हम्रे वास्ता नै कर्ली कलेसे पक्कै फेन हम्रे फेन सजाय भेटैबी। आघे प्रभु येशू अप्निहीँ यी मुक्तिक बारेमे कलाँ, और प्रभुक कलक मुक्तिक सन्देश सुनुइया चेलनके हम्रिहिन्हे यी सच्चा हो कहिके सबुत देलाँ। <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />परमेश्वर यिहिहे ठिक अपन इच्छा अनुसार अचम्मक काम करके, बरवार-बरवार चिन्हा देखाके, बहुत मेरिक शक्तिशाली काम करके और मनैनहे पवित्र आत्मक माध्यमसे वरदान देके सच्चा साबित करलाँ।<verse eid="HEB 2:4" /></para>
  <para style="s">ख्रीष्ट मुक्तिदाता</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />हमार बत्वैती अइलक उ लावा संसारहे परमेश्वर स्वर्गदूतनके अधिनमे नै धरलाँ, पर प्रभु येशूक अधिनमे धरलाँ। <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />पवित्र शास्त्रक कौनो एकथो ठाउँमे परमेश्वरहे केऊ असिक कहिके गवाही देहल बा,</para>
  <para style="q" vid="HEB 2:6">“मनैया का हो, और अप्नि, परमेश्वर ओकर वास्ता कर्थी?</para>
  <para style="q" vid="HEB 2:6">अथवा मै, मनैयक छावा<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="fq" closed="false">मनैयक छावा </char><char style="ft" closed="false">यहाँ मनैयक छावा कहिके साधारण रुपसे मनैयाहे कहक खोजल बा।</char></note> के हुइतुँ, और अप्नि मोरिक चिन्ता कर्थी?<verse eid="HEB 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HEB 2:7" />अप्नि थोरिक समयक लग मनैयाहे स्वर्गदूतसे कम शक्तिशाली बनैली।</para>
  <para style="q" vid="HEB 2:7">अप्नि उहिहे रज्वक हस महिमा और आदर देली।<verse eid="HEB 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HEB 2:8" />अप्नि सक्कु चिज ओकर अधिनमे धारदेली, ताकि ऊ सक्कु चिजनके उप्पर राज करे सेके।”</para>
  <para style="p" vid="HEB 2:8">यहाँ कहिगिल बा कि परमेश्वर सक्कु चिज मनैनके अधिनमे धारदेलाँ। यकर मतलब हुइत कि असिन कौनो फेन चिज नै हो, जोन ओइन्के अधिनमे नै हो। पर वर्तमान समयमे हम्रे देखती कि सक्कु चिज मनैनके अधिनमे नै हो। <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />पर सच्चाई यहे हो कि कुछ समयक लग येशू स्वर्गदूतनसे थोरचे तरे करागिलाँ। परमेश्वरके अनुग्रहसे येशू संसारके सक्कु मनैनके लग दुःख भोग्लाँ और मुलाँ। तबेकमारे परमेश्वर येशूहे महिमा और आदर देलाँ।<verse eid="HEB 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 2:10" />परमेश्वर सक्कु चिज बनैलाँ और सक्कु चिज हुँकारे हुइतिन। तबेकमारे बहुत्ते मनैनहे हुँकार महिमामे शामिल हुइक लग लैजाइक लग परमेश्वर निर्णय करलाँ कि मुक्तिक संस्थापक प्रभु येशूहे दुःख-भोगके माध्यमसे सिद्ध बनैना सही बा। <verse eid="HEB 2:10" /><verse number="11" style="v" sid="HEB 2:11" />काकरेकी जोन मनैया मनैनहे पापसे चोखा करत, और जोन मनै अपन पापसे चोखा करगिल बताँ, ओइन्के एक्केथो बाबा, अथवा परमेश्वर हुइँत। तबेकमारे येशू ओइन्हे भैया बाबु कनामे नै लजैथाँ। <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />और ख्रीष्ट परमेश्वरहे कहतताँ,</para>
  <para style="q" vid="HEB 2:12">“मै अपन मनैनहे मोरिक लग कर्लक अप्निक मजा कामके बारेमे कहम,</para>
  <para style="q" vid="HEB 2:12">ओइने अप्निक आराधना करक लग जमा हुइल समयमे मै अप्निक प्रशंसा करम।”<verse eid="HEB 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 2:13" />और फेनदोस्रे येशू कथाँ, “मै अपन भरोसा हुँकार उप्पर धारम।”</para>
  <para style="q" vid="HEB 2:13">और फेनदोस्रे ऊ कहतताँ,</para>
  <para style="q" vid="HEB 2:13">“मै परमेश्वरके देलक मनैनके संग यहाँ बतुँ, यने मोरिक छाईछावा हस हुइँत।”<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />काकरेकी परमेश्वर जेनहे छाईछावा कहिके कलाँ, ओइने मनै हुइँत। येशू हरेक मेरसे हमार हस हुइलाँ, और मनैया होके अइलाँ ताकि हुँकार मृत्युक माध्यमसे, मृत्युक उप्पर अधिकार रहल शैतानहे नाश करे सेकिँत। <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />तबेकमारे मुए परी कना डरकमारे जीवनभर गुलाम हस होके जिअल मनैनहे येशू मुक्ति देलाँ। <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />काकरेकी जात्तिके प्रभु येशू स्वर्गदूतनके नै होके, पर अब्राहामके सन्ताननके मद्दत करथाँ। <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />तबेकमारे हरेक बातमे येशूहे दोसुर मनैनके हस बने पर्लिन। अस्तेहेँके ऊ परमेश्वरके दयालु और विश्वासयोग्य प्रधान पुजारी बन्लाँ। ताकि हुँकार बलिदानसे मनै अपन पापमेसे माफी भेटाई सेकिँत। <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />काकरेकी येशू दुःख और परीक्षा भोग्लाँ, और ऊ परीक्षामे परुइया सक्कु मनैनहे सहायता करे जन्थाँ।<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s">मोशासे भारी येशू</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />तबेकमारे परमेश्वर स्वर्गमे हुँकार संग शामिल हुइक लग बलैलक विश्वासी भैयो, येशूकमे मन लगाऊ, जे हमार लग परमेश्वरके खुशीक खबर सुनुइया दूत और प्रधान पुजारी हुइँत। <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />येशू हुँकिन्हे नियुक्त करुइया परमेश्वरकेमे विश्वासयोग्य रहिँत, जसिके मोशा फेन परमेश्वरके परिवारके सक्कु मनैनके सेवा करनामे विश्वासयोग्य रहे। <verse eid="HEB 3:2" /><verse number="3-4" style="v" sid="HEB 3:3-4" />मनै घर बनैथाँ, पर परमेश्वर सक्कु चिज बनैलाँ। काकरेकी मनै बनाइल घरसे धेउर घर बनुइया मनैयाहे आदर करथाँ। ओस्तेहेँके येशू फेन मोशासे धेउर भारी सम्मानके योग्यक बताँ, जेकर माध्यमसे परमेश्वरके घर बनल। <verse eid="HEB 3:3-4" /><verse number="5" style="v" sid="HEB 3:5" />मोशा परमेश्वरके घरक सक्कु मनैनसे सेबक हस विश्वासयोग्य हुइलस, और पाछेजाके मोशक कर्लक काम भविष्यमे परमेश्वरके बोल्ना सच्चा बातके सच्चा उदाहरण रहे। <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />पर ख्रीष्ट भर परमेश्वरके घरक मनैनके संग छावक रुपमे विश्वासयोग्य रहिँत। और यदि हम्रे ख्रीष्टमे रलक हमार आशामे हिम्मत और भरोसा धर्ले पलिरबी कलेसे हम्रे परमेश्वरके घरक मनै हुइती।<verse eid="HEB 3:6" /></para>
  <para style="s">अविश्वासके विरोधमे चेतावनी</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />तबेकमारे पवित्र आत्मा पवित्र शास्त्रमे कले बताँ,</para>
  <para style="q" vid="HEB 3:7">“आज तुहुरिन्हे परमेश्वरके आवाज सुन्हिक परी।<verse eid="HEB 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="HEB 3:8" />उजाड़-ठाउँमे परीक्षक समयमे परमेश्वरके विरोधमे विद्रोह करुइया तुहुरिन्के पुर्खन हस</para>
  <para style="q" vid="HEB 3:8">परमेश्वरके आज्ञा पालन करना अस्वीकार ना करो।<verse eid="HEB 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HEB 3:9" />वहाँ तुहुरिन्के पुर्खनके महिन्हे नै पत्यैलाँ और महिन्हे जँच्लाँ।</para>
  <para style="q" vid="HEB 3:9">जब्की ओइने चालीस सालसम मोरिक अचम्मक काम देखल रहिँत।<verse eid="HEB 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HEB 3:10" />तबेकमारे उ पुस्तासे मै रिसागिनु।</para>
  <para style="q" vid="HEB 3:10">और कनु, ‘ओइने महिन्हे अस्वीकार कर्ले बताँ।</para>
  <para style="q" vid="HEB 3:10">ओइने मोरिक देहल काम करनासे अस्वीकार कर्ले बताँ।’<verse eid="HEB 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HEB 3:11" />तबेकमारे मै अपन क्रोधमे असिके कसम खैनु,</para>
  <para style="q" vid="HEB 3:11">‘मोरिक विश्राम देना ठाउँमे ओइने कबु नै जाई भेटैहीँ’।”<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />हे मोरिक विश्वासी भैयो, चौँकस रहो! तुहुरिन्मेसे केक्रोमे रहल दुष्ट और अविश्वासी मन तुहुरिन्हे जित्ती परमेश्वरसे दूर ना लैजाए। <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />जबसम पवित्र शास्त्रमे “आझिक दिन” कना शब्द बा, तबसम प्रत्येक दिन एकदोसर जहनहे मजा तरिकासे जीवन बिताइक लग उत्साहा देऊ। यदि तुहुरे ओसिक कर्बो कलेसे, पाप तुहुरिन्हे धोखा नै दि, और तुहुरे परमेश्वरके विरोधमे जिद्दीह्या नै बन्बो। <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />यदि हमार सुरुमे रहल विश्वासमे हम्रे जीवनके अन्त्यसम बल्गर पलिरबी कलेसे हम्रे ख्रीष्टके संग साझा हकदार हुइबी। <verse eid="HEB 3:14" /><verse number="15" style="v" sid="HEB 3:15" />पवित्र शास्त्रमे असिके लिखल बा,</para>
  <para style="q" vid="HEB 3:15">“आझी तुहुरे परमेश्वरके आवाज सुन्बो कलेसे</para>
  <para style="q" vid="HEB 3:15">परमेश्वरके विरोधमे विद्रोह करुइया तुहुरिन्के पुर्खन हस</para>
  <para style="q" vid="HEB 3:15">परमेश्वरके आज्ञा पालन करना तुहुरे अस्वीकार ना करो।”<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />परमेश्वरके आवाज सुनके फेन हुँकार विरोध के करल? ओइने इजरायल देशके मनै हुइँत, जेनहे मोशा मिश्र देशमेसे निकारके नानल रहे। <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />किहिसे चालीस सालसम परमेश्वर रिसैलाँ? ओइने इजरायल देशके मनै हुइँत, जेने पाप करलाँ और उजाड़-ठाउँमे मुगिलाँ। <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />जब परमेश्वर कसम खाके यी घोषणा करलाँ कि ओइने उ ठाउँमे कबु नै जाई भेटैहीँ, जोन ठाउँ मै ओइन्हे बिसाँइक लग देहम। परमेश्वर उ मनैनके बारेमे कहतिहिँत, जेने हुँकार आज्ञा पालन करनासे अस्वीकार करल रहिँत। <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />यिहिसे हम्रे पता पैली कि विश्वास नै कर्लक कारण ओइने बिँसैना ठाउँमे जाई नै भेटैलाँ।<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="s">परमेश्वरके मनैनहे सतौँ दिनमे बिँसैना</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />तबेकमारे हम्रिहिन्हे बिँसैना ठाउँ देहम कहिके परमेश्वरके कर्लक वाचा अभिन फेन पलि बा। तबेकमारे चौँकस रहो, नै ते हमारमेसे केऊ फेन हुँकार वाचा कर्लक बिँसैना ठाउँमे पैँठे नै भेटाई। <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />जसिके हम्रे येशू ख्रीष्टके बारेमे खुशीक खबर सुनल बती, इजरायल देशके मनै फेन बिँसैना ठाउँमे जाई भेटैना खुशीक खबर सुनल रहिँत। पर ओइने यम्ने विश्वास नै करलाँ। तबेकमारे उ सन्देश ओइन्के लग काम नै लग्ना हुइल। <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />तबेकमारे हम्रे परमेश्वरके कलक बातमे विश्वास करुइयन बिँसैना ठाउँमे जैबी। और दोसुर मनैनके लग परमेश्वर कले बताँ,</para>
  <para style="q" vid="HEB 4:3">“तबेकमारे मै अपन रिसमे असिके कसम खैनु,</para>
  <para style="q" vid="HEB 4:3">‘मोरिक बिँसैना ठाउँमे ओइने कबु नै जाई भेटैहीँ’।”</para>
  <para style="p" vid="HEB 4:3">पर हम्रे जन्थी कि उ बिँसैना ठाउँ जोन अब्बे वहाँ बा, उ संसारके सृष्टि हुइल तब्बेहेँसे वहाँ रहे। <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />काकरेकी सतौँ दिनके बारेमे परमेश्वर पवित्र शास्त्रमे असिके कले बताँ, “परमेश्वर सक्कु काममेसे सतौँ दिनमे बिँसैलाँ।” <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />हम्रे असिक फेन पहर्थी कि पाछे परमेश्वर कलाँ, “ओइने बिँसैना ठाउँमे कबु नै जाई भेटैहीँ।” <verse eid="HEB 4:5" /><verse number="6" style="v" sid="HEB 4:6" />पैलेहेँ खुशीक खबर सुनुइया इजरायल देशके मनै अपन अनाज्ञाकारितक कारण बिँसैना उ ठाउँमे जाई नै सेक्लाँ। पर परमेश्वरके उ बिँसैना ठाउँमे जाइक लग अभिन फेन मौका बा। <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />तबेकमारे परमेश्वर हुँकार बिँसैना ठाउँमे जाइक लग दोसुर समय टोक्लाँ, और उ समय आज हो। बहुत साल पाछे हमार पुर्खन परमेश्वरके विरोध करलाँ। ऊ पैलेहेँ लिख्लक बात दाऊद रज्वाहे कहे लगैलाँ,</para>
  <para style="q" vid="HEB 4:7">“आज तुहुरे परमेश्वरके आवाज सुन्बो कलेसे</para>
  <para style="q" vid="HEB 4:7">हुँकार आज्ञा पालन करना अस्वीकार ना करो।”<verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />हम्रे यी फेन जन्थी कि परमेश्वरके वाचा कर्लक बिँसैना ठाउँ कनान देश नै हो, जहाँ जाइक लग हमार पुर्खनहे यहोशू अगुवाई करल रहे। काकरेकी यदि उ ठाउँ कनान देश रहत कलेसे परमेश्वर पाछेसे दोसुर दिनके बारेमे नै कना रहिँत। <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />परमेश्वरके मनैनके लग अभिन फेन असिन ठाउँ बा, जहाँ ओइने पूरा रुपमे बिँसाई सेक्थाँ। परमेश्वर सतौँ दिनमे बिँसाई हस ओइने बिसैहीँ। <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />काकरेकी परमेश्वर अपन काम सेकके बिँसैलाँ। और सक्कु जाने अस्तेहेँ करहीँ, जेने परमेश्वरके संग बिँसैना ठाउँमे जैहीँ। ओइने अपन काम ओर्वाके बिसैहीँ। <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />तबेकमारे हम्रे उ बिँसैना-ठाउँमे जाइक लग कोशिस करी। और केऊ फेन परमेश्वरके आज्ञा पालन करनासे अस्वीकार करुइया मनैनहे नमूना ना मानिँत। तब हम्रे उ बिँसैना-ठाउँमे जाई सेकब।<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />परमेश्वरके वचन ते काम कर्ती रना और जित्ती बा। यी दुनु ओहोँर धार रहल तरवालसे फेन चोखुर बा। यी भित्तर जाके प्राण और आत्माहे अलग करदेहत, अथवा गाँठीगुँथा और हड्डीहे फेन काट्देहत। परमेश्वरके वचन मनैनके मनके विचार और चाहनाहे फट्कारसे जाँचत। <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />परमेश्वरके नजरमे कौनो मनै नै नुकल हुइँत। और हुँकिनेहे हम्रे अपन जीवनभर कर्लक सक्कु कामके लेखा देहे परी। हुँकार आघे सक्कु चिज फरछ्वार और खुल्ला बा।<verse eid="HEB 4:13" /></para>
  <para style="s">येशू सक्कुहुनसे भारी प्रधान पुजारी</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />स्वर्गमे गैलक परमेश्वरके छावा येशूए हुइँत। ऊ हमार सक्कुहुनके सक्कुहुनसे भारी प्रधान पुजारी हुइँत। तबेकमारे सक्कु मनैनके आघे स्वीकार कर्लक विश्वासहे थामके बल्गर पलिरहो। <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />प्रधान पुजारी, जे येशू ख्रीष्ट हुइँत, ऊ हमार सक्कु कमजोरीहे बुझ्थाँ। काकरेकी हमार हस शैतान हुँकिन्हे फेन सक्कु बातमे परीक्षा करल। तभुन फेन ऊ कौनो पाप नै करलाँ। <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />तबेकमारे हिम्मत करके परमेश्वरके आघे जाई, जे अनुग्रहसे भरल बताँ। परमेश्वर हम्रिहिन्हे दया और अनुग्रह देखैहीँ, और जरुरीक समयमे हमार सहायता करहीँ।<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />परमेश्वर इजरायल देशके मनैनमेसे हरेक प्रधान पुजारीनहे रोज्लाँ। और ऊ हरेक प्रधान पुजारीनहे मनैनके ओहोँरसे पापके माफिक लग भेटी और बलिदान चह्राइक लग नियुक्त करलाँ। ताकि परमेश्वर मनैनके पापहे माफ करे सेकिँत। <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />काकरेकी प्रधान पुजारीनके अप्निहीँ फेन कमजोर मनै हुइँत। तबेकमारे ओइने नै जानल और डगर भुलाइल मनैनहे नम्र होके सम्झाई सेक्थाँ। <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />तबेकमारे प्रधान पुजारीनके जसिके दोसुर मनैनके पापके माफिक लग बलि चह्राई पर्थिन। ओस्तेहेँके ओइन्हे अपन पापके माफिक लग फेन बलि चह्राई पर्थिन।<verse eid="HEB 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 5:4" />सम्मान भेटाइक लग केऊ फेन अप्निहीँ प्रधान पुजारी हुई नै सेकत। परमेश्वर सुरुक प्रधान पुजारी हारुनहे नियुक्त करलाँ, जसिके परमेश्वरके नियुक्त कर्लक मनैया किल प्रधान पुजारी हुई सेकत। <verse eid="HEB 5:4" /><verse number="5" style="v" sid="HEB 5:5" />अस्तेहेँके ख्रीष्ट सम्मान भेटाइक लग अप्निहीँ प्रधान पुजारी नै हुइलाँ। पर परमेश्वर हुँकिन्हे उ सम्मान देलिन। और असिके कलिन,</para>
  <para style="q" vid="HEB 5:5">“तैँ मोरिक छावा हुइते,</para>
  <para style="q" vid="HEB 5:5">आज मै घोषणा करतुँ कि तैँ मोरिक छावा हुइते।”<verse eid="HEB 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 5:6" />दोसुर ठाउँमे, परमेश्वर हुँकिन्हे फेनदोस्रे कलिन,</para>
  <para style="q" vid="HEB 5:6">“मल्किसेदेक<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="fq" closed="false">मल्किसेदेक </char><char style="ft" closed="false">मल्किसेदक अब्राहामके पालामे एकथो पुजारी और रज्वा रहे।</char></note> पुजारी रहल हस</para>
  <para style="q" vid="HEB 5:6">तैँ सदादिनके लग पुजारी हुइते।”<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />येशू अपन शारीरिक जीवनमे रहलमे अपनहे मुअलमेसे बँचुइया परमेश्वरसे जोरसे रुइति बिन्ती और प्राथना चह्रैलाँ। हुँकार नम्रता और भक्तिक कारण परमेश्वर हुँकार प्राथना सुन्लिन। <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />येशू परमेश्वरके छावा हुइँत। तभुन फेन अपन भोग्लक दुःख-कष्टसे येशू परमेश्वरके आज्ञा माने सिख्लाँ। <verse eid="HEB 5:8" /><verse number="9-10" style="v" sid="HEB 5:9-10" />मल्किसेदेक पुजारी हुइल हस परमेश्वर येशूहे प्रधान पुजारी बनाके सम्मान देलिन। और जब येशूहे परमेश्वर पूरा रुपमे सिद्ध बनाके सेक्लाँ ते हुँकारमे विश्वास करुइया मनैनके लग ऊ सदाकालके मुक्तिक मूल होगिलाँ।<verse eid="HEB 5:9-10" /></para>
  <para style="s">पतनमेसे बँच्ना चेतावनी</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />यकर बारेमे कहे परना ते बहुत बा। पर उ बातके बारेमे वर्णन करना कर्रा बा। काकरेकी तुहुरे परमेश्वरके वचन सिखक लग नै हौसल हुइतो। <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />अभिनसम ते तुहुरे दोसुर जहनहे सिखाई सेक्ना मेरिक हुई परना रहे। पर तुहुरे अभिन फेन परमेश्वरके वचनके बारेमे प्राथमिक बात पता नै पाके कौनो दोसुर जाने सिखाई पर्थिन। आँखर खाना खैना ठाउँमे अभिन तुहुरिन्हे लर्कन हस दुधे चाहत। <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />दूध खाके किल जिउइया मनैया भर धार्मिक जीवन बितैना शिक्षामे पूरा नै हुइल रहत। काकरेकी ऊ बच्चै रहत। <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />पर मजबुत मनैयक तुलना आँखर खाना खाई सेक्ना मनैयक संग करल बा। उ मनैया विश्वासमे बल्गर रहत, और गहिँर शिक्षा बुझे सेकत। उ मनैया मजा और खराब छुत्याई सेकत।<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />तबेकमारे आऊ, हम्रे उ चिज सिख्ना बन्द करी, जोन चिज हम्रिहिन्हे पैलेहेँ ख्रीष्टके बारेमे सिखागिल रहे। और गहिँर शिक्षाहे सिखी ताकि हमार विश्वास परिपक्क होजाए। हम्रिहिन्हे फेनदोस्रे परमेश्वरमे विश्वासके बारेमे और मृत्यु ओहोँर लैजिना कामसे दूर हुइना बारेमे सिख्ना सुरु नै करे परी। <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />बहुत मेरिक डुब्किक बारेमे शिक्षा, केक्रो उप्पर हाँथ धरना और मुअल मनैनके फेनदोस्रे जिउठ्ना और सदाकालके दण्ड जसिन बातमे किल लागके विश्वासके जग फेनदोस्रे बैठैना शिक्षामे नै लागी। <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />यदि परमेश्वरके अनुमति हुई कलेसे मै तुहुरिन्हे विश्वासमे परिपक्क हुइना शिक्षा देहम।<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />जे अपन विश्वास छोरत, ओइन्हे फेनदोस्रे पश्चात्ताप करना अवस्थामे नाने नै सेकजाइत। ओइने एकचो परमेश्वरके सच्चाइहे चिहिन्लाँ, और स्वर्गमेसे वरदान भेटैलाँ। और ओइने दोसुर जहनके संग पवित्र आत्मा भेटासेकल बताँ। <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />ओइने परमेश्वरके थेनसे अइलक सन्देश मजा बा कहिके और ओइने भविष्यमे अइना समयक शक्तिक अनुभव करल रहिँत। <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />ओइन्हे फेनदोस्रे फिर्ता नन्ना कौनो तरिका नै हो। काकरेकी ओइने अप्निहीँ परमेश्वरके छावाहे फेनदोस्रे क्रूसमे टंग्था और हुँकार लाज करथाँ। और दोसुर मनै ख्रीष्टहे बेकार हो कहिके सोँच्थाँ।<verse eid="HEB 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7" />मजा शिक्षा स्वीकार करुइया मनैया जमिन हस हो, जेम्ने पानी बर्सत। यदि जमिन मजा बा कलेसे यी जमिन किसानहे मजा बाली देहत, और यम्ने परमेश्वरके आशिष रहत। <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />दोसुर मनै उ जमिन हस हुइँत, जोन जमिन काँटा और सेहुँर जमाइत, और उ जमिन बेकार रहत। असिन जमिनमे ते परमेश्वरके सराप परना डर रहत, और यी आगीलेके नाश होजाई।<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />मोरिक प्रिय भैयो! तुहुरे मजा काम करतो। काकरेकी परमेश्वर तुहुरिन्हे पैलेहेँ मुक्ति देसेकल बताँ। तबेकमारे यी चेतावनी तुहुरिन्के बारेमे नै हो। <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />जसिके तुहुरे मजा काम करल बतो, और आब परमेश्वरके नाउँमे परमेश्वरके मनैनके लग प्रेमसे सेवाके काम करतो। परमेश्वर तुहुरिन्हे नै बिस्रैहीँ। काकरेकी ऊ धर्मी बताँ। <verse eid="HEB 6:10" /><verse number="11-12" style="v" sid="HEB 6:11-12" />अल्छी ना होऊ। पर कड़ा मेहनत करुइयन हस तुहुरे फेन यी प्रेम भरल काम धैर्यता और विश्वाससे अन्तिमसम कर्तिरहे परत। और परमेश्वरके वाचा भेटाइक लग मजबुत आशा हुई परत।<verse eid="HEB 6:11-12" /></para>
  <para style="s">परमेश्वरके वाचक पक्का</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />परमेश्वर अब्राहामहे वाचा करेबेर ऊ अपन नाउँमे कसम खैलाँ। काकरेकी केक्रो नाउँ लेके कसम खाइक लग हुँकिन्से भारी केऊ नै रहे। <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />परमेश्वर कलाँ, “पक्कै फेन मै तुहिन्हे आशिष देहम, अथवा तुहिन्हे बहुत्ते सन्तान देहम।” <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />अब्राहाम सँस्सा करके नम्मा समयसम अँस्याइल। तब ऊ परमेश्वरके वाचा कर्लक आशिष भेटाइल।<verse eid="HEB 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 6:16" />कसम खाईबेर मनै अपनसे भारी मनैयक नाउँ प्रयोग करथाँ। कसमसे यी साबित हुइत कि ओइन्के कलक सच्चा हो। और कसम सक्कु बहसहे ओर्वादेहत। <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />तबेकमारे परमेश्वर फेन कसम खैलाँ। यिहिसे ऊ वाचा भेटैलक मनैनहे फरछ्वार रुपमे देखाई चाहतिहिँत कि ऊ अपन वाचाहे पूरा करहीँ। <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />तबेकमारे परमेश्वर हम्रिहिन्से वाचा कर्ले बताँ और ऊ कसम खैथाँ, यी दुईथो बात बद्ले नै सेकत। काकरेकी परमेश्वर झूट बोले सेक्हीँ कना बात सम्भव नै हो। तबेकमारे हम्रे जेने सुरक्षा भेटाइक लग परमेश्वरके लग्गे आइल बती। हमार आघे रहल आशाहे भेटाइक लग हम्रे बरवार हौसला भेटाई सेक्थी। <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />जसिके बरवार खम्भामे बाँधल बरहा लाउहे बल्गर और हिले नै देहत। ओस्तेहेँके यी आशा हमार जीवनहे पक्का और सुरक्षित धारत। जेकर आशा हम्रे कर्थी ऊ येशू हुइँत : ऊ स्वर्गमे पवित्र तम्बूक पर्दक पाछे परम पवित्र ठाउँमे परमेश्वरके थेन गैलाँ। <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />हमार लग येशू हम्रिहिन्से आग्गिहीँ उ ठाउँमे जाके बैठसेकल बताँ। मल्किसेदेक पुजारीक हस ऊ सदक लग प्रधान पुजारी हुइल बताँ।<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s">प्रधान पुजारी मल्किसेदेक</para>
  <para style="p">
    <verse number="1-3" style="v" sid="HEB 7:1-3" />यहे मल्किसेदेक शालेम शहरके रज्वा और सर्वोच्चक परमेश्वरके प्रधान पुजारी रहे। ओकर नाउँक मतलब “न्यायसे राज करुइया रज्वा” हुइत, और शालेम रज्वक मतलब “शान्तिक रज्वा” हुइत। पवित्र शास्त्रमे ओकर बाबा, और ओकर पुर्खनके बारेमे अथवा ओकर जलम, अथवा ओकर मुलक बारेमे कौनो बात नै लिखल हो। ऊ सदक लग पुजारी हो। तबेकमारे ऊ परमेश्वरके छावा हस बा। जब अब्राहाम चारथो रज्वनहे मारके घुमके आइतेहे। तब मल्किसेदेक उहिसे भेँटा हुइलस, और उहिहे आशीर्वाद देहल। और अब्राहाम उहिहे युद्धमेसे जितके भेटैलक सक्कु चिजके दशांश देहल।<verse eid="HEB 7:1-3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />आब विचार करो ते, मल्किसेदेक कतरा महान मनैया रहे, जिहिहे हमार पुर्खा अब्राहाम युद्धमेसे जितके भेटैलक सक्कु चिजके दशांश देहल। <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />लेवी वंशक पुजारीनके कथाँ, मोशक नियम कानुन यी बात सिखाइत कि जेने पुजारी बन्थाँ। ओइने इजरायल देशके अपन मनैनसे दशांश लेहे परत। पर उ पुजारीनके और दोसुर मनै दादू-भैया हस हुइँत। काकरेकी ओइने सक्कु जाने अब्राहामके लरका हुइँत। <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />पर यी मनैया मल्किसेदेक, जे लेवी वंशक फेन नै रहे। ऊ अब्राहामसे दशांश लेहल। और परमेश्वरके वाचा भेटुइया अब्राहाम रलेसे फेन मल्किसेदेक अब्राहामहे आशीर्वाद देहल। <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />हम्रे यी ते पक्कै जन्थी कि आशिष देहुइया आशिष भेटुइयासे भारी रहत। <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />और लेवी वंशक पुजारीनके जेने दशांश लेहतिहिँत, ओइने एक दिन मुजिना रहिँत। पर अब्राहामके बारेमे दशांश लेहुइया पुजारी मल्किसेदेक अभिनसम जित्ती पलि बा कहिके पवित्र शास्त्रमे साबित हुइल बा। <verse eid="HEB 7:8" /><verse number="9-10" style="v" sid="HEB 7:9-10" />मनैनसे दशांश लेहुइया लेवी अब्राहामके वंश रहे। तबेकमारे जब अब्राहाम मल्किसेदेकहे भेँटा करल, और उहिहे दशांश देहल। तब हम्रे असिके कहे सेक्थी कि लेवी फेन मल्किसेदेकहे अब्राहामके माध्यमसे दशांश देहल रहे।<verse eid="HEB 7:9-10" /></para>
  <para style="s">येशू मल्किसेदेक हस</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />जेने हारुनके वंशमेसे लेवी कुलके रहिँत, उ मनैनहे पुजारीक चलन अनुसार मोशक नियम कानुन देजाए। पर ओइने उ चलनके माध्यमसे सिद्ध हुई नै सेक्लाँ। तबेकमारे दोसुर पुजारी अइना जरुरी रहे। उ पुजारी हारुन हस नै होके मल्किसेदेक हस हुई परना रहे। <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />काकरेकी जब पुजारी पद बद्लत, तब मोशक नियम कानुन फेन बद्लिही परत। <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />हम्रे यी बात ख्रीष्टके बारेमे कहती, जे दोसुर कुलके रहिँत। उ कुलमेसे केऊ फेन अभिनसम वेदीमे पुजारीक रुपमे सेवा नै करल रहिँत। <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />काकरेकी सक्कुहुन्हे पतै बा कि हमार प्रभु येशू यहूदक वंश हुइँत। और मोशा यहूदक कौनो फेन वंश पुजारी बन्ना बातके बारेमे कुछु नै कहल हो। और यहूदक कौनो फेन वंश कबु पुजारी नै बनल हुइँत।<verse eid="HEB 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15" />मै का बात बत्वाइतुँ कहिके आब फरछ्वार होजाइत कि मोशक नियम कानुन पैलेहेँ बदलसेकल बा। काकरेकी दोसुर पुजारी आसेकल बताँ, और ऊ मल्किसेदेक हस बताँ। <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />येशू लेवी कुलके हुइलक कारण पुजारी नै बन्लाँ। ऊ मनैनके चलन और कानुनके पालन नै करके, पर अमर जीवनके शक्तिक माध्यमसे पुजारी बन्लाँ। <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />काकरेकी पवित्र शास्त्रमे परमेश्वर हुँकार बारेमे गवाही देले बताँ,</para>
  <para style="q" vid="HEB 7:17">“मल्किसेदेक पुजारी रहल हस</para>
  <para style="q" vid="HEB 7:17">तैँ सदादिनके लग पुजारी हुइते।”<verse eid="HEB 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 7:18" />काकरेकी पुरान मोशक नियम कानुन कुछु करे नै सेक्ना और काम नै लग्ना हुइलक कारण खारेज करगिल बा। <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />काकरेकी मोशक नियम कानुन कुछु सिद्ध करे नै सेकल। और हमार थेन येशू ख्रीष्टके मजा आशा बा, जिहिसे हम्रे परमेश्वरके लग्गे जाई सेक्थी।<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />और परमेश्वर येशूहे कसम खाके पुजारी बनैलाँ। <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />लेवीक वंशनहे परमेश्वर बिना कसम खाके पुजारी बनैले रहिँत। पर येशूहे कसम खाके पुजारी बनैलाँ। और जब येशू परमेश्वरके पुजारी हुइलाँ। तब परमेश्वर कलाँ,</para>
  <para style="q" vid="HEB 7:21">“मै, परमेश्वर कसम खाइतुँ।</para>
  <para style="q" vid="HEB 7:21">और मै अपन मन कबु नै बद्लम।</para>
  <para style="q" vid="HEB 7:21">तैँ सदादिनके लग पुजारी हुइते।”<verse eid="HEB 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 7:22" />तबेकमारे येशू हम्रिहिन्हे बरह्या करार पूरा करना भरोसा देले बताँ।<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />दोसुर फरक का हो कलेसे पहिलेक पुजारीनके अपन काम पूरा करे नै सेक्लाँ। पर ओइने मुगिलक कारण ओइन्के ठाउँमे दोसुर पुजारी नियुक्त हुइलाँ। तबेकमारे आघेक पुजारीनके संख्या बहुत्ते रहिन। <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />पर येशू अनन्त हुइलक ओहोँरसे हुँकार पुजारीक पद केऊ नै ली। <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />तबेकमारे येशूक माध्यमसे परमेश्वरके लग्गे अउइयनहे ऊ सदाकालके लग मुक्ति देहे सेक्थाँ। काकरेकी ओइन्के लग मध्यस्थतक प्राथना चह्राइक लग ऊ सदादिन जित्ती बताँ।<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />येशू हम्रिहिन्हे चहलक प्रधान पुजारीक रज्वा हुइँत। ऊ पवित्र, निर्दोष और शुद्ध बताँ। परमेश्वर हुँकिन्हे पापी मनैनसे अलग कराके सक्कुहुनसे धेउर आदरसे स्वर्गमे बैठैलिन। <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />और हारुनके वंशक प्रधान पुजारीनके हस येशूहे फेन रोट्दिन बलि चह्रैना जरुरी नै हो। उ प्रधान पुजारीनके आघे अपन पापके लग और ओकर पाछे दोसुर मनैनके पापके लग बलिदान चह्रैलाँ। येशू अपन बलिदान देके यी कामहे सदादिनके लग पूरा करदेलाँ। <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />काकरेकी मोशक नियम कानुन कमजोर मनैनहे प्रधान पुजारी नियुक्त करत। पर मोशक नियम कानुनसे पाछे अइना कसम परमेश्वरके छावाहे प्रधान पुजारी नियुक्त करल रहे। और ऊ सदादिनके लग सिद्ध प्रधान पुजारी हुइल बताँ।<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s">लावा करारके प्रधान पुजारी</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />आब हमार कहे खोज्लक बात भर यहे हो: हमार फेन असिन प्रधान पुजारी बताँ, जे स्वर्गमे महान परमेश्वरके सिंहासनके दाहिन ओहोँर उच्च आदरके ठाउँमे बैठल बताँ। <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />हमार प्रधान पुजारी स्वर्गमे रहल महापवित्र तम्बूमे सेवा करथाँ। उ तम्बू मनै नै होके परमेश्वर बनैलाँ।<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />हरेक प्रधान पुजारी पाप क्षमक भेटी और बलिदान चह्राइक लग नियुक्त हुइल रथाँ। तबेकमारे, हमार प्रधान पुजारी ख्रीष्टहे फेन पाप क्षमक लग कुछु चिज चह्रैना जरुरी बतिन। <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />यदि येशू यी संसारमे पलिरताँ कलेसे ऊ पुजारी नै रना रहिँत। काकरेकी मोशक नियम कानुन अनुसार भेटी चह्रुइया पुजारीनके ते पलिबताँ। <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />ओइन्के पुजारीनके रुपमे करना यी काम स्वर्गमे रहल सच्चा कामके नक्कल और छाहीँ किल हुइतिन। पर स्वर्गमे रहले हस नै हो। काकरेकी जब मोशा पवित्र तम्बू बनाइतेहे। तब परमेश्वर मोशाहे चेतावनी देहल रहिँत, “पहाड़मे तुहिहे देखादेलक ढाँचा अनुसार तैँ सक्कु चिज ठिक्केपर बनाइक लग पक्का हुइस।” <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />पर ख्रीष्ट येशू, जे हमार प्रधान पुजारी हुइँत। हुँकिन्हे दोसुर पुजारीनहे देहल कामसे धेउर भारी काम देगिल रहिन। काकरेकी येशू जोन करारके मध्यस्थता कर्ले बताँ। उ करार पुरान करारसे फेन धेउर मजा बा। और उ मजा बातके वाचामे आधारित बा।<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />काकरेकी यदि सुरुक करारमे कुछु गलत नै रहत कलेसे दोस्रा करारके जरुरी नै परना रहे। <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />पर उ मनैनके दोष देखैती परमेश्वर कहतताँ,</para>
  <para style="q" vid="HEB 8:8">“परमप्रभु कहतताँ, उ दिन आई,</para>
  <para style="q" vid="HEB 8:8">जब इजरायल<note caller="+" style="f"><char style="fr" closed="false">8:8 </char><char style="fq" closed="false">जब इजरायल </char><char style="ft" closed="false">दाऊद रज्वक समयक पाछे, इजरायल देशके मनै दुईथो राज्यमे विभाजन होगिलाँ, जेम्नेमेसे एकथो इजरायल और दोसुर यहूदिया कहिजाए। परमेश्वर यहाँ असिके कथाँ कि यी लावा करार मै एक्केथो समूहसे किल नै होके सक्कु मनैनसे बाँधम। यिहिसे यी जनाइत कि यहूदा कुलमेसे अइलक येशू यहूदिया प्रदेशके मनैनके किल नै होके सक्कु मनैनके मुक्तिदाता हुइँत। </char></note> देशके मनैनके संग और यहूदिया प्रदेशके मनैनके संग</para>
  <para style="q" vid="HEB 8:8">मै एकथो लावा करार बाँधम।<verse eid="HEB 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="HEB 8:9" />यी करार भर ओइन्के पुर्खनके संग मोरिक बाँधल करार हस नै रही।</para>
  <para style="q" vid="HEB 8:9">उ बेला ते मै हाँथ पकरके</para>
  <para style="q" vid="HEB 8:9">ओइन्हे मिश्र देशमेसे निकारल रहुँ।</para>
  <para style="q" vid="HEB 8:9">परमप्रभु कथाँ कि, मै ओइन्के संग बहन्लक करार ओइने पालन नै करलाँ।</para>
  <para style="q" vid="HEB 8:9">तबेकमारे मै ओइन्के वास्ता नै कर्नु।<verse eid="HEB 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="HEB 8:10" />फेनदोस्रे परमप्रभु कहतताँ, कि अइना दिनमे</para>
  <para style="q" vid="HEB 8:10">मै इजरायल देशके मनैनके संग यी करार बाँधम।</para>
  <para style="q" vid="HEB 8:10">मै ओइन्हे मोरिक नियम कानुनके बारेमे सोच्नाहाँ बनैबुँ।</para>
  <para style="q" vid="HEB 8:10">और ओइने उहिहे अपन मनमे धरहीँ।</para>
  <para style="q" vid="HEB 8:10">और मै ओइन्के परमेश्वर होजिम।</para>
  <para style="q" vid="HEB 8:10">और ओइने मोरिक जनता होजिहीँ।<verse eid="HEB 8:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="HEB 8:11" />‘परमप्रभुहे चिन्हो’ कहिके आब ओसिके कौनो मनैया</para>
  <para style="q" vid="HEB 8:11">अपन देशके मनैनहे या अपन नाँतपाँतनहे सिखाई परना जरुरी नै पर्हिन।</para>
  <para style="q" vid="HEB 8:11">काकरेकी छुटिसे लेके भारीसम सक्कु जाने मै ओइन्के परमेश्वर हुइतुँ कहिके चिहिन्हीँ।<verse eid="HEB 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="HEB 8:12" />मै ओइन्के पापहे माफ करदेहम,</para>
  <para style="q" vid="HEB 8:12">और ओइन्के पाप कबु याद नै रही।”<verse eid="HEB 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13" />परमेश्वर यिहिहे लावा करार कले बताँ। तबेकमारे ऊ सुरुक करारहे पुरान बनैलाँ। और जोन करार पुरान होके थोँथ्रे हुइती जाइत, उ झत्तेहेँ गायब होजाई।<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s">मनैनके बनाइल तम्बूमे आराधना</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />पुरान करारमे आराधना सम्बन्धी कानुन इजरायलके मनैनके लग रहिन। और मनैनके बनाइल आराधना करक लग एकथो तम्बू फेन रहे। <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />यी तम्बू पशुनके छल्रीलेके बनाइल रहे। उ तम्बूक बिच्चेम ओइने पर्दा झुलाके दुईथो कोठा बनैले रहिँत। सुरुक कोठामे सातथो शाखा रहल दिउँत रहे। वहाँ एकथो टेबुल रहे, जेम्ने परमेश्वरहे चह्रैलक रोटी रहे। यी कोठाहे पवित्र ठाउँ कहिजाए। <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />तम्बूक भित्तर पर्दक पाछेक दोसुर कोठाहे महापवित्र ठाउँ कहिजाए। <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />वहे कोठामे धूप बरना सोनक वेदी धारल रहे। और वहाँ एकथो वाचक सन्दूक फेन रहे, जोन भित्तर बाहेर सोनक रेपन लगाइल रहे। उ सन्दूकमे तीनथो सामान रहिँत: मन्न<note caller="+" style="f"><char style="fr" closed="false">9:4 </char><char style="fq" closed="false">मन्न </char><char style="ft" closed="false">मन्न: मन्न धनियक गुदा हस एकथो छुटिमुती गुल्यार-गुल्यार चिज हो, जेकर स्वाद मध्रीक सहद हस रथिस। यिहिहे धुर बनाके खाना पकाईबेर प्रयोग करे सेकजाइत। उजाड़-ठाउँमे चालीस सालसम इजरायलीनके मुख्य खाना यहे रहिन। इजरायल देशके मनै उजाड़-ठाउँमे खानक कमि हुइल समयमे गनगन करलाँ ते परमेश्वर ओइन्हे यी रोटी स्वर्गमेसे देलिन (प्रस्थान 16:4)। </char></note> धारल सोनक भाँरा, तेम्ह्री<note caller="+" style="f"><char style="fr" closed="false">9:4 </char><char style="fq" closed="false">तेम्ह्री </char><char style="ft" closed="false">तेम्ह्री लागल: तेम्ह्री लागल बात यी बातके सबुत हो कि हारुन परमेश्वरके चुनल पुजारी रहे (गिन्ती 16 और 17)।</char></note> लागल हारुनके एकथो लट्ठी, और मोशाहे परमेश्वरके देहल दशथो आज्ञक दुईथो ढुंगक पाटी रहिँत, जिहिहे परमेश्वर लिखल रहिँत। <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />सोनक सन्दुकके टिप्पामे पख्ना रहल दुईथो करुब<note caller="+" style="f"><char style="fr" closed="false">9:5 </char><char style="fq" closed="false">करुब </char><char style="ft" closed="false">करुब: यी स्वर्गमे रहल प्राणीक पख्नक मूर्ति हो।</char></note>के मूर्ति रहिँत, जोन यी बातहे जनाए कि परमेश्वर वहाँ बताँ। ओइन्के खुलल पख्ना सन्दूकके उपरका हिस्साहे छोपत। जेम्ने खुन छिटजाए ताकि मनैनके पाप माफ होजाइन। पर हम्रे यी महिमक सक्कु बातके व्याख्या अब्बे करे नै सेकब।<verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />असिके यी सक्कु तयार होके सेकत ते पुजारीनके उ तम्बूक आराधना करना सुरुक कोठामे जाके अपन रीतिरिवाज पूरा करिँत। <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />पर सालमे एकचो किल प्रधान पुजारी महापवित्र ठाउँमे जाए। जब ऊ भित्तर पैँठे, तब ऊ अपन संग जानबरके खुन लेके जाए। प्रधान पुजारी उ खुनहे अपन पापके माफिक लग और मनैनके नै जानके कर्लक पापके माफिक लग परमेश्वरहे चह्राए। <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />यी रीतिरिवाजसे पवित्र आत्मा हम्रिहिन्हे यी बुझाइतताँ कि जबसम यी धर्तीमे उ तम्बू बा, और यकर रीतिरिवाज यी धर्तीमे पालन हुइता। तबसम स्वर्गक महापवित्र ठाउँमे परमेश्वरके थेन जैना डगर नै खुली। <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />यिहिसे यी फरछ्वार होजाइत कि परमेश्वरहे चह्रैलक बलिमे मनैनके मनहे सिद्ध बनाई सेक्ना शक्ति नै हो। अब्बे यी हमार लग एकथो शिक्षा हो। <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />काकरेकी ओइने ते मनैनहे खैना और पिना और मनैनहे बाहिरी रुपमे शुद्ध बनैना बहुत मेरिक पुरान चलनके लहैनक बारेमे किल कथाँ। यी रीतिरिवाज ओइन्हे परमेश्वरके लावा करार सुरु नै हुइतसम पालन करे परिन।<verse eid="HEB 9:10" /></para>
  <para style="s">ख्रीष्टके खुन</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />पर आब ख्रीष्ट प्रधान पुजारी होसेकल बताँ, जे लावा करारके सक्कु मजा चिज देथाँ। ऊ स्वर्गमे रहल आकुर महान और सिद्ध तम्बूमे गैल बताँ। जोन तम्बू मनैनके बनाइल नै हो, और यी संसारके फेन नै हो। <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />ख्रीष्ट स्वर्गमे रहल महापवित्र ठाउँमे छेग्रा और बछरवनके खुन लेके नै गैलाँ। पर ऊ अपने खुनेलेके गैलाँ। असिके येशू एक्केचोमे करदेलाँ। और फेनदोस्रे यकर जरुरी नै हो। उहिसे हम्रे सदाकालके मुक्ति भेटैली। <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />मोशक नियम कानुनके चलन अनुसार छुटिह्या मनै परमेश्वरके आराधना करना लायकके नै रहिँत। पर उ छुटिह्या मनैनकेमे यदि छेग्रा और बर्धक खुन और होमबली चह्रैलक बछर्वक भुवा छिटदेलेसे ओइन्के चलन अनुसार ओइने चोखा मानजाइँत। <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />पर ख्रीष्ट बिना पापके रहिँत। और ऊ अपनहे सदाकालके लग और आत्मिक बलिक रुपमे परमेश्वरहे चह्रैलाँ। तबेकमारे हुँकार खुन शक्तिशाली बतिन, और हमार सोँचाईहे शुद्ध बनैथिन। आब हम्रे जित्ती परमेश्वरके सेवा करे सेक्थी, और उ काम नै कर्बी जोन काम मृत्यु ओहोँर लैजाइत।<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />तबेकमारे ख्रीष्ट परमेश्वरके बिच्चेमसे मनैनके लग लावा करार नन्लाँ। परमेश्वरके बलाइल मनै हुँकार वाचा कर्लक आशिष भेटाई सेक्थाँ। उ आशिष सदादिनके लग पलिरही। ख्रीष्ट मुलक कारण ओइने उ आशिष भेटाई सेक्थाँ, ताकि सुरुक करारमे रहुइयन पापमेसे स्वतन्त्र हुई सेकिँत।<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />उदाहरणके लग, कौनो एकथो मनैया किहुहे इच्छापत्र लिखक लग अनुरोध करत। जहाँ ऊ वाचा कर्ले बा कि ऊ अपन सम्पति कौनो एकथो निश्चित मनैयाहे हकदारके रुपमे देहक लग बा। कलेसे उ सम्पतिक मलिक्वा मुके सेकी, तब किल उ मनैया ओकर सम्पतिक हक भेटाई। <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />काकरेकी सम्पतिक मलिक्वा जित्ती रहतसम उ इच्छापत्रक कौनो महत्त्व नै रहत। उ मनैया मुके सेकत, तब किल उ इच्छापत्रक महत्त्व रहत। <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />तबेकमारे सुरुक करार<note caller="+" style="f"><char style="fr" closed="false">9:18 </char><char style="fq" closed="false">करार </char><char style="ft" closed="false">करार: यहूदी मनैनके चलन रहिन कि यदि दुईथो मनै करार बहन्हीँ कलेसे ओइने अपन बाँधल करार पक्का करक लग कौनो जानबरहे मारके बलि चह्राइत। उत्पत्ति 15 अध्यायमे परमेश्वर असिके यी पक्का करक लग करलाँ कि परमेश्वर अब्राहामसे बहन्लक करार पूरा करहीँ। </char></note> कौनो जानबरके खुन छिटके किल पक्का हुइल रहे। <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />तबेकमारे मोशा नियम कानुनके हरेक आज्ञा मनैनहे कहिके सेकके बछरवा और छेग्रनके खुनहे लेके पानीमे मिलैलस। ऊ लाल ऊनहे हिसपके दहियाँमे बाँधल। और उहिहे उ खुनमे डुबाके नियम कानुनके किताबमे और सक्कु मनैनके उप्पर छिटल। <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />मोशा असिके करेबेर मनैनहे कहल, “तुहुरिन्के पालन करना आज्ञक बारेमे परमेश्वर तुहुरिन्के संग करार बहन्ले बताँ। यी खुन उ करारहे पक्का करत।” <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />अस्तेहेँके मोशा पवित्र तम्बूमे और आराधनामे चलैना सक्कु भाँरामे वहे मेरसे खुन छिटल। <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />मोशक नियम कानुन कहत कि लगभग सक्कु चिजहे खुन छिटके चोखा बनाई परत। और खुन बिना चह्रैले पाप माफ हुई नै सेकत, जे मृत्युहे देखाइत।<verse eid="HEB 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />तबेकमारे उ तम्बूहे और ओम्ने रहल सक्कु चिजहे जानबरके बलिलेके चोखा करे परना जरुरी रहे। और यी चिज स्वर्गक चिजके नक्कल किल हुइँत। पर स्वर्गमे रहल चिजनहे रीति पुगाके चोखा करक लग जानबरके खुनसे आकुर धेउर मजा बलिक जरुरी रहे। <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />तबेकमारे ख्रीष्ट मनैनके बनाइल उ तम्बूमे नै गैलाँ, जोन खास बातके नक्कल किल हो। पर ऊ ते सक्ली ठाउँ स्वर्गमे गैलाँ, ताकि ऊ हमार फाइदक लग परमेश्वरके आघे जाई सेकिँत। <verse eid="HEB 9:24" /><verse number="25-26" style="v" sid="HEB 9:25-26" />प्रधान पुजारी हरेक साल पशुनके बलि चह्रैलक खुन लेके उ तम्बूक दोसुर कोठामे जैथाँ। पर ख्रीष्ट ओसिके नै करलाँ। ओसिके करे पर्तिन कलेसे संसारके सुरुवातेसे ख्रीष्टहे घनीघनी अपनहे बलि करे परना रहिन। पर आब अन्त्यक समयमे ऊ एक्केचो सक्कु जहनके लग अइलाँ। ताकि ऊ अपनहे बलि करके हमार पापहे उठालैजाइँत। <verse eid="HEB 9:25-26" /><verse number="27" style="v" sid="HEB 9:27" />हरेक मनैनहे एकचो मुए परना पक्का बा। और मुके सेकब ते परमेश्वर हरेक मनैनके न्याय करहीँ। <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />ओस्तेहेँके बहुत्ते मनैनके पाप उठाके लैजाइक लग ख्रीष्ट अपनहे एकचो बलि करलाँ। और ऊ दोसुरचो फेनदोस्रे मनैनके पापके बलिदान हुइक लग नै अइहीँ। पर हुँकार डगर हेरके बैठुइयनहे बँचाइक लग अइहीँ।<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="s">ख्रीष्टके बलि सदादिनके लग</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />मोशक नियम कानुनमे रहल पुरान नियम अइना मजा चिजके छाहीँ किल हो। ख्रीष्ट हमार लग कर्लक मजा बातके वास्तविकता नै हो। पुरान नियममे बलि घनीघनी और सालोसाल चह्राई परिन। पर ओइने परमेश्वरके आराधना करे अउइया मनैनहे पूरा रुपमे शुद्ध पारे नै सेकिँत। <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />यदि मोशक नियम कानुन ओइन्हे सिद्ध बनाई सेकत कलेसे बलि चह्रैना काम पैलेहेँ रोकजैना रहे। परमेश्वरके आराधना करुइया मनै अपन पापमेसे जात्तिके शुद्ध होजिताँ। और ओइने पापके दोषी रलक महसुस नै करताँ। <verse eid="HEB 10:2" /><verse number="3-4" style="v" sid="HEB 10:3-4" />पर सच्चा बात यी हो कि ओइन्हे चह्रैलक उ बलि हरेक साल ओइन्हे पापके दोषी रलक याद करवैथिन। काकरेकी जानबर बर्धा और बोकनके खुन पाप कर्लक मनैनके दोषहे मेटाई नै सेकत।<verse eid="HEB 10:3-4" /></para>
  <para style="s">ख्रीष्टके बलिदानसे पुग्ना</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />तबेकमारे संसारमे आइलमे ख्रीष्ट परमेश्वरहे कलाँ,</para>
  <para style="q" vid="HEB 10:5">“मनैनसे तैँ बलि और भेटी नै चहले।</para>
  <para style="q" vid="HEB 10:5">पर तैँ महिन्हे बलिदानके लग शरीर देले बते।<verse eid="HEB 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HEB 10:6" />होमबलिनमे और पापबलिनमे तैँ खुशी नै हुइले।”<verse eid="HEB 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="HEB 10:7" />तब् ख्रीष्ट परमेश्वरहे कलाँ, “हे परमेश्वर पवित्र शास्त्रमे मोरिक बारेमे लिखल हस</para>
  <para style="q" vid="HEB 10:7">तोरिके इच्छा पूरा करे मै आइल बतुँ।”<verse eid="HEB 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 10:8" />मोशक नियम कानुन सिखाइत कि पापके कारण बलि और भेटी चह्रैना जरुरी बा। पर ख्रीष्ट काकरे यी बातके उल्लेख करलाँ, और कलाँ कि परमेश्वर उ चिज नै चहथाँ? <verse eid="HEB 10:8" /><verse number="9-10" style="v" sid="HEB 10:9-10" />और ओकर पाछे येशू असिके कलाँ, “हे परमेश्वर तोरिके इच्छा पूरा करक लग मै आइल बतुँ।” और परमेश्वरके इच्छा अनुसार, ख्रीष्ट अपन शरीरहे एक्केचो बलिक रुपमे चह्रैलाँ। यिहिसे परमेश्वर हम्रिहिन्हे पवित्र बनैलाँ। असिके ख्रीष्ट सुरुक करारके बलिहे खारेज करथाँ, ताकि ऊ दोसुर करारहे सुरु करे सेकिँत।<verse eid="HEB 10:9-10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />पुरान करार अनुसार पुजारीनके रोट्दिन बेदीक आघे ठरह्याके घनिघनी बलिदान चह्रैना सेवा करिँत, जे पापहे कब्बु हटाई नै सेकत। <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />पर ख्रीष्ट अपनहे सदादिनके लग पुग्ना मेरिक पाप माफिक लग एक्केथो किल बलि चह्रैलाँ। ओकर पाछे ऊ परमेश्वरके दाहिन हाँथेओहोँर उच्च आदरके ठाउँ सिंहासनमे बैठ्लाँ। <verse eid="HEB 10:12" /><verse number="13-14" style="v" sid="HEB 10:13-14" />ख्रीष्ट अपन शरीरहे बलिक रुपमे एक्केचोमे परमेश्वरहे देलाँ। तबेकमारे हुँकार मनै पवित्र हुइल बताँ। और ओइने सदादिनके लग सच्चा धर्मी हुइल बताँ। और परमेश्वर हुँकार दुश्मननहे हुँकार अधिनमे और पौलीक तरे नै कराइतसम ख्रीष्ट आज फेन वहैँ अस्याइतताँ।<verse eid="HEB 10:13-14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />पवित्र आत्मा फेन यी सच्चा हो कहिके हम्रिहिन्हे गवाही देथाँ। सुरुमे ऊ कथाँ,<verse eid="HEB 10:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="HEB 10:16" />“उ दिनिक पाछे ओइन्के संग बहन्ना मोरिक करार</para>
  <para style="q" vid="HEB 10:16">यहे हो, परमप्रभु कथाँ, कि</para>
  <para style="q" vid="HEB 10:16">मै ओइन्हे मोरिक नियम कानुनके बारेमे सोँचे सेक्ना बनैम।</para>
  <para style="q" vid="HEB 10:16">और ओइने उहिहे अपन मनमे धरहीँ।”<verse eid="HEB 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 10:17" />परमेश्वर फेनदोस्रे कथाँ,</para>
  <para style="q" vid="HEB 10:17">“ओइन्के पाप और ओइन्के खराब काम</para>
  <para style="q" vid="HEB 10:17">मै फेनदोस्रे नै सम्झम।”<verse eid="HEB 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 10:18" />और परमेश्वर हमार पाप और खराब कामहे माफ करथाँ। और आब कौनो फेन बलि चह्रैना जरुरी नै हो।<verse eid="HEB 10:18" /></para>
  <para style="s">कोशिस करना सल्लाहा</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />तबेकमारे हे मोरिक विश्वासी भैयो, येशू बलिक रुपमे अपन खुन देलाँ। यिहिसे हम्रे बिना डरैले स्वर्गक महापवित्र ठाउँमे हिम्मतसे पैँठे सेक्थी। <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />जब ख्रीष्ट मुलाँ, तब ऊ हम्रिहिन्हे सदाकालके जीवन देहक लग लावा डगर खोलदेलाँ। येशू पर्दामेसे छिरके डगर खोल्लाँ, ओकर मतलब यी हो कि ऊ अपनहे बलिक रुपमे चह्राके असिके करलाँ। <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />और परमेश्वरके मनैनमे राज करुइया हमार संग एकथो महान पुजारी हुइलक कारण, <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />ख्रीष्टके खुन छिट्कलक कारण हमार मनके दोष हटके चलगिल बताँ, और हमार शरीर शुद्ध पानीलेके धोगिल बा। और हम्रे तयार करगिल बती। तबेकमारे आब आई, सच्चा मन और बल्गर विश्वाससे हम्रे परमेश्वरके थेन जाई। <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />आई, हमार धर्लक आशा हम्रे बल्गरसे पकर्ले रही। काकरेकी परमेश्वर अपन वाचा कर्लक सक्कु चिज विश्वासयोग्यतासे पूरा करहीँ। <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />आई, हम्रे एकदोसुर जहनहे प्रेम करना और भलाई करना बातमे एकदोसुर जहनहे उत्साहा देती रही। <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />तमान जहनके प्रभुक महिमा करना सङ्गतिमे नै जैना बानी रथिन। पर हम्रे एक्के थेन जुटे नै छोरी। पर एकदोसुर जहनहे आकुर हौसला देती रही। काकरेकी हम्रिहिन्हे पता बा कि प्रभु झत्तेहेँ फिर्ता आइतताँ।<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />हम्रे अस्तेहेँ काम करे परत। काकरेकी यदि ख्रीष्टके बारेमे सच्चा सन्देश पता पाके फेन हम्रे जान-जानके पाप कर्बी कलेसे हमार पाप मेटाइक लग आकुर कौनो बलि नै हो। <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />बेन ओइने डरैती परमेश्वरके न्यायक लग अँस्याई परत। और ओइने हुँकार दुश्मन हुइलक कारण दम्कती रहल आगीमे भसम होजिहीँ। <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />मोशक नियम कानुनहे नै मनुइया मनैयाहे दुई या तीनथो साँखीन बताँ कलेसे उ मनैया बिना दयक मुए परत। <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />यदि मोशक नियम कानुन अनुसार सजाय ओस्तेहेँ रहे कलेसे, जे परमेश्वरके छावाहे बेकारके हो कहिके सोँचत उहिहे आकुर भारी सजाय हुइहिस। ऊ परमेश्वरके छावाहे अपने गोरालेके किच्लैले बा। और ऊ हुँकार आदर नै करत। ऊ ख्रीष्टके खुनहे पवित्र नै मानत, जोन परमेश्वर उहिहे पवित्र बनाइक लग लावा करार सुरु करलाँ। ऊ पवित्र आत्मक अपमान कर्लस, जिहिसे ऊ अनुग्रह भेटाइल रहे। <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />काकरेकी हम्रे जन्थी कि परमेश्वर कलाँ, “बदला लेना काम मोरिक हो, दण्ड मै देहम।” असिके फेन कहिगिल बा, “परमप्रभु अपन मनैनके न्याय करहीँ।” <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />जित्ती परमेश्वरके हाँथसे सजाय भेटैना एकदम डरलग्तिक बात हो।<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />सुरु-सुरु ओहोँरकिक दिनहे सम्झो, जब तुहुरे ख्रीष्टके बारेमे सुरुकचो सिखल रहो। याद करो उ समयमे डरलग्तिक दुःख रलेसे फेन तुहुरे स्थिर पलि रलो। <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />कैयोचो तुहुरे निन्दा और दुःख सहती मनैनके आघे हेल्हा हुइलो। और कैयोचो अस्तेहेँ निन्दा और दुःख भेटुइयनके संग शामिल हुइक लग तयार हुइलो। <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />कैदिनकेमे तुहुरे दया देखैलो। अपन सम्पति लुट्गिलमे फेन खुशीसे सहलो। काकरेकी तुहुरे जन्ले रहो, कि तुहुरिन्के थेन अभिन फेन परमेश्वरके वाचा कर्लक चिज बताँ। जोन आकुर धेउर मजा बा, और सदादिनके लग पलिरहिहीँ।<verse eid="HEB 10:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="HEB 10:35" />तबेकमारे तुहुरे अपन विश्वासहे ना छोरो, ताकि तुहुरे परमेश्वरसे बरवार ईनाम भेटाई सेको। <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />अब्बे तुहुरिन्हे स्थिर रहे परी, ताकि तुहुरे लगातार परमेश्वरके इच्छा अनुसार काम करे सेको। तब तुहुरे परमेश्वरके वाचा कर्लक सक्कु चिज भेटाई सेक्बो। <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />काकरेकी पवित्र शास्त्रमे लिखल बा,</para>
  <para style="q" vid="HEB 10:37">“आब एकघची पाछे अउइया पक्कै अइहीँ,</para>
  <para style="q" vid="HEB 10:37">और बेर नै करहीँ।<verse eid="HEB 10:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="HEB 10:38" />जे परमेश्वरकेमे भरोसा करी, उहिहे परमेश्वर धर्मी ठहरैहीँ,</para>
  <para style="q" vid="HEB 10:38">और ऊ सदाकालके जीवन भेटाई।</para>
  <para style="q" vid="HEB 10:38">और यदि ऊ महिन्हे अस्वीकार करी कलेसे ते</para>
  <para style="q" vid="HEB 10:38">मै उहिसे खुशी नै हुइम।”<verse eid="HEB 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 10:39" />पर हम्रे परमेश्वरहे अस्वीकार करुइया और नाश पारजउइयनमेसे नै हुइती। पर हम्रे परमेश्वरहे विश्वास करके जीवन भेटुइयनमेसे हुइती।<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s">विश्वासके उदाहरण</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />विश्वास करना कलक आशा कर्लक बातमे निर्धक्क हुइना और नै देखल बातमे पक्का भरोसा करना हो। <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />हमार पुर्खन अस्तेहेँ विश्वास करल रहिँत। यक्रेहे कारण किल परमेश्वर ओइन्से खुशी हुइलाँ कहिके देखैलाँ।<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />विश्वाससे हम्रे बुझ्थी कि संसार परमेश्वरके वचनसे सृष्टि हुइल। और हमार देखे सेक्ना चिज बनाइक लग परमेश्वर नै देखैना चिज प्रयोग करलाँ।<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />विश्वासेसे आदमके छावा हाबिल परमेश्वरहे अपन दादू कयिनसे धेउर ग्रहणयोग्य बलि चह्राइल। और वहे बलिसे परमेश्वर हाबिलहे धर्मी मनैयक रुपमे स्वीकार करलाँ। काकरेकी हाबिलके चह्रैलक बलिसे परमेश्वर खुशी हुइलाँ। और हाबिल मुगिलेसे फेन परमेश्वरहे विश्वास कर्नक बारेमे अभिन फेन ऊ हम्रिहिन्हे सिखाइत।<verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />हनोक नाउँ रहल मनैयक विश्वाससे परमेश्वर उहिहे जित्ती स्वर्गमे उठालैगिलिस। और ऊ नै मुअल, तबेकमारे केऊ फेन ओकर मुअल शरीरहे नै भेटैलिस। स्वर्गमे उठाके लैजिनासे आघे हनोक परमेश्वरहे खुशी बनाइल कहिके पवित्र शास्त्रमे लिखल बा। <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />हुँकारमे विश्वास करके किल हम्रे परमेश्वरहे खुशी बनाई सेक्थी। काकरेकी जे परमेश्वरमे आइत, ऊ परमेश्वरहे विश्वास करे परत कि परमेश्वर बताँ। और सच्चाइसे हुँकार खोजी करुइयनहे ऊ ईनाम दिहीँ।<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />विश्वासेसे नोआ नाउँ रहल मनैया कबु नै देख्लक सैलाबके बारेमे परमेश्वरसे चेतावनी भेटाके हुँकार आज्ञा पालन करके अपन परिवारहे बँचाइक लग पानी जहाज बनाइल। और परमेश्वरहे नोअक विश्वास करनासे आघे, औरे विश्वास नै करुइया मनै दोषी ठहरगिलाँ और ओइने डुबके मुगिलाँ। और नोअक विश्वासके कारण परमेश्वर उहिहे धर्मी घोषणा करलाँ।<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />विश्वाससे अब्राहाम कना मनैया परमेश्वरके बलैलक समयमे आज्ञा पालन करल। और अब्राहाम उ ठाउँमे गैल, जहाँ परमेश्वर उहिहे जाई कले रहिस। जोन ठाउँहे परमेश्वर उत्तराधिकारके रुपमे उहिहे पाछे देना रहिस। और केहोँर जैना हो कहिके बिना पता रले ऊ अपन देशहे छोरके नेगल। <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />परमेश्वरके वाचा कर्लक ठाउँमे अब्राहाम परदेशी हस तम्बू टाँगके बैठल। अब्राहामके संग ओक्रेहे छावा इसहाक और ओकर नतिया याकूब फेन परमेश्वरसे वहे वाचा भेटैलाँ, और ओस्तेहेँके तम्बू टाँगके बैठ्लाँ। <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />काकरेकी ऊ एकथो सदादिन पलिरना जग बनल शहरमे रहक लग आसरा हेरतेहे, जोन शहरहे बनुइया और निर्माण करुइया परमेश्वरे हुइताँ।<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />विश्वासेसे अब्राहामके जन्नी सारा फेन अपन उमेर ढल्कलमे लरका पैना शक्ति भेटाइल। काकरेकी वाचा करुइयाहे ऊ विश्वासयोग्य मानल रहे। <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />अब्राहाम बुह्राइल रलेसे फेन ओकर छावा इसहाक जल्मलिस। यी गुणात्मक रुपमे बह्रल आकाशके तोरैयाँ हस और समुन्दरके बालु हस ओकर बहुत्ते लरकापरका हुइलिस।<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />परमेश्वरहे विश्वास करुइया यी सक्कु मनै परमेश्वरके वाचा कर्लक चिज बिना भेटैले मुगिलाँ। पर ओइने परमेश्वरके भविष्यमे करना काम बुझके खुशी हुइलाँ। और ओइने यी फेन बुझ्लाँ कि हम्रे यी धर्तीमे परदेशी और प्रवासी हुइती। <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />असिन बात बतुइया मनै यी फरछ्वारेसे देखैथाँ कि ओइने अपन लग एकथो देश खोजतताँ, जोन देश ओइन्के हुइहिन। <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />ओइने जोन देशमेसे निकरके गैल रहिँत, उ देशके बारेमे ओइने सोँच्बे नै करलाँ। नै ते ओइन्हे घुमके जैना मौका मिल्बे नै कर्तिन। <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />पर ओइने आकुर मजा देश, अथवा एकथो स्वर्गीय देशके चाहना करथाँ। तबेकमारे ओइन्के परमेश्वर हुइतुँ कहिके परमेश्वर गर्व करिँत। काकरेकी ओइन्के लग परमेश्वर एकथो शहर तयार पारदेले बताँ।<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />विश्वासेसे अपन परीक्षा हुइबेर अब्राहाम अपन छावा इसहाकहे बलि चह्राइक लग तयार रहे। और परमेश्वर अब्राहामेहे एकथो छावा देना वाचा कर्ले रहिँत। इसहाक अब्राहामके लग एकथो विशेष छावा रहिस। तभुन फेन अपन एक्केथो छावक बलि चह्रैना ऊ तयार होगिल। <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />परमेश्वर उहिहे पैलेहेँ कले रहिँत, “मोरिक वाचा करल अनुसार इसहाकेसे तोरिक वंश आघे बह्री।” <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />काकरेकी जसिके अब्राहाम यी मानलेहल कि परमेश्वर सामर्थी बताँ, और ऊ इसहाकहे मुअलमेसे फेनदोस्रे जिवादिहीँ। अस्तेहेँके ऊ इसहाकहे मुअलमेसे फेनदोस्रे जित्ती भेटाइल।<verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />विश्वासेसे इसहाक अपन दुईथो छावा याकूब और एसावहे वाचा कर्लक आशिषके बारेमे आशीर्वाद देहल।<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />जब याकूब मुए लागल रहे तब विश्वासेसे ऊ योसेफके सक्कु छावनहे आशीर्वाद देहल। और अपन लट्ठीक सहारा लेके परमेश्वरके आराधना करल।<verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />विश्वाससे योसेफ अपने मुएबेर निर्धक्क होके इजरायलीन मिश्र देश छोरके जैहीँ कहिके कले रहे। और मिश्र देश छोरके जाई लग्हीँ ते ऊ ओइन्हे अपन हड्डी फेन संगे लैजिहो कहिके कले रहे।<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />जब मिश्र देशके रज्वा इजरायलीनके छावनहे जल्मत्तिकिल मुवादेना आदेश देहल। तब विश्वासेसे मोशा जल्मल ते ओकर दाईबाबा उहिहे तीन महिनासम नुकैले रलिस। और ओइने अपन लर्ककमे खास बात देख्के ओइने रज्वक आदेश नै मानलमे फेन नै डरैलाँ।<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />मिश्र देशके फारो रज्वक छाई मोशाहे पल्लिस। मोशा भारी होके सेकल ते विश्वासेसे ऊ नै चाहल कि मनै उहिहे राजकुमारीक छावा कहिँत। <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />एक घचिक लग पापके सुख भोग्नासे बेन परमेश्वरके मनैनके संग दुःख भोग्ना मोशा रोजल। <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />मिश्र देशके धनसम्पत्तिसे ख्रीष्टके लग निन्दित हुइना ऊ किम्ती सम्पति मानल। काकरेकी ओकर नजर भविष्यमे मिल्ना ईनाममे लागल पलिरहिस। <verse eid="HEB 11:26" /><verse number="27" style="v" sid="HEB 11:27" />रज्वक क्रोधसे नै डराके विश्वासेके कारण ऊ मिश्र देश छोरल। काकरेकी ऊ बुझगिल रहे, और जिहिहे हम्रे देखे नै सेक्थी। ऊ परमेश्वरहे देखल हस करके मोशा कतै पाछे नै घुमल। <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />विश्वासेके कारणसे मोशा इजरायल देशके मनैनहे अपन-अपन दवारीक चौखटमे बलिक खुन छिटके निस्तार-तिहुवार मन्ना आज्ञा देहल। ताकि परमेश्वरके पठैलक बरका छावा मुवैना मृत्युदूत इजरायलीनके बरका छावनहे ना मुवाए। पर मिश्र देशके मनैनके बरका छावनहे किल मुवाए।<verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />विश्वासेसे सुखल जमिनमे हस नेङ्गके इजरायल देशके मनै लाल समुन्दर नहङ्लाँ। पर मिश्र देशके मनै भर ओस्तेहेँके समुन्दर नहाँगे खोज्लाँ ते ओइने डुबके मुगिलाँ।<verse eid="HEB 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30" />इजरायल देशके मनै परमेश्वरहे विश्वास कर्लके कारण सात दिनसम यरिहो शहरके पर्खालहे चक्कर लगैलाँ। ओकर पाछे पर्खाल ढलगिल।<verse eid="HEB 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="HEB 11:31" />विश्वासेके भरमे राहाब वेश्या परमेश्वरके आज्ञा नै मनुइयनके संगे नाश नै हुइल। काकरेकी नुकके यरिहो शहरमे हेरे गैलक इजरायल देशके जासूसहुँक्रिहिनहे ऊ स्वागत करल रहे।<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />यिहिसे धेउर महिन्हे कना जरुरी नै हो। काकरेकी गिदोन, बाराक, शिमशोन, यिप्ता, दाऊद रज्वा, शमूएल हस मनै और परमेश्वरके अगमवक्तनके बारेमे कती रना महिन्हे समय नै हो। <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />विश्वासेसे ओइने राज कब्जा करलाँ, और न्यायसे राज करलाँ। परमेश्वरके वाचा कर्लक चिज फेन भेटैलाँ। सिंह फेन ओइन्हे नै खैलिन। <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />और आगी ओइन्हे नै जरैलिन। तरवाल ओइन्हे नै कट्लिन। ओइने कमजोर रहिँत, पर आब बल्गर होगिलाँ। युद्धमे वीर हुइलाँ, और ओइने अपन दुश्मननके फौजहे भगैलाँ। <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />कौनो-कौनो जन्नी मनै अपन मुअल मनैनहे मुअलमेसे फेनदोस्रे जित्ती भेटैलाँ। झेलमेसे छुटक लग अपन विश्वास नै छोरब कती बहुत मनै ते पिटाई खाइत-खाइत मुगिलाँ। पर ओइने अपन विश्वास छोरे नै चहलाँ। ताकि ओइने मुके सेकके फेनदोस्रे जित्ती होके आकुर मजा जीवन भेटाई सेकिँत। <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />गोड्गात मनैनहे अपमान सहे पर्लिन, कोर्रा खाई पर्लिन, और बन्ध्वा पाके कैदी बने पर्लिन। <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />ओइन्मेसे कौनो मनैनहे पठरालेके मार्के मुवैलिन। ओइन्हे आरालेके चिरके दुई खण्डा बनादेलिन। ओइन्हे तरवाललेके मुवैलिन। ओइने गरीब रहिँत, और ओइन्हे दुःख देलिन। और ओइन्से नै मजा व्यवहार कर्लिन। और ओइने भेँरीनके और छेग्रीनके छल्री लगाके यहोँरओहोँर नेँगित। <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />यी नै मजा संसार उ विश्वासीनके रना लायकके नै रहिन। मरुभूमि, पहाड़, गुफा और पृथ्वीक ओदारहुँक्रिहिनमे हुइती ओइन्हे घुम्ती नेगे पर्लिन।<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />परमेश्वर यी मनैनसे खुशी रहिँत, काकरेकी ओइने हुँकिन्हे भरोसा करिँत। पर नै मुअतसम ओइने परमेश्वरके वाचा कर्लक चिज नै भेटैलाँ। <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />काकरेकी परमेश्वरके थेन ओइन्के लग किल नै हो, पर हमार लग फेन एकथो मजा योजना बतिन। पर परमेश्वर ओइन्हे हमार संग मिलाके किल ओइन्हे सिद्ध बनाई चहथाँ।<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s">परमेश्वरके ताड़ना</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />हमार आँजरपाँजर यी मनैनके विश्वासके गवाही फालाफाल बा। तबेकमारे आऊ, हमार डगरमे अइना बाधा और हम्रिहिन्हे फँसैना पापहे हम्रे हटाई। और हमार आघे रलक दौड़ हम्रे लगनशील होके दौरी। <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />हमार विश्वासहे सुरु करुइया और पूरा करुइया येशूहे हम्रे हेर्ती रही, जे अपन आघे धारदेलक आनन्दक लग अपमानहे कुछु हस नै मानके क्रूसके कष्ट भोग्लाँ। और परमेश्वरके दाहिन पाँजर आदरके उँच ठाउँमे बैठल बताँ। <verse eid="HEB 12:2" /><verse number="3" style="v" sid="HEB 12:3" />तबेकमारे तुहुरे येशूक उदाहरणके बारेमे विचार करो। हुँकिन्हे घृणा करुइया पापी मनैनसे कर्लक अतरा विरोध ऊ कसिके सहलाँ, ताकि तुहुरे निराश होके हरेस ना खाऊ।<verse eid="HEB 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 12:4" />तुहुरे पापके विरोधमे कर्लक संघर्षमे, मनै तुहुरिन्हे मुवैना अवस्थासम ते सहे नै परल हो। <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />परमेश्वर अपन छाईछावन हस तुहुरिन्हे असिके उत्साहक शब्द कलक तुहुरे बिस्रागिलो।</para>
  <para style="q" vid="HEB 12:5">“हे मोरिक छावा, परमप्रभु तोहाँर कर्लक गल्ती देखैहीँ कलेसे ध्यान देऊ।</para>
  <para style="q" vid="HEB 12:5">और जब ऊ तुहिन्हे हप्कैहीँ ते हरेस ना खाऊ।<verse eid="HEB 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="HEB 12:6" />काकरेकी जिहिहे परमप्रभु प्रेम करथाँ, ओकर कर्लक गल्ती फेन देखैथाँ।</para>
  <para style="q" vid="HEB 12:6">और अपन छावक रुपमे स्वीकार कर्लक मनैनहे ऊ सजाय फेन देथाँ।”<verse eid="HEB 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />मोरिक अपने बाबा सजाय देहल कना समझके तुहुरे दुःख सहो। परमेश्वर तुहुरिन्हे अपन छावक हस व्यवहार करथाँ। काकरेकी हरेक बाबन अपन छाईछावनहे सजाय देथाँ, जब ओइने गल्ती करथाँ। <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />परमेश्वर अपन सक्कु लर्कनहे सुधरथाँ। और यदि तुहुरे परमेश्वरसे कौनो फेन सजाय नै भेटैलो कलेसे तुहुरे हुँकार खास लरका नै हुइतो। <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />और हमार शारीरिक बाबा फेन हम्रिहिन्हे सजाय देहल, और हम्रे ओकर आदर कर्ली। कलेसे हम्रे हमार स्वर्गक बाबाहे झन कतरा धेउर आदर करे परी। ताकि हुँकार सुधर्लक समयमे हुँकार कलक सुनके हम्रे सदादिनके लग जित्ती रहे सेकी। <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />काकरेकी हमार शारीरिक बाबनके ते ओइन्हे ठिक लागल अनुसार थोरिक दिन हम्रिहिन्हे सजाय देलाँ। पर परमेश्वर हमार भलाईक लग हम्रिहिन्हे सजाय देथाँ, ताकि ऊ हम्रिहिन्हे अपन हस पवित्र बनाई सेकिँत। <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />हम्रिहिन्हे सजाय मिलत ते हम्रिहिन्हे मन नै परत, बेन दुःख भेटाइल हस लागत। पर वहे दुःखसे सिखके सेकके हम्रे शान्ति भेटैथी। काकरेकी हम्रे मजा तरिकासे जीवन जिना सुरु कर्थी। <verse eid="HEB 12:11" /><verse number="12" style="v" sid="HEB 12:12" />तबेकमारे अपन मिच्छाइल हाँथ उठाऊ। लग्लगैती रहल गोरा बल्गर बनाऊ। <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />और यहोँरओहोँर हेरलसे बेन हम्रे सोझ डगरमे नेंग्ती रही। जोन डगर येशूक लग्गे लैजाइत, ताकि हमारमेसे आत्मिक रुपमे कमजोर रहल मनै डगर ना बिस्राइँत। पर ओइन्के विश्वास बल्गर होजाइन।<verse eid="HEB 12:13" /></para>
  <para style="s">परमेश्वरहे अस्वीकार नै करना चेतावनी</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />सक्कु मनैनसे शान्तिमे बैठ्ना और पवित्र हुइना कोशिस करो; पवित्रताविना कौनो मनैया परमप्रभुहे देखे नै सेकत। <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />ध्यान देऊ, कि कौनो मनैया परमेश्वरके अनुग्रह भेटैनासे असफल ना होए, ताकि तुहुरिन्के बिच्चेम समस्या ना आए। काकरेकी ओसिन मनैया तुहुरिन्हे बहुत जहनहे भ्रष्ट बनादेहत। <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />केऊ फेन व्यभिचारी या अब्राहामके नतिया एसाव हस अधर्मी ना होए। काकरेकी ऊ बरका छावा रहे। और उहिहे उत्तराधिकारी हुइना विशेष अधिकार रहिस। पर ऊ अपन जल्मत्तिक अधिकारके सम्मान नै करल। तबेकमारे ऊ अपन छुट्की भैया याकूबहे एक छाँक खानक लग अपन जल्मत्तिक अधिकार बेँचदेहल। <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />तुहुरिन्हे पतै बा, पाछेसे ऊ अपन बाबासे आशीर्वाद भेटाई खोजल, पर ऊ नै भेटाइल। आँश बहाके एसाव उ आशीर्वाद चहलेसे फेन ऊ अपन कर्लक कामहे बद्लक लग कुछु फेन करे नै सेकल।<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />तुहुरे सीनै पहाड़ हस ठाउँमे नै आइल हुइतो, जिहिहे देखे और छुए सेकजाइत। इजरायलके मनै आगीक मोँजा या गहिँर अंधार या आँधीबौखा देख्लाँ। जब परमेश्वर ओइन्हे अपन नियम कानुन देलिन। <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />ओइने तुरही फुँक्लक और परमेश्वरके आवाज सुन्लाँ। जब मनै उ आवाज सुन्लाँ ते यी फेनदोस्रे ना बोले कहिके ओइने अनुरोध करलाँ। काकरेकी ओइने गजब डरागिल रहिँत। <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />ओइने असिके कलाँ, काकरेकी परमेश्वर ओइन्हे कलक यी आज्ञा ओइने सहे नै सेक्लाँ, “यदि कौनो जानबर उ पहाड़हे छुई कलेसे उहिहे पठरालेके मारके मुवादेहो।” <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />और हुँकार दृश्य अतरा डरलग्तिक रहे, कि मोशा फेन “मै डरकमारे लग्लगाइतुँ” कहिके कहल रहे।<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />पर तुहुरे ते सियोन पहाड़मे आइल बतो, जहाँ स्वर्गक यरुशलेम बा, जोन जित्ती परमेश्वरके शहर हो। जहाँ लाखोँ स्वर्गदूतनके आनन्द-उत्सव मनैथाँ। <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />तुहुरे परमेश्वरके बरका सन्तानके सभामे आइल बतो, जेकर नाउँ स्वर्गमे लिखल बा। ओइने स्वर्गमे रहुइयन धर्मी मनैनके आत्मा हुइँत, जेने अब्बे सिद्ध बनागिल बताँ। तुहुरे अप्निहीँ परमेश्वरके थेन आइल बतो, जे सक्कु मनैनके न्यायधीश हुइँत। <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />तुहुरे येशूक थेन आइल बतो, जे परमेश्वर और हमार बिच्चेम लावा करार बहन्थाँ। तुहुरे हुँकार छिट्लक खुनके थेन आइल बतो, जोन हाबिलके खुन हस न्यायक लग चिल्लैनक सटाहा माफिक बारेमे कहत।<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />हौश्यार बैठो, और परमेश्वरके कलक मानो जे तुहुरिन्से बोलतताँ। काकरेकी इजरायल देशके मनै परमेश्वरके दण्डसे बँचे नै सेक्लाँ जब मोशा पृथ्वीमे रहल समयमे ओइन्हे चेतावनी देहल ते ओइने ओकर बात सुन्ना अस्वीकार करलाँ। यदि हम्रे स्वर्गमेसे चेतावनी देहुइया परमेश्वरके बात सुन्ना अस्वीकार करब कलेसे हम्रे फेन हुँकार दण्डसे बिरकुले बँचे नै सेकब। <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />सीनै पहाड़मेसे परमेश्वर बोल्लाँ ते धर्ती हिलगिल रहे। पर आब ते ऊ असिक कहिके वाचा कर्ले बताँ, “अभिन एकचो आकुर, धर्ती किल नै होके स्वर्गहे फेन मै हिलैबुँ।” <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />“अभिन एकचो आकुर” कना वचन यी देखाइत, कि सृष्टि हुइलक सक्कु चिज हिलाजाई और हटाजाई, ताकि हिलाई नै सेकजैना चिज स्थिर रहिँत।<verse eid="HEB 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28" />तबेकमारे हिलाई नै सेकजैना राज भेटैलक ओहोँरसे हम्रे परमेश्वरहे धन्यवाद देहे परत। तबेकमारे हम्रे भक्ति और डरसे परमेश्वरहे ग्रहणयोग्य आराधना चह्राई, जिहिसे ऊ खुशी हुइथाँ। <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />काकरेकी हमार परमेश्वर भसम परुइया आगी हस हुइताँ।<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s">अन्तिम अर्ती</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />हम्रे दादू-भैयनके और दिदी बहिन्यनके हस एकदोसर जहनहे प्रेम कर्ती रही। <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />याद कर्ले रहो, परदेशीनहे फेन पहुननके रुपमे सत्कार करे परत। काकरेकी अस्तेहेँके केऊ-केऊ बिना पता पैले स्वर्गदूतनके सत्कार कर्ले बताँ।<verse eid="HEB 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 13:3" />अप्निहीँ फेन ओइन्के संग कैदमे परल हस झेलमे रहुइयनके ख्याल करो। और अप्निहीँ दुःखमे परल हस अत्याचारमे परल मनैनहे सम्झो। जसिके कि तुहुरे ओइनेहेन्के संग दुःखमे बतो।<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />सक्कुहुनके भोज आदरणीय होए, और एकदोसर जहनमे हरदम विश्वासयोग्य पलिरहो। काकरेकी दुराचारी और व्यभिचारीनके इन्साफ परमेश्वर करथाँ।<verse eid="HEB 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5" />अपन जीवनहे धन-सम्पतिक लालचसे अल्गे धारो। तुहुरिन्के संग रहल चिजमे सन्तुष्ट बैठो। काकरेकी परमेश्वर अप्निहीँ कलेताँ,</para>
  <para style="q" vid="HEB 13:5">“मै तुहुरिन्हे कबु नै छोरम, मै तुहुरिन्हे कबु नै छोरम।”<verse eid="HEB 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 13:6" />तबेकमारे बिना डरैले हम्रे कथी,</para>
  <para style="q" vid="HEB 13:6">“प्रभु मोरिक सहायक हुइताँ, मै नै डरैम।</para>
  <para style="q" vid="HEB 13:6">मै काकरे डराऊँ, मनै महिन्हे का करे सेक्हीँ?”<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />अपन अगुवनहे सम्झहो, जेने परमेश्वरके वचन तुहुरिन्हे सुनैलाँ। ओइने अपन जीवनहे कसिके जिलाँ, और नै मुअतसम विश्वायोग्य फेन पलिरलाँ। तुहुरे फेन ओइन्के करल हस परमेश्वरकेमे विश्वास देखाऊ। <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />येशू ख्रीष्ट काल, आज और सदासर्वदा एक्के हस बताँ। ऊ कबु फेन नै बदल्थाँ।<verse eid="HEB 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 13:9" />तबेकमारे हम्रे यी सक्कु लावा और फरक शिक्षक पाछे नै लागे परत। और तुहुरिन्हे यी शिक्षा खराब डगरमे ना लैजाए। काकरेकी खैना चिजके नियमहे मानके नै हो, पर परमेश्वरके अनुग्रहसे तुहुरिन्के मन बल्गर होए। ओसिन नियम पालन करुइयनके भलाई नै हुइल हो। <verse eid="HEB 13:9" /><verse number="10" style="v" sid="HEB 13:10" />यहूदी चलन अनुसार परमेश्वरके भवनमे सेवा करुइया पुजारीनहे येशूक कर्लक बलिदानमेसे कुछु फाइदा नै हुइतिन। पर हम्रिहिन्हे फाइदा बा।<verse eid="HEB 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 13:11" />सुरुक वाचा अनुसार प्रत्येक साल प्रधान पुजारी पाप माफिक लग जानबरके खुन महापवित्र ठाउँमे नन्थाँ। पर उ जानबरीनके शरीर भर मनैनके बैठ्ना ठाउँसे बाहेर लैजाके जराजैथिन। <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />तबेकमारे येशू फेन हुँकार अपने खुनसे मनैनहे पवित्र कराइक लग यरुशलेम शहरसे बाहेर कष्ट भोग्लाँ और मुलाँ। <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />तबेकमारे हम्रे यहूदी परम्पराहे छोरके येशूहे विश्वास करे परत, और हुँकार संग अपमान सहे परत। <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />काकरेकी यी संसार हमार सदादिन पलिरना घर नै हो। पर हम्रे अइना दिनके घरक आसरा हेरती।<verse eid="HEB 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 13:15" />तबेकमारे आऊ, हम्रे अपन ढेबरलेके लगातार येशूक माध्यमसे परमेश्वरके प्रशंसा गाई। यहे हुँकार लग हमार बलिदान हो। <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />भलाई करना और अपन थेन रलक चिज जरुरीमे परल मनैनहे बाँटचुँड करना ना बिसराऊ। काकरेकी अस्ते बलिमे परमेश्वर खुशी हुइथाँ।<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />तुहुरिन्के अगुवनके कलक मानो, ओइन्के काम तुहुरिन्के जीवनके रेखदेख करना और ओइन्के सेवक बारेमे परमेश्वरहे हिसाब बुझैना हुइतिन। तुहुरे ओइन्के आज्ञा पालन करो ताकि ओइने अपन काम खुशीसे करिँत, दुःख मानके नै। यदि तुहुरे ओइन्हे दुखि बनैबो कलेसे यिहिसे तुहुरिन्हे कुछु फाइदा नै हुई।<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />हमार लग प्राथना करो। हम्रिहिन्हे पक्का पता बा कि हमार विवेक सफा बा। और हमार करना सक्कु चिजमे हम्रे परमेश्वरहे आदर देना चहथी। <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />तुहुरिन्हे मोरिक विशेष आग्रह यी बा, कि मोरिक लग प्राथना करदेऊ। और मै फेनदोस्रे तुहुरिन्के थेन झत्ते आई सेकुँ।<verse eid="HEB 13:19" /></para>
  <para style="s">आशीर्वाद</para>
  <para style="p">
    <verse number="20-21" style="v" sid="HEB 13:20-21" />और आब, शान्ति देहुइया परमेश्वरके अनुग्रह, जे प्रभु येशूहे मुअलमेसे जित्ती करैलाँ। हुँकार इच्छा पूरा करक लग तुहिन्हे चहना सक्कु चिजसे सजैहीँ। हुँकिन्हे मन परना सक्कु चिज येशू ख्रीष्टके शक्तिसे तोहाँरमे पैदा करैहीँ। येशूए भेँरीनके मजा भेँरहुवा हुइँत कना बात सदाकालके वाचक चिन्हा हुँकार खुनसे देखाइत। हुँकिनेहे सदासर्वदा महिमा मिलिन। आमेन! (यकर मतलब हुइत, अस्तेहेँ होए।)<verse eid="HEB 13:20-21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />हे मोरिक विश्वासी भैयो, मै तुहुरिन्हे अनुरोध करतुँ, कि मोरिक लिखल यी उत्साहक सन्देशहे तुहुरे सँस्सा करके सुनो। काकरेकी मै तुहुरिन्हे छोटकरीमे लिखल बतुँ।<verse eid="HEB 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 13:23" />तुहुरिन्हे यी जनाई चहथुँ, कि हमार भैया तिमोथी झेलमेसे छुट्गिल बा। यदि ऊ झत्तेहेँ आजाई कलेसे मै ओकर संग तुहुरिन्हे भेँटा करे अइबुँ।<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />तुहुरिन्के सक्कु अगुवा और परमेश्वरके सक्कु पवित्र मनैनहे नमस्कार कहिदेऊ। इटाली देशमेसे अइलक विश्वासीन तुहुरिन्हे नमस्कार पठाइल बताँ।<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />तुहुरे सक्कुहुनके संग परमेश्वरके अनुग्रह पलिरहे। आमेन! (यकर मतलब हुइत, अस्तेहेँ होए।)<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>