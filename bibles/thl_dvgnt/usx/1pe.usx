<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1PE" style="id">- DEUKHARIYA Tharu New Testament</book>
  <para style="ide">UTF-8</para>
  <para style="rem">Copyright Information: Creative Commons Attribution-ShareAlike 4.0 License</para>
  <para style="h">१ पत्रुस</para>
  <para style="toc1">पत्रुसके सुरुक चिट्ठी</para>
  <para style="toc2">१ पत्रुस</para>
  <para style="toc3">१ पत्रु.</para>
  <para style="mt1">पत्रुसके सुरुक चिट्ठी</para>
  <para style="mt2">१ पत्रुस</para>
  <para style="is">लिखुइया</para>
  <para style="ip">सुरुवातके पदसे जानमिलत कि यी चिट्ठीहे लिखुइया पत्रुस हो, “पत्रुसके ओहोँरसे जे येशू ख्रीष्टके निउतरह्या हो।” ऊ अपनहे “येशू ख्रीष्टके निउतरह्या” कहिके कहत (१ पत्रु. १:१)। उ चिट्ठीक माध्यमसे घनीघनी ख्रीष्ट येशूक दुःखके चर्चा कर्लक कारण (<char style="xt"><ref loc="1PE 2:21-24">२:२१-२४</ref>; <ref loc="1PE 3:18">३:१८</ref>; <ref loc="1PE 4:1">४:१</ref>; <ref loc="1PE 5:1">५:१</ref></char>) से जानमिलत कि दुखि सेबकके उ रुप ओकर सम्झनामे छपगिल रहिस। ऊ मर्कूसहे अपन “छावा” कहत (<char style="xt"><ref loc="1PE 5:13">५:१३</ref></char>), उ लौँदा और ओकर परिवारके उप्पर (निउ. का. १२:१२) ऊ अपन प्रेम प्रकट करत। यी सक्कु तथ्यसे फरछ्वार हुइत कि निउतरह्या पत्रुसे यी चिट्ठीक लेखक हो।</para>
  <para style="is">लिख्लक मिति और ठाउँ</para>
  <para style="ip">लगभग ई. स. ६०-६४</para>
  <para style="ip">५:१३ मे लेखक बेबिलोनके मण्डलीक ओहोँरसे नमस्कार पठाइता।</para>
  <para style="is">भेटुइया</para>
  <para style="ip">पत्रुस यी चिट्ठी एशिया प्रदेशके बहुतसे ठाउँमे बैठुइयन ख्रीष्टियन विश्वासीनहे लिखल रहे। संभव ते यी चिट्ठीहे भेटुइयनमे यहूदी और गैर-यहूदी विश्वासी दुनु रहिँत।</para>
  <para style="is">उद्देश्य</para>
  <para style="ip">पत्रुस यी चिट्ठीहे लिख्नक उद्देश्य जनाइता: विश्वासके कारण सताजउइया विश्वासीनहे उत्साहा देना। ऊ ओइन्हे पूरा रुपमे भरोसा देहे चाहतेहे कि ख्रीष्टियन विश्वासमे किल परमेश्वरके अनुग्रह मिलत। तबेकमारे यी विश्वासहे नै छोरे परत। जसिके १ पत्रु. ५:१२ मे लिखल बा, “मै छोटकरीमे लिखके तुहुरिन्हे सम्झाइल बतुँ, और यी गवाही देले बतुँ कि परमेश्वरके सच्चा अनुग्रह यहे हो, यम्नेहेँ हिर्गर होके पलिरहो।” यिहिसे फरछ्वार होजाइत कि ओकर चिट्ठीहे पह्रुइयनमे बहुत जोरसे सतावट रहिन। पत्रुसके सुरुक चिट्ठीसे जाने सेक्जाइत कि पूरा एशिया प्रदेशमे ख्रीष्टियन विश्वासीनहे सताजाइतिहिन।</para>
  <para style="iot">किताबके विभाजन</para>
  <para style="io1">१. अभिवादन <char style="ior"><ref loc="1PE 1:1-2">१:१-२</ref> </char></para>
  <para style="io1">२. परमेश्वरके अनुग्रहक लग हुँकार गुणगान <char style="ior"><ref loc="1PE 1:3-12">१:३-१२</ref> </char></para>
  <para style="io1">३. पवित्र जीवन जिना तरिका <char style="ior"><ref loc="1PE 1:13-5:12">१:१३-५:१२</ref> </char></para>
  <para style="io1">४. अन्तिम नमस्कार <char style="ior"><ref loc="1PE 5:13-14">५:१३-१४</ref> </char></para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1" />मै पत्रुस यी चिट्ठी लिखतुँ, जे येशू ख्रीष्टके निउतरह्या हुइतुँ। मै यी चिट्ठी परमेश्वरके चुनल उ मनैनहे लिखतुँ, जेने पोन्टस, गलातिया, कापाडोकिया, एशिया और बिथिनिया प्रदेशके अलग-अलग बहुत्ते शहरमे परदेशीनके हस रथाँ।<verse eid="1PE 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1PE 1:2" />परमेश्वर बाबा पैलेहेँ तुहुरिन्हे अपन मनै बनाइक लग और पवित्र आत्मक कामके माध्यमसे तुहुरिन्हे पवित्र बनाइक लग चुन्ना निर्णय करल रहिँत। परमेश्वर असिके काकरे करलाँ कलेसे ताकि तुहुरे येशू ख्रीष्टके आज्ञा पालन करो, और हुँकार खुनसे शुद्ध हुई सेको। मै प्राथना करतुँ कि परमेश्वर तुहुरिन्हे प्रशस्त मात्रामे अनुग्रह और शान्ति दिँत।<verse eid="1PE 1:2" /></para>
  <para style="s">जित्ती आशक लग परमेश्वरके प्रशंसा</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3" />हमार प्रभु येशू ख्रीष्टके बाबा और परमेश्वरहे प्रशंसा होए। परमेश्वर अपन महान कृपासे हम्रिहिन्हे लावा जीवन देले बताँ। काकरेकी परमेश्वर येशू ख्रीष्टहे मुअलमेसे फेनदोस्रे जिवैलाँ। ऊ हम्रिहिन्हे निर्धक्कसे जिअक लग सक्षम बनैले बताँ; उ कलक ऊ हम्रिहिन्हे वाचा कर्लक बात भेटैना पूरा आशा करना हो। <verse eid="1PE 1:3" /><verse number="4" style="v" sid="1PE 1:4" />परमेश्वर हमार लग तयार पर्लक सक्कु मजा चिज भेटाइक लग हम्रे आसरा हेरती। उ चिजनहे केऊ फेन नाश करे नै सेकी। ओइन्हे कुछु चिज फेन बिगारे नै सेकी। उ चिज कबु फेन पुरान या नै सुग्घुर नै हुइहीँ। परमेश्वर उ चिजनहे तुहुरिन्के लग स्वर्गमे धर्ले बताँ। <verse eid="1PE 1:4" /><verse number="5" style="v" sid="1PE 1:5" />परमेश्वर अपन बरवार शक्तिसे तुहुरिन्हे सुरक्षित धरहीँ। काकरेकी तुहुरे येशूकमे विश्वास करथो। ऊ तुहुरिन्हे अन्तिम दिनसम सुरक्षित धरहीँ। जब ख्रीष्ट फिर्ता अइहीँ, तब तुहुरे जन्बो कि परमेश्वर तुहुरिन्हे पूरा रुपमे पाप और मृत्युमेसे बँचैले बताँ। <verse eid="1PE 1:5" /><verse number="6" style="v" sid="1PE 1:6" />तुहुरे यहे सक्कु बातमे खुशी हुई परत, तभुन फेन अब्बे कुछ समयक लग तुहुरिन्हे बहुत मेरके दुःख सहे परी। <verse eid="1PE 1:6" /><verse number="7" style="v" sid="1PE 1:7" />यी समस्यनके उद्देश्य यी देखाइक लग हो कि तुहुरे जात्तिकमे परमेश्वरकेमे भरोसा करथो। येशू ख्रीष्टकेमे तुहुरिन्के विश्वास सोनसे फेन धेउर मोलके बा। जसिके नाश होजिना सोनहे आगीलेके जाँचजाइत और निखारजाइत। ओस्तेहेँके जब तुहुरिन्के विश्वास समस्यामे फेन बल्गर पलिरहत कलेसे, येशू ख्रीष्ट फिर्ता अइना दिनमे यी तुहुरिन्हे बहुत्ते प्रशंसा, महिमा और सम्मान लेके आई। <verse eid="1PE 1:7" /><verse number="8" style="v" sid="1PE 1:8" />तुहुरे येशूहे नै देख्ले हुइतो, तभुन फेन तुहुरे हुँकिन्हे प्रेम करथो। तुहुरे हुँकिन्हे अब्बे नै देख्थो। पर तुहुरे हुँकारमे विश्वास करथो। तबेकमारे तुहुरे बहुत खुशी बतो। तुहुरे कतरा खुशी बतो कहिके वर्णन करना शब्दै नै हो। <verse eid="1PE 1:8" /><verse number="9" style="v" sid="1PE 1:9" />काकरेकी परमेश्वर तुहुरिन्के प्राणहे पूरा रुपमे पापके सजायमेसे मुक्ति देहतताँ। यी तुहुरिन्के येशू ख्रीष्टमे कर्लक विश्वासके ईनाम हो।<verse eid="1PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10" />यी मुक्तिक बारेमे परमेश्वरके अगमवक्तनके आकुर धेउर जाने चाहिँत। ओइने असिके अगमवाणी करलाँ कि परमेश्वर तुहुरिन्हे बँचाइक लग तुहुरिन्के पक्षमे कसिके दयासे भरल व्यवहार करहीँ, जेकर तुहुरे लायकके फेन नै रहो। ओइने जवाफ भेटाइक लग महा ध्यानसे अध्ययन करलाँ। <verse eid="1PE 1:10" /><verse number="11" style="v" sid="1PE 1:11" />ख्रीष्टके आत्मा ओइन्केमे रहिन, और ओइन्हे कलिन कि ख्रीष्ट कसिके दुःख भोग्हीँ, और पाछेजाके ओइन्हे बरवार सम्मान मिल्हिन। तबेकमारे ओइने ख्रीष्ट के हुइहीँ कहिके पता लगैना कोशिस करलाँ। और असिन कब हुई कहिके पत्ता लगाई खोज्लाँ। <verse eid="1PE 1:11" /><verse number="12" style="v" sid="1PE 1:12" />पर परमेश्वर उ अगमवक्तनहे कलाँ कि तुहुरिन्के यी सन्देश तुहुरिन्के अपन लग नै हो, पर दोसुर जहनके लग हो। उ सन्देश येशू ख्रीष्टके बारेमे खुशीक खबर हो, जोन खुशीक खबर तुहुरे अब्बे सुनल बतो। परमेश्वर स्वर्गमेसे अपन पवित्र आत्माहे तुहुरे मनैनहे खुशीक खबर प्रचार करे सेको कहिके सहयोग करक लग पठैलाँ। यी सक्कु अतरा अचम्मक बा कि स्वर्गदूतनके फेन उत्सुकतासे यी बात हुइलक हेरतताँ।<verse eid="1PE 1:12" /></para>
  <para style="s">पवित्र होऊ</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13" />तबेकमारे तुहुरे का करतो कहिके मजासे सोँचो, और अपनहे नियन्त्रण करो। मुक्ति भेटैना आशा करो, जोन मुक्ति अनुग्रहसे आइत, जोन मुक्ति तुहुरिन्हे येशू ख्रीष्ट यी संसारमे फिर्ता अइलक दिनमे देजाई। <verse eid="1PE 1:13" /><verse number="14" style="v" sid="1PE 1:14" />अपन दाईबाबक आज्ञा पालन करुइया मजा लर्कनके हस तुहुरे फेन परमेश्वरके आज्ञा पालन करो। तुहुरे परमेश्वरके सच्चाई नै जानल समयमे अपन इच्छा अनुसार कर्ती रहल खराब काम आब तुहुरे ना करो। <verse eid="1PE 1:14" /><verse number="15" style="v" sid="1PE 1:15" />पर आब तुहुरे अपन करना हरेक बातमे पवित्र हुई परत, जसिके परमेश्वर पवित्र बताँ, जे तुहुरिन्हे अपन लरका बनाइक लग चुन्लाँ।<verse eid="1PE 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1PE 1:16" />काकरेकी पवित्र शास्त्रमे असिके लिखल बा, “तुहुरे पवित्र हुई परत, काकरेकी मै पवित्र बतुँ।”<verse eid="1PE 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 1:17" />परमेश्वर हरेक मनैनके कर्लक कामके बारेमे जन्थाँ। और ऊ हरेक जहनके बिना पक्षपात कर्ले न्याय करथाँ। जब तुहुरे परमेश्वरसे प्राथना करथो, तब तुहुरे हुँकिन्हे बाबा कथो। ओसिक हो कलेसे सदादिन हुँकिन्हे आदर करो। जबसम तुहुरे यी धर्तीमे परदेशीनके हस अपरिचित होके रबो। <verse eid="1PE 1:17" /><verse number="18" style="v" sid="1PE 1:18" />तुहुरिन्हे पता बा कि बितल समयमे तुहुरे वहे बेकार तरिकासे जीवन बिताइतोहो, जोन तरिकासे तुहुरिन्से आघेक जिअल मनै जीवन बिताइँत। पर तुहुरे उ बेकारके जीवनसे बँचागिल बतो। तुहुरे सोन अथवा चाँदी जसिन नाश होजिना चिजसे नै किनगिल हुइतो। <verse eid="1PE 1:18" /><verse number="19" style="v" sid="1PE 1:19" />पर परमेश्वर तुहुरिन्हे ख्रीष्टके बहुमूल्य खुनेलेके किन्लाँ। जे हमार पापके लग बलिक रुपमे मुलाँ। हुँकार मृत्यु हमार लग सिद्ध बलि रहे। जसिके यहूदी पुजारीनके बलि चह्रैना पथरु बिना दागके अथवा बिना दोषके सिद्ध रहिन। <verse eid="1PE 1:19" /><verse number="20" style="v" sid="1PE 1:20" />यी संसारके सृष्टि हुइनासे पैलेहेँ, येशू ख्रीष्ट मुक्तिदाता हुइहीँ कहिके परमेश्वर समयसे पैलेहेँ वाचा कर्ले रहिँत। पर येशू अन्तिम समयमे यी संसारमे तुहुरिन्हे सहायता करक लग अइलाँ।<verse eid="1PE 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1PE 1:21" />काकरेकी ख्रीष्टके कर्लक कामके कारण तुहुरे अब्बे परमेश्वरहे विश्वास करथो। और तुहुरे अपन विश्वास और आशा परमेश्वरकेमे धर्ले बतो। काकरेकी परमेश्वर ख्रीष्टहे मुअलमेसे फेनदोस्रे जिवादेलाँ, और हुँकिन्हे बरवार महिमा देलाँ।<verse eid="1PE 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22" />काकरेकी सच्चाइक पालना करके तुहुरे शुद्ध हुइल बतो। आब तुहुरे निष्कपट रुपसे अपन विश्वासी संघरियनहे प्रेम करे परी। एकदोसर जहनहे निष्कपटतासे अपन जिउ-ज्यानसे प्रेम कर्ती रहो। <verse eid="1PE 1:22" /><verse number="23" style="v" sid="1PE 1:23" />काकरेकी तुहुरे परमेश्वरसे लावा जीवन भेटैले बतो। तुहुरे यी जीवन नाश होजिना चिजसे नै भेटैले हुइतो, पर हरदम पलिरना चिजसे भेटैले बतो। हम्रे यी लावा जीवन जित्ती और सदाकालके परमेश्वरके वचनसे भेटाइल बती। <verse eid="1PE 1:23" /><verse number="24" style="v" sid="1PE 1:24" />काकरेकी पवित्र शास्त्रमे असिके लिखल बा,</para>
  <para style="q" vid="1PE 1:24">“सक्कु मनै घाँस जसिन हुइँत,</para>
  <para style="q" vid="1PE 1:24">और ओइन्के सक्कु गौरव घाँसक फूला हस हुइतिन।</para>
  <para style="q" vid="1PE 1:24">घाँस सुख जाई,</para>
  <para style="q" vid="1PE 1:24">और फूला भुइयाँमे झरजाई,<verse eid="1PE 1:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="1PE 1:25" />पर प्रभुक वचन सदासर्वदा पलिरहत।”</para>
  <para style="p" vid="1PE 1:25">और तुहुरिन्हे प्रचार करगिलक खुशीक खबरके वचन यहे हो।<verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />तबेकमारे सक्कु मेरिक खराब काम छोरदेऊ। दोसुर जहनहे धोखा ना देऊ। कपटी ना बनो। दोसुर जहनके बिह्रे ना मुओ। दोसुर जहनके विरोधमे नै मजा बात ना बत्वाऊ। <verse eid="1PE 2:1" /><verse number="2" style="v" sid="1PE 2:2" />मै तुहुरिन्हे भर्खर लावा जल्मलक लरकनसे तुलना करथुँ। एकथो लावा जल्मलक लरकाहे बल्गर हुइती बह्रक लग रोट्दिन उहिहे दाईक दूध चहथिस। ओस्तेहेँके तुहुरिन्हे फेन परमेश्वरके वचन सुन्ना इच्छा हुई परत। ताकि परमेश्वरकेमे तुहुरिन्के विश्वास पक्का होए। और परमेश्वर तुहुरिन्हे बँचाई सेकिँत। <verse eid="1PE 2:2" /><verse number="3" style="v" sid="1PE 2:3" />काकरेकी जसिके पवित्र शास्त्रमे लिखल बा, “तुहुरे अनुभव कर्ले बतो कि प्रभु भलाई करथाँ।<verse eid="1PE 2:3" /></para>
  <para style="p">
    <verse number="4-5" style="v" sid="1PE 2:4-5" />तुहुरे प्रभु येशूक थेन आइल बतो। ऊ एकथो भवनके जग बैठैलक मूल ढुंगक हस बताँ। पर येशू जित्ती ढुंगा हुइँत। हुँकिन्हे बहुत्ते मनै अस्वीकार कर्लिन। पर परमेश्वर हुँकिन्हे चुन्लाँ। और हुँकिन्हे बहुमूल्य बनैलाँ। और जसिके मनै ढुंगालेके भवन बनैथाँ, ओस्तेहेँके परमेश्वर फेन तुहुरिन्हे एकथो समूहमे जमा करैले बताँ। जेम्ने परमेश्वरके आत्मा रथिन, ताकि तुहुरे पुजारीनके हस हुँकार सेवा करो, जेने बलिदान चह्रैथाँ। और ओइने असिन काम करथाँ, जोन काम परमेश्वरहे खुशी बनैथिन। असिन काम तुहुरे यहे कारणसे कर्बो जोन काम येशू ख्रीष्ट कर्ले बताँ।”<verse eid="1PE 2:4-5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 2:6" />काकरेकी पवित्र शास्त्रमे परमेश्वर असिके कले बताँ,</para>
  <para style="q" vid="1PE 2:6">“हेरो, मै सियोन शहरमे कोन्वक ढुंगा हस किहुहे धारतुँ।</para>
  <para style="q" vid="1PE 2:6">ऊ जग बैठाइक लग रोजगिलक एकथो बहुमूल्य ढुंगा हस हुइताँ,</para>
  <para style="q" vid="1PE 2:6">जे हुँकारमे विश्वास करी ओकर लाज नै हुइहिस।”<verse eid="1PE 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 2:7" />तुहुरे येशू ख्रीष्टमे विश्वास करुइयनके लग ते यी ढुंगा बहुत किम्ती बा। पर हुँकारमे विश्वास नै करुइया मनैनके लग पवित्र शास्त्र असिके कहत,</para>
  <para style="q" vid="1PE 2:7">“जोन ढुंगाहे भवन बनुइयन काम लगैनासे अस्वीकार करदेलाँ,</para>
  <para style="q" vid="1PE 2:7">वहे ढुंगा भवन बनाईबेर बहुमूल्य बनल बा।”<verse eid="1PE 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 2:8" />और फेनदोस्रे पवित्र शास्त्रमे असिके फेन लिखल बा,</para>
  <para style="q" vid="1PE 2:8">“यी ढुंगा मनैनहे भुइयाँमे गिराई,</para>
  <para style="q" vid="1PE 2:8">यी एकथो चट्टान हो, जे ओइन्हे गिराई।”</para>
  <para style="q" vid="1PE 2:8">ओइने असिके गिरथाँ, काकरेकी ओइने परमेश्वरके सन्देशहे मन्नासे अस्वीकार करथाँ।</para>
  <para style="q" vid="1PE 2:8">परमेश्वर ओइन्हे अस्तेहेँ हुइन कना योजना बनैले बताँ।<verse eid="1PE 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9" />पर तुहुरे ओसिन नै हुइतो, काकरेकी तुहुरे परमेश्वरके रोजल मनै हुइतो। तुहुरे उ परमेश्वरके पुजारी हुइतो, जे एकथो रज्वा हुइँत। तुहुरे परमेश्वरके सेवा करक लग समर्पित हुइलक मनै और परमेश्वरके नेजी जनता हुइतो। ऊ तुहुरिन्हे अंधारमेसे अपन अचम्मक ओजरारमे रोजल बताँ, ताकि तुहुरे परमेश्वरके अचम्मक कामके घोषणा करे सेको।<verse eid="1PE 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 2:10" />एकचो तुहुरे परमेश्वरके जनता नै रहो, पर आब तुहुरे परमेश्वरके जनता हुइल बतो। एकचो तुहुरे परमेश्वरके दया नै भेटाइल रहो, पर आब तुहुरे यिहिहे जन्थो। काकरेकी परमेश्वर पैलेहेँ तुहुरिन्हे अपन दया देखा सेकल बताँ।<verse eid="1PE 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11" />हे मोरिक प्रिय संघरियन, तुहुरे यी संसारमे विदेशीनके हस और प्रवासीनके हस बैठल बतो। मै तुहुरिन्हे अनुरोध करतुँ कि शरीरके उ सक्कु खराब इच्छासे दूरे बैठो। काकरेकी असिन चाहना हरदम तुहुरिन्के प्राणके विरोधमे रहत। <verse eid="1PE 2:11" /><verse number="12" style="v" sid="1PE 2:12" />परमेश्वरहे विश्वास नै करुइया मनै तुहुरिन्के आसपासे रथाँ, और तुहुरे गलत करतो कहिके कहे सेक्थाँ। तुहुरे असिन मजा जीवन बिताऊ कि ओइने तुहुरिन्के कर्लक मजा काम देखिँत, और ख्रीष्ट फिर्ता अइना दिनमे परमेश्वरके महिमा करिँत।<verse eid="1PE 2:12" /></para>
  <para style="s">शासक और मलिक्वनके अधीनता</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13" />हम्रे उ सक्कु शासकहुँक्रिहिनके अधिनमे बैठे परत, जेनहे मनै नियुक्त कर्ले रथाँ। काकरेकी उ प्रभुक इच्छा हो। रज्वक अधिनमे बैठो, जे सक्कुहुनके उप्पर शासन करत। <verse eid="1PE 2:13" /><verse number="14" style="v" sid="1PE 2:14" />हाकिमनके फेन अधिनमे बैठो। काकरेकी गलत काम करुइया मनैनहे सजाय देना और सही काम करुइयनहे प्रशंसा करना अधिकार रज्वा हाकिमनहे देले रथिन। <verse eid="1PE 2:14" /><verse number="15" style="v" sid="1PE 2:15" />तुहुरे मजा काम करो कना परमेश्वर चहथाँ। ताकि तुहुरे गलत आरोप लगुइया उ मूर्ख मनैनहे रोके सेको, जेने परमेश्वरहे नै चिहिन्थाँ। <verse eid="1PE 2:15" /><verse number="16" style="v" sid="1PE 2:16" />तुहुरिन्के चाहल अनुसार काम करनासे तुहुरिन्हे रोके सेकुइया केऊ नै हो। काकरेकी तुहुरे हमार प्रभु येशू ख्रीष्टके माध्यमसे पैलेहेँ स्वतन्त्र होसेकल बतो। पर खराब काम करक लग यिहिहे बहाना ना बनैहो। बेन तुहुरे अपन कामसे यी देखाई परत कि तुहुरे जात्तिके परमेश्वरके सेबक हुइतो। <verse eid="1PE 2:16" /><verse number="17" style="v" sid="1PE 2:17" />सक्कु मनैनहे आदर करो। विश्वासी भैया बाबुनहे प्रेम करो। परमेश्वरसे डराऊ। रज्वक आदर करो।<verse eid="1PE 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18" />तुहुरे नोकरहुँक्रे, जेने दोसुर जहनके घरेम काम करथो और विश्वासी फेन हुइतो। तुहुरे अपन मलिक्वनके आज्ञा पालन करे परत, और हरदम ओइन्के आदर करे परत। तुहुरे सक्कु मेरिक मलिक्वनहे आदर करे परत। चाहे ओइने दयालु और व्यवहारिक रहिँत या ना रहिँत। <verse eid="1PE 2:18" /><verse number="19" style="v" sid="1PE 2:19" />काकरेकी परमेश्वर हम्रिहिन्से खुशी हुइथाँ, जब हम्रे सँस्सा करके उ दुःखहे सहलेथी, जोन दुःख हम्रिहिन्हे नै मिलेपरना हो। काकरेकी हम्रे परमेश्वरके बारेमे सोँच्थी। <verse eid="1PE 2:19" /><verse number="20" style="v" sid="1PE 2:20" />पर यदि तुहुरे गलत काम करके पिटाई खैथो कलेसे तुहुरे अपन सजाय भोगेबेर धिरजता देखैथो कलेसे ओम्ने तुहुरिन्हे कुछु प्रशंसा नै मिली। पर यदि तुहुरे मजा कामके लग दुःख भोगेबेर तुहुरे धिरजता देखैथो कलेसे परमेश्वर यिहिसे खुशी हुइथाँ। <verse eid="1PE 2:20" /><verse number="21" style="v" sid="1PE 2:21" />परमेश्वर तुहुरिन्हे बलैना एकथो कारण यी हो कि तुहुरिन्हे हुँकार लग दुःख भोगे परी। ख्रीष्ट, जे तुहुरिन्के लग दुःख भोग्लाँ, ऊ तुहुरिन्के लग एकथो उदाहरण हुइताँ। तबेकमारे तुहुरे फेन हुँकार कर्लक कामके अनुशरण करे परत।<verse eid="1PE 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="1PE 2:22" />पवित्र शास्त्रमे असिके लिखल बा, “ऊ कबु पाप नै करलाँ,</para>
  <para style="q" vid="1PE 2:22">और ऊ कबु फेन कौनो झूँट नै बोल्लाँ।”<verse eid="1PE 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1PE 2:23" />जब मनै येशूक बेज्जत करलाँ, तब ऊ ओइन्के बेज्जत नै करलाँ। जब मनै हुँकिन्हे दुःख देलाँ, तब ओकर बदलामे ऊ ओइन्हे चोट पुगैना कोशिस फेन नै करलाँ। बेन यकर बद्लामे येशू सहयोगके लग परमेश्वरकेमे भरोसा करलाँ। हुँकिन्हे पता रहिन कि परमेश्वर हरदम मनैनके न्याय सही तरिकासे करथाँ। <verse eid="1PE 2:23" /><verse number="24" style="v" sid="1PE 2:24" />जब ख्रीष्ट मुलाँ, ऊ क्रूसमे हमार पापके लग अपन शरीरमे दण्ड भोग्लाँ। ऊ असिन यहे कारणसे करलाँ ताकि हम्रे पाप करना छोरके धर्मी होके जीवन जिना सुरु करे सेकी। और हुँकार सहलक चोटसे हम्रे चोखाइल बती। <verse eid="1PE 2:24" /><verse number="25" style="v" sid="1PE 2:25" />पहिले तुहुरे डगर भुलाइल भेँरीनके हस रहो। पर आब तुहुरे अपन आत्मक भेँरहुवा और सुरक्षा करुइया ख्रीष्टके थेन घुमल बतो।<verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="s">थारु और जन्नी</para>
  <para style="p">
    <verse number="1-2" style="v" sid="1PE 3:1-2" />हे जन्नी मनै, तुहुरे फेन अपन थरवक अधिनमे रहो। ताकि यदि तुहुरिन्मेसे केक्रो थरवा परमेश्वरके वचन विश्वास करनासे अस्वीकार करत कलेसे तुहुरे कुछु नै कलेसे फेन तुहुरिन्के व्यवहार देख्के ओइने परमेश्वरहे विश्वास करे सेक्थाँ। जब ओइने तुहुरिन्के शुद्ध और प्रेम भरल व्यवहार देख्हीँ। तब ओइने ख्रीष्टमे विश्वास करहीँ। <verse eid="1PE 3:1-2" /><verse number="3" style="v" sid="1PE 3:3" />अपनहे सुग्घुर बनाइक लग अपन भुट्लामे रहर लग्तिक झोँटी ना बनाऊ। और सोन, मोती और बहुत महिँगा लुग्गा लगाके दोसुर जहनके ध्यान अपन ओहोँर ना तानो। <verse eid="1PE 3:3" /><verse number="4" style="v" sid="1PE 3:4" />तुहुरिन्के भित्री मनमे रहल बात तुहुरिन्हे सुग्घुर बनाइत। उ कलक तुहुरिन्के नरम और शान्त व्यवहार हो, जोन परमेश्वरके लग बहुत किम्ती बा। <verse eid="1PE 3:4" /><verse number="5" style="v" sid="1PE 3:5" />काकरेकी बहुत पहिलेक जन्नी मनैनके व्यवहार फेन अस्तेहेँ रहिन। ओइन्के जीवन पवित्र रहिन, और ओइने परमेश्वरहे विश्वास और आशा करिँत। उ जन्नी मनै सुग्घुर हुइलाँ, काकरेकी ओइने अपन थरवक अधिनमे बैठिँत। <verse eid="1PE 3:5" /><verse number="6" style="v" sid="1PE 3:6" />सारक हस, जे अब्राहामहे स्वामी कहिके ओकर आज्ञा पालन करे। उ कलक यदि तुहुरे दोसुर जहनके लग मजा करबो और कौनो बातमे नै डरैबो कलेसे तुहुरे सारक छाईन हस हुइतो।<verse eid="1PE 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7" />हे थारु मनै, ओस्तेहेँके तुहुरे अपन-अपन जन्नीनसे मिलके बैठो। और कसिके ओइन्हे सहयोग करना कहिके विचार करो। और ओइने तुहुरिन्से कमजोर बताँ कहिके तुहुरे याद करो। तबेकमारे तुहुरे ओइन्हे सम्मान करे परत। काकरेकी तुहुरे दुनु जाने परमेश्वरके देहल वहे अनुग्रहक साझा हकदार बतो, जोन अनुग्रह सदाकालके जीवन हो। तुहुरे अस्तेहेँके करहो ताकि जब तुहुरे हुँकिन्से प्राथना करे जैबो ते परमेश्वर तुहुरिन्के प्राथना सुनिँत।<verse eid="1PE 3:7" /></para>
  <para style="s">मजा काम करेबेर अइना दुःख</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />अन्तिममे विश्वासी भैयो, मै तुहुरिन्हे यी कहे चाहतुँ, कि तुहुरे एकतामे बैठो, एकदोसर जहनके लग सोँचो। एक्के परिवारके सदस्य हस एकदोसर जहनहे प्रेम करो। एकदोसर जहनहे दया देखाऊ, और एकदोसर जहनसे नम्र होऊ।<verse eid="1PE 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 3:9" />खराबीक बदला खराबी नै करुइया अथवा बेज्जतके बदला बेज्जत नै करुइया, बेन ओकर बदलामे आशिष देहुइया बनो। तुहुरे ओइन्के लग आशिष मांगदेहे परत। काकरेकी तुहुरे परमेश्वरसे आशिष देहक लग बलागिल बतो, ताकि तुहुरे परमेश्वरसे आशिष भेटाई सेको। <verse eid="1PE 3:9" /><verse number="10" style="v" sid="1PE 3:10" />काकरेकी पवित्र शास्त्रमे असिके लिखल बा,</para>
  <para style="q" vid="1PE 3:10">“यदि कौनो मनैया अपन जीवनके आनन्द लेहे चाहत,</para>
  <para style="q" vid="1PE 3:10">और मजा दिन देख्ना इच्छा करत कलेसे,</para>
  <para style="q" vid="1PE 3:10">उहिहे खराब काम करनासे हौश्यार रहे परत।</para>
  <para style="q" vid="1PE 3:10">और उहिहे उ बात बोल्ना छोरे परत, जोन सच्चा नै हो।<verse eid="1PE 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="1PE 3:11" />उहिहे खराब काम करना छोरे परत। बेन उहिहे मजा काम करे परत।</para>
  <para style="q" vid="1PE 3:11">दोसुर जहनके संग शान्तिमे रहक लग कर्रा मेहनत करो।<verse eid="1PE 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="1PE 3:12" />काकरेकी प्रभु मजा काम करुइया मनैनहे हेरथाँ।</para>
  <para style="q" vid="1PE 3:12">और ऊ ओइन्के प्राथना सुनक लग हरदम तयार रथाँ।</para>
  <para style="q" vid="1PE 3:12">पर परमेश्वर नै मजा काम करुइया मनैनके विरोधमे काम करथाँ।”<verse eid="1PE 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13" />यदि तुहुरे सदादिन मजा काम करक लग कोशिस करथो कलेसे पक्कै फेन तुहुरिन्हे केऊ चोट पुगाई नै सेकी। <verse eid="1PE 3:13" /><verse number="14" style="v" sid="1PE 3:14" />पर यदि तुहुरिन्हे मजा काम कर्लक कारण दुःख भोगे परता कलेसे परमेश्वर तुहुरिन्हे आशिष दिहीँ। तुहुरे यशैया अगमवक्तक लिखल हस करो: “तुहुरिन्हे धम्की देहुइया मनैनसे ना डराऊ, और मनै का करहीँ कना बातमे चिन्ता ना करो।” <verse eid="1PE 3:14" /><verse number="15" style="v" sid="1PE 3:15" />बेन तुहुरे ख्रीष्टहे तुहुरिन्के जीवनके प्रभुक रुपमे आराधना करो। और यदि हम्रे सक्कु विश्वासीन साझेदार हुइना आशक बारेमे केऊ पुँछल कलेसे उहिहे व्याख्या करक लग हरदम तयार रहो। <verse eid="1PE 3:15" /><verse number="16" style="v" sid="1PE 3:16" />पर यिहिहे नम्र और आदरसे भरल तरिकासे करो। सदादिन ज्या मजा बा, वहे करो। जब तुहुरिन्के विरोधमे खराब बात करुइया मनै तुहुरिन्के ख्रीष्टके संगक सम्बन्धक कारण तुहुरिन्के मजा व्यवहार देख्हीँ, तब ओइने लाजमे परजिहीँ। <verse eid="1PE 3:16" /><verse number="17" style="v" sid="1PE 3:17" />यदि हमार मजा कामके कारणसे हम्रे दुःख भोग्थी, और यी हमार लग परमेश्वरके इच्छा हो कलेसे यी एकदम मजा हो। खराब काम करके दुःख उठाइलसे ते यहे मजा बा। <verse eid="1PE 3:17" /><verse number="18" style="v" sid="1PE 3:18" />मै असिके यहे कारणसे कहतुँ, काकरेकी हमार पापके कारण ख्रीष्ट दुःख भोग्लाँ, और मुलाँ। ऊ एकचो किल मुलाँ और यिहिहे दोहरैना जरुरी नै हो। ऊ एकथो धर्मी मनैया रहिँत, जे पापी मनैनके लग मुलाँ ताकि ऊ हम्रिहिन्हे परमेश्वरके लग्गे नाने सेकिँत। ओइने हुँकार शरीरहे मुवैलाँ, पर हुँकार आत्मा जित्ती बतिन। <verse eid="1PE 3:18" /><verse number="19" style="v" sid="1PE 3:19" />तब हुँकार आत्मा गैलिन, और परमेश्वरके कैद कर्लक आत्मनहे उ ठाउँमे खुशीक खबर प्रचार करलाँ, जहाँ मुअल मनैनके आत्मा बतिन। <verse eid="1PE 3:19" /><verse number="20" style="v" sid="1PE 3:20" />यने वहे आत्मा रहिँत, जेने बहुत समय पहिले परमेश्वरके आज्ञा पालन नै करलाँ। जब नोआ अपन पानी जहाज बनाइतेहे, तब मनै अपन पाप करना छोरके परमेश्वरके ओहोँर घुमके अइथाँ कि कहिके परमेश्वर धिरजतासे ओइन्के आसरा हेरतिहिँत। पर आठ जाने किल उ डरलग्तिक सैलाबसे बँचागिलाँ। <verse eid="1PE 3:20" /><verse number="21" style="v" sid="1PE 3:21" />जब हम्रे डुब्कि लेथी तब पुरान समयमे ओइन्के मुक्ति अब्बे हमार मुक्तिक एकथो उदाहरण हो। हमार डुब्कि लेना पानी हमार शरीरमेसे फुहर नै हटाइत। पर ओकर संकेत यी हो कि हम्रे परमेश्वरसे माफी मंग्ले बती, ताकि हमार मन आबसे ना घब्राए। हम्रे माफी भेटाई सेक्थी, काकरेकी येशू ख्रीष्ट मुअलमेसे फेनदोस्रे जित्ती होगिलाँ।<verse eid="1PE 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 3:22" />और ऊ स्वर्गमे चलगिलाँ। आब ऊ वहाँ परमेश्वरके दाहिन पाँजर सक्कुहुनसे खास ठाउँमे बैठल बताँ। और ऊ सक्कु स्वर्गदूत और सक्कु अधिकारीनके और शक्तिहुँक्रिहिनके उप्पर राज करथाँ।<verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="s">परमेश्वरके लग जिना</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />तबेकमारे ख्रीष्ट अपन शरीरमे रहलमे दुःख भोग्लाँ, और तुहुरे फेन हुँकार हस विचार धारके दुःख भोग्ना तयार हुई परत। काकरेकी यदि तुहुरे ख्रीष्टके लग दुःख भोग्ना इच्छा करथो कलेसे तुहुरे पाप करे छोरना निर्णय कर्ले बतो। <verse eid="1PE 4:1" /><verse number="2" style="v" sid="1PE 4:2" />परिणामके रुपमे उ मनैया यी धर्तीमे अपन बाँकी जीवन अपने पापसे भरल इच्छाहे पूरा करके नै जिई। पर ऊ परमेश्वरके चाहल काम करी। <verse eid="1PE 4:2" /><verse number="3" style="v" sid="1PE 4:3" />गैल समयमे तुहुरे अविश्वासीनहे मन परना काम करके बहुत्ते समय बर्बाद कर सेक्लो। तुहुरिन्के जीवन अनैतिकता, अभिलाषा, खाना, जाँर-दारु पिके, मौजमज्जामे और मूर्तिहे पुज्ती बितल, जिहिहे परमेश्वर घृणा करथाँ। <verse eid="1PE 4:3" /><verse number="4" style="v" sid="1PE 4:4" />तबेकमारे तुहुरिन्के पुरान संघरियन अचम्म मन्थाँ, कि जब तुहुरे ओइन्के खराब काममे शामिल नै हुइथो। तबेकमारे ओइने तुहुरिन्के बारेमे नै मजा बात बत्वैथाँ। <verse eid="1PE 4:4" /><verse number="5" style="v" sid="1PE 4:5" />पर एक दिन पक्कै ओइन्हे फेन परमेश्वरके आघे न्यायक लग ठरह्याई पर्हिन। और परमेश्वर उ सक्कुहुनहे धर्तीमे कर्लक कामके बारेमे पुँछ्हीँ। परमेश्वर मुअल और जित्ती दुनु मनैनके न्याय करहीँ। <verse eid="1PE 4:5" /><verse number="6" style="v" sid="1PE 4:6" />तबेकमारे मुअल मनै फेन खुशीक खबर सुन्लाँ। ओइन्के शरीर दोसुर मनैनके हस मुए पर्लिन। पर आब ओइने सदामान परमेश्वरके संग आत्मामे जिअतताँ। <verse eid="1PE 4:6" /><verse number="7" style="v" sid="1PE 4:7" />सक्कु बातके अन्त्य लग्गेहेँ आगिल बा। तबेकमारे तुहुरे एकदम फरछ्वार रुपमे सोँचो, और अपनहे नियन्त्रण करो, ताकि तुहुरे प्राथना करे सेको। <verse eid="1PE 4:7" /><verse number="8" style="v" sid="1PE 4:8" />सक्कुहुनसे खास बात यहे हो कि तुहुरे एकदोसर जहनहे प्रेम करो। काकरेकी यदि तुहुरे मनैनहे प्रेम कर्बो कलेसे तुहुरे हरदम ओइन्के कर्लक कौनो फेन पापी कामहे माफ करक लग तयार रबो। <verse eid="1PE 4:8" /><verse number="9" style="v" sid="1PE 4:9" />मनैनहे तुहुरे अपन घरेमे कौनो गुनासो बिना कर्ले स्वागत करो। <verse eid="1PE 4:9" /><verse number="10" style="v" sid="1PE 4:10" />हरेक मनैनहे परमेश्वर वरदान देले बताँ। और ओइने उ वरदान दोसुर जहनहे सहयोग करना काममे प्रयोग करे परत। परमेश्वरके मजा सेबक बनो, और परमेश्वरके देहल बरदानहे मजासे प्रयोग करो। <verse eid="1PE 4:10" /><verse number="11" style="v" sid="1PE 4:11" />उदाहरणके लग, यदि तुहुरिन्के थेन प्रचार करना वरदान बा कलेसे परमेश्वरके वचन प्रचार करे परत। यदि तुहुरिन्के थेन दोसुर मनैनहे सहयोग करना वरदान बा कलेसे परमेश्वर तुहुरिन्हे देलक क्षमता अनुसार तुहुरे सहयोग करो। तब तुहुरे ज्या चिज फेन करबो, उहिसे येशू ख्रीष्टके माध्यमसे परमेश्वरहे महिमा मिल्हिन। सक्कु महिमा और शक्ति हरदम हुँकारे हो! आमेन! (यकर मतलब हुइत, अस्तेहेँ होए।)<verse eid="1PE 4:11" /></para>
  <para style="s">विश्वासी हुइलकमे दुःख उठैना</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />हे मोरिक प्रिय संघरियन, तुहुरिन्के भोग्ती रहल दुःख लग्ना बातके बारेमे अचम्म ना मानो। काकरेकी तुहुरे ख्रीष्टके हुइतो। पर यी बात यी देखाइक लग हुइता कि तुहुरे जात्तिकमे परमेश्वरहे विश्वास करथो कि नै करथो। तबेकमारे असिके ना सोँच्हो कि तुहुरिन्के संग कुछु अचम्म हुइता। <verse eid="1PE 4:12" /><verse number="13" style="v" sid="1PE 4:13" />यकर बारेमे तुहुरे खुशी होऊ, काकरेकी तुहुरे ख्रीष्टके भोग्लक दुःखमे शामिल हुइल बतो। तबेकमारे जब ख्रीष्ट सक्कु मनैनहे अपन महिमा देखाइक लग फेनदोस्रे अइहीँ, तब तुहुरिन्के आनन्द जात्तिकमे बरवार हुई। <verse eid="1PE 4:13" /><verse number="14" style="v" sid="1PE 4:14" />यदि ख्रीष्टके नाउँमे तुहुरिन्के बेज्जत हुई कलेसे तुहुरे धन्यके हुइतो। काकरेकी महिमित परमेश्वरके आत्मा तुहुरिन्केमे बास कर्थिन। <verse eid="1PE 4:14" /><verse number="15" style="v" sid="1PE 4:15" />पर तुहुरिन्मेसे केऊ फेन हत्यारा, या चोर, या खराबी करुइया, या दोसुर जहनके मामलामे हाँथ दरुइयनके हस दुःख ना भोगो। <verse eid="1PE 4:15" /><verse number="16" style="v" sid="1PE 4:16" />पर केऊ ख्रीष्टियन हुइलक कारण दुःख भोगत कलेसे ऊ लाज ना माने। पर विश्वासी हुइलक कारण ऊ परमेश्वरहे धन्यवाद देहे। <verse eid="1PE 4:16" /><verse number="17" style="v" sid="1PE 4:17" />काकरेकी न्याय परमेश्वरके परिवारमेसे सुरु हुइना समय आगिल बा। काकरेकी ऊ सुरुमे हम्रे विश्वासीनके न्याय करहीँ। और तुहुरे उ डरलग्तिक चिजके बारेमे सोँचो जोन उ मनैनहे हुइहिन, जेने परमेश्वरके ओहोँरसे अइना खुशीक खबरहे नै मन्थाँ।<verse eid="1PE 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 4:18" />जसिके पवित्र शास्त्रमे लिखल बा,</para>
  <para style="q" vid="1PE 4:18">“मजा मनैनहे फेन आघे दुःख भोगे पर्थिन, और ओकर पाछे किल उहिहे मुक्ति मिल्थिस। कलेसे,</para>
  <para style="q" vid="1PE 4:18">तबेकमारे अधर्मी और पापी मनैनहे पक्कै फेन परमेश्वरसे बहुत कर्रा दण्ड भोगे पर्हिन!”<verse eid="1PE 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1PE 4:19" />तबेकमारे परमेश्वरके इच्छा अनुसार जब केऊ दुःख भोगत, और जीवन देहुइया परमेश्वरहे भरोसा कर्ले पलिरहत। तब ओकर लग परमेश्वर हरदम अपन वाचा कर्लक बात पूरा करथाँ। तबेकमारे तुहुरे मजा काम कर्ती रहो।<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="s">अगुवनहे और जवानहुँक्रिहिन्हे</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />मै तुहुरे वहाँ रहल मण्डलीक अगुवनहे कुछु कहे चाहतुँ, काकरेकी मै फेन तुहुरिनेके हस मण्डलीक एकथो अगुवा हुइतुँ। मै अप्निहीँ ख्रीष्टके भेटैलक दुःख बहुत पैलेहेँ देखल बतुँ। जब ख्रीष्ट फेनदोस्रे फिर्ता अइहीँ, मै फेन हुँकार महिमामे साझेदार हुइबुँ। आब मै तुहुरिन्हे अनुरोध करतुँ, <verse eid="1PE 5:1" /><verse number="2" style="v" sid="1PE 5:2" />जसिके एकथो भेँरहुवा अपन भेँरीनके रेखदेख करत। ओस्तेहेँके तुहुरे फेन सक्कु मनैनके रेखदेख करे परत, जेनहे परमेश्वर तुहुरिन्के जिम्मामे देले बताँ। यी चिज तुहुरे अपने मनसे करो, काकरेकी तुहुरे अस्तेहेँ करो कना परमेश्वर चहथाँ। यी कामहे तुहुरे बलजब्रे ना करो। यी कामहे पैँसा भेटाइक लग फेन ना करो। पर परमेश्वर और मनैनके सेवा करना इच्छासे करो। <verse eid="1PE 5:2" /><verse number="3" style="v" sid="1PE 5:3" />और शासकहुँक्रिहिनके हस तुहुरे ओइन्के उप्पर हुकुम ना चलाऊ, जोन मनैनहे रेखदेख करक लग परमेश्वर तुहुरिन्हे देले बताँ। पर ओइन्के लग एकथो मजा नमूना बनो। <verse eid="1PE 5:3" /><verse number="4" style="v" sid="1PE 5:4" />जब येशू ख्रीष्ट फिर्ता अइहीँ, जे हमार मुख्य भेँरहुवा हुइँत। तब तुहुरिन्हे एकथो सुग्घुर मुकुट दिहीँ, जेकर चमक कबु कम नै हुई।<verse eid="1PE 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5" />ओस्तेहेँके हे जवानो, मण्डलीक अगुवनके अधिनमे बैठो। तुहुरे सक्कु जाने नम्रतासे एकदोसर जहनहे सहयोग करे परत। काकरेकी पवित्र शास्त्रमे असिके लिखल बा,</para>
  <para style="q" vid="1PE 5:5">“परमेश्वर घमण्डी मनैनके विरोध करथाँ,</para>
  <para style="q" vid="1PE 5:5">पर नम्र मनैनहे ऊ अनुग्रह करथाँ।”<verse eid="1PE 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 5:6" />तबेकमारे परमेश्वरके आघे अपनहे नम्र बनाऊ, जे सुरक्षा देहक लग बल्गर बताँ। ताकि ऊ ठिक समयमे तुहुरिन्हे सम्मान दिँत। <verse eid="1PE 5:6" /><verse number="7" style="v" sid="1PE 5:7" />परमेश्वर तुहुरिन्के वास्ता करथाँ, तबेकमारे अपन सक्कु चिन्ता परमेश्वरहे दैदेऊ।<verse eid="1PE 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8" />होश करो, जागल रहो, काकरेकी तुहुरिन्के दुश्मन शैतान मनैनहे नाश करक लग चारु ओहोँर घुमता। उ गर्जना सिंह हस किहिहे भेटाऊँ, और खादारुँ कना मौका खोज्ती रहत।<verse eid="1PE 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 5:9" />तुहुरे अपन विश्वासहे पक्का बनाके ओकर विरोध करे परत। याद करो कि संसारभर रहल विश्वासीनहे फेन अस्तेहेँ दुःखके अनुभव करे परतिन।<verse eid="1PE 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 5:10" />परमेश्वर, जे पूरा रुपमे अनुग्रह करथाँ, येशू ख्रीष्टके संगक हमार सम्बन्धक कारण अपन सदाकालके महिमामे हम्रिहिन्हे साझेदार हुइक लग बलैले बताँ। तुहुरे कुछ समयसम दुःख भोगके सेक्बो ते परमेश्वर तुहुरिन्हे मजा बनैहीँ, ताकि तुहुरिन्केमे कुछु गल्ती ना रहे। और ऊ तुहुरिन्के मनहे बल्गर बनैहीँ, और पक्का हुइक लग हुँकारमे विश्वास करनाहाँ बनैहीँ।<verse eid="1PE 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 5:11" />ऊ आदर भेटैना लायकके बताँ, काकरेकी हुँकार शक्तिक कौनो अन्त नै हुइतिन। आमेन! (यकर मतलब हुइत, अस्तेहेँ होए।)<verse eid="1PE 5:11" /></para>
  <para style="s">अन्तिम नमस्कार</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />सिलासके सहयोगसे मै यी छुटिमुती चिट्ठी लिखाके पठाइल बतुँ। ख्रीष्टमे मै उहिहे विश्वासयोग्य भैयक रुपमे सम्झथुँ। मोरिक चिट्ठी लिख्नक उद्देश्य तुहुरिन्हे उत्साहा देना और पक्का करना हो कि तुहुरिन्के अनुभव कर्ती रहल तुहुरिन्के लग परमेश्वरके अनुग्रह हो। यी अनुग्रहमे पक्का होके ठरह्याइल रहो।<verse eid="1PE 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13" />तुहुरिनेके हस परमेश्वरके चुनल बेबिलोन शहरके विश्वासीन तुहुरिन्हे नमस्कार पठैले बताँ। मर्कूस फेन तुहुरिन्हे नमस्कार पठैले बा, जे मोरिक छावके हस हो। <verse eid="1PE 5:13" /><verse number="14" style="v" sid="1PE 5:14" />एकदोसर जहनहे सच्चा प्रेमसे नमस्कार करो। मै प्राथना करतुँ कि ख्रीष्टमे रहल तुहुरे सक्कु जहनहे परमेश्वर शान्ति दिँत।<verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>