<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id">Acts - DEUKHARIYA Tharu New Testament</book>
  <para style="ide">UTF-8</para>
  <para style="rem">Copyright Information: Creative Commons Attribution-ShareAlike 4.0 License</para>
  <para style="h">निउतरह्या</para>
  <para style="toc1">निउतरह्यनके काम</para>
  <para style="toc2">निउतरह्या</para>
  <para style="toc3">निउत. का.</para>
  <para style="mt1">निउतरह्यनके काम</para>
  <para style="mt2">निउतरह्या</para>
  <para style="is">लिखुइया</para>
  <para style="ip">यी किताबहे लूका कना वैदा लिखल। निउतरह्यनके कामके किताबमे धर्लक बहुत्ते घटनाहे अपन आँखीलेके देखुइया ऊ एकथो साँखी रहे। यकर पुष्टि ओकर प्रयोग कर्लक बहुवचन सर्वनाम शब्द “हम्रे” से हुइत। १६:१०-११; २०:५-२१:१८; २७:१-२८:१६ परम्परा अनुसार ऊ एकथो विजातीय विश्वासी रहे, जे प्रचारक बनल।</para>
  <para style="is">लिख्लक मिति और ठाउँ</para>
  <para style="ip">लगभग ई. स. ६०-६३</para>
  <para style="ip">लिख्लक मुख्य ठाउँ यरुशलेम शहर, सामरिया, लुद्दा, याफा, अन्ताकिया शहर, इकुनियस, लुस्त्रा, दिरबे, फिलिप्पी, थेसलोनिके, बेरिया, एथेन्स, कोरिन्थ, एफिसस, कैसरिया, माल्टा और रोम रहल हुइहीँ।</para>
  <para style="is">भेटुइया</para>
  <para style="ip">यी किताब लूका थियोफिलसके लग लिखल रहे (निउत. १:१)। दुर्भाग्यवश, थियोफिलसके बारेमे दोसुर कौनो जानकारी नै हो। सम्भव बा कि ऊ लूकक अभिभावक रहे; या यी नाउँ थियोफिलस अथवा “परमेश्वरहे प्रेम करुइया” ख्रिष्टियन विश्वासीनके लग काममे लेगिलक व्यापक शब्द रहे।</para>
  <para style="is">उद्देश्य</para>
  <para style="ip">निउतरह्यनके कामके किताबके उद्देश्य यी हो कि विश्वासीन मण्डलीक सुरुवात और ओकर विकासके कहानी प्रस्तुत करिँत। यी किताब डुब्कि देहुइया यूहन्ना येशू और खुशीक खबरके वृतान्तमे बाह्रथो चेलनके सन्देशनहे प्रकट करत। यी किताबमे पेन्तिकोसके दिन पवित्र आत्मक उतरनासे लेके विश्वासीनके विश्वासहे प्रसारणके वृतान्त व्यक्त करत।</para>
  <para style="iot">किताबके विभाजन</para>
  <para style="io1">१. पवित्र आत्मक वाचा <char style="ior"><ref loc="ACT 1:1-26">१:१-२६</ref> </char></para>
  <para style="io1">२. पवित्र आत्मक देखा पर्लक <char style="ior"><ref loc="ACT 2:1-4">२:१-४</ref> </char></para>
  <para style="io1">३. यरुशलेम शहरमे पवित्र आत्मासे निउतरह्यनके सेवकाई और मण्डलीक सतावट <char style="ior"><ref loc="ACT 2:5-8:3">२:५-८:३</ref> </char></para>
  <para style="io1">४. यहूदिया और सामरिया प्रदेशमे पवित्र आत्मासे निउतरह्यनके सेवकाई <char style="ior"><ref loc="ACT 8:4-12:25">८:४-१२:२५</ref> </char></para>
  <para style="io1">५. संसार दोसुर भागमे पवित्र आत्मासे निउतरह्यनके सेवकाई <char style="ior"><ref loc="ACT 13:1-28:31">१३:१-२८:३१</ref> </char></para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="s">लूका लिखत्</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />प्रिय थियोफिलस, मै सुरुक किताबमे उ सक्कु बातके बारेमे लिख्नु, ज्या येशू सुरुएसे कर्ती और सिखैती रलाँ। <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />येशू स्वर्गमे उठागिलाँ। परमेश्वरसे स्वर्गमे उठाजिनासे आघे ऊ अपन चुनल निउतरह्यनहे पवित्र आत्मक सहायतासे आज्ञा देलाँ। <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />और हुँकार दुःख उठैलक और मुके सेकके ऊ बहुत्ते पक्का सबुतसे अपनहे ओइन्के थेन जित्ती देखैलाँ। चालीस दिनसम ऊ ओइन्के थेन देखा पर्तिरलाँ, और परमेश्वरके राजके बारेमे ओइन्से बात बत्वैती रलाँ। <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" />एकचो जब ओइने एक्के संग रहिँत। तब येशू ओइन्हे भेँटा करके ओइन्हे आज्ञा देलाँ, “तुहुरे यरुशलेम शहरमेसे केहोँरो नै जैहो। पर उ पहुँराहे अँस्याऊ, जोन मोरिक बाबा तुहुरिन्हे देना वाचा कर्ले रहे। तुहुरे महिन्हे ओकर बारेमे बोलत सुन्ले बतो। <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />काकरेकी यूहन्ना ते पानीलेके डुब्कि देहल। पर अब्बक थोरिक दिन पाछे परमेश्वर तुहुरिन्के संग रहक लग पवित्र आत्माहे पठैहीँ।”<verse eid="ACT 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />ओकर पाछे जब निउतरह्यन फेनदोस्रे येशूसे भेँटा हुइलाँ। तब् ओइने हुँकिन्हे पुँछ्लाँ, “हे प्रभु, का इजरायलहे स्वतन्त्र करना और हमार राजहे फेनदोस्रे बनाइक लग अप्निक समय आगिल बा?” <verse eid="ACT 1:6" /><verse number="7" style="v" sid="ACT 1:7" />ऊ ओइन्हे कलाँ, “यी घट्ना कब हुई कहिके जन्ना तुहुरिन्हे जरुरी नै हो। मोरिक बाबक थेन किल उ निर्णय करना अधिकार बतिस। <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />पर जब पवित्र आत्मा तुहुरिन्केमे आई, तब तुहुरे शक्ति पैबो। और यरुशलेम शहरमे, सारा यहूदिया प्रदेशमे, सामरिया प्रदेशमे और संसारके हर ठाउँमे तुहुरे मोरिक बारेमे मनैनके थेन साँखी हुइबो।”<verse eid="ACT 1:8" /></para>
  <para style="s">येशू स्वर्गमे गैलक</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 1:9" />येशू यी बात बट्वाके सेक्लाँ ते, ओइने हेर्ती-हेर्ती परमेश्वर येशूहे स्वर्गमे उठालेलिन। और बद्रिक कारण तबसे ओइने येशूहे देखे नै सेक्लाँ। <verse eid="ACT 1:9" /><verse number="10" style="v" sid="ACT 1:10" />और हुँकार जैती रहल समयमे जब ओइने आकाश ओहोँर हेरतिहिँत, तब् एकफाले उज्जर लुग्गा घालल दुईथो स्वर्गदूत ओइन्के लग्गे ठरह्यागिलिन। <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />और ओइने कहे लग्लाँ, “हे गालील प्रदेशके मनै, तुहुरे काकरे ठरह्याके आकाश ओहोँर हेरतो? यहे येशू, जिहिहे परमेश्वर तुहुरिन्के थेनसे स्वर्गमे लैगिल बताँ, ऊ ठिक अस्तेहेँके फेनदोस्रे अइहीँ, जसिके तुहुरे हुँकिन्हे स्वर्गमे जाइत देख्लो।”<verse eid="ACT 1:11" /></para>
  <para style="s">मत्तियासके नियुक्ति</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />जब उ स्वर्गदूतनके चलगिलाँ, तब् चेलनके जैतून कना पहाड़मेसे यरुशलेम शहरमे घुमगिलाँ। यरुशलेम शहरसे यी पहाड़ लगभग एक किलोमिटर<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="fq" closed="false">लगभग एक किलोमिटर </char><char style="ft" closed="false">यहूदिनके अनुसार बिँसैना दिनमे लगभग एक किल नेगे मिलत। </char></note> जतरा दूर परत। <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />और जब ओइने शहरमे पुग्लाँ ते ओइने घरक उप्पर कोन्तीमे गैलाँ। ते वहाँ यी सक्कु निउतरह्यन पत्रुस, यूहन्ना, याकूब, अन्द्रियास, फिलिप और थोमा, बारथोलोमाइ और मत्ती, अल्फयसके छावा याकूब और उग्रपन्थी दलके सिमोन और याकूबके छावा यहूदा उ कोन्तीमे रहिँत। <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />और वहाँ येशूहे सहायता करुइया जन्नी मनै, येशूक दाई मरियम और येशूक भैयनके संग यी निउतरह्यन जमा हुइल रहिँत। और ओइने मनमे एक्के लक्ष्य बनाके हरदम प्राथना करिँत।<verse eid="ACT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />वहे समयमे जब लगभग एक सौ बीस जाने विश्वासी भैयन जमा हुइल रहिँत। तब पत्रुस ओइन्के बिच्चेम ठरह्याके कहे लागल, <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />“हे मोरिक विश्वासी भैयो, पवित्र आत्मा बहुत समय आघे दाऊद रज्वक माध्यमसे यहूदक बारेमे भविष्यवाणी करल रहिँत, जे येशूहे गिरफ्तार करुइया मनैनके अगुवा बनगिलस। यी जरुरी रहे कि यहूदक बारेमे पवित्र शास्त्रमे लिखल बात पूरा होए। <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />ऊ हमारमेसे एकथो रहे, और यी सेवाके काममे फेन शामिल हुइल रहे। <verse eid="ACT 1:17" /><verse number="18" style="v" sid="ACT 1:18" />जसिके तुहुरे सक्कु जाने जन्थो कि यहूदी दलके नेतन यहूदाहे पैँसा देले रहिँत, जब ऊ येशूहे धोखा देना वाचा करल रहे। और पाछेजाके यहूदा उ पैँसा ओइन्हे घुमादेहल। और जब यहूदा अपनहे अप्निहीँ फाँसी लगालेहल, तब ओकर शरीर भुइयाँमे गिरगिलिस। ओकर धिँर फाट्गिलिस, और ओकर सक्कु भुँरपतंगा बाहेर निकरगिलिस। तबेकमारे यहूदी दलके नेतन उ पैँसालेके खेट्वा किनलेलाँ। <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />और यी बात यरुशलेम शहरके मनै पता पालेलाँ। तबेकमारे ओइने उ ठाउँहे अपन भाषामे आखेल्दामा (खुनके खेट्वा) कहे लग्लाँ। <verse eid="ACT 1:19" /><verse number="20" style="v" sid="ACT 1:20" />काकरेकी दाऊद भजनसंग्रहक किताबमे असिके लिखल बा,</para>
  <para style="q" vid="ACT 1:20">‘ओकर घर उजरजाए,</para>
  <para style="q" vid="ACT 1:20">और उ घरेम केऊ ना रहिँत।’</para>
  <para style="q" vid="ACT 1:20">और दाऊद दोसुर ठाउँमे असिके फेन कहल बा,</para>
  <para style="q" vid="ACT 1:20">‘कौनो दोसुर जाने ओकर पद लैलिँत।’”<verse eid="ACT 1:20" /></para>
  <para style="p">
    <verse number="21-22" style="v" sid="ACT 1:21-22" />तबेकमारे यी जरुरी बा कि एकथो असिन मनैयाहे चुने परी, जे प्रभु येशूक सक्कु समयमे कर्लक कामक साँखी बा। और प्रभु येशूहे यूहन्नक माध्यमसे डुब्कि देनासे लेके येशूहे स्वर्गमे स्वीकार हुइतसम यी मनैया हमार संग प्रभु येशूक फेनदोस्रे जित्ती हुइलक साँखी बने। <verse eid="ACT 1:21-22" /><verse number="23" style="v" sid="ACT 1:23" />तब ओइन्मेसे दुई जहनके नाउँ प्रस्तावमे धरलाँ, एकथो बारसाबास कना योसेफ, जेकर उपनाउँ युस्तस रहिस, और दोसुर नाउँ मतियासके रहिस। <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />और ओइने असिके प्राथना करलाँ, “हे प्रभु, अप्नि सक्कु मनैनके मनके बात जन्थी। यी दुई जहनमेसे अप्नि किहिहे चुनल बती, वहे हम्रिहिन्हे देखादी। <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />काकरेकी यहूदा मुगिलस, और उ ठाउँमे चलगिल, जहाँ उहिहे जाई परना रहिस। यी सेवाके काममे और निउतरह्यक खाली रहल यहे ठाउँमे हम्रे उहिहे धारे सेकी।” <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />तब् ओइने चिट्टा दरलाँ और चिट्टा मतियासके नाउँमे परगिलिस। तबेकमारे असिके एघारथो निउतरह्यनके संग ऊ फेन गनगिलस।<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s">पेन्तिकोसमे पवित्र आत्मक आगमन</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />जब यहूदी मनैनके पेन्तिकोसके तिहुवारके<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fq" closed="false">पेन्तिकोसके तिहुवारके </char><char style="fp" closed="false">पुरान करारमे पेन्तिकोसके तिहुवार कलक हप्तक तिहुवार हो, और कट्निक तिहुवारके रुपमे जानजाए। (प्रस्थान २३:१६; ३४:२२) पेन्तिकोस दिन निस्तार-तिहुवारके पचासौँ दिनमे परत।</char></note> दिन अइलिन। उ सक्कु चेलनके एक्के ठाउँमे जुटल रहिँत। <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />तब् स्वर्गमेसे एकफाले भारी बयालके बौखा हस एकथो आवाज आइल। और ओइन्के बैठल पूरा कोन्तीमे फैलगिलिन। <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />तब ओइन्के आघे असिन आगीक मोँजा देखा पर्लिन, जोन मोँजक आकार जीभ हस रहिस। और उ अलग-अलग होके प्रत्येक जहनकेमे परगिलिन। <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />तब् ओइने सक्कु जाने पवित्र आत्मासे भरगिलाँ। और ओइन्हे पवित्र आत्मक देहल वरदान अनुसार ओइने मेरमेरके भाषामे बोले लग्लाँ।<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />वहे समयमे वहाँ संसारके हर देशमेसे परमेश्वरके डर मनुइया बहुत्ते यहूदी मनै तिहुवार मनाइक लग यरुशलेम शहरमे आके बैठल रहिँत। <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />तब् बौखक हस आवाज सुनके मनैनके भीड़ एक्के थेन जमा होगिल। और ओइने अचम्म होगिलाँ, काकरेकी ओइने सक्कु जाने अपन-अपन भाषामे चेलनहे बोलत सुनतिहिँत। <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />ओइन सक्कु जहनहे अचम्म लग्लिन, और ओइने एकदोसर जहनहे कहे लग्लाँ, “का यी बोलुइयन सक्कु गालील प्रदेशमे रहुइया मनै नै हुइँत? <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />ते यी का हुइता, कसिके ओइन्हे हम्रे सक्कु जाने हमार अपन-अपन भाषामे बोलत सुनती? <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />हमारमेसे यहाँ केऊ पार्थी ईलाकक, केऊ मादी ईलाकक और केऊ एलामी ईलाकक, केऊ मेसोपोटामिया प्रदेशके, केऊ यहूदिया प्रदेशके, केऊ कापाडोकिया प्रदेशके, केऊ पोन्टस ईलाकक और केऊ एशिया प्रदेशमे रहुइयन बती। <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />और हमारमेसे केऊ फ्रिगिया, पामफिलिया प्रदेशके, मिश्र देश और केऊ लिबिया देशके लग्गे परना कुरेनी शहरमेसे और केऊ जुन रोम शहरमेसे यरुशलेम शहरसम घुमे अइलक यहूदी और गैर-यहूदिनमेसे यहूदी मत मनुइया दुनु बती। <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />और केऊ क्रेट टापुक मनै और केऊ अरब देशके मनै फेन बती। और हम्रे अपन-अपन भाषामे परमेश्वरके महान कामके चर्चा करत ओइन्से सुनती।” <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />उ सक्कु जहनहे अचम्म लग्लिन। और ओइने अकमकाके एकदोसुर जहनसे असिक पुँछे लग्लाँ, “यकर मतलब का हो?” <verse eid="ACT 2:12" /><verse number="13" style="v" sid="ACT 2:13" />पर दोसुर जाने मजाक उरैती कलाँ, “ओइने लावा अंगुरके मदसे मतवार होरलाँ।”<verse eid="ACT 2:13" /></para>
  <para style="s">भीड़हे पत्रुसके उपदेश</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />पर पत्रुस एघारथो निउतरह्यनके संग ठरह्याके ओइन्हे जोरसे कहल, “हे यहूदिया प्रदेशके मनै और यरुशलेम शहरके मनै, तुहुरिन्हे यी बात बुझ्ना जरुरी बा। तबेकमारे तुहुरे मोरिक बातहे ध्यान देके सुनो। <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />काकरेकी तुहुरिन्के सोँचल हस यने मतवार नै हुइल हुइँत। काकरेकी अभिन बेहानिक नौ किल बजल बा। <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />पर जोन घटना हमार बिच्चेम हुइता, ओकर बारेमे परमेश्वरके अगमवक्ता योएलके माध्यमसे पवित्र शास्त्रमे लिखल बात पूरा हुइता।<verse eid="ACT 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ACT 2:17" />आखिरी दिनमे असिन हुई कहिके परमेश्वर कथाँ।</para>
  <para style="q" vid="ACT 2:17">‘मै सक्कु मनैनहे मोरिक आत्मा देहम।</para>
  <para style="q" vid="ACT 2:17">और तुहुरिन्के छाईछावन अगमवाणी बोल्हीँ।</para>
  <para style="q" vid="ACT 2:17">और तुहुरिन्के जवान मनै दर्शन देख्हीँ।</para>
  <para style="q" vid="ACT 2:17">और तुहुरिन्के बुह्राइल मनै सपना देख्हीँ।<verse eid="ACT 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ACT 2:18" />उ समयमे, मै अपन सेबक और सेविकनहे अपन आत्मा देहम।</para>
  <para style="q" vid="ACT 2:18">और ओइने अगमवाणी बोल्हीँ।<verse eid="ACT 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ACT 2:19" />मै उप्पर आकाशमे अचम्मक चमत्कार देखैम।</para>
  <para style="q" vid="ACT 2:19">और तरे पृथ्वीमे खुन, आगी और धुँवक मोँजक बद्रीमे अचम्मक चिन्हा देखैम।<verse eid="ACT 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ACT 2:20" />प्रभुक महान और गौरवमय दिन अइनासे आघे सूर्य अंधार होजाई।</para>
  <para style="q" vid="ACT 2:20">और जोन्ह्याँ खुन हस होजाई।<verse eid="ACT 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ACT 2:21" />और उ समयसे आघे जे-जे परमप्रभुक नाउँ लिहीँ,</para>
  <para style="q" vid="ACT 2:21">उ सक्कु जाने मुक्ति भेटैहीँ।’”<verse eid="ACT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />“हे इजरायलके मनै, यी बात सुनो, परमेश्वर येशूक माध्यमसे तुहुरिन्के बिच्चेम शक्तिशाली काम करके अचम्मक चिन्हा देखैलाँ। और यी बात सच्चा हो कहिके तुहुरिन्हे पतै बा। वहे चिन्हासे परमेश्वर नासरत गाउँक येशूहे अप्निहीँ पठैलाँ कहिके साबित फेन करलाँ। <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />परमेश्वरके ठहराइल लक्ष्य और पैलेहेँसे जानलेना ज्ञानके अनुसार ऊ तुहुरिन्के हाँथेम सौँपदेगिलाँ। तुहुरे अधर्मी मनैनके सहायतासे हुँकिन्हे किल्ला ठोकके क्रूसमे टँगाके मारदेलो। <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />पर तभुन फेन परमेश्वर मुअलमेसे हुँकिन्हे फेनदोस्रे जिवादेलाँ। काकरेकी येशू अपनहे मृत्युक अधिनमे धर्ले पलिरना सम्भव नै रहे। <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />काकरेकी येशूक बारेमे राजा दाऊद असिके कले बा,</para>
  <para style="q" vid="ACT 2:25">‘मै प्रभुहे सदादिन हेर्ती रहुँ।</para>
  <para style="q" vid="ACT 2:25">काकरेकी ऊ मोरिक दाहिन ओहोँर बताँ,</para>
  <para style="q" vid="ACT 2:25">ताकि मै उ मनैनसे ना डराऊँ, जेने मोरिक नोकसान पुगाई खोज्थाँ।<verse eid="ACT 2:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ACT 2:26" />तबेकमारे मै आनन्दसे भरगिल बतुँ।</para>
  <para style="q" vid="ACT 2:26">और मै आनन्दसे अप्निक स्तुति करतुँ।</para>
  <para style="q" vid="ACT 2:26">यकर संगसंगे मोरिक शरीर फेन आशामे जिती रही।<verse eid="ACT 2:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ACT 2:27" />काकरेकी अप्नि महिन्हे मुअल नै रहेदेबी।</para>
  <para style="q" vid="ACT 2:27">और ना ते अप्नि अपन पवित्र मनैयक लाहाशहे सरे देबी!<verse eid="ACT 2:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ACT 2:28" />अप्नि महिन्हे जीवनके डगर देखैली।</para>
  <para style="q" vid="ACT 2:28">अप्नि महिन्हे अपन हाजिरीमे आनन्दसे भरदेबी।’”<verse eid="ACT 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />“हे मोरिक विश्वासी भैयो, हमार पुर्खा दाऊद रज्वक बारेमे यी जात्तिक हो कि ऊ मुअल। और ओकर लाहाशहे चिहानमे फेन धारगिलिस। और उ चिहान आज फेन वहैँ पलि बा। <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />ऊ एकथो परमेश्वरके अगमवक्ता हुइलक कारण यी जाने कि परमेश्वर कसम खाके उहिसे यी वाचा कर्ले बताँ, ‘मै तोरिक खानदानमेसे एकथो मनैयाहे तोरिक सिंहासनमे बैठ्वैम।’ <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />यी जानके कि भविष्यमे परमेश्वर का करे जाइतिहिँत। दाऊद रज्वा येशू ख्रीष्टके फेनदोस्रे जिउठ्नक बारेमे बात बत्वाइल। और ऊ कहल,</para>
  <para style="q" vid="ACT 2:31">‘काकरेकी अप्नि महिन्हे मुअल नै रहेदेबी;</para>
  <para style="q" vid="ACT 2:31">और ना ते अप्नि अपन पवित्र मनैयक लाहाशहे सरे देबी!’<verse eid="ACT 2:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 2:32" />यहे येशूहे परमेश्वर जित्ती बनैलाँ। यी बातके हम्रे सक्कु जाने साँखी बती। <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />आब ऊ स्वर्गमे परमेश्वरके दाहिन पाँजर सक्कुहुनसे ऊँच सम्मानके ठाउँमे विराजमान बताँ। और जसिके बाबा हुँकिन्से वाचा कर्ले रहिन, ओस्तेहेँके हुँकिन्हे पवित्र आत्मा देलाँ और वहे पवित्र आत्मा ऊ हम्रिहिन्हे देले बताँ, जसिके आज तुहुरे देख्थो और सुन्थो। <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />दाऊद रज्वा ते स्वर्गमे नै गैल रहे, तभुन फेन ऊ अप्निहीँ कहल:</para>
  <para style="q" vid="ACT 2:34">‘प्रभु परमेश्वर मोरिक प्रभुहे कलाँ,</para>
  <para style="q" vid="ACT 2:34">तुँ मोरिक दाहिन पाँजर बैठो,<verse eid="ACT 2:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="ACT 2:35" />जबसम मै तोहाँरिक दुश्मननहे तोहाँर अधिनमे ना करादिऊँ।’<verse eid="ACT 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36" />तबेकमारे इजरायलके सक्कु मनै यी बात जानलिँत: कि परमेश्वर वहे येशूहे प्रभु और ख्रीष्ट दुनु ठहरैलाँ, जिहिहे तुहुरे क्रूसमे टँगैलो।”<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />जब मनै यी बात सुन्लाँ, तब ओइने अपनहे बहुत दोषी रहल महसुस करलाँ। ओइने पत्रुस और औरे निउतरह्यनसे पुँछे लग्लाँ, “हे भैयो, हम्रे का करी?” <verse eid="ACT 2:37" /><verse number="38" style="v" sid="ACT 2:38" />पत्रुस ओइन्हे कहल, “अपन मन बदलके पाप करना छोरदेऊ, और तुहुरे प्रत्येक जाने अपन-अपन पापके माफिक लग येशू ख्रीष्टके नाउँमे डुब्कि लेऊ; तब् तुहुरे पवित्र आत्मक वरदान भेटैबो। <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />काकरेकी यी प्रतिज्ञा तुहुरिन्के लग, और तुहुरिन्के लरकनके लग और दूर-दूर रहल सक्कु मनैनके लग फेन हो, जेनहे प्रभु हमार परमेश्वर अपन थेन बलैहीँ।” <verse eid="ACT 2:39" /><verse number="40" style="v" sid="ACT 2:40" />पत्रुस यी बात घनी-घनी कहिके ओइन्हे बिन्ती करल कि, “तुहुरे अपनहे अप्निहीँ यी दुष्ट पुस्तासे बँचाऊ।” <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />तब् जोन-जोन मनै पत्रुसके कहल बातहे स्वीकार करलाँ, ओइने डुब्कि लेलाँ; और वहे दिन विश्वासीनके उ समूहमे लगभग तीन हजार मनै ओइन्के संग थपगिलाँ।<verse eid="ACT 2:41" /></para>
  <para style="s">विश्वासीनके साझा जीवन</para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 2:42" />ओइने निउतरह्यनके संग सिखिँत, और संगति करिँत। और ओइने प्रभुभोजमे शामिल हुइँत। और सक्कु विश्वासीन एक्के संग अपन खाना खाइँत, और हरदम प्राथनामे लग्ले रहिँत। <verse eid="ACT 2:42" /><verse number="43" style="v" sid="ACT 2:43" />यरुशलेम शहरके सक्कु मनै अचम्म लग्तिक डर अनुभव करलाँ। और बहुत्ते चिन्हा और निउतरह्यन अचम्मक काम करलाँ। <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />और विश्वास करुइया उ सक्कु जाने एक्के संग बैठिँत। और ओइन्के थेन रलक सक्कु चिज ओइने एकदोसुर जहनहे बाँतिँत्। <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />ओइने अपन सम्पति और सामान बेँचबेँचके जिही-जिहिहे ज्या-ज्या चिजके जरुरी परिन, ओइन्हे उ चिज बाँटदिँत। <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />और ओइने प्रत्येक दिन एक्के मन बनाके मन्दिरमे एकजुट होके आराधना करिँत। और प्रभुभोजके लग एकदोसुर जहनके घरेम जमा हुइँत। और ओइने खुशी और शुद्ध मनसे मिल्जुलके खाना खाँइत। <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />और ओइने परमेश्वरके प्रशंसा करिँत। और सक्कु जाने यनसे खुशी रहिँत। और जोन-जोन मनैनहे मुक्ति मिलिन, ओइन्हे दिन-दिने प्रभु यनके समूहमे शामिल करादिन।<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s">एकथो नाँगर मनैया चोख्वागिलक</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />पत्रुस और यूहन्ना दुपहरिक तीन बजे प्राथनक समयमे मन्दिरमे जाइतिहिँत। <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />एकथो जल्मत्तिक नागर मनैयाहे मनै मन्दिरके दवारीमे नानतिहिँत। प्रत्येक दिन ओइने उहिहे उ दवार थेन बैठ्वादिँत, जोन दवारके नाउँ सुग्घुर दवार रहिस। ऊ वहाँ बैठ्के मन्दिरमे जउइया मनैनसे भीख माँगे। <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />जब ऊ पत्रुस और यूहन्नाहे मन्दिरके भित्तर जाइत देखल, ते ऊ ओइन्से भीख माँगल। <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />पत्रुस और यूहन्ना सोझे ओकर ओहोँर हेरलाँ और कलाँ, “हमार ओहोँर हेर!” <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />ओइन्से कुछु भेटैना आसरा करके ऊ ओइन्हे महा घट्गरसे हेरल। <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />तब् पत्रुस कहल, “सोन और चाँदी ते मोरिक थेन नै हो; पर ज्या मोरिक थेन बा, वहे मै तुहिहे देहम; नासरत गाउँक येशू ख्रीष्टके नाउँमे उठ् और नेङ्ग!” <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />और पत्रुस ओकर दाहिन हाँथ पकरके उहिहे उठाइल; और जुरतेहेँ ओकर गोरामे और घुट्ठी-घुट्ठीमे बल आगिलिस। <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />तब् ऊ जुरुकसे उठ्के ठरह्यागिल, और ऊ नेगे लागल और नेंग्ती और कुद्गति और परमेश्वरके स्तुति कर्ती ओइन्के संग मन्दिरके अंगनामे चलगिल। <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />तब् सक्कु मनै उहिहे नेंग्ती और परमेश्वरके प्रशंसा कर्ती देख्के, <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />उहिहे चिहिन्लेलाँ कि यी वहे नंग्रा भिखारी हो, जे मन्दिरके सुग्घुर नाउँक दवारमे बैठके भीख माँगे। और उ भिखारीक संग हुइलक घटनाहे देख्के ओइने छक्क परके दंग परगिलाँ।<verse eid="ACT 3:10" /></para>
  <para style="s">मन्दिरमे पत्रुसके उपदेश</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />जब उ भिखारी मनैया यूहन्ना और पत्रुसहे पकर्ले रहे, ते सक्कु जाने अचम्म मानलेलाँ। और ओइने ओइन्के ओहोँर दगुरती गैलाँ, और ओइने वहाँ जमा होगिलाँ, जहाँ सुलेमान नाउँक बरन्दा रहे। <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />यी देख्के पत्रुस मनैनहे कहल, “हे इजरायलके मनै, यी मनैयाहे देख्के तुहुरे काकरे अचम्म मानतो, और तुहुरे हम्रिहिन्हे काकरे घुरेरके हेरतो? तुहुरे ते हम्रिहिन्हे असिके हेरतो जसिके हम्रे अपन शक्ति या भक्तिसे यिहिहे नेङ्नाहाँ बनाइल बती। <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />हमार पुर्खन अब्राहाम, इसहाक और याकूबके परमेश्वर अपन सेबक येशूहे मुअलमेसे जित्ती बनाके महिमित करलाँ। पर तुहुरे हुँकिन्हे मरवाइक लग रोमी अधिकारीनके हाँथेम दैदेलो। और जब राजपाल पिलातस हुँकिन्हे छोरदेना विचार करल, तब तुहुरे ओकर आघे येशूहे अस्वीकार करलो। <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" />पर तुहुरे येशूहे अस्वीकार करदेलो, जे पवित्र और धर्मी रहिँत। और तुहुरिन्के लग एकथो हत्याराहे छोरदेजाए कहिके तुहुरे चहलो। <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />और तुहुरे सदाकालके जीवनके स्रोतहे मुवादर्लो। पर परमेश्वर हुँकिन्हे फेनदोस्रे जिवादेलाँ; और हम्रे यी बातके साँखी बती। <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />यी मनैया, जिहिहे तुहुरे अब्बे देखतो और जिहिहे तुहुरे चिहिन्थो, यिहिहे येशू ख्रीष्टके नाउँमे विश्वास कर्लक कारण बल देगिल बतिस। और येशू ख्रीष्टमे विश्वास कर्लक कारण यी बिरकुल चोखागिल बा, जसिके अब्बे तुहुरे अप्निहीँ देखतो। <verse eid="ACT 3:16" /><verse number="17" style="v" sid="ACT 3:17" />आब हे मोरिक विश्वासी भैयो, मै जन्थुँ कि तुहुरे और तुहुरिन्के अगुवन येशूहे अन्जानमे मुवादर्लो। काकरेकी तुहुरिन्हे पता नै रहे कि ऊ ख्रीष्ट रहिँत। <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />पर जोन बातहे परमेश्वर सक्कु अगमवक्तनके माध्यमसे पैलेहेँ बतादेले रहिँत कि ख्रीष्ट दुःख उठैहीँ और मुवाजिहीँ; और ऊ ओइन्हे जात्तिकमे करके देखैलाँ। <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />तबेकमारे अपन मन बदलके पाप करना छोरदेऊ, और परमेश्वरके ओहोँर घुमजाऊ, ताकि तुहुरिन्के पाप माफ करजाए। तब परमेश्वरके ओहोँरसे आत्मिक शक्तिक समय आई। <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />और परमेश्वर येशूहे पठैहीँ, जे वहे ख्रीष्ट हुइताँ, जिहिहे ऊ तुहुरिन्के लग पैलेहेँसे चुन्ले बताँ। <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />येशूहे स्वर्गमे उ समयसम रहे परना जरुरी बतिन, जबसम परमेश्वर अपन बनैलक सक्कु चिजहे लावा नै बनादिहीँ। बहुत समय पहिले परमेश्वर मनैनहे यी बताइक लग पवित्र अगमवक्तनके माध्यमसे असिक करना वाचा कर्ले रहिँत। <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />जसिके मोशा कले बा, ‘प्रभु परमेश्वर तुहुरिन्के लग तुहुरिन्के दादू-भैयनमेसे मोरिक हस एकथो अगमवक्ता पठैहीँ। और ऊ ज्या-ज्या कहिहीँ, तुहुरे हुँकार बात सुन्हो।’ <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />और प्रत्येक मनै जे परमेश्वरके अगमवक्तक कलक बात नै सुनी, उहिहे परमेश्वरके मनैनके बिच्चेमेसे पूरा रुपमे नाश करदेजाई। <verse eid="ACT 3:23" /><verse number="24" style="v" sid="ACT 3:24" />परमेश्वरके अगमवक्ता शमूएलसे लेके ओकर पाछेक सक्कु अगमवक्तनके माध्यमसे फेन यहे दिनके बारेमे घोषणा करगिल बा। <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />तुहुरे सक्कु जाने परमेश्वरके अगमवक्तनके लरका और उ वाचक भागिदार हुइतो, जोन वाचा परमेश्वर तुहुरिन्के पुर्खनहे कर्ले रहिँत। जब ऊ अब्राहामसे कलाँ, ‘तोरिक छावक माध्यमसे पृथ्वीक सक्कु परिवार आशिष भेटैहीँ।’ <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />परमेश्वर अपन सेबक येशूहे मुअलमेसे जिवाके सक्कुहुनसे आघे तुहुरिन्के थेन आशिष देहक लग पठैलाँ। ताकि ऊ तुहुरिन्मेसे हरेक जहनहे तुहुरिन्के पापी जीवनहे छोरके परमेश्वरके ओहोँर घुम्नामे तुहुरिन्हे सहायता करे सेकिँत।”<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s">पत्रुस और यूहन्नक गिरफ्तार हुइलक</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />जब पत्रुस और यूहन्ना मनैनके संग बोल्तीए रहिँत, तब्बेहेँ पुजारीनके, मन्दिरके कप्तान और सदुकी दलके मनै ओइन्के थेन आगिलाँ। <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />ओइने महा जोरसे रिसागिलाँ। काकरेकी पत्रुस और यूहन्ना मनैनहे सिखाइतिहिँत कि जोन मनै मुसेकल बताँ, ओइन्हे परमेश्वर फेनदोस्रे जित्ती करादिहीँ, जसिके ऊ येशूहे मुअलमेसे फेनदोस्रे जिवादेलाँ। <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />और ओइने यूहन्ना और पत्रुसहे गिरफ्तार करके दोसुर दिनसम थानामे धर्ले रलाँ। काकरेकी संझा होसेकल रहे। <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />पर वचन सुनुइयनमेसे बहुत जाने येशूकमे विश्वास करलाँ। और वहाँ लगभग पाँच हजार थारु मनै रहिँत, जेने येशूकमे विश्वास करे लग्लाँ।<verse eid="ACT 4:4" /></para>
  <para style="s">यहूदी महासभक आघे पत्रुस और यूहन्ना</para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />दोसुर दिन ओइन्के शासकहुँक्रे, यहूदी दलके नेतनके और यहूदी कानुनके गुरुनके यरुशलेम शहरके एकथो ठाउँमे जमा होगिलाँ। <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />उ सभामे शामिल रहल मनै यहूदी प्रधान पुजारी हन्नाससे भेँटा करलाँ। और कैयाफा, यूहन्ना, अलेक्जेन्डर और जतरा फेन प्रधान पुजारीक परिवारके रहिँत, ओइने सक्कु जाने यरुशलेम शहरमे जमा हुइल रहिँत। <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />और पत्रुस और यूहन्नाहे ओइने सक्कुहुनके बिच्चेम थरह्वाके पुँछ्लाँ, “यी मनैयाहे चोख्वाइक लग तुहुरे कोन शक्तिसे या कोन अधिकारके प्रयोग कर्ले बतो?” <verse eid="ACT 4:7" /><verse number="8" style="v" sid="ACT 4:8" />तब पत्रुस पवित्र आत्मामे भरके यहूदी दलके नेतनहे कहल, <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />“हे मनैनके शासक और यहूदी दलके नेतनके, हम्रे एकथो कमजोर मनैयक भलाई कर्ले बती। और आज हम्रिहिन्हे पुँछ्पाँछ हुइता कि ऊ कसिके चोखाइल। <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />कलेसे तुहुरे सक्कु जाने और इजरायलके सक्कु मनै, तुहुरे यी जानलेऊ, कि यी काम नासरत गाउँक येशू ख्रीष्टके नाउँमे करगिल बा। वहे येशूहे तुहुरे क्रूसमे टँगादेले रहो। पर परमेश्वर हुँकिन्हे मुअलमेसे फेनदोस्रे जिवादेलाँ। आज हुँकारे नाउँसे यी मनैया तुहुरिन्के आघे चोखाके ठरह्याइल बा। <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />ख्रीष्ट येशू वहे पठरा हुइँत, जिहिहे तुहुरे राजमिस्ट्रीन बेकारके बा कहिके सम्झलो। वहे पठरा जगके मुख्य पठरा बनगिलस। <verse eid="ACT 4:11" /><verse number="12" style="v" sid="ACT 4:12" />येशू बाहेक कौनो दोसुर जहनमे मुक्ति नै हो। काकरेकी स्वर्गक तरे मनैनके लग कौनो दोसुर नाउँ नै देगिल हो, जिहिसे हम्रिहिन्हे मुक्ति मिले सेके।”<verse eid="ACT 4:12" /></para>
  <para style="s">येशूक नाउँक कारण चेलनहे धम्की</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />जब ओइने पत्रुस और यूहन्नक हिम्मत देख्लाँ, और यने अनपढ़ और साधारण मनै हुइताँ कना पता पालेलाँ। तब् ओइन्हे अचम्म लग्लिन। और ओइने ओइन्हे जानलेलाँ कि यने येशूक संग रहतिहिँत। <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />पर चोख्वागिलक उ मनैयाहे पत्रुस और यूहन्नक संग ठरह्याइल देख्के यहूदी सभक मनै कुछु बोले नै सेक्लाँ। <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />तबेकमारे ओइन्हे ओइने महासभामेसे बाहेर जैना आज्ञा देलाँ। तब ओइने एकदोसुर जहनसे छलफल करे लग्लाँ, <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />“हम्रे यनहे का करी? यी ते फरछ्वारे बा कि यनसे एकथो असाधारण चमत्कार जरुर हुइल बतिन। और यी बात यरुशलेम शहरके मनै फेन जानसेकल बताँ। यी सच्चाइहे हम्रे अस्वीकार करे नै सेक्बी। <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />पर यी बात जनतनमे आकुर धेउर ना फैलजाए कहिके हम्रे यनहे धम्की देबी। ताकि ओइने येशूक नाउँ लेके आबसे फेनदोस्रे दोबारा किहुसे फेन बात ना बत्वाइँत।” <verse eid="ACT 4:17" /><verse number="18" style="v" sid="ACT 4:18" />तब ओइने पत्रुस और यूहन्नाहे बलैलाँ, और ओइन्हे चेतावनी देके असिके कलाँ, “आबसे तुहुरे येशूक नाउँ लेके कुछु ना बोल्हो, और कुछु फेन ना सिखैहो।” <verse eid="ACT 4:18" /><verse number="19" style="v" sid="ACT 4:19" />पर पत्रुस और यूहन्ना ओइन्हे जवाफ देलाँ, “तुहुरेहे न्याय करो कि का यी परमेश्वरके नजरमे सही बा कि हम्रे परमेश्वरके बात छोरके तुहुरिन्के बात मानी? <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />काकरेकी यी ते हम्रिहिन्से हुई नै सेकी, कि हम्रे ज्या देखल और सुनल बती ओकर बारेमे हम्रे कती रहे नै सेकब।” <verse eid="ACT 4:20" /><verse number="21" style="v" sid="ACT 4:21" />तब ओइने ओइन्हे धम्की देके छोरदेलाँ। ओइने यी सम्झे नै सेकतिहिँत कि ओइने पत्रुस और यूहन्नाहे कोन आधारमे दण्ड देहे सेकजाई। काकरेकी सक्कु मनै यी घट्नक कारण परमेश्वरके प्रशंसा करतिहिँत। <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />जोन मनैया एकथो अचम्मक तरिकासे चोखाइल रहे, ओकर उमेर चालीस सालसे फेन धेउर रहिस।<verse eid="ACT 4:22" /></para>
  <para style="s">चेलनके प्राथना</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />पत्रुस और यूहन्ना छुट्के अपन संघरियनके थेन गैलाँ। और मुख्य पुजारी और यहूदी दलके नेतनके कलक सक्कु बात ओइने अपन संघरियनहे बतादेलाँ। <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />यी सुनके ओइने सक्कु जाने एक्के मन बनाके बरका आवाजमे परमेश्वरसे प्राथना करलाँ, “हे प्रभु, अप्निए हुइती जे स्वर्ग, पृथ्वी, समुन्दर और ओइन्केमे रहल सक्कु प्राणीनहे बनैली। <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />अप्नि पवित्र आत्मक माध्यमसे अपन सेबक हमार पुर्खा दाऊदके मुहेँसे कली।</para>
  <para style="q" vid="ACT 4:25">‘गैर-यहूदिनके काकरे रिसैथाँ।</para>
  <para style="q" vid="ACT 4:25">और मनै काकरे बिनाकामक षड़यन्त्र बनैथाँ?<verse eid="ACT 4:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ACT 4:26" />ख्रीष्ट प्रभु और हुँकार अभिषेक करल मनैयक विरोधमे पृथ्वीक रज्वन एकजुट हुइलाँ।</para>
  <para style="q" vid="ACT 4:26">और शासकहुँक्रे एक ठाउँमे जमा होगिलाँ।’<verse eid="ACT 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 4:27" />जात्तिकमे अप्निक अभिषेक कर्लक अप्निक पवित्र सेबक येशूक विरोधमे हेरोद रज्वा और पन्तियस राजपाल पिलातस दुनु जाने गैर-यहूदी और इजरायलीनके संग यहे शहरमे जमा हुइल रहिँत। <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />ओइने वहे करलाँ, ज्या अप्निक शक्ति और इच्छामे पैलेहेँ तय होगिल रहे कि अस्तेहेँके हुई परी। <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />आब हे प्रभु, ओइन्के धम्कीहे सुनी; और अपन दासहुँक्रिहिनहे अप्निक वचन पूरा हिम्मतसे सुनाई दैदी। <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />और चोख्वाइक लग अप्नि अपन हाँथ बह्राई कि चमत्कारके चिन्हा और अचम्मक काम अप्निक पवित्र सेबक येशूक नाउँसे होए।” <verse eid="ACT 4:30" /><verse number="31" style="v" sid="ACT 4:31" />जब ओइने प्राथना करके सेक्लाँ ते जहाँ ओइने जमा हुइल रहिँत, उ ठाउँ हिलगिलस। और ओइने सक्कु जाने पवित्र आत्मासे भरगिलाँ। और ओइने परमेश्वरके वचन हिम्मतसे सुनैती रलाँ।<verse eid="ACT 4:31" /></para>
  <para style="s">विश्वासीनके सहयोगी</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />विश्वास करुइयनके मण्डली सक्कु जाने एक्के मन और एक्के आत्मक हुइल रहिँत। यहाँसम कि केऊ फेन अपन सम्पतिहे अपन नै कहिँत, पर ओइन्के सक्कु चिज साझा रहिन। <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />और निउतरह्यन महा शक्तिशाली तरिकासे प्रभु येशूक फेनदोस्रे जित्ती हुइलक गवाही देती रलाँ। और उ सक्कु जहनकेमे बरवार अनुग्रह रहिन। <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />और ओइन्मेसे केऊ फेन गरीब नै रहे। काकरेकी जेनके थेन जग्गाजमिन या घर रहिन, ओइने उ चिज बेँचबेँचके, बिकल चिजके मोल नानके निउतरह्यनहे दैदिँत। <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />और जिही-जिहिहे ज्या-ज्या चिजके जरुरी परिन, ओक्रेहे अनुसार निउतरह्यन ओइन्हे बाँटदिँत। <verse eid="ACT 4:35" /><verse number="36" style="v" sid="ACT 4:36" />योसेफ नाउँ रहल साइप्रस टापुक एकथो लेवी रहे। जेकर नाउँ निउतरह्यन बारनाबास धर्ले रहिँत। जेकर मतलब हुइत “उत्साहा देहुइया।” <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />ओकर थोरचे जग्गा रहिस। और ऊ उहिहे बेँचदेहल, और मोलके रुपिया नानके मनैनहे बाँटक लग निउतरह्यनहे दैदेहल।<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s">हननिया और सफीरा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />हननिया नाउँक एकथो मनैया और ओकर जन्नी सफीरा अपन जग्गक एक खण्डा बेँच्लाँ। <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />और ओकर मोलमेसे थोरचे अपन लग धारलेलाँ। और यी बात ओकर जन्नीहे फेन पता रहिस। और ओकर बाँकी रहल हिस्सा नानके ऊ निउतरह्यनहे दैदेहल। <verse eid="ACT 5:2" /><verse number="3" style="v" sid="ACT 5:3" />पर पत्रुस कहल, “ए हननिया! शैतान तोरिक मनमे पवित्र आत्मासे झूँट बोल्ना विचार दर्ले बा। और अपन बेँच्लक जग्गक मोलके एक हिस्सा तैँ अपन लग धारलेले बते। <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />का बेँच्नासे आघे उ जग्गा तोरिक नै रहे? और जब तैँ बेँचदर्ले तब फेन उ तोरिके अधिकारमे नै रहे का? तोरिक मनमे यी खराब काम करना विचार कहाँसे अइलस? तैँ मनैनहे नै होके परमेश्वरहे ठग्ले बते।” <verse eid="ACT 5:4" /><verse number="5" style="v" sid="ACT 5:5" />यी बात सुन्ती किल हननिया भुइयाँमे गिर पर्लस, और ऊ मुगिलस। और यी बात सुनुइया सक्कु जाने डरागिलाँ। <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />तब् जवान मनै आके ओकर अर्थी बनैलाँ, और बाहेर लैजाके भँथारदेलाँ। <verse eid="ACT 5:6" /><verse number="7" style="v" sid="ACT 5:7" />लगभग तीन घण्टा पाछे हननियक जन्नी भित्तर अइलिस। और ज्या चिज फेन हुइल रहे, ओकर बारेमे उहिहे कुछु पता नै रहिस। <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />तब पत्रुस उहिहे पुँछल, “महिन्हे बताऊ, का तुहुरे दुनु जाने उ जग्गाहे अत्रेहेमे बेँच्ले रहो?” तब् ऊ कहल, “हाँ, अत्रेहेमे बेँच्ले रही।” <verse eid="ACT 5:8" /><verse number="9" style="v" sid="ACT 5:9" />तब पत्रुस उहिहे कहल, “यी का बात बा कि प्रभुक आत्मक परीक्षा करक लग तुहुरे दुनु जाने एक्के संग सहमति होगिलो? हेरो, जेने तोहाँरिक थरवाहे भँथरलाँ, उ जवान मनै दवारेमे ठरह्याइल बताँ, और ओइने तुहिन्हे फेन बोकके बाहेर लैजिहीँ।” <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />तब् उ फेन जुरतेहेँ भुइयाँमे गिरपरल, और ऊ मुगिलस। तब जब जवान मनै भित्तर अइलाँ ते उहिहे मुअल देख्लाँ। और उहिहे फेन बाहेर लैजाके ओक्रेहे थरवक थेन भँथारदेलाँ। <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />यरुशलेम शहरके सक्कु मण्डलीक मनै और यी बात सुनुइया सक्कु मनैनकेमे बरवार डर छोपलेलिन।<verse eid="ACT 5:11" /></para>
  <para style="s">निउतरह्यनसे हुइलक चिन्हा और चमत्कार</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />निउतरह्यनसे बहुत्ते चमत्कार और अचम्मक काम मनैनके थेन हुइतिहिन। और ख्रीष्टमे विश्वास करुइया सक्कु जाने एक्के मन बनाके सुलेमानके बरन्दामे जमा हुइँत। <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />पर जेने अभिनसम येशूकमे विश्वास नै करल रहिँत। ओइन्हे यी हिम्मत नै हुइन कि जाके ओइने ओइन्के समूहमे शामिल होजाइँत। तभुन फेन मनै निउतरह्यनके आदर करिँत्। <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />और प्रभुमे विश्वास करुइयनके संख्या बहर्तीगैलिन। ओइन्केमे थारु मनै और जन्नी दुनु जहनके संख्या बहर्तीगैलिन। <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />निउतरह्यन ज्या चिज करतिहिँत, ओकर कारण मनै बेमार मनैनहे डगरमे नान-नानके खटिया और मचियामे सुतादिँत। ताकि जब पत्रुस आई, तब ओकर छाहीँ किल हुइलेसे फेन ओइन्मेसे केक्रोमे परजाए। <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />और यरुशलेम शहरके आँजरपाँजरका नगरमेसे फेन बहुत्ते बेमार मनैनहे और भूतनके सताइल मनैनहे निउतरह्यनके थेन नानिँत। और ओइने सक्कु जाने चोखाजाँइत।<verse eid="ACT 5:16" /></para>
  <para style="s">निउतरह्यनहे झेलमे दर्लक</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />तब यहूदी प्रधान पुजारी और ओकर संग रहुइया सदुकी दलके मनै निउतरह्यनसे हिस्का मुए लग्लाँ। तबेकमारे ओइने ओइन्के विरोधमे कारबाही करना निर्णय करलाँ। <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />और ओइने निउतरह्यनहे पकरके झेलमे दारदेलाँ। <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />पर रातके प्रभुक एकथो स्वर्गदूत झेलके दवार खोलके ओइन्हे बाहेर नानके कहल, <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />“जाऊ और मन्दिरके अंगनामे ठरह्याके मनैनहे यी लावा जीवनके बारेमे बतादेऊ।” <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />निउतरह्यन सक्करहीँ मन्दिरमे गैलाँ। और शिक्षा देना सुरु करदेलाँ, जसिके ओइन्हे स्वर्गदूत बतैले रहिन। पर यहूदी प्रधान पुजारी और ओकर संघरियन आके महासभाहे और इजरायलीनके सक्कु अगुवनहे जमा करैलाँ। और निउतरह्यनहे ओइने झेलमेसे नन्ना आदेश देलाँ। <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />पर जब मन्दिरके चौकीदर्वन वहाँ पुग्लाँ ते निउतरह्यनहे झेलमे नै भेटैलाँ। और घुमके आके असिके बतैलाँ, <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />“हम्रे झेलहे महा साबधानीसे ताला लगाइल, और चौकिदर्वनहे दवारीक बाहेर ठरह्याइल देख्ली। पर दवार खोलके हेर्ली ते हम्रे भित्तर किहुहे फेन नै भेटैली।” <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />जब मन्दिरके चौकिदर्वनके कप्तान और मुख्य पुजारीनके यी खबर सुन्लाँ, ते ओइने निउतरह्यनके बारेमे महा चिन्तामे परगिलाँ कि यकर नतिजा का हुई। <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />अत्रेहेमे केऊ एकजाने आके ओइन्हे बतैलिन, “हेरो, जोन मनैनहे तुहुरे झेलमे दर्ले रहो, ओइने मन्दिरमे ठरह्याके मनैनहे शिक्षा देहतताँ।” <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />जब अधिकारीन यी बात सुन्लाँ, तब मन्दिरके चौकिदर्वनके कप्तान चौकिदर्वनके संग मन्दिरमे गैलस। और वहाँ जाके ओइने निउतरह्यनहे महासभक थेन लयन्लाँ। पर जबरजस्ती नै नन्लाँ। काकरेकी ओइने मनैनसे डराइँत कि मनै पठरालेके मार-मारके ओइन्हे मुवा ना दिँत। <verse eid="ACT 5:26" /><verse number="27" style="v" sid="ACT 5:27" />और यहूदी प्रधान पुजारी ओइन्हे महासभक आघे ठरह्वाइल और असिके पुँछल, <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />“येशूक नाउँमे कुछु शिक्षा ना देहो कहिके हम्रे तुहुरिन्हे कड़ा आज्ञा देले रही। तभुन फेन तुहुरे सारा यरुशलेमहे अपन शिक्षासे भरदेले बतो। और तुहुरे उ मनैयक हत्यक दोष जबरजस्ती हमारिकमे लगाई चहथो।” <verse eid="ACT 5:28" /><verse number="29" style="v" sid="ACT 5:29" />तब पत्रुस और दोसुर निउतरह्यन जवाफ देलाँ, “मनैनके आज्ञाहे छोरके परमेश्वरके आज्ञक पालन करना हमार कर्तव्य हो। <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />हमार पुर्खनके परमेश्वर येशूहे मुअलमेसे जित्ती बनादेलाँ, जिहिहे तुहुरे क्रूसमे टँगाके मुवाँदारल रहो। <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />जिहिहे परमेश्वर अपन दाहिन पाँजर सृष्टिकर्ता और मुक्तिदाता बनैलाँ। ताकि इजरायल देशके मनै अपन गलत सोँच-विचार और गलत डगरमेसे परमेश्वरके ओहोँर घुमिँत। और असिक करके ओइने अपन पापके माफी भेटाई सेकिँत। <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />हम्रे यी बातके साँखी बती। और पवित्र आत्मा फेन साँखी बा, जोन पवित्र आत्माहे परमेश्वर ओइन्हे देले बतिन, जेने हुँकार आज्ञा पालन करथाँ।” <verse eid="ACT 5:32" /><verse number="33" style="v" sid="ACT 5:33" />जब सभक सदस्यन यी बात सुन्लाँ ते ओइने महा जोरसे रिसागिलाँ। तब ओइने निउतरह्यनहे मुवाई खोज्लाँ। <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />तब्बेहेँ गमलिएल नाउँ रहल एकथो फरिसी महासभक आघे ठरह्यागिल। ऊ एकथो सक्कुहुनके मानल यहूदी कानुनके गुरु रहे। निउतरह्यनहे ऊ एक घचिक लग महासभामेसे बाहेर जैना आज्ञा देहल। <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />तब ऊ महासभक सदस्यनहे कहल, “हे इजरायलके मनै, ज्या चिज तुहुरे यी मनैनहे करे चहथो, उ चिज तुहुरे सोँचबुझके करहो। <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />काकरेकी आजसे पहिले थूदास नाउँ रहल एकथो मनैया रहे। ऊ मै फेन कुछु हुइतुँ कहिके दाबी करे, और लगभग चार सौ मनै ओकर अनुशरण करे लग्लाँ। ऊ मुवागिलस और उहिहे मरुइया सक्कु मनै छिदिरबिदिर होगिलाँ, और ओइन्के नाउँ-निशान नै रहिगिलिन। <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />ओकर पाछे जनगणनक समयमे गालील प्रदेशके यहूदा आइल। और बहुत मनैनहे अपन ओहोँर करालेहल; ऊ फेन मुवागिलस, और ओकर पाछे लगुइयन फेन छिदिरबिदिर होगिलाँ। <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />तबेकमारे मै तुहुरिन्हे कहतुँ, यी मनैनसे दूरे रहो। और ओइन्हे कौनो वास्ता ना करो। काकरेकी यदि यी योजना या यी काम मनैयक ओहोँरसे हुई कलेसे यी मेट्जाई। <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />पर यदि यी परमेश्वरके ओहोँरसे हो कलेसे तुहुरे ओइन्हे कबु फेन मेटाई नै सेक्बो। कहुँ असिन ना होए, कि तुहुरे परमेश्वरसे फेन लरुइया ठहरजाऊ।” <verse eid="ACT 5:39" /><verse number="40" style="v" sid="ACT 5:40" />तब् ओइने ओकर सल्लाहा मानलेलाँ। और निउतरह्यनहे बलाके ओइन्हे पित्वैलाँ, और ओइन्हे यी आज्ञा देलाँ कि आबसे ओइने येशूक नाउँमे कुछु ना कहिँत। तब ओइने ओइन्हे छोरदेलाँ। <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />तब् निउतरह्यन यी बातसे खुशी हुइलाँ कि हम्रे येशूक लग अपमान सहना योग्यक ते ठहरली। तब ओइने ओकर पाछे महासभामेसे बाहेर चलगिलाँ। <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />यकर पाछे प्रत्येक दिन मन्दिरमे और घर-घर जाके निउतरह्यन हरदम सिखाइँत। और येशूए ख्रीष्ट हुइँत कहिके ओइने प्रचार करिँत।<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s">सात जहनके नियुक्ति</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />उ समयमे जब चेलनके संख्या बहरती जाइतिहिन। तब् ग्रीक भाषा बोलुइया यहूदी विश्वासीन हिब्रू भाषा बोलुइया यहूदी विश्वासीनके विरोधमे गुनासो करे लग्लाँ, कि प्रत्येक दिनके खाना बाँटेबेर ओइन्के विधवनहे पक्षपात हुइता। <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />तब् उ बाह्रथो चेलनके यरुशलेम शहरके दोसुर विश्वासीनहे अपन थेन बलाके कलाँ, “हम्रे निउतरह्यन खवैना-पिवैना सेवामे नै होके परमेश्वरके वचन प्रचार करना और शिक्षा देना सेवामे समय बिताई परत। <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />तबेकमारे हे मोरिक विश्वासी भैयो, तुहुरिन्मेसे पवित्र आत्मा और बुद्धिसे भरल और सक्कुहुनसे आदर भेटाइल सात जहनहे रोजो, जेनहे हम्रे यी काममे खटाई सेकी। <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />पर हम्रे भर प्राथनामे, वचनके प्रचार करनामे और शिक्षा देना सेवामे लागल पलि रहब।” <verse eid="ACT 6:4" /><verse number="5" style="v" sid="ACT 6:5" />यी बात मण्डलीक सक्कु मनैनहे मजा लग्लिन। तबेकमारे ओइने पवित्र आत्मा और विश्वाससे भरपूर रहल स्तिफनसहे चुन्लाँ। और ओकर संगसंगे फिलिप, प्रखरस, निकनोर, तीमोन, पर्मिनास और एन्टिओखिया शहरके यहूदी धरम मनुइया निकोलाउसहे फेन छन्लाँ। <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />और ओइन्हे निउतरह्यनके थेन नन्लाँ, और निउतरह्यन ओइन्के लग प्राथना करलाँ, और उ कामहे करक लग ओइन्हे नियुक्त करलाँ। <verse eid="ACT 6:6" /><verse number="7" style="v" sid="ACT 6:7" />परमेश्वरके वचन फैलतिगैल, और यरुशलेम शहरमे चेलनके संख्या बहर्तीगैलिन। बहुत्ते यहूदी पुजारीनके फेन येशू ख्रीष्टकेमे विश्वास करना शिक्षाहे स्वीकार करलाँ।<verse eid="ACT 6:7" /></para>
  <para style="s">स्तिफनसके पक्राऊ हुइलक</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />स्तिफनस अनुग्रह और शक्तिसे पूरा होके मनैनके बिच्चेम बर-बर अचम्मक काम और चमत्कार देखाए। <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />पर कौनो-कौनो मनै स्तिफनसके विरोध करलाँ। ओइने उ यहूदी बैठक भवनके सदस्यन रहिँत, जिहिहे दासत्वसे मुक्त कहिके कहिजाइत। ओइने कुरेन शहरके और अलेक्जेन्ड्रिया शहरके और किलिकिया और एशिया प्रदेशके फेन रहिँत। यने स्तिफनससे बहस करे लग्लाँ। <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />पर स्तिफनस ज्या बात कहल, ओइने ओकर कुछु फेन जवाफ देहे नै सेक्लाँ। काकरेकी पवित्र आत्मा उहिहे बुद्धिमानीसे बोलक लग सहायता कर्लिस। <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />असिके ओइने कौनो-कौनो थारु मनैनहे स्तिफनसके बारेमे झूँट बोलक लग उक्सैलाँ। ओइने असिके कहे लग्लाँ, “हम्रे यिहिहे मोशा और परमेश्वरके विरोधमे निन्दा कर्ती रहल सुनल बती।” <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />और ओइने स्तिफनसके विरोधमे जनतनहे, यहूदी दलके नेतनहे और यहूदी कानुनके गुरुनहे उक्सैलाँ। और यने आके स्तिफनसहे पकरलाँ, और उहिहे महासभक आघे लैगिलाँ। <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />और वहाँ ओइने झूँटा गवाही देहुइया साँखीनहे आघे सरलाँ। जेने स्तिफनसकेमे असिन आरोप लगैलाँ, “यी मनैया जबफेन यी पवित्र मन्दिर और मोशक नियम कानुनके विरोधमे बोलत। <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />काकरेकी यिहिहे हम्रे असिक कहत सुन्ली कि यहे नासरत गाउँक येशू यी मन्दिरहे ढलादिहीँ। और उ चालचलनहे बदलदिहीँ, जोन मोशा हम्रिहिन्हे देले बा।” <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />तब महासभामे बैठुइया सक्कु जाने ओकर ओहोँर हेरलाँ, और ओकर मुहाँर स्वर्गदूतके मुहाँर हस चम्कत देख्लाँ।<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s">महासभामे स्तिफनसके भाषण</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />तब् यहूदी प्रधान पुजारी पुँछल, “का यी आरोप सही बा?” <verse eid="ACT 7:1" /><verse number="2" style="v" sid="ACT 7:2" />स्तिफनस कहल, “हेरो दादूभैयो और महाशयहुँक्रे, सुनो। हमार पुर्खा अब्राहामहे ओकर हारान नगरमे आके बैठ्नासे आघे जब ऊ मेसोपोटामिया प्रदेशमे रहे। तब्बेहेँ महिमक परमेश्वर उहिहे दर्शन देलिस, <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />और उहिहे कलिस, ‘तुँ अपन देश और अपन नातपाँतनके थेनसे निकरके उ देशमे चल्जाऊ, जोन देश मै तुहिन्हे देखैबुँ।’ <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />तब् ऊ कल्दीनके<note caller="+" style="f"><char style="fr" closed="false">7:4 </char><char style="fq" closed="false">कल्दीनके देश </char><char style="ft" closed="false">यी वहे ठाउँ हो जहाँ कल्दीन (बेबिलोनीन) रहतिहिँत और यी मेसोपोटामिया देशके दोसुर नाउँ फेन हो।</char></note> देशमेसे निकरके हारान नगरमे जाके बैठगिल। और जब ओकर बाबा मुगिलिस, तब परमेश्वर उहिहे वहाँसे नानके यी देशमे बैठ्वादेलिस, जोन देशमे अब्बे हम्रे रथी। <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />उ समयमे परमेश्वर उहिहे कौनो उत्तराधिकार नै देलिस, अत्रे किल नै होके उहिहे गोरा धरना ठाउँ फेन नै देलिस। जब कि उ समयमे ओकर कौनो लरका फेन नै रहिस, तभुन फेन परमेश्वर उहिसे वाचा कर्लिस कि ‘मै यी देश तुहिन्हे और तोहारँ लर्कनहे देहम।’ <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />और परमेश्वर उहिहे असिक फेन कलिस, ‘तोहाँर लरका आनक देशमे परदेशी होजिहीँ। और ओइने तोहाँर लर्कनहे गुलाम बनैहीँ। और ओइने चार सौ सालसम ओइन्हे दुःख दिहीन।’ <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />फेनदोस्रे परमेश्वर उहिहे कलिस, ‘जोन जातिक ओइने गुलाम बन्हीँ, उ जातिहे मै दण्ड देहम; और ओकर पाछे उ देशमेसे ओइने बाहेर अइहीँ। और यहे देशमे आके यहे ठाउँमे ओइने मोरिक आराधना करहीँ।’ <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />और परमेश्वर अब्राहामसे एकथो वाचा करलाँ, और उहिहे कलिस कि ऊ अपन घरक सक्कु थारु मनैनके वाचक चिन्हक रुपमे खतना करवाए। ओकर पाछे अब्राहामके छावा इसहाकके जलम हुइलिस। और अठौँ दिनमे अब्राहाम ओकर खतना करदेलिस। ओकर पाछे अस्तेहेँके इसहाक अपन छावा याकूबके और याकूब फेन अपन बाह्रथो छावनके शरीरके खतना करदेहल। आब यनेहेँ हमार बाह्रथो गोत्यारीनके पुर्खा हुइताँ। <verse eid="ACT 7:8" /><verse number="9" style="v" sid="ACT 7:9" />याकूबके छावन अपन भैया योसेफसे हिस्का मुइँत। और ओइने उहिहे मिश्र देशमे एकथो गुलाम हुइक लग बेँचदेले रहिस। पर परमेश्वर ओकर संग रहिँत। <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />और परमेश्वर योसेफहे सक्कु दुःखमेसे छुटाके मिश्र देशके रज्वा फारोक आघे अनुग्रह और बुद्धि देलाँ। फारो रज्वा योसेफहे मिश्र देशमे और अपन पूरा राज दरबारमे राजपाल बनैलस। <verse eid="ACT 7:10" /><verse number="11" style="v" sid="ACT 7:11" />जब योसेफ राजपालके रुपमे रहे, तब पूरा मिश्र देश और कनान देशमे अनिकाल परगिलस। जेकर कारण ओइन्केमे बरवार कष्ट अइलिन, और हमार पुर्खनहे खाना नै मिल्लिन। <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />पर जब याकूब यी बात सुनल कि मिश्र देशमे अनाज बा, तब ऊ हमार पुर्खनहे सुरुकचो उ देशमे पठैलस। ओइने योसेफहे भेँटा करलाँ, और अनाज किन्लाँ। पर ओइने (हमार पुर्खनके) योसेफहे नै चिहिन्लाँ। <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />दोसुरचो जब ओइने अनाज लेहे गैलाँ ते योसेफ अपन दादू-भैयनहे बतादेहल कि ऊ के हो कहिके, और फारो रज्वाहे योसेफके परिवारके बारेमे पता चलगिलिस। <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />तब योसेफ अपन बाबा याकूबहे और अपन सक्कु गोत्यारीनहे जेने जम्मा पचहत्तर जाने रहिँत। ओइन्हे ऊ मिश्र देशमे आइक लग खबर पठाइल। <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />तब याकूब मिश्र देशमे गैल; और थोरिक समय पाछे हमार बाह्रथो गोत्यारीनके पुर्खन वहैँ मुगिलाँ। <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />ओकरपाछे मिश्र देशके मनै याकूब और ओकर छावनके मुअल शरीरहे हमार देश कनानमे लयन्लाँ। और ओइने याकूबके मुअल शरीरहे उ चिहानमे दफ्नैलाँ, जोन चिहानहे अब्राहाम एकथो पक्का मोल तिरके किन्ले रहे। और ओइने याकूबके छावनहे शकिम शहरके उ ठाउँमे दफ्नैलाँ, जोन जग्गा याकूब हामोरके छावनसे किन्ले रहे। <verse eid="ACT 7:16" /><verse number="17" style="v" sid="ACT 7:17" />पर जब अब्राहामहे परमेश्वरके देलक वाचा पूरा हुइना समय लग्गे आइल, तब मिश्र देशमे उ मनै बह्रे लग्लाँ। और ओइन्के संख्या धेउर होगिलिन। <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />तब् मिश्र देशमे दोसुर रज्वा अइलस जे योसेफहे नै चिन्हे। <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />ऊ हमार पुर्खनहे चलाँखीसे अन्याय कर्लस। और यी आदेश देहल कि प्रत्येक दाई-बाबा अपन भर्खर हुइलक लर्कनहे बाहेर फेँकादिँत, ताकि उ लरका मुजाँइत। <verse eid="ACT 7:19" /><verse number="20" style="v" sid="ACT 7:20" />वहे समयमे मोशक जलम हुइलिस। और ऊ परमेश्वरके नजरमे महा सुग्घुर रहे। और तीन महिनासम ओकर दाईबाबनसे गोप्य रुपमे ओकर रेखदेख हुइलिस। <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />पर जब ओइने उहिहे आकुर धेउर नुकाई नै सेक्लाँ, ते ओइने उहिहे घरेमसे बाहेर धारदेलाँ। और फारो रज्वक छाई उहिहे लैजाके अपने छावा हस पालपोष कर्लिस। <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />मोशाहे मिश्र देशके मनैनके सक्कु विद्या पह्रागिलिस। और मोशा बात बत्वैनामे सिपार और काम करनामे शक्तिशाली रहे। <verse eid="ACT 7:22" /><verse number="23" style="v" sid="ACT 7:23" />जब मोशा चालीस सालके हुइल ते ओकर मनमे अपन इजरायली दादू-भैयनहे भेँटा करना विचार अइलिस। <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />और वहाँ ऊ एकथो इजरायली मनैयाहे अन्याय हुइत देख्के उहिहे बँचैलस। और मिश्र देशके नागरिकहे मुवाके बद्ला लेहल। <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />मोशा सोँचल कि ओकर दादू-भैयन सोच्हीँ कि परमेश्वर ओकर हाँथेलेके ओइन्के गुलामीसे ओइन्हे मुक्ति दिहीँ, पर ओइने नै बुझ्लाँ। <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />दोसुर दिन जब इजरायली मनै आपसमे झगरा खेलतिहिँत, तब मोशा वहाँ पुगगिलस। और असिक कहिके ओइन्हे सम्झाके मिलाई खोजल, ‘हे मनै, तुहुरे ते दादू-भैया हुइतो, ते तुहुरे एकदोसर जहनहे काकरे अन्याय करथो?’ <verse eid="ACT 7:26" /><verse number="27" style="v" sid="ACT 7:27" />पर जे अपन परोसीहे अन्याय करतेहे, ऊ असिक कहिके मोशाहे धकेलल, ‘हमारिकमे हाकिम और न्यायकर्ता हुइक लग तुहिन्हे के नियुक्त करल? <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />जसिके तुँ काल मिश्र देशके मनैयाहे मुवैलो, का ओस्तेके तुँ महिन्हे फेन मुवाई चहथो?’ <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />असिन जवाफ सुनके मोशा डरागिलस। और ऊ मिश्र देशमेसे भागके मिद्यान देशमे जाके परदेशी होके रहे लागल; और वहाँ ओकर दुईथो छावनके जलम हुइलिस। <verse eid="ACT 7:29" /><verse number="30" style="v" sid="ACT 7:30" />मिद्यान देशमे मोशा चालीस साल रहिके सेकल ते मोशा सीनै पहाड़के उजाड़-ठाउँमे बर्ती रहल झर्कत्तीमे एकथो स्वर्गदूतहे देखल। और उ स्वर्गदूतके माध्यमसे परमेश्वर मोशासे बात बत्वैलाँ। <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />जब मोशा बर्ती रहल झर्कत्तीहे देखल। जोन झर्कत्ती बरतेहे, पर नै जरतेहे। ते ऊ छक्क परके दंग परगिलस। और जब हेरक लग ऊ लग्गे गैलस ते ऊ प्रभुक असिन आवाज सुनल, <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />‘मै तोहाँरिक पुर्खा अब्राहाम, इसहाक और याकूबके परमेश्वर हुइतुँ।’ तब मोशा डरकमारे लग्लगाई लागल। और ओहोँर हेरनासम फेन ओकर हिम्मत नै हुइलिस। <verse eid="ACT 7:32" /><verse number="33" style="v" sid="ACT 7:33" />तब् प्रभु उहिहे कलिस, ‘महिन्हे आदर देखाइक लग अपन गोरक जुत्ता खोललेऊ। काकरेकी जोन ठाउँमे तुँ ठरह्याइल बतो, उ पवित्र ठाउँ हो। <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />मिश्र देशमे रहल मोरिक मनैनके दुःख-कष्ट भोग्लक मै देख्ले बतुँ। और ओइन्के रुइलक सुन्ले बतुँ। तबेकमारे मै ओइन्हे बँचाइक लग आइल बतुँ। और यी कामके लग मै तुहिन्हे मिश्र देशमे पठैम।’ <verse eid="ACT 7:34" /><verse number="35" style="v" sid="ACT 7:35" />यी वहे मोशा हो, जिहिहे इजरायलीन अस्वीकार कर्ले रहिँत। और जेने कले रहिँत, ‘हमारिकमे हाकिम और न्यायकर्ता हुइक लग तुहिन्हे के नियुक्त करल?’ उहिएहे परमेश्वर हाकिम और न्यायकर्ता बनाके उ स्वर्गदूतके माध्यमसे पठैलाँ, जोन स्वर्गदूत मोशाहे बर्ती रहल झर्कत्तीमे देखा परल रहे। <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />यहे मनैया मिश्र देशमे, लाल समुन्दरमे और उजाड़-ठाउँमे चालीस सालसम अचम्मक काम और चिन्हा देखाके ओइन्हे बाहेर निकारके लयानल। <verse eid="ACT 7:36" /><verse number="37" style="v" sid="ACT 7:37" />यी वहे मोशा हो, जे इजरायल देशके मनैनहे कले रहे, ‘परमेश्वर तुहुरिन्के दादू-भैयनमेसे तुहुरिन्के लग मोरिक हस एकथो अगमवक्ता तयार परहीँ।’ <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />यहे मोशा एकथो अगुवक रुपमे हमार पुर्खनके संग रहे, जब ओइने उजाड़-ठाउँमे एक्के संग जमा हुइल रहिँत। जब स्वर्गदूत मोशासे सीनै पहाड़मे बात बत्वाइल, और वहाँ मोशाहे जीवन देना वचन मिल्लिस, तब उ वचन मोशा हमार थेन पुगैलस। <verse eid="ACT 7:38" /><verse number="39" style="v" sid="ACT 7:39" />पर हमार पुर्खनके ओकर आज्ञा पालन करना अस्वीकार करलाँ; बेन उहिहे अस्वीकार करके ओइने मिश्र देशमे फिर्ता जैना चाहिँत। <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />और ओइने मोशक दादू हारुनहे कलाँ, ‘हमार लग एकथो असिन देउँता बनादेऊ, जे मिश्र देशमे जाइक लग हमार अगुवाई करे सेके। काकरेकी यी मोशा जे हम्रिहिन्हे मिश्र देशमेसे निकारके नानल बा। हम्रे नै जन्थी कि यिहिहे का हुइल बतिस।’ <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />उ समयमे ओइने एकथो बछरवक मूर्ति बनैलाँ। और ओकर आघे बलि चह्रैलाँ। और जोन मूर्ति ओइने अपन हाँथेलेके बनाइल रहिँत, ओकर लग ओइने खुशियाली मनैलाँ। <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />तबेकमारे परमेश्वर ओइन्से रिसागिलिन। और ओइन्हे ओइने आकाशमे रहल सूर्य, जोन्ह्याँ और तोरैँयनहे अपन देउँतनके रुपमे पुजिँत कहिके छोरदेलिन। जसिके परमेश्वरके अगमवक्तनके किताबमे लिखल बा,</para>
  <para style="q" vid="ACT 7:42">‘हे इजरायल देशके मनै, का तुहुरे उजाड़-ठाउँमे चालीस सालसम पशुबलि और अनाज-बलि महिन्हे चह्रैलो?</para>
  <para style="q" vid="ACT 7:42">नै, तुहुरे उ चिज दोसुर देउँतनहे चह्रैलो।<verse eid="ACT 7:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="ACT 7:43" />और तुहुरे उ तम्बूहे बोक्लो, जेम्ने तुहुरिन्के देउँता मोलोखके मूर्ति और तुहुरिन्के देउँता रेफनके तोरैयँक फोँटु रहिस।</para>
  <para style="q" vid="ACT 7:43">अर्थात उ मूर्तिनहे जेनके आराधना करक लग तुहुरे बनैले रहो।</para>
  <para style="q" vid="ACT 7:43">तबेकमारे मै तुहुरिन्हे अन्जान देशमे पठादेहम, जोन देश बेबिलोन शहरसे बहुत दूर बा।’”<verse eid="ACT 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />गवाहीक तम्बू उजाड़-ठाउँमे हमार पुर्खनके थेन रहिन। यिहिहे ठिक परमेश्वरसे मोशाहे देगिलक आदेश अनुसार बनागिल रहे, जेकर आकार मोशा अप्निहीँ देख सेकल रहे। <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />बहुत साल पाछे हमार पुर्खनके यी गवाहीक तम्बूहे यहोशूक अगुवाइमे अपन संग उ ठाउँमे लयन्लाँ, जोन ठाउँहे ओइने अपन अधिकारमे करलेले रहिँत। और जहाँसे परमेश्वर हमार पुर्खनके आघेसे गैर-यहूदिनहे निकारदेले रहिँत। और उ तम्बू दाऊद रज्वक समयसम पलिरहल। <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />परमेश्वर दाऊदकेमे अनुग्रह करलाँ, और दाऊद याकूबके परमेश्वरके लग एकथो बैठ्ना ठाउँ बनाइक लग परमेश्वरसे अनुमति माँगल। <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />पर परमेश्वरके लग मन्दिर दाऊदके छावा सुलेमान बनैलस। <verse eid="ACT 7:47" /><verse number="48" style="v" sid="ACT 7:48" />पर सर्वोच्च परमेश्वर हाँथेलेके बनाइल मन्दिरमे नै रथाँ। जसिके परमेश्वरके अगमवक्ता यशैयक किताबके लिखल बा,<verse eid="ACT 7:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="ACT 7:49" />“परमेश्वर कथाँ, स्वर्ग मोरिक सिंहासन हो। और पृथ्वी मोरिक गोरा धरना ठाउँ हो।</para>
  <para style="q" vid="ACT 7:49">तुहुरे मोरिक लग एकथो मन्दिर बनाई नै सेक्बो जहाँ मै रथुँ।</para>
  <para style="q" vid="ACT 7:49">और तुहुरे मोरिक लग एकथो बिँसैना ठाउँ फेन बनाई नै सेक्बो।<verse eid="ACT 7:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="ACT 7:50" />का मै अप्निहीँ यी सक्कु चिजहे नै बनैनु?”<verse eid="ACT 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />“तुहुरिन्के मन गैर-यहूदिनके हस हेँक्कर होगिल बा, और तुहुरे परमेश्वरके बात मन्ना और सुन्नासे अस्वीकार करथो। अपन बाबा-पुर्खनके हस तुहुरे फेन पवित्र आत्मक देखाइल बातहे कबु फेन नै मन्थो। <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />तुहुरिन्के पुर्खन परमेश्वरके सक्कु अगमवक्तनहे सतैलाँ। और ओइने उ अगमवक्तनहे मुवादेलाँ, जेने ख्रीष्टके बारेमे अगमवाणी कर्ले रहिँत जोन ख्रीष्ट धर्मी रहिँत। और जब ख्रीष्ट अइलाँ ते तुहुरे हुँकिन्हे धोखा देलो, और हुँकिन्हे मुवाँदेलो। <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />तुहुरे स्वर्गदूतनके हाँथेमेसे परमेश्वरके मोशक नियम कानुन भेटैलो, पर तुहुरे ओकर पालन नै करलो।”<verse eid="ACT 7:53" /></para>
  <para style="s">स्तिफनसके हत्या</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />स्तिफनसके बात सुनके यहूदी अगुवन रिसेलेके चुर होगिलाँ। और ओइने स्तिफनसहे देख्के दाँत किचकिचाई लग्लाँ। <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />पर ऊ पवित्र आत्मासे भरपूर होके स्वर्ग ओहोँर हेरल। और ऊ परमेश्वरके शक्तिशाली महिमा देखल, और येशूहे परमेश्वरके दाहिन पाँजर ठरह्याइल फेन देखल। <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />और कहल, “हेरो, मै स्वर्गहे उघ्रल और मनैयक छावाहे परमेश्वरके दाहिन पाँजर ठरह्याइल देखतुँ।” <verse eid="ACT 7:56" /><verse number="57" style="v" sid="ACT 7:57" />यी बात सुन्तिकिल ओइने चिल्लैती अपन कान बुजलेलाँ। तब ओइने रिसाके एक्के संग स्तिफनसकेमे झपटपरलाँ। <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />और ओइने स्तिफनसहे यरुशलेम शहरमेसे बाहेर निकारके ओकर उप्पर पठरा बर्साई लग्लाँ। और उहिहे मुवाई खोज्लाँ। और स्तिफनसहे आरोप लगुइया मनै अपन बाहेर घल्ना लुग्गाहे खोलके शाऊल नाउँ रहल एकथो जवान मनैयक गोरातिर धारदेलाँ। <verse eid="ACT 7:58" /><verse number="59" style="v" sid="ACT 7:59" />जब ओइने स्तिफनसकेमे पठरा मारतिहिँत, तब स्तिफनस असिके प्राथना करल, “हे प्रभु येशू, मोरिक आत्माहे स्वीकार करलेऊ।” <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />तब स्तिफनस ठेहुनी टेकके बरका स्वरमे चिल्लाके कहल, “हे प्रभु, यी पापके लग यनहे दण्ड ना देबी।” अतरा कहिके सेकके स्तिफनस मुगिलस।<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="s">विश्वासीनकेमे शाऊलके अत्याचार कर्लक</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />शाऊल स्तिफनसहे मुवैनामे पूरा रुपमे सहमत रहे। वहे दिन यरुशलेम शहरके मण्डलीमे बरवार दुःख और सतावट हुई लग्लिन। और निउतरह्यनके बाहेक सक्कु जाने यहूदिया प्रदेश और सामरिया प्रदेशमे छिदिरबिदिर होगिलाँ। <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />और परमेश्वरके आदर करुइया कौनो-कौनो थारु मनै स्तिफनसके मुअल शरीरहे चिहानमे धरलाँ। और ओकर लग बरवार शोक मनैलाँ। <verse eid="ACT 8:2" /><verse number="3" style="v" sid="ACT 8:3" />पर शाऊल मण्डलीहे सताइतेहे; और घर-घर पैँठ्के विश्वासी थारु और जन्नी मनैनहे घिँस्याघिँस्याके झेलमे दारतेहे।<verse eid="ACT 8:3" /></para>
  <para style="s">सामरिया प्रदेशमे फिलिप</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />पर जोन-जोन विश्वासीन छिदिरबिदिर हुइल रहिँत, ओइने खुशीक खबर प्रचार करे लग्लाँ। <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />और फिलिप सामरिया प्रदेशके एकथो नगरमे जाके ख्रीष्टके बारेमे मनैनहे शिक्षा देहे लागल। <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />फिलिप जोन बात कहल और जोन चमत्कार ऊ देखैलस, उ देख्के भीड़के मनै एक मन बनाके ओकर प्रवचन सुने लग्लाँ। <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />काकरेकी जब फिलिप आदेश देहल ते बहुत्ते मनैनकेमेसे भूत्वन बरका आवाज निकारके चिल्लैती निकरगिलाँ। और बहुत्ते अपाहिज और कुँज मनै फेन चोखागिलाँ। <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />असिके उ शहरके बहुत्ते मनै आनन्दित होगिलाँ।<verse eid="ACT 8:8" /></para>
  <para style="s">जादू देखुइया सिमोन</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />उ नगरमे सिमोन नाउँ रहल एकथो मनैया रहे जे जादू देखाके सामरिया प्रदेशके मनैनहे छक्क परवाके दंग परवैले रहे। और ऊ अपनहे अप्निहीँ भारी मनैया हुइतुँ कना माने। <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />उ मनैयाहे छुटिसे भारीसम सक्कु मनै आदर करिँत और यी मानिँत, “यी मनैया परमेश्वरके उ शक्ति हो, जिहिहे महाशक्ति कहिजाइत।” <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />ओइने ओकर आदर करिँत, काकरेकी बहुत पैलेहेँसे ऊ अपन जादू देखाके मनैनहे छक्क पर्वाइल रहे। <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />पर जब मनै फिलिपके सुनाइल सन्देश सुनके परमेश्वरके राज और येशू ख्रीष्टके नाउँक खुशीक खबरमे विश्वास करलाँ, तब् सक्कु थारु मनै और जन्नी मनै डुब्कि लेलाँ। <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />सिमोन अप्निहीँ फेन फिलिपके सुनाइल सन्देशमे विश्वास करल, और ऊ डुब्कि लेहल। और फिलिप जहाँ-जहाँ गैल, सिमोन ओकर अनुशरण करे लागल, और चिन्हा और बर-बर शक्तिशाली काम देख्के उहिहे अचम्म लागिस।<verse eid="ACT 8:13" /></para>
  <para style="s">सामरिया प्रदेशके मनै पवित्र आत्मा भेटैलक</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />सामरिया प्रदेशके मनै परमेश्वरके वचन स्वीकार करलाँ कना बात सुनके यरुशलेम शहरमे रहल निउतरह्यन पत्रुस और यूहन्नाहे ओइन्के थेन पठैलाँ। <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />वहाँ पुगके ओइने सामरिया प्रदेशके मनै पवित्र आत्मा भेटाँइत कहिके ओइन्के लग प्राथना करलाँ। <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />काकरेकी तबसम ओइन्मेसे केक्रोमे फेन पवित्र आत्मा नै पठागिल रहिन। ओइने प्रभु येशूक नाउँमे डुब्कि किल लेले रहिँत। <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />तब् पत्रुस और यूहन्ना अपन हाँथ ओइन्के उप्पर धरलाँ, और ओइने पवित्र आत्मा भेटैलाँ।<verse eid="ACT 8:17" /></para>
  <para style="s">सिमोनके पाप</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18" />आब निउतरह्यन हाँथ धरलेसे पवित्र आत्मा मिलत कना देख्के सिमोन असिक कती ओइन्के थेन रुपिया नानके कहल, <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />“महिन्हे फेन यी शक्ति देऊ, और मै जेकरमे फेन हाँथ धारम ऊ पवित्र आत्मा भेटाजाए।” <verse eid="ACT 8:19" /><verse number="20" style="v" sid="ACT 8:20" />पर पत्रुस उहिहे कहल, “तैँ और तोरिक रुपिया नाश होजाए, काकरेकी तैँ परमेश्वरके वरदान रुपियालेके किने सेकजाइत कहिके सोँच्ले। <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />यी सेवामे ना ते तोरिक बखरा बा, ना ते तोरिक हिस्सा बा; काकरेकी परमेश्वरके आघे तोरिक मन ठिक नै हो। <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />तबेकमारे तैँ दुष्टतासे सोँच्ना बन्द करदे, और प्रभुसे प्राथना कर, सायद परमेश्वर तोरिक खराब सोँचहे माफ करदेथाँ कि। <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />तैँ अपन मन बदलके पाप करना छोरदे, काकरेकी मै देखतुँ, कि तैँ गजब हिस्का मुथे, और पापके गुलामीमे बते।” <verse eid="ACT 8:23" /><verse number="24" style="v" sid="ACT 8:24" />तब् सिमोन पत्रुस और यूहन्नाहे कहल, “तुहुरे मोरिक लग प्राथना करदेऊ, और तुहुरिन्के कहल कौनो फेन बात मोरिकमे ना आए।” <verse eid="ACT 8:24" /><verse number="25" style="v" sid="ACT 8:25" />तब पत्रुस और यूहन्ना गवाही देके और प्रभु येशूक वचन सुनाके सेक्लाँ ते यरुशलेम शहरमे फिर्ता हुइती, ओइने सामरिया प्रदेशके बहुत्ते गाउँमे खुशीक खबर प्रचार करलाँ।<verse eid="ACT 8:25" /></para>
  <para style="s">इथियोपियाके बरका पदाधिकारी</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />ओकरपाछे प्रभुक एकथो स्वर्गदूत फिलिपहे कहल, “उठ्के दक्खिन ओहोँर यरुशलेम शहरमेसे गाजा शहर ओहोँर जैना डगरमे जाऊ। उ डगर उजाड़-ठाउँमे बा।” <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />तब् फिलिप उठ्के चलगिल, और एकफाले इथोयोपिया देशके एकथो नपुंसक मनैयासे ओकर भेँटा हुइलिस। ऊ नपुंसक एकथो महत्त्वपूर्ण अधिकारी रहे, जे इथोयोपिया देशके रानीक सक्कु सम्पतिक कोषाध्यक्ष रहे। और ऊ आराधना करक लग यरुशलेम शहरमे आइल रहे। <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />ऊ रथमे बैठ्के अपन देशमे फिर्ता जाइतेहे। और परमेश्वरके अगमवक्ता यशैयक किताब जोरसे पह्रतेहे। <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" />तब् पवित्र आत्मा फिलिपहे कहल, “जाऊ और उ रथके संगसंगे नेँगो।” <verse eid="ACT 8:29" /><verse number="30" style="v" sid="ACT 8:30" />फिलिप दौरके रथके लग्गे पुगल और उहिहे परमेश्वरके अगमवक्ता यशैयक किताब पह्रत सुनके ऊ उहिहे पुँछल, “अप्नि ज्या पह्रती, का उ अप्नि बुझती?” <verse eid="ACT 8:30" /><verse number="31" style="v" sid="ACT 8:31" />तब् ऊ कहल, “यदि केऊ महिन्हे नै बुझादी कलेसे मै यिहिहे बुझे नै सेकम।” तब् ऊ फिलिपहे अनुरोध करल कि ऊ रथमे चहुँरके ओकर थेन बैठ्जाए। और फिलिप ओकर थेन जाके बैठगिलस। <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />आब ओकर पहर्लक पवित्र शास्त्र मनिक खण्ड यी रहे।</para>
  <para style="q" vid="ACT 8:32">“जसिके भेँरवा काटक लग लैजागिल रहत।</para>
  <para style="q" vid="ACT 8:32">या पठ्वा ऊन कटुइयनके थेन चिमचाम रहत।</para>
  <para style="q" vid="ACT 8:32">ओस्तेके जब मनै हुँकिन्हे दुःख देलाँ ते।</para>
  <para style="q" vid="ACT 8:32">ऊ फेन अपन मुह नै खोल्लाँ।<verse eid="ACT 8:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="ACT 8:33" />ऊ अपमानित हुइलाँ।</para>
  <para style="q" vid="ACT 8:33">और हुँकिन्हे न्याय नै मिल्लिन।</para>
  <para style="q" vid="ACT 8:33">हुँकार सन्तानके बारेमे केऊ नै बताई सेकी।</para>
  <para style="q" vid="ACT 8:33">काकरेकी हुँकार कौनो सन्तान हुइनासे पैलेहेँ मनै हुँकिन्हे मुवाँदेलाँ।”<verse eid="ACT 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34" />तब् उ नपुंसक फिलिपहे कहल, “मै अप्निहे अनुरोध करतुँ कि महिन्हे यी बतादी कि परमेश्वरके अगमवक्ता यी बात केकर बारेमे बोलतताँ। हुँकार अपने बारेमे हुइतिन कि औरे केक्रो दोसुर जहनके बारेमे?” <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />तब् फिलिप बोल्ना सुरु करल, और पवित्र शास्त्रक यहे खण्डमेसे सुरु करके उहिहे खुशीक खबर सुनाइल। तबेकमारे उ अधिकारी बुझगिलस, और येशू ख्रीष्टकेमे विश्वास करलेहल। <verse eid="ACT 8:35" /><verse number="36" style="v" sid="ACT 8:36" />और जब ओइने डग्रेडगर जाइतिहिँत, तब ओइने डग्रिक आँरितिर एकथो तल्वा देख्लाँ। तब उ नपुंसक कहल, “हेरी, यहाँ पानी बा, और आब महिन्हे डुब्कि लेनामे का कौनो बाधा बा?” <verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" />फिलिप जवाफ देहल, “यदि अप्नि पूरा मनसे विश्वास कर्थी कलेसे अप्नि डुब्कि लेहे सेक्बी।” ऊ जवाफ देहल, “ख्रीष्ट येशूए परमेश्वरके छावा हुइताँ कहिके मै विश्वास करतुँ।” <verse eid="ACT 8:37" /><verse number="38" style="v" sid="ACT 8:38" />तब ऊ रथ रोक्ना आज्ञा देहल। और तब् फिलिप और उ नपुंसक दुनु जाने तल्वामे गैलाँ, और फिलिप उहिहे डुब्कि देहल। <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />जब ओइने पानीमेसे बाहेर निकरके अइलाँ ते पवित्र आत्मा फिलिपहे उ नपुंसकके आघेसे दूर लैगिलिस। और उ नपुंसक फिलिपहे फेनदोस्रे कबु नै देखल। और ऊ खुशी होगिल कि परमेश्वर उहिहे बँचालेलिस, और ऊ अपन देशमे चलगिलस। <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />पर फिलिप अपनहे अश्दोश शहरमे भेटाइल। और जबसम ऊ कैसरिया शहर नै पुगल, तबसम ऊ प्रत्येक शहर और गाउँमे खुशीक खबरके प्रचार कर्ती एकथो ठाउँमेसे दोसुर ठाउँमे जैती रहल।<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s">शाऊलके जीवन परिवर्तन</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />शाऊल प्रभु येशूक चेलनहे मुवैना धम्की देती रहल। और ऊ प्रधान पुजारीक थेन गैल। <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />तब ऊ “दमस्कस शहरमे रहल बैठक भवनके शासकहुँक्रिहिन्हे मोरिक परिचय देके चिट्ठी लिख्देऊ”, कहिके अनुरोध करल। और “कौनो फेन थारु मनै और जन्नी मनै जेने ख्रीष्टके डगरमे नेंग्था, उ सक्कुहुनहे खोज-खोजके पकरके यरुशलेम शहरमे नाने भेटाऊँ”, कहिके शाऊल अधिकार माँगल। <verse eid="ACT 9:2" /><verse number="3" style="v" sid="ACT 9:3" />पर जब शाऊल और ओकर संघरियन यात्रा करतिहिँत। तब ओइने दमस्कस शहरके लग्गे पुग्लाँ ते एकफाले आकाशमेसे एकथो ओजरार ओकर चारु ओहोँर चम्कलिस। <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />तब ऊ भुइयाँमे गिर पर्लस। और ऊ परमेश्वरके असिन बोली सुनल, “हे शाऊल, हे शाऊल, तुँ महिन्हे काकरे सताइतो?” <verse eid="ACT 9:4" /><verse number="5" style="v" sid="ACT 9:5" />तब शाऊल पुँछल, “हे प्रभु, अप्नि के हुइती?” तब् ऊ कलाँ, “मै येशू हुइतुँ; जिहिहे तुँ सताइतो। <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />पर उठ्के आब तुँ नगरमे जाऊ, और केऊ तुहिन्हे बतादी कि मै तुहिन्से का करवाई चहथुँ।” <verse eid="ACT 9:6" /><verse number="7" style="v" sid="ACT 9:7" />जोन मनै ओकर संग जाइतिहिँत, ओइने चिमचाम रहिगिलाँ। काकरेकी ओइने बोली ते सुनतिहिँत, पर ओइने किहुहे फेन नै देखतिहिँत। <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />तब् शाऊल भुइयाँमेसे उठल, और आँखी खोलल ते ऊ कुछु फेन नै देखे लागल। और बाँकी मनै ओकर हाँथ पकरके उहिहे दमस्कस शहरमे लैगिलाँ। <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />तब् तीन दिनसम ऊ आँधर होगिल, और ना ते ऊ कुछु खाइल, और ना कुछु पिअल।<verse eid="ACT 9:9" /></para>
  <para style="s">शाऊलके डुब्कि लेलक</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />दमस्कस शहरमे हननिया नाउँ रहल प्रभु येशूक एकथो चेला रहे। उहिहे प्रभु येशू दर्शनमे कलाँ, “ए हननिया।” तब हननिया कहल, “मै यहैँ बतुँ प्रभु।” <verse eid="ACT 9:10" /><verse number="11" style="v" sid="ACT 9:11" />तब् प्रभु हननियाहे कलाँ, “उठो, और ‘सोझ’ नाउँक गल्लीमे जाऊ। और वहाँ यहूदक घरेम शाऊल नाउँक टार्सस शहरके मनैयाहे खोजो। काकरेकी ऊ प्राथना करता। <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />शाऊल दर्शनमे देखल बा कि हननिया नाउँ रहल एकथो मनैया आके ओकरमे हाँथ धारे, ताकि ऊ फेनदोस्रे देख्नाहाँ होजाए।” <verse eid="ACT 9:12" /><verse number="13" style="v" sid="ACT 9:13" />पर हननिया जवाफ देहल, “हे प्रभु, मै यी मनैयक बारेम बहुत मनैनसे सुनल बतुँ कि यी यरुशलेम शहरमे अप्निक पवित्र मनैनहे कत्थुक सतैले बा। <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />और यहाँ फेन जोन-जोन मनै अप्निकमे विश्वास करथाँ, ओइन्हे बहानके यरुशलेम शहरमे लैजाए कहिके यिहिहे मुख्य पुजारीनसे अधिकार मिलल बतिस।” <verse eid="ACT 9:14" /><verse number="15" style="v" sid="ACT 9:15" />पर प्रभु उहिहे कलाँ, “तुँ जाऊ। काकरेकी मै यिहिहे गैर-यहूदिनके, रज्वनके और इजरायलीनके आघे मोरिक नाउँक प्रचार करक लग और मोरिक सेवा करवाइक लग रोजल बतुँ। <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />और मै उहिहे बतैम कि मोरिक बारेम बतैलक कारण उहिहे कसिन-कसिन दुःख उठाई परहिस।” <verse eid="ACT 9:16" /><verse number="17" style="v" sid="ACT 9:17" />तब् हननिया उठ्के उ घरेम गैल जहाँ शाऊल रहे। और ओकरमे अपन हाँथ धारके कहल, “हे शाऊल भैया, महिन्हे उ प्रभु येशू पठैले बताँ, जिहिहे तुँ उ डगरमे देख्ले रहो, जोन डगर सोज तुँ आइल रहो। तुँ देख्नाहाँ हुई सेको, और पवित्र आत्मासे भरिपूर्ण हुई सेको कहिके ऊ महिन्हे पठैले बताँ।” <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />जुरतेहेँ ओकर आँखीमेसे सेवाँर हस कुछु चिज गिरलिस, और ऊ फेनदोस्रे देख्नाहाँ होगिल। तब् ऊ उठल और डुब्कि लेहल, <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />तब् खाना खाके ऊ बल भेटाइल। शाऊल बहुत्ते दिनसम दमस्कस शहरमे चेलनके संग रहल।<verse eid="ACT 9:19" /></para>
  <para style="s">दमस्कस शहरमे शाऊल</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 9:20" />तब् जुरतेहेँ दमस्कस शहरके बैठक भवनहुँक्रिहिनमे “येशूए परमेश्वरके छावा हुइँत” कहिके ऊ येशूक प्रचार करे लागल। <verse eid="ACT 9:20" /><verse number="21" style="v" sid="ACT 9:21" />तब् सुनुइयन भर सक्कु जाने अचम्म मानके कलाँ, “का यी वहे मनैया नै हो, जे उ मनैनहे यरुशलेम शहरमे खोब सताइल, जेने येशू ख्रीष्टकेमे विश्वास करिँत। और का यी वहे मनैया नै हो, जे ओइन्हे बहानके मुख्य पुजारीनके थेन लैजाइक लग आइल रहे?” <verse eid="ACT 9:21" /><verse number="22" style="v" sid="ACT 9:22" />पर शाऊल आकुर धेउर शक्तिशाली रुपमे प्रचार करना सुरु करदेहल। और येशूए ख्रीष्ट हुइताँ कहिके ऊ असिन एकथो पक्का सबुत देहल कि दमस्कस शहरके यहूदिन कुछु फेन जवाफ देहे नै सेक्लाँ। <verse eid="ACT 9:22" /><verse number="23" style="v" sid="ACT 9:23" />जब शाऊलके दमस्कस शहरमे रलक बहुत्ते समय बितगिलिस, तब् यहूदी दलके नेतन मिलके उहिहे मुवैना षड़यन्त्र बनैलाँ। <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />पर ओइन्के षड़यन्त्र शाऊलहे पता चलगिलिस: ओइने उहिहे मुवाइक लग रातदिन शहरके दवारमे नुकके बैठिँत। <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />एक दिन रातके समयमे ओइने शाऊलहे पठरक उ महा ढेंग देवालमे लैगिलाँ, जोन देवाल शहरहे घेरल रहे। तब चेलनके देवालके एकथो खुलल ठाउँमेसे लस्रीक प्रयोग करके छिट्वामे बैठ्वाके शाऊलहे तरे उतारदेलाँ। और असिके ऊ दमस्कस शहरमेसे बँचके निकरगिलस।<verse eid="ACT 9:25" /></para>
  <para style="s">यरुशलेम शहरमे शाऊल</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />शाऊल यरुशलेम शहरमे गैल, और ऊ चेलनके संग शामिल हुइना कोशिस करल। पर ओइने सक्कु जाने शाऊलसे डराइल रहिँत। और शाऊल फेन आब जात्तिकमे येशूक चेला बनगिल बा कहिके ओइने विश्वास करे नै सेकतिहिँत। <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />पर बारनाबास शाऊलहे निउतरह्यनके थेन लैगिलस। और ओइन्हे फरछ्वारसे बतादेहल कि दमस्कस शहरमे जैना डगरमे शाऊलहे येशू कसिन दर्शन देले रहिस। और प्रभु उहिसे बात बत्वैलिस। और कसिके शाऊल दमस्कस शहरमे येशूक नाउँक प्रचार बिना डरैले कर्लस। <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />निउतरह्यन बारनाबासके बातमे विश्वास करलाँ। तबेकमारे शाऊल यरुशलेम शहरमे निउतरह्यनके संग रहे लागल। और येशू ख्रीष्टके नाउँक प्रचार बिना डरैले करे लागल। और ऊ यरुशलेम शहरके प्रत्येक ठाउँमे गैलस। <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />और शाऊल ग्रीक भाषा बोलुइया यहूदिनके संग बात बत्वाए और ओइन्से वाद-विवाद करे। पर ओइने उहिहे मुवाइक खोजतिहिँत। <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />जब दोसुर विश्वासी भैयन यी बातके बारेम पता पैलाँ ते ओइने शाऊलहे कैसरिया शहरमे लैगिलाँ। और वहाँसे ओइने उहिहे जहाजमे बैठ्वाके टार्सस नगरमे पठादेलाँ, जोन नगर ओकर अपन ठाउँ रहिस। <verse eid="ACT 9:30" /><verse number="31" style="v" sid="ACT 9:31" />असिके सारा यहूदिया प्रदेश, गालील प्रदेश और सामरिया प्रदेशके मण्डलीमे शान्ति होगिलिन, और मण्डली बल्गर होगिल। प्रभुक डरमे नेंग्ती और पवित्र आत्मासे हौसती बहुत्ते मनै प्रभु येशूकमे विश्वास करलाँ।<verse eid="ACT 9:31" /></para>
  <para style="s">एनियास और डोरकास</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />तब असिके हुइल कि पत्रुस उ सक्कु प्रदेशके प्रत्येक ठाउँमे गैलस, और परमेश्वरके उ पवित्र मनैनहे भेँटा करे गैल, जेने लुद्दा नगरमे रहिँत। <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />ऊ वहाँ एनियास नाउँक कौनो एकथो मनैयाहे भेटाइल, जे आठ सालसे कुँज रोगसे पठरीमे परल रहे। <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />पत्रुस उहिहे कहल, “ए एनियास! येशू ख्रीष्ट तुहिन्हे चोख्वादिहिँ। उठो, और अपन पठरी उसराऊ।” तब् ऊ जुरतेहेँ उठ्गिलस। <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />और उहिहे देख्के लुद्दा और शारोन नगरमे रहुइया सक्कु जाने प्रभु येशूकमे विश्वास करलाँ।<verse eid="ACT 9:35" /></para>
  <para style="s">डोरकासहे जीवनदान</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />योप्पा नगरमे तबीता नाउँ रहल एकथो विश्वासी लौँदी रहे। ग्रीक भाषामे ओकर नाउँ डोरकास रहिस, जेकर मतलब हुइत एकथो हरणी। ऊ महा मजा-मजा काम करे, और गरीब मनैनहे सहायता करे। <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />जब पत्रुस लुद्दा नगरमे रहे वहे समयमे उ लौँदी बेमार होके मुगिलस; और मनै उहिहे लौह्वाके उपरका तल्हक एकथो कोन्तीमे धरलाँ। <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />लुद्दा नगर योप्पा नगरके लग्गे हुइलक ओहोँरसे चेलनके पता पालेलाँ कि पत्रुस वहाँ बा। तब ओइने पत्रुसके थेन दुईथो मनैनहे असिन बिन्ती करे पठैलाँ, “बिना बेर कर्ले हमार थेन आजाऊ।” <verse eid="ACT 9:38" /><verse number="39" style="v" sid="ACT 9:39" />तब् पत्रुस उठ्के ओइन्के संग चलगिलस। वहाँ पुग्लाँ ते ओइने उहिहे उपरका तल्हक कोन्तीमे लैगिलाँ। वहाँ सक्कु विधवा जन्नी मनै पत्रुसके थेन ठरह्याके रुई लग्लाँ। उ विधवा जन्नी मनै पत्रुसहे उ सक्कु लुग्गा देखैलाँ, जोन लुग्गा डोरकास जित्ती रहल समयमे बनाइल रहे। <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />पर पत्रुस उ सक्कुहुनहे बाहेर पठाके ठेहुनी टेकल, और प्राथना करल, और उ लाहाश ओहोँर घुमके कहल, “तबीता, उठो!” तब् उ लौँदी आँखी उघारल, और पत्रुसहे देख्के उठ्के बैठगिलस। <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />पत्रुस डोरकासहे अपन हाँथेलेके पकरके जुरुकसे उठाइल। तब् ऊ परमेश्वरके पवित्र मनैनहे और विधवनहे बलाके ओइन्हे देखाइल कि डोरकास मुअलमेसे जित्ती होगिल बा। <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />यी बात सारा योप्पा नगरमे फैलगिलस; और बहुत्ते जाने प्रभु येशूकमे विश्वास करलाँ। <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />तब् पत्रुस बहुत्ते दिनसम एकथो सिमोन कना छालक काम करुइया मनैयक संग योप्पा नगरमे रलस।<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s">पत्रुस और कर्नेलियस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />कैसरिया शहरमे कर्नेलियस नाउँक एकथो मनैया रहे, जे इटालिया नाउँ रहल पल्टनके एकथो कप्तान रहे। <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />ऊ परमेश्वरके आराधना करे, और ऊ और ओकर पूरा परिवार परमेश्वरके डर मानिँत। और ऊ गरीब यहूदिनहे खुशीसे दान देहे, और हरदम परमेश्वरसे प्राथना करे। <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />एक दिन दुपहरके लगभग तीन बजे ओहोँर कर्नेलियस दर्शनमे एकदम फरछ्वारसे देखल कि परमेश्वरके एकथो स्वर्गदूत ओकर लग्गे आके उहिहे कलिस, “हे कर्नेलियस!” <verse eid="ACT 10:3" /><verse number="4" style="v" sid="ACT 10:4" />तब कर्नेलियस स्वर्गदूतहे ध्यान देके हेरल, और डरैती उहिहे कहल, “का आज्ञा बा प्रभु?” तब् स्वर्गदूत उहिहे कलिस, “तोहाँर प्राथना और गरीबनहे देलक दान सम्झनक रुपमे परमेश्वरके थेन पुगल बा। <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />आब कौनो मनैनहे योप्पा नगरमे पठाऊ, और पत्रुस कना सिमोनहे बलाई पठाऊ। <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />ऊ छालक काम करुइया सिमोनके थेन जाके रहता, जेकर घर समुन्दरके आँरितिर बतिस।” <verse eid="ACT 10:6" /><verse number="7" style="v" sid="ACT 10:7" />जब उहिसे बोलुइया स्वर्गदूत ओकर थेनसे विदा हुइलिस, तब् कर्नेलियस अपन नोकरहुँक्रिहिनमेसे दुईथो नोकर और परमेश्वरके आराधना करुइया एकथो सिपाहिहे अपन थेन बलाइल। <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />और ओइन्हे सक्कु बात बताके पत्रुसहे नानक लग योप्पा नगरमे पठादेहल।<verse eid="ACT 10:8" /></para>
  <para style="s">पत्रुसके दर्शन</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />दोसुर दिन जब कर्नेलियसके पठैलक उ तीन जाने अपन यात्रा कर्ती गैलाँ, ते ओइने दुपहरके बाह्र बजे ओहोँर योप्पा शहरके लग्गे पुग्लाँ। वहे समयमे पत्रुस प्राथना करक लग अपन बैठल घरक छटमे चहुँरल। <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />और पत्रुसहे भुँख लागगिलिस। जब दोसुर जाने खाना निधतिहित, वहे समयमे पत्रुस एकथो दर्शन देखल। <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />और ऊ असिन देखल कि स्वर्ग उघरगिल, और वहाँसे चारु कोन्वामे बाँधल तन्ना हस कुछु पृथ्वी ओहोँर गिरतेहे। <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />उ तन्नामे पृथ्वीक सक्कु मेरके चरगोरिया जानबर और घस्रना प्राणी और आकाशमे उरुइया चिरैँचुरुंगीन रहिँत। यनकेमे उ जानबर और चिरैँ फेन शामिल रहिँत, जेनके बारेमे मोशक नियम कानुन कहत कि ओइने अशुद्ध और अपवित्र हुइँत, और यनहे खाइक लग यहूदिनहे मनाहीँ बतिन। <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />तब् पत्रुस एकथो आवाज सुनल, “ए पत्रुस उठो और मुवाके खाऊ।” <verse eid="ACT 10:13" /><verse number="14" style="v" sid="ACT 10:14" />पर पत्रुस कहल, “नाई प्रभु, काकरेकी मै कबु फेन कुछु अपवित्र या अशुद्ध चिज नै खाइल हुइतुँ।” <verse eid="ACT 10:14" /><verse number="15" style="v" sid="ACT 10:15" />पत्रुस फेनदोस्रे दोसुरचो आवाज सुनल, “परमेश्वर जोन चिजहे शुद्ध करदेले बताँ, उहिहे तुँ अशुद्ध ना कहो।” <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />यी दर्शन तीनचो दोहोरागिलस, और जुरतेहेँ उ तन्ना स्वर्ग ओहोँर उठागिलस।<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />पत्रुस अभिन यहे दोधारमे रहे कि मोरिक देख्लक दर्शनके मतलब का हुई सेकी। तब्बेहेँ कर्नेलियसके पठाइल मनै सिमोनके घर खोज्ती ओक्रेहे घरक दवारी थेन पुगगिलाँ। <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />और ओइने गोहराके पुँछे लग्लाँ, “का पत्रुस कना सिमोन यहाँ रहत?” <verse eid="ACT 10:18" /><verse number="19" style="v" sid="ACT 10:19" />जब पत्रुस दर्शनके बारेमे सोँचतेहे, तब्बेहेँ पवित्र आत्मा उहिहे कलिस, “हेरो, तीनथो मनै तुहिन्हे खोजतताँ। <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />उठो, और तरे जाऊ। भले ओइने गैर-यहूदिन हुइताँ, तभुन फेन बिना हिचकिचैले तुँ ओइन्के संग चलजाऊ। काकरेकी तोहाँर थेन ओइन्हे मै पठैनु।” <verse eid="ACT 10:20" /><verse number="21" style="v" sid="ACT 10:21" />तब् पत्रुस तरे उतरगिल, और उ मनैनके थेन जाके कहल, “हेरो, जिहिहे तुहुरे खोजतो, उ मनैया महिँ हुइतुँ; तुहुरे यहाँ काकरे अइलो?” <verse eid="ACT 10:21" /><verse number="22" style="v" sid="ACT 10:22" />ओइने जवाफ देलाँ, “हम्रिहिन्हे एकथो कप्तान कर्नेलियस अप्निक थेन पठैले बताँ, ऊ धार्मिक और परमेश्वरके डर मनुइया और पूरा यहूदी जातिमेसे सम्मान भेटाइल मनैया हुइताँ। हुँकिन्हे एकथो पवित्र स्वर्गदूतसे दर्शन मिल्लिन कि ऊ अप्निहे अपन घर बलाइँत और अप्निन्से उपदेश सुनिँत।” <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />तब् पत्रुस ओइन्हे भित्तर बलाके ओइन्हे रहक लग ठाउँ देलस। और दोसुर दिन पत्रुस उठ्के ओइन्के संग गैल, और योप्पा नगरके गोड्गात विश्वासी भैयन फेन ओइन्के संग गैलाँ।<verse eid="ACT 10:23" /></para>
  <para style="s">कर्नेलियसके घरेम पत्रुस</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 10:24" />दोसुर दिन ओइने कैसरिया शहरमे पुगगिलाँ। और कर्नेलियस अपन गोत्यारीनहे और अपन एकदम मिल्ना संघरियनहे एक्के थेन जुटाके ओइन्के अइना डगर हेरतेहे। <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />जब पत्रुस भित्तर आइल, तब् कर्नेलियस उहिसे भेँटा करल, और ओकर गोरामे लिहुरके ओकर आराधना कर्लस। <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />पर पत्रुस उहिहे उठाके असिक कहल, “उठी, और मोरिक आराधना ना करी, काकरेकी मै फेन ते एकथो मनैया हुइतुँ।” <verse eid="ACT 10:26" /><verse number="27" style="v" sid="ACT 10:27" />तब् पत्रुस कर्नेलियसके संग बात बत्वैती भित्तर गैल, और वहाँ ऊ बहुत्ते जहनहे जमा हुइल भेटाइल। <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />तब् पत्रुस उहिहे कहल, “गैर-यहूदिनके संग संगत करना, अथवा ओइन्हे भेटघाट करना हम्रे यहूदी मनैनके लग यहूदी मोशक नियम कानुनके विरोधमे बा कना बात तुहुरिन्हे पतै बा। तभुन फेन परमेश्वर महिन्हे कौनो फेन मनैयाहे अपवित्र अथवा अशुद्ध ना मन्हो कहिके देखाइल बताँ। <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />तबेकमारे बलैती किल बिना हिचकिचैले मै अप्निनके थेन आगिनु। आब मै जाने चहथुँ कि अप्नि महिन्हे काकरे बलैली?” <verse eid="ACT 10:29" /><verse number="30" style="v" sid="ACT 10:30" />ओकरपाछे कर्नेलियस कहल, “चार दिन आघे लगभग यहे समयमे जब मै घरेम दिनक तीन बजे प्राथना करतुँहुँ, तब्बेहेँ चहकार लुग्गा घालल एकथो मनैया मोरिक आघे ठरह्यागिल। <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />और महिन्हे कहल, ‘हे कर्नेलियस! तोहाँर प्राथना और गरीबनहे देलक दान सम्झनक रुपमे परमेश्वरके थेन पुगल बा। <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />आब कौनो मनैनहे योप्पा नगरमे पठाऊ, और पत्रुस कना सिमोनहे बलाई पठाऊ। ऊ छालक काम करुइया सिमोनके थेन जाके रहता, जेकर घर समुन्दरके आँरितिर बतिस। जब ऊ आई, तब ऊ तुहुरिन्हे परमेश्वरके ओहोँरसे एकथो सन्देश बताई।’ <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />तब् मै जुरतेहेँ अप्निन्हे बलाइक लग मै अपन कामदारीनहे अप्निक थेन पठैनु, और मजा हुइल कि अप्नि आदेली। आब हम्रे सक्कु जाने यहाँ यी कारणसे जुटल बती ताकि परमेश्वर अप्निहे ज्या-ज्या कले बताँ उहिहे हम्रे सुने सेकी।”<verse eid="ACT 10:33" /></para>
  <para style="s">कर्नेलियसके घरेम पत्रुसके उपदेश</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />तब् पत्रुस बोले लागल, “आब मै जानदर्नु कि जात्तिकमे परमेश्वर किहुहे फेन पक्षपात नै करथाँ। <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />पर हरेक जातिमेसे जे परमेश्वरसे डराइत, और धार्मिक काम करत, उहिएहे परमेश्वर स्वीकार करथाँ। <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />अप्नि उ सन्देशहे जन्थी, जोन सन्देश परमेश्वर हम्रे, इजरायलके मनैनहे पठैले बताँ। और वहे शान्तिक बारेमे खुशीक खबर सुनैलाँ, जोन शान्ति मनैनहे येशू ख्रीष्टकेमे विश्वास कर्लेसे मिलत। ऊ सक्कु मनैनके परमेश्वर हुइँत। <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />उ सन्देशहे तुहुरे जन्थो, जोन सन्देश डुब्किक बारेमे यूहन्नक कर्लक प्रचारके पाछे गालील प्रदेशमेसे सुरु हुइल। और पूरा यहूदिया प्रदेशमे फैलगिल: <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />कि परमेश्वर नासरत गाउँक येशूहे पवित्र आत्मा और शक्तिलेके अभिषेक करलाँ। येशू मजा काम कर्ती गैलाँ। और शैतानके सटैलक सक्कु मनैनहे चोख्वैती नेंग्लाँ। काकरेकी परमेश्वर हुँकार संग रहिन। <verse eid="ACT 10:38" /><verse number="39" style="v" sid="ACT 10:39" />और यहूदिनके देशमे और यरुशलेम शहरमे येशूक कर्लक सक्कु कामके हम्रे साँखी बती। और यरुशलेम शहरमे यहूदी जातिक नेतनके हुँकिन्हे क्रूसमे टँगाके फेन मुवाँदेलाँ। <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />पर तेसर दिन परमेश्वर येशूहे मुअलमेसे फेनदोस्रे जिवादेलाँ। और हुँकिन्हे प्रकट फेन करदेले बताँ। <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />सक्कु मनै हुँकिन्हे नै देख्लाँ। पर परमेश्वर हम्रिहिन्हे अर्थात निउतरह्यनहे सुरुसे रोजलेले रहिँत। और जब ऊ मुअलमेसे जित्ती हुइलाँ ते हम्रे हुँकार संग खैली और पिली। <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />और ऊ हम्रिहिन्हे आज्ञा देलाँ कि सक्कु मनैनहे असिके प्रचार करो। और गवाही देऊ कि येशू वहे हुइँत, जिहिहे परमेश्वर जित्ती और मुअल मनैनके न्यायकर्ता नियुक्त कर्ले बताँ। <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />परमेश्वरके सक्कु अगमवक्तन येशूक बारेमे गवाही देले बताँ, कि ख्रीष्ट जोन काम क्रूसमे करलाँ, उ कामके कारण जे-जे हुँकारमे विश्वास करी ओइन्के पाप माफ होजिहीन।”<verse eid="ACT 10:43" /></para>
  <para style="s">गैर-यहूदिनकेमे पवित्र आत्मा अइलक</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />पत्रुस यी बात बत्वैती रहे, तब्बेहेँ ओकर वचन सुनुइया सक्कुहुनकेमे पवित्र आत्मा आगिलिन। <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />और जतरा जाने यहूदी विश्वासीन पत्रुसके संग आइल रहिँत, ओइने सक्कु जाने अचम्मित होगिलाँ कि गैर-यहूदिनकेमे फेन पवित्र आत्मक वरदान देगिल बा। <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />काकरेकी ओइने ओइन्हे फरक-फरक भाषामे बोलत, और परमेश्वरके प्रशंसा करत सुन्लाँ। तब् पत्रुस कहल, <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />“हमारे हस यनहे फेन परमेश्वरके ओहोँरसे पवित्र आत्मा मिलल बतिन, और यनहे आब पानीक डुब्कि लेनासे केऊ नै रोके सेकी।” <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />तब् पत्रुस कर्नेलियसके घरेम रहुइया सक्कु गैर-यहूदिनहे आज्ञा देहल कि ओइने येशू ख्रीष्टके नाउँमे डुब्कि लिँट्। ओकर पाछे पत्रुस थोरिक दिन आकुर ओकर संग पलिरहे कहिके कर्नेलियस पत्रुसहे अनुरोध करल।<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s">पत्रुसके बात फरछ्वैलक</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />यहूदिया प्रदेशमे रहल निउतरह्यन और विश्वासीन गैर-यहूदिनके फेन परमेश्वरके वचन ग्रहण करलेले बताँ कहिके सुन्लाँ। <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />और जब पत्रुस यरुशलेम शहरमे आइल ते यहूदी विश्वासीन असिक कहिके पत्रुससे विवाद करे लग्लाँ, <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />“तुँ गैर-यहूदिनके घरेम गैलो, और ओइन्के संग खाना खैलो।” <verse eid="ACT 11:3" /><verse number="4" style="v" sid="ACT 11:4" />तब् पत्रुस का-का हुइल कना सक्कु बात सुरुसे असिके सुनाई लागल; <verse eid="ACT 11:4" /><verse number="5" style="v" sid="ACT 11:5" />“मै योप्पा नगरमे प्राथना करतुहुँ। और तब्बेहेँ मै एकथो दर्शन देख्नु कि स्वर्गमेसे चारु कोन्वामे बाँधल तन्ना हस कुछु पृथ्वी ओहोँर गिरतेहे। और उ मोरिक थेन अइलस। <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />जब मै उहिहे ध्यानसे हेर्नु, ते मै देख्नु कि उ तन्नामे पृथ्वीक सक्कु मेरके चरगोरिया और बन्वामे रना जानबर और घस्रना प्राणी और आकाशमे उरुइया चिरैँचुरुंगीन रहिँत। <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />और वहे समयमे मै एकथो आवाज फेन सुन्नु, ‘ए पत्रुस उठो और मुवाके खाऊ।’ <verse eid="ACT 11:7" /><verse number="8" style="v" sid="ACT 11:8" />पर मै कनु, ‘नाई प्रभु, काकरेकी मै कबु फेन कुछु अपवित्र या अशुद्ध चिज नै खाइल हुइतुँ।’ <verse eid="ACT 11:8" /><verse number="9" style="v" sid="ACT 11:9" />पर उ आवाज फेनदोस्रे स्वर्गमेसे आइल, ‘परमेश्वर जोन चिजहे शुद्ध करदेले बताँ, उहिहे तुँ अशुद्ध ना कहो।’ <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />तीनचो ओस्तेहेँके हुइलस और उ सक्कु फेनदोस्रे स्वर्गमे फिर्ता उठागिलस। <verse eid="ACT 11:10" /><verse number="11" style="v" sid="ACT 11:11" />वहे समयमे कैसरिया शहरमेसे कर्नेलियसके पठाइल तीनथो मनै हमारिक रहल घरेम आपुग्लाँ। <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />तब पवित्र आत्मा महिन्हे बिना हिचकिचैले ओइन्के संग जाऊ कहिके कहल। और यी छे जाने विश्वासी भैयन फेन मोरिक संग आगिलाँ; और हम्रे कर्नेलियसके घरेम गैली। <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />ऊ हम्रिहिन्हे बताइल, कि ऊ एकथो स्वर्गदूतहे अपन घरेम ठरह्याइल देखल। और उ स्वर्गदूत उहिहे कलिस, ‘आब कौनो मनैनहे योप्पा नगरमे पठाऊ, और पत्रुस कना सिमोनहे बलाई पठाऊ। <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />और ऊ तुहिन्हे वचन सुनाई, जिहिसे परमेश्वर तुहिन्हे और तोहाँर परिवारके सक्कु मनैनहे बँचैहीँ।’ <verse eid="ACT 11:14" /><verse number="15" style="v" sid="ACT 11:15" />जब मै बोले लग्नु, ते पवित्र आत्मा ओइन्केमे असिके अइलिन जसिके सुरुवातमे हमारमे पवित्र आत्मा आइल रहे। <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />तब् महिन्हे प्रभुक कहल उ वचन याद आइल, ‘यूहन्ना ते पानीलेके डुब्कि देहल, पर तुहुरे पवित्र आत्मक डुब्कि भेटैबो।’ <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />तबेकमारे यी बात फरछ्वारे बा कि परमेश्वर ओइन्हे फेन वहे वरदान देलाँ, जोन वरदान हम्रिहिन्हे प्रभु येशू ख्रीष्टके उप्पर विश्वास कर्ली ते मिलल; कलेसे मै के रहुँ, जे परमेश्वरहे रोक्तुँ?” <verse eid="ACT 11:17" /><verse number="18" style="v" sid="ACT 11:18" />यी बात सुनके उ यहूदी विश्वासीन चिमचाम होगिलाँ। और परमेश्वरके प्रशंसा कर्ती ओइने कहे लग्लाँ, “तब ते परमेश्वर गैर-यहूदिनहे फेन सदाकालके जीवनके लग मन बदलके अपन पाप करे छोरना और येशू ख्रीष्टकेमे विश्वास करना मौका देले बताँ।”<verse eid="ACT 11:18" /></para>
  <para style="s">एन्टिओखिया शहरमे शाऊल और बारनाबास</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />स्तिफनसहे मुवाँदेलिस ते ओकरपाछे बहुत्ते विश्वासीन यरुशलेम शहरहे छोरदेलाँ। और ओइने फोनिके प्रदेश, साइप्रस टापु और सिरिया प्रदेशके एन्टिओखिया शहरमे चलगिलाँ। पर ओइने यहूदिनहे बाहेक औरे दोसुर जहन किहुहे फेन परमेश्वरके वचन नै सुनाइँत। <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />पर ओइन्मेसे केऊ-केऊ साइप्रस टापु और कुरेन शहरके मनै रहिँत। ओइने एन्टिओखिया शहरमे जाके ग्रीक भाषा बोलुइया गैर-यहूदिनहे फेन प्रभु येशूक प्रचार करिँत। <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />और प्रभुक शक्ति ओइन्केमे रहिन, और बहुत्ते गैर-यहूदी जातिनके मनै ओइन्के सन्देशमे विश्वास करलाँ। और ओकर पाछे ओइने प्रभु येशूकमे विश्वास करना सुरु करदेलाँ। <verse eid="ACT 11:21" /><verse number="22" style="v" sid="ACT 11:22" />यी समाचार यरुशलेम शहरके मण्डलीक मनै फेन सुनलेलाँ। तबेकमारे ओइने बारनाबासहे एन्टिओखिया शहरमे पठैलाँ। <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />बारनाबास वहाँ जाके परमेश्वरके अनुग्रह देख्के खुशी होगिल, और ओइन्हे सक्कुहुनहे पूरा मनसे प्रभुकमे विश्वासी पलिरना उत्साहा देहल। <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />बारनाबास एकथो मजा मनैया रहे; और ऊ पवित्र आत्मा और विश्वाससे भरल रहे। और बहुत्ते मनै येशूहे विश्वास करलाँ। <verse eid="ACT 11:24" /><verse number="25" style="v" sid="ACT 11:25" />तब् एन्टिओखिया शहरहे छोरके शाऊलहे खोजक लग बारनाबास टार्सस नगरमे चलगिलस। <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />जब बारनाबास शाऊलहे भेटाइल, तब ऊ शाऊलहे एन्टिओखिया शहरमे लैगिलस। तब् पूरा एक सालसम मण्डलीक मनैनके संग ओइने भेटघाट कर्ती रलाँ, और मनैनके बरवार समूहहे प्रभु येशूक बारेमे शिक्षा देलाँ। चेलनके सुरुकचो एन्टिओखिया शहरमे ख्रीष्टियन कहिगिलाँ। <verse eid="ACT 11:26" /><verse number="27" style="v" sid="ACT 11:27" />उ समयमे गोड्गात विश्वासी अगमवक्तन यरुशलेम शहरमेसे एन्टिओखिया शहरमे अइलाँ। <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />ओइन्मेसे अगाबस नाउँ रहल एकथो अगमवक्ता ठरह्याके पवित्र आत्मक अगुवाइसे असिके बतैलस कि सारा संसारमे बरवार अनिकाल परी। और पाछे जाके वहे अनिकाल महाराजा क्लौडियसके शासनकालमे परल। <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />तब् एन्टिओखिया शहरके चेलनके सक्कु जाने अपन-अपन क्षमता अनुसार यहूदिया प्रदेशमे रहल विश्वासीनके लग दानके रुपमे कुछु सहायता पठैना निर्णय करलाँ। <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />ओइने अस्तेके करलाँ, और ओइन्के दान बारनाबास और शाऊलके हाँथेम देके यरुशलेम शहरके मण्डलीक अगुवनके थेन पठादेलाँ।<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s">पत्रुस झेलमे</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />उ समयमे हेरोद रज्वा मण्डलीक गोड्गात मनैनहे दुःख देहक लग झेलमे दारदेले रेहे। <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />हेरोद रज्वा यूहन्ना निउतरह्यक दादू याकूबहे तरवाललेके मरवा दारल। <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />जब हेरोद रज्वा जानलेहल कि यी कामसे यहूदी दलके नेतन खुशी हुइथाँ, तब ऊ पत्रुसहे फेन गिरफ्तार करवैलस। यी घटना अखमिरी रोटीक तिहुवारके समयमे हुइल रहे। <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />हेरोद पत्रुसहे गिरफ्तार करवाके झेलमे दारदेहल। और निस्तार-तिहुवार ओराके सेकी ते मनैनके आघे पत्रुसके न्याय करम कहिके ओकर अख्वारी करक लग चार-चारथो सिपाहिनहे चारथो टोली बनाके चारथो ठाउँमे खटैलस।<verse eid="ACT 12:4" /></para>
  <para style="s">झेलमेसे पत्रुसके छुट्लक</para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 12:5" />बहुत दिनसे झेलमे पत्रुसके अख्वारी हुइतिहिस, पर मण्डलीक मनै ओकर लग एक्के मन बनाके परमेश्वरसे प्राथना करतिहिँत। <verse eid="ACT 12:5" /><verse number="6" style="v" sid="ACT 12:6" />जब हेरोद रज्वा पत्रुसके न्याय करक लग उहिहे मनैनके आघे नानक लग रहे, ते ओकर एक रात आघे पत्रुस दुईथो सिँक्रीलेके बँधल रहे। और दुईथो सिपाहिनके बिच्चेम सुतल रहे। और अख्वारी करुइया सिपाहिन दवारमे ठरह्याके झेलके अख्वारी करतिहिँत। <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />एकफाले प्रभुक एकथो स्वर्गदूत पत्रुसके लग्गे आके ठरह्यागिलिस। और उ कोठरीमे ओजरार चम्कल। और स्वर्गदूत पत्रुसके पस्रीमे हाँथेलेके मारके उहिहे जगैलिस, और कलिस, “झत्ते उठो।” तब् ओकर हाँथेमसे सिँक्री खुलके गिरगिलिस। <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />तब स्वर्गदूत पत्रुसहे कलिस, “लुग्गा और जुत्ता घाललेऊ।” तब् पत्रुस ओस्तेहेँके कर्लस। फेनदोस्रे स्वर्गदूत पत्रुसहे कलिस, “अपन कोट घालके मोरिक पाछेपाछे आऊ।” <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />तब् पत्रुस निकरके उ स्वर्गदूतके पाछेपाछे नेगे लागल। पर स्वर्गदूतके कर्लक बात जात्तिक हो कहिके पत्रुसहे पतै नै रहिस। पर दर्शन देखतुँ कहिके ऊ सोँचल। <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />जब सुरुक और दोसुर अख्वारी करुइया सिपाहिनके टोलीहे नहाङके ओइने लोहेक दवार थेन पुगगिलाँ, जोन दवार शहर ओहोँर लैजाइत। तब उ दवार अप्निहीँ खुलगिल। तब ओइने बाहेर निकरके एकथो गल्लीक डगर सोज गैलाँ। और जुरतेहेँ स्वर्गदूत पत्रुसहे छोरके चलगिलिस। <verse eid="ACT 12:10" /><verse number="11" style="v" sid="ACT 12:11" />जब पत्रुसके होश खुल्लिस, तब् ऊ कहल, “आब महिन्हे जात्तिके पता होगिलस, कि प्रभु अपन स्वर्गदूत पठाके हेरोद रज्वक अधिकारसे और यहूदि नेतनके ज्या करक लग रहिँत, उ सक्कुहुनसे महिन्हे छुटकारा देलाँ।” <verse eid="ACT 12:11" /><verse number="12" style="v" sid="ACT 12:12" />परमेश्वर पत्रुसहे बँचैलिस कना बात जानके सेकल ते ऊ मर्कूस कना यूहन्नक दाई मरियमके घरेम गैल। वहाँ बहुत्ते विश्वासीन जमा होके प्राथना करतिहिँत। <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />जब पत्रुस दवार धकधकाइल, तब् रोदा नाउँ रहल नोकर्नी दवार खोले आइल। <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />पत्रुसके बोली चिन्हल ते खुशी होके बिना दवार खोल्ले भित्तर दौरके जाके बतादेहल, “पत्रुस दवारमे ठरह्याइल बताँ।” <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />पर ओइने उहिहे कलाँ, “तैँ बौरागिल बते।” पर ओकर कहल बात जात्तिक हो कहिके ऊ जिद्दी करल: तब् ओइने कलाँ, “ऊ ओकर स्वर्गदूत हुइहिस।” <verse eid="ACT 12:15" /><verse number="16" style="v" sid="ACT 12:16" />पर पत्रुस दवार धकधकैती रहल। जब ओइने दवार खोल्लाँ ते ओइने पत्रुसहे देख्के छक्क परके दंग परगिलाँ। <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />ओइने चिमचाम लागिँत कहिके पत्रुस ओइन्हे हाँथेलेके इशारा करल। और प्रभु उहिहे कसिके झेलमेसे बाहेर निकरलाँ कहिके ओइन्हे बताइल। और पत्रुस ओइन्हे कहल कि ओइने याकूब और दोसुर विश्वासी भैयनहे फेन यकर बारेमे बतादिँत। तब पत्रुस वहाँसे निकरके दोसुर ठाउँमे चलगिलस। <verse eid="ACT 12:17" /><verse number="18" style="v" sid="ACT 12:18" />दोसुर दिन बेहानके पत्रुस कहाँ चलगिल कहिके झेलके सिपाहिनमे बरवार तहल्का मचगिलिन। <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />हेरोद रज्वा अपन सिपाहिनहे आदेश देहल कि ओइने पत्रुसहे खोजिँत। पर ओइने पत्रुसहे नै भेटैलाँ। तब हेरोद रज्वा सिपाहिनहे प्रश्न पुँछल, और ओइने जवाफ देहे नै सेक्लाँ, ते हेरोद रज्वा उ सिपाहिनहे मृत्यु दण्डक सजाय सुनाइल। और हेरोद रज्वा यहूदिया प्रदेशहे छोरके थोरिक दिनके लग कैसरिया शहरमे जाके वहैँ रहे लागल।<verse eid="ACT 12:19" /></para>
  <para style="s">हेरोद रज्वा मुलक</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />हेरोद रज्वा टुरोस और सीडोन शहरके मनैनसे रिसाइल रहे। तबेकमारे उ दुनु शहरके मनै रज्वासे मिलाप करक लग एकथो समूह बनाके सक्कुहुनसे आघे रज्वक नेजी सहायक बलस्तसके थेन अनुरोध करे गैलाँ। तब ओकर पाछे शान्ति बनाइक लग ओइने हेरोद रज्वाहे कलाँ। काकरेकी अपन खानक पूर्ति करक लग ओइने हेरोद रज्वक देशमे भर परल रहिँत। <verse eid="ACT 12:20" /><verse number="21" style="v" sid="ACT 12:21" />जोन दिन हेरोद रज्वा उ शहरनके मनैनसे भेँटा करना निर्णय करल, वहे दिन हेरोद रज्वा राजकीय पहिरन घालके अपन न्यायक सिंहासनमे बैठल; और ओइन्हे भाषण देहल। <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />और भीड़के मनै चिल्लाके कहे लग्लाँ, “यी ते मनैया नै होके देउँता बोलता।” <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />वहे समयमे परमेश्वरके एकथो स्वर्गदूत हेरोद रज्वकमे प्रहार कर्लिस, काकरेकी ऊ परमेश्वरहे महिमा नै देले रहे। ओकर शरीरमे बुजुक-बुजुक करना किरा परगिलिस, और ऊ मुगिलस। <verse eid="ACT 12:23" /><verse number="24" style="v" sid="ACT 12:24" />पर परमेश्वरके वचन फैलतिगैल, और विश्वासीनके संख्या बहर्तीगैलिन। <verse eid="ACT 12:24" /><verse number="25" style="v" sid="ACT 12:25" />यहूदिया प्रदेशमे यहूदी विश्वासीनके सहायता करक लग पैँसा देके सेकके बारनाबास और शाऊल यरुशलेम शहरमेसे एन्टिओखिया शहरमे फिर्ता होगिलाँ। मर्कूस कना यूहन्ना फेन ओइन्के संग गैलस।<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s">पावलके सुरुक प्रचार-यात्रा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />एन्टिओखिया शहरके मण्डलीमे बहुत्ते अगमवक्ता और गुरुनके रहिँत। ओइन्मेसे बारनाबास, निगेर कना शिमियोन, कुरेन शहरके लुकियस, प्रान्‍तीय शासक हेरोद रज्वक संग बह्रल-पहुँरल मनैया मनाहेम और शाऊल रहिँत। <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />जब यने परमेश्वरके आराधना करतिहिँत, और उपवास बैठल रहिँत। तब्बेहेँ पवित्र आत्मा ओइन्हे कलिन, “मोरिक सेवा करक लग बारनाबास और शाऊलहे अल्गे करदेऊ, जेहँकक लग मै ओइन्हे बलाइलतुँ।” <verse eid="ACT 13:2" /><verse number="3" style="v" sid="ACT 13:3" />तब ओइने उपवास और प्राथना करके बारनाबास और शाऊलके उप्पर हाँथ धारके परमेश्वरके काम करक लग ओइन्हे पठादेलाँ।<verse eid="ACT 13:3" /></para>
  <para style="s">पावलके प्रचार करे गैलक सुरुक यात्रा</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />तब् बारनाबास और शाऊल पवित्र आत्मक अगुवाइसे एन्टिओखिया शहरमेसे सिलुकिया बन्दरगाहा शहरसम गैलाँ। और वहाँसे जहाजमे चहुँरके ओइने साइप्रस टापुक सलामिस बन्दरगाहामे चलगिलाँ। <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />और सलामिस बन्दरगाहामे पुग्के परमेश्वरके वचन ओइने यहूदिनके बैठक भवनमे सुनैलाँ। और ओइन्हे सहायता करक लग मर्कूस कना यूहन्ना ओइन्के संग रहे। <verse eid="ACT 13:5" /><verse number="6" style="v" sid="ACT 13:6" />ओकर पाछे ओइने पूरा टापुमे एकथो नगरमेसे दोसुर नगरके यात्रा करलाँ। और सक्कुहुनसे पाछे ओइने पाफोस शहरमे पुगगिलाँ। तब् वहाँ ओइने बार-येशू कना एकथो जादूगरहे भेटैलाँ, जे यहूदी रहे, और ऊ झूँटा अगमवक्ता फेन रहे। <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />उ जादूगर साइप्रस प्रदेशके राजपाल सर्गियस पौलुसके संग बैठे। सर्गियस पौलुस एकथो बुद्धिमान मनैया रहे। राजपालहे शाऊल और बारनाबासहे बलाके परमेश्वरके वचन सुन्ना मन लग्लिस। <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />पर एलुमास जादूगर (काकरेकी ग्रीक भाषामे ओकर नाउँक मतलब जादूगरे हो।) बारनाबास और शाऊलके सामना करके येशूकमे विश्वास करनासे राजपाल सर्गियस पौलुसहे रोके खोजल। <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />पर शाऊल जेकर नाउँ पावल फेन हुइतिस, ऊ पवित्र आत्मालेके भरके जादूगरके ओहोँर हेरके कहल, <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />“ए शैतानके छावा, तैँ सारा धार्मिकतक दुश्मन हुइते, और तैँ पूरा कपट और दुष्टतासे भरल बते! का तैँ परमेश्वरके सोझ डगरहे तेहेँर कराई नै छोरबे? <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />आब हेर, परमेश्वर तुहिहे दण्ड दिहीँ। तैँ थोरिक समयसम आँधर होजिबे, और तैँ सूर्यहे नै हेरे भेटैबे।” तब् जुरतेहेँ कुहिरा और अंधार उहिहे टोपदेलिस, और केऊ ओकर हाँथ पकरके उहिहे सहायता करे कहिके ऊ यहोँर-ओहोँर टटोरे लागल। <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />तब् राजपाल यी हुइल देख्के प्रभु येशूकमे विश्वास करल। काकरेकी परमेश्वरके शिक्षासे ऊ अचम्मित होगिल रहे।<verse eid="ACT 13:12" /></para>
  <para style="s">पिसिदिया जिल्लक एन्टिओखिया शहरमे पावलके प्रचार</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />पावल और ओकर संघरियन पाफोस शहरमेसे समुन्दरके यात्रा सुरु करलाँ। और ओइने पामफिलिया प्रदेशके पर्गा नगरमे पुगगिलाँ; और मर्कूस कना यूहन्ना ओइन्हे छोरके यरुशलेम शहरमे फिर्ता होगिल। <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />पर ओइने पर्गा नगरमेसे निकरके गलातिया प्रदेशके पिसिदिया जिल्लक लग्गे एन्टिओखिया शहरमे पुगगिलाँ; और बिँसैना दिनमे यहूदी बैठक भवनके भित्तर जाके बैठ्गिलाँ। <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />आब मोशक नियम कानुन और परमेश्वरके अगमवक्तक किताबमेसे पहरके यहूदी बैठक भवनके शासकहुँक्रे ओइन्के थेन असिक कहिके पठैलाँ, “ए भैयो, तुहुरिन्के संग मनैनके लग कुछु उपदेश देना वचन बा कलेसे कहो।” <verse eid="ACT 13:15" /><verse number="16" style="v" sid="ACT 13:16" />तब् पावल ठरह्याके ओइन्हे शान्त करक लग हाँथेलेके इशारा करके कहल, “हे इजरायलके मनै और परमेश्वरके डर मनुइया गैर-यहूदिनके, सक्कु जाने सुनो। <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />इजरायल जातिनके परमेश्वर हमार बाबा-पुर्खनहे चुनलेलाँ। और ओइने मिश्र देशमे परदेशी होके रहतिहिँत, तब ऊ ओइन्के उन्नति कर्लिन। और परमेश्वर अपन पराक्रमी शक्तिसे ओइन्हे उ देशमेसे बाहेर निकारके लयन्लिन। <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />हमार पुर्खन घनी-घनी परमेश्वरके आज्ञक उल्लङ्घन करलाँ। तभुन फेन उजाड़-ठाउँमे परमेश्वर लगभग चालीस सालसम हमार पुर्खनके रेखदेख कर्लिन। <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />तब् कनान देशके सातथो जातिनहे नाश पारके ओइन्के देश परमेश्वर हमार बाबा पुर्खनहे देलाँ, यी प्रक्रियामे लगभग चार सौ पचास साल लागल। <verse eid="ACT 13:19" /><verse number="20" style="v" sid="ACT 13:20" />परमेश्वर शमूएल अगमवक्तक समयसम इजरायलके मनैनकेमे राज करक लग अगुवा नियुक्त करलाँ। <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />जब शमूएल ओइन्के अगुवै पलिरहीन, तब्बेहेँ ओइने एकथो रज्वक माँग करलाँ। तब परमेश्वर बेन्यामिन कुलके कीशके छावा शाऊलहे ओइन्के रज्वा बनैलिन। और ऊ शाऊलहे चालीस सालसम इजरायलके मनैनकेमे राज करक लग देलिन। <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />तब परमेश्वर शाऊलहे ओकर पदमेसे हटाके ओकर ठाउँमे दाऊदहे रज्वा बनैलाँ। ओकर बारेमे परमेश्वर गवाही देके कलाँ, ‘मै यिशैक छावा दाऊदहे मोरिक खोजल हस मनैया भेटैनु, जे मोरिक सक्कु इच्छा पूरा करी।’ <verse eid="ACT 13:22" /><verse number="23" style="v" sid="ACT 13:23" />ओक्रेहे वंशमेसे परमेश्वर अपन वाचा अनुसार इजरायलके मनैनके थेन एकथो मुक्तिदाता अर्थात वहे येशूहे पठैलाँ। <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />जेकर अइनासे आघे यूहन्ना इजरायल देशके सक्कु मनैनहे प्रचार करल कि अपन मन बद्लो और पाप करना छोरदेऊ ताकि परमेश्वर तुहुरिन्के पाप माफ करिँत। और तब् मै तुहुरिन्हे डुब्कि देहम। <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />जब यूहन्नक सेवक काम पूरा हुइतिहिस, तब ऊ असिके कहल रहे, ‘तुहुरे का सोँच्थो, मै के हुइतुँ? मै ख्रीष्ट नै हुइतुँ। पर मोरिक पाछे एक जाने अइहीँ, मै हुँकार आघे यी लायकके फेन मै नै हुइतुँ कि मै हुँकार असिन नोकर बने सेकुँ जे जुत्तक टेनी खोल्ना काम करत।’ <verse eid="ACT 13:25" /><verse number="26" style="v" sid="ACT 13:26" />हे मोरिक विश्वासी भैयो, तुहुरे जेने अब्राहामके सन्तान हुइतो, और परमेश्वरके डर मनुइया गैर-यहूदिनके, तुहुरिन सक्कु जहनके थेन मुक्तिक सन्देश पठागिल बा। <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />यरुशलेम शहरके मनै और ओइन्के शासकहुँक्रे येशू ख्रीष्टहे नै चिहिन्लाँ। और ओइने परमेश्वरके अगमवक्तनके उ वचनहे नै बुझ्लाँ, जोन वचन ओइने हरेक बिँसैना दिनमे पह्रिँत। तबेकमारे ओइने येशूहे दोषी ठहरैलाँ। और असिके ओइने परमेश्वरके अगमवक्तनके वचनहे पूरा करलाँ। <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />ज्यान सजायके कुछु कारण नै भेटैलेसे फेन ओइने येशूहे मुवाइक परी कहिके राजपाल पिलातसके थेन बिन्ती करलाँ। <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />और ओइने उ सक्कु चिज करलाँ, जोन बात पवित्र शास्त्रमे येशूक बारेमे लिखल बतिन। और ओइने येशूहे क्रूसमे किल्ला ठोकके मुवाँदेलाँ। ओकर पाछे ओइने हुँकिन्हे क्रूसमेसे उतारके चिहानमे धरलाँ। <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />पर परमेश्वर येशूहे मुअलमेसे फेनदोस्रे जिवादेलिन। <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />और बहुत दिनसम येशू गालील प्रदेशमेसे यरुशलेम शहरमे अउइया अपन चेलनके थेन देखा पर्तिरलाँ। और आब मनैनके थेन यने किल साक्षी बनल रहिँत। काकरेकी यने येशूहे देख्ले रहिँत। <verse eid="ACT 13:31" /><verse number="32" style="v" sid="ACT 13:32" />हम्रे अप्निनके थेन वहे खुशीक खबर नन्थी, जोन खुशीक खबरके वाचा परमेश्वर हमार पुर्खनसे कर्ले रहिँत। <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />अर्थात परमेश्वर येशूहे मुअलमेसे फेनदोस्रे जित्ती बनाके वहे वाचा हम्रे यहूदिनके लग फेन पूरा कर्ले बताँ, जेने हुँकार सन्तान हुइती। जसिके भजनसंग्रहक किताबमे परमेश्वर येशू ख्रीष्टके बारेमे असिके कले बताँ।</para>
  <para style="q" vid="ACT 13:33">‘तैँ मोरिक छावा हुइते। और आज मै तोरिक बाबा बनगिल बतुँ।’<verse eid="ACT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 13:34" />परमेश्वर ख्रीष्टहे कबु नै सरना मेरिक मुअलमेसे फेनदोस्रे जित्ती बनैलाँ। यी सच्चाइहे असिके कहिगिल बा, ‘मै तुहुरिन्हे वहे पवित्र और अटल आशीर्वाद देहम, जोन आशीर्वाद मै दाऊद रज्वाहे देले रहुँ।’ <verse eid="ACT 13:34" /><verse number="35" style="v" sid="ACT 13:35" />तबेकमारे दाऊद यी बात भजनसंग्रहक दोसुर ठाउँमे फेन असिके लिख्ले बा, ‘अप्नि अपन पवित्र जनके शरीर सरे नै देबी।’ <verse eid="ACT 13:35" /><verse number="36" style="v" sid="ACT 13:36" />काकरेकी दाऊद रज्वा ते परमेश्वरके इच्छा अनुसार परमेश्वरके लक्ष्यहे पूरा करके मुगिलस, और अपन पुर्खनके संग मिलगिलस, और ओकर शरीर फेन सरगिलिस। यिहिसे हम्रे जाने सेक्थी कि यी बात दाऊद अपन बारेमे नै बोलतेहे। <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />पर दाऊद येशूक बारेमे बात करतेहे, जिहिहे परमेश्वर मुअलमेसे फेनदोस्रे जिवैलाँ, और हुँकार शरीर सरे नै भेटैलिन।<verse eid="ACT 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 13:38" />तबेकमारे हे मोरिक भैयो; तुहुरे यी जानलेऊ कि येशूक माध्यमसे पापके माफ हुइत कना खुशीक खबर तुहुरिन्हे देजाइता। <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />तुहुरे विश्वास करुइया हरेक जाने येशूएसे सक्कु चिजसे छुटकारा भेटाइल बतो, जोन छुटकारा मोशक नियम कानुनसे तुहुरिन्के लग सम्भव नै रहे। <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />तबेकमारे यी विषयमे तुहुरे हौश्यार रहहो। कहुँ असिन ना होए कि परमेश्वरके अगमवक्तनके किताबमे लिखल यी बात तुहुरिन्केमे आजाए।<verse eid="ACT 13:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="ACT 13:41" />‘हे निन्दा करुइयन, हेरो और अचम्म मानो और नाश होजाऊ।</para>
  <para style="q" vid="ACT 13:41">काकरेकी तुहुरिन्के समयमे मै एकथो काम करम।</para>
  <para style="q" vid="ACT 13:41">असिन काम जेकर बारेमे केऊ बयान करदेलेसे फेन तुहुरे कबु विश्वास नै करबो।’”<verse eid="ACT 13:41" /></para>
  <para style="s">एन्टिओखिया शहरमे पावल और बारनाबास</para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />जब पावल और बारनाबास बैठक भवनमेसे बाहेर निक्रतिहिँत, तब मनै ओइन्हे अनुरोध करलाँ कि अइना बिँसैना दिनमे फेन ओइने यहे विषयमे शिक्षा दिँत। <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />जब सभा ओराके विदा हुइलिन ते बहुत्ते यहूदी दलके नेतनके और यहूदी मत मनुइया भक्त मनै पावल और बारनाबासके पाछे लागगिलाँ। और ओइने पावल और बारनाबासहे परमेश्वरके अनुग्रहमे पलिरहहो कहिके आग्रह करलाँ। <verse eid="ACT 13:43" /><verse number="44" style="v" sid="ACT 13:44" />दोसुर बिँसैना दिनमे लगभग पूरा शहरके मनै परमेश्वरके वचन सुनक लग जमा होगिलाँ। <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />पर यहूदी दलके नेतन मनैनके भीड़हे देख्के हिस्का मुए लग्लाँ। और पावलके बत्वाइल बातके विरोध कर्ती ओइन्के निन्दा करे लग्लाँ। <verse eid="ACT 13:45" /><verse number="46" style="v" sid="ACT 13:46" />पर पावल और बारनाबास बिना डरैले कलाँ, “परमेश्वरके वचन सक्कुहुनसे आघे अप्निनेहे सुनैना जरुरी रहे। पर अप्निनके यिहिहे अस्वीकार करदेली, और अपनहे सदाकालके जीवनके अयोग्य ठहरालेले बती। ते आब हम्रे गैर-यहूदिनके थेन जैबी। <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />काकरेकी प्रभु हम्रिहिन्हे असिन आज्ञा देले बताँ, ‘मै तुहुरिन्हे गैर-यहूदिनके लग एकथो ओजरारके रुपमे चुन्ले बतुँ। ताकि तुहुरे संसारमे हरेक ठाउँक मनैनके थेन जाऊ, और ओइन्हे बताऊ कि परमेश्वर ओइन्हे कसिके बँचाई चहथाँ।’” <verse eid="ACT 13:47" /><verse number="48" style="v" sid="ACT 13:48" />यी बात सुनके गैर-यहूदिनके खुशी होके परमेश्वरके वचनके प्रशंसा करे लग्लाँ, और सदाकालके जीवनके लग नियुक्त हुइल सक्कु जाने यम्ने विश्वास करलाँ। <verse eid="ACT 13:48" /><verse number="49" style="v" sid="ACT 13:49" />तब परमेश्वरके वचन एन्टिओखिया शहरके सक्कु ईलाकामे फैलगिल। <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />पर यहूदी दलके नेतन पावल और बारनाबासके विरोधमे भक्त और प्रतिष्ठित जन्नी मनैनहे और शहरके मुख्य-मुख्य मनैनहे उक्सैलाँ। और ओइन्हे अपन साँधसिमानासे बाहेर पठादेलाँ। <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />तब परमेश्वर ओइन्हे अस्वीकार करदेले बतिन, और ओइन्हे दण्ड दिहिन कना देखाइक लग अपन गोरक धुर झराके पावल और बारनाबास ओइन्के थेनसे आइकोनिया शहरमे चलगिलाँ। <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />और आइकोनिया शहरमे चेलनके आनन्द और पवित्र आत्मालेके भरपूर होगिलाँ।<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s">आइकोनिया शहरमे पावल और बारनाबास</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />आब आइकोनिया शहरमे असिन हुइल कि पावल और बारनाबास यहूदिनके बैठक भवनमे एक्के संग गैलाँ। और असिन बात बत्वैलाँ, कि यहूदिनमेसे और ग्रीकहुँक्रिहिनमेसे बहुत्ते जाने विश्वास करलाँ। <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />पर विश्वास नै करुइया यहूदिनके गैर-यहूदिनहे विश्वासी भैयनके विरोधमे भरकैलाँ, और ओइन्के मनमे तीतपन भरदेलाँ। <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />और पावल और बारनाबास बहुत्ते दिनसम वहाँ रलाँ, और परमेश्वरकेमे भरोसा कर्ती मनैनहे शिक्षा देती रलाँ। और ओइने बहुत्ते चिन्हा और अचम्मक काम देखैलाँ, जिहिसे ओइने साबित करलाँ कि यी अनुग्रहक बारेम ओइन्के देलक शिक्षा सच्चा रहे। <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />पर उ शहरके मनैनकेमे मनमुटाव होगिलिन। और केऊ यहूदी दलके नेतनके पक्षमे और केऊ निउतरह्यनके पक्षमे होगिलाँ। <verse eid="ACT 14:4" /><verse number="5" style="v" sid="ACT 14:5" />जब गैर-यहूदी और यहूदिनके दुनु जाने ओइन्के शासकहुँक्रिहिनके संग मिलके पावल और बारनाबासके पक्षमे रहुइयनहे सतैना और पठरा मरना षड़यन्त्र बनैलाँ। <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />ते ओइने यी बात जान्लेलाँ। और ओइने लुकोनिया प्रदेशके लुस्त्रा शहरमे, और डर्बी नगरमे और आँजर-पाँजरके प्रदेशमे भागगिलाँ। <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />और वहाँ ओइने खुशीक खबर प्रचार कर्ती रलाँ।<verse eid="ACT 14:7" /></para>
  <para style="s">लुस्त्रा शहरमे एकथो नाँगर मनैया चोखैलक</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />लुस्त्रा शहरमे एकथो मनैया रहे, जे जल्मत्तिसे नाँगर रहे, और ऊ कबु नै नेगल रहे। <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />पावलके बत्वाइल बात उ नाँगर मनैया सुनतेहे। पावल उहिहे एकसुरसे हेर्तिरहल, और चोखैना ओकर विश्वास बतिस कना देख्के, <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />पावल जोरसे चिल्लाके उहिहे आज्ञा देहल, “तुँ अपन गोरक भरमे सोझ ठरह्याजाऊ।” तब्बेहेँ उ मनैया जुरुकसे उठ्गिल और नेगे लागल। <verse eid="ACT 14:10" /><verse number="11" style="v" sid="ACT 14:11" />जब पावलके कर्लक यी काम भीड़के मनै देख्लाँ, ते ओइने लुकोनियक भाषामे जोरसे असिके कलाँ, “देउँतन मनैनके रुपमे हमार थेन उतरके आइल बताँ।” <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />ओइने बारनाबासहे ग्रीकके जिउस देउँता और पावलहे हर्मेस देउँता कहे लग्लाँ, काकरेकी पावल मुख्य प्रचारक रहे। <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />नगरके आघे जिउस देउँतक मन्दिर रहिस। और उ मन्दिरके पुजारी गोरुनहे और फूलक माला लेके नगरके दवारमे आगिलस। काकरेकी उ पुजारी भीड़के मनैनके संग मिलके बलि चह्राइक लग रहे। <verse eid="ACT 14:13" /><verse number="14" style="v" sid="ACT 14:14" />पर जब निउतरह्यन बारनाबास और पावल यी बात सुन्लाँ, ते ओइने महा परेशान होगिलाँ। तबेकमारे ओइने अपन लुग्गा अप्निहीँ फारलेलाँ। और ओइने दौर्ती मनैनके भीड़मे गैलाँ। और ओइन्हे जोर-जोरसे कलाँ, <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />“सक्कु जाने सुनो, तुहुरे काकरे असिन काम करथो? हम्रे फेन ते तुहुरिनेके हस दुःख-सुख भोग्ना मनै हुइती। और हम्रे तुहुरिन्हे खुशीक खबर सुनैथी, ताकि तुहुरे बिनाकामक चिजसे अल्गे होके परमेश्वरके ओहोँर घुमे सेको। जे स्वर्ग, पृथ्वी, समुन्दर और ओइन्केमे रहल मेरमेरके चिज बनैलाँ। <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />पैलेहेँ बित सेक्लक पुस्तनके सक्कु जातिनहे परमेश्वर ओइन्के अपन-अपन रीतिअनुसार चले देलाँ। <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />तभुन फेन परमेश्वर हरदम अपन अस्तित्त्वक सबुत अपन कर्लक मजा कामसे देथाँ। जसिके आकाशमेसे पानी बर्साके और फारा फर्ना ऋतु देके तुहुरिन्के मनहे खाना और आनन्दलेके सन्तुष्ट कर्ती रलाँ।” <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />यी बात कहिके ओइने महा मुश्किलसे उ भीड़के मनैनहे बलि चह्रैनासे रोके सेक्लाँ। <verse eid="ACT 14:18" /><verse number="19" style="v" sid="ACT 14:19" />पर कौनो-कौनो यहूदी दलके नेतन एन्टिओखिया और आइकोनिया शहरमेसे वहाँ आपुग्लाँ। और भीड़के मनैनहे अपन ओहोँर करलेलाँ। और पावलकेमे पठरा बर्सैलाँ। और पावल मुगिल कना सोँचके ओइने नगरमेसे बाहेर घिँस्याके लैगिलाँ। <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />पर जब चेलनके पावलके चारु ओहोँरसे घेरलेलाँ ते ऊ उठ्के वहे नगरमे फिर्ता होगिल। और दोसुर दिन पावल बारनाबासके संग डर्बी नगरमे चलगिल।<verse eid="ACT 14:20" /></para>
  <para style="s">सिरियामेसे एन्टिओखिया शहरमे फिर्ता हुइलक</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />ओकर पाछे पावल और बारनाबास उ नगरमे खुशीक खबर प्रचार करके और बहुत्ते चेला बनाके अपन डगर फिर्ता हुई लग्लाँ। ओइने फेनदोस्रे लुस्त्रा शहरमे गैलाँ। तब ओइने वहाँसे आइकोनिया शहरमे गैलाँ। और ओकर पाछे ओइने पिसिदिया जिल्लक लग्गे एन्टिओखिया शहरमे गैलाँ। <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />और हरेक ठाउँमे चेलनहे बल्गर कर्ती रलाँ, और ओइन्हे विश्वासमे पलिरहहो कहिके शिक्षा दिँत; और ओइने असिके कहिँत, “परमेश्वरके राजमे जाइक लग हम्रिहिन्हे बहुत्ते कष्ट सहे परी।” <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />और ओइने प्रत्येक मण्डलीक समूहमे ओइन्के लग मण्डलीक अगुवा नियुक्त करलाँ। और उपवास बैठ्के प्राथना करलाँ, और ओइन्हे प्रभु येशूक हाँथेम सौँपदेलाँ, जोन प्रभुमे ओइने विश्वास कर्ले रहिँत। <verse eid="ACT 14:23" /><verse number="24" style="v" sid="ACT 14:24" />ओकरपाछे पिसिदिया प्रदेशमेसे ओइने पामफिलिया प्रदेशमे गैलाँ। <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />और पामफिलिया प्रदेशके पर्गा नगरमे ओइने परमेश्वरके वचन प्रचार करलाँ, और ओकरपाछे ओइने अटालिया शहरमे गैलाँ। <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />और वहाँसे ओइने पानी जहाजमे बैठ्के एन्टिओखिया शहरमे फिर्ता होगिलाँ। जहाँसे ओइन्हे परमेश्वरके अनुग्रहमे सौँपके उ काम करक लग पठागिल रहिन, जोन कामहे पूरा करके आब ओइने फिर्ता होगिल रहिँत। <verse eid="ACT 14:26" /><verse number="27" style="v" sid="ACT 14:27" />एन्टिओखिया शहरमे पुगके ओइने मण्डलीक मनैनहे जमा करैलाँ। और ओइन्हे बतैलाँ कि परमेश्वर ओइन्के संग रहिके बर-बर काम कसिके करलाँ, और कसिके परमेश्वर गैर-यहूदिनहे येशू ख्रीष्टमे विश्वास करक लग सहायता करलाँ। <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />तब वहाँ पावल और बारनाबास बहुत्ते दिनसम चेलनके संग रलाँ।<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s">यरुशलेम शहरके परिषद्</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />कौनो यहूदी विश्वासीन यहूदिया प्रदेशमेसे एन्टिओखिया शहरमे आके विश्वासीनहे असिके शिक्षा देना सुरु करलाँ, “तुहुरे मोशक रीतिअनुसार खतना नै करबो कलेसे तुहुरे मुक्ति भेटाई नै सेक्बो।” <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />तब् पावल और बारनाबासके ओइन्के संग बहुत मतभेद और वाद-विवाद होगिलिन। तब वहाँक विश्वासी भैयन एक्के मन बनाके यी फैसला करलाँ कि पावल और बारनाबासहे कौनो दोसुर चेलनके संग यी प्रश्नक हल निकारक लग निउतरह्यनके थेन और मण्डलीक अगुवनके थेन यरुशलेम शहरमे पठादेलाँ। <verse eid="ACT 15:2" /><verse number="3" style="v" sid="ACT 15:3" />मण्डलीक सदस्यन ओइन्हे वहाँसे पहुँरा देके विदा करलाँ। ओइने फोनिके और सामरिया प्रदेश ओहोँरसे जाइबेर गैर-यहूदिनके प्रभुहे ग्रहण कर्लक बात ओइने मिलाके सुनादेलाँ। यी खबर सुनके वहाँक विश्वासीन गजब खुशी होगिलाँ। <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />जब पावल और बारनाबास यरुशलेम शहर पुग्लाँ ते ओइन्हे मण्डली, निउतरह्यन और मण्डलीक अगुवन स्वागत करलाँ। परमेश्वर ओइन्के माध्यमसे कर्लक सक्कु बातके प्रतिवेदन ओइने देलाँ।<verse eid="ACT 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 15:5" />तब् फरिसी दलके विश्वास करुइयन बहुत जाने उठ्के कलाँ, “गैर-यहूदिनके खतना हुइना और ओइन्हे मोशक नियम कानुन पालन करो कहिके आज्ञा देना जरुरी बा।” <verse eid="ACT 15:5" /><verse number="6" style="v" sid="ACT 15:6" />यकर बारेमे सोचविचार करना लक्ष्य लेके निउतरह्यन और मण्डलीक अगुवन जमा होगिलाँ।<verse eid="ACT 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 15:7" />बरे नम्मा बहस चलके सेकल ते पत्रुस ठरह्याके ओइन्हे कहल, “हे मोरिक विश्वासी भैयो, तुहुरिन्हे पतै बा, सुरुक दिनवामे कसिके परमेश्वर मोरिक मुहेँमेसे गैर-यहूदिनके खुशीक खबरके वचन सुनिँत। और विश्वास करिँत् कहिके तुहुरिन्के बिच्चेमसे परमेश्वर महिन्हे चुन्लाँ। <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />मनके बात जनुइया परमेश्वर उ मनैनहे फेन हम्रिहिन हस पवित्र आत्मा देके अपन मनै कहिके ग्रहण करल बात देखैलाँ। <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />ऊ ओइन्के और हमार बिच्चेम कौनो भेदभाव नै धरलाँ, पर ओइन्के मन विश्वाससे शुद्ध परलाँ।<verse eid="ACT 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 15:10" />तबेकमारे यी गैर-यहूदी विश्वासी चेलनके कन्धामे यहूदी मोशक नियम कानुनके जुवा धारके काकरे तुहुरे परमेश्वरके परीक्षा करथो? यी जुवा ना ते हमार पुर्खनके, ना ते हम्रे बोके सेक्ली? <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />असिके करना ठिक नै हो, हम्रे विश्वास कर्थी कि प्रभु येशूक अनुग्रहसे हम्रे मुक्ति भेटाइल बती, ठिक ओस्तेहेँके ओइने फेन भेटाइल बताँ। मोशक नियम कानुन पालन करके केऊ फेन मुक्ति नै भेटाइत।”<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />तब् सभामे सक्कु जाने चुप होगिलाँ, तब् गैर-यहूदिनके बिच्चेम परमेश्वर ओइन्से कसिन चिन्हा और अचम्मक काम करलाँ कहिके ओकर बयान बारनाबास और पावल करलाँ। ओइने यी बयान सुन्लाँ।<verse eid="ACT 15:12" /></para>
  <para style="s">याकूबके निर्णय</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 15:13" />ओइने बोलके सेक्लाँ, तब् याकूब असिक कहल,</para>
  <para style="p" vid="ACT 15:13">“हे मोरिक विश्वासी भैयो, मोरिक बात सुनो, <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />सिमोन पत्रुस व्याख्या करल कि परमेश्वर गैर-यहूदिनहे दया करलाँ, और बहुत्ते मनैनहे अपन मनै कहिके चुन्लाँ।<verse eid="ACT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 15:15" />यहे बातके संग परमेश्वरके अगमवक्तक वचन फेन मिलत, जोन बहुत आघे असिके लिखल रहे,<verse eid="ACT 15:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ACT 15:16" />‘यी बातके पाछे मै घुमम और दाऊदके भस्कल घरहे फेनदोस्रे बनैम, जोन घर ओकर विरोधीन नाश करदेले रहिँत।</para>
  <para style="q" vid="ACT 15:16">और मै ओकर बँचल अवशेष फेनदोस्रे बनादेहम।</para>
  <para style="q" vid="ACT 15:16">और उहिहे ठरह्वा देहम।<verse eid="ACT 15:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ACT 15:17" />और बाँकी सक्कु मनै परमप्रभुहे खोजे सेकिँत। और सक्कु गैर-यहूदिनके फेन, जेने मोरिक नाउँसे बलागिल बताँ।<verse eid="ACT 15:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ACT 15:18" />यी बात परमप्रभु कथाँ, जे प्राचीन कालसे यी बात जनाइल बताँ। और जे सृष्टिक शुरुवातसे जनागिल बताँ।’”<verse eid="ACT 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />“तबेकमारे मोरिक फैसला यहे बा कि परमेश्वरके ओहोँर घुमुइया गैर-यहूदिनहे हम्रे यहूदी मोशक नियम कानुन पालन करे परी कहिके जबरजस्ती करके दुःख ना दि। <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />पर ओइन्हे हम्रे यी बात चिट्ठी लिख्के पठादी, कि ओइने मूर्तिहे चह्राइल खैना चिज ना खाइँत। और व्यभिचार ना करिँत्। और घेँचा अँइठके मुँवाइल पशुनके सिकार और जानबरीनके खुन ना खाइँत। <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />काकरेकी आघेक पुस्तासे नगर-नगरमे मोशक नियम कानुनके प्रचार करुइयन आइल बताँ। काकरेकी यी हरेक बैठक भवनमे हरेक बिँसैना दिनमे पहरजाइत।”<verse eid="ACT 15:21" /></para>
  <para style="s">परिषद्के निर्णय</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />तब् निउतरह्यन, मण्डलीक अगुवन और पूरा यरुशलेम शहरके मण्डली मिलके विश्वासीनमेसे मुख्य अगुवन यहूदा कना बारसाबास और सिलासहे रोज्लाँ। और ओइन्हे पावल और बारनाबासके संग एन्टिओखिया शहरके मण्डलीमे पठैना निर्णय करलाँ। <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />और ओइन्के संग ओइने यी चिट्ठी पठैलाँ: “एन्टिओखिया शहर, सिरिया और किलिकिया प्रदेशमे रहुइया गैर-यहूदी विश्वासी भैयनहे, निउतरह्या और मण्डलीक अगुवनके ओहोँरसे नमस्कार!<verse eid="ACT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 15:24" />हम्रे सुनल बती, कि हमार बिच्चेमसे कौनो-कौनो मनै हमार आदेश बिना तुहुरिन्के थेन जाके तुहुरिन्के मनहे दोधारमे पारके कैयो बातसे दुःख देहल बताँ। <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />तबेकमारे हम्रे सक्कु जाने सक्कुहुनके सहमतीमे कर्लक निर्णय अनुसार गोड्गात मनैनहे रोजके ओइन्हे हमार प्रिय संघरिया बारनाबास और पावलके संग अप्निनके थेन पठाईती। <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />यी मनै असिन हुइँत, जेने हमार प्रभु येशू ख्रीष्टके लग अपन ज्यान जोखिममे पारल बताँ।<verse eid="ACT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 15:27" />तबेकमारे हम्रे यहूदा और सिलासहे पठाइल बती। ओइने फेन यी बात अपन व्यक्तिगत तरिकासे बतैहीँ। <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />काकरेकी पवित्र आत्मा और हम्रिहिन्हे यहे ठिक लागल, कि यी जरुरी बातसे बाहेक आकुर धेउर बोझ अप्निन्हे नै बोकैना हो। <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />अप्निनके मूर्तिनहे चह्राइल खैना चिज ना खैबी, और व्यभिचार ना कर्बी, घेँचा अँइठके मुँवाइल पशुनके सिकार और जानबरीनके खुन ना खैबी। और यी सक्कु चिजसे अलग रहबी कलेसे मजा हुई। आब हम्रे बिदा माँगति।”<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />तब बिदाबारी होके ओइने एन्टिओखिया शहरमे पुग्लाँ, और समुदायहे एक्के थेन जम्मा करके वहे चिट्ठी देलाँ। <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />चिट्ठीमे रहल अर्तीक बात पहरके ओइने खुशी होगिलाँ। <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />यहूदा और सिलास अप्निहीँ फेन परमेश्वरके अगमवक्ता हुइलक ओहोँरसे विश्वासीनहे बहुत्ते वचनसे अर्ती देके ओइन्हे बल्गर बनैलाँ।<verse eid="ACT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 15:33" />यहूदा और सिलास थोरिक दिन वहाँ बिताके सेक्लाँ ते वहाँक विश्वासीन यरुशलेम शहरके मण्डलीमे शान्तिक आशिष देके ओइन्हे विदा देके पठैलाँ। <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />(पर सिलास वहैँ एन्टिओखिया शहरमे रना निर्णय करल, तबेकमारे यहूदा एक्केली यरुशलेम शहर घुमके गैलस।) <verse eid="ACT 15:34" /><verse number="35" style="v" sid="ACT 15:35" />पावल और बारनाबास भर शिक्षा देती और प्रभु येशूक वचन प्रचार कर्ती आकुर बहुत्ते जहनके संग एन्टिओखिया शहरमे बैठ्लाँ।<verse eid="ACT 15:35" /></para>
  <para style="s">पावल और बारनाबासके फरक विचार</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />थोरिक दिन पाछे पावल बारनाबासहे कहल, “आऊ, जोन-जोन नगरमे हम्रे प्रचार करल रही उ नगरमे घुमके जाके विश्वासीनहे भेँटा करी, और ओइने का-कसिन बताँ कहिके हेरी।” <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />बारनाबास मर्कूस कना यूहन्नाहे अपन संग लैजिना मन कर्लस। <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />पर पावल मर्कूसहे संगे लैजिना ठिक नै मानल। काकरेकी ऊ पामफिलिया प्रदेशमेसे ओइन्से अल्गाके गैल रहे, और ओइन्के संग काममे नै गैल रहे।<verse eid="ACT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 15:39" />पावल और बारनाबासके बिच्चेम विश्वासके मामलामे अतरा भारी असहमति होगिलिन, कि ओइने एकदोसर जहनसे अल्गागिलाँ। और बारनाबास मर्कूसहे अपन संग लेके साइप्रस टापु ओहोँर चलगिलस।<verse eid="ACT 15:39" /></para>
  <para style="s">पावलके दोसर प्रचार-यात्रा</para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 15:40" />पर पावल सिलासहे रोजल, तब् विश्वासी भैयनसे परमेश्वरके अनुग्रहमे अर्पण होके ओइने एन्टिओखिया शहरमेसे विदा होगिलाँ। <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />तब ओइने मण्डलीक विश्वासीनहे बल्गर करैती सिरिया और किलिकिया प्रदेशमे गैलाँ।<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s">पावल और सिलाससे तिमोथीक भेँटा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />पावल और सिलास डर्बी और लुस्त्रा शहरमे फेन अइलाँ। वहाँ तिमोथी नाउँ रहल एकथो चेला रहे। उ एकथो विश्वासी यहूदी जन्नीक छावा रहे। पर ओकर बाबा भर ग्रीक देशके बासिन्दा रहिस। <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />लुस्त्रा और आइकोनिया शहरके विश्वासीनके बिच्चेम ओकर गवाही मजा रहिस। <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />पावलहे उहि अपन संग लैजिना मन हुइलिस। उ ठाउँमे रहुइया यहूदिनके कारण पावल उहिहे लैजाके खतना करल। काकरेकी ओकर बाबा ग्रीक देशके बासिन्दा रहिस कना ओइन् सक्कुहुनहे पता रहिन।<verse eid="ACT 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 16:4" />पावल और ओकर संघरियन शहरके डगर ओहोँरसे जाइबेर ओइने यरुशलेमके निउतरह्या और मण्डलीक अगुवनके कर्लक निर्णय विश्वासीनहे पालन करहो कहिके सुनैलाँ। <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />असिके मण्डलीक विश्वासीन विश्वासमे बल्गर हुइती और गिन्तिमे दिन-दिने बहरती गैलाँ।<verse eid="ACT 16:5" /></para>
  <para style="s">माकेडोनिया प्रदेशमे जैना दर्शन</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />पवित्र आत्मासे एशिया प्रदेशमे वचन प्रचार करना मनाही हुइलक ओहोँरसे पावल और ओकर संघरियन फ्रिगिया और गलातियक ईलाका ओहोँरसे हुइती गैलाँ। <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />माइसियक ईलाकामे आके सेकके ओइने बिथिनियक ईलाका ओहोँर जैना विचार करलाँ। येशूक आत्मा ओइन्हे जाई नै देलिन। <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />तब् माइसियक ईलाका हुइती ओइने त्रोआस शहरके बन्दरगाहामे गैलाँ।<verse eid="ACT 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 16:9" />रातके पावल एकथो दर्शन देखल; माकेडोनियक ईलाकामे रहुइया एकथो मनैया ठरह्याके ओइन्हे बिन्ती करतेहे, “समुन्दरके उपार माकेडोनियक ईलाकामे आदेऊ, और हम्रिहिन्हे सहायता करदेऊ।” <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />जब ऊ यी दर्शन भेटाइल, तब जुरतेहेँ हम्रे माकेडोनिया ईलाकामे जैना तयार होगिली। हम्रे यी पक्का कर्ली, कि ओइन्हे खुशीक खबर प्रचार करक लग परमेश्वर हम्रिहिन्हे बलाइल बताँ।<verse eid="ACT 16:10" /></para>
  <para style="s">फिलिप्पीमे लिडियाके परिवर्तन</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />तब् हम्रे त्रोआस शहरमेसे पानी जहाजमे चहुँरके सोझे सामोथ्राके टापु ओहोँर गैली, और दोसुर दिन नियापोलिस शहरमे पुगगिली। <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />और वहाँसे हम्रे फिलिप्पी शहरमे पुग्ली, जोन माकेडोनिया प्रदेशके मुख्य शहर हो, जहाँ रोमी नागरिक फेन बैठिँत। हम्रे उ शहरमे थोरिक दिन बैठ्ली। <verse eid="ACT 16:12" /><verse number="13" style="v" sid="ACT 16:13" />आब बिँसैना दिनमे शहरके दवारमेसे बाहेर लदियक आँरितिर गैली। काकरेकी वहाँ यहूदिनके प्राथना करना ठाउँ बा कना हम्रे अनुमान लगाइल रही। और वहाँ हम्रे बैठ्ली। और जमा हुइलक जन्नी मनैनके संग बात बटवाई लग्ली।<verse eid="ACT 16:13" /></para>
  <para style="s">यूरोपके सुरुक विश्वासी</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 16:14" />तब् लिडिया नाउँक थिआटिरा शहरके एकथो जन्नी जे बैजनी लुग्गक व्यापार करे। ऊ परमेश्वरके अराधक रहे, पावलके बोलल बात ध्यानसे सुने कहिके प्रभु ओकर मन खोलदेलाँ। <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />जब ओकर और ओकर घरपरिवारके मनै डुब्कि लेलाँ, तब् ऊ हम्रिहिन्हे बिन्ती करल, “यदि अप्निनके महिन्हे प्रभुक विश्वासी मन्थी कलेसे मोरिक घरेम आके रहिजाई।” और ऊ हम्रिहिन्हे मनाके लैगिल।<verse eid="ACT 16:15" /></para>
  <para style="s">भूत्वासे छुटकारा</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />जब हम्रे प्राथना करना ठाउँमे जाइतिही, तब् एकथो नोकर्नी लौँदीक संग हमार भेँटा हुइल। ओकरमे एकथो असिन भूत्वा रहिस, जेकर सहायतासे ऊ भविष्यक बारेम बताए, और भविष्य हेरके अपन मलिक्वनके लग बहुत्ते कमाही करदेहे। <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />ऊ पावल और हमार पाछे-पाछे लागगिल, और असिक कती चिल्लाइल, “यी मनै सर्वोच्च परमेश्वरके सेबक हुइताँ। यने तुहुरिन्हे मुक्ति कसिके मिलत कहिके बतैथाँ।” <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />उ बहुत्ते दिनसम असिक कर्ती रहल। तब् पावल परेसान होके फिरिक्से घुमके उ भूत्वाहे कहल, “येशू ख्रीष्टके नाउँमे मै तुहिहे ओकरमेसे निकरना आज्ञा करतुँ।” तब् उ भूत्वा जुरतेहेँ निकरगिल।<verse eid="ACT 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19" />जब ओकर मलिक्वन ओइन्के कमाहिक आशा विफल हुइल देख्के पावल और सिलासहे पकरके शहरके चोकमे शासकहुँक्रिहिनके थेन तन्ति लैगिलाँ। <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />तब् ओइन्हे शहरके हाकिमनके थेन नानके कलाँ, “यी मनै यहूदी हुइँत, यने हमार शहरमे हुलदङ्गा मचाइतताँ। <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />और यने असिन-असिन चलन सिखैथाँ, जोन हम्रे रोम शहरमे रहुइयनके लग ग्रहण करना बिरकुले ठिक नै हो।”<verse eid="ACT 16:21" /></para>
  <para style="s">पावल और सिलास झेलमे</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 16:22" />तब् पावल और सिलासके विरोधमे मनैनके भीर जमा होगिलिन। शहरके हाकिमहुँक्रे ओइन्के लुग्गा फारके फेँकादेलाँ, और ओइन्हे लट्ठीलेके पिटे लगैलाँ। <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />ओइने पावल और सिलासहे दटके पिट्के झेलमे दारदेलाँ। और थाहनक हाकिमहे यी कैदिनहे कड़ा निगरानीमे धरहो कहिके हुकुम देलाँ। <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />असिन हुकुम भेटाके ऊ ओइन्हे झेलके भितरका कोन्तीमे लैजाके ओइने नेँगे ना सेकिँत कहिके ओइन्के गोरामे कठ्वक साँकर ठोकदेलिन।<verse eid="ACT 16:24" /></para>
  <para style="s">पावल और सिलास झेलमेसे छुट्लक</para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />लगभग आधा रात ओहोँर पावल और सिलास प्राथना कर्ती परमेश्वरके भजन गाइतिहिँत, और दोसुर कैदीन उ बात सुनतिहिँत। <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />तब् एकफाले एकथो बरवार भुँइचाल गैल। और झेलके जग हिलगिलाँ, और जुरतेहेँ सक्कु दवार खुलगिल, और सक्कु कैदिनके बन्धन खुलगिलिन।<verse eid="ACT 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 16:27" />झेलके हाकिम निंदमेसे जागगिल, और झेलके दवार खुलल देख्के कैदीन सक्कु जाने भागगिल हुइहीँ कना सोँचके ऊ अपन हत्या करना विचारसे अपन तरवाल निकारल। <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />पर पावल जोरसे असिक कती चिल्लाइल, “अप्नि अपन कुछु नोक्सानी ना कर्बी, काकरेकी हम्रे सक्कु जाने यहैँ पलिबती।”<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />तब् ऊ दिया माँगके भित्तर आइल, और डरकमारे थर्थरैती पावल और सिलासके आघे घोपत्या परगिलस।<verse eid="ACT 16:29" /></para>
  <para style="s">झेलके हाकिमके मन परिवर्तन</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 16:30" />ओइन्हे बाहेर नानके ऊ कहल, “हे महाशय, मुक्ति पाइक लग महिन्हे का करे परी?” <verse eid="ACT 16:30" /><verse number="31" style="v" sid="ACT 16:31" />तब् ओइने कलाँ, “प्रभु येशू ख्रीष्टमे विश्वास करी और अप्नि और अप्निक परिवार मुक्ति भेटैबी।”<verse eid="ACT 16:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 16:32" />ओइने उहिहे और ओकर घरक सक्कु मनैनहे प्रभुक वचन सुनैलाँ। <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />तब् रातिक वहे बेला ऊ ओइन्हे लैजाके ओइन्के खटरा धोदेहल। तब् ऊ और ओकर परिवार जुरतेहेँ डुब्कि लेलाँ। <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />और ऊ ओइन्हे घरेम नानके ओइन्के आघे खाना धारदेहल। और परमेश्वरहे विश्वास करके ओकर पूरा परिवार खुशी होगिलाँ।<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />दोसुर दिन सक्करहीँ शहरके हाकिमहुँक्रे सिपाहिनहे यी आदेश देके पठैलाँ, “उ मनैनहे छोरदेऊ।” <verse eid="ACT 16:35" /><verse number="36" style="v" sid="ACT 16:36" />तब् झेलके हाकिम पावलहे यी बात सुनाइल, “शहरके हाकिमहुँक्रे अप्निन्हे छोरदेना आदेश देले बताँ। तबेकमारे आब निकरके शान्तिसे जाऊ।”<verse eid="ACT 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37" />पर पावल ओइन्हे कहल, “हम्रे रोम देशके नागरिकहे दोषी बिना ठहरैले ओइने मनैनके आघे पिट्लाँ। और झेलमे फेन दरलाँ, और आब हम्रिहिन्हे चुप्पेसे निकारे खोजतताँ? यी नै हुई सेकी, ओइने अप्निहीँ आइँत, और हम्रिहिन्हे बाहेर निकारके लैजाँइत।” <verse eid="ACT 16:37" /><verse number="38" style="v" sid="ACT 16:38" />उ सिपाहिन हाकिमनहे यी बात सुनैलाँ। पावल और सिलास रोम देशके नागरिक हुइताँ कना सुनके ओइने डरागिलाँ। <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />और ओइने आके पावल और सिलाससे माफी मंग्लाँ, और ओइन्हे बाहेर लैगिलाँ। और ओइने शहर छोरके चलजाइँत कहिके ओइन्हे अनुरोध करलाँ।<verse eid="ACT 16:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 16:40" />ओइने झेलमेसे बाहेर निकरके लिडियक घरेम गैलाँ, और विश्वासीनके संग भेटघाट करके ओइन्हे हौसला देके विदा होगिलाँ।<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s">थेसलोनिके शहरमे पावल और सिलास</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />पावल और सिलास अम्फिपोलिस और अपोल्लोनिया नगरमेसे थेसलोनिके शहरमे अइलाँ। जहाँ एकथो यहूदिनके बैठक भवन रहे। <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />पावल अपन चलन अनुसार यहूदिनके बैठक भवनके भित्तर गैल। और तीन हप्तासमके बिसैना दिनसम पवित्र शास्त्रमेसे ओइन्के संग बहस कर्तिरहल।<verse eid="ACT 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 17:3" />“ख्रीष्टहे जरुर दुःख भोगे परना रहिन, और मुअलमेसे जित्ती हुई परना रहिन। और यहे येशू, जेकर विषयमे खुशीक खबर मै अप्निन्हे सुनाइतुँ, वहे ख्रीष्ट हुइताँ” कना बातके मतलब खोलके ऊ ओइन्हे व्याख्या कर्ती साबित करदेहल। <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />ओइन्मेसे कौनो-कौनो यहूदिनके और परमेश्वरके डर मनुइया ग्रीक देशके मनै और बहुत्ते खानदानी जन्नी मनै विश्वास करके पावल और सिलासके ओहोँर लागगिलाँ।<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />पर हिस्का मुके यहूदी दलके नेतन नगरके बदमाश मनैनके भीड़ जमा करके नगरमे हुलदङ्गा मचाई लगैलाँ। और यासोनके घरेम हमला करके पावल और सिलासहे मनैनके भीड़के आघे नाने खोज्लाँ। <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />ओइन्हे फेला पारे नै सेकके, ओइने यासोन और कौनो-कौनो विश्वासीनहे शहरके शासकनके थेन असिक कहिके चिल्लैती घिँस्स्याके नन्लाँ, “हर ठाउँमे परेसानी फैलुइया यी मनै यहाँ फेन आपुगल बताँ।<verse eid="ACT 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 17:7" />और यासोन ओइन्हे अपन घरेम रना अनुमति देले बा, और ओइने सक्कु जाने येशू कना एकथो दोसुर रज्वा बा कहिके रोमी महाराजक हुकुमके विरोध करथाँ।” <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />यी बात सुनके भीड़के मनै और शासकहुँक्रे घब्रागिलाँ। <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />ओइने यासोन और ओकर संगे रहल बाँकी मनैनसे धरौटी लेके ओइन्हे छोरदेलाँ।<verse eid="ACT 17:9" /></para>
  <para style="s">बेरिया नगरमे पावल और सिलास</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />विश्वासीन जुरतेहेँ पावल और सिलासहे रात्तिहीँ बेरिया नगरमे पठादेलाँ। और जब ओइने वहाँ पुग्लाँ, तब् ओइने यहूदिनके बैठक भवनके भित्तर गैलाँ। <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />यहाँक मनै थेसलोनिके शहरके यहूदिनसे धेउर मजा रहिँत। काकरेकी यने पूरा उत्सुक्तक संग वचन ग्रहण करलाँ। और उ बात ठिक्के बा कि नै हो कहिके रोज पवित्र शास्त्रमेसे छानबीन करिँत्। <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />तबेकमारे यनमेसे बहुत्ते जाने, और खानदानी ग्रीक जन्नी मनै और थारु मनैनमेसे बहुत्तेजाने विश्वास करलाँ।<verse eid="ACT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 17:13" />पर जब परमेश्वरके वचन पावलसे बेरिया नगरमे प्रचार हुइता कना थेसलोनिके शहरके यहूदिन पता पैलाँ। तब् ओइने वहाँ फेन आके मनैनहे भरकाई और उक्साई लग्लाँ। <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />तब् विश्वासीन जुरतेहेँ पावलहे समुन्दरके आँरितिर ओहोँर जाए कहिके विदा करलाँ। पर सिलास और तिमोथी भर बेरिया नगरमे रहिगिलाँ। <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />पावलहे पुगाई जउइयन उहिहे एथेन्स शहरसम पुगैलाँ। पर सिलास और तिमोथी भर सेक्लेसे जतरा झत्ते पावलके थेन आइपरी कना आज्ञा पाके ओइने बेरिया नगरमे घुमगैलाँ।<verse eid="ACT 17:15" /></para>
  <para style="s">पावल एथेन्स शहरमे</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />पावल ओइन्हे एथेन्स शहरमे अँस्याई बेर, उ शहरहे मूर्तिए मूर्तिलेके भरल देख्के ओकर मन दुखि होगिलिस्। <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />तबेकमारे ऊ यहूदिनके बैठक भवनमे और परमेश्वरके डर मनुइया गैर-यहूदी मनैनसे और चौराहामे भेँटा हुइलक सक्कु जहनसे रोज बहस करे।<verse eid="ACT 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 17:18" />इपिक्युरी और स्तोइकी दर्शन जनुइया गुरुनमेसे फेन केऊ-केऊ उहिसे बहस करलाँ। और कौनो-कौनो मनै कलाँ, “यी बकबके का कहत?” औरे जाने कलाँ, “दोसुर कौनो विदेशी देउँतनके प्रचार करुइया हस देखाइत।” काकरेकी ऊ येशू और मुअलमेसे फेनदोस्रे जित्ती हुइना बातके खुशीक खबरके प्रचार करे।<verse eid="ACT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 17:19" />तब् ओइने उहिहे अरियोपागस नाउँक बैठक भवनमे लैजाके पुँछ्लाँ, “अप्निक देहल यी लावा शिक्षा का हो, का हम्रे जाने सेक्बी? <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />काकरेकी अप्नि हम्रिहिन्हे अचम्मक बात सुनाइती। तबेकमारे यी बातके मतलब का हो कहिके हम्रे जन्ना चहथी।” <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />(एथेन्स शहरमे बैठुइया सक्कुजाने और वहाँ बैठुइया विदेशी मनै लावा-लावा बात बत्वैना और सुन्ना बाहेक अपन समय औरे कौनो काममे नै बिताइँत।)<verse eid="ACT 17:21" /></para>
  <para style="s">अरियोपागस नाउँक यहूदी बैठक भवनमे पावलके अर्ती</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />पावल अरियोपागस नाउँक यहूदी बैठक भवनके बिच्चेम ठरह्याके कहल,</para>
  <para style="p" vid="ACT 17:22">“एथेन्स शहरके मनै, अप्निन्हे मै सक्कु बातमे देउँतनहे महा आदरसे मनुइया हस देखतुँ, <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />काकरेकी नेङघुम कर्ती जाइबेर मै अप्निनके आराधना करना चिजहे देख्नु। मै एकथो असिन वेदी फेन भेटैनु। जेम्ने असिक खोपल बा, ‘अज्ञात देउँतनके लग।’ तबेकमारे जिहिहे अप्निनके बिना जन्ले आराधना कर्थी, मै ओकर खुशीक खबर सुनाइतुँ।”<verse eid="ACT 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 17:24" />“जोन परमेश्वर, जे संसार और ओम्ने रहल मेरमेरके चिज बनैलाँ, ऊ स्वर्ग और पृथ्वीक प्रभु हुइलक ओहोँरसे हाँथेलेके बनाइल मन्दिरमे नै बैठ्थाँ। <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />हुँकिन्हे कौनो चिजके जरुरी परलेसे फेन मनैनके सहायतक जरुरी नै रथिन। काकरेकी परमेश्वर सक्कुहुनहे जीवन, साँस और सक्कु चिज देथाँ।<verse eid="ACT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 17:26" />ऊ एक्केथो मनैयासे पूरा पृथ्वीमे रहुइया सक्कु जातिनहे बनैलाँ। ओइन्के रहना अवधि और सीमा फेन टोकदेलाँ। <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />परमेश्वर असिके यहे कारण करलाँ ताकि ओइने परमेश्वरहे खोजिँत। सायद ओइने छामछुम करके हुँकिन्हे भेटैथाँ कि कना आशामे यी करगिलस। तभुन फेन ऊ हम्रिहिन्से दूर नै हुइताँ।<verse eid="ACT 17:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 17:28" />काकरेकी ऊ हमार संग बताँ। तबेकमारे हम्रे जिथी और नेङघुम कर्थी और हमार अस्तित्त्व बा। ठिक ओस्तेके जसिके कि तुहुरिन्के कविनके फेन कले बताँ, ‘हम्रे पक्का हुँकारे सन्तान हुइती।’”<verse eid="ACT 17:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 17:29" />“तबेकमारे हम्रे परमेश्वरके सन्तान हुइलक ओहोँरसे, परमेश्वर सोन, चाँदी और पठरा हस हो कहिके हम्रे नै सोँचे परत। यी ते मनैनके कला और कल्पनक आकार किल हुइताँ।<verse eid="ACT 17:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 17:30" />बिगतके मनैनके अज्ञानतक समयहे परमेश्वर ध्यान नै देलाँ। पर आब प्रत्येक ठाउँमे सक्कु मनैनहे मन बदलके पाप करे छोरना आज्ञा देहतताँ। <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />काकरेकी ऊ एक दिन टोकदेहल बताँ, जोन दिन ऊ अपन नियुक्त कर्लक एकथो मनैयक माध्यमसे धार्मिकतामे संसारके न्याय करहीँ। जिहिहे ऊ ठहरैले बताँ, हुँकिन्हे मुअलमेसे जिवाके ऊ सक्कु मनैनहे यकर सबुत देले बताँ।”<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />जब ओइने मुअलमेसे फेनदोस्रे जित्ती हुइना विषयमे सुन्लाँ, तब् केऊ-केऊ मजाक उराई लग्लाँ। पर दोसुरजाने भर कलाँ, “हम्रे फेनदोस्रे यकर बारेमे तोहाँरिक बात सुनब।” <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />ओकरपाछे पावल ओइन्के थेनसे चलगिल। <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />पर गोड्गात मनै ओकर संगे गैलाँ, और प्रभुमे विश्वास करलाँ। ओइन्मेसे अरियोपागस नाउँ रहल बैठक भवनके सदस्य डियनुसियस रहे। दामारिस नाउँ रहल एकथो जन्नी मनैया रहे, और ओकर संग गोड्गात मनै फेन रहिँत।<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s">पावल कोरिन्थ शहरमे</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />ओकरपाछे पावल एथेन्स शहरमेसे विदा होके कोरिन्थ शहरमे गैल। <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />ऊ पोन्टस प्रदेशके वासिन्दा अकिलास नाउँ रहल एकथो यहूदिहे भेटाइल। ऊ अपन जन्नी प्रिस्किलक संग इटालिया प्रदेशसे भर्खर आइल रहे। काकरेकी महाराजा क्लौडियस सक्कु यहूदिनहे<note caller="+" style="f"><char style="fr" closed="false">18:2 </char><char style="fq" closed="false">यहूदिनहे </char><char style="ft" closed="false">रोमी साम्राज्यक राजधानी रोम रहे जोन इटालिया प्रदेशमे परे। महाराजा क्लौडियस यहूदिनहे लगभग ई. स. ४९ मे धार्मिक हुलदङ्गक कारण रोम शहरमेसे बाहेर निकरना आदेश देले रहे। </char></note> रोममेसे निकरके जैना आज्ञा देलक कारण ओइने कोरिन्थ शहरमे आइल रहिँत। पावल ओइन्हे वहाँ भेँटा करे गैल। <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />पावल और अकिलासके एक्के काम हुइलक ओहोँरसे ऊ फेन ओइनेहेँन्के संग बैठल, और काम करल। काकरेकी ओइन्के काम क्रिपाल बनैना रहिन।<verse eid="ACT 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 18:4" />हरेक बिँसैना दिनमे पावल बैठक भवनमे बहस करे, और यहूदी और ग्रीकहुँक्रिहिनहे सम्झाके येशू ख्रीष्टमे विश्वास करैना कोशिस करे। <verse eid="ACT 18:4" /><verse number="5" style="v" sid="ACT 18:5" />जब सिलास और तिमोथी माकेडोनिया प्रदेशमे आपुग्लाँ, तब पावल क्रिपाल बनैना<note caller="+" style="f"><char style="fr" closed="false">18:5 </char><char style="fq" closed="false">क्रिपाल बनैना </char><char style="ft" closed="false">काकरेकी पावलके लग सिलास और तिमोथी माकेदोनिया प्रदेशमेसे कुछ पैँसा नानदेले रहिँत। </char></note> छोरके वचन प्रचार करनामे व्यस्त होगिल। और यहूदिनहे येशूए ख्रीष्ट हुइताँ कना शिक्षा देहे लागल। <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />पर जब यहूदिनके विरोध करके पावलके निन्दा करे लग्लाँ। तब् ऊ अपन लुग्गक धुर झराके ओइन्हे कहल, “परमेश्वरके वचन अस्वीकार कर्लक कारण तुहुरिन्के खुनके दण्ड तुहुरिनेके जिम्मामे बा, मै निर्दोष बतुँ। आबसे मै गैर-यहूदिनके थेन जैम, और परमेश्वरके वचन प्रचार करम।”<verse eid="ACT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 18:7" />तब् ऊ वहाँसे परमेश्वरके भक्ति करुइया गैर-यहूदी तीतस युस्तस नाउँ रहल मनैयक घरेम गैर-यहूदिनहे सिखाई गैल। ओकर घर यहूदी बैठक भवनके लग्गेहेँ रहिस्।<verse eid="ACT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 18:8" />यहूदी बैठक भवनके शासक क्रिस्पसके पूरा परिवार प्रभुमे विश्वास करलाँ। और कोरिन्थ शहरमे रहुइया मनैनमेसे फेन बहुत्ते जाने पावलके वचन सुनके विश्वास करलाँ और डुब्कि लेलाँ। <verse eid="ACT 18:8" /><verse number="9" style="v" sid="ACT 18:9" />एक रात दर्शनमे प्रभु पावलहे कलाँ, “ना डराऊ, पर बोल्ती जाऊ, और चुप ना लागो। <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />काकरेकी मै तोहाँरिक संग बतुँ, और केऊ तुहिन्हे आक्रमण करके नोकसान पुगाई नै सेकी। काकरेकी यी शहरमे मोरमे भरोसा करुइया बहुत्ते मनै बताँ।” <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />तबेकमारे परमेश्वरके वचन सिखैती पावल एक साल छे महिनासम ओइन्के संग रहल।<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />जब गलियोन अखैया प्रदेशके शासक बनल। तब् यहूदी दलके नेतन एक्केम मिलके पावलकेमे आक्रमण करलाँ, और उहिहे अदालतमे नन्लाँ। <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />और असिक कलाँ, “यी मनैया परमेश्वरके आराधना मनैनहे असिके करे सिखाइता, जोन मोशक नियम कानुनके उल्टा बा।”<verse eid="ACT 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14" />जब पावल बोल्ही लागल रहे, तब्बेहेँ गलियोन शासक उ यहूदी दलके नेतनहे कहल, “हे यहूदिनके, यदि जात्तिके यी कुछु अन्याय या दुष्ट अपराधके बात रहत कलेसे मै तुहुरिन्के बात सुन्ना ठिक रहे। <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />पर यदि यी बहसके शब्द, नाउँ और तुहुरिन्के अपने मोशक नियम कानुनके सवाल हुइलक ओहोँरसे तुहुरे अप्निहीँ जानो। मै असिन बातके न्याय करना अस्वीकार करतुँ।”<verse eid="ACT 18:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 18:16" />तब् गलियोन शासक ओइन्हे अदालतमेसे भगादेहल। <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />तब् ओइने सक्कु जाने यहूदी बैठक भवनके शासक सोस्थेनेसहे पकरके अदालतके आघे पिट्लाँ। पर गलियोन उ बातके कुछु वास्ता नै करल।<verse eid="ACT 18:17" /></para>
  <para style="s">पावल एन्टिओखिया नगर घुमल</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />ओकरपाछे पावल बहुत्ते दिनसम कोरिन्थ शहरमे बैठल। तब् विश्वासीनके संग विदा होके ऊ जहाजमे सिरिया प्रदेशमे चलगिल। ओकर संग प्रिस्किला और अकिलास फेन रहिँत। कौनो कसम खैलक कारण ऊ किंक्रिया नगरमे अपन भुट्ला खौरल। <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />ओइने तीनु जाने एफिसस शहरमे आपुग्लाँ। तब् पावल प्रिस्किला और अकिलासहे वहैँ छोरदेहल। और अप्ने भर एकथो बैठक भवनमे पैँठ्के यहूदी दलके नेतनसे बहस करे लागल।<verse eid="ACT 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 18:20" />तब् उ मनै पावलहे थोरिक दिन आकुर बैठ्ना बिन्ती करलाँ, तब् ऊ अस्वीकार करल। <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />पर ओइन्के संग विदा हुइबेर ऊ कहल, “यदि परमेश्वरके इच्छा रही कलेसे मै फेनदोस्रे तुहुरिन्के थेन घुमके अइबुँ।” तब् ऊ जहाजमे चहुँरके एफिसस शहरमेसे चलगिल।<verse eid="ACT 18:21" /></para>
  <para style="s">पावलके तेसर प्रचार-यात्रा</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 18:22" />जब पावल कैसरिया शहरमे उतरल, तब् उप्पर चहुँरके यरुशलेम शहरके मण्डलीहे भेटघाट करके नमस्कार करके एन्टिओखिया नगर ओहोँर गैल। <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />ऊ एन्टिओखिया नगरमे थोरिक दिन रहिके वहाँसे निकरके गलातिया और फ्रिगिया प्रदेश ओहोँरसे होके सक्कु चेलनहे हौसला देती अलग-अलग ठाउँमे गैलस।<verse eid="ACT 18:23" /></para>
  <para style="s">अपोल्लोस नाउँक विद्वान मनैया</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />उ समयमे अलेक्जेन्ड्रिया शहरमे बैठुइया अपोल्लोस नाउँक एकथो यहूदी एफिसस शहरमे आइल। ऊ एकथो सिपार अगमवक्ता और पवित्र शास्त्रमे सिपार और दक्ष रहे। <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />ऊ प्रभुक डगरके शिक्षा भेटाइल रहे। और आत्मामे हौसके ऊ येशूक विषयक बात ठिक ठिकसे बोल्ना और सिखैना काम करे। तभुन फेन ऊ यूहन्नक डुब्किक बात किल जानल रहे। <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />ऊ बैठक भवनमे हिम्मतसे बोले लागल। पर ओकर बोल्लक बात सुनके प्रिस्किला और अकिलास उहिहे अपन घरेम नन्लाँ। और परमेश्वरके डगरके मतलब आकुर फरछ्वारसे बुझादेलाँ।<verse eid="ACT 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 18:27" />अपोल्लोस अखैया प्रदेशमे जैना मन करल। तब् विश्वासीन उहिहे वहाँ जैना उत्साहा देलाँ। और उहिहे ग्रहण करिँत् कहिके वहाँक चेलनहे उत्साहा देके चिट्ठी लिख्लाँ। ऊ वहाँ पुग्के अनुग्रहसे विश्वास करुइया मनैनहे गजब सहायता करल। <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />काकरेकी ऊ पवित्र शास्त्रक वचनसे येशूए ख्रीष्ट हुइताँ कना बात साबित करके यहूदी दलके नेतनहे सक्कुहुनके आघे बिरकुल बिना जवाफके बनादेहल।<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s">पावल एफिसस शहरमे</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />अपोल्लोस कोरिन्थ शहरमे रहल बेला पावल भित्री प्रदेश हुइती एफिसस शहरमे आइल। वहाँ ऊ कौनो-कौनो चेलन संग भेँटा हुइल। <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />ऊ ओइन्हे कहल, “जब तुहुरे विश्वास कर्लो, तब का तुहुरे पवित्र आत्मा भेटैलो?” ओइने उहिहे कलाँ, “पवित्र आत्मा बा कना ते हम्रे सुनल फेन नै हुइती।”<verse eid="ACT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3" />तब् पावल ओइन्हे कहल, “तब् तुहुरे कोन मेरके डुब्कि लेलो?” ओइने कलाँ, “हम्रे यूहन्नक देहल डुब्कि लेली।” <verse eid="ACT 19:3" /><verse number="4" style="v" sid="ACT 19:4" />तब् पावल कहल, “यूहन्नक देहल डुब्कि ते मन बदलके पाप करे छोर्ना और परमेश्वरसे पाप माफिक डुब्कि रहे। पर ऊ इजरायलके मनैनहे येशूकमे विश्वास करे कहल, जे ओकर पाछे अउइया ख्रीष्ट हुइँत कहिके बताए।”<verse eid="ACT 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5" />यी बात सुनके ओइने प्रभु येशूक नाउँमे डुब्कि लेलाँ। <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />जब पावल ओइन्के उप्पर अपन हाँथ धारल, तब् पवित्र आत्मा ओइन्केमे अइलिन। और ओइने दोसुर भाषामे बोले लग्लाँ, और अगमवाणी बोले लग्लाँ। <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />ओइने लगभग बाह्र जाने थारु मनै रहिँत।<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />पावल बैठक भवनमे पैँठ्के तीन महिनासम परमेश्वरके राजके बारेमे ओइन्के संग हिम्मतसे बहस कर्ती रहल, और मनैनहे बुझैती रहल। <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />पर जब कौनो-कौनो मनै हेँक्कर होके विश्वास नै करलाँ। और प्रभुक डगरके विरोधमे सक्कु मनैनके आघे बोले लग्लाँ। तब् पावल ओइन्के थेनसे अल्गे चलगिल। और चेलनहे संगे लैजाके रोज टुरान्नसके स्कुलमे बहस कर्ती रहल। <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />यी काम दुई सालसम चल्ती रहल, और एशिया प्रदेशके सक्कु मनै, और यहूदी और ग्रीक सक्कु मनै प्रभुक वचन सुन्लाँ।<verse eid="ACT 19:10" /></para>
  <para style="s">एफिसस शहरमे अचम्मक काम</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />परमेश्वर पावलके माध्यमसे असाधारण अचम्मक काम करलाँ। <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />यहाँसम कि रुमाल अथवा तौलिया ओकर शरीरमे छुवाके बेमार मनैनके थेन लैजाँइत, और बेमार मनै चोखाजाँइत, और भूत फेन निकरजाँइत।<verse eid="ACT 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 19:13" />पर कौनो-कौनो यहोँर-ओहोँर नेङघुम कर्ती भूत भगुइया यहूदी मनै भूत लागल मनैनहे प्रभु येशूक नाउँ लेके असिक कलाँ, “जोन येशूक प्रचार पावल करत, ओक्रेहे नाउँमे मै तुहिहे बाहेर जैना आज्ञा देहतुँ।” <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />वहाँ एकथो स्केवास नाउँक यहूदी मुख्य पुजारीक सातथो छावन असिके करिँत्।<verse eid="ACT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 19:15" />तब् भूत्वा जवाफ देके ओइन्हे कहल, “येशूहे मै चिन्थुँ, और पावलहे फेन चिन्थुँ, पर तुहुरे के हुइतो?” <verse eid="ACT 19:15" /><verse number="16" style="v" sid="ACT 19:16" />उ भूत्वा लागल मनैया ओइन्के उप्पर कुदुक्ती आइल, और उ सक्कुहुनहे अपन कब्जामे करके ओइन्हे अतरा चिमोथ्लिन कि, ओइने उ घरेमेसे फाटल लुग्गा घल्ले और अरघताहा होके भग्लाँ। <verse eid="ACT 19:16" /><verse number="17" style="v" sid="ACT 19:17" />यी बात एफिसस शहरमे रहुइया यहूदी, और ग्रीकके सक्कु मनै पता पागिलाँ। तब् उ सक्कु जाने डरागिलाँ। और प्रभु येशूक नाउँक प्रशंसा हुइल।<verse eid="ACT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 19:18" />विश्वास करल बहुत्ते मनै अइलाँ, और ओइने अपन-अपन कर्लक दुष्ट कामहे स्वीकार करलाँ, और उ सक्कुहुनके आघे बतादेलाँ। <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />ओइन्मेसे बहुत्ते जाने, जे-जे टुना-मुना करिँत, ओइने अपन-अपन किताब बितोरके नन्लाँ, और सक्कुहुनके आघे जरादेलाँ। ओइने ओकर मोल लगैलाँ ते पचास हजार चाँदीक सिक्कक हिसाब हुइल। <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />असिके प्रभुक वचन फैलतिगैल, और प्रभावशाली हुइल।<verse eid="ACT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />यी घटननके पाछे, पवित्र आत्मक प्रेरणामे पावल माकेडोनिया और अखैया प्रदेशके डगर हुइती यरुशलेम शहर जैना निर्णय करल। ऊ कहल, “यरुशलेम शहर पुग्के महिन्हे रोम शहर जैही परी।” <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />ओकर सेवा करुइयन दुई जाने, तिमोथी और इरास्तसहे ऊ माकेडोनिया प्रदेशमे अपनसे आघे पठाके अप्ने भर थोरिक दिन एशिया प्रदेशके एफिसस शहरमे बैठल।<verse eid="ACT 19:22" /></para>
  <para style="s">एफिसस शहरमे हुलदङ्गा</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />वहे समयमे प्रभुक डगरके बारेमे खोब हलचल मचगिल। <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />काकरेकी डेमेत्रियस नाउँ रहल एकथो चाँदीक मूर्ति बनुइया ग्रीकके देवी आर्तेमिसके चाँदीक छुटीछुटी मूर्तिक मन्दिर कारीगरहुँक्रिहिनसे बन्वाए। और बेँच्वाके गजब नाफा कम्वाए। <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />तब् देमेत्रियस अपन अस्तेहेँ काम करुइयनहे जमा करके कहल, “भैयो, तुहुरिन्हे पतै बा, कि व्यापारसे हम्रिहिन्हे मजा आम्दानी हुइत। <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />तुहुरे देखतो और सुनतो, कि एफिसस शहरमे किल नै हो। पर लगभग पूरा एशिया प्रदेशमे हाँथेलेके बनाइल देउँतीदेउँता जात्तिक नै हुइँत कहिके पावल बहुत्ते मनैनके समूहहे फुस्लाके बहकादेले बा। <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />तबेकमारे हमार व्यापारके इज्जत नाश हुइना किल नै हो। पर महान देवी आर्तेमिसके मन्दिर फेन बेकारके मानजाई, और सारा एशिया प्रदेशमे और संसारभर मन्ती आइल देवीक पुजा हुइना बन्द होजिहिस।”<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />यी सुनके सक्कु मूर्तिक काम करुइया मनै रिसकमारे चुर होगिलाँ। और चिल्लैती कहे लग्लाँ, “एफिसस शहरके मनैनके लग आर्तेमिस देवी महान हुइतिन।” <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />सारा शहरमे हल्ला मचगिल, और ओइने एकजुट होके पावलके संग नेगुइया माकेडोनिया प्रदेशमे बैठुइया गायस और अरिस्तार्खसहे पकरके खेल मैदानके भित्तर घिँस्यैती लैगिलाँ।<verse eid="ACT 19:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 19:30" />पावल फेन खेल मैदानमे जाके मनैनसे बात करे चाहल। पर चेलनके उहिहे जाई नै देलाँ। <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />एशिया प्रदेशके तमान प्रमुख मनै पावलके संघरियन रहिँत। ओइने पावलहे खेल मैदानके भित्तर जाके अपन ज्यान जोखिममे ना दारी कहिके बिन्ती पठैलाँ। <verse eid="ACT 19:31" /><verse number="32" style="v" sid="ACT 19:32" />तब् ओइने खेल मैदानके भित्तर मेरमेरके बात कर्ती चिल्लाई लग्लाँ। काकरेकी उ भीड़मे होहल्ला मचल रहे, और बहुत मनैनहे ते काकरे जमा हुइल बती कहिके फेन पता नै रहिन।<verse eid="ACT 19:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 19:33" />भीड़के कौनो-कौनो मनै अलेक्जेन्डरहे आघे पठैलाँ, जिहिहे यहूदी दलके नेतन आघे पठैले रहिँत। अलेक्जेन्डर हाँथेलेके इशारा करके मनैनहे शान्त कराइल। और ओइने ते वहाँ चिल्लैलक आवाज सुनके किल अइलक हुइँत कहिके भीड़के उ मनैनहे सम्झैना कोशिस करल।<verse eid="ACT 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 19:34" />पर जब ओइने पता पैलाँ कि ओइने यहूदिन हुइताँ, जेने विश्वासीनके हस मूर्तिक आराधना नै करथाँ। तब लगभग दुई घण्टासम सक्कु जाने एक्के स्वरमे चिल्लैलाँ, “एफिसस शहरके आर्तेमिस देवी महान हुइतिन।” <verse eid="ACT 19:34" /><verse number="35" style="v" sid="ACT 19:35" />शहरके हाकिम मनैनहे शान्त कराके कहल, “एफिसस शहरके मनै सुनो, एफिसीनके शहर भर महान आर्तेमिस देवीक मन्दिर और आकाशमेसे गिरल, ओकर मूर्तिक रक्षक हो कना बात सक्कु मनैनहे पता बा। <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />अप्निनके जन्थी कि यी बात काटे सेकुइया केऊ नै हो। तबेकमारे अप्निन्के शान्त होजाई, और बिना सोँच्ले कौनो काम ना कर्बी। <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />तुहुरिन्के नन्लक यी मनै मन्दिर नै लुटल हुइँत, और हमार देवीक अपमान फेन नै करल हुइँत।<verse eid="ACT 19:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 19:38" />तबेकमारे यदि डेमेत्रियस और ओकर संग रहुइया कारीगरनमेसे कौनो मनैनके विरोधमे कुछु उजूरी बा कलेसे अदालतमे जाँइत। और न्यायधीशके थेन अपन मुद्दक फैसलक लग उजूरी करिँत्। ओइने एकदोसर जहनके विपक्षमे मुद्दा लरिँत। <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />पर यकर बाहेक दोसुर विषय उठाई चहथी कलेसे ओकर फैसला नियमित शहरके सभामे हुई। <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />काकरेकी मै डराइतुँ कि आझिक यी हुलदङ्गक बारेम सरकार सुनी, और कहि कि हम्रे रोमी सरकारके विरोधमे विद्रोह करना कोशिस करती। काकरेकी यी बिना कारणके हुलदङ्गक विषयमे कुछु जवाफ हम्रे देहे नै सेकब।” <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />अतरा कहिके ऊ सक्कु मनैनहे विदा करल।<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s">पावल माकेडोनियामे और ग्रीसमे</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />यी हुलदङ्गा थमके सेकल ते पावल अपन चेलनहे बलाई पठाइल। और ओइन्हे हौसाइल। और ओइन्से विदा होके माकेडोनिया प्रदेश ओहोँर चलगिल। <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />वहाँक सक्कु ईलाका ओहोँरसे जाके ओइन्हे गजब उत्साह देके ग्रीस प्रदेश जिहिहे अखैया प्रदेश कथाँ, ऊ वहैँ चलगिल। <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />वहाँ ऊ तीन महिना बिताइल। पर सिरिया प्रदेश ओहोँरसे पानी जहाजमे जाइबेर ऊ सुनल कि कौनो-कौनो यहूदी दलके नेतन उहिहे पानी जहाजमे मरना योजना बनाइतताँ। तबेकमारे ऊ माकेडोनिया प्रदेश ओहोँरे घुमके जैना निर्णय करल।<verse eid="ACT 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 20:4" />तब् बेरिया नगरमे बैठुइया पुरसके छावा सोपात्रोस, थेसलोनिके शहरमेसे अरिस्तार्खस और सिकान्दस, डर्बी नगरके गायस और लुस्त्रा नगरके तिमोथी और एशिया प्रदेशके तुखिकस और त्रोफिमस हमार संग गैलाँ। <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />यने हम्रिहिन्से आग्गिहीँ पुग्के हम्रिहिन्हे त्रोआस शहरमे अँस्याइतिहिँत। <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />पर हम्रे दुईजाने भर अखमिरी रोटीक तिहुवारके दिनक पाछे फिलिप्पी शहरके जमिनमे यात्रा करके पाँच दिनमे त्रोआस शहरमे ओइन्के थेन पुग्ली, और वहाँ सात दिन रली।<verse eid="ACT 20:6" /></para>
  <para style="s">युटिकस जित्ती बनागिलक</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />हप्तक सुरुक दिन जब हम्रे प्रभुभोजके लग जमा हुइली। तब् पावल दोसुर दिन जैना मन कर्लक ओहोँरसे ऊ ओइन्के संग आधा रातसम बात बत्वैती रहल। <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />हमार जमा हुइलक घरक उपरका तल्हक कोन्तीमे बहुत्ते दिया बरतिहिँत।<verse eid="ACT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 20:9" />युटिकस नाउँ रहल एकथो जवान मनैया मोकामे बैठल रहे। पावल बहुत बेरसम बात बट्वाइबेर ऊ गहिँर निंदमे रहे। और निंदासलकेमारे ऊ तेस्रा तलामेसे गिरगिल। और जब कौनो-कौनो मनै उतरके तरे ओहोँर दौर्ती गैलाँ, और उहिहे उठैलाँ ते ऊ मुसेकल रहे। <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />तब् पावल तरे उतरल और ओकर लग्गे जाके घोपत्या होके उहिहे उँक्वारमे लेहल और कहल, “जिन घबराऊ, काकरेकी ऊ अभिन जित्तिए बा।”<verse eid="ACT 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 20:11" />तब् ऊ दोबारा उप्पर चहुँरल, और रोटी खन्टाके ओइने सक्कु जाने संगे खैलाँ, और बेहानके ओजरार नै हुइतसम् महा बेर बात बत्वैती रहल। तबजाके विदा होगिल।<verse eid="ACT 20:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 20:12" />तब् ओइने उ जवान मनैयाहे जित्तिए हालतमे लैगिलाँ, और बहुत खुशी हुइलाँ।<verse eid="ACT 20:12" /></para>
  <para style="s">त्रोआसमेसे मिलेटससमके यात्रा</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />पावल जमिन ओहोँरसे अस्सोस शहर जैना निर्णय करल। हम्रे पानी जहाजमे चहुँरके आग्गिहीँ गैली। और हम्रे पावलहे उ पानी जहाजमे बैठैना योजना बनैले रही। काकरेकी पावल अस्सोससम पैदले गैल रहे। <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />और जब उहिहे हम्रे अस्सोस शहरमे भेटैली, तब हम्रे उहिहे पानी जहाजमे चहुँरैली, और मितिलेने नगरमे अइली।<verse eid="ACT 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 20:15" />दोसुर दिन वहाँसे पानी जहाजमे यात्रा करके हम्रे खियस टापुक आँरितिर पुगगिली। और तेसर दिन हम्रे सामोस टापुमे आपुग्ली। ओकर दोसुर दिन हम्रे सामोस टापु छोरके मिलेटस नगरमे अइली। <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />एशिया प्रदेशमे समय बितैना विचार नै हुइलक ओहोँरसे पावल एफिसस शहरमे बिना पैँठ्ले जैना निर्णय करल। काकरेकी सम्भव हुइलेसे पेन्तिकोस तिहुवारके दिन यरुशलेम शहरमे पुग्ना ऊ हतार करतेहे।<verse eid="ACT 20:16" /></para>
  <para style="s">एफिसस शहरके एल्डरहुँक्रिहिनसे बिदाई</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />हम्रे मिलेटस शहरमे आके सेक्ली ते पावल एफिसस शहरके मण्डलीक अगुवनहे एकथो खबर पठाइल। <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />जब ओइने ओकर थेन अइलाँ, तब ऊ ओइन्हे कहल,</para>
  <para style="p" vid="ACT 20:18">“एशिया प्रदेशमे पुग्लक सुरुक दिनसे आजसम मै पूरा समय तुहुरिन्के बिच्चेम कोन मेरके बितैनु कहिके तुहुरिन्हे पता बा। <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />पूरा नम्रतामे आँश बहैती, यहूदी दलके नेतनके षड्यणन्त्रक परीक्षामे फेन मै प्रभुक सेवा कर्नु। <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />जोन-जोन बात तुहुरिन्के फाइदा हुइना रहे, मै तुहुरिन्के आघे घोषणा करनासे और घर-घरेम सक्कुहुनके सामुन्ने तुहुरिन्हे शिक्षा देनासे कबु पाछे नै हट्नु। <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />बेन यहूदिनहे और ग्रीकहुँक्रिहिनहे अपन मन बदलके पाप करना छोरके परमेश्वरके ओहोँर घुमो। और प्रभु येशू ख्रीष्टके उप्पर विश्वास करो कना बातके प्रचार मै कर्ले बतुँ।”<verse eid="ACT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 20:22" />“आब हेरो, मै पवित्र आत्मक आज्ञा मानके यरुशलेम शहर ओहोँर जाइतुँ। वहाँ महिन्हे का-कसिन हुई कना बारेमे मै कुछु नै जन्थुँ। <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />अतरा किल जन्थुँ, कि हरेक शहरमे कैद और कष्ट मोरिक उप्पर परे आई कना पवित्र आत्मा महिन्हे गवाही देथाँ। <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />पर मै अपन जीवनहे कौनो मोलके और अपन लग दुलार नै मन्थुँ। बेन अतरा किल चहथुँ, कि परमेश्वरके अनुग्रहक खुशीक खबरके गवाही देहक लग मोरिक दौड़ और प्रभु येशूकमेसे मिलल मोरिक सेवकाई मै पूरा करे सेकुँ।”<verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />“आब हेरो, मै जन्थुँ कि तुहुरिन्मेसे सक्कु जाने, जिही-जिहिहे मै परमेश्वरके राजके प्रचार कर्ती नेंग्नु, तुहुरे महिन्हे दोबारा कबु नै देख्बो। <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />तबेकमारे आझिक दिन मै तुहुरिन्हे गवाही देहतुँ, कि यदि केऊ येशूकमे बिना विश्वास कर्ले मुई कलेसे उ मोरिक गल्ती नै हो। <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />काकरेकी मै तुहुरिन्हे सक्कु बात बतैनु, जोन बात परमेश्वर चाहतिहिँत कि तुहुरे जानो, मै कुछु फेन नै नुकैनु। <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />तबेकमारे तुहुरे अपन लग और अपन पूरा समूहक लग सावधान रहहो। पवित्र आत्मा तुहुरिन्हे समूहक मण्डलीक अगुवा बनैलक ओहोँरसे तुँ ख्रीष्टके खुनेलेके किनल परमेश्वरके मण्डलीक रेखदेख तुहुरे करो। <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />काकरेकी महिन्हे पता बा, कि मै जैम ते झूँटा शिक्षा देहुइयन तुहुरिन्के बिच्चेम अइहीँ, और ओइने विश्वासीनहे बहुत नोकसान पुगैहीँ। ओइने भेरीँनहे मरुइया बवाँसन हस रहिहीँ। <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />यहाँसम कि तुहुरिन्के अपने विश्वासीनके समूहमेसे असिन-असिन मनै निकरके अइहीँ, जेने चेलनहे अपन पाछे तानक लग तेँर-बेँर बात बत्वैहीँ।<verse eid="ACT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 20:31" />तबेकमारे यी सोँचके हौश्यार रहहो, कि तीन सालसम दिनरात आँश बहैती हरेक मनैनहे मै चेतावनी देती रनु। <verse eid="ACT 20:31" /><verse number="32" style="v" sid="ACT 20:32" />आब मै तुहुरिन्हे परमेश्वरमे और हुँकार अनुग्रहक वचनमे सौँप देहम, जे तुहुरिन्हे बल्गर बनाई। परमेश्वर तुहुरिन्हे उ उत्तराधिकार दिहीँ, जोन उत्तराधिकार देहक लग ऊ सक्कु मनैनसे वाचा कर्ले बताँ, जेने हुँकार माध्यमसे पवित्र हुइल बताँ।<verse eid="ACT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 20:33" />मै कौनो मनैयक सोन, चाँदी या लुग्गक लालच नै कर्नु। <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />तुहुरे अप्निहीँ जन्थो कि मोरिक यहे दुनु हाँथ मोरिक अपने और मोरिक संग रहुइयनके जरुरीहे पूरा करल बताँ। <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />मै सक्कु बातमे तुहुरिन्हे उदाहरण देहल बतुँ, कि तुहुरे फेन अस्तेहेँके कड़ा मेहनत करके कमजोर मनैनहे सहयोग करे परत। प्रभु येशूक वचन याद रहे, कि ऊ अप्निहीँ कहल बताँ, कि लेनासे देना धन्य हो।”<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />अतरा कहिके ऊ ठेहुनी टेकल, और वहाँ रहल सक्कुहुनके संग प्राथना करल। <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />तब ओइने सक्कु जाने बहुत रुइलाँ, और पावलहे उँक्वारमे लेके चुम्मा खाके बिदा करलाँ। <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />तुहुरे महिन्हे दोबारा कबु नै देख्बो कहिके पावलके कहल बातमे ओइने गजब शोक करलाँ। तब् ओइने उहिहे पानी जहाजसम पुगैलाँ।<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s">यरुशलेम शहरके यात्रा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />एफिसस शहरमे रलक मण्डलीक अगुवनसे विदा होके हम्रे पानी जहाजमे चहुँरके सोझे कोस टापुमे अइली। और दोसुर दिन रोडस टापुमे और वहाँसे पटारा टापुमे पुग्ली। <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />तब् फोनिके प्रदेशमे जैना एकथो पानी जहाजमे चहुँरके यात्रा सुरु कर्ली।<verse eid="ACT 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 21:3" />जब साइप्रस टापु देखा परल, तब् हम्रे उहिहे बाउँ पाँजर पारके सिरिया प्रदेश ओहोँर लागके टुरोस नगरमे उतरली। काकरेकी पानी जहाजमेसे मालसामान वहाँ उतारे परना रहे। <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />चेलनहे फेला पारके ओइन्के संग हम्रे सात दिन वहाँ बैठ्ली। पावलहे यरुशलेम शहरमे नै जैहो कहिके ओइने पवित्र आत्मक अगुवाइसे बिन्ती करलाँ।<verse eid="ACT 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 21:5" />सात दिन पाछे जब वहाँसे हमार जैना समय हुइल ते हम्रे विदा होके अपन यात्रामे निकरगिली। अपन परिवार बालबच्चा समेत ओइने जम्मै हम्रिहिन्हे शहरके बाहेरसम पुगाई अइलाँ। और हम्रे समुन्दरके आँरितिर ठेहुनी टेकके प्राथना कर्ली। <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />ओकर पाछे हम्रे एकदोसर जहनसे विदा होगिली। आब हम्रे पानी जहाजमे चहुँरली, और ओइने भर अपन-अपन घर घुमगैलाँ।<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />टुरोस नगरमेसे समुन्दरके यात्रा करके हम्रे टोलेमाइस नगरमे पुगगिली। वहाँ विश्वासीनहे नमस्कार करके ओइन्के संग एक दिन बैठ्ली। <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />दोसुर दिन हम्रे विदा होके कैसरिया शहरमे अइली, और खुशीक खबर प्रचार करुइया फिलिपके घरेम पैँठ्ली। जे उ सात जहनमेसे एकथो मनैया रहे जिहिहे विधवनहे रेखदेख करक लग यरुशलेम शहरके निउतरह्यन चुनल रहिस। <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />ओकर अगमवाणी बोल्ना चारथो कुँवारी छाई रहिस।<verse eid="ACT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 21:10" />जब हम्रे वहाँ थोरिक दिन बैठ्ली ते यहूदिया प्रदेशमेसे अगाबस नाउँक एकथो परमेश्वरके अगमवक्ता आइल। <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />ऊ हमार थेन आके पावलके पटुका लेके अपन हाँथ-गोरा बाँधल और कहल, “पवित्र आत्मा असिक कहतताँ, ‘यी पटुका जोन मनैयक हो, उहिहे यरुशलेम शहरमे यहूदी दलके नेतन अस्तेहेँके बहन्हीँ। और गैर-यहूदिनके हाँथेम सौँपदिहीँ।’”<verse eid="ACT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12" />जब हम्रे यी बात सुन्ली, तब हम्रे और उ ठाउँक मनै मिलके पावल यरुशलेम शहरमे ना जाए कहिके बिन्ती कर्ली। <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />पर पावल जवाफ देहल, “तुहुरे असिके रोके काकरे मोरिक मनहे कमजोर पारतो? मै ते प्रभु येशूक नाउँक लग यरुशलेम शहरके कैदमे परना किल नै होके, पर मुअक लग फेन मै तयार बतुँ।” <verse eid="ACT 21:13" /><verse number="14" style="v" sid="ACT 21:14" />उहिहे मनाई नै सेकके “प्रभुक इच्छा पूरा होए।” कहिके हम्रे चिमचाम होगिली।<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />थोरिक दिन पाछे हम्रे तयार होगिली और यरुशलेम शहर ओहोँर गैली। <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />हमार संगे कैसरिया शहरके कौनो-कौनो चेलनके फेन गैलाँ, और ओइने हम्रिहिन्हे उ समयमे साइप्रस टापुमे बैठुइया मनासोन नाउँक एकथो पुरान चेलक घरेम नन्लाँ। ओकर थेन हम्रिहिन्हे रहे परल रहे।<verse eid="ACT 21:16" /></para>
  <para style="s">पावल यरुशलेम शहरमे पुग्लक</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />और जब हम्रे यरुशलेम शहर पुग्ली, तब् विश्वासीन खुशी हुइती हम्रिहिन्से भेँटा हुइलाँ। <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />दोसुर दिन पावल हमार संग याकूबके थेन गैल। वहाँ मण्डलीक सक्कु अगुवन जमा हुइल रहिँत। <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />ओइन्हे नमस्कार करके सेकके, पावल ओइन्के सेवकाईसे गैर-यहूदिनके बिच्चेम परमेश्वरके कर्लक काम ओइन्हे एक-एक करके बयान करल। <verse eid="ACT 21:19" /><verse number="20" style="v" sid="ACT 21:20" />यी सुनके ओइने परमेश्वरके महिमा करलाँ। तब् ऊ कहल, “हेरो भैयो, तुहुरिन पता बा कि यहूदिनके बिच्चेम विश्वास करुइयन हजारौँ बताँ, और सक्कु जाने मोशक नियम कानुन विश्वासयोग्यतासे मन्थाँ। <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />ऊ यहूदी विश्वासीन अप्निक बारेमे फेन कुछु हल्ला सुनल बताँ, उ का हो कलेसे, गैर-यहूदिनके बिच्चेम रहुइया यहूदिनहे अप्नि ‘मोशक नियम कानुन छोरदेहो। और अपन लरकनके खतना ना करहो। और यहूदी रीतिरिवाज पालन ना करहो’ कहिके सिखाइल बती, हुँ।<verse eid="ACT 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 21:22" />आब हम्रे का करी? अप्नि आइल बती कहिके मनै पक्कै फेन सुन्हीँ। <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />तबेकमारे ज्या हम्रे कबी, अप्नि वहे करी। हमार यहाँ चार जाने मनै बताँ, जेने परमेश्वरके आघे कसम <note caller="+" style="f"><char style="fr" closed="false">21:23 </char><char style="fq" closed="false">कसम </char><char style="ft" closed="false">पहिले इजरायल देशमे कौनो-कौनो थारु मनैनके लग असिन चलन रहिन कि ओइन्हे अपन पूरा जीवन अंगुरके मदसे या अशुद्ध करना चिजसे दूर रहे परिन और ओइने अपन भुट्ला कबु नै कट्ना कसम खाइँत। पाछेजाके यहूदी कानुन कौनो एकथो मनैयाहे अस्थाई रुपमे एकथो नाजिरी हुइना अवसर मिल्लिस, जेकर मतलब यी रहे कि ऊ एकथो टोकल समयसम एकथो नाजिरीक रुपमे रही, और उ समयक अन्त्यमे पालिकपाला बलिदान चह्रैहीँ। जब यी सब चिज पूरा होजाई। तब उ मनैया अपन भुत्ला खौर्वालेहे और बलिदानके संगसंगे अपन भुत्ला जरा देहे। ओकर पाछे ऊ अंगुरके रस पिना भेटाए और अपन सामान्य जीवन जिअक लग स्वतन्त्र होजाए। </char></note>खाके पूरा कर्ले बताँ। <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />यनहे लेके अप्नि फेन यनके संगसंगे शुद्ध हुइना विधि पूरा करी, और यनहे चहना खर्च अप्नि भरदी, और यने अपन कपारिमनिक भुट्ला खौरिँत। असिके अप्निहे मोशक नियम कानुन पालन करल देख्के अप्निक बारेमे सुन्लक कौनो बात सच्चा नै हो कहिके सक्कु जाने पता पैहीँ।<verse eid="ACT 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 21:25" />पर गैर-यहूदिनके जेने विश्वास करल बताँ। ओइने मूर्तिनहे चह्राइल खैना चिज ना खाइँत। और जानबरीनके खुन ना खाइँत। और घेँचा अँइठके मुँवाइल पशुनके सिकार ना खाइँत। और व्यभिचार ना करिँत् कना हमार निर्णय जनाके हम्रे चिट्ठी लिखल बती।” <verse eid="ACT 21:25" /><verse number="26" style="v" sid="ACT 21:26" />दोसुर दिन पावल उ मनैनहे अपन संग लैजाके अपनहे शुद्ध करल। तब ऊ मन्दिरमे गैल। और घोषणा करल कि जब शुद्धिकरणके दिन ओराई। तब ओइन्मेसे हरेक जहनके लग देना दान चह्राजैहिन।<verse eid="ACT 21:26" /></para>
  <para style="s">मन्दिरमे पावलहे पक्राऊ</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />जब सतौँ दिन पूरा हुई लागल रहे, तब् एशिया प्रदेशके यहूदिनके पावलहे मन्दिरमे देख्के सारा भीड़हे उक्सैलाँ, और पावलहे हुलदङ्गा मचैती पकरलाँ। <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />ओइने असिक कती चिल्लाई लग्लाँ, “इजरायलके मनै सहायता करो! मनैनहे जेहोँर-तेहोँर हमार जाति, हमार मोशक नियम कानुन और यी ठाउँक विरोधमे शिक्षा देती नेगुइया मनैया यहे हो। अतरा किल नै हो, यी गैर-यहूदिनहे फेन मन्दिरके भित्तर नानके यी पवित्र ठाउँहे अशुद्ध बनादेहल बा।” <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" />ओइने असिके यहे कारण कलाँ, काकरेकी यकर आघे ओइने एफिसस शहरके त्रोफिमस कना एक जहनहे पावलके संग शहरमे देख्लक ओहोँरसे उहिहे ऊ मन्दिरके भित्तर नानल हुई कहिके सोँच्लाँ।<verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />तब् पूरा शहरमे हुलदङ्गा मचगिल और मनै दौर्ती आके जमा हुइलाँ, ओइने पावलहे पकरके मन्दिरमेसे बाहेर घिँस्यैती नन्लाँ, और जुरतेहेँ दवार बन्द करदेलाँ। <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />जब ओइने उहिहे पीटना कोशिस करतिहिँत, तब् सारा यरुशलेम शहरके मनै हुलदङ्गा करतताँ कना बातके खबर पल्टनके सेनापतिक थेन पुग्लिस।<verse eid="ACT 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 21:32" />ऊ जुरतेहेँ सिपाही और कप्तानहुँक्रिहिनहे संगे लेके दौर्ती आइल। भीड़के मनै सेनापति और सिपाहिनहे देख्लाँ, और पावलहे ठठाई छोरदेलाँ। <verse eid="ACT 21:32" /><verse number="33" style="v" sid="ACT 21:33" />तब् उ सेनापति पावलके लग्गे आके उहिहे पक्रल, और दुईथो सिँक्रीलेके उहिहे बहन्ना आदेश देहल। यी के हो और यी का करल कहिके ऊ पुँछल।<verse eid="ACT 21:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 21:34" />पर उ भीड़मेसे केऊ एक बात केऊ दोसुर बात कहिके चिल्लैलाँ। और उ होहल्लक कारण घटना का हो कना पता पाई नै सेक्लक ओहोँरसे पावलहे ब्यारेकमे लैजाऊ कहिके सेनापति ओइन्हे अह्राइल। <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />जब पावल सीढ़ीमे पुगल, तब् भीड़के दबाबके कारण सिपाहिन उहिहे उठाके लैगिलाँ। <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />काकरेकी मनैनके भीड़ “उहिहे मुवाँदेऊ” कहिके चिल्लैती पाछे-पाछे लागल रहे।<verse eid="ACT 21:36" /></para>
  <para style="s">भीड़के मनैनहे पावलके सम्बोधन</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />ब्यारेकके भित्तर पुगाइबेर पावल सेनापतिहे कहल, “अप्नि, अनुमति देबी कलेसे, मै अप्निहे कुछु कहक चहथुँ।” ऊ कहल, “का तैँ ग्रीक भाषा बोले जन्थे? <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />का तैँ वहे मिश्र देशके नै हुइस, जे भर्खर सरकारके विरोधमे विद्रोह मचाके चार हजार विद्रोहीनहे उजाड़-ठाउँमे लैगिल रहे?”<verse eid="ACT 21:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39" />पर पावल जवाफ देहल, “नाई, मै ते यहूदी मनैया हुइतुँ। मै किलिकिया प्रदेशके टार्सस शहरमे जल्मनु, छुटिमुती शहरके नागरिक नै हुइतुँ। बिन्ती बा, महिन्हे यी मनैनहे कुछु कना अनुमति दैदी।” <verse eid="ACT 21:39" /><verse number="40" style="v" sid="ACT 21:40" />जब सेनापति अनुमति देहल, तब् सीढ़ीमे ठरह्याके पावल मनैनहे हाँथेलेके शान्त रहो कहिके इशारा करल। जब मनै एकदम शान्त हुइलाँ, तब ऊ हिब्रू भाषामे कहल:<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="s">भीड़के मनैनहे पावलके सन्देश</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />हे मोरिक विश्वासी भैयो और बाबन, तुहुरिन्के आघे मै अपन पक्षमे कहे परना बात आब सुनो।<verse eid="ACT 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 22:2" />उहिहे हिब्रू भाषामे बोलत सुनके ओइने आकुर शान्त होगिलाँ।<verse eid="ACT 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3" />ऊ कहल, “मै ते यहूदी मनैया हुइतुँ। मै किलिकिया प्रदेशके टार्सस शहरमे जल्मनु। पर यी शहरमे गमलिएलके चरणमे शिक्षा भेटैलक मनैया हुइतुँ। हमार पुर्खनके चलन अनुसार मै ठिक-ठिक शिक्षा भेटैनु। आज तुहुरे परमेश्वरकेमे जतरा समर्पित बतो, मै फेन ओत्रेहे समर्पित रहुँ। <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" />मै प्रभुक डगरमे नेगुइया मनैनहे मुनासम सतैनु और थारु और जन्नी दुन्हुनहे बहानके झेलमे दारदेनु। <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />यहूदी प्रधान पुजारी और सक्कु महासभक अगुवन फेन मोरिके पक्षमे गवाही देथाँ। ओइनेहेँन्के तरफसे दमस्कस शहरके यहूदी भैयनके नाउँमे चिट्ठी पाके मै वहाँ रहल विश्वासीनहे बहानके यरुशलेम शहरमे नानके सजाय देहवाइक लग दमस्कस शहरमे गैल रहुँ।”<verse eid="ACT 22:5" /></para>
  <para style="s">पावलके मन बदल्लक ब्याख्या</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />“मोरिक यात्रामे दमस्कस शहर थेन पुगलमे लगभग दुपहर हुइल रहे। एकफाले स्वर्गमेसे एकथो बरवार ओजरार मोरिक आँजर-पाँजर चम्कल। <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />और मै भुइयाँमे गिरगैनु। तब् महिन्हे असिक कहत एकथो आवाज सुन्नु, ‘ए शाऊल, ए शाऊल, तुँ काकरे महिन्हे सतैथो?’ <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />तब् मै पुँछ्नु, ‘हे प्रभु, अप्नि के हुइती?’ तब् ऊ महिन्हे कलाँ, ‘नासरत गाउँक येशू महिँए हुइतुँ, जिहिहे तुँ सताइतो।’ <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />तब् मोरिक संग जतरा जाने रहिँत, ओइने आवाज सुन्लाँ, पर महिन्हे का कहल कहिके नै बुझ्लाँ। <verse eid="ACT 22:9" /><verse number="10" style="v" sid="ACT 22:10" />मै कनु, ‘हे प्रभु, मै का करुँ?’ तब् प्रभु महिन्हे कलाँ, ‘उठो, दमस्कस शहरमे जाऊ, और तुहिन्हे करे परना तोकल काम तुहिन्हे सब बताजाई।’ <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />उ ओजरारके तेजके कारण जब मै कुछु नै देखे सेक्नु, तब् मोरिक संग रहुइयन हाँथेलेके पकरके नेगाके महिन्हे दमस्कस शहरमे नन्लाँ।”<verse eid="ACT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12" />“हननिया कना एकथो मोशक नियम कानुन अनुसार चल्ना धार्मिक मनैया जे वहाँ बैठुइया सक्कु यहूदिनसे आदर भेटाइल रहे। <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />ऊ मोरिक थेन आइल और मोरिक थेन ठरह्याके महिन्हे कहल, ‘शाऊल भैया, देख्नाहाँ होजाऊ।’ और मै वहे समयमे देख्नाहाँ होगैनु, और उहिहे देख्नु।<verse eid="ACT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 22:14" />तब् ऊ कहल, ‘हमार बाबा-पुर्खनके परमेश्वर तुहिन्हे हुँकार इच्छा जानक लग और धर्मी ख्रीष्टहे देखक लग और हुँकार आवाज सुनक लग तुहिन्हे नियुक्त करल बताँ। <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />काकरेकी सक्कु मनैनके आघे हुँकार लग तुँ ज्या देखल और सुनल बतो, तुँ ओकर साँखी हुइबो। <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />आब काकरे बेर करतो? उठो और डुब्कि लेऊ, और अपन पापसे माफी भेटैना चहथो कलेसे हुँकार नाउँ गोहराऊ।’<verse eid="ACT 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />यरुशलेम शहरमे आके मन्दिरमे प्राथना करेबेर मै दर्शन देख्नु। <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />मै प्रभुहे देख्नु और प्रभु महिन्हे कलाँ, ‘झत्तेहेँ यरुशलेम शहरमेसे निकरजाऊ, काकरेकी मोरिक बारेमे तोहाँर देलक गवाही यहाँ रहल मनै ग्रहण नै करहीँ।’<verse eid="ACT 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 22:19" />मै कनु, ‘हे प्रभु, मै नै बुझ्नु कि यरुशलेम शहरके यहूदी मनै काकरे विश्वास नै करलाँ। काकरेकी मै हरेक यहूदी बैठक भवनमे जाके अप्निक उप्पर विश्वास करुइया मनैनहे खोज-खोजके झेलमे दर्लक, और अप्निकमे विश्वास करुइया मनैनहे मारपिट कर्लक बात यन सक्कुहुनहे पता बतिन। <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />अप्निक साँखी स्तिफनसके हत्या हुइबेर मै अप्निहीँ फेन लग्गेहेँ ठरह्याके उ हत्यामे सहमत होके, उहिहे मरुइयनके लुग्गा रखाके बैठल रहुँ।’ <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />तब् प्रभु महिन्हे कलाँ, ‘जाऊ, काकरेकी मै तुहिन्हे गैर-यहूदिनके थेन दूर-दूरसम पठैम।’”<verse eid="ACT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />उ मनै पावलके बात यहाँसम किल सुन्लाँ, और असिक कती ओइने चिल्लाई लग्लाँ, “यी मनैयाहे मारदेऊ। काकरेकी ऊ जिना लायकके नै हो।” <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />ओइने अपन-अपन बाहेर घल्लक लुग्गा फर्ती और अपन रीस देखाइक लग धुर उरैती चिल्लाई लग्लाँ। <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />सेनापति हुकुम देहल, “यिहिहे ब्यारेकके भित्तर लयानो और कोर्रा लगाके जाँचो, कि काकरे ओकर विरोधमे ओइने असिके चिल्लाइतताँ।”<verse eid="ACT 22:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 22:25" />और जब ओइने पावलहे छालक लस्रीलेके बहन्लाँ, तब् पावल अपन लग्गे ठरह्याइल कप्तानहे पुँछल, “का रोमी नागरिकहे और दोषी नै ठहरल मनैयाहे तुहुरिन्के कोर्रा लगैना सही हो?” <verse eid="ACT 22:25" /><verse number="26" style="v" sid="ACT 22:26" />कप्तान यी सुनके सेनापतिक थेन आके असिक कहल, “अप्नि काकरे असिके करती? काकरेकी यी मनैया ते रोमी नागरिक हो।”<verse eid="ACT 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27" />तब् सेनापति आके पावलहे पुँछल, “महिन्हे को, का तैँ रोम देशके नागरिक हुइते?” ऊ कहल, “हुइतुँ।” <verse eid="ACT 22:27" /><verse number="28" style="v" sid="ACT 22:28" />यी सुनके सेनापति कहल, “मै फेन रोमी नागरिक हुइतुँ। मै रोमी नागरिक हुइक लग बहुत्ते रुपिया तिर्नु।” पावल कहल, “पर मै ते जल्मेसे रोमी हुइतुँ।” <verse eid="ACT 22:28" /><verse number="29" style="v" sid="ACT 22:29" />पर उहिहे जाँच करक लग तयार रहुइयन सक्कु जाने जुरतेहेँ ओकर थेनसे हट्गैलाँ। और पावल एकथो रोमी नागरिक हो कहिके पता पाके सेनापति फेन डरागिल, काकरेकी ऊ उहिहे बाँधल रहे।<verse eid="ACT 22:29" /></para>
  <para style="s">पावल महासभक आघे</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />दोसुर दिन यहूदी दलके नेतन पावलहे कोन खास कारणसे दोष लगाइल रहिँत उ बुझक लग ओकर सिँक्री खोलदेलाँ। और सक्कु मुख्य पुजारीनहे और महासभाहे जुटना आज्ञा देलाँ। और पावलहे तरे नानके ओइन्के आघे ठरह्वैलाँ।<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />पावल महासभा ओहोँर सोझे हेरल और कहल, “भैयो, आझिक दिनसम परमेश्वरके नजरमे मै सच्चा विवेकसे जीवन बिताइल बतुँ।” <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />पावलके कलक बात सुनके यहूदी प्रधान पुजारी हननिया ओकर आँरितिर ठरह्याइल मनैनहे ओकर मुहेम मरना हुकुम देहल। <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />जब केऊ पावलहे झाँपर मारल, तब पावल कहल, “हे कपटी! तुहिहे फेन परमेश्वर प्रहार करहीँ। तैँ मोशक नियम कानुन अनुसार मोरिक इन्साफ करे बैठके का मोशक नियम कानुनके उल्टा महिन्हे मरना हुकुम देथे?”<verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />तब् आँरितिर ठर्हुइयन कलाँ, “तैँ परमेश्वरके प्रधान पुजारीक अपमान करथे?” <verse eid="ACT 23:4" /><verse number="5" style="v" sid="ACT 23:5" />तब् पावल कहल, “हे मोरिक भैयो, ऊ यहूदी प्रधान पुजारी हुइँत कहिके महिन्हे पता नै रहे। काकरेकी पवित्र शास्त्रमे लिखल बा,</para>
  <para style="q" vid="ACT 23:5">‘तैँ अपन जनतनके शासकके बारेमे खराबी ना बोलिस।’”<verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />पर उ महासभामे कौनो सदुकी दलके मनै और कौनो फरिसी दलके मनै बताँ कना पता पाके पावल जोरसे कहल, “भैयो, मै ते फरिसीनके सन्तान फरिसीए हुइतुँ। परमेश्वर मुअल मनैनहे फेनदोस्रे जिवैहीँ कना आशामे विश्वास कर्लक कारण मोरिकमे दोष लगाके मुद्दा चलता।” <verse eid="ACT 23:6" /><verse number="7" style="v" sid="ACT 23:7" />ऊ असिक कहिके सेकल ते फरिसी दलके मनैनके और सदुकी दलके मनैनके झगरा हुइलगलिन। और भीड़के मनैनमे दरार परगिलिन। <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />काकरेकी सदुकी दलके मनैनके विश्वास यी बतिन कि मनै मुअलमेसे फेनदोस्रे नै जिथाँ। और स्वर्गदूत, आत्मा कना चिज कुछ नै रहत। पर फरिसी दलके मनै यी सक्कु चिजमे विश्वास करथाँ।<verse eid="ACT 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 23:9" />वहाँ बरवार हुलदङ्गा मचगिल, और फरिसी दलके गोड्गात यहूदी कानुनके गुरुनके ठरह्याके असिक कती प्रतिवाद करे लग्लाँ, “यी मनैयकमे हम्रे कुछु खराबी नै भेटाईथुइति। सायद आत्मा या स्वर्गदूतनके यिहिहे असिक कलाँ कि?” <verse eid="ACT 23:9" /><verse number="10" style="v" sid="ACT 23:10" />वहाँ बरवार हुलदङ्गा मचल ते ओइन्के हाँथेमेसे पावलहे चिमोथिक चिमोथा हुइना डरेलेके सेनापति सिपाहिनहे तरे जाके पावलहे सभक सदस्यनके बिच्चेमसे बरबत्ति नानके ब्यारेकके भित्तर लैजिना आदेश देहल।<verse eid="ACT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11" />वहे रातके प्रभु येशू पावलके लग्गे ठरह्याके कलाँ, “सँस्सा करो, पावल! काकरेकी जसिके तुँ यरुशलेम शहरमे मोरिक बारेमे गवाही देलो, ओस्तेहेँके तुहिन्हे रोम देशमे फेन गवाही देहे परी।”<verse eid="ACT 23:11" /></para>
  <para style="s">पावलहे मुवैना षड़यन्त्र</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />सक्कारे जब ओजरार होके सेकल, तब् कौनो-कौनो यहूदी दलके नेतन आपसमे गट्ठा बहानके पावलहे नै मुवाँइतसम कुछु नै खैबी, और कुछु नै पिअब कहिके कसम <note caller="+" style="f"><char style="fr" closed="false">23:12 </char><char style="fq" closed="false">कसम </char><char style="ft" closed="false">जब कौनो मनै कसम खैथाँ, ऊ कुछु बात करत और अपन वचन पूरा करक लग परमेश्वरसे बिन्ती करत। यदि ऊ अपन वचन पूरा नै करत कलेसे परमेश्वर उहिहे सजाई देथाँ। </char></note>खैलाँ। <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />यी षड्यण्त्र करुइया मनै चालीससे फेन धेउर रहिँत।<verse eid="ACT 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 23:14" />यने मुख्य पुजारीनके और यहूदी दलके नेतनके थेन जाके कलाँ, “पावलहे नै मुवाँइतसम हम्रे कुछु नै खैबी कहिके हम्रे पक्का कसम खाइल बती। <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />तबेकमारे अप्निनके और महासभा मिलके सेनापतिहे अपील करी। और पावलके मुद्दक निर्णय आकुर ठिक रुपसे करे परी कना बहाना बनाके उहिहे निकरवाऊ। और ऊ यहाँ अइति किल हम्रे उहिहे मुवाइक लग तयार रबी।”<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />पर पावलके भैने यहूदी दलके मनै योजना बनाके पावलहे मारक लग बताँ कना पता पाके ब्यारेकके भित्तर जाके पावलहे बतादेहल। <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />तब् पावल कप्ताननमेसे एकथोहे बलाके कहल, “यी लौँदाहे सेनापतिक थेन पुगादी, काकरेकी यकर उहिसे कुछु बात कना बतिस।”<verse eid="ACT 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 23:18" />तबेकमारे उ कप्तान पावलके भैनेहे लेके सेनापतिक थेन पुगाके कहल, “बन्दी पावल महिन्हे बलाके यी लौँदाहे अप्निक थेन लैजाई कहल, अप्निहे कुछु कना बा हुँ।” <verse eid="ACT 23:18" /><verse number="19" style="v" sid="ACT 23:19" />सेनापति ओकर हाँथ पकरके अलग्गे लैजाके पुँछल, “तैँ महिन्हे का कना चाहते?”<verse eid="ACT 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20" />ऊ कहल, “यहूदी दलके नेतन महासभक संग मिलके अप्निहे यी बहाना बनाके अपील करक लग बताँ कि पावलके मुद्दक निर्णय आकुर ठिक रुपसे करवैबी कहिके बाहेर निकरवाके उहिहे मारदेबी कहिके तयार बताँ। <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />पर अप्नि ओइन्के अपील जिन मन्बी। काकरेकी ओइन्मेसे चालीससे फेन धेउर मनै पावलहे नै मुवाँइतसम कुछु खानपिन नै करना कसम खाके हुँकिन्हे मुवाइक लग तयार होके बैठल बताँ, और आब ओइने अप्निक वचनहे अँस्याइतताँ।”<verse eid="ACT 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22" />तबेकमारे सेनापति उ लौँदाहे असिक कहिके आज्ञा देके पठाइल, “तैँ महिन्हे यी खबर देलक बात किहुहे फेन ना बताइस।”<verse eid="ACT 23:22" /></para>
  <para style="s">पावल कैसरियामे पठागिल</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />ओकरपाछे उ सेनापति कप्ताननमेसे दुई जहनहे बलाके कहल, “आज रातके नौ बजे ओहोँर दुई सौ सिपाहिनहे, सत्तर जहन घोड़चढ़ी और दुई सौ भालावालनहे कैसरिया शहरसम जाइक लग तयार पारके धारो। <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />और पावलके लग फेन घोरवा तयार करो। और उहिहे सुरक्षितसे हाकिम फेलिक्सके थेन पुगाऊ।”<verse eid="ACT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 23:25" />सेनापति यी मेरके चिट्ठी हाकिमहे लिखल:<verse eid="ACT 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 23:26" />“माननीय हाकिम फेलिक्सहे, क्लौडियस लुसियसके नमस्कार! <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />यी मनैयाहे यहूदी दलके नेतन पकरके मुवाइक खोजल रहिँत। पर यी रोमी नागरिक हो कना पता पाके मै फौजीनके संग वहाँ पुग्के यिहिहे छुटैनु।<verse eid="ACT 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 23:28" />और कोन अभियोगमे ओइने यिहिहे दोष लगैलाँ कना जन्ना इच्छासे मै यिहिहे ओइन्के महासभामे नन्नु। <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />ओइने अपन यहूदी नियम कानुनके बहसके विषयमे ओकरमे दोष लगाइल रहिँत। पर ज्यान सजाय अथवा कैद करना मेरके कुछु दोष यकरमे मै नै भेटैनु। <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />यी मनैयक विरोधमे षड्यण्त्र हुइता कना बातके सूचना महिन्हे देगिलस, और यिहिहे जुरतेहेँ अप्निक आघे पठाइल बतुँ, और यकर विरोधमे दोष लगुइया यहूदिनहे फेन अप्निक आघे बयान देहो कहिके आदेश देहल बतुँ।”<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />उ रात सिपाहिनके हुँकार आदेश पालन करलाँ, और ओइने पावलहे यरुशलेम शहरमेसे रात्तिहीँ एन्टिपात्रिस शहरमे पुगैलाँ। <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />दोसुर दिन घोड़चढ़ीनहे पावलके संग कैसरिया शहरमे जाइक लग छोरके कुछ पैदरिया सिपाहीन यरुशलेम शहरके ब्यारेकमे घुमगिलाँ। <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />कैसरिया शहरमे पुग्के ओइने हाकिमहे चिट्ठी बुझैलाँ, और पावलहे फेन ओकर आघे हाजिर करैलाँ।<verse eid="ACT 23:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 23:34" />उ चिट्ठी हाकिम पहरके पुँछल, “ऊ कोन प्रदेशके हो?” ऊ किलिकिया प्रदेशके हो कना पता पाके ऊ कहल, <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />“तुहिन्हे अभियोग लगुइयन अइहीँ, तब् मै तोहाँर मुद्दा सुनम।” तब् ऊ पावलहे राजा हेरोदके बनाइल दरबारमे धरहो कहिके हुकुम करल।<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s">पावल फेलिक्सके आघे</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />पाँच दिन पाछे यहूदी प्रधान पुजारी हननिया और गोड्गात यहूदी दलके नेतन, तर्तुल्लस नाउँक एकथो वकीलके संग कैसरिया शहरमे अइलाँ और ओइने पावलके विरोधमे हाकिमके आघे मुद्दा पेश करलाँ। <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />जब पावलहे हेरोद रज्वक दरबारमेसे राजपालके आघे नानगिलिस तब् तर्तुल्लस उहिहे असिक कती अभियोग लगाई लागल, “अति माननीय फेलिक्स, अप्निसे राजमे हम्रे शान्ति भेटाइल बती और अप्नि यी जातिक लग सुधार सुरु करल बती।<verse eid="ACT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 24:3" />यी बात हर मेरके सक्कु ठाउँमे हम्रे धन्यवादके साथ स्वीकार कर्थी।<verse eid="ACT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 24:4" />पर हम्रे चाहति कि अप्निक धेउर समय नै लेके हमार बिन्ती छोटकरीमे दया करके सुनदेबी। <verse eid="ACT 24:4" /><verse number="5" style="v" sid="ACT 24:5" />काकरेकी हम्रे यी मनैयाहे जेहोँर-तेहोँर दुःख देती नेंग्ना, संसार भरके सारा यहूदिनके बिच्चेम आन्दोलन मचैना और नासरत गाउँक धार्मिक सप्रदायक मुख्य अगुवक रुपमे भेटाइल बती। <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />यी मन्दिर अपवित्र परना फेन कोशिस करल रहे, पर हम्रे यिहिहे पकरलेली। हमार मोशक नियम कानुन अनुसार हम्रे यिहिहे दण्ड फेन देती,<verse eid="ACT 24:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 24:7" />पर सेनापति लुसियस हमार थेन आके जबरजस्ती उहिहे हमार हाँथेमेसे छिनके लैगिलाँ, और यकर विरोधमे अभियोग लगुइयनहे अप्निक थेन अइना आज्ञा देलाँ। <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />आब अप्नि अप्निहीँ यकर जाँच कर्बी कलेसे हम्रे यिहिहे लगाइल दोषके यी सक्कु सच्चाई उहिएसे पता लगाई सेक्थी।” <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />उ यहूदी दलके नेतन फेन उ बात सक्कु सही हो कहिके समर्थन करलाँ।<verse eid="ACT 24:9" /></para>
  <para style="s">फेलिक्सके आघे पावलके अपन बचाऊ कर्लक</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />हाकिम पावलहे बोल्ना इशारा करल, तब् पावल जवाफ देहल, “बहुत सालसे अप्नि यी यहूदी जातिक मनैनके न्यायधीश रहल बात पता हुइलक ओहोँरसे मै खुशीसे अपन रक्षक लग प्रत्युत्तर देहतुँ। <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />अप्नि पता लगाई सेक्बी कि मै यरुशलेम शहरके मन्दिरमे आराधना करे अइलक बाह्र दिनसे धेउर नै हुइल हो। <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />यने ना ते महिन्हे कौनो मनैयासे बहस करत भेटैलाँ, ना मन्दिरमे या बैठक भवनमे अथवा शहरमे जनतनहे उत्तेजित पारल भेटैलाँ, <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />ना ते महिन्हे अब्बे दोष लगैती रहल बातके यने सबुत देहे सेक्हीँ।<verse eid="ACT 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 24:14" />पर मै यी अप्निक थेन स्वीकार करतुँ, कि मै हमार पुर्खा परमेश्वरके सेवा करथुँ, जोन ख्रीष्टके डगरहे यहूदी दलके नेतन एकथो झूट दल हो कहिके कथाँ। मै मोशक नियम कानुन और परमेश्वरके अगमवक्तक किताबमे लिखल सक्कु बात विश्वास करके मोरिक पुर्खनके परमेश्वरके आराधना करथुँ। <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />मै परमेश्वरकेमे आशा करथुँ कि धर्मी और अधर्मीन दुन्हुनहे मुअलमेसे परमेश्वर फेनदोस्रे जिउठैथाँ कना बात यने अप्निहीँ स्वीकार करथाँ। <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />तबेकमारे परमेश्वरकेमे और मनैनकेमे मै सदादिन शुद्ध विवेक धरना कोशिस करथुँ।<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />बहुत साल पाछे अपन जातिक गरीबनहे दान देहे और परमेश्वरहे दान चह्राई मै यरुशलेम शहरमे आइल रहुँ। <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />वहे समयमे यने महिन्हे मन्दिरमे शुद्ध हुइना विधि पूरा करत देख्लाँ। वहाँ कौनो भीड़ नै रहे, होहल्ला फेन नै रहे। पर वहाँ एशिया प्रदेशके कौनो-कौनो यहूदी मनै रहिँत। <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />ओइन्हे यहाँ महिन्हे दोष लगाइक लग अप्निक आघे हाजिर हुई परना रहिन। यदि मै कौनो गलत काम करल हुइबुँ कलेसे मोरिकमे आरोप लगाईक लग ओइन्हे यहाँ अप्निक आघे हुई परना रहिन्।<verse eid="ACT 24:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 24:20" />या ते यी मनै अप्निहीँ यहाँ कहिँत कि जब मै महासभक आघे ठरह्याइल रहुँ ते मोरिकमे का कसुर भेटैलाँ? <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />सिरिफ यहे एकथो बात किल हो, जोन मै ओइन्के बिच्चेम ठरह्याके चिल्लाके कले रहुँ, ‘परमेश्वर मुअल मनैनहे फेनदोस्रे जिवैहीँ कना बातमे मै विश्वास कर्लक कारण आज अप्निनके आघे मोरिक मुद्दा चलता’।”<verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />यी ख्रीष्टके डगरके बारेमे हाकिम फेलिक्सहे ठिक-ठिक ज्ञान हुइलक ओहोँरसे उ यी बात सुनके सेकके ओइन्हे असिक कहिके टारके पठादेहल, “सेनापति लुसियस यहाँ अइहीँ, तब् मै तुहुरिन्के मुद्दक फैसला करदेहम।” <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />तब ऊ पावलके मजासे अख्वारी करहो, और थोरिक छुट देहो, और ओकर कौनो फेन संघरियाहे ओकर सेवा करक लग रोक नै लगैहो कहिके कप्तानहे आज्ञा देहल।<verse eid="ACT 24:23" /></para>
  <para style="s">पावलके फेलिक्स और ओकर जन्नीक संग बातचित हुइलक</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />थोरिक दिन पाछे हाकिम फेलिक्स ओकर यहूदी जन्नी द्रुसिल्लाहे अपन संग लेके कैसरिया शहरमे आइल। और ऊ पावलहे बलाके ख्रीष्ट येशूमे विश्वास करना बारेमे उहिसे सुनल। <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />जब पावल परमेश्वरके आघे सच्चा काम करना विषयमे बताई लागल। और इच्छक उप्पर नियन्त्रण करना और अइना न्यायक बारेमे बहस करे लागल। तब फेलिक्स डरागिल, और असिक कहल, “अब्बक लग जाऊ, मौका परल बेला मै अप्निहीँ तुहिन्हे बलैम।”<verse eid="ACT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 24:26" />पावलके कहल बातसे हाकिम फेलिक्स डरागिल। पर झेलमेसे छुटैलक कारण पावलसे कुछ रुपिया मिली कि कना आशा फेन ऊ करल रहे। तबेकमारे फेन ऊ उहिहे घनिघनी बलाके बातचित करे। <verse eid="ACT 24:26" /><verse number="27" style="v" sid="ACT 24:27" />पर दुई साल पाछे जब फेलिक्सके बदलामे पर्किअस फेस्तस हाकिम बनल। तब् हाकिम फेलिक्स यहूदी मनैनहे खुशी करक लग पावलहे झेलमे दारके गैल।<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s">फेस्तसके आघे पावलके मुद्दा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />हाकिम फेस्तस यहूदिया प्रदेशमे अइलक तीन दिन पाछे कैसरिया शहरमेसे यरुशलेम शहरमे गैल। <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />मुख्य पुजारी और यहूदिनके नेतन पावलके विरोधमे अभियोग लगैलाँ। <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />और पावलहे डगरीहिमे मुवैना षड्यण्त्र बनाके उहिहे यरुशलेम शहरमे निकरवादिँत कना बिन्ती करलाँ।<verse eid="ACT 25:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 25:4" />पर हाकिम फेस्तस पावलहे कैसरिया शहरके थानामे दारल। और अप्ने फेन वहाँ झत्ते जैना मन हुइलक बात बत्वाइल। <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />ऊ कहल, “तबेकमारे तुहुरिन्के मनिक नेतन वहाँ मोरिक संग जाँइत, और उ मनैयकमे कुछु खराबी बा कलेसे उहिहे अभियोग लगाँइत।”<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />हाकिम फेस्तस आठ-दश दिनसे धेउर दिन यरुशलेम शहरमे बैठ्के कैसरिया शहरमे घुमगिल। और दोसुर दिन न्याय-आसनमे बैठके ऊ पावलहे नन्ना हुकुम देहल। <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />पावल आइल ते यरुशलेम शहरमेसे अइलक यहूदी दलके नेतन ओकर आँजर-पाँजर ठरह्यागिलाँ। और पावलके विरोधमे अनेक मेरिक गम्भीर अभियोग लगैलाँ, जेकर ओइने सबुत देहे नै सेक्लाँ। <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />पर पावल अपन पक्षमे बोल्ती कहल, “मै यहूदिनके नियम कानुनके विरोधमे, मन्दिरके विरोधमे और महाराजक विरोधमे कुछु अपराध नै करल हुइतुँ।”<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />पर हाकिम फेस्तस यहूदी दलके नेतनहे खुशी पारक लग पावलसे पुँछल, “का तुँ यरुशलेम शहरमे जाके वहाँ मोरिक आघे यी बातके बारेमे इन्साफ करजाए कना चहथो?”<verse eid="ACT 25:9" /></para>
  <para style="s">पावल महाराजक न्याय-आसनके आघे</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10" />पर पावल कहल, “मै महाराजक न्याय-आसनके आघे ठरह्याइल बतुँ, और यी वहे ठाउँ हो, जहाँ मोरिक न्याय हुई परना हो। यहूदी दलके नेतनके मै कुछु खराबी नै करल हुइतुँ कहिके ते अप्नि मजासे जन्थी।<verse eid="ACT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 25:11" />यदि मै अपराधी हुइतुँ, और मै ज्यान सजाय मिल्ना लायकके काम करल हुइबुँ कलेसे मुअक लग मै अस्वीकार नै करम। पर यदि मोरिक उप्पर यनके लगैलक आरोपमे कुछु सबुत नै हो कलेसे महिन्हे केक्रो अधिकार नै हो कि केऊ महिन्हे यनके हाँथेम सौँपे। मै महाराजक थेन ऊ अप्निहीँ न्याय करिँत् कहिके अपील करम।” <verse eid="ACT 25:11" /><verse number="12" style="v" sid="ACT 25:12" />तब् हाकिम फेस्तस सल्लाहकारनसे सल्लाहा लेके कहल, “तुँ महाराजाहे अपील कर्लो, तुँ महाराजक थेन जैबो।”<verse eid="ACT 25:12" /></para>
  <para style="s">राजा अग्रिपासहे हाकिम फेस्तसके सल्लाहा</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />थोरिक दिन पाछे हाकिम फेस्तसहे नमस्कार करे राजा अग्रिपास और ओकर छोट्की बहिन्या बरनिकी कैसरिया शहरमे आपुग्लाँ। <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />ओइने वहाँ बहुत्ते दिन बैठके सेक्लाँ। तब् हाकिम फेस्तस पावलके मुद्दा राजक आघे असिक कती पेश करल, “हाकिम फेलिक्सके झेलमे दारके गैलक एकथो बन्दी यहाँ बा। <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />मै यरुशलेम शहरमे रहलमे जेकर बारेमे, मुख्य पुजारीनके और यहूदी दलके नेतन ओकर विरोधमे आरोप लगाके उहिहे दण्ड देहे परी कहिके अनुरोध करल रहिँत। <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />आरोपी और आरोप लगुइया मनैनके संग आमने-सामने नै होके और अपन विरोधमे लगागिलक आरोपके बारेमे बोल्ना मौका बिना भेटैले कौनो मनैयाहे बिना पत्तक दण्ड देना रोमीनके नियम नै हो कहिके मै ओइन्हे जवाफ देनु।<verse eid="ACT 25:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 25:17" />तबेकमारे जब यहूदी दलके नेतन मोरिक संग कैसरिया शहरमे अइलाँ। मै बिना बेर कर्ले काल्ही न्याय-आसनमे बैठके पावलहे हाजिर करैना हुकुम देनु। <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />जब आरोप लगुइयन ठरह्यैलाँ, तब बहस चलल। पर मोरिक सोँचल हस ओकर मुद्दामे कौनो नै मजा घट्नक बारेमे ओइने कौनो दोष लगाई नै सेक्लाँ। <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />पर ओइन्के मतभेद भर ओइनेहेन्के धर्मक बारेमे और मुसेकल येशूक बारेमे रहिन, जिहिहे पावल भर अभिन जित्ती बा कहिके दाबी करतेहे। <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />तबेकमारे यी बातके जाँच पत्ता लगैना बारेमे मै अलमलमे पर्लक ओहोँरसे मुद्दक बारेम छलफल करे यरुशलेम शहरमे जैना पावलके मन बतिस कि नै कहिके मै उहिहे पुँछ्नु, ‘का तुँ यरुशलेम शहरमे जाके वहाँ यी बातके बारेमे न्याय होए कना चहथो?’<verse eid="ACT 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 25:21" />पर पावल महाराजक न्याय नै हुइतसम हिरासतेमे धरहो कहिके अपील कर्लक ओहोँरसे उहिहे महाराजक थेन नै पठाइतसम अख्वारीमे धरना हुकुम देनु।” <verse eid="ACT 25:21" /><verse number="22" style="v" sid="ACT 25:22" />तब् राजा अग्रिपास हाकिम फेस्तसहे कहल, “उ मनैयक बात मै अप्निहीँ सुने भेटैतुँ ते हुइना रहे।” तब् ऊ कहल, “काल अप्नि सुनलेबी।”<verse eid="ACT 25:22" /></para>
  <para style="s">पावल राजा अग्रिपासके आघे</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />दोसुर दिन राजा अग्रिपास और ओकर छुट्की बहिन्या बरनिकी महा धुमधामसे सेनापति और शहरके प्रमुख मनैनके संगे सभाभवनमे पैठ्लाँ। तब् हाकिम फेस्तसके हुकुम पाके पावल हाजिर करागिलस। <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />फेस्तस हाकिम कहल, “राजा अग्रिपास और हमार संग यहाँ हाजिर हुइलक सक्कु जाने, अप्निनके यी मनैयाहे देखती। जेकर बारेमे सारा यहूदिनके ‘यी मनैया आबसे जिना लायकके नै हो’ कहिके यरुशलेम शहरमे और यहाँ फेन महिन्से बिन्ती करल रहिँत।<verse eid="ACT 25:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 25:25" />पर ज्यान सजाय पाईपरना यिहिहे कुछु करल मै नै भेटैलक ओहोँरसे और यी अप्निहीँ फेन महाराजक थेन रोम शहरमे अपील कर्लक ओहोँरसे मै यिहिहे पठैना निर्णय कर्नु। <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />यकर बारेमे मै मोरिक महाराजाहे लिख्ना विशेष बात कुछु नै हो। तबेकमारे मै यिहिहे अप्निनके आघे और खास करके, हे राजा अग्रिपास, अप्निक आघे नानल बतुँ। और हम्रे यकर दोषके जाँच करके सेकके सायद मै कुछु लिख्ना बात भेटैम। <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />काकरेकी कैदीक विरोधमे कौनो दोष बिना बतैले उहिहे पठैलेसे ओकर ते कुछु मतलब नै रही।”<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s">पावल राजा अग्रिपासके आघे बात फरछ्वार करल</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />राजा अग्रिपास पावलहे कहल, “तुहिन्हे अपन पक्षमे बोल्ना अनुमति बा।” तब् पावल मनैनहे हाँथेलेके शान्त रहो कहिके इशारा करल। और अपन बचाउके लग बोले लागल:<verse eid="ACT 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 26:2" />“हे राजा अग्रिपास, यहूदी दलके नेतनके महिन्हे लगैलक सक्कु दोषके बारेमे आज अप्निक आघे अपन बचाउमे बोले भेटैलकमे मै अपनहे भाग्यमानी मानतुँ। <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />यहूदी दलके नेतनके सक्कु प्रथा और वाद-विवादके बातमे अप्नि विशेष रुपसे दक्ष हुइलक ओहोँरसे, मै अपनहे भाग्यमानी मानतुँ। और मोरिक बयान संस्सा करके सुनदेबी कहिके मै बिन्ती फेन करतुँ।<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />मोरिक जातिक मनैनके बिच्चेम और यरुशलेम शहरमे छुटिएसे बितैलक मोरिक जवान अवस्थासम मोरिक जीवन शैली यहूदी मनैनहे पता बतिन। <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />नम्मा समयसे ओइन्हे पता हुइलक बात हो, कि हमार धर्मक सक्कुहुनसे कट्टर पन्थी दल अन्तर्गत मै एकथो फरिसी होके छुटिएसे जीवनयापन करल बतुँ। ओइने चहिहीँ कलेसे यी बातके गवाही देहे सेक्हीँ।<verse eid="ACT 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 26:6" />परमेश्वर हमार पुर्खनहे करल प्रतिज्ञामे मै आशा कर्लक कारणसे आज मै यहाँ दोषीक रुपमे ठरह्याइल बतुँ। <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />हमार बाह्रै कुलके मनै यी वाचा पूरा हुइना आशा लेके रातदिन एक मनसे आराधना करथाँ। हे राजा, यी यहूदी दलके नेतनहे परमेश्वरके कर्लक वाचा पूरा हुइना आशक कारण यने महिन्हे दोष लगाइल बताँ। <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />परमेश्वर मुअल मनैनहे जित्ती बनैथाँ कहिके अप्निनके विश्वास कर्थी, तभुन फेन अप्निनके काकरे केऊ फेन परमेश्वर येशूहे मुअलमेसे जिवैलाँ कहिके विश्वास नै कर्थी?<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />नासरत गाउँक येशूक नाउँक विरोधमे बहुत्ते कारबाही करे परी कना मै अपनहे फेन विश्वास रहे। <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />मै यरुशलेम शहरमे ओस्तेहेँ कर्नु और मुख्य पुजारीनसे अधिकार पाके बहुत्ते सन्तहुँक्रिहिन् मै झेलमे किल नै दर्नु, पर ओइन्हे मुवाइबेर ओइनेहेँन्के विरोधमे मै सहमत हुइनु। <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />और सक्कु बैठक भवनमे ओइन्हे घनिघनी सजाय देके ओइन्हे ख्रीष्टमे करना विश्वास छोरवैना और ओइन्हे येशूक निन्दा करवैना कोशिस कर्नु। ओइन्के विरोधमे रिसकमारे बाहेरके शहरमे फेन मै ओइन्हे सतैनु।<verse eid="ACT 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />असिके मुख्य पुजारीनसे अधिकार और आज्ञा चिट्ठी भेटाके मै दमस्कस शहर ओहोँर जाइतुहुँ, <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />ते, हे राजा, दुपहरके समयमे मै स्वर्गमेसे सुर्यसे फेन ओजरार देख्नु, जोन मै और मोरिक संग नेगुइयनके चारु ओहोँर चम्कतेहे। <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />जब हम्रे सक्कु जाने भुइयाँमे गिरल रही, तब् हिब्रू भाषामे महिन्हे असिक कहत मै सुन्नु, ‘शाऊल, शाऊल, तुँ काकरे महिन्हे सतैथो? मोरिक विरोधमे लरना मूर्खता हो।’<verse eid="ACT 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 26:15" />तब् मै कनु, ‘हे प्रभु, अप्नि के हुइती?’ प्रभु महिन्हे कलाँ, ‘मै येशू हुइतुँ, जिहिहे तुँ सताइतो। <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />पर उठो और अपन गोरामे ठरह्याऊ। काकरेकी मोरिकमे तोहाँर देखल और मै तुहिन्हे देखैना बातके लग सेबक और साँखी नियुक्त करना उद्देश्यसे मै तोहाँरिक थेन देखा परल बतुँ। <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />मै तुहिन्हे तोहाँर अपने जाति और गैर-यहूदिनसे छुटकारा देहम, जेनके थेन मै तुहिन्हे पठैम, <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />ताकि तुँ ओइन्के आँखी खोलदेऊ। तबेकमारे ओइने अन्धकारसे ओजरार ओहोँर और शैतानके शक्तिसे परमेश्वरके ओहोँर घुमिँत। असिके परमेश्वर ओइन्के पापहे माफ करहिन, और उत्तराधिकार रहल ठाउँ उ मनैनहे फेन मिलहिन जेने पवित्र बताँ, और जेने मोरिकमे विश्वास कर्ले बताँ।’<verse eid="ACT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />तबेकमारे, हे राजा अग्रिपास, स्वर्गीय दर्शनके मै आज्ञाकारी हुइनु। <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />पर आघे दमस्कस शहरमे, तब् यरुशलेम शहरमे और सारा यहूदिया देशभर रहुइयनहे और गैर-यहूदिनहे फेन मन बदलके पाप करना छोरके परमेश्वरके ओहोँर घुमो और दण्डसे बँचक लग असिन काम करो। और तुहुरे जात्तिके अपन मन बदलके पाप करना छोरदेऊ कहिके मै प्रचार कर्नु। <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />तबेकमारे यहूदी दलके नेतन महिन्हे मन्दिरमे पकरके मुवैना कोशिस करलाँ।<verse eid="ACT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 26:22" />पर आझिक दिनसम परमेश्वरसे मै सहायता भेटाइल बतुँ। तबे छुटी भारी सक्कुहुनहे गवाही देती मै यहाँ ठरह्याइल बतुँ। परमेश्वरके अगमवक्तनके और मोशक बोलल वचन जरुर पूरा हुई कना बात बाहेक मै औरे कुछु नै कहल हुइतुँ। <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />ओइने कले रहिँत कि ख्रीष्टहे दुःख भोग्ही परहिन। और मुअलमेसे सक्कुहुनसे आघे जित्ती होके यहूदी जाति और गैर-यहूदिनके लग मुक्तिक घोषणा वहे करहीँ, और ओइने जिइँत।”<verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />पावल यी अपन बचाऊक बात बोलेबेर हाकिम फेस्तस जोरसे चिल्लाके कहल, “ए पावल, तैँ बौरागिले, तोरिक धेउर विद्या तुहिहे बौराहा बनादेहल बा।” <verse eid="ACT 26:24" /><verse number="25" style="v" sid="ACT 26:25" />पर पावल कहल, “आदरणीय हाकिम फेस्तस, मै बौराहा नै हुइतुँ, पर सच्चा और बुद्धिक बात बत्वाइतुँ। <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />काकरेकी रज्वा अप्निहीँ फेन यी सक्कु बात जन्थाँ, जेकर आघे मै बिना डरैले बोलतुँ। काकरेकी यी कौनो फेन बात हुँकिन्से छुपल नै हो, काकरेकी यी घट्ना गुपचुपमे नै घटल।<verse eid="ACT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 26:27" />राजा अग्रिपास, का अप्नि परमेश्वरके अगमवक्तनकेमे विश्वास कर्थी? हाँ, मै जन्थुँ, अप्नि विश्वास कर्थी।” <verse eid="ACT 26:27" /><verse number="28" style="v" sid="ACT 26:28" />राजा अग्रिपास पावलहे कहल, “का एक्के घचिमे तुँ महिन्हे ख्रीष्टियन बनाई खोजतो?” <verse eid="ACT 26:28" /><verse number="29" style="v" sid="ACT 26:29" />पावल जवाफ देहल, “एक्के घचिमे होए चाहे बेरमे मै परमेश्वरसे प्राथना करतुँ कि अप्नि किल नै होके पर आज मोरिक बात सुनुइया सक्कु जाने मोरे हस ख्रीष्टियन होजाइँत, पर मोरिक हस कैदी होके भर नै।”<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />तब् राजा, हाकिम, रज्वक बहिन्या बरनिकी और वहाँ बैठुइया सक्कु जाने उठ्के चलगिलाँ। <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />तब् ओइने निक्रेबेर आपसमे असिक बट्वाई लग्लाँ, “यी मनैया मृत्युदण्ड पैना और झेलमे जैना मेरिक कुछु काम नै करल हो।” <verse eid="ACT 26:31" /><verse number="32" style="v" sid="ACT 26:32" />राजा अग्रिपास हाकिम फेस्तसहे कहल, “यदि यी मनैया महाराजक थेन न्यायक लग अपील नै करल रहत कलेसे ते यिहिहे छोरदेलेसे फेन हुइना रहे।”<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s">पावलके रोम यात्रा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />जब हाकिम फेस्तसके माध्यमसे यी पक्का हुइलस कि जहाजमे चहुँरके हम्रिहिन्हे इटालिया प्रदेशके रोम शहरमे जाईपरी, तब ओइने पावल और औरे बहुत्ते कैदिनहे महाराजा अगस्टसके फौजके युलियस नाउँक कप्तानके जिम्मा लगादेलाँ। <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />एड्रामिटेनोस शहरमेसे एशिया प्रदेशके बहुत्ते बन्दरगाहन हुइती जैना एकथो पानी जहाजमे चहुँरके हम्रे यात्रा सुरु कर्ली। अरिस्तार्खस नाउँ रहल माकेडोनिया प्रदेशके थेसलोनिके शहरके एकथो मनैया हमार संग रहे।<verse eid="ACT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 27:3" />दोसुर दिन हम्रे सीडोन नगरमे पुग्ली। युलियस पावलहे दया देखाके ओकर संघरियनके थेन जाके जरुरी सहायता लेना अनुमति देहल। <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />वहाँसे हम्रे दोबारा पानी जहाजके यात्रा सुरु कर्ली, बयाल उल्टा चल्लक ओहोँरसे हम्रे साइप्रस टापुक आड़ लेके गैली। <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />किलिकिया और पामफिलिया प्रदेशके समुन्दरके आँरितिर पुग्के, हम्रे लुकिया प्रदेशके माइरा शहरमे पुग्गिली। <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />वहाँ इटालिया प्रदेशमे जैना अलेक्जेन्ड्रिया शहरके एकथो पानी जहाज भेटाके कप्तान हम्रिहिन्हे ओम्नेहेँ चहुँरादेहल।<verse eid="ACT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 27:7" />बहुत्ते दिनसम धिरे-धिरे जाके बरबत्ति क्नीडस नगरमे पुग्ली, और बयाल आकुर आघे बह्रे नै देलक ओहोँरसे क्रेट टापुक आड़ लेके हम्रे सोलोमन टापुक आँरितिर-तिर गैली। <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />हम्रे महा मुश्किलसे टापुक आँरितिर-तिर लागके हम्रे सुग्घुर बन्दरगाह कना ठाउँमे पुग्ली। वहाँसे लासिया नगर लग्गेहेँ रहे।<verse eid="ACT 27:8" /></para>
  <para style="s">पावलके सल्लाहा नै मन्लक</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />बहुत्ते समय बितसेकल रहे, और समुन्दरके यात्रा फेन खतरनाक होसेकल रहे। ओक्रेहे संग प्रायश्चित-दिवसके<note caller="+" style="f"><char style="fr" closed="false">27:9 </char><char style="fq" closed="false">प्रायश्चित-दिवस </char><char style="ft" closed="false">प्रायश्चित-दिवसहे योम किपूरके तिहुवार फेन कथाँ। यी यहूदी मनैनके सबसे भारी पवित्र दिन हो। काकरेकी ओइने यी दिन उपवास बैठिँत। और प्रधान पुजारी यनके पाप प्रायश्चित करक लग बलिदान चह्राए। यी तिहुवार अंग्रेजी महिना सेप्टेम्बर महिनक अन्तिममे और अक्टुबर महिनक सुरुमे परे। सेप्टेम्बर महिनक आधासे समुन्दरके यात्रा बहुत खतरनाक होए। नोभेम्बर महिना और फेब्रुअरी महिनक बिचमे यात्रा करना असम्भव रहे। </char></note> उपवासके समय फेन बित सेक्लक ओहोँरसे, पावल सक्कु जहनहे असिक कहिके सम्झाइल। <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />“हेरो संघरियन, यी समुन्दरके यात्रासे हमार पानी जहाज और मालसामानके किल नै होके, पर हमार जीउ-ज्यान समेत खतरा और नोक्सानी हुइना हस मै देखतुँ। और मै सक्कुहुनहे यहे सल्लाहा देहतुँ कि हम्रे खतरक समय नै ओराइतसम हम्रिहिन्हे यहैँ रुके परी।” <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />पर कप्तान पावलके बातसे पानी जहाजके चालक और पानी जहाजके मलिक्वक कहल मानल।<verse eid="ACT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 27:12" />सुग्घुर बन्दरगाहामे जार छेँक कटाईक लग असुबिधा हुइलक ओहोँरसे कौनो फेन हालतसे फोनिक्स बन्दरगाहामे पुग्के जार कटाई परी कहिके बहुत्ते जाने वहाँसे पानी जहाज चलाके आघे लैजिना सल्लाहा देलाँ। क्रेट टापुक आँरितिर फोनिक्स कना एकथो बन्दरगाहा बा, जेकर दवार दक्खिन-पश्छिउँ और उतर-पश्छिउँ ओहोँर बा। तबेकमारे जार कटाइक लग यी ठाउँ मजा रहे।<verse eid="ACT 27:12" /></para>
  <para style="s">समुन्दरमे आँधी</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />जब दखिनका बयाल धीरेसे चले लागल, तब ओइने फोनेक्स टापु पुग्ना उद्देश्य पूरा होगिल कना सोँचके, लङ्गर निकारके ओइने क्रेट टापुक आँरितिर-तिर हुइती यात्रा करे लग्लाँ।<verse eid="ACT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 27:14" />पर थोरिक्के बेरमे उ टापुमेसे “उत्तर-पूर्वी” कना बरवार आँधीबौखा आगिलस। <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />जब पानी जहाज आँधीक चपेटामे परगिल, तब उ तूफानके सामना करे नै सेकल, और हम्रे पानी जहाजहे बयाल जेहोँर लैजाइ ते लैजाइ कहिके छोरदेली। <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />क्लौडा कना एकथो छुटिमुती टापुक आड़मे पुग्के हम्रे बल्तल पानी जहाजमे रहल लाउहे बँचाई सेक्ली।<verse eid="ACT 27:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 27:17" />पानी जहाजके पाछे बाँधल मनैनहे बँचैना लाउहे उप्पर उठाके सेकके नाविनके कौनो उपायसे पानी जहाजहे तरेसे लेके उप्परसम लस्रीलेके बहानके नन्लाँ। और सिरटिस खाडी कना बल्ह्वा दलदलमे फँस्ना डरसे ओइने लङ्गरहे आधा गिरादेलाँ। और पानी जहाजहे हावक संग-संगे जाए कहिके कृपाल गिरादेलाँ। <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />आब आँधी हम्रिहिन्हे दटके उल्द्र्वाई और हिलाई लागल। और दोसुर दिन ओइने पानी जहाजके मालसामान झबाझब फेँके लग्लाँ।<verse eid="ACT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 27:19" />तबजाके तेसर दिन ओइने अपने हाँथेलेके पानी जहाजके माल-सामान फेँकादेलाँ। <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />बहुत्ते दिनसम घाम, तोरैयाँ कुछु फेन देखा नै परल। तूफान लगातार चल्ती रलक ओहोँरसे आखिरमे हम्रे जिना आशा फेन छोरदेली।<verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />कैयो दिनसम ओइने बिना खैले बैठल रहिँत। तब् पावल आके ओइन्हे कहल, “हेरो संघरियन, अप्निनके मोरिक सल्लाहा मन्ती कलेसे क्रेट टापुमेसे पानी जहाजहे चलाके आघे बह्राई नै परना रहे। और असिन आफत और नोक्सानी फेन नै खेपे परना रहे।<verse eid="ACT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 27:22" />पर आब मै कहतुँ, हरेस नै खाई। अप्निहुँक्रिहिनमेसे केक्रो फेन ज्यान नै जाई, पर पानी जहाज भर नाश होजाई। <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />काकरेकी मै जोन परमेश्वरके हुइतुँ और जेकर आराधना मै करथुँ, हुँकार एकथो दूत गैलक रात मोरिक थेन आके ठरह्यैलाँ। <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />ऊ महिन्हे कलाँ, ‘पावल, ना डराऊ, तुहिन्हे महाराजक आघे ते जरुर ठरह्याई परी, और तोहाँर संग पानी जहाजमे रहुइया सक्कु मनैनहे परमेश्वर अपन अनुग्रहसे बँचैहीँ।’ <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />तबेकमारे संघरियो, हिम्मत करो। मै परमेश्वरमे विश्वास करथुँ, महिन्हे जसिके बतागिल बा, ठिक ओस्तेहेँ हुई। <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />पर हम्रिहिन्हे भर कौनो एकथो टापूमे ठकराई परना बा।”<verse eid="ACT 27:26" /></para>
  <para style="s">जहाजके तुट्ना</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />पर जब चौधौँ रात हुइल रहे, और एड्रियास समुन्दरमे हम्रे आँधीलेके धकेल्वा पाइतिही। तब् आधा रात ओहोँर पानी जहाज चलुइया मनै हम्रे कौनो जमिनके लग्गे पुगती कना अनुमान लगैलाँ। <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />और ओइने पानीक गहिराई नापके हेरलाँ ते सरतिस मिटर पता लगैलाँ। और थोरचे दूर जाके फेन पानीक गहिराई नप्लाँ ते ओइने सत्ताइस मिटर पता लगैलाँ। <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />तब् कौनो चट्टानमे ठक्कर खैना डरसे, ओइने जहाजके पाछेसे चारथो लङ्गर गिरैलाँ, और बेहान होजाए कहिके प्राथना करे लग्लाँ।<verse eid="ACT 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 27:30" />जब जहाज चलुइयन पानी जहाजमेसे भागे खोजतिहिँत। और आघे ओहोँर लङ्गर गिरैना बहानासे पानी जहाजके पाछे बाँधल मनैन बँचैना लाउहे समुन्दरमे गिरादारल रहिँत। <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />तब् पावल कप्तान और सिपाहिनहे कहल, “यी मनै पानी जहाजमे नै बैठिहीँ कलेसे अप्निनके बँचे नै सेक्बी।” <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />तब् सिपाहिन लाउक बरहा काटदेलाँ, और पानी जहाजके पाछे बाँधल मनैन बँचैना लाउहे जाई देलाँ।<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />जब भुवर ओजरार हुइतेहे, तब पावल ओइन्हे सक्कु जहनहे खाना खाऊ कहिके बिन्ती कर्ती कहल, “आज चौद दिन होसेकल, अप्निनके चिन्ता करत-करत बिना कुछु खैले भुँख्ले बैठल बती। <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />तबेकमारे कुछु-कुछु खाली कहिके मै अप्निन्हे आग्रह करतुँ। कुछु खैबी कलेसे अप्निनके बँचल रबी, अप्निनके केक्रो कपारिक एकथो भुट्ला फेन नाश नै हुई।” <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />यी बात कहिके ऊ रोटी लेहल, और सक्कुहुनके आघे परमेश्वरहे धन्यवाद देके उहिहे खन्टाके खाई लागल।<verse eid="ACT 27:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 27:36" />तब् ओइने सक्कु जाने हौसला पाके कुछु खैना चिज खैलाँ। <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />पानी जहाजमे रहुइया हम्रे जम्मा दुई सौ छ्यहत्तर जाने रही। <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />ओइने खाके अघाके सेक्लाँ ते पानी जहाजहे हलुक बनाइक लग ओइने समुन्दरमे गोहूँ फेँकादेलाँ।<verse eid="ACT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />ओजरार होगिल तभुन फेन ओइने उ ठाउँहे चिह्ने नै सेक्लाँ। पर ओइने एकथो धिक्वा देख्लाँ, ओकर आँरितिर बल्ह्वा रहिस। सेकतसम ओइने पानी जहाजहे वहैँ पन्ज्रे लगैना योजना बनैलाँ। <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />ओइने लङ्गरहे खोलके समुन्दरमे गिरादेलाँ। तब्बेहेँ पानी जहाजहे सोझर्ना साधन दब्लाहे बहन्लक बरहाहे ओइने खोलदेलाँ। आघेक पल्ली ओइने उठाके बयाल बहना ओहोँर घुमादेलाँ, और पानी जहाजहे आँरितिर बह्रैलाँ। <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />पर पानीक तरे नुकल बालुक पख्वामे पानी जहाज लरके वहैँ गसकगिल। पानी जहाजके आघेक भाग अँटकगिलिस्, और चले नै सेकल, और पाछेक भाग भर पानीक हल्कोरासे टूटे लग्लिस।<verse eid="ACT 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42" />कैदीन पहुँरके भागजिहीँ कना सोँचके सिपाहिनके ओइन्हे मुवैना विचार करलाँ। <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />पर कप्तान पावलहे बँचैना मन बनाके ओइन्हे ओसिक करे नै देहल। पहुँरे सेकुइया भर पानी जहाजमेसे आघे कुदुकके धिक्वामे उतरहो कना हुकुम ऊ देहल। <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />और बाँकी रहुइयन भर पतरामे और पानी जहाजके खण्डामे उपार जैहो कहिके कहल। असिके सक्कु जाने मजासे बँचके आँरितिर पुग्गिलाँ।<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s">पावल माल्टा टापुमे</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />जब हम्रे मजैसे बँचके आँरितिर पुग्ली ते उ टापुक नाउँ माल्टा हो कहिके पता पैली। <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />वहाँ रहुइया मनै हम्रिहिन्हे बिस्राई नै सेक्ना माया देखैलाँ। काकरेकी पानी परके जार हुइलक ओहोँरसे ओइने आगी बारदेलाँ, और हम्रिहिन सक्कु जहनहे स्वागत करलाँ।<verse eid="ACT 28:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 28:3" />पावल एक बोझा काठी कुरह्याइल रहे, और वहे नानके आगीमे दारदेहल। आगिक आँचसे एकथो बिखार सँप्वा निकरगिल, और ओकर हाँथेम लपेट्गिलिस। <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />वहाँ रहुइया मनै ओकर हाँथेम सँप्वा लपेटल देख्के एक दोसुर जहनहे कहे लग्लाँ, “यी मनैया पक्का फेन ज्यानमारा हुई। समुन्दरमेसे बँचके ते निकरगिल, पर हमार देवीक न्याय<note caller="+" style="f"><char style="fr" closed="false">28:4 </char><char style="fq" closed="false">न्याय </char><char style="ft" closed="false">न्याय एकथो ग्रीक देवीक नाउँ रहे। </char></note>से यी बँचे नै सेकल।”<verse eid="ACT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 28:5" />पर पावल उ सँप्वाहे आगीमे झित्कार देहल, और ओकर कुछु बिगार नै हुइलिस्। <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />ओकर शरीर सुन होजिहिस, या ऊ एकफाले गिरके मुजाई कहिके उ मनै असरा हेरे लग्लाँ। पर बहुत बेरसम अस्यैलाँ तभुन ओकर कुछु बिगार नै हुइल देख्के ओइने अपन सोँच बदलके कहे लग्लाँ, “यी ते देउँता पो हुइँत।”<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />उ टापुक पब्लियस नाउँ रहल भल्मन्सक जग्गाजमिन वहे ठाउँक आँजर-पाँजर रहे। ऊ हम्रिहिन्हे स्वागत करलाँ, और तीन दिनसम हुँकार घरेम हम्रे पहुना बनके बैठ्ली। <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />पब्लियसके बाबा जुरी और आउँ रोग लागके बेमार रहिस। पावल उहिहे हेरे कोन्तीमे गैल, और ओकर लग प्राथना करल। और अपन हाँथ ओकर उप्पर धारके उहिहे चोख्वादेहल। <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />यी घटना होके सेकल तब, उ टापुक आकुर रोगाइल मनै पावलके थेन अइलाँ, और चोखागिलाँ। <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />ओइने हम्रिहिन्हे बहुत आदर करलाँ। जब हम्रे तीन महिना पाछे पानी जहाजमे चहुँरके जाइक लग तयार हुइली, तब हमार लग जरुरी परना चिज ओइने पानी जहाजमे धारदेलाँ।<verse eid="ACT 28:10" /></para>
  <para style="s">पावल रोम शहरमे</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />तीन महिना पाछे, हम्रे अलेक्जेन्ड्रिया शहरमे जैना पानी जहाजमे चहुँरली। यी पानी जहाज जार हुइलक कारण यी टापुमे रुकल रहे। यी पानी जहाजके आघेक हिस्सामे जुइकाहा देउँतनके फोँटु खोपके बनाइल रहिन। <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />सुराकुसाई शहरमे पुग्के हम्रे वहाँ तीन दिनसम पलिरली।<verse eid="ACT 28:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 28:13" />वहाँसे आघे जाके हम्रे रेगियन नगरमे पुग्ली। और एक दिन पाछे दक्खिनका बयाल चल्लस, और दोसुर दिन हम्रे पटिओली शहरमे पुगगिली। <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />वहाँ हम्रे कौनो विश्वासी भैयनहे भेटैली, और ओइने हम्रिहिन्हे सात दिनसम अपन संग रहक लग अनुरोध करलाँ, और हम्रे ओइन्के संग वहाँ रली। असिके हम्रे ओइन्के संग रहिके सेकके हम्रे रोम शहरके डगर ओहोँर चलदेली। <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />रोममेसे विश्वासी भैयन हम्रे ओइन्के थेन आइती कना खबर सुन्लाँ ते ओइने हम्रिहिन्हे भेँटा करक लग और हम्रिहिन्हे रोम शहरमे लैजाइक लग अप्पियस नगरके बजार हुइती तीन-पाटी कना नगरसम अइलाँ। यनहे देख्के पावल परमेश्वरहे धन्यवाद चह्राइल, और बहुत हौसगिलस। <verse eid="ACT 28:15" /><verse number="16" style="v" sid="ACT 28:16" />जब हम्रे रोम शहरमे पुग्ली ते पावलहे एकथो सिपाहिक रेखदेखमे एक्केली बैठ्ना अनुमति मिल्लिस।<verse eid="ACT 28:16" /></para>
  <para style="s">रोम शहरमे पावलके प्रचार</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />तीन दिन पाछे पावल यहूदिनके स्थानीय अगुवनहे बलाई पठाइल। और जब ओइने जमा हुइलाँ ते ऊ ओइन्हे कहल, “हेरो भैयो, मै ते अपन देशके मनैनके अथवा बाबा-पुर्खनके रीतिरिवाजके विरोधमे कुछु काम नै करल रहुँ। तभुन फेन बन्दी बनाके यरुशलेम शहरमेसे रोमी सरकारके हाँथेम महिन्हे सौँपगिलस। <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />ओइने छानबीन करके सेकके मोरिकमे मृत्यु दण्डक कौनो कारण नै भेटैलाँ ते ओइने महिन्हे छोरदेहक लग रहिँत।<verse eid="ACT 28:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 28:19" />पर जब यहूदी दलके नेतन यी बातके विरोधमे बोले लग्लाँ ते महिन्हे महाराजासे माँग करे पर्लस कि यहाँ रोम शहरमे मोरिक न्याय होए। पर यम्ने मोरिक अपन मनैनके विरोधमे कुछु दोष लगैना बात नै रहे। <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />तबेकमारे मै अप्निन्हे बलैले बतुँ ताकि मै अप्निनसे भेँटा करे सेकुँ, और बातचित करे सेकुँ। काकरेकी इजरायल देशके मनैनके आशा ख्रीष्ट हुइताँ, हुँकारे लग मै सिँक्रीमे बँधल बतुँ।”<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />तब ओइने पावलहे कलाँ, “ना हम्रे अप्निक बारेमे यहूदिया प्रदेशके मनैनसे कौनो चिट्ठी भेटैली। और ना ते अप्निक बारेमे विश्वासी भैयनमेसे केऊ हम्रिहिन्हे बताइल। और ना ते हमार थेन केऊ अप्निक बारेमे खराब बात बत्वाइल। <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />पर अप्निक विचार का बा? वहे हम्रे अप्निसे सुन्ना चहथी। काकरेकी हम्रे जन्थी कि प्रत्येक ठाउँमे प्रभुक डगरके बारेमे मनै विरोध करथाँ।”<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />तब उ यहूदिनके ओकर लग एकथो दिन टोकदेलाँ, और बहुत्ते मनै ओकर डेरामे जमा हुइलाँ। और पावल ओइन्हे परमेश्वरके राजके बारेमे गवाही देती, ओइन्हे मोशक नियम कानुन और परमेश्वरके अगमवक्तनके किताबमेसे येशूक बारेमे ओइन्हे बेहानसे लेके संझासम बताइल। <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />तब कौनो-कौनो मनै पावलके कलक बातमे विश्वास करलाँ, और कौनो मनै भर विश्वास नै करलाँ।<verse eid="ACT 28:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 28:25" />ओइन्के बात आपसमे नै मिल्लिन, और विदा हुइबेर पावल ओइन्हे यी बात कहल, “तुहुरिन्के पुर्खनहे परमेश्वरके अगमवक्ता यशैयक माध्यमसे पवित्र आत्मक कहल वचन ठिके रहे। <verse eid="ACT 28:25" /><verse number="26" style="v" sid="ACT 28:26" />यी मनैनके थेन जाके को,</para>
  <para style="q" vid="ACT 28:26">‘सुन्ना ते तुहुरे सुन्थो, पर तुहुरे नै बुझ्थो।</para>
  <para style="q" vid="ACT 28:26">हेरना ते तुहुरे हेर्थो, पर तुहुरे नै देख्थो।<verse eid="ACT 28:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ACT 28:27" />काकरेकी यी मनैनके मन भद्दा होगिल बतिन।</para>
  <para style="q" vid="ACT 28:27">और ओइन्के कान बहिर होगिल बतिन।</para>
  <para style="q" vid="ACT 28:27">और ओइने अपन आँखी तुमल बताँ।</para>
  <para style="q" vid="ACT 28:27">नै ते ओइने आँखीलेके देख्ताँ, कानलेके सुन्ताँ,</para>
  <para style="q" vid="ACT 28:27">मनसे बुझ्ताँ और परमेश्वरके ओहोँर घुम्ना रहिँत।</para>
  <para style="q" vid="ACT 28:27">और मै ओइन्हे चोख्वैतुँ।’<verse eid="ACT 28:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28" />तबेकमारे तुहुरे जानलेऊ कि परमेश्वरके यी मुक्ति आब गैर-यहूदिनके लग फेन पठागिल बा, और ओइने यिहिहे स्वीकार फेन करहीँ।”<verse eid="ACT 28:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 28:29" />जब पावल यी बात कहिके सेकल ते उ यहूदिनके आपसमे खोब विवाद करे लग्लाँ, और ओइने वहाँसे चलगिलाँ।<verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />पावल पूरा दुई सालसम अपने भारा तिरके रोम शहरमे बैठल, और ओकर थेन अउइया सक्कुहुनहे ऊ वहाँ स्वागत करल। <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />पावल खुल्लमखुल्ला और बिना डरैले परमेश्वरके राजके प्रचार करे, और प्रभु येशू ख्रीष्टके बारेमे शिक्षा देहे।<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>