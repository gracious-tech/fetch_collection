<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- DEUKHARIYA Tharu New Testament</book>
  <para style="ide">UTF-8</para>
  <para style="rem">Copyright Information: Creative Commons Attribution-ShareAlike 4.0 License</para>
  <para style="h">फिलिप्पी</para>
  <para style="toc1">फिलिप्पी शहरके मण्डलीहे पावलके चिट्ठी</para>
  <para style="toc2">फिलिप्पी</para>
  <para style="toc3">फिलि.</para>
  <para style="mt1">फिलिप्पी शहरके मण्डलीहे पावलके चिट्ठी</para>
  <para style="mt2">फिलिप्पी</para>
  <para style="is">लिखुइया</para>
  <para style="ip">पावल अप्निहीँ दाबी करत कि यी चिट्ठी मै लिख्नु <char style="xt"><ref loc="PHP 1:1">१:१</ref> </char> और भाषा, शैली, इतिहास तथ्य यकर पुष्टि करथाँ। सुरुवातके मण्डली फेन विषमता रहिँत पावल लेखक हो कहिके और ओकर अधिकारके चर्चा करत। फिलिपके मण्डलीहे लिखगिलक यहे चिट्ठी ख्रीष्टके मन प्रकट करथाँ <char style="xt"><ref loc="PHP 2:1-11">२:१-११</ref> </char> यी चिट्ठी लिखेबेर पावल झेलमे रहे, पर ऊ खुशी रहे। यहे चिट्ठी हम्रिहिन्हे सिखाई कि समस्यामे और दु:खमे फेन ख्रीष्टके विश्वासीन आनन्दके अनुभव करथाँ। हमार आनन्दके कारण ख्रीष्टमे हमार आशा बा।</para>
  <para style="is">लिख्लक मिति और ठाउँ</para>
  <para style="ip">लगभग ई. स. ६१</para>
  <para style="ip">पावल फिलिपके मण्डलीहे यहे चिट्ठी रोमके झेलमेसे लिखल रहे (निउ. काम २८:३०)। यी चिट्ठीक हुलाकी इपफ्रुदितुस रहे। वहे फिलिपके मण्डलीक ओहोँरसे पावलके लग आर्थिक भेटि लेके रोम शहरमे आइल रहे (फिलि. २:२५, ४:१८)। वहाँ आके इपफ्रुदितुस गजब बेमार होगिल रहे, तबेकमारे ऊ झत्ते घरे नै आइसेकल रहे। तबेकमारे यी चिट्ठी बहुत ढिला आइल (<char style="xt"><ref loc="PHP 2:26">२:२६</ref>,<ref loc="PHP 2:27">२७</ref></char>)।</para>
  <para style="is">भेटुइया</para>
  <para style="ip">फिलिप्पीक मण्डली, फिलिप्पी माकेडोनियक एकथो प्रमुख शहर रहे।</para>
  <para style="is">उद्देश्य</para>
  <para style="ip">पावल मण्डलीहे अपन बन्दी <char style="xt"><ref loc="PHP 1:12-26">१:१२-२६</ref></char> और छुट्कारक योजनक <char style="xt"><ref loc="PHP 2:23-24">२:२३-२४</ref></char> बारेमे जानकारी कराई चाहे। उ मण्डलीमे झगरा और फुट हुईल देखपरत। तबेकमारे पावल नम्रसे एकताके बारेमे लिखत (<char style="xt"><ref loc="PHP 2:1-18">२:१-१८</ref>; <ref loc="PHP 4:2-3">४:२-३</ref></char>)। पावल, पास्तरीय धर्मशास्त्री, नै मजा शिक्षा और कुछ झूँटा गुरुनके नतिजक बारेमे सोझे बिरुद्धमे लिखत (<char style="xt"><ref loc="PHP 3:2">३:२</ref>,<ref loc="PHP 3:3">३</ref></char>)। पावल तिमोथीहे मण्डलीक रेखदेख और इपाफ्रोडाइटसके स्वास्थ्यक <char style="xt"><ref loc="PHP 2:19-30">२:१९-३०</ref> </char> जिम्मा देना अपन योजनक बारेमे चर्चा करत। पावल ओइन्के आर्थिक उपहार और ओकर लग ओइन्के चासोक लग कृतज्ञता फेन व्यक्त करत <char style="xt"><ref loc="PHP 4:10-20">४:१०-२०</ref> </char></para>
  <para style="iot">किताबके विभाजन</para>
  <para style="io1">१. नमस्कार <char style="ior"><ref loc="PHP 1:1-2">१:१-२</ref> </char></para>
  <para style="io1">२. पावलके परिस्थिति और मण्डलीक प्रोत्साहन <char style="ior"><ref loc="PHP 1:12-2:30">१:१२-२:३०</ref> </char></para>
  <para style="io1">३. झूँट चेलनके विरोधमे चेतावनी <char style="ior"><ref loc="PHP 3:1-4:1">३:१-४:१</ref> </char></para>
  <para style="io1">४. अन्तिम प्रबोधन <char style="ior"><ref loc="PHP 4:2-9">४:२-९</ref> </char></para>
  <para style="io1">५. आभारोक्ति <char style="ior"><ref loc="PHP 4:10-20">४:१०-२०</ref> </char></para>
  <para style="io1">६. अन्तिम नमस्कार <char style="ior"><ref loc="PHP 4:21-23">४:२१-२३</ref> </char></para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="s">अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />मै पावल, तिमोथीक संग, ख्रीष्ट येशूक दासके रुपमे यी चिट्ठी फिलिप्पी शहरके मण्डलीक अगुवनहे, मण्डलीक सेबकनहे और परमेश्वरके सक्कु पवित्र मनैनहे लिखतुँ, जेनके सम्बन्ध येशू ख्रीष्टसे बतिन। <verse eid="PHP 1:1" /><verse number="2" style="v" sid="PHP 1:2" />मै प्राथना करतुँ कि हमार बाबा परमेश्वर और प्रभु येशू ख्रीष्टके ओहोँरसे तुहुरिन्हे अनुग्रह और शान्ति मिल्ती रहे।<verse eid="PHP 1:2" /></para>
  <para style="s">धन्यवाद ज्ञापन और प्राथना</para>
  <para style="p">
    <verse number="3-5" style="v" sid="PHP 1:3-5" />सुरुक दिनसे तुहुरे येशू ख्रीष्टके बारेमे यी खुशीक खबरमे विश्वास करलो, यिहिहे फैलैनामे तुहुरे महिन्हे साथ देले बतो। तबेकमारे जब-जब मै तुहुरिन्के बारेमे सोच्थुँ, तब-तब मै परमेश्वरहे धन्यवाद देथुँ। और मै आनन्दसे प्राथना करथुँ कि परमेश्वर तुहुरिन्हे सहायता करिँत। <verse eid="PHP 1:3-5" /><verse number="6" style="v" sid="PHP 1:6" />महिन्हे यी बातके पक्का विश्वास बा, कि परमेश्वर जे तुहुरिन्केमेसे कौनो मजा काम सुरु करल बताँ, वहे उ कामहे उ दिन पूरा करहीँ, जोन दिन येशू ख्रीष्ट फिर्ता अइहीँ। <verse eid="PHP 1:6" /><verse number="7" style="v" sid="PHP 1:7" />यी ठिक बा कि मै तुहुरिन् सक्कुहुनके लग असिन सोँचुँ। काकरेकी मै तुहुरिन्हे बहुत माया करथुँ। और मै झेलमे बतुँ तभुन फेन खुशीक खबरके रक्षा करनामे और उहिहे साबित करनामे तुहुरे सक्कु जाने मोरिक संग परमेश्वरके अनुग्रहमे शामिल बतो। <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />यम्ने परमेश्वर जन्थाँ कि मै तुहुरिन्से कतरा भेँटा करे चहथुँ। और परमेश्वर जन्थाँ कि मै तुहुरिन्के वास्ता ओस्तेहेँके करथुँ, जसिके येशू ख्रीष्ट करथाँ। <verse eid="PHP 1:8" /><verse number="9" style="v" sid="PHP 1:9" />मै प्राथना करतुँ कि एकदोसुर जहनकेमे तुहुरिन्के प्रेम, सच्चाइक ज्ञान और सक्कु न्यायक संग आकुर बहरती जाए। <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />तबेकमारे तुहुरे चुने सेको कि कोन काम करना ठिक बा। और ख्रीष्ट फिर्ता नै आइतसम तुहुरे शुद्ध और दोषरहित पलिरहो। <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />अपन जीवनहे धार्मिक तरिकासे जिओ, जोन येशू ख्रीष्टके ओहोँरसे आइत, और जिहिसे परमेश्वरके महिमा और प्रशंसा हुइती रहे।<verse eid="PHP 1:11" /></para>
  <para style="s">पावलके बन्धनसे खुशीक खबरके विस्तार</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />हे मोरिक विश्वासी भैयो, मै चहथुँ कि तुहुरे यी जानलेऊ कि मोरिक संग ज्या हुइल बा उहिसे खुशीक खबरहे फैलैनामे बहुत सहयोग मिलल बा। <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" />यहाँसम कि महाराजक महलके सारा पल्टन और बाँकी रहल सक्कु मनैनके बिच्चेम यी पता चलगिलिन कि ख्रीष्टके सेबक हुइलक कारण मै झेलमे बतुँ। <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />और मै झेलमे हुइलक कारण प्रभुमे बहुत्ते विश्वासी संघरियनहे अतरा हिम्मत आगिल बतिन कि ओइने बिना डरैले परमेश्वरके वचन बोले सेक्थाँ। <verse eid="PHP 1:14" /><verse number="15" style="v" sid="PHP 1:15" />कौनो-कौनो झग्राहा मनै बिह्रे मुती ख्रीष्टके प्रचार करिँत। पर कौनो मनै ईमानदारीसे खुशीक खबर प्रचार करनामे मोरिक सहायता करक लग प्रचार करिँत। <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />जोन मनै खुशीक खबरहे ईमानदारीसे प्रचार करथाँ, ओइने प्रेमके कारण असिके करथाँ। काकरेकी ओइने जन्थाँ कि ख्रीष्टके बारेमे खुशीक खबरके रक्षा कर्लक कारण मै झेलमे परल बतुँ। <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />पर उ मनै जेने बिह्रे मुथाँ, ओइने स्वार्थी इच्छासे ख्रीष्टके प्रचार करथाँ। और ओइने यहाँ झेलमे मोरिक समस्या आकुर बह्राई चहथाँ। <verse eid="PHP 1:17" /><verse number="18" style="v" sid="PHP 1:18" />यिहिसे कौनो फरक नै परी! खास बात यी हो कि चाहे उ मजा इच्छासे होए, चाहे गलत इच्छासे होए जसिके हुइलेसे फेन ख्रीष्टके बारेमे खुशीक खबरके प्रचार हुइता। तबेकमारे यक्रेहे कारण मै खुशी बतुँ और खुशी पलिरहम। <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />काकरेकी मै जन्थुँ कि तुहुरिन्के प्राथनासे और येशू ख्रीष्टके ओहोँरसे पठागिलक पवित्र आत्मक सहायतासे मै झेलमेसे मुक्त हुइम। <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />मोरिक मनके इच्छा और आशा यी हो कि मोरिक लाज ना होए। बेन मोरिकमे ख्रीष्टके बारेमे बोल्ना हिम्मत होए, जसिके मै बितल समयमे करल रहुँ। चाहे मै जित्ती रहुँ चाहे मै मुजाऊँ, मै अपन पूरा जीवनसे ख्रीष्टके आदर कर्ती रबुँ। <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />काकरेकी यदि मै जित्ती रहम कलेसे यी ख्रीष्टके लग हुई। और जब मै मुजिम कलेसे यी मोरिक लग आकुर फेन मजा हुई। काकरेकी तब मै ख्रीष्टके संग रहम। <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />पर यदि शरीरमे जित्ती होके मै ख्रीष्टके लग आकुर फलदायी काम करे सेकम। ते मै नै जन्थुँ कि यम्नेमेसे कोन मजा हो। <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />काकरेकी मै ते दोधारमे परल बतुँ। मन ते कहत कि मुजाऊँ और जाके ख्रीष्टके संग रहुँ। काकरेकी यी गजब मजा बा। <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />पर मोरिक जित्ती रना जरुरी बा। काकरेकी तुहुरिन्हे मोरिक सहायतक जरुरी बा। <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />तबेकमारे महिन्हे भरोसा बा और मै जन्थुँ कि मै जित्ती रहम। और मै तुहुरे सक्कु जहनके संग रहम, जिहिसे मै तुहुरिन्हे तुहुरिन्के विश्वासमे बल्गर हुइक लग और ओम्ने खुशी रहक लग सहायता करम। <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />ताकि जब मै फेनदोस्रे तुहुरिन्के संग रहम तब तुहुरे मोरिक कारण येशू ख्रीष्टके बारेमे आकुर धेउर घमण्ड करे सेको।<verse eid="PHP 1:26" /></para>
  <para style="s">कोशिस कर्ती रना और ख्रीष्टके लग दुःख उठैना</para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27" />ध्यान धारो, कि तुहुरिन्के चालचलन ख्रीष्टके खुशीक खबरके अनुसार किल होए। चाहे मै आके तुहुरिन्हे भेँटा करुँ या ना करुँ, मै तुहुरिन्के बारेमे यहे सुनु कि तुहुरे एक्के उद्देश्यक लग स्थिर होके एक्के संग मिलके खुशीक खबरमे आधारित विश्वासके लग लरतो। <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />और कौनो बातमे फेन विरोधीनसे नै डरैथो। तुहुरिन्के हिम्मत ओइन्के विनाशके लग फरछ्वार चिन्हा हो। पर तुहुरिन्के लग मुक्तिक सबुत हो, और यी परमेश्वरके ओहोँरसे हो। <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />काकरेकी परमेश्वर तुहुरिन्हे ख्रीष्टमे विश्वास करना किल नै हो, पर तुहुरिन्हे दुःख सहना फेन सौभाग्य देले बताँ। काकरेकी तुहुरे परमेश्वरकेमे विश्वास करथो। <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" />और तुहुरिन्हे ओस्तेहेँ संघर्ष करना बा जसिके तुहुरे महिन्हे संघर्ष करत देख्लो जब मै फिलिप्पी शहरमे रहुँ। और जोन संघर्षक बारेमे तुहुरे सुन्थो, उ संघर्ष अभिन फेन महिन्हे झेलमे करे परता।<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />ख्रीष्टमे बती कहिके तुहुरे हौसल बतो। काकरेकी तुहुरे अपनमे ख्रीष्टके प्रेमसे सान्त्वना भेटाइल बतो। काकरेकी तुहुरिन्के सहभागिता पवित्र आत्मक संग बा। और काकरेकी ख्रीष्ट तुहुरिन्केमे करुणा और दया देखैले बताँ। <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />कलेसे तुहुरे एक्के संग रहिके, एकदोसुर जहनहे प्रेम करके और एक्के उद्देश्यक लग एक्के मन होके तुहुरे मोरिक आनन्दहे पूरा करो। <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />स्वार्थ या घमण्डसे कुछु ना करो, पर जतरा आदर तुहुरे अपनहे करथो, उहिसे धेउर आदर तुहुरे दोसुर जहनहे करो। <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />तुहुरे हरेक जाने अपन किल भलाई ना खोजो, पर दोसुर जहनके भलाईमे फेन ध्यान देऊ।<verse eid="PHP 2:4" /></para>
  <para style="s">ख्रीष्टके बारेमे गीत</para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 2:5" />जसिन येशू ख्रीष्टके स्वभाव रहिन, ओस्तेहेँ स्वभाव तुहुरिन्केमे रहे परत। <verse eid="PHP 2:5" /><verse number="6" style="v" sid="PHP 2:6" />ऊ परमेश्वर रहिँत, तभुन फेन ऊ परमेश्वरके बराबरी हुइना बातहे एकथो पकरले रना चिज हस नै सोच्लाँ। <verse eid="PHP 2:6" /><verse number="7" style="v" sid="PHP 2:7" />पर येशू सक्कु चिज छोरदेलाँ, और नोकरके रुप धारण करलाँ, और ऊ एकथो मनैया बनगिलाँ। <verse eid="PHP 2:7" /><verse number="8" style="v" sid="PHP 2:8" />और मनैयक रुपमे देखा परके अपनहे नम्र बनैलाँ। और परमेश्वरके आज्ञा मानके ऊ मुअक लग फेन तयार रहिँत। और एकथो अपराधीक हस क्रूसके मृत्यु फेन सहलेलाँ। <verse eid="PHP 2:8" /><verse number="9" style="v" sid="PHP 2:9" />तबेकमारे परमेश्वर हुँकिन्हे सक्कुहुनसे ऊँच पद देलिन। और हुँकिन्हे उ नाउँ देलिन, जोन नाउँ सक्कु नाउँसे भारी बा। <verse eid="PHP 2:9" /><verse number="10" style="v" sid="PHP 2:10" />ताकि जेने स्वर्गमे और पृथ्वीमे और पृथ्वीक तरे बताँ, उ सक्कु जाने येशूहे आदर देहक लग ठेहुनी टेकिँत। <verse eid="PHP 2:10" /><verse number="11" style="v" sid="PHP 2:11" />और परमेश्वर बाबक महिमक लग सक्कु जाने स्वीकार करलिँत कि ख्रीष्ट येशूए प्रभु हुइँत।<verse eid="PHP 2:11" /></para>
  <para style="s">ओजरार हस चम्कना</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />तबेकमारे हे मोरिक प्रिय संघरियन, जसिके तुहुरे पैलेहेँसे मोरिक आज्ञा मन्ती आइल बतो। ओस्तेहेँके अब्बे मोरिक संग रहलमे किल नै होके विशेष करके महिन्से दूर रहलमे फेन तुहुरे हरेक जाने डरैती और लग्लगैती उ सक्कु कामहे करे परना हो। जोन काम उ मनैनके लग ठिक बतिन, जेनहे परमेश्वर मुक्ति देले बताँ। <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />काकरेकी परमेश्वर तुहुरिन्केमे काम करतताँ। तबेकमारे तुहुरिन्हे उ सक्कु करना इच्छा और शक्ति देहतताँ जोन कामसे ऊ खुशी हुइथाँ। <verse eid="PHP 2:13" /><verse number="14" style="v" sid="PHP 2:14" />सक्कु काम बिना गन्गनैले और वाद-विवाद बिना कर्ले करो; <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />ताकि तुहुरे निर्दोष और चोखा होके खराब और भ्रष्ट पुस्तक मनैनके बिच्चेम परमेश्वरके कलंक बिनक सन्तान बनल पलिरहो। यी संसारके मनैनके बिच्चेम तुहुरे आकाशमे रहल तोरैयँन हस चम्के परत। <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />ताकि जब ख्रीष्ट फिर्ता अइहीँ तब मोरिक कोशिस और मोरिक मेहनत बेकारमे नै रहे कहिके महिन्हे घमण्ड करना कारण मिले। <verse eid="PHP 2:16" /><verse number="17" style="v" sid="PHP 2:17" />जब मै तुहुरिन्हे खुशीक खबर सुनैनु ते तुहुरे प्रभु येशूकमे विश्वास कर्लो, और हुँकार सेवक लग अपन जीवनहे बलिदान करक लग देलो। तबेकमारे खुशीक खबर सुनैलक ओहोँरसे यदि महिन्हे मुवादेजाई कलेसे फेन मै तुहुरिन्के संग आनन्दित और खुशी रहम। <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />ओस्तेहेँके तुहुरे खुशी हुई परना हो और मोरिक संग आनन्द करे परना हो।<verse eid="PHP 2:18" /></para>
  <para style="s">तिमोथी और इपाफ्रोडितस</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />महिन्हे प्रभु येशूकमे आशा बा कि मै तिमोथीहे तुहुरिन्के थेन झत्तेहेँ पठैम, ताकि तुहुरिन्के हालखबर सुनके महिन्हे उत्साहा मिले। <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />काकरेकी मोरिक थेन असिन स्वभाव रहल केऊ नै हो, जे चोखा मनसे तुहुरिन्के चिन्ता करे। <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />काकरेकी सक्कु जाने अपन स्वार्थक बारेमे सोँच्थाँ। और येशू ख्रीष्टसे सम्बन्धित बातके बारेमे ओइने नै सोँच्थाँ। <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />पर तुहुरे जन्थो कि तिमोथी कसिके साबित करल कि ऊ बफादार बा कि जसिके छावा बाबक संग मेहनत करत, ओस्तेके खुशीक खबर फैलैनामे मोरिक संग ऊ महान काम कर्ले बा। <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />तबेकमारे महिन्हे आशा बा, कि मोरिक संग का हुइक लग बा कहिके महिन्हे पता चल्तिकी मै तिमोथीहे तुहुरिन्के थेन पठादेहम। <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />और महिन्हे प्रभुकमे भरोसा बा कि मै फेन झत्तेहेँ अइबुँ।<verse eid="PHP 2:24" /></para>
  <para style="s">इपाफ्रोडिटसहे प्रशंसा</para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25" />मै इपाफ्रोडिटसहे तुहुरिन्के थेन पठैना जरुरी सम्झनु। जे मोरिक भैया और सहकर्मी और सिपाही-संघरिया और तुहुरिन्के पठाइल हुलाकी और जरुरी बातमे मोरिक सेवा करुइया मनैया हो। <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />मै उहिहे यी कारणसे फेन पठाइतुँ। काकरेकी तुहुरे सक्कुहुनसे भेँटा करक लग उहिहे गजब मन लागल रहिस। और ऊ बेमार बा कना बात तुहुरे सुनलेले बतो कहिके ऊ चिन्ता करतेहे। <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />और ऊ जात्तिके बेमार होगिल रहे, यहाँसम कि ऊ मुना हस फेन होगिल रहे। पर परमेश्वर उहिहे चोख्वैलाँ; ओकरमे किल नै, पर महिन्हे फेन परमेश्वर दया देखैलाँ ताकि मै उहिसे धेउर आकुर दुःख ना उठाऊँ, जत्रा दुःख मै पैलेहेँसे उठाइतुँ। <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />तबेकमारे उहिहे तुहुरिन्के थेन पठाइक लग मै आकुर धेउर कोशिस कर्नु ताकि उहिसे भेँटा करके तुहुरे खुशी होजाऊ, और मोरिक मन फेन शान्त होजाए। <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />तबेकमारे तुहुरे प्रभुमे उहिसे खुशीसे भेँटा करहो, और तुहुरिन्हे ओकर और ओकर हस मनैनके सम्मान करे परत। <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />काकरेकी ऊ ख्रीष्टके कामके लग अपन प्राणहे जोखिममे दारल, यहाँसम कि मुचुकल रहे। ताकि ऊ मोरिक सहायता करे सेके, जोन सहायता तुहुरे करे नै सेकथुइतो, काकरेकी तुहुरे गजब दूर बतो।<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s">शरीरमे भरोसा नै करना</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />तबेकमारे हे मोरिक विश्वासी भैयो, तुहुरे प्रभुमे बतो कहिके तुहुरे आनन्दित रहो। जोन बात मै तुहुरिन्हे पैलेहेँ लिखल बतुँ, वहे बात घनीघनी लिखक लग महिन्हे कौनो झन्झट नै लागत और जब मै बात तुहुरिन्हे घनीघनी कथुँ ते यी बात तुहुरिन्हे झूँटा गुरुनसे बँचाके धारी। <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />ओइन्से हौश्यार रहो जेने, कुकरीनके हस व्यवहार देखैथाँ, और ओइन्से फेन हौश्यार रहो, जेने खराब काम करथाँ। और उ मनैनसे फेन हौश्यार रहो, जेने कथाँ कि तुहुरिन्के उद्धारके लग खतना करवैना जरुरी बा। <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />काकरेकी अस्लीमे खतना करल मनै ते हम्रेहे हुइती। काकरेकी हम्रे परमेश्वरके आराधना हुँकार आत्मक अगुवाइसे कर्थी और ख्रीष्ट येशूकमे गर्व कर्थी, और हम्रे अपने कोशिसमे भर नै पर्थी। <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />जब कि मोरिक थेन बहुत्ते कारण बा कि मै अपने कोशिसमे भर परुँ। पर यदि केऊ असिन सोँचत कि ओकर थेन असिन मानवीय कोशिसमे भर परना मजा कारण बताँ कलेसे मोरिक थेन उहिसे फेन धेउर कारण बा कि मै अपने कोशिसमे भर परुँ। <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" />मोरिक जल्मलक आठ दिन पाछे परमेश्वरके आज्ञा अनुसार मोरिक खतना हुइल। मै जल्मत्तिक इजरायल देशके हुइतुँ। और मै बेन्यामिन कुलके हुइतुँ। और मोरिक दाईबाबा हिब्रू रहिँत। तबेकमारे मै फेन हिब्रू हुइतुँ, और मोशक नियम कानुनके बारेमे हो कलेसे मै एकथो फरिसी हुइतुँ। <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" />यदि जोशके बारेमे हो कलेसे मै मण्डलीहे सतुइया मनैया रहुँ। यदि मोशक नियम कानुनके धार्मिकतक बारेमे हो कलेसे मै मोशक नियम कानुनके पालन करनामे एकथो धार्मिक मनैया रहुँ। काकरेकी मै उ सक्कु नियम कानुनके पालन कर्नु। <verse eid="PHP 3:6" /><verse number="7" style="v" sid="PHP 3:7" />पर ख्रीष्ट महिन्हे देखैले बताँ कि एकथो समयमे जोन चिजहे मै सोँचुँ कि यी मोरिक फाइदक लग हो। पर ख्रीष्टके कर्लक कामके कारण आज उ चिज मोरिक लग कौनो कामके नै हुइँत। <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />काकरेकी मै अपन प्रभु येशू ख्रीष्टहे चिन्हे चहथुँ, जे बाँकी सक्कु चिजसे अमूल्य बताँ। तबेकमारे मै सक्कु चिजहे बेकार मानके छोरदेले बतुँ। और ओइन्हे मै कुरकुट हस सम्झथुँ, ताकि मै ख्रीष्टहे जाने सेकुँ। <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />और ताकि मै हुँकार संग एकतामे रहे सेकुँ, उ धार्मिकतासे नै हो जोन मोशक नियम कानुनके पालन कर्लेसे किल आइत। पर उ धार्मिकतासे हो, जोन ख्रीष्टमे विश्वास कर्लक कारण परमेश्वर महिन्हे देथाँ। <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />मै ख्रीष्टहे जाने और अनुभव करे चहथुँ। और मै फेनदोस्रे जित्ती करुइया शक्तिहे जाने चहथुँ जे ख्रीष्टहे जित्ती करल। और मै ओस्तेहेँके दुःख उठाई चहथुँ और मुए चहथुँ जसिके ख्रीष्ट करलाँ। <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />ताकि मै फेन मुअलमेसे फेनदोस्रे जित्ती कराजाऊँ।<verse eid="PHP 3:11" /></para>
  <para style="s">लक्ष्य ओहोँर आघे बहरना</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />मै यी सक्कु चिजहे पैलेहेँ भेटासेकल बतुँ, या मै पक्का होसेकल बतुँ कहिके मै दाबी नै करथुइतुँ। पर मै कोशिस कर्ती आघे बहरती जाइतुँ ताकि महिन्हे उ चिज मिलजाए। पर मै उ चिजके लग दौरतुँ, जोन चिजके लग येशू ख्रीष्ट महिन्हे चुनल बताँ। <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />हे मोरिक विश्वासी भैयो, मै यी दाबी नै करथुइतुँ कि मै पैलेहेँ उ चिज भेटासेकलतुँ। पर हाँ, मै यी जरुर करतुँ कि जोन पैलेहेँ होसेकल बा, उहिहे बिस्रैती भविष्यक ओहोँर बह्रतुँ। <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />और लक्ष्यक लग मै कर्रा मेहनत कर्ती बतुँ ताकि मै उ ईनाम भेटाई सेकुँ, और उ ईनाम यी हो कि परमेश्वर महिन्हे स्वर्गमे बलाइतताँ। काकरेकी येशू ख्रीष्ट मोरिक लग मुलाँ। <verse eid="PHP 3:14" /><verse number="15" style="v" sid="PHP 3:15" />तबेकमारे हमारमेसे जतरा जाने फेन विश्वासमे पक्का बती, हम्रे सक्कु जाने एक्के हस सोँची। और यदि कौनो बातमे तुहुरिन्के दोसुर विचार बा कलेसे परमेश्वर तुहुरिन्हे उ फेन फरछ्वार करादिहीँ। <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />तबेकमारे हम्रिहिन्हे उ सच्चाइसे जिए परत, जोन परमेश्वर पैलेहेँसे हम्रिहिन्हे देखैले बताँ।<verse eid="PHP 3:16" /></para>
  <para style="s">स्वर्गमे हमार नागरिकता</para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17" />हे मोरिक विश्वासी भैयो, तुहुरे मोरिक व्यवहारके अनुशरण करो, और उ मनैनकेमे फेन ध्यान देऊ, जेने मोरिक व्यवहारके अनुशरण करथाँ। तुहुरे यनके व्यवहारके फेन अनुशरण करो। <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />काकरेकी असिन बहुत्ते मनै बताँ, जेनके बारेमे मै तुहुरिन्हे घनीघनी बतैले बतुँ। और अब्बे फेन मै आँश गिरैती कहतुँ कि ओइन्के जीवन यी देखैथिन कि ओइने क्रूसमे ख्रीष्टके मुलक सन्देशहे घृणा करथाँ। <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />ओइन्के अन्त्य विनाश हुइना हुइतिन, और ओइने अपन शरीरके इच्छाहे पूरा करक लग किल जिथाँ। लाज लग्तिक काम करना बारेमे ओइने घमण्ड करथाँ, और ओइने जबफेन संसारके चिजके बारेमे सोँच्ती रथाँ। <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />पर हमार नागरिकता स्वर्गक हो, और हम्रे हमार मुक्तिदाता प्रभु येशू ख्रीष्टके स्वर्गमेसे फिर्ता अइना आसरा हेरती। <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />येशू ख्रीष्टके थेन हरेक चिजहे अपन अधिनमे धरना शक्ति बतिन। और वहे शक्तिसे ऊ हमार कमजोर शरीरहे अपन महिमक शरीर हस हुइक लग बदलदिहीँ।<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="s">पावलके सल्लाहा</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />तबेकमारे हे मोरिक प्रिय भैयो, मै तुहुरिन्हे बहुत माया करथुँ, और तुहुरिन्से भेँटा करना आसरा हेरतुँ। तुहुरे मोरिक आनन्द और मोरिक मुकुट हुइतो। हे मोरिक प्रिय भैयो, अपन विश्वासमे बल्गर पलिरहो। <verse eid="PHP 4:1" /><verse number="2" style="v" sid="PHP 4:2" />मै इयोदिया और सुन्तुखे दुनु जहनहे अनुरोध करतुँ कि ओइने एकदोसुर जहनमे एकतामे रहिँत। <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />हे सच्चा सहकर्मी, मै तुहिन्हे फेन अनुरोध करतुँ, कि तुँ उ जन्नी मनैनहे एकदोसुर जहनके संग एकतामे रहक लग सहायता करो। काकरेकी ओइने मोरिक संगसंगे खुशीक खबर फैलैना काममे क्लेमेसके संग और मोरिक दोसुर सहकर्मीनके संग मिलके मेहनत कर्ले बताँ। जेनके नाउँ जीवनके किताबमे बतिन।<verse eid="PHP 4:3" /></para>
  <para style="s">जबफेन आनन्दित रना</para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4" />प्रभुमे सदादिन आनन्दित रहो; मै फेनदोस्रे कहतुँ, आनन्दित रहो। <verse eid="PHP 4:4" /><verse number="5" style="v" sid="PHP 4:5" />सक्कु जाने तुहुरिन्के कोमल स्वभावहे देखिँत। प्रभु झत्तेहेँ आइतताँ। <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />कौनो फेन बातके चिन्ता ना करो; पर हरेक परस्थितिमे तुहुरिन्के निवेदनहे प्राथना और बिन्तीक माध्यमसे धन्यवादके संग परमेश्वरके आघे धारो। <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />तब परमेश्वर तुहुरिन्हे शान्ति दिहीँ, यी उ शान्ति हो जिहिहे मनै बुझे नै सेक्थाँ। और यी शान्ति तुहुरिन्के मन और तुहुरिन्के विचारहे येशू ख्रीष्टमे सुरक्षित धारल रही।<verse eid="PHP 4:7" /></para>
  <para style="s">यी बातमे ध्यान लगाऊ</para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8" />तबेकमारे, हे मोरिक विश्वासी भैयो, अन्त्यमे जोन-जोन बात सच्चा बा। और जोन-जोन बात आदरणीय बा। और जोन-जोन बात धार्मिक बा। और जोन-जोन बात सुग्घुर बा। और जोन-जोन बात प्रशंसा करना लायकके बा। और जोन-जोन चिज महा मजा बा। और असिन चिज जेकर मनै सम्मान करथाँ। यहे सक्कु बातमे तुहुरिन्के मन लागल पलिरहे। <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />तुहुरिन्हे उ पाठके अभ्यास कर्ती रहे परी, उ निर्देशनके फेन जोन तुहुरिन्हे महिन्से मिलल बा। और उ नमूनक जोन मै अपन बात बत्वाके और कामके माध्यमसे तुहुरिन्हे देखैले बतुँ। तब शान्तिक परमेश्वर तुहुरिन्के संग रहिहीँ।<verse eid="PHP 4:9" /></para>
  <para style="s">ओइन्के दानके लग धन्यवाद</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />मै प्रभुमे गजब आनन्दित बतुँ, कि आब अतरा धेउर दिन पाछे मोरिक लग पहुँरा पठाके तुहुरे यी देखाइल बतो कि तुहुरे मोरिक बारेमे सोँच्थो; मै जन्थुँ कि यकर बारेम तुहुरे सुरुएसे सोँचतोहो। पर तुहुरिन्हे मौका नै मिलल रहे। <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />मोरिक थेन उ चिजके कमि बा, ज्या चिजके महिन्हे जरुरी बा कहिके मै यी नै कहथुइतुँ। पर जोन परस्थितिमे रलेसे फेन सन्तुष्ट रहे परत कहिके मै सिखसेकल बतुँ, तबेकमारे मै असिके कहतुँ। <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />थोरचे रलेसे फेन मै रहे सेकदरथुँ, और सक्कु चिज रलेसे फेन मै रहे सेकदरथुँ। और मोरिक थेन मोरिक जरुरीक सक्कु चिज रलेसे फेन या जब मोरिक थेन मोरिक जरुरीक चिज नै रलेसे फेन मै यी सक्कु परस्थितिमे रहे सिखलेहल बतुँ। <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />ख्रीष्टमे मै सक्कु चिज करे सेक्थुँ, जे महिन्हे शक्ति देहत। <verse eid="PHP 4:13" /><verse number="14" style="v" sid="PHP 4:14" />तभुन फेन महिन्हे पहुँरा पठाके तुहुरे मोरिक दुःखमे शामिल हुइल बतो, और यी तुहुरे मजा काम करलो। <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />तुहुरे फिलिप्पीन अप्निहीँ फेन जन्थो, कि खुशीक खबरके सुरुमे मै माकेडोनिया प्रदेशमेसे विदा हुइबेर, देना और लेना काममे, तुहुरिन्हे बाहेक कौनो मण्डली शामिल मोरिक संग नै हुइल रहे। <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" />अस्तेके जब मै थेसलोनिके शहरमे रहुँ, तब फेन तुहुरे मोरिक जरुरी पूरा करक लग तुहुरे एकचोसे धेउरचो मोरिक लग पैँसा पठैलो। <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />मै आर्थिक सहायता भेटाइक लग असिके नै कहथुइतुँ, बेन मै चहथुँ कि तुहुरिन्हे उ दयक लग ईनाम मिले, जोन दया तुहुरे देखैले बतो। <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />जोन सहायता तुहुरे इपाफ्रोडिटसके माध्यमसे पठैलो, उहिसे मै सक्कु चिज भेटागिनु। और जतरा महिन्हे भेटाई परना रहे, मै उहिसे फेन धेउरे भेटाइल बतुँ। यी मोरिक लग प्रशस्त बा, और तुहुरिन्के यी पहुँरा असिन बा जसिके कि तुहुरे परमेश्वरहे दान चह्रैले बतो, जोन मीठ बास देहत। परमेश्वर यिहिहे स्वीकार करथाँ, और यिहिसे परमेश्वर गजब खुशी हुइथाँ। <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />और मोरिक परमेश्वर फेन अपन उ सम्पतिसे तुहुरिन्के हरेक कमिहे पूरा करहीँ, जोन सम्पत्ति महिमासुन्धे येशू ख्रीष्टमे बा। <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />हमार परमेश्वर बाबक महिमा सदासर्वदा हुइती रहे। आमेन! (यकर मतलब हुइत, अस्तेहेँ होए।)<verse eid="PHP 4:20" /></para>
  <para style="s">आखिरी नमस्कार</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />ख्रीष्ट येशूमे परमेश्वरके सक्कु पवित्र मनैनहे मोरिक ओहोँरसे नमस्कार कहिदेऊ। जोन विश्वासी भैयन मोरिक संग बताँ, ओइन्के ओहोँरसे फेन तुहुरिन्हे नमस्कार। <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />परमेश्वरके सक्कु पवित्र मनैनके ओहोँरसे विशेष करके महाराजक महलके विश्वासीनके ओहोँरसे तुहुरिन्हे नमस्कार बा। <verse eid="PHP 4:22" /><verse number="23" style="v" sid="PHP 4:23" />हमार प्रभु येशू ख्रीष्टके अनुग्रह तुहुरिन्के संग रहे।<verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>