<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">MAR MARƗKO</book>
  <para style="h">Marɨko</para>
  <para style="toc3">Mar</para>
  <para style="toc2">Marɨko</para>
  <para style="toc1">eNgʉlʉ Mbʉya ya Yesʉ Kirisito nga ko yashakawa na Marɨko</para>
  <para style="mt2">eNgʉlʉ Mbʉya ya Yesʉ Kirisito nga ko yashakawa na</para>
  <para style="mt1">MARƗKO</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">Makangɨrɨtsya wa Yoani mubatisya</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mat 3:1-12</ref>; <ref loc="LUK 3:1-18">Luk 3:1-18</ref>; <ref loc="JHN 1:19-28">Yoa 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Hano ho ithangire eNgʉlʉ Mbʉya ya Yesʉ <char style="w" lemma="Kirisito">Kirisito</char>, <char style="w" lemma="Mʉgala wa Gongo">Mʉgala wa Gongo</char>, <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />ɨkwamana nga ko bishakirwe mo kɨtabo ky'omʉmɨnyeretsɨ Isaya bɨthɨ:</para>
  <para style="q1" vid="MRK 1:2">«Shʉnga, ingye Gongo nyamathʉma omugendi aye</para>
  <para style="q1" vid="MRK 1:2">akʉthange ebʉshondotsɨ,</para>
  <para style="q1" vid="MRK 1:2">bʉshana akʉkometsye nzɨra<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="ft" closed="false">Soma Malaki 3:1.</char></note>.<verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />Nɨ mʉlenge w'omʉndʉ yo ʉhambala mo mbwarara athɨ:</para>
  <para style="q1" vid="MRK 1:3">“Muthungananie enzɨra ya Nyinya-kowethʉ,</para>
  <para style="q1" vid="MRK 1:3">mulambathikanie aho atsʉka<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">Malaki 3:1; Isaya 40:3xt*, ahwirwe ɨkwamana n'omʉbɨndʉlo wa kera wa Bakiriki.</char></note>!”»<verse eid="MRK 1:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MRK 1:4" />Aho Yoani Mubatisya mwahʉlʉka mo <char style="w" lemma="mbwarara">mbwarara</char>. Mwabatisya abandʉ, alɨakangɨrɨtsyabo athɨ: « Mʉbɨndʉke ɨthoka mo <char style="w" lemma="bɨtsɨbʉ">bɨtsɨbʉ </char> byenyu, <char style="w" lemma="mubatisibwe">mubatisibwe</char>, nɨmo mwaganyɨrwako <char style="w" lemma="ebɨtsɨbʉ">ebɨtsɨbʉ</char><note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">ɨbɨndʉka ly'obʉyɨngo</char><char style="ft" closed="false">: Awandɨ mashako anegenire athɨ: </char><char style="fqa" closed="false">Ɨbɨndʉla emɨbere </char><char style="fqa" closed="false">Mʉbɨndʉke </char><char style="ft" closed="false">kʉtse </char><char style="fqa" closed="false">Mʉyɨshʉbeko.</char></note>.» <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Abandʉ mobathoka mo kɨhʉgo kyoshɨ ky'iYuteya n'abahimbani boshi b'ɨYerʉsalemʉ n'ɨgendera Yoani. Mobatsɨga ebɨtsɨbʉ byabo, naye mwabatisyabo mo lwitsi lw'eYorotani.<verse eid="MRK 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6" />Yoani agenda ambala lʉkɨmba lwakomibawa mʉ boya bwa nyama yo ɨnahʉlwamo ngamɨa, na kuthyo agenda ambala mʉkaba wa ngobi mo mbɨndɨ yɨwe<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">Shʉnga <char style="xt"><ref loc="2KI 1:8">2Bamɨ 1:8</ref></char>.</char></note>. Na agenda alya <char style="w" lemma="mɨngʉra">emɨʉngʉra</char> n'obʉkɨ bw'omo ndokolo. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Athya ko Yoani agenda akangɨrɨtsya abandʉ: «Oyo uhika enyuma kw'ingye, awithe maka kw'inyirengya, nangye nyɨthatholere iunama n'ɨmɨnʉla emiriki y'oko bɨrato bɨwe. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Ingye enyibabatisya mʉ metsi, h'ɨye andababatisya mʉ <char style="w" lemma="Mʉthɨma mwerʉ">Mʉthɨma Mwerʉ</char>.»<verse eid="MRK 1:8" /></para>
  <para style="s">Eribatisibwa lya Yesʉ n'erɨrengwako lɨwe</para>
  <para style="r">(<ref loc="MAT 3:13">Mat 3:13</ref>; <ref loc="MAT 4:11">4:11</ref>; <ref loc="LUK 3:21-22">Luk 3:21-22</ref>; <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Mo bɨro ebyo, Yesʉ mwathoka iNasareti, mo kɨhʉgo ky'iNgalilaya, na Yoani mwamubatisya mo lwitsi lw'eYorotani. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />Yesʉ abere anemʉthoka mo metsi, aho n'aho mwashʉnga <char style="w" lemma="lʉbʉla">olʉbʉla</char> nɨ lwamakɨngʉkala <char style="w" lemma="Mʉthɨma mwerʉ">n'oMʉthɨma Mwerʉ</char> mwamukimirako nga kalikuku. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />N'omʉlenge mw'onvwɨka ɨthoka mo lʉbʉla, nɨanegena athɨ: «Ɨwe ʉlɨ Mʉgala aye mʉtsɨɨrwa, unanyimoya kʉtsɨbʉ.»<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />Aho n'aho oMʉthɨma Mwerʉ mwamukuna n'ɨmʉthwala mo mbwarara. <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />Yesʉ mwabya mo mbwarara eyo mo bɨro makumi ane, alɨ alengwako na Sitani. Mwikalayo hagʉma n'esonyama s'omo ndokolo, na bamalaɨka bagenda abamʉkolera. <verse eid="MRK 1:13" /><verse number="14" style="v" sid="MRK 1:14" />Honyuma w'erɨmɨnwa lya Yoani mo muliki, Yesʉ mwaya mo kɨhʉgo ky'iNgalilaya, mwafʉla eNgʉlʉ Mbʉya ya Gongo. <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />Agenda abwɨra abandʉ athɨ: «Endambi yamahika, <char style="w" lemma="Bwamɨ bwa Gongo">n'oBwamɨ bwa Gongo</char> bʉlɨ hofɨ! Bʉshana n'ekyo, mʉbɨndʉke ɨthoka mo bɨtsɨbʉ byenyu, na mwɨkɨrɨtsye eNgʉlʉ Mbʉya!»<verse eid="MRK 1:15" /></para>
  <para style="s">Yesʉ abɨrɨkɨra barobi bane</para>
  <para style="r">(<ref loc="MAT 4:18-22">Mat 4:18-22</ref>; <ref loc="LUK 5:1-3">Luk 5:1-3</ref>; <ref loc="LUK 5:10-11">Luk 5:10-11</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />Yesʉ abere anemʉtsʉka emʉsɨke w'engetsɨ y'iNgalilaya, mwashʉnga Simoni bana Ndereya mʉgala wabo. Bano bagenda abagʉsha akakira kabo mo ngetsɨ, kʉshangwa babyaga barobi. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Yesʉ mwabwɨrabo athɨ: «Mʉnyɨkwame, nyabayɨramo barobi ba bandʉ.» <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Aho n'aho mobamika ehikira hyabo n'ɨmʉkwama. <verse eid="MRK 1:18" /><verse number="19" style="v" sid="MRK 1:19" />Yesʉ abere alotsya ebʉshondotsɨ, mwashʉnga Yakobo na Yoani mʉgala wabo, bagala ba Sebetayo. Babyaga mo bwatho bwabo niabakomya ehikira hyabo. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Aho n'aho mwabɨrɨkɨrabo. Aho mobamika Sebetayo ishe wabo y'omo bwatho hagʉma n'abakoli bʉwe, na mobakwama Yesʉ.<verse eid="MRK 1:20" /></para>
  <para style="s">Yesʉ abɨnga mʉtsɨmʉ mʉbɨ</para>
  <para style="r">(<ref loc="LUK 4:31-37">Luk 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Yesʉ n'abɨga bʉwe mobɨngɨra mo muyi w'ɨKaperenaʉmʉ. Ekɨro ky'<char style="w" lemma="Sabato">eSabato</char> kyabere kyahika, Yesʉ mwɨngɨra mo <char style="w" lemma="sinakoki">sinakoki</char> n'ɨthanga ɨkangɨrɨtsya abandʉ. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />Abandʉ bo bagenda abamwonvwa mobashweka kʉtsɨbʉ babere bashʉnga ko mɨkangɨrɨtsye yɨwe, kʉshangwa mwathakangɨrɨtsyabo nga kw'abakangɨrɨtsya babo b'o<char style="w" lemma="Mʉgomba">Mʉgomba</char>, hewethuwe agenda akangɨrɨtsyabo n'amaka.<verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />Ko ndambi eyo, mo <char style="w" lemma="Sinakoki">Sinakoki</char> yabo mwabyaga mʉndʉ mʉgʉma yo wabyagako mʉtsɨmʉ mʉbɨ. Mwathanga ɨhambala n'ɨanegena athɨ: <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />«Ɨwe Yesʉ w'iNasareti, Uthushondyako ki no? wahikaga bʉshana n'ithutsikya? Nyetsi ko ʉlɨ <char style="w" lemma="Mubuyirire wa Gongo">Mubuyirire wa Gongo</char>!»<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />Yesʉ mwakemera omʉtsɨmʉ mʉbɨ oyo yo kʉtsɨbʉ, n'ɨmʉhamʉla athɨ: «Tsɨra, thoka ko mʉndʉ oyu!» <verse eid="MRK 1:25" /><verse number="26" style="v" sid="MRK 1:26" />Omʉtsɨmʉ oyo mwathengania omʉndʉ oyo yo kʉtsɨbʉ, mwamʉthokako, nɨahambala kʉtsɨbʉ.<verse eid="MRK 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 1:27" />Abandʉ boshi mobashweka kʉtsɨbʉ n'ɨthanga ibutsania bathɨ: «Ebi nabyo nɨ bɨhɨ? Ko kwenene ebɨnwa ebyo Yesʉ akangɨrɨtsya ni bihya-bihya kandɨ nɨ bya maka! Omʉndʉ oyu anahamʉla emɨtsɨmʉ, naro ni yamushikya!» <verse eid="MRK 1:27" /><verse number="28" style="v" sid="MRK 1:28" />Aho Yesʉ mwaya ngʉlʉ mo kɨhʉgo kyoshi ky'iNgalilaya.<verse eid="MRK 1:28" /></para>
  <para style="s">Yesʉ alamya bakoni bangɨ</para>
  <para style="r">(<ref loc="MAT 8:14-17">Mat 8:14-17</ref>; <ref loc="LUK 4:38-41">Luk 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Babere bathoka mo <char style="w" lemma="sinakoki">sinakoki</char> eyo, aho n'aho mobaya mo nyʉmba ya Simoni na Ndereya, Yesʉ nɨalɨ hagʉma na Yakobo na Yoani. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Nyatsala wa Simoni abyaga mo ngɨngo, bʉshana n'akapururu. Mo ndambi Yesʉ abere ahika aho, aho n'aho mobamʉfʉlɨra omwatsɨ w'endwala yɨwe. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Yesʉ mwayɨfʉnda hofɨ naye, mwamʉtsɨmba ko kʉboko n'imwimania, naye mwalama akapururu ako, na mwathanga ɨthekerabo.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />Bwabere bwagoroba, erɨtsʉba nɨ lyamamala ɨrenga, mobalethera Yesʉ yo abandʉ boshi bo babyaga bakoni na bo babyagako <char style="w" lemma="mɨtsɨmʉ">emɨtsɨmʉ</char> mɨbɨ. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Abandʉ boshi b'omo muyi oyo mobahindana ho lukyo lw'enyʉmba. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Yesʉ mwalamya bakoni bangɨ bo bagenda abagalwa na makoni mɨna-mɨna. Mwabɨnga emɨtsɨmʉ mɨbɨ mɨngɨ, mwathalikaro ɨnegene n'ekɨnwa n'ekɨgʉma, kʉshangwa yabyaga niyimwetsi.<verse eid="MRK 1:34" /></para>
  <para style="s">Yesʉ athulagania eNgʉlʉ Mbʉya y'iNgalilaya</para>
  <para style="r">(<ref loc="LUK 4:42-44">Luk 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Bwabere bwakya mo mambya matsɨbʉ, Yesʉ mwabʉka, mwathoka mo muyi na mwaya ahathalɨ bandʉ, n'eyo mwathanga ɨshaba. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Aho Simoni na balikyabo mobayamushondya. <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />Babere bamʉshʉnga mobamʉbwɨra bathɨ: «Abandʉ boshi abakushondya.» <verse eid="MRK 1:37" /><verse number="38" style="v" sid="MRK 1:38" />Hewethuwe Yesʉ mwashʉbɨtsyabo athɨ: «Thʉgende mo mɨrongo yo yɨrɨ hofɨ, bʉshana nyɨfʉle eNgʉlʉ Mbʉya ko bandʉ b'eyo nabo. Kʉshangwa nyahikaga bʉshana n'ekyo.»<verse eid="MRK 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39" />Aho mwagenda ahoshi-hoshi mo kɨhʉgo ky'iNgalilaya alɨafʉla eNgʉlʉ Mbʉya mo <char style="w" lemma="sosinakoki">sosinakoki</char> n'erɨbɨnga emɨtsɨmʉ mɨbɨ.<verse eid="MRK 1:39" /></para>
  <para style="s">Yesʉ alamya mʉbenzɨ</para>
  <para style="r">(<ref loc="MAT 8:1-4">Mat 8:1-4</ref>; <ref loc="LUK 5:12-16">Luk 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Kɨro kɨgʉma <char style="w" lemma="Mʉbenzɨ">mʉbenzɨ</char> mʉgʉma mwahikira Yesʉ. Omʉbenzɨ oyo mwafʉkama embere sɨwe n'ɨmʉshaba athɨ: «Wamashasha wanganyetsya.» <verse eid="MRK 1:40" /><verse number="41" style="v" sid="MRK 1:41" />Yesʉ mwamʉshashɨra, mwalambʉla okʉboko, mwamʉkolako n'ɨmʉbwɨra athɨ: «Nyishashire, wetsɨbwe!» <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Aho n'aho ebɨbenzɨ mobyamʉthokako, n'omʉndʉ oyo mwetsɨbwa. <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />Kona ndambi eyo, Yesʉ mwamʉbwɨra athɨ agende. <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />Mwakongomeretsya athɨ: «Onvwa! Uthanalinda wabwɨra mʉndʉ n'omʉgʉma y'ebɨnwa ebi. Hewethuwe ʉgende ew'o <char style="w" lemma="mʉheri">muheri</char> n'imukangya nga ko wamamala ibya. Honyuma kw'aho ʉlethe <char style="w" lemma="bɨhembo">ebɨhembo</char> nga ko Mʉsa ahamulire, bibye butimo ko bandʉ boshi ko wametsɨbwa.»<verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />Hewethuwe omʉndʉ oyo abere agenda, mwathanga ithulagania emyatsɨ eyo y'ahoshi-hoshi. Na bʉshana n'ekyo Yesʉ mwathashubakotsya ɨngɨra mu muyi woshi-woshi mo bʉrora-rora. Mwikala mo mbwarara, hewethuwe namo byanabyaga bithyo, abandʉ bagenda abamuhikira eyo, ɨthoka ko mbande soshi.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">Yesʉ alamya mʉndʉ w'amakonongola</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mat 9:1-8</ref>; <ref loc="LUK 5:17-26">Luk 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Honyuma wa bɨro bɨrebe, Yesʉ mwashʉba ɨKaperenaʉmʉ, abandʉ mobonvwa kw'alɨ mo nyʉmba. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Bandʉ bangɨ mobahindana aho, ihika ko kɨka mohathashubabya mwanya mo nyʉmba n'embʉga embere y'olukyo. Yesʉ agenda akangɨrɨtsyabo eKɨnwa kya Gongo.<verse eid="MRK 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 2:3" />Aho, bandʉ bagʉma mobalethera Yesʉ yo mukoni wa makonongola niahekirwe na bayira bane. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Hewethuwe, bʉshana n'obʉngɨ bw'abandʉ, mobathakotsya imuhikya embere sa Yesʉ. Aho mobashamba naye ko lʉthwe<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">Abathobola olʉthwe</char><char style="ft" closed="false">: olʉthwe lwa ko manyʉmba w'aBayuta lwabyaga nɨlʉlambathɨkene. Lwabyaga lwa mɨthɨ na bʉthaka butsindayirwe. </char></note> lw'enyʉmba, mobathobola elʉgʉlʉ y'ahandʉ ho Yesʉ abyaga imene. Aho, mobakimya ow'amakonongola ahandʉ aho bashambʉlaga, nɨanaonzere ko kipoyi kɨwe (ImageCO000123jpj) <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />Yesʉ abere ashʉnga olwɨkɨrɨtsyo lw'abandʉ abo, mwabwɨra ow'amakonongola athɨ: «Mwana aye, ebɨtsɨbʉ byawe byamaganyɨrwa.»<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />Bakangɨrɨtsya bagʉma b'oMʉgomba, babyaga nibikere mo nyʉmba eyo. aBakangɨrɨtsya abo mobathanga ɨyɨbʉtsya mo mɨthɨma yabo, bathɨ: <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />«Omʉndʉ oyu anegena athya bʉshana na ki? Ahatsya kʉ Gongo. Nɨ ndɨ yo wangakotsya ɨganyɨra ebɨtsɨbʉ athalɨ Gongo mʉsha?» <verse eid="MRK 2:7" /><verse number="8" style="v" sid="MRK 2:8" />Aho Yesʉ mwamɨnya ebɨnwa bagenda abayɨbʉtsya mo mɨthɨma yabo. Bʉshana n'ekyo, mwabʉtsyabo athɨ: «Bʉshana na ki omʉyɨbʉtsya ebɨnwa ebi mo mɨthɨma enyu? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />Kɨhe kyo kyolo mo bɨbɨrɨ bɨno? Ɨbwɨra omʉndʉ w'amakonongola mbʉ: “ebɨtsɨbʉ byawe byamaganyɨrwa” kʉtse ɨmʉbwɨra mbʉ: “wimana, ʉheke ekipoyi kyawe na ʉgende?” <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Aho, enyishondya mʉmɨnye kw'oMʉgala w'oMʉndʉ awithe amaka w'erɨganyɨra ebɨtsɨbʉ hano ishi.» Bʉshana n'ekyo mwabwɨra omʉndʉ w'amakonongola oyo athɨ: <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />«Ni ingye enyɨkʉbwɨra nyɨthɨ wimana, heka ekipoyi kyawe na ʉgende ewawe!»<verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />Aho n'aho omʉndʉ oyo mwimana, mwatsɨmba ekipoyi kɨwe, mwahʉlʉka embere s'abandʉ boshi n'ɨyɨgendera. Abandʉ boshi mobashweka, mobasingya Gongo, nɨabanegena bathɨ: «Thʉthahera thwathashʉnga kʉ bɨnwa bɨrɨnga ebi!»<verse eid="MRK 2:12" /></para>
  <para style="s">Yesʉ abɨrɨkɨra Lawi amʉkwame</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mat 9:9-13</ref>; <ref loc="LUK 5:27-32">Luk 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Honyuma kw'aho, Yesʉ mwashʉbaya emʉsɨke w'engetsɨ y'iNgalilaya. Muhindano mʉnene wa bandʉ mobamʉkwama, naye agenda akangɨrɨtsyabo. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Abere anemʉtsʉka, mwashʉnga Lawi<note caller="+" style="f"><char style="fr" closed="false">2:14 </char><char style="ft" closed="false">Lawi: Lawi au Matayo (Mat 9.9).</char></note> mʉgala wa Alʉfayo. Lawi oyo abyaga n'ikere mo biro by'erɨrɨhɨsɨramo ekoli. Yesʉ mwamʉbwɨra athɨ: «Nyɨkwame!» Na Lawi mwimana n'ɨmʉkwama.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />Honyuma kw'aho, Yesʉ mwayalya ku kalyo mo nyʉmba ya Lawi. Bakarani bangɨ b'ekoli na bandɨ bakoli b'ebɨbɨ mobikala irya hagʉma na Yesʉ n'abɨga bʉwe, kʉshangwa bangɨ ba mo bandʉ bo balɨ ng'abo bo bagenda abamʉkwama. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />aBakangɨrɨtsya b'oMʉgomba b'omo kɨkembe ky'aBafarisayo babere bashʉnga ko Yesʉ alya hagʉma n'abandʉ abo, mobabʉtsya abɨga bʉwe bathɨ: «Bʉshana na ki oMʉkangɨrɨtsya enyu alya hagʉma n'abakarani b'ekoli n'abakoli b'ebɨbɨ?»<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />Yesʉ abere onvwa athyo, aho mwabwɨrabo athɨ: «Abatsibuhire bathalayire kʉ mʉshake, hewethuwe nɨ abo balwere basha. Nyithahikaga ɨbɨrɨkɨra abathʉnganene banyɨkwame, hewethuwe abakoli b'ebɨtsɨbʉ.»<verse eid="MRK 2:17" /></para>
  <para style="s">Yesʉ akangɨrɨtsya bʉshana n'iyima kalyo</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mat 9:14-17</ref>; <ref loc="LUK 5:33-39">Luk 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Kɨro kɨgʉma abɨga ba Yoani Mubatisya n'aBafarisayo bagenda abayima kalyo. Aho bandʉ bagʉma mobahikira Yesʉ n'ɨmʉbʉtsya bathɨ: «Bʉshana na ki abɨga ba Yoani Mubatisya n'abɨga b'aBafarisayo abanayima kalyo, hewethuwe abɨga bawe ɨbo ɨhɨ?»<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />Yesʉ mwashʉbɨtsyabo athɨ: «Abo bathalalɨkwa ko linye ly'obuheruki banganayima kalyo omuherukya akɨnalɨ hagʉma nabo? Ɨhɨ! Mo ndambi omuherukya akɨnalɨ hagʉma nabo bathangakotsya iyima kalyo. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Hewethuwe kwandabya bɨro omuherukya andabya athokibwa mo kathi kabo, nɨ mo bɨro ebyo mo bandayima kalyo.<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />«Hathalɨ mʉndʉ yo ʉnalandɨra kɨbandɨko kihya-kihya kʉ lʉkɨmba lwa kera. Amakola athyo, ekɨbandɨko kihya-kihya nɨkyaberenga olʉkɨmba lwa kera, n'erɨbereka lyalo nɨlyongereka kʉtsɨbʉ. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />Na kuthyo hathalɨ mʉndʉ yo unahira tifayi nyihya-nyihya mʉ bɨrega bya ngobi sikulire. Amakola athyo, etifayi nɨyaberenga ebɨrega, n'aho nɨahetsya etifayi n'ebɨrega kuthyo. Bʉshana n'ekyo abanahira etifayi nyihya-nyihya mʉ bɨrega bihya-bihya.»<verse eid="MRK 2:22" /></para>
  <para style="s">Yesʉ yo mʉkʉlʉ w'eSabato</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mat 12:1-8</ref>; <ref loc="LUK 6:1-5">Luk 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Kɨro kɨgʉma ky'<char style="w" lemma="Sabato">eSabato</char>, Yesʉ n'abɨga bʉwe bagenda abatsʉka mo mashwa w'engano. Abɨga bʉwe mobagenda nɨbanemʉtsa ebɨkʉmba by'engano<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">Soma Ɨbʉka Mʉgomba 23:26.</char></note>. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />Aho <char style="w" lemma="Abafarisayo">aBafarisayo</char> babere bashʉnga kw'ebyo, mobabwɨra Yesʉ bathɨ: «Lola! Bʉshana na ki abɨga bawe abakola ebyo <char style="w" lemma="Mɨgomba">oMʉgomba</char> ethʉ ahangire ɨkola ekɨro ky'<char style="w" lemma="Sabato">eSabato</char>?»<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />Yesʉ mwashʉbɨtsyabo athɨ: «Mʉthahera mwathasoma ebyo Tawiti akolaga ɨye n'abandʉ bʉwe babere bawɨra? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />Ndɨ mwɨngɨra mo Nyʉmba ya Gongo n'irya emikati yo yahererawa Gongo! Naho, nɨ abaheri basha bo babyaga bahamulirwe irya emikati eyo. Hewethuwe Tawiti mwalya n'ɨha abandʉ abo abyaga nabo. Ekɨnwa eki kyakolekaga mo mʉgʉlʉ Abiatari abyaga <char style="w" lemma="Muheri Mʉkʉlʉ">Muheri Mʉkʉlʉ</char>.»<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />Yesʉ mwashʉba bwɨrabo athɨ: «Ekɨro ky'<char style="w" lemma="Sabato">eSabato</char> kyahirawaho bʉshana n'omʉndʉ. Hewethuwe omʉndʉ athakomibawa bʉshana n'<char style="w" lemma="Sabato">eSabato</char> <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />Bʉshana n'ekyo, oMʉgala w'oMʉndʉ yo Mʉkʉlʉ w'eSabato.»<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">Yesʉ alamya mʉndʉ ekɨro ky'eSabato</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mat 12:9-14</ref>; <ref loc="LUK 6:6-11">Luk 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Yesʉ mwashʉbɨngɨra mo <char style="w" lemma="sinakoki">sinakoki</char>. N'omo sinakoki eyo mwabyaga mʉndʉ mʉgʉma wa kʉboko kulehemire. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Abandʉ babyagamo bagenda abayɨthegeretsya Yesʉ bʉshana balole nga alamya omʉndʉ oyo mo kɨro ky'<char style="w" lemma="sabato">eSabato</char>, babone ekyangaleka nibamusitaka.<verse eid="MRK 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 3:3" />Aho Yesʉ mwabwɨra ow'okʉboko kulehemire athɨ: «Wimana aha mo kathi k'abandʉ.» <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />Honyuma kw'aho mwabʉtsyabo athɨ: «Iki ky'oMʉgomba ethʉ athuhamulire thʉgende othʉkola mo kɨro ky'<char style="w" lemma="Sabato">eSabato</char>? N'ɨkola bɨbʉya kʉtse ɨkola ebɨbɨ? Ilamya mʉndʉ kʉtse imwitha?» Hewethuwe abandʉ abo mobayɨtsɨrɨra. <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />Yesʉ mwahanda kʉbo kw'amesho niatsibukire, na abyaga na bulige kʉshangwa mobatsibuhya emɨthɨma yabo. Mwabwɨra omʉndʉ oyo athɨ: «Lambʉla okʉboko kwawe.» Mwalambʉlako, nako mokwalama.<verse eid="MRK 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 3:6" />Aho n'aho <char style="w" lemma="Bafarisayo">aBafarisayo</char> mobathoka mo <char style="w" lemma="Sinakoki">Sinakoki</char> n'ɨya hindana n'abandʉ ba Herote bʉshana bakomye mbitha y'itha Yesʉ.<verse eid="MRK 3:6" /></para>
  <para style="s">Muhindano mʉnene wa bandʉ ahikira Yesʉ</para>
  <para style="r">(<ref loc="MAT 4:25">Mat 4:25</ref>; <ref loc="MAT 12:15-16">12:15-16</ref>; <ref loc="LUK 6:17-19">Luk 6:17-19</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Yesʉ n'<char style="w" lemma="abɨga">abɨga</char> bʉwe mobayɨhɨgʉla n'ɨya emʉsɨke w'engetsɨ y'iNgalilaya. Muhindano mʉnene wa bandʉ mobamʉkwama. Abandʉ abo bagenda abathoka mo kɨhʉgo ky'iNgalilaya na ky'iYuteya, <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />na mo muyi w'ɨYerʉsalemʉ, na mo kɨhʉgo ky'Indumea, na mo bɨhʉgo bya ko lʉndɨ lʉnda lw'olwitsi lw'eYorotani na ko mʉnda w'omuyi w'iTiro na w'iSitona. Omuhindano mʉnene w'abandʉ oyo, mwahikira Yesʉ kʉshangwa abyaga niamalire ɨonvwa emyatsɨ y'ebyoshi agenda akola.<verse eid="MRK 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 3:9" />Yesʉ mwabwɨra abɨga bʉwe bamʉshondetsye bwatho bʉke nɨmo omuhindano athangamʉyɨndɨrɨtsya. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />Bandʉ bangɨ bo babyaga nibamalire inubibwa n'amakoni, bagenda abayɨhʉtha bʉshana bayakole kʉ Yesʉ, kʉshangwa abyaga niamalamya bandʉ bangɨ. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Abo babyagako emɨtsɨmʉ mɨbɨ babere bashʉnga Yesʉ, mobawa embere sɨwe nɨabahambala bathɨ: «Ɨwe ʉlɨ Mʉgala wa Gongo.» <verse eid="MRK 3:11" /><verse number="12" style="v" sid="MRK 3:12" />Hewethuwe Yesʉ mwakemera emɨtsɨmʉ eyo yo kʉtsɨbʉ ɨthanegenaga ɨye nga nɨ ndɨ.<verse eid="MRK 3:12" /></para>
  <para style="s">Yesʉ ashombola bathʉmwa ikumi na babɨrɨ</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mat 10:1-4</ref>; <ref loc="LUK 6:12-16">Luk 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Honyuma kw'aho, Yesʉ mwɨrʉkɨra ko kɨthwa. Mwabɨrɨkɨra bandʉ abo abyaga ashashire yo wene, n'abandʉ abo mobamuhikira. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />Mwashombola mʉbo mo ikumi na babɨrɨ, abo alʉkagamo <char style="w" lemma="bathʉmwa">bathʉmwa</char>, bʉshana bikale hagʉma naye na bʉshana athʉmebo bayafʉle eNgʉlʉ Mbʉya. <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />Na mwahabo maka w'ɨbɨnga emɨtsɨmʉ mɨbɨ. <verse eid="MRK 3:15" /><verse number="16" style="v" sid="MRK 3:16" />Ano wo matsɨna w'abandʉ ikumi na babɨrɨ ashombolaga : Simoni yo Yesʉ alʉkagamo Petero. <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />Yakobo na Yoani mʉgala wabo, ababɨrɨ babyaga bagala ba Sebetayo. Yesʉ mwahabo ɨtsɨna lya Boanereke, n'ɨnegena mbʉ «Bagala ba muhindo wa buthuku», <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />Na Ndereya na Filipo, na Barɨtolomayo, na Matayo, na Tomasɨ, na Yakobo mʉgala wa Alʉfayo, na Tatei, na Simoni wa mo kɨkembe ky'abaselote <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />na Yuta Isikariote oyo wahotheraga Yesʉ.<verse eid="MRK 3:19" /></para>
  <para style="s">Yesʉ atsɨmbwa nga mʉsɨre</para>
  <para style="r">(<ref loc="MAT 12:24-32">Mat 12:24-32</ref>; <ref loc="LUK 11:15-23">Luk 11:15-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Honyuma kw'aho, Yesʉ mwashʉba eka. Muhindano mʉnene wa bandʉ mwashʉba hindana ihika ko kɨka Yesʉ n'abɨga bʉwe mobathabona ndambi y'erirya. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Abandʉ b'omo lʉganda lʉwe babere bonvwa ebɨnwa ebyo, mobayamwenda kʉshangwa mobanegena bathɨ asirehire.<verse eid="MRK 3:21" /></para>
  <para style="s">Yesʉ atsɨmbwa nga Belesebuli</para>
  <para style="r">(<ref loc="MAT 12:22-32">Mat 12:22-32</ref>; <ref loc="LUK 11:14-23">Luk 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />Bakangɨrɨtsya b'oMʉgomba bo bandagalaga ɨthoka ɨYerʉsalemʉ, bagenda abanegena bathɨ: «Alɨko Belisebuli<note caller="+" style="f"><char style="fr" closed="false">3:22 </char><char style="ft" closed="false">Belisebuli: Ni mʉtsɨmʉ mʉkʉlʉ w'eyɨndɨ mɨtsɨmʉ mɨbɨ yoshi.</char></note>.» Na bandɨ ba mʉbo mobanegena bathɨ: «Nɨ mʉkʉlʉ w'emɨtsɨmʉ mɨbɨ yo ʉnamʉha amaka w'erɨbɨnga emɨtsɨmʉ mɨbɨ.» <verse eid="MRK 3:22" /><verse number="23" style="v" sid="MRK 3:23" />Aho Yesʉ mwabɨrɨkɨra aBakangɨrɨtsya b'oMʉgomba abo n'ɨthanga ɨbwɨrabo mo mishinga athɨ: «Sitani angakotsya athɨ ɨbɨnga Sitani? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />Abandʉ b'obwamɨ bʉgʉma bamagabana, obwamɨ obo nɨbwathera. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />Na bandʉ ba mʉ lʉganda lʉgʉma nabo bamalwa ɨbo kw'ɨbo, olʉganda olo ni lwahimbukala. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Aho Sitani amayɨlwɨsa yowene, obwamɨ bʉwe nɨbwamagabana, athangashʉbayɨra kagala, hewethuwe nɨbwashambʉkala.<verse eid="MRK 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27" />«Mʉndʉ athangakostya ɨngɨra mʉ nyʉmba ya mʉndʉ wa kagala n'ɨshamʉla ebɨndʉ bɨwe athathangire amugalinga. Hewethuwe anabya amamala imugalinga aho angakotsya ɨshamʉla ebɨndʉ bɨwe byoshi.<verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />«Kwenene enyɨbabwɨra nyɨthɨ, abandʉ bandaganyɨrwa ebɨtsɨbʉ byabo n'erɨhatsya kʉ Gongo lyabo lyoshi. <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />Hewethuwe omʉndʉ yo uhangya oMʉthɨma Mwerʉ, athɨndaganyɨrwe n'ahake, kʉshangwa ebɨtsɨbʉ ebyo byandamubyako ihika kera na kera.» <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />Yesʉ mwabwɨrabo athyo kʉshangwa mobanegena bathɨ: «Alɨko mʉtsɨmʉ mʉbɨ.»<verse eid="MRK 3:30" /></para>
  <para style="s">Ɨndɨ yo malɨ na bahɨ bo bagala bethʉ?</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mat 12:46-50</ref>; <ref loc="LUK 8:19-21">Luk 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Bagala babo Yesʉ na nyinya ʉwe mobahika, mobimana embʉga, mobathʉma mʉndʉ ayamʉbɨrɨkɨre. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Mo nyʉmba eyo mwabyaga muhindano mʉnene wa bandʉ, nibikere, nibathimbire kʉ Yesʉ. Aho mobamʉbwɨra bathɨ: «Lola, nyoko na bagala benyu balɨ embʉga, abakushondya.»<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />Yesʉ mwashʉbɨtsyabo athɨ: «Ɨndɨ yo malɨ na bahe bo bagala bethʉ?» <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />Honyuma kw'aho Yesʉ mwathimbya kw'abo babyaga bamuthimbireko kw'amesho n'ɨnegena athɨ: «Abo bikere hano aba, bo malɨ na bagala bethʉ. <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Kʉshangwa omʉndʉ woshi-woshi yo ʉkola erɨshasha lya Gongo, oyo yo mʉgala ethʉ, na mwalɨ wethʉ na malɨ.»<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">Mushinga wa muheri wa mbʉtho</para>
  <para style="r">(<ref loc="MAT 13:1-9">Mat 13:1-9</ref>; <ref loc="LUK 8:4-8">Luk 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />Honyuma kw'aho, Yesʉ mwashʉbaya emʉsɨke w'engetsɨ y'iNgalilaya alɨ akangɨrɨtsya abandʉ. Muhindano mʉnene wa bandʉ mwamuthimbako. Bʉshana n'ekyo, Yesʉ mwɨngɨra mʉ bwatho bʉgʉma bwabyaga bwimene ko ngetsɨ kw'aho na mwikala mʉbo. Abandʉ mobimana ko kɨthaka, emʉsɨke w'engetsɨ. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />Yesʉ agenda akangɨrɨtsyabo bɨnwa bɨngɨ mu mishinga. Mo makangɨrɨtsya ʉwe mwabwɨrabo athɨ: <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />«Mʉhʉlɨkɨrɨtsye! Kwabyaga muhingi mʉgʉma mwaya hera mbʉtho. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />Abere anemʉhera, mbʉtho ngʉma mosathogongera emʉsɨke w'enzɨra. Ebɨronge mobyahika n'iryatho. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Esɨndɨ mbʉtho mosathogera handʉ halɨ mabwe, ahathalɨ bʉthaka bʉngɨ. Esombʉtho etho mosalasha tsʉba kʉshangwa hathabyaga bʉthaka bʉngɨ. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />Hewethuwe elɨshɨ lyabere lyakola, mosashashʉka na mosʉma kʉshangwa sɨthabyaga na mirihi mɨre-mɨre. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Sɨndɨ mbʉtho mosathogongera mu kathi ka mɨshakɨ. Emɨshakɨ eyo yabere yalasha, moyayɨndɨrɨtsya esombʉtho, ihika ko kɨka mosɨthaheka biguma. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Hewethuwe esɨndɨ mbʉtho ɨtho mosathogongera kʉ bʉthaka bukwirire. Emyaka moyalasha, moyakʉla n'ɨheka biguma: ngʉma mosaheka mbulu makumi ashathʉ ashathʉ, sɨndɨ kɨrathʉ kɨrathʉ na sɨndɨ, mbulu igana igana.»<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />Honyuma kw'aho Yesʉ mwabwɨrabo athɨ: «Yo uwithe mathwi w'ɨonvwa onvwe!»<verse eid="MRK 4:9" /></para>
  <para style="s">Ekyalekaga Yesʉ nɨagenda anegena mu mishinga</para>
  <para style="r">(<ref loc="MAT 13:10-17">Mat 13:10-17</ref>; <ref loc="LUK 8:9-10">Luk 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Yesʉ abere ahera yowene, aBathʉmwa bʉwe ikumi na babɨrɨ hagʉma n'abandʉ babyaga bamuthimbireko, mobamʉbʉtsya akumbulirebo emishinga eyo. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Yesʉ mwashʉbɨtsyabo athɨ: «Imwe momwahabwa ɨmɨnya olʉfʉmɨ lw'oBwamɨ bwa Gongo, hewethuwe abandɨ bo bathalɨ mo kɨkembe kyenyu, ɨbo, enyɨnegena nabo ebɨnwa byoshi ɨtsʉkɨra emishinga, <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />bʉshana</para>
  <para style="q1" vid="MRK 4:12">“ɨlola bagende abalola,</para>
  <para style="q1" vid="MRK 4:12">hewethuwe bathamɨnyaga,</para>
  <para style="q1" vid="MRK 4:12">ɨovnwa bagende abonvwa,</para>
  <para style="q1" vid="MRK 4:12">hewethuwe bathabyaga na bwenge,</para>
  <para style="q1" vid="MRK 4:12">bʉshana bathabonaga bwenge bw'ɨbɨndʉkɨra Gongo</para>
  <para style="q1" vid="MRK 4:12">bʉshana baganyɨrwe.”»<verse eid="MRK 4:12" /></para>
  <para style="s">Yesʉ akumbulira omushinga w'omuheri w'embʉtho</para>
  <para style="r">(<ref loc="MAT 13:18-23">Mat 13:18-23</ref>; <ref loc="LUK 8:11-15">Luk 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Yesʉ mwashʉba bwɨrabo athɨ: «Mwamabya muthonvwire omushinga oyu, mʉthɨ ko mwangonvwa eyɨndɨ mishinga? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Embʉtho yo muheri aheraga, nɨ eKɨnwa kya Gongo. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Esombʉtho so sathogongeraga emʉsɨke w'enzɨra, nɨ abandʉ bo banonvwa eKɨnwa kya Gongo, hewethuwe aho n'aho Sitani niyahika niathokya eKɨnwa kɨthaherwa mo mɨthɨma yabo. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Esombʉtho so sathogongeraga ko mabwe, sishoshekanibwe n'abandʉ bo banonvwa eKɨnwa kya Gongo, aho n'aho nɨbangɨrɨrakyo mo lʉmogo. <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />Hewethuwe kɨthalɨ ekinashika mo mɨthɨma yabo ng'emirihi ko inashika mo kɨthaka, abanakwamakyo kʉ kathambi kake. Na mo ndambi amalɨgo n'obwagali ebinabya byahikirabo bʉshana n'eKɨnwa kya Gongo ekyo, aho n'aho nibalika olwɨkɨrɨtsyo lwabo. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Esombʉtho so sathogongeraga mo mɨshakɨ sishoshekanibwe n'abandʉ bo banonvwa eKɨnwa kya Gongo, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />hewethuwe emɨnʉbo ya hano ishi, erɨlengwako ly'obushoki, n'eyɨndɨ mɨhanda y'erɨlengwako inabya yahikirabo, nɨbyayɨndɨrɨtsya eKɨnwa ekyo, nakyo nɨkɨthɨheke biguma. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />N'esombʉtho sathogongeraga ko bʉthaka bʉlɨmo bʉyɨnʉ ɨtho, sishoshekanibwe na bandʉ bo banonvwa eKɨnwa kya Gongo n'ikokyakyo, ihika ko kɨka nɨbabʉtha biguma. Bagʉma nɨbabʉtha biguma makumi ashathʉ ashathʉ, na bandɨ kɨrathʉ kɨrathʉ na bandɨ igana igana.»<verse eid="MRK 4:20" /></para>
  <para style="s">Mushinga wa tara</para>
  <para style="r">(<ref loc="LUK 8:16-18">Luk 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />Honyuma kw'aho Yesʉ mwabwɨrabo athɨ: «Omʉndʉ anganaletha etara honyuma kw'aho nɨashwɨkaro kɨthonga kʉtse niahiraro mwisha-ngɨngo? Ɨhɨ! ndɨ eyinahirwa kw'ihango! <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />Kʉshangwa hathalɨ kɨndʉ kibishire kyo kithindabishulwe kʉtse hathalɨ lʉfʉmɨ lo lʉthɨndamɨnyɨkale. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Yo uwithe mathwi w'ɨonvwa onvwe!»<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />Yesʉ mwashʉbabwɨrabo athɨ: «Mʉhʉlɨkɨrɨtsye kʉbʉya ebɨnwa enyɨbabwɨra! Olʉlengo omʉnalengeramo abandɨ, lona lʉlengo Gongo andabalengeramo, na mwandongererwa kʉtsɨbʉ. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />Kʉshangwa yo uwithe kʉ kɨndʉ anahabwa kɨndɨ, hewethuwe yo uthawithe kʉ kɨndʉ, andanyagʉlwa n'akake awitheko.»<verse eid="MRK 4:25" /></para>
  <para style="s">Mushinga w'erɨlasha ly'embʉtho</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Yesʉ mwanegena athɨ: «oBwamɨ bwa Gongo bwangalinganibwa na mʉndʉ mʉgʉma yo waheraga embʉtho mw'ɨshwa lɨwe. <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />Embʉtho eyɨnalasha n'ɨkʉla kɨro na mwɨshɨ, omʉndʉ oyo abyetho kʉtse abye mesho athamɨnya ko yɨlasha n'ɨkʉla. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Obʉthaka bobwene bobunalashya emyaka. Emyaka ɨnathanga ihulukya bɨthɨ, honyuma kw'aho niyahulukya bɨkʉmba, nabyo nibyaheka mbulu. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />Mo ndambi esombulu sɨrɨ mo bɨkʉmba samera, omʉndʉ nɨagesharo, kʉshangwa nɨ bɨro by'erɨgesha.»<verse eid="MRK 4:29" /></para>
  <para style="s">Mushinga wa mbulu ya haratali</para>
  <para style="r">(<ref loc="MAT 13:31-32">Mat 13:31-32</ref>; <ref loc="LUK 13:18-19">Luk 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Yesʉ mwashʉba negena athɨ: «Thwangalingania oBwamɨ bwa Gongo na ki? Kʉtse thwangalinganiabo na mushinga ohɨ? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />Obwamɨ obo bwangalinganibwa na kambulu ka haratali. Akambulu ako ko kake ko sɨndɨ mbulu soshi sosɨnaherwa mo bʉthaka hano ishi. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />Hewethuwe akanabya kamaherwa, nɨkalasha nikabya mʉthɨ mʉnene kʉtsɨbʉ kʉlenga emyaka yoshi. Akanathahʉla mɨthahɨ mɨnene-mɨnene ihika ko kɨka ebɨronge by'omo kyanya nibyahimba sonyʉthʉ sabyo ko mɨthahɨ yago.»<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />Yesʉ agenda akangɨrɨtsya abandʉ mʉ mishinga mɨngɨ eyɨrɨ ng'eyi, ɨkwamana na nga ko bangakotsya ɨonvwa kʉbʉya. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />Hathalɨ kɨnwa abwɨraga abandʉ ɨthalɨ mo mishinga. Hewethuwe abere alɨ hagʉma n'abɨga bʉwe ɨbo bene, agenda akumbulirabo ebɨnwa byoshi.<verse eid="MRK 4:34" /></para>
  <para style="s">Yesʉ abombetsya emibimbi</para>
  <para style="r">(<ref loc="MAT 8:18">Mat 8:18</ref>,<ref loc="MAT 8:23-27">23-27</ref>; <ref loc="LUK 8:22-25">Luk 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Ekɨro ekyo, bwabere bwagoroba, Yesʉ mwabwɨra abɨga bʉwe athɨ: «Thʉshabʉkɨre ko ʉndɨ mwishirya w'engetsɨ.»<verse eid="MRK 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 4:36" />Aho abɨga mobalaga omuhindano w'abandʉ, mobɨngɨra mo bwatho bo Yesʉ abyagamo n'ɨgenda hagʉma naye. Na wandɨ matho mwamʉherekeretsya. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Kɨhʉnga kɨnene mokyabya ko ngetsɨ. Emibimbi moyayɨbanda ko bwatho ihika ko kɨka mobwathanga iotsulamo metsi. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />Yesʉ abyaga nɨalɨ mo bwatho mw'enyuma, nɨalɨtho nɨashegemere ko mʉshegemero. Abɨga bʉwe mobamubukya n'ɨmʉbwɨra bathɨ: «Mʉkangɨrɨtsya, bithakubwire kɨndʉ ɨlola kw'ithwe bano thwashenda?»<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />Yesʉ mwabʉka, mwakemera ekɨhʉnga ekyo n'ɨbwɨra engetsɨ athɨ: «Tsɨra! Yɨbombeke!»</para>
  <para style="p" vid="MRK 4:39">Aho ekɨhʉnga mokyatsɨra n'engetsɨ moyabombera. <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />Honyuma kw'aho, Yesʉ mwabwɨra abɨga athɨ: «Bʉshana na ki mwubahire kʉtsɨbʉ? Ihika lɨno muthanetsi mwabya na lwɨkɨrɨtsyo?»<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />Abɨga abo mobʉbaha kʉtsɨbʉ, nabo mobathanga ibutsania bathɨ: «Oyu nɨ mʉndʉ ki, yo emibimbi n'engetsɨ ebimushikya?»<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">Yesʉ alamya mʉndʉ alɨko mɨtsɨmʉ mɨbɨ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Honyuma kw'aho Yesʉ n'abɨga bʉwe mobahika ko ʉndɨ mʉnda w'engetsɨ y'iNgalilaya mo kɨhʉgo ky'aBangerasi.<verse eid="MRK 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 5:2" />Yesʉ abere anemʉthoka mo bwatho, aho n'aho mʉndʉ mʉgʉma yo wabyagako mʉtsɨmʉ mʉbɨ mwathoka ko masɨnda bʉshana n'iyahindana naye. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />Omʉndʉ oyu, ko masɨnda ko kwabyaga kowe. Na kandɨ hathabyaga mʉndʉ yo wangakotsitsye ɨshʉba mʉmɨna, ibye na mʉ bʉhʉlʉla. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />Ngendo nyɨngɨ, abandʉ bagenda abamɨna ebɨshando bɨwe mʉ byʉma n'amaboko mʉ bʉhʉlʉla, hewethuwe agenda atsitsanga obʉhʉlʉla obo n'itsitsanga ebɨkono by'ebyʉma ebyo. Hathabyaga mʉndʉ n'omʉgʉma yo wabyaga na kagala k'imwikikania. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Ko bʉlɨ kathambi, kɨro na mwɨshɨ agenda atsʉka-tsʉka ko masɨnda na ko bɨthwa, alɨahambala n'ɨyɨbabatsya-babatsya mu mabwe.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />Abere ashʉnga Yesʉ yo hale, mwagenda tsʉba ɨya mʉfʉkamɨra. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />Mwahambala mʉ mʉlenge mʉnene athɨ: «Yesʉ, Mʉgala wa Gongo yo ʉlɨ mo lʉbʉla, unyishondya ko ki? Enyɨkʉshaba kw'ɨtsɨna lya Gongo, uthanyinubyaga!» <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />Anegenaga athyo kʉshangwa Yesʉ agenda amʉhamʉla athɨ: «Ɨwe mʉtsɨmʉ mʉbɨ, thoka ko mʉndʉ oyu!» <verse eid="MRK 5:8" /><verse number="9" style="v" sid="MRK 5:9" />Aho Yesʉ mwamʉbʉtsya athɨ: «Erɨtsɨna lyawe ɨwe ndɨ?» Naye mwamʉshʉbɨtsya athɨ: «Erɨtsɨna lyaye nɨ “Kɨkembe” kʉshangwa thʉlɨ bangɨ.» <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />Omʉndʉ oyo mwatsitsinia ɨshaba athɨ Yesʉ athathokaya emɨtsɨmʉ mɨbɨ mo kɨhʉgo ekyo.<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />Na hofɨ n'ekɨthwa habyaga kihyo kɨnene kya ngʉlʉbe sosagenda esishondya kalyo. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />Aho emɨtsɨmʉ mɨbɨ moyashaba Yesʉ yɨthɨ: «Thʉthʉme mo so ngʉlʉbe sirira thwɨngɨre mʉtho.» <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />Yesʉ mwatsɨɨraro. Aho, emɨtsɨmʉ mɨbɨ eyo moyathoka ko mʉndʉ oyo n'ɨngɨra mo so ngʉlʉbe. Ekihyo kyoshi ky'esongʉlʉbe mosahʉrʉmʉka tsʉba ko kɨthwa n'ɨthogongera mo ngetsɨ. Esongʉlʉbe etho sabyaga hofɨ bɨhʉmbɨ bɨbɨrɨ, na mosashenda mo ngetsɨ.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />Abalishya b'esongʉlʉbe etho mobashaga, n'ɨyafʉla omwatsɨ mo muyi na mo mɨrongo. Abandʉ mobahika bʉshana bashʉnge ko byo bithabya. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Babere bahika ho Yesʉ abyaga, mobashʉnga oyo wabyagako ekihyo ky'emɨtsɨmʉ mɨbɨ n'ikere, niambithe lʉkɨmba niamalire ɨlama. Aho, abandʉ abo mobʉbaha. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Bo bashʉngaga ebyo byahikiraga omʉndʉ yo wabyagako emɨtsɨmʉ mɨbɨ, n'ebyo byahikiraga esongʉlʉbe, mobasɨmolera abandɨ bw'emyatsɨ eyo. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />Bʉshana n'ekyo mobathanga ɨshaba Yesʉ yo kʉtsɨbʉ athoke mo kɨhʉgo kyabo. <verse eid="MRK 5:17" /><verse number="18" style="v" sid="MRK 5:18" />Yesʉ abere analɨ ashambɨra mo bwatho, omʉndʉ yo wabyagako emɨtsɨmʉ mɨbɨ mwamʉshaba kʉtsɨbʉ athɨ agende hagʉma naye. <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />Yesʉ mwathamʉtsɨɨra, hewethuwe mwamʉbwɨra athɨ: «Genda ewawe eyɨrɨ olʉganda lwawe, na ʉsɨmolerebo ebɨnwa Nyinya-kowenyu athakʉkolera na kw'athakʉfwɨra shashi.» <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />Ko nduli, omʉndʉ oyo mwayɨgendera, mwathanga ɨganʉlɨra mo kɨhʉgo ky'eMiyi Ikumi ebɨnwa byoshi Yesʉ athamʉkolera. N'abandʉ boshi bo bamwonvwaga, mobashweka kʉtsɨbʉ.<verse eid="MRK 5:20" /></para>
  <para style="s">Yesʉ alamya mʉkatsɨ n'ilubukya mwalɨ wa Yairo</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mat 9:18-26</ref>; <ref loc="LUK 8:40-56">Luk 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Yesʉ mwashabʉkɨra ko ʉndɨ mwishirya w'engetsɨ y'iNgalilaya mʉ bwatho. Abere animene emʉsɨke w'engetsɨ, bandʉ bangɨ mobahindana hofɨ naye. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Aho mʉgʉma w'oko bakʉlʉ b'esinakoki yo wagenda ahʉlwamo Yairo, mwahika aho. Abere ashʉnga Yesʉ mwafʉkama embere sɨwe. <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />Mwashaba Yesʉ yo kʉtsɨbʉ nɨanegena athɨ: «mwalɨ waye mʉlere athakɨrɨko kalamo. Enyɨkʉshaba, hika umuhireko eminwe, bʉshana alame na ashʉbe byaho!»<verse eid="MRK 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24" />Aho Yesʉ mwagenda naye. Bandʉ bangɨ mobakwama Yesʉ nɨabamʉyɨndɨrɨtsya.<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />Na mo kathi k'abandʉ abo mwabyaga mʉkatsɨ mʉgʉma yo wabyaga nɨamamala myaka ikumi n'ibiri nɨanalwere bukoni bw'ɨthoka mʉsasɨ. <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />Omʉkatsɨ oyo mwagalwa kʉtsɨbʉ mw'ɨgendera bashake bangɨ. Namo byanabyaga bithyo, mwahetsya ebyoshi abyaga awitheko na mwathalama. Hewethuwe mwaserwa kʉtsɨbʉ. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />Omʉkatsɨ oyo mwonvwa omwatsɨ wa Yesʉ. Mwahika n'ɨngɨra mo muhindano w'abandʉ enyuma wa Yesʉ n'ɨkola ko lʉkɨmba lʉwe, <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />kʉshangwa agenda ayinegenia athɨ: «Nyamakola ko lʉkɨmba lwa Yesʉ nɨ nyalama.» <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />Abere akola ko lʉkɨmba lwa Yesʉ, aho n'aho omʉsasɨ mwathashʉba thoka mo mʉbɨrɨ ʉwe. Naye mwayonvwa kw'amalama.<verse eid="MRK 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 5:30" />Aho n'aho Yesʉ mwamɨnya ko akagala kamʉthokamo. Mwabɨndʉka mo kathi k'omuhindano n'ɨbʉtsya athɨ: «Nɨ ndɨ yo ʉthakola ko lʉkɨmba lwaye?»<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />Abɨga bʉwe mobamʉshʉbɨtsya bathɨ: «Shʉnga kw'abandʉ abakʉyɨndɨrɨtsya! Kʉthɨ ko ʉbʉtsya ʉthɨ nɨ ndɨ yo wamakʉkolako?»<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />Hewethuwe Yesʉ mwathimbya amesho ko bandʉ babyaga bamuthimbireko, bʉshana alole nga nɨ ndɨ yo wamakola ebyo. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />Omʉkatsɨ oyo mwʉbaha na mwathanga ithithimana, kʉshangwa mwamɨnya ebyoshi bithamuhikira. Aho mwayɨgʉsha mo bɨshando bya Yesʉ n'ɨmʉbwɨra ekwenene yoshi. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Yesʉ mwamʉbwɨra athɨ: «Mwalɨ waye, olwɨkɨrɨtsyo lwawe lwamakulamya. Ʉgende mʉ bʉholo, obukoni bwawe bwamalama!»<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />Yesʉ abere akɨnalɨ anegena, bagendi mobahika ɨthoka ewa Yairo omʉkʉlʉ w'<char style="w" lemma="sinakoki">esinakoki</char>. Abagendi abo mobabwɨra Yairo bathɨ: «Mwalɨ wawe athakɨrɨho. Bʉshana na ki ʉkɨne mʉkendetsya oMʉkangɨrɨtsya?» <verse eid="MRK 5:35" /><verse number="36" style="v" sid="MRK 5:36" />Hewethuwe Yesʉ mwathakwama ebɨnwa byabo, mwabwɨra omʉkʉlʉ oyo athɨ: «Ʉthʉbahaga, wɨkɨrɨtsye kuroshi.» <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />Yesʉ mwathatsɨga kubye mʉndʉ w'ɨmʉherekeretsya, athalɨ Petero, Yakobo, na Yoani wa mʉ nda ngʉma na Yakobo. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Babere bahika ho nyʉmba y'omʉkʉlʉ Yairo, Yesʉ mweya nɨ halɨ bʉrʉnga, abandʉ bagenda abalɨra nɨahambala kʉtsɨbʉ. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Mwɨngɨra mo nyʉmba n'ɨbwɨra abandʉ athɨ: «Bʉshana na ki omʉletha bʉrʉnga n'ɨrɨra? Omwana oyu athafwire, hewethuwe alɨtho!»<verse eid="MRK 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40" />Abandʉ abo mobathanga ɨmʉshekeretsya. Hewethuwe Yesʉ mwahʉlʉkɨtsya abandʉ boshi bw'embʉga, mwatsɨmba ishe na nyinya bw'omwana n'abɨga bʉwe bashathʉ. Mwɨngɨra mo kɨshenge kyo kyabyagamo ekinda ky'omwana. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />Mwatsɨmba omwana ko kʉboko n'ɨmʉbwɨra athɨ: «Talita kumu!» n'ɨnegena mbʉ: «Mʉthasha, enyɨkʉbwɨra wimana!»<verse eid="MRK 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42" />Aho n'aho, omʉthasha oyo mwimana na mwathanga ɨgenda. Abyaga na lʉgero lwa myaka ikumi n'ibiri. Abandʉ mobashweka kʉtsɨbʉ babere bashʉnga ekɨnwa ekyo. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Hewethuwe Yesʉ mwahangɨrabo kʉtsɨbʉ bathabwɨraga mʉndʉ woshi woshi ekɨnwa kyakolekaga. Honyuma kw'aho, mwabwɨrabo athɨ bahe omwana oyo yo kalyo.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">Abandʉ b'iNasareti abathɨnda Yesʉ</para>
  <para style="r">(<ref loc="MAT 13:53-58">Mat 13:53-58</ref>; <ref loc="LUK 4:16-30">Luk 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Yesʉ mwathoka eyo, mwaya mo muyi ɨshʉkɨragamo, n'abɨga bʉwe mobamʉkwama. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Ekɨro ky'<char style="w" lemma="Sabato">eSabato</char> kyabere kyahika, mwathanga ɨkangɨrɨtsya mo <char style="w" lemma="sinakoki">sinakoki</char>. Bangɨ mo bo bagenda abamʉhʉlɨkɨrɨtsya mobashweka kʉtsɨbʉ n'ibutsania bathɨ: «Oyu amathokya ebɨnwa byoshi ebi byo hayi? Nɨ bwenge mʉhanda ki obo ahabawa, ihika ko kɨka ky'ɨkola bɨthɨko-thɨko bɨrɨnga ebi? <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />Oyu ndɨ nɨ omʉsapate, Mʉgala wa Marɨa! Na mʉgalabo Yakobo, na Yose, na Yuta na Simoni! Na balɨ babo ndɨ thunikere nabo kʉno!» Na bʉshana n'ekyo mobathamwɨkɨrɨtsya. <verse eid="MRK 6:3" /><verse number="4" style="v" sid="MRK 6:4" />Nɨmo Yesʉ abwɨrabo athɨ: «<char style="w" lemma="Mʉmɨnyeretsɨ">Omʉmɨnyeretsɨ</char> anashikibwa ahoshi, hewethuwe athalɨ anashikibwa kowabo, mo kathi ka bagala babo na mo kathi k'olʉganda lʉwe.» <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />Bʉshana n'ekyo, Yesʉ mwathakola iNasareti yo kɨthɨko-thɨko n'ekɨgʉma, ɨthalɨ erihira eminwe kʉ bakoni bake n'ilamyabo. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Naye mwashweka kʉtsɨbʉ bʉshana n'obʉthɨkɨrɨtsya bwabo.</para>
  <para style="s" vid="MRK 6:6">Yesʉ athʉma abɨga ikumi na babɨrɨ</para>
  <para style="r" vid="MRK 6:6">(<ref loc="MAT 10:5-15">Mat 10:5-15</ref>; <ref loc="LUK 9:1-6">Luk 9:1-6</ref>)</para>
  <para style="p" vid="MRK 6:6">Honyuma kw'aho Yesʉ agenda athimba-thimba mo mɨrongo ya mo ndambɨ-ndambɨ w'omuyi w'iNasareti alɨ akangɨrɨtsya abandʉ. <verse eid="MRK 6:6" /><verse number="7" style="v" sid="MRK 6:7" />Mwabɨrɨkɨra abɨga bʉwe ikumi na babɨrɨ. Mwathanga ɨthʉmabo babɨrɨ babɨrɨ n'ɨhabo maka w'ɨbɨnga emɨtsɨmʉ mɨbɨ. <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />Yesʉ mwahamʉlabo athɨ: «Mʉthahekaga kɨndʉ kyoshi-kyoshi mo lʉgendo lwenyu, ɨthalɨ kɨkoma kuroshi. Mʉthahekaga mʉlamo kʉtse shaho, kʉtse faranga mo mɨfʉko enyu. <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />Mwambale bɨrato, hewethuwe mʉthambalaga koti ibiri ibiri.» <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Mwashʉbabwɨrabo athɨ: «Na mwamakokibwa mʉ nyʉmba nyɨrebe, mubye omo ihika ko kɨro mwandathoka mo muyi oyo. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />Na bandʉ ba mʉ mʉrongo mʉlebe bamathɨnda ibakokya n'ɨbahʉlɨkɨrɨtsya, mʉthokeko na mʉkʉngʉthe oluthuthu lwa ko bɨshando bwenyu<note caller="+" style="f"><char style="fr" closed="false">6:11 </char><char style="fq" closed="false">mʉkʉngʉthe oluthuthu: </char><char style="ft" closed="false">Soma Luk 10:1; Mɨkolano13:51 na 18:6: N'ɨnegena mbʉ yo ʉthakʉngʉtha ebɨshando bɨwe athakɨhwere abo athakʉngʉthɨra bo kɨndʉ. </char><char style="fq" closed="false">butimo</char><char style="ft" closed="false">Mat 8:4; 10:18; Mar 1:44; 13:9; Luk 5:14.</char></note>. Ekɨnwa eki kyabya butimo kw'ɨbo.»<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />Aho abɨga mobahongoka, mobagenda abakangɨrɨtsya abandʉ mbʉ babɨndʉke bathoke mo bɨtsɨbʉ byabo. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />Mobagenda ababɨnga emɨtsɨmʉ mɨbɨ mɨngɨ, na mobahaka bakoni bangɨ bo mafʉtha n'ilamyabo.<verse eid="MRK 6:13" /></para>
  <para style="s">Herote ɨthɨsa Yoani Mubatisya</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mat 14:1-12</ref>; <ref loc="LUK 9:7-9">Luk 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />oMwamɨ Herote mwonvwa omwatsɨ wa Yesʉ, kʉshangwa erɨtsɨna lɨwe lyabyaga nilyayire ngʉlʉ. Bandʉ bagʉma bagenda abanegena bathɨ: «Oyu nɨ Yoani Mubatisya yo walubukire! Kyo kɨreka niabya na maka w'ɨkola bɨthɨko-thɨko.» <verse eid="MRK 6:14" /><verse number="15" style="v" sid="MRK 6:15" />Hewethuwe abandɨ bagenda abanegena bathɨ: «Oyu nɨ <char style="w" lemma="mʉmɨnyeretsɨ">mʉmɨnyeretsɨ</char> Elia.» Abandɨ bagenda abanegena bathɨ: «Ɨye nɨ mʉmɨnyeretsɨ nga mʉgʉma wa ko bamɨnyeretsɨ ba kera.»<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />Hewethuwe Herote abere onvwa omwatsɨ oyo mwanegena athɨ: «Nɨ Yoani Mubatisya yo nyahamʉlaga nyɨthɨ bamʉtseko omuthwe yo wamalubuka!» <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />Kʉshangwa nɨ Herote yowene-wene yo wahamʉlaga athɨ Yoani atsɨmbwe na ahirwe mo biriso. Byabyaga bithyo kʉshangwa Herote mwahikya Herotia, mʉka Filipo mʉgala abo. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Yoani agenda abwɨra Herote athɨ: «Bithahamulirwe kw'ɨwe ihikya mʉka mʉgala enyu.»<verse eid="MRK 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19" />Bʉshana n'ekyo, Herotia mwabaga Yoani na agenda ashondya imwitha, hewethuwe mwathakotsya. <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />Herote agendaga ʉbaha Yoani, kʉshangwa abyaga nietsi ko Yoani nɨ mʉthʉnganene na mubuyirire. Bʉshana n'ekyo mwamutheya. Agenda atsɨɨra ɨhʉlɨkɨrɨtsya ebɨnwa bya Yoani, namo byanagenda ebimuthabagania kʉtsɨbʉ mo bʉlɨ ndambi agenda ahʉlɨkɨrɨtsyabyo.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />Kɨro kɨgʉma Herotia mwabona mwanya w'itha Yoani. Kyabyaga kɨro kɨkʉlʉ ky'erɨbʉthwa lya Herote. Mo kɨro ekyo Herote mwakolera abakʉlʉ b'abashirikani bo linye n'abo lʉkengerwa b'iNgalilaya n'abimanitsi b'obuthegeki bʉwe.<verse eid="MRK 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 6:22" />Babere banalɨ mw'ebyo, mwalɨ wa Herotia mwɨngɨra n'ɨthanga ɨshatha. Erɨshatha lɨwe eryo molyamoya omwamɨ Herote n'abo balalɨkawa. Bʉshana n'ekyo mwabwɨra omʉthasha oyo athɨ: «Ʉnyɨshabe ekɨndʉ kyoshi-kyoshi ushashire, nangye nyakʉhakyo.»<verse eid="MRK 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 6:23" />Honyuma kw'aho mwalahɨtsya n'ɨnegena athɨ: «Nyakʉha ekɨndʉ kyoshi-kyoshi wanyɨshaba, na mo kyangabya kɨtse ky'obwamɨ bwaye.» <verse eid="MRK 6:23" /><verse number="24" style="v" sid="MRK 6:24" />Omʉthasha oyo mwahʉlʉka n'ɨya bʉtsya nyinya ʉwe athɨ: «Nyɨshabe ki no malɨ?» Nyinya ʉwe mwamʉshʉbɨtsya athɨ: «Shaba omuthwe wa Yoani Mubatisya.»<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />Aho n'aho omʉthasha oyo mwashʉba tsʉba ahalɨ omwamɨ n'ɨmʉshaba athɨ: «Enyishondya ʉnyɨhe ko kathambi kano omuthwe wa Yoani Mubatisya kʉ mbale.»<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />Omwamɨ abere onvwa athyo, mwagalɨrwa kʉtsɨbʉ, hewethuwe bʉshana n'erɨlahɨtsya akolaga, na bʉshana n'abo bathalalɨkwa, mwabʉsha nga ko amʉthɨndɨra ekyo amashaba. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Aho n'aho omwamɨ mwathʉma mʉgʉma wa ko bashirikani bʉwe bo bagenda abamutheya n'ɨmʉhamʉla athɨ ayalethe omuthwe wa Yoani Mubatisya.</para>
  <para style="p" vid="MRK 6:27">Omushirikani oyo mwaya mo biriso n'ɨyatsa Yoani y'omuthwe. <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />Honyuma kw'aho mwalethawo kʉ mbale, mwahawo omʉthasha oyo, naye mwahawo nyinya ʉwe.<verse eid="MRK 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 6:29" />Abɨga ba Yoani babere bonvwa omwatsɨ oyo, mobaya heka ekinda kɨwe n'ɨyathakyo mw'ɨsɨnda.<verse eid="MRK 6:29" /></para>
  <para style="s">Yesʉ alɨsa bandʉ bɨhʉmbɨ bɨthano</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mat 14:13-21</ref>; <ref loc="LUK 9:10-17">Luk 9:10-17</ref>; <ref loc="JHN 6:1-14">Yoa 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Abathʉmwa ba Yesʉ babere bashʉba aho abyaga, mobamʉbwɨra ebyoshi bathakola n'ebyoshi bathakangɨrɨtsya abandʉ. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Abandʉ bo bagenda abahikira Yesʉ n'abo bagenda abashʉbʉla, babyaga bangɨ kʉtsɨbʉ ihika ko kɨka ɨye n'abɨga bʉwe mobathabona ndambi y'erirya. Bʉshana n'ekyo Yesʉ mwabwɨra abɨga bʉwe athɨ: «Thʉgende ithwe bene handʉ hathalɨ bandʉ, bʉshana mʉlʉhʉke hake.» <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />Aho mobagenda ɨbo bene mʉ bwatho, handʉ hathalɨ bandʉ.<verse eid="MRK 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33" />Hewethuwe bandʉ bangɨ mobashʉngabo balɨ abagenda, mobamɨnya eyo bamaya. Bʉshana n'ekyo mobahuthuka mo bɨshando ɨthoka mo miyi yoshi, abandʉ abo mobathanga Yesʉ n'abɨga bʉwe bw'eyo. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />Yesʉ abere athoka mo bwatho, mwashʉnga muhindano mʉnene wa bandʉ. Mwafwɨrawo shashi, kʉshangwa babyaga nga mbuli sithawithe mulishya. Aho mwathanga ɨkangɨrɨtsyabo bɨnwa bɨngɨ.<verse eid="MRK 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35" />Bwabere bwagoroba, abɨga ba Yesʉ mobayɨfʉnda hofɨ naye n'ɨmʉbwɨra bathɨ: «Hano nɨ mbwarara, n'obuthuku bo bʉno bwamahika igolo. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />Shʉbʉtsya abandʉ aba bagende mo thʉnzalɨ na mo mɨrongo ya hofɨ-hofɨ bʉshana bayayɨgʉlɨre kalyo.»<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />Yesʉ mwashʉbɨtsyabo athɨ: «Imwe bene mʉhebo kalyo.» Nabo mobamʉbʉtsya bathɨ: «Ushondya thʉyagʉle mikati ya bɨtsere magana abɨrɨ<note caller="+" style="f"><char style="fr" closed="false">6:37 </char><char style="ft" closed="false">Kɨtsere kya faranga: Mo kikiriki ni tinari. Etinari ngʉma yabyaga n'ɨyɨrɨngene na lʉhembo lwa buhingi bwa mʉthobero mʉgʉma.</char></note> bya faranga bʉshana thʉherobo balyero?» <verse eid="MRK 6:37" /><verse number="38" style="v" sid="MRK 6:38" />Yesʉ mwabʉtsyabo athɨ: «Muwithe kʉ mikati ɨngahɨ? Mwathayalola!» Babere bamamala ɨmɨnya, mobamʉbwɨra bathɨ: «Thuwithe kʉ mikati ithano na mahere abɨrɨ.»<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />Aho Yesʉ mwahamʉla abɨga bʉwe athɨ bikatsye abandʉ boshi bo ahishi ko bɨthɨ mo bithutho bithutho. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Mobikala bithutho bya bandʉ igana igana, na makumi athano athano. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />Honyuma kw'aho, Yesʉ mwatsɨmba emikati ithano eyo n'amahere abɨrɨ. Mwashʉmba amesho w'elʉbʉla, mwasɨma Gongo. Mwatsitsanga emikati eyo, mwaharo abɨga bʉwe bʉshana bagabɨrero abandʉ. Na kuthyo mwagabɨra amahere abɨrɨ ayo w'oko boshi. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Abandʉ boshi mobalya na mobugutha. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />Abɨga babere bashongya-shongya ebɨtse-bɨtse by'emikati na by'amahere byashibaga, mobyotsutsya bɨthonga ikumi na bɨbɨrɨ. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Abandʉ bo balyaga babyaga bayira bɨhʉmbɨ bɨthano.<verse eid="MRK 6:44" /></para>
  <para style="s">Yesʉ athandayɨra ko metsi</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mat 14:22-33</ref>; <ref loc="JHN 6:16-21">Yoa 6:16-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Aho n'aho, Yesʉ mwahamʉla abɨga bʉwe bashambɨre mo bwatho n'ɨmʉthanga ko ʉndɨ mwishirya w'engetsɨ ko lʉhande lw'omuyi w'iBetesaita. Mo ndambi eyo, ɨye mwashiba alɨalaga omuhindano w'abandʉ. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Honyuma w'erɨlagabo, mwɨrʉkɨra ko kɨthwa bʉshana n'ɨya shaba Gongo. <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />Bwabere bwabya kɨro, obwatho bwabyaga nɨ bwahera mo kathi k'engetsɨ, na Yesʉ yowene ɨye abyaga nɨakɨnalɨ emʉsɨke ko kɨthaka. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />Mwashʉnga kw'abɨga bʉwe abagalwa mw'ɨkʉba engahya kʉshangwa erɨhʉnga lyagenda erishubyabo enyuma. Bwabere bwashondya ikya, Yesʉ mwahikirabo nɨagendera elʉgʉlʉ ko metsi, na mwashondya ɨtsʉka kʉbo. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />Nabo babere bamʉshʉnga alɨ agenda elʉgʉlʉ w'engetsɨ, mobaganɨtsya bathɨ nɨ kɨhɨndɨ, mobathanga ɨhambala, <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />kʉshangwa aboshi mobamʉshʉnga n'ɨʉbaha kʉtsɨbʉ.</para>
  <para style="p" vid="MRK 6:50">Hewethuwe aho n'aho, Yesʉ mwanegena nabo athɨ: «Mʉtsɨbʉhe, n'ingye mʉthʉbahaga!» <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />Honyuma kw'aho, mwashambɨra mo bwatho bo abɨga babyagamo, n'erɨhʉnga eryo molyabombera. Bʉshana n'ekyo abɨga mobashweka kʉtsɨbʉ, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />kʉshangwa mobathamɨnya ekɨthɨko-thɨko ky'eriluya emikati nga kinegenire kithi ki, bʉshana n'emɨthɨma yabo mɨtsɨbʉ.<verse eid="MRK 6:52" /></para>
  <para style="s">Yesʉ alamya bakoni mo kɨhʉgo ky'iNgenesareti</para>
  <para style="r">(<ref loc="MAT 14:34-36">Mat 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Yesʉ n'abɨga bʉwe babere bashabʉka engetsɨ, mobahika mo kɨhʉgo ky'iNgenesareti. Mobagobeka obwatho bw'emʉsɨke w'engetsɨ. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Babere bathoka mo bwatho, aho n'aho abandʉ mobamɨnya Yesʉ. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />Mobatsʉka mo kɨhʉgo kyoshi ekyo, mobathanga ɨrethera Yesʉ yo bakoni bahekirwe kʉ bipoyi ahoshi bagenda abonvwa mbʉ alɨ. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Bʉlɨ handʉ ho Yesʉ agenda atsʉka, mo miyi na mo mɨrongo, kʉtse mo thʉnzalɨ, abandʉ bagenda abahira abakoni mo bɨbʉga by'emihindano n'ɨmʉshaba bathɨ ahamʉle abakoni bakole ko pindo y'olʉkɨmba lʉwe kuroshi. N'aboshi bo bagenda abakola kʉlo, bagenda abalama.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">Mɨbere y'abandʉ</para>
  <para style="r">(<ref loc="MAT 15:1-20">Mat 15:1-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />
    <char style="w" lemma="Bafarisayo">Bafarisayo</char> na <char style="w" lemma=" bakangɨrɨtsya">bakangɨrɨtsya bagʉma b'oMʉgomba</char> mobathoka ɨYerʉsalemʉ, mobahindana embere sa Yesʉ. <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />Mobashʉnga bagʉma ba ko <char style="w" lemma="bɨga">bɨga</char> bʉwe niabalya kalyo mu minwe yɨrɨko mɨkonzɨ. Nɨ negena mbʉ, eminwe yo bathanabireko ɨkwamana n'emɨbere y'ekɨsomo kyabo.<verse eid="MRK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3" />Mobyabya bithyo kʉshangwa <char style="w" lemma="Bafarisayo">aBafarisayo</char> n'aBayuta boshi bashikitsye emɨbere y'obwishe-kʉlʉ wabo, yo yihangire erirya bʉthanaba ko minwe, erihika ko ngokola nga ko bɨtholere. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />Kandɨ, abanabya bathoka mo kathale, bathalɨ abanalya bathakarabire. Na kalengyo kw'ebyo bashikitsye n'eyɨndɨ mɨbere mɨngɨ ng'omʉhanda w'eryetsya esonyatha, ebɨrega n'esonyʉngʉ so sakomibawa mʉ mɨrɨnga [n'esongɨngo.<note caller="+" style="f"><char style="fr" closed="false">7:4 </char><char style="ft" closed="false">N'esongɨngo: Ekɨnwa kɨno kɨthalɨ mʉ wandɨ mashako wa kera.</char></note>]<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />Aho <char style="w" lemma="Bafarisayo">aBafarisayo</char> n'<char style="w" lemma="bakangɨrɨtsya">abakangɨrɨtsya</char> b'oMʉgomba mobabʉtsya Yesʉ bathɨ: «Bʉshana na ki abɨga bawe ɨbo bathakwamire emɨbere y'abo thatha-kʉlʉ, hewethuwe abanalya mo minwe yɨrɨko mɨkonzɨ?»<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />Yesʉ mwashʉbɨtsyabo athɨ: «Imwe bayimbya, Isaya mwamɨnyerera kʉbʉya mo mʉgʉlʉ ashakaga ebɨnwa bɨno kw'imwe athɨ:</para>
  <para style="q1" vid="MRK 7:6">“Gongo anegena athɨ:</para>
  <para style="q1" vid="MRK 7:6">aBandʉ aba banyishikitsye ko mitutu yabo,</para>
  <para style="q1" vid="MRK 7:6">hewethuwe emɨthɨma yabo yɨrɨ hale nangye.<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />Eriramya abananyiramya nɨ lya bʉsha-bʉsha,</para>
  <para style="q1" vid="MRK 7:7">kʉshangwa amakangɨrɨtsya wabo</para>
  <para style="q1" vid="MRK 7:7">nɨ hɨhanɨrɨro hya bandʉ<note caller="+" style="f"><char style="fr" closed="false">7:7 </char><char style="ft" closed="false">Soma Isaya 29:13.</char></note>.”»<verse eid="MRK 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8" />Yesʉ mwashʉba bwɨrabo athɨ: «Imwe omumika amathegeko wa Gongo bʉshana n'erishikya ehɨhanɨrɨro hy'abandʉ. <verse eid="MRK 7:8" /><verse number="9" style="v" sid="MRK 7:9" />Mwashʉba bwɨrabo kandɨ athɨ: Mwetsi kweneneko erɨhɨgʉla amathegeko wa Gongo bʉshana mushikye ehɨhanɨrɨro hyenyu! <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />Kʉshangwa Mʉsa mwanegena athɨ: “Ushikye sho na nyoko,” na kuthyo “oyo uhangya ishe kʉtse nyinya, atholere ithwa<note caller="+" style="f"><char style="fr" closed="false">7:10 </char><char style="ft" closed="false">Soma Ɨthoka 21:17; Balawi 20:9; Ɨthoka 20:12; 21:17; Balawi 20:9; Ɨbʉka mʉgomba 5:16.</char></note>.” <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />Hewethuwe imwe omʉnanegena mʉthɨ omʉndʉ angabwɨra ishe kʉtse nyinya athɨ: “Ebyo nyangabawathikitsye nabyo byamabya Korobane. Korobane n'ɨnegena mbʉ bɨhembo bibuyirire b'ɨhemba Gongo, <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />omw'ɨkola muthyo nɨ mwamahangɨra omʉndʉ mʉthɨ athashʉba wathikya ishe kʉtse nyinya. <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />Ni bathyo k'omʉnasʉnzʉgʉra eKɨnwa kya Gongo bʉshana n'emɨbere enyu yo munashigirana. Nemwe ʉmʉkola bɨndɨ bɨndʉ bɨngɨ by'omʉhanda oyo.”»<verse eid="MRK 7:13" /></para>
  <para style="s">Ebɨndʉ byo bɨnayɨra mo mʉndʉ mo muhenyi</para>
  <para style="r">(<ref loc="MAT 15:10-20">Mat 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />Honyuma kw'aho Yesʉ mwashʉba bɨrɨkɨra omuhindano w'abandʉ n'ɨbwɨrabo athɨ: «Imwe boshi mʉnyɨhʉlɨkɨrɨtsye na mʉmɨnye ebɨnwa byo nyinshondya ɨbabwɨra bɨno: <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />Bɨthalɨ byo bɨngɨra mo mʉndʉ ɨthoka embʉga byo byanga mʉyɨramo muhenyi. Hewethuwe nɨ ebyo bɨthoka mo mʉndʉ nɨ ebyo, byo bɨnamʉyɨramo muhenyi. <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />[Oyo uwithe mathwi w'ɨonvwa, onvwe.»] <verse eid="MRK 7:16" /><verse number="17" style="v" sid="MRK 7:17" />Yesʉ abere amikana n'omuhindano w'abandʉ n'ɨngɨra mo nyʉmba, abɨga bʉwe mobamʉbʉtsya esonzomolo y'omushinga oyo. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Naye mwabwɨrabo athɨ: «Nemwe kuthyo muthaminyire? Muthetsi k'obʉlɨ kɨndʉ kyo kɨnɨngɨra mo mʉndʉ ɨthoka embʉga kɨthangakotsya ɨmʉyɨramo muhenyi. <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />Kʉshangwa ebɨndʉ ebyo, bɨthalɨ ebɨnɨngɨra mo mʉthɨma ʉwe, hewethuwe ebɨnɨngɨra mo nda kuroshi na honyuma kw'aho nɨbyathokamo mw'ɨya ebwɨga.» Mw'ɨnegena athyo, Yesʉ mwakangania kw'ebiryo byoshi bihamulirwe ɨrɨbwa. <verse eid="MRK 7:19" /><verse number="20" style="v" sid="MRK 7:20" />Yesʉ mwashʉba negena athɨ: «Nɨ ebyo bɨnathoka mo mʉndʉ byo bɨnamʉyɨramo muhenyi. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />Kʉshangwa nɨ mo mʉthɨma w'omʉndʉ, mo mʉnathoka emɨganɨtsye mɨbɨ yo yɨnaletha: ɨthola bakatsɨ ba bene na bwɨtsɨ na bwithi <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />na rʉsɨngɨ na ngʉmbʉ mbɨ ya bɨndʉ na mɨkolano mɨbɨ na buliribania na mɨbere mɨbɨ na mwisho na buhangya n'ɨyɨheka na bʉhʉmo. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />Ebɨbɨ byoshi ebi ebɨnathoka mo mʉndʉ, nabyo nɨbyamʉyɨramo muhenyi.»<verse eid="MRK 7:23" /></para>
  <para style="s">Lwɨkɨrɨtsyo lwa mʉkatsɨ musuria</para>
  <para style="r">(<ref loc="MAT 15:21-28">Mat 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Honyuma kw'aho Yesʉ mwathoka aho, n'ɨya mo ndambɨ ndambɨ s'omuyi w'iTiro. Mwɨngɨra mʉ nyʉmba ngʉma, naye mwashondya abandʉ bathamɨnyaga ko alɨ omo, hewethuwe mwathakotsya iyibisha. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />Aho n'aho mʉkatsɨ mʉgʉma mwonvwa omwatsɨ wa Yesʉ. Omʉkatsɨ oyo mwalɨ ʉwe abyagako mɨtsɨmʉ mɨbɨ. Mwahikira Yesʉ n'ɨyɨgʉsha mo bɨshando bɨwe. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Omʉkatsɨ oyo abyaga mukiriki, mbʉthɨrwa w'iFoiniki mo kɨhʉgo ky'iSuria. Mwashaba Yesʉ abɨnge omʉtsɨmʉ mʉbɨ oyo athoke kʉ mwalɨ ʉwe. <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />Yesʉ mwamʉshʉbɨtsya athɨ: «Thanga walika abana buguthe, kʉshangwa bithakwirire ɨtsɨmba akalyo k'abana n'ɨgʉshɨrako esombwa.» <verse eid="MRK 7:27" /><verse number="28" style="v" sid="MRK 7:28" />Omʉkatsɨ mwamʉshʉbɨtsya athɨ: «Nyinya-kowethʉ, wamanegena ekwenene, hewethuwe ebɨbwana ebinalya ebɨshakɨtsya by'akalyo kw'abana abanathogongya ko lʉgalɨ.» <verse eid="MRK 7:28" /><verse number="29" style="v" sid="MRK 7:29" />Aho Yesʉ mwamʉbwɨra athɨ: «Bʉshana n'ekɨnwa eki, shʉba ewawe, omʉtsɨmʉ oyo amathoka kʉ mwalɨ wawe.» <verse eid="MRK 7:29" /><verse number="30" style="v" sid="MRK 7:30" />Omʉkatsɨ mwashʉba ewe, mweya mwalɨ ʉwe niayilambikire ko ngɨngo, n'omʉtsɨmʉ mʉbɨ niamalire ɨmʉthokako.<verse eid="MRK 7:30" /></para>
  <para style="s">Yesʉ alamya mʉtsɨha</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Honyuma kw'aho Yesʉ mwathoka mo kɨhʉgo kyabyaga hofɨ n'iTiro. Mwatsʉka mo muyi w'iSitona na mwalotsya ko ngetsɨ y'iNgalilaya mo kɨhʉgo ky'eMiyi iKumi. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Mobalethera Yesʉ yo mʉndʉ mʉgʉma yo wabyaga mʉtsɨha na muthethu-thethu. Abo bamʉlethaga mobashaba Yesʉ amuhireko eminwe. <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />Aho Yesʉ mwathokya omʉndʉ oyo mo kathi k'omuhindano w'abandʉ, mwamʉthwala hale hake n'abandʉ. Mwahira eminwe mo mathwi w'omʉndʉ oyo, mwayɨtsɨrako mathandɨ ko minwe na mwakola ko lʉlɨmɨ lw'omʉndʉ oyo. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Yesʉ mwashʉmba amesho mo lʉbʉla, mwahʉmʉlɨkana kʉtsɨbʉ n'ɨbwɨra omʉndʉ oyo athɨ: «Efata», n'ɨnegena mbʉ, «Tsɨbʉkala!» <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />Aho n'aho amathwi ʉwe mwatsɨbʉkala, na kuthyo olʉlɨmɨ lʉwe molwagobokala, mwathanga ɨnegena kʉbʉya. <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />Yesʉ mwahamʉla abandʉ athɨ bathabwɨraga mʉndʉ n'omʉgʉma ekyamakoleka. Hewethuwe na mwanahangɨragabo, ɨbo mobathalika ithulagania omwatsɨ oyo ko bandʉ. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Abandʉ mobashweka kʉtsɨbʉ n'ɨnegena bathɨ: «Ko kwenene, ebyoshi akola bikwirire. Akɨngʉla amathwi w'abatsɨha, anegenia n'othurumbu.»<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">Yesʉ alɨsa bandʉ bɨhʉmbɨ bɨne</para>
  <para style="r">(<ref loc="MAT 15:32-39">Mat 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />Ko bɨro ebyo muhindano mʉnene wa bandʉ mobashʉba hindana. Kʉshangwa babyaga ni bathawithe ku kalyo, Yesʉ mwabɨrɨkɨra abɨga bʉwe, n'ɨbwɨrabo athɨ: <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />«Nyamafwɨra abandʉ aba bo shashi, kʉshangwa bamikala nangye hano bɨro bɨshathʉ, nabo bathakiwithe kalyo. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />Na nyamabwɨrabo nyɨthɨ bagende ewabo bʉtsɨra irya, nɨbalekʉlɨra mo nzɨra, kʉshangwa bagʉma mo kathi kabo bathathoka hale.» <verse eid="MRK 8:3" /><verse number="4" style="v" sid="MRK 8:4" />Abɨga bʉwe mobamʉshʉbɨtsya bathɨ: «Mo mbwarara mo hano, thwabona akalyo ko hayi y'eryuguthya abandʉ boshi aba?» <verse eid="MRK 8:4" /><verse number="5" style="v" sid="MRK 8:5" />Yesʉ mwabʉtsyabo athɨ: «Muwithe kʉ mikati ɨngahɨ?» Nabo mobamʉshʉbɨtsya bathɨ: «Thuwithe kʉ mikati ɨrɨnda.» <verse eid="MRK 8:5" /><verse number="6" style="v" sid="MRK 8:6" />Aho Yesʉ mwahamʉla abandʉ bikale ahishi. Honyuma kw'aho mwatsɨmba emikati ɨrɨnda eyo, mwasɨma Gongo, mwatsitsangaro n'ɨharo abɨga bʉwe bagabɨrero ko bandʉ. N'abɨga mobagabaro ko bandʉ. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />Babyaga bawithe kuthyo na kʉ thʉhere thʉke-thʉke thʉke. Yesʉ mwasɨma Gongo bʉshana n'othʉhere otho, n'ɨbwɨra abɨga bʉwe athɨ bagabetho kuthyo. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Abandʉ boshi mobalya n'iugutha. Honyuma kw'aho abɨga mobathola-thola ebɨtse-bɨtse byashakaga, mobyotsutsya bɨthonga bɨrɨnda. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />Abandʉ bo balyaga akalyo ako babyaga bangana hofɨ bɨhʉmbɨ bɨne. Honyuma kw'aho Yesʉ mwalagabo. <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />Aho n'aho Yesʉ mwashambɨra mo bwatho hagʉma n'abɨga bʉwe, na mwagenda mo kɨhʉgo kya Talimanuta.<verse eid="MRK 8:10" /></para>
  <para style="s">aBafarisayo abashondya kɨmɨnyɨkalo</para>
  <para style="r">(<ref loc="MAT 16:1-4">Mat 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />aBafarisayo mobahikira Yesʉ n'ɨthanga ikubisania naye. Mobamʉlengako mw'ɨmʉshaba akolerebo kɨmɨnyɨkalo kyo kikangania kw'amaka ʉwe athoka mo lʉbʉla. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />Yesʉ mwahʉmʉlɨkana kʉtsɨbʉ mo mʉthɨma na mwanegena athɨ: «Bʉshana na ki imwe bandʉ b'olʉgero lʉno omushondya ɨshʉnga kɨmɨnyɨkalo? Kwenene enyɨbabwɨra, muthikangibwe kɨmɨnyɨkalo n'ekɨgʉma!»<verse eid="MRK 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 8:13" />Honyuma kw'aho, mwamikabo na mwashambɨra kandɨ mo bwatho, na mwashabʉkɨra ko ʉndɨ mwishirya w'engetsɨ.<verse eid="MRK 8:13" /></para>
  <para style="s">Tsatsʉ y'aBafarisayo na ya Herote</para>
  <para style="r">(<ref loc="MAT 16:5-12">Mat 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Abɨga ba Yesʉ babyaga nɨbamɨbɨrɨrwa ɨheka emikati, he babyaga nibawithe ku mukati mʉgʉma mʉsha mo bwatho. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />Yesʉ mwahamʉlabo athɨ: «Ohe, muyitheye ko <char style="w" lemma="tsatsʉ y'aBafarisayo">tsatsʉ y'aBafarisayo</char> n'eya Herote.» <verse eid="MRK 8:15" /><verse number="16" style="v" sid="MRK 8:16" />Abɨga mobathanga ɨbwɨrana bathɨ: «Anegena athya bʉshana thuthawithe ku mikati.» <verse eid="MRK 8:16" /><verse number="17" style="v" sid="MRK 8:17" />Yesʉ mwamɨnya ebɨnwa bagenda abanegena, aho mwabʉtsyabo athɨ: «Bʉshana na ki omukubisania bʉshana n'erɨbʉsha emikati? Muthetsi mwamɨnya kʉtse ɨkɨngʉlwako bwenge? Emɨthɨma enyu ɨkɨnalɨ mɨtsɨbʉ? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />Muwithe mesho, hewethuwe muthalolire? Muwithe mathwi, hewethuwe mʉthalɨ omwonvwa? Muthakibukire <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />mo ndambi nyatsitsangaga emikati ithano n'ɨrɨsa abandʉ bɨhʉmbɨ bɨthano? Mo ndambi eyo momwotsutsya bɨthonga bɨngahɨ by'ebɨtse-bɨtse by'emikati?» Mobashubya bathɨ: «Ikumi na bɨbɨrɨ.» <verse eid="MRK 8:19" /><verse number="20" style="v" sid="MRK 8:20" />Naye mwashʉba bʉtsyabo athɨ: «Na mo ndambi nyatsitsangaga emikati ɨrɨnda n'ɨrɨsa bandʉ bɨhʉmbɨ bɨne, momwotsutsya bɨthonga bɨngahɨ by'ebɨtse-bɨtse by'emikati?» Mobamʉshʉbɨtsya bathɨ: «Bɨrɨnda.» <verse eid="MRK 8:20" /><verse number="21" style="v" sid="MRK 8:21" />Aho Yesʉ mwabʉtsyabo athɨ: «Muthetsi mwamɨnya kɨndʉ?»<verse eid="MRK 8:21" /></para>
  <para style="s">Yesʉ alamya mbumi mo muyi w'iBetesaita</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Yesʉ n'abɨga bʉwe mobahika mo muyi w'iBetesaita. Eyo bandʉ bagʉma mobalethera Yesʉ yo mʉndʉ mʉgʉma mbumi n'ɨmʉshaba amʉkoleko. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Yesʉ mwatsɨmba okʉboko kw'embumi eyo n'ɨmʉthwala embʉga y'omʉrongo. Yesʉ mwatsɨra mathandɨ ko mesho w'omʉndʉ oyo, n'imuhirako eminwe yɨwe, mwamʉbʉtsya athɨ: «Wanamashʉnga kɨndʉ?» <verse eid="MRK 8:23" /><verse number="24" style="v" sid="MRK 8:24" />Embumi moyashʉmba amesho waro n'ɨnegena yɨthɨ: «Nyamashʉnga bandʉ abagenda, hewethuwe abashʉngɨka nga mɨthɨ.» <verse eid="MRK 8:24" /><verse number="25" style="v" sid="MRK 8:25" />Yesʉ mwashʉba kola ko mesho w'embumi eyo, naro moyalola kʉbʉya. Amesho waro mwalama, n'ɨlola ko bɨndʉ byoshi ko kʉbʉya-kʉbʉya. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Honyuma kw'aho Yesʉ mwamʉbwɨra athɨ ashʉbe ewe, n'ɨmʉhamʉla athɨ athashʉbaga mo mʉrongo oyo.<verse eid="MRK 8:26" /></para>
  <para style="s">Petero amɨnyɨsa ko Yesʉ nɨ Kirisito</para>
  <para style="r">(<ref loc="MAT 16:13-20">Mat 16:13-20</ref>; <ref loc="LUK 9:18-21">Luk 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Yesʉ n'abɨga bʉwe mobagenda ko mʉnda w'emɨrongo yo yabyaga hofɨ n'omuyi w'iKaisaria Filipi. Babere banalɨ omo nzɨra, mwabʉtsyabo athɨ: «Abandʉ abanegena bathɨ ingye nyɨrɨ ndɨ?» <verse eid="MRK 8:27" /><verse number="28" style="v" sid="MRK 8:28" />Nabo mobamʉshʉbɨtsya bathɨ: «Bagʉma abanegena bathɨ ɨwe ʉlɨ Yoani Mubatisya, n'abandɨ abanegena bathɨ ɨwe ʉlɨ Elia, n'abandɨ abanegena bathɨ ɨwe ʉlɨ mʉgʉma w'oko <char style="w" lemma="bamɨnyeretsɨ">bamɨnyeretsɨ</char>.»<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />Aho Yesʉ mwabʉtsyabo athɨ: «Nemwe omʉnegena mʉthɨ ingye nyɨrɨ ndɨ?» Petero mwamʉshʉbɨtsya athɨ: «Ɨwe nɨ <char style="w" lemma="Kirisito">Kirisito</char>.» <verse eid="MRK 8:29" /><verse number="30" style="v" sid="MRK 8:30" />Nɨmo Yesʉ ahamʉlabo athɨ bathanalinda babwɨra mʉndʉ y'ekɨnwa ekyo.<verse eid="MRK 8:30" /></para>
  <para style="s">Yesʉ afʉla omwatsɨ w'olʉholo n'erilubuka lɨwe</para>
  <para style="r">(<ref loc="MAT 16:21-28">Mat 16:21-28</ref>; <ref loc="LUK 9:22-27">Luk 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Honyuma kw'aho Yesʉ mwathanga ɨkangɨrɨtsya abɨga bʉwe athɨ: «Bɨtholere oMʉgala w'oMʉndʉ agatsɨbwe n'ɨthɨndwa n'abimanitsi b'abandʉ, <char style="w" lemma="Baheri Bakʉlʉ">n'aBaheri Bakʉlʉ</char> hagʉma n'a<char style="w" lemma="Bakangɨrɨtsya oMʉgomba">Bakangɨrɨtsya b'oMʉgomba</char>. Andithwa n'oko kɨro ky'akashathʉ honyuma w'olʉholo lʉwe andalubuka.» <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Agenda abwɨrabo ebɨnwa ebyo kʉbʉya-kʉbʉya. Aho Petero mwatsɨmba Yesʉ n'ɨyɨhɨgʉla naye n'ɨthanga ɨmʉkemera. <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />Hewethuwe Yesʉ mwabɨndʉkɨra abɨga bʉwe n'ɨkemera Petero n'ɨnegena athɨ: «Thoka hofɨ nangye hano ɨwe Sitani, kʉshangwa emɨganɨtsye awe ɨthalɨ ya Gongo hewethuwe nɨ ya bandʉ.»<verse eid="MRK 8:33" /></para>
  <para style="s">Mʉhanda w'ɨkwama Yesʉ</para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />Honyuma kw'aho, Yesʉ mwabɨrɨkɨra omuhindano w'abandʉ hagʉma n'abɨga bʉwe, n'ɨbwɨrabo athɨ: «Omʉndʉ amashasha ɨnyɨkwama, athayɨtsomanaga yowene, hewethuwe ayɨsɨnge ɨheka omʉsalaba ʉwe n'ɨnyɨkwama. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />Kʉshangwa omʉndʉ yo ushondya ilamya obʉyɨngo bʉwe, andahetsyabo, hewethuwe oyo wandahetsya obʉyɨngo bʉwe bʉshana nangye na bʉshana n'eNgʉlʉ Mbʉya, andalamyabo. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Nɨ ndundi ehɨ ko mʉndʉ erɨbona obushoki boshi bw'ekɨhʉgo, hewethuwe nɨahetsya obʉyɨngo bʉwe? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Hathalɨ kɨndʉ kyoshi-kyoshi kyo mʉndʉ angakotsya ɨhana bʉshana ashabʉle obʉyɨngo bʉwe.»<verse eid="MRK 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 8:38" />Bʉshana n'ekyo, obʉlɨ mʉndʉ yo ʉnyɨfwɨra shoni, n'ɨfwɨra amakangɨrɨtsya aye wo shoni mo kathi k'abandʉ b'olʉgero lʉno, olo luthawithe iyinihirwa na lʉshɨngɨtsɨ embere sa Gongo, oMʉgala w'oMʉndʉ andamʉfwɨra shoni kuthyo, andabya ahika hagʉma n'abamalaɨka babuyirire, mo lʉkengerwa lw'Ishe.<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Yesʉ mwashʉba negena athɨ: «Kwenene enyɨbabwɨra nyɨthɨ: bagʉma mo bandʉ bo balɨ hano bathɨndafwe bathetsi balola ko Bwamɨ bwa Gongo bʉlɨ obuhika n'amaka.»<verse eid="MRK 9:1" /></para>
  <para style="s">Yesʉ ahɨndʉlwa bʉsʉ</para>
  <para style="r">(<ref loc="MAT 17:1-13">Mat 17:1-13</ref>; <ref loc="LUK 9:28-36">Luk 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />Honyuma wa bɨro ndathʉ, Yesʉ mwatsɨmba Petero, na Yakobo na Yoani, na mwathwalabo ɨbo bene ko kɨthwa kɨre. N'eyo obʉsʉ bwa Yesʉ mobwahɨndʉka embere sabo. <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />Esongɨmba sɨwe mosahɨndʉka mʉshohe kʉtsɨbʉ n'ɨnyenyetha. Naho mo kɨhʉgo hathalɨ mwengenge yo wangakotsya ɨnyenyethya athyo<note caller="+" style="f"><char style="fr" closed="false">9:3 </char><char style="ft" closed="false">Soma 2Petero 1:16-18.</char></note>. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Aho n'aho abɨga bashathʉ abo mobashʉnga Elia bana Mʉsa nɨabasɨmola na Yesʉ. <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />Aho Petero mwabwɨra Yesʉ athɨ: «Mʉkangɨrɨtsya, bikwirire kw'ithwe ibya hano. Thuhimbe hema ishathu, ngʉma yɨwawe, na ngʉma ya Mʉsa na yɨndɨ ya Elia.» <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />Petero mwathamɨnya ekyo anganegena kʉshangwa ɨye na balikyabo mobʉbaha. <verse eid="MRK 9:6" /><verse number="7" style="v" sid="MRK 9:7" />Aho ekɨfʉ mokyahʉlʉka n'ɨshwɨkabo. N'omo kɨfʉ ekyo momwonvwɨka mʉlenge nɨanegena athɨ: «Ono nɨ Mʉgala aye mʉtsɨɨrwa. Mʉmʉhʉlɨkɨrɨtsye!» <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />Aho n'aho abɨga mobakeba-keba ko mbande sabo soshi, mobathashʉnga ʉndɨ mʉndʉ hagʉma nabo, athalɨ Yesʉ yowene. <verse eid="MRK 9:8" /><verse number="9" style="v" sid="MRK 9:9" />Babere balɨ abandagala ɨthoka ko kɨthwa, Yesʉ mwahamʉlabo athɨ: «Mʉthaganʉlɨraga mʉndʉ y'ebyo mʉthashʉnga ihika ko kɨro Mʉgala w'oMʉndʉ andalubuka.»<verse eid="MRK 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10" />Abɨga mobashikya ekɨnwa ekyo, hewethuwe mobathanga ibutsania bathɨ: «Erilubuka eri, linegenire lithi ki?» <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" />Honyuma kw'aho mobabʉtsya Yesʉ bathɨ: «Bʉshana na ki <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">aBakangɨrɨtsya b'oMʉgomba</char> abananegena bathɨ lɨtholere Elia<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="ft" closed="false">Elia abyaga mʉmɨnyeretsɨ wa kera mo kɨhʉgo ky'aBayuta. Abayuta babyaga nibalindirire ko Elia bʉshana abwɨre abandʉ athɨ bayithegekanie kw'ihika ly'omushabuli wabo. Elia oyo Yesʉ ahʉla hano nɨ Yoani mubatisya. Soma Malaki 3:23.</char></note> nɨathanga ɨshʉbʉla?»<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />Yesʉ mwashʉbɨtsyabo athɨ: «Kwenene, Elia atholere nɨathanga ɨshʉbʉla n'ɨthondeka ebɨndʉ byoshi. Hewethuwe bʉshana na ki aMashako Abuyirire anegenire athɨ oMʉgala w'oMʉndʉ andagalwa kʉtsɨbʉ n'ɨsʉnzʉgʉrwa<note caller="+" style="f"><char style="fr" closed="false">9:12 </char><char style="ft" closed="false">Soma Isaya 53:3; Saburi 22:1-18.</char></note>? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Hewethuwe enyɨbabwɨra ko Elia amalire ihika, n'abandʉ mobamʉkolera ebyoshi babyaga bashashire, ɨkwamana n'ebishakirwe kw'ɨye mo Mashako Abuyirire<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false">Yoani mubatisya alinganibwe na Elia. Soma Luk 1:16-17.</char></note>.»<verse eid="MRK 9:13" /></para>
  <para style="s">Yesʉ alamya mwana yo ʉlɨko mʉtsɨmʉ mʉbɨ</para>
  <para style="r">(<ref loc="MAT 17:14-21">Mat 17:14-21</ref>; <ref loc="LUK 9:37-43">Luk 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Yesʉ n'abɨga bashathʉ abo babere bahika eyɨrɨ abandɨ abɨga, mobashʉnga muhindano w'abandʉ bangɨ niathimbire kʉbo, balɨ abakubisania n'<char style="w" lemma="bakangɨrɨtsya b'oMʉgombas">abakangɨrɨtsya b'oMʉgomba</char>. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Aho n'aho, abandʉ babere bashʉnga Yesʉ, mobashweka kʉtsɨbʉ, mobathɨbɨtha mw'ɨya mʉketsya. <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />Yesʉ mwabʉtsya abɨga bʉwe athɨ: «Ni ki kyo kɨreka nɨ mwakubisania nabo?» <verse eid="MRK 9:16" /><verse number="17" style="v" sid="MRK 9:17" />N'aho, mʉndʉ mʉgʉma mo kathi k'omuhindano mwamʉshʉbɨtsya athɨ: «Mʉkangɨrɨtsya, nyamakʉlethera mʉgala aye, kʉshangwa alɨko mɨtsɨmʉ mɨbɨ. Emɨtsɨmʉ eyo yamalire ɨmʉyɨramo karumbu. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Ko bʉlɨ ndambi omʉtsɨmʉ oyo anabya amʉtsɨmba, anamuhuma ahishi, n'omwana anathokya ɨfʉlo mo bʉnʉ n'ishya ameno, n'omʉbɨrɨ ʉwe anʉma. Monyashabire abɨga bawe babɨnge omʉtsɨmʉ oyo, hewethuwe mobalemirwe.» <verse eid="MRK 9:18" /><verse number="19" style="v" sid="MRK 9:19" />Yesʉ mwabwɨrabo athɨ: «Mbe imwe bandʉ b'olʉgero lʉthɨkɨrɨtsye Gongo! Nyandabya hagʉma nemwe kandɨ ihika ndambi ehɨ? Nyandabalɨndɨrɨra kandɨ ihika ku ndambi ehɨ? Mʉnyɨrethere omwana yo hano.» <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />Aho mobamʉlethera omwana oyo. Na aho n'aho omʉtsɨmʉ mʉbɨ oyo abere ashʉnga Yesʉ, mwathithimania omwana oyo ko kagala ihika ko kɨka mwawa ahishi, na mwagala-gala ahishi n'ithokya erɨfʉlo mo bʉnʉ. <verse eid="MRK 9:20" /><verse number="21" style="v" sid="MRK 9:21" />Yesʉ mwabʉtsya ishe w'omwana athɨ: «Omwana oyu anabya athyo ɨthanga kʉ mʉgʉlʉ ohɨ?» Ishe ʉwe mwamʉshʉbɨtsya athɨ: «Nɨ ɨthanga mo bwana bʉwe. <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />Na ngendo nyɨngɨ omʉtsɨmʉ mʉbɨ oyu anamʉgʉsha mo mʉtsanwa na mo metsi, bʉshana amwithe. Hewethuwe wamabya wanganakotsya ɨkola kɨndʉ, ʉthʉshashɨre n'ithuwathikya.» <verse eid="MRK 9:22" /><verse number="23" style="v" sid="MRK 9:23" />Yesʉ mwamʉbwɨra athɨ: «Bʉshana na ki ʉnegena ʉthɨ nga nyanganakotsya? Ʉmɨnye kʉbʉya kw'ebyoshi bɨthokekene kw'oyo wɨkɨrɨtsye.» <verse eid="MRK 9:23" /><verse number="24" style="v" sid="MRK 9:24" />Aho n'aho ishe w'omwana mwahambala kʉtsɨbʉ athɨ: «Nyɨkɨrɨtsye! Hewethuwe unyiwathikye kʉshangwa olwɨkɨrɨtsyo lwaye nɨ lʉke!»<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />Yesʉ abere ashʉnga abandʉ bangɨ ko bongereka tsʉba-tsʉba, mwakemera omʉtsɨmʉ oyo n'ɨmʉbwɨra athɨ: «Ɨwe mʉtsɨmʉ mʉbɨ w'oʉyɨra abandʉ mo thurumbu na batsɨha, enyɨkʉhamʉla ʉthoke ko mwana oyu na ʉthandashʉba mʉshʉbako!» <verse eid="MRK 9:25" /><verse number="26" style="v" sid="MRK 9:26" />Omʉtsɨmʉ oyo mwahambala, n'ithithimania omwana yo kʉtsɨbʉ n'ɨmʉthokako. Omwana mwashʉngɨka nga amafwa, n'abandʉ bangɨ mobathanga ɨnegena bathɨ: «Amamala ɨfwa.» <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Hewethuwe Yesʉ mwamʉtsɨmba ko kʉboko, n'imwimania<note caller="+" style="f"><char style="fr" closed="false">9:27 </char><char style="ft" closed="false">Imwimania: Awandɨ mashako anegenire athɨ: Mwamubukya.</char></note>, naye mwimana. <verse eid="MRK 9:27" /><verse number="28" style="v" sid="MRK 9:28" />Yesʉ abere amɨngɨra mo nyʉmba<note caller="+" style="f"><char style="fr" closed="false">9:28 </char><char style="ft" closed="false">Mo nyʉmba, Soma 2:1, n'ebishakirwe.</char></note>, abɨga bʉwe mobamʉbʉtsya nɨbahera ɨbo bene hagʉma naye bathɨ: «Bʉshana na ki ithwe mothwalemirwe ɨbɨnga omʉtsɨmʉ oyo?» <verse eid="MRK 9:28" /><verse number="29" style="v" sid="MRK 9:29" />Yesʉ mwashʉbɨtsyabo athɨ: «Emɨtsɨmʉ y'omʉhanda oyu ɨnabɨngwa mo mɨshabe kuroshi.»<verse eid="MRK 9:29" /></para>
  <para style="s">Yesʉ amɨnyɨsa kandɨ omwatsɨ w'olʉholo n'erilubuka lɨwe</para>
  <para style="r">(<ref loc="MAT 17:22-23">Mat 17:22-23</ref>; <ref loc="LUK 9:43-45">Luk 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Yesʉ n'abɨga bʉwe mobathoka eyo n'ɨtsʉka mo kɨhʉgo ky'iNgalilaya. Yesʉ mwathashasha abandʉ bamɨnye aho babyaga, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />kʉshangwa abyaga nɨakangɨrɨtsya abɨga bʉwe, n'ɨbwɨrabo athɨ: «oMʉgala w'oMʉndʉ ahirwa mo minwe y'abandʉ, nabo bandamwitha, n'oko kɨro ky'akashathʉ honyuma w'olʉholo lʉwe, andalubuka.» <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />Hewethuwe abɨga mobathamɨnya amakangɨrɨtsya ayo ng'anegenire athɨ ki. Mobʉbaha ɨmʉbʉtsya kɨnwa.<verse eid="MRK 9:32" /></para>
  <para style="s">Nɨ ndɨ yo mʉkʉlʉ mo Bwamɨ bwa Gongo?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Mat 18:1-5</ref>; <ref loc="LUK 9:46-48">Luk 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />Honyuma kw'aho, Yesʉ n'abɨga bʉwe mobahika ɨKaperenaʉmʉ. Babere bamɨngɨra mo nyʉmba, Yesʉ mwabʉtsya abɨga bʉwe athɨ: «Ni ki kyo mʉthagenda omukubisaniako mo nzɨra?» <verse eid="MRK 9:33" /><verse number="34" style="v" sid="MRK 9:34" />Hewethuwe mobatsɨra, kʉshangwa babyaga niabakubisania mo nzɨra bathɨ nɨ ndɨ yo mʉkʉlʉ mo kathi kabo. <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />Aho Yesʉ mwikala, mwabɨrɨkɨra abɨga bʉwe ikumi n'ababɨrɨ n'ɨbwɨrabo athɨ: «Omʉndʉ yo ushondya ibya mʉmbere atholere nɨayɨyɨramo munyuma-nyuma kʉlenga aboshi n'ibya mukoli w'aboshi.» <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />Honyuma kw'aho, mwatsɨmba mwana mʉlere, mwamuhira mo kathi k'abo n'ɨmʉfʉmbatha. Aho mwabwɨrabo athɨ: <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />«Omʉndʉ yo ukokya omwana mʉlere ng'ono bʉshana nangye, niamanyikokya. N'oyo wamanyikokya, nɨathalɨ ingye amakokya, hewethuwe niamakokya kuthyo oyo wanyɨthʉmaga.»<verse eid="MRK 9:37" /></para>
  <para style="s">Yo ʉthalɨ nzigu ethʉ nɨ w'ekɨkembe kyethʉ</para>
  <para style="r">(<ref loc="LUK 9:49-50">Luk 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />Yoani mwabwɨra Yesʉ athɨ: «Mʉkangɨrɨtsya, mothʉshʉnga mʉndʉ mʉgʉma nɨabɨnga mʉtsɨmʉ kw'ɨtsɨna lyawe. Aho, ithwe mothʉmʉhangɨra kʉshangwa ɨye athalɨ w'omo kɨkembe kyethʉ.» <verse eid="MRK 9:38" /><verse number="39" style="v" sid="MRK 9:39" />Hewethuwe Yesʉ mwashubya athɨ: «Mʉthamʉhangɨraga, kʉshangwa hathalɨ mʉndʉ yo ʉkola bɨthɨko-thɨko kw'ɨtsɨna lyaye, oyo athangakotsya ɨshʉba negena kʉbɨ kw'ingye honyuma hake kw'aho. <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />Kʉshangwa yo uthathubayire nɨ alɨ ko lʉhande lwethʉ. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />N'omʉndʉ woshi-woshi yo wandabaha lwatha lwa metsi bʉshana nangye, kʉshangwa imwe mʉlɨ bandʉ ba Kirisito, kwenene enyɨbabwɨra, omʉndʉ oyo athɨndabʉshe ɨhabwa lʉhembo lʉwe.»<verse eid="MRK 9:41" /></para>
  <para style="s">Ɨyɨhɨgʉla ko bɨtsɨbʉ</para>
  <para style="r">(<ref loc="MAT 18:6-9">Mat 18:6-9</ref>; <ref loc="LUK 17:1-2">Luk 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />«Omʉndʉ woshi-woshi yo wandaleka mʉgʉma w'oko balere abo banyɨkɨrɨtsye aba nɨakola kɨtsɨbʉ, byangabere bɨbʉya kw'ɨye amɨnɨrweko lushyo<note caller="+" style="f"><char style="fr" closed="false">9:42 </char><char style="ft" closed="false">Lushyo: Soma Mat 18:6.</char></note> lʉnene mw'igosi n'ɨgʉshwa mo ngetsɨ.» <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />N'okʉboko kwawe kwamaleka nɨ wakola kɨtsɨbʉ, ʉtseko! Bikwirire kw'ɨwe ɨngɨra mo bʉyɨngo bw'ekwenene n'okʉboko kʉgʉma, kʉlenga ɨya kw'ɨrʉnga mo mʉtsanwa owathɨndatsɨme n'amaboko abɨrɨ. <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />[Omo mʉlɨ bɨhʉka bɨthafwa, na mʉtsanwa owathatsɨma<note caller="+" style="f"><char style="fr" closed="false">9:45 </char><char style="ft" closed="false">Amashako ano athalɨ mʉ wandɨ mashako mangɨ wa kera.</char></note>.] <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />N'okʉgʉlʉ kwawe nako kwamaleka nɨ wakola kɨtsɨbʉ, ʉtseko. Bikwirire kw'ɨwe ɨngɨra mo bʉyɨngo bw'ekwenene na kʉgʉlʉ kʉgʉma, kʉlenga kw'ɨgʉshwa mo mʉtsanwa owo kw'ɨrʉnga na magʉlʉ abɨrɨ. <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />[Omo mʉlɨ bɨhʉka bɨthafwa, na mʉtsanwa owathatsɨma<note caller="+" style="f"><char style="fr" closed="false">9:45 </char><char style="ft" closed="false">Amashako ano athalɨ mʉ wandɨ mashako mangɨ wa kera.</char></note>.] <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />N'elisho lyawe nalyo lwamaleka nɨ wakola kɨtsɨbʉ, ʉkʉlelyo. Bikwirire kw'ɨwe ɨngɨra mo <char style="w" lemma="Bwamɨ bwa Gongo">Bwamɨ bwa Gongo</char> n'elisho lɨgʉma, kʉlenga kw'ɨgʉshwa kw'ɨrʉnga na mesho abɨrɨ. <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />Omo mʉlɨ bɨhʉka bɨthafwa, na mʉtsanwa owathatsɨma<note caller="+" style="f"><char style="fr" closed="false">9:48 </char><char style="ft" closed="false">Soma Isaya 66:24.</char></note>. <verse eid="MRK 9:48" /><verse number="49" style="v" sid="MRK 9:49" />Kʉshangwa obʉlɨ mʉndʉ andetsɨbwa mw'itsukibwa mo mʉtsanwa, nga ko lʉhembo lw'esonyama s'erɨhembwa Gongo nga ko esɨnetsɨbwa mw'ihirwamo munyu<note caller="+" style="f"><char style="fr" closed="false">9:49 </char><char style="ft" closed="false">Abayuta abanagenda abahemba Gongo yo lʉhembo lwa kalyo, bagenda abetsya akalyo ako mw'ihira mʉko mo munyu. Soma Balawi 2:13. </char></note>.<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />«Omunyu nɨ kɨndʉ kikwirire. Hewethuwe omunyu amahetsya obʉshɨ bwawo, angahirwamo ki nɨmo ashʉba loka? Mubye munyu, na mwikale hagʉma mʉ bʉholo.»<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">Ihikya n'ɨkamba</para>
  <para style="r">(<ref loc="MAT 19:1-12">Mat 19:1-12</ref>; <ref loc="LUK 16:18">Luk 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Yesʉ mwathoka eyo, mwaya mo kɨhʉgo ky'iYuteya n'ɨshabʉkɨra ko ʉndɨ mwishirya w'eYorotani. Abere ahika eyo, mihindano mɨngɨ y'abandʉ moyahindana kandɨ embere sɨwe, naye mwathanga ɨkangɨrɨsyabo, nga ko abyaga abegere ɨkola. <verse eid="MRK 10:1" /><verse number="2" style="v" sid="MRK 10:2" /><char style="w" lemma="Bafarisayo">Bafarisayo</char> bagʉma mobamuhikira bʉshana n'ɨmʉlengako. Mobamʉbʉtsya bathɨ: «<char style="w" lemma="mʉgomba">Omʉgomba</char> ethʉ anahamulire omuyira ɨkamba mʉkatsɨwe?»<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />Yesʉ mwashʉbɨtsyabo athɨ: «Mʉsa mwabaha ithegeko lɨhe?»<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />Nabo mobamʉshʉbɨtsya bathɨ: «Mʉsa mwaha omuyira yo hamuli y'ɨshaka marʉba w'ɨkamba mʉkatsɨwe na honyuma kw'aho amʉhɨge<note caller="+" style="f"><char style="fr" closed="false">10:4 </char><char style="ft" closed="false">Soma Ɨbʉka Mʉgomba 24:1.</char></note>.»<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />Yesʉ mwabwɨrabo athɨ: «Mʉsa mwabashakɨra <char style="w" lemma="ithegeko">erithegeko</char> eryo bʉshana n'obʉkalwe bw'emɨthɨma enyu. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />Hewethuwe ko ndangɨro y'erɨhangɨka ebɨndʉ byoshi, Gongo mwabʉmba muyira na mʉkatsɨ. <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />Bʉshana n'ekyo, omuyira andamika ishe na nyinya n'ɨmathana na mʉkatsɨwe, <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />n'ababɨrɨ bandabya mʉbɨrɨ mʉgʉma. Aho nɨ bathakɨrɨ babɨrɨ, hewethuwe ni babya mʉbɨrɨ mʉgʉma. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Ewo bʉshana n'ekyo, omʉndʉ athamathʉlaga ekyo Gongo amathanaya.»<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />Yesʉ n'abɨga bʉwe babere bashʉba mo nyʉmba, abɨga bʉwe mobamʉbʉtsya kandɨ bʉshana n'ekɨnwa ekyo. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />Yesʉ mwabwɨrabo athɨ: «Obʉlɨ mʉndʉ yo ʉkamba mʉkatsɨwe n'ihikya ʉndɨ, nɨamakolera mʉkatsɨwe mʉmbere yo rʉsɨngɨ. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />N'omʉkatsɨ naye kuthyo amamika iba ʉwe n'ihikibwa na ʉndɨ muyira, nɨamasɨngɨra.»<verse eid="MRK 10:12" /></para>
  <para style="s">Yesʉ agashanɨra abana</para>
  <para style="r">(<ref loc="MAT 19:13-15">Mat 19:13-15</ref>; <ref loc="LUK 18:15-17">Luk 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Kɨro kɨgʉma, bandʉ bagʉma mobalethera Yesʉ yo bana bʉshana ahire kʉbo kw'eminwe, hewethuwe abɨga bʉwe mobakemera abandʉ abo. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />Yesʉ abere ashʉnga athyo, mwahɨthana n'ɨbwɨra abɨga bʉwe athɨ: «Mulike abana bahike yo nyɨrɨ. Kandɨ mʉthakɨkɨragabo, kʉshangwa <char style="w" lemma="Bwamɨ bwa Gongo">oBwamɨ bwa Gongo</char> nɨ bwa abandʉ abalɨ ng'abo. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />Kwenene enyɨbabwɨra: obʉlɨ mʉndʉ yo uthangirire oBwamɨ bwa Gongo ng'omwana mʉlere, athɨndɨngɨre mʉbo na hake.» <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Honyuma kw'aho, mwafʉmbatha abana abo, mwahira eminwe yo kʉbo n'ɨgashanɨrabo.<verse eid="MRK 10:16" /></para>
  <para style="s">Yesʉ na mʉsole mʉgʉma mushoki</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mat 19:16-30</ref>; <ref loc="LUK 18:18-30">Luk 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Yesʉ abere alotsya ebʉshondotsɨ mo lʉgendo lʉwe, mʉndʉ mʉgʉma mwamuhikira tsʉba n'ɨfʉkama embere sɨwe n'ɨmʉbʉtsya athɨ: «Mʉkangɨrɨtsya mʉbʉya, nyɨyɨre nyɨthɨ bʉshana nyɨbone obʉyɨngo bwa kera n'ekera?»<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />Yesʉ mwamʉshʉbɨtsya athɨ: «Bʉshana na ki ogʉnyahʉlamo mʉbʉya? Hathalɨ mʉndʉ mʉbʉya, athalɨ Gongo mʉsha. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />Unetsi ko amathegeko anegenire athɨ: “Uthithaga, ʉthasɨngɨraga, uthibaga, ʉthalegaga mʉndʉ, ʉthathɨmaga, ushikye sho na nyoko.”»<verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />Omʉndʉ oyo mwamʉshʉbɨtsya athɨ: «Mʉkangɨrɨtsya, nyishikitsye amathegeko woshi ayo ɨthanga mo bʉtsana bwaye.»<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />Yesʉ mwamʉkebera mʉ lwanzo, n'ɨmʉbwɨra athɨ: «Ubushire kɨndʉ kɨgʉma kɨsha. Enda ʉyagʉtsye ebɨndʉ byawe byoshi, n'esofaranga so sathoka kʉbyo ʉgabɨretho abatsene. Nawe wayɨra bushoki mo lʉbʉla. Honyuma kw'aho uhike, ʉnyɨkwame!» <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />Hewethuwe omʉndʉ oyo abere onvwa ebɨnwa ebyo, mwafʉnya obʉsʉ, n'ɨyɨendera mw'ɨhononokala, bʉshana abyaga mushoki kʉtsɨbʉ. <verse eid="MRK 10:22" /><verse number="23" style="v" sid="MRK 10:23" />Yesʉ mwakebera abɨga bo babyaga bamuthimbireko n'ɨbwɨrabo athɨ: «Kwenene bitsibuhire ko bashoki erɨngɨra mo <char style="w" lemma=" Bwamɨ bwa Gongo">Bwamɨ bwa Gongo</char>!»<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />Abɨga babere bonvwa ebɨnwa ebyo, mobashweka kʉtsɨbʉ. Hewethuwe Yesʉ mwashʉba bwɨrabo athɨ: «Bana baye, bitsibuhire kundu erɨngɨra mo <char style="w" lemma=" Bwamɨ bwa Gongo">Bwamɨ bwa Gongo</char>! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />Byanguhire kʉtsɨbʉ ko ngamɨa ɨtsʉka mo kyuna ky'enandi kʉlenga omushoki erɨngɨra mo <char style="w" lemma=" Bwamɨ bwa Gongo">Bwamɨ bwa Gongo</char>.»<verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />Abɨga babere bonvwa ebɨnwa ebyo mobashʉba shweka ihika ko kɨka mobathanga ibutsania ɨbo kw'ɨbo bathɨ: «Ewono, nɨ ndɨ yo wangashabʉlwa?»<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />Yesʉ mwahanda kʉbo kw'amesho n'ɨbwɨrabo athɨ: «Ko bandʉ bɨthathokekene, hewethuwe kʉ Gongo ko bɨthalɨ bithyo, kʉshangwa ebyoshi bɨthokekene kw'ɨye.»<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />Petero mwamʉbwɨra athɨ: «Lola, ithwe thwamamika ebyoshi n'ɨkʉkwama!»<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />Yesʉ mwashubya athɨ: «Kwenene enyɨbabwɨra: kw'omʉndʉ amamika enyʉmba yɨwe, kʉtse bagala babo, kʉtse balɨ babo, kʉtse nyinya, kʉtse ishe, kʉtse abana bʉwe kʉtse mashwa ʉwe bʉshana nangye na bʉshana n'eNgʉlʉ Mbʉya, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />andahamba ngendo igana kalengyo mo mʉgʉlʉ ono. Na andahamba manyʉmba, na bagala babo, na balɨ babo, na nyinya, na bana. Hagʉma n'ebyoshi ebyo, andabona na malɨgo ko kɨhʉgo kɨno. Na mo mʉgʉlʉ owandahika andahamba bʉyɨngo bwa kera n'ekera. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />Hewethuwe bangɨ bo balɨ bambere-mbere munobwire, bandabya banyuma-nyuma, na bangɨ bo balɨ banyuma-nyuma munobwire, bandabya bambere-mbere.»<verse eid="MRK 10:31" /></para>
  <para style="s">Yesʉ amɨnyɨsa ngendo lya kashathʉ olʉholo n'erilubuka lɨwe</para>
  <para style="r">(<ref loc="MAT 20:17-19">Mat 20:17-19</ref>; <ref loc="LUK 18:31-34">Luk 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />Yesʉ n'abɨga bʉwe babere balɨ mo nzɨra, balɨ abɨrʉkɨra ɨYerʉsalemʉ, ɨye mwabya embere kʉbo. Abɨga babyaga nɨbamatsɨmbwa n'obʉba, n'abandʉ bo babyaga bakwamirebo mobatsɨmbwa n'obʉba. Yesʉ mwashʉba tsɨmba abɨga bʉwe ikumi na babɨrɨ, n'ɨthanga ɨsɨmolerabo bʉshana n'ebɨndʉ byo byamuhikira. <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />Yesʉ mwabwɨrabo athɨ: «Mwonvwe! Ithwe bano othwɨrʉkɨra ɨYerʉsalemʉ. N'eyo oMʉgala w'oMʉndʉ ahotherwa ko <char style="w" lemma="Baheri Bakʉlʉ">Baheri Bakʉlʉ</char> n'oko <char style="w" lemma="Bakangɨrɨtsya Omʉgomba">Bakangɨrɨtsya b'oMʉgomba</char>. Nabo bandamʉsohera ithwa n'imuhira mo minwe y'abandʉ b'ebɨhanda. <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />N'abandʉ abo bandamʉshekeretsya, n'ɨmʉtsɨrako mathandɨ, bandamuhumba mbasha n'imwitha. Hewethuwe ko kɨro kya kashathʉ honyuma w'olʉholo lʉwe, andalubuka.»<verse eid="MRK 10:34" /></para>
  <para style="s">Yakobo na Yoani abashaba bʉkʉlʉ</para>
  <para style="r">(<ref loc="MAT 20:20-28">Mat 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Honyuma kw'aho, bagala babɨrɨ ba Sebetayo, ye Yakobo bana Yoani, mobahikira Yesʉ n'ɨmʉbwɨra bathɨ: «Mʉkangɨrɨtsya, othushondya ʉthʉkolere ekɨnwa kyo thwakʉshaba.» <verse eid="MRK 10:35" /><verse number="36" style="v" sid="MRK 10:36" />Yesʉ mwabʉtsyabo athɨ: «Omushondya nyɨbakolere ki?» <verse eid="MRK 10:36" /><verse number="37" style="v" sid="MRK 10:37" />Nabo mobamʉshʉbɨtsya bathɨ: «Wandabya wabya mo lʉkengerwa lwawe, ʉthʉtsɨɨre ikala hagʉma nawe, mʉgʉma ko lʉhande lwawe lw'amalyo n'ogʉndɨ ko lʉhande lwawe lw'amalembe.» <verse eid="MRK 10:37" /><verse number="38" style="v" sid="MRK 10:38" />Hewethuwe Yesʉ mwabwɨrabo athɨ: «Muthetsi ekɨndʉ omʉshaba. mwanganakotsya ɨshoma olwatha lw'amalɨgo olo nyashoma? Kʉtse mwanganakotsya ibatisibwa ko lubatiso lwa malɨgo olo nyabatisibwako?» <verse eid="MRK 10:38" /><verse number="39" style="v" sid="MRK 10:39" />Nabo mobamʉshʉbɨtsya bathɨ: «Ega, thwangakotsya.»</para>
  <para style="p" vid="MRK 10:39">Yesʉ mwashʉba bwɨrabo athɨ: «Kwenene mwashoma olwatha olo nyashoma, n'ibatisibwa nga ko nyabatisibwa<note caller="+" style="f"><char style="fr" closed="false">10:39 </char><char style="ft" closed="false">Olubatiso lo nyabatisibwako: Nɨ negena mbʉ olʉholo lwa Yesʉ.</char></note>. <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />Hewethuwe ikatsya bandʉ ko lʉhande lwaye lw'amalyo, kʉtse lw'amalembe, oyo athalɨ mʉlɨmo aye. Nɨ Gongo ɨye mʉsha yo wandahira abandʉ abo athegekanaya mo myanya eyo.»<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />Abandɨ bɨga ikumi babere bonvwa ebɨnwa ebyo, mobapona Yakobo na Yoani. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />Bʉshana n'ekyo, Yesʉ mwabɨrɨkɨra aboshi n'ɨbwɨrabo athɨ: «Munetsi ko abo bashungikire nga bathegeki b'ebɨhanda abanathegekabyo mʉ kahatho, n'abakʉlʉ babo abanikala kʉbo. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />Hewethuwe bɨthagenda ebibya bithyo mo kathi kenyu. Oyo ushondya ibya mʉkʉlʉ mo kathi kenyu, lɨtholere niabya mukoli enyu. <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />N'oyo ushondya ibya mʉmbere, lɨtholere niabya <char style="w" lemma="mʉkobe">mʉkobe</char> wa boshi. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Kʉshangwa oMʉgala w'oMʉndʉ athahikaga bʉshana n'ɨkolerwa, hewethuwe ɨkolerana n'ɨhana obʉyɨngo bʉwe bʉshana ashabʉle bandʉ bangɨ<note caller="+" style="f"><char style="fr" closed="false">10:45 </char><char style="ft" closed="false">Soma 14:24.</char></note>.»<verse eid="MRK 10:45" /></para>
  <para style="s">Yesʉ alamya embumi Barɨtolomayo</para>
  <para style="r">(<ref loc="MAT 20:29-34">Mat 20:29-34</ref>; <ref loc="LUK 18:35-43">Luk 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Honyuma kw'aho Yesʉ n'abɨga bʉwe mobahika iYeriko. Na mo ndambi babere balɨ abathoka mo muyi oyo, muhindano mʉnene w'abandʉ mobamʉkwama. Mbumi ngʉma yo yahʉlawamo Barɨtolomayo mʉgala wa Timayo, abyaga n'ikere ko mʉsɨke w'enzɨra alɨ ahemeretsya. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />Abere onvwa ko Yesʉ w'iNasareti yo ʉtsʉka, mwahambala nɨanegena athɨ: «Yesʉ Mʉgala wa Tawiti, ʉnyɨfwɨre shashi!» <verse eid="MRK 10:47" /><verse number="48" style="v" sid="MRK 10:48" />Bandʉ bangɨ mobamʉkemera bathɨ atsɨre. Hewethuwe mwashʉba hambala kʉtsɨbʉ athɨ: «Mʉgala wa Tawiti, nyɨfwɨre shashi!» <verse eid="MRK 10:48" /><verse number="49" style="v" sid="MRK 10:49" />Yesʉ mwimana n'ɨnegena athɨ: «Mʉmʉbɨrɨkɨre.» Aho abandʉ mobabɨrɨkɨra embumi eyo n'ɨmʉbwɨra bathɨ: «Shikya omʉthɨma! Wimana, amakʉbɨrɨkɨra.» <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />Barɨtolomayo mwagʉsha ekoti yɨwe, mwahuthuka tsʉba na mwagendera Yesʉ. <verse eid="MRK 10:50" /><verse number="51" style="v" sid="MRK 10:51" />Yesʉ mwamʉbʉtsya athɨ: «Ushondya nyɨkʉkolere ki?» Embumi eyo moyamʉshʉbɨtsya yɨthɨ: «<char style="w" lemma="Mʉkangɨrtɨtsya">Mʉkangɨrɨtsya</char>, enyishondya nyɨlole.» <verse eid="MRK 10:51" /><verse number="52" style="v" sid="MRK 10:52" />Yesʉ mwamʉbwɨra athɨ: «Ʉyɨgendere, olwɨkɨrɨtsyo lwawe lwamakulamya.» Aho n'aho mwalola n'ɨkwama Yesʉ mo nzɨra.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">Yesʉ ɨngɨra mo muyi w'ɨYerʉsalemʉ</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mat 21:1-11</ref>; <ref loc="LUK 19:28-40">Luk 19:28-40</ref>; <ref loc="JHN 12:12-19">Yoa 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Yesʉ n'abɨga bʉwe mobahika hofɨ n'omuyi w'ɨYerʉsalemʉ, ko mʉnda w'omuyi w'ɨBetefake na w'ɨBetanɨa, hofɨ n'ekɨthwa ky'eMiseituni. Yesʉ mwathʉma babɨrɨ b'oko bɨga bʉwe. <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />Mwabwɨrabo athɨ: «Mʉgende mo muyi owalɨ embere senyu. Mo ndambi mwabya mwahika mʉwo, mweya kyana kya pʉnda kihangirwe, na kɨthahera kyathashambwako na mʉndʉ. Mʉmɨnʉlekyo na mʉnyɨretherekyo hano. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />Na mʉndʉ amababʉtsya athɨ: “Bʉshana na ki ʉmʉkola muthyo? Mʉmʉshʉbɨtsye mʉthɨ Nyinya-kowethʉ alayire kw'ɨkolesakyo, ashʉbʉtsyakyo tsʉba.”»<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />Abɨga abo mobagenda, mobeya ekyana ky'epʉnda ekyo nɨ kihangirwe embʉga, hofɨ n'oluyi lwa nyʉmba emʉsɨke w'enzɨra. Babere balɨ abahangʉlakyo, <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />bagʉma mo bandʉ bo babyaga aho mobabʉtsyabo bathɨ: «Imwe! Bʉshana na ki omʉhangʉla ekyana ky'epʉnda eki?» <verse eid="MRK 11:5" /><verse number="6" style="v" sid="MRK 11:6" />Mobashʉbɨtsyabo nga ko Yesʉ athabwɨrabo. N'abandʉ abo mobalikabo bagende. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Mobalethera Yesʉ y'ekyana ky'epʉnda n'ɨshesha esongɨmba sabo so kʉkyo. Na Yesʉ mwikala kʉkyo<note caller="+" style="f"><char style="fr" closed="false">11:7 </char><char style="ft" closed="false">Soma Sakarɨa 9:9.</char></note>. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Bandʉ bangɨ mobashesha esongɨmba sabo mo nzɨra, n'abandɨ mobayatsa mathahɨ w'emɨthɨ nabo mobasheshawo mo nzɨra<note caller="+" style="f"><char style="fr" closed="false">11:8 </char><char style="ft" closed="false">Ɨshesha esongɨmba so mo nzɨra: Abayuta bagenda abakola bathyo balɨ abakokya mwamɨ kʉtse mʉndʉ mʉkʉlʉ.</char></note> bʉshana Yesʉ atsʉke kʉwo. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Abandʉ bo bathangaga Yesʉ y'embere n'abo bamʉkwamaga enyuma, mobathanga ɨhambala mʉ mʉlenge mʉnene bathɨ:</para>
  <para style="q1" vid="MRK 11:9">«Hosana<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="ft" closed="false">Hosana mo Kɨebʉranɨa n'ɨnegena mbʉ: Ʉthʉshabʉle lero.</char></note>!</para>
  <para style="q1" vid="MRK 11:9">Agashanɨrwe</para>
  <para style="q1" vid="MRK 11:9">yo uhika kw'ɨtsɨna lya Nyinya-kowethʉ<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="ft" closed="false">Soma Saburi 118:25-26.</char></note>!<verse eid="MRK 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10" />Bʉgashanɨrwe obwamɨ bo buhika,</para>
  <para style="q1" vid="MRK 11:10">obwamɨ bwa thatha-kʉlʉ Tawiti!</para>
  <para style="q1" vid="MRK 11:10">Hosana kʉ Gongo yo ʉlɨ elʉgʉlʉ mo <char style="w" lemma="lʉbʉla">lʉbʉla</char><note caller="+" style="f"><char style="fr" closed="false">11:10 </char><char style="ft" closed="false">Soma Mat 21:9 n'ebyo bishakirwe.</char></note>!»<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />Yesʉ abere ahika mo muyi w'ɨYerʉsalemʉ mwɨngɨra mo <char style="w" lemma="Nyʉmba ya Gongo">Nyʉmba ya Gongo</char>. Abere amamala ɨshʉnga ebɨndʉ byoshi ko mbande soshi, mwathokamo n'ɨgenda ɨBetanɨa hagʉma n'abɨga bʉwe ikumi na babɨrɨ, kʉshangwa bwabyaga nɨ bwamamala ɨkʉra.<verse eid="MRK 11:11" /></para>
  <para style="s">Yesʉ athakɨra omʉthɨ w'omutini</para>
  <para style="r">(<ref loc="MAT 21:18-19">Mat 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Bwabere bwakya, mo ndambi bagenda abathoka ɨBetanɨa, Yesʉ mwafwa nzala. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Mwashʉngɨra mʉthɨ wa mutini wo hale owalɨko bɨthɨ bɨngɨ. Aho mwaya shʉnga nga ng'anabona kʉwo ko biguma. Hewethuwe abere ahika hofɨ nawo, mwathashʉnga kʉwo ko kɨndʉ bɨthalɨ ebɨthɨ bɨsha, kʉshangwa kithabyaga kɨrɨmo kyawo ky'erɨheka biguma. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Aho Yesʉ mwathakɨra omʉthɨ oyo athɨ: «Ɨthanga munobwire n'erihika kera na kera, hathandashubabya kiro na mʉndʉ n'omʉgʉma yo wandalya biguma kw'ɨwe.» N'abɨga bʉwe mobonvwa ebɨnwa ebyo anegenaga.<verse eid="MRK 11:14" /></para>
  <para style="s">Yesʉ ahɨga abahingania mo Nyʉmba ya Gongo</para>
  <para style="r">(<ref loc="MAT 21:12-17">Mat 21:12-17</ref>; <ref loc="LUK 19:45-48">Luk 19:45-48</ref>; <ref loc="JHN 2:13-22">Yoa 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Honyuma kw'aho, Yesʉ n'abɨga bʉwe mobahika mo muyi w'ɨYerʉsalemʉ. Aho mwɨngɨra mo mbʉga y'e<char style="w" lemma="Nyʉmba ya Gongo">Nyʉmba ya Gongo</char>, n'ɨthanga ɨhɨga abandʉ bo bagenda abagʉtsya n'ɨgʉla ebɨndʉ byabo mo <char style="w" lemma="Nyʉmba ya Gongo">Nyʉmba ya Gongo</char>. Mwabɨndʉngʉla esonyɨgalɨ sabo bagenda abahingania esofaranga n'ebifumbi by'abahingania b'othulikuku. <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />Na kuthyo mwahangɨra abandʉ ɨheka obʉlɨ kɨndʉ kyoshi-kyoshi n'ɨtsʉka nakyo mo mbʉga y'e<char style="w" lemma="Nyʉmba ya Gongo">Nyʉmba ya Gongo</char>. (Image WA03896btif) <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Honyuma kw'aho, mwakangɨrɨtsyabo n'ɨbwɨrabo athɨ: «Kushakirwe mo Mashako Abuyirire kʉthɨ: “eNyʉmba aye yandahʉlwamo nyʉmba ya mɨshabe ko bɨhanda byoshi.” Hewethuwe imwe mwamabɨndʉlaro mo kabishamo k'abashamuli<note caller="+" style="f"><char style="fr" closed="false">11:17 </char><char style="ft" closed="false">Soma Isaya 56:7; Yeremia 7:11.</char></note>!» <verse eid="MRK 11:17" /><verse number="18" style="v" sid="MRK 11:18" /><char style="w" lemma="Abaheri bakʉlʉ">Abaheri bakʉlʉ</char> n'<char style="w" lemma="aBakangɨrɨtsya b'oMʉgomba">aBakangɨrɨtsya b'oMʉgomba</char> babere bonvwa omwatsɨ oyu, mobashondya mwanya w'eritha Yesʉ. Hewethuwe mobamʉbaha, kʉshangwa omuhindano woshi w'abandʉ bagenda abashwekera amakangɨrɨtsya ʉwe. <verse eid="MRK 11:18" /><verse number="19" style="v" sid="MRK 11:19" />Bwabere bwahika igolo, Yesʉ n'abɨga bʉwe mobathoka mo muyi oyo.<verse eid="MRK 11:19" /></para>
  <para style="s">Makangɨrɨtsya ko mʉthɨ w'omutini</para>
  <para style="r">(<ref loc="MAT 21:20-22">Mat 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Bwabere bwakya mo mambya, Yesʉ n'abɨga bʉwe babere balɨ abatsʉka, mobashʉnga omʉthɨ w'omutini oyo nɨamʉma owoshi, ihika ko mirihi yawo. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Petero mwɨbʉka ko Yesʉ mwathakɨra omʉthɨ oyo. Aho mwabwɨra Yesʉ athɨ: «<char style="w" lemma="Mʉkangɨrɨtsya">Mʉkangɨrɨtsya</char>, shʉnga, omʉthɨ w'omutini wo wathakɨraga amalire ʉma.» <verse eid="MRK 11:21" /><verse number="22" style="v" sid="MRK 11:22" />Yesʉ mwabwɨra abɨga bʉwe athɨ: «Mwɨkɨrɨtsye Gongo. <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />Kwenene enyɨbabwɨra nyɨthɨ: “Omʉndʉ angabwɨra ekɨthwa eki athɨ thoka hano na ʉyɨgʉshe mo ngetsɨ.” Na amabya alɨanegena ebɨnwa ebyo bʉtsɨra ɨthɨka-thɨka mo mʉthɨma ʉwe, hewethuwe amɨkɨrɨtsya ko ekɨnwa ekyo amanegena kyakoleka, kwenene nɨahabwakyo. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Nɨ bʉshana n'ekyo enyɨbabwɨra nyɨthɨ, mʉlɨ omʉshaba bʉshana na mʉlawo wa kɨndʉ kɨrebe, mwɨkɨrɨtsye ko mwamamala ɨbonakyo, n'ekyo nɨ mwahabwakyo. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />Na omunabya mwimana bʉshana n'ɨshaba, mwamabya mʉlɨ na kɨnwa na ʉndɨ mʉndʉ, mʉmʉganyɨre, nɨmo Thatha wenyu yo ʉlɨ mo lʉbʉla, abaganyɨre kuthyo ebɨbɨ byenyu. [<verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />Hewethuwe muthaganyire abandɨ, Thatha wenyu yo ʉlɨ mo lʉbʉla naye nɨathɨbaganyɨre nemwe ebɨbɨ byenyu kuthyo<note caller="+" style="f"><char style="fr" closed="false">11:26 </char><char style="ft" closed="false">Omʉlondo ono athalɨ mʉ wandɨ mashako w'ekikiriki.</char></note>.»]<verse eid="MRK 11:26" /></para>
  <para style="s">Amaka wa Yesʉ athoka hayi?</para>
  <para style="r">(<ref loc="MAT 21:23-27">Mat 21:23-27</ref>; <ref loc="LUK 20:1-8">Luk 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Yesʉ n'<char style="w" lemma="abɨga">abɨga</char> bʉwe mobashʉba kandɨ mo muyi w'ɨYerʉsalemʉ. Yesʉ abere alɨ athimba mo mbʉga y<char style="w" lemma="Nyʉmba ya Gongo">eNyʉmba ya Gongo</char>, <char style="w" lemma="Baheri Bakʉlʉ">aBaheri Bakʉlʉ</char>, n'<char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">aBakangɨrɨtsya b'oMʉgomba</char> hagʉma n'abakʉlʉ b'abandʉ, mobamuhikira. <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />Mobamʉbʉtsya bathɨ: «Oʉkola ebɨndʉ ebi kʉ maka ahɨ? Na nɨ ndɨ yo wakʉhaga amaka aya?» <verse eid="MRK 11:28" /><verse number="29" style="v" sid="MRK 11:29" />Yesʉ mwashʉbɨtsyabo athɨ: «Nyababʉtsya ɨbʉtsyo ɨgʉma bʉsha. Mwamanyɨshʉbɨtsya, nangye kuthyo nyababwɨra nga nɨ kʉ maka ahɨ kw'enyɨkola ebɨndʉ bɨno. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />Mʉnyɨshʉbɨtsye! Yoani abonaga amaka w'eribatisya wo hayi? Kʉ Gongo kʉtse ko bandʉ?» <verse eid="MRK 11:30" /><verse number="31" style="v" sid="MRK 11:31" />Nabo mobathanga ibutsania ɨbo kw'ɨbo bathɨ: «Thwamashubya thʉthɨ: “Amaka ʉwe athokaga ewa Gongo,” athʉbʉtsya athɨ: “Bʉshana na ki momʉthamwɨkɨrɨtsya?” <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Na kuthyo thʉthangakotsya ɨnegena thʉthɨ: “Athokaga kʉ bandʉ.”» Bagenda abanegena ebyo kʉshangwa mobʉbaha omuhindano w'abandʉ, kʉshangwa aboshi babyaga nɨbɨkɨrɨtsye ko Yoani nɨ mʉmɨnyeretsɨ wa kwenene. <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />Aho mobashʉbɨtsya Yesʉ bathɨ: «Thuthetsi.»</para>
  <para style="p" vid="MRK 11:33">Naye mwabwɨrabo athɨ: «Nangye kuthyo nyɨthɨbabwɨre nga nɨ kʉ maka ahɨ w'enyɨkolako ebɨndʉ bɨno.»<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">Mushinga wa balimi babɨ</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mat 21:33-46</ref>; <ref loc="LUK 20:9-19">Luk 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Honyuma kw'aho Yesʉ mwathanga ɨnegena na bandʉ mʉ <char style="w" lemma="mishinga">mishinga</char> athɨ: «Mʉndʉ mʉgʉma mwahera ɨshwa lya <char style="w" lemma="misabibu">misabibu</char>. Erɨshwa eryo mwathimbya kʉlyo ko lʉgʉthʉ, mwathima kyuna ky'erɨkamɨramo ebiguma by'emisabibu na mwahimba kathegeryo<note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="ft" closed="false">Soma Isaya 5:1-2.</char></note> k'abatheya b'erɨshwa. Honyuma kw'aho mwakondesalyo ku bahingi, na mwagenda lʉgendo. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />Ebɨro by'erɨhʉlʉla byabere byahika, mwathʉma mʉgʉma w'oko bakoli bʉwe ko balimi abo, bʉshana bamʉhe engemo y'erɨshwa lɨwe. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Hewethuwe abalimi abo mobatsɨmba omukoli oyo, mobamuhumba n'ɨmʉshʉbʉtsya minwe mɨsha. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Omwenye erɨshwa mwathʉmɨrabo kandɨ ʉndɨ mukoli. Oyo naye, mobamuhuma ko muthwe n'ɨmʉsʉnzʉgʉra. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />Omwenye erɨshwa mwashʉba thʉmɨrabo ʉndɨ mukoli, oyo mobamwitha. Na honyuma kw'aho mwathʉma bandɨ bakoli bangɨ, abalimi abo mobahumba bagʉma n'itha abandɨ. <verse eid="MRK 12:5" /><verse number="6" style="v" sid="MRK 12:6" />Omwenye erɨshwa abyaga niakishibya na mʉgala ʉwe mʉtsɨɨrwa kuroshi. Ko nduli mwamʉthʉma kʉbo, n'ɨnegena athɨ: “Nyetsi ko mʉgala aye ɨye bamushikya.” <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" />Hewethuwe abalimi abo mobabwɨrana ɨbo kw'ɨbo bathɨ: “Shʉnga! Oyo yo wandashiba n'omwandʉ w'erɨshwa lɨno. Ewo kwenzi thumwithe, n'erɨshwa lɨno lyabya mwandʉ ethʉ!” <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />Aho mobatsɨmba mʉgala ʉwe oyo mobamwitha n'ɨgʉsha ekinda kɨwe ky'emʉsɨke w'erɨshwa.»<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />Honyuma kw'aho Yesʉ mwabʉtsya athɨ: «Ewono omwenye erɨshwa ly'emisabibu oyo andakola ki? Ɨye andahika n'itha abalimi abo. Na honyuma kw'aho andaha erɨshwa eryo lyo bandɨ balimi.» <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />Yesʉ mwabwɨrabo athɨ: «Mʉthahera mwathasoma aMashako Abuyirire owanegenire athɨ:</para>
  <para style="q1" vid="MRK 12:10">“Eribwe lyo lyathɨndawa n'abahimbi,</para>
  <para style="q1" vid="MRK 12:10">lyo lyabere ibwe inene ly'ekoni.<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />Ni Nyinya-kowethʉ yo wakolaga ekɨnwa kɨno,</para>
  <para style="q1" vid="MRK 12:11">nakyo nɨ ky'erishwekya kʉtsɨbʉ kw'ithwe<note caller="+" style="f"><char style="fr" closed="false">12:11 </char><char style="ft" closed="false">Soma Saburi 118:22-23.</char></note>.”»<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />Aho abaheri bakʉlʉ abo mobashondya ɨtsɨmba Yesʉ, kʉshangwa mobamɨnya ko mwanegena omushinga oyo bʉshana nabo. Hewethuwe kʉshangwa mobʉbaha omuhindano w'abandʉ, mobamulika na mobayɨgendera.<verse eid="MRK 12:12" /></para>
  <para style="s">Erɨrɨha ekoli ya Kaisari</para>
  <para style="r">(<ref loc="MAT 22:15-22">Mat 22:15-22</ref>; <ref loc="LUK 20:20-26">Luk 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Honyuma kw'aho, <char style="w" lemma="Bafarisayo">Bafarisayo</char> bagʉma na bandʉ bagʉma bo bayihiraga hagʉma na Herote mobathʉmwa kʉ Yesʉ bʉshana bamʉthege mʉthego mo bɨnwa ebyo anegena. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />Abandʉ abo mobabʉtsya bathɨ: «<char style="w" lemma="Mʉkangɨrɨtsya">Mʉkangɨrɨtsya</char>, thwetsi kw'ɨwe ʉlɨ mʉndʉ wa kwenene. Na kuthyo ʉthatsomene mɨganɨtsye ya mʉndʉ, hewethuwe ʉnakangɨrɨtsya ko kwenene enzɨra Gongo ahamulire ɨkwama. Ingo thʉbwɨre, <char style="w" lemma="mʉgomba">oMʉgomba</char> anathuhamulire ɨrɨha ekoli ya Kaisari kʉtse ɨhɨ? Thʉtholere nɨ thwafʉharo kʉtse ɨhɨ?»<verse eid="MRK 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15" />Hewethuwe kʉshangwa Yesʉ mwamɨnya kw'ɨbo nɨ bayimbya, mwabwɨrabo athɨ: «Bʉshana na ki omʉnyɨrengako? Mʉnyɨrethere kɨtsere kɨgʉma kya faranga hano bʉshana nyɨlole kʉkyo.»<verse eid="MRK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16" />Mobamʉletherakyo. Yesʉ mwabʉtsyabo athɨ: «Eshoshani eno n'erɨtsɨna lɨno ebishakirwe hano nɨ bya ndɨ?»</para>
  <para style="p" vid="MRK 12:16">Mobamʉshʉbɨtsya bathɨ: «Nɨ bya Kaisari.»<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />Aho Yesʉ mwabwɨrabo athɨ: «Mʉgende omʉha Kaisari y'ebɨwe, na mʉgende omʉha Gongo y'ebɨwe.» Nabo mobashwekera kʉtsɨbʉ emɨshʉbɨtsye yɨwe.<verse eid="MRK 12:17" /></para>
  <para style="s">Abandʉ ababʉtsya bʉshana n'erilubuka</para>
  <para style="r">(<ref loc="MAT 22:23-33">Mat 22:23-33</ref>; <ref loc="LUK 20:27-40">Luk 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />Honyuma w'ebyo, <char style="w" lemma="Basandukayo">Basandukayo</char> bagʉma mobahikira Yesʉ. Nɨ <char style="w" lemma="Basandukayo">aBasandukayo</char> abo bo bananegena bathɨ abaholi bathindalubuke. Mobamʉbʉtsya bathɨ: <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />«<char style="w" lemma="Mʉkangɨrɨtsya">Mʉkangɨrɨtsya</char>, Mʉsa mwathʉshakɨra mo <char style="w" lemma="Mʉgomba">Mʉgomba</char> athɨ: “Omʉndʉ amabya awithe mʉgalabo, naye amafwa n'ishiga mʉkatsɨwe buthashiga mwana, mʉgalabo angɨngɨrɨra omʉshʉmbakatsɨ oyo bʉshana abʉthɨre mʉgalabo yo wafwaga yo bana<note caller="+" style="f"><char style="fr" closed="false">12:19 </char><char style="ft" closed="false">Soma Ɨbʉka mʉgomba 25:5-6.</char></note>.” <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Aho, kwabyaga bandʉ balɨnda ba mʉ nda ngʉma. Kambere mwahikya mʉkatsɨ, hewethuwe mwafwa bʉtsɨra imika mwana. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Mʉlʉmʉna ʉwe mw'ɨngɨrɨra omʉkatsɨ oyo, naye mwafwa kuthyo bʉtsɨra imika mwana. Na mobyabya bithyo kʉ mʉgalabo wa kashathʉ, <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />n'ihika ko balɨnda boshi. Aboshi mobahikya omʉkatsɨ oyo, bʉlɨ mʉgʉma honyuma w'olʉholo lwa mulikyabo, hewethuwe mobafwa bʉtsɨra imika bana. Na ko nduli, omʉkatsɨ oyo naye mwafwa. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Ewono, ekɨro abaholi bandalubuka, omʉkatsɨ oyo andabya wa ndɨ? Kʉshangwa abalɨnda boshi babyaga nɨ bamamuhikya!»<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />Yesʉ mwashʉbɨtsyabo athɨ: «Mwamayɨthɨma bʉshana n'obʉthamɨnya aMashako Abuyirire kʉtse amaka wa Gongo. <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />Kʉshangwa abaholi bandabya balubuka, bandabyaho nga <char style="w" lemma="malaɨka">abamalaɨka</char> ko balɨho mo lʉbʉla. Bathindahikye kʉtse ihikibwa. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />Na bʉshana n'erilubuka ly'abaholi, mʉthahera mwathasoma mo kɨtabo ky'<char style="w" lemma="Mʉgomba">oMʉgomba</char> wa Mʉsa, ebyo aMashako owanegenire bʉshana n'ekɨkala kyo kyagenda ekɨgʉlɨmɨra? Gongo mwabwɨra Mʉsa athɨ: “Ingye ngyo Gongo wa Abʉrahamʉ, Gongo wa Isaka na Gongo wa Yakobo<note caller="+" style="f"><char style="fr" closed="false">12:26 </char><char style="ft" closed="false">Soma ɨthoka 3:2-6.</char></note>!” <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Yesʉ mwashʉba bwɨrabo athɨ: “Gongo athalɨ Gongo w'abaholi, hewethuwe nɨ Gongo w'abalɨho. Imwe mwamayɨthɨma kundu.”»<verse eid="MRK 12:27" /></para>
  <para style="s">Erithegeko inene kʉlenga awandɨ</para>
  <para style="r">(<ref loc="MAT 22:34-40">Mat 22:34-40</ref>; <ref loc="LUK 10:25-28">Luk 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />
    <char style="w" lemma="Mʉkangɨrɨtsya">Mʉkangɨrɨtsya</char> mʉgʉma w'<char style="w" lemma="Mʉgomba">oMʉgomba</char> abyaga aho Yesʉ abere aliakubisania-kubisania n'a<char style="w" lemma="Basandukayo">Basandukayo</char>. Ɨye mwamɨnya ko Yesʉ mwashʉbɨtsyabo kʉbʉya. Aho mwayɨfʉnda hofɨ naye n'ɨmʉbʉtsya athɨ: «<char style="w" lemma="ithegeko">Ithegeko</char> lɨhe lyo lɨkʉlʉ mo kathi k'a<char style="w" lemma="mathegeko">mathegeko</char> woshi?» <verse eid="MRK 12:28" /><verse number="29" style="v" sid="MRK 12:29" />Yesʉ mwamʉshʉbɨtsya athɨ: «<char style="w" lemma="ithegeko">Erithegeko</char> lɨkʉlʉ mo kathi k'awoshi nɨ lɨno: “Mwonvwe, imwe bana b'Isiraeli! Nyinya-kowethʉ Gongo wethʉ yo Nyinya-kowethʉ yowene. <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />Ʉtsɨɨre Nyinya-kowethʉ Gongo wawe n'omʉthɨma awe woshi, n'omʉthɨma awe woshi, n'obwenge bwawe boshi n'akagala kawe koshi.” <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />N'<char style="w" lemma="ithegeko">erithegeko</char> inene lya kabɨrɨ nɨ lɨno: “Ʉmʉtsɨɨre mulikyenyu nga ko uyitsiire wowene<note caller="+" style="f"><char style="fr" closed="false">12:31 </char><char style="ft" closed="false">Soma Balawi 19:18.</char></note>.” Hathalɨ wandɨ <char style="w" lemma="ithegeko">mathegeko</char> manene kʉlenga ayo.» <verse eid="MRK 12:31" /><verse number="32" style="v" sid="MRK 12:32" /><char style="w" lemma="Mʉkangɨrɨtsya">oMʉkangɨrɨtsya w'oMʉgomba</char> oyo mwabwɨra Yesʉ athɨ: «Bɨbʉya mbe <char style="w" lemma="Mʉkangɨrɨtsya">Mʉkangɨrɨtsya</char>! Wamanegena ekwenene ko Gongo nɨ mʉgʉma yowene kandɨ hathalɨ ʉndɨ Gongo athalɨ ɨye mʉsha. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Bʉlɨ mʉndʉ atholere ɨtsɨɨra Gongo ko mʉthɨma ʉwe woshi, na ko bwenge bʉwe boshi, na ko kagala kʉwe koshi, atholere ɨtsɨɨra na mulikyabo nga ko ayitsiire yowene. Ebɨndʉ ebyo bikwirire kʉtsɨbʉ kʉlenga ɨhemba Gongo yo bɨhembo<note caller="+" style="f"><char style="fr" closed="false">12:33 </char><char style="ft" closed="false">Soma Osea 6:6.</char></note> by'okibwa mʉ mʉtsanwa kʉtse ebɨndɨ bɨhembo byoshi.» <verse eid="MRK 12:33" /><verse number="34" style="v" sid="MRK 12:34" />Yesʉ abere ashʉnga oMʉkangɨrɨtsya w'oMʉgomba kw'amashubya mʉ bwenge, mwamʉbwɨra athɨ: «Ʉthalɨ hale n'oBwamɨ bwa Gongo.» Honyuma kw'aho mohathashubabya mʉndʉ yo washʉbɨra ɨbʉtsya Yesʉ yo kɨnwa.<verse eid="MRK 12:34" /></para>
  <para style="s">Kirisito na Tawiti</para>
  <para style="r">(<ref loc="MAT 22:41-46">Mat 22:41-46</ref>; <ref loc="LUK 20:41-44">Luk 20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />Yesʉ abere alɨ akangɨrɨtsya mo kɨbʉga ky'<char style="w" lemma="Nyʉmba ya Gongo">eNyʉmba ya Gongo</char>, mwabʉtsya athɨ: «Bathɨ ko <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">Bakangɨrɨtsya b'oMʉgomba</char> bangakotsya ɨnegena bathɨ Kirisito nɨ Mʉgala wa Tawiti? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />Tawiti ɨye yowene, ashondolerwe n'<char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char>, mwanegena athɨ:</para>
  <para style="q1" vid="MRK 12:36">“Nyinya-kowethʉ Gongo mwabwɨra Nyinya-kowethʉ athɨ:</para>
  <para style="q1" vid="MRK 12:36">wikala na maka ko malyo aye,</para>
  <para style="q1" vid="MRK 12:36">ihika ko kɨka nyandahira esonzigu sawe emwishi w'ebɨshando byawe<note caller="+" style="f"><char style="fr" closed="false">12:36 </char><char style="ft" closed="false">Soma Saburi 110:1.</char></note>.”<verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />Tawiti yowene-wene ahʉla <char style="w" lemma="Kirisito">Kirisito</char> mo “Nyinya-kowethʉ,” bathɨ ko Kirisito angakotsya ibya Mʉgala ʉwe?»</para>
  <para style="s" vid="MRK 12:37">Mahano bʉshana n'abakangɨrɨtsya b'oMʉgomba</para>
  <para style="r" vid="MRK 12:37">(<ref loc="MAT 23:1-36">Mat 23:1-36</ref>; <ref loc="LUK 20:45-47">Luk 20:45-47</ref>)</para>
  <para style="p" vid="MRK 12:37">Muhindano mʉnene w'abandʉ bagenda abahʉlɨkɨrɨtsya Yesʉ mʉ lʉmogo. <verse eid="MRK 12:37" /><verse number="38" style="v" sid="MRK 12:38" />Yesʉ abere alɨ akangɨrɨtsya abandʉ, mwabwɨrabo athɨ: «Muyiteheye ko <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">Bakangɨrɨtsya b'oMʉgomba</char>, kʉshangwa atsiire ɨrendera bambithe eso ropo nyɨre-nyɨre, n'ɨketsɨbwa n'olʉkengerwa ahandʉ h'emihindano. <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />Kuthyo abanatsɨɨra ɨgenda bikala ko bifumbi by'embere mo <char style="w" lemma="sinakoki">sosinakoki</char>. Na kuthyo abanatsɨɨra ikala mo myanya y'embere mo solinye. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />Abanashamʉla obushoki bw'abashʉmba-katsɨ n'ɨshaba mɨshabe mɨre bʉshana bashʉngɨke embere s'abandʉ. Bʉshana n'eki, Gongo andasohabo kalengyo!»<verse eid="MRK 12:40" /></para>
  <para style="s">Ebɨhembo by'omʉshʉmba-katsɨ mʉtsene</para>
  <para style="r">(<ref loc="LUK 21:1-4">Luk 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Honyuma kw'aho, Yesʉ mwikala nialolitsye eyɨrɨ ekibo ky'erihiramo ebɨhembo by'omo <char style="w" lemma="Nyʉmba ya Gongo">Nyʉmba ya Gongo</char>. Mwayɨthegeretsya kw'abandʉ bagenda abahira esofaranga mo kibo ekyo. Bashoki bangɨ mobahira mʉkyo mo faranga nyɨngɨ. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Na mokwahika mʉshʉmba-katsɨ mʉgʉma mʉtsene, mwahulukya hɨtesre hɨbɨrɨ hɨke-hɨke hya faranga ehɨrɨngene na sengi ibiri.<verse eid="MRK 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 12:43" />Aho Yesʉ mwabɨrɨkɨra abɨga bʉwe n'ɨbwɨrabo athɨ: «Kwenene enyɨbabwɨra ko mʉshʉmba-katsɨ mʉtsene oyu, yo wamahulukya nyɨngɨ kalengyo kʉlenga aboshi bo bamahira mo kibo ky'ebɨhembo. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />Kʉshangwa abandɨ boshi mobahulukya ebɨshakɨtsya by'obushoki bwabo. Hewethuwe ɨye amahulukya mo bʉtsene bʉwe, obushoki boshi athawitheko bʉshana n'obʉyɨngo bʉwe.»<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">Yesʉ athɨ eNyʉmba ya Gongo yashambʉlwa</para>
  <para style="r">(<ref loc="MAT 24:1-3">Mat 24:1-3</ref>; <ref loc="LUK 21:5-7">Luk 21:5-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Yesʉ abere anemʉthoka mo Nyʉmba ya Gongo, mʉgʉma w'oko bɨga bʉwe mwamʉbwɨra athɨ: «Mʉkangɨrɨtsya, shʉnga! Enyʉmba eyi ko yɨngana, n'amabwe w'ahimbagaro kw'akwirire!» <verse eid="MRK 13:1" /><verse number="2" style="v" sid="MRK 13:2" />Yesʉ mwamʉshʉbɨtsya athɨ: «Ʉnatsene ko nyʉmba nene nene esi? Kuthindashibe kiro n'ibwe elʉgʉlʉ w'erɨndɨ, awoshi andashambʉlwa.»<verse eid="MRK 13:2" /></para>
  <para style="s">Ebyo byandabya ko bɨro by'enduli</para>
  <para style="r">(<ref loc="MAT 24:3-14">Mat 24:3-14</ref>; <ref loc="LUK 21:8-19">Luk 21:8-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Yesʉ abyaga n'ikere ko kɨthwa ky'iMiseituni ko mʉnda ow'alolire ko Nyʉmba ya Gongo. Petero na Yakobo na Yoani na Ndereya mobamuhikira ahathalɨ bandʉ. Mobamʉbʉtsya bathɨ: <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />«Thʉbwɨre, ebɨnwa wamanegena byandabya kʉ mʉgʉlʉ ohɨ? Na kɨhɨ kyo kɨmɨnyɨkalo kyandakangania kw'ebɨnwa byoshi ebyo ebishondya ɨbererera?»<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />Aho Yesʉ mwathanga ɨbwɨrabo athɨ: «Mʉmɨnyage, kuthabyaga kiro na mʉndʉ wabathɨma. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />Bandʉ bangɨ bandahika mw'ɨtsɨna lyaye nɨabanegena bathɨ: “Ingye nyɨrɨ Kirisito!” Na bandathɨma bandʉ bangɨ. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />Mwandabya mwonvwa omwatsɨ w'amalwa, kʉtse ehwehweri y'amalwa mʉthand'ʉbaha. Lɨtholere ebyo nibyabya, hewethuwe ebyo bɨthalɨ ebikangania kw'enduli y'ekɨhʉgo yamahika. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />Kʉshangwa ekɨhʉgo kyandalwa na kɨndɨ kɨhʉgo, na bwamɨ bwandalwa na bʉndɨ bwamɨ. Thulingiti thwandatsʉka handʉ hangɨ-hangɨ na kuthyo kwandabya nzala. Ebyoshi ebi byandabya nga ndangɨro ya bwagali bw'ɨkʉnda. <verse eid="MRK 13:8" /><verse number="9" style="v" sid="MRK 13:9" />He imwe muyitheye kʉshangwa abandʉ bandabathwala ko tɨrɨbɨnalɨ bʉshana n'ɨbasoha n'ibahumba mbasha mo sosinakoki. Na kuthyo mwandathonda embere s'abakʉlʉ n'abamɨ bʉshana nangye. Bʉshana n'ekyo mwandabya batimo baye embere sabo. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Bɨtholere Engʉlʉ Mbʉya ɨthange ɨfʉlɨrwa abandʉ b'ebɨhanda byoshi.» <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />«Bandabya babathwala ko tɨrɨbɨnalɨ, mʉthaganga-gangaya emɨthɨma enyu nga mwanegena ki. Hewethuwe ebyo mwandanegena mwandahabwabyo kona ndambi eyo. Kʉshangwa mʉthalɨ imwe mwandanegena, hewethuwe oMʉthɨma Mwerʉ. <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" />Mʉndʉ andahothera mʉgalabo bʉshana n'ɨmwɨthɨsa, n'ishe w'omwana andakolera mʉgala yo athyo. Abana nabo bandabɨndʉka ko babuthi babo na bandɨthɨsabo. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />N'abandʉ boshi bandababaga bʉshana nangye. Hewethuwe yo wandatsitsinia ihika ko nduli, oyo, andashabʉlwa.»<verse eid="MRK 13:13" /></para>
  <para style="s">Bʉlɨgo bʉnene</para>
  <para style="r">(<ref loc="MAT 24:15-28">Mat 24:15-28</ref>; <ref loc="LUK 21:20-24">Luk 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />«Mwandabya mwashʉnga yo wahʉlwamo “Mubihya” imana aho athatholere ibya, yo ʉsoma ebɨnwa ebi onvwebyo kʉbʉya. Aho, abo bandabya iYuteya bashayɨre ko bɨthwa. <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />Yo wandabya ko lʉthwe lw'enyʉmba athakimaga n'ɨngɨra omwe bʉshana ayahekemo kɨndʉ. <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />Yo wandeyibwa mw'ɨshwa, naye athashʉbaga ewe bʉshana n'ɨyaheka olʉkɨmba lʉwe. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />Bʉlɨgo ko bakatsɨ bo bandabya nɨ bakʉle na kw'abo bandabya niabongya mo bɨro ebyo. <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Mʉshabe Gongo bʉshana ebyo bithabyaga mo bɨro by'embeho. <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />Kʉshangwa ebɨro ebyo, byandabya bɨro bya malɨgo mangɨ ow'athahera athashʉngɨka ɨthanga ko kɨro Gongo ahangɨkaga ekɨhʉgo ihika lɨno. Na kuthindashubabye wandɨ malɨgo alɨ ng'ayo. <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />Na Nyinya-kowethʉ athangakehitsye ebɨro by'amalɨgo ebyo, hathangabere kiro na mʉndʉ yo wangashabwirwe. Hewethuwe mwakehya ebɨro ebyo bʉshana n'abo ayɨshomboleraga.» <verse eid="MRK 13:20" /><verse number="21" style="v" sid="MRK 13:21" />«Aho, mʉndʉ mʉlebe amababwɨra athɨ: “Mʉlole, Kirisito alɨ hano!” kʉtse “Alɨ halira!” mʉthamwɨkɨrɨtsyaga. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Kʉshangwa kwandahʉlʉka bo kirisito ba mabesɨ na bamɨnyeretsɨ ba mabesɨ. Abandʉ abo bandakola bɨmɨnyɨkalo na bɨthɨko-thɨko, bʉshana bɨrɨ byangathokekana bathɨme n'abo Gongo ashombolaga. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Hewethuwe imwe mʉmɨnyage kʉshangwa nyamalire ɨbabwɨra ebyoshi ebyo.»<verse eid="MRK 13:23" /></para>
  <para style="s">Erishubahika ly'oMʉgala w'oMʉndʉ</para>
  <para style="r">(<ref loc="MAT 24:29-31">Mat 24:29-31</ref>; <ref loc="LUK 21:25-28">Luk 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />Hewethuwe mo bɨro ebyo, honyuma w'amalɨgo ayo,</para>
  <para style="q1" vid="MRK 13:24">erɨtsʉba lyandabya mwitsimya,</para>
  <para style="q1" vid="MRK 13:24">omʉgenda athɨndashʉba koletsye.<verse eid="MRK 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="MRK 13:25" />Esongununu sandathogonga ɨthoka mo lʉbʉla.</para>
  <para style="q1" vid="MRK 13:25">N'ebyoshi by'amaka byo bɨrɨ mo lʉbʉla, byandathenganibwa.<verse eid="MRK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 13:26" />Aho, Mʉgala w'oMʉndʉ andashʉngwa nɨathoka mo bɨfʉ mo maka na mo lʉkengerwa lʉwe. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Aho andathʉma abamalaɨka bʉwe ko mbande ine s'ekɨhʉgo ihika ko nduli y'olʉbʉla bʉshana bayashongye abandʉ bʉwe ashombolaga.<verse eid="MRK 13:27" /></para>
  <para style="s">Mushinga wa mʉthɨ w'omutini</para>
  <para style="r">(<ref loc="MAT 24:32-35">Mat 24:32-35</ref>; <ref loc="LUK 21:29-33">Luk 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />«Mw'ɨgɨre ko mushinga w'omʉthɨ w'omutini. Ko ndambi amathahɨ wao alashʉla, n'ebɨthɨ byawo byalasha, imwe omʉnamɨnya kw'endambi y'ekyanda yɨhera hofɨ. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Na kuthyo, mwandabya mwashʉnga ebɨnwa ebyo byahika, mʉmɨnye kw'oMʉgala w'oMʉndʉ alɨ hofɨ, na ahera ko lukyo. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Kwenene enyɨbabwɨra nyɨthɨ abandʉ b'olʉgero olu bathɨndahwe embere ebɨnwa byoshi ebi bibye. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Olʉbʉla n'ekɨhʉgo byandatsʉka, hewethuwe ebɨnwa byaye ɨbyo bɨthɨndatsʉke kiro na hake.»<verse eid="MRK 13:31" /></para>
  <para style="s">Gongo mʉsha yo wetsi endambi y'enduli</para>
  <para style="r">(<ref loc="MAT 24:36-44">Mat 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />«Hathalɨ mʉndʉ yo wetsi ekɨro kʉtse endambi ebyo byandabya. Ibye abamalaɨka ba mo lʉbʉla ibye Mʉgala wa Gongo, hewethuwe Thatha mʉsha yo wetsi. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />Muyitheye, mubye mesho, kʉshangwa muthetsi ekɨro n'omʉgʉlʉ ebyo byandahika. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />Byandabya nga mʉndʉ yo ʉlalɨtsya lʉgendo. Abere athoka ewe mwamikira abakoli bw'obuthegeki bʉwe, mw'ɨha bʉlɨ mʉndʉ omʉlɨmo ʉwe. Na kuthyo mwahamʉla omutheya w'oluyi abye mesho. <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />Aho mutheye, kʉshangwa muthetsi endambi omwenye nyʉmba andashʉbʉla. Yangabya mwigolo, kʉtse mʉ kathi ka kɨro, kʉtse ko ndambi embagatsɨ inabya yabɨka, kʉtse mo makerakera. <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />Bʉshana n'ekyo mutheye athangandahika bʉthalagana n'ibeya nɨ mʉlɨ thʉlo. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />Ebɨnwa enyɨbabwɨra, enyɨbwɨrabyo abandʉ boshi, mutheye.»<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">aBakʉlʉ abaya nama y'itha Yesʉ</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mat 26:1-5</ref>; <ref loc="LUK 22:1-2">Luk 22:1-2</ref>; <ref loc="JHN 11:47">Yoa 11:47</ref>,<ref loc="JHN 11:49">49</ref>,<ref loc="JHN 11:53">53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Kwabyaga nikukishiya bɨro bɨbɨrɨ embere ekɨro kɨkʉlʉ ky'ePasaka na ky'eMikati ɨthemo tsatsʉ kihike. Abakʉlʉ b'abaheri n'abakangɨrɨtsya b'oMʉgomba mobashondya ko bangatsɨmba Yesʉ mʉ menge bʉshana bamwithe. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />Hewethuwe bagenda ababwɨrana bathɨ: «Thʉthamʉtsɨmbaga mo kɨro ky'elinye, bʉshana kuthangabya bʉrʉnga mo kathi k'abandʉ.»<verse eid="MRK 14:2" /></para>
  <para style="s">Mʉkatsɨ mʉgʉma ahaka Yesʉ yo marasi</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mat 26:6-13</ref>; <ref loc="JHN 12:1-8">Yoa 12:1-8</ref>; <ref loc="LUK 7:36-38">Luk 7:36-38</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />Yesʉ abyaga ɨBetanɨa mo nyʉmba ya Simoni Mʉbenzɨ. Abere anemulya, mʉkatsɨ mʉgʉma mwɨngɨra mo nyʉmba. Abyaga niahekire murangi akomibwe mw'ibwe nɨalɨmo marasi wa kɨtsɨro kɨnene. Amarasi merʉ ayo akomibawa mʉ mʉshanga wa narito. Honyuma kw'aho, mwatsa obʉnʉ bw'omurangi oyo n'ɨhaka amarasɨ ko muthwe wa Yesʉ. <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />Bagʉma mo bandʉ babyaga aho, mobagalɨrwa bʉshana n'ekyo n'ɨbwɨrana bathɨ: «Bʉshana na ki ibihya amarasi aya? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />Amarasi aya angautsibwe kʉ kɨtsɨro kya bɨtsere magana ashathʉ bya faranga nɨgabɨrabyo abatsene!» Bʉshana n'ekyo mobahayɨra omʉkatsɨ oyo yo kʉtsɨbʉ. <verse eid="MRK 14:5" /><verse number="6" style="v" sid="MRK 14:6" />Hewethuwe Yesʉ mwabwɨrabo athɨ: «Mumulike! Omumunubya bʉshana na ki? Ekyo amanyɨkolera kikwirire. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />Kʉshangwa mwandabya n'abatsene ebɨro byoshi, na mwangawathikyabo ko ndambi mushashire. Hewethuwe ingye, nyithindabye hagʉma nemwe ko bɨro byoshi. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />Omʉkatsɨ oyu amakola ekyo angakotsya. Amanyɨhaka marasi ko mʉbɨrɨ bʉshana athegekaniewo embere bathewo. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Kwenene enyɨbabwɨra, ahoshi Engʉlʉ Mbʉya yandafʉlwa, ekyo amakola kyandafʉlwa mo kɨhʉgo kyoshi bʉshana n'ɨmwɨbʉka.»<verse eid="MRK 14:9" /></para>
  <para style="s">Yuta Isikariote atsɨga ɨhothera Yesʉ</para>
  <para style="r">(<ref loc="MAT 26:14-16">Mat 26:14-16</ref>; <ref loc="LUK 22:3-6">Luk 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Yuta Isikariote, mʉgʉma w'oko bathʉmwa ikumi na babɨrɨ, mwaya ewa abakʉlʉ b'abaheri, bʉshana ahothere Yesʉ kʉbo. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Abakʉlʉ b'abaheri abo babere bonvwa omwatsɨ oyo, mobamoga kʉtsɨbʉ na mobamʉlaga ɨmʉha faranga. Aho Yuta mwathanga ishondya kathambi kakwirire ako angahanamo Yesʉ.<verse eid="MRK 14:11" /></para>
  <para style="s">Yesʉ alya akalyo k'ePasaka hagʉma n'abɨga bʉwe</para>
  <para style="r">(<ref loc="MAT 26:17-25">Mat 26:17-25</ref>; <ref loc="LUK 22:7-14">Luk 22:7-14</ref>; <ref loc="LUK 21:23">21:23</ref>; <ref loc="JHN 13:21-30">Yoa 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Mo kɨro kɨmbere ky'elinye ly'emikati ɨthemo tsatsʉ, ekɨro ekyo bagenda abakeramo embuli y'erirya ko Pasaka, abɨga ba Yesʉ mobamʉbʉtsya bathɨ: «Ushondya thʉyakʉkometsye elinye ly'ePasaka lyo hayi?» <verse eid="MRK 14:12" /><verse number="13" style="v" sid="MRK 14:13" />Aho Yesʉ mwathʉma babɨrɨ ba mo bɨga bʉwe n'ɨbwɨrabo athɨ: «Mʉye mo muyi, mwahindana na mʉndʉ mʉgʉma yo uhekire kɨrega kya metsi. Mʉkwame omʉndʉ oyo, <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />n'enyʉmba eyo ɨngɨramo, mʉbwɨre omwenye nyʉmba eyo mʉthɨ: “oMʉkangɨrɨtsya abʉtsya nga hayi ho halɨ ekɨshenge kɨwe ekyo alɨramo elinye ly'ePasaka hagʉma n'abɨga bʉwe!” <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />Aho, omwenye enyʉmba abakangya kɨshenge kɨnene ko ngorofa, kyamalire ithegekanibwa kʉbʉya. Nɨ omo mo mwathʉkometsya elinye.» <verse eid="MRK 14:15" /><verse number="16" style="v" sid="MRK 14:16" />Abɨga babɨrɨ abo mobagenda, mobahika mo muyi, mobeya ebɨndʉ byoshi ni bithegekanibwe kʉbʉya nga ko Yesʉ athabwɨrabo. Na mobatheka akalyo k'ePasaka.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />Bwabere bwahika igolo, Yesʉ mwahika hagʉma n'abathʉmwa bʉwe ikumi na babɨrɨ. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Babere bahera abalya, Yesʉ mwanegena athɨ: «Kwenene enyɨbabwɨra, mʉgʉma mw'imwe yo ulya hagʉma nangye anyɨhothera.» <verse eid="MRK 14:18" /><verse number="19" style="v" sid="MRK 14:19" />Abɨga mobathanga ɨfwa buliye n'ɨmʉbʉtsya mʉgʉma kʉ ʉndɨ bathɨ: «N'ingye he?» <verse eid="MRK 14:19" /><verse number="20" style="v" sid="MRK 14:20" />Yesʉ mwashʉbɨtsyabo athɨ: «Nɨ mʉgʉma mw'imwe ikumi na babɨrɨ, yo ʉkoletsya omukati hagʉma nangye mo mbale. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Kʉshangwa oMʉgala w'oMʉndʉ afwa nga kw'Amashako Abuyirire anegenire bʉshana naye. Hewethuwe bʉhanya ko mʉndʉ yo wamʉhothera! Byangabere bɨbʉya ko mʉndʉ oyo athabʉthawa.»<verse eid="MRK 14:21" /></para>
  <para style="s">Omʉbɨrɨ n'omʉsasɨ wa Yesʉ</para>
  <para style="r">(<ref loc="MAT 26:26-29">Mat 26:26-29</ref>; <ref loc="LUK 22:15-20">Luk 22:15-20</ref>; <ref loc="1CO 11:23-26">1Kor 11:23-26</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Babere balɨ abalya, Yesʉ mwatsɨmba omukati, mwasɨma Gongo, honyuma kw'aho mwatsitsangawo n'ɨhawo abɨga bʉwe, nɨanegena athɨ: «Mʉtsɨmbe, ono nɨ mʉbɨrɨ aye.» <verse eid="MRK 14:22" /><verse number="23" style="v" sid="MRK 14:23" />Honyuma kw'aho, mwatsɨmba olwatha, abere amamala ɨsɨma Gongo, mwahalobo. N'aboshi mobashoma kʉlo. <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />Yesʉ mwabwɨrabo athɨ: «Ono nɨ mʉsasɨ aye, mʉsasɨ w'endagane wo ashesheka bʉshana na bandʉ bangɨ. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />Kwenene enyɨbabwɨra, nyɨthɨshʉbe shoma tifayi ya misabibu ihika ko kɨro nyandashoma nyihya-nyihya mo Bwamɨ bwa Gongo.» <verse eid="MRK 14:25" /><verse number="26" style="v" sid="MRK 14:26" />Babere bamamala imba esosaburi<note caller="+" style="f"><char style="fr" closed="false">14:26 </char><char style="ft" closed="false">Imba esosaburi: Esosaburi 115-118 sagenda esimbwa enyuma w'erirya akalyo k'ePasaka.</char></note> s'elinye, mobaya ko kɨthwa ky'eMiseituni.<verse eid="MRK 14:26" /></para>
  <para style="s">Yesʉ anegena ko Petero ayɨgana ɨye</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mat 26:31-35</ref>; <ref loc="LUK 22:31-34">Luk 22:31-34</ref>; <ref loc="JHN 13:36-38">Yoa 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />Yesʉ mwabwɨra abɨga bʉwe athɨ: «Imwe boshi mwanyishiga, kʉshangwa kushakirwe mo Mashako Abuyirire kʉthɨ:</para>
  <para style="q1" vid="MRK 14:27">“Nyanditha omulishya,</para>
  <para style="q1" vid="MRK 14:27">n'esombuli sandasanzabana<note caller="+" style="f"><char style="fr" closed="false">14:27 </char><char style="ft" closed="false">Soma Sakarɨa 13:7.</char></note>.”»<verse eid="MRK 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 14:28" />Hewethuwe enyuma w'erilubuka lyaye, nyandabathanga iNgalilaya. <verse eid="MRK 14:28" /><verse number="29" style="v" sid="MRK 14:29" />Petero mwamʉbwɨra athɨ: «Namo abandɨ boshi bangakushiga, ingye nyithindakushige.» <verse eid="MRK 14:29" /><verse number="30" style="v" sid="MRK 14:30" />Yesʉ mwamʉshʉbɨtsya athɨ: «Kwenene enyɨkʉbwɨra, mo kɨro kya munobwire, embere embagatsɨ y'ɨbɨke kabɨrɨ, wabya nɨwamayɨgana ingye ngendo ishathu.» <verse eid="MRK 14:30" /><verse number="31" style="v" sid="MRK 14:31" />Hewethuwe Petero mwayɨtsɨnga ɨnegena athɨ: «Namo byangaleka nɨnyafwa hagʉma nawe, nyɨthɨyɨgane ɨwe kiro na hake.» N'abandɨ boshi, nabo mobanegena ng'ɨye.<verse eid="MRK 14:31" /></para>
  <para style="s">Yesʉ ashabɨra mw'ɨshwa ly'iNgetesemani</para>
  <para style="r">(<ref loc="MAT 26:36-46">Mat 26:36-46</ref>; <ref loc="LUK 22:40-46">Luk 22:40-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Yesʉ n'abɨga bʉwe mobahika ahandʉ ho ahanahʉlwamo Ngetetsemani. Yesʉ mwabwɨra abɨga bʉwe athɨ: «Mwikale hano mo ndambi enyɨya shaba.» <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Mwatsɨmba Petero na Yakobo na Yoani, na mwagenda nabo. Mwathanga ibya na bulige bʉnene n'ɨthabagana. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Mwabwɨrabo athɨ: «Omʉthɨma aye alɨ na bulige hofɨ nyɨfwe. Mushibe hano na mubye mesho.»<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />Honyuma kw'aho mwayɨfʉnda hale hake kʉbo na mwayihuma ahishi n'ɨshaba athɨ: «Byamathokekana ko ndambi eyo y'emɨnʉbo ɨtsʉke hale naye.» <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />Mwanegena athɨ: «Mbe Thatha! Obʉlɨ kɨndʉ kɨthokekene kw'ɨwe, enyɨkʉshaba ʉhɨgʉle olwatha lw'amalɨgo olu. Hewethuwe ithabyaga nga ko nyishashire, hewethuwe nga ko ushashire.»<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />Yesʉ abere ashʉba ahalɨ abɨga bashathʉ mweyabo nɨbalɨtho. Mwabwɨra Petero athɨ: «Simoni, ʉlɨ tho? Moʉthalɨ ʉbona kagala k'itheya saha ngʉma bʉsha. <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />Mutheye na mʉshabe Gongo, bʉshana mʉthangalengwako. Kʉshangwa omʉthɨma nɨ mʉngangwe, hewethuwe omʉbɨrɨ nɨ molo.»<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />Yesʉ mwashʉba yɨfʉnda hale hake kʉbo. Mwayashaba Gongo nɨashʉbɨrɨra ebɨnwa bɨgʉmerera. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Abere ashʉba shʉba eyɨrɨ abɨga bʉwe, mweyabo nibashubire yatho, bʉshana amesho wabo abyaga nɨamatsɨthoha kʉtsɨbʉ n'othʉlo. Nabo mobathabona ky'erɨmʉshʉbɨtsya. <verse eid="MRK 14:40" /><verse number="41" style="v" sid="MRK 14:41" />Abere ashʉba shʉbʉla erya kashathʉ, mwabwɨrabo athɨ: «Mʉkɨnalɨ tho n'ɨlʉhʉka? Bɨhwere aho! Endambi yamahika. Aho, oMʉgala w'oMʉndʉ amamala ihirwa mo minwe y'abakoli b'ebɨtsɨbʉ. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />Mwimane thʉgende! Mʉlole, yo ʉnyɨhothera yono ahera hofɨ!»<verse eid="MRK 14:42" /></para>
  <para style="s">Yesʉ atsɨmbwa</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />Yesʉ abere akɨnalɨ anegena, aho n'aho Yuta, mʉgʉma w'oko bathʉmwa ikumi na babɨrɨ, mwahika hagʉma na kɨkembe kɨnene ky'abandʉ bo babyaga bahekire emiyali na mihumbo. Aboshi aba babyaga nɨbamathʉmwa n'abakʉlʉ b'abaheri, n'abakangɨrɨtsya b'oMʉgomba, n'abakʉlʉ b'abandʉ. <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />Yuta oyo, yo wabyaga nɨamamʉhana, abyaga nɨamamala ɨhabo ekɨmɨnyɨkalo kɨno: «Oyo nyafʉmbatha, nɨ ɨye. Mʉmʉtsɨmbe na mʉmʉthwale, nimumutheyitsye kʉbʉya.»<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />Yuta abere ahika ahalɨ Yesʉ, aho n'aho mwayɨfʉnda hofɨ naye n'ɨmʉbwɨra athɨ: «Mʉkangɨrɨtsya!» Honyuma kw'aho mwamʉfʉmbatha. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Aho abandʉ abo mobatsɨmba Yesʉ n'ɨmʉmɨna. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Hewethuwe mʉgʉma mo kathi k'abo babyaga hagʉma na Yesʉ, mwashoshola omuyali n'ɨtsa okuthwi k'omukoli w'omuheri Mʉkʉlʉ. <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />Honyuma kw'aho, Yesʉ mwabwɨrabo athɨ: «Mwamahika na miyali na mihumbo bʉshana n'ɨnyɨtsɨmba nga bandʉ bo baya tsɨmba mushamuli? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />Ebɨro byoshi nyabyaga hagʉma nemwe, nangye nyagenda enyɨkangɨrɨtsya mo Nyʉmba ya Gongo, ewo kamomuthanyitsimbire! Hewethuwe ebɨnwa ebi byamahika bʉshana ebyo bishakirwe mo Mashako Abuyirire bɨbererere.»<verse eid="MRK 14:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50" />Aho abɨga bʉwe boshi mobamumika n'ɨshaga.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />Mʉtsana mʉgʉma abyaga ambithe tarape mwakwama Yesʉ. Mobayɨrenga ɨmʉkɨkɨra, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />hewethuwe mwamika etarape eyo n'ɨthɨbɨtha ndumbu.<verse eid="MRK 14:52" /></para>
  <para style="s">Yesʉ athonda embere y'obʉshenge bʉkʉlʉ</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Abandʉ abo mobathwala Yesʉ ew'oMuheri Mʉkʉlʉ. <char style="w" lemma="Abakʉlʉ b'abaheri">Abakʉlʉ b'abaheri</char> boshi, na bimanitsi b'abandʉ hagʉma na <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">Bakangɨrɨtsya b'oMʉgomba</char> mobahindana aho. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />Petero mwakwama Yesʉ y'enyuma yo hale, na mwɨngɨra mo rʉba lw'enyʉmba y'<char style="w" lemma="Muheri Mʉkʉlʉ">oMuheri Mʉkʉlʉ</char>. Aho mwikala hagʉma n'abakoli, nɨotha ko mʉtsanwa.<verse eid="MRK 14:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55" />Abakʉlʉ b'abaheri hagʉma n'abandɨ bakʉlʉ boshi b'obʉshenge bʉkʉlʉ mobashondya kʉ Yesʉ ko bɨnwa bʉshana bamwithe, hewethuwe mobathabona kɨnwa. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Bandʉ bangɨ mobamʉhambɨka, hewethuwe obutimo bwabo mobʉthalɨngana. <verse eid="MRK 14:56" /><verse number="57" style="v" sid="MRK 14:57" />Aho, bagʉma mobimana bʉshana n'ɨretha butimo bwa mabesɨ kw'ɨye nɨabanegena bathɨ: <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />«Ithwe mothʉmwonvwa nɨanegena athɨ: “Ingye nyashambʉla Enyʉmba ya Gongo yo yahimbawa na bandʉ eyi, na mʉ bɨro bɨshathʉ nyahimba yɨndɨ yo yithihimbwe na bandʉ.”» <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Hewethuwe namo byanabyaga bithyo, obutimo bwabo mobʉthalɨngana. <verse eid="MRK 14:59" /><verse number="60" style="v" sid="MRK 14:60" />Aho <char style="w" lemma="Muheri Mʉkʉlʉ">oMuheri Mʉkʉlʉ</char> mwimana mo kathi k'abandʉ n'ɨbʉtsya Yesʉ athɨ: «Ko bɨnwa byoshi abandʉ aba abakusitakira uthashubitsye kiro na kɨnwa?» Abandʉ aba abakusitakira ki? <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />Hewethuwe Yesʉ mwayɨtsɨrɨra, na mwathashubya kɨnwa. oMuheri Mʉkʉlʉ oyo mwashʉbabʉtsya athɨ: «Ɨwe wo Kirisito Mʉgala wa Gongo yo ugashanirwe?» <verse eid="MRK 14:61" /><verse number="62" style="v" sid="MRK 14:62" />Yesʉ mwashubya athɨ: «Ega! n'ingye! Nemwe mwashʉnga oMʉgala w'oMʉndʉ n'ikere ko malyo wa Gongo ow'amaka. Mwamʉshʉnga kuthyo niahika ɨthoka mo lʉbʉla mo kathi k'ebɨfʉ!» <verse eid="MRK 14:62" /><verse number="63" style="v" sid="MRK 14:63" />Ko ndambi oMuheri Mʉkʉlʉ abere onvwa ebɨnwa ebi, mwaberenga esongɨmba sɨwe n'ɨnegena athɨ: «Thuthakilaire ku butimo ko mʉndʉ oyu. <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />Mwamonvwa imwe bene ko mwahangya Gongo. Omʉganɨtsya ki?» Aboshi mobanegena bathɨ atholere lʉholo<note caller="+" style="f"><char style="fr" closed="false">14:64 </char><char style="ft" closed="false">Soma Balawi 24:16.</char></note>. <verse eid="MRK 14:64" /><verse number="65" style="v" sid="MRK 14:65" />Bagʉma mo kathi kabo mobathanga ɨtsɨra kʉ Yesʉ ko mathandɨ, mobamʉshwɨka obʉsʉ n'imuhiramo nvʉndo, mobamʉbwɨra bathɨ: «Mɨnyerera nga nɨ ndɨ yo wamakuhumba!» Na bashirikani batheya mobatsɨmba Yesʉ n'ɨmʉha makofi<note caller="+" style="f"><char style="fr" closed="false">14:65 </char><char style="ft" closed="false">Soma Isaya 50:6.</char></note>.<verse eid="MRK 14:65" /></para>
  <para style="s">Petero ayɨgana Yesʉ</para>
  <para style="r">(<ref loc="MAT 26:69-75">Mat 26:69-75</ref>; <ref loc="LUK 22:54-62">Luk 22:54-62</ref>; <ref loc="JHN 18:15-18">Yoa 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Petero abyaga nɨakɨnalɨ ekihya mo rʉba, mʉgʉma wa ko bakoli bakatsɨ b'oMuheri Mʉkʉlʉ mwahika aho. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />Mwashʉnga Petero nɨotha ko mʉtsanwa, mwamʉlola, n'ɨmʉbwɨra athɨ: «Ɨwe kuthyo ʉthalɨ hagʉma na Yesʉ w'iNasareti.» <verse eid="MRK 14:67" /><verse number="68" style="v" sid="MRK 14:68" />Hewethuwe Petero mwayɨgana, na mwanegena athɨ: «Nyithetsi ebyo ushondya ɨnegena, nyithonvwire kɨndʉ.» Honyuma kw'aho, Petero mwahʉlʉka n'ɨya ho lukyo lw'orʉba. [Ko kathambi ako, embagatsɨ moyabɨka.] <verse eid="MRK 14:68" /><verse number="69" style="v" sid="MRK 14:69" />Omukoli mʉkatsɨ oyo mwashʉba shʉnga Petero, mwashʉba bwɨra abo babyaga aho athɨ: «Omʉndʉ oyu nɨ mʉgʉma wa kʉbo!» <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Hewethuwe Petero mwashʉbayɨgana. Honyuma hake, abandʉ abo mobashʉbabwɨra Petero bathɨ: «Kwenene ɨwe ʉlɨ mʉgʉma wa kʉbo, kʉshangwa ɨwe kuthyo ʉlɨ mʉndʉ w'iNgalilaya.»<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />Aho Petero mwathanga ɨyɨgana n'ɨlahɨtsya kʉtsɨbʉ athɨ: «Omʉndʉ yo mwahʉla oyu nyamalahɨtsya nyɨthɨ nyithamwetsi. Na nyamabya nɨenyɨbɨha, nyɨthakɨrwe!» <verse eid="MRK 14:71" /><verse number="72" style="v" sid="MRK 14:72" />Aho n'aho embagatsɨ moyabɨka ngendo ya kabɨrɨ, na Petero mwɨbʉka ebɨnwa ebyo Yesʉ amʉbwɨraga ko embere embagatsɨ ithetsi yabɨka ngendo ibiri, andabya nɨamayɨgana ɨye ngendo ishathu. Aho mwathanga ɨrɨra.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">Yesʉ abʉrana embere sa Pilato</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mat 27:1-2</ref>,<ref loc="MAT 27:11-26">11-26</ref>; <ref loc="LUK 23:1-5">Luk 23:1-5</ref>,<ref loc="LUK 23:13-25">13-25</ref>; <ref loc="JHN 18:28">Yoa 18:28</ref>; <ref loc="JHN 19:16">19:16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Mo mambya matsɨbʉ, abaheri bakʉlʉ mobaya nama hagʉma n'abakʉlʉ b'abandʉ, n'abakangɨrɨtsya b'oMʉgomba n'obʉshenge bʉkʉlʉ boshi. Mobamɨna Yesʉ, n'ɨmʉthwala ewa kafʉrʉnalɨ Pilato. <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />Pilato mwabʉtsya Yesʉ athɨ: «Ewono! Ɨwe wo Mwamɨ w'aBayuta?» Yesʉ mwamʉshʉbɨtsya athɨ: «Ɨwe wo wamanegena.» <verse eid="MRK 15:2" /><verse number="3" style="v" sid="MRK 15:3" />Abaheri bakʉlʉ mobasitaka Yesʉ yo bɨnwa bɨngɨ. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Aho Pilato mwashʉba mʉbʉtsya athɨ: «Uthashubitsye kiro na kɨnwa? Shʉnga ebɨnwa byoshi abakusitakako!» <verse eid="MRK 15:4" /><verse number="5" style="v" sid="MRK 15:5" />Hewethuwe Yesʉ mwathashʉba shubya kiro na kɨnwa. Aho, Pilato mwashweka.<verse eid="MRK 15:5" /></para>
  <para style="s">Pilato asohera Yesʉ yo lʉholo</para>
  <para style="r">(<ref loc="MAT 27:15-26">Mat 27:15-26</ref>; <ref loc="LUK 23:13-25">Luk 23:13-25</ref>; <ref loc="JHN 18:39-19:16">Yoa 18:39–19:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Ko bʉlɨ kɨro kɨkʉlʉ ky'ePasaka, Pilato abyaga abegere ɨmɨnʉla mʉndʉ mʉgʉma wa muliki yo bandʉ bathamʉshaba. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Kwabyaga mʉndʉ mʉgʉma wa muliki, erɨtsɨna lɨwe nɨ yo Baraba. Omʉndʉ oyo amɨnawa hagʉma na bathengʉ bagʉma bʉshana n'obwithi na bʉthengʉhe bo bakolaga. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Aho, abandʉ mobagendera Pilato, mobathanga ɨmʉshaba akolerebo nga kw'abyaga abegere ɨkolerabo. <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />Pilato mwabʉtsyabo athɨ: «Omushondya nyɨbamɨnʉlɨre omwamɨ w'aBayuta?» <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Anegenaga athyo kʉshangwa mwamɨnya kw'abaheri bakʉlʉ bamahothera Yesʉ bʉshana n'ɨmʉfwa mwisho. <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />Hewethuwe abaheri bakʉlʉ abo mobuhya abandʉ bashabe Pilato amɨnʉlɨrebo Baraba. <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />Pilato mwashʉbabʉtsya omuhindano athɨ: «Aho omushondya nyɨyɨre omʉndʉ yo mwahʉlamo mwamɨ w'aBayuta oyu yo nyɨthɨ?» <verse eid="MRK 15:12" /><verse number="13" style="v" sid="MRK 15:13" />Mobashʉba hambala bathɨ: «Mʉbambe ko mʉsalaba!» <verse eid="MRK 15:13" /><verse number="14" style="v" sid="MRK 15:14" />Pilato mwashʉbabʉtsyabo athɨ: «Akolire kɨbɨ kɨhe?» Hewethuwe mobatsitsinia mw'ɨhambala kʉtsɨbʉ bathɨ: «Mʉbambe ko mʉsalaba!» <verse eid="MRK 15:14" /><verse number="15" style="v" sid="MRK 15:15" />Pilato agendaga ashondya imoya abandʉ, aho mwamɨnʉlɨrabo Baraba. Honyuma kw'aho mwahamʉla bahumbe Yesʉ yo mbasha, na mwamʉhana bʉshana abambwe ko mʉsalaba.<verse eid="MRK 15:15" /></para>
  <para style="s">Abashirikani abashekeretsya Yesʉ</para>
  <para style="r">(<ref loc="MAT 27:27-31">Mat 27:27-31</ref>; <ref loc="JHN 19:2-3">Yoa 19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Abashirikani mobathwala Yesʉ mo rʉba lw'enyʉmba ya kafʉrʉnalɨ, na mobabɨrɨkɨra balikyabo boshi. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />Mobambikya Yesʉ yo lʉkɨmba lwa ngʉla<note caller="+" style="f"><char style="fr" closed="false">15:17 </char><char style="ft" closed="false">Lʉkɨmba lwa ngʉla: Nɨ lʉkɨmba lwa kɨtsɨro kɨnene lwa rangi nyɨthʉkʉla, lwagenda olʉbɨkɨrwa abamɨ basha na ko bandʉ bakʉlʉ. N'erangi eyo yabyaga y'omwamɨ w'abaroma.</char></note>, na mobalʉka kakira mʉ mʉthahɨ alɨko mɨshakɨ na mobamwambikyako ko muthwe. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />Honyuma kw'aho mobathanga ɨmʉketsya bathɨ: «Woyo he, mwamɨ w'aBayuta!» <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />Bagenda abamuhumanga lʉsheke ko muthwe n'ɨmʉtsɨrako mathandɨ. Honyuma kw'aho mobafʉkama n'iunama embere sɨwe. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Babere bamamala ɨmʉshekeretsya, mobamwambʉlako olʉkɨmba lw'engʉla olo, n'ɨshʉba mwambikya esongɨmba sɨwe. Honyuma kw'aho, mobamʉhʉlʉkɨtsya embʉga bʉshana n'ɨya mʉbamba ko mʉsalaba.<verse eid="MRK 15:20" /></para>
  <para style="s">Yesʉ abambwa ko mʉsalaba</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mat 27:32-44</ref>; <ref loc="LUK 23:26-43">Luk 23:26-43</ref>; <ref loc="JHN 19:17-27">Yoa 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />Babere banemʉgenda, mobahindana na muyira mʉgʉma w'iKurene yo wagenda ahʉlawamo Simoni, ishe wa Likisa na Rʉfʉ<note caller="+" style="f"><char style="fr" closed="false">15:21 </char><char style="ft" closed="false">Rʉfʉ: Soma Baroma 16:13.</char></note>. Simoni oyo agenda athoka engero. Abashirikani mobamʉkara-kara aheke omʉsalaba wa Yesʉ. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />Mobahikya Yesʉ yo handʉ aho hanahʉlwamo Ngolingota, n'ɨnegena mbʉ: «Handʉ h'ɨfʉha lya kahangali»<note caller="+" style="f"><char style="fr" closed="false">15:22 </char><char style="ft" closed="false">Ngolingota: Soma Mat 27:33.</char></note> <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />Mobamʉha tifayi yabyaga niyithulungene na manemane, hewethuwe mwathɨndaro. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Honyuma kw'aho, mobamʉbamba ko mʉsalaba. Mobagaba esongɨmba sɨwe mw'ɨkoleratho bwɨkɨ, bʉshana bamɨnye nga nɨ lʉkɨmba lʉhe lo bʉlɨ mʉgʉma atholere ɨheka. <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />Bwabyaga saha ishathu sa makerakera, babere bamʉbamba ko mʉsalaba. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />Mobashaka kʉ kɨshayɨ ebɨnwa byo byalekaga nɨbamʉsohera olʉholo. Ebɨnwa ebyo byabyaga bishakire ko kɨshayɨ ekyo nibinegenire bɨthɨ: «Mwamɨ w'aBayuta». <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />Na kuthyo mobabamba bashamuli babɨrɨ ko mɨsalaba hagʉma na Yesʉ, mʉgʉma ko lʉnda lʉwe lw'amalyo n'ogʉndɨ ko lwa malembe. [<verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />Amashako Abuyirire wo anegenire athya mwabererera: «Mwaganzwa hagʉma n'abakoli b'ebɨbɨ.»]<note caller="+" style="f"><char style="fr" closed="false">15:28 </char><char style="ft" closed="false">Soma Isaya 53.12.</char></note><verse eid="MRK 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29" />Abandʉ bo bagenda abatsʉka aho, mobamuhangya niabathengania emithwe yabo. Nɨabanegena bathɨ: «Mbe tha! Ɨwe washondaga ɨshambʉla eNyʉmba ya Gongo n'ihimba yɨndɨ mʉ bɨro bɨshathʉ, <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />ɨngo, yɨshabʉle wowene, n'iyikimya ko mʉsalaba!» <verse eid="MRK 15:30" /><verse number="31" style="v" sid="MRK 15:31" /><char style="w" lemma="abaheri bakʉlʉ">Abaheri bakʉlʉ</char> <char style="w" lemma="bakangɨrɨtsya b'oMʉgomba">n'abakangɨrɨtsya b'oMʉgomba</char>nabo kuthyo mobashekeretsya Yesʉ, nɨabanegena bathɨ: «Mwashabʉla abandɨ, hewethuwe lɨno amalemwa ɨyɨshabʉla yowene! <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />Ewo, amabya n'ɨye yo Kirisito, Mwamɨ w'aBaisiraeli, ayikimye ko <char style="w" lemma="mʉsalaba">mʉsalaba</char> bʉshana nethwe thʉlole na thʉmwɨkɨrɨtsye.»</para>
  <para style="p" vid="MRK 15:32">Abo babambawa hagʉma naye, nabo kuthyo mobamuhangyako.<verse eid="MRK 15:32" /></para>
  <para style="s">Lʉholo lwa Yesʉ</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mat 27:45-56</ref>; <ref loc="LUK 23:44-49">Luk 23:44-49</ref>; <ref loc="JHN 9:28-30">Yoa 9:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Bwabere bwabya saha ndathʉ, omwitsimya mwabya ko kɨhʉgo kyoshi ihika kʉ saha mwenda. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Ko saha mwenda, Yesʉ mwahambala athɨ: «Eloi, Eloi, lama sabakatani.» N'ɨnegena mbʉ: «Gongo waye, Gongo waye, bʉshana na ki wamanyishiga?» <verse eid="MRK 15:34" /><verse number="35" style="v" sid="MRK 15:35" />Bagʉma mo bandʉ bo babyaga aho, babere bamwonvwa, mobanegena bathɨ: «Mwonvwe, abɨrɨkɨra Elia.» <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />Na mʉgʉma wa mʉbo mwangʉha tsʉba, mwathobetsya kɨrɨmbo mo tifayi ɨtsʉkɨrene<note caller="+" style="f"><char style="fr" closed="false">15:36 </char><char style="ft" closed="false">Tifayi ɨtsʉkɨrene: Alɨnga nɨ mafʉ w'abatsene n'abashirikani. Soma Saburi 69:22.</char></note> n'ɨmɨnɨrakyo kʉ lʉsheke. Honyuma kw'aho, mw'ɨrʉkɨtsyaro Yesʉ, bʉshana ashomero. Nɨanegena athɨ: «Mwathalika, thʉlole nga Elia ahika imukimya ko mʉsalaba.» <verse eid="MRK 15:36" /><verse number="37" style="v" sid="MRK 15:37" />Hewethuwe Yesʉ mwahambala mʉ mʉlenge mʉnene, na mwatsa omʉthɨma.<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />Aho epasɨya <char style="w" lemma="Nyʉmba ya Gongo">y'omo Nyʉmba ya Gongo</char><note caller="+" style="f"><char style="fr" closed="false">15:38 </char><char style="ft" closed="false">Soma Ɨthoka 26:31-33.</char></note> moyabereka bɨhande bɨbɨrɨ ɨthangɨra elʉgʉ ihika ahishi. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />Omʉkʉlʉ w'abashirikani yo wabyaga imene embere sa Yesʉ, abere ashʉnga nga kw'amatsa omʉthɨma, mwanegena athɨ: «Kwenene omʉndʉ oyu athalɨ <char style="w" lemma="Mʉgala wa Gongo">Mʉgala wa Gongo</char>!»<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />Habyaga bakatsɨ bagʉma bo bagendaga abashʉngɨrabyo hale. Mo kathi kabo habyaga Marɨa w'ɨMangɨndala, Marɨa nyinya w'omʉtsana Yakobo na Yose na ʉndɨ mʉkatsɨ ye Salome. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />Abakatsɨ aba nɨ abo bakwamaga Yesʉ n'ɨmʉkolera mo mʉgʉlʉ abyaga iNgalilaya. Na kuthyo bandɨ bakatsɨ bangɨ bo bɨrʉkɨraga naye ɨYerʉsalemʉ.<verse eid="MRK 15:41" /></para>
  <para style="s">Yesʉ athabwa</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mat 27:57-61</ref>; <ref loc="LUK 23:50-56">Luk 23:50-56</ref>; <ref loc="JHN 19:38-42">Yoa 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Bwabere bwagoroba, kʉshangwa kyabyaga kɨro ky'erithegekania eSabato, <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />mʉndʉ mʉgʉma erɨtsɨna lɨwe nɨ yo Yosefʉ w'iArimatea, mwahika. Yosefʉ oyo abyaga mʉndʉ niashikibwe mo <char style="w" lemma="Bʉshenge Bʉkʉlʉ">Bʉshenge Bʉkʉlʉ</char>, na kuthyo abyaga nialindirire erihika ly'obwamɨ bwa Gongo. Mwagenda na muhwa ewa pilato bʉshana n'ɨyashaba omʉbɨrɨ wa Yesʉ. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />Pilato mwashweka kʉtsɨbʉ abere onvwa ko Yesʉ amamala ɨfwa. Aho mwabɨrɨkɨra omʉkʉlʉ w'abashirikani oyo n'ɨmʉbʉtsya nga kwanamatsʉka ndambi nyɨre ho Yesʉ afwirire. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Abere amamala ɨhʉlɨkɨrɨtsya omʉkʉlʉ w'abashirikani oyo ko Yesʉ amalire ɨfwa, Pilato mwɨmɨra ko Yosefʉ aheke ekinda kya Yesʉ. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />Yosefʉ mwagʉla tarape, mwathokya ekinda kya Yesʉ ko mʉsalaba, mwabʉnga-bʉngɨrakyo mo tarape eyo, n'ihirakyo mw'ɨsɨnda lyo lyathimawa mo lʉkʉka. Honyuma kw'aho mwakʉmbagalɨtsya ibwe ho kyɨngɨrɨro ky'erɨsɨnda eryo. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />Marɨa w'ɨMangɨndala na Marɨa nyinya wa Yose babyaga nɨabayɨthegeretsya aho Yesʉ athabawa.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">Ilubuka lya Yesʉ</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mat 28:1-8</ref>; <ref loc="LUK 24:1-12">Luk 24:1-12</ref>; <ref loc="JHN 20:1-10">Yoa 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Ekɨro ky'<char style="w" lemma="Sabato">eSabato</char> kyabere kyahwa, Marɨa w'ɨMangɨndala, na Marɨa nyinya wa Yakobo, na Salome, mobagʉla marasi bʉshana n'ɨyahakawo ko kinda kya Yesʉ. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Moyenga, mo mambya, ko ndambi erɨshɨ lyathangaga ɨhʉlʉka, mobaya ho lɨsɨnda. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />Nabo mobagenda niababutsania bathɨ: «Nɨ ndɨ yo wathukunira eribwe eryo lɨrɨ ho kyɨngɨrɨro ky'erɨsɨnda?» <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />Bagenda abanegena bathyo kʉshangwa eribwe lyabyaga inene kʉtsɨbʉ. Hewethuwe babere bashʉmba mesho, mobashʉnga kw'eribwe eryo lyamalire ikunwa emʉsɨke. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />Abakatsɨ abo mobɨngɨra mw'ɨsɨnda, n'omo mobashʉnga mʉthabana mʉgʉma n'ikere ko lʉhande lwa malyo, niambithe ropo ya mʉshohe. Nabo mobashalima. <verse eid="MRK 16:5" /><verse number="6" style="v" sid="MRK 16:6" />Hewethuwe omʉthabana oyo, mwabwɨrabo athɨ: «Mʉthʉbahaga! Omushondya Yesʉ w'iNasareti oyo wabambawa ko mʉsalaba. Alubukire, athakɨrɨ hano. Mʉlole, hano ho bamʉbɨkaga. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Mʉgende lɨno mʉyafʉlɨre <char style="w" lemma="abɨya">abɨga</char> bʉwe na Petero b'omwatsɨ mʉthɨ: “Amabathanga iNgalilaya, nemwe mwamʉshʉnga eyo nga kw'ababwɨraga.”» <verse eid="MRK 16:7" /><verse number="8" style="v" sid="MRK 16:8" />Aho mobathoka kw'ɨsɨnda lya Yesʉ n'ɨthɨbɨtha tsʉba, kʉshangwa babyaga niabathithimana n'ɨshweka kʉtsɨbʉ. Nabo mobathabwɨra mʉndʉ woshi-woshi, kʉshangwa mobʉbaha.</para>
  <para style="s" vid="MRK 16:8">Yesʉ ahʉlʉkɨra Marɨa w'ɨMangandala</para>
  <para style="r" vid="MRK 16:8">(<ref loc="MAT 28:9-10">Mat 28:9-10</ref>; <ref loc="MAT 18:20">18:20</ref>; <ref loc="LUK 24:13-53">Luk 24:13-53</ref>; <ref loc="JHN 20:11-23">Yoa 20:11-23</ref>; <ref loc="ACT 1:6-11">Mɨko 1:6-11</ref>)</para>
  <para style="p" vid="MRK 16:8">[<verse eid="MRK 16:8" /><verse number="9" style="v" sid="MRK 16:9" />Yesʉ abere amamala ilubuka mo makera-kera w'ekɨro ky'eyenga, mwathanga ɨhʉlʉkɨra Marɨa w'ɨMangɨndala, oyo abɨngagako emɨtsɨmʉ mɨbɨ ɨrɨnda. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Marɨa oyo mwaya fʉlɨra omwatsɨ w'abo babyaga hagʉma na Yesʉ. Mo ndambi eyo babyaga nɨabathabagana n'ɨrɨrɨra Yesʉ. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Nabo babere bonvwa Marɨa abwɨrabo ko Yesʉ alɨho, na ko amamʉlolako, mobathamwɨkɨrɨtsya.<verse eid="MRK 16:11" /></para>
  <para style="s">Yesʉ ahʉlʉkɨra abɨga babɨrɨ</para>
  <para style="r">(<ref loc="LUK 24:13-35">Luk 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />Honyuma kw'aho, <char style="w" lemma="Abɨga">bɨga</char> babɨrɨ ba Yesʉ babyaga nɨabaya mʉ mʉrongo. Yesʉ mwahʉlʉkɨrabo nɨamashosha ʉndɨ mʉhanda. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Nabo mobashʉbʉla n'ɨyafʉlɨra abandɨ bɨga b'omwatsɨ oyo. Hewethuwe nabo kuthyo mobathɨkɨrɨtsyabo.<verse eid="MRK 16:13" /></para>
  <para style="s">Yesʉ ahʉlʉkɨra abɨga ikumi n'omʉgʉma</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mat 28:16-20</ref>; <ref loc="LUK 24:36-49">Luk 24:36-49</ref>; <ref loc="JHN 20:19-23">Yoa 20:19-23</ref>; <ref loc="ACT 1:6-8">Mɨko 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Ko nduli Yesʉ mwahʉlʉkɨra abɨga bʉwe ikumi n'omʉgʉma babere balɨ abalya. Naye mwakemerabo bʉshana n'obʉthɨkɨrɨtsya bwabo na bʉshana n'obʉkalwe bwabo. Mwakemerabo athyo kʉshangwa mobathɨkɨrɨtsya abo bamʉlolagako enyuma y'erilubuka lɨwe. <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />Honyuma kw'aho mwabwɨrabo athɨ: «Mʉgende mo kɨhʉgo kyoshi mʉfʉlɨre obʉlɨ mʉndʉ y'Engʉlʉ Mbʉya. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />Obʉlɨ mʉndʉ yo wandɨkɨrɨtsya n'ibatisibwa andashabʉlwa, hewethuwe oyo ʉthɨndɨkɨrɨtsye andasohwa. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />N'abo bandanyɨkɨrɨtsya bandagenda abakola ebɨmɨnyɨkalo bɨno: “Omw'ɨtsɨna lyaye bandabɨnga emɨtsɨmʉ mɨbɨ, bandanegena mʉ mɨnegene mihya-mihya, <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />bandatsɨmba esonzoka mo minwe yabo kʉtse namo bangalya kɨmbʉlɨ-mbʉlɨ, bathɨndafwe kɨndʉ, bandahira eminwe yabo ko bakoni, n'abakoni bandalama.”»<verse eid="MRK 16:18" /></para>
  <para style="s">Yesʉ irukibwa mo lʉbʉla</para>
  <para style="r">(<ref loc="ACT 1:9-11">Mɨko 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />Nyinya-kowethʉ Yesʉ abere amamala ɨnegena nabo ebɨnwa ebyo, mwirukibwa mo lʉbʉla n'iyikala ko lʉhande lwa malyo lwa Gongo. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Abɨga mobaya fʉla Engʉlʉ Mbʉya y'ahoshi-hoshi. Nyinya-kowethʉ Yesʉ agenda akola hagʉma nabo na agendaga ahabo maka w'ɨkola bɨthɨko-thɨko mw'ikangania kw'ebyo abakangɨrɨtsya abandʉ nɨ bya kwenene.]<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>