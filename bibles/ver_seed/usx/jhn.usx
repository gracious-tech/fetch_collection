<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- KOBO BIBLE TRANSLATION</book>
  <para style="h">Yoani</para>
  <para style="toc3">Yoa</para>
  <para style="toc2">Yoani</para>
  <para style="toc1">eNgʉlʉ Mbʉya ya Yesʉ Kirisito nga ko yashakawa na Yoani</para>
  <para style="mt2">eNgʉlʉ Mbʉya ya Yesʉ Kirisito nga ko yashakawa na</para>
  <para style="mt1">YOANI</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">Kɨnwa mwahɨndʉka mʉndʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />Ko ndangɨro y'ebɨndʉ byoshi ye Kɨnwa abyagaho. Na Kɨnwa oyo abyaga hagʉma na Gongo, na Kɨnwa oyo abyaga Gongo. <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />Ko ndangɨro Kɨnwa oyo abyaga hagʉma na Gongo.<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="ft" closed="false">Soma 1-2; Migani 8:22-26.</char></note> <verse eid="JHN 1:2" /><verse number="3" style="v" sid="JHN 1:3" />Ebɨndʉ byoshi byabʉmbawa kw'ɨye, hathalɨ kɨndʉ n'ekɨgʉma kyo kyabʉmbawa bʉtsɨra ɨye.<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">Soma Ndangɨro 1:3; Saburi 33:6-9; 1Kor 8:6; Kol 1:16-17.</char></note> <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />Ɨye abyaga shoko y'obʉyɨngo, n'obʉyɨngo obu bo bwabyaga kyakakala ko bandʉ. <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />Ekyakakala ekyo ekɨnakoletsya mo mwitsimya, n'omwitsimya mwathatsimyakyo.<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />Mokwahʉlʉka mʉndʉ mbʉ yo Yoani<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="fq" closed="false">Yoani </char><char style="ft" closed="false">Yoani yo wahʉlwa hano nɨ Yoani Mubatisya. Soma emɨlondo ye 19-36.</char></note> yo Gongo athʉmaga. <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />Yoani oyo mwahika nga mutimo w'ekyakakala ekyo, bʉshana abandʉ boshi bɨkɨrɨtsye mw'ɨmʉtsʉkɨra. <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />Ɨye athabyaga ekyakakala ekyo, hewethuwe mwahika bʉshana abye mutimo w'ekyakakala ekyo. <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />Kɨnwa oyo yo kyakakala ky'ekwenene. Ekyakakala ekyo kyamahika mo kɨhʉgo, nakyo ekɨkoletsya abandʉ boshi. <verse eid="JHN 1:9" /><verse number="10" style="v" sid="JHN 1:10" />Kɨnwa oyo abyaga nɨahera mo kɨhʉgo, n'ekɨhʉgo kyabʉmbawa mw'ɨmʉtsʉkɨra. Hewethuwe ekɨhʉgo mokɨthamʉmɨnya. <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />Na Kɨnwa oyo mwahikira abandʉ b'omo kɨhʉgo kɨwe, hewethuwe abandʉ abo mobathamukokya.<verse eid="JHN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 1:12" />Hewethuwe abo bamukokaya n'ɨmwɨkɨrɨtsya, mwahabo amaka w'eribya bana ba Gongo. <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />Abana abo mobathabya bana ba Gongo kw'ɨbʉthwa lya mʉbɨrɨ, kʉtse kw'ishondya lya mʉndʉ, hewethuwe kw'ɨshasha lya Gongo. <verse eid="JHN 1:13" /><verse number="14" style="v" sid="JHN 1:14" />Ye Kɨnwa oyo mwayɨyɨramo mʉndʉ, mwikala mo kathi kethʉ, niotswiremo <char style="w" lemma="lʉkogo">olʉkogo</char> n'ekwenene. Mothwashʉnga <char style="w" lemma="lʉkengerwa">olʉkengerwa</char> lʉwe. <char style="w" lemma="lʉkengerwa">Olʉkengerwa</char> olo nɨ Gongo yowene-wene yo wahagalo Mʉgala ʉwe kyʉsha.<verse eid="JHN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />Yoani abyaga mutimo wa Mʉgala wa Gongo oyo, agenda ahambala mʉ mʉlenge mʉnene athɨ: «Ono yo nyahʉlaga nyɨthɨ: “Oyo uhika enyuma kw'ingye nɨ mʉkʉlʉ kw'inyirengya, kʉshangwa abyagaho embere nyɨbʉthwe.”»<verse eid="JHN 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16" />Ithwe boshi thwamalire ɨbona mʉhango w'<char style="w" lemma="lʉkogo">olʉkogo</char> lʉwe, mw'ɨthʉha migisha mɨngɨ kʉtsɨbʉ. <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />Gongo mwathʉha <char style="w" lemma="Mʉgomba">oMʉgomba</char> kw'ɨtsʉkɨra Mʉsa, hewethuwe <char style="w" lemma="lʉkogo">olʉkogo</char> n'ekwenene mobyahika ɨtsʉkɨra kʉ Yesʉ Kirisito. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />Hathalɨ kiro na mʉndʉ n'omʉgʉma yo wamalire ɨshʉnga Gongo. Hewethuwe Mʉgala ʉwe kyʉsha mʉsha, naye nɨ Gongo yo wikere hagʉma n'Ishe, ɨye mʉsha yo wathʉmɨnyɨsaya ɨye.<verse eid="JHN 1:18" /></para>
  <para style="s">Obutimo bwa Yoani Mubatisya</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mat 3:1-12</ref>; <ref loc="MRK 1:1-8">Mar 1:1-8</ref>; <ref loc="LUK 3:1-18">Luk 3:1-18</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />Abakʉlʉ b'<char style="w" lemma="Bayuta">aBayuta</char> ɨthoka ɨYerʉsalemʉ mobathʉma kʉ Yoani ko <char style="w" lemma="Baheri">aBaheri</char> n'<char style="w" lemma="Balawi">aBalawi</char> bʉshana n'ɨmʉbʉtsya bathɨ: «Ɨwe ʉlɨ ndɨ?» <verse eid="JHN 1:19" /><verse number="20" style="v" sid="JHN 1:20" />Yoani mwashʉbɨtsyabo bʉrora-rora bʉthayɨgana athɨ: «Ingye nyɨthalɨ ngyo <char style="w" lemma="Kirisito">Kirisito</char>.»<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />Aho mobamʉbʉtsya bathɨ: «Ewono! Ʉlɨ ndɨ? Ɨwe nɨ Elia?» Mwashubya athɨ: «Ingye nyɨthalɨ Elia.» Mobashʉba mʉbʉtsya bathɨ: «Ʉlɨ omʉmɨnyeretsɨ yo wahʉlawa<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="fq" closed="false">Mʉmɨnyeretsɨ yo wahʉlawa </char><char style="ft" closed="false">Abayuta babyaga nibalindirire mʉmɨnyeretsɨ yo wabyaga nialindirirwe ihika, bʉshana n'ithegekaniabo embere y'erihika lya Kirisito. </char></note>?» Mwashubya athɨ: «Ɨhɨ.» <verse eid="JHN 1:21" /><verse number="22" style="v" sid="JHN 1:22" />Aho mobamʉbwɨra bathɨ: «Ewono ʉlɨ ndɨ no? Thʉbwɨre nɨmo thwabona ebyo thwashʉbɨtsya abo bathathʉthʉma. Oʉyɨnegenako ki wowene?»<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />Yoani mwashubya athɨ: «Ingye nyɨrɨ</para>
  <para style="q" vid="JHN 1:23">omʉlenge w'oyo ʉhambala mo mbwarara athɨ:</para>
  <para style="q1" vid="JHN 1:23">“Muthungananie enzɨra ya Nyinya-kowethʉ!”<note caller="+" style="f"><char style="fr" closed="false">1:23 </char><char style="ft" closed="false">Soma Isaya 40:3.</char></note>»</para>
  <para style="m" vid="JHN 1:23">nga kw'omʉmɨnyeretsɨ Isaya anegenaga.<verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />Abo bathʉmawa babyaga <char style="w" lemma="Bafarisayo">Bafarisayo</char>. <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />Mobashʉba bʉtsya Yoani bathɨ: «Wamabya nɨ ʉthalɨ Kirisito, kʉtse Elia, kʉtse omʉmɨnyeretsɨ, ewono, ogubatisya abandʉ bʉshana na ki?» <verse eid="JHN 1:25" /><verse number="26" style="v" sid="JHN 1:26" />Yoani mwashʉbɨtsyabo athɨ: «Ingye enyibatisya abandʉ mo metsi, hewethuwe mo kathi kenyu mʉlɨ mʉndʉ yo muthetsi. <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />Omʉndʉ oyo ahika enyuma kw'ingye. Nangye nyɨthatholere ɨmɨnʉla emiriki y'oko bɨrato bɨwe.»<note caller="+" style="f"><char style="fr" closed="false">1:27 </char><char style="ft" closed="false">Kera, aBayuta babyaga na mɨbere, nɨ abakoli bo bagenda abamɨnʉla emiriki y'ebɨrato by'abo nyinya-kowabo.</char></note><verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />Ebyoshi ebyo byakolekaga ko muyi w'ɨBetanɨa<note caller="+" style="f"><char style="fr" closed="false">1:28 </char><char style="ft" closed="false">Betanɨa abyaga ʉndɨ muyi eyishirya w'olwitsi lw'eYorotani. Omuyi oyo athalɨ mʉgʉma na wo Marɨa na Lasaro babyagamo.</char></note>, ko mwishirya w'olwitsi lw'eyorotani, aho Yoani agenda abatisirya.<verse eid="JHN 1:28" /></para>
  <para style="s">Yesʉ nɨ kyana ky'embuli kya Gongo</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />Bwabere bwakya, Yoani mwashʉnga Yesʉ niamuhikira, mwanegena athɨ: «Shʉnga ono yo Kyana ky'eMbuli kya Gongo kyo kithokya ebɨtsɨbʉ ko bandʉ b'ekɨhʉgo. <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />Nɨ oyu yo nyahʉlaga nyɨthɨ: “Okuhika mʉndʉ mʉgʉma enyuma kw'ingye, hewethuwe nɨ mʉkʉlʉ kw'ingye kʉshangwa abyagaho embere kw'ingye.” <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />Nangye nyabyaga ninyithamwetsi, hewethuwe nyahikaga ibatisya mo metsi bʉshana nyɨmʉmɨnyɨse ko bandʉ b'iIsiraeli.»<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />Yoani mwaletha obutimo bʉno athɨ: «Monyɨshʉnga oMʉthɨma Mwerʉ niakima ɨthoka elʉbʉla nga kalikuku n'imwikirako.<note caller="+" style="f"><char style="fr" closed="false">1:32 </char><char style="ft" closed="false">Soma Isaya 11:2; 61:1.</char></note> <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />Nangye nyabyaga ninyithamwetsi, hewethuwe Gongo yo wanyɨthʉmaga nyibatisye mo metsi mwanyɨbwɨra athɨ: “Oyo wandashʉnga ikirako oMʉthɨma Mwerʉ n'imwikalako, omʉndʉ oyo yo ubatisya mo Mʉthɨma Mwerʉ.” <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />Ingye monyɨshʉnga ebyo, nangye nyɨrɨ mutimo kw'oyu nɨ Mʉgala wa Gongo.»<verse eid="JHN 1:34" /></para>
  <para style="s">Yesʉ abɨrɨkɨra abɨga bʉwe bambere</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />Bwabere bwakya, Yoani abyaga nɨakɨnalɨ aho na babɨrɨ b'omo <char style="w">abɨga</char> bʉwe. <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />Abere ashʉnga Yesʉ atsʉka, mwanegena athɨ: «Shʉnga ono yo Kyana ky'eMbuli kya Gongo!»<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />
    <char style="w">Abɨga</char> babɨrɨ abo babere bonvwa ebyo, mobakwama Yesʉ. <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />Yesʉ abere akebʉka mwashʉnga ko bamukwamire. Mwabʉtsyabo athɨ: «Omushondya ki?» Nabo mobamʉshʉbɨtsya bathɨ: «Rabi wikere hayi kwenzi?» (Rabi n'ɨnegena mbʉ Mʉkangɨrɨtsya). <verse eid="JHN 1:38" /><verse number="39" style="v" sid="JHN 1:39" />Naye mwabwɨrabo athɨ: «Muhike na mwalola.» Aho mobagenda, mobashʉnga aho abyaga ikere, mobashiba naye ekɨro ekyo. Endambi eyo, yabyaga hofɨ saha ikumi s'igolo. <verse eid="JHN 1:39" /><verse number="40" style="v" sid="JHN 1:40" />Ndereya mʉgalabo Simoni Petero abyaga mʉgʉma w'oko babɨrɨ bo bonvwaga ebɨnwa bya Yoani n'ɨkwama Yesʉ.<verse eid="JHN 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 1:41" />Ndereya mwathanga ieya Simoni mʉgalabo n'ɨmʉbwɨra athɨ: «Thwamashʉnga Masia!» <char style="w" lemma="Masia">Masia</char>, n'ɨnegena mbʉ: «<char style="w" lemma="Kirisito">Kirisito</char>.» <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />Honyuma kw'aho, Ndereya mwathwala Simoni eyɨrɨ Yesʉ. Yesʉ mwamʉhandako amesho, mwanegena athɨ: «Ɨwe nɨ Simoni mʉgala wa Yoani<note caller="+" style="f"><char style="fr" closed="false">1:42 </char><char style="fq" closed="false">Yoani </char><char style="ft" closed="false">Mashako magʉma w'eKikiriki abanahʉla mʉ Yoani mo Yona.</char></note>. Wagenda alʉkwamo Kefa. Amatsɨna Kefa na Petero nɨ magʉma. N'awabɨrɨ anegenire mbʉ: “Ibwe”.»<verse eid="JHN 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />Bwabere bwakya, Yesʉ mwahamʉla ɨya iNgalilaya. Mwahindana na Filipo n'ɨmʉbwɨra athɨ: «Nyɨkwame!»<verse eid="JHN 1:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 1:44" />Filipo oyo abyaga mbʉthɨrwa w'omo muyi w'ɨBetesaita, nɨ omo muyi oyo wo Ndereya na Petero bathokagamo.<verse eid="JHN 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 1:45" />Honyuma kw'aho, Filipo mweya Natanaele n'ɨmʉbwɨra athɨ: «Thwamashʉnga omʉndʉ yo Mʉsa ahʉlaga mo kɨtabo ky'<char style="w" lemma="Mʉgomba">oMʉgomba</char> na yo abamɨnyeretsɨ bahʉlaga.<note caller="+" style="f"><char style="fr" closed="false">1:45 </char><char style="ft" closed="false">Soma Ibʉka Mʉgomba 18:18; Isaya 9:5-6; Tsekeli 34:23.</char></note> Nɨ Yesʉ mʉgala wa Yosefʉ, w'iNasareti.» <verse eid="JHN 1:45" /><verse number="46" style="v" sid="JHN 1:46" />Aho, Natanaele mwamʉbwɨra athɨ: «iNasareti yanganathoka kɨndʉ kikwirire?» Filipo mwamʉbwɨra athɨ: «Hika ʉlole.»<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />Yesʉ abere ashʉnga Natanaele alɨ amuhikira, mwanegena bʉshana naye athɨ: «Shʉnga oMuisiraeli w'ekwenene, athalɨmo buliribangania na hake!» <verse eid="JHN 1:47" /><verse number="48" style="v" sid="JHN 1:48" />Natanaele mwabʉtsya Yesʉ athɨ: «Ʉthɨ ko wamanyɨmɨnya?»</para>
  <para style="p" vid="JHN 1:48">Yesʉ mwamʉshʉbɨtsya athɨ: «Filipo athabere athetsi aya kʉbɨrɨkɨra, monyɨkʉshʉnga wikere mo kɨsɨna ky'omʉthɨ w'omutini<note caller="+" style="f"><char style="fr" closed="false">1:48 </char><char style="ft" closed="false">Ɨkwamana n'amashako w'abaheri, abandʉ bagenda abikala mo ndina y'omutini balɨ abɨga n'ɨsoma eKɨnwa kya Gongo.</char></note>.» <verse eid="JHN 1:48" /><verse number="49" style="v" sid="JHN 1:49" />Natanaele mwamʉbwɨra athɨ: «<char style="w" lemma="Rabi">Rabi</char>, ʉlɨ <char style="w" lemma="Mʉgala wa Gongo">Mʉgala wa Gongo</char>, na kandɨ ɨwe ʉlɨ mwamɨ w'aBaisiraeli!»<note caller="+" style="f"><char style="fr" closed="false">1:49 </char><char style="ft" closed="false">Soma Saburi 2:7; Sefanɨa 3:15. </char></note> <verse eid="JHN 1:49" /><verse number="50" style="v" sid="JHN 1:50" />Yesʉ mwamʉshʉbɨtsya athɨ: «Kʉshangwa nyamakʉbwɨra nyɨthɨ monyɨkʉshʉnga mo kɨsɨna ky'omʉthɨ w'omutini kyamaleka nɨwɨkɨrɨtsya? Washʉnga kʉ bɨnene-bɨnene kw'ebi.» <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />Ko nduli Yesʉ mwashʉba negena athɨ: «Kwenene, kwenene enyɨbabwɨra, mwashʉnga olʉbʉla nɨ lwamakɨngʉkala, na abamalaɨka ba Gongo nɨabɨrʉka n'ikima ahalɨ o<char style="w" lemma="Mwana w'oMʉndʉ">Mwana w'oMʉndʉ</char>.»<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">Ekɨthɨko-thɨko kɨmbere kya Yesʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />Mo kɨro kya kashathʉ, mokwabya buheruki mo muyi w'ɨKana mo kɨhʉgo ky'iNgalilaya. Na nyinya wa Yesʉ abyagaho. <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />Yesʉ <char style="w" lemma="Abɨga">n'abɨga</char> bʉwe nabo mobalalɨkwa ko buheruki obo.<verse eid="JHN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 2:3" />Etifayi yabere yahwa, nyinya wa Yesʉ mwabwɨra Mʉgala athɨ: «Bathakiwithe kʉ tifayi.»<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />Hewethuwe Yesʉ mwamʉshʉbɨtsya athɨ: «Mbe malɨ, unyishondyako ki? Endambi aye ithetsi yahika.» <verse eid="JHN 2:4" /><verse number="5" style="v" sid="JHN 2:5" />Nyinya mwabwɨra abakoli bo bagenda abathenga etifai athɨ: «Ebyoshi ababwɨra, mʉkolebyo.»<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />Aho habyaga bɨrega ndathʉ byakomibawa mʉ mabwe, ebyo <char style="w" lemma="Bayuta">aBayuta</char> bagenda abahiramo ametsi w'erɨyetsyamo. Na mo bʉlɨ kɨrega mwagenda omwɨngɨra hofɨ litere igana lya metsi.<verse eid="JHN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 2:7" />Yesʉ mwabwɨra abakoli abo athɨ: «Mwotsutsye ebɨrega ebi byo metsi.» Nabo mobotsutsyabyo metsi bʉyɨ-bʉyɨ.<verse eid="JHN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 2:8" />Nɨmo Yesʉ abwɨrabo athɨ: «Mʉthehe ko metsi aya na mʉthwalɨre kʉwo kw'omʉkʉlʉ w'elinye.» Abakoli mobamʉthwalɨra kʉwo. <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />Omʉkʉlʉ w'elinye mwagetsya ametsi ayo nɨamamala ɨhɨndʉka tifayi. Hewethuwe mwathamɨnya nga etifayi eyo ɨthathoka hayi. Abakoli bo bathehaga ko metsi basha bo bamɨnyaga aho yɨthathoka.</para>
  <para style="p" vid="JHN 2:9">Aho omʉkʉlʉ w'elinye mwabɨrɨkɨra omuherukya, <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />n'ɨmʉbwɨra athɨ: «Abandʉ boshi abanathanga ɨha bo bathalalɨkwa bw'etifayi ikwirire kʉtsɨbʉ, bamamala ikunda nɨmo wahabo omʉshʉshʉle. Hewethuwe ɨwe moʉbɨka etifayi yikwire ihika lɨno!»<verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />Kuthyo ko Yesʉ akolaga ekɨmɨnyɨkalo kɨwe kɨmbere mo muyi w'ɨKana mo kɨhʉgo ky'iNgalilaya. Aho, mwakangania olʉkengerwa lʉwe, <char style="w" lemma="Abɨga">n'abɨga</char> bʉwe mobamwɨkɨrɨtsya.<verse eid="JHN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />Honyuma kw'aho mwandagalɨra ɨKaperenaʉmʉ hagʉma na nyinya, na bagala babo <char style="w" lemma="Abɨga">n'abɨga</char> bʉwe. Hewethuwe mobikalako bɨro bɨke.<verse eid="JHN 2:12" /></para>
  <para style="s">Yesʉ abɨnga abahingania mo Nyʉmba ya Gongo</para>
  <para style="r">(<ref loc="MAT 21:12-13">Mat 21:12-13</ref>; <ref loc="MRK 11:15-17">Mar 11:15-17</ref>; <ref loc="LUK 19:45-46">Luk 19:45-46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />Aho ePasaka <char style="w" lemma="Bayuta">y'aBayuta</char> yabyaga nɨyɨrɨ hofɨ, Yesʉ mwɨrʉkɨra ɨYerʉsalemʉ. <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />Abere ahika mo kɨbʉga ky'eNyʉmba ya Gongo mweya bandʉ nɨabagʉlɨtsyamo esonde, na mbuli na thulikuku na kuthyo abahingania b'esofaranga nabo nɨbalɨmo.<verse eid="JHN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 2:15" />Aho mwalʉka lʉkoba, mwayɨralo mo lʉbasha, mwahɨga abandʉ boshi n'esombuli n'esonde sabo mo kɨbʉga ky'eNyʉmba ya Gongo. Mwapanza esofaranga s'abahingania, n'ɨbɨndʉngʉla eso nyɨgalɨ sabo. <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />Na bo bagenda abagʉtsya othulikuku, Yesʉ mwabwɨrabo athɨ: «Muthokye ebyoshi ebyo byo hano. Mʉthayɨraga eNyʉmba ya Thatha mo nyʉmba ya buhingania.»<verse eid="JHN 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 2:17" />
    <char style="w">Abɨga</char> bʉwe mobɨbʉka ko kushakirwe mo Mashako Abuyirire kʉthɨ: «Olwanzo nyɨrɨ nalo ko Nyʉmba awe lwanyɨmala.<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="ft" closed="false">Soma Saburi 69:10.</char></note>»<verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />Aho <char style="w" lemma="Bayuta">abakʉlʉ b'aBayuta</char> mobabʉtsya Yesʉ bathɨ: «Kɨmɨnyɨkalo kɨhe ky'erishwekya kyo wathukangya bʉshana thʉmɨnye ko uwithe maka w'ɨkola uthyo?»<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />Yesʉ mwashʉbɨtsyabo athɨ: «Muhimbule eNyʉmba ya Gongo eyi, na mʉ bɨro bɨshathʉ nyashʉba imaniaro.» <verse eid="JHN 2:19" /><verse number="20" style="v" sid="JHN 2:20" />Aho <char style="w" lemma="Bayuta">aBayuta</char> abo mobamʉbwɨra bathɨ: «eNyʉmba ya Gongo eyi yotsuliraga myaka makumi ane na ndathʉ, nawe ʉthɨ wimaniaro mʉ bɨro bɨshathʉ kuroshi?»<verse eid="JHN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21" />Hewethuwe eNyʉmba ya Gongo yo Yesʉ agenda ahʉla, yabyaga nɨ omʉbɨrɨ ʉwe. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />Honyuma kw'aho, Yesʉ abere alubuka, <char style="w">abɨga</char> bʉwe mobɨbʉka ko mwasɨmolerabo ekɨnwa eki, aho mobɨkɨrɨtsya aMashako n'ebɨnwa Yesʉ anegenaga.<verse eid="JHN 2:22" /></para>
  <para style="s">Yesʉ etsi ebyoshi bɨrɨ mo mɨthɨma y'abandʉ</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />Yesʉ abere alɨ ɨYerʉsalemʉ ko kɨro kɨkʉlʉ ky'ePasaka mwakola bɨthɨko-thɨko. Bʉshana n'erɨlola ko bɨthɨko-thɨko akolaga, bandʉ bangɨ mobamwɨkɨrɨtsya.<verse eid="JHN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 2:24" />Hewethuwe Yesʉ ɨye, mwathɨkɨrɨtsyabo kʉshangwa abyaga nietsi aboshi bo kʉtsɨbʉ. <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />Kandɨ mwathashondya bamʉfʉlɨre mwatsɨ wa mʉndʉ mʉlebe, kʉshangwa abyaga nietsi ebɨrɨ mo mɨthɨma y'abandʉ.<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">Yesʉ asɨmola na Nikotemo</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />Kwabyaga muyira mʉgʉma yo wagenda ahʉlwamo Nikotemo. Nikotemo oyo abyaga mʉgʉma w'oko bangʉmwa b'aBayuta. Na kuthyo abyaga w'omo kɨkembe ky'aBafarisayo. <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />Kɨro kɨgʉma mwahikira Yesʉ mo kɨro n'ɨmʉbwɨra athɨ: «Rabi, thwetsi kw'ɨwe ʉlɨ <char style="w" lemma="Mʉkangɨrɨtsya">Mʉkangɨrɨtsya</char> yo wathʉmawa na Gongo, kʉshangwa hathalɨ mʉndʉ yo wangakola ebɨmɨnyɨkalo ebyo oʉkola Gongo amabya athalɨ hagʉma naye.» <verse eid="JHN 3:2" /><verse number="3" style="v" sid="JHN 3:3" />Yesʉ mwamʉshʉbɨtsya athɨ: «Kwenene, kwenene enyɨkʉbwɨra, omʉndʉ athangɨngɨra mo bwamɨ bwa Gongo athetsi abʉthwa ngendo lya kabɨrɨ<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">Ngendo ya kabɨrɨ: Mo Kikiriki ekɨnwa eki kinegenire mbʉ «ɨthoka elʉgʉlʉ.» </char></note>.» <verse eid="JHN 3:3" /><verse number="4" style="v" sid="JHN 3:4" />Nikotemo mwamʉbʉtsya athɨ: «Omʉndʉ angashʉba bʉthwa athɨ yo wahera mʉshyakʉlʉ? Angashʉba ɨngɨra mo nda ya nyinya n'ɨshʉba bʉthwa ngendo lya kabɨrɨ?» <verse eid="JHN 3:4" /><verse number="5" style="v" sid="JHN 3:5" />Yesʉ mwamʉshʉbɨtsya athɨ: «Kwenene, kwenene enyɨkʉbwɨra nyɨthɨ, omʉndʉ amabya athabuthirwe ko metsi na ko Mʉthɨma Mwerʉ, athangɨngɨra mo Bwamɨ bwa Gongo. <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />Ekyo kyabʉthawa ko mʉbɨrɨ nɨ mʉbɨrɨ, n'ekyo kyabʉthawa ko Mʉthɨma Mwerʉ nɨ mʉthɨma. <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />Ʉthashwekaga kʉshangwa monyɨkʉbwɨra nyɨthɨ: “Mʉtholere nɨmwabʉthwa erya kabɨrɨ.” <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />Embeho eyɨnalotsya yo yishashire, hewethuwe uthetsi yo yɨthoka na yo yɨya. Na bathyo ko binabya ko bʉlɨ mʉndʉ yo ʉthabʉthwa ko Mʉthɨma Mwerʉ.» <verse eid="JHN 3:8" /><verse number="9" style="v" sid="JHN 3:9" />Nikotemo mwamʉbwɨra athɨ: «Ebyo byangakoleka bɨthɨ?» <verse eid="JHN 3:9" /><verse number="10" style="v" sid="JHN 3:10" />Yesʉ mwamʉshʉbɨtsya athɨ: «Ɨwe ʉlɨ mʉkangɨrɨtsya mo Isiraeli, uthetsi ebɨnwa bɨno! <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />Kwenene, kwenene enyɨkʉbwɨra: othʉnegena ebɨnwa byo thwetsi n'ɨhana butimo ko byo thwashʉngagako, hewethuwe imwe mo muthashonditsye ɨangɨrɨra obutimo bwethʉ. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />Na mwamabya mʉthɨkɨrɨtsye mo ndambi enyɨbabwɨra ebɨndʉ by'ekɨhʉgo kʉthɨ ko mwangɨkɨrɨtsya nyamababwɨra ebɨndʉ by'omo lʉbʉla? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />Kʉshangwa hathalɨ mʉndʉ yo w'ɨrʉkɨraga mo lʉbʉla, athalɨ Mʉgala w'oMʉndʉ yo wakimaga ɨthoka mo lʉbʉla. <verse eid="JHN 3:13" /><verse number="14" style="v" sid="JHN 3:14" />Nga ko Mʉsa ahanɨkaga enzoka y'omʉlɨnga mo mbwarara, ni bathyo ko Mʉgala w'oMʉndʉ naye lɨtholere nɨahanɨkwa, <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />bʉshana obʉlɨ omʉndʉ yo ʉmwɨkɨrɨtsye abone obʉyɨngo bw'ekera n'ekera. <verse eid="JHN 3:15" /><verse number="16" style="v" sid="JHN 3:16" />Kʉshangwa Gongo mwatsɨɨra kʉtsɨbʉ abandʉ b'omo kɨhʉgo, mwahika ko kɨka ky'erɨhana Mʉgala ʉwe kyʉsha, bʉshana obʉlɨ mʉndʉ yo ʉmwɨkɨrɨtsye athaheraga, hewethuwe abone obʉyɨngo bw'ekera n'ekera. <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />Gongo mwathathʉma Mʉgala ʉwe mo kɨhʉgo bʉshana asohe abandʉ b'omo kɨhʉgo, hewethuwe Gongo athʉmaga Mʉgala bʉshana mw'ɨtsʉkɨra ɨye ashabʉle abandʉ. <verse eid="JHN 3:17" /><verse number="18" style="v" sid="JHN 3:18" />Oyo wɨkɨrɨtsye Mʉgala wa Gongo athasohirwe, hewethuwe yo ʉthɨkɨrɨtsye amalire ɨsohwa, kʉshangwa mwathɨkɨrɨtsye Mʉgala wa Gongo, kyʉsha. <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />Na shʉnga ekyo kɨnaleka abandʉ nɨ basohwa: ekyakakala mokyahika mo kɨhʉgo, he abandʉ mobatsɨɨra omwitsimya kʉlenga ekyakakala, kʉshangwa emɨkolano yabo yabyaga mɨbɨ. <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />Kʉshangwa obʉlɨ mʉndʉ oyo ʉkola ebɨbɨ, anabaga ekyakakala. Kandɨ anathɨnda ihika ahalɨ ekyakakala bʉshana ebɨbɨ bɨwe bɨthashʉngɨkaga. <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />Hewethuwe oyo ʉnakola eby'ekwenene anaya eyɨrɨ ekyakakala, bʉshana emɨkolano yɨwe ɨmɨnyɨkale kʉbʉya ko eyɨkoleka nga ko Gongo ahamulire.»<verse eid="JHN 3:21" /></para>
  <para style="s">Yesʉ na Yoani Mubatisya</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />Honyuma w'ebyoshi ebyo, Yesʉ hagʉma n'abɨga bʉwe mobaya mo kɨhʉgo ky'iYuteya. Mwabya nabo eyo na agenda abatisya<note caller="+" style="f"><char style="fr" closed="false">3:22 </char><char style="ft" closed="false">Soma Yoa 4:1-2.</char></note> <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />Na Yoani naye kuthyo agenda abatisya mo muyi w'iAinoni hofɨ n'omuyi w'iSalimu<note caller="+" style="f"><char style="fr" closed="false">3:23 </char><char style="ft" closed="false">Ainoni na Salimu</char><char style="ft" closed="false">Ni mɨrongo ibiri ithetsibwe, mo muthiri w'olwitsi lw'eYorotani.</char></note>, kʉshangwa eyo yabyaga metsi mangɨ. Abandʉ mobamʉgendera naye mwabatisyabo. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />Kʉshangwa ko bɨro ebyo, Yoani abyaga niathetsi agʉshwa mo muliki.<note caller="+" style="f"><char style="fr" closed="false">3:24 </char><char style="ft" closed="false">Mar 6:17; Luk 3:19-20.</char></note><verse eid="JHN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />Kɨro kɨgʉma mokwahʉlʉka bʉhaka mo kathi k'abɨga ba Yoani na Muyuta mʉgʉma bʉshana n'emɨbere yabo y'erɨyetsya. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />Aho mobagendera Yoani n'ɨmʉbwɨra bathɨ: «Mʉkangɨrɨtsya, unibukire omʉndʉ yo wabyaga hagʉma nawe ko ʉndɨ mwishirya w'eYorotani yo walethagako obutimo? Ɨngo shʉnga, ɨye abatisya n'abandʉ boshi abamuhikira!» <verse eid="JHN 3:26" /><verse number="27" style="v" sid="JHN 3:27" />Yoani mwashʉbɨtsyabo athɨ: «Hathalɨ mʉndʉ yo wangawatha kʉ kɨndʉ athalɨ athahabwakyo na Gongo. <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />Imwe bene mʉlɨ batimo baye ko monyanegenire nyɨthɨ: “Nyɨthalɨ Kirisito, he nyithumirwe embere kw'ɨye.<note caller="+" style="f"><char style="fr" closed="false">3:28 </char><char style="ft" closed="false">Malaki 3:1.</char></note>” <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />Omwenye omuheruki yo muherukya, hewethuwe omwira w'omuherukya animana hofɨ naye n'ɨmʉhʉlɨkɨrɨtsya, anamoga kʉtsɨbʉ erɨonvwa omʉlenge w'omuherukya. Na kuthyo nangye nyimoyire, n'olʉmogo lwaye lulumirire. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />Lɨtholere olʉkengerwa lʉwe nɨ lwalʉga n'olʉwaye nɨlwakeha.»<verse eid="JHN 3:30" /></para>
  <para style="s">Oyo wathokaga elʉgʉlʉ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />Oyo ʉthoka elʉgʉlʉ alɨ elʉgʉlʉ w'ebyoshi, owa hano ishi nɨ wa hano ishi, naye ananegena ebɨnwa by'omo kɨhʉgo. Hewethuwe oyo ʉthoka mo lʉbʉla alɨ elʉgʉlʉ w'ebyoshi<note caller="+" style="f"><char style="fr" closed="false">3:31 </char><char style="ft" closed="false">Emɨlondo eno yangatsɨmbwa nga Makangɨrɨtsya akwamirire owa Yoani (m. 27-30) kʉtse nɨ mɨganɨtsye yo yashakaga eNgʉlʉ eno. </char></note>, <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />analetha butimo kw'ebyo ashʉngagako n'ebyo onvwa, hewethuwe hathalɨ mʉndʉ yo wɨmɨraga obutimo bʉwe. <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />Bʉlɨ mʉndʉ yo wɨmɨra obutimo bʉwe nɨamɨmɨra ko Gongo nɨ wa kwenene. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />Kʉshangwa omʉndʉ yo Gongo athʉmaga ananegena ebɨnwa bya Gongo, kʉshangwa Gongo anamwotsutsyamo <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> ʉwe wo kalengyo. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />Thatha atsiire Mʉgala ʉwe, naye amalire ihira ebɨndʉ byoshi mo minwe yɨwe. <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />Omʉndʉ yo wɨkɨrɨtsye Mʉgala wa Gongo awithe obʉyɨngo bw'ekera n'ekera. N'oyo ʉthɨnda ɨkɨrɨtsya Mʉgala wa Gongo athɨndabone obʉyɨngo obo, hewethuwe obʉhɨthane bwa Gongo bwandamubyako ko bɨro byoshi.<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">Yesʉ n'omʉkatsɨ Mʉsamarɨa</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />Yesʉ mwamɨnya ko aBafarisayo mobonvwa kw'ɨye abona bɨga bangɨ kʉlenga Yoani n'ibatisyabo. <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />Ko kwenene Yesʉ yowene mwathabatisya mʉndʉ. Hewethuwe nɨ abɨga bʉwe bo babatisaga. <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />Mwathoka mo kɨhʉgo ky'iYuteya mwashʉba mo kɨhʉgo ky'iNgalilaya. <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />Kw'ihika eyo, lyabyaga nɨlɨtholere ikirukania mo kɨhʉgo ky'ɨSamarɨa. <verse eid="JHN 4:4" /><verse number="5" style="v" sid="JHN 4:5" />Ni bathyo kw'ahikaga mu muyi mʉgʉma w'ɨSamarɨa ow'anahʉlwamo Sikari. Omuyi oyo abyaga hofɨ n'erɨshwa Yakobo ahaga mʉgala ʉwe Yosefʉ. <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />Nɨ oko ko kʉlɨ ekisima kya Yakobo. Bʉshana n'enduhi y'olʉgendo, Yesʉ mwikala ko mʉsɨke w'ekisima ekyo. Bwabyaga hofɨ saha ndathʉ.<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />Aho, mʉkatsɨ mʉgʉma Mʉsamarɨa mwitsa theha metsi. Yesʉ mwamʉbwɨra athɨ: «Nyɨhe metsi w'ɨshoma.» <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />Ko ndambi eyo, abɨga bʉwe babyaga nibayire ʉla kalyo mo muyi. <verse eid="JHN 4:8" /><verse number="9" style="v" sid="JHN 4:9" />Omʉkatsɨ Mʉsamarɨa oyo mwabwɨra Yesʉ athɨ: «Ɨwe ʉlɨ Muyuta, ʉthɨ ko wanganyɨshaba metsi ingye Mʉsamarɨa? Anegenaga athyo, kʉshangwa aBayuta bathabyaga mʉ bʉgʉma n'aBasamarɨa.» <verse eid="JHN 4:9" /><verse number="10" style="v" sid="JHN 4:10" />Yesʉ mwamʉshʉbɨtsya athɨ: «Wangaminyire ekyo Gongo anahana, na nɨ ndɨ yo ʉkʉbwɨra athɨ: “Nyɨhe metsi w'ɨshoma,” n'ɨwe wo wangamushabire ametsi, naye angakʉhere ametsi w'obʉyɨngo.» <verse eid="JHN 4:10" /><verse number="11" style="v" sid="JHN 4:11" />Omʉkatsɨ oyo mwamʉbwɨra athɨ: «Nyinya-kowethʉ, uthawite kɨndʉ ky'ɨthehamo, n'ekisima nɨ kɨre kʉtsɨbʉ. Wamathokya ametsi w'obʉyɨngo ayo wo hayi? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />Ʉlɨ mʉkʉlʉ kʉ thatha Yakobo yo wathʉhaga ekisima eki, na ɨyowene-wene mwashoma ko metsi wakyo hagʉma n'abana bʉwe n'ekihyo kɨwe.» <verse eid="JHN 4:12" /><verse number="13" style="v" sid="JHN 4:13" />Yesʉ mwamʉshʉbɨtsya athɨ: «Bʉlɨ mʉndʉ yo ʉshoma ko metsi aya andashʉbafwa nyotha. <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />Hewethuwe obʉlɨ mʉndʉ yo wandashoma ametsi wo nyandamʉha, athɨndashʉbafwe nyotha na hake. Ametsi nyandamʉha, andabya nga shoko mw'ɨye yo yɨthokamo metsi wa bʉyɨngo bwa kera na kera.» <verse eid="JHN 4:14" /><verse number="15" style="v" sid="JHN 4:15" />Omʉkatsɨ oyo mwamʉbwɨra athɨ: «Nyinya-kowethʉ, nyɨhe ko metsi ayo nɨmo nyɨthɨshʉbafwe nyotha, na nyɨthɨshʉbe hika ɨthehera hano.» <verse eid="JHN 4:15" /><verse number="16" style="v" sid="JHN 4:16" />Yesʉ mwamʉbwɨra athɨ: «Genda, ʉyabɨrɨkɨre ibawe, na uhike naye hano.» <verse eid="JHN 4:16" /><verse number="17" style="v" sid="JHN 4:17" />Omʉkatsɨ oyo mwamʉshʉbɨtsya athɨ: «Nyithawithe iba aye.» Aho, Yesʉ mwamʉbwɨra athɨ: «Wamashubya kʉbʉya ʉthɨ: “Uthawithe iba awe,” <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />kʉshangwa wabyaga na bayira bathano, n'oyo wikere naye lɨno athalɨ ibawe. Aho wamanegena kwenene.» <verse eid="JHN 4:18" /><verse number="19" style="v" sid="JHN 4:19" />Omʉkatsɨ oyo mwamʉbwɨra athɨ: «Nyinya-kowethʉ, nyamalola ko ʉlɨ mʉmɨnyeretsɨ. <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />Bo thatha-kʉlʉ mobaramya Gongo ko kɨthwa kɨno. He imwe Bayuta omʉnegena mʉthɨ: n'ɨYerʉsalemʉ ko kʉlɨ ahandʉ abandʉ bahamulirwe ɨramɨtsya Gongo.» <verse eid="JHN 4:20" /><verse number="21" style="v" sid="JHN 4:21" />Yesʉ mwamʉbwɨra athɨ: «Mbe mʉkatsɨ, ʉnyɨkɨrɨtsye, endambi eyihika yo muthindaramye Thatha ibye ko kɨthwa kɨno, ibye ɨYerʉsalemʉ. <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />Imwe Basamarɨa omunaramya Gongo bʉthamʉmɨnya. He ithwe Bayuta, othunaramya Gongo yo thwetsi kʉshangwa obushabuli buthokire ko Bayuta. <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />Hewethuwe endambi eyihika naro yamalire ihika. Abo baramya Thatha mo kwenene bangamuramya mo Mʉthɨma na mo kwenene, kʉshangwa Thatha ashondya bandʉ bo bamuramya mo mʉhanda oyo. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />Gongo nɨ Mʉthɨma, na bo bamuramya lɨtholere nibamuramya mo Mʉthɨma na mo kwenene.» <verse eid="JHN 4:24" /><verse number="25" style="v" sid="JHN 4:25" />Omʉkatsɨ oyo mwamʉbwɨra athɨ: «Nyetsi ko Masia yo ʉnahʉlwamo Kirisito andahika. Na andabya ahika andathʉkangɨrɨtsya ebɨnwa byoshi.» <verse eid="JHN 4:25" /><verse number="26" style="v" sid="JHN 4:26" />Aho Yesʉ mwamʉshʉbɨtsya athɨ: «N'ingye ngyo nyɨnegena nawe.»<verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />Ko ndambi eyo abɨga ba Yesʉ mobashʉbʉla, nabo mobashweka babere bamʉshʉnga alɨ asɨmola n'omʉkatsɨ oyo. He mohathabya mʉgʉma mʉbo yo wabutsaya omʉkatsɨ oyo nga ashondya ki kʉtse ɨbʉtsya Yesʉ nga bʉshana na ki asɨmola naye. <verse eid="JHN 4:27" /><verse number="28" style="v" sid="JHN 4:28" />Aho omʉkatsɨ oyo mwamika ekɨrega kɨwe kya metsi, mwashʉba mo muyi n'ɨbwɨra abandʉ athɨ: <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />«Muhike mʉlole omʉndʉ yo wamanyɨbwɨra ebɨnwa byoshi nyakolaga. Athangabya ni Kirisito?» <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />Aho mobathoka mo muyi na mobaya eyɨrɨ Yesʉ. <verse eid="JHN 4:30" /><verse number="31" style="v" sid="JHN 4:31" />Ko ndambi eyo, abɨga ba Yesʉ mobamʉshaba bathɨ: «Mʉkangɨrɨtsya, ulye kalyo!» <verse eid="JHN 4:31" /><verse number="32" style="v" sid="JHN 4:32" />Hewethuwe mwashʉbɨtsyabo athɨ: «Ingye nyiwithe kʉ kalyo ko muthetsi.» <verse eid="JHN 4:32" /><verse number="33" style="v" sid="JHN 4:33" />Aho abɨga bʉwe mobabutsania bathɨ: «Halɨ mʉndʉ yo wamalire ɨmʉlethera kalyo?» <verse eid="JHN 4:33" /><verse number="34" style="v" sid="JHN 4:34" />Yesʉ mwabwɨrabo athɨ: «Akalyo kaye nɨ ɨkola erɨshasha lya yo wanyɨthʉmaga n'ɨbereretsya omʉlɨmo ʉwe anyɨhaga. <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />Imwe bene mʉthalɨ omʉnanegena mʉthɨ: “Kukishiya myetsɨ ine nɨthwahʉlʉla”? H'ingye enyɨbabwɨra, mʉshʉmbe amesho, mʉshʉnge amashwa: ebɨkʉmba byerire, nabyo bɨhera byangageshwa. <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />Omugeshi amamala ɨhembwa olʉhembo lʉwe. Na akʉma-kʉma ebɨkʉmba bʉshana n'obʉyɨngo bw'ekera na kera, bʉshana omuheri n'omugeshi bamogere hagʉma. <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />Kʉshangwa omushinga ono nɨ wa kwenene owanegenire athɨ: “Mʉndʉ mʉgʉma anahera n'ogʉndɨ anahʉlʉla.” <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />Ingye, monyabathʉma ɨya hʉlʉla mw'ɨshwa lyo mʉthalʉhɨraga, abandɨ mobahɨngalyo, nemwe mwamabona endundi y'omʉlɨmo wabo.»<verse eid="JHN 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />Basamarɨa bangɨ b'omo muyi oyo mobɨkɨrɨtsya Yesʉ bʉshana n'ebɨnwa omʉkatsɨ oyo anegenaga athɨ: «Mwanyɨbwɨra ebyoshi nyakolaga!» <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />aBasamarɨa babere bamuhikira, mobamʉshaba ikale hagʉma nabo, naye mwamalayo bɨro bɨbɨrɨ. <verse eid="JHN 4:40" /><verse number="41" style="v" sid="JHN 4:41" />Na bandɨ bandʉ bangɨ kʉtsɨbʉ mobɨkɨrɨtsya bʉshana n'ebɨnwa Yesʉ yowene-wene anegenaga, <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />nabo mobabwɨra omʉkatsɨ oyo bathɨ: «Thwamamwɨkɨrɨtsya lɨno, ɨthalɨ bʉshana n'ebɨnwa wanegenaga kuroshi, hewethuwe nɨ bʉshana thwamayonvwɨra ithwe bene-bene, na thwetsi ko kwenene kw'oyu ni mushabuli w'ekɨhʉgo.»<verse eid="JHN 4:42" /></para>
  <para style="s">Yesʉ alamya mwana wa mʉkɨnga-kɨnga w'oko bwamɨ</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />Kwabere kwatsʉka bɨro bɨbɨrɨ, Yesʉ mwathoka eyo, na mwaya mo kɨhʉgo ky'iNgalilaya. <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />Yesʉ yowene-wene mwanegena athɨ: «Omʉmɨnyeretsɨ athalɨ anashikibwa mo kɨhʉgo kɨwe.»<note caller="+" style="f"><char style="fr" closed="false">4:44 </char><char style="ft" closed="false">Soma Mat 13:57; Mar 6:4; Luk 4:24.</char></note> <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />Hewethuwe abere ahika iNgalilaya, abandʉ bayo mobamukokya kʉbʉya. Kʉshangwa nabo babyaga ko linye ly'<char style="w" lemma="pasaka">ePasaka</char>, mobashʉnga ko byoshi Yesʉ akolaga ɨYerʉsalemʉ ekɨro ekyo. <verse eid="JHN 4:45" /><verse number="46" style="v" sid="JHN 4:46" />Aho Yesʉ mwashʉbaya iNgalilaya mo muyi w'ɨKana, oko ahɨndʉlɨraga ametsi mo tifayi. ɨKaperenaʉmʉ yabyaga mʉkɨnga-kɨnga mʉgʉma w'oko bwamɨ, yo wabyaga na mwana mukoni. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />Omʉkʉlʉ oyo abere onvwa ko Yesʉ amahika iNgalilaya nɨathoka iYuteya, mwamʉgendera, n'ɨmʉshaba athɨ aye ɨKaperenaʉmʉ ayalamye mʉgala yo wabyaga niathohire. <verse eid="JHN 4:47" /><verse number="48" style="v" sid="JHN 4:48" />Yesʉ mwamʉbwɨra athɨ: «Imwe mʉthangathɨkɨrɨtsya na hake muthashungire kʉ bɨmɨnyɨkalo na bɨthɨko-thɨko.» <verse eid="JHN 4:48" /><verse number="49" style="v" sid="JHN 4:49" />Omʉkʉlʉ w'oko bwamɨ oyo, mwamʉshʉbɨtsya athɨ: «Nyinya-kowethʉ enyɨkʉshaba uhike ewaye omwana aye athetsi afwa.» <verse eid="JHN 4:49" /><verse number="50" style="v" sid="JHN 4:50" />Yesʉ mwamʉbwɨra athɨ: «Shʉba ewawe, mʉgalawe aneho.» Ishe w'omwana mwɨkɨrɨtsya ekɨnwa ekyo Yesʉ amʉbwɨraga na mwagenda. <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />Abere anemʉshʉbʉla, abakoli bʉwe mobayamʉlɨndɨrɨra na mobamʉbwɨra bathɨ: «Omwanawe alɨho!» <verse eid="JHN 4:51" /><verse number="52" style="v" sid="JHN 4:52" />Aho, mwabʉtsyabo ng'omwana athalama kʉ ndambi sɨngahɨ. Nabo mobamʉshʉbɨtsya bathɨ: «Alamaga muligolo ko saha sɨrɨnda sa mwɨshɨ.» <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />Ishe ʉwe mwamɨnyerera ko nɨ oko ndambi eyo, ko Yesʉ athamʉbwɨra k'omwana ʉwe alɨho. Aho ɨye n'olʉganda lʉwe loshi mobɨkɨrɨtsya Yesʉ. <verse eid="JHN 4:53" /><verse number="54" style="v" sid="JHN 4:54" />Kɨno kyo kɨmɨnyɨkalo kya kabɨrɨ kyo Yesʉ akolaga, abere alɨathoka iYuteya n'ɨya iNgalilaya.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">Yesʉ alamya mukoni wa makonongola</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />Honyuma kw'aho, Yesʉ mwaya ɨYerʉsalemʉ mu linye ly'aBayuta. <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />Mo muyi w'ɨYerʉsalemʉ oyo, hofɨ n'olukyo lw'omuyi lo lʉnahʉlwamo <char style="it">Lukyo lwa Mbuli</char>, halɨ kisima kyo kɨrɨ na bɨngɨrɨro bɨthano bitsimbirirwe na nduyi. Mo Kɨebʉranɨa, ekisima ekyo ekɨnahʉlwamo Betesaita.<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">Betesaita, nɨ negena mbʉ nyʉmba ya shashi.</char></note> <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />Bakoni bangɨ babyaga nɨbagonzere mo bɨngɨrɨro ebyo. Babyagamo mbumi, bɨrema n'abamakongonola. [Abandʉ abo bagenda abalɨndɨrɨra ametsi athenganibwe. <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />Kʉshangwa malaɨka wa Nyinya-kowethʉ agenda akimira mo kisima ekyo n'ithengania ametsi. N'omukoni mʉmbere-mbere yo wagenda ɨngɨra mo metsi amamala ithenganibwa agenda alama obukoni abyagako.]<note caller="+" style="f"><char style="fr" closed="false">5:4 </char><char style="ft" closed="false">Omʉlondo ono athalɨ mʉ mashako magʉma wa kera.</char></note> <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />Aho, habyaga mʉndʉ mʉgʉma yo wabyaga mukoni ɨthoka kʉ mɨaka makumi ashathʉ na mʉnanɨ. <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />Yesʉ abere ashʉnga ko mukoni oyo anagonzere, mwamɨnyerera ko nɨ mukoni wa bɨro bɨngɨ. Mwamʉbʉtsya athɨ: «Ushondya ʉlame?» <verse eid="JHN 5:6" /><verse number="7" style="v" sid="JHN 5:7" />Omukoni oyo mwamʉshʉbɨtsya athɨ: «Nyinya-kowethʉ, nyithawithe mʉndʉ w'erɨnyɨngɨtsya mo kisima ametsi amamala ithenganibwa. Nangye enyinabya nyashondya ɨngɨra mo metsi, ʉndɨ mʉndʉ nɨanyɨthanga.» <verse eid="JHN 5:7" /><verse number="8" style="v" sid="JHN 5:8" />Yesʉ mwamʉbwɨra athɨ: «Wimana, heka ekipoyi kyawe na ʉgende.» <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />Aho n'aho omʉndʉ oyo mwalama, mwaheka ekipoyi kɨwe na mwathanga ɨbashʉla. Ekɨro ekyo kyabyaga kɨro kya Sabato. <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />Aho, abakʉlʉ b'aBayuta mobabwɨra omʉndʉ yo walamibawa bathɨ: «Munobwire nɨ kɨro kya Sabato, oMʉgomba athakuhamulire ɨheka ekipoyi kyawe.» <verse eid="JHN 5:10" /><verse number="11" style="v" sid="JHN 5:11" />Mwashʉbɨtsyabo athɨ: «Oyo uthanyilamya mwanyɨbwɨra athɨ: “Tsɨmba ekipoyi kyawe ʉgende.<note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="ft" closed="false">Soma Nehemia 13.19, Yeremia 17.21.</char></note>”» <verse eid="JHN 5:11" /><verse number="12" style="v" sid="JHN 5:12" />Aho, mobamʉbʉtsya bathɨ: «Nɨ ndɨ yo ʉthakʉbwɨra mbʉ ʉheke ekipoyi kyawe na ʉgende?» <verse eid="JHN 5:12" /><verse number="13" style="v" sid="JHN 5:13" />Hewethuwe omʉndʉ yo walamibawa mwathamɨnya nga nɨ ndɨ yo uthamulamya, kʉshangwa Yesʉ abyaga nɨamathoka mo muhindano w'abandʉ bo babyaga aho. <verse eid="JHN 5:13" /><verse number="14" style="v" sid="JHN 5:14" />Honyuma kw'aho, Yesʉ mweya omʉndʉ oyo mo Nyʉmba ya Gongo, mwamʉbwɨra athɨ: «Shʉnga, wamalama. Aho ʉthashʉba kola kɨtsɨbʉ nɨmo kɨndɨ kɨndʉ kɨbɨ kʉlenga ekyo kithakuhikiraga!» <verse eid="JHN 5:14" /><verse number="15" style="v" sid="JHN 5:15" />Omʉndʉ oyo mwaya bwɨra aBayuta ko nɨ Yesʉ yo uthamulamya. <verse eid="JHN 5:15" /><verse number="16" style="v" sid="JHN 5:16" />Bʉshana n'ekyo, aBayuta mobathanga ɨbaga Yesʉ, kʉshangwa mwakola ebyo mo kɨro ky'eSabato. <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />Hewethuwe Yesʉ mwashʉbɨtsyabo athɨ: «Thatha anakola ko ndambi soshi, nangye kuthyo enyɨkola.» <verse eid="JHN 5:17" /><verse number="18" style="v" sid="JHN 5:18" />Bʉshana n'ekɨnwa kɨno, abakʉlʉ b'aBayuta mobashʉba shondya imwitha. Ɨthalɨ kʉshangwa mwathashikya eSabato kuroshi, hewethuwe kʉshangwa agendaga ahʉla Gongo mw'Ishe, n'iyilingania na Gongo.<verse eid="JHN 5:18" /></para>
  <para style="s">Amaka wa Mʉgala wa Gongo</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />Aho Yesʉ mwashʉba bwɨra aBayuta athɨ: «Kwenene, kwenene enyɨbabwɨra, Mʉgala wa Gongo athangakola kɨndʉ mo mɨganɨtsye yɨwe yowene. Hewethuwe anakola ebyo analolako Ishe ʉwe alɨ akola. Ebyoshi Thatha anakola, Mʉgala ʉwe naye kuthyo by'anakola. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />Kʉshangwa Thatha atsiire Mʉgala, anakangya Mʉgala y'ebyoshi anakola. Andamukangya bɨndʉ bɨnene ebirengitsye ebi bʉshana mukotsye ɨshweka. <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />Nga ko Thatha analubukya abaholi na ɨfʉlʉkɨtsyabo obʉyɨngo, na Mʉgala naye kuthyo anahana obʉyɨngo ko bʉlɨ mʉndʉ woshi-woshi oyo ashashire ɨhabo. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />Thatha athasoha mʉndʉ, hewethuwe mwaha Mʉgala ʉwe y'amaka woshi w'erɨsoha abandʉ, <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />bʉshana abandʉ boshi bashikye Mʉgala nga ko bashikitsye Ishe. Yo uthashikitsye Mʉgala, niathashikitsye n'Ishe yo wamʉthʉmaga. <verse eid="JHN 5:23" /><verse number="24" style="v" sid="JHN 5:24" />Kwenene, kwenene enyɨbabwɨra nyɨthɨ omʉndʉ yo wonvwa ekɨnwa kyaye n'ɨkɨrɨtsya yo wanyɨthʉmaga, awithe bʉyɨngo bw'ekera n'ekera. Ɨye athɨndasohwe, hewethuwe amathoka mo lʉholo n'ibya na bʉyɨngo. <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />Kwenene, kwenene enyɨbabwɨra, kʉlɨ ndambi eyihika, naro yamalire ihika, abaholi bandabya bonvwa omʉlenge wa Mʉgala wa Gongo, n'abo bandonvwao bandabyaho. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />Kʉshangwa nga ko Thatha awithe maka w'ɨhana bʉyɨngo, ni bathyo kw'ahaga Mʉgala y'amaka w'ɨhana obʉyɨngo. <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />Mwamʉha maka w'ɨsoha, kʉshangwa ɨye nɨ Mʉgala w'oMʉndʉ. <verse eid="JHN 5:27" /><verse number="28" style="v" sid="JHN 5:28" />Mʉthashwekaga bʉshana n'ebɨnwa ebi, kʉshangwa kwandabya ndambi abaholi boshi bo balɨ mo masɨnda bandonvwa omʉlenge ʉwe, <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />na bandathoka mo masɨnda wabo. Abandʉ bo bakolaga bɨbʉya bandalubuka n'ɨbona bʉyɨngo. Hewethuwe bo bakolaga ebɨbɨ bandalubuka n'ɨsohwa. <verse eid="JHN 5:29" /><verse number="30" style="v" sid="JHN 5:30" />Hathalɨ kyo nyangayɨkolera ngyowene. Enyɨnasoha ɨkwamana n'ebyo enyɨnonvwa n'esohi aye nɨ ya kwenene, kʉshangwa nyɨthalɨ enyishondya ɨkola erɨshasha lyaye, hewethuwe erɨshasha ly'oyo wanyɨthʉmaga. <verse eid="JHN 5:30" /><verse number="31" style="v" sid="JHN 5:31" />Nyamayɨlethera butimo ngyowene, obutimo bwaye bʉthangɨkɨrɨtsɨbwa. <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />Hewethuwe halɨ ʉndɨ yo ʉnanyɨlethera butimo, nangye nyetsi kw'obutimo aletha bʉshana nangye ni bwa kwenene. <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" />Imwe momwathumire bagendi kʉ Yoani, ebyo anegenaga kw'ingye nɨ bya kwenene. <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />Ingye nyɨthalɨ enyishondya obutimo bwaye ko bandʉ, hewethuwe enyɨnegena nyithyo nɨmo mwashabʉlwa.»<verse eid="JHN 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 5:35" />Yoani abyaga nga tara yo ɨnoka n'ɨkoletsya abandʉ, nemwe momwamogere ekyakakala kɨwe kʉ ndambi nge. <verse eid="JHN 5:35" /><verse number="36" style="v" sid="JHN 5:36" />Hewethuwe ingye nyiyiwitheko butimo bulengitsye obutimo bwa Yoani. Kʉshangwa emɨkolano Thatha anyɨthʉmaga nyɨkole, bo butimo bo bukangya ko Thatha yo wanyɨthʉmaga. <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />Na Thatha yo wanyɨthʉmaga naye kuthyo ni mutimo aye. Hewethuwe imwe mʉthahera mwathonvwa omʉlenge ʉwe kʉtse ɨlola ko bʉsʉ bʉwe. <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />Ekɨnwa kɨwe kɨthalɨ mo mɨthɨma enyu, kʉshangwa mʉthɨkɨrɨtsye oyo athʉmaga. <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />Omʉnɨga aMashako Abuyirire, kʉshangwa omʉganɨtsya mʉthɨ mwabona mʉwo mw'obʉyɨngo bw'ekera na kera. Nɨ aMashako ayo bo butimo bwaye. <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />H'imwe mwathindire inyihikira bʉshana mʉbone obʉyɨngo bwa kera na kera.<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />Ingye nyɨthalɨ enyishondya lʉkengerwa lo lʉthoka ko bandʉ. <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />Hewethuwe nyibwetsi, muthatsiire Gongo mo mɨthɨma enyu. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />Ingye nyahikaga kw'ɨtsɨna lya Thatha, nemwe mwamathɨnda inyikokya. Hewethuwe ʉndɨ mʉndʉ amahika kw'ɨtsɨna lɨwe yowene oyo nimwamukokya. <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />Kʉthɨ ko mwangakotsya ɨkɨrɨtsya, imwe omʉbona olʉkengerwa lwenyu ɨthoka bagʉma kʉ bandɨ, hewethuwe mʉthalɨ omushondya olʉkengerwa lo lʉthoka ewa Gongo mʉsha.<verse eid="JHN 5:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 5:45" />Mʉthaganɨtsyaga mʉthɨ nyabasitaka kʉ Thatha. Nɨ Mʉsa yo wandabasitaka kʉshangwa n'ɨye yo mwahiragako amagene enyu. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />Mwangɨkɨrɨtsye Mʉsa, nangye kuthyo mwanganyɨkɨrɨtsye, kʉshangwa nɨ ebinyilebitsye byo Mʉsa ashakaga. <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />Hewethuwe mʉlɨ mʉthɨkɨrɨtsye amashako wa Mʉsa, kʉthɨ ko mwangɨkɨrɨtsya ebyo enyɨnegena?<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">Yesʉ alɨsa bandʉ bɨhʉmbɨ bɨthano</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mat 14:13-21</ref>; <ref loc="MRK 6:30-44">Mar 6:30-44</ref>; <ref loc="LUK 9:10-17">Luk 9:10-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />Honyuma kw'aho, Yesʉ mwashabʉka engetsɨ y'iNgalilaya, kandɨ eyɨnahʉlwamo ngetsɨ ya Tiberia<note caller="+" style="f"><char style="fr" closed="false">6:1 </char><char style="ft" closed="false">Erɨndɨ ɨtsɨna ly'engetsɨ y'iNgalilaya, lɨthokene n'omuyi owalɨ hofɨ n'engetsɨ eyo ow'anahʉlwamo Tiberia, owalɨ ko lʉhande lw'obʉlengera ɨtsʉba lw'engetsɨ eyo.</char></note>. <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />Muhindano w'abandʉ bangɨ mobamʉkwama, kʉshangwa abandʉ abo mobashʉnga bɨmɨnyɨkalo ebyo akanganaya mw'ilamya abakoni. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />Aho Yesʉ mwɨrʉkɨra ko kɨthwa hagʉma n'abɨga bʉwe na mobikala eyo. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />N'ekɨro kɨkʉlʉ ky'<char style="w" lemma="Pasaka">ePasaka</char> y'aBayuta kyabyaga nɨ kɨrɨ hofɨ. <verse eid="JHN 6:4" /><verse number="5" style="v" sid="JHN 6:5" />Yesʉ abere ashʉmba amesho, mwashʉnga muhindano mʉnene wa bandʉ niamuhikira. Aho mwabʉtsya Filipo athɨ: «Hayi ho thwangagʉla kalyo k'erɨrɨsa abandʉ aba?» <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />Mwanegena athyo nɨathega Filipo yo kɨnwa kʉshangwa abyaga nietsi ekyo akola. <verse eid="JHN 6:6" /><verse number="7" style="v" sid="JHN 6:7" />Filipo mwamʉshʉbɨtsya athɨ: «Namo thwangagʉla mikati ya bɨtsere magana abɨrɨ bya faranga<note caller="+" style="f"><char style="fr" closed="false">6:7 </char><char style="ft" closed="false">Ebɨtsere by'esofaranga byo byahʉlwa hano, byagenda ebyo byahʉlwamo tinari. Na tinari ngʉma yabyaga lʉhembo lwa mʉlɨmo wa mʉthobero mʉgʉma.</char></note>, ɨthangagonera kʉbo na mothwangahabo kɨtse-kɨtse.» <verse eid="JHN 6:7" /><verse number="8" style="v" sid="JHN 6:8" />Oʉndɨ mwɨga mʉgʉma ye Ndereya, mʉgalabo Simoni Petero mwamʉbwɨra athɨ: <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />«Hano halɨ mʉthabana awithe ku mikati ithano ya shayiri<note caller="+" style="f"><char style="fr" closed="false">6:9 </char><char style="ft" closed="false">Shayiri ni mbʉtho yangalinganibwa na bʉlo.</char></note> na mahere abɨrɨ. Ewono, ebyo byanga yɨra ki ko bandʉ bangana n'aba?» <verse eid="JHN 6:9" /><verse number="10" style="v" sid="JHN 6:10" />Yesʉ mwanegena athɨ: «Mʉbwɨre abandʉ bikale ahishi.» Ahandʉ aho habyaga bɨthɨ bɨngɨ. Aho abandʉ mobikala. Abayira bo babyaga aho, babyaga hofɨ bɨhʉmbɨ bɨthano. <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />Honyuma kw'aho, Yesʉ mwatsɨmba emikati eyo, mwasɨma Gongo, na mwagabɨraro ko bandʉ boshi bo babyaga aho. Na kuthyo mwagaba amahere nga ko bʉlɨ mʉndʉ abyaga alayire. <verse eid="JHN 6:11" /><verse number="12" style="v" sid="JHN 6:12" />Babere bamamala iutha, Yesʉ mwabwɨra abɨga bʉwe athɨ: «Mʉkʉme-kʉme ebɨtse-bɨtse bithashiba, bʉshana kuthabyaga kɨtse n'ekɨgʉma kyo kyahera.» <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />Aho mobashongya-shongya ebɨtse-bɨtse by'emikati ithano y'eshayiri byo byashakaga, na mobutsutsya bɨthonga ikumi na bɨbɨrɨ.<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />Abandʉ babere bashʉnga ekɨmɨnyɨkalo Yesʉ akolaga, mobanegena bathɨ: «Ko kwenene omʉndʉ oyu nɨ omʉmɨnyeretsɨ yo wangahikire mo kɨhʉgo.» <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />Kʉshangwa Yesʉ abyaga nietsi ko bahika ɨmʉthwala mʉ kahatho n'ɨmʉyɨramo mwamɨ, mwathoka aho n'ɨshʉba ko kɨthwa ko yowene.<verse eid="JHN 6:15" /></para>
  <para style="s">Yesʉ agendera elʉgʉlʉ ko metsi</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mat 14:22-33</ref>; <ref loc="MRK 6:45-52">Mar 6:45-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />Bwabere bwahika igolo, abɨga bʉwe mobandagalɨra ko ngetsɨ. <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />Mobashambɨra mo bwatho n'ɨshabʉkɨra ko ʉndɨ mwishirya, ɨKaperenaʉmʉ. Omwitsimya abyaga nɨamamala ibya na Yesʉ niathetsi eyabo. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />N'ametsi w'engetsɨ mwabyamo mibimbi mɨtsɨbʉ, kʉshangwa embeho yabyaga nzɨbʉ. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />Babere bahika hofɨ kʉ bilometere bɨthano kʉtse ndathʉ, mobashʉnga Yesʉ yo hofɨ n'obwatho, nɨagendera ko metsi kw'elʉgʉlʉ. Bʉshana n'ekyo mobʉbaha. <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />Hewethuwe Yesʉ mwabwɨrabo athɨ: «N'ingye, mʉthʉbahaga!» <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />Abɨga babyaga niabashondya ɨmʉshambɨtsya mo bwatho, hewethuwe aho n'aho obwatho mobwitsa obuhika ko kɨthaka eyo bagenda baya.<verse eid="JHN 6:21" /></para>
  <para style="s">Omuhindano ashondya Yesʉ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />Bwabere bwakya, abandʉ bo bashibaga eyishirya w'engetsɨ mobamɨnya ko ko kyambʉ kʉthalɨ bwatho bʉgʉma bʉsha. Na kandɨ mobamɨnya ko Yesʉ mwathalɨ ashambɨra mo bwatho obo hagʉma n'abɨga bʉwe, he abɨga mobagenda ɨbo bene. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />Na kuthyo wandɨ matho mwahika ho abandʉ balɨraga emikati, Nyinya-kowethʉ abere amamala ɨsɨma Gongo. Amatho ayo athokaga mo muyi w'iTiberia. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />Abandʉ babere bashʉnga ko Yesʉ n'abɨga bʉwe bathalɨ aho, mobɨngɨra mo matho n'ɨshabʉkɨra ɨKaperenaʉmʉ ɨya shondya Yesʉ.<verse eid="JHN 6:24" /></para>
  <para style="s">Yesʉ yo mukati w'obʉyɨngo</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />Abandʉ abo mobeya Yesʉ yo eyishirya w'engetsɨ n'ɨmʉbʉtsya bathɨ: «Mʉkangɨrɨtsya uthahika hano mango ki?» <verse eid="JHN 6:25" /><verse number="26" style="v" sid="JHN 6:26" />Yesʉ mwashʉbɨtsyabo athɨ: «Kwenene kwenene, mʉthalɨ omunyishondya bʉshana n'ebɨmɨnyɨkalo mʉthashʉnga nyɨrɨ enyɨkola, hewethuwe nɨ bʉshana n'emikati muthalya n'iugutha. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />Mʉthakoleraga akalyo ko kanabola, hewethuwe mʉkolere akalyo ko kathahwa na ko kanaletha obʉyɨngo bw'ekera n'ekera. N'akalyo ako, nɨ oMʉgala w'oMʉndʉ yo wabahako, kʉshangwa Gongo Thatha mwamʉha maka w'ɨkola athyo.» <verse eid="JHN 6:27" /><verse number="28" style="v" sid="JHN 6:28" />Mobamʉbʉtsya bathɨ: «Thʉyɨre thʉthɨ nɨmo thwakola ebyo Gongo ashondya?» <verse eid="JHN 6:28" /><verse number="29" style="v" sid="JHN 6:29" />Yesʉ mwashʉbɨtsyabo athɨ: «Omʉlɨmo wa Gongo wono: mwɨkɨrɨtsye yo Gongo athʉmaga.» <verse eid="JHN 6:29" /><verse number="30" style="v" sid="JHN 6:30" />Mobabʉtsya Yesʉ bathɨ: «Wathukangya kɨmɨnyɨkalo kɨhe bʉshana thʉshʉnge kʉkyo na thʉkwɨkɨrɨtsye? iki kyo wakola? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />Abo thatha-kʉlʉ mobalya <char style="w" lemma="mana">mana</char> mo mbwarara, nga ko binegenirwe mo <char style="w" lemma="Mashako Abuyirire">Mashako Abuyirire</char> bɨthɨ: “Mwalɨsabo omukati ow'athokaga elʉbʉla.”<note caller="+" style="f"><char style="fr" closed="false">6:31 </char><char style="ft" closed="false">Soma Ɨthoka 16:4-15; Saburi 78:24.</char></note>» <verse eid="JHN 6:31" /><verse number="32" style="v" sid="JHN 6:32" />Yesʉ mwashʉbɨtsyabo athɨ: «Ko kwenene enyɨbabwɨra: Mʉsa mwathabaha mukati ow'athokaga elʉbʉla, hewethuwe nɨ Thatha yo ʉbaha omukati w'ekwenene ow'athoka elʉbʉla. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />Kʉshangwa omukati wo Gongo ahana, nɨ ow'akima ɨthoka mo lʉbʉla n'ɨretha obʉyɨngo ko bandʉ b'omo kɨhʉgo kɨno.» <verse eid="JHN 6:33" /><verse number="34" style="v" sid="JHN 6:34" />Aho mobamʉbwɨra bathɨ: «Nyinya-kowethʉ, ʉgende ʉthʉha omukati oyo w'ebɨro byoshi.» <verse eid="JHN 6:34" /><verse number="35" style="v" sid="JHN 6:35" />Yesʉ mwabwɨrabo athɨ: «Ingye ngyo mukati w'obʉyɨngo. Oyo wamanyihikira athɨndafwe nzala na hake, n'oyo ʉnyɨkɨrɨtsye athɨndafwe nyotha na hake. <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />Hewethuwe nga ko nyababwɨraga, mwamanyɨshʉnga hewethuwe namo bɨnalɨ bithyo, mʉthanyɨkɨrɨtsye. <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />Abandʉ boshi bo Thatha anyɨha bandanyihikako, nangye nyɨthɨndathɨnde n'omʉgʉma w'oko bo banyihikira. <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />Kʉshangwa nyakimaga ɨthoka elʉbʉla bʉshana nyɨkole erishondya ly'oyo wanyɨthʉmaga, bʉtsɨra erishondya lyaye. <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />N'erishondya ly'oyo wanyɨthʉmaga nɨ: nyɨthahetsyaga n'omʉgʉma w'oko bo anyɨhaga, hewethuwe nyimulubukye ekɨro ky'enduli y'ekɨhʉgo. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />Shʉnga, erishondya lya Thatha: aboshi bo bashʉnga Mʉgala n'ɨmwɨkɨrɨtsya babone obʉyɨngo bw'ekera n'ekera, nangye nyandalubukyabo ekɨro ky'enduli.»<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />Aho, aBayuta mobathanga ɨrʉkʉma kʉshangwa Yesʉ mwanegena athɨ: «Ingye nyɨrɨ mukati ow'akimaga ɨthoka mo lʉbʉla.» <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />Nabo mobanegena bathɨ: «Oyu athalɨ Yesʉ mʉgala wa Yosefʉ? Ndɨ thunetsi ishe na nyinya! Ewono athɨ kwanganegena athɨ ɨye akimaga ɨthoka elʉbʉla?» <verse eid="JHN 6:42" /><verse number="43" style="v" sid="JHN 6:43" />Yesʉ mwashʉbɨtsyabo athɨ: «Mʉtharʉkʉmaga mo kathi kenyu. <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />Hathalɨ yo wangahika yo nyɨrɨ, alɨ athalɨ athakʉrwa na Thatha yo wanyɨthʉmaga, nangye nyandamulubukya ekɨro ky'enduli. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />Bishakirwe mo mashako <char style="w" lemma="bamɨnyeretsɨ">w'abamɨnyeretsɨ</char> bɨthɨ: “Aboshi bandakangɨrɨtsɨbwa na Gongo.”<note caller="+" style="f"><char style="fr" closed="false">6:45 </char><char style="ft" closed="false">Soma Isaya 54:13.</char></note> Obʉlɨ mʉndʉ yo ʉhʉlɨkɨrɨtsya Thatha n'ɨkwama amakangɨrɨtsya ʉwe, ahika eyo nyɨrɨ. <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />Hathalɨ mʉndʉ yo washʉngaga Thatha, athalɨ yo wathokaga ewa Gongo. Ɨye, mwashʉnga Thatha. <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />Kwenene, kwenene, enyɨbabwɨra: oyo wɨkɨrɨtsye awithe bʉyɨngo bw'ekera n'ekera. <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />Ingye ngyo mukati w'obʉyɨngo. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />Bo sho-kʉlʉ mobalya mana mo mbwarara, hewethuwe mobafwa. <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />Hewethuwe ono wo mukati akimaga ɨthoka elʉbʉla. Bʉlɨ mʉndʉ yo ulya kʉwo athɨndafwe. <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />Ingye ngyo mukati w'obʉyɨngo ow'akimaga ɨthoka mo lʉbʉla. Omʉndʉ amalya ko mukati ono andabyaho kera na kera. N'omukati wo nyabaha nɨ omʉbɨrɨ aye ow'ahanwa bʉshana ekɨhʉgo kɨbone obʉyɨngo.»<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />Aho aBayuta mobathanga ikubisania ɨbo kw'ɨbo, mobanegena bathɨ: «Omʉndʉ oyu, athɨ kwangathʉha omʉbɨrɨ ʉwe thulyewo?»<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />Bʉshana n'ekyo Yesʉ mwabwɨrabo athɨ: «Kwenene kwenene enyɨbabwɨra, muthalire omʉbɨrɨ w'oMʉgala w'oMʉndʉ n'ɨshoma omʉsasɨ ʉwe, muthindabye na bʉyɨngo mw'imwe. <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />Omʉndʉ yo ulya omʉbɨrɨ aye n'ɨshoma omʉsasɨ aye, alɨ n'obʉyɨngo bw'ekera n'ekera, nangye nyandamulubukya ekɨro ky'enduli. <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />Omʉbɨrɨ aye nɨ kalyo ka kwenene n'omʉsasɨ aye nɨ w'erɨshoma lya kwenene. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />Omʉndʉ yo ulya omʉbɨrɨ aye n'ɨshoma omʉsasɨ aye, ikere emwishi saye, nangye nyikere emwishi sɨwe. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />Nga ko Thatha yo wanyɨthʉmaga alɨho, nangye nyɨrɨho ko kagala kʉwe, na kuthyo oyo unyirya andabyaho ko kagala kaye. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />Mʉshʉnge ko mukati ow'akimaga ɨthoka elʉbʉla kw'alɨ, athalɨ ng'emikati yo bosho-kʉlʉ balyaga mo mbwarara na mobafwa. Oyo ulya omukati ono andabyaho kera n'ekera.» <verse eid="JHN 6:58" /><verse number="59" style="v" sid="JHN 6:59" />Yesʉ anegenaga ebɨnwa ebyo abere alɨ akangɨrɨtsya mo sinakoki ɨKaperenaʉmʉ.<verse eid="JHN 6:59" /></para>
  <para style="s">Bɨga bagʉma abamika Yesʉ</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />Bangɨ mo bɨga bʉwe babere bonvwa ebɨnwa ebyo mobanegena bathɨ: «Ebɨnwa bɨno bitsibuhire. Nɨ ndɨ yo wangɨmɨrabyo?» <verse eid="JHN 6:60" /><verse number="61" style="v" sid="JHN 6:61" />Yesʉ mwamɨnya ko abɨga bʉwe abarʉkʉma bʉshana n'ekɨnwa eki, aho mwabʉtsyabo athɨ: «Ekɨnwa kɨno kyamabagatsya emɨthɨma? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />Ewo, byandabya bɨthɨ mwamashʉnga oMʉgala w' <char style="w" lemma="Mʉgala w'oMʉndʉ">oMʉndʉ</char> alɨ ɨrʉkɨra aho abyaga embere? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />oMʉthɨma Mwerʉ yo ʉnaletha obʉyɨngo, omʉbɨrɨ athawithe ndundi. Ebɨnwa nyababwɨraga, nɨ ɨbyo byo <char style="w" lemma="Mʉthɨma Mwerʉ">Mʉthɨma Mwerʉ</char> na kandɨ nɨ byo bɨnaletha obʉyɨngo. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />Hewethuwe halɨ bagʉma mw'imwe bathɨkɨrɨtsye.» Yesʉ anegenaga athyo kʉshangwa abyaga nietsi ɨthoka kera abo bathɨkɨrɨtsye n'oyo wamʉhothera. <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />Yesʉ mwashʉba negena athɨ: «Bʉshana n'eki enyɨbabwɨra nyɨthɨ, hathalɨ mʉndʉ yo wangahika yo nyɨrɨ, Thatha athamʉhere obuthoki.»<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />Na bʉshana n'ebɨnwa ebyo, bangɨ mo bɨga bʉwe mobamumika, nabo mobathashʉba enda hagʉma naye. <verse eid="JHN 6:66" /><verse number="67" style="v" sid="JHN 6:67" />Aho Yesʉ mwabʉtsya abɨga ikumi n'ababɨrɨ athɨ: «Nemwe kuthyo omushondya ɨgenda?» <verse eid="JHN 6:67" /><verse number="68" style="v" sid="JHN 6:68" />Simoni Petero mwamʉshʉbɨtsya athɨ: «Nyinya-kowethʉ, thwaya ewa ndɨ? N'ɨwe wo uwithe ko bɨnwa by'obʉyɨngo bw'ekera na kera. <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />Na lɨno thwamɨkɨrɨtsya n'ɨmɨnya ko ʉlɨ <char style="w" lemma="Mubuyirire">Mubuyirire</char> yo wathʉmawa na Gongo<note caller="+" style="f"><char style="fr" closed="false">6:69 </char><char style="ft" closed="false">Lingania na Mat 16:16; Mar 8:29; Luk 9:20.</char></note>!» <verse eid="JHN 6:69" /><verse number="70" style="v" sid="JHN 6:70" />Yesʉ mwashʉbɨtsyabo athɨ: «Nɨ ingye ngyowene ngyo nyabashombolaga imwe ikumi na babɨrɨ, hewethuwe namo bɨnalɨ bithyo mʉgʉma wa mw'imwe ni Sitani!» <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />Anegenaga athyo bʉshana na Yuta mʉgala wa Simoni Isikariote. Kʉshangwa abyaga mʉgʉma w'oko bɨga ikumi na babɨrɨ, na n'ɨye yo wamʉhothera.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">Banyikyabo Yesʉ bathamwɨkɨrɨtsye</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />Honyuma kw'aho, Yesʉ agenda athimba mo kɨhʉgo ky'iNgalilaya. Athagenda ahika mo kɨhʉgo ky'iYuteya, kʉshangwa aBakʉlʉ b'aBayuta bagenda abashondya imwitha. <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />Ekɨro kɨkʉlʉ ky'elinye ly'eso<char style="w" lemma="Hema">Hema</char> ky'aBayuta kyabyaga hofɨ.<note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="ft" closed="false">Soma Balawi 23:34-36; Ɨbʉka Mʉgomba 16:13.</char></note> <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />Bagala babo Yesʉ mobamʉbwɨra bathɨ: «Thoka kʉno, ʉye iYuteya nɨmo abɨga bawe nabo balola ko mɨkolano yo ʉkola. <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />Omʉndʉ yo ushondya ɨmɨnyɨkala athakola kɨndʉ mʉ bubisho. Kʉshangwa oʉkola mɨkolano yɨrɨ ng'eyo, uyikangye ko bandʉ boshi bʉshana bakʉmɨnye!» <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />Bagala babo nabo mobathamwɨkɨrɨtsya. <verse eid="JHN 7:5" /><verse number="6" style="v" sid="JHN 7:6" />Aho, Yesʉ mwabwɨrabo athɨ: «Endambi aye ithetsi yahika, hewethuwe kw'imwe obʉlɨ ndambi ɨtholere. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />Abandʉ ba hano ishi bathangababaga, hewethuwe banyibayire kʉshangwa enyɨnanegena nyɨthɨ emɨkolano yabo nɨ mɨbɨ. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />Mʉgende ko linye. Ingye nyɨthɨyeyo kʉshangwa endambi aye ithetsi yahika.» <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />Abere amamala ɨnegena athyo, mwikala iNgalilaya. <verse eid="JHN 7:9" /><verse number="10" style="v" sid="JHN 7:10" />Hewethuwe bagala babo babere baya ko linye, Yesʉ naye mwayayo, buthayikangya ko bandʉ.<verse eid="JHN 7:10" /></para>
  <para style="s">Amakangɨrɨtsya w'ekɨro ky'elinye ly'esoHema</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 7:11" />Mo kɨro ky'elinye, abakʉlʉ b'aBayuta bagenda abashondya Yesʉ nɨababʉtsya bathɨ: «Alɨ hayi?» <verse eid="JHN 7:11" /><verse number="12" style="v" sid="JHN 7:12" />Mo kathi k'abandʉ abo mwabyaga bo bagenda abarʉkʉma bʉshana na Yesʉ. Bagʉma bagenda abanegena bathɨ: «Nɨ mʉndʉ akwirire.» N'abandɨ bagenda abanegena bathɨ: «Kiro, athɨma abandʉ.» <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />Hewethuwe hathalɨ mʉndʉ yo wamʉnegenagako kɨnwa ahalɨ bandʉ kʉshangwa aboshi bagenda abʉbaha abakʉlʉ b'aBayuta.<verse eid="JHN 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />Elinye lyabere lyahika mo kathi, Yesʉ mwɨngɨra mo <char style="w" lemma="Nyʉmba ya Gongo">Nyʉmba ya Gongo</char> na mwathanga ɨkangɨrɨtsya. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />Abakʉlʉ b'aBayuta mobashwekera amakangɨrɨtsya ʉwe nɨabanegena bathɨ: «Athokya obwenge boshi obu bo hayi omʉndʉ yo ʉthahera wathɨngɨra mʉ masomo?» <verse eid="JHN 7:15" /><verse number="16" style="v" sid="JHN 7:16" />Yesʉ mwashʉbɨtsyabo athɨ: «Amakangɨrɨtsya awo enyɨkangɨrɨtsya athalɨ ʉwaye, hewethuwe nɨ w'oyo wanyɨthʉmaga. <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />Mʉndʉ amashondya ɨkola erɨshasha lya Gongo, amɨ́nya kw'amakangɨrɨtsya aya ng'athoka ewa Gongo kʉtse ng'enyɨnegena kʉ maka aye ingy'owene. <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />Omʉndʉ yo ʉnegena ko maka ʉwe yowene, oyo niashondya iyisingya yowene. Hewethuwe yo ushondya isingya yo wamʉthʉmaga, oyo nɨanegena ekwenene na athalɨmo bʉbɨ boshi-boshi. <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />Mʉsa mwathabaha oMʉgomba? Namo bɨnalɨ bithyo, hathalɨ n'omʉgʉma wa mw'imwe yo ushikitsyewo. Aho, omushondya inyithira ki?» <verse eid="JHN 7:19" /><verse number="20" style="v" sid="JHN 7:20" />Omuhindano mwamʉshʉbɨtsya athɨ: «Ʉlɨko mʉtsɨmʉ mʉbɨ! Ɨndɨ yo ushondya ikwitha?» <verse eid="JHN 7:20" /><verse number="21" style="v" sid="JHN 7:21" />Yesʉ mwashʉbɨtsyabo athɨ: «Monyɨkola kɨnwa kɨgʉma kuroshi, nakyo kyamabashwekya imwe boshi. <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />Mʉsa mwabahamʉla imonia abana benyu b'obʉtsana. Ko kwenene, ebyo bɨthathokaga ewa Mʉsa hewethuwe ewa bo sho-kʉlʉ benyu. Na lɨno, imwe omunamonia abana benyu namo kɨro ky'eSabato. <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />Na mwamabya niomunamonia abana benyu mo kɨro ky'eSabato bʉshana mushikye oMʉgomba wa Mʉsa, bʉshana na ki omʉnyɨtsɨbʉkɨra kʉshangwa nyamalamya mʉndʉ ekɨro ky'eSabato? <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />Mulike ɨsoha abandʉ ɨkwamana na ko bashoshire, hewethuwe mʉsohebo ɨkwamana n'ekwenene.»<verse eid="JHN 7:24" /></para>
  <para style="s">Yesʉ yo Kirisito</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />Bahimbani bagʉma b'ɨYerʉsalemʉ bagenda abanegena bathɨ: «Omʉndʉ oyu athalɨ yo bashondya itha? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />Hene! Athɨ kw'anegenera mo bandʉ nabo bathanegenire kɨndʉ? Kʉthɨ abakʉlʉ bethʉ bamalire ɨmɨnya ko kwenene kw'ɨye nɨ Kirisito! <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />Hewethuwe omʉndʉ oyu thwetsi eyo athoka, Masia ɨye andabya ahika, hathalɨ yo wandamɨnya aho andahʉlʉka.» <verse eid="JHN 7:27" /><verse number="28" style="v" sid="JHN 7:28" />Aho Yesʉ abere anemʉkangɨrɨtsya mo Nyʉmba ya Gongo, mwahambala nɨanegena athɨ: «Imwe omʉnegena mʉthɨ munyetsi, mwetsi na yo nyɨthoka. Nyithahikaga mʉ maka aye ngyowene. Hewethuwe yo wanyɨthʉmaga nɨ wa kwenene, nemwe muthamwetsi. <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />Hewethuwe ingye nyimwetsi kʉshangwa nyathokaga ewe, na n'ɨye yo wanyɨthʉmaga.»<verse eid="JHN 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30" />Mobashondya ɨmʉmɨna hewethuwe mohathabya mʉndʉ yo wamuhiragako eminwe kʉshangwa endambi yɨwe yabyaga niyithetsi yahika. <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />Bandʉ bangɨ mo muhindano bo babyaga aho mobamwɨkɨrɨtsya, na bagenda abanegena bathɨ: «Kirisito andabya ahika andakola bɨmɨnyɨkalo bilengitsye ebyo oyu akola?»<verse eid="JHN 7:31" /></para>
  <para style="s">aBakʉlʉ b'abaheri abathʉmwa bandʉ bayamɨne Yesʉ</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />
    <char style="w" lemma="Bafarisayo">aBafarisayo</char> mobonvwa ebɨnwa abandʉ bagenda abanegena kʉ Yesʉ. Aho, abakʉlʉ b'abaheri n'aBafarisayo mobathʉma abatheya b'eNyʉmba ya Gongo bayamɨne Yesʉ. <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />Yesʉ mwanegena athɨ: «Nyɨkɨnalɨ nemwe ku ndambi nge, na honyuma kw'aho nyashʉba ewa yo wanyɨthʉmaga. <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />Mwanyishondya hewethuwe mʉthɨnyɨbone, kʉshangwa muthangakotsya ɨya eyo nyandabya.» <verse eid="JHN 7:34" /><verse number="35" style="v" sid="JHN 7:35" />Abakʉlʉ b'aBayuta mobathanga ibutsania ɨbo kw'ɨbo bathɨ: «Aya hayi nɨmo thʉthɨshʉbe mʉshʉngeko? Aya eyɨrɨ aBayuta bo babungire mo Bakiriki, n'ɨkangɨrɨtsya aBakiriki? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />Ebɨnwa athanegena athɨ: “Mwanyishondya na mʉthɨnyɨbone, n'eyo enyɨya muthangahikayo, binegenire bithi ki?”»<verse eid="JHN 7:36" /></para>
  <para style="s">Nyitsi sa metsi wa bʉyɨngo</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />Ekɨro kɨtsɨndʉ ky'elinye ly'esoHema, kyo kyabyaga kɨro kɨkʉlʉ, Yesʉ mwimana embere s'omuhindano n'ɨhambala kʉtsɨbʉ athɨ: «Kwamabya kʉlɨ mʉndʉ yo ufwire nyotha, anyihikire na ashome. <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />Nga ko aMashako anegenire athɨ: “Nyitsi sa metsi wa bʉyɨngo sathoka mo mʉthɨma w'oyo ʉnyɨkɨrɨtsye.”» <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />Yesʉ anegenaga athyo, bʉshana n'oMʉthɨma Mwerʉ bandabona abo bandamwɨkɨrɨtsya. Mo bɨro ebyo oMʉthɨma Mwerʉ abyaga niathetsi athʉmwa, kʉshangwa Yesʉ abyaga niathetsi ɨngɨra mo lʉkengerwa lʉwe.<verse eid="JHN 7:39" /></para>
  <para style="s">Omuhindano agabana bʉshana na Yesʉ</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />Mo bandʉ bahʉlɨkɨrɨtsyaga ebɨnwa bya Yesʉ, bagʉma bagenda abanegena bathɨ: «Ko kwenene, oyu nɨ omʉmɨnyeretsɨ yo wangahikire!» <verse eid="JHN 7:40" /><verse number="41" style="v" sid="JHN 7:41" />N'abandɨ bagenda abanegena bathɨ: «Oyu nɨ Kirisito.» N'abandɨ kandɨ bathɨ: «Kirisito anganathoka iNgalilaya? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />aMashako athanegenire athɨ Kirisito andabya wa mo lʉganda lwa Tawiti na andathoka ɨBetelehemʉ, muyi wa mabʉthwa wa Tawiti?» <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />Aho abandʉ mobagabana bʉshana na Yesʉ. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />Bagʉma ba mʉbo mobashondya ɨmʉmɨna, hewethuwe mohathabya mʉndʉ yo wamuhiragako eminwe.<verse eid="JHN 7:44" /></para>
  <para style="s">Obʉthɨkɨrɨtsya bw'abakʉlʉ b'aBayuta</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />Abatheya abo mobashʉba eyɨrɨ abakʉlʉ b'abaheri n'aBafarisayo. Mobabʉtsya abatheya bathɨ: «Muthamulethire bʉshana na ki?» <verse eid="JHN 7:45" /><verse number="46" style="v" sid="JHN 7:46" />Abatheya mobashubya bathɨ: «Tʉthahera thwathonvwa mʉndʉ yo ʉnegena ng'oyo.» <verse eid="JHN 7:46" /><verse number="47" style="v" sid="JHN 7:47" />aBafarisayo mobabʉtsyabo bathɨ: «Nemwe kuthyo mwamalire ɨthɨmwa? <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />Nɨ ndɨ mo bakʉlʉ b'aBayuta kʉtse mo Bafarisayo yo wamwɨkɨrɨtsye? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />Kiro nako, hewethuwe abandʉ aba bathetsi oMʉgomba wa Mʉsa, bathakirwe na Gongo!» <verse eid="JHN 7:49" /><verse number="50" style="v" sid="JHN 7:50" />Nikotemo, yo wayaga shʉnga Yesʉ embere, abyaga mʉgʉma w'oko Bafarisayo bo babyaga aho, mwanegena athɨ: <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />«oMʉgomba ethʉ anganasoha mʉndʉ yo ʉthathangire athonda n'ɨmɨnya ekyo athakola?»<note caller="+" style="f"><char style="fr" closed="false">7:51 </char><char style="ft" closed="false">Lingania Ɨbʉka Mʉgomba 1:16.</char></note> <verse eid="JHN 7:51" /><verse number="52" style="v" sid="JHN 7:52" />Mobamʉshʉbɨtsya bathɨ: «Nawe kuthyo ʉlɨ Munyangalilaya? Sonzomola aMashako Abuyirire na walola kw'iNgalilaya ɨthathoka mʉmɨnyeretsɨ.»<verse eid="JHN 7:52" /></para>
  <para style="s">Yesʉ n'omʉkatsɨ mʉshɨngɨtsɨ</para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 7:53" />[Bʉlɨ mʉndʉ mwaya ewe.<note caller="+" style="f"><char style="fr" closed="false">7:53 </char><char style="ft" closed="false">Amashako ano athalɨ mʉ wandɨ Mashako wa kera.</char></note><verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s">Mʉkatsɨ mʉshɨngɨtsɨ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />Honyuma kw'aho Yesʉ mwɨrʉkɨra ko kɨthwa ky'eMiseituni. <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />Mo mambya, mwashʉba mo Nyʉmba ya Gongo. Abandʉ mobayɨfʉnda hofɨ naye. Mwikala na mwathanga ɨkangɨrɨtsyabo. <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />Aho, <char style="w" lemma="abakangɨrɨtsya b'oMʉgomba">abakangɨrɨtsya b'oMʉgomba</char> n'<char style="w" lemma="Bafarisayo">aBafarisayo</char> mobaletha mʉkatsɨ yo batheya nɨasɨngɨra n'imwimania mo kathi k'abandʉ. <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />Mobabwɨra Yesʉ bathɨ: «Mʉkangɨrɨtsya, mothweya omʉkatsɨ oyu nɨasɨngɨra. <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />Mʉsa mwathʉhamʉla mo Mʉgomba itha mu mabwe abakatsɨ balɨ ng'aba.<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">Soma Balawi 20:10; Ɨbʉka Mʉgomba 22:22-24. </char></note> Ewono, nawe uthi ki?» <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />Banegenaga bathyo mw'ɨmʉthega kɨnwa bʉshana babone eky'erimusitakira. Hewethuwe Yesʉ mwunama na mwashaka ahishi mo munwe ʉwe. <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />Nabo babere bamʉbʉlɨrɨtsya kʉtsɨbʉ, Yesʉ mwashʉmba amesho n'ɨbwɨrabo athɨ: «Yo ʉthahera wathakola kɨtsɨbʉ mo kathi kenyu abye mʉmbere w'erɨmʉgʉshako eribwe.» <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />Mwashʉba iunama n'ɨshaka ko kɨthaka. <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />Babere bonvwa ebɨnwa ebyo, aboshi mobathoka aho mʉgʉma mʉgʉma ɨthanga ko bakʉlʉ. Yesʉ mwashiba aho ho yowene hagʉma n'omʉkatsɨ yo wabyaga n'imene mo kathi-kathi k'abandʉ. <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />Yesʉ mwinamuka n'ɨbʉtsya omʉkatsɨ oyo athɨ: «Mʉkatsɨ, abo bathakusitaka balɨ hayi? Hathalɨ mʉndʉ yo wamakʉsoha?» <verse eid="JHN 8:10" /><verse number="11" style="v" sid="JHN 8:11" />Omʉkatsɨ mwashubya athɨ: «Kiro na mʉndʉ mbe Nyinya-kowethʉ». Aho Yesʉ mwamʉbwɨra athɨ: «Nangye kuthyo nyithakusohire. Yɨgendere hewethuwe uthanalinda washʉba kola kɨtsɨbʉ.»]<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="ft" closed="false">Ebɨnwa bɨno bɨthalɨ mʉ wandɨ mashako wa kera.</char></note><verse eid="JHN 8:11" /></para>
  <para style="s">Yesʉ nɨ kyakakala ky'omo kɨhʉgo</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />Yesʉ mwashʉba bwɨrabo athɨ: «Nyɨrɨ kyakakala ky'omo kɨhʉgo. Yo unyikwamire athɨndagende mu mwitsimya na hake, hewethuwe andabya na kyakakala kya bʉyɨngo bwa kera na kera.»<verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />Aho, <char style="w" lemma="Bafarisayo">aBafarisayo</char> mobamʉbwɨra mobamʉbwɨra bathɨ: «Obutimo bwawe bʉthalɨ bwa kwenene, kʉshangwa ʉyɨhala wowene!» <verse eid="JHN 8:13" /><verse number="14" style="v" sid="JHN 8:14" />Yesʉ mwashʉbɨtsyabo athɨ: «Nɨ kwenene nyɨrɨ mutimo wa ngyowene, hewethuwe obutimo bwaye nɨ bwa kwenene, kʉshangwa nyetsi yo nyɨthoka n'eyo nyɨya. H'imwe muthetsi eyo nyathokaga kʉtse eyo nyɨya. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />Imwe omʉnasoha ɨkwamana n'emɨganɨtsye y'abandʉ. Ingye nyɨthasoha mʉndʉ. <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />Hewethuwe, na monyangasohire mʉndʉ, esohi aye yangabere ya kwenene, kʉshangwa nyɨthalɨ ngyowene. Thatha yo wanyɨthʉmaga alɨ hagʉma nangye. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />Mo Mʉgomba enyu mushakirwe mʉthɨ obutimo bwa bandʉ babɨrɨ obo nɨ bwa kwenene.<note caller="+" style="f"><char style="fr" closed="false">8:17 </char><char style="ft" closed="false">Soma Ɨbʉka Mʉgomba 17:6; 19:15; Mɨganzo 35:30.</char></note> <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />Ingye nyɨrɨ mutimo wa ngyowene, na Thatha yo wanyɨthʉmaga, naye nɨ mutimo aye.» <verse eid="JHN 8:18" /><verse number="19" style="v" sid="JHN 8:19" />Aho, aBafarisayo mobamʉbʉtsya bathɨ: «Ye Sho alɨ hayi?» Yesʉ mwashubya athɨ: «Muthanyetsi na muthetsi Thatha. Mwanganyiminyire, mwangaminyire na Thatha.»<verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />Yesʉ anegenaga ebɨnwa ebi mo ndambi agenda akangɨrɨtsya mo Nyʉmba ya Gongo hofɨ n'embɨko y'ebɨhembo. Hathalɨ mʉndʉ wamʉmɨnaga, kʉshangwa endambi yɨwe yabyaga niyithetsi yahika.<verse eid="JHN 8:20" /></para>
  <para style="s">Mʉthangaya eyo nyɨya</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />Yesʉ mwashʉba bwɨrabo athɨ: «Enyɨyɨgendera, nemwe mwanyishondya hewethuwe mwafwɨra mo bɨtsɨbʉ byenyu. Eyo nyɨya muthangahikayo.» <verse eid="JHN 8:21" /><verse number="22" style="v" sid="JHN 8:22" />Abakʉlʉ b'aBayuta mobabutsania bathɨ: «Ashondya ɨya yitha kyo kɨreka nɨanegena athɨ: “Eyo nyɨya muthangahikayo?”» <verse eid="JHN 8:22" /><verse number="23" style="v" sid="JHN 8:23" />Yesʉ mwashʉbɨtsyabo athɨ: «Mʉlɨ ba hano ishi, ingye nyɨrɨ w'elʉgʉlʉ. Mʉlɨ ba mʉno kɨhʉgo, ingye nyɨthalɨ wa mʉno kɨhʉgo. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />Kyo kɨthaleka nɨnyababwɨra nyɨthɨ mwafwɨra mo bɨtsɨbʉ byenyu, mʉthɨkɨrɨtsye kw'Ingye ngyo Nyɨrɨ<note caller="+" style="f"><char style="fr" closed="false">8:24 </char><char style="ft" closed="false">Ingye ngyo Nyɨrɨ: nɨ lɨgʉma ly'oko matsɨna wa Gongo. Soma Ɨthoka 3:14.</char></note>, ko kwenene nɨmwafwɨra mo bɨtsɨbʉ byenyu.» <verse eid="JHN 8:24" /><verse number="25" style="v" sid="JHN 8:25" />Aho mobabʉtsya Yesʉ bathɨ: «Ɨwe ʉlɨ ndɨ?» Yesʉ mwashʉbɨtsyabo athɨ: «Nyɨrɨ yo nyababwɨraga ɨthoka ko ndangɨro. <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />Nyiwithe bɨnwa bɨngɨ by'ɨbabwɨra n'ɨbasoha. Hewethuwe yo wanyɨthʉmaga nɨ wa kwenene nangye enyɨbwɨra abandʉ b'omo kɨhʉgo ebyo nyonvwaga alɨ anegena.» <verse eid="JHN 8:26" /><verse number="27" style="v" sid="JHN 8:27" />Mobathamɨnya ko n'Ishe yo Yesʉ agenda asɨmolerabo. <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />Aho, Yesʉ mwashʉbɨtsyabo athɨ: «Mwandabya mwahira oMʉgala w'oMʉndʉ y'elʉgʉlʉ, mwandamɨnya kw'Ingye ngyo Nyɨrɨ, na kalengyo kw'aho mwandamɨnya ko nyɨthalɨ enyɨkola kɨndʉ kw'ishondya lyaye ngyowene. Hewethuwe enyɨnanegena ebyo Thatha anyɨkangɨrɨtsyaga kuroshi. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />Oyo wanyɨthʉmaga alɨ nangye. Mwathanyimika ingy'owene kʉshangwa ebɨro byoshi enyɨnakola ebyo binamumoya.» <verse eid="JHN 8:29" /><verse number="30" style="v" sid="JHN 8:30" />Yesʉ abere anemʉnegena ebɨnwa ebi, bandʉ bangɨ mobamwɨkɨrɨtsya.<verse eid="JHN 8:30" /></para>
  <para style="s">Engʉmo ya Abʉrahamʉ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />Aho, Yesʉ mwabwɨra aBayuta bo bamwɨkɨrɨtsyaga athɨ: «Mwamashikya amakangɨrɨtsya aye, mʉlɨ kwenene bɨga baye, <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />mwandamɨnya ekwenene, n'ekwenene yandabaha bwiranda.» <verse eid="JHN 8:32" /><verse number="33" style="v" sid="JHN 8:33" />Mobamʉshʉbɨtsya bathɨ: «Thʉlɨ ngʉmo ya Abʉrahamʉ, thʉthahera thwathabya bakobe ba mʉndʉ n'ekɨro n'ekɨgʉma. Kʉthɨ ko wangathʉbwɨra ʉthɨ thwabona bwiranda?» <verse eid="JHN 8:33" /><verse number="34" style="v" sid="JHN 8:34" />Yesʉ mwashʉbɨtsyabo athɨ: «Kwenene, kwenene enyɨbabwɨra, omʉndʉ yo ʉkola ebɨtsɨbʉ nɨ mʉkobe w'ebɨtsɨbʉ. <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />Omʉkobe athabya mo lʉganda mw'ebɨro byoshi. Hewethuwe omwana ɨye, alɨ mo lʉganda mw'ebɨro byoshi. <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />Omwana amabaha obwiranda, aho nɨ mwabona obwiranda bw'ekwenene. <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />Nyetsi ko mʉlɨ kwenene ngʉmo ya Abʉrahamʉ. Hewethuwe, kʉshangwa mʉthalɨ omwɨkɨrɨtsya amakangɨrɨtsya aye, omushondya ɨnyɨthɨsa. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />Ingye enyɨnegena ebyo nyashʉngaga ewa Thatha. H'imwe omʉkola ebyo mwonvwaga ɨthoka ewa thatha wenyu!» <verse eid="JHN 8:38" /><verse number="39" style="v" sid="JHN 8:39" />Mobamʉshʉbɨtsya bathɨ: «Thatha nɨ Abʉrahamʉ.» Yesʉ mwabwɨrabo athɨ: «Mwangabere bana ba Abʉrahamʉ, mwangakolire emɨkolano ya Abʉrahamʉ. <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />Hewethuwe omushondya ɨnyɨthɨsa, ingye mʉndʉ enyɨbabwɨra ekwenene eyo nyonvwaga ɨthoka ewa Gongo. Abʉrahamʉ athahera athakola bɨrɨ ng'ebi. <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />H'imwe omʉkola emɨkolano yo thatha wenyu anakola.» Mobamʉshʉbɨtsya bathɨ: «Thʉthabʉthawa mʉ rʉsɨngɨ! Thuwithe thatha mʉgʉma, nɨ Gongo!» <verse eid="JHN 8:41" /><verse number="42" style="v" sid="JHN 8:42" />Yesʉ mwabwɨrabo athɨ: «Gongo angabere Thatha wenyu, mwanganyitsiire, kʉshangwa nɨ ewa Gongo yo nyathokaga, na lɨno nyɨrɨ hano. Nyithahikaga mʉ maka aye ngyowene, hewethuwe n'ɨye yo wanyɨthʉmaga. <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />Bʉshana na ki mʉthalɨ omʉmɨnya ebyo enyɨnegena? Nɨ bʉshana muthangakotsya ɨhʉlɨkɨrɨtsya ebɨnwa byaye. <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />Imwe mʉlɨ bana ba thatha wenyu Sitani. Nemwe omushondya ɨkola ebyo thatha wenyu atsiire. Ɨye nɨ mwithi wa bandʉ ɨthanga kera. Athalɨ mo kwenene kʉshangwa ekwenene ɨthalɨ mw'ɨye. Anabya alɨ anegena mabesɨ, anathokyawo mo mɨbere yɨwe, kʉshangwa nɨ mʉbesɨ n'ishe w'ababesɨ. <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />Ingye, mʉthalɨ omʉnyɨkɨrɨtsya kʉshangwa enyɨnanegena ekwenene. <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />Ɨndɨ mo kathi kenyu yo wangakangya ekɨtsɨbʉ nyakolaga? Nyamabya nɨenyɨnegena ekwenene, bʉshana na ki mʉthalɨ omʉnyɨkɨrɨtsya? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />Omʉndʉ wa Gongo anahʉlɨkɨrɨtsya ebɨnwa bya Gongo. Imwe mʉthalɨ omwonvwa kʉshangwa mʉthalɨ bandʉ ba Gongo.»<verse eid="JHN 8:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />aBayuta mobamʉshʉbɨtsya bathɨ: «Thʉthathasɨngene thʉthabere thwanegena thʉthɨ ʉlɨ Mʉsamarɨa na ʉlɨko mʉtsɨmʉ mʉbɨ?» <verse eid="JHN 8:48" /><verse number="49" style="v" sid="JHN 8:49" />Yesʉ mwashʉbɨtsyabo athɨ: «Ɨhɨ, nyɨthalɨko mʉtsɨmʉ mʉbɨ, hewethuwe nyishikitsye Thatha, imwe muthanyishikitsye! <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />Nyɨthalɨ enyishondya iyisingya, hewethuwe halɨ mʉndʉ yo ushondya erisingibwa bʉshana nangye, naye yo uwithe maka w'erɨsoha. <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />Kwenene, kwenene, enyɨbabwɨra, omʉndʉ yo wamashikya ekɨnwa kyaye athɨndafwe ihika kera na kera.»<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />Aho aBayuta abo mobamʉbwɨra bathɨ: «Aho thwamamɨnya ko ʉlɨko mɨtsɨmʉ mɨbɨ! Abʉrahamʉ mwafwa, n'abamɨnyeretsɨ nabo mobafwa, nawe oʉnegena ʉthɨ: “Omʉndʉ amashikya ekɨnwa kyaye nɨathɨndafwe ihika kera na kera.” <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />Ʉlɨ mʉkʉlʉ kʉlenga thatha wethʉ Abʉrahamʉ? Ɨye mwafwa n'abamɨnyeretsɨ nabo kuthyo mobafwa. Ɨwe ʉyɨshʉngamo ndɨ?» <verse eid="JHN 8:53" /><verse number="54" style="v" sid="JHN 8:54" />Yesʉ mwashʉbɨtsyabo athɨ: «Nyangashonditsye iyisingya ngyowene, eriyisingya lyaye lyangabere lya bʉsha. Oyo omʉnayɨhalɨra mʉthɨ nɨ Gongo wenyu, oyo yo Thatha yo unyisingya. <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />Imwe muthamwetsi, h'ingye nyimwetsi. Nyanganegenire nyɨthɨ nyithamwetsi, nyangabere mʉbesɨ ng'imwe. Hewethuwe nyimwetsi na nyishikitsye ekɨnwa kɨwe. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />Abʉrahamʉ thatha wenyu mwasɨma bʉshana n'amaha w'erɨshʉnga ekɨro nyandahika. Na abere ashʉngakyo, mwamoga kʉtsɨbʉ.» <verse eid="JHN 8:56" /><verse number="57" style="v" sid="JHN 8:57" />Aho, aBayuta mobamʉbwɨra bathɨ: «Ɨwe uthetsi wayɨra mɨaka makumi athano, ʉthɨ mowashʉnga Abʉrahamʉ!» <verse eid="JHN 8:57" /><verse number="58" style="v" sid="JHN 8:58" />Yesʉ mwashʉbɨtsyabo athɨ: «Kwenene, kwenene, enyɨbabwɨra, embere Abʉrahamʉ abʉthwe, ingye nyabyagaho.» <verse eid="JHN 8:58" /><verse number="59" style="v" sid="JHN 8:59" />Bʉshana n'ebɨnwa ebyo, mobatsɨmba mabwe bʉshana bagʉshangewo kʉ Yesʉ, hewethuwe mwayibisha na mwathoka mo Nyʉmba ya Gongo.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">Yesʉ alamya mbumi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />Yesʉ abere anemʉtsʉka mo nzɨra, mwashʉnga mʉndʉ mʉgʉma yo wabyaga mbumi ɨthanga kw'ɨbʉthwa lɨwe. <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />Abɨga bʉwe mobamʉbʉtsya bathɨ: «Mʉkangɨrɨtsya, bʉshana na ki omʉndʉ oyu mwabʉthwamo mbumi? Nɨ bʉshana n'ebɨtsɨbʉ bɨwe kʉtse ebɨtsɨbʉ by'ababuthi bʉwe?» <verse eid="JHN 9:2" /><verse number="3" style="v" sid="JHN 9:3" />Yesʉ mwashubya athɨ: «Omʉndʉ oyu athabʉthawa mbumi bʉshana n'ebɨtsɨbʉ bɨwe kʉtse n'ebɨtsɨbʉ by'ababuthi bʉwe. Hewethuwe abʉthawa athya bʉshana emɨkolano ya Gongo ɨmɨnyɨkale ɨtsʉkɨra ɨye. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />Ko bʉkɨnatsene, lɨtholere nɨthwakola emɨrɨmo ya yo wanyɨthʉmaga. Kʉshangwa bwamakʉra, ko ndambi eyo omʉndʉ athangakotsya ɨshʉba kola. <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />Mo ndambi nyɨkɨnalɨ hano ishi, nyɨrɨ kyakakala kya hano ishi.»<verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />Yesʉ abere amamala ɨnegena athyo, mwatsɨra mathandɨ w'ahishi, mwatsʉmba bɨtholo mo mathandɨ ayo, na mwahaka ebɨtholo ebyo ko mesho w'embumi eyo. <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />Yesʉ mwabwɨra embumi athɨ: «Genda ʉyanabe mo mesho ko kisima ky'iSiloamu<note caller="+" style="f"><char style="fr" closed="false">9:7 </char><char style="ft" closed="false">Ekisima ky'iSiloamu kyabyaga mwishi w'oluhimbo lw'omuyi w'ɨYerʉsalemʉ. Soma 2 Bamɨ 20:20, Isaya 8:6 n'ebishakirwe.</char></note>.» Siloamu n'ɨnegena mbʉ: yo wathʉmawa. Aho embumi eyo moyaya naba mo mesho na moyashʉbʉla n'ɨyɨhera eyɨlola.<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />Abahimbani b'embumi eyo n'abo babyaga babegere ɨmʉshʉngako alɨahemeretsya, bagenda abanegena bathɨ: «Omʉndʉ oyu athalɨ yo wagenda ikala ahishi n'ɨshabɨrɨtsya?» <verse eid="JHN 9:8" /><verse number="9" style="v" sid="JHN 9:9" />Bagʉma bagenda abanegena bathɨ: «N'ɨye!» Na bandɨ bathɨ: «Ɨhɨ, nɨ ʉndɨ amushoshire.» Hewethuwe omʉndʉ oyo mwanegena athɨ: «N'ingye.» <verse eid="JHN 9:9" /><verse number="10" style="v" sid="JHN 9:10" />Aho, mobamʉbʉtsya bathɨ: «Amesho awe athatsɨbʉkala athɨ?» <verse eid="JHN 9:10" /><verse number="11" style="v" sid="JHN 9:11" />Mwashubya athɨ: «Omʉndʉ yo unahʉlwamo Yesʉ mwakomya bɨtholo, mwanyɨhakabyo ko mesho na mwanyɨbwɨra athɨ: “Genda ʉyanabe ho Siloamu.” Monyɨyayo, monyɨnaba mo mesho na lɨno enyɨlola.» <verse eid="JHN 9:11" /><verse number="12" style="v" sid="JHN 9:12" />Mobashʉba mʉbʉtsya bathɨ: «Omʉndʉ oyo alɨ hayi?» Mwashubya athɨ: «Nyithetsi.»<verse eid="JHN 9:12" /></para>
  <para style="s">Abafarisayo ababʉlɨrɨtsya embumi</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />Mobathwala oyo wabyaga mbumi eyɨrɨ <char style="w" lemma="Bafarisayo">aBafarisayo</char>. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />Ekɨro Yesʉ atsʉmbaga ebɨtholo n'ilamya embumi, kyabyaga kɨro kya Sabato. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />Aho, aBafarisayo nabo mobamʉbʉtsya ng'amesho ʉwe athatsɨbʉkala athɨ. Mwashʉbɨtsyabo athɨ: «Mwanyɨhaka bɨtholo ko mesho, nangye monyɨyanaba na lɨno enyɨlola.» <verse eid="JHN 9:15" /><verse number="16" style="v" sid="JHN 9:16" />Bagʉma mo <char style="w" lemma="Bafarisayo">Bafarisayo</char> mobanegena bathɨ: «Omʉndʉ oyu athathokaga ewa Gongo, kʉshangwa athashikitsye eSabato.» Hewethuwe abandɨ mobanegena bathɨ: «Omukoli w'ebɨtsɨbʉ anganakola bɨthɨko-thɨko bɨrɨ ng'ebi?» Aho, mobagabana. <verse eid="JHN 9:16" /><verse number="17" style="v" sid="JHN 9:17" />aBafarisayo mobashʉba bʉtsya embumi yo yɨthalama bathɨ: «Nawe, oyo ʉthakʉtsɨbʉlako amesho, ʉmʉnegenako ʉthɨ ki?» Naye mwashubya athɨ: «Nɨ mʉmɨnyeretsɨ.»<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />Hewethuwe abakʉlʉ b'aBayuta mobathɨkɨrɨtsya kw'athalɨ mbumi ko na lɨno ahera alola, ihika ko kɨka mobabɨrɨkɨra ababuthi bʉwe, <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />n'ɨbʉtsyabo bathɨ: «Omʉndʉ oyu yo n'omwana enyu yo mwahʉla mʉthɨ abʉthawa mbumi? Aho, athɨ kw'amalola?» <verse eid="JHN 9:19" /><verse number="20" style="v" sid="JHN 9:20" />Ababuthi bʉwe mobashʉbɨtsyabo bathɨ: «Kweneneko oyu nɨ mwana ethʉ na abʉthawa ni mbumi. <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />Hewethuwe thuthetsi ekyo kyamaleka nɨalola. Na thuthetsi oyo watsɨbʉlaga amesho ʉwe. Ɨye nɨ mʉndʉ mʉkʉlʉ, mʉmʉbʉtsye naye ababwɨra ebyo bithamuhikira!» <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />Ababuthi bʉwe banegenaga bathyo kʉshangwa babyaga n'ibubahire abakʉlʉ b'aBayuta. Abakʉlʉ b'aBayuta abo babyaga nibamalire ɨhʉlɨkɨrɨrana iriitha mo sinakoki obʉlɨ mʉndʉ woshi woshi yo wɨkɨrɨtsye ko Yesʉ nɨ Kirisito. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />Ekyo kyo kyalekaga ababuthi bʉwe nɨbanegena bathɨ: «Ahera mʉndʉ mʉkʉlʉ mʉmʉbʉtsye.»<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />aBafarisayo mobabɨrɨkɨra yo wabyaga mbumi yo lya kabɨrɨ n'ɨmʉbwɨra bathɨ: «Negena ekwenene embere sa Gongo. Ithwe thwetsi kw'omʉndʉ oyu ni mukoli w'ebɨtsɨbʉ.» <verse eid="JHN 9:24" /><verse number="25" style="v" sid="JHN 9:25" />Naye mwashʉbɨtsyabo athɨ: «Nyithetsi nga ni mukoli wa bɨtsɨbʉ kʉtse ɨhɨ. Hewethuwe nyetsi kɨndʉ kɨgʉma kuroshi: nyɨthalɨ mbumi, he lɨno enyɨlola.» <verse eid="JHN 9:25" /><verse number="26" style="v" sid="JHN 9:26" />Mobashʉba mʉbʉtsya bathɨ: «Mwakʉkolera ki? Athɨ ko athakʉtsɨbʉla amesho?» <verse eid="JHN 9:26" /><verse number="27" style="v" sid="JHN 9:27" />Mwashʉbɨtsyabo athɨ: «Nyamalire ɨbabwɨrabyo hewethuwe momʉthalɨ omʉnyonvwa! Bʉshana na ki omushondya nyɨshʉbe mʉbyo? Nemwe omushondya ibya bɨga bʉwe?» <verse eid="JHN 9:27" /><verse number="28" style="v" sid="JHN 9:28" />Mobamuhangya n'ɨmʉbwɨra bathɨ: «Nɨ ɨwe wo mwɨga ʉwe! Ithwe thʉlɨ bɨga ba Mʉsa. <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />Thwetsi ko Gongo mwasɨmola na Mʉsa. Hewethuwe omʉndʉ oyu thuthetsi eyo athoka!» <verse eid="JHN 9:29" /><verse number="30" style="v" sid="JHN 9:30" />Omʉndʉ oyo mwashʉbɨtsyabo athɨ: «Ko kwenene ekɨnwa eki nɨ ky'erishwekya. Omʉnegena mʉthɨ muthetsi eyo athoka, naho nɨ ɨye yo wamanyɨtsɨbʉlako amesho! <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />Thwetsi ko Gongo athonvwa abakoli b'ebɨtsɨbʉ. Hewethuwe Gongo anahʉlɨkɨrɨtsya obʉlɨ mʉndʉ yo umushikitsye n'ɨkola erishondya lɨwe. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />Ɨthanga kera thʉthahera thwathonvwa mʉndʉ n'omʉgʉma yo watsɨbʉlaga mesho wa mʉndʉ yo wabʉthawa ni mbumi. <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />Omʉndʉ oyu athangakolire kɨndʉ alɨ athathokaga ewa Gongo.» <verse eid="JHN 9:33" /><verse number="34" style="v" sid="JHN 9:34" />Mobamʉshʉbɨtsya bathɨ: «Ɨwe ʉlɨ mukoli w'ebɨtsɨbʉ ɨthoka kw'ɨbʉthwa lyawe. Ushondya ɨthʉkangɨrɨtsya!» Na mobamʉgʉsha embʉga.<verse eid="JHN 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />Yesʉ mwonvwa ko mobathɨbɨtha ko mʉndʉ yo wabyaga mbumi. Aho, mwaya mushondya n'ɨmʉbʉtsya athɨ: «Wɨkɨrɨtsye oMʉgala w'oMʉndʉ?» <verse eid="JHN 9:35" /><verse number="36" style="v" sid="JHN 9:36" />Naye mwashubya athɨ: «Nyinya-kowethʉ, nyɨbwɨre nga nɨ ndɨ bʉshana nyɨmwɨkɨrɨtsye.» <verse eid="JHN 9:36" /><verse number="37" style="v" sid="JHN 9:37" />Yesʉ mwamʉbwɨra athɨ: «Wamamʉshʉnga, nɨ yo ʉnegena nawe.» <verse eid="JHN 9:37" /><verse number="38" style="v" sid="JHN 9:38" />Aho, omʉndʉ oyo mwanegena athɨ: «Nyinya-kowethʉ, nyɨkɨrɨtsye.» Na mwafʉkama embere sa Yesʉ mw'imuramya.<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />Honyuma kw'aho Yesʉ mwanegena athɨ: «Nyahikaga mo kɨhʉgo bʉshana esohi ibye. Nɨ ɨnegena mbʉ: esombumi sɨlole, na bo balola babye mbumi.» <verse eid="JHN 9:39" /><verse number="40" style="v" sid="JHN 9:40" />Bafarisayo bagʉma bo babyaga hofɨ na Yesʉ mobonvwa ebɨnwa ebyo agenda anegena, mobamʉbʉtsya bathɨ: «Nɨ ɨnegena mbʉ nethwe thʉlɨ mbumi?» <verse eid="JHN 9:40" /><verse number="41" style="v" sid="JHN 9:41" />Yesʉ mwashʉbɨtsyabo athɨ: «Mwangabere mbumi mʉthangabere bakoli ba bɨtsɨbʉ. Hewethuwe kʉshangwa omʉnegena mʉthɨ omʉlola, aho mʉlɨ bakoli ba bɨtsɨbʉ.»<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">Mushinga w'omulishya w'esombuli</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />Honyuma kw'aho, Yesʉ mwanegena athɨ: «Kwenene, kwenene enyɨbabwɨra omʉndʉ yo uthatsukire mo lukyo lw'olʉgʉthʉ lw'esombuli<note caller="+" style="f"><char style="fr" closed="false">10:1 </char><char style="fq" closed="false">olʉgʉthʉ lw'esombuli: </char><char style="ft" closed="false">Mo kɨro, esombuli sagenda esihirwa mʉ lʉgʉthʉ/rʉba lwa mabwe. Lwagenda oluhirwako mutheya.</char></note>, hewethuwe nɨashamba n'ɨkɨrʉkɨra mo lʉgʉthʉ ko lʉndɨ lʉnda, oyo nɨ mwɨtsɨ na mushamuli. <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />Hewethuwe omʉndʉ yo wɨngɨrɨra mo lukyo nɨ omulishya w'esombuli. <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />Omutheya w'olʉgʉthʉ anamʉkɨngʉlɨra oluyi n'esombuli esɨnonvwa omʉlenge ʉwe. Naye anabɨrɨkɨra esombuli sɨwe obʉlɨ ngʉma mw'ɨtsɨna lyaro n'ɨthwalatho embʉga. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />Anabya amamala ihulukya esombuli sɨwe, nɨashondoleratho natho nɨsamʉkwama enyuma kʉshangwa sietsi omʉlenge ʉwe. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />Esombuli etho sɨthangakwama mugeni, hewethuwe nɨsamʉshaga, kʉshangwa sithetsi omʉlenge ʉwe.»<verse eid="JHN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6" />Yesʉ mwabwɨrabo omushinga ono, hewethuwe mobathamɨnya ebɨnwa anegenaga.<verse eid="JHN 10:6" /></para>
  <para style="s">Yesʉ ni mulishya mʉbʉya</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />Aho Yesʉ mwashʉbabwɨrabo athɨ: «Enyɨbabwɨra ekwenene, ingye nyɨrɨ luyi lw'olʉgʉthʉ lw'esombuli. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />Aboshi bahikaga embere kw'ingye nɨ bɨtsɨ na bashamuli,<note caller="+" style="f"><char style="fr" closed="false">10:8 </char><char style="ft" closed="false">soma Yeremia 23:1-2; Tsekeli 34:2-3.</char></note> na bʉshana n'ekyo esombuli mosɨthonvwabo. <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />Ingye nyɨrɨ luyi lw'olʉgʉthʉ. Omʉndʉ amɨngɨra mʉlo kw'ɨnyɨtsʉkɨrako, andashabʉlwa, naye andabona kalyo<note caller="+" style="f"><char style="fr" closed="false">10:9 </char><char style="ft" closed="false">Kalyo: Kʉtse kɨkʉyʉ.</char></note>. <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />Omwɨtsɨ ɨye anahika bʉshana n'ɨya iba, itha n'ibihya kuroshi. H'ingye nyamahika bʉshana abandʉ babone bʉyɨngo, obʉyɨngo bw'ekwenene kundu. <verse eid="JHN 10:10" /><verse number="11" style="v" sid="JHN 10:11" />Ingye ngyo mulishya mʉbʉya.<note caller="+" style="f"><char style="fr" closed="false">10:11 </char><char style="ft" closed="false">Soma Saburi 23:1, Isaya 40:11; Tsekeli 34:15; 37:24.</char></note> N'omulishya mʉbʉya anahana obʉyɨngo bʉwe bʉshana n'esombuli sɨwe. <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />Hewethuwe omukoli yo ʉnahembwa, ɨye athalɨ mulishya kandɨ n'esombuli sɨthalɨ sɨwe. Bʉshana n'ekyo anabya ashʉnga olʉnyambwe lwahika, anamika esombuli n'ɨshaga. Aho olʉnyambwe nɨlwatsɨmba esombuli n'ɨpanzatho. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />Ndɨ ɨye athatsomene esombuli kʉshangwa akolera lʉhembo lʉsha. <verse eid="JHN 10:13" /><verse number="14" style="v" sid="JHN 10:14" />Ingye nyɨrɨ mulishya mʉbʉya. Nyetsi esombuli saye n'esombuli saye natho sinyetsi, <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />nga ko Thatha anyetsi, nangye kuthyo ko nyimwetsi.<note caller="+" style="f"><char style="fr" closed="false">10:15 </char><char style="ft" closed="false">Soma Mat 11:27.</char></note> Enyɨhana obʉyɨngo bwaye bʉshana n'esombuli saye. <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />Nyiwithe kʉ sɨndɨ mbuli so sɨthalɨ s'omo kihyo kɨno. Nyɨtholere kuthyo nɨnyalethatho, natho sandonvwa omʉlenge aye, n'esoshi sandabya kihyo kɨgʉma na mulishya mʉgʉma.»<verse eid="JHN 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17" />Thatha anyitsiire kʉshangwa enyɨhana obʉyɨngo bwaye bʉshana honyuma kw'aho nyɨshʉbabonebo buhya-buhya. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />Hathalɨ mʉndʉ yo wanganyɨshamʉla obʉyɨngo bwaye, hewethuwe enyɨhanabo kw'ɨshasha lyaye ingy'owone. Nyiwithe amaka w'erɨhana obʉyɨngo bwaye n'amaka w'erɨshʉba bonabo. Ni bathyo ko Thatha anyɨhamʉlaga.<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />Bʉshana n'ebɨnwa ebyo, mokwabya ɨgabana mo kathɨ k'aBayuta. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />Bangɨ mo kathi kabo mobanegena bathɨ: «Alɨko mʉtsɨmʉ! Nɨ mʉsɨre! Bʉshana na ki omʉmʉhʉlɨkɨrɨtsya?» <verse eid="JHN 10:20" /><verse number="21" style="v" sid="JHN 10:21" />Hewethuwe abandɨ mobanegena bathɨ: «Omʉndʉ yo ʉlɨko mɨtsɨmʉ mɨbɨ athanganegena athya. Emɨtsɨmʉ mɨbɨ yanganakotsya ilamya amesho w'esombumi?»<verse eid="JHN 10:21" /></para>
  <para style="s">aBayuta abathɨnda Yesʉ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />Ebɨro bagenda abakolamo elinye ly'erɨbʉka erɨkɨngʉlwa ly'eNyʉmba ya Gongo<note caller="+" style="f"><char style="fr" closed="false">10:22 </char><char style="fq" closed="false">elinye ly'erɨbʉka erɨkɨngʉlwa ly'eNyʉmba ya Gongo </char><char style="ft" closed="false">Elinye eryo lyagenda erɨkolwa ɨYerʉsalemʉ hofɨ n'enduli y'omwetsɨ w'erikumi n'ibiri bʉshana n'ibukya erishubibwa ly'elinye buhya-buhya ly'obʉtara bw'erɨhererako mo Nyʉmba ya Gongo. Lyagenda erɨkolwa na kɨkembe ky'aBayuta, Yuta na Makabeyo mo mwaka 165 kʉtse mʉ mwaka wa 164 embere s'erɨbʉthwa lya Yesʉ Kirisito.</char></note> ɨYerʉsalemʉ mobyahika. N'ebɨro ebyo byabyaga bya mbeho nzɨbʉ. <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />Yesʉ agenda athimba-thimba mo Nyʉmba ya Gongo, mo mbarasa yo yagenda eyahʉlwamo «mbarasa ya Solomona.» <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />aBayuta mobamuthimbako n'ɨmʉbwɨra bathɨ: «Wandathulungya-lungya ihika kɨro ki? Wamabya n'ɨwe Kirisito, thʉbwɨre kʉbʉya-kʉbʉya.» <verse eid="JHN 10:24" /><verse number="25" style="v" sid="JHN 10:25" />Yesʉ mwashʉbɨtsyabo athɨ: «Nyamalire ɨbabwɨrabyo, hewethuwe mʉthɨkɨrɨtsye. Ebyo enyɨkola mw'ɨtsɨna lya Thatha ebikangania kʉbʉya-kʉbʉya nga nyɨrɨ ndɨ.» <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />Hewethuwe mʉthɨkɨrɨtsye kʉshangwa imwe mʉthalɨ mbuli saye. <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />Esombuli saye esɨnonvwa omʉlenge aye. Nangye nyetsitho, natho esɨnanyɨkwama. <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />Ingye enyɨhatho obʉyɨngo bw'ekera n'ekera, natho sɨthɨndahere na hake, na hathalɨ mʉndʉ yo wangathokyatho mo minwe aye. <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />Thatha yo wanyɨhaga esombuli esi nɨ mʉkʉlʉ kʉlenga aboshi,<note caller="+" style="f"><char style="fr" closed="false">10:29 </char><char style="ft" closed="false">Ekyo Thatha anyɨhaga nɨ kɨnene kʉlenga aboshi. Awandɨ mashako anegenire athɨ: Thatha yo wanyɨhagatho nɨ mʉkʉlʉ kʉlenga aboshi.</char></note> na hathalɨ mʉndʉ yo wanganyagʉlatho mo minwe ya Thatha. <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />Ingye na Thatha thʉlɨ mʉndʉ mʉgʉma.<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />Aho kandɨ aBayuta mobathola mabwe bʉshana bagʉshangewo kʉ Yesʉ. <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />Aho Yesʉ mwabwɨrabo athɨ: «Nyamalire ibakangya mɨkolano mɨngɨ mɨbʉya ko maka wa Thatha. Ewono, nɨ mʉkolano ohɨ mo kathi k'eyoshi ow'aleka nimwashondya ɨnyɨgʉshangako mabwe?» <verse eid="JHN 10:32" /><verse number="33" style="v" sid="JHN 10:33" />aBayuta mobamʉshʉbɨtsya bathɨ: «Thʉthalɨ othushondya ikwitha mu mabwe bʉshana na mʉkolano mʉbʉya wakolaga, hewethuwe nɨ bʉshana n'erɨhatsya kʉ Gongo. Ɨwe ʉlɨ mʉndʉ mʉsha, hewethuwe oʉyɨyɨramo Gongo.» <verse eid="JHN 10:33" /><verse number="34" style="v" sid="JHN 10:34" />Yesʉ mwashʉbɨtsyabo athɨ: «Ndɨ bishakirwe mo mʉgomba enyu ko Gongo mwanegena athɨ: “Monyɨnegena, mʉlɨ bo gongo!”<note caller="+" style="f"><char style="fr" closed="false">10:34 </char><char style="ft" closed="false">Soma Saburi 82:6.</char></note> <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />Gongo mwahʉla abandʉ bo bangɨrɨraga eKɨnwa kɨwe mo bo gongo. Na thwetsi ko Amashako Abuyirire athangathokibwako. <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />Thatha mwanyɨshombola na mwanyɨthʉma mo kɨhʉgo. Ewono, mʉthɨ ko mwanganegena mʉthɨ enyɨhatsya kʉ Gongo kʉshangwa monyɨnegena nyɨthɨ nyɨrɨ Mʉgala wa Gongo? <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />Nyamabya nɨnyɨthalɨ enyɨkola emɨkolano ya Thatha, mʉthanyɨkɨrɨtsaya. <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />Hewethuwe nyamabya nɨenyɨkolabyo, na momʉthananyɨkɨtsye, ewo mwɨkɨrɨtsye emɨkolano aye, bʉshana mʉmɨnye ko kwenene ko Thatha alɨ mw'ingye, nangye, nyɨrɨ mw'ɨye.» <verse eid="JHN 10:38" /><verse number="39" style="v" sid="JHN 10:39" />Aho mobashondya ɨmʉtsɨmba kandɨ, hewethuwe mwaromboka kʉbo. <verse eid="JHN 10:39" /><verse number="40" style="v" sid="JHN 10:40" />Aho Yesʉ mwashʉbaya ko ʉndɨ mʉnda w'eYorotani, aho Yoani agenda abatisirya abandʉ kera, na mwabya eyo. <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />Bandʉ bangɨ mobamuhikira n'ɨnegena bathɨ: «Yoani mwathakola kɨmɨnyɨkalo n'ekɨgʉma, hewethuwe ebɨnwa byoshi anegenaga ko mʉndʉ oyu byabyaga bya kwenene.» <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />N'eyo bandʉ bangɨ mobɨkɨrɨtsya Yesʉ.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">Yesʉ alubukya Lasaro</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />Kwabyaga muyira mʉgʉma mukoni. Erɨtsɨna lɨwe nɨ yo Lasaro. Lasaro oyo abyaga mbʉthɨrwa w'ɨBetanɨa na abyaga mʉgalabo Marɨa na Marata. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />Marɨa ono, nɨ yo wahakaga Nyinya-kowethʉ Yesʉ y'amarasi ko bɨshando n'ɨshangʉlabyo mo nzwɨrɨ sɨwe. Nɨ Lasaro mʉgalabo yo wabyaga alwere. <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />Balɨ babo Lasaro babɨrɨ abo, mobathʉmɨra Yesʉ yo mugendi ayamʉbwɨre athɨ: «Nyinya-kowethʉ, yo utsiire alwere.»<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />Yesʉ abere onvwa omwatsɨ oyo, mwanegena athɨ: «Obukoni obo buthimwithe, hewethuwe nɨ bw'ikangania olʉkengerwa lwa Gongo na bʉshana Mʉgala wa Gongo asingibwe.» <verse eid="JHN 11:4" /><verse number="5" style="v" sid="JHN 11:5" />Yesʉ abyaga atsiire Marata na Marɨa na Lasaro mʉgala wabo. <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />Hewethuwe, na mwanamɨnyaga ko Lasaro alwere, mwashʉba mala oko abyaga ko bɨro bɨbɨrɨ. <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />Honyuma kw'aho mwabwɨra abɨga bʉwe athɨ: «Thʉshʉbe iYuteya.» <verse eid="JHN 11:7" /><verse number="8" style="v" sid="JHN 11:8" />Abɨga mobamʉbwɨra bathɨ: «Mʉkangɨrɨtsya, kuthetsi kwatsʉka bɨro bɨngɨ ɨthoka ko kɨro abakʉlʉ b'aBayuta bashondyaga ikwitha mu mabwe na lɨno ushondya ɨshʉba yayo?» <verse eid="JHN 11:8" /><verse number="9" style="v" sid="JHN 11:9" />Yesʉ mwashʉbɨtsyabo athɨ: «Mo mʉthobero mʉthalɨ saha ikumi n'ibiri? Mʉndʉ amagenda mo mwɨshɨ athatsɨkala kʉshangwa alola mo kyakakala kya mo kɨhʉgo kɨno. <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />Hewethuwe omʉndʉ amagenda mo kɨro anatsɨkala kʉshangwa ekyakakala nɨkɨthalɨ mw'ɨye.» <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />Yesʉ abere amamala ɨnegena ebɨnwa ebyo, mwashʉba bwɨrabo athɨ: «Mwira ethʉ Lasaro alɨtho, hewethuwe enyishondya ɨya mubukya.» <verse eid="JHN 11:11" /><verse number="12" style="v" sid="JHN 11:12" />Abɨga mobamʉbwɨra bathɨ: «Nyinya-kowethʉ, amabya alɨtho, nɨalama.» <verse eid="JHN 11:12" /><verse number="13" style="v" sid="JHN 11:13" />Ko kwenene, Yesʉ agenda asɨmola ko lʉholo lwa Lasaro mo ndambi abɨga ɨbo bagenda abaganɨtsya bathɨ asɨmola bʉshana n'ɨya thʉlo. <verse eid="JHN 11:13" /><verse number="14" style="v" sid="JHN 11:14" />Aho, Yesʉ mwakumbulirabo athɨ: «Lasaro afwire, <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />nangye nyimogire bʉshana nemwe, kʉshangwa nyɨthathalɨho, bʉshana mʉnyɨkɨrɨtsye. Hewethuwe thʉye eyo alɨ.» <verse eid="JHN 11:15" /><verse number="16" style="v" sid="JHN 11:16" />Aho, Tomasɨ yo ʉnahʉlwamo Mʉhasha mwabwɨra abandɨ bɨga athɨ: «Thʉyeyo nethwe bʉshana thʉfwɨre hagʉma naye.»<verse eid="JHN 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />Yesʉ abere ahika, mweya Lasaro nɨamamala bɨro bɨne mw'ɨsɨnda. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />ɨBetanɨa n'ɨYerʉsalemʉ halɨ lʉgendo lwa bilometere bɨshathʉ. <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />Bayuta bangɨ mobayawa kʉ Marata na Marɨa bʉshana n'olʉholo lwa mʉgala wabo. <verse eid="JHN 11:19" /><verse number="20" style="v" sid="JHN 11:20" />Marata abere onvwa ko Yesʉ ahika, mwaya mʉlɨndɨrɨra, hewethuwe Marɨa ɨye mwabya nianikere mo nyʉmba. <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />Marata mwabwɨra Yesʉ athɨ: «Nyinya-kowethu, wangabere hano mʉgala ethʉ athangafwire. <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />Hewethuwe, nyetsi ko na lɨno, ebyoshi washaba Gongo, Gongo akʉhabyo.» <verse eid="JHN 11:22" /><verse number="23" style="v" sid="JHN 11:23" />Yesʉ mwamʉbwɨra athɨ: «Mʉgala enyu alubuka.» <verse eid="JHN 11:23" /><verse number="24" style="v" sid="JHN 11:24" />Marata mwamʉshʉbɨtsya athɨ: «Nyetsi ko andalubuka mo kɨro ky'enduli abandʉ bandabya balubuka.» <verse eid="JHN 11:24" /><verse number="25" style="v" sid="JHN 11:25" />Yesʉ mwamʉbwɨra athɨ: «Ingye nyɨrɨ erilubuka na bʉyɨngo. Yo ʉnyɨkɨrɨtsye, na mwangafwa andabyaho. <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />Na bʉlɨ mʉndʉ yo ʉlɨho na amabya anyɨkɨrɨtsye, oyo athɨndafwe ihika kera na kera. Ʉnɨkɨrɨtsye ebɨnwa ebi?» <verse eid="JHN 11:26" /><verse number="27" style="v" sid="JHN 11:27" />Marata mwashʉbɨtsya Yesʉ athɨ: «Ega mbe Nyinya-kowethʉ, nyɨkɨrɨtsye ko ʉlɨ Kirisito Mʉgala wa Gongo yo wangahikire mo kɨhʉgo.»<verse eid="JHN 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />Marata abere amamala ɨnegena ebɨnwa ebyo, mwayabɨrɨkɨra Marɨa mwalɨ wabo n'ɨmʉbʉherera athɨ: «Nyinya-kowethʉ amahika, akʉbɨrɨkɨra.» <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />Marɨa abere onvwa ebɨnwa ebyo, mwabathʉka na mwaya eyɨrɨ Yesʉ. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />Yesʉ abyaga niathetsi ɨngɨra mo muyi, hewethuwe abyaga nɨakɨnalɨ aho Marata athamweya. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />aBayuta babyaga mo nyʉmba hagʉma na Marɨa bʉshana n'imulirikya, mobashweka abere abathʉka tsʉba n'ɨhʉlʉka. Mobamʉkwama kʉshangwa mobaganɨtsya bathɨ aya kw'ɨsɨnda, ɨya lɨrɨrako.<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />Marɨa abere ahika ho Yesʉ abyaga n'ɨmʉshʉngako, mwawa ko bɨshando bɨwe n'ɨmʉbwɨra athɨ: «Nyinya-kowethʉ, wangabere hano mʉgala ethʉ athangafwire.» <verse eid="JHN 11:32" /><verse number="33" style="v" sid="JHN 11:33" />Yesʉ abere ashʉnga Marɨa alɨ alɨra, ɨye hagʉma n'aBayuta bo babyaga bamʉherekeretsye, mwafwa bulige bʉnene n'ɨthabagana. <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />Mwabʉtsya athɨ: «Momwamʉthere hayi?» Mobashubya bathɨ: «Nyinya-kowethʉ, hika ʉlole.» <verse eid="JHN 11:34" /><verse number="35" style="v" sid="JHN 11:35" />Yesʉ mwalɨra. <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />Aho, Bayuta bagʉma mobanegena bathɨ: «Mʉlole ko abyaga amutsiire!» <verse eid="JHN 11:36" /><verse number="37" style="v" sid="JHN 11:37" />Hewethuwe bagʉma ba mʉbo bagenda abanegena bathɨ: «Yo walamaya embumi, athangahangire olʉholo lwa Lasaro?»<verse eid="JHN 11:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />Aho, Yesʉ mwashʉba imana na bulige bʉnene na mwaya kw'ɨsɨnda. Erɨsɨnda eryo, kyabyaga kyuna kyathimawa mʉ lʉkʉka na lyabyaga likingirwe n'ibwe inene. <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />Aho, Yesʉ mwanegena athɨ: «Muthokye eribwe eri.» Marata, mwalɨ wabo omuholi mwabwɨra Yesʉ athɨ: «Nyinya-kowethʉ, ahera abeha kʉshangwa bɨno nɨ bɨro bɨne alɨ omw'ɨsɨnda.» <verse eid="JHN 11:39" /><verse number="40" style="v" sid="JHN 11:40" />Hewethuwe Yesʉ mwamʉshʉbɨtsya athɨ: «Monyɨthalɨ enyɨkʉbwɨra nyɨthɨ, wamɨkɨrɨtsya n'ɨwalola ko lʉkengerwa lwa Gongo?» <verse eid="JHN 11:40" /><verse number="41" style="v" sid="JHN 11:41" />Aho, mobakʉmbagatsya eribwe eryo. Yesʉ mwashʉmba amesho w'elʉgʉlʉ n'ɨnegena athɨ: «Thatha, enyɨkʉsɨma kʉshangwa wamanyonvwa. <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />Ko kwenene, nyetsi ko oʉnanyonvwa ebɨro byoshi, hewethuwe enyɨnegena nyithya bʉshana n'omuhindano w'abandʉ banyithimbireko aba, bʉshana bɨkɨrɨtsye ko nɨ ɨwe wo wanyɨthʉmaga.» <verse eid="JHN 11:42" /><verse number="43" style="v" sid="JHN 11:43" />Abere amamala ɨnegena ebɨnwa ebi, mwahambala mʉ mʉlenge mʉnene athɨ: «Lasaro, thoka omo!» <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />Aho, yo wabyaga afwire mwahʉlʉka, ebɨshando n'eminwe yɨwe nibiminire mʉ bɨtambara, n'obʉsʉ nɨ bushwikire mʉ lʉkɨmba. Yesʉ mwabwɨrabo athɨ: «Mʉmʉmɨnʉle na mumulike agende!»<verse eid="JHN 11:44" /></para>
  <para style="s">Enama y'eritha Yesʉ</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mat 26:1-5</ref>; <ref loc="MRK 14:1-2">Mar 14:1-2</ref>; <ref loc="LUK 22:1-2">Luk 22:1-2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />Bayuta bangɨ mo kathi ka bo balungulaga Marɨa na bo balolaga kw'ebyo Yesʉ akolaga, mobamwɨkɨrɨtsya. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />Hewethuwe bagʉma ba mʉbo mobaya eyɨrɨ aBafarisayo na mobabwɨrabo ebyo Yesʉ athakola. <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />Aho, abakʉlʉ b'abaheri n'aBafarisayo mobahindania oBʉshenge Bʉkʉlʉ n'ɨnegena bathɨ: «Thʉyɨre thʉthɨ? Kʉshangwa omʉndʉ oyu akola bɨmɨnyɨkalo bɨngɨ! <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />Thwamamulika ahɨrɨke mo by'akola, abandʉ boshi nɨbamwɨkɨrɨtsya. Aho, aBaroma banditsa ihimbula eNyʉmba ya Gongo n'ekɨhʉgo kyethʉ.» <verse eid="JHN 11:48" /><verse number="49" style="v" sid="JHN 11:49" />Hewethuwe, Kayafa mʉgʉma wa kʉbo, yo wabyaga Muheri Mʉkʉlʉ ko mwaka oyo, mwanegena athɨ: «Imwe muthetsi ki, <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />muthetsi ko likwirire mʉndʉ mʉgʉma afwɨre abandʉ, bʉshana ekɨhʉgo kɨthatsɨ́kaga.» <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />Ebɨnwa Kayafa anegenaga athanegenagabyo ɨthokana n'emɨganɨtsye yɨwe, hewethuwe kʉshangwa abyaga Muheri Mʉkʉlʉ ko mwaka oyo, mwamɨnyerera ko lyabyaga nɨ lɨtholere Yesʉ afwɨre abandʉ boshi b'omo ekɨhʉgo kɨno. <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />N'erɨfwa lɨwe lɨthalɨ bʉshana n'abandʉ boshi b'omo kɨhʉgo kɨno kuroshi, hewethuwe na bʉshana n'ihira mʉ bʉgʉma abana ba Gongo bo basanzabene. <verse eid="JHN 11:52" /><verse number="53" style="v" sid="JHN 11:53" />Ɨthoka ekɨro ekyo, abakʉlʉ b'aBayuta mobahamʉla ɨthɨsa Yesʉ. <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />Bʉshana n'ekyo, Yesʉ mwathashʉba genda-genda alɨ ayikangya ko Bayuta. Honyuma kw'aho mwathoka eyo n'ɨya mo kɨhʉgo kyabyaga hofɨ n'embwarara, mu muyi alʉkawamo Efʉraɨmʉ. Oko, mwikalako bɨro bɨrɨ bʉlebe hagʉma n'abɨga bʉwe.<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />Ekɨro ky'ePasaka y'aBayuta kyabyaga hofɨ. Mo mɨlalɨtsyo y'ePasaka, bandʉ bangɨ mobathoka mo miyi n'ɨrʉkɨra ɨYerʉsalemʉ bʉshana baya yetsye embere y'ePasaka. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />Bagenda abashondya Yesʉ, n'abandʉ babyaga mo Nyʉmba ya Gongo bagenda ababutsania bathɨ: «Omʉganɨtsya ki? Yesʉ ahika ko linye kʉtse ɨhɨ?» <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />aBaheri Bakʉlʉ n'aBafarisayo babyaga nɨbamahamʉla bathɨ: bʉlɨ mʉndʉ yo wamɨnya ho Yesʉ alɨ, nɨ aya bwɨrabo bʉshana bamʉmɨne.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">Marɨa ahaka Yesʉ yo marasi</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mat 26:6-13</ref>; <ref loc="MRK 14:3-9">Mar 14:3-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />Bɨro ndathʉ embere y'ePasaka, Yesʉ mwahika ɨBetanɨa muyi wabo Lasaro yo alubukaya ɨthoka mo baholi. <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />Oko, mobamʉthekera kalyo ka lʉlengero. Marata agenda athekʉlɨrabo, na Lasaro abyaga mʉgʉma wa ko bo balɨraga hagʉma na Yesʉ. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />Marɨa mwathola kɨtse kya litere ngʉma ya marasi wa kɨtsɨro kɨnene. Amarasi ayo akomibawa mʉ mʉshanga wa narito mʉsha. Marɨa mwahakawo ko bɨshando bya Yesʉ n'ɨshangʉlabyo mo nzwɨrɨ sɨwe. Enyʉmba yoshi moyotsula akabeho k'amarasi ayo. <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />Aho, Yuta Isikariote mʉgʉma wa ko bɨga ba Yesʉ, oyo wamʉhothera, mwanegena athɨ: <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />«Bʉshana na ki mobathalɨ abagʉtsya amarasi aya wo bɨtsere magana ashathʉ bya tinari n'ɨgabɨrabyo abatsene?»<note caller="+" style="f"><char style="fr" closed="false">12:5 </char><char style="ft" closed="false">Bɨtsere magana ashathʉ bya tinari: Nɨ faranga sɨrɨngene na lʉhembo lwa mʉlɨmo wa mwaka mʉgʉma. </char></note> <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />Anegenaga athyo ɨthalɨ bʉshana n'ɨfwɨra abatsene bo shashi hewethuwe nɨ bʉshana abyaga mwɨtsɨ. N'ɨye yo wagendaga abɨka eshaho y'esofaranga na agenda ashoshola ko sofaranga etho. <verse eid="JHN 12:6" /><verse number="7" style="v" sid="JHN 12:7" />Aho Yesʉ mwanegena athɨ: «Mumulike! Akola athyo bʉshana n'ekɨro ky'erɨthabwa lyaye. <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />Abatsene omunabya nabo ebɨro byoshi, he ingye, muthindabye nangye ebɨro byoshi.»<verse eid="JHN 12:8" /></para>
  <para style="s">Enama y'eritha Lasaro</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />Muhindano mʉnene wa Bayuta mobonvwa ko Yesʉ alɨ ɨBetanɨa. Mobayayo, ɨthalɨ bʉshana n'ɨlola kʉ Yesʉ kuroshi, hewethuwe na bʉshana n'ɨya lola kʉ Lasaro yo walubukibawa ɨthoka mo baholi. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />Aho, abakʉlʉ b'abaheri mobahamʉla ɨthɨsa Lasaro naye, <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />kʉshangwa nɨ bʉshana naye Bayuta bangɨ mobayɨhɨgʉla kʉbo na mobɨkɨrɨtsya Yesʉ.<verse eid="JHN 12:11" /></para>
  <para style="s">Yesʉ ɨngɨra ɨYerʉsalemʉ</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mat 21:1-11</ref>; <ref loc="MRK 11:1-11">Mar 11:1-11</ref>; <ref loc="LUK 19:28-40">Luk 19:28-40</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />Bwabere bwakya, omuhindano mʉnene ow'ahikaga ko linye ly'ePasaka, mobonvwa ko Yesʉ alɨ mo nzɨra aya ɨYerʉsalemʉ. <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />Mobatsɨmba mɨthahɨ ya mingasi na mobaya mʉlɨndɨrɨra. Bagenda abahambala bathɨ:</para>
  <para style="q1" vid="JHN 12:13">«Hosana! Agashanɨrwe yo uhika kw'ɨtsɨna lya Nyinya-kowethʉ!</para>
  <para style="q1" vid="JHN 12:13">Agashanɨrwe omwamɨ w'iIsiraeli.»<verse eid="JHN 12:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="JHN 12:14" />Yesʉ mweya kyana kya pʉnda, mwikala kʉkyo nga ko kushakirwe kʉthɨ:<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />«Mʉthʉbahaga imwe bikalani b'iSayuni!</para>
  <para style="q1" vid="JHN 12:15">Mʉlole, omwamɨ enyu ahika, ikere kʉ kyana kya pʉnda.»<note caller="+" style="f"><char style="fr" closed="false">12:15 </char><char style="ft" closed="false">Soma Sakarɨa 9:9.</char></note><verse eid="JHN 12:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="JHN 12:16" />Mo kathambi ako abɨga ba Yesʉ mobathonvwa ebyo bɨtsʉka, hewethuwe abere amamala ɨshʉngɨka mo lʉkengerwa mobɨbʉka ko ebɨnwa ebi bishakirwe kw'ɨye na bathyo ko bamamʉkolera.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />Omuhindano w'abandʉ bo babyaga hagʉma na Yesʉ mo ndambi abɨrɨkɨraga Lasaro athoke mw'ɨsɨnda n'imulubukya bagenda ababwɨra abandɨ ebyo bithabya. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />Bʉshana n'ekyo bandʉ bangɨ mobaya mʉlɨndɨrɨra, kʉshangwa babyaga nɨbamonvwa kw'amakangya ekɨmɨnyɨkalo ekyo. <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />Aho, aBafarisayo mobabwɨrana bagʉma kʉ bandɨ bathɨ: «Mʉlole, hathalɨ kyo mwangakotsya. Abandʉ boshi bamukwamire!»<verse eid="JHN 12:19" /></para>
  <para style="s">Bakiriki abashondya ɨshʉnga kʉ Yesʉ</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />Kwabyaga Bakiriki bagʉma bo bɨrʉkɨraga ɨYerʉsalemʉ bʉshana n'ɨya ramya Gongo mo kɨro ky'elinye. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />Mobayɨfʉnda ahalɨ Filipo w'oko muyi w'iBetesaita mo kɨhʉgo ky'iNgalilaya n'ɨmʉbwɨra bathɨ: «Nyinya-kowethʉ, othushondya ɨshʉnga Yesʉ.» <verse eid="JHN 12:21" /><verse number="22" style="v" sid="JHN 12:22" />Filipo mwayabwɨra Ndereya yo ebɨnwa ebyo, honyuma kw'aho, ababɨrɨ mobayabwɨra Yesʉ. <verse eid="JHN 12:22" /><verse number="23" style="v" sid="JHN 12:23" />Yesʉ mwashʉbɨtsyabo athɨ: «Endambi y'erisingya oMʉgala w'oMʉndʉ yamahika.» <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />Kwenene, kwenene enyɨbabwɨra, embulu y'engano ɨthathogere ahishi na ithafwire inabya yoyene. Hewethuwe yamafwa ɨnaheka mbulu nyɨngɨ. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />Yo utsiire obʉyɨngo bʉwe anahetsyabo, hewethuwe yo ubayire obʉyɨngo bʉwe hano ishi andabya nabo ihika ko kɨro andabona obʉyɨngo bw'ekera n'ekera. <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />Mʉndʉ amashondya ɨnyɨkolera, anyɨkwame. Ahoshi nyandabya, nɨ aho h'omukoli aye naye andabya. Thatha andashikya yo ʉnyɨkolera.<verse eid="JHN 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />Lɨno omʉthɨma aye agangaganga. Nyithetsi nga nyɨnegene nyithi ki. Thatha nyɨshabʉle ko ndambi eno. Hewethuwe nyahikaga bʉshana n'endambi eno. <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />Thatha, singya erɨtsɨna lyawe. Aho, mʉlenge mwathoka mo lʉbʉla nɨanegena athɨ: «Nyamasingyalyo na nyandashʉba singyalyo.» <verse eid="JHN 12:28" /><verse number="29" style="v" sid="JHN 12:29" />Omuhindano w'abandʉ bo babyagaho bo bonvwaga omʉlenge oyo mobanegena bathɨ: «Nɨ muhindo wa buthuku.» N'abandɨ mobanegena bathɨ: «Nɨ malaɨka yo ʉthagenda asɨmola naye.» <verse eid="JHN 12:29" /><verse number="30" style="v" sid="JHN 12:30" />Hewethuwe Yesʉ mwabwɨrabo athɨ: «Omʉlenge athathonvwɨka bʉshana nagye, hewethuwe bʉshana nemwe. <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />Eno yo ndambi ekɨhʉgo kɨno kyasohwamo. Eno yo ndambi omuthegeki w'ekɨhʉgo kɨno ahɨmwa. <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />Hewethuwe ingye, nyandabya nyashʉmbwa ɨthoka hano ishi, nyandayɨkʉrɨrako abandʉ boshi.» <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />Ɨtsʉkɨra ebɨnwa ebi Yesʉ akanganaya ng'afwa lʉholo lʉlɨ lʉthɨ. <verse eid="JHN 12:33" /><verse number="34" style="v" sid="JHN 12:34" />Omuhindano mwamʉshʉbɨtsya athɨ: «Mothwɨga mo mashako w'oMʉgomba mbʉ Kirisito andabyaho kera n'ekera. Aho, ʉthɨ ko ʉnegena ʉthɨ lɨtholere oMʉgala w'oMʉndʉ nɨashʉmbwa mo kyanya? N'oMʉgala w'oMʉndʉ oyo nɨ ndɨ?» <verse eid="JHN 12:34" /><verse number="35" style="v" sid="JHN 12:35" />Yesʉ mwashʉbɨtsyabo athɨ: «Ekyakakala kɨkɨnalɨ mo kathi kenyu kʉ ndambi nge. Ko mʉkɨnalɨ n'ekyakakala, mʉgende nɨmo omwitsimya athabashwɨkaga. Kʉshangwa yo ʉgenda mo mwitsimya athamɨnya eyo aya. <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />Aho mwɨkɨrɨtsye ekyakakala mo ndambi mʉkɨnalɨ n'ekyakakala, nɨmo mwabya bana b'ekyakakala.» Yesʉ abere amamala ɨbwɨrabo ebɨnwa ebyo, mwayɨgendera n'iyibisha hale n'omuhindano oyo.<verse eid="JHN 12:36" /></para>
  <para style="s">Obʉthɨkɨrɨtsya bw'aBayuta</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37" />Namo Yesʉ anakolaga bɨmɨnyɨkalo bɨngɨ embere sabo, mobathamwɨkɨrɨtsya <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />bʉshana ebɨnwa byanegenawa n'omʉmɨnyeretsɨ Isaya bɨno bɨbererere:</para>
  <para style="q1" vid="JHN 12:38">«Nyinya-kowethʉ, nɨ ndɨ yo wɨkɨrɨtsyaga ebyo thwanegenaga?</para>
  <para style="q1" vid="JHN 12:38">Na nɨ ndɨ yo wakumbulirawa emɨkolano y'amaka wa Nyinya-kowethʉ?»<note caller="+" style="f"><char style="fr" closed="false">12:38 </char><char style="ft" closed="false">Soma Isaya 53:1.</char></note><verse eid="JHN 12:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="JHN 12:39" />Omʉmɨnyeretsɨ Isaya mwashaka ekyangalekire nɨbathɨkɨrɨtsya athɨ:<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />«Gongo mwatsɨba amesho wabo na mwatsibuhya emɨthɨma yabo,</para>
  <para style="q1" vid="JHN 12:40">bʉshana bathalolaga n'amesho wabo,</para>
  <para style="q1" vid="JHN 12:40">n'emɨthɨma yabo ɨthonvwaga</para>
  <para style="q1" vid="JHN 12:40">nɨmo bathɨbɨndʉke</para>
  <para style="q1" vid="JHN 12:40">nangye nyangalamitsyebo?»<note caller="+" style="f"><char style="fr" closed="false">12:40 </char><char style="ft" closed="false">Soma Isaya 6:9-10.</char></note><verse eid="JHN 12:40" /></para>
  <para style="m">
    <verse number="41" style="v" sid="JHN 12:41" />Isaya anegenaga ebɨnwa ebi, kʉshangwa mwashʉnga olʉkengerwa lwa Yesʉ, na mwasɨmola ko myatsɨ yɨwe. <verse eid="JHN 12:41" /><verse number="42" style="v" sid="JHN 12:42" />Hewethuwe bangɨ ba mo bakʉlʉ b'aBayuta mobɨkɨrɨtsya Yesʉ. Bʉshana n'erɨʉbaha aBafarisayo, bathagenda abayikangya ko bamɨkɨrɨtsya, bagenda abʉbaha erɨhɨwa mo sinakoki. <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />Abakʉlʉ abo babyaga nibatsiire olʉkengerwa lo luthokire ko bandʉ kʉlenga olʉkengerwa lo lʉthoka kʉ Gongo.<verse eid="JHN 12:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />Aho Yesʉ mwahambala athɨ: «Oyo wamanyɨkɨrɨtsya, athalɨ ingye amɨkirɨtsya, hewethuwe amɨkɨrɨtsya yo wanyɨthʉmaga. <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />N'oyo wamanyɨshʉnga nɨamashʉnga na ko yo wanyɨthʉmaga. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />Ingye nyahikaga hano ishi nga kyakakala, bʉshana bʉlɨ mʉndʉ yo ʉnyɨkɨrɨtsye athabyaga mu mwitsimya. <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />Mʉndʉ amonvwa ebɨnwa byaye buthashikyabyo, nyɨthalɨ ingye nyandamʉsoha. Kʉshangwa nyithahikaga ɨsoha ekɨhʉgo hewethuwe nyahikaga bʉshana n'ɨshabʉla ekɨhʉgo. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />Yo ʉnyɨthɨnda na athalɨ akokya ebɨnwa byaye andasohwa ɨkwamana nabyo. Ekɨnwa enyɨnegena kyo kyandamʉsoha ekɨro ky'enduli. <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />Kʉshangwa monyɨthalɨ enyɨnegena kʉ maka aye ngyowene, hewethuwe Thatha yo wanyɨthʉmaga yo wanyɨhamʉlaga ebyo nyanganegena n'ɨkangɨrɨtsya. <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />Nyetsi kw'oMʉgomba ʉwe analetha obʉyɨngo bw'ekera na kera. Bʉshana n'ekyo, ebɨnwa enyɨnegena, enyɨnegenabyo nga ko Thatha anyɨhamʉlaga.»<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">Yesʉ anabya ebɨshando by'abɨga bʉwe</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />Kwabyaga ni kukishiya kɨro kɨgʉma embere ePasaka ihike. Yesʉ abyaga nietsi kw'endambi yɨwe y'erɨthoka mo kɨhʉgo n'ɨshʉba ewa Thatha yamahika. Ɨye yo wabyaga atsiire abandʉ bʉwe ba hano ishi, mwatsɨɨrabo ihika ko nduli.<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />Yesʉ n'abɨga bʉwe babere balɨ abalya akalyo k'olʉlengero, Sitani abyaga niamalire ihira mo mʉthɨma wa Yuta mʉgala wa Simoni Isikariote mo mɨganɨtsye y'erɨhothera Yesʉ. <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />Yesʉ abyaga nietsi ko Ishe mwahira ebɨndʉ byoshi ekihya y'obuthegeki bʉwe, nietsi ko athokaga ewa Gongo na ashʉba ewa Gongo. <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />Babere balɨ abalya, Yesʉ mwimana emʉsɨke w'olʉgalɨ, mwathokya ekoti na mwatsɨmba sume na mwayɨmɨnaro mo mbɨndɨ. <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />Honyuma kw'aho, mwahira metsi mʉ beseni, na mwathanga inabya ebɨshando by'abɨga bʉwe n'ɨshangʉlabyo mo sume abyaga aminire mo mbɨndɨ. <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />Lwabere lwabya lʉhɨtsyo lwa Simoni Petero, ono mwamʉbwɨra athɨ: «Nyinya-kowethʉ, nɨ ɨwe wanyinabya ko bɨshando?» <verse eid="JHN 13:6" /><verse number="7" style="v" sid="JHN 13:7" />Yesʉ mwamʉshʉbɨtsya athɨ: «Uthaminyire lɨno ekyo enyɨkola, hewethuwe wamɨnyakyo enyuma.» <verse eid="JHN 13:7" /><verse number="8" style="v" sid="JHN 13:8" />Petero mwamʉbwɨra athɨ: «Kiro, uthanganyinabya ebɨshando n'ahake!» Yesʉ mwamʉshʉbɨtsya athɨ: «Nyithakunabitsye ko bɨshando, nɨhathakɨrɨ kyo nyishangire nawe.» <verse eid="JHN 13:8" /><verse number="9" style="v" sid="JHN 13:9" />Simoni Petero mwamʉbwɨra athɨ: «Aho mbe Nyinya-kowethʉ uthanyinabaya ko bɨshando bɨsha, hewethuwe na ko minwe na ko muthwe!» <verse eid="JHN 13:9" /><verse number="10" style="v" sid="JHN 13:10" />Yesʉ mwamʉbwɨra athɨ: «Yo ʉthoga athakilayire kw'inabibwa, kʉshangwa ɨye woshi erire. Nemwe mwerire hewethuwe ɨthalɨ imwe boshi.» <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />Yesʉ abyaga nietsi yo wamʉhothera kyo kyalekaga nɨanegena athɨ: «Ɨthalɨ imwe boshi mo mwerire.»<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />Yesʉ abere amamala inabyabo ko bɨshando, mwambala ekoti yɨwe, mwashʉba ɨya lya n'ɨbwɨra abɨga athɨ: «Mwanamamɨnya ebyo nyamabakolera? <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />Omʉnyahʉlamo “Mʉkangɨrɨtsya” na “Nyinya-kowethʉ” omʉnegena kwenene kʉshangwa nyɨrɨ ɨye. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />Aho, ingye Mʉkangɨrɨtsya enyu na Nyinya-kowenyu nyamabanabya ko bɨshando, nemwe kuthyo muhamulirwe ɨgenda omunabania bɨshando. <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />Nyamabakangya ko mwagenda omʉyɨra, ekyo nyamabakolera, nemwe mʉgende omʉkola muthyo.<figure style="fig" alt="Jesus lave les pieds de ses disciples" file="WA03912b.tif" size="col" copy="Graham Wade" ref="13:15">Yesʉ anabya ebɨshando bya bɨga bʉwe</figure> <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />Kwenene, kwenene, enyɨbabwɨra, omukoli athalengitsye nyinya-kowabo. Kʉtse omʉthʉmwa athalɨ mʉkʉlʉ ko yo ʉthamʉthʉma. <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />Kʉshangwa mʉhera mwetsi ebi, mwandagashanɨrwa mwamakolabyo.»<verse eid="JHN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />«Nyɨthalɨ enyɨbwahʉla imwe boshi, nyetsi bo nyashombolaga. Hewethuwe, lɨtholere ebɨnwa bɨrɨ mo Mashako Abuyirire bɨno bɨbererere: “Yo nyashangɨraga naye akalyo kʉ mbale ngʉma, amanyɨbɨndʉkako<note caller="+" style="f"><char style="fr" closed="false">13:18 </char><char style="ft" closed="false">Soma Saburi 41:10.</char></note>.” <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />Enyɨbabwɨra lɨno embere bibye, bʉshana byabya byahika mwɨkɨrɨtsye ko Ingye ngyo Nyɨrɨ. <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />Kwenene, kwenene enyɨbabwɨra, ikokya yo nyandathʉma nɨ inyikokya ingyowene-wene, n'erinyikokya nɨ ikokya na yo wanyɨthʉmaga.»<verse eid="JHN 13:20" /></para>
  <para style="s">Yuta ahothera Yesʉ</para>
  <para style="r">(<ref loc="MAT 26:20-25">Mat 26:20-25</ref>; <ref loc="MRK 14:17-21">Mar 14:17-21</ref>; <ref loc="LUK 22:21-23">Luk 22:21-23</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />Yesʉ abere amamala ɨnegena ebyo, mwathabagana n'ɨnegena athɨ: «Kwenene, kwenene enyɨbabwɨra, mʉgʉma mw'imwe anyɨhothera.» <verse eid="JHN 13:21" /><verse number="22" style="v" sid="JHN 13:22" />Abɨga mobalolana n'ɨabayɨbʉtsya nga Yesʉ ahʉla ndɨ. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />Mʉgʉma w'oko bɨga, yo Yesʉ abyaga atsiire kʉtsɨbʉ abyaga nɨagemere kʉ Yesʉ balɨ abalya. <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />Simoni Petero mwamʉkohetsya athɨ abʉtsye Yesʉ ng'ahʉla ndɨ. <verse eid="JHN 13:24" /><verse number="25" style="v" sid="JHN 13:25" />Aho, omwɨga oyo mwagemera ko kɨfʉba kya Yesʉ n'ɨmʉbʉtsya athɨ: «Nyinya-kowethʉ, nɨ ndɨ yo wahʉla?» <verse eid="JHN 13:25" /><verse number="26" style="v" sid="JHN 13:26" />Yesʉ mwashubya athɨ: «Enyishondya ɨkoletsya kɨtse kya mukati. Yo nyaha ekɨtse ekyo, nɨ ɨye.» Aho, Yesʉ mwakoletsya ekɨtse ky'omukati abyaga awitheko na mwahakyo Yuta mʉgala wa Simoni Isikariote. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />Yuta abere amamala ɨtsɨmba ekɨtse ky'omukati ekyo Sitani mwamwɨngɨramo. Nɨmo Yesʉ amʉbwɨra athɨ: «Ekyo ushondya ɨkola, kolakyo tsʉba.» <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />Hathalɨ n'omʉgʉma ko bo bagenda abalya hagʉma na Yesʉ yo wamɨnyaga nga Yesʉ amamʉbwɨra athyo bʉshana na ki. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />Bagʉma mobaganɨtsya bathɨ Yesʉ amamʉbwɨra mbʉ ayagʉle bɨndʉ bilayirweko ko linye kʉtse ayawathikye abatsene kʉshangwa nɨ Yuta yo wabyaga abikire eshaho y'esofaranga. <verse eid="JHN 13:29" /><verse number="30" style="v" sid="JHN 13:30" />Yuta ɨye, abere amamala irya ekɨtse ky'omukati ekyo, aho n'aho mwahʉlʉka. Bwabyaga nɨbwahera kɨro.<verse eid="JHN 13:30" /></para>
  <para style="s">Yesʉ ahana ithegeko lihya</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />Yuta abere amahʉlʉka, Yesʉ mwanegena athɨ: «Hano, oMʉgala w'oMʉndʉ amasingibwa, na Gongo naye amasingibwa ɨtsʉkɨra ɨye. <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />Gongo alɨ amasingibwa ɨtsʉkɨra Mʉgala, na kuthyo Gongo naye asingya Mʉgala w'oMʉndʉ ɨtsʉkɨra ɨye yowene, na amusingya bʉtha thɨndɨra. <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" />Bʉshana n'ekyo, bana baye, nyɨkɨnalɨ nemwe kʉ kathambi kake. Mwanyishondya, hewethuwe nga ko nyɨthabwɨra abakʉlʉ b'aBayuta, nemwe kuthyo enyɨbabwɨrabyo lɨno, eyo nyɨya muthangahikayo. <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" />Enyɨbaha ithegeko lihya: mʉtsɨɨrane bagʉma kʉ bandɨ. Nga ko nyabatsɨɨraga, nemwe kuthyo mʉtsɨɨrane. <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />Mwamatsɨɨrana bagʉma kʉ bandɨ, abandʉ boshi nɨbamɨnya ko mʉlɨ bɨga baye.»<verse eid="JHN 13:35" /></para>
  <para style="s">Yesʉ anegena ko Petero ayɨgana ɨye</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mat 26:31-35</ref>; <ref loc="MRK 14:27-31">Mar 14:27-31</ref>; <ref loc="LUK 22:31-34">Luk 22:31-34</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />Simoni Petero mwamʉbʉtsya athɨ: «Nyinya-kowethʉ, waya hayi?» Yesʉ mwamʉshʉbɨtsya athɨ: «Eyo enyɨya, ʉthanganyɨkwama lɨno, hewethuwe wandanyɨkwama enyuma.» <verse eid="JHN 13:36" /><verse number="37" style="v" sid="JHN 13:37" />Petero mwamʉbʉtsya athɨ: «Nyinya-kowethʉ, bʉshana na ki nyɨthangakʉkwama lɨno? Nyahana obʉyɨngo bwaye bʉshana nawe!» <verse eid="JHN 13:37" /><verse number="38" style="v" sid="JHN 13:38" />Yesʉ mwamʉshʉbɨtsya athɨ: «Wahana obʉyɨngo bwawe bʉshana nangye? Kwenene, kwenene, enyɨkʉbwɨra, wayɨgana ingye ngendo ishathu ko uthanyetsi embere embagatsɨ yɨbɨke.»<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">Yesʉ nɨ nzɨra y'erɨya ewa Thatha</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />Yesʉ mwabwɨra abɨga bʉwe athɨ: «Mʉthaganga-gangaya emɨthɨma enyu. Mwɨkɨrɨtsye Gongo nangye mʉnyɨkɨrɨtsye kuthyo. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />Mo nyʉmba ya Thatha mʉlɨ bwikalo bʉngɨ. Bɨrɨ ko bɨthalɨ bithyo, nyithangababwire nyɨthɨ enyɨya bakometsya bwikalo. <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />Na nyandabya nyamala ɨbakometsya bwikalo, nyandashʉbʉla n'itsa bwenda, bʉshana aho nyandabya, nemwe mubyeho kuthyo. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />Mwetsi enzɨra y'erihika eyo nyɨya.»<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />Tomasɨ mwamʉbwɨra athɨ: «Nyinya-kowethʉ, thuthetsi eyo ʉya, aho thwangamɨnya enzɨra yo thʉthɨ?» <verse eid="JHN 14:5" /><verse number="6" style="v" sid="JHN 14:6" />Yesʉ mwamʉshʉbɨtsya athɨ: «Ingye ngyo nzɨra n'ekwenene n'obʉyɨngo. Omʉndʉ athangahika ewa Thatha athanyitsukireko. <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />Mwanganyiminyire, mwangaminyire na Thatha kuthyo. Ɨthoka lɨno mumwetsi na mwamamʉshʉnga.»<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />Filipo mwamʉbwɨra athɨ: «Nyinya-kowethʉ, thukangye Thatha, n'ekyo kithuwathikye.» <verse eid="JHN 14:8" /><verse number="9" style="v" sid="JHN 14:9" />Yesʉ mwamʉbwɨra athɨ: «Nyɨrɨ nemwe bɨro bɨngaha, mbe Filipo, uthanetsi wanyɨmɨnya? Yo wamanyɨshʉnga nɨamashʉnga Thatha. Bʉshana na ki oʉnegena ʉthɨ: “Thukangye Thatha”? <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />Ʉthɨkɨrɨtsye ko nyɨrɨ emwishi sa Thatha na Thatha alɨ emwishi saye? Ebɨnwa ebyo enyɨbabwɨra nyɨthalɨ enyɨnegenabyo kʉ maka aye ingy'owene. Hewethuwe nɨ Thatha yo ʉlɨ emwishi saye yo ʉkola emɨrɨmo yɨwe. <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />Mʉnyɨkɨrɨtsye mo ndambi enyɨnegena nyɨthɨ nyɨrɨ emwishi sa Thatha, na Thatha alɨ emwishi saye. Bɨthalɨ bithyo, mwɨkɨrɨtsye bʉshana n'emɨkolano eyo enyɨkola.»<verse eid="JHN 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 14:12" />«Kwenene, kwenene, enyɨbabwɨra, yo ʉnyɨkɨrɨtsye, naye andakola ebyo enyɨkola. Na kalengyo kw'aho, ɨye andakola mɨkolano mɨnene-mɨnene kʉlenga ebyo enyɨkola, kʉshangwa enyɨya ewa Thatha. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />N'ebyoshi mwandashaba kw'ɨtsɨna lyaye, nyandakolabyo, bʉshana Thatha abone olʉkengerwa kw'ɨtsʉkɨra Mʉgala. <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />Na mwamanyɨshaba kɨndʉ kyoshi-kyoshi kw'ɨtsɨna lyaye nyandabakolerakyo.»<verse eid="JHN 14:14" /></para>
  <para style="s">Endagane y'erɨthʉma oMʉthɨma Mwerʉ</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />«Na mwamanyɨtsɨɨra nimwandashikya amathegeko aye. <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />Nangye nyandashaba Thatha abahe ʉndɨ mwangɨrɨtsɨ naye andabya hagʉma nemwe ebɨro byoshi. <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />Naye nɨ oMʉthɨma w'ekwenene. Ekɨhʉgo kithangamukokya kʉshangwa kɨthalɨ ekɨmʉlolako na kithamwetsi. Imwe mumwetsi kʉshangwa ikere hagʉma nemwe naye alɨ emwishi senyu.»<verse eid="JHN 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 14:18" />«Nyithibamike nga fubi, hewethuwe nyandabashʉbɨra. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />Mʉ bɨro bɨke abandʉ ba hano ishi bathɨndashʉbe nyɨlolako. Hewethuwe imwe, mwandanyɨlolako kʉshangwa ingye nyɨrɨho nemwe kuthyo mwandabyaho. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />Mo kɨro ekyo, mwandamɨnya ko nyɨrɨ emwishi sa Thatha, nemwe ko mʉlɨ emwishi saye, nangye ko nyɨrɨ emwishi senyu. <verse eid="JHN 14:20" /><verse number="21" style="v" sid="JHN 14:21" />Yo wɨkɨrɨtsya amathegeko aye n'ishikyawo, nɨ oyo yo unyitsiire. Na Thatha andatsɨɨra yo unyitsiire, nangye kuthyo nyandamʉtsɨɨra na nyandayikangya kw'ɨye.»<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />Yuta, hewethuwe athalɨ Yuta Isikariote, mwamʉbʉtsya athɨ: «Nyinya-kowethʉ, ʉthɨ ko wayikangania wowene kw'ithwe basha, he bʉtsɨra ko bandʉ b'omo kɨhʉgo?» <verse eid="JHN 14:22" /><verse number="23" style="v" sid="JHN 14:23" />Yesʉ mwamʉshʉbɨtsya athɨ: «Mʉndʉ amanyɨtsɨɨra, andashikya ekɨnwa kyaye, na Thatha andamʉtsɨɨra. Aho, ingye na Thatha thwandɨngɨra emwishi sɨwe, n'ikala emwishi sɨwe. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />Yo uthanyitsiire athangashikya ebɨnwa byaye. N'ekɨnwa omwonvwa nyɨrɨ enyɨnegena kɨthalɨ ekɨthoka emwishi saye, hewethuwe ekɨthoka ewa Thatha yo wanyɨthʉmaga. <verse eid="JHN 14:24" /><verse number="25" style="v" sid="JHN 14:25" />Nyamababwɨra ebɨnwa byoshi ebi kʉshangwa nyɨkɨnalɨ hagʉma nemwe. <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />Hewethuwe oMwangɨrɨtsɨ nɨ oMʉthɨma Mwerʉ, oyo Thatha andathʉma mw'ɨtsɨna lyaye, andabakangɨrɨtsya ebɨnwa byoshi n'ibwibukya ebyoshi nyababwɨraga.»<verse eid="JHN 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />«Nyamabamikira obʉholo, nyamabaha obʉholo bwaye. Nyɨthabaherebo ng'abandʉ ba hano ishi ko banahanabo. Mʉthaganga-gangaya emɨthɨma enyu na mʉthʉbahaga. <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />Momwonvwa ko nyɨthababwɨra nyɨthɨ enyɨyɨgendera, hewethuwe nyabashʉbɨra. Mwanganyitsiire mwangamogere erɨmɨnya kw'enyɨya ewa Thatha, kʉshangwa Thatha nɨ mʉkʉlʉ kw'ingye. <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />Nyamababwɨra ebɨnwa ebi ko ndambi eno embere bibye, bʉshana byandabya byakoleka, mʉnyɨkɨrɨtsye. <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />Nyɨthɨshʉbe sɨmola nemwe bɨnwa bɨngɨ, kʉshangwa omuthegeki w'ekɨhʉgo kɨno ahika. Ɨye athawithe maka kw'ingye. <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />Hewethuwe lɨtholere abandʉ nɨbamɨnya ko nyitsiire Thatha, nangye enyɨkola nga ko anyɨhamʉlaga. Ewo, mwimane thʉthoke hano!»<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">Yesʉ nɨ musabibu w'ekwenene</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />Ingye nyɨrɨ <char style="w" lemma="musabibu">musabibu</char> w'ekwenene<note caller="+" style="f"><char style="fr" closed="false">15:1 </char><char style="ft" closed="false">Soma Isaya 5:1-4.</char></note> na Thatha yo muhingi. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />Bʉlɨ mʉthahɨ anyilashireko ow'athahekire biguma anatsawo. Hewethuwe bʉlɨ mʉthahɨ ow'ahekire biguma anasarɨrawo bʉshana aheke biguma bɨngɨ kw'aho. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />Imwe mwamalire ɨera bʉshana n'ekɨnwa nyababwɨraga. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />Mwikale emwishi saye nga ko nyikere emwishi senyu. Kʉbʉshɨ hathalɨ mʉthahɨ wangaheka biguma wowene alɨ athalashire ko musabibu. Nemwe kuthyo mʉthangaheka biguma muthikere emwishi saye. <verse eid="JHN 15:4" /><verse number="5" style="v" sid="JHN 15:5" />Ingye nyɨrɨ musabibu, nemwe mʉlɨ mɨthahɨ. Yo wikere emwishi saye, nangye nyikere emwishi sɨwe, oyo andaheka biguma bɨngɨ. Kʉshangwa muthikere emwishi saye mʉthangakola kɨndʉ. <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />N'omʉndʉ amabya athikere emwishi saye, andagʉshwa embʉga nga kw'abanagʉsha omʉthahɨ nawo n'ɨʉma. Emɨthahɨ yɨrɨ ng'eyo, ɨnakʉmwa-kʉmwa n'ɨʉshwa mo mʉtsanwa naro niyahya. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />Mwamikala emwishi saye n'ebɨnwa byaye byamikala emwishi senyu, mʉshabe ebyo mushashire, nemwe mwandahabwabyo. <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />Mwamaheka biguma bɨngɨ, Thatha nɨandahalambwa, n'aho ni mwabya bɨga baye kundu. <verse eid="JHN 15:8" /><verse number="9" style="v" sid="JHN 15:9" />Nga ko Thatha anyɨtsɨɨraga, nangye kuthyo nyibatsiire. Aho, mwikale mo lwanzo lwaye. <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />Mwamashikya amathegeko aye, mwandikala mo lwanzo lwaye, nga ko nangye monyashikya amathegeko wa Thatha, na nyikere mo lwanzo lʉwe. <verse eid="JHN 15:10" /><verse number="11" style="v" sid="JHN 15:11" />Monyɨbabwɨra ebɨnwa ebi, bʉshana olʉmogo lwaye lubye mw'imwe, n'olʉmogo lwenyu lubye lʉnene kʉtsɨbʉ<note caller="+" style="f"><char style="fr" closed="false">15:11 </char><char style="ft" closed="false">Soma Isaya 9:2; 35:10.</char></note>. <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />Erithegeko lyo nyɨbaha lye lɨno: mʉtsɨɨrane bagʉma kʉ bandɨ nga ko nyabatsɨɨraga. <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />Hathalɨ mʉndʉ yo uwithe lwanzo lʉnene kʉlenga yo ʉhana obʉyɨngo bʉwe bʉshana n'abira bʉwe. <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />Imwe mʉlɨ bira baye mwamakola ebyo enyɨbahamʉla. <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />Nyɨthɨshʉbe bahʉlamo bakoli, kʉshangwa omukoli athamɨnya ebyo nyinya-kowabo akola. Enyɨbwahʉlamo bira baye lɨno kʉshangwa monyababwire ebyoshi nyonvwaga ɨthoka ewa Thatha. <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />Mʉthalɨ imwe mwanyɨshombolaga, hewethuwe n'ingye ngyo nyabashombolaga. Nyamabathʉma mʉgende mʉyaheke biguma, n'ebiguma byenyu bɨthɨndahwe. Aho, ebyoshi mwandashaba Thatha kw'ɨtsɨna lyaye andabahabyo. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />Erithegeko nyamabaha lye lɨno: mʉtsɨɨrane imwe kw'imwe.<verse eid="JHN 15:17" /></para>
  <para style="s">Abandʉ babayire Yesʉ n'abɨga bʉwe</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />«Abandʉ ba mo kɨhʉgo bamababaga, mʉmɨnye ko mobanyɨbaga embere bababage. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />Mwangabere bandʉ b'ekɨhʉgo, abandʉ b'omo kɨhʉgo bangabatsiire nga balikyabo. Hewethuwe monyabashombola ɨthoka mo kɨhʉgo kɨno. Nemwe mʉthakɨrɨ bandʉ b'omo kɨhʉgo. Nɨ bʉshana n'ekyo abandʉ bababayire. <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />Mwɨbʉke ebɨnwa nyababwɨraga nyɨthɨ: “Omukoli athalɨ mʉkʉlʉ kʉ nyinya-kowabo<note caller="+" style="f"><char style="fr" closed="false">15:20 </char><char style="ft" closed="false">Soma Mat 10:24; Luk 6:40; Yoa 13:16.</char></note>.” Balɨ mobanyagatsya, nemwe kuthyo bandabagatsya. Na balɨ mobashikya ebɨnwa byaye, bandashikya n'ebɨnwa byenyu kuthyo. <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />Hewethuwe bandabakolera ebyoshi ebyo, bʉshana n'erɨtsɨna lyaye kʉshangwa bathetsi yo wanyɨthʉmaga. <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />Nyɨrɨ nyithahikaga na nyɨrɨ nyɨthasɨmolaga nabo, bathangabere bakoli ba bɨtsɨbʉ. Hewethuwe lɨno bathangayɨgana ebɨtsɨbʉ byabo. <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />Yo unyibayire niabayire na Thatha kuthyo. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />Nyɨrɨ nyɨthakolaga bɨmɨnyɨkalo ebyo ʉndɨ mʉndʉ mo kathi kabo athangakotsya ɨkola, bathangabere bakoli b'ebɨtsɨbʉ. Hewethuwe mobalola kʉbyo, he namo bɨnalɨ bithyo, bathubayire ingye na thatha. <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />Hewethuwe ebibya bithyo, nɨ bʉshana kɨbererere ekɨnwa kishakirwe mo <char style="w" lemma="Mʉgomba">Mʉgomba</char> wabo kɨthɨ: “Mobanyɨbayɨra bʉsha<note caller="+" style="f"><char style="fr" closed="false">15:25 </char><char style="ft" closed="false">Soma Saburi 35:19; 69:5.</char></note>.” <verse eid="JHN 15:25" /><verse number="26" style="v" sid="JHN 15:26" />oMwangɨrɨtsɨ nyandabathʉmɨra ɨthoka ewa Thatha andabya ahika, andabya mutimo aye. Ɨye nɨ oMʉthɨma ow'ekwenene ow'athoka ewa Thatha. <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />Nemwe kuthyo mwandabya batimo baye, kʉshangwa mʉlɨ nangye ɨthoka ko ndangɨro.»<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />Nyamababwɨra ebɨnwa byoshi ebi, bʉshana mʉthahetsyaga olwɨkɨrɨtsyo lwenyu. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />Kʉshangwa bandabathokya mo <char style="w" lemma="sosinakoki">sosinakoki</char> sabo. Na kwandabya ndambi abo bandabwitha bandaganɨtsya bathɨ abaherera Gongo mo bwithi obo. <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />Bandakola bathyo kʉshangwa bathetsi Thatha, nangye kuthyo bathanyetsi. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />Hewethuwe monyababwɨra ebɨnwa ebyo, kʉshangwa endambi eyo yandabya yahika, mwɨbʉke ko nyamalire ɨbabwɨra ebɨnwa byoshi ebi.</para>
  <para style="s" vid="JHN 16:4">Omʉlɨmo w'oMʉthɨma Mwerʉ</para>
  <para style="p" vid="JHN 16:4">Monyɨthababwɨra ebɨnwa ebi by'embere, kʉshangwa nyabyaga nɨnyɨkɨnalɨ hagʉma nemwe. <verse eid="JHN 16:4" /><verse number="5" style="v" sid="JHN 16:5" />Ewo, ngyono nyaya eyɨrɨ yo wanyɨthʉmaga. Hathalɨ kiro na mʉndʉ n'omʉgʉma wa kw'imwe yo wamanyɨbʉtsya athɨ: «Ʉya hayi?» <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />Ewono, kʉshangwa nyamababwɨra ebɨnwa ebi, kyamaleka nɨ mwahononokala kʉtsɨbʉ mo mɨthɨma enyu! <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />Hewethuwe enyɨbabwɨra ekwenene: nɨ ndundi kw'imwe ingye nyɨgende, kʉshangwa nyithagendire, oMwangɨrɨtsɨ<note caller="+" style="f"><char style="fr" closed="false">16:7 </char><char style="ft" closed="false">Muwathikya: Soma 14:16.</char></note> niathindabahikire. Hewethuwe nyamagenda nɨnyandabathʉmɨra ɨye. <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />Naye andabya ahika andakangya kʉbʉya-kʉbʉya abandʉ b'omo kɨhʉgo kɨno bw'ebɨtsɨbʉ byabo, na bʉshana n'ekwenene aye, na bʉshana n'esohi ya Gongo<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">Lingania Miko 24:25.</char></note>. <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />Ko birebitsye ebɨtsɨbʉ: kʉshangwa mobathanyɨkɨrɨtsya. <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />Ko birebitsye ekwenene: ingye enyɨya ewa Thatha, nemwe mʉthɨndashʉbe nyɨshʉngako na hake. <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />Na ko birebitsye esohi: omuthegeki w'ekɨhʉgo kɨno amalire ɨtsɨrwa olʉbanza.<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />Nyikinawithe bɨnwa bɨngɨ b'ɨbabwɨra, he muthetsi mwabya na maka w'erɨmɨnyabyo lɨno. <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />Hewethuwe <char style="w" lemma="oMʉthɨma">oMʉthɨma</char> w'eKwenene andabya ahika, andabashondola mo kwenene yoshi. Kʉshangwa athɨndanegene bɨnwa bɨwe yowene, hewethuwe andanegena ebyoshi ebyo andonvwa, na andababwɨra ebyo byandahika. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />Ɨye andanyisingya kʉshangwa ebɨnwa andababwɨra nɨ ebyo andanyonvwako. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />Ebyoshi ebyo Thatha awitheko nɨ bɨwaye. Nɨ bʉshana n'ekyo monyɨbabwɨra nyɨthɨ, ebyo oMʉthɨma Mwerʉ andababwɨra nɨ ebyo bɨrɨ emwishi saye.<verse eid="JHN 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />Honyuma kw'aho, Yesʉ mwanegena athɨ: «Hakishiya ndambi nge nemwe mʉthɨshʉbe nyɨlolako. Kandɨ honyuma hake kw'aho, mwashʉba nyɨshʉnga.» <verse eid="JHN 16:16" /><verse number="17" style="v" sid="JHN 16:17" />Aho bagʉma mo <char style="w" lemma="bɨga">bɨga</char> bʉwe mobathanga ibutsania ɨbo kw'ɨbo bathɨ: «Ashondya ɨthʉbwɨra bɨhɨ? Mwathubwire athɨ: “Hakishiya hake mʉthɨshʉbe nyɨshʉngeko. Kandɨ athɨ kʉ kathambi kake mwashʉba nyɨshʉngako,” kandɨ athɨ: “Enyɨgenda eyɨrɨ Thatha.” <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />Binegenire bithi ki mo ndambi anegena athɨ: “Kandɨ kʉ kathambi kake?” Thuthaminyire ebyo anegena.» <verse eid="JHN 16:18" /><verse number="19" style="v" sid="JHN 16:19" />Aho Yesʉ mwamɨnya ko abashondya ɨmʉbʉtsya kw'ebyo mwabwɨrabo athɨ: «Omʉyɨbʉtsya bʉshana n'ebɨnwa nyɨthanegena nyɨthɨ: hakishiya ndambi nge nemwe mʉthɨshʉbe nyɨlolako, hewethuwe kandɨ kʉ ndambi nge mwashʉba nyɨlolako.» <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />Ko kwenene enyɨbabwɨra mwandalɨra n'ɨhononokala, hewethuwe abandʉ b'omo kɨhʉgo bandamoga. Mwandafwa buliye, hewethuwe obuliye bwenyu bwandabɨndʉka lʉmogo. <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />Omʉkatsɨ anabya alɨ akʉnda, anonvwa bwagali bʉngɨ, kʉshangwa endambi yɨwe y'erɨbʉtha niyamahika. Hewethuwe anabya amamala ɨbʉtha, athalɨ anashʉba ɨbʉka obwagali, bʉshana n'olʉmogo lw'erɨbʉthwa ly'omwana. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />Aho nemwe kuthyo omwonvwa bwagali, he nyandashʉba bashʉnga nemwe mwandamoga mo mɨthɨma enyu, na hathalɨ mʉndʉ yo wandashʉba leka nɨ mwafwa buliye. <verse eid="JHN 16:22" /><verse number="23" style="v" sid="JHN 16:23" />Ko kɨro ekyo mʉthɨndashʉbe nyɨbʉtsya kɨndʉ. Kwenene kwenene enyɨbabwɨra, mwamashaba Thatha yo kɨndʉ kɨrebe mw'ɨtsɨna lyaye, andabahakyo. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />Erihika lɨno muthetsi mwashaba kɨndʉ mw'ɨtsɨna lyaye. Mʉshabe nemwe mwandahabwa, bʉshana olʉmogo lwenyu lubye lʉnene.<verse eid="JHN 16:24" /></para>
  <para style="s1">Yesʉ mwakinda ekɨhʉgo</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />«Monyababwire ebɨnwa byoshi ebyo mʉ mishinga. Hewethuwe kwandabya endambi nyɨthandashʉbe negena nemwe mʉ mishinga, nyandababwɨra emyatsɨ ya Thatha yo bʉrora-rora. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />Ekɨro ekyo mwandashaba Thatha mw'ɨtsɨna lyaye. Nyithababwire nyɨthɨ: nyandabashabɨra kʉ Thatha, <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />kʉshangwa Thatha yo wene-wene abatsiire. Abatsiire athyo, kʉshangwa momwanyɨtsɨɨra na momwɨkɨrɨtsya ko nyathokaga ewa Thatha. <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />Nyathokaga ewa Thatha, nangye monyahika mo kɨhʉgo kɨno, na lɨno enyɨthoka mo kɨhʉgo n'ɨshʉba ewa Thatha.» <verse eid="JHN 16:28" /><verse number="29" style="v" sid="JHN 16:29" /><char style="w" lemma="Abɨga">Abɨga</char> bʉwe mobamʉbwɨra bathɨ: «Lero, shʉnga ko wamanegena bʉrora-rora bʉtsɨra mishinga. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />Ewo ndɨ thwamamɨnya ko wetsi ebyoshi na kandɨ thʉthangashʉba kʉbʉtsya kɨndʉ. Bʉshana n'ekyo thwamɨkɨrɨtsya ko wathokaga ewa Gongo.» <verse eid="JHN 16:30" /><verse number="31" style="v" sid="JHN 16:31" />Yesʉ mwabʉtsyabo athɨ: «Mwamashala mwɨkɨrɨtsya?» <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />Mwonvwe! Endambi eyihika, na yamalire ihika, endambi eyo bandabapanza n'obʉlɨ mʉgʉma wa kw'imwe andashʉba mo nyʉmba yɨwe. Na mwandanyimika ingy'owene. Hewethuwe nyɨthalɨ ingy'owene, kʉshangwa Thatha alɨ hagʉma nangye. <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />Monyababwire ebɨnwa bɨno, bʉshana mubye na bʉholo mw'ibya mʉ bʉgʉma hagʉma nagye. Mwandagalwa mo kɨhʉgo kɨno, hewethuwe mʉyɨsɨngɨrɨke, kʉshangwa ingye nyamalire ikinda ebyoshi mo kɨhʉgo!<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">Yesʉ ashabɨra abɨga bʉwe</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />Yesʉ abere amamala ɨnegena ebɨnwa ebyo, mwashʉmbɨra amesho w'elʉbʉla n'ɨnegena athɨ: «Thatha endambi yamahika. Ʉhe Mʉgalawe yo <char style="w" lemma="lʉkengerwa">lʉkengerwa</char>, bʉshana Mʉgalawe naye kuthyo akanganie olʉkengerwa lwawe. <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />Kʉshangwa mowamʉha amaka ko bandʉ boshi, bʉshana ahe obʉyɨngo bw'ekera n'ekera abandʉ boshi wamʉhaga. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />N'obʉyɨngo bw'ekera n'ekera bo bʉno, bakʉmɨnye ɨwe Gongo mʉgʉma w'ekwenene, na bamɨnye Yesʉ Kirisito yo wathʉmaga. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />Ingye nyamakʉha olʉkengerwa mo kɨhʉgo, kʉshangwa nyamamala omʉlɨmo wo wanyɨhaga. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />Ewo mbe Thatha, ʉnyɨhe olʉkengerwa embere sawe, olʉkengerwa olo nyabyaga nalo hagʉma nawe embere ekɨhʉgo kɨhangɨkwe<note caller="+" style="f"><char style="fr" closed="false">17:5 </char><char style="ft" closed="false">Lingania na 1:1-2.</char></note>. <verse eid="JHN 17:5" /><verse number="6" style="v" sid="JHN 17:6" />Monyakangania erɨtsɨna lyawe ko bandʉ bo wathokaya mo kɨhʉgo, bʉshana n'ɨnyɨhabo. Abandʉ abo babyaga bʉwawe, nawe mowanyɨhabo, mobashikitsye eKɨnwa kyawe. <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />Bamalire ɨmɨnya kw'ebyoshi wanyɨhaga byathokaga ewawe, <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />Kʉshangwa monyahabo ebɨnwa byoshi wanyɨhaga, nabo mobangɨrɨrabyo. Betsi ko kwenene ko nyathokaga ewawe, nabo mobɨkɨrɨtsye ko n'ɨwe wo wanyɨthʉmaga. <verse eid="JHN 17:8" /><verse number="9" style="v" sid="JHN 17:9" />Nangye enyɨshabɨrabo, nyɨthalɨ enyɨshabɨra abandʉ b'omo kɨhʉgo kɨno, hewethuwe abo wanyɨhaga, kʉshangwa ɨbo nɨ bandʉ bawe. <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />Aho ebyoshi nyiwitheko nɨ bɨwawe, n'ebyoshi uwitheko nɨ bɨwaye, nangye nyamahalambwa mw'ɨtsʉkɨrabo. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />Ingye nyithishubabye mo kɨhʉgo kɨno, hewethuwe ɨbo balɨ mo kɨhʉgo kɨno. Thatha Mubuyirire, utheyebo ko maka w'erɨtsɨna lyawe, erɨtsɨna eryo wambaga, bʉshana babye mʉgʉma, ng'ɨwe nangye ko thʉlɨ mʉgʉma. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />Nyabere nyɨkɨnalɨ hagʉma nabo monyatheyabo mo maka w'erɨtsɨna lyawe, nalyo nɨ erɨtsɨna lyo wanyɨhaga. Monyatheyitsyebo na hathalɨ mʉgʉma wa kʉbo yo waheraga, athalɨ yo ʉtholere ɨhera, bʉshana aMashako Abuyirire aberere<note caller="+" style="f"><char style="fr" closed="false">17:12 </char><char style="ft" closed="false">Soma 13:18; Saburi 41:10.</char></note>. <verse eid="JHN 17:12" /><verse number="13" style="v" sid="JHN 17:13" />Ewo, lɨno nyashʉba ewawe, nangye nyamanegena ebɨnwa bɨno nɨ nyɨkɨnalɨ ko kɨhʉgo kɨno, bʉshana olʉmogo lwaye lʉnene kundu lubye emwishi sabo. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />Ingye nyamalire ɨfʉlɨrabo eKɨnwa kyawe, n'abandʉ b'ekɨhʉgo bamalire ɨbagabo, kʉshangwa ɨbo bathalɨ bandʉ b'omo kɨhʉgo, ng'ingye ko nyɨthalɨ w'omo kɨhʉgo kɨno. <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />Nyɨthalɨ enyɨshaba nyɨthɨ uthokyebo mo kɨhʉgo, hewethuwe nyɨthɨ utheyebo n'omukoli w'ebɨbɨ <char style="w" lemma="Sitani">Sitani</char><note caller="+" style="f"><char style="fr" closed="false">17:15 </char><char style="ft" closed="false">Soma Mat 6:13.</char></note>. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />Ɨbo bathalɨ b'omo kɨhʉgo ng'ingye ko nyɨthalɨ w'omo kɨhʉgo. <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />Wetsyebo mo kwenene, nɨ eKɨnwa kyawe yo kwenene. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />Nga ko wanyɨthʉmaga mo kɨhʉgo, nangye kuthyo nyamathʉmabo mo kɨhʉgo. <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />Nyamayihira mo minwe awe kundu, bʉshana nabo kuthyo bayihire mo minwe awe mo kundu-kundu. <verse eid="JHN 17:19" /><verse number="20" style="v" sid="JHN 17:20" />Nyɨthalɨ enyɨshabɨra aba kuroshi, hewethuwe enyɨshabɨra nabo bandɨkɨrɨtsya bʉshana n'amakangɨrɨtsya wabo. <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />Thatha, enyɨshaba bʉshana babye mʉgʉma ng'ɨwe ko ʉlɨ mw'ingye nangye nga ko nyɨrɨ mw'ɨwe, nabo babye mʉgʉma mw'ithwe, bʉshana abandʉ b'omo kɨhʉgo bɨkɨrɨtsye ko nɨ ɨwe wo wanyɨthʉmaga. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />Ingye monyahabo olʉkengerwa olo wanyɨhaga, bʉshana babye mʉgʉma nga kw'ɨwe nangye thʉlɨ mʉgʉma. <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />Enyɨshaba nyɨthɨ nyibye emwishi sabo, nawe ubye emwishi saye bʉshana babye mʉ bʉgʉma kwenene, bʉshana abandʉ b'omo kɨhʉgo bamɨnye ko kwenene ko nɨ ɨwe wanyɨthʉmaga na ko mowatsɨɨrabo nga ko wanyɨtsɨɨraga. <verse eid="JHN 17:23" /><verse number="24" style="v" sid="JHN 17:24" />Thatha, enyishondya nyɨthɨ: abo wanyɨhaga babye hagʉma nangye aho nyabya, na balole ko lʉkengerwa lwaye, nɨ olʉkengerwa olo wanyɨhaga, kʉshangwa mowanyɨtsɨɨra embere y'erɨhangɨkwa ly'ekɨhʉgo. <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />Thatha mʉthʉnganene, namo bandʉ b'ekɨhʉgo kɨno bathanakʉmɨnyaga, ingye monyakʉmɨnya. N'abandʉ aba mobamɨnya ko nɨ ɨwe wo wanyɨthʉmaga. <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />Monyakʉmɨnyɨsa kʉbo na nyagenda enyɨkʉmɨnyɨsa kʉbo, bʉshana olwanzo wanyanzagamo lubye mʉbo, na ingy'owene-wene nyibye emwishi sabo.»<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">Yesʉ atsɨmbwa</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mat 26:47-56</ref>; <ref loc="MRK 14:43-50">Mar 14:43-50</ref>; <ref loc="LUK 22:47-53">Luk 22:47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />Yesʉ abere amamala ɨnegena ebɨnwa ebyo, mwagenda hagʉma n'abɨga bʉwe, na mobashabʉkɨra eyishirya w'olwitsi lw'iKitironi. N'aboshi mobɨngɨra mw'ɨshwa lyo lyabyagayo. <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />Na Yuta yo wahotheraga Yesʉ, mwamɨnya aho Yesʉ abyaga, kʉshangwa agenda ahindana mw'ɨshwa eryo mo ngendo nyɨngɨ n'abɨga bʉwe<note caller="+" style="f"><char style="fr" closed="false">18:2 </char><char style="ft" closed="false">Soma Luk 21:37; 22:39.</char></note>. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />Aho, Yuta oyo mwaletha kɨkembe kya bashirikani ba baroma na batheya bagʉma b'eNyʉmba ya Gongo, abo babyaga nɨbamathʉmwa n'abaheri bakʉlʉ n'aBafarisayo. Na mwahika mw'ɨshwa hagʉma nabo. Bano babyaga bahekire bɨmole, na tara, na bɨmano bya malwa mo minwe yabo. <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />Kʉshangwa Yesʉ abyaga nietsi ebɨndʉ byoshi ebyo byamuhikira, mwagenderabo n'ɨbʉtsyabo athɨ: «Omushondya ndɨ?» <verse eid="JHN 18:4" /><verse number="5" style="v" sid="JHN 18:5" />Nabo mobamʉshʉbɨtsya bathɨ: «Yesʉ w'iNasareti<note caller="+" style="f"><char style="fr" closed="false">18:5 </char><char style="ft" closed="false">Ekɨnwa kyo kinegenire kɨthɨ: N'ingye, mo kikiriki kɨrɨ mo mʉlondo 4:26; 6:20; 8:24,28,58; 13:19; 18:6-8, Soma Ɨthoka 3:14-15, n'ebishakirwe.</char></note>.» Na Yesʉ mwabwɨrabo athɨ: «N'ingye.» Yuta yo wamʉhotheraga abyaga nimene aho hagʉma nabo. <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />Yesʉ abere abwɨrabo athɨ: «N'ingye», mobashʉba enyuma n'ɨwa ahishi. <verse eid="JHN 18:6" /><verse number="7" style="v" sid="JHN 18:7" />Mwabʉtsyabo athɨ: «Omushondya ndɨ?» Nabo mobashubya bathɨ: «Yesʉ w'iNasareti.» <verse eid="JHN 18:7" /><verse number="8" style="v" sid="JHN 18:8" />Yesʉ mwashʉbɨtsyabo athɨ: «Nyamalire ɨbabwɨra nyɨthɨ n'ingye. Na nyamabya n'ingye omushondya, mulike abo nyɨrɨ nabo aba bayɨgendere.» <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />Mwanegena athyo bʉshana bɨbererere ebɨnwa anegenaga athɨ: «Monyɨthahetsya n'omʉgʉma w'oko abo wanyɨhaga<note caller="+" style="f"><char style="fr" closed="false">18:9 </char><char style="ft" closed="false">Lingania 6:39; 17:12.</char></note>.» <verse eid="JHN 18:9" /><verse number="10" style="v" sid="JHN 18:10" />Aho, Simoni Petero abyaga niawithe ku muyali, mwashosholawo mo lʉba, na mwatsa okuthwi kw'amalyo kw'omukoli w'oMuheri Mʉkʉlʉ. Omukoli oyo agenda ahʉlwamo Malɨko. <verse eid="JHN 18:10" /><verse number="11" style="v" sid="JHN 18:11" />Hewethuwe Yesʉ mwabwɨra Petero athɨ: «Shubya omuyali awe w'omo lʉba. Ʉganɨtsya ʉthɨ nyɨthɨshome olwatha lw'amalɨgo lo Thatha anyɨhaga<note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">Soma Mat 26:39; Mar 14:36; Luk 22:42.</char></note>?» <verse eid="JHN 18:11" /><verse number="12" style="v" sid="JHN 18:12" />Ekɨkembe ky'abashirikani n'omʉkʉlʉ wabo, n'abatheya b'abakʉlʉ b'aBayuta mobatsɨmba Yesʉ n'ɨmʉmɨna. <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />Mobathanga ɨmʉthwala ewa Ana<note caller="+" style="f"><char style="fr" closed="false">18:13 </char><char style="ft" closed="false">Ana: Soma Luka 3:2 n'ebishakirwe.</char></note>. Ana oyo abyaga ishe-tsala wa Kayafa. Na Kayafa yo wabyaga Muheri Mʉkʉlʉ ko mwaka oyo. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />Ewo, ndɨ nɨ Kayafa yo wahanaga aBayuta athɨ: bikwirire mʉndʉ mʉgʉma nɨafwa bʉshana n'abandʉ boshi.<verse eid="JHN 18:14" /></para>
  <para style="s">Petero ayɨgana Yesʉ</para>
  <para style="r">(<ref loc="MAT 26:69-70">Mat 26:69-70</ref>; <ref loc="MRK 14:66-68">Mar 14:66-68</ref>; <ref loc="LUK 22:55-57">Luk 22:55-57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />Simoni Petero na ʉndɨ mwɨga mobakwama Yesʉ. Kʉshangwa oʉndɨ mwɨga oyo abyaga nietsibwe n'<char style="w" lemma="Muheri Mʉkʉlʉ">oMuheri Mʉkʉlʉ</char>, mwɨngɨra na Yesʉ mo nyʉmba y'<char style="w" lemma="Muheri Mʉkʉlʉ">oMuheri Mʉkʉlʉ</char> oyo. <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />Hewethuwe Petero ɨye mwimana embʉga hofɨ n'olukyo, oʉndɨ mwɨga oyo wabyaga nietsibwe n'oMuheri Mʉkʉlʉ, mwahʉlʉkɨra embʉga n'ɨthanga ɨsɨmola n'omʉkatsɨ mutheya w'olukyo, na mwɨngɨtsya Petero y'omo. <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />Omʉkatsɨ mutheya w'olukyo, mwabwɨra Petero athɨ: «Ɨwe nawe ʉthalɨ mʉgʉma w'oko bɨga b'omʉlʉme oyu?» Petero mwashubya athɨ: «Ɨhɨ, ingye nyɨthalɨ mwɨga ʉwe!» <verse eid="JHN 18:17" /><verse number="18" style="v" sid="JHN 18:18" />Abakoli n'abatheya babyaga nɨbamatsana mʉtsanwa, kʉshangwa ebɨro ebyo byabyaga bɨro bya mbeho, nabo babyaga nibimeneho nɨabotha ko mʉtsanwa. Petero naye abyaga nimene aho kuthyo alɨotha ko mʉtsanwa.<verse eid="JHN 18:18" /></para>
  <para style="s">oMuheri Mʉkʉlʉ athondesa Yesʉ</para>
  <para style="r">(<ref loc="MAT 26:59-66">Mat 26:59-66</ref>; <ref loc="MRK 14:55-64">Mar 14:55-64</ref>; <ref loc="LUK 22:66-71">Luk 22:66-71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />«<char style="w" lemma="Muheri Mʉkʉlʉ">oMuheri Mʉkʉlʉ</char> mwabʉtsya Yesʉ bʉshana n'abɨga bʉwe, na bʉshana n'amakangɨrɨtsya ʉwe.» <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />Yesʉ mwamʉshʉbɨtsya athɨ: «Nyagenda enyɨnegena n'abandʉ boshi bʉrora-rora, na nyagenda enyɨkangɨrɨtsya mo so <char style="w" lemma="sinakoki">sinakoki</char> na mo <char style="w" lemma="Nyʉmba ya Gongo">Nyʉmba ya Gongo</char>, aho aBayuta boshi abanahindana. Monyɨthanegena kɨndʉ mʉ bubisho-bisho.» <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />Ewono, bʉshana na ki oʉnyɨbʉtsya? Bʉtsya abo bagenda abanyɨhʉlɨkɨrɨtsya, kʉshangwa betsi kʉbʉya ebyo nyagenda enyɨnegena. <verse eid="JHN 18:21" /><verse number="22" style="v" sid="JHN 18:22" />Yesʉ abere alɨanegena ebyo, mʉgʉma wa ko batheya bo babyaga hofɨ naye, mwamʉbanda ikofi n'ɨnegena athɨ: «Nɨ bathyo ko wangashʉbɨtsya <char style="w" lemma="Muheri Mʉkʉlʉ">oMuheri Mʉkʉlʉ</char>?» <verse eid="JHN 18:22" /><verse number="23" style="v" sid="JHN 18:23" />Yesʉ mwashubya athɨ: «Nyɨrɨ nyamanegena kɨnwa kɨbɨ mukanganiekyo. Hewethuwe ebyo nyamanegena byamabya bya kwenene, bʉshana na ki wamanyihumba?» <verse eid="JHN 18:23" /><verse number="24" style="v" sid="JHN 18:24" />Honyuma kw'aho, Ana mwathʉma Yesʉ nianaminire ewa Kayafa <char style="w" lemma="Muheri Mʉkʉlʉ">Muheri Mʉkʉlʉ</char>.<verse eid="JHN 18:24" /></para>
  <para style="s">Simoni Petero ashʉba yɨgana Yesʉ</para>
  <para style="r">(<ref loc="MAT 26:71-75">Mat 26:71-75</ref>; <ref loc="MRK 14:69-72">Mar 14:69-72</ref>; <ref loc="LUK 22:58-62">Luk 22:58-62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />Mo ndambi eyo Simoni Petero abyaga nɨakɨnalɨ aho alɨotha ko mʉtsanwa. Mobamʉbʉtsya bathɨ: «Ndɨ nawe kuthyo ʉlɨ mʉgʉma w'oko bɨga b'omʉlʉme oyu!» Petero mwayɨgana athɨ: «Ɨhɨ! Ingye nyɨthalɨ mwɨga ʉwe.» <verse eid="JHN 18:25" /><verse number="26" style="v" sid="JHN 18:26" />Mukoli mʉgʉma w'oMuheri Mʉkʉlʉ yo wabyaga mʉgalabo yo Petero atsagako okuthwi, mwamʉbwɨra athɨ: «Ɨwe, monyɨthalɨ enyɨkʉshʉnga mw'ɨshwa hagʉma naye?» <verse eid="JHN 18:26" /><verse number="27" style="v" sid="JHN 18:27" />Petero mwashʉba yɨgana ɨye, aho n'aho embagatsɨ moyabɨka.<verse eid="JHN 18:27" /></para>
  <para style="s">Yesʉ athonda embere sa Pilato</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mat 27:1-2</ref>; <ref loc="MRK 15:1-5">Mar 15:1-5</ref>; <ref loc="LUK 23:1-5">Luk 23:1-5</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />Bwabere bwakya mo mambya, mobathokya Yesʉ yo ewa Kayafa n'ɨmʉthwala mo nyʉmba ya Kafʉrʉnalɨ. Hewethuwe aBayuta ɨbo mobathɨngɨra mo nyʉmba ya Kafʉrʉnalɨ, kʉshangwa bangingire mo nyʉmba eyo bangabere batsɨrene na bathangatholere irya ko linye ly'ePasaka. <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />Aho Pilato mweyabo embʉga, n'ɨbʉtsyabo athɨ: «Omusitaka omʉndʉ oyu bʉshana na ki?» <verse eid="JHN 18:29" /><verse number="30" style="v" sid="JHN 18:30" />Nabo mobashubya bathɨ: «Athangabere mukoli w'ebɨbɨ thuthangamulethire embere sawe.» <verse eid="JHN 18:30" /><verse number="31" style="v" sid="JHN 18:31" />Pilato mwabwɨrabo athɨ: «Imwe bene mʉmʉtsɨmbe na mʉmʉsohe ɨkwamana n'oMʉgomba enyu.» aBayuta nabo mobamʉshʉbɨtsya bathɨ: «Ithwe thuthahamulirwe itha mʉndʉ.» <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />Mobyakoleka bithyo, bʉshana bɨbererere ebɨnwa Yesʉ anegenaga kw'ikangania nga andafwa lʉholo lʉhɨ. <verse eid="JHN 18:32" /><verse number="33" style="v" sid="JHN 18:33" />Aho Pilato mwashʉba mo nyʉmba, mwabɨrɨkɨra Yesʉ n'ɨmʉbʉtsya athɨ: «Nɨ ɨwe wo mwamɨ w'aBayuta?» <verse eid="JHN 18:33" /><verse number="34" style="v" sid="JHN 18:34" />Yesʉ mwashubya athɨ: «Wamanegena uthyo ɨthoka mo mɨganɨtsye awe wowene kʉtse nɨ bandɨ bandʉ bo bamakʉbwɨra emyatsɨ aye?» <verse eid="JHN 18:34" /><verse number="35" style="v" sid="JHN 18:35" />Pilato mwashubya athɨ: «Ingye nyɨthalɨ Muyuta. Abandʉ b'omo kɨhʉgo kyenyu n'abaheri bakʉlʉ nɨ ɨbo bo bathanyɨrethera ɨwe. Moʉkola ki?» <verse eid="JHN 18:35" /><verse number="36" style="v" sid="JHN 18:36" />Yesʉ mwashubya athɨ: «oBwamɨ bwaye bʉthalɨ bw'oko kɨhʉgo kɨno, oBwamɨ bwaye bwangabere bw'oko kɨhʉgo kɨno, abakoli baye banganyilwire, kʉshangwa nyɨthahotherawa ko Bayuta. Hewethuwe oBwamɨ bwaye bʉthalɨ bwa hano ishi.» <verse eid="JHN 18:36" /><verse number="37" style="v" sid="JHN 18:37" />Aho Pilato mwamʉbwɨra athɨ: «Nɨ ɨnegena mbʉ ɨwe ʉlɨ mwamɨ?» Yesʉ mwamʉshʉbɨtsya athɨ: «Ɨwe wamanegena ʉthɨ nyɨrɨ Mwamɨ. Ingye monyabʉthwa bʉshana nyɨrethe butimo bw'ekwenene. Aboshi bo balɨ ko lʉnda lw'ekwenene abananyɨhʉlɨkɨrɨtsya.» <verse eid="JHN 18:37" /><verse number="38" style="v" sid="JHN 18:38" />Pilato mwamʉbʉtsya athɨ: «Ekwenene kyo ki?»</para>
  <para style="s" vid="JHN 18:38">Yesʉ asoherwa lʉholo</para>
  <para style="r" vid="JHN 18:38">(<ref loc="MAT 27:15-31">Mat 27:15-31</ref>; <ref loc="MRK 15:6-20">Mar 15:6-20</ref>; <ref loc="LUK 23:13-25">Luk 23:13-25</ref>)</para>
  <para style="p" vid="JHN 18:38">Pilato abere amamala ɨnegena ekɨnwa ekyo mwashʉba hʉlʉkɨra embʉga n'ɨbwɨra aBayuta athɨ: «Ingye nyithashungire ekyangaleka omʉndʉ oyu nɨasoherwa lʉholo. <verse eid="JHN 18:38" /><verse number="39" style="v" sid="JHN 18:39" />Hewethuwe ɨkwamana n'emɨbere enyu, nyɨbegere ɨbamɨnʉlɨra mʉndʉ mʉgʉma wa muliki mo kɨro ky'elinye ly'ePasaka. Ewono, omushondya nyɨbamɨnʉlɨre omwamɨ w'aBayuta?» <verse eid="JHN 18:39" /><verse number="40" style="v" sid="JHN 18:40" />Aho, mobahambala kʉtsɨbʉ bathɨ: «Thʉthalɨ othushondya omʉndʉ oyu! Othushondya ʉthʉmɨnʉlɨre Baraba!» Baraba oyo abyaga munyaguli.<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />Honyuma kw'aho, Pilato mwahamʉla athɨ batsɨmbe Yesʉ na bamuhireko mbasha. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />Honyuma w'erɨmʉshekeretsya, abashirikani mobalʉka kakira mʉ mʉthahɨ wa mʉthɨ alɨko mahwa n'imwambikyako ko muthwe. Na honyuma kw'aho mobamwambikya lʉkɨmba lwerʉ<note caller="+" style="f"><char style="fr" closed="false">19:2 </char><char style="ft" closed="false">Lʉkɨmba lwerʉ: Soma Mar 15:17 n'ebishakirwe.</char></note>. <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />Mobagenda abahika embere sɨwe nɨabanegena bathɨ: «Woyo he mbe mwamɨ w'aBayuta.» Nabo mobamʉbanda makofi. <verse eid="JHN 19:3" /><verse number="4" style="v" sid="JHN 19:4" />Pilato mwashʉba hʉlʉkɨra embʉga n'ɨbwɨra aBayuta athɨ: «Ɨngo, nyabalethera ɨye yo hano bʉshana mʉmɨnye ko ingye nyithashungire ekyangaleka nɨnyamʉsoha.» <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />Aho Yesʉ mwahʉlʉkɨra embʉga nianambithe akakira k'amahwa n'olʉkɨmba lwerʉ olo. Pilato mwabwɨra abandʉ athɨ: «Ewo, omʉndʉ enyu y'ono!» <verse eid="JHN 19:5" /><verse number="6" style="v" sid="JHN 19:6" />Hewethuwe <char style="w" lemma="baheri bakʉlʉ">abaheri bakʉlʉ</char> n'abatheya b'eNyʉmba ya Gongo babere bamʉshʉnga mobahambala bathɨ: «Mʉmʉbambe! Mʉmʉbambe!» Pilato mwashʉba bwɨrabo athɨ: «Mʉmʉheke imwe bene n'ɨyamʉbamba ko <char style="w" lemma="mʉsalaba">mʉsalaba</char>, kʉshangwa ingye nyithashungire ekyangaleka nɨasoherwa lʉholo.» <verse eid="JHN 19:6" /><verse number="7" style="v" sid="JHN 19:7" />Aho aBayuta mobamʉshʉbɨtsya bathɨ: «Thuwithe kʉ mʉgomba, ɨkwamana n'<char style="w" lemma="mʉgomba">omʉgomba</char> oyo, omʉndʉ oyu atholere ithwa, kʉshangwa mwayahʉlamo Mʉgala wa Gongo<note caller="+" style="f"><char style="fr" closed="false">19:7 </char><char style="ft" closed="false">Lingania na Balawi 24:16.</char></note>.» <verse eid="JHN 19:7" /><verse number="8" style="v" sid="JHN 19:8" />Pilato abere onvwa ebɨnwa ebyo mwashʉba ʉbaha kʉtsɨbʉ. <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />Mwashʉba ɨngɨra mo nyʉmba yɨwe n'ɨbʉtsya Yesʉ athɨ: «Mbe tha! Ɨwe ʉlɨ mbʉthɨrwa ya hayi?» Hewethuwe Yesʉ mwathamʉshʉbɨtsya kɨnwa. <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />Aho Pilato mwamʉbwɨra athɨ: «Uthalɨ ushondya ɨnyɨshʉbɨtsya? Ɨwe uthetsi ko nyiwithe amaka w'ɨkʉmɨnʉla n'amaka w'erɨkʉbamba ko mʉsalaba?» <verse eid="JHN 19:10" /><verse number="11" style="v" sid="JHN 19:11" />Yesʉ mwamʉshʉbɨtsya athɨ: «Ɨwe uthawithe maka woshi-woshi kw'ingye, athalɨ awo wahabawa na Gongo. Bʉshana n'ekyo oyo wanyɨhotheraga kw'ɨwe ahekire kɨtsɨbʉ kɨnene kʉtsɨbʉ.» <verse eid="JHN 19:11" /><verse number="12" style="v" sid="JHN 19:12" />Ɨthanga ko ndambi eyo Pilato mwashondya nga kw'angamɨnʉla Yesʉ. Hewethuwe aBayuta mobahambala kʉtsɨbʉ n'ɨnegena bathɨ: «Wanamamɨnʉla omʉndʉ oyu ɨwe nɨ ʉthalɨ mwira wa Kaisari! Bʉlɨ mʉndʉ yo ʉyahʉlamo mwamɨ nɨamathɨnda Kaisari.»<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />«Pilato abere onvwa ebɨnwa ebyo, mwahʉlʉkɨtsya Yesʉ y'embʉga, mwikala mo kifumbi ky'esohi, aho hanahʉlwa mo kɨebʉranɨa mo “Kabata” n'ɨnegena mbʉ mbʉga ilambikirwemo mabwe.» <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />Kyabyaga ekɨro ky'emɨlalɨtsye y'elinye ly'ePasaka ko saha ndathʉ sa kathi ka mwɨshɨ<note caller="+" style="f"><char style="fr" closed="false">19:14 </char><char style="ft" closed="false">Ekɨro ekyo kyabyaga mɨlalɨtsye y'elinye ly'ePasaka, kyo kɨro bagendaga abakera ebyana by'esombuli byo byabɨkɨrawa elinye ly'epasaka.</char></note>. Pilato mwabwɨra aBayuta athɨ: «Ɨngo, omwamɨ enyu yo yu!» <verse eid="JHN 19:14" /><verse number="15" style="v" sid="JHN 19:15" />Hewethuwe mobahambala bathɨ: Umwithe! Umwithe! Ʉmʉbambe ko mʉsalaba! Pilato mwabʉtsyabo athɨ: «Omushondya nyɨbambe omwamɨ enyu y'oko mʉsalaba?» Abaheri bakʉlʉ mobashubya bathɨ: «Thuthawithe ʉndɨ mwamɨ athalɨ Kaisari!» <verse eid="JHN 19:15" /><verse number="16" style="v" sid="JHN 19:16" />Aho Pilato mwamʉheretsyabo bʉshana bamʉbambe ko mʉsalaba.</para>
  <para style="s" vid="JHN 19:16">Yesʉ abambwa ko mʉsalaba</para>
  <para style="r" vid="JHN 19:16">(<ref loc="MAT 27:32-44">Mat 27:32-44</ref>; <ref loc="MRK 15:21-32">Mar 15:21-32</ref>; <ref loc="LUK 23:26-43">Luk 23:26-43</ref>)</para>
  <para style="p" vid="JHN 19:16">Aho, mobatsɨmba Yesʉ. <verse eid="JHN 19:16" /><verse number="17" style="v" sid="JHN 19:17" />«Yesʉ mwathoka mo muyi nianahekire omʉsalaba ʉwe ihika ahandʉ ho hanahʉlwamo Kahangali, mo kɨebʉranɨa nɨ Ngolingota.» <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />Honyuma kw'aho, abashirikani mobaya bamba Yesʉ ko mʉsalaba hagʉma n'abandɨ bithi babɨrɨ, mʉgʉma ko lʉhande lʉwe lwa malyo n'ogʉndɨ ko lwa malembe<note caller="+" style="f"><char style="fr" closed="false">19:18 </char><char style="ft" closed="false">Ngolongota nɨ kɨnwa kya mʉnegene w'ekɨgaramu: Nɨ negena mbʉ Kahangali. Kabyaga kathwa kalɨ hofɨ n'omuyi.</char></note>. <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />Pilato mwashaka mashako ku kɨshayɨ na mwahamʉla bahirekyo ko mʉsalaba. Amashako ayo abyaga anegenire athɨ: «Yesʉ w'iNasareti mwamɨ w'aBayuta.» <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />Bayuta bangɨ mobasoma amashako ayo kʉshangwa ahandʉ Yesʉ abambɨrawa ko mʉsalaba habyaga hofɨ n'omuyi. Amashako abyaga ashakirwe mʉ mɨnegene ishathu: Kɨebʉranɨa na Kilatini na Kikiriki. <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />Aho abaheri bakʉlʉ b'aBayʉta mobabwɨra Pilato bathɨ: «Ʉthashakaga ʉthɨ mwamɨ w'aBayuta, hewethuwe shaka uthya: omʉndʉ oyu ayahʉlamo mwamɨ w'aBayuta.» <verse eid="JHN 19:21" /><verse number="22" style="v" sid="JHN 19:22" />Pilato mwashubya athɨ: «Ebyo nyɨthashaka, byamalire ɨshakwa!» <verse eid="JHN 19:22" /><verse number="23" style="v" sid="JHN 19:23" />Abashirikani babere bamamala ɨbamba Yesʉ ko mʉsalaba, mobatsɨmba esongɨmba sɨwe n'ɨgabatho mo mɨhango ine, mobaha bʉlɨ mushirikani yo mʉhango mʉgʉma. Na kuthyo mobatsɨmba ekoti yɨwe yo yithabyagako mʉlando, yo yakomibawa mʉ lʉkɨmba lʉgʉmerera ɨthoka elʉgʉlʉ ihika ahishi. <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />Abashirikani mobabwɨrana bathɨ: «Thʉthaberengaga ekoti eno, hewethuwe thʉkolerero bwɨkɨ, bʉshana thʉmɨnye nga yabya ya ndɨ.» Ebyo mobyabya bithyo bʉshana abererere aMashako Abuyirire ow'anegenawa athɨ:</para>
  <para style="q1" vid="JHN 19:24">«Mobagabana esongɨmba saye</para>
  <para style="q1" vid="JHN 19:24">na mobakolera ekoti yo bwɨkɨ<note caller="+" style="f"><char style="fr" closed="false">19:24 </char><char style="ft" closed="false">Soma Saburi 22:19.</char></note>.»</para>
  <para style="m" vid="JHN 19:24">Ebyo byo abashirikani bakolaga.<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />Hofɨ n'omʉsalaba habyaga nihimene Marɨa nyinya wa Yesʉ hagʉma na mwalɨ wabo, na Marɨa mʉka Kiliopa na Marɨa w'ɨMangɨndala. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />Yesʉ abere ashʉnga nyinya n'omwɨga ʉwe yo abyaga atsiire imene hofɨ naye, mwabwɨra nyinya athɨ: «Malɨ, shʉnga mʉgala awe.» <verse eid="JHN 19:26" /><verse number="27" style="v" sid="JHN 19:27" />Honyuma kw'aho, Yesʉ mwabwɨra omwɨga ʉwe oyo athɨ: «Shʉnga nyoko.» Ɨthoka ko ndambi eyo omwɨga mwathwala Marɨa y'ewe.<verse eid="JHN 19:27" /></para>
  <para style="s">Lʉholo lwa Yesʉ</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mat 27:45-56</ref>; <ref loc="MRK 15:33-41">Mar 15:33-41</ref>; <ref loc="LUK 23:44-49">Luk 23:44-49</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />Honyuma kw'aho, kʉshangwa Yesʉ abyaga nietsi kw'ebyoshi byamabererera, mwanegena athya bʉshana aMashako Abuyirire abererere: «Nyamafwa nyotha.» <verse eid="JHN 19:28" /><verse number="29" style="v" sid="JHN 19:29" />Aho habyaga kɨrega kyabyagamo tifayi igayire. Aho abashirikani mobathobetsya kakɨmba mo tifayi eyo n'ɨmɨnɨrako kʉ mʉthahɨ wa hisopo n'ihirako ko bʉnʉ bʉwe. <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />Yesʉ abere amamala ɨmera etifayi eyo mwanegena athɨ: «Ebyoshi byamabererera.» Honyuma kw'aho mwinamya obʉsʉ bʉwe na mwatsa omʉthɨma<note caller="+" style="f"><char style="fr" closed="false">19:30 </char><char style="ft" closed="false">Lingania na Saburi 69:22 tifayi igayire, Mar 15:36 n'ebishakirwe.</char></note>.<verse eid="JHN 19:30" /></para>
  <para style="s">Omushirikani athobola olʉkanga lwa Yesʉ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />Ekɨro ekyo kyabyaga ky'emɨlalɨtsye y'eSabato. Bʉshana n'ekyo, abakʉlʉ b'aBayuta mobathashondya ebinda bibye nɨ bɨnalɨ ko mɨsalaba mo kɨro ky'eSabato, kʉshangwa ekɨro ekyo kyabyaga kɨro kɨkʉlʉ kʉtsɨbʉ. Bʉshana n'ekyo mobashaba Pilato ahamʉle bakonongole emɨhɨmbɨ y'abo bathabambwa ko mɨsalaba, nɨmo bafwa tsʉba n'ebinda byabo bithokibwe ko mɨsalaba. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />Aho abashirikani mobahika na mobakonongola emɨhɨmbɨ y'omʉndʉ mʉmbere na honyuma kw'aho mobakonongola emɨhɨmbɨ y'owa kabɨrɨ y'abo babambawa hagʉma na Yesʉ. <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />Hewethuwe babere bahika ko mɨhɨmbɨ ya Yesʉ, mobeya nɨamamala ɨfwa, bʉshana n'ekyo mobathakonongola emɨhɨmbɨ yɨwe. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />Hewethuwe mushirikani mʉgʉma mwahanda mʉ Yesʉ mw'ɨsɨnga mo lʉkanga, aho hahandawa erɨsɨnga mohahʉlʉka mʉsasɨ na metsi. <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />Oyo walolaga kw'ebyo yo waganʉlɨraga, n'obutimo bʉwe nɨ bwa kwenene. Kandɨ etsi kw'anegena ekwenene, bʉshana nemwe kuthyo mwɨkɨrɨtsye. <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />Ebyoshi ebyo mobyakoleka bʉshana abererere aMashako Abuyirire aw'anegenire athɨ: «Hathalɨ kiro n'ɨfʉha lɨwe lyo lyandakonolwa<note caller="+" style="f"><char style="fr" closed="false">19:36 </char><char style="ft" closed="false">Soma Isaya 12:46; Mɨganzo 9:12; Saburi 34:21.</char></note>.» <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />Kandɨ awandɨ Mashako Abuyirire anegenire athya: «Bandagʉsha amesho wabo w'oko yo bahandagamo erɨsɨnga.»<verse eid="JHN 19:37" /></para>
  <para style="s">Yesʉ athabwa</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mat 27:57-61</ref>; <ref loc="MRK 15:42-47">Mar 15:42-47</ref>; <ref loc="LUK 23:50-56">Luk 23:50-56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />Honyuma w'ebyoshi ebyo, Yosefʉ w'iArimatea mwashaba Herote yo hamuli y'ithokya ekinda kya Yesʉ ko mʉsalaba. Yosefʉ oyo abyaga mwɨga wa Yesʉ mu bubisho-bisho bʉshana abyaga niubahire aBayuta. Pilato mwatsɨga. Aho Yosefʉ mwagenda n'ithokya ekinda kya Yesʉ. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />Na Nikotemo yo wagenderaga Yesʉ mo kɨro, mwagenda hagʉma na Yosefʉ. Nikotemo oyo abyaga niahekire hofɨ bilo makumi ashathʉ bya mafʉta wa kabeho kakwirire, wo bakomaya mu ndulungane ya marasi na bubani. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />Ababɨrɨ boshi mobaheka omʉbɨrɨ wa Yesʉ, mobahirawo mʉ bɨtambara bihakabirwe mafʉtha alɨmo kabeho kakwirire ɨkwamana n'emɨbere y'erɨtha bandʉ ly'aBayuta. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />Hofɨ n'aho babambɨraga Yesʉ ko mʉsalaba habyaga ɨshwa. Na mw'ɨshwa eryo mwabyaga ɨsɨnda lihya-lihya lyo lyabyaga ni lithetsi lyathabwamo mʉndʉ. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />Kʉshangwa ekɨro ekyo kyabyaga nɨ ky'emɨlalɨtsye y'eSabato y'aBayuta, n'erɨsɨnda lyabyaga hofɨ, mobatha Yesʉ yo mʉlyo.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">Erilubuka lya Yesʉ</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mat 28:1-8</ref>; <ref loc="MRK 16:1-8">Mar 16:1-8</ref>; <ref loc="LUK 24:1-12">Luk 24:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />Moyenga mo mambya matsɨbʉ, kwabere kʉkɨnalɨ mwitsimya, Marɨa w'ɨMangɨndala mwaya kw'ɨsɨnda. Abere ahika eyo, mwalola kw'eribwe lyabyaga likingire olukyo lw'erɨsɨnda lyamalire ɨkʉmbagatsɨbwa. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />Aho mwangʉha eyɨrɨ Simoni Petero n'eyɨrɨ ogʉndɨ mwɨga yo wabyaga atsiirwe na Yesʉ n'ɨbwɨrabo athɨ: «Bamalire ithokya omʉbɨrɨ wa Nyinya-kowethʉ wo mw'ɨsɨnda na thuthetsi nga bathwerewo hayi.» <verse eid="JHN 20:2" /><verse number="3" style="v" sid="JHN 20:3" />Aho Petero n'ogʉndɨ mwɨga oyo, mobangʉha tsʉba n'ɨya kw'ɨsɨnda. <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />Ababɨrɨ boshi mobangʉha tsʉba nɨabathɨbɨtha, hewethuwe omwɨga oyo mwangʉha tsʉba kʉlenga Petero, mwamʉthanga kw'ɨsɨnda. <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />Ɨye mwunama n'ilungulira mw'ɨsɨnda, mwashʉnga ebɨtambara nibyamalire ihirwa emʉsɨke, hewethuwe mwathɨngɨra mʉlyo. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />Simoni Petero yo wabyaga enyuma, mwahika n'ɨngɨra mw'ɨsɨnda. Mwashʉnga ebɨtambara nibyamalire ihirwa emʉsɨke, <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />kuthyo mwashʉnga ekɨtambara kyabyaga kishwikire omuthwe wa Yesʉ, ekɨtambara ekyo mokithahirwa hagʉma n'ebɨndɨ. Hewethuwe kyabyaga nikitsingirwe n'ihirwa ɨkyo kyene emʉsɨke. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />Aho ogʉndɨ mwɨga yo wathangaga ihika kw'ɨsɨndana naye kuthyo mwɨngɨra mw'ɨsɨnda. Naye mwɨkɨrɨtsya abere amamala ɨyɨlolera. <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />Kʉshangwa ihika aho abɨga ba Yesʉ babyaga nibathetsi bamɨnya kw'aMashako Abuyirire owanegenire athɨ Yesʉ atholere ilubuka mo baholi<note caller="+" style="f"><char style="fr" closed="false">20:9 </char><char style="ft" closed="false">Soma Saburi 16:10.</char></note>. <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />Honyuma kw'aho, abɨga babɨrɨ abo mobashʉba ewabo.<verse eid="JHN 20:10" /></para>
  <para style="s">Yesʉ ahʉlʉkɨra Marɨa w'ɨMangɨndala</para>
  <para style="r">(<ref loc="MAT 28:9-10">Mat 28:9-10</ref>; <ref loc="MRK 16:9-11">Mar 16:9-11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />Mo ndambi eyo, Marɨa abyaga nimene embʉga hofɨ n'erɨsɨnda, alɨ alɨra. Abere anemʉlɨra, mwunama n'ilungulira mw'ɨsɨnda, <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />mwashʉnga bamalaɨka babɨrɨ bambithe ngɨmba sa mʉshohe nibikere ho mʉbɨrɨ wa Yesʉ abyaga abombekirwe. Omʉgʉma abyaga ikere ho habyaga omuthwe wa Yesʉ n'ogʉndɨ abyaga ikere ho habyaga ebɨshando bɨwe. <verse eid="JHN 20:12" /><verse number="13" style="v" sid="JHN 20:13" />Abamalaɨka abo mobamʉbʉtsya bathɨ: «Mbe mʉkatsɨ, ʉlɨra bʉshana na ki?» naye mwashʉbɨtsyabo athɨ: «Kʉshangwa bathokitsye omʉbɨrɨ wa Nyinya-kowethʉ, nangye nyithetsi nga bathwerewo hayi.» <verse eid="JHN 20:13" /><verse number="14" style="v" sid="JHN 20:14" />Abere amamala ɨnegena ebɨnwa ebyo, mwabɨndʉkɨra enyuma, mwashʉnga Yesʉ nimene aho, hewethuwe mwathamɨnya ko nɨ ɨye. <verse eid="JHN 20:14" /><verse number="15" style="v" sid="JHN 20:15" />Yesʉ mwamʉbʉtsya athɨ: «Mʉkatsɨ, ʉlɨra bʉshana na ki? Ushondya ndɨ?» Marɨa mwaganɨtsya athɨ kʉthɨ nɨ mulimi wa mw'ɨshwa eryo, mwamʉbwɨra athɨ: «Nyinya-kowethʉ, wamabya nɨ ɨwe wahekire omʉbɨrɨ ʉwe, unyikangye aho wahirirewo nangye nyendawo ho.» <verse eid="JHN 20:15" /><verse number="16" style="v" sid="JHN 20:16" />Yesʉ mwamʉbwɨra athɨ: «Marɨa!» Naye mwabɨndʉka, mwanegena mo kɨebʉranɨa athɨ: «Rabuni!» Nɨ ɨnegena mbʉ: «Mʉkangɨrɨtsya.» <verse eid="JHN 20:16" /><verse number="17" style="v" sid="JHN 20:17" />Yesʉ mwamʉbwɨra athɨ: «Ʉthanyɨkolagako<note caller="+" style="f"><char style="fr" closed="false">20:17</char><char style="ft" closed="false">Ʉthanyɨtsɨmbaga </char><char style="ft" closed="false">N'ɨnegena mbʉ </char><char style="fqa" closed="false">lika ɨnyɨfʉnderetsya </char><char style="ft" closed="false">: awandɨ Mashako anegenire athɨ: </char><char style="fqa" closed="false">Ʉthanyɨkolagako.</char></note>, kʉshangwa nyithetsi nyagenda ewa Thatha. Hewethuwe ʉgende eyɨrɨ bagala bethʉ ʉbwɨrebo ʉthɨ: enyɨrʉkɨra ewa Thatha, naye kuthyo nɨ Thatha wenyu, ɨye nɨ Gongo waye na kuthyo nɨ Gongo wenyu.» <verse eid="JHN 20:17" /><verse number="18" style="v" sid="JHN 20:18" />Aho Marɨa w'ɨMangɨndala mwayafʉlɨra <char style="w" lemma="abɨga">abɨga</char> bw'omwatsɨ kw'amashʉnga Nyinya-kowethʉ, na kw'amamʉbwɨra ebɨnwa ebyo.<verse eid="JHN 20:18" /></para>
  <para style="s">Yesʉ ahʉlʉkɨra abɨga bʉwe</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mat 28:16-20</ref>; <ref loc="MRK 16:14-18">Mar 16:14-18</ref>; <ref loc="LUK 24:36-49">Luk 24:36-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />Omw'igolo ly'ekɨro kɨsha-kɨsha ky'eyenga ekyo, abɨga mobahindana mʉ nyʉmba n'esonyuyi saro mosakɨngwa, kʉshangwa babyaga ni bubahire abakʉlʉ b'aBayuta. Aho n'aho Yesʉ mwahʉlʉkɨrabo n'imana mo kathi k'abo. Mwabwɨrabo athɨ: «Obʉholo bubye hagʉma nemwe!» <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />Abere amamala ɨnegena ebyo, mwakangyabo ebɨganza bɨwe n'olʉkanga lʉwe. Aho abɨga mobamoga babere bashʉnga Nyinya-kowethʉ. <verse eid="JHN 20:20" /><verse number="21" style="v" sid="JHN 20:21" />Yesʉ mwashʉba bwɨrabo athɨ: «Bʉholo kw'imwe! Nga ko Thatha anyɨthʉmaga, nangye kuthyo nyamabathʉma.» <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />Abere amamala ɨnegena ebɨnwa ebyo, mwabʉha kʉbo n'ɨbwɨrabo athɨ: «Mwangɨrɨre <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char>. <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />Abandʉ boshi mwandaganyɨra ebɨtsɨbʉ, bandaganyɨrwa. N'aboshi mʉthɨndaganyɨre bathɨndaganyɨrwe<note caller="+" style="f"><char style="fr" closed="false">20:23 </char><char style="ft" closed="false">Lingania na Mat 16:19; 18:18.</char></note>.»<verse eid="JHN 20:23" /></para>
  <para style="s">Yesʉ ayikangya kʉ Tomasɨ</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />Hewethuwe Tomasɨ yo ʉnahʉlwamo «mʉhasha» yo wabyaga mʉgʉma w'oko bɨga ikumi na babɨrɨ, athabyaga hagʉma nabo Yesʉ abere ahika. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />Abandɨ bɨga mobamʉbwɨra bathɨ: «Thwamashʉnga Nyinya-kowethʉ.» Hewethuwe Tomasɨ mwashʉbɨtsyabo athɨ: «Nyithashungire ko byuna by'emisumali mo bɨganza bɨwe, n'ihira omunwe aye mo byuna ebyo, na nyithingitsye omunwe aye mo lʉkanga lʉwe nyɨthangɨkɨrɨtsya na hake.» <verse eid="JHN 20:25" /><verse number="26" style="v" sid="JHN 20:26" />Honyuma kw'aho, habere hahwa yenga ngʉma, abɨga ba Yesʉ mobashʉba hindana mo nyʉmba ngʉmegerera eyo, lero Tomasɨ abyaga hagʉma nabo. Namo sonyuyi sabyaga nisinakingire, Yesʉ mwashʉba hʉlʉkɨrabo, mwimana mo kathi kabo n'ɨnegena athɨ: «bʉholo kw'imwe!» <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />Honyuma kw'aho, mwabwɨra Tomasɨ athɨ: «Hira omunwe awe wo hano na ʉshʉnge ko bɨganza byaye, na lambʉla okʉboko kwawe na uhire eminwe awe y'oko lʉkanga lwaye. Ʉthashʉba thɨka-thɨka, hewethuwe wɨkɨrɨtsye lero.» <verse eid="JHN 20:27" /><verse number="28" style="v" sid="JHN 20:28" />Tomasɨ mwashubya athɨ: «Nyinya-kowethʉ na Gongo waye!» <verse eid="JHN 20:28" /><verse number="29" style="v" sid="JHN 20:29" />Na Yesʉ mwamʉbwɨra athɨ: «Wamɨkɨrɨtsya kʉshangwa wamanyɨshʉngako? Bagashanɨrwe abo bɨkɨrɨtsya bathanyilolireko!»<verse eid="JHN 20:29" /></para>
  <para style="s">Omʉgasho w'ekɨtabʉ kɨno</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />Yesʉ mwakangania bɨndɨ bɨmɨnyɨkalo bɨngɨ ko bɨga bʉwe byo bithashakirwe mo kɨtabo kɨno. <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />Hewethuwe bɨno mobyashakwa bʉshana mwɨkɨrɨtsye ko Yesʉ nɨ Kirisito, Mʉgala wa Gongo, na mwɨkɨrɨtsye, mʉbone bʉyɨngo mw'ɨtsɨna lɨwe.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">Yesʉ ahʉlʉkɨra abɨga bʉwe ko ngetsɨ y'iTiberia</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />Honyuma w'ebyoshi ebyo Yesʉ mwashʉba hʉlʉkɨra abɨga bʉwe ko mʉsɨke w'engetsɨ y'iTiberia. Shʉnga nga kw'ahʉlʉkɨragabo: <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />Simoni Petero na Tomasɨ yo ʉnahʉlwamo mʉhasha na Natanaele w'omo muyi w'iKana y'iNgalilaya, n'abana ba Sebetayo, n'abandɨ bɨga babɨrɨ ba Yesʉ, aboshi babyaga hagʉma. <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />Simoni Petero mwabwɨra balikyabo athɨ: «Nyamayaroba.» Na balikyabo mobamʉbwɨra bathɨ: «Nethwe kuthyo thwagenda hagʉma nawe.» Aho mobagenda na mobashambɨra mo bwatho. Hewethuwe mo kɨro ekyo mobahɨna. <verse eid="JHN 21:3" /><verse number="4" style="v" sid="JHN 21:4" />Mo mambya matsɨbʉ Yesʉ mwashʉngɨka n'imene emʉsɨke w'engetsɨ, hewethuwe abɨga mobathamɨnya ko nɨ ɨye. <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />Aho Yesʉ mwabʉtsyabo athɨ: «Bana baye, mwanamitha ko mahere?» Mobamʉshʉbɨtsya bathɨ: «Kiro nako mbe thatha.» <verse eid="JHN 21:5" /><verse number="6" style="v" sid="JHN 21:6" />Yesʉ mwabwɨrabo athɨ: «Mʉgʉshe ehikira hyenyu hy'oko lʉnda lw'amalyo lw'obwatho, na mwitha ko mahere.» Aho mobagʉsha ehikira hyabo, nabo mobalemwa ɨkʉrahyo bʉshana n'obʉngɨ bw'amahere abyagamo. <verse eid="JHN 21:6" /><verse number="7" style="v" sid="JHN 21:7" />Aho omwɨga yo wabyaga atsiirwe na Yesʉ mwabwɨra Petero athɨ: «Ni Nyinya-kowethʉ.» Simoni Petero abere onvwa ko ni Nyinya-Kowethʉ, mwambala olʉkɨmba lʉwe kʉshangwa abyaga nɨalɨ ndumbu aho n'aho mwayɨgʉsha mo metsi. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />Abandɨ bɨga mobahika n'obwatho balɨ abakʉra ehikira hyo hyabyaga hyotswiremo amahere. Alɨbo, babyaga nɨbathakɨrɨ hale n'oko kyambʉ, habyaga nihakishia metere igana bʉsha nibahika ko kɨthaka. <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />Babere bahika ko kyambʉ n'ikimira ko kɨthaka, mobashʉnga makala wa mʉtsanwa alɨko mahere na mukati. <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />Yesʉ mwabwɨrabo athɨ: «Mʉlethe ko mahere mwamaroba.» <verse eid="JHN 21:10" /><verse number="11" style="v" sid="JHN 21:11" />Aho Simoni Petero mwashamba mo bwatho, na mwakʉra akakira ihika ko kɨthaka. N'akakira ako kabyaga nikotswiremo mahere manene-manene igana na makumi athano n'ashathʉ. Namo amahere anabyaga mangɨ akakira mokathabereka. <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />Yesʉ mwabwɨrabo athɨ: «Muhike mulye.» Mohathabya mwɨga n'omʉgʉma yo wamubutsaya ng'ɨye nɨ ndɨ, kʉshangwa mobamɨnya ko nɨ Nyinya-kowethʉ. <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />Aho Yesʉ mwayɨfʉnda hofɨ nabo, mwatsɨmba omukati, mwagabɨrawo kʉbo n'ɨgabɨrabo kuthyo n'amahere. <verse eid="JHN 21:13" /><verse number="14" style="v" sid="JHN 21:14" />Lɨno nɨ lya kashathʉ Yesʉ alɨahʉlʉkɨra abɨga bʉwe ɨthanga kw'ilubuka lɨwe.<verse eid="JHN 21:14" /></para>
  <para style="s">Yesʉ asɨmola na Petero</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />Babere bamamala irya, Yesʉ mwabʉtsya Simoni Petero athɨ: «Simoni mʉgala wa Yoani, unyitsiire kʉlenga aba?» Na Petero mwashubya athɨ: «Ega, mbe Nyinya-kowethʉ, wetsi kʉbʉya ko nyikutsiire!» Yesʉ mwamʉbwɨra athɨ: «Lishya esombuli saye.» <verse eid="JHN 21:15" /><verse number="16" style="v" sid="JHN 21:16" />Yesʉ mwamʉbʉtsya ngendo ya kabɨrɨ athɨ: «Simoni mʉgala wa Yoani, unyitsiire?» Naye mwamʉshʉbɨtsya athɨ: «Ega mbe Nyinya-kowethʉ wetsi ko nyikutsiire!» Yesʉ mwashʉba mʉbwɨra athɨ: «Lishya esombuli saye.» <verse eid="JHN 21:16" /><verse number="17" style="v" sid="JHN 21:17" />Honyuma kw'aho, Yesʉ mwamʉbʉtsya erya kashathʉ athɨ: «Simoni mʉgala wa Yoani, unanyitsiire?» Aho Petero mwahɨthana kʉshangwa Yesʉ mwamʉbʉtsya ngendo ishathu nga anamutsiire. Bʉshana n'ekyo, mwamʉshʉbɨtsya athɨ: «Nyinya-kowethʉ, wetsi ebyoshi, wetsi ko nyikutsiire!» Yesʉ mwamʉbwɨra athɨ: «Lishya esombuli saye<note caller="+" style="f"><char style="fr" closed="false">21:17 </char><char style="ft" closed="false">Lingania na Miko 20:28; 1Pet 5:2.</char></note>. <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />Enyɨkʉbwɨra ekwenene, wabere ʉkɨrɨ mʉtsana, wagenda uyambikya wowene n'ɨya ahoshi ushashire. Hewethuwe wandabya wabya mʉshyakʉlʉ, wandalambʉla okʉboko kwawe na ʉndɨ mʉndʉ yo wandakwambikya n'ɨkʉthwala eyo uthashashire.» <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />Yesʉ anegenaga ebɨnwa ebyo, mw'ikangania Petero nga andafwa lʉholo mʉhanda ki n'isingya Gongo mo lʉholo lʉwe. Honyuma kw'aho Yesʉ mwamʉbwɨra athɨ: «Ʉnyɨkwame<note caller="+" style="f"><char style="fr" closed="false">21:19 </char><char style="ft" closed="false">Ʉthʉbahaga: Soma Yoani 1:43.</char></note>!»<verse eid="JHN 21:19" /></para>
  <para style="s">Yesʉ n'omwɨga mʉtsɨɨrwa</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />Petero mwakebʉka na mwashʉnga omwɨga yo wabyaga niatsiirwe na Yesʉ. Omwɨga oyo yo wabyaga nɨagemere mo kɨfʉba kya Yesʉ balɨ abalya. Mwamʉbʉtsya athɨ: «Nyinya-kowethʉ, nɨ ndɨ yo wakʉhothera?» <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />Ewo, Petero abere amʉshʉnga mwabʉtsya Yesʉ athɨ: «Nyinya-kowethʉ, n'omʉndʉ oyu, iki kyo kyamuhikira?» <verse eid="JHN 21:21" /><verse number="22" style="v" sid="JHN 21:22" />Yesʉ mwamʉshʉbɨtsya athɨ: «Nyamashasha omʉndʉ oyu abyeho ihika ko kɨro nyandashʉbʉla, ebyo bithakulebitsye mbe Petero, ɨwe ʉnyɨkwame!» <verse eid="JHN 21:22" /><verse number="23" style="v" sid="JHN 21:23" />Aho, omwatsɨ ono mwaya ngʉlʉ mo bɨkɨrɨtsya boshi ba Yesʉ, kw'omwɨga yo utsiirwe na Yesʉ athɨndafwe. Yesʉ ɨye mwathanegena athɨ athɨndafwe, hewethuwe mwanegena athɨ: «Nyamashasha oyu abyeho ihika ko kɨro nyandashʉbʉla, ebyo bithakulebitsye.» <verse eid="JHN 21:23" /><verse number="24" style="v" sid="JHN 21:24" />Yo n'omwɨga oyo yo walethega butimo bw'ebɨnwa ebyo n'ɨshakabyo, nethwe thwetsi obutimo bʉwe ko nɨ bwa kwenene.<verse eid="JHN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />Halɨ bɨndʉ bɨngɨ byo Yesʉ akolaga. Hewethuwe ebyoshi byangashakirwe kɨgʉma kʉ kɨndɨ, enyɨganɨtsya ng'ekɨhʉgo kyoshi kɨthangabonekiremo mwanya w'erɨbɨkamo ebɨtabo byo byangashakirwe.<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>