<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="COL" style="id">- KOBO BIBLE TRANSLATION</book>
  <para style="h">Banyakolosayi</para>
  <para style="toc1">Marʉba wa Polo ko Banyakolosayi</para>
  <para style="toc2">Banyakolosayi</para>
  <para style="toc3">Kol</para>
  <para style="mt1">BANYAKOLOSAYI</para>
  <para style="imt" />
  <para style="imt">Kyɨngɨrɨro</para>
  <para style="ip">Kolosayi abyaga mʉrongo wa mo kɨhʉgo ky'iAsia Nge (bo Buturuki bw'iAsia ya munobwire). Ni muyi alɨ ku bilometere 200 n'obʉbʉkɨra ɨtsʉba bw'omuyi Efese. Alɨnga Polo mwathathanga ahika muwo. Ni mulikyabo Epafʉra muhimbani w'iKolosayi yo mumbere mbere wathwalagako Engulu Mbʉya (Col 1.7; 4.12).</para>
  <para style="ip">Polo abyaga mo muliki (4.3,10,18), kʉthɨ mw'ɨRoma naho, Epafura mwitsa mubwɨra ko Banyakolisayi abathɨmwa na bandʉ abaletha makangɨrɨtsya mahya mahya. Abandʉ abo abanakangɨrɨtsya bathɨ: erɨmɨnya Gongo n'erɨshabʉlwa ebishondya niwaramya batsɨmʉ n'ɨtsɨga mɨkolano mɨgʉma mɨgʉma ng'erimonibwa, ɨkwama amathegeko ow'elebitsye akalyo, eby'erɨshoma, n'ebɨndɨ n'ebɨndɨ. Omʉthʉmwa Polo abere onvwa omwatsɨ oyo, mwashakɨra banyaKolosayi bʉshana ibukyebo kw'obushabuli bo bʉthoka ewa Gongo ɨtsʉkɨra Yesu Kirisito butosire. Alinga athʉmaga amarʉba wo na Tisike bana Onesime (4.7,9).</para>
  <para style="ip">Abere amamala ɨketsyabo, mwakwamyaho mʉshabe w'ɨsima Gongo (1.1-14). Ekɨhande kɨmbere ekikangania ko Kirisito alɨ elʉgʉlʉ w'emɨtsɨmʉ yoshi, yo mʉkʉlʉ w'eKanisa (1.15–2.3).</para>
  <para style="ip">Honyuma kw'aho, mʉthʉmwa Polo mwabwɨra abo ashakɨra athɨ babye mesho bʉshana na bandʉ bagʉma bo bathulagania iKolosayi yo bɨnwa bihengemire (2.4-25).</para>
  <para style="ip">Ko nduli, ekɨhande kinyuma ekibukya emɨkolano y'obʉyɨngo buhya, obw'eribyaho hagʉma na Kirisito, mo lʉganda lw'abakirisito lo lwene-lwene na mo lʉganda na ko bandɨ bahimbani (3.1–4.6).</para>
  <para style="ip">Amarʉba ahwere na myatsɨ imulebitsye yowene, na ngetsyo ishakirwe n'eminwe yɨwe (4.7-18).</para>
  <para style="ip">Amakangɨrɨtsya mabɨ angahɨndʉka ko bʉlɨ mʉgʉlʉ. Na mw'erɨhɨndʉka eryo, bʉlɨ mʉhanda ashondya ithokya omwinihiro w'abɨkɨrɨtsya ku Kirisito. Kirisito yo ʉnaha abakobe bw'obwiranda bw'omʉthɨma.</para>
  <chapter number="1" style="c" sid="COL 1" />
  <para style="s">Ngetsyo</para>
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1" />Ingye Polo, nyɨrɨ<char style="w" lemma="Bathʉmwa">mʉthʉmwa</char> wa Yesʉ <char style="w" lemma="Kirisito">Kirisito</char> kw'ɨshasha lya Gongo. Ni ingye hagʉma na Timote mʉgala ethʉ, <verse eid="COL 1:1" /><verse number="2" style="v" sid="COL 1:2" />thwo thʉbashakɨra imwe bandʉ ba Gongo b'iyinihirwa bo balɨ iKolosayi. Mʉlɨ bagala bethʉ <char style="w" lemma="Mubuyirire">babuyirire</char>, mʉ Yesʉ Kirisito. Mubye n'olʉkogo n'obʉholo byo bɨthoka ewa Gongo Thatha.<verse eid="COL 1:2" /></para>
  <para style="s">Mʉshabe w'ɨsɨma Gongo</para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3" />Mo bʉlɨ ndambi othunabya thʉlɨ othʉbashabɨra, othʉnasɨma Gongo, Ishe wa Nyinya-kowethʉ Yesʉ <char style="w" lemma="Kirisito">Kirisito</char>. <verse eid="COL 1:3" /><verse number="4" style="v" sid="COL 1:4" />Othʉkola thuthyo, kʉshangwa mothwonvwa nɨabasɨmola ko lwɨkɨrɨtsyo lwenyu mʉ Yesʉ Kirisito na ko mutsiire abɨkɨrɨtsya boshi.<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">Soma 1Kor 13:13.</char></note> <verse eid="COL 1:4" /><verse number="5" style="v" sid="COL 1:5" />Ebyo bɨthokene n'omuyinihiro w'ebyo Gongo ababikire mo lʉbʉla. Omuyinihiro oyo, nɨ wo mwonvwaga balɨ abasɨmola bʉshana nawo mwabere mwafʉlɨrwa Engʉlʉ Mbʉya, eKɨnwa ky'ekwenene. <verse eid="COL 1:5" /><verse number="6" style="v" sid="COL 1:6" />Engʉlʉ Mbʉya eyɨkona malambo na eyɨheka biguma mo kɨhʉgo kyoshi, nga ko yakolaga mo kathi-kathi kenyu ɨthanga ekɨro mwonvwaga balɨ abafʉla omwatsɨ w'olʉkogo lwa Gongo n'ɨmɨnya ko nɨ bya kwenene. <verse eid="COL 1:6" /><verse number="7" style="v" sid="COL 1:7" />Nɨ Epafʉra mukoli mulikyethu mʉtsɨɨrwa yo wabakangɨrɨtsayabyo. Naye ni mukoli w'iyinihirwa wa <char style="w" lemma="Kirisito">Kirisito</char> bʉshana nemwe.<verse eid="COL 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 1:8" />N'ɨye yo wathʉganʉlɨra olwanzo lwenyu olo mwahabawa n'oMʉthɨma Mwerʉ. <verse eid="COL 1:8" /><verse number="9" style="v" sid="COL 1:9" />Nɨ bʉshana n'ekyo thʉthalɨ othulika erɨbashabɨra, ɨthanga ko kɨro thwonvwaga emyatsɨ enyu. Othʉnashaba Gongo abamɨnyɨse kʉbʉya erishondya lɨwe, ɨtsʉkɨra ko buthegekania n'obwenge bʉwe bo bʉnahanwa n'oMʉthɨma Mwerʉ. <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />Aho mwagenda omʉyɨwatha nga ko Nyinya-kowethʉ ashashire n'imumoya mo bɨndʉ byoshi. Bʉshana n'ekyo, mwandahika kw'ɨkola bɨbʉya n'ɨmɨnya Gongo yo kʉtsɨbʉ. <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" />Gongo agende abaha kagala mw'ɨtsʉkɨra amaka w'olʉkengerwa lʉwe, bʉshana mutsitsinie ko bʉlɨ kɨndʉ bʉthalʉha nɨmʉlɨ n'olʉmogo. <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />Mʉgende omʉsɨma Thatha Gongo yo wabahaga maka w'erɨshangɨra ko mwandʉ w'ababuyirire mo kyakakala. <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />Kʉshangwa mwathʉshabʉla ɨthoka mo maka w'omwitsimya n'ɨthwɨngɨtsya mo bwamɨ bwa Mʉgala ʉwe mʉtsɨɨrwa, <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" />nɨ kw'ɨye ko thwamashabʉlwa ɨthoka mo bɨbɨ na kuthyo ebɨtsɨbʉ byethʉ byamaganyɨrwa.<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">Soma Efe 1:7.</char></note><verse eid="COL 1:14" /></para>
  <para style="s">Obʉkʉlʉ bwa Kirisito</para>
  <para style="p">
    <verse number="15" style="v" sid="COL 1:15" />Kirisito ni shoshani ya Gongo yo ʉthashʉngɨka. Ɨye nɨ Kambere, mʉkʉlʉ mo byoshi byo bya bʉmbawa.<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">Soma Migani 8:32-36; Yoa 1:1-3.</char></note> <verse eid="COL 1:15" /><verse number="16" style="v" sid="COL 1:16" />Kʉshangwa nɨ kw'ɨmʉtsʉkɨra, ko Gongo abʉmbaga ebyoshi mo lʉbʉla na mo kɨhʉgo, ebyo bɨnashʉngɨka na byo bɨthalɨ ebɨnashʉngɨka. Bubye bwamɨ kʉtse bʉkʉlʉ, kʉtse buthegeki kʉtse maka. Gongo mwabʉmba ebyoshi kw'ɨtsʉkɨra Kirisito na bʉshana naye. <verse eid="COL 1:16" /><verse number="17" style="v" sid="COL 1:17" />Kirisito abyagaho embere w'ebɨndʉ byoshi, na nɨ kw'ɨye kw'ebɨndʉ byoshi bithondekire. <verse eid="COL 1:17" /><verse number="18" style="v" sid="COL 1:18" />Kirisito nɨ muthwe w'omʉbɨrɨ, n'omʉbɨrɨ oyo ni aKanisa. Ɨye nɨ ndangɨro, Kambere mo baholi, bʉshana abye mʉmbere mo byoshi. <verse eid="COL 1:18" /><verse number="19" style="v" sid="COL 1:19" />Kʉshangwa Gongo mwashʉnga kʉbʉya ɨye woshi abye mʉ Mʉgala. <verse eid="COL 1:19" /><verse number="20" style="v" sid="COL 1:20" />Na kw'ɨtsʉkɨra Kirisito, Gongo mwashondya ihindania abandʉ boshi hagʉma naye. Nɨ kw'ɨtsʉkɨra omʉsasɨ wa Mʉgala ow'asheshekaga ko<char style="w" lemma="mʉsalaba">mʉsalaba</char> mwaletha obʉholo ko bandʉ boshi, ibye ko kɨhʉgo, kʉtse mo lʉbʉla. <verse eid="COL 1:20" /><verse number="21" style="v" sid="COL 1:21" />Nemwe kera ndɨ mwabyaga hale na Gongo, na mwabyaga nzigu sɨwe bʉshana n'ebɨbɨ mwagenda omʉganɨtsya n'ɨkola. <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />Hewethuwe lɨno, Gongo mwabahindania n'ɨye yo wene ɨtsʉkɨra olʉholo lwa Mʉgala mo mʉbɨrɨ, bʉshana mʉshʉngɨke bandʉ <char style="w" lemma="Mubuyirire">babuyirire</char> embere sɨwe, bʉtsɨra bʉlema na bʉbɨ boshi-boshi. <verse eid="COL 1:22" /><verse number="23" style="v" sid="COL 1:23" />Hewethuwe bɨtholere nɨmwayɨtsɨnga ibya n'olwɨkɨrɨtsyo. Mushike na mubye ko mʉsɨngɨ ow'ashikire, muthamikaga omuyinihiro enyu ɨthanga ho mʉkonvwɨra Engʉlʉ Mbʉya, eyo yafʉlɨrwa ebɨhangɨkwa byoshi hano ishi. Nangye Polo monyayɨrwamo mukoli w'eNgʉlʉ Mbʉya eyo.<verse eid="COL 1:23" /></para>
  <para style="s">Erishondya lya Polo ko Banyakolosayi</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24" />Na lɨno nyɨmogere amalɨgo wo nyɨrɨ nawo bʉshana nemwe. Mw'ɨtsʉkɨra eryagalwa lyaye, enyɨbereretsya amalɨgo ow'ashakaga ko mʉbɨrɨ wa Kirisito, n'omʉbɨrɨ ʉwe nɨ aKanisa. <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />Nangye nyabere mukoli w'eKanisa ɨkwamana n'omʉlɨmo wo Gongo anyɨhaga bʉshana nemwe. Omʉlɨmo oyo, nɨerɨfʉla eKɨnwa kya Gongo mo kwenene. <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />Ekɨnwa ekyo nɨ olʉfʉmɨ lwa bishawa ɨthanga kera. Hewethuwe lɨno, amabishuliralo ko bandʉ bʉwe babuyirire. <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />Kʉshangwa Gongo mwashondya ibishula obushoki n'olʉkengerwa by'olʉfʉmɨ olo ko bandʉ b'ebɨhanda. N'ebyoshi ebyo binegenire bɨthɨ: Kirisito alɨ emwishi senyu, nɨ ɨye yo ʉbaha muyinihiro ko muwithe mʉhango ko lʉkengerwa lwa Gongo. <verse eid="COL 1:27" /><verse number="28" style="v" sid="COL 1:28" />Aho othʉkangɨrɨtsya abandʉ bo Kirisito. Othʉhana n'ɨkangɨrɨtsya bʉlɨ mʉndʉ mo buthegekania boshi, bʉshana n'ɨyɨra bʉlɨ mʉndʉ mo mwɨkɨrɨtsya na mʉthʉnganene mo bʉgʉma hagʉma na Kirisito. <verse eid="COL 1:28" /><verse number="29" style="v" sid="COL 1:29" />Na bʉshana n'ekyo, enyɨkola n'ɨyɨlwako mo kagala ko kathoka mu Kirisito. N'akagala ako, akakola n'amaka mw'ingye.<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1" />Enyishondya mʉmɨnye kw'enyɨyagatsya kʉtsɨbʉ bʉshana nemwe, na bʉshana n'abɨkɨrɨtsya b'iLaotikia, na bʉshana n'aboshi bo bathahera banyɨshʉngako. <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />Enyishondya nyɨthɨ emɨthɨma yabo yotsulemo muhwa, na bagende abatsɨɨrana mʉ bʉgʉma, na babone obushoki bwoshi bw'ekwenene bo bʉlethwa n'obwenge bulumirire bʉshana bamɨnye olʉfʉmɨ lwa Gongo. N'olʉfʉmɨ olo ni <char style="w" lemma="Kirisito">Kirisito</char> yowene-wene. <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />Kʉshangwa obushoki boshi bw'erithegekania na b'obwenge bibishirwe mw'Ɨye. <verse eid="COL 2:3" /><verse number="4" style="v" sid="COL 2:4" />Enyɨbabwɨra bɨno bʉshana omʉndʉ athabathɨmaga mo bɨnwa bɨwe by'ekishehya bya mabesɨ. <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />Na monyɨthanalɨ hagʉma nemwe mo mʉbɨrɨ, nyɨrɨ hagʉma nemwe mo mʉthɨma. Kandɨ nyimogire erɨbashʉnga ni mwimene n'ɨtsɨbʉhɨrɨra kʉbʉya mo lwɨkɨrɨtsyo lwenyu mʉ <char style="w" lemma="Kirisito">Kirisito</char>.<verse eid="COL 2:5" /></para>
  <para style="s">Obʉyɨngo thwabonaga mʉ Kirisito</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />Na kʉshangwa momwatsɨga Yesʉ <char style="w" lemma="Kirisito">Kirisito</char> nga Nyinya-kowethʉ, mubyeho mo bʉgʉma hagʉma naye. <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />Mulashye mirihi mw'ɨye, na muhire obʉyɨngo bwenyu boshi mw'ɨye. Mwimane kʉbʉya ebɨro byoshi mo lwɨkɨrɨtsyo ɨkwamana n'amakangɨrɨtsya mwahabawa. Na mubye bandʉ b'erɨsɨma kʉtsɨbʉ. <verse eid="COL 2:7" /><verse number="8" style="v" sid="COL 2:8" />Mubye mesho. Hathabyaga mʉndʉ w'ɨbathɨma mo bwenge bʉwe bwa mabesɨ magegene. Yo uyinihire emɨbere y'abandʉ n'emɨtsɨmʉ mɨbɨ yo yɨthegeka ekɨhʉgo, hewethuwe ɨthagemere ko makangɨrɨtsya wa <char style="w" lemma="Kirisito">Kirisito</char>. <verse eid="COL 2:8" /><verse number="9" style="v" sid="COL 2:9" />Kʉshangwa Gongo ɨye woshi alɨ mʉ Kirisito, emwishi s'omʉbɨrɨ ʉwe, <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />nemwe kw'ɨtsʉkɨra Ɨye momwahabwa obʉthʉnganene. Ɨye nɨ mʉkʉlʉ w'obuthegeki boshi n'amaka woshi. <verse eid="COL 2:10" /><verse number="11" style="v" sid="COL 2:11" />Mw'ibya mo bʉgʉma naye mwamalire ɨmona. Lɨthalɨ imonibwa na minwe ya bandʉ, hewethuwe mwamamonibwa na <char style="w" lemma="Kirisito">Kirisito</char>, n'erimonibwa eryo, lyamabashabʉla ɨthoka mo mɨbere enyu y'obʉthethera bw'omʉbɨrɨ. <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" />Aho, mwabere mwabatisibwa, mo mwathabwa hagʉma na Kirisito, na kuthyo mo mwalubuka hagʉma naye. Kʉshangwa momwɨkɨrɨtsya amaka wa Gongo wa mulubukaya mo baholi.<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">Soma Bar 6:4.</char></note> <verse eid="COL 2:12" /><verse number="13" style="v" sid="COL 2:13" />Kera mwabyaga baholi bʉshana n'ebɨbɨ byenyu, mwabyaga bandʉ bathamwene, kandɨ bandʉ b'ebɨhanda. Hewethuwe lɨno Gongo mwabalubukya hagʉma na Kirisito. Mwathʉganyɨra ebɨbɨ byethʉ byoshi. <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" />Mwaberenga amarʉba w'eminda y'ebɨbɨ byethʉ n'amathegeko ow'abyaga athusitakire, mwatsimyawo kundu mw'ɨkongomererabyo ko <char style="w">mʉsalaba</char>. <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />Nɨ bathyo ko Gongo ashamʉlaga amaka w'abakʉlʉ n'awabathegeki, mwahemʉlabo embere s'abandʉ mw'ɨkʉrabo nga bandʉ ba muliki, kinzekule ky'erɨsɨndana lya Mʉgala ʉwe. <verse eid="COL 2:15" /><verse number="16" style="v" sid="COL 2:16" />Aho, kuthabyaga mʉndʉ yo wabasoha bʉshana n'ebyo omulya kʉtse ebyo omʉshoma kʉtse linye, kʉtse linye lya mwetsɨ muhya kʉtse kɨro<char style="w" lemma="Sabato">kya Sabato</char>.<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">Soma Rom 14:1-6.</char></note> <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />Ebɨndʉ byoshi ebyo ni kithuthu ky'ebɨndʉ byo bihika, hewethuwe ekwenene y'ebyoshi ebyo ni <char style="w" lemma="Kirisito">Kirisito</char>. <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />Mʉthatsɨgaga ɨsohwa na mʉndʉ woshi-woshi yo uyikangya ko nɨ mʉlonvʉ, n'oyo uramya abamalaɨka. Omʉndʉ w'omʉhanda oyo ayɨkethere ebyo athashʉnga mo humanani, naye ayɨhala bʉsha, bʉshana n'emɨganɨtsye yɨwe nga mʉndʉ, <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" />omʉndʉ oyo athalɨ kʉ Kirisito, na Kirisito oyo yo muthwe w'omʉbɨrɨ. Ni ko bushondoli bʉwe, kw'omʉbɨrɨ woshi analɨsɨbwa kʉbʉya n'ihindanibwa hagʉma ly'ebɨthambo n'emiki yawo, nawo niabya nga ko Gongo ashondya.<verse eid="COL 2:19" /></para>
  <para style="s">Ɨfwa n'ibyaho hagʉma na Kirisito</para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20" />Momwafwa hagʉma na <char style="w" lemma="Kirisito">Kirisito</char> n'ɨshabʉlwa ɨthoka mo kagala k'emɨtsɨmʉ ya hano ishi<note caller="+" style="f"><char style="fr" closed="false">2:20 </char><char style="ft" closed="false">Soma Ngal 4:3 n'ebishakire.</char></note>. Ewono, bʉshana na ki omʉshʉbabya ng'abandʉ b'omo kɨhʉgo kɨno mʉlɨ omʉkwama amathegeko alɨ ng'ano? <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />«Mʉthawathaga kw'eki», «mʉthagetsyaga kɨra», «mʉthakolaga kw'eki.» <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />Ebyoshi ebyo nɨ bɨndʉ ebɨnabɨha byakolesɨbwa, ebyo ni hamuli na makangɨrɨtsya w'abandʉ. <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />Kwenene eso hamuli etho esɨnashʉngɨka nga sa buthegekania kʉshangwa sɨthokene n'eriramya lya abandʉ abo, hagʉma n'obʉlonvʉ bwabo n'esohamuli sabo s'erɨgatsya omʉbɨrɨ. Hewethuwe sithawithe kagala k'ɨkakɨtsya eso ngʉmbʉ s'omʉbɨrɨ.<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1" />Kʉshangwa mwamalire ilubukibwa ɨthoka mo baholi n'ibyaho hagʉma na <char style="w" lemma="Kirisito">Kirisito</char>, ewo mʉgende omushondya ebɨndʉ bɨrɨ elʉgʉlʉ, eyo <char style="w" lemma="Kirisito">Kirisito</char> ikere ko malyo wa Gongo. <verse eid="COL 3:1" /><verse number="2" style="v" sid="COL 3:2" />Mʉgende omushondya ebɨndʉ bɨrɨ elʉgʉlʉ, hewethuwe mʉthagenda omushondya ebɨndʉ bya hano ishi. <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />Kʉshangwa mʉlɨ baholi, n'obʉyɨngo bwenyu bubishirwe hagʉma na <char style="w" lemma="Kirisito">Kirisito</char> mʉ Gongo. <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />Obʉyɨngo bwenyu bw'ekwenene nɨ <char style="w" lemma="Kirisito">Kirisito</char>, n'ekɨro andahʉlʉka nemwe kuthyo mwandahʉlʉka hagʉma naye mo lʉkengerwa lʉwe.<verse eid="COL 3:4" /></para>
  <para style="s">Obʉyɨngo bwa kera n'obuhya-buhya</para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5" />Aho mwithe ebyoshi bya hano ishi ebɨrɨ mw'imwe: Orʉsɨngɨ, emɨkonzɨ, mɨganɨtsye mɨbɨ, ngʉmbʉ nyɨbɨ, n'erɨtsɨɨra esofaranga so kʉtsɨbʉ, nalyo lɨrɨngene n'eriramya ebishoshani. <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />Nɨ ebɨbɨ bɨrɨ ng'ebyo byo bɨnaletha obʉhɨthane bwa Gongo ko bandʉ bo bathamushikitsye. <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />Muthyo ko mwagenda omʉyɨwatha kera, mwabere mʉkɨnathegekawa n'ebɨtsɨbʉ. <verse eid="COL 3:7" /><verse number="8" style="v" sid="COL 3:8" />Hewethuwe lɨno, nemwe kuthyo, mʉthɨnde ebɨndʉ byoshi bɨno: obʉhɨthane, ɨhɨthɨkɨrana n'obʉbɨ, ɨlega mʉndʉ kʉtse ebɨnwa bɨthatholere bɨthathokaga mo mʉnʉ enyu. <verse eid="COL 3:8" /><verse number="9" style="v" sid="COL 3:9" />Mʉthahambɨkanaga imwe kw'imwe, kʉshangwa imwe mwamalire ithokya omʉndʉ wa kera hagʉma n'emɨbere yɨwe yoshi. <verse eid="COL 3:9" /><verse number="10" style="v" sid="COL 3:10" />Kuthyo mwamalire ɨambala omʉndʉ muhya-muhya yo Gongo Muhangiki ethʉ anagenda ahɨndʉla, bʉshana mʉmʉmɨnye kʉbʉya-kʉbʉya. <verse eid="COL 3:10" /><verse number="11" style="v" sid="COL 3:11" />Aho, hathakɨrɨ ndondogoli mo kathi k'abandʉ b'ebɨhanda n'aBayuta, bo bamwene na bo bathamwene, abageni, abasenzi, abakobe na bo bathalɨ bakobe. Hewethuwe <char style="w" lemma="Kirisito">Kirisito</char> yo byoshi naye alɨ mo bandʉ boshi. <verse eid="COL 3:11" /><verse number="12" style="v" sid="COL 3:12" />Bʉshana n'ekyo, kʉshangwa imwe mʉlɨ bandʉ ba Gongo babuyirire, ɨye mwabwanza n'ɨbashombola bʉshana naye yowene. Bʉshana n'ekyo, mubye na mʉthɨma w'eshashi, na bʉbʉya, n'eriyihohya, n'obʉlonvʉ, n'erishikya omʉthɨma. <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" />Mʉthagenda omʉkwamɨrɨrana na mʉgende omʉganyɨrana imwe kw'imwe, na mʉndʉ amabya na kɨnwa ky'erisitakira mulikyabo, mʉganyɨrane imwe kw'imwe, nga ko Nyinya-kowethʉ abaganyɨraga<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">Soma Mat 6:12-14.</char></note>. <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />Na kalengyo ko bɨnwa byoshi ebi, mubye n'olwanzo, kʉshangwa olwanzo lolunahindania abandʉ babye mo bʉgʉma obʉthʉnganene. <verse eid="COL 3:14" /><verse number="15" style="v" sid="COL 3:15" />N'obʉholo bwa <char style="w" lemma="Kirisito">Kirisito</char> bwikale mo mɨthɨma enyu. Na bʉshana n'obʉholo obo, Gongo mwababɨrɨkɨra ibya nga bɨthambo bya mʉbɨrɨ mʉgʉma. Na mubye bandʉ b'erɨsɨma. <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" />Ekɨnwa kya <char style="w" lemma="Kirisito">Kirisito</char> kibye mo mɨthɨma enyu hagʉma n'obushoki bʉwe bwoshi. Mukangiritsanie n'ɨhanana mo buthegekania bwoshi. Mwimbire Gongo yo nyimbo mo mɨthɨma enyu yoshi hagʉma n'ɨmʉsɨma mo sosaburi na mo nyimbo s'erisingya na mo nyimbo so sɨshondolerwe n'oMʉthɨma Mwerʉ.<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">Soma Efe 5:19-20.</char></note> <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />Bʉlɨ kɨndʉ kyo mʉnegena kʉtse ky'omʉkola, mʉkole ebyoshi mw'ɨtsɨna lya Nyinya-kowethʉ Yesʉ mw'ɨsɨma Gongo Thatha ɨtsʉkɨra Kirisito.<verse eid="COL 3:17" /></para>
  <para style="s">Ebɨtholere ɨkolwa mo bʉyɨngo buhya-buhya</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18" />Imwe bakatsɨ, mʉgende omushikya abw'iba enyu, nga ko lɨtholere embere sa Nyinya-kowethʉ. <verse eid="COL 3:18" /><verse number="19" style="v" sid="COL 3:19" />Nemwe bayira, mʉtsɨɨre abakatsɨ benyu, mʉthagenda omʉkaramɨrabo. <verse eid="COL 3:19" /><verse number="20" style="v" sid="COL 3:20" />Imwe bana mʉgende omushikya ababuthi benyu mo byoshi, kʉshangwa ekyo ekinamoya Gongo. <verse eid="COL 3:20" /><verse number="21" style="v" sid="COL 3:21" />Nemwe bo thatha mʉthagenda omuhithania abana benyu, bʉshana bathalemerawa. <verse eid="COL 3:21" /><verse number="22" style="v" sid="COL 3:22" />Nemwe bakobe mʉgende omushikya abo nyinya-kowenyu ba hano ishi mo byoshi. Mʉthakolaga muthyo mo ndambi babashungire mw'imoyabo, he mushikyebo n'omʉthɨma akwirire, bʉshana n'olushikyo lo mʉlɨ nalo kʉ Nyinya-kowethʉ. <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />Na bʉlɨ kɨndʉ omʉkola, mʉkolekyo na mʉthɨma akwirire, nga bandʉ bo bakolera Nyinya-kowethʉ, hewethuwe bo bathalɨ abakolera bandʉ. <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />Mwɨbʉke ko Nyinya-kowethʉ andabaha olʉhembo abikire abandʉ bʉwe<note caller="+" style="f"><char style="fr" closed="false">3:24 </char><char style="ft" closed="false">Soma Ngal 4:1-2.</char></note>. Kʉshangwa <char style="w" lemma="Kirisito">Kirisito</char> yo Nyinya-kowethʉ w'ekwenene yo mʉkolera. <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" />Hewethuwe yo ʉkola ebɨbɨ andahembwa ɨkwamana n'ebɨbɨ akolaga, kʉshangwa Gongo athathondogola<note caller="+" style="f"><char style="fr" closed="false">3:25 </char><char style="ft" closed="false">Soma Ɨbʉka mɨgomba 10:17.</char></note>.<verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1" />Nemwe mo muwithe ko bakobe, mʉgende omʉkolerabo mo bʉthʉnganene na mo kwenene. Mwɨbʉke ko nemwe muwithe Nyinya-kowenyu mo lʉbʉla.<verse eid="COL 4:1" /></para>
  <para style="s">Bɨlayɨro</para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />Mʉyɨtsɨnge ko mɨshabe. Mʉlɨ omʉshaba, mubye mesho n'ɨsɨma Gongo. <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />Na kuthyo mʉthʉshabɨre bʉshana Gongo athʉkɨngʉlɨre enzɨra y'erɨkangɨrɨtsya ekɨnwa kɨwe, n'ikumbula olʉfʉmɨ lwa <char style="w" lemma="Kirisito">Kirisito</char>. Nɨ bʉshana n'ebyo nyɨrɨ mʉndʉ wa muliki lɨno. <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />Aho mʉnyɨshabɨre bʉshana nyikotsye ɨgenda enyɨnegena ko lʉfʉmɨ n'ikanganialo kʉbʉya-kʉbʉya nga ko nyihamulirwe. <verse eid="COL 4:4" /><verse number="5" style="v" sid="COL 4:5" />Mʉgende n'obwenge embere s'abo bathalɨ bakirisito, n'ɨkolesa endambi muwithe yo kʉbʉya. <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />Ebɨnwa byenyu bɨgende ebibya bɨbʉya ebɨro byoshi na byo bɨtholere, na mʉgende omʉmɨnya erɨshʉbɨtsya obʉlɨ mʉndʉ yo kʉbʉya.<verse eid="COL 4:6" /></para>
  <para style="s">Engetsyo nyɨtsɨndʉ</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />Mʉgala ethʉ mʉtsɨɨrwa ye Tikiko, mukoli mulikyethu w'iyinihirwa yo thʉkola naye omʉlɨmo wa Nyinya-kowethʉ, andabafʉlɨra omwatsɨ aye woshi. <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />Nyabathʉmɨra ɨye bʉshana abafʉlɨre emyatsɨ ethʉ n'ibashikya mɨthɨma. <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" />Aherekeretsɨbwe na Onesime<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="fq" closed="false">Onesime </char><char style="ft" closed="false">: Soma Fil 1:10-15.</char></note>, mʉgala ethʉ mʉtsɨɨrwa na w'iyinihirwa, ɨye nɨ mʉgʉma wa mw'imwe. N'ɨbo bo bababwɨra ebɨnwa byoshi byo bɨtsʉka hano. <verse eid="COL 4:9" /><verse number="10" style="v" sid="COL 4:10" />Sɨtarɨko y'uminirwe hagʉma nagye, amabaketsya. Na kuthyo Marɨko, mʉsara wa Barɨnaba naye abaketsya<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="fq" closed="false">Sɨtarɨko </char><char style="ft" closed="false">: Soma mɨko 19:29; 27:2; </char><char style="fq" closed="false">Marɨko </char><char style="ft" closed="false">: Soma Mɨko 12:12-25; 13:13; 15:37-39. </char><char style="fq" closed="false">Barɨnaba </char><char style="ft" closed="false">: Soma Mɨko 9:27; 11:22-30.</char></note>. Mwamalire ɨthegekwa bʉshana naye, amahika kowenyu ni mwamukokya kʉbʉya. <verse eid="COL 4:10" /><verse number="11" style="v" sid="COL 4:11" />Na Yesʉ y'ʉnahʉlwamo Yʉsʉto, naye kuthyo abaketsya. Abandʉ bashathʉ abo basha bona bakirisito bo bathoka mo Bayuta bo bakola hagʉma nangye bʉshana <char style="w" lemma="Bwamɨ bwa Gongo">n'obwamɨ bwa Gongo</char>. Nabo abanyishikya mʉthɨma kʉtsɨbʉ. <verse eid="COL 4:11" /><verse number="12" style="v" sid="COL 4:12" />Na Epafʉra<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="ft" closed="false">Soma 1:7.</char></note> mbʉthɨrwa y'okowenyu naye abaketsya. Naye ni omukoli wa Yesʉ <char style="w" lemma="Kirisito">Kirisito</char> athalɨ alʉha mw'ɨbashabɨra bʉshana mʉtsɨbʉhe na mubye bandʉ bashikire kʉbʉya mo bɨnwa bya Gongo, na mʉgende omʉkola erishondya lya Gongo. <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />Nyɨrɨ mutimo w'ebyo akola, ayinubya mw'ɨkola mʉlɨmo n'omuhwa mʉngɨ bʉshana nemwe na bʉshana n'abagala bethʉ b'iLaotikia na b'iHierapoli<note caller="+" style="f"><char style="fr" closed="false">4:13 </char><char style="fq" closed="false">Laotikia </char><char style="ft" closed="false">na </char><char style="fq" closed="false">Hierapoli </char><char style="ft" closed="false">yabyaga miyi ibiri yɨrɨ hagʉma n'iKolosayi, kuthyo yabyaga mw'ibanda lya Lukasi.</char></note>. <verse eid="COL 4:13" /><verse number="14" style="v" sid="COL 4:14" />Omʉshake Luka mwira ethʉ na Tema ababaketsya<note caller="+" style="f"><char style="fr" closed="false">4:14 </char><char style="fq" closed="false">Luka </char><char style="ft" closed="false">: Soma 2Tim 4:11; Fil 1:24. </char><char style="fq" closed="false">Tema </char><char style="ft" closed="false">: Soma 2Tim 4:10; Fil 1:24.</char></note> <verse eid="COL 4:14" /><verse number="15" style="v" sid="COL 4:15" />Mʉketsye bagala bethʉ na balɨ bethʉ bɨkɨrɨtsya b'iLaotikia, na Nimufa na akanisa ko kanahindana mo nyʉmba yɨwe. <verse eid="COL 4:15" /><verse number="16" style="v" sid="COL 4:16" />Amarʉba ano abya amamala ɨsomwa kowenyu, mʉkole kagala kenyu koshi, amarʉba ayo ayasomerwe na mo kanisa k'iLaotikia. Nemwe kuthyo mʉsome amarʉba wo athathoka iLaotikia. <verse eid="COL 4:16" /><verse number="17" style="v" sid="COL 4:17" />Mʉbwɨre ye Arikipo mʉthɨ akole kʉbʉya omʉlɨmo ahabawa na Nyinya-kowethʉ. <verse eid="COL 4:17" /><verse number="18" style="v" sid="COL 4:18" />Ingye Polo nyamabathʉmɨra engetsyo aye, eyo nyamashaka mo minwe aye ingy'owene. Mʉthɨbɨrɨrawa ko nyikinaminire. Olʉkogo lwa Gongo lubye hagʉma nemwe.<verse eid="COL 4:18" /></para>
  <chapter eid="COL 4" />
</usx>