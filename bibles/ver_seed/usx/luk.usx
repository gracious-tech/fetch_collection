<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LUK" style="id">LUKA</book>
  <para style="h">LUKA</para>
  <para style="toc3">Luk</para>
  <para style="toc2">Luka</para>
  <para style="toc1">eNgʉlʉ Mbʉya ya Yesʉ Kirisito nga ko yashakawa na Luka</para>
  <para style="mt2">eNgʉlʉ Mbʉya ya Yesʉ Kirisito nga ko yashakawa na</para>
  <para style="mt1">Luka</para>
  <para style="imt">Ekyɨngɨrɨro</para>
  <para style="ip">Ni Luka yo washakaga ekɨtabo kɨno. Abyaga mʉshake, kandɨ athabyaga Muyuta. Mwashaka ekɨtabo kɨno mo maha w'erɨfʉlɨra abandʉ b'ebɨhanda bw'eNgʉlʉ Mbʉya y'obushabuli ɨtsʉkɨra kʉ Yesʉ Kirisito. Nɨna Luka oyo yo washakaga ekɨtabo ky'eMɨkolano y'aBathʉmwa. Luka mwathashʉnga kʉ Yesʉ, hewethuwe mwabʉlɨrɨtsya omwatsɨ w'obʉyɨngo bwa Yesʉ ko bandʉ bo babyaga hagʉma naye (soma Luka 1:1-3).</para>
  <para style="ip">Mo kɨtabo kɨno Luka akangania ko Yesʉ Kirisito yo Mʉgala w'oMʉndʉ yo wahikaga ishondya n'ɨshabʉla abandʉ bo babyaga nɨ baherire (soma Luka 19:10). Kandɨ Luka akangania ko Yesʉ agenda akangania eshashi ko bandʉ basunzuyirwe nga: abatsene n'abakatsɨ n'abana. Kandɨ Luka anegena bʉshana n'omʉlɨmo w'oMʉthɨma Mwerʉ mo byo Yesʉ agenda akola.</para>
  <para style="ip">Nɨ ekɨtabo kya Luka kyo kɨre kʉlenga ebɨtabo byoshi by'omo Ndagane Nyihya. Mw'ɨthanga ekɨtabo kɨno, Luka asonzomola bɨnwa bɨngɨ byo bɨsɨmolera erɨbʉthwa lya Yesʉ (soma Luka 1–2), ashʉba negena bʉshana n'ekithunga kya Yesʉ (soma Luka 3:23-38). Kandɨ anegena ko lubatiso lwa Yesʉ (soma Luka 3:21), n'erɨlengwako lɨwe n'eSitani (soma Luka 4:1-13). Ashʉba negena bʉshana n'omʉlɨmo wa Yesʉ (soma Luka 4–21), n'erɨbambwa lɨwe ko mʉsalaba (soma Luka 22–23), n'erilubuka lɨwe (soma Luka 24).</para>
  <para style="ip">Honyuma kw'aho Luka anegena nga ko Yesʉ ayikangaya ngendo kangɨ kangɨ ko bɨga bʉwe amamala ilubuka. Mwathegekaniabo ko mʉlɨmo w'erɨfʉlɨra abandʉ bw'eNgʉlʉ Mbʉya. Ko nduli anegena kw'ɨrʉka lya Yesʉ mo lʉbʉla (soma Luka 24:50-51).</para>
  <para style="iot">Ebyo bɨrɨmo</para>
  <para style="io1">a) Ebɨnwa by'endangɨro (1:1-4)</para>
  <para style="io1">b) Erɨbʉthwa lya Yesʉ n'obwana bʉwe (1:5–2:52)</para>
  <para style="io1">c) Omʉlɨmo wa Yoani Mubatisya n'ɨrengwako lya Yesʉ (3:1–4:13)</para>
  <para style="io1">d) Yesʉ akangɨrɨtsya bʉshana n'oBwamɨ bwa Gongo n'ɨkola ebɨthɨko-thɨko mo kɨhʉgo ky'iNgalilaya (4:14–9:50)</para>
  <para style="io1">e) Yesʉ akangɨrɨtsya bɨngɨ bʉshana n'abo bagenda abashondya ɨmʉkwama, abere alɨ mo nzɨra y'erɨrʉkɨra ɨYerʉsalemʉ (9:51–19:27)</para>
  <para style="io1">f) Yesʉ ɨngɨra mo muyi w'ɨYerʉsalemʉ n'ɨkangɨrɨtsya bʉshana n'ebɨro by'enduli (19:28–21:38)</para>
  <para style="io1">g) Lʉholo lwa Yesʉ (22:1–23:56)</para>
  <para style="io1">h) Ilubuka lya Yesʉ (24:1-53)</para>
  <chapter number="1" style="c" sid="LUK 1" />
  <para style="s">Endangɨro y'ebɨnwa bya Yesʉ Kirisito</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1" />Mʉkengwa Teofili, halɨ bandʉ bangɨ mobayɨrenga ɨshaka ɨkwamana n'ebɨnwa byatsʉkaga mo kathi kethʉ. <verse eid="LUK 1:1" /><verse number="2" style="v" sid="LUK 1:2" />Abo bashakaga abo mobaganʉlɨra kundu ng'oko abakoli ba Yesʉ <char style="w" lemma="Kirisito, Masia">Kirisito</char> bathʉbwɨraga. Abakoli abo nɨ abo bayɨloleraga ko byoshi byo Yesʉ akolaga mo mesho wabo ho bɨkathangɨra. Nɨ ɨbo bo bafʉlaga eNgʉlʉ Mbʉya ya Gongo. <verse eid="LUK 1:2" /><verse number="3" style="v" sid="LUK 1:3" />Nangye monyayɨthegeretsye kʉtsɨbʉ ebɨnwa byoshi bya Yesʉ ɨthoka ko byathangaga. Bʉshana n'ebyo, nyamashʉnga mʉkengwa Teofili, nyɨkʉshakɨre ebɨnwa byoshi ebyo mw'ɨthondeka. <verse eid="LUK 1:3" /><verse number="4" style="v" sid="LUK 1:4" />Enyɨkʉshakɨra kʉshangwa ʉmɨnye ekwenene y'amakangɨrɨtsya wakangɨrɨtsɨbawa.<verse eid="LUK 1:4" /></para>
  <para style="s">Mwatsɨ w'erɨbʉthwa lya Yoani Mubatisya</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5" />Mo mʉgʉlʉ <char style="w">Herote</char> abyaga mwamɨ w'omo kɨhʉgo ky'iYuteya, habyaga mʉndʉ mʉgʉma erɨtsɨna lɨwe nɨ yo Sakarɨa. Sakarɨa oyo abyaga mʉgʉma w'oko <char style="w" lemma="Muheri">baheri</char> w'omo kɨkembe kya Abia. Mʉkatsɨwe Lisabeti abyaga w'oko lʉganda lwa Haruni.<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="fq" closed="false">Haruni </char><char style="ft" closed="false">abyaga muheri mʉmbere w'aBaisiraeli.</char></note> <verse eid="LUK 1:5" /><verse number="6" style="v" sid="LUK 1:6" />Sakarɨa na Lisabeti babyaga bathʉnganene embere sa Gongo. Nibakwamire kundu <char style="w" lemma="Mathegeko">amathegeko</char> wa Nyinya-kowethʉ n'ɨkola nga kw'anegenire. <verse eid="LUK 1:6" /><verse number="7" style="v" sid="LUK 1:7" />Hewethuwe babyaga nibathawithe kʉ mwana kʉshangwa Lisabeti abyaga mʉgʉmba. Kandɨ ababɨrɨ boshi nɨbahera bakʉlʉ-kʉlʉ kʉtsɨbʉ.<verse eid="LUK 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8" />Kɨro kɨgʉma Sakarɨa agenda akola omʉlɨmo ʉwe <char style="w" lemma="Muheri">w'obuheri</char> mo <char style="w">Nyʉmba ya Gongo</char>, kʉshangwa lwabyaga lʉhɨtsyo lw'omo kɨkembe kyabo ky'ɨkola mʉlɨmo. <verse eid="LUK 1:8" /><verse number="9" style="v" sid="LUK 1:9" />Omw'ɨkwamana n'emɨtsyo <char style="w" lemma="Muheri">y'abaheri</char>, Sakarɨa yo washombolawa mʉ bwɨkɨ kʉshangwa ɨngɨre mo <char style="w" lemma="Nyʉmba ya Gongo:">Nyʉmba ya Nyinya-kowethʉ</char> oketsyemo obubani.<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="xt" closed="false">Soma <ref loc="EXO 30:7-8">Ɨthoka 30:7-8</ref>.</char></note> <verse eid="LUK 1:9" /><verse number="10" style="v" sid="LUK 1:10" />Mo ndambi Sakarɨa agenda okya <char style="w" lemma="Bubani">obubani</char>, abandʉ boshi babyaga embʉga nɨabashaba Gongo.<verse eid="LUK 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 1:11" />Honyuma kw'aho <char style="w">malaɨka</char> mʉgʉma wa Nyinya-kowethʉ mwabʉthʉkɨra Sakarɨa, mwimana ko malyo <char style="w" lemma="Bʉtara bw'ɨhererako">w'obʉtara</char><note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">Obʉtara bw'ɨhererako bw'aBayuta bwabyaga bwa mabwe.</char></note> bw'ɨhererako <char style="w" lemma="Bubani">obubani</char>. <verse eid="LUK 1:11" /><verse number="12" style="v" sid="LUK 1:12" />Sakarɨa abere amʉlolako mwashalima, mwʉbaha kʉtsɨbʉ. <verse eid="LUK 1:12" /><verse number="13" style="v" sid="LUK 1:13" />Hewethuwe <char style="w">malaɨka</char> oyo mwamʉbwɨra athɨ: «Ʉthʉbahaga mbe Sakarɨa kʉshangwa Gongo amonvwa emɨshabe awe. Mʉkatsɨ awe Lisabeti andakʉbʉthɨra mwana wa bʉtsana wandamʉlʉkamo Yoani. <verse eid="LUK 1:13" /><verse number="14" style="v" sid="LUK 1:14" />Omwana oyo andaleka niwabya na lʉmogo lʉnene, na bandʉ bangɨ bandamogera erɨbʉthwa lɨwe. <verse eid="LUK 1:14" /><verse number="15" style="v" sid="LUK 1:15" />Kʉshangwa andabya mʉkʉlʉ embere sa Nyinya-kowethʉ, athɨndashome <char style="w" lemma="Tifayi:">tifayi</char> kʉtse wandɨ mafʉ w'ikundya.<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="xt" closed="false">Soma <ref loc="NUM 6:3">Mɨganzo 6:3</ref>.</char></note> Andabya akɨnalɨ mo nda ya nyinya ʉwe, andashondolwa <char style="w" lemma="Mʉthɨma Mwerʉ">n'oMʉthɨma Mwerʉ</char>. <verse eid="LUK 1:15" /><verse number="16" style="v" sid="LUK 1:16" />Andaleka <char style="w" lemma="Isiraeli">Baisiraeli</char> bangɨ nɨbashʉbɨra Nyinya-kowethʉ Gongo wabo.<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="xt" closed="false">Soma <ref loc="MAL 2:6">Malaki 2:6</ref>.</char></note> <verse eid="LUK 1:16" /><verse number="17" style="v" sid="LUK 1:17" />Andahika nga mʉthʉmwa wa Gongo, andabya n'omʉthɨma na maka nga Elia <char style="w">mʉmɨnyeretsɨ</char>. Bʉshana n'ɨletha abana bahʉlɨkɨrɨrane n'obwishe. Kandɨ ahɨndʉle abandʉ bobanathɨnda ebɨnwa bya Gongo nɨmo babya n'obwenge ng'abandʉ bathʉnganene embere sa Gongo.<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="xt" closed="false">Soma <ref loc="MAL 3:23-24">Malaki 3:23-24</ref> </char><char style="ft" closed="false">kʉtse Malaki 4:5-6.</char></note> Mw'ebyo andathegekanɨtsya Nyinya-kowethʉ yo bandʉ abayithegekenie imukokya.»<verse eid="LUK 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18" />Hewethuwe Sakarɨa mwabʉtsya <char style="w" lemma="Malaɨka">omʉmalaɨka</char> oyo athɨ: «Nyamɨnya nyɨthɨ kw'ebyo nɨ bya kwenene? Kʉshangwa ingye nyahera mʉshyakʉlʉ na mʉkatsɨ aye naye ahera mʉkekʉlʉ.» <verse eid="LUK 1:18" /><verse number="19" style="v" sid="LUK 1:19" /><char style="w">Malaɨka</char> mwamʉshʉbɨtsya athɨ: «Ingye ngyo Ngabulieri,<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="xt" closed="false">Soma <ref loc="DAN 8:16">Ndanieli 8:16</ref>; <ref loc="DAN 9:21">9:21</ref>; <ref loc="LUK 1:26">Luka 1:26</ref>.</char></note> n'ingye ngyo nyinimana embere sa Gongo. Ɨye yo wamanyɨthʉma kw'ɨwe nyɨkʉbwɨre n'ɨkʉfʉlɨra <char style="w" lemma="Ngʉlʉ Mbʉya">engʉlʉ mbʉya</char> eyi. <verse eid="LUK 1:19" /><verse number="20" style="v" sid="LUK 1:20" />Onvwa! Ebɨnwa ebyo byandabererera ko ndambi yilayirwe. Kʉshangwa moʉthɨkɨrɨtsye ebɨnwa ebyo, wabya kɨtsɨrʉ. Uthikotsye ɨshʉba negena ihika ekɨro ebɨnwa ebi byandabererera.»<verse eid="LUK 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21" />Omo ndambi eyo abandʉ babyaga balindirire Sakarɨa mobashweka kw'amaherera mo <char style="w" lemma="Nyʉmba ya Gongo:">Nyʉmba ya Gongo</char> ndambi nyɨre. <verse eid="LUK 1:21" /><verse number="22" style="v" sid="LUK 1:22" />Sakarɨa abere athokamo mwathakotsya ɨnegena. Mwagenda anegena nabo mo minwe, kʉshangwa niamabya kɨtsɨrʉ. Aho abandʉ mobamɨnya ko mwashʉnga humanani mo <char style="w" lemma="Nyʉmba ya Gongo:">Nyʉmba ya Gongo</char>.<verse eid="LUK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23" />Sakarɨa abere amamala ebɨro bɨwe by'erɨkola mo <char style="w">Nyʉmba ya Gongo</char>, mwashʉba ewe.<verse eid="LUK 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 1:24" />Honyuma w'ebɨro ebyo, mʉkatsɨwe Lisabeti mwaheka bʉkʉle. Mwamala myetsɨ ithano bʉthahʉlʉka. Naye agenda anegena athɨ: <verse eid="LUK 1:24" /><verse number="25" style="v" sid="LUK 1:25" />«Shʉnga ebɨbʉya Nyinya-kowethʉ amanyɨkolera! Mwanyithokyako esoshoni s'obʉgʉmba embere s'abandʉ.»<verse eid="LUK 1:25" /></para>
  <para style="s">Mwatsɨ w'erɨbʉthwa lya Yesʉ</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26" />Ko mʉgʉlʉ obʉkʉle bwa Lisabeti bwabere bwahika ko mwetsɨ w'endathʉ, Gongo mwathʉma <char style="w">malaɨka</char> Ngabulieri mo muyi w'iNasareti, mo kɨhʉgo ky'iNgalilaya, <verse eid="LUK 1:26" /><verse number="27" style="v" sid="LUK 1:27" />ko mʉnyere mʉgʉma agenda ahʉlwamo Marɨa. Marɨa oyo agenda athahibwa na muyira mʉgʉma nɨ yo Yosefʉ, w'omo lʉganda lw'omwamɨ <char style="w">Tawiti</char>. <verse eid="LUK 1:27" /><verse number="28" style="v" sid="LUK 1:28" />Malaɨka oyo mwahika ho Marɨa abyaga n'ɨmʉketsya athɨ: «Bwakyere he Marɨa! Moga! Nyinya-kowethʉ mwakʉha lʉkogo kandɨ alɨ hagʉma nawe.»<figure style="fig" alt="L'ange dit a Marie qu'elle va engendrer Jesus" file="DN00401b.tif" size="span" ref="1:28">Malaɨka afʉlɨra Marɨa yo mwatsɨ kw'ɨye yo wabʉtha Yesʉ</figure> <verse eid="LUK 1:28" /><verse number="29" style="v" sid="LUK 1:29" />Marɨa abere onvwa ekɨnwa eki mwahononokala. Mwathanga ɨyɨbʉtsya athɨ: «Engetsyo eyi inegenire yithi ki?»<verse eid="LUK 1:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 1:30" />He <char style="w">malaɨka</char> mwamʉbwɨra athɨ: «Marɨa ʉthʉbahaga kʉshangwa Gongo amakʉha lʉkogo. <verse eid="LUK 1:30" /><verse number="31" style="v" sid="LUK 1:31" />Waheka bʉkʉle, wandabʉtha mwana wa bʉtsana, wandamʉlʉkamo Yesʉ. <verse eid="LUK 1:31" /><verse number="32" style="v" sid="LUK 1:32" />Andabya mʉkʉlʉ na andahʉlwamo <char style="w">Mʉgala wa Gongo</char> yo ʉlɨ elʉgʉlʉ w'ebyoshi. Na Nyinya-kowethʉ Gongo andamʉha obwamɨ bwa <char style="w">Tawiti</char> ishe-kʉlʉ ʉwe. <verse eid="LUK 1:32" /><verse number="33" style="v" sid="LUK 1:33" />Andathegeka aBaisiraeli bo kera na kera, n'obuthegeki bʉwe bʉthɨndahwe.»<verse eid="LUK 1:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34" />Marɨa mwabʉtsya <char style="w">malaɨka</char> athɨ: «Ebi bya thokekana bɨthɨ ingye Nyithetsi nyamɨnya bayira?» <verse eid="LUK 1:34" /><verse number="35" style="v" sid="LUK 1:35" /><char style="w">Malaɨka</char> mwamʉshʉbɨtsya athɨ: «<char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> andakukimirako, n'akagala ka Gongo w'elʉgʉlʉ w'ebyoshi kandakʉshwɨka ng'ekithuthu. Bʉshana n'eki omwana wandabʉtha andabya <char style="w">mubuyirire</char> kandɨ andahʉlwamo <char style="w">Mʉgala wa Gongo</char>. <verse eid="LUK 1:35" /><verse number="36" style="v" sid="LUK 1:36" />Hene, Lisabeti w'omo lʉganda lwawe, na mwanahera mʉkekʉlʉ kandɨ yo wabyaga mʉgʉmba naye nɨ mʉkʉle wa myetsɨ ndathʉ alindire ɨbʉtha mwana wa bʉtsana. <verse eid="LUK 1:36" /><verse number="37" style="v" sid="LUK 1:37" />Kʉshangwa hathalɨ kyo kɨnalemana embere sa Gongo.»<verse eid="LUK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38" />Aho, Marɨa mwanegena athɨ: «Ingye nyɨrɨ mukoli wa Nyinya-kowethʉ, binyibyeko nga ko ʉthanegena.» Honyuma kw'aho <char style="w">malaɨka</char> mwayɨgendera.<verse eid="LUK 1:38" /></para>
  <para style="s">Marɨa aya lungula Lisabeti</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39" />Mo bɨro ebyo Marɨa mwahuthuka n'ɨya mo kɨhʉgo ky'ebɨthwa mwahika mʉ muyi mʉgʉma w'iYuteya. <verse eid="LUK 1:39" /><verse number="40" style="v" sid="LUK 1:40" />Abere ahikayo mwɨngɨra mo nyʉmba ya Sakarɨa n'ɨketsya Lisabeti. <verse eid="LUK 1:40" /><verse number="41" style="v" sid="LUK 1:41" />Lisabeti abere onvwa engetsyo ya Marɨa, obʉkʉle bʉwe mobwashatha mo nda yɨwe. Mwashondolwa <char style="w" lemma="Mʉthɨma Mwerʉ">n'oMʉthɨma Mwerʉ</char>. <verse eid="LUK 1:41" /><verse number="42" style="v" sid="LUK 1:42" />Mwahambala n'ɨbwɨra Marɨa athɨ: «Gongo amakʉha lʉkogo kʉlenga abakatsɨ boshi. N'omwana wandabʉtha naye amagashanɨrwa! <verse eid="LUK 1:42" /><verse number="43" style="v" sid="LUK 1:43" />Nyɨrɨ ndɨ w'ilungulwa na nyinya wa Nyinya-kowethʉ? <verse eid="LUK 1:43" /><verse number="44" style="v" sid="LUK 1:44" />Kʉshangwa mo ndambi nyɨthonvwa engetsyo awe obʉkʉle mobʉshatha n'olʉmogo mo nda aye. <verse eid="LUK 1:44" /><verse number="45" style="v" sid="LUK 1:45" />Wamagashanɨrwa kʉshangwa mowɨkɨrɨtsya ebyo wabwɨrawa ɨthoka kʉ Nyinya-kowethʉ ko byandabererera.»<verse eid="LUK 1:45" /></para>
  <para style="s">Olwimbo lwa Marɨa</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46" />Aho Marɨa mwanegena athɨ:</para>
  <para style="q1" vid="LUK 1:46">«Omʉthɨma aye asingya Nyinya-kowethʉ yo kʉtsɨbʉ,<verse eid="LUK 1:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="LUK 1:47" />kandɨ omʉthɨma aye amogera Gongo yo kʉtsɨbʉ, yo Mushabuli aye;<verse eid="LUK 1:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LUK 1:48" />kʉshangwa mwashʉnga obʉlonvʉ bwaye ingye mʉgombe ʉwe.</para>
  <para style="q1" vid="LUK 1:48">Ega! Ɨthanga lɨno-lɨno abandʉ boshi bandagenda abanyahʉlamo mʉgashanɨrwa,<verse eid="LUK 1:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="LUK 1:49" />kʉshangwa Gongo w'amaka woshi mwanyɨkolera kɨndʉ kɨnene.</para>
  <para style="q1" vid="LUK 1:49">Erɨtsɨna lɨwe lɨsha lyo <char style="w" lemma="Mubuyirire">libuyirire</char>.<verse eid="LUK 1:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50" />Ko bɨro byoshi andagenda afwɨra shashi bobamukengire.<verse eid="LUK 1:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51" />Mwakola kɨndʉ kɨnene mo maka w'okʉboko kʉwe.</para>
  <para style="q1" vid="LUK 1:51">Mwapanzire abandʉ bo babyaga n'emɨthɨma y'emɨfʉma.<verse eid="LUK 1:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52" />Mwathoyitsye abamɨ b'oko ndebe sabo,</para>
  <para style="q1" vid="LUK 1:52">n'abalonvʉ mwirukitsyebo.<note caller="+" style="f"><char style="fr" closed="false">1:52 </char><char style="xt" closed="false">Soma <ref loc="JOB 5:11">Yobu 5:11</ref>; <ref loc="JOB 12:19">12:19</ref>.</char></note><verse eid="LUK 1:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53" />Ababyaga nibawirire mwayirirebo mo bashoki,</para>
  <para style="q1" vid="LUK 1:53">hewethuwe abashoki mwafulukitsyebo minwe mɨsha.<verse eid="LUK 1:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54" />Mwangirire <char style="w">Isiraeli</char> mʉgombe ʉwe,</para>
  <para style="q1" vid="LUK 1:54">mwathibirirwe imukangya obʉbʉya bʉwe,<verse eid="LUK 1:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55" />ng'oko alagaga bo thatha-kʉlʉ,</para>
  <para style="q1" vid="LUK 1:55">
    <char style="w">Abʉrahamʉ</char> n'olʉbʉtho lʉwe kera na kera.»<verse eid="LUK 1:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56" />Marɨa mwikala hagʉma na Lisabeti hofɨ myetsɨ ishathu. Honyuma kw'aho mwashʉba ewe.<verse eid="LUK 1:56" /></para>
  <para style="s">Erɨbʉthwa lya Yoani Mubatisya</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57" />Ebɨro by'erɨbʉtha bya Lisabeti byabere byahika, mwabʉtha mwana wa bʉtsana. <verse eid="LUK 1:57" /><verse number="58" style="v" sid="LUK 1:58" />Abahʉwene n'abahimbani bʉwe babere bonvwa ko Nyinya-kowethʉ mwamʉfwɨra shashi nene mobamoga hagʉma naye. <verse eid="LUK 1:58" /><verse number="59" style="v" sid="LUK 1:59" />Ekɨro ky'omʉnanɨ enyuma y'erɨbʉthwa lɨwe mobagenda n'omwana <char style="w" lemma="Ɨmona">ayamonibwe</char>,<note caller="+" style="f"><char style="fr" closed="false">1:59 </char><char style="xt" closed="false">Soma <ref loc="LEV 12:3">Balawi 12:3</ref>.</char></note> mobashondya ɨmʉha erɨtsɨna lya Sakarɨa ishe ʉwe. <verse eid="LUK 1:59" /><verse number="60" style="v" sid="LUK 1:60" />Hewethuwe nyinya ʉwe mwathɨnda athɨ: «Ɨhɨ, alʉkwamo Yoani.» <verse eid="LUK 1:60" /><verse number="61" style="v" sid="LUK 1:61" />Mobamʉbwɨra bathɨ: «Mbeno! Hathalɨ mʉndʉ n'omʉgʉma w'omo lʉganda lwawe yo ʉnahʉlwa mw'ɨtsɨna eryo!»<verse eid="LUK 1:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 1:62" />Aho mobabʉtsya ishe w'omwana y'omo minwe bathɨ: «Omwana wamʉlʉkamo ndɨ?» <verse eid="LUK 1:62" /><verse number="63" style="v" sid="LUK 1:63" />Sakarɨa mwashababo kɨshayɨ naye mwashakako athɨ: «Erɨtsɨna lɨwe yo Yoani.» Aboshi mobashweka kʉtsɨbʉ. <verse eid="LUK 1:63" /><verse number="64" style="v" sid="LUK 1:64" />Mo kathambi ako obʉnʉ bwa Sakarɨa, n'olʉlɨmɨ lʉwe mobyagobokala mwathanga ɨshʉba negena n'ɨhalamba Gongo kʉtsɨbʉ. <verse eid="LUK 1:64" /><verse number="65" style="v" sid="LUK 1:65" />Aho abahimbani bʉwe boshi mobʉbaha kʉtsɨbʉ. Omwatsɨ oyo mwathimba mo bɨthwa byoshi by'ekɨhʉgo ky'iYuteya.<verse eid="LUK 1:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 1:66" />Abandʉ boshi bo bonvwaga omwatsɨ oyo mobathanga ɨyɨbʉtsya mo mɨthɨma yabo bathɨ: «Omwana wamabʉthwa oyu andabya athɨ?» Ega! Kwenene amaka wa Nyinya-kowethʉ abyaga hagʉma naye.<verse eid="LUK 1:66" /></para>
  <para style="s">Olwimbo lwa Sakarɨa</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67" />Sakarɨa, ishe w'omwana mwotsutsibwa <char style="w" lemma="Mʉthɨma Mwerʉ">n'oMʉthɨma Mwerʉ</char>; mwathanga ɨmɨnyerera athɨ:<verse eid="LUK 1:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68" />«Nyinya-kowethʉ Gongo w'ekɨhanda <char style="w" lemma="Isiraeli">ky'aBaisiraeli</char> asingibwe,</para>
  <para style="q1" vid="LUK 1:68">kʉshangwa mwawathikya abandʉ bʉwe n'ɨshabʉlabo.<verse eid="LUK 1:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69" />Mwathʉthʉmɨra Mushabuli wa maka,</para>
  <para style="q1" vid="LUK 1:69">w'omo lʉganda lwa <char style="w">Tawiti</char> mʉgombe ʉwe.<verse eid="LUK 1:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70" />Ebɨnwa ebi bɨrɨngene n'ebyo anegenaga ɨthanga kera ɨtsʉkɨra ko <char style="w" lemma="Mʉmɨnyeretsɨ">bamɨnyeretsɨ</char> bʉwe <char style="w" lemma="Mubuyirire">babuyirire</char> bathɨ:<verse eid="LUK 1:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71" />andathʉthʉmɨra yo wandathʉshabʉla mo minwe y'esonzigu,</para>
  <para style="q1" vid="LUK 1:71">na bobathufwire bʉshʉ.<verse eid="LUK 1:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72" />Mwakangania eshashi yɨwe yo bo thatha-kʉlʉ,</para>
  <para style="q1" vid="LUK 1:72">na kandɨ mwathɨbɨrɨrwa <char style="w" lemma="Ndagane">endagane</char> yɨwe <char style="w" lemma="Mubuyirire">nyibuyirire</char> kʉtsɨbʉ.<verse eid="LUK 1:72" /></para>
  <para style="q1">
    <verse number="73" style="v" sid="LUK 1:73" />Akolaga athyo ɨkwamana nga kw'alahɨtsɨraga <char style="w">Abʉrahamʉ</char> thatha-kʉlʉ wethʉ,<note caller="+" style="f"><char style="fr" closed="false">1:73 </char><char style="xt" closed="false">Soma <ref loc="GEN 22:16-17">Ndangɨro 22:16-17</ref>.</char></note><verse eid="LUK 1:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="LUK 1:74" />athɨ andathʉshabʉla n'ithuthokya mo minwe y'esonzigu</para>
  <para style="q1" vid="LUK 1:74">kʉshangwa thumuramye bʉtsɨra bʉba,<verse eid="LUK 1:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="LUK 1:75" />mo bʉbʉya n'obʉthʉnganene embere sɨwe,</para>
  <para style="q1" vid="LUK 1:75">bɨro byoshi mw'ibyaho lyethʉ.<verse eid="LUK 1:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76" />Nawe, mwana aye, bandagenda abakwahʉlamo <char style="w">Mʉmɨnyeretsɨ</char> wa Gongo yo ʉlɨ elʉgʉlʉ w'ebyoshi,</para>
  <para style="q1" vid="LUK 1:76">kʉshangwa n'ɨwe wandahika embere Nyinya-kowethʉ ahike,</para>
  <para style="q1" vid="LUK 1:76">bʉshana n'ithunganania enzɨra yɨwe.<verse eid="LUK 1:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77" />Nɨ ɨwe wo wandabwɨra abandʉ bʉwe nga kw'ahika bʉshana n'ɨshabʉlabo,</para>
  <para style="q1" vid="LUK 1:77">mw'ɨganyɨrwa ebɨtsɨbʉ byabo.<verse eid="LUK 1:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78" />Ɨkwamana n'eshashi nene ya Gongo wethʉ,</para>
  <para style="q1" vid="LUK 1:78">andathʉthʉmɨra ekyakakala ky'elʉgʉlʉ ekyandathʉkoletsya.<verse eid="LUK 1:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79" />Andakoletsya abalɨ mo mwitsimya n'abalɨ mo nzɨra y'olʉholo,</para>
  <para style="q1" vid="LUK 1:79">bʉshana n'ɨthwangɨrɨra thʉkwame enzɨra y'obʉholo.»<verse eid="LUK 1:79" /></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80" />Omwana oyo agenda ɨshʉka, n'omʉthɨma ʉwe mwabya n'akagala. Mwayikala mo <char style="w">mbwarara</char> ihika ko kɨro ashʉngɨkaga embere s'abandʉ <char style="w" lemma="Isiraeli">b'iIsiraeli</char>.<verse eid="LUK 1:80" /></para>
  <chapter eid="LUK 1" />
  <chapter number="2" style="c" sid="LUK 2" />
  <para style="s">Ɨbʉthwa lya Yesʉ</para>
  <para style="r">(<ref loc="MAT 1:18-25">Mat 1:18-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1" />Ko bɨro ebyo, Ngosito <char style="w">Kaisari</char> mwahamʉla abandʉ boshi babyaga mo bɨhʉgo byoshi agenda athegeka baye ko fishi.<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">Efishi eyo yakolekaga bʉshana abandʉ boshi balɨhe Ekoli y'omwamɨ mʉkʉlʉ w'ɨRoma.</char></note> <verse eid="LUK 2:1" /><verse number="2" style="v" sid="LUK 2:2" />Efishi nyɨmbere eyo yakolekaga mo bɨro Kurenio abyaga mʉkʉlʉ w'ekɨhʉgo ky'eSuria. <verse eid="LUK 2:2" /><verse number="3" style="v" sid="LUK 2:3" />Abandʉ boshi mobayakolera efishi eyo, obʉlɨ mʉndʉ ko muyi w'amabʉthwa ʉwe.<verse eid="LUK 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4" />Yosefʉ naye mwathoka mo kɨhʉgo ky'iNgalilaya, ko muyi w'iNasareti. Mwɨrʉkɨra mo kɨhʉgo ky'iYuteya mo muyi w'ɨBetelehemʉ w'omwamɨ <char style="w">Tawiti</char> abʉthɨrawamo; kʉshangwa naye abyaga w'omo lʉganda lwa <char style="w">Tawiti</char>. <verse eid="LUK 2:4" /><verse number="5" style="v" sid="LUK 2:5" />Mw'ɨya ko fishi mwagenda na Marɨa oyo agenda ahikya; naye abyaga mʉkʉle. <verse eid="LUK 2:5" /><verse number="6" style="v" sid="LUK 2:6" />Mo mʉgʉlʉ babyaga ɨBetelehemʉ, Marɨa ebɨro bɨwe by'erɨbʉtha mobyahika. <verse eid="LUK 2:6" /><verse number="7" style="v" sid="LUK 2:7" />Naye mwabʉtha mwana ʉwe mʉmbere wa bʉtsana. Amamuhira mo bɨralɨyo, amamʉlambɨka mo kiringa kʉshangwa mobathabona bʉgonzero mo nyʉmba y'abageni.<verse eid="LUK 2:7" /></para>
  <para style="s">Malaɨka afʉlɨra abalishya b'omwatsɨ w'ɨbʉthwa lya Yesʉ</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8" />Mo kɨthambɨ ekyo mwabyaga balishya. Abalishya abo babyaga mo lʉlɨshɨtsyo nɨabatheya ebihyo byabo mo kɨro. <verse eid="LUK 2:8" /><verse number="9" style="v" sid="LUK 2:9" /><char style="w">Malaɨka</char> mʉgʉma wa Nyinya-kowethʉ mwahʉlʉkɨrabo, mo lʉkengerwa lw'ekyakakala kya Nyinya-kowethʉ mokyathimba kʉbo, nabo mobʉbaha kʉtsɨbʉ.<figure style="fig" alt="Les bergers recoivent la nouvelle de la naissance de Jesus" file="WA03803b.tif" size="span" ref="2:9">Abalishya bamonvwa omwatsɨ w'ɨbʉthwa lya Yesʉ</figure> <verse eid="LUK 2:9" /><verse number="10" style="v" sid="LUK 2:10" />Hewethuwe <char style="w">malaɨka</char> mwabwɨrabo athɨ: «Mʉthʉbahaga! Kʉshangwa nyabalethera mwatsɨ mʉbʉya w'andaletha lʉmogo lʉnene ko bandʉ boshi. <verse eid="LUK 2:10" /><verse number="11" style="v" sid="LUK 2:11" />Munobwire Mushabuli enyu amabʉthwa mo muyi w'omwamɨ <char style="w">Tawiti</char>, naye nɨ <char style="w" lemma="Kirisito, Masia">Kirisito</char> yo Nyinya-kowethʉ. <verse eid="LUK 2:11" /><verse number="12" style="v" sid="LUK 2:12" />Na kɨno kyo kɨmɨnyɨkalo kyo kyabakangania: mweya lʉmekeke lʉlɨ mʉ bɨralɨyo lulambikire mʉ kiringa.»<verse eid="LUK 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13" />Aho n'aho <char style="w" lemma="Malaɨka">omʉmalaɨka</char> oyo mwashʉngɨka nɨalɨ na kɨkembe kɨnene ky'abandɨ <char style="w" lemma="Malaɨka">bamalaɨka</char> ɨthoka elʉbʉla niabasingya Gongo nɨabanegena bathɨ:<verse eid="LUK 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14" />«Gongo asingibwe mo lʉgʉlʉ kʉtsɨbʉ,</para>
  <para style="q1" vid="LUK 2:14">n'abandʉ abo atsɨgɨre mo kɨhʉgo babye n'obʉholo!»<verse eid="LUK 2:14" /></para>
  <para style="s">Abalishya bamaya lola ko mwana ɨBetelehemʉ</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15" />Honyuma kw'aho <char style="w" lemma="Malaɨka">abamalaɨka</char> abo mobamika abalishya, mobashʉba mo lʉbʉla. Aho abalishya mobabwɨrana bathɨ: «Thʉye ɨBetelehemʉ thʉlole nga yabere ki kyo Nyinya-kowethʉ amathʉbwɨra.» <verse eid="LUK 2:15" /><verse number="16" style="v" sid="LUK 2:16" />Mobahuthukirayo, mobeya Yosefʉ na Marɨa n'olʉmekeke nilunalambikire mo kiringa. <verse eid="LUK 2:16" /><verse number="17" style="v" sid="LUK 2:17" />Abalishya babere bashʉnga omwana, mobayafʉla omwatsɨ malaɨka athabwɨrabo bʉshana n'omwana oyo. <verse eid="LUK 2:17" /><verse number="18" style="v" sid="LUK 2:18" />Abandʉ boshi bonvwaga omwatsɨ abalishya bafʉlaga mobashweka kʉtsɨbʉ. <verse eid="LUK 2:18" /><verse number="19" style="v" sid="LUK 2:19" />Hewethuwe Marɨa mwabɨka ebyoshi ebyo mo mʉthɨma ʉwe na agenda aganɨkɨrabyo kʉtsɨbʉ. <verse eid="LUK 2:19" /><verse number="20" style="v" sid="LUK 2:20" />Honyuma kw'aho, abalishya abo mobashʉbʉla. Mobagenda nɨabasɨma n'isingya Gongo bʉshana n'ebɨnwa byoshi bathonvwa n'ɨshʉnga. Kʉshangwa mobeya ebɨnwa byoshi nga ko malaɨka abwɨragabo.<verse eid="LUK 2:20" /></para>
  <para style="s">Yesʉ amahabwa ɨtsɨna</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21" />Omwana abere ahika ko kɨro ky'omʉnanɨ honyuma w'erɨbʉthwa lɨwe <char style="w" lemma="ɨmona">mobamumonia</char>. Mobamʉlʉkamo Yesʉ. Erɨtsɨna eryo lyo <char style="w">malaɨka</char> ahʉlaga embere Marɨa aheke obʉkʉle.<verse eid="LUK 2:21" /></para>
  <para style="s">Yesʉ akanganibwa mo Nyʉmba ya Gongo</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 2:22" />Honyuma kw'aho, ebɨro mobyahika byo Yosefʉ na Marɨa bangayeritsye ɨkwamana <char style="w" lemma="Mʉgomba">n'oMʉgomba</char> wa Mʉsa nga kw'anegenire. Mobathwala omwana y'ɨYerʉsalemʉ bʉshana bamukanganie embere sa Nyinya-kowethʉ.<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="xt" closed="false">Soma <ref loc="LEV 12:1-8">Balawi 12:1-8</ref>.</char></note> <verse eid="LUK 2:22" /><verse number="23" style="v" sid="LUK 2:23" />Kʉshangwa bishakirwe mo <char style="w">Mʉgomba</char> wa Nyinya-kowethʉ bɨthɨ: «Obʉlɨ mwana mʉmbere w'obʉtsana andabya wa Nyinya-kowethʉ.<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="xt" closed="false">Soma <ref loc="EXO 13:2">Ɨthoka 13:2</ref>,<ref loc="EXO 13:12">12</ref>.</char></note>» <verse eid="LUK 2:23" /><verse number="24" style="v" sid="LUK 2:24" />Kandɨ bahikaga bʉshana n'ɨhera obʉhere buthegekire mo <char style="w">Mʉgomba</char> wa Nyinya-kowethʉ athɨ: «Hɨparara hɨbɨrɨ kʉtse makʉkʉ abɨrɨ owakɨrɨ malere.<note caller="+" style="f"><char style="fr" closed="false">2:24 </char><char style="xt" closed="false">Soma <ref loc="LEV 12:8">Balawi 12:8</ref>.</char></note>»<verse eid="LUK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25" />Mo mʉgʉlʉ oyo mo muyi w'ɨYerʉsalemʉ mwabyaga mʉndʉ mʉgʉma erɨtsɨna lɨwe nɨ yo Simioni. Simioni oyo abyaga mʉndʉ athʉnganene niubahire Gongo. Agenda alɨndɨrɨra Mushabuli w'ekɨhanda <char style="w" lemma="Isiraeli">ky'aBaisiraeli</char>. <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> abyaga hagʉma naye. <verse eid="LUK 2:25" /><verse number="26" style="v" sid="LUK 2:26" />Kandɨ mwamukumbulira kw'athɨndafwe athetsi alola kʉ <char style="w" lemma="Kirisito, Masia">Kirisito</char> yo wandathʉmwa na Nyinya-kowethʉ. <verse eid="LUK 2:26" /><verse number="27" style="v" sid="LUK 2:27" />Simioni mwashondolwa <char style="w" lemma="Mʉthɨma Mwerʉ">n'oMʉthɨma Mwerʉ</char>, mwɨngɨra mo <char style="w">Nyʉmba ya Gongo</char>. Ababuthi ba Yesʉ mobamʉlethamo akolerwe <char style="w" lemma="Mʉgomba">ng'oMʉgomba</char> wa Mʉsa kw'anegenire. <verse eid="LUK 2:27" /><verse number="28" style="v" sid="LUK 2:28" />Simioni mwangɨrɨra omwana mo minwe yɨwe, mwasingya Gongo n'ɨnegena athɨ:<verse eid="LUK 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29" />«Nyinya-kowethʉ, wamabereretsya endagane awe.</para>
  <para style="q1" vid="LUK 2:29">Hano wahera wanganyirika ingye mʉgombe awe nyɨfwe mo bʉholo.<verse eid="LUK 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30" />Kʉshangwa ingye owene-wene nyamayɨshʉngɨra mo mesho aye oMushabuli wamathʉma.<verse eid="LUK 2:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="LUK 2:31" />Wamamuthegekania abye Mushabuli embere s'abandʉ boshi<verse eid="LUK 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32" />oMushabuli ono yo kyakakala kyandakoletsya ko bandʉ boshi abandʉ b'ebɨhanda,</para>
  <para style="q1" vid="LUK 2:32">kandɨ n'ɨye yo wandaletha olʉkengerwa ko bandʉ bʉwe <char style="w">Isiraeli</char>.»<verse eid="LUK 2:32" /></para>
  <para style="s">Erɨmɨnyerera lya Simioni.</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33" />Ebɨnwa Simioni anegenaga kʉ Yesʉ mobyashwekya ababuthi bʉwe. <verse eid="LUK 2:33" /><verse number="34" style="v" sid="LUK 2:34" />Honyuma kw'aho, Simioni mwagashanɨrabo. He mwabwɨra Marɨa nyinya w'omwana athɨ: «Shʉnga! Omwana ono athabʉthwa bʉshana athoye bandʉ bangɨ mo <char style="w">Isiraeli</char> n'imania bangɨ mʉbo. Kandɨ andabya kɨmɨnyɨkalo kyo kɨthoka kʉ Gongo kyo bandʉ bangɨ bandathɨnda. <verse eid="LUK 2:34" /><verse number="35" style="v" sid="LUK 2:35" />Kʉshangwa emɨganɨtsye ya bandʉ bangɨ yo yibishire yandamɨnyɨkala. Nawe wowene Marɨa wandagalwa nga mʉndʉ bathathobola mʉthɨma mu muyali.»<verse eid="LUK 2:35" /></para>
  <para style="s">Mʉmɨnyeretsɨ Ana asɨma Gongo</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36" />Kandɨ habyaga <char style="w" lemma="Mʉmɨnyeretsɨ">mʉkekʉlʉ mʉmɨnyeretsɨ</char> erɨtsɨna lɨwe nɨ yo Ana. Abyaga mwalɨ wa Fanʉele w'omo lʉganda lwa Aseri. Ye Ana oyo mwamala omwe mo mɨaka ɨrɨnda bʉsha, iba ʉwe mwafwa. <verse eid="LUK 2:36" /><verse number="37" style="v" sid="LUK 2:37" />Honyuma kw'aho, mwabya mʉshʉmbakatsɨ ihika kʉ mɨaka makumi mʉnanɨ n'ine. Athagenda athoka mo <char style="w">Nyʉmba ya Gongo</char>, omo agendaga akolera Gongo kɨro na mwɨshɨ <char style="w" lemma="Iyima kalyo">n'iyima akalyo</char> n'ɨshaba. <verse eid="LUK 2:37" /><verse number="38" style="v" sid="LUK 2:38" />Ana oyo mwahika mo kathambi ako, mwathanga ɨsɨma Gongo. Agenda asɨmola emyatsɨ ya Yesʉ ko bandʉ boshi bagenda abalɨndɨrɨra ko Gongo andashabʉla abandʉ b'ɨYerʉsalemʉ mo malɨgo wabo.<verse eid="LUK 2:38" /></para>
  <para style="s">Ababuthi ba Yesʉ bamashʉba iNasareti</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39" />Ababuthi ba Yesʉ mobamala ɨkola ebyoshi ɨkwamana n'ebithegekirwe mo <char style="w">Mʉgomba</char> wa Nyinya-kowethʉ. Honyuma kw'aho, mobashʉba n'omwana mo kɨhʉgo ky'iNgalilaya, mo muyi wabo w'iNasareti.<verse eid="LUK 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 2:40" />Yesʉ agenda ɨshʉka n'ɨyɨra kagala. Abyaga niotswiremo bwenge n'olʉkogo lwa Gongo nɨlʉlɨ hagʉma naye.<verse eid="LUK 2:40" /></para>
  <para style="s">Yesʉ alɨ mo Nyʉmba ya Gongo</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41" />Ko bʉlɨ mwaka ababuthi ba Yesʉ nɨabanaya ɨYerʉsalemʉ ko kɨro kɨkʉlʉ <char style="w" lemma="Pasaka">ky'ePasaka</char>. <verse eid="LUK 2:41" /><verse number="42" style="v" sid="LUK 2:42" />Yesʉ abere amayɨra mɨaka ikumi n'ibiri mwɨrʉkɨra ɨYerʉsalemʉ hagʉma n'ababuthi bʉwe ko linye ɨkwamana n'emɨbere y'aBayuta.<note caller="+" style="f"><char style="fr" closed="false">2:42 </char><char style="ft" closed="false">Ko Bayuta, omwana amahika ko mɨaka ikumi n'ibiri nɨahera ashondya ibya mʉndʉ mʉkʉlʉ mo bɨnwa bya Gongo.</char></note> <verse eid="LUK 2:42" /><verse number="43" style="v" sid="LUK 2:43" />Ebɨro by'elinye y'ePasaka byabere byahwa, ababuthi ba Yesʉ mobashʉba ewabo. Hewethuwe omwana Yesʉ mwashiba ɨYerʉsalemʉ ababuthi bʉwe mobathamɨnya. <verse eid="LUK 2:43" /><verse number="44" style="v" sid="LUK 2:44" />Bagendaga abaganɨtsya bathɨ analɨ mo kathi k'abandɨ bagendania. Babere bamala ɨgenda lʉgendo lwa mʉthobero mʉgʉma, mobamʉshondya mo lʉganda lwabo na mo balikyabo. <verse eid="LUK 2:44" /><verse number="45" style="v" sid="LUK 2:45" />Hewethuwe mobathamʉbona. Bʉshana n'ekyo, mobashʉba ɨYerʉsalemʉ nibanemumushondya.<verse eid="LUK 2:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 2:46" />Honyuma wa bɨro bɨshathʉ, mobamweya mo <char style="w">Nyʉmba ya Gongo</char>, n'ikere mo kathi <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">k'abakangɨrɨtsya b'oMʉgomba</char> nɨahʉlɨkɨrɨtsyabo n'ɨbʉtsyabo. <verse eid="LUK 2:46" /><verse number="47" style="v" sid="LUK 2:47" />Aboshi bagenda abamʉhʉlɨkɨrɨtsya nɨabashweka bʉshana n'obwenge bʉwe n'emɨshʉbɨtsye yɨwe. <verse eid="LUK 2:47" /><verse number="48" style="v" sid="LUK 2:48" />Ababuthi bʉwe babere bamʉshʉnga mobashweka kʉtsɨbʉ. Nɨmo nyinya amʉbwɨra athɨ: «Mbe mwanaye! Bʉshana na ki wamathʉkolera ebi? Lola ingye na sho thwamakushondya emɨthɨma nɨyɨthalɨ mo nda!» <verse eid="LUK 2:48" /><verse number="49" style="v" sid="LUK 2:49" />Naye mwashʉbɨtsyabo athɨ: «Mʉthanyɨshondetsya ki? Muthetsi ko lɨtholere ninyabya mo Nyʉmba ya Thatha?» <verse eid="LUK 2:49" /><verse number="50" style="v" sid="LUK 2:50" />Hewethuwe eby'agenda abwɨrabo mobathonvwabyo.<verse eid="LUK 2:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51" />Ko nduli y'ebyoshi ebyo, Yesʉ mwandagala hagʉma n'ababuthi bʉwe mw'ɨshʉba iNasareti, abyaga niashikitsyebo. Ebɨnwa byoshi ebyo nyinya nɨanabɨkabyo mo mʉthɨma ʉwe. <verse eid="LUK 2:51" /><verse number="52" style="v" sid="LUK 2:52" />Yesʉ agenda ɨshʉka mo bwenge na mo lʉgero n'omo lʉkogo embere sa Gongo n'embere s'abandʉ.<verse eid="LUK 2:52" /></para>
  <chapter eid="LUK 2" />
  <chapter number="3" style="c" sid="LUK 3" />
  <para style="s">Amakangɨrɨtsya wa Yoani Mubatisya</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mat 3:1-12</ref>; <ref loc="MRK 1:1-8">Mar 1:1-8</ref>; <ref loc="JHN 1:19-28">Yoa 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1" />Ko mʉgʉlʉ Tiberia <char style="w">Kaisari</char> abyaga mo mwaka w'ikumi n'ithano alɨ athegeka, bano bo bagenda abakola hagʉma naye: Ponzo <char style="w">Pilato</char> abyaga kafʉrʉnalɨ w'ekɨhʉgo ky'iYuteya, na <char style="w">Herote</char> agendaga athegeka ekɨhʉgo ky'iNgalilaya, na mʉgala wabo Filipo naye agenda athegeka ekɨhʉgo ky'Itureya n'ekya Tarakoniti. Na Lisania nɨathegeka ekɨhʉgo ky'iAbilene. <verse eid="LUK 3:1" /><verse number="2" style="v" sid="LUK 3:2" />Na Ana na Kayafa babyaga <char style="w" lemma="Muheri">baheri bakʉlʉ</char>.</para>
  <para style="p" vid="LUK 3:2">N'oko bɨro ebyo <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char> mokyahikira Yoani mʉgala wa Sakarɨa mo mʉgʉlʉ abyaga mo <char style="w">mbwarara</char>. <verse eid="LUK 3:2" /><verse number="3" style="v" sid="LUK 3:3" />Na Yoani oyo mwatsʉka mo bɨhʉgo byoshi ebyo byabyaga bithimbire ko lwitsi lw'eYorotani, nɨakangɨrɨtsya abandʉ athɨ: «Mʉbɨndʉke mʉthoke mo bɨtsɨbʉ byenyu na <char style="w" lemma="Lubatiso">mubatisibwe</char> nɨmo mwandaganyɨrwa ebɨtsɨbʉ byenyu.» <verse eid="LUK 3:3" /><verse number="4" style="v" sid="LUK 3:4" />Naho ebɨnwa mobyabererera, ebyo byashakawa <char style="w" lemma="Mʉmɨnyeretsɨ">n'omʉmɨnyeretsɨ</char> Isaya omo kɨtabo kɨwe athɨ:</para>
  <para style="q1" vid="LUK 3:4">«Mʉndʉ mʉgʉma ahambala mo <char style="w">mbwarara</char> athɨ:</para>
  <para style="q1" vid="LUK 3:4">“Muthungananie enzɨra ya Nyinya-kowethʉ,</para>
  <para style="q1" vid="LUK 3:4">Muthungananie aho atsʉka!<verse eid="LUK 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5" />Emithiri yoshi yandotsʉla.</para>
  <para style="q1" vid="LUK 3:5">Bʉlɨ kɨthwa n'obʉlɨ kathwa byandakimibwa.</para>
  <para style="q1" vid="LUK 3:5">Esongonde sandalambʉlwa.</para>
  <para style="q1" vid="LUK 3:5">N'esonzɨra sɨrɨmo thʉkʉbo-thʉkʉbo sandalambathikanibwa.<verse eid="LUK 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6" />N'abandʉ boshi bandashʉnga ko Gongo andathʉshabʉla.”»<verse eid="LUK 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7" />Bandʉ bangɨ bagenda bahikira Yoani bʉshana <char style="w" lemma="Lubatiso">abatisyebo</char>. Hewethuwe mwagenda abwɨrabo athɨ: «Imwe lʉbʉtho lwa nzoka! Nɨ ndɨ yo wabakangɨrɨtsaya ɨshaga esohi ya Gongo yo yihika? <verse eid="LUK 3:7" /><verse number="8" style="v" sid="LUK 3:8" />Aho mʉgende omukangya mo mɨbere enyu ko mwabindukire ɨthoka mo bɨtsɨbʉ byenyu. Kandɨ mʉthayɨhalaga mʉthɨ: “Ithwe <char style="w">Abʉrahamʉ</char> yo thatha-kʉlʉ wethʉ.” Enyɨbabwɨra kwenene ko Gongo awithe amaka w'ɨbɨndʉla amabwe aya abye bana ba <char style="w">Abʉrahamʉ</char>! <verse eid="LUK 3:8" /><verse number="9" style="v" sid="LUK 3:9" />Lɨno embasha yamalire ɨgosholwa bʉshana n'ɨtsɨra emɨthɨ y'omo mirihi. Obʉlɨ mʉthɨ w'athahekire biguma bikwirire andakondwa n'ɨgʉshwa mo mʉtsanwa.»<verse eid="LUK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10" />Honyuma kw'aho omuhindano oyo mwabʉtsya Yoani athɨ: «Thʉyɨre thʉthɨ?» <verse eid="LUK 3:10" /><verse number="11" style="v" sid="LUK 3:11" />Yoani mwashʉbɨtsyabo athɨ: «Omʉndʉ oyo uwithe kʉ ngɨmba ibiri ahe yo uthawithe yo lʉgʉma. Na yo uwithe kʉ kalyo naye akole athyo.»<verse eid="LUK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12" />Abakarani bagʉma b'ekoli nabo mobahikira Yoani <char style="w" lemma="Lubatiso">abatisyebo</char>, mobamʉbʉtsya bathɨ: «Mʉkangɨrɨtsya, nethwe thʉkole ki?» <verse eid="LUK 3:12" /><verse number="13" style="v" sid="LUK 3:13" />Mwashʉbɨtsyabo athɨ: «Mʉthagenda omʉlɨhɨsya faranga nyɨngɨ kʉlenga s'abakʉlʉ bahamwire.»<verse eid="LUK 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 3:14" />Abashirikani nabo mobamʉbʉtsya bathɨ: «Nethwe thʉkole ki?» Mwashʉbɨtsyabo athɨ: «Mʉthashamʉlaga kɨndʉ kya bene, kandɨ mʉthabɨhɨraga mʉndʉ. Hewethuwe mʉgende omʉmogera olʉhembo lwenyu.»<verse eid="LUK 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15" />Abandʉ babyaga nibalindirire erihika lya <char style="w" lemma="Kirisito, Masia">Kirisito</char>. Aho aboshi bagenda abayɨbʉtsya mo mɨthɨma yabo nga kʉno Yoani yo ʉthalɨ <char style="w" lemma="Kirisito, Masia">Kirisito</char>. <verse eid="LUK 3:15" /><verse number="16" style="v" sid="LUK 3:16" />Yoani mwashʉbɨtsya aboshi athɨ: «Ingye <char style="w" lemma="Lubatiso">enyibabatisya</char> mʉ metsi. Hewethuwe ahika enyuma kw'ingye yo uwithe maka mangɨ kw'ɨnyɨrengya. Nyɨthatholere ɨmɨnʉla emiriki y'oko bɨrato bɨwe. Ɨye <char style="w" lemma="Lubatiso">andababatisya</char> mo <char style="w">Mʉthɨma Mwerʉ</char> na mo mʉtsanwa. <verse eid="LUK 3:16" /><verse number="17" style="v" sid="LUK 3:17" />Aho awithe ko lʉhʉngʉlo ko mo minwe, bʉshana n'ilongya engano. Engano eyo andahiraro mo mbʉpʉ yɨwe. Hewethuwe omʉsɨsɨ andagʉshawo mo mʉtsanwa owathɨndatsɨme.»<verse eid="LUK 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 3:18" />Yoani agenda afʉlɨra abandʉ bw'eNgʉlʉ Mbʉya, n'ɨhabo wandɨ mahano mangɨ.<verse eid="LUK 3:18" /></para>
  <para style="s">Herote ahira Yoani mo muliki</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 3:19" />Muthegeki <char style="w">Herote</char> mwahikya Herotia mʉka mʉgalabo nga ko bɨthatholere. Kandɨ agendaga akola n'ebɨndɨ bɨbɨ. Bʉshana n'ebyoshi ebyo Yoani mwamʉkemera. <verse eid="LUK 3:19" /><verse number="20" style="v" sid="LUK 3:20" />He mwashʉba ongerera ko bɨbɨ ebyo mw'ɨmɨna Yoani n'ɨmʉgʉsha mo muliki.<verse eid="LUK 3:20" /></para>
  <para style="s">Yoani abatisya Yesʉ</para>
  <para style="r">(<ref loc="MAT 3:13-17">Mat 3:13-17</ref>; <ref loc="MRK 1:9-11">Mar 1:9-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21" />Abandʉ boshi babere bamamala <char style="w" lemma="Lubatiso">ibatisibwa</char>, Yesʉ naye <char style="w" lemma="Lubatiso">mwabatisibwa</char>. Abere anemʉshaba Gongo olʉbʉla molwakɨngʉkala, <verse eid="LUK 3:21" /><verse number="22" style="v" sid="LUK 3:22" />n'<char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> mwamukimirako nga kalikuku. N'omʉlenge mw'onvwɨka ɨthoka mo lʉbʉla athɨ: «Ʉlɨ Mʉgala aye mʉtsɨɨrwa ɨwe unanyimoya kʉtsɨbʉ.<note caller="+" style="f"><char style="fr" closed="false">3:22 </char><char style="xt" closed="false">Soma <ref loc="PSA 2:7">Saburi 2:7</ref>.</char></note>»<verse eid="LUK 3:22" /></para>
  <para style="s">Kithunga kya Yesʉ</para>
  <para style="r">(<ref loc="MAT 1:1-17">Mat 1:1-17</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23" />Yesʉ abyaga niawithe mɨaka hofɨ makumi ashathʉ abere athangɨra omʉlɨmo ʉwe. Abandʉ bagenda abaganɨtsya bathɨ nɨ mʉgala wa Yosefʉ.</para>
  <para style="q1" vid="LUK 3:23">Yosefʉ oyo abyaga mʉgala wa Heli.<verse eid="LUK 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 3:24" />Na Heli abyaga mʉgala wa Matati,</para>
  <para style="q1" vid="LUK 3:24">na Matati abyaga mʉgala wa Lawi,</para>
  <para style="q1" vid="LUK 3:24">na Lawi abyaga mʉgala wa Meleki,</para>
  <para style="q1" vid="LUK 3:24">na Meleki abyaga mʉgala wa Yana,</para>
  <para style="q1" vid="LUK 3:24">na Yana abyaga mʉgala wa Yosefʉ.<verse eid="LUK 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 3:25" />Na Yosefʉ abyaga mʉgala wa Matatia,</para>
  <para style="q1" vid="LUK 3:25">na Matatia abyaga mʉgala wa Amosi,</para>
  <para style="q1" vid="LUK 3:25">na Amosi abyaga mʉgala wa Nahumu,</para>
  <para style="q1" vid="LUK 3:25">na Nahumu abyaga mʉgala wa Esili,</para>
  <para style="q1" vid="LUK 3:25">na Esili abyaga mʉgala wa Nagayi.<verse eid="LUK 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="LUK 3:26" />Na Nagayi abyaga mʉgala wa Magati,</para>
  <para style="q1" vid="LUK 3:26">na Magati abyaga mʉgala wa Matatia,</para>
  <para style="q1" vid="LUK 3:26">na Matatia abyaga mʉgala wa Semeyi,</para>
  <para style="q1" vid="LUK 3:26">na Semeyi abyaga mʉgala wa Yoseki,</para>
  <para style="q1" vid="LUK 3:26">na Yoseki abyaga mʉgala wa Yota.<verse eid="LUK 3:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="LUK 3:27" />Na Yota abyaga mʉgala wa Yohanani,</para>
  <para style="q1" vid="LUK 3:27">na Yohanani abyaga mʉgala wa Resa,</para>
  <para style="q1" vid="LUK 3:27">na Resa abyaga mʉgala wa Yorobabeli,</para>
  <para style="q1" vid="LUK 3:27">na Yorobabeli abyaga mʉgala wa Salatiere,</para>
  <para style="q1" vid="LUK 3:27">na Salatiere abyaga mʉgala wa Neri.<verse eid="LUK 3:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="LUK 3:28" />Na Neri abyaga mʉgala wa Meleki,</para>
  <para style="q1" vid="LUK 3:28">na Meleki abyaga mʉgala wa Ati,</para>
  <para style="q1" vid="LUK 3:28">na Ati abyaga mʉgala wa Kosamu,</para>
  <para style="q1" vid="LUK 3:28">na Kosamu abyaga mʉgala wa Elimatamu,</para>
  <para style="q1" vid="LUK 3:28">na Elimatamu abyaga mʉgala wa Eri.<verse eid="LUK 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 3:29" />Na Eri abyaga mʉgala wa Yoshua,</para>
  <para style="q1" vid="LUK 3:29">na Yoshua abyaga mʉgala wa Elieseri,</para>
  <para style="q1" vid="LUK 3:29">na Elieseri abyaga mʉgala wa Yorimu,</para>
  <para style="q1" vid="LUK 3:29">na Yorimu abyaga mʉgala wa Matati,</para>
  <para style="q1" vid="LUK 3:29">na Matati abyaga mʉgala wa Lawi.<verse eid="LUK 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 3:30" />Na Lawi abyaga mʉgala wa Simioni,</para>
  <para style="q1" vid="LUK 3:30">na Simioni abyaga mʉgala wa Yuta,</para>
  <para style="q1" vid="LUK 3:30">na Yuta abyaga mʉgala wa Yosefʉ,</para>
  <para style="q1" vid="LUK 3:30">na Yosefʉ abyaga mʉgala wa Yonamu,</para>
  <para style="q1" vid="LUK 3:30">na Yonamu abyaga mʉgala wa Eliakimu.<verse eid="LUK 3:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="LUK 3:31" />Na Eliakimu abyaga mʉgala wa Meleya,</para>
  <para style="q1" vid="LUK 3:31">na Meleya abyaga mʉgala wa Mena,</para>
  <para style="q1" vid="LUK 3:31">na Mena abyaga mʉgala wa Matata,</para>
  <para style="q1" vid="LUK 3:31">na Matata abyaga mʉgala wa Natani,</para>
  <para style="q1" vid="LUK 3:31">na Natani abyaga mʉgala wa <char style="w">Tawiti</char>.<verse eid="LUK 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 3:32" />Na Tawiti abyaga mʉgala wa Yese,</para>
  <para style="q1" vid="LUK 3:32">na Yese abyaga mʉgala wa Obeti,</para>
  <para style="q1" vid="LUK 3:32">na Obeti abyaga mʉgala wa Boasi,</para>
  <para style="q1" vid="LUK 3:32">na Boasi abyaga mʉgala wa Salimoni,</para>
  <para style="q1" vid="LUK 3:32">na Salimoni abyaga mʉgala wa Nasoni.<verse eid="LUK 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="LUK 3:33" />Na Nasoni abyaga mʉgala wa Amɨnatabʉ,</para>
  <para style="q1" vid="LUK 3:33">na Amɨnatabʉ abyaga mʉgala wa Atimini,</para>
  <para style="q1" vid="LUK 3:33">na Atimini abyaga mʉgala wa Aramu,</para>
  <para style="q1" vid="LUK 3:33">na Aramu abyaga mʉgala wa Isironi,</para>
  <para style="q1" vid="LUK 3:33">na Isironi mʉgala wa Peresi,</para>
  <para style="q1" vid="LUK 3:33">na Peresi abyaga mʉgala wa Yuta.<verse eid="LUK 3:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="LUK 3:34" />Na Yuta abyaga mʉgala wa Yakobo,</para>
  <para style="q1" vid="LUK 3:34">na Yakobo abyaga mʉgala wa Isaka,</para>
  <para style="q1" vid="LUK 3:34">na Isaka abyaga mʉgala wa <char style="w">Abʉrahamʉ</char>,</para>
  <para style="q1" vid="LUK 3:34">na <char style="w">Abʉrahamʉ</char> abyaga mʉgala wa Tera,</para>
  <para style="q1" vid="LUK 3:34">na Tera abyaga mʉgala wa Nahori.<verse eid="LUK 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="LUK 3:35" />Na Nahori abyaga mʉgala wa Serugi,</para>
  <para style="q1" vid="LUK 3:35">na Serugi abyaga mʉgala wa Reu,</para>
  <para style="q1" vid="LUK 3:35">na Reu abyaga mʉgala wa Pelegi,</para>
  <para style="q1" vid="LUK 3:35">na Pelegi abyaga mʉgala wa Eberi,</para>
  <para style="q1" vid="LUK 3:35">na Eberi abyaga mʉgala wa Sela.<verse eid="LUK 3:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="LUK 3:36" />Na Sela abyaga mʉgala wa Kenani,</para>
  <para style="q1" vid="LUK 3:36">na Kenani abyaga mʉgala wa Arifakasati,</para>
  <para style="q1" vid="LUK 3:36">na Arifakasati abyaga mʉgala wa Semu,</para>
  <para style="q1" vid="LUK 3:36">na Semu abyaga mʉgala wa Noa,</para>
  <para style="q1" vid="LUK 3:36">na Noa abyaga mʉgala wa Lameke.<verse eid="LUK 3:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="LUK 3:37" />Na Lameke abyaga mʉgala wa Metusela,</para>
  <para style="q1" vid="LUK 3:37">na Metusela abyaga mʉgala wa Enoke,</para>
  <para style="q1" vid="LUK 3:37">na Enoke abyaga mʉgala wa Yareti,</para>
  <para style="q1" vid="LUK 3:37">na Yareti abyaga mʉgala wa Mahalaleli,</para>
  <para style="q1" vid="LUK 3:37">na Mahalaleli abyaga mʉgala wa Kenani.<verse eid="LUK 3:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="LUK 3:38" />Na Kenani abyaga mʉgala wa Enosi,</para>
  <para style="q1" vid="LUK 3:38">na Enosi abyaga mʉgala wa Seti,</para>
  <para style="q1" vid="LUK 3:38">na Seti abyaga mʉgala wa Atamu,</para>
  <para style="q1" vid="LUK 3:38">na Atamu abyaga mʉgala wa Gongo.<verse eid="LUK 3:38" /></para>
  <chapter eid="LUK 3" />
  <chapter number="4" style="c" sid="LUK 4" />
  <para style="s">Ɨrengwako lya Yesʉ</para>
  <para style="r">(<ref loc="MAT 4:1-11">Mat 4:1-11</ref>; <ref loc="MRK 1:12-13">Mar 1:12-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1" />Yesʉ mwathoka ko lwitsi lw'eYorotani nɨalɨ na maka <char style="w" lemma="Mʉthɨma Mwerʉ">w'oMʉthɨma Mwerʉ</char>. <char style="w" lemma="Mʉthɨma Mwerʉ">N'oMʉthɨma Mwerʉ</char> oyo mwamʉthwala mo <char style="w">mbwarara</char>. <verse eid="LUK 4:1" /><verse number="2" style="v" sid="LUK 4:2" />Mwabya eyo yo bɨro makumi ane, <char style="w">Sitani</char> agenda amʉlengako. Ebɨro byoshi ebyo mwathalya kɨndʉ. Ebɨro ebyo byabere byahwa, mwafwa nzala.<verse eid="LUK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3" />Aho <char style="w">Sitani</char> mwamʉbwɨra athɨ: «Ɨwe, kwenene wamabya ʉlɨ <char style="w">Mʉgala wa Gongo</char>, bwɨra eribwe eri lɨhɨndʉke mukati.» <verse eid="LUK 4:3" /><verse number="4" style="v" sid="LUK 4:4" />Yesʉ mwamʉshʉbɨtsya athɨ: «Kushakirwe mo Mashako Abuyirire kʉthɨ: “Omʉndʉ athɨndabyeho bʉshana n'akalyo kuroshi.<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="xt" closed="false">Soma <ref loc="DEU 8:3">Ɨbʉka 8:3</ref>.</char></note>”»<verse eid="LUK 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5" />Honyuma kw'aho Sitani mwɨrʉkɨtsya Yesʉ y'elʉgʉlʉ kʉtsɨbʉ. Aho n'aho mwamʉkangya amamɨ woshi wa hano ishi, <verse eid="LUK 4:5" /><verse number="6" style="v" sid="LUK 4:6" />n'ɨmʉbwɨra athɨ: «Nyakʉha obuthegeki boshi n'obushoki bw'amamɨ aya. Kʉshangwa ebyoshi ebyo nyahabawabyo, nangye nyangahabyo mʉndʉ woshi-woshi yo nyishashire. <verse eid="LUK 4:6" /><verse number="7" style="v" sid="LUK 4:7" />Aho, wamanyɨfʉkamɨra mw'inyiramya ebyoshi ebyo nɨbyabya bɨwawe.» <verse eid="LUK 4:7" /><verse number="8" style="v" sid="LUK 4:8" />Yesʉ mwamʉshʉbɨtsya athɨ: «Kushakirwe mo Mashako Abuyirire kʉthɨ: “Ʉgende uramya Nyinya-kowethʉ Gongo wawe, n'ɨmʉkolera ɨye mʉsha.<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="xt" closed="false">Soma <ref loc="DEU 6:13">Ɨbʉka 6:13</ref>.</char></note>”»<verse eid="LUK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9" />N'oko nduli y'ebyoshi, Sitani mwathwala Yesʉ mo muyi w'ɨYerʉsalemʉ, mwamuhira ko mukuthu <char style="w" lemma="Nyʉmba ya Gongo">w'eNyʉmba ya Gongo</char> n'ɨmʉbwɨra athɨ: «Wamabya ʉlɨ <char style="w">Mʉgala wa Gongo</char> yɨgʉshe ahishi, <verse eid="LUK 4:9" /><verse number="10" style="v" sid="LUK 4:10" />kʉshangwa kushakirwe kʉthɨ:</para>
  <para style="q1" vid="LUK 4:10">“Gongo andahamʉla <char style="w" lemma="Malaɨka">abamalaɨka</char> bʉwe bakutheye.”<verse eid="LUK 4:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="LUK 4:11" />Kandɨ kushakirwe mo Mashako Abuyirire kʉthɨ:</para>
  <para style="q1" vid="LUK 4:11">“Bakʉheka mo minwe yabo, bʉshana ekɨshando kyawe kɨthatsɨkalaga kw'ibwe.<note caller="+" style="f"><char style="fr" closed="false">4:11 </char><char style="xt" closed="false">Soma <ref loc="PSA 91:11-12">Saburi 91:11-12</ref>.</char></note>”»<verse eid="LUK 4:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="LUK 4:12" />Yesʉ mwamʉshʉbɨtsya athɨ: «Kushakirwe mo Mashako Abuyirire kʉthɨ: “Ʉthagenda ʉlenga kʉ Nyinya-kowethʉ Gongo wawe.<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="xt" closed="false">Soma <ref loc="DEU 6:16">Ɨbʉka 6:16</ref>.</char></note>”»<verse eid="LUK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13" />
    <char style="w">Sitani</char> abere amala ɨlenga kʉ Yesʉ mo nzɨra soshi, mwathamʉleka, ihika kʉ ɨndɨ ndambi.<verse eid="LUK 4:13" /></para>
  <para style="s">Yesʉ athangɨra omʉlɨmo ʉwe mo kɨhʉgo ky'iNgalilaya</para>
  <para style="r">(<ref loc="MAT 4:12-17">Mat 4:12-17</ref>; <ref loc="MRK 1:14-15">Mar 1:14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14" />Yesʉ mwashʉba mo kɨhʉgo ky'iNgalilaya nɨalɨ n'akagala <char style="w" lemma="Mʉthɨma Mwerʉ">k'oMʉthɨma Mwerʉ</char>. Engʉlʉ yɨwe moyahika mo kɨhʉgo kyoshi ekyo. <verse eid="LUK 4:14" /><verse number="15" style="v" sid="LUK 4:15" />Agenda akangɨrɨtsya abandʉ b'omo <char style="w" lemma="Sinakoki:">sinakoki</char> yabo. N'abandʉ boshi niabamusingya.<verse eid="LUK 4:15" /></para>
  <para style="s">Abandʉ b'ɨNasareti bamathɨnda Yesʉ</para>
  <para style="r">(<ref loc="MAT 13:53-58">Mat 13:53-58</ref>; <ref loc="MRK 6:1-6">Mar 6:1-6</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16" />Yesʉ mwaya mo muyi w'iNasareti owɨshʉkɨragamo. Ekɨro <char style="w" lemma="Sabato">ky'eSabato</char> kyabere kyahika, mwɨngɨra mo <char style="w" lemma="Sinakoki:">sinakoki</char> ng'oko abyaga abegere. Mwimana bʉshana asomere abandʉ <char style="w" lemma="Kɨnwa kya Gongo">bw'eKɨnwa kya Gongo</char>. <verse eid="LUK 4:16" /><verse number="17" style="v" sid="LUK 4:17" />Mwahabwa mʉbʉngo w'ekɨtabo ky'<char style="w" lemma="Mʉmɨnyeretsɨ">omʉmɨnyeretsɨ</char> Isaya, naye mwabʉngʉlawo. Mwahikira ahashakirwe hathɨ:<verse eid="LUK 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18" />«<char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma</char> wa Nyinya-kowethʉ alɨ kw'ingye.</para>
  <para style="q1" vid="LUK 4:18">Kʉshangwa amanyɨhaka mafʉtha nyɨgende nyɨyakangɨrɨtsye <char style="w" lemma="Ngʉlʉ Mbʉya">eNgʉlʉ Mbʉya</char> ko batsene.</para>
  <para style="q1" vid="LUK 4:18">Amanyɨthʉma nyɨfʉlɨre bo balɨ mo muliki bw'omwatsɨ ko bamɨnʉlwa.</para>
  <para style="q1" vid="LUK 4:18">N'esombumi natho ko salola.</para>
  <para style="q1" vid="LUK 4:18">Na bo banubibwa babye n'ɨyɨbwara.<verse eid="LUK 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="LUK 4:19" />N'ɨfʉlɨra abandʉ b'omwatsɨ k'omwaka amahika wo Nyinya-kowethʉ w'akanganiamo obʉbʉya bʉwe ko bandʉ.<note caller="+" style="f"><char style="fr" closed="false">4:19 </char><char style="xt" closed="false">Soma <ref loc="ISA 61:1-2">Isaya 61:1-2</ref>.</char></note>»<verse eid="LUK 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20" />Honyuma kw'aho, Yesʉ mwabʉngabʉnga ekɨtabo mwahakyo omukoli w'omo <char style="w" lemma="Sinakoki:">sinakoki</char> mwayikala. N'abandʉ boshi babyaga bikere mo <char style="w" lemma="Sinakoki:">sinakoki</char> eyo, mobamʉhandako amesho.<verse eid="LUK 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 4:21" />Aho Yesʉ mwathanga ɨbwɨrabo athɨ: «<char style="w" lemma="Mashako Abuyirire">aMashako Abuyirire</char> mwamonvwa wo nyɨthoka ɨbasomera amabererera munobwire.»<verse eid="LUK 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22" />Abandʉ boshi bagenda abamogera Yesʉ n'ɨshweka bʉshana n'ebɨnwa bɨbʉya ebyo agenda anegena. Mobathanga ɨnegena bathɨ: «Oyu ndɨ nɨ mʉgala wa Yosefʉ!»<verse eid="LUK 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23" />Yesʉ mwabwɨrabo athɨ: «Nyetsi kundu mwandanyɨthega mo mushinga ono, owanegenire athɨ: “Mʉshake, yilamye wowene!” Kandɨ mwanyɨbwɨra mʉthɨ: “Mothwonvwa ebyoshi wakolaga ɨKaperenaʉmʉ, kolabyo n'omo muyi enyu ono.”» <verse eid="LUK 4:23" /><verse number="24" style="v" sid="LUK 4:24" />Mwashʉba bwɨrabo kandɨ athɨ: «Kwenene hathalɨ <char style="w" lemma="Mʉmɨnyeretsɨ">mʉmɨnyeretsɨ</char> yo unakokibwa kʉbʉya ko wabo. <verse eid="LUK 4:24" /><verse number="25" style="v" sid="LUK 4:25" />Kwenene enyɨbabwɨra nyɨthɨ mo kɨhʉgo <char style="w" lemma="Isiraeli">ky'iIsiraeli</char> mwabyaga bashʉmbakatsɨ bangɨ mo mʉgʉlʉ w'omʉmɨnyeretsɨ Elia. Mo mʉgʉlʉ oyo envʉla moyamala mɨaka ishathu na myetsɨ ndathʉ bʉthawa. Mokwabya nzala nzɨbʉ mo kɨhʉgo kyoshi.<note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="xt" closed="false">Soma <ref loc="1KI 17:1-7">1Bamɨ 17:1-7</ref>.</char></note> <verse eid="LUK 4:25" /><verse number="26" style="v" sid="LUK 4:26" />Mo bashʉmbakatsɨ boshi abo, Gongo mwathathʉma Elia awathikye mʉgʉma wa kʉbo. Hewethuwe mwamʉthʉma kʉ mʉgʉma w'oko muyi w'ɨSarepata mo kɨhʉgo ky'eSitona.<note caller="+" style="f"><char style="fr" closed="false">4:26 </char><char style="xt" closed="false">Soma <ref loc="1KI 17:8-16">1Bamɨ 17:8-16</ref>.</char></note><verse eid="LUK 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 4:27" />«Kandɨ mo kɨhʉgo <char style="w" lemma="Isiraeli">ky'iIsiraeli</char> mwabyaga babenzɨ bangɨ mo mʉgʉlʉ <char style="w" lemma="Mʉmɨnyeretsɨ">w'omʉmɨnyeretsɨ</char> Elisha. Hewethuwe mohathabya n'omʉgʉma wa kʉbo w'etsɨbwaga, he Namani mʉsha w'omo kɨhʉgo ky'eSuria.<note caller="+" style="f"><char style="fr" closed="false">4:27 </char><char style="xt" closed="false">Soma <ref loc="2KI 5:1-14">2Bamɨ 5:1-14</ref>.</char></note>»<verse eid="LUK 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28" />Abandʉ boshi bo babyaga mo <char style="w" lemma="Sinakoki:">sinakoki</char> eyo babere bonvwa ebyo mobakapɨkɨra. <verse eid="LUK 4:28" /><verse number="29" style="v" sid="LUK 4:29" />Mobimana, mobaligitha Yesʉ mo muyi, mobamʉkʉrɨra ko kathwa k'omuyi oyo abyaga ahimbireko. Niabashondya bamukunire mo muthiri. <verse eid="LUK 4:29" /><verse number="30" style="v" sid="LUK 4:30" />Hewethuwe Yesʉ mwasheshera mo kathi-kathi kabo, n'ɨyɨgendera.<verse eid="LUK 4:30" /></para>
  <para style="s">Yesʉ abɨnga mʉtsɨmʉ kʉ mʉndʉ</para>
  <para style="r">(<ref loc="MRK 1:21-28">Mar 1:21-28</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31" />Honyuma kw'aho Yesʉ mwandagalɨra mo muyi w'ɨKaperenaʉmʉ mo kɨhʉgo ky'iNgalilaya. Ekɨro <char style="w" lemma="Sabato">ky'eSabato</char> kyabere kyahika mwakangɨrɨtsya abandʉ. <verse eid="LUK 4:31" /><verse number="32" style="v" sid="LUK 4:32" />Abandʉ mobashweka kʉtsɨbʉ bashʉnga emɨkangɨrɨtsye yɨwe, kʉshangwa ebɨnwa bɨwe byabyaga nibishikire.<verse eid="LUK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 4:33" />Mo <char style="w" lemma="Sinakoki:">sinakoki</char> eyo mwabyaga mʉndʉ nɨalɨko <char style="w" lemma="mɨtsɨmʉ">mʉtsɨmʉ mʉbɨ</char>. Omʉndʉ oyo mwahambala kʉtsɨbʉ athɨ: <verse eid="LUK 4:33" /><verse number="34" style="v" sid="LUK 4:34" />«Ahaaa! Yesʉ w'iNasareti mbe uthushondyako ki? Wahikaga bʉshana n'ithubihya? Nyikwetsi kʉbʉya. Ɨwe ʉlɨ <char style="w">Mubuyirire</char> wathʉmawa na Gongo!» <verse eid="LUK 4:34" /><verse number="35" style="v" sid="LUK 4:35" />Yesʉ mwakemera kʉtsɨbʉ <char style="w" lemma="mɨtsɨmʉ">omʉtsɨmʉ</char> oyo athɨ: «Tsɨra! Na ʉthoke ko mʉndʉ oyu!» Aho n'aho <char style="w" lemma="mɨtsɨmʉ">omʉtsɨmʉ</char> oyo mwahuma omʉndʉ oyo yo ahishi mo kathi k'abandʉ, mwamʉthokako bʉthamwagatsya.<verse eid="LUK 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36" />Abandʉ boshi mobashweka kʉtsɨbʉ nɨababwɨrana bathɨ: «Kɨnwa mʉhanda ki eki? Omʉndʉ oyu abɨnga <char style="w" lemma="mʉtsɨmʉ">emɨtsɨmʉ</char> ko bandʉ mo maka na kagala athɨ bathoke kʉbo aho n'aho nabo nɨbathoka!» <verse eid="LUK 4:36" /><verse number="37" style="v" sid="LUK 4:37" />Bʉshana n'ekyo engʉlʉ ya Yesʉ moyagenda mo kɨhʉgo kyoshi ekyo.<verse eid="LUK 4:37" /></para>
  <para style="s">Yesʉ alamya bakoni bangɨ</para>
  <para style="r">(<ref loc="MAT 8:14-17">Mat 8:14-17</ref>; <ref loc="MRK 1:29-34">Mar 1:29-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38" />Yesʉ mwathoka mo <char style="w" lemma="Sinakoki">sinakoki</char> eyo, mwaya omwa Simoni. Abere ahikamo, mweya nyatsala wa Simoni niathithimana bʉshana n'akapururu. Mobashaba Yesʉ amʉlamye. <verse eid="LUK 4:38" /><verse number="39" style="v" sid="LUK 4:39" />Yesʉ mwunama niabindukire eyɨrɨ omʉkatsɨ oyo, mwakemera akapururu ako, nako kamamulika. Aho n'aho omʉkatsɨ oyo mwimana n'ɨthekerabo kalyo.<verse eid="LUK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40" />Erɨtsʉba lyabere lyalenga, mobalethera Yesʉ yo abakoni boshi bo bagenda abagalwa n'amagali mɨnamɨna. Yesʉ mwagenda ahira ko bʉlɨ mʉgʉma wa kʉbo kw'eminwe n'imulamya. <verse eid="LUK 4:40" /><verse number="41" style="v" sid="LUK 4:41" /><char style="w" lemma="mɨtsɨmʉ">N'emɨtsɨmʉ</char> moyathoka ko bandʉ bangɨ nɨeyɨhambala yɨthɨ: «Ɨwe ʉlɨ <char style="w">Mʉgala wa Gongo</char>!» Hewethuwe Yesʉ mwakemeraro n'ɨkagaro ɨthanegenaga, kʉshangwa yabyaga niyetsi kw'ɨye nɨ <char style="w" lemma="Kirisito, Masia">Kirisito</char>.<verse eid="LUK 4:41" /></para>
  <para style="s">Yesʉ afʉla eNgʉlʉ Mbʉya mo so sinakoki</para>
  <para style="r">(<ref loc="MRK 1:35-39">Mar 1:35-39</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42" />Bwabere bwakya, Yesʉ mwathoka mo muyi, mwaya <char style="w" lemma="Mbwarara">ahathalɨ bandʉ</char>. Omuhindano mwathanga imushondya. Babere bamʉshʉngako mobashondya ɨmʉkɨkɨra bʉshana athashʉba mikabo. <verse eid="LUK 4:42" /><verse number="43" style="v" sid="LUK 4:43" />Hewethuwe Yesʉ mwabwɨrabo athɨ: «Nyɨtholere nɨnyafʉla <char style="w" lemma="Ngʉlʉ Mbʉya">eNgʉlʉ Mbʉya</char> <char style="w" lemma="Bwamɨ bwa Gongo">y'oBwamɨ bwa Gongo</char> y'omo yɨndɨ miyi naro. Kʉshangwa Gongo anyɨthʉmaga bʉshana n'ekyo.»<verse eid="LUK 4:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 4:44" />Aho Yesʉ agenda afʉlɨra abandʉ bw'eNgʉlʉ Mbʉya y'omo so <char style="w" lemma="Sinakoki:">sinakoki</char> s'omo kɨhʉgo ky'iYuteya.<verse eid="LUK 4:44" /></para>
  <chapter eid="LUK 4" />
  <chapter number="5" style="c" sid="LUK 5" />
  <para style="s">Yesʉ ashombola abɨga bʉwe bambere</para>
  <para style="r">(<ref loc="MAT 4:18-22">Mat 4:18-22</ref>; <ref loc="MRK 1:16-20">Mar 1:16-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1" />Kɨro kɨgʉma, Yesʉ abyaga n'imene emʉsɨke w'engetsɨ y'iNgenesareti.<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="fq" closed="false">Engetsɨ y'iNgenesareti </char><char style="ft" closed="false">yona ngetsɨ y'iNgalilaya.</char></note> Muhindano mʉnene wa bandʉ babyaga nɨabamʉyɨndɨrɨtsya balɨ abashondya ɨonvwa <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char>. <verse eid="LUK 5:1" /><verse number="2" style="v" sid="LUK 5:2" />Mwashʉnga matho abɨrɨ emʉsɨke w'engetsɨ, abarobi nɨbamathoka mʉwo, nɨabashʉga ehikira hyabo. <verse eid="LUK 5:2" /><verse number="3" style="v" sid="LUK 5:3" />Yesʉ mwashambɨra mʉ bwatho bʉgʉma bw'oko matho abyagaho. N'obwatho obo bwabyaga bwa Simoni, Yesʉ mwamʉbwɨra athɨ: «Fʉnda obwatho b'omo ngetsɨ hale hake n'ekɨthaka.» Mwikala mo bwatho obo n'ɨthanga ɨkangɨrɨtsya omuhindano wa bandʉ.<verse eid="LUK 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4" />Abere amamala ɨkangɨrɨtsya mwabwɨra Simoni athɨ: «Fʉnda obwatho bo ahalɨ metsi male, mʉgʉshe ehikira hyenyu mʉrobe ko mahere.» <verse eid="LUK 5:4" /><verse number="5" style="v" sid="LUK 5:5" />Simoni mwamʉshʉbɨtsya athɨ: «Mʉkangɨrɨtsya, mothʉroba mo kɨro kyoshi he mothʉhɨna. He kʉshangwa wo wamanegena nyagʉsha ehikira.»<verse eid="LUK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 5:6" />Mobagʉsha ehikira mo ngetsɨ. Mobitha mahere mangɨ kʉtsɨbʉ ihika ko kɨka ehikira hyabo niehishondya ɨbereka. <verse eid="LUK 5:6" /><verse number="7" style="v" sid="LUK 5:7" />Mobakohetsya balikyabo bo babyaga mo bʉndɨ bwatho bahike bangɨrɨrebo. Balikyabo babere bahika mobotsutsya amatho abɨrɨ woshi hofɨ bashende. <verse eid="LUK 5:7" /><verse number="8" style="v" sid="LUK 5:8" />Simoni Petero abere ashʉnga ebyo, mwafʉkama embere sa Yesʉ. Mwanegena athɨ: «Nyinya-kowethʉ, yɨfʉnde hale nangye, kʉshangwa nyɨrɨ mukoli w'ebɨtsɨbʉ!» <verse eid="LUK 5:8" /><verse number="9" style="v" sid="LUK 5:9" />Simoni hagʉma na balikyabo boshi mobashweka kʉtsɨbʉ bʉshana n'obʉngɨ bw'amahere bithaga.<verse eid="LUK 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 5:10" />Yakobo na Yoani bagala ba Sebetayo barobi balikyabo Simoni, nabo mobashweka kʉtsɨbʉ. Hewethuwe Yesʉ mwabwɨra Simoni athɨ: «Ʉthʉbahaga! Ɨthanga munobwire wabya murobi wa bandʉ.»<verse eid="LUK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 5:11" />Aho, mobakʉrɨra amatho wabo ko kɨthaka. Mobashiga ebyoshi n'ɨkwama Yesʉ.<verse eid="LUK 5:11" /></para>
  <para style="s">Yesʉ alamya mʉbenzɨ</para>
  <para style="r">(<ref loc="MAT 8:1-4">Mat 8:1-4</ref>; <ref loc="MRK 1:40-45">Mar 1:40-45</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12" />Yesʉ abere analɨ mʉ mʉgʉma w'emiyi y'ekɨhʉgo ekyo, mohahika mʉndʉ alɨko bɨbenzɨ ko mʉbɨrɨ woshi. Omʉndʉ oyo abere ashʉnga Yesʉ mwafʉkama embere sɨwe n'obʉsʉ mobwahika ahishi n'ɨmʉshaba kʉtsɨbʉ athɨ: «Ee Nyinya-kowethʉ, wamashasha wanganyetsya.» <verse eid="LUK 5:12" /><verse number="13" style="v" sid="LUK 5:13" />Yesʉ mwalambʉla okʉboko mwamʉkolako n'ɨnegena athɨ: «Nyishashire, were.» Aho n'aho ebɨbenzɨ ebyo mobyamʉthokako. <verse eid="LUK 5:13" /><verse number="14" style="v" sid="LUK 5:14" />Yesʉ mwamʉhamʉla athɨ: «Ʉthabwɨraga mʉndʉ bʉshana n'ebi. Hewethuwe ʉgende uyayikangye ko <char style="w">muheri</char>. Honyuma kw'aho uhulukye <char style="w" lemma="Bɨhembo">ebɨhembo</char> ng'oko oMʉgomba wa Mʉsa ahamulire, kw'ikangania ko bandʉ boshi ko wamera.<note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="ft" closed="false">Omʉndʉ amalamibwa ebɨbenzɨ anaya yikangania ko baheri kw'alamire. Agenda akola ebyo kʉshangwa bashʉbe mʉtsɨge mo kathi k'abandʉ. </char><char style="xt" closed="false">Soma <ref loc="LEV 13:45-46">Balawi 13:45-46</ref>; <ref loc="LEV 14:1-32">14:1-32</ref>.</char></note>»<verse eid="LUK 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15" />Mokɨthaleka engʉlʉ ya Yesʉ ɨthagenda mo bandʉ. Bandʉ bangɨ mobagenda abahindana bʉshana bonvwe ebyo Yesʉ agenda anegena na kandɨ balamibwe amakoni wabo. <verse eid="LUK 5:15" /><verse number="16" style="v" sid="LUK 5:16" />Hewethuwe Yesʉ agenda ayɨhɨgʉla kʉbo, n'ɨya handʉ <char style="w" lemma="Mbwarara">hathalɨ bandʉ</char> bʉshana n'ɨyashaba Gongo.<verse eid="LUK 5:16" /></para>
  <para style="s">Yesʉ alamya omukoni w'amakonongola</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mat 9:1-8</ref>; <ref loc="MRK 2:1-12">Mar 2:1-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17" />Kɨro kɨgʉma Yesʉ agenda akangɨrɨtsya bandʉ. <char style="w" lemma="Bafarisayo:">aBafarisayo</char> <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">n'abakangɨrɨtsya b'oMʉgomba</char> bagʉma bo bathokaga mo miyi yoshi y'ekɨhʉgo ky'iNgalilaya, na ky'iYuteya, n'omo muyi w'ɨYerʉsalemʉ nabo babyaga nibikereho. Yesʉ agenda alamya abakoni mo maka wa Nyinya-kowethʉ Gongo.<verse eid="LUK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 5:18" />Bandʉ bagʉma mobahika nibahekire kipoyi kɨrɨko mukoni wa makonongola. Niabashondya ɨmwɨngɨtsya mo nyʉmba bamuhire embere sa Yesʉ. <verse eid="LUK 5:18" /><verse number="19" style="v" sid="LUK 5:19" />He mobabʉsha nzɨra y'imutsukyamo bʉshana n'abandʉ bangɨ. Bʉshana n'ebyo mobashamba ko luthwe lw'enyʉmba eyo.<note caller="+" style="f"><char style="fr" closed="false">5:19 </char><char style="ft" closed="false">aBayuta bagʉma abanabya bahimba abanalambɨka amakombamoya w'oko nyʉmba na ko makombamoya ayo wo bagenda bahirako ebikayi ebyo.</char></note> Mobathokya ko bikayi, mobamukimya mo bandʉ embere sa Yesʉ nɨanalɨ ko kipoyi kɨwe.<figure style="fig" alt="Les gens font decendre le malade sur le toit de la maison" file="WA03824b.tif" size="span" ref="5:19">Abandʉ abakimya mukoni ko luthwe lw'enyʉmba</figure> <verse eid="LUK 5:19" /><verse number="20" style="v" sid="LUK 5:20" />Yesʉ abere ashʉnga olwɨkɨrɨtsyo lw'abandʉ abo, mwabwɨra omukoni oyo athɨ: «Mwiraye, ebɨtsɨbʉ byawe byamaganyɨrwa!»<verse eid="LUK 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21" />
    <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">Abakangɨrɨtsya b'oMʉgomba</char> <char style="w" lemma="Bafarisayo:">n'aBafarisayo</char> abo, mobathanga ɨganɨtsya n'ɨyɨbʉtsya bathɨ: «Oyu nɨ ndɨ yo ʉhatsya kʉ Gongo? Nɨ ndɨ yo wangaganyɨra ebɨtsɨbʉ athalɨ Gongo yowene?»<verse eid="LUK 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22" />Yesʉ mwamɨnya emɨganɨtsye yabo mwabʉtsyabo athɨ: «Bʉshana na ki omʉganɨtsya muthyo mo mɨthɨma enyu? <verse eid="LUK 5:22" /><verse number="23" style="v" sid="LUK 5:23" />Ɨngo mʉnyɨbwɨre! Kɨhe kyo kyolo ɨnegena mbʉ: “Wamaganyɨrwa ebɨtsɨbʉ byawe,” kʉtse ɨnegena mbʉ: “Hangana ʉgende”? <verse eid="LUK 5:23" /><verse number="24" style="v" sid="LUK 5:24" />Enyishondya mʉmɨnye kw'ingye <char style="w">Mʉgala w'oMʉndʉ</char> nyiwithe amaka w'ɨganyɨra ebɨtsɨbʉ hano ishi.» Honyuma kw'aho Yesʉ mwabwɨra owamakonongola athɨ: «Ingye ngyo nyɨkʉbwɨra nyɨthɨ: Wimana! Tsɨmba ekipoyi kyawe ʉshʉbe eka.» <verse eid="LUK 5:24" /><verse number="25" style="v" sid="LUK 5:25" />Kona kathambi ako omʉndʉ oyo mwahangana embere s'abandʉ mwatsɨmba ekipoyi ekyo abyaga agonzereko mwashʉba ewe nianemusingya Gongo. <verse eid="LUK 5:25" /><verse number="26" style="v" sid="LUK 5:26" />Abandʉ boshi mobashukumana, mobatsɨmbwa n'obʉba, mobasingya Gongo, nɨabanegena bathɨ: «Munobwire thwamashʉnga ebɨthɨko-thɨko!»<verse eid="LUK 5:26" /></para>
  <para style="s">Yesʉ abwɨra Lawi amʉkwame</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mat 9:9-13</ref>; <ref loc="MRK 2:13-17">Mar 2:13-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27" />Honyuma kw'aho, Yesʉ mwathoka mo nyʉmba eyo. Mwashʉnga kʉ mukarani mʉgʉma w'ekoli erɨtsɨna lɨwe nɨ yo Lawi.<note caller="+" style="f"><char style="fr" closed="false">5:27 </char><char style="fq" closed="false">Lawi </char><char style="ft" closed="false">oyo yo na Matayo.</char></note> Lawi oyo abyaga n'ikere mo biro agenda alɨhɨsɨra Ekoli. Yesʉ mwamʉbwɨra athɨ: «Nyɨkwame.» <verse eid="LUK 5:27" /><verse number="28" style="v" sid="LUK 5:28" />Lawi mwahangana, mwashiga ebyoshi n'ɨkwama Yesʉ.<verse eid="LUK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29" />Honyuma kw'aho Lawi mwakolera Yesʉ yo linye linene mo nyʉmba yɨwe. Mo nyʉmba eyo mwabyaga bakarani bangɨ b'ekoli na bandɨ bandʉ bagenda abalya hagʉma nabo. <verse eid="LUK 5:29" /><verse number="30" style="v" sid="LUK 5:30" /><char style="w" lemma="Bafarisayo:">aBafarisayo</char> <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">n'abakangɨrɨtsya b'oMʉgomba</char> b'omo kɨkembe <char style="w" lemma="Bafarisayo">ky'aBafarisayo</char> abo, babere bashʉnga ebyo mobayɨfweba, n'ɨbwɨra <char style="w">abɨga</char> ba Yesʉ bathɨ: «Nɨ ki kyo kɨreka omulya n'ɨshoma hagʉma n'abakarani b'ekoli n'abakoli b'ebɨtsɨbʉ?» <verse eid="LUK 5:30" /><verse number="31" style="v" sid="LUK 5:31" />Yesʉ mwashʉbɨtsyabo athɨ: «Abatsibuhire bathashondya mʉshake hewethuwe nɨ abakoni bobanamushondya. <verse eid="LUK 5:31" /><verse number="32" style="v" sid="LUK 5:32" />Ingye nyithahikaga ɨbɨrɨkɨra abathʉnganene embere sa Gongo, hewethuwe nyahikaga ɨbɨrɨkɨra abakoli b'ebɨtsɨbʉ bʉshana babɨndʉke bathoke mo bɨtsɨbʉ byabo.»<verse eid="LUK 5:32" /></para>
  <para style="s">aBafarisayo ababʉtsya Yesʉ bʉshana n'eriyima akalyo</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mat 9:14-17</ref>; <ref loc="MRK 2:18-22">Mar 2:18-22</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33" />
    <char style="w" lemma="Bafarisayo:">aBafarisayo</char> mobabwɨra Yesʉ bathɨ: «<char style="w">Abɨga</char> ba Yoani n'abʉwethʉ kuthyo abanagenda <char style="w" lemma="Iyima kalyo">abayima</char> akalyo n'ɨshaba. Hewethuwe abʉwawe ɨbo abanagenda abalya n'ɨshoma.» <verse eid="LUK 5:33" /><verse number="34" style="v" sid="LUK 5:34" />Yesʉ mwashʉbɨtsyabo athɨ: «Mwangabwɨra abo bathabɨrɨkɨrwa ko buheruki mʉthɨ bathalyaga n'oyo uthaherukya nɨakɨnalɨ nabo? Kiro! <verse eid="LUK 5:34" /><verse number="35" style="v" sid="LUK 5:35" />Ebɨro byandahika oyo uthaherukya andathokibwa mʉbo. Nɨ mo bɨro ebyo mobandagenda <char style="w" lemma="Iyima kalyo">abayima</char> akalyo.»<verse eid="LUK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36" />Yesʉ mwashʉba tsɨrabo omushinga ono athɨ: «Hathalɨ mʉndʉ yo wangatsa kɨbandɨko ko lʉkɨmba luhyaluhya n'ɨlandɨrakyo ko lʉkɨmba lukulire. Kʉshangwa omʉndʉ amayɨra athyo nɨamaberenga olʉkɨmba luhyaluhya, n'ekɨbandɨko kyo kɨthathokako kɨthangatsɨmbana n'olʉkɨmba lukulire. <verse eid="LUK 5:36" /><verse number="37" style="v" sid="LUK 5:37" />Kandɨ hathalɨ mʉndʉ oyo unahira <char style="w" lemma="Tifayi:">etifayi</char> nyihya-nyihya mʉ bɨrega bya ngobi sikulire.<note caller="+" style="f"><char style="fr" closed="false">5:37 </char><char style="ft" closed="false">Ebɨrega aBayuta bagenda bahangɨkamo etifayi byabyaga bya ngobi kʉshangwa engobi eyo ɨthangabereka mo ndambi etifayi yamahya. Kʉshangwa engobi ikulire yabyaga nɨyahera yolohire, yangaberekera bʉsha.</char></note> Oyo wangakola athyo angaleka <char style="w" lemma="Tifayi:">etifayi</char> nyihya nɨyaberenga ebɨrega ebyo, <char style="w" lemma="Tifayi:">etifayi</char> nɨyashesheka n'ebɨrega nɨbyabɨha. <verse eid="LUK 5:37" /><verse number="38" style="v" sid="LUK 5:38" />Hewethuwe, lɨtholere etifayi nyihya-nyihya niyahirwa mʉ bɨrega bihya-bihya. <verse eid="LUK 5:38" /><verse number="39" style="v" sid="LUK 5:39" />Kandɨ hathalɨ mʉndʉ wamashoma ko tifayi yihire yowangashʉba shondya tifayi ya kera. Kʉshangwa nɨanegena athɨ: “Eyihire yo yikwirire kʉtsɨbʉ!”»<verse eid="LUK 5:39" /></para>
  <chapter eid="LUK 5" />
  <chapter number="6" style="c" sid="LUK 6" />
  <para style="s">Yesʉ yo Mʉkʉlʉ w'eSabato</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mat 12:1-8</ref>; <ref loc="MRK 2:23-28">Mar 2:23-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1" />Kɨro kɨgʉma <char style="w" lemma="Sabato">ky'eSabato</char>, Yesʉ agenda atsʉka mo mashwa w'engano. <char style="w">Abɨga</char> bʉwe bagenda abatsa ebɨkʉmba by'engano, mobahonolabyo mo minwe na mobalyaro.<note caller="+" style="f"><char style="fr" closed="false">6:1 </char><char style="ft" closed="false">Ko Bayuta omʉndʉ alɨ atsʉka mw'ɨshwa lɨrɨmo kalyo kerire alɨ awirire nɨatsa ebyangalya. Ɨkola bathyo bʉthabyaga bwɨtsɨ kʉbo. </char><char style="xt" closed="false">Soma <ref loc="DEU 23:25-26">Ɨbʉka 23:25-26</ref>.</char></note><verse eid="LUK 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 6:2" />
    <char style="w" lemma="Bafarisayo:">Bafarisayo</char> bagʉma mobabwɨrabo bathɨ: «Imwe! Bʉshana na ki omʉkola ebyo oMʉgomba ethʉ ahangire ɨkola ekɨro <char style="w" lemma="Sabato">ky'eSabato</char>?»<verse eid="LUK 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3" />Yesʉ mwashʉbɨtsyabo athɨ: «Mʉthahera mwathasoma ebyo omwamɨ <char style="w">Tawiti</char> akolaga mo ndambi ɨye n'abandʉ abyaga nabo babere bawɨra? <verse eid="LUK 6:3" /><verse number="4" style="v" sid="LUK 6:4" />Mwathɨngɨra mo <char style="w">Nyʉmba ya Gongo</char>, n'ɨthola emikati yo bandʉ bahembaga Gongo? Ndɨ mwalyaro n'ɨha abandʉ abyaga nabo, naho, <char style="w" lemma="Muheri">abaheri</char> basha n'ɨbo bahamulirwe irya emikati yɨrɨ ng'eyo!<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="xt" closed="false">Soma <ref loc="1SA 21:1-7">1Samweli 21:1-7</ref>.</char></note>»<verse eid="LUK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 6:5" />Honyuma kw'aho Yesʉ mwabwɨrabo athɨ: «<char style="w">Mʉgala w'oMʉndʉ</char> yo Mʉkʉlʉ <char style="w" lemma="Sabato">w'eSabato</char>.»<verse eid="LUK 6:5" /></para>
  <para style="s">Yesʉ alamya omʉndʉ w'amakonongola ekɨro ky'eSabato</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mat 12:9-14</ref>; <ref loc="MRK 3:1-6">Mar 3:1-6</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6" />Kɨndɨ kɨro <char style="w" lemma="Sabato">ky'eSabato</char> Yesʉ mwɨngɨra mo <char style="w">sinakoki</char> mwakangɨrɨtysa abandʉ. N'omo <char style="w">sinakoki</char> eyo mwabyaga mʉndʉ mʉgʉma ekɨganza kɨwe ky'amalyo nɨ kikonongokire. <verse eid="LUK 6:6" /><verse number="7" style="v" sid="LUK 6:7" /><char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">Abakangɨrɨtsya b'oMʉgomba</char> <char style="w" lemma="Bafarisayo:">n'aBafarisayo</char> bagenda abayɨthegeretsya nga Yesʉ alamya omʉndʉ oyo mo kɨro <char style="w" lemma="Sabato">ky'eSabato</char>. Bakolaga bathyo bʉshana babone kɨnwa bangamʉsɨtakɨra. <verse eid="LUK 6:7" /><verse number="8" style="v" sid="LUK 6:8" />Hewethuwe Yesʉ mwamɨnya emɨganɨtsye yabo. Mwabwɨra omʉndʉ w'ekɨganza kikonongokire athɨ: «Hangana, wimane mo kathi-kathi k'abandʉ.» Mwahangana amaya imana mo kathi kabo.<verse eid="LUK 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 6:9" />Honyuma kw'aho Yesʉ mwabwɨrabo athɨ: «Enyɨbabʉtsya nyɨthɨ: oMʉgomba ethʉ ahamulire ɨkola ki ekɨro <char style="w" lemma="Sabato">ky'eSabato</char>? Ɨkola bɨbʉya kʉtse ɨkola bɨbɨ? Ilamya mʉndʉ kʉtse imwitha?»<verse eid="LUK 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 6:10" />Yesʉ mwathimbya ko boshi kw'amesho, mwabwɨra omʉndʉ oyo athɨ: «Lambʉla okʉboko kwawe.» Naye mwalambʉlakyo, n'ekɨganza kɨwe mokyalama. <verse eid="LUK 6:10" /><verse number="11" style="v" sid="LUK 6:11" />Hewethuwe <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">abakangɨrɨtsya b'oMʉgomba</char> abo, n'aBafarisayo mobakapɨkɨra. Mobathanga ibutsania nga kʉno bayɨre Yesʉ yo bathɨ.<verse eid="LUK 6:11" /></para>
  <para style="s">Yesʉ ashombola abathʉmwa bʉwe ikumi na babɨrɨ</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mat 10:1-4</ref>; <ref loc="MRK 3:13-19">Mar 3:13-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12" />Mo bɨro ebyo Yesʉ mwɨrʉkɨra ko kɨthwa bʉshana n'ɨyashaba Gongo. Mobwamukyerayo nɨanemʉshaba. <verse eid="LUK 6:12" /><verse number="13" style="v" sid="LUK 6:13" />Bwabere bwakya Yesʉ mwabɨrɨkɨra <char style="w">abɨga</char> bʉwe, mwashombola mʉbo mo ikumi na babɨrɨ mwalʉkabo mo <char style="w">bathʉmwa</char>. <verse eid="LUK 6:13" /><verse number="14" style="v" sid="LUK 6:14" />N'abathʉmwa abo babano: Simoni, yo Yesʉ ahaga erɨtsɨna lya Petero, na Ndereya mʉgala wabo, na Yakobo na Yoani, na Filipo na Barɨtolomayo, <verse eid="LUK 6:14" /><verse number="15" style="v" sid="LUK 6:15" />na Matayo na Tomasɨ, Yakobo mʉgala wa Alʉfayo na Simoni w'omo kɨkembe ky'aBaselote, <verse eid="LUK 6:15" /><verse number="16" style="v" sid="LUK 6:16" />na Yuta mʉgala wa Yakobo na Yuta Isikariote, yo wahotheraga Yesʉ.<verse eid="LUK 6:16" /></para>
  <para style="s">Yesʉ akangɨrɨtsya n'ilamya bakoni</para>
  <para style="r">(<ref loc="MAT 4:23-25">Mat 4:23-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17" />Yesʉ mwandagala ɨthoka ko kɨthwa hagʉma n'abathʉmwa bʉwe abo. Abere ahika habothe-bothe mwimana. Mweyaho kɨkembe ky'<char style="w">abɨga</char> bʉwe na bandɨ bandʉ bangɨ nɨabahʉlʉka mo kɨhʉgo kyoshi ky'iYuteya n'ɨYerʉsalemʉ, n'omo bɨhande by'emiyi y'eTiro n'eSitona emʉsɨke w'engetsɨ. <verse eid="LUK 6:17" /><verse number="18" style="v" sid="LUK 6:18" />Abandʉ abo bahikaga bʉshana n'ɨhʉlɨkɨrɨtsya Yesʉ, n'ilamibwa amakoni wabo. N'abo bagenda abanubibwa <char style="w" lemma="mɨtsɨmʉ">n'emɨtsɨmʉ</char> nabo kuthyo mobalamibwa. <verse eid="LUK 6:18" /><verse number="19" style="v" sid="LUK 6:19" />Abandʉ boshi bagenda abashondya ɨmʉkolako, kʉshangwa akagala kagenda akamʉthokamo n'ilamyabo.<verse eid="LUK 6:19" /></para>
  <para style="s">Ɨgashanɨrwa n'ɨthakɨrwa</para>
  <para style="r">(<ref loc="MAT 5:1-12">Mat 5:1-12</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20" />Yesʉ mwathimbya ko <char style="w" lemma="Abɨga">bɨga</char> bʉwe kw'amesho n'ɨbwɨrabo athɨ:</para>
  <para style="q1" vid="LUK 6:20">«Mwamagashanɨrwa imwe batsene,</para>
  <para style="q1" vid="LUK 6:20">kʉshangwa <char style="w" lemma="Bwamɨ bwa Gongo">oBwamɨ bwa Gongo</char> nɨ buwenyu.<verse eid="LUK 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21" />Mwamagashanɨrwa imwe muwirire lɨno,</para>
  <para style="q1" vid="LUK 6:21">kʉshangwa mwandugutha.</para>
  <para style="q1" vid="LUK 6:21">Mwamagashanɨrwa imwe omʉlɨra munobwire,</para>
  <para style="q1" vid="LUK 6:21">kʉshangwa mwandasheka.<verse eid="LUK 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 6:22" />«Mwamagashanɨrwa imwe, omʉgʉlʉ abandʉ bababayire, babathindire, ababahangya, ababathonga, bʉshana na ngye <char style="w">Mʉgala w'oMʉndʉ</char>. <verse eid="LUK 6:22" /><verse number="23" style="v" sid="LUK 6:23" />Omʉgʉlʉ ebyo byandagenda ebibahikira, mʉgende omʉyɨbwɨra mo lʉmogo, kʉshangwa lʉhembo lʉnene lubalindire mo lʉbʉla. Nɨ kuthyo kw'obwishe-kʉlʉ wabo bagenda abanubya <char style="w" lemma="Mʉmɨnyeretsɨ">abamɨnyeretsɨ</char>.<verse eid="LUK 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24" />He imwe bashoki mʉlɨ bahanya,</para>
  <para style="q1" vid="LUK 6:24">kʉshangwa mwamalire ɨbona obʉtseme bwenyu.<verse eid="LUK 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25" />Nemwe momuguthire lɨno, mʉlɨ bahanya,</para>
  <para style="q1" vid="LUK 6:25">kʉshangwa mwandafwa nzala.</para>
  <para style="q1" vid="LUK 6:25">Nemwe momʉsheka lɨno, mʉlɨ bahanya,</para>
  <para style="q1" vid="LUK 6:25">kʉshangwa mwandabya mo kɨrɨro na mwandalɨra.<verse eid="LUK 6:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="LUK 6:26" />Mʉlɨ bahanya mo ndambi abandʉ boshi ababahalamba, kʉshangwa nɨ bathyo ko bw'ishe-kʉlʉ wabo bagenda abahalamba <char style="w" lemma="Mʉmɨnyeretsɨ">abamɨnyeretsɨ b'amabesɨ</char>.»<verse eid="LUK 6:26" /></para>
  <para style="s">Mʉgende omʉtsɨɨra esonzigu senyu</para>
  <para style="r">(<ref loc="MAT 5:38-48">Mat 5:38-48</ref>; <ref loc="MAT 7:12">7:12</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27" />Yesʉ mwashʉba negena athɨ: «Hewethuwe imwe momunyihulikiritsye, bɨno byo nyɨbabwɨra: so nzigu senyu, mʉgende omʉtsɨgɨratho. N'abo bobanababaga mʉgende omʉkolerabo bɨbʉya, <verse eid="LUK 6:27" /><verse number="28" style="v" sid="LUK 6:28" />abo banabathakɨra mʉgende omʉshabɨrabo Gongo agashanɨrebo. N'abo babanubya, mʉgende omʉshabɨrabo Gongo. <verse eid="LUK 6:28" /><verse number="29" style="v" sid="LUK 6:29" />Omʉndʉ amakʉbanda ikofi kw'ithema ɨgʉma, ʉmʉthege n'erɨndɨ. N'omʉndʉ amakʉnyaga ekoti umushigire n'esimisi awe. <verse eid="LUK 6:29" /><verse number="30" style="v" sid="LUK 6:30" />Omʉndʉ amakʉshaba kɨndʉ uthamwimagakyo, kʉtse amakʉnyaga kɨndʉ kyawe ʉthashʉba mʉshabakyo ʉthɨ akʉshʉbʉlɨtsyekyo. <verse eid="LUK 6:30" /><verse number="31" style="v" sid="LUK 6:31" />Ebyo omushondya abandʉ babakolere, nemwe kuthyo mʉkolerebyo bo.<verse eid="LUK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32" />«Mwamagenda omʉtsɨɨra bobanabatsɨɨra kuroshi, mwangabona ɨsɨmwa lɨhɨ? Hathalɨ! Ndɨ n'abakoli b'ebɨtsɨbʉ nabo abanatsɨɨra bobatsiirebo! <verse eid="LUK 6:32" /><verse number="33" style="v" sid="LUK 6:33" />Kandɨ mwamagenda omʉkolera ebɨbʉya bo banagenda ababakolerabyo basha, ɨsɨmwa lɨhɨ lyo mwangabona? Ndɨ n'abakoli b'ebɨtsɨbʉ nabo abanakolerana bathyo! <verse eid="LUK 6:33" /><verse number="34" style="v" sid="LUK 6:34" />Kandɨ mwamagenda omʉbweka bo mwetsi ko babafʉha ɨsɨmwa lɨhɨ lyo mwangahabwa? Ndɨ n'abakoli b'ebɨtsɨbʉ nabo abanabweka bo bangafʉhabo!<verse eid="LUK 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 6:35" />«Hewethuwe imwe mʉgende omʉtsɨɨra esonzigu senyu. Mʉgende omʉkoleratho bɨbʉya. Kandɨ mʉgende omʉbweka buthahirayo maha w'ɨshʉbʉlɨtsɨbwa. Aho nɨmwabona lʉhembo lʉnene, kandɨ nimwabya kundu-kundu bana ba Gongo ow'elʉgʉlʉ w'ebyoshi. Kʉshangwa ɨye anakolera ebɨbʉya kw'abo bathasɨma n'abakoli b'ebɨtsɨbʉ. <verse eid="LUK 6:35" /><verse number="36" style="v" sid="LUK 6:36" />Mʉgende omʉshashɨrana nga Thatha wenyu kw'anabashashɨra.»<verse eid="LUK 6:36" /></para>
  <para style="s">Mʉthagenda omʉlola ko bɨbɨ by'abandɨ kuroshi</para>
  <para style="r">(<ref loc="MAT 7:1-5">Mat 7:1-5</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37" />Yesʉ mwashʉba negena athɨ: «Mʉthagenda omʉsoha abandɨ bandʉ, nemwe kuthyo bathɨndagende abalola ko bɨbɨ byenyu. Mʉthagenda omʉha abandɨ bandʉ bo malipisi, nemwe kuthyo mʉthɨndahabwe malipisi. Hewethuwe mʉgende omʉganyɨrana nemwe kuthyo mwandaganyɨrwa. <verse eid="LUK 6:37" /><verse number="38" style="v" sid="LUK 6:38" />Mʉgende omʉhana nemwe mwandahabwa. N'ebyo mwandahabwa byandabya nibilengire kʉbʉya, nibishokire, nibithenganibwe, kandɨ nibyotswire kʉbʉya mo bɨthonga byenyu. Nga k'omʉnalengera abandɨ, nemwe kuthyo ko Gongo andabalengera.»<verse eid="LUK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39" />Kandɨ Yesʉ mwatsɨrabo omushinga ono athɨ: «Embumi yanganashondolera eyɨndɨ mbumi? Ɨhɨ! Amayɨra athyo ababɨrɨ boshi kundu-kundu nɨbathogera mo kyuna! <verse eid="LUK 6:39" /><verse number="40" style="v" sid="LUK 6:40" /><char style="w" lemma="Abɨga">Omwɨga</char> athalengitsye omʉkangɨrɨtsya ʉwe. Hewethuwe <char style="w" lemma="Abɨga">omwɨga</char> yo wamamala ɨkangɨrɨtsɨbwa kʉbʉya n'ɨye yo wangabya ng'omʉkangɨrɨtsya ʉwe.<verse eid="LUK 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41" />«Bʉshana na ki ʉshʉnga ko kathɨ kalɨ mo lisho lya mʉgala enyu, he niuthashungire ko kithika kɨrɨ mo lisho lyawe? <verse eid="LUK 6:41" /><verse number="42" style="v" sid="LUK 6:42" />Bʉshana na ki ʉbwɨra mʉgala enyu ʉthɨ: “Lika nyithokye akathɨ ko kalɨ mo lisho lyawe,” hewethuwe mo lɨwawe nɨmʉkɨnalɨ mʉthɨ? Ɨwe muyimbya! Thanga wathokya omʉthɨ owalɨ mo lisho lyawe, nɨmo walola kʉbʉya ng'oko wathokya akathɨ akalɨ mo lisho lya mʉgala enyu!»<verse eid="LUK 6:42" /></para>
  <para style="s">Omʉndʉ anamɨnyɨkala ko mɨnegenere yɨwe</para>
  <para style="r">(<ref loc="MAT 7:16-20">Mat 7:16-20</ref>; <ref loc="MAT 12:33-35">12:33-35</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43" />Kandɨ Yesʉ mwanegena athɨ: «Hathalɨ mʉthɨ akwirire w'angaheka biguma bɨbɨ, kʉtse hathalɨ mʉthɨ mʉbɨ w'angaheka biguma bikwirire. <verse eid="LUK 6:43" /><verse number="44" style="v" sid="LUK 6:44" />Obʉlɨ mʉthɨ anagenda amɨnyɨkala ko biguma byawo. Abandʉ bathoha biguma bya mʉthɨ w'omutini ko mɨgando. Kʉtse <char style="w" lemma="Musabibu">by'emisabibu</char> ko mɨshakɨshakɨ. <verse eid="LUK 6:44" /><verse number="45" style="v" sid="LUK 6:45" />Na kuthyo mʉndʉ mʉbʉya anagenda anegena bɨnwa bɨbʉya byo bɨthoka mo mʉthɨma ʉwe. Hewethuwe omʉndʉ mʉbɨ ɨye, ebɨbɨ anagenda anegena ebɨnathoka mo bɨbɨ byo byotswire mo mʉthɨma ʉwe. Kʉshangwa obʉnʉ bw'omʉndʉ obʉnanegena ebyo byotswire mo mʉthɨma ʉwe.»<verse eid="LUK 6:45" /></para>
  <para style="s">Mushinga wa bahimbi babɨrɨ</para>
  <para style="r">(<ref loc="MAT 7:24-27">Mat 7:24-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46" />Yesʉ mwashʉba negena athɨ: «Bʉshana na ki omʉnyahʉla mʉthɨ: “Nyinya-kowethʉ, Nyinya-kowethʉ,” kandɨ nɨmʉthalɨ omʉnakola ebyo enyɨbabwɨra? <verse eid="LUK 6:46" /><verse number="47" style="v" sid="LUK 6:47" />Nyabakangya nga kw'ashoshire omʉndʉ yo unyikwamire na yo ʉhʉlɨkɨrɨtsya ebɨnwa byaye n'ɨkola nga ko binegenire. <verse eid="LUK 6:47" /><verse number="48" style="v" sid="LUK 6:48" />Ashoshire nga mʉndʉ ahimbaga nyʉmba. Mwathanga ithima kʉtsɨbʉ mo kɨthaka ihika okw'ibwe. Na okw'ibwe eryo kwahiraga omʉsɨngɨ ahimbagako enyʉmba. Envʉla y'ekithi yabere yawa olwitsi molwotsula n'ametsi walo mwayihuma ko nyʉmba eyo hewethuwe mwalemwa ithengania enyʉmba eyo kʉshangwa yabyaga niyishikire. <verse eid="LUK 6:48" /><verse number="49" style="v" sid="LUK 6:49" />Hewethuwe omʉndʉ yo wonvwa ebɨnwa byaye bʉthakola ng'oko binegenire, ashoshire mʉndʉ yo wahimbaga enyʉmba yɨwe ko kɨthaka buthathima aho ahira omʉsɨngɨ. Olwitsi lwabere lwotsula ametsi walo mwayihuma ko nyʉmba eyo aho n'aho moyathera n'ɨshambʉkala loshi.»<verse eid="LUK 6:49" /></para>
  <chapter eid="LUK 6" />
  <chapter number="7" style="c" sid="LUK 7" />
  <para style="s">Yesʉ alamya mʉgombe w'omʉkʉlʉ w'abashirikani b'aBaroma</para>
  <para style="r">(<ref loc="MAT 8:5-13">Mat 8:5-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1" />Yesʉ abere amamala ɨnegena ebɨnwa byoshi eby'abwɨraga abandʉ bo bagenda abamʉhʉlɨkɨrɨtsya, mwaya mo muyi w'ɨKaperenaʉmʉ. <verse eid="LUK 7:1" /><verse number="2" style="v" sid="LUK 7:2" />Ko muyi oyo kwabyaga mʉkʉlʉ mʉgʉma w'abashirikani <char style="w" lemma="Roma">b'aBaroma</char>. Omʉkʉlʉ oyo abyaga awithe mʉgombe yo abyaga atsiire kʉtsɨbʉ. Omʉgombe oyo abyaga niathohire. <verse eid="LUK 7:2" /><verse number="3" style="v" sid="LUK 7:3" />Omʉkʉlʉ oyo mwonvwa ebyo bandʉ bagenda abanegena kʉ Yesʉ. Aho mwathʉmɨra Yesʉ yo bangʉmwa bagʉma ba <char style="w">Bayuta</char> bamʉshabe ahike alamye omʉgombe ʉwe. <verse eid="LUK 7:3" /><verse number="4" style="v" sid="LUK 7:4" />Abangʉmwa abo babere bahika ho Yesʉ abyaga, mobamʉshaba kʉtsɨbʉ n'ɨnegena bathɨ: «Ʉkolere omʉndʉ oyu ebyo akʉshaba, kʉshangwa atholere ɨkolerwabyo. <verse eid="LUK 7:4" /><verse number="5" style="v" sid="LUK 7:5" />Kʉshangwa ɨye atsiire ekɨhʉgo kyethʉ, kandɨ nɨ ɨye yo wathuhimbiraga <char style="w" lemma="Sinakoki">esinakoki</char> ethʉ.»<verse eid="LUK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 7:6" />Aho Yesʉ mwagenda n'abangʉmwa abo. Abere ahika hofɨ n'enyʉmba y'omʉkʉlʉ, omʉkʉlʉ oyo mwathʉma bira bʉwe bamʉbwɨrɨre Yesʉ bathɨ: «Nyinya-kowethʉ, uthayiluhaya ihika, kʉshangwa ingye nyɨthatholere ɨwe wɨngɨre omwaye. <verse eid="LUK 7:6" /><verse number="7" style="v" sid="LUK 7:7" />Kyo kɨthaleka nyithayakushondya ngyowene, hewethuwe ɨwe negena kɨnwa kɨgʉma kuroshi omʉgombe aye alama. <verse eid="LUK 7:7" /><verse number="8" style="v" sid="LUK 7:8" />Kʉshangwa na ngye nyiwithe bakʉlʉ bo bananyɨthegeka. Na ngye kuthyo, nyiwithe bashirikani bo nyɨnathegeka. Nyamabwɨra mʉgʉma nyɨthɨ: “Genda!” Nɨagenda. Na nyamabwɨra ʉndɨ nyɨthɨ: “Hika!” Naye niahika. Kandɨ, nyamabwɨra omʉgombe aye nyɨthɨ: “Kola kɨno!” Naye nɨakolakyo.»<verse eid="LUK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9" />Yesʉ abere onvwa ebyo mwashweka bʉshana n'omʉkʉlʉ w'abashirikani oyo. Mwabɨndʉkɨra omuhindano w'abandʉ bo babyaga bamukwamire na mwanegena athɨ: «Enyɨbabwɨra, ko mo kɨhʉgo kyoshi <char style="w" lemma="Isiraeli">ky'iIsiraeli</char> nyithetsi nyashʉnga mʉndʉ wa lwɨkɨrɨtsyo lʉnene ng'oyu.»<verse eid="LUK 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 7:10" />Abo bathʉmawa n'omʉkʉlʉ w'abashirikani mobashʉba eka. Mobeya omʉgombe nialamire.<verse eid="LUK 7:10" /></para>
  <para style="s">Yesʉ amalubukya omwana w'omʉshʉmbakatsɨ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11" />Honyuma kw'aho, Yesʉ mwaya mʉ muyi mʉgʉma ow'agenda ahʉlwamo Naina. <char style="w">Abɨga</char> bʉwe na muhindano mʉnene wa bandʉ mobagendania naye. <verse eid="LUK 7:11" /><verse number="12" style="v" sid="LUK 7:12" />Abere ahika hofɨ n'olukyo lw'orʉba lo lwabyaga luthimbire ko muyi, mwahindana na bandʉ bo bagenda abayatha kinda kya mʉtsana. Omʉtsana oyo abyaga mwana kyʉsha kya mʉshʉmbakatsɨ. Bandʉ bangɨ b'omo muyi oyo nɨbaherekeretsye omʉshʉmbakatsɨ oyo. <verse eid="LUK 7:12" /><verse number="13" style="v" sid="LUK 7:13" />Nyinya-kowethʉ abere ashʉnga omʉshʉmbakatsɨ oyo, mwamʉfwɨra shashi kʉtsɨbʉ, mwamʉbwɨra athɨ: «Ʉthalɨraga!»<verse eid="LUK 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 7:14" />Yesʉ mwayɨfʉnda hofɨ n'esanduku eyo, mwakola kʉro. Abandʉ bo babyaga bahekirero mobimana. Yesʉ mwanegena athɨ: «Mʉtsana, enyɨkʉhamʉla, bʉka!» <verse eid="LUK 7:14" /><verse number="15" style="v" sid="LUK 7:15" />Omʉtsana yo wabyaga afwire mwabʉka. Mwikala mwathanga ɨnegena. Yesʉ mwamʉheretsya nyinya ʉwe.<verse eid="LUK 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16" />Abandʉ boshi mobafwa bʉba, mobasingya Gongo nɨabanegena bathɨ: «<char style="w" lemma="Mʉmɨnyeretsɨ">Mʉmɨnyeretsɨ</char> mʉkʉlʉ amahʉlʉka mo kathi kethʉ!» Mobashʉba negena bathɨ: «Gongo mwahika ɨshabʉla abandʉ bʉwe!» <verse eid="LUK 7:16" /><verse number="17" style="v" sid="LUK 7:17" />Omwatsɨ w'ebyo Yesʉ akolaga mwagenda mo kɨhʉgo kyoshi ky'iYuteya n'omo bɨndɨ bɨhʉgo byoshi byo byabyaga bithimbire kʉkyo.<verse eid="LUK 7:17" /></para>
  <para style="s">Yoani Mubatisya athʉma abɨga bʉwe kʉ Yesʉ</para>
  <para style="r">(<ref loc="MAT 11:2-19">Mat 11:2-19</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18" />Ebɨnwa byoshi ebyo <char style="w">abɨga</char> ba Yoani mobamʉfʉlɨrabyo. Bʉshana n'ebyo Yoani mwabɨrɨkɨra mʉbo mo babɨrɨ. <verse eid="LUK 7:18" /><verse number="19" style="v" sid="LUK 7:19" />Mwathʉmabo eyɨrɨ Nyinya-kowethʉ bamʉbʉtsye bathɨ: «Ɨwe, we <char style="w" lemma="Kirisito, Masia">Masia</char> wahikire? Kʉtse thʉlɨnde ʉndɨ?» <verse eid="LUK 7:19" /><verse number="20" style="v" sid="LUK 7:20" /><char style="w">Abɨga</char> abo mobahika ho Yesʉ abyaga. Mobamʉbwɨra bathɨ: «Yoani <char style="w" lemma="Lubatiso">Mubatisya</char> amathʉthʉma yo ʉlɨ thʉkʉbʉtsye thʉthɨ: “Ɨwe, we <char style="w" lemma="Kirisito, Masia">Masia</char> wahikire? Kʉtse thʉlɨnde ʉndɨ?”»<verse eid="LUK 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21" />Mo ndambi eyo Yesʉ mwalamya bandʉ bangɨ bo bagenda abagalwa n'amakoni, n'abo babyaga bɨrema, n'abo babyagako <char style="w" lemma="mɨtsɨmʉ">abatsɨmʉ</char>. Na mwaha kuthyo esombumi s'olʉkogo lw'ɨshʉba lola. <verse eid="LUK 7:21" /><verse number="22" style="v" sid="LUK 7:22" />Honyuma kw'aho, Yesʉ mwashʉbɨtsya <char style="w">abɨga</char> ba Yoani athɨ: «Mʉgende mʉyabwɨre Yoani ebɨnwa mwamashʉnga n'ebyo mwamwonvwa. Esombumi sahera esɨlola, n'ebɨrema byahera ebɨgenda, n'ababenzɨ abetsɨbwa, n'abathwithwi bahera abonvwa, n'abaholi abalubukibwa, n'abatsene abafʉlɨrwa <char style="w" lemma="Ngʉlʉ Mbʉya">eNgʉlʉ Mbʉya</char>.<note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="xt" closed="false">Soma <ref loc="ISA 35:5-6">Isaya 35:5-6</ref>; <ref loc="ISA 61:1">61:1</ref>.</char></note> <verse eid="LUK 7:22" /><verse number="23" style="v" sid="LUK 7:23" />Agashanɨrwe omʉndʉ yo ʉthɨndahetsye olwɨkɨrɨtsyo lʉwe mw'ingye!»<verse eid="LUK 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24" />
    <char style="w">Abɨga</char> ba Yoani abo mobashʉbʉla. Yesʉ mwathanga ɨbwɨra muhindano w'abandʉ omwatsɨ wa Yoani athɨ: «Mwayaga mo <char style="w">mbwarara</char> nɨomʉyashʉngayo ku ki? Nɨ lʉsheke lo lunathenganibwa n'omʉyaga? Kiro! <verse eid="LUK 7:24" /><verse number="25" style="v" sid="LUK 7:25" />Ewono mwayaga lola ku ki? Mʉndʉ ambithe ngɨmba s'ekɨtsɨro kɨnene? Kiro! Abo banagenda abambala esongɨmba s'ekɨtsɨro kɨnene n'ikala mo bushoki, bikere mo manyʉmba w'obwamɨ! <verse eid="LUK 7:25" /><verse number="26" style="v" sid="LUK 7:26" />Mwayaga lola ku ki? <char style="w" lemma="Mʉmɨnyeretsɨ">Mʉmɨnyeretsɨ</char>? Ega, enyɨbabwɨra ɨye alengitsye <char style="w" lemma="Mʉmɨnyeretsɨ">mʉmɨnyeretsɨ</char>. <verse eid="LUK 7:26" /><verse number="27" style="v" sid="LUK 7:27" />Na bʉshana n'oyo, bishakirwe kw'ɨye mo Mashako Abuyirire bɨthɨ:</para>
  <para style="q1" vid="LUK 7:27">“Mwonvwe! Nyathʉma omugendi aye akʉthange embere,</para>
  <para style="q1" vid="LUK 7:27">bʉshana akʉkometsye enzɨra.<note caller="+" style="f"><char style="fr" closed="false">7:27 </char><char style="xt" closed="false">Soma <ref loc="MAL 3:1">Malaki 3:1</ref>.</char></note>”<verse eid="LUK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 7:28" />«Enyɨbabwɨra, mo bandʉ boshi b'omo kɨhʉgo kɨno, mʉthalɨ yogulengitsye Yoani. Hewethuwe namo bɨnalɨ bithyo omʉke kʉtsɨbʉ mo <char style="w">Bwamɨ bwa Gongo</char>, oyo nɨ mʉkʉlʉ kw'ɨmʉlenga.» <verse eid="LUK 7:28" /><verse number="29" style="v" sid="LUK 7:29" />Abandʉ boshi n'abakarani b'ekoli bo bagenda abahʉlɨkɨrɨtsaga amakangɨrɨtsya wa Yoani, mobamɨnya ko Gongo anagenda akola ebɨthʉnganene ihika ko ndambi <char style="w" lemma="Lubatiso">mobabatisibwa</char> na Yoani. <verse eid="LUK 7:29" /><verse number="30" style="v" sid="LUK 7:30" />Hewethuwe <char style="w" lemma="Bafarisayo:">aBafarisayo</char> n'abakangɨrɨtsya <char style="w" lemma="Mʉgomba">b'oMʉgomba</char> ɨbo mobathɨnda ebyoshi Gongo ashondaga ɨkolerabo. Bʉshana n'ekyo mobayɨthɨndɨra <char style="w" lemma="Lubatiso">ibatisibwa</char> na Yoani.<verse eid="LUK 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31" />Yesʉ mwashʉba negena athɨ: «Abandʉ ba munobwire nyangalinganiabo na ndɨ? Na bashoshekanibwe na ndɨ? <verse eid="LUK 7:31" /><verse number="32" style="v" sid="LUK 7:32" />Bashoshire ng'abana bikere mo mbʉga nɨabathelemeranako bathɨ:</para>
  <para style="q1" vid="LUK 7:32">“Mothʉbabʉhɨra akapʉlɨ momʉthalɨ omʉshatha!</para>
  <para style="q1" vid="LUK 7:32">Mothubwimbira nyimbo sa kɨrɨro momʉthalɨ omʉlɨra!”<verse eid="LUK 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 7:33" />«Kʉshangwa Yoani <char style="w" lemma="Lubatiso">Mubatisya</char> mwahika nianayima akalyo, niayima n'erɨshoma <char style="w" lemma="Tifayi:">etifayi</char> ngendo nyɨngɨ. He momwagenda omʉnegena mʉthɨ: “Alɨko <char style="w" lemma="mɨtsɨmʉ">mʉtsɨmʉ</char>.” <verse eid="LUK 7:33" /><verse number="34" style="v" sid="LUK 7:34" />Ingye <char style="w">Mʉgala w'oMʉndʉ</char> nyabere nyahika, enyirya n'ɨshoma, nemwe omʉnegena mʉthɨ: “Shʉnga omʉndʉ oyu! Nɨ wa kahehu kandɨ nɨ mukundirya, kandɨ nɨ mwira w'abakarani b'ekoli n'abandɨ bakoli b'ebɨtsɨbʉ.” <verse eid="LUK 7:34" /><verse number="35" style="v" sid="LUK 7:35" />Hewethuwe abandʉ boshi bo bɨkɨrɨtsye Gongo, abanashʉnga k'obwenge bʉwe bʉthʉnganene.»<verse eid="LUK 7:35" /></para>
  <para style="s">Yesʉ aganyɨra ebɨtsɨbʉ bya mʉkatsɨ mʉgʉma</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36" />Kɨro kɨgʉma <char style="w" lemma="Bafarisayo:">Mufarisayo</char> mʉgʉma mwabɨrɨkɨra Yesʉ ahike alye ko kalyo mo nyʉmba yɨwe. Yesʉ mwɨngɨra mo nyʉmba <char style="w" lemma="Bafarisayo:">y'oMufarisayo</char> oyo mwikala.<note caller="+" style="f"><char style="fr" closed="false">7:36 </char><char style="ft" closed="false">aBayuta abanabya balɨ abalya abanayɨlambɨka nɨbagemere ko ngokola y'amalembe, n'omuthwe nialolitsye ko lʉgalɨ n'ebɨshando nibilolire embʉga. Soma mʉlondo wa 38.</char></note> Na mwathanga irya. <verse eid="LUK 7:36" /><verse number="37" style="v" sid="LUK 7:37" />Mo muyi oyo mwabyaga mʉkatsɨ mʉgʉma mukoli w'ebɨtsɨbʉ. Omʉkatsɨ oyo abere onvwa ko Yesʉ alya ko kalyo mo nyʉmba <char style="w" lemma="Bafarisayo:">y'oMufarisayo</char> oyo, mwahikamo niahekire murangi wa marasi wa kɨtsɨro kɨnene. <verse eid="LUK 7:37" /><verse number="38" style="v" sid="LUK 7:38" />Mwimana enyuma ya Yesʉ hofɨ n'ebɨshando bɨwe nɨanemʉlɨra. Emishonia yɨwe moyathanga ɨgeretsya ebɨshando bya Yesʉ. Honyuma kw'aho mwashangʉlabyo mo nzwɨrɨ sɨwe. Mwafʉmbatha ebɨshando bya Yesʉ n'ihakabyabyo amarasi ayo.<note caller="+" style="f"><char style="fr" closed="false">7:38 </char><char style="ft" closed="false">Mo mɨbere y'aBayuta, omʉndʉ alɨ ashondya ikangya ogʉndɨ kw'amushikitsye kʉtsɨbʉ agenda amukokya kʉbʉya n'ɨfʉmbatha ebɨshando bɨwe.</char></note><figure style="fig" alt="Une femme pecheresse lave les pieds Jesus par ses larmes" file="WA03839b.tif" size="span" ref="7:38">Mʉkatsɨ mʉgʉma mukoli w'ebɨtsɨbʉ anabya ebɨsando bya Yesʉ mo mishonia yɨwe</figure><verse eid="LUK 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 7:39" />
    <char style="w" lemma="Bafarisayo:">oMufarisayo</char> oyo wabɨrɨkɨraga Yesʉ abere ashʉnga ebyo, mwathanga ɨnegena mo mʉthɨma ʉwe athɨ: «Omʉndʉ oyu angabere <char style="w" lemma="Mʉmɨnyeretsɨ">mʉmɨnyeretsɨ</char> kundu, angaminyire omʉkatsɨ yo ʉmʉkola-kolako nga alɨ athɨ. Kandɨ angaminyire k'omʉkatsɨ oyu nɨ mukoli w'ebɨtsɨbʉ.»<verse eid="LUK 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40" />Yesʉ mwabwɨra oMufarisayo oyo athɨ: «Simoni, nyiwithe kɨnwa ky'ɨkʉbwɨra.» Simoni naye mwashubya athɨ: «Mʉkangɨrɨtsya, negena.» <verse eid="LUK 7:40" /><verse number="41" style="v" sid="LUK 7:41" />Yesʉ mwanegena athɨ: «Kwabyaga bandʉ babɨrɨ bo babyagako mwinda wa mʉndʉ mʉgʉma. Mʉgʉma wa kʉbo abyagako mwinda wa tinari<note caller="+" style="f"><char style="fr" closed="false">7:41 </char><char style="fq" closed="false">Tinari: </char><char style="ft" closed="false">Etinari yabyaga faranga. N'etinari ngʉma yabyaga nɨyɨrɨngene n'olʉhembo lw'omʉthobero mʉgʉma.</char></note> magana athano, n'ogʉndɨ abyagako mwinda wa tinari makumi athano. <verse eid="LUK 7:41" /><verse number="42" style="v" sid="LUK 7:42" />Abandʉ babɨrɨ abo, ng'oko bathabyaga n'obuthoki bw'erɨfʉha eminda eyo, oyo wabwekagabo mwashashɨra ababɨrɨ abo. Ewono, mo bandʉ babɨrɨ abo, nɨ ndɨ yo watsɨɨraga kʉtsɨbʉ omwindiki?» <verse eid="LUK 7:42" /><verse number="43" style="v" sid="LUK 7:43" />Simoni mwashubya athɨ: «Enyɨganɨtsya nyɨthɨ nɨ yo washashɨrawa omwinda mʉnene.» Yesʉ mwamʉbwɨra athɨ: «Wamashubya kʉbʉya.»<verse eid="LUK 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 7:44" />Honyuma kw'aho, Yesʉ mwabɨndʉkɨra eyo omʉkatsɨ abyaga, mwabwɨra Simoni athɨ: «Wanamashʉnga omʉkatsɨ oyu? Monyɨngɨra omwawe mogʉthalɨ oʉnyɨha metsi w'ɨnaba ko bɨshando. He omʉkatsɨ oyu ɨye, amanabya ebɨshando byaye mo mishonia yɨwe, na amashangʉlabyo mo nzwɨrɨ sɨwe. <verse eid="LUK 7:44" /><verse number="45" style="v" sid="LUK 7:45" />Mogʉthalɨ ʉnyɨfʉmbatha mw'ɨnyɨketsya. He omʉkatsɨ oyu, ho nyithahikira mo nyʉmba eno, athathangire alika ɨfʉmbatha ebɨshando byaye. <verse eid="LUK 7:45" /><verse number="46" style="v" sid="LUK 7:46" />Mogʉthalɨ unyihakabya mafʉtha ko muthwe aye, he ɨye mwanyɨhakabya marasi ko bɨshando byaye.<note caller="+" style="f"><char style="fr" closed="false">7:46 </char><char style="ft" closed="false">Ko Bayuta omugeni amahika abanagenda abamukokya mw'ɨmʉha metsi w'ɨnaba ko bɨshando, mʉ mw'ɨfʉmbatha, na omw'ɨmʉhaka marasi.</char></note> <verse eid="LUK 7:46" /><verse number="47" style="v" sid="LUK 7:47" />Bʉshana n'ekyo, enyɨkʉbwɨra nyɨthɨ: namo ebɨtsɨbʉ by'omʉkatsi oyu nɨ bɨngɨ, nyamaganyɨra ebyoshi. Nɨ bʉshana n'ekyo akangya kw'anyanzire kʉtsɨbʉ. Hewethuwe omʉndʉ yo wamalire ɨganyɨrwa kʉke, ananza kʉke.»<verse eid="LUK 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48" />Aho Yesʉ mwabwɨra omʉkatsɨ oyo athɨ: «Ebɨtsɨbʉ byawe byamaganyɨrwa.»<verse eid="LUK 7:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49" />Abandɨ bandʉ bo bagenda abalya hagʉma na Yesʉ mobathanga ibutsania ɨbo kw'ɨbo bathɨ: «Oyu nɨ ndɨ yo wangaganyɨra ebɨtsɨbʉ?» <verse eid="LUK 7:49" /><verse number="50" style="v" sid="LUK 7:50" />Hewethuwe Yesʉ mwabwɨra omʉkatsɨ oyo athɨ: «Olwɨkɨrɨtsyo lwawe lwamakʉshabʉla. Genda mʉ bʉholo.»<verse eid="LUK 7:50" /></para>
  <chapter eid="LUK 7" />
  <chapter number="8" style="c" sid="LUK 8" />
  <para style="s">Abakatsɨ bo bagenda abawathikya Yesʉ ko mʉlɨmo ʉwe</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1" />Honyuma kw'aho, Yesʉ mwathimba mo miyi n'omo mɨrongo, bʉshana n'ɨkangɨrɨtsya n'ɨfʉlɨra abandʉ <char style="w" lemma="Ngʉlʉ Mbʉya">bw'eNgʉlʉ Mbʉya</char> <char style="w" lemma="Bwamɨ bwa Gongo">y'oBwamɨ bwa Gongo</char>. Abyaga hagʉma n'abathʉmwa bʉwe ikumi na babɨrɨ. <verse eid="LUK 8:1" /><verse number="2" style="v" sid="LUK 8:2" />Kandɨ abyaga hagʉma na bakatsɨ bagʉma, abo athokayako <char style="w" lemma="mɨtsɨmʉ">emɨtsɨmʉ mɨbɨ</char> n'ilamyabo makoni. Mo bakatsɨ abo mwabyaga: Marɨa w'omo muyi w'ɨMangandala, Marɨa oyo, Yesʉ mwamuthokyako <char style="w">mɨtsɨmʉ</char> ɨrɨnda, <verse eid="LUK 8:2" /><verse number="3" style="v" sid="LUK 8:3" />na Yane mʉka Kusa. Ye Kʉsa oyo yo wabyaga imanire obushoki bwa <char style="w">Herote</char>. Na mo bakatsɨ abo mwabyaga Sʉsana, na bandɨ bakatsɨ bangɨ. Nɨabakatsɨ abo bo bagenda abahana ko bushoki bwabo mw'iwathikya Yesʉ n'abathʉmwa bʉwe.<verse eid="LUK 8:3" /></para>
  <para style="s">Mushinga w'omuheri w'embʉtho</para>
  <para style="r">(<ref loc="MAT 13:1-17">Mat 13:1-17</ref>; <ref loc="MRK 4:1-9">Mar 4:1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4" />Bandʉ bangɨ bagenda abathoka mo bʉlɨ muyi, bʉshana bayahindane na Yesʉ. Yesʉ mwatsɨrabo mushinga athɨ: <verse eid="LUK 8:4" /><verse number="5" style="v" sid="LUK 8:5" />«Muheri mʉgʉma mwayabɨba mbʉtho mw'ɨshwa lɨwe. Mo ndambi agenda abɨba esombʉtho sɨwe, mbʉtho ngʉma mosathogera emʉsɨke w'enzɨra. Abandʉ mobalyathangatho, n'emɨronge moyalyatho. <verse eid="LUK 8:5" /><verse number="6" style="v" sid="LUK 8:6" />Esɨndɨ mosathogera ko mabwe. Sabere salasha, mosʉma bʉshana n'erɨbʉsha metsi mo kɨthaka. <verse eid="LUK 8:6" /><verse number="7" style="v" sid="LUK 8:7" />Sɨndɨ mbʉtho mosathogongera mo mɨshakɨ. Emɨshakɨ eyo moyalasha hagʉma n'esombʉtho, na moyayɨndɨrɨtsyatho. <verse eid="LUK 8:7" /><verse number="8" style="v" sid="LUK 8:8" />Esɨndɨ ɨtho, mosathogera ko kɨthaka kikwirire. Sabere sakʉla mosaheka bɨkʉmba. Bʉlɨ kɨkʉmba mokyaheka mbulu igana-igana.» Yesʉ abere amala ɨbwɨrabo ebyo, mwanegena athɨ: «Yo uwithe mathwi w'ɨonvwa, onvwe!»<verse eid="LUK 8:8" /></para>
  <para style="s">Bʉshana na ki Yesʉ asɨmola mo mishinga</para>
  <para style="r">(<ref loc="MAT 13:10-17">Mat 13:10-17</ref>; <ref loc="MRK 4:10-12">Mar 4:10-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9" />
    <char style="w">Abɨga</char> ba Yesʉ mobamʉbʉtsya ng'omushinga oyu ashondya ɨnegena athɨ ki. <verse eid="LUK 8:9" /><verse number="10" style="v" sid="LUK 8:10" />Yesʉ mwashʉbɨtsyabo athɨ: «Imwe momwahabwa ɨmɨnya bɨnwa bibishire by'omo <char style="w">Bwamɨ bwa Gongo</char>. He abandɨ ɨbo, lɨtholere nɨnyabwɨrabo mo mishinga, bʉshana</para>
  <para style="q1" vid="LUK 8:10">“bagende abalola, he nɨbathɨshʉnge.</para>
  <para style="q1" vid="LUK 8:10">Bagende abonvwa, he nɨbathɨonvwe.<note caller="+" style="f"><char style="fr" closed="false">8:10 </char><char style="xt" closed="false">Soma <ref loc="ISA 6:9">Isaya 6:9</ref>.</char></note>”»<verse eid="LUK 8:10" /></para>
  <para style="s">Yesʉ akumbulira omushinga w'omuheri w'embʉtho</para>
  <para style="r">(<ref loc="MAT 13:18-23">Mat 13:18-23</ref>; <ref loc="MRK 4:13-20">Mar 4:13-20</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11" />Kandɨ Yesʉ mwanegena athɨ: «Athya k'omushinga ono anegenire: Embʉtho nɨ <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char>. <verse eid="LUK 8:11" /><verse number="12" style="v" sid="LUK 8:12" />Esombʉtho so sathogeraga emʉsɨke w'enzɨra, sishoshekanibwe n'abandʉ bo banonvwa <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char>. Honyuma kw'aho <char style="w" lemma="Sitani">Sitani</char> niahika niathokyakyo mo mɨthɨma yabo, bʉshana bathɨkɨrɨtsyaga n'ɨshabʉlwa. <verse eid="LUK 8:12" /><verse number="13" style="v" sid="LUK 8:13" />N'esombʉtho so sathogeraga ko mabwe, sishoshekanibwe n'abandʉ bobanahʉlɨkɨrɨtsya <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char> n'ikokyakyo mo lʉmogo. Hewethuwe eKɨnwa ekyo kithashika kʉbʉya mo mɨthɨma yabo. Abanɨkɨrɨtsyakyo mʉ kathambi kake kuroshi, erɨlengwako erinabya lyahikirabo nibamikakyo. <verse eid="LUK 8:13" /><verse number="14" style="v" sid="LUK 8:14" />N'esɨndɨ mbʉtho so sathogeraga mo mɨshakɨ, sishoshekanibwe n'abandʉ bobanonvwa <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char>. Hewethuwe emɨnʉbo n'obushoki n'erɨtsɨɨra ebɨndʉ by'omo kɨhʉgo kɨno, ebɨnayɨndɨgɨrɨtsya eKɨnwa ekyo mo mɨthɨma yabo. Bʉshana n'ekyo, bathaheka biguma byerire. <verse eid="LUK 8:14" /><verse number="15" style="v" sid="LUK 8:15" />N'esombʉtho so sathogeraga mo kɨthaka kikwirire, ɨtho sishoshekanibwe n'abandʉ bo banonvwa <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char> n'omʉthɨma akwirire, na ow'athʉnganene. Abo bo banabɨka eKɨnwa ekyo mw'itsitsinia ihika ko kɨka ky'ɨheka biguma.»<verse eid="LUK 8:15" /></para>
  <para style="s">Mushinga w'etara</para>
  <para style="r">(<ref loc="MRK 4:21-25">Mar 4:21-25</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16" />Yesʉ mwashʉba negena kandɨ athɨ: «Hathalɨ mʉndʉ yo wanganokya etara n'ɨshwɨkaro kɨthonga kʉtse ihiraro omw'ishangɨngo. Hewethuwe anagenda ahiraro kw'ihango, bʉshana abo bɨngɨra mo nyʉmba bashʉnge ekyakakala. <verse eid="LUK 8:16" /><verse number="17" style="v" sid="LUK 8:17" />Bʉlɨ kɨndʉ kibishire kyandabishulwa kʉbʉya-kʉbʉya. N'obʉlɨ kɨndʉ kyo kɨkoleka mo bubisho-bisho kyandamɨnyɨkala kʉbʉya-kʉbʉya. <verse eid="LUK 8:17" /><verse number="18" style="v" sid="LUK 8:18" />Bʉshana n'ekyo muyitheye ko bɨnwa byo mwonvwa! Kʉshangwa nɨ omʉndʉ yo uwithe kɨndʉ yo ʉnahabwa kɨndɨ. He oyo uthawithe kɨndʉ andanyagʉlwa n'ekyo aganɨtsya kw'awitheko.»<verse eid="LUK 8:18" /></para>
  <para style="s">Abagala babo Yesʉ na nyinya ʉwe</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mat 12:46-50</ref>; <ref loc="MRK 3:31-35">Mar 3:31-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19" />Kɨro kɨgʉma bagala babo Yesʉ na nyinya ʉwe mobayamushondya. Hewethuwe mobathakotsya imuhikako bʉshana n'omuhindano w'abandʉ. <verse eid="LUK 8:19" /><verse number="20" style="v" sid="LUK 8:20" />Abandʉ mobabwɨra Yesʉ bathɨ: «Bagala benyu na nyoko bimene embʉga abashondya ɨkʉshʉnga.» <verse eid="LUK 8:20" /><verse number="21" style="v" sid="LUK 8:21" />He Yesʉ mwabwɨrabo athɨ: «Bagala bethʉ na malɨ nɨ bo banonvwa <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char> n'ɨkola nga ko kinegenire.»<verse eid="LUK 8:21" /></para>
  <para style="s">Yesʉ abombetsya embeho n'emibimbi</para>
  <para style="r">(<ref loc="MAT 8:23-27">Mat 8:23-27</ref>; <ref loc="MRK 4:35-41">Mar 4:35-41</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22" />Kɨro kɨgʉma Yesʉ mwashambɨra mʉ bwatho bʉgʉma hagʉma <char style="w" lemma="Abɨga">n'abɨga</char> bʉwe. Mwabwɨrabo athɨ: «Thʉshabʉkɨre ko ʉndɨ mwishirya w'engetsɨ.» Nabo mobagenda.<verse eid="LUK 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 8:23" />Babere banalɨ abatsa engetsɨ, Yesʉ mwayatho. Aho n'aho, mbeho nzɨbʉ moyayihuma ko ngetsɨ. Ametsi mwathanga ɨngɨra mo bwatho, nabo mobabya hofɨ n'ɨshenda. <verse eid="LUK 8:23" /><verse number="24" style="v" sid="LUK 8:24" />Mobayɨfʉnda ahalɨ Yesʉ mobamubukya n'ɨnegena bathɨ: «Mʉkangɨrɨtsya, Mʉkangɨrɨtsya, thwahwa!»</para>
  <para style="p" vid="LUK 8:24">Yesʉ mwabʉka mwakemera kʉtsɨbʉ embeho n'emibimbi, nabyo mobyabombera, mokwabya shereri. <verse eid="LUK 8:24" /><verse number="25" style="v" sid="LUK 8:25" />Aho, Yesʉ mwabʉtsyabo athɨ: «Olwɨkɨrɨtsyo lwenyu lʉlɨ hayi?» Nabo mobʉbaha n'ɨshweka kʉtsɨbʉ nɨababwɨrana bathɨ: «Oyu nɨ mʉndʉ mʉhanda ki? Yo ʉthegeka embeho n'emibimbi nabyo nibyamushikya!»<verse eid="LUK 8:25" /></para>
  <para style="s">Yesʉ abɨnga mɨtsɨmʉ mɨbɨ kʉ mʉndʉ</para>
  <para style="r">(<ref loc="MAT 8:28-34">Mat 8:28-34</ref>; <ref loc="MRK 5:1-20">Mar 5:1-20</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26" />Honyuma kw'aho, Yesʉ n'<char style="w">abɨga</char> bʉwe mobashabʉka engetsɨ n'ɨgobeka obwatho mo kɨhʉgo ky'aBangerasi mwishirya na mwishirya w'ekɨhʉgo ky'iNgalilaya. <verse eid="LUK 8:26" /><verse number="27" style="v" sid="LUK 8:27" />Yesʉ abere akɨnalɨ akima mo bwatho, mʉndʉ mʉgʉma w'omo muyi mwayɨfʉnda ahalɨ Yesʉ. Omʉndʉ oyo abyagako mɨtsɨmʉ mɨbɨ. Mʉ bɨro bɨngɨ niathashubire ɨambala lʉkɨmba, niathashubire ikala mʉ nyʉmba, he kona ko masɨnda. <verse eid="LUK 8:27" /><verse number="28" style="v" sid="LUK 8:28" />Abere ashʉnga Yesʉ mwahambala, mwawa embere s'ebɨshando bɨwe. Mwahambala kʉtsɨbʉ athɨ: «Yesʉ, <char style="w">Mʉgala wa Gongo</char> yo ʉlɨ elʉgʉlʉ w'ebyoshi, unyishondya ko ki? Enyɨkʉshaba uthanyinubaya!» <verse eid="LUK 8:28" /><verse number="29" style="v" sid="LUK 8:29" />Mwanegena athyo, kʉshangwa Yesʉ abyaga nɨamahamʉla <char style="w" lemma="mɨtsɨmʉ">omʉtsɨmʉ mʉbɨ</char> oyo athoke ko mʉndʉ oyo. <char style="w" lemma="mɨtsɨmʉ">Omʉtsɨmʉ</char> oyo agenda amunubya ngendo nyɨngɨ. Bʉshana n'ekyo bagenda abamʉmɨna mʉ bʉhʉlʉla n'omo byʉma nɨmo atharombokaga, he agenda atsabyo. <char style="w" lemma="mɨtsɨmʉ">Omʉtsɨmʉ</char> oyo agenda amuhikya ko kɨka ky'ɨmʉthwala <char style="w" lemma="Mbwarara">ahathalɨ bandʉ</char>.<verse eid="LUK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30" />Yesʉ mwamʉbʉtsya athɨ: «Erɨtsɨna lyawe ɨwe ndɨ?» Naye mwashubya athɨ: «Erɨtsɨna lyaye ingye kɨkembe.» Anegenaga ebyo kʉshangwa abyagako <char style="w">mɨtsɨmʉ</char> mɨngɨ. <verse eid="LUK 8:30" /><verse number="31" style="v" sid="LUK 8:31" />Emɨtsɨmʉ eyo moyashaba Yesʉ yɨthɨ athagʉshagaro mo kyuna kɨre ky'okwɨrʉnga.<verse eid="LUK 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32" />N'aho habyaga luhyo lwa ngʉlʉbe, sagenda esishondya kalyo ko kathwa. Emɨtsɨmʉ eyo moyashaba Yesʉ yɨthɨ: «Kishi kishi! Thʉhamʉle thwɨngɨre mo so ngʉlʉbe esi.» Naye mwahamʉlaro. <verse eid="LUK 8:32" /><verse number="33" style="v" sid="LUK 8:33" />Aho n'aho, <char style="w" lemma="mɨtsɨmʉ">emɨtsɨmʉ mɨbɨ</char> eyo moyathoka ko mʉndʉ oyo, moyayɨngɨra mo so ngʉlʉbe etho. Oluhyo loshi lw'esongʉlʉbe etho mosahʉrʉmʉka ko kathwa nɨesɨthɨbɨtha eyɨrɨ engetsɨ, aho n'aho, mosathogongera mo ngetsɨ n'esoshi mosashenda.<verse eid="LUK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34" />Abalishya b'esongʉlʉbe etho babere bashʉnga kw'ebyo, mobagenda tsʉba mo muyi n'omo thʉnzalɨ n'ɨyafʉlɨra abandʉ b'omwatsɨ oyo. <verse eid="LUK 8:34" /><verse number="35" style="v" sid="LUK 8:35" />Abandʉ mobayalola ko byo bithabya. Babere bahika ho Yesʉ abyaga, mobeya omʉndʉ yo wathokagako <char style="w" lemma="mɨtsɨmʉ">emɨtsɨmʉ</char> mɨbɨ n'ikere hofɨ n'ebɨshando bya Yesʉ. Abyaga nɨahera ambithe, kandɨ nɨahera awithe bwenge bukwirire. Abandʉ mobʉbaha. <verse eid="LUK 8:35" /><verse number="36" style="v" sid="LUK 8:36" />Abandʉ bo bashʉngaga kw'ebyo byatsʉkaga, mobagambʉlɨra abandɨ ng'oko omʉndʉ yo wabyagako emɨtsɨmʉ mɨbɨ athalamibwa.<verse eid="LUK 8:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 8:37" />Aho abandʉ boshi b'omo kɨhʉgo ky'aBangerasi mobabya n'obʉba kʉtsɨbʉ. Bʉshana n'ekyo mobabwɨra Yesʉ bathɨ, athokerebo mo kɨhʉgo kyabo. Aho Yesʉ mwashambɨra mo bwatho mwashʉba eyo athokaga. <verse eid="LUK 8:37" /><verse number="38" style="v" sid="LUK 8:38" />Omʉndʉ yo wathokagako <char style="w" lemma="mɨtsɨmʉ">abatsɨmʉ</char>, mwalemba-lemba Yesʉ athɨ: «Nyangagendire nawe!» He Yesʉ mwamʉshʉbʉtsya n'ɨmʉbwɨra athɨ: <verse eid="LUK 8:38" /><verse number="39" style="v" sid="LUK 8:39" />«Ʉshʉbe ewawe, ʉyafʉlɨre abandʉ bw'ebyoshi Gongo amakʉkolera.»</para>
  <para style="p" vid="LUK 8:39">Omʉndʉ oyo mwathimba mo muyi woshi nɨane mʉfʉlɨra abandʉ bw'ebyoshi Yesʉ athamʉkolera.<verse eid="LUK 8:39" /></para>
  <para style="s">Yesʉ alubukya mwalɨ wa Yairo n'ilamya mʉkatsɨ mʉgʉma</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mat 9:18-26</ref>; <ref loc="MRK 5:21-43">Mar 5:21-43</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40" />Yesʉ abere ashʉbʉla bandʉ bangɨ mobayamukokya, kʉshangwa aboshi babyaga nibamulindirire. <verse eid="LUK 8:40" /><verse number="41" style="v" sid="LUK 8:41" />Mo ndambi eyo, mʉkʉlʉ mʉgʉma <char style="w" lemma="Sinakoki:">w'esinakoki</char> erɨtsɨna lɨwe nɨ yo Yairo mwahika, mwafʉkama embere sa Yesʉ. Mwalemba-lemba Yesʉ ɨngɨre omwe <verse eid="LUK 8:41" /><verse number="42" style="v" sid="LUK 8:42" />kʉshangwa omʉthasha ʉwe abyaga niathohire. Abyaga mʉthasha kyʉsha, niawithe mɨaka hofɨ ikumi n'ibiri.</para>
  <para style="p" vid="LUK 8:42">Yesʉ abere anemʉya ewa Yayiro, muhindano mʉnene wa bandʉ agenda amʉyɨndɨrɨtsya. <verse eid="LUK 8:42" /><verse number="43" style="v" sid="LUK 8:43" />Mo muhindano oyo mwabyaga mʉkatsɨ mʉgʉma yo wabyaga nɨamamala mɨaka ikumi n'ibiri anemʉnʉba mo bukoni bw'ɨthokwamo mʉsasɨ. Abyaga nɨamamala obushoki bʉwe boshi ko bashake hewethuwe mohathabya n'omʉgʉma wa kʉbo yo wamulamyaga. <verse eid="LUK 8:43" /><verse number="44" style="v" sid="LUK 8:44" />Omʉkatsɨ oyo mwahʉlʉkɨra Yesʉ y'enyuma na mwakola ko pindo y'olʉkɨmba lʉwe. Kona kathambi ako obukoni bw'erɨthokamo mʉsasɨ mobwalama.<verse eid="LUK 8:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 8:45" />Yesʉ mwabʉtsya athɨ: «Nɨ ndɨ yo wamanyɨkolako?» Abandʉ boshi mobayɨgana ko hathalɨ yo wamamʉkolako. Aho Petero mwamʉbwɨra athɨ: «Mʉkangɨrɨtsya, uthashungire ko muhindano woshi oyu ow'akuthimbireko n'ɨkʉyɨndɨrɨtsya?» <verse eid="LUK 8:45" /><verse number="46" style="v" sid="LUK 8:46" />Hewethuwe Yesʉ mwanegena athɨ: «Mʉndʉ mʉgʉma mwanyɨkolako, kʉshangwa nyamwonvwa ko kʉlɨ kagala kamanyɨthokamo.»<verse eid="LUK 8:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 8:47" />Omʉkatsɨ oyo abere ashʉnga ko bamamʉmɨnya, mwayɨfʉnda ho Yesʉ abyaga niathithimana bʉshana n'obʉba. Mwafʉkama embere sɨwe. Mwaganʉlɨra mo kathi k'abandʉ boshi kyo kɨthaleka nɨamʉkolako na ko mwalama aho n'aho. <verse eid="LUK 8:47" /><verse number="48" style="v" sid="LUK 8:48" />Aho Yesʉ mwamʉbwɨra athɨ: «Mwalɨ waye, olwɨkɨrɨtsyo lwawe lwamakulamya. Yɨgendere n'obʉholo.»<verse eid="LUK 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49" />Yesʉ abere akɨnalɨ anegena mokwahika mʉndʉ mʉgʉma nɨathoka ewa Yayiro, <char style="w" lemma="Sinakoki">mʉkʉlʉ w'esinakoki</char>. Mwamʉbwɨra athɨ: «Oh mʉkengwa! Mwalɨ wawe athakɨrɨho. Ʉthashʉba luhya oMʉkangɨrɨtsya!» <verse eid="LUK 8:49" /><verse number="50" style="v" sid="LUK 8:50" />Yesʉ abere onvwa ebyo, mwabwɨra Yayiro athɨ: «Ʉthʉbahaga, wɨkɨrɨtsye kuroshi naye alama.»<verse eid="LUK 8:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51" />Yesʉ mwahika ewa Yayiro. Mwathatsɨga ɨngɨra mo nyʉmba na bandɨ bandʉ athalɨ Petero, na Yoani, na Yakobo n'ababuthi b'omwana. <verse eid="LUK 8:51" /><verse number="52" style="v" sid="LUK 8:52" />Abandʉ boshi bagenda abalɨra n'ɨhononokala bʉshana n'olʉholo lw'omʉthasha oyo. Hewethuwe Yesʉ mwabwɨrabo athɨ: «Mʉthalɨraga, kʉshangwa omʉthasha oyu athafwire, he alɨ thʉlo!» <verse eid="LUK 8:52" /><verse number="53" style="v" sid="LUK 8:53" />Babere bonvwa ebyo, mobamʉsheka, kʉshangwa ɨbo babyaga nibetsi ko omʉthasha oyo amalire ɨfwa. <verse eid="LUK 8:53" /><verse number="54" style="v" sid="LUK 8:54" />Hewethuwe Yesʉ mwatsɨmba omʉthasha y'oko kʉboko, mwahambala kʉtsɨbʉ n'ɨnegena athɨ: «Ɨwe mʉthasha, bʉka!» <verse eid="LUK 8:54" /><verse number="55" style="v" sid="LUK 8:55" />Omʉthasha oyo mwashʉba. Aho n'aho, mwimana. Yesʉ mwabwɨra abandʉ athɨ bahe omʉthasha oyo yo kalyo. <verse eid="LUK 8:55" /><verse number="56" style="v" sid="LUK 8:56" />Ababuthi b'omʉthasha oyo, mobashweka kʉtsɨbʉ. Yesʉ mwahangɨrabo athɨ bathanalinda babwɨra mʉndʉ byo bɨthakoleka.<verse eid="LUK 8:56" /></para>
  <chapter eid="LUK 8" />
  <chapter number="9" style="c" sid="LUK 9" />
  <para style="s">Yesʉ athʉma abathʉmwa bʉwe mo mʉlɨmo</para>
  <para style="r">(<ref loc="MAT 10:5-15">Mat 10:5-15</ref>; <ref loc="MRK 6:7-13">Mar 6:7-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1" />Kɨro kɨgʉma Yesʉ mwahindania abathʉmwa bʉwe ikumi na babɨrɨ. Mwahabo kagala n'amaka w'erɨbɨnga <char style="w" lemma="mɨtsɨmʉ">emɨtsɨmʉ mɨbɨ</char> yoshi n'ilamya abakoni. <verse eid="LUK 9:1" /><verse number="2" style="v" sid="LUK 9:2" />Mwathʉmabo bayafʉle engʉlʉ <char style="w" lemma="Bwamɨ bwa Gongo">y'oBwamɨ bwa Gongo</char> n'ilamya bakoni. <verse eid="LUK 9:2" /><verse number="3" style="v" sid="LUK 9:3" />Mwabwɨrabo athɨ: «Mo lʉgendo lwenyu mʉthahekaga kiro na kɨndʉ. Mʉthahekaga, kɨkoma, kʉtse shaho kʉtse kalyo kʉtse faranga. Bʉlɨ mʉndʉ aheke lʉkɨmba lʉgʉma kuroshi. <verse eid="LUK 9:3" /><verse number="4" style="v" sid="LUK 9:4" />Bʉlɨ nyʉmba mwandahʉmbɨrɨramo, mubyemo kw'ihika ekɨro mwandathoka mo muyi oyo. <verse eid="LUK 9:4" /><verse number="5" style="v" sid="LUK 9:5" />Na bʉlɨ muyi abandʉ bamo bandathɨnda ibakokya, mʉyɨthokere mʉwo. He kw'ɨthokamo, mʉkʉngʉthɨrebo oluthuthu lw'oko bɨshando byenyu. Ekyo kyandabya kɨmɨnyɨkalo ko bandʉ abo.<note caller="+" style="f"><char style="fr" closed="false">9:5 </char><char style="ft" closed="false">Ɨkʉngʉtha oluthuthu lw'oko bɨshando ebyo binegenire bɨthɨ omʉndʉ yo ʉthathʉmwa nɨamayɨshangʉlako omʉsasɨ w'omʉndʉ oyo amathɨnda omwatsɨ athaletherwa.</char></note>» <verse eid="LUK 9:5" /><verse number="6" style="v" sid="LUK 9:6" />Aho abathʉmwa mobagenda, nɨabathoka mʉ mʉrongo n'ɨya mʉ ʉndɨ. Bagenda abafʉla <char style="w" lemma="Ngʉlʉ Mbʉya">eNgʉlʉ Mbʉya</char> n'ilamya abakoni bw'ahoshi.<verse eid="LUK 9:6" /></para>
  <para style="s">Herote amathabagana bʉshana n'ebɨnwa bya Yesʉ</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mat 14:1-12</ref>; <ref loc="MRK 6:14-29">Mar 6:14-29</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7" />
    <char style="w">Herote</char> muthegeki w'ekɨhʉgo ky'iNgalilaya mwonvwa ebɨnwa byoshi ebyo. Mwathabagana, kʉshangwa bandʉ bagʉma bagenda abanegena bathɨ: «Nɨ Yoani Mubatisya yo walubukire.» <verse eid="LUK 9:7" /><verse number="8" style="v" sid="LUK 9:8" />N'abandɨ bathɨ nɨ Elia <char style="w" lemma="Mʉmɨnyeretsɨ">mʉmɨnyeretsɨ</char> yo wamahʉlʉka. N'abandɨ bathɨ nɨ mʉgʉma w'oko <char style="w" lemma="Mʉmɨnyeretsɨ">bamɨnyeretsɨ</char> ba kera yo wamalubuka.<verse eid="LUK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 9:9" />He <char style="w">Herote</char> mwanegena athɨ: «N'ingye owene-wene ngyo nyahamʉlaga nyɨthɨ batse omuthwe wa Yoani. Ewono, nɨ mʉndʉ ndɨ oyo yo nyonvwa emyatsɨ yɨwe?» Bʉshana n'ekyo <char style="w">Herote</char> mwashondya ɨshʉnga kʉ Yesʉ.<verse eid="LUK 9:9" /></para>
  <para style="s">Yesʉ uguthya bandʉ bɨhʉmbɨ bɨthano</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mat 14:13-21</ref>; <ref loc="MRK 6:30-44">Mar 6:30-44</ref>; <ref loc="JHN 6:1-14">Yoa 6:1-14</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10" />
    <char style="w" lemma="Bathʉmwa">Abathʉmwa</char> mobashʉbʉla, mobafʉlɨra Yesʉ y'ebɨnwa byoshi bakolaga. Honyuma kw'aho, Yesʉ mwathwalabo hale hake n'abandʉ. Mobaya ko lʉhande lw'omuyi w'iBetesaita.<verse eid="LUK 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 9:11" />He omuhindano w'abandʉ mwamɨnya ko Yesʉ mwaya eyo, mobamʉkwamɨrayo. Mwakokyabo kʉbʉya, mwathanga ɨfʉlɨrabo omwatsɨ owanegenire ko by' <char style="w">oBwamɨ bwa Gongo</char>. N'abo babyaga bakoni mo kathi kabo, mwalamyabo.<verse eid="LUK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12" />Bwabere bwagoroba, abathʉmwa ikumi na babɨrɨ ba Yesʉ mobahika aho abya, n'ɨmʉbwɨra bathɨ: «Mʉkengwa! Hano thʉlɨ hale n'omuyi. Bʉshana n'ekyo nga ʉthabwɨra abandʉ bagende mo mɨrongo eyɨrɨ hofɨ-hofɨ n'omo thʉnzalɨ, bʉshana babone bʉgonzero na eby'erirya.» <verse eid="LUK 9:12" /><verse number="13" style="v" sid="LUK 9:13" />Yesʉ mwabwɨrabo athɨ: «Mʉhebo kalyo imwe bene.» Nabo mobashʉba mʉshʉbɨtsya bathɨ: «Thuthawithe kalyo, he mikati ithano na mahere abɨrɨ kuroshi. Ushondya thʉyagʉlɨre abandʉ boshi aba bo kalyo?»<verse eid="LUK 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 9:14" />Abandʉ babyaga aho, babyaga hofɨ bayira bangana bɨhʉmbɨ bɨthano. Yesʉ mwabwɨra <char style="w">abɨga</char> bʉwe athɨ: «Mwikatsye abandʉ mo bithutho-bithutho bya bandʉ makumi athano-athano.» <verse eid="LUK 9:14" /><verse number="15" style="v" sid="LUK 9:15" /><char style="w">Abɨga</char> mobakola nga ko Yesʉ abwɨragabo, mobikatsya abandʉ boshi. <verse eid="LUK 9:15" /><verse number="16" style="v" sid="LUK 9:16" />Yesʉ mwatsɨmba emikati ithano n'amahere abɨrɨ ayo, mwashʉmba amesho mo lʉbʉla n'ɨsɨma Gongo. Honyuma kw'aho, mwatsitsanga-tsingaro. Aho, mwaharo <char style="w">abɨga</char> bʉwe bagabɨrero abandʉ. <verse eid="LUK 9:16" /><verse number="17" style="v" sid="LUK 9:17" />Abandʉ boshi abo mobalya n'iugutha. Abɨga mobashongya ebyo byashakaga, mobotsutsya bɨthonga ikumi na bɨbɨrɨ.<verse eid="LUK 9:17" /></para>
  <para style="s">Petero anegena athɨ Yesʉ yo Kirisito</para>
  <para style="r">(<ref loc="MAT 16:13-19">Mat 16:13-19</ref>; <ref loc="MRK 8:27-29">Mar 8:27-29</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18" />Kɨro kɨgʉma Yesʉ agenda ashaba Gongo ahathalɨ bandʉ, <char style="w" lemma="Abɨga">n'abɨga</char> bʉwe nɨbalɨ hagʉma naye. Mwabʉtsyabo athɨ: «Abandʉ abanegena bathɨ nyɨrɨ ndɨ?» <verse eid="LUK 9:18" /><verse number="19" style="v" sid="LUK 9:19" />Abɨga mobamʉshʉbɨtsya bathɨ: «Bagʉma abanegena bathɨ ɨwe we Yoani <char style="w" lemma="Lubatiso">Mubatisya</char>, n'abandɨ bathɨ ɨwe we Elia, n'abandɨ nabo bathɨ ɨwe ʉlɨ mʉgʉma w'oko <char style="w" lemma="Mʉmɨnyeretsɨ">bamɨnyeretsɨ</char> ba kera yo walubukire.» <verse eid="LUK 9:19" /><verse number="20" style="v" sid="LUK 9:20" />Aho Yesʉ mwabʉtsyabo athɨ: «Nemwe omʉnegena mʉthɨ nyɨrɨ ndɨ kwenzi?» Petero mwamʉshʉbɨtsya athɨ: «Nɨ ɨwe <char style="w" lemma="Kirisito, Masia">Kirisito</char> yo Gongo athʉmaga.»<verse eid="LUK 9:20" /></para>
  <para style="s">Yesʉ anegena kw'ɨfwa n'ilubuka lɨwe</para>
  <para style="r">(<ref loc="MAT 16:20-28">Mat 16:20-28</ref>; <ref loc="MRK 8:30-9:1">Mar 8:30–9:1</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21" />Yesʉ mwahamʉla <char style="w">abɨga</char> bʉwe bathanalinda babwɨra n'omʉndʉ n'omʉgʉma omwatsɨ oyo. <verse eid="LUK 9:21" /><verse number="22" style="v" sid="LUK 9:22" />Kandɨ mwashʉba bwɨrabo athɨ: «Ingye <char style="w">Mʉgala w'oMʉndʉ</char> bɨtholere nɨnyagalwa kʉtsɨbʉ n'ɨthɨndwa n'abakʉlʉ b'abandʉ, <char style="w" lemma="Muheri">n'abakʉlʉ b'abaheri</char> <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">n'abakangɨrɨtsya b'oMʉgomba</char>. Nyandithwa, n'ekɨro kya kashathʉ nyandalubuka.»<verse eid="LUK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23" />Honyuma kw'aho, mwabwɨra aboshi athɨ: «Omʉndʉ alɨ atsiire ɨnyɨkwama, ayɨthɨnde yowene. Atsɨge ɨheka <char style="w" lemma="Mʉsalaba">omʉsalaba</char> ʉwe bʉlɨ kɨro, n'ɨnyɨkwama. <verse eid="LUK 9:23" /><verse number="24" style="v" sid="LUK 9:24" />Kʉshangwa omʉndʉ yo ushondya ilamya obʉyɨngo bʉwe andahetsyabo. Hewethuwe yo wandahetsyabo bʉshana na ngye, andalamyabo. <verse eid="LUK 9:24" /><verse number="25" style="v" sid="LUK 9:25" />N'omʉndʉ mwangabona obushoki bwoshi bw'ekɨhʉgo, hewethuwe amayɨhetsya n'iyibihya, andabona ndundi ki? Hathalɨ! <verse eid="LUK 9:25" /><verse number="26" style="v" sid="LUK 9:26" />Bʉshana n'ekyo mʉndʉ woshi-woshi yo wandagenda anyɨfwɨra shoni, n'ɨfwɨra ebɨnwa byaye byo shoni, <char style="w">oMʉgala w'oMʉndʉ</char> naye kuthyo andamʉfwɨra shoni. Ko byandabya bithyo ko mʉgʉlʉ nyandahika mo lʉkengerwa lwaye, nalo lo na lʉkengerwa lwa Thatha, na <char style="w" lemma="Malaɨka">olw'abamalaɨka</char> <char style="w" lemma="Mubuyirire">babuyirire</char>. <verse eid="LUK 9:26" /><verse number="27" style="v" sid="LUK 9:27" />Kwenene enyɨbabwɨra, mo kathi k'abalɨ hano bagʉma bathɨndafwe bathetsi balola ko <char style="w">Bwamɨ bwa Gongo</char>.»<verse eid="LUK 9:27" /></para>
  <para style="s">Obʉsʉ bwa Yesʉ bwamahɨndʉka</para>
  <para style="r">(<ref loc="MAT 17:1-8">Mat 17:1-8</ref>; <ref loc="MRK 9:2-8">Mar 9:2-8</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28" />Habere hahwa bɨro mʉnanɨ Yesʉ anegenire ebɨnwa ebyo, mwatsɨmba Petero, Yoani na Yakobo. Mwɨrʉkɨra nabo ko kɨthwa bʉshana n'ɨya shaba Gongo. <verse eid="LUK 9:28" /><verse number="29" style="v" sid="LUK 9:29" />Abere anemʉshaba, obʉsʉ bʉwe mobwahɨndʉka n'esongɨmba sɨwe mosasana n'ɨngenga kʉtsɨbʉ. <verse eid="LUK 9:29" /><verse number="30-31" style="v" sid="LUK 9:30-31" />Omo lʉkengerwa olo mokwahʉlʉka bayira babɨrɨ, Mʉsa na Elia. Abayira babɨrɨ abo nɨabasɨmola na Yesʉ ng'oko andamala omʉlɨmo ʉwe n'ɨfwɨra ɨYerʉsalemʉ.<verse eid="LUK 9:30-31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 9:32" />Ko ndambi eyo Petero na balikyabo babyaga nibayiretho bʉrangwe. He mobasɨsɨmʉka, mobashʉnga olʉkengerwa lwa Yesʉ, n'abayira babɨrɨ abo bo babyaga nibimene hagʉma naye. <verse eid="LUK 9:32" /><verse number="33" style="v" sid="LUK 9:33" />Mo ndambi abayira babɨrɨ abo bamikanaga na Yesʉ, Petero mwamʉbwɨra athɨ: «Mʉkangɨrɨtsya, bikwirire thwikale hano. Na thuhimbe hano ho hema ishathu: ngʉma yabya yɨwawe, eyɨndɨ yabya ya Mʉsa, n'eyɨndɨ yabya ya Elia.» Petero abyaga niathetsi ebyo agenda anegena. <verse eid="LUK 9:33" /><verse number="34" style="v" sid="LUK 9:34" />Mo ndambi Petero abere anemʉnegena athyo, mokwahʉlʉka kɨfʉ kɨnene n'ɨshwɨkabo. <char style="w">Abɨga</char> abo mobʉbaha babere balola ekɨfʉ ko kyamashwɨkabo. <verse eid="LUK 9:34" /><verse number="35" style="v" sid="LUK 9:35" />Mo kɨfʉ ekyo momwonvwɨka mʉlenge nɨanegena athɨ: «Oyu nɨ Mʉgala aye yo nyashombolaga. Mʉgende omʉmʉthega amathwi!»<verse eid="LUK 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 9:36" />Mo ndambi omʉlenge oyo onvwɨkaga, <char style="w">abɨga</char> abo mobashʉnga Yesʉ nɨahera yowene. Ebɨnwa bashʉngaga aho, mobayɨtsɨrɨra, mobathabwɨrabyo mʉndʉ n'omʉgʉma mo bɨro ebyo.<verse eid="LUK 9:36" /></para>
  <para style="s">Yesʉ abɨnga mʉtsɨmʉ mʉbɨ ko mwana</para>
  <para style="r">(<ref loc="MAT 17:14-18">Mat 17:14-18</ref>; <ref loc="MRK 9:14-27">Mar 9:14-27</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37" />Bwabere bwakya, Yesʉ n'<char style="w">abɨga</char> bʉwe bashathʉ abo mobandagala ko kɨthwa. Muhindano mʉnene wa bandʉ mwamʉgendera. <verse eid="LUK 9:37" /><verse number="38" style="v" sid="LUK 9:38" />Mo muhindano oyo, mʉndʉ mʉgʉma mwahambala mʉ mʉlenge mʉnene athɨ: «Mʉkangɨrɨtsya, enyɨkʉshaba thagʉsha elisho ly'oko mwana aye. Kʉshangwa yo nyinawitheko yowene! <verse eid="LUK 9:38" /><verse number="39" style="v" sid="LUK 9:39" /><char style="w" lemma="mɨtsɨmʉ">Omʉtsɨmʉ</char> anagenda ayihuma kw'ɨye, aho n'aho nɨaleka nɨahambala n'imuthithimania, n'erɨfʉlo niryothsula ko bʉnʉ. <char style="w" lemma="mɨtsɨmʉ">Omʉtsɨmʉ</char> athalɨ anamʉthokako tsʉba, na kandɨ anamunubya kʉtsɨbʉ. <verse eid="LUK 9:39" /><verse number="40" style="v" sid="LUK 9:40" />Monyashabire <char style="w">abɨga</char> bawe babɨnge omʉtsɨmʉ oyu, he mobalemirwe!»<verse eid="LUK 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41" />Aho, Yesʉ mwashubya athɨ: «Imwe bandʉ ba munobwire muthawithe lwɨkɨrɨtsyo, kandɨ mʉlɨ babɨ kʉtsɨbʉ. Nyandagenda enyibya nemwe n'ɨhʉlɨkɨrɨtsya ebɨnwa byenyu ihika kɨro ki? Nyɨrethere omwana awe oyo yo hano!»<verse eid="LUK 9:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42" />Mo ndambi omwana abyaga nɨaya ahalɨ Yesʉ, aho n'aho, <char style="w" lemma="mɨtsɨmʉ">omʉtsɨmʉ</char> oyo mwamuhuma ahishi n'imuthithimania kʉtsɨbʉ. Hewethuwe Yesʉ mwakemera <char style="w" lemma="mɨtsɨmʉ">omʉtsɨmʉ</char>. Mwalamya omwana oyo n'ɨmʉshʉbʉlɨtsya ishe. <verse eid="LUK 9:42" /><verse number="43" style="v" sid="LUK 9:43" />Abandʉ boshi mobashweka kʉtsɨbʉ mw'ɨshʉnga amaka manene wa Gongo.</para>
  <para style="s" vid="LUK 9:43">Yesʉ ashʉba negena ko lʉholo lʉwe</para>
  <para style="r" vid="LUK 9:43">(<ref loc="MAT 17:22-23">Mat 17:22-23</ref>; <ref loc="MRK 9:30-32">Mar 9:30-32</ref>)</para>
  <para style="p" vid="LUK 9:43">Mo ndambi eyo abandʉ boshi abo babyaga nɨbanemʉshweka bʉshana n'ebyoshi Yesʉ agenda akola. Yesʉ mwabwɨra <char style="w">abɨga</char> bʉwe athɨ: <verse eid="LUK 9:43" /><verse number="44" style="v" sid="LUK 9:44" />«Mʉthege amathwi bʉshana mwonvwe ebɨnwa enyishondya ɨbawɨra: <char style="w">Mʉgala w'oMʉndʉ</char> ahirwa mo minwe y'abandʉ.» <verse eid="LUK 9:44" /><verse number="45" style="v" sid="LUK 9:45" />Hewethuwe ebɨnwa ebyo Yesʉ abwɨragabo, mobathamɨnya nga binegenire bithi ki. Byabyaga nibibishire kʉbo bʉshana bathamɨnyagabyo. Na mobʉbaha ɨmʉbʉtsya nga binegenire bithi ki.<verse eid="LUK 9:45" /></para>
  <para style="s">Nɨ ndɨ yo mʉkʉlʉ?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Mat 18:1-5</ref>; <ref loc="MRK 9:33-37">Mar 9:33-37</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46" />Kɨro kɨgʉma <char style="w">abɨga</char> ba Yesʉ mobakubisania bamɨnye ɨndɨ nga yo mʉkʉlʉ mo kathi kabo. <verse eid="LUK 9:46" /><verse number="47" style="v" sid="LUK 9:47" />Yesʉ abyaga nɨamamala ɨmɨnya emɨganɨtsye yabo. Bʉshana n'ekyo mwatsɨmba mwana mʉlere mwamuhira hofɨ naye. <verse eid="LUK 9:47" /><verse number="48" style="v" sid="LUK 9:48" />Mwabwɨrabo athɨ: «Oyo ukokya mwana mʉlere yo ʉlɨ ng'oyu mw'ɨtsɨna lyaye, ni ingye amakokya. N'oyo unyikokya, kuthyo akokya oyo wanyɨthʉmaga. Nɨ kwenene, omʉlere mo kathi k'imwe boshi, oyo yo mʉkʉlʉ.»<verse eid="LUK 9:48" /></para>
  <para style="s">Oyo ʉthalɨ nzigu enyu nɨalɨ ko lʉhande lwenyu</para>
  <para style="r">(<ref loc="MRK 9:38-40">Mar 9:38-40</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49" />Aho Yoani mwanegena athɨ: «Mʉkangɨrɨtsya, mothʉshʉnga kʉ mʉndʉ yo ʉbɨnga <char style="w" lemma="mɨtsɨmʉ">emɨtsɨmʉ mɨbɨ</char> mw'ɨtsɨna lyawe. Hewethuwe mothʉmʉhangɨra kʉshangwa athalɨ w'omo kɨkembe kyethʉ.» <verse eid="LUK 9:49" /><verse number="50" style="v" sid="LUK 9:50" />Yesʉ mwamʉbwɨra athɨ: «Mʉthamʉhangɨraga, kʉshangwa oyo ʉthalɨ nzigu enyu, nɨ w'oko lʉhande lwenyu.»<verse eid="LUK 9:50" /></para>
  <para style="s">aBasamarɨa abathɨnda ikokya Yesʉ</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51" />Ebɨro Yesʉ angirukibwe mo lʉbʉla byabyaga hofɨ n'ihika. Bʉshana n'ekyo, mwashʉnga ko bɨtholere ɨrʉkɨre ɨYerʉsalemʉ. <verse eid="LUK 9:51" /><verse number="52" style="v" sid="LUK 9:52" />Mwathʉma bandʉ balebe bamʉthange embere. Abandʉ abo mobagenda n'ɨngɨra mʉ mʉrongo mʉgʉma <char style="w" lemma="Basamarɨa">w'aBasamarɨa</char>, kʉshangwa bashondetsye Yesʉ yo bʉgonzero. <verse eid="LUK 9:52" /><verse number="53" style="v" sid="LUK 9:53" />Hewethuwe abandʉ b'omo mʉrongo oyo mobathɨnda imukokya, kʉshangwa agenda aya ɨYerʉsalemʉ.<note caller="+" style="f"><char style="fr" closed="false">9:53 </char><char style="ft" closed="false">Ɨthanga kera aBayuta n'aBasamarɨa bathagenda bahʉlɨkɨrɨrana. Bʉshana n'ekyo, aBasamarɨa babyaga nɨ bathanzire aBayuta batsʉke mo kɨhʉgo kyabo balɨ abayaherera Gongo y'ɨYerʉsalemʉ. aBasamarɨa ɨbo babyaga nɨabanegena bathɨ lɨtholere ɨherera Gongo y'oko kɨthwa ky'eNgerasi.</char></note> <verse eid="LUK 9:53" /><verse number="54" style="v" sid="LUK 9:54" /><char style="w">Abɨga</char> bʉwe, Yakobo na Yoani babere bashʉnga ebyo, mobanegena bathɨ: «Nyinya-kowethʉ, ushondya thʉshabe mʉtsanwa athoke mo lʉbʉla bʉshana atsikyebo?» <verse eid="LUK 9:54" /><verse number="55" style="v" sid="LUK 9:55" />Yesʉ mwabɨndʉka n'ɨkemerabo.<note caller="+" style="f"><char style="fr" closed="false">9:55 </char><char style="ft" closed="false">Kʉlɨ wandɨ mashako wa kera wana ongerera bɨndɨ bɨnwa ko mʉlondo oyo athɨ: </char><char style="fqa" closed="false">Ewo Yesʉ kandɨ athɨ: «Muthetsi k'omunabya bandʉ b'oMʉthɨma wa Gongo? Mʉmɨnye kʉbʉya ingye Mʉgala w'oMʉndʉ, nyithahikaga bʉshana n'itsikya abandʉ, hewethuwe nyahikaga bʉshana n'ɨshabʉlabo.» </char></note> <verse eid="LUK 9:55" /><verse number="56" style="v" sid="LUK 9:56" />Aho, Yesʉ n'<char style="w">abɨga</char> bʉwe mobagenda kʉ ʉndɨ mʉrongo.<verse eid="LUK 9:56" /></para>
  <para style="s">Mahano bʉshana n'ɨkwama Yesʉ</para>
  <para style="r">(<ref loc="MAT 8:19-22">Mat 8:19-22</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57" />Mo ndambi Yesʉ n'<char style="w">abɨga</char> bʉwe babyaga bakɨnalɨ mo nzɨra, mʉndʉ mʉgʉma mwabwɨra Yesʉ athɨ: «Nyandagenda enyɨkʉkwama ahoshi wandaya.» <verse eid="LUK 9:57" /><verse number="58" style="v" sid="LUK 9:58" />Yesʉ mwamʉbwɨra athɨ: «Emɨtherere yiwithe mashamba waro, n'ebɨronge biwithe nyʉthʉ sabyo. Hewethuwe <char style="w">oMʉgala w'oMʉndʉ</char> athawithe n'aho anagonzera.»<verse eid="LUK 9:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59" />Yesʉ mwabwɨra ʉndɨ mʉndʉ athɨ: «Nyɨkwame.» He omʉndʉ oyo mwanegena athɨ: «Nyinya-kowethʉ, thaleka nyathathanga ɨyatha thatha.» <verse eid="LUK 9:59" /><verse number="60" style="v" sid="LUK 9:60" />Yesʉ mwamʉshʉbɨtsya athɨ: «Lika abaholi bagende bayathe abaholi babo. He ɨwe ʉgende ʉyafʉlɨre abandʉ bw'omwatsɨ <char style="w" lemma="Bwamɨ bwa Gongo">w'oBwamɨ bwa Gongo</char>.»<verse eid="LUK 9:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61" />Ʉndɨ mʉndʉ mwabwɨra Yesʉ athɨ: «Nyinya-kowethʉ, nyagenda enyɨkʉkwama, hewethuwe thaleka nyathayalagana n'ekɨhanda kyaye.» <verse eid="LUK 9:61" /><verse number="62" style="v" sid="LUK 9:62" />Yesʉ mwamʉbwɨra athɨ: «Omʉndʉ yo ʉthanga ɨrɨma nɨathashʉba lola enyuma, oyo ʉkola athyo athatholere ɨkolera <char style="w" lemma="Bwamɨ bwa Gongo">oBwamɨ bwa Gongo</char>.»<verse eid="LUK 9:62" /></para>
  <chapter eid="LUK 9" />
  <chapter number="10" style="c" sid="LUK 10" />
  <para style="s">Yesʉ athʉma bandɨ bɨga makumi alɨnda na babɨrɨ mo mʉlɨmo</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1" />Honyuma kw'aho, Nyinya-kowethʉ mwashombola bandɨ <char style="w" lemma="Abɨga">bɨga</char> makumi alɨnda na babɨrɨ.<note caller="+" style="f"><char style="fr" closed="false">10:1 </char><char style="ft" closed="false">Kʉlɨ bɨndɨ bɨtabo binegenire bɨthɨ mwashombola bandɨ bɨga makumi alɨnda.</char></note> Mwathʉmabo mo babɨrɨ-babɨrɨ bamʉthange embere mo bʉlɨ muyi na bʉlɨ handʉ angayire yowene. <verse eid="LUK 10:1" /><verse number="2" style="v" sid="LUK 10:2" />Mwabwɨrabo athɨ: «Emyaka yerire mɨngɨ, he abakoli nɨ bake. Bʉshana n'ekyo, mʉshabe omwenye emyaka athʉme bandɨ bakoli mw'ɨshwa lɨwe. <verse eid="LUK 10:2" /><verse number="3" style="v" sid="LUK 10:3" />Ewo mʉgende! Hewethuwe mʉmɨnye ko nyamabathʉma ng'ebyana by'esombuli mo kathi k'esonyambwe. <verse eid="LUK 10:3" /><verse number="4" style="v" sid="LUK 10:4" />Mʉthahekaga faranga kʉtse shaho, kʉtse bɨrato. Na mʉthaketsyaga mʉndʉ mo nzɨra.<verse eid="LUK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 10:5" />«Mo bʉlɨ nyʉmba mwandagenda omwɨngɨra, mʉketsye benyemo mʉthɨ: “Bʉholo bubye mo nyʉmba eno.” <verse eid="LUK 10:5" /><verse number="6" style="v" sid="LUK 10:6" />N'omo nyʉmba eyo mwamabya mʉlɨ mʉndʉ ashondya bʉholo, obʉholo bwenyu obo, bwandamʉshɨgalɨra. Bɨthalɨ bityo, obʉholo bwenyu obo, bwandabashʉbʉlɨra. <verse eid="LUK 10:6" /><verse number="7" style="v" sid="LUK 10:7" />Mwikale mo nyʉmba eyo, mulye n'ɨshoma ebyo abenye enyʉmba bandabaha. Kʉshangwa omukoli atholere ɨhabwa lʉhembo lʉwe. Mʉthathokaga mo nyʉmba n'ɨngɨra mʉ yɨndɨ. <verse eid="LUK 10:7" /><verse number="8" style="v" sid="LUK 10:8" />N'omo bʉlɨ muyi wo mwandɨngɨramo, abandʉ bamabakokya, mulye byo abandʉ abo bandabaha. <verse eid="LUK 10:8" /><verse number="9" style="v" sid="LUK 10:9" />N'abakoni bo balɨ mo muyi oyo, mulamyebo n'ɨbwɨra abandʉ b'omo muyi oyo mʉthɨ: “<char style="w" lemma="Bwamɨ bwa Gongo">oBwamɨ bwa Gongo</char> bʉlɨ hofɨ nemwe.” <verse eid="LUK 10:9" /><verse number="10" style="v" sid="LUK 10:10" />He mo bʉlɨ muyi abikalani bamo bandathɨnda ibakokya, mʉgende mo mbʉga yawo n'ɨnegena mʉthɨ: <verse eid="LUK 10:10" /><verse number="11" style="v" sid="LUK 10:11" />“Thwamabakʉngʉthɨra oluthuthu lw'omuyi enyu olʉlɨ ko bɨshando byethʉ.<note caller="+" style="f"><char style="fr" closed="false">10:11 </char><char style="xt" closed="false">Soma <ref loc="LUK 9:5">Luka 9:5</ref>.</char></note> He mʉmɨnye kʉbʉya kw'<char style="w" lemma="Bwamɨ bwa Gongo">oBwamɨ bwa Gongo</char> bʉlɨ hofɨ.” <verse eid="LUK 10:11" /><verse number="12" style="v" sid="LUK 10:12" />Kwenene enyɨbabwɨra nyɨthɨ, ekɨro ky'esohi kyandabya kyahika abandʉ b'omo muyi oyo, bandasohwa kʉtsɨbʉ kʉlenga abandʉ b'omuyi w'ɨSotomo.<note caller="+" style="f"><char style="fr" closed="false">10:12 </char><char style="xt" closed="false">Soma <ref loc="GEN 19:24-28">Ndangɨro 19:24-28</ref>.</char></note>»<verse eid="LUK 10:12" /></para>
  <para style="s">Yesʉ athakɨra abandʉ bo bamʉthɨndaga</para>
  <para style="r">(<ref loc="MAT 11:20-24">Mat 11:20-24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13" />Yesʉ mwashʉba negena athɨ: «Bʉhanya kw'imwe Banyakorasini! Na bʉhanya kw'imwe Banyabetesaita! Kʉshangwa monyakolire ebɨthɨko-thɨko mo kathi kenyu. Ebɨthɨko-thɨko ebyo kʉbwɨra mbʉ nyakoleragabyo aBanyatiro n'aBanyasitona, ɨbo bangambere mɨbʉta n'ikala omw'ɨfʉ bʉshana n'ikangania ko bamabɨndʉka ɨthoka mo bɨtsɨbʉ byabo. <verse eid="LUK 10:13" /><verse number="14" style="v" sid="LUK 10:14" />Bʉshana n'ekyo, ekɨro ky'erɨsoha, aBanyatiro n'aBanyasitona bandasohwa kʉke kʉlenga aBanyakorasini n'aBanyabetesaita. <verse eid="LUK 10:14" /><verse number="15" style="v" sid="LUK 10:15" />Nemwe Banyakaperenaʉmʉ, omʉganɨtsya mʉthɨ mwandirukibwa ihika mo lʉbʉla? Ɨhɨ! Mwandakimibwa ihika okw'ɨrʉnga!»<verse eid="LUK 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16" />Yesʉ Mwashʉba bwɨra <char style="w">abɨga</char> bʉwe athɨ: «Oy'ʉbahʉlɨkɨrɨtsya n'ingye ahʉlɨkɨrɨtsya. Hewethuwe oyo wamabathɨnda n'ingye amathɨnda. N'oyo wamanyɨthɨnda, nɨamathɨnda yo wanyɨthʉmaga.»<verse eid="LUK 10:16" /></para>
  <para style="s">Erɨfʉlʉka ly'abɨga makumi alɨnda na babɨrɨ</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17" />Honyuma kw'aho, <char style="w">abɨga</char> makumi alɨnda na babɨrɨ abo, mobashʉbʉla nɨbalɨ n'olʉmogo lʉnene. Mobanegena bathɨ: «Nyinya-kowethʉ, <char style="w" lemma="mɨtsɨmʉ">emɨtsɨmʉ mɨbɨ</char> naro thwabere thʉlɨ othʉbɨngaro mw'ɨtsɨna lyawe moyagendire eyɨthʉkenga!» <verse eid="LUK 10:17" /><verse number="18" style="v" sid="LUK 10:18" />Aho Yesʉ mwabwɨrabo athɨ: «Monyashungire <char style="w">Sitani</char> nɨathoga mo lʉbʉla ng'omulabyo. <verse eid="LUK 10:18" /><verse number="19" style="v" sid="LUK 10:19" />Monvwe! Monyabahere maka w'ikinda Sitani. Nɨ omo maka ayo momwagenda omʉlyathɨra so nzoka n'esonge, hathakɨrɨ ekyangabayɨra kʉbɨ. <verse eid="LUK 10:19" /><verse number="20" style="v" sid="LUK 10:20" />He, mʉthamogaga bʉshana <char style="w" lemma="mɨtsɨmʉ">n'emɨtsɨmʉ</char> ko yɨbakenga. Hewethuwe mʉmoge kʉshangwa amatsɨna enyu ashakirwe mo lʉbʉla.»<verse eid="LUK 10:20" /></para>
  <para style="s">Yesʉ amoga</para>
  <para style="r">(<ref loc="MAT 11:25-27">Mat 11:25-27</ref>; <ref loc="MAT 13:16-17">13:16-17</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21" />Kona ndambi eyo, Yesʉ mwamoga kʉtsɨbʉ mo maka <char style="w" lemma="Mʉthɨma Mwerʉ">w'oMʉthɨma Mwerʉ</char>. Mwanegena athɨ: «Thatha, ɨwe Muthegeki w'olʉbʉla n'ekɨhʉgo! Enyɨkʉsɨma kʉshangwa ebɨnwa bɨno mowabishabyo abathegekania n'abawithe obwenge. He mowabishulirabyo abana balere. Ega, mbe Thatha! Ebyoshi ebi bɨthokene kw'ɨshasha lyawe!<verse eid="LUK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22" />«Thatha mwanyɨhere ebyoshi. Hathalɨ mʉndʉ yo wetsi oMʉgala athalɨ Thatha mʉsha. Na kandɨ hathalɨ mʉndʉ yo wetsi Thatha athalɨ Mʉgala mʉsha, n'obʉlɨ mʉndʉ yo Mʉgala ashashire amʉmɨnye.»<verse eid="LUK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23" />Aho Yesʉ mwabɨndʉkɨra ahabyaga <char style="w">abɨga</char> bʉwe. Mwabwɨrabo ɨbo bene athɨ: «Amesho ow'alola ko by'omʉlolako bɨno amagashanɨrwa. <verse eid="LUK 10:23" /><verse number="24" style="v" sid="LUK 10:24" />Kwenene enyɨbabwɨra, <char style="w" lemma="Mʉmɨnyeretsɨ">bamɨnyeretsɨ</char> bangɨ na bamɨ bangɨ mobashondya ɨlola ko by'omʉlolako, he mobathalola kʉbyo. Kandɨ mobashondya ɨonvwa ebyo mwonvwa ebi, he mobathonvwabyo.»<verse eid="LUK 10:24" /></para>
  <para style="s">Mushinga w'oMʉsamarɨa mʉbʉya</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25" />Honyuma kw'aho, mʉkangɨrɨtsya mʉgʉma <char style="w" lemma="Mʉgomba">w'oMʉgomba</char> mwimana niashondya ɨlenga kʉ Yesʉ. Mwabʉtsya Yesʉ athɨ: «Mʉkangɨrɨtsya, nyangakola ki bʉshana nyɨbone obʉyɨngo bw'ekera na kera?»<verse eid="LUK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26" />Yesʉ mwamʉshʉbɨtsya athɨ: «Mo <char style="w">Mʉgomba</char> mushakirwe ki? Ʉlɨ ʉsomawo ʉnonvwawo ʉthɨ?» <verse eid="LUK 10:26" /><verse number="27" style="v" sid="LUK 10:27" />Omʉkangɨrɨtsya w'oMʉgomba oyo mwamʉshʉbɨtsya athɨ: «Ʉtsɨɨre Nyinya-kowethʉ Gongo wawe n'omʉthɨma awe woshi, n'obwenge bwawe boshi, n'akagala kawe koshi, n'emɨganɨtsye awe yoshi. Na ʉtsɨɨre mulikyenyu ng'oko uyitsiire wowene.<note caller="+" style="f"><char style="fr" closed="false">10:27 </char><char style="xt" closed="false">Soma <ref loc="DEU 6:5">Ɨbʉka 6:5</ref>; <ref loc="LEV 19:18">Balawi 19:18</ref>.</char></note>» <verse eid="LUK 10:27" /><verse number="28" style="v" sid="LUK 10:28" />Aho Yesʉ mwamʉbwɨra athɨ: «Wamashubya kʉbʉya! Ʉgende ʉkola uthyo nawe wandabyaho.»<verse eid="LUK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29" />Hewethuwe omʉkangɨrɨtsya w'oMʉgomba oyo, mwashondya ikangania kw'asɨngene. Aho mwabʉtsya Yesʉ athɨ: «Na ndɨ yo mulikyethu?»<verse eid="LUK 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30" />Yesʉ mwamʉshʉbɨtsya athɨ: «Mʉndʉ mʉgʉma agenda athoka ɨYerʉsalemʉ nɨ akimira iYeriko. Abere akɨnalɨ mo nzɨra abashamuli mobamʉwako. Abashamuli abo mobamʉnyaga ebyoshi abyaga awitheko, mobamunoya, mobayɨgendera nibamamushiga hofɨ ɨfwa.<verse eid="LUK 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 10:31" />«Mokwahʉlʉka <char style="w">muheri</char> mʉgʉma wa Gongo agenda akima mo nzɨra eyo. Abere ashʉnga yo uthahumbwa mwatsʉka emʉsɨke n'ɨyɨgendera. <verse eid="LUK 10:31" /><verse number="32" style="v" sid="LUK 10:32" /><char style="w" lemma="Balawi">Mulawi</char><note caller="+" style="f"><char style="fr" closed="false">10:32 </char><char style="fq" closed="false">Mulawi: </char><char style="ft" closed="false">aBalawi nɨ bandʉ b'omo kɨhanda ky'aBaisiraeli bagenda abangɨrɨra abaheri bakʉlʉ ko mʉlɨmo w'omo Nyʉmba ya Gongo. </char><char style="xt" closed="false">Soma <ref loc="NUM 3:5-13">Mɨganzo 3:5-13</ref>.</char></note> mʉgʉma naye mwahikaho. Abere ashʉnga ko mʉndʉ oyo, naye mwatsʉka emʉsɨke n'ɨyɨgendera.<verse eid="LUK 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 10:33" />«Honyuma kw'aho, mokwahʉlʉka <char style="w" lemma="Basamarɨa">Mʉsamarɨa</char> mʉgʉma abyaga mo lʉgendo. <char style="w" lemma="Basamarɨa">oMʉsamarɨa</char> oyo mwahika ahabyaga omʉndʉ wahumbawa. Ɨye abere amʉshʉngako mwamʉfwɨra shashi. <verse eid="LUK 10:33" /><verse number="34" style="v" sid="LUK 10:34" />Mwayɨfʉnda hofɨ naye, mwashomola ebɨhʉlʉ bɨwe mw'ihira mʉbyo mo mafʉtha <char style="w" lemma="Tifayi:">n'etifayi</char> n'ɨmɨnabyo. Mwamʉshʉmbɨra ko pʉnda yɨwe mwamʉthwala eyɨrɨ enyʉmba y'abageni bʉshana bamʉlweko.<figure style="fig" alt="Le bon samaritain lie les plaies d'une personne qui a été frappée" file="WA03863b.tif" size="span" copy="Graham Wade" ref="10:34">Mʉsamarɨa mʉbʉya ashomola ebɨhʉlʉ bya mʉndʉ athahumbwa</figure> <verse eid="LUK 10:34" /><verse number="35" style="v" sid="LUK 10:35" />Bwabere bwakya, mwahulukya tinari<note caller="+" style="f"><char style="fr" closed="false">10:35 </char><char style="fq" closed="false">Tinari: </char><char style="ft" closed="false">Eso tinari ibiri sabyaga lʉhembo lwa mɨbɨtsɨ ibiri.</char></note> ibiri, mwahatho omwenye nyʉmba y'abageni n'ɨmʉbwɨra athɨ: “Omʉndʉ oyu ʉmʉlweko kʉbʉya. Nyandakʉfʉha esɨndɨ tinari soshi ko byoshi wamʉkolera nyandabya nyashʉbʉla.”»<verse eid="LUK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36" />Ko nduli Yesʉ mwabʉtsya omʉkangɨrɨtsya w'oMʉgomba oyo athɨ: «Mo mɨganɨtsye awe ko bandʉ bashathʉ abo, nɨ ndɨ yo wabyaga mulikyabo w'oyo wahumbawa n'abashamuli?» <verse eid="LUK 10:36" /><verse number="37" style="v" sid="LUK 10:37" />Omʉkangɨrɨtsya w'oMʉgomba oyo mwashubya athɨ: «Oyo wamʉfwɨraga shashi.»</para>
  <para style="p" vid="LUK 10:37">Yesʉ mwamʉbwɨra athɨ: «Enda! Nawe ʉgende ʉkola uthyo.»<verse eid="LUK 10:37" /></para>
  <para style="s">Yesʉ alungula Maratha na Marɨa</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38" />Yesʉ n'<char style="w">abɨga</char> bʉwe babere banalɨ mo lʉgendo, mwɨngɨra mʉ mʉrongo mʉgʉma. Mʉkatsɨ mʉgʉma yo ʉnahʉlwamo Marata mwamukokya mo nyʉmba yɨwe. <verse eid="LUK 10:38" /><verse number="39" style="v" sid="LUK 10:39" />Maratha oyo abyaga awithe mʉlʉmʉna ʉwe, agenda ahʉlwamo Marɨa. Marɨa oyo mwikala ho mʉsɨke w'ebɨshando bya Nyinya-kowethʉ, nɨahʉlɨkɨrɨtsya ebɨnwa bɨwe. <verse eid="LUK 10:39" /><verse number="40" style="v" sid="LUK 10:40" />He Marata ɨye abyaga nɨathʉba-thʉba mo mʉlɨmo w'ɨtheka kalyo. Mwahika ahalɨ Yesʉ mwamʉbwɨra athɨ: «Nyinya-kowethʉ, mʉlʉmʉna aye mwanyimikira omʉlɨmo w'ingye ngyowene, bithakubwire kɨndʉ? Mʉbwɨre anyiwathikye.»<verse eid="LUK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41" />Nyinya-kowethʉ mwamʉshʉbɨtsya athɨ: «Marata! Ɨwe ʉyagatsya n'ɨthʉba-thʉba mʉ bɨndʉ bɨngɨ. <verse eid="LUK 10:41" /><verse number="42" style="v" sid="LUK 10:42" />Hewethuwe, nɨ kɨndʉ kɨgʉma bʉsha kyo kɨtholere. Marɨa ɨye amashombola kɨndʉ kɨbʉya kʉtsɨbʉ. N'ekyo athɨndanyagʉlwekyo.»<verse eid="LUK 10:42" /></para>
  <chapter eid="LUK 10" />
  <chapter number="11" style="c" sid="LUK 11" />
  <para style="s">Yesʉ akangɨrɨtsya abɨga bʉwe ɨshaba Gongo</para>
  <para style="r">(<ref loc="MAT 6:9-13">Mat 6:9-13</ref>; <ref loc="MAT 7:7-11">7:7-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1" />Kɨro kɨgʉma Yesʉ agenda ashabɨra handʉ halebe. Abere amamala ɨshaba, mʉgʉma w'oko <char style="w" lemma="Abɨga">bɨga</char> bʉwe mwamʉbwɨra athɨ: «Yoani Mubatisya mwakangɨrɨtsya <char style="w">abɨga</char> bʉwe ng'oko banashaba Gongo. Aho Nyinya-kowethʉ, nawe kuthyo thʉkangɨrɨtsye nga ko banashaba Gongo.»<verse eid="LUK 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2" />Yesʉ mwabwɨrabo athɨ: «Mʉlɨ omʉshaba Gongo mʉgende omʉnegena mʉthɨ:</para>
  <para style="q1" vid="LUK 11:2">“Thatha,</para>
  <para style="q1" vid="LUK 11:2">erɨtsɨna lyawe lisingibwe!</para>
  <para style="q1" vid="LUK 11:2">Obuthegeki bwawe buhike!<verse eid="LUK 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3" />Ʉgende ʉthʉha akalyo kethʉ k'ebɨro byoshi.<verse eid="LUK 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4" />Ʉthʉganyɨre ebɨtsɨbʉ byethʉ,</para>
  <para style="q1" vid="LUK 11:4">kʉshangwa nethwe othʉnaganyɨra abo banathʉkolera obʉbɨ.</para>
  <para style="q1" vid="LUK 11:4">Ʉthagenda uthumika thwɨngɨre mw'ɨlengwako.”»<verse eid="LUK 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5" />Yesʉ mwashʉba bwɨra <char style="w">abɨga</char> bʉwe athɨ: «Thʉlolere ko mushinga oyu: mʉndʉ mʉgʉma wa kw'imwe angayɨra mwira. Omwɨra oyo niamuhikira mo kathi k'ekɨro n'ɨmʉbwɨra athɨ: “Mwiraye, nyɨbweke mikati ishathu, <verse eid="LUK 11:5" /><verse number="6" style="v" sid="LUK 11:6" />kʉshangwa mʉgʉma w'oko bira baye amanyihikira nɨathoka mo lʉgendo nangye nyithawithe kalyo k'ɨmʉha.” <verse eid="LUK 11:6" /><verse number="7" style="v" sid="LUK 11:7" />Oyo ʉlɨ mo nyʉmba nɨamʉshʉbɨtsya athɨ: “Ʉthanyɨkendetsyaga, nyamalire ɨkɨnga oluyi, ingye n'abana baye thwamalire ɨgonzera. Nyɨthangashʉba hangana bʉshana n'ɨkʉha mikati.” <verse eid="LUK 11:7" /><verse number="8" style="v" sid="LUK 11:8" />Enyɨbabwɨra nyɨthɨ mwangathɨnda imana n'ɨmʉha emikati bʉshana n'obwira, he angimana n'ɨmʉha ebyoshi ashashire bʉshana n'obuhathikani bʉwe.<verse eid="LUK 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 11:9" />«Nangye enyɨbabwɨra nyɨthɨ: mʉgende omʉshaba nemwe mwandahabwa, mʉgende omushondya nemwe mwandabona, mʉgende omʉkongotha ko luyi nemwe mwandakɨngʉlɨrwa. <verse eid="LUK 11:9" /><verse number="10" style="v" sid="LUK 11:10" />Kʉshangwa bʉlɨ mʉndʉ yo ʉshaba anahabwa, n'oyo ushondya anabona. N'oyo ʉkongotha ko luyi anakɨngʉlɨrwa. <verse eid="LUK 11:10" /><verse number="11" style="v" sid="LUK 11:11" />Ishe ndɨ wa mwana mo kathi kenyu, yo mʉgala ʉwe angamʉshaba ihere nɨamʉha nzoka? Hathalɨ! <verse eid="LUK 11:11" /><verse number="12" style="v" sid="LUK 11:12" />Kʉtse kandɨ ɨndɨ yo mʉgala ʉwe angamʉshaba ɨyɨ nɨamʉha nge? Hathalɨ! <verse eid="LUK 11:12" /><verse number="13" style="v" sid="LUK 11:13" />Na mo mʉnalɨ babɨ, he mwetsi ɨha abana benyu bw'ebɨndʉ bikwirire. Aho Ɨsho wenyu yo ʉlɨ mo lʉbʉla athɨndagende aha <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> w'abo banagenda abamʉshabawo!»<verse eid="LUK 11:13" /></para>
  <para style="s">Yesʉ abɨnga mʉtsɨmʉ mʉbɨ</para>
  <para style="r">(<ref loc="MAT 12:22-30">Mat 12:22-30</ref>; <ref loc="MRK 3:22-27">Mar 3:22-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14" />Kɨro kɨgʉma Yesʉ agenda abɨnga <char style="w" lemma="mʉtsɨmʉ">mʉtsɨmʉ mʉbɨ</char> yo wayɨraga mʉndʉ mʉgʉma mo kɨtsɨrʉ. <char style="w" lemma="mʉtsɨmʉ">Omʉtsɨmʉ mʉbɨ</char> oyo abere athoka ko mʉndʉ oyo, aho n'aho mwathanga ɨnegena. Mo muhindano, abandʉ mobashweka kʉtsɨbʉ. <verse eid="LUK 11:14" /><verse number="15" style="v" sid="LUK 11:15" />He bagʉma mo bandʉ abo mobagenda ababwɨrana bathɨ: «Omʉndʉ oyu nɨ Belisebuli, mʉkʉlʉ <char style="w" lemma="mɨtsɨmʉ">w'emɨtsɨmʉ mɨbɨ</char> nɨ ɨro yo yɨnagenda eyɨmʉha amaka w'ɨbɨngaro.» <verse eid="LUK 11:15" /><verse number="16" style="v" sid="LUK 11:16" />Abandɨ babyaga niabashondya ɨmʉlengako. Mobamʉshaba akolerebo kɨthɨko-thɨko kɨgʉma kyo kɨthoka elʉbʉla.<verse eid="LUK 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 11:17" />Hewethuwe Yesʉ abyaga nɨamamala ɨmɨnya ebɨrɨ mo mɨthɨma yabo. Mwabwɨrabo athɨ: «Abandʉ b'omo bwamɨ bʉgʉma bamalwa ɨbo kw'ɨbo, obwamɨ obo nɨbwamathera. N'abandʉ b'omo lʉganda lʉgʉma bamalwa ɨbo kw'ɨbo, olʉganda olo nɨlwamashambʉkala. <verse eid="LUK 11:17" /><verse number="18" style="v" sid="LUK 11:18" />Aho, <char style="w">Sitani</char> amabya angayɨlwɨsa yowene, obwamɨ bʉwe nibwimana bʉthɨ? Enyɨnegena ebyo kʉshangwa omʉnegena mʉthɨ: enyɨbɨnga <char style="w" lemma="mɨtsɨmʉ">emɨtsɨmʉ mɨbɨ</char> ko maka wa Belisebuli. <verse eid="LUK 11:18" /><verse number="19" style="v" sid="LUK 11:19" />Nyamabya nɨenyɨbɨnga <char style="w" lemma="mɨtsɨmʉ">emɨtsɨmʉ mɨbɨ</char> kʉ maka wa Belisebuli, aho abɨga benyu nabo abanagenda ababɨngaro kʉ maka wa ndɨ? Nɨ Bʉshana n'ekyo abɨga benyu abo bo bandabasoha. <verse eid="LUK 11:19" /><verse number="20" style="v" sid="LUK 11:20" />He ingye, alɨ mo maka wa Gongo wonyɨbɨngamo <char style="w" lemma="mɨtsɨmʉ">emɨtsɨmʉ mɨbɨ</char>, n'ɨnegena mbʉ <char style="w" lemma="Bwamɨ bwa Gongo">oBwamɨ bwa Gongo</char> bwamalire ibahikira.<verse eid="LUK 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21" />«Mo ndambi omʉndʉ wa kagala awithe kʉ bɨmano bya malwa atheya rʉba lʉwe, obushoki bʉwe obunabya nibutheyibwe kʉbʉya. <verse eid="LUK 11:21" /><verse number="22" style="v" sid="LUK 11:22" />He ʉndɨ mʉndʉ yo uwithe kagala kw'imulengya amahika iyihuma kw'ɨye n'imukinda, aho angashamʉla omwenye enyʉmba y'ebɨmano by'amalwa ebyo athayinihire, n'ɨgaba ebɨndʉ byoshi athamʉnyaga.<verse eid="LUK 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23" />«Oyo ʉthalɨ ko lʉhande lwaye, nɨ nzigu aye. N'oyo ʉthalɨ anyiwathikya kw'ɨkʉmakʉma nɨapanza.»<verse eid="LUK 11:23" /></para>
  <para style="s">Mʉtsɨmʉ mʉbɨ ashʉba ko mʉndʉ</para>
  <para style="r">(<ref loc="MAT 12:43-45">Mat 12:43-45</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24" />Yesʉ mwashʉba negena athɨ: «Mo ndambi <char style="w" lemma="mɨtsɨmʉ">omʉtsɨmʉ mʉbɨ</char> anabya amathoka ko mʉndʉ anagenda athimba-thimba mo <char style="w">mbwarara</char> niashondya aho angalʉhʉkɨra. Amabʉshaho nɨanegena athɨ: “Nyashʉba mo nyʉmba aye nyɨthathokamo.” <verse eid="LUK 11:24" /><verse number="25" style="v" sid="LUK 11:25" />Anabya ashʉbamo, ameyaro nɨyamalire ɨbɨtsɨbwa n'ikomibwa kʉbʉya, <verse eid="LUK 11:25" /><verse number="26" style="v" sid="LUK 11:26" />aho<char style="w" lemma="mɨtsɨmʉ">omʉtsɨmʉ mʉbɨ</char> oyo anayenda yɨndɨ <char style="w">mɨtsɨmʉ</char> ɨrɨnda mɨbɨ kʉlengya ɨye. Eyoshi nɨyɨngɨra mo nyʉmba eyo n'iyikaliramo. Aho omʉndʉ oyo emɨbere yɨwe nɨ yabya mɨbɨ kʉtsɨbʉ kʉlenga emɨbere yɨwe mɨmbere.»<verse eid="LUK 11:26" /></para>
  <para style="s">Ɨgashanɨrwa lya kwenene</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27" />Mo ndambi Yesʉ abere anemʉnegena ebɨnwa ebyo, mʉkatsɨ mʉgʉma mo muhindano mwahambala athɨ: «Omʉkatsɨ yo wakʉbʉthaga n'ikwongya agashanɨrwe!» <verse eid="LUK 11:27" /><verse number="28" style="v" sid="LUK 11:28" />He Yesʉ mwashubya athɨ: «He abo bagashanɨrwe kundu kundu, nɨ bo banagenda abonvwa <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char> n'ɨkola nga ko kinegenire.»<verse eid="LUK 11:28" /></para>
  <para style="s">Ɨshaba kɨthɨko-thɨko</para>
  <para style="r">(<ref loc="MAT 12:38-42">Mat 12:38-42</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29" />Bandʉ bangɨ bagenda abongereka ho Yesʉ abyaga, mwabwɨrabo athɨ: «Abandʉ b'omo mʉgʉlʉ ono nɨ babɨ! Abashaba kɨmɨnyɨkalo. Hewethuwe hathalɨ kɨmɨnyɨkalo bandakangibwa kɨthalɨ eky'omʉmɨnyeretsɨ Yona. <verse eid="LUK 11:29" /><verse number="30" style="v" sid="LUK 11:30" />Yona abyaga kɨmɨnyɨkalo ko bandʉ b'eNinawi.<note caller="+" style="f"><char style="fr" closed="false">11:30 </char><char style="xt" closed="false">Soma <ref loc="JON 3:3-5">Yona 3:3-5</ref>.</char></note> <char style="w">oMʉgala w'oMʉndʉ</char>, kuthyo andabya kɨmɨnyɨkalo ko bandʉ ba munobwire.<verse eid="LUK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 11:31" />«Mo kɨro ky'esohi omʉgole yo wathokaga ko Lʉnda Kihya<note caller="+" style="f"><char style="fr" closed="false">11:31 </char><char style="xt" closed="false">Soma <ref loc="1KI 10:1-10">1Bamɨ 10:1-10</ref>.</char></note> andalubukira hagʉma nemwe bandʉ ba munobwire bʉshana n'ibasitaka. Kʉshangwa ɨye athokaga hale kʉtsɨbʉ bʉshana n'ɨyonvwa ebɨnwa by'obuthegekania bw'omwamɨ Solomona. Mwonvwe! Hano halɨ mʉkʉlʉ kʉlenga Solomona!<verse eid="LUK 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 11:32" />«Ekɨro ky'esohi kyandabya kyahika, abandʉ b'eNinawi nabo bandalubukira hagʉma nemwe, imwe bandʉ ba munobwire n'ibasitaka. He abo ɨbo babere bonvwa ebɨnwa by'omʉmɨnyeretsɨ Yona akangɨrɨtsyagabo mobabɨndʉka ɨthoka mo bɨtsɨbʉ byabo. Mwonvwe! Hano halɨ mʉkʉlʉ kʉlenga omʉmɨnyeretsɨ Yona.»<verse eid="LUK 11:32" /></para>
  <para style="s">Amesho wo tara y'omʉbɨrɨ</para>
  <para style="r">(<ref loc="MAT 5:15">Mat 5:15</ref>; <ref loc="MAT 6:22-23">6:22-23</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33" />Yesʉ mwashʉba negena athɨ: «Hathalɨ mʉndʉ yo ʉnagenda anokya etara n'ibisharo, kʉtse n'ɨshwɨkaro kɨthonga. Hewethuwe niahiraro kw'ihango, nɨmo abandʉ bo bɨngɨra mo nyʉmba balole ko kyakakala. <verse eid="LUK 11:33" /><verse number="34" style="v" sid="LUK 11:34" />Elisho lyo tara y'omʉbɨrɨ. Elisho lyawe lyamabya lɨthalwere, omʉbɨrɨ woshi nɨalɨ mo kyakakala. He elisho lyawe lyamabya lɨlwere, omʉbɨrɨ awe nawo niabya mo mwitsimya. <verse eid="LUK 11:34" /><verse number="35" style="v" sid="LUK 11:35" />Bʉshana n'ekyo uyitheye kʉshangwa ekyakakala kɨrɨ mw'ɨwe kɨthahɨndʉkaga mwitsimya. <verse eid="LUK 11:35" /><verse number="36" style="v" sid="LUK 11:36" />Omʉbɨrɨ awe woshi amabya alɨ mo kyakakala, amabya athalɨko kɨthambo kɨrɨ mo mwitsimya, omʉbɨrɨ awe woshi andabya mo kyakakala ky'ekwenene ng'etara yo yɨnagenda eyɨkʉkoletsya mo kyakakala kyaro.»<verse eid="LUK 11:36" /></para>
  <para style="s">Emɨbere mɨbɨ y'aBafarisayo n'abakangɨrɨtsya b'oMʉgomba</para>
  <para style="r">(<ref loc="MAT 23:1-36">Mat 23:1-36</ref>; <ref loc="MRK 12:38-40">Mar 12:38-40</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37" />Yesʉ abere amamala ɨnegena ebɨnwa ebyo, <char style="w" lemma="Bafarisayo:">Mufarisayo</char> mʉgʉma mwamʉbɨrɨkɨra ayalye ko kalyo k'omwe. Yesʉ mwɨngɨra mo nyʉmba na mwathanga irya. <verse eid="LUK 11:37" /><verse number="38" style="v" sid="LUK 11:38" /><char style="w" lemma="Bafarisayo:">oMufarisayo</char> oyo mwashweka abere ashʉnga Yesʉ ko mwalya bʉthanaba ko minwe.<note caller="+" style="f"><char style="fr" closed="false">11:38 </char><char style="ft" closed="false">Ko aBafarisayo byabyaga nibithatholere omʉndʉ erirya bʉthanaba ko minwe.</char></note><verse eid="LUK 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 11:39" />Aho, Nyinya-kowethʉ mwamʉbwɨra athɨ: «Imwe <char style="w" lemma="Bafarisayo:">Bafarisayo</char>, omʉnagenda omʉshʉga enyuma y'olwatha na y'embale. Hewethuwe mo mɨthɨma enyu mwotswire ngʉmbʉ y'obwɨtsɨ n'ebɨndɨ bɨbɨ. <verse eid="LUK 11:39" /><verse number="40" style="v" sid="LUK 11:40" />Imwe mʉlɨ thʉhʉmo! Muthetsi kw'oyo wakomaya enyuma y'olwatha na y'embale n'ɨye yo wanakomaya n'emwishi watho? <verse eid="LUK 11:40" /><verse number="41" style="v" sid="LUK 11:41" />Aho, mʉgende omʉwathɨkya abatsene mo bɨndʉ byo muwitheko. Aho n'ebɨndɨ byoshi nɨbyetsɨbwa bʉshana nemwe.<verse eid="LUK 11:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42" />«Mʉlɨ balɨgo, imwe <char style="w" lemma="Bafarisayo:">Bafarisayo</char>! Omʉnahana ekɨgʉma ky'ikumi ky'akandambʉka, n'esoshogo, n'esɨndɨ nyinyi, he omʉnagenda omʉsʉnzʉgʉra ɨkola ebɨthʉnganene n'olwanzo lwa Gongo. Naho nɨ ebyo byo mwangagendire omʉkola, buthalika ɨhana kɨgʉma ky'ikumi ky'ebɨndɨ bɨndʉ byoshi ebyo.<verse eid="LUK 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43" />«Mʉlɨ balɨgo, imwe <char style="w" lemma="Bafarisayo:">Bafarisayo</char>! Mutsiire ikala ko bifumbi by'embere mo so<char style="w" lemma="Sinakoki:">sinakoki</char>. Na kandɨ mutsiire abandʉ bagende ababaketsya n'olushikyo mo mihindano. <verse eid="LUK 11:43" /><verse number="44" style="v" sid="LUK 11:44" />Mʉlɨ balɨgo! Omunabya ng'amasɨnda w'athalɨko kɨmɨnyɨkalo, w'abandʉ abanalyathanga kʉwo bʉthamɨnya.<note caller="+" style="f"><char style="fr" closed="false">11:44 </char><char style="ft" closed="false">aBayuta babyaga na mɨbere y'ihira bɨmɨnyɨkalo ko masɨnda wabo bʉshana mʉndʉ athalyathaga kʉwo bʉthamɨnya. Ɨkwamana n'oMʉgomba wa Mʉsa obʉlɨ wakolaga kʉ kinda kʉtse ilyatha kw'ɨsɨnda nɨ amahatsya. Athangashubire hindana n'abandɨ Bayuta mo bʉhere. </char><char style="xt" closed="false">Soma <ref loc="LEV 5:3">Balawi 5:3</ref>; <ref loc="NUM 19:11-22">Mɨganzo 19:11-22</ref>.</char></note>»<verse eid="LUK 11:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45" />Mʉkangɨrɨtsya mʉgʉma <char style="w" lemma="Mʉgomba">w'oMʉgomba</char> mwabwɨra Yesʉ athɨ: «Mʉkangɨrɨtsya, ʉlɨ oʉnegena uthyo nɨoʉthʉkamba nethwe.»<verse eid="LUK 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46" />Na Yesʉ mwashubya athɨ: «Bʉlɨgo kw'imwe bakangɨrɨtsya <char style="w" lemma="Mʉgomba">b'oMʉgomba</char>! Kʉshangwa omuhekya abandʉ bw'emɨtsɨgo itsithohire, kandɨ nɨmʉthangathakola na kʉro ko mo minwe enyu.<verse eid="LUK 11:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 11:47" />«Bʉlɨgo kw'imwe! Kʉshangwa omuhimba amasɨnda <char style="w" lemma="Mʉmɨnyeretsɨ">w'abamɨnyeretsɨ</char> bo bithawa na bo sho. <verse eid="LUK 11:47" /><verse number="48" style="v" sid="LUK 11:48" />Aho omwɨmɨrana n'abo sho ko byo bakolaga, kʉshangwa mobitha abamɨnyeretsɨ, nemwe omuhimba amasɨnda wabo! <verse eid="LUK 11:48" /><verse number="49" style="v" sid="LUK 11:49" />Bʉshana n'ekyo, Gongo mwithegekania lɨwe mwanegena athɨ: “Nyandathʉmɨrabo <char style="w" lemma="Mʉmɨnyeretsɨ">abamɨnyeretsɨ</char> <char style="w" lemma="Bathʉmwa">n'abathʉmwa</char>. He bandagenda abitha bagʉma ba mʉbo, n'inubya abandɨ.” <verse eid="LUK 11:49" /><verse number="50" style="v" sid="LUK 11:50" />Nɨ bʉshana n'ekyo, omʉsasɨ <char style="w" lemma="Mʉmɨnyeretsɨ">w'abamɨnyeretsɨ</char> boshi bithawa ɨthoka kw'ɨbʉmbwa ly'ekɨhʉgo, andabya ko muthwe w'abandʉ ba munobwire. <verse eid="LUK 11:50" /><verse number="51" style="v" sid="LUK 11:51" />Obwithi obo bwathangaga kʉ Abeli ihika kʉ Sakarɨa<note caller="+" style="f"><char style="fr" closed="false">11:51 </char><char style="ft" closed="false">Mo Ndagane ya Kera, aBayuta ɨbo babyaga nibetsi k'omʉndʉ mʉmbere withawa abyaga Abeli, n'omʉndʉ munyuma-nyuma withawa abyaga mʉmɨnyeretsɨ Sakarɨa. </char><char style="xt" closed="false">Soma <ref loc="GEN 4:8">Ndangɨro 4:8</ref>; <ref loc="2CH 24:20-22">2Myatsɨ y'eMɨgʉlʉ 24:20-22</ref>.</char></note> yo bithiraga mo <char style="w">Nyʉmba ya Gongo</char> mo kathi-kathi <char style="w" lemma="Bʉtara bw'ɨhererako">k'obʉtara</char> bw'erɨhererako n'ahandʉ habuyirire. Ega, enyɨbabwɨra nyɨthɨ omʉsasɨ w'abandʉ boshi aba andabya ko mithwe enyu imwe bandʉ ba munobwire.<verse eid="LUK 11:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52" />«Mʉlɨ balɨgo bakangɨrɨtsya <char style="w" lemma="Mʉgomba">b'oMʉgomba</char>! Omunabisha abandɨ bandʉ b'olʉfʉngʉro bʉshana bathɨngɨraga aho bangɨyɨra ɨmɨnya Gongo. Imwe bene mʉthalɨ omushondya ɨngɨraho, na bo bashondya ɨngɨraho omʉnakɨkɨrabo.»<verse eid="LUK 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53" />Yesʉ abere athoka mo nyʉmba eyo, <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">abakangɨrɨtsya b'oMʉgomba</char> <char style="w" lemma="Bafarisayo:">n'aBafarisayo</char> mobakapɨkɨra bʉshana naye n'ɨmʉbʉlɨrɨtsya bɨngɨ. <verse eid="LUK 11:53" /><verse number="54" style="v" sid="LUK 11:54" />Bagenda abashondya ɨmʉlengako nɨmo babona kyo bangimanirako kw'imusitaka.<verse eid="LUK 11:54" /></para>
  <chapter eid="LUK 11" />
  <chapter number="12" style="c" sid="LUK 12" />
  <para style="s">Yesʉ ahangɨra obuyimbya</para>
  <para style="r">(<ref loc="MAT 10:26-27">Mat 10:26-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1" />Mo kathambi ako bɨhʉmbɨ na bɨhʉmbɨ bya bandʉ mobahindana aho, ihika ko kathambi mobathanga ilyathangana. Yesʉ mwathanga ɨbwɨra <char style="w">abɨga</char> bʉwe athɨ: «Mʉgende omuyitheya ko <char style="w">tsatsʉ</char> <char style="w" lemma="Bafarisayo">y'aBafarisayo</char>, n'ɨnegena mbʉ obuyimbya bwabo. <verse eid="LUK 12:1" /><verse number="2" style="v" sid="LUK 12:2" />Hathalɨ kɨndʉ kibishire ekɨthɨndabishulwe, kandɨ hathalɨ lʉfʉmɨ olʉthɨnda kumbulwe. <verse eid="LUK 12:2" /><verse number="3" style="v" sid="LUK 12:3" />Bʉshana n'ekyo ebyoshi mwanegenaga mo mwitsimya, byandonvwɨka mo mwɨshɨ. N'ebyo mwabʉhereranaga mo bɨshenge by'emwishi, byandahambalɨrwa ko nyithwe s'amanyʉmba.»<verse eid="LUK 12:3" /></para>
  <para style="s">Oyo wangʉbahwa</para>
  <para style="r">(<ref loc="MAT 10:28-31">Mat 10:28-31</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4" />Kandɨ Yesʉ mwashʉba negena athɨ: «Enyɨbabwɨra imwe bira baye: mʉthagenda omʉbaha abo bangitha omʉbɨrɨ, he bamamala ithawo, bathangashʉba kola kɨndɨ kɨndʉ. <verse eid="LUK 12:4" /><verse number="5" style="v" sid="LUK 12:5" />Nyabakangya oyo mwangagenda omʉbaha. Mʉgende omʉbaha Gongo yo wangashamʉla obʉyɨngo bw'omʉndʉ, na amamala ɨshamʉlabo, alɨ na maka w'ɨgʉsha mʉndʉ yo kw'ɨrʉnga. Ega! Enyɨbabwɨra kw'oyo yo mʉgende omʉbaha.<verse eid="LUK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 12:6" />«Ebishwi bɨthano bɨthalɨ ebɨnagʉtsɨbwa sengi ibiri sa faranga kuroshi? Hewethuwe mʉbyo hathalɨ n'ekɨgʉma ekyo Gongo ibirirwe. <verse eid="LUK 12:6" /><verse number="7" style="v" sid="LUK 12:7" />Na kuthyo esonzwɨrɨ soshi s'oko mithwe enyu, Gongo etsi emɨganzo y'esoshi etho. Bʉshana n'ekyo mʉthagenda omʉbaha, kʉshangwa muwithe kɨtsɨro kɨnene kʉtsɨbʉ kʉlenga bishwi bɨngɨ.»<verse eid="LUK 12:7" /></para>
  <para style="s">Ɨmɨra n'ɨthɨnda Kirisito</para>
  <para style="r">(<ref loc="MAT 10:19-20">Mat 10:19-20</ref>; <ref loc="MAT 10:32-33">10:32-33</ref>; <ref loc="MAT 12:32">12:32</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8" />Yesʉ mwashʉba anegena athɨ: «Enyɨbabwɨra nyɨthɨ omʉndʉ amanyɨmɨra embere s'abandʉ, kuthyo <char style="w">Mʉgala w'oMʉndʉ</char> andamwɨmɨra embere <char style="w" lemma="Malaɨka">s'abamalaɨka</char> ba Gongo. <verse eid="LUK 12:8" /><verse number="9" style="v" sid="LUK 12:9" />Hewethuwe mʉndʉ amanyɨthɨnda embere s'abandʉ, naye kuthyo andathɨndwa embere <char style="w" lemma="Malaɨka">s'abamalaɨka</char> ba Gongo. <verse eid="LUK 12:9" /><verse number="10" style="v" sid="LUK 12:10" />Obʉlɨ mʉndʉ yo wandanegena kɨbɨ ko <char style="w">Mʉgala w'oMʉndʉ</char>, andaganyɨrwa. Hewethuwe yo wandahatsya <char style="w" lemma="Mʉthɨma Mwerʉ">ko Mʉthɨma Mwerʉ</char>, oyo athɨndaganyɨrwe na hake.<verse eid="LUK 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11" />«Mo ndambi mwandagenda omʉthwalwa mo so <char style="w" lemma="Sinakoki">sinakoki</char> bʉshana n'ɨyabʉrana embere s'abasohi, kʉtse embere s'abakʉlʉ b'ekɨhʉgo, mʉthagenda omugangya-gangya emɨthɨma enyu nga mwandabʉrana mʉthɨ, kʉtse nga mwandanegena ki. <verse eid="LUK 12:11" /><verse number="12" style="v" sid="LUK 12:12" />Kʉshangwa kona kathambi ako <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> andabakangɨrɨtsya ebyo mwanganegena.»<verse eid="LUK 12:12" /></para>
  <para style="s">Mushinga w'omushoki kahʉmo</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13" />Mʉndʉ mʉgʉma mo muhindano mwabwɨra Yesʉ athɨ: «Mʉkangɨrɨtsya, nyɨbwɨrɨre mʉgala ethʉ anyɨgabɨre omʉhango aye w'oko mwandʉ thatha athushigiraga.» <verse eid="LUK 12:13" /><verse number="14" style="v" sid="LUK 12:14" />Yesʉ mwamʉshʉbɨtsya athɨ: «Mwira aye! Nɨ ndɨ yo wanyɨgɨragamo musohi enyu, kʉtse nyibye w'ɨbagabɨra obushoki bwenyu?» <verse eid="LUK 12:14" /><verse number="15" style="v" sid="LUK 12:15" />Honyuma kw'aho, Yesʉ mwabwɨra abandʉ boshi athɨ: «Ohe! Mʉgende omuyitheya ko ngʉmbʉ s'obushoki. Kʉshangwa obʉyɨngo bw'omʉndʉ bʉthalɨ mo bʉngɨ bw'obushoki bʉwe na mwangabya mushoki kʉtsɨbʉ.»<verse eid="LUK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16" />Aho Yesʉ mwatsɨrabo mushinga athɨ: «Kwabyaga mushoki mʉgʉma abyaga awithe mashwa ʉwe. Amashwa ayo mweramo mɨaka mɨngɨ. <verse eid="LUK 12:16" /><verse number="17" style="v" sid="LUK 12:17" />Omushoki oyo mwathanga ɨganɨtsya n'ɨyɨbʉtsya athɨ: “Nyayɨra nyɨthɨ kwenzi? Emyaka aye yoshi eyi ndakiwithe ho nyahiraro!” <verse eid="LUK 12:17" /><verse number="18" style="v" sid="LUK 12:18" />Aho mwanegena athɨ: “Nyithya ko nyayɨra: nyahimbula esombʉpʉ saye, n'ɨshʉba himba sɨndɨ nene nene. N'omo mbʉpʉ etho monyandahira engano aye yoshi n'obʉndɨ bushoki bwaye. <verse eid="LUK 12:18" /><verse number="19" style="v" sid="LUK 12:19" />Honyuma kw'aho, nyandayɨbwɨra nyɨthɨ: ‘Ingye nyamayɨbɨkɨra bushoki bʉngɨ bo bwandamala mɨaka mɨngɨ. Aho nyangalʉhʉka, kʉshangwa nyirye, nyɨshome na nyɨmoge!’”»<verse eid="LUK 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 12:20" />«Hewethuwe Gongo mwamʉbwɨra athɨ: “Ɨwe mʉndʉ kahʉmo! Mo kɨro kya munobwire wafwa. Aho obushoki bwawe bwoshi bo wamalire ɨyɨbɨkɨra bwandabya bwa ndɨ?”»<verse eid="LUK 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21" />Yesʉ mwashʉba negena athɨ: «Ekyo kyo kinahikira omʉndʉ yo unashondya ɨyɨthʉndɨra bushoki bʉngɨ, hewethuwe athalɨ mushoki embere sa Gongo.»<verse eid="LUK 12:21" /></para>
  <para style="s">Iyinihira Gongo</para>
  <para style="r">(<ref loc="MAT 6:25-34">Mat 6:25-34</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22" />Aho Yesʉ mwabwɨra <char style="w">abɨga</char> bʉwe athɨ: «Ekyo kyo kyamaleka nɨnyababwɨra nyɨthɨ: mʉthagenda omuganga-gangya emɨthɨma enyu bʉshana n'obʉyɨngo bwenyu, mw'ɨnegena nga mwalya ki. Kʉtse iganga-gangya emɨthɨma enyu bʉshana n'emɨbɨrɨ enyu nga mwandambala ki. <verse eid="LUK 12:22" /><verse number="23" style="v" sid="LUK 12:23" />Ega! Kʉshangwa obʉyɨngo bwenyu bo buwithe kɨtsɨro kʉlenga akalyo. N'emɨbɨrɨ enyu yo yiwithe kɨtsɨro kʉlenga esongɨmba. <verse eid="LUK 12:23" /><verse number="24" style="v" sid="LUK 12:24" />Mʉlolere ko bɨkororo, bɨthahera na kandɨ bɨthahʉlʉla, bɨthayɨra handʉ h'ɨbɨkamo kalyo kʉtse mbʉpʉ. Hewethuwe Gongo anagenda alɨsabyo. Aho ni imwe mo muwithe kɨtsɨro kɨnene kʉlenga ebɨronge. <verse eid="LUK 12:24" /><verse number="25" style="v" sid="LUK 12:25" />Ɨndɨ mo kathi kenyu mw'iganga-gangya omʉthɨma ʉwe angayongerera kathambi kake ko bʉyɨngo bʉwe? Hathalɨ! <verse eid="LUK 12:25" /><verse number="26" style="v" sid="LUK 12:26" />Mʉlɨ muthangakotsya ɨkola kandʉ kake ng'ako, bʉshana na ki omugangya-gangya emɨthɨma enyu bʉshana n'ebɨndɨ bɨndʉ?<verse eid="LUK 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 12:27" />«Mʉshʉnge omʉshanga nga kw'anagenda alasha. Athakola, na kandɨ athayɨlandɨra ngɨmba. Hewethuwe enyɨbabwɨra nyɨthɨ n'omwamɨ Solomona mo bushoki bʉwe boshi, mwathambala lʉkɨmba lukwirire nga mʉgʉma w'oko mʉshanga oyo. <verse eid="LUK 12:27" /><verse number="28" style="v" sid="LUK 12:28" />Ebɨthɨ by'omwɨshwa ebɨnashʉngɨka munobwire na mungya nɨ byagʉshwa mo mʉtsanwa. Namo bɨnalɨ bithyo Gongo anagenda ambikyabyo ngɨmba sikwirire. Nemwe athindabambikye kʉbʉyahanga imwe bandʉ b'olwɨkɨrɨtsyo lʉke? <verse eid="LUK 12:28" /><verse number="29" style="v" sid="LUK 12:29" />Mʉthagenda omuyigangya-gangya bʉshana n'ishondya ebyo mwandalya n'ebyo mwandashoma. <verse eid="LUK 12:29" /><verse number="30" style="v" sid="LUK 12:30" />Kʉshangwa nɨ abandʉ b'omo kɨhʉgo, bobathetsi Gongo, bobanashondya ebɨndʉ byoshi ebyo bʉthalʉha. H'imwe ye Sho etsi ko mulayire ko bɨndʉ ebyo. <verse eid="LUK 12:30" /><verse number="31" style="v" sid="LUK 12:31" />Aho imwe mwathagenda omushondya oBwamɨ bwa Gongo, naye andabongerera ebɨndɨ bɨndʉ byoshi.<verse eid="LUK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32" />«Imwe kɨkembe kɨke mʉthagenda omʉbaha kʉshangwa Ɨsho atsemesibwe erɨbaha oBwamɨ.»<verse eid="LUK 12:32" /></para>
  <para style="s">Ɨyɨbɨkɨra bushoki mo lʉbʉla</para>
  <para style="r">(<ref loc="MAT 6:19-21">Mat 6:19-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 12:33" />Yesʉ mwashʉba negena athɨ: «Mʉgʉtsye ebɨndʉ byenyu, n'esofaranga sathoka kʉbyo mʉhetho abatsene. Mʉyɨkometsye mbɨko sɨtɨndakʉle. Nɨ omo lʉbʉla mo mʉgende omʉbɨka obushoki bʉthɨndahwe. Nɨ aho, ɨho, ho omwɨtsɨ athangahika n'enʉndʉ ithangabihya. <verse eid="LUK 12:33" /><verse number="34" style="v" sid="LUK 12:34" />Kʉshangwa aho halɨ obushoki bwenyu, ho hanabya n'emɨthɨma enyu.»<verse eid="LUK 12:34" /></para>
  <para style="s">Bakoli babʉya</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35" />Yesʉ mwashʉba negena athɨ: «Mʉgende omuyithegekania kw'ɨkola, n'esotara senyu sibye nisinanokire. <verse eid="LUK 12:35" /><verse number="36" style="v" sid="LUK 12:36" />Mʉgende omubya ng'abakoli bo balindirire nyinya-kowabo ashʉbʉle ɨthoka ko ndwa. Andabya ahika n'ɨkongotha ko luyi, aho n'aho nɨbamʉkɨngʉlɨra. <verse eid="LUK 12:36" /><verse number="37" style="v" sid="LUK 12:37" />Bamagashanɨrwa abakoli bo nyinya-kowabo andeya nɨbane mʉmʉlɨnda ashʉbʉle! Kwenene enyɨbabwɨra, nyinya-kowabo oyo andambala ngɨmba s'omʉlɨmo, kandɨ andakokyabo ko lʉgalɨ balye n'ibya aho, alɨ athekʉlɨrabo akalyo. <verse eid="LUK 12:37" /><verse number="38" style="v" sid="LUK 12:38" />Bamagashanɨrwa abakoli bo nyinya-kowabo angahika mo kathi k'ekɨro kʉtse mo mambya matsɨbʉ nibanamulindire.<verse eid="LUK 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 12:39" />«Mʉmɨnye kʉbʉya k'omwenye enyʉmba angaminyire akathambi omwɨtsɨ andahikirako, athangalikire omwɨtsɨ athobole omwe. <verse eid="LUK 12:39" /><verse number="40" style="v" sid="LUK 12:40" />Nemwe kuthyo muyithegekenie, kʉshangwa <char style="w">Mʉgala w'oMʉndʉ</char> andashʉbʉla mo kathambi muthetsi.»<verse eid="LUK 12:40" /></para>
  <para style="s">Mukoli mʉthʉnganene na mukoli mʉbɨ</para>
  <para style="r">(<ref loc="MAT 24:45-51">Mat 24:45-51</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41" />Aho Petero mwabʉtsya Yesʉ athɨ: «Nyinya-kowethʉ, omushinga wamatsa oyu athulebitsye ithwe bene kʉtse alebitsye abandʉ boshi?»<verse eid="LUK 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42" />Nyinya-kowethʉ mwamʉshʉbɨtsya athɨ: «Ɨndɨ yo mukoli w'iyinihirwa na mwenge? Omukoli yo ʉlɨ ng'oyo n'ɨye yo nyinya-kowabo angamʉyɨramo mwimanitsi w'enyʉmba yɨwe. Omukoli oyo andagenda aha abakoli balikyabo bo kalyo ko ndambi ɨtholere. <verse eid="LUK 12:42" /><verse number="43" style="v" sid="LUK 12:43" />Amagashanɨrwa omukoli oyo nyinya-kowabo andabya ashʉbʉla angamweya nɨakɨnalɨ akola omʉlɨmo oyo. <verse eid="LUK 12:43" /><verse number="44" style="v" sid="LUK 12:44" />Kwenene enyɨbabwɨra, nyinya-kowabo andamʉyɨramo mwimanitsi w'obushoki bʉwe boshi.<verse eid="LUK 12:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 12:45" />«He n'omukoli oyo amathanga ɨyɨbwɨra mo mʉthɨma ʉwe athɨ: “Nyinya-kowethʉ amathɨndɨrayo,” honyuma kw'aho amagenda ahumba abakoli balikyabo abayira n'abakatsɨ, nɨathanga irya n'ɨshoma n'ikunda, <verse eid="LUK 12:45" /><verse number="46" style="v" sid="LUK 12:46" />nyinya-kowabo andashʉbʉla mo kɨro athalengekenie na ko ndambi athetsi. Aho nyinya-kowabo andamʉthɨbɨthako n'ɨmʉganzamo nga mʉndʉ athathʉnganene.»<verse eid="LUK 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47" />«Omukoli yo wetsi erishondya lya nyinya-kowabo, he athayithegekenie n'ɨkola nga ko nyinya-kowabo ashondire, omukoli oyo andahumbwa mihumbo mɨngɨ. <verse eid="LUK 12:47" /><verse number="48" style="v" sid="LUK 12:48" />He omukoli yo uthetsi erishondya lya nyinya-kowabo amakola ekyangaleka niahumbwa andahumbwa mihumbo mɨke. Omʉndʉ yo wahabawa bɨngɨ, andashabwa bɨngɨ. N'oyo wabikibawa bɨngɨ andabʉtsɨbwa bɨngɨ kʉtsɨbʉ.»<verse eid="LUK 12:48" /></para>
  <para style="s">Yesʉ mwaletha ɨgabana</para>
  <para style="r">(<ref loc="MAT 10:34-36">Mat 10:34-36</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49" />Yesʉ mwashʉba negena athɨ: «Mʉtsanwa wo nyalethaga mo kɨhʉgo! Nyanganzire n'omʉtsanwa oyo abye niamalire ɨnoka! <verse eid="LUK 12:49" /><verse number="50" style="v" sid="LUK 12:50" />Nyiwithe mʉtsɨgo wa malɨgo wo nyɨtholere ɨheka. Hano enyagalwa kʉtsɨbʉ mo mʉthɨma kw'ihika ko ndambi amalɨgo ayo andabererera. <verse eid="LUK 12:50" /><verse number="51" style="v" sid="LUK 12:51" />Omʉganɨtsya mʉthɨ nyahikaga bʉshana n'ɨletha bʉholo mo kɨhʉgo he? Ɨhɨ! Enyɨbabwɨra, ko n'ɨgabana lyo nyalethaga! <verse eid="LUK 12:51" /><verse number="52" style="v" sid="LUK 12:52" />Ɨthanga munobwire, bandʉ bathano b'omo nyʉmba ngʉma bandagabana, abashathʉ bandalwɨsa ababɨrɨ, n'ababɨrɨ bandalwɨsa abashathʉ. <verse eid="LUK 12:52" /><verse number="53" style="v" sid="LUK 12:53" />Omwana n'ishe bathɨndahʉlɨkɨrɨrane, omʉthasha na nyinya bathɨndahʉlɨkɨrɨrane, omwatsana na nyatsala nabo bathɨndahʉlɨkɨrɨrane.<note caller="+" style="f"><char style="fr" closed="false">12:53 </char><char style="xt" closed="false">Soma <ref loc="MIC 7:6">Mika 7:6</ref>.</char></note>»<verse eid="LUK 12:53" /></para>
  <para style="s">Ikumbula ebyo bɨtsʉka ko mɨgʉlʉ eno</para>
  <para style="r">(<ref loc="MAT 16:2-3">Mat 16:2-3</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54" />Yesʉ mwashʉba bwɨra omuhindano w'abandʉ athɨ: «Omunabya mwashʉnga ekɨfʉ kyahʉlʉka ebʉlengera ɨtsʉba, aho n'aho omʉnagenda omʉnegena mʉthɨ: “Envʉla eyishondya ɨwa.” Kwenene, naro nɨyawa. <verse eid="LUK 12:54" /><verse number="55" style="v" sid="LUK 12:55" />Na mo ndambi ekɨhʉnga ekɨnagenda ekɨhʉlʉka emʉnda kihya, aho n'aho omʉnagenda omʉnegena mʉthɨ: “Ekyʉka kyabya kɨngɨ.” Na kwenene, ekyʉka nikyabya kɨngɨ. <verse eid="LUK 12:55" /><verse number="56" style="v" sid="LUK 12:56" />Mʉlɨ bayimbya! Omʉnamɨnya ikumbula emɨgʉlʉ ya hano ishi na y'elʉbʉla. Hewethuwe bʉshana na ki omʉlemwa ikumbula ebyo bɨtsʉka mo bɨro bɨno?»<verse eid="LUK 12:56" /></para>
  <para style="s">Ɨhʉlɨkɨrɨrana n'enzigu awe</para>
  <para style="r">(<ref loc="MAT 5:25-26">Mat 5:25-26</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57" />Yesʉ mwashʉba negena athɨ: «Bʉshana na ki mʉthalɨ omʉsonzomola kʉbʉya emɨkolere enyu, imwe bene-bene muthangakotsya ɨlola kʉbʉya-kʉbʉya kw'ebyo mwangakolire? <verse eid="LUK 12:57" /><verse number="58" style="v" sid="LUK 12:58" />Wamabya ʉlɨ oʉya ko tɨrɨbɨnalɨ ɨya bʉrana n'omʉfwane awe, kola kyo wangakotsya ʉhʉlɨkɨrɨrane naye mʉkɨnalɨ mo nzɨra. Bɨthalɨ bityo niandakuhikya ahalɨ omusohi, n'omusohi oyo andakʉheretsya abapolisi, n'abapolisi bandakʉgʉsha mo muliki. <verse eid="LUK 12:58" /><verse number="59" style="v" sid="LUK 12:59" />Enyɨkʉbwɨra nyɨthɨ ʉthangathoka mo muliki oyo uthetsi wafʉha esengi nyɨtsɨndʉ-tsɨndʉ.»<verse eid="LUK 12:59" /></para>
  <chapter eid="LUK 12" />
  <chapter number="13" style="c" sid="LUK 13" />
  <para style="s">Endundi y'erɨbɨndʉka mw'ɨthoka mo bɨtsɨbʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1" />Oko ndambi eyo, bandʉ bagʉma mobaya ahalɨ Yesʉ nɨabayamʉbwɨra ng'oko <char style="w">Pilato</char> mwithisa bandʉ bagʉma omo kɨhʉgo ky'iNgalilaya, mo ndambi bagenda abakera so nyama s'ɨherera Gongo. <verse eid="LUK 13:1" /><verse number="2" style="v" sid="LUK 13:2" />Yesʉ mwabʉtsyabo athɨ: «Omʉganɨtsya mʉthɨ abandʉ b'iNgalilaya abo bithawa bathyo, n'ɨnegena mbʉ babyaga bakoli b'ebɨtsɨbʉ kʉlenga abandɨ abandʉ b'iNgalilaya boshi? <verse eid="LUK 13:2" /><verse number="3" style="v" sid="LUK 13:3" />Ɨhɨ! Enyɨbabwɨra nyɨthɨ nemwe muthabindukire, nemwe boshi kuthyo mwandafwa nga ko bafwaga. <verse eid="LUK 13:3" /><verse number="4" style="v" sid="LUK 13:4" />N'omo muyi w'iSiloamu, omʉnara mwatherera kʉ bandʉ ikumi na mʉnanɨ, nabo mobafwa. Omʉganɨtsya mʉthɨ babyaga bakoli b'ebɨbɨ kʉlenga abahimbani boshi b'ɨYerʉsalemʉ? <verse eid="LUK 13:4" /><verse number="5" style="v" sid="LUK 13:5" />Ɨhɨ! He enyɨbabwɨra nemwe nyɨthɨ, muthabindukire ɨthoka mo bɨtsɨbʉ byenyu, nemwe boshi mwandafwa nga abandʉ abo ko bafwaga.»<verse eid="LUK 13:5" /></para>
  <para style="s">Omushinga w'omʉthɨ w'omutini bʉthaheka bɨgʉma</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6" />Honyuma kw'aho, Yesʉ mwatsɨrabo ogʉndɨ mushinga ono athɨ: «Habyaga mʉndʉ mʉgʉma abyaga niaherire mʉthɨ wa mutini <char style="w" lemma="Musabibu">mw'ɨshwa lɨwe ly'emisabibu</char>. Kɨro kɨgʉma mwayashondya kʉwo ko biguma he mwathabonabyo kʉwo. <verse eid="LUK 13:6" /><verse number="7" style="v" sid="LUK 13:7" />Bʉshana n'ekyo, mwabwɨra omukoli yo wagenda amʉkolera mw'ɨshwa lɨwe athɨ: “Shʉnga! Eno nɨ mɨaka ishathu yamatsʉka nienyinashondya biguma ko mʉthɨ w'omutini oyu, he nyɨthalɨ enyɨnabonako nethe. Bʉshana n'ekyo tsawo! Kʉshangwa abihya ekɨthaka kyo bʉsha.” <verse eid="LUK 13:7" /><verse number="8" style="v" sid="LUK 13:8" />Hewethuwe omukoli oyo mwashubya athɨ: “Nyinya-kowethʉ, thashʉba likawo kandɨ ko mwaka ono. Nyashʉba shekererawo n'ihiramo bʉyɨnʉ. <verse eid="LUK 13:8" /><verse number="9" style="v" sid="LUK 13:9" />Omw'ɨkola ebyo kʉthɨ anganaheka biguma mo mwaka owahika. Bɨthabere bithyo aho nɨmo wandatsawo.”»<verse eid="LUK 13:9" /></para>
  <para style="s">Yesʉ alamya mʉkatsɨ ekɨro ky'eSabato</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10" />Kɨro kɨgʉma <char style="w" lemma="Sabato">ky'eSabato</char> Yesʉ agenda akangɨrɨtsya bandʉ mo <char style="w" lemma="Sinakoki:">sinakoki</char>. <verse eid="LUK 13:10" /><verse number="11" style="v" sid="LUK 13:11" />Mo sinakoki eyo mwabyaga mʉkatsɨ mʉgʉma mukoni. Omʉkatsɨ oyo abyaga nɨamamala mɨaka ikumi na mʉnanɨ nianemunubibwa <char style="w" lemma="mɨtsɨmʉ">n'omʉtsɨmʉ mʉbɨ</char>. <char style="w" lemma="mɨtsɨmʉ">Omʉtsɨmʉ</char> oyo abyaga niafunyire omʉgongo ʉwe ihika ko kɨka k'ɨremwa ɨyɨsɨngɨka. <verse eid="LUK 13:11" /><verse number="12" style="v" sid="LUK 13:12" />Yesʉ abere amʉshʉngako mwamʉbɨrɨkɨra n'ɨmʉbwɨra athɨ: «Koyo, wamalamibwa obʉlema bwawe.» <verse eid="LUK 13:12" /><verse number="13" style="v" sid="LUK 13:13" />Yesʉ mwamuhirako eminwe, aho n'aho, omʉkatsɨ oyo mwashʉba yɨsɨngɨka n'ɨthanga isingya Gongo.<verse eid="LUK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14" />Hewethuwe <char style="w" lemma="Sinakoki">omʉkʉlʉ w'esinakoki</char> eyo, mwatsɨbʉka bʉshana na Yesʉ kw'amalamya omukoni ekɨro <char style="w" lemma="Sabato">ky'eSabato</char>. Bʉshana n'ekyo, mwabwɨra omuhindano w'abandʉ athɨ: «Kʉlɨ bɨro ndathʉ b'ɨkolamo mʉlɨmo. Nɨmo bɨro ebyo momʉtholere ɨgenda omuhika bʉshana mulamibwe, he kɨthalɨ ekɨro <char style="w" lemma="Sabato">ky'eSabato</char>.»<verse eid="LUK 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15" />He Nyinya-kowethʉ mwamʉshʉbɨtsya athɨ: «Mʉlɨ bayimbya! Ndɨ munetsi kw'ekɨro <char style="w" lemma="Sabato">ky'eSabato</char> obʉlɨ mʉndʉ mw'imwe anagenda ahangʉla ende kʉtse epʉnda yɨwe aho ɨnagenda ɨhangwa bʉshana athwalero ko maliba. <verse eid="LUK 13:15" /><verse number="16" style="v" sid="LUK 13:16" />Omʉkatsɨ ono nɨ w'omo lʉganda lwa <char style="w">Abʉrahamʉ</char> yo <char style="w">Sitani</char> amɨnaga mɨaka ikumi na mʉnanɨ. Aho, bɨthatholere amɨnʉlwe mo kɨro <char style="w" lemma="Sabato">ky'eSabato</char>?»<verse eid="LUK 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 13:17" />Yesʉ abere amamala ɨnegena ebɨnwa ebyo, esonzigu sɨwe soshi mosafwa shoni. He omuhindano woshi w'abandʉ ɨwo, mwagenda amogera ebɨthɨko-thɨko byoshi Yesʉ agenda akola.<verse eid="LUK 13:17" /></para>
  <para style="s">Mushinga w'akambulu k'eharatali</para>
  <para style="r">(<ref loc="MAT 13:31-33">Mat 13:31-33</ref>; <ref loc="MRK 4:30-32">Mar 4:30-32</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18" />Yesʉ mwashʉba negena athɨ: «<char style="w" lemma="Bwamɨ bwa Gongo">oBwamɨ bwa Gongo</char> bwangashoshekanibwa na ki? Kandɨ iki kyo nyangalingania nabo? <verse eid="LUK 13:18" /><verse number="19" style="v" sid="LUK 13:19" />oBwamɨ obo bushoshire nga kambulu kake ka haratali, ko mʉndʉ mʉgʉma ayaga hera mw'ɨshwa lɨwe. Akambulu kake ako mokalasha mokabya mʉthɨ mʉnene, n'ebɨronge mobyayahimba so nyʉthʉ sabyo ko mɨthahɨ yago.»<verse eid="LUK 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20" />Yesʉ mwashʉba negena athɨ: «<char style="w" lemma="Bwamɨ bwa Gongo">oBwamɨ bwa Gongo</char> nyangalinganiabo na ki? <verse eid="LUK 13:20" /><verse number="21" style="v" sid="LUK 13:21" />oBwamɨ obo bushoshire nga <char style="w">tsatsʉ</char> yo mʉkatsɨ mʉgʉma atsɨmbaga n'ithulunganiaro mʉ hɨthonga hɨshathʉ hya shyano, ihika ko kɨka eshyano yoshi moyabimba.»<verse eid="LUK 13:21" /></para>
  <para style="s">Lukyo lʉfʉnda</para>
  <para style="r">(<ref loc="MAT 7:13-14">Mat 7:13-14</ref>,<ref loc="MAT 7:21-23">21-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22" />Yesʉ abyaga mo lʉgendo lw'ɨrʉkɨra ɨYerʉsalemʉ. Mwatsʉka mo miyi n'omo mɨrongo nɨakangɨrɨtsya bandʉ. <verse eid="LUK 13:22" /><verse number="23" style="v" sid="LUK 13:23" />Mʉndʉ mʉgʉma mwamʉbʉtsya athɨ: «Nyinya-kowethʉ, nɨna bandʉ bake bo bandashabʉlwa?» Yesʉ mwabwɨrabo athɨ: <verse eid="LUK 13:23" /><verse number="24" style="v" sid="LUK 13:24" />«Mʉyɨtsɨnge ɨngɨra mo lukyo lʉfʉnda. Kʉshangwa enyɨbabwɨra kwenene, bandʉ bangɨ bandayɨrenga ɨngɨra mʉlo he bandalemwa.<verse eid="LUK 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 13:25" />«Omwenye enyʉmba andabya nɨamamala imana n'ɨkɨnga oluyi, nemwe mwandabya nimwimene embʉga. Nemwe mwandathanga ɨkongotha ko luyi nɨomʉnegena mʉthɨ: “Nyinya-kowethʉ, thʉkɨngʉlɨre!” Naye andabashʉbɨtsya athɨ: “Nyithetsi yo mʉthoka.” <verse eid="LUK 13:25" /><verse number="26" style="v" sid="LUK 13:26" />Aho mwandathanga ɨnegena mʉthɨ: “Thwalyaga n'ɨshoma hagʉma nawe. Kandɨ mowakangɨrɨtsya abandʉ b'omo mɨhengere y'omo muyi ethʉ.” <verse eid="LUK 13:26" /><verse number="27" style="v" sid="LUK 13:27" />Hewethuwe andababwɨra athɨ: “Nyithetsi yo mʉthoka. Mʉthoke mo mesho aye imwe boshi bakoli b'ebɨbɨ!” <verse eid="LUK 13:27" /><verse number="28" style="v" sid="LUK 13:28" />Mwandashʉnga <char style="w">Abʉrahamʉ</char>, na Isaka, na Yakobo <char style="w" lemma="Mʉmɨnyeretsɨ">n'abamɨnyeretsɨ</char> boshi mo <char style="w">Bwamɨ bwa Gongo</char>. H'imwe mwandagʉshwa embʉga. Eyo, mwandalɨra n'ɨshʉnga kya bwana. <verse eid="LUK 13:28" /><verse number="29" style="v" sid="LUK 13:29" />Abandʉ bandathoka ebʉbʉkɨra ɨtsʉba n'ebʉlengera ɨtsʉba, ko mʉnda lʉgʉlʉ na ko mʉnda kihya. Abandʉ abo bandikala niabalya kalyo mo <char style="w">Bwamɨ bwa Gongo</char>. <verse eid="LUK 13:29" /><verse number="30" style="v" sid="LUK 13:30" />Mʉhʉlɨkɨrɨtsye! Bandʉ bagʉma bo balɨ banyuma-nyuma bandabya bambere-mbere. Na bo balɨ bambere-mbere bandabya banyuma-nyuma.»<verse eid="LUK 13:30" /></para>
  <para style="s">Yesʉ alɨrɨra abahimbani b'ɨYerʉsalemʉ</para>
  <para style="r">(<ref loc="MAT 23:37-39">Mat 23:37-39</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31" />Mo kathambi ako <char style="w" lemma="Bafarisayo:">Bafarisayo</char> bagʉma mobahikira Yesʉ n'ɨmʉbwɨra bathɨ: «Yɨhɨgʉle, kʉshangwa <char style="w">Herote</char> ashondya ikwitha.» <verse eid="LUK 13:31" /><verse number="32" style="v" sid="LUK 13:32" />Yesʉ mwashʉbɨtsyabo athɨ: «Mʉyabwɨre omʉtherere oyo mʉthɨ: “Enyɨbɨnga <char style="w" lemma="mɨtsɨmʉ">emɨtsɨmʉ</char> mɨbɨ, n'ilamya abakoni munobwire na mʉmakera. Na mwabwakya nyandabya nɨnyamamala omʉlɨmo aye.” <verse eid="LUK 13:32" /><verse number="33" style="v" sid="LUK 13:33" />Hewethuwe lɨtholere munobwire na mʉmakera, na mwabwakya nyɨkwame olʉgendo. Kʉshangwa lɨthatholere <char style="w" lemma="Mʉmɨnyeretsɨ">omʉmɨnyeretsɨ</char> niathithirwa mʉ ʉndɨ muyi athalɨ w'ɨYerʉsalemʉ.<verse eid="LUK 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34" />«Imwe bahimbani b'ɨYerʉsalemʉ! Imwe momʉnagenda omwitha <char style="w" lemma="Mʉmɨnyeretsɨ">abamɨnyeretsɨ</char>. N'abandʉ Gongo anabathʉmɨra omʉnagenda omwɨthabo mw'ihumabo mabwe. Ngendo sɨngahɨ monyashondire ibahindania ng'engoko ko ɨnagenda eyihindania ehipyeye mo bipupa byaro. He, imwe momwathindire. <verse eid="LUK 13:34" /><verse number="35" style="v" sid="LUK 13:35" />Monvwe! Enyʉmba enyu yandabya kihuma. Enyɨbabwɨra kwenene, ko mʉthɨndashʉbe nyɨlolako ihika ko ndambi mwandanegena mʉthɨ: “Agashanɨrwe yo uhika kw'ɨtsɨna lya Nyinya-kowethʉ!<note caller="+" style="f"><char style="fr" closed="false">13:35 </char><char style="xt" closed="false">Soma <ref loc="PSA 118:26">Saburi 118:26</ref>.</char></note>”»<verse eid="LUK 13:35" /></para>
  <chapter eid="LUK 13" />
  <chapter number="14" style="c" sid="LUK 14" />
  <para style="s">Yesʉ alamya mukoni mʉgʉma ekɨro ky'eSabato</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1" />Kɨro kɨgʉma <char style="w" lemma="Sabato">ky'eSabato</char> Yesʉ mwayalya ku kalyo mo nyʉmba ya mʉgʉma w'oko bakʉlʉ <char style="w" lemma="Bafarisayo:">b'aBafarisayo</char>. Abandʉ bo babyaga mo nyʉmba eyo nɨabayɨthegeretsya Yesʉ yo kʉtsɨbʉ bʉshana balole ebyo ashondya ɨkola. <verse eid="LUK 14:1" /><verse number="2" style="v" sid="LUK 14:2" />Shʉnga! Embere sa Yesʉ habyaga mʉndʉ mʉgʉma omʉbɨrɨ ʉwe abyaga nɨalwere bukoni bw'ibimbabimba. <verse eid="LUK 14:2" /><verse number="3" style="v" sid="LUK 14:3" />Yesʉ mwabʉtsya abakangɨrɨtsya <char style="w" lemma="Mʉgomba">b'oMʉgomba</char> <char style="w" lemma="Bafarisayo:">n'aBafarisayo</char> athɨ: «<char style="w" lemma="Mʉgomba">oMʉgomba</char> ethʉ anahamulire kʉtse ahangire ilamya mʉndʉ mo kɨro <char style="w" lemma="Sabato">ky'eSabato</char>?» <verse eid="LUK 14:3" /><verse number="4" style="v" sid="LUK 14:4" />Hewethuwe mobayumya. Aho Yesʉ mwakola ko mukoni oyo, mwamulamya n'ɨmʉbwɨra athɨ agende. <verse eid="LUK 14:4" /><verse number="5" style="v" sid="LUK 14:5" />Honyuma kw'aho Yesʉ mwashʉba bʉtsyabo athɨ: «Mʉgʉma mw'imwe alɨ awithe mʉgala ʉwe kʉtse ekɨmasa kɨwe kyo kyamathogera mo kyuna kɨrɨmo metsi aho n'aho nɨathɨyɨhʉthe iyathokyakyomo na mokyangabya kɨro <char style="w" lemma="Sabato">ky'eSabato</char>?» <verse eid="LUK 14:5" /><verse number="6" style="v" sid="LUK 14:6" />Nabo mobathakotsya ishubya kw'ekyo.<verse eid="LUK 14:6" /></para>
  <para style="s">Iyihamya kʉtse iyikehya</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7" />Yesʉ mwayɨthegeretsya bobakokibawa ko abashombola emyanya y'embere. Aho mwahabo amahano ano athɨ: <verse eid="LUK 14:7" /><verse number="8" style="v" sid="LUK 14:8" />«Mo ndambi mʉndʉ amakʉbɨrɨkɨra ko linye lya buheruki ʉthagenda ow'ikala ko bifumbi by'embere. Kʉshangwa mo bobathabɨrɨkɨrwa mwanganabya mʉndʉ w'olʉkengerwa kw'ɨkʉlenga. <verse eid="LUK 14:8" /><verse number="9" style="v" sid="LUK 14:9" />N'omʉndʉ w'olʉkengerwa oyo amahika, oyo ʉthababɨrɨkɨra imwe babɨrɨ amahika n'ɨkʉbwɨra athɨ: “Shigira oyu y'ekifumbi.” Aho nɨwafwa shoni bʉshana n'iyikala enyuma. <verse eid="LUK 14:9" /><verse number="10" style="v" sid="LUK 14:10" />Hewethuwe wamabɨrɨkɨrwa niwayikala enyuma. N'omo ndambi yo ʉthakʉbɨrɨkɨra abya ahika n'ɨkʉbwɨra athɨ: “Mwiraye, hika wikale embere.” Aho abandʉ boshi bomulya nabo bangakushikya. <verse eid="LUK 14:10" /><verse number="11" style="v" sid="LUK 14:11" />Kʉshangwa obʉlɨ mʉndʉ yo unayihamya andakehibwa, hewethuwe, yo unayikehya ɨye andahamibwa.»<verse eid="LUK 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12" />Honyuma kw'aho Yesʉ mwabwɨra oyo wamʉbɨrɨkɨraga athɨ: «Mo ndambi ogukomya kalyo k'elinye, kangabya k'omo mwɨshɨ kʉtse k'olʉlengero, ʉthagendaga ʉbɨrɨkɨra bira bawe kʉtse bagala b'enyu kʉtse babuthi bawe kʉtse abahimbani bawe bashoki basha, kʉshangwa wetsi ko nabo kuthyo bangakʉbɨrɨkɨra, aho niwabya nga bamakʉfʉha. <verse eid="LUK 14:12" /><verse number="13" style="v" sid="LUK 14:13" />Hewethuwe ʉlɨ ogukomya akalyo k'elinye, ʉgende ʉbɨrɨkɨra abatsene, ebɨrema, bobashyonogera n'esombumi. <verse eid="LUK 14:13" /><verse number="14" style="v" sid="LUK 14:14" />Aho, wamakola uthyo wandagashanɨrwa, kʉshangwa abandʉ abo bathawithe by'ɨkʉshʉbʉlɨtsya. Gongo yo wandakʉshʉbʉlɨtsya ko ndambi abakolaga ebɨthʉnganene bandalubuka.»<verse eid="LUK 14:14" /></para>
  <para style="s">Mushinga w'abo bathabɨrɨkɨrwa ko linye</para>
  <para style="r">(<ref loc="MAT 22:1-10">Mat 22:1-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15" />Mʉndʉ mʉgʉma w'oko bobagendaga abalya hagʉma na Yesʉ abere amamala ɨonvwa ebɨnwa ebyo mwabwɨra Yesʉ athɨ: «Agashanirwe omʉndʉ yo wandalya ko kalyo mo <char style="w">Bwamɨ bwa Gongo</char>!» <verse eid="LUK 14:15" /><verse number="16" style="v" sid="LUK 14:16" />Yesʉ mwamʉshʉbɨtsya mo mushinga ono athɨ: «Mʉndʉ mʉgʉma mwatheka kalyo kangɨ k'elinye na mwabɨrɨkɨra bandʉ bangɨ. <verse eid="LUK 14:16" /><verse number="17" style="v" sid="LUK 14:17" />Endambi y'erirya yabere yahika, mwathʉma omukoli ʉwe ayabwɨre bobathabɨrɨkɨrwa athɨ: “Ewo muhike kʉshangwa ebyoshi byamalire ithegekanibwa.” <verse eid="LUK 14:17" /><verse number="18" style="v" sid="LUK 14:18" />Hewethuwe bʉlɨ mʉndʉ, mwathanga ɨyɨhambʉlɨtsya. Omʉmbere mwabwɨra omukoli oyo athɨ: “Monyagulire ɨshwa, enyishondya ɨyalola kʉlyo. Enyɨkʉshaba ʉnyɨshashɨre.” <verse eid="LUK 14:18" /><verse number="19" style="v" sid="LUK 14:19" />N'ogʉndɨ mwanegena athɨ: “Monyagulire bɨmasa ikumi by'ɨrɨmamo, enyishondya ɨyalola nga byanganakotsya ɨkola. Enyɨkʉshaba ʉnyɨshashɨre.”<verse eid="LUK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 14:20" />«N'ogʉndɨ mwanegena athɨ: “Nyaherukaya lɨno-lɨno, bʉshana n'ekyo nyithangahika.”<verse eid="LUK 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 14:21" />«Honyuma kw'aho omukoli oyo mwashʉba eyo nyinya-kowabo abyaga n'ɨmʉfʉlɨra ebyoshi ebyo. Aho omwenye enyʉmba abere onvwa ebyo, mwatsɨbʉka n'ɨbwɨra omukoli ʉwe athɨ: “Genda tsʉba mo mbʉga n'omo nzɨra s'omo muyi, bʉshana ʉlethe abatsene na bobashyonogera, n'esombumi n'ebɨrema, wɨngɨtsyebo mʉno.” <verse eid="LUK 14:21" /><verse number="22" style="v" sid="LUK 14:22" />Honyuma kw'aho omukoli oyo mwashʉbʉla n'ɨnegena athɨ: “Nyinya-kowethʉ, ebyoshi ʉthahamʉla nyɨkole, nyamakolabyo. Hewethuwe hakɨnalɨ mwanya.” <verse eid="LUK 14:22" /><verse number="23" style="v" sid="LUK 14:23" />Aho nyinya-kowabo mwabwɨra omukoli ʉwe oyo athɨ: “Genda mo nzɨra s'othʉnzalɨ, n'omo mɨkɨkɨ y'amashwa. Abandʉ bo weyayo uhathikaniebo bɨngɨre omwaye nɨmo enyʉmba aye y'otsula. <verse eid="LUK 14:23" /><verse number="24" style="v" sid="LUK 14:24" />Ega! Enyɨbabwɨra hathalɨ mʉndʉ n'omʉgʉma w'oko bobabɨrɨkɨrawa yo wandagetsya ko kalyo kaye.”»<verse eid="LUK 14:24" /></para>
  <para style="s">Imika ebyoshi bʉshana n'ɨkwama Yesʉ</para>
  <para style="r">(<ref loc="MAT 10:37-38">Mat 10:37-38</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25" />Kɨro kɨgʉma muhindano mʉnene wa bandʉ mwakwama Yesʉ. Mwabɨndʉka n'ɨbwɨrabo athɨ: <verse eid="LUK 14:25" /><verse number="26" style="v" sid="LUK 14:26" />«Omʉndʉ yo ushondya ɨnyɨkwama anyɨtsɨɨre kʉlenga ishe, na nyinya, na mʉkatsɨwe, n'abana bʉwe, na bagala babo na balɨ babo. Na kandɨ atholere nɨanyɨtsɨɨra kʉlenga obʉyɨngo bʉwe. Bɨthalɨ bithyo athangabya <char style="w" lemma="Abɨga">mwɨga</char> aye. <verse eid="LUK 14:26" /><verse number="27" style="v" sid="LUK 14:27" />Omʉndʉ yo uthahekire <char style="w" lemma="Mʉsalaba">omʉsalaba</char><note caller="+" style="f"><char style="fr" closed="false">14:27 </char><char style="ft" closed="false">Ɨheka omʉsalaba gʉwe n'ɨtsɨga ɨagalwa kʉtse ɨfwa bʉshana na Yesʉ Kirisito.</char></note> ʉwe n'ɨnyɨkwama athangabya <char style="w" lemma="Abɨga">mwɨga</char> aye.<verse eid="LUK 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28" />«Mo ndambi mʉgʉma wa kw'imwe yo ushondya ihimba nyʉmba ya ngorofa, lɨtholere nɨathanga ikala n'ɨkola emɨganzo ng'anganabona esofaranga sosandamala omʉlɨmo oyo. <verse eid="LUK 14:28" /><verse number="29" style="v" sid="LUK 14:29" />He amahimba omʉsɨngɨ, honyuma kw'aho amalemwa iotsutsya enyʉmba eyo, abandʉ boshi bo bandagenda abashʉnga kʉro nɨbandagenda abamʉsheka, <verse eid="LUK 14:29" /><verse number="30" style="v" sid="LUK 14:30" />nɨabanegena bathɨ: “Omʉndʉ oyu mwathangɨra ihimba enyʉmba, hewethuwe mwalemwa iotsutsyaro.”<verse eid="LUK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31" />«Mo ndambi mwamɨ mʉlebe ashondya ɨyalwa n'ogʉndɨ mwamɨ, lɨtholere nɨathanga ikala, n'ɨlola nga abashirikani bʉwe bɨhʉmbɨ ikumi nga angana kinda mulikyabo yo uwithe abashirikani bɨhʉmbɨ makumi abɨrɨ? <verse eid="LUK 14:31" /><verse number="32" style="v" sid="LUK 14:32" />Amamɨnya kw'athangakotsya, nɨathʉmɨra mulikyabo oyo yo bagendi nɨakɨnalɨ hale bʉshana n'ɨmʉbʉtsya ng'ɨbo babɨrɨ bangabona obʉholo bo bathɨ. <verse eid="LUK 14:32" /><verse number="33" style="v" sid="LUK 14:33" />Nemwe kuthyo, hathalɨ mʉndʉ mo kathi kenyu yo wangabya <char style="w" lemma="Abɨga">mwɨga</char> aye alɨ athangamika ebyoshi awitheko.»<verse eid="LUK 14:33" /></para>
  <para style="s">Omunyu ow'athatholere</para>
  <para style="r">(<ref loc="MAT 5:13">Mat 5:13</ref>; <ref loc="MRK 9:50">Mar 9:50</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34" />Yesʉ mwashʉba negena athɨ: «Omunyu anabya kɨndʉ kikwirire. He omunyu amahetsya obʉshɨ bwawo nɨ ki kyo kyangahirwa mʉwo nɨmo ashʉba loka? <verse eid="LUK 14:34" /><verse number="35" style="v" sid="LUK 14:35" />Omunyu oyo athakɨtholere ibye ko kɨthaka ibye ko bʉyɨnʉ. Anagʉshwa embʉga. Yo ʉlɨko mathwi w'ɨonvwa onvwe!»<verse eid="LUK 14:35" /></para>
  <chapter eid="LUK 14" />
  <chapter number="15" style="c" sid="LUK 15" />
  <para style="s">Omushinga w'embuli yaheraga n'ɨboneka</para>
  <para style="r">(<ref loc="MAT 18:12-14">Mat 18:12-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1" />Kɨro kɨgʉma abakarani b'ekoli n'abandɨ bakoli b'ebɨtsɨbʉ boshi mobayɨfʉnda hofɨ na Yesʉ bʉshana n'ɨmʉhʉlɨkɨrɨtsya. <verse eid="LUK 15:1" /><verse number="2" style="v" sid="LUK 15:2" /><char style="w" lemma="Bafarisayo:">aBafarisayo</char> <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">n'abakangɨrɨtsya b'oMʉgomba</char> babere bashʉnga kw'ebyo, mobathanga ɨfweba Yesʉ nɨabanegena bathɨ: «Omʉndʉ oyu anagenda akokya abakoli b'ebɨtsɨbʉ n'irya nabo!»<verse eid="LUK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 15:3" />Bʉshana n'ebyo, Yesʉ mwatsɨrabo omushinga ono athɨ: <verse eid="LUK 15:3" /><verse number="4" style="v" sid="LUK 15:4" />«Mʉgʉma mw'imwe amayɨra kʉ mbuli sɨwe igana, n'engʉma mo mbuli sɨwe etho nɨyahera. Angakola ki? Athangamika amakumi mwenda na mwenda mo kɨkʉyʉ bʉshana n'iyashondya yo yɨthahera ihika kw'ɨbonaro! <verse eid="LUK 15:4" /><verse number="5" style="v" sid="LUK 15:5" />Anabya abonaro athalɨ anahekaro ko bithigo nɨagenda niamogire! <verse eid="LUK 15:5" /><verse number="6" style="v" sid="LUK 15:6" />Anabya ahika ewe, athalɨ anabɨrɨkɨra abira bʉwe n'abahimbani bʉwe n'ɨbwɨrabo athɨ: “Mʉmoge hagʉma nangye. Kʉshangwa embuli aye yo yithabya niyaherire nyamabonaro.” <verse eid="LUK 15:6" /><verse number="7" style="v" sid="LUK 15:7" />Enyɨbabwɨra, kuthyo ko mo lʉbʉla mwandabya lʉmogo lʉnene kʉtsɨbʉ bʉshana na mukoli mʉgʉma w'ebɨtsɨbʉ yo ʉbɨndʉka ɨthoka mo bɨtsɨbʉ bɨwe. Olʉmogo olo olunabya lʉnene kʉlenga ko lwangabere abandʉ makumi mwenda na mwenda abathʉnganene embere sa Gongo, bobathakilayire kw'ɨbɨndʉka ɨthoka mo bɨtsɨbʉ byabo.»<verse eid="LUK 15:7" /></para>
  <para style="s">Kɨtsere kya faranga kyaheraga n'ɨboneka</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8" />Yesʉ mwashʉba negena athɨ: «Mʉkatsɨ mʉgʉma amayɨra kʉ bɨtsere ikumi bya faranga,<note caller="+" style="f"><char style="fr" closed="false">15:8 </char><char style="ft" closed="false">Ko bɨro ebyo ekɨtsere kɨgʉma kya faranga kyabyaga nɨkɨrɨngene n'olʉhembo lwa mʉbɨtsɨ mʉgʉma.</char></note> kɨgʉma kya kʉbyo nɨkyahera, angakola ki? Athanganokya etara n'ɨbɨtsya enyʉmba yoshi, n'ishondya kʉbʉya ihika ko kɨka abonekyo! <verse eid="LUK 15:8" /><verse number="9" style="v" sid="LUK 15:9" />Amabonakyo, athalɨ anabɨrɨkɨra abirakatsi bʉwe n'abahimbani bʉwe n'ɨbwɨrabo athɨ: “Mʉmoge hagʉma nangye kʉshangwa ekɨtsere kyaye nyahetsyaga nyamabonakyo.” <verse eid="LUK 15:9" /><verse number="10" style="v" sid="LUK 15:10" />Enyɨbabwɨra, kuthyo ko <char style="w" lemma="Malaɨka">abamalaɨka</char> ba Gongo abanamoga bʉshana na mukoli mʉgʉma mʉsha w'ebɨtsɨbʉ yo ʉnabɨndʉka ɨthoka mo bɨtsɨbʉ bɨwe.»<verse eid="LUK 15:10" /></para>
  <para style="s">Mushinga w'omʉsole aheraga n'ɨboneka</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11" />Yesʉ mwashʉba negena athɨ: «Kwabyaga muyira mʉgʉma niawithe kʉ bagala bʉwe babɨrɨ. <verse eid="LUK 15:11" /><verse number="12" style="v" sid="LUK 15:12" />Omʉlere mwabwɨra ishe athɨ: “Thatha, nyɨhe omʉhango aye w'oko bushoki bwawe.” Aho ishe wabo mwagabɨra obushoki bʉwe bw'abagala bʉwe.<verse eid="LUK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 15:13" />«Habere hahwa bɨro bɨke omʉlere mwagʉtsya omʉhango ʉwe, mwabʉngɨra mʉ kɨhʉgo kya hale. Abere ahika eyo mwamalɨrayo obushoki bʉwe mo kiritsatsa. <verse eid="LUK 15:13" /><verse number="14" style="v" sid="LUK 15:14" />Abere amamala esofaranga sɨwe soshi, mo kɨhʉgo ekyo momwabya nzala nzɨbʉ. Mwathanga ɨbʉsha kalyo. <verse eid="LUK 15:14" /><verse number="15" style="v" sid="LUK 15:15" />Bʉshana n'ekyo mwayakolera mʉndʉ mʉgʉma w'omo kɨhʉgo ekyo. Omʉndʉ oyo mwamʉthʉma mo mashwa ʉwe ayalishye so ngʉlʉbe sɨwe. <verse eid="LUK 15:15" /><verse number="16" style="v" sid="LUK 15:16" />Omʉsole oyo agenda ashondya alye ko kalyo k'esongʉlʉbe sagenda esirya, hewethuwe mohathabya mʉndʉ w'ɨmʉha kʉko.<verse eid="LUK 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 15:17" />«Bʉshana n'ekyo, mwathanga iyinegenia athɨ: “Abakoli ba thatha balɨ mo mʉkene, h'ingye hano, enyɨfwa n'enzala! <verse eid="LUK 15:17" /><verse number="18" style="v" sid="LUK 15:18" />Nyashʉba eyɨrɨ thatha na nyamʉbwɨra nyɨthɨ: ‘Thatha, monyakola ekɨtsɨbʉ embere sa Gongo n'embere sawe. <verse eid="LUK 15:18" /><verse number="19" style="v" sid="LUK 15:19" />Nyɨthakɨtholere ʉnyahʉlemo mʉgala awe. Hano, ʉnyɨtsɨmbe nga mʉgʉma w'oko bakoli bawe!’”<verse eid="LUK 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 15:20" />«Aho omʉsole oyo mwabathʉka mwashʉba ew'ishe. Abere akɨnalɨ hale n'enyʉmba, ishe mwamʉshʉnga, amamʉfwɨra shashi kʉtsɨbʉ. Mwahuthuka iyamukokya n'ɨmʉwako. <verse eid="LUK 15:20" /><verse number="21" style="v" sid="LUK 15:21" />Mʉgala mwamʉbwɨra athɨ: “Thatha, monyakola ekɨtsɨbʉ embere sa Gongo n'embere sawe. Hano, nyɨthakɨtholere ʉnyɨganzemo mʉgala awe.” <verse eid="LUK 15:21" /><verse number="22" style="v" sid="LUK 15:22" />H'ishe mwabwɨra abagombe bʉwe athɨ: “Mʉlethe tsʉba olʉkɨmba lʉbʉya kʉtsɨbʉ mumwambikyelo. Mumwambikye n'olʉpete ko munwe, mumwambikye n'ebɨrato. <verse eid="LUK 15:22" /><verse number="23" style="v" sid="LUK 15:23" />Mʉlethe ekyana ky'ende ekinunire mʉkerekyo, thulye elinye na thʉmoge. <verse eid="LUK 15:23" /><verse number="24" style="v" sid="LUK 15:24" />Kʉshangwa mʉgala aye ono abyaga niafwire he amalubuka. Abyaga niaherire hewethuwe amaboneka.” Mobathanga irya elinye.<verse eid="LUK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25" />«Mo ndambi eyo omwana mʉkʉlʉ w'omuyira oyo niakimire. Omw'ɨfʉlʉka lɨwe, abere ahika hofɨ n'eka mwonvwa esongoma silumire n'abandʉ nɨabatsɨna. <verse eid="LUK 15:25" /><verse number="26" style="v" sid="LUK 15:26" />Mwabɨrɨkɨra mʉgʉma w'oko bakoli n'ɨmʉbʉtsya nga yamabya ki. <verse eid="LUK 15:26" /><verse number="27" style="v" sid="LUK 15:27" />Omukoli mwamʉshʉbɨtsya athɨ: “Mʉlʉmʉna awe yo wahikire. Na sho amakera ekyana ky'ende ekinunire, kʉshangwa mʉgala ʉwe amashʉbʉla nɨna mʉtsɨbʉ.”<verse eid="LUK 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28" />«Omwana mʉkʉlʉ oyo abere onvwa ebyo mwakapɨkɨra, n'ɨthɨnda ɨngɨra mo nyʉmba. Ishe ʉwe mwahʉlʉka, amaya mʉgongagonga ɨngɨre mo nyʉmba. <verse eid="LUK 15:28" /><verse number="29" style="v" sid="LUK 15:29" />He omwana mʉkʉlʉ oyo mwamʉshʉbɨtsya athɨ: “Shʉnga, bɨrɨmo bɨngɨ bɨno nɨnyɨne mʉkʉkolera, nyɨthahera nyathakʉthengʉha n'ekɨro n'ekɨgʉma. Hewethuwe ʉthahera wathamba n'ekyana ky'embene nangye nyɨkole linye n'abira baye. <verse eid="LUK 15:29" /><verse number="30" style="v" sid="LUK 15:30" />He omwana awe oyu yo wabihaya ebɨndʉ byawe mo rʉsɨngɨ amabya ashʉbʉla, wamamʉkerera ekyana ky'ende kinunire!”<verse eid="LUK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 15:31" />«Ishe mwamʉbwɨra athɨ: “Mbe mwana aye! Ɨwe othunabya nawe hano ebɨro byoshi. N'ebyoshi nyiwitheko nɨ bɨwawe. <verse eid="LUK 15:31" /><verse number="32" style="v" sid="LUK 15:32" />Hewethuwe bɨthatholere kw'ithwe irya elinye n'ɨmoga, kʉshangwa mʉlʉmʉna awe oyu abya niafwire he amalubuka. Abya niaherire he amaboneka.”»<verse eid="LUK 15:32" /></para>
  <chapter eid="LUK 15" />
  <chapter number="16" style="c" sid="LUK 16" />
  <para style="s">Omushinga w'omwimanitsi mwenge</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1" />Yesʉ mwatsɨra <char style="w">abɨga</char> bʉwe bw'omushinga athɨ: «Kwabyaga muyira mʉgʉma mushoki. Omushoki oyo niawithe mwimanitsi w'obushoki bʉwe. Abandʉ mobasitaka omwimanitsi oyo yo kʉ nyinya-kowabo nga kw'anashatha mo bushoki bʉwe. <verse eid="LUK 16:1" /><verse number="2" style="v" sid="LUK 16:2" />Aho omushoki oyo mwabɨrɨkɨra omwimanitsi oyo n'ɨmʉbwɨra athɨ: “Myatsɨ ehɨ yo enyɨkonvwako? Ɨthoka munobwire uthishubabye mwimanitsi w'obushoki bwaye. Ewo, nyɨganzɨre obushoki bwaye bo wimanire.”<verse eid="LUK 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 16:3" />«Omwimanitsi oyo, mwayɨbwɨra athɨ: “Nyinya-kowethʉ ashondya inyithokya ko mʉlɨmo. Nyayɨra nyɨthɨ? Ɨhɨnga nyithangakotsya, n'ɨhema lyanyitha shoni. <verse eid="LUK 16:3" /><verse number="4" style="v" sid="LUK 16:4" />Ega! Nyamamɨnya ko nyayɨra, nɨmo nyandabya nyathokibwa ko mʉlɨmo, abandʉ bagende abanyikokya mo manyʉmba wabo!” <verse eid="LUK 16:4" /><verse number="5" style="v" sid="LUK 16:5" />Aho mwabɨrɨkɨra bʉlɨ mʉndʉ yo wabyagako mwinda wa nyinya-kowabo. Mwabʉtsya omʉmbere athɨ: “Ʉlɨko mwinda wa sɨngahɨ wa Nyinya-kowethʉ?” <verse eid="LUK 16:5" /><verse number="6" style="v" sid="LUK 16:6" />Mwashubya athɨ: “Nyɨrɨko mwinda wa ngunguru igana sa mafʉtha.” Omwimanitsi oyo mwamʉbwɨra athɨ: “Ikala hano tsʉba, tsɨmba kababɨ ʉshake ngunguru makumi athano.”<verse eid="LUK 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 16:7" />«Honyuma kw'aho mwabʉtsya ʉndɨ athɨ: “Nawe ʉlɨko mwinda wa Nyinya-kowethʉ wa sɨngahɨ?” Mwashubya athɨ: “Nyɨrɨko mwinda wa mɨfʉko igana ya ngano.” Omwimanitsi oyo mwamʉbwɨra athɨ: “Tsɨmba kababɨ shaka mɨfʉko makumi mʉnanɨ.” <verse eid="LUK 16:7" /><verse number="8" style="v" sid="LUK 16:8" />Nyinya-kowabo mwahalamba omwimanitsi shuma oyo bʉshana n'obwenge bʉwe. Kʉshangwa abandʉ b'omo kɨhʉgo kɨno abanakola emyatsɨ yabo y'obushuma hagʉma na balikyabo kʉlenga abandʉ bo balɨ mo kyakakala.»<verse eid="LUK 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 16:9" />Aho Yesʉ mwanegena athɨ: «Nangye enyɨbabwɨra, mʉgende omʉkolesa obushoki bw'ɨthɨma bwa mʉno kɨhʉgo, mw'ɨyɨra mira. Aho obushoki bwenyu bwandabya bwahwa bandabakokya mo manyʉmba wa kera na kera.<verse eid="LUK 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 16:10" />«Omʉndʉ w'iyinihirwa mo bɨndʉ bɨke-bɨke, yo wanganabya w'iyinihirwa na mʉ bɨndʉ bɨngɨ. He oyo uthangayinihirwa mʉ bɨndʉ bɨke-bɨke yo uthanganayinihirwa na mʉ bɨndʉ bɨngɨ. <verse eid="LUK 16:10" /><verse number="11" style="v" sid="LUK 16:11" />Aho mwamabya mʉthalɨ bandʉ b'iyinihirwa mw'imanira obushoki bw'ɨthɨma bwa hano ishi, nɨ ndɨ yo wangabayɨramo bimanitsi bw'obushoki bw'ekwenene? <verse eid="LUK 16:11" /><verse number="12" style="v" sid="LUK 16:12" />Kandɨ mʉlɨ momʉthabya bandʉ b'iyinihirwa mw'imanira bushoki bwa ʉndɨ mʉndʉ, nɨ ndɨ yo wandabaha bɨndʉ bibye biwenyu?<verse eid="LUK 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13" />«Hathalɨ mukoli wangakolera bo nyinya-kowabo babɨrɨ. Kʉshangwa kwenene andabaga omʉgʉma n'ɨtsɨɨra ogʉndɨ, kʉtse kwenene andabya kʉ lʉnda lwa mʉgʉma n'ɨsʉnzʉgʉra ogʉndɨ. Muthangakotsya ɨkolera Gongo na faranga.»<verse eid="LUK 16:13" /></para>
  <para style="s">Yesʉ ashʉbɨtsya aBafarisayo</para>
  <para style="r">(<ref loc="MAT 11:12-13">Mat 11:12-13</ref>; <ref loc="MAT 5:31-32">5:31-32</ref>; <ref loc="MRK 10:11-12">Mar 10:11-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14" />Mo ndambi <char style="w" lemma="Bafarisayo:">aBafarisayo</char> bagenda abonvwa ebɨnwa byoshi ebyo, mobathanga ɨshekeretsya Yesʉ kʉshangwa babyaga nibatsiire esofaranga. <verse eid="LUK 16:14" /><verse number="15" style="v" sid="LUK 16:15" />Yesʉ mwabwɨrabo athɨ: «Imwe, omʉnagenda omuyikangya embere s'abandʉ ng'imwe bene momunabya bathʉnganene embere sabo, hewethuwe Gongo anamɨnya ebyoshi bɨrɨ mo mɨthɨma enyu. Kʉshangwa ebyo abandʉ abanaganɨtsya ko nɨ bya kɨtsɨro kɨnene, Gongo anabagabyo kʉtsɨbʉ.<verse eid="LUK 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16" />«<char style="w" lemma="Mʉgomba">oMʉgomba</char> wa Mʉsa n'aMashako <char style="w" lemma="Mʉmɨnyeretsɨ">w'abamɨnyeretsɨ</char> byo bandʉ bagenda abakwama ihika ko mʉgʉlʉ wa Yoani Mubatisya. Aho ɨthoka ko mʉgʉlʉ oyo nɨ <char style="w" lemma="Ngʉlʉ Mbʉya">eNgʉlʉ Mbʉya</char> <char style="w" lemma="Bwamɨ bwa Gongo">y'oBwamɨ bwa Gongo</char> yo yɨfʉlwa, na bʉlɨ mʉndʉ n'ɨyɨkasha kw'ɨngɨra mo Bwamɨ obo. <verse eid="LUK 16:16" /><verse number="17" style="v" sid="LUK 16:17" />Nɨ kyolo olʉbʉla n'ekɨhʉgo bɨbʉlɨrane, hewethuwe hathalɨ n'akathondi k'oko <char style="w">Mʉgomba</char> akandathokibwa kʉwo.<verse eid="LUK 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18" />«Bʉlɨ muyira yo ʉkamba mʉkatsɨwe n'ihikya ʉndɨ amɨnye kw'amasɨngɨra. N'omuyira amahikya omʉkatsɨ yo ʉthakambwa naye amɨnye kw'amasɨngɨra.»<verse eid="LUK 16:18" /></para>
  <para style="s">Omushinga w'omushoki n'omʉtsene Lasaro</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19" />Yesʉ mwatsa ʉndɨ mushinga athɨ: «Kwabyaga mʉndʉ mʉgʉma mushoki. Omushoki oyo agenda ambala ngɨmba sikwirire kandɨ sa kɨtsɨro kɨnene kʉtsɨbʉ. Abyaga mʉ mʉkene ebɨro byoshi. <verse eid="LUK 16:19" /><verse number="20" style="v" sid="LUK 16:20" />Kwabyaga na mʉtsene mʉgʉma erɨtsɨna lɨwe nɨ yo Lasaro. Lasaro oyo abyagako bɨhʉlʉ ko mʉbɨrɨ ʉwe woshi. Bagenda abamʉlambɨka ho lukyo lw'enyʉmba y'omushoki oyo. <verse eid="LUK 16:20" /><verse number="21" style="v" sid="LUK 16:21" />Agenda ashondya alye ko byo bɨthogonga ko lʉwalɨ lw'omushoki oyo. Kandɨ esombwa sagenda esihika ilyatsira ebɨhʉlʉ bɨwe.<verse eid="LUK 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22" />«Kɨro kɨgʉma Lasaro oyo mwafwa, <char style="w" lemma="Malaɨka">n'abamalaɨka</char> mobamʉthwala hofɨ na <char style="w">Abʉrahamʉ</char>. Omushoki oyo naye mwafwa mobamʉtha. <verse eid="LUK 16:22" /><verse number="23" style="v" sid="LUK 16:23" />Agenda agalwa kʉtsɨbʉ okw'ɨrʉnga. Mwashʉmba amesho na mwashʉnga <char style="w">Abʉrahamʉ</char> yo hale na mwashʉnga Lasaro nɨalɨ ho mʉsɨke kw'ɨye. <verse eid="LUK 16:23" /><verse number="24" style="v" sid="LUK 16:24" />Mwahambala athɨ: “Thatha <char style="w">Abʉrahamʉ</char>, nyɨshashɨre! Enyagalɨrwa kʉtsɨbʉ mo mʉtsanwa ono. Bʉshana n'ekyo, thʉma Lasaro atsukye omuthwemutwe w'omunwe ʉwe mo metsi, aholokye olʉlɨmɨ lwaye.”<verse eid="LUK 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25" />«He <char style="w">Abʉrahamʉ</char> mwamʉbwɨra athɨ: “Mwana aye, wɨbʉke ko wabyaga mo mʉkene mo bʉyɨngo bwawe, na Lasaro mwabona malɨgo mangɨ h'ɨye amathulera nawe ʉlɨ mo bwagali. <verse eid="LUK 16:25" /><verse number="26" style="v" sid="LUK 16:26" />Kandɨ mo kathi k'ithwe nemwe halɨ kyuna kɨre kʉtsɨbʉ. Bʉshana n'ekyo abalɨ eno bamashondya ɨya eyo mʉlɨ, bɨthangathokekana. N'abo balɨ eyo bathangakotsya ɨya eyo thʉlɨ eno.” <verse eid="LUK 16:26" /><verse number="27" style="v" sid="LUK 16:27" />Aho omushoki oyo mwanegena athɨ: “Mbe thatha enyɨkʉshaba thʉma Lasaro y'omwethʉ, <verse eid="LUK 16:27" /><verse number="28" style="v" sid="LUK 16:28" />kʉshangwa nyiwithe bagala bethʉ bathano, agende ayahanebo nɨmo bathahikaga ɨagalɨrwa hano handʉ h'amalɨgo.” <verse eid="LUK 16:28" /><verse number="29" style="v" sid="LUK 16:29" />He <char style="w">Abʉrahamʉ</char> mwashubya athɨ: “Bagala benyu bawithe amashako wa Mʉsa na <char style="w" lemma="Mʉmɨnyeretsɨ">ow'abamɨnyeretsɨ</char>. Bagende abonvwa byo amashako ayo anegenire!” <verse eid="LUK 16:29" /><verse number="30" style="v" sid="LUK 16:30" />Omushoki mwanegena athɨ: “Ɨhɨ mbe thatha <char style="w">Abʉrahamʉ</char>, ebyo bɨsha bɨthagonere, hewethuwe muholi amalubuka n'ɨya yo balɨ, bangabɨndʉka n'ɨthoka mo bɨtsɨbʉ byabo.” <verse eid="LUK 16:30" /><verse number="31" style="v" sid="LUK 16:31" />Hewethuwe Abʉrahamʉ mwamʉshʉbɨtsya athɨ: “Bagala benyu balɨ bathanga onvwa amashako wa Mʉsa na <char style="w" lemma="Mʉmɨnyeretsɨ">ow'abamɨnyeretsɨ</char> ng'oko anegenire, bathangakotsya ɨtsɨga n'omuholi yo uthalubuka.”»<verse eid="LUK 16:31" /></para>
  <chapter eid="LUK 16" />
  <chapter number="17" style="c" sid="LUK 17" />
  <para style="s">Ekɨtsɨbʉ n'obuganyiri</para>
  <para style="r">(<ref loc="MAT 18:6-7">Mat 18:6-7</ref>,<ref loc="MAT 18:21-22">21-22</ref>; <ref loc="MRK 9:42">Mar 9:42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1" />Yesʉ mwabwɨra <char style="w">abɨga</char> bʉwe athɨ: «Kʉthangabʉsha ibya byo byangaleka abandʉ nɨbakola ebɨtsɨbʉ. He bʉlɨgo kw'oyo wandaleka nibyabya. <verse eid="LUK 17:1" /><verse number="2" style="v" sid="LUK 17:2" />Omʉndʉ oyo lɨtholere kw'ɨye nɨamɨnɨrwako lushyo lʉnene mw'igosi, n'ɨgʉshwa mo ngetsɨ, kʉlenga kw'ɨreka mʉndʉ mʉgʉma w'oko bake aba akole kɨtsɨbʉ.<verse eid="LUK 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 17:3" />«Mʉgende omuyitheya! Mʉgala enyu amakola kɨtsɨbʉ mukanganie ko mwakola kɨtsɨbʉ. Amabɨndʉka n'ɨthoka mo bɨtsɨbʉ bɨwe nɨwamʉganyɨra. <verse eid="LUK 17:3" /><verse number="4" style="v" sid="LUK 17:4" />Amakʉkolera bɨtsɨbʉ ngendo sɨrɨnda ko kɨro kɨgʉma, na kandɨ amakuhikira ɨkʉshaba buganyiri ngendo sɨrɨnda, nɨwanamʉganyɨra.»<verse eid="LUK 17:4" /></para>
  <para style="s">Yesʉ akangɨrɨtsya bʉshana n'ibya n'olwɨkɨrɨtsyo</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5" />Kɨro kɨgʉma <char style="w" lemma="Bathʉmwa">abathʉmwa</char> mobabwɨra Nyinya-kowethʉ bathɨ: «Ongerera olwɨkɨrɨtsyo lwethʉ.» <verse eid="LUK 17:5" /><verse number="6" style="v" sid="LUK 17:6" />Nyinya-kowethʉ mwashʉbɨtsyabo athɨ: «Mwangabere na lwɨkɨrɨtsyo na molwangabere lʉke nga kambulu ka haratali, mwangabwire omʉthɨ oyu mʉthɨ: “Yɨkʉle ʉyayɨhere mo ngetsɨ, nawo nɨakola ebyo mʉthanegena.”»<verse eid="LUK 17:6" /></para>
  <para style="s">Omʉgombe atholere ɨkolera nyinya-kʉwabo</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7" />Yesʉ mwashʉba negena athɨ: «Mʉndʉ mʉgʉma wa kw'imwe amabya awithe mukoli ʉwe yo ʉnamʉhɨngɨra kʉtse yo unalishya obʉhange bʉwe, ko ndambi omukoli amafʉlʉka ɨthoka engero, nyinya-kowabo anganamʉbwɨra athɨ: “Hika ulye?” <verse eid="LUK 17:7" /><verse number="8" style="v" sid="LUK 17:8" />Ɨhɨ! Hewethuwe nɨamʉbwɨra athɨ: “Thanga wanyɨthekera kalyo, honyuma kw'aho uhingye esongɨmba sawe nɨmo wanyɨthekʉlɨra ihika ko kɨka nyirye n'ɨshoma, aho nawe nɨmo walya n'ɨshoma.” <verse eid="LUK 17:8" /><verse number="9" style="v" sid="LUK 17:9" />Omʉganɨtsya mʉthɨ omukoli oyo, nyinya-kowabo anganamʉsɨma kʉshangwa mwakola ebyo athamʉbwɨra? Ɨhɨ! <verse eid="LUK 17:9" /><verse number="10" style="v" sid="LUK 17:10" />Aho ko bɨrɨ bithyo kw'imwe. Mo ndambi mwamakola ebyo Gongo abashabire ɨkola, mʉgende omʉnegena mʉthɨ: “Ithwe thʉlɨ bakoli basha. Mothʉkola ebyo thuhamulirwe ɨkola.”»<verse eid="LUK 17:10" /></para>
  <para style="s">Yesʉ alamya babenzɨ ikumi</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11" />Yesʉ abere anemʉya ɨYerʉsalemʉ, mwatsʉka mo mʉhathɨ w'ekɨhʉgo ky'ɨSamarɨa na ky'iNgalilaya. <verse eid="LUK 17:11" /><verse number="12" style="v" sid="LUK 17:12" />Abere anemwɨngɨra mʉ muyi mʉgʉma, babenzɨ ikumi mobayahindana naye. Mobimana hale.<note caller="+" style="f"><char style="fr" closed="false">17:12 </char><char style="ft" closed="false">Mo Mʉgomba wa Mʉsa omʉbenzɨ athabyaga atholere ibya hofɨ n'abandʉ abathalɨ babenzɨ. </char><char style="xt" closed="false">Soma <ref loc="LEV 13:45-46">Balawi 13:45-46</ref>.</char></note> <verse eid="LUK 17:12" /><verse number="13" style="v" sid="LUK 17:13" />Mobathanga ɨhambala bathɨ: «Nyinya-kowethʉ Yesʉ, ʉthʉshashɨre!»<verse eid="LUK 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14" />Yesʉ abere ashʉngabo mwabwɨrabo athɨ: «Muyayikangye ko <char style="w" lemma="Muheri">baheri</char>.<note caller="+" style="f"><char style="fr" closed="false">17:14 </char><char style="xt" closed="false">Soma <ref loc="LEV 14:2-3">Balawi 14:2-3</ref>.</char></note>» Babere bakɨnalɨ mo nzɨra balɨ abayayo mobalama.<verse eid="LUK 17:14" /></para>
  <para style="p">
    <verse number="15-16" style="v" sid="LUK 17:15-16" />Mʉgʉma wa kʉbo abyaga <char style="w" lemma="Basamarɨa">Mʉsamarɨa</char>. <char style="w" lemma="Basamarɨa">oMʉsamarɨa</char> oyo abere ashʉnga ko amalama, mwashʉba enyuma mwagenda niasingya Gongo mʉ mʉlenge mʉnene. Mwinamya obʉsʉ bʉwe ihika ko kɨthaka embere s'ebɨshando bya Yesʉ n'ɨmʉbwɨra athɨ wamashingya. <verse eid="LUK 17:15-16" /><verse number="17" style="v" sid="LUK 17:17" />Aho Yesʉ mwanegena athɨ: «Bathalɨ babenzɨ ikumi bo nyithalamya? Abandɨ mwenda balɨ hayi? <verse eid="LUK 17:17" /><verse number="18" style="v" sid="LUK 17:18" />Hathalɨ kiro n'omʉgʉma wa kʉbo yo wamashʉbʉla bʉshana n'isingya Gongo, he yo ʉthalɨ Muyuta oyu mʉsha!» <verse eid="LUK 17:18" /><verse number="19" style="v" sid="LUK 17:19" />Aho Yesʉ mwashʉbamʉbwɨra athɨ: «Wimana ʉyɨgendere, olwɨkɨrɨtsyo lwawe lwamakulamya.»<verse eid="LUK 17:19" /></para>
  <para style="s">Erihika ly'oBwamɨ bwa Gongo</para>
  <para style="r">(<ref loc="MAT 24:23-28">Mat 24:23-28</ref>,<ref loc="MAT 24:37-41">37-41</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20" />
    <char style="w" lemma="Bafarisayo:">aBafarisayo</char> mobabʉtsya Yesʉ bathɨ: «Mʉgʉlʉ ohɨ <char style="w" lemma="Bwamɨ bwa Gongo">w'oBwamɨ bwa Gongo</char> bwandahikako?» Yesʉ mwashʉbɨtsyabo athɨ: «<char style="w" lemma="Bwamɨ bwa Gongo">oBwamɨ bwa Gongo</char> buthindahike nga bɨndʉ bilolirweko. <verse eid="LUK 17:20" /><verse number="21" style="v" sid="LUK 17:21" />Abandʉ bathɨndanegene bathɨ: “Lola, <char style="w" lemma="Bwamɨ bwa Gongo">oBwamɨ bwa Gongo</char> bʉlɨ hano,” kʉtse ɨnegena bathɨ: “Bʉlɨ halira.” Mʉmɨnye kʉbʉya ko oBwamɨ obo bwamalire ibya mo kathi kenyu.»<verse eid="LUK 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22" />Mwashʉba bwɨra <char style="w">abɨga</char> bʉwe athɨ: «Ebɨro byandahika mwandashondya ɨnyɨlolako ingye <char style="w">Mʉgala w'oMʉndʉ</char>, he mʉthɨndanyɨloleko n'ekɨro n'ekɨgʉma. <verse eid="LUK 17:22" /><verse number="23" style="v" sid="LUK 17:23" />Abandʉ bandababwɨrwa bathɨ: “Shʉnga! Alɨ hala!” kʉtse bandababwɨra bathɨ: “Shʉnga! Alɨ hano!” Muthanalinda mwayayo na mʉthakwamagabo. <verse eid="LUK 17:23" /><verse number="24" style="v" sid="LUK 17:24" />Kʉshangwa <char style="w">Mʉgala w'oMʉndʉ</char> andabya ashʉbʉla, andashʉngɨka ng'omulabyo kw'anagenda ashʉngɨka mo lʉbʉla n'ɨkoletsya mo kɨhʉgo kyoshi. <verse eid="LUK 17:24" /><verse number="25" style="v" sid="LUK 17:25" />Hewethuwe lɨtholere nɨnyathanga ɨagalwa kʉtsɨbʉ, n'ɨthɨndwa n'abandʉ b'ekɨgenyero kɨno. <verse eid="LUK 17:25" /><verse number="26" style="v" sid="LUK 17:26" />Nga ko byabyaga ko bɨro bya Noa, bithyo ko byandabya mo mʉgʉlʉ ingye <char style="w">Mʉgala w'oMʉndʉ</char> nyandabya nyashʉbʉla. <verse eid="LUK 17:26" /><verse number="27" style="v" sid="LUK 17:27" />Kʉshangya mo bɨro ebyo, abandʉ bagenda abalya n'ɨshoma, bagenda abahikya n'ihikibwa, ihika ko kɨro Noa ɨngɨraga mo bwatho. Aho ametsi mwotsula ko kɨhʉgo n'itsikya abandʉ boshi.<note caller="+" style="f"><char style="fr" closed="false">17:27 </char><char style="xt" closed="false">Soma <ref loc="GEN 6:5-22">Ndangɨro 6:5-22</ref>; <ref loc="GEN 7:1-23">7:1-23</ref>.</char></note><verse eid="LUK 17:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 17:28" />«Kuthyo ko byandabya nga ko byabyaga mo bɨro bya Loti. Abandʉ bagenda abalya n'ɨshoma, bagenda abagʉla n'ɨgʉtsya, bagenda abahera n'ihimba. <verse eid="LUK 17:28" /><verse number="29" style="v" sid="LUK 17:29" />He ekɨro Loti athokaga mo muyi w'eSotomo, Gongo mwakimitsyamo mʉtsanwa ow'abyaga nga nvʉla ya mathwa nɨathoka mo lʉbʉla. Omʉtsanwa oyo mwatsikya abandʉ boshi.<note caller="+" style="f"><char style="fr" closed="false">17:29 </char><char style="xt" closed="false">Soma <ref loc="GEN 18:20-33">Ndangɨro 18:20-33</ref>; <ref loc="GEN 19:1-25">19:1-25</ref>.</char></note> <verse eid="LUK 17:29" /><verse number="30" style="v" sid="LUK 17:30" />Bithyo ko byandabya ekɨro ingye <char style="w">Mʉgala w'oMʉndʉ</char> nyandabya nyashʉbʉla.<verse eid="LUK 17:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 17:31" />«Ko kɨro ekyo omʉndʉ yo wandabya ko luthwe lw'enyʉmba yɨwe, athakimaga athɨ ɨngɨremo bʉshana n'ɨyenda ebɨndʉ bɨwe. Na yo wandabya engero nɨathashʉbaya eka. <verse eid="LUK 17:31" /><verse number="32" style="v" sid="LUK 17:32" />Mwɨbʉke byo byahikiraga mʉka Loti.<note caller="+" style="f"><char style="fr" closed="false">17:32 </char><char style="ft" closed="false">Gongo mwabwɨra Loti na mʉkatsɨwe athɨ bashage ɨthoka mo muyi w'eSotoma, na kandɨ bathalolaga enyuma. Hewethuwe babere balɨ abashaga mʉka Loti mwakebʉka, kʉshangwa abyaga niahekerenie mo mʉthɨma gʉwe ebyo amikagayo. Gongo mwamʉsoha n'ɨmʉbɨndʉlamo ithundu lya munyu. </char><char style="xt" closed="false">Soma <ref loc="GEN 19:26">Ndangɨro 19:26</ref>.</char></note> <verse eid="LUK 17:32" /><verse number="33" style="v" sid="LUK 17:33" />Omʉndʉ yo wandashondya ɨbɨka obʉyɨngo bʉwe bo kʉbʉya andahetsyabo; hewethuwe yo wandahetsyabo andabɨkabo kʉbʉya. <verse eid="LUK 17:33" /><verse number="34" style="v" sid="LUK 17:34" />Enyɨbabwɨra, mo kɨro ekyo, abandʉ babɨrɨ bandabya nɨbagonzere kʉ ngɨngo ngʉma, mʉgʉma andahekwa n'ogʉndɨ andamikwa. <verse eid="LUK 17:34" /><verse number="35" style="v" sid="LUK 17:35" />Bakatsɨ babɨrɨ bandabya nɨabashyera hagʉma, mʉgʉma andahekwa n'ogʉndɨ andamikwa. [<verse eid="LUK 17:35" /><verse number="36" style="v" sid="LUK 17:36" />Bandʉ babɨrɨ bandabya nɨabakola mwɨshwa, mʉgʉma andahekwa n'ogʉndɨ andamikwa.<note caller="+" style="f"><char style="fr" closed="false">17:36 </char><char style="ft" closed="false">Omʉlondo ono athalɨ mʉ mashako magʉma wa kera.</char></note>»]<verse eid="LUK 17:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37" />
    <char style="w">Abɨga</char> mobabʉtsya Yesʉ bathɨ: «Nyinya-kowethʉ, ebyo byandakolekera hayi?» Mwashʉbɨtsyabo mo mushinga ono athɨ: «Ahalɨ ekinda ho amahʉngʉ anagenda ahindana.»<verse eid="LUK 17:37" /></para>
  <chapter eid="LUK 17" />
  <chapter number="18" style="c" sid="LUK 18" />
  <para style="s">Omushinga w'omusohi n'omʉshʉmbakatsɨ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1" />Yesʉ mwashʉba tsɨra <char style="w">abɨga</char> bʉwe omushinga oyu, bʉshana n'ikangyabo bagende abashaba Gongo ko bɨro byoshi bʉthalʉha. <verse eid="LUK 18:1" /><verse number="2" style="v" sid="LUK 18:2" />Mwanegena athɨ: «Mʉ muyi mʉgʉma mwabyaga musohi. Omusohi oyo abyaga niathubahire Gongo, na kandɨ niathashikitsye na bʉlɨ mʉndʉ woshi. <verse eid="LUK 18:2" /><verse number="3" style="v" sid="LUK 18:3" />Na mo muyi oyo mwabyaga mʉshʉmbakatsɨ mʉgʉma. Omʉshʉmbakatsɨ oyo agenda amuhikira n'ɨmʉbwɨra athɨ: “Nyɨtsɨre kʉbʉya olʉbanza lwaye n'enzigu aye.”<verse eid="LUK 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 18:4" />«Hewethuwe mʉ bɨro bɨngɨ, omusohi oyo mwathɨnda ɨmʉtsɨralo. Honyuma kw'aho mwayinegenia emwishi sɨwe athɨ: “Ingye nyithubahire Gongo na kandɨ nyithashikitsye bʉlɨ mʉndʉ. <verse eid="LUK 18:4" /><verse number="5" style="v" sid="LUK 18:5" />Hewethuwe omʉshʉmbakatsɨ oyu kw'amanyiluhya, nyamʉtsɨra olʉbanza lʉwe lo kʉbʉya. Nɨmo athɨgende anyihikira ko ndambi soshi ɨnyɨkendetsya.”»<verse eid="LUK 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6" />Aho Nyinya-kowethʉ mwanegena athɨ: «Mwonvwe ebyo anegena omusohi oyu yo ʉthathʉnganene. <verse eid="LUK 18:6" /><verse number="7" style="v" sid="LUK 18:7" />Na Gongo, abandʉ bw'ashombolaga bo banagenda abamʉlɨrɨra kɨro na mwɨshɨ andasohabo kʉbʉya na kandɨ athɨndathɨndɨre iwathikyabo. <verse eid="LUK 18:7" /><verse number="8" style="v" sid="LUK 18:8" />Enyɨbabwɨra kw'andatsɨrabo olʉbanza tsʉba. Hewethuwe ingye <char style="w">Mʉgala w'oMʉndʉ</char> nyandabya nyashʉbʉla nyanandeya mo kɨhʉgo mo bandʉ banyɨkɨrɨtsye?»<verse eid="LUK 18:8" /></para>
  <para style="s">Mushinga w'oMufarisayo n'omukarani w'ekoli</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9" />Kwabyaga bandʉ bo bagenda abayɨheka bathɨ ɨbo bobathʉnganene embere sa Gongo bo bagenda abasʉnzʉgʉra abandɨ. Aho Yesʉ mwatsɨrabo omushinga ono athɨ: <verse eid="LUK 18:9" /><verse number="10" style="v" sid="LUK 18:10" />«Kɨro kɨgʉma bandʉ babɨrɨ mobayashaba mo <char style="w">Nyʉmba ya Gongo</char>. Mʉgʉma abyaga <char style="w" lemma="Bafarisayo:">Mufarisayo</char> n'ogʉndɨ mukarani wa koli. <verse eid="LUK 18:10" /><verse number="11" style="v" sid="LUK 18:11" /><char style="w" lemma="Bafarisayo:">oMufarisayo</char> oyo mwimana, n'ɨshaba bʉthɨmathɨma athɨ: “Oo Gongo, enyɨkʉsɨma kʉshangwa ingye nyɨthalɨ ng'abandɨ bandʉ. Ɨbo nɨ bɨtsɨ, bathathʉnganene na nɨ bashɨngɨtsɨ. Kandɨ enyɨkʉsɨma kʉshangwa ingye nyɨthalɨ ng'omukarani w'esokoli oyu. <verse eid="LUK 18:11" /><verse number="12" style="v" sid="LUK 18:12" />Enyɨnɨngɨra mo mʉshabe wa buthalya kabɨrɨ ko yenga. Kandɨ enyɨnahana ekɨgʉma ky'ikumi ky'ebyoshi byo nyɨnabona.”<verse eid="LUK 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13" />«Omukarani w'ekoli ɨye, mwimana hale, kandɨ mwathanalinda ashʉmbɨra amesho ʉwe w'elʉbʉla. Mwabandanga ko kɨfʉba kɨwe bʉshana n'ɨhononokala nɨashaba buganyiri athɨ: “Oo Gongo, nyishashire ingye omukoli w'ebɨtsɨbʉ!”»<verse eid="LUK 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 18:14" />Aho Yesʉ mwanegena athɨ: «Enyɨbabwɨra, omukarani w'ekoli oyo mwashʉba ewe, Gongo nɨamamʉganzamo mʉthʉnganene. He <char style="w" lemma="Bafarisayo">oMufarisayo</char> oyo ɨye ɨhɨ. Kʉshangwa obʉlɨ mʉndʉ yo wandagenda ayɨheka andakimibwa, he yo wandagenda ayihohya andahamibwa.»<verse eid="LUK 18:14" /></para>
  <para style="s">Yesʉ agashanɨra abana balere</para>
  <para style="r">(<ref loc="MAT 19:13-15">Mat 19:13-15</ref>; <ref loc="MRK 10:13-16">Mar 10:13-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15" />Bandʉ bagʉma kuthyo bagenda abalethera Yesʉ yo abana balere bʉshana ahire kʉbo kw'eminwe. <char style="w">Abɨga</char> babere balola kw'ebyo, mobakemera abandʉ abo. <verse eid="LUK 18:15" /><verse number="16" style="v" sid="LUK 18:16" />Hewethuwe Yesʉ mwahamʉla bamʉlethere abana abo. Mwanegena athɨ: «Mulike abana balere bahike yo nyɨrɨ! Mʉthahangɨragabo, kʉshangwa abandʉ abalɨ ng'abo bo benye <char style="w" lemma="Bwamɨ bwa Gongo">oBwamɨ bwa Gongo</char>.<figure style="fig" alt="Jesus accueille les petits enfants" file="WA03880b.tif" size="span" ref="18:16">Yesʉ agashanɨra abana balere</figure> <verse eid="LUK 18:16" /><verse number="17" style="v" sid="LUK 18:17" />Kwenene enyɨbabwɨra nyɨthɨ, obʉlɨ mʉndʉ yo ʉthɨndɨangɨrɨre <char style="w" lemma="Bwamɨ bwa Gongo">oBwamɨ bwa Gongo</char> ng'omwana mʉlere, athɨndɨngɨre mʉbo na hake.»<verse eid="LUK 18:17" /></para>
  <para style="s">Yesʉ asɨmola n'omushoki</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mat 19:16-30</ref>; <ref loc="MRK 10:17-31">Mar 10:17-31</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18" />Mʉkʉlʉ mʉgʉma mwabʉtsya Yesʉ athɨ: «Mʉkangɨrɨtsya mʉbʉya, nyɨyɨre nyɨthɨ nɨmo nyabona obʉyɨngo bwa kera na kera?» <verse eid="LUK 18:18" /><verse number="19" style="v" sid="LUK 18:19" />Yesʉ mwamʉbʉtsya athɨ: «Bʉshana na ki ʉnyahʉlamo mʉbʉya? Hathalɨ mʉndʉ mʉbʉya athalɨ Gongo mʉsha. <verse eid="LUK 18:19" /><verse number="20" style="v" sid="LUK 18:20" />Unetsi kw'oMʉgomba wa Gongo anegenire athɨ: “Ʉthagenda ʉsɨngɨra, ʉthagenda owitha, ʉthagenda owiba, ʉthagenda ʉhambɨka mʉndʉ, ʉgende ushikya sho na nyoko.<note caller="+" style="f"><char style="fr" closed="false">18:20 </char><char style="xt" closed="false">Soma <ref loc="EXO 20:12-16">Ɨthoka 20:12-16</ref>; <ref loc="DEU 5:16-20">Ɨbʉka 5:16-20</ref>.</char></note>”» <verse eid="LUK 18:20" /><verse number="21" style="v" sid="LUK 18:21" />Omʉndʉ oyo mwashubya athɨ: «Enyɨnakola ng'oko emɨgomba yoshi eyo inegenire ɨthoka ko bwana bwaye.»<verse eid="LUK 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22" />Yesʉ abere onvwa ebyo mwamʉbwɨra athɨ: «Ukinabushire kɨndʉ kɨgʉma: ʉtsya ebyoshi uwitheko, n'esofaranga sathoka kʉbyo, gabɨratho abatsene. Wamakola uthyo nɨwayɨra bushoki mo lʉbʉla. Honyuma kw'aho hika unyikwame.»<verse eid="LUK 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 18:23" />Hewethuwe omʉndʉ oyo abere onvwa ebɨnwa ebi, mwafwa buliye bʉnene, kʉshangwa abyaga mushoki kʉtsɨbʉ.<verse eid="LUK 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 18:24" />Yesʉ abere ashʉnga ko mʉndʉ oyo ko amalire ibya n'obuliye, mwanegena athɨ: «Ega litsibuhire kʉtsɨbʉ ko bashoki ɨngɨra mo <char style="w">Bwamɨ bwa Gongo</char>! <verse eid="LUK 18:24" /><verse number="25" style="v" sid="LUK 18:25" />Lyolohire engamɨa ɨtsʉke mo kyuna ky'enandi kʉlenga ko mushoki ɨngɨra mo <char style="w">Bwamɨ bwa Gongo</char>.»<verse eid="LUK 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26" />Abandʉ bo bonvwaga ebɨnwa ebyo mobanegena bathɨ: «Aho, nɨ ndɨ yo wangashabʉlwa?» <verse eid="LUK 18:26" /><verse number="27" style="v" sid="LUK 18:27" />Yesʉ mwashubya athɨ: «Ebɨthathokekene ko bandʉ bɨthokekene kʉ Gongo.»<verse eid="LUK 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28" />Aho Petero mwanegena athɨ: «Shʉnga! Ithwe mothwamikire ebyoshi thwabyaga thʉwɨtheko n'ɨkʉkwama.» <verse eid="LUK 18:28" /><verse number="29" style="v" sid="LUK 18:29" />Yesʉ mwabwɨrabo athɨ: «Kwenene enyɨbabwɨra, omʉndʉ amamika enyʉmba yɨwe kʉtse mʉkatsɨwe, kʉtse bagala babo, kʉtse babuthi bʉwe kʉtse bana bʉwe bʉshana <char style="w" lemma="Bwamɨ bwa Gongo">n'oBwamɨ bwa Gongo</char>, <verse eid="LUK 18:29" /><verse number="30" style="v" sid="LUK 18:30" />andabona bɨndʉ bɨngɨ kʉtsɨbʉ ko mʉgʉlʉ ono. Na mo bɨro byandahika andabona bʉyɨngo bwa kera na kera.»<verse eid="LUK 18:30" /></para>
  <para style="s">Yesʉ ashʉba fʉla emyatsɨ y'olʉholo lʉwe n'erilubuka lɨwe</para>
  <para style="r">(<ref loc="MAT 20:17-19">Mat 20:17-19</ref>; <ref loc="MRK 10:32-34">Mar 10:32-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31" />Honyuma kw'aho Yesʉ mwathwala abathʉmwa bʉwe ikumi na babɨrɨ ho mʉsɨke n'ɨbwɨrabo athɨ: «Shʉnga! Othwɨrʉkɨra mo muyi w'ɨYerʉsalemʉ. Nɨ mo muyi oyo mo ebyoshi ebyo <char style="w" lemma="Mʉmɨnyeretsɨ">abamɨnyeretsɨ</char> bashakaga kʉ <char style="w">Mʉgala w'oMʉndʉ</char> byandabererera. <verse eid="LUK 18:31" /><verse number="32" style="v" sid="LUK 18:32" />Nyandahotherwa n'ihirwa mo minwe y'abandʉ, abandʉ b'ebɨhanda. Bandanyɨshekeretsya n'ɨnyɨhangya n'ɨnyɨtsɨrako mathandɨ. <verse eid="LUK 18:32" /><verse number="33" style="v" sid="LUK 18:33" />Bandanyihumba mʉ mbasha na ko nduli bandanyitha. Na mo kɨro kya kashathʉ nyandalubuka.» <verse eid="LUK 18:33" /><verse number="34" style="v" sid="LUK 18:34" />Hewethuwe abathʉmwa mobathamɨnya ebɨnwa ebi nga binegenire bɨthɨ ki. Kʉshangwa byabyaga nibibishirwe kʉbo. Aho mobathamɨnya Yesʉ ng'anegena ki.<verse eid="LUK 18:34" /></para>
  <para style="s">Yesʉ alamya mbumi</para>
  <para style="r">(<ref loc="MAT 20:29-34">Mat 20:29-34</ref>; <ref loc="MRK 10:46-52">Mar 10:46-52</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35" />Yesʉ abere ahika hofɨ n'omuyi w'iYeriko habyaga mbumi ngʉma niyikere emʉsɨke w'enzɨra nɨeyɨhema. <verse eid="LUK 18:35" /><verse number="36" style="v" sid="LUK 18:36" />Mo ndambi embumi eyo yabere y'onvwa esongindo s'abandʉ bobagenda abatsʉka, moyabʉtsya yɨthɨ: «Mbe yabere ki?» <verse eid="LUK 18:36" /><verse number="37" style="v" sid="LUK 18:37" />Abandʉ mobamʉshʉbɨtsya bathɨ: «Nɨ Yesʉ w'iNasareti yo ʉtsʉka.» <verse eid="LUK 18:37" /><verse number="38" style="v" sid="LUK 18:38" />Aho mwahambala athɨ: «Yesʉ, Mʉgala wa <char style="w">Tawiti</char>, ʉnyɨfwɨre shashi!»<verse eid="LUK 18:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39" />Abo babyaga embere mobamʉkemera bathɨ atsɨre. He mwalengya mw'ɨhambala kʉtsɨbʉ athɨ: «Mʉgala wa <char style="w">Tawiti</char>, nyɨfwɨre shashi!»<verse eid="LUK 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40" />Yesʉ mwimana n'ɨhamʉla athɨ bamʉlethere embumi eyo. Babere bamuhikya hofɨ naye, Yesʉ mwamʉbʉtsya athɨ: <verse eid="LUK 18:40" /><verse number="41" style="v" sid="LUK 18:41" />«Ushondya nyɨkʉkolere ki?» Mwashubya athɨ: «Nyinya-kowethʉ, enyishondya nyɨshʉbe lola.» <verse eid="LUK 18:41" /><verse number="42" style="v" sid="LUK 18:42" />Aho Yesʉ mwamʉbwɨra athɨ: «Shʉba lola! Olwɨkɨrɨtsyo lwawe lwamakulamya.» <verse eid="LUK 18:42" /><verse number="43" style="v" sid="LUK 18:43" />Aho n'aho, mwashʉbalola. Mwakwama Yesʉ nianemusingya Gongo. Abandʉ boshi babere bashʉnga kw'ebyo, nabo kuthyo mobasingya Gongo.<verse eid="LUK 18:43" /></para>
  <chapter eid="LUK 18" />
  <chapter number="19" style="c" sid="LUK 19" />
  <para style="s">Yesʉ ayagonzera omwa Sakayo</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1" />Yesʉ abere ɨngɨra mo muyi w'iYeriko mwakirukania mʉwo. <verse eid="LUK 19:1" /><verse number="2" style="v" sid="LUK 19:2" />Kwenzi ko muyi oyo kwabyaga muyira mʉgʉma nɨ yo Sakayo. Sakayo oyo abyaga mʉkʉlʉ wa bakarani b'ekoli. Kandɨ abyaga mushoki. <verse eid="LUK 19:2" /><verse number="3" style="v" sid="LUK 19:3" />Agenda ashondya alole Yesʉ nga nɨ ndɨ. He ng'oko abyaga mofɨ, mwathakotsya ɨmʉlolako bʉshana n'obʉngɨ bw'abandʉ. <verse eid="LUK 19:3" /><verse number="4" style="v" sid="LUK 19:4" />Bʉshana n'ekyo mwathɨbɨtha embere, n'ɨshamba kʉ mʉthɨ bʉshana ashʉnge kʉ Yesʉ, kʉshangwa aho ho Yesʉ abyaga niangatsukire. <verse eid="LUK 19:4" /><verse number="5" style="v" sid="LUK 19:5" />Mo ndambi Yesʉ abere ahika aho, mwashʉmba amesho n'ɨbwɨra Sakayo athɨ: «Sakayo, kima tsʉba kʉshangwa nyɨtholere nɨnyagonzera omwawe munobwire.»<figure style="fig" alt="Zaché monte sur l'arbre pour qu'il voie Jesus" file="WA03891b.tif" size="span" ref="19:5">Sakayo ashamba ko mʉthɨ bʉshana ashʉnge kʉ Yesʉ</figure><verse eid="LUK 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 19:6" />Sakayo mwakima tsʉba, na mwakokya Yesʉ na lʉmogo lʉnene.<verse eid="LUK 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 19:7" />Mo ndambi abandʉ boshi babere bashʉnga kw'ebyo, mobarʉkʉma bathɨ: «Ɨyaa! Amayagonzera omw'omukoli w'ebɨtsɨbʉ!»<verse eid="LUK 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8" />He Sakayo mwimana embere sa Yesʉ n'ɨnegena athɨ: «Nyinya-kowethʉ, onvwa! Nyaha kɨtse ky'ebɨndʉ byaye ky'abatsene. Nyamabya nɨmonyanyagʉla kɨndʉ kya mʉndʉ mʉ mabesɨ nyamʉshʉbʉlɨtsyakyo ngendo ine.» <verse eid="LUK 19:8" /><verse number="9" style="v" sid="LUK 19:9" />Aho Yesʉ mwamʉbwɨra athɨ: «Munobwire, Gongo amashabʉla abandʉ b'omo nyʉmba eno, kʉshangwa nawe kuthyo ʉlɨ w'omo lʉganda lwa <char style="w">Abʉrahamʉ</char>. <verse eid="LUK 19:9" /><verse number="10" style="v" sid="LUK 19:10" />Kʉshangwa ingye <char style="w">Mʉgala w'oMʉndʉ</char> nyahikaga bʉshana n'ishondya bo babyaga nibaherire n'ɨshabʉlabo.»<verse eid="LUK 19:10" /></para>
  <para style="s">Mushinga w'abakoli ikumi</para>
  <para style="r">(<ref loc="MAT 25:14-30">Mat 25:14-30</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11" />Abandʉ babyaga nɨbane mwonvwa ebɨnwa byo Yesʉ agenda anegena, kʉshangwa abyaga nɨalɨ hofɨ n'ɨYerʉsalemʉ. Aho abandʉ bagenda abaganɨtsya <char style="w" lemma="Bwamɨ bwa Gongo">ng'oBwamɨ bwa Gongo</char> bʉlɨ hofɨ n'ihika. Bʉshana n'ekyo Yesʉ mwatsɨrabo ʉndɨ mushinga athɨ: <verse eid="LUK 19:11" /><verse number="12" style="v" sid="LUK 19:12" />«Kwabyaga mʉndʉ mʉgʉma w'omo kɨhanda ky'elyamɨ abyaga niashondya ɨgenda mʉ kɨhʉgo kya hale bʉshana n'iyasingibwayo. Enyuma y'erisingibwa lɨwe angashubwire ayathegeke ekɨhʉgo kɨwe. <verse eid="LUK 19:12" /><verse number="13" style="v" sid="LUK 19:13" />Embere agende ɨyasɨnga, mwabɨrɨkɨra bandʉ ikumi mo bakoli bʉwe. Mwaha bʉlɨ mʉndʉ yo kɨtsere kɨgʉma kya faranga,<note caller="+" style="f"><char style="fr" closed="false">19:13 </char><char style="fq" closed="false">Kɨtsere kɨgʉma kya faranga: </char><char style="ft" closed="false">Ekɨtsere ekyo kyabyaga n'ɨkɨrɨngene n'olʉhembo lwa mɨbɨtsɨ igana.</char></note> mwabwɨrabo athɨ: “Mʉkole buhingania mo bɨtsere ebyo ihika ko kɨro nyandashʉbʉla.” <verse eid="LUK 19:13" /><verse number="14" style="v" sid="LUK 19:14" />Hewethuwe abandʉ b'omo kɨhʉgo kɨwe nibamubayire. Bʉshana n'ekyo, mobamʉthʉmɨra bagendi enyuma kw'ɨye bamʉbwɨre ko bathalɨ abashondya abye mwamɨ wabo. <verse eid="LUK 19:14" /><verse number="15" style="v" sid="LUK 19:15" />Hewethuwe omʉkʉlʉ oyo mwanasɨnga. Mwashʉba mo kɨhʉgo kɨwe. Abere ahika mwanegena athɨ bamʉbɨrɨkɨrɨre abakoli ikumi abo amikiraga ebɨtsere, kʉshangwa abyaga niashondya ɨmɨnya endundi yo bathabona mo buhingania bakolaga.<verse eid="LUK 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 19:16" />«Omukoli mʉmbere mwahika mwanegena athɨ: “Nyinya-kowethʉ, ekɨtsere wambaga mokyathʉndire bɨndɨ bɨtsere ikumi.” <verse eid="LUK 19:16" /><verse number="17" style="v" sid="LUK 19:17" />Nyinya-kowabo mwamʉbwɨra athɨ: “Wamakola! Ʉlɨ mukoli mʉbʉya. Kʉshangwa mowabya w'iyinihirwa kʉ bɨndʉ bɨke nyamakʉha maka w'ɨthegeka miyi ikumi.”<verse eid="LUK 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 19:18" />«Omukoli wa kabɨrɨ naye mwahika n'ɨnegena athɨ: “Nyinya-kowethʉ, ekɨtsere wambaga mokyathundire bɨndɨ bɨthano.” <verse eid="LUK 19:18" /><verse number="19" style="v" sid="LUK 19:19" />Nyinya-kowabo mwamʉbwɨra athɨ: “Nawe kuthyo nyamakʉha maka w'ɨthegeka miyi ithano.” <verse eid="LUK 19:19" /><verse number="20" style="v" sid="LUK 19:20" />Honyuma kw'aho ogʉndɨ mukoli naye mwahika n'ɨnegena athɨ: “Nyinya-kowethʉ, shʉnga! Nyamakʉlethera ekɨtsere kyo wanyɨhaga. Ekɨtsere kɨno monyabɨkakyo kʉbʉya mʉ kakɨmba. <verse eid="LUK 19:20" /><verse number="21" style="v" sid="LUK 19:21" />Monyakʉbaha kʉshangwa unabya muyira mʉtsɨbʉ. Ɨwe ʉnagenda ʉthola ekyo ʉthabɨkaga, na kandɨ ʉnagenda ʉhʉlʉla ebyo ʉthaheraga.” <verse eid="LUK 19:21" /><verse number="22" style="v" sid="LUK 19:22" />Nyinya-kowabo mwamʉbwɨra athɨ: “Ɨwe ʉlɨ mukoli mʉbɨ! Nyakʉsoha ɨkwamana n'emɨnegenere awe. Wabyaga niwetsi ko nyɨrɨ mʉtsɨbʉ, enyɨnagenda enyɨthola ebyo nyɨthathabɨka na kandɨ enyɨnahʉlʉla ebyo nyɨthaheraga. <verse eid="LUK 19:22" /><verse number="23" style="v" sid="LUK 19:23" />Aho bʉshana na ki mogʉthabɨka ekɨtsere kyaye ky'omo nyʉmba yo banagenda ababɨkamo esofaranga? Na omw'ɨshʉbʉla lyaye, nyangathokitsye ky'omo n'endundi yakyo!” <verse eid="LUK 19:23" /><verse number="24" style="v" sid="LUK 19:24" />Aho nyinya-kowabo mwabwɨra abandʉ bobabyagaho athɨ: “Omukoli oyo mʉmʉnyage ekɨtsere ekyo na mʉhekyo oyo uwithe kw'ikumi.” <verse eid="LUK 19:24" /><verse number="25" style="v" sid="LUK 19:25" />Mobamʉbwɨra bathɨ: “Nyinya-kowethʉ, oyo ahera awithe kʉ bɨtsere ikumi!” <verse eid="LUK 19:25" /><verse number="26" style="v" sid="LUK 19:26" />Nyinya-kowabo oyo mwashubya athɨ: “Nɨ kwenene enyɨbabwɨra nyɨthɨ, nɨ yo uwithe kɨndʉ yo andahabwa kɨndɨ. He oyo uthawithe kɨndʉ andanyagʉlwa n'akake awitheko. <verse eid="LUK 19:26" /><verse number="27" style="v" sid="LUK 19:27" />Hewethuwe esonzigu saye bobathashashaga nyibye mwamɨ wabo mʉlethebo hano na mʉkererebo mo mesho aye.”»<verse eid="LUK 19:27" /></para>
  <para style="s">Yesʉ ɨngɨra mo muyi w'ɨYerʉsalemʉ n'olʉkengerwa</para>
  <para style="r">(<ref loc="MAT 21:11">Mat 21:11</ref>; <ref loc="MRK 11:1-11">Mar 11:1-11</ref>; <ref loc="JHN 12:12-19">Yoa 12:12-19</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28" />Mo ndambi Yesʉ abere amamala ɨnegena ebɨnwa ebyo, mwalola ebʉshondotsɨ mo lʉgendo lʉwe lw'erɨrʉkɨra ɨYerʉsalemʉ nɨalɨ embere s'omuhindano. <verse eid="LUK 19:28" /><verse number="29" style="v" sid="LUK 19:29" />Mwahika hofɨ n'omuyi w'ɨBetefake na w'ɨBetanɨa, ko mʉnda w'ekɨthwa ky'eMiseituni. Mwathʉma babɨrɨ b'oko <char style="w" lemma="Abɨga">bɨga</char> bʉwe n'ɨbwɨrabo athɨ: <verse eid="LUK 19:29" /><verse number="30" style="v" sid="LUK 19:30" />«Mʉgende mo muyi owalɨ embere senyu. Mwabya mwahika mʉwo, mweyamo kyana kya pʉnda kihangire ekyo kɨthahera kyathikalwako na mʉndʉ. Mʉhangʉlekyo na mʉlethekyo. <verse eid="LUK 19:30" /><verse number="31" style="v" sid="LUK 19:31" />Na mʉndʉ amababʉtsya athɨ bʉshana na ki omʉhangʉlakyo, nɨmwamʉshʉbɨtsya mʉthɨ Nyinya-kowenyu alayire kʉkyo.»<verse eid="LUK 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32" />
    <char style="w">Abɨga</char> bobathʉmawa mobagenda. Mobeya emyatsɨ nɨyɨnalɨ ng'oko Yesʉ athabwɨrabo. <verse eid="LUK 19:32" /><verse number="33" style="v" sid="LUK 19:33" />Babere banemʉhangʉla ekyana ky'epʉnda ekyo, abenyekyo mobabʉtsyabo bathɨ: «Imwe! Bʉshana na ki omʉhangʉla ekyana ky'epʉnda ekyo?» <verse eid="LUK 19:33" /><verse number="34" style="v" sid="LUK 19:34" />Mobashʉbɨtsyabo bathɨ: «Nyinya-kowethʉ alayire kʉkyo.»<verse eid="LUK 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 19:35" />Honyuma kw'aho mobalethera Yesʉ y'ekyana ky'epʉnda ekyo. Mobashesha kʉkyo kw'esongɨmba sabo, aho mobashambya Yesʉ yo kʉkyo. <verse eid="LUK 19:35" /><verse number="36" style="v" sid="LUK 19:36" />Babere banemʉgenda, abandʉ mobagenda abashesha esongɨmba sabo mo nzɨra.<note caller="+" style="f"><char style="fr" closed="false">19:36 </char><char style="ft" closed="false">aBayuta bagenda abakokya abakʉlʉ mw'ɨshesha esongɨmba sabo mo nzɨra. Bagendaga abakola bathyo bʉshana n'imukangania ko bamamukokya n'olushikyo.</char></note> <verse eid="LUK 19:36" /><verse number="37" style="v" sid="LUK 19:37" />Yesʉ abere ahika hofɨ n'ɨYerʉsalemʉ, mo bwandagala bw'ekɨthwa ky'eMiseituni, omuhindano woshi w'<char style="w">abɨga</char> bʉwe mwamoga kʉtsɨbʉ. Mobahalamba Gongo nɨabahambala kʉtsɨbʉ bʉshana n'ebɨthɨko-thɨko byoshi bathashʉngako. <verse eid="LUK 19:37" /><verse number="38" style="v" sid="LUK 19:38" />Mobagenda nɨabanegena bathɨ:</para>
  <para style="q1" vid="LUK 19:38">«Agashanɨrwe oMwamɨ yo uhika kw'ɨtsɨna lya Nyinya-kowethʉ!</para>
  <para style="q1" vid="LUK 19:38">Obʉholo bubye elʉgʉlʉ kʉtsɨbʉ,</para>
  <para style="q1" vid="LUK 19:38">na Gongo asingibwe!<note caller="+" style="f"><char style="fr" closed="false">19:38 </char><char style="xt" closed="false">Soma <ref loc="PSA 118:26">Saburi 118:26</ref>.</char></note>»<verse eid="LUK 19:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39" />
    <char style="w" lemma="Bafarisayo:">Bafarisayo</char> bagʉma bo babyaga mo muhindano w'abandʉ mobabwɨra Yesʉ bathɨ: «Mʉkangɨrɨtsya, kemera <char style="w">abɨga</char> bawe batsɨre.» <verse eid="LUK 19:39" /><verse number="40" style="v" sid="LUK 19:40" />Yesʉ mwabwɨrabo athɨ: «Enyɨbabwɨra aba bamahʉlɨkɨrɨra, nɨ amabwe nɨ ɨwo ahambala!»<verse eid="LUK 19:40" /></para>
  <para style="s">Yesʉ alɨrɨra omuyi w'ɨYerʉsalemʉ</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41" />Yesʉ abere ahika hofɨ n'omuyi w'ɨYerʉsalemʉ na abere ashʉnga kʉwo, mwalɨrɨrawo. <verse eid="LUK 19:41" /><verse number="42" style="v" sid="LUK 19:42" />Mwanegena athɨ: «Munobwire wangaminyire ekyangakʉlethere obʉholo! He ekyo kibishirwe kw'ɨwe munobwire ʉthangakotsya ɨshʉngakyo. <verse eid="LUK 19:42" /><verse number="43" style="v" sid="LUK 19:43" />Kʉshangwa ebɨro byandahika, aho esonzigu sawe sandakuthimbako bʉshana n'ɨkʉlwɨsa. Sandabya sahimba oluhimbo lw'ɨyɨkakɨra hofɨ nawe sandakʉyɨndɨrɨtsya ko mbande soshi. <verse eid="LUK 19:43" /><verse number="44" style="v" sid="LUK 19:44" />Sandakʉshambʉla ɨwe hagʉma n'abandʉ bawe. Sithindakumikire n'ibwe kʉ lɨndɨ mw'ɨwe, kʉshangwa moʉthamɨnya endambi Gongo ahikaga ɨkʉshabʉla.»<verse eid="LUK 19:44" /></para>
  <para style="s">Yesʉ aligitha abandʉ mo mbʉga y'eNyʉmba ya Gongo</para>
  <para style="r">(<ref loc="MAT 21:12-17">Mat 21:12-17</ref>; <ref loc="MRK 11:15-19">Mar 11:15-19</ref>; <ref loc="JHN 2:13-22">Yoa 2:13-22</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45" />Yesʉ mwɨngɨra mo mbʉga <char style="w" lemma="Nyʉmba ya Gongo">y'eNyʉmba ya Gongo</char>, abere ahikamo mwathanga iligitha bo bagenda abahingania. <verse eid="LUK 19:45" /><verse number="46" style="v" sid="LUK 19:46" />Mwabwɨrabo athɨ: «Bishakirwe mo Mashako Abuyirire bɨthɨ: “Enyʉmba aye yandabya nyʉmba y'ɨnyɨshabɨramo.” He imwe mwayiriremo kabishamo k'abashamuli!<note caller="+" style="f"><char style="fr" closed="false">19:46 </char><char style="xt" closed="false">Soma <ref loc="ISA 56:7">Isaya 56:7</ref>; <ref loc="JER 7:11">Yeremia 7:11</ref>.</char></note>»<verse eid="LUK 19:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47" />Ko bʉlɨ kɨro Yesʉ agenda akangɨrɨtsya abandʉ mo <char style="w">Nyʉmba ya Gongo</char>. <char style="w" lemma="Muheri">Abakʉlʉ b'abaheri</char> <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">n'abakangɨrɨtsya b'oMʉgomba</char> n'abakʉlʉ b'abandʉ, bagenda abashondya imwitha. <verse eid="LUK 19:47" /><verse number="48" style="v" sid="LUK 19:48" />Hewethuwe mobabʉsha omwanya w'erimwitha, kʉshangwa abandʉ boshi bagendaga abamʉhʉlɨkɨrɨtsya kʉtsɨbʉ.<verse eid="LUK 19:48" /></para>
  <chapter eid="LUK 19" />
  <chapter number="20" style="c" sid="LUK 20" />
  <para style="s">Amaka wa Yesʉ athoka hayi?</para>
  <para style="r">(<ref loc="MAT 21:23-27">Mat 21:23-27</ref>; <ref loc="MRK 11:27-33">Mar 11:27-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1" />Kɨro kɨgʉma Yesʉ abyaga mo <char style="w">Nyʉmba ya Gongo</char>, agenda akangɨrɨtsya abandʉ, n'ɨfʉlɨrabo <char style="w" lemma="Ngʉlʉ Mbʉya">eNgʉlʉ Mbʉya</char>. <char style="w" lemma="Muheri">Abakʉlʉ b'abaheri</char> <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">n'abakangɨrɨtsya b'oMʉgomba</char> hagʉma n'abakʉlʉ b'aBayuta, mobafʉmba. <verse eid="LUK 20:1" /><verse number="2" style="v" sid="LUK 20:2" />Mobamʉbʉtsya bathɨ: «Thʉbwɨre nga oʉnagenda ʉkola ebɨndʉ byoshi ebi byo kʉ hamuli ki, na ndɨ yo wakʉhaga amaka w'ɨkola ebyo?» <verse eid="LUK 20:2" /><verse number="3" style="v" sid="LUK 20:3" />Yesʉ mwashʉbɨtsyabo athɨ: «Nangye kuthyo nyababʉtsya kɨnwa kɨgʉma. Mʉnyɨbwɨre: <verse eid="LUK 20:3" /><verse number="4" style="v" sid="LUK 20:4" />Hayi ho Yoani athokaya amaka w'ɨgenda <char style="w" lemma="Lubatiso">abatisya</char> abandʉ? Ewa Gongo kʉtse kʉ bandʉ?»<verse eid="LUK 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5" />Mobathanga ibutsania bathɨ: «Thwamamʉshʉbɨtsya thʉthɨ amaka ʉwe athokaga ewa Gongo, athʉbʉtsya athɨ: “Bʉshana na ki momʉthɨkɨrɨtsya Yoani oyo?” <verse eid="LUK 20:5" /><verse number="6" style="v" sid="LUK 20:6" />Kandɨ thwamamʉshʉbɨtsya thʉthɨ nɨ kʉ bandʉ, abandʉ boshi balɨ hano bathʉgʉshangako mabwe, kʉshangwa betsi kʉbʉya ko Yoani abyaga <char style="w" lemma="Mʉmɨnyeretsɨ">mʉmɨnyeretsɨ</char>.» <verse eid="LUK 20:6" /><verse number="7" style="v" sid="LUK 20:7" />Aho, mobamʉshʉbɨtsya bathɨ: «Thuthetsi aho amaka wa Yoani athokaga.» <verse eid="LUK 20:7" /><verse number="8" style="v" sid="LUK 20:8" />Yesʉ naye mwashʉbɨtsyabo athɨ: «Nangye kuthyo nyɨthɨbabwɨre nga enyɨkola ebɨndʉ ebi byo kʉ maka wa ndɨ.»<verse eid="LUK 20:8" /></para>
  <para style="s">Mushinga w'abahingi babɨ</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mat 21:33-46</ref>; <ref loc="MRK 12:1-12">Mar 12:1-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9" />Honyuma kw'aho, Yesʉ mwatsɨra abandʉ omushinga ono athɨ: «Kwabyaga mʉndʉ mʉgʉma yo waheraga <char style="w" lemma="Musabibu">ɨshwa lɨwe lya misabibu</char>. Omʉndʉ oyo mwakondesalyo bahingi bagʉma. Honyuma kw'aho mwagenda lʉgendo lwa bɨro bɨngɨ. <verse eid="LUK 20:9" /><verse number="10" style="v" sid="LUK 20:10" />Ebɨro by'erɨhʉlʉla byabere byahika, mwathʉma mukoli ʉwe mʉgʉma ko bahingi kʉshangwa bamʉhe engemo yɨwe. Hewethuwe abahingi abo mobahumba omukoli oyo n'ɨmʉshʉbʉtsya minwe mɨsha. <verse eid="LUK 20:10" /><verse number="11" style="v" sid="LUK 20:11" />Omwenye <char style="w" lemma="Musabibu">erɨshwa ly'emisabibu</char> mwashʉba thʉmɨrabo ʉndɨ mukoli, oyo naye mobamuhumba, mobamuhangya n'ɨmʉshʉbʉtsya minwe mɨsha. <verse eid="LUK 20:11" /><verse number="12" style="v" sid="LUK 20:12" />Mwashʉba thʉma mukoli wa kashathʉ. Oyo naye, mobamʉbabatsya n'ɨmʉgʉsha emʉsɨke w'erɨshwa. <verse eid="LUK 20:12" /><verse number="13" style="v" sid="LUK 20:13" />Aho omwenye erɨshwa mwayɨbʉtsya athɨ: “Nyɨyɨre nyɨthɨ? Nyathʉma mʉgala aye mʉtsɨɨrwa, oyo ɨye kʉthɨ bamushikya.” <verse eid="LUK 20:13" /><verse number="14" style="v" sid="LUK 20:14" />Hewethuwe abahingi babere bashʉnga mʉgala ʉwe, mobabwɨrana ɨbo kw'ɨbo bathɨ: “Oyu yo mʉlɨ w'omwandʉ. Thumwithe nɨmo thwandashiba nalyo.” <verse eid="LUK 20:14" /><verse number="15" style="v" sid="LUK 20:15" />Aho mobamʉkʉrɨra emʉsɨke w'erɨshwa n'imwitha.»</para>
  <para style="p" vid="LUK 20:15">Yesʉ mwabʉtsya abandʉ athɨ: «Aho abahingi abo omwenye erɨshwa andayɨrabo athɨ? <verse eid="LUK 20:15" /><verse number="16" style="v" sid="LUK 20:16" />Andahika n'ithisabo, na andaha erɨshwa eryo lyo bandɨ bahingi.» Abandʉ babere bonvwa ebɨnwa ebyo, mobanegena bathɨ: «Ebɨndʉ ebɨrɨ ng'ebi bithanalinda byathuhikira!»<verse eid="LUK 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17" />He Yesʉ mwahanda kʉbo kw'amesho n'ɨnegena athɨ: «aMashako Abuyirire ano anegenire athɨ ki?</para>
  <para style="q1" vid="LUK 20:17">“Eribwe lya thɨndawa n'abahimbi,</para>
  <para style="q1" vid="LUK 20:17">nɨ lyo lyo lyabere ibwe ly'ekoni.<note caller="+" style="f"><char style="fr" closed="false">20:17 </char><char style="xt" closed="false">Soma <ref loc="PSA 118:22">Saburi 118:22</ref>.</char></note>”<verse eid="LUK 20:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="LUK 20:18" />Bʉlɨ mʉndʉ yo wandayihinda kw'ibwe eryo andakonongoka, n'oyo lyandathogerako, lyandamuthundula.»<verse eid="LUK 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19" />Kona kathambi ako <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">abakangɨrɨtsya b'oMʉgomba</char> <char style="w" lemma="Muheri">n'abakʉlʉ b'abaheri</char> babere bonvwa ebyo, mobamɨnya ko Yesʉ mwatsa omushinga oyu bʉshana nabo. Bʉshana n'ekyo mobashondya ɨmʉmɨna, he mobʉbaha abandʉ.<verse eid="LUK 20:19" /></para>
  <para style="s">Ɨrɨha Ekoli ya Kaisari</para>
  <para style="r">(<ref loc="MAT 22:15-22">Mat 22:15-22</ref>; <ref loc="MRK 12:13-17">Mar 12:13-17</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 20:20" />Abakangɨrɨtsya b'oMʉgomba n'abakʉlʉ b'abaheri abo, mobathanga ɨgenda abalɨnga Yesʉ. Aho, mobamʉthʉmɨra bandʉ bo bayɨyɨragamo bandʉ bathʉnganene. Mobakola ebyo bʉshana n'ɨmʉtsɨmba mo bɨnwa bɨwe n'imuhira mo minwe y'abakʉlʉ b'ekɨhʉgo. <verse eid="LUK 20:20" /><verse number="21" style="v" sid="LUK 20:21" />Abandʉ abo mobamʉbʉtsya bathɨ: «Mʉkangɨrɨtsya, thwetsi ko ʉnagenda ʉnegena n'ɨkangɨrɨtsya ebɨthʉnganene. Kandɨ ʉthalɨ ʉnatsomana bʉkʉlʉ bwa mʉndʉ, hewethuwe ʉnagenda ʉkangɨrɨtsya abandʉ bw'enzɨra y'ekwenene yo Gongo anamogera. <verse eid="LUK 20:21" /><verse number="22" style="v" sid="LUK 20:22" />Ewono thathʉbwɨra! oMʉgomba ethʉ anahamulire ɨrɨha Ekoli ya <char style="w">Kaisari</char> kʉtse ɨhɨ?»<verse eid="LUK 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23" />Hewethuwe Yesʉ mwamɨnya ko abashondya ɨmʉthega kɨnwa. Aho mwabwɨrabo athɨ: <verse eid="LUK 20:23" /><verse number="24" style="v" sid="LUK 20:24" />«Munyikangye kɨtsere kɨgʉma kya faranga.» Aho mwabʉtsyabo athɨ: «Eshoshani n'erɨtsɨna byo bɨrɨ ko kɨtsere kɨno nɨ bya ndɨ?» Mobashʉbya bathɨ: «Nɨ bya <char style="w">Kaisari</char>.» <verse eid="LUK 20:24" /><verse number="25" style="v" sid="LUK 20:25" />Aho Yesʉ mwabwɨrabo athɨ: «Mʉgende omʉha <char style="w">Kaisari</char> y'ebɨwe na Gongo y'ebɨwe.» <verse eid="LUK 20:25" /><verse number="26" style="v" sid="LUK 20:26" />Abandʉ abo mobathabona kɨnwa kyo bangamʉthega embere s'abandʉ. He mobashweka kʉtsɨbʉ kw'ishubya lɨwe, mo bayɨhʉlɨkɨrɨtsya.<verse eid="LUK 20:26" /></para>
  <para style="s">Omwatsɨ w'erilubuka ly'abaholi</para>
  <para style="r">(<ref loc="MAT 22:23-33">Mat 22:23-33</ref>; <ref loc="MRK 12:18-27">Mar 12:18-27</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27" />Kɨro kɨgʉma <char style="w">Basandukayo</char> bagʉma mobahikira Yesʉ. Nɨ <char style="w" lemma="Basandukayo">aBasandukayo</char> bo banagenda abanegena bathɨ abaholi bathindalubuke. <char style="w" lemma="Basandukayo">aBasandukayo</char> bo bahikiraga Yesʉ abo, mobamʉbʉtsya bathɨ: <verse eid="LUK 20:27" /><verse number="28" style="v" sid="LUK 20:28" />«Mʉkangɨrɨtsya, Mʉsa mwathʉthegeka athɨ omuyira amafwa bʉthabʉtha, mʉgala wabo n'ɨngɨrɨra omʉshʉmbakatsɨ yo uthashiba bʉshana abʉthɨre walɨ mʉgala abo yo bana.<note caller="+" style="f"><char style="fr" closed="false">20:28 </char><char style="xt" closed="false">Soma <ref loc="GEN 38:8">Ndangɨro 38:8</ref>; <ref loc="DEU 25:5-6">Ɨbʉka 25:5-6</ref>.</char></note> <verse eid="LUK 20:28" /><verse number="29" style="v" sid="LUK 20:29" />Aho, kwabyaga basole balɨnda ba mʉ nda ngʉma. Kambere mwahikya he mwafwa bʉthabʉtha. <verse eid="LUK 20:29" /><verse number="30" style="v" sid="LUK 20:30" />Owa kabɨrɨ mw'ɨngɨrɨra omʉshʉmbakatsɨ, he naye mwafwa bʉtha mʉbʉthako. <verse eid="LUK 20:30" /><verse number="31" style="v" sid="LUK 20:31" />Honyuma kw'aho mobyabya bithyo ko wa kashathʉ, na kuthyo ko balɨnda boshi. Mobafwa bʉthabʉtha kiro na mwana. <verse eid="LUK 20:31" /><verse number="32" style="v" sid="LUK 20:32" />Ko nduli, omʉshʉmbakatsɨ naye mwafwa. <verse eid="LUK 20:32" /><verse number="33" style="v" sid="LUK 20:33" />Ewono, ekɨro abaholi bandalubuka, omʉshʉmbakatsɨ oyo andabya mʉka ndɨ? Kʉshangwa abalɨnda boshi mobamuhikya.»<verse eid="LUK 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34" />Yesʉ mwashʉbɨtsyabo athɨ: «Abandʉ b'omo kɨhʉgo kɨno abanahikya n'ihikibwa. <verse eid="LUK 20:34" /><verse number="35" style="v" sid="LUK 20:35" />Hewethuwe abandʉ bo Gongo andashʉnga ko batholere ilubuka bʉshana bɨngɨre mo Bwamɨ bo buhika, bathɨndahikye kʉtse ihikibwa. <verse eid="LUK 20:35" /><verse number="36" style="v" sid="LUK 20:36" />Bathɨndashʉbafwe, bandalɨngana n'abamalaɨka. Nɨ abo bo bana ba Gongo, kʉshangwa mwalubukyabo. <verse eid="LUK 20:36" /><verse number="37" style="v" sid="LUK 20:37" />Mʉsa mwakangania kʉbʉya-kʉbʉya ko abaholi bandalubuka. Ebɨnwa ebyo anegena kʉbyo aho ashakire bʉshana n'ekɨkala kyo kyagenda ekɨgʉlʉmɨra. Aho ahʉla Nyinya-kowethʉ athɨ: “Gongo wa <char style="w">Abʉrahamʉ</char>, yo Gongo wa Isaka na yo Gongo wa Yakobo.<note caller="+" style="f"><char style="fr" closed="false">20:37 </char><char style="xt" closed="false">Soma <ref loc="EXO 3:2-6">Ɨthoka 3:2-6</ref>.</char></note>”» <verse eid="LUK 20:37" /><verse number="38" style="v" sid="LUK 20:38" />Yesʉ mwashʉba negena athɨ: «Gongo nɨ Gongo w'abalɨho he athalɨ w'abaholi, kʉshangwa aboshi balɨho kw'ɨye.»<verse eid="LUK 20:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39" />Aho bagʉma b'omo <char style="w">bakangɨrɨtsya b'oMʉgomba</char> mobanegena bathɨ: «Mʉkangɨrɨtsya, moʉnegena kʉbʉya.» <verse eid="LUK 20:39" /><verse number="40" style="v" sid="LUK 20:40" />Mobathanalinda bashʉbabʉtsya Yesʉ yo kɨndɨ kɨndʉ.<verse eid="LUK 20:40" /></para>
  <para style="s">Kirisito n'omwamɨ Tawiti</para>
  <para style="r">(<ref loc="MAT 22:41-46">Mat 22:41-46</ref>; <ref loc="MRK 12:35-37">Mar 12:35-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41" />Yesʉ mwabʉtsya abandʉ athɨ: «Bʉshana na ki abandʉ banganegena bathɨ <char style="w" lemma="Kirisito, Masia">Kirisito</char> nɨ mʉgala w'omwamɨ <char style="w">Tawiti</char>? <verse eid="LUK 20:41" /><verse number="42" style="v" sid="LUK 20:42" />Ndɨ mwamɨ <char style="w">Tawiti</char> yowene-wene yo ʉnegena mo kɨtabo ky'eSaburi athɨ:</para>
  <para style="q1" vid="LUK 20:42">“Nyinya-kowethʉ Gongo mwabwɨra Nyinya-kowethʉ athɨ:</para>
  <para style="q1" vid="LUK 20:42">‘Wikala ko malyo aye,<verse eid="LUK 20:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="LUK 20:43" />ihika ko kɨro nyandayɨra so nzigu sawe</para>
  <para style="q1" vid="LUK 20:43">mo kɨndʉ kyawe k'iryathirako.<note caller="+" style="f"><char style="fr" closed="false">20:43 </char><char style="xt" closed="false">Soma <ref loc="PSA 110:1">Saburi 110:1</ref>.</char></note>’”<verse eid="LUK 20:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="LUK 20:44" />Aho omwamɨ <char style="w">Tawiti</char> amahʉla Kirisito mo Nyinya-kowabo, Kirisito oyo angashʉbabya athɨ mʉgala w'omwamɨ <char style="w">Tawiti</char>?»<verse eid="LUK 20:44" /></para>
  <para style="s">Iyitheya ko bakangɨrɨtsya b'oMʉgomba</para>
  <para style="r">(<ref loc="MAT 23:1-36">Mat 23:1-36</ref>; <ref loc="MRK 12:38-40">Mar 12:38-40</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45" />Mo mʉgʉlʉ abandʉ boshi babyaga nɨbakɨnalɨ abahʉlɨkɨrɨtsya Yesʉ, mwabwɨra <char style="w">abɨga</char> bʉwe athɨ: <verse eid="LUK 20:45" /><verse number="46" style="v" sid="LUK 20:46" />«Mʉthagenda omʉyɨtsɨmba <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">ng'abakangɨrɨtsya b'oMʉgomba</char>. Bo banagenda abayɨgendya-gendya nibambithe soropo nyɨre-nyɨre. Kandɨ abanatsɨɨra abandʉ bagende abaketsyabo mw'ishikibwa mo mihindano. Na kandɨ abanagenda abatsɨɨra ikala ko bifumbi by'embere mo <char style="w" lemma="Sinakoki:">sosinakoki</char> na mo solinye. <verse eid="LUK 20:46" /><verse number="47" style="v" sid="LUK 20:47" />Abananyaga abashʉmbakatsɨ bw'ebyo bawitheko, kandɨ abanagenda abashaba mɨshabe mɨre bʉshana bayikanganie embere s'abandʉ. Abandʉ abo, Gongo andasohabo kʉtsɨbʉ kʉlenga abandɨ.»<verse eid="LUK 20:47" /></para>
  <chapter eid="LUK 20" />
  <chapter number="21" style="c" sid="LUK 21" />
  <para style="s">Bɨhembo by'omʉshʉmbatsɨ mʉtsene</para>
  <para style="r">(<ref loc="MRK 12:41-44">Mar 12:41-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1" />Kɨro kɨgʉma Yesʉ abyaga mo <char style="w">Nyʉmba ya Gongo</char>. Abere athimbya amesho ko bandʉ mwashʉnga nga ko abashoki bagenda abahira <char style="w" lemma="Bɨhembo">ebɨhembo</char> by'omo kibo. <verse eid="LUK 21:1" /><verse number="2" style="v" sid="LUK 21:2" />Mwashʉnga kuthyo mʉshʉmbakatsɨ mʉgʉma mʉtsene naye mwahira hɨtsere hɨbɨrɨ hya faranga mo kibo ekyo. <verse eid="LUK 21:2" /><verse number="3" style="v" sid="LUK 21:3" />Aho Yesʉ mwanegena athɨ: «Kwenene enyɨbabwɨra, omʉshʉmbakatsɨ mʉtsene oyu, yo wamahana bɨhembo bɨngɨ kʉlenga abandɨ bandʉ boshi. <verse eid="LUK 21:3" /><verse number="4" style="v" sid="LUK 21:4" />Kʉshangwa abandɨ boshi, <char style="w" lemma="Bɨhembo">ebɨhembo</char> bya faranga bathahana nɨ so sɨthashaka ko bushoki bwabo. He omʉshʉmbakatsɨ oyu ɨye mo bʉtsene bʉwe amahana ebyoshi athawitheko byo byangalekire niabyaho.»<verse eid="LUK 21:4" /></para>
  <para style="s">Mwatsɨ w'ihimbulwa ly'eNyʉmba ya Gongo</para>
  <para style="r">(<ref loc="MAT 24:1-2">Mat 24:1-2</ref>; <ref loc="MRK 13:1-2">Mar 13:1-2</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5" />Bandʉ bagʉma bagenda abasɨmola ko myatsɨ <char style="w" lemma="Nyʉmba ya Gongo">y'eNyʉmba ya Gongo</char>. Bagenda abanegena bathɨ <char style="w" lemma="Nyʉmba ya Gongo">eNyʉmba ya Gongo</char> eyi yihimbire kʉbʉya, mʉ mabwe akwirire, n'omo bɨndɨ bɨndʉ bikwirire ebyo abandʉ bahaga Gongo. He Yesʉ mwanegena athɨ:<figure style="fig" alt="Le Temple de Jerusalem" file="lb00250b.tif" size="span" ref="21:5">eNyʉmba ya Gongo y'ɨYerʉsalemʉ</figure> <verse eid="LUK 21:5" /><verse number="6" style="v" sid="LUK 21:6" />«Ebyo mushungireko ebi, ebɨro byandahika eribwe lithindashibe elʉgʉlʉ w'erɨndɨ. Ebyoshi byandashambʉlwa.»<verse eid="LUK 21:6" /></para>
  <para style="s">Ebyo byandahika embere y'ebɨro by'enduli</para>
  <para style="r">(<ref loc="MAT 24:3-14">Mat 24:3-14</ref>; <ref loc="MRK 13:3-13">Mar 13:3-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7" />Aho abandʉ mobamʉbʉtsya bathɨ: «Mʉkangɨrɨtsya, emyatsɨ eyi yandahika kɨro ki? Na kɨhe kyo kɨmɨnyɨkalo kyandathukangania ko yahera hofɨ n'ɨbererera?»<verse eid="LUK 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8" />Yesʉ mwashʉbɨtsyabo athɨ: «Muyitheye mʉthathɨmawa. Kʉshangwa bandʉ bangɨ bandahika mw'ɨtsɨna lyaye. Bandagenda abanegena bathɨ n'ɨbo bo Kirisito. Kandɨ bandanegena bathɨ endambi eyo yamalire ihika! He abandʉ abo mʉthakwamagabo. <verse eid="LUK 21:8" /><verse number="9" style="v" sid="LUK 21:9" />Mwandabya mwonvwa abandʉ balɨ abanegena ko myatsɨ y'ebita n'oko hwehweri y'obʉrʉnga, mʉthagenda omʉbaha. Kʉshangya lɨtholere ebyo nɨbyathanga ihika, hewethuwe bɨthalɨ ebikangania kw'enduli y'ekɨhʉgo yahika ko bɨro ebyo.»<verse eid="LUK 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10" />Honyuma kw'aho Yesʉ mwashʉba bwɨrabo athɨ: «Ekɨhanda kyandalwa n'ekɨndɨ, n'obwamɨ bwandalwa n'obʉndɨ. <verse eid="LUK 21:10" /><verse number="11" style="v" sid="LUK 21:11" />Kwandatsʉka thulingiti thʉtsɨbʉ. Kwandabya nzala nzɨbʉ na makoni handʉ hangɨ hangɨ. N'omo lʉbʉla mwandabya bɨmɨnyɨkalo b'ishwekya, byo byandubahya abandʉ bo kʉtsɨbʉ.<verse eid="LUK 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 21:12" />«Hewethuwe embere ebyoshi ebi bihike, bandabatsɨmba n'ibanubya. Bandabathwala mo so <char style="w" lemma="Sinakoki:">sinakoki</char> bʉshana n'ɨyabʉrana n'ɨbagʉsha mo muliki. Kandɨ bandagenda ababaletha embere s'abamɨ n'abakʉlʉ b'ekɨhʉgo bʉshana nangye. <verse eid="LUK 21:12" /><verse number="13" style="v" sid="LUK 21:13" />Ekyo kyandaleka nɨmwaletha obutimo bwenyu. <verse eid="LUK 21:13" /><verse number="14" style="v" sid="LUK 21:14" />He bɨno byo mʉtholere nɨmwamɨnya: Mʉthagenda omʉthanga igangya-gangya emɨthɨma enyu nga mwandayɨlwako mʉthɨ. <verse eid="LUK 21:14" /><verse number="15" style="v" sid="LUK 21:15" />Kʉshangwa nɨ ingyowene ngyo nyandabaha ebɨnwa by'obuthegekania byo mwandanegena, ihika ko kɨka so nzigu senyu soshi sithindakotsye ikubisania nemwe kʉtse ɨthɨnda ebyo mʉthanegena. <verse eid="LUK 21:15" /><verse number="16" style="v" sid="LUK 21:16" />Na kuthyo bo sho na bo nyoko, na bagala benyu, n'ababuthi benyu, n'abira benyu, nabo kuthyo bandabahothera ko bakʉlʉkʉlʉ. Bagʉma mw'imwe bandasoherwa ithwa. <verse eid="LUK 21:16" /><verse number="17" style="v" sid="LUK 21:17" />Abandʉ boshi bandababaga bʉshana na ngye. <verse eid="LUK 21:17" /><verse number="18" style="v" sid="LUK 21:18" />Hewethuwe hathalɨ lʉtswɨrɨ n'olʉgʉma lw'oko mithwe enyu lolwandahera. <verse eid="LUK 21:18" /><verse number="19" style="v" sid="LUK 21:19" />Bʉshana n'ebyo muhathikanie mw'itsitsinia, kʉshangwa omw'itsitsinia eryo, mo mwandashabʉla obʉyɨngo bwenyu.»<verse eid="LUK 21:19" /></para>
  <para style="s">Mwatsɨ w'ɨshambʉlwa ly'ɨYerʉsalemʉ</para>
  <para style="r">(<ref loc="MAT 24:15-21">Mat 24:15-21</ref>; <ref loc="MRK 13:14-19">Mar 13:14-19</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20" />Yesʉ mwashʉba negena athɨ: «Mwandabya mwashʉnga omuyi w'ɨYerʉsalemʉ athimbwako n'abashirikani, aho mʉmɨnye kw'erɨshambʉlwa lyawo lɨrɨ hofɨ. <verse eid="LUK 21:20" /><verse number="21" style="v" sid="LUK 21:21" />Aho abandʉ bo bandabya iYuteya, bagende bashayɨre ko bɨthwa. N'abo bandabya mo muyi w'ɨYerʉsalemʉ bagende bathoke mʉwo. N'abo bandabya mo mashwa bathandashʉba mo muyi.<verse eid="LUK 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 21:22" />«Kʉshangwa ebɨro ebyo byandabya bɨro byo Gongo andasoha abandʉ, nɨmo ebyoshi byo bishakirwe mo Mashako Abuyirire bɨbererere.<note caller="+" style="f"><char style="fr" closed="false">21:22 </char><char style="xt" closed="false">Soma <ref loc="HOS 9:7">Oseya 9:7</ref>.</char></note> <verse eid="LUK 21:22" /><verse number="23" style="v" sid="LUK 21:23" />Mo bɨro ebyo, kwandabya bʉhanya ko bakatsɨ bo bandabya nɨ bakʉle, n'abo bandabya niabongya! Kʉshangwa kwandabya malɨgo manene mo kɨhʉgo ekyo na Gongo andakangania obʉhɨthane bʉwe ko bandʉ abo. <verse eid="LUK 21:23" /><verse number="24" style="v" sid="LUK 21:24" />Bandʉ bagʉma bandithwa mo muyali, n'abandɨ bandalerekwa mʉ bɨndɨ bɨhʉgo. N'abandʉ b'ebɨhanda bandalyathanga omuyi w'ɨYerʉsalemʉ ihika ko kɨro endambi yabo yandahwa.»<verse eid="LUK 21:24" /></para>
  <para style="s">Ɨshʉbʉla ly'oMʉgala w'oMʉndʉ</para>
  <para style="r">(<ref loc="MAT 24:29-31">Mat 24:29-31</ref>; <ref loc="MRK 13:24-27">Mar 13:24-27</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25" />Yesʉ mwashʉba negena athɨ: «Ebɨmɨnyɨkalo byandashʉngɨka mw'ɨtsʉba, n'omo mʉgenda, n'omo songununu. Na mo kɨhʉgo abandʉ bandabya mʉ malɨgo na mw'ɨhononokala bʉshana n'erɨhʉha n'emibimbi by'engetsɨ. <verse eid="LUK 21:25" /><verse number="26" style="v" sid="LUK 21:26" />Abandʉ bandagenda abalekʉla bʉshana n'omushiki omw'ɨrɨndɨrɨra ebyo byandabya mo kɨhʉgo. Kʉshangwa byo biwithe amaka mo lʉbʉla byandathenganibwa. <verse eid="LUK 21:26" /><verse number="27" style="v" sid="LUK 21:27" />Aho bandashʉnga <char style="w">oMʉgala w'oMʉndʉ</char> nɨathoka mo kɨfʉ, na maka, na lʉkengerwa lʉnene. <verse eid="LUK 21:27" /><verse number="28" style="v" sid="LUK 21:28" />Emyatsɨ eyo yandabya yathanga ɨhʉlʉka, mwimane na mʉyɨsɨngɨrɨke kʉshangwa endambi y'erɨshabʉlwa lyenyu yɨrɨ hofɨ.»<verse eid="LUK 21:28" /></para>
  <para style="s">oBwamɨ bwa Gongo bʉlɨ hofɨ</para>
  <para style="r">(<ref loc="MAT 24:32-35">Mat 24:32-35</ref>; <ref loc="MRK 13:28-31">Mar 13:28-31</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29" />Honyuma kw'aho Yesʉ mwashʉba tsɨra abandʉ b'omushinga ono athɨ: «Mʉlolere ko mʉthɨ w'omutini n'eyɨndɨ mɨthɨ yoshi. <verse eid="LUK 21:29" /><verse number="30" style="v" sid="LUK 21:30" />Omunabya mwashʉnga ebɨbabɨ byaro byathanga ɨlasha nɨmwamɨnya kw'ekɨgenyero kikwirire kɨrɨ hofɨ. <verse eid="LUK 21:30" /><verse number="31" style="v" sid="LUK 21:31" />Na kuthyo, mwandabya mwalola emyatsɨ eyi yabya, mʉmɨnye <char style="w" lemma="Bwamɨ bwa Gongo">k'oBwamɨ bwa Gongo</char> bʉhera hofɨ. <verse eid="LUK 21:31" /><verse number="32" style="v" sid="LUK 21:32" />Nɨ kwenene, enyɨbabwɨra ko emyatsɨ yoshi eyo yandabererera abandʉ b'omo lʉgero lʉno bandabya nibathetsi bafwa aboshi. <verse eid="LUK 21:32" /><verse number="33" style="v" sid="LUK 21:33" />Olʉbʉla n'ekɨhʉgo byandatsʉka, he ebɨnwa byaye ɨbyo bɨthɨndatsʉke na hake.»<verse eid="LUK 21:33" /></para>
  <para style="s">Ɨrɨndɨrɨra erɨshʉbʉla lya Yesʉ</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34" />Yesʉ mwashʉba negena athɨ: «Muyitheye nɨmo emɨthɨma enyu ɨthɨtsɨthoherwe mw'ishondya irya bɨngɨ kʉtsɨbʉ n'omo bukundirya na omw'iganga-gangya emɨthɨma enyu bʉshana n'obʉyɨngo bwenyu. Muthayitheyitsye, ekɨro ekyo ky'erihika lya Kirisito kyandabalɨbʉkanɨtsya, <verse eid="LUK 21:34" /><verse number="35" style="v" sid="LUK 21:35" />ng'omʉthego kwanagenda atsɨmba. Kʉshangwa ekɨro ekyo kyandalɨbʉkanɨtsya abandʉ b'omo kɨhʉgo kyoshi. <verse eid="LUK 21:35" /><verse number="36" style="v" sid="LUK 21:36" />Aho mʉthayagatho! Mʉgende omʉshaba Gongo ko ndambi soshi. Nɨmo mwandabona kagala k'ɨyɨhɨgʉla ko bɨndʉ byoshi byandahika, n'imana embere saye ingye <char style="w">Mʉgala w'oMʉndʉ</char>.»<verse eid="LUK 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37" />Yesʉ agenda ashiba mo <char style="w">Nyʉmba ya Gongo</char> niakangɨrɨtsya abandʉ. N'omo kɨro agenda ayagonzera ko kɨthwa ky'eMiseituni. <verse eid="LUK 21:37" /><verse number="38" style="v" sid="LUK 21:38" />Abandʉ boshi bagenda abamuhikira mo mambya mo <char style="w">Nyʉmba ya Gongo</char> bʉshana n'ɨmʉhʉlɨkɨrɨtsya.<verse eid="LUK 21:38" /></para>
  <chapter eid="LUK 21" />
  <chapter number="22" style="c" sid="LUK 22" />
  <para style="s">Enama y'eritha Yesʉ</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mat 26:1-5</ref>; <ref loc="MRK 14:1-2">Mar 14:1-2</ref>; <ref loc="JHN 11:45-53">Yoa 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1" />Ekɨro ky'elinye ly'emikati <char style="w" lemma="Mikati ɨthemo tsatsʉ">ɨthemo tsatsʉ</char> kyo bagenda abahʉlamo <char style="w">Pasaka</char> kyabyaga hofɨ n'ihika.<note caller="+" style="f"><char style="fr" closed="false">22:1 </char><char style="xt" closed="false">Soma <ref loc="EXO 12:1-17">Ɨthoka 12:1-17</ref>.</char></note> <verse eid="LUK 22:1" /><verse number="2" style="v" sid="LUK 22:2" /><char style="w" lemma="Muheri">Abakʉlʉ b'abaheri</char> <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">n'abakangɨrɨtsya b'oMʉgomba</char> bagenda abashondya ko bangɨthɨsa Yesʉ. Hewethuwe babyaga n'ibubahire abandʉ.<verse eid="LUK 22:2" /></para>
  <para style="s">Yuta atsɨga ɨhothera Yesʉ</para>
  <para style="r">(<ref loc="MAT 26:14-16">Mat 26:14-16</ref>; <ref loc="MRK 14:10-11">Mar 14:10-11</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 22:3" />Aho <char style="w">Sitani</char> mwɨngɨra mʉ Yuta, oyo wagenda ahʉlwamo Isikariote. Yuta oyo abyaga mʉgʉma w'oko bathʉmwa ikumi na babɨrɨ ba Yesʉ. <verse eid="LUK 22:3" /><verse number="4" style="v" sid="LUK 22:4" />Mwayasɨmola <char style="w" lemma="Muheri">n'abakʉlʉ b'abaheri</char> n'abakʉlʉ b'abatheya b'eNyʉmba ya Gongo, bʉshana ahʉlɨkɨrɨrane nabo nga kw'ahabo Yesʉ. <verse eid="LUK 22:4" /><verse number="5" style="v" sid="LUK 22:5" />Mobamoga, n'ɨmʉlaga ko bamʉha faranga. <verse eid="LUK 22:5" /><verse number="6" style="v" sid="LUK 22:6" />Yuta mwatsɨga na mwathanga ishondya mwanya angahabo Yesʉ bʉtsɨra abandʉ erɨmɨnya.<verse eid="LUK 22:6" /></para>
  <para style="s">Yesʉ akalihya akalyo k'ePasaka</para>
  <para style="r">(<ref loc="MAT 26:17-25">Mat 26:17-25</ref>; <ref loc="MRK 14:12-21">Mar 14:12-21</ref>; <ref loc="JHN 13:21-30">Yoa 13:21-30</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7" />Ekɨro ky'emikati <char style="w" lemma="Mikati ɨthemo tsatsʉ">ɨthemo tsatsʉ</char> mokyahika. Nɨ ekɨro ekyo kyo bangakeriremo ebyana by'esombuli bʉshana n'elinye <char style="w" lemma="Pasaka">ly'ePasaka</char>. <verse eid="LUK 22:7" /><verse number="8" style="v" sid="LUK 22:8" />Yesʉ mwathʉma Petero na Yoani n'ɨnegena athɨ: «Mʉgende mʉyathʉthekere akalyo <char style="w" lemma="Pasaka">k'ePasaka</char> bʉshana thulyeko.» <verse eid="LUK 22:8" /><verse number="9" style="v" sid="LUK 22:9" />Mobamʉbʉtsya bathɨ: «Oushondya thʉyathekereko hayi?» <verse eid="LUK 22:9" /><verse number="10" style="v" sid="LUK 22:10" />Mwashʉbɨtsyabo athɨ: «Mwonvwe! Mwabya mwɨngɨra mo muyi, mwahindana na mʉndʉ ahekire kɨrega kya metsi. Omʉndʉ oyo mʉmʉkwame mo nyʉmba ɨngɨramo. <verse eid="LUK 22:10" /><verse number="11" style="v" sid="LUK 22:11" />Na mwabwɨra omwenye enyʉmba mʉthɨ: “oMʉkangɨrɨtsya akʉbʉtsya nga hayi hohalɨ ekɨshenge ekyo alɨramo akalyo <char style="w" lemma="Pasaka">k'ePasaka</char> hagʉma <char style="w" lemma="Abɨga">n'abɨga</char> bʉwe.” <verse eid="LUK 22:11" /><verse number="12" style="v" sid="LUK 22:12" />Aho omʉndʉ oyo abakangya ekɨshenge kɨnene ky'elʉgʉlʉ kyamalire ikomibwa kɨrɨmo n'ebɨndʉ byoshi. Omo momwathʉthekera akalyo k'ePasaka.» <verse eid="LUK 22:12" /><verse number="13" style="v" sid="LUK 22:13" /><char style="w">Abɨga</char> abo mobagenda mobeya ebɨndʉ nɨbɨnalɨ nga ko Yesʉ abwɨragabo. Mobatheka akalyo <char style="w" lemma="Pasaka">k'ePasaka</char>.<verse eid="LUK 22:13" /></para>
  <para style="s">Kalyo k'ɨbʉka Nyinya-kowethʉ</para>
  <para style="r">(<ref loc="MAT 26:26-30">Mat 26:26-30</ref>; <ref loc="MRK 14:22-26">Mar 14:22-26</ref>; <ref loc="1CO 11:23-25">1Kor 11:23-25</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14" />Endambi y'erirya yabere yahika Yesʉ mwikala alye hagʉma <char style="w" lemma="Bathʉmwa">n'abathʉmwa</char> bʉwe.<figure style="fig" alt="Jesus mange la pacque avec ses apotres" file="WA03910b.tif" size="span" ref="22:14">Yesʉ alya ePasaka hagʉma n'abathʉmwa bʉwe</figure> <verse eid="LUK 22:14" /><verse number="15" style="v" sid="LUK 22:15" />Mwabwɨrabo athɨ: «Monyashonditsye kʉtsɨbʉ irya akalyo <char style="w" lemma="Pasaka">k'ePasaka</char> kano hagʉma nemwe embere banyagatsye. <verse eid="LUK 22:15" /><verse number="16" style="v" sid="LUK 22:16" />Ega! Enyɨbabwɨra nyɨthɨ nyɨthɨndashʉbalye akalyo k'ePasaka ihika ko kɨro nyandalya akalyo akalumirire mo <char style="w">Bwamɨ bwa Gongo</char>.»<verse eid="LUK 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 22:17" />Aho Yesʉ mwatsɨmba olwatha, mwasɨma Gongo n'ɨnegena athɨ: «Mʉtsɨmbe olwatha lʉno na imwe boshi mʉshangɨrelo. <verse eid="LUK 22:17" /><verse number="18" style="v" sid="LUK 22:18" />Ega! Enyɨbabwɨra ɨthanga ko ndambi eno nyɨthɨndashʉbeshome <char style="w" lemma="Tifayi">etifayi</char> na hake ihika ko kɨro<char style="w" lemma="Bwamɨ bwa Gongo">oBwamɨ bwa Gongo</char> bwandahika.»<verse eid="LUK 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19" />Honyuma kw'aho Yesʉ mwatsɨmba omukati mwasɨma Gongo, mwatsawo n'ɨhawo abathʉmwa bʉwe. Mwanegena athɨ: «Ono nɨ mʉbɨrɨ aye w'amahanwa bʉshana nemwe, mʉgende omʉyɨra muthyo kw'ɨnyɨbʉka.»<verse eid="LUK 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 22:20" />Babere bamala irya, Yesʉ mwathola olwatha, mwahalobo n'ɨnegena athɨ: «Olwatha lʉno nɨ <char style="w">ndagane</char> nyihya mo mʉsasɨ aye w'amashesheka bʉshana nemwe.<verse eid="LUK 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 22:21" />«He mʉlole! Omʉndʉ yo wanyɨhothera alya hagʉma nangye. <verse eid="LUK 22:21" /><verse number="22" style="v" sid="LUK 22:22" />Ingye <char style="w" lemma="Mʉgala w'oMʉndʉ">Mʉgala w'oMʉndʉ</char> nyafwa ɨkwamana n'erishasha lya Gongo. Hewethuwe bʉhanya ko mʉndʉ yo wanyɨhana.» <verse eid="LUK 22:22" /><verse number="23" style="v" sid="LUK 22:23" />Abathʉmwa mobathanga ibutsania nga nɨ ndɨ mʉbo yo wakola ekyo.<verse eid="LUK 22:23" /></para>
  <para style="s">Yo ushondya ibya mʉkʉlʉ ayikehye</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24" />Mo <char style="w" lemma="Abɨga">bɨga</char> momwabya bʉhaka bʉngɨ bʉshana n'ɨmɨnya nga nɨ ndɨ yo mʉkʉlʉ mo kathi kabo. <verse eid="LUK 22:24" /><verse number="25" style="v" sid="LUK 22:25" />Yesʉ mwabwɨrabo athɨ: «Mo bandʉ bobathetsi Gongo, abamɨ babo abanagenda abathegekabo mo kahatho. Na bo bawithe amaka kʉbo abanagenda abayahʉlamo “bakoli ba bɨbʉya.” <verse eid="LUK 22:25" /><verse number="26" style="v" sid="LUK 22:26" />He kw'imwe bɨthagenda ebibya bithyo. Omʉndʉ mʉkʉlʉ mw'imwe lɨtholere niabya nga yo mʉlere. Na yo ʉthegeka abandɨ abye nga yo mukoli. <verse eid="LUK 22:26" /><verse number="27" style="v" sid="LUK 22:27" />Aho nɨ ndɨ yo mʉkʉlʉ kʉlenga mulikyabo? Yo wikere alɨ alya kʉtse yo ʉmʉkolera? Ndɨ nɨ yo wikere alɨ alya! H'ingye nyɨrɨ mo kathi kenyu nga mukoli.<verse eid="LUK 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 22:28" />«Nemwe momwatsitsiniaga ibya hagʉma nangye mw'ɨlengwako lyaye. <verse eid="LUK 22:28" /><verse number="29" style="v" sid="LUK 22:29" />Bʉshana n'ekyo, nga ko Thatha anyɨhaga oBwamɨ, nangye kuthyo enyɨbahabo. <verse eid="LUK 22:29" /><verse number="30" style="v" sid="LUK 22:30" />Aho, mwandalya n'ɨshoma hagʉma nangye mo Bwamɨ bwaye. Kandɨ ni imwe mo mwandikala ko ndebe bʉshana n'ɨsoha esonganda ikumi n'ibiri <char style="w" lemma="Isiraeli">s'aBaisiraeli</char>.»<verse eid="LUK 22:30" /></para>
  <para style="s">Yesʉ afʉla mwatsɨ ko Petero ayɨgana ɨye</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mat 26:31-35</ref>; <ref loc="MRK 14:27-31">Mar 14:27-31</ref>; <ref loc="JHN 13:36-38">Yoa 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31" />Yesʉ mwabwɨra Simoni athɨ: «Simoni, Simoni, hʉlɨkɨrɨtsya! <char style="w">Sitani</char> mwashaba ehamuli bʉshana n'ibalongya ng'oko abanagenda abalongya engano bʉshana n'ɨbalengako. <verse eid="LUK 22:31" /><verse number="32" style="v" sid="LUK 22:32" />He, ingye monyɨkʉshabɨra, bʉshana olwɨkɨrɨtsyo lwawe kw'ingye uthamikagalo. Wandabya wanyɨshʉbɨra, ʉhe bagala benyu bo muhwa.»<verse eid="LUK 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33" />Petero mwamʉshʉbɨtsya athɨ: «Nyinya-kowethʉ, ingye nyiyisingire ɨya mo muliki hagʉma nawe, n'ɨfwa hagʉma nawe.»<verse eid="LUK 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34" />Yesʉ mwamʉshʉbɨtsya athɨ: «Mbe Petero! Enyɨkʉbwɨra nyɨthɨ munobwire embagatsɨ yabɨka nɨwamanyɨthɨnda ngendo ishathu ko uthanyetsi.»<verse eid="LUK 22:34" /></para>
  <para style="s">Faranga, shaho na muyali</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35" />Aho Yesʉ mwabwɨra <char style="w">abɨga</char> athɨ: «Lyo nyabathʉmaga bʉthaheka lʉfaranga kʉtse shaho kʉtse bɨrato, momwabʉsha kɨndʉ?» Nabo bathɨ: «Kiro!»<verse eid="LUK 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36" />Yesʉ mwabwɨrabo athɨ: «He lɨno, yo uwithe kʉ lʉfaranga ahekelo, na kuthyo yo uwithe kʉ shaho ashahero na yo uthawithe kʉ muyali agʉtse ekoti yɨwe bʉshana agʉlewo. <verse eid="LUK 22:36" /><verse number="37" style="v" sid="LUK 22:37" />Enyɨbabwɨra ko lɨtholere bɨno nibyanyihikira, byo bishakirwe mo Mashako Abuyirire bɨthɨ: “Mobamʉganza mo mɨganzo y'abakoli b'ebɨtsɨbʉ.<note caller="+" style="f"><char style="fr" closed="false">22:37 </char><char style="xt" closed="false">Soma <ref loc="ISA 53:12">Isaya 53:12</ref>.</char></note>” Kʉshangwa ebɨnwa ebinyilebitsye bɨrɨ hofɨ n'ihika ko nduli yabyo.» <verse eid="LUK 22:37" /><verse number="38" style="v" sid="LUK 22:38" /><char style="w">Abɨga</char> mobamʉbwɨra bathɨ: «Nyinya-kowethʉ, hano thuwithe ku miyali ibiri.» Mwashʉbɨtsyabo athɨ: «Bɨhwere aho.»<verse eid="LUK 22:38" /></para>
  <para style="s">Yesʉ ashaba Gongo ko kɨthwa ky'eMiseituni</para>
  <para style="r">(<ref loc="MAT 26:36-46">Mat 26:36-46</ref>; <ref loc="MRK 14:32-42">Mar 14:32-42</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39" />Yesʉ mwathoka mo muyi oyo, mwɨrʉkɨra ko kɨthwa ky'eMiseituni nga ko abyaga abegere. <char style="w">Abɨga</char> bʉwe mobamʉkwama. <verse eid="LUK 22:39" /><verse number="40" style="v" sid="LUK 22:40" />Abere ahika ahandʉ aho, mwabwɨra <char style="w">abɨga</char> bʉwe athɨ: «Mʉshabe Gongo, nɨmo mwabona kagala k'ikinda mwabya mwalengwako.»<verse eid="LUK 22:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 22:41" />Honyuma kw'aho mwayɨfʉnda hale kʉbo haleha n'aho mʉndʉ angahikya eribwe athagʉsha. Mwafʉkama n'ɨthanga ɨshaba Gongo athɨ: <verse eid="LUK 22:41" /><verse number="42" style="v" sid="LUK 22:42" />«Thatha, wamashasha olwatha lw'obwagali olu fʉnda lo hale nangye. Hewethuwe bithabyaga nga ko nyishashire, he erɨshasha lyawe lyo lɨkoleke.»</para>
  <para style="p" vid="LUK 22:42">[<verse eid="LUK 22:42" /><verse number="43" style="v" sid="LUK 22:43" />Aho malaɨka mʉgʉma mwathoka mo lʉbʉla, mwamʉhʉlʉkɨra bʉshana amʉhe kagala. <verse eid="LUK 22:43" /><verse number="44" style="v" sid="LUK 22:44" />Yesʉ abyaga nɨagalwa kʉtsɨbʉ, mwongerera ɨshaba Gongo na muhwa mʉngɨ. N'esondʉbano sagenda esɨthoka kw'ɨye mosabya nga mathondi wa mʉsasɨ w'agenda athogongera ahishi.<note caller="+" style="f"><char style="fr" closed="false">22:43-44 </char><char style="ft" closed="false">Emɨlondo eno ɨthalɨ mʉ mashako magʉma wa kera.</char></note>]<verse eid="LUK 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45" />Abere amamala ɨshaba, mwimana n'ɨshʉba eyɨrɨ <char style="w">abɨga</char>, mweyabo nɨbalɨtho bʉshana n'enduhi y'obuliye. <verse eid="LUK 22:45" /><verse number="46" style="v" sid="LUK 22:46" />Mwabwɨrabo athɨ: «Omʉyatho bʉshana na ki? Mwimane na mʉshabe Gongo nɨmo mwabona kagala k'ikinda mwabya mwalengwako.»<verse eid="LUK 22:46" /></para>
  <para style="s">Yesʉ atsɨmbwa</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mat 26:47-56</ref>; <ref loc="MRK 14:43-50">Mar 14:43-50</ref>; <ref loc="JHN 18:3-11">Yoa 18:3-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47" />Yesʉ abere akɨnalɨ anegena, aho n'aho mokwahʉlʉka muhindano mʉnene wa bandʉ. Nɨ Yuta, mʉgʉma w'oko bathʉmwa ikumi na babɨrɨ ba Yesʉ, yo wabyaga nɨashondolerewo, mwaya ahalɨ Yesʉ bʉshana n'ɨmʉfʉmbatha. <verse eid="LUK 22:47" /><verse number="48" style="v" sid="LUK 22:48" />Yesʉ mwamʉbʉtsya athɨ: «Mbe Yuta! Nɨ mw'ɨnyɨfʉmbatha mo ʉnyɨhothera ingye <char style="w">Mʉgala w'oMʉndʉ</char>?»<verse eid="LUK 22:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49" />Abɨga ba Yesʉ babere bashʉnga ko byo byabya, mobamʉbʉtsya bathɨ: «Nyinya-kowethʉ, thʉbandangebo mo miyali?»<verse eid="LUK 22:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 22:50" />Aho n'aho mʉgʉma wa kʉbo mwabanda omukoli <char style="w" lemma="Muheri">w'omuheri mʉkʉlʉ</char>, n'ɨmʉtsako okuthwi kw'amalyo. <verse eid="LUK 22:50" /><verse number="51" style="v" sid="LUK 22:51" />He Yesʉ mwanegena athɨ: «Mulikire aho!» Mwakola ko kuthwi kw'omʉndʉ oyo n'imulamya.<verse eid="LUK 22:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52" />Aho, Yesʉ mwabwɨra <char style="w" lemma="Muheri">abakʉlʉ b'abaheri</char>, n'abakʉlʉ b'abatheya <char style="w" lemma="Nyʉmba ya Gongo">b'eNyʉmba ya Gongo</char>, n'abakʉlʉ b'abandʉ, bo bahikaga ɨmʉtsɨmba athɨ: «Bʉshana na ki mwamanyihikira n'emiyali na mihumbo nga nyɨrɨ mushamuli? <verse eid="LUK 22:52" /><verse number="53" style="v" sid="LUK 22:53" />Ebɨro byoshi nyabyaga hagʉma nemwe mo <char style="w">Nyʉmba ya Gongo</char>, momʉthanyɨtsɨmba. He eno nɨ ndambi enyu, yona ndambi y'amaka w'ekɨbɨ w'akolera mo mwitsimya.»<verse eid="LUK 22:53" /></para>
  <para style="s">Petero ayɨgana Yesʉ</para>
  <para style="r">(<ref loc="MAT 26:57-58">Mat 26:57-58</ref>,<ref loc="MAT 26:69-75">69-75</ref>; <ref loc="MRK 14:53-54">Mar 14:53-54</ref>,<ref loc="MRK 14:66-72">66-72</ref>; <ref loc="JHN 18:12-18">Yoa 18:12-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54" />Aho, abandʉ abo mobatsɨmba Yesʉ. Mobamʉheka n'ɨmʉthwala mo nyʉmba <char style="w" lemma="Muheri">y'omuheri mʉkʉlʉ</char>. Petero niakwamirebo nɨanalɨ hale.<verse eid="LUK 22:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 22:55" />Mobatsana kiriko mo kathi k'embʉga y'omuheri mʉkʉlʉ n'ithimba kʉkyo. Petero naye mwahika ɨotha ko mʉtsanwa hagʉma nabo. <verse eid="LUK 22:55" /><verse number="56" style="v" sid="LUK 22:56" />Mukoli mʉgʉma mʉkatsɨ abere ashʉnga ko Petero ikere hofɨ n'omʉtsanwa, mwamʉhandako amesho kʉtsɨbʉ n'ɨnegena athɨ: «Omʉndʉ oyu naye athalɨ hagʉma na Yesʉ.» <verse eid="LUK 22:56" /><verse number="57" style="v" sid="LUK 22:57" />He Petero mwayɨgana n'ɨnegena athɨ: «Ɨwe mʉkatsɨ! Nyithetsi omʉndʉ oyu!»<verse eid="LUK 22:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58" />Kwabere kwahwa kathambi, ʉndɨ mʉndʉ mwashʉnga Petero n'ɨmʉbwɨra athɨ: «Ɨwe nawe kundu kundu ʉlɨ mʉgʉma wa kʉbo!» He Petero mwashʉbɨtsya omʉndʉ oyo athɨ: «Ingye nyɨthalɨ mʉgʉma wa kʉbo.»<verse eid="LUK 22:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59" />Kwabere kwatsʉka nga saha ngʉma, ʉndɨ mʉndʉ mwahathɨkɨrɨtsya ekɨnwa kyo kʉ Petero athɨ: «Kwenene, omʉndʉ oyu athalɨ hagʉma na Yesʉ, kʉshangwa naye nɨ mʉndʉ w'iNgalilaya.»<verse eid="LUK 22:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60" />He Petero mwashʉbɨtsya omʉndʉ oyo athɨ: «Nyithetsi ebyo ʉnegena!» Petero abere akɨnalɨ anegena aho n'aho embagatsɨ moyabɨka. <verse eid="LUK 22:60" /><verse number="61" style="v" sid="LUK 22:61" />Nyinya-kowethʉ mwabɨndʉka, mwahanda amesho wo kʉ Petero. Aho, Petero abere amɨnya ko Yesʉ amamʉlola mwɨbʉka ebɨnwa Nyinya-kowethʉ athamʉbwɨra athɨ: «Munobwire, embagatsɨ yabɨka nɨwamayɨgana ingye ngendo ishathu ʉthɨ uthanyetsi.» <verse eid="LUK 22:61" /><verse number="62" style="v" sid="LUK 22:62" />Aho, Petero mwahʉlʉkɨra embʉga nɨalɨra n'obuliye kʉtsɨbʉ.<verse eid="LUK 22:62" /></para>
  <para style="s">Abandʉ abashekeretsya Yesʉ</para>
  <para style="r">(<ref loc="MAT 26:67-68">Mat 26:67-68</ref>; <ref loc="MRK 14:65">Mar 14:65</ref>)</para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63" />Abandʉ bo bagenda abatheya Yesʉ bagenda abamʉshekeretsya n'imuhumba. <verse eid="LUK 22:63" /><verse number="64" style="v" sid="LUK 22:64" />Mobashwɨka obʉsʉ bʉwe n'ɨmʉbʉtsya bathɨ: «Mɨnyerera nga nɨ ndɨ yo wamakuhumba!» <verse eid="LUK 22:64" /><verse number="65" style="v" sid="LUK 22:65" />Mobamʉgʉshɨra bɨndɨ bɨnwa bɨngɨ b'imuhangya.<verse eid="LUK 22:65" /></para>
  <para style="s">Yesʉ athonda mo Bʉshenge Bʉkʉlʉ bw'aBayuta</para>
  <para style="r">(<ref loc="MAT 26:59-66">Mat 26:59-66</ref>; <ref loc="MRK 14:55-64">Mar 14:55-64</ref>; <ref loc="JHN 18:19-24">Yoa 18:19-24</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66" />Bwabere bwakya, abakʉlʉ b'aBayuta <char style="w" lemma="Muheri">n'abakʉlʉ b'abaheri</char> <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">n'abakangɨrɨtsya b'oMʉgomba</char> mobahindana. Mobahamʉla bathɨ baletherebo Yesʉ mo <char style="w">Bʉshenge Bʉkʉlʉ</char> bwabo. <verse eid="LUK 22:66" /><verse number="67" style="v" sid="LUK 22:67" />Mobamʉbʉtsya bathɨ: «Thʉbwɨre! Ɨwe <char style="w" lemma="Kirisito, Masia">Kirisito</char>?» Mwashʉbɨtsyabo athɨ: «Monyangababwɨra nyɨthɨ nɨ ingye, mʉthanganyɨkɨrɨtsya. <verse eid="LUK 22:67" /><verse number="68" style="v" sid="LUK 22:68" />Na monyangababʉtsya kɨnwa, mʉthanganyɨshʉbɨtsya. <verse eid="LUK 22:68" /><verse number="69" style="v" sid="LUK 22:69" />Hewethuwe ɨthanga lɨno, ingye <char style="w">Mʉgala w'oMʉndʉ</char> nyayikala ko malyo wa Gongo w'amaka.»<verse eid="LUK 22:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70" />Aho aboshi mobamʉbʉtsya bathɨ: «N'ɨnegena mbʉ nɨ ɨwe <char style="w">Mʉgala wa Gongo</char> he?» Yesʉ mwashʉbɨtsyabo athɨ: «Ndɨ mwamamala ɨnegena!»<verse eid="LUK 22:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="LUK 22:71" />Ko nduli mobanegena bathɨ: «Thuthakilayire kʉ batimo, kʉshangwa ithwebene-bene thwamayonvwɨra ebyo amanegena yowene!»<verse eid="LUK 22:71" /></para>
  <chapter eid="LUK 22" />
  <chapter number="23" style="c" sid="LUK 23" />
  <para style="s">Yesʉ athonda embere sa Pilato</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mat 27:1-2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="MRK 15:1-5">Mar 15:1-5</ref>; <ref loc="JHN 18:28-38">Yoa 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1" />Aho abandʉ boshi bo babyaga mo <char style="w">Bʉshenge Bʉkʉlʉ</char> bw'aBayuta mobimana, n'ɨthwala Yesʉ embere sa <char style="w">Pilato</char>. <verse eid="LUK 23:1" /><verse number="2" style="v" sid="LUK 23:2" />Mobathanga imusitaka bathɨ: «Mothweya omuyira oyu nɨakaramya abandʉ b'omo kɨhʉgo kyethʉ. Nɨahangɨrabo athɨ bathalɨhaga Ekoli ya <char style="w">Kaisari</char>, na yowene ayahʉlamo <char style="w" lemma="Kirisito, Masia">Kirisito</char>, kandɨ mwamɨ.»<verse eid="LUK 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3" />
    <char style="w">Pilato</char> mwabʉtsya Yesʉ athɨ: «Nɨ ɨwe mwamɨ <char style="w" lemma="Bayuta">w'aBayuta</char>?» Yesʉ mwamʉshʉbɨtsya athɨ: «Ndɨ nɨ ɨwe wamanegena!» <verse eid="LUK 23:3" /><verse number="4" style="v" sid="LUK 23:4" />Aho <char style="w">Pilato</char> mwabwɨra <char style="w" lemma="Muheri">abakʉlʉ b'abaheri</char> n'omuhindano athɨ: «Ingye nyithashungire kɨndʉ n'ekɨgʉma ekyangaleka omʉndʉ oyu nɨasoherwa lʉholo.»<verse eid="LUK 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 23:5" />Hewethuwe abandʉ abo mobahathɨkɨrɨtsya bathɨ: «Ebɨnwa omʉndʉ oyu akangɨrɨtsya ebikaramya abandʉ b'omo kɨhʉgo kyoshi ky'iYuteya. Mwathanga iNgalilaya, na lɨno yono amahikyabyo kʉno.»<verse eid="LUK 23:5" /></para>
  <para style="s">Yesʉ athonda embere sa Herote</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6" />
    <char style="w">Pilato</char> abere onvwa ebɨnwa ebi mwabʉtsya Yesʉ nga nɨ mʉndʉ w'iNgalilaya. <verse eid="LUK 23:6" /><verse number="7" style="v" sid="LUK 23:7" />Mobamʉbwɨra bathɨ Yesʉ nɨ mʉndʉ w'iNgalilaya. Na nɨ <char style="w">Herote</char> yo wagendaga athegeka ekɨhʉgo ky'iNgalilaya. Na ko bɨro ebyo abyaga nɨalɨ ɨYerʉsalemʉ. Bʉshana n'ekyo Pilato mwathʉma Yesʉ yo ewa <char style="w">Herote</char>.<verse eid="LUK 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 23:8" />
    <char style="w">Herote</char> abere ashʉnga Yesʉ mwamoga kʉtsɨbʉ, kʉshangwa bɨro bɨngɨ, agendaga ashondya ɨmʉshʉngako. Agendaga onvwa abandʉ kw'abanegena bʉshana naye. Kandɨ abyaga na maha w'ɨlola Yesʉ kw'akola ebɨthɨko-thɨko. <verse eid="LUK 23:8" /><verse number="9" style="v" sid="LUK 23:9" />Mwabʉtsya Yesʉ yo bɨnwa bɨngɨ, hewethuwe Yesʉ mwathamʉshʉbɨtsya kɨndʉ. <verse eid="LUK 23:9" /><verse number="10" style="v" sid="LUK 23:10" /><char style="w" lemma="Muheri">Abakʉlʉ b'abaheri</char> <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">n'abakangɨrɨtsya b'oMʉgomba</char>, bobabyagaho bagenda abanegena n'ɨhathɨkɨrɨtsya mw'isitaka Yesʉ. <verse eid="LUK 23:10" /><verse number="11" style="v" sid="LUK 23:11" /><char style="w">Herote</char> n'abashirikani bʉwe, mobashekeretsya Yesʉ n'ɨmʉsʉnzʉgʉra. Mwahamʉla athɨ bamwambikye lʉkɨmba lukwirire. Aho mwamushubya ewa <char style="w">Pilato</char>. <verse eid="LUK 23:11" /><verse number="12" style="v" sid="LUK 23:12" />Ho mbere kw'aho, <char style="w">Herote</char> na <char style="w">Pilato</char> babyaga nibabagene. Hewethuwe ɨthanga ko kɨro ekyo mobabya bira.<verse eid="LUK 23:12" /></para>
  <para style="s">Pilato ahamʉla Yesʉ ithwe</para>
  <para style="r">(<ref loc="MAT 27:15-26">Mat 27:15-26</ref>; <ref loc="MRK 15:6-15">Mar 15:6-15</ref>; <ref loc="JHN 18:39-19:16">Yoa 18:39–19:16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13" />Aho <char style="w">Pilato</char> mwahindania <char style="w" lemma="Muheri">abakʉlʉ b'abaheri</char>, abakʉlʉ b'aBayuta n'abandɨ bandʉ. <verse eid="LUK 23:13" /><verse number="14" style="v" sid="LUK 23:14" />Mwabwɨrabo athɨ: «Momʉnyɨrethera omʉndʉ oyu mʉthɨ akaramya abandʉ. Aho monyamubulitsye bʉshana n'ebɨnwa ebi embere senyu. He monyithabonire bʉbɨ mo bɨnwa byoshi byo mwamusitakiraga. <verse eid="LUK 23:14" /><verse number="15" style="v" sid="LUK 23:15" />Na <char style="w">Herote</char> naye mwathamushungireko kiro na bʉbɨ, bʉshana n'ekyo kyamaleka nɨathʉshʉbʉlɨtsya ɨye. Omʉndʉ oyu hathalɨ bʉbɨ athakola obwangaleka n'ithwa. <verse eid="LUK 23:15" /><verse number="16" style="v" sid="LUK 23:16" />Bʉshana n'ekyo, nyahamʉla ahumbwe mbasha, honyuma kw'aho nyamʉmɨnʉla.» [<verse eid="LUK 23:16" /><verse number="17" style="v" sid="LUK 23:17" />Mo bʉlɨ kɨro ky'elinye ly'ePasaka, Pilato agenda amɨnʉlɨra abandʉ bo mʉndʉ mʉgʉma wa muliki.<note caller="+" style="f"><char style="fr" closed="false">23:17 </char><char style="ft" closed="false">Omʉlondo ono athalɨ mʉ mashako magʉma wa kera.</char></note>]<verse eid="LUK 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18" />Hewethuwe abandʉ boshi mobanegenera kʉgʉma n'ɨhambala bathɨ: «Wɨthɨsa omuyira oyu! Thʉmɨnʉlɨre Baraba!» <verse eid="LUK 23:18" /><verse number="19" style="v" sid="LUK 23:19" />Baraba oyo amɨnawa bʉshana n'ikarama lya bandʉ lyabyaga mo muyi, na bʉshana n'ithwa lya mʉndʉ. <verse eid="LUK 23:19" /><verse number="20" style="v" sid="LUK 23:20" /><char style="w">Pilato</char> agenda ashondya ɨmɨnʉla Yesʉ, mwashʉba negena n'abandʉ. <verse eid="LUK 23:20" /><verse number="21" style="v" sid="LUK 23:21" />Hewethuwe mobashʉba hambala bathɨ: «Mʉbambe ko mʉsalaba! Mʉbambe ko mʉsalaba!»<verse eid="LUK 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22" />Pilato mwashʉba bʉtsya abandʉ elya kashathʉ athɨ: «Omʉndʉ oyu akolire kɨbɨ kɨhe? Nyithamushungireko bʉbɨ obw'akolire obwangaleka nɨatholera ɨfwa. Bʉshana n'ekyo nyahamʉla ahumbwe mbasha, honyuma kw'aho nyamʉmɨnʉla.»<verse eid="LUK 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23" />Hewethuwe abandʉ mobahathɨkɨrɨtsya n'ɨhambala kʉtsɨbʉ bathɨ Yesʉ abambwe ko mʉsalaba. Honyuma kw'aho abandʉ mobasɨnda Pilato bʉshana n'erɨhambala lyabo. <verse eid="LUK 23:23" /><verse number="24" style="v" sid="LUK 23:24" />Aho <char style="w">Pilato</char> mwakolerabo nga ko bagenda abamʉshaba. <verse eid="LUK 23:24" /><verse number="25" style="v" sid="LUK 23:25" />Mwamɨnʉlɨrabo Baraba yo bagendaga abamʉshaba. Namo anamɨnawa bʉshana n'ikarama lya bandʉ lyabyaga mo muyi, na bʉshana n'ithwa lya mʉndʉ. Aho mwahabo Yesʉ bamʉkolere nga ko bashashire.<verse eid="LUK 23:25" /></para>
  <para style="s">Yesʉ abambwa ko mʉsalaba</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mat 27:32-44</ref>; <ref loc="MRK 15:21-32">Mar 15:21-32</ref>; <ref loc="JHN 19:17-27">Yoa 19:17-27</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26" />Abashirikani babere banemʉthwala Yesʉ ahandʉ bayamʉbambɨra ko <char style="w">mʉsalaba</char>, mobahindana na mʉndʉ mʉgʉma nɨathoka engero erɨtsɨna lɨwe nɨ yo Simoni. Simoni oyo abyaga muhimbani w'omo muyi w'iKurene. Mobamʉtsɨmba n'imuhekya <char style="w" lemma="Mʉsalaba">omʉsalaba</char> wa Yesʉ mʉ kahatho. Mwakwama Yesʉ y'enyuma.<verse eid="LUK 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 23:27" />Muhindano mʉnene wa bandʉ mwakwama Yesʉ. Mo bandʉ abo mwabyaga bakatsɨ bo bagendaga abamʉlɨrɨra n'iyihania bʉshana naye.<verse eid="LUK 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 23:28" />Yesʉ mwabɨndʉka n'ɨbwɨra abakatsɨ abo athɨ: «Imwe bakatsɨ b'ɨYerʉsalemʉ mʉthanyɨrɨrɨraga! Hewethuwe mʉyɨrɨrɨre imwe bene n'abana benyu! <verse eid="LUK 23:28" /><verse number="29" style="v" sid="LUK 23:29" />Ewo mwonvwe! Ebɨro byandahika mo ndambi abandʉ bandanegena bathɨ: “Bagashanɨrwe abagʉmba na bo bathahera bathabʉtha, na bo bathahera bathongya!” <verse eid="LUK 23:29" /><verse number="30" style="v" sid="LUK 23:30" />Mo bɨro ebyo,</para>
  <para style="q1" vid="LUK 23:30">abandʉ bandathanga ɨbwɨra ebɨthwa bathɨ: “Mʉthʉtherereko!”</para>
  <para style="q1" vid="LUK 23:30">Na bandabwɨra ehɨthwa bathɨ: “Mʉthʉshwɨke!<note caller="+" style="f"><char style="fr" closed="false">23:30 </char><char style="xt" closed="false">Soma <ref loc="HOS 10:8">Oseya 10:8</ref>.</char></note>”<verse eid="LUK 23:30" /></para>
  <para style="m">
    <verse number="31" style="v" sid="LUK 23:31" />Kʉshangwa bamanyɨkolera bathya ingye nyɨrɨ ng'omʉthɨ mʉbɨshɨ, bandabakolera bathɨ imwe mʉlɨ nga mɨthɨ myʉmʉ?»<verse eid="LUK 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32" />Mobaletha bandɨ bandʉ babɨrɨ bakoli ba bɨbɨ nabo bayithirwe hagʉma na Yesʉ. <verse eid="LUK 23:32" /><verse number="33" style="v" sid="LUK 23:33" />Babere bahika ahandʉ ho hagenda ahahʉlwamo «Kahangali», abashirikani mobabamba Yesʉ y'oko mʉsalaba. Mobabamba kuthyo abakoli b'ebɨbɨ babɨrɨ abo,<note caller="+" style="f"><char style="fr" closed="false">23:33 </char><char style="xt" closed="false">Soma <ref loc="ISA 53:12">Isaya 53:12</ref>.</char></note> mʉgʉma ko lʉhande lwa Yesʉ lw'amalyo n'ogʉndɨ ko lwa malembe.<figure style="fig" alt="Jesus and two criminals on the cross" file="gt00087.tif" size="span" ref="23:33">Yesʉ ko mʉsalaba mo kathi-kathi k'abakoli b'ebɨbɨ babɨrɨ</figure> [<verse eid="LUK 23:33" /><verse number="34" style="v" sid="LUK 23:34" />Aho Yesʉ mwanegena athɨ: «Thatha, ʉganyɨrebo, kʉshangwa bathetsi kyo bakola!<note caller="+" style="f"><char style="fr" closed="false">23:34 </char><char style="ft" closed="false">Omʉlondo ono athalɨ mʉ mashako magʉma wa kera.</char></note>»]</para>
  <para style="p" vid="LUK 23:34">Abashirikani mobagaba esongɨmba sa Yesʉ mo bwɨkɨ.<verse eid="LUK 23:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 23:35" />Abandʉ babyaga nibimeneho, balɨ abayɨthegeretsya. Abakʉlʉ b'aBayuta bagenda abashekeretsya Yesʉ bathɨ: «Mwashabʉla abandɨ bandʉ. Ɨngo, ayɨshabʉle yowene, amabya nɨna <char style="w" lemma="Kirisito, Masia">Kirisito</char> yo ashombolawa na Gongo!»<verse eid="LUK 23:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 23:36" />Abashirikani nabo mobathanga ɨshekeretsya Yesʉ. Mobayɨfʉnda hofɨ naye bʉshana n'ɨmʉha tifayi ɨtsʉkɨrene. <verse eid="LUK 23:36" /><verse number="37" style="v" sid="LUK 23:37" />Mobamʉbwɨra bathɨ: «Wamabya nɨ ɨwe mwamɨ <char style="w" lemma="Bayuta">w'aBayuta</char> ʉyɨshabʉle wowene!»<verse eid="LUK 23:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38" />Ho lʉgʉlʉ w'omuthwe wa Yesʉ mobahiraho kɨshayɨ kyabyaga kishakireko kɨthɨ: «Oyu nɨ mwamɨ <char style="w" lemma="Bayuta">w'aBayuta</char>.»<verse eid="LUK 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39" />Mʉgʉma w'oko bakoli b'ebɨbɨ babɨrɨ abo bobabambawa ko mʉsalaba, mwathanga ihangya Yesʉ athɨ: «Ndɨ n'ɨwe <char style="w" lemma="Kirisito, Masia">Kirisito</char>! Yɨshabʉle wowene, nethwe kuthyo ʉthʉshabʉle!»<verse eid="LUK 23:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40" />Hewethuwe mulikyabo mwamʉkemera athɨ: «Ɨwe uthubahire Gongo, na mo wanamasoherwa olʉholo ng'omʉndʉ oyu? <verse eid="LUK 23:40" /><verse number="41" style="v" sid="LUK 23:41" />Kw'ithwe amalipisi aya athʉtholere, kʉshangwa othʉsohwa ɨkwamana n'ebɨbɨ thwakolaga. Hewethuwe omʉndʉ oyu ɨye hathalɨ kiro n'ekɨbɨ athakola.»<verse eid="LUK 23:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 23:42" />Honyuma kw'aho mwanegena athɨ: «Yesʉ, ingye ʉnyɨbʉke mo ndambi wandahika mo buthegeki bwawe.» <verse eid="LUK 23:42" /><verse number="43" style="v" sid="LUK 23:43" />Yesʉ mwamʉshʉbɨtsya athɨ: «Kwenene, enyɨkʉbwɨra munobwire wabya hagʉma na ngye mo <char style="w">Paratiso</char>.»<verse eid="LUK 23:43" /></para>
  <para style="s">Lʉholo lwa Yesʉ</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mat 27:45-56</ref>; <ref loc="MRK 15:33-41">Mar 15:33-41</ref>; <ref loc="JHN 19:28-30">Yoa 19:28-30</ref>)</para>
  <para style="p">
    <verse number="44-45" style="v" sid="LUK 23:44-45" />Bwabere bwashonda ihika kathi ka mwɨshɨ, erɨtsʉba molɨthashʉba koletsya. Omwitsimya mwashwɨka ekɨhʉgo kyoshi ihika ko saha mwenda. Epasɨya yabyaga ihanikire mo <char style="w" lemma="Nyʉmba ya Gongo:">Nyʉmba ya Gongo</char> moyabereka mo kathi-kathi.<note caller="+" style="f"><char style="fr" closed="false">23:44-45 </char><char style="ft" closed="false">Nɨ epasɨya eyo yo yabyaga igabire ahandʉ habuyirire na ahabuyirire kʉtsɨbʉ mo Nyʉmba ya Gongo. Nɨ abaheri bakʉlʉ basha bo bagenda abatsʉka mo pasɨya eyo bʉshana n'iyahindana na Gongo. Aho Gongo mwaberenga epasɨya eyo bʉshana n'ikangania ko bʉlɨ mʉndʉ ahera angayɨfʉnda hofɨ naye. </char><char style="xt" closed="false">Soma <ref loc="EXO 26:31-33">Ɨthoka 26:31-33</ref>; <ref loc="HEB 10:19-22">Baebʉranɨa 10:19-22</ref>.</char></note><verse eid="LUK 23:44-45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 23:46" />Yesʉ mwahambala athɨ: «Thatha, nyamahira omʉthɨma aye w'omo minwe awe.» Abere amamala ɨnegena ebyo mwatsa omʉthɨma.<note caller="+" style="f"><char style="fr" closed="false">23:46 </char><char style="xt" closed="false">Soma <ref loc="PSA 31:5-6">Saburi 31:5-6</ref>.</char></note><verse eid="LUK 23:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47" />Omʉkʉlʉ w'abashirikani <char style="w" lemma="Roma">w'aBaroma</char> abere alola ko byo bɨthatsʉka, mwasingya Gongo athɨ: «Kwenene, omʉndʉ oyu athalɨ mʉthʉnganene!»<verse eid="LUK 23:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 23:48" />Omuhindano w'abandʉ bo bahikaga ɨlola ko mwatsɨ oyu, babere bashʉnga ko byo bɨthatsʉka, mobashʉbʉla nɨabayɨbandanga ko bɨfʉba bʉshana n'obuliye. <verse eid="LUK 23:48" /><verse number="49" style="v" sid="LUK 23:49" />Abandʉ boshi bo babyaga betsi Yesʉ, n'abakatsɨ bo bamʉkwamaga ɨthoka iNgalilaya, mobimana hale nɨabayɨthegeretsya byo byagenda ebɨtsʉka.<verse eid="LUK 23:49" /></para>
  <para style="s">Yesʉ athabwa</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mat 27:57-61</ref>; <ref loc="MRK 15:42-47">Mar 15:42-47</ref>; <ref loc="JHN 19:38-42">Yoa 19:38-42</ref>)</para>
  <para style="p">
    <verse number="50-51" style="v" sid="LUK 23:50-51" />Aho, kwabyaga muyira mʉgʉma nɨanahʉlwamo Yosefʉ w'omo muyi w'iArimatea mo kɨhʉgo ky'iYuteya. Yosefʉ oyo abya mʉndʉ akwirire kandɨ nɨ mʉthʉnganene. Abyaga nɨ alindirire <char style="w" lemma="Bwamɨ bwa Gongo">oBwamɨ bwa Gongo</char> buhike. Kandɨ abyaga mʉgʉma w'oko <char style="w">Bʉshenge Bʉkʉlʉ</char> <char style="w" lemma="Bayuta">bw'aBayuta</char>. He ɨye athabyaga ahʉlɨkɨrɨrene na balikyabo mo nama y'eritha Yesʉ. <verse eid="LUK 23:50-51" /><verse number="52" style="v" sid="LUK 23:52" />Yosefʉ oyo mwagendera <char style="w">Pilato</char> bʉshana n'ɨmʉshaba ekinda kya Yesʉ. <verse eid="LUK 23:52" /><verse number="53" style="v" sid="LUK 23:53" />Aho Yosefʉ mwakimyakyo ko mʉsalaba. Honyuma kw'aho mwabʉngabʉngɨra kʉkyo ko lʉkɨmba n'iyahirakyo mw'ɨsɨnda lyathimawa mo lʉkʉka. Mw'ɨsɨnda eryo mwabyaga nɨ Mʉthahera mwathathabwa mʉndʉ. <verse eid="LUK 23:53" /><verse number="54" style="v" sid="LUK 23:54" />Ekɨro ekyo kyabyaga kɨro kya kathano <char style="w" lemma="Sabato">n'eSabato</char> yabyaga nɨ eyishondya ɨthangɨra.<verse eid="LUK 23:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55" />Abakatsɨ abo bahikaga na Yesʉ ɨthoka iNgalilaya, mobakwama Yosefʉ. Mobashʉnga kw'ɨsɨnda na mobashʉnga nga ko bahiraga ekinda kya Yesʉ ky'omo. <verse eid="LUK 23:55" /><verse number="56" style="v" sid="LUK 23:56" />Ko nduli mobashʉbʉla bʉshana na iyakomya mafʉtha na marasi w'ɨhaka ko kinda kya Yesʉ. Ekɨro <char style="w" lemma="Sabato">ky'eSabato</char> mobalʉhʉka nga ko Mʉgomba anegenire.<verse eid="LUK 23:56" /></para>
  <chapter eid="LUK 23" />
  <chapter number="24" style="c" sid="LUK 24" />
  <para style="s">Ilubuka lya Yesʉ</para>
  <para style="r">(<ref loc="MAT 28:1-10">Mat 28:1-10</ref>; <ref loc="MRK 16:1-8">Mar 16:1-8</ref>; <ref loc="JHN 20:1-10">Yoa 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1" />Mo yenga mo mambya abakatsɨ abo mobaya kw'ɨsɨnda nibahekire amafʉtha wo bengaga. <verse eid="LUK 24:1" /><verse number="2" style="v" sid="LUK 24:2" />Babere bahika okw'ɨsɨnda, mobeya eribwe lyo lyabyaga ko lukyo nilyamalire ɨkʉmbagalɨtsɨbwa emʉsɨke. <verse eid="LUK 24:2" /><verse number="3" style="v" sid="LUK 24:3" />Mobɨngɨra omw'ɨsɨnda, hewethuwe mobatheyamo ekinda kya Nyinya-kowethʉ Yesʉ. <verse eid="LUK 24:3" /><verse number="4" style="v" sid="LUK 24:4" />Ebɨnwa ebyo mobyaleka nɨbathabagana. Mw'ɨthabagana eryo, aho n'aho emʉsɨke kʉbo moyafʉmba bandʉ babɨrɨ bambithe ngɨmba singengire kʉtsɨbʉ. <verse eid="LUK 24:4" /><verse number="5" style="v" sid="LUK 24:5" />Aho bʉshana n'obʉba, abakatsɨ abo mobahuma amesho w'ahishi. He abandʉ abo mobabwɨrabo bathɨ: «Bʉshana na ki omʉshondetsya oyo ʉlɨho mo baholi? <verse eid="LUK 24:5" /><verse number="6" style="v" sid="LUK 24:6" />Athakɨrɨ hano, alubukire! Mwɨbʉke ekyo ababwɨraga abere akɨnalɨ iNgalilaya. <verse eid="LUK 24:6" /><verse number="7" style="v" sid="LUK 24:7" />Ndɨ mwababwɨra athɨ: “Ingye <char style="w">Mʉgala w'oMʉndʉ</char> lɨtholere ninyahirwa mo minwe y'abakoli b'ebɨtsɨbʉ. Bandanyɨbamba kʉ mʉsalaba, he mo kɨro kya kashathʉ enyuma y'erɨfwa lyaye nyandalubuka.”»<verse eid="LUK 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 24:8" />Aho abakatsɨ abo mobɨbʉka ebɨnwa byo Yesʉ anegenaga. <verse eid="LUK 24:8" /><verse number="9" style="v" sid="LUK 24:9" />Mobathoka kw'ɨsɨnda, mobayafʉlɨra ebyoshi ebyo byo abathʉmwa ikumi n'omʉgʉma n'abandɨ bɨga boshi. <verse eid="LUK 24:9" /><verse number="10" style="v" sid="LUK 24:10" />Bano bo bakatsɨ bayaga fʉlɨra <char style="w" lemma="Bathʉmwa">abathʉmwa</char> b'omwatsɨ: Marɨa w'ɨMangandala, na Yane na Marɨa nyinya wa Yakobo, n'abandɨ bakatsɨ bo babyaga nabo. <verse eid="LUK 24:10" /><verse number="11" style="v" sid="LUK 24:11" />Hewethuwe abathʉmwa mobashʉnga ebɨnwa by'abakatsɨ abo nga nɨ bya bʉsha-bʉsha, mobathɨkɨrɨtsyabyo.<verse eid="LUK 24:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 24:12" />He Petero ɨye mwabathʉka n'ihuthukira tsʉba eyɨrɨ erɨsɨnda. Abere ahikayo mwunama, mwashʉnga ko mɨpapara mɨsha. Honyuma kw'aho, mwashʉba ewe nɨashwekera byo bɨthatsʉka.<verse eid="LUK 24:12" /></para>
  <para style="s">Yesʉ ahʉlʉkɨra abɨga babɨrɨ mo nzɨra y'iEmau</para>
  <para style="r">(<ref loc="MRK 16:12-13">Mar 16:12-13</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13" />Hene ko mona kɨro ky'eyenga ekyo, babɨrɨ mo bɨga ba Yesʉ bagenda abaya mʉ mʉrongo mʉgʉma w'agenda ahʉlwamo Emau. Omʉrongo oyo abyaga kʉ lʉgendo lwa hofɨ bilometere ikumi na kɨgʉma n'omuyi w'ɨYerʉsalemʉ. <verse eid="LUK 24:13" /><verse number="14" style="v" sid="LUK 24:14" />Bagenda abagenda nɨabaganʉlɨra ko byoshi ebyo bɨthatsʉka. <verse eid="LUK 24:14" /><verse number="15" style="v" sid="LUK 24:15" />Babere banemʉsɨmola n'ikubisania, Yesʉ yowene-wene mwayɨfʉnda hofɨ nabo n'igendania nabo. <verse eid="LUK 24:15" /><verse number="16" style="v" sid="LUK 24:16" />Mobamʉshʉnga he kɨndʉ kɨrebe mokyaleka nɨbathamʉmɨnya.<verse eid="LUK 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 24:17" />Yesʉ mwabʉtsyabo athɨ: «Nɨ myatsɨ ehɨ y'omukubisaniako mʉlɨ omʉgenda?»</para>
  <para style="p" vid="LUK 24:17">Abɨga babɨrɨ abo mobimana nibathashagalukire. <verse eid="LUK 24:17" /><verse number="18" style="v" sid="LUK 24:18" />Mʉgʉma wa kʉbo nɨ yo Kiliopa, mwamʉshʉbɨtsya athɨ: «Abahimbani boshi b'ɨYerʉsalemʉ betsi emyatsɨ yo yɨtsʉkamo ko bɨro bɨno! Wowene wo uthanetsi emyatsɨ eyo?» <verse eid="LUK 24:18" /><verse number="19" style="v" sid="LUK 24:19" />Yesʉ mwabʉtsyabo athɨ: «Bɨhɨ ebyo?»</para>
  <para style="p" vid="LUK 24:19">Mobamʉshʉbɨtsya bathɨ: «Emyatsɨ yo yahikiraga Yesʉ w'iNasareti. Abyaga <char style="w" lemma="Mʉmɨnyeretsɨ">mʉmɨnyeretsɨ</char> wa maka, mw'ɨnegena na mw'ɨkola embere sa Gongo n'embere s'abandʉ boshi.<verse eid="LUK 24:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 24:20" />«<char style="w" lemma="Muheri">Abakʉlʉ b'abaheri</char> bethʉ n'abakʉlʉ bethʉ mobamuhanire asoherwe lʉholo. Na honyuma kw'aho mobamubambire ko mʉsalaba. <verse eid="LUK 24:20" /><verse number="21" style="v" sid="LUK 24:21" />Ithwe thwabyaga nithuhirire yo maha ko n'ɨye yo wandashabʉla <char style="w" lemma="Isiraeli">aBaisiraeli</char>. Hewethuwe munobwire nɨ kɨro kya kashathʉ ɨthoka ebɨnwa ebyo bikolekire. <verse eid="LUK 24:21" /><verse number="22" style="v" sid="LUK 24:22" />Na kandɨ bakatsɨ bagʉma b'omo kɨkembe kyethʉ mobathʉshwekya. Mobatsɨndʉka kw'ɨsɨnda, <verse eid="LUK 24:22" /><verse number="23" style="v" sid="LUK 24:23" />hewethuwe mobathalɨ abeyayo ekinda kɨwe. Mobashʉbʉla n'ɨthʉfʉlɨra omwatsɨ ko <char style="w" lemma="Malaɨka">abamalaɨka</char> mobahʉlʉkɨrabo n'ɨbwɨrabo ko alɨho. <verse eid="LUK 24:23" /><verse number="24" style="v" sid="LUK 24:24" />Honyuma kw'aho bagʉma ba kw'ithwe nabo mobaya kw'ɨsɨnda, mobeya ebyoshi ng'oko abakatsɨ bathanegena. Nabo kuthyo mobathalɨ abashʉnga ko kinda kɨwe.»<verse eid="LUK 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25" />Aho Yesʉ mwabwɨrabo athɨ: «Imwe thʉhʉmo! N'emɨthɨma enyu ɨthalɨ eyɨnɨkɨrɨtsya tsʉba emyatsɨ yoshi yo <char style="w" lemma="Mʉmɨnyeretsɨ">abamɨnyeretsɨ</char> banegenaga! <verse eid="LUK 24:25" /><verse number="26" style="v" sid="LUK 24:26" />Bithabyaga bɨtholere <char style="w" lemma="Kirisito, Masia">Kirisito</char> athange ɨagalwa athyo embere ɨngɨre mo lʉkengerwa lʉwe?» <verse eid="LUK 24:26" /><verse number="27" style="v" sid="LUK 24:27" />Honyuma kw'aho Yesʉ mwakumbulirabo ebɨnwa byoshi bishakirwe kw'ɨye mo <char style="w">Mashako Abuyirire</char> woshi. Mwathangɨra ko bɨtabo bya Mʉsa n'ebɨtabo byoshi <char style="w" lemma="Mʉmɨnyeretsɨ">by'abamɨnyeretsɨ</char>.<verse eid="LUK 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28" />Babere bahika hofɨ n'omʉrongo wo bagenda abayako, Yesʉ mwashʉngɨka nga mʉndʉ ashondya ɨlotsya ebʉshondotsɨ. <verse eid="LUK 24:28" /><verse number="29" style="v" sid="LUK 24:29" />Hewethuwe abɨga mobamʉshaba kʉtsɨbʉ bathɨ: «Bya hagʉma nethwe, kʉshangwa bwahera igolo n'obuthuku bo bʉno bwamakʉra.»</para>
  <para style="p" vid="LUK 24:29">Aho mwɨngɨra mo nyʉmba bʉshana abye hagʉma nabo. <verse eid="LUK 24:29" /><verse number="30" style="v" sid="LUK 24:30" />Mwikala alye kalyo hagʉma nabo, mwatsɨmba omukati, n'ɨsɨma Gongo, honyuma kw'aho mwatsawo, n'ɨhawobo. <verse eid="LUK 24:30" /><verse number="31" style="v" sid="LUK 24:31" />Aho amesho wabo mwakɨngʉkala mobamʉmɨnya. He Yesʉ mwaliribana embere sabo. <verse eid="LUK 24:31" /><verse number="32" style="v" sid="LUK 24:32" />Aho mobabwɨrana bathɨ: «Athabere alɨ anegena nethwe mo nzɨra n'ithukumbulira <char style="w" lemma="Mashako Abuyirire">aMashako Abuyirire</char>, emɨthɨma ethʉ mo yɨthalɨ eyotsulamo lʉmogo?»<verse eid="LUK 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 24:33" />Kona kathambi ako mobabathʉka n'ɨshʉba ɨYerʉsalemʉ. Mobeyayo abathʉmwa ikumi n'omʉgʉma ba Yesʉ nɨbalɨ mʉ muhindo hagʉma n'abo mo kɨkembe kyabo. <verse eid="LUK 24:33" /><verse number="34" style="v" sid="LUK 24:34" />Abo babyaga mo muhindano mobabwɨra <char style="w">abɨga</char> babɨrɨ abo bathɨ: «Kundu kundu Nyinya-kowethʉ alubukire! Mwahʉlʉkɨra Simoni!»<verse eid="LUK 24:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 24:35" />
    <char style="w">Abɨga</char> babɨrɨ abo mobaganʉlɨra balikyabo byo bɨthatsʉka mo nzɨra, na ko bathamɨnya Yesʉ athabere atsa omukati.<verse eid="LUK 24:35" /></para>
  <para style="s">Yesʉ ahʉlʉkɨra abɨga bʉwe</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mat 28:16-20</ref>; <ref loc="MRK 16:14-18">Mar 16:14-18</ref>; <ref loc="JHN 20:19-23">Yoa 20:19-23</ref>; <ref loc="ACT 1:6-8">Mɨko 1:6-8</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36" />
    <char style="w">Abɨga</char> babɨrɨ abo babere bakɨnalɨ abasɨmola kw'ebyo, Yesʉ yowene-wene mwahʉlʉka mo kathi kabo. Mwabwɨrabo athɨ: «Obʉholo bubye nemwe!»<verse eid="LUK 24:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37" />Mobashalima n'ɨʉbaha kʉtsɨbʉ, kʉshangwa mobaganɨtsya bathɨ bamalola kʉ kɨhɨndɨ. <verse eid="LUK 24:37" /><verse number="38" style="v" sid="LUK 24:38" />Hewethuwe Yesʉ mwabʉtsyabo athɨ: «Bʉshana na ki omushalima? Kandɨ bʉshana na ki omʉthɨkathɨka mo mɨthɨma enyu? <verse eid="LUK 24:38" /><verse number="39" style="v" sid="LUK 24:39" />Mʉshʉnge ko minwe n'oko bɨshando byaye, n'ingye ngyo wene-wene! Mʉnyɨkoleko na mʉlole, ekɨhɨndɨ kɨthayɨra mʉbɨrɨ kandɨ kɨthayɨra na mafʉha. H'ingye omʉshʉnga ng'oko nyiwithebyo.»<verse eid="LUK 24:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 24:40" />Yesʉ abere anemʉnegena ebɨnwa ebyo mwakangyabo eminwe yɨwe n'ebɨshando bɨwe. <verse eid="LUK 24:40" /><verse number="41" style="v" sid="LUK 24:41" /><char style="w">Abɨga</char> abo babyaga nibathetsi bɨkɨrɨtsya bʉshana n'olʉmogo n'ɨshweka. Aho Yesʉ mwabʉtsyabo athɨ: «Munawithe hano ho kʉ kalyo?»<verse eid="LUK 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 24:42" />Mobamʉha kɨtse k'ihere kyokitsye. <verse eid="LUK 24:42" /><verse number="43" style="v" sid="LUK 24:43" />Mwatsɨmbakyo n'iryakyo mo mesho wabo. <verse eid="LUK 24:43" /><verse number="44" style="v" sid="LUK 24:44" />Aho mwabwɨrabo athɨ: «Ko bɨro nyabyaga nyɨkɨnalɨ hagʉma nemwe monyababwɨra nyɨthɨ ebishakirwe bʉshana nangye mo <char style="w">Mʉgomba</char> wa Mʉsa, n'omo bɨtabo <char style="w" lemma="Mʉmɨnyeretsɨ">by'abamɨnyeretsɨ</char> na mo kɨtabo kya Saburi ebyoshi byangabererere.» <verse eid="LUK 24:44" /><verse number="45" style="v" sid="LUK 24:45" />Aho Yesʉ mwakɨngʉla obwenge bwabo, bʉshana bamɨnye kʉbʉya <char style="w" lemma="Mashako Abuyirire">kw'aMashako Abuyirire</char> anegenire. <verse eid="LUK 24:45" /><verse number="46" style="v" sid="LUK 24:46" />Mwabwɨrabo athɨ: «Bishakirwe ko <char style="w" lemma="Kirisito, Masia">Kirisito</char> atholere ɨgalwa n'ilubuka ko kɨro kya kashathʉ enyuma y'olʉholo lʉwe.<note caller="+" style="f"><char style="fr" closed="false">24:46 </char><char style="xt" closed="false">Soma <ref loc="ISA 53">Isaya 53</ref>; <ref loc="HOS 6:2">Oseya 6:2</ref>.</char></note> <verse eid="LUK 24:46" /><verse number="47" style="v" sid="LUK 24:47" />Na omw'ɨtsɨna lɨwe bandakangɨrɨtsya abandʉ boshi ɨbɨndʉka ɨthoka mo bɨtsɨbʉ byabo bʉshana n'ɨganyɨrwako ebɨtsɨbʉ, ɨthangɨra ɨYerʉsalemʉ. <verse eid="LUK 24:47" /><verse number="48" style="v" sid="LUK 24:48" />Nemwe mʉlɨ batimo b'ebɨnwa ebi. <verse eid="LUK 24:48" /><verse number="49" style="v" sid="LUK 24:49" />Mwonvwe! Nyandabathʉmɨra ebyo Thatha abalagaga. He mwandabya mo muyi w'ɨYerʉsalemʉ ihika ko ndambi mwandabona amaka ow'athoka elʉgʉlʉ.<note caller="+" style="f"><char style="fr" closed="false">24:49 </char><char style="xt" closed="false">Soma <ref loc="ACT 1:4-5">Mɨkolano 1:4-5</ref>.</char></note>»<verse eid="LUK 24:49" /></para>
  <para style="s">Yesʉ irukibwa mo lʉbʉla</para>
  <para style="r">(<ref loc="MRK 16:19-20">Mar 16:19-20</ref>; <ref loc="ACT 1:9-11">Mɨko 1:9-11</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50" />Honyuma kw'aho Yesʉ mwathwala <char style="w">abɨga</char> bʉwe hofɨ n'omʉrongo w'ɨBetanɨa. Mwashʉmba eminwe n'ɨgashanɨrabo. <verse eid="LUK 24:50" /><verse number="51" style="v" sid="LUK 24:51" />Abere akɨnalɨ agashanɨrabo, mwayɨhɨgʉla kʉbo n'irukibwa mo lʉbʉla.<figure style="fig" alt="Jesus monte au ciel" file="WA03935b.tif" size="span" copy="Graham Wade" ref="24:51">Yesʉ irukibwa mo lʉbʉla</figure> <verse eid="LUK 24:51" /><verse number="52" style="v" sid="LUK 24:52" />Na mobamuramya. Honyuma kw'aho mobashʉba ɨYerʉsalemʉ nibamogire kʉtsɨbʉ. <verse eid="LUK 24:52" /><verse number="53" style="v" sid="LUK 24:53" />Ebɨro byoshi babyaga mo <char style="w">Nyʉmba ya Gongo</char> niabamusingya.<verse eid="LUK 24:53" /></para>
  <chapter eid="LUK 24" />
</usx>