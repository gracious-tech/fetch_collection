<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id">w */A ç MƗK Mɨkolano</book>
  <para style="h">Mɨkolano</para>
  <para style="toc3">Mɨko</para>
  <para style="toc2">Mɨkolano</para>
  <para style="toc1">Mɨkolano y'aBathʉmwa</para>
  <para style="mt1">Mɨkolano</para>
  <para style="mt2">y'aBathʉmwa</para>
  <para style="is">Ekyɨngɨrɨro</para>
  <para style="ip">Omushaki w'ekɨtabo ky'eMɨkolano y'aBathʉmwa nɨ Luka. Kandɨ n'ɨye yo washakaga ekɨtabo ky'eNgʉlʉ Mbʉya nga ko yashakawa na Luka. Luka athabyaga Muyuta. Agenda athamba hagʉma n'omʉthʉmwa Polo mʉ ngendo sɨwe nyɨngɨ alɨ akangɨrɨtsya eNgʉlʉ Mbʉya ya Yesʉ Kirisito (<char style="xt">soma <ref loc="COL 4:10-14">Banyakolosayi 4:10-14</ref></char>). Polo anegena athɨ Luka abyaga mʉgʉma w'oko bakoli bo bagenda abamuwathikya (<char style="xt">soma <ref loc="2TI 4:11">2Timote 4:11</ref>; Filemo24</char>.) Kandɨ Luka oyo abyaga mʉshake (<char style="xt">soma <ref loc="COL 4:14">Banyakolosayi 4:14</ref></char>).</para>
  <para style="ip">Luka ashakaga ekɨtabo ky'eMɨkolano y'aBathʉmwa mo kathi-kathi k'emɨaka makumi ndathʉ ihika kʉ makumi ndathʉ n'ine, enyuma y'erɨbʉthwa lya Yesʉ Kirisito. Mo mʉgʉlʉ oyo abyaga hagʉma na Polo mo muyi w'ɨRoma. Alɨnga Luka ashakaga ekɨtabo ekyo mo mɨaka eyo, kʉshangwa mokyahwa embere Polo amale ebɨro bɨwe by'omuliki.</para>
  <para style="ip">Luka mwashaka ekɨtabo ky'<char style="bk">eNgʉlʉ Mbʉya nga ko yashakawa na Luka</char> hagʉma n'ekɨtabo ky'eMɨkolano y'aBathʉmwa ho wa mʉndʉ mʉgʉma yo wahʉlawamo Teofili. Ashakɨra Teofili, n'ɨmwahʉlamo mʉkengwa (<char style="xt">soma <ref loc="LUK 1:3">Luka 1:3</ref></char>.) Teofili oyo, abengenge bangɨ b'eBibiria abaganɨtsya bathɨ abyaga mʉgʉma w'oko bakʉlʉ b'aBaroma bo bashabʉlawa. Na mo Luka anashakɨraga Teofili, abengenge bangɨ mobaganɨtsya bathɨ Luka abyaga na maha ko abɨkɨrɨtsya boshi b'aBayuta na b'abandʉ b'ebɨhanda bagende abasoma ebɨtabo ebyo.</para>
  <para style="ip">Ekɨtabo ky'eMɨkolano y'aBathʉmwa kɨkwamɨrɨrene n'ekɨtabo ky'eNgʉlʉ Mbʉya nga ko yashakawa na Luka (<char style="xt">soma <ref loc="ACT 1:1-2">Mɨkolano 1:1-2</ref></char>.) Endangɨro yakyo nɨ ho hahwerere ekɨtabo ky'eNgʉlʉ Mbʉya ya Luka. Mo kɨtabo ky'eMɨkolano y'aBathʉmwa, Luka asɨmola ko bɨndʉ bɨbʉyahanga ebyo ashʉngaga ko ndangɨro y'ekanisa kambere. Erithegekania lɨwe lyabyaga ikangania nga ko Gongo athambaya eNgʉlʉ Mbʉya ya Yesʉ Kirisito, na nga ko akulaya n'ɨgashanɨra akanisa kw'ɨtsʉkɨra emɨrɨmo y'oMʉthɨma Mwerʉ.</para>
  <para style="iot">Ebyo bɨrɨmo</para>
  <para style="io1">1. Ɨfʉla eNgʉlʉ Mbʉya mo muyi w'ɨYerʉsalemʉ (2:1–8:3)</para>
  <para style="io1">2. Ɨfʉla eNgʉlʉ Mbʉya mo kɨhʉgo ky'iYuteya na eky'ɨSamarɨa (8:4–12:25)</para>
  <para style="io1">3. Mʉlɨmo w'omʉthʉmwa Polo (13:1–28:31)</para>
  <para style="io2">a. Lʉgendo lʉmbere lw'erɨfʉla eNgʉlʉ Mbʉya (13:1–14:28)</para>
  <para style="io2">b. Muhindano w'omo muyi w'ɨYerʉsalemʉ (15:1-35)</para>
  <para style="io2">c. Lʉgendo lwa kabɨrɨ lw'erɨfʉla eNgʉlʉ Mbʉya (15:36–18:23)</para>
  <para style="io2">d. Lʉgendo lwa kashathʉ lw'erɨfʉla eNgʉlʉ Mbʉya (18:24–21:16)</para>
  <para style="io2">e. Polo nga mʉndʉ wa muliki mo muyi w'ɨYerʉsalemʉ, iKaisaria n'ɨRoma (21:17–28:31)</para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="s">Erɨlawa ly'oMʉthɨma Mwerʉ ko bathʉmwa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />Mʉkengwa Teofili, mo kɨtabo kyaye kɨmbere,<note caller="+" style="f"><char style="fr" closed="false">1:1</char><char style="fq" closed="false">Ekɨtabo kyaye kɨmbere </char><char style="ft" closed="false">nɨ eNgʉlʉ Mbʉya nga ko yashakawa na Luka. Kandɨ nɨ Luka yo washakaga ekɨtabo ky'eMɨkolano y'aBathʉmwa. </char><char style="xt" closed="false">Soma <ref loc="LUK 1:1-4">Luka 1:1-4</ref>.</char></note> monyashaka ebyoshi byo Yesʉ akolaga n'ebyo akangɨrɨtsaya, ɨthoka ko ndambi athangaga omʉlɨmo ʉwe, <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />n'ihika ko kɨro irukibawa mo lʉbʉla. Embere irukibwe, mwahana <char style="w" lemma="Mathegeko">amathegeko</char> ʉwe ko maka <char style="w" lemma="Mʉthɨma Mwerʉ">w'oMʉthɨma Mwerʉ</char> ko <char style="w">bathʉmwa</char> bʉwe ashombolaga. <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />Aho, enyuma y'olʉholo lʉwe, mwayikangania kʉbo mʉ mɨhanda mɨngɨ bamɨnye kw'alɨho. Mʉ bɨro makumi ane, mwagenda ahʉlʉkɨrabo n'ɨsɨmolerabo ko <char style="w">Bwamɨ bwa Gongo</char>.<verse eid="ACT 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 1:4" />Kɨro kɨgʉma agenda alya hagʉma nabo, mwahamʉlabo athɨ: «Mʉthathokaga kʉ Yerʉsalemʉ, hewethuwe mʉlɨndɨrɨreko kyo Thatha abalagaga, olʉhembo lo nyababwɨraga. <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />Kʉshangwa Yoani <char style="w" lemma="Lubatiso">mwabatisya</char> mʉ metsi, he imwe, mʉ bɨro bɨke, <char style="w" lemma="Lubatiso">mwabatisibwa</char> <char style="w" lemma="Mʉthɨma Mwerʉ">mʉ Mʉthɨma Mwerʉ</char>.»<verse eid="ACT 1:5" /></para>
  <para style="s">Yesʉ irukibwa mo lʉbʉla</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />Aho abathʉmwa babere bahindana na Yesʉ mobamʉbʉtsya bathɨ: «Nyinya-kowethʉ, nɨmo bɨro bɨno mo washʉbʉlɨtsya <char style="w" lemma="Isiraeli">aBaisiraeli</char> b'obwamɨ bwabo?» <verse eid="ACT 1:6" /><verse number="7" style="v" sid="ACT 1:7" />Yesʉ mwashʉbɨtsyabo athɨ: «Erɨmɨnya endambi n'omʉgʉlʉ bithabalebitsye, kʉshangwa Thatha mwahirabyo mo maka ʉwe masha. <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />Hewethuwe mwandabona kagala omʉgʉlʉ <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> andabakimirako. Aho mwandabya batimo baye ɨYerʉsalemʉ, na mo kɨhʉgo kyoshi ky'iYuteya na ky'ɨSamarɨa, n'ihika ho kɨhʉgo kinika.»<verse eid="ACT 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 1:9" />Yesʉ abere amamala ɨnegena ebɨnwa ebyo, mwirukibwa elʉbʉla nabo nibanamuhandireko amesho. Honyuma kw'aho ekɨfʉ mokyamubisha na mobathashʉba mʉlolako. <verse eid="ACT 1:9" /><verse number="10" style="v" sid="ACT 1:10" />Babyaga nibakinahandire amesho mo lʉbʉla eyo Yesʉ agenda ɨrʉkɨra, aho n'aho bandʉ babɨrɨ bambithe ngɨmba sa mʉshohe mobabʉthʉka hofɨ nabo <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />n'ɨbwɨrabo bathɨ: «Imwe bandʉ b'iNgalilaya, bʉshana na ki mʉlɨ hano mʉlɨ omʉlola mo kyanya? Yesʉ oyu, yo uthathokibwa mo kathi kenyu n'ɨya mo lʉbʉla, andashʉbʉla nga ko mʉthamʉshʉnga alɨ ayayo.»<verse eid="ACT 1:11" /></para>
  <para style="s">Matiasi ashombolwa abye mo mwanya wa Yuta</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />Aho abathʉmwa mobashʉba ɨYerʉsalemʉ ɨthoka ko kɨthwa kyo kɨnahʉlwamo kɨthwa ky'eMiseituni. Ekɨthwa ekyo kɨrɨ hofɨ n'omuyi w'ɨYerʉsalemʉ, hofɨ lʉgendo lwa kilometere kɨgʉma. <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />Babere bahika ɨYerʉsalemʉ, mobɨrʉkɨra mo kɨshenge kyo kyabyaga mo ngorofa, kyo babyaga babegere ikalamo. Bano bo babyaga mo kɨshenge ekyo: Petero na Yoani na Yakobo na Ndereya na Filipo na Tomasɨ na Barɨtolomayo na Matayo na Yakobo mʉgala wa Alʉfayo na Simoni w'omo kɨkembe ky'aBaselote<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="fq" closed="false">aBaselote </char><char style="ft" closed="false">kyabyaga kɨkembe ky'aBayuta bo babyaga babagire obuthegeki bw'aBaroma. </char></note> na Yuta mʉgala wa Yakobo. <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />Aboshi hagʉma bagenda abahindana kangɨ kangɨ bʉshana n'ɨshaba, hagʉma na bakatsɨ balebe na hagʉma na Marɨa nyinya wa Yesʉ na hagʉma n'abagala babo Yesʉ.<verse eid="ACT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />Kɨro kɨgʉma mo bɨro ebyo, omuhindano w'abɨkɨrɨtsya abyaga mʉ mɨganzo ya bandʉ hofɨ igana na makumi abɨrɨ. Aho Petero mwimana mo kathi kabo n'ɨbwɨrabo athɨ: <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />«Bagala bethʉ, bɨthatholere nɨbyabererera ebyo <char style="w">oMʉthɨma Mwerʉ</char> anegenaga mo <char style="w">Mashako Abuyirire</char> mo bʉnʉ bwa <char style="w">Tawiti</char>, bʉshana na Yuta yo washondoleraga abo batsɨmbaga Yesʉ.<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="xt" closed="false">Soma <ref loc="PSA 41:9-10">Saburi 41:9-10</ref>. </char></note> <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />Yuta abyaga mʉgʉma wa kw'ithwe, na mothwakola hagʉma naye mo mʉlɨmo.» <verse eid="ACT 1:17" /><verse number="18" style="v" sid="ACT 1:18" />Esofaranga Yuta ahabawa ko bʉbɨ akolaga, mwagʉla kʉtho kw'ɨshwa. Na aho mwathoga n'ɨthanga omuthwe w'ahishi, n'omʉbɨrɨ ʉwe mwabereka, n'ebɨshalɨ byoshi mobyashesheka. <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />Abahimbani boshi b'ɨYerʉsalemʉ mobonvwa omwatsɨ oyo, mobahika ko kɨka ky'erɨlʉka erɨshwa eryo mo «Akelitama», mo mʉnegene wabo n'ɨnegena mbʉ: «Ɨshwa lya Mʉsasɨ».<verse eid="ACT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20" />Petero mwashʉba negena athɨ: «Ewo shʉnga ebishakire mo kɨtabo kya Saburi kɨthɨ:</para>
  <para style="q1" vid="ACT 1:20">“Enyʉmba yɨwe ibye kihuma,</para>
  <para style="q1" vid="ACT 1:20">na ɨthandashʉba ikalamo mʉndʉ.”</para>
  <para style="m" vid="ACT 1:20">Na kandɨ kushakirwe kʉthɨ:</para>
  <para style="q1" vid="ACT 1:20">“Ʉndɨ mʉndʉ abye mo mwanya ʉwe.<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="xt" closed="false">Soma <ref loc="PSA 69:26-27">Saburi 69:26-27</ref>; <ref loc="PSA 109:8">109:8</ref>.</char></note>”<verse eid="ACT 1:20" /></para>
  <para style="m">
    <verse number="21-22" style="v" sid="ACT 1:21-22" />Aho bɨtholere mʉndʉ mʉgʉma wa ko bo babyaga hagʉma nethwe ɨthanga ko ndambi yo Yoani <char style="w" lemma="Lubatiso">abatisaya</char> Yesʉ, n'ihika ko kɨro irukibawa ɨthoka mo kathi k'ethʉ kw'ɨya mo lʉbʉla, abye mutimo hagʉma nethwe w'erilubuka lya Nyinya-kowethʉ Yesʉ.»<verse eid="ACT 1:21-22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />Aho mobahʉla bandʉ babɨrɨ: ye Yosefʉ yo wahʉlawamo Barisaba kandɨ yo walʉkawamo Yusito, na Matiasi. <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />Honyuma kw'aho omuhindano mwashaba omʉshabe ono: «Nyinya-kowethʉ, ɨwe wetsi emɨthɨma y'abandʉ boshi. Thukangye oyo wamashombola mo babɨrɨ aba, <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />bʉshana abye mo mwanya w'obʉthʉmwa bo Yuta athathokamo n'ɨya ahandʉ hʉwe ahamʉtholere.» <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />Aho mobakola bwɨkɨ, n'obwɨkɨ obo mobwahʉla Matiasi, yo w'ongererawa ko <char style="w">bathʉmwa</char> ikumi n'omʉgʉma.<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s">Erikima ly'oMʉthɨma Mwerʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />Ekɨro ky'ePentekosite kyabere kyahika, abɨkɨrɨtsya boshi babyaga nibahindene hagʉma. <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />Aho n'aho lʉkanda molwathoka mo lʉbʉla, nɨlʉlɨ nga kɨhʉnga kɨtsɨbʉ ekɨbʉhɨrɨra, na mokyotsutsya enyʉmba yoshi yo babyaga bikeremo. <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />Aho mobashʉnga ko kwamahʉlʉka so ndɨmɨ sɨrɨnga ndɨmɨ sa mʉtsanwa, mosagabana n'ikira ko bʉlɨ mʉgʉma wa kʉbo. <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />Aboshi mobotsutsibwa n'<char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> na mobathanga ɨnegena mo yɨndɨ mɨnegene, ɨkwamana n'ebyo <char style="w">Mʉthɨma Mwerʉ</char> ahagabo obuthoki bw'erɨnegena.<figure style="fig" alt="Le St Esprit descend sur les apotres" file="cn01890.jpg" size="col" ref="2:3-4">oMʉthɨma Mwerʉ akimira ko bɨkɨrɨtsya</figure><verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />ɨYerʉsalemʉ yabyaga niyikere <char style="w">Bayuta</char> bo babyaga bashikitsye Gongo, bo bathokaga mo bɨhʉgo byoshi. <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />Olʉkanda olo lwabere lw'onvwɨka, bandʉ bangɨ mobahindana. Aboshi mobashishala kʉtsɨbʉ, kʉshangwa obʉlɨ mʉndʉ mʉbo agendaga onvwa abɨkɨrɨtsya nɨabanegena mo mʉnegene ʉwe. <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />Mobashweka n'ishishala kʉtsɨbʉ nɨabanegena bathɨ: «Abandʉ bo banegena aba, aboshi bathalɨ bandʉ b'iNgalilaya? <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />Aho bɨthokekene bɨthɨ obʉlɨ mʉndʉ mw'ithwe onvwabo mo mʉnegene ʉwe? <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />Mw'ithwe mʉlɨ bobathoka mo kɨhʉgo ky'aBapariti, na ky'aBameti na ky'aBaelamʉ. Halɨ na bandʉ b'ekɨhʉgo ky'ɨMesopotamɨa na ky'iYuteya na ky'iKapatokia na ky'ɨPonto na ky'iAsia, <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />na ky'iFurikia na ky'iPamufilia na ky'iMisiri na b'omo kɨhʉgo ky'iLibia mo ndambɨ-ndambɨ y'omuyi w'iKurene, n'abandɨ bobathokaga mo muyi <char style="w" lemma="Roma">w'ɨRoma</char>, <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />n'ekɨhʉgo ky'ɨKɨrete na eky'iArabia, bagʉma babʉthawamo <char style="w">Bayuta</char>, n'abandɨ babɨndʉkɨraga mo kɨsomo <char style="w" lemma="Bayuta">ky'aBayuta</char>. Naho othwonvwabo balɨ abanegena mo mɨnegene ethʉ ebɨnwa by'amaka wa Gongo!» <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />Aboshi mobashishala kʉtsɨbʉ nibathakyetsi kyo bangaganɨtsya, bagenda ababwɨrana bagʉma kʉ bandɨ bathɨ: «Ebyo binegenire bithi ki?» <verse eid="ACT 2:12" /><verse number="13" style="v" sid="ACT 2:13" />Hewethuwe abandɨ bagenda abashekeretsya abɨkɨrɨtsya bathɨ: «Bakundire tifayi yo kʉtsɨbʉ!»<verse eid="ACT 2:13" /></para>
  <para style="s">Makangɨrɨtsya wa Petero</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />Aho Petero mwimana hagʉma n'abandɨ bathʉmwa ikumi n'omʉgʉma, mwahambala mʉ mʉlenge mʉnene n'ɨbwɨra omuhindano athɨ: «Imwe <char style="w">Bayuta</char> nemwe bandʉ boshi b'ɨYerʉsalemʉ, mʉhʉlɨkɨrɨtsye kʉbʉya ebɨnwa byaye na mwonvwe kʉbʉya byo bɨtsʉka. <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />Abandʉ aba bathakundire nga ko mʉganɨtsya, kʉshangwa bʉkɨne saha ishathu sa mʉ makera-kera. <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />Hewethuwe lɨno eby'<char style="w" lemma="Mʉmɨnyeretsɨ">omʉmɨnyeretsɨ</char> Yoeli anegenaga byamabererera:<verse eid="ACT 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17" />“Gongo anegena athɨ:</para>
  <para style="q1" vid="ACT 2:17">‘Bɨno byo byandabya ko bɨro by'enduli:</para>
  <para style="q1" vid="ACT 2:17">Nyandafʉbʉlɨra <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma</char> aye w'oko bandʉ boshi,</para>
  <para style="q1" vid="ACT 2:17">abatsana benyu n'abathasha benyu bandamɨnyerera,</para>
  <para style="q1" vid="ACT 2:17">n'abasole benyu bandashʉnga humanani,</para>
  <para style="q1" vid="ACT 2:17">n'abashyakʉlʉ benyu bandalotha bɨlotho.<verse eid="ACT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18" />Ega, ebɨro ebyo nyandafʉbʉlɨra <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma</char> aye w'oko bakoli baye,</para>
  <para style="q1" vid="ACT 2:18">abayira n'abakatsɨ,</para>
  <para style="q1" vid="ACT 2:18">nabo bandamɨnyerera.<verse eid="ACT 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19" />Nyandabukya bɨthɨko-thɨko mo kyanya mw'elʉgʉlʉ</para>
  <para style="q1" vid="ACT 2:19">na bɨmɨnyɨkalo hano ishi.</para>
  <para style="q1" vid="ACT 2:19">Kwandabya mʉsasɨ, na mʉtsanwa na bɨfʉ bya muki.<verse eid="ACT 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ACT 2:20" />Erɨtsʉba lyandahɨndʉlwamo mwitsimya</para>
  <para style="q1" vid="ACT 2:20">n'omʉgenda andahɨndʉka ngʉla nga mʉsasɨ,</para>
  <para style="q1" vid="ACT 2:20">embere ekɨro kya Nyinya-kowethʉ kihike,</para>
  <para style="q1" vid="ACT 2:20">ekɨro kɨkʉlʉ na ky'olʉkengerwa.<verse eid="ACT 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21" />Aho obʉlɨ mʉndʉ yo wandalaka kw'ɨtsɨna lya Nyinya-kowethʉ andashabʉlwa.<note caller="+" style="f"><char style="fr" closed="false">2:17-21 </char><char style="xt" closed="false">Soma <ref loc="JOL 3:1-5">Yoeli 3:1-5</ref> </char><char style="ft" closed="false">kʉtse Yoeli 2:28-32.</char></note>’”<verse eid="ACT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />«Imwe bandʉ <char style="w" lemma="Isiraeli">b'iIsiraeli</char>, mʉhʉlɨkɨrɨtsye ebyo nyababwɨra: Yesʉ w'iNasareti abyaga mʉndʉ yo Gongo abakangayamo amaka ʉwe, mw'ɨbereretsya emɨhanda yoshi y'emɨkolano ya maka, na y'ebɨthɨko-thɨko, n'eyebɨmɨnyɨkalo mw'ɨtsʉkɨra mʉ Yesʉ mo kathi kenyu, nga ko munetsi imwe bene-bene. <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />Omʉndʉ oyu mwahirwa mo minwe enyu ɨkwamana na ko Gongo abyaga nietsi n'ebyo athangaga ithegekania. Nemwe momwamwithire mw'imumikira abakoli b'ebɨtsɨbʉ bamʉbambe ko mʉsalaba. <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />Hewethuwe Gongo mwamulubukya, mwamulamya ko magali w'olʉholo, kʉshangwa byabyaga nɨbɨthathokekene olʉholo lʉmʉtsɨmbɨrɨre mo maka walo. <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />Kʉshangwa <char style="w">Tawiti</char> mwanegena ko bimulebitsye athɨ:</para>
  <para style="q1" vid="ACT 2:25">“Nyagenda enyɨshʉnga Nyinya-kowethʉ lʉgʉmerera embere saye.</para>
  <para style="q1" vid="ACT 2:25">Alɨ ko lʉnda lwaye lw'amalyo kʉshangwa nyithathithimanaga.<verse eid="ACT 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26" />Nɨ bʉshana n'ekyo omʉthɨma aye amogire kʉtsɨbʉ</para>
  <para style="q1" vid="ACT 2:26">n'ebɨnwa byaye byotswiremo lʉmogo,</para>
  <para style="q1" vid="ACT 2:26">n'omʉbɨrɨ aye nawo andalʉhʉka mo maha.<verse eid="ACT 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27" />Kʉshangwa Nyinya-kowethʉ, uthindanyimike kw'ɨrʉnga,</para>
  <para style="q1" vid="ACT 2:27">ʉthɨndatsɨge ingye <char style="w">mubuyirire</char> awe nyɨbolere mw'ɨsɨnda.<verse eid="ACT 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28" />Mowanyikangya so nzɨra so sihikya ko bʉyɨngo,</para>
  <para style="q1" vid="ACT 2:28">wandanyotsutsyamo lʉmogo mw'ibya hagʉma nangye.<note caller="+" style="f"><char style="fr" closed="false">2:25-28 </char><char style="xt" closed="false">Soma <ref loc="PSA 16:8-11">Saburi 16:8-11</ref>.</char></note>”<verse eid="ACT 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />«Bagala bethʉ, bɨtholere nɨnyababwɨra kʉbʉya-kʉbʉya ko bɨnwa byahikiraga thatha-kʉlʉ <char style="w">Tawiti</char>: mwafwa na mwathabwa n'erɨsɨnda lɨwe lɨnalɨ kʉno wethʉ ihika munobwire. <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />Hewethuwe abyaga <char style="w" lemma="Mʉmɨnyeretsɨ">mʉmɨnyeretsɨ</char> kandɨ abyaga nietsi Gongo ko mwamʉlaga mw'ɨlahɨtsya ko mʉgʉma w'omo kɨhanda kɨwe andikala ko lʉthebe lʉwe lw'eryamɨ. <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />Tawiti, bʉshana n'ɨshʉnga ko byo byandahika embere, mwasɨmola kw'ilubuka lya <char style="w" lemma="Kirisito, Masia">Kirisito</char> abere anegena athɨ:</para>
  <para style="q1" vid="ACT 2:31">“Mwathamikwa kw'ɨrʉnga,</para>
  <para style="q1" vid="ACT 2:31">n'omʉbɨrɨ ʉwe mwathabolera mw'ɨsɨnda.”<verse eid="ACT 2:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="ACT 2:32" />Gongo mwalubukya Yesʉ oyo ɨthoka mo baholi, nethwe boshi thʉlɨ batimo bo mwatsɨ oyu. <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />Mwirukibwa n'iyikala ko malyo wa Gongo na mwabona ɨthoka ewa Thatha <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> yo walagawa, na mwamʉfʉbʉlɨra kw'ithwe, nɨ ebyo omʉshʉngako n'ɨonvwa lɨno. <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />Kʉshangwa <char style="w">Tawiti</char> yowene-wene mwathɨrʉkɨra elʉbʉla, hewethuwe mwanegena athɨ:</para>
  <para style="q1" vid="ACT 2:34">“Nyinya-kowethʉ Gongo mwabwɨra Nyinya-kowethʉ athɨ:</para>
  <para style="q1" vid="ACT 2:34">‘Ikala ko malyo aye,<verse eid="ACT 2:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ACT 2:35" />ihika ko kɨro nyandayɨra so nzigu sawe,</para>
  <para style="q1" vid="ACT 2:35">mo kɨndʉ kyawe ky'iryathirako.<note caller="+" style="f"><char style="fr" closed="false">2:34-35 </char><char style="xt" closed="false">Soma <ref loc="PSA 110:1">Saburi 110:1</ref>.</char></note>’”<verse eid="ACT 2:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="ACT 2:36" />Aho abandʉ boshi <char style="w" lemma="Isiraeli">b'iIsiraeli</char> batholere nɨbamɨnya kundu-kundu ko Yesʉ yo mwabambaga ko mʉsalaba, n'ɨye yo Gongo ayɨragamo Nyinya-kowethʉ na <char style="w" lemma="Kirisito, Masia">Kirisito</char>!»<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />Babere bonvwa ebɨnwa ebi, mobathabagana kʉtsɨbʉ mo mɨthɨma yabo. Mobabʉtsya Petero n'abandɨ <char style="w">bathʉmwa</char> bathɨ: «Bagala bethʉ, thʉkole ki?» <verse eid="ACT 2:37" /><verse number="38" style="v" sid="ACT 2:38" />Petero mwashʉbɨtsyabo athɨ: «Mʉbɨndʉke ɨthoka mo bɨtsɨbʉ byenyu, n'obʉlɨ mʉgʉma wa kw'imwe <char style="w" lemma="Lubatiso">abatisibwe</char> mw'ɨtsɨna lya Yesʉ <char style="w" lemma="Kirisito, Masia">Kirisito</char> bʉshana mʉganyɨrwe ebɨtsɨbʉ byenyu. Aho nɨmo mwahabwa olʉhembo lwa Gongo, <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char>. <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />Kʉshangwa endagane ya Gongo eno yahirawaho bʉshana n'imwe, n'abana benyu, na ko boshi bo balɨ hale, na aboshi bo Nyinya-kowethʉ Gongo wethʉ andabɨrɨkɨra.» <verse eid="ACT 2:39" /><verse number="40" style="v" sid="ACT 2:40" />Petero mwabwɨrabo bɨndɨ bɨnwa bɨngɨ bʉshana bɨkɨrɨtsye ebyo anegena n'ɨhabo muhwa nɨanegena athɨ: «Muyilamye ɨthoka mo kɨgenyero kɨbɨ kɨno!» <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />Bandʉ bangɨ mobɨkɨrɨtsya ebɨnwa bya Petero na <char style="w" lemma="Lubatiso">mobabatisibwa</char>. Ekɨro ekyo bandʉ hofɨ bɨhʉmbɨ bɨshathʉ mobongereka ko kɨkembe ky'abɨkɨrɨtsya.<verse eid="ACT 2:41" /></para>
  <para style="s">Ibyaho ly'obʉgʉma</para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 2:42" />Abɨkɨrɨtsya babyaga na muhwa w'ɨkwama kʉbʉya amakangɨrɨtsya <char style="w" lemma="Bathʉmwa">w'abathʉmwa</char>, n'ibyaho mo bʉgʉma, n'ɨgenda abalɨra hagʉma<note caller="+" style="f"><char style="fr" closed="false">2:42 </char><char style="fq" closed="false">abalɨra hagʉma: </char><char style="ft" closed="false">Kano kangabya kalyo k'olʉgalɨ lwa Nyinya-kowethʉ, kʉtse kalyo ko kanalɨbwa honyuma w'olʉgalɨ lwa Nyinya-kowethʉ.</char></note> n'ɨgenda abashabɨra hagʉma. <verse eid="ACT 2:42" /><verse number="43" style="v" sid="ACT 2:43" />Obʉlɨ mʉndʉ abyaga na bʉba, kʉshangwa Gongo agenda akola bɨthɨko-thɨko bɨngɨ na bɨmɨnyɨkalo bɨngɨ kw'ɨtsʉkɨra <char style="w" lemma="Bathʉmwa">abathʉmwa</char>. <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />Abɨkɨrɨtsya boshi babyaga mʉ bʉgʉma, na bagenda abashangɨra ebyoshi babyaga bawitheko. <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />Bagenda abagʉtsya ebɨndʉ byabo, n'esofaranga sagenda esɨthoka kʉbyo bagenda abagabanatho, ɨkwamana n'emɨlago y'obʉlɨ mʉndʉ. <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />Ebɨro byoshi bagenda abahindana mo <char style="w">Nyʉmba ya Gongo</char>, na bagenda abalɨra hagʉma mo manyʉmba wabo na bagenda abalya akalyo kabo mo lʉmogo na mo mɨthɨma y'obʉlonvʉ. <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />Bagenda abasingya Gongo, kandɨ nibatsiyirwe n'abandʉ boshi. Na Nyinya-kowethʉ agenda ongerera ekɨkembe kyabo, abo agenda ashabʉla ebɨro byoshi.<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s">Petero na Yoani abalamya kɨrema</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />Kɨro kɨgʉma Petero na Yoani bagenda abɨrʉkɨra ho <char style="w">Nyʉmba ya Gongo</char> bʉshana n'omʉshabe w'oko saha mwenda. <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />Hofɨ n'olukyo lʉgʉma <char style="w" lemma="Nyʉmba ya Gongo">lw'eNyʉmba ya Gongo</char> lo lwagenda olwahʉlwamo «Lukyo Lʉbʉya», mohahekerwa mʉndʉ mʉgʉma abyaga kɨrema ɨthanga kw'ɨbʉthwa lɨwe. Ko bɨro byoshi bagenda abamumika ko lukyo olo, bʉshana n'ɨgenda ashaba buwathikya ko bandʉ bo bagenda abɨngɨra mo <char style="w">Nyʉmba ya Gongo</char>. <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />Omʉndʉ oyo mwashʉnga Petero na Yoani niabashondya ɨngɨra mo <char style="w">Nyʉmba ya Gongo</char>, na mwashababo faranga. <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />Petero na Yoani mobamʉhandako amesho. Petero mwamʉbwɨra athɨ: «Yɨthegeretsye ithwe!» <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />Omʉndʉ oyo mwahanda kʉbo kw'amesho nɨaganɨtsya athɨ abona kʉbo ko kɨndʉ. <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />Hewethuwe Petero mwamʉbwɨra athɨ: «Nyithawithe kʉ faranga kʉtse kʉ horo. Hewethuwe ekyo nyiwitheko kyo nyakʉha. Mw'ɨtsɨna lya Yesʉ <char style="w" lemma="Kirisito, Masia">Kirisito</char> w'iNasareti, wimana na ʉgende!»<figure style="fig" alt="Pierre et Jean guerissent un paralytiqe a l' entree du Temple" file="wa03941.jpg" size="col" ref="3:6-7">Petero na Yoani abalamya kɨrema ho lukyo lw'eNyʉmba ya Gongo</figure><verse eid="ACT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 3:7" />Aho Petero mwamʉtsɨmba ko kʉboko kʉwe kw'amalyo na mwamuwathikya erimwimania. Aho n'aho ebɨshando n'obukongolu by'omʉndʉ oyo mobyabya na kagala, <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />mwabathʉka n'ɨthanga ɨgenda. Mwɨngɨra na Petero na Yoani mo <char style="w">Nyʉmba ya Gongo</char>, nɨagenda n'ɨyɨshɨnda, n'isingya Gongo.<verse eid="ACT 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 3:9" />Abandʉ boshi mobamʉshʉnga alɨagenda n'isingya Gongo. <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />Abandʉ babere bamʉshʉnga mobamɨnya ko nɨ ɨye yo wagenda ashabɨrɨtsya ikere ho lukyo <char style="w" lemma="Nyʉmba ya Gongo">lw'eNyʉmba ya Gongo</char> lo lwagenda olwahʉlwamo «Lukyo Lʉbʉya». Kandɨ mobashishala n'ɨshweka kʉtsɨbʉ bashʉnga ko byo bithahikira omʉndʉ oyo.<verse eid="ACT 3:10" /></para>
  <para style="s">Makangɨrɨtsya wa Petero</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />Omʉndʉ oyo mwathalika Petero na Yoani. Abandʉ boshi mobashweka kʉtsɨbʉ n'ɨthɨbɨthɨra tsʉba yo babyaga mo mbarasa yo yagenda eyahʉlwamo «Mbarasa ya Solomona.<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="fq" closed="false">Mbarasa ya Solomona </char><char style="ft" closed="false">nɨ mbarasa ya nduyi nyɨngɨ yabyaga mo mbʉga y'eNyʉmba ya Gongo.</char></note>» <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />Aho, Petero abere ashʉnga kw'ebyo mwabwɨra abandʉ athɨ: «Imwe bandʉ <char style="w" lemma="Isiraeli">b'iIsiraeli</char>, bʉshana na ki omʉshwekera erɨlama eri? Na bʉshana na ki omʉthʉhandako amesho nga nɨ ko maka ethʉ ithwe bene, kʉtse nɨ kw'ɨtholera lyethʉ embere sa Gongo lyo lyamaleka omʉndʉ oyu nɨagenda? <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />Gongo wa <char style="w">Abʉrahamʉ</char> na Isaka na Yakobo, Gongo wa bo thatha-kʉlʉ, n'ɨye yo wamasingya mukoli ʉwe Yesʉ. Yesʉ yo mwahotheraga n'ɨyɨgana ɨye embere sa <char style="w">Pilato</char> mo ndambi abyaga niashondya ɨmʉmɨnʉla. <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" />He imwe momwathɨnda yo <char style="w" lemma="Mubuyirire">ubuyirire</char>, omʉthʉnganene, momwashaba mʉmɨnʉlɨrwe omwithi.<note caller="+" style="f"><char style="fr" closed="false">3:13-14 </char><char style="xt" closed="false">Soma <ref loc="LUK 23:13-23">Luka 23:13-23</ref>.</char></note> <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />Momwitha yo ʉlɨ shoko y'obʉyɨngo, hewethuwe Gongo mwamulubukya mo baholi nethwe thʉlɨ batimo bʉwe. <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />Nɨ mo maka w'erɨtsɨna lya Yesʉ, bʉshana n'olwɨkɨrɨtsyo mw'ɨye, lwamaha omʉndʉ oyu yo kagala yo mushungireko hano na mumwetsi. Nɨ erɨtsɨna lya Yesʉ n'olwɨkɨrɨtsyo mw'ɨye lo lwamamʉha erɨlama lɨhwererere nga ko mwamashʉnga imwe boshi.<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />«Aho bagala bethʉ imwe, nyetsi ko imwe n'abakʉlʉ benyu momwakolera Yesʉ mo bʉthamɨnya ebyo mwakolaga. <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />Hewethuwe Gongo amamala ɨbereretsya kuthyo ekyo anegenaga kera mo mʉnʉ <char style="w" lemma="Mʉmɨnyeretsɨ">w'abamɨnyeretsɨ</char> boshi. Mwanegena athɨ <char style="w" lemma="Kirisito, Masia">Kirisito</char> ʉwe angagerwe. <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />Ɨngo! Mʉbɨndʉke ɨthoka mo bɨtsɨbʉ byenyu, na mʉbɨndʉkɨre Gongo nɨmo abashangʉlako ebɨtsɨbʉ byenyu. <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />Aho Nyinya-kowethʉ andabaha ndambi y'ɨlʉhʉka, n'ɨbathʉmɨra Yesʉ, ye <char style="w" lemma="Kirisito, Masia">Kirisito</char> yo Gongo abashombolera ɨthoka kera. <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />Ko ndambi eno Yesʉ Kirisito atholere nɨathanga ibya mo lʉbʉla ihika ko mʉgʉlʉ ebyoshi byandabya bihya-bihya, nga ko Gongo anegenaga mo mʉnʉ <char style="w" lemma="mʉmɨnyeretsɨ">w'abamɨnyeretsɨ</char> bʉwe <char style="w" lemma="Mubuyirire">babuyirire</char> ɨthanga kera. <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />Kʉshangwa Mʉsa mwabwɨra bo thatha-kʉlʉ athɨ: “Nyinya-kowethʉ Gongo wenyu, andahulukya <char style="w" lemma="Mʉmɨnyeretsɨ">mʉmɨnyeretsɨ</char> yo ʉlɨ ng'ingye mʉgʉma mw'imwe. Mwandahʉlɨkɨrɨtsya ebyoshi andababwɨra. <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />N'obʉlɨ mʉndʉ yo ʉthɨndahʉlɨkɨrɨtsye <char style="w" lemma="Mʉmɨnyeretsɨ">omʉmɨnyeretsɨ</char> oyo, andaligithwa ɨthoka mo bandʉ ba Gongo n'ithwa.<note caller="+" style="f"><char style="fr" closed="false">3:22-23 </char><char style="xt" closed="false">Soma <ref loc="DEU 18:15">Ɨbʉka 18:15</ref>,<ref loc="DEU 18:18-19">18-19</ref>.</char></note>”<verse eid="ACT 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 3:24" />«Na <char style="w" lemma="Mʉmɨnyeretsɨ">abamɨnyeretsɨ</char> boshi bo banegenaga ɨthanga kʉ Samwere, aboshi nga ko bakwamanaga, nabo mobahʉla ebɨro bɨno. <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" /><char style="w" lemma="Ndagane">Endagane</char> yo Gongo akolaga <char style="w" lemma="Mʉmɨnyeretsɨ">n'abamɨnyeretsɨ</char>, nɨ <char style="w">ndagane</char> enyu. Na mushangire ko <char style="w">ndagane</char> eyo akolaga na bo thatha-kʉlʉ abere anegena na <char style="w">Abʉrahamʉ</char> athɨ: “Ko lʉbʉtho lwawe ebɨhanda byoshi by'omo kɨhʉgo byandagashanɨrwa.<note caller="+" style="f"><char style="fr" closed="false">3:25 </char><char style="xt" closed="false">Soma <ref loc="GEN 22:18">Ndangɨro 22:18</ref>.</char></note>” <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />Kuthyo, Gongo mwahulukya omukoli ʉwe, mwathanga ɨbathʉmɨra ɨye bʉshana n'ɨbagashanɨra mw'ɨbɨndʉla bʉlɨ mʉndʉ mw'imwe ɨthoka mo bɨbɨ bɨwe.»<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s">Petero na Yoani ababʉrana embere s'abakʉlʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />Aho Petero na Yoani babere bakɨnalɨ abanegena n'abandʉ, <char style="w" lemma="Muheri">abaheri</char> n'omʉkʉlʉ w'abatheya <char style="w" lemma="Nyʉmba ya Gongo">b'eNyʉmba ya Gongo</char> n'<char style="w" lemma="Basandukayo">aBasandukayo</char> mobafʉmba. <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />Babyaga nibatsibukire kʉtsɨbʉ kʉshangwa abathʉmwa babɨrɨ abo bagenda abakangɨrɨtsya abandʉ n'ɨbwɨrabo ko Yesʉ mwalubuka, na mw'ebyo nɨabanegena bathɨ abaholi bangalubuka. <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />Mobatsɨmbabo na mobagʉshabo mo muliki ihika mungya, kʉshangwa bwabyaga nɨbwahera igolo. <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />Hewethuwe bangɨ mw'abo bonvwaga ebɨnwa by'abathʉmwa mobɨkɨrɨtsya, n'emɨganzo ya bobɨkɨrɨtsaya yabyaga hofɨ bɨhʉmbɨ bɨthano.<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />Aho bwabere bwakya, abakʉlʉ n'abangʉmwa <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">n'abakangɨrɨtsya b'oMʉgomba</char>, mobahindana ɨYerʉsalemʉ. <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />Mo kathi k'abo mwabyaga Ana <char style="w" lemma="Muheri">muheri mʉkʉlʉ</char> na Kayafa na Yoani na Likisa n'aboshi bo babyaga b'omo lʉganda <char style="w" lemma="Muheri">lw'omuheri mʉkʉlʉ</char>. <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />Mobahira Petero na Yoani mo kathi-kathi n'ɨbʉtsyabo bathɨ: «Nɨ kʉ maka ahɨ kʉtse kw'ɨtsɨna lya ndɨ lyo mʉthalamyamo?» <verse eid="ACT 4:7" /><verse number="8" style="v" sid="ACT 4:8" />Aho Petero anotswiremo <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char>, mwabwɨrabo athɨ: «Imwe bakʉlʉ b'abandʉ n'imwe bangʉmwa, <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />othʉbʉrana munobwire bʉshana n'ekɨbʉya kɨthakolerwa ekɨrema. Othʉbʉtsɨbwa ng'omʉndʉ athalama athɨ. <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />Imwe, n'abandʉ boshi <char style="w" lemma="Isiraeli">b'iIsiraeli</char>, mʉtholere nɨmwamɨnya k'omʉndʉ oyu amimana embere senyu alɨ amalire ɨlama kʉbʉya, nɨ bʉshana n'amaka w'erɨtsɨna lya Yesʉ <char style="w" lemma="Kirisito, Masia">Kirisito</char> w'iNasareti. Momwamubambire ko mʉsalaba na Gongo mwamulubukitsye ɨthoka mo baholi. <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />Yesʉ oyo yo aMashako Abuyirire anegenako athɨ:</para>
  <para style="q1" vid="ACT 4:11">“Eribwe lyo mwathɨndaga imwe bahimbi,</para>
  <para style="q1" vid="ACT 4:11">nɨ lyo lyabere ibwe ly'ekoni.<note caller="+" style="f"><char style="fr" closed="false">4:11 </char><char style="xt" closed="false">Soma <ref loc="PSA 118:22">Saburi 118:22</ref>.</char></note>”<verse eid="ACT 4:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ACT 4:12" />Kandɨ hathalɨ ɨshabʉlwa mʉ ʉndɨ mʉndʉ, kʉshangwa hathalɨ lɨndɨ ɨtsɨna hano ishi lyo abandʉ bahabawa bashabʉlwe mʉlyo.»<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />Aho abangʉmwa babere bashʉnga obʉthʉbaha bwa Petero na Yoani, n'ɨmɨnya ko nɨ bandʉ bathasomire na nɨ bandʉ ba bʉsha-bʉsha, mobashweka kʉtsɨbʉ, na mobamɨnya ko bathalɨ hagʉma na Yesʉ. <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />Kandɨ babere bashʉnga omʉndʉ yo uthalamibwa imene hagʉma nabo, mobathakotsya ishubya kɨnwa. <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />Aho mobahamʉlabo bathoke mo <char style="w">Bʉshenge Bʉkʉlʉ</char>, nabo mobaya bʉnombo. <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />Omo, mobathanga ɨnegena bathɨ: «Thwayɨra abandʉ aba bo thʉthɨ? Kʉshangwa ekɨthɨko-thɨko bathakola nɨ kɨnene embere s'abandʉ boshi b'ɨYerʉsalemʉ, kandɨ thʉthangakotsya ɨyɨganakyo. <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />Aho nɨmo omwatsɨ ono athayaga ngʉlʉ, thʉhangɨrebo kʉtsɨbʉ bathanalinda bashʉba sɨmolera mʉndʉ yo kw'ɨtsɨna eri.»<verse eid="ACT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18" />Honyuma kw'aho mobabɨrɨkɨrabo na mobabwɨrabo bathɨ: «Muthanalinda mwashʉba negena kʉtse ɨkangɨrɨtsya kw'ɨtsɨna lya Yesʉ.» <verse eid="ACT 4:18" /><verse number="19" style="v" sid="ACT 4:19" />Hewethuwe Petero na Yoani mobashʉbɨtsyabo bathɨ: «Mʉsohe imwe bene ni ki kyo kɨtholere embere sa Gongo, ɨbonvwa kʉtse ɨonvwa Gongo? <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />Ithwe thuthangalika ɨnegena ko bɨnwa ebyo thʉthashʉngako nɨonvwa.» <verse eid="ACT 4:20" /><verse number="21" style="v" sid="ACT 4:21" />Babere bamamala ɨshʉba hangɨrabo kʉtsɨbʉ, mobamɨnʉlabo, kʉshangwa mobathashʉnga omwanya w'erilakyabo bʉshana n'abandʉ, kʉshangwa abandʉ boshi bagenda abasingya Gongo bʉshana n'ebyo bɨthakoleka. <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />Omʉndʉ yo walamibawa abyaga niawithe myaka irengitsye makumi ane.<verse eid="ACT 4:22" /></para>
  <para style="s">Mɨshabe y'abɨkɨrɨtsya</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />Petero na Yoani babere bamamala ɨmɨnʉlwa mobagenda eyɨrɨ balikyabo, mobafʉlɨrabo emyatsɨ y'ebyoshi <char style="w" lemma="Muheri">abakʉlʉ b'abaheri</char> n'abangʉmwa bathabwɨrabo. <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />Abɨkɨrɨtsya babere bamala ɨonvwa omwatsɨ oyo aboshi kʉgʉmerera mobalakɨra Gongo bathɨ: «Ewo Nyinya-kowethʉ, ɨwe wo wabʉmbaga olʉbʉla n'ekɨhʉgo n'engetsɨ n'ebyoshi bɨrɨ mʉbyo, <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />nɨ ɨwe wo wayɨraga omukoli awe <char style="w">Tawiti</char> thatha-kʉlʉ wethʉ, anegene ko kagala <char style="w" lemma="Mʉthɨma Mwerʉ">k'oMʉthɨma Mwerʉ</char> athɨ:</para>
  <para style="q1" vid="ACT 4:25">“Bʉshana na ki abandʉ b'ebɨhanda abaletha bʉrʉnga?</para>
  <para style="q1" vid="ACT 4:25">Na bʉshana na ki abandʉ abaya nama sa bʉsha-bʉsha?<verse eid="ACT 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26" />Abamɨ ba hano ishi mobayithegekenie kʉbʉya,</para>
  <para style="q1" vid="ACT 4:26">n'abakʉlʉ mobahindene hagʉma</para>
  <para style="q1" vid="ACT 4:26">bʉshana n'ɨlwɨsa Nyinya-kowethʉ na Kirisito ʉwe.<note caller="+" style="f"><char style="fr" closed="false">4:25-26 </char><char style="xt" closed="false">Soma <ref loc="PSA 2:1-2">Saburi 2:1-2</ref>.</char></note>”<verse eid="ACT 4:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ACT 4:27" />Ega! Nɨ kwenene, ye <char style="w">Herote</char> na Ponzo <char style="w">Pilato</char> hagʉma n'abandʉ b'ebɨhanda, n'abandʉ <char style="w" lemma="Isiraeli">b'iIsiraeli</char>, mobahindene mo muyi ono bʉshana n'ɨlwɨsa omukoli awe <char style="w">mubuyirire</char> Yesʉ, yo wahakabaya amafʉtha. <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />Nɨ bathyo ko babereretsaya ebyo walengekanaya mo maka n'erishondya lyawe ɨthanga kera. <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />Aho, Nyinya-kowethʉ, shʉnga ebyʉbahɨrɨtsyo byabo, ewo, ʉthʉhe ithwe bakoli bawe bo kagala k'erɨfʉla eKɨnwa kyawe bʉtsɨra bʉba. <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />Kangania amaka awe kʉshangwa abandʉ balamibwe, ebɨmɨnyɨkalo n'ebɨthɨko-thɨko bɨkoleke mw'ɨtsɨna ly'omukoli awe <char style="w">mubuyirire</char> Yesʉ.» <verse eid="ACT 4:30" /><verse number="31" style="v" sid="ACT 4:31" />Babere bamamala ɨshaba, aho babyaga bahindene mohathenganibwa, n'aboshi mobotsutsibwa <char style="w" lemma="Mʉthɨma Mwerʉ">n'oMʉthɨma Mwerʉ</char>, mobathanga ɨfʉla <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char> bʉtsɨra bʉba.<verse eid="ACT 4:31" /></para>
  <para style="s">Abɨkɨrɨtsya abashangya ebɨndʉ byabo</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />Ekɨkembe ky'abɨkɨrɨtsya mobabya na mʉthɨma mʉgʉma, na mɨganɨtsye mɨgʉma. Mohathabya mʉndʉ mʉbo yo wagenda anegena athɨ ebɨndʉ bɨwe nɨ bɨwe yowene, hewethuwe mobashangɨra ebɨndʉ byoshi. <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" /><char style="w" lemma="Bathʉmwa">N'abathʉmwa</char> bagenda abafʉla ebyo balolagako kw'ilubuka lya Nyinya-kowethʉ Yesʉ mo maka mangɨ. Na Gongo mwaha aboshi bo lʉkogo lʉngɨ. <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />Na mo kathi kabo momuthabya n'omʉndʉ n'omʉgʉma yo wabʉshaga kɨndʉ, kʉshangwa aboshi bo babyaga bawithe mashwa kʉtse manyʉmba bagenda abagʉtsyawo n'ɨletha esofaranga sathokaga kʉwo <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />n'iwathyatho <char style="w" lemma="Bathʉmwa">abathʉmwa</char>, nabo bagenda abagabɨratho ko bʉlɨ mʉndʉ ɨkwamana n'emɨlago yɨwe.<verse eid="ACT 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36" />Kwabyaga <char style="w" lemma="Balawi">Mulawi</char> mʉgʉma erɨtsɨna lɨwe nɨ yo Yosefʉ, mbʉthɨrwa y'ekɨtsɨra ky'iKipuro, yo <char style="w" lemma="Bathʉmwa">abathʉmwa</char> balʉkagamo Baranaba (nɨ ɨnegena mbʉ: «Mʉndʉ w'ɨhana muhwa»). <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />Yosefʉ oyo abyaga awithe ɨshwa lɨwe, mwagʉtsyalyo, na mwaletha esofaranga n'iwathyatho <char style="w" lemma="Bathʉmwa">abathʉmwa</char>.<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s">Ananɨa bana Safɨra</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />Hewethuwe mʉndʉ mʉgʉma erɨtsɨna lɨwe agenda ahʉlwamo Ananɨa hagʉma na mʉkatsɨwe agenda ahʉlwamo Safɨra, mwagʉtsya ɨshwa lɨwe, <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />mwabisha ko sofaranga, mwaletha eso sashakaga, mwawathyatho <char style="w" lemma="Bathʉmwa">abathʉmwa</char>. Na mʉkatsɨwe abyaga nietsi omwatsɨ oyo. <verse eid="ACT 5:2" /><verse number="3" style="v" sid="ACT 5:3" />Aho Petero mwamʉbʉtsya athɨ: «Ananɨa, bʉshana na ki <char style="w">Sitani</char> mwotsutsya omʉthɨma awe n'ɨkʉthʉma ʉthɨme <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> n'ibisha ko faranga s'erɨshwa lyawe? <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />Embere ʉgʉtsyelyo lithabyaga lɨwawe? Na ʉthabere wamamala ɨgʉtsyalyo, esofaranga sɨthathalɨ sɨwawe? Bʉshana na ki moʉganɨkɨra ɨkola ebɨrɨ ng'ebi? Moʉthalɨ ʉthɨma bandʉ, hewethuwe Gongo yo wamathɨma!» <verse eid="ACT 5:4" /><verse number="5" style="v" sid="ACT 5:5" />Ananɨa abere onvwa ebɨnwa ebyo, mwawa ahishi n'ɨfwa. Aboshi abo bonvwaga omwatsɨ oyo mobatsɨmbwa na bʉba bʉngɨ. <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />Aho mokwahʉlʉka bathabana mobatsɨmba omʉbɨrɨ ʉwe mobashwɨkawo n'ɨyathawo.<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />Honyuma wa saha ishathu, mʉka Ananɨa mwɨngɨra bʉthamɨnya ebyo byamatsʉka. <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />Petero mwamʉbʉtsya athɨ: «Nyɨbwɨre, esi so faranga mwabonaga mwabere mwagʉtsya erɨshwa lyenyu?» Naye mwamʉshʉbɨtsya athɨ: «Ega, so netho.» <verse eid="ACT 5:8" /><verse number="9" style="v" sid="ACT 5:9" />Petero mwamʉbwɨra athɨ: «Bʉshana na ki momwalagene kw'ɨrenga ko <char style="w" lemma="Mʉthɨma Mwerʉ">Mʉthɨma</char> wa Nyinya-kowethʉ? Onvwa, bobamatha ibawe babano bahera ho lukyo nawe kuthyo bakʉheka.» <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />Aho n'aho mwawa ahishi embere s'ebɨshando bya Petero n'ɨfwa. Abathabana mobɨngɨra na mobamweya niamalire ɨfwa. Mobamʉheka n'ɨya mʉtha hofɨ n'iba. <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" /><char style="w" lemma="Kanisa">Akanisa</char> koshi n'aboshi bo bonvwaga omwatsɨ oyo mobʉbaha kʉtsɨbʉ.<verse eid="ACT 5:11" /></para>
  <para style="s">Abathʉmwa abakola bɨthɨko-thɨko bɨngɨ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />
    <char style="w" lemma="Bathʉmwa">Abathʉmwa</char> bagenda abakola bɨmɨnyɨkalo na bɨthɨko-thɨko bɨngɨ mo kathi k'abandʉ. Abɨkɨrɨtsya boshi mobagenda abahindana hagʉma mo mbarasa ya Solomona.<note caller="+" style="f"><char style="fr" closed="false">5:12 </char><char style="fq" closed="false">Mbarasa ya Solomona </char><char style="ft" closed="false">nɨ mbarasa ya nduyi nyɨngɨ yabyaga mo mbʉga y'eNyʉmba ya Gongo.</char></note> <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />Mohathabya ʉndɨ mʉndʉ yo wayihiraga kʉbo, na mobyanabyaga bithyo abandʉ babyaga nibashikitsyebo kʉbʉya. <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />Emɨganzo y'abandʉ bikiritsaya Nyinya-kowethʉ, abayira n'abakatsɨ, bagenda abongererwa kʉtsɨbʉ ko kɨkembe kyabo. <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />Aho mobagenda abaletha abakoni b'emʉsɨke w'enzɨra, na mobagenda abahirabo ko bipoya kʉtse ko mɨkeka nɨmo Petero abya atsʉkaho, ekithuthu kɨwe kɨshwɨke bagʉma ba mʉbo. <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />Bandʉ bangɨ bo bagenda abathoka mo miyi eyithimbire kʉ Yerʉsalemʉ, mobahindana nɨabaletha abakoni n'abandʉ bo bagenda abagalwa <char style="w" lemma="Batsɨmʉ">n'emɨtsɨmʉ</char>, n'aboshi mobalamibwa.<verse eid="ACT 5:16" /></para>
  <para style="s">Abathʉmwa abagalwa</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />Aho <char style="w" lemma="Muheri">omuheri mʉkʉlʉ</char> n'abalikyabo boshi, n'ɨnegena mbʉ abandʉ b'omo kɨkembe <char style="w" lemma="Basandukayo">ky'aBasandukayo</char>, mobafwa mwisho ko bathʉmwa. <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />Mobatsɨmba <char style="w" lemma="Bathʉmwa">abathʉmwa</char> abo n'ɨyagʉshabo mo biriso by'abandʉ boshi. <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />Hewethuwe mo kɨro <char style="w">malaɨka</char> wa Nyinya-kowethʉ mwakɨngʉla esonyuyi s'ebiriso mwahʉlʉkɨtsyabo embʉga, n'ɨbwɨrabo athɨ: <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />«Mʉgende muyimane mo <char style="w">Nyʉmba ya Gongo</char>, mʉyabwɨre abandʉ b'emyatsɨ yoshi y'obʉyɨngo buhya.» <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />Abathʉmwa babere bonvwa ebyo, mobɨngɨra mo <char style="w">Nyʉmba ya Gongo</char> mo mambya matsɨbʉ, mobathanga ɨkangɨrɨtsya abandʉ.</para>
  <para style="p" vid="ACT 5:21">
    <char style="w" lemma="Muheri">Omuheri mʉkʉlʉ</char> n'abalembya bʉwe babere bahika, mobahindania abangʉmwa <char style="w" lemma="Isiraeli">b'aBaisiraeli</char>, bʉshana n'ɨkola muhindano <char style="w" lemma="Bʉshenge Bʉkʉlʉ">w'oBʉshenge Bʉkʉlʉ</char>. Honyuma kw'aho mobathʉma bandʉ ko biriso bayalethe abathʉmwa. <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />Hewethuwe abatheya babere bahikayo, mobatheyabomo. Mobashʉbʉla n'ɨyafʉla omwatsɨ, <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />mobanegena bathɨ: «Thwameya ebiriso nibinakingire kʉbʉya, n'abatheya nibanimene ko luyi. Hewethuwe thʉthabere thwakɨngʉla, mothʉthalɨ othʉshʉngamo mʉndʉ.» <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />Omʉkʉlʉ w'abatheya <char style="w" lemma="Nyʉmba ya Gongo">b'eNyʉmba ya Gongo</char> <char style="w" lemma="Muheri">n'abakʉlʉ b'abaheri</char> babere bonvwa ebyo, mobagashama, mobayɨbʉtsya byo bithahikira abathʉmwa. <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />Honyuma kw'aho mʉndʉ mʉgʉma mwahʉlʉka n'ɨbwɨrabo athɨ: «Mwonvwe! Abandʉ bomwagʉshaga mo biriso balɨ mo <char style="w">Nyʉmba ya Gongo</char> abakangɨrɨtsya abandʉ.»<verse eid="ACT 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 5:26" />Aho omʉkʉlʉ w'abatheya b'eNyʉmba ya Gongo oyo, mwagenda hagʉma n'abakoli bʉwe, mobayaletha abathʉmwa he bʉtsɨra kʉ kahatho, kʉshangwa mobʉbaha abandʉ bathangagʉsha kʉbo ko mabwe. <verse eid="ACT 5:26" /><verse number="27" style="v" sid="ACT 5:27" />Babere balethabo, mobahirabo embere <char style="w" lemma="Bʉshenge Bʉkʉlʉ">y'oBʉshenge Bʉkʉlʉ</char>. <char style="w" lemma="Muheri">Omuheri mʉkʉlʉ</char> mwabwɨrabo athɨ: <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />«Mothwabahangire kʉtsɨbʉ thʉthɨ mʉthashʉba kangɨrɨtsya kw'ɨtsɨna ly'omʉndʉ oyo. Hene ko mwamutsutsya eYerʉsalemʉ yoshi n'amakangɨrɨtsya enyu, kandɨ omushondya ithuhekya omʉsasɨ w'omʉndʉ oyo.» <verse eid="ACT 5:28" /><verse number="29" style="v" sid="ACT 5:29" />Hewethuwe Petero n'abandɨ <char style="w">bathʉmwa</char> mobashubya bathɨ: «Bɨtholere nithwashikya Gongo kʉlenga abandʉ. <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />Gongo wa bo thatha-kʉlʉ mwalubukya Yesʉ, yo mwithaga mw'ɨmʉbamba ko <char style="w">mʉsalaba</char>. <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />Omʉndʉ oyo, Gongo mwamusingya n'imuhira ko kʉboko kʉwe kw'amalyo n'ɨmʉyɨramo Mʉkʉlʉ na Mushabuli, kʉshangwa ahe <char style="w" lemma="Isiraeli">aBaisiraeli</char> bw'obuthoki bw'erɨbɨndʉka ɨthoka mo bɨtsɨbʉ byabo n'ɨganyɨrwa. <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />Nethwe thʉlɨ batimo b'ebɨnwa ebi hagʉma <char style="w" lemma="Mʉthɨma Mwerʉ">n'oMʉthɨma Mwerʉ</char> yo Gongo ahaga bo bamushikitsye.»<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />Abandʉ b'oBʉshenge Bʉkʉlʉ babere bonvwa ebɨnwa ebyo, mobakapɨkɨra, n'ishondya itha abathʉmwa abo. <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />Hewethuwe kwabyaga mʉndʉ mʉgʉma <char style="w" lemma="Bafarisayo">Mufarisayo</char>, erɨtsɨna lɨwe nɨ yo Ngamalieri, <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">mʉkangɨrɨtsya</char> w'oMʉgomba, niashikibwe n'abandʉ boshi. Mwayɨhangalɨka mo Bʉshenge, mwahamʉla athɨ bathahulukya abathʉmwa kʉ kathambi kake. <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />Honyuma kw'aho mwabwɨrabo athɨ: «Imwe bayira <char style="w" lemma="Isiraeli">b'iIsiraeli</char>, mʉyɨthondekere ebyo omushondya ɨkolera abandʉ aba. <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />Kʉshangwa mo bɨro byatsʉkaga mokwahulukire mʉndʉ mbʉ yo Teʉta nɨanegena athɨ ɨye nɨ mʉndʉ mʉkʉlʉ. N'abandʉ bo bamʉkwamaga mobahika hofɨ magana ane. Hewethuwe mwithwa, na bo babyaga bamukwamire mobasanzabana n'ekɨkembe kyabo mokyahwa. <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />Honyuma kw'ɨye mo bɨro by'efishi, mokwahʉlʉka Yuta mʉndʉ w'omo kɨhʉgo ky'iNgalilaya mwayɨkʉrɨrako bandʉ bangɨ naye mwithwa. N'aboshi bo bamʉkwamaga mobasanzabanibwa. <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />Aho enyɨbabwɨra, mʉthatsomanagabo, mulikebo bagende. Kʉshangwa ebyo abathegekania kʉtse ebyo abakola byamabya nɨ by'abandʉ nɨbyayɨhwera. <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />Hewethuwe byamabya nɨ bya Gongo muthangakotsya ibihyabyo. Mʉthangandabya nga kʉno omushondya ɨlwa na Gongo!»</para>
  <para style="p" vid="ACT 5:39">Aboshi mobɨmɨra ebɨnwa bya Ngamalieri. <verse eid="ACT 5:39" /><verse number="40" style="v" sid="ACT 5:40" />Mobashʉba bɨrɨkɨra <char style="w" lemma="Bathʉmwa">abathʉmwa</char>, mobahamʉla bahirweko mbasha na mobahangɨrabo bathɨ bathanalinda bashʉba negena kw'ɨtsɨna lya Yesʉ Kirisito. Honyuma kw'aho mobamɨnʉlabo. <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />Abathʉmwa mobathoka mo <char style="w">Bʉshenge Bʉkʉlʉ</char> nibamogire kʉtsɨbʉ, kʉshangwa nɨbamaganzwa ko batholere ɨgalwa bʉshana n'erɨtsɨna lya Yesʉ Kirisito. <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />Ko bɨro byoshi, mobathalika erɨgenda abakangɨrɨtsya mo <char style="w">Nyʉmba ya Gongo</char> n'omo bʉlɨ nyʉmba erɨfʉla <char style="w" lemma="Ngʉlʉ Mbʉya">eNgʉlʉ Mbʉya</char> ya Yesʉ <char style="w" lemma="Kirisito, Masia">Kirisito</char>.<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s">Bandʉ balɨnda abashombolwa iwathikya abathʉmwa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />Mo bɨro ebyo emɨganzo <char style="w" lemma="Abɨga">y'abɨga</char> moyagenda eyɨlʉga. Mokwabya ɨrʉkʉma mo kathi k'abɨkɨrɨtsya bo bagenda abanegena <char style="w" lemma="Bakiriki">ekikiriki</char> na bo bagenda abanegena <char style="w" lemma="Baebʉranɨa">ekɨebʉranɨa</char>, kʉshangwa abo bagenda abanegena <char style="w" lemma="Bakiriki">ekikiriki</char> mobatsɨbʉka bathɨ abashʉmbakatsɨ babo mobathagenda abagabɨrwa ng'abandɨ ko bʉlɨ kɨro. <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />Abathʉmwa ikumi n'ababɨrɨ mobahindania abandɨ <char style="w" lemma="Abɨga">bɨga</char> boshi n'ɨbwɨrabo bathɨ: «Bɨthatholere kw'ithwe thulike ɨkangɨrɨtsya <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char>, bʉshana n'ɨgenda othʉgaba akalyo. <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />Bʉshana n'ekyo, bagala bethʉ, mʉshombole bandʉ balɨnda mw'imwe bandʉ bayire ngʉlʉ mbʉya, bo botswiremo oMʉthɨma Mwerʉ, n'abo bwenge, kʉshangwa thʉhebo omʉlɨmo oyu. <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />He ithwe thwagenda othʉshaba n'erɨfʉla <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char>.» <verse eid="ACT 6:4" /><verse number="5" style="v" sid="ACT 6:5" />Ekɨnwa eki mokyamoya omuhindano woshi. Aho mobashombola Sɨtɨfano, mʉndʉ yo wabyaga otswiremo olwɨkɨrɨtsyo <char style="w" lemma="Mʉthɨma Mwerʉ">n'oMʉthɨma Mwerʉ</char>, na Filipo na Porokoro na Nikanora na Timoni na Parɨmena na Nikola w'iAntiokia, yo wabɨndʉkɨraga mo kɨsomo ky'aBayuta. <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />Mobakangyabo embere <char style="w" lemma="Bathʉmwa">s'abathʉmwa</char>, nabo mobashabɨrabo n'ihira kʉbo kw'eminwe.<verse eid="ACT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7" />Aho <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char> kyagenda ekɨkanya n'emɨganzo <char style="w" lemma="Abɨga">y'abɨga</char> yagenda eyɨlʉga kʉtsɨbʉ mo muyi w'ɨYerʉsalemʉ, <char style="w" lemma="Muheri">na baheri</char> bangɨ mobɨkɨrɨtsya.<verse eid="ACT 6:7" /></para>
  <para style="s">Sɨtɨfano atsɨmbwa</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />Na ye Sɨtɨfano anotswiremo olʉkogo lwa Gongo n'akagala, agenda akola bɨthɨko-thɨko na bɨmɨnyɨkalo bɨngɨ mo kathi-kathi k'abandʉ. <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />Hewethuwe bandʉ bagʉma mobakubisania na Sɨtɨfano. Abandʉ abo babyaga b'omo <char style="w">sinakoki</char> yo yagenda eyahʉlwamo: «Bandʉ b'oBwiranda» babyaga b'omo miyi y'iKurene n'iAlesanduria na b'omo kɨhʉgo k'iKilikia na ky'iAsia. <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />Hewethuwe mobathakotsya ɨmʉsɨnda kʉshangwa agenda anegena n'obwenge ahabawa n'oMʉthɨma Mwerʉ. <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />Aho mobaha bandʉ bagʉma bo kituliro bʉshana bayanegene bathɨ: «Mothwonvwa omʉndʉ oyu niahangya Mʉsa na Gongo!» <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />Mobakaramya abandʉ n'abangʉmwa <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">n'abakangɨrɨtsya b'oMʉgomba</char> mobayihuma kw'ɨye n'ɨmʉtsɨmba n'ɨmʉthwala embere <char style="w" lemma="Bʉshenge Bʉkʉlʉ">s'oBʉshenge Bʉkʉlʉ</char>. <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />Mobaletha abatimo b'amabesɨ bo banegenaga bathɨ: «Omʉndʉ oyu athathangire alika ɨhatsya ko Nyʉmba ya Gongo na ko <char style="w">Mʉgomba</char> wa Mʉsa. <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />Kʉshangwa mothʉmwonvwa nɨanegena athɨ Yesʉ w'iNasareti ashambʉla eNyʉmba ya Gongo n'ɨbɨndʉla emɨbere ethʉ thwahabawa na Mʉsa.» <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />Aboshi bo babyaga bikere mo <char style="w">Bʉshenge Bʉkʉlʉ</char> mobahanda kʉ Sɨtɨfano kw'amesho, na mobashʉnga obʉsʉ bʉwe nɨbwamashosha nga bwa <char style="w">malaɨka</char>.<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s">Ebɨnwa bya Sɨtɨfano</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />Aho <char style="w" lemma="Muheri">omuheri mʉkʉlʉ</char> mwabʉtsya Sɨtɨfano athɨ: «Ebyo abakʉnegenako nɨna bya kwenene?»<verse eid="ACT 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2" />Sɨtɨfano mwashubya athɨ: «Bagala bethʉ n'abo thatha, mʉnyɨhʉlɨkɨrɨtsye. Gongo w'olʉkengerwa mwahʉlʉkɨra thatha-kʉlʉ wethʉ <char style="w">Abʉrahamʉ</char>, abere akɨnalɨ mo kɨhʉgo ky'ɨMesopotamɨa naye niathetsi aya ikala mo muyi w'iHarani, <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />na mwamʉbwɨra athɨ: “Thoka mo kɨhʉgo kyawe na mo lʉganda lwawe, ʉbʉngɨre mo kɨhʉgo nyandakukangya.<note caller="+" style="f"><char style="fr" closed="false">7:3 </char><char style="xt" closed="false">Soma <ref loc="GEN 12:1">Ndangɨro 12:1</ref>.</char></note>” <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />Aho Abʉrahamʉ mwathoka mo kɨhʉgo ky'aBakalitayo na mwayahimba iHarani. Honyuma kw'aho, enyuma w'olʉholo lw'ishe, Gongo mwamuthokya iHarani n'ɨmʉthwala mo kɨhʉgo kɨno kyo mwikeremo lɨno.<verse eid="ACT 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 7:5" />«Gongo mwathamʉhayo bʉthaka, na kiro na hangana n'aherihira ekɨshando kɨwe habye mwandʉ ʉwe. Hewethuwe mwamʉlaga athɨ andamʉha kɨhʉgo, n'engʉmo yɨwe yo yandatsɨmbakyo honyuma kw'ɨye. Ewo, mo mʉgʉlʉ oyo Abʉrahamʉ abyaga niathawithe kʉ mwana. <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />Bɨno byo Gongo amʉbwɨraga: “Engʉmo awe yandayikala mʉ kɨhʉgo kɨthe kyabo, n'eyo bandayabyayo bakobe, eyo bandanubyabo myaka magana ane. <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />Hewethuwe nyandasoha ekɨhʉgo kyo kyandabayɨramo mo bakobe. Honyuma kw'aho bandathokayo na bandanyiramya ho thʉlɨ hano.<note caller="+" style="f"><char style="fr" closed="false">7:6-7 </char><char style="xt" closed="false">Soma <ref loc="GEN 15:13-14">Ndangɨro 15:13-14</ref>; <ref loc="EXO 3:12">Ɨthoka 3:12</ref>.</char></note>” <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />Honyuma kw'aho Gongo mwakola <char style="w">ndagane</char> na Abʉrahamʉ <char style="w" lemma="Ɨmona">erɨmona</char> lyo lyabyaga kɨmɨnyɨkalo <char style="w" lemma="Ndagane">ky'endagane</char> eyo. Bʉshana n'ekyo Abʉrahamʉ <char style="w" lemma="Ɨmona">mwamonia</char> mʉgala ye Isaka ekɨro ky'omʉnanɨ enyuma w'erɨbʉthwa lɨwe. Na kuthyo Isaka <char style="w" lemma="Ɨmona">mwamonia</char> mʉgala Yakobo, na Yakobo <char style="w" lemma="Ɨmona">mwamonia</char> bagala ikumi n'ababɨrɨ, bo thatha-kʉlʉ.<verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />«Abo thatha-kʉlʉ mobafwɨra Yosefʉ mʉlʉmʉna wabo yo mwisho, na mobamʉgʉtsya ayabye mʉkobe mo kɨhʉgo ky'iMisiri. Hewethuwe Gongo abyaga hagʉma naye, <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />mwamuthokya mo malɨgo woshi ayo. Mwaha Yosefʉ yo lʉkogo na bwenge na mwamʉyɨramo mʉndʉ ukwirire embere sa Farao mwamɨ w'iMisiri. Farao oyo mwayɨra Yosefʉ mo muthegeki w'iMisiri na mwimanitsi w'enyʉmba yoshi y'eryamɨ. <verse eid="ACT 7:10" /><verse number="11" style="v" sid="ACT 7:11" />Aho nzala nzɨbʉ moyabya mo kɨhʉgo kyoshi ky'iMisiri na ky'ɨKanana. Amalɨgo abyaga mangɨ kʉtsɨbʉ n'abo thatha-kʉlʉ mobathashʉba bona kalyo. <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />Yakobo abere onvwa kw'iMisiri ɨnalɨ ngano, mwathʉma abo thatha-kʉlʉ bw'erimbere. <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />Babere bayayo erya kabɨrɨ, Yosefʉ mwayikangania kʉ bagala babo, na kuthyo mwakangania Farao yo olʉganda lʉwe. <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />Aho Yosefʉ mwathʉmabo bayalethe Yakobo ishe ʉwe n'olʉganda loshi. N'olʉganda olo, lwabyagamo bandʉ makumi alɨnda na bathano. <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />Aho Yakobo mwaya iMisiri na mwafwɨrayo, n'abandɨ bo thatha-kʉlʉ kuthyo mobafwɨrayo. <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />Honyuma kw'aho mobathwala emɨbɨrɨ yabo y'iSekemu. Mobayathabo mw'ɨsɨnda lyo <char style="w">Abʉrahamʉ</char> agʉlaga mʉ kɨkanda kya faranga kʉ bagala ba Hamori iSekemu.<verse eid="ACT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />«Aho endambi y'endagane yo Gongo alahɨtsɨraya <char style="w">Abʉrahamʉ</char> yabere yashondya ɨbererera, abandʉ bethʉ mobakanya kʉtsɨbʉ mo kɨhʉgo ky'iMisiri. <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />Honyuma kw'aho ʉndɨ mwamɨ yo wabyaga niathetsi Yosefʉ mwathanga ɨthegeka ekɨhʉgo ky'iMisiri. <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />Oyo mwathɨma abandʉ bethʉ n'inubya abo thatha-kʉlʉ nɨahathɨkabo athɨ bagende abashiga esonzolyana sabo s'omo mbʉga bʉshana sɨfwe. <verse eid="ACT 7:19" /><verse number="20" style="v" sid="ACT 7:20" />Mo mʉgʉlʉ oyo mo Mʉsa abʉthawamo, naye abyaga mʉbʉya embere sa Gongo. Mwalemberwa mʉ myetsɨ ishathu mo nyʉmba y'ishe. <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />Naye abere ashiwa embʉga, mwalɨ wa Farao mwamʉbʉgʉla, n'ɨmʉlembera nga mwana ʉwe. <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />Mʉsa mwakangɨrɨtsɨbwa ebɨnwa byoshi by'obwenge bw'iMisiri, mwabya na maka mo bɨnwa na mw'ɨkola.<verse eid="ACT 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23" />«Abere ayɨra myaka makumi ane, mwabyamo omʉthɨma w'erɨyashʉnga bagala babo, <char style="w" lemma="Isiraeli">aBaisiraeli</char>. <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />Eyo mwashʉnga Mumisiri niahumba mʉgʉma w'aBaisiraeli. Aho mwawathikya n'ɨfʉna oMuisiraeli oyo yo wabyaga agonerwe n'itha oMumisiri oyo. <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />Mʉsa mwaganɨtsya athɨ abagala babo bamɨnya ko Gongo ashabʉlabo mʉ mw'ɨmʉtsʉkɨra, he mobathamɨnyabyo. <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />Bwabere bwakya, Mʉsa mweya Baisiraeli babɨrɨ nɨabalwa, mwashondya ɨfʉngʉtsyabo n'ɨnegena athɨ: “Bagala bethʉ, imwe mʉlɨ bagʉma, bʉshana na ki omʉkolerana kʉbɨ?” <verse eid="ACT 7:26" /><verse number="27" style="v" sid="ACT 7:27" />Hewethuwe yo wagenda akolera mulikyabo yo kʉbɨ mwagundula Mʉsa nɨamʉbʉtsya athɨ: “Nɨ ndɨ yo wakuyiriremo mʉkʉlʉ na musohi ethʉ? <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />Ushondya inyitha nga ko withaga oMumisiri yo muligolo?<note caller="+" style="f"><char style="fr" closed="false">7:27-28 </char><char style="xt" closed="false">Soma <ref loc="EXO 2:13-14">Ɨthoka 2:13-14</ref>.</char></note>” <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />Mʉsa abere onvwa ebyo, mwashayɨra mo kɨhʉgo ky'iMitiani n'ikalayo. Eyo mwayabʉthɨrayo bana babɨrɨ.<verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />«Kwabere kwahwa myaka makumi ane, <char style="w">malaɨka</char> wa Nyinya-kowethʉ mwamʉhʉlʉkɨra mo <char style="w">mbwarara</char> hofɨ n'ekɨthwa ky'eSinai mʉ kɨrɨmɨ kya mʉtsanwa w'agenda agʉlʉmɨra mo kɨkala. <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />Mʉsa abere ashʉnga ebyo, mwashweka. Abere anemʉyɨfʉnda hofɨ bʉshana ayɨthegeretsye, mwonvwa omʉlenge wa Nyinya-kowethʉ nɨanegena athɨ: <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />“Ingye ngyo Gongo wa bo sho, Gongo wa <char style="w">Abʉrahamʉ</char> na wa Isaka na wa Yakobo.” Mʉsa mwathithimana bʉshana n'obʉba, mwathanalinda ashʉba ʉshayo amesho. <verse eid="ACT 7:32" /><verse number="33" style="v" sid="ACT 7:33" />Aho Nyinya-kowethʉ mwamʉbwɨra athɨ: “Thokya ebɨrato byawe kʉshangwa ho wimene hano nɨ handʉ <char style="w" lemma="Mubuyirire">habuyirire</char>. <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />Kwenene, nyamashʉnga emɨnʉbo y'abandʉ baye mo kɨhʉgo ky'iMisiri, nyamwonvwa ekɨrɨro kyabo, ewo lɨno nyamakima bʉshana nyɨshabʉlebo. Aho nyakʉthʉma ʉgende iMisiri.<note caller="+" style="f"><char style="fr" closed="false">7:33-34 </char><char style="xt" closed="false">Soma <ref loc="EXO 3:5-10">Ɨthoka 3:5-10</ref>.</char></note>”<verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />«Mʉsa oyo yo aBaisiraeli bathɨndaga balɨ abanegena bathɨ: “Nɨ ɨndɨ yo wakʉyɨragamo mʉkʉlʉ na musohi?” N'ɨye yo Gongo athʉmaga abye mʉkʉlʉ na mushabuli, ɨtsʉkɨra ko <char style="w" lemma="Malaɨka">malaɨka</char> yo wamʉhʉlʉkɨraga mo kɨkala. <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />Nɨ Mʉsa yo wathokaya aBaisiraeli b'iMisiri alɨ akola ebɨthɨko-thɨko na bɨmɨnyɨkalo mo kɨhʉgo ky'iMisiri, na mo ngetsɨ Nyerʉ, na mo <char style="w">mbwarara</char>, mʉ myaka makumi ane. <verse eid="ACT 7:36" /><verse number="37" style="v" sid="ACT 7:37" />Nɨna Mʉsa oyo yo wabwɨraga <char style="w" lemma="Isiraeli">aBaisiraeli</char> athɨ: “Gongo andahulukya mo bagala benyu mo <char style="w" lemma="Mʉmɨnyeretsɨ">mʉmɨnyeretsɨ</char> mʉgʉma yo ʉlɨ ng'ingye.<note caller="+" style="f"><char style="fr" closed="false">7:37 </char><char style="xt" closed="false">Soma <ref loc="DEU 18:15">Ɨbʉka 18:15</ref>,<ref loc="DEU 18:18">18</ref>.</char></note>” <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />Na mo ndambi aBaisiraeli bagenda abahindana mo <char style="w">mbwarara</char>, Mʉsa agenda abya hagʉma na bo thatha-kʉlʉ na <char style="w">malaɨka</char> yo wanegenaga naye ko kɨthwa ky'iSinai. Kandɨ nɨ ɨye yo wahabawa ebɨnwa by'obʉyɨngo bʉshana athʉhebyo.<verse eid="ACT 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39" />«Hewethuwe abo thatha-kʉlʉ mobathatsɨyɨra ishikya Mʉsa, mobamʉthɨnda mo mɨthɨma yabo n'ishondya ɨshʉba iMisiri. <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />Mobabwɨra ye Haruni bathɨ: “Thʉkometsye bo gongo bo bathʉshondola, kʉshangwa ye Mʉsa oyu yo wathuthokaya mo kɨhʉgo ky'iMisiri, thuthetsi ebyo byamuhikire.<note caller="+" style="f"><char style="fr" closed="false">7:40 </char><char style="xt" closed="false">Soma <ref loc="EXO 32:1">Ɨthoka 32:1</ref>,<ref loc="EXO 32:23">23</ref>.</char></note>” <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />Aho mobakomya kɨshoshekano kya kɨnyana, na mobakometsyakyo bʉhere, mobakomya linye lya lʉmogo ko mʉlɨmo w'eminwe yabo. <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />Hewethuwe Gongo mwabɨndʉka kʉbo, na mwalikabo baramye esongununu s'omo lʉbʉla nga ko byashakawa mo kɨtabo <char style="w" lemma="Mʉmɨnyeretsɨ">ky'abamɨnyeretsɨ</char> bɨthɨ:</para>
  <para style="q1" vid="ACT 7:42">“Imwe bandʉ <char style="w" lemma="Isiraeli">b'iIsiraeli</char>,</para>
  <para style="q1" vid="ACT 7:42">n'ingye ngyo mwahereraga esonyama n'awandɨ mahere</para>
  <para style="q1" vid="ACT 7:42">mo myaka makumi ane mo <char style="w">mbwarara</char>?<verse eid="ACT 7:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43" />Ɨhɨ, hewethuwe momwaheka ehema ya gongo wenyu Moloke,</para>
  <para style="q1" vid="ACT 7:43">n'ekɨshoshekano kya ngununu Refani, gongo wenyu</para>
  <para style="q1" vid="ACT 7:43">ekɨshoshekano eki kyo mwayɨkoleraga kʉshangwa muramyekyo.</para>
  <para style="q1" vid="ACT 7:43">Bʉshana n'ekyo nyandabaligitha hale kʉlenga iBabeli.<note caller="+" style="f"><char style="fr" closed="false">7:42-43 </char><char style="xt" closed="false">Soma <ref loc="AMO 5:25-27">Amosi 5:25-27</ref>.</char></note>”<verse eid="ACT 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />«Abo thatha-kʉlʉ babyaga na hema mo <char style="w">mbwarara</char> yo yagenda eyikangania ko Gongo alɨ mo kathi kabo. Ehema eyo moyakomibwa nga ko Gongo ahamʉlaga Mʉsa, ɨkwamana n'omʉhanda akangibawa. <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />Honyuma kw'aho ehema eyo moyashigirwa olʉgero lo lwashʉbʉkaga abo thatha-kʉlʉ. Nabo mobahekaro nɨbashondolerwe na Yoshua ihika ko ndambi banyagʉlaga ekɨhʉgo ky'ebɨhanda byo Gongo aligithaga embere bahike ewabo. N'ehema eyo moyabyaho ihika ko mʉgʉlʉ wa <char style="w">Tawiti</char>. <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />Tawiti oyo mwabona lʉkogo embere sa Gongo, naye mwashaba hamuli bʉshana ahimbire Gongo wa Yakobo yo nyʉmba. <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />Hewethuwe mwabya nɨ Solomona yo wamuhimbiraga enyʉmba. <verse eid="ACT 7:47" /><verse number="48" style="v" sid="ACT 7:48" />Hewethuwe Gongo w'elʉgʉlʉ athikala mʉ manyʉmba athahimbwa mʉ minwe ya bandʉ, nga ko <char style="w" lemma="Mʉmɨnyeretsɨ">mʉmɨnyeretsɨ</char> anegenaga athɨ:<verse eid="ACT 7:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49" />“Nyinya-kowethʉ athɨ:</para>
  <para style="q1" vid="ACT 7:49">‘Olʉbʉla kyo kifumbi kyaye ky'obwamɨ,</para>
  <para style="q1" vid="ACT 7:49">n'ekɨhʉgo kyo kiryathiro ky'ebɨshando byaye.</para>
  <para style="q1" vid="ACT 7:49">Nɨ nyʉmba yɨrɨ yɨthɨ yo mwanganyihimbira?</para>
  <para style="q1" vid="ACT 7:49">Na nɨ hayi ho nyangalʉhʉkɨra?<verse eid="ACT 7:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50" />Eminwe aye yo yɨthabʉmbaga ebɨndʉ byoshi ebi?<note caller="+" style="f"><char style="fr" closed="false">7:49-50 </char><char style="xt" closed="false">Soma <ref loc="ISA 66:1-2">Isaya 66:1-2</ref>.</char></note>’”»<verse eid="ACT 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />Sɨtɨfano mwashʉba negena athɨ: «Imwe bandʉ ba mathwi matsɨbʉ, imwe b'emɨthɨma ithikiritsye n'amathwi ahʉmene, ebɨro byoshi omʉlwa <char style="w" lemma="Mʉthɨma Mwerʉ">n'oMʉthɨma Mwerʉ</char>, nga ko bo thatha-kʉlʉ bakolaga! <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />Nɨ ɨndɨ mo <char style="w" lemma="Mʉmɨnyeretsɨ">bamɨnyeretsɨ</char> boshi yo bo thatha-kʉlʉ bathagatsaya? Nabo mobitha abo bathangaga ɨfʉla omwatsɨ w'erihika ly'oMʉthʉnganene, na nɨ ɨye yo mwahotheraga n'imwitha. <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />Imwe mo <char style="w" lemma="Malaɨka">bamalaɨka</char> bahaga <char style="w" lemma="Mʉgomba">oMʉgomba</char> wa Gongo he momuthashikyawo!»<verse eid="ACT 7:53" /></para>
  <para style="s">Sɨtɨfano ithwa mʉ mabwe</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />Ab'omo Bʉshenge Bʉkʉlʉ babere bonvwa ebɨnwa ebyo mobakapɨkɨra, n'ishyera Sɨtɨfano y'ameno. <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />Naye anotswiremo <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char>, mwashʉmbɨra amesho w'elʉbʉla, mwashʉnga olʉkengerwa lwa Gongo na Yesʉ n'imene ko kʉboko kw'amalyo kwa Gongo. <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />Sɨtɨfano mwanegena athɨ: «Mʉhʉlɨkɨrɨtsye, enyɨshʉnga olʉbʉla nilukingwire, na <char style="w">Mʉgala w'oMʉndʉ</char> n'imene ko kʉboko kw'amalyo kwa Gongo.» <verse eid="ACT 7:56" /><verse number="57" style="v" sid="ACT 7:57" />Aho mobahambala kʉtsɨbʉ nibanatsibire amathwi wabo, na mobamʉgʉlʉkɨra aboshi kʉgʉmerera. <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />Mobamʉkʉrɨra embʉga y'omuyi n'ɨmʉgʉshangako amabwe bʉshana bamwithe. N'abatimo mobahira esongɨmba sabo s'oko bɨshando bya mʉthabana mʉgʉma erɨtsɨna lɨwe nɨ yo Sauli. <verse eid="ACT 7:58" /><verse number="59" style="v" sid="ACT 7:59" />Babere bane mumuhumanga amabwe, Sɨtɨfano mwashaba athɨ: «Nyinya-kowethʉ Yesʉ, wangɨrɨra omʉthɨma aye!» <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />Honyuma kw'aho mwafʉkama na mwalaka mʉ mʉlenge mʉnene athɨ: «Nyinya-kowethʉ, ʉthaganzɨragabo ekɨtsɨbʉ eki!» Abere amamala ɨnegena ebɨnwa ebyo, mwatsa omʉthɨma.<figure style="fig" alt="Stephane est lapide" file="cn02154.jpg" size="col" ref="7:58-60">Sɨtɨfano ithwa mu mabwe</figure><verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />Na Sauli abyaga n'imire olʉholo lwa Sɨtɨfano.</para>
  <para style="s" vid="ACT 8:1">Sauli anubya akanisa</para>
  <para style="p" vid="ACT 8:1">Ɨthanga ekɨro ekyo malɨgo mangɨ mwahikira <char style="w" lemma="Kanisa">akanisa</char> k'ɨYerʉsalemʉ. Abɨkɨrɨtsya boshi erithokyako <char style="w" lemma="Bathʉmwa">abathʉmwa</char> basha, mobasanzabana mo kɨhʉgo kyoshi ky'iYuteya na eky'ɨSamarɨa. <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />Abandʉ bo babyaga bashikitsye Gongo mobayatha Sɨtɨfano, mobamʉlɨra kʉtsɨbʉ. <verse eid="ACT 8:2" /><verse number="3" style="v" sid="ACT 8:3" />Hewethuwe ye Sauli agenda anubya <char style="w" lemma="Kanisa">akanisa</char>, agenda ɨngɨra mo bʉlɨ nyʉmba n'ɨkʉra abayira n'abakatsɨ n'ɨyagʉshabo mo muliki.<verse eid="ACT 8:3" /></para>
  <para style="s">Filipo afʉla eNgʉlʉ Mbʉya ɨSamarɨa</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />Abɨkɨrɨtsya bo basanzabanibawa bagenda abaya ahoshi-hoshi nɨabafʉla <char style="w" lemma="Ngʉlʉ Mbʉya">eNgʉlʉ Mbʉya</char>. <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />Filipo mwagenda mo muyi mʉkʉlʉ w'ekɨhʉgo ky'ɨSamarɨa na mwathanga ɨfʉlɨra abandʉ b'omwatsɨ wa <char style="w" lemma="Kirisito, Masia">Kirisito</char>. <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />Abahimbani boshi babere bonvwa n'ɨshʉnga ko bɨmɨnyɨkalo ebyo Filipo agenda akola, mobathegera ebɨnwa bɨwe by'amathwi. <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />Aho <char style="w" lemma="Batsɨmʉ">abatsɨmʉ</char> bagenda abathoka ko bandʉ bangɨ nɨabahambala mʉ mʉlenge mʉnene, na bandʉ bangɨ b'amakonongola n'ebɨrema mobalama. <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />Aho olʉmogo molwabya lʉnene mo muyi oyo.<verse eid="ACT 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />Mʉndʉ mʉgʉma yo wagenda ahʉlwamo Simoni abyaga nɨamamala mo muyi oyo bɨro bɨthe bɨke. Agenda akola bukumu n'ishwekya abandʉ b'ɨSamarɨa. Agenda anegena athɨ ɨye nɨ mʉndʉ mʉkʉlʉ kʉtsɨbʉ. <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />N'aboshi, ɨthanga ko balere n'ihika ko bakʉlʉkʉlʉ, bagenda abamʉthega amathwi, nɨabanegena bathɨ: «Omʉndʉ oyu nɨ maka wa Gongo, wo anahʉlwamo “Maka Makʉlʉ”.» <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />Bagenda abamʉhʉlɨkɨrɨtsya kʉtsɨbʉ, kʉshangwa mokwahwa bɨro bɨngɨ analɨ ashwekyabo mo bukumu bʉwe. <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />Hewethuwe babere bɨkɨrɨtsya <char style="w" lemma="Ngʉlʉ Mbʉya">eNgʉlʉ Mbʉya</char> yo Filipo agenda afʉlɨrabo bʉshana <char style="w" lemma="Bwamɨ bwa Gongo">n'oBwamɨ bwa Gongo</char> n'erɨtsɨna lya Yesʉ <char style="w" lemma="Kirisito, Masia">Kirisito</char>, abayira n'abakatsɨ <char style="w" lemma="Lubatiso">mobabatisibwa</char>. <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />Na Simoni yo wene-wene mwɨkɨrɨtsya <char style="w" lemma="Lubatiso">n'ibatisibwa</char>. Mwabya hagʉma na Filipo naye mwashweka kʉtsɨbʉ alɨashʉnga ko bɨmɨnyɨkalo na emɨkolano y'amaka byo byagenda ebɨkoleka.<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />
    <char style="w" lemma="Bathʉmwa">Abathʉmwa</char> bo babyaga ɨYerʉsalemʉ babere bonvwa kw'abandʉ b'ɨSamarɨa bamɨkɨrɨtsya <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char>, aho mobathʉmɨrabo Petero na Yoani. <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />Babere bahika ɨSamarɨa, mobashabɨra abɨkɨrɨtsya bʉshana bangɨrɨre <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char>. <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />Kʉshangwa babyaga nɨbamamala <char style="w" lemma="Lubatiso">ibatisibwa</char> kuroshi mw'ɨtsɨna lya Nyinya-kowethʉ Yesʉ, hewethuwe oMʉthɨma Mwerʉ abyaga niathetsi akimira kʉ mʉgʉma wa kʉbo. <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />Aho Petero na Yoani mobahira kʉbo kw'eminwe na mobangɨrɨra <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char>.<verse eid="ACT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18" />Simoni abere ashʉnga <char style="w" lemma="Mʉthɨma Mwerʉ">kw'oMʉthɨma Mwerʉ</char> amahabwa abɨkɨrɨtsya mo ndambi <char style="w" lemma="Bathʉmwa">abathʉmwa</char> bahiraga kʉbo kw'eminwe, mwalethera Petero na Yoani bo faranga <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />n'ɨnegena athɨ: «Nangye mʉnyɨhe amaka ayo, kʉshangwa abo nyandahirako eminwe babone <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char>.» <verse eid="ACT 8:19" /><verse number="20" style="v" sid="ACT 8:20" />Hewethuwe Petero mwamʉshʉbɨtsya athɨ: «Ubihibwe ɨwe n'esofaranga sawe, kʉshangwa moʉganɨtsya ʉthɨ olʉhembo lwa Gongo olʉnagʉlwa mʉ faranga! <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />Uthawithe mʉhango kandɨ ʉthatholere mo mwatsɨ ono, kʉshangwa omʉthɨma awe athathʉnganene embere sa Gongo. <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />Bʉshana n'ekyo ʉbɨndʉke ɨthoka mo bɨbɨ byawe na ʉshabe Nyinya-kowethʉ kʉthɨ anganakʉganyɨra ko mɨganɨtsye awe mɨbɨ eyi. <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />Nyamashʉnga kwenene ko wotswiremo mwisho mʉngɨ na ʉlɨ mo muliki w'ebɨtsɨbʉ.» <verse eid="ACT 8:23" /><verse number="24" style="v" sid="ACT 8:24" />Aho Simoni mwabwɨra Petero bana Yoani athɨ: «Imwe bene mʉnyɨshabɨre kʉ Nyinya-kowethʉ, kʉshangwa kuthabyaga ekyanyihikira ko byoshi byo mwamanegena.»<verse eid="ACT 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25" />Petero na Yoani babere bamamala ɨfʉla omwatsɨ w'ebyo bashʉngaga, n'ɨkangɨrɨtsya eKɨnwa kya Nyinya-kowethʉ, mobashʉba ɨYerʉsalemʉ. Mo nzɨra mobagenda nɨabafʉla <char style="w" lemma="Ngʉlʉ Mbʉya">eNgʉlʉ Mbʉya</char> y'omo mɨrongo mɨngɨ y'omo kɨhʉgo <char style="w" lemma="Basamarɨa">ky'ɨSamarɨa</char>.<verse eid="ACT 8:25" /></para>
  <para style="s">Filipo n'omʉsagarwa w'iEtiopia</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />
    <char style="w" lemma="Malaɨka">Malaɨka</char> mʉgʉma wa Nyinya-kowethʉ mwabwɨra Filipo athɨ: «Wagenda ko lʉnda lwa kihya<note caller="+" style="f"><char style="fr" closed="false">8:26 </char><char style="fq" closed="false">Lʉnda lwa kihya </char><char style="ft" closed="false">kʉtse </char><char style="fq" closed="false">kathi ka mwɨshɨ.</char></note>, omo ndaki yo ɨthoka ɨYerʉsalemʉ n'ikimira ɨNgasa. Enzɨra eyo yitsukire mo <char style="w">mbwarara</char>.» <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />Aho Filipo mwabathʉka n'ɨgenda. Na mo ndaki eyo, mokwahʉlʉka muyira mʉgʉma, abyaga mʉsagarwa w'iEtiopia, na mukoli mʉkʉlʉ yo wabyaga mwimanitsi w'obushoki bwa Kandake,<note caller="+" style="f"><char style="fr" closed="false">8:27 </char><char style="fq" closed="false">Kandake </char><char style="ft" closed="false">lɨthalɨ ɨtsɨna lya mʉndʉ, hewethuwe nɨ mʉthɨ wa lyamɨ. Wahʉla mwamɨ-katsɨ w'iEtiopia, nga Farao w'iMisiri.</char></note> omwamɨ-katsɨ w'iEtiopia. Abyaga niamahika ɨYerʉsalemʉ bʉshana n'iyaramya Gongo, <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />nɨ alɨ mʉ lʉgendo lw'ɨshʉba ewe. Abyaga n'ikere mo mutukali ʉwe, agenda asoma ekɨtabo <char style="w" lemma="Mʉmɨnyeretsɨ">ky'omʉmɨnyeretsɨ</char> Isaya. <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" /><char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> mwabwɨra Filipo athɨ: «Yɨfʉnde ahalɨ omutukali ola.» <verse eid="ACT 8:29" /><verse number="30" style="v" sid="ACT 8:30" />Filipo mwangʉha tsʉba ahalɨ omutukali, mwonvwa oMuetiopia nɨasoma ekɨtabo <char style="w" lemma="Mʉmɨnyeretsɨ">ky'omʉmɨnyeretsɨ</char> Isaya. Mwamʉbʉtsya athɨ: «Unonvwire ebyo ʉsoma?» <verse eid="ACT 8:30" /><verse number="31" style="v" sid="ACT 8:31" />Naye mwashʉbɨtsya Filipo athɨ: «Nyangonvwabyo nyɨthɨ nyithawithe yo ʉnyɨkangɨrɨtsyabyo?» Na mwabɨrɨkɨra Filipo athɨ ɨrʉkɨre mo mutukali ʉwe ikale ho mʉsɨke kw'ɨye. <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />Kɨno kyo kɨhande <char style="w" lemma="Mashako Abuyirire">ky'aMashako Abuyirire</char> kyo agenda asoma:</para>
  <para style="q1" vid="ACT 8:32">«Mwabya nga mbuli yo bagenda abathwala mo lʉkerero.</para>
  <para style="q1" vid="ACT 8:32">Nga kyana kya mbuli kyo kihulikirire embere y'abo batsa kʉkyo kw'ebyoya,</para>
  <para style="q1" vid="ACT 8:32">mwathamamʉla obʉnʉ bʉwe.<verse eid="ACT 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33" />Mw'ɨsʉnzʉgʉrwa mw'imwa ebyo abyaga asɨngeneko.</para>
  <para style="q1" vid="ACT 8:33">Nɨ ɨndɨ yo wandanegena ko ngʉmo yɨwe?</para>
  <para style="q1" vid="ACT 8:33">Kʉshangwa mobamʉmalɨra obʉyɨngo bʉwe ko kɨhʉgo.<note caller="+" style="f"><char style="fr" closed="false">8:32-33 </char><char style="xt" closed="false">Soma <ref loc="ISA 53:7-8">Isaya 53:7-8</ref>.</char></note>»<verse eid="ACT 8:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 8:34" />Omʉsagarwa mwabʉtsya Filipo athɨ: «Enyɨkʉshaba, nyɨbwɨre <char style="w" lemma="Mʉmɨnyeretsɨ">ng'omʉmɨnyeretsɨ</char> oyu nga anegena athyo kʉ ndɨ? Ewono, nɨ kw'ɨye yowene kʉtse kʉ ʉndɨ mʉndʉ?» <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />Aho Filipo mwathangɨra ko <char style="w">Mashako Abuyirire</char> ayo, mwamʉfʉlɨra <char style="w" lemma="Ngʉlʉ Mbʉya">eNgʉlʉ Mbʉya</char> ya Yesʉ.<figure style="fig" alt="Philipe enseigne l'eunuque d'Ethiopie" file="cn01932.jpg" size="col" ref="8:35">Filipo afʉla eNgʉlʉ Mbʉya ko Muetiopia</figure><verse eid="ACT 8:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 8:36" />Mobalotsya ebʉshondotsɨ mo lʉgendo lwabo, na mobahika halɨ metsi. Aho omʉsagarwa oyo mwabwɨra Filipo athɨ: «Shʉnga, ametsi waya. Ni ki kyo kyangaleka <char style="w" lemma="Lubatiso">ninyithabatisibwa</char>?» [<verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" />Filipo mwamʉshʉbɨtsya athɨ: «Wamɨkɨrɨtsya n'omʉthɨma awe woshi wangabatisibwa.» N'omuyira oyo mwashubya athɨ: «Nyɨkɨrɨtsye ko Yesʉ Kirisito nɨ <char style="w">Mʉgala wa Gongo</char>.»<note caller="+" style="f"><char style="fr" closed="false">8:37 </char><char style="ft" closed="false">Omʉlondo ono athalɨ mʉ wandɨ mashako magʉma wa kera.</char></note>] <verse eid="ACT 8:37" /><verse number="38" style="v" sid="ACT 8:38" />Honyuma kw'aho, mwimania omutukali. Filipo mwakima hagʉma naye mo metsi <char style="w" lemma="Lubatiso">n'imubatisya</char>. <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />Babere bathoka mo metsi, <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma</char> wa Nyinya-kowethʉ mwabulirania Filipo. N'omʉsagarwa oyo mwathashʉba mʉshʉngako, he mwalotsya ebʉshondotsɨ niamogire kʉtsɨbʉ. <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />Filipo mwayeya mo muyi w'ɨAsoto. Honyuma kw'aho mwatsʉka muyi ku muyi alɨ afʉla <char style="w" lemma="Ngʉlʉ Mbʉya">eNgʉlʉ Mbʉya</char> y'ahoshi, ihika ko ndambi mwahika mo muyi w'iKaisaria.<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s">Erɨbɨrɨkɨrwa lya Sauli</para>
  <para style="r">(<ref loc="ACT 22:6-16">Mɨko 22:6-16</ref>; <ref loc="ACT 26:12-18">26:12-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />Mo ndambi eyo Sauli mwathalika bɨʉbahɨrɨtsyo bya bwithi ko <char style="w" lemma="Abɨga">bɨga</char> ba Nyinya-kowethʉ. Mwaya eyɨrɨ <char style="w" lemma="Muheri">omuheri mʉkʉlʉ</char>, <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />n'ɨmʉshaba marʉba w'ɨmʉmɨnyɨsa ko so<char style="w" lemma="Sinakoki:">sinakoki</char> s'iTamasiki, athɨ ameyayo bayira kʉtse bakatsɨ bo bakwamire eNzɨra ya Nyinya-kowethʉ, amɨnebo n'ɨthwalabo ɨYerʉsalemʉ.<verse eid="ACT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 9:3" />Abere akɨnalɨ mo nzɨra y'iTamasiki, nɨahera hofɨ n'omuyi oyo, aho n'aho ekyakakala kyo kyathokaga mo lʉbʉla mokyamʉkoletsya ko mbande soshi. <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />Mwawa ahishi n'ɨonvwa mʉlenge nɨamʉbwɨra athɨ: «Sauli, Sauli, bʉshana na ki unyinubya?» <verse eid="ACT 9:4" /><verse number="5" style="v" sid="ACT 9:5" />Na Sauli mwabʉtsya athɨ: «Ʉlɨ ndɨ no Nyinya-kowethʉ?» N'omʉlenge mwashubya athɨ: «Ni ingye Yesʉ ngyo unubya. <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />Hewethuwe wimana na wɨngɨre mo muyi, n'omo bakʉbwɨra ebyo wakola.» <verse eid="ACT 9:6" /><verse number="7" style="v" sid="ACT 9:7" />Abagendania ba Sauli mobimana bʉthanegena kɨnwa, mobonvwa omʉlenge, hewethuwe mobathashʉnga mʉndʉ. <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />Sauli mwimana ɨthoka ko kɨthaka, mwatsɨbʉla amesho, hewethuwe niathakilolire. Mobamʉtsɨmba ko kʉboko n'ɨmʉthwala iTamasiki. <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />Mʉ bɨro bɨshathʉ mwathakotsya ɨlola na mwabya buthalya na bʉthashoma.<figure style="fig" alt="La conversion de Saul" file="wa03960.jpg" size="col" ref="9:3-4">Sauli abɨrɨkɨrwa na Yesʉ</figure><verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />iTamasiki yabyaga <char style="w" lemma="Abɨga">mwɨga</char> yo wagenda ahʉlwamo Ananɨa. Nyinya-kowethʉ mwamʉhʉlʉkɨra mʉ humanani n'ɨmʉbɨrɨkɨra athɨ: «Ananɨa!» Naye mwashubya athɨ: «Ingye ono mbe Nyinya-kowethʉ.» <verse eid="ACT 9:10" /><verse number="11" style="v" sid="ACT 9:11" />Nyinya-kowethʉ mwamʉbwɨra athɨ: «Ʉgende lɨno-lɨno mo nzɨra yo yɨnahʉlwamo “Ɨthʉnganene,” na mo nyʉmba ya Yuta wabʉtsyamo mʉndʉ mʉgʉma w'ɨTarɨso erɨtsɨna lɨwe yo Sauli. Ashaba ko ndambi eno. <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />Sauli naye mwashʉnga mo humanani mo mʉndʉ mʉgʉma, erɨtsɨna lɨwe nɨ yo Ananɨa, n'ɨngɨra n'ihira eminwe yo kw'ɨye kʉshangwa ashʉbe lola.»<verse eid="ACT 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13" />Ananɨa mwashubya athɨ: «Nyinya-kowethʉ, bandʉ bangɨ mobanyɨsɨmolera ko mʉndʉ oyo, na mobanyɨganʉlɨra ebɨbɨ akoleraga abɨkɨrɨtsya bawe ɨYerʉsalemʉ. <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />Na yono amahika kʉno na maka athahabwa <char style="w" lemma="Muheri">n'abakʉlʉ b'abaheri</char> bʉshana n'ɨmɨna aboshi bo bashaba kw'ɨtsɨna lyawe.» <verse eid="ACT 9:14" /><verse number="15" style="v" sid="ACT 9:15" />Hewethuwe Nyinya-kowethʉ mwamʉbwɨra athɨ: «Genda, kʉshangwa monyashombwere omʉndʉ oyo bʉshana anyɨkolere mw'ikangania erɨtsɨna lyaye ly'oko bandʉ b'ebɨhanda na ko bamɨ kuthyo na ko <char style="w" lemma="Isiraeli">Baisiraeli</char>. <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />Ingye owene-wene nyamukangya ko atholere ɨagalwa kʉtsɨbʉ bʉshana nangye.»<verse eid="ACT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17" />Aho, Ananɨa mwagenda, mwɨngɨra mo nyʉmba, mwahira kʉ Sauli kw'eminwe n'ɨmʉbwɨra athɨ: «Sauli mʉgala ethʉ, Nyinya-kowethʉ Yesʉ yo ʉthakʉhʉlʉkɨra mo nzɨra yo ʉthahʉlʉkamo, yo wamanyɨthʉma kʉshangwa ʉshʉbe lola, na wotsulemo <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char>.» <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />Aho n'aho ebɨndʉ ebɨrɨ nga bɨkora mobyathogonga mo mesho wa Sauli, mwashʉba lola. Mwimana na <char style="w" lemma="Lubatiso">mwabatisibwa</char>. <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />Honyuma kw'aho mwalya, mwashʉba bona kagala.</para>
  <para style="s" vid="ACT 9:19">Sauli afʉla eNgʉlʉ Mbʉya y'iTamasiki</para>
  <para style="p" vid="ACT 9:19">Sauli mwikala bɨro bɨke hagʉma <char style="w" lemma="Abɨga">n'abɨga</char> abo babyaga iTamasiki. <verse eid="ACT 9:19" /><verse number="20" style="v" sid="ACT 9:20" />Aho n'aho mwathanga ɨkangɨrɨtsya mo <char style="w" lemma="Sinakoki">sosinakoki</char> athɨ Yesʉ nɨ <char style="w">Mʉgala wa Gongo</char>. <verse eid="ACT 9:20" /><verse number="21" style="v" sid="ACT 9:21" />Aboshi bo bagenda abamwonvwa bagenda abashweka n'ɨyɨbʉtsya bathɨ: «Athalɨ omʉndʉ oyu yo wagenda anubya kʉtsɨbʉ abandʉ bo banashaba kw'ɨtsɨna lya Yesʉ ɨYerʉsalemʉ? Na kandɨ athalɨ athahika kʉno nɨalɨ mʉ menge w'ɨmɨna abandʉ n'ɨthwalabo eyɨrɨ <char style="w" lemma="Muheri">abakʉlʉ b'abaheri</char>?» <verse eid="ACT 9:21" /><verse number="22" style="v" sid="ACT 9:22" />Hewethuwe Sauli agenda abona maka kʉtsɨbʉ, na agenda akangania kundu ko Yesʉ yo <char style="w" lemma="Kirisito, Masia">Kirisito</char>. <char style="w" lemma="Bayuta">N'aBayuta</char> b'iTamasiki mobathabona kɨnwa ky'erishubya.<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />Kwabere kwatsʉka bɨro bɨngɨ, <char style="w" lemma="Bayuta">aBayuta</char> mobaya nama y'itha Sauli, <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />hewethuwe Sauli mwamɨnya enama eyo. Bagenda abatheya esongyo s'erɨngɨra mo muyi kɨro na mwɨshɨ kʉshangwa bamwithe. <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />Aho kɨro kɨgʉma mo kɨro, <char style="w">abɨga</char> bʉwe mobamʉheka, mobamukimya mʉ kɨthonga kɨnene ko rʉba lw'omuyi.<figure style="fig" alt="A l' aide d' un panier, on descend Saul le long de la cloture" file="lb00333.jpg" size="col" ref="9:25">Sauli akimibwa mʉ kɨthonga ko rʉba lw'omuyi w'iTamasiki</figure><verse eid="ACT 9:25" /></para>
  <para style="s">Sauli ashʉba ɨYerʉsalemʉ</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />Sauli abere ahika ɨYerʉsalemʉ agenda ashondya iyihira hagʉma <char style="w" lemma="Abɨga">n'abɨga</char>. Hewethuwe aboshi bagenda abamʉbaha kʉshangwa mobathɨkɨrɨtsya kw'amalire ibya <char style="w" lemma="Abɨga">mwɨga</char>. <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />Aho ye Baranaba mwathwala Sauli, n'imuhikya ahalɨ <char style="w" lemma="Bathʉmwa">abathʉmwa</char> n'ɨsɨmolerabo ko Sauli athashʉnga Nyinya-kowethʉ mo nzɨra na ko Nyinya-kowethʉ athasɨmola naye. Na kandɨ mwabwɨrabo ko Sauli mwakangɨrɨtsya abandʉ bʉtsɨra bʉba mw'ɨtsɨna lya Yesʉ iTamasiki. <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />Aho, Sauli mwikala hagʉma nabo, agenda athimba nabo mo Yerʉsalemʉ yoshi, agenda akangɨrɨtsya mw'ɨtsɨna lya Nyinya-kowethʉ bʉtsɨra bʉba. <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />Agenda asɨmola n'ikubisania n'aBayuta bo bagenda abanegena <char style="w" lemma="Bakiriki">ekikiriki</char>, he ɨbo mobashondya imwitha. <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />Abagala bethʉ bɨkɨrɨtsya babere bamɨnya omwatsɨ oyo, mobaheka Sauli, mobamʉthwala mo muyi w'iKaisaria, na mobamʉthʉma mo muyi w'ɨTarɨso.<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />Mo mʉgʉlʉ oyo <char style="w" lemma="Kanisa">akanisa</char> k'omo kɨhʉgo kyoshi ky'iYuteya na ky'iNgalilaya, na ky'ɨSamarɨa mokabya na bʉholo. <char style="w" lemma="Kanisa">Akanisa</char> mokashika mo lwɨkɨrɨtsyo n'ishikya Nyinya-kowethʉ, n'ɨlʉga bʉshana n'obuwathikya <char style="w" lemma="Mʉthɨma Mwerʉ">bw'oMʉthɨma Mwerʉ</char>.<verse eid="ACT 9:31" /></para>
  <para style="s">Aineya alamibwa</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />Mo ndambi Petero agenda athimba mo kɨhʉgo kyoshi, kɨro kɨgʉma mwahika ew'abɨkɨrɨtsya bo babya nibikere mo muyi w'iLuta. <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />Mweyayo mʉndʉ mʉgʉma yo wagenda ahʉlwamo Aineya yo wabyaga nɨalɨ ko ngɨngo mʉ myaka mʉnanɨ bʉshana n'obukoni bw'amakonongola. <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />Petero mwamʉbwɨra athɨ: «Aineya, Yesʉ <char style="w" lemma="Kirisito, Masia">Kirisito</char> amakulamya. Hangana na ʉyɨsheshere engɨngo awe.» Aho n'aho Aineya mwahangana. <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />Abandʉ boshi b'omo muyi w'iLuta na mw'ibanda lya Saroni babere bamʉshʉnga mobabɨndʉkɨra Nyinya-kowethʉ.<verse eid="ACT 9:35" /></para>
  <para style="s">Erilubuka lya Thabitha</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />Mo muyi w'ɨYopa mwabyaga <char style="w" lemma="Abɨga">mʉkatsɨ mʉgʉma mwɨga</char> yo wagenda ahʉlwamo Thabitha. Erɨtsɨna lya Thabitha mo kikiriki nɨ Torika, n'ɨnegena mbʉ: «shuku». Omʉkatsɨ oyo agenda akola bɨbʉya ebɨro byoshi n'iwathikya abatsene. <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />Ko mʉgʉlʉ oyo mwalwala n'ihika kw'ɨfwa. Babere bamamala inabya omʉbɨrɨ ʉwe, mobamuhira mʉ kɨshenge kɨgʉma mo ngorofa. <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" /><char style="w">Abɨga</char> b'ɨYopa mobonvwa ko Petero alɨ iLuta, muyi walɨ hofɨ n'ɨYopa. Mobamʉthʉmɨra bagendi babɨrɨ n'omwatsɨ ono: «Othʉkʉshaba thʉthɨ uhike eno bʉthathɨndɨra.» <verse eid="ACT 9:38" /><verse number="39" style="v" sid="ACT 9:39" />Aho n'aho Petero mwagenda hagʉma nabo. Babere bahikayo, mobamʉthwala mo kɨshenge kyabyaga mo ngorofa. Abashʉmbakatsɨ boshi mobayɨfʉnda hofɨ naye nɨabalɨra, niabamukangya eso ropo na sɨndɨ ngɨmba eso Torika alandɨragabo abere akɨnalɨho.<verse eid="ACT 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 9:40" />Petero mwahulukya abandʉ boshi, mwafʉkama n'ɨshaba. Honyuma kw'aho mwabɨndʉkɨra ekinda n'ɨnegena athɨ: «Thabitha, hangana!» Thabitha mwatsɨbʉla amesho, abere ashʉnga Petero, mwayimanika n'ikala. <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />Petero mwamʉtsɨmba ko kʉboko n'imuwathikya kw'imwimania. Honyuma kw'aho mwabɨrɨkɨra abɨkɨrɨtsya n'abashʉmbakatsɨ, na mwamukanganiabo nɨahera mʉndʉ ʉlɨho. <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />Omwatsɨ oyo mwamɨnyɨkala mo muyi woshi w'ɨYopa, na bandʉ bangɨ mobɨkɨrɨtsya Nyinya-kowethʉ. <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />Petero mwikala bɨro bɨngɨ ɨYopa howa mʉndʉ mʉgʉma mukoli wa ngobi yo wagenda ahʉlwamo Simoni.<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s">Petero abɨrɨkɨrwa ewa Koroneri</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />Mo muyi w'iKaisaria mwabyaga mʉndʉ mʉgʉma, erɨtsɨna lɨwe agenda ahʉlwamo Koroneri. Koroneri oyo abyaga mʉkʉlʉ w'ekɨkembe ky'abashirikani ba Baroma kyo kyagenda ekyahʉlwamo «Kɨkembe ky'aBaitalia.» <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />Omʉndʉ oyo abyaga niubahire Gongo n'imuramya hagʉma n'abandʉ boshi bo babyaga mo nyʉmba yɨwe. Agenda awathikya kʉtsɨbʉ aBayuta batsene, na agenda ashaba Gongo ko bʉlɨ ndambi. <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />Kɨro kɨgʉma mwigolo ko saha mwenda, mwashʉnga humanani, na mo humanani eyo mwashʉnga kʉbʉya-kʉbʉya <char style="w">malaɨka</char> wa Gongo mwɨngɨra omwe n'ɨmʉbɨrɨkɨra athɨ: «Koroneri!» <verse eid="ACT 10:3" /><verse number="4" style="v" sid="ACT 10:4" />Koroneri mwahanda amesho wo kʉ malaɨka n'obʉba n'ɨmʉbwɨra athɨ: «Nyinya-kowethʉ, kwamabya ki?» Malaɨka mwamʉshʉbɨtsya athɨ: «Gongo amatsɨga emɨshabe awe n'ebɨbʉya ʉnakolera abatsene naye athakwibirirwe. <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />Ewo, thʉma bandʉ ɨYopa bagende bayalethe mʉndʉ mbʉ yo Simoni yo ʉnahʉlwamo Petero. <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />Nɨ mugeni wa mʉndʉ mʉgʉma mukoli wa ngobi yo ʉnahʉlwamo Simoni. Enyʉmba yɨwe yɨrɨ ko mʉsɨke w'engetsɨ.»<verse eid="ACT 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 10:7" />
    <char style="w" lemma="Malaɨka">Malaɨka</char> oyo wanegenaga naye abere amamala ɨgenda, Koroneri mwabɨrɨkɨra babɨrɨ ba ko bakoli bʉwe na mʉgʉma wa ko bashirikani bʉwe. Omushirikani oyo abyaga niashikitsye Gongo na Koroneri niayinihire ɨye. <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />Mwabwɨrabo ebyoshi byatsʉkaga, honyuma kw'aho mwathʉmabo ɨYopa.<verse eid="ACT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />Bwabere bwakya, babere bakɨnalɨ mo nzɨra hofɨ n'omuyi w'ɨYopa, Petero mwaya ko lʉthwe<note caller="+" style="f"><char style="fr" closed="false">10:9 </char><char style="ft" closed="false">Manyʉmba mangɨ w'aBayuta mo mʉgʉlʉ oyo abyaga na nyɨthwe sɨlambathɨkene aho abandʉ bangikere n'ɨlʉhʉkɨraho, n'abandʉ bagenda abɨrʉkɨraho kʉ kɨrʉkɨro. Shʉnga eshoshani mʉ </char><char style="xt" closed="false"><ref loc="LUK 5:19">Luka 5:19</ref>.</char></note> kw'elʉgʉlʉ hofɨ kathi ka mwɨshɨ bʉshana n'ɨya shaba. <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />Mwafwa nzala na mwashondya irya. Babere banalɨ abamʉthekera akalyo, mwabya nga amalekʉla, <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />na mwashʉnga olʉbʉla nɨ lwamakɨngʉkala, na kɨndʉ kɨgʉma kyagendaga ekikima kishoshire nga lʉkɨmba lʉnene, olukimibwa ahishi ni lutsimbirwe ko mbande ine. <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />Namo mwabyaga mɨhanda yoshi y'esonyama s'ebɨrenge bɨne, n'esonyama eso sɨnagendera ahishi ko nda, na mɨhanda yoshi y'ebɨronge. <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />Aho mwonvwa mʉlenge nɨamʉbwɨra athɨ: «Petero, hangana, kera na ulye!» <verse eid="ACT 10:13" /><verse number="14" style="v" sid="ACT 10:14" />Hewethuwe Petero mwashubya athɨ: «Oh, ɨhɨ mbe Nyinya-kowethʉ, kʉshangwa nyɨthahera nyathalya kɨndʉ kɨthatholere kʉtse kitherire.» <verse eid="ACT 10:14" /><verse number="15" style="v" sid="ACT 10:15" />Omʉlenge mwashʉba onvwɨka n'ɨmʉbwɨra athɨ: «Ebyo Gongo athetsya, ʉthahʉlaga mʉbyo mo bitherire.<note caller="+" style="f"><char style="fr" closed="false">10:15 </char><char style="xt" closed="false">Soma <ref loc="MRK 7:15-19">Marɨko 7:15-19</ref>.</char></note>» <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />Ekyo mokyakoleka ngendo kashathʉ, honyuma kw'aho ekɨndʉ ekyo mokirukibwa mo lʉbʉla.<figure style="fig" alt="La vision de Pierre: une toile avec toutes sortes d'animaux" file="wa03963.jpg" size="col" ref="10:9-12">Petero ashʉnga humanani ya lʉkɨmba lʉlɨmo nyama mɨna-mɨna</figure><verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />Petero mwayɨbʉtsya nga ehumanani athashʉnga nga yinegenire ithi ki. Mo ndambi eyo abo bathʉmawa na Koroneri mobahika ho lukyo, kʉshangwa babyaga nɨbamamala ɨbʉlɨrɨtsya ng'omwa Simoni mʉlɨ hayi. <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />Mobabɨrɨkɨra n'ɨbʉtsya bathɨ: «Ewono hano ho Simoni yo ʉnahʉlwamo Petero alɨ?» <verse eid="ACT 10:18" /><verse number="19" style="v" sid="ACT 10:19" />Petero abere akɨnalɨ aganɨtsya ko humanani eyo, <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> mwamʉbwɨra athɨ: «Onvwa, hano halɨ bayira bashathʉ abakushondya. <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />Hangana, kima, ʉgende hagʉma nabo bʉtha thɨka-thɨka, kʉshangwa ni ingye ngyo nyɨthathʉmabo.» <verse eid="ACT 10:20" /><verse number="21" style="v" sid="ACT 10:21" />Aho Petero mwakimira ahalɨ abandʉ abo n'ɨbwɨrabo athɨ: «Nɨ ingye ono ngy'omushondya. Mwamahika bʉshana na ki?» <verse eid="ACT 10:21" /><verse number="22" style="v" sid="ACT 10:22" />Mobashubya bathɨ: «Koroneri mʉkʉlʉ w'abashirikani yo wamathʉthʉma. Nɨ mʉndʉ athʉnganene, yo ubahire Gongo na ayire ngʉlʉ mo <char style="w">Bayuta</char>. <char style="w">Malaɨka</char> mʉgʉma wa Gongo mwamuhamulire akʉbɨrɨkɨre ewe bʉshana nɨonvwa ekyo wamʉbwɨra.» <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />Petero mwakokyabo n'ɨhabo bʉgonzero.</para>
  <para style="p" vid="ACT 10:23">Bwabere bwakya mwagenda nabo. Bagʉma ba mo bɨkɨrɨtsya b'ɨYopa mobamʉherekeretsya. <verse eid="ACT 10:23" /><verse number="24" style="v" sid="ACT 10:24" />Bwabere bwashubakya, mobahika iKaisaria. Koroneri nialindirirebo hagʉma n'olʉganda lʉwe n'abira bʉwe abo athabɨrɨkɨra. <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />Petero abere ashondya ɨngɨra, Koroneri mwahika imukokya, mwunuma embere sɨwe ihika ko kɨthaka mw'imushikya. <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />Hewethuwe Petero mwamuhangania n'ɨmʉbwɨra athɨ: «Hangana, kʉshangwa nangye nyɨrɨ mʉndʉ ng'ɨwe.» <verse eid="ACT 10:26" /><verse number="27" style="v" sid="ACT 10:27" />Honyuma kw'aho, nianemʉsɨmola na Koroneri, mwɨngɨra mo nyʉmba, mweya bandʉ bangɨ nibahindene. <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />Mwabwɨrabo athɨ: «Mwetsi <char style="w" lemma="Bayuta">k'oMuyuta</char> athahamulirwe ɨkwamana n'ekɨsomo kɨwe ikiritsania n'omʉndʉ w'ebɨhanda kʉtse ɨngɨra mo nyʉmba yɨwe. Hewethuwe Gongo mwanyikangya ko Nyɨthatholere ɨtsɨmba mʉndʉ woshi-woshi nga athatholere kʉtse nga y'utherire. <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />Bʉshana n'ekyo, mʉthabere mwanyɨbɨrɨkɨra, monyihika bʉthakʉbɨsa. Enyishondya ɨmɨnya nga mʉthanyɨbɨrɨkɨra bʉshana na ki.»<verse eid="ACT 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30" />Koroneri mwashubya athɨ: «Bɨro bɨshathʉ byamatsʉka, ko ndambi eyɨrɨ ng'eno, ko saha mwenda y'erigolo, nyabyaga nɨenyɨshabɨra omwaye. Aho n'aho, monyashʉnga kʉ mʉndʉ n'imene embere saye, niambithe ngɨmba singengire <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />na mwanyɨbwɨra athɨ: “Koroneri, Gongo mwonvwa emɨshabe awe, na amɨbʉka ebɨhembo byawe byo ʉnaha abatsene. <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />Aho ʉthʉme bandʉ ɨYopa ʉbɨrɨkɨre Simoni yo ʉnahʉlwamo Petero, ikere mo nyʉmba ya Simoni mukoli wa ngobi, ahimbire ho mʉsɨke w'engetsɨ.” <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />Aho n'aho monyɨkʉthʉmɨra bandʉ, nawe wamashingya ukahika. Ithwe boshi thʉlɨ hano lɨno embere sa Gongo bʉshana nɨonvwa ebyoshi Nyinya-kowethʉ athakʉhamʉla ʉthʉbwɨre.»<verse eid="ACT 10:33" /></para>
  <para style="s">Ebɨnwa bya Petero omwa Koroneri</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />Aho Petero mwanegena athɨ: «Ko kwenene nyamamɨnya lɨno ko Gongo athalɨ na ndondogoli, <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />hewethuwe obʉlɨ mʉndʉ na mw'angabya wa mʉ kɨhʉgo kɨhe yo ubahire Gongo n'ɨkola ebɨthʉnganene, oyo yo Gongo anakokya. <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />Mwathʉma mwatsɨ ʉwe ko <char style="w" lemma="Isiraeli">Baisiraeli</char>, <char style="w" lemma="Ngʉlʉ Mbʉya">eNgʉlʉ Mbʉya</char> y'obʉholo ɨtsʉkɨra kʉ Yesʉ <char style="w" lemma="Kirisito, Masia">Kirisito</char> n'ɨye yo Nyinya-kowethʉ w'abandʉ boshi. <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />Ndɨ munetsi kyo kyathangaga kyahika mo kɨhʉgo ky'iNgalilaya, na honyuma kw'aho mo kɨhʉgo kyoshi ky'iYuteya, Yoani abere amamala ɨkangɨrɨtsya abandʉ athɨ <char style="w" lemma="Lubatiso">babatisibwe</char>. <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />Mwetsi ko Gongo mwafʉbʉlɨra amaka <char style="w" lemma="Mʉthɨma Mwerʉ">w'oMʉthɨma Mwerʉ</char> kʉ Yesʉ w'iNasareti. Kandɨ mwetsi ko Yesʉ mwathimba mo kɨhʉgo nɨakola bɨbʉya n'ilamya aboshi bo babyaga mo bʉkobe bwa <char style="w">Sitani</char>, kʉshangwa Gongo abyaga hagʉma naye.<verse eid="ACT 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 10:39" />«Nethwe thʉlɨ batimo b'ebyoshi akolaga mo kɨhʉgo <char style="w" lemma="Bayuta">ky'aBayuta</char> n'ɨYerʉsalemʉ. Mobamwitha mw'ɨmʉbamba ko <char style="w">mʉsalaba</char>. <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />Hewethuwe Gongo mwamulubukya mo kɨro kya kashathʉ, mwamukangania kʉbʉya-kʉbʉya, <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />ɨthalɨ ko bandʉ boshi, hewethuwe kw'ithwe Gongo athangaga ɨshombolamo batimo. Ni ithwe thwalyaga n'ɨshoma hagʉma naye honyuma w'erilubuka lɨwe ɨthoka mo baholi. <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />Mwathʉhamʉla ɨkangɨrɨtsya abandʉ n'ibya batimo ko n'ɨye yo Gongo ayɨragamo musohi w'abalɨho n'abaholi. <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" /><char style="w" lemma="Mʉmɨnyeretsɨ">Abamɨnyeretsɨ</char> boshi abamwahʉla nɨabanegena bathɨ obʉlɨ mʉndʉ yo ʉmwɨkɨrɨtsye aganyɨrwa ebɨtsɨbʉ bɨwe mo maka w'erɨtsɨna lɨwe.»<verse eid="ACT 10:43" /></para>
  <para style="s">oMʉthɨma Mwerʉ akimira ko bandʉ b'ebɨhanda</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />Petero abere akɨnalɨ anegena, <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> mwakimira ko boshi bo bagenda abamʉhʉlɨkɨrɨtsya. <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />aBayuta bɨkɨrɨtsye bo bahikaga hagʉma na Petero mobashweka kw'ɨshʉnga ko Gongo amahana olʉhembo <char style="w" lemma="Mʉthɨma Mwerʉ">lw'oMʉthɨma Mwerʉ</char> ko bandʉ b'ebɨhanda. <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />Kʉshangwa mobonvwabo nɨabanegena mʉ yɨndɨ mɨnegene ithetsibwe n'isingya obʉkʉlʉ bwa Gongo. Aho Petero mwanegena athɨ: <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />«Nɨ ndɨ yo wangakaga abandʉ aba <char style="w" lemma="Lubatiso">ibatisibwa</char> mo metsi, bo bamalire ɨbona <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> ng'ithwe?» <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />Na mwahamʉla <char style="w" lemma="Lubatiso">babatisibwe</char> mw'ɨtsɨna lya Yesʉ <char style="w" lemma="Kirisito, Masia">Kirisito</char>. Aho mobamʉshaba abye hagʉma nabo bɨro bɨrebe.<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s">Petero aganʉlɨra ebyo byatsʉkaga omwa Koroneri</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />
    <char style="w" lemma="Bathʉmwa">Abathʉmwa</char> n'abɨkɨrɨtsya bo babyaga iYuteya, mobonvwa ko abandʉ b'ebɨhanda kuthyo mobɨkɨrɨtsya <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char>. <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />Petero abere ashʉba ɨYerʉsalemʉ, abɨkɨrɨtsya b'aBayuta mobakubisania <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />nɨabanegena bathɨ: «Ndɨ ɨwe mowɨngɨra mo nyʉmba ya bo <char style="w" lemma="Ɨmona">bathamwene</char> na moulya hagʉma nabo!»<verse eid="ACT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 11:4" />Aho Petero mwathanga ɨsonzomolerabo ebyoshi byatsʉkaga. Mwabwɨrabo athɨ: <verse eid="ACT 11:4" /><verse number="5" style="v" sid="ACT 11:5" />«Nyabyaga mo muyi w'ɨYopa nɨenyɨshaba, monyabya nga nyamalekʉla nangye monyashʉnga humanani. Monyashʉnga kʉ kɨndʉ kɨrebe niekikimibwa ɨthoka mo lʉbʉla, nɨ kɨrɨ nga lʉkɨmba lʉnene lutsimbirwe ko mbande ine niekikimira ho nyɨrɨ. <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />Monyayɨthegeretsya ebyo byabyaga omwishi na monyashʉnga sonyama s'ebɨrenge bɨne, n'esonyama s'omo ndokolo, n'esosɨnagendera ko nda n'ebɨronge. <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />Aho monyonvwa mʉlenge nɨanyɨbwɨra athɨ: “Petero, hangana, kera na ulye!” <verse eid="ACT 11:7" /><verse number="8" style="v" sid="ACT 11:8" />Hewethuwe monyashubya nyɨthɨ: “Oo ɨhɨ mbe Nyinya-kowethʉ, kʉshangwa nyɨthahera nyathalya kɨndʉ kɨthatholere kʉtse kitherire.” <verse eid="ACT 11:8" /><verse number="9" style="v" sid="ACT 11:9" />Omʉlenge mwashʉba onvwɨka mo lʉbʉla athɨ: “Ebyo Gongo athetsya, ʉthahʉlaga mʉbyo mo bitherire.” <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />Ekyo mokyashʉngɨka ngendo kashathʉ, honyuma kw'aho ebɨndʉ byoshi ebyo mobirukibwa mo lʉbʉla.<verse eid="ACT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 11:11" />«Kona kathambi ako, bayira bashathʉ mobahika ho nyʉmba thwabyaga, bathʉmawa kw'ingye nɨabathoka iKaisaria. <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" /><char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> mwanyɨbwɨra athɨ enda hagʉma nabo bʉtsɨra ɨthɨka-thɨka. Abɨkɨrɨtsya ndathʉ aba mobanyɨherekeretsya iKaisaria na mothwingire ithwe boshi mo nyʉmba ya Koroneri. <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />Koroneri oyo mwathuganulire nga kw'ashʉngaga kʉ <char style="w">malaɨka</char> yo wimanaga mo nyʉmba yɨwe n'ɨmʉbwɨra athɨ: “Thʉma bandʉ ɨYopa bayalethe Simoni, yo ʉnahʉlwamo Petero. <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />Ɨye, akʉbwɨra ebɨnwa ebyo byandakʉlethera bushabuli, ɨwe n'abandʉ boshi abalɨ omwawe.”<verse eid="ACT 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 11:15" />«Nyabere nyathanga ɨnegena, <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> mwakimira kʉbo, nga ko nethwe athukimiragako ko ndangɨro. <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />Aho monyɨbʉka ekyo Nyinya-kowethʉ anegenaga athɨ: “Yoani <char style="w" lemma="Lubatiso">mwabatisya</char> mo metsi, he imwe <char style="w" lemma="Lubatiso">mwabatisibwa</char> mo <char style="w">Mʉthɨma Mwerʉ</char>.<note caller="+" style="f"><char style="fr" closed="false">11:16 </char><char style="xt" closed="false">Soma <ref loc="ACT 1:5">Mɨkolano 1:5</ref>.</char></note>” <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />Aho Gongo amabya nɨmwahabo oMʉthɨma Mwerʉ nga kw'athʉhagawo thwabere thwɨkɨrɨtsya Nyinya-kowethʉ Yesʉ <char style="w" lemma="Kirisito, Masia">Kirisito</char>, ewono ingye nyɨrɨ ndɨ w'ɨlwɨsa Gongo?»<verse eid="ACT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18" />Abɨkɨrɨtsya ba Bayuta babere bonvwa ebɨnwa ebyo, aboshi mobatsɨra n'isingya Gongo nɨabanegena bathɨ: «Nɨ kwenene, Gongo mwaha abandʉ b'ebɨhanda nabo bo buthoki bw'ɨbɨndʉka n'ɨthoka mo bɨtsɨbʉ byabo n'ɨbona bʉyɨngo bw'ekwenene.»<verse eid="ACT 11:18" /></para>
  <para style="s">Ndangɨro y'ekanisa k'iAntiokia</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />Honyuma y'olʉholo lwa Sɨtɨfano abɨkɨrɨtsya mobasanzabana bʉshana na malɨgo. Bagʉma ba mʉbo mobaya mo kɨhʉgo ky'iFoiniki na mo kɨhʉgo ky'iKipuro na mo muyi w'iAntiokia. Ahoshi bayaga bagenda abakangɨrɨtsya <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char> ko <char style="w">Bayuta</char> basha. <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />Hewethuwe bɨkɨrɨtsya bagʉma bo babyaga b'omo kɨhʉgo ky'iKipuro na mo muyi w'iKurene mobahika iAntiokia. Nabo kuthyo mobasɨmola n'abandʉ b'ebɨhanda nɨabafʉlɨrabo <char style="w" lemma="Ngʉlʉ Mbʉya">eNgʉlʉ Mbʉya</char> ya Nyinya-kowethʉ Yesʉ. <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />Amaka wa Nyinya-kowethʉ abyaga hagʉma nabo, ihika ko kɨka bandʉ bangɨ mobɨkɨrɨtsya n'ɨbɨndʉkɨra Nyinya-kowethʉ. <verse eid="ACT 11:21" /><verse number="22" style="v" sid="ACT 11:22" />Omwatsɨ oyo mw'onvwɨka ko <char style="w">kanisa</char> k'ɨYerʉsalemʉ. Aho mobathʉma Baranaba y'iAntiokia. <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />Abere ahikayo n'ɨshʉnga olʉkogo lwa Gongo, mwamoga na mwaha abɨkɨrɨtsya boshi bo muhwa, kʉshangwa bayinihire Nyinya-kowethʉ n'omʉthɨma mʉgʉma. <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />Baranaba abyaga mʉndʉ mʉbʉya, niotswiremo <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> n'olwɨkɨrɨtsyo. Bandʉ bangɨ mobongererwa ko abo bikiritsaya Nyinya-kowethʉ.<verse eid="ACT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />Honyuma kw'aho Baranaba mwaya ɨTarɨso bʉshana n'ɨya shondya Sauli. <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />Abere amʉshʉnga, mwamʉthwala iAntiokia. Ababɨrɨ boshi mobamala omwaka woshi niabahindana na bandʉ mo <char style="w">kanisa</char> nɨabakangɨrɨtsya bandʉ bangɨ mo lwɨkɨrɨtsyo. Nɨ iAntiokia yo <char style="w">abɨga</char> bathangaga ɨahʉlwamo bakirisito.<verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />Mo bɨro ebyo <char style="w" lemma="Mʉmɨnyeretsɨ">bamɨnyeretsɨ</char> bagʉma mobathoka ɨYerʉsalemʉ, mobaya iAntiokia. <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />Mʉgʉma wa kʉbo agendaga ahʉlwamo Akabo, mw'ibishulirwa <char style="w" lemma="Mʉthɨma Mwerʉ">n'oMʉthɨma Mwerʉ</char>, mwamɨnyerera ko kwabya nzala nzɨbʉ mo bɨhʉgo byoshi. (Enzala nzɨbʉ eyo moyabya ko mʉgʉlʉ Kalautio Kaisari abyaga muthegeki.) <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />Aho <char style="w">abɨga</char> mobahamʉla bathɨ bʉlɨ mʉndʉ ahane nga kw'angakotsya bʉshana n'iwathikya abagala bethʉ bɨkɨrɨtsya bo babyaga b'ikere iYuteya. <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />Mobakola bathyo, na mobathʉmɨra ebɨhembo ebyo by'abangʉmwa b'ekanisa k'iYuteya mo minwe ya Baranaba na Sauli.<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s">Yakobo ithwa na Petero agʉshwa mo biriso</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />Ko mʉgʉlʉ oyo, mwamɨ <char style="w">Herote</char> Angiripa mwathanga inubya bɨkɨtsya bagʉma b'omo <char style="w">kanisa</char>. <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />Mwahamʉla athɨ Yakobo mʉgala wabo Yoani ithwe mʉ muyali. <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />Abere ashʉnga <char style="w" lemma="Bayuta">aBayuta</char> ko mobamogera ebyo, mwashʉba tsɨmba Petero, mo mʉgʉlʉ w'elinye <char style="w" lemma="Mikati ɨthemo tsatsʉ">ly'emikati ɨthemo tsatsʉ</char>. <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />Herote abere amamala ɨmʉtsɨmba mwamʉgʉsha mo biriso n'imuhira mʉ bɨkembe bɨne bya bashirikani bane bane bamutheye. Abyaga nialalitsye ɨmʉsoha embere s'abandʉ enyuma <char style="w" lemma="Pasaka">y'ePasaka</char>. <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />Aho Petero mobamutheya mo biriso, hewethuwe <char style="w" lemma="Kanisa">akanisa</char> kagenda akamʉshabɨra kʉ Gongo na muhwa.<verse eid="ACT 12:5" /></para>
  <para style="s">Petero athokibwa mo biriso</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />Mo kɨro ky'ekɨro ekyo <char style="w">Herote</char> abyaga niashondya ɨmʉsoha embere s'abandʉ, Petero abyaga nɨagonzere mo kathi-kathi ka bashirikani babɨrɨ. Abyaga niaminire mʉ bʉhʉlʉla bʉbɨrɨ na batheya babyaga ko lukyo lw'ebiriso. <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />Aho n'aho, <char style="w">malaɨka</char> mʉgʉma wa Nyinya-kowethʉ mwahʉlʉka n'ekyakakala mokyakoletsya kʉtsɨbʉ mo kɨshenge abyagamo. <char style="w">Malaɨka</char> mwakola ko lʉkanga lwa Petero, mwamubukya n'ɨmʉbwɨra athɨ: «Hangana tsʉba!» Aho obʉhʉlʉla mobwathoga ko minwe yɨwe. <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />Honyuma kw'aho <char style="w">malaɨka</char> mwamʉbwɨra athɨ: «Wambala omʉkaba awe na wambala ebɨrato byawe.» Petero mwakola athyo na <char style="w">malaɨka</char> mwashʉbamʉbwɨra athɨ: «Wambala ekoti awe na ʉnyɨkwame.» <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />Petero mwathoka mo biriso niakwamire <char style="w">malaɨka</char> oyo. Mwathamɨnya kw'ebyo <char style="w">malaɨka</char> akola nga nɨ bya kwenene. Agenda aganɨtsya ng'amashʉnga humanani. <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />Mobatsʉka ahalɨ ekɨkembe kɨmbere ky'abatheya, n'ekya kabɨrɨ, na mobahika ko luyi lw'ekyʉma lo lulolire ko muyi. Oluyi olo molwayɨkɨngʉla lolwene embere sabo na mobahʉlʉkɨra embʉga. Mobatsʉka mo nzɨra ngʉma, aho n'aho <char style="w">malaɨka</char> mwamumika.<verse eid="ACT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11" />Aho Petero abere amɨnya ebyo bɨthatsʉka mwanegena athɨ: «Lɨno nyamamɨnya ko nɨ kwenene. Nyinya-kowethʉ mwathʉma <char style="w">malaɨka</char> ʉwe, mwanyithokya mo minwe ya <char style="w">Herote</char> na mo bɨbɨ byoshi <char style="w" lemma="Bayuta">aBayuta</char> bathagenda abaganitsya inyihikira.»<verse eid="ACT 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12" />Abere amɨnya ebyo, mwaya omwa Marɨa, nyinya wa Yoani yo ʉnahʉlwamo Marɨko. Bandʉ bangɨ babyaga nibahindenemo nɨabashaba. <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />Petero mwakongotha ko luyi lw'orʉba. Mukoli mʉgʉma mʉkatsɨ yo wagenda ahʉlwamo Rota mwahika ɨya kɨngʉla. <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />Mwamɨnyerera omʉlenge wa Petero, na bʉshana n'olʉmogo lʉngɨ mwathakɨngʉla oluyi, he mwathɨbɨtha mo nyʉmba, mwaya bwɨra abandɨ ko Petero imene embʉga. <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />Mobamʉbwɨra bathɨ: «Ʉlɨ mʉsɨre!» Rota mwayɨtsɨnga athɨ nɨ kwenene. Aho mobanegena bathɨ: «Nɨ <char style="w">malaɨka</char> ʉwe.<note caller="+" style="f"><char style="fr" closed="false">12:15 </char><char style="fq" closed="false">malaɨka ʉwe: </char><char style="ft" closed="false">Ko mɨganɨtsye y'aBayuta, obʉlɨ mʉndʉ abyaga niawithe malaɨka ʉwe w'imutheya yo wangahʉlʉka niashoshire omʉndʉ oyo.</char></note>» <verse eid="ACT 12:15" /><verse number="16" style="v" sid="ACT 12:16" />Mondambi eyo Petero mwayɨtsɨnga erɨkongotha. Babere bakɨngʉla oluyi, mobamʉshʉnga n'ɨshweka kʉtsɨbʉ. <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />Petero mwakohetsyabo mo minwe athɨ batsɨre, na mwasɨmolerabo nga ko Nyinya-kowethʉ athamʉshondola n'imuthokya mo biriso. Mwashʉba negena athɨ: «Mʉbwɨre Yakobo n'abandɨ bagala bethʉ bɨkɨrɨtsya.» Honyuma kw'aho mwathoka aho, mwaya handɨ.<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />Bwabere bwakya, abashirikani mobaganga-ganga mo kathi-kathi kabo. Bagenda abayɨbʉtsya nga Petero abere athɨ. <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" /><char style="w">Herote</char> mwahamʉla bamushondye he mobathamʉbona. Mwathondesabo n'ɨhamʉla b'ithwe. Honyuma kw'aho <char style="w">Herote</char> mwathoka iYuteya, mwaya iKaisaria, mwabyayo kʉ ndambi nyɨrebe.<verse eid="ACT 12:19" /></para>
  <para style="s">Lʉholo lwa Herote</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />Herote abyaga nɨamatsɨbʉkɨra kʉtsɨbʉ abandʉ b'omo miyi y'iTiro n'iSitona. He abahimbani b'emiyi eyo mobalagana ɨyamʉshʉnga. Mobuhya Bʉlasɨto, mwimanitsi mʉkʉlʉ w'ekɨshenge ky'omwamɨ. Honyuma kw'aho mobayashʉnga Herote bʉshana barongane, kʉshangwa akalyo kabo kagenda akathoka mo kɨhʉgo kɨwe. <verse eid="ACT 12:20" /><verse number="21" style="v" sid="ACT 12:21" />Ekɨro b'ɨkɨrɨtsanaya, <char style="w">Herote</char> mwambala lʉkɨmba lʉwe lw'obwamɨ, mwikala ko lʉthebe lʉwe lw'obwamɨ, na mwasɨmolera abandʉ. <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />Aho abandʉ mobahambala bathɨ: «Athalɨ mʉndʉ yo ʉnegena, he nɨ Gongo!» <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />Hewethuwe aho n'aho, <char style="w">malaɨka</char> mʉgʉma wa Nyinya-kowethʉ mwagʉshɨra Herote yo bukoni, kʉshangwa mwathaha Gongo y'olʉkengerwa lʉwe. Mwalɨbwa n'esonzoka sa mʉ nda, na mwafwa.<verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />
    <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char> mokyakanya kʉtsɨbʉ kʉ bandʉ bangɨ. <verse eid="ACT 12:24" /><verse number="25" style="v" sid="ACT 12:25" />Baranaba na Sauli ɨbo babere bamala omʉlɨmo wabo w'ɨYerʉsalemʉ,<note caller="+" style="f"><char style="fr" closed="false">12:25 </char><char style="xt" closed="false">Soma <ref loc="ACT 11:29-30">Mɨkolano 11:29-30</ref>.</char></note> mobashʉba iAntiokia na mobalethania Yoani yo wagenda ahʉlwamo Marɨko.<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s">Baranaba na Sauli bamashombolwa n'oMʉthɨma Mwerʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />Mo <char style="w">kanisa</char> k'iAntiokia, mwabyaga <char style="w" lemma="Mʉmɨnyeretsɨ">bamɨnyeretsɨ</char> na bakangɨrɨtsya nabo nɨ Baranaba, na Simioni yo ʉnahʉlwamo Mwirafulu, na Lukio w'iKurene, na Manaeni yo wɨshʉkɨraga hagʉma n'omuthegeki <char style="w">Herote</char> Antipasi, na Sauli. <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />Kɨro kɨgʉma babere balɨ abaramya Nyinya-kowethʉ <char style="w" lemma="Iyima kalyo">n'iyima</char> akalyo, <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> mwabwɨrabo athɨ: «Mʉnyɨbɨkɨre Baranaba na Sauli bʉshana n'omʉlɨmo wo nyabɨrɨkɨrɨragabo.» <verse eid="ACT 13:2" /><verse number="3" style="v" sid="ACT 13:3" />Aho, honyuma <char style="w" lemma="Iyima kalyo">w'eriyima akalyo</char> n'ɨshaba, mobahira kʉbo kw'eminwe n'ɨthʉmabo bagende.<verse eid="ACT 13:3" /></para>
  <para style="s">Baranaba na Sauli bamaya iKipuro</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />Aho Baranaba na Sauli babere bamamala ɨthʉmwa <char style="w" lemma="Mʉthɨma Mwerʉ">n'oMʉthɨma Mwerʉ</char> mo mʉlɨmo, mobandagalɨra iSeleukia, yo bathokaga mo bwatho baya ko kɨtsɨra ky'iKipuro. <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />Babere bahika iSalami, mobathanga ɨfʉla <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char> mo <char style="w" lemma="Sinakoki">so sinakoki</char> <char style="w" lemma="Bayuta">s'aBayuta</char>. Yoani Marɨko abyaga hagʉma nabo bʉshana n'iwathikyabo.<verse eid="ACT 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6" />Babere bamala ikirukania ekɨtsɨra kyoshi ihika ko muyi w'ɨPafo, oko mobeyako mukumu mʉgʉma abyaga <char style="w" lemma="Mʉmɨnyeretsɨ">mʉmɨnyeretsɨ wa mabesɨ</char>. Kandɨ abyaga <char style="w" lemma="Bayuta">Muyuta</char>, erɨtsɨna lɨwe nɨ yo Bara-Yesʉ. <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />Bara-Yesʉ oyo agenda akola hagʉma na Serekio Polo mʉkʉlʉ w'ekɨtsɨra ekyo, yo wabyaga mʉndʉ mwenge. Serekio ono mwabɨrɨkɨra Baranaba na Sauli kʉshangwa abyaga niashondya ɨonvwa <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char>. <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />He omukumu Elema (ng'erɨtsɨna lɨwe ko linegenire mo kikiriki) mwakubisania nabo kʉshangwa omʉkʉlʉ w'ekɨtsɨra athɨkɨrɨtsyaga <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char>. <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />Aho Sauli kandɨ yo wahʉlawamo Polo, anotswiremo <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char>, mwamʉhandako amesho <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />mwamʉbwɨra athɨ: «Ɨwe mʉndʉ wotswiremo erɨthɨmɨrɨtsya n'obuliribania, ɨwe mʉgala wa <char style="w">Sitani</char>, ɨwe nzigu y'ebɨbʉya byoshi! Uthindalike ihengemya ebɨnwa by'ekwenene bya Nyinya-kowethʉ? <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />Ewo hʉlɨkɨrɨtsya, eminwe ya Nyinya-kowethʉ yakuhumba, wabya mbumi na ʉthɨndashʉbalola na hake ko kyakakala ky'erɨtsʉba kʉ ndambi nyɨrebe.» Aho n'aho akaho n'omwitsimya mobyabya mo mesho wa Elema. Na agenda ayithimba-thimbako niashondya mʉndʉ yo wamʉshondola mw'ɨmʉtsɨmba ko kʉboko. <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />Omʉkʉlʉ abere ashʉnga ebyo byakolekaga, mwɨkɨrɨtsya bʉshana mwashwekera amakangɨrɨtsya wa Nyinya-kowethʉ.<verse eid="ACT 13:12" /></para>
  <para style="s">Polo na Baranaba iAntiokia mo kɨhʉgo ky'iPisitia</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />Polo na balikyabo mobathoka mo muyi w'ɨPafo mo bwatho, mobahika mo muyi w'ɨPerenga mo kɨhʉgo ky'iPamufilia. Yoani Marɨko mwamikabo aho n'ɨshʉba ɨYerʉsalemʉ. <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />He Polo na Baranaba ɨbo, mobalotsya ebʉshondotsɨ nɨabathoka ɨPerenga na mobahika iAntiokia mo kɨhʉgo ky'iPisitia. Ekɨro <char style="w" lemma="Sabato">ky'eSabato</char> mobɨngɨra mo <char style="w" lemma="Sinakoki:">sinakoki</char> n'ikala. <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />Babere bamamala ɨsoma ebɨtabo <char style="w" lemma="Mʉgomba">by'oMʉgomba</char> n'ebya <char style="w" lemma="Mʉmɨnyeretsɨ">aBamɨnyeretsɨ</char>, <char style="w" lemma="Sinakoki">abakʉlʉ b'esinakoki</char> mobathʉmɨrabo mugendi bathɨ: «Bagala bethʉ, mwamabya muwithe bɨnwa by'ɨha muhwa omuhindano, mʉnegene lɨno.»<verse eid="ACT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16" />Polo mwimana, mwakola kɨmɨnyɨkalo mo minwe bʉshana bamʉhʉlɨkɨrɨtsye, na mwanegena athɨ: «Imwe bandʉ <char style="w" lemma="Isiraeli">b'iIsiraeli</char> nemwe mo mʉthalɨ Bayuta momubahire Gongo, mʉnyɨhʉlɨkɨrɨtsye! <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />Gongo w'abandʉ <char style="w" lemma="Isiraeli">b'iIsiraeli</char> mwayɨshoga bo thatha-kʉlʉ. Babere banikere iMisiri nga bageni mwaluyabo. Honyuma kw'aho mwathokyabo mo kɨhʉgo ekyo mo maka ʉwe. <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />Hofɨ myaka makumi ane mwalembalembabo mo <char style="w">mbwarara</char>. <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />Honyuma kw'aho mwathogothya bɨhanda bɨrɨnda mo kɨhʉgo ky'ɨKanana, na mwaha ekɨhʉgo ekyo ky'abandʉ bʉwe, kibye mwandʉ wabo. <verse eid="ACT 13:19" /><verse number="20" style="v" sid="ACT 13:20" />Ebyoshi ebyo mobyakoleka mʉ mɨaka hofɨ magana ane na makumi athano.</para>
  <para style="p" vid="ACT 13:20">«Honyuma kw'aho, mwaha bo thatha-kʉlʉ bo basohi ihika ko mʉgʉlʉ <char style="w" lemma="Mʉmɨnyeretsɨ">w'omʉmɨnyeretsɨ</char> Samwere. <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />Honyuma kw'aho mobashaba mwamɨ. Gongo mwahabo Sauli, mʉgala wa Kishi, w'omo lʉganda lwa Benyamini, yo wathegekaga myaka makumi ane. <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />Abere amamala ithokya Sauli, Gongo mwimania <char style="w">Tawiti</char> mo mwamɨ wabo. Gongo mwanegena bʉshana naye athɨ: “Nyamalire ɨbona <char style="w">Tawiti</char>, mʉgala wa Yese, kʉshangwa omʉndʉ oyo alɨ ko mʉthɨma aye, na andakola erɨshasha lyaye.<note caller="+" style="f"><char style="fr" closed="false">13:22 </char><char style="xt" closed="false">Soma <ref loc="1SA 13:14">1Samweli 13:14</ref>.</char></note>” <verse eid="ACT 13:22" /><verse number="23" style="v" sid="ACT 13:23" />Na mo lʉganda lwa Tawiti oyo, Gongo mwalethera <char style="w" lemma="Isiraeli">aBaisiraeli</char> bo Mushabuli, Yesʉ, nga kw'alagagabo. <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />Embere Yesʉ ahike, Yoani mwafʉlɨra <char style="w" lemma="Isiraeli">aBaisiraeli</char> boshi b'omwatsɨ athɨ babɨndʉke ɨthoka mo bɨtsɨbʉ byabo na <char style="w" lemma="Lubatiso">babatisibwe</char>. <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />Mo ndambi Yoani abere ashondya ɨmala omʉlɨmo ʉwe, mwanegena athɨ: “Omʉganɨtsya mʉthɨ nyɨrɨ ndɨ? Ingye nyɨthalɨ yo mulindire. Hewethuwe monvwe: enyuma kw'ingye kwahika mʉndʉ nangye Nyɨthatholere ɨmɨnʉla ebɨrato bɨwe.<note caller="+" style="f"><char style="fr" closed="false">13:25 </char><char style="xt" closed="false">Soma <ref loc="JHN 1:20">Yoani 1:20</ref>,<ref loc="JHN 1:27">27</ref>.</char></note>”<verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />«Bagala bethʉ, imwe bana b'engʉmo <char style="w" lemma="Abʉrahamʉ">y'Abʉrahamʉ</char>, nemwe mo mʉthalɨ Bayuta mo mubahire Gongo, engʉlʉ eyi y'obushabuli ni ithwe bo Gongo athʉmɨragaro. <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />Kʉshangwa abahimbani b'ɨYerʉsalemʉ n'abakʉlʉ babo mobathamɨnya Yesʉ n'ebɨnwa by'<char style="w" lemma="Mʉmɨnyeretsɨ">abamɨnyeretsɨ</char> byo bɨnasomwa mo bʉlɨ <char style="w">Sabato</char>. Hewethuwe mobabereretsya ebɨnwa ebi mw'ɨsoha Yesʉ. <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />Na mo bathanamʉshʉngagako ekyangaleka nɨasoherwa lʉholo, mobashaba <char style="w">Pilato</char> bathɨ ithwe. <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />Babere bamamala ɨbereretsya ebyoshi byahʉlawa mo Mashako Abuyirire bʉshana naye, mobamukimya ko <char style="w">mʉsalaba</char> n'imuhira mw'ɨsɨnda. <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />He Gongo mwamulubukya mo baholi. <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />Ko bɨro bɨngɨ Yesʉ mwahʉlʉkɨra abandʉ bo bagendaga naye ɨthoka iNgalilaya ɨrʉkɨra ɨYerʉsalemʉ nabo lɨno nɨ batimo bʉwe ko bandʉ b'iIsiraeli. <verse eid="ACT 13:31" /><verse number="32" style="v" sid="ACT 13:32" />Nethwe thwamabalethera <char style="w" lemma="Ngʉlʉ Mbʉya">eNgʉlʉ Mbʉya</char> eyo thʉthɨ endagane eyo Gongo alagaga bo thatha-kʉlʉ, <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />amabereretsyaro kw'ithwe bana babo mw'ilubukya Yesʉ mo baholi. Bɨno bishakirwe mo Saburi ya kabɨrɨ bɨthɨ:</para>
  <para style="q1" vid="ACT 13:33">“Ʉlɨ mʉgala aye,</para>
  <para style="q1" vid="ACT 13:33">ingye munobwire nyamakʉbʉtha.<note caller="+" style="f"><char style="fr" closed="false">13:33 </char><char style="xt" closed="false">Soma <ref loc="PSA 2:7">Saburi 2:7</ref>.</char></note>”<verse eid="ACT 13:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 13:34" />Gongo mwanegena ko andalubukya Yesʉ mo baholi bʉshana athashʉbaga mw'ɨsɨnda n'ɨbola. Mwanegena athɨ:</para>
  <para style="q1" vid="ACT 13:34">“Nyandakʉha emigisha <char style="w" lemma="Mubuyirire">yibuyirire</char> na y'ekwenene</para>
  <para style="q1" vid="ACT 13:34">yo nyalagaga <char style="w">Tawiti</char>.<note caller="+" style="f"><char style="fr" closed="false">13:34 </char><char style="xt" closed="false">Soma <ref loc="ISA 55:3">Isaya 55:3</ref>.</char></note>”<verse eid="ACT 13:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="ACT 13:35" />Kyo kɨreka nɨashʉba negena mo ʉndɨ mʉlondo athɨ:</para>
  <para style="q1" vid="ACT 13:35">“Ʉthɨndalike <char style="w" lemma="Mubuyirire">omubuyirire</char> awe abole.<note caller="+" style="f"><char style="fr" closed="false">13:35 </char><char style="xt" closed="false">Soma <ref loc="PSA 16:10">Saburi 16:10</ref>.</char></note>”<verse eid="ACT 13:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="ACT 13:36" />Kʉshangwa <char style="w">Tawiti</char> ɨye, abere amamala ɨkola erihano lya Gongo mo mʉgʉlʉ ʉwe, honyuma kw'aho mwafwa, mwathabwa hofɨ n'obwishe-kʉlʉ na mwabola. <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />Hewethuwe yo Gongo alubukaya mo baholi ɨye mwathabola. <verse eid="ACT 13:37" /><verse number="38-39" style="v" sid="ACT 13:38-39" />Bagala bethʉ, mʉtholere nɨmwamɨnya ko nɨ bʉshana na Yesʉ ko mwafʉlɨrawa omwatsɨ w'erɨganyɨrwa ly'ebɨtsɨbʉ. Nɨ bʉshana naye obʉlɨ mʉndʉ yo wɨkɨrɨtsye angaganyɨrwako ebɨbɨ ebyo oMʉgomba wa Mʉsa athangakotsitsye ɨmʉmɨnʉlako. <verse eid="ACT 13:38-39" /><verse number="40" style="v" sid="ACT 13:40" />Aho muyitheye bithabahikiraga ebyo <char style="w" lemma="Mʉmɨnyeretsɨ">bamɨnyeretsɨ</char> bashakaga bathɨ:<verse eid="ACT 13:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41" />“Mʉlole imwe mwotswiremo epono,</para>
  <para style="q1" vid="ACT 13:41">mʉshweke na mʉbʉlɨrane!</para>
  <para style="q1" vid="ACT 13:41">Kʉshangwa nyandabakolera kɨndʉ mo mesho enyu</para>
  <para style="q1" vid="ACT 13:41">ekyo mʉthangɨkɨrɨtsya na mo mwangabonire oyo wangabasɨmolere!<note caller="+" style="f"><char style="fr" closed="false">13:41 </char><char style="xt" closed="false">Soma <ref loc="HAB 1:5">Habakuki 1:5</ref>.</char></note>”»<verse eid="ACT 13:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />Polo na Baranaba babere bathoka mo sinakoki, abandʉ mobabwɨrabo bathɨ bagende bashʉbe hika mo ɨndɨ <char style="w" lemma="Sabato">Sabato</char> bʉshana n'ɨsɨmola ko mwatsɨ ono. <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />Babere bamala omuhindano, <char style="w">Bayuta</char> bangɨ n'abandʉ b'ebɨhanda bo babɨndʉkɨraga mo kɨsomo <char style="w" lemma="Bayuta">ky'aBayuta</char>, mobakwama Polo na Baranaba. Bano mobasɨmolerabo n'ɨhabo muhwa bathalikaga iyinihira olʉkogo lwa Gongo.<verse eid="ACT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />Na mo yɨndɨ <char style="w" lemma="Sabato">Sabato</char>, hofɨ abandʉ boshi b'omo muyi mobahindana bʉshana nɨonvwa eKɨnwa kya Nyinya-kowethʉ. <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" /><char style="w" lemma="Bayuta">aBayuta</char> babere bashʉnga omuhindano w'abandʉ, mobafwa mwisho kʉtsɨbʉ, mobathɨnda ebya Polo n'imuhangya. <verse eid="ACT 13:45" /><verse number="46" style="v" sid="ACT 13:46" />Aho Polo na Baranaba mobabwɨrabo bʉtsɨra bʉba bathɨ: «Byabyaga bɨtholere kw'ithwe nɨthwathanga ɨbafʉlɨra <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char>. Hewethuwe kʉshangwa mwamathɨndakyo n'ɨyɨmɨnya imwe bene ko obʉyɨngo bwa kera na kera buthawithe ndundi kw'imwe, aho, thwaya yo yɨrɨ abandʉ b'ebɨhanda. <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />Kʉshangwa Nyinya-kowethʉ mwathʉhamʉla athya:</para>
  <para style="q1" vid="ACT 13:47">“Monyakuyirire ubye nga kyakakala ko nganda s'abandʉ b'ebɨhanda,</para>
  <para style="q1" vid="ACT 13:47">kʉshangwa ʉlethe bushabuli ihika ko nduli y'ekɨhʉgo.<note caller="+" style="f"><char style="fr" closed="false">13:47 </char><char style="xt" closed="false">Soma <ref loc="ISA 49:6">Isaya 49:6</ref>.</char></note>”»<verse eid="ACT 13:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />Abandʉ b'ebɨhanda babere bonvwa ebɨnwa ebyo, mobamoga n'isingya eKɨnwa kya Nyinya-kowethʉ. Na mobabya bɨkɨrɨtsya aboshi bobabɨkɨrawa obʉyɨngo bwa kera na kera. <verse eid="ACT 13:48" /><verse number="49" style="v" sid="ACT 13:49" />eKɨnwa kya Nyinya-kowethʉ mokyathimba mo kɨhʉgo kyoshi ekyo. <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />Hewethuwe <char style="w" lemma="Bayuta">aBayuta</char> mobakaramia abakatsɨ bo babyaga nibashikibwe, bo bagenda abaramya Gongo, kuthyo n'abakʉlʉ b'omuyi. Mobaletha malɨgo mangɨ kʉ Polo na Baranaba ihika ko kɨka mobaligithabo mo kɨhʉgo kyabo. <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />Aho Polo na Baranaba mobakʉngʉthɨrabo oluthuthu lw'ebɨshando byabo na mobaya mo muyi w'iIkonio. <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />Hewethuwe <char style="w" lemma="Abɨga">abɨga</char> b'iAntiokia mobotsulamo olʉmogo kʉtsɨbʉ n'o<char style="w" lemma="Mʉthɨma Mwerʉ">Mʉthɨma Mwerʉ</char>.<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s">Polo na Baranaba balɨ iIkonio</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />Polo na Baranaba mobahika iIkonio. Oko nako mobɨngɨra mo <char style="w" lemma="Sinakoki:">sinakoki</char> <char style="w" lemma="Bayuta">y'aBayuta</char>, mobakangɨrɨtsya ihika ko kɨka <char style="w">Bayuta</char> na <char style="w">Bakiriki</char> bangɨ mobɨkɨrɨtsya. <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />Hewethuwe <char style="w" lemma="Bayuta">aBayuta</char> bo bathɨndaga ɨkɨrɨtsya, mobakaramya abandʉ b'ebɨhanda, mobahira mʉbo mo mɨthɨma mɨbɨ y'ɨbaga abɨkɨrɨtsya. <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />Namo byanabyaga bithyo, Polo na Baranaba mobikala bɨro bɨngɨ iIkonio. Bagenda abanegena bʉtsɨra bʉba, nibayinihire Nyinya-kowethʉ. Naye mwahabo maka w'ɨkola bɨmɨnyɨkalo na bɨthɨko-thɨko. Na bʉshana n'ekyo mwakangania kwenene kw'amakangɨrɨtsya bakangɨrɨtsyaga w'olʉkogo lʉwe abyaga wa kwenene. <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />Abahimbani b'omo muyi mobagabana, bagʉma mobabya ko lʉhande <char style="w" lemma="Bayuta">lw'aBayuta</char> n'abandɨ ko lʉhande <char style="w" lemma="Bathʉmwa">lw'abathʉmwa</char>. <verse eid="ACT 14:4" /><verse number="5" style="v" sid="ACT 14:5" /><char style="w" lemma="Bayuta">aBayuta</char> n'abandʉ b'ebɨhanda, hagʉma n'abakʉlʉ babo, bagenda abayithegekania inubya Polo na Baranaba n'ithabo mu mabwe. <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />Polo na Baranaba babere bamɨnya ebyo, mobashayɨra iLisitira n'ɨTerebe, miyi yɨrɨ mo kɨhʉgo ky'iLikaonia, na mo ndambɨ-ndambɨ y'emiyi eyo. <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />Eyo nayo mobagenda abafʉla <char style="w" lemma="Ngʉlʉ Mbʉya">eNgʉlʉ Mbʉya</char>.<verse eid="ACT 14:7" /></para>
  <para style="s">Polo na Baranaba balɨ iLisitira</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />Mo muyi w'iLisitira, mwabyaga mʉndʉ mʉgʉma, abyaga nɨ kɨrema ɨthanga kw'ɨbʉthwa lɨwe, kʉshangwa ebɨshando bɨwe nibikonongokire. Abyaga nɨathahera athayɨsɨngɨrɨka kʉtse ɨgenda. <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />Mwonvwa ebyo Polo agenda anegena. Polo mwamʉhandako amesho, mwashʉnga nɨalɨ na lwɨkɨrɨtsyo lw'ilamibwa. <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />Aho Polo mwamʉbwɨra mʉ mʉlenge mʉnene athɨ: «Hangana, ʉyɨsɨngɨrɨke ko bɨshando byawe!» Omuyira oyo mwabathʉka na mwathanga ɨgenda.<verse eid="ACT 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 14:11" />Omuhindano abere ashʉnga ebyo Polo akolaga, mobahambala mo mʉnegene w'ekilikaonia bathɨ: «Bo gongo bamakimira eyo thʉlɨ nɨbalɨ mo mɨbɨrɨ y'abandʉ!» <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />Mobahʉla Baranaba mo «Seu» na Polo «Hereme», kʉshangwa Polo abyaga mbuyi.<note caller="+" style="f"><char style="fr" closed="false">14:12 </char><char style="ft" closed="false">Seu na Hereme babyaga bo gongo b'aBakiriki. Seu abyaga nietsibwemo mʉkʉlʉ wa bo gongo boshi na Hereme abyaga mbuyi w'abo gongo abo.</char></note> <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" /><char style="w" lemma="Muheri">Omuheri</char> w'omo nyʉmba ya gongo Seu yo yabyaga ko mbʉlʉkɨro yo muyi, mwaletha bɨmasa nibyambithe mbitha ya mʉshanga embere y'esongyo s'enyʉmba eyo. Agenda ashondya athɨ ɨye n'omuhindano bakometsye Baranaba na Polo bo bʉhere.<verse eid="ACT 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14" />Hewethuwe <char style="w" lemma="Bathʉmwa">abathʉmwa</char> babɨrɨ, Baranaba na Polo babere bonvwa ebyo, mobaberengenga esongɨmba sabo<note caller="+" style="f"><char style="fr" closed="false">14:14 </char><char style="ft" closed="false">Mo mɨbere y'aBayuta bagenda ababerenga esongɨmba sabo bamonvwa kɨnwa k'ɨhatsya.</char></note> n'ɨthɨbɨtha mo muhindano nɨabahambala bathɨ: <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />«Balikyethu, bʉshana na ki omʉkola ebyo? Nethwe thʉnalɨ bandʉ, ng'imwe. Othʉbafʉlɨra <char style="w" lemma="Ngʉlʉ Mbʉya">eNgʉlʉ Mbʉya</char> mw'ɨbabwɨra thʉthɨ mulike esoshoshani sa bʉsha-bʉsha, n'ɨbɨndʉkɨra Gongo yo ʉlɨho, yo wabʉmbaga olʉbʉla n'ekɨhʉgo n'engetsɨ n'ebyoshi bɨrɨmo. <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />Mo mɨgʉlʉ ya kera, Gongo mwalika ebɨhanda byoshi bɨkwame sonzɨra sabyo. <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />Hewethuwe, mwathalika iyikangya mw'ɨkola ebɨbʉya. Ɨthoka mo lʉbʉla anabaha nvʉla yo ɨnɨetsya emyaka mo bɨrɨmo byayo, anabaha akalyo na otsutsya lʉmogo mo mʉthɨma enyu.» <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />Namo bananegenaga ebɨnwa ebi, lyabyaga litsibuhire ko bathʉmwa ɨhangɨra omuhindano bathahereramo bʉhere.<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />Honyuma kw'ebyo <char style="w" lemma="Bayuta">aBayuta</char> mobahika nɨabathoka iAntiokia n'iIkonio, na mobuhya abandʉ mo muhindano. Mobagʉshɨra Polo yo mabwe bʉshana bamwithe, mobamʉkʉrɨra ko kyashwa ky'omuyi, mobaganɨtsya bathɨ amalire ɨfwa. <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />Hewethuwe abɨkɨrɨtsya babere bamuthimbako, mwahangana, mwashʉbaya mo muyi. Bwabere bwakya, mwaya ɨTerebe hagʉma na Baranaba.<verse eid="ACT 14:20" /></para>
  <para style="s">Polo na Baranaba bamashʉba iAntiokia mo kɨhʉgo ky'iSuria</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />Polo na Baranaba mobafʉla <char style="w" lemma="Ngʉlʉ Mbʉya">eNgʉlʉ Mbʉya</char> mo muyi w'ɨTerebe eyo babonaga <char style="w" lemma="Abɨga">bɨga</char> bangɨ. Honyuma kw'aho mobashʉbaya iLisitira, n'iIkonio nɨ iAntiokia y'omo kɨhʉgo ky'iPisitia. <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />Eyo mobagenda abashikya emɨthɨma y'<char style="w">abɨga</char>, n'ɨhabo muhwa mw'itsitsinia mo lwɨkɨrɨtsyo. Bagenda ababwɨrabo bathɨ: «Lɨtholere nɨthwɨngɨra mo <char style="w">Bwamɨ bwa Gongo</char> mʉ malɨgo mangɨ.» <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />Babere bamamala <char style="w" lemma="Iyima kalyo">iyima akalyo</char> n'ɨshaba, mobahira mo bʉlɨ <char style="w">kanisa</char> mo bangʉmwa, mobahirabo mo minwe ya Nyinya-kowethʉ yo bɨkɨrɨtsyaga.<verse eid="ACT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24" />Honyuma kw'aho mobatsʉka mo kɨhʉgo ky'iPisitia mobɨngɨra mo kɨhʉgo ky'iPamufilia. <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />Babere bamamala ɨfʉla <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char> mo muyi w'ɨPerenga, honyuma kw'aho mobaya mo muyi w'iAtalia. <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />Babere bathoka eyo, mobaya iAntiokia y'iSuria mʉ bwatho, omuyi bashabɨrawamo olʉkogo lwa Gongo bʉshana n'omʉlɨmo babyaga nɨbamamala. <verse eid="ACT 14:26" /><verse number="27" style="v" sid="ACT 14:27" />Babere bahika iAntiokia, mobahindania <char style="w" lemma="Kanisa">akanisa</char> n'ɨbwɨrako ebyoshi Gongo akolaga kw'ɨtsʉkɨrabo, na ko mwakɨngʉlɨra abandʉ b'ebɨhanda nabo olukyo lw'olwɨkɨrɨtsyo. <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />Polo na Baranaba mobikala iAntiokia yo bɨro bɨngɨ hagʉma <char style="w" lemma="Abɨga">n'abɨga</char>.<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s">Omuhindano w'abathʉmwa n'abangʉmwa b'ɨYerʉsalemʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />Honyuma kw'aho bandʉ bagʉma mobathoka mo kɨhʉgo ky'iYuteya mobandagalɨra mo muyi w'iAntiokia. Abandʉ abo mobathanga ɨkangɨrɨtsya abɨkɨrɨtsya bathɨ: «Mwamabya <char style="w" lemma="Ɨmona">mʉthamwene</char> nga okw'oMʉgomba wa Mʉsa ahamulire, mʉthangashabʉlwa.» <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />Polo na Baranaba mobathɨndawo. Mobagenda abakubisania nabo kʉtsɨbʉ bʉshana n'omwatsɨ oyo. Bʉshana n'ekyo abɨkɨrɨtsya mobikiritsania ɨthʉma Polo na Baranaba na bagʉma ba mʉbo bɨrʉkɨre ɨYerʉsalemʉ, bayasɨmole <char style="w" lemma="Bathʉmwa">n'abathʉmwa</char> n'abangʉmwa b'ekanisa bʉshana n'obʉhaka obo.<verse eid="ACT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3" />
    <char style="w" lemma="Kanisa">Akanisa</char> k'omo muyi w'iAntiokia kabere kamamala ɨthʉmabo, bo bathʉmawa abo, mobakirukania mo kɨhʉgo ky'iFoiniki na mo ky'ɨSamarɨa, nɨbanemʉfʉlɨra abandʉ bayo nga ko abandʉ b'ebɨhanda nabo ko bamabɨndʉkɨra Gongo. Omwatsɨ oyo mwaletha lʉmogo lʉnene mo bɨkɨrɨtsya boshi.<verse eid="ACT 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 15:4" />Polo na balikyabo babere bahika ɨYerʉsalemʉ, <char style="w" lemma="Kanisa">akanisa</char> n'<char style="w" lemma="Bathʉmwa">abathʉmwa</char> hagʉma n'abangʉmwa, mobakokyabo. Polo na balikyabo mobasɨmolerabo ebyoshi Gongo akolaga mw'ɨtsʉkɨrabo. <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />He bandʉ bagʉma b'omo kɨkembe <char style="w" lemma="Bafarisayo">ky'aBafarisayo</char> bo bathɨkɨrɨtsya Nyinya-kowethʉ, mobimana n'ɨnegena bathɨ: «Lɨtholere abandʉ b'ebɨhanda abo bathɨkɨrɨtsya nabo <char style="w" lemma="Ɨmona">nibamonibwa</char> n'ɨhamʉlabo bagende abakola nga ko <char style="w" lemma="Mʉgomba">oMʉgomba</char> wa Mʉsa anegenire.»<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />Bʉshana n'ekyo <char style="w" lemma="Bathʉmwa">abathʉmwa</char> n'abangʉmwa b'ekanisa mobikala bʉshana basonzomole omwatsɨ oyo. <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />Obʉhaka bwabere bwabya bʉngɨ, Petero mwimana n'ɨnegena athɨ: «Imwe bagala bethʉ, ndɨ mwetsi ɨthanga kera ko Gongo mwanyɨshombola mo kathi kenyu, kʉshangwa nyɨgende enyɨfʉla <char style="w" lemma="Ngʉlʉ Mbʉya">eNgʉlʉ Mbʉya</char> ko bandʉ b'ebɨhanda, bʉshana b'onvwero na bɨkɨrɨtsye. <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />Gongo yo wetsi emɨthɨma y'abandʉ, mwakangania kwenene kw'amatsɨga abandʉ b'ebɨhanda mw'ɨhabo <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> nga kw'athʉhagawo nethwe. <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />Mwathakola ndondogoli na hake mo kathi k'ithwe nabo, kʉshangwa mw'ɨkɨrɨtsya lyabo, nabo mwetsya emɨthɨma yabo. <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />Ewono bʉshana na ki omʉlenga kʉ Gongo mw'ihekya <char style="w">abɨga</char> aba bw'omʉtsɨgo wo bo thatha nethwe thwalemawa ɨheka? <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />Bɨthatholere ibya bithyo, kʉshangwa ithwe nabo thwɨkɨrɨtsye ko ithwe boshi thwashabʉlawa mo lʉkogo lwa Nyinya-kowethʉ Yesʉ.»<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />Aho abandʉ boshi bo babyaga mo muhindano mobatsɨra. Mobahʉlɨkɨrɨtsya Baranaba bana Polo balɨ abasɨmola ko bɨmɨnyɨkalo n'ebɨthɨko-thɨko byoshi byo Gongo akolaga mw'ɨtsʉkɨrabo mo kathi k'abandʉ b'ebɨhanda.<verse eid="ACT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 15:13" />Babere bamamala ɨsɨmola, Yakobo naye mwanegena athɨ: «Bagala bethʉ, mʉnyɨhʉlɨkɨrɨtsye! <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />Simoni<note caller="+" style="f"><char style="fr" closed="false">15:14 </char><char style="fq" closed="false">Simoni </char><char style="ft" closed="false">kandɨ yo na Petero. Soma </char><char style="xt" closed="false"><ref loc="MAT 4:18">Matayo 4:18</ref>.</char></note> oyu amathʉganʉlɨra ko Gongo mwathanga ɨyɨshombolera abandʉ b'ebɨhanda kʉshangwa bagʉma ba mʉbo babye bandʉ bʉwe. <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />N'ekɨnwa eki kɨrɨngene n'ebɨnwa <char style="w" lemma="Mʉmɨnyeretsɨ">by'abamɨnyeretsɨ</char> byo bishakirwe mo Mashako Abuyirire athɨ:<verse eid="ACT 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16" />“Honyuma w'ebyo nyandashʉba hika,</para>
  <para style="q1" vid="ACT 15:16">n'ɨshʉba imania enyʉmba ya <char style="w">Tawiti</char>,</para>
  <para style="q1" vid="ACT 15:16">nyandashʉba imaniaro,</para>
  <para style="q1" vid="ACT 15:16">nga ko banashʉba himba enyʉmba yo yithabya niyamalire ɨthera.<verse eid="ACT 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17" />Ebyo byandaleka abandɨ bandʉ boshi nɨbanyɨbɨndʉkɨra,</para>
  <para style="q1" vid="ACT 15:17">kʉshangwa abandʉ b'ebɨhanda byoshi bo nyabɨrɨkɨraga, babye bandʉ baye.</para>
  <para style="q1" vid="ACT 15:17">Ebyo byo nyɨnegena ingye Nyinya-kowethʉ.<verse eid="ACT 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 15:18" />Ebɨnwa ebyo, nɨ ingye nyakanganayabyo ɨthanga kera.<note caller="+" style="f"><char style="fr" closed="false">15:16-18 </char><char style="xt" closed="false">Soma <ref loc="AMO 9:11-12">Amosi 9:11-12</ref>.</char></note>”»<verse eid="ACT 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />Yakobo mwashʉba negena athɨ: «Bʉshana n'ekyo, ingye nyamashʉnga ko abandʉ b'ebɨhanda bo babɨndʉkɨra Gongo lɨthatholere thʉgende othunubyabo. <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />Hewethuwe lɨtholere thʉshakɨrebo thʉthɨ bathalyaga ku kalyo kathahererwa abatsɨmʉ, bathagenda abakola rʉsɨngɨ, bathagenda abalya nyama sithaniwa, na bathalyaga n'omʉlegano. <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />Kʉshangwa ɨthanga kera oMʉgomba wa Mʉsa agenda asomwa mo so<char style="w">sinakoki</char> na abyaga awithe bandʉ bo bagenda abakangɨrɨtsyawo mo bʉlɨ kɨro <char style="w" lemma="Sabato">ky'eSabato</char> mo bʉlɨ muyi.»<verse eid="ACT 15:21" /></para>
  <para style="s">Amarʉba w'ashakɨrwa abɨkɨrɨtsya b'omo bandʉ b'ebɨhanda</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />Aho <char style="w" lemma="Bathʉmwa">abathʉmwa</char> n'abangʉmwa <char style="w" lemma="Kanisa">n'akanisa</char> koshi, mobahamʉla ɨshombola bagʉma mʉbo bo bagenda hagʉma na Polo na Baranaba iAntiokia. Mobashombola Yuta yo wahʉlawamo Barisaba bana Sɨla. Abandʉ babɨrɨ abo babyaga nibashikibwe mo bagala bethʉ bɨkɨrɨtsya. <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />Mobathʉmabo na marʉba ashakire athɨ:</para>
  <para style="pi" vid="ACT 15:23">«Ithwe <char style="w" lemma="Bathʉmwa">bathʉmwa</char> n'abangʉmwa na bagala bethʉ bɨkɨrɨtsya, othʉbaketsya imwe bagala bethʉ bɨkɨrɨtsya b'omo bandʉ b'ebɨhanda imwe mʉlɨ mo muyi w'iAntiokia, mo kɨhʉgo ky'iSuria na ky'iKilikia.<verse eid="ACT 15:23" /></para>
  <para style="pi">
    <verse number="24" style="v" sid="ACT 15:24" />«Mothwonvwa omwatsɨ ko kʉlɨ bandʉ bagʉma mobathokire ewethʉ eno, mobayire babwɨra bɨnwa b'ɨbakendetsya na b'igangya-gangya emɨthɨma enyu. Abandʉ abo thʉthalɨ ithwe thʉthathʉmabo. <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />Nɨ bʉshana n'ekyo ithwe thwamikiritsania ɨshombola bandʉ bagʉma mw'ithwe n'ɨbatʉmɨrabo, hagʉma n'abatsɨɨrwa bethʉ Baranaba na Polo, <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />bo bathashɨga obʉyɨngo bwabo bʉshana n'omʉlɨmo w'erɨkolera Nyinya-kowethʉ Yesʉ <char style="w" lemma="Kirisito, Masia">Kirisito</char>. <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />Aho thwamabathʉmɨra Yuta na Sɨla n'ɨbo bo bababwɨra bʉnʉ kʉ bʉnʉ ebɨnwa byo thwamabashakɨra.<verse eid="ACT 15:27" /></para>
  <para style="pi">
    <verse number="28" style="v" sid="ACT 15:28" />«Kʉshangwa mobimoya <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> nethwe bene, thʉthahekayabo ʉndɨ mʉtsɨgo athalɨ ebɨnwa bɨtholere ebi: <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />Muthalyaga kalyo kathahererwa batsɨmʉ, muthalyaga mʉlegano, kʉtse muthalyaga nyama sithaniwa na muyitheye ko rʉsɨngɨ. Mwamayitheya kw'ebyo nɨmwamakola kʉbʉya. Mubye n'obʉholo!»<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />Babere balagana, abo bathʉmawa mobandagalɨra iAntiokia. Babere bahika eyo, mobahindania abɨkɨrɨtsya boshi, n'iwathyabo amarʉba ayo. <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />Nabo babere basoma amarʉba ayo, mobamoga kʉshangwa ebɨnwa byabyagamo byabyaga b'ɨhabo muhwa. <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />Kʉshangwa Yuta na Sɨla babyaga <char style="w" lemma="Mʉmɨnyeretsɨ">bamɨnyeretsɨ</char>, mobabwɨra abagala bethʉ bɨkɨrɨtsya abo bo bɨndɨ bɨnwa bɨngɨ b'ɨhabo muhwa n'ɨsɨngɨrɨkabo.<verse eid="ACT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 15:33" />Babere bamala bɨro bɨrebe iAntiokia eyo, bagala bethʉ bɨkɨrɨtsya mobalagabo bathɨ bafʉlʉke na bʉholo, eyo yɨrɨ bo bathʉmagabo. <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />[He Sɨla ɨye mwahamʉla ishibayo.<note caller="+" style="f"><char style="fr" closed="false">15:34 </char><char style="ft" closed="false">Omʉlondo ono athalɨ mʉ wandɨ mashako magʉma wa kera.</char></note>] <verse eid="ACT 15:34" /><verse number="35" style="v" sid="ACT 15:35" />Polo na Baranaba ɨbo mobikala iAntiokia. Oko, ababɨrɨ abo hagʉma na bandɨ bandʉ bangɨ, bagenda abakangɨrɨtsya n'ɨfʉlɨra abandʉ bw'eKɨnwa kya Nyinya-kowethʉ.<verse eid="ACT 15:35" /></para>
  <para style="s">Polo na Baranaba bamamikana</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />Honyuma wa bɨro bɨrebe, Polo mwabwɨra Baranaba athɨ: «Thʉshʉbe ɨya lungula abagala bethʉ bɨkɨrɨtsya mo bʉlɨ muyi wo thwafʉlɨragamo abandʉ eKɨnwa kya Nyinya-kowethʉ, kʉshangwa thʉmɨnye nga balɨyo bathɨ.» <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />Baranaba abyaga niashondya bagende na Yoani yo wahʉlwamo Marɨko. <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />Hewethuwe Polo ɨye mwashʉnga nibithakwirire erɨgenda n'omʉndʉ oyo. Kʉshangwa babere bakɨnalɨ mo kɨhʉgo ky'iPamufilia, mwayɨhɨgʉla kʉbo, n'ɨthɨnda ɨshʉba kola hagʉma nabo mo mʉlɨmo wabo.<note caller="+" style="f"><char style="fr" closed="false">15:38 </char><char style="xt" closed="false">Soma <ref loc="ACT 13:13">Mɨkolano 13:13</ref>.</char></note> <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />Bʉshana n'ekyo Polo na Baranaba mobakubisania kʉtsɨbʉ, mobahika ko kɨka ky'erimikana. Baranaba mwagenda na Marɨko, mobɨngɨra mo bwatho n'ɨshabʉkɨra ko kɨtsɨra ky'iKipuro,<note caller="+" style="f"><char style="fr" closed="false">15:39 </char><char style="ft" closed="false">Baranaba oyo abyaga mʉndʉ wa ko kɨtsɨra ky'iKipuro. </char><char style="xt" closed="false">Soma <ref loc="ACT 4:36">Mɨkolano 4:36</ref>.</char></note> <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />na Polo mwashombola ɨgenda na Sɨla. Abagala bethʉ bɨkɨrɨtsya babere bamamala ɨshabɨrabo olʉkogo lwa Nyinya-kowethʉ, nabo mobagenda. <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />Mo lʉgendo olo Polo mwatsʉka mo kɨhʉgo ky'iSuria na mo ky'iKilikia alɨ ashikya olwɨkɨrɨtsyo <char style="w" lemma="Kanisa">lw'esokanisa</char>.<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s">Timote aherekeretsya Polo bana Sɨla</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />Aho Polo mwahika mo muyi w'ɨTerebe na w'iLisitira. Mo muyi w'iLisitira oyo mwabyaga <char style="w" lemma="Abɨga">mwɨga</char> mʉgʉma erɨtsɨna lɨwe nɨ yo Timote. Timote oyo nyinya abyaga <char style="w" lemma="Bayuta">Muyuta</char> yo wabyaga nɨamɨkɨrɨtsya, hewethuwe ishe abyaga <char style="w" lemma="Bakiriki">Mukiriki</char>. <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />Abagala bethʉ bɨkɨrɨtsya b'omo muyi w'iLisitira n'abo mo muyi w'Ikonio bagenda abanegena kʉ Timote oyo ko bɨbʉya. <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />Polo abyaga niashondya athɨ Timote agende amʉherekeretsya mo so ngendo sɨwe. Aho Polo mwathanga <char style="w" lemma="Ɨmona">imumonia</char>, bʉshana <char style="w" lemma="Bayuta">aBayuta</char> bo babyaga mo bɨthambɨ ebyo bamʉtsɨge. Kʉshangwa aboshi babyaga nibetsi kw'ishe abyaga <char style="w" lemma="Bakiriki">Mukiriki</char>. <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />Mo miyi bagenda abatsʉka, bagenda abafʉlɨra abɨkɨrɨtsya ebɨnwa ebyo <char style="w" lemma="Bathʉmwa">abathʉmwa</char> n'abangʉmwa b'ekanisa k'ɨYerʉsalemʉ bahamʉlaga. Ebɨnwa ebyo bagenda ababwɨrabo bathɨ bagende abakola nga ko bɨthanegenwa. <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />Aho <char style="w" lemma="Kanisa">amakanisa</char> mwayɨra kagala mo lwɨkɨrɨtsyo, n'emɨganzo yawo yagenda eyongereka bʉlɨ kɨro.<verse eid="ACT 16:5" /></para>
  <para style="s">Polo abɨrɨkɨrwa iMaketonia</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />Polo n'abo bamʉherekeretsaya mobatsʉka mo kɨhʉgo ky'iFurikia na eky'ɨNgalatɨa, mobahangɨrwa <char style="w" lemma="Mʉthɨma Mwerʉ">n'oMʉthɨma Mwerʉ</char> bathakangɨrɨtsaya <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char> mo kɨhʉgo ky'iAsia. <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />Babere bahika hofɨ n'ekɨhʉgo ky'iMisia, mobayɨrenga ɨya iBitinia, hewethuwe <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma</char> wa Yesʉ mwashʉba hangɨrabo. <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />Bʉshana n'ekyo, mobakirukania mo kɨhʉgo ky'iMisia na mobandagalɨra mo muyi w'ɨTʉroa.<verse eid="ACT 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 16:9" />Bwabere bwabya kɨro, Polo mwashʉnga humanani. Mwashʉnga mʉndʉ mʉgʉma w'iMaketonia n'imene embere sɨwe nɨamʉshaba athɨ: «Shabʉkɨra mo kɨhʉgo kyethʉ ky'iMaketonia uthuwathikye.» <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />Aho n'aho honyuma w'ehumanani eyo, mothwathegekania ɨya iMaketonia, kʉshangwa mothwamɨnya kwenene ko Gongo mwathʉbɨrɨkɨra bʉshana thʉyafʉlɨre abandʉ bayo <char style="w" lemma="Ngʉlʉ Mbʉya">bw'eNgʉlʉ Mbʉya</char>.<verse eid="ACT 16:10" /></para>
  <para style="s">Lutia ɨkɨrɨtsya Yesʉ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />Honyuma kw'aho, mothwathoka ɨTʉroa mʉ bwatho, mothwagenda lʉgʉmerera n'ihika ko kɨtsɨra ky'iSamotirake. Bwabere bwakya mothwahika mo muyi w'iNeapoli. <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />Thwabere thwathoka iNeapoli mothwahika mo muyi w'iFilipi, ow'abyaga muyi mʉnene w'ekɨhʉgo ky'iMaketonia. Omuyi oyo agenda athegekwa n'aBaroma. Mothwikala mo muyi oyo mo bɨro bɨrebe.<verse eid="ACT 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 16:13" />Ekɨro <char style="w" lemma="Sabato">ky'eSabato</char> kyabere kyahika, mothwahʉlʉkɨra embʉga y'omuyi oyo, na mothwaya emʉsɨke wa lwitsi lʉgʉma, ho thwaganɨtsaya thʉthɨ thwabona ahandʉ aBayuta abanashabɨra Gongo. Mothweya bakatsɨ bagʉma nibahindene aho, mothwikala na mothwathanga ɨsɨmolerabo bʉshana na Yesʉ. <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />Mo kathi k'abakatsɨ abo mwabyaga mʉkatsɨ mʉgʉma, erɨtsɨna lɨwe nɨ yo Lutia w'omo muyi w'iTuatera. Lutia oyo agenda agʉtsya ngɨmba sa ngʉla sa kɨtsɨro kɨnene, kuthyo agenda aramya Gongo. Mo ndambi Polo agenda asɨmola, Nyinya-kowethʉ mwakɨngʉla omʉthɨma ʉwe ihika ko kɨka mwɨkɨrɨtsya ebɨnwa byo Polo agenda anegena. <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />Honyuma kw'aho, <char style="w" lemma="Lubatiso">mwabatisibwa</char> ɨye n'olʉganda lʉwe. Mwathʉshaba kʉtsɨbʉ athɨ: «Mwamashʉnga ko nyɨkɨrɨtsye Nyinya-kowethʉ, muhike mʉhʉmbɨrɨre omwaye.» Mwathʉhathɨka thʉtsɨge.<verse eid="ACT 16:15" /></para>
  <para style="s">Polo bana Sɨla bamamɨnwa</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />Kɨro kɨgʉma thwabere thʉlɨ othʉya ahandʉ h'erɨshabɨra, mothwahindana na mʉthasha mʉgʉma mukoli. Omukoli oyo abyagamo <char style="w" lemma="Batsɨmʉ">mʉtsɨmʉ</char> w'ɨlagʉla. Na mo bʉlagʉ obo mwalethera abo nyinya-kowabo bo ndundi nyɨngɨ. <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />Omʉthasha oyo agenda akwama Polo nethwe, nɨahambala athɨ: «Abandʉ aba nɨ bakoli ba Gongo yo ʉlɨ elʉgʉlʉ! Abababwɨra bʉshana n'enzɨra yo mwangashabʉlwamo!» <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />Mwakola ebyo kʉ bɨro bɨngɨ. Ko nduli Polo mwahɨthana kʉtsɨbʉ. Aho kɨro kɨgʉma mwabɨndʉka n'ɨbwɨra <char style="w" lemma="Batsɨmʉ">omʉtsɨmʉ</char> oyo athɨ: «Mw'ɨtsɨna lya Yesʉ <char style="w" lemma="Kirisito, Masia">Kirisito</char> enyɨkʉhamʉla nyɨthɨ thoka ko mʉthasha oyu!» Aho n'aho <char style="w" lemma="Batsɨmʉ">omʉtsɨmʉ</char> mwamʉthokako.<verse eid="ACT 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19" />Aho bonyinya-kowabo omʉthasha oyo babere bashʉnga omuyinihiro wabo w'erɨbona endundi yabo mw'ɨtsʉkɨra omʉthasha oyo ko amahwa, mobatsɨmba Polo na Sɨla. Mobakʉrɨrabo ho bandʉ bangɨ abanahindanira embere s'abakʉlʉ b'omuyi. <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />Babere bahikyabo embere y'abasohi ba b'aBaroma abo, mobathanga ɨnegena bathɨ: «Abandʉ aba nɨ <char style="w">Bayuta</char> nabo abaletha bʉrʉnga bʉnene mo muyi ethʉ ono. <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />Kandɨ emɨbere abakangɨrɨtsya abandʉ, nɨ eyo thuhangirwe ithwe <char style="w" lemma="Roma">Baroma</char>, ɨtsɨgaro kʉtse ɨkolaro.»<verse eid="ACT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 16:22" />Omuhindano w'abandʉ mwagʉlʉkɨra Polo bana Sɨla. Abasohi mobahamʉla abashirikani bathɨ: «Muthokye kʉbo kw'esongɨmba, na muhire kʉbo ko mbasha.» <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />Babere bamamala ihumbabo kʉtsɨbʉ, mobagʉshabo mo biriso. Mobahamʉla omutheya bathɨ atheyebo kʉbʉya. <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />Aho, erɨkwamana n'ehamuli eyo, omutheya oyo mwahirabo mʉ kɨshenge mw'emwishi kʉtsɨbʉ ky'ebiriso ebyo, na mwamɨnɨra ebɨshando byabo byo kʉ kisingiti kya mʉthɨ<figure style="fig" alt="Paul et Silas en prison" file="wa03976.jpg" size="col" ref="16:24">Polo bana Sɨla baminirwe mo biriso</figure>.<verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />Bwabere bwahika hofɨ kathi ka kɨro, Polo na Sɨla babyaga nɨbakɨnalɨ abashaba n'imba nyimbo s'isingya Gongo. N'abandɨ bandʉ b'omuliki nɨabahʉlɨkɨrɨtsyabo. <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />Aho n'aho, mokwabya kalingiti katsɨbʉ ihika ko kɨka mokathengania emɨsɨngɨ y'ebiriso. Esonyuyi soshi s'ebiriso mosakɨngʉkala n'amahʉlʉla w'abyaga aminire abandʉ boshi b'omuliki mwayɨmɨnʉla. <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />Omutheya abere abʉka, mwashʉnga kw'esonyuyi s'ebiriso sɨkɨngʉkere, mwathokya omuyali w'omo lʉba athɨ ayithe, kʉshangwa mwaganɨtsya athɨ abandʉ b'omuliki barombokire. <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />Hewethuwe Polo mwahambala mʉ mʉlenge mʉnene athɨ: «Uthayithaga, kʉshangwa ithwe boshi thʉlɨ hano!» <verse eid="ACT 16:28" /><verse number="29" style="v" sid="ACT 16:29" />Aho omutheya mwashaba ahabwe kɨmole, mwangʉha tsʉba n'ɨyɨgʉsha mo kɨshenge ekyo, na mwawa mo bɨshando bya Polo bana Sɨla, niathithimana bʉshana n'obʉba.<verse eid="ACT 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 16:30" />Honyuma kw'aho, mwahulukyabo n'ɨbʉtsyabo athɨ: «Bonyinya-kowethʉ, nyɨyɨre ki bʉshana nyɨshabʉlwe?» <verse eid="ACT 16:30" /><verse number="31" style="v" sid="ACT 16:31" />Mobamʉshʉbɨtsya bathɨ: «Wɨkɨrɨtsye Nyinya-kowethʉ Yesʉ, nawe washabʉlwa, ɨwe n'olʉganda lwawe.» <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />Na mobamʉfʉlɨra eKɨnwa kya Nyinya-kowethʉ, hagʉma n'olʉganda lʉwe. <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />Aho n'aho mo kɨro ekyo, omutheya oyo mwatsɨmba Polo bana Sɨla, mwashomola ebɨhʉlʉ byabo. Nabo <char style="w" lemma="Lubatiso">mobamubatisya</char> ɨye n'olʉganda lʉwe loshi. <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />Honyuma kw'aho mwabwɨrabo athɨ bɨrʉkɨre omwe, mwashegerabo shego. Omutheya oyo n'olʉganda lʉwe loshi mobabya na lʉmogo bʉshana bamɨkɨrɨtsya Gongo.<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />Bwabere bwakya, abasohi b'aBaroma mobathʉma bakʉlʉ bagʉma ba bashirikani ko omutheya w'ebiriso bayamʉbwɨre bathɨ: «Mɨnʉla abandʉ abo.» <verse eid="ACT 16:35" /><verse number="36" style="v" sid="ACT 16:36" />Omutheya naye mwayabwɨra Polo athɨ: «Abasohi bamanyɨthʉmɨra mwatsɨ bathɨ nyɨbamɨnʉle. Aho mʉthokemo n'ɨgenda mʉ bʉholo.» <verse eid="ACT 16:36" /><verse number="37" style="v" sid="ACT 16:37" />Hewethuwe Polo mwabwɨra abakʉlʉ b'abashirikani abo athɨ: «Abasohi abo mobahamʉla bathɨ thuhumbirwe embere s'abandʉ bʉthabʉrana, naho nethwe nɨ thʉlɨ <char style="w" lemma="Roma">Baroma</char>.<note caller="+" style="f"><char style="fr" closed="false">16:37 </char><char style="ft" closed="false">aBaroma babyaga nɨ bathahamulirwe ihumba Mʉroma mulikyabo. Polo na Sɨla babyaga Bayuta, hewethuwe amathegeko wa Baroma abyaga n'imirebo nga Baroma.</char></note> Honyuma kw'aho mobathʉgʉsha mo biriso bɨno. Aho bathɨ ko bashondya ɨthʉmɨnʉla mʉ bubisho-bisho? Bɨthathokekene kundu! Ɨbo bene-bene bahike bathʉmɨnʉle.» <verse eid="ACT 16:37" /><verse number="38" style="v" sid="ACT 16:38" />Abakʉlʉ b'abashirikani mobayafʉlɨra ebɨnwa ebyo by'abasohi <char style="w" lemma="Roma">b'aBaroma</char>. Babere bonvwa ko Polo bana Sɨla nabo ko nɨ <char style="w" lemma="Roma">Baroma</char> mobʉbaha kʉtsɨbʉ. <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />Aho abasohi abo mobayashababo buganyiri, n'ithokyabo mo biriso. Honyuma kw'aho mobabwɨra Polo bana Sɨla bathɨ bathoke mo muyi oyo.<verse eid="ACT 16:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 16:40" />Aho Polo bana Sɨla babere bamamala ɨthoka mo biriso, mobaya ewa Lutia. Babere bamamala ɨshʉnga abagala bethʉ bɨkɨrɨtsya n'ɨhabo muhwa, mobathoka mo muyi oyo.<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s">Polo bana Sɨla balɨ mo muyi w'iTesalonika</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />Polo na Sɨla mobalotsya ebʉshondotsɨ mo lʉgendo lwabo, mobatsʉka mo muyi w'iAmufipoli na mo muyi w'iApolonia, mobahika mo muyi w'iTesalonika. Mo muyi oyo, mwabyaga <char style="w" lemma="Sinakoki:">sinakoki</char> <char style="w" lemma="Bayuta">y'aBayuta</char>. <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />Polo mwashushikania <char style="w">Sabato</char> ishathu nɨanemwɨngɨra mo sinakoki nga ko abyaga abegere. Omo sinakoki eyo, mwasɨmola n'abo eyagamo, <char style="w" lemma="Mashako Abuyirire">ko Mashako Abuyirire</char>. <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />Agenda asonzomolerabo n'ikangyabo, ko <char style="w" lemma="Kirisito, Masia">Kirisito</char> abyaga nɨatholere ɨgalwa n'ilubuka mo baholi. Na kuthyo agenda abwɨrabo athɨ: «Yesʉ oyo nyɨbafʉlɨra, n'ɨye yona <char style="w" lemma="Kirisito, Masia">Kirisito</char>.» <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />Aho Bayuta bagʉma mobɨkɨrɨtsya na mobayihira ko mʉnda wa Polo bana Sɨla. Na kuthyo <char style="w">Bakiriki</char> bangɨ bo babyaga nɨ abanaramya Gongo na bakatsɨ bangɨ bo babyaga bashikibwe nabo mobɨkɨrɨtsya.<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />Hewethuwe <char style="w">Bayuta</char> bagʉma mobafwa mwisho. Mobahindania bandʉ babɨ bo beyaga mo ndaki. Honyuma kw'aho mobayihira hagʉma nɨthangɨtsya bʉrʉnga mo muyi. Mobayɨngɨrɨra mo nyʉmba ya Yasoni niabayashondya Polo bana Sɨla bʉshana bathwalebo embere s'abandʉ, <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />hewethuwe mobatheya b'omo. Mobakʉrɨra Yasoni n'abandɨ bagala bethʉ bɨkɨrɨtsya bagʉma embere y'abakʉlʉ b'omuyi. Na mobathanga ɨhambala bathɨ: «Abandʉ aba mobaletha bʉrʉnga mo kɨhʉgo kyoshi, na lɨno babano bahera kʉno! <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />Na nɨ Yasoni oyu yo uthakokyabo omwe! Abandʉ boshi aba abakola ebɨthalɨngene n'<char style="w" lemma="Mathegeko">amathegeko</char> wa <char style="w" lemma="Kaisari">Kaisari</char>, kʉshangwa ɨbo abanegena bathɨ halɨ ʉndɨ mwamɨ mbʉ yo Yesʉ!» <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />Ebɨnwa ebi mobyathabagania omuhindano n'abakʉlʉ b'omuyi. <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />Yasoni na balikyabo mobathanga ɨthʉnga ndihi ko bakʉlʉ embere balikebo.<verse eid="ACT 17:9" /></para>
  <para style="s">Polo na Sɨla mo muyi w'ɨBeroya</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />Bwabere bwahika kɨro, abagala bethʉ bɨkɨrɨtsya mobaherekeretsya Polo bana Sɨla ɨBeroya. Babere bahikayo mobɨngɨra mo <char style="w" lemma="Sinakoki">sinakoki</char> <char style="w" lemma="Bayuta">y'aBayuta</char>. <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />Abandʉ b'ɨBeroya babyaga ba mʉthɨma mʉbʉya kʉlenga Abanyatesalonika, kʉshangwa ɨbo mobakokya <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char> na ngʉmbʉ nyɨngɨ. Bʉlɨ kɨro bagenda abasonzomola <char style="w" lemma="Mashako Abuyirire">aMashako Abuyirire</char> bʉshana n'ɨmɨnya ng'ebyo Polo anegena nga nɨna bya kwenene. <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />Bayuta bangɨ mʉbo mobɨkɨrɨtsya hagʉma na bakatsɨ bangɨ <char style="w">Bakiriki</char> bo bashikibwe na bayira bangɨ.<verse eid="ACT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 17:13" />Hewethuwe <char style="w" lemma="Bayuta">aBayuta</char> b'iTesalonika babere bonvwa ko Polo kw'afʉla kuthyo <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char> ky'omo muyi w'ɨBeroya, oko nako mobayako n'ɨyakaramya abandʉ n'ɨretha bʉrʉnga mo muhindano. <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />Aho n'aho abagala bethʉ bɨkɨrɨtsya mobaherekeretsya Polo y'oko kyambʉ ky'engetsɨ. Hewethuwe ye Sɨla bana Timote ɨbo mobashiba ɨBeroya. <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />Abandʉ bo baherekeretsaya Polo mobamuhikya mo muyi w'ɨAtene. Babere balɨ abashʉba ɨBeroya, Polo mwahamʉla athɨ babwɨre Sɨla na Timote, bamweye tsʉba.<verse eid="ACT 17:15" /></para>
  <para style="s">Polo asɨmola n'abandʉ b'ɨAtene</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />Polo abere akinalindire Sɨla bana Timote mo muyi w'ɨAtene, mwagenda ashʉnga kw'omuyi oyo otswiremo ebishoshekano by'esogongo. Ebyo mobyamwitha mʉthɨma. <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />Aho mwagenda asɨmola <char style="w" lemma="Bayuta">n'aBayuta</char> mo <char style="w" lemma="Sinakoki:">sinakoki</char> hagʉma n'abandʉ b'ebɨhanda bo babyaga nɨ abanaramya Gongo. Na bʉlɨ kɨro kuthyo agenda asɨmola n'abandʉ abo agenda eya ahandʉ h'erihindanira.<verse eid="ACT 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 17:18" />Bakangɨrɨtsya bagʉma b'omo kɨkembe ky'aBaepikurio na ky'aBasitoiko nabo mobathanga ikubisania na Polo.<note caller="+" style="f"><char style="fr" closed="false">17:18 </char><char style="ft" closed="false">Kera kera, Baepikurio na Basitoiko byabyaga bɨkembe bɨbɨrɨ bya kalasɨ ko kagenda akakangɨrɨtsya abandʉ bw'ebɨnwa by'obwenge.</char></note> Bagʉma mʉbo bagenda ababutsania bathɨ: «Ashondya ɨnegena athɨ ki omʉndʉ w'ebɨnwa bɨngɨ oyu?» N'abandɨ bathɨ: «Alɨnga afʉla mwatsɨ w'obo gongo bagʉma bageni.» Bagenda abanegena bathyo, kʉshangwa Polo agenda afʉla <char style="w" lemma="Ngʉlʉ Mbʉya">eNgʉlʉ Mbʉya</char> ya Yesʉ n'erilubuka ly'abaholi. <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />Bʉshana n'ekyo mobathwala Polo y'embere s'oBʉshenge Bʉkʉlʉ bo bʉnahʉlwamo Areopako.<note caller="+" style="f"><char style="fr" closed="false">17:19 </char><char style="fq" closed="false">Areopako </char><char style="ft" closed="false">nɨ kathwa k'ɨAtene aho bandʉ bako bagenda abahindanira. Obʉshenge obo mobwahabwa erɨtsɨna lya kathwa ako.</char></note> Abakʉlʉ b'oBʉshenge obo mobamʉbwɨra bathɨ: «Ebɨnwa bihya-bihya ebyo ʉkangɨrɨtsya abandʉ othushondya ʉthʉsonzomolerebyo kʉbʉya. <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />Thwamanegena thuthyo kʉshangwa ebɨnwa ebyo ʉthʉbwɨra bithonvwikire kʉbʉya mo mathwi ethʉ. Aho othushondya thʉmɨnye kʉbʉya nga binegenire bithi ki.» <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />Byabyaga bithyo kʉshangwa abandʉ boshi b'ɨAtene hagʉma n'abageni bo babyaga bikereko, bagenda abatsukya endambi yabo yoshi mw'ɨsɨmola kʉtse mw'ɨonvwa emyatsɨ mihya-mihya.<verse eid="ACT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />Aho Polo mwimana mo kathi-kathi k'oBʉshenge bw'eAreopako mwanegena athɨ: «Imwe bandʉ b'ɨAtene! Nyamashʉnga kw'imwe mo bʉlɨ mwatsɨ, omʉnatsɨɨra ebɨnwa by'ekɨsomo byo kʉtsɨbʉ. <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />Nyamanegena nyithyo kʉshangwa mw'ɨtsʉka-tsʉka mo muyi enyu, monyayishungire ko bɨshoshekano byenyu ebyo munaramya. Na monyashungire kʉ bʉtara bʉgʉma bw'ɨhererako bushakirweko bʉthɨ: “Kʉ Gongo yo uthetsibwe.” Aho yo munaramya bʉthamʉmɨnya, yo nyitsire ɨbafʉlɨra.<verse eid="ACT 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 17:24" />«Gongo yo wabʉmbaga ekɨhʉgo n'ebyoshi bɨrɨmo, kandɨ nɨ ɨye yo mwenye olʉbʉla n'ekɨhʉgo. Bʉshana n'ekyo, athalɨ anikala mʉ manyʉmba wa bogongo wahimbawa na bandʉ. <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />Kuthyo ɨye athalayire iwathikibwa na bandʉ, nga mʉndʉ alayire kʉ buwathikya bʉlebe. Kʉshangwa n'ɨye yo ʉnaha abandʉ boshi bw'omʉka w'obʉyɨngo n'ebɨndɨ bɨndʉ byoshi balayireko. <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />Okw'ɨtsʉkɨra mo mʉndʉ mʉgʉma, mwabʉmba abandʉ b'ebɨhanda byoshi, bʉshana bikale ko kɨhʉgo kyoshi. Mwahirirabo bɨrɨmo na mɨhathɨ mo kɨhʉgo kyo bangikalamo. <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />Gongo akolaga athyo kʉshangwa abyaga niashondya abandʉ bamushondye, na bahike ko kɨka ky'ɨmʉbona, mobangamushondya mw'ɨmamatha-mamatha. Ko kwenene Gongo athalɨ hale n'obʉlɨ mʉgʉma kw'ithwe! <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />Kʉshangwa nɨ ko maka ʉwe waleka nithwabyaho, nithwabya niothuthengya n'ɨhʉmʉla. Ekyo kɨrɨngene nga ko bagʉma mo bashaki benyu b'esonyimbo banegenaga bathɨ: “Kʉshangwa nethwe thʉlɨ bana bʉwe.” <verse eid="ACT 17:28" /><verse number="29" style="v" sid="ACT 17:29" />Aho, kʉshangwa thʉlɨ bana ba Gongo, bɨthatholere ɨgenda thʉganɨtsya thʉthɨ Gongo ashoshikanibwe na kɨshoshekano kyakomibawa mʉ buthegekania na bwenge bwa mʉndʉ, kibye kya horo kʉtse kya faranga kʉtse ky'ibwe.<verse eid="ACT 17:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 17:30" />«Emyatsɨ yo bandʉ bagenda abakola mo bʉthamɨnya, Gongo mwathaganzɨrarobo. Hewethuwe abwɨra abandʉ boshi bo balɨ ahoshi athɨ babɨndʉke ɨthoka mo bɨtsɨbʉ byabo. <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />Kʉshangwa mwahiraho kɨro kɨgʉma ekyo andasohamo abandʉ boshi mo kwenene, kw'ɨtsʉkɨra omʉndʉ yo ashombolaga bʉshana n'omʉlɨmo oyo. Na Gongo mwabereretsya ebɨnwa ebyo, mw'ilubukya omʉndʉ oyo mo baholi.»<figure style="fig" alt="Paul preche devant le conseil dÁreopage" file="cn01993.jpg" size="col" ref="17:22-31">Polo akangɨrɨtsya embere y'oBʉshenge bw'ɨAreopako</figure><verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />Abakʉlʉ abo babere bonvwa Polo kw'asɨmola bʉshana n'erilubuka ly'abaholi, bagʉma mʉbo mobathanga ɨmʉshekeretsya. Hewethuwe bangɨ mʉbo mobanegena bathɨ: «Thwandashʉba kʉhʉlɨkɨrɨtsya ʉlɨ ʉnegena ko bɨnwa ebi ko kɨndɨ kɨro.»<verse eid="ACT 17:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 17:33" />Nɨ bathyo ko Polo amikanaga nabo. <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />Hewethuwe bandʉ bagʉma mobɨkɨrɨtsya na mobabya ko mʉnda wa Polo. Mw'abo mwabyaga Tionisi mʉgʉma w'omo Bʉshenge bw'Areopako, na mʉkatsɨ mʉgʉma yo wahʉlawamo Tamari, hagʉma n'abandɨ bandʉ.<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s">Polo mo muyi w'iKorinto</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />Honyuma kw'aho Polo mwathoka mo muyi w'ɨAtene mwaya mo w'iKorinto. <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />Abere ahika eyo, mweyayo <char style="w" lemma="Bayuta">Muyuta</char> mʉgʉma yo wagenda ahʉlwamo Akila, mbʉthɨrwa w'omo kɨhʉgo ky'ɨPonto. Ye Akila oyo hagʉma na mʉkatsɨwe Pirisila babyaga nibathetsi bamala bɨro bɨngɨ bathokire mo kɨhʉgo ky'iItalia, kʉshangwa omwamɨ Kalautio abyaga nɨamahamʉla athɨ <char style="w" lemma="Bayuta">aBayuta</char> boshi bathoke ɨRoma. Polo mwayashʉngabo. <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />Aho mwikala nabo kʉshangwa omʉlɨmo ʉwe n'owabo abyaga mʉgʉma. N'omʉlɨmo oyo abyaga w'ikomya eso hema. <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />Mo bʉlɨ kɨro ky'<char style="w">eSabato</char>, Polo agenda ɨngɨra mo <char style="w" lemma="Sinakoki:">sinakoki</char>. Agenda iuhya <char style="w" lemma="Bayuta">n'aBayuta</char> <char style="w" lemma="Bakiriki">n'aBakiriki</char> bʉshana bɨkɨrɨtsye.<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />Sɨla bana Timote babere bahika ɨthoka mo kɨhʉgo ky'iMaketonia, Polo mwatsukya endambi yɨwe yoshi mw'ɨfʉla <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char>. Agenda akangania <char style="w" lemma="Bayuta">aBayuta</char> bo kʉbʉya-kʉbʉya ko Yesʉ yo <char style="w" lemma="Kirisito, Masia">Kirisito</char>. <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />Hewethuwe aBayuta mobathɨnda ebɨnwa bya Polo n'imuhangya. Aho mwakʉngʉthɨrabo esongɨmba<note caller="+" style="f"><char style="fr" closed="false">18:6 </char><char style="ft" closed="false">Mo mɨbere y'aBayuta, erɨkʉngʉthɨra omʉndʉ y'esongɨmba binegenire bɨthɨ ʉthakɨrɨ mo myatsɨ y'omʉndʉ oyo.</char></note> sɨwe n'ɨbwɨrabo athɨ: «Mwamahera omʉsasɨ enyu abye ko mithwe enyu. Ingye nyɨthalɨ na mwinda enyu. Ɨthanga lɨno nyaya yo yɨrɨ abandʉ b'ebɨhanda.»<verse eid="ACT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 18:7" />Polo mwathoka aho, mwaya mʉ nyʉmba ya muyira mʉgʉma yo wahʉlawamo Tito Yusito. Tito oyo agenda aramya Gongo. Enyʉmba yɨwe yabyaga hofɨ <char style="w" lemma="Sinakoki">n'esinakoki</char>. <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" /><char style="w" lemma="Sinakoki">Omʉkʉlʉ w'esinakoki</char> eyo yo wahʉlawamo Kirisipo mwɨkɨrɨtsya Nyinya-kowethʉ ɨye n'abandʉ b'omwe boshi. Na Banyakorinto bangɨ bo bagenda abahʉlɨkɨrɨtsya ebɨnwa bya Polo, nabo mobɨkɨrɨtsya <char style="w" lemma="Lubatiso">n'ibatisibwa</char>.<verse eid="ACT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />Kɨro kɨgʉma mʉ kɨro Nyinya-kowethʉ mwabwɨra Polo mo humanani athɨ: «Ʉthʉbahaga, ʉhɨrɨke mw'ɨnegena na ʉthahʉlɨkɨrɨraga, <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />kʉshangwa nyɨrɨ hagʉma nawe. Hathalɨ mʉndʉ yo wandakuhirako eminwe akwagatsye, kʉshangwa mo muyi oyo, nyiwithemo bandʉ bangɨ.» <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />Mo muyi w'iKorinto oyo, Polo mwikalako mwaka mʉgʉma na myetsɨ ndathʉ alɨ akangɨrɨtsya abandʉ <char style="w" lemma="Kɨnwa kya Gongo">bw'eKɨnwa kya Gongo</char>.<figure style="fig" alt="Paul enseigne la parole de Dieu a corinthe" file="wa03982.jpg" size="col" ref="18:11">Polo akangɨrɨtsya eKɨnwa kya Gongo iKorinto</figure><verse eid="ACT 18:11" /></para>
  <para style="s">Polo asitakwa embere sa Ngalio</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />Mo mʉgʉlʉ Ngalio abyaga mʉkʉlʉ w'ekɨhʉgo ky'ɨAkaya, <char style="w" lemma="Bayuta">aBayuta</char> mobayihira hagʉma mw'ɨyɨra Polo yo nama y'ɨmʉtsɨmba n'ɨmʉthwala ko tɨrɨbɨnalɨ. <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />Mobathanga imusitaka bathɨ: «Omʉndʉ oyu uhya abandʉ athɨ bagende abaramya Gongo nga<char style="w" lemma="Mʉgomba">k'oMʉgomba</char> ethʉ athanegenire.»<verse eid="ACT 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14" />Polo abere ashondya ɨnegena, Ngalio mwabwɨra <char style="w" lemma="Bayuta">aBayuta</char> athɨ: «Imwe <char style="w">Bayuta</char> mwangasitakire omʉndʉ oyu bʉshana na kɨnwa kɨtsɨbʉ, kʉtse kɨbɨ kɨnene athakola, nyangabatheyire amathwi. <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />He kʉshangwa obʉhaka bwenyu bulebitsye bɨnwa na matsɨna, <char style="w" lemma="Mʉgomba">n'omʉgomba</char> enyu ebyo bibalebitsye imwe bene. Ebɨnwa ebɨrɨ ng'ebyo ingye nyithatsiire ɨsohabyo.» <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />Na mwaligithabo ko tɨrɨbɨnalɨ. <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />Aho, abandʉ boshi mobatsɨmba Sositene yo wabyaga <char style="w" lemma="Sinakoki">mʉkʉlʉ w'esinakoki</char>, na mobamuhumba embere y'etɨrɨbɨnalɨ. Hewethuwe ebyoshi ebyo Ngalio mwathatsomanabyo.<verse eid="ACT 18:17" /></para>
  <para style="s">Polo ashʉba iAntiokia</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />Polo mwikala bɨndɨ bɨro bɨngɨ mo muyi w'iKorinto oyo. Honyuma kw'aho mwalagana n'abagala bethʉ bɨkɨrɨtsya, mwatsɨmba bwatho bʉshana ashabʉkɨre mo kɨhʉgo ky'iSuria, nɨakwamene na Pirisila bana Akila. Embere y'erɨthoka ko kyambʉ ky'iKengureya, mwagembwa kʉshangwa abyaga nɨamamala ɨbereretsya erɨlahɨtsya akolaga embere sa Gongo. <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />Babere bahika mo muyi w'ɨEfeso, Polo mwamikana na Akila bana Pirisila. Ɨye mwɨngɨra mo <char style="w" lemma="Sinakoki:">sinakoki</char> na mwathanga ɨsɨmola <char style="w" lemma="Bayuta">n'aBayuta</char>. <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />Mobamʉshaba bathɨ ikale nabo bɨro bɨngɨ, he mwathɨnda. <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />Abere amamala ɨlagabo, mwabwɨrabo athɨ: «Gongo amashasha nyandashʉba hika ewenyu eno.» Honyuma kw'aho mwathoka ɨEfeso mʉ bwatho. <verse eid="ACT 18:21" /><verse number="22" style="v" sid="ACT 18:22" />Abere ahika mo muyi w'iKaisaria, mwɨrʉkɨra ɨYerʉsalemʉ ɨyaketsya <char style="w" lemma="Kanisa">akanisa</char>. Honyuma kw'aho mwandagalɨra mo muyi w'iAntiokia. <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />Abere amamala bɨro bɨrɨ bʉlebe mo muyi oyo, mwashʉba genda alɨ athimba mo kɨhʉgo ky'ɨNgalatɨa, na mo ky'iFurikia alɨ ashikya <char style="w">abɨga</char> boshi bo mʉthɨma mo lwɨkɨrɨtsyo lwabo.<verse eid="ACT 18:23" /></para>
  <para style="s">Apolo ahika mo muyi w'ɨEfeso na w'iKorinto</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />Mo muyi w'ɨEfeso momwahika <char style="w" lemma="Bayuta">Muyuta</char> mʉgʉma erɨtsɨna lɨwe nɨ yo Apolo. Apolo oyo abyaga mbʉthɨrwa y'omo muyi w'iAlesanduria. Abyaga muyira mbuyi mbʉya, kandɨ abyaga nietsi kʉbʉya <char style="w" lemma="Mashako Abuyirire">aMashako Abuyirire</char>. <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />N'enzɨra y'erɨkwama Nyinya-kowethʉ, naye abyaga nɨamamala ɨkangɨrɨtsɨbwaro. Anotswiremo oMʉthɨma Mwerʉ agenda afʉlɨra abandʉ n'ɨkangɨrɨtsyabo na muhwa mʉngɨ ebɨnwa by'ekwenene ebirebitsye Yesʉ. Hewethuwe abyaga nietsi <char style="w" lemma="Lubatiso">olubatiso</char> lwa Yoani lʉsha. <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />Mwɨngɨra mo <char style="w">sinakoki</char> na mwathanga ɨkangɨrɨtsya abandʉ <char style="w" lemma="Kɨnwa kya Gongo">bw'eKɨnwa kya Gongo</char> bʉtsɨra bʉba. Pirisila bana Akila babere bamamala ɨmʉhʉlɨkɨrɨtsya, mobagenda naye ewabo kʉshangwa bamʉkangɨrɨtsye ko kwenene enzɨra y'erɨkwama Gongo. <verse eid="ACT 18:26" /><verse number="27" style="v" sid="ACT 18:27" />Honyuma kw'aho, Apolo mwashondya ɨya mo kɨhʉgo ky'ɨAkaya. Abɨkɨrɨtsya mobamʉha muhwa mo kɨnwa ekyo. Aho mobashakɨra abagala bethʉ, <char style="w" lemma="Abɨga">bɨga</char> balikyabo b'omo kɨhʉgo ekyo, bathɨ bamukokye kʉbʉya. Abere ahikayo, mwabya mʉndʉ ukwirire ko bandʉ bo bɨkɨrɨtsaya ko lʉkogo lwa Gongo, <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />kʉshangwa agenda agashamya <char style="w" lemma="Bayuta">aBayuta</char> embere s'abandʉ, alɨ akanganiabo ɨtsʉkɨra mo <char style="w">Mashako Abuyirire</char> ko Yesʉ yo <char style="w" lemma="Kirisito, Masia">Kirisito</char>.<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s">Amakangɨrɨtsya wa Polo ɨEfeso</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />Mo mʉgʉlʉ Apolo abere akɨnalɨ mo muyi w'iKorinto, Polo naye agenda athimba mo bɨthwa by'ekɨhʉgo ky'iAsia. Honyuma kw'aho mwandagalɨra mo muyi w'ɨEfeso. Mo muyi oyo mweyamo <char style="w" lemma="Abɨga">bɨga</char> bagʉma, <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />mwabʉtsyabo athɨ: «Mwabere mwɨkɨrɨtsya Yesʉ momwanabona <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char>?» Nabo mobamʉshʉbɨtsya bathɨ: «Ɨhɨ, n'erɨonvwa ko kunabya <char style="w">Mʉthɨma Mwerʉ</char> thʉthahera thwathonvwa na hake.» <verse eid="ACT 19:2" /><verse number="3" style="v" sid="ACT 19:3" />Aho Polo mwashʉba bʉtsyabo athɨ: «Ewono nɨ <char style="w">lubatiso</char> lʉhɨ lo <char style="w" lemma="Lubatiso">mwabatisibawako</char>?» Mobashubya bathɨ: «Ko <char style="w">lubatiso</char> lwa Yoani.» <verse eid="ACT 19:3" /><verse number="4" style="v" sid="ACT 19:4" />Aho Polo mwabwɨrabo athɨ: «Yoani agenda <char style="w" lemma="Lubatiso">abatisya</char> bo bɨmɨraga ɨbɨndʉka ɨthoka mo bɨtsɨbʉ byabo. Kuthyo mwabwɨrabo athɨ bɨkɨrɨtsye yo wandahika enyuma kw'ɨye, naye ni Yesʉ.»<verse eid="ACT 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5" />Babere bamala ɨonvwa ebɨnwa ebyo, <char style="w" lemma="Lubatiso">mobabatisibwa</char> mw'ɨtsɨna lya Nyinya-kowethʉ Yesʉ. <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />Polo mwahira kʉbo kw'eminwe <char style="w" lemma="Mʉthɨma Mwerʉ">n'oMʉthɨma Mwerʉ</char> mwakimira kʉbo. Mobathanga ɨnegena mʉ yɨndɨ mɨnegene, n'ɨmɨnyerera. <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />Aboshi babyaga hofɨ bayira ikumi na babɨrɨ.<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />Polo mwamala myetsɨ ishathu analɨ ɨngɨra mo <char style="w" lemma="Sinakoki:">sinakoki</char>. Agenda abwɨra abandʉ bʉtsɨra bʉba n'ikubisania nabo ko bɨnwa <char style="w" lemma="Bwamɨ bwa Gongo">by'oBwamɨ bwa Gongo</char>, kʉshangwa abyaga niashondya bɨkɨrɨtsyebyo. <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />Hewethuwe bagʉma mʉbo, mobabya na mɨthɨma mɨtsɨbʉ ihika ko kɨka mobathɨnda ɨkɨrɨtsya. Mobathanga ɨnegena kʉbɨ ko Nzɨra ya Nyinya-kowethʉ embere s'abandʉ. Bʉshana n'ekyo, Polo mwamikabo, mwagenda <char style="w" lemma="Abɨga">n'abɨga</char> mʉ kalasɨ ka muyira mʉgʉma nɨ yo Tirano, omo agenda akangɨrɨtsya abandʉ. <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />Polo mwagenda akola athyo mʉ myaka ibiri, ihika ko kɨka <char style="w" lemma="Bayuta">aBayuta</char> <char style="w" lemma="Bakiriki">n'aBakiriki</char> boshi bo babyaga mo kɨhʉgo ky'iAsia mobonvwa eKɨnwa kya Nyinya-kowethʉ.<verse eid="ACT 19:10" /></para>
  <para style="s">Abagala ba Sikewa abahumbwa n'emɨtsɨmʉ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />Gongo agenda akola bɨthɨko-thɨko b'ishwekya mw'ɨtsʉkɨra Polo. <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />Abandʉ mobagenda abaletha ebɨpahasha kʉtse esongɨmba so sɨthakola ko mʉbɨrɨ wa Polo, mobagenda abahirabyo ko bakoni, nabo nɨbalama <char style="w" lemma="mɨtsɨmʉ">n'emɨtsɨmʉ</char> moyagenda ɨthoka kʉbo.<verse eid="ACT 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 19:13" />Kwabyaga <char style="w">Bayuta</char> bagʉma bo bagenda abathimba-thimba nɨabagenda nɨbane muligitha <char style="w" lemma="mɨtsɨmʉ">emɨtsɨmʉ</char>. Nabo mw'iligitha <char style="w" lemma="mɨtsɨmʉ">emɨtsɨmʉ</char> nɨabahʉla erɨtsɨna lya Nyinya-kowethʉ bathɨ: «Kw'ɨtsɨna lya Yesʉ yo Polo akangɨrɨtsya, enyɨbahamʉla mʉthoke ko mʉndʉ oyu!» <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />Mo kathi k'abandʉ bo bagenda abakola bathyo, mwabyaga bagala balɨnda ba Sikewa. Sikewa oyo abyaga <char style="w" lemma="Muheri">muheri mʉkʉlʉ</char> <char style="w" lemma="Bayuta">w'aBayuta</char>. <verse eid="ACT 19:14" /><verse number="15" style="v" sid="ACT 19:15" />Kɨro kɨgʉma, <char style="w" lemma="Batsɨmʉ">omʉtsɨmʉ</char> abyaga nɨamatsɨmba mʉndʉ. <char style="w" lemma="Batsɨmʉ">Omʉtsɨmʉ</char> oyo mwabwɨra abagala ba Sikewa abo athɨ: «Yesʉ, nyimwetsi, na Polo naye nyetsi nga nɨ ndɨ. He imwe mʉlɨ bahɨ?» <verse eid="ACT 19:15" /><verse number="16" style="v" sid="ACT 19:16" />Omʉndʉ yo wabyagako <char style="w" lemma="Batsɨmʉ">omʉtsɨmʉ</char>, aho n'aho mwagʉlʉkɨrabo, mwalengya aboshi bo kagala. Mwathanga ihumbabo na mobahika ko kɨka k'ɨthoka mo nyʉmba y'omukoni oyo. Mobagenda nɨabathɨbɨtha nɨbalɨ ndumbu nibotswireko bɨhʉlʉ.<verse eid="ACT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 19:17" />Abahimbani boshi b'ɨEfeso, <char style="w" lemma="Bayuta">aBayuta</char> <char style="w" lemma="Bakiriki">n'aBakiriki</char> babere bamɨnya omwatsɨ oyo, aboshi mobatsɨmbwa n'obʉba na mobathanga isingya kʉtsɨbʉ erɨtsɨna lya Nyinya-kowethʉ Yesʉ. <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />Aho bangɨ mw'abo bikiritsaya, bagenda abahika n'ɨnegena ebɨbɨ byoshi bakolaga embere s'abandʉ. <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />Bandʉ bangɨ mo bobagenda abakola obukumu, nabo mobaletha ebɨtabo byo bagenda abakolamo obukumu bwabo obo, mobokyabyo embere s'abandʉ boshi. Babere baganza ekɨtsɨro ky'ebɨtabʉ ebyo, mokyahika kʉ faranga bɨhʉmbɨ makumi athano.<note caller="+" style="f"><char style="fr" closed="false">19:19 </char><char style="fq" closed="false">faranga bɨhʉmbɨ makumi athano: </char><char style="ft" closed="false">Esofaranga etho sangaulire nde hofɨ magana abɨrɨ na makumi athano.</char></note> <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />Nɨ bathyo, ko Kɨnwa kya Nyinya-kowethʉ, mokyaya-ngʉlʉ ahoshi mo maka ʉwe, n'ibya na kagala kangɨ.<figure style="fig" alt="Les fils de Sceva brulent leurs livres de la sorcelerie." file="wa03985.jpg" size="col" ref="19:19">Abanyaefeso abokya ebɨtabʉ byabo by'obukumu</figure><verse eid="ACT 19:20" /></para>
  <para style="s">Bʉrʉnga bwamabya mo muyi w'ɨEfeso</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />Honyuma w'ebyo, Polo mwahamʉla atsʉke mo kɨhʉgo ky'iMaketonia na ky'ɨAkaya, na honyuma kw'aho agende ɨYerʉsalemʉ. Mwashʉba negena athɨ: «Honyuma w'erihika ɨYerʉsalemʉ kuthyo lɨtholere ninyahika mo muyi <char style="w" lemma="Roma">w'ɨRoma</char>.» <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />Aho mwatsɨmba bandʉ babɨrɨ mo bo bagenda abamuwathikya ko mʉlɨmo, Timote bana Rasɨto mwathʉmabo bamʉthange embere ɨya iMaketonia. He ɨye mwashiba mo kɨhʉgo ky'iAsia kʉ ndambi nge.<verse eid="ACT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />Aho mo bɨro ebyo, mo muyi w'ɨEfeso mo mwahʉlʉka bʉrʉnga bʉngɨ bʉshana n'eNzɨra ya Nyinya-kowethʉ. <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />Mo muyi oyo mwabyaga muheshi mʉgʉma erɨtsɨna lɨwe nɨ yo Temetirio. Temetirio oyo abyaga na mʉlɨmo w'ɨhesha bɨshoshekano bɨke-bɨke mʉ byʉma bya faranga bishoshire nyʉmba ya gongo mʉkatsɨ yo wahʉlwamo Aritemi. Omʉlɨmo oyo, mwagenda alethera abaheshi balikyabo bo ndundi nyɨngɨ.<note caller="+" style="f"><char style="fr" closed="false">19:24 </char><char style="ft" closed="false">Ko Bakiriki, Aritemi abyaga gongo wa bʉkatsɨ yo wagenda aha abandʉ bw'emigisha y'erɨetsya emɨaka.</char></note> <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />Temetirio mwahindania abaheshi balikyabo hagʉma n'abandɨ bandʉ bo bagenda abakola omʉlɨmo walɨ ng'oyo. Mwabwɨrabo athɨ: «Ewono imwe bayira! Ndɨ munetsi ko nɨ omʉlɨmo ono wathubikire! <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />Aho imwe bene mwamayɨlolera n'ɨyonvwɨra ko Polo oyu uhya n'ɨheka bandʉ bangɨ mo muyi w'ɨEfeso ono, na handʉ hangɨ mo kɨhʉgo ky'iAsia. Agenda anegena athɨ abo gongo bakomibawa n'abandʉ bathalɨ bagongo ba kwenene. <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />Ekyo kyangaleka omʉlɨmo ethʉ nɨasʉnzʉgʉrwa na kandɨ olushikyo loshi <char style="w" lemma="Nyʉmba ya Gongo">lw'enyʉmba ya gongo</char> mʉkatsɨ mʉkʉlʉ Aritemi nɨlwahera, aho olʉkengerwa lʉwe lwakeha, ɨye yo uramibwa mo kɨhʉgo kyoshi ky'iAsia na hano ishi hoshi!»<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />Abaheshi abo babere bonvwa ebyo, mobakapɨkɨra kʉtsɨbʉ n'ɨthanga ɨhambala bathɨ: «Aritemi wa aBanyaefeso asingibwe!» <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />Olʉkanda olo, molwagenda olubya lʉngɨ kʉtsɨbʉ mo muyi woshi. Abandʉ mobatsɨmba bahimbani babɨrɨ b'omo kɨhʉgo ky'iMaketonia, Kayo bana Sɨtarɨko, bo bagenda abaherekeretsya Polo yo mo mʉlɨmo. Aho n'aho, mobathwalabo mʉ nyʉmba nene mo bandʉ bagenda abahindanira. <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />Polo abyaga niashondya iyikangania ko muhindano, hewethuwe <char style="w">abɨga</char> mobamʉhangɨra. <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />Bakʉlʉ bagʉma b'omo kɨhʉgo ky'iAsia, bo babyaga bira bʉwe, mobamʉthʉmɨra mugendi nɨabamʉhangɨra bathɨ athanalinda ɨngɨra mo nyʉmba eyo.<verse eid="ACT 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 19:32" />Mo muhindano oyo mwabyaga lʉkanda lʉngɨ, kʉshangwa bandʉ bagʉma bagenda abahambala bagʉma bathya n'abandɨ bathya. Na bangɨ mʉbo, babyaga nibathetsi nga bahindene bʉshana na ki. <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />Bandʉ bagʉma mo <char style="w">Bayuta</char> mobabwɨra muyira mʉgʉma nɨ yo Likisa bathɨ atsʉke embere y'abandʉ bʉshana n'ɨbwɨrabo ebɨrɨ. Aho naye mwashʉmba okʉboko bʉshana abandʉ batsɨre, kʉshangwa abyaga niashondya ayɨthondere embere sabo. <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />Hewethuwe abandʉ babere bamɨnya ko nɨ <char style="w" lemma="Bayuta">Muyuta</char>, aboshi mobashʉba hambalɨra kʉgʉma bathɨ: «Aritemi wa aBanyaefeso asingibwe!» Mobamala hofɨ saha ibiri nɨbanemʉnegena bathyo!<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />Ko nduli, omushaki w'omuyi mwabombetsya abandʉ abo athɨ: «Ewo imwe bandʉ b'ɨEfeso kʉkɨnalɨ mʉndʉ yo uthetsi ko ni omuyi ethʉ ono w'anatheya enyʉmba ya gongo mʉkʉlʉ Aritemi hagʉma n'eshoshani yɨwe yo yathogaga ɨthoka mo lʉbʉla? <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />Hathalɨ mʉndʉ yo wangakotsya ɨyɨgana athɨ athetsi omwatsɨ oyo. Bʉshana n'ekyo, mʉtsɨre mʉthathɨbɨthɨraga ɨkola kɨndʉ kyoshi bʉtsɨra ɨganɨtsya. <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />Nyamanegena nyithyo kʉshangwa mwamaletha abayira aba bo hano bathibire kɨndʉ mo nyʉmba ya gongo, kʉtse bathahangitsye gongo wethʉ mʉkatsɨ Aritemi. <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />Aho Temetirio n'abaheshi balikyabo bamabya na lʉbanza na mʉndʉ mʉlebe betsi ko othunabya na tɨrɨbɨnalɨ na thuwithe kuthyo basohi. Aho nɨ eyo yo batholere ɨgenda abathwala esomanza sabo! <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />Na kandɨ mwamabya mʉkɨnalɨ na kɨndɨ kɨnwa, kyasɨmolerwa mo muhindano wetsibwe n'omʉgomba ethʉ. <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />Ebɨnwa byo byamakoleka munobwire, byangaleka nithwasitakwa ko nithwe thwothwamaletha bʉrʉnga. Kuthyo hathalɨ kɨnwa kyoshi-kyoshi kyo thwangakangania ko kyo kyamaleka omuhindano oyu niabya.» <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />Abere amamala ɨnegena athyo, aho mwabwɨra omuhindano athɨ bashʉbe mo manyʉmba wabo.<note caller="+" style="f"><char style="fr" closed="false">19:41 </char><char style="ft" closed="false">Mashako magʉma athulungenie omʉlondo wa makumi ane n'omʉgʉma ono mo mʉlondo wa makumi ane.</char></note><verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s">Lʉgendo lwa Polo mo kɨhʉgo ky'iMaketonia na ky'iBukiriki</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />Obʉrʉnga bwabere bwahwa mo muyi w'ɨEfeso, Polo mwahindania <char style="w">abɨga</char> n'ishikyabo mʉthɨma. Honyuma kw'aho mwalagabo, na mwagenda mo kɨhʉgo ky'iMaketonia. <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />Mwatsʉka mo kɨhʉgo ekyo nɨanemʉbwɨra <char style="w" lemma="Abɨga">abɨga</char> bo bɨnwa bɨngɨ b'ishikyabo mʉthɨma. Honyuma kw'aho mwaya mo kɨhʉgo <char style="w" lemma="Bakiriki">ky'iBukiriki</char>, <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />eyo mwamalayo myetsɨ ishathu. Abere ashondya ɨshabʉkɨra mo kɨhʉgo ky'iSuria mʉ bwatho, mwamɨnya ko <char style="w" lemma="Bayuta">aBayuta</char> abamʉyɨra nama. Aho, mwahamʉla ɨshʉbʉla atsʉkɨre mo kɨhʉgo ky'iMaketonia. <verse eid="ACT 20:3" /><verse number="4" style="v" sid="ACT 20:4" />Bano bo bandʉ bo bamʉherekeretsaya: Sopateri mʉgala wa Piro w'omo muyi w'ɨBeroya, na Sɨtarɨko na Sekundo w'omo muyi w'iTesalonika, na Kayo w'omo muyi w'ɨTerebe, na Timote na Tikiko na Torofimo b'omo kɨhʉgo ky'iAsia. <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />Abandʉ abo, mobathʉthanga embere mo muyi w'ɨTʉroa bʉshana bathʉlɨndɨrɨreyo. <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />Ekɨro <char style="w" lemma="Mikati ɨthemo tsatsʉ">ky'emikati ɨthemo tsatsʉ</char> kyabere kyatsʉka, ithwe mothwatsɨmba bwatho, na mothwathoka mo muyi w'iFilipi. Thwabere thwamamala bɨro bɨthano mo lʉgendo olo, mothweya balikyethu mo muyi w'ɨTʉroa. Mo muyi oyo, mothwamalamo yenga ngʉma.<verse eid="ACT 20:6" /></para>
  <para style="s">Polo alubukya Eutiko</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />Ekɨro ky'eyenga kyabere kyahika, mothwahindana mw'ɨshangɨra omukati. Aho kʉshangwa Polo abyaga niangalamukire mungya, mwathanga ɨkangɨrɨtsya abandʉ <char style="w" lemma="Kɨnwa kya Gongo">eKɨnwa kya Gongo</char> ihika mo kathi ka kɨro. <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />Mo kɨshenge ky'engorofa thwabyaga thuhindaniremo, mwabyaga nɨ munokire bɨmole bɨngɨ.<verse eid="ACT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 20:9" />Ko lirisa ly'ekɨshenge ekyo, kwabyaga nikwikere mʉsole mʉgʉma erɨtsɨna lɨwe nɨ yo Eutiko. Polo abere anemʉkagɨrɨtsya abandʉ bo ndambi nyɨre, Eutiko oyo mwathanga ithinga. Abere amayatho kʉtsɨbʉ mwathogera ahishi, nɨathoka ko ngorofa ya kashathʉ y'enyʉmba eyo. Abandʉ mobathɨbɨtha ɨya mwimania, he mobamweya nɨamamala ɨfwa. <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />Polo mwakima, mwunama n'ɨmʉtsɨmba mo minwe yɨwe. Honyuma kw'aho mwabwɨra abandʉ athɨ: «Mʉthaganga-gangaya emɨthɨma, akɨnalɨho!» <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />Honyuma w'ebyo, Polo mwashʉba ɨrʉkɨra mo kɨshenge ekyo, mwashʉbatsa omukati n'iryawo. Kandɨ mwashʉba kangɨrɨtsyabo ndambi nyɨre ihika mo mambya. Ko nduli mwagenda. <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />Abɨkɨrɨtsya mobaherekeretsya omʉsole oyo nɨahera mʉkangwe. Emɨthɨma yabo moyashika.<verse eid="ACT 20:12" /></para>
  <para style="s">Polo aya mo muyi w'iMileto</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />Ithwe mothwatsʉka embere mʉ bwatho n'ɨya mo muyi w'iAsosi. Mo muyi oyo mothwangathwere Polo nga ko ahamʉlaga, kʉshangwa ɨye abyaga niashondya ɨgenda mo bɨshando. <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />Abere athweya iAsosi, mwɨngɨra mo bwatho, na mothwashabʉkɨra naye mo muyi w'iMitilena. <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />Bwabere bwakya mothwathoka iMitilena mo bwatho, na mothwashabʉkɨra hofɨ n'ekɨtsɨra ky'iKio. Kyabere kyabya ekɨro kya kashathʉ, mothwashabʉkɨra ko kɨtsɨra ky'iSamosi. Honyuma kw'aho mo kɨro kya kane, mothwashabʉkɨra mo muyi w'iMileto. <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />Polo abyaga nɨamahamʉla athɨ bathimanaga ɨEfeso, kʉshangwa athatsukaya endambi mo kɨhʉgo ky'iAsia. Abyaga nɨayɨhʉtha ahike ɨYerʉsalemʉ embere y'ekɨro ky'ePentekosite, byamathokekana.<verse eid="ACT 20:16" /></para>
  <para style="s">Polo alaga abangʉmwa b'ekanisa k'ɨEfeso</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />Polo abere akɨnalɨ iMileto, mwabɨrɨkɨra abangʉmwa <char style="w" lemma="Kanisa">b'ekanisa</char> k'ɨEfeso. <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />Babere bahika aho abyaga, mwabwɨrabo athɨ: «Imwe bene mwetsi nga ko mɨbere aye yabyaga ko ndambi soshi nyabyaga hagʉma nemwe, ɨthanga ekɨro kɨmbere nyahikiragamo mo kɨhʉgo kɨno ky'iAsia. <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />Monyakolera Nyinya-kowethʉ mo bʉlonvʉ boshi, na mo mishonia n'omwɨrengwako nyabonaga bʉshana n'esonama <char style="w" lemma="Bayuta">aBayuta</char> bagenda abanyɨkolera. <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />Na kandɨ mwetsi, kʉlɨ kwabyaga kɨnwa kyo kyabyaga na ndundi kw'imwe, monyithanalinda nyababishakyo. Hewethuwe nyagendaga enyɨbafʉlɨra eNgʉlʉ Mbʉya n'ɨbakangɨrɨtsya ebyoshi embere s'abandʉ na mo manyʉmba enyu. <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />Nyabyaga nɨenyɨbwɨra <char style="w" lemma="Bayuta">aBayuta</char> <char style="w" lemma="Bakiriki">n'aBakiriki</char> nyɨthɨ batholere nɨbabɨndʉkɨra Gongo n'ɨthoka mo bɨtsɨbʉ byabo na bɨkɨrɨtsye Nyinya-kowethʉ Yesʉ.<verse eid="ACT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 20:22" />«Ewo ingye ono, oMʉthɨma Mwerʉ anyɨhathɨka athɨ nyɨtholere ɨya ɨYerʉsalemʉ. N'eyo Nyithetsi ebyo byanyihikira.» <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />Hewethuwe ekyo nyetsi, ko mo bʉlɨ muyi nyatsʉkagamo <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> mwanyikangya ko erɨmɨnwa n'erɨagalwa byo binyirindire. <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />Hewethuwe nyithaganzire obʉyɨngo bwaye nga kɨndʉ kya ndundi nene kw'ingye. Ekyo enyishondya n'ihikya omʉlɨmo aye ko nduli n'ɨmala omʉlɨmo Nyinya-kowethʉ Yesʉ anyɨhaga. N'omʉlɨmo oyo nɨ erɨfʉla <char style="w" lemma="Ngʉlʉ Mbʉya">eNgʉlʉ Mbʉya</char> y'olʉkogo lwa Gongo.<verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />«Nyagendaga enyithimba mo kathi kenyu ɨyafʉlɨra abandʉ bw'eNgʉlʉ Mbʉya y'oBwamɨ bwa Gongo. Hewethuwe lɨno mwonvwe, ɨthanga lɨno ingye nyetsi ko hathalɨ mʉgʉma wa mw'imwe yo wandashʉba nyɨshʉngako. <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />Bʉshana n'ekyo, enyɨbabwɨra munobwire nyɨthɨ mwamahera omʉsasɨ enyu alɨ ko mithwe enyu. <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />Enyɨnegena nyithyo kʉshangwa ebɨnwa byoshi by'erishondya lya Gongo, monyababwirebyo buthababisha kɨndʉ. <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />Aho lɨno mʉgende omuyitheya kʉbʉya, na mutheye ekihyo kyoshi ky'abɨkɨrɨtsya ekyo <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> abayɨragamo balishya. Mutheye <char style="w" lemma="Kanisa">akanisa</char> ko Gongo ashabʉlaga mw'ɨtsʉkɨra mo mʉsasɨ wa mʉgala. <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />Nyetsi ko enyuma w'erɨgenda lyaye, nyambwe nzɨbʉ sandɨngɨra mo kathi kenyu, na sɨthɨndashashɨre ekihyo ekyo. <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />Na mo kathi kenyu namo mwandahʉlʉka bandʉ bandagenda abanegena bɨnwa bya mabesɨ, bʉshana bayɨkʉrɨreko <char style="w">abɨga</char> na bakwamebo. <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />Bʉshana n'ekyo, muyitheye kʉbʉya na mw'ɨbʉke ko mʉ mɨaka ishathu, kɨro na mwɨshɨ, monyɨthalemerwa ɨhana bʉlɨ mʉgʉma mw'imwe mo mishonia.<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />«Na lɨno, enyibahira mo minwe ya Gongo, na mo kɨnwa kɨwe ky'olʉkogo kɨgende ekibatheya. Kʉshangwa nɨ ekɨnwa ekyo kyo kiwithe amaka w'ibawathikya bʉshana n'ɨkʉla mo lwɨkɨrɨtsyo, n'ɨbaha omwandʉ wo abikire abandʉ bʉwe boshi <char style="w" lemma="Mubuyirire">babuyirire</char>. <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />Monyithayitsutsa faranga, kʉtse horo, kʉtse ngɨmba sa mʉndʉ. <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />Kuthyo imwe bene mwetsi ko ni mo minwe aye eno monyagendaga enyɨkola bʉshana n'emɨlago aye n'eya balikyethu bo babyaga hagʉma nangye. <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />Mo byoshi ebyo, nyagendaga enyibakangya ko lɨtholere nɨthwagenda othʉkola kʉtsɨbʉ bʉshana thʉbone ekyangawathikya abathayikotsitsye. Mʉgende omwɨbʉka ko Nyinya-kowethʉ Yesʉ mwanegena athɨ: “Yo ʉhana yo ʉnagashanɨrwa kʉlenga yo ʉhabwa.”»<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />Polo abere amamala ɨnegena ebɨnwa ebyo, mwafʉkama hagʉma n'aboshi na mwashaba Gongo. <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />Abandʉ boshi mobathanga ɨyɨgʉsha mo minwe yɨwe, n'ɨmʉfʉmbatha nɨabalɨra kʉtsɨbʉ. <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />Babyaga n'obuliye kʉshangwa Polo mwabwɨrabo athɨ bathɨndashʉbe mʉloleko. Honyuma kw'aho mobamʉherekeretsya ihika ahalɨ obwatho.<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s1">Polo ɨrʉkɨra ɨYerʉsalemʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />Honyuma w'erimikana n'abangʉmwa b'ekanisa k'ɨEfeso mothwɨngɨra mo bwatho aho n'aho mothwashabʉkɨra ko kɨtsɨra ky'iKosi. Bwabere bwakya mothwashabʉkɨra ko kɨtsɨra ky'ɨRoto. Mw'ɨthoka ko kɨtsɨra ky'ɨRoto ekyo mothwahika ko muyi w'ɨPatara. <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />Mo muyi oyo, mothweyamo bwatho bʉgʉma bo bwagenda obʉya mo kɨhʉgo ky'iFoiniki. Mothwashambɨra mo bwatho obo na mothwagenda. <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />Thwabere thwahera othʉshʉnga ekɨtsɨra ky'eKipuro ky'eyishirya, mothwashigakyo ko lʉnda lw'amalembe na mothwalotsya mo kɨhʉgo ky'iSuria. Mothwimana ko kyambʉ ky'iTiro bʉshana nɨ mo muyi oyo m'obwatho bwangikitsye emɨtsɨgo bwabyaga buhekire.<verse eid="ACT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 21:4" />Mothwahindana <char style="w" lemma="Abɨga">n'abɨga</char> b'omo muyi oyo, mothwamala yenga ngʉma hagʉma nabo. <char style="w">Abɨga</char> abo kʉshangwa bagenda abashondolwa <char style="w" lemma="Mʉthɨma Mwerʉ">n'oMʉthɨma Mwerʉ</char>, mobabwɨra Polo bathɨ athɨrʉkɨraga ɨYerʉsalemʉ. <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />Hewethuwe honyuma w'erɨmala eyenga ngʉma eyo mothwathoka ko muyi w'iTiro oyo na mothwalotsya ebʉshondotsɨ mo lʉgendo lwethʉ. <char style="w">Abɨga</char> boshi abo hagʉma n'abakatsɨ n'abana mobathʉherekeretsya ɨthoka ko muyi ihika ko kyambʉ. Thwabere thwahika ko kyambʉ ekyo, mothwafʉkama n'ɨshaba Gongo. <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />Honyuma w'erɨlagana, mothwashambɨra mo bwatho. Hewethuwe <char style="w">abɨga</char> abo ɨbo, mobashʉba ewabo.<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />Erɨthoka iTiro, mothwalotsya ebʉshondotsɨ mo lʉgendo lwethʉ lw'oko ngetsɨ mothwahika mo muyi w'iTolemai. Thwabere thwahika mo muyi oyo mothwaketsya bagala bethʉ bɨkɨrɨtsya, mothwamala kɨro kɨgʉma hagʉma nabo. <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />Bwabere bwakya, mothwashʉbagenda, na mothwahika mo muyi w'iKaisaria. Oko mothwɨngɨra mo nyʉmba ya Filipo mufuli w'eNgʉlʉ Mbʉya na mothwikala omwe. Filipo oyo abyaga mʉgʉma w'oko bandʉ balɨnda abo bashombolawa bawathikye abathʉmwa.<note caller="+" style="f"><char style="fr" closed="false">21:8 </char><char style="xt" closed="false">Soma <ref loc="ACT 6:1-6">Mɨkolano 6:1-6</ref>.</char></note> <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />Abyaga niawithe banyere bane bo bagenda abamɨnyerera.<verse eid="ACT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 21:10" />Thwabere thwamamala ko muyi w'iKaisaria oyo ko bɨro bɨngɨ, momwahika <char style="w" lemma="mʉmɨnyeretsɨ">mʉmɨnyeretsɨ</char> mʉgʉma erɨtsɨna lɨwe nɨ yo Akabo. Akabo oyo mwahʉlʉka mo kɨhʉgo ky'iYuteya. <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />Abere ahika ho thwabyaga, mwatsɨmba omʉkaba wa Polo, mwayɨmɨna mʉwo mw'ebɨshando n'eminwe. Mwanegena athɨ: «Mwonvwe, <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> anegena, athɨ: “Omwenye omʉkaba oyu, ni bathya ko bamʉmɨna <char style="w" lemma="Bayuta">aBayuta</char> b'omo muyi w'ɨYerʉsalemʉ n'imuhira mo minwe y'abandʉ b'ebɨhanda.”»<verse eid="ACT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12" />Thwabere thwonvwa ebyo, ithwe hagʉma n'abandɨ bɨkɨrɨtsya b'omo muyi w'iKaisaria, mothwashaba Polo yo kʉtsɨbʉ thʉthɨ athɨrʉkɨraga ɨYerʉsalemʉ. <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />Hewethuwe Polo ɨye mwathʉshʉbɨthya athɨ: «Bʉshana na ki omʉlɨra n'inyitha mʉthɨma? Ingye nyamayɨsɨnga ɨyamɨnɨrwa ɨYerʉsalemʉ bʉshana n'erɨtsɨna lya Nyinya-kowethʉ Yesʉ. Na lwamabya lʉholo nyimire olʉholo bʉshana na Yesʉ.» <verse eid="ACT 21:13" /><verse number="14" style="v" sid="ACT 21:14" />Thwabere thwashʉnga ko thwamalemwa imuhya, mothwatsɨra, aho mothwanegena thʉthɨ: «Erishondya lya Nyinya-kowethʉ lyo lɨkoleke.»<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />Honyuma w'ebɨro ebyo, mothwayithegekania na mothwɨrʉkɨra ɨYerʉsalemʉ. <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" /><char style="w" lemma="Abɨga">Bɨga</char> bagʉma b'omo muyi w'iKaisaria mobathʉherekeretsya n'ithuhikya ho thwikalaga, ho wa muyira mʉgʉma nɨ yo Munasoni. Munasoni oyo abyaga w'omo kɨtsɨra ky'iKipuro, na kuthyo abyaga mʉgʉma w'oko <char style="w" lemma="Abɨga">bɨga</char> bambere.<verse eid="ACT 21:16" /></para>
  <para style="s">Polo ayashʉnga Yakobo</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />Thwabere thwahika ɨYerʉsalemʉ, bagala bethʉ bɨkɨrɨtsya mobathukokya na lʉmogo. <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />Bwabere bwakya, Polo hagʉma nethwe mothwaya omwa Yakobo. Abangʉmwa boshi b'ekanisa nabo babyagamo. <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />Polo mwaketsyabo na mwaganʉlɨrabo kɨnwa kʉ kɨnwa, ebyoshi Gongo agenda akola mo kathi k'abandʉ b'ebɨhanda, ɨtsʉkɨra mo mʉlɨmo ʉwe.<verse eid="ACT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 21:20" />Abangʉmwa abo babere bonvwa ebyo, mobasingya Gongo. Nɨmo babwɨra Polo bathɨ: «Mbe mʉgala ethʉ! Lola <char style="w" lemma="Bayuta">aBayuta</char> bo bamɨkɨrɨtsya nga ko bangana, na kandɨ aboshi bashikitsye <char style="w" lemma="Mʉgomba">oMʉgomba</char> wa Mʉsa wo kʉtsɨbʉ. <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />Aho bamamala ɨonvwa engʉlʉ kw'ɨwe ouhya <char style="w" lemma="Bayuta">aBayuta</char> boshi bo bikere mo bandʉ b'ebɨhanda ko bathagenda abashikya oMʉgomba wa Mʉsa. Kuthyo bathɨ ambʉ, ʉbwɨrabo bathashʉba genda <char style="w" lemma="Ɨmona">abamonia</char> abana babo, n'ɨhangɨrabo ʉthɨ bathashʉba kwama emɨbere <char style="w" lemma="Bayuta">y'aBayuta</char>. <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />Aho thʉyɨre thʉthɨ? aBayuta abo bonvwa ko wamalire ihika kʉno. <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />Bʉshana n'ekyo, ekyo othushondya ɨkʉbwɨra kɨno kyo ʉkole, thʉlɨ na bayira bane hano bamalahɨtsya embere sa Gongo, <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />ʉgende nabo mo kɨsomo ky'erɨyetsya. N'ebyoshi bashabwa nɨ ɨwe wo walɨhɨrabyobo nɨmo bagembwa. Ekɨnwa ekyo kyakangania abandʉ boshi ko ebɨnwa bathakonvwako nɨ mabesɨ masha. Na kuthyo bamɨnya kwenene ko ukinashikitsye <char style="w" lemma="Mʉgomba">oMʉgomba</char> wa Mʉsa. <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" />Ko byo birebitsye abandʉ b'ebɨhanda bo bɨkɨrɨtsye, thwamamala ɨshakɨrabo bʉshana n'ebyo thwasohaga thʉthɨ, bathagenda abashubalya nyama sɨthahererwa mɨtsɨmʉ, kʉtse irya mʉlegano, kʉtse irya nyama sɨthayɨfwɨra na bayitheye ko rʉsɨngɨ.<note caller="+" style="f"><char style="fr" closed="false">21:25 </char><char style="xt" closed="false">Soma <ref loc="ACT 15:19-20">Mɨkolano 15:19-20</ref>.</char></note>»<verse eid="ACT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />Aho bwabere bwakya Polo mwagenda n'abayira bane abo, na mwayetsya hagʉma nabo. Honyuma kw'aho mwaya mo <char style="w">Nyʉmba ya Gongo</char> bʉshana abwɨre abandʉ omʉgʉlʉ w'erɨyetsya lyabo nga lyandahwa kɨro ki, <char style="w" lemma="Bɨhembo">n'ebɨhembo</char> byo byandahanwa bʉshana n'obʉlɨ mʉgʉma wa kʉbo.<verse eid="ACT 21:26" /></para>
  <para style="s">aBayuta abatsɨmba Polo</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />Ebɨro bɨrɨnda by'erɨyetsya byabere byashondya ɨhwa, <char style="w" lemma="Bayuta">aBayuta</char> bagʉma bobathokaga mo kɨhʉgo ky'iAsia, mobashʉnga Polo mo <char style="w">Nyʉmba ya Gongo</char>. Mobakaramya omuhindano woshi na mobamʉtsɨmba. <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />Mobahambala bathɨ: «Imwe bayira boshi <char style="w" lemma="Isiraeli">b'iIsiraeli</char>, muhike mʉthwangɨrɨre! Omuyira oyo yono, oyo ʉtsʉka ahoshi-hoshi alɨ akangɨrɨtsya abandʉ boshi athɨ bagende abathʉsʉnzʉgʉra, n'ɨbwɨrabo athɨ bathashikaya <char style="w" lemma="Mʉgomba">oMʉgomba</char> wa Mʉsa <char style="w" lemma="Nyʉmba ya Gongo">n'ɨsʉnzʉgʉra eNyʉmba ya Gongo</char> <char style="w" lemma="Mubuyirire">nyibuyirire</char> eno. Na lɨno amabihyaro mw'ɨngɨtsya mʉro <char style="w" lemma="Bakiriki">mw'aBakiriki</char>!» <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" />Banegenaga bathyo, kʉshangwa mobashʉnga Polo mo muyi nɨalɨ na muhimbani mʉgʉma w'ɨEfeso yo wahʉlawamo Torofimo. Mobaganɨtsya bathɨ mwakamwɨngɨtsya mo <char style="w">Nyʉmba ya Gongo</char>.<verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />Olʉkanda molwotsula mo muyi woshi w'ɨYerʉsalemʉ. Abandʉ mobathɨbɨthɨra aho Polo abyaga nɨabathoka mo mbande soshi, mobamʉtsɨmba n'ɨmʉkʉrɨra embʉga <char style="w" lemma="Nyʉmba ya Gongo">y'eNyʉmba ya Gongo</char>. N'ɨkɨnga esonyuyi saro aho n'aho. <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />Babere bashondya itha Polo, omʉkʉlʉ kʉtsɨbʉ w'abashirikani b'aBaroma mwonvwa omwatsɨ k'omuyi woshi w'ɨYerʉsalemʉ alɨmo lʉkanda. <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />Aho n'aho, mwatsɨmba abashirikani bagʉma n'abakʉlʉ babo, n'ɨthɨbɨthɨra nabo aho abandʉ abo babyaga nibamahindanira. Abandʉ abo babere bashʉnga ko mʉkʉlʉ kʉtsɨbʉ wa abashirikani n'abashirikani bʉwe, aho mobalika ihumba Polo.<verse eid="ACT 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 21:33" />Aho omʉkʉlʉ kʉtsɨbʉ oyo, mwayɨfʉnda hofɨ na Polo. Mwatsɨmba Polo n'ɨhamʉla bamʉmɨne mʉ mahʉlʉla abɨrɨ. Honyuma kw'aho mwabʉtsya abandʉ athɨ: «Omʉndʉ oyu nɨ ndɨ? Na amakola ki?» <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />Hewethuwe babere balɨ abamʉshʉbɨtsya, abandʉ abo bagenda abahambala bagʉma bathya n'abandɨ bathya. Bʉshana n'ekyo omʉkʉlʉ kʉtsɨbʉ w'abashirikani oyo mwathamɨnya kwenene ebyo bithabya. Aho mwahamʉla athɨ bathwale Polo mo rʉba lw'abashirikani. <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />Polo abere ahika ko kɨrʉkɨro, abashirikani mobashʉnga ko bɨtholere bamʉshʉmbe bʉshana n'erɨkarama ly'omuhindano. <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />Abandʉ boshi babyaga nibakwamire Polo bagenda abagenda nɨabahambala bathɨ: «Itwe!»<verse eid="ACT 21:36" /></para>
  <para style="s">Polo ayɨthondera</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />Mo kathambi abashirikani babere bashondya ɨngɨtsya Polo mo rʉba lwabo, mwabwɨra omʉkʉlʉ kʉtsɨbʉ athɨ: «Mbe mʉkengwa wanganatsɨɨra nyɨkʉbwɨre kɨnwa?» Omʉkʉlʉ mwamʉbʉtsya athɨ: «Wetsi <char style="w" lemma="Bakiriki">ekikiriki</char>? <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />Ʉthalɨ ɨwe oMumisiri yo walethaga olʉkanda mo muyi ono mo bɨro byamatsʉka, n'ɨthwala ababandi bɨhʉmbɨ bɨne mo <char style="w" lemma="mbwarara">mbwarara</char>?» <verse eid="ACT 21:38" /><verse number="39" style="v" sid="ACT 21:39" />Polo naye mwashubya athɨ: «Ingye nyɨrɨ <char style="w" lemma="Bayuta">Muyuta</char>, mbʉthɨrwa w'omo muyi w'ɨTarɨso. Omuyi oyo ayire ngʉlʉ mo kɨhʉgo ky'iKilikia. Aho mbe mʉkengwa, enyɨkʉshaba ʉnyɨtsɨyɨre nyɨnegene n'abandʉ aba.» <verse eid="ACT 21:39" /><verse number="40" style="v" sid="ACT 21:40" />Omʉkʉlʉ kʉtsɨbʉ w'abashirikani oyo mwamʉtsɨyɨra athɨ anegene. Polo mwimana ko kɨrʉkɨro, mwakohetsya abandʉ mo minwe na mobatsɨra. Abandʉ boshi babere bamatsɨra nɨmo Polo anegena nabo mo mʉnegene wabo <char style="w" lemma="Baebʉranɨa">w'ekɨebʉranɨa</char> athɨ:<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />«Imwe bo thatha na bagala bethʉ, mʉhʉlɨkɨrɨtsye kʉbʉya ebyo enyishondya ɨyɨthondera bɨno embere senyu!» <verse eid="ACT 22:1" /><verse number="2" style="v" sid="ACT 22:2" />Babere bonvwa ko Polo anegena nabo mo mʉnegene wabo <char style="w" lemma="Baebʉranɨa">w'ekɨebʉranɨa</char>, mobahʉmana. Nɨmo Polo anegena athɨ: <verse eid="ACT 22:2" /><verse number="3" style="v" sid="ACT 22:3" />«Ingye nyɨrɨ <char style="w" lemma="Bayuta">Muyuta</char>, mbʉthɨrwa w'omo muyi w'ɨTarɨso mo kɨhʉgo k'iKilikia. Hewethuwe nɨ mo muyi w'ɨYerʉsalemʉ ono wo nyakʉlɨragamo, na nyabyaga mwɨga wa Ngamalieri. Na nɨ Ngamalieri oyo yo wanyɨkangɨrɨtsaya kʉbʉya-kʉbʉya <char style="w" lemma="Mʉgomba">oMʉgomba</char> wa bo thatha-kʉlʉ nga ko anegenire. Na kuthyo nyabyaga na muhwa mʉngɨ ko bɨnwa bya Gongo nga ko imwe boshi mufwirewo munobwire. <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" />Na kandɨ nyagenda enyinubya kʉtsɨbʉ abandʉ bo bagenda abakwama eNzɨra ya Nyinya-kowethʉ ihika ko kɨka k'ɨthɨsabo. Na nyagenda enyɨmɨna abayira n'abakatsɨ n'ɨgʉshabo mo biriso. <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" /><char style="w" lemma="Muheri">Omuheri mʉkʉlʉ</char> hagʉma n'ekɨkembe kyoshi ky'abangʉmwa <char style="w" lemma="Bʉshenge Bʉkʉlʉ">b'oBʉshenge Bʉkʉlʉ</char> nabo bangana babwɨra ko ebyo nyɨnegena ebi nɨ bya kwenene. N'ɨbo bo bagenda abanyɨha amarʉba w'ɨthwalɨra bagala bethʉ Bayuta b'omo muyi w'iTamasiki. Nyagenda enyɨya eyo kʉshangwa nyɨmɨne abɨkɨrɨtsya n'ɨrethabo ɨYerʉsalemʉ eno kʉshangwa bahabwe malipisi.»<verse eid="ACT 22:5" /></para>
  <para style="s">Polo aganʉlɨra nga ko abɨndʉkɨraga Nyinya-kowethʉ</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />Polo mwashʉba negena athɨ: «Kɨro kɨgʉma nyabyaga mo nzɨra hofɨ n'omuyi w'iTamasiki. Aho n'aho, hofɨ kathi ka mwɨshɨ, kyakakala kɨnene kyo kyathokaga mo lʉbʉla mokyakoletsya aho nyabyaga. <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />Monyawa ahishi na monyonvwa mʉlenge nɨanyɨbwɨra athɨ: “Sauli, Sauli, bʉshana na ki unyinubya?” <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />Monyashubya nyɨthɨ: “Ʉlɨ ndɨ no Nyinya-kowethʉ?” Omʉlenge mwashubya athɨ: “Ni ingye Yesʉ w'iNasareti ngyo unubya.” <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />Balikyethu bo thwabyaga nabo, mobashʉnga ekyakakala ekyo, hewethuwe mobathonvwa omʉlenge w'oyo wagenda anegena na ngye. <verse eid="ACT 22:9" /><verse number="10" style="v" sid="ACT 22:10" />Aho monyashʉba bʉtsya nyɨthɨ: “Nyinya-kowethʉ, aho nyɨyɨre nyɨthɨ?” Na Nyinya-kowethʉ athɨ: “Wimana, ʉgende mo muyi w'iTamasiki, oko bakʉbwɨra ebyoshi wahamʉlwa ɨkola.” <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />Ko ndambi eyo nyabyaga ninyithakilolire kʉshangwa obʉkalwe bw'ekyakakala ekyo bwabyaga nɨbwamamala ɨnyɨtsɨba amesho. Aho abalikyethu mobanyɨtsɨmbɨra ko kʉboko, n'ɨnyɨshondola ihika mo muyi w'iTamasiki.<verse eid="ACT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12" />«Mo muyi oyo, mwabyaga muyira mʉgʉma nɨ yo Ananɨa. Ananɨa oyo abyaga niashikitsye Gongo n'ishikya <char style="w" lemma="Mʉgomba">oMʉgomba</char> ethʉ. Kuthyo abyaga niawithe mɨbere mɨbʉya mo <char style="w">Bayuta</char> boshi b'omo muyi oyo. <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />Ananɨa mwahika, mwimana hofɨ nangye n'ɨnyɨbwɨra athɨ: “Mʉgala ethʉ Sauli, shʉba lola.” Aho n'aho monyashʉba lola na monyamʉshʉnga. <verse eid="ACT 22:13" /><verse number="14" style="v" sid="ACT 22:14" />Mwashʉba nyɨbwɨra athɨ: “Gongo wa bo thatha-kʉlʉ amakʉshombola bʉshana ʉmɨnye erishondya lɨwe, na ʉyɨlolere ko Mʉthʉnganene, na ʉyonvwɨre omʉlenge ʉwe. <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />Kʉshangwa ebyo wamayɨshʉngɨra n'ɨyonvwɨra, wandabya mutimo wabyo embere s'abandʉ boshi. <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />Ewono ukinalindire ki? Wimana no, <char style="w" lemma="Lubatiso">ubatisibwe</char> na ʉganyɨrwe ebɨtsɨbʉ byawe, mw'ɨbɨrɨkɨra erɨtsɨna lya Nyinya-kowethʉ.”»<verse eid="ACT 22:16" /></para>
  <para style="s">Polo aganʉlɨra nga ko amathʉmwa ko bɨndɨ bɨhanda</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />Aho Polo mwashʉba negena kandɨ athɨ: «Honyuma w'ebyo, monyashʉba ɨYerʉsalemʉ. Nyabere nyɨrɨ enyɨshaba mo <char style="w" lemma="Nyʉmba ya Gongo">Nyʉmba ya Gongo</char>, monyashʉnga humanani. <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />Mo humanani eyo, monyashʉnga Nyinya-kowethʉ nɨanyɨbwɨra athɨ: “Ʉthoke mo muyi w'ɨYerʉsalemʉ ono mo tsʉba, kʉshangwa ebɨnwa byo wagenda ʉnegena bʉshana nangye, abandʉ bamo bathɨkɨrɨtsyebyo.” <verse eid="ACT 22:18" /><verse number="19" style="v" sid="ACT 22:19" />Nangye monyashubya nyɨthɨ: “Nyinya-kowethʉ, abandʉ aba betsi kʉbʉya ko n'ingye nyagenda enyɨtsʉka-tsʉka mo <char style="w" lemma="Sinakoki:">sosinakoki</char> n'ɨgenda enyɨgʉsha abɨkɨrɨtsya mo biriso n'ihumbabo. <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />Na mo ndambi bithaga Sɨtɨfano, yo wabyaga mutimo awe, nangye ngyo wene nyabyaga aho. Monyɨmɨrana na bo bamwithaga. Na bo bamwithaga abo, n'ingye ngyo nyagendaga enyitheya esongɨmba sabo.” <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />Hewethuwe Nyinya-kowethʉ mwanyɨbwɨra athɨ: “Genda, kʉshangwa nyandakʉthʉma hale, ko bandʉ b'ebɨhanda!”»<verse eid="ACT 22:21" /></para>
  <para style="s">Polo n'omʉkʉlʉ kʉtsɨbʉ w'abashirikani Baroma</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />Abandʉ mobahʉlɨkɨrɨtsya Polo yo kʉbʉya. Hewethuwe abere anegena ekɨnwa eky'enduli ekyo, mobathanga ɨhambala bathɨ: «Omʉndʉ oyo ithwe, kʉshangwa athatholere ibyaho!» <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />Mobahambala kʉtsɨbʉ, n'ɨgʉshanga esongɨmba sabo mo kyanya, nɨ bane mugulukya oluthuthu.<note caller="+" style="f"><char style="fr" closed="false">22:23 </char><char style="ft" closed="false">Ko Bayuta, erɨgʉsha oluthuthu lw'omo kyanya kyagenda ekikangya ko abandʉ bakapikire, na kuthyo mokyakangania ko Polo amahatsya kʉ Gongo.</char></note> <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />Aho omʉkʉlʉ kʉtsɨbʉ w'abashirikani mwahamʉla abashirikani bʉwe athɨ bɨngɨtsye Polo mo rʉba lwabo. Mwahamʉla bahumbe Polo yo mbasha bʉshana amɨnye ng'abandʉ abahambala bathyo kw'ɨye bʉshana na ki. <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />Hewethuwe mo ndambi abashirikani abo babere bamamala ɨmʉmɨna mʉ miriki bʉshana bamuhireko mbasha, Polo mwabʉtsya mʉgʉma w'oko bakʉlʉ babo yo wabyaga aho athɨ: «Mʉnyɨbwɨre, munahamulirwe ihumba <char style="w" lemma="Roma">Mʉroma</char><note caller="+" style="f"><char style="fr" closed="false">22:25 </char><char style="ft" closed="false">Polo abyaga Muyuta na kandɨ omʉgomba w'aBaroma mwamʉtsɨga ibya Mʉroma.</char></note> yo mbasha alɨ athetsi asohwa?»<verse eid="ACT 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26" />Omʉkʉlʉ oyo abere onvwa ebɨnwa ebyo, mwayabwɨra omʉkʉlʉ kʉtsɨbʉ athɨ: «Mʉkengwa, uthabya nioushondya ɨkola ki? Omuyira oyu kwenzi naye nɨ <char style="w" lemma="Roma">Mʉroma</char>!» <verse eid="ACT 22:26" /><verse number="27" style="v" sid="ACT 22:27" />Omʉkʉlʉ kʉtsɨbʉ oyo abere onvwa ebyo, mwaya bʉtsya Polo athɨ: «Nyɨbwɨre kwenene nga ʉlɨ <char style="w" lemma="Roma">Mʉroma</char>.» Polo mwashubya athɨ: «Ega, ingye nyɨrɨ <char style="w" lemma="Roma">Mʉroma</char>!» <verse eid="ACT 22:27" /><verse number="28" style="v" sid="ACT 22:28" />Omʉkʉlʉ oyo mwamʉbwɨra athɨ: «Ingye monyahana faranga nyɨngɨ bʉshana nyibye Mʉroma.» Polo mwashubya athɨ: «Ingye nyɨrɨ Mʉroma wa mbʉthɨrwa.» <verse eid="ACT 22:28" /><verse number="29" style="v" sid="ACT 22:29" />Kona kathambi ako, abo babyaga niabashondya ɨthondesa Polo mobamulika. Omʉkʉlʉ kʉtsɨbʉ w'abashirikani oyo, naye abere amɨnya ko yo athamɨna ko nɨ <char style="w" lemma="Roma">Mʉroma</char>, mwʉbaha.<verse eid="ACT 22:29" /></para>
  <para style="s">Polo embere y'oBʉshenge Bʉkʉlʉ bw'aBayuta</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />Bwabere bwakya, omʉkʉlʉ kʉtsɨbʉ w'abashirikani mwashondya amɨnye kundu-kundu nga nɨ ki kyo <char style="w" lemma="Bayuta">aBayuta</char> abasitakira Polo. Bʉshana n'ekyo mwamʉmɨnʉla, mwahamʉla <char style="w" lemma="Muheri">abakʉlʉ b'abaheri</char> <char style="w" lemma="Bʉshenge Bʉkʉlʉ">n'oBʉshenge Bʉkʉlʉ</char> boshi <char style="w" lemma="Bayuta">bw'aBayuta</char> bahindane. Ko nduli mwaletha Polo n'imwimania embere sabo.<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />Polo mwahanda amesho w'oko bakʉlʉ <char style="w" lemma="Bʉshenge Bʉkʉlʉ">b'oBʉshenge Bʉkʉlʉ</char> obo, n'ɨnegena athɨ: «Bagala bethʉ, ingye nyithashungire kiro na kɨbɨ mo mʉthɨma aye. Kʉshangwa ihika munobwire, nyetsi ko nyimene kʉbʉya embere sa Gongo.» <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" /><char style="w" lemma="Muheri">Omuheri mʉkʉlʉ</char> yo wahʉlawamo Ananɨa abere onvwa athyo, mwahamʉla abandʉ babyaga hofɨ na Polo athɨ bamʉbande ikofi ko bʉnʉ. <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />Aho Polo mwabwɨra Ananɨa oyo athɨ: «Nawe Gongo akʉbande ikofi, ɨwe ʉlɨ nga luhimbo luhakire mbemba.<note caller="+" style="f"><char style="fr" closed="false">23:3 </char><char style="xt" closed="false">Soma <ref loc="MAT 23:27">Matayo 23:27</ref>.</char></note> Ɨwe wikere aho bʉshana n'ɨnyɨsoha kuroshi ɨkwamana <char style="w" lemma="Mʉgomba">n'oMʉgomba</char> nga ko anegenire. Aho bʉshana na ki ʉlemwa ishikyawo mw'ɨhamʉla ʉthɨ banyɨbande ikofi?»<verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />Bo babyaga hofɨ na Polo mobamʉbwɨra bathɨ: «Ee! Ʉthafwa shoni wo uhangya <char style="w" lemma="Muheri">omuheri mʉkʉlʉ</char> wa Gongo?» <verse eid="ACT 23:4" /><verse number="5" style="v" sid="ACT 23:5" />Polo mwanegena athɨ: «Bagala bethʉ, nyithathetsi ko nɨ <char style="w" lemma="Muheri">muheri mʉkʉlʉ</char>. Kʉshangwa aMashako Abuyirire anegenire athɨ: “Ʉthagenda ʉnegena bɨbɨ ko mʉkʉlʉ w'abandʉ bawe.<note caller="+" style="f"><char style="fr" closed="false">23:5 </char><char style="xt" closed="false">Soma <ref loc="EXO 22:27-28">Ɨthoka 22:27-28</ref>.</char></note>”»<verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />Polo abyaga nietsi ko bagʉma b'omo <char style="w">Bʉshenge Bʉkʉlʉ</char> babyaga b'omo kɨkembe ky'a <char style="w" lemma="Basandukayo">Basandukayo</char> n'abandɨ babyaga b'omo kɨkembe ky'<char style="w" lemma="Bafarisayo">aBafarisayo</char>. Bʉshana n'ekyo, mwahambalɨra mo Bʉshenge obo athɨ: «Bagala bethʉ, nyɨrɨ <char style="w" lemma="Bafarisayo">Mufarisayo</char>, mʉgala <char style="w" lemma="Bafarisayo">w'aBafarisayo</char>.<note caller="+" style="f"><char style="fr" closed="false">23:6 </char><char style="xt" closed="false">Soma <ref loc="ACT 26:5">Mɨkolano 26:5</ref>; <ref loc="PHP 3:5">Banyafilipi 3:5</ref>.</char></note> Enyɨsohwa munobwire bʉshana nyɨrɨ na maha ko abaholi bandalubuka.» <verse eid="ACT 23:6" /><verse number="7" style="v" sid="ACT 23:7" />Polo abere amamala ɨnegena ebɨnwa ebyo, aho n'aho <char style="w" lemma="Bafarisayo:">aBafarisayo</char> <char style="w" lemma="Basandukayo">n'aBasandukayo</char> mobahaya, n'abandʉ bo babyaga mo muhindano mobagabana. <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />Byabyaga bithyo kʉshangwa <char style="w" lemma="Basandukayo">aBasandukayo</char> ɨbo abananegena bathɨ kʉthalɨ erilubuka lya baholi na kʉthalɨ <char style="w" lemma="Malaɨka">bamalaɨka</char> na kʉthalɨ <char style="w">batsɨmʉ</char>, hewethuwe <char style="w" lemma="Bafarisayo:">aBafarisayo</char> ɨbo bɨkɨrɨtsye ebyoshi ebyo.<verse eid="ACT 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 23:9" />Bʉshana n'ekyo obʉrʉnga mobwabya bʉngɨ, aho <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">bakangɨrɨtsya bagʉma b'oMʉgomba</char>, b'omo kɨkembe <char style="w" lemma="Bafarisayo">ky'aBafarisayo</char> mobimana n'ɨthanga ɨpenga bathɨ: «Ithwe thuthashungire kiro na kɨbɨ ko mʉndʉ oyu. Kʉthɨ nɨ mʉtsɨmʉ kʉtse <char style="w">malaɨka</char> yo ʉthanegena naye!» <verse eid="ACT 23:9" /><verse number="10" style="v" sid="ACT 23:10" />Obʉrʉnga obo bwabere bwakanya kʉtsɨbʉ, omʉkʉlʉ kʉtsɨbʉ w'abashirikani mwʉbaha, kʉshangwa mwaganɨtsya athɨ abandʉ abo bitha Polo. Aho mwahamʉla athɨ abashirikani bʉwe bakimire mo kathi k'abandʉ banyagʉle Polo mo minwe yabo, bamʉshʉbʉtsye mo rʉba lw'abashirikani.<verse eid="ACT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11" />Bwabere bwabya kɨro ky'ekɨro ekyo, Nyinya-kowethʉ mwahʉlʉkɨra Polo n'ɨmʉbwɨra athɨ: «Shika! Nga ko ʉthasɨmolera abandʉ bʉshana nangye mo muyi w'ɨYerʉsalemʉ ono, na ʉtholere nɨwakola uthyo na mo muyi <char style="w" lemma="Roma">w'ɨRoma</char> namo.»<verse eid="ACT 23:11" /></para>
  <para style="s">aBayuta abaya nama y'itha Polo</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />Bwabere bwakya, <char style="w">Bayuta</char> bagʉma mobaya nama. Mobalahɨtsya bathɨ bathirye kʉtse ɨshoma bathetsi bitha Polo. <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />Abandʉ bakolaga enama eyo babyaga nibalengitsye makumi ane. <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />Mobagendera <char style="w" lemma="Muheri">abakʉlʉ b'abaheri</char> n'abangʉmwa b'aBayuta mobabwɨrabo bathɨ: «Ithwe thwamalahɨtsya ko thuthirye kiro na kɨndʉ thuthetsi thwitha Polo. <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />Aho, imwe hagʉma <char style="w" lemma="Bʉshenge Bʉkʉlʉ">n'oBʉshenge Bʉkʉlʉ</char> mʉgende mʉshabe omʉkʉlʉ kʉtsɨbʉ w'abashirikani abahe Polo oyo. Mwayɨyɨra nga bandʉ bo bashondya ɨmɨnya kʉbʉya ebɨnwa byo bathamusitakira. Nethwe thwamʉlambɨra monzɨra bʉshana thumwithe embere ahike hano.»<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />Hewethuwe mʉgala wa mwalɨ wabo Polo, mwonvwa hwehweri y'enama eyo. Aho mwathɨbɨthɨra mo rʉba lw'abashirikani, mwɨngɨra mʉlo n'ɨbwɨra Polo yo mwatsɨ oyo. <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />Honyuma kw'aho, Polo mwabɨrɨkɨra mʉkʉlʉ mʉgʉma mo kathi k'abakʉlʉ b'abashirikani n'ɨmʉbwɨra athɨ: «Thwala omʉsole oyu eyɨrɨ omʉkʉlʉ kʉtsɨbʉ, kʉshangwa awithe kɨnwa kyo ashondya ɨmʉbwɨra.» <verse eid="ACT 23:17" /><verse number="18" style="v" sid="ACT 23:18" />Omʉkʉlʉ oyo mwathwala omʉsole ahalɨ omʉkʉlʉ kʉtsɨbʉ. Mwabwɨra omʉkʉlʉ kʉtsɨbʉ athɨ: «Mbe mʉkengwa, Polo mʉndʉ w'omuliki, mwanyɨbɨrɨkɨra n'ɨnyɨbwɨra athɨ nyɨkʉlethere omʉsole oyu kʉshangwa awithe ekɨnwa kyo ashondya ɨkʉbwɨra.»<verse eid="ACT 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19" />Omʉkʉlʉ kʉtsɨbʉ oyo mwatsɨmba omʉsole oyo y'oko kʉboko, mwayɨhɨgʉla hagʉma naye. Honyuma kw'aho mwamʉbʉtsya athɨ: «Mbe mʉsole! Ushondya ɨnyɨbwɨra ki?» <verse eid="ACT 23:19" /><verse number="20" style="v" sid="ACT 23:20" />Mwashubya athɨ: «<char style="w" lemma="Bayuta">aBayuta</char> bamalire ɨhʉlɨkɨrɨrana ɨkʉshaba ʉlethe Polo yo mungya embere <char style="w" lemma="Bʉshenge Bʉkʉlʉ">y'oBʉshenge Bʉkʉlʉ</char>, mʉ menge w'ɨnegena mbʉ <char style="w" lemma="Bʉshenge Bʉkʉlʉ">oBʉshenge Bʉkʉlʉ</char> obushondya ɨmɨnya kʉbʉya omwatsɨ ʉwe. <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />Hewethuwe ebɨnwa bakʉbwɨra, ʉthatsɨgɨragabo kʉshangwa abandʉ bamaya nama ko bayamʉlambɨra mo nzɨra. Na abandʉ abo, balengitsye bandʉ makumi ane. Na kandɨ bamalahɨtsya ko bathangalya kʉtsye ɨshoma bathetsi bitha Polo. Aho bamalire iyithegekania, balindire ekɨnwa kyo wanegena.» <verse eid="ACT 23:21" /><verse number="22" style="v" sid="ACT 23:22" />Omʉkʉlʉ kʉtsɨbʉ w'abashirikani oyo mwahamʉla omʉsole oyo athɨ: «Omwatsɨ wamanyɨfʉlɨra oyu, uthanalinda wabwɨra ʉndɨ mʉndʉ ko wamamala ɨnyɨfʉlɨrawo.» Honyuma kw'aho mobalagana.<verse eid="ACT 23:22" /></para>
  <para style="s">Polo athʉmwa ewa kafʉrʉnalɨ Felisi</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />Honyuma kw'aho omʉkʉlʉ kʉtsɨbʉ w'abashirikani oyo, mwabɨrɨkɨra bakʉlʉ babɨrɨ mo kathi k'abakʉlʉ b'abashirikani bʉwe. Mwabwɨrabo athɨ: «Muthegekanie bashirikani magana abɨrɨ, bo banagenda mo bɨshando, na bandɨ makumi alɨnda bobanalwa nɨbalɨ ko farasɨ, na bandɨ magana abɨrɨ bo betsi erɨlwa mo masɨnga. Aboshi abo bathoka hano ko saha ishathu sa kɨro bʉshana baye mo muyi w'iKaisaria. <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />Na muthegekanie farasɨ so saheka Polo n'imuhikya ewa kafʉrʉnalɨ Felisi nɨna mʉtsɨbʉ.»<figure style="fig" alt="les unités miltaires qui ont escorté Paul" file="lb00198.jpg" size="col" ref="23:23-24">Abashirikani abathegekanibawa ɨthwala Polo ewa kafʉrʉnalɨ Felisi</figure><verse eid="ACT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 23:25" />Omʉkʉlʉ kʉtsɨbʉ w'abashirikani oyo mwashaka amarʉba athɨ:<verse eid="ACT 23:25" /></para>
  <para style="pi">
    <verse number="26" style="v" sid="ACT 23:26" />«Mʉkengwa kafʉrʉnalɨ Felisi, ingye Kalautio Lʉsɨa enyɨkʉketsya. <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />Enyishondya ɨkʉbwɨra k'omʉndʉ oyu, <char style="w" lemma="Bayuta">aBayuta</char> mobamʉtsɨmba n'ishondya imwitha. Hewethuwe nyabere nyonvwa ko ni <char style="w" lemma="Roma">Mʉroma</char>, ingye n'abashirikani baye monyayire mʉshabʉla. <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />Aho monyamʉthwala embere <char style="w" lemma="Bʉshenge Bʉkʉlʉ">s'oBʉshenge Bʉkʉlʉ</char> bwabo. Kʉshangwa nyagenda enyishondya nyɨmɨnye ekyalekaga nibamusitaka. <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />Nyabere nyahika omo, monyamɨnya ko bamusitakire bʉshana n'obʉhaka <char style="w" lemma="Mʉgomba">bw'omʉgomba</char> wabo. Hewethuwe hathabyaga kiro na kɨbɨ n'ekɨgʉma eky'akolaga ekyangaleka n'ithwa kʉtse nɨamɨnwa. <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />Nyabere nyonvwa ko aBayuta abamʉyɨra nama y'imwitha, monyashungire kʉbʉya nyɨkʉthʉmɨre ɨye yo tsʉba. Honyuma kw'aho monyabwire bo bamusitakaga nyɨthɨ nɨ eyo ʉlɨ eyo yo bayamusitakira.»<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />Abashirikani abo mobakola nga ko bahamʉlawa n'omʉkʉlʉ wabo. Mona kɨro ky'ekɨro ekyo, mobatsɨmba Polo n'ɨmʉthwala mo muyi w'iAntipatiri. <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />Bwabere bwakya, abashirikani bo banagenda mo bɨshando mobashʉba mo rʉba lwabo, na bo babyaga ko farasɨ mobalotsya ebʉshondotsɨ nɨbanalɨ na Polo. <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />Babere bahika mo muyi w'iKaisaria mobawathya kafʉrʉnalɨ yo amarʉba, na mobaletha Polo y'embere sɨwe. <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />Kafʉrʉnalɨ abere asoma amarʉba ayo, mwabʉtsya Polo athɨ: «Ɨwe ʉlɨ mʉndʉ wa mʉ kɨhʉgo kɨhe?» Abere onvwa ko Polo nɨ w'omo kɨhʉgo ky'iKilikia, <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />mwanegena athɨ: «Nyakʉthondesa bo bakusitaka babya bahika.»</para>
  <para style="p" vid="ACT 23:35">Ko nduli, mwahamʉla abashirikani bʉwe athɨ batheye Polo mo rʉba lw'elyamɨ lw'omwamɨ <char style="w">Herote</char>.<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s">aBayuta abasitaka Polo embere ya kafʉrʉnalɨ Felisi</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />Kwabere kwahwa bɨro bɨthano <char style="w" lemma="Muheri">omuheri mʉkʉlʉ</char> Ananɨa mwandagalɨra mo muyi w'iKaisaria hagʉma n'abangʉmwa bagʉma b'aBayuta, n'embuyi yabo, Teritulo. Mobahika embere ya kafʉrʉnalɨ Felisi n'ɨthanga isitaka Polo. <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />Babere babɨrɨkɨra Polo, Teritulo mwathanga imusitaka nɨanegena athɨ: «Ee mʉkengwa kafʉrʉnalɨ Felisi, nɨ ɨwe wo ulekire nithwabya na bʉholo ko bɨro byoshi bɨno. Kandɨ obuthegeki bwawe bʉbʉya bo bwalekire bɨngɨ nɨbyahɨndʉka n'ibya bɨbʉya ko ndundi y'ekɨhʉgo kɨno. <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />Ko byoshi ebyo mʉkengwa kafʉrʉnalɨ Felisi, ebɨro byoshi na ahoshi-hoshi, othʉkʉsɨma kʉtsɨbʉ. <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />Hewethuwe bʉthashʉba kuluhya, enyɨkʉshaba ko lʉkogo lwawe, ʉhʉlɨkɨrɨtsye ebɨnwa bɨke bɨno ebyo othushondya ɨnegena.<verse eid="ACT 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 24:5" />«Omʉndʉ oyu, thwamashʉnga ko ni bwanishe, aletha bʉrʉnga mo <char style="w">Bayuta</char> b'omo kɨhʉgo kyoshi. Kuthyo nɨ ɨye yo mʉkʉlʉ w'ekɨkembe ky'aBanyanasareti.<note caller="+" style="f"><char style="fr" closed="false">24:5 </char><char style="fq" closed="false">aBanyanasareti: </char><char style="ft" closed="false">Erɨtsɨna eryo erɨnagenda erɨhabwa Yesʉ, hewethuwe hano eryahʉla abɨga bʉwe. </char><char style="xt" closed="false">Soma <ref loc="MAT 26:71">Matayo 26:71</ref>.</char></note> <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />Na kandɨ mwashondya ibihya <char style="w" lemma="Nyʉmba ya Gongo">eNyʉmba ya Gongo</char> aho mothwamʉtsɨmba. [Mothwashondya ɨmʉthondesa ɨkwamana n'oMʉgomba ethʉ nga ko anegenire, <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />hewethuwe omʉkʉlʉ kʉtsɨbʉ w'abashirikani Lʉsɨa mwamʉnyagʉla mo minwe ethʉ. <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />Mwanegena athɨ abandʉ bo bathasitaka Polo, nɨ eno yo baye.<note caller="+" style="f"><char style="fr" closed="false">24:8 </char><char style="ft" closed="false">Ɨthoka ko kɨtse kinyuma ky'omʉlondo wa 6 ihika ko mʉlondo wa 8, bɨthalɨ mʉ mashako magʉma wa kera. </char></note>] Nawe wowene wamʉthondesa, aho wamɨnya ko kwenene ebyo byalekaga nithwamusitaka.»<verse eid="ACT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 24:9" />Ebɨnwa bya Teretulo, <char style="w" lemma="Bayuta">aBayuta</char> nabo mobahathɨkɨrɨtsya bathɨ ebyo anegena nɨ bya kwenene.<verse eid="ACT 24:9" /></para>
  <para style="s">Polo ayɨthondera embere sa kafʉrʉnalɨ Felisi</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />Honyuma kw'aho kafʉrʉnalɨ Felisi mwakohetsya Polo athɨ anegene. Aho Polo naye mwanegena athɨ: «Nyetsi ko ɨwe wamamala myaka mɨngɨ ʉnalɨ ʉsoha mo kɨhʉgo kɨno. Bʉshana n'ekyo, nyathonda embere sawe na mʉthɨma ashikire. <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />Ɨwe wowene-wene wanganabʉtsya, bakʉbwɨra ko kuthetsi kwatsʉka bɨro birengitsye ikumi na bɨbɨrɨ nyɨrʉkɨre ɨYerʉsalemʉ bʉshana n'iyaramya Gongo. <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />Mo kathi k'abandʉ aba, hathalɨ n'omʉgʉma yo wanyegaya nyɨrɨ enyikubisania kʉtse iuhya abandʉ balethe bʉrʉnga, ibye mo <char style="w">Nyʉmba ya Gongo</char> kʉtse mo <char style="w" lemma="Sinakoki:">sosinakoki</char> kʉtse handɨ handʉ mo muyi oyo. <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />Abandʉ aba bathangakotsya ikukangania ko byo banyisitakira lɨno ko nɨ bya kwenene. <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />Hewethuwe, ekyo nyimire embere sawe mbe mʉkengwa, kye kɨno: ingye enyinaramya Gongo wa bo thatha-kʉlʉ mw'ɨkwama eNzɨra yo ɨbo abahʉlamo ya mabesɨ. Kandɨ ebyoshi bishakirwe mo <char style="w" lemma="Mʉgomba">Mʉgomba</char> wa Mʉsa, na mo bɨtabo <char style="w" lemma="Mʉmɨnyeretsɨ">by'abamɨnyeretsɨ</char>, nabyo nyɨkɨrɨtsyebyo. <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />Na kandɨ nga ko balɨ na maha ko Gongo andalubukya ababʉya n'ababɨ, nangye kuthyo nyɨrɨ n'amaha oyo. <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />Kyo kɨnaleka, nangye nɨnyayɨtsɨnga bʉlɨ kɨro ibya na mɨanɨtsye ikwirire yo ɨthangasohwa embere sa Gongo n'embere s'abandʉ.<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />«Aho mʉkengwa, honyuma ya mɨaka mɨngɨ nɨ nyɨthalɨ mo muyi w'ɨYerʉsalemʉ, monyashubire mʉwo bʉshana n'iwathikya abandʉ b'ekɨhanda kyaye na buwathikya bwa bushoki n'ɨha Gongo yo bɨhembo. <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />Nɨ ebyo byo nyagenda enyɨkola mo ndambi banyegaya mo <char style="w">Nyʉmba ya Gongo</char>. Na nyabyaga nɨ nyamamala ɨyetsya. Na mo <char style="w">Nyʉmba ya Gongo</char> eyo, nyithabyagamo na mʉndʉ, na hathabyaga na kiro na bʉrʉnga bo nyalethagamo. <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />Hewethuwe <char style="w">Bayuta</char> bagʉma b'iAsia babyagaho. Nɨ abo bo bangimene embere sawe bʉshana n'inyisitaka, balɨ bawithe kyo banganyisitakira. <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />Kʉtse abandʉ balɨ hano aba, banegene balɨ mobanyonvwako kɨbɨ nyɨthabere nyathonda embere <char style="w" lemma="Bʉshenge Bʉkʉlʉ">y'oBʉshenge Bʉkʉlʉ</char> bwabo. <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />Alɨnga ekɨnwa kyo banyonvwagako kʉbɨ, mo mʉgʉlʉ nyahambalaga nyɨthɨ: “Enyɨbʉrana embere senyu munobwire kʉshangwa ko nyɨrɨ na muyinihiro kw'abaholi bandalubuka!”»<verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />Honyuma kw'aho kafʉrʉnalɨ Felisi, kʉshangwa abyaga nietsi emyatsɨ y'eNzɨra ya Nyinya-kowethʉ, mwimania olʉbanza. Mwanegena athɨ: «Nyabatsɨra olʉbanza olu, Lʉsɨa omʉkʉlʉ kʉtsɨbʉ w'abashirikani abya ahika hano!» <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />Honyuma kw'aho mwabwɨra omʉkʉlʉ w'abashirikani athɨ atheye Polo mo biriso, hewethuwe agende amʉha bwiranda bw'ɨkola ebyo ashashire. Na kandɨ athagendaga ahangɨra abira bʉwe mo ndambi bo bamuwathikya bagenda abahika.<verse eid="ACT 24:23" /></para>
  <para style="s">Polo athonda embere sa Felisi na Tʉrʉsɨla</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />Honyuma wa bɨro bɨke, kafʉrʉnalɨ Felisi na mʉkatsɨwe Tʉrʉsɨla, yo wabyaga <char style="w" lemma="Bayuta">Muyuta</char> mobahika. Mwanegena athɨ bamʉbɨrɨkɨrɨre Polo. Mwahʉlɨkɨrɨtsya ebɨnwa Polo agendaga anegena bʉshana n'erɨkɨrɨtsya Yesʉ <char style="w" lemma="Kirisito, Masia">Kirisito</char>. <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />Hewethuwe Polo abere alɨ akangɨrɨtsya bʉshana n'obʉthʉnganene, na bʉshana n'ɨyɨkakɨtsya ko bɨtsɨbʉ, na bʉshana n'ekɨro ky'esohi ya Gongo yo yandahika, Felisi mwʉbaha n'ɨmʉbwɨra athɨ: «Lɨno ʉhera wangagenda. Nyandabya nyabona kathambi nyandashʉba kʉbɨrɨkɨra.» <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />Felisi mwagenda abɨrɨkɨra Polo ngendo ngʉma-ngʉma bʉshana n'ɨsɨmola naye niahirireyo maha athɨ Polo amʉha faranga. <verse eid="ACT 24:26" /><verse number="27" style="v" sid="ACT 24:27" />Kwabere kwahwa myaka ibiri, Porikio Fesɨto mwaya mo mwanya wa Felisi nga kafʉrʉnalɨ. Hewethuwe Felisi kʉshangwa abyaga niashondya amoye <char style="w" lemma="Bayuta">aBayuta</char>, mwalika Polo mo biriso ebyo.<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s">Polo athonda embere ya kafʉrʉnalɨ Fesɨto</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />Fesɨto abere amamala bɨro bɨshathʉ ahikire mo kɨhʉgo ky'iYuteya, mwathoka mo muyi w'iKaisaria n'ɨrʉkɨra mo muyi w'ɨYerʉsalemʉ. <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />Abere ahika eyo, <char style="w" lemma="Muheri">abakʉlʉ b'abaheri</char> n'abangʉmwa <char style="w" lemma="Bayuta">b'aBayuta</char> mobayasitaka Polo yo embere sɨwe. <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />Mobamʉshaba kʉtsɨbʉ bathɨ awathikyebo ashubye Polo y'ɨYerʉsalemʉ, kʉshangwa babyaga nɨbamaya nama y'ithira Polo mo nzɨra. <verse eid="ACT 25:3" /><verse number="4" style="v" sid="ACT 25:4" />Hewethuwe Fesɨto mwashʉbɨtsyabo athɨ: «Ndɨ Polo atheyibwa mo biriso mw'iKaisaria, nangye ngy'owene-wene ndɨthɨndɨre ɨyayo. <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />Aho mʉyɨre thwandagalɨre iKaisaria na bagʉma mo bakʉlʉ benyu. Na nɨ eyo yo bamusitakire amabya niakolire kɨbɨ kyoshi-kyoshi.»<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />Fesɨto abere amamala bɨro bithalingetsye mʉnanɨ kʉtse ikumi hagʉma nabo mwashʉba iKaisaria. Bwabere bwakya, mwayikala mo tɨrɨbɨnalɨ na mwahamʉla athɨ bamʉlethere Polo. <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />Polo abere ahika, <char style="w" lemma="Bayuta">aBayuta</char> bo bathokaga ɨYerʉsalemʉ, mobamuthimbako na mobamusitaka bɨnwa bɨngɨ kandɨ bɨtsɨtho byo ɨbo bene balemwaga ikangya ko nɨ bya kwenene. <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />Hewethuwe Polo mwathonda athɨ: «Hathalɨ kɨtsɨbʉ kyoshi kyo nyakolire, ibye ko <char style="w">Mʉgomba</char> <char style="w" lemma="Bayuta">w'aBayuta</char>, ibye ko <char style="w">Nyʉmba ya Gongo</char>, ibye kʉ <char style="w">Kaisari</char>.»<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />Fesɨto naye abyaga niashondya imoya <char style="w" lemma="Bayuta">aBayuta</char>. Bʉshana n'ekyo, mwabʉtsya Polo athɨ: «Ushondya w'ɨrʉkɨre ɨYerʉsalemʉ bʉshana ʉyasoherweyo embere saye?» <verse eid="ACT 25:9" /><verse number="10" style="v" sid="ACT 25:10" />Hewethuwe Polo mwamʉshʉbɨtsya athɨ: «Ko ndambi eno nyimene embere y'etɨrɨbɨnalɨ ya <char style="w" lemma="Kaisari">Kaisari</char>. Aho nɨ hano hasha ho nyɨtholere ɨsoherwa. Ɨwe wowene wetsi ko hathalɨ kiro na kɨbɨ ekyo nyakolere <char style="w" lemma="Bayuta">aBayuta</char> aba. <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />Na ko kwenene nyamabya nyɨrɨ mʉlɨgo na nyamabya nɨmonyakola kɨbɨ kyo kyangaleka ninyithwa, nyithathindire ɨhola. Hewethuwe halɨ hathalɨ kya kwenene mo byo abandʉ aba abanyisitakira, hathalɨ mʉndʉ yo wanyihira mo minwe yabo. Enyishondya ɨya thondera embere sa <char style="w">Kaisari</char>.» <verse eid="ACT 25:11" /><verse number="12" style="v" sid="ACT 25:12" />Aho Fesɨto mwathanga ɨsɨmola n'abahani bʉwe. Honyuma kw'aho mwashʉbɨtsya Polo athɨ: «Kʉshangwa wamashaba ɨyathondera embere ya <char style="w">Kaisari</char>, nɨ eyo yo wayathondera.»<verse eid="ACT 25:12" /></para>
  <para style="s">Polo embere ya Angiripa na Berenike</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />Enyuma ya bɨro bɨrɨ bʉlebe, omwamɨ <char style="w" lemma="Herote">Angiripa</char> na Berenike mwalɨ wabo, mobahika iKaisaria bʉshana n'ɨyaketsya kafʉrʉnalɨ Fesɨto. <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />Mobamala eyo yo bɨro bɨngɨ. Na mo bɨro ebyo Fesɨto mwaganʉlɨra omwamɨ y'ebɨnwa bya Polo. Mwamʉbwɨra athɨ: «Hano halɨ muyira mʉgʉma yo Felisi athamika mo biriso. <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />Nyabere nyahika ɨYerʉsalemʉ, <char style="w" lemma="Muheri">abakʉlʉ b'abaheri</char> n'abangʉmwa <char style="w" lemma="Bayuta">b'aBayuta</char> mobamusitaka na mobanyɨshaba nyɨmʉsohe. <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />Nangye monyashubitsyebo nyɨthɨ <char style="w" lemma="Roma">aBaroma</char> bathabegere ɨsoha mʉndʉ yo uthasitakwa alɨ athetsi athonda embere y'abandʉ bathamusitaka bʉshana abone mwanya w'ɨyɨthondera ko byo bathamusitakira. <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />Aho, monyahikire nabo kʉno. Bwabere bwakya, bʉthathɨndɨra, monyikere mo tɨrɨbɨnalɨ n'ɨhamʉla nyɨthɨ balethe Polo oyo. <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />Abere ahika, abo bamusitakaga babere bamala ɨthonda, monyashungire ko hathalɨ kiro na kɨnwa kɨbɨ kyo bathamusitakako kyo kɨrɨ nga ko nyɨthagenda enyɨganɨtsya. <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />Bathagenda abakubisania naye ko birebitsye ekɨsomo kyabo na ko birebitsye mʉndʉ mʉgʉma yo wamalire ɨfwa mbʉ yo Yesʉ. Na Yesʉ oyo, yo Polo abwɨrako abandʉ athɨ akɨnalɨho. <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />Ebɨnwa bɨrɨ ng'ebyo monyalemirwe nga ko nyangatsabyo. Nɨmo monyabʉtsya Polo ng'ashondya ebɨnwa bɨwe bɨyasoherwe ɨYerʉsalemʉ. <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />Hewethuwe Polo mwashaba athɨ embere ya <char style="w">Kaisari</char> yo ashondya ɨthondera. Aho, nangye monyahamulire bamutheye mo biriso ihika ko kɨro nyandamʉthʉma ewa <char style="w">Kaisari</char> ɨRoma.»<verse eid="ACT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22" />
    <char style="w" lemma="Herote">Angiripa</char> mwabwɨra Fesɨto athɨ: «Nangye nyitsigire nɨnyayonvwɨra omuyira oyo ingy'owene-wene.» Fesɨto mwashubya athɨ: «Mungya wandamonvwa.»<verse eid="ACT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />Bwabere bwakya, <char style="w" lemma="Herote">Angiripa</char> na Berenike mobahika na lʉkengerwa lʉnene nɨbakwamene n'abakʉlʉ b'abashirikani n'abangʉmwa b'omuyi, na mobɨngɨra mo nyʉmba yo bagenda abatsɨramo esomanza. Aho, Fesɨto mwahamʉla athɨ balethe Polo. <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />Honyuma kw'aho Fesɨto mwanegena athɨ: «Mwamɨ <char style="w" lemma="Herote">Angiripa</char> n'imwe boshi mʉlɨ hano hagʉma nethwe, mʉshʉnge omʉndʉ oyu! <char style="w" lemma="Bayuta">aBayuta</char> boshi mobamusitakire kw'ingye ɨYerʉsalemʉ. Na kuthyo mobamusitakire kʉno Kaisaria balɨ abahambala bathɨ athakɨtholere ibyaho. <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />Hewethuwe ingye monyashungire ko athakolire kiro na kɨbɨ ekyangaleka n'ithwa. Hewethuwe kʉshangwa yowene mwashabire athɨ ebɨnwa bɨwe bɨsohwe na Kaisari, aho monyashungire ko bɨtholere nyɨmʉthʉme ey'alɨ. <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />Na kuthyo nangye nyithawithe kɨnwa kyo nyangashakɨra Kaisari bʉshana naye. Ekyo kyo kyamaleka nɨnyamʉletha embere sawe mbe mwamɨ <char style="w" lemma="Herote">Angiripa</char>. Aho, nyabona kɨnwa ekyo nyangashaka wabya wamala ɨmʉthondesa. <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />Kʉshangwa nyamalola ko bithakwirire ɨthʉma mʉndʉ wa muliki ɨRoma buthakangania kʉbʉya-kʉbʉya ebyo abamusitakira.»<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s">Polo athonda embere ya Angiripa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />
    <char style="w" lemma="Herote">Angiripa</char> mwabwɨra Polo athɨ: «Nyamakʉhamʉla ʉyɨnegenere wowene.»</para>
  <para style="p" vid="ACT 26:1">Aho Polo mwalambʉla okʉboko, na mwathanga ɨnegena athɨ: <verse eid="ACT 26:1" /><verse number="2" style="v" sid="ACT 26:2" />«Mbe mwamɨ <char style="w" lemma="Herote">Angiripa</char>, nyimoyire erimana embere sawe munobwire, bʉshana nyɨyɨthondere ko bɨnwa byoshi ebyo <char style="w" lemma="Bayuta">aBayuta</char> abanyisitakako. <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />Nyimoyire nyithyo kʉshangwa ɨwe wowene wetsi kʉbʉya emɨbere yoshi <char style="w" lemma="Bayuta">y'aBayuta</char>, n'ebɨnwa ebyo abanagenda abakubisaniako. Bʉshana n'ekyo mʉkengwa, enyɨkʉshaba ʉnyɨhʉlɨkɨrɨtsye buthayihania.<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />«<char style="w" lemma="Bayuta">aBayuta</char> boshi betsi obʉyɨngo bwaye nga ko bʉlɨ ɨthanga ko bwana bwaye. Kandɨ betsi nga ko nyagenda enyɨyɨwatha mo kɨhʉgo kyethʉ na mo muyi w'ɨYerʉsalemʉ. <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />Ɨthanga kera banyetsi kʉbʉya. Na bamashasha ɨbo bene bangakangania kwenene ko nyabyaga mʉgʉma w'oko kɨkembe ky'<char style="w" lemma="Bafarisayo">aBafarisayo</char>. <char style="w" lemma="Bafarisayo">N'aBafarisayo</char> abo n'ɨbo bo banahathɨkɨrɨtsya kʉtsɨbʉ mo bɨnwa by'emɨbere y'ekɨsomo kyethʉ. <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />Lɨno nyimene hano bʉshana n'ɨsohwa, kʉshangwa nyiyinihire endagane eyo Gongo alagaga bo thatha-kʉlʉ. <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />Omʉlayi oyo, esonganda sethʉ ikumi n'ibiri natho siyinihire ko Gongo andabereretsyawo. Na nɨ bʉshana n'ekyo esɨnagenda esimuramya kɨro na mwɨshɨ. Mbe mwamɨ Angiripa, amaha ayo w'aleka <char style="w" lemma="Bayuta">aBayuta</char> aba nibanyisitaka munobwire. <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />Imwe Bayuta, bʉshana na ki omʉnaganɨtsya mʉthɨ Gongo athangalubukya abaholi?<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />«Ingy'owene nyagenda enyɨganɨtsya nyɨthɨ nyɨtholere ɨgenda enyɨkola ebyoshi byo nyangakotsya mw'ɨlwɨsya erɨtsɨna lya Yesʉ w'iNasareti. <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />Na nɨ ebyo byo nyakolaga ɨYerʉsalemʉ. Nɨ <char style="w" lemma="Muheri">abakʉlʉ b'abaheri</char> bo bagenda abanyɨha amaka w'ɨgenda enyɨgʉsha abɨkɨrɨtsya mo biriso. Na mo ndambi bagenda abanegena bathɨ abɨkɨrɨtsya abo bithwe, nangye nyagenda enyɨmɨra ko bithwe. <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />Ngendo nyɨngɨ, nyagenda enyɨya nubyabo mo <char style="w" lemma="Sinakoki">sosinakoki</char> kʉshangwa bahatsye kʉ Yesʉ. Nyabyaga na kiniga kɨnene bʉshana nabo monyahika ko kɨka ky'ɨgenda enyiyanubyabo mo miyi ya bɨndɨ bɨhʉgo.»<verse eid="ACT 26:11" /></para>
  <para style="s">Polo aganʉlɨra erɨbɨndʉka lɨwe</para>
  <para style="r">(<ref loc="ACT 9:1-19">Mɨko 9:1-19</ref>; <ref loc="ACT 22:6-16">22:6-16</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />Polo kandɨ mwashʉba negena athɨ: «Ni kuthyo ko <char style="w" lemma="Muheri">abakʉlʉ b'abaheri</char> banyɨhaga maka n'ɨnyɨhamʉla ɨya mo muyi w'iTamasiki. <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />Aho mbe mwamɨ, nyabere nyɨkɨnalɨ mo nzɨra, mʉ kathi ka mwɨshɨ, aho n'aho monyashʉnga kyakakala nɨekɨthoka mo lʉbʉla. Ekyakakala ekyo, mokyakoletsya kʉtsɨbʉ kʉlenga erɨtsʉba, na mokyanyɨkoletsya ko mbande soshi hagʉma na balikyethu bo thwabyaga nabo mo lʉgendo. <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />Ithwe boshi mothwawa ahishi. Honyuma kw'aho monyonvwa mʉlenge nɨanyɨbwɨra mo mʉnegene <char style="w" lemma="Baebʉranɨa">w'ekɨebʉranɨa</char> athɨ: “Sauli, Sauli, bʉshana na ki unyinubya? Ɨwe ʉlɨ nga nde yo yinayihuma mo lʉshʉthɨ lwa nyinya-kowabo. Ʉmɨnye ko oʉyagatsya bʉsha.” <verse eid="ACT 26:14" /><verse number="15" style="v" sid="ACT 26:15" />Monyabʉtsya nyɨthɨ: “Ʉlɨ ndɨ no Nyinya-kowethʉ?” Naye mwanyɨshʉbɨtsya athɨ: “Ni ingye Yesʉ ngyo unubya. <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />Hewethuwe hangana, ʉyɨsɨngɨrɨke. Monyɨkʉbʉthʉkɨra bʉshana nyɨkʉyɨremo mukoli aye. Ɨwe wabya mutimo aye bʉshana ʉganʉlɨre abandʉ nga ko ʉthanyɨshʉngako munobwire na ʉfʉle emyatsɨ nyandashʉba kʉkangya. <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />Nyandagenda enyɨkʉshabʉla ɨthoka mo minwe y'abagala benyu Bayuta, na mo minwe y'abandʉ b'ebɨhanda ebyo enyɨkʉthʉmako, <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />bʉshana ʉtsɨbʉle amesho wabo, bathoke mo mwitsimya na bɨngɨre mo kyakakala. Bathoke mo maka wa <char style="w">Sitani</char>, babɨndʉkɨre Gongo, kʉbʉshɨ baganyɨrwe ebɨtsɨbʉ byabo, n'ɨbona mwanya hagʉma n'abandɨ <char style="w" lemma="Mubuyirire">babuyirire</char> baye, abo Gongo amashombola mw'ɨnyɨkɨrɨtsya.<note caller="+" style="f"><char style="fr" closed="false">26:18 </char><char style="xt" closed="false">Soma <ref loc="ISA 42:6-7">Isaya 42:6-7</ref>; <ref loc="COL 1:12-13">Banyakolosayi 1:12-13</ref>.</char></note>”»<verse eid="ACT 26:18" /></para>
  <para style="s">Polo anegenera omʉlɨmo ʉwe</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />Polo mwashʉba negena athɨ: «Bʉshana n'ekyo mbe mwamɨ <char style="w" lemma="Herote">Angiripa</char>, ehumanani yanyihikiraga ɨthoka mo lʉbʉla, monyakola nga ko yanyɨhamʉlaga. <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />Hewetuwe monyathanga ɨkangɨrɨtsya abo mo muyi w'iTamasiki, n'abahimbani b'omo muyi w'ɨYerʉsalemʉ n'abomo kɨhʉgo kyoshi ky'iYuteya babɨndʉke bathoke mo bɨtsɨbʉ byabo. Babɨndʉkɨre Gongo, n'emɨkolano yabo ɨgende eyikangania ko bamabɨndʉka kwenene. Byo n'ebɨnwa ebyo, byo nyakangɨrɨtsaya, n'ihika ko bandʉ b'ebɨhanda nabo. <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />Kyo kyalekaga <char style="w" lemma="Bayuta">aBayuta</char> nɨbanyɨtsɨmbɨra mo <char style="w">Nyʉmba ya Gongo</char> n'ishondya inyitha. <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />Hewethuwe ihika ko kɨro kya munobwire, Gongo akinanyithegaya. Bʉshana n'ekyo, nyɨkɨnakangɨrɨtsaya abandʉ boshi abakʉlʉ n'abalere ebɨnwa nyayɨshʉngɨraga. Hathalɨ bɨndɨ bɨnwa byo nyɨkangɨrɨtsya bɨthalɨ byo <char style="w" lemma="Mʉmɨnyeretsɨ">abamɨnyeretsɨ</char> na Mʉsa bagenda abanegena bathɨ byandahika. <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />Aboshi abo mobanegena ko <char style="w" lemma="Kirisito, Masia">Kirisito</char> atholere nianubibwa, n'ibya mumbere erilubuka ɨthoka mo baholi, bʉshana akangɨrɨtsye Engʉlʉ y'oBwamɨ bw'ekyakakala ko Bayuta na ko bandʉ b'ebɨhanda.»<verse eid="ACT 26:23" /></para>
  <para style="s">Polo ashaba Angiripa ɨkɨrɨtsye Yesʉ</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />Polo abere akɨnalɨ anegena, Fesɨto mwamʉbwɨra nɨahambala athɨ: «Polo, ʉlɨ mʉsɨre! Erɨga bɨngɨ lyalekire nɨwasɨreha!»<verse eid="ACT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25" />Hewethuwe Polo mwamʉshʉbɨtsya athɨ: «Mʉkengwa Fesɨto, nyɨthalɨ mʉsɨre. Ebɨnwa enyɨnegena nɨ bya kwenene kandɨ nɨ bya mʉndʉ awithe bwenge. <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />Ebɨnwa ebyo, omwamɨ Angiripa naye etsibyo kʉbʉya. Kuthyo nyetsi kwenene ko hathalɨ eky'athetsi, kʉshangwa ebɨnwa byoshi ebyo bɨthakolekaga mʉ bubisho. Bʉshana n'ekyo nyɨthalɨ na bʉba boshi bw'ɨnegena embere sɨwe. <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />Mwamɨ <char style="w" lemma="Herote">Angiripa</char>, ebɨnwa ebyo <char style="w" lemma="Mʉmɨnyeretsɨ">abamɨnyeretsɨ</char> banegenaga, ndɨ unikiritsyebyo! Nyetsi kʉbʉya ko wikiritsyebyo.»<verse eid="ACT 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28" />Nɨmo <char style="w" lemma="Herote">Angiripa</char> abʉtsya Polo athɨ: «Uganɨtsya ʉthɨ wanyuhya ibya mukirisito mo kathambi kake kano?» <verse eid="ACT 26:28" /><verse number="29" style="v" sid="ACT 26:29" />Polo mwashubya athɨ: «Moyangabya ndambi nge kʉtse nene, enyɨkʉshabɨra kʉ Gongo, enyɨshabɨra n'abandɨ bandʉ boshi aba bobanyɨhʉlɨkɨrɨtsya munobwire mubye ng'angye. Hewethuwe nyɨthalɨ enyishondya mʉgende omʉmɨnwa nga ko nyiminirwe mo bʉhʉlʉla.»<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />Honyuma kw'aho, omwamɨ na kafʉrʉnalɨ na Berenike n'aboshi babyaga nabo, mobimana. <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />Babere bathoka aho mobaya nama, nɨabanegena mo kathi kabo bathɨ: «Omʉndʉ oyu athakolire kiro na kɨbɨ ekyangaleka nɨasoherwa lʉholo kʉtse ɨyamɨnwa.» <verse eid="ACT 26:31" /><verse number="32" style="v" sid="ACT 26:32" /><char style="w" lemma="Herote">Angiripa</char> mwabwɨra Fesɨto athɨ: «Omuyira oyu angaminulirwe alɨ athashabaga ɨthondera ewa <char style="w">Kaisari</char>.»<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s">Polo athʉmwa ɨRoma</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />Honyuma kw'aho mobahamʉla ɨthʉthwala mo kɨhʉgo ky'iItalia mo bwatho, mobahira Polo na bandʉ ba muliki bagʉma mo minwe ya mʉkʉlʉ mʉgʉma wa bashirikani yo wahʉlawamo Yuli. Ye Yuli oyo abyaga w'omo kɨkembe ky'abashirikani kyo kyahʉlawamo «Kɨkembe ky'abashirikani ba Kaisari». <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />Mothwɨngɨra mʉ bwatho bʉgʉma bo bwagenda obʉthoka mo muyi w'iAtaramiti. Obwatho obo bwabyaga nɨbwatsʉkɨra ko byambʉ by'omo kɨhʉgo ky'iAsia. Mothwagenda hagʉma na Sɨtarɨko mwikalani mʉgʉma w'omo kɨhʉgo ky'iMaketonia, w'omo muyi w'iTesalonika. <verse eid="ACT 27:2" /><verse number="3" style="v" sid="ACT 27:3" />Bwabere bwakya, mothwashabʉkɨra mo muyi w'iSitona. Ye Yuli, kʉshangwa agenda akolera Polo yo bɨbʉya, mwamʉtsɨyɨra ayalole ko bira bʉwe bʉshana bamʉhe ebɨndʉ alayireko. <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />Mw'ɨthoka iSitona mothwatsʉka mo ndambɨ-ndambɨ y'ekɨtsɨra ky'eKipuro bʉshana n'ɨshaga erɨhʉnga lyo lyagenda erɨhʉlʉka embere sethʉ. <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />Mothwashabʉka engetsɨ nɨothʉtsʉka emʉsɨke w'ekɨhʉgo k'iKilikia na eky'iPamufilia. Honyuma kw'aho mothwahika mo muyi w'iMira mo kɨhʉgo ky'iLikia. <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />Omʉkʉlʉ w'abashirikani mweya mo muyi oyo mo bwatho bʉgʉma. Obwatho obo, bwabyaga bw'omo muyi w'iAlesanduria bo bwagenda obʉya mo kɨhʉgo ky'iItalia. Mwathushambya mʉbo.<verse eid="ACT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 27:7" />Mothwamala bɨro bɨngɨ nɨothʉgenda hake-hake, na mothwahika emʉsɨke w'omuyi w'iKinito nɨthwamanʉba kʉtsɨbʉ. Kʉshangwa embeho yagenda eyɨthʉkɨkɨra ɨya hale mo nzɨra eyo, mothwalengera iSalimone ko mʉnda w'ekɨtsɨra ky'ɨKɨrete. <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />Mothwalotsya ebʉshondotsɨ mo lʉgendo lwa malɨgo mangɨ, thwagenda othʉtsʉka emʉsɨke-mʉsɨke w'engetsɨ. Honyuma kw'aho, mothwahika handʉ hagʉma ho hanahʉlwamo «Byambʉ Bɨbʉya», hofɨ n'omuyi w'iLaseya.<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />Thwabere thwamamala bɨro bɨngɨ mo lʉgendo olo, mothwahika mo bɨro bɨtsɨbʉ by'erɨgenda mo ngetsɨ. Na kuthyo kʉshangwa ekɨro <char style="w" lemma="Iyima kalyo">ky'eriyima akalyo</char> kyabyaga nɨkyamatsʉka, aho Polo mwaha abagendya b'obwatho bo ihano athɨ: <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />«Balikyethu, nyamalola ko lʉgendo olu ko lwabya lwa mɨnʉbo na bubihya bʉngɨ, byo byaleka obwatho n'emɨtsɨgo nɨbyafwa bʉsha. Nethwe kuthyo thwanganahetsya n'obʉyɨngo bwethʉ.»<verse eid="ACT 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 27:11" />Erihano lya Polo eryo, omʉkʉlʉ w'abashirikani mwathɨndalyo, na mwakwama emɨganɨtsye y'omugendya w'obwatho na y'omwenye obwatho. <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />Na kuthyo ko kyambʉ ekyo hathabyaga handʉ habʉya ho bandʉ bangikere mo bɨro by'embeho nzɨbʉ. Bʉshana n'ekyo, bandʉ bangɨ mw'ithwe mobahʉlɨkɨrɨrana bathɨ thʉthoke ko lʉnda olo, kʉshangwa byamathokekana thuhike iFoiniki, bʉshana thutsukye ebɨro by'embeho nzɨbʉ by'eyo. Foiniki nɨ kyambʉ kɨgʉma kyo kɨrɨ ko kɨtsɨra ky'ɨKɨrete. Ekyambʉ ekyo kilolire ko mʉnda w'obʉlengera ɨtsʉba.<verse eid="ACT 27:12" /></para>
  <para style="s">Erɨhʉnga ko ngetsɨ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />Honyuma kw'aho mokwahʉlʉka mʉyaga ko mʉnda kihya. Abenye obwatho mobaganɨtsya bathɨ balotsya ebʉshondotsɨ mo lʉgendo lwabo nga ko babyaga bathegekenie. Bʉshana n'ekyo mobirukya enanga. Thwabere thwathoka aho, mothwatsʉka emʉsɨke-mʉsɨke w'engetsɨ hofɨ n'ekɨtsɨra ky'ɨKɨrete. <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />Hewethuwe kwabere kwahwa ndambi nge, mo bɨthwa by'ekɨtsɨra ekyo momwahʉlʉka kɨhʉnga, ekɨhʉnga ekyo kyahʉlʉkaga ko mʉnda lʉgʉlʉ. <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />Ekɨhʉnga ekyo mokyakuna obwatho obo, nabo mobuthakotsya ɨsɨndana nakyo. Mothwalika obwatho bʉthʉheke eyo bushashire ko ngetsɨ. <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />Mothwatsʉka ko mʉnda kihya w'ekɨtsɨra kɨke kyo kyagenda ekyahʉlwamo Kauta. Ekɨtsɨra ekyo mokyathuwathikya hake kw'ɨhʉnga eryo. Hewethuwe mothwagalwa kʉtsɨbʉ thʉlɨ othutheya akatho ko kanakʉrwa n'obwatho. <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />Abakoli b'omo bwatho babere bamamala ishambya akatho ako k'omo bwatho, mobathimbya kʉbo ko miriki bʉshana bʉthaberekaga. Kandɨ bagenda abʉbaha bathɨ obwatho obo bʉthahathɨraga ko kɨthʉmo ky'omʉshege owabyaga ko mʉnda w'iSiriti mo kɨhʉgo ky'iLibia, mobakimya enanga yo yinimania obwatho, aho mobalikabo bʉhekwe n'ekɨhʉnga.<verse eid="ACT 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 27:18" />Ekɨhʉnga mokyagenda ekikuna-kuna obwatho bo kʉtsɨbʉ. Bwabere bwakya mobathanga ɨgʉshanga emɨtsɨgo mo ngetsɨ. <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />Mo kɨro kya kashathʉ, ebɨndʉ bagenda abakolesa mo bwatho mobahika ko kɨka ky'erɨgʉshangabyo mo ngetsɨ ɨbo bene-bene. <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />Mokwatsʉka bɨro bɨngɨ bʉthashʉba shʉnga kw'ɨtsʉba kʉtse ngununu. Ekɨhʉnga ekyo, mokyabya kɨngɨ kʉtsɨbʉ. Aho amaha w'erɨshabʉlwa mwahwa.<verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />Abandʉ babyaga nɨbamamala bɨro bɨngɨ buthalya. Aho Polo mwimana mo kathi kabo n'ɨbwɨrabo athɨ: «Ee balikyethu! Mwangakwamire erihano lyaye nyabahaga nyɨthɨ thʉthathokaga ɨKɨrete, muthangalolire ko malɨgo woshi aya n'ɨhetsya ebɨndʉ ebi. <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />Aho enyɨbashaba mushikye emɨthɨma, kʉshangwa hathalɨ mʉndʉ n'omʉgʉma wa kw'imwe yo wafwa hewethuwe obwatho bo bwene bo bwabɨha. <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />Nyamanegena ebyo kʉshangwa ingye nyɨrɨ mukoli wa Gongo, na kandɨ nɨ ɨye yo nyɨnagenda enyiramya. Na mo kɨro kya munobwire <char style="w">malaɨka</char> mʉgʉma wa Gongo mwanyɨhʉlʉkɨra, <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />na mwanyɨbwɨra athɨ: “Ee Polo, ʉthʉbahaga, kʉshangwa lɨtholere nɨwayathonda embere sa <char style="w">Kaisari</char>. Na kandɨ, ʉmɨnye ko Gongo mo lʉkogo lʉwe kw'ɨwe, ashabʉla abandʉ boshi ʉlɨ nabo aba mo lʉgendo lwenyu olo.” <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />Bira baye, bʉshana n'ekyo mushikye emɨthɨma, kʉshangwa ebyo Gongo athanyɨbwɨra, nyɨkɨrɨtsye ko byabererera. <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />Na mo bɨne bithyo, lɨtholere obwatho nɨbwathʉgʉsha kʉ kɨtsɨra kɨgʉma.»<verse eid="ACT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />Mothwamala bɨro ikumi na bɨne ekɨhʉnga kɨnalɨ ekɨthʉthwala eyi n'eyi mo ngetsɨ y'iAtiria. Mo kathi k'ekɨro ky'erikumi n'ebɨne, abakoli b'omo bwatho mobaganɨtsya bathɨ thwamahika hofɨ n'ekyambʉ. <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />Aho, mobakimya omʉpondo bamɨnye obʉle bw'ametsi, mobashʉnga ko erihika ko mʉshege nɨhakɨnalɨ metere makumi ashathʉ na sɨrɨnda. Babere bayɨfʉnda embere hake, mobashʉba kimya omʉpondo, mobashʉnga nɨhakɨnalɨ metere makumi abɨrɨ na mʉnanɨ erihika ko mʉshege. <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />Mobʉbaha bathɨ obwatho bwahathɨra mo mabwe. Mobakimya nanga ine s'enyuma y'obwatho so sinimaniabo, mw'ɨrɨnda bukye tsʉba. <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />Hewethuwe abakoli b'omo bwatho mobashondya ko bangaromboka, mobakimitsya akatho k'omo metsi nɨabayɨhambʉlɨtsya bathɨ abayakimya eso nanga s'embere y'obwatho. <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />Aho Polo mwabwɨra omʉkʉlʉ w'abashirikani hagʉma n'abashirikani bʉwe athɨ: «Abayira aba bamathoka mo bwatho bʉno, mʉmɨnye ko nemwe nɨmʉthɨshabʉlwe!» <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />Abashirikani babere bonvwa ebyo mobatsitsanga emiriki yabyaga iminire akatho ako n'irikako kathogere mo ngetsɨ.<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />Bwabere bwashondya ikya, Polo mwabwɨra abandʉ boshi athɨ balye akalyo. Mwanegena athɨ: «Mwamamala mayenga abɨrɨ ano munobwire buthalya kiro na kɨndʉ. <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />Aho enyɨbashaba mulye kalyo, kʉshangwa ko kabawathikya mʉthafwaga. Hewethuwe mʉmɨnye kwenene ko hathalɨ kiro na mʉgʉma mo kathi kenyu yo wahetsya n'olʉtswɨrɨ n'olʉgʉma ko muthwe ʉwe.» <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />Polo abere amamala ɨnegena ebyo, mwatsɨmba omukati, mwasɨma Gongo embere s'aboshi. Honyuma kw'aho mwatsitsangawo na mwathanga irya. <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />Bʉshana n'ekyo, abandʉ boshi mobashʉba shika mɨthɨma nabo mobathanga irya. <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />Mo bwatho obo, ithwe boshi hagʉma thwabyagamo bandʉ magana abɨrɨ na makumi alɨnda na ndathʉ. <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />Babere bamala iugutha, mobagʉsha emɨtsɨgo y'engano mo ngetsɨ bʉshana banguhye obwatho.<verse eid="ACT 27:38" /></para>
  <para style="s">Obwatho obʉbereka</para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />Bwabere bwakya, abenye obwatho mobathamɨnya nga balɨ mʉ kɨhʉgo kɨhe. Hewethuwe mobashʉnga handʉ hagʉma ho engetsɨ yingirire ko kɨthaka ho habyaga ekyambʉ. Mobahamʉla bayahathɨtsye obwatho bw'eyo bɨrɨ byangathokekana. <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />Aho mobamɨnʉla emiriki y'esonanga n'ɨthogongetsyatho mo ngetsɨ. Na kuthyo mobamɨnʉla emiriki yo yabyaga iminire ebɨshayɨ byo binagendya obwatho. Honyuma kw'aho mobamɨna etange embere y'obwatho bʉshana ekɨhʉnga kikunirebo ko kyambʉ ekyo. <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />Aho mobahathɨra mo mʉshosho n'ekɨtse kya mbere ky'obwatho mokyayikuna mo mʉshege. Hewethuwe ekɨtse ky'enyuma ɨkyo, mokyaberengeka bʉshana n'emibimbi mɨtsɨbʉ yo yagenda eyiyihumanga kʉkyo.<verse eid="ACT 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42" />Aho abashirikani mobashondya itha abandʉ b'omuliki, bʉshana kuthabyaga n'omʉgʉma yo waromboka alɨ ogera. <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />Hewethuwe omʉkʉlʉ w'abashirikani ɨye mw'ishondya ilamya Polo, mwahangɨra abashirikani abo athɨ bathakolaga ekyo. Bʉshana n'ekyo mwahamʉla athɨ bo betsi eryogera bo babye bambere ɨyɨgʉsha mo metsi bʉshana bashabʉkɨre ko kɨthaka. <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />N'abo bashiba batsɨmbɨrɨre ko bɨtse-bɨtse by'ebɨshayɨ by'obwatho bʉshana biwathikyebo kw'ɨshabʉka. Na bathyo ko aboshi bashabʉkɨraga ko kɨthaka mo bʉholo.<figure style="fig" alt="Le bateau qui amene Paul a Rome est decompose suite au mauvais temps" file="dn00514.jpg" size="col" ref="27:41-44">Obwatho bo bʉthwala Polo y'ɨRoma bwamaberengeka</figure><verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s">Polo ko kɨtsɨra ky'iMelita</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />Thwabere thwamahabʉka, mothwamɨnya ko ekɨtsɨra thwabyagako ko nɨ kyo kyagenda ekyahʉlwamo Melita. <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />Abahimbani ba ko kɨtsɨra ekyo mobathʉkolera bɨbʉya bɨngɨ. Envʉla yabyaga nɨyamathanga ɨwa na kwabyaga mbeho nyɨngɨ. Abandʉ abo mobathʉnoketsya mʉtsanwa na mobathukokya ithwe boshi bathɨ thuhike thwothe. <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />Polo mwaya shenya bulo bwa ngwi. Abere agʉsha esongwi so mo mʉtsanwa, bʉshana n'ekyʉka ekɨkwetha mokyahʉlʉka mʉtho na mokyayɨtsɨngɨra ko kʉboko kʉwe. <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />Abahimbani b'ekɨtsɨra ky'iMelita babere bashʉnga ekɨkwetha ekyo ky'iyitsingire ko kʉboko kwa Polo, mobathanga ɨbwɨrana bathɨ: «Ko kwenene omʉndʉ oyu nɨ mwithi. Na mwanamahabʉka ɨthoka mo ngetsɨ, ɨkwamana n'esohi y'ekwenene ya Gongo, olʉholo lʉwe lʉlɨ hofɨ.» <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />Hewethuwe Polo mwakʉngʉthɨra ekɨkwetha ekyo ky'omo mʉtsanwa na mwathafwa kɨndʉ. <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />Abandʉ bagenda abalɨndɨlɨrɨra bathɨ okʉboko kwabimba, kʉtse iyihuma ahishi n'ɨfwa. Babere balɨndɨrɨra ndambi nyɨre, mobamɨnya kw'athafwire kɨndʉ. Aho mobabɨndʉla emɨganɨtsye yabo n'ɨthanga ɨnegena bathɨ Polo nɨ mʉgʉma w'oko bogongo.<note caller="+" style="f"><char style="fr" closed="false">28:6 </char><char style="ft" closed="false">Lingania </char><char style="xt" closed="false"><ref loc="ACT 14:11">Mɨkolano 14:11</ref>.</char></note><figure style="fig" alt="Paul est mordu par une vipere" file="wa03996.jpg" size="col" ref="28:3-5">Polo abʉlɨrwa n'ekɨkwetha</figure><verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />Hofɨ n'aho habyaga mashwa wa mʉkʉlʉ w'ekɨtsɨra ekyo yo wahʉlawamo Pubilio. Pubilio oyo mwathukokya kʉbʉya omwe, mothwamalamo bɨro bɨshathʉ. <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />Ishe wa Pubilio abyaga mo ngɨngo bʉshana na kapururu n'ɨhɨtha mʉsasɨ. Polo mwaya mulungula, mwamʉshabɨra n'imuhirako eminwe, mwamulamya. <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />Bʉshana n'ekyo, abandɨ bakoni babyaga ko kɨtsɨra ekyo mobagenda abahikira Polo nabo mobagenda abalama. <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />Abandʉ mobagenda abathushikya kʉtsɨbʉ. Na thwabere thwashondya ɨgenda mo bwatho, mobathʉha ebyoshi thwabyaga thulayireko mo lʉgendo lwethʉ.<verse eid="ACT 28:10" /></para>
  <para style="s">Polo amahika mo muyi w'ɨRoma</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />Thwabere thwamamala myetsɨ ishathu ko kɨtsɨra ky'iMelita ekyo, mothwagenda mʉ bwatho bʉgʉma bo bwabyaga nibwimene bʉlɨ obʉlɨndɨrɨra omʉgʉlʉ w'embeho nzɨbʉ atsʉke. Obwatho obo bwagenda obʉthoka mo muyi w'iAlesanduria. Ko bwatho obo kwabyaga shoshani ya bogongo bahasha.<note caller="+" style="f"><char style="fr" closed="false">28:11 </char><char style="fq" closed="false">bogongo bahasha: </char><char style="ft" closed="false">Mo kathi kabo mwabyaga Kasitoro na Polikisi. Bogongo bahasha babɨrɨ abo babyaga nibashikibwe kʉtsɨbʉ mo mɨbere ya Baroma. Kuthyo, abandʉ bagenda abagendya amatho babyaga nibayinihirebo omʉgʉlʉ embeho nzɨbʉ yagenda eyɨhʉlʉka mo ngetsɨ.</char></note> <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />Mothwahika mo muyi w'iSirakuse, mothwabyamo bɨro bɨshathʉ. <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />Mw'ɨthoka mo muyi oyo mothwatsʉka emʉsɨke-mʉsɨke w'engetsɨ, na mothwahika mo muyi w'iRengio. Bwabere bwakya ekɨhʉnga kɨthe kɨtsɨbʉ mokyahʉlʉka ko mʉnda kihya mokyathanga ɨkarama. Honyuma kw'aho mothwagenda lʉgendo lwa bɨro bɨbɨrɨ kw'ihika mo muyi w'iPuteoli. <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />Thwabere thwahika mo muyi oyo mothweyamo bagala bethʉ bɨkɨrɨtsya. Mobathʉshaba bathɨ thubye hagʉma nabo yenga ngʉma. Nɨ bathyo ko thwagendaga n'ihika mo muyi <char style="w" lemma="Roma">w'ɨRoma</char>.<verse eid="ACT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 28:15" />Abagala bethʉ bɨkɨrɨtsya b'omo muyi w'ɨRoma babere bonvwa omwatsɨ ethʉ k'othuhika, mobahika ɨthʉlɨndɨrɨra mo kathale k'iApio,<note caller="+" style="f"><char style="fr" closed="false">28:15 </char><char style="ft" closed="false">Ɨthoka iApio ihika ɨRoma habyaga hofɨ bilometere makumi ndathʉ na bɨthano.</char></note> na bangɨ mobagenda ɨyathʉlɨndɨrɨra ko Tiretaberene.<note caller="+" style="f"><char style="fr" closed="false">28:15 </char><char style="fq" closed="false">Tiretaberene </char><char style="ft" closed="false">n'ɨnegena mbʉ manyʉmba ashathʉ w'ikokyamo bageni. Ahandʉ aho habyaga kʉ bilometere makumi athano n'omuyi w'ɨRoma. </char></note> Polo abere ashʉngabo mwasɨma Gongo na mwashʉbafwa muhwa. <verse eid="ACT 28:15" /><verse number="16" style="v" sid="ACT 28:16" />Thwabere thwahika mo muyi <char style="w" lemma="Roma">w'ɨRoma</char>, abakʉlʉ mobatsɨyɨra Polo abye mʉ nyʉmba yɨwe yo wene hagʉma na mushirikani mʉgʉma w'imutheya athangaromboka.<verse eid="ACT 28:16" /></para>
  <para style="s">Polo akangɨrɨtsya eKɨnwa kya Gongo mo muyi w'ɨRoma</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />Honyuma wa bɨro bɨshathʉ, Polo mwabɨrɨkɨra abakʉlʉ <char style="w" lemma="Bayuta">b'aBayuta</char> bo babyaga bikere mo muyi <char style="w" lemma="Roma">w'ɨRoma</char>. Babere bamamala ihindana, Polo mwathanga ɨbwɨrabo athɨ: «Bagala bethʉ, ingye monyamɨnwa ɨYerʉsalemʉ n'ihirwa mo minwe <char style="w" lemma="Roma">y'aBaroma</char>, naho hathalɨ kiro na kɨbɨ kyoshi-kyoshi nyakoleraga ekɨhanda kyethʉ kʉtse ɨhatsya ko mɨbere ya bo thatha-kʉlʉ. <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />aBaroma abo, babere bamamala ɨnyɨthondesa, mobashondya ɨnyɨmɨnʉla, kʉshangwa mobathanyɨshʉngako ekyangaleka nɨnyasoherwa lʉholo. <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />Hewethuwe <char style="w" lemma="Bayuta">aBayuta</char> babere bathɨnda nyɨmɨnʉlwe, ko nyashabaga nyithyo nyɨyathondere kʉno Roma embere sa <char style="w">Kaisari</char>. Na mo byoshi ebyo, nyithabyaga na maha woshi-woshi w'isitaka ekɨhanda kyaye. <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />Nɨ bʉshana n'ekyo monyɨbabɨrɨkɨra thʉshʉngane na nyɨsɨmole nemwe. Mʉmɨnye kundu ko nyiminirwe mo mahʉlʉla ano bʉshana n'amaha wo <char style="w" lemma="Isiraeli">aBaisiraeli</char> balɨ nawo.»<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />Abakʉlʉ abo mobamʉshʉbɨtsya bathɨ: «Thuthetsi thwabona marʉba woshi-woshi wathathoka iYuteya w'anegenire bʉshana nawe. Kuthyo hathalɨ mʉgala ethʉ Muyuta yo uthahika hano n'ɨthʉfʉlɨra mwatsɨ kʉtse ɨkʉnegenako kɨbɨ. <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />Hewethuwe othushondya ɨyonvwɨra emɨganɨtsye awe, kʉshangwa thwetsi ko ekɨsomo eki ekɨthɨndwa ahoshi n'abandʉ.»<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />Aho mobalagana ekɨro kyo bandashʉba hindana na Polo. N'ekɨro ekyo kyabere kyahika, bandʉ bangɨ mobahika mo nyʉmba abyaga ikeremo. Ɨthanga mo makerakera ihika mw'igolo, Polo agenda afʉlɨrabo omwatsɨ <char style="w" lemma="Bwamɨ bwa Gongo">w'oBwamɨ bwa Gongo</char>, n'ɨkangɨrɨtsyabo mw'ɨtsʉkɨra mo <char style="w">Mʉgomba</char> wa Mʉsa n'ebishakirwe mo bɨtabo <char style="w" lemma="Mʉmɨnyeretsɨ">by'abamɨnyeretsɨ</char>, kʉshangwa agenda iuhyabo bɨkɨrɨtsye Yesʉ. <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />Ebɨnwa Polo anegenaga, bagʉma ba mʉbo mobatsɨgabyo, hewethuwe abandɨ ɨbo mobathɨkɨrɨtsyabyo. <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />aBayuta abo babere bagenda bʉthahʉlɨkɨrɨrana, Polo mwashʉba bwɨrabo kɨno athɨ: «<char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> abyaga niayitsye abere abwɨra bo sho-kʉlʉ mw'ɨtsʉkɨra mo <char style="w" lemma="Mʉmɨnyeretsɨ">mʉmɨnyeretsɨ</char> Isaya athɨ:<verse eid="ACT 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 28:26" />“Ʉyabwɨre abandʉ aba ʉthɨ:</para>
  <para style="q1" vid="ACT 28:26">‘Erɨonvwa mwandagenda omwonvwa,</para>
  <para style="q1" vid="ACT 28:26">hewethuwe mʉthɨndagende omʉmɨnya.</para>
  <para style="q1" vid="ACT 28:26">Erɨlola mwandagenda omʉlola,</para>
  <para style="q1" vid="ACT 28:26">hewethuwe mʉthɨndagende omʉshʉnga.’<verse eid="ACT 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27" />Kʉshangwa abandʉ aba bamayɨra emɨthɨma mɨtsɨbʉ,</para>
  <para style="q1" vid="ACT 28:27">bamatsɨba amathwi wabo,</para>
  <para style="q1" vid="ACT 28:27">bamatsɨba n'amesho wabo.</para>
  <para style="q1" vid="ACT 28:27">Bɨrɨ bɨthangabere bithyo, amesho wabo angagendire alola,</para>
  <para style="q1" vid="ACT 28:27">n'amathwi wabo angagendire onvwa,</para>
  <para style="q1" vid="ACT 28:27">n'emɨthɨma yabo yangagendire eyɨmɨnya,</para>
  <para style="q1" vid="ACT 28:27">na banganyibindukire, nangye nyangalamitsyebo.<note caller="+" style="f"><char style="fr" closed="false">28:26-27 </char><char style="xt" closed="false">Soma <ref loc="ISA 6:9-10">Isaya 6:9-10</ref>.</char></note>”»<verse eid="ACT 28:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="ACT 28:28" />Polo mwashʉba bwɨrabo athɨ: «Ewo mʉmɨnye ko Gongo amathʉma omwatsɨ w'obushabuli ono ko bandʉ b'ebɨhanda. N'abandʉ abo ɨbo bonvwawo!<note caller="+" style="f"><char style="fr" closed="false">28:28 </char><char style="xt" closed="false">Soma <ref loc="LUK 3:6">Luka 3:6</ref>.</char></note>»<verse eid="ACT 28:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 28:29" />[Polo abere amamala ɨnegena ebɨnwa ebyo, aBayuta mobagenda niabakubisania kʉtsɨbʉ ɨbo kw'ɨbo.<note caller="+" style="f"><char style="fr" closed="false">28:29 </char><char style="ft" closed="false">Omʉlondo ono athalɨ mʉ wandɨ mashako magʉma wa kera.</char></note>]<verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />Polo mwikala mo nyʉmba akondesaya mo myaka ibiri. Mwagenda akokyamo abandʉ boshi bo bagenda abahika ɨmʉlolako. <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />Agenda afʉla engʉlʉ <char style="w" lemma="Bwamɨ bwa Gongo">y'oBwamɨ bwa Gongo</char> n'ɨkangɨrɨtsya omwatsɨ wa Nyinya-kowethʉ Yesʉ <char style="w" lemma="Kirisito, Masia">Kirisito</char>, na bʉtsɨra bʉba n'obwiranda boshi.<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>