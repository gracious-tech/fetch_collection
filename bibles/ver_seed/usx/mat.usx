<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- KOBO BIBLE TRANSLATION</book>
  <para style="h">Matayo</para>
  <para style="toc3">Mat</para>
  <para style="toc2">Matayo</para>
  <para style="toc1">eNgʉlʉ Mbʉya ya Yesʉ Kirisito nga ko yashakawa na Matayo</para>
  <para style="mt2">eNgʉlʉ Mbʉya ya Yesʉ Kirisito nga ko yashakawa na</para>
  <para style="mt1">Matayo</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Ekithunga kya Yesʉ</para>
  <para style="r">(<ref loc="LUK 3:23-38">Luk 3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Kɨno kyo kithunga kya Yesʉ <char style="w" lemma="Kirisito, Masia">Kirisito</char>. Yesʉ Kirisito abyaga w'omo kithunga kya Tawiti. Tawiti naye abyaga w'omo kithunga kya Abʉrahamʉ.<verse eid="MAT 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MAT 1:2" />Abʉrahamʉ mwabʉtha Isaka,</para>
  <para style="q2" vid="MAT 1:2">na Isaka mwabʉtha Yakobo,</para>
  <para style="q2" vid="MAT 1:2">na Yakobo mwabʉtha Yuta na bagala babo.<verse eid="MAT 1:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="MAT 1:3" />Yuta mwabʉtha Peresi bana Sera kʉ Tamari,</para>
  <para style="q2" vid="MAT 1:3">na Peresi mwabʉtha Isironi,</para>
  <para style="q2" vid="MAT 1:3">na Isironi mwabʉtha Aramu,<verse eid="MAT 1:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="MAT 1:4" />na Aramu mwabʉtha Amɨnatabʉ,</para>
  <para style="q2" vid="MAT 1:4">na Amɨnatabʉ mwabʉtha Nasoni,</para>
  <para style="q2" vid="MAT 1:4">na Nasoni mwabʉtha Salimoni,<verse eid="MAT 1:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="MAT 1:5" />na Salimoni mwabʉtha kʉ Rahabu ko Boasi,</para>
  <para style="q2" vid="MAT 1:5">na Boasi mwabʉtha kʉ Ruti ko Obeti,</para>
  <para style="q2" vid="MAT 1:5">na Obeti mwabʉtha Yese,<verse eid="MAT 1:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="MAT 1:6" />na Yese mwabʉtha omwamɨ Tawiti,</para>
  <para style="q2" vid="MAT 1:6">na Tawiti mwabʉtha Solomona kʉ mʉka Uria,<verse eid="MAT 1:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="MAT 1:7" />Solomona mwabʉtha Roboamʉ,</para>
  <para style="q2" vid="MAT 1:7">na Roboamʉ mwabʉtha Abia,</para>
  <para style="q2" vid="MAT 1:7">na Abia mwabʉtha Asa,<verse eid="MAT 1:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="MAT 1:8" />na Asa mwabʉtha Yosafati,</para>
  <para style="q2" vid="MAT 1:8">na Yosafati mwabʉtha Yoramu,</para>
  <para style="q2" vid="MAT 1:8">na Yoramu mwabʉtha Usia, <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Usia mwabʉtha Yotama,</para>
  <para style="q2" vid="MAT 1:9">na Yotama mwabʉtha Ahasi,</para>
  <para style="q2" vid="MAT 1:9">na Ahasi mwabʉtha Hesekia,<verse eid="MAT 1:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="MAT 1:10" />na Hesekia mwabʉtha Manasɨ,</para>
  <para style="q2" vid="MAT 1:10">na Manasɨ mwabʉtha Amoni,</para>
  <para style="q2" vid="MAT 1:10">na Amoni mwabʉtha Yosia,<verse eid="MAT 1:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="MAT 1:11" />na Yosia mwabʉtha Yekonia</para>
  <para style="q2" vid="MAT 1:11">na bagala babo, mo mʉgʉlʉ aBaisiraeli bathwalawa <char style="w" lemma="Babeli">iBabeli</char>.<verse eid="MAT 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 1:12" />Na honyuma w'erɨthwalwa iBabeli,</para>
  <para style="q2" vid="MAT 1:12">Yekonia mwabʉtha Salatiere,</para>
  <para style="q2" vid="MAT 1:12">na Salatiere mwabʉtha Serubabeli,<verse eid="MAT 1:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="MAT 1:13" />na Serubabeli mwabʉtha Abihuti,</para>
  <para style="q2" vid="MAT 1:13">na Abihuti mwabʉtha Eliakimu,</para>
  <para style="q2" vid="MAT 1:13">na Eliakimu mwabʉtha Asora,<verse eid="MAT 1:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="MAT 1:14" />na Asora mwabʉtha Satoke,</para>
  <para style="q2" vid="MAT 1:14">na Satoke mwabʉtha Akimu,</para>
  <para style="q2" vid="MAT 1:14">na Akimu mwabʉtha Elihuti,<verse eid="MAT 1:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="MAT 1:15" />na Elihuti mwabʉtha Eliasari,</para>
  <para style="q2" vid="MAT 1:15">na Eliasari mwabʉtha Matani,</para>
  <para style="q2" vid="MAT 1:15">na Matani mwabʉtha Yakobo,<verse eid="MAT 1:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="MAT 1:16" />na Yakobo mwabʉtha Yosefʉ iba wa Marɨa.</para>
  <para style="q2" vid="MAT 1:16">Marɨa oyo, yo wabʉthaga Yesʉ yo ʉnahʉlwamo <char style="w" lemma="Kirisito, Masia">Kirisito</char>.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Aho, emɨganzo y'esongero soshi ɨthanga kʉ Abʉrahamʉ ihika kʉ Tawiti nɨ ngero ikumi n'ine, n'erɨthanga kʉ Tawiti ihika kw'ɨthwalwa ly'aBaisiraeli iBabeli nɨ ngero ikumi n'ine, n'erɨthanga kw'ɨthwalwa ly'aBaisiraeli iBabeli ihika kʉ <char style="w" lemma="Kirisito, Masia">Kirisito</char> nɨ ngero ikumi n'ine.<verse eid="MAT 1:17" /></para>
  <para style="s">Erɨbʉthwa lya Yesʉ Kirisito</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Erɨbʉthwa lya Yesʉ <char style="w" lemma="Kirisito, Masia">Kirisito</char> lithya ko lyabyaga. Marɨa nyinya ʉwe agenda athahibwa na Yosefʉ, hewethuwe embere bikale hagʉma, mwayeya nɨ mʉkʉle ko kagala <char style="w" lemma="Mʉthɨma Mwerʉ">k'oMʉthɨma Mwerʉ</char>. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Yosefʉ yo wagendaga athahya Marɨa abyaga mʉndʉ mʉthʉnganene. Mwathashondya imwitha shoni embere s'abandʉ, mwahamʉla imulika mʉ bubisho-bisho. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />Abere anemʉganɨtsya kw'ebyo, <char style="w" lemma="malaɨka">malaɨka</char> wa <char style="w" lemma="Nyɨnya-kowethʉ">Nyinya-kowethʉ</char> mwamʉhʉlʉkɨra mo bɨlotho n'ɨmʉbwɨra athɨ: «Yosefʉ mʉgala wa Tawiti, ʉthʉbahaga ihikya mʉkatsɨ awe Marɨa, kʉshangwa obʉkʉle bʉwe nɨ bwa maka <char style="w" lemma="Mʉthɨma Mwerʉ">w'oMʉthɨma Mwerʉ</char>. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Naye andabʉtha mwana wa bʉtsana, nawe wandamʉlʉkamo Yesʉ, kʉshangwa nɨ ɨye yo andashabʉla abandʉ bʉwe ɨthoka mo bɨtsɨbʉ byabo.» <verse eid="MAT 1:21" /><verse number="22" style="v" sid="MAT 1:22" />Ebyoshi ebyo mobyahʉlʉka bʉshana kɨbererere ekɨnwa Nyinya-kowethʉ anegenaga mw'ɨtsʉkɨra <char style="w" lemma="mʉmɨnyeretsɨ">omʉmɨnyeretsɨ</char> athɨ:<verse eid="MAT 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="MAT 1:23" />«Mwonvwe, omʉnyere andaheka bʉkʉle, andabʉtha mwana wa bʉtsana,</para>
  <para style="q1" vid="MAT 1:23">yo wandalʉkwamo Manʉere.»</para>
  <para style="m" vid="MAT 1:23">Manʉere n'ɨnegena mbʉ: «Gongo alɨ hagʉma nethwe.»<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Na Yosefʉ abere abʉka, mwakola nga ko <char style="w" lemma="Malaɨka">malaɨka</char> wa Nyinya-kowethʉ amʉhamʉlaga, na mwahikya Marɨa. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Hewethuwe mwathaonzera naye ihika ko kɨro abʉthaga omwana ʉwe w'obʉtsana, yo Yosefʉ alʉkagamo Yesʉ.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Abengenge abayashʉnga Yesʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Yesʉ mwabʉthɨrwa ɨBetelehemʉ, mo kɨhʉgo ky'iYuteya mo mʉgʉlʉ <char style="w" lemma="Herote">Herote</char> abyaga mwamɨ. Honyuma w'erɨbʉthwa lɨwe abengenge<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">Abengenge bo abahʉlwa hano, nɨ bandʉ bo ban'ɨga byo birebitsye esongununu.</char></note> mobathoka ebʉbʉkɨra ɨtsʉba, mobahika ɨYerʉsalemʉ. <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />Mobabʉtsya bathɨ: «Alɨ hayi omwamɨ w'aBayuta yo wamabʉthwa? Kʉshangwa mothʉshʉnga engununu yɨwe y'ebʉbʉkɨra ɨtsʉba. Bʉshana n'ekyo, nethwe thwamahika imuramya.» <verse eid="MAT 2:2" /><verse number="3" style="v" sid="MAT 2:3" />Omwamɨ <char style="w" lemma="Herote">Herote</char> abere onvwa omwatsɨ oyo, mwathabagana, n'abandʉ boshi b'ɨYerʉsalemʉ nabo kuthyo mobathabagana. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Aho mwabɨrɨkɨra <char style="w" lemma="abakʉlʉ boshi b'abaheri">abakʉlʉ boshi b'abaheri</char> <char style="w" lemma="n'abakangɨtsya b'oMʉgomba">n'abakangɨrɨtsya b'oMʉgomba</char>, n'ɨbʉtsyabo nga <char style="w" lemma="Kirisito">Kirisito</char> angabuthirwe hayi. <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Nabo mobamʉshʉbɨtsya bathɨ: «ɨBetelehemʉ y'omo kɨhʉgo ky'iYuteya. Kʉshangwa kuthyo ko byashakawa n' <char style="w" lemma="Mʉmɨnyeretsɨ">omʉmɨnyeretsɨ</char> kʉthɨ:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />“Ɨwe Betelehemʉ, mo kɨhʉgo ky'iYuteya,</para>
  <para style="q1" vid="MAT 2:6">ʉthalɨ wo mʉke mo miyi mɨkʉlʉ y'omo kɨhʉgo ky'iYuteya,</para>
  <para style="q1" vid="MAT 2:6">kʉshangwa nɨ mw'ɨwe mo mwandathoka omuthegeki</para>
  <para style="q1" vid="MAT 2:6">yo wandashondola abandʉ baye, <char style="w" lemma="isiraeli">Baisiraeli</char>.”»<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Aho ye <char style="w">Herote</char> mwabɨrɨkɨra abengenge mʉ bubisho-bisho n'ɨbʉlɨrɨtsyabo ng'engununu yahʉlʉkaga kʉ mʉgʉlʉ ohɨ. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Honyuma kw'aho mwathʉmabo ɨBetelehemʉ n'ɨbwɨrabo athɨ: «Mʉyabʉlɨrɨtsye kʉbʉya emyatsɨ y'omwana, na mwabya mwamʉshʉnga, nɨmwanyɨbwɨra bʉshana nangye nyiyamuramye.»<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Abengenge babere bamamala ɨonvwa ebɨnwa by'omwamɨ Herote, mobagenda. Aho mobashʉba shʉnga engununu yo bashʉngaga ebʉbʉkɨra ɨtsʉba, moyashondolerabo, moyimana mo kyanya, elʉgʉlʉ y'aho omwana abyaga. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Babere bashʉnga engununu eyo mobamoga kʉtsɨbʉ. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Mobɨngɨra mo nyʉmba, mobashʉnga omwana hagʉma na Marɨa nyinya ʉwe. Mobafʉkama bʉshana n'imuramya. Honyuma kw'aho, mobakanʉla emɨtsɨgo yabo na mobamʉha bɨhembo bya horo, na bya bubani, na bya marasi. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Honyuma kw'aho Gongo mwabwɨrabo mo bɨlotho ko bathashʉbaga ew'omwamɨ <char style="w" lemma="Herote">Herote</char>. Aho mobashʉba mo kɨhʉgo kyabo mw'ɨtsʉkɨra mʉ ɨndɨ nzɨra.<verse eid="MAT 2:12" /></para>
  <para style="s">Yosefʉ ashayɨra iMisiri</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Abengenge babere bamagenda, <char style="w" lemma="malaɨka">malaɨka</char> wa Nyinya-kowethʉ mwahʉlʉkɨra Yosefʉ mo bɨlotho n'ɨmʉbwɨra athɨ: «Bathʉka, tsɨmba omwana na nyinya ʉwe na mʉshayɨre iMisiri. Ubye eyo ihika ko kɨro nyandakʉbwɨra nyɨthɨ ʉshʉbʉle, kʉshangwa <char style="w">Herote</char> ashondya omwana bʉshana amwithe.» <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Yosefʉ mwimana n'ɨtsɨmba omwana na nyinya ʉwe, na mo kɨro kɨsha-kɨsha mobashayɨra iMisiri <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />Mwabyayo ihika ko mʉgʉlʉ <char style="w" lemma="Herote">Herote</char> afwaga. Ebyo mobyabya bʉshana bɨbererere ebyo Nyinya-kowethʉ anegenaga kw'ɨtsʉkɨra <char style="w" lemma="mʉmɨnyeretsɨ">omʉmɨnyeretsɨ</char> athɨ: «Monyabɨrɨkɨra mʉgala aye athoke iMisiri.»<note caller="+" style="f"><char style="fr" closed="false">2:14-15 </char><char style="ft" closed="false">Soma Osea 11:1.</char></note><verse eid="MAT 2:15" /></para>
  <para style="s">Ithwa ly'abana ɨBetelehemʉ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />
    <char style="w">Herote</char> abere amɨnya abengenge ko mobamʉthɨma, mwakapɨkɨra kʉtsɨbʉ. Aho, Herote mwathʉma abashirikani mo muyi w'ɨBetelehemʉ na mo ndambɨ-ndambɨ sawo bayithe abana b'obʉtsana boshi ɨthoka kw'ɨbʉthwa ihika kʉ myaka ibiri. Akolaga athyo ɨkwamana n'ebɨro abengenge bamʉbwɨraga. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Aho mobyabererera ebyo byanegenawa mw'ɨtsʉkɨra <char style="w" lemma="Mʉmɨnyeretsɨ">omʉmɨnyeretsɨ</char> Yeremia athɨ:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />«Omʉlenge wa bɨrɨro n'ishishikana ɨtsɨbʉ, mobyonvwɨka ɨRama.</para>
  <para style="q1" vid="MAT 2:18">Nɨ Rakeli yo ʉlɨrɨra abana bʉwe,</para>
  <para style="q1" vid="MAT 2:18">athalɨ ashondya ikiranibwa,</para>
  <para style="q1" vid="MAT 2:18">kʉshangwa abana bʉwe bamalire ɨfwa.»<note caller="+" style="f"><char style="fr" closed="false">2:17-18 </char><char style="ft" closed="false">Yeremia 31:15.</char></note><verse eid="MAT 2:18" /></para>
  <para style="s">Yosefʉ ashʉbʉla ɨthoka iMisiri</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Honyuma w'olʉholo lwa <char style="w">Herote</char>, <char style="w" lemma="malaɨka">malaɨka</char> wa Nyinya-kowethʉ mwahʉlʉkɨra Yosefʉ mo bɨlotho iMisiri. <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />Mwamʉbwɨra athɨ: «Bathʉka, tsɨmba omwana na nyinya ʉwe ʉshʉbe mo kɨhʉgo <char style="w" lemma="Isiraeli">ky'Isiraeli</char>, kʉshangwa abandʉ bo babyaga niabashondya itha omwana bamalire ɨfwa.» <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />Aho Yosefʉ mwimana, mwatsɨmba omwana na nyinya ʉwe, n'ɨshʉba mo kɨhʉgo <char style="w" lemma="Isiraeli">ky'Isiraeli</char>. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Hewethuwe Yosefʉ abere onvwa ko Arikelao<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false">Arikelao abyaga mʉgala wa Herote na kandɨ mwashiba mo kifumbi ky'ishe mʉkʉlʉ, mwathegeka mɨaka ine embere w'erɨbʉthwa lya Yesʉ na mɨaka ndathʉ enyuma y'erɨbʉthwa lya Yesʉ.</char></note> yo ʉthegeka mo mwanya w'ishe ʉwe <char style="w">Herote</char> mo kɨhʉgo ky'iYuteya, aho mwafwa bʉba bw'erɨshʉbayo. Gongo mwabwɨra Yosefʉ mo bɨlotho athɨ athashʉbagayo. Bʉshana n'ekyo, mwaya mo kɨhʉgo ky'iNgalilaya. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />Mwayikala mo muyi w'agenda ahʉlwamo Nasareti. Mobyakoleka bithyo bʉshana kɨbererere ekɨnwa kyanegenawa kʉ Yesʉ ɨtsʉkɨra <char style="w" lemma="Mʉmɨnyeretsɨ">abamɨnyeretsɨ</char> kɨthɨ: «Andahʉlwamo Munyanasareti.<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="fq" closed="false">Andahʉlwamo Munyanasareti</char><char style="ft" closed="false">: Erɨtsɨna eryo molyabya nga mʉthɨ wa lyamɨ bʉshana na Yesʉ (lingania Mat 21:11) na kandɨ yabyaga kw'ikangania abakirisito bambere (Mɨkolo 24:5).</char></note>»<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">Amakangɨrɨtsya wa Yoani Mubatisya</para>
  <para style="r">(<ref loc="MRK 1:1-8">Mar 1:1-8</ref>; <ref loc="LUK 3:1-18">Luk 3:1-18</ref>; <ref loc="JHN 1:19-28">Yoa 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Mo bɨro ebyo Yoani <char style="w" lemma="Lubatiso">Mubatisya</char> mwahʉlʉka mo <char style="w">mbwarara</char> y'iYuteya n'ɨthanga ɨfʉla mwatsɨ athɨ: <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />«Mʉbɨndʉke ɨthoka mo bɨtsɨbʉ byenyu, kʉshangwa oBwamɨ bw'elʉbʉla bʉlɨ hofɨ!» <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Yoani oyo yo wahʉlawa na Gongo ɨtsʉkɨra <char style="w" lemma="Mulaguli wa Gongo">omʉmɨnyeretsɨ</char> Isaya abere alɨanegena athɨ:</para>
  <para style="q1" vid="MAT 3:3">«Mʉndʉ mʉgʉma ahambala mo <char style="w" lemma="mbwarara">mbwarara</char> athɨ:</para>
  <para style="q1" vid="MAT 3:3">“Muthungananie enzɨra ya Nyinya-kowethʉ,</para>
  <para style="q1" vid="MAT 3:3">mukomye aho atsʉka.”»<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Olʉkɨmba lwa Yoani lwakomibawa mʉ boya bwa ngamɨa, kandɨ abyaga niambithe mʉkaba wa ngobi mo mbɨndɨ.<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">2Bamɨ 1:8.</char></note> Agenda alya emɨʉngʉra n'obʉkɨ bw'omo ndokolo. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Abahimbani b'ɨYerʉsalemʉ, n'abo mo kɨhʉgo kyoshi ky'iYuteya, n'abo mo ndambɨ-ndambɨ y'olwitsi lw'eYorotani bagenda abamuhikira. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Bagenda abayɨshʉbako ko bɨtsɨbʉ byabo, na Yoani agenda abatisyabo mo lwitsi lw'eYorotani.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Yoani mwashʉnga <char style="w" lemma="Bafarisayo:">Bafarisayo</char> bangɨ na <char style="w" lemma="Basandukayo">Basandukayo</char> bangɨ bagenda abamuhikira <char style="w" lemma="Lubatiso">abatisyebo</char>, naye mwabwɨrabo athɨ: «Imwe, lʉbʉtho lwa nzoka! Nɨ ndɨ yo wabakangɨrɨtsaya ishondya ɨshaga esohi ya Gongo yo yɨrɨ hofɨ? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Aho mukanganie mo mɨkolere enyu ko mwamalire ɨbɨndʉka ɨthoka mo bɨtsɨbʉ byenyu. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Na mʉthagenda omʉganɨtsya mʉthɨ mʉhwere ɨyahʉlamo mʉthɨ: “Thʉlɨ bana ba Abʉrahamʉ<note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="ft" closed="false">Lingania na Yoani 8:33,37,39.</char></note>,” kʉshangwa enyɨbabwɨra, amabwe aya Gongo angahulukyamo bana ba Abʉrahamʉ. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Embasha yamalire ɨgosholwa bʉshana n'ɨtsɨra emɨthɨ y'omo mirihi. Na bʉlɨ mʉthɨ w'athahekire biguma bikwire andakondwa n'ɨgʉshwa mo mʉtsanwa. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />Ingye enyibabatisya mo metsi bʉshana n'ikangania ko mwamabɨndʉka ɨthoka mo bɨtsɨbʉ byenyu. He yo uhika enyuma kw'ingye, andababatisya mo <char style="w" lemma="Mʉthɨma Mwerʉ">Mʉthɨma Mwerʉ</char> na mo mʉtsanwa. Ɨye awithe maka mangɨ kw'inyirengya, kandɨ nyɨthatholere na hake ithokya ebɨrato bɨwe. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Aho awithe ko lʉhʉngʉlo<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">Lʉhʉngʉlo nɨ lokwera lo bandʉ abanakolesa kw'ilongya mʉlo mo engano bʉshana n'erithokya mʉro mw'omʉsɨsɨ.</char></note> mo minwe yɨwe, bʉshana n'ilongya engano. Andahira esombulu s'omo mbʉpʉ, hewetuwe and'okya omʉsɨsɨ mo mʉtsanwa ow'athatsɨma.»<verse eid="MAT 3:12" /></para>
  <para style="s">Olubatiso lwa Yesʉ</para>
  <para style="r">(<ref loc="MRK 1:9-11">Mar 1:9-11</ref>; <ref loc="LUK 3:21-22">Luk 3:21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Aho Yesʉ mwathoka mo kɨhʉgo ky'iNgalilaya n'ihika ko lwitsi lw'eYorotani. Mwahikira Yoani bʉshana abatisibwe naye. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Hewethuwe Yoani mwashondya ɨthɨnda, nɨamʉbwɨra athɨ: «N'ingye ngyo nyangabatisibwe nawe, ʉthɨ ko unyihikira ʉthɨ ingye ngyo nyikubatisye?» <verse eid="MAT 3:14" /><verse number="15" style="v" sid="MAT 3:15" />Hewethuwe Yesʉ mwamʉshʉbɨtsya athɨ: «Tsɨga bibye bithyo ko ndambi eno, kʉshangwa ni bathyo ko bɨtholere nɨthwabereretsya ebyoshi by'ekwenene byo Gongo ashabire.» Aho Yoani mwatsɨga. <verse eid="MAT 3:15" /><verse number="16" style="v" sid="MAT 3:16" />Yesʉ abere amamala ibatisibwa, mwathoka mo metsi. Kona ndambi eyo, olʉbʉla molwakɨngʉkala, mwashʉnga <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> wa Gongo mwamukimirako nga kalikuku. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Na mʉlenge mwahʉlʉka mo lʉbʉla n'ɨnegena athɨ: «Oyu nɨ Mʉgala aye mʉtsɨɨrwa yo unanyimoya kʉtsɨbʉ.<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">Soma Isaya 42:1.</char></note>»<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Erɨlengwako lya Yesʉ</para>
  <para style="r">(<ref loc="MRK 1:12-13">Mar 1:12-13</ref>; <ref loc="LUK 4:1-13">Luk 4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Honyuma kw'aho <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> mwathwala Yesʉ mo <char style="w" lemma="mbwarara">mbwarara</char> bʉshana ayalengweko na <char style="w" lemma="Sitani">Sitani</char>. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Abere amamala <char style="w" lemma="Iyima kalyo">iyima akalyo</char> bɨro makumi ane kɨro na mwɨshɨ mwafwa nzala. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Sitani, yo ʉnalenga ko bandʉ, mwayɨfʉnda hofɨ naye n'ɨmʉbwɨra athɨ: «Wamabya ʉlɨ Mʉgala wa Gongo, hamʉla amabwe aya ahɨndʉke mikati.» <verse eid="MAT 4:3" /><verse number="4" style="v" sid="MAT 4:4" />Yesʉ mwashubya athɨ: «Kushakirwe kʉthɨ: “Omʉndʉ athɨndabyeho bʉshana n'emikati mɨsha, he bʉshana n'obʉlɨ kɨnwa kyo kɨthoka mo bʉnʉ bwa Gongo.”<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">Ɨbʉka Mʉgomba 8:3.</char></note>»<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Aho <char style="w" lemma="Sitani">Sitani</char> mwamʉthwala ɨYerʉsalemʉ, omuyi mubuyirire, n'ɨya muhira ko mʉnara <char style="w" lemma="Nyʉmba ya Gongo">w'eNyʉmba ya Gongo</char>, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />n'ɨmʉbwɨra athɨ: «Wamabya ʉlɨ Mʉgala wa Gongo, yɨgʉshe ahishi, kʉshangwa kushakirwe kʉthɨ:</para>
  <para style="q1" vid="MAT 4:6">“Gongo andahamʉla abamalaɨka bʉwe,</para>
  <para style="q1" vid="MAT 4:6">nabo bandakʉheka mo minwe yabo,</para>
  <para style="q1" vid="MAT 4:6">bʉshana ekɨshando kyawe kɨthatsɨkalaga kw'ibwe.”<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">Saburi 91:11-12.</char></note>»<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Yesʉ mwamʉbwɨra athɨ: «Kuthyo, kushakirwe kʉthɨ: “Ʉthalengaga kʉ Nyinya-kowethʉ Gongo wawe.”<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">Ɨbʉka mʉgomba 6:16.</char></note>»<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />
    <char style="w" lemma="Sitani">Sitani</char> mwashʉba mʉthwala ko kɨthwa kɨre-kɨre, n'imukangya amamɨ woshi w'omo kɨhʉgo n'olʉkengerwa lwawo, <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />n'ɨmʉbwɨra athɨ: «Wamafʉkama embere s'aye n'inyiramya, nɨnyakʉha amamɨ woshi aya.» <verse eid="MAT 4:9" /><verse number="10" style="v" sid="MAT 4:10" />Aho Yesʉ mwamʉbwɨra athɨ: «Thoka hano, <char style="w" lemma="Sitani">Sitani</char>! Kushakirwe mo mashako kʉthɨ: “Uramye Nyinya-kowethʉ Gongo wawe na ʉmʉkolere ɨye yowene mʉsha.”<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false">Ɨbʉka mʉgomba 6:13.</char></note>» <verse eid="MAT 4:10" /><verse number="11" style="v" sid="MAT 4:11" />Aho <char style="w" lemma="Sitani">Sitani</char> mwamumika. Aho n'aho <char style="w" lemma="Malaɨka">abamalaɨka</char> mobahika ahalɨ Yesʉ n'ɨthanga imuwathikya.<verse eid="MAT 4:11" /></para>
  <para style="s">Yesʉ athangɨra omʉlɨmo ʉwe iNgalilaya</para>
  <para style="r">(<ref loc="MRK 1:14-15">Mar 1:14-15</ref>; <ref loc="LUK 4:14-15">Luk 4:14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Yesʉ abere onvwa ko Yoani<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="fq" closed="false">Yoani alɨ mo biriso</char><char style="ft" closed="false">Yo wahʉlwa hano nɨ Yoani Mubatisya. Soma 14:3.</char></note> alɨ mo biriso, mwaya iNgalilaya. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Mwathoka iNasareti, mwaya ikala ɨKaperenaʉmʉ, muyi alɨ ko mʉsɨke w'engetsɨ y'iNgalilaya, mo kɨhʉgo kya Sabuluni n'ekya Nafutali.<note caller="+" style="f"><char style="fr" closed="false">4:13</char><char style="fqa" closed="false">Sabuluni n'ekya Nafutali</char><char style="ft" closed="false">: Nɨ bɨhanda bɨbɨrɨ bya kera by'aBaisiraeli bɨrɨ ko mʉnda lʉgʉlʉ w'ekɨhʉgo ky'Isiraeli.</char></note> <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Mwakola athyo bʉshana bɨbererere ebɨnwa ebyo byanegenawa kw'ɨtsʉkɨra <char style="w" lemma="Mʉmɨnyeretsɨ">omʉmɨnyeretsɨ</char> Isaya bɨthɨ:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />«Kɨhʉgo kya Sabuluni na kɨhʉgo kya Nafutali,</para>
  <para style="q1" vid="MAT 4:15">erɨlolera ko ngetsɨ, ko mʉnda ishirya w'olwitsi lw'eYorotani,</para>
  <para style="q1" vid="MAT 4:15">mo kɨhʉgo ky'iNgalilaya, eyo yikere abandʉ b'ebɨhanda!<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Abandʉ bo babyaga bikere mo mwitsimya</para>
  <para style="q1" vid="MAT 4:16">bamashʉnga kyakakala kɨnene!</para>
  <para style="q1" vid="MAT 4:16">Na bo babyaga bikere mo kɨhʉgo ky'omwitsimya mʉnene w'olʉholo,</para>
  <para style="q1" vid="MAT 4:16">ekyakakala kyamahʉlʉkɨrabo!<note caller="+" style="f"><char style="fr" closed="false">4:16 </char><char style="ft" closed="false">Soma Isaya 8:23; 9:1.</char></note>»<verse eid="MAT 4:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 4:17" />Ɨthanga aho, Yesʉ mwathanga ɨkangɨrɨtsya athɨ: «Mʉbɨndʉke ɨthoka mo bɨtsɨbʉ byenyu, kʉshangwa oBwamɨ bw'elʉbʉla bʉlɨ hofɨ!»<verse eid="MAT 4:17" /></para>
  <para style="s">Yesʉ abɨrɨkɨra abɨga bʉwe bambere</para>
  <para style="r">(<ref loc="MRK 1:16-20">Mar 1:16-20</ref>; <ref loc="LUK 5:1-11">Luk 5:1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Yesʉ abere anemʉtsʉka emʉsɨke w'engetsɨ y'iNgalilaya, mwashʉnga bandʉ babɨrɨ ba mʉ nda ngʉma, Simoni yo walʉkawamo Petero, na mʉgalabo nɨ yo Ndereya. Bagenda abagʉsha ehikira hyabo hyo mo ngetsɨ kʉshangwa babyaga barobi. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Yesʉ mwabwɨrabo athɨ: «Mʉnyɨkwame nangye nyabayɨramo barobi ba bandʉ.» <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Aho n'aho mobamika ehikira hyabo n'ɨmʉkwama. <verse eid="MAT 4:20" /><verse number="21" style="v" sid="MAT 4:21" />Mwashʉba lotsya embere, mwashʉnga bandɨ bandʉ babɨrɨ ba mʉ nda ngʉma, Yakobo na Yoani bagala ba Sebetayo. Babyaga mo bwatho na Sebetayo ishe wabo, niabakomya ehikira hyabo. Yesʉ mwabɨrɨkɨrabo. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Aho n'aho mobamika obwatho n'ishe wabo n'ɨmʉkwama.<verse eid="MAT 4:22" /></para>
  <para style="s">Yesʉ akangɨrɨtsya n'ilamya</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Honyuma kw'aho Yesʉ mwathimba mo kɨhʉgo kyoshi ky'iNgalilaya, agenda akangɨrɨtsya mo <char style="w" lemma="Sinakoki">sosinakoki</char> s'aBayuta, alɨ afʉla <char style="w" lemma="Ngʉlʉ Mbʉya">eNgʉlʉ Mbʉya</char> y'oBwamɨ n'ilamya abandʉ bw'amakoni wabo, n'obʉlema bwabo boshi. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Engʉlʉ yɨwe moyahika mo kɨhʉgo kyoshi ky'eSuria. Bagenda abamʉlethera bo babyaga n'amakoni mɨna-mɨna, na bo bagenda abagalwa na magali mɨna-mɨna, abo babyagako emɨtsɨmʉ mɨbɨ, n'abebithutsa, n'abamakonongola. Na Yesʉ mwalamyabo. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Muhindano mʉnene mwamʉkwama, bagenda abahʉlʉka iNgalilaya na mo kɨhʉgo ky'eMiyi iKumi, n'ɨYerʉsalemʉ, na mo kɨhʉgo ky'iYuteya, na ko ʉndɨ mwishirya w'eYorotani.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Amakangɨrɨtsya ko kɨthwa</para>
  <para style="r">(<ref loc="MRK 3:13">Mar 3:13</ref>; <ref loc="LUK 6:12-13">Luk 6:12-13</ref>; <ref loc="LUK 6:20-23">6:20-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Yesʉ abere ashʉnga ko muhindano w'abandʉ, mwɨrʉkɨra ko kɨthwa n'ikala. <char style="w">Abɨga</char> bʉwe mobayɨfʉnda hofɨ naye. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Na mwathanga ɨkangɨrɨtsyabo athɨ:<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />«Bagashanɨrwe abatsene mo mʉthɨma,</para>
  <para style="q1" vid="MAT 5:3">kʉshangwa oBwamɨ bw'elʉbʉla nɨ bwabo!<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Bagashanɨrwe abo abalɨra,</para>
  <para style="q1" vid="MAT 5:4">kʉshangwa Gongo andakiraniabo.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Bagashanɨrwe abalonvʉ,</para>
  <para style="q1" vid="MAT 5:5">kʉshangwa bandahabwa ekɨhʉgo mo mwandʉ.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Bagashanɨrwe abo bawirire n'ɨfwa nyotha y'erɨkola ebɨthʉnganene,</para>
  <para style="q1" vid="MAT 5:6">kʉshangwa Gongo anduguthyabo.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Bagashanɨrwe ab'eshashi,</para>
  <para style="q1" vid="MAT 5:7">kʉshangwa nabo bandashashɨrwa!<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Bagashanɨrwe abo mʉthɨma erire,</para>
  <para style="q1" vid="MAT 5:8">kʉshangwa bandashʉnga Gongo.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Bagashanɨrwe abarongani,</para>
  <para style="q1" vid="MAT 5:9">kʉshangwa bandahʉlwamo bana ba Gongo.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Bagashanɨrwe abo bagalwa bʉshana n'ɨkola ebɨthʉnganene,</para>
  <para style="q1" vid="MAT 5:10">kʉshangwa oBwamɨ bw'elʉbʉla nɨ bwabo.<verse eid="MAT 5:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 5:11" />Mʉgashanɨrwe imwe mo ndambi abandʉ ababahangya, n'ɨbagatsya, n'ɨbahambɨka obʉlɨ bʉbɨ boshi bʉshana nangye. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Mʉmoge na mʉyɨbware kʉshangwa olʉhembo lwenyu lwandabya lʉnene mo lʉbʉla. Ni kuthyo ko banubyaga <char style="w" lemma="Mʉmɨnyeretsɨ">abamɨnyeretsɨ</char> bo babyagaho embere kw'imwe.»<verse eid="MAT 5:12" /></para>
  <para style="s">Omunyu n'ekyakakala by'ekɨhʉgo</para>
  <para style="r">(<ref loc="MRK 9:50">Mar 9:50</ref>; <ref loc="LUK 14:34-35">Luk 14:34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />Imwe mʉlɨ munyu w'ekɨhʉgo. Ewo omunyu amahetsya obʉshɨ bwawo, ni ki kyo kyangakotsya ishubya mʉwo mw'obʉshɨ? Omunyu ow'athakikwirire na hake, nɨ w'erɨgʉshwa embʉga n'ilyathangwa n'abandʉ.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />Mʉlɨ kyakakala ky'ekɨhʉgo. Omuyi owalɨ ko kɨthwa athangabishama. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Na bathalɨ abananokya etara n'ɨshwɨkaro kɨthonga, he eyinahirwa okw'ihango bʉshana ɨkoletsye aboshi bo balɨ mo nyʉmba. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Na kuthyo ekyakakala kyenyu kɨkoletsye embere s'abandʉ, kʉbʉshɨ mw'ɨshʉnga ebɨbʉya omʉkola abandʉ basingye Thatha wenyu yo ʉlɨ mo lʉbʉla.<verse eid="MAT 5:16" /></para>
  <para style="s">Makangɨrɨtsya bʉshana n'oMʉgomba</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />Mʉthagenda omʉganɨtsya mʉthɨ nyahikaga bʉshana n'ithokyaho <char style="w" lemma="Mʉgomba">oMʉgomba</char> wa Mʉsa n'amakangɨrɨtsya <char style="w" lemma="Mʉmɨnyeretsɨ">w'abamɨnyeretsɨ</char>. Nyithahikaga bʉshana n'ithokyabyo, hewethuwe bʉshana n'ɨbereretsyabyo. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Kʉshangwa enyɨbabwɨra kwenene, olʉbʉla n'ekɨhʉgo byandatsʉka, hewethuwe <char style="w" lemma="Mʉgomba">oMʉgomba</char> athɨndathokeko lʉshako n'olʉgʉma kʉtse kʉthɨndathoke kakorotsi n'akagʉma ko byo bishakirwemo ihika kw'ɨbererera ly'ebyoshi. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Na bʉshana n'ekyo, omʉndʉ yo wandathengʉha akake kʉtsɨbʉ k'oko mathegeko, n'ɨkangɨrɨtsya abandɨ bandʉ bathengʉhe ng'ɨye, andahʉlwamo mʉke mo Bwamɨ bw'elʉbʉla. Hewethuwe oyo wandashikya n'ɨkangɨrɨtsyawo abandɨ bashikyewo ng'ɨye, oyo andahʉlwamo mʉkʉlʉ mo Bwamɨ bw'elʉbʉla<note caller="+" style="f"><char style="fr" closed="false">5:19 </char><char style="ft" closed="false">Ɨthoka 20:13; Ɨbʉka Mʉgomba 5:17.</char></note>. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Aho enyɨbabwɨra, mwamabya mʉthalɨ bathʉnganene kʉlenga <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">aBakangɨrɨtsya b'oMʉgomba</char> <char style="w" lemma="Bafarisayo">n'aBafarisayo</char>, mʉthɨndɨngɨre mo Bwamɨ bw'elʉbʉla.<verse eid="MAT 5:20" /></para>
  <para style="s">Makangɨrɨtsya bʉshana n'obʉfwane</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />«Momwonvwa nga ko bo sho-kʉlʉ babwɨrawa mbʉ: “Uthithaga, oyo wanditha atholere ɨsohwa.” <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Hewethuwe ingye enyɨbabwɨra nyɨthɨ, bʉlɨ mʉndʉ yo wandatsɨbʉkɨra mʉgalabo, atholere ɨsohwa. Na yo wandabwɨra mʉgalabo athɨ uthawithe bwenge, atholere ɨsohwa mo <char style="w">bʉshenge bʉkʉlʉ</char>, na yo wandalʉka mʉgalabo mo mʉsɨre, atholere ɨʉshwa mo mʉtsanwa wa okw'ɨrʉnga. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />Aho wamaletha <char style="w" lemma="Bɨhembo">ebɨhembo</char> byawe ko <char style="w" lemma="Bʉtara bw'ɨhererako">bʉtara bw'erɨhererako</char> n'aho wamɨbʉka ko ʉlɨ na kiniga na mʉgala enyu,<figure style="fig" alt="Autel" file="xx" size="col" ref="5:23">Bʉtara bw'ɨhererako</figure> <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />mika <char style="w" lemma="Bɨhembo">ebɨhembo</char> byawe by'embere y'obʉtara na ʉthange ɨyarongana na mʉgala enyu, honyuma kw'aho hika ʉherere Gongo.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />«Kandɨ mʉndʉ amakusitaka, hʉlɨkɨrɨrana naye tsʉba mʉkɨnalɨ mo nzɨra y'etɨrɨbɨnalɨ. Bɨthalɨ bithyo, yo uthakusitaka nɨakʉheretsya omusohi, n'omusohi nɨakʉthwala eyɨrɨ abashirikani, n'abashirikani nɨbakʉgʉsha mo muliki. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Kwenene enyɨkʉbwɨra, ʉthɨndathoke mo muliki omo uthetsi wafʉha esengi nyɨtsɨndʉ-tsɨndʉ.»<verse eid="MAT 5:26" /></para>
  <para style="s">Makangɨrɨtsya bʉshana n'orʉsɨngɨ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />«Momwonvwa ko mokwanegenwa kʉthɨ: Ʉthandasɨngɨra.<note caller="+" style="f"><char style="fr" closed="false">5:27 </char><char style="ft" closed="false">Soma Ɨthoka 20:14; Ɨbʉka Mʉgomba 5:18. </char></note> <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Hewethuwe ingye enyɨbabwɨra nyɨthɨ, obʉlɨ mʉndʉ amayɨthegeretsya mʉkatsɨ n'imushumira nɨamamala ɨsɨngɨra naye mo mʉthɨma ʉwe. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />He elisho lyawe ly'amalyo lyamaleka nɨwakola kɨtsɨbʉ, kʉlalyo na ʉgʉshelyo hale nawe, kʉshangwa bikwirire kɨthambo kɨgʉma ky'oko mʉbɨrɨ awe kɨhere kʉlenga omʉbɨrɨ awe woshi ɨgʉshwa kw'ɨrʉnga. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />N'okʉboko kwawe kw'amalyo kwamaleka nɨwakola kɨtsɨbʉ, tsako na ʉshako hale nawe, kʉshangwa bikwirire kw'ɨwe ɨhetsya ekɨthambo kɨgʉma ky'oko mʉbɨrɨ awe, kʉlenga omʉbɨrɨ awe woshi ɨgʉshwa kw'ɨrʉnga.»<verse eid="MAT 5:30" /></para>
  <para style="s">Makangɨrɨtsya bʉshana n'erɨkamba</para>
  <para style="r">(<ref loc="MAT 19:7-9">Mat 19:7-9</ref>; <ref loc="MRK 10:4-5">Mar 10:4-5</ref>,<ref loc="MRK 10:10-12">10-12</ref>; <ref loc="LUK 16:18">Luk 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />«Na kandɨ mokwanegenwa kʉthɨ: “Yo wamakamba mʉkatsɨwe nɨamʉha marʉba w'erɨkamba.”<note caller="+" style="f"><char style="fr" closed="false">5:31 </char><char style="ft" closed="false">Ɨbʉka Mʉgomba 24:1.</char></note> <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />H'ingye enyɨbabwɨra nyɨthɨ: “Omuyira amakamba mʉkatsɨwe lɨthalɨ bʉshana na rʉsɨngɨ, nɨamamʉyɨramo mʉshɨngɨtsɨ, n'omuyira amahikya yo ʉthakambwa, naye nɨamasɨngɨra.”»<verse eid="MAT 5:32" /></para>
  <para style="s">Makangɨrɨtsya bʉshana n'erɨlahɨtsya</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />Kandɨ momwonvwa ko bo sho-kʉlʉ mobabwɨrwa mbʉ: «Nɨ ʉthalahɨtsya bya mabesɨ, hewethuwe ʉkole nga ko walahɨtsyaga embere ya Nyinya-kowethʉ<note caller="+" style="f"><char style="fr" closed="false">5:33 </char><char style="ft" closed="false">Balawi 19:12; Mɨganzo 30:3; Ɨbʉka Mʉgomba 23:22-24.</char></note>. <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />H'ingye enyɨbabwɨra nyɨthɨ, muthanalinda mwalahɨtsya ibye ko lʉbʉla kʉshangwa kyo kifumbi kya Gongo. <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />Mʉthalahɨtsyaga na ko kɨthaka kʉshangwa kyo kiryathiro kya Gongo. Mʉthalahɨtsyaga ibye ko muyi w'ɨYerʉsalemʉ kʉshangwa wo muyi w'oMwamɨ mʉkʉlʉ. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Ʉthalahɨtsyaga n'oko muthwe awe, kʉshangwa uthangakotsya ɨyɨra mo lʉtswɨrɨ lwawe lʉgʉma mo lʉfwɨ kʉtse mo lwirafulu. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Mʉlɨ omʉnegena, mʉnegene mʉthɨ: “Ega” kʉtse “Ɨhɨ” n'ebɨndɨ byoshi kʉlenga ebyo, ebɨthoka ewa mubihya Sitani.»<verse eid="MAT 5:37" /></para>
  <para style="s">Makangɨrɨtsya bʉshana n'ɨyɨfʉna</para>
  <para style="r">(<ref loc="LUK 6:29-30">Luk 6:29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />«Momwonvwa ko mokwanegenwa kʉthɨ: “Lisho ku lisho, na lino ku lino.”<note caller="+" style="f"><char style="fr" closed="false">5:38 </char><char style="ft" closed="false">Ɨthoka 21:24; Balawi 24:20; Ɨbʉka Mʉgomba 19:21.</char></note> <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Hewethuwe, ingye enyɨbabwɨra nyɨthɨ, muthakubisaniaga na mʉndʉ mʉbɨ. Hewethuwe omʉndʉ amakʉbanda ikofi kw'ithema ly'amalyo, mʉthege na ery'amalembe. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Na mʉndʉ mʉlebe amakusitaka bʉshana akʉnyagʉle esimisi awe, umulikire n'ekoti. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Mʉndʉ amakuhathikania athɨ ʉheke butikaki kʉ lʉgendo lwa kilometere kɨgʉma, nɨwahekabo kʉ bilometere bɨbɨrɨ. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Mʉndʉ amakʉshaba nɨwamʉha, na mʉndʉ amashondya ɨyɨbweka kw'ɨwe uthamukangaya omʉgongo.»<verse eid="MAT 5:42" /></para>
  <para style="s">Ɨtsɨɨra esonzigu</para>
  <para style="r">(<ref loc="LUK 6:27-28">Luk 6:27-28</ref>,<ref loc="LUK 6:32-36">32-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />«Momwonvwa ko mokwanegenwa kʉthɨ: “Tsɨɨra omuhimbani awe, na ʉbage enzigu awe.”<note caller="+" style="f"><char style="fr" closed="false">5:43 </char><char style="ft" closed="false">Balawi 19:18.</char></note> <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Hewethuwe ingye enyɨbabwɨra nyɨthɨ, mʉtsɨɨre esonzigu senyu, na mʉshabɨre bo babanubya. <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />Mwamayɨwatha muthyo nimwabya kwenene bana ba Thatha wenyu yo ʉlɨ mo lʉbʉla. Kʉshangwa anakoletsya erɨtsʉba lɨwe ly'oko babʉya n'oko babɨ, n'ɨwɨsa envʉla ko bo bathʉnganene na bo bathathʉnganene. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Kʉshangwa mwamatsɨɨra bo babatsiire kuroshi, lʉhembo lʉhe lo mwangabona? N'abakarani b'ekoli bathalɨ abana kola bathyo? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Na mwamaketsya bagala benyu basha, nɨmwamakola kɨhe ekɨthahera kyathakolwa? Bo bathɨkɨrɨtsye nabo bathalɨ abanakola bathyo? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Aho, imwe mubye bathʉnganene nga Thatha wenyu w'elʉbʉla kw'athʉnganene<note caller="+" style="f"><char style="fr" closed="false">5:48 </char><char style="ft" closed="false">Balawi 19:2; Ɨbʉka mʉgomba 18:13.</char></note>.»<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">Makangɨrɨtsya bʉshana n'iwathikya abatsene</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />«Muyitheye, mʉthagenda omʉkola bɨbʉya embere s'abandʉ bʉshana muyikanganie kʉbo. Kʉshangwa mwamakola muthyo nɨmʉthɨndahembwe na Thatha wenyu yo ʉlɨ elʉbʉla. <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />Wamawathikya mʉtsene nɨʉthabanda kʉ ngoma ng'abayimbya ko banakola mo <char style="w" lemma="Sinakoki">sosinakoki</char> na mo mɨhengere, bʉshana abandʉ basingyebo. Kwenene enyɨbabwɨra, abo bamalire ɨbona olʉhembo lwabo. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />H'ɨwe, ʉlɨ ouwathikya mʉtsene, okʉboko kwawe kw'amalembe nɨkʉthamɨnya eby'okʉboko kwawe kw'amalyo okʉkola. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Aho, uwathikye mo bubisho-bisho, na Sho yo ʉnalola ko byo ʉnakola mo bubisho-bisho andakʉhemba.»<verse eid="MAT 6:4" /></para>
  <para style="s">Makangɨrɨtsya bʉshana n'emɨshabe</para>
  <para style="r">(<ref loc="LUK 11:2-4">Luk 11:2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />Mo ndambi omʉshaba, mʉthagenda omubya ng'abayimbya bo atsiire ɨshaba nibimene mo <char style="w" lemma="Sinakoki">sosinakoki</char> na mo mashanganzɨra bʉshana balolweko n'abandʉ. Enyɨbabwɨra ekwenene, bamalire ɨbona olʉhembo lwabo. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />H'ɨwe washondya ɨshaba, nɨwɨngɨra mo kɨshenge kyawe mw'emwishi, kɨnga oluyi lwawe, ʉshabe Sho yo ʉlɨ ahabishamire. Aho, na Sho yo ʉlola kw'ebyo ʉkola mo bubisho-bisho akʉhemba.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />«Mʉlɨ omʉshaba mʉthagenda omʉshʉbɨrɨra bɨnwa bɨgʉmerera nga bandʉ bathɨkɨrɨtsye, abo banaganɨtsya bathɨ Gongo and'onvwabo bʉshana n'obʉngɨ bw'ebɨnwa byabo. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Muthabyaga ngabo, kʉshangwa Thatha wenyu etsi ebyoshi ebyo mulayireko embere mʉmʉshabe. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />Muthya ko mwandagenda omʉshaba:</para>
  <para style="q1" vid="MAT 6:9">“Thatha wethʉ ʉlɨ mo lʉbʉla,</para>
  <para style="q1" vid="MAT 6:9">erɨtsɨna lyawe lisingibwe,<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Obuthegeki bwawe buhike,</para>
  <para style="q1" vid="MAT 6:10">erishondya lyawe lɨkoleke mo kɨhʉgo ng'omo lʉbʉla.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Ʉthʉhe munobwire akalyo kethʉ k'ebɨro byoshi.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />Ʉthʉganyɨre ebɨtsɨbʉ byethʉ,</para>
  <para style="q1" vid="MAT 6:12">nga ko nethwe othʉnaganyɨra abo banathʉhabɨra.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />Uthathumikaga ɨremwa mw'ɨlengwako,</para>
  <para style="q1" vid="MAT 6:13">he ʉthʉshabʉle n'omubihya Sitani.</para>
  <para style="q1" vid="MAT 6:13">[Kʉshangwa obwamɨ nɨ bʉwawe, n'akagala, n'olʉkengerwa, kera na kera. Bibye bithyo.]”<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />«Mwamaganyɨra abandʉ bw'ebɨbɨ byabo, na Thatha wenyu w'elʉbʉla kuthyo andabaganyɨra ebɨbɨ byenyu. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Hewetuwe muthaganyire abandɨ bw'ebɨbɨ byabo, na Thatha wenyu naye athɨndabaganyɨre ebɨbɨ byenyu.»<verse eid="MAT 6:15" /></para>
  <para style="s">Makangɨrɨtsya bʉshana n'iyima kalyo</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />«Mo ndambi <char style="w" lemma="Iyima kalyo">omuyima akalyo</char>, mʉthabyaga ng'abayimbya bo banayɨyɨramo bandʉ babuliye, abanahingya amʉsʉ wabo, bʉshana bamɨnywe ko <char style="w" lemma="Iyima kalyo">abayima akalyo</char>. Kwenene enyɨbabwɨra, abo bamalire ɨbona olʉhembo lwabo. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />H'ɨwe ʉlɨ <char style="w" lemma="Iyima kalyo">ouyima akalyo</char>, ʉnabe mo bʉsʉ, haka marasi ko muthwe awe, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />bʉshana abandʉ bathamɨnyaga ko <char style="w" lemma="Iyima kalyo">ouyima akalyo</char>. He Sho mʉsha yo ʉlɨ ahabishamire, yo ʉlola kw'ebyo oʉkola mo bubisho-bisho andakʉhemba.»<verse eid="MAT 6:18" /></para>
  <para style="s">Obushoki mo lʉbʉla</para>
  <para style="r">(<ref loc="LUK 12:33-34">Luk 12:33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />«Mʉthagenda omʉbɨka obushoki by'enyu bo hano ishi, aho esonʉndʉ n'amakenge ebinabihya, aho abɨtsɨ abanathobola n'iba. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Mʉgende omʉbɨka obushoki bwenyu mo lʉbʉla, aho esonʉndʉ n'amakenge bithangabihya, n'aho abɨtsɨ bathangathobola n'iba. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Kʉshangwa ahalɨ obushoki bwawe nɨ aho h'omʉthɨma awe anabya.<verse eid="MAT 6:21" /></para>
  <para style="s">Amesho wo kyakakala ky'omʉbɨrɨ</para>
  <para style="r">(<ref loc="LUK 11:34-36">Luk 11:34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />«Erisho lyo tara y'omʉbɨrɨ. Erisho lyawe lyamabya likwirire omʉbɨrɨ woshi nɨalɨ mo kyakakala. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Hewethuwe erisho lyawe lyamabya lithakwirire omʉbɨrɨ awe woshi nɨalɨ mo mwitsimya. Aho, ekyakakala kɨrɨ mw'ɨwe kyamahɨndʉka mwitsimya, omwitsimya oyo angabya mʉnene kʉtsɨbʉ!»<verse eid="MAT 6:23" /></para>
  <para style="s">Ɨkolera Gongo kʉtse faranga</para>
  <para style="r">(<ref loc="LUK 16:13">Luk 16:13</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />«Hathalɨ yo wangakolera bo nyinya-kowabo babɨrɨ. Kʉshangwa andabaga omʉgʉma n'ɨtsɨɨra ogʉndɨ. Kʉtse andayihira kʉ mʉgʉma, n'ɨsʉnzʉgʉra ogʉndɨ. Muthangakotsya ɨkolera Gongo n'ɨkolera sofaranga.»<verse eid="MAT 6:24" /></para>
  <para style="s">Iyinihira Gongo</para>
  <para style="r">(<ref loc="LUK 12:22-31">Luk 12:22-31</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />Bʉshana n'ebyo enyɨbabwɨra nyɨthɨ: Mʉthaganga-gangyaga emɨthɨma enyu bʉshana n'obʉyɨngo bwenyu nga mwalya ki, kʉtse nga mwashoma ki na bʉshana n'emɨbɨrɨ enyu nga mwambala ki. Ewono obʉyɨngo buthalengitsye akalyo, n'omʉbɨrɨ athalengitsye esongɨmba? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Mʉlole ko bɨronge, bɨthahɨnga na bɨthahʉlʉla, kandɨ bɨthabɨka mʉ mbʉpʉ, na Thatha wenyu w'elʉbʉla analɨsabyo. Ewono imwe muthalengitsye ebɨronge byo kɨtsɨro? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Ɨndɨ mo kathi kenyu mw'iganga-gangya omʉthɨma ʉwe angayongerera kathambi kake ko bʉyɨngo bʉwe?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />Na bʉshana na ki omuganga-gangya emɨthɨma enyu bʉshana n'esongɨmba? Mʉyɨthegeretsye omʉshanga w'omo mashwa kw'analasha, athakola mʉlɨmo kandɨ athayɨlandɨra ngɨmba. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Namo bɨne bityo, enyɨbabwɨra nyɨthɨ n'omwamɨ Solomona<note caller="+" style="f"><char style="fr" closed="false">6:29 </char><char style="ft" closed="false">Soma 1Bamɨ 10.</char></note> mo lʉkengerwa lʉwe loshi, mwathathanga ambala kʉbʉya nga mʉgʉma wa kʉwo. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Aho Gongo amabya nianambikya athya ebɨthɨ by'omo mashwa, ebyo binabyaho munobwire na mungya nɨbyagʉshwa mo mʉtsanwa, athɨndagende abambikya kalengyo kw'aho, imwe bandʉ b'olwɨkɨrɨtsyo lʉke? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />Bʉshana n'ekyo, mʉthagenda omuganga-gangya emɨthɨma enyu nga mwalya ki, mwashoma ki, na nga mwambala ki. <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Kʉshangwa nɨ abandʉ b'omo kɨhʉgo, bo bathetsi Gongo n'ɨbo bo banashondya ebɨndʉ byoshi ebyo bʉthalʉha. H'imwe ye Sho etsi ko mulayire ko bɨndʉ ebyo. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Mʉthange mwashondya embere w'ebyoshi <char style="w" lemma="Bwamɨ bwa Gongo">oBwamɨ bwa Gongo</char> n'obʉthʉnganane bʉwe, naye andabongerera ebɨndɨ bɨndʉ byoshi. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Mʉthaganga-gangyaga emɨthɨma enyu bʉshana n'ebya mungya, kʉshangwa mungya yandayɨshondetsya yo yene. Obʉlɨ kɨro kiwithe mɨnʉbo yakyo.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Mʉthasohaga abandɨ</para>
  <para style="r">(<ref loc="LUK 6:37-38">Luk 6:37-38</ref>,<ref loc="LUK 6:40-41">40-41</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />«Mʉthagenda omʉsoha abandɨ, nemwe kutyo nɨmo Gongo athɨndabasohe. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Kʉshangwa Gongo andabasoha nga k'omʉsoha abandɨ, na kandɨ andabalengera mo lʉlengo lo mʉlengeramo abandɨ. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />Bʉshana na ki oʉshʉnga ko kathɨ kalɨ mo lisho lya mʉgala enyu, he uthashungire ko kithika kɨrɨ mo lisho lyawe? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Ʉthɨ ko wangabwɨra mʉgala enyu ʉthɨ: “Lika nyithokye akathɨ ko kalɨ mo lisho lyawe” mo ndambi mo lisho lyawe nɨmʉnalɨ ekithika? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Ɨwe muyimbya, thanga wathokya ekithika kɨrɨ mo lisho lyawe, aho nɨmo walola kʉbʉya nɨmo wakotsya ithokya ekɨthɨ kɨrɨ mo lisho lya mʉgala enyu.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />«Mʉthahaga esombwa s'ebɨndʉ bibuyirire, kʉshangwa sɨthababɨndʉkɨraga n'ɨbabʉlɨranga na mʉthagʉshaga obʉlema bwenyu bwa kɨtsɨro bw'embere y'esongʉlʉbe bʉshana sithalyathangagabo.»<verse eid="MAT 7:6" /></para>
  <para style="s">Ishondya, ɨshaba n'ɨkongotha</para>
  <para style="r">(<ref loc="LUK 11:9-13">Luk 11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />«Mʉgende omʉshaba nɨmo mwahabwa, mʉgende omushondya nɨmo mwabona, mʉgende omʉkongotha ko luyi nɨmo mwakɨngʉlɨrwa. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Kʉshangwa bʉlɨ mʉndʉ yo ʉshaba anahabwa, n'oyo ushondya yo ʉnabona. N'oyo ʉkongotha ko luyi anakɨngʉlɨrwa. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />Nɨ ndɨ mo kathi kenyu y'omwana ʉwe angamʉshaba mukati nɨamʉha ibwe? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Kʉtse amamʉshaba ihere nɨamʉha nzoka? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Imwe bandʉ babɨ mwetsi ɨha abana benyu bw'ebɨndʉ bikwirire. Ɨsho wenyu yo ʉlɨ mo lʉbʉla andagenda aha abo bamʉshaba bo bɨndʉ bikwirire kalengyo!<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />«Mʉgende omʉkolera abandɨ bw'ebyoshi omushondya babakolere. Nɨ ebyo byo bɨkangɨrɨtsɨbwa mo bɨtabo <char style="w" lemma="Mʉgomba">by'oMʉgomba</char> wa Mʉsa na mo <char style="w" lemma="Mʉmɨnyeretsɨ">by'abamɨnyeretsɨ</char>.»<note caller="+" style="f"><char style="fr" closed="false">7:12 </char><char style="ft" closed="false">Banyaroma 13:8-10.</char></note><verse eid="MAT 7:12" /></para>
  <para style="s">Nzɨra ibiri</para>
  <para style="r">(<ref loc="LUK 13:24">Luk 13:24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />«Mʉgende omwɨngɨra mo lukyo lʉfʉnda! Kʉshangwa olukyo lo lʉlotsya kw'ibihibwa nɨ lʉgalɨ, n'enzɨra yo yɨlotsyayo nɨ nene, n'abandʉ bo batsʉka mo nzɨra eyo nɨ bangɨ. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Hewethuwe olukyo lo lulolitsye ko bʉyɨngo nɨ lʉfʉnda, n'enzɨra y'erɨngɨra mo bʉyɨngo obo nɨ nge. N'abandʉ bo bakwama enzɨra eyo nɨ bake kʉtsɨbʉ.»<verse eid="MAT 7:14" /></para>
  <para style="s">Abamɨnyeretsɨ b'amabesɨ</para>
  <para style="r">(<ref loc="LUK 6:43-44">Luk 6:43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />Mʉgende omuyitheya ko bamɨnyeretsɨ b'amabesɨ. Kʉshangwa abanabahikira ni bambithe ngobi sa mbuli, hewethuwe emwishi sabo nɨ nyambwe nzɨbʉ. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Mwandamɨnyɨrabo ko mɨbere yabo. Abandʉ bathatsa ebiguma <char style="w" lemma="Musabibu">by'emisabibu</char> by'oko mɨthɨ y'emɨgando, kʉtse ebiguma by'omutini by'oko mɨshakɨ-shakɨ. <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Omʉthɨ mʉbʉya anaheka biguma bɨbʉya, na kuthyo omʉthɨ mʉbɨ anaheka biguma bɨbɨ. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Omʉthɨ akwirire athangaheka biguma bɨbɨ, kʉtse omʉthɨ mʉbɨ athangaheka biguma bikwirire. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Obʉlɨ mʉthɨ ow'athahekire biguma bikwirire anatsɨbwa n'ɨgʉshwa mo mʉtsanwa. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Aho mwandamɨnyɨra <char style="w" lemma="Mʉmɨnyeretsɨ">abamɨnyeretsɨ</char> b'amabesɨ ko byo banakola.<verse eid="MAT 7:20" /></para>
  <para style="s">Ɨnegena n'ɨkola</para>
  <para style="r">(<ref loc="LUK 13:25-27">Luk 13:25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />«Athalɨ bʉlɨ mʉndʉ yo ʉnyahʉlamo “Nyinya-kowethʉ, Nyinya-kowethʉ!” yo wandɨngɨra mo Bwamɨ bw'elʉbʉla, hewethuwe nɨ yo ʉkola erishondya lya Thatha yo ʉlɨ elʉbʉla. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Bandʉ bangɨ bandanyɨbwɨra ekɨro ekyo bathɨ: “Nyinya-kowethʉ, Nyinya-kowethʉ, ndɨ unetsi ko mothwakola bʉmɨnyeretsɨ kw'ɨtsɨna lyawe, kandɨ mothwabɨnga emɨtsɨmʉ mɨbɨ kw'ɨtsɨna lyawe, na kandɨ mw'ɨtsɨna lyawe mothwakola bɨthɨko-thɨko bɨngɨ!” <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Aho nyandabwɨrabo nyɨthɨ: “Ingye nyɨthahera nyathabamɨnya na hake, mʉthoke hofɨ nangye imwe bakoli b'ebɨbɨ.”»<verse eid="MAT 7:23" /></para>
  <para style="s">Mushinga wa bahimbi babɨrɨ</para>
  <para style="r">(<ref loc="LUK 6:47-49">Luk 6:47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />«Aho obʉlɨ mʉndʉ yo wonvwa ebɨnwa byaye n'ɨkolabyo, angashoshekanibwa na mʉndʉ mwenge yo wahimbaga enyʉmba yɨwe yo kw'ibwe. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Envʉla moyawa, emibimbi y'esonyitsi moyahika, n'ekɨhʉnga mokyabya, mokyayihuma ko nyʉmba eyo he moyɨthathera, kʉshangwa omʉsɨngɨ waro abyaga kw'ibwe. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Hewethuwe obʉlɨ mʉndʉ yo onvwa ebɨnwa ebyo nyɨthoka ɨnegena bʉthakolabyo, ashoshekanibwe n'omʉndʉ kahʉmo yo wahimbaga enyʉmba yɨwe y'oko mʉshege. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Envʉla moyawa, emibimbi y'esonyitsi moyahika, ekɨhʉnga mokyabya, mokyayihuma ko nyʉmba eyo naro moyathera na moyashambʉkala kʉtsɨbʉ.»<verse eid="MAT 7:27" /></para>
  <para style="s">Amaka wa Yesʉ</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Yesʉ abere amamala ɨnegena ebɨnwa ebyo, aboshi mobashwekera kʉtsɨbʉ Makangɨrɨtsya ʉwe, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />kʉshangwa mwathakangɨrɨtsyabo <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">ng'abakangɨrɨtsya babo b'oMʉgomba</char>. Hewetuwe ɨye agenda akangɨrɨtsyabo nga mʉndʉ wa maka.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Yesʉ etsya mʉbenzɨ</para>
  <para style="r">(<ref loc="MRK 1:40-45">Mar 1:40-45</ref>; <ref loc="LUK 5:12-16">Luk 5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Yesʉ abere andagala ko kɨthwa, bandʉ bangɨ kʉtsɨbʉ mobamʉkwama. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Aho mʉbenzɨ mʉgʉma mwayɨfʉnda hofɨ naye n'ɨfʉkama embere sɨwe n'ɨmʉbwɨra athɨ: «Nyinya-kowethʉ, wamashasha, wanganyetsya.» <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />Yesʉ mwalambʉla okʉboko n'ɨmʉkolako, n'ɨnegena athɨ: «Nyishashire, ʉlame!» Aho n'aho omʉndʉ oyo Yesʉ mwetsya ebɨbenzɨ bɨwe. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Honyuma kw'aho Yesʉ mwamʉbwɨra athɨ: «Hʉlɨkɨrɨtsya kʉbʉya, uthanalinda wabwɨraga mʉndʉ woshi-woshi y'ekɨnwa eki. Hewethuwe uyayikangye ko <char style="w">muheri</char>, honyuma kw'aho ʉlethe ebɨhembo nga ko Mʉsa ahamʉlaga, kw'ikangania ko bandʉ boshi ko wamalama.»<note caller="+" style="f"><char style="fr" closed="false">8:4 </char><char style="ft" closed="false">Balawi 14:2-32.</char></note><verse eid="MAT 8:4" /></para>
  <para style="s">Olwɨkɨrɨtsyo lw'omʉkʉlʉ w'abashirikani</para>
  <para style="r">(<ref loc="LUK 7:1-10">Luk 7:1-10</ref>; <ref loc="JHN 4:43-54">Yoa 4:43-54</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Mo ndambi Yesʉ agendaga ɨngɨra mo muyi w'ɨKaperenaʉmʉ, mʉkʉlʉ mʉgʉma w'abashirikani b'aBaroma mwayɨfʉnda hofɨ naye n'ɨmʉshaba kʉtsɨbʉ amuwathikye, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />n'ɨnegena athɨ: «Nyinya-kowethʉ, omukoli aye ayilambikire ko ngɨngo mw'eka, alwere makonongola na agalwa kʉtsɨbʉ.» <verse eid="MAT 8:6" /><verse number="7" style="v" sid="MAT 8:7" />Yesʉ mwamʉbwɨra athɨ: «Ingye, nyayamulamya.» <verse eid="MAT 8:7" /><verse number="8" style="v" sid="MAT 8:8" />Hewethuwe omʉkʉlʉ w'abashirikani<note caller="+" style="f"><char style="fr" closed="false">8:8 </char><char style="ft" closed="false">Omʉkʉlʉ oyo abyaga n'imanire bashirikani igana.</char></note> oyo mwamʉshʉbɨtsya athɨ: «Nyinya-kowethʉ, Nyɨthatholere wɨngɨre omwaye. Hewethuwe, negena kɨnwa kɨgʉma kuroshi omʉgombe aye alama. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Nangye enyɨnathegekwa n'abakʉlʉ baye, na kuthyo nyiwithe bashirikani bo nyɨnathegeka. Nyamabwɨra mʉgʉma nyɨthɨ: “Genda” nɨagenda, na nyamabwɨra ogʉndɨ nyɨthɨ: “Hika” niahika, na nyamabwɨra omʉgombe aye nyɨthɨ: “Kola kɨrebe” naye nɨakolakyo.» <verse eid="MAT 8:9" /><verse number="10" style="v" sid="MAT 8:10" />Yesʉ abere onvwa ebɨnwa ebyo, mwashweka kʉtsɨbʉ na mwabwɨra aboshi bo babyaga bamukwamire athɨ: «Enyɨbabwɨra ekwenene, nyɨthahera nyathashʉnga mʉndʉ uwithe lwɨkɨrɨtsyo lʉngana n'olu mo <char style="w">Isiraeli</char> yoshi. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Kandɨ enyɨbabwɨra, bandʉ bangɨ bandathoka ko bʉbʉkɨra ɨtsʉba n'abandɨ ko bʉlengera ɨtsʉba nabo bandalya linye mo Bwamɨ bw'elʉbʉla hagʉma na <char style="w">Abʉrahamʉ</char> na Isaka na Yakobo. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Hewethuwe abo babɨkɨrawa oBwamɨ bandagʉshwa embʉga mo mwitsimya, eyo bandalɨra n'ishya ameno.»<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Honyuma kw'aho Yesʉ mwabwɨra omʉkʉlʉ w'abashirikani oyo athɨ: «Shʉba ewawe, ʉkolerwe nga ko ʉthɨkɨrɨtsya!» Aho n'aho omukoli w'omʉkʉlʉ w'abashirikani mwalama.<verse eid="MAT 8:13" /></para>
  <para style="s">Yesʉ alamya bakoni bangɨ</para>
  <para style="r">(<ref loc="MRK 1:29-34">Mar 1:29-34</ref>; <ref loc="LUK 4:38-41">Luk 4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Yesʉ mwɨngɨra omwa Petero. Mweyamo nyatsala wa Petero nɨalɨ mo ngɨngo, bʉshana n'akapururu. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Mwamʉkolako ko kʉboko n'akapururu mokamulika, mwimana n'ɨthanga ɨkolera Yesʉ. <verse eid="MAT 8:15" /><verse number="16" style="v" sid="MAT 8:16" />Bwabere bwagoroba, mobalethera Yesʉ yo bandʉ bangɨ bo babyagako mɨtsɨmʉ mɨbɨ. Mʉ kɨnwa kɨgʉma, Yesʉ mwabɨnga emɨtsɨmʉ eyo, na mwalamya abakoni boshi. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Mwakola ebyo bʉshana kɨbererere ekɨnwa ky'<char style="w" lemma="Mʉmɨnyeretsɨ">omʉmɨnyeretsɨ</char> Isaya ekinegenire kɨthɨ: «Mwatsɨmba obʉthethera bwethʉ na mwaheka amakoni ethʉ.»<note caller="+" style="f"><char style="fr" closed="false">8:17 </char><char style="ft" closed="false">Soma Isaya 53:4. </char></note><verse eid="MAT 8:17" /></para>
  <para style="s">Abo bashondya ɨkwama Yesʉ</para>
  <para style="r">(<ref loc="LUK 9:57-62">Luk 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Yesʉ abere ashʉnga omuhindano woshi w'abyaga amuthimbireko, mwahamʉla <char style="w" lemma="abɨga">abɨga</char> bʉwe athɨ bashabʉkɨre ko ʉndɨ mwishirya w'engetsɨ. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" /><char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">Mʉkangɨrɨtsya mʉgʉma w'oMʉgomba</char> mwayɨfʉnda hofɨ naye n'ɨmʉbwɨra athɨ: «Mʉkangɨrɨtsya, nyandakʉkwama ahoshi wandaya.» <verse eid="MAT 8:19" /><verse number="20" style="v" sid="MAT 8:20" />Yesʉ mwamʉshʉbɨtsya athɨ: «Emɨtherere yiwithe mashamba n'ebɨronge biwithe nyʉthʉ, he <char style="w" lemma="Mʉgala w'oMʉndʉ">oMʉgala w'oMʉndʉ</char> athawithe ah'erihira omuthwe.»<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Na ʉndɨ mʉgʉma w'oko <char style="w" lemma="Abɨga">bɨga</char> bʉwe mwamʉbwɨra athɨ: «Nyinya-kowethʉ, nyɨtsɨɨre nyathathanga ɨyatha thatha.» <verse eid="MAT 8:21" /><verse number="22" style="v" sid="MAT 8:22" />Hewethuwe Yesʉ mwamʉshʉbɨtsya athɨ: «Nyɨkwame na lika abaholi bathe abaholi babo.»<verse eid="MAT 8:22" /></para>
  <para style="s">Yesʉ abombetsya ekɨhʉnga</para>
  <para style="r">(<ref loc="MRK 4:35-41">Mar 4:35-41</ref>; <ref loc="LUK 8:22-25">Luk 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Yesʉ mwashambɨra mo bwatho <char style="w" lemma="Abɨga">n'abɨga</char> bʉwe mobagendania naye. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Aho n'aho, mo ngetsɨ mokwahʉlʉka kɨhʉnga kɨnene, n'emibimbi moyagenda eyɨshwɨka obwatho. He Yesʉ abyaga niayiretho. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Abɨga bʉwe mobayɨfʉnda hofɨ naye n'imubukya nɨabahambala bathɨ: «Nyinya-kowethʉ, thʉshabʉle! Thwahwa!» <verse eid="MAT 8:25" /><verse number="26" style="v" sid="MAT 8:26" />Yesʉ mwabwɨrabo athɨ: «Omʉbaha bʉshana na ki? Bandʉ ba lwɨkɨrɨtsyo lʉke!» Aho mwimana, mwakemera ekɨhʉnga n'engetsɨ, na mokwabya shereri nene. <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />Abandʉ boshi mobashweka nɨabanegena bathɨ: «Nɨ mʉndʉ mʉhanda ki oyu yo ekɨhʉnga n'engetsɨ ebimushikya?»<note caller="+" style="f"><char style="fr" closed="false">8:27 </char><char style="ft" closed="false">Saburi 65:8; 89:10; 107:23-32.</char></note> <figure style="fig" alt="Jesus calme la mer" file="xxxx" size="col" ref="8:27">Yesʉ abombetsya engetsɨ</figure><verse eid="MAT 8:27" /></para>
  <para style="s">Yesʉ alamya abo babyagako emɨtsɨmʉ mɨbɨ</para>
  <para style="r">(<ref loc="MRK 5:1-20">Mar 5:1-20</ref>; <ref loc="LUK 8:26-39">Luk 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Yesʉ abere ahika ko ʉndɨ mwishirya w'engetsɨ, mo kɨhʉgo ky'aBangendari<note caller="+" style="f"><char style="fr" closed="false">8:28 </char><char style="ft" closed="false">Ngandara athabyaga muyi w'aBayuta. Abyaga hofɨ kʉ kilometere ikumi ko bʉbʉkɨra ɨtsʉba bw'omʉnda kihya w'engetsɨ y'iNgalilaya.</char></note>, bandʉ babɨrɨ mobafʉmba mo masɨnda na mobaya hindana naye. Abandʉ abo babyagako mɨtsɨmʉ mɨbɨ, babyaga manishe ihika ko kɨka hathabyaga mʉndʉ wangatsukire mo nzɨra eyo. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Aho mobathanga ɨhambala bathɨ: «Uthushondyako ki Mʉgala wa Gongo? Uthahika hano bʉshana n'ɨthwagatsya embere y'endambi yahirawaho?»<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Hale hake kʉbo habyaga kihyo kɨnene kya ngʉlʉbe sosagendaga esɨkera bɨthɨ.<note caller="+" style="f"><char style="fr" closed="false">8:30 </char><char style="ft" closed="false">Mar 5:11.</char></note> <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Emɨtsɨmʉ mɨbɨ moyashaba Yesʉ yɨthɨ: «Wamathʉbɨnga, thʉthʉme mo kihyo ky'esongʉlʉbe eki.» <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />Yesʉ mwabwɨra emɨtsɨmʉ eyo athɨ: «Mʉgende.» Aho, emɨtsɨmʉ mɨbɨ moyathoka mo bandʉ abo n'ɨya mo so ngʉlʉbe. Aho n'aho ekihyo kyoshi mokyathoka elʉgʉlʉ w'ekɨkʉbo, mokyathogongera mo ngetsɨ n'ɨfwɨra mo metsi. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Abalishya b'esongʉlʉbe mobashaga, mobahika mo muyi n'ɨfʉlɨra abandʉ b'omwatsɨ na byo bɨthakoleka ko bandʉ babɨrɨ bo bathalɨko emɨtsɨmʉ mɨbɨ. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Aho, abandʉ boshi b'omo muyi oyo mobahʉlʉka n'ɨya hindana na Yesʉ, babere bamʉshʉnga, mobamʉshaba kʉtsɨbʉ athoke mo kɨhʉgo kyabo.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">Yesʉ alamya mʉndʉ w'amakonongola</para>
  <para style="r">(<ref loc="MRK 2:1-12">Mar 2:1-12</ref>; <ref loc="LUK 5:17-26">Luk 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Yesʉ mwashambɨra mo bwatho, mwashʉba shabʉka engetsɨ n'ihika mo muyi ʉwe.<note caller="+" style="f"><char style="fr" closed="false">9:1 </char><char style="ft" closed="false">Ɨkwamana na Marɨko 2:1-12, Kaperenaʉmʉ ni muyi wo Yesʉ ikalagamo. Matayo 4:13.</char></note> <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Bandʉ bagʉma mobamʉlethera mʉndʉ wa makonongola nɨalɨ ku kipoyi. Yesʉ abere ashʉnga olwɨkɨrɨtsyo lwabo, mwabwɨra ow'amakonongola athɨ: «Magala ayo mbe mʉgala aye! Ebɨtsɨbʉ byawe byamaganyɨrwa!» <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />Aho <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">bakangɨrɨtsya bagʉma b'oMʉgomba</char> mobayinegenia bathɨ: «Omʉndʉ oyu amahatsya kʉ Gongo<note caller="+" style="f"><char style="fr" closed="false">9:3 </char><char style="ft" closed="false">Soma Balawi 24:16.</char></note>!» <verse eid="MAT 9:3" /><verse number="4" style="v" sid="MAT 9:4" />Yesʉ mwamɨnyerera ebyo bagenda abaganɨtsya, mwabwɨrabo athɨ: «Bʉshana na ki mʉlɨ n'emɨganɨtsye mɨbɨ mo mɨthɨma enyu? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Kɨhe kyo kyolo, ɨnegena mbʉ: “Ebɨtsɨbʉ byawe byamaganyɨrwa kʉtse ɨnegena mbʉ wimana na ʉgende”? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Aho, bʉshana mʉmɨnye kw'<char style="w" lemma="Mʉgala w'oMʉndʉ">oMʉgala w'oMʉndʉ</char> alɨ n'amaka w'erɨganyɨra ebɨtsɨbʉ ko kɨhʉgo.» Honyuma kw'aho mwabwɨra ow'amakonongola athɨ: «Wimana, tsɨmba ekipoyi kyawe na ʉshʉbe ewawe!» <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Omʉndʉ oyo mwimana na mwayɨgendera ewe. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Omuhindano abere ashʉnga kw'ebyo, mwafwa bʉba n'ɨthanga ɨsɨma Gongo yo wahaga abandʉ bw'amaka alɨ ng'aya.<verse eid="MAT 9:8" /></para>
  <para style="s">Yesʉ abɨrɨkɨra Matayo</para>
  <para style="r">(<ref loc="MRK 2:13-17">Mar 2:13-17</ref>; <ref loc="LUK 5:27-32">Luk 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Yesʉ abere alɨ atsʉka, mwashʉnga mʉndʉ mʉgʉma yo wagenda ahʉlwamo Matayo n'ikere mo biro by'erɨlɨhɨsɨra ekoli. Yesʉ mwamʉbwɨra athɨ: «Nyɨkwame!» Matayo mwimana n'ɨmʉkwama. <verse eid="MAT 9:9" /><verse number="10" style="v" sid="MAT 9:10" />Yesʉ abere anemulya ko kalyo kw'omwa Matayo, bakarani bangɨ b'ekoli na bakoli b'ebɨtsɨbʉ mobayalya hagʉma na Yesʉ <char style="w" lemma="Abɨga">n'abɨga</char> bʉwe. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" /><char style="w" lemma="Bafarisayo:">Abafarisayo</char> babere bashʉnga kw'ebyo, mobabwɨra <char style="w" lemma="abɨga">abɨga</char> bʉwe bathɨ: «Bʉshana na ki omʉkangɨrɨtsya enyu alya hagʉma n'abakarani b'ekoli na bakoli b'ebɨtsɨbʉ?»<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="ft" closed="false">Soma Luka 15:1-2.</char></note> <verse eid="MAT 9:11" /><verse number="12" style="v" sid="MAT 9:12" />Yesʉ abere onvwa ebyo bagenda abanegena, mwabwɨrabo athɨ: «Abandʉ batsibuhire bathalɨ abanalaga kʉ mʉshake, he nɨ abo balwere. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Mʉgende mʉyɨge aMashako Abuyirire owanegenire athɨ: “Nyilayire kʉ shashi, he nyithalayire kʉ bʉhere<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false">Osea 6:6.</char></note>.” Kʉshangwa nyithahikaga bʉshana n'ɨbɨrɨkɨra abathʉnganene hewethuwe abakoli b'ebɨtsɨbʉ.»<verse eid="MAT 9:13" /></para>
  <para style="s">Yesʉ n'iyima akalyo</para>
  <para style="r">(<ref loc="MRK 2:18-22">Mar 2:18-22</ref>; <ref loc="LUK 5:33-39">Luk 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />
    <char style="w">Abɨga</char> ba Yoani Mubatisya mobahika ahalɨ Yesʉ n'ɨmʉbʉtsya bathɨ: «Bʉshana na ki ithwe <char style="w" lemma="Bafarisayo:">n'aBafarisayo</char> <char style="w" lemma="Iyima kalyo">othunayima akalyo</char>, he <char style="w">abɨga</char> bawe ɨbo bathalɨ <char style="w" lemma="Iyima kalyo">abanayima akalyo</char>?» <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />Yesʉ mwashʉbɨtsyabo athɨ: «Omʉganɨtsya mʉthɨ abo bathalalɨkwa mo buheruki banganabya mʉ kɨrɨro omuherukya alɨ akɨnalɨ hagʉma nabo? Kiro! Hewethuwe ebɨro byandahika andabya athokibwa mʉbo, aho <char style="w" lemma="Iyima kalyo">bandayima akalyo</char>.»<verse eid="MAT 9:15" /></para>
  <para style="s">Tifayi nyihya na bɨrega bihya</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />«Hathalɨ mʉndʉ yo ʉnalandɨra ko lʉkɨmba lwa kera ko kɨbandɨko kihya-kihya, kʉshangwa ekɨbandɨko ekyo nɨkyakʉra olʉkɨmba lwa kera olo, aho ekɨthobo nɨ kyagalɨha kʉtsɨbʉ.»<verse eid="MAT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 9:17" />«Kuthyo abandʉ bathalɨ abanahira <char style="w" lemma="Tifayi:">etifayi</char> nyihya-nyihya mʉ bɨrega bya ngobi sikulire. Bɨthalɨ bithyo <char style="w" lemma="Tifayi:">etifayi</char> nɨyaberenga ebɨrega ebyo, <char style="w" lemma="Tifayi:">etifayi</char> nɨyashesheka n'ebɨrega nɨbyabɨha. Hewethuwe abanahira <char style="w" lemma="Tifayi:">etifayi</char> nyihya-nyihya mʉ bɨrega bihya-bihya, aho <char style="w" lemma="Tifayi:">etifayi</char> n'ebɨrega nɨbyabɨkɨka kʉbʉya.»<verse eid="MAT 9:17" /></para>
  <para style="s">Yesʉ alamya mʉkatsɨ na alubukya mʉthasha</para>
  <para style="r">(<ref loc="MRK 5:21-43">Mar 5:21-43</ref>; <ref loc="LUK 8:40-56">Luk 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Yesʉ abere anemʉbwɨrabo athyo, mʉkʉlʉ mʉgʉma w'aBayuta mwahika, mwafʉkama embere sɨwe n'ɨmʉbwɨra athɨ: «Omʉthasha aye amafwa lɨno-lɨno, hewethuwe hika umuhireko eminwe, naye ashʉba byaho.» <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Yesʉ mwimana n'ɨmʉkwama hagʉma <char style="w" lemma="Abɨga">n'abɨga</char> bʉwe.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Kwabyaga mʉkatsɨ mʉgʉma yo wabyaga alwere bukoni bw'ɨthokwamo mʉsasɨ mʉ mɨaka ikumi n'ibiri, mwayɨfʉnda ahalɨ Yesʉ nɨamʉhʉlʉka enyuma, na mwakola ko pindo y'olʉkɨmba lʉwe, <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />kʉshangwa agenda ayinegenia athɨ: «Nyanamakola ko lʉkɨmba lʉwe, nɨnyalama.» <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />Yesʉ abere abɨndʉka, mwamʉshʉnga n'ɨnegena athɨ: «Magala ayo mbe mwalɨ waye! olwɨkɨrɨtsyo lwawe lwamakulamya.» Aho n'aho omʉkatsɨ oyo mwalama.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Yesʉ abere ahika mo nyʉmba y'omʉkʉlʉ w'aBayuta, abere ashʉnga ko babuhi b'ehɨpʉlɨ<note caller="+" style="f"><char style="fr" closed="false">9:23 </char><char style="ft" closed="false">Abɨmbɨrɨtsɨ kʉtse abawathi b'ehɨpʉlɨ, bagenda baherekeretsya abaliri bo babyaga nibetsi ɨrɨra bʉshana n'omuhindano wabyaga mo nyʉmba yo banahiramo abaholi.</char></note>, n'omuhindano ow'abyaga nɨayɨkʉngʉtha mo kɨrɨro, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />mwanegena athɨ: «Mʉthoke hano, kʉshangwa omʉthasha athafwire, he alɨtho.» Hewethuwe mobamʉsheka. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Babere bamamala iriitha abandʉ, Yesʉ mwɨngɨra mo kɨshenge, mwatsɨmba omʉthasha y'oko kʉboko n'omʉthasha mwimana. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Omwatsɨ oyo mwaya-ngʉlʉ mo kɨhʉgo ekyo.<verse eid="MAT 9:26" /></para>
  <para style="s">Yesʉ alamya mbumi ibiri</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Yesʉ abere athoka aho, mbumi ibiri mosamʉkwama nɨesɨhambala sɨthɨ: «Thʉshashɨre mbe Mʉgala wa <char style="w" lemma="Tawiti">Tawiti</char>.»<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Yesʉ abere ahika mo nyʉmba, esombumi mosayɨfʉnda hofɨ naye, naye mwabʉtsyatho athɨ: «Mwɨkɨrɨtsye ko nyangakola ebyo?» Mosamʉshʉbɨtsya sɨthɨ: «Ega mbe Nyinya-kowethʉ.» <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />Aho Yesʉ mwakola ko mesho watho n'ɨnegena athɨ: «Bɨkoleke kw'imwe ɨkwamana n'olwɨkɨrɨtsyo lwenyu!» <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />N'amesho wabo mwakɨngʉkala. Honyuma kw'aho Yesʉ mwahamʉlabo kʉtsɨbʉ athɨ: «Ohe, hathabyaga mʉndʉ n'omʉgʉma yo wamɨnya ebi.» <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Hewethuwe ɨbo babere bathoka aho mobayathulagania engʉlʉ yɨwe mo kɨhʉgo kyoshi ekyo.<verse eid="MAT 9:31" /></para>
  <para style="s">Yesʉ alamya kɨtsɨrʉ</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Abandʉ babɨrɨ abo babere balɨ abathoka aho, bandɨ bandʉ mobalethera Yesʉ yo mʉndʉ yo wabyaga kɨtsɨrʉ kʉshangwa abyagako mʉtsɨmʉ mʉbɨ. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Yesʉ abere amamala ɨbɨnga omʉtsɨmʉ oyo, ekɨtsɨrʉ ekyo mokyathanga ɨnegena. Abandʉ boshi mobashweka nɨabanegena bathɨ: «Thʉthahera thwathashʉnga kʉ kɨrɨ ng'eki mo kɨhʉgo <char style="w" lemma="Isiraeli">ky'iIsiraeli</char>.» <verse eid="MAT 9:33" /><verse number="34" style="v" sid="MAT 9:34" />Hewethuwe <char style="w" lemma="Bafarisayo:">aBafarisayo</char> bagenda abanegena bathɨ: «Nɨ omʉkʉlʉ w'emɨtsɨmʉ yo ʉmʉha akagala k'erɨbɨnga emɨtsɨmʉ mɨbɨ!»<note caller="+" style="f"><char style="fr" closed="false">9:34 </char><char style="ft" closed="false">Soma 12:24.</char></note><verse eid="MAT 9:34" /></para>
  <para style="s">Yesʉ afwɨra abandʉ bo shashi</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />«Yesʉ agenda athimba mo miyi n'omo mɨrongo yoshi, agenda akangɨrɨtsya mo <char style="w" lemma="Sinakoki:">sosinakoki</char> sabo, alɨafʉla <char style="w" lemma="Ngʉlʉ Mbʉya">eNgʉlʉ Mbʉya</char> y'oBwamɨ bwa Gongo, n'ilamya amakoni woshi n'obʉlema bwoshi. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Mo ndambi Yesʉ agenda ashʉnga muhindano wa bandʉ bangɨ, mwagenda afwɨrabo shashi kʉshangwa babyaga nɨbamalʉha n'ɨfwa bulundu nga mbuli sithawithe mulishya.<note caller="+" style="f"><char style="fr" closed="false">9:36 </char><char style="ft" closed="false">Mɨganzo 27:17; Bamɨ bambere 22:17.</char></note> <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Aho mwabwɨra <char style="w">abɨga</char> bʉwe athɨ: “Emyaka yerire nɨ mɨngɨ, hewethuwe abageshi nɨ bake. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Aho mʉshabe omwenye emyaka athʉme bakoli bangɨ mw'ɨshwa lɨwe.”»<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">aBathʉmwa ikumi na babɨrɨ</para>
  <para style="r">(<ref loc="MRK 3:13-19">Mar 3:13-19</ref>; <ref loc="LUK 6:12-16">Luk 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Yesʉ mwabɨrɨkɨra <char style="w">abɨga</char> bʉwe ikumi na babɨrɨ na mwahabo maka w'ɨbɨnga emɨtsɨmʉ mɨbɨ n'ilamya bʉlɨ bukoni boshi, na bʉlɨ bʉlema boshi. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Ano wo matsɨna <char style="w" lemma="Bathʉmwa">w'abathʉmwa</char> ikumi na babɨrɨ: omʉmbere nɨ Simoni yo walʉkawamo Petero, na Ndereya mʉgala abo. Yakobo mʉgala wa Sebetayo, na Yoani mʉgala abo, <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Filipo na Barɨtolomayo, Tomasɨ na Matayo omukarani w'ekoli, Yakobo mʉgala wa Alʉfayo, na Tatei, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Simoni w'omo kɨkembe ky'aBaselote<note caller="+" style="f"><char style="fr" closed="false">10:4 </char><char style="ft" closed="false">aBaselote kyabyaga kɨkembe ky'aBayuta bo babyaga nibathatsiire obuthegeki bw'aBaroma.</char></note> na Yuta Isikariote yo wahotheraga Yesʉ.<verse eid="MAT 10:4" /></para>
  <para style="s">Omʉlɨmo w'abathʉmwa ikumi na babɨrɨ</para>
  <para style="r">(<ref loc="MRK 6:7-13">Mar 6:7-13</ref>; <ref loc="LUK 9:1-6">Luk 9:1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Yesʉ mwathʉma abɨga bʉwe ikumi na babɨrɨ mo mʉlɨmo n'ɨhamʉlabo athɨ: «Mʉthayaga mo bɨhʉgo by'abandʉ b'ebɨndɨ bɨhanda na mʉthɨngɨraga mo miyi <char style="w" lemma="Basamarɨa">y'aBasamarɨa</char>. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Hewethuwe mʉgendere esombuli siherire s'omo nyʉmba ya <char style="w">Isiraeli</char>. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Mo nzɨra mw'eyo mʉgende omʉkangɨrɨtsya abandʉ mʉthɨ: “oBwamɨ bw'elʉbʉla bʉlɨ hofɨ!” <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Mulamye abakoni, mulubukye abaholi, mwetsye ababenzɨ, mʉbɨnge emɨtsɨmʉ mɨbɨ. Mwahabawa bʉsha nemwe mʉhane bʉsha. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Mʉthahekaga <char style="w">horo</char> kʉtse faranga, kʉtse bɨtsere bya mʉlɨnga mo bɨla byenyu. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />Na mʉthahekaga shaho, kʉtse koti ibiri, kʉtse bɨrato, kʉtse kɨkoma. Kʉshangwa omukoli atholere nialya.<note caller="+" style="f"><char style="fr" closed="false">10:10 </char><char style="ft" closed="false">1Banyakorinto 9:14; 1Timote 5:18.</char></note>»<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />«Mo ndambi mwandabya mwahika mʉ muyi kʉtse mʉ mʉrongo, mushondye mʉndʉ yo ʉtholere ibakokya na mwikale omwe ihika ko kɨro mwandathoka mʉwo. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Mwandabya mwɨngɨra mʉ nyʉmba mʉketsye abalɨmo, mʉthɨ: “Obʉholo bubye nemwe.” <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Abandʉ b'omo nyʉmba eyo bamabakokya, obʉholo bwenyu nibwabya nabo. Hewethuwe bathabakokitsye obʉholo bwenyu nɨbwabashʉbʉlɨra. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Na kwamabya nyʉmba kʉtse muyi wo bamathɨnda ibakokyamo, kʉtse ɨbahʉlɨkɨrɨtsya, mʉthokemo na mʉkʉngʉthe oluthuthu ly'oko bɨshando byenyu.<note caller="+" style="f"><char style="fr" closed="false">10:14 </char><char style="ft" closed="false">Ko Bayuta, ekɨnwa erɨkʉngʉtha oluthuthu ko bɨshando n'ɨnegena mbʉ abandʉ bathahʉlɨkɨrɨrene kʉbʉya. Kandɨ nɨ negena mbʉ yo ʉthathʉmwa athakɨrɨko mwinda w'oyo athathʉmwako. Marɨko 6:11.</char></note> <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Kwenene enyɨbabwɨra, ekɨro ky'esohi abahimbani b'omo kɨhʉgo ky'eSotomo na eky'eNgomora bandasohwa kʉke kʉtsɨbʉ kʉlenga abandʉ b'omo muyi oyo.»<verse eid="MAT 10:15" /></para>
  <para style="s">Emɨnʉbo yo yihika</para>
  <para style="r">(<ref loc="MRK 13:9-13">Mar 13:9-13</ref>; <ref loc="LUK 21:12-17">Luk 21:12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />Mʉhʉlɨkɨrɨtsye! Enyɨbathʉma ng'esombuli mo kathi k'esonyambwe. Mubye nyengeshu ng'esonzoka na balonvʉ ng'othulikuku. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Muyitheye ko bandʉ, kʉshangwa bandabathwala ko tɨrɨbɨnalɨ na bandabahumba mihumbo mo so<char style="w" lemma="Sinakoki:">sinakoki</char> sabo. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Na kuthyo bandabathwala embere s'abakʉlʉ n'abamɨ bʉshana nangye, bʉshana mubye batimo baye embere sabo n'embere s'abandʉ b'ebɨndɨ bɨhanda. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Mo ndambi bandagenda ababathwala ko tɨrɨbɨnalɨ, mʉthagenda omuyigangya-gangyaga nga mʉthɨ ko mwanegena kʉtse nga mwanegena ki. Ebɨnwa mwandanegena Gongo andabahabyo ko kathambi ako. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Kandɨ mʉthalɨ imwe momwandanegena, hewethuwe nɨ <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma Mwerʉ</char> wa Thatha wenyu wo andabanegeneramo. <verse eid="MAT 10:20" /><verse number="21" style="v" sid="MAT 10:21" />Omʉndʉ andahothera mʉgala abo bʉshana ithwe, n'ishe w'omwana andahothera mʉgala ʉwe, abana nabo bandabɨndʉkɨra ababuthi babo na bandɨthɨsabo. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Abandʉ boshi bandababaga bʉshana nangye. Hewethuwe yo wandatsitsinia ihika ko nduli andashabʉlwa. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Bandabya babanubya mu muyi mʉlebe mʉshayɨre mʉ ʉndɨ. Enyɨbabwɨra ekwenene, mʉthɨndamale ithimba mo miyi yoshi <char style="w" lemma="Isiraeli">y'iIsiraeli</char> <char style="w">Mʉgala w'oMʉndʉ</char> athetsi ahika.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />«Hathalɨ <char style="w" lemma="Abɨga">mwɨga</char> yo ulengitsye omʉkangɨrɨtsya ʉwe, kʉtse hathalɨ mʉkobe yo ulengitsye nyinya-kowabo. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Hewethuwe bikwirire <char style="w" lemma="Abɨga">omwɨga</char> ibya ng'omʉkangɨrɨtsya ʉwe n'omʉkobe ibya nga nyinya-kowabo. Bamabya nɨabahʉla omʉkʉlʉ w'olʉganda mo Belisebuli<note caller="+" style="f"><char style="fr" closed="false">10:25 </char><char style="ft" closed="false">Belisebuli n'ɨtsɨna lyahabawa eSitani nga mʉkʉlʉ w'emɨtsɨmʉ.</char></note>, bathangabʉsha ɨahʉla abandʉ b'omo lʉganda lʉwe mʉ matsɨna mabɨ kʉtsɨbʉ!»<verse eid="MAT 10:25" /></para>
  <para style="s">Oyo wangʉbahwa</para>
  <para style="r">(<ref loc="LUK 12:2-7">Luk 12:2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />Aho, mʉthʉbahaga abandʉ abo. Kʉshangwa hathalɨ kɨndʉ kyoshi-kyoshi kyo kibishire kyo kithindabishulwe, kʉtse hathalɨ lʉfʉmɨ lolʉthɨndamɨnywe. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Ekyo nyɨbabwɨra mo mwitsimya mʉnegenekyo mʉ kathɨ ka mwɨshɨ, na kuthyo ekyo abababʉherera ko kuthwi, mʉhambalɨrekyo ko lʉthwe lw'enyʉmba. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Mʉthʉbahaga abandʉ bo bang'itha omʉbɨrɨ kuroshi he nibathangitha ekirimu, hewethuwe mwʉbahe Gongo yo wang'itha<note caller="+" style="f"><char style="fr" closed="false">10:28 </char><char style="ft" closed="false">Yakobo 4:12.</char></note> omʉbɨrɨ n'ekirimu okw'ɨrʉnga. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Ewono, ebishwi bɨbɨrɨ bɨthalɨ ebɨnagʉtsɨbwa sengi ngʉma? He namo bɨnalɨ bithyo hathalɨ kɨgʉma kya kʉbyo kyo kyangathogera ko kɨthaka lɨthalɨ ɨshasha lya Gongo Thatha wenyu. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Na kw'imwe Gongo etsi emɨganzo y'esonzwɨrɨ soshi s'oko mithwe enyu. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Aho mʉthʉbahaga, kʉshangwa muwithe kɨtsɨro kɨnene kʉlenga bishwi bɨngɨ!<verse eid="MAT 10:31" /></para>
  <para style="s">Ɨkɨrɨtsya kʉtse ɨthɨnda Yesʉ Kirisito</para>
  <para style="r">(<ref loc="LUK 12:8-9">Luk 12:8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />«Bʉlɨ mʉndʉ yo wandanyɨkɨrɨtsya embere s'abandʉ nangye nyandamwɨkɨrɨtsya embere sa Thatha yo ʉlɨ elʉbʉla. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Hewethuwe omʉndʉ amanyɨthɨnda embere s'abandʉ nangye nɨnyandamʉthɨnda embere sa Thatha yo ʉlɨ elʉbʉla.»<verse eid="MAT 10:33" /></para>
  <para style="s">Yesʉ aletha ɨgabana</para>
  <para style="r">(<ref loc="LUK 12:51-53">Luk 12:51-53</ref>; <ref loc="LUK 14:26-27">14:26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />«Muthaganitsaya mʉthɨ nyahikaga ɨretha bʉholo ko kɨhʉgo. Nyithahikaga ɨretha bʉholo hewethuwe muyali. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Kʉshangwa nyahikaga igabania omʉndʉ n'ishe ʉwe, omʉthasha na nyinya ʉwe, omwatsana na nyatsala. <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />N'esonzigu s'omʉndʉ bandabya bandʉ b'omo nyʉmba yɨwe.<note caller="+" style="f"><char style="fr" closed="false">10:36 </char><char style="ft" closed="false">Mika 7:6.</char></note> <verse eid="MAT 10:36" /><verse number="37" style="v" sid="MAT 10:37" />Oyo utsiire ishe kʉtse nyinya kʉlenga ingye, athanyɨtholere. N'oyo utsiire mʉgala kʉtse mwalɨ kʉlenga ingye, athanyɨtholere. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Oyo uthahekire <char style="w" lemma="Mʉsalaba">omʉsalaba</char> ʉwe n'ɨnyɨkwama athanyɨtholere. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Oyo wandashondya ilamya obʉyɨngo bʉwe andahetsyabo. Hewethuwe yo wandahetsyabo bʉshana nangye andalamyabo.»<verse eid="MAT 10:39" /></para>
  <para style="s">Lʉhembo lw'abo bakokya abɨga ba Yesʉ</para>
  <para style="r">(<ref loc="MRK 9:41">Mar 9:41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />«Omʉndʉ yo ubakokya niamanyikokya, n'oyo unyikokya niakokya yo wanyɨthʉmaga. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Oyo wamakokya <char style="w" lemma="Mʉmɨnyeretsi">omʉmɨnyeretsɨ</char> kʉshangwa nɨ <char style="w" lemma="Mʉmɨnyeretsi">mʉmɨnyeretsɨ</char>, andabona lʉhembo <char style="w" lemma="Mʉmɨnyeretsi">lw'omʉmɨnyeretsɨ</char>, n'oyo ukokya omʉthʉnganene kʉshangwa nɨ mʉthʉnganene andabona lʉhembo lw'omʉthʉnganene. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Kwenene enyɨbabwɨra, oyo ʉha mʉgʉma w'oko bake-bake b'omo <char style="w" lemma="Abɨga">bɨga</char> baye yo lwatha lwa metsi mʉfʉ, kʉshangwa nɨ <char style="w" lemma="Abɨga">mwɨga</char> aye, athɨndabʉshe ɨhabwa olʉhembo lʉwe.»<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Abagendi ba Yoani Mubatisya</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Yesʉ abere amamala ɨhamʉla ebɨnwa ebyo ko <char style="w">bɨga</char> bʉwe ikumi na babɨrɨ, mwathoka aho n'ɨya mo miyi y'iNgalilaya bʉshana n'ɨya kangɨrɨtsya n'ɨfʉla Engʉlʉ Mbʉya.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Mo ndambi eyo, Yoani Mubatisya abyaga niaminirwe, mwonvwa ng'oko abasɨmola ko mɨrɨmo ya <char style="w" lemma="Kirisito, Masia">Kirisito</char>. Aho mwathʉma bagʉma b'oko <char style="w" lemma="Abɨga">bɨga</char> bʉwe, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />ɨya bʉtsya Yesʉ bathɨ: «Ewono ɨwe ʉlɨ yo wangahikire, kʉtse thʉlɨnde ʉndɨ?» <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />Yesʉ Mwashʉbɨtsyabo athɨ: «Mʉgende mʉyabwɨre Yoani byo monvwa na byo mʉlolako. <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Esombumi esɨlola, ebɨrema ebɨgenda, ababenzɨ abetsɨbwa, abatsɨha abonvwa, abaholi abalubuka, <char style="w" lemma="Ngʉlʉ Mbʉya">n'eNgʉlʉ Mbʉya</char> eyɨfʉlɨrwa abatsene. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Agashanɨrwe yo ʉthɨndawe bʉshana nangye.»<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Abɨga ba Yoani abo babere bagenda, Yesʉ mwathanga ɨsɨmolera omuhindano bʉshana na Yoani athɨ: «Mwayaga lola ku ki mo <char style="w">mbwarara</char>? Lʉsheke lo luthenganibwa na mbeho? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Aho, mwayaga lola ku ki? Mʉndʉ ambithe ngɨmba sikwirire? Ɨhɨ! Bo banambala ngɨmba sikwirire balɨ mo manyʉmba w'abamɨ. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Ewono, mwayaga lola ku ki? Kʉ <char style="w" lemma="mʉmɨnyeretsɨ">mʉmɨnyeretsɨ</char>? Ega, enyɨbabwɨra ɨye alengitsye <char style="w" lemma="mʉmɨnyeretsɨ">mʉmɨnyeretsɨ</char>. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Kʉshangwa ni Yoani yo bishakirweko mbʉ: “Nyathʉma omugendi aye akʉthange embere, yo wandakomya enzɨra awe.” <verse eid="MAT 11:10" /><verse number="11" style="v" sid="MAT 11:11" />Kwenene enyɨbabwɨra, mo bandʉ babʉthawa na mʉkatsɨ, kuthathangire kwahʉlʉka mʉkʉlʉ kʉ Yoani <char style="w" lemma="Lubatiso">Mubatisya</char>. Hewethuwe omʉke kʉtsɨbʉ mo Bwamɨ bw'elʉbʉla nɨ mʉkʉlʉ kw'ɨye. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Ɨthoka ko bɨro bya Yoani Mubatisya ihika lɨno, abandʉ abalwɨsa oBwamɨ bw'elʉbʉla, nɨ aba kagala bo batsɨmbabo. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" /><char style="w" lemma="Mulaguli wa Gongo">Kʉshangwa abamɨnyeretsɨ</char> boshi <char style="w" lemma="Mʉgomba">n'oMʉgomba</char> wa Mʉsa mobafʉla omwatsɨ oyo, ihika ko mʉgʉlʉ wa Yoani. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Na mwamashondya ɨmɨnya kʉbʉya, Yoani yo Elia yo wangahikire. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Yo uwithe mathwi onvwe!»<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />«Ɨndɨ yo nyangalingania n'abandʉ ba munobwire? Bangalinganibwa na bana bikere handʉ ha muhindano, bo babɨrɨkɨra balikyabo bathɨ:<verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />“Mothwababuhire akapʉlɨ, hewethuwe momuthashathire! Mothwimbire lwimbo lwa kɨrɨro, momuthalirire.” <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />Kʉshangwa Yoani mwahika, athagenda alya n'ɨshoma, abandʉ mobanegena bathɨ: “alɨko mʉtsɨmʉ!” <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" /><char style="w">oMʉgala w'oMʉndʉ</char> mwahika, agenda alya n'ɨshoma abandʉ mobanegena bathɨ: “Shʉnga, omʉndʉ oyu ni wa kahehu, kandɨ nɨ mukundirya, ni mwira w'abakarani b'ekoli n'abakoli b'ebɨtsɨbʉ!” Hewethuwe obuthegekania bwa Gongo obʉshʉngɨka mo mɨrɨmo yɨwe.»<verse eid="MAT 11:19" /></para>
  <para style="s">Emiyi yo ɨthɨnda ɨkɨrɨtsya</para>
  <para style="r">(<ref loc="MAT 10:15">Mat 10:15</ref>; <ref loc="LUK 10:12-15">Luk 10:12-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Honyuma kw'aho, Yesʉ mwathanga ɨkemera emiyi eyo akoleragamo bɨthɨko-thɨko bɨngɨ kʉtsɨbʉ kʉshangwa abikalani bamʉro mobathabɨndʉka ɨthoka mo bɨtsɨbʉ byabo. Mwanegena athɨ: <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />«Bʉhanya kw'imwe Banyakorasini! Bʉhanya kw'imwe Banyabetesaita! Kʉshangwa ebɨthɨko-thɨko byakolerawa ewenyu byangakolerwe Banyatiro na Banyasitona, bangambere kera mɨbʉta n'ɨyɨhaka ɨfʉ ikangania ko bamalire ɨbɨndʉka. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Bʉshana n'ekyo enyɨbabwɨra nyɨthɨ ekɨro ky'esohi amalipisi enyu andalenga ow'abikalani b'iTiro n'iSitona.» <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Nemwe Banyakaperenaʉmʉ, omʉganɨtsya mʉthɨ mwandirukibwa mo lʉbʉla? Mwandakimibwa kw'ɨrʉnga. Kʉshangwa ebɨthɨko-thɨko byakolekaga ewenyu, byangakolekire ɨSotomo, omuyi oyo ng'akɨnalɨho munobwire. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Kyokɨreka nɨnyababwɨra nyɨthɨ, ekɨro ky'esohi ya Gongo, abandʉ b'ɨSotomo bandasohwa kʉke kw'imwe.<verse eid="MAT 11:24" /></para>
  <para style="s">Muhike mʉlʉhʉke</para>
  <para style="r">(<ref loc="LUK 10:21-22">Luk 10:21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Mo ndambi eyo, Yesʉ mwanegena athɨ: «Thatha, ɨwe Muthegeki w'olʉbʉla n'ekɨhʉgo, enyɨkʉsɨma kʉshangwa mowabisha ebɨnwa bɨno ko bandʉ ba bwenge n'abathegekania, hewethuwe wamabishulirabyo abana balere. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Ega, mbe Thatha, mwishondya lyawe mowashasha bibye bithyo.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />«Thatha mwanyɨhere ebyoshi. Hathalɨ yo wetsi Mʉgala, athalɨ Thatha mʉsha. Kandɨ hathalɨ yo wetsi Thatha athalɨ Mʉgala, n'aboshi bo Mʉgala ashashire ibishulira.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />«Muhike yo nyɨrɨ imwe boshi mo munubire na mɨtsigo mɨtsɨtho, nangye nyabalʉhʉkya. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Mʉheke engomo aye na mʉkangɨrɨtsɨbwe nangye, kʉshangwa nyɨrɨ mʉlonvʉ n'omʉthɨma aye ahehere, nemwe mwandabona erɨlʉhʉka ly'ebirimu byenyu. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Ega, engomo aye yolohire ɨheka n'omʉtsɨgo aye nɨ mwangʉ.» <figure style="fig" alt="xxx" file="xx" size="col" ref="11:30">Engomo nɨ mʉthɨ abatsire w'anamɨnɨrwa ko nde so sɨnalɨma </figure><verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Yesʉ yo mʉkʉlʉ w'eSabato</para>
  <para style="r">(<ref loc="MRK 2:23-28">Mar 2:23-28</ref>; <ref loc="LUK 6:1-5">Luk 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Ko mʉgʉlʉ oyo, mʉ kɨro kɨgʉma <char style="w" lemma="Sabato">ky'eSabato</char>, Yesʉ agenda atsʉka mo mashwa w'engano. <char style="w" lemma="Abɨga">Abɨga</char> bʉwe mobawɨra, mobathanga ɨtsa ebɨkʉmba by'engano n'ɨthanga iryabyo. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" /><char style="w" lemma="Bafarisayo:">aBafarisayo</char> babere balola kw'ebyo, mobabwɨra Yesʉ bathɨ: «Lola, <char style="w" lemma="abɨga">abɨga</char> bawe abakola ebyo bɨthatholere ɨkolwa mo kɨro <char style="w" lemma="Sabato">ky'eSabato</char>!» <verse eid="MAT 12:2" /><verse number="3" style="v" sid="MAT 12:3" />Yesʉ mwashʉbɨtsyabo athɨ: «Momʉthasoma ekyo <char style="w">Tawiti</char> akolaga abere awɨra ɨye n'abo abyaga nabo? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Ndɨ mwɨngɨra mo <char style="w">Nyʉmba ya Gongo</char> n'irya emikati yo yahererawa Gongo, yo bathabyaga bahamulirwe irya ɨye n'abo abyaga nabo, hewethuwe niyihamulirwe ɨrɨbwa <char style="w" lemma="Muheri">n'abaheri</char> basha! <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Kʉtse momʉthasoma mo <char style="w">Mʉgomba</char> wa Mʉsa k'obʉlɨ kɨro <char style="w" lemma="Sabato">ky'eSabato</char>, <char style="w" lemma="Muheri">abaheri</char> bo banakola mo <char style="w">Nyʉmba ya Gongo</char> abanagenda abahatsya ko <char style="w" lemma="Sabato">Sabato</char>, nabo bathalɨ abanaganzɨrwa kɨbɨ?<note caller="+" style="fe"><char style="fr" closed="false">12:5 </char><char style="ft" closed="false">Soma Mɨganzo 28:9-10.</char></note> <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Hewethuwe enyɨbabwɨra, hano halɨ mʉkʉlʉ kʉlenga <char style="w" lemma="Nyʉmba ya Gongo">eNyʉmba ya Gongo</char>! <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Mwangaminyire ekɨnwa ekinegenire kɨthɨ: “Nyishashire shashi, he bʉthalɨ obʉhere<note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="ft" closed="false">Soma Osea 6:6.</char></note> bwenyu,” muthangasohire abandʉ aba bo bathakolire kɨbɨ. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Kʉshangwa <char style="w">Mʉgala w'oMʉndʉ</char> yo mʉkʉlʉ <char style="w" lemma="Sabato">w'eSabato</char>.»<verse eid="MAT 12:8" /></para>
  <para style="s">Yesʉ alamya mʉndʉ w'amakonongola ekɨro ky'eSabato</para>
  <para style="r">(<ref loc="MRK 3:1-6">Mar 3:1-6</ref>; <ref loc="LUK 6:6-11">Luk 6:6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Yesʉ mwathoka aho, mwɨngɨra mo <char style="w" lemma="Sinakoki">sinakoki</char> y'aBayuta. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Omo mwabyaga mʉndʉ wa kʉboko kukonongokire. aBafarisayo mobabʉtsya Yesʉ bathɨ: «Binahamulirwe ilamya ekɨro <char style="w" lemma="Sabato">ky'eSabato</char>?» Bagenda abashondya kɨnwa k'imusitakirako. <verse eid="MAT 12:10" /><verse number="11" style="v" sid="MAT 12:11" />Yesʉ mwashʉbɨtsyabo athɨ: «Ɨndɨ mo kathi kenyu amabya awithe kʉ mbuli ngʉma kuroshi naro yamathogera mo kyuna ekɨro <char style="w" lemma="Sabato">ky'eSabato</char> niathiyathokyeromo? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Ndɨ omʉndʉ nɨ wa kɨtsɨro kɨnene kʉlenga embuli! Aho, bihamulirwe ɨkola bɨbʉya ekɨro <char style="w" lemma="Sabato">ky'eSabato</char>.» <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Aho Yesʉ mwabwɨra omʉndʉ oyo athɨ: «Lambʉla okʉboko kwawe.» Mwalambʉlako, mokwalama na mokwabya ng'okʉndɨ. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" /><char style="w" lemma="Bafarisayo:">aBafarisayo</char> mobathoka aho n'ɨya kola nama nga ko bangɨthɨsa Yesʉ.<verse eid="MAT 12:14" /></para>
  <para style="s">Omukoli yo washombolawa na Gongo</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Yesʉ abere amɨnya omwatsɨ oyo, mwathoka aho. Bandʉ bangɨ mobamʉkwama, naye mwalamya abakoni boshi. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Hewethuwe mwahangɨrabo kʉtsɨbʉ athɨ bathanalinda bamʉmɨnyɨsa ko bandʉ. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Mobyakoleka bithyo bʉshana bɨbererere ebɨnwa byanegenawa ɨtsʉkɨra <char style="w" lemma="Mʉmɨnyeretsɨ">omʉmɨnyeretsɨ</char> Isaya bɨthɨ:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />«Mʉshʉnge omukoli aye oyo nyashombolaga,</para>
  <para style="q1" vid="MAT 12:18">yo mʉtsɨɨrwa aye, yo nyamogeraga ɨshombola.</para>
  <para style="q1" vid="MAT 12:18">Nyandamuhirako <char style="w" lemma="Mʉthɨma Mwerʉ">oMʉthɨma</char> aye,</para>
  <para style="q1" vid="MAT 12:18">naye andafʉlɨra abandʉ b'ebɨhanda bw'obʉthʉnganene bwa Gongo.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Athɨndakʉbe bʉhaka na mʉndʉ kʉtse ɨhambala,</para>
  <para style="q1" vid="MAT 12:19">omʉlenge ʉwe athɨndonvwɨke mo mɨhengere.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Athɨndatse olʉsheke lufunyire, kʉtse itsimya orʉtambɨ lo lʉkɨnafʉmbagako muki,</para>
  <para style="q1" vid="MAT 12:20">andakola athyo ihika ko kɨro andahikya obʉthʉnganene kw'ɨthegeka.<verse eid="MAT 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21" />Mw'ɨtsɨna lɨwe, ebɨhanda byoshi byandayinihira ɨye.»<note caller="+" style="f"><char style="fr" closed="false">12:21 </char><char style="ft" closed="false">Soma Isaya 42:1-4.</char></note><verse eid="MAT 12:21" /></para>
  <para style="s">Yesʉ ahʉlwamo Belisebuli</para>
  <para style="r">(<ref loc="MRK 3:22-30">Mar 3:22-30</ref>; <ref loc="LUK 11:14-23">Luk 11:14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Aho mobalethera Yesʉ yo mʉndʉ yo wabyagako mʉtsɨmʉ. Omʉtsɨmʉ oyo abyaga niamuyiriremo mbumi na kɨtsɨrʉ. Yesʉ mwamulamya ihika ko kɨka mwathanga ɨshʉba negena n'ɨlola. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Abandʉ boshi mobashweka nɨabanegena bathɨ: «Oyu athalɨ Mʉgala wa <char style="w">Tawiti</char>?» <verse eid="MAT 12:23" /><verse number="24" style="v" sid="MAT 12:24" /><char style="w" lemma="Bafarisayo:">Hewethuwe aBafarisayo</char> babere bonvwa ebyo, mobanegena bathɨ: «Omʉndʉ oyu anagenda abɨnga emɨtsɨmʉ ko maka wa Belisebuli, mʉkʉlʉ w'emɨtsɨmʉ.» <verse eid="MAT 12:24" /><verse number="25" style="v" sid="MAT 12:25" />Yesʉ mw'ɨmɨnya emɨganɨtsye yabo, mwabwɨrabo athɨ: «Abandʉ b'obwamɨ bʉgʉma bamalwa ɨbo kw'ɨbo, obwamɨ obo nɨ bwashambʉkala. Na bikalani ba muyi mʉgʉma kʉtse bandʉ ba kɨhanda kɨgʉma bamalwa ɨbo kw'ɨbo, omuyi oyo kʉtse ekɨhanda ekyo nibithindimane. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" /><char style="w">Na Sitani</char> amaliitha <char style="w">Sitani</char>, nɨamayɨlwɨsa yowene. Aho obwamɨ bʉwe bwangimana bʉthɨ? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Na nyamabya nɨenyɨbɨnga emɨtsɨmʉ mɨbɨ kʉ maka wa Belisebuli, abɨga benyu ababɨngaro kʉ maka wa ndɨ? Nɨ bʉshana n'ekyo abɨga benyu abo bandabasoha. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Hewethuwe nyamabya nɨenyɨbɨnga emɨtsɨmʉ ko kagala k'oMʉthɨma wa Gongo, aho <char style="w" lemma="Bwamɨ bwa Gongo">oBwamɨ bwa Gongo</char> nibwamalire ibahikira.<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />«Kʉtse kandɨ omʉndʉ angɨngɨra athɨ mo nyʉmba y'omʉndʉ wa kagala, n'ipura obushoki bʉwe, athathangire agalinga omʉndʉ wa kagala oyo? Aho nɨmwanyaga ebyoshi bɨrɨ omwe. <verse eid="MAT 12:29" /><verse number="30" style="v" sid="MAT 12:30" />Oyo ʉthalɨ hagʉma nangye, nianyibayire, n'oyo ʉthalɨ akʉma-kʉma hagʉma nangye nɨapanza. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Nɨ bʉshana n'ekyo, enyɨbabwɨra nyɨthɨ: abandʉ bandaganyɨrwa obʉlɨ kɨtsɨbʉ n'obʉlɨ bʉhatsye, hewethuwe erɨhatsya ko <char style="w">Mʉthɨma Mwerʉ</char> lɨthɨndaganyɨrwe. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Obʉlɨ mʉndʉ woshi-woshi amanegena kɨnwa kɨbɨ kʉ <char style="w">Mʉgala w'oMʉndʉ</char>, ekyo andaganyɨrwakyo, hewethuwe amanegena kɨbɨ ko <char style="w">Mʉthɨma Mwerʉ</char> ekyo, athɨndaganyɨrwekyo ibye mo kɨhʉgo kɨno, ibye mo kɨhʉgo kyandahika.»<verse eid="MAT 12:32" /></para>
  <para style="s">Omʉthɨ n'ebiguma byawo</para>
  <para style="r">(<ref loc="LUK 6:43-45">Luk 6:43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />«Omʉthɨ amabya akwirire, ebiguma byago nabyo kuthyo nɨbyakwɨra, n'omʉthɨ amabya mʉbɨ, ebiguma byago kuthyo nibyabya bɨbɨ. Kʉshangwa omʉthɨ anamɨnyɨrwa ko biguma byawo. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Imwe lʉbʉtho lwa nzoka! Mwanganegena mʉthɨ bɨnwa bikwirire imwe bandʉ babɨ? Kʉshangwa obʉnʉ obʉnanegena ebyo byotswire mo mʉthɨma. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Omʉndʉ yo ukwirire anathokya bɨndʉ bikwirire mo mbɨko yɨwe mbʉya, n'omʉndʉ mʉbɨ anathokya bɨndʉ bɨbɨ mo mbɨko yɨwe mbɨ. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Enyɨbabwɨra nyɨthɨ ekɨro ky'esohi, abandʉ bandathonda ko bʉlɨ kɨnwa kyoshi kya bʉsha-bʉsha banegenaga. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Kʉshangwa wandasɨndana kʉtse wandasɨndwa ɨkwamana n'ebɨnwa byawe.»<verse eid="MAT 12:37" /></para>
  <para style="s">aBafarisayo abashaba kɨmɨnyɨkalo</para>
  <para style="r">(<ref loc="MRK 8:11-12">Mar 8:11-12</ref>; <ref loc="LUK 11:29-32">Luk 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Aho <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">bakangɨrɨtsya bagʉma b'oMʉgomba</char> na <char style="w" lemma="Bafarisayo:">Bafarisayo</char> bagʉma mobabwɨra Yesʉ bathɨ: «Mʉkangɨrɨtsya, othushondya uthukangye kɨmɨnyɨkalo.» <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" />Yesʉ mwashʉbɨtsyabo athɨ: «Bandʉ ba lʉgero lʉbɨ na lwa bashɨngɨtsɨ bo bashondya kɨmɨnyɨkalo. Hewethuwe bathɨndahabwe kɨndɨ kɨmɨnyɨkalo kɨthalɨ eky' <char style="w" lemma="Mʉmɨnyeretsɨ">omʉmɨnyeretsɨ</char> Yona. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Kʉshangwa nga ko Yona amalaga bɨro bɨshathʉ kɨro na mwɨshɨ mo nda y'erihere inene, kuthyo <char style="w">oMʉgala w'oMʉndʉ</char> andamala bɨro bɨshathʉ, kɨro na mwɨshɨ, mo nda kɨthaka. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Ekɨro ky'esohi, abandʉ b'iNinawi band'imana hagʉma n'abandʉ b'olʉgero lʉno n'ɨsohabo. Kʉshangwa mobabɨndʉka ɨthoka mo bɨtsɨbʉ byabo ɨkwamana n'amakangɨrɨtsya wa Yona.<note caller="+" style="f"><char style="fr" closed="false">12:41 </char><char style="ft" closed="false">Soma Yona 3:5.</char></note> Na hano halɨ mʉkʉlʉ kʉ Yona! <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Na kuthyo, ekɨro ky'esohi, omʉgole w'oko Lʉnda Kihya andimana embere s'abandʉ b'olʉgero lʉno n'ɨsohabo. Kʉshangwa mwathoka mʉ kɨhʉgo kya hale bʉshana n'ɨonvwa ebɨnwa by'obwenge by'omwamɨ Solomona. Na hano halɨ mʉkʉlʉ kʉ Solomona.<verse eid="MAT 12:42" /></para>
  <para style="s">Omʉtsɨmʉ ashʉba ko mʉndʉ</para>
  <para style="r">(<ref loc="LUK 11:24-26">Luk 11:24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />«Mo ndambi omʉtsɨmʉ athoka ko mʉndʉ, anayathimba-thimba mo <char style="w">mbwarara</char> mw'ishondya handʉ angalʉhʉkɨra. Naye amabʉshaho, <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />nɨanegena athɨ: “Nyashʉbaya mo nyʉmba aye mo nyɨthathoka.” Mw'ihikamo, ameyamo nɨ mʉthalɨ mʉndʉ, nɨ mubitsibwe na nɨ mukwirire. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Aho nɨyayenda yɨndɨ mɨtsɨmʉ ɨrɨnda, mɨbɨ kʉlenga ɨye, naro nɨyɨngɨramo n'ikalamo. Aho emɨbere minyuma y'omʉndʉ oyo niyabya mɨbɨ kʉlenga emɨmbere. Na bithyo ko byandabya ko bandʉ b'olʉgero lʉbɨ lʉno.»<verse eid="MAT 12:45" /></para>
  <para style="s">Nyinya na bagala babo Yesʉ</para>
  <para style="r">(<ref loc="MRK 3:31-35">Mar 3:31-35</ref>; <ref loc="LUK 8:19-21">Luk 8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Yesʉ abere anemʉnegena n'omuhindano, nyinya na bagala babo babyaga nibimene embʉga niabashondya ɨsɨmola naye. [<verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Mʉndʉ mʉgʉma mwamʉbwɨra athɨ: «Shʉnga, nyoko na bagala benyu bimene embʉga abashondya ɨsɨmola nawe.»] <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />Yesʉ mwashʉbɨtsya omʉndʉ oyo athɨ: «Ɨndɨ yo malɨ na bahɨ bo bagala bethʉ?» <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Honyuma kw'aho, mwakangya <char style="w">abɨga</char> bʉwe bw'omunwe n'ɨnegena athɨ: «Aba bo malɨ na bagala bethʉ. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Bʉlɨ mʉndʉ woshi-woshi yo ʉkola erishondya lya Thatha yo ʉlɨ mo lʉbʉla, oyo yo mʉgala ethʉ, na mwalɨ wethʉ na malɨ.»<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Omushinga w'omuheri wa mbʉtho</para>
  <para style="r">(<ref loc="MRK 4:1-9">Mar 4:1-9</ref>; <ref loc="LUK 8:4-8">Luk 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Mona kɨro ekyo, Yesʉ mwathoka mo nyʉmba n'iyikala emʉsɨke w'engetsɨ. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Bandʉ bangɨ mobahindana hofɨ naye. Bʉshana n'ekyo mwashambɨra mʉ bwatho n'ikala mʉbo. N'abandʉ babyaga nibimene emʉsɨke w'engetsɨ. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Mwasɨmolerabo bɨnwa bɨngɨ mo mishinga n'ɨbwɨrabo athɨ: «Muheri mʉgʉma mwaya mw'ɨshwa lɨwe bʉshana n'ɨya hera. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Abere anemʉhera, mbʉtho ngʉma mosathogera emʉsɨke w'enzɨra, ebɨronge mobyahika n'irya esoshi. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Esɨndɨ mbʉtho mosathogera ko kɨthaka kya mabwe, aho hathabyaga bʉthaka bʉngɨ. Esombʉtho etho mosalasha tsʉba kʉshangwa hathabyaga bʉthaka bʉngɨ. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Hewethuwe erɨshɨ lyabere lyakola kʉtsɨbʉ, esombʉtho mosashashʉka, kʉshangwa mosabʉsha mirihi, mosʉma. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Sɨndɨ mbʉtho mosathogongera mo mɨshakɨ, Emɨshakɨ eyo moyalasha na moyayɨndɨrɨtsyatho. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Sɨndɨ mbʉtho mosathogera ko kɨthaka kikwirire na mosaheka biguma. Biguma bɨgʉma mobyaheka mbulu igana, n'ebɨndɨ kɨrathʉ n'ebɨndɨ makumi ashathʉ. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Yo uwithe mathwi w'ɨonvwa onvwe!»<verse eid="MAT 13:9" /></para>
  <para style="s">Bʉshana na ki Yesʉ anegena mo mishinga</para>
  <para style="r">(<ref loc="MRK 4:10-12">Mar 4:10-12</ref>; <ref loc="LUK 8:9-10">Luk 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />
    <char style="w">Abɨga</char> mobayɨfʉnda hofɨ na Yesʉ n'ɨmʉbʉtsya bathɨ: «Bʉshana na ki ʉnegena n'abandʉ mo mishinga?» <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />Mwashʉbɨtsyabo athɨ: «Imwe momwabona lʉkogo lw'erɨmɨnya sonyɨfʉmɨ s'oBwamɨ bw'elʉbʉla, he ɨbo, mobathabonalo. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Kʉshangwa yo uwithe kɨndʉ andahabwa kalengyo, aho andayɨra bɨndʉ bɨngɨ. He yo uthawithe andanyagʉlwa n'akake awitheko. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Shʉnga, ekyo kɨreka nɨnyanegena nabo mo mishinga nɨ bʉshana abashʉnga he bathalɨ abalola na abahʉlɨkɨrɨtsya he bathalɨ abonvwa n'ɨmɨnya. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />Aho obʉmɨnyeretsɨ bwa Isaya bwamabererera kʉbo bo bunegenire bʉthɨ:</para>
  <para style="q1" vid="MAT 13:14">“Erɨonvwa mwand'onvwa, he mʉthɨndamɨnye,</para>
  <para style="q1" vid="MAT 13:14">Erɨshʉnga mwandashʉnga, he mʉthɨndalole.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Kʉshangwa emɨthɨma y'abandʉ aba nɨ mɨtsɨbʉ,</para>
  <para style="q1" vid="MAT 13:15">na babere ba mathwi matsɨbʉ,</para>
  <para style="q1" vid="MAT 13:15">bamalire ɨtsɨba amesho wabo</para>
  <para style="q1" vid="MAT 13:15">kʉshangwa bathalolaga,</para>
  <para style="q1" vid="MAT 13:15">na bathonvwaga mo mathwi wabo,</para>
  <para style="q1" vid="MAT 13:15">na bathamɨnyaga mo mɨthɨma yabo,</para>
  <para style="q1" vid="MAT 13:15">bathangandabɨndʉka nangye nyihike kw'ilamyabo.”<note caller="+" style="f"><char style="fr" closed="false">13:15 </char><char style="ft" closed="false">Soma Isaya 6:9-10.</char></note><verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />«Hewethuwe imwe, mʉgashanɨrwe kʉshangwa amesho enyu alola, n'amathwi enyu onvwa. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Kwenene enyɨbabwɨra <char style="w" lemma="Mʉmɨnyeretsɨ">bamɨnyeretsɨ</char> bangɨ na bandʉ bangɨ bathʉnganene mobashondya ɨlola ko by'omʉlolako, he mobathalola kʉbyo, na mobashondya ɨonvwa eby'omonvwa, he mobathonvwabyo.»<verse eid="MAT 13:17" /></para>
  <para style="s">Yesʉ akumbulira omushinga w'omuheri w'embʉtho</para>
  <para style="r">(<ref loc="MRK 4:13-20">Mar 4:13-20</ref>; <ref loc="LUK 8:11-15">Luk 8:11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />«Ewo, imwe mwonvwe nga k'omushinga w'omuheri w'embʉtho oyo anegenire. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Obʉlɨ mʉndʉ yo wonvwa ekɨnwa ky'oBwamɨ bwa Gongo bʉthamɨnyakyo, ashoshekanibwe n'esombʉtho so sathogeraga emʉsɨke w'enzɨra. Enzigu Sitani anahika n'ithokya eKɨnwa kyaherawa mo mʉthɨma ʉwe. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Esombʉtho so saherawa ko bʉthaka bʉlɨmo amabwe, sishoshekanibwe na mʉndʉ yo wonvwa eKɨnwa kya Gongo n'ɨkokyako mo lʉmogo, <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />hewethuwe kithawithe mirihi mo mʉthɨma ʉwe. Abanashikyakyo kʉ ndambɨ nge. Aho, amalɨgo kʉtse inubibwa ebinabya byahika bʉshana n'eKɨnwa kya Gongo, nɨathoka mo lwɨkɨrɨtsyo lʉwe. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Esombʉtho sosaherawa mo mɨshakɨ, sishoshekanibwe na mʉndʉ yo wonvwa eKɨnwa kya Gongo, hewethuwe ebyo mo kɨhʉgo kɨno n'erɨrengwako ly'obushoki n'ɨbyayɨndɨrɨtsya eKɨnwa ekyo, nakyo ni kyabya bʉthabʉtha. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Esombʉtho so saherawa mo kɨthaka kikwirire, sishoshekanibwe na mʉndʉ yo wonvwa eKɨnwa n'ɨmɨnyakyo. Aho anaheka biguma, n'ekiguma kɨgʉma nɨkyaheka mbulu igana n'ekɨndɨ kɨrathʉ, n'ekɨndɨ makumi ashathʉ.»<verse eid="MAT 13:23" /></para>
  <para style="s">Mushinga wa bɨthɨ bɨbɨ mw'ɨshwa ly'engano.</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Yesʉ mwatsɨrabo ʉndɨ mushinga athɨ: «oBwamɨ bw'elʉbʉla bushoshekanibwe na mʉndʉ yo waheraga mw'ɨshwa lɨwe mo mbʉtho ikwirire. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Abandʉ babere banagonzere, enzigu yo omʉndʉ oyo moyaya hera bɨthɨ bɨbɨ mo ngano, na moyayɨgendera. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Engano yabere yalasha n'ihulukya mathokwe, ebɨthɨ bɨbɨ kuthyo nabyo mobyahʉlʉka. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Abakoli b'omwenye erɨshwa mobaya mʉbwɨra bathɨ: “Mbe nyinya-kowethʉ, mouthaherire mbʉtho sikwirire mw'ɨshwa lyawe? Ewono ebɨthɨ bɨbɨ byamabʉthʉkamo hayi?” <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />Mwashʉbɨtsyabo athɨ: “Nɨ enzigu yo yakolaga ithyo.” Aho abakoli mobamʉbwɨra bathɨ: “Wanzire nɨthwayakʉlanga ebɨthɨ bɨbɨ ebyo?” <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Mwanegena athɨ: “Ɨhɨ, mw'ɨkʉlanga ebɨthɨ bɨbɨ ebyo, mwangalibukira nɨmwamakʉlanga n'engano. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Mulike ebyoshi bɨshʉkɨre hagʉma ihika ekɨro ky'erɨgesha. Nɨ mo kɨro ekyo monyandabwɨra abageshi bathange ɨkʉma-kʉma ebɨthɨ bɨbɨ, bamɨnebyo mo mɨganda-mɨganda bʉshana bokyebyo. Hewethuwe engano ɨro, bashongye-shongyero n'ihiraro mo mbʉpʉ aye.”»<verse eid="MAT 13:30" /></para>
  <para style="s">Mushinga w'akambulu k'eharatali</para>
  <para style="r">(<ref loc="MRK 4:30-32">Mar 4:30-32</ref>; <ref loc="LUK 13:18-19">Luk 13:18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Yesʉ mwashʉba tsɨrabo ʉndɨ mushinga athɨ: «oBwamɨ bw'elʉbʉla bushoshekanibwe na kambulu k'eharatali, ko mʉndʉ mʉgʉma atsɨmbaga nɨyaherako mw'ɨshwa lɨwe. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Ako ko kambulu kake mo mbʉtho soshi, hewethuwe akanabya kamamala ɨlasha nɨkabya kanene mo myaka yɨrɨ mw'ɨshwa, na nikabya mʉthɨ, ihika ko kɨka ebɨronge by'omo kyanya nibyaya himba sonyʉthʉ sabyo ko mɨthahɨ yawo.»<verse eid="MAT 13:32" /></para>
  <para style="s">Mushinga wa tsatsʉ</para>
  <para style="r">(<ref loc="LUK 13:20-21">Luk 13:20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Yesʉ mwashʉba bwɨra abandʉ abo bo ʉndɨ mushinga athɨ: «oBwamɨ bw'elʉbʉla bushoshekanibwe nga <char style="w" lemma="Tsatsʉ">tsatsʉ</char> yo mʉkatsɨ mʉgʉma atsɨmbaga n'ithulunganiaro mʉ hɨthonga hɨshathʉ hya shyano bʉshana atsʉmbe bʉndʉ bwa mikati, ihika ko kɨka ebyoshi mobyabimba.»<verse eid="MAT 13:33" /></para>
  <para style="s">Ɨkangɨrɨtsya lya Yesʉ mo mishinga</para>
  <para style="r">(<ref loc="MRK 4:33-34">Mar 4:33-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Ebyoshi ebyo Yesʉ mwabwɨrabyo omuhindano mʉ mishinga, athagenda abwɨrabo kɨndʉ ɨthalɨ mu mishinga. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Agenda akola athyo bʉshana kɨberere ekɨnwa kyanegenawa kw'ɨtsʉkɨra <char style="w" lemma="Mʉmɨnyeretsɨ">omʉmɨnyeretsɨ</char> athɨ:</para>
  <para style="q1" vid="MAT 13:35">«Nyandanegena mo mishinga,</para>
  <para style="q1" vid="MAT 13:35">na nyandanegena bɨndʉ bya bishawa ɨthanga ko ndangɨro y'ekɨhʉgo.»<note caller="+" style="f"><char style="fr" closed="false">13:35 </char><char style="ft" closed="false">Soma Saburi 78:2.</char></note><verse eid="MAT 13:35" /></para>
  <para style="s">Yesʉ akumbulira omushinga w'ebɨthɨ bɨbɨ</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Honyuma kw'aho Yesʉ mwamika omuhindano, mwashʉba mo nyʉmba. <char style="w" lemma="Abɨga">Abɨga</char> bʉwe mobayɨfʉnda hofɨ naye n'ɨmʉbwɨra bathɨ: «Thukumbulire omushinga oyo w'ebɨthɨ bɨbɨ mw'ɨshwa.» <verse eid="MAT 13:36" /><verse number="37" style="v" sid="MAT 13:37" />Yesʉ mwashʉbɨtsyabo athɨ: «Oyo ʉhera embʉtho ikwirire nɨ <char style="w">oMʉgala w'oMʉndʉ</char>. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />N'erɨshwa nɨ ekɨhʉgo. Embʉtho ikwirire nɨ abana b'oBwamɨ bwa Gongo. Ebɨthɨ bɨbɨ nɨ abana b'omubihya Sitani. <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />Enzigu yo yaheraga ebɨthɨ bɨbɨ nɨ <char style="w">Sitani</char>. Emyaka nɨ enduli y'ekɨhʉgo, abageshi nɨ <char style="w" lemma="Malaɨka">abamalaɨka</char>. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Nga ko abanakʉma-kʉma ebɨthɨ bɨbɨ bʉshana n'iokyabyo mo mʉtsanwa, kuthyo ko byandabya ko nduli y'ekɨhʉgo. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />oMʉgala w'omʉndʉ andathʉma abamalaɨka bʉwe, nabo bandakʉma-kʉma ɨthoka mo Bwamɨ bʉwe abo banaletha kɨtsɨkalo n'abakoli b'ebɨbɨ. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Na bandagʉshabo mo kiriko ky'omʉtsanwa, aho handabya bɨrɨro n'ishya meno. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Hewethuwe abathʉnganene ɨbo bandangenga ng'erɨshɨ mo Bwamɨ bw'Ishe wabo. Yo ʉlɨko mathwi w'ɨonvwa, onvwe!»<verse eid="MAT 13:43" /></para>
  <para style="s">Omushinga w'obushoki bubishirwe</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />«oBwamɨ bw'elʉbʉla bushoshekanibwe na bushoki bo bwabyaga bubishirwe mw'ɨshwa. Mʉndʉ mʉgʉma mwashʉngabo. Omʉndʉ oyo mwashʉba bishabo buhya-buhya, mwagenda niamoyire, n'ɨyagʉtsya ebyoshi abyaga awitheko n'ɨyagʉla erɨshwa eryo.<verse eid="MAT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />«Kandɨ oBwamɨ bw'elʉbʉla bushoshekanibwe na muhingania yo wagenda ashondya bʉlema bwa kɨtsɨro kɨnene. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Abere ashʉnga olʉlema lwa kɨtsɨro kɨnene, mwayagʉtsya ebyoshi abyaga awitheko n'ɨyagʉlalo.»<verse eid="MAT 13:46" /></para>
  <para style="s">Omushinga w'akakira</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />«oBwamɨ bw'elʉbʉla bushoshekanibwe kandɨ n'akakira kokanagʉshwa mo ngetsɨ n'ishongya emɨhanda yoshi y'amahere. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Mo ndambi akakira kamotsula, abarobi nɨbakʉrɨrako emʉsɨke. Honyuma kw'aho, nibikala n'ɨshombola amahere akwirire n'ihirawo mo bɨthonga, n'ɨgʉsha ow'athakwirire. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Ni bithyo ko byandabya ko nduli y'ekɨhʉgo. Aho <char style="w" lemma="Malaɨka">abamalaɨka</char> bandahika na bandagabania ababɨ n'abathʉnganene. <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />Nabo bandagʉsha ababɨ mo kiriko ky'omʉtsanwa, aho handabya bɨrɨro n'ishya ameno.»<verse eid="MAT 13:50" /></para>
  <para style="s">Ebɨndʉ bihya-bihya n'ebya kera</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />«Yesʉ mwabʉtsya abɨga bʉwe athɨ: “Mwanamamɨnya ebyoshi ebyo?” Mobamʉshʉbɨtsya bathɨ: “Ega” <verse eid="MAT 13:51" /><verse number="52" style="v" sid="MAT 13:52" />Mwabwɨrabo athɨ: “Aho, bʉlɨ mushaki w'oMʉgomba yo wakangɨrɨtsɨbawa ebɨnwa by'oBwamɨ bw'elʉbʉla, ashoshekanibwe na mwenye nyʉmba yo uthokya mo mbɨko yɨwe mw'ebɨndʉ bihya-bihya n'ebya kera.”»<verse eid="MAT 13:52" /></para>
  <para style="s">Yesʉ athɨndwa ewabo</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Yesʉ abere amamala ɨtsa emishinga eyo, mwathokayo. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Abere ahika mo kɨhʉgo kɨwe, mwakangɨrɨtsya abahimbani mo <char style="w" lemma="Sinakoki:">sinakoki</char> yabo, ihika ko kɨka abandʉ mobashweka nɨabanegena bathɨ: <note caller="+" style="f"><char style="fr" closed="false">13:54 </char><char style="ft" closed="false">Kɨhʉgo kɨwe</char><char style="ft" closed="false">: Nɨ negena mbʉ: Ekɨhʉgo ky'eNasareti. Soma Luk 4:146. </char></note>«Amathokya obwenge obu bo hayi, n'amaka w'erɨkola ebɨthɨko-thɨko? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Oyu athalɨ omʉgala w'omʉsapate? Na nyinya ʉwe athalɨ anahʉlwamo Marɨa? Na bagala babo bathalɨ Yakobo na Yosefʉ na Simoni na Yuta? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Na balɨ babo boshi bathalɨ kowethʉ? Ebyoshi ebi athokyabyo hayi?» <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Ebyo mobyaleka nɨbathamwɨkɨrɨtsya. Aho Yesʉ mwabwɨrabo athɨ: «<char style="w" lemma="Mʉmɨnyeretsɨ">Omʉmɨnyeretsɨ</char> athalɨ anashikibwa mo kɨhʉgo kɨwe n'omo muyi ʉwe.»<note caller="+" style="f"><char style="fr" closed="false">13:57 </char><char style="ft" closed="false">Soma Luka 4:24; Yoani 4:44.</char></note> <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Eyo, Yesʉ mwathakolayo bɨthɨko-thɨko bɨngɨ bʉshana n'obʉthɨkɨrɨtsya bwabo.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Olʉholo lwa Yoani Mubatisya</para>
  <para style="r">(<ref loc="MRK 6:14-29">Mar 6:14-29</ref>; <ref loc="LUK 9:7-9">Luk 9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Mo bɨro ebyo, <char style="w">Herote</char> yo wabyaga muthegeki w'ekɨhʉgo ky'iNgalilaya, mwonvwa engʉlʉ ya Yesʉ. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />Aho mwabwɨra abakoli bʉwe athɨ: «Omʉlʉme oyu nɨ Yoani <char style="w" lemma="Lubatiso">Mubatisya</char> yo walubukire mo baholi! Ekyo kyo kɨreka niabya n'amaka w'erɨkola ebɨthɨko-thɨko.»<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />
    <char style="w">Herote</char> abyaga nɨamahamʉla batsɨmbe Yoani, bamʉmɨne na bamʉgʉshe mo biriso bʉshana na Herotia mʉka Filipo mʉgalabo. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Yoani agendaga abwɨra Herote athɨ: «Bithahamulirwe kw'ɨwe ɨthola Herotia!» <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Herote mwashondya itha Yoani, hewethuwe agendaga ʉbaha abandʉ kʉshangwa babyaga nɨbɨkɨrɨtsye ko Yoani nɨ <char style="w" lemma="mʉmɨnyeretsɨ">mʉmɨnyeretsɨ</char>. <verse eid="MAT 14:5" /><verse number="6" style="v" sid="MAT 14:6" />Ko kɨro ky'erɨbʉka erɨbʉthwa lya <char style="w">Herote</char>, mwalɨ wa Herotia mwatsɨna embere y'abo balalɨkawa, na mwamoya <char style="w">Herote</char>. <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />Aho mwamʉlaga mw'ɨlahɨtsya kw'amʉha ebyoshi amʉshaba. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Omʉthasha oyo, bʉshana n'erikunwa na nyinya ʉwe Herotia, mwabwɨra Herote athɨ: «Nyɨhe hano ko mbale, omuthwe wa Yoani <char style="w" lemma="Lubatiso">Mubatisya</char>!» <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Omwamɨ mwathabagana. He bʉshana n'erɨlahɨtsya lɨwe embere y'abo balalɨkawa, mwahamʉla athɨ bahe omʉthasha y'omuthwe wa Yoani. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Aho, mwathʉma mʉndʉ ayatse omuthwe wa Yoani Mubatisya mo muliki. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Mobaletha omuthwe ʉwe ko mbale n'ɨhawo omʉthasha oyo, naye mwathwalɨrawo nyinya. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" /><char style="w">Abɨga</char> ba Yoani mobayenda ekinda kɨwe n'ɨyathakyo. Honyuma kw'aho mobayabwɨra Yesʉ y'omwatsɨ oyo.<verse eid="MAT 14:12" /></para>
  <para style="s">Yesʉ alɨsa bandʉ hofɨ bɨhʉmbɨ bɨthano.</para>
  <para style="r">(<ref loc="MRK 6:30-44">Mar 6:30-44</ref>; <ref loc="LUK 9:10-17">Luk 9:10-17</ref>; <ref loc="JHN 6:1-14">Yoa 6:1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Yesʉ abere onvwa omwatsɨ oyo, mwathoka aho mʉ bwatho n'ɨya aho <char style="w" lemma="Mbwarara">hathalɨ bandʉ</char>. Bandʉ bangɨ babere bonvwa bathyo, mobathoka mo miyi yabo n'ɨmʉkwama mʉ bɨshando. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Yesʉ abere athoka mo bwatho, mwashʉnga bandʉ bangɨ, mwafwɨrabo shashi na mwathanga ilamya abakoni babo. <verse eid="MAT 14:14" /><verse number="15" style="v" sid="MAT 14:15" />Bwabere bwahika igolo, <char style="w">abɨga</char> bʉwe mobayɨfʉnda hofɨ naye n'ɨmʉbwɨra bathɨ: «Aho thʉlɨ hano <char style="w" lemma="Mbwarara">hathalɨ bandʉ</char> n'endambi yamatsʉka, shʉbʉtsya abandʉ bagende mo miyi bʉshana bayayɨʉlɨre kalyo.» <verse eid="MAT 14:15" /><verse number="16" style="v" sid="MAT 14:16" />Hewethuwe Yesʉ mwashʉbɨtsyabo athɨ: «Bathalayire kw'ɨyayo, imwe bene mʉhebo kalyo!» <verse eid="MAT 14:16" /><verse number="17" style="v" sid="MAT 14:17" />Aho, mobamʉbwɨra bathɨ: «Thuwite hano ku mikati ithano mɨsha na mahere abɨrɨ.» <verse eid="MAT 14:17" /><verse number="18" style="v" sid="MAT 14:18" />Yesʉ mwabwɨrabo athɨ: «Mʉnyɨretherebyo hano.» <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Honyuma kw'aho, mwahamʉla abandʉ bikale ko bɨthɨ. Mwatsɨmba emikati ithano eyo n'amahere abɨrɨ, mwashʉmbɨra amesho w'elʉbʉla na mwasɨma Gongo. Mwatsitsanga emikati eyo, na mwaharo <char style="w" lemma="abɨga">abɨga</char>, nabo mobagabɨraro abandʉ. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Aboshi mobalya na mobugutha, abɨga mobakʉma-kʉma bɨthonga ikumi na bɨbɨrɨ by'ebɨtse-bɨtse byashakaga. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Abandʉ bo balyaga babyaga hofɨ bɨhʉmbɨ bɨthano, bʉthaganza abakatsɨ n'abana.<verse eid="MAT 14:21" /></para>
  <para style="s">Yesʉ agendera ko ngetsɨ</para>
  <para style="r">(<ref loc="MRK 6:45-52">Mar 6:45-52</ref>; <ref loc="JHN 6:15-21">Yoa 6:15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Honyuma w'ebyo, aho n'aho Yesʉ mwahamʉla <char style="w">abɨga</char> bʉwe bɨrʉkɨre mo bwatho bʉshana bamʉthange ko ʉndɨ mwishirya w'engetsɨ, mo ndambi eyo ɨye mwashiba alɨalaga omuhindano. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Abere amamala ɨlaga omuhindano, mwɨrʉkɨra kʉ kɨthwa yowene bʉshana n'ɨya shaba. Mobwagoroba nɨanalɨyo yowene. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Obwatho bwabyaga nɨbwahera kʉ ma metere magana ɨthoka ko kɨthaka. N'emibimbi yagenda eyiyihumanga ko bwatho kʉshangwa ekɨhʉnga kyagenda ekɨhʉlʉkabo embere. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />Bwabere bwabya mʉhʉho, Yesʉ mwahikira abɨga bʉwe nɨagenda elʉgʉlʉ w'engetsɨ. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" /><char style="w">Abɨga</char> babere bamʉshʉnga alɨagenda elʉgʉlʉ w'engetsɨ, mobafwa bʉba n'ɨnegena bathɨ: «Eki nɨ kɨhɨndɨ!» Mobathanga ɨhambala bʉshana n'obʉba. <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />Hewethuwe, aho n'aho Yesʉ mwabwɨrabo athɨ: «Mushikye emɨthɨma, n'ingye, mʉthʉbahaga!» <verse eid="MAT 14:27" /><verse number="28" style="v" sid="MAT 14:28" />Aho Petero mwamʉbwɨra athɨ: «Nyinya-kowethʉ, wamabya nɨ ɨwe, nyɨhamʉle nyihike eyo ʉlɨ nɨenyɨgendera ko metsi. <verse eid="MAT 14:28" /><verse number="29" style="v" sid="MAT 14:29" />Yesʉ mwamʉbwɨra athɨ: “Hika!”»</para>
  <para style="p" vid="MAT 14:29">Petero mwakima mo bwatho, mwagenda elʉgʉlʉ y'ametsi na mwaya eyɨrɨ Yesʉ. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Hewethuwe abere ashʉnga ko kɨhʉnga, mwafwa bʉba. Na mwathanga ɨthobera mo metsi, mwalaka athɨ: «Nyinya-kowethʉ nyɨshabʉle!» <verse eid="MAT 14:30" /><verse number="31" style="v" sid="MAT 14:31" />Aho n'aho Yesʉ mwalambʉla okʉboko kʉwe, mwamʉtsɨmba, n'ɨmʉbwɨra athɨ: «Ɨwe mʉndʉ w'olwɨkɨrɨtsyo lʉke! Bʉshana na ki moʉthɨka-thɨka?» <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />Yesʉ na Petero babere bashambɨra mo bwatho, ekɨhʉnga mokyathulera. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Abo babyaga mo bwatho mobafʉkamɨra Yesʉ n'ɨnegena bathɨ: «Kwenene ʉlɨ Mʉgala wa Gongo!»<verse eid="MAT 14:33" /></para>
  <para style="s">Yesʉ alamya bakoni iNgenesareti</para>
  <para style="r">(<ref loc="MRK 6:53-56">Mar 6:53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Babere bamamala ɨshabʉka engetsɨ, mobahika mo kɨhʉgo ky'iNgenesareti. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Abandʉ bayo mobamɨnyerera Yesʉ, na mobabwɨra abandʉ boshi b'omo kɨhʉgo ekyo, na mobamʉlethera abakoni boshi. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Mobamʉshaba bathɨ ahamʉlebo bakole ko pindo y'olʉkɨmba lʉwe. N'abakoni boshi bo bakolaga kʉro mobalama.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">Yesʉ n'emɨbere y'aBafarisayo</para>
  <para style="r">(<ref loc="MRK 7:1-13">Mar 7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Aho <char style="w" lemma="aBafarisayo">aBafarisayo</char> hagʉma <char style="w" lemma="Bakangɨrɨtsya">n'aBakangɨrɨtsya</char> b'oMʉgomba bagenda abathoka ɨYerʉsalemʉ. Mobahikira Yesʉ n'ɨmʉbʉtsya bathɨ: <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />«Bʉshana na ki <char style="w">abɨga</char> bawe abahaba ko mɨbere ya bo thatha-kʉlʉ? Kʉshangwa bathalɨ abananaba ko minwe embere balye.<note caller="+" style="f"><char style="fr" closed="false">15:2 </char><char style="ft" closed="false">Soma Luka 11:38.</char></note>» <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />Yesʉ mwashʉbɨtsyabo athɨ: «Nemwe bʉshana na ki omʉnahaba ko Mʉgomba wa Gongo mw'ɨkwama emɨbere enyu? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Kʉshangwa Gongo mwanegena athɨ: “Shikya sho na nyoko,” na kandɨ yo ʉthakɨra ishe na nyinya lɨtholere n'ithwa.<note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="ft" closed="false">Soma Ɨthoka 20:17; Ɨbʉka Mʉgomba 5:16; Ɨthoka 21:17; Balawi 20:9.</char></note> <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Hewethuwe imwe omʉnanegena mʉthɨ: “Omʉndʉ amabwɨra ishe kʉtse nyinya athɨ: Obuwathikya bo nyangakʉhere bʉshana n'ikuwathikya, nɨ bʉhere bo nyamalire ithegekania bʉshana n'ɨhabo Gongo.” <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Aho nɨomʉnegena mʉthɨ bɨthakɨtholere ishikya ishe kʉtse nyinya mo buwathikya obo. N'aho mwamalire ibihya eKɨnwa kya Gongo bʉshana n'erishikya emɨbere enyu. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Imwe bayimbya! Isaya mwamɨnyerera kʉbʉya bʉshana nemwe, abere anegena athɨ:<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />“Abandʉ aba banyishikitsye mo bʉnʉ</para>
  <para style="q1" vid="MAT 15:8">hewethuwe emɨthɨma yabo yɨrɨ hale nangye kʉtsɨbʉ.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Erinyiramya lyo banyiramya nɨ lya bʉsha-bʉsha.</para>
  <para style="q1" vid="MAT 15:9">Kʉshangwa amakangɨrɨtsya awo abakangɨrɨtsya nɨ mathegeko wa bandʉ.”<note caller="+" style="f"><char style="fr" closed="false">15:9 </char><char style="ft" closed="false">(ahwirwe ɨkwamana n'amashako wa kera w'ekikiriki.) </char></note>»<verse eid="MAT 15:9" /></para>
  <para style="s">Ebɨndʉ byo bɨnaletha obubihya</para>
  <para style="r">(<ref loc="MRK 7:14-23">Mar 7:14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Honyuma kw'aho Yesʉ mwashʉba bɨrɨkɨra omuhindano n'ɨnegena athɨ: «Mʉhʉlɨkɨrɨtsye na mʉmɨnye kʉbʉya. <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Kɨthalɨ ekyo ekɨnɨngɨra mo bʉnʉ bw'omʉndʉ kyo kinamubihya. Hewethuwe nɨ ekyo kɨthoka mo bʉnʉ bʉwe, kyo kinamubihya.»<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Aho <char style="w">abɨga</char> mobayɨfʉnda hofɨ naye n'ɨmʉbwɨra bathɨ: «Wetsi ko <char style="w" lemma="Bafarisayo:">aBafarisayo</char> bathabere bonvwa ekɨnwa ekyo mobagalɨrwa kʉtsɨbʉ?» <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" />Yesʉ mwashubya athɨ: «Omwaka woshi wo Thatha w'omo lʉbʉla athaheraga andakʉlwa. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Mulikebo, abo nɨ mbumi bobashondolere esombumi! N'embumi yamashondolera eyɨndɨ mbumi, ababɨrɨ boshi nɨbathogera mo kyuna.»<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Aho Petero mwashubya n'ɨmʉbwɨra athɨ: «Thʉsonzomolere omushinga oyu.» <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />Yesʉ mwashubya athɨ: «Nemwe kuthyo muthetsi mwamɨnya kʉbʉya? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Muthetsi kw'ebyoshi byo bɨnɨngɨra mo bʉnʉ bw'omʉndʉ ebɨnatsʉka mo nda, na honyuma kw'aho nɨbyagʉshwa mo bwɨga? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Hewethuwe ebyo bɨthoka mo bʉnʉ ebɨnathoka mo mʉthɨma. N'ebyo byo binabihya omʉndʉ. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Kʉshangwa mo mʉthɨma momʉnathoka emɨganɨtsye mɨbɨ, obwithi, orʉsɨngɨ, erɨgenda na muyira wa bene kʉtse erɨgenda na mʉkatsɨ wa bene, bwɨtsɨ, erɨrega abandɨ, n'erihangya. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Ebyo, byo binabihya omʉndʉ! Hewethuwe erirya bʉthanaba ko minwe lithabihya mʉndʉ.»<verse eid="MAT 15:20" /></para>
  <para style="s">Lwɨkɨrɨtsyo lw'omʉkatsɨ Mʉkanana</para>
  <para style="r">(<ref loc="MRK 7:24-30">Mar 7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Yesʉ mwathoka aho mwaya mo kɨhʉgo ky'iTiro na ky'iSitona. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Aho, mʉkatsɨ mʉgʉma Mʉkanana yo wabyaga ikere mo kɨhʉgo ekyo, mwamuhikira nɨahambala athɨ: «Nyinya-kowethʉ, Mʉgala wa <char style="w">Tawiti,</char> nyɨshashɨre! Omʉthasha aye alɨko mɨtsɨmʉ mɨbɨ, eyɨmwagatsya kʉtsɨbʉ!» <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />Hewethuwe Yesʉ mwathamʉshʉbɨtsya kɨnwa n'ekɨgʉma. <char style="w">Abɨga</char> bʉwe mobayɨfʉnda hofɨ naye n'ɨmʉshaba bathɨ: «Mʉshʉbʉtsye, kʉshangwa athukwamire n'ɨthʉkendetsya mw'ɨhambala lɨwe.» <verse eid="MAT 15:23" /><verse number="24" style="v" sid="MAT 15:24" />Yesʉ mwashubya athɨ: «Nyɨthathʉmawa lɨthalɨ ko bana <char style="w" lemma="Isiraeli">b'iIsiraeli</char> bo balɨ nga mbuli siherire.» <verse eid="MAT 15:24" /><verse number="25" style="v" sid="MAT 15:25" />Hewethuwe omʉkatsɨ oyo mwahika n'ɨfʉkama embere sɨwe n'ɨnegena athɨ: «Nyinya-kowethʉ, nyiwathikye!» <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />Yesʉ mwashubya athɨ: «Lithakwirire ɨtsɨmba akalyo k'abana n'ɨgʉshɨrako esombwa.» <verse eid="MAT 15:26" /><verse number="27" style="v" sid="MAT 15:27" />Omʉkatsɨ oyo mwamʉbwɨra athɨ: «Nɨ kwenene mbe Nyinya-kowethʉ, ndɨ n'esombwa natho esinalya ebɨshakɨtsya byo bɨnathogonga ko lʉwalɨ lwa bo nyinya-kowabo.» <verse eid="MAT 15:27" /><verse number="28" style="v" sid="MAT 15:28" />Aho Yesʉ mwamʉshʉbɨtsya athɨ: «Mʉkatsɨ, olwɨkɨrɨtsyo lwawe nɨ lʉnene! Bibye kw'ɨwe nga ko ushashire.» N'omʉthasha ʉwe mwalama kona kathambi ako.<verse eid="MAT 15:28" /></para>
  <para style="s">Yesʉ alamya bakoni bangɨ</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Yesʉ mwathoka eyo, mwatsʉka emʉsɨke w'engetsɨ y'iNgalilaya. Mwɨrʉkɨra ko kɨthwa na mwikalako. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Bandʉ bangɨ mobamuhikira, nɨabamʉlethera ebɨrema, esombumi, bo bashyonogera, ebirumbu na bandɨ bakoni bangɨ. Mobahirabo embere sa Yesʉ, naye mwalamyabo. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Abandʉ mobashweka babere bashʉnga ebirumbu byanegena, na bo bashyonogera bayɨsɨngɨka kʉbʉya, n'ebɨrema byagenda n'esombumi salola. Na mobasingya Gongo <char style="w" lemma="Isiraeli">w'iIsiraeli</char>.<verse eid="MAT 15:31" /></para>
  <para style="s">Yesʉ alɨsa bandʉ bɨhʉmbɨ bɨne.</para>
  <para style="r">(<ref loc="MRK 8:1-10">Mar 8:1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Yesʉ mwabɨrɨkɨra <char style="w">abɨga</char> bʉwe n'ɨbwɨrabo athɨ: «Nyamafwɨra abandʉ aba bo shashi, kʉshangwa byahera bɨro bɨshathʉ banalɨ nangye, na bathawithe kalyo. Kandɨ nyɨthalɨ enyishondya ɨshʉbʉtsyabo nɨ banawirire, bathangalekʉlɨra mo nzɨra.» <verse eid="MAT 15:32" /><verse number="33" style="v" sid="MAT 15:33" />Abɨga bʉwe mobamʉbwɨra bathɨ: «Thwabona mikati yo hayi mo mbwarara eno y'eryuguthya omuhindano mʉngana n'oyu?» <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />Yesʉ mwabwɨrabo athɨ: «Muwithe ku mikati ɨngahɨ?» Mobamʉshʉbɨtsya bathɨ: «Thuwithe ku mikati ɨrɨnda na thʉhere thʉlɨ bʉlebe.» <verse eid="MAT 15:34" /><verse number="35" style="v" sid="MAT 15:35" />Aho mwahamʉla omuhindano bikale ahishi. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Mwatsɨmba emikati ɨrɨnda eyo n'amahere, mwasɨma Gongo, mwatsitsangabyo n'ɨhabyo <char style="w">abɨga</char> bʉwe, n'<char style="w">abɨga</char> bʉwe mobagabɨrabyo abandʉ. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />N'aboshi mobalya n'iugutha. Abɨga mobaheka bɨthonga bɨrɨnda byotswiremo ebɨshakɨtsya. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Bo balyaga babyaga bayira bɨhʉmbɨ bɨne, bʉthaganza abakatsɨ n'abana.<verse eid="MAT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39" />Honyuma kw'aho Yesʉ abere amamala ɨlaga omuhindano, mwashambɨra mo bwatho, mwaya mo kɨhʉgo ky'iMangandani.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">aBafarisayo n'aBasandukayo abashaba kɨmɨnyɨkalo</para>
  <para style="r">(<ref loc="MRK 8:11-13">Mar 8:11-13</ref>; <ref loc="LUK 12:54-56">Luk 12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />
    <char style="w" lemma="Bafarisayo">aBafarisayo</char> n'aBasandukayo mobahikira Yesʉ niabashondya ɨmʉthega kɨnwa. Mobamʉshaba akangyebo kɨmɨnyɨkalo kyo kɨthoka elʉbʉla. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Hewethuwe Yesʉ mwashʉbɨtsyabo athɨ: [«Obunabya bwahika igolo nɨmwanegena mʉthɨ: “Mungya bwandakya kʉbʉya kʉshangwa obuthuku bukyere.” <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Na mo makera-kera, nɨmwanegena mʉthɨ: “Envʉla yawa munobwire kʉshangwa obuthuku buthukire. Omʉnamɨnya emɨbere y'obuthuku, ewono bʉshana na ki mʉthalɨ omʉmɨnya ebɨmɨnyɨkalo by'omʉgʉlʉ ono<note caller="+" style="f"><char style="fr" closed="false">16:3 </char><char style="ft" closed="false">Mashako mangɨ athalɨmo omʉlondo w'akabɨrɨ n'owakashathʉ.</char></note>!] <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Bandʉ b'olʉgero lʉbɨ na lʉshɨngɨtsɨ embere sa Gongo lolushondya kɨmɨnyɨkalo. Hewethuwe bathɨndahabwe kɨndɨ kɨmɨnyɨkalo kɨthalɨ ekya Yona.”<note caller="+" style="f"><char style="fr" closed="false">16:4 </char><char style="ft" closed="false">Lingania na 12:39-40.</char></note>» Honyuma kw'aho Yesʉ mwamikabo n'ɨyɨgendera.<verse eid="MAT 16:4" /></para>
  <para style="s">Etsatsʉ y'aBafarisayo n'aBasandukayo</para>
  <para style="r">(<ref loc="MRK 8:14-21">Mar 8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />
    <char style="w">Abɨga</char> ba Yesʉ babere bashabʉkɨra ko ʉndɨ mʉnda w'engetsɨ, mobɨbʉka ko mobɨbɨrɨrwa ɨheka emikati. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Aho Yesʉ mwabwɨrabo athɨ: «Ohe! Muyitheye ko <char style="w" lemma="Tsatsʉ">tsatsʉ</char> <char style="w" lemma="Bafarisayo:">y'aBafarisayo</char> n'aBasandukayo.» <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />Abɨga mobathanga ɨbwɨrana ɨbo kw'ɨbo bathɨ: «Anegena athyo kʉshangwa thuthahekire mikati.» <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />Yesʉ mwamɨnyerera ebyo bagenda abanegena, mwabʉtsyabo athɨ: «Imwe bandʉ ba lwɨkɨrɨtsyo lʉke, bʉshana na ki omuyinegenia imwe kw'imwe mʉthɨ muthawithe kʉ mikati? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Ihika munobwire muthanetsi mwamɨnya? Muthibukire emikati ithano yo y'uguthaya abandʉ bɨhʉmbɨ bɨthano, na momwaheka bɨthonga bɨngahɨ?<note caller="+" style="f"><char style="fr" closed="false">16:9 </char><char style="ft" closed="false">Lingania 14:15-21.</char></note> <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Na muthibukire emikati ɨrɨnda yo y'uguthaya abandʉ bɨhʉmbɨ bɨne na momwaheka bɨthonga bɨngahɨ?<note caller="+" style="f"><char style="fr" closed="false">16:10 </char><char style="ft" closed="false">Soma 15:32-38.</char></note> <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Bʉshana na ki muthaminyire ko nyɨthathagenda enyɨnegena nemwe bʉshana n'emikati mo ndambi nyɨthababwɨra nyɨthɨ muyitheye ko tsatsʉ y'aBafarisayo na ey'aBasandukayo?» <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Aho abɨga mobamɨnya ko mwathalɨ anegena nabo bʉshana n'iyitheya ko <char style="w" lemma="Tsatsʉ">tsatsʉ</char> yo inakomya emikati, hewethuwe agenda anegena nabo bʉshana n'amakangɨrɨtsya w'<char style="w" lemma="Bafarisayo:">aBafarisayo</char> n'aBasandukayo.<verse eid="MAT 16:12" /></para>
  <para style="s">Petero anegena athɨ Yesʉ yo Kirisito</para>
  <para style="r">(<ref loc="MRK 8:27-30">Mar 8:27-30</ref>; <ref loc="LUK 9:18-21">Luk 9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Yesʉ abere ahika mo kɨhʉgo ky'iKaisaria Filipi, mwabʉtsya <char style="w" lemma="abɨga">abɨga</char> bʉwe athɨ: «Abandʉ abanegena bathɨ <char style="w" lemma="Mʉgala w'oMʉndʉw">Mʉgala w'oMʉndʉ</char> nɨ ndɨ?» <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />Mobamʉshʉbɨtsya bathɨ: «Bagʉma abanegena bathɨ nɨ Yoani Mubatisya, na bandɨ bathɨ nɨ Elia, na bandɨ bathɨ nɨ Yeremia kʉtse mʉgʉma w'oko <char style="w" lemma="Mʉmɨnyeretsɨ">bamɨnyeretsɨ</char>.» <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />Aho Yesʉ mwabʉtsyabo athɨ: «Nemwe omʉnegena mʉthɨ nyɨrɨ ndɨ?» <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />Simoni Petero mwamʉshʉbɨtsya athɨ: «Ʉlɨ Kirisito Mʉgala wa Gongo yo ʉlɨho.» <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />Yesʉ mwamʉbwɨra athɨ: «Ʉlɨ mʉgashanɨrwa mbe Simoni mʉgala wa Yona<note caller="+" style="f"><char style="fr" closed="false">16:17 </char><char style="ft" closed="false">Mwana wa Yona: Shʉnga Yoani 1:42. aho hashakirwe hathɨ Simoni ni mʉgala wa Yona. He mo Kikiriki ni mwana wa Yoani.</char></note>, kʉshangwa athalɨ omʉbɨrɨ n'omʉsasɨ byo byamakukumbulirabyo, hewethuwe nɨ Thatha yo ʉlɨ mo lʉbʉla. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Nangye enyɨkʉbwɨra nyɨthɨ ʉlɨ Petero, n'ɨnegena mbʉ ibwe. Na kw'ibwe eri nyandahimbako aKanisa kaye,<note caller="+" style="f"><char style="fr" closed="false">16:18 </char><char style="ft" closed="false">Soma Banyaefeso 2:20.</char></note> n'amaka w'okwɨrʉnga athɨndahɨmeko. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Nyandakʉha esofʉngʉro s'oBwamɨ bw'elʉbʉla, ekyoshi kyo wandamɨna ko kɨhʉgo kyandamɨnwa n'omo lʉbʉla, n'ekyoshi kyo wandamɨnʉla mo kɨhʉgo, kyandamɨnʉlwa na mo lʉbʉla.»<verse eid="MAT 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20" />Aho Yesʉ mwakongomeretsya <char style="w">abɨga</char> bʉwe athɨ bathanalinda babwɨra mʉndʉ kw'ɨye nɨ Kirisito.<verse eid="MAT 16:20" /></para>
  <para style="s">Yesʉ anegena ko lʉholo na kw'ilubuka lɨwe.</para>
  <para style="r">(<ref loc="MRK 8:31-9:1">Mar 8:31–9:1</ref>; <ref loc="LUK 9:22-27">Luk 9:22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Ɨthanga ko ndambi eyo, Yesʉ mwathanga ikangania abɨga bʉwe ko lɨtholere nɨaya ɨYerʉsalemʉ. N'eyo abakʉlʉ b'abandʉ, n'abakʉlʉ b'abaheri n' <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">aBakangɨrɨtsya b'oMʉgomba</char>, bandamwagatsya. Bandamwitha na mo kɨro kya kashathʉ honyuma y'olʉholo lʉwe, andalubuka. <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />Aho Petero mwamʉthwala ho mʉsɨke n'ɨmʉkemera athɨ: «Gongo akutheye mbe Nyinya-kowethʉ! Ɨhɨ, ebyo bithakuhikiraga!» <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />Hewethuwe Yesʉ mwabɨndʉka n'ɨbwɨra Petero athɨ: «Thoka hofɨ nangye! Ɨwe <char style="w" lemma="Sitani">Sitani</char>! Ɨwe ʉlɨ kɨtsɨkalo mo nzɨra aye, kʉshangwa emɨganɨtsye awe ɨthalɨ ya Gongo, hewethuwe nɨ ya bandʉ.»<verse eid="MAT 16:23" /></para>
  <para style="s">Wangakwama Yesʉ yo ʉthɨ?</para>
  <para style="r">(<ref loc="MRK 8:34-9:1">Mar 8:34–9:1</ref>; <ref loc="LUK 9:23-27">Luk 9:23-27</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Honyuma kw'aho Yesʉ mwabwɨra <char style="w" lemma="abɨga">abɨga</char> bʉwe athɨ: «Omʉndʉ amashondya ɨnyɨkwama, ayɨthɨnde yowene<note caller="+" style="f"><char style="fr" closed="false">16:24 </char><char style="ft" closed="false">Ayithinde yowene: Nɨ ɨnegena mbʉ athakɨrɨ yowene, he ahera wa Kirisito.</char></note>, aheke <char style="w" lemma="Mʉsalaba">omʉsalaba</char> ʉwe na anyɨkwame. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Kʉshangwa omʉndʉ yo ushondya ilamya obʉyɨngo bʉwe andahetsyabo, hewethuwe yo wandahetsya obʉyɨngo bʉwe<note caller="+" style="f"><char style="fr" closed="false">16:25 </char><char style="ft" closed="false">Soma Luka 17:33; Yoani 12:25.</char></note> bʉshana nangye andabonabo. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Ndundi ki ko mʉndʉ erɨbona ekɨhʉgo kyoshi n'ɨhetsya obʉyɨngo bʉwe? Kʉtse mʉndʉ angahana ki ekiwithe kɨtsɨro ky'obʉyɨngo bʉwe? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Kʉshangwa oMʉgala w'oMʉndʉ andahika hagʉma n'abamalaɨka bʉwe mo lʉkengerwa lw'ishe, na aho andafʉha obʉlɨ mʉndʉ ɨkwamana n'emɨkolano yɨwe.<note caller="+" style="f"><char style="fr" closed="false">16:27 </char><char style="ft" closed="false">Lingania na Saburi 62:13; Banyaroma 2:6.</char></note> <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Kwenene enyɨbabwɨra, mo kathi k'abo balɨ hano, bagʉma bathɨndafwe bathetsi bashʉnga oMʉgala w'oMʉndʉ ahika nga Mwamɨ.»<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">Obʉsʉ bwa Yesʉ obʉhɨndʉlwa</para>
  <para style="r">(<ref loc="MRK 9:2-13">Mar 9:2-13</ref>; <ref loc="LUK 9:28-36">Luk 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Habere hahwa bɨro ndathʉ, Yesʉ mwatsɨmba Petero, Yakobo na Yoani mʉgala abo, mwathwalabo ko kɨthwa kɨre, babyagako ɨbo bene. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Yesʉ mwahɨndʉlwa embere sabo, n'obʉsʉ bʉwe mobwathanga ɨngenga-ngenga<note caller="+" style="f"><char style="fr" closed="false">17:2 </char><char style="ft" closed="false">Lingania na 2Petero 1:16-18; Marɨko 9:2 n'ebishakirwe.</char></note> nga lɨshɨ, n'esongɨmba sɨwe mosasana nga kyakakala. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Aho n'aho Mʉsa na Elia mobahʉlʉkɨrabo nɨabasɨmola na Yesʉ. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Aho Petero mwabwɨra Yesʉ athɨ: «Nyinya-kowethʉ, likwirire kw'ithwe eribya hano. Wamashasha, nyahimba hano ho hema ishathu, ngʉma yɨwawe, ngʉma ya Mʉsa na ngʉma ya Elia.» <verse eid="MAT 17:4" /><verse number="5" style="v" sid="MAT 17:5" />Abere anemʉnegena, ekɨfʉ ekyo ekɨkoletsya mokyashwɨkabo. N'omo kɨfʉ ekyo momwonvwɨka mʉlenge nɨanegena athɨ: «Ono nɨ Mʉgala aye mʉtsɨɨrwa, nyimoyibwe naye kʉtsɨbʉ. Mʉmʉhʉlɨkɨrɨtsye!»<note caller="+" style="f"><char style="fr" closed="false">17:5 </char><char style="ft" closed="false">Soma 3:17 n'ebishakirwe.</char></note> <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" /><char style="w">Abɨga</char> babere bonvwa omʉlenge oyo, mobʉbaha kʉtsɨbʉ, mobawa n'ihuma obʉsʉ ko kɨthaka. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Yesʉ mwayɨfʉnda aho babyaga, mwakola kʉbo n'ɨbwɨrabo athɨ: «Mwimane, mʉthʉbahaga.» <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Nabo babere bashʉmba amesho wabo, mobathashʉnga ʉndɨ mʉndʉ athalɨ Yesʉ mʉsha. <verse eid="MAT 17:8" /><verse number="9" style="v" sid="MAT 17:9" />Babere banemukima ko kɨthwa, Yesʉ mwahamʉlabo athɨ: «Mʉthabwɨraga mʉndʉ ebyo mwamashʉngako, ihika ko kɨro oMʉgala w'oMʉndʉ andalubuka mo baholi.»<verse eid="MAT 17:9" /></para>
  <para style="s">Yesʉ asɨmola kʉ Elia</para>
  <para style="r">(<ref loc="MRK 9:11-13">Mar 9:11-13</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />
    <char style="w">Aho abɨga</char> mobabʉtsya Yesʉ bathɨ: «Bʉshana na ki aBakangɨrɨtsya b'oMʉgomba abanegena bathɨ lɨtholere Elia nɨathanga ihika?»<note caller="+" style="f"><char style="fr" closed="false">17:10 </char><char style="ft" closed="false">Soma Malaki 3:23.</char></note> <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />Mwashʉbɨtsyabo athɨ: «Kwenene lɨtholere Elia nɨathanga ihika athondeke ebɨndʉ byoshi. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Hewethuwe enyɨbabwɨra nyɨthɨ Elia amalire ihika, abandʉ mobathamʉmɨnya he mobamʉkolera nga ko bashashire.<note caller="+" style="f"><char style="fr" closed="false">17:12 </char><char style="ft" closed="false">Soma Marɨko 9:13.</char></note> Ni kuthyo ko bandagatsya oMʉgala w'oMʉndʉ yowene-wene.» <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Aho <char style="w">abɨga</char> mobamɨnya ko agenda ahʉla Yoani <char style="w" lemma="Lubatiso">mubatisya</char>.<verse eid="MAT 17:13" /></para>
  <para style="s">Yesʉ alamya mwana alɨko bithutsa</para>
  <para style="r">(<ref loc="MRK 9:14-29">Mar 9:14-29</ref>; <ref loc="LUK 9:37-43">Luk 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Yesʉ n'abɨga bʉwe babere bahika aho habyaga omuhindano, mʉndʉ mʉgʉma mwahikira Yesʉ, mwafʉkama embere sɨwe, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />mwanegena athɨ: «Nyinya-kowethʉ, shashɨra mʉgala aye. Alɨko bithutsa<note caller="+" style="f"><char style="fr" closed="false">17:15 </char><char style="ft" closed="false">Soma 4:24 n'ebishakirwe.</char></note> na agalwa kʉtsɨbʉ. Ko ndambi soshi, anayihuma mo mʉtsanwa kʉtse mo metsi. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Monyamuthwalire <char style="w">abɨga</char> bawe, hewethuwe mobalemirwe imulamya.» <verse eid="MAT 17:16" /><verse number="17" style="v" sid="MAT 17:17" />Yesʉ mwanegena athɨ: «Imwe kɨgenyero kɨthɨkɨrɨtsye<note caller="+" style="f"><char style="fr" closed="false">17:17 </char><char style="ft" closed="false">Kɨthɨkɨrɨtsye kʉtse iyinihirwa: awandɨ mashako anegenire athɨ kithangayinihirwa.</char></note> na kya bo baheraga! Nyandabya nemwe ihika ku ndambi ehɨ? Nyandabaheka kʉ bɨro bɨngahɨ? Mʉnyɨlethere omwana oyo yo hano.» <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Yesʉ mwabɨnga omʉtsɨmʉ oyo, mwathoka ko mwana, na ko ndambi eyo mwalama. <verse eid="MAT 17:18" /><verse number="19" style="v" sid="MAT 17:19" />Aho <char style="w">abɨga</char> mobahikira Yesʉ ɨbo bene n'ɨmʉbʉtsya bathɨ: «Bʉshana na ki ithwe mothwalemirwe ɨbɨnga omʉtsɨmʉ oyo?» <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" />Yesʉ mwashʉbɨtsyabo athɨ: «Kʉshangwa olwɨkɨrɨtsyo lwenyu nɨ lʉke. Nɨ kwenene enyɨbabwɨra, mwamabya na lwɨkɨrɨtsyo lʉngana na kambulu k'eharatali, mwangabwire ekɨthwa eki mʉthɨ: “Uyithokye hano ʉye halira,” nakyo nɨkyagenda. Hathalɨ kɨnwa kyo mwangalemwa ɨkola. [<verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />Hewethuwe nɨ mo mɨshabe n'iyima akalyo kuroshi byo byangathokya mɨtsɨmʉ mɨbɨ ng'eyi.»]<note caller="+" style="f"><char style="fr" closed="false">17:21 </char><char style="ft" closed="false">Mashako magʉma mwongerera hano ho bɨndɨ: nɨ mɨshabe n'eriyima akalyo bɨsha byo byangaleka abandʉ nibakotsya ɨbɨnga emɨtsɨmʉ yɨrɨ ng'eyi.</char></note><verse eid="MAT 17:21" /></para>
  <para style="s">Yesʉ ashʉba negena ko lʉholo lʉwe n'erilubuka lɨwe.</para>
  <para style="r">(<ref loc="MRK 9:30-32">Mar 9:30-32</ref>; <ref loc="LUK 9:43-45">Luk 9:43-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Kɨro kɨgʉma, Yesʉ n'abɨga bʉwe babyaga ni bahindene hagʉma iNgalilaya. Yesʉ mwabwɨrabo athɨ: «<char style="w" lemma="Mʉgala w'oMʉndʉ">oMʉgala w'oMʉndʉ</char> ahirwa mo minwe y'abandʉ. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />Bandamwitha, he ekɨro kya kashathʉ andalubuka.» Aho abɨga mobafwa buliye bʉnene.<verse eid="MAT 17:23" /></para>
  <para style="s">Erɨrɨha Ekoli y'eNyʉmba ya Gongo</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Yesʉ n'abɨga bʉwe babere bahika ɨKaperenaʉmʉ, abakarani b'ekoli b'omo nyʉmba ya Gongo mobahikira Petero n'ɨmʉbʉtsya bathɨ: «Omʉkangɨrɨtsya enyu athafʉha ekoli y' <char style="w" lemma="Nyʉmba ya Gongo">eNyʉmba ya Gongo</char>?»<note caller="+" style="f"><char style="fr" closed="false">17:24 </char><char style="ft" closed="false">Ɨthoka 30:11-16.</char></note> <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />«Petero mwashubya athɨ: anafʉharo.» Petero abere ɨngɨra mo nyʉmba, embere anegene Yesʉ mwamʉbwɨra athɨ: «Ʉganɨtsya ki no Simoni? Abamɨ b'ekɨhʉgo kɨno abanafuhya ekoli yo bahɨ? Nɨ esombʉthɨrwa kʉtse abageni?» <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />Petero mwashubya athɨ: «Abageni.» Yesʉ mwamʉbwɨra athɨ: «Byamabya nɨ ko bɨrɨ bithyo, sombʉthɨrwa s'ekɨhʉgo sɨthangafʉha. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Hewethuwe, thuthatsiire itsibukya abandʉ aba. Bʉshana n'ekyo ʉgende ko ngetsɨ, ʉsha obʉrobo mo metsi. Ʉkʉre erihere limbere wabona, ʉkɨngʉle obʉnʉ bwalyo, washʉngamo kɨtsere kya faranga. Ʉtsɨmbekyo ʉfʉhe Ekoli aye n'eyɨwawe.»<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Nɨ ndɨ yo mʉkʉlʉ</para>
  <para style="r">(<ref loc="MRK 9:33-37">Mar 9:33-37</ref>; <ref loc="LUK 9:46-48">Luk 9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Ko ndambi eyo, <char style="w">abɨga</char> mobayɨfʉnda hofɨ na Yesʉ n'ɨmʉbʉtsya bathɨ: «Nɨ ndɨ yo mʉkʉlʉ mo Bwamɨ bw'elʉbʉla?» <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />Yesʉ mwabɨrɨkɨra mwana mʉlere, mwamuhira mo kathi-kathi kabo, <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />n'ɨnegena athɨ: «Kwenene enyɨbabwɨra, muthabindukire n'ibya nga bana balere, mʉthɨndɨngɨre mo Bwamɨ bw'elʉbʉla. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Yo wandayɨyɨra ng'omwana mʉlere oyu, oyo yo mʉkʉlʉ mo Bwamɨ bw'elʉbʉla. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Omʉndʉ yo ukokya omwana mʉlere ng'ono mw'ɨtsɨna lyaye, n'ingye amakokya.<verse eid="MAT 18:5" /></para>
  <para style="s">Bʉlɨgo ko yo wandahetsya mwɨkɨrɨtsya</para>
  <para style="r">(<ref loc="MRK 9:42-48">Mar 9:42-48</ref>; <ref loc="LUK 17:1-2">Luk 17:1-2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />«Hewethuwe yo wandaleka mʉgʉma w'oko bana bo banyɨkɨrɨtsye aba nɨathera, kyangabere kɨbʉya kw'ɨye ɨmɨnɨrwako lushyo lʉnene mw'igosi n'ɨgʉshwa mw'iriba ly'engetsɨ. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />Bʉhanya ko bandʉ b'ekɨhʉgo bʉshana n'ebyo ebɨreka abandʉ nɨbakola bɨtsɨbʉ! Kʉshangwa ebyo bɨnaleka abandʉ nɨbakola ebɨtsɨbʉ bɨthangabʉsha ihika, hewethuwe bʉhanya ko mʉndʉ yo wandaleka nɨbyabya! <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Aho okʉboko kwawe kʉtse ekɨshando kyawe byamabya nɨbyangaleka nɨwakola ekɨtsɨbʉ, tsabyo na ʉgʉshebyo hale nawe, kʉshangwa bikwirire kw'ɨwe ɨngɨra mo bʉyɨngo bw'ekera n'ekera na kʉboko kʉgʉma kʉtse kʉgʉlʉ kʉgʉma, kʉlenga erɨgʉshwa mo mʉtsanwa wa kera n'ekera na maboko abɨrɨ kʉtse na magʉlʉ abɨrɨ. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />N'erisho lyawe lyamabya nɨlyangaleka nɨwakola kɨtsɨbʉ, ʉkʉlelyo na ʉgʉsheryo hale nawe! Likwirire kw'ɨwe ɨngɨra mo bʉyɨngo bwa kera n'ekera na lisho ɨgʉma kʉlenga kw'ɨgʉshwa mo mʉtsanwa w'okwɨrʉnga<note caller="+" style="f"><char style="fr" closed="false">18:9 </char><char style="ft" closed="false">Soma 5:22.</char></note> na mesho abɨrɨ.<verse eid="MAT 18:9" /></para>
  <para style="s">Omushinga w'embuli yaheraga</para>
  <para style="r">(<ref loc="LUK 15:3-7">Luk 15:3-7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />«Muyitheye mʉthasʉnzʉgʉraga mʉgʉma w'oko balere aba, kʉshangwa enyɨbabwɨra mo lʉbʉla <char style="w" lemma="abamalaɨka">abamalaɨka</char> babo bimene bʉthalʉha embere sa Thatha yo ʉlɨ mo lʉbʉla. [<verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />Kʉshangwa <char style="w" lemma="Mwana w'oMʉndʉ">oMwana w'oMʉndʉ</char> ahikaga bʉshana n'ɨshabʉla bo baherire.<note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">Hano, mashako magʉma ongerereko ebɨnwa bɨno: kʉshangwa oMʉgala w'oMʉndʉ ahikaga bʉshana n'ɨshabʉla bobabyaga ni baherire. Soma Luk 19:10.</char></note>]<verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />«Omʉganɨtsya kw'ebi ko muthi ki? Omʉndʉ amabya niawithe ku mbuli sɨwe igana, n'engʉma ya kʉtho yamahera, athangamika esɨndɨ makumi mwenda na mwenda ko kɨthwa bʉshana n'ɨya shondya yo yɨthahera? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Na amahika kw'ɨbonaro, kwenene enyɨbabwɨra, anamogeraro kʉlenga esombuli makumi mwenda na mwenda sosɨthathahera. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Na kuthyo Thatha wenyu yo ʉlɨ elʉbʉla athatsiire erɨhera ly'omʉgʉma w'oko balere aba.»<verse eid="MAT 18:14" /></para>
  <para style="s">Ihano ko yo ʉkʉkolera ekɨbɨ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />«Mʉgala enyu amakʉkolera kɨtsɨbʉ, genda ʉyamʉhane, mubye imwe babɨrɨ kuroshi. Amakw'onvwa, nɨwamabona mʉgala enyu. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Hewethuwe amathɨnda ɨkwonvwa, shʉbatsɨmba mʉndʉ mʉgʉma kʉtse babɨrɨ hagʉma nawe, kʉshangwa “obʉlɨ mwatsɨ nɨatsɨwa ko kɨnwa kya batimo babɨrɨ kʉtse bashathʉ.”<note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="ft" closed="false">Soma Ibʉka Mʉgomba 19:15.</char></note> <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Hewethuwe amathɨnda ɨbonvwa, nɨwabwɨra akanisa, na amathɨnda ɨonvwa akanisa, ʉmʉtsɨmbe nga mʉndʉ uthetsi Gongo, kʉtse nga mukarani wa koli.<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />«Kwenene enyɨbabwɨra, ebyoshi byo mwandamɨna ko kɨhʉgo, byandamɨnwa n'omo lʉbʉla. N'ebyoshi mwandamɨnʉla mo kɨhʉgo, byandamɨnʉlwa n'omo lʉbʉla.<note caller="+" style="f"><char style="fr" closed="false">18:18 </char><char style="ft" closed="false">Soma 16:19; Yoani 20:23.</char></note><verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />«Kandɨ enyɨbabwɨra kwenene, bandʉ babɨrɨ mw'imwe ko kɨhʉgo bamalagana bʉshana n'ɨshaba kɨndʉ kyoshi-kyoshi, ekyo bandahabwakyo na Thatha yo ʉlɨ mo lʉbʉla. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Kʉshangwa ho bandʉ babɨrɨ kʉtse bashathʉ bahindene bʉshana n'erɨtsɨna lyaye, nagye nɨnyɨrɨ mo kathi-kathi kabo.»<verse eid="MAT 18:20" /></para>
  <para style="s">Mushinga w'omukoli yo ʉthalɨ na shashi</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Aho Petero mwagendera Yesʉ n'ɨmʉbʉtsya athɨ: «Nyinya-kowethʉ, mʉgala ethʉ amanyɨhabɨra nyangamʉshashɨra ngendo sɨngahɨ? Ihika kʉ ngendo sɨrɨnda?» <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" />Yesʉ mwamʉshʉbɨtsya athɨ: «Nyithakubwire nyɨthɨ ngendo sɨrɨnda, hewethuwe kalɨnda ngendo makumi alɨnda<note caller="+" style="f"><char style="fr" closed="false">18:22 </char><char style="ft" closed="false">Kalɨnda ngendo makumi alɨnda: wandɨ mashako athɨ ngendo makumi alɨnda na kalɨnda.</char></note>.»<verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />«Bʉshana n'eki, oBwamɨ bw'elʉbʉla bushoshire nga mwamɨ mʉgʉma yo washondyaga ɨkola mɨganzo y'eminda yo abakoli bʉwe babyagako. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Abere athanga ɨganza, mobamʉlethera mukoli mʉgʉma yo wabyagako mwinda ʉwe wa talanta<note caller="+" style="f"><char style="fr" closed="false">18:24 </char><char style="ft" closed="false">Etalanta kyabyaga kɨtsere kyakomibawa mʉ horo, n'etalanta ngʉma yabyaga na bʉtsɨtho bwa bilo 34 bya horo. Etalanta ngʉma yabyaga ɨrɨngene na lʉhembo lo mʉndʉ angakolera hofɨ myaka makumi abɨrɨ. Aho ebɨhʉmbɨ ikumi by'etalanta sabyaga kalagere ka faranga. </char></note> bɨhʉmbɨ ikumi. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Omʉndʉ oyo kʉshangwa abyaga niathawithe s'erɨmʉfʉha, aho nyinya-kowabo mwahamʉla agʉtsɨbwe ɨye na mʉkatsɨwe n'abana bʉwe n'ebyoshi abyaga awitheko, bʉshana n'ɨfʉha omwinda ʉwe. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />Omukoli oyo mwafʉkamɨra nyinya-kowabo n'ɨmʉbwɨra athɨ: “Thathʉma, nyandakʉfʉha esoshi!” <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Nyinya-kowabo mwafwɨra omukoli ʉwe yo shashi, na mwamʉganyɨra omwinda oyo n'imulika agende. <verse eid="MAT 18:27" /><verse number="28" style="v" sid="MAT 18:28" />Omukoli oyo abere ahʉlʉka, mwahindana na mʉgʉma wa ku balikyabo yo wabyagako mwinda ʉwe wa bɨtsere igana bya tinari<note caller="+" style="f"><char style="fr" closed="false">18:28 </char><char style="ft" closed="false">Etinari yabyaga faranga. N'etinari ngʉma yabyaga n'ɨyɨrɨngene n'olʉhembo lwa mʉbɨtsɨ mʉgʉma.</char></note>. Mwamʉtsɨmbɨra mw'igosi, n'ɨmʉsɨmatha kʉtsɨbʉ niashondya imuniga, n'ɨmʉbwɨra athɨ: “Nyɨfʉhe omwinda aye!” <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />Mulikyabo oyo mwawa ko bɨshando bɨwe n'ɨmʉgonga-gonga athɨ: “Thalɨnda, nyandakʉfʉha omwinda awe!” <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />Hewethuwe mulikyabo oyo mwathɨnda kʉtsɨbʉ n'ɨyamʉgʉsha mo muliki ihika ko ndambi andafʉha omwinda ʉwe. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Abandɨ bakoli balikyabo babere bashʉnga ebyo, mobabya n'obuliye bʉngɨ n'ɨyabwɨra nyinya-kowabo ebyoshi byo byamatsʉka. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Aho nyinya-kowabo oyo mwabɨrɨkɨra omukoli oyo n'ɨmʉbwɨra athɨ: “Ɨwe ʉlɨ mukoli mʉbɨ! Monyakushashire omwinda awe woshi, kʉshangwa mowanyishabire nyɨkʉshashɨre. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Nawe kuthyo ʉthangabere na shashi ku mulikyenyu nga ko nyakʉshashɨraga?” <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Nyinya-kowabo mwakapɨkɨra lɨwe, mwamuhira mo minwe y'abatheya b'ebiriso bʉshana bamwagatsye ihika ko kɨka andafʉha omwinda ʉwe woshi.»<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />Ko nduli Yesʉ mwanegena athɨ: «Ni bathyo ko Thatha w'elʉbʉla andakolera bʉlɨ mʉndʉ mw'imwe yo ʉthangashashɨra mʉgalabo n'omʉthɨma ʉwe woshi.<note caller="+" style="f"><char style="fr" closed="false">18:35 </char><char style="ft" closed="false">Soma 6:15.</char></note>»<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Makangɨrɨtsya bʉshana n'erɨkamba mʉkatsɨ</para>
  <para style="r">(<ref loc="MRK 10:1-12">Mar 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Yesʉ abere amamala ɨnegena ebyo, mwathoka iNgalilaya mwahika mo kɨhʉgo ky'iYuteya ko ʉndɨ mʉnda w'olwitsi lw'eYorotani. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Muhindano mʉnene wa bandʉ mwamʉkwama n'eyo mwalamya abakoni. <verse eid="MAT 19:2" /><verse number="3" style="v" sid="MAT 19:3" /><char style="w" lemma="Bafarisayo:">Bafarisayo</char> mobamuhikira bʉshana n'ɨmʉthega kɨnwa, na mobamʉbʉtsya bathɨ: «Ewono binahamulirwe ko muyira ɨkamba mʉkatsɨwe bʉshana na bʉlɨ kɨnwa?» <verse eid="MAT 19:3" /><verse number="4" style="v" sid="MAT 19:4" />Yesʉ mwashʉbɨtsyabo athɨ: «Momʉthasoma mo Kɨnwa kya Gongo, ko ko ndangɨro yo wabʉmbaga, mwabʉmba muyira na mʉkatsɨ<note caller="+" style="f"><char style="fr" closed="false">19:4 </char><char style="ft" closed="false">Soma Ndangɨro 1:27; 5:2.</char></note>? <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />Aho Gongo mwanegena athɨ: “Bʉshana n'ekyo, omuyira andamika ishe na nyinya n'ibya hagʉma na mʉkatsɨwe, n'ababɨrɨ bandabya mʉbɨrɨ mʉgʉma.<note caller="+" style="f"><char style="fr" closed="false">19:5 </char><char style="ft" closed="false">Soma Ndangɨro 2:24.</char></note>” <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Nɨ bathakɨrɨ babɨrɨ, hewethuwe nɨ bahera mʉbɨrɨ mʉgʉma. Aho abo Gongo amalire ihindania, mʉndʉ athalikanayabo.» <verse eid="MAT 19:6" /><verse number="7" style="v" sid="MAT 19:7" />aBafarisayo mobamʉbʉtsya bathɨ: «Bʉshana na ki Mʉsa mwahamʉla omuyira ɨhana marʉba w'ikamba mʉkatsɨwe n'imulika?»<note caller="+" style="f"><char style="fr" closed="false">19:7 </char><char style="ft" closed="false">Soma 5:33; Ɨbʉka 24:1.</char></note> <verse eid="MAT 19:7" /><verse number="8" style="v" sid="MAT 19:8" />Yesʉ mwashʉbɨtsyabo athɨ: «Mʉsa mwabahamʉla iriitha abakatsɨ benyu bʉshana n'emɨthɨma enyu mɨtsɨbʉ. Hewethuwe ko ndangɨro ko bithabyaga bithyo. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Enyɨbabwɨra nyɨthɨ: “Omuyira amakamba mʉkatsɨwe, ɨthalɨ bʉshana n'orʉsɨngɨ<note caller="+" style="f"><char style="fr" closed="false">19:9 </char><char style="ft" closed="false">Soma 5:32 n'ebishakirwe.</char></note> kuroshi, na amahikya ʉndɨ, nɨamasɨngɨra.”»<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />
    <char style="w">Abɨga</char> bʉwe mobamʉbwɨra bathɨ: «Byamabya nɨ ko biri bithyo, ko muyira na mʉkatsɨwe, kwenzi ni bithawithe mʉgasho omʉndʉ erihikya.» <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" />Yesʉ mwashʉbɨtsyabo athɨ: «Bathalɨ abandʉ boshi bo bangonvwa ebɨnwa ebi byo kʉbʉya, hewethuwe abo bonvwirebyo nɨ abo bahabawabyo basha. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Ega, halɨ abasagarwa bo babʉthawa bathyo. Halɨ n'abasagarwa bo basagarawa n'abandʉ. Halɨ na abo bayɨyɨragamo basagarwa ɨbo bene bʉshana n'oBwamɨ bw'elʉbʉla. Yo wangonvwa ekɨnwa kɨno, onvwekyo!»<verse eid="MAT 19:12" /></para>
  <para style="s">Yesʉ agashanɨra abana balere</para>
  <para style="r">(<ref loc="MRK 10:13-16">Mar 10:13-16</ref>; <ref loc="LUK 18:15-17">Luk 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Aho abandʉ mobalethera Yesʉ yo abana balere bʉshana ahire kʉbo kw'eminwe n'ɨshabɨrabo. Hewethuwe <char style="w">abɨga</char> bʉwe mobakemerabo. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Aho Yesʉ mwabwɨrabo athɨ: «Mulike abana balere bahike yo nyɨrɨ, mʉthakagagabo, kʉshangwa oBwamɨ bw'elʉbʉla nɨ bw'abandʉ balɨ ng'abo.»<note caller="+" style="f"><char style="fr" closed="false">19:14 </char><char style="ft" closed="false">Soma 18:3-5.</char></note> <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Mwahira kʉbo kw'eminwe, honyuma kw'aho, mwathoka aho.<verse eid="MAT 19:15" /></para>
  <para style="s">Mʉthabana mushoki</para>
  <para style="r">(<ref loc="MRK 10:17-31">Mar 10:17-31</ref>; <ref loc="LUK 18:18-30">Luk 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Honyuma kw'aho, mʉndʉ mʉgʉma mwagendera Yesʉ n'ɨmʉshaba athɨ: «Mʉkangɨrɨtsya, nyangakola kɨbʉya kɨhe nɨmo nyabona obʉyɨngo bwa kera na kera?» <verse eid="MAT 19:16" /><verse number="17" style="v" sid="MAT 19:17" />Yesʉ mwamʉshʉbɨtsya athɨ: «Bʉshana na ki ʉnyɨbʉtsya ko bɨbʉya? Mʉndʉ mʉgʉma mʉsha yo mʉbʉya. Wamabya ʉlɨ ushondya ɨngɨra mo bʉyɨngo bwa kera n'ekera, ushikye amathegeko wa Gongo.» <verse eid="MAT 19:17" /><verse number="18" style="v" sid="MAT 19:18" />Omʉthabana oyo mwamʉbʉtsya athɨ: «Amathegeko ahɨ no?» Yesʉ mwashubya athɨ: «Uthithaga, ʉthasɨngɨraga, uthibaga, ʉthahambɨkaga mʉndʉ, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />shikya sho na nyoko, na ʉtsɨɨre mulikyenyu nga ko uyitsiire wowene.»<note caller="+" style="f"><char style="fr" closed="false">19:19 </char><char style="ft" closed="false">Soma Ɨthoka 20:12-16; Balawi 19:18; Ɨthoka 5:16-20.</char></note> <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />Omʉthabana oyo mwamʉbwɨra athɨ: «Nyishikitsye ebyoshi ebyo, nyamashʉba bʉsha ki?» <verse eid="MAT 19:20" /><verse number="21" style="v" sid="MAT 19:21" />Yesʉ mwamʉbwɨra athɨ: «Wamabya ʉlɨ ushondya ibya mʉthʉnganene, enda ʉyagʉtsye ebyoshi uwitheko na ʉhe esofaranga etho s'abatsene. Aho wandabona bushoki mo lʉbʉla. Honyuma kw'aho, hika ʉnyɨkwame.»<note caller="+" style="f"><char style="fr" closed="false">19:21 </char><char style="ft" closed="false">Soma 5:48, nyɨkwame: shʉnga Yoani 1:43 n'ebishakirwe. </char></note> <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />Omʉthabana abere onvwa ebyo, mwayɨgendera n'obuliye, kʉshangwa abyaga niawithe bʉshoki bʉngɨ.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Yesʉ mwabwɨra abɨga bʉwe athɨ: «Kwenene enyɨbabwɨra nyɨthɨ litsibuhire ko mushoki ɨngɨra mo Bwamɨ bw'elʉbʉla. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Enyɨshʉbababwɨra ko lyolohire engamɨa ɨtsʉka mo kyuna ky'enandi, kʉlenga omushoki ɨngɨra mo <char style="w">Bwamɨ bwa Gongo</char>.» <verse eid="MAT 19:24" /><verse number="25" style="v" sid="MAT 19:25" />Abɨga babere bonvwa ebɨnwa ebyo, mobashweka kʉtsɨbʉ n'ɨnegena bathɨ: «Ɨndɨ yo wangashabʉlwa?» <verse eid="MAT 19:25" /><verse number="26" style="v" sid="MAT 19:26" />Yesʉ mwahanda kʉbo kw'amesho n'ɨbwɨrabo athɨ: «Ko bandʉ kɨthangathokekana, hewethuwe kʉ Gongo ebyoshi bɨthokekene.»<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Aho Petero mwamʉbwɨra athɨ: «Shʉnga, ithwe mothwamikire ebyoshi na mothwakukwamire. Byandabya bɨthɨ kw'ithwe?» <verse eid="MAT 19:27" /><verse number="28" style="v" sid="MAT 19:28" />Yesʉ mwabwɨrabo athɨ: «Kwenene enyɨbabwɨra: “Mo ndambi ebɨndʉ byoshi byandabya byayɨrwamo bihya-bihya, mo ndambi oMʉgala w'oMʉndʉ andabya ikala ko lʉthebe lʉwe lw'olʉkengerwa, imwe mwanyɨkwamaga, mwandikala nemwe ko ndebe ikumi n'ibiri bʉshana n'ɨsoha ebɨhanda ikumi na bɨbɨrɨ by'a<char style="w" lemma="Isiraeli">banyaIsiraeli</char>. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />N'obʉlɨ mʉndʉ yo wamikaga manyʉmba, kʉtse bagala babo, kʉtse balɨ babo, kʉtse ishe ʉwe, kʉtse nyinya ʉwe, kʉtse bana babo, kʉtse mashwa wabo bʉshana n'erɨtsɨna lyaye, bandahembwa ngendo igana, na kalengyo kw'aho bandahembwa obʉyɨngo bw'ekera n'ekera.” <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Hewethuwe bandʉ bangɨ bo balɨ bambere-mbere bandabya banyuma-nyuma na bangɨ bo balɨ banyuma-nyuma bandabya bambere-mbere.»<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">Mushinga w'abahingi mw'ɨshwa ly'emisabibu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />«oBwamɨ bw'elʉbʉla, bushoshekanibwe na mwenye erɨshwa mʉgʉma yo watsɨndʉkaga mo mambya mw'iyashondya bahingi b'erɨshwa lɨwe ly'<char style="w" lemma="Musabibu">emisabibu</char>. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Mwahʉlɨkɨrɨrana nabo ɨhembabo kɨtsere kɨgʉma kya tinari<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">Etinari yabyaga faranga. N'etinari ngʉma yabyaga n'ɨyɨrɨngene n'olʉhembo lwa mʉbɨtsɨ mʉgʉma. </char></note> ko kɨro, na mwathʉmabo mw'ɨshwa lɨwe ly'e<char style="w" lemma="Musabibu">misabibu</char>. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />Mwashʉba hʉlʉka ko saha ishathu na mwashʉnga bandɨ bandʉ bo babyaga nibimene ahandʉ h'omuhindamo bʉtsɨra mʉlɨmo. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Mwabwɨrabo athɨ: “Nemwe kuthyo mʉgende mʉyakole mw'ɨshwa lyaye ly'emisabibu nyabahemba nga ko bɨtholere.” <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Nabo mobayayo. Omwenye erɨshwa mwashʉbahʉlʉka ko saha ndathʉ, na honyuma kw'aho ko saha mwenda, na mwakola nga ko athathanga ɨkola. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />N'oko saha ikumi na ngʉma, mwashʉbahʉlʉka na mweya bandɨ bandʉ nibimene aho na mwabwɨrabo athɨ: “Bʉshana na ki mwimene hano ko mʉthobero woshi bʉthakola mʉlɨmo?” <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />Nabo mobamʉshʉbɨtsya bathɨ: “Kʉshangwa hathalɨ mʉndʉ w'erɨthʉha mʉlɨmo.” Mwabwɨrabo athɨ: “Nemwe kuthyo mʉgende mʉyakole mw'ɨshwa lyaye ly'emisabibu.” <verse eid="MAT 20:7" /><verse number="8" style="v" sid="MAT 20:8" />Bwabere bwahika igolo, omwenye erɨshwa ly'emisabibu mwabwɨra omwimanitsi ʉwe athɨ: “Bɨrɨkɨra abahingi na ʉhe obʉlɨ mʉndʉ yo esofaranga athakolera, ʉthange ko banyuma-nyuma na ʉmalɨre ko bambere-mbere.” <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Abahingi bo bathangaga omʉlɨmo ko saha ikumi na ngʉma, obʉlɨ mʉndʉ mwahamba kɨtsere kɨgʉma kya tinari. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Abambere bahabawa omʉlɨmo babere bahika, mobaganɨtsya bathɨ bahamba nyɨngɨ, hewethuwe mobahabwa nabo bʉlɨ mʉndʉ kɨtsere kɨgʉma kya tinari. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Babere bahamba, mobarʉkʉma ko mwenye erɨshwa, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />nɨabanegena bathɨ: “Abahingi banyuma mobakola saa ngʉma nyɨsha, bamahamba ng'ithwe thʉthakola mo mʉthobero woshi mo lishɨ ɨtsɨbʉ.” <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />Hewethuwe omwenye erɨshwa mwashʉbɨtsya mʉgʉma wa kʉbo athɨ: “Mwira aye, monyɨthalɨ enyɨkʉkanga. Moʉthalɨ oʉhʉlɨkɨrɨrana nangye kɨtsere kɨgʉma kya tinari ko kɨro? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Tsɨmba esofaranga ʉthakolera na ʉgende. Nyaha omunyuma sɨngana n'eso wabona. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Nyɨthatholere ɨkola ekyo nyishashire mo bushoki bwaye? Kʉtse wamafwa mwisho kʉshangwa enyɨnakolera abandʉ bo bɨbʉya?” <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" />Aho Yesʉ mwashʉba negena athɨ: “Abanyuma-nyuma bandabya bambere-mbere, n'abambere-mbere bandabya banyuma-nyuma.”»<verse eid="MAT 20:16" /></para>
  <para style="s">Yesʉ anegena ngendo ya kashathʉ ko lʉholo n'erilubuka lɨwe</para>
  <para style="r">(<ref loc="MRK 10:32-34">Mar 10:32-34</ref>; <ref loc="LUK 18:31-34">Luk 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Yesʉ abere alɨ ɨrʉkɨra ɨYerʉsalemʉ, mwatsɨmba <char style="w" lemma="abɨga">abɨga</char> bʉwe ikumi na babɨrɨ mwayɨhɨgʉla ho mʉsɨke w'enzɨra n'ɨbwɨrabo athɨ: <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />«Shʉnga, ko othwɨrʉkɨra mo muyi w'ɨYerʉsalemʉ. Oko <char style="w" lemma="Mʉgala w'oMʉndʉ">Mʉgala w'oMʉndʉ</char> andahotherwa ko bakʉlʉ b'abaheri n'a<char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">bakangɨrɨtsya b'oMʉgomba</char>. N'abo bandamʉsohera lʉholo, <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />na bandamuhira mo minwe y'abandʉ b'ebɨhanda, bʉshana bamʉshekeretsye, n'imuhumba, n'ɨmʉbamba ko mʉsalaba. N'ekɨro kya kashathʉ andalubuka.»<verse eid="MAT 20:19" /></para>
  <para style="s">Omʉshabe wa nyinya w'abana ba Sebetayo</para>
  <para style="r">(<ref loc="MRK 10:35-45">Mar 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Aho nyinya wa bagala ba Sebetayo mwahikira Yesʉ na bagala bʉwe n'ɨfʉkama embere sɨwe bʉshana n'ɨmʉshaba kɨnwa kɨgʉma. <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />Yesʉ mwamʉbʉtsya athɨ: «Ushondya ki?» Mwamʉshʉbɨtsya athɨ: «Wandabya wabya mo Bwamɨ bwawe, ʉhamʉle abagala baye babɨrɨ aba bikale, omʉgʉma ko lʉnda lwawe lw'amalyo n'ogʉndɨ ko lw'amalembe.» <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />Yesʉ mwashubya athɨ: «Muthetsi ekyo omʉshaba. Mwanganakotsya ɨshoma olwatha lwa malɨgo lo nyashoma?» Mobamʉshʉbɨtsya bathɨ: «Ega, thwangakotsya.» <verse eid="MAT 20:22" /><verse number="23" style="v" sid="MAT 20:23" />Aho Yesʉ mwabwɨrabo athɨ: «Kwenene mwandashoma olwatha lwaye lwa malɨgo.<note caller="+" style="f"><char style="fr" closed="false">20:23 </char><char style="ft" closed="false">Soma Mɨkolano 12:2.</char></note> Hewethuwe erikatsya abandʉ ko lʉnda lwaye lw'amalyo kʉtse lw'amalembe, nyɨthalɨ ingye ngyo nyangahamʉla. Nɨ Gongo yowene yo wandahira abandʉ athangaga ithegekania ko myʉnda eyo.»<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Abandɨ bɨga ikumi babere bonvwa ebyo, mobatsɨbʉkɨra bagala ba Sebetayo abo. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Aho Yesʉ mwabɨrɨkɨrabo n'ɨbwɨrabo athɨ: «Mwetsi ko abakʉlʉ b'abandʉ b'ebɨhanda abanathegeka abandʉ mʉ kahatho, n'abakʉlʉ babo abanikala kʉbo. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Aho ebyo bɨthatholere ibya bithyo mo kathi kenyu. He omʉndʉ amashondya ibya mʉkʉlʉ mw'imwe, lɨtholere niabya mukoli enyu. <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />Na mʉndʉ mʉlebe amashondya ibya mʉmbere mw'imwe, lɨtholere niabya mʉkobe enyu. <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />Ni bathyo ko <char style="w">Mʉgala w'oMʉndʉ</char> ahikaga, lɨthalɨ ɨkolerwa, hewethuwe ɨkolerana n'ɨhana obʉyɨngo bʉwe bubye ndihi bʉshana n'ɨshabʉla bandʉ bangɨ.»<note caller="+" style="f"><char style="fr" closed="false">20:28 </char><char style="ft" closed="false">Soma 26:28; 1Tiomote 2:6.</char></note><verse eid="MAT 20:28" /></para>
  <para style="s">Yesʉ alamya mbumi ibiri</para>
  <para style="r">(<ref loc="MRK 10:46-52">Mar 10:46-52</ref>; <ref loc="LUK 18:35-43">Luk 18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Yesʉ n'abɨga bʉwe babere bathoka iYeriko, muhindano mʉnene wa bandʉ mwamʉkwama. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Ko mʉsɨke w'enzɨra kwabyaga nikwikere mbumi ibiri. Babere bonvwa ko Yesʉ atsʉka, mobathanga ɨhambala bathɨ: «Nyinya-kowethʉ<note caller="+" style="f"><char style="fr" closed="false">20:30 </char><char style="ft" closed="false">Mashako magʉma wa kera athalɨmo ekɨnwa: Nyinya-kowethʉ.</char></note>, Mʉgala wa <char style="w" lemma="Tawiti">Tawiti</char>, thʉfwɨre shashi!» <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />Omuhindano mwakemerabo n'ɨbwɨrabo bʉshana batsɨre. He mobashʉba hambala kʉtsɨbʉ bathɨ: «Nyinya-kowethʉ, Mʉgala wa <char style="w">Tawiti</char>, thʉfwɨre shashi!» <verse eid="MAT 20:31" /><verse number="32" style="v" sid="MAT 20:32" />Yesʉ mwimana, mwabɨrɨkɨrabo n'ɨbʉtsyabo athɨ: «Omushondya nyɨbakolere ki?» <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />Mobamʉshʉbɨtsya bathɨ: «Nyinya-kowethʉ, amesho ethʉ atsɨbʉkale!» <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />Yesʉ mwafwɨrabo shashi na mwakola ko mesho wabo, aho n'aho mobashʉba lola, na mobamʉkwama.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">Yesʉ ɨngɨra ɨYerʉsalemʉ</para>
  <para style="r">(<ref loc="MRK 11:1-11">Mar 11:1-11</ref>; <ref loc="LUK 19:28-40">Luk 19:28-40</ref>; <ref loc="JHN 12:12-19">Yoa 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Yesʉ n'abɨga bʉwe babere bahika hofɨ n'ɨYerʉsalemʉ, mobahika ɨBetefake, ko kɨthwa ky'eMiseituni<note caller="+" style="f"><char style="fr" closed="false">21:1 </char><char style="ft" closed="false">Betefake: Mʉrongo alɨ ko lʉhande lw'obʉbʉkɨra ɨtsʉba lw'ekɨthwa ky'emiseituni, ku bilometere bɨrebe n'omuyi w'ɨYerʉsalemʉ.</char></note>. Yesʉ mwathʉma bɨga babɨrɨ <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />n'ɨbwɨrabo athɨ: «Mʉgende mo muyi owalɨ embere senyu, mweyako pʉnda iminirwe hagʉma n'ekyana ky'epʉnda. Mʉmɨnʉletho na mʉnyɨretheretho. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />N'omʉndʉ amababʉtsya kɨnwa, mwamʉshʉbɨtsya mʉthɨ: “Nyinya-kowethʉ alayire kʉtho.” Aho n'aho omʉndʉ oyo abatsɨɨra mʉgende natho.» <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />Ebyo mobyabya bithyo bʉshana bɨbererere ebɨnwa byanegenawa <char style="w" lemma="Mʉmɨnyeretsɨ">n'omʉmɨnyeretsɨ</char> bɨthɨ:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />«Mʉbwɨre abahimbani b'iSayuni mʉthɨ:</para>
  <para style="q1" vid="MAT 21:5">“Shʉnga, omwamɨ enyu abahikira,</para>
  <para style="q1" vid="MAT 21:5">nɨ mʉlonvʉ, na ashambire kʉ pʉnda, kyana ky'epʉnda, ekyana.”<note caller="+" style="f"><char style="fr" closed="false">21:5 </char><char style="ft" closed="false">Sakarɨa 9:9.</char></note>»<verse eid="MAT 21:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="MAT 21:6" />
    <char style="w">Aho abɨga</char> mobageda mobakola nga ko Yesʉ ahamʉlagabo. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Mobaletha epʉnda n'ekyana ky'epʉnda, na mobashesha esongɨmba sabo so kʉtho na Yesʉ mwikala kʉro. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Muhindano wa bandʉ bangɨ mobashesha esongɨmba sabo so mo nzɨra, n'abandɨ bagenda abatsa bɨsanza ko mɨthɨ n'ɨsheshabyo mo nzɨra.<note caller="+" style="f"><char style="fr" closed="false">21:8 </char><char style="ft" closed="false">Lingania na 2Bamɨ 9:13.</char></note> <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Abandʉ bo babyaga ebʉshondotsɨ bwa Yesʉ n'abo babyaga bamukwamire bagenda abahambala bathɨ:</para>
  <para style="q1" vid="MAT 21:9">«Hosana<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="ft" closed="false">Hosana nɨ kɨnwa ky'ekɨebʉranɨa ekinegenire kɨthɨ: «Hika uthuwathikye» </char><char style="ft" closed="false">Soma Saburi 118:25 </char><char style="ft" closed="false">Ekɨnwa ekyo mokyabya kɨnwa ky'ɨsɨma n'isingya Gongo.</char></note> kʉ Mʉgala wa <char style="w">Tawiti</char>!</para>
  <para style="q1" vid="MAT 21:9">Agashanɨrwe yo uhika kw'ɨtsɨna lya Nyinya-kowethʉ!</para>
  <para style="q1" vid="MAT 21:9">Hosana kʉ Gongo w'eLʉgʉlʉ Kʉtsɨbʉ mo lʉbʉla!»<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Yesʉ abere ɨngɨra ɨYerʉsalemʉ, omuyi woshi mwathabagana. Abandʉ mobathanga ibutsania bathɨ: «Nɨ ndɨ oyu?» <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />Omuhindano w'abandʉ mobashubya bathɨ: «Nɨ Yesʉ <char style="w" lemma="mʉmɨnyeretsɨ">mʉmɨnyeretsɨ</char> w'iNasareti mo kɨhʉgo ky'iNgalilaya.»<verse eid="MAT 21:11" /></para>
  <para style="s">Yesʉ abɨnga abahingania mo Nyʉmba ya Gongo</para>
  <para style="r">(<ref loc="MRK 11:15-19">Mar 11:15-19</ref>; <ref loc="LUK 19:45-48">Luk 19:45-48</ref>; <ref loc="JHN 2:13-22">Yoa 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Honyuma kw'aho, Yesʉ mwɨngɨra mo <char style="w">Nyʉmba ya Gongo</char>, mwathɨbɨtha ko boshi bo bagenda abagʉtsya n'abo bagenda abagʉlɨramo. Mwakʉmbagatsya esonyɨgalɨ s'abahingania b'esofaranga n'ebifumbi by'abahingania b'amakʉkʉ. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Na mwabwɨrabo athɨ: «Kushakirwe kʉthɨ:</para>
  <para style="q1" vid="MAT 21:13">“Enyʉmba aye yandahʉlwamo nyʉmba ya mɨshabe.”</para>
  <para style="q1" vid="MAT 21:13">H'imwe mwayirire mʉro mo kabishamo k'abashamuli!»<note caller="+" style="f"><char style="fr" closed="false">21:13 </char><char style="ft" closed="false">Soma Isaya 56:7; Yeremia 7:11.</char></note><verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Esombumi n'ebɨrema mobyayɨfʉnda ahalɨ Yesʉ mo <char style="w">Nyʉmba ya Gongo</char> na mwalamyabyo. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" /><char style="w" lemma="Muheri">Abakʉlʉ b'abaheri</char> n'<char style="w" lemma="aBakangɨrɨtsya b'oMʉgomba">aBakangɨrɨtsya b'oMʉgomba</char> mobatsɨbʉka babere bashʉnga b'yerishwekya Yesʉ agenda akola, n'abana bo bagenda abahambalɨra mo <char style="w" lemma="Nyʉmba ya Gongo">Nyʉmba ya Gongo</char> bathɨ: «Hosana Mʉgala wa <char style="w">Tawiti</char>!» <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Aho mobabʉtsya Yesʉ bathɨ: «Unonvwire ebyo abana aba abanegena?» Yesʉ mwashʉbɨtsyabo athɨ: «Ega. Mʉthanahera mwathasoma mo mashako ahanegenire hathɨ:</para>
  <para style="q1" vid="MAT 21:16">“Mo mʉnʉ w'abana balere n'esonzolyana, monyayɨhalamba?”»<verse eid="MAT 21:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 21:17" />Honyuma kw'aho mwamikabo na mwathoka mo muyi w'ɨYerʉsalemʉ na mwaya ɨBetanɨa n'oko, mwagonzerako.<verse eid="MAT 21:17" /></para>
  <para style="s">Yesʉ athakɨra omutini owathahekire biguma</para>
  <para style="r">(<ref loc="MRK 11:12-14">Mar 11:12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Bwabere bwakya mo makerakera, Yesʉ abere anemʉshʉba mo muyi w'ɨYerʉsalemʉ, mwafwa nzala. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Mwashʉnga mʉthɨ w'omutini emʉsɨke w'enzɨra, mwayɨfʉnda hofɨ nawo, he mwathashʉnga kʉwo ko kɨndʉ, mweyako ebɨthɨ bɨsha. Aho mwathakɨra omʉthɨ oyo athɨ: «Ʉthɨndashʉbaheke biguma ihika kera na kera!» Aho n'aho, omʉthɨ oyo mwʉma.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />
    <char style="w">Abɨga</char> babere bashʉnga kw'ebyo, mobashweka kʉtsɨbʉ n'ɨnegena bathɨ: «Omutini oyu amʉma athɨ konakathambi?» <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />Yesʉ Mwashʉbɨtsyabo athɨ: «Kwenene enyɨbabwɨra, mwamabya na lwɨkɨrɨtsyo bʉtsɨra ɨthɨka-thɨka, nemwe nɨmwandakola ebyo nyamakolera omutini oyu. Na mwamabwɨra ekɨthwa eki mʉthɨ: “Yɨkʉle aho na ʉyɨgʉshe mo ngetsɨ,” ebyo nɨbyandakoleka. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Mwamabya mʉlɨ na lwɨkɨrɨtsyo, ebyoshi mwandashaba Gongo mwandabonabyo.»<verse eid="MAT 21:22" /></para>
  <para style="s">Amaka wa Yesʉ athoka hayi?</para>
  <para style="r">(<ref loc="MRK 11:27-33">Mar 11:27-33</ref>; <ref loc="LUK 20:1-8">Luk 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Yesʉ mwɨngɨra mo <char style="w">Nyʉmba ya Gongo</char> na mwathanga ɨkangɨrɨtsya. <char style="w" lemma="Muheri">Abakʉlʉ b'abaheri</char> n'abangʉmwa b'abandʉ mobayɨfʉnda hofɨ naye n'ɨmʉbʉtsya bathɨ: «Ʉkola ebyoshi ebi kʉ maka ahɨ? Na nɨ ndɨ yo wakʉhaga amaka ayo?» <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />Yesʉ mwashʉbɨtsyabo athɨ: «Nangye nyababʉtsya kɨnwa kɨgʉma, kɨgʉma kuroshi. Mwamanyɨshʉbɨtsya, aho nangye nɨnyababwɨra nga nɨ kʉ maka ahɨ ko enyɨkola ebɨnwa ebi. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Amaka wa Yoani w'eribatisya abandʉ athokaga hayi? Athokaga ewa Gongo kʉtse ko bandʉ?» Mobathanga ibutsania ɨbo kw'ɨbo bathɨ: «Thwamashubya thʉthɨ: “Athokaga ewa Gongo,” nɨathʉbwɨra athɨ: “Bʉshana na ki momʉthamwɨkɨrɨtsya?” <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Na thwamanegena thʉthɨ: “Athokaga ko bandʉ,” thwamʉbaha abandʉ, kʉshangwa aboshi bɨkɨrɨtsye ko Yoani abyaga <char style="w" lemma="mʉmɨnyeretsi">mʉmɨnyeretsɨ</char>.» <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Aho mobashʉbɨtsya Yesʉ bathɨ: «Thuthetsi.» Naye kuthyo mwabwɨrabo athɨ: «Nangye kuthyo nyɨthɨbabwɨre nga enyɨkola ebɨnwa ebi kʉ maka ahɨ.»<verse eid="MAT 21:27" /></para>
  <para style="s">Mushinga wa bana babɨrɨ</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />«Omʉganɨtsya ki kw'ebi? Mʉndʉ mʉgʉma abyaga awithe bagala babɨrɨ. Mwabwɨra omʉmbere athɨ: “Mwana aye, munobwire genda ʉyakole mw'ɨshwa ly'emisabibu.” <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />Mʉgala oyo mwashubya athɨ: “Ɨhɨ, nyɨthalɨ enyishondya.” Hewethuwe kwabere kwahwa kathambi, mwayɨshʉbako na mwaya mw'ɨshwa n'ɨkola. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Honyuma kw'aho, mwagendera owakabɨrɨ na mwamʉbwɨra ebɨgʉmerera. Ono ɨye mwamʉshʉbɨtsya athɨ: “Ega nyayayo mbe thatha.” Hewethuwe mwathayayo. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />Ewono, nɨ ndɨ mo babɨrɨ yo wakolaga erishondya l'ishe wabo?» Mobashubya bathɨ: «Omʉmbere.» Aho Yesʉ mwabwɨrabo athɨ: «Enyɨbabwɨra ekwenene, abakarani b'ekoli n'abashɨngɨtsɨ bandabathanga mo <char style="w" lemma="Bwamɨ bwa Gongo">Bwamɨ bwa Gongo</char>. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Kʉshangwa Yoani mwabahikira bʉshana abakangye enzɨra y'obʉthʉnganane na momʉthamwɨkɨrɨtsya, hewethuwe abakarani b'ekoli n'abashɨngɨtsɨ ɨbo mobamwɨkɨrɨtsya. He imwe na momwanashʉngaga ebɨnwa byoshi ebyo, momʉthabɨndʉka ɨthoka mo bɨtsɨbʉ byenyu na momʉthamwɨkɨrɨtsya.»<verse eid="MAT 21:32" /></para>
  <para style="s">Omushinga w'abahingi babɨ</para>
  <para style="r">(<ref loc="MRK 12:1-12">Mar 12:1-12</ref>; <ref loc="LUK 20:9-19">Luk 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />«Mʉhʉlɨkɨrɨtsye ʉndɨ mushinga. Kwabyaga mʉndʉ mʉgʉma yo wahɨngaga ɨshwa lɨwe lya misabibu. Mwathimbya kʉlyo ko lʉgʉthʉ, mwakomya handʉ h'erɨkamɨra emisabibu na mwahimba kathegeryo k'abatheya<note caller="+" style="f"><char style="fr" closed="false">21:33 </char><char style="ft" closed="false">Soma Isaya 5:1-2.</char></note>. Honyuma kw'aho mwakondesalyo ku bahingi na mwagenda lʉgendo. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Ebɨro by'erɨoha emisabibu byabere byahika, mwathʉma abakoli bʉwe ko bahingi abo bʉshana bamʉhe engemo. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Hewethuwe abahingi mobatsɨmba abakoli bʉwe, mobahumba omʉgʉma, n'ogʉndɨ mobamwitha, n'ogʉndɨ mobamuhumanga mabwe. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Aho, omwenye erɨshwa mwashʉba thʉma bandɨ bakoli bangɨ kʉlenga abambere, hewethuwe abahingi abo mobayɨrabo nga ko bayɨraga abambere. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Ko nduli, mwathʉmɨrabo mʉgala alɨ aganɨtsya athɨ: “Bashikya mʉgala aye.” <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Hewethuwe abahingi abo babere bashʉnga mʉgala, mobabwɨrana ɨbo kw'ɨbo bathɨ: “Shʉnga omuli w'omwandʉ yoyo! Thumwithe na thʉyɨtsɨmbɨre omwandʉ ʉwe!” <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Aho mobamʉtsɨmba, mobamʉgʉsha emʉsɨke w'erɨshwa na mobamwitha.» <verse eid="MAT 21:39" /><verse number="40" style="v" sid="MAT 21:40" />Aho Yesʉ mwabʉtsya athɨ: «Ewono, omwenye <char style="w" lemma="Musabibu">erɨshwa ly'emisabibu</char> andabya ashʉbʉla andayɨra abahingi abo bo athɨ?» <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />Mobamʉshʉbɨtsya bathɨ: «Andɨthɨsa abandʉ babɨ abo bʉthashashɨra, na andaha erɨshwa eryo lyo bandɨ bahingi, bo bandamʉha engemo ko ndambi ɨtholere.»<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Yesʉ mwashʉba bwɨrabo athɨ: «Mʉthahera mwathasoma ebyo bishakirwe mo Mashako Abuyirire byo binegenire bɨthɨ:</para>
  <para style="q1" vid="MAT 21:42">“Eribwe lyathɨndawa n'abahimbi</para>
  <para style="q1" vid="MAT 21:42">lyo lyabere ibwe ly'ekoni.</para>
  <para style="q1" vid="MAT 21:42">Ekɨnwa kɨno ekɨthoka ewa Nyinya-kowethʉ,</para>
  <para style="q1" vid="MAT 21:42">nakyo ni ky'erishwekya mo mesho ethʉ.”<note caller="+" style="f"><char style="fr" closed="false">21:42 </char><char style="ft" closed="false">Eribwe ly'ekoni lyo lɨnatsɨmbɨrɨra enyʉmba yoshi.</char></note><verse eid="MAT 21:42" /></para>
  <para style="m">
    <verse number="43" style="v" sid="MAT 21:43" />Bʉshana n'ekyo enyɨbabwɨra nyɨthɨ <char style="w" lemma="Bwamɨ bwa Gongo">oBwamɨ bwa Gongo</char> mwandanyagʉlwabo na bwandahabwa abandʉ bo bandabʉtha biguma byo bɨtholere oBwamɨ obo. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />[Yo wandayihinda kw'ibwe eryo, andakonongoka n'oyo wandathogerako eribwe eryo, lyandamuthundula.»]<note caller="+" style="f"><char style="fr" closed="false">21:44 </char><char style="ft" closed="false">Omʉlondo ono athalɨ mʉ mashako mangɨ wa kera. Shʉnga Luka 20:18.</char></note><verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />
    <char style="w" lemma="Muheri">Abakʉlʉ b'abaheri</char> <char style="w" lemma="Bafarisayo:">n'aBafarisayo</char> babere bonvwa emishinga ya Yesʉ, mobamɨnya ko n'ɨbo bo agenda ahʉla. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Aho mobashondya ko bangamʉtsɨmba, he mobʉbaha omuhindano wabyaga niatsimbire Yesʉ nga <char style="w" lemma="mʉmɨnyeretsɨ">mʉmɨnyeretsɨ</char>.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Mushinga wa linye lya buheruki</para>
  <para style="r">(<ref loc="LUK 14:15-24">Luk 14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Yesʉ mwashʉba negena n'omuhindano oyo mo mishinga. Mwabwɨrabo athɨ: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />«oBwamɨ bw'elʉbʉla bushoshire nga mwamɨ mʉgʉma yo wakoleraga erihikya lya mʉgala lyo linye. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Mwathʉma abakoli bʉwe bayabɨrɨkɨre abo balalɨkawa ko linye. Hewethuwe mobathanza ihika. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Mwashʉbathʉma bandɨ bakoli bayabwɨre abo balalɨkawa mbʉ: “Elinye lyaye lyamahika, ebɨmasa byaye n'esɨndɨ nyama sinunire samamala ɨkerwa, ebyoshi byalumirire. Muhike ko linye ly'obuheruki!” <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Hewethuwe abo balalɨkawa mobathatsomanabyo, mobayɨgendera mʉgʉma mw'ɨshwa lɨwe na ʉndɨ mo buhingania bʉwe. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Abandɨ mobatsɨmba abakoli abo, mobashʉngyabo kya bwana na mobithabo. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Omwamɨ mwatsɨbʉka, mwathʉma abashirikani bʉwe bayithe abithi abo n'iokya omuyi wabo. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Honyuma kw'aho mwabwɨra abakoli bʉwe athɨ: “Akalyo k'obuheruki kamahya, hewethuwe abo balalɨkawa babyaga nɨbathatholere. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Aho, mʉgende mo mahwa n'aboshi mwashʉngako mʉbwɨrebo bahike ko linye ly'obuheruki.” <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Abakoli mobaya mo sonzɨra n'ihindania aboshi bo bashʉngagako, ababɨ n'ababʉya. Aho, ekɨshenge ky'elinye mokyotsulamo abo balalɨkawa. <verse eid="MAT 22:10" /><verse number="11" style="v" sid="MAT 22:11" />Omwamɨ mwɨngɨra mo kɨshenge ky'elinye bʉshana ayalole kw'abo bathalalɨkwa. Mwashʉnga mʉbo mo mʉndʉ mʉgʉma yo wabyaga niathambithe lʉkɨmba lw'elinye. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Omwamɨ mwamʉbʉtsya athɨ: “Mwira aye, ʉthɨngɨra mʉno mo ʉthɨ ɨwe uthambithe lʉkɨmba lw'elinye?” Hewethuwe omʉndʉ oyo mwathashubya kɨndʉ. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />Aho omwamɨ mwabwɨra abakoli athɨ: “Mʉmʉmɨne ko bɨshando n'oko maboko na mʉmʉgʉshe mo mwitsimya mw'embʉga. Eyo y'alɨrɨra n'ishya ameno.<note caller="+" style="f"><char style="fr" closed="false">22:13 </char><char style="ft" closed="false">Soma 8:12.</char></note>”»<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />Honyuma kw'aho Yesʉ mwanegena athɨ: «Abalalɨkawa nɨ bangɨ hewethuwe abashombolwa nɨ bake.»<verse eid="MAT 22:14" /></para>
  <para style="s">Yesʉ abʉtsɨbwa bʉshana n'erɨrɨha ekoli</para>
  <para style="r">(<ref loc="MRK 12:13-17">Mar 12:13-17</ref>; <ref loc="LUK 20:20-26">Luk 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Honyuma kw'aho, <char style="w" lemma="Bafarisayo">aBafarisayo</char> mobaya nama bʉshana bamɨnye nga bangatsɨmba Yesʉ yo bathɨ mw'ɨmʉthega kɨnwa. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Mobamʉthʉmɨra bagʉma <char style="w" lemma="Abɨga">b'oko bɨga</char> babo na bagʉma b'oko kɨkembe kya <char style="w">Herote</char> bayamʉbwɨre bathɨ: «Mʉkangɨrɨtsya, thwetsi ko ʉnanegena ekwenene na ʉnakangɨrɨtsya enzɨra ya Gongo mo kwenene yoshi. Ʉthʉbaha mʉndʉ na ʉthatsomana bʉkʉlʉ bwa mʉndʉ. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Ewo thathʉbwɨra emɨganɨtsye awe ko kɨnwa kɨno: “Thunahamulirwe ɨrɨha ekoli ya <char style="w" lemma="Kaisari">Kaisari</char> kʉtse ɨhɨ?”» <verse eid="MAT 22:17" /><verse number="18" style="v" sid="MAT 22:18" />Hewethuwe Yesʉ mw'ɨmɨnya emɨganɨtsye yabo mɨbɨ mwashʉbɨtsyabo athɨ: «Imwe bayimbya, omʉnyɨrengako bʉshana na ki? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Munyikangye esofaranga sosɨnalɨhwamo ekoli.» Mobamukangya kɨtsere kɨgʉma kya faranga. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Yesʉ mwabʉtsyabo athɨ: «Eshoshani n'erɨtsɨna byo bishakirwe ebi nɨ bya ndɨ?» <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />Mobamʉshʉbɨtsya bathɨ: «Nɨ bya Kaisari.» Aho Yesʉ mwabwɨrabo athɨ: «Mʉhe Kaisari y'ebya Kaisari na mʉhe Gongo y'ebya Gongo.» <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />Babere bonvwa erishubya lɨwe, mobashweka kʉtsɨbʉ. Mobamumika na mobayɨgendera.<verse eid="MAT 22:22" /></para>
  <para style="s">Ebirebitsye erilubuka ly'abaholi</para>
  <para style="r">(<ref loc="MRK 12:18-27">Mar 12:18-27</ref>; <ref loc="LUK 20:27-40">Luk 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Ekɨro kɨsha-kɨsha ekyo <char style="w" lemma="Basandukayo">Basandukayo</char> bagʉma mobayɨfʉnda ahalɨ Yesʉ. Abasandukayo nɨ abo bananegena bathɨ hathalɨ erilubuka,<note caller="+" style="f"><char style="fr" closed="false">22:23 </char><char style="ft" closed="false">Soma Mɨkolano 23:8.</char></note> Mobamʉbʉtsya bathɨ: <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />«Mʉkangɨrɨtsya, Mʉsa mwanegena athɨ: “Omuyira amafwa bʉthayɨra bana, mʉgala abo n'ɨngɨrɨra omʉshʉmbakatsɨ bʉshana ahe yo wafwaga yo bana.”<note caller="+" style="f"><char style="fr" closed="false">22:24 </char><char style="ft" closed="false">Soma Ɨbʉka Mʉgomba 25:5-6.</char></note> <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Ewo, mokathi kethʉ mwabyaga basole balɨnda ba mʉ nda ngʉma. Omʉmbere mwaherukya, mwafwa bʉthayɨra mwana. Mwamikira omʉshʉmbakatsɨ yo mʉlʉmʉna ʉwe. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Mobyabya bithyo kʉ mʉgalabo wa kabɨrɨ, na ko w'akashathʉ ihika ko balɨnda boshi. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Enyuma y'aboshi erɨfwa, omʉkatsɨ naye mwafwa. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Ewono, ekɨro ky'erilubuka ly'abaholi, omʉkatsɨ oyo andabya wa ndɨ mo balɨnda? Kʉshangwa abalɨnda boshi mobamuhikya!»<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Yesʉ mwashʉbɨtsyabo athɨ: «Omʉyɨthɨma kʉshangwa muthetsi, ibye aMashako ibye amaka wa Gongo. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Kʉshangwa abaholi bandabya balubuka, kuthindabye ihikya kʉtse ihikibwa, hewethuwe bandabya ng'abamalaɨka mo lʉbʉla. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Ko kɨnwa ky'erilubuka ly'abaholi, momʉthasoma ekɨnwa Gongo ababwɨraga? Mwanegena athɨ: <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />“Nyɨrɨ Gongo wa <char style="w">Abʉrahamʉ</char>, Gongo wa Isaka na Gongo wa Yakobo.”<note caller="+" style="f"><char style="fr" closed="false">22:32 </char><char style="ft" closed="false">Soma Ɨthoka 3:6.</char></note> Yesʉ mwongerera athɨ Gongo nɨ Gongo w'abalɨho, he athalɨ w'abaholi.» <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />Emihindano yabere yonvwa ebyo mobashwekera amakangɨrɨtsya ʉwe.<verse eid="MAT 22:33" /></para>
  <para style="s">Erithegeko inene kʉlenga awandɨ</para>
  <para style="r">(<ref loc="MRK 12:28-34">Mar 12:28-34</ref>; <ref loc="LUK 10:25-28">Luk 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />
    <char style="w" lemma="Bafarisayo:">aBafarisayo</char> babere bonvwa kw'a<char style="w" lemma="Basandukayo">Basandukayo</char> mobabʉsha byo bangashʉba negena, mobahindana. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Mʉgʉma wa kʉbo, mʉkangɨrɨtsya <char style="w" lemma="Mʉgomba">w'oMʉgomba</char>, mwashondya ɨthega Yesʉ mwamʉbʉtsya athɨ: <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />«Mʉkangɨrɨtsya, lɨhɨ lyo ithegeko lɨkʉlʉ <char style="w" lemma="Mʉgomba">ly'omo Mʉgomba</char>?» <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />Yesʉ mwamʉshʉbɨtsya athɨ: «Ʉtsɨɨre Nyinya-kowethʉ Gongo wawe n'omʉthɨma awe woshi, n'emɨganɨtsye awe yoshi, n'obwenge bwawe boshi.<note caller="+" style="f"><char style="fr" closed="false">22:37 </char><char style="ft" closed="false">Soma Ɨbʉka Mʉgomba 6:5.</char></note> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Eryo ly'<char style="w" lemma="ithegeko">ithegeko</char> inene, kandɨ lyo na limbere. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Na lɨno ly'ithegeko lya kabɨrɨ, lɨshoshene n'erimbere: “Ʉtsɨɨre mulikyenyu nga wowene.”<note caller="+" style="f"><char style="fr" closed="false">22:39 </char><char style="ft" closed="false">Soma Balawi 19:18.</char></note> <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" /><char style="w" lemma="Mʉgomba">oMʉgomba</char> woshi wa Mʉsa n'amakangɨrɨtsya woshi <char style="w" lemma="Mulaguli wa Gongo">w'aBamɨnyeretsɨ</char> athokire ko mathegeko abɨrɨ ayo.»<note caller="+" style="f"><char style="fr" closed="false">22:40 </char><char style="ft" closed="false">Soma 7:12.</char></note><verse eid="MAT 22:40" /></para>
  <para style="s">Kirisito na Tawiti</para>
  <para style="r">(<ref loc="MRK 12:35-37">Mar 12:35-37</ref>; <ref loc="LUK 20:41-44">Luk 20:41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Mo ndambi <char style="w" lemma="Bafarisayo:">aBafarisayo</char> babyaga nibahindene, Yesʉ mwabʉtsyabo athɨ: <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />«Omʉganɨtsya ki kʉ Kirisito? Nɨ mʉgala wa ndɨ?» Mobamʉshʉbɨtsya bathɨ: «Nɨ mʉgala wa <char style="w" lemma="Tawiti">Tawiti</char>.» <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />Yesʉ mwabwɨrabo athɨ: «Bʉshana na ki <char style="w" lemma="Tawiti">Tawiti</char> ashondolerwe n'omʉthɨma Mwerʉ mwahʉla Kirisito mo “Nyinya-kowabo”? Kʉshangwa <char style="w">Tawiti</char> mwanegena athɨ<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />Nyinya-kowethʉ Gongo mwabwɨra Nyinya-kowethʉ athɨ:</para>
  <para style="q1" vid="MAT 22:44">“Hika wikale ko malyo aye,</para>
  <para style="q1" vid="MAT 22:44">ihika ko kɨro nyandahira esonzigu sawe ekihya y'ebɨshando byawe.<note caller="+" style="f"><char style="fr" closed="false">22:44 </char><char style="ft" closed="false">Soma 110:1.</char></note>”»<verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />«<char style="w" lemma="Tawiti">Tawiti</char> amahʉla Kirisito mo “Nyinya-kowethʉ,” kʉthɨ ko Kirisito angabya mʉgala wa <char style="w" lemma="Tawiti">Tawiti</char>?» <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Mohathabya n'omʉgʉma wa kʉbo yo washubyaga kɨnwa n'ekɨgʉma, na ɨthoka ekɨro ekyo, mokuthashubabya mʉndʉ yo wamʉbʉtsyaga kɨnwa.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Mahano bʉshana n'aBafarisayo</para>
  <para style="r">(<ref loc="MRK 12:38-40">Mar 12:38-40</ref>; <ref loc="LUK 11:39-52">Luk 11:39-52</ref>; <ref loc="LUK 20:45-46">20:45-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Honyuma kw'aho, Yesʉ mwabwɨra omuhindano hagʉma <char style="w" lemma="Abɨga">n'abɨga</char> bʉwe athɨ: <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />«<char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">aBakangɨrɨtsya b'oMʉgomba</char> <char style="w" lemma="Bafarisayo">n'aBafarisayo</char> mobahabwa maka w'erɨkangɨrɨtsya abandʉ bw'oMʉgomba wa Mʉsa. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Aho lɨtholere nimwashikyabo n'ɨkola ebyoshi abababwɨra, hewethuwe mʉthakwamaga emɨkolere yabo, kʉshangwa ebyo abanegena bɨthalɨ byo banakola. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Abanakana mɨtsɨgo mɨtsɨtho, n'ihekyaro abandɨ bandʉ ko bithigo, hewethuwe ɨbo bene-bene abanathɨnda ishukyaro mu munwe bʉshana bangɨrɨrebo. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />Ebyoshi abanakola, abanakolabyo bʉshana bayikangye ko bandʉ. Aho, abananenehya ehɨkopo hɨrɨmo hɨbabɨ hishakireko eBɨnwa Bibuyirire hyo banamɨnɨra ko bʉsʉ na ko minwe. Na kandɨ, abanambala ropo eso abanayɨra emɨsɨke yatho mo mɨre-mɨre.<note caller="+" style="f"><char style="fr" closed="false">23:5 </char><char style="ft" closed="false">Ngɨmba siwithe mɨsɨke mɨre-mɨre: Ɨkwamana n'emɨbere eyi, aBafarisayo bagenda abayikangania ko bashikitsye amathegeko wa Gongo. Shʉnga Ɨthoka 13:9; 16; Mɨganzo 15:37-41.</char></note><figure style="fig" alt="Philactère" file="hk00274b.tif" size="col" copy="Horace Knowles" ref="23:5">Muyuta ambithe akakopo ko bʉsʉ ako kalɨmo kababɨ kashakirweko bɨnwa bibuyirire</figure> <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Atsiire ikala mo myanya y'embere mo linye na ko bifumbi by'embere mo <char style="w" lemma="Sinakoki:">sosinakoki</char>. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />Atsiire ɨketsɨbwa na lʉkengerwa mo mihindano nɨahʉlwa n'abandʉ mo Bakangɨrɨtsya.»<verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />«He imwe, mʉthatsɨɨraga abandʉ babwahʉlemo “mʉkangɨrɨtsya,” kʉshangwa mʉlɨ bagala kʉ bagala na muwithe Mʉkangɨrɨtsya mʉgʉma. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Hano ishi, muthanalinda mwahʉla mʉndʉ mo “Thatha,” kʉshangwa muwithe Thatha mʉgʉma, nɨ yo ʉlɨ elʉbʉla. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Na kandɨ mʉthɨmɨraga abandʉ babwahʉlemo “Bakʉlʉ,” kʉshangwa muwithe Mʉkʉlʉ mʉgʉma, naye nɨ Kirisito. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Hewethuwe omʉkʉlʉ mw'imwe atholere niabya mʉgombe enyu. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Bʉlɨ mʉndʉ yo wandayihamya andakimibwa, hewethuwe obʉlɨ mʉndʉ yo uyihohya andahamibwa.»<verse eid="MAT 23:12" /></para>
  <para style="s">Yesʉ athakɨra aBakangɨrɨtsya b'oMʉgomba n'aBafarisayo</para>
  <para style="r">(<ref loc="MRK 12:40">Mar 12:40</ref>; <ref loc="LUK 11:39-52">Luk 11:39-52</ref>; <ref loc="LUK 20:45-47">20:45-47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />«Bʉhanya kw'imwe, Bakangɨrɨtsya b'oMʉgomba <char style="w" lemma="Bafarisayo:">na kw'imwe Bafarisayo</char>, bayimbya! Omʉkɨngɨra abandʉ b'oluyi lw'oBwamɨ bw'elʉbʉla, imwe bene mʉthalɨ omwɨngɨra mʉbo, n'abo bashondya ɨngɨra mʉbo omʉkɨkɨrabo.» [<verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />«Bʉhanya kw'imwe, Bakangɨrɨtsya b'oMʉgomba n'aBafarisayo, bayimbya! Omʉnanyaga abashʉmbakatsɨ bw'ebyo bawitheko n'ɨyɨra mɨshabe mɨre-mɨre bʉshana muyikanganie. Bʉshana n'ekyo mwandasohwa kʉtsɨbʉ<note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">omʉlondo ono athalɨ mʉ mashako magʉma wa kera.</char></note>!»]<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />«Bʉhanya kw'imwe, <char style="w">Bakangɨrɨtsya b'oMʉgomba</char> <char style="w" lemma="Bafarisayo">n'aBafarisayo</char>, bayimbya! Omʉnaya ahoshi n'ɨshabʉka esongetsɨ, n'ɨtsʉka mo bɨhʉgo bʉshana mʉbɨndʉle mʉndʉ mʉgʉma abye mwɨga enyu. Na mwamamʉbona nɨmwamʉyɨramo mʉndʉ yo atholere esohi y'okw'ɨrʉnga ngendo kabɨrɨ kʉbalenga<note caller="+" style="f"><char style="fr" closed="false">23:15 </char><char style="ft" closed="false">Hano Yesʉ akemera aBafarisayo bathahiraga abo bathɨkɨrɨtsya mw'ishikya oMʉgomba wo kʉtsɨbʉ, nɨalemana kʉshangwa niamabya wa kahatho.</char></note>.»<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />«Bʉhanya kw'imwe, bashondotsɨ mbumi! Omʉnanegena mʉthɨ: “Mʉndʉ amalahɨtsya ko <char style="w" lemma="Nyʉmba ya Gongo:">Nyʉmba ya Gongo</char>, ekyo kɨthalɨ kɨndʉ, hewethuwe amalahɨtsya ko horo <char style="w" lemma="Nyʉmba ya Gongo">y'omo Nyʉmba ya Gongo</char>, lɨtholere nɨabereretsya erɨlahɨtsya eryo.” <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Imwe thʉhʉmo na mbumi! Kɨhe kyo kirengitsye kirikyabo, ehoro kʉtse <char style="w" lemma="Nyʉmba ya Gongo:">eNyʉmba ya Gongo</char> yo yɨnayɨra ehoro mo <char style="w" lemma="Mubuyirire">nyibuyirire</char>? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Kandɨ omʉnegena mʉthɨ: “Omʉndʉ amalahɨtsya ko lʉtarɨ, aho hathalɨ ki, hewethuwe amalahɨtsya ko <char style="w">bɨhembo</char> byo bɨrɨ ko lʉtarɨ, oyo atholere ɨbereretsya erɨlahɨtsya lɨwe.” <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Imwe mbumi! Iki kyo kilengitsye ekɨndɨ, <char style="w" lemma="Bɨhembo">ebɨhembo</char>, kʉtse olʉtarɨ lo lʉnayɨra <char style="w" lemma="Bɨhembo">ebɨhembo</char> mo <char style="w" lemma="Mubuyirire">bibuyirire</char>? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Kwenene, yo wamalahɨtsya kw'ɨtsɨna ly'olʉtarɨ, nɨamalahɨtsya kʉlo n'ebyoshi bɨrɨ kʉlo. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Yo wamalahɨtsya kw'ɨtsɨna ly'<char style="w" lemma="Nyʉmba ya Gongo:">eNyʉmba ya Gongo</char>, nɨamalahɨtsya kʉlyo na kʉ Gongo yo wikeremo. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Yo wamalahɨtsya kw'ɨtsɨna ly'olʉbʉla nɨamalahɨtsya n'oko lʉthebe lwa Gongo na Gongo yo wikere kʉlo<note caller="+" style="f"><char style="fr" closed="false">23:22 </char><char style="ft" closed="false">Lingania na Isaya 66:1; Matayo 5:34.</char></note>.»<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />«Bʉhanya kw'imwe, Bakangɨrɨtsya <char style="w" lemma="Mʉgomba">b'oMʉgomba</char> <char style="w" lemma="Bafarisayo:">n'aBafarisayo</char>, bayimbya! Omunahulukya kɨgʉma k'ikumi kya myaka ya nyinyi.<note caller="+" style="f"><char style="fr" closed="false">23:23 </char><char style="ft" closed="false">Soma Balawi 27:30; Ɨbʉka Mʉgomba 14:22.</char></note> Hewethuwe omʉnasʉnzʉgʉra ebishikibwe mo <char style="w">Mʉgomba</char>, nga obʉthʉnganene, eshashi, n'olwɨkɨrɨtsyo. Nɨ ebyo byo mwangagendire omʉkola, bʉthasʉnzʉgʉra ebɨndɨ ebyo. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Imwe bashondotsɨ mbumi! Omunatsuya eby'erɨshoma bʉshana muthokyemo eshuki, hewethuwe omʉmera engamɨa!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />«Bʉhanya kw'imwe, <char style="w" lemma=" b'oMʉgomba">Bakangɨrɨtsya b'oMʉgomba</char> <char style="w" lemma="Bafarisayo">n'aBafarisayo</char>, bayimbya! Omʉnetsya embʉga y'olwatha n'embale, hewethuwe mo kathi kabyo nimotswire bɨndʉ by'obwɨtsɨ na by'esongʉmbʉ mbɨ. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" /><char style="w" lemma="Bafarisayo">Ɨwe Mufarisayo</char> mbumi! Thanga wetsya mo kathi k'olwatha aho n'embʉga yalo nɨyera.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />«Bʉhanya kw'imwe, <char style="w">Bakangɨrɨtsya b'oMʉgomba</char> <char style="w" lemma="Bafarisayo:">n'aBafarisayo</char>, bayimbya! Mushoshire nga masɨnda athahakwa mbemba.<note caller="+" style="f"><char style="fr" closed="false">23:27 </char><char style="ft" closed="false">Amasɨnda w'aBayuta anahakwa rangi ya mʉshohe, bʉshana abandʉ bathafʉlaga kʉwo mo kɨro na bathahatsyaga, na bathangandashabwa ndihi y'ɨetsɨbwa.</char></note> Embʉga ashoshire kʉbʉya, hewethuwe omwishi, otswiremo mafʉha wa baholi na bʉlɨ mʉhanda wa mɨkonzɨ. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Nemwe kuthyo, embʉga omʉshʉngɨka mo mesho w'abandʉ nga bandʉ bathʉnganene, he mo kathi kenyu mwotswiremo obuyimbya n'ebɨbɨ.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />«Bʉhanya kw'imwe, <char style="w">Bakangɨrɨtsya b'oMʉgomba</char> <char style="w" lemma="Bafarisayo">n'aBafarisayo</char>, bayimbya! Omunahimba amasɨnda w'a<char style="w" lemma="bamɨnyeretsɨ">bamɨnyeretsɨ</char>, n'ɨhaka mbemba ko masɨnda w'abathʉnganene. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Nemwe omʉnegena mʉthɨ: “Thwangabereho mo bɨro by'abo thatha-kʉlʉ, thuthangayire mo nama yabo y'eritha <char style="w" lemma="abamɨnyeretsɨ">abamɨnyeretsɨ</char>.” <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Aho, imwe bene-bene mwamɨkɨrɨtsya ko mʉlɨ bana b'abo bithaga <char style="w" lemma="Bamɨnyeretsɨ">aBamɨnyeretsɨ</char>. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Aho, mʉhɨrɨke, mʉmalɨrɨre ebyo bo sho-kʉlʉ benyu bathangaga! <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />Imwe nzoka, lʉbʉtho lwa bɨkwetha! Mʉthɨ ko mwandalama esohi y'okw'ɨrʉnga? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Ekyo kyo kɨreka nɨnyabathʉmɨra <char style="w" lemma="Bamɨnyeretsye">bamɨnyeretsɨ</char>, na bangʉmwa <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">na bakangɨrɨtsya</char>. Mwanditha bagʉma ba mʉbo na mwandabamba abandɨ ko mɨsalaba, n'abandɨ mwandahumbabo mbasha mo <char style="w" lemma="Sinakoki:">sosinakoki</char> senyu na mwandaliithabo ɨthoka muyi kʉ ʉndɨ. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Aho, omʉsasɨ w'abandʉ bathʉnganene, ow'asheshawa bʉtsɨra bɨbɨ hano ishi, ɨthoka kʉ Abeli mʉthʉnganene ihika kʉ Sakarɨa mʉgala wa Barakia yo mwithiraga ho kathi k'ahabuyirire n'olʉtarɨ andabya ko mithwe enyu. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Kwenene enyɨbabwɨra, ebyoshi ebyo byandabya ko muthwe w'olʉgero lwa munobwire!»<verse eid="MAT 23:36" /></para>
  <para style="s">Yesʉ alɨrɨra omuyi w'ɨYerʉsalemʉ</para>
  <para style="r">(<ref loc="LUK 13:34-35">Luk 13:34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />«Yerʉsalemʉ, Yerʉsalemʉ, ɨwe unitha <char style="w" lemma="Bamɨnyeretsɨ">aBamɨnyeretsɨ</char> n'itha mʉ mabwe bo Gongo akʉthʉmɨra! Ngendo nyɨngɨ monyashondya ihindania abana bawe hofɨ nangye ng'engoko ko inahindania ehipyege hyaro mo bipupa byaro, hewethuwe momwathɨnda! <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Aho, mʉmɨnye ko enyʉmba enyu yabya kihuma.<note caller="+" style="f"><char style="fr" closed="false">23:38 </char><char style="ft" closed="false">Soma Yeremia 22:5.</char></note> <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Kʉshangwa enyɨbabwɨra nyɨthɨ ɨthoka munobwire mʉthɨndashʉbe nyɨlolako ihika ko ndambi mwandanegena mʉthɨ: “Agashanɨrwe yo uhika kw'ɨtsɨna lya Nyinya-kowethʉ!”<note caller="+" style="f"><char style="fr" closed="false">23:39 </char><char style="ft" closed="false">Soma Saburi 118:26.</char></note>»<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">Yesʉ afʉla mwatsɨ w'erɨshambʉlwa ly'eNyʉmba ya Gongo</para>
  <para style="r">(<ref loc="MRK 13:1-2">Mar 13:1-2</ref>; <ref loc="LUK 21:5-6">Luk 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Yesʉ mwathoka mo <char style="w" lemma="Nyʉmba ya Gongo">Nyʉmba ya Gongo</char>. Abere anemʉgenda, <char style="w" lemma="abɨga">abɨga</char> bʉwe mobayɨfʉnda hofɨ naye bʉshana bamukangye emihimbire <char style="w" lemma="Nyʉmba ya Gongo">y'eNyʉmba ya Gongo</char>. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Aho Yesʉ mwanegena n'ɨbwɨrabo athɨ: «Mʉnatsene ko byoshi ebi? Kwenene enyɨbabwɨra, hano hathindashibe kiro n'ibwe elʉgʉlʉ wa lɨndɨ, awoshi andabɨndʉlwa.»<verse eid="MAT 24:2" /></para>
  <para style="s">Malɨgo na magali</para>
  <para style="r">(<ref loc="MRK 13:3-13">Mar 13:3-13</ref>; <ref loc="LUK 21:7-19">Luk 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Yesʉ abere anikere ko kɨthwa ky'eMiseituni, <char style="w">abɨga</char> bʉwe mobayɨfʉnda hofɨ naye emʉsɨke n'ɨmʉbʉtsya bathɨ: «Thʉbwɨre ebyo nga byandabya kɨro ki, na kɨhe kyo kɨmɨnyɨkalo kyandathukangya endambi wandahika na ky'enduli y'ekɨhʉgo.»<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Yesʉ mwashʉbɨtsyabo athɨ: «Mʉmɨnyage, mʉndʉ athabathɨmaga. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Kʉshangwa bandʉ bangɨ bandahika mw'ɨtsɨna lyaye nɨabanegena bathɨ: “Ingye ngyo Kirisito!” Na bandahetsya bandʉ bangɨ.» <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Mwand'onvwa mwatsɨ w'ebita na hwehweri ya bita. Mubye mesho mʉthʉbahaga, lɨtholere ebyo nɨ byabya, hewethuwe naki ɨthalɨ mɨhwere y'ekɨhʉgo kɨno. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Kʉshangwa ekɨhanda kyandalwa n'ekɨndɨ, na bwamɨ bwandalwa na bʉndɨ. Kwandabya nzala na thulingiti handʉ hangɨ-hangɨ. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Ebyoshi ebyo byandabya nga bwagali bwa mʉkatsɨ akʉnda.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />«Aho, abandʉ bandabanubya na bandabwitha. Ebɨhanda byoshi byandababaga bʉshana n'erɨtsɨna lyaye. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Aho, bandʉ bangɨ bandathɨnda olwɨkɨrɨtsyo lwabo. Bandahotherana ɨbo kw'ɨbo na bandabagana ɨbo kw'ɨbo. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Bamɨnyeretsɨ bangɨ ba mabesɨ bandahʉlʉka na bandathɨma bandʉ bangɨ. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Bʉshana n'erɨongerera ly'ebɨbɨ, lwanzo lwa bandʉ bangɨ lwandaholoka. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Hewethuwe yo wandatsitsinia ihika ko nduli andashabʉlwa. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />eNgʉlʉ Mbʉya y'oBwamɨ bwa Gongo, yandafʉlwa mo kɨhʉgo kyoshi bʉshana ibye butimo ko bandʉ boshi b'ebɨhanda. Honyuma kw'aho enduli y'ekɨhʉgo yandahika.»<verse eid="MAT 24:14" /></para>
  <para style="s">Magali matsɨbʉ</para>
  <para style="r">(<ref loc="MRK 13:14-23">Mar 13:14-23</ref>; <ref loc="LUK 21:20-24">Luk 21:20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />«Mwandabya mwashʉnga ko yo ʉnahʉlwamo “Mubihya” <char style="w" lemma="mʉmɨnyeretsɨ">yo mʉmɨnyeretsɨ</char> Ndanieli ahʉlaga, andabya imana ahandʉ habuyirire yo ʉsoma ebɨnwa bɨno amɨnyebyo kʉbʉya! <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />Aho, bo bandabya iYuteya bagende bashayɨre ko bɨthwa. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Yo wandeyibwa ko lʉthwe lw'enyʉmba athandakima bʉshana ayaheke ebɨndʉ bɨrɨ omwe.<note caller="+" style="f"><char style="fr" closed="false">24:17 </char><char style="ft" closed="false">24:15 </char><char style="ft" closed="false">Amanyʉmba w'aBayuta agenda abya na nyithwe sa kɨtara-tara, wo bagenda abakimako kʉ kɨrʉkɨro kyo kyagenda ekibya embʉga yawo.</char></note> <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Na yo wandeyibwa mw'ɨshwa athandafʉlʉka bʉshana ayaheke ekoti yɨwe. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Bwandabya bʉhanya mo bɨro ebyo ko bakatsɨ bakʉle na kw'abo bandabya niabongya! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Mʉshabe Gongo bʉshana mʉthandashaga mo bɨro by'embeho kʉtse ekɨro <char style="w" lemma="Sabato">ky'eSabato</char>! <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Kʉshangwa mo bɨro ebyo, amalɨgo andabya mangɨ kʉlenga amalɨgo woshi amalire ibya hano ishi ɨthoka ko ndangɨro y'ekɨhʉgo ihika munobwire, na kuthindashubabye bʉndɨ bʉlɨgo bʉlɨ buthyo.<note caller="+" style="f"><char style="fr" closed="false">24:21 </char><char style="ft" closed="false">Soma na Ndanieli 12:1.</char></note> <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Ebɨro bya malɨgo ebyo bɨrɨ bithakehibawa, hathangabere n'omʉndʉ n'omʉgʉma yo wangashabwirwe. Hewethuwe bʉshana n'abashombolawa, ebɨro ebyo byandakehibwa.<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />«Aho, mʉndʉ amababwira athɨ: “Mʉlole, <char style="w" lemma="Kirisito, Masia">Kirisito</char> alɨ hano!” kʉtse: “Alɨ hala!” Mʉthamwɨkɨrɨtsyaga. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Kʉshangwa bo kirisito b'amabesɨ na bamɨnyeretsɨ b'amabesɨ bandahʉlʉka. Nabo bandakola bɨthɨko-thɨko, na bɨndɨ b'ishwekya ihika ko kɨka, bɨrɨ byangathokekana, bahetsye abandʉ Gongo ashombolaga. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Mʉhʉlɨkɨrɨtsye! Nyamababwɨra ebyoshi byo embere.»<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />«Aho bandʉ bamababwɨra mbʉ: “Mʉlole! alɨ mo <char style="w">mbwarara</char>,” nɨmʉthayagayo. Kʉtse bamababwɨra mbʉ: “Mʉlole, abishamire mo kɨshenge,” nɨmʉthɨkɨrɨtsya. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Kʉshangwa ng'omulabyo kw'anakoletsya ɨthoka ebʉbʉkɨra ɨtsʉba ihika ebʉlengera ɨtsʉba, ni bathyo <char style="w" lemma="Mʉgala w'oMʉndʉ">ko Mʉgala w'oMʉndʉ</char> andahika. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Ahoshi ahalɨ ekinda, ho amahʉngʉ anahindana.»<verse eid="MAT 24:28" /></para>
  <para style="s">Erihika lya Mʉgala w'oMʉndʉ</para>
  <para style="r">(<ref loc="MRK 12:24-27">Mar 12:24-27</ref>; <ref loc="LUK 21:25-28">Luk 21:25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />«Honyuma w'amalɨgo w'ebɨro ebyo,</para>
  <para style="q1" vid="MAT 24:29">erɨtsʉba lyandabyamo mwitsimya, omʉgenda athɨndashʉbe ɨkoletsya,</para>
  <para style="q1" vid="MAT 24:29">esongununu sandathoga ɨthoka mo kyanya</para>
  <para style="q1" vid="MAT 24:29">n'ebyoshi by'amaka mo kyanya byandathenganibwa.<note caller="+" style="f"><char style="fr" closed="false">24:29 </char><char style="ft" closed="false">Soma Isaya 13:10; 34:4; Tsekeli 32:7; Yoeli 2:10; 3:4.</char></note><verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />«Aho, ekɨmɨnyɨkalo ky'oMʉgala w'oMʉndʉ kyandahʉlʉka mo kyanya. Aho, abandʉ boshi ba hano ishi bandaganga-ganga, bandalola ko <char style="w">Mʉgala w'oMʉndʉ</char> niahika ko bɨfʉ by'omo kyanya hagʉma na maka mangɨ na lʉkengerwa.<note caller="+" style="f"><char style="fr" closed="false">24:30 </char><char style="ft" closed="false">Soma Ndanieli 7:13.</char></note> <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Ekɨroro kɨnene kyandahambala, andathʉma abamalaɨka bʉwe ko mbande ine s'olʉbʉla bʉshana bashongye abo ashombolaga, ɨthoka mo kɨhʉgo kyoshi.<note caller="+" style="f"><char style="fr" closed="false">24:31 </char><char style="ft" closed="false">Soma Ɨbʉka mʉgomba 30:4; Nehemia 1:9; Sakarɨa.</char></note>»<verse eid="MAT 24:31" /></para>
  <para style="s">Mushinga w'omʉthɨ w'omutini</para>
  <para style="r">(<ref loc="MRK 13:28-32">Mar 13:28-32</ref>; <ref loc="LUK 21:29-33">Luk 21:29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />«Mwɨge ko mushinga w'omʉthɨ w'omutini. Ko mʉgʉlʉ emɨthahɨ y'omutini eyɨlasha n'ebɨthɨ bya kʉro ebɨlasha, omʉnamɨnya kw'omʉgʉlʉ w'ekyanda alɨ hofɨ. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Na kuthyo, nemwe mwandabya mwalola ko byoshi ebyo, nɨmwamɨnya k'oMʉgala w'oMʉndʉ alɨ hofɨ, na alɨ ho lukyo. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Kwenene enyɨbabwɨra, olʉgero lʉno lʉthɨndatsʉke embere ebyoshi bɨno bɨbererere. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Olʉbʉla n'ekɨhʉgo byandatsʉka, hewethuwe ebɨnwa byaye bɨthɨndatsʉke n'ahake.»<verse eid="MAT 24:35" /></para>
  <para style="s">Gongo yowene yo wetsi ekɨro ky'enduli</para>
  <para style="r">(<ref loc="MRK 13:32-37">Mar 13:32-37</ref>; <ref loc="LUK 17:26-30">Luk 17:26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />«Hewethuwe hathalɨ mʉndʉ yo wetsi ekɨro kʉtse endambi y'ebyo byandakoleka. Ibye abamalaɨka mo lʉbʉla, ibye Mʉgala wa Gongo <note caller="+" style="f"><char style="fr" closed="false">24:36 </char><char style="ft" closed="false">Ibye Mʉgala: Ekɨnwa kɨno kɨthalɨ mʉ mashako malebe.</char></note> kuthyo athetsi, he Thatha mʉsha yo wetsi. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Nga ko byabyaga ko mʉgʉlʉ wa Noa, bithyo ko byandabya ekɨro <char style="w" lemma="Mʉgala w'oMʉndʉ">oMʉgala w'oMʉndʉ</char> andahika. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Kʉshangwa mo bɨro ebyo embere envʉla nyɨngɨ yɨwe, abandʉ bagenda abalya n'ɨshoma, bagenda abahikya n'ɨhana balɨ babo bahikibwe, ihika ko kɨro Noa ɨngɨraga mo bwatho.<note caller="+" style="f"><char style="fr" closed="false">24:38 </char><char style="ft" closed="false">Soma Ndangɨro 6:9-7:6.</char></note> <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />Abandʉ abo mobathamɨnya kɨndʉ ihika ko kɨro envʉla y'ekithi yawaga n'itsikya aboshi.<note caller="+" style="f"><char style="fr" closed="false">24:39 </char><char style="ft" closed="false">Soma Ndangɨro 7:7-24.</char></note> Kuthyo ko byandabya ekɨro <char style="w" lemma="Mʉgala w'oMʉndʉ">oMʉgala w'oMʉndʉ</char> andashʉbʉla. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Aho, bandʉ babɨrɨ bandabya mw'ɨshwa, mʉgʉma andathwalwa n'oʉndɨ andamikwa. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Bakatsɨ babɨrɨ bandabya niabashya ko lushyo, mʉgʉma andathwalwa n'oʉndɨ andamikwa.»<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />«Kwenzi muyitheye, kʉshangwa muthetsi ekɨro Nyinya-kowenyu andahika. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Mwetsi kʉbʉya ko omwenye enyʉmba angaminyire nga omwɨtsɨ ahika mo kɨro kʉ ndambi ehɨ, angatheyitsye na athangalikire omwɨtsɨ athobole omwe. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Bʉshana n'ekyo, nemwe kuthyo, muyithegekanie, kʉshangwa <char style="w" lemma="Mʉgala w'oMʉndʉ">oMʉgala w'oMʉndʉ</char> andahika ko ndambi muthetsi.»<verse eid="MAT 24:44" /></para>
  <para style="s">Mukoli w'iyinihirwa</para>
  <para style="r">(<ref loc="LUK 12:41-48">Luk 12:41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />«Ɨndɨ yo mukoli mwenge na w'iyinihirwa? Nɨ yo nyinya-kowabo ahaga omʉlɨmo w'imanira abandɨ bakoli n'ɨhabo akalyo kabo ko ndambi yɨtholere. <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Agashanɨrwe omukoli yo nyinya-kowabo mw'ɨshʉbʉla lɨwe, andamweya nɨakola omʉlɨmo oyo. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Kwenene enyɨbabwɨra, nyinya-kowabo andamʉyɨramo mwimanitsi w'ebɨndʉ bɨwe byoshi. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Hewethuwe omukoli oyo amabya nɨ mʉndʉ mʉbɨ nɨayɨbwɨra mo mʉthɨma ʉwe athɨ: “Nyinya-kowethʉ amathɨndɨra ɨshʉbʉla, <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />na nɨathanga ihumba abakoli balikyabo, nialya n'ɨshoma hagʉma n'abakundirya, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />aho, nyinya-kowabo omukoli oyo, andashʉbʉla mʉ kɨro athamulindire na kʉ ndambi athetsi. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Andamʉthɨbɨthako na andamʉkolera nga ko banakolera abayimbya. Eyo yandabya bɨrɨro n'ishya ameno.”»<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">Mushinga w'abanyere ikumi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />«Ekɨro ekyo, oBwamɨ bw'elʉbʉla bwandashosha nga banyere ikumi bo batsɨmbaga esotara sabo bʉshana bayalɨndɨrɨre omuherukya. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Bathano ba mʉbo babyaga thʉhʉmo n'abandɨ bathano babyaga benge. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Abo babyaga thʉhʉmo mobaheka so tara sabo bʉthaheka bitoroli by'ongerera mʉtho. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Hewethuwe, abenge ɨbo, mobaheka na mirangi ɨrɨmo bitoroli b'ihira mo tara sabo. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Hewethuwe, kʉshangwa omuherukya mwathahika tsʉba, abanyere boshi mobalʉha na mobayatho. <verse eid="MAT 25:5" /><verse number="6" style="v" sid="MAT 25:6" />Mo kathi k'ekɨro, omʉlenge mw'onvwɨka athɨ: “oMuherukya yoyo! Muyamukokye!” <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />Aho, abanyere boshi abo, mobabʉka na mobathegekania eso tara sabo. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Othʉhʉmo mothwabwɨra abenge thʉthɨ: “Mʉthʉhe ko bitoroli byenyu, kʉshangwa so tara sethʉ sɨhera esɨtsɨma.” <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />Abenge mobashubya bathɨ: “Ɨhɨ, ebitoroli thuwitheko nɨ bɨke kw'ithwe nemwe. Mʉgende eyɨrɨ abahingania mʉyɨgʉlɨre.” <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Othʉhʉmo mothwayagʉla bitoroli. Mo ndambi eyo, omuherukya mwahika. Abanyere bathano bo babyaga bawithe bitoroli mobɨngɨra naye mo kɨshenge ky'elinye ly'endwa, n'oluyi molwakɨngwa. <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" />Honyuma kw'aho, abandɨ banyere mobahika nɨabanegena bathɨ: “Nyinya-kowethʉ, Nyinya-kowethʉ, thʉkɨngʉlɨre!” <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />Hewethuwe omuherukya mwashubya athɨ: “Kwenene enyɨbabwɨra, nyithabwetsi.”»<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />«Yesʉ mwashʉba negena athɨ: “Muyitheye kʉshangwa muthetsi ekɨro kʉtse endambi nyandashʉbʉla.”»<verse eid="MAT 25:13" /></para>
  <para style="s">Mushinga w'abakoli bashathʉ</para>
  <para style="r">(<ref loc="LUK 19:11-27">Luk 19:11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />«oBwamɨ bw'elʉbʉla bwandabya nga ko muyira mʉgʉma yo walalɨtsyaga lʉgendo. Mwabɨrɨkɨra abakoli bʉwe n'iwathyabo obushoki bʉwe. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Mwaha mʉgʉma yo bɨtsere<note caller="+" style="f"><char style="fr" closed="false">25:15 </char><char style="ft" closed="false">Kɨtsere kikomibwe mʉ horo: Mashako magʉma anegenire athɨ talanta. N'etalanta ngʉma yabyaga ɨrɨngene na bɨtsere igana bya horo. </char></note> magana athano bya horo, na ʉndɨ magana abɨrɨ, n'owa kashathʉ igana. Mwagabɨra ebɨtsere by'ehoro ko bʉlɨ mʉndʉ ɨkwamana n'akagala kʉwe. Honyuma kw'aho mwagenda. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Omukoli yo wahabawa ebɨtsere magana athano by'ehoro mwagenda ɨyakola buhingania mo faranga etho na mwathʉnda bɨndɨ bɨtsere magana athano bya horo. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Na kuthyo, yo wahabawa ebɨtsere magana abɨrɨ mwathʉnda bɨndɨ bɨtsere magana abɨrɨ. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Hewethuwe yo wahabawa bɨtsere igana mwayathima kyuna mo kɨthaka n'ibisha mʉkyo mw'esofaranga sa nyinya-kowabo. <verse eid="MAT 25:18" /><verse number="19" style="v" sid="MAT 25:19" />Honyuma wa bɨro bɨngɨ, nyinya-kowabo abakoli abo mwashʉbʉla na mwathanga ɨkola nabo emɨganzo y'obushoki bʉwe. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Oyo wahabawa ebɨtsere magana athano by'ehoro mwayɨfʉnda embere n'ikangya nyinya-kowabo yo bɨndɨ bɨtsere magana athano n'ɨnegena athɨ: “Nyinya-kowethʉ, mowanyɨha bɨtsere magana athano bya horo. Monyathundire bɨndɨ magana athano, bye bɨno.” <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />Nyinya-kowabo mwamʉbwɨra athɨ: “Wamakola kʉbʉya, ʉlɨ mukoli mʉbʉya na w'iyinihirwa. Mowabere w'iyinihirwa mʉ bɨndʉ bɨke, nyakʉyɨramo mwimanitsi wa bɨndʉ bɨngɨ. Hika ʉmoge hagʉma na nyinya-kowenyu.” <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />Omukoli yo wahabawa ebɨtsere magana abɨrɨ bya horo mwayɨfʉnda embere, mwanegena athɨ: “Nyinya-kowethʉ, mowanyɨha bɨtsere magana abɨrɨ bya horo. Monyathundire bɨndɨ magana abɨrɨ, nabyo bye bɨno.” <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />Nyinya-kowabo mwamʉbwɨra athɨ: “Wamakola kʉbʉya, ʉlɨ mukoli mʉbʉya na w'iyinihirwa. Mowabere w'iyinihirwa mʉ bɨndʉ bɨke, nyakʉyɨramo mwimanitsi wa bɨndʉ bɨngɨ. Hika ʉmoge hagʉma na nyinya-kowenyu.” <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />Omukoli yo wahabawa ebɨtsere igana naye mwayɨfʉnda embere n'ɨnegena athɨ: “Nyinya-kowethʉ, nyikwetsi mo mʉndʉ mʉtsɨbʉ, ʉnagesha ho ʉthabɨbaga, ʉnakʉma-kʉma ho ʉthasanzaga. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Monyʉbaha na monyayabisha ebɨtsere byawe mo kɨthaka. Ewo, tsɨmba ebɨwawe.” <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />Nyinya-kowabo mwamʉshʉbɨtsya athɨ: “Ʉlɨ mukoli mʉbɨ, mʉgatha! Wabyaga niwetsi kw'enyɨnagesha ho nyɨthabɨbaga na enyɨnakʉma-kʉma ho nyɨthasanzaga kɨndʉ! <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Ewo, uthangahirire esofaranga saye mo bangɨ, na mw'ɨshʉbʉla lyaye, nyangathokitsyetho hagʉma n'endundi yatho. <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Mʉmʉnyage ebɨtsere igana by'ehoro ebyo na mʉhebyo yo uwithe kʉ kɨhʉmbɨ. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Kʉshangwa obʉlɨ mʉndʉ yo uwithe kɨndʉ andahabwa kalengyo na andabya mʉ mʉkene, hewethuwe yo uthawithe kɨndʉ, andanyagʉlwa n'akake awitheko. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />N'omukoli wa bʉsha-bʉsha oyu, mʉmʉgʉshe embʉga, mo mwitsimya, eyo alɨra n'ishya ameno.”»<verse eid="MAT 25:30" /></para>
  <para style="s">Esohi y'enduli</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />«<char style="w" lemma="Mʉgala w'oMʉndʉ">Mo mʉgʉlʉ oMʉgala w'oMʉndʉ</char> andabya ahika mo lʉkengerwa lʉwe hagʉma n'abamalaɨka boshi, andikala ko lʉthebe lʉwe lubuyirire lw'elyamɨ. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Ebɨhanda byoshi bya hano ishi byandahindana embere sɨwe na andagabania abandʉ bɨkembe bɨbɨrɨ nga k'omulishya anagabania sombuli n'esombene. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Andahira esombuli ko malyo ʉwe n'esombene ko malembe ʉwe. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Aho omwamɨ andabwɨra bo balɨ ko malyo ʉwe athɨ: “Muhike, momugashanirwe na Thatha, na mwɨngɨre mo Bwamɨ bo bwathegekanibawa bʉshana nemwe, ɨthoka ko kɨro ekɨhʉgo kyahangɨkawa. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Kʉshangwa monyafwa nzala momwanyɨha kalyo, monyafwa nyotha momwanyɨha metsi w'ɨshoma, nyabyaga mugeni momwanyikokya. <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Nyabyaga ndumbu momwanyambikya, nyabyaga mukoni momwaya nyilungula, nyabyaga mo muliki momwitsa nyɨlolako.” <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />Aho abathʉnganene bandamʉshʉbɨtsya bathɨ: “Nyinya-kowethʉ, kɨro ki kyo thwakʉshʉngaga uwirire mothwakʉha kalyo, kʉtse ufwire nyotha mothwakʉha metsi w'ɨshoma? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Kɨro ki kyo thwakʉshʉngagamo mugeni na mothwakukokya, ndumbu na mothwakwambikya? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Kɨro ki kyo thwakʉshʉngaga ʉlɨ mukoni kʉtse uminirwe mothwayakulungula?” <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Omwamɨ andashʉbɨtsyabo athɨ: “Kwenene enyɨbabwɨra, obʉlɨ kɨndʉ mwakoleraga mʉgʉma w'oko bagala bethʉ balere kʉtsɨbʉ aba, n'ingye mwakoleragakyo.”»<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />«Honyuma kw'aho, omwamɨ andabwɨra bo bandabya ko malembe ʉwe athɨ: “Mʉye hale nangye, imwe muthakirwe! Mʉye mo mʉtsanwa w'ekera n'ekera owanokibawa bʉshana na <char style="w">Sitani</char> n'abamalaɨka bʉwe! <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Kʉshangwa monyafwa nzala momʉthanyɨha kalyo, monyafwa nyotha momʉthanyɨha metsi w'ɨshoma. <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Nyabyaga mugeni, momuthanyikokya. Nyabyaga ndumbu, momuthanyambikya. Nyabyaga mukoni na mʉndʉ wa muliki, momuthanyilungula.” <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />Aho, bandashubya bathɨ: “Nyinya-kowethʉ, kɨro ki kyo thwakʉshʉngaga uwirire, kʉtse ufwire nyotha, kʉtse ʉlɨ mugeni, kʉtse ʉlɨ ndumbu, kʉtse ʉlɨ mukoni, kʉtse ʉlɨ mʉ muliki na mothʉthakʉlwako?” <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />Omwamɨ andashʉbɨtsyabo athɨ: “Kwenene enyɨbabwɨra, ko bʉlɨ kɨndʉ mʉthakoleraga mʉgʉma w'oko balere aba, ni ingye mʉthakolerakyo.”» <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />Bandahabwa malipisi w'ekera n'ekera, he bo bakolaga ebɨthʉnganene, bandabya na bʉyɨngo bw'ekera n'ekera.<note caller="+" style="f"><char style="fr" closed="false">25:46 </char><char style="ft" closed="false">Soma Ndanieli 12:2.</char></note><verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">Enama y'eritha Yesʉ</para>
  <para style="r">(<ref loc="MRK 14:1-2">Mar 14:1-2</ref>; <ref loc="LUK 22:1-2">Luk 22:1-2</ref>; <ref loc="JHN 11:45-53">Yoa 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Yesʉ abere amamala amakangɨrɨtsya woshi ayo, mwabwɨra <char style="w">abɨga</char> bʉwe athɨ: <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />«Mwetsi kw'elinye <char style="w" lemma="Pasaka">ly'ePasaka</char> lyabya mʉ bɨro bɨbɨrɨ, n'oMʉgala w'oMʉndʉ andahotherwa bʉshana abambwe kʉ mʉsalaba.»<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Aho <char style="w" lemma="Muheri">abakʉlʉ b'abaheri</char> n'abangʉmwa b'aBayuta mobahindana mo nyʉmba ya Kayafa <char style="w" lemma="Muheri">Muheri Mʉkʉlʉ</char>. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Mobahʉlɨkɨrɨrana ɨtsɨmba Yesʉ mʉ menge bʉshana bamwithe. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Hewethuwe bagendaga abanegena bathɨ: «Thʉthamʉmɨnaga ekɨro ky'elinye, bʉshana abandʉ bathangakarama.»<verse eid="MAT 26:5" /></para>
  <para style="s">Mʉkatsɨ ashesha mafʉtha ko muthwe wa Yesʉ</para>
  <para style="r">(<ref loc="MRK 14:3-9">Mar 14:3-9</ref>; <ref loc="JHN 12:1-8">Yoa 12:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Yesʉ abere alɨ ɨBetanɨa mo nyʉmba ya Simoni Mʉbenzɨ, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />mʉkatsɨ mʉgʉma mwayɨfʉnda hofɨ naye niahekire murangi wa marasi wa kɨtsɨro kɨnene. Yesʉ abere anemulya, omʉkatsɨ mwashesha amarasɨ ayo ko muthwe ʉwe. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" /><char style="w">Abɨga</char> babere bashʉnga ebyo, mobatsɨbʉka n'ɨnegena bathɨ: «Bʉshana na ki bubihya bʉlɨ ng'obu? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Amarasɨ aya angagutsibwe kɨtsɨro kɨnene, n'ɨha esofaranga s'abatsene!»<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Yesʉ mwamɨnya emɨanɨtsye yabo, mwabwɨrabo athɨ: «Omunubya omʉkatsɨ oyu bʉshana na ki? Ebyo amanyɨkolera bikwirire. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Kʉshangwa mwandabya n'abatsene ebɨro byoshi, h'ingye, muthindabye nangye ebɨro byoshi. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Omʉkatsɨ oyu amashesha amarasi aya ko mʉbɨrɨ aye, bʉshana n'ithegekania erɨthabwa lyaye. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Kwenene enyɨbabwɨra, ahoshi handafʉlwa <char style="w" lemma="Ngʉlʉ Mbʉya">Engʉlʉ Mbʉya</char> eyi, mo kɨhʉgo kyoshi, bandaganʉlɨra eby'omʉkatsɨ oyu athakola, na andagenda ɨbʉkwa.»<verse eid="MAT 26:13" /></para>
  <para style="s">Yuta ahothera Yesʉ</para>
  <para style="r">(<ref loc="MRK 14:10-11">Mar 14:10-11</ref>; <ref loc="LUK 22:3-6">Luk 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Aho, mʉgʉma w'oko bɨga ikumi na babɨrɨ, yo wahʉlawamo Yuta Isikariote, mwaya eyɨrɨ <char style="w" lemma="Muheri">abakʉlʉ b'abaheri</char> <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />n'ɨbwɨrabo athɨ: «Mwanyɨha ki nyamabaha Yesʉ?» Aho mobamʉha bɨtsere makumi ashathʉ bya faranga.<note caller="+" style="f"><char style="fr" closed="false">26:15 </char><char style="ft" closed="false">Bɨtsere makumi ashathʉ: Byabyaga bɨrɨngene na lʉhembo lwa mwetsɨ mʉgʉma</char><char style="xt" closed="false">Soma <ref loc="ZEC 11:12">Sakarɨa 11:12</ref>.</char></note> <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Ɨthoka ko ndambi eyo, Yuta mwagenda ashondya mwanya angahanamo Yesʉ.<verse eid="MAT 26:16" /></para>
  <para style="s">Yesʉ alya akalyo k'ePasaka hagʉma n'abɨga bʉwe</para>
  <para style="r">(<ref loc="MRK 14:12-21">Mar 14:12-21</ref>; <ref loc="LUK 22:7-14">Luk 22:7-14</ref>; <ref loc="LUK 22:21-23">Luk 22:21-23</ref>; <ref loc="JHN 13:21-30">Yoa 13:21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Ekɨro kɨmbere ky'elinye ly'emikati <char style="w" lemma="Mikati ɨthemo tsatsʉ">ɨthemo tsatsʉ</char>, <char style="w">abɨga</char> mobayabʉtsya Yesʉ bathɨ: «Ushondya thʉyakʉkometsye akalyo k'ePasaka ko hayi?» <verse eid="MAT 26:17" /><verse number="18" style="v" sid="MAT 26:18" />Yesʉ mwashʉbɨtsyabo athɨ: «Mʉye mo muyi omwa mʉndʉ mʉlebe na mʉmʉbwɨre mʉthɨ: “Nyinya-kowethʉ anegena athɨ endambi aye yamahika, nɨ omwawe monyalɨra ePasaka hagʉma <char style="w" lemma="Abɨga">n'abɨga</char> baye.”» <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" /><char style="w">Abɨga</char> mobakola nga ko Yesʉ ahamʉlagabo na mobatheka akalyo k'ePasaka.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Bwabere bwakʉra, Yesʉ mwalya hagʉma n'abɨga ikumi na babɨrɨ. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Babere banemulya, Yesʉ mwanegena athɨ: «Kwenene enyɨbabwɨra, mʉgʉma wa mw'imwe anyɨhothera.» <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />Abɨga mobafwa bulige bʉnene na mobathanga ɨmʉbʉtsya mʉgʉma mʉgʉma bathɨ: «Ni ingye he Nyinya-kowethʉ?» <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />Yesʉ mwashubya athɨ: «Yo ʉkolera hagʉma nangye mo mbale, nɨ ɨye yo wanyɨhothera. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" /><char style="w" lemma="Mʉgala w'oMʉndʉ">oMʉgala w'oMʉndʉ</char> ayɨgendera nga kw'aMashako anegenire kw'ɨye. Hewethuwe bʉhanya ko yo wamʉhothera! Lyabyaga lɨtholere omʉndʉ oyo nɨathabʉthwa!» <verse eid="MAT 26:24" /><verse number="25" style="v" sid="MAT 26:25" />Yuta, yo wamʉhothera, mwamʉbʉtsya athɨ: «Ni ingye he Mʉkangɨrɨtsya?» Yesʉ mwamʉshʉbɨtsya athɨ: «Nɨ ɨwe wo wamanegena.»<verse eid="MAT 26:25" /></para>
  <para style="s">Linye lya Nyinya-kowethʉ</para>
  <para style="r">(<ref loc="MRK 14:22-26">Mar 14:22-26</ref>; <ref loc="LUK 22:14-20">Luk 22:14-20</ref>; <ref loc="1CO 11:23-25">1Kor 11:23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Babere bakɨnalɨ abalya, Yesʉ mwatsɨmba omukati, abere amamala ɨsɨma Gongo, mwatsitsangawo na mwahawo <char style="w">abɨga</char> bʉwe n'ɨbwɨrabo athɨ: «Mʉtsɨmbe, mulye, ono nɨ mʉbɨrɨ aye.» <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />Honyuma kw'aho, mwatsɨmba olwatha lw'etifai, abere amamala ɨsɨma Gongo, mwahalobo nɨanegena athɨ: «Mʉshomero imwe boshi, <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />kʉshangwa ono nɨ mʉsasɨ aye, mʉsasɨ w'<char style="w">endagane</char> ow'asheshekire bʉshana na bandʉ bangɨ, na bʉshana n'obuganyiri bw'ebɨtsɨbʉ. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Enyɨbabwɨra, ɨthoka lɨno, nyɨthɨndashʉbe shoma ko tifai y'emisabibu ihika ko kɨro nyandashoma nemwe etifai nyihya mo Bwamɨ bwa Thatha.»<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Babere bamamala erimba sosaburi, mobaya ko kɨthwa ky'eMiseituni.<verse eid="MAT 26:30" /></para>
  <para style="s">Yesʉ anegena ko Petero ayɨgana ɨye</para>
  <para style="r">(<ref loc="MRK 14:27-31">Mar 14:27-31</ref>; <ref loc="LUK 22:31-34">Luk 22:31-34</ref>; <ref loc="JHN 13:36-38">Yoa 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Aho Yesʉ mwabwɨra abɨga bʉwe athɨ: «Mo kɨro kɨno, imwe boshi mwanyishiga, kʉshangwa kushakirwe kʉthɨ:</para>
  <para style="q1" vid="MAT 26:31">“Nyanditha omulishya,</para>
  <para style="q1" vid="MAT 26:31">n'ekihyo ky'esombuli kyandasanzabana.”»<verse eid="MAT 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 26:32" />«Hewethuwe, nyandabya nyalubuka, nyandayabalɨndɨra iNgalilaya.» <verse eid="MAT 26:32" /><verse number="33" style="v" sid="MAT 26:33" />Petero mwamʉbwɨra athɨ: «Abandɨ boshi mobangakushiga, ingye nyithindakushige n'ahake.» <verse eid="MAT 26:33" /><verse number="34" style="v" sid="MAT 26:34" />Yesʉ mwamʉshʉbɨtsya athɨ: «Kwenene enyɨkʉbwɨra, mo kɨro kɨno, embere embagatsɨ yɨbɨke, wayɨgana ingye ngendo kashathʉ ʉthɨ uthanyetsi.» <verse eid="MAT 26:34" /><verse number="35" style="v" sid="MAT 26:35" />Petero mwamʉbwɨra athɨ: «Monyangabya mbʉ nyafwa hagʉma nawe, nyɨthɨyɨgane nyɨthɨ nyithakwetsi.» N'abandɨ <char style="w" lemma="Abɨga">bɨga</char> boshi mobanegena bathyo.<verse eid="MAT 26:35" /></para>
  <para style="s">Yesʉ ashabɨra mw'ɨshwa ly'iNgetetsemani</para>
  <para style="r">(<ref loc="MRK 14:32-42">Mar 14:32-42</ref>; <ref loc="LUK 22:39-46">Luk 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Aho Yesʉ mwahika handʉ hagenda ahahʉlwamo Ngetetsemani hagʉma <char style="w" lemma="Abɨga">n'abɨga</char> bʉwe. Mwabwɨrabo athɨ: «Mwikale hano, mo ndambi enyɨya shabɨra halira.» <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Honyuma kw'aho, mwagenda na Petero n'abagala babɨrɨ ba Sebetayo. Mwathanga ɨfwa buliye na n'igangya-gangya mʉthɨma. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Aho mwabwɨrabo athɨ: «Omʉthɨma aye otswiremo buliye ihika ko kɨka ky'ɨfwa. Mushibe hano na mutheye hagʉma nangye.» <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />Yesʉ mwayɨfʉnda hale hake, mwafʉkama obʉsʉ ihika ahishi na mwashaba nɨanegena athɨ: «Thatha, bɨrɨ byangathokekana, fʉnda hale nangye olwatha lw'obwagali olu. Hewethuwe, bithabyaga nga ko nyishashire, he nga ko ushashire.»<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Honyuma kw'aho mwashʉba ahalɨ <char style="w">abɨga</char> na mweyabo nɨbalɨtho. Mwabwɨra Petero athɨ: «Momʉthalɨ omukotsya itheya hagʉma nangye n'esaha n'engʉma? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Mʉthayagatho na mʉshabe nɨmo mʉthɨlengweko. Omʉthɨma afwire muhwa, hewethuwe omʉbɨrɨ nɨ molo.» <verse eid="MAT 26:41" /><verse number="42" style="v" sid="MAT 26:42" />Yesʉ mwayɨfʉnda hale n'ɨya shaba Gongo ngendo lya kabɨrɨ nɨanegena athɨ: «Thatha, olwatha lw'amalɨgo olu lʉlɨ lʉthangatsʉka hale nangye bʉthashoma kʉlo, aho, erɨshasha lyawe lɨkoleke!» <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Kandɨ mwashʉba aho abɨga babyaga, na mweyabo nɨbalɨtho, kʉshangwa amesho wabo abyaga nɨamatsɨthoha bʉshana n'othʉlo. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Yesʉ mwashʉba shigabo, mwashʉba yɨfʉnda n'ɨya shaba ngendo lya kashathʉ nɨashʉbɨrɨra ebɨnwa bɨgʉmerera. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Honyuma kw'aho mwashʉba aho <char style="w">abɨga</char> babyaga n'ɨbwɨrabo athɨ: «mʉkɨnalɨtho n'ɨlʉhʉka? Mʉlole, endambi yamahika <char style="w" lemma="Mʉgala w'oMʉndʉ">oMʉgala w'oMʉndʉ</char> ahirwa mo minwe y'abakoli b'ebɨtsɨbʉ. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Mwimane thʉgende! Mʉlole kw'oyo wamanyɨhothera kʉbo kw'amahika!»<verse eid="MAT 26:46" /></para>
  <para style="s">Ɨtsɨmbwa lya Yesʉ</para>
  <para style="r">(<ref loc="MRK 14:43-50">Mar 14:43-50</ref>; <ref loc="LUK 22:47-53">Luk 22:47-53</ref>; <ref loc="JHN 18:3-12">Yoa 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Yesʉ abere akɨnalɨ anegena, Yuta mʉgʉma w'oko bɨga ikumi na babɨrɨ mwahika. Yuta oyo abyaga na bandʉ bangɨ bahekire miyali na bɨbando. Babyaga nibathumirwe <char style="w" lemma="Muheri">n'abakʉlʉ b'abaheri</char> n'abangʉmwa b'aBayuta. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Yuta, oyo wabyaga nɨamahothera Yesʉ, mwaha abandʉ abo bo kɨmɨnyɨkalo athɨ: «Oyo nyafʉmbatha nɨ ɨye. Mʉmʉtsɨmbe.» <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Aho n'aho Yuta mwayɨfʉnda ahalɨ Yesʉ n'ɨmʉbwɨra athɨ: «Enyɨkʉketsya mbe Mʉkangɨrɨtsya!» Honyuma kw'aho mwamʉfʉmbatha. <verse eid="MAT 26:49" /><verse number="50" style="v" sid="MAT 26:50" />Yesʉ mwamʉbwɨra athɨ: «Mwira aye, kola ebyo bɨthakʉletha.» Aho, abandʉ abo mobayɨfʉnda hofɨ, mobatsɨmba Yesʉ n'ɨmʉmɨna. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Mʉgʉma w'oko bo babyaga na Yesʉ mwahulukya omuyali ʉwe, mwabanda mukoli <char style="w" lemma="Muheri">w'omuheri mʉkʉlʉ</char> n'ɨmʉtsako okuthwi. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Aho Yesʉ mwamʉbwɨra athɨ: «Shubya omuyali awe w'omo lʉba lwawo, kʉshangwa aboshi bo batsɨmba omuyali bandafwa mʉ muyali. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Uthetsi ko nyangalakɨra Thatha anyiwathikye. Aho n'aho anganyɨthʉmɨra bɨkembe bilengitsye ikumi na bɨbɨrɨ bya bamalaɨka? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Hewethuwe, aMashako owanegenire athɨ bɨno bithyo ko byangabere, angabererere athɨ?»<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Honyuma kw'aho Yesʉ mwabwɨra abandʉ abo athɨ: «Iki kyangaleka nimwahika na miyali na bɨbando bʉshana mʉnyɨtsɨmbe nga nyɨrɨ mubandi? Nyagendaga enyikala mo <char style="w">Nyʉmba ya Gongo</char> mw'ebɨro byoshi nyɨrɨ enyɨkangɨrɨtsya, momʉthanyɨmɨna. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Hewethuwe ebyoshi ebyo mobyabya bʉshana n'ebyo <char style="w" lemma="Mʉmɨnyeretsɨ">bamɨnyeretsɨ</char> banegenaga mo Mashako Abuyirire bɨbererere.» Aho <char style="w">abɨga</char> bʉwe boshi mobamushiga na mobashaga.<verse eid="MAT 26:56" /></para>
  <para style="s">Yesʉ embere y'oBʉshenge Bʉkʉlʉ</para>
  <para style="r">(<ref loc="MRK 14:53-65">Mar 14:53-65</ref>; <ref loc="LUK 22:54-55">Luk 22:54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Yoa 18:13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Bo bamɨnaga Yesʉ mobamʉthwala ewa Kayafa <char style="w" lemma="Muheri Mʉkʉlʉ">Muheri Mʉkʉlʉ</char>, eyo aBakangɨrɨtsya b'oMʉgomba n'abangʉmwa b'aBayuta babyaga bahindanire. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Petero mwakwama Yesʉ nɨanalɨ hale, ihika mo kɨbʉga ky'enyʉmba <char style="w" lemma="Muheri Mʉkʉlʉ">y'oMuheri Mʉkʉlʉ</char>. Mwɨngɨra mo kɨbʉga na mwikala hagʉma n'abatheya bʉshana amɨnye nga byahwa bɨthɨ.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />
    <char style="w" lemma="Muheri bakʉlʉ">Abaheri bakʉlʉ</char> <char style="w" lemma="Bʉshenge Bʉkʉlʉ">n'oBʉshenge Bʉkʉlʉ</char> boshi bagendaga abashondya mabesɨ wo bangasitakira Yesʉ bʉshana bamʉsohere lʉholo. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Hewethuwe mobathabonawo, n'omo bandʉ bangɨ mobayɨyɨramo batimo ba bʉbesɨ. Ko nduli bandʉ babɨrɨ mobayɨsɨnga, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />na mobanegena bathɨ: «oMʉndʉ oyu mwanegena athɨ: “Nyangashambʉla <char style="w" lemma="Nyʉmba ya Gongo:">eNyʉmba ya Gongo</char> n'ishubahimbaro mʉ bɨro bɨshathʉ.”» <verse eid="MAT 26:61" /><verse number="62" style="v" sid="MAT 26:62" /><char style="w" lemma="Muheri">oMuheri Mʉkʉlʉ</char> mwimana n'ɨbwɨra Yesʉ athɨ: «Uthishubye kɨndʉ ko byo abandʉ aba abakʉnegenako?» <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Hewethuwe Yesʉ mwatsɨra. Aho <char style="w" lemma="Muheri">oMuheri Mʉkʉlʉ</char> mwamʉbwɨra athɨ: «Kw'ɨtsɨna lya Gongo yo ʉlɨho, enyɨkʉshaba ʉthʉbwɨre mw'ɨlahɨtsya nga nɨ ɨwe <char style="w" lemma="Kirisito, Masia">Kirisito</char>, Mʉgala wa Gongo.» <verse eid="MAT 26:63" /><verse number="64" style="v" sid="MAT 26:64" />Yesʉ mwamʉshʉbɨtsya athɨ: «Nɨ ɨwe wo wamanegena. H'ingye enyɨbabwɨra nyɨthɨ, ɨthoka ko ndambi eno mwalola ko <char style="w">Mʉgala w'oMʉndʉ</char> n'ikere ko malyo wa Gongo w'amaka, nɨathoka mo bɨfʉ by'oko buthuku.» <verse eid="MAT 26:64" /><verse number="65" style="v" sid="MAT 26:65" />Aho <char style="w" lemma="Muheri">oMuheri Mʉkʉlʉ</char> mwaberenga so ngɨmba sɨwe n'ɨnegena athɨ: «Amahatsya! Thuthakilayire ku mutimo! Mwamonvwa obʉhatsye bʉwe. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Mwamanegena muthi ki?» Mobashubya bathɨ: «Atholere lʉholo.»<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Aho, mobamʉtsɨrako mathandɨ mo bʉsʉ n'imuhumba mʉ bikundi. N'abandɨ mobamuhiramo makofi, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />nɨabanegena bathɨ: «Mɨnyerera, ɨwe Masia, thʉbwɨre nga nɨ ndɨ yo wamakuhumba!»<verse eid="MAT 26:68" /></para>
  <para style="s">Petero ayɨgana Yesʉ</para>
  <para style="r">(<ref loc="MRK 14:66-72">Mar 14:66-72</ref>; <ref loc="LUK 22:56-62">Luk 22:56-62</ref>; <ref loc="JHN 18:15-18">Yoa 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Mo ndambi eyo, Petero abyaga n'ikere embʉga mo kɨbʉga. Mukoli mʉgʉma wa bʉkatsɨ mwayɨfʉnda hofɨ naye n'ɨmʉbwɨra athɨ: «Nawe kuthyo, ʉthalɨ hagʉma na Yesʉ, Munyangalilaya.» <verse eid="MAT 26:69" /><verse number="70" style="v" sid="MAT 26:70" />He mwayɨgana embere y'abandʉ boshi n'ɨnegena athɨ: «Nyithetsi ebyo ushondya ɨnegena.» <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />Aho Petero mwaya emʉnda w'olukyo lw'ekɨbʉga. Ʉndɨ mukoli wa bʉkatsɨ mwamʉshʉnga n'ɨbwɨra abo babyagaho athɨ: «Oyu athalɨ hagʉma na Yesʉ w'iNasareti.» <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />Na Petero mwashʉbayɨgana, mwalahɨtsya nɨanegena athɨ: «Ko kwenene, nyithetsi omuyira oyu.» <verse eid="MAT 26:72" /><verse number="73" style="v" sid="MAT 26:73" />Kwabere kwatsʉka kathambi, bo babyaga aho mobayɨfʉnda ahali Petero n'ɨmʉbwɨra bathɨ: «Kundu-kundu, ɨwe nawe ʉlɨ mʉgʉma wa kʉbo, emɨnegenere awe yamakukangania.» <verse eid="MAT 26:73" /><verse number="74" style="v" sid="MAT 26:74" />Aho Petero mwathanga ɨlahɨtsya athɨ: «Nyɨthakɨrwe nyamabya nɨenyɨnegena mabesɨ! Nyithetsi omʉndʉ oyu!» Aho n'aho, embagatsɨ moyabɨka.<verse eid="MAT 26:74" /></para>
  <para style="p">
    <verse number="75" style="v" sid="MAT 26:75" />Na Petero mwɨbʉka ebɨnwa Yesʉ amʉbwɨraga athɨ: «Embere embagatsɨ y'ɨbɨke, wayɨana ingye ngendo kashathʉ ʉthɨ uthanyetsi.»<note caller="+" style="f"><char style="fr" closed="false">26:75 </char><char style="ft" closed="false">Soma 26:34.</char></note> Mwahʉlʉka na mwalɨra na buliye bʉnene.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">Yesʉ athwalwa embere sa Pilato</para>
  <para style="r">(<ref loc="MRK 15:1">Mar 15:1</ref>; <ref loc="LUK 23:1-2">Luk 23:1-2</ref>; <ref loc="JHN 18:28-32">Yoa 18:28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Bwabere bwakya, <char style="w" lemma="baheri">abaheri bakʉlʉ</char> boshi n'abangʉmwa b'aBayuta mobaya nama y'ɨsohera Yesʉ yo lʉholo. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Mobamʉmɨna, mobamʉthwala n'ɨyamʉha kafʉrʉnalɨ <char style="w">Pilato</char>.<verse eid="MAT 27:2" /></para>
  <para style="s">Lʉholo lwa Yuta</para>
  <para style="r">(<ref loc="ACT 1:18-19">Mɨko 1:18-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Aho, Yuta yo wahotheraga Yesʉ abere ashʉnga kw'amasohwa, mwayɨshʉbako na mwafʉlʉkɨtsya <char style="w" lemma="baheri">abaheri bakʉlʉ</char> n'abangʉmwa b'aBayuta bw'ebɨtsere makumi ashathʉ by'esofaranga ebyo. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />Mwabwɨrabo athɨ: «Monyɨkola kɨtsɨbʉ mw'ɨhana yo uthakolire ki, ithwe!» Hewethuwe mobamʉshʉbɨtsya bathɨ: «Ebyo bithakithulolire! Ebyo nɨ bɨnwa byawe!» <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" />Yuta mwagʉsha esofaranga etho mo <char style="w" lemma="Nyʉmba ya Gongo:">Nyʉmba ya Gongo</char> n'ɨgenda. Mwayayɨhanɨka.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />
    <char style="w" lemma="baheri bakʉlʉ">Abaheri bakʉlʉ</char> mobathola esofaranga etho n'ɨnegena bathɨ: «oMʉgomba ethʉ athahamulire ihira esofaranga esi mo mbɨko y'eNyʉmba ya Gongo, kʉshangwa sɨthathoka mw'ɨshesha mʉsasɨ.»<verse eid="MAT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 27:7" />Babere bamala enama, mobagʉla mo sofaranga etho mw'ɨshwa lya mubumbi mʉgʉma bʉshana libye masɨnda wa bageni. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Kyokɨreka erɨshwa eryo nɨlyahʉlwamo «Ɨshwa lya mʉsasɨ ihika munobwire.» <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Aho ebɨnwa byanegenawa n'o<char style="w" lemma="Mulaguli wa Gongo">mʉmɨnyeretsɨ</char> Yeremia mobyabererera. Ebɨnwa byo binegenire bɨthɨ: «Mobathola ebɨtsere makumi ashathʉ by'esofaranga ɨkwamana n'ekɨtsɨro <char style="w" lemma="Isiraeli">aBaisiraeli</char> bahʉlɨkɨrɨranaga bʉshana n'obʉyɨngo bʉwe. <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />Mobagʉla mʉtho mw'erɨshwa ly'omubumbi, nga ko Nyinya-kowethʉ anyɨhamʉlaga.»<note caller="+" style="f"><char style="fr" closed="false">27:10 </char><char style="ft" closed="false">Ebyanegenawa bɨrɨngene na Sakarɨa 11:12-13. n'ebɨnwa byayɨbwekawa mʉ Yeremia 18:2-3; 19:1-3; 32:6-15.</char></note><verse eid="MAT 27:10" /></para>
  <para style="s">Pilato athondesa Yesʉ</para>
  <para style="r">(<ref loc="MRK 15:2-5">Mar 15:2-5</ref>; <ref loc="LUK 23:3-5">Luk 23:3-5</ref>; <ref loc="JHN 18:33-38">Yoa 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Yesʉ mwathonda embere ya kafʉrʉnalɨ Pilato. Kafʉrʉnalɨ mwamʉbʉtsya athɨ: «Nɨ ɨwe mwamɨ <char style="w" lemma="Bayuta">w'aBayuta</char>?» Yesʉ mwashubya athɨ: «Nɨ ɨwe wo wamanegena.» <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />Honyuma kw'aho, <char style="w" lemma="Muheri">abaheri bakʉlʉ</char> n'abangʉmwa b'aBayuta babere bamusitaka, mwathashubya kɨndʉ. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Aho, <char style="w">Pilato</char> mwamʉbwɨra athɨ: «Uthonvwire ebyoshi abakusitakira?» <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Hewethuwe Yesʉ mwathashubya kʉ kɨnwa n'ekɨgʉma, ihika ko kɨka kafʉrʉnalɨ mwashweka kʉtsɨbʉ.<verse eid="MAT 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Ko bʉlɨ linye lya Pasaka, kafʉrʉnalɨ agenda amɨnʉla mʉndʉ mʉgʉma wa muliki, oyo omuhindano agenda ashaba. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Na mo bɨro ebyo kwabyaga mʉndʉ mʉgʉma wa muliki nietsibwe kʉtsɨbʉ, erɨtsɨna lɨwe nɨ yo Yesʉ Baraba<note caller="+" style="f"><char style="fr" closed="false">27:16 </char><char style="fq" closed="false">Yesʉ Baraba </char><char style="ft" closed="false">Mashako magʉma athalɨmo erɨtsɨna lya Yesʉ embere y'erɨtsɨna lya Baraba.</char></note> <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" /><char style="w">Pilato</char> mwabʉtsya omuhindano athɨ: «Omushondya nyɨbamɨnʉlɨre ndɨ, Yesʉ Baraba kʉtse Yesʉ yo ʉnahʉlwamo <char style="w" lemma="Kirisito, Masia">Kirisito</char>?» <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Pilato abʉtsyaga athyo kʉshangwa abyaga nietsi ko bahiraga Yesʉ mo minwe yɨwe mʉ mwisho.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Pilato abere anemʉsoha olʉbanza, mʉkatsɨwe mwamʉthʉmɨra mwatsɨ athɨ: «Uthayihiraga mo bɨnwa by'omʉndʉ mʉthʉnganene oyo. Kʉshangwa, mo kɨro kya munobwire, monyagalwa kʉtsɨbʉ mo bɨlotho bʉshana naye.»<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />
    <char style="w" lemma="baheri bakʉlʉ">Abaheri bakʉlʉ</char> n'abangʉmwa b'aBayuta mobakaramya abandʉ bashabe Baraba amɨnʉlwe na Yesʉ ithwe. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Kafʉrʉnalɨ Pilato mwashʉba bʉtsyabo athɨ: «Ɨndɨ ko babɨrɨ yo mushondya nyɨbamɨnʉlɨre?» Mobamʉshʉbɨtsya bathɨ: «Baraba!» <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" /><char style="w">Pilato</char> mwashʉba bʉtsyabo athɨ: «Nyɨyɨre nyɨthɨ na Yesʉ oyu yo ʉnahʉlwamo <char style="w" lemma="Kirisito, Masia">Kirisito</char>?» Aboshi mobashubya bathɨ: «Abambwe kʉ mʉsalaba!» <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />Pilato mwabʉtsya athɨ: «Kɨbɨ kɨhe kyo akolire?» Hewethuwe mobahambala n'amagala wabo woshi bathɨ: «Abambwe kʉ mʉsalaba!»<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />
    <char style="w">Pilato</char> abere ashʉnga ko amalemwabo, n'obʉrʉnga bʉhera obwongereka, mwatsɨmba metsi, mwanaba ko minwe yɨwe embere y'abandʉ boshi n'ɨnegena athɨ: «Omʉsasɨ w'omʉndʉ oyu athabyaga ko muthwe aye! Ebyo bibalebitsye!» <verse eid="MAT 27:24" /><verse number="25" style="v" sid="MAT 27:25" />Omuhindano woshi mwashubya athɨ: «Omʉsasɨ ʉwe athubyeko na abye na ko bana bethʉ!» <verse eid="MAT 27:25" /><verse number="26" style="v" sid="MAT 27:26" />Aho, Pilato mwamɨnʉlɨrabo Baraba, na mwahamʉla Yesʉ ahumbwe mbasha na mwamʉhana bʉshana abambwe kʉ mʉsalaba.<verse eid="MAT 27:26" /></para>
  <para style="s">Abashirikani abashekeretsya Yesʉ</para>
  <para style="r">(<ref loc="MRK 15:16-20">Mar 15:16-20</ref>; <ref loc="JHN 19:2-3">Yoa 19:2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Abashirikani ba Kafʉrʉnalɨ Pilato mobathwala Yesʉ yo mo rʉba lwa Kafʉrʉnalɨ n'abashirikani boshi mobamuthimbako. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Mobamwambʉlako esongɨmba sɨwe n'imwambikya koti ya ngʉla<note caller="+" style="f"><char style="fr" closed="false">27:28 </char><char style="fq" closed="false">koti ya ngʉla </char><char style="ft" closed="false">Yabyaga koti y'abashirikani b'aBaroma.</char></note>. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Honyuma kw'aho, mobalʉka mbitha mʉ mɨthahɨ ɨrɨko mɨshakɨ, mobahiraro ko muthwe ʉwe n'ihira lʉsheke mo minwe yɨwe y'amalyo. Mobafʉkama embere sɨwe nɨabamʉshekeretsya bathɨ: «Othʉkʉketsya mbe mwamɨ <char style="w" lemma="Bayuta">w'aBayuta</char>!» <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Bagenda abamʉtsɨrako mathandɨ na mobatsɨmba olʉsheke n'imuhumangalo ko muthwe. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Babere bamala ɨmʉshekeretsya, mobamwambʉlako ekoti, n'ɨshʉba mwambikya esongɨmba sɨwe n'ɨmʉthwala bʉshana bamʉbambe kʉ mʉsalaba.<verse eid="MAT 27:31" /></para>
  <para style="s">Yesʉ abambwa kʉ mʉsalaba</para>
  <para style="r">(<ref loc="MRK 15:21-32">Mar 15:21-32</ref>; <ref loc="LUK 23:26-43">Luk 23:26-43</ref>; <ref loc="JHN 19:17-27">Yoa 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Babere bahʉlʉka, mobahindana na muyira mʉgʉma w'iKurene erɨtsɨna lɨwe nɨ yo Simoni, abashirikani mobamuhekya <char style="w" lemma="Mʉsalaba">omʉsalaba</char> wa Yesʉ mo kahatho.<verse eid="MAT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 27:33" />Mobahika handʉ hagʉma ho ahanahʉlwamo Ngolingota, n'ɨnegena mbʉ «Handʉ ha kahangali». <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Aho, mobaha Yesʉ yo tifayi ɨrɨmo bɨndʉ bikalihire kʉtsɨbʉ. Abere amala ɨgetsyaro, mwathashʉbashoma kʉro.<verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />Babere bamala ɨmʉbamba ko mʉsalaba, mobagabana esongɨmba sɨwe mo bwɨkɨ.<note caller="+" style="f"><char style="fr" closed="false">27:35 </char><char style="ft" closed="false">Soma Saburi 22:19.</char></note> <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Honyuma kw'aho, mobɨkala aho bʉshana n'imutheya. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Ho lʉgʉlʉ w'omuthwe ʉwe, mobahiraho kɨshayɨ kishakireko ekyo kyalekaga nɨasohwa. Kyabyaga ni kishakirweko kɨthɨ: «Ono nɨ Yesʉ, mwamɨ <char style="w" lemma="Bayuta">w'aBayuta</char>.» <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Bashamuli babɨrɨ mobabambwa ko mɨsalaba emʉsɨke wa Yesʉ. Mʉgʉma ko malyo ʉwe, n'ogʉndɨ ko malembe ʉwe.<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />Abagendi-nzɨra bagenda abamuhangya niabathengania emithwe, <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />bagenda abanegena bathɨ: «Ɨwe washondyaga ihimbula <char style="w" lemma="Nyʉmba ya Gongo">eNyʉmba ya Gongo</char> n'ɨshʉba himbaro mʉ bɨro bɨshathʉ, ewo yɨshabʉle wowene. Wamabya ʉlɨ Mʉgala wa Gongo uyikimye ko <char style="w">mʉsalaba</char>!»<note caller="+" style="f"><char style="fr" closed="false">27:40 </char><char style="ft" closed="false">Soma na ulinganie na 26:61; Yoa 2:19.</char></note><verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Na kuthyo, <char style="w" lemma="Muheri">abakʉlʉ b'abaheri</char>, <char style="w" lemma="Bakangɨrɨtsya b'oMʉgomba">abakangɨrɨtsya b'oMʉgomba</char> n'abangʉmwa b'aBayuta bagenda abamʉshekeretsya nɨabanegena bathɨ: <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />«Mwashabʉla bandɨ, he athangayɨshabʉla yowene! Ɨye yo Mwamɨ <char style="w" lemma="Isiraeli">w'iIsiraeli</char><note caller="+" style="f"><char style="fr" closed="false">27:42 </char><char style="ft" closed="false">Soma Yoa 1:49; 12:13.</char></note> akime lɨno ko <char style="w">mʉsalaba</char> nethwe thwamwɨkɨrɨtsya. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Mwahira amagene ʉwe kʉ Gongo na mwanegena athɨ: “Nyɨrɨ Mʉgala wa Gongo.”<note caller="+" style="f"><char style="fr" closed="false">27:43 </char><char style="ft" closed="false">Soma Yoani 15:18.</char></note> Aho Gongo amabya amutsiire, amʉshabʉle ko ndambi eno!» <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />N'abashamuli babambawa ko mɨsalaba emʉsɨke kw'ɨye, nabo kuthyo bagenda abamuhangya.<verse eid="MAT 27:44" /></para>
  <para style="s">Olʉholo lwa Yesʉ</para>
  <para style="r">(<ref loc="MRK 15:33-41">Mar 15:33-41</ref>; <ref loc="LUK 23:44-49">Luk 23:44-49</ref>; <ref loc="JHN 19:28-30">Yoa 19:28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Ɨthoka mo kathi ka mwɨshɨ, omwitsimya<note caller="+" style="f"><char style="fr" closed="false">27:45 </char><char style="ft" closed="false">Soma Ɨthoka 10:22.</char></note> mwabya ko kɨhʉgo kyoshi ihika kʉ saha mwenda. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Hofɨ na saha mwenda, Yesʉ mwahambala kʉtsɨbʉ athɨ: «Eli, Eli, lama sabakitani?» n'ɨnegena mbʉ: «Gongo waye, Gongo waye, bʉshana na ki wamanyishiga?» <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />Bagʉma mo bo babyaga bimene aho mobamwonvwa na mobahambala bathɨ: «Abɨrɨkɨra Elia!» <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Aho n'aho mʉgʉma wa kʉbo mwathɨbɨthɨra kakɨmba, mwathobetsyako mu tifayi ɨtsʉkɨrene mwamɨnɨrako kʉ lʉsheke. Mwɨrʉkɨtsyako Yesʉ athɨ ashomero.<note caller="+" style="f"><char style="fr" closed="false">27:48 </char><char style="ft" closed="false">Soma Saburi 69:22.</char></note> <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Hewethuwe abandɨ mobanegena bathɨ: «Mulike, thʉlole nga Elia itsa mʉshabʉla!» <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />Hewethuwe Yesʉ mwashʉba hambala ʉndɨ mʉlenge mʉnene na mwatsa omʉthɨma.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Mo kathambi ako, epasɨya yabyaga mo <char style="w" lemma="Nyʉmba ya Gongo:">Nyʉmba ya Gongo</char> moyabereka ɨthoka elʉgʉlʉ ihika ko kɨthaka. Akalingiti mokatsʉka, sonyɨkʉka mosabereka. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Amasɨnda mwayɨkɨngʉla n'emɨbɨrɨ ya babuyirire bangɨ bo babyaga baholire moyalubuka. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Mobathoka mo masɨnda n'enyuma y'erilubuka lya Yesʉ, mobɨngɨra ɨYerʉsalemʉ, omuyi <char style="w">mubuyirire</char>, mo bandʉ bangɨ bashʉngɨragabo.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Omʉkʉlʉ w'abashirikani, n'abashirikani bobagenda abatheya Yesʉ hagʉma naye, mobashʉnga akalingiti n'ebyoshi byatsʉkaga, aho mobafwa bʉba bʉngɨ n'ɨnegena bathɨ: «Kwenene omʉndʉ oyu athalɨ Mʉgala wa Gongo!»<note caller="+" style="f"><char style="fr" closed="false">27:54 </char><char style="ft" closed="false">Soma Matayo 14:33. </char></note><verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Aho habyaga bakatsɨ bangɨ bo bagenda abayɨthegeretsya nɨ balɨ hale, nɨ abo bakwamaga Yesʉ ɨthoka iNgalilaya<note caller="+" style="f"><char style="fr" closed="false">27:55 </char><char style="fq" closed="false">ɨthoka iNgalilaya </char><char style="ft" closed="false">: linegenire mbʉ ɨthoka ekɨro Yesʉ athangɨraga ɨkola.</char></note> bʉshana bamʉkolere. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Mo kathi kabo, mwabyaga Marɨa w'oko muyi w'ɨMangɨndala na Marɨa nyinya wa Yakobo na Yosefʉ, na nyinya w'abagala ba Sebetayo.<verse eid="MAT 27:56" /></para>
  <para style="s">Ɨthabwa lya Yesʉ</para>
  <para style="r">(<ref loc="MRK 15:42-47">Mar 15:42-47</ref>; <ref loc="LUK 23:50-56">Luk 23:50-56</ref>; <ref loc="JHN 19:38-42">Yoa 19:38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Bwabere bwagoroba, muyira mʉgʉma mushoki yo wahʉlawamo Yosefʉ w'iArimatea<note caller="+" style="f"><char style="fr" closed="false">27:57 </char><char style="fq" closed="false">Arimatea </char><char style="ft" closed="false">: muyi alɨ hale nga 35 km elʉgʉlʉ ebʉlengera ɨtsʉba n'ɨYerʉsalemʉ.</char></note> mwahika naye niamalire ibya mwɨga wa Yesʉ. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Omuyira oyo mwayashʉnga <char style="w">Pilato</char> n'ɨmʉshaba omʉbɨrɨ wa Yesʉ. Aho <char style="w">Pilato</char> mwahamʉla bamʉhewo. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Yosefʉ mwatsɨmba omʉbɨrɨ oyo, mwabʉnga-bʉngɨrawo mʉ lʉkɨmba lwerire, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />na mwabɨrɨkɨrɨtsyawo mw'ɨsɨnda lyo abyaga niamayithimira mʉ lʉkʉka. Honyuma kw'aho mwakʉmbagalɨtsya ibwe<note caller="+" style="f"><char style="fr" closed="false">27:60 </char><char style="ft" closed="false">Soma Marɨko 16:3-4.</char></note> inene ho lukyo lw'erɨsɨnda n'ɨyɨgendera. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Marɨa w'ɨMangɨndala n'ogʉndɨ Marɨa babyaga aho, nibikere ko ʉndɨ mʉnda w'erɨsɨnda.<verse eid="MAT 27:61" /></para>
  <para style="s">Abashirikani abatheya erɨsɨnda</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Bwabere bwakya, n'ɨnegena mbʉ ekɨro kyabyaga kikwamire emɨlalɨtsye y'eSabato<note caller="+" style="f"><char style="fr" closed="false">27:62 </char><char style="ft" closed="false">Ekɨro </char><char style="fq" closed="false">emɨlalɨtsye y'eSabato </char><char style="ft" closed="false">kyabyaga kɨro kya kathano, ekɨro aBayuta bagenda abakola ebihamulirwe mo kɨro kya mungya, ekɨro ky'esabato.</char></note>, <char style="w" lemma="Muheri">abaheri bakʉlʉ</char> <char style="w" lemma="Bafarisayo:">n'aBafarisayo</char> mobaya kʉgʉma ewa <char style="w">Pilato</char>, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />na mobanegena bathɨ: «Nyinya-kowethʉ, thwamɨbʉka k'omʉbesɨ oyu, abere akɨnalɨho, mwanegena athɨ: “Honyuma wa bɨro bɨshathʉ, nyandalubuka<note caller="+" style="f"><char style="fr" closed="false">27:63 </char><char style="ft" closed="false">Soma 16:21; 17:23; 20:19.</char></note>.” <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Aho, hamʉla erɨsɨnda litheyibwe ihika ko kɨro kya kashathʉ. Bɨthalɨ bithyo <char style="w">abɨga</char> bʉwe bangahika iba omʉbɨrɨ na bangabwɨra abandʉ bathɨ: “Alubukire mo baholi.” Amabesɨ manyuma angabya mabɨ kʉlenga amambere.» <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" /><char style="w">Pilato</char> mwabwɨrabo athɨ: «Abashirikani batheya baba. Mʉgende muyatheye erɨsɨnda nga k'omushondya.» <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Mobagenda, mobahira kɨmɨnyɨkalo kw'ibwe lyo lyabyaga likingire erɨsɨnda na mobahiraho bashirikani batheya.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Erilubuka lya Yesʉ</para>
  <para style="r">(<ref loc="MRK 16:1-10">Mar 16:1-10</ref>; <ref loc="LUK 24:1-12">Luk 24:1-12</ref>; <ref loc="JHN 20:1-10">Yoa 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />
    <char style="w" lemma="Sabato">eSabato</char> yabere yahwa, mo mʉhʉgʉtho w'ekɨro kɨmbere ky'eyenga, Marɨa w'ɨMangɨndala n'ogʉndɨ Marɨa<note caller="+" style="f"><char style="fr" closed="false">28:1 </char><char style="ft" closed="false">Soma 27.56.</char></note> mobayalola kw'ɨsɨnda. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Aho n'aho, mokwabya kalingiti katsɨbʉ, <char style="w" lemma="malaɨka">malaɨka</char> wa Nyinya-kowethʉ mwakima ɨthoka mo lʉbʉla, mwahika ɨkʉmbagatsya eribwe eryo n'ikala kʉlyo. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Abyaga niashoshire nga mulabyo n'esongɨmba sɨwe sabyaga nisisanire nga nzʉrʉrʉ. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Abatheya b'erɨsɨnda mobʉbaha kʉtsɨbʉ ihika ko kɨka mobathithimana na mobabya nga bafwire. <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />Malaɨka oyo mwabwɨra abakatsɨ abo athɨ: «Mʉthʉbahaga! Nyetsi kw'omushondya Yesʉ, yo wabambawa ko mʉsalaba. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Athalɨ hano, kʉshangwa alubukire nga kw'anegenaga. Mwitse mʉlole ahabyaga alambikire. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Aho, mʉgende tsʉba mʉyabwɨre <char style="w">abɨga</char> bʉwe mʉthɨ: “Alubukire ɨthoka mo baholi, amalire ɨbathanga iNgalilaya<note caller="+" style="f"><char style="fr" closed="false">28:7 </char><char style="ft" closed="false">Soma 26.32.</char></note>, eyo yo mwamʉshʉngako.” Ebyo byo nyithashondya ɨbabwɨra.»<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Mobathoka kw'ɨsɨnda ko tsʉba n'obʉba na ngoga nene, mobathɨbɨtha nɨyafʉlɨra <char style="w">abɨga</char> bʉwe bw'omwatsɨ. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Aho n'aho, Yesʉ mwayahindana n'abakatsɨ abo n'ɨbwɨrabo athɨ: «Mwabukirehe!» Mobayɨfʉnda hofɨ naye na mobatsɨmba ko bɨshando bɨwe n'imuramya. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Aho Yesʉ mwabwɨrabo athɨ: «Mʉthʉbahaga. Mʉgende mʉyabwɨre bagala bethʉ ko batholere ɨya iNgalilaya, eyo yo banyɨshʉngako.»<verse eid="MAT 28:10" /></para>
  <para style="s">Abatheya b'erɨsɨnda lya Yesʉ abanegena mabesɨ</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Abakatsɨ abo babere bakɨnalɨ mo nzɨra, bagʉma ba mo batheya b'erɨsɨnda mobaya mo muyi bʉshana n'ɨyafʉlɨra <char style="w" lemma="baheri bakʉlʉ">abaheri bakʉlʉ</char> bw'ebyoshi bɨthatsʉka. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" /><char style="w" lemma="Abaheri bakʉlʉ">Abaheri bakʉlʉ</char> mobahindana hagʉma n'abangʉmwa b'aBayuta, na mobahʉlɨkɨrɨrana n'ɨha abashirikani bo faranga nyɨngɨ, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />n'ɨbwɨrabo bathɨ: «Mwanegena mʉthɨ: “<char style="w" lemma="abɨga">Abɨga</char> bʉwe mobahika mo kɨro n'imwiba, mo ndambi thuthabya nɨthwamayatho.”<note caller="+" style="f"><char style="fr" closed="false">28:13 </char><char style="ft" closed="false">Soma 27.64.</char></note> <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />N'omwatsɨ amahika kʉ kafʉrʉnalɨ, n'ithwe thwothwamolohya, bʉshana ebɨnwa ebyo bithabaletheraga bʉrʉnga.» <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Abatheya abo mobathola esofaranga etho na mobakola ɨkwamana na ko bathahamʉlwa. N'omwatsɨ oyo mwaya-ngʉlʉ ko <char style="w" lemma="Bayuta">Bayuta</char> boshi, ihika ko kɨro kya munobwire.<verse eid="MAT 28:15" /></para>
  <para style="s">Yesʉ athʉma abɨga bʉwe mo mʉlɨmo</para>
  <para style="r">(<ref loc="MRK 16:14-18">Mar 16:14-18</ref>; <ref loc="LUK 24:36-49">Luk 24:36-49</ref>; <ref loc="JHN 20:19-23">Yoa 20:19-23</ref>; <ref loc="ACT 1:6-8">Mɨko 1:6-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />
    <char style="w">Abɨga</char> ikumi n'omʉgʉma mobaya iNgalilaya, ko kɨthwa Yesʉ akangayabo.<note caller="+" style="f"><char style="fr" closed="false">28:16 </char><char style="ft" closed="false">Soma 26.32.</char></note> <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Babere bamʉshʉngako mobamuramya, hewethuwe bagʉma mʉbo mobathɨka-thɨka. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Yesʉ mwayɨfʉnda hofɨ nabo n'ɨbwɨrabo athɨ: «Nyamahabwa amaka woshi mo lʉbʉla n'oko kɨthaka. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Mʉgende ko bɨhanda byoshi mʉyɨre abandʉ mo <char style="w" lemma="Abɨga">bɨga</char><note caller="+" style="f"><char style="fr" closed="false">28:19 </char><char style="ft" closed="false">Soma Mɨkolano 1.8.</char></note>, mubatisyebo kw'ɨtsɨna lya Thatha, na lya Mʉgala na ely'<char style="w">oMʉthɨma Mwerʉ</char>. <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />Na mʉkangɨrɨtsyebo ishikya ebyoshi nyabahamʉlaga. Nangye nyɨrɨ hagʉma nemwe ebɨro byoshi ihika ko nduli y'ekɨhʉgo.»<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>