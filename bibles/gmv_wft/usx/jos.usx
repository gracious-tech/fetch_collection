<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOS" style="id">- Gamo Full Bible final version</book>
  <para style="h">Iyaaso Maxaafa</para>
  <para style="toc1">Iyaaso Maxaafa</para>
  <para style="toc2">Iyaaso Maxaafa</para>
  <para style="toc3">Iya</para>
  <para style="mt1">Iyaaso Maxaafa</para>
  <para style="imt1">Giddo Qofa</para>
  <para style="ip">Iyaaso maxaafay Isra7eele asay Muse sohon gidi doorettida Iyaasoy kaaleththiin Kanaane izi wostti oli oykkidaakko yootiza taarike. Ha maxaafazan xaafettida gita taariketa giddofe waannati, Yordaanoose shaafa pineth, Iyarkko gimbeza laaleteth, Aye geetettiza kataman dendida olanne derezi Xoossara caaqettida caaqoza ooraxiso gishshas yooteettes. Maxaafaza garsan keehi erettidaytappe issoy, «Intte goynnana koyidayssa hach doorite; taninne taso asay gidikko Xoossas goynnana» gizayta (24:15).</para>
  <para style="iot">Ha Maxaafay Oykkida Kumeththa Qofa</para>
  <para style="io1">Kanaane xooneteth <char style="ior"><ref loc="JOS 1:1-12:24">1:1—12:24</ref> </char></para>
  <para style="io1">Gade gisheteth <char style="ior"><ref loc="JOS 13:1-21:45">13:1—21:45</ref> </char></para>
  <para style="io2">Yordaanooseppe he pinththan arshey mokkizaso baggara diza gade <char style="ior"><ref loc="JOS 13:1-33">13:1-33</ref> </char></para>
  <para style="io2">Yordaanooseppe he pinththan arshey wulliza baggara diza gade <char style="ior"><ref loc="JOS 14:1-19:51">14:1—19:51</ref> </char></para>
  <para style="io2">Isttan baqati attiza katamata <char style="ior"><ref loc="JOS 20:1-9">20:1-9</ref> </char></para>
  <para style="io2">Lewetas imettida katamata <char style="ior"><ref loc="JOS 21:1-45">21:1-45</ref> </char></para>
  <para style="io1">Arshey mokkiza baggafe yida qommoti ba dere simo <char style="ior"><ref loc="JOS 22:1-34">22:1-34</ref> </char></para>
  <para style="io1">Iyaasoy wurseththan gida qaala <char style="ior"><ref loc="JOS 23:1-16">23:1-16</ref> </char></para>
  <para style="io1">Seekeemen caaqo qaalaa ooraxiso <char style="ior"><ref loc="JOS 24:1-33">24:1-33</ref> </char></para>
  <chapter number="1" style="c" sid="JOS 1" />
  <para style="s1">Goday Iyaaso Azazida Azazo</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 1:1" />GODAA aylle Musey hayqqidaappe guye GODAY Muse maaddiza Nawe naa Iyaasos, <verse eid="JOS 1:1" /><verse number="2" style="v" sid="JOS 1:2" />«Hekko ta aylle Musey hayqqides; ha7i neninne hayssi derezi dendite; tani kase Isra7eele asaas immana gida biittaa gelanaas Yordaanoose shaafa pinnite. <verse eid="JOS 1:2" /><verse number="3" style="v" sid="JOS 1:3" />Tani kase Muses immida hidota mala intte tohoy yedhdhiza biitta ubbaa ta inttes immana. <verse eid="JOS 1:3" /><verse number="4" style="v" sid="JOS 1:4" />Intte biittaa zaway bazzofe doommidi Libaanoose, wogga shaafa Efiraaxiseppe biidi Hiite dere ubbaa oykkidi arshey wulliza baggara biidi wogga abbaa gakkanaassa. <verse eid="JOS 1:4" /><verse number="5" style="v" sid="JOS 1:5" />Neni diza wode ubbaan nenara oonikka eqettana dandayenna; tani kase Musera gidida mala nenarakka gidana; mulekka ta nena yeggikenne aggike.<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="DEU 31:6">Zaare 31:6</ref>,<ref loc="DEU 31:8">8</ref>; <ref loc="HEB 13:5">Ib 13:5</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">1:3-5 </char><char style="xt" closed="false"><ref loc="DEU 11:24-25">Zaare 11:24-25</ref></char></note><verse eid="JOS 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 1:6" />«Minna! Xala gida; tani kase istta aawatas immana gaada caaqqida biittaa ha dereza kaaleththada laatisanay nena gidida gishshas minna.<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="DEU 31:6">Zaare 31:6</ref>,<ref loc="DEU 31:7">7</ref>,<ref loc="DEU 31:23">23</ref></char></note> <verse eid="JOS 1:6" /><verse number="7" style="v" sid="JOS 1:7" />Aykkoy baa; neni mino xalla minna; ta aylle Musey nees immida wogaza ubbaa lo7eththa azazetta; ne bidaso ubbaan giiga gidana mala hadirs ushach gooppa. <verse eid="JOS 1:7" /><verse number="8" style="v" sid="JOS 1:8" />Hayssi woga Maxaafay ne doonappe shaakettofo; iza giddon dizayssa ne lo7eththa naagettada polana mala gallas gidiin omars zaara zaara qoppa; ne hessaththo ooththiko ne qoppida ubbay nees suurananne hanana. <verse eid="JOS 1:8" /><verse number="9" style="v" sid="JOS 1:9" />Neni bizason ubbaan GODAA ne Xoossay nenara diza gishshas aykkoy baa, minna, yayyofa, dagammofa gaada ta nena azazabeekkinaa!» gides.<verse eid="JOS 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 1:10" />Hessafe kaallidi Iyaasoy Isra7eele asaa, <verse eid="JOS 1:10" /><verse number="11" style="v" sid="JOS 1:11" />«Intte gede asay dizaso biidi, ‹Intte heedzdzu gallassafe guye kase GODAA intte Xoossay inttena laatissanaas inttes immiza biittayo laattanaas Yordaanoose pinnana gishshas inttes shinqe giigsite› gi yootite» gi azazides.<verse eid="JOS 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 1:12" />Iyaasoy Oroobeele qommotas, Gaade qommotas, hessaththoka Minaase qommotappe baggaytas, <verse eid="JOS 1:12" /><verse number="13" style="v" sid="JOS 1:13" />«GODAA aylle Musey, ‹GODAA intte Xoossay inttena shempisana; hanno biittayokka izi inttes immana› gi immida azazoza akeekite. <verse eid="JOS 1:13" /><verse number="14" style="v" sid="JOS 1:14" />Intte machcheti, intte naytinne intte mehetikka kase Musey inttes Yordaanoose shaafappe he pinththan immidason heen diishetto; gido attiin intte ola asay ubbay kumeth ola miishshara intte baggata Isra7eele asaa maaddanaas kasetidi Yordaanoose pinnetto; intteka intte ishatara issife olaas kezite. <verse eid="JOS 1:14" /><verse number="15" style="v" sid="JOS 1:15" />Hessika GODAY istta shempisana gakkanaassinne inttes izi ooththoyssaththo isttika GODAA intte Xoossay isttas immida biittaa gakki laattana gakkanaassa; hessafe guye intte simmi yiidi arshey mokkiza baggara Yordaanoose shaafappe he pinththan GODAA aylle Musey inttes immida biittaa intte laattana» gides.<note caller="-" style="x"><char style="xo" closed="false">1:12-15 </char><char style="xt" closed="false"><ref loc="NUM 32:28-32">Tay 32:28-32</ref>; <ref loc="DEU 3:18">Zaare 3:18</ref>; <ref loc="JOS 22:1-6">Iya 22:1-6</ref></char></note><verse eid="JOS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 1:16" />Isttika Iyaasos, «Neni nuus yootoyssa nuni ubbaa polana; ne kiittizaso awakka baana. <verse eid="JOS 1:16" /><verse number="17" style="v" sid="JOS 1:17" />Nuni Muses ubba wode azazettida mala neeskka azazettana; GODAA ne Xoossay kase Musera gidida mala nenarakka izi gido! <verse eid="JOS 1:17" /><verse number="18" style="v" sid="JOS 1:18" />Nenara eqettizaadeynne nees azazettonttaade ubbay hayqqo; ne minna; aykkoy baa, ne mino minna» gida.<verse eid="JOS 1:18" /></para>
  <chapter eid="JOS 1" />
  <chapter number="2" style="c" sid="JOS 2" />
  <para style="s1">Iyaasoy Kiittida Wochche Asata</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 2:1" />Nawe naa Iyaasoy biittaa wochchiza nam7u asata Shiixime geetettizasoppe qotan kiittides; kiittishe isttas, «Biite; biidi biitta wochchite; harappeka Iyarkko katamaa dummasi wochchite» gides.</para>
  <para style="p" vid="JOS 2:1">Histtiin istti biidi Era7aabo geetettiza layma maccassay soo gelidi aqida.<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="HEB 11:31">Ib 11:31</ref>; <ref loc="JAS 2:25">Yaaqo 2:25</ref></char></note> <verse eid="JOS 2:1" /><verse number="2" style="v" sid="JOS 2:2" />Histtiin Iyarkko kawoy, «Isra7eele asaappe kiitettidayti ha biitta wochchanaas omars yida» giza yo7o siyides.<verse eid="JOS 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 2:3" />Iyarkko kawoy Era7aabikko, «Ne soo yi gelida asata kessa imma. Ays giikko istti biitta ubbaa wochchanaas yida» giza kiita yeddides.<verse eid="JOS 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 2:4" />Gido attiin mishireya he nam7u asata qotta woththada, «Ee asati taakko yidaakkoshin istti awappe yidaakko ta erabeekke. <verse eid="JOS 2:4" /><verse number="5" style="v" sid="JOS 2:5" />Omars katama penge gordana giza wode istti kezi bida; istti awa bidaakko ta erikke; eesotidi kaallizaa gidikko intte istta oykkana» gadus. <verse eid="JOS 2:5" /><verse number="6" style="v" sid="JOS 2:6" />Gido attiin Era7aaba asata pooqe mala oosettidaso kessada micettida talbba buuxa giddon istta qotta woththadus. <verse eid="JOS 2:6" /><verse number="7" style="v" sid="JOS 2:7" />Asati xomosizayta koyanaas kezidi Yordaanoose shaafa pinth efiza oge oykkidi bida; koyzayti katamaappe kezida mala katamaa pengey gordettides.<verse eid="JOS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 2:8" />Wochchizayti dhiskanaappe kasetada iza isttako pude kezada isttas, <verse eid="JOS 2:8" /><verse number="9" style="v" sid="JOS 2:9" />«GODAY ha biittaa inttes immidayssa, inttes yashshateththi nunan kumidayssanne ha biittan de7iza asaa wozinay inttes hirgan seeridayssa ta erays. <verse eid="JOS 2:9" /><verse number="10" style="v" sid="JOS 2:10" />Gibxe biittafe intte kezida wode intte sinththan Zo7o abbaa GODAY wostti melissidaakko nuni siyidos; qasse Yordaanoose shaafappe arshe kessaso baggara diza Amoore biitta kawota nam7ata, Sihoonenne Aage intte wostti ubbaa dhayssidaakko nu siyidos.<note caller="-" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="EXO 14:21">Kessa 14:21</ref>; <ref loc="NUM 21:21-35">Tay 21:21-35</ref></char></note> <verse eid="JOS 2:10" /><verse number="11" style="v" sid="JOS 2:11" />Nu hessa siyida mala nu wozinay seerides; inttes yashshateththafe dendidayssan shirotontta asi deenna; GODAA intte Xoossay bolla salonkka garsa biittankka izi Xoossa. <verse eid="JOS 2:11" /><verse number="12" style="v" sid="JOS 2:12" />Hessa gishshas tani inttes kiyida mala intteka ta aawa keeththa asaas kiyana mala taas GODAAN caaqqite; hessaska ammanththiza malata taas immite. <verse eid="JOS 2:12" /><verse number="13" style="v" sid="JOS 2:13" />Ta aawaanne ta aayiyo, ta ishatanne ta michcheta isttas shemppora diza ubbaa wodhopite; nuna hayqoppe ashshite» gadus.<verse eid="JOS 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 2:14" />He asati, «Nu nees caaqqida qaalaa mala polontta aggiko Xoossi nuna wodho! Nu ooththidayssa ne oonaska yootontta aggiko, GODAY hanno biittayo nuus immiza wode nu nees lo7o ooththana mala caaqqoos» gida.<verse eid="JOS 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 2:15" />Era7aaba diza keeththay katamaa dirsaara oyketti keexetti uttida gishshas asata wodoron qachchada maskootera duge woththadus. <verse eid="JOS 2:15" /><verse number="16" style="v" sid="JOS 2:16" />Era7aaba isttas, «Inttena koyzayti demmontta mala pude zumbullata bolla kezidi heen heedzdzu gallas qotettite; hessafe guye intte baanaaso biite» gadus.<verse eid="JOS 2:16" /></para>
  <para style="p">
    <verse number="17-18" style="v" sid="JOS 2:17-18" />Asatikka izis, «Nuni ne biitta geliza wode ha zo7o wodoroza neni nuna kessida maskoote bolla qachchontta aggiko ne aawa, ne aayiyo, ne ishatanne neso asaa ubbaa neso ehontta aggiko neni nuna caaqisida caaqoy nuus gomettenna. <verse eid="JOS 2:17-18" /><verse number="19" style="v" sid="JOS 2:19" />Oonikka ne keeththafe kare kezi oge bolla beetti hayqqiko hessi iza gome; nuni hessan oyshshettoko; gido attiin nenara soon issife dizay oonikka boshettiko iza suuththa gomey nuna gakko. <verse eid="JOS 2:19" /><verse number="20" style="v" sid="JOS 2:20" />Nu ooththizayssa ne haras yootizaa gidikko neni nuna caaqeththida caaqoy nuus gomettenna» gida.<verse eid="JOS 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 2:21" />Izakka, «Intte gida mala hano» gaada istta moyzadus; istti bidaappe guye zo7o wodoro ba maskoote bolla qaaphadus.<verse eid="JOS 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 2:22" />Istti pude zumbullatakko bida; goodeththizayti Iyarkko simmana gakkanaas heen heedzdzu gallas qotettida. Goodeththizayti oge ubbaan koyida shin istti demmibeettenna. <verse eid="JOS 2:22" /><verse number="23" style="v" sid="JOS 2:23" />Hessafe guye he nam7u asati zumbullatappe wodhdhi Yordaanoose shaafaa pinnidi Nawe naa Iyaasokko biidi bana gakkida ubbaa izas yootida. <verse eid="JOS 2:23" /><verse number="24" style="v" sid="JOS 2:24" />Istti Iyaasos, «GODAY tumappe biitta ubbaa nuus aaththi immides; qasse he biittan diza asay wuri nuus yashshateththafe dendidayssan istta wozinay seeridayssa nu be7idos» gida.<verse eid="JOS 2:24" /></para>
  <chapter eid="JOS 2" />
  <chapter number="3" style="c" sid="JOS 3" />
  <para style="s1">Isra7eele Asay Yordaanoose Shaafa Pineth</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 3:1" />Iyaasoynne Isra7eele asay maalado wonttara dendida; istti Shiixime geetettizasoppe dendidi Yordaanoose shaafaakko biidi pinnontta heen takkida. <verse eid="JOS 3:1" /><verse number="2" style="v" sid="JOS 3:2" />Heedzdzu gallassafe guye ola gadawati istti dunkaanidason gelidi, <verse eid="JOS 3:2" /><verse number="3" style="v" sid="JOS 3:3" />asaas, «GODAA intte Xoossaa Caaqo Qaalaa Taabotaanne iza tookkida Lewe zare qeeseta be7iza wode intte dunkaanidasoppe dendidi istta kaallite. <verse eid="JOS 3:3" /><verse number="4" style="v" sid="JOS 3:4" />Intte kase he ogera bi erontta gishshas intte baana oge istti inttena bessana; gido attiin Caaqo Qaalaa Taabotaakko shiiqopite; Caaqo Qaala Taabotaappe 2,000 wadha gidizayssa mala haahon eqqite» gi azazo immida.<verse eid="JOS 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 3:5" />Iyaasoy asaa, «GODAY wonto intte giddon malalisizaaz ooththana gishshas intte geeyte» gides. <verse eid="JOS 3:5" /><verse number="6" style="v" sid="JOS 3:6" />Qasseka Iyaasoy qeesetas, «Intte Caaqo Qaala Taabotaa tookkidi asaappe sinththe aadhdhite» gi yootides; istti Caaqo Qaala Taabotaa tookkidi deraappe sinththe sinththe bida.<verse eid="JOS 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 3:7" />GODAY Iyaasos, «Tani Musera gidida mala nenara gidanayssa Isra7eele asay wuri erana mala hach istta sinththan tani nena dhoqqu dhoqqu ooththanaas doommana. <verse eid="JOS 3:7" /><verse number="8" style="v" sid="JOS 3:8" />Neni Caaqo Qaala Taabotaa tookkiza qeeseta, ‹Yordaanoose shaafa doona gakkiza wode haaththan gelidi eqqite› gaada azaza» gides.<verse eid="JOS 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 3:9" />Iyaasoy Isra7eele asaa, «Haa yiite; yiidi GODAA intte Xoossaa qaala siyite. <verse eid="JOS 3:9" /><verse number="10" style="v" sid="JOS 3:10" />De7o Xoossi intte giddon dizayssanne izi tumappe Kanaaneta, Hiiteta, Hiiweta, Paarizeta, Gergeseta, Amooretanne Yaabuseta intte sinththafe kessanayssa intte hessan erana. <verse eid="JOS 3:10" /><verse number="11" style="v" sid="JOS 3:11" />Sa7a ubbaa GODAA Caaqo Qaalaa Taabotay inttefe sinththatidi Yordaanoose shaafaa gelana. <verse eid="JOS 3:11" /><verse number="12" style="v" sid="JOS 3:12" />Ha7i Isra7eele zaretappe 12 asata doorite; issi issi zareppe issi issi as gido. <verse eid="JOS 3:12" /><verse number="13" style="v" sid="JOS 3:13" />Sa7a ubbaa GODAA Caaqo Qaala Taabotaa tookkida qeeseta tohoy Yordaanoose haaththaa bochchida mala pudehappe duge goggiza Yordaanoose haaththi heerakka gogeththaa aggaagana; doore mala gidi eqqaa gaana» gides.<verse eid="JOS 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 3:14" />Asay Yordaanoose shaafaa pinnanaas ba dunkaaneppe kezida wode Caaqo Qaala Taabotaa tookkida qeeseti asaappe sinththati bida. <verse eid="JOS 3:14" /><verse number="15" style="v" sid="JOS 3:15" />Kaththa shiisho woden ubbaan Yordaanoose shaafay kixxees; gidikkoka Caaqo Qaala Taabotaa tookkida qeeseti Yordaanoose shaafa gakkidi istta tohoy haaththaa gaxa yedhdhida mala, <verse eid="JOS 3:15" /><verse number="16" style="v" sid="JOS 3:16" />goggiza haaththay eqqides; heen daro haahoson Phartaane matan diza Addaame geetettiza katamaa gakkanaas issiso shiiqidi doorettides; duge Arabe gadhan diza Maxine abban goggiza haaththi ubbay duuxxi attides; histtiin asay Iyarkko katamaa ginara pinnides. <verse eid="JOS 3:16" /><verse number="17" style="v" sid="JOS 3:17" />Isra7eele asay mela biitta yedhdhi pinniza wode asay wuri pinnana gakkanaas GODAA Caaqo Qaala Taabotaa tookkida qeeseti Yordaanoose shaafaa giddon mela biittan eqqaa gida.<verse eid="JOS 3:17" /></para>
  <chapter eid="JOS 3" />
  <chapter number="4" style="c" sid="JOS 4" />
  <para style="s1">Hassa7issiza Shuchchata Eso</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 4:1" />Kawoteththay wuri Yordaanoose shaafaa pinnidaappe guye GODAY Iyaaso, <verse eid="JOS 4:1" /><verse number="2" style="v" sid="JOS 4:2" />«Isra7eele asaappe 12 asata doora; issi issi qommofe issi issi as gido. <verse eid="JOS 4:2" /><verse number="3" style="v" sid="JOS 4:3" />Histtada isttas, ‹Yordaanoose shaafaa giddon qeeseta tohoy eqqidasoppe 12 shuchchata ekkite; he shuchchata tookki efidi hach intte aqizason woththite› gaada yoota» gides.<verse eid="JOS 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 4:4" />Hessa gishshas Iyaasoy Isra7eele qommotappe issi issi as ekkidi tammanne nam7u doorettidayta xeygides. <verse eid="JOS 4:4" /><verse number="5" style="v" sid="JOS 4:5" />Histtidi isttas, «GODAA intte Xoossaa Caaqo Qaalaa Taabotay dizasoho Yordaanoose shaafaa gelite; Isra7eele qommota qoodan wurikka issi issi shuch intte hashen hashen tookkite. <verse eid="JOS 4:5" /><verse number="6" style="v" sid="JOS 4:6" />Ha shuchchati GODAY hach ooththidayssa inttena hassa7issiza malata gidana; wodeppe intte nayti inttena, ‹Ha shuchchati aazee?› giidi oychchiza wode, <verse eid="JOS 4:6" /><verse number="7" style="v" sid="JOS 4:7" />intte, ‹GODAA Caaqo Qaalaa Taabotay pinniza wode Yordaanoose shaafay goggizayssa aggi eqqides; ha shuchchati he sohon hanidayssa ubbaa mernaas Isra7eele asaa hassa7issizayta› giidi isttas yootite» gides.<verse eid="JOS 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 4:8" />Isra7eele asay Iyaasoy azazida mala ooththides; GODAY Iyaasos yootida mala Isra7eele qommota qoodan 12 shuchchata Yordaanoose shaafaa giddofe ekkida; tookki ehidi ba aqida sohon woththida. <verse eid="JOS 4:8" /><verse number="9" style="v" sid="JOS 4:9" />Iyaasoy Caaqo Qaala Taabotaa tookkida qeeseta tohoy Yordaanoose shaafa giddon eqqidaason 12 shuchchata essides; he shuchchati hach gakkanaas heen deettes. <verse eid="JOS 4:9" /><verse number="10" style="v" sid="JOS 4:10" />GODAY Iyaaso azazidayssa ubbaa asay polana gakkanaas Caaqo Qaala Taabotaa tookkida qeeseti Yordaanoose shaafaa giddon eqqi gam7ida; Musey Iyaaso azazida azazoykka hessa; asay eesotidi shaafaa pinnides. <verse eid="JOS 4:10" /><verse number="11" style="v" sid="JOS 4:11" />Asay wuri pinnidaappe guye GODAA Caaqo Qaala Taabotaynne qeeseti asay istta xeellishin pinnida. <verse eid="JOS 4:11" /><verse number="12" style="v" sid="JOS 4:12" />Musey azazida mala Oroobeele zareti, Gaade zaretinne Minaase zaretappe baggay ola miishshaa oykkidi Isra7eele asaappe sinththatidi pinnida. <verse eid="JOS 4:12" /><verse number="13" style="v" sid="JOS 4:13" />Qoodan 40,000 gidiza asay tooranne gondalle oykki olas giigettidi GODAA sinththan Iyarkko matan diza demba pinnida. <verse eid="JOS 4:13" /><verse number="14" style="v" sid="JOS 4:14" />He gallas GODAY Iyaaso Isra7eele asaa ubbaa sinththan dhoqqu dhoqqu histtides; asay Muse bonchchida mala Iyaasokka izi dida layth ubbaan bonchchides.<verse eid="JOS 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 4:15" />Hessafe guye GODAY Iyaasos, <verse eid="JOS 4:15" /><verse number="16" style="v" sid="JOS 4:16" />«Caaqo Qaala Taabotaa tookkida qeeseti Yordaanoose shaafappe kezana mala azaza» gi yootiin, <verse eid="JOS 4:16" /><verse number="17" style="v" sid="JOS 4:17" />Iyaasoy qeeseta, «Yordaanoose shaafappe kezite» gi azazides. <verse eid="JOS 4:17" /><verse number="18" style="v" sid="JOS 4:18" />GODAA Caaqo Qaala Taabotaa tookkida qeeseti Yordaanoose shaafa giddofe kezidi mela biitta istti yedhdhida mala heerakka Yordaanoose haaththay kase mala shaafaa kumidi gogeth oykkides.<verse eid="JOS 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOS 4:19" />Asay koyro aginan tammanththa gallassan Yordaanoose shaafaa pinnidi Iyarkkon arshey mokkizaso baggara zawatiza Gelgelan dunkaanides. <verse eid="JOS 4:19" /><verse number="20" style="v" sid="JOS 4:20" />Iyaasoy Yordaanoose shaafappe ehida 12 shuchchata Gelgelan essides. <verse eid="JOS 4:20" /><verse number="21" style="v" sid="JOS 4:21" />Isra7eele asaas, «Wodeppe intte zareti ba aawata, ‹Ha shuchchati aazee?› gi oychchiza wode, <verse eid="JOS 4:21" /><verse number="22" style="v" sid="JOS 4:22" />‹Isra7eele asay Yordaanoose shaafaa mela biitta yedhdhidi pinnidayssa hassa7issizayssa› giidi yootite. <verse eid="JOS 4:22" /><verse number="23" style="v" sid="JOS 4:23" />Nuni pinnana gakkanaas GODAA nu Xoossay Zo7o abbaa kase nu sinththan melissida mala intteka pinnana gakkanaas GODAA intte Xoossay Yordaanoose shaafaa intte sinththan melissides. <verse eid="JOS 4:23" /><verse number="24" style="v" sid="JOS 4:24" />Hessaththo izi ooththiday sa7an diza asay wuri GODAA wolqqay ay mala gitakko eranaassinne intteka GODAAS intte Xoossaas mernaas yayyanaassa» gides.<verse eid="JOS 4:24" /></para>
  <chapter eid="JOS 4" />
  <chapter number="5" style="c" sid="JOS 5" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 5:1" />Yordaanoose shaafappe arshey wulliza baggara diza Amooreta kawotinne Mediteraane Abba lanqe lanqe oykkidi diza Kanaaneta kawoti wuri Isra7eele asay pinnana gakkanaas GODAY Yordaanoose shaafa haaththaa melissidayssa siyida wode istta wozinay babon seerides. Histtiin istti Isra7eele asaara eqettanaas xalibeettenna.<verse eid="JOS 5:1" /></para>
  <para style="s1">Qaxxara</para>
  <para style="p">
    <verse number="2" style="v" sid="JOS 5:2" />He wode GODAY Iyaasos, «Salo shuchcha qara ekkada qaxxarettontta Isra7eele attuma asaa nam7anththo qaxxara» gides. <verse eid="JOS 5:2" /><verse number="3" style="v" sid="JOS 5:3" />Histtiin Iyaasoy salo shuch qarasidi Gibi7aaze Eloote geetettizason Isra7eele attumasaa qaxxarides. <verse eid="JOS 5:3" /><verse number="4" style="v" sid="JOS 5:4" />Izi hessa ooththida gaasoykka Gibxeppe kezida asan layththay olas gakkida attuma asay wuri Gibxeppe kezidaappe guye bazzon oge bolla hayqqides. <verse eid="JOS 5:4" /><verse number="5" style="v" sid="JOS 5:5" />Gibxeppe kezida attuma asay wuri qaxxarettides; gido attiin bazzon yuuyiza wode yelettida attuma naytappe issoyka qaxxarettibeenna. <verse eid="JOS 5:5" /><verse number="6" style="v" sid="JOS 5:6" />Isra7eele kawoteththay GODAAS azazettontta ixxida gishshas Gibxeppe keziza wode layththay olas gakkida attuma asay wuri hayqqidi wurana gakkanaas bazzon 40 layth yuuyides; hessan GODAY isttas, «Eessinne maaththi goggiza aradda biitta tani kase intte aawatas immana gida he biittaa intte beyekketa» gida qaalay polettanaassa.<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="NUM 14:28-35">Tay 14:28-35</ref></char></note> <verse eid="JOS 5:6" /><verse number="7" style="v" sid="JOS 5:7" />Hessa gishshas GODAY istta nayta isttasohon denththides; Iyaasoy qaxxara gelththidayti heytantta; istti oge bolla hemettishe diza gishshas qaxxarettibeettenna.<verse eid="JOS 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 5:8" />Kawoteththay wuri qaxxarettidaappe guye madunththay paxana gakkanaas ba dunkaani dizason takkides. <verse eid="JOS 5:8" /><verse number="9" style="v" sid="JOS 5:9" />GODAY Iyaasos, «Hach tani Gibxeta bore inttefe genderisa diggadis» gides; histtiin he sohoza sunththay hach gakkanaas Gelgela<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="fqa" closed="false">Gelgela: </char><char style="ft" closed="false">Gelgela guussay Ibraaweta qaalan genderisi diggides guussa.</char></note> geetettees.<verse eid="JOS 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 5:10" />Isra7eele asay Iyarkko demban Gelgelan dunkaani dishe aginay geliin tammanne oydanththa gallassa omars Paaziga ba7aale bonchchides.<note caller="-" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="EXO 12:1-13">Kessa 12:1-13</ref></char></note> <verse eid="JOS 5:10" /><verse number="11" style="v" sid="JOS 5:11" />Paazigappe guye wonteththa gallas biittan mokkida kaththa ayfeppe irshoy gelontta uukettidayssanne caacettida tiya mides. <verse eid="JOS 5:11" /><verse number="12" style="v" sid="JOS 5:12" />He biittaan mokkida kaththa ayfe mida gallas mannay yuus aggides; hessafe guye Isra7eele asaas mannay yibeenna; gido attiin he wodeppe doommidi istti Kanaanen mokkida kath mishe de7ida.<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="EXO 16:35">Kessa 16:35</ref></char></note><verse eid="JOS 5:12" /></para>
  <para style="s1">Mashsha Oykkidi Iyaasora Gayttidaade</para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 5:13" />Iyaasoy Iyarkko matan dishe dhoqqu gi xeellidi giththa mashsha shoddi oykkida issi asi iza sinththan eqqidayssa be7ides; Iyaasoy izakko shiiqidi, «Neni nu baggayee nu morkketa baggaa?» gi oychchides.<verse eid="JOS 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 5:14" />Izikka, «Ta oona baggaka gidikke; gido attiin tani GODAA olanchchata gadawa gidida gishshas yadis» gi zaarides.</para>
  <para style="p" vid="JOS 5:14">Iyaasoykka sa7an gufanni goynnidi, «Ta godawu! Taas ne ayllezas ne ay yootanee?» gides.<verse eid="JOS 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 5:15" />GODAA olanchchata gadaway, «Neni eqqidasoy geesh gidida gishshas ne tohoppe caamma kessa» gides; histtiin Iyaasoy izi azazida mala ooththides.<verse eid="JOS 5:15" /></para>
  <chapter eid="JOS 5" />
  <chapter number="6" style="c" sid="JOS 6" />
  <para style="s1">Iyarkko Kundeth</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 6:1" />Isra7eele asaas yayyida gaason Iyarkko katama dirsa pengeti gordettida; katamaa gelanaassinne katamaappe kezanaas dandayzay oonikka deenna. <verse eid="JOS 6:1" /><verse number="2" style="v" sid="JOS 6:2" />GODAY Iyaasos, «Hekko tani Iyarkko katamayo izi kawozara izi mino olanchchatarakka ne kushen aaththa immadis. <verse eid="JOS 6:2" /><verse number="3" style="v" sid="JOS 6:3" />Neninne ne olanchchati cifridi usuppun gallas gakkanaas hach hach katamaa dirsaa issito yuuyi aadhdhite.<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false">Cifra gizayssa issi issi bagga gamoththo qaalan ziire guussa.</char></note> <verse eid="JOS 6:3" /><verse number="4" style="v" sid="JOS 6:4" />Qasse laappun qeeseti laappun zayeta oykkidi GODAA Caaqo Qaala Taabotaa sinth aadhdhetto; laappunththa gallas qeeseti zayeta punnishin olanchchati cifridi issife katamayo laappunto yuuyi aadhdhetto. <verse eid="JOS 6:4" /><verse number="5" style="v" sid="JOS 6:5" />Hessafe guye zayey qanxxoy baynda punettizayssa siyida mala asay wuri ba qaala dhoqqu histti waasso; histtida mala katamay gimbey laalettana; asay wuri lawuhu gi ke7idi katamay giddo sitti gi gelana» gides.<verse eid="JOS 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 6:6" />Nawe naa Iyaasoy qeeseta xeygidi, «GODAA Caaqo Qaala Taabotaa tookkite; inttefe laappun qeeseti laappun zayeta oykkidi Caaqo Qaala Taabotaappe sinththe aadhdhi biite» gides. <verse eid="JOS 6:6" /><verse number="7" style="v" sid="JOS 6:7" />Derezakka, «Gede sinththe biite; katamaa yuuyi aadhdhite; olanchchatikka GODAA Caaqo Qaala Taabotaappe sinththati betto; katamayokka yuuyite» giidi azazides.<verse eid="JOS 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 6:8" />Iyaasoy asaas haasayda mala laappun qeeseti laappun zayeta GODAA sinththan oykkidi punnishe sinththati bida; qasse GODAA Caaqo Qaala Taabotay istta kaallides. <verse eid="JOS 6:8" /><verse number="9" style="v" sid="JOS 6:9" />Olas giigettidayti zayeta punniza qeesetappe sinththara bishin guyera naagiza olanchchati Caaqo Qaala Taabotaa kaallida; he wode zayey qanxxoy baynda punettides. <verse eid="JOS 6:9" /><verse number="10" style="v" sid="JOS 6:10" />Gido attiin Iyaasoy asaa, «Tani inttena, ‹Waassite!› gaana gallassay gakkanaas ola waaso waassofte; intte qaalay siyettofo; issi qaalakka qaattofte; ta waassite giikko he wode waassite!» gi azazides. <verse eid="JOS 6:10" /><verse number="11" style="v" sid="JOS 6:11" />Hessa gishshas GODAA Caaqo Qaala Taabotay tookettidi he katamaa issito yuuyi aadhdhana mala ooththides; hessafe guye asay ba dunkaanidaso simmidi omars heen aqides.<verse eid="JOS 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 6:12" />Wonteththa gallas Iyaasoy wonttatti dendides; qeesetikka GODAA Caaqo Qaala Taabotaa tookkida. <verse eid="JOS 6:12" /><verse number="13" style="v" sid="JOS 6:13" />Laappun zayeta oykkida laappun qeeseti sinththe aadhdhidi zayishe GODAA Caaqo Qaala Taabotaappe sinththe sinththe bishe zayeza qanxxoy baynda punnida; olas giigidayti isttafe sinththara bishin guyera naagiza olanchchatikka GODAA Caaqo Qaala Taabotaa kaalli beettes; he wode qeeseti qanxxoy baynda zaye zayeettes. <verse eid="JOS 6:13" /><verse number="14" style="v" sid="JOS 6:14" />Nam7anththo gallas katamaa issito yuuyi aadhdhidi ba dunkaanidaso simmida; usuppun gallas gakkanaas hessaththoka ooththida.<verse eid="JOS 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 6:15" />Laappunththa gallas bazzoy zo7ishin dendidi kaseyssaththoka katamayo laappunto yuuyi aadhdhida; he gallas xalla katamayo laappunto yuuyi aadhdhida. <verse eid="JOS 6:15" /><verse number="16" style="v" sid="JOS 6:16" />Laappunththo yuuyishe qeeseti zayeta punnishin Iyaasoy deraa, «GODAY hanno katamayo inttes aaththi immida gishshas waassite! <verse eid="JOS 6:16" /><verse number="17" style="v" sid="JOS 6:17" />Katamayanne katamay giddon diza ubbay GODAAS dumma gidida gishshas izo mulera dhayssite; nuni biittayo wochchanaas kiittida asata qotta ashshida gishshas layma maccas Era7aabanne izi soon izira issife diza asi xalla attana. <verse eid="JOS 6:17" /><verse number="18" style="v" sid="JOS 6:18" />Gido attiin intte GODAAS dummatidayssafe aykkoka ekkontta mala intte hu7es naagettite; intte histtontta aggiko Isra7eeleti dunkaanidaso iitas aaththi immana; histtidi he sohoza bolla meto gaththana. <verse eid="JOS 6:18" /><verse number="19" style="v" sid="JOS 6:19" />Biraynne worqqay wuri qasse xarqimalappenne biratappe oosettida miishshati ubbay GODAAS dumma gidida gishshas GODAA minjja keeth gelo» gides.<verse eid="JOS 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 6:20" />Hessa gishshas zayey punettiin asay waassides; zayezi punettishin derezi ba qaala dhoqqu histtidi waassiin katamaa dirsay laalettides; hessafe guye asay wuri sitti giidi gede katamayo gelides. <verse eid="JOS 6:20" /><verse number="21" style="v" sid="JOS 6:21" />Katamaan shemppora paxa dizayta ubbaa oykkidi macca, attuma, nayta, cimata, miiz, dorsanne hare ubbaa qara mashshan wodhides.<verse eid="JOS 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 6:22" />Iyaasoy biittaa wochchanaas kiitettida nam7u asata, «Layma maccas Era7aabi soo biite; histtidi intte izis caaqqida mala ane izonne izi soo asaa ubbaa qori kessite» gides. <verse eid="JOS 6:22" /><verse number="23" style="v" sid="JOS 6:23" />Hessa gishshas biittaa wochchida asati biidi Era7aabo, izi aawaa, izi aayiyo, izi ishatanne izi dabbota ubbaa qori kessida; Isra7eele asay dunkaani dizasoppe gaxara woththida. <verse eid="JOS 6:23" /><verse number="24" style="v" sid="JOS 6:24" />Hessafe guye katamayonne izi giddon diza ubbaa taman xuuggida; gido attiin biranne worqqa, xarqimalappenne biratappe oosettida miishshata GODAA minjja keeththan woththida. <verse eid="JOS 6:24" /><verse number="25" style="v" sid="JOS 6:25" />Qasse Iyaasoy layma maccas Era7aabo izi aawa soo asaanne izira diza dabbota ubbaa ashshides; gaasoykka Iyaasoy Iyarkko katamayo wochchanaas kiitettida asata iza kase qottada ashshida gishshassa; izi zareti hach gakkanaas Isra7eele biittan deettes.<note caller="-" style="x"><char style="xo" closed="false">6:25 </char><char style="xt" closed="false"><ref loc="HEB 11:31">Ib 11:31</ref></char></note><verse eid="JOS 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JOS 6:26" />He wode Iyaasoy, «Hanno katamayo zaari essiza asi,</para>
  <para style="q1" vid="JOS 6:26">‹GODAA sinththan qanggettidaade gido.</para>
  <para style="q2" vid="JOS 6:26">Yoch yeggiza wode</para>
  <para style="q2" vid="JOS 6:26">izas bayra nay dhayo.</para>
  <para style="q2" vid="JOS 6:26">Gimbeta essishin</para>
  <para style="q2" vid="JOS 6:26">wurseththa nay dhayo› »</para>
  <para style="q2" vid="JOS 6:26">giidi qanggides.<verse eid="JOS 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JOS 6:27" />Ha ubbaan GODAY Iyaasora gidides; Iyaaso goobateththa worey biitta ubbaa gakkides.<verse eid="JOS 6:27" /></para>
  <chapter eid="JOS 6" />
  <chapter number="7" style="c" sid="JOS 7" />
  <para style="s1">Akaane Nagara</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 7:1" />Isra7eele asay GODAAS ammanettontta ixxidi piila miish ekkides; hessa ekkiday Akaane; Akaaney Karme naa; Karmey Zimire naa; Zimirey Yuhuda qommofe Zaraahe naa; histtiin GODAA hanqoy Isra7eele asaa bolla eexxi kezides.<verse eid="JOS 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JOS 7:2" />Iyaasoy Beetele katamappe arshey mokkiza baggara Beeti-Awene matan diza Aye katama Iyarkkofe as kiittidi, «Gede ke7ite; Biittayokka wochchite» gides. Asatikka biidi Aye katamaa wochchida.<verse eid="JOS 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 7:3" />Wochchida asati Iyaasokko simmi yiidi, «Aye katamaa olanaas ubba asay baanaas koshshenna; nam7u woykko heedzdzu shii as yedda; Ayen guuththa asi diza gishshas asay wuri daaburoppo» gida. <verse eid="JOS 7:3" /><verse number="4" style="v" sid="JOS 7:4" />Histtiin 3,000 gidiza asay olettanaas Aye katama bides; gido attiin asay Aye katama asaa sinththafe baqatides. <verse eid="JOS 7:4" /><verse number="5" style="v" sid="JOS 7:5" />Aye katama asay Isra7eele asaa katamaa gimbe pengefe biidi Shibaarme gakkanaas dugunththaan gooddishe shocides; isttafe 36 as wodhida; hessan asaa wozinay seeridi haaththa mala gukkides.<verse eid="JOS 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 7:6" />Hessafe guye Iyaasoy ba may7o daakkides; histtidi GODAA Taabotaa sinththan omars gakkanaas gufannides. Isra7eele cimatikka hessa mala hanida; ba hu7enkka gudulla makkida. <verse eid="JOS 7:6" /><verse number="7" style="v" sid="JOS 7:7" />Histtiin Iyaasoy, «Aayye ana! Ubbaa Haariza GODAWU! Nuna Amoore asaas aaththa immada wursisanaas ays Yordaanoose shaafaa pinththada ehadii? Nu pinnontta heen attidaakko aazee dizayshin! <verse eid="JOS 7:7" /><verse number="8" style="v" sid="JOS 7:8" />Abeet Godawu! Isra7eele asay xoonettidi ba morkketa sinththafe baqatidayssa tani ay goo? <verse eid="JOS 7:8" /><verse number="9" style="v" sid="JOS 7:9" />Kanaane asaynne ha biittan diza hara asay wuri ha yo7oza siyidi nuna dooddana; biitta bollafe nu sunth dhayssana; histtiin ne gita sunththaa gishshas gaada ne ay ooththanee?» gides.<verse eid="JOS 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 7:10" />GODAY Iyaaso, «Denda eqqa! Ays gufannadii? <verse eid="JOS 7:10" /><verse number="11" style="v" sid="JOS 7:11" />Isra7eele asay nagara ooththides; tani isttara caaqettida ta caaqoza menththides; istti piila miishshatappe ekkida; kaysotida; wordotida; qasse bantti ekkidayssa bantta miishshara walakkida. <verse eid="JOS 7:11" /><verse number="12" style="v" sid="JOS 7:12" />Isra7eele asay bantta morkketara eqettanaas dandayonttay hessa gaasonna; istti dhayos aadhdhi imettida gishshas bantta morkketa sinththafe guye simmi baqatida; piila miish intte giddofe intte dhayssontta aggiko hayssafe guye tani inttenara gidikke.<verse eid="JOS 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 7:13" />«Denda! Asaa geeshsha; isttas, ‹GODAA Isra7eele Xoossay inttena: Isra7eeletoo! Piila miishshi intte giddon dees; intte hessa intte giddofe diggana gakkanaas intte morkketa sinththan eqqanaas dandayekketa; wontos inttena giigsanaas inttena geeshshite. <verse eid="JOS 7:13" /><verse number="14" style="v" sid="JOS 7:14" />Wonto mallado intte qommon qommon shiiqite; GODAY shaakkidayssi, zaren zaren, zarkken zarkken, keeththan keeththaninne hu7en hu7en sinththe kezana. <verse eid="JOS 7:14" /><verse number="15" style="v" sid="JOS 7:15" />Hessafe guye piila miishshi iza achchan beettidaadeynne izas diza ubbay taman xuugettana. Gaasoykka GODAA Caaqo Qaalaa laallidi Isra7eele giddon yeellachchiza ooso ooththida gishshassa› ga» gides.<verse eid="JOS 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 7:16" />Iyaasoy wonteththa gallas wonttara dendidi Isra7eele asay ba qommon qommon shiiqana mala ooththides; hessafe guye Yuhuda qommoy shaakettides. <verse eid="JOS 7:16" /><verse number="17" style="v" sid="JOS 7:17" />Yuhuda qommoy shiiqiin, Zaraahe zarey shaakettides; Zaraahe zarey shiiqiin, Zimire soo asay shaakettides. <verse eid="JOS 7:17" /><verse number="18" style="v" sid="JOS 7:18" />Zimire soo asay shiiqiin, wurseththan Zimire naa, Karme naa Akaaney shaakettides. <verse eid="JOS 7:18" /><verse number="19" style="v" sid="JOS 7:19" />Histtiin Iyaasoy Akaane, «Ta naazoo! GODAA Isra7eele Xoossaa bonchcha; izas paaxa; ane neni ooththidayssa qottontta dashe taas yoota» gides.<verse eid="JOS 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 7:20" />Akaaneykka Iyaasos, «Ee tuma! Tani GODAA Isra7eele Xoossaa qohadis; tani ooththiday hayssa; <verse eid="JOS 7:20" /><verse number="21" style="v" sid="JOS 7:21" />Di7etti yida miishshaa giddofe tani issi lo7iza Sana7oore kaabba, nam7u xeetu saqile biranne bagga kilo gidiza worqqa be7ada amottida gishshas ekkadis. Histtada ta dunkaane giddon bookkada biraa garsara hiixxa moogadis» gides.<verse eid="JOS 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 7:22" />Histtiin Iyaasoy as kiittides; istti iza dunkaanekko woxxi biidi birazi garsara hiixetti hankko miishshatara moogettidayssa demmida. <verse eid="JOS 7:22" /><verse number="23" style="v" sid="JOS 7:23" />Kiitetti bida asati miishshaa dunkaaneza giddofe ekkidi, Iyaasokkonne Isra7eele asaakko ehidi GODAA sinththan woththida.<verse eid="JOS 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 7:24" />Hessafe guye Iyaasoynne Isra7eele asay ubbay issife Zaraahes naaza naa Karme naa Akaane, biraa, kaabbaa, worqqaa, iza attuma naytanne macca nayta, iza miizaa, haretanne dorsata, iza dunkaanenne izas dizayssa ubbaa ekkidi Akoore zulle ehides. <verse eid="JOS 7:24" /><verse number="25" style="v" sid="JOS 7:25" />Iyaasoy Akaane, «Hayssa mala meto nu bolla ays ehadii? GODAY hach ne bollaka meto ehana» gides.</para>
  <para style="p" vid="JOS 7:25">Histtiin Isra7eele asay wuri Akaanenne iza soo asaa shuchchan kurakki wodhidi izas diza ubbaa taman xuuggides. <verse eid="JOS 7:25" /><verse number="26" style="v" sid="JOS 7:26" />Istti Akaane bollan hach gakkanaas diza daro shuch korida. Hessafe guye GODAY yashissiza ba hanqoza zaarides; hessa gishshas hach gakkanaas he sohoy Akoore zulle geetettees.<note caller="+" style="f"><char style="fr" closed="false">7:26 </char><char style="ft" closed="false">Akoore zulle guussi meto zulle guussa.</char></note><verse eid="JOS 7:26" /></para>
  <chapter eid="JOS 7" />
  <chapter number="8" style="c" sid="JOS 8" />
  <para style="s1">Aye Katama Xooneteth</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 8:1" />GODAY Iyaasos, «Yayyofa; dagammofa! Olanchchata ubbaa nenara ekkada, Aye katama baada ola. Hekko Aye katama kawo, iza deraa, iza katamaanne iza biittaa tani ne kushen aaththa immadis. <verse eid="JOS 8:1" /><verse number="2" style="v" sid="JOS 8:2" />Neni Iyarkko katamaanne iza kawoza dhayssida mala Aye katamaanne iza kawozakka dhayssana. Gido attiin bonqqida haarozanne di7ida meheza inttes ekkite. Katamaappe guye baggara zamadi naagiza olanchchata woththa» gides.<verse eid="JOS 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 8:3" />Histtiin Iyaasoynne olanchchati ubbay Aye olanaas dendida. Iyaasoy ba olanchchata giddofe 30,000 gidiza mino olanchchata dooridi qammara yeddides. <verse eid="JOS 8:3" /><verse number="4" style="v" sid="JOS 8:4" />Iyaasoy isttas, «Siyite, katamaappe guye baggara zamadi naagite; katamaappe haakkofte; ubbayka minni naagite. <verse eid="JOS 8:4" /><verse number="5" style="v" sid="JOS 8:5" />Taninne tanara diza asa ubbay katamaykko shiiqana; he wode Aye katama asay kaseyssaththoka nunara olettana giidi nuukko kezishin nuni isttafe baqatana. <verse eid="JOS 8:5" /><verse number="6" style="v" sid="JOS 8:6" />Katamaappe istti ubbay kezana gakkanaas nuni istta sinththafe baqatana; histtida mala isttas, ‹Kaseyssaththo Isra7eeleti nu sinththafe baqateettes› gishe nu istta kaaleththidi haassi efana gakkanaas istti nuna kaallana; nunikka isttafe baqatana. <verse eid="JOS 8:6" /><verse number="7" style="v" sid="JOS 8:7" />He wode intte qotettidasoppe kezidi katamayo oykkandeta; GODAA intte Xoossay katamayo inttes aaththi immana. <verse eid="JOS 8:7" /><verse number="8" style="v" sid="JOS 8:8" />Katamayo oykkidaappe guye GODAY azazida mala taman xuuggite; be7ite tani inttena azazadis» gides.<verse eid="JOS 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 8:9" />Histtidi Iyaasoy olanchchata yeddides; istti biidi Aye katamappe arshey wullizaso baggara diza Beetelessinne Ayes giddon zamadi naagida; gido attiin Iyaasoy he gallassa omars asaara issife aqides.<verse eid="JOS 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 8:10" />Iyaasoy wonteththa gallas wonttara dendidi olanchchata ubbaa shiishshides; izinne Isra7eele gadawati ola asaa kaaleththidi Aye bida. <verse eid="JOS 8:10" /><verse number="11" style="v" sid="JOS 8:11" />Izara diza olanchchati ubbay katamays sinth bi matida; hessafe guye qasse Aye katamaappe pudeha baggara diza shoobbaafe he pinththan dunkaanida. <verse eid="JOS 8:11" /><verse number="12" style="v" sid="JOS 8:12" />Iyaasoy 5,000 gidana olanchchata ekkidi katamayppe arshey wulliza baggara Beeteleppenne Ayeppe giddon zamadi uttana mala ooththides. <verse eid="JOS 8:12" /><verse number="13" style="v" sid="JOS 8:13" />Katamayppe pudeha baggara diza olanchchatanne katamayppe arshey wulliza baggara zamadi uttida olanchchata ubbaa soho soho oyththides. He gallassa omars Iyaasoy duge shoobbaa wodhdhides.<verse eid="JOS 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 8:14" />Aye dere kawoy hessa be7idi izinne iza olanchchati ubbay Isra7eele asaa olanaas Arabeppe sinththa baggara dizasoho yida. Gido attiin kawozi katamayppe guye baggara zamadi naagizayti dizayssa eribeenna. <verse eid="JOS 8:14" /><verse number="15" style="v" sid="JOS 8:15" />Iyaasoynne Isra7eele asay ubbay xoonettidaa misatidi bazzo simmi baqatida. <verse eid="JOS 8:15" /><verse number="16" style="v" sid="JOS 8:16" />Aye asay ubbay istta yedeththanaas xeygettida; Iyaasokka yedeththida; hessaththo ooththidi Aye asay katamaappe haakkana mala ooththida. <verse eid="JOS 8:16" /><verse number="17" style="v" sid="JOS 8:17" />Isra7eele asaa yedeththanaas Ayeppenne Beeteleppe kezontta attida attumasi deenna; katamayo doya yeggidi Isra7eele yedeththida.<verse eid="JOS 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JOS 8:18" />Hessafe guye GODAY Iyaasos, «Katamayo ta ne kushen aaththa immana; ne oykkida tooraa Aye bolla xonganaas malla xeella» gides. Histtiin Iyaasoy ba tooraa katamaakko zaaridi mallides. <verse eid="JOS 8:18" /><verse number="19" style="v" sid="JOS 8:19" />Iyaasoy tooraa hee zaari mallida mala kase zamadi uttida olanchchati bantti qotettidasoppe eeson kezida. Woxxi gelidi oykkida; heerakka izo taman xuuggida.<verse eid="JOS 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 8:20" />Aye asay guye simmidi xeellishin katamayppe cuway salo kezizayssa be7ida. Bazzo baqatida Isra7eele asay istta bolla haa simmi wodhdhida gishshas isttas bizasoy dhaydes. <verse eid="JOS 8:20" /><verse number="21" style="v" sid="JOS 8:21" />Iyaasoynne Isra7eele asay ubbay zamadi uttida olanchchati katamaa oykkidayssanne cuway salo kezidayssa be7ida mala guye simmidi Aye asaa bolla meto yeggida. <verse eid="JOS 8:21" /><verse number="22" style="v" sid="JOS 8:22" />Zamadi uttida olanchchatikka katamayppe istta bolla kezida. Hessa gishshas Isra7eele olanchchati istta yaara haara giddoththidi dippi histtida; issi asikka attibeenna. <verse eid="JOS 8:22" /><verse number="23" style="v" sid="JOS 8:23" />Gido attiin Aye kawo xalla shemppora paxa oykkidi Iyaasokko ehida.<verse eid="JOS 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 8:24" />Isra7eele asay Aye attuma asaa ubbaa yedeththida dembaninne bazzon issaa issaa qara mashshan wodhi wursidaappe guye simmidi katamayo biidi heen beettida as ubbaa wodhida. <verse eid="JOS 8:24" /><verse number="25" style="v" sid="JOS 8:25" />He gallas Aye asay ubbay hayqqides; hayqqida asa ubbaa qooday 12,000 gidides. <verse eid="JOS 8:25" /><verse number="26" style="v" sid="JOS 8:26" />Iyaasoy Aye katamayn diza asaa mulera dhayssana gakkanaas katamaakko malli woththida tooraa duge woththibeenna. <verse eid="JOS 8:26" /><verse number="27" style="v" sid="JOS 8:27" />Gido attiin GODAY Iyaaso azazida mala Isra7eele asay he katamayn diza medosatanne di7ida miishshata baas ekkida. <verse eid="JOS 8:27" /><verse number="28" style="v" sid="JOS 8:28" />Iyaasoy Aye katamaa xuuggides; hach gakkanaas beettiza mala mernaas bidinththa doorenne bula kessides. <verse eid="JOS 8:28" /><verse number="29" style="v" sid="JOS 8:29" />Aye dere kawo miththa bolla kaqqides; iza ahaza omars gakkanaas he miththaa bolla aggaagides; arshey wullishin Iyaasoy iza ahaa katamaa penge bolla yeggana mala azazides; iza bolla daro shuch korida; shuchchay hach gakkanaas he sohon dees.<verse eid="JOS 8:29" /></para>
  <para style="s1">Eebaale Zumaa Bolla Ooraxida Caaqo Qaala</para>
  <para style="p">
    <verse number="30" style="v" sid="JOS 8:30" />Hessafe guye Iyaasoy Eebaale zuma bolla GODAAS Isra7eele Xoossaas yarsho yarshizasoho giigsides. <verse eid="JOS 8:30" /><verse number="31" style="v" sid="JOS 8:31" />GODAA aylle Musey Isra7eele asaa azazida malanne Muse Woga Maxaafaan xaafettida mala yarshizasohozi masettonttanne biratay bochchontta shuchchafe keelettides. Izan GODAAS xuugettiza yarshonne issifeteththa yarsho yarshida.<note caller="-" style="x"><char style="xo" closed="false">8:31 </char><char style="xt" closed="false"><ref loc="EXO 20:25">Kessa 20:25</ref></char></note> <verse eid="JOS 8:31" /><verse number="32" style="v" sid="JOS 8:32" />Iyaasoy Musey xaafida Woga Maxaafaa Isra7eele asay xeellishin shuchcha bolla wooci xaafides.<note caller="-" style="x"><char style="xo" closed="false">8:31-32 </char><char style="xt" closed="false"><ref loc="DEU 27:2-8">Zaare 27:2-8</ref></char></note> <verse eid="JOS 8:32" /><verse number="33" style="v" sid="JOS 8:33" />Isra7eele asay ubbay, bete asati, cimati, shuumetinne daannati ubbay GODAA Caaqo Qaala Taabotaa tookkida Lewe zare gidida qeeseta sinththan Caaqo Qaala Taabotaappe ushachcha baggaranne hadirsa baggara eqqida. GODAA aylle Musey kase azazida mala Isra7eele asaa anjjanaas isttafe bagga asay Garizaane zumaakko, bagga asay Eebaale zumaakko simmi eqqides. <verse eid="JOS 8:33" /><verse number="34" style="v" sid="JOS 8:34" />Hessafe guye Woga Maxaafaan xaafettida mala Iyaasoy Woga qaalaa anjjonne qanggeth ubbaa nababides. <verse eid="JOS 8:34" /><verse number="35" style="v" sid="JOS 8:35" />Musey azazida ubbaafe Iyaasoy nababontta aggida issi qaalaykka deenna. Kumeththa Isra7eele deraas, maccassaas, naytassinne istta giddon diza bete asatas ubbaas nababides.<note caller="-" style="x"><char style="xo" closed="false">8:33-35 </char><char style="xt" closed="false"><ref loc="DEU 11:29">Zaare 11:29</ref>; <ref loc="DEU 27:11-14">27:11-14</ref></char></note><verse eid="JOS 8:35" /></para>
  <chapter eid="JOS 8" />
  <chapter number="9" style="c" sid="JOS 9" />
  <para style="s1">Geba7oone Asay Iyaaso Baleththida Baleththo</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 9:1" />Yordaanoose shaafappe arshey wulliza baggara pude gezzen diza derey, gadhan diza derey Libaanoose gakkanaas diza gita abbaa gaxan diza Hiiteta, Amooreta, Kanaaneta, Paarizeta, Hiiwetanne Yaabuseta kawoti ubbay Isra7eele asay xoonidayssa siyida. <verse eid="JOS 9:1" /><verse number="2" style="v" sid="JOS 9:2" />Histtidi Iyaasonne Isra7eele asaa olanaas issi bolla dendi yida.<verse eid="JOS 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 9:3" />Geba7oone asay gidikko Iyaasoy Iyarkko katamaninne Aye kataman ooththidayssa siyida wode, <verse eid="JOS 9:3" /><verse number="4" style="v" sid="JOS 9:4" />baleththanaas koyidi gal7a ogoronne woyne ushshu izan woththiza sikettida lukkamo haren caanida. <verse eid="JOS 9:4" /><verse number="5" style="v" sid="JOS 9:5" />Asati gal7anne sikettida caamma aaththida; gal7a may7oka may7ida; melidi buuqqida shinqe oykkida. <verse eid="JOS 9:5" /><verse number="6" style="v" sid="JOS 9:6" />Hessafe guye istti Iyaasoy dunkaanidaso Gelgela biidi Iyaasossinne Isra7eele asaas, «Nuni haaho biittafe yidos; ha7i nunara caaqettite» gida.<verse eid="JOS 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 9:7" />Isra7eele asay Hiiwetas, «Intte nu matan diza asaakko nu ay eridi inttenara caaqettanee?» gida.<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="EXO 23:32">Kessa 23:32</ref>; <ref loc="EXO 34:12">34:12</ref>; <ref loc="DEU 7:2">Zaare 7:2</ref></char></note><verse eid="JOS 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 9:8" />Istti Iyaasos, «Nuni ne aylleta» gida.</para>
  <para style="p" vid="JOS 9:8">Iyaasoy, «Intte oonee? Awappe yidetii?» giidi oychchides.<verse eid="JOS 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 9:9" />Isttika, «Nuni ne aylleti GODAA ne Xoossaa gitateth siyidi daro haaho biittafe yidos. Iza gitateththaanne izi Gibxe biittan ooththidayssa ubbaa siyidos. <verse eid="JOS 9:9" /><verse number="10" style="v" sid="JOS 9:10" />Qasse Yordaanoose shaafappe he pinththan diza Amoore kawota nam7ata, heytikka Haseboone kawo Sihoone, Astaroote haariza Baasaane kawo Aage bolla izi ooththidayssaka nu siyidos.<note caller="-" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="NUM 21:21-35">Tay 21:21-35</ref></char></note> <verse eid="JOS 9:10" /><verse number="11" style="v" sid="JOS 9:11" />Nu dere cimatinne nu biittan diza asay ubbay nuna, inttes oge shinqe oykkidi isttara biidi gayttite; isttas, ‹Nuni inttes aylleta gidana; intte nunara caaqettite› gida.<verse eid="JOS 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 9:12" />«Nuni intteko yaanaas nu sooppe hayssa shinqezi ho7o dishin ekki yidos; gido attiin melidayssanne buuqqidayssa hayssa be7ite! <verse eid="JOS 9:12" /><verse number="13" style="v" sid="JOS 9:13" />Hayti eessa lukkamoti nuni kunththiza wode ooraththa; gido attiin ha7i istti waani daakettidaakko be7ite! Nu haaho oge hemettida gishshas nu may7oynne caammay wurides» gida. <verse eid="JOS 9:13" /><verse number="14" style="v" sid="JOS 9:14" />GODAA oychchontta Isra7eele asay istta shinqefe guuththara ekkides. <verse eid="JOS 9:14" /><verse number="15" style="v" sid="JOS 9:15" />Iyaasoy istti saron de7ana mala isttara caaqettides; deraa kaaleththizaytikka he caaqoza minththanaas qaala gelida.<verse eid="JOS 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 9:16" />Isttara caaqettida heedzdzanththo gallassafe guye he asati istta dooth gididayssa Isra7eeleti siyida. <verse eid="JOS 9:16" /><verse number="17" style="v" sid="JOS 9:17" />Isra7eele asay heedzdzu gallas hemettidi Geba7oone, Kaafire, Bi7erootenne Qiriyaate-Yi7aarime geetettiza katamata gakkides. <verse eid="JOS 9:17" /><verse number="18" style="v" sid="JOS 9:18" />Gidikkoka deraa kaaleththizayti GODAA Isra7eele Xoossaa sunththan caaqqida gishshas Isra7eeleti istta olibeettenna; kumeththa maabaraykka istta bolla zuuzumides. <verse eid="JOS 9:18" /><verse number="19" style="v" sid="JOS 9:19" />Gido attiin deraa kaaleththizayti, «Nuni GODAA Isra7eele Xoossaa sunththan caaqqida gishshas ha7i simmidi istta bolla meto gaththanaas dandayokko. <verse eid="JOS 9:19" /><verse number="20" style="v" sid="JOS 9:20" />Nuni isttas ooththana dandayzay isttas gelida caaqo qaalaa menththiin hanqoy nu bolla gakkontta mala istta wodhopite. <verse eid="JOS 9:20" /><verse number="21" style="v" sid="JOS 9:21" />Gido attiin istti kumeththa maabaraas mith mixishenne haath duuqqishe detto» gi zaarida. Hessa gishshas maabaraa kaaleththizayti gelida qaalay naagettides.<verse eid="JOS 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 9:22" />Iyaasoy Geba7oone asata xeygidi, «Intte haan nu matan de7ishe, ‹Nuni keehi haaho biittafe yidos› giidi ays nuna baleththidetii? <verse eid="JOS 9:22" /><verse number="23" style="v" sid="JOS 9:23" />Hessa gishshas ha7i intte qanggettidayta; guuththati ta GODAA Keeththan mith mixizanne haath duuqqiza aylleta gidana» gides.<verse eid="JOS 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 9:24" />Istti Iyaasos, «Nuni ne aylleti GODAA ne Xoossay ha biitta ubbaa inttes immanayssanne izan diza asaa ubbaa intte sinththafe dhayssanaas ba aylle Muse azazidayssa geeshshi siyidos. Hessa gishshas inttefe dendoyssan nu shemppos hirgidi hayssa ooththidos. <verse eid="JOS 9:24" /><verse number="25" style="v" sid="JOS 9:25" />Hekko ha7i nuni ne kushen doos; nees lo7onne suure misati beettida mala nu bolla ooththa» gi zaarida. <verse eid="JOS 9:25" /><verse number="26" style="v" sid="JOS 9:26" />Histtiin Iyaasoy Geba7oone asata Isra7eeleta kusheppe ashshides; isttika wodhibeettenna. <verse eid="JOS 9:26" /><verse number="27" style="v" sid="JOS 9:27" />He gallas Iyaasoy Geba7oone asata Isra7eele maabaraassinne GODAY dooridasohon eqqida yarshosozas istti hach gakkanaas mith mixanaassinne haath duuqqana mala ooththides.<verse eid="JOS 9:27" /></para>
  <chapter eid="JOS 9" />
  <chapter number="10" style="c" sid="JOS 10" />
  <para style="s1">Arshe Eqo</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 10:1" />Iyaasoy kase Iyarkko katamaa oli dhayssidinne istta kawoza wodhida mala, Aye katama olidi ubbaa dhayssidayssanne istta kawozakka wodhidayssa Yerusalaame kawo Adooni-Xeedeqey siyides. Qasse Geba7oone asay Isra7eele asaara saron de7anaas caaqettidayssanne ha7i isttara issife dizayssa siyides. <verse eid="JOS 10:1" /><verse number="2" style="v" sid="JOS 10:2" />Hessan izinne derezi dagammida; gaasoykka Geba7ooney kawota katama mala katamata ubbaafe gita katama; gomppay Aye katamayppe darees; izin diza asaykka mino olanchcha. <verse eid="JOS 10:2" /><verse number="3" style="v" sid="JOS 10:3" />Hessa gishshas Yerusalaame kawoy Adooni-Xeedeqey, Kebroone kawo Hohaames, Yarmuute kawo Phir7aames, Laakishe kawo Yaafi7assinne Egiloone kawo Dabirey, <verse eid="JOS 10:3" /><verse number="4" style="v" sid="JOS 10:4" />«Geba7oone katamaa asay Iyaasoranne Isra7eele asaara saro deyanaas caaqettida gishshas isttara olettanaas yiidi tana maadderketii!» gides. <verse eid="JOS 10:4" /><verse number="5" style="v" sid="JOS 10:5" />Hessafe guye Amooreta kawoti ichchashati Yerusalaame kawoy, Kebroone kawoy, Yarmuute kawoy, Laakishe kawoynne Egiloone kawoy ba olanchchata issife gaththidi ubbaa ekki biidi, Geba7oone katamaa dooddi oykkidi olida.<verse eid="JOS 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 10:6" />Geba7oone asay Gelgelan dunkaanida Iyaasokko kiittidi, «Nuna ne aylleta aggofa; eeson nuukko yaada nuna ashsha. Gezze deren diza Amooreta kawoti wuri nuna olanaas ba olanchchata ubbaa shiishshi ekkidi yiza gishshas nuna ne aylleta maadda» gida.<verse eid="JOS 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 10:7" />Hessa gishshas Iyaasoy ba olanchchatanne mino asata ubbaa shiishshi ekkidi Gelgelappe kezides. <verse eid="JOS 10:7" /><verse number="8" style="v" sid="JOS 10:8" />GODAY Iyaaso, «Ne isttas yayyofa; tani istta ne kushen aaththa immadis; isttafe issaadeyka nenara eqettanaas dandayenna» gides. <verse eid="JOS 10:8" /><verse number="9" style="v" sid="JOS 10:9" />Hessafe guye Iyaasoy Gelgelappe omarsara hemettishe aqidi istti akeekontta dishin istta bolla worajjides. <verse eid="JOS 10:9" /><verse number="10" style="v" sid="JOS 10:10" />GODAY Isra7eele asaa sinththan Amooreta bolla shiro yeddides; Isra7eele asay isttafe daro asaa Geba7oonen wodhides. Isra7eele asay istta Beeti-Horoone efiza oge pudunththan kaallides; Azeeqeppe biidi Maqeeda gakkanaas yedeththi wodhida. <verse eid="JOS 10:10" /><verse number="11" style="v" sid="JOS 10:11" />Beeti-Horooneppe duge Azeeqe efiza oge oykkidi istti Isra7eele asaa sinththafe baqatishin GODAY wolqqama shach saloppe istta bolla bukisides. Histtiin Isra7eele asay mashshan wodhida asaappe, shachchay wodhida asay keehippe daro.<verse eid="JOS 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 10:12" />GODAY Amooreta Isra7eele asaa kushen aaththi immida gallas Isra7eele asaa sinththan Iyaasoy GODAAS,</para>
  <para style="q1" vid="JOS 10:12">«Arshey Geba7oonen eqqo;</para>
  <para style="q2" vid="JOS 10:12">Aginaykka Ayaaloone</para>
  <para style="q2" vid="JOS 10:12">shoobban eqqu» gides.<verse eid="JOS 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 10:13" />Hessa gishshas Isra7eele kawoteththay ba morkketa bolla halo kessana gakkanaas arshey eqqides. Aginaykka qaaxxabeekku. Hessika Yashaare Maxaafan xaafettides; arshey salos giddo addan eqqides; issi gallas kumeth arshey wullontta pe7ides.<note caller="-" style="x"><char style="xo" closed="false">10:13 </char><char style="xt" closed="false"><ref loc="2SA 1:18">2Same 1:18</ref></char></note> <verse eid="JOS 10:13" /><verse number="14" style="v" sid="JOS 10:14" />GODAY asa qaala siyida hessa mala gallassi hessafe kasekka guyekka hanibeenna. Tumukka GODAY Isra7eele gishshas olettides.<verse eid="JOS 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 10:15" />Hessafe guye Iyaasoynne Isra7eele olanchchati ubbay ba dunkaanidaso Gelgela simmida.<verse eid="JOS 10:15" /></para>
  <para style="s1">Amoore Kawota Ichchashata Hayqo</para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 10:16" />He wode Amooreta kawoti ichchashati baqati biidi Maqeedan gongolo giddon qotettida. <verse eid="JOS 10:16" /><verse number="17" style="v" sid="JOS 10:17" />Iyaasoykka ichchash kawoti Maqeedan gongolo giddon qotetti dizayssa siyides.<verse eid="JOS 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JOS 10:18" />Iyaasoy, «Gita shuchchata genderisi efidi gongoloza gordite; histtidi naagana zabeta heen woththite. <verse eid="JOS 10:18" /><verse number="19" style="v" sid="JOS 10:19" />Intte morkketa yedeththite attiin azallofte; istta kaalli kaalli meto gaththite; istti ba katamaa bi gelontta mala diggite; hekko GODAA intte Xoossay istta intte kushen aaththi immides» gides. <verse eid="JOS 10:19" /><verse number="20" style="v" sid="JOS 10:20" />Hessa gishshas Iyaasoynne Isra7eele asay istta mulera dippi histtida; isttafe attida guuththati kase ba diza gimbettida katamata simmi gelida. <verse eid="JOS 10:20" /><verse number="21" style="v" sid="JOS 10:21" />Hessafe guye asay ubbay saron simmidi Iyaasoy dunkaani dizaso Maqeeda yides; Isra7eele asaa bolla issi qaalakka haasayda asi deenna.<verse eid="JOS 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 10:22" />Iyaasoy isttas, «Gongoloza doydi he ichchash kawota kessidi taas haa ekki yiite» gides. <verse eid="JOS 10:22" /><verse number="23" style="v" sid="JOS 10:23" />Isttika he ichchash kawota Yerusalaame kawo, Kebroone kawo, Yarmuute kawo, Laakishe kawonne Egiloone kawo kessidi izakko ehida. <verse eid="JOS 10:23" /><verse number="24" style="v" sid="JOS 10:24" />Istti he kawota Iyaasokko ehiin Iyaasoy Isra7eele attuma asaa ubbaa baakko xeygidi banara diza ola gadawata, «Haa yiidi hayta kawota qoodhe bolla yedhdhi eqqite» gides. Isttika sinth aadhdhidi ba tohon kawota qoodhe bolla yedhdhi eqqida. <verse eid="JOS 10:24" /><verse number="25" style="v" sid="JOS 10:25" />Iyaasoykka isttas, «Babofte; dagammofte; minnitenne xalite; inttenara olettiza intte morkketa ubbata bolla GODAY hayssaththo ooththana» gides. <verse eid="JOS 10:25" /><verse number="26" style="v" sid="JOS 10:26" />Hessafe guye Iyaasoy ichchash kawota wodhidi ichchash miththa bolla istta ahaa kaqqides; omarsi gakkanaas istta ahay miththa bollafe wodhdhibeenna.<verse eid="JOS 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JOS 10:27" />Arshey wullana hanishin Iyaasoy azaziin miththaa bollafe kawota ahaa woththidi kase istti qotettida gongolozan efi yeggida. Histtidi gongoloza gita shuchchatan tuccida; he shuchchati hach gakkanaaska heen deettes.<verse eid="JOS 10:27" /></para>
  <para style="s1">Iyaasoy Xooni Oykkida Hara Katamata</para>
  <para style="p">
    <verse number="28" style="v" sid="JOS 10:28" />He gallas Iyaasoy Maqeeda katama oykkides; katamayonne izi kawoza giththa mashshan siifides; izi giddon diza asaappe issinokka ashshontta dishe dippi histtides; Iyarkko kawo bolla ooththidayssaththoka Maqeeda kawo bollaka ooththides.<verse eid="JOS 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JOS 10:29" />Hessafe guye Iyaasoynne izara diza Isra7eele asay ubbay Maqeedafe Libina biidi olida. <verse eid="JOS 10:29" /><verse number="30" style="v" sid="JOS 10:30" />GODAY he katamayonne izi kawoza Isra7eele asaa kushen aaththi immides; Iyaasoy katamayonne izi giddon diza ubbaa issinokka ashshontta giththa mashshan dippi histtides; Iyarkko kawo bolla ooththoyssaththoka Libina kawo bollaka ooththides.<verse eid="JOS 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JOS 10:31" />Hessafe guye Iyaasoynne izara diza Isra7eele asay ubbay Libinappe Laakishe bi dooddi olida. <verse eid="JOS 10:31" /><verse number="32" style="v" sid="JOS 10:32" />GODAY Laakishe Isra7eele asaa kushen aaththi immides; Iyaasoy he katamayo nam7anththo gallassan oykkides; izi Libinan ooththoyssaththoka hanno ha katamayonne izi giddon diza ubbaa giththa mashshan siifides. <verse eid="JOS 10:32" /><verse number="33" style="v" sid="JOS 10:33" />He wode Gezeere kawo Horaamey Laakishe kawo maaddanaas yides; gido attiin Iyaasoy izakka iza asaakka issino ashshontta ubbaa dippi histtides.<verse eid="JOS 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JOS 10:34" />Hessafe guye Iyaasoynne izara diza Isra7eele asay ubbay Laakisheppe Egiloone biidi he katamaa dooddi oykki olida. <verse eid="JOS 10:34" /><verse number="35" style="v" sid="JOS 10:35" />He gallas Egiloone oli oykkidi giththa mashshan dhayssida; kase Laakishen ooththida mala Egiloone katamaan diza asaa mulera dhayssida.<verse eid="JOS 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JOS 10:36" />Hessafe guye Iyaasoynne izara diza Isra7eele asa ubbay Egilooneppe kezi biidi Kebroone olida. <verse eid="JOS 10:36" /><verse number="37" style="v" sid="JOS 10:37" />He katamayonne katamay giddon diza miish ubbaa issinokka ashshontta giththa mashshan dippi histtida; kase Egiloonen ooththida mala hanno katamay giddon diza ubbaa mulera dippi histtida.<verse eid="JOS 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JOS 10:38" />Hessafe guye Iyaasoynne izara diza Isra7eele asay ubbay guye simmidi Dabire olida. <verse eid="JOS 10:38" /><verse number="39" style="v" sid="JOS 10:39" />Katamayonne izi kawoza, izi heeran diza qeeri katamatakka ubbaa giththa mashshan siifida; izi giddon dizayssafe issinokka ashshontta ubbaa dippi histtida; kase Libinaninne Libina kawo bolla ooththida mala, Kebroone bolla ooththoyssaththoka Dabire bollanne izi kawoza bolla ooththida.<verse eid="JOS 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JOS 10:40" />Hessaththoka Iyaasoy zumbullati dariza biittaa, Negebe, arshey wulliza baggara diza gadha biittanne zuma laddeta, biitta ubbaa kawotara gaththi oykkides. GODAA Isra7eele Xoossay azazida mala biittaa bolla shemppora diza ubbaa dippi histtides; aykkoka shemppora paxa ashshibeenna. <verse eid="JOS 10:40" /><verse number="41" style="v" sid="JOS 10:41" />Iyaasoy istta Qaadeese Barineppe biidi Gaaza gakkanaas, qasse Gooshene biittafe doommidi Geba7oone gakkanaas ubbaa xooni oykkides. <verse eid="JOS 10:41" /><verse number="42" style="v" sid="JOS 10:42" />Iyaasoy issito ola kezidi he kawotanne istta biitta ubbaa xoonides. Hessika haniday GODAA Isra7eele Xoossay ba deraas olettida gishshassa. <verse eid="JOS 10:42" /><verse number="43" style="v" sid="JOS 10:43" />Hessafe guye Iyaasoynne Isra7eele asay ubbay ba dunkaanidaso Gelgela simmides.<verse eid="JOS 10:43" /></para>
  <chapter eid="JOS 10" />
  <chapter number="11" style="c" sid="JOS 11" />
  <para style="s1">Pudeha Bagga Kawota Xooneteth</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 11:1" />Haxoore kawo Yaabiney Isra7eele asay xoonidayssa siyida wode, Meedoone kawo Yobaabes, Shimiroone katamaas, Akishaafe kawos kiita yeddides. <verse eid="JOS 11:1" /><verse number="2" style="v" sid="JOS 11:2" />Hessaththoka pudeha baggara shaara menththon diza kawotas, dugeha baggan Arabe kawotas, arshey wulliza baggara diza gadha kawotassinne arshey wulliza baggara Doore zuman diza kawotas kiittides. <verse eid="JOS 11:2" /><verse number="3" style="v" sid="JOS 11:3" />Qasse arshey keziza baggaranne wulliza baggara diza Kanaanetas, Amooretas, Hiitetas, Paarizetas, shaara menththon diza Yaabusetassinne Mixiphpha biittan Hermoone zumaappe garsa baggara diza Hiiwe kawotas kiittides. <verse eid="JOS 11:3" /><verse number="4" style="v" sid="JOS 11:4" />Histtiin istti ba olanchchata ubbaa denththidi daro paratanne para-gaareta issife Isra7eele olanaas ekki yida. Isttas qooday abba doonan diza ancco mala cora. <verse eid="JOS 11:4" /><verse number="5" style="v" sid="JOS 11:5" />He kawoti wuri issife ba wolqqa minththidi Isra7eele olanaas Meroome haaththaa matan dunkaanida.<verse eid="JOS 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 11:6" />GODAY Iyaasos, «Neni isttas babbofa! Tani wonto hanni wode istta ubbaa hayqqida asa mala histta Isra7eele kushen aaththa immana. Neni istta parata ubbaa gildayana; istta para-gaaretakka taman xuuggana» gides.<verse eid="JOS 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 11:7" />Histtiin Iyaasoynne iza olanchchati ubbay istti qoppontta dishin Meroome haaththaa matan istta bolla puttu giidi istta olida. <verse eid="JOS 11:7" /><verse number="8" style="v" sid="JOS 11:8" />GODAY istta Isra7eeleta kushen aaththi immides; histtiin Isra7eeleti istta xoonidi gita Sidoona biitta efiza ogera, Masirafoote-Mayma gakkanaas qasseka arshey mokkiza baggara Mixiphpha shoobbaa gakkanaas yedeththida. Isttafe issi asikka shemppora paxa attibeenna. <verse eid="JOS 11:8" /><verse number="9" style="v" sid="JOS 11:9" />Iyaasoy GODAY iza azazidayssa ubbaa istta bolla polides; istta paratakka gildaydes; istta para-gaaretakka taman xuuggides.<verse eid="JOS 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 11:10" />He wode Iyaasoy guye simmidi Haxoore katamaa oykkides; he katamaa kawozakka giththa mashshan siifides; Haxoore katamaas he wode diza kawoteththata ubbaa bolla alaafeteththi dees. <verse eid="JOS 11:10" /><verse number="11" style="v" sid="JOS 11:11" />He katamaan diza asaa ubbaa giththa mashshan siifida; shemppora paxa diza ubbaa issinokka ashshontta wodhida; katamayokka taman xuuggida.<verse eid="JOS 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 11:12" />GODAA aylle Musey azazida mala Iyaasoy he katamatanne istta kawota ubbaa dhayssides; giththa mashshankka siifides. <verse eid="JOS 11:12" /><verse number="13" style="v" sid="JOS 11:13" />Gidikkoka Iyaasoy Haxoore katamaa xuuggoyssafe attiin Isra7eele asay zumata bolla keexettida katamata xuuggibeenna. <verse eid="JOS 11:13" /><verse number="14" style="v" sid="JOS 11:14" />Isra7eele asay he katamatappe bonqqida miish ubbaanne mehe ubbaa banttas ekkida; gido attiin asaa giththa mashshan dhayssida; shemppora paxa dizaa issinokka ashshibeettenna. <verse eid="JOS 11:14" /><verse number="15" style="v" sid="JOS 11:15" />GODAY ba aylle Muse azazida mala Museykka Iyaaso azazides. Histtiin Iyaasoykka azazoza polides; GODAY Muses azazida ubbaafe izi ooththontta aggida ay miishshika deenna.<verse eid="JOS 11:15" /></para>
  <para style="s1">Iyaasoy Oykkida Biitta</para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 11:16" />Hessaththo histtidi Iyaasoy he biitta ubbaa gezze biitta, Negebe biitta, Gooshene biitta, arshey wullizaso baggara diza gadhanne Arabe biitta qasseka Isra7eele gezzenne gadha ubbaa shiishshi oykkides. <verse eid="JOS 11:16" /><verse number="17" style="v" sid="JOS 11:17" />Hessika Seyre gakkanaas diza Halaaqe zumaappe biidi Hermoone zumaappe dan7e baggara Libaanoose zullen Ba7aali-Gaade gakkanaas diza biitta ubbaa gakkides. Istta kawotakka ubbaa oykkidi wodhides. <verse eid="JOS 11:17" /><verse number="18" style="v" sid="JOS 11:18" />Iyaasoy daro wode he kawota ubbaara olettishe gam7ides. <verse eid="JOS 11:18" /><verse number="19" style="v" sid="JOS 11:19" />Geba7oonen diza Hiiwetappe attiin hara katamay issoynne Isra7eeletara saroteththan de7ana caaqettibeenna; Isra7eeleti ubbatakka oli oykkida. <verse eid="JOS 11:19" /><verse number="20" style="v" sid="JOS 11:20" />GODAY Muse azazida mala Iyaasoy isttas qadhettontta ubbaa wodhides. Gaasoykka istti Isra7eeletara olettana mala GODAY istta wozina dammisides.<note caller="-" style="x"><char style="xo" closed="false">11:20 </char><char style="xt" closed="false"><ref loc="DEU 7:16">Zaare 7:16</ref></char></note><verse eid="JOS 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 11:21" />He wode Iyaasoy biidi, gezze biittan Kebroone katamaan, Dabire katamaan, Anaabe katamaan, Yuhudaninne Isra7eele gezze biitta ubbaan diza Enaaqe zareta ubbaanne istta katama ubbaa dhayssides. <verse eid="JOS 11:21" /><verse number="22" style="v" sid="JOS 11:22" />Isttafe guuththati xalla Gaazan, Geeteninne Ashdooden attida; gido attiin Isra7eelen shemppora paxa attida Enaaqe zereththi deenna. <verse eid="JOS 11:22" /><verse number="23" style="v" sid="JOS 11:23" />GODAY Muse azazida mala Iyaasoy biitta ubbaa oykkides; histtidi Isra7eele asaas istta qommon qommon shaakki immides; hessafe guye biittay olappe shempides.<verse eid="JOS 11:23" /></para>
  <chapter eid="JOS 11" />
  <chapter number="12" style="c" sid="JOS 12" />
  <para style="s1">Museynne Iyaasoy Xoonida Kawota</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 12:1" />Isra7eele asay Yordaanoose shaafaappe arshey mokkiza baggara diza Arabe biitta ubbaa oykkidi Arnoone zullera biidi Hermoone zumaa gakkanaas diza he dere kawota xoonidi woththi ekkides. He xoonettida kawoti hayssafe kaalli xaafettidayta.<verse eid="JOS 12:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JOS 12:2" />Haseboone katamaan uttidi ayssiza Amooreta kawoy Sihoone. Izi Arnoone shoobbaa lanqen diza Aaro7eere zullera kanththi biidi Amooneta zawaa Yaabooqe shaafaa gakkanaas haarides; hessi Gala7aade biittaafe baggaa gujji ekkees. <verse eid="JOS 12:2" /><verse number="3" style="v" sid="JOS 12:3" />Qasseka arshey mokkiza baggara Yordaanoose shoobbafe biidi Galila abbaa gakkanaas, Beeti-Yashimoote baggara biidi maxine abbaafe dugeha baggara diza Pizga zumaas dan7e bagga gakkanaas dizasoza haarides.<verse eid="JOS 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 12:4" />Astarooteninne Edira7en uttidi haariza Erafayme zereththatappe wurseththa bolla kawotidayta Baasaane kawo Aage. <verse eid="JOS 12:4" /><verse number="5" style="v" sid="JOS 12:5" />Izi Hermoone zumaa, Salaaka, Baasaane biitta ubbaa, biidi Geeshuretanne Ma7ikate zawa gakkanaas, qasseka Gala7aade biittafe baggaa ekki biidi Haseboone kawo Sihoone zawa gakkanaas haarides.<note caller="-" style="x"><char style="xo" closed="false">12:1-5 </char><char style="xt" closed="false"><ref loc="NUM 21:21-35">Tay 21:21-35</ref>; <ref loc="DEU 2:26-3:11">Zaare 2:26—3:11</ref></char></note><verse eid="JOS 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 12:6" />GODAA ashkara Museynne Isra7eele asay ha kawota xoonida; histtidi GODAA aylle Musey istta biittaa Oroobeele qommotas, Gaade qommotassinne Minaase qommotappe baggaytas xinxxo gidana mala shaakki immides.<note caller="-" style="x"><char style="xo" closed="false">12:6 </char><char style="xt" closed="false"><ref loc="NUM 32:33">Tay 32:33</ref>; <ref loc="DEU 3:12">Zaare 3:12</ref></char></note><verse eid="JOS 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 12:7" />Iyaasoynne Isra7eele asay Yordaanoose shaafappe arshey wulliza baggan diza kawota ubbaa xoonida. Heyti haariza zaway Libaanoose shoobban diza Ba7aali-Gaadeppe doommidi Seyren Halaaqe zumaa gakkees; Iyaasoy he biittata shaakkidi Isra7eele qommotas xinxxo histti immides. <verse eid="JOS 12:7" /><verse number="8" style="v" sid="JOS 12:8" />He biittati, gezze dere, arshey wullizaso baggan diza zumbullata ladde, Arabe zumata ladde, bazzo biittanne Negebe biitta. He biittati kase Hiiteti, Amooreti, Kanaaneti, Paarizeti, Hiiwetinne Yaabuseti de7iza biitta. <verse eid="JOS 12:8" /><verse number="9" style="v" sid="JOS 12:9" />Isra7eele asay xoonida kawoti hayssafe kaalli dizayta; Iyarkko kawo, Beetele matan diza Aye kawo, <verse eid="JOS 12:9" /><verse number="10" style="v" sid="JOS 12:10" />Yerusalaame kawo, Kebroone kawo, <verse eid="JOS 12:10" /><verse number="11" style="v" sid="JOS 12:11" />Yarmuute kawo, Laakishe kawo, <verse eid="JOS 12:11" /><verse number="12" style="v" sid="JOS 12:12" />Egiloone kawo, Gezeere kawo, <verse eid="JOS 12:12" /><verse number="13" style="v" sid="JOS 12:13" />Dabire kawo, Beeti-Gadera kawo, <verse eid="JOS 12:13" /><verse number="14" style="v" sid="JOS 12:14" />Horma kawo, Araade kawo, <verse eid="JOS 12:14" /><verse number="15" style="v" sid="JOS 12:15" />Libina kawo, Adulaame kawo, <verse eid="JOS 12:15" /><verse number="16" style="v" sid="JOS 12:16" />Maqeeda kawo, Beetele kawo, <verse eid="JOS 12:16" /><verse number="17" style="v" sid="JOS 12:17" />Taaphphuhe kawo, Hefeere kawo, <verse eid="JOS 12:17" /><verse number="18" style="v" sid="JOS 12:18" />Afeeqe kawo, Lasharoone kawo, <verse eid="JOS 12:18" /><verse number="19" style="v" sid="JOS 12:19" />Meedoone kawo, Haxoore kawo, <verse eid="JOS 12:19" /><verse number="20" style="v" sid="JOS 12:20" />Shimiroone-Miroone kawo, Akishaafe kawo, <verse eid="JOS 12:20" /><verse number="21" style="v" sid="JOS 12:21" />Ta7inaake kawo, Magiddo kawo, <verse eid="JOS 12:21" /><verse number="22" style="v" sid="JOS 12:22" />Qaadeese kawo, Qarmeloosen diza Yoqina7aame kawo, <verse eid="JOS 12:22" /><verse number="23" style="v" sid="JOS 12:23" />Zumbullata bolla diza Doore kawo, Gelgelan diza Goyme kawo, <verse eid="JOS 12:23" /><verse number="24" style="v" sid="JOS 12:24" />Tirxxa kawo. Heyti issi bolla 31 kawota.<verse eid="JOS 12:24" /></para>
  <chapter eid="JOS 12" />
  <chapter number="13" style="c" sid="JOS 13" />
  <para style="s1">Buro Oykettibeenna Biittata</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 13:1" />Iyaasoy cimmiin izas layththay keehi bida wode GODAY, «Neni keeha cimadasa; layththayka nees keehi bides; gido attiin buro oykettontta daro biittay dees. <verse eid="JOS 13:1" /><verse number="2" style="v" sid="JOS 13:2" />Buro oykettibeenna biittati hayta; Filisxeemeta biittanne Geeshureta biitta ubbata, <verse eid="JOS 13:2" /><verse number="3" style="v" sid="JOS 13:3" />Gibxeppe arshey mokkiza baggara diza Shihoore shaafaappe doommidi, pudeha baggara diza Aqaroone zawa gakkanaas diza biittati wuri Kanaane biitta mala qoodetteettes. Ichchash Filisxeeme kawoti haariza katamati Gaaza, Ashdoode, Asqeloona, Geetenne Aqaroone geetettizayta gidishin heytikka Aweta biitta. <verse eid="JOS 13:3" /><verse number="4" style="v" sid="JOS 13:4" />Dugeha baggara Kanaaneta biittay wuri, Sidoonatas diza Ma7aare geetettizasoppe doommi biidi Amooreta biittan diza Afeeqe katama gakkanaas, <verse eid="JOS 13:4" /><verse number="5" style="v" sid="JOS 13:5" />Gebaaleta biitta, arshey mokkiza baggara Ba7aali-Gaadeppe biidi Hermoone zumaas dan7e baggara aadhdhi biidi Hamaate purde gakkanaas diza Libaanoose biitta ubbaa.<verse eid="JOS 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 13:6" />«Libaanooseppe biidi Masirafoote-Mayman diza gezze deren Sidoonata biittayka oykettibeenna. Tani ta hu7es Isra7eele asaa sinththafe istta goodda kessana. Tani nena azazida mala neni ha biittata Isra7eele asaas xinxxo histta shaakka.<note caller="-" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false"><ref loc="NUM 33:54">Tay 33:54</ref></char></note> <verse eid="JOS 13:6" /><verse number="7" style="v" sid="JOS 13:7" />Neni ha biittaa uddufun qommotassinne Minaase qommotappe baggaytas gisha» gides.<verse eid="JOS 13:7" /></para>
  <para style="s1">Yordaanoose Shaafappe Arshey Mokkiza Baggara Diza Biittaa Gishereththo</para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 13:8" />Minaase qommotappe baggati, Oroobeele zaretinne Gaade zareti GODAA aylle Musey Yordaanoose shaafappe he pinththan arshey mokkizaso baggara isttas immida biitta ekkida.<note caller="-" style="x"><char style="xo" closed="false">13:8 </char><char style="xt" closed="false"><ref loc="NUM 32:33">Tay 32:33</ref>; <ref loc="DEU 3:12">Zaare 3:12</ref></char></note> <verse eid="JOS 13:8" /><verse number="9" style="v" sid="JOS 13:9" />Istta biittay Arnoone shoobbaa lanqen diza Aaro7eere katamappe doommidi he shoobbaa giddon diza katamaa oykkidi Medeba geetettiza gezze dere kanththi biidi Diboone gakkees. <verse eid="JOS 13:9" /><verse number="10" style="v" sid="JOS 13:10" />Qasse Haseboonen uttidi Amooneta zawa gakkanaas haarida Amooreta kawo Sihoone katamata ubbaa gaththi oykkees. <verse eid="JOS 13:10" /><verse number="11" style="v" sid="JOS 13:11" />Hessaththoka Gala7aade biitta, Geeshureta biitta, Ma7ikate biitta, Hermoone zuma ubbaa, Baasaane biitta biidi Salaaka gakkanaas oykkees. <verse eid="JOS 13:11" /><verse number="12" style="v" sid="JOS 13:12" />Hessika Astaroote katamaninne Edira7e katamaan dishe haarida Aage kawoteththaa ubbaa oykkees; Aagey wurshe attida Erafayme zaretappe issaa. Musey he asaa xooni gooddidi istta biittaa oykkides. <verse eid="JOS 13:12" /><verse number="13" style="v" sid="JOS 13:13" />Gido attiin Isra7eele asay Geeshure asaanne Ma7ikate asaa kessi gooddontta aggida gishshas istti hach gakkanaas Isra7eele asaa giddon deettes.<verse eid="JOS 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 13:14" />Musey Lewe qommotas xinxxo immibeenna; GODAY Muses gida mala, GODAAS Isra7eele Xoossaas taman xuugettiza yarshoy isttas xinxxo.<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="DEU 18:1">Zaare 18:1</ref></char></note><verse eid="JOS 13:14" /></para>
  <para style="s1">Oroobeele Qommota Gakkida Xinxxo</para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 13:15" />Musey Oroobeele qommotas istta zarkken zarkken gishereththi immida biittay hayssafe kaalli dizayssa. <verse eid="JOS 13:15" /><verse number="16" style="v" sid="JOS 13:16" />Istta zaway Arnoone shoobbaa lanqen diza Aaro7eere katamaappenne he shoobbaa giddon diza katamaa oykkidi, Medeba gezze dere kanththi biidi, <verse eid="JOS 13:16" /><verse number="17" style="v" sid="JOS 13:17" />Haseboonenne gezze deren diza katamata ubbaa, qasse Diboone, Bamooti Ba7aale, Beeti-Ba7aali-Me7oone, <verse eid="JOS 13:17" /><verse number="18" style="v" sid="JOS 13:18" />Yahaaxe, Qidimoote, Mefa7aate, <verse eid="JOS 13:18" /><verse number="19" style="v" sid="JOS 13:19" />Qiriyaatayme, Seebama shoobbaa giddon diza zumbullaa bolla diza Xerete-Shahaare, <verse eid="JOS 13:19" /><verse number="20" style="v" sid="JOS 13:20" />Beeti-Pe7oore, Pizga dugunththatanne Beeti-Yashimoote. <verse eid="JOS 13:20" /><verse number="21" style="v" sid="JOS 13:21" />Hessika gezze biittan diza katamata ubbaanne Haseboone katamaan uttidi haarida Amooreta kawo Sihoone biitta ubbaa oykkees. Musey kawo Sihoonenne he biittan diza daannata, Eewa, Ereqeeme, Xuure, Uurenne Ereba7e geetettiza Midiyaame halaqata oli xoonides. <verse eid="JOS 13:21" /><verse number="22" style="v" sid="JOS 13:22" />Isra7eele asay olan wodhida asaappe hara, Bi7oore naa maro Balaamekka mashshan siifida. <verse eid="JOS 13:22" /><verse number="23" style="v" sid="JOS 13:23" />Oroobeele qommota zaway Yordaanoose shaafa. Oroobeele qommoti ba zarkken zarkken gishetti ekkida katamatinne gutati heyta.<verse eid="JOS 13:23" /></para>
  <para style="s1">Gaade Qommota Gakkida Xinxxo</para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 13:24" />Musey Gaade qommotas istta zarkken zarkken gishereththi immida biittay hayssafe kaalli dizayssa. <verse eid="JOS 13:24" /><verse number="25" style="v" sid="JOS 13:25" />Istta zaway Iyaazeere, Gala7aade katamata ubbaa Eraaba achchan diza Aaro7eere gakkanaas diza Amooneta biittafe baggaa, <verse eid="JOS 13:25" /><verse number="26" style="v" sid="JOS 13:26" />Hasebooneppe biidi Eramoote-Mixiphphanne Bexoniime, Mahanaymeppe biidi Dabaare zawaa, <verse eid="JOS 13:26" /><verse number="27" style="v" sid="JOS 13:27" />arshey mokkiza baggara diza Yordaanoose shoobbaas giddon Haseboone kawo Sihoone kawoteththafe attidayta, Beeti-Haraame, Beeti-Niimire, Sukootenne Xafoone geetettiza katamata issife gaththi oykkees. <verse eid="JOS 13:27" /><verse number="28" style="v" sid="JOS 13:28" />Gaade qommoti ba zarkken zarkken gishetti ekkida katamatinne gutati heyta.<verse eid="JOS 13:28" /></para>
  <para style="s1">Minaase Qommotappe Baggaytas Gakkida Xinxxo</para>
  <para style="p">
    <verse number="29" style="v" sid="JOS 13:29" />Musey Minaase qommotappe baggaytas istta zarkken zarkken gishereththi immida biittay hayssafe kaalli dizayssa. <verse eid="JOS 13:29" /><verse number="30" style="v" sid="JOS 13:30" />Istta zaway Mahanaymeppe doommidi Baasaane biitta ubbaa gujjidi Baasaanen diza 60 Ya7ire katamata ubbaa ekkidi Baasaane kawo Aagey haarizaso ubbaa gidishin, <verse eid="JOS 13:30" /><verse number="31" style="v" sid="JOS 13:31" />Gala7aadeppe baggaanne Baasaanen Aage kawoteththaas waanna katamata Astarootenne Edira7e gakkees. Heyti Minaase naa Maakire zaretas imettidayta gidishin heytikka Maakire naytappe baggaytas istta zarkken zarkken imettidayta.<verse eid="JOS 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 13:32" />Yordaanooseppe he pinththan, Iyarkkofe arshey mokkiza baggara diza Mo7aabe demban diza wode Musey shaakkidi immida biittay hessa. <verse eid="JOS 13:32" /><verse number="33" style="v" sid="JOS 13:33" />Gido attiin Musey Lewe qommotas xinxxo immibeenna; kase GODAA Isra7eele Xoossay isttas yootida mala izi istta xinxxo.<note caller="-" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="NUM 18:20">Tay 18:20</ref>; <ref loc="DEU 18:2">Zaare 18:2</ref></char></note><verse eid="JOS 13:33" /></para>
  <chapter eid="JOS 13" />
  <chapter number="14" style="c" sid="JOS 14" />
  <para style="s1">Yordaanoose Shaafappe Arshey Wullizaso Bagga Biitta Gishechcho</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 14:1" />Qeese El7ezeerey, Nawe naa Iyaasoynne Isra7eele zareta korapinneti gishechchi immiin Isra7eele asay gishetti ekkidi laattida biittay hayssafe kaallizayssa. <verse eid="JOS 14:1" /><verse number="2" style="v" sid="JOS 14:2" />GODAY Muse baggara azazida mala istti gishetti ekkida biittay uddufun qommotassinne baggaytas saaman gakkides.<note caller="-" style="x"><char style="xo" closed="false">14:2 </char><char style="xt" closed="false"><ref loc="NUM 26:52-56">Tay 26:52-56</ref>; <ref loc="NUM 34:13">34:13</ref></char></note> <verse eid="JOS 14:2" /><verse number="3" style="v" sid="JOS 14:3" />Musey nam7u qommotassinne baggatas Yordaanoose shaafappe he pinththan arshey mokkiza baggara diza gadeza isttas xinxxo histti immides; gido attiin Lewe qommotas istta giddon xinxxo immibeenna.<note caller="-" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="NUM 32:33">Tay 32:33</ref>; <ref loc="NUM 34:14-15">34:14-15</ref>; <ref loc="DEU 3:12-17">Zaare 3:12-17</ref></char></note> <verse eid="JOS 14:3" /><verse number="4" style="v" sid="JOS 14:4" />Yooseefe nayti Minaasenne Efreeme geetettidi nam7u zarkke gidida. Musey Lewe qommotas laata biitta immibeenna; gido attiin Lewe qommotas istti diza katamatanne istti ba mehenne dorsa heemmizasoho xalla attiin hara gadey isttas imettibeenna. <verse eid="JOS 14:4" /><verse number="5" style="v" sid="JOS 14:5" />Hessa gishshas GODAY Muse azazida mala Isra7eele asay biittaa gishetti ekkida.<verse eid="JOS 14:5" /></para>
  <para style="s1">Kaalebes Imettida Kebroone Biitta</para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 14:6" />Issi gallas Yuhuda asay Iyaasokko Gelgela shiiqides; isttafe Qenaaze dere as Yoofine naa Kaalebey Iyaasos, «Nuni Qaadeese Barinen dishin GODAA as Muses ne gishshassinne ta gishshas yootidayssa ne eraasa.<note caller="-" style="x"><char style="xo" closed="false">14:6 </char><char style="xt" closed="false"><ref loc="NUM 14:30">Tay 14:30</ref></char></note> <verse eid="JOS 14:6" /><verse number="7" style="v" sid="JOS 14:7" />GODAA aylle Musey biittayo wochchada yaana mala Qaadeese Barineppe tana kiittiza wode taas layththay 40. He wode tani izas ammanththiza yo7o ekka yadis.<note caller="-" style="x"><char style="xo" closed="false">14:7 </char><char style="xt" closed="false"><ref loc="NUM 13:1-30">Tay 13:1-30</ref></char></note> <verse eid="JOS 14:7" /><verse number="8" style="v" sid="JOS 14:8" />Tanara bida asati deraa wozina hirgan kunththida; tani gidikko GODAA ta Xoossaa kumeththa wozinappe kaalladis. <verse eid="JOS 14:8" /><verse number="9" style="v" sid="JOS 14:9" />He gallas Musey, ‹Neni GODAA ta Xoossaa kumeththa wozinappe kaallida gishshas ne tohoy yedhdhida biittay mernaas neessinne ne zereththas laata biitta gidana› giidi taas caaqqides.<note caller="-" style="x"><char style="xo" closed="false">14:9 </char><char style="xt" closed="false"><ref loc="NUM 14:24">Tay 14:24</ref></char></note><verse eid="JOS 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 14:10" />«GODAY ha yo7oza Muses yootoosoppe doommidi Isra7eele asay bazzo biittan toylattishin tana 45 layth naagidi shemppora paxa woththides; ha7i ta layththay 85 gidides. <verse eid="JOS 14:10" /><verse number="11" style="v" sid="JOS 14:11" />Gidikkoka ha7i taas diza minoteththay beni Musey tana kiittiza wode diza minoteththaa mala. Taas ha7ikka olettana baanaas beni wolqqaynne minoteththi dees. <verse eid="JOS 14:11" /><verse number="12" style="v" sid="JOS 14:12" />Hessa gishshas GODAY taas immana gida ha gezze biittaa ha7i taas imma. He wode Enaaqeti he biittaan dizayssanne istta katamatikka gitanne gimbettidayta gididayssa ne siyadasa; gido attiin GODAY tanara gidikko izi gida mala tani istta he biittafe yedeththana» gides.<verse eid="JOS 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 14:13" />Hessafe guye Iyaasoy Yoofine naa Kaalebe anjjidi Kebroone izas xinxxo histti immides. <verse eid="JOS 14:13" /><verse number="14" style="v" sid="JOS 14:14" />GODAA Isra7eele Xoossaa izi kumeththa wozinappe kaallida gishshas he gallassafe doommidi Kebrooney Qenaaze dere as Yoofine naa Kaalebes xinxxo gidides. <verse eid="JOS 14:14" /><verse number="15" style="v" sid="JOS 14:15" />Kebrooney kase Enaaqeta ubbaafe bayra gidida Arba7e sunththan Qiriyaate-Arba7e geetetta xeygettadus.</para>
  <para style="p" vid="JOS 14:15">Hessafe guye he biittaya olappe shempadus.<verse eid="JOS 14:15" /></para>
  <chapter eid="JOS 14" />
  <chapter number="15" style="c" sid="JOS 15" />
  <para style="s1">Gishon Yuhuda Qommota Gakkida Gade</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 15:1" />Yuhuda qommotas istta zarkken zarkken saama yeggiin gakkida gadey biidi Eedoomera zawatidi, dugeha bagga gaxan diza Xiine geetettiza bazzo gakkees. <verse eid="JOS 15:1" /><verse number="2" style="v" sid="JOS 15:2" />Dugeha baggara istta zaway Maxine abbaas dugeha bagga xeerappe doommees. <verse eid="JOS 15:2" /><verse number="3" style="v" sid="JOS 15:3" />Akirabime purdera kanththidi, Xiine bazzora biidi Qaadeese Barine dugeha bagga gakkees. Qasse hessafe Hexiroomera kanththi pude Adaare gakkidi Qarqqaako simmees. <verse eid="JOS 15:3" /><verse number="4" style="v" sid="JOS 15:4" />Aximoonera kanththi biidi haaththi baynda Gibxe shaafan gakkidi Mediteraane abban zawatees. Dugeha baggara diza Yuhuda zaway hayssa.<verse eid="JOS 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 15:5" />Arshey mokkizaso baggara diza zaway Maxine abba gidishin hessika Yordaanoose shaafay izan bi gelizaso gakkees.</para>
  <para style="p" vid="JOS 15:5">Pudeha baggara diza zaway Yordaanoose shaafay Maxine abban gelizasoppe doommidi, <verse eid="JOS 15:5" /><verse number="6" style="v" sid="JOS 15:6" />pude Beeti-Hoogile kezidi Yordaanoose shoobbafe ganna baggara kanththidi Oroobeele naa Bohaane shuchchaan zawatees. <verse eid="JOS 15:6" /><verse number="7" style="v" sid="JOS 15:7" />Histtidi zawazi Akoore shoobbafe Dabire katama pude kezidi, shoobbafe duge baggara diza Adumime purdefe sinththara kanththidi pudeha bagga Gelgelakko simmees. Qasse En-Shemishe geetettiza pulttozara kanththi biidi pude En-Roogeele geetettizaso kezees. <verse eid="JOS 15:7" /><verse number="8" style="v" sid="JOS 15:8" />Hessafe Henoome naa shoobbara kanththi biidi Yaabuseta katama Yerusalaamey dizaso dugeha baggara kanththidi Erafayme shoobbaas pudeha bagga xeerara kanththi biidi Henoome shoobbaas arshey wulliza baggara diza zumbulla xeera gakkees. <verse eid="JOS 15:8" /><verse number="9" style="v" sid="JOS 15:9" />Heeppeka zumbullaa xeerappe doommidi Nefto pulttotara kanththidi Efroone deren diza katamatakko gakkees. Hessafe qasse duge Ba7aala woykko Qiriyaate-Yi7aarime geetettiza katamaakko wodhdhees; <verse eid="JOS 15:9" /><verse number="10" style="v" sid="JOS 15:10" />Ba7aalappe arshey wulliza baggara diza Seyre zumaakko mirqqettidi Kisaloone geetetti xeygettiza Yi7aarime zumbullas pudeha baggara diza dugunththaara duge Beeti-Shemishe wodhdhidi Temina pinnees. <verse eid="JOS 15:10" /><verse number="11" style="v" sid="JOS 15:11" />Qasse Aqaroones pudeha baggara diza dugunththaara kanththidi Shikaroonekko mirqqettidi Ba7aala zuma bollara aadhdhi biidi Yaabin7eele gakkees; hessafe guye zaway biidi abbaan eqqees.<verse eid="JOS 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 15:12" />Arshey wulliza baggara diza zaway Mediteraane abbaa gaxa gakkees. Yuhuda qommoti ba zarkken zarkken ekkida zawati haytantta.<verse eid="JOS 15:12" /></para>
  <para style="s1">Kaalebey Xooni Oykkida Kebroonenne Dabire Biitta</para>
  <para style="r">(<ref loc="JDG 1:11-15">Daanna 1:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 15:13" />GODAY iza azazida mala Iyaasoy Yuhuda gishaappe shaakkidi Kebroone geetettizaaro Qiriyaate-Arba7e Yoofine naa Kaalebes immides; Arba7ey Enaaqe Aawa. <verse eid="JOS 15:13" /><verse number="14" style="v" sid="JOS 15:14" />Kaalebeykka Enaaqe zare heedzdzata, Shashaye, Ahimaanenne Talimaye Kebrooneppe kessi gooddides.<note caller="-" style="x"><char style="xo" closed="false">15:13-14 </char><char style="xt" closed="false"><ref loc="JDG 1:20">Daanna 1:20</ref></char></note> <verse eid="JOS 15:14" /><verse number="15" style="v" sid="JOS 15:15" />Hessafe guye Dabire dere bolla olas dendides; Dabire katamay kase Qiriyaate-Sefere geetettawus. <verse eid="JOS 15:15" /><verse number="16" style="v" sid="JOS 15:16" />Kaalebey, «Qiriyaate-Sefere olidi oykkizaades tani ta nayo Akisa immana» gides. <verse eid="JOS 15:16" /><verse number="17" style="v" sid="JOS 15:17" />Hessa gishshas Kaalebe isha Qenaaze naa Otin7eeley he katamaa olidi oykkides; histtiin Kaalebey ba nayo izas machcho immides.<verse eid="JOS 15:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JOS 15:18" />Akisay Otin7eele gelidaappe guye izi aaway izis gade immana mala ba aawaa woossana mala ba azinaas minththa yootadus; iza hareza bollafe wodhdhiin Kaalebey izo, «Ta nees ay ooththana mala koyay?» gi oychchides.<verse eid="JOS 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOS 15:19" />Izakka zaarada, «Taas lo7o ooththarkkii! Neni kase taas Negeben gade immidayssaththo ha7ikka pultto haaththara diza gade taas imma» gadus. Histtiin Kaalebey izis puderanne dugera diza pultto immides.<verse eid="JOS 15:19" /></para>
  <para style="s1">Yuhuda Qommotas Imettida Xinxxo</para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 15:20" />Yuhuda qommotas istta zarkken zarkken gishshas immida biittay hayssafe kaalli dizayssa. <verse eid="JOS 15:20" /><verse number="21" style="v" sid="JOS 15:21" />Negebe heeran Eedoome zawa xeeran diza dugeha baggara diza Yuhuda qommota katamati Qabxi7eele, Edeere, Yaagure, <verse eid="JOS 15:21" /><verse number="22" style="v" sid="JOS 15:22" />Qiina, Dimoona, Adaada, <verse eid="JOS 15:22" /><verse number="23" style="v" sid="JOS 15:23" />Qaadeese, Haxoore, Yutinaane, <verse eid="JOS 15:23" /><verse number="24" style="v" sid="JOS 15:24" />Ziife, Teleme, Ba7aaloote, <verse eid="JOS 15:24" /><verse number="25" style="v" sid="JOS 15:25" />Haxoore-Hadaata, Hexiroome geetettiza Qiriyaate-Haxoore, <verse eid="JOS 15:25" /><verse number="26" style="v" sid="JOS 15:26" />Amaame, Shema7e, Molaade, <verse eid="JOS 15:26" /><verse number="27" style="v" sid="JOS 15:27" />Haxaare-Gaada, Heshmoone, Beeti-Phaleexe, <verse eid="JOS 15:27" /><verse number="28" style="v" sid="JOS 15:28" />Haxaare-Shu7aale, Bersaabehe, Biziyootiya, <verse eid="JOS 15:28" /><verse number="29" style="v" sid="JOS 15:29" />Ba7aala, Iyume, Exeeme, <verse eid="JOS 15:29" /><verse number="30" style="v" sid="JOS 15:30" />Elttolaade, Kisile, Horma, <verse eid="JOS 15:30" /><verse number="31" style="v" sid="JOS 15:31" />Xigilaage, Madimaana, Sanssaana, <verse eid="JOS 15:31" /><verse number="32" style="v" sid="JOS 15:32" />Lebawoote, Shilihiime, Ayinenne Armoone. Katamatinne gutati issi bolla nam7u tammanne uddufuna.<verse eid="JOS 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JOS 15:33" />Arshey wulliza baggara zumbullata tohosora dizayti Eshtta7oole, Xora7a, Ashina, <verse eid="JOS 15:33" /><verse number="34" style="v" sid="JOS 15:34" />Zaanohe, En-Gaanime, Taaphphuhe, Enaame, <verse eid="JOS 15:34" /><verse number="35" style="v" sid="JOS 15:35" />Yarmuute, Adulaame, Sooko, Azeeqe, <verse eid="JOS 15:35" /><verse number="36" style="v" sid="JOS 15:36" />Shaa7irayme, Aditayme, Gadeerenne Gaderootayme. Katamatinne gutati issi bolla tammanne oydda.<verse eid="JOS 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JOS 15:37" />Qasse Xinaane, Hadasha, Migidaala-Gaade, <verse eid="JOS 15:37" /><verse number="38" style="v" sid="JOS 15:38" />Dil7aane, Mixiphpha, Yoqiti7eele, <verse eid="JOS 15:38" /><verse number="39" style="v" sid="JOS 15:39" />Laakishe, Boxiqaate, Egiloone, <verse eid="JOS 15:39" /><verse number="40" style="v" sid="JOS 15:40" />Kaboone, Lahimaase, Kitiliishe, <verse eid="JOS 15:40" /><verse number="41" style="v" sid="JOS 15:41" />Gaderoote, Beeti-Daagone, Naa7imanne Maqeeda. Katamatinne gutati issi bolla tammanne usuppuna.<verse eid="JOS 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JOS 15:42" />Qasse Libina, Eteere, Ashaane, <verse eid="JOS 15:42" /><verse number="43" style="v" sid="JOS 15:43" />Yoftahe, Ashina, Nixibe, <verse eid="JOS 15:43" /><verse number="44" style="v" sid="JOS 15:44" />Qi7ila, Akiziibenne Mareesha. Katamatinne gutati issi bolla uddufuna.<verse eid="JOS 15:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JOS 15:45" />Aqarooney ba heeran diza gutatara, <verse eid="JOS 15:45" /><verse number="46" style="v" sid="JOS 15:46" />hessaththoka Aqarooneppe arshey wulliza baggara diza Ashdoode gakkanaas, <verse eid="JOS 15:46" /><verse number="47" style="v" sid="JOS 15:47" />qasse Ashdoodey ba heeran diza gutataranne Gaazappe biidi haaththi baynda Gibxe shaafa gakkanaassinne Mediteraane gaxappe haa simmiin diza katamatanne gutata.<verse eid="JOS 15:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JOS 15:48" />Zumbullata bolla diza katamatikka Shamire, Yetire, Sooko, <verse eid="JOS 15:48" /><verse number="49" style="v" sid="JOS 15:49" />Daanna, Qiriyaate-Siina woykko Dabire, <verse eid="JOS 15:49" /><verse number="50" style="v" sid="JOS 15:50" />Anaabe, Eshttamo, Aniime, <verse eid="JOS 15:50" /><verse number="51" style="v" sid="JOS 15:51" />Gooshene, Holoonenne Gilo; heyti tammanne issineti istta katamatanne istta gutata.<verse eid="JOS 15:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JOS 15:52" />Qasse Arabe, Duuma, Eshaane, <verse eid="JOS 15:52" /><verse number="53" style="v" sid="JOS 15:53" />Yaanime, Beeti-Taaphphuhe, Afeeqe, <verse eid="JOS 15:53" /><verse number="54" style="v" sid="JOS 15:54" />Humixa, Kebroone woykko Qiriyaate-Arba7enne Xi7oore; heyti uddufunati istta katamatanne istta gutata.<verse eid="JOS 15:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JOS 15:55" />Qasseka Ma7oone, Qarmeloose, Ziife, Yuuxa, <verse eid="JOS 15:55" /><verse number="56" style="v" sid="JOS 15:56" />Izra7eele, Yoqidi7aame, Zaanohe, <verse eid="JOS 15:56" /><verse number="57" style="v" sid="JOS 15:57" />Qayne, Gibi7anne Temina; heyti tammati istta katamatanne istta gutata.<verse eid="JOS 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JOS 15:58" />Qasse Halihuule, Beeti-Xuure, Gadoore, <verse eid="JOS 15:58" /><verse number="59" style="v" sid="JOS 15:59" />Maarate, Beeti-Anootenne Elttiqoone; heyti usuppunati istta katamatanne istta gutata.<verse eid="JOS 15:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="JOS 15:60" />Hessaththoka Qiriyaate-Yi7aarime geetettidaara Qiriyaate-Ba7aalenne Eraaba; heyti nam7ati istta katamatanne istta gutata.<verse eid="JOS 15:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JOS 15:61" />Bazzon dizayti hayssafe kaallizayta; Beeti-Arabe, Midiina, Sikaaka, <verse eid="JOS 15:61" /><verse number="62" style="v" sid="JOS 15:62" />Nibishaane, Maxine katamanne En-Gaade; heyti usuppunati istta katamatanne istta gutata.<verse eid="JOS 15:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="JOS 15:63" />Gido attiin Yuhuda asay Yerusalaamen diza Yaabuseta istti dizasoppe kessi gooddana dandaybeettenna; hessa gishshas Yaabuseti hach gakkanaaska Yuhuda asaara issife Yerusalaamen deettes.<note caller="-" style="x"><char style="xo" closed="false">15:63 </char><char style="xt" closed="false"><ref loc="JDG 1:21">Daanna 1:21</ref>; <ref loc="2SA 5:6">2Same 5:6</ref>; <ref loc="1CH 11:4">1Taari 11:4</ref></char></note><verse eid="JOS 15:63" /></para>
  <chapter eid="JOS 15" />
  <chapter number="16" style="c" sid="JOS 16" />
  <para style="s1">Yooseefe Qommota Gakkida Biitta</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 16:1" />Yooseefe zareta gakkida biittay Iyarkko matan Yordaanoose shaafappe doommidi Iyarkko pulttotappe arshey mokkiza baggara bazzo kanththidi gezzetiza biittara aadhdhidi Beetele gakkees. <verse eid="JOS 16:1" /><verse number="2" style="v" sid="JOS 16:2" />Looza geetettiza Beeteleppe dendidi Axaroote geetettiza Arkketa biitta gakkees. <verse eid="JOS 16:2" /><verse number="3" style="v" sid="JOS 16:3" />Hessafe arshey wulliza baggara diza Yaafaleexeta biitta dugunththaa duge Beeti-Horoone wodhdhidi Gezeerera kanththi biidi gita Abban gelees.<verse eid="JOS 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 16:4" />Yooseefe qommo Minaase zaretinne Efreeme zareti banttana gakkiza biittaa laattida.<verse eid="JOS 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 16:5" />Efreeme zareta istta zarkken zarkken gakkida biittay hayssafe kaallizayssa; istta zaway arshey mokkiza baggara diza Axaroote-Adaareppe biidi ganna Beeti-Horoone gakkees. <verse eid="JOS 16:5" /><verse number="6" style="v" sid="JOS 16:6" />Heeppe biidi wogga abbaan gelees. Qasse pudeha baggara diza zaway Mikimaataateppe arshey mokkizaso bagga Taanate-Shiilora mirqqetti simmidi, arshey mokkizaso baggara diza Yaanooke gakkees. <verse eid="JOS 16:6" /><verse number="7" style="v" sid="JOS 16:7" />Yaanookeppe duge Axarootenne Naarate dugunththaa wodhdhidi Iyarkkora kanththi biidi Yordaanoose shaafaan gelees. <verse eid="JOS 16:7" /><verse number="8" style="v" sid="JOS 16:8" />Zawazi Taaphphuheppe arshey wulliza baggara biidi Qaana shaafara wodhdhi biidi Mediteraane abban gelees. Efreeme zareti ba zarkken zarkken laattida biittay hayssa. <verse eid="JOS 16:8" /><verse number="9" style="v" sid="JOS 16:9" />Hessi Minaase zareta biittafe Efreeme zaretas immida katamatanne istta gutata ubbaa gaththi oykkides. <verse eid="JOS 16:9" /><verse number="10" style="v" sid="JOS 16:10" />Hayssi ubbay haniinkka Efreeme zareti Gezeere katamaan diza Kanaane asata kessi gooddibeettenna. Kanaane asati hach gakkanaas Efreeme zaretara issife deettes. Gido attiin Efreeme zareti istta wolqqara oosiseettes.<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="JDG 1:29">Daanna 1:29</ref></char></note><verse eid="JOS 16:10" /></para>
  <chapter eid="JOS 16" />
  <chapter number="17" style="c" sid="JOS 17" />
  <para style="s1">Minaase Qommota Gakkida Biitta</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 17:1" />Minaasey Yooseefes bayra naa gidida gishshas iza zareta saaman gakkida biittay hayssafe kaalli dizayssa; Minaases bayra naazi Maakirey Gala7aadeta aaway mino olanchcha gidida gishshas Gala7aadeynne Baasaaney izas gisha gidides. <verse eid="JOS 17:1" /><verse number="2" style="v" sid="JOS 17:2" />Hessa gishshas he biittazi hankko attida Minaase zaretas Abi7eezeres, Heleeqes, Asira7eeles, Seekeemes, Hefeeres, Shamidas imettides; Yooseefe naa Minaase zarkke gidida attumati hayssafe kaalli dizayta.<verse eid="JOS 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 17:3" />Xilofaadey Hefeere naa; Hefeerey Gala7aade naa; Gala7aadey Maakire naa; Maakirey Minaase naa. Xilofaades macca naytappe attiin attuma nay deenna; iza macca nayti Mahilo, No7o, Hogilo, Milkkonne Tirxxo geetetteettes. <verse eid="JOS 17:3" /><verse number="4" style="v" sid="JOS 17:4" />Istta qeese El7ezeerekko, Nawe naa Iyaasokkonne halaqataakko shiiqidi, «Nuni nu ishatara gade gishetti ekkana mala GODAY Muse azazides» gida. Hessa gishshas GODAY azazida mala Iyaasoy istta aawaa ishatassaranne isttasara gishechchi immides.<note caller="-" style="x"><char style="xo" closed="false">17:4 </char><char style="xt" closed="false"><ref loc="NUM 27:1-7">Tay 27:1-7</ref></char></note> <verse eid="JOS 17:4" /><verse number="5" style="v" sid="JOS 17:5" />Minaases Gala7aadeppenne Baasaaneppe harason tammu kezi gishettiza biittay Yordaanooseppe arshey mokkiza baggara dees. <verse eid="JOS 17:5" /><verse number="6" style="v" sid="JOS 17:6" />Minaase zaretappe macca naytikka attuma naytara issife biittaa gishetti ekkida gishshas Gala7aade biittay attida Minaase zaretas gidides.<verse eid="JOS 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 17:7" />Minaase zareta biittaa zaway Aaseere biittafe doommidi, Seekeemeppe arshey mokkiza baggara diza Mikimaataate gakkees. He zaway hessafe biidi dugeha baggara kanththidi En-Taaphphuhen diza derezakka gujjees. <verse eid="JOS 17:7" /><verse number="8" style="v" sid="JOS 17:8" />Taaphphuhe biittay Minaasessa; gido attiin Minaase zawan diza Taaphphuhe katamaya kase Efreeme zaretassa. <verse eid="JOS 17:8" /><verse number="9" style="v" sid="JOS 17:9" />Hessafe kaallidi iza zaway biidi Qaana shaafaan gelees. Minaase katamata giddon Efreeme katamatikka deettes; Gido attiin Minaase zaway Qaana shaafappe pudeha baggara biidi Mediteraane abban gelees. <verse eid="JOS 17:9" /><verse number="10" style="v" sid="JOS 17:10" />Dugeha baggara diza biittay Efreemessa; pudeha baggara diza biittay qasse Minaasessa. Minaase biitta zaway biidi Mediteraane abbaa gakkees; pudeha bagga zaway Aaseere gakkees; arshey mokkiza baggara diza zaway Yisakoore gakkees. <verse eid="JOS 17:10" /><verse number="11" style="v" sid="JOS 17:11" />Yisakoore biittaninne Aaseere biittan Beeti-Sha7aaney, Yibila7aamey, Doore asay, En-Doorey, Ta7inaakeynne Magiddoy ba yuushon gutatara issife Minaasessa; heedzdzanththozi Nafoote. <verse eid="JOS 17:11" /><verse number="12" style="v" sid="JOS 17:12" />Gido attiin Minaase zareti he katamata xooni oykkana dandaybeettenna. Gaasoykka Kanaane asay ba oykkida biittaa yeddoko gi murttida gishshassa. <verse eid="JOS 17:12" /><verse number="13" style="v" sid="JOS 17:13" />Isra7eele asay minnida wode Kanaane asata banttas haggazissida attiin biittaafe istta ubbaa kessi gooddibeettenna.<note caller="-" style="x"><char style="xo" closed="false">17:12-13 </char><char style="xt" closed="false"><ref loc="JDG 1:27-28">Daanna 1:27-28</ref></char></note><verse eid="JOS 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 17:14" />Yooseefe zareti Iyaaso, «GODAY nuna anjjiin nuni qoodan cora gidishin laata biitta shaakon nuus ays issi gisha xalla immadii?» gida.<verse eid="JOS 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 17:15" />Iyaasoykka isttas, «Intte cora gidikko Efreeme gezzey Paarizetinne Erafaymeti diza biitta biidi wora inttes qeexite» gides.<verse eid="JOS 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 17:16" />Yooseefe zareti, «Gezze biittazi nuus gidenna; hessa bollaka demban diza Beeti-Sha7aanenne he heeran dizayti, qasse Izra7eele shoobbaan diza Kanaanetas birata para-gaareti deettes» gida.<verse eid="JOS 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JOS 17:17" />Iyaasoy zaaridi Yooseefe zaretas Efreeme qommotassinne Minaase qommotas, «Intte coranne keehi wolqqama; inttes issi gisha xallay gidenna. <verse eid="JOS 17:17" /><verse number="18" style="v" sid="JOS 17:18" />Hessa gishshas gezze biittayka inttessa; biidi qeexite; wurseththa gaxa gakkanaas dizayssi inttes gidana; Kanaanetas birata para-gaareti diikkoka, istti mino gidikkoka intte istta heeppe kessana» gides.<verse eid="JOS 17:18" /></para>
  <chapter eid="JOS 17" />
  <chapter number="18" style="c" sid="JOS 18" />
  <para style="s1">Attida Gade Gisheteth</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 18:1" />Isra7eele maabaray wuri Seelon shiiqida; Gaytoteththa Dunkaane heen tokkida; biittayakka co7u gaada isttas haarettadus. <verse eid="JOS 18:1" /><verse number="2" style="v" sid="JOS 18:2" />Gido attiin Isra7eele asaappe gade gishay gakkontta attida laappun qommoti deettes.<verse eid="JOS 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 18:3" />Hessa gishshas Iyaasoy Isra7eele asaa, «GODAA intte aawata Xoossay inttes immida biittaa laattontta ayde gakkanaas azalleetii? <verse eid="JOS 18:3" /><verse number="4" style="v" sid="JOS 18:4" />Issi issi qommofe heedzdzu heedzdzu asata doorite. Biittaa yuuyi xeellidi issi issi qommo gakkanayssa taas xaafi immanayta ta kiittana; isttika taakko haa simmi yaana. <verse eid="JOS 18:4" /><verse number="5" style="v" sid="JOS 18:5" />Istti he biittayo laappun kessi shaakkana. Dugeha baggara Yuhuday, pudeha baggara Yooseefey baas xinxxo histti oykkana. <verse eid="JOS 18:5" /><verse number="6" style="v" sid="JOS 18:6" />Ha laappun kezi shaakettida biittaa hanota xaafidaappe guye taakko ekki yiikko tani GODAA nu Xoossaa sinththan inttes saama yeggana. <verse eid="JOS 18:6" /><verse number="7" style="v" sid="JOS 18:7" />Lewe zareti Xoossas ooththiza oosoy isttas xinxxo gidida gishshas inttenara istti biitta gishettettenna. Gaade zareti, Oroobeele zaretinne Minaase zaretappe baggay Yordaanoose shaafappe arshey mokkizaso baggara GODAA aylle Musey isttas immida biittaa kaseti laattida» gides.<verse eid="JOS 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 18:8" />Asay biittaa hanota pilggi xeellanaassinne xaafanaas buus doommishin Iyaasoy, «Biidi biittay hanota pilggi xeellidi paatti xaafidaappe guye haa taakko simmi yiite. Hayssan Seelon GODAA sinththan ta inttes saama yeggana» gides. <verse eid="JOS 18:8" /><verse number="9" style="v" sid="JOS 18:9" />Hessa gishshas asay biittaa yuuyi xeellides; katamatara issife laappun kessi shaakkidi xaaththa waraqatan xaafida; hessafe gede Iyaasokko Seelo simmi bida. <verse eid="JOS 18:9" /><verse number="10" style="v" sid="JOS 18:10" />Iyaasoy GODAA sinththan Seelon isttas saama yeggides; biittayo Isra7eele asaas istta qommo keena gishechchi immides.<verse eid="JOS 18:10" /></para>
  <para style="s1">Biniyaame Qommotas Gakkida Biitta</para>
  <para style="p">
    <verse number="11" style="v" sid="JOS 18:11" />Koyro gishay Biniyaame qommota istta zarkken zarkken gakkides. Saaman istta gakkida biittay dizasoy Yuhuda zareta biittafenne Yooseefe zareta biittafe giddon gidishin hayssafe kaallizayssa; <verse eid="JOS 18:11" /><verse number="12" style="v" sid="JOS 18:12" />Pudeha baggara istta zaway Yordaanoose shaafappe doommidi, Iyarkko pudunththaara aadhdhi biidi arshey wulliza baggara dhoqqa biittara oykkidi Beeti-Awenera kanththees. <verse eid="JOS 18:12" /><verse number="13" style="v" sid="JOS 18:13" />Hessafe dugeha baggara Looza geetettiza Beetele pudunththaara kanththidi duge baggara diza Beeti-Horooneppe dugeha baggara diza zumaa achchara kanththi biidi duge Axaroote-Adaare gakkees.<verse eid="JOS 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 18:14" />Dugeha baggara diza zaway Beeti-Horoones sinththa baggara diza zumbullaafe doommidi, arshey wulliza baggara dugeha bagga mirqqettidi Yuhuda qommota katama gidida Qiriyaate-Ba7aale woykko Qiriyaate-Yi7aarimera kanththi bees; hessi arshey wulliza baggaas zawa.<verse eid="JOS 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 18:15" />Dugeha baggara zaway Qiriyaate-Yi7aarimeppe doommidi Nefto pultto haaththara kanththees. <verse eid="JOS 18:15" /><verse number="16" style="v" sid="JOS 18:16" />He zawazi Erafayme shoobbaafe pudeha baggara diza Henoome naa shoobbaa ginara diza zumbullaa tohoso wodhdhees; heeppe Yaabuseta katamappe dugeha baggara diza dugunththaara Henoome zulle wodhdhidi En-Roogeelera kanththees. <verse eid="JOS 18:16" /><verse number="17" style="v" sid="JOS 18:17" />Qasse pudeha bagga mirqqettidi En-Shemishera biidi Gelilootera kanththees; hessafe Adumime purde ginara diza Oroobeele naa Bohaane shuchchaako duge wodhdhees. <verse eid="JOS 18:17" /><verse number="18" style="v" sid="JOS 18:18" />Hessafe Beeti-Arabe pudunththaara kanththidi duge Arabe wodhdhees. <verse eid="JOS 18:18" /><verse number="19" style="v" sid="JOS 18:19" />Hessafe qasse Beeti-Hoogile pudunththaafe pudeha baggara kanththidi, Yordaanoose shaafay goggi gelizaso Maxine abbaafe ganna bagga gaxa gakkees. Hessi dugeha baggaas zawa. <verse eid="JOS 18:19" /><verse number="20" style="v" sid="JOS 18:20" />Arshey mokkizaso baggara Yordaanoose shaafay zawa. Biniyaame zareti laattida biitta ubbaasikka zawati heytantta.<verse eid="JOS 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 18:21" />Biniyaame zareti ba zarkken zarkken ekkida katamati Iyarkko, Beeti-Hoogile, Ameq-Kexixe, <verse eid="JOS 18:21" /><verse number="22" style="v" sid="JOS 18:22" />Beeti-Arabe, Zamarayme, Beetele, <verse eid="JOS 18:22" /><verse number="23" style="v" sid="JOS 18:23" />Awime, Paara, Oofira, <verse eid="JOS 18:23" /><verse number="24" style="v" sid="JOS 18:24" />Kafer-Amonaye, Oofinanne Geeba. Hayti bantta gutatara 12 katamata. <verse eid="JOS 18:24" /><verse number="25" style="v" sid="JOS 18:25" />Qasse Geba7oone, Eraama, Bi7eroote, <verse eid="JOS 18:25" /><verse number="26" style="v" sid="JOS 18:26" />Mixiphpha, Kaafire, Mooxa, <verse eid="JOS 18:26" /><verse number="27" style="v" sid="JOS 18:27" />Ereqeeme, Yirphi7eela, Teraala, <verse eid="JOS 18:27" /><verse number="28" style="v" sid="JOS 18:28" />Xela, Helefa, Yaabuseta katama Yerusalaame, Gibi7anne Qiriyaate-Yi7aarime. Hayti bantta gutatara 14 katamata. Biniyaame qommoti bantta zarkken zarkken laattida biittay hayta.<verse eid="JOS 18:28" /></para>
  <chapter eid="JOS 18" />
  <chapter number="19" style="c" sid="JOS 19" />
  <para style="s1">Simoona Qommota Gakkida Biitta</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 19:1" />Nam7anththo saamay Simoona qommota istta zarkken zarkken gakkides. Istta gakkida biittay Yuhuda qommoti laattida biittay istti laattida biitta giddoththi uttides. <verse eid="JOS 19:1" /><verse number="2" style="v" sid="JOS 19:2" />Istti laattida katamati Bersaabehe, Sheba7e, Molaade, <verse eid="JOS 19:2" /><verse number="3" style="v" sid="JOS 19:3" />Haxaare-Shu7aale, Baala, Exeeme, <verse eid="JOS 19:3" /><verse number="4" style="v" sid="JOS 19:4" />Elttolaade, Baatule, Horma, <verse eid="JOS 19:4" /><verse number="5" style="v" sid="JOS 19:5" />Xigilaage, Beeti-Markaboote, Haxaare-Suusa, <verse eid="JOS 19:5" /><verse number="6" style="v" sid="JOS 19:6" />Beeti-Laba7ootenne Sharuheene. Heyti ubbay 13 katamatanne istta yuushon diza gutata. <verse eid="JOS 19:6" /><verse number="7" style="v" sid="JOS 19:7" />Qasse Ayine, Armoone, Eteerenne Ashaane geetettiza oyddu katamatanne istta yuushon diza gutata. <verse eid="JOS 19:7" /><verse number="8" style="v" sid="JOS 19:8" />Ba7alaate-Ba7eere woykko Negeben diza Aramaateeme gakkanaas diza katamata yuushon diza gutata ubbaa laattida. Simoona qommoti ba zarkken zarkken gishetti ekkida biittati heytantta.<note caller="-" style="x"><char style="xo" closed="false">19:2-8 </char><char style="xt" closed="false"><ref loc="1CH 4:28-33">1Taari 4:28-33</ref></char></note> <verse eid="JOS 19:8" /><verse number="9" style="v" sid="JOS 19:9" />Yuhuda qommoti oykkida xinxxoy keehi aako gidida gishshas Simoona qommotas xinxxo gidi imettides; hessa gishshas Simoona qommoti Yuhuda qommota gishaappe gishetti ekkana dandayda.<verse eid="JOS 19:9" /></para>
  <para style="s1">Zaabiloone Qommota Gakkida Biitta</para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 19:10" />Heedzdzanththo saamay Zaabiloone qommotas istta zarkken zarkken gakkides. Istti laattida biittaa zaway Sariide gakkees. <verse eid="JOS 19:10" /><verse number="11" style="v" sid="JOS 19:11" />Qasse hessafe biidi arshey wullizasora Maraala baggara kanththi bees; Dabasheete matara Yoqina7aame achchan diza shaafaan bi gelees. <verse eid="JOS 19:11" /><verse number="12" style="v" sid="JOS 19:12" />Hara baggara qasse Sariide katamappe arshey mokkizaso bagga simmidi Kisiloote-Taaboorera kanththi biidi Dabiraatera gede Yaafi7a bees. <verse eid="JOS 19:12" /><verse number="13" style="v" sid="JOS 19:13" />Heera gede arshey mokkiza baggara Geet-Hefeerenne Eti-Qaxine kanththi bees; heeppeka gede Armoone gakkidi Ni7a bagga mirqqettees. <verse eid="JOS 19:13" /><verse number="14" style="v" sid="JOS 19:14" />Pudeha baggara Hanatoone simmidi Yiftaahi7eele shoobbaan gakki eqqees. <verse eid="JOS 19:14" /><verse number="15" style="v" sid="JOS 19:15" />Qasseka Qaxaate, Nahilaale, Shimiroone, Idaalenne Beeteliheeme geetettiza katamatikka deettes. Istti wuri 12; istta yuushon diza gutatikka isttan gujetteettes. <verse eid="JOS 19:15" /><verse number="16" style="v" sid="JOS 19:16" />Hayti Zaabiloone qommotas xinxxo gididi istta zarkken zarkken gishan gakkida katamatanne gutata.<verse eid="JOS 19:16" /></para>
  <para style="s1">Yisakoore Qommota Gakkida Biitta</para>
  <para style="p">
    <verse number="17" style="v" sid="JOS 19:17" />Oydanththo saamay Yisakoore qommota istta zarkken zarkken gakkides. <verse eid="JOS 19:17" /><verse number="18" style="v" sid="JOS 19:18" />Istta biittati hayssafe kaallizayta; Izra7eele, Kasuloote, Suneme, <verse eid="JOS 19:18" /><verse number="19" style="v" sid="JOS 19:19" />Hafara7ime, Shi7oone, Anaharaate, <verse eid="JOS 19:19" /><verse number="20" style="v" sid="JOS 19:20" />Erabite, Qisoone, Abeexe, <verse eid="JOS 19:20" /><verse number="21" style="v" sid="JOS 19:21" />Eremeete, En-Gaanime, En-Haadanne Beeti-Phaxeexe. <verse eid="JOS 19:21" /><verse number="22" style="v" sid="JOS 19:22" />He biittata zaway Taaboore, Shahaxuumenne Beeti-Shemishe bochchi biidi, Yordaanoose shaafan gelees. Istti ubbay tammanne usuppun katamata; istta yuushon diza gutatikka isttan gujetteettes. <verse eid="JOS 19:22" /><verse number="23" style="v" sid="JOS 19:23" />Hayti Yisakoore qommotas xinxxo gididi istta zarkken zarkken gishan gakkida katamatanne gutata.<verse eid="JOS 19:23" /></para>
  <para style="s1">Aaseere Qommota Gakkida Biitta</para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 19:24" />Ichchashanththo saamay Aaseere qommota istta zarkken zarkken gakkides. <verse eid="JOS 19:24" /><verse number="25" style="v" sid="JOS 19:25" />Istta biittati hayssafe kaallizayta Helqaate, Hale, Bexeene, Akishaafe, <verse eid="JOS 19:25" /><verse number="26" style="v" sid="JOS 19:26" />Alameleke, Amadenne Mishaale. Arshey wullizaso baggara Qarmelooseranne Shihoore-Libinaatera zawatees. <verse eid="JOS 19:26" /><verse number="27" style="v" sid="JOS 19:27" />Qasse arshe kessaso bagga simmi Beeti-Daagonekko mirqqettidi, Zaabiloone biittaanne Yiftaahi7eele shoobbara kanththi biidi Kaabule hadirsa bolla yeggidi pudeha baggara Beeti-Emeeqenne Na7i7eele bees. <verse eid="JOS 19:27" /><verse number="28" style="v" sid="JOS 19:28" />Hessafe qasse Ebiroone, Erahoobe, Hamoonenne Qaana pudunththaa kezidi gita Sidoona gakkees. <verse eid="JOS 19:28" /><verse number="29" style="v" sid="JOS 19:29" />Zaway Eraama simmidaappe gimbettida Xiroose katamaakko mirqqetti gede Hoosa simmidi Akiziibe baggaranne Mahileebe gede Mediteraane abbaan gakki gelees. <verse eid="JOS 19:29" /><verse number="30" style="v" sid="JOS 19:30" />Heen Uma, Afeeqenne Erahoobe geetettiza katamatikka deettes. Istti ubbay 22; istta yuushon diza gutatikka isttan gujetteettes. <verse eid="JOS 19:30" /><verse number="31" style="v" sid="JOS 19:31" />Hayti Aaseere qommotas xinxxo gididi istta zarkken zarkken gishan gakkida katamatanne gutata.<verse eid="JOS 19:31" /></para>
  <para style="s1">Niftaaleme Qommota Gakkida Biitta</para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 19:32" />Usuppunththa saamay Niftaaleme qommota istta zarkken zarkken gakkides. <verse eid="JOS 19:32" /><verse number="33" style="v" sid="JOS 19:33" />Istta zaway Heleefeppenne Zanaanimen diza gita wolappe doommidi Adaame-Neqeebe, Yaabin7eelenne Laaqume kanththi biidi Yordaanoose shaafa gelees. <verse eid="JOS 19:33" /><verse number="34" style="v" sid="JOS 19:34" />Zawazikka arshey wulliza baggara Azinoote-Taaboorekko mirqqettees; hessafe qasse Huqooqe simmidi dugeha baggara Zaabiloone biittaninne arshey geliza baggara Aaseere biittan zawatidi arshey keziza baggara Yordaanoose shaafan gelees. <verse eid="JOS 19:34" /><verse number="35" style="v" sid="JOS 19:35" />Gimbettida katamatikka Xiidime, Xeera, Hamaate, Eraaqate, Kinereete, <verse eid="JOS 19:35" /><verse number="36" style="v" sid="JOS 19:36" />Adaama, Eraama, Haxoore, <verse eid="JOS 19:36" /><verse number="37" style="v" sid="JOS 19:37" />Qaadeese, Edira7e, En-Haxoore, <verse eid="JOS 19:37" /><verse number="38" style="v" sid="JOS 19:38" />Yiroone, Migidal7eele, Horeeme, Beeti-Anaatenne Beeti-Shemishe. Istti wuri 19; istta yuushon diza gutatikka isttan gujetteettes. <verse eid="JOS 19:38" /><verse number="39" style="v" sid="JOS 19:39" />Hayti Niftaaleme qommotas xinxxo gididi istta zarkken zarkken gishan gakkida katamatanne istta yuushon diza gutata.<verse eid="JOS 19:39" /></para>
  <para style="s1">Daane Qommota Gakkida Biitta</para>
  <para style="p">
    <verse number="40" style="v" sid="JOS 19:40" />Laappunththo saamay Daane qommota istta zarkken zarkken gakkides. <verse eid="JOS 19:40" /><verse number="41" style="v" sid="JOS 19:41" />Istti laattida biittati Xora7a, Eshtta7oole, Ir-Shemeeshe, <verse eid="JOS 19:41" /><verse number="42" style="v" sid="JOS 19:42" />Sha7albine, Ayaaloone, Yitaala, <verse eid="JOS 19:42" /><verse number="43" style="v" sid="JOS 19:43" />Eeloone, Temina, Aqaroone, <verse eid="JOS 19:43" /><verse number="44" style="v" sid="JOS 19:44" />Elteqe, Gabatoone, Ba7alaate, <verse eid="JOS 19:44" /><verse number="45" style="v" sid="JOS 19:45" />Yuhuda, Bane-Baraaqe, Geet-Ermoone, <verse eid="JOS 19:45" /><verse number="46" style="v" sid="JOS 19:46" />Meyarqqoone, Eraaqoonenne Yoophphe katama yuushon diza heerata ubbaa oykkees. <verse eid="JOS 19:46" /><verse number="47" style="v" sid="JOS 19:47" />Gido attiin Daane qommotas imettida xinxxoy isttas gidontta aggida gishshas Laysha katamaa oli oykkida; he katamaan diza asaa giththa mashshan siifi wursidi katamaa baas ekkidi heen uttida. He katamaa sunththaaka laammidi ba aawaa Daane sunththan xeygida.<note caller="-" style="x"><char style="xo" closed="false">19:47 </char><char style="xt" closed="false"><ref loc="JDG 18:27-29">Daanna 18:27-29</ref></char></note> <verse eid="JOS 19:47" /><verse number="48" style="v" sid="JOS 19:48" />Hayti Daane qommotas xinxxo gididi istta zarkken zarkken gishan gakkida katamatanne gutata.<verse eid="JOS 19:48" /></para>
  <para style="s1">Iyaaso Gakkida Biitta</para>
  <para style="p">
    <verse number="49" style="v" sid="JOS 19:49" />Isra7eele asay banttana gakkida biitta ekkidaappe guye Nawe naa Iyaasos bantta biittafe xinxxo gade immida; <verse eid="JOS 19:49" /><verse number="50" style="v" sid="JOS 19:50" />GODAY azazida malanne Iyaasoy koyza mala Efreeme gezze deren diza Teminaate-Seraaha geetettiza katama izas immida. Izikka katamayo lo7eththidi baas duussaso ooththides. <verse eid="JOS 19:50" /><verse number="51" style="v" sid="JOS 19:51" />Qeese El7ezeerey, Nawe naa Iyaasoynne Isra7eele qommota korapinneti Seelon Gaytoteththa Dunkaaneza pengen GODAA sinththan saama yeggidi gishida xinxxo biittay hayssa. Istti biittaa gishereththi giigida.<verse eid="JOS 19:51" /></para>
  <chapter eid="JOS 19" />
  <chapter number="20" style="c" sid="JOS 20" />
  <para style="s1">Baqati Bi Attiza Katamata</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 20:1" />Hessafe guye GODAY Iyaaso,<note caller="-" style="x"><char style="xo" closed="false">20:1-9 </char><char style="xt" closed="false"><ref loc="NUM 35:6-32">Tay 35:6-32</ref>; <ref loc="DEU 4:41-43">Zaare 4:41-43</ref>; <ref loc="DEU 19:1-13">19:1-13</ref></char></note> <verse eid="JOS 20:1" /><verse number="2" style="v" sid="JOS 20:2" />«Tani Muse baggara yootida mala asi baqati attiza katamata shaakkana mala Isra7eele asaas yoota; <verse eid="JOS 20:2" /><verse number="3" style="v" sid="JOS 20:3" />Ay asikka eronttanne akeekontta as wodhikko hee baqati biidi suuththa acoppe attana. <verse eid="JOS 20:3" /><verse number="4" style="v" sid="JOS 20:4" />As wodhiday he katamatappe issaakko baqati biidi katama geliza pengen eqqidi, hanidayssa he katama cimatas yooto. Isttika bantta katama efidi izi de7anaaso immiko izi isttara heen de7o. <verse eid="JOS 20:4" /><verse number="5" style="v" sid="JOS 20:5" />Suuth azarana koyzay iza kaallidi yiikko he katama cimati iza aaththi immofetto. Gaasoykka ba shooroza izi odi morkketeththa gishshas wodhibeenna. <verse eid="JOS 20:5" /><verse number="6" style="v" sid="JOS 20:6" />Deraa sinththan pirdas izi eqqana gakkanaassinne he woden diza qeeseta halaqay hayqqana gakkanaas he katamaan de7o. Hessafe guye baqatidi kezida katama guye simmidi ba soo gelo» gides.<verse eid="JOS 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 20:7" />Histtiin Isra7eele asay Niftaaleme gezze dere, Galilan diza Qaadeese, Efreeme gezze deren diza Seekeemen diza shaara menththo bollanne Yuhudan shaara menththon diza Qiriyaate-Arba7e woykko Kebroone dummasida. <verse eid="JOS 20:7" /><verse number="8" style="v" sid="JOS 20:8" />Yordaanoose shaafappe he pinththan, Iyarkkofe arshey mokkiza baggara Oroobeele qommota xinxxo giddon bazzon dhoqqaso bolla diza Baxira, Gaade qommota xinxxofe Gala7aaden diza Eramootenne Minaase qommota xinxxofe Baasaanen diza Golaane dummasida. <verse eid="JOS 20:8" /><verse number="9" style="v" sid="JOS 20:9" />Isra7eele as ubbaassinne istta giddon diza betetas dummasida katamati hayta; erontta dishe as wodhida ay asikka deraa sinththan eqqana gakkanaas suuth azarana koyzaade kushen hayqqontta mala he katamatappe issaakko baqatanaas dandayees.<verse eid="JOS 20:9" /></para>
  <chapter eid="JOS 20" />
  <chapter number="21" style="c" sid="JOS 21" />
  <para style="s1">Lewetas Imettida Katamata</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 21:1" />Lewe zarkketa kaaleththizayti qeese El7ezeerekko, Nawe naa Iyaasokkonne Isra7eele zareta aawatakko shiiqida. <verse eid="JOS 21:1" /><verse number="2" style="v" sid="JOS 21:2" />Kanaane biittan diza Seelon isttas, «Nuni de7ana katamatanne nu mehe heenththasohota intte nuus immana mala GODAY kase Muse baggara azazi woththides» gida.<note caller="-" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="NUM 35:1-8">Tay 35:1-8</ref></char></note> <verse eid="JOS 21:2" /><verse number="3" style="v" sid="JOS 21:3" />Histtiin GODAY azazida mala Isra7eele asay Lewe qommotas ba laattida xinxxotappe ha katamatanne mehe heenththasohota qanxxi immida.<verse eid="JOS 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 21:4" />Koyro saamay Qa7aate zereththatas istta zarkken zarkken kezides. Qeese Aaroone zare gidida Lewetas Yuhudappe, Simoonappenne Biniyaame qommotappe 13 katamati saaman gakkida. <verse eid="JOS 21:4" /><verse number="5" style="v" sid="JOS 21:5" />Hankko attida Qa7aate zereththatas Efreemeppe, Daaneppenne Minaases bagga qommotappe 10 katamati saaman gakkida.<verse eid="JOS 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 21:6" />Gershoone zereththatas Yisakooreppe, Aaseereppe, Niftaalemeppenne Baasaanen diza Minaases bagga qommotappe 13 katamati saaman gakkida.<verse eid="JOS 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 21:7" />Meraare zereththatas istta zarkken zarkken Oroobeeleppe, Gaadeppenne Zaabiloone qommotappe 10 katamati saaman gakkida.<verse eid="JOS 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 21:8" />GODAY Muse baggara azazida mala, Isra7eele asay ha katamatanne mehe heenththasohota Lewetas saaman immida.<verse eid="JOS 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 21:9" />Yuhudappenne Simoona qommotappe hayssafe kaalli diza katamata saaman gaththida. <verse eid="JOS 21:9" /><verse number="10" style="v" sid="JOS 21:10" />Koyro saamay Lewe qommo Qa7aateppe yelettida Aaroone zaretas keziin isttas imettida katamati hayssafe kaallizayta. <verse eid="JOS 21:10" /><verse number="11" style="v" sid="JOS 21:11" />Heytikka Yuhuda biittan gezzetizason diza Kebroone geetettiza Qiriyaate-Arba7enne iza yuushon diza mehe heenththasohota isttas immida. (Arba7ey Enaaqe Aawaa.) <verse eid="JOS 21:11" /><verse number="12" style="v" sid="JOS 21:12" />Gido attiin he katama yuushon diza mehe heenththasohotanne mooththata Yoofine naa Kaalebes xinxxo histti immida. <verse eid="JOS 21:12" /><verse number="13" style="v" sid="JOS 21:13" />Qeese Aaroone zaretas as wodhida asi baqati biidi attiza Kebroonenne, Libina katamata istta mehe heenththasohora issife gaththi immida. <verse eid="JOS 21:13" /><verse number="14" style="v" sid="JOS 21:14" />Yetirenne Eshttamo7a, <verse eid="JOS 21:14" /><verse number="15" style="v" sid="JOS 21:15" />Holoonenne Dabire, <verse eid="JOS 21:15" /><verse number="16" style="v" sid="JOS 21:16" />Ayine, Yuuxa, Beeti-Shemishenne istta mehe heenththasohora issife gaththi immida. Hayti uddufun katamati Yuhuda qommotappenne Simoona qommota xinxxofe gishetti imettidayta.<verse eid="JOS 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JOS 21:17" />Biniyaame qommotappe Geba7oone, Geeba, <verse eid="JOS 21:17" /><verse number="18" style="v" sid="JOS 21:18" />Anatoote, Almmoone geetettiza oyddu katamatanne istti mehe heemmizasohora issife gaththi immida. <verse eid="JOS 21:18" /><verse number="19" style="v" sid="JOS 21:19" />Qeese Aaroone zereththatas mehe heenththasohora issife gaththidi 13 katamata immida.<verse eid="JOS 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 21:20" />Hankko attida Lewe naa Qa7aate zaretas Efreeme qommotappe hayssafe kaalli dizayssi saaman gakkides. <verse eid="JOS 21:20" /><verse number="21" style="v" sid="JOS 21:21" />Efreeme gezze deren diza as wodhida asi baqati biidi attizaso Seekeemenne Gezeere, <verse eid="JOS 21:21" /><verse number="22" style="v" sid="JOS 21:22" />Qibixayme, Beeti-Horoonenne istta mehe heenththasohora issife gaththidi 4 katamata immida. <verse eid="JOS 21:22" /><verse number="23" style="v" sid="JOS 21:23" />Daane qommotappe Elteqe, Gabatoone, <verse eid="JOS 21:23" /><verse number="24" style="v" sid="JOS 21:24" />Ayaaloone, Geet-Ermoonenne istta mehe heenththasohora issife gaththi 4 katamata immida.<verse eid="JOS 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JOS 21:25" />Minaase qommotas baggatappe Ta7inaake, Geet-Ermoone mehe heenththasohotara issife gaththi 2 katamata immida. <verse eid="JOS 21:25" /><verse number="26" style="v" sid="JOS 21:26" />Hayti 10 katamati ubbay mehe heenththasohotara issife hankko attida Qa7aate zaretas imettides.<verse eid="JOS 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JOS 21:27" />Minaase zareta baggatappe as wodhida asi baqati biidi attiza, Baasaanen diza Golaane katamaa mehe heenththasohora Ba7eshtira mehe heenththasohora, nam7u katamata ubbaa ekkidi, Gershoone zare gidida hara Lewetas immida. <verse eid="JOS 21:27" /><verse number="28" style="v" sid="JOS 21:28" />Yisakoore zaretappe Qisoone mehe heenththasohora, Dabiraate mehe heenththasohora, <verse eid="JOS 21:28" /><verse number="29" style="v" sid="JOS 21:29" />Yarmuute mehe heenththasohora, En-Gaanime mehe heenththasohora, oyddu katamata ubbaa ekkidi immida.<verse eid="JOS 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JOS 21:30" />Aaseere zaretappe Mishaale mehe heenththasohora, Abdoone mehe heenththasohora, <verse eid="JOS 21:30" /><verse number="31" style="v" sid="JOS 21:31" />Helqaate mehe heenththasohoranne Erahoobe mehe heenththasohora, oyddu katamata ubbaa ekkidi immida.<verse eid="JOS 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 21:32" />Hessaththoka Niftaaleme zaretappe as wodhida asi baqati biidi attiza Galilan diza Qaadeese mehe heenththasohora, Hamooti-Doore mehe heenththasohora, Qarta mehe heenththasohora, 3 katamata ubbaa ekkidi isttas immida. <verse eid="JOS 21:32" /><verse number="33" style="v" sid="JOS 21:33" />Gershoone zareta katamatinne istta meheta heenththasohoti ubbay tammanne heedzdza.<verse eid="JOS 21:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JOS 21:34" />Attida Meraare zare gidida Lewetas imettida biittati Zaabiloone zaretappe Yoqina7aame mehe heenththasohora, Qarta mehe heenththasohora, <verse eid="JOS 21:34" /><verse number="35" style="v" sid="JOS 21:35" />Diimina mehe heenththasohora, Nahilaale mehe heenththasohora, oyddu katamata ubbaa ekkidi immida.<verse eid="JOS 21:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JOS 21:36" />Oroobeele zaretappe Baxiranne izi mehe heenththasohota, Yahaaxenne izi mehe heenththasohota, <verse eid="JOS 21:36" /><verse number="37" style="v" sid="JOS 21:37" />Qidimootenne izi mehe heenththasohota, Mefa7aatenne izi mehe heenththasohota, hayta oyddu katamata ubbaa ekkidi isttas immida.<verse eid="JOS 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JOS 21:38" />Qasse Gaade zaretappe as wodhida asi baqati biidi attiza, Gala7aaden diza Eramoote mehe heenththasohora, Mahanayme mehe heenththasohora, <verse eid="JOS 21:38" /><verse number="39" style="v" sid="JOS 21:39" />Haseboone mehe heenththasohora, Iyaazeere mehe heenththasohora, hayta oyddu katamata ubbaa ekkidi isttas immida. <verse eid="JOS 21:39" /><verse number="40" style="v" sid="JOS 21:40" />Meraarey zare gidida hara Lewetas gishan gakkida katamati ubbay tammanne nam7a.<verse eid="JOS 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JOS 21:41" />Isra7eele asay laattida biittan diza Lewetas imettida katamati istta mehe heenththasohora ubbay issi bolla oyddu tammanne osppuna. <verse eid="JOS 21:41" /><verse number="42" style="v" sid="JOS 21:42" />He katamata ubbaa yuushon mehe heemmizasohoti deettes. Mehe heemmizasohoy baynda katamay deenna.<verse eid="JOS 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JOS 21:43" />Hessaththo ooththidi GODAY istta aawatas immanaas caaqqida biitta ubbaa Isra7eele asaas immides; histtiin istti laattidi heen de7ida. <verse eid="JOS 21:43" /><verse number="44" style="v" sid="JOS 21:44" />GODAY istta aawatas caaqqida mala istta yuushon diza ubbatappe istta shempisides. GODAY istta morkketa ubbaa isttas aaththi immida gishshas istta morkketappe issoyka isttara eqettanaas dandaybeenna. <verse eid="JOS 21:44" /><verse number="45" style="v" sid="JOS 21:45" />GODAY Isra7eele asaas immana gida lo7o qaala ubbaa polides attiin issoynne sa7an wodhdhi attibeenna.<verse eid="JOS 21:45" /></para>
  <chapter eid="JOS 21" />
  <chapter number="22" style="c" sid="JOS 22" />
  <para style="s1">Banttaso Simmida Arshey Mokkiza Baggara Diza Qommota</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 22:1" />Hessafe guye Iyaasoy Oroobeele qommota, Gaade qommotanne Minaase qommo baggatappe xeygides. <verse eid="JOS 22:1" /><verse number="2" style="v" sid="JOS 22:2" />Histtidi, «GODAA aylle Musey inttena azazidayssa ubbaa naagideta; qasse tanikka azazidayssa mulera polideta.<note caller="-" style="x"><char style="xo" closed="false">22:2 </char><char style="xt" closed="false"><ref loc="NUM 32:20-32">Tay 32:20-32</ref>; <ref loc="JOS 1:12-15">Iya 1:12-15</ref></char></note> <verse eid="JOS 22:2" /><verse number="3" style="v" sid="JOS 22:3" />Daro wodeppe doommidi hach gakkanaas intte intte ishata yeggibeekketa; GODAA intte Xoossay inttes immida hadaraa polideta. <verse eid="JOS 22:3" /><verse number="4" style="v" sid="JOS 22:4" />Hekko GODAA intte Xoossay inttes immida hidota qaalaa mala intte ishata shempisides. Hessa gishshas GODAA ashkara Musey inttes Yordaanoose shaafappe he pinththan immida laata biittan diza intte soo soo simmite. <verse eid="JOS 22:4" /><verse number="5" style="v" sid="JOS 22:5" />GODAA aylle Musey inttena azazida azazozanne wogaa intte naagite. GODAA intte Xoossa siiqite; iza ogeta ubbaan simerettite; iza azazota polite; izakka minththi oykkite; intte kumeththa wozinappenne kumeththa shemppofe izas ooththana mala izi immida azazotanne wogata minththi naagite» gides.<verse eid="JOS 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 22:6" />Hessafe guye Iyaasoy istta anjji yeddiin isttika bantta soo soo simmi bida. <verse eid="JOS 22:6" /><verse number="7" style="v" sid="JOS 22:7" />Musey Minaase qommofe baggatas Baasaane biittan xinxxo immides; hankko attida baggatas Iyaasoy Yordaanooseppe arshey wulliza baggafe istta ishata giddon isttas xinxxo immides. Iyaasoy istta bantta soo soo simmana mala moyziza wode istta anjjishe, <verse eid="JOS 22:7" /><verse number="8" style="v" sid="JOS 22:8" />«Be7ite, intte ha7i daro aqota ekkidi, daro mehe wude, bira, worqqa, xarqimala, biratanne daro may7o ekkidi intte soo simmite. Hessa gishshas intte morkketappe di7ettidayssa, intte ishatara gishetti ekkite» gides.<verse eid="JOS 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 22:9" />Hessa gishshas Oroobeele qommotinne Gaade qommoti hessaththoka Minaase qommofe baggati Isra7eele asaa Kanaanen diza Seelon aggidi kase Muse baggara GODAA azazon laata ekkida xinxxon Gala7aade simmi bida.<verse eid="JOS 22:9" /></para>
  <para style="s1">Yordaanoose Shaafa Matan Oosettida Yarshosoho</para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 22:10" />Oroobeele qommoti, Gaade qommotinne Minaase qommotappe baggati Yordaanoose shaafa matan Kanaane biittan diza Gala7aade yida wode shaafa matan gita yarshosoho giigsida. <verse eid="JOS 22:10" /><verse number="11" style="v" sid="JOS 22:11" />Histtiin istti Isra7eele biittan, Kanaane zawan, Gaaden gita yarshosoho giigsidayssa hara Isra7eele asay siyida wode <verse eid="JOS 22:11" /><verse number="12" style="v" sid="JOS 22:12" />kumeththa Isra7eele asay istta olana baanaas Seelon issife shiiqides.<verse eid="JOS 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 22:13" />Histtidi Isra7eele asay qeese El7ezeere naa Finihaase, Gala7aade biittan diza Oroobeele qommotakko, Gaade qommotakkonne Minaase qommotappe baggataakko kiittides. <verse eid="JOS 22:13" /><verse number="14" style="v" sid="JOS 22:14" />Kumeththa Isra7eele qommota ba qommota halaqatappe issi issi as dooridi, tammu as Finihaasera gaththi yeddides. Hayti issoy issoy Isra7eele qommotappe yida bantta zarkken zarkken doorettida halaqata.<verse eid="JOS 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 22:15" />Istti Oroobeele qommoti, Gaade qommotinne Minaase qommotappe baggati diza Gala7aade biitta biidi isttas, <verse eid="JOS 22:15" /><verse number="16" style="v" sid="JOS 22:16" />«GODAA asay kumeth inttena, ‹Isra7eele Xoossa bolla ays hayssa mala iita ooththidetii? Waanidi intte hara yarsho yarshizaso inttes giigsidetii? GODAA bolla waani makkallidetii? Iza kaallizaayssaka waanidi aggidetii?<note caller="-" style="x"><char style="xo" closed="false">22:16 </char><char style="xt" closed="false"><ref loc="DEU 12:13-14">Zaare 12:13-14</ref></char></note> <verse eid="JOS 22:16" /><verse number="17" style="v" sid="JOS 22:17" />Pe7ooren nuni ooththida nagaray nuus gidennee? Isra7eele deraa bolla boshay wodhdhidaa gidikkoka hach gakkanaaska nuni he nagarappe geeyibookko.<note caller="-" style="x"><char style="xo" closed="false">22:17 </char><char style="xt" closed="false"><ref loc="NUM 25:1-9">Tay 25:1-9</ref></char></note> <verse eid="JOS 22:17" /><verse number="18" style="v" sid="JOS 22:18" />Intte ha7ikka GODAA kaallizayssa aggidi guye guye geetii?</para>
  <para style="p" vid="JOS 22:18">« ‹Intte hach GODAA bolla makkalliko izi wonto kumeththa Isra7eele deraa hanqettana. <verse eid="JOS 22:18" /><verse number="19" style="v" sid="JOS 22:19" />Intte laattida biittay tunidaa gidikko GODAA Dunkaaney eqqida GODAA biitta haa yiidi, nunara gade gishetti ekkite. Gido attiin kaseppe diza GODAA nu Xoossa yarshosoppe hara yarshosoho giigsidi GODAA bolla woykko nu bolla makkallofte. <verse eid="JOS 22:19" /><verse number="20" style="v" sid="JOS 22:20" />Zaraahe naa Akaaney piila gididayssa ekkidi, nagara ooththida gishshas, kumeththa Isra7eele deraa bolla GODAA hanqoy wodhdhibeennee? Iza nagara gaason hayqqiday iza xalala gidenna› geettes» gida.<note caller="-" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="JOS 7:1-26">Iya 7:1-26</ref></char></note><verse eid="JOS 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 22:21" />Histtiin Oroobeele qommoti, Gaade qommotinne Minaase qommotappe baggati Isra7eele qommota halaqatas zaaridi, <verse eid="JOS 22:21" /><verse number="22" style="v" sid="JOS 22:22" />«GODAY Wolqqama Xoossay! GODAY Wolqqama Xoossay! Nuni hayssa ays ooththidaakko izi erees! Nuni ays ooththidaakko intteka erana mala koyoos. Nuni hayssa ooththiday makkallateththaninne GODAAS azazeteththa ixon gidikko, hach nuna maaropite. <verse eid="JOS 22:22" /><verse number="23" style="v" sid="JOS 22:23" />Nuni GODAA kaallizayssa aggidi xuugettiza yarsho, kaththa yarshonne issifeteththa yarsho yarshanaas qoppidi giigsidaa gidikko, GODAY nu bolla ba halo kesso. <verse eid="JOS 22:23" /><verse number="24" style="v" sid="JOS 22:24" />Nuni hessaththo ooththiday sinththafe yaana intte zereththati nu zereththata, ‹GODAA Isra7eele Xoossara inttes aaza gaytoteththi dizee? <verse eid="JOS 22:24" /><verse number="25" style="v" sid="JOS 22:25" />Intteno Oroobeelenne Gaade qommotoo, GODAY nu giddoninne intte giddon Yordaanoose shaafan zawa zaarida gishshas, GODAAN inttena gaththiza miishshi deenna› giidi intte zareti nu zareta GODAAS goynnontta mala teqqontta aggettenna gi hirgidos» gida.<verse eid="JOS 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JOS 22:26" />«Hessa gishshas, ‹Nuni nu giddon yarsho yarshizasoho ane ooththoos; gido attiin xuugettiza yarshos woykko hara yarshos gidenna› giday hessassa. <verse eid="JOS 22:26" /><verse number="27" style="v" sid="JOS 22:27" />Nuni yarshosoho giigsiday xuugettiza yarsho, issifeteththa yarshonne hara yarsho yarshidi, GODAAS iza Dunkaanen goynnizayssa hayssi yarshosohozi nu giddoninne intte giddon, qasse nuuppe kaalliza yeletata giddon markka gidana. Wodeppe intte zereththati nu zereththata, ‹Inttena GODAAN gaththizay aykkoyka deenna› gaanaas dandayettenna. <verse eid="JOS 22:27" /><verse number="28" style="v" sid="JOS 22:28" />Istti nuna woykko nu zereththata wodeppe hessaththo giikko nuni isttas zaaridi, ‹Hekko! Nu aawati GODAASSI yarshizasoho leemiso ooththidayssa be7ite. Hayssa nu aawati xuugettiza yarshonne hara yarsho yarshanaas gidontta, inttefenne nuuppe giddon markka gidana mala giigsida› gaana. <verse eid="JOS 22:28" /><verse number="29" style="v" sid="JOS 22:29" />GODAA nu Xoossa Dunkaaneza sinththan eqqida yarsho yarshizasohoppe hara, xuugettiza yarsho, kaththa yarshonne hara yarsho yarshizasoho giigsidi GODAA bolla makkalloy nuuppe haakko!» gida.<verse eid="JOS 22:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JOS 22:30" />Qeese Finihaasinne izara diza Isra7eele qommota halaqati, Oroobeele, Gaadenne Minaase qommoti yootidayssa siyidi, keehi ufayettida. <verse eid="JOS 22:30" /><verse number="31" style="v" sid="JOS 22:31" />Qeese El7ezeere naa Finihaasi Oroobeele, Gaadenne Minaase qommotas, «GODAY nu giddon dizayssa nuni hach eridos; ays giikko ha yo7oza intte GODAA bolla makkallanaas ooththibeekketa. Intte ha7i GODAA hanqofe Isra7eele asaa ashshideta» gides.<verse eid="JOS 22:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 22:32" />Hessafe guye qeese El7ezeere naa Finihaasinne deraa kaaleththizayti Gala7aaden diza Oroobeelenne Gaade qommotara haasayettidaappe guye Kanaanen diza Isra7eele asaakko simmida; histtidi hanidayssa isttas yootida. <verse eid="JOS 22:32" /><verse number="33" style="v" sid="JOS 22:33" />Isra7eele asay hessa siyidi ufayssan Xoossa galatides. Qasse Oroobeele qommotinne Gaade qommoti diza biitta oli dhayssanaas baana gidayssa aggides.<verse eid="JOS 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JOS 22:34" />Oroobeeleynne Gaade qommoti, «GODAY izi Xoossaa gididayssas hayssi nu giddon markka» giidi yarshosohoza, «Markka» gi sunththida.<verse eid="JOS 22:34" /></para>
  <chapter eid="JOS 22" />
  <chapter number="23" style="c" sid="JOS 23" />
  <para style="s1">Iyaasoy Deraa Kaaleththizaytas Yootida Wurseththa Qaala</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 23:1" />Daro wodes GODAY Isra7eele asaa istta yuushon diza morkketa ubbaafe shempisides. He wode Iyaasoy cimmidi keehippe wode sugides. <verse eid="JOS 23:1" /><verse number="2" style="v" sid="JOS 23:2" />Iyaasoy Isra7eele asaa ubbaa, cimata, shuumeta, daannatanne pirdizayta issife xeygi shiishshidi, «Tani cimadis, wodeykka taas keehi bides. <verse eid="JOS 23:2" /><verse number="3" style="v" sid="JOS 23:3" />GODAA intte Xoossay intte gishshas ha kawoteththata bolla ooththida ubbaa miish intte intte ayfen beyideta. Intte gishshas olettiday GODAA intte Xoossaa. <verse eid="JOS 23:3" /><verse number="4" style="v" sid="JOS 23:4" />Be7ite, Yordaanoose shaafappe doommidi arshey wullizaso baggan Mediteraane Abba gakkanaas dizasota ubbaa, intte xoonida kawoteththatappe intte buro laattontta biittata tani intte qommotas saaman saaman wostta gishidaakko akeekite. <verse eid="JOS 23:4" /><verse number="5" style="v" sid="JOS 23:5" />GODAA intte Xoossay istta intte sinththafe istti dizasozappe istta yedeththana; GODAA intte Xoossay inttes immida hidota qaala mala intte istta biitta laattana.<verse eid="JOS 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 23:6" />«Minnite! Hadirsinne ushach goopite; Muse Woga Maxaafan xaafettida ubbaa naaganaassinne ooththanaas keehippe minettite. <verse eid="JOS 23:6" /><verse number="7" style="v" sid="JOS 23:7" />Hayta intte giddon attida kawoteththatara issifettofte; istta eeqa xoossata sunththa xeygopite; istta sunththan caaqqofte; isttas ooththoftenne goynnofte. <verse eid="JOS 23:7" /><verse number="8" style="v" sid="JOS 23:8" />Gido attiin hach gakkanaas intte ooththida mala GODAA intte Xoossaa minththi oykkite.<verse eid="JOS 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 23:9" />«GODAY gitanne mino kawoteththata intte sinththafe gooddi kessides; hach gakkanaas oonikka inttenara eqettanaas dandaybeenna. <verse eid="JOS 23:9" /><verse number="10" style="v" sid="JOS 23:10" />GODAA intte Xoossay inttes immida hidota qaala mala izi olettiza gishshas inttefe issi asi shii as yedeththana.<note caller="-" style="x"><char style="xo" closed="false">23:10 </char><char style="xt" closed="false"><ref loc="DEU 3:22">Zaare 3:22</ref>; <ref loc="DEU 32:30">32:30</ref></char></note> <verse eid="JOS 23:10" /><verse number="11" style="v" sid="JOS 23:11" />Hessa gishshas GODAA intte Xoossaa minni siiqite. <verse eid="JOS 23:11" /><verse number="12" style="v" sid="JOS 23:12" />Gido attiin intte guye simmidi hankko attida inttenara diza kawoteththatara intte issifettiko, ekon gelon isttara issife walakettiko, <verse eid="JOS 23:12" /><verse number="13" style="v" sid="JOS 23:13" />GODAA intte Xoossay hayssafe guye intte sinththafe istta kessi gooddonttayssa intte eranaas bessees; GODAA intte Xoossay inttes immida ha lo7o biittayfe intte dhayana gakkanaas istti inttes woximadenne yarde gidana; intte zokkos lisso, intte ayfesikka agunth gidana.<verse eid="JOS 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 23:14" />«Be7ite taas ha7i hayqo wodey gakkides; GODAA intte Xoossay inttes immida lo7o hidota ubbaafe issinokka izi ashshonttayssa intte kumeththa wozinappenne kumeththa shemppofe ereeta; izi inttes immana gida hidotay pacey baynda mulera polettides. <verse eid="JOS 23:14" /><verse number="15" style="v" sid="JOS 23:15" />Gido attiin GODAA intte Xoossay inttes immida lo7o hidota ubbay mulera polettida mala GODAA intte Xoossay inttes immida lo7o biittayfe inttena dhayssana gakkanaas iita miish intte bolla ehana. <verse eid="JOS 23:15" /><verse number="16" style="v" sid="JOS 23:16" />GODAA intte Xoossay inttes immida caaqo qaala intte laallizaa gidikko, biidi hara eqqa xoossatas haggazikkonne goynniko GODAA hanqoy intte bolla tama mala eexxi kezana; izi inttes immida lo7o biittayfe intte eeson dhayana» gides.<verse eid="JOS 23:16" /></para>
  <chapter eid="JOS 23" />
  <chapter number="24" style="c" sid="JOS 24" />
  <para style="s1">Seekeemen Ooraxida Caaqo Qaala</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 24:1" />Hessafe guye Iyaasoy Isra7eele qommota ubbaa Seekeemen shiishshides. Cimata, kaaleththizayta, daannatanne pirdizayta ubbaa xeygides; isttika Xoossa sinth shiiqida. <verse eid="JOS 24:1" /><verse number="2" style="v" sid="JOS 24:2" />Iyaasoy deraa ubbaas, «GODAA Isra7eele Xoossay, ‹Kase intte aawati Abrahaamenne Naakoore aawa Taara gujjidi Efiraaxise shaafappe he pinththan de7ida; istti hara eeqa xoossatas goynnida.<note caller="-" style="x"><char style="xo" closed="false">24:2 </char><char style="xt" closed="false"><ref loc="GEN 11:27">Medhe 11:27</ref></char></note> <verse eid="JOS 24:2" /><verse number="3" style="v" sid="JOS 24:3" />Tani gidikko intte aawa Abrahaame Efiraaxise shaafas he pinththafe ehadis; Kanaane biittankka kaaleththadis. Iza zereththatakka darsadis; Yisaaqakka izas immadis.<note caller="-" style="x"><char style="xo" closed="false">24:3 </char><char style="xt" closed="false"><ref loc="GEN 12:1-9">Medhe 12:1-9</ref>; <ref loc="GEN 21:1-3">21:1-3</ref></char></note> <verse eid="JOS 24:3" /><verse number="4" style="v" sid="JOS 24:4" />Yisaaqaska Yaaqoobenne Eesawe immadis. Eesawes gezzetiza Seyre biitta xinxxo histta immadis; Yaaqoobeynne iza nayti gidikko duge Gibxe bida.<note caller="-" style="x"><char style="xo" closed="false">24:4 </char><char style="xt" closed="false"><ref loc="GEN 25:24-26">Medhe 25:24-26</ref>; <ref loc="GEN 36:8">36:8</ref>; <ref loc="GEN 46:1-7">46:1-7</ref>; <ref loc="DEU 2:5">Zaare 2:5</ref></char></note><verse eid="JOS 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 24:5" />« ‹Hessafe guye Musenne Aaroone kiittadis; ta ehida boshan Gibxeta un7eththada inttena heeppe kessadis.<note caller="-" style="x"><char style="xo" closed="false">24:5 </char><char style="xt" closed="false"><ref loc="EXO 3:1-12:42">Kessa 3:1—12:42</ref></char></note> <verse eid="JOS 24:5" /><verse number="6" style="v" sid="JOS 24:6" />Tani intte aawata Gibxeppe kessiin Zo7o abbaako yideta; Gibxeti para-gaaretaninne toga asatan inttena Zo7o abbaa gakkanaas oykkana kaallida.<note caller="-" style="x"><char style="xo" closed="false">24:6-7 </char><char style="xt" closed="false"><ref loc="EXO 14:1-31">Kessa 14:1-31</ref></char></note> <verse eid="JOS 24:6" /><verse number="7" style="v" sid="JOS 24:7" />Intte aawati maado demmanaas taakko waassida; tani isttafenne Gibxetappe giddon dhuma yeggadis; histtada abbay istta bolla simmana malanne istta mittana mala ooththadis. Tani Gibxeta bolla ooththidayssa intte intte ayfen be7ideta. Intteka bazzon daro wode de7ideta.<verse eid="JOS 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 24:8" />« ‹Hessafe guye Yordaanoose shaafappe arshey mokkizaso baggara diza Amooreta biitta tani inttena ehadis. Istti inttenara olettiin tani istta intte kushen aaththa immadis; tani istta intte sinththafe dhayssadis; qasse intte istta biitta laattideta.<note caller="-" style="x"><char style="xo" closed="false">24:8 </char><char style="xt" closed="false"><ref loc="NUM 21:21-35">Tay 21:21-35</ref></char></note> <verse eid="JOS 24:8" /><verse number="9" style="v" sid="JOS 24:9" />Hessafe guye Mo7aabe biitta kawo Xipoora naa Balaaqey Isra7eele olanaas dendides; inttena yiidi doqqana mala Bi7oore naa Balaames kiita yeddides. <verse eid="JOS 24:9" /><verse number="10" style="v" sid="JOS 24:10" />Tani gidikko Balaame siyana koyabeekke; hessa gishshas izi inttena zaari zaari anjjides; tanikka inttena Baalaaqe kusheppe ashshadis.<note caller="-" style="x"><char style="xo" closed="false">24:9-10 </char><char style="xt" closed="false"><ref loc="NUM 22:1-24:25">Tay 22:1—24:25</ref></char></note><verse eid="JOS 24:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JOS 24:11" />« ‹Heeppe intte Yordaanoose shaafa pinnidi Iyarkko yideta; Amooreti, Paarizeti, Kanaaneti, Hiiteti, Gergeseti, Hiiwetinne Yaabuseti inttenara olettida mala Iyarkko asay inttenara olettides; gido attiin tani istta intte kushen aaththa immadis.<note caller="-" style="x"><char style="xo" closed="false">24:11 </char><char style="xt" closed="false"><ref loc="JOS 3:14-17">Iya 3:14-17</ref>; <ref loc="JOS 6:1-21">6:1-21</ref></char></note> <verse eid="JOS 24:11" /><verse number="12" style="v" sid="JOS 24:12" />Inttefe sinththe kazhe kiittada isttanne Amoore kawo nam7ata intte sinththafe gooddadis. Hayssi ubbay haniday intte mashshaninne intte wondafen gidenna.<note caller="-" style="x"><char style="xo" closed="false">24:12 </char><char style="xt" closed="false"><ref loc="EXO 23:28">Kessa 23:28</ref>; <ref loc="DEU 7:20">Zaare 7:20</ref></char></note> <verse eid="JOS 24:12" /><verse number="13" style="v" sid="JOS 24:13" />Intte daaburontta biittanne intte keexxontta katamata tani inttes immadis; hekko intte tokkontta woyne ayfenne wogara ayfe meeta› gides.<note caller="-" style="x"><char style="xo" closed="false">24:13 </char><char style="xt" closed="false"><ref loc="DEU 6:10-11">Zaare 6:10-11</ref></char></note><verse eid="JOS 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 24:14" />«Hessa gishshas ha7ikka GODAAS yayyite; kumeththa wozinappe ammaneteththan izas haarettite; kase intte aawati Efiraaxise shaafappe he pinththaninne Gibxe biittan goynnida eeqa xoossata inttefe haassite; GODAAS xalla goynnite. <verse eid="JOS 24:14" /><verse number="15" style="v" sid="JOS 24:15" />GODAAS goynoy koshshontta miish misati inttes beettiko kase intte aawati shaafappe he pinththan dishe goynnida eeqa xoossata woykko ha7i intte diza Amooreti goynniza xoossata goynnana gidikko intte goynnanayssa hach doorite; taninne ta keeththa asay gidikko GODAAS goynnana» gides.<verse eid="JOS 24:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 24:16" />Histtiin asay zaaridi, «GODAA aggidi hara eeqa xoossatas goynoy nuuppe haakko! <verse eid="JOS 24:16" /><verse number="17" style="v" sid="JOS 24:17" />Gibxe aylleteththa biittafe, nunanne nu aawata kessidi ehiday, he gita malaatata nu sinththan ooththiday, nu biza oge ubbaaninne nu kanththida kawoteththata ubbaa giddon nuna naagiday GODAA nu Xoossaa. <verse eid="JOS 24:17" /><verse number="18" style="v" sid="JOS 24:18" />Qasse GODAY he biittan diza Amooretara gujjiin deraa ubbaa nu sinththafe gooddides; hessa gishshas nuni GODAAS goynnana; izi nu Xoossa» gides.<verse eid="JOS 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOS 24:19" />Iyaasoykka deraas, «Intte GODAAS goynnanaas dandayekketa; izi geeshsha Xoossa; izi qanaatiza Xoossa; izi intte makkallateththaanne intte nagaraa atto geenna. <verse eid="JOS 24:19" /><verse number="20" style="v" sid="JOS 24:20" />Intte GODAA aggidi allaga xoossatas goynniko izi inttes lo7o ooththidaappe guye simmi wodhdhidi izi intte bolla iita ooththananne inttena dhayssana» gides.<verse eid="JOS 24:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 24:21" />Histtiin derezi Iyaaso, «Akkay nuni GODAAS xalla goynnana» gides.<verse eid="JOS 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 24:22" />Hessafe guye Iyaasoy deraas, «Intte GODAAS goynnanaas doorida gishshas intte hu7es intte markka» gides.</para>
  <para style="p" vid="JOS 24:22">Isttika zaaridi, «Ee nuni markka!» gida.<verse eid="JOS 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JOS 24:23" />Iyaasoy, «Histtiko, intte giddon diza allaga xoossata diggite; intte wozinaa GODAA Isra7eele Xoossaako zaarite» gides.<verse eid="JOS 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 24:24" />Derezikka Iyaasos, «Nuni GODAA nu Xoossas goynnana; izaskka azazettana» gida.<verse eid="JOS 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JOS 24:25" />He gallas Iyaasoy dereza caaqeththides; istti kaallana wogaanne maara heen Seekeemen isttas immides. <verse eid="JOS 24:25" /><verse number="26" style="v" sid="JOS 24:26" />Iyaasoy he qaalata Xoossa Woga Maxaafan xaafides. Hessafe guye issi gita shuch ekkidi Geesh gidida GODAA Dunkaaneza matan diza wola garsan essides. <verse eid="JOS 24:26" /><verse number="27" style="v" sid="JOS 24:27" />Iyaasoy kumeththa deraas, «Be7ite; GODAY nuus haasayda qaala ubbaa ha shuchchay siyida gishshas izi nu bolla markka gidana. Intte Xoossa bollan makkalliko ha shuchchay intte bolla markka gidana» gides. <verse eid="JOS 24:27" /><verse number="28" style="v" sid="JOS 24:28" />Hessafe guye Iyaasoy deraa ubbaa ba xinxxon xinxxon simmana mala moyzides.<verse eid="JOS 24:28" /></para>
  <para style="s1">Iyaaso Hayqonne El7ezeere Hayqo</para>
  <para style="p">
    <verse number="29" style="v" sid="JOS 24:29" />Hessafe guye GODAA aylle, Nawe naa Iyaasos layththay 110 gidiin hayqqides. <verse eid="JOS 24:29" /><verse number="30" style="v" sid="JOS 24:30" />Asay Ga7aashe zumaappe pudeha baggan, shaara menththon diza Efreeme deren diza iza xinxxon Teminaate-Seraahan moogides.<note caller="-" style="x"><char style="xo" closed="false">24:30 </char><char style="xt" closed="false"><ref loc="JOS 19:49-50">Iya 19:49-50</ref></char></note><verse eid="JOS 24:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JOS 24:31" />Iyaasoy paxa diza wode ubbaan, Iyaasoppe simmiin de7ida asatinne GODAY Isra7eeletas ooththida ooso ubbaa eriza cimati diza wode ubbaan Isra7eele asay GODAAS goynnides.<verse eid="JOS 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 24:32" />Isra7eele asay Gibxe biittafe ehida Yooseefe meqeththaa Seekeemen moogida. He sohoza Yaaqoobey Seekeeme aawa Emooreppe 100 saqile biran shammides; histtiin guyeppe Yooseefe zereththatas xinxxo gidides.<note caller="-" style="x"><char style="xo" closed="false">24:32 </char><char style="xt" closed="false"><ref loc="GEN 33:19">Medhe 33:19</ref>; <ref loc="GEN 50:24-25">50:24-25</ref>; <ref loc="EXO 13:19">Kessa 13:19</ref>; <ref loc="JHN 4:5">Yoha 4:5</ref>; <ref loc="ACT 7:16">Hawa 7:16</ref></char></note><verse eid="JOS 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JOS 24:33" />Qasseka Aaroone naa El7ezeerey hayqqides; izikka shaara menththon diza Efreeme deren iza naaza Finihaase saaman gakkida Gibi7a katamaan moogettides.<verse eid="JOS 24:33" /></para>
  <chapter eid="JOS 24" />
</usx>