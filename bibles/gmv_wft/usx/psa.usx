<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- Gamo Full Bible final version</book>
  <para style="h">Mazamure Maxaafa</para>
  <para style="toc1">Mazamure Maxaafa</para>
  <para style="toc2">Mazamure Maxaafa</para>
  <para style="toc3">Maza</para>
  <para style="mt1">Mazamure Maxaafa</para>
  <para style="imt1">Giddo Qofa</para>
  <para style="ip">Mazamure Maxaafay Geeshsha Maxaafa giddon Mazamurenne woosa maxaafa gididi erettees. Ha maxaafaa giigsidayti adussa wodeta giddon beettida dumma dumma asata. Issi issi mazamureta kawo Dawiti xaafides; ha mazamuretanne ha woosata shiishshidi ba goynniza woden go7ettishe gam7idayti Isra7eele asata. Guuththa wodeppe guye bantta Geeshsha maxaafata giddon gelththida.</para>
  <para style="ip">Haytanti ayanappe xaafettida ginxota qommoy cora; isttika galata galatiza ginxonne Xoossa goynnana go7iza ginxota; Xoossi maaddana mala, naagana malanne saron woththana mala woossiza woosata ginxo; nagarappe maarettanaas shiishshiza woosa ginxota; Xoossa anjjo gishshas yootiza galata sabatanne morkketa qaxxayana mala Xoossas yootiza magana ginxota. Ha woosati issi asi barkka woossida woosatanne cora asay issife woossida woosata. Isttafe issoti issoti issi issi asaa wozinan siyettida mishota qonccisizayta. Harati qasse Xoossa asay ubbay koyzayssanne as ubbaas siyettiza hanoteth bessizayta.</para>
  <para style="ip">Yesusi tamaarsishe Mazamure maxaafappe bochchi bochchi ekkidi tamaarsides. Ooraththa Caaqo maxaafata xaafidaytikka izan xaafettidayssafe ba xaafiza maxaafa giddo gelththida. Woosa keeththaya eqqosofe doommada Mazamure Maxaafaa Xoossas goynniza wode go7ettiza gita minjja miishsha mala oykkadus.</para>
  <para style="iot">Ha maxaafay oykkida kumeththa qofa</para>
  <para style="ip">Mazamure maxaafay ichchash kifiletan shaakettees; dariza baggata koyro kifiletanne nam7anththo kifileta xaafiday kawo Dawite. Heedzdzanththo kifileza xaafiday Aasaafe woykko Qoore nayta.</para>
  <para style="ip">Mazamure 120-134 gakkanaas diza mazamureti ba7aale bonchchos yexettiza mazamureta; hayssafe kaallidi maxaafazi ichchash kifiletan shaakettidayssi qonccides.</para>
  <para style="io1">Mazamure <char style="ior"><ref loc="PSA 1-41">1—41</ref> </char></para>
  <para style="io1">Mazamure <char style="ior"><ref loc="PSA 42-72">42—72</ref> </char></para>
  <para style="io1">Mazamure <char style="ior"><ref loc="PSA 73-89">73—89</ref> </char></para>
  <para style="io1">Mazamure <char style="ior"><ref loc="PSA 90-106">90—106</ref> </char></para>
  <para style="io1">Mazamure <char style="ior"><ref loc="PSA 107-150">107—150</ref> </char></para>
  <chapter number="1" style="c" sid="PSA 1" />
  <para style="ms">Koyro Maxaafa</para>
  <para style="mr">(<ref loc="PSA 1-41">Maza 1—41</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1" />Iitata zoren bonttay,</para>
  <para style="q2" vid="PSA 1:1">woykko nagaranchchata</para>
  <para style="q2" vid="PSA 1:1">ogen eqqonttay,</para>
  <para style="q2" vid="PSA 1:1">qilccizayta shiiqon</para>
  <para style="q2" vid="PSA 1:1">uttonttay anjjettidaade.<verse eid="PSA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2" />Hessa mala asi</para>
  <para style="q2" vid="PSA 1:2">GODAA wogan ufayettees;</para>
  <para style="q2" vid="PSA 1:2">iza wogaa gallassinne</para>
  <para style="q2" vid="PSA 1:2">qamma qoppees.<verse eid="PSA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3" />Hessaadey goggiza haaththa</para>
  <para style="q2" vid="PSA 1:3">achchan tokettidi,</para>
  <para style="q2" vid="PSA 1:3">hayththika qokkontta</para>
  <para style="q2" vid="PSA 1:3">woden woden ayfe ayfiza</para>
  <para style="q2" vid="PSA 1:3">miththa mala;</para>
  <para style="q2" vid="PSA 1:3">izi ooththiza ubbay izas hanees.<note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="JER 17:8">Er 17:8</ref></char></note><verse eid="PSA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4" />Gido attiin iitati</para>
  <para style="q2" vid="PSA 1:4">hessa mala gidettenna;</para>
  <para style="q2" vid="PSA 1:4">carkoy pitti efiza suulla mala.<verse eid="PSA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5" />Hessa gishshas iitata bolla</para>
  <para style="q2" vid="PSA 1:5">GODAY pirdana;</para>
  <para style="q2" vid="PSA 1:5">nagaranchchatikka</para>
  <para style="q2" vid="PSA 1:5">xillota shiiqon eqqettenna.<verse eid="PSA 1:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6" />Ays giikko GODAY</para>
  <para style="q2" vid="PSA 1:6">xillota oge erees;</para>
  <para style="q2" vid="PSA 1:6">gido attiin iitata ogey</para>
  <para style="q2" vid="PSA 1:6">istta dhayon gaththees.<verse eid="PSA 1:6" /></para>
  <chapter eid="PSA 1" />
  <chapter number="2" style="c" sid="PSA 2" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1" />Kawoteththati ays dendizoo?</para>
  <para style="q2" vid="PSA 2:1">Qasse kawoteththay</para>
  <para style="q2" vid="PSA 2:1">ays iita ooththanaas maqettizee?<verse eid="PSA 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2" />Sa7a kawotinne daannati dendida;</para>
  <para style="q2" vid="PSA 2:2">istti GODAA bollanne</para>
  <para style="q2" vid="PSA 2:2">GODAY tiydayssa bolla</para>
  <para style="q2" vid="PSA 2:2">dendanaas issife duulatida.<note caller="-" style="x"><char style="xo" closed="false">2:1-2 </char><char style="xt" closed="false"><ref loc="ACT 4:25-26">Hawa 4:25-26</ref></char></note><verse eid="PSA 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3" />Istti, «Ane nuni</para>
  <para style="q2" vid="PSA 2:3">istta sansalataa duuththoos;</para>
  <para style="q2" vid="PSA 2:3">istti nuna qachchizayssaka</para>
  <para style="q2" vid="PSA 2:3">kessi wora oloos» geettes.<verse eid="PSA 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4" />Salon ba araata bolla uttidayssi</para>
  <para style="q2" vid="PSA 2:4">istta bolla miiccees;</para>
  <para style="q2" vid="PSA 2:4">Goday istta qidhees.<verse eid="PSA 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5" />Goday ba hanqon istta seerees;</para>
  <para style="q2" vid="PSA 2:5">ba wolqqama hanqon</para>
  <para style="q2" vid="PSA 2:5">istta daganththees.<verse eid="PSA 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PSA 2:6" />Goday, «Tani ta geeshsha zuma</para>
  <para style="q2" vid="PSA 2:6">Xiyoone bolla ta kawoza</para>
  <para style="q2" vid="PSA 2:6">kawoththadis» gees.<verse eid="PSA 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PSA 2:7" />He kawoy, «Tani GODAA</para>
  <para style="q2" vid="PSA 2:7">woga awajjana;</para>
  <para style="q2" vid="PSA 2:7">GODAY tana, ‹Neni ta naa;</para>
  <para style="q2" vid="PSA 2:7">tani nena hach yeladis.<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="ACT 13:33">Hawa 13:33</ref>; <ref loc="HEB 1:5">Ib 1:5</ref>; <ref loc="HEB 5:5">5:5</ref></char></note><verse eid="PSA 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8" />Neni tana oychcha;</para>
  <para style="q2" vid="PSA 2:8">tani kawoteththa ubbaa</para>
  <para style="q2" vid="PSA 2:8">nees immana;</para>
  <para style="q2" vid="PSA 2:8">sa7a ubbay nees gidana.<verse eid="PSA 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9" />Neni birata guufen</para>
  <para style="q2" vid="PSA 2:9">istta qoxereththana;</para>
  <para style="q2" vid="PSA 2:9">istta neni mana miishshi</para>
  <para style="q2" vid="PSA 2:9">meqqiza mala</para>
  <para style="q2" vid="PSA 2:9">menththereththana› gees» gides.<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="REV 2:26-27">Ajju 2:26-27</ref>; <ref loc="REV 12:5">12:5</ref>; <ref loc="REV 19:15">19:15</ref></char></note><verse eid="PSA 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10" />Hessa gishshas intteno</para>
  <para style="q2" vid="PSA 2:10">kawotoo akeekite;</para>
  <para style="q2" vid="PSA 2:10">ha sa7a haarizaytoo</para>
  <para style="q2" vid="PSA 2:10">intte naagettite!<verse eid="PSA 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11" />GODAAS yashshateththan ooththite;</para>
  <para style="q2" vid="PSA 2:11">izas kokkorsan haarettite.<verse eid="PSA 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12" />GODAY hanqettiin</para>
  <para style="q2" vid="PSA 2:12">ogen intte dhayontta mala</para>
  <para style="q2" vid="PSA 2:12">izas suure wozinan goynnite;</para>
  <para style="q2" vid="PSA 2:12">ays giikko iza hanqoy</para>
  <para style="q2" vid="PSA 2:12">eeson eexxi kezana.</para>
  <para style="q2" vid="PSA 2:12">Iza banttas zemppo</para>
  <para style="q2" vid="PSA 2:12">ooththizayti anjjettidayta.<verse eid="PSA 2:12" /></para>
  <chapter eid="PSA 2" />
  <chapter number="3" style="c" sid="PSA 3" />
  <para style="s1">Dawiti Ba Naa Abeseloomeppe Baqatishe Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1" />GODAWU! Ta morkketi</para>
  <para style="q2" vid="PSA 3:1">ay keena corattidoo!</para>
  <para style="q2" vid="PSA 3:1">Ta bolla aappunati dendidoo!<verse eid="PSA 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2" />Daroti, «Xoossi iza ashshenna»</para>
  <para style="q2" vid="PSA 3:2">giidi ta bolla haasayda.<verse eid="PSA 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3" />Gido attiin GODAWU!</para>
  <para style="q2" vid="PSA 3:3">Neni ta yuushon gondalle.</para>
  <para style="q2" vid="PSA 3:3">Tana bonchchisizaynne</para>
  <para style="q2" vid="PSA 3:3">minththeththizay nena.<verse eid="PSA 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4" />Tani ta qaala dhoqqisada</para>
  <para style="q2" vid="PSA 3:4">GODAAKKO waassana;</para>
  <para style="q2" vid="PSA 3:4">histtiko izi ba geeshsha</para>
  <para style="q2" vid="PSA 3:4">zuma bolla dishe</para>
  <para style="q2" vid="PSA 3:4">ta woosa siyana.<verse eid="PSA 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5" />GODAY tana naagiza gishshas,</para>
  <para style="q2" vid="PSA 3:5">tani ichchada dhiskayssinne</para>
  <para style="q2" vid="PSA 3:5">beegottays.<verse eid="PSA 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6" />Tani tana giddoththi uttida</para>
  <para style="q2" vid="PSA 3:6">cora morkketaska babbike.<verse eid="PSA 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7" />Abeet GODAWU! Denda!</para>
  <para style="q2" vid="PSA 3:7">Abeet ta Xoossawu! Tana ashsha!</para>
  <para style="q2" vid="PSA 3:7">Neni ta morkketa</para>
  <para style="q2" vid="PSA 3:7">ubbaa banqila shoca;</para>
  <para style="q2" vid="PSA 3:7">iitata achchaaka menththa.<verse eid="PSA 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8" />Maadoy GODAASSA;</para>
  <para style="q2" vid="PSA 3:8">GODAWU ne anjjoy</para>
  <para style="q2" vid="PSA 3:8">ne deraa bolla gido.<note caller="-" style="x"><char style="xo" closed="false">3:1-8 </char><char style="xt" closed="false"><ref loc="2SA 15:13-17:22">2Same 15:13—17:22</ref></char></note><verse eid="PSA 3:8" /></para>
  <chapter eid="PSA 3" />
  <chapter number="4" style="c" sid="PSA 4" />
  <para style="s1">Dawiti Zammareta Kaabbos Osppun Shayan Waaxettida Diiththan Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 4:1" />Abeet ta xillo Xoossawu!</para>
  <para style="q2" vid="PSA 4:1">Tani xeygiza wode</para>
  <para style="q2" vid="PSA 4:1">ne taas koya.</para>
  <para style="q2" vid="PSA 4:1">Tani un7ettida wode,</para>
  <para style="q2" vid="PSA 4:1">neni tana shempisadasa;</para>
  <para style="q2" vid="PSA 4:1">taas qadhettada ta woosa siya.<verse eid="PSA 4:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2" />Intteno asatoo!</para>
  <para style="q2" vid="PSA 4:2">Intte awude gakkanaas</para>
  <para style="q2" vid="PSA 4:2">ta bonchcho kawushshanee?</para>
  <para style="q2" vid="PSA 4:2">Intte awude gakkanaas</para>
  <para style="q2" vid="PSA 4:2">hada miish siiqanee?</para>
  <para style="q2" vid="PSA 4:2">Intte awude gakkanaas</para>
  <para style="q2" vid="PSA 4:2">wordo miish kaallanee?<verse eid="PSA 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3" />GODAY xillo asata</para>
  <para style="q2" vid="PSA 4:3">baas shaakki</para>
  <para style="q2" vid="PSA 4:3">dumma woththidayssa</para>
  <para style="q2" vid="PSA 4:3">intte erite;</para>
  <para style="q2" vid="PSA 4:3">hessa gishshas tani GODAA</para>
  <para style="q2" vid="PSA 4:3">xeygiza wode</para>
  <para style="q2" vid="PSA 4:3">izi taas siyees.<verse eid="PSA 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4" />Hanqettite; gido attiin</para>
  <para style="q2" vid="PSA 4:4">intte hanqon</para>
  <para style="q2" vid="PSA 4:4">nagara ooththofte.</para>
  <para style="q2" vid="PSA 4:4">Hiixan ichchi diza wode</para>
  <para style="q2" vid="PSA 4:4">sirphi giidi</para>
  <para style="q2" vid="PSA 4:4">intte wozina qorite.<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="EPH 4:26">Efe 4:26</ref></char></note><verse eid="PSA 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5" />GODAAS bessiza yarsho yarshite;</para>
  <para style="q2" vid="PSA 4:5">GODAANKKA Xoossankka</para>
  <para style="q2" vid="PSA 4:5">ammanettite.<verse eid="PSA 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6" />Daroti, «Nuna</para>
  <para style="q2" vid="PSA 4:6">lo7o bessanay</para>
  <para style="q2" vid="PSA 4:6">oonee?» geettes;</para>
  <para style="q2" vid="PSA 4:6">Abeet GODAWU!</para>
  <para style="q2" vid="PSA 4:6">Ne lo7o ayfesoy</para>
  <para style="q2" vid="PSA 4:6">nu bolla poo7o.<verse eid="PSA 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7" />Kaththinne woyne ushshu</para>
  <para style="q2" vid="PSA 4:7">daro demmidi</para>
  <para style="q2" vid="PSA 4:7">harati ufayettizayssafe aaththada</para>
  <para style="q2" vid="PSA 4:7">neni ta wozina</para>
  <para style="q2" vid="PSA 4:7">ufayssan kunththadasa.<verse eid="PSA 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 4:8">Ne xalla tana saron naaga</para>
  <para style="q2" vid="PSA 4:8">ayssiza gishshas</para>
  <para style="q2" vid="PSA 4:8">tani ichchada saroteththan</para>
  <para style="q2" vid="PSA 4:8">dhiskays.<verse eid="PSA 4:8" /></para>
  <chapter eid="PSA 4" />
  <chapter number="5" style="c" sid="PSA 5" />
  <para style="s1">Dawiti Zammareta Kaabbos Susul7en Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 5:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 5:1">Tani yootizayssa ezga;</para>
  <para style="q2" vid="PSA 5:1">ta un7on woossiza</para>
  <para style="q2" vid="PSA 5:1">woosaakka siya.<verse eid="PSA 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2" />Ta kawozo Xoossoo!</para>
  <para style="q2" vid="PSA 5:2">Ta nena woossiza gishshas</para>
  <para style="q2" vid="PSA 5:2">tana maadda gaada</para>
  <para style="q2" vid="PSA 5:2">ta waassiza waaso ne siya.<verse eid="PSA 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 5:3">Maalado maalado guuran</para>
  <para style="q2" vid="PSA 5:3">neni ta qaala siyaasa.</para>
  <para style="q2" vid="PSA 5:3">Maalado maalado guuran</para>
  <para style="q2" vid="PSA 5:3">tani ta woosa</para>
  <para style="q2" vid="PSA 5:3">ne sinth shiishshada,</para>
  <para style="q2" vid="PSA 5:3">neni taas immiza zaaro</para>
  <para style="q2" vid="PSA 5:3">ekkana gaada naagays.<verse eid="PSA 5:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4" />Neni iitateththan</para>
  <para style="q2" vid="PSA 5:4">ufayettontta Xoossa;</para>
  <para style="q2" vid="PSA 5:4">iitati nenara de7ettenna.<verse eid="PSA 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5" />Ceeqettizayti</para>
  <para style="q2" vid="PSA 5:5">ne sinththan eqqettenna;</para>
  <para style="q2" vid="PSA 5:5">iita miish ooththiza ubbata</para>
  <para style="q2" vid="PSA 5:5">neni ixxaasa.<verse eid="PSA 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 5:6" />Wordo haasayzayta</para>
  <para style="q2" vid="PSA 5:6">neni dhayssaasa.</para>
  <para style="q2" vid="PSA 5:6">Suuth gussizaytanne</para>
  <para style="q2" vid="PSA 5:6">cimmiza asata</para>
  <para style="q2" vid="PSA 5:6">neni harasettaasa.<verse eid="PSA 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7" />Gido attiin tani ne maaro daron</para>
  <para style="q2" vid="PSA 5:7">ne keeththa gelana.</para>
  <para style="q2" vid="PSA 5:7">Ne geeshsha Keeththaako simmada</para>
  <para style="q2" vid="PSA 5:7">bonchchoninne yashshateththan</para>
  <para style="q2" vid="PSA 5:7">nees goynnana.<verse eid="PSA 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8" />Abeet GODAWU! Ta morkketappe</para>
  <para style="q2" vid="PSA 5:8">ne tana ashsha;</para>
  <para style="q2" vid="PSA 5:8">tana ne xilloteththankka</para>
  <para style="q2" vid="PSA 5:8">kaaleththa;</para>
  <para style="q2" vid="PSA 5:8">ne oge ta sinththan suurisa.<verse eid="PSA 5:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9" />Istta doonappe keziza qaalay</para>
  <para style="q2" vid="PSA 5:9">tumu gidenna.</para>
  <para style="q2" vid="PSA 5:9">Istta wozinankka geney kumides;</para>
  <para style="q2" vid="PSA 5:9">istta doonay</para>
  <para style="q2" vid="PSA 5:9">doyettida duufo mala;</para>
  <para style="q2" vid="PSA 5:9">istti bantta inxarsan</para>
  <para style="q2" vid="PSA 5:9">as cimmeettes.<note caller="-" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="ROM 3:13">Oro 3:13</ref></char></note><verse eid="PSA 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10" />Abeet Xoossoo!</para>
  <para style="q2" vid="PSA 5:10">Istta bolla neni pirda;</para>
  <para style="q2" vid="PSA 5:10">istta geney istta ekki bo.</para>
  <para style="q2" vid="PSA 5:10">Istta nagaray daro;</para>
  <para style="q2" vid="PSA 5:10">hessa gishshas</para>
  <para style="q2" vid="PSA 5:10">neni istta goodda digga;</para>
  <para style="q2" vid="PSA 5:10">ays giikko</para>
  <para style="q2" vid="PSA 5:10">istti ne bolla geellattida.<verse eid="PSA 5:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11" />Gido attiin nenan zemppida</para>
  <para style="q2" vid="PSA 5:11">ubbati ufayetetto;</para>
  <para style="q2" vid="PSA 5:11">istti mernaas ufayssan yexxetto.</para>
  <para style="q2" vid="PSA 5:11">Ne sunththa siiqiza</para>
  <para style="q2" vid="PSA 5:11">ubbati ufayetetto;</para>
  <para style="q2" vid="PSA 5:11">isttika nenan naagettetto.<verse eid="PSA 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 5:12">Neni xillota anjjaasa;</para>
  <para style="q2" vid="PSA 5:12">Neni gondallen kammiza mala</para>
  <para style="q2" vid="PSA 5:12">ne kiyateththan istta kammaasa.<verse eid="PSA 5:12" /></para>
  <chapter eid="PSA 5" />
  <chapter number="6" style="c" sid="PSA 6" />
  <para style="s1">Dawiti Zammareta Kaabbos Osppun Shayan Waaxettida Diiththan Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1" />Abeet GODAWU! Yiillon tana seeroppa;</para>
  <para style="q2" vid="PSA 6:1">woykko ne hanqon</para>
  <para style="q2" vid="PSA 6:1">tana qaxxayoppa.<note caller="-" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="PSA 38:1">Maza 38:1</ref></char></note><verse eid="PSA 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 6:2">Tani daaburanchcha gidida</para>
  <para style="q2" vid="PSA 6:2">gishshas tana maara.</para>
  <para style="q2" vid="PSA 6:2">Abeet GODAWU!</para>
  <para style="q2" vid="PSA 6:2">Ta wozinay madunxida gishshas</para>
  <para style="q2" vid="PSA 6:2">tana paththa.<verse eid="PSA 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3" />Ta shemppoya keeha un7ettadus;</para>
  <para style="q2" vid="PSA 6:3">histtiin GODAWU!</para>
  <para style="q2" vid="PSA 6:3">Tana maaddanaas</para>
  <para style="q2" vid="PSA 6:3">neni awude gakkanaas gam7anee?<verse eid="PSA 6:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 6:4">Neni simmada tana ashsha;</para>
  <para style="q2" vid="PSA 6:4">ne maaroteththa daron</para>
  <para style="q2" vid="PSA 6:4">tana kessa ekka.<verse eid="PSA 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5" />Hayqqida asi ooninne</para>
  <para style="q2" vid="PSA 6:5">nena qoppenna;</para>
  <para style="q2" vid="PSA 6:5">duufon nena galatizay deenna.<verse eid="PSA 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6" />Ta ceecen xalla daaburadis;</para>
  <para style="q2" vid="PSA 6:6">omars omars tani yeekkashe</para>
  <para style="q2" vid="PSA 6:6">ta hiixa caphisays;</para>
  <para style="q2" vid="PSA 6:6">ta borkoththaaka</para>
  <para style="q2" vid="PSA 6:6">ta afunththan musissays.<verse eid="PSA 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7" />Ta ayfeti</para>
  <para style="q2" vid="PSA 6:7">daro afunxxida gishshas daaburda;</para>
  <para style="q2" vid="PSA 6:7">ta morkketa ubbaa gaasonkka</para>
  <para style="q2" vid="PSA 6:7">demo ixxida.<verse eid="PSA 6:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8" />GODAY tani yeekkiza yeeho</para>
  <para style="q2" vid="PSA 6:8">siyida gishshas,</para>
  <para style="q2" vid="PSA 6:8">intteno iita ooththiza ubbatoo!</para>
  <para style="q2" vid="PSA 6:8">Taappe haakkite.<note caller="-" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="MAT 7:23">Mato 7:23</ref></char></note><verse eid="PSA 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9" />GODAY ta shoobeththaa be7ides;</para>
  <para style="q2" vid="PSA 6:9">ta woosaakka siyides.<verse eid="PSA 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10" />Ta morkke ubbati</para>
  <para style="q2" vid="PSA 6:10">yeellatananne dagammana;</para>
  <para style="q2" vid="PSA 6:10">qoppontta kawuyidi guye simmana.<verse eid="PSA 6:10" /></para>
  <chapter eid="PSA 6" />
  <chapter number="7" style="c" sid="PSA 7" />
  <para style="s1">Biniyaame Zare Kuuze Gaason Dawiti Godaakko Zilalida Zilas</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 7:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 7:1">Ta Xoossawu neni taas qotettizaso;</para>
  <para style="q2" vid="PSA 7:1">tana gooddiza ubbaafe</para>
  <para style="q2" vid="PSA 7:1">neni tana ashsha.<verse eid="PSA 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2" />Neni tana ashshontta aggiko,</para>
  <para style="q2" vid="PSA 7:2">istti tana gaammo mala</para>
  <para style="q2" vid="PSA 7:2">menththereththidi,</para>
  <para style="q2" vid="PSA 7:2">ooninne ashshonttason</para>
  <para style="q2" vid="PSA 7:2">puuzereththana.<verse eid="PSA 7:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3-4" style="v" sid="PSA 7:3-4" />Abeet GODAWU ta Xoossawu!</para>
  <para style="q2" vid="PSA 7:3-4">Tani as qohidaa gidikko,</para>
  <para style="q2" vid="PSA 7:3-4">taas lo7o ooththidaades</para>
  <para style="q2" vid="PSA 7:3-4">iita zaaridaa gidikko,</para>
  <para style="q2" vid="PSA 7:3-4">woykko gaasoykka baynda</para>
  <para style="q2" vid="PSA 7:3-4">ta morkkefe bonqqidaa gidikko,</para>
  <para style="q2" vid="PSA 7:3-4">heyta mala yo7otappe issinokka</para>
  <para style="q2" vid="PSA 7:3-4">tani ooththidaa gidikko,<verse eid="PSA 7:3-4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 7:5" />ta morkkey tana gooddi oykko;</para>
  <para style="q2" vid="PSA 7:5">tana sa7ankka yedhereththo;</para>
  <para style="q2" vid="PSA 7:5">tana biittan yeggidi</para>
  <para style="q2" vid="PSA 7:5">ta bonchcho kawushsho.<verse eid="PSA 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 7:6">Ne hanqon denda eqqa;</para>
  <para style="q2" vid="PSA 7:6">eexxiza ta morkketa</para>
  <para style="q2" vid="PSA 7:6">hanqo bolla denda;</para>
  <para style="q2" vid="PSA 7:6">ta Xoossawu beegga;</para>
  <para style="q2" vid="PSA 7:6">tumu pirda pirda.<verse eid="PSA 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7" />Dereta duulatay</para>
  <para style="q2" vid="PSA 7:7">ne yuushozan shiiqo;</para>
  <para style="q2" vid="PSA 7:7">neni istta bolla kawota.<verse eid="PSA 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 7:8" />GODAY kawoteththata bolla pirdees.</para>
  <para style="q2" vid="PSA 7:8">Abeet GODAWU!</para>
  <para style="q2" vid="PSA 7:8">Taas ta xilloteththa malanne</para>
  <para style="q2" vid="PSA 7:8">ta suureteththa mala pirda.<verse eid="PSA 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9" />Qofanne wozina pilgga eriza</para>
  <para style="q2" vid="PSA 7:9">xillo Xoossawu!</para>
  <para style="q2" vid="PSA 7:9">Iitata geneza neni dhayssa;</para>
  <para style="q2" vid="PSA 7:9">gido attiin xillota saron naaga.<note caller="-" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="REV 2:23">Ajju 2:23</ref></char></note><verse eid="PSA 7:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10" />Xoossi taas gondalle;</para>
  <para style="q2" vid="PSA 7:10">wozina xillota</para>
  <para style="q2" vid="PSA 7:10">izi ashshiza Xoossa.<verse eid="PSA 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11" />Xoossay xillo pirdiza Xoossa;</para>
  <para style="q2" vid="PSA 7:11">izi gallas gallas</para>
  <para style="q2" vid="PSA 7:11">ba hanqo qonccisiza Xoossa.<verse eid="PSA 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12" />Asi ba nagara paaxidi</para>
  <para style="q2" vid="PSA 7:12">simmontta aggiko,</para>
  <para style="q2" vid="PSA 7:12">Xoossi ba mashsha leefees;</para>
  <para style="q2" vid="PSA 7:12">izi ba wondafeza</para>
  <para style="q2" vid="PSA 7:12">dafi oykkees.<verse eid="PSA 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13" />Izi wodhiza ola</para>
  <para style="q2" vid="PSA 7:13">miishshata giigssees;</para>
  <para style="q2" vid="PSA 7:13">tama laco mala</para>
  <para style="q2" vid="PSA 7:13">popol7u giza</para>
  <para style="q2" vid="PSA 7:13">ba toora yiishshaa giigssees.<verse eid="PSA 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14" />Iitateth shaaridi,</para>
  <para style="q2" vid="PSA 7:14">gene qanththatiday wordo yelees.<verse eid="PSA 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15" />Hara asatas olla bookkida asi</para>
  <para style="q2" vid="PSA 7:15">ba bookkida ollan</para>
  <para style="q2" vid="PSA 7:15">simmi kundees.<verse eid="PSA 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16" />Izi ehiza geney</para>
  <para style="q2" vid="PSA 7:16">iza hu7es simmees;</para>
  <para style="q2" vid="PSA 7:16">iza makkallaykka simmidi</para>
  <para style="q2" vid="PSA 7:16">izas gidees.<verse eid="PSA 7:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17" />GODAA xilloteththa gishshas</para>
  <para style="q2" vid="PSA 7:17">tani iza galatana;</para>
  <para style="q2" vid="PSA 7:17">qasse Ubbaafe Dhoqqa</para>
  <para style="q2" vid="PSA 7:17">GODAA sunththas</para>
  <para style="q2" vid="PSA 7:17">tani galata mazamure yexxana.<verse eid="PSA 7:17" /></para>
  <chapter eid="PSA 7" />
  <chapter number="8" style="c" sid="PSA 8" />
  <para style="s1">Dawiti Zammareta Kaabbos Susul7en Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 8:1">Nu Godawu ne sunththi</para>
  <para style="q2" vid="PSA 8:1">biitta ubbaan keehi</para>
  <para style="q2" vid="PSA 8:1">bonchchettides;</para>
  <para style="q2" vid="PSA 8:1">neni ne bonchcho</para>
  <para style="q2" vid="PSA 8:1">salotappe bollan</para>
  <para style="q2" vid="PSA 8:1">dhoqqu dhoqqu histta</para>
  <para style="q2" vid="PSA 8:1">woththadasa.<verse eid="PSA 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2" />Neni ne morkketa gishshas</para>
  <para style="q2" vid="PSA 8:2">ne baalgaaranne</para>
  <para style="q2" vid="PSA 8:2">ne bolla mandizayssa</para>
  <para style="q2" vid="PSA 8:2">sirphi ooththanawu</para>
  <para style="q2" vid="PSA 8:2">guuththa nayta doonaninne</para>
  <para style="q2" vid="PSA 8:2">dhammiza nayta doonan</para>
  <para style="q2" vid="PSA 8:2">galata kunththadasa.<note caller="-" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="MAT 21:16">Mato 21:16</ref></char></note><verse eid="PSA 8:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3" />Neni ne kushen medhdhida salota,</para>
  <para style="q2" vid="PSA 8:3">sohon sohon neni</para>
  <para style="q2" vid="PSA 8:3">woththida aginanne</para>
  <para style="q2" vid="PSA 8:3">xoolintteta tani be7iza wode,<verse eid="PSA 8:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 8:4" />neni asas qoppanawu asi aazee?</para>
  <para style="q2" vid="PSA 8:4">Woykko neni asa naas</para>
  <para style="q2" vid="PSA 8:4">wudettanawu izi aazee?<note caller="-" style="x"><char style="xo" closed="false">8:4 </char><char style="xt" closed="false"><ref loc="JOB 7:17-18">Iyo 7:17-18</ref>; <ref loc="PSA 144:3">Maza 144:3</ref>; <ref loc="HEB 2:6-8">Ib 2:6-8</ref></char></note><verse eid="PSA 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5" />Iza neni kiitanchchatappe<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">Kiitanchchatappe gizayssa issi issi geeshsha maxaafati Xoossafe geettes.</char></note></para>
  <para style="q2" vid="PSA 8:5">guuththara ziqqisadasa;</para>
  <para style="q2" vid="PSA 8:5">bonchchonne gitateththa</para>
  <para style="q2" vid="PSA 8:5">kallachcha</para>
  <para style="q2" vid="PSA 8:5">iza hu7en goxxisadasa.<verse eid="PSA 8:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6" />Iza neni ne medhdhida</para>
  <para style="q2" vid="PSA 8:6">medheteththa ubbaa bollan</para>
  <para style="q2" vid="PSA 8:6">haarizaade ooththada</para>
  <para style="q2" vid="PSA 8:6">sunththadasa;</para>
  <para style="q2" vid="PSA 8:6">ubbaaka izas haarisadasa.<note caller="-" style="x"><char style="xo" closed="false">8:6 </char><char style="xt" closed="false"><ref loc="1CO 15:27">1Qoro 15:27</ref>; <ref loc="EPH 1:22">Efe 1:22</ref>; <ref loc="HEB 2:8">Ib 2:8</ref></char></note><verse eid="PSA 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7" />Dorsatanne miizata,</para>
  <para style="q2" vid="PSA 8:7">do7a ubbaa,<verse eid="PSA 8:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 8:8" />salo kafota, abba moletanne</para>
  <para style="q2" vid="PSA 8:8">abba giddon diza medheta</para>
  <para style="q2" vid="PSA 8:8">ubbaaka izas haarisadasa.<verse eid="PSA 8:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9" />Abeet nu GODAA Xoossawu!</para>
  <para style="q2" vid="PSA 8:9">Ne sunththi biitta ubbaa bolla</para>
  <para style="q2" vid="PSA 8:9">keehi bonchchettides.<verse eid="PSA 8:9" /></para>
  <chapter eid="PSA 8" />
  <chapter number="9" style="c" sid="PSA 9" />
  <para style="s1">Naa Hayqo Giigiso Geetettiza Yeththan Dawiti Zammareta Kaabbos Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 9:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 9:1">Tani nena kumeththa</para>
  <para style="q2" vid="PSA 9:1">wozinappe galatana;</para>
  <para style="q2" vid="PSA 9:1">malalisiza ne oosoza</para>
  <para style="q2" vid="PSA 9:1">ubbaaka ta yootana.<verse eid="PSA 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2" />Tani nenan ufayettananne</para>
  <para style="q2" vid="PSA 9:2">hashshu gaana.</para>
  <para style="q2" vid="PSA 9:2">Ubbaafe Dhoqqa Xoossawu!</para>
  <para style="q2" vid="PSA 9:2">Tani ne sunththas</para>
  <para style="q2" vid="PSA 9:2">galata mazamure yexxana.<verse eid="PSA 9:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3" />Ne qoncciza wode</para>
  <para style="q2" vid="PSA 9:3">ta morkketi guye simmana;</para>
  <para style="q2" vid="PSA 9:3">ne sinththafekka</para>
  <para style="q2" vid="PSA 9:3">dhuphetti dhayana.<verse eid="PSA 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4" />Neni taas xillo pirda pirdadasa;</para>
  <para style="q2" vid="PSA 9:4">neni xilloteththan pirdashe</para>
  <para style="q2" vid="PSA 9:4">ne kawoteththa araatan uttadasa.<verse eid="PSA 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5" />Neni kawoteththata seeradasa;</para>
  <para style="q2" vid="PSA 9:5">iitatakka dhayssadasa;</para>
  <para style="q2" vid="PSA 9:5">neni istta sunththaa</para>
  <para style="q2" vid="PSA 9:5">meri mernaaskka qucca diggadasa.<verse eid="PSA 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6" />Morkketi meri mernaas dhayda;</para>
  <para style="q2" vid="PSA 9:6">istta katamatakka</para>
  <para style="q2" vid="PSA 9:6">mulera dhoqalla dhayssadasa;</para>
  <para style="q2" vid="PSA 9:6">istti mulera dogetti attida.<verse eid="PSA 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7" />Gido attiin GODAY</para>
  <para style="q2" vid="PSA 9:7">mernaas kawotidi dees;</para>
  <para style="q2" vid="PSA 9:7">izi pirdanaas</para>
  <para style="q2" vid="PSA 9:7">ba araata giigsides.<verse eid="PSA 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8" />Izi ha alameza</para>
  <para style="q2" vid="PSA 9:8">xilloteththan pirdana;</para>
  <para style="q2" vid="PSA 9:8">kawoteththata bollaka</para>
  <para style="q2" vid="PSA 9:8">tumateththan pirdana.<verse eid="PSA 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9" />GODAY un7ettidaytas</para>
  <para style="q2" vid="PSA 9:9">baqati attizaso;</para>
  <para style="q2" vid="PSA 9:9">meto wodetankka</para>
  <para style="q2" vid="PSA 9:9">qotetti attizaso.<verse eid="PSA 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10" />Ne sunththa erizayti</para>
  <para style="q2" vid="PSA 9:10">nenan ammanetteettes;</para>
  <para style="q2" vid="PSA 9:10">ays giikko GODAWU!</para>
  <para style="q2" vid="PSA 9:10">Neni nena koyzayta</para>
  <para style="q2" vid="PSA 9:10">yegga aggabeekka.<verse eid="PSA 9:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11" />Xiyoonen kawoti uttida GODAAS</para>
  <para style="q2" vid="PSA 9:11">galata mazamure yexxite;</para>
  <para style="q2" vid="PSA 9:11">izi ooththida ooso</para>
  <para style="q2" vid="PSA 9:11">dere ubbaas qonccen yootite.<verse eid="PSA 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12" />Ays giikko suuth gussizaytas</para>
  <para style="q2" vid="PSA 9:12">halo kessiza Xoossi</para>
  <para style="q2" vid="PSA 9:12">naaqettidayta waasoza</para>
  <para style="q2" vid="PSA 9:12">izi dogenna.<verse eid="PSA 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 9:13">ta morkketi</para>
  <para style="q2" vid="PSA 9:13">tana yedeththizayssa be7a.</para>
  <para style="q2" vid="PSA 9:13">Neni taas qadhettada</para>
  <para style="q2" vid="PSA 9:13">hayqoppe tana ashsha.<verse eid="PSA 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14" />Hessika tani Xiyoone asa karen</para>
  <para style="q2" vid="PSA 9:14">eqqada nena galatanaassinne</para>
  <para style="q2" vid="PSA 9:14">ne ashshidayssan</para>
  <para style="q2" vid="PSA 9:14">keeha ufayettanaassa.<verse eid="PSA 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15" />Kawoteththay ba bookkida</para>
  <para style="q2" vid="PSA 9:15">ollan kundides.</para>
  <para style="q2" vid="PSA 9:15">Istti qotti woththida woximadey</para>
  <para style="q2" vid="PSA 9:15">istta toho oykkides.<verse eid="PSA 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16" />GODAY ba xillo pirdan erettides;</para>
  <para style="q2" vid="PSA 9:16">iita asi ba kushen ooththida</para>
  <para style="q2" vid="PSA 9:16">ooso woximaden oykettides.<verse eid="PSA 9:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17" />Iitati si7oolen gelana;</para>
  <para style="q2" vid="PSA 9:17">Xoossa dogiza kawoteththay</para>
  <para style="q2" vid="PSA 9:17">ubbayka istta mala hanana.<verse eid="PSA 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18" />Hiyeesati aydekka</para>
  <para style="q2" vid="PSA 9:18">dogetti attettenna;</para>
  <para style="q2" vid="PSA 9:18">woykko manqota hidotay</para>
  <para style="q2" vid="PSA 9:18">coo mernaas dhayenna.<verse eid="PSA 9:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 9:19">Kawoteththati ba wolqqan dendidi</para>
  <para style="q2" vid="PSA 9:19">ne bolla ceeqettontta mala</para>
  <para style="q2" vid="PSA 9:19">neni istta bolla pirda.<verse eid="PSA 9:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 9:20">Ne istta daganththa;</para>
  <para style="q2" vid="PSA 9:20">istti as gididayssa</para>
  <para style="q2" vid="PSA 9:20">neni istta erisa.<verse eid="PSA 9:20" /></para>
  <chapter eid="PSA 9" />
  <chapter number="10" style="c" sid="PSA 10" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 10:1">Ne ays haakkada eqqay?</para>
  <para style="q2" vid="PSA 10:1">Meto wodenkka ays geemmay?<verse eid="PSA 10:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2" />Iita asati otoretteettes;</para>
  <para style="q2" vid="PSA 10:2">hiyeesatakka yedeththeettes;</para>
  <para style="q2" vid="PSA 10:2">istti haras woththida woximaden</para>
  <para style="q2" vid="PSA 10:2">zaari oykettetto.<verse eid="PSA 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3" />Iita asi ba wozina</para>
  <para style="q2" vid="PSA 10:3">amon ceeqettees;</para>
  <para style="q2" vid="PSA 10:3">Yoray GODAA cayeessinne</para>
  <para style="q2" vid="PSA 10:3">kaddees.<verse eid="PSA 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4" />Iita asi otoreteththan</para>
  <para style="q2" vid="PSA 10:4">Xoossa koyenna;</para>
  <para style="q2" vid="PSA 10:4">iza qofa ubbaan Xoossi deenna.<verse eid="PSA 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5" />Ubbaa miishshi izas kumees;</para>
  <para style="q2" vid="PSA 10:5">ne wogay izas gelenna;</para>
  <para style="q2" vid="PSA 10:5">otoranchchay</para>
  <para style="q2" vid="PSA 10:5">ne wogappe haakkees;</para>
  <para style="q2" vid="PSA 10:5">hessa gishshas</para>
  <para style="q2" vid="PSA 10:5">ba morkketa bollan</para>
  <para style="q2" vid="PSA 10:5">izi qilccees.<verse eid="PSA 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6" />Ba wozinan izi,</para>
  <para style="q2" vid="PSA 10:6">«Tana aykkoyka qaaththenna;</para>
  <para style="q2" vid="PSA 10:6">tana mulekka metoy gakkenna»</para>
  <para style="q2" vid="PSA 10:6">giidi qoppees.<verse eid="PSA 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7" />Iza doonan qanggeththi,</para>
  <para style="q2" vid="PSA 10:7">wordoynne mandey kumides;</para>
  <para style="q2" vid="PSA 10:7">iza inxarsan geneynne</para>
  <para style="q2" vid="PSA 10:7">baleththoy dees.<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="ROM 3:14">Oro 3:14</ref></char></note><verse eid="PSA 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8" />Dere giddon geemason zuggi uttees;</para>
  <para style="q2" vid="PSA 10:8">maadoy bayndayta</para>
  <para style="q2" vid="PSA 10:8">dhayssanaas naagettees;</para>
  <para style="q2" vid="PSA 10:8">xillo asata geeman wodhees.<verse eid="PSA 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 10:9" />Ba qotettizason geemmidi,</para>
  <para style="q2" vid="PSA 10:9">hiyeesa oykkanawu</para>
  <para style="q2" vid="PSA 10:9">gaammo mala zuggees;</para>
  <para style="q2" vid="PSA 10:9">maadoy bayndayta ba woximaden</para>
  <para style="q2" vid="PSA 10:9">oykkidi goochchi efees.<verse eid="PSA 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10" />Maadoy bayndaynne</para>
  <para style="q2" vid="PSA 10:10">hiyeesay iza kushen kundees;</para>
  <para style="q2" vid="PSA 10:10">izikka istta</para>
  <para style="q2" vid="PSA 10:10">nippi histti menththereththees.<verse eid="PSA 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11" />Iita asi ba wozinan,</para>
  <para style="q2" vid="PSA 10:11">«Xoossi tana dogides;</para>
  <para style="q2" vid="PSA 10:11">ba sinththaa taappe genththides;</para>
  <para style="q2" vid="PSA 10:11">mulekka izi tana be7enna» gees.<verse eid="PSA 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12" />Abeet GODAWU! Denda.</para>
  <para style="q2" vid="PSA 10:12">Xoossoo! Ne kusheza</para>
  <para style="q2" vid="PSA 10:12">dhoqqu histta denththa;</para>
  <para style="q2" vid="PSA 10:12">maadoy baynda</para>
  <para style="q2" vid="PSA 10:12">metotanchchata dogoppa.<verse eid="PSA 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13" />Iita asi Xoossa ays kadhizee?</para>
  <para style="q2" vid="PSA 10:13">Ba wozinankka,</para>
  <para style="q2" vid="PSA 10:13">«Xoossi tana qaxxayenna»</para>
  <para style="q2" vid="PSA 10:13">ays gizee?<verse eid="PSA 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14" />Gido attiin Xoossoo!</para>
  <para style="q2" vid="PSA 10:14">Neni metozanne</para>
  <para style="q2" vid="PSA 10:14">waayezakka beyaasa;</para>
  <para style="q2" vid="PSA 10:14">neni ubba wode</para>
  <para style="q2" vid="PSA 10:14">maaddanaas giiga uttadasa;</para>
  <para style="q2" vid="PSA 10:14">neni yi7ota maaddaasa;</para>
  <para style="q2" vid="PSA 10:14">maadoy bayndaytikka</para>
  <para style="q2" vid="PSA 10:14">bana nees sheedhdheettes.<verse eid="PSA 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15" />Gene asata wolqqa menththa;</para>
  <para style="q2" vid="PSA 10:15">iita asata wolqqaka liiqisa;</para>
  <para style="q2" vid="PSA 10:15">istti nam7anththo</para>
  <para style="q2" vid="PSA 10:15">iita ooththontta mala</para>
  <para style="q2" vid="PSA 10:15">istta ooso mala istta qaxxaya.<verse eid="PSA 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16" />GODAY merippe mernaas</para>
  <para style="q2" vid="PSA 10:16">kawotidi dees;</para>
  <para style="q2" vid="PSA 10:16">hara kawoteththati</para>
  <para style="q2" vid="PSA 10:16">iza biittafe dhayana.<verse eid="PSA 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 10:17">Neni hiyeesata amo eraasa;</para>
  <para style="q2" vid="PSA 10:17">istta woosaakka siyada</para>
  <para style="q2" vid="PSA 10:17">minththeththaasa.<verse eid="PSA 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18" />Oonikka istta yashisontta mala</para>
  <para style="q2" vid="PSA 10:18">maadoy bayndaytassinne</para>
  <para style="q2" vid="PSA 10:18">yi7otas ne pirda.<verse eid="PSA 10:18" /></para>
  <chapter eid="PSA 10" />
  <chapter number="11" style="c" sid="PSA 11" />
  <para style="s1">Dawiti Zammareta Kaabbos Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 11:1" />GODAY tani baqata attizaso;</para>
  <para style="q2" vid="PSA 11:1">histtiin intte tana ays,</para>
  <para style="q2" vid="PSA 11:1">«Neni kafo mala</para>
  <para style="q2" vid="PSA 11:1">pude zuma bolla baqata» geetii?<verse eid="PSA 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2" />Nagaranchchati wozina geeshshata</para>
  <para style="q2" vid="PSA 11:2">dhuman caddanaas</para>
  <para style="q2" vid="PSA 11:2">bantta wondafe</para>
  <para style="q2" vid="PSA 11:2">dafi oykkida.<verse eid="PSA 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3" />Yochcha shuchchi<note caller="+" style="f"><char style="fr" closed="false">11:3 </char><char style="fqa" closed="false">Yochcha shuch: </char><char style="ft" closed="false">Yochcha shuch gizayssa issi issi bagga gamoththo qaalan magala shuch, harati qasse baasa gishin hessika amaraththo qaalara masarate geetettees.</char></note> woddiza wode,</para>
  <para style="q2" vid="PSA 11:3">xilloy ay ooththanawu</para>
  <para style="q2" vid="PSA 11:3">dandayzee?<verse eid="PSA 11:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4" />GODAY ba geeshsha</para>
  <para style="q2" vid="PSA 11:4">Keeththan dees;</para>
  <para style="q2" vid="PSA 11:4">salon ba araatan uttidi</para>
  <para style="q2" vid="PSA 11:4">asaa be7ees;</para>
  <para style="q2" vid="PSA 11:4">iza ayfeti</para>
  <para style="q2" vid="PSA 11:4">asaa pilggi xeelleettes.<verse eid="PSA 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5" />GODAY xillotanne</para>
  <para style="q2" vid="PSA 11:5">nagaranchchata pilggi xeellees.</para>
  <para style="q2" vid="PSA 11:5">Gido attiin geellateththinne</para>
  <para style="q2" vid="PSA 11:5">makkallateth siiqizayta</para>
  <para style="q2" vid="PSA 11:5">izi keehippe ixxees.<verse eid="PSA 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6" />GODAY iitata bolla</para>
  <para style="q2" vid="PSA 11:6">eexxiza tama bonqonne</para>
  <para style="q2" vid="PSA 11:6">diine tama bukisana.</para>
  <para style="q2" vid="PSA 11:6">Dhayssiza gote carkon</para>
  <para style="q2" vid="PSA 11:6">istta qaxxayana.<verse eid="PSA 11:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7" />GODAY xillo gidida gishshas</para>
  <para style="q2" vid="PSA 11:7">xilloteththa ooso dosees.</para>
  <para style="q2" vid="PSA 11:7">Suure asati iza sinth beyana.<verse eid="PSA 11:7" /></para>
  <chapter eid="PSA 11" />
  <chapter number="12" style="c" sid="PSA 12" />
  <para style="s1">Dawiti Zammareta Kaabbos Osppun Shayan Waaxettida Diiththan Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 12:1" />GODAWU! Lo7o asi biitta bollafe wurida gishshas</para>
  <para style="q2" vid="PSA 12:1">ne tana maaddarkki;</para>
  <para style="q2" vid="PSA 12:1">deraa giddon ammanettiza</para>
  <para style="q2" vid="PSA 12:1">asi deenna.<verse eid="PSA 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2" />Issoy issaas wordo haasayees;</para>
  <para style="q2" vid="PSA 12:2">issoy issaa doonan cimmeettes;<verse eid="PSA 12:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 12:3">baleththiza doona gorda;</para>
  <para style="q2" vid="PSA 12:3">otoron haasayza</para>
  <para style="q2" vid="PSA 12:3">inxarsata qanxxa;<verse eid="PSA 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4" />Istti, «Nuni nu inxarsan xoonana;</para>
  <para style="q2" vid="PSA 12:4">nu doonay nuussa;</para>
  <para style="q2" vid="PSA 12:4">nuus goday oonee?» geettes.<verse eid="PSA 12:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5" />GODAY, «Hiyeesati un7ettida</para>
  <para style="q2" vid="PSA 12:5">gishshassinne,</para>
  <para style="q2" vid="PSA 12:5">metotanchchata waaso gishshas</para>
  <para style="q2" vid="PSA 12:5">ha7i tani dendana;</para>
  <para style="q2" vid="PSA 12:5">tani istti amottiza saroteththan</para>
  <para style="q2" vid="PSA 12:5">istta woththana» gees.<verse eid="PSA 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6" />GODAA qaalay izan</para>
  <para style="q2" vid="PSA 12:6">walakay baynda muuruta;</para>
  <para style="q2" vid="PSA 12:6">cooce taman laappunto</para>
  <para style="q2" vid="PSA 12:6">paacetti geeyida bira mala.<verse eid="PSA 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 12:7">Neni nuna saroteththan naaga;</para>
  <para style="q2" vid="PSA 12:7">ha woden diza iita yeletappe</para>
  <para style="q2" vid="PSA 12:7">mernaas ne nuna ashsha.<verse eid="PSA 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8" />Asaa giddon iitay</para>
  <para style="q2" vid="PSA 12:8">bonchchettida wode</para>
  <para style="q2" vid="PSA 12:8">geellati ubba wode</para>
  <para style="q2" vid="PSA 12:8">otoreteththan simeretteettes.<verse eid="PSA 12:8" /></para>
  <chapter eid="PSA 12" />
  <chapter number="13" style="c" sid="PSA 13" />
  <para style="s1">Dawiti Zammareta Kaabbos Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 13:1">Awude gakkanaas</para>
  <para style="q2" vid="PSA 13:1">neni tana doganee?</para>
  <para style="q2" vid="PSA 13:1">Ne tana mernaas balanee?</para>
  <para style="q2" vid="PSA 13:1">Awude gakkanaas</para>
  <para style="q2" vid="PSA 13:1">neni taappe geemmanee?<verse eid="PSA 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2" />Awude gakkanaas</para>
  <para style="q2" vid="PSA 13:2">tani ta qofara baaxetanee?</para>
  <para style="q2" vid="PSA 13:2">Awude gakkanaas ta wozinay</para>
  <para style="q2" vid="PSA 13:2">ceecishe daanee?</para>
  <para style="q2" vid="PSA 13:2">Ta morkketi ta bolla</para>
  <para style="q2" vid="PSA 13:2">awude gakkanaas goobanee?<verse eid="PSA 13:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3" />Ta GODAWU!</para>
  <para style="q2" vid="PSA 13:3">Haa taakko xeellada</para>
  <para style="q2" vid="PSA 13:3">taas zaaro imma;</para>
  <para style="q2" vid="PSA 13:3">ta ayfe poo7isada,</para>
  <para style="q2" vid="PSA 13:3">hayqoppe tana ashsha.<verse eid="PSA 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4" />«Nuni iza xoonidos» giidi,</para>
  <para style="q2" vid="PSA 13:4">ta morkketi ceeqettontta mala</para>
  <para style="q2" vid="PSA 13:4">ne istta teqqa.</para>
  <para style="q2" vid="PSA 13:4">Ta kundeththaan</para>
  <para style="q2" vid="PSA 13:4">istti ufayettontta mala</para>
  <para style="q2" vid="PSA 13:4">ne istta digga.<verse eid="PSA 13:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5" />Gido attiin ne maaroteththa</para>
  <para style="q2" vid="PSA 13:5">daron tani ammanettays;</para>
  <para style="q2" vid="PSA 13:5">neni tana ashshiza gishshas</para>
  <para style="q2" vid="PSA 13:5">tani ufayettays.<verse eid="PSA 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6" />GODAWU!</para>
  <para style="q2" vid="PSA 13:6">Ne kiyateththi</para>
  <para style="q2" vid="PSA 13:6">taas darida gishshas</para>
  <para style="q2" vid="PSA 13:6">tani nees yexxana.<verse eid="PSA 13:6" /></para>
  <chapter eid="PSA 13" />
  <chapter number="14" style="c" sid="PSA 14" />
  <para style="s1">Dawiti Zammareta Kaabbos Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 14:1" />Eeyati bantta wozinan,</para>
  <para style="q2" vid="PSA 14:1">«Xoossi baawa» geettes;</para>
  <para style="q2" vid="PSA 14:1">istta de7oy moorettides;</para>
  <para style="q2" vid="PSA 14:1">istti harassiza miish ooththeettes;</para>
  <para style="q2" vid="PSA 14:1">istta giddon lo7o ooththiza</para>
  <para style="q2" vid="PSA 14:1">issi asikka deenna.<verse eid="PSA 14:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2" />Xoossa koyzaynne akeekizay</para>
  <para style="q2" vid="PSA 14:2">de7izakko be7anaas,</para>
  <para style="q2" vid="PSA 14:2">GODAY saloppe duge</para>
  <para style="q2" vid="PSA 14:2">asaa xeellees.<verse eid="PSA 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3" />Gido attiin ubbayka</para>
  <para style="q2" vid="PSA 14:3">ogeppe kare ke7ida;</para>
  <para style="q2" vid="PSA 14:3">ubbayka mulera go7onttaaz gidida;</para>
  <para style="q2" vid="PSA 14:3">lo7o ooththizay ooninne deenna;</para>
  <para style="q2" vid="PSA 14:3">haray atto issaadeyka deenna.<note caller="-" style="x"><char style="xo" closed="false">14:1-3 </char><char style="xt" closed="false"><ref loc="ROM 3:10-12">Oro 3:10-12</ref></char></note><verse eid="PSA 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4" />GODAY, «Ta asaa bonqqi</para>
  <para style="q2" vid="PSA 14:4">miza iita asati</para>
  <para style="q2" vid="PSA 14:4">aykkoka erettennee?» gees.<verse eid="PSA 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5" />Gido attiin Xoossi xillo asatara</para>
  <para style="q2" vid="PSA 14:5">de7iza gishshas</para>
  <para style="q2" vid="PSA 14:5">iita asati hessan dagammana.<verse eid="PSA 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6" />Intte hiyeesata halchcho laalleeta;</para>
  <para style="q2" vid="PSA 14:6">gido attiin GODAY</para>
  <para style="q2" vid="PSA 14:6">hiyeesati baqati attizaso gidees.<verse eid="PSA 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7" />Isra7eeles atoteththi</para>
  <para style="q2" vid="PSA 14:7">Xiyooneppe yidaakko!</para>
  <para style="q2" vid="PSA 14:7">GODAY istta duussa zaariza wode</para>
  <para style="q2" vid="PSA 14:7">Yaaqoobe zereththati ufayettana;</para>
  <para style="q2" vid="PSA 14:7">Isra7eele asay</para>
  <para style="q2" vid="PSA 14:7">ufayssan galatana.<verse eid="PSA 14:7" /></para>
  <chapter eid="PSA 14" />
  <chapter number="15" style="c" sid="PSA 15" />
  <para style="s1">Dawite Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 15:1">Ne Dunkaanezan</para>
  <para style="q2" vid="PSA 15:1">gam7anay oonee?</para>
  <para style="q2" vid="PSA 15:1">Ne geeshsha zumaa bolla</para>
  <para style="q2" vid="PSA 15:1">nenara de7anay oonee?<verse eid="PSA 15:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2" />Suure de7o de7izay,</para>
  <para style="q2" vid="PSA 15:2">xillo ooththizay,</para>
  <para style="q2" vid="PSA 15:2">ba wozinappe tuma haasayzay,<verse eid="PSA 15:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 15:3" />as cimmonttay,</para>
  <para style="q2" vid="PSA 15:3">ba lagge bolla iita ooththonttay,</para>
  <para style="q2" vid="PSA 15:3">ba shooro zigironttay,<verse eid="PSA 15:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 15:4" />Iita asata kadhizay,</para>
  <para style="q2" vid="PSA 15:4">gido attiin</para>
  <para style="q2" vid="PSA 15:4">GODAAS yayyizayta</para>
  <para style="q2" vid="PSA 15:4">bonchchizay,</para>
  <para style="q2" vid="PSA 15:4">ay deexxikkoka</para>
  <para style="q2" vid="PSA 15:4">ba caaqqida qaala polizay,<verse eid="PSA 15:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 15:5" />ba miishsha dichchas tal7onttay,</para>
  <para style="q2" vid="PSA 15:5">xillo as qohanaas</para>
  <para style="q2" vid="PSA 15:5">matta7e ekkonttay,</para>
  <para style="b" vid="PSA 15:5" />
  <para style="q2" vid="PSA 15:5">Ha yo7ota polizaadey</para>
  <para style="q2" vid="PSA 15:5">mernaaskka hirgenna.<verse eid="PSA 15:5" /></para>
  <chapter eid="PSA 15" />
  <chapter number="16" style="c" sid="PSA 16" />
  <para style="s1">Dawite Woosa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 16:1">Ta baqata attizasoy nena;</para>
  <para style="q2" vid="PSA 16:1">ne ki7on tana qotta.<verse eid="PSA 16:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2" />Tani GODAAS, «Neni ta Godaa;</para>
  <para style="q2" vid="PSA 16:2">neeppe attiin hara lo7oy</para>
  <para style="q2" vid="PSA 16:2">taas deenna» gadis.<verse eid="PSA 16:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3" />Sa7an de7iza geeshshati</para>
  <para style="q2" vid="PSA 16:3">ay mala bonchchettidaytee!</para>
  <para style="q2" vid="PSA 16:3">Tani isttan ufayettays.<verse eid="PSA 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4" />Wordo xoossata kaallizayti</para>
  <para style="q2" vid="PSA 16:4">bantta bolla meto darseettes.</para>
  <para style="q2" vid="PSA 16:4">Gido attiin</para>
  <para style="q2" vid="PSA 16:4">tani eeqa xoossatas shukkike;</para>
  <para style="q2" vid="PSA 16:4">isttas sunththaaka xeygikke.<verse eid="PSA 16:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5" />GODAWU! Taas laata xinxxoynne</para>
  <para style="q2" vid="PSA 16:5">qaaday nena;<verse eid="PSA 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6" />Ne taas wadhdhida zaway</para>
  <para style="q2" vid="PSA 16:6">lo7o gidides;</para>
  <para style="q2" vid="PSA 16:6">keehippe lo7o xinxxoy</para>
  <para style="q2" vid="PSA 16:6">tana gakkides.<verse eid="PSA 16:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7" />Tana zoriza GODAA galatays;</para>
  <para style="q2" vid="PSA 16:7">omars ta wozinay</para>
  <para style="q2" vid="PSA 16:7">tana tamaarssees.<verse eid="PSA 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8" />Tani ubbato GODAA sinththasays;</para>
  <para style="q2" vid="PSA 16:8">izi ta ushachchan diza gishshas</para>
  <para style="q2" vid="PSA 16:8">tani kokkorikke.<verse eid="PSA 16:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9" />Hessa gishshas</para>
  <para style="q2" vid="PSA 16:9">ta wozinay ufayettees;</para>
  <para style="q2" vid="PSA 16:9">ta shemppoyka woppu gees;</para>
  <para style="q2" vid="PSA 16:9">ta asateththayka hirgay baynda</para>
  <para style="q2" vid="PSA 16:9">shempi dees.<verse eid="PSA 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10" />Ne tana Si7oolen aggaka;</para>
  <para style="q2" vid="PSA 16:10">ne geeshshaza</para>
  <para style="q2" vid="PSA 16:10">wooqqana mala aggaka.<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="ACT 13:35">Hawa 13:35</ref></char></note><verse eid="PSA 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11" />Neni tana de7o oge bessaasa;</para>
  <para style="q2" vid="PSA 16:11">ne matan kumeththa ufayssi,</para>
  <para style="q2" vid="PSA 16:11">nees ushachchan</para>
  <para style="q2" vid="PSA 16:11">mernaa ufayssi dees.<note caller="-" style="x"><char style="xo" closed="false">16:8-11 </char><char style="xt" closed="false"><ref loc="ACT 2:25-28">Hawa 2:25-28</ref></char></note><verse eid="PSA 16:11" /></para>
  <chapter eid="PSA 16" />
  <chapter number="17" style="c" sid="PSA 17" />
  <para style="s1">Dawite Woosa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 17:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 17:1">Ta xilloteththan maganniza</para>
  <para style="q2" vid="PSA 17:1">magana siya;</para>
  <para style="q2" vid="PSA 17:1">ta waasoza ezga;</para>
  <para style="q2" vid="PSA 17:1">cimoy baynda woossiza woosaas</para>
  <para style="q2" vid="PSA 17:1">zaaro imma.<verse eid="PSA 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2" />Taas xilloteththi neeppe yo;</para>
  <para style="q2" vid="PSA 17:2">tumaa ne ayfey xeello.<verse eid="PSA 17:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3" />Neni qamman tana xomosadasa;</para>
  <para style="q2" vid="PSA 17:3">ta wozina paaccadasa;</para>
  <para style="q2" vid="PSA 17:3">ne paaccidaa gidikkoka</para>
  <para style="q2" vid="PSA 17:3">ta bolla aykkoka demmabeekka.</para>
  <para style="q2" vid="PSA 17:3">Ta inxarsay iita haasaybeenna.<verse eid="PSA 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4" />Tani hara asa mala</para>
  <para style="q2" vid="PSA 17:4">iita qaala haasaykke;</para>
  <para style="q2" vid="PSA 17:4">tani ne azazo naagiza gishshas</para>
  <para style="q2" vid="PSA 17:4">gene oge kaallabeekke.<verse eid="PSA 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5" />Ta tohoti ne ogeppe</para>
  <para style="q2" vid="PSA 17:5">handarshontta mala</para>
  <para style="q2" vid="PSA 17:5">ta tanggoy ne ogeppe</para>
  <para style="q2" vid="PSA 17:5">kare kezibeenna.<verse eid="PSA 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6" />Abeet Xoossawu! Tani woossiin</para>
  <para style="q2" vid="PSA 17:6">neni siyiza gishshas</para>
  <para style="q2" vid="PSA 17:6">tani nena woossays;</para>
  <para style="q2" vid="PSA 17:6">ne hayththa taakko zaarada,</para>
  <para style="q2" vid="PSA 17:6">tani nees yootizayssa siya.<verse eid="PSA 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7" />Bantta morkketappe baqatizayta</para>
  <para style="q2" vid="PSA 17:7">ne ushachcha kushezan</para>
  <para style="q2" vid="PSA 17:7">qottada ashshizayssoo!</para>
  <para style="q2" vid="PSA 17:7">Ne kiyateththa malalisiza</para>
  <para style="q2" vid="PSA 17:7">ogera qonccisa.<verse eid="PSA 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8" />Ne ayfe ciro mala tana naaga;</para>
  <para style="q2" vid="PSA 17:8">ne qefeta giddon tana qotta.<verse eid="PSA 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9" />Un7eththiza iitatappenne</para>
  <para style="q2" vid="PSA 17:9">dooddi uttida wolqqama</para>
  <para style="q2" vid="PSA 17:9">morkketa kusheppe</para>
  <para style="q2" vid="PSA 17:9">ne tana ashsha.<verse eid="PSA 17:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10" />Isttas qadhettiza wozinay baawa;</para>
  <para style="q2" vid="PSA 17:10">otoro haasaya haasayeettes.<verse eid="PSA 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11" />Tani bizaso ubbaan</para>
  <para style="q2" vid="PSA 17:11">istti tana dooddeettes;</para>
  <para style="q2" vid="PSA 17:11">tana duge biittan kundis</para>
  <para style="q2" vid="PSA 17:11">yegganaas dereqeettes.<verse eid="PSA 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12" />Istti banttas miza miish</para>
  <para style="q2" vid="PSA 17:12">koyza gaammo mala;</para>
  <para style="q2" vid="PSA 17:12">woykko geeman zamadi naagiza</para>
  <para style="q2" vid="PSA 17:12">wodalla gaammo mala.<verse eid="PSA 17:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13" />Abeet GODAWU! Denda.</para>
  <para style="q2" vid="PSA 17:13">Ta morkketara eqettada</para>
  <para style="q2" vid="PSA 17:13">istta shoca;</para>
  <para style="q2" vid="PSA 17:13">ne mashshan iitatappe</para>
  <para style="q2" vid="PSA 17:13">tana ashsha.<verse eid="PSA 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 17:14">Hessa mala asatappe</para>
  <para style="q2" vid="PSA 17:14">tana qotta;</para>
  <para style="q2" vid="PSA 17:14">Istta qaaday ha sa7a de7o</para>
  <para style="q2" vid="PSA 17:14">xalla gidiza asaappe</para>
  <para style="q2" vid="PSA 17:14">ne kushen tana ashsha;</para>
  <para style="q2" vid="PSA 17:14">ne mazgaban minjjida qixaateppe</para>
  <para style="q2" vid="PSA 17:14">istta kalssa;</para>
  <para style="q2" vid="PSA 17:14">istta naytas daridi tirpo;</para>
  <para style="q2" vid="PSA 17:14">istta nayta naytaska</para>
  <para style="q2" vid="PSA 17:14">gidi palaho.<verse eid="PSA 17:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15" />Gido attiin tani xilloteththan</para>
  <para style="q2" vid="PSA 17:15">ne sinththa beyana;</para>
  <para style="q2" vid="PSA 17:15">tani beeggiza wode</para>
  <para style="q2" vid="PSA 17:15">ne bonchcho be7ada alana.<verse eid="PSA 17:15" /></para>
  <chapter eid="PSA 17" />
  <chapter number="18" style="c" sid="PSA 18" />
  <para style="s1">GODAY Sa7oole kusheppenne iza morkketa ubbaa kusheppe ashshida wode GODAA aylle Dawiti zammareta kaabbos GODAA gishshas yexxida mazamure.</para>
  <para style="r">(<ref loc="2SA 22:1-51">2Same 22:1-51</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 18:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 18:1">Ne taas wolqqa immida gishshas</para>
  <para style="q2" vid="PSA 18:1">ta nena siiqays.<verse eid="PSA 18:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2" />GODAY taas zaalla;</para>
  <para style="q2" vid="PSA 18:2">tani olappe naagettiza miixa;</para>
  <para style="q2" vid="PSA 18:2">izi tana ashshizayssa;</para>
  <para style="q2" vid="PSA 18:2">ta Xoossay tani izan</para>
  <para style="q2" vid="PSA 18:2">geemetta attiza wogga zaalla.</para>
  <para style="q2" vid="PSA 18:2">Izi taas gondalle;</para>
  <para style="q2" vid="PSA 18:2">izi tana ashshiza kace;</para>
  <para style="q2" vid="PSA 18:2">taas izi mino zemppo.<verse eid="PSA 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3" />Galatay bessiza GODAA</para>
  <para style="q2" vid="PSA 18:3">tani xeygays;</para>
  <para style="q2" vid="PSA 18:3">izi ta morkketappe tana ashshees.<verse eid="PSA 18:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4" />Hayqo wodoroy tana cuullides;</para>
  <para style="q2" vid="PSA 18:4">dhayssiza di7oy tana mittides.<verse eid="PSA 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5" />Duufo wodoroy tana qachchides;</para>
  <para style="q2" vid="PSA 18:5">hayqo woximadey</para>
  <para style="q2" vid="PSA 18:5">ta sinththan waaxettides.<verse eid="PSA 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6" />Tana metoy un7iin</para>
  <para style="q2" vid="PSA 18:6">GODAA xeygadis;</para>
  <para style="q2" vid="PSA 18:6">«Tana maadda» gaada</para>
  <para style="q2" vid="PSA 18:6">ta Xoossas waassadis;</para>
  <para style="q2" vid="PSA 18:6">izi ba Keeththan dishe</para>
  <para style="q2" vid="PSA 18:6">ta cenggurssaa siyides;</para>
  <para style="q2" vid="PSA 18:6">tani waassida waasoy</para>
  <para style="q2" vid="PSA 18:6">iza hayththan wodhdhides.<verse eid="PSA 18:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7" />Xoossi hanqettida gishshas</para>
  <para style="q2" vid="PSA 18:7">biittay qaaxxides;</para>
  <para style="q2" vid="PSA 18:7">zumata xaphoy kokkorides.<verse eid="PSA 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8" />Iza sidheppe</para>
  <para style="q2" vid="PSA 18:8">hanqo cuway cuwattides;</para>
  <para style="q2" vid="PSA 18:8">iza doonappe</para>
  <para style="q2" vid="PSA 18:8">miza tama lacoy kezides;</para>
  <para style="q2" vid="PSA 18:8">iza doonappe</para>
  <para style="q2" vid="PSA 18:8">xuuggiza bonqoy pulttides.<verse eid="PSA 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9" />Salo phalqidi wodhdhides;</para>
  <para style="q2" vid="PSA 18:9">he wode iza toho garsara</para>
  <para style="q2" vid="PSA 18:9">dhippi gida shaaray dees.<verse eid="PSA 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10" />Kiruben uttidi paallides;</para>
  <para style="q2" vid="PSA 18:10">carko qefe ekkidi</para>
  <para style="q2" vid="PSA 18:10">pude dendi bides.<verse eid="PSA 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11" />Bana dhuman kammides;</para>
  <para style="q2" vid="PSA 18:11">iza Dunkaaneza dhippi gida</para>
  <para style="q2" vid="PSA 18:11">irara shaaray dooddides.<verse eid="PSA 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12" />Iza sinththan de7iza</para>
  <para style="q2" vid="PSA 18:12">gita poo7ozappe shachchinne</para>
  <para style="q2" vid="PSA 18:12">wolqqanththi ke7ides;</para>
  <para style="q2" vid="PSA 18:12">dhippi gida shaarakka</para>
  <para style="q2" vid="PSA 18:12">kanththi ke7ides.<verse eid="PSA 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13" />GODAY dada mala</para>
  <para style="q2" vid="PSA 18:13">saloppe guummides;</para>
  <para style="q2" vid="PSA 18:13">Ubbaafe Dhoqqa Xoossay</para>
  <para style="q2" vid="PSA 18:13">ba cenggurssa sissides;</para>
  <para style="q2" vid="PSA 18:13">wolqqanththaninne</para>
  <para style="q2" vid="PSA 18:13">tama lacon qonccides.<verse eid="PSA 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14" />Ba wondafeza yiishshaa yeddides;</para>
  <para style="q2" vid="PSA 18:14">ba morkketakka laallides;</para>
  <para style="q2" vid="PSA 18:14">wolqqanththa poo7o kiittidi</para>
  <para style="q2" vid="PSA 18:14">istta yedeththides.<verse eid="PSA 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 18:15">Neni seerida wodenne</para>
  <para style="q2" vid="PSA 18:15">ne hanqoy eexxida wode,</para>
  <para style="q2" vid="PSA 18:15">gita abbati</para>
  <para style="q2" vid="PSA 18:15">ichchida biittay beettides;</para>
  <para style="q2" vid="PSA 18:15">qasse sa7a yochchay qonccides.<verse eid="PSA 18:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16" />GODAY bollafe ba kusheza</para>
  <para style="q2" vid="PSA 18:16">duge yeddidi tana oykkides;</para>
  <para style="q2" vid="PSA 18:16">ciimma haaththafe tana kessides.<verse eid="PSA 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17" />Izi ta bolla wolqqatiza</para>
  <para style="q2" vid="PSA 18:17">ta morkketappe,</para>
  <para style="q2" vid="PSA 18:17">tana ixxizaytappe ashshides.<verse eid="PSA 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18" />Tana metoy un7ida gallas</para>
  <para style="q2" vid="PSA 18:18">istti ta bolla dendida;</para>
  <para style="q2" vid="PSA 18:18">gido attiin GODAY</para>
  <para style="q2" vid="PSA 18:18">taas zemppo gidides.<verse eid="PSA 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19" />Izi tana aaho demban kessides;</para>
  <para style="q2" vid="PSA 18:19">tanan ufayettida gishshas</para>
  <para style="q2" vid="PSA 18:19">tana ashshides.<verse eid="PSA 18:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20" />Ta xilloteththa mala</para>
  <para style="q2" vid="PSA 18:20">GODAY taas qanxxides;</para>
  <para style="q2" vid="PSA 18:20">ta kushe geeshshateththa mala</para>
  <para style="q2" vid="PSA 18:20">izi taas zaarides.<verse eid="PSA 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21" />Tani GODAA oge kaalladis;</para>
  <para style="q2" vid="PSA 18:21">tani ta Xoossa aggada</para>
  <para style="q2" vid="PSA 18:21">iita ooththabeekke.<verse eid="PSA 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22" />Tani iza woga ubbaa naagadis;</para>
  <para style="q2" vid="PSA 18:22">iza azazoza polanaappe</para>
  <para style="q2" vid="PSA 18:22">guye gabeekke.<verse eid="PSA 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23" />Tani iza sinththan suure de7adis;</para>
  <para style="q2" vid="PSA 18:23">tanateththaa nagarappe naagadis.<verse eid="PSA 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24" />Hessa gishshas</para>
  <para style="q2" vid="PSA 18:24">GODAY taas</para>
  <para style="q2" vid="PSA 18:24">ta xilloteththa mala immides;</para>
  <para style="q2" vid="PSA 18:24">ta kushey iza sinththan</para>
  <para style="q2" vid="PSA 18:24">geesh gidida mala zaarides.<verse eid="PSA 18:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 18:25">Ammanettizaytas</para>
  <para style="q2" vid="PSA 18:25">neni ammanettaasa;</para>
  <para style="q2" vid="PSA 18:25">suuretas neni suure.<verse eid="PSA 18:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26" />Geeshshataskka neni geeshsha;</para>
  <para style="q2" vid="PSA 18:26">gido attiin geellatas neni geella.<verse eid="PSA 18:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27" />Ashketa ne ashshaasa;</para>
  <para style="q2" vid="PSA 18:27">gido attiin otoranchchata</para>
  <para style="q2" vid="PSA 18:27">kawushshaasa.<verse eid="PSA 18:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 18:28">Ne taas xomppaasa;</para>
  <para style="q2" vid="PSA 18:28">Xoossay neni taas</para>
  <para style="q2" vid="PSA 18:28">dhuma poo7isaasa.<verse eid="PSA 18:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29" />Ne maaddiin</para>
  <para style="q2" vid="PSA 18:29">tani ta morkketa olays;</para>
  <para style="q2" vid="PSA 18:29">ta Xoossa wolqqan tani istta</para>
  <para style="q2" vid="PSA 18:29">gimbe bollara guppa aadhdhays.<verse eid="PSA 18:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30" />Xoossa ogey suure;</para>
  <para style="q2" vid="PSA 18:30">GODAA qaalay ammanettizayssa;</para>
  <para style="q2" vid="PSA 18:30">Izakko baqatiza ubbatas</para>
  <para style="q2" vid="PSA 18:30">izi gondalle.<verse eid="PSA 18:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31" />Xoossafe attiin hara xoossi oonee?</para>
  <para style="q2" vid="PSA 18:31">nu GODAAPPE attiin hara zaallay oonee?<verse eid="PSA 18:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32" />Taas wolqqa immizaynne</para>
  <para style="q2" vid="PSA 18:32">ta oge saro ooththizay Xoossa.<verse eid="PSA 18:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33" />Izi ta tohota</para>
  <para style="q2" vid="PSA 18:33">genessa toho mala minththees;</para>
  <para style="q2" vid="PSA 18:33">tana dhoqqasohotan saroteththan woththees.<note caller="-" style="x"><char style="xo" closed="false">18:33 </char><char style="xt" closed="false"><ref loc="HAB 3:19">Im 3:19</ref></char></note><verse eid="PSA 18:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34" />Izi ta kusheta</para>
  <para style="q2" vid="PSA 18:34">ola tamaarssees;</para>
  <para style="q2" vid="PSA 18:34">hessa gishshas tani ta qesen</para>
  <para style="q2" vid="PSA 18:34">xarqimala birata wondafeza</para>
  <para style="q2" vid="PSA 18:34">dafada dukkays.<verse eid="PSA 18:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35" />Ashshiza ne gondalle taas immadasa.</para>
  <para style="q2" vid="PSA 18:35">Ne ushachcha kushen tana zemppisadasa;</para>
  <para style="q2" vid="PSA 18:35">taakko ziqqi gaada tana gitasadasa.<verse eid="PSA 18:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36" />Ta oge aassadasa;</para>
  <para style="q2" vid="PSA 18:36">hessa gishshas ta tohoy handarashibeenna.<verse eid="PSA 18:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37" />Ta morkketa tani</para>
  <para style="q2" vid="PSA 18:37">yedeththa oykkadis;</para>
  <para style="q2" vid="PSA 18:37">tani istta dhayssana gakkanaas</para>
  <para style="q2" vid="PSA 18:37">guye simmabeekke.<verse eid="PSA 18:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38" />Istti nam7anththo</para>
  <para style="q2" vid="PSA 18:38">dendontta mala shocadis;</para>
  <para style="q2" vid="PSA 18:38">ta toho garsankka kundida.<verse eid="PSA 18:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39" />Olas tana wolqqa gixissadasa;</para>
  <para style="q2" vid="PSA 18:39">ta morkketa</para>
  <para style="q2" vid="PSA 18:39">ta sinththan gulbatissadasa.<verse eid="PSA 18:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40" />Ta morkketa ta sinththafe</para>
  <para style="q2" vid="PSA 18:40">guye zaara baqatissadasa;</para>
  <para style="q2" vid="PSA 18:40">tana ixxizayta tani dhayssadis.<verse eid="PSA 18:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41" />Banttana maaddana mala waassida;</para>
  <para style="q2" vid="PSA 18:41">gido attiin ooninne istta ashshibeenna.</para>
  <para style="q2" vid="PSA 18:41">GODAA istti xeygida;</para>
  <para style="q2" vid="PSA 18:41">gido attiin izi isttas koyibeenna.<verse eid="PSA 18:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42" />Carkoy pittidi efiza gudulla mala</para>
  <para style="q2" vid="PSA 18:42">tani istta ooththadis;</para>
  <para style="q2" vid="PSA 18:42">ogen de7iza urqqa malakka</para>
  <para style="q2" vid="PSA 18:42">istta yedhettadis.<verse eid="PSA 18:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43" />Makkalla asappe tana ashshadasa;</para>
  <para style="q2" vid="PSA 18:43">ne tana kawoteththata ayssizaade</para>
  <para style="q2" vid="PSA 18:43">histta shuumadasa;</para>
  <para style="q2" vid="PSA 18:43">ta erontta derey</para>
  <para style="q2" vid="PSA 18:43">taas haarettides.<verse eid="PSA 18:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 18:44" />Tana erontta allaga derey</para>
  <para style="q2" vid="PSA 18:44">taas azazettees;</para>
  <para style="q2" vid="PSA 18:44">istti ta goobateththaa siyidi</para>
  <para style="q2" vid="PSA 18:44">taas ziggeettes.<verse eid="PSA 18:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45" />Istti yashshan kaha dhayeettes;</para>
  <para style="q2" vid="PSA 18:45">bantti naagiza miixappe kezidi</para>
  <para style="q2" vid="PSA 18:45">kokkorishe taakko yeettes.<verse eid="PSA 18:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46" />GODAY de7o Xoossa!</para>
  <para style="q2" vid="PSA 18:46">Ta zemppiza</para>
  <para style="q2" vid="PSA 18:46">wogga zaallay galatetto!</para>
  <para style="q2" vid="PSA 18:46">Tana ashshida Xoossay</para>
  <para style="q2" vid="PSA 18:46">dhoqqu dhoqqu go!<verse eid="PSA 18:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47" />Izi ta halo kessiza Xoossa;</para>
  <para style="q2" vid="PSA 18:47">kawoteththata taas haarisiza Xoossa.<verse eid="PSA 18:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 18:48" />Ta morkketappe tana ashshaasa;</para>
  <para style="q2" vid="PSA 18:48">Abeet GODAWU!</para>
  <para style="q2" vid="PSA 18:48">Neni ta morkketa bolla</para>
  <para style="q2" vid="PSA 18:48">tana dhoqqu dhoqqu histtaasa;</para>
  <para style="q2" vid="PSA 18:48">makkallanchcha asatappe</para>
  <para style="q2" vid="PSA 18:48">neni tana ashshaasa.<verse eid="PSA 18:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49" />Hessa gishshas tani nena</para>
  <para style="q2" vid="PSA 18:49">kawoteththata sinththan galatana;</para>
  <para style="q2" vid="PSA 18:49">tani ne sunththa yeththan sabbana.<note caller="-" style="x"><char style="xo" closed="false">18:49 </char><char style="xt" closed="false"><ref loc="ROM 15:9">Oro 15:9</ref></char></note><verse eid="PSA 18:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50" />Xoossi ba kawoththida kawos</para>
  <para style="q2" vid="PSA 18:50">xoono bolla xoono immees.</para>
  <para style="q2" vid="PSA 18:50">Ba tiydayssas kiyateththa bessees;</para>
  <para style="q2" vid="PSA 18:50">Dawitesinne iza zereththatas</para>
  <para style="q2" vid="PSA 18:50">mernaas hessaththo ooththees.<verse eid="PSA 18:50" /></para>
  <chapter eid="PSA 18" />
  <chapter number="19" style="c" sid="PSA 19" />
  <para style="s1">Dawiti Zammareta Kaabbos Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1" />Saloti Xoossa bonchcho yooteettes;</para>
  <para style="q2" vid="PSA 19:1">salo gufanththoy</para>
  <para style="q2" vid="PSA 19:1">iza kushe ooso awajjees.<verse eid="PSA 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2" />Issi gallassay hara gallassas</para>
  <para style="q2" vid="PSA 19:2">hessa yootees;</para>
  <para style="q2" vid="PSA 19:2">issi qammayka kaalliza qammas</para>
  <para style="q2" vid="PSA 19:2">erateth qonccisees.<verse eid="PSA 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3" />Isttas haasayay</para>
  <para style="q2" vid="PSA 19:3">woykko qaalay baawa;</para>
  <para style="q2" vid="PSA 19:3">istta cenggurssikka siyettenna.<verse eid="PSA 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4" />Gido attiin istta haasaya cenggurssi</para>
  <para style="q2" vid="PSA 19:4">sa7a ubbaan laalettana;</para>
  <para style="q2" vid="PSA 19:4">istta qaalaykka biitta gaxa gakkana.</para>
  <para style="b" vid="PSA 19:4" />
  <para style="q2" vid="PSA 19:4">Xoossi arshes</para>
  <para style="q2" vid="PSA 19:4">salon soho giigsides.<note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="ROM 10:18">Oro 10:18</ref></char></note><verse eid="PSA 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 19:5" />Arshey mishiray ba keeththafe</para>
  <para style="q2" vid="PSA 19:5">keziza mala poo7i ke7ees;</para>
  <para style="q2" vid="PSA 19:5">gaadde woxxiza pilata</para>
  <para style="q2" vid="PSA 19:5">asa mala ufayettees.<verse eid="PSA 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6" />Arshey kessasoppe</para>
  <para style="q2" vid="PSA 19:6">wuloso gakkanaas bees;</para>
  <para style="q2" vid="PSA 19:6">iza seelappe geemmi</para>
  <para style="q2" vid="PSA 19:6">attana miishshi deenna.<verse eid="PSA 19:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7" />GODAA wogay suure;</para>
  <para style="q2" vid="PSA 19:7">shemppo zaari cil7isees;</para>
  <para style="q2" vid="PSA 19:7">GODAA azazoy ammanettizayssa;</para>
  <para style="q2" vid="PSA 19:7">akeekay paccidaytas</para>
  <para style="q2" vid="PSA 19:7">aadho erateth immees.<verse eid="PSA 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8" />GODAA wogay likke;</para>
  <para style="q2" vid="PSA 19:8">wozina ufayssees.</para>
  <para style="q2" vid="PSA 19:8">GODAA azazoy geeshsha;</para>
  <para style="q2" vid="PSA 19:8">ayfe poo7isees.<verse eid="PSA 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9" />GODAAS yashshi geeshshateththa;</para>
  <para style="q2" vid="PSA 19:9">izi mernaas eqqidi de7ana.</para>
  <para style="q2" vid="PSA 19:9">GODAA pirday</para>
  <para style="q2" vid="PSA 19:9">mulera tumanne xillo.<verse eid="PSA 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10" />Worqqafenne muuruta worqqafe</para>
  <para style="q2" vid="PSA 19:10">aadhdhi dosettees;</para>
  <para style="q2" vid="PSA 19:10">eessafenne eessa ililoppe</para>
  <para style="q2" vid="PSA 19:10">aadhdhi mal7ees.<verse eid="PSA 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11" />Qasse tana ne aylleza</para>
  <para style="q2" vid="PSA 19:11">naagettana mala zorees;</para>
  <para style="q2" vid="PSA 19:11">ne woga naagoy daro go7ees.<verse eid="PSA 19:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12" />Ba bala demmizay oonee?</para>
  <para style="q2" vid="PSA 19:12">Abeet GODAWU!</para>
  <para style="q2" vid="PSA 19:12">Geemmida nagarappe</para>
  <para style="q2" vid="PSA 19:12">tana geeshsha.<verse eid="PSA 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13" />Tani ne aylley,</para>
  <para style="q2" vid="PSA 19:13">xalateththan nagara</para>
  <para style="q2" vid="PSA 19:13">ooththontta mala</para>
  <para style="q2" vid="PSA 19:13">neni tana naaga.</para>
  <para style="q2" vid="PSA 19:13">Nagaray tana haaroppo;</para>
  <para style="q2" vid="PSA 19:13">he wode tani suure gidana;</para>
  <para style="q2" vid="PSA 19:13">gita mooroppeka geeyana.<verse eid="PSA 19:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 19:14">Ta zemppiza wogga zaallawu!</para>
  <para style="q2" vid="PSA 19:14">Tana wozzida ta Godawu!</para>
  <para style="q2" vid="PSA 19:14">Ta doonappe ke7iza qaalaynne</para>
  <para style="q2" vid="PSA 19:14">ta wozina qofay</para>
  <para style="q2" vid="PSA 19:14">nena ufayssizayssa gido.<verse eid="PSA 19:14" /></para>
  <chapter eid="PSA 19" />
  <chapter number="20" style="c" sid="PSA 20" />
  <para style="s1">Dawiti Zammareta Kaabbos Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 20:1" />Neni metotida wode</para>
  <para style="q2" vid="PSA 20:1">GODAY ne woosa siyo;</para>
  <para style="q2" vid="PSA 20:1">Yaaqoobe Xoossa sunththi</para>
  <para style="q2" vid="PSA 20:1">nena minththi esso.<verse eid="PSA 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2" />Ba Keeththafe nees maado kiitto;</para>
  <para style="q2" vid="PSA 20:2">Xiyooneppe maadoy yo.<verse eid="PSA 20:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3" />Ne yarsho ubbaa izi akeeko;</para>
  <para style="q2" vid="PSA 20:3">ne xuuggiza yarshon izi ufayetto.<verse eid="PSA 20:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4" />Ne wozina amo nees immo;</para>
  <para style="q2" vid="PSA 20:4">ne halchcho ubbaa polo.<verse eid="PSA 20:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5" />Ne xoonida gishshas</para>
  <para style="q2" vid="PSA 20:5">nuni ufayssan hombocana;</para>
  <para style="q2" vid="PSA 20:5">nu Xoossa sunththan</para>
  <para style="q2" vid="PSA 20:5">nu bandira dhoqqu ooththana;</para>
  <para style="q2" vid="PSA 20:5">ne woosa ubbaa</para>
  <para style="q2" vid="PSA 20:5">GODAY nees immo.<verse eid="PSA 20:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6" />GODAY ba doorida kawozas</para>
  <para style="q2" vid="PSA 20:6">xoono immizayssa tani ha7i eradis;</para>
  <para style="q2" vid="PSA 20:6">ba ushachcha kushezan</para>
  <para style="q2" vid="PSA 20:6">izi gita xoonon kunththana;</para>
  <para style="q2" vid="PSA 20:6">ba geeshsha saloppeka</para>
  <para style="q2" vid="PSA 20:6">izas zaaro immana.<verse eid="PSA 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7" />Issoti issoti bantta ola</para>
  <para style="q2" vid="PSA 20:7">para-gaaren ammanetteettes;</para>
  <para style="q2" vid="PSA 20:7">harati bantta paran ceeqetteettes;</para>
  <para style="q2" vid="PSA 20:7">nuni gidikko</para>
  <para style="q2" vid="PSA 20:7">nu GODAA wolqqan ceeqettoos.<verse eid="PSA 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8" />Istti dhuphettidi kundana;</para>
  <para style="q2" vid="PSA 20:8">nuni gidikko dendidi</para>
  <para style="q2" vid="PSA 20:8">minni eqqana.<verse eid="PSA 20:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 20:9">Kawozas xoono imma;</para>
  <para style="q2" vid="PSA 20:9">nunikka nena xeygiza wode siya.<verse eid="PSA 20:9" /></para>
  <chapter eid="PSA 20" />
  <chapter number="21" style="c" sid="PSA 21" />
  <para style="s1">Dawiti Zammareta Kaabbos Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 21:1">Kawoy ne immida</para>
  <para style="q2" vid="PSA 21:1">wolqqa gishshas ufayettees;</para>
  <para style="q2" vid="PSA 21:1">neni immida xoonon</para>
  <para style="q2" vid="PSA 21:1">izi keehi hombocees.<verse eid="PSA 21:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2" />Neni iza wozina amo</para>
  <para style="q2" vid="PSA 21:2">izas immadasa;</para>
  <para style="q2" vid="PSA 21:2">qasse izi nena</para>
  <para style="q2" vid="PSA 21:2">ba doonan oychchidayssa</para>
  <para style="q2" vid="PSA 21:2">neni diggabeekka.<verse eid="PSA 21:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3" />Neni lo7o anjjora iza mokkaasa;</para>
  <para style="q2" vid="PSA 21:3">geeshsha worqqa kallachcha</para>
  <para style="q2" vid="PSA 21:3">iza hu7aan goxxisadasa.<verse eid="PSA 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4" />Neni de7o izas immana mala</para>
  <para style="q2" vid="PSA 21:4">nena woossides;</para>
  <para style="q2" vid="PSA 21:4">nekka izas de7onne</para>
  <para style="q2" vid="PSA 21:4">adussa layth immadasa.<verse eid="PSA 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5" />Neni xoono immida gishshas</para>
  <para style="q2" vid="PSA 21:5">izas bonchchoy darides;</para>
  <para style="q2" vid="PSA 21:5">gitateththinne teema</para>
  <para style="q2" vid="PSA 21:5">izas immadasa.<verse eid="PSA 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6" />Neni izas mernaa anjjo immadasa;</para>
  <para style="q2" vid="PSA 21:6">ne izara duussan</para>
  <para style="q2" vid="PSA 21:6">iza ufayssadasa.<verse eid="PSA 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7" />Kawozi GODAAN ammaneettes.</para>
  <para style="q2" vid="PSA 21:7">Ubbaafe Dhoqqa</para>
  <para style="q2" vid="PSA 21:7">Xoossa kiyateththi</para>
  <para style="q2" vid="PSA 21:7">izara diza gishshas</para>
  <para style="q2" vid="PSA 21:7">izi yayyenna.<verse eid="PSA 21:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8" />Ne kushey ne morkketa</para>
  <para style="q2" vid="PSA 21:8">ubbaa demmana;</para>
  <para style="q2" vid="PSA 21:8">ne ushachchay</para>
  <para style="q2" vid="PSA 21:8">nena ixxizayta oykkana.<verse eid="PSA 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9" />Neni qoncciza wode</para>
  <para style="q2" vid="PSA 21:9">coocen eexxiza tama mala</para>
  <para style="q2" vid="PSA 21:9">ne istta xuuggana;</para>
  <para style="q2" vid="PSA 21:9">GODAY ba hanqoza suulen</para>
  <para style="q2" vid="PSA 21:9">istta xuuggana;</para>
  <para style="q2" vid="PSA 21:9">iza tamaykka</para>
  <para style="q2" vid="PSA 21:9">istta mi dhayssana.<verse eid="PSA 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10" />Neni istta nayta</para>
  <para style="q2" vid="PSA 21:10">biittafe diggana;</para>
  <para style="q2" vid="PSA 21:10">istta zereththaaka</para>
  <para style="q2" vid="PSA 21:10">dereppe denththa dhayssana.<verse eid="PSA 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11" />Ne morkketi ne bolla</para>
  <para style="q2" vid="PSA 21:11">genen duulateettes;</para>
  <para style="q2" vid="PSA 21:11">iita miishshika maqetteettes;</para>
  <para style="q2" vid="PSA 21:11">gido attiin isttas hanenna.<verse eid="PSA 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12" />Nekka istta</para>
  <para style="q2" vid="PSA 21:12">ne wondafeza</para>
  <para style="q2" vid="PSA 21:12">yiishshan gooddaasa;</para>
  <para style="q2" vid="PSA 21:12">istti guye simmidi</para>
  <para style="q2" vid="PSA 21:12">baqatana mala ooththaasa.<verse eid="PSA 21:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 21:13">Ne minoteththay</para>
  <para style="q2" vid="PSA 21:13">dhoqqu dhoqqu go;</para>
  <para style="q2" vid="PSA 21:13">ne gita wolqqaa gishshas</para>
  <para style="q2" vid="PSA 21:13">galata mazamure yexxoos.<verse eid="PSA 21:13" /></para>
  <chapter eid="PSA 21" />
  <chapter number="22" style="c" sid="PSA 22" />
  <para style="s1">Dawiti Zammareta Kaabbos Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1" />Ta Xoossawu! Ta Xoossawu!</para>
  <para style="q2" vid="PSA 22:1">Tana ays aggadii?</para>
  <para style="q2" vid="PSA 22:1">Tana maadda gaada</para>
  <para style="q2" vid="PSA 22:1">tani waassishin</para>
  <para style="q2" vid="PSA 22:1">ays siyontta ixxadii?</para>
  <para style="q2" vid="PSA 22:1">Taappeka ays haakkadii?<note caller="-" style="x"><char style="xo" closed="false">22:1 </char><char style="xt" closed="false"><ref loc="MAT 27:46">Mato 27:46</ref>; <ref loc="MRK 15:34">Mar 15:34</ref></char></note><verse eid="PSA 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2" />Abeet ta Xoossawu!</para>
  <para style="q2" vid="PSA 22:2">Gallas kumeth</para>
  <para style="q2" vid="PSA 22:2">ta neekko waassishin</para>
  <para style="q2" vid="PSA 22:2">ne siyabeekka;</para>
  <para style="q2" vid="PSA 22:2">qamma ubbaankka neekko</para>
  <para style="q2" vid="PSA 22:2">waasoppe shempabeekke.<verse eid="PSA 22:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3" />Ne gidikko geeshsha kawo;</para>
  <para style="q2" vid="PSA 22:3">Isra7eele galatay</para>
  <para style="q2" vid="PSA 22:3">ne yuushon dees.<verse eid="PSA 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4" />Kase nu aawati</para>
  <para style="q2" vid="PSA 22:4">nenan ammanettida;</para>
  <para style="q2" vid="PSA 22:4">nenan ammanettiin</para>
  <para style="q2" vid="PSA 22:4">ne istta ashshadasa.<verse eid="PSA 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5" />Istti neekko waassiin ashshadasa;</para>
  <para style="q2" vid="PSA 22:5">nenan ammanettiin</para>
  <para style="q2" vid="PSA 22:5">istta yeellasabeekka.<verse eid="PSA 22:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6" />Tani guxune attiin</para>
  <para style="q2" vid="PSA 22:6">as gidikke;</para>
  <para style="q2" vid="PSA 22:6">tani asan kadhettidaadenne</para>
  <para style="q2" vid="PSA 22:6">ixettidaade.<verse eid="PSA 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7" />Tana be7ida ubbati qidheettes;</para>
  <para style="q2" vid="PSA 22:7">zaaridikka inxars</para>
  <para style="q2" vid="PSA 22:7">kessi qidheettes;</para>
  <para style="q2" vid="PSA 22:7">ba qoodhekka</para>
  <para style="q2" vid="PSA 22:7">ta bolla qaaththeettes.<note caller="-" style="x"><char style="xo" closed="false">22:7 </char><char style="xt" closed="false"><ref loc="MAT 27:39">Mato 27:39</ref>; <ref loc="MRK 15:29">Mar 15:29</ref></char></note><verse eid="PSA 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8" />Histtidi, «Izi GODAAN</para>
  <para style="q2" vid="PSA 22:8">ammanettides;</para>
  <para style="q2" vid="PSA 22:8">ane Xoossi iza ashsho;</para>
  <para style="q2" vid="PSA 22:8">izi ufayettidaa gidikko</para>
  <para style="q2" vid="PSA 22:8">ane iza maaddo» geettes.<note caller="-" style="x"><char style="xo" closed="false">22:8 </char><char style="xt" closed="false"><ref loc="MAT 27:43">Mato 27:43</ref></char></note><verse eid="PSA 22:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9" />Gido attiin ta wogara</para>
  <para style="q2" vid="PSA 22:9">yelettana mala maaddiday nena;</para>
  <para style="q2" vid="PSA 22:9">tani ta aayi dhanth</para>
  <para style="q2" vid="PSA 22:9">dhammishinkka</para>
  <para style="q2" vid="PSA 22:9">ne taas ammanettaasa.<verse eid="PSA 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10" />Tani yelettoosofe doommada</para>
  <para style="q2" vid="PSA 22:10">nenan diccadis;</para>
  <para style="q2" vid="PSA 22:10">ta aayey uloppe doommadakka</para>
  <para style="q2" vid="PSA 22:10">neni ta Xoossa.<verse eid="PSA 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11" />Metoy taakko</para>
  <para style="q2" vid="PSA 22:11">mati mati yiza gishshas,</para>
  <para style="q2" vid="PSA 22:11">tana maaddizaykka</para>
  <para style="q2" vid="PSA 22:11">baynda gishshas</para>
  <para style="q2" vid="PSA 22:11">neni taappe haakkofa.<verse eid="PSA 22:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12" />Daro morkketi korma boorata mala</para>
  <para style="q2" vid="PSA 22:12">tana giddoththida;</para>
  <para style="q2" vid="PSA 22:12">qayciza Baasaane biitta</para>
  <para style="q2" vid="PSA 22:12">boorata mala</para>
  <para style="q2" vid="PSA 22:12">tana dooddida.<verse eid="PSA 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13" />Menththereththi yeggidi</para>
  <para style="q2" vid="PSA 22:13">xaaggiza gaammo mala</para>
  <para style="q2" vid="PSA 22:13">ba doona ta bolla doyda.<verse eid="PSA 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14" />Tani haaththa mala goggadis;</para>
  <para style="q2" vid="PSA 22:14">ta meqeththati</para>
  <para style="q2" vid="PSA 22:14">someppe someppe kolettida.</para>
  <para style="q2" vid="PSA 22:14">Ta wozinay muqaadda mala</para>
  <para style="q2" vid="PSA 22:14">ta giddon seerides.<verse eid="PSA 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15" />Taas qoodhey kon7a mala melides;</para>
  <para style="q2" vid="PSA 22:15">ta inxarsay</para>
  <para style="q2" vid="PSA 22:15">gonggiraththara oykettides;</para>
  <para style="q2" vid="PSA 22:15">neni tana hayqqida asa mala</para>
  <para style="q2" vid="PSA 22:15">gudullan baanan yeggadasa.<note caller="+" style="f"><char style="fr" closed="false">22:15 </char><char style="ft" closed="false">Gonggirath gizayssi issi issi bagga gamoththo qaalan hangaro geetettees.</char></note><verse eid="PSA 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16" />Kanati tana giddoththida;</para>
  <para style="q2" vid="PSA 22:16">Iita asati tana dooddi oykkida;</para>
  <para style="q2" vid="PSA 22:16">Ta kushetanne</para>
  <para style="q2" vid="PSA 22:16">ta tohota shiishshi dhishkida.<verse eid="PSA 22:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17" />Tani meqeththata</para>
  <para style="q2" vid="PSA 22:17">qoodana dandayays;</para>
  <para style="q2" vid="PSA 22:17">ta morkketikka</para>
  <para style="q2" vid="PSA 22:17">tana phirxi histti xeelleettes.<verse eid="PSA 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18" />Ta may7oza gishetti ekkida;</para>
  <para style="q2" vid="PSA 22:18">ta adussa may7ozan</para>
  <para style="q2" vid="PSA 22:18">saama yeggida.<note caller="-" style="x"><char style="xo" closed="false">22:18 </char><char style="xt" closed="false"><ref loc="MAT 27:35">Mato 27:35</ref>; <ref loc="MRK 15:24">Mar 15:24</ref>; <ref loc="LUK 23:34">Luqa 23:34</ref>; <ref loc="JHN 19:24">Yoha 19:24</ref></char></note><verse eid="PSA 22:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 22:19">Neni ha7i taappe haakkofa.</para>
  <para style="q2" vid="PSA 22:19">Abeet ta wolqqawu!</para>
  <para style="q2" vid="PSA 22:19">Tana maaddanaas eesota.<verse eid="PSA 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20" />Tana mashshafe ashsha;</para>
  <para style="q2" vid="PSA 22:20">ta shemppoyo</para>
  <para style="q2" vid="PSA 22:20">wolqqama kanatappe ashsha.<verse eid="PSA 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21" />Tana gaammota doonappe ashsha;</para>
  <para style="q2" vid="PSA 22:21">qayciza menththa kacezappe</para>
  <para style="q2" vid="PSA 22:21">tana naaga.<verse eid="PSA 22:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22" />Tani ne sunththa</para>
  <para style="q2" vid="PSA 22:22">ta ishatas yootana;</para>
  <para style="q2" vid="PSA 22:22">istti shiiqidasonkka</para>
  <para style="q2" vid="PSA 22:22">ta nena galatana.<note caller="-" style="x"><char style="xo" closed="false">22:22 </char><char style="xt" closed="false"><ref loc="HEB 2:12">Ib 2:12</ref></char></note><verse eid="PSA 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23" />Intteno GODAAS yayyizaytoo,</para>
  <para style="q2" vid="PSA 22:23">iza galatite!</para>
  <para style="q2" vid="PSA 22:23">intteno Yaaqoobe zereththatoo!</para>
  <para style="q2" vid="PSA 22:23">Ubbayka iza bonchchite!</para>
  <para style="q2" vid="PSA 22:23">intteno Isra7eele zereththatoo!</para>
  <para style="q2" vid="PSA 22:23">Ubbatikka bonchchon</para>
  <para style="q2" vid="PSA 22:23">izas yayyite!<verse eid="PSA 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24" />Izi naaqettidayssa kadhibeenna;</para>
  <para style="q2" vid="PSA 22:24">metotishin yeggi aadhdhibeenna;</para>
  <para style="q2" vid="PSA 22:24">ba sinththa izappe</para>
  <para style="q2" vid="PSA 22:24">genththibeenna;</para>
  <para style="q2" vid="PSA 22:24">izi maaddarkki gi waassiin</para>
  <para style="q2" vid="PSA 22:24">iza waaso siyides.<verse eid="PSA 22:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25" />Neni ooththida lo7o ooso gishshas,</para>
  <para style="q2" vid="PSA 22:25">derey shiiqidason galatana;</para>
  <para style="q2" vid="PSA 22:25">ta adinidayssa nena yayyiza</para>
  <para style="q2" vid="PSA 22:25">asaa sinththan gaththana.<verse eid="PSA 22:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26" />Hiyeesati miidi kallana.</para>
  <para style="q2" vid="PSA 22:26">GODAA koyzayti iza galatana.</para>
  <para style="q2" vid="PSA 22:26">Istti mernaas ufayettana.<verse eid="PSA 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27" />Sa7a gaxa gakkanaas diza asay</para>
  <para style="q2" vid="PSA 22:27">iza gishshas yuushshi qoppana;</para>
  <para style="q2" vid="PSA 22:27">GODAAKKO simmana.</para>
  <para style="q2" vid="PSA 22:27">Asa zere ubbay izas goynnana.<verse eid="PSA 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28" />Ays giikko maatay izassa;</para>
  <para style="q2" vid="PSA 22:28">kawoteththay ubbay izas haarettana.<verse eid="PSA 22:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29" />Sa7a bolla diza dureti</para>
  <para style="q2" vid="PSA 22:29">izas goynnana.</para>
  <para style="q2" vid="PSA 22:29">Bana hayqoppe ashshanawu</para>
  <para style="q2" vid="PSA 22:29">dandayontta biittan</para>
  <para style="q2" vid="PSA 22:29">baana asi ubbay</para>
  <para style="q2" vid="PSA 22:29">iza sinththan gulbatana.<verse eid="PSA 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30" />Buro yaana yeletay izas ooththana;</para>
  <para style="q2" vid="PSA 22:30">he yeletay kaalli yiza yeletas</para>
  <para style="q2" vid="PSA 22:30">Godaa ooso yootana.<verse eid="PSA 22:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31" />Istti iza xilloteththa gishshas</para>
  <para style="q2" vid="PSA 22:31">buro yaana yeletas yootana.<verse eid="PSA 22:31" /></para>
  <chapter eid="PSA 22" />
  <chapter number="23" style="c" sid="PSA 23" />
  <para style="s1">Dawite Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1" />GODAY ta heenththanchcha;</para>
  <para style="q2" vid="PSA 23:1">taas aykkoyka paccenna.<verse eid="PSA 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 23:2" />Tana aaca qooron shempisees;</para>
  <para style="q2" vid="PSA 23:2">xillo haaththi dizaso</para>
  <para style="q2" vid="PSA 23:2">tana kaaleththees.<note caller="-" style="x"><char style="xo" closed="false">23:2 </char><char style="xt" closed="false"><ref loc="REV 7:17">Ajju 7:17</ref></char></note><verse eid="PSA 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 23:3" />Ta de7o ooraxissees.</para>
  <para style="q2" vid="PSA 23:3">Ba sunththa gishshas</para>
  <para style="q2" vid="PSA 23:3">tana xilloteththa ogen kaaleththees.<verse eid="PSA 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4" />Neni ta GODAY tanara diza gishshas</para>
  <para style="q2" vid="PSA 23:4">tani girdi gida</para>
  <para style="q2" vid="PSA 23:4">dhuma shoobba giddora biikkoka</para>
  <para style="q2" vid="PSA 23:4">iita miishshas babbike.</para>
  <para style="q2" vid="PSA 23:4">Ne guufeynne gatumay</para>
  <para style="q2" vid="PSA 23:4">tana minththeththees.<verse eid="PSA 23:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5" />Ta morkketa sinththan</para>
  <para style="q2" vid="PSA 23:5">taas maadda giigsadasa;</para>
  <para style="q2" vid="PSA 23:5">ta hu7e zayten tiyadasa;</para>
  <para style="q2" vid="PSA 23:5">ta ushshi kunththa palahissadasa.<verse eid="PSA 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6" />Ne kiyateththinne ne maaroteththay</para>
  <para style="q2" vid="PSA 23:6">ta de7o layththa ubbaan</para>
  <para style="q2" vid="PSA 23:6">tana kaallana;</para>
  <para style="q2" vid="PSA 23:6">tani GODAA keeththan mernaas daana.<verse eid="PSA 23:6" /></para>
  <chapter eid="PSA 23" />
  <chapter number="24" style="c" sid="PSA 24" />
  <para style="s1">Dawiti Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1" />Sa7aynne sa7an kumida</para>
  <para style="q2" vid="PSA 24:1">ubbay GODAASSA;</para>
  <para style="q2" vid="PSA 24:1">salo gufanththon diza</para>
  <para style="q2" vid="PSA 24:1">ubbay Xoossassa.<note caller="-" style="x"><char style="xo" closed="false">24:1 </char><char style="xt" closed="false"><ref loc="1CO 10:26">1Qoro 10:26</ref></char></note><verse eid="PSA 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2" />Sa7aa gita abbata bolla miccides;</para>
  <para style="q2" vid="PSA 24:2">haaththa bollaka</para>
  <para style="q2" vid="PSA 24:2">minththidi essides.<verse eid="PSA 24:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3" />GODAA zuma bolla kezanay oonee?</para>
  <para style="q2" vid="PSA 24:3">Iza geeshshasohon</para>
  <para style="q2" vid="PSA 24:3">eqqanay oonee?<verse eid="PSA 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4" />Iza kushey nagarappe geeyiday,</para>
  <para style="q2" vid="PSA 24:4">iza wozinay geeshsha gididay,</para>
  <para style="q2" vid="PSA 24:4">eeqa xoossatas goynnonttay,</para>
  <para style="q2" vid="PSA 24:4">wordo caaqqonttay,<note caller="-" style="x"><char style="xo" closed="false">24:4 </char><char style="xt" closed="false"><ref loc="MAT 5:8">Mato 5:8</ref></char></note><verse eid="PSA 24:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 24:5" />izi GODAAPPE anjjo ekkana;</para>
  <para style="q2" vid="PSA 24:5">bana ashshiza Xoossafe</para>
  <para style="q2" vid="PSA 24:5">xillo pirda demmana.<verse eid="PSA 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6" />Xoossako xeelliza asaynne</para>
  <para style="q2" vid="PSA 24:6">Yaaqoobe Xoossaa sinth</para>
  <para style="q2" vid="PSA 24:6">koyza asay heytantta mala.<verse eid="PSA 24:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7" />Kareti doyettetto;</para>
  <para style="q2" vid="PSA 24:7">Bonchcho Kawoy gelo;</para>
  <para style="q2" vid="PSA 24:7">beni pengeti</para>
  <para style="q2" vid="PSA 24:7">iza ufayssan mokkite!<verse eid="PSA 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8" />He Bonchcho Kawoy oonee?</para>
  <para style="q2" vid="PSA 24:8">Minonne wolqqama GODAA!</para>
  <para style="q2" vid="PSA 24:8">Olaska izi wolqqama GODAA!<verse eid="PSA 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9" />Kareti doyettetto;</para>
  <para style="q2" vid="PSA 24:9">Bonchcho Kawoy gelo;</para>
  <para style="q2" vid="PSA 24:9">beni pengeti</para>
  <para style="q2" vid="PSA 24:9">iza ufayssan mokkite!<verse eid="PSA 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10" />Ha Bonchcho Kawoy oonee?</para>
  <para style="q2" vid="PSA 24:10">He Bonchcho Kawoy</para>
  <para style="q2" vid="PSA 24:10">salo medheteththa GODAA!<verse eid="PSA 24:10" /></para>
  <chapter eid="PSA 24" />
  <chapter number="25" style="c" sid="PSA 25" />
  <para style="s1">Dawite Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 25:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 25:1">Ta nena wozinappe woossays.<verse eid="PSA 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2" />Abeet ta Xoossawu!</para>
  <para style="q2" vid="PSA 25:2">Tani nenan ammanettays;</para>
  <para style="q2" vid="PSA 25:2">tana yeellasoppa;</para>
  <para style="q2" vid="PSA 25:2">ta morkketikka</para>
  <para style="q2" vid="PSA 25:2">ta bolla ceeqettofetto.<verse eid="PSA 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3" />Nena hidota ooththizayti</para>
  <para style="q2" vid="PSA 25:3">yeellatettenna;</para>
  <para style="q2" vid="PSA 25:3">gido attiin gene ooththizayti</para>
  <para style="q2" vid="PSA 25:3">yeellatana.<verse eid="PSA 25:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 25:4">Tana ne oge bessa;</para>
  <para style="q2" vid="PSA 25:4">ne geedo kaalo tana tamaarsa.<verse eid="PSA 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5" />Neni tana ashshiza Xoossa;</para>
  <para style="q2" vid="PSA 25:5">ne tumateththan</para>
  <para style="q2" vid="PSA 25:5">tana kaaleththanne tamaarsa;</para>
  <para style="q2" vid="PSA 25:5">ubba wode ta hidotay nena.<verse eid="PSA 25:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 25:6">Beniisofe diza ne qadheteththaanne</para>
  <para style="q2" vid="PSA 25:6">ne kiyateththa hassa7a.<verse eid="PSA 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7" />Ta yelagateththa nagaranne</para>
  <para style="q2" vid="PSA 25:7">mooro hassa7oppa;</para>
  <para style="q2" vid="PSA 25:7">Abeet GODAWU!</para>
  <para style="q2" vid="PSA 25:7">Ne gita kiyateththa malanne</para>
  <para style="q2" vid="PSA 25:7">ne lo7eteththa keena tana qoppa;<verse eid="PSA 25:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8" />GODAY kiyanne suure;</para>
  <para style="q2" vid="PSA 25:8">hessa gishshas nagaranchchata</para>
  <para style="q2" vid="PSA 25:8">ba oge tamaarssees.<verse eid="PSA 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9" />Ashketa suure ogera kaaleththees;</para>
  <para style="q2" vid="PSA 25:9">isttaka ba oge tamaarssees.<verse eid="PSA 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10" />GODAA caaqo qaalanne</para>
  <para style="q2" vid="PSA 25:10">maara naagizaytas</para>
  <para style="q2" vid="PSA 25:10">iza ogey ubbay kiyanne tuma.<verse eid="PSA 25:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 25:11">Ta nagaray keehi daro;</para>
  <para style="q2" vid="PSA 25:11">gidikkoka ne sunththa gishshas</para>
  <para style="q2" vid="PSA 25:11">atto ga.<verse eid="PSA 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12" />GODAAS yayyiza asi oonee?</para>
  <para style="q2" vid="PSA 25:12">Ne doorada baana ogeza</para>
  <para style="q2" vid="PSA 25:12">izi nena tamaarsana.<verse eid="PSA 25:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13" />Izi ubbaa wodekka lo7o duus daana;</para>
  <para style="q2" vid="PSA 25:13">iza zereththati biitta laattana.<verse eid="PSA 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14" />GODAY bana yayyizaytappe</para>
  <para style="q2" vid="PSA 25:14">ba xuura qottenna;</para>
  <para style="q2" vid="PSA 25:14">izi isttas ba gelida caaqo</para>
  <para style="q2" vid="PSA 25:14">qaalakka erisees.<verse eid="PSA 25:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15" />GODAY ta toho</para>
  <para style="q2" vid="PSA 25:15">narxafe kessi ekkiza gishshas,</para>
  <para style="q2" vid="PSA 25:15">ta ayfey maado demmanaas</para>
  <para style="q2" vid="PSA 25:15">ubba wode izakko xeellees.<verse eid="PSA 25:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16" />GODAWU! Tani bizza dizaadenne</para>
  <para style="q2" vid="PSA 25:16">qohettida as gidida gishshas,</para>
  <para style="q2" vid="PSA 25:16">ne haa taakko simma;</para>
  <para style="q2" vid="PSA 25:16">ne maaroteththaka bessa.<verse eid="PSA 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17" />Taas metoy darides;</para>
  <para style="q2" vid="PSA 25:17">ta metozappe tana neni kessa.<verse eid="PSA 25:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18" />Ta metozanne</para>
  <para style="q2" vid="PSA 25:18">ta tuggaa neni be7a;</para>
  <para style="q2" vid="PSA 25:18">Ta nagara ubbaa atto ga.<verse eid="PSA 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19" />Ta morkketi ay keena daridaakko</para>
  <para style="q2" vid="PSA 25:19">ne be7a;</para>
  <para style="q2" vid="PSA 25:19">istti tana ay mala ixxizaakko</para>
  <para style="q2" vid="PSA 25:19">ne xeella.<verse eid="PSA 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20" />Neni tana naaganne ashsha;</para>
  <para style="q2" vid="PSA 25:20">ta nenan zemppadis;</para>
  <para style="q2" vid="PSA 25:20">ne tana yeellasoppa.<verse eid="PSA 25:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21" />Ne taas hidota gidida gishshas</para>
  <para style="q2" vid="PSA 25:21">suureteththaynne tumateththay</para>
  <para style="q2" vid="PSA 25:21">tana naago.<verse eid="PSA 25:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 25:22">Isra7eele asa</para>
  <para style="q2" vid="PSA 25:22">meto ubbaafe neni wozza.<verse eid="PSA 25:22" /></para>
  <chapter eid="PSA 25" />
  <chapter number="26" style="c" sid="PSA 26" />
  <para style="s1">Dawite Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 26:1">Tani suureteththaninne</para>
  <para style="q2" vid="PSA 26:1">sidhey baynda</para>
  <para style="q2" vid="PSA 26:1">nenan ammanetta</para>
  <para style="q2" vid="PSA 26:1">de7ida gishshas</para>
  <para style="q2" vid="PSA 26:1">ne taas pirda.<verse eid="PSA 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2" />Abeet GODAWU! Tana paacca;</para>
  <para style="q2" vid="PSA 26:2">ta qanth pilgga;</para>
  <para style="q2" vid="PSA 26:2">ta wozina xeella;<verse eid="PSA 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3" />Ays giikko ne siiqoy</para>
  <para style="q2" vid="PSA 26:3">ta sinththan dees;</para>
  <para style="q2" vid="PSA 26:3">tani ne tumateththa</para>
  <para style="q2" vid="PSA 26:3">ogen hemettays.<verse eid="PSA 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4" />Tani baleththiza asatara</para>
  <para style="q2" vid="PSA 26:4">issife uttike;</para>
  <para style="q2" vid="PSA 26:4">lo7o misatiza</para>
  <para style="q2" vid="PSA 26:4">iitata maabaran gelikke.<verse eid="PSA 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5" />Iita ooththiza asata issifeteththa</para>
  <para style="q2" vid="PSA 26:5">tani ixxays;</para>
  <para style="q2" vid="PSA 26:5">kofa asatara issife uttike.<verse eid="PSA 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 26:6">Tanan qohoy</para>
  <para style="q2" vid="PSA 26:6">bayndayssa bessanaas</para>
  <para style="q2" vid="PSA 26:6">ta kusheza meeccays;</para>
  <para style="q2" vid="PSA 26:6">histtada yarsho</para>
  <para style="q2" vid="PSA 26:6">yarshizasoza yuuyays.<verse eid="PSA 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7" />Galata mazamure yexxays;</para>
  <para style="q2" vid="PSA 26:7">neni ooththida miish</para>
  <para style="q2" vid="PSA 26:7">ubbaaka yootays.<verse eid="PSA 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 26:8">Neni de7iza keeththanne</para>
  <para style="q2" vid="PSA 26:8">ne bonchchoy aqizasoho</para>
  <para style="q2" vid="PSA 26:8">tani dosays.<verse eid="PSA 26:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9" />Tana nagaranchchatara</para>
  <para style="q2" vid="PSA 26:9">issife pirdofa;</para>
  <para style="q2" vid="PSA 26:9">as wodhizaytarakka issife</para>
  <para style="q2" vid="PSA 26:9">ta shemppo dhayssofa.<verse eid="PSA 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10" />Istta kushen iita halchchoy dees;</para>
  <para style="q2" vid="PSA 26:10">qasse istta ushachcha kushey</para>
  <para style="q2" vid="PSA 26:10">matta7en kumides.<verse eid="PSA 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11" />Tani gidikko borey baynda</para>
  <para style="q2" vid="PSA 26:11">duus days;</para>
  <para style="q2" vid="PSA 26:11">tana wozza;</para>
  <para style="q2" vid="PSA 26:11">taas qadhetta.<verse eid="PSA 26:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12" />Ta tohoy dembason eqqides;</para>
  <para style="q2" vid="PSA 26:12">tani derey shiiqidason GODAA galatana.<verse eid="PSA 26:12" /></para>
  <chapter eid="PSA 26" />
  <chapter number="27" style="c" sid="PSA 27" />
  <para style="s1">Dawite Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1" />GODAY taas poo7onne</para>
  <para style="q2" vid="PSA 27:1">tana ashshizayssa;</para>
  <para style="q2" vid="PSA 27:1">histtiin tani oonas yayyanee?</para>
  <para style="q2" vid="PSA 27:1">GODAY ta shemppoys</para>
  <para style="q2" vid="PSA 27:1">attiza miixa;</para>
  <para style="q2" vid="PSA 27:1">histtiin tani oonas babbanee?<verse eid="PSA 27:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2" />Iita asati, ta morkketinne</para>
  <para style="q2" vid="PSA 27:2">ta balgaarati</para>
  <para style="q2" vid="PSA 27:2">tana wodhanawu</para>
  <para style="q2" vid="PSA 27:2">taakko hordofi yiza wode,</para>
  <para style="q2" vid="PSA 27:2">istti baas dhuphettidi kundana.<verse eid="PSA 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3" />Morkke tooray</para>
  <para style="q2" vid="PSA 27:3">tana dooddizaakkoka</para>
  <para style="q2" vid="PSA 27:3">ta wozinay yayyenna;</para>
  <para style="q2" vid="PSA 27:3">olay ta bolla worajjidaakkoka,</para>
  <para style="q2" vid="PSA 27:3">tani GODAAN ammanettays.<verse eid="PSA 27:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4" />Tani GODAA issi miish oychchays;</para>
  <para style="q2" vid="PSA 27:4">hessika tani</para>
  <para style="q2" vid="PSA 27:4">ta de7o layth ubbaan</para>
  <para style="q2" vid="PSA 27:4">GODAA keeththan de7anaassa;</para>
  <para style="q2" vid="PSA 27:4">tani GODAA bonchcho</para>
  <para style="q2" vid="PSA 27:4">lo7oteththa be7anaassa;</para>
  <para style="q2" vid="PSA 27:4">iza Keeththankka</para>
  <para style="q2" vid="PSA 27:4">iza koyashe de7anaassa.<verse eid="PSA 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5" />Hessa gishshas meto gallas</para>
  <para style="q2" vid="PSA 27:5">izi tana ba dizason genththana;</para>
  <para style="q2" vid="PSA 27:5">ba dunkaanen</para>
  <para style="q2" vid="PSA 27:5">tana qotti ashshana;</para>
  <para style="q2" vid="PSA 27:5">dhoqqa zaalla bollaka</para>
  <para style="q2" vid="PSA 27:5">izi tana essana.<verse eid="PSA 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6" />He wode tana dooddida</para>
  <para style="q2" vid="PSA 27:6">ta morkketappe bollara</para>
  <para style="q2" vid="PSA 27:6">dhoqqu dhoqqu gaana;</para>
  <para style="q2" vid="PSA 27:6">tani iza Dunkaaneza sinththan</para>
  <para style="q2" vid="PSA 27:6">ufayssa yarsho yarshana;</para>
  <para style="q2" vid="PSA 27:6">tani GODAAS diixxananne</para>
  <para style="q2" vid="PSA 27:6">yexxana.<verse eid="PSA 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 27:7">Tani nena xeygiza wode</para>
  <para style="q2" vid="PSA 27:7">neni taas koya;</para>
  <para style="q2" vid="PSA 27:7">taas qadhetta; tana siya.<verse eid="PSA 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8" />Neni, «Ta sinththa</para>
  <para style="q2" vid="PSA 27:8">koyite» gida wode,</para>
  <para style="q2" vid="PSA 27:8">ta wozinay,</para>
  <para style="q2" vid="PSA 27:8">«Abeet GODAWU! Eeno;</para>
  <para style="q2" vid="PSA 27:8">tani ne sinththa koyana» gides.<verse eid="PSA 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9" />Abeet tana ashshiza ta Xoossawu!</para>
  <para style="q2" vid="PSA 27:9">Neni tana maaddizaade;</para>
  <para style="q2" vid="PSA 27:9">Ne sinththa taappe genththofa;</para>
  <para style="q2" vid="PSA 27:9">tana ne aylle hanqettada</para>
  <para style="q2" vid="PSA 27:9">neeppe haassofa.</para>
  <para style="q2" vid="PSA 27:9">Tana oloppanne aggofa.<verse eid="PSA 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10" />Ta aawaynne</para>
  <para style="q2" vid="PSA 27:10">ta aaya tana aggikokka</para>
  <para style="q2" vid="PSA 27:10">GODAY tana shiishshi ekkana.<verse eid="PSA 27:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 27:11">Ne oge tana tamaarsa;</para>
  <para style="q2" vid="PSA 27:11">ta morkketa gishshas</para>
  <para style="q2" vid="PSA 27:11">tana suure ogera kaaleththa.<verse eid="PSA 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12" />Wordo markkati</para>
  <para style="q2" vid="PSA 27:12">ta bolla makkallateththan</para>
  <para style="q2" vid="PSA 27:12">dendida;</para>
  <para style="q2" vid="PSA 27:12">hessa gishshas ne tana</para>
  <para style="q2" vid="PSA 27:12">istta iita amos aaththa immofa.<verse eid="PSA 27:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13" />Tani shemppora paxa dashe</para>
  <para style="q2" vid="PSA 27:13">GODAA kiyateth beyanayssa</para>
  <para style="q2" vid="PSA 27:13">hidota ooththays.<verse eid="PSA 27:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14" />GODAAN ammanetta;</para>
  <para style="q2" vid="PSA 27:14">minna, hidota qanxxofa,</para>
  <para style="q2" vid="PSA 27:14">GODAAN ammanetta.<verse eid="PSA 27:14" /></para>
  <chapter eid="PSA 27" />
  <chapter number="28" style="c" sid="PSA 28" />
  <para style="s1">Dawite Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1" />Abeet GODAWU! Ta Zaallawu!</para>
  <para style="q2" vid="PSA 28:1">Tani nena xeygishin</para>
  <para style="q2" vid="PSA 28:1">taas sissi ixxofa;</para>
  <para style="q2" vid="PSA 28:1">ta waassishin ne co7u giikko</para>
  <para style="q2" vid="PSA 28:1">tani duufon geliza</para>
  <para style="q2" vid="PSA 28:1">asata mala gidana.<verse eid="PSA 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2" />Ta kusheza ne Geeshsha</para>
  <para style="q2" vid="PSA 28:2">aqoso miccada woossishinne</para>
  <para style="q2" vid="PSA 28:2">tana maaddarkki gaada</para>
  <para style="q2" vid="PSA 28:2">ta waassishin ne siya.<verse eid="PSA 28:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3" />Ba wozinan iita qoppishe</para>
  <para style="q2" vid="PSA 28:3">ba laggetara saroteth haasayza</para>
  <para style="q2" vid="PSA 28:3">iita ooththizaytara</para>
  <para style="q2" vid="PSA 28:3">tana isttara gaththa efoppa.<verse eid="PSA 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4" />Ne isttas istta iitateththaa malanne</para>
  <para style="q2" vid="PSA 28:4">istta ooso mala imma;</para>
  <para style="q2" vid="PSA 28:4">isttas istta kushe</para>
  <para style="q2" vid="PSA 28:4">ooso mala zaara;</para>
  <para style="q2" vid="PSA 28:4">istti ooththida iita oosozas</para>
  <para style="q2" vid="PSA 28:4">halo kessa.<note caller="-" style="x"><char style="xo" closed="false">28:4 </char><char style="xt" closed="false"><ref loc="REV 22:12">Ajju 22:12</ref></char></note><verse eid="PSA 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5" />Istti GODAA oosos wudu gontta</para>
  <para style="q2" vid="PSA 28:5">ixxida gishshas,</para>
  <para style="q2" vid="PSA 28:5">iza kushe oosotas soho</para>
  <para style="q2" vid="PSA 28:5">immontta aggida gishshas,</para>
  <para style="q2" vid="PSA 28:5">izi istta laallana;</para>
  <para style="q2" vid="PSA 28:5">zaaridikka keexxenna.<verse eid="PSA 28:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6" />Ta woosa siyida gishshas,</para>
  <para style="q2" vid="PSA 28:6">GODAY galatetto.<verse eid="PSA 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7" />GODAY taas wolqqanne gondalle;</para>
  <para style="q2" vid="PSA 28:7">ta wozinay izan ammaneettes;</para>
  <para style="q2" vid="PSA 28:7">hessan tani maadettadis;</para>
  <para style="q2" vid="PSA 28:7">hessa gishshas</para>
  <para style="q2" vid="PSA 28:7">ta wozinay izan ufayettees;</para>
  <para style="q2" vid="PSA 28:7">tani iza yeththan sabbana.<verse eid="PSA 28:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8" />GODAY ba deraas wolqqa;</para>
  <para style="q2" vid="PSA 28:8">izi ba tiyda kawoza</para>
  <para style="q2" vid="PSA 28:8">ashshiza miixa.<verse eid="PSA 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9" />GODAWU! Ne deraa ashsha;</para>
  <para style="q2" vid="PSA 28:9">nees gidizayta anjja;</para>
  <para style="q2" vid="PSA 28:9">istta heenththanchchay</para>
  <para style="q2" vid="PSA 28:9">nena gida;</para>
  <para style="q2" vid="PSA 28:9">neni istta mernaaskka tookka.<verse eid="PSA 28:9" /></para>
  <chapter eid="PSA 28" />
  <chapter number="29" style="c" sid="PSA 29" />
  <para style="s1">Dawite Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 29:1" />Intteno salon diza medhetatoo!</para>
  <para style="q2" vid="PSA 29:1">«Bonchchoynne wolqqay</para>
  <para style="q2" vid="PSA 29:1">GODAASSA» giidi yootite.<verse eid="PSA 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2" />GODAA bonchcho</para>
  <para style="q2" vid="PSA 29:2">sunththaa galatite;</para>
  <para style="q2" vid="PSA 29:2">Iza geeshshateththa teemas</para>
  <para style="q2" vid="PSA 29:2">GODAA goynnite.<note caller="-" style="x"><char style="xo" closed="false">29:1-2 </char><char style="xt" closed="false"><ref loc="PSA 96:7-9">Maza 96:7-9</ref></char></note><verse eid="PSA 29:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3" />GODAA cenggurssay</para>
  <para style="q2" vid="PSA 29:3">haaththata bollan siyettees.</para>
  <para style="q2" vid="PSA 29:3">Bonchcho Xoossay</para>
  <para style="q2" vid="PSA 29:3">dada mala guummees;</para>
  <para style="q2" vid="PSA 29:3">GODAY gita haaththata bollan</para>
  <para style="q2" vid="PSA 29:3">guummees.<verse eid="PSA 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4" />GODAA cenggurssay wolqqama;</para>
  <para style="q2" vid="PSA 29:4">GODAA gunththay,</para>
  <para style="q2" vid="PSA 29:4">«Nees hoola!» giissizaaza.<verse eid="PSA 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5" />GODAA cenggurssay</para>
  <para style="q2" vid="PSA 29:5">ziga miththa menththereththees;</para>
  <para style="q2" vid="PSA 29:5">Libaanoose zigatakka</para>
  <para style="q2" vid="PSA 29:5">GODAY menththereththees.<verse eid="PSA 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6" />Libaanoose zumaa</para>
  <para style="q2" vid="PSA 29:6">galo mara mala buraqissees;</para>
  <para style="q2" vid="PSA 29:6">Siriyoone zumaakka</para>
  <para style="q2" vid="PSA 29:6">menththa mala xikisees.<note caller="+" style="f"><char style="fr" closed="false">29:6 </char><char style="ft" closed="false">Sidoona qaalara Siriyoone gizayssi Hermoone bessees.</char></note><verse eid="PSA 29:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7" />GODAA cenggurssay</para>
  <para style="q2" vid="PSA 29:7">wolqqanth popol7u gees.<verse eid="PSA 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8" />GODAA cenggurssay</para>
  <para style="q2" vid="PSA 29:8">bazzo qaaththees;</para>
  <para style="q2" vid="PSA 29:8">GODAY Qaadeese Bazzo qaaththees.<verse eid="PSA 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9" />GODAA cenggurssay</para>
  <para style="q2" vid="PSA 29:9">wolata qaaththees;</para>
  <para style="q2" vid="PSA 29:9">miththa hayththika qoqofees.</para>
  <para style="q2" vid="PSA 29:9">Iza Keeththan de7izayti,</para>
  <para style="q2" vid="PSA 29:9">«Bonchchoy</para>
  <para style="q2" vid="PSA 29:9">GODAAS gido» geettes.<verse eid="PSA 29:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10" />GODAY di7o haaththa bolla</para>
  <para style="q2" vid="PSA 29:10">ba araata woththidi uttides;</para>
  <para style="q2" vid="PSA 29:10">GODAY ba kawoteththa</para>
  <para style="q2" vid="PSA 29:10">algan uttidi</para>
  <para style="q2" vid="PSA 29:10">mernaas haarees.<verse eid="PSA 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11" />GODAY ba deraas wolqqa immees.</para>
  <para style="q2" vid="PSA 29:11">Ba asaakka saroteththan anjjees.<verse eid="PSA 29:11" /></para>
  <chapter eid="PSA 29" />
  <chapter number="30" style="c" sid="PSA 30" />
  <para style="s1">Keeththa Anjjisos Yexettida Dawite Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 30:1">Neni tana ciimmafe kessadasa;</para>
  <para style="q2" vid="PSA 30:1">ta morkketi ta bolla</para>
  <para style="q2" vid="PSA 30:1">ufayettontta mala ooththadasa;</para>
  <para style="q2" vid="PSA 30:1">hessas ta nena</para>
  <para style="q2" vid="PSA 30:1">dhoqqu dhoqqu histtays.<verse eid="PSA 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2" />Abeet ta GODAWU!</para>
  <para style="q2" vid="PSA 30:2">Neni tana maaddana mala</para>
  <para style="q2" vid="PSA 30:2">ta neekko waassadis;</para>
  <para style="q2" vid="PSA 30:2">nekka tana paththadasa.<verse eid="PSA 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 30:3">Tana duufon bontta mala</para>
  <para style="q2" vid="PSA 30:3">naagadasa;</para>
  <para style="q2" vid="PSA 30:3">duge ciimma ollan gelontta mala</para>
  <para style="q2" vid="PSA 30:3">neni tana ashshadasa.<verse eid="PSA 30:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4" />Intteno Xoossa asatoo!</para>
  <para style="q2" vid="PSA 30:4">GODAAS yexxite;</para>
  <para style="q2" vid="PSA 30:4">iza geeshsha sunththaaka sabbite.<verse eid="PSA 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5" />Iza hanqoy guuththa wodessa,</para>
  <para style="q2" vid="PSA 30:5">gido attiin iza kiyateththi</para>
  <para style="q2" vid="PSA 30:5">de7o layth ubbaassa;</para>
  <para style="q2" vid="PSA 30:5">omars yeekkishe aqikkoka</para>
  <para style="q2" vid="PSA 30:5">maalado zaway</para>
  <para style="q2" vid="PSA 30:5">baynda ufays gidees.<verse eid="PSA 30:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6" />Tani woppan diza wode,</para>
  <para style="q2" vid="PSA 30:6">«Tani mulekka kokkorikke» gadis.<verse eid="PSA 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 30:7">Neni taas kiyida wode,</para>
  <para style="q2" vid="PSA 30:7">tana gita zuma mala</para>
  <para style="q2" vid="PSA 30:7">minththa essadasa;</para>
  <para style="q2" vid="PSA 30:7">gido attiin neni ne sinththaa</para>
  <para style="q2" vid="PSA 30:7">taappe haraso zaarida wode</para>
  <para style="q2" vid="PSA 30:7">tani dagammadis.<verse eid="PSA 30:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 30:8">Tani nena xeygadis;</para>
  <para style="q2" vid="PSA 30:8">tani Godaappe</para>
  <para style="q2" vid="PSA 30:8">maaroteth woossadis;<verse eid="PSA 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9" />«Ta hayqqiko woykko</para>
  <para style="q2" vid="PSA 30:9">duufon gelikko</para>
  <para style="q2" vid="PSA 30:9">ne taappe ay demmanee?</para>
  <para style="q2" vid="PSA 30:9">Biittan gelida asi</para>
  <para style="q2" vid="PSA 30:9">nena galati erizee?</para>
  <para style="q2" vid="PSA 30:9">Ne ammaneteththa</para>
  <para style="q2" vid="PSA 30:9">haasayi erizee?<verse eid="PSA 30:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 30:10">Ta woosa ne siya;</para>
  <para style="q2" vid="PSA 30:10">taas qadhetta.</para>
  <para style="q2" vid="PSA 30:10">Abeet GODAWU!</para>
  <para style="q2" vid="PSA 30:10">Ne taas maado gida» gadis.<verse eid="PSA 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11" />Ta yeeho yeththan laammadasa.</para>
  <para style="q2" vid="PSA 30:11">Kayo may7oza taappe qaarada</para>
  <para style="q2" vid="PSA 30:11">ufayssa may7o</para>
  <para style="q2" vid="PSA 30:11">tana mayzadasa.<verse eid="PSA 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12" />Hessa gishshas tani nena</para>
  <para style="q2" vid="PSA 30:12">sabbanaappe attiin co7u giikke.</para>
  <para style="q2" vid="PSA 30:12">Abeet ta GODAWU!</para>
  <para style="q2" vid="PSA 30:12">Tani nena mernaas galatana.<verse eid="PSA 30:12" /></para>
  <chapter eid="PSA 30" />
  <chapter number="31" style="c" sid="PSA 31" />
  <para style="s1">Dawiti Zammareta Kaabbos Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 31:1">Ne taas kuwa gidana mala</para>
  <para style="q2" vid="PSA 31:1">ta neekko yadis;</para>
  <para style="q2" vid="PSA 31:1">aydekka tana yeellasoppa;</para>
  <para style="q2" vid="PSA 31:1">ne xilloteththan tana ashsha.<verse eid="PSA 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2" />Ne hayththa taakko zaara;</para>
  <para style="q2" vid="PSA 31:2">eeson tana ashsha;</para>
  <para style="q2" vid="PSA 31:2">neni tana genththiza zaalla gida;</para>
  <para style="q2" vid="PSA 31:2">tana ashshiza mino miixa</para>
  <para style="q2" vid="PSA 31:2">taas gida.<verse eid="PSA 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3" />Ee, neni taas zaalla;</para>
  <para style="q2" vid="PSA 31:3">ta izan gela attiza miixa;</para>
  <para style="q2" vid="PSA 31:3">ne sunththa gishshas</para>
  <para style="q2" vid="PSA 31:3">tani baana oge</para>
  <para style="q2" vid="PSA 31:3">bessanne kaaleththa.<verse eid="PSA 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4" />Neni taas zemppo gidiza gishshas,</para>
  <para style="q2" vid="PSA 31:4">istti taas waaxi woththida</para>
  <para style="q2" vid="PSA 31:4">narxafe tana ne naaga.<verse eid="PSA 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5" />Abeet GODAWU tumu Xoossawu!</para>
  <para style="q2" vid="PSA 31:5">tani ta shemppo</para>
  <para style="q2" vid="PSA 31:5">ne kushen hadara immays;</para>
  <para style="q2" vid="PSA 31:5">neni tana wozza.<note caller="-" style="x"><char style="xo" closed="false">31:5 </char><char style="xt" closed="false"><ref loc="LUK 23:46">Luqa 23:46</ref></char></note><verse eid="PSA 31:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6" />Paththontta eeqatas</para>
  <para style="q2" vid="PSA 31:6">goynnizayta tani ixxays;</para>
  <para style="q2" vid="PSA 31:6">tani gidikko GODAAN ammanettays.<verse eid="PSA 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7" />Ta meto neni be7ida gishshassinne</para>
  <para style="q2" vid="PSA 31:7">ta tuggaa neni erida gishshas</para>
  <para style="q2" vid="PSA 31:7">tani ne siiqon ufayettays.<verse eid="PSA 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8" />Neni tana ta morkketas aaththa</para>
  <para style="q2" vid="PSA 31:8">aaththa immabeekka;</para>
  <para style="q2" vid="PSA 31:8">ta tohotakka</para>
  <para style="q2" vid="PSA 31:8">aaho sohon essadasa.<verse eid="PSA 31:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 31:9">Tani meton geladis;</para>
  <para style="q2" vid="PSA 31:9">taas qadhetta.</para>
  <para style="q2" vid="PSA 31:9">Tani daro mishettadis;</para>
  <para style="q2" vid="PSA 31:9">ta ayfey, ta ashoynne</para>
  <para style="q2" vid="PSA 31:9">ta shemppoy daaburdes.<verse eid="PSA 31:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10" />Ta shemppoya waayen daaburadus;</para>
  <para style="q2" vid="PSA 31:10">ta layththayka ceecen wurides.</para>
  <para style="q2" vid="PSA 31:10">Meto daron</para>
  <para style="q2" vid="PSA 31:10">ta wolqqay cingides;</para>
  <para style="q2" vid="PSA 31:10">ta meqeththatikka</para>
  <para style="q2" vid="PSA 31:10">giddon seerida.<verse eid="PSA 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11" />Ta morkketa ubbaas</para>
  <para style="q2" vid="PSA 31:11">tani qidhe miish gidadis;</para>
  <para style="q2" vid="PSA 31:11">ta shoorotas miires attadis;</para>
  <para style="q2" vid="PSA 31:11">tana erizaytas kadhes gidadis;</para>
  <para style="q2" vid="PSA 31:11">ogen tana be7idaytikka</para>
  <para style="q2" vid="PSA 31:11">taappe baqateettes.<verse eid="PSA 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12" />Tani hayqqida asa mala dogettadis;</para>
  <para style="q2" vid="PSA 31:12">mooho oto mala gidadis.<verse eid="PSA 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13" />Tani daroti saasukettishin siyadis;</para>
  <para style="q2" vid="PSA 31:13">dagamay Ubbasora dees;</para>
  <para style="q2" vid="PSA 31:13">istti ta bolla genen duulateettes;</para>
  <para style="q2" vid="PSA 31:13">tana wodhanawukka</para>
  <para style="q2" vid="PSA 31:13">maqetteettes.<verse eid="PSA 31:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14" />Gido attiin GODAWU!</para>
  <para style="q2" vid="PSA 31:14">Tani nenan ammanettada,</para>
  <para style="q2" vid="PSA 31:14">«Neni ta Xoossa» gays.<verse eid="PSA 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15" />Ta de7o layththay</para>
  <para style="q2" vid="PSA 31:15">ne kushenna;</para>
  <para style="q2" vid="PSA 31:15">tana gooddiza</para>
  <para style="q2" vid="PSA 31:15">ta morkketa kusheppe</para>
  <para style="q2" vid="PSA 31:15">ne tana ashsha.<verse eid="PSA 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16" />Ne aylleza bolla</para>
  <para style="q2" vid="PSA 31:16">ne sinththa poo7isa;</para>
  <para style="q2" vid="PSA 31:16">ne maaroteththan tana ashsha.<verse eid="PSA 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 31:17">Tani nena xeygays;</para>
  <para style="q2" vid="PSA 31:17">tana yeellasoppa;</para>
  <para style="q2" vid="PSA 31:17">iitati gidikko yeellatetto;</para>
  <para style="q2" vid="PSA 31:17">duge duufon gelidi sirphi getto.<verse eid="PSA 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18" />Xilloza bolla otoron, kadheninne</para>
  <para style="q2" vid="PSA 31:18">xalateththan haasayza gishshas</para>
  <para style="q2" vid="PSA 31:18">wordanchchata doona duudisa.<verse eid="PSA 31:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19" />Nenan zemppanaas</para>
  <para style="q2" vid="PSA 31:19">neekko shiiqidaytassinne</para>
  <para style="q2" vid="PSA 31:19">nees yayyizaytas</para>
  <para style="q2" vid="PSA 31:19">neni asaa sinththan isttas</para>
  <para style="q2" vid="PSA 31:19">immana gaada minjja woththida</para>
  <para style="q2" vid="PSA 31:19">kiyateththi ay mala daroo!<verse eid="PSA 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20" />Neni istta ne keeththan genththada</para>
  <para style="q2" vid="PSA 31:20">asaa maqqofe ashshaasa;</para>
  <para style="q2" vid="PSA 31:20">neni istta ne dizason qottada</para>
  <para style="q2" vid="PSA 31:20">iita inxarsafe naagaasa.<verse eid="PSA 31:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21" />Tani morkkey dooddi oykkida</para>
  <para style="q2" vid="PSA 31:21">katamaa giddon diza wode</para>
  <para style="q2" vid="PSA 31:21">izi malalisiza ba maaroteth</para>
  <para style="q2" vid="PSA 31:21">tana bessida gishshas</para>
  <para style="q2" vid="PSA 31:21">GODAY galatetto.<verse eid="PSA 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22" />Tani dagammada,</para>
  <para style="q2" vid="PSA 31:22">«Ne sinththafe kichchadis» gadis.</para>
  <para style="q2" vid="PSA 31:22">Gido attiin tana maaddana mala</para>
  <para style="q2" vid="PSA 31:22">nena ta xeygida wode</para>
  <para style="q2" vid="PSA 31:22">ta waasoza neni siyadasa.<verse eid="PSA 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23" />Intteno Xoossa asatoo!</para>
  <para style="q2" vid="PSA 31:23">GODAA siiqite.</para>
  <para style="q2" vid="PSA 31:23">GODAY izan ammanettizayta</para>
  <para style="q2" vid="PSA 31:23">naagees;</para>
  <para style="q2" vid="PSA 31:23">gido attiin otoranchchatas</para>
  <para style="q2" vid="PSA 31:23">isttas bessiza qixaate immees.<verse eid="PSA 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24" />Intte hidota</para>
  <para style="q2" vid="PSA 31:24">GODAAN ooththidaytoo!</para>
  <para style="q2" vid="PSA 31:24">Beeggitenne minnite.<verse eid="PSA 31:24" /></para>
  <chapter eid="PSA 31" />
  <chapter number="32" style="c" sid="PSA 32" />
  <para style="s1">Dawiti Hassa7an Shiishshida Ginxo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1" />Iza mooroy atto geetettidayssinne</para>
  <para style="q2" vid="PSA 32:1">iza nagaray</para>
  <para style="q2" vid="PSA 32:1">kamettiday anjjettidayssa.<verse eid="PSA 32:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2" />GODAY iza nagara</para>
  <para style="q2" vid="PSA 32:2">qoodonttaadeynne</para>
  <para style="q2" vid="PSA 32:2">iza qofan</para>
  <para style="q2" vid="PSA 32:2">baleththoy baynday anjjettidayssa.<note caller="-" style="x"><char style="xo" closed="false">32:1-2 </char><char style="xt" closed="false"><ref loc="ROM 4:7-8">Oro 4:7-8</ref></char></note><verse eid="PSA 32:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3" />Tani ta nagara paaxontta dashe</para>
  <para style="q2" vid="PSA 32:3">gallas kumeth ceeciin</para>
  <para style="q2" vid="PSA 32:3">ta asateththay daaburdes.<verse eid="PSA 32:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4" />Gallassinne qamma ne kushey</para>
  <para style="q2" vid="PSA 32:4">ta bolla deexxides;</para>
  <para style="q2" vid="PSA 32:4">haaththi bone awan micciza mala</para>
  <para style="q2" vid="PSA 32:4">ta wolqqay cingi wurides.<verse eid="PSA 32:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5" />Tani ta nagara nees paaxadis;</para>
  <para style="q2" vid="PSA 32:5">ta qohidayssa neeppe</para>
  <para style="q2" vid="PSA 32:5">genththabeekke;</para>
  <para style="q2" vid="PSA 32:5">«Ta mooroza GODAAS</para>
  <para style="q2" vid="PSA 32:5">paaxana» gadis.</para>
  <para style="q2" vid="PSA 32:5">Histtiin ne ta nagara</para>
  <para style="q2" vid="PSA 32:5">ubbaa atto gadasa.<verse eid="PSA 32:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6" />Hessa gishshas xillo asi</para>
  <para style="q2" vid="PSA 32:6">neni beettiza wode nena woosso;</para>
  <para style="q2" vid="PSA 32:6">di7oy izi diza heera</para>
  <para style="q2" vid="PSA 32:6">meecci efikkoka iza bochchenna.<verse eid="PSA 32:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7" />Neni taas qotettizaso;</para>
  <para style="q2" vid="PSA 32:7">neni tana metoppe naagaasa;</para>
  <para style="q2" vid="PSA 32:7">tana xoono yeththan</para>
  <para style="q2" vid="PSA 32:7">kunththadasa.<verse eid="PSA 32:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8" />GODAY, «Tani nena tamaarsana;</para>
  <para style="q2" vid="PSA 32:8">neni baanaas bessiza ogekka</para>
  <para style="q2" vid="PSA 32:8">nena erisana;</para>
  <para style="q2" vid="PSA 32:8">tani nena zorananne naagana.<verse eid="PSA 32:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9" />Bixalaninne puulon haarettiza</para>
  <para style="q2" vid="PSA 32:9">akeekay baynda baqulo mala</para>
  <para style="q2" vid="PSA 32:9">woykko para mala</para>
  <para style="q2" vid="PSA 32:9">intte hanopite» gees.<verse eid="PSA 32:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10" />Iitatas tuggay daro;</para>
  <para style="q2" vid="PSA 32:10">gido attiin GODAAN</para>
  <para style="q2" vid="PSA 32:10">ammanettizayta</para>
  <para style="q2" vid="PSA 32:10">maaroteththi dooddees.<verse eid="PSA 32:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11" />Intteno xillotoo!</para>
  <para style="q2" vid="PSA 32:11">GODAAN ufayettitenne</para>
  <para style="q2" vid="PSA 32:11">«Hashshu!» giite;</para>
  <para style="q2" vid="PSA 32:11">intteno wozina suuretoo!</para>
  <para style="q2" vid="PSA 32:11">Ufayssan ililite!<verse eid="PSA 32:11" /></para>
  <chapter eid="PSA 32" />
  <chapter number="33" style="c" sid="PSA 33" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1" />Intteno xillotoo! GODAAN ufayettite;</para>
  <para style="q2" vid="PSA 33:1">suure asati ufayssan ililite.<verse eid="PSA 33:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2" />Maasinqo shocishe GODAA galatite;</para>
  <para style="q2" vid="PSA 33:2">tammu shayan waaxettida</para>
  <para style="q2" vid="PSA 33:2">diiththan izas yexxite.<verse eid="PSA 33:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3" />Ooraththa mazamure izas yexxite;</para>
  <para style="q2" vid="PSA 33:3">diiththaa giigsi shocite;</para>
  <para style="q2" vid="PSA 33:3">ufayssan ilili giite.<verse eid="PSA 33:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4" />GODAA qaalay tuma;</para>
  <para style="q2" vid="PSA 33:4">izi ooththiza ooso</para>
  <para style="q2" vid="PSA 33:4">ubbay ammanettizayssa.<verse eid="PSA 33:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5" />GODAY xilloteththanne</para>
  <para style="q2" vid="PSA 33:5">tuma pirda dosees;</para>
  <para style="q2" vid="PSA 33:5">iza kiyateththi sa7a kumides.<verse eid="PSA 33:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6" />Saloti GODAA qaalan medhettida.</para>
  <para style="q2" vid="PSA 33:6">Iza doonappe keziza peenon</para>
  <para style="q2" vid="PSA 33:6">salon diza medheteththati medhettida.<verse eid="PSA 33:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7" />Gita abba haaththa</para>
  <para style="q2" vid="PSA 33:7">izi issison shiishshides;</para>
  <para style="q2" vid="PSA 33:7">ciimma haaththa</para>
  <para style="q2" vid="PSA 33:7">minjjason eelissides.<verse eid="PSA 33:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8" />Sa7an diza asi ubbay</para>
  <para style="q2" vid="PSA 33:8">GODAAS yayyo;</para>
  <para style="q2" vid="PSA 33:8">salo gufanththoy</para>
  <para style="q2" vid="PSA 33:8">GODAA bonchcho.<verse eid="PSA 33:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9" />Ays giikko izi haasayiin handes;</para>
  <para style="q2" vid="PSA 33:9">izi azaziin minnidi eqqides.<verse eid="PSA 33:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10" />GODAY kawoteththata</para>
  <para style="q2" vid="PSA 33:10">halchcho laallana;</para>
  <para style="q2" vid="PSA 33:10">istta qofaakka hada ooththana.<verse eid="PSA 33:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11" />GODAA halchchoy</para>
  <para style="q2" vid="PSA 33:11">mernaas eqqi daana;</para>
  <para style="q2" vid="PSA 33:11">iza wozina qofaykka yeletappe</para>
  <para style="q2" vid="PSA 33:11">yeleta gakkanawu daana.<verse eid="PSA 33:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12" />Xoossi izas GODAA gidida</para>
  <para style="q2" vid="PSA 33:12">kawoteththay,</para>
  <para style="q2" vid="PSA 33:12">izi baas doorida derey</para>
  <para style="q2" vid="PSA 33:12">anjjettida dere.<verse eid="PSA 33:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13" />GODAY salon uttidi duge xeellees;</para>
  <para style="q2" vid="PSA 33:13">asaa ubbaaka be7ees.<verse eid="PSA 33:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14" />GODAY ba araatan uttidi</para>
  <para style="q2" vid="PSA 33:14">sa7an de7iza ubbaa xeellees.<verse eid="PSA 33:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15" />Izi ubbaa wozina medhdhides;</para>
  <para style="q2" vid="PSA 33:15">istti ooththiza miish ubbaa erees.<verse eid="PSA 33:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16" />Kawoy ba wottadara</para>
  <para style="q2" vid="PSA 33:16">corateththan attenna;</para>
  <para style="q2" vid="PSA 33:16">olanchchay ba wolqqa</para>
  <para style="q2" vid="PSA 33:16">minoteththan kessi ekkenna.<verse eid="PSA 33:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17" />Tani paran xoonana gi</para>
  <para style="q2" vid="PSA 33:17">naagoy hada;</para>
  <para style="q2" vid="PSA 33:17">izi ba wolqqa minoteththan</para>
  <para style="q2" vid="PSA 33:17">oonakka ashshanawu</para>
  <para style="q2" vid="PSA 33:17">dandayenna.<verse eid="PSA 33:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18" />GODAA ayfeti izas yayyizaytanne</para>
  <para style="q2" vid="PSA 33:18">iza mernaa siiqo</para>
  <para style="q2" vid="PSA 33:18">hidota ooththiza asata xeellees.<verse eid="PSA 33:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19" />Izi hessan istta hayqoppe ashshees;</para>
  <para style="q2" vid="PSA 33:19">kosha wodekka istta</para>
  <para style="q2" vid="PSA 33:19">shemppora paxa woththees.<verse eid="PSA 33:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20" />Nu shemppoya GODAA</para>
  <para style="q2" vid="PSA 33:20">hidota ooththawus;</para>
  <para style="q2" vid="PSA 33:20">izi nuus maadonne gondalle.<verse eid="PSA 33:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21" />Nuni geesh gidida</para>
  <para style="q2" vid="PSA 33:21">iza sunththan ammanettoos;</para>
  <para style="q2" vid="PSA 33:21">nu wozinaykka izan ufayettees.<verse eid="PSA 33:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 33:22">Nuni nenan</para>
  <para style="q2" vid="PSA 33:22">hidota ooththizayssa mala</para>
  <para style="q2" vid="PSA 33:22">mernaa ne siiqoy nunara gido.<verse eid="PSA 33:22" /></para>
  <chapter eid="PSA 33" />
  <chapter number="34" style="c" sid="PSA 34" />
  <para style="s1">Kawo Abimelekke Sinththafe Atti Bida Wode Dawiti Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1" />Tani GODAA ubba wode galatana;</para>
  <para style="q2" vid="PSA 34:1">iza galatay ay wodenkka</para>
  <para style="q2" vid="PSA 34:1">ta doonappe paccenna.<note caller="-" style="x"><char style="xo" closed="false">34:1-22 </char><char style="xt" closed="false"><ref loc="1SA 21:13-15">1Same 21:13-15</ref></char></note><verse eid="PSA 34:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2" />Tani GODAAN ceeqettays;</para>
  <para style="q2" vid="PSA 34:2">naaqettidayti hessa siyidi</para>
  <para style="q2" vid="PSA 34:2">ufayetetto.<verse eid="PSA 34:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3" />Ane tanara issife</para>
  <para style="q2" vid="PSA 34:3">GODAA bonchchoos;</para>
  <para style="q2" vid="PSA 34:3">iza sunththaaka</para>
  <para style="q2" vid="PSA 34:3">dhoqqu dhoqqu ooththoos.<verse eid="PSA 34:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4" />Tani GODAA koyadis;</para>
  <para style="q2" vid="PSA 34:4">izikka taas zaarides;</para>
  <para style="q2" vid="PSA 34:4">tani yayyiza miish ubbaafe</para>
  <para style="q2" vid="PSA 34:4">tana ashshides.<verse eid="PSA 34:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5" />Izakko xeelliza ubbaa</para>
  <para style="q2" vid="PSA 34:5">sinththay poo7ees;</para>
  <para style="q2" vid="PSA 34:5">istti mulekka yeellatettenna.<verse eid="PSA 34:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6" />Ha hiyeesay waassides;</para>
  <para style="q2" vid="PSA 34:6">GODAY iza waasoza siyides;</para>
  <para style="q2" vid="PSA 34:6">meto ubbaafe iza ashshides.<verse eid="PSA 34:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7" />GODAA kiitanchchay</para>
  <para style="q2" vid="PSA 34:7">GODAAS yayyizayta naagees;</para>
  <para style="q2" vid="PSA 34:7">izi istta yuushozan gididi</para>
  <para style="q2" vid="PSA 34:7">istta ashshees.<verse eid="PSA 34:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8" />GODAY kiya gididayssa</para>
  <para style="q2" vid="PSA 34:8">yuushshi qopite;</para>
  <para style="q2" vid="PSA 34:8">izakko shiiqiday anjjettidaade.<note caller="-" style="x"><char style="xo" closed="false">34:8 </char><char style="xt" closed="false"><ref loc="1PE 2:3">1Phex 2:3</ref></char></note><verse eid="PSA 34:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9" />Intteno geeshsha asatoo!</para>
  <para style="q2" vid="PSA 34:9">GODAAS yayyite;</para>
  <para style="q2" vid="PSA 34:9">ays giikko izas yayyiza ubbatas</para>
  <para style="q2" vid="PSA 34:9">aykkoyka paccenna.<verse eid="PSA 34:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10" />Gaammoti mizaazi dhayiin</para>
  <para style="q2" vid="PSA 34:10">koshatteettes;</para>
  <para style="q2" vid="PSA 34:10">GODAA koyzaytas gidikko</para>
  <para style="q2" vid="PSA 34:10">lo7o miishshi</para>
  <para style="q2" vid="PSA 34:10">aykkoka paccenna.<verse eid="PSA 34:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11" />Naytoo! Haa yiite;</para>
  <para style="q2" vid="PSA 34:11">ta gizaaz siyite;</para>
  <para style="q2" vid="PSA 34:11">tani inttena</para>
  <para style="q2" vid="PSA 34:11">GODAAS yashshateth</para>
  <para style="q2" vid="PSA 34:11">tamaarsana.<verse eid="PSA 34:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12" />Adussa layth daanaas dosizaynne</para>
  <para style="q2" vid="PSA 34:12">lo7o miish beyanaas</para>
  <para style="q2" vid="PSA 34:12">koyzay oonee?<verse eid="PSA 34:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13" />Ne inxarsaa</para>
  <para style="q2" vid="PSA 34:13">iita haasayontta mala naaga;</para>
  <para style="q2" vid="PSA 34:13">ne doonappe wordoy</para>
  <para style="q2" vid="PSA 34:13">kezontta mala naagetta.<verse eid="PSA 34:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14" />Iitappe shaaketta;</para>
  <para style="q2" vid="PSA 34:14">lo7o miish ooththa;</para>
  <para style="q2" vid="PSA 34:14">saroteth koyada kaalla.<verse eid="PSA 34:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15" />GODAA ayfey xillotakko xeellees;</para>
  <para style="q2" vid="PSA 34:15">qasse iza hayththi</para>
  <para style="q2" vid="PSA 34:15">istta woosa ezgees.<verse eid="PSA 34:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16" />Istta hassa7issiza miish</para>
  <para style="q2" vid="PSA 34:16">biittafe dhayssana mala,</para>
  <para style="q2" vid="PSA 34:16">GODAY iita ooththizayta</para>
  <para style="q2" vid="PSA 34:16">ba hanqo ayfen xeellees.<note caller="-" style="x"><char style="xo" closed="false">34:12-16 </char><char style="xt" closed="false"><ref loc="1PE 3:10-12">1Phex 3:10-12</ref></char></note><verse eid="PSA 34:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17" />Xilloti waasseettes;</para>
  <para style="q2" vid="PSA 34:17">GODAY istta waaso siyees;</para>
  <para style="q2" vid="PSA 34:17">izikka istta meto</para>
  <para style="q2" vid="PSA 34:17">ubbaafe ashshees.<verse eid="PSA 34:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18" />GODAY wozinay meqqidaytas</para>
  <para style="q2" vid="PSA 34:18">matan dees;</para>
  <para style="q2" vid="PSA 34:18">qasse hidota qanxxidaytakka</para>
  <para style="q2" vid="PSA 34:18">ashshees.<note caller="+" style="f"><char style="fr" closed="false">34:18 </char><char style="ft" closed="false">Hidota qanxxidaytakka ashshees gizayssa issi issi Geeshsha Maxaafa birsheththan bantta ayanan liiqidayta ashshees geetetti xaafettides.</char></note><verse eid="PSA 34:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19" />Xillo as gakkiza metoy daro;</para>
  <para style="q2" vid="PSA 34:19">gido attiin GODAY</para>
  <para style="q2" vid="PSA 34:19">iza he ubbaafe ashshees.<verse eid="PSA 34:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20" />GODAY iza minththi naagees;</para>
  <para style="q2" vid="PSA 34:20">iza meqeththatappe</para>
  <para style="q2" vid="PSA 34:20">issoyka meqqenna.<note caller="-" style="x"><char style="xo" closed="false">34:20 </char><char style="xt" closed="false"><ref loc="JHN 19:36">Yoha 19:36</ref></char></note><verse eid="PSA 34:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21" />Iitata istta iitateththi wodhana;</para>
  <para style="q2" vid="PSA 34:21">xillota ixxizayti pirdettana.<verse eid="PSA 34:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22" />GODAY ba oosanchchata ashshees;</para>
  <para style="q2" vid="PSA 34:22">izakko baqatida ooninne</para>
  <para style="q2" vid="PSA 34:22">pirdettenna.<verse eid="PSA 34:22" /></para>
  <chapter eid="PSA 34" />
  <chapter number="35" style="c" sid="PSA 35" />
  <para style="s1">Dawite Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 35:1">Tanara eqettizaytara</para>
  <para style="q2" vid="PSA 35:1">neni eqetta;</para>
  <para style="q2" vid="PSA 35:1">tanara olettizaytara neni oletta.<verse eid="PSA 35:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2" />Gondallenne xurure<note caller="+" style="f"><char style="fr" closed="false">35:2 </char><char style="fqa" closed="false">Xurure: </char><char style="ft" closed="false">Xurure geetettizay ola wode asay olettishe tira kammiza gamballe mala ola may7o.</char></note> oykkada,</para>
  <para style="q2" vid="PSA 35:2">tana maaddanaas denda.<verse eid="PSA 35:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3" />Tana yedeththizayta bollan</para>
  <para style="q2" vid="PSA 35:3">ne tooranne mashsha denththa.</para>
  <para style="q2" vid="PSA 35:3">Tana, «Ta nena ashshizaade» ga.<verse eid="PSA 35:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4" />Ta shemppoyo wodhanawu koyzayti</para>
  <para style="q2" vid="PSA 35:4">yeellatettonne kawuyetto;</para>
  <para style="q2" vid="PSA 35:4">ta bolla iita ooththana</para>
  <para style="q2" vid="PSA 35:4">maqettizayti</para>
  <para style="q2" vid="PSA 35:4">kawuyidi guye simmetto.<verse eid="PSA 35:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5" />GODAA kiitanchchay</para>
  <para style="q2" vid="PSA 35:5">istta yedeththo;</para>
  <para style="q2" vid="PSA 35:5">isttika carko sinththan diza</para>
  <para style="q2" vid="PSA 35:5">suulla mala gidetto.<verse eid="PSA 35:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6" />GODAA kiitanchchay istta gooddo;</para>
  <para style="q2" vid="PSA 35:6">istta ogeykka dhumanne</para>
  <para style="q2" vid="PSA 35:6">hallith gido.<verse eid="PSA 35:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7" />Coo tana oykkanawu</para>
  <para style="q2" vid="PSA 35:7">bantta narxa woththida;</para>
  <para style="q2" vid="PSA 35:7">qasseka coo tana kundisanaas</para>
  <para style="q2" vid="PSA 35:7">olla bookkida.<verse eid="PSA 35:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8" />Istti qoppontta dishin</para>
  <para style="q2" vid="PSA 35:8">bashshi istta bolla puttu go;</para>
  <para style="q2" vid="PSA 35:8">istti woththida woximadey</para>
  <para style="q2" vid="PSA 35:8">istta oykko;</para>
  <para style="q2" vid="PSA 35:8">istti ollan kundi dhayetto.<verse eid="PSA 35:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9" />He wode tani GODAAN ufayettana;</para>
  <para style="q2" vid="PSA 35:9">izi ashshida gishshas</para>
  <para style="q2" vid="PSA 35:9">tani ufayettana.<verse eid="PSA 35:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10" />Ta kumeththa asateththay nena,</para>
  <para style="q2" vid="PSA 35:10">«Abeet GODAWU!</para>
  <para style="q2" vid="PSA 35:10">Qohettidayta qohizayta</para>
  <para style="q2" vid="PSA 35:10">kusheppe ashshizay,</para>
  <para style="q2" vid="PSA 35:10">hiyeesatanne metotanchchata</para>
  <para style="q2" vid="PSA 35:10">bonqqizayta kusheppe naagizay</para>
  <para style="q2" vid="PSA 35:10">hara ne malay oonee?» gaana.<verse eid="PSA 35:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11" />Iita asati ta ooththontta miishshan</para>
  <para style="q2" vid="PSA 35:11">tana mootida;</para>
  <para style="q2" vid="PSA 35:11">ta erontta miishshan ta bolla</para>
  <para style="q2" vid="PSA 35:11">wordo markka markkasida.<verse eid="PSA 35:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12" />Tana bizzasida;</para>
  <para style="q2" vid="PSA 35:12">ta lo7o ooththoyssa kushe</para>
  <para style="q2" vid="PSA 35:12">iita zaarida.<verse eid="PSA 35:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13" />Gido attiin tani</para>
  <para style="q2" vid="PSA 35:13">istti hargida wode</para>
  <para style="q2" vid="PSA 35:13">maaqa may7adis;</para>
  <para style="q2" vid="PSA 35:13">ta asateththa xooman</para>
  <para style="q2" vid="PSA 35:13">daabursadis;</para>
  <para style="q2" vid="PSA 35:13">ta woosaas zaaroy dhaydes.<verse eid="PSA 35:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 35:14" />Ta ishaas woykko ta dabbos</para>
  <para style="q2" vid="PSA 35:14">ta muuzottiza mala muuzottadis;</para>
  <para style="q2" vid="PSA 35:14">aaya hayqqiin kayottiza asa mala</para>
  <para style="q2" vid="PSA 35:14">keeha yeekkadis.<verse eid="PSA 35:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15" />Gido attiin tani dhuphettiin</para>
  <para style="q2" vid="PSA 35:15">istti ufayssan issi bolla shiiqida;</para>
  <para style="q2" vid="PSA 35:15">he gene asati ta erontta gaason</para>
  <para style="q2" vid="PSA 35:15">tana wadhdhidi aggontta ixxida.<verse eid="PSA 35:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16" />Istti iita asati qidhiza mala</para>
  <para style="q2" vid="PSA 35:16">tana qidhida;</para>
  <para style="q2" vid="PSA 35:16">yiillos ba ach garccida.<verse eid="PSA 35:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17" />Abeet Godawu!</para>
  <para style="q2" vid="PSA 35:17">Neni awude gakkanaas</para>
  <para style="q2" vid="PSA 35:17">tana co7u gaada xeellanee?</para>
  <para style="q2" vid="PSA 35:17">Istta iita oosaappe tana ashsha;</para>
  <para style="q2" vid="PSA 35:17">ha gaammo mala asatappe</para>
  <para style="q2" vid="PSA 35:17">ta al7o shemppoyo woththa ekka.<verse eid="PSA 35:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18" />He wode gita shiiqon</para>
  <para style="q2" vid="PSA 35:18">ta nena galatana;</para>
  <para style="q2" vid="PSA 35:18">cora asa shiiqon ta nena sabbana.<verse eid="PSA 35:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19" />Wordora tana morkkizayti</para>
  <para style="q2" vid="PSA 35:19">ufayettofetto;</para>
  <para style="q2" vid="PSA 35:19">tana coo ixxizayti</para>
  <para style="q2" vid="PSA 35:19">ta bolla qim7otoppetto.<note caller="-" style="x"><char style="xo" closed="false">35:19 </char><char style="xt" closed="false"><ref loc="PSA 69:4">Maza 69:4</ref>; <ref loc="JHN 15:25">Yoha 15:25</ref></char></note><verse eid="PSA 35:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20" />Istta doonappe</para>
  <para style="q2" vid="PSA 35:20">saro haasayay kezenna;</para>
  <para style="q2" vid="PSA 35:20">biittan co7u giidi diza asata bolla</para>
  <para style="q2" vid="PSA 35:20">yo7o qaxeththeettes.<verse eid="PSA 35:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21" />Istti ba doona ta bolla doydi,</para>
  <para style="q2" vid="PSA 35:21">«Hekko be7a!</para>
  <para style="q2" vid="PSA 35:21">Ne ooththoyssa nuni</para>
  <para style="q2" vid="PSA 35:21">nu ayfen be7idos» geettes.<verse eid="PSA 35:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 35:22">Neni hayssa beyaasa;</para>
  <para style="q2" vid="PSA 35:22">hessa gishshas neni co7u gooppa;</para>
  <para style="q2" vid="PSA 35:22">taappeka haakkofa.<verse eid="PSA 35:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23" />Abeet Godawu, ta Xoossawu!</para>
  <para style="q1" vid="PSA 35:23">Ta gishshas oletta;</para>
  <para style="q2" vid="PSA 35:23">denda; beegga;</para>
  <para style="q2" vid="PSA 35:23">ta doona gidada mootetta.<verse eid="PSA 35:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24" />Abeet GODAWU ta Xoossawu!</para>
  <para style="q2" vid="PSA 35:24">ne xilloteththa mala taas pirda;</para>
  <para style="q2" vid="PSA 35:24">ta morkketakka ufayssofa.<verse eid="PSA 35:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25" />Istti banttas, «Hashshu, hashshu,</para>
  <para style="q2" vid="PSA 35:25">nuni nu wozinan</para>
  <para style="q2" vid="PSA 35:25">amottidayssi polettides;</para>
  <para style="q2" vid="PSA 35:25">nuni iza mittidos»</para>
  <para style="q2" vid="PSA 35:25">gaana mala ooththofa.<verse eid="PSA 35:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26" />Ta waayen ufayettizayti</para>
  <para style="q2" vid="PSA 35:26">ubbay yeellatettonne kawuyetto;</para>
  <para style="q2" vid="PSA 35:26">ta bollan otorettizayti</para>
  <para style="q2" vid="PSA 35:26">yeellanne kawushshateth</para>
  <para style="q2" vid="PSA 35:26">may7etto.<verse eid="PSA 35:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27" />Tani shatumizayssa dosizayti</para>
  <para style="q2" vid="PSA 35:27">ufayettidi «Hashshu!» getto;</para>
  <para style="q2" vid="PSA 35:27">istti ubba wode,</para>
  <para style="q2" vid="PSA 35:27">«Ba aylleza</para>
  <para style="q2" vid="PSA 35:27">saroteththan ufayettiza</para>
  <para style="q2" vid="PSA 35:27">GODAY dhoqqu dhoqqu</para>
  <para style="q2" vid="PSA 35:27">go» getto.<verse eid="PSA 35:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28" />Gallas kumeth ta inxarsay</para>
  <para style="q2" vid="PSA 35:28">ne xilloteththinne ne galata yootana.<verse eid="PSA 35:28" /></para>
  <chapter eid="PSA 35" />
  <chapter number="36" style="c" sid="PSA 36" />
  <para style="s1">Godaa Oosanchcha Dawiti Zammareta Kaabbos Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1" />Iita asi ba wozinan</para>
  <para style="q2" vid="PSA 36:1">gene qoppees;</para>
  <para style="q2" vid="PSA 36:1">iza giddon Xoossas</para>
  <para style="q2" vid="PSA 36:1">yashshateththi deenna.<note caller="-" style="x"><char style="xo" closed="false">36:1 </char><char style="xt" closed="false"><ref loc="ROM 3:18">Oro 3:18</ref></char></note><verse eid="PSA 36:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2" />Iza nagaray qoncciin ixxontta mala</para>
  <para style="q2" vid="PSA 36:2">izi barkka bana baleththees<verse eid="PSA 36:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3" />Iza doonappe ke7iza haasayay</para>
  <para style="q2" vid="PSA 36:3">genenne wordo;</para>
  <para style="q2" vid="PSA 36:3">aadho erateththinne lo7o ooso</para>
  <para style="q2" vid="PSA 36:3">mulekka aggides.<verse eid="PSA 36:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4" />Izi ba hiixan dishe</para>
  <para style="q2" vid="PSA 36:4">gene qoppishe aqees;</para>
  <para style="q2" vid="PSA 36:4">bana lo7o gidontta</para>
  <para style="q2" vid="PSA 36:4">oge kaaleththees;</para>
  <para style="q2" vid="PSA 36:4">iita izi ixxenna.<verse eid="PSA 36:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 36:5">Ne mernaa siiqoy salo gakkees;</para>
  <para style="q2" vid="PSA 36:5">ne tumateththayka</para>
  <para style="q2" vid="PSA 36:5">bolla shaara mala dhoqqees.<verse eid="PSA 36:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 36:6">Ne xilloteththay</para>
  <para style="q2" vid="PSA 36:6">ubbaafe dhoqqa zumata mala;</para>
  <para style="q2" vid="PSA 36:6">ne pirdayka ubbaafe</para>
  <para style="q2" vid="PSA 36:6">ziqqa ciimma mala;</para>
  <para style="q2" vid="PSA 36:6">neni asaakka do7aakka</para>
  <para style="q2" vid="PSA 36:6">iitappe naagaasa.<verse eid="PSA 36:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 36:7">Ne mernaa siiqoy</para>
  <para style="q2" vid="PSA 36:7">ay keena al7o!</para>
  <para style="q2" vid="PSA 36:7">Asay ne qefe giddon</para>
  <para style="q2" vid="PSA 36:7">geemmi attees.<verse eid="PSA 36:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8" />Istti neson kumida maaddafe</para>
  <para style="q2" vid="PSA 36:8">miidi kaalleettes;</para>
  <para style="q2" vid="PSA 36:8">neni ne anjjo shaafappe</para>
  <para style="q2" vid="PSA 36:8">istta ushshaasa.<verse eid="PSA 36:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9" />Ays giikko de7o pulttoy</para>
  <para style="q2" vid="PSA 36:9">ne achchan dees;</para>
  <para style="q2" vid="PSA 36:9">ne poo7on nuni poo7o be7oos.<verse eid="PSA 36:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10" />Nena erizaytas</para>
  <para style="q2" vid="PSA 36:10">ne mernaa siiqoza aggofa;</para>
  <para style="q2" vid="PSA 36:10">suuretas ne kiyateth diggofa.<verse eid="PSA 36:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11" />Otoranchchata tohoy</para>
  <para style="q2" vid="PSA 36:11">tana yedhdhofo;</para>
  <para style="q2" vid="PSA 36:11">nagaranchchata kushey</para>
  <para style="q2" vid="PSA 36:11">tana yedeththofo.<verse eid="PSA 36:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12" />Iita asati kundidayssa be7ite;</para>
  <para style="q2" vid="PSA 36:12">istti kundida;</para>
  <para style="q2" vid="PSA 36:12">dendanawukka dandayettenna.<verse eid="PSA 36:12" /></para>
  <chapter eid="PSA 36" />
  <chapter number="37" style="c" sid="PSA 37" />
  <para style="s1">Dawite Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1" />Iita ooththizayta</para>
  <para style="q2" vid="PSA 37:1">be7ada yiillotoppa;</para>
  <para style="q2" vid="PSA 37:1">nagara ooththizayta qanaatoppa.<verse eid="PSA 37:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2" />Ays giikko istti</para>
  <para style="q2" vid="PSA 37:2">maata mala eeson melana;</para>
  <para style="q2" vid="PSA 37:2">boncco mala</para>
  <para style="q2" vid="PSA 37:2">istti shullidi qokkana.<verse eid="PSA 37:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3" />Neni GODAAN ammanetta;</para>
  <para style="q2" vid="PSA 37:3">lo7o oosokka ooththa;</para>
  <para style="q2" vid="PSA 37:3">histtiko neni biitta bolla</para>
  <para style="q2" vid="PSA 37:3">palahin daana.<verse eid="PSA 37:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4" />GODAAN ufayetta;</para>
  <para style="q2" vid="PSA 37:4">izi nees</para>
  <para style="q2" vid="PSA 37:4">ne wozina amo immana.<verse eid="PSA 37:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5" />Ne oge GODAAS hadara imma;</para>
  <para style="q2" vid="PSA 37:5">izan ammanetta;</para>
  <para style="q2" vid="PSA 37:5">izikka nees ooththana.<verse eid="PSA 37:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6" />Izi ne xilloteththa</para>
  <para style="q2" vid="PSA 37:6">maalado xalqqe mala kessana;</para>
  <para style="q2" vid="PSA 37:6">ne yo7oza pirdaaka</para>
  <para style="q2" vid="PSA 37:6">seeta gallassa awa mala</para>
  <para style="q2" vid="PSA 37:6">poo7isana.<verse eid="PSA 37:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7" />GODAA sinththan co7u gaada</para>
  <para style="q2" vid="PSA 37:7">izi ooththana gakkanaas</para>
  <para style="q2" vid="PSA 37:7">dandayan naaga;</para>
  <para style="q2" vid="PSA 37:7">iita asati duretikkonne</para>
  <para style="q2" vid="PSA 37:7">istta qofay polettiko</para>
  <para style="q2" vid="PSA 37:7">ne istta bolla yiillotoppa.<verse eid="PSA 37:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8" />Hanqo agga;</para>
  <para style="q2" vid="PSA 37:8">yiillofe baqata.</para>
  <para style="q2" vid="PSA 37:8">Yiillotoppa; ays giikko</para>
  <para style="q2" vid="PSA 37:8">hessi as meton yeggees.<verse eid="PSA 37:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9" />Iita ooththizayti</para>
  <para style="q2" vid="PSA 37:9">dhoqalletti dhayana;</para>
  <para style="q2" vid="PSA 37:9">gido attiin GODAAN</para>
  <para style="q2" vid="PSA 37:9">hidota ooththizayti</para>
  <para style="q2" vid="PSA 37:9">biitta laattana.<verse eid="PSA 37:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10" />Iita ooththizayti</para>
  <para style="q2" vid="PSA 37:10">guuththa wodeppe</para>
  <para style="q2" vid="PSA 37:10">guye de7ettenna;</para>
  <para style="q2" vid="PSA 37:10">neni istta koyidaakkoka</para>
  <para style="q2" vid="PSA 37:10">istti beettettenna.<verse eid="PSA 37:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11" />Gido attiin ashketi biitta laattana;</para>
  <para style="q2" vid="PSA 37:11">istti gita saroteththan</para>
  <para style="q2" vid="PSA 37:11">ufayetti daana.<note caller="-" style="x"><char style="xo" closed="false">37:11 </char><char style="xt" closed="false"><ref loc="MAT 5:5">Mato 5:5</ref></char></note><verse eid="PSA 37:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12" />Iita asati</para>
  <para style="q2" vid="PSA 37:12">xillota bolla maqetteettessinne</para>
  <para style="q2" vid="PSA 37:12">ba ach garcceettes.<verse eid="PSA 37:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13" />Gido attiin Goday</para>
  <para style="q2" vid="PSA 37:13">iitata bollan miiccees;</para>
  <para style="q2" vid="PSA 37:13">ays giikko istti dhayana gallassay</para>
  <para style="q2" vid="PSA 37:13">gakkidayssa izi erees.<verse eid="PSA 37:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14" />Iita asati hiyeesatanne</para>
  <para style="q2" vid="PSA 37:14">metotanchchata dhayssanawu,</para>
  <para style="q2" vid="PSA 37:14">suureteththan hemettizayta</para>
  <para style="q2" vid="PSA 37:14">wodhanawu bantta mashsha</para>
  <para style="q2" vid="PSA 37:14">shoddeettessinne</para>
  <para style="q2" vid="PSA 37:14">bantta wondafeza dafeettes.<verse eid="PSA 37:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15" />Gido attiin istta mashshay</para>
  <para style="q2" vid="PSA 37:15">isttas wozina ayfen gelana;</para>
  <para style="q2" vid="PSA 37:15">istta wondafeykka meqqana.<verse eid="PSA 37:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16" />Xillos de7iza guuththay</para>
  <para style="q2" vid="PSA 37:16">iita asatas diza</para>
  <para style="q2" vid="PSA 37:16">daro aqotappe aadhdhees.<verse eid="PSA 37:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17" />Ays giikko</para>
  <para style="q2" vid="PSA 37:17">iitata wolqqay meqqana;</para>
  <para style="q2" vid="PSA 37:17">xillota gidikko</para>
  <para style="q2" vid="PSA 37:17">GODAY minththeththees.<verse eid="PSA 37:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18" />GODAY Suure asatau</para>
  <para style="q2" vid="PSA 37:18">ubbaa gallas naagees;</para>
  <para style="q2" vid="PSA 37:18">istta laataykka</para>
  <para style="q2" vid="PSA 37:18">mernaas isttas gidana.<verse eid="PSA 37:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19" />Iita woden</para>
  <para style="q2" vid="PSA 37:19">suure asati yeellatettenna;</para>
  <para style="q2" vid="PSA 37:19">kosha layth istti kalli maana.<verse eid="PSA 37:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20" />Iita asati gidikko hayqqana;</para>
  <para style="q2" vid="PSA 37:20">GODAA morkketi</para>
  <para style="q2" vid="PSA 37:20">bazzo ciishsha mala qokkana;</para>
  <para style="q2" vid="PSA 37:20">cuwa malakka coo dhayana.<verse eid="PSA 37:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21" />Iita asi tal7i ekkidi</para>
  <para style="q2" vid="PSA 37:21">zaari erenna;</para>
  <para style="q2" vid="PSA 37:21">gido attiin xillo asi</para>
  <para style="q2" vid="PSA 37:21">qadhettidi gede immees.<verse eid="PSA 37:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22" />GODAAN anjjettidayti</para>
  <para style="q2" vid="PSA 37:22">biitta laattana;</para>
  <para style="q2" vid="PSA 37:22">gido attiin izi qanggidayti</para>
  <para style="q2" vid="PSA 37:22">coo dhayana.<verse eid="PSA 37:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23" />Asa ogey GODAA ufayssiko</para>
  <para style="q2" vid="PSA 37:23">GODAY izaade tanggo</para>
  <para style="q2" vid="PSA 37:23">kaaleththeessinne minththees.<verse eid="PSA 37:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24" />Izi dhuphettikokka kundontta mala</para>
  <para style="q2" vid="PSA 37:24">GODAY ba kushen</para>
  <para style="q2" vid="PSA 37:24">oykki ashshees.<verse eid="PSA 37:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25" />Tani kase yelaga shin</para>
  <para style="q2" vid="PSA 37:25">ha7i cimadis;</para>
  <para style="q2" vid="PSA 37:25">gido attiin xillo asi</para>
  <para style="q2" vid="PSA 37:25">coo yegetti attishin,</para>
  <para style="q2" vid="PSA 37:25">woykko iza zereththi</para>
  <para style="q2" vid="PSA 37:25">kath woossi mishin</para>
  <para style="q2" vid="PSA 37:25">tani mulekka be7a erikke.<verse eid="PSA 37:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26" />Izi ubba wodekka kiyateth immees;</para>
  <para style="q2" vid="PSA 37:26">dichchi baynda tal7ees;</para>
  <para style="q2" vid="PSA 37:26">iza zaretikka anjjos gidana.<verse eid="PSA 37:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27" />Iitappe haakka; lo7o miish ooththa.</para>
  <para style="q2" vid="PSA 37:27">Histtiko ne adussa layth de7ana.<verse eid="PSA 37:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28" />Ays giikko GODAY xilloteth dosees.</para>
  <para style="q2" vid="PSA 37:28">Xoossay baas ammanettida</para>
  <para style="q2" vid="PSA 37:28">asata yeggenna;</para>
  <para style="q2" vid="PSA 37:28">izi istta mernaaskka naagana.</para>
  <para style="q2" vid="PSA 37:28">Gido attiin</para>
  <para style="q2" vid="PSA 37:28">iitata zereththati dhoommana.<verse eid="PSA 37:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29" />Xilloti biittayo laattana;</para>
  <para style="q2" vid="PSA 37:29">izin mernaas de7ana.<verse eid="PSA 37:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30" />Xillo asa doonay</para>
  <para style="q2" vid="PSA 37:30">aadho erateth yootees;</para>
  <para style="q2" vid="PSA 37:30">iza inxarsika xillo haasayees.<verse eid="PSA 37:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31" />Iza Xoossa wogay iza wozinan dees;</para>
  <para style="q2" vid="PSA 37:31">iza tohoykka harchchenna.<verse eid="PSA 37:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32" />Iita asi xillo as</para>
  <para style="q2" vid="PSA 37:32">iita ayfen xeelleessinne</para>
  <para style="q2" vid="PSA 37:32">wodhanawukka koyi kaallees.<verse eid="PSA 37:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33" />Gido attiin GODAY xillo as</para>
  <para style="q2" vid="PSA 37:33">iza kushen yeggenna;</para>
  <para style="q2" vid="PSA 37:33">pirdas eqqiza wodekka</para>
  <para style="q2" vid="PSA 37:33">iza aaththi immenna.<verse eid="PSA 37:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34" />GODAA hidota ooththa;</para>
  <para style="q2" vid="PSA 37:34">iza azazokka naaga;</para>
  <para style="q2" vid="PSA 37:34">izi nena biitta laatissana;</para>
  <para style="q2" vid="PSA 37:34">zaaridikka bonchchana;</para>
  <para style="q2" vid="PSA 37:34">iita asati dhoommi dhayshin</para>
  <para style="q2" vid="PSA 37:34">ne beyana.<verse eid="PSA 37:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35" />Tani issi menxe iita asi</para>
  <para style="q2" vid="PSA 37:35">wola mala daayidayssa beyadis.<verse eid="PSA 37:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36" />Gido attiin tani he sohora</para>
  <para style="q2" vid="PSA 37:36">simmada kanththiza wode</para>
  <para style="q2" vid="PSA 37:36">izi dhaydes;</para>
  <para style="q2" vid="PSA 37:36">ta koyiinkka izi beettibeenna.<verse eid="PSA 37:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37" />Ane lo7o as akeeka;</para>
  <para style="q2" vid="PSA 37:37">suure as be7a;</para>
  <para style="q2" vid="PSA 37:37">saro asas wurseththi lo7o gidana.<verse eid="PSA 37:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38" />Gido attiin nagaranchchati</para>
  <para style="q2" vid="PSA 37:38">mulera dhayana;</para>
  <para style="q2" vid="PSA 37:38">istti wurseththan dhoommana.<verse eid="PSA 37:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39" />Xillotas atoteththi GODAAPPE yees;</para>
  <para style="q2" vid="PSA 37:39">meto wode izi isttas geemmizaso.<verse eid="PSA 37:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40" />Xilloti GODAA guye aadhdhida;</para>
  <para style="q2" vid="PSA 37:40">hessa gishshas izi istta</para>
  <para style="q2" vid="PSA 37:40">maaddeessinne ashshees;</para>
  <para style="q2" vid="PSA 37:40">iitata kusheppeka</para>
  <para style="q2" vid="PSA 37:40">woththi ekkees.<verse eid="PSA 37:40" /></para>
  <chapter eid="PSA 37" />
  <chapter number="38" style="c" sid="PSA 38" />
  <para style="s1">Hassa7isos Dawiti Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 38:1">Ne hanqon tana seeroppa;</para>
  <para style="q2" vid="PSA 38:1">ne yiillon tana muroppa.<verse eid="PSA 38:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2" />Ne wondafe yiishshi tana caddides;</para>
  <para style="q2" vid="PSA 38:2">ne kusheykka</para>
  <para style="q2" vid="PSA 38:2">tana naaqqi oykkides.<verse eid="PSA 38:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3" />Ne hanqofe dendidayssan</para>
  <para style="q2" vid="PSA 38:3">ta bollay payyenna;</para>
  <para style="q2" vid="PSA 38:3">ta nagara gaason</para>
  <para style="q2" vid="PSA 38:3">ta asateththay papattides.<verse eid="PSA 38:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4" />Ta qohoy tana mittides;</para>
  <para style="q2" vid="PSA 38:4">deexo tooho mala</para>
  <para style="q2" vid="PSA 38:4">tana naaqqi oykkides.<verse eid="PSA 38:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5" />Tani eeyateththan ooththida</para>
  <para style="q2" vid="PSA 38:5">nagara gaason</para>
  <para style="q2" vid="PSA 38:5">ta madunththay xinqqides.<verse eid="PSA 38:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6" />Tani hokkadissinne quunnadis.</para>
  <para style="q2" vid="PSA 38:6">Gallas kumeth</para>
  <para style="q2" vid="PSA 38:6">yeekkashe pe7adis.<verse eid="PSA 38:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7" />Ta ashoy tama misha mala</para>
  <para style="q2" vid="PSA 38:7">xuuggees;</para>
  <para style="q2" vid="PSA 38:7">ta bollayka payyenna.<verse eid="PSA 38:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8" />Tani ixettadissinne nififi gadis;</para>
  <para style="q2" vid="PSA 38:8">ta wozinay</para>
  <para style="q2" vid="PSA 38:8">ceecida gishshas waassays.<verse eid="PSA 38:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9" />Abeet Godawu!</para>
  <para style="q2" vid="PSA 38:9">Ta amo ubbaa ne eraasa;</para>
  <para style="q2" vid="PSA 38:9">tani ceecizayssi</para>
  <para style="q2" vid="PSA 38:9">neeppe geemmibeenna.<verse eid="PSA 38:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10" />Taas wozina ayfen guppees;</para>
  <para style="q2" vid="PSA 38:10">ta wolqqay cingides;</para>
  <para style="q2" vid="PSA 38:10">ta ayfeppe poo7oy kichchides.<verse eid="PSA 38:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11" />Ta madunththa gaason</para>
  <para style="q2" vid="PSA 38:11">ta shoorotinne ta laggetikka</para>
  <para style="q2" vid="PSA 38:11">taappe baqatida;</para>
  <para style="q2" vid="PSA 38:11">Ta dabbotikka taappe haakkida.<verse eid="PSA 38:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12" />Tana wodhanawu koyzayti</para>
  <para style="q2" vid="PSA 38:12">bantta narxa tana oykkana woththida;</para>
  <para style="q2" vid="PSA 38:12">Tana qohanawu koyzayti,</para>
  <para style="q2" vid="PSA 38:12">«Naagaashsha; nuni nena</para>
  <para style="q2" vid="PSA 38:12">demmana» giidi</para>
  <para style="q2" vid="PSA 38:12">ta bolla mandida;</para>
  <para style="q2" vid="PSA 38:12">gallas kumeth ta bolla</para>
  <para style="q2" vid="PSA 38:12">genen duulatida.<verse eid="PSA 38:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13" />He wode tani siyontta</para>
  <para style="q2" vid="PSA 38:13">tulle asa mala gidadis;</para>
  <para style="q2" vid="PSA 38:13">doonakka pogontta</para>
  <para style="q2" vid="PSA 38:13">duude asa mala gidadis.<verse eid="PSA 38:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14" />Tumappe tani hayththi siyontta</para>
  <para style="q2" vid="PSA 38:14">asa malanne</para>
  <para style="q2" vid="PSA 38:14">doonay haasayontta</para>
  <para style="q2" vid="PSA 38:14">asa mala gidadis.<verse eid="PSA 38:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15" />Gido attiin abeet GODAWU!</para>
  <para style="q2" vid="PSA 38:15">Tani nenan hidota ooththays;</para>
  <para style="q2" vid="PSA 38:15">Abeet ta GODAWU!</para>
  <para style="q2" vid="PSA 38:15">Neni taas zaaro imma.<verse eid="PSA 38:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16" />Tani GODAA,</para>
  <para style="q2" vid="PSA 38:16">«Ta tohoy handaraashin,</para>
  <para style="q2" vid="PSA 38:16">ta morkketi ‹Izas hashshu›</para>
  <para style="q2" vid="PSA 38:16">gaana malanne</para>
  <para style="q2" vid="PSA 38:16">ta bolla ceeqettana mala</para>
  <para style="q2" vid="PSA 38:16">ooththofa» gaada woossays.<verse eid="PSA 38:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17" />Tani kundana matadis;</para>
  <para style="q2" vid="PSA 38:17">ta sakoykka paxontta ixxides.<verse eid="PSA 38:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18" />Ta nagaray tana metides;</para>
  <para style="q2" vid="PSA 38:18">hessa gishshas ta qoho</para>
  <para style="q2" vid="PSA 38:18">ta nees paaxays.<verse eid="PSA 38:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19" />Ta morkketi gitanne wolqqama;</para>
  <para style="q2" vid="PSA 38:19">tana coo ixxizayti cora.<verse eid="PSA 38:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20" />Tani lo7o ooso ooththiin</para>
  <para style="q2" vid="PSA 38:20">taas iita zaarizayti</para>
  <para style="q2" vid="PSA 38:20">tani lo7o kaalliza gishshas</para>
  <para style="q2" vid="PSA 38:20">tanara eqetteettes.<verse eid="PSA 38:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 38:21">Ne tana yeggofa;</para>
  <para style="q2" vid="PSA 38:21">Abeet Xoossawu</para>
  <para style="q2" vid="PSA 38:21">taappe neni haakkofa.<verse eid="PSA 38:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22" />Abeet tana ashshiza Godawu!</para>
  <para style="q2" vid="PSA 38:22">Tana maaddanaas eesota.<verse eid="PSA 38:22" /></para>
  <chapter eid="PSA 38" />
  <chapter number="39" style="c" sid="PSA 39" />
  <para style="s1">Dawiti Zammareta Kaabbo Edotaanes Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 39:1" />Tani, «Inxarsan</para>
  <para style="q2" vid="PSA 39:1">nagara ooththontta mala</para>
  <para style="q2" vid="PSA 39:1">tani ta oge naagana;</para>
  <para style="q2" vid="PSA 39:1">iita asati</para>
  <para style="q2" vid="PSA 39:1">ta sinththan diza wode</para>
  <para style="q2" vid="PSA 39:1">ta doona gordana» gadis.<verse eid="PSA 39:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2" />Tani duude mala co7u gadis;</para>
  <para style="q2" vid="PSA 39:2">haray attoshin lo7o miish</para>
  <para style="q2" vid="PSA 39:2">haasayanaappeka co7u gadis;</para>
  <para style="q2" vid="PSA 39:2">gido attiin ta waayey</para>
  <para style="q2" vid="PSA 39:2">haa darides.<verse eid="PSA 39:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 39:3" />Ta wozinay qofan seellides;</para>
  <para style="q2" vid="PSA 39:3">ta yuushsha qoppishin tama mala</para>
  <para style="q2" vid="PSA 39:3">eexxi kezides.</para>
  <para style="q2" vid="PSA 39:3">Histtiin tani haasaya doommadis.<verse eid="PSA 39:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4" />«Abeet GODAWU!</para>
  <para style="q2" vid="PSA 39:4">Ta de7o wurseththanne</para>
  <para style="q2" vid="PSA 39:4">taas de7anaas attida gallassata</para>
  <para style="q2" vid="PSA 39:4">tana bessa.</para>
  <para style="q2" vid="PSA 39:4">Qasse ta daana layththay</para>
  <para style="q2" vid="PSA 39:4">ay keena qaanththako</para>
  <para style="q2" vid="PSA 39:4">tana erisa.<verse eid="PSA 39:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5" />Neni ta layththa</para>
  <para style="q2" vid="PSA 39:5">qii tadhdhako keena kessadasa;</para>
  <para style="q2" vid="PSA 39:5">ta layththi ne sinththan</para>
  <para style="q2" vid="PSA 39:5">qoodan baynda mala;</para>
  <para style="q2" vid="PSA 39:5">tumappe asi ubbay</para>
  <para style="q2" vid="PSA 39:5">issito aadhdhi biza carko mala.<verse eid="PSA 39:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6" />Tumappe asa duussi eesho mala;</para>
  <para style="q2" vid="PSA 39:6">coo mela hada haaro</para>
  <para style="q2" vid="PSA 39:6">shiishon daaburees;</para>
  <para style="q2" vid="PSA 39:6">gido attiin ooni ekkanaakko erenna.<verse eid="PSA 39:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7" />«Abeet Godawu!</para>
  <para style="q2" vid="PSA 39:7">Neeppe attiin hara</para>
  <para style="q2" vid="PSA 39:7">oonakko xeelloo?</para>
  <para style="q2" vid="PSA 39:7">Ta hidotay nenana.<verse eid="PSA 39:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8" />Ta mooro ubbaafe tana ashsha;</para>
  <para style="q2" vid="PSA 39:8">eeyata miichchas tana kessofa.<verse eid="PSA 39:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9" />Hayssa ubbaa ooththiday</para>
  <para style="q2" vid="PSA 39:9">nena gidida gishshas</para>
  <para style="q2" vid="PSA 39:9">tani co7u gaana;</para>
  <para style="q2" vid="PSA 39:9">doonakka pogikke.<verse eid="PSA 39:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10" />Ne boshaa ta bollafe denththa;</para>
  <para style="q2" vid="PSA 39:10">Ne wolqqama shochcha gaason</para>
  <para style="q2" vid="PSA 39:10">ta daaburadis.<verse eid="PSA 39:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11" />Neni as iza nagara gishshas</para>
  <para style="q2" vid="PSA 39:11">seeraasanne muraasa;</para>
  <para style="q2" vid="PSA 39:11">izas diza al7o miish bada mala</para>
  <para style="q2" vid="PSA 39:11">ne wursaasa;</para>
  <para style="q2" vid="PSA 39:11">tumappe asi ubbay issito</para>
  <para style="q2" vid="PSA 39:11">carki aadhdhiza carko mala.<verse eid="PSA 39:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12" />«Abeet GODAWU!</para>
  <para style="q2" vid="PSA 39:12">Ta woosa siya;</para>
  <para style="q2" vid="PSA 39:12">tana maaddanaas ta waasoza ezga.</para>
  <para style="q2" vid="PSA 39:12">Ta afunththaa co7u gooppa;</para>
  <para style="q2" vid="PSA 39:12">tani kase ta aawata ubbaa mala</para>
  <para style="q2" vid="PSA 39:12">bete asinne imath gidada</para>
  <para style="q2" vid="PSA 39:12">ne keeththan days.<verse eid="PSA 39:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13" />Tani guye simma yaanaas</para>
  <para style="q2" vid="PSA 39:13">dandayonttaso baanaappe kase</para>
  <para style="q2" vid="PSA 39:13">guuththa wode ufayettana mala</para>
  <para style="q2" vid="PSA 39:13">tana aggaasharkkii!» gadis.<verse eid="PSA 39:13" /></para>
  <chapter eid="PSA 39" />
  <chapter number="40" style="c" sid="PSA 40" />
  <para style="s1">Dawiti Zammareta Kaabbos Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1" />Tani GODAA dandayan naagadis;</para>
  <para style="q2" vid="PSA 40:1">izi taakko simmidi</para>
  <para style="q2" vid="PSA 40:1">ta woosaa siyides.<verse eid="PSA 40:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2" />Ciimma ollafe, mittiza urqqafe</para>
  <para style="q2" vid="PSA 40:2">tana kessides;</para>
  <para style="q2" vid="PSA 40:2">ta tohota zaalla bolla essides;</para>
  <para style="q2" vid="PSA 40:2">qasse ta hemeththa minththides.<verse eid="PSA 40:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3" />Izi ta doonan</para>
  <para style="q2" vid="PSA 40:3">ooraththa mazamure woththides;</para>
  <para style="q2" vid="PSA 40:3">he yeththay,</para>
  <para style="q2" vid="PSA 40:3">«Nu Xoossay galatetto» gizaaza.</para>
  <para style="q2" vid="PSA 40:3">Daroti be7idi yayyananne</para>
  <para style="q2" vid="PSA 40:3">GODAAN ammanettana.<verse eid="PSA 40:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4" />GODAAN ammanettizay,</para>
  <para style="q2" vid="PSA 40:4">otoranchchatakko simmonttay,</para>
  <para style="q2" vid="PSA 40:4">wordanchchatakko xeellonttay</para>
  <para style="q2" vid="PSA 40:4">anjjettidaade.<verse eid="PSA 40:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5" />Abeet ta GODAWU!</para>
  <para style="q2" vid="PSA 40:5">Neni daro malalisiza</para>
  <para style="q2" vid="PSA 40:5">ooso ooththadasa;</para>
  <para style="q2" vid="PSA 40:5">nenara likkettizay</para>
  <para style="q2" vid="PSA 40:5">ooninne baawa!</para>
  <para style="q2" vid="PSA 40:5">Neni nuus qoppida lo7o qofa</para>
  <para style="q2" vid="PSA 40:5">ooninne qoodanawu dandayenna;</para>
  <para style="q2" vid="PSA 40:5">hessi tani yootiin</para>
  <para style="q2" vid="PSA 40:5">wurizaaz gidenna.<verse eid="PSA 40:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6" />Neni yarshonne</para>
  <para style="q2" vid="PSA 40:6">muxuwaata koyabeekka;</para>
  <para style="q2" vid="PSA 40:6">xuuggiza yarshonne</para>
  <para style="q2" vid="PSA 40:6">nagara yarshoka</para>
  <para style="q2" vid="PSA 40:6">neni saamottabeekka;</para>
  <para style="q2" vid="PSA 40:6">gido attiin siyana mala</para>
  <para style="q2" vid="PSA 40:6">taas hayththata doyadasa.<note caller="-" style="x"><char style="xo" closed="false">40:6-8 </char><char style="xt" closed="false"><ref loc="HEB 10:5-7">Ib 10:5-7</ref></char></note><verse eid="PSA 40:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7" />Hessafe guye tani,</para>
  <para style="q2" vid="PSA 40:7">«Xaaththa maxaafan</para>
  <para style="q2" vid="PSA 40:7">ta gishshas xaafettida mala</para>
  <para style="q2" vid="PSA 40:7">hekko ha7i tani yadis.<verse eid="PSA 40:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8" />Abeet ta Xoossawu!</para>
  <para style="q2" vid="PSA 40:8">Tani neni koyzayssa</para>
  <para style="q2" vid="PSA 40:8">ooththanaas dosays;</para>
  <para style="q2" vid="PSA 40:8">ne wogay ta wozina</para>
  <para style="q2" vid="PSA 40:8">giddon dees» gadis.<verse eid="PSA 40:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9" />Gita shiiqon tani xilloteththa</para>
  <para style="q2" vid="PSA 40:9">mishiraachcho awajjadis.</para>
  <para style="q2" vid="PSA 40:9">Abeet GODAWU!</para>
  <para style="q2" vid="PSA 40:9">Neni eriza malakka</para>
  <para style="q2" vid="PSA 40:9">tani ta doonan</para>
  <para style="q2" vid="PSA 40:9">yootizayssa aggike.<verse eid="PSA 40:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10" />Tani ne xilloteththa</para>
  <para style="q2" vid="PSA 40:10">ta wozinan qottabeekke;</para>
  <para style="q2" vid="PSA 40:10">neni ammanettizayssanne</para>
  <para style="q2" vid="PSA 40:10">ashshizayssa ta yootadis.</para>
  <para style="q2" vid="PSA 40:10">Qasse ne siiqonne</para>
  <para style="q2" vid="PSA 40:10">ne tumateththa</para>
  <para style="q2" vid="PSA 40:10">gita shiiqozappe genththabeekke.<verse eid="PSA 40:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 40:11">Ne maaroteththaa</para>
  <para style="q2" vid="PSA 40:11">taappe haassofa;</para>
  <para style="q2" vid="PSA 40:11">ne siiqoynne ne tumateththay</para>
  <para style="q2" vid="PSA 40:11">tana ubba wode naago.<verse eid="PSA 40:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12" />Ays giikko qooday baynda</para>
  <para style="q2" vid="PSA 40:12">iita miishshi tana dooddides;</para>
  <para style="q2" vid="PSA 40:12">ta iitateththi darida gishshas</para>
  <para style="q2" vid="PSA 40:12">ta xeellanawu dandaykke.</para>
  <para style="q2" vid="PSA 40:12">Ta iita oosoy</para>
  <para style="q2" vid="PSA 40:12">ta hu7e binanappe darides;</para>
  <para style="q2" vid="PSA 40:12">ta wozinay ta giddon seerides.<verse eid="PSA 40:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13" />Abeet GODAWU! Tana ashsha;</para>
  <para style="q2" vid="PSA 40:13">abeet GODAWU!</para>
  <para style="q2" vid="PSA 40:13">Tana maaddanaas eesota.<verse eid="PSA 40:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14" />Tana wodhanawu koyzayti</para>
  <para style="q2" vid="PSA 40:14">mulekka yeellatettonne kawuyetto;</para>
  <para style="q2" vid="PSA 40:14">tani qohettanayssa amottizayti</para>
  <para style="q2" vid="PSA 40:14">kawuyidi guye simmetto.<verse eid="PSA 40:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15" />Ta bolla,</para>
  <para style="q2" vid="PSA 40:15">«Izas hashshu! Hashshu!» gidayti,</para>
  <para style="q2" vid="PSA 40:15">ba hu7es yeellan dagammetto.<verse eid="PSA 40:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16" />Gido attiin nena koyza ubbati</para>
  <para style="q2" vid="PSA 40:16">nenan ufayetettonne</para>
  <para style="q2" vid="PSA 40:16">hashshu getto;</para>
  <para style="q2" vid="PSA 40:16">ne atoteththaa dosiza ubbati,</para>
  <para style="q2" vid="PSA 40:16">«GODAY gitato!» getto.<verse eid="PSA 40:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17" />Tani hiyeesanne metotanchcha;</para>
  <para style="q2" vid="PSA 40:17">Goday taas qoppees;</para>
  <para style="q2" vid="PSA 40:17">tana maaddizaynne</para>
  <para style="q2" vid="PSA 40:17">ashshizay nena;</para>
  <para style="q2" vid="PSA 40:17">abeet ta Xoossawu</para>
  <para style="q2" vid="PSA 40:17">tana eeson maadda.<verse eid="PSA 40:17" /></para>
  <chapter eid="PSA 40" />
  <chapter number="41" style="c" sid="PSA 41" />
  <para style="s1">Dawiti Zammareta Kaabbos Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1" />Hiyeesas qoppiza asi anjjettidayssa;</para>
  <para style="q2" vid="PSA 41:1">meto gallas GODAY iza ashshees.<verse eid="PSA 41:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2" />GODAY iza naagidi paxa woththees;</para>
  <para style="q2" vid="PSA 41:2">izikka biitta bolla anjjettana;</para>
  <para style="q2" vid="PSA 41:2">GODAY iza morkketas</para>
  <para style="q2" vid="PSA 41:2">iza aaththidi immenna.<verse eid="PSA 41:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3" />GODAY izi hargettidi</para>
  <para style="q2" vid="PSA 41:3">hiixan dishin maaddees;</para>
  <para style="q2" vid="PSA 41:3">sakettinkka iza paththees.<verse eid="PSA 41:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4" />Tani gidikko, «Abeet GODAWU!</para>
  <para style="q2" vid="PSA 41:4">tani nena qohida gishshas</para>
  <para style="q2" vid="PSA 41:4">tana maara;</para>
  <para style="q2" vid="PSA 41:4">hargefe tana paththa» gadis.<verse eid="PSA 41:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5" />Ta morkketi ta bolla</para>
  <para style="q2" vid="PSA 41:5">iita miish haasaydi,</para>
  <para style="q2" vid="PSA 41:5">«Izi awude hayqqandeeshaa?</para>
  <para style="q2" vid="PSA 41:5">Qasse iza sunththayka</para>
  <para style="q2" vid="PSA 41:5">awude dhayandeeshaa?» geettes.<verse eid="PSA 41:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6" />Tana beyanawu yiza oonikka</para>
  <para style="q2" vid="PSA 41:6">ba wozinan</para>
  <para style="q2" vid="PSA 41:6">iita miish suuththishe</para>
  <para style="q2" vid="PSA 41:6">qoodheppe qommon haasayees;</para>
  <para style="q2" vid="PSA 41:6">kare kezidikka zigirs punnees.<verse eid="PSA 41:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7" />Tana ixxiza ubbati</para>
  <para style="q2" vid="PSA 41:7">zuppetidi ta bollan</para>
  <para style="q2" vid="PSA 41:7">saasuketteettes;</para>
  <para style="q2" vid="PSA 41:7">iita miishshi ta bolla</para>
  <para style="q2" vid="PSA 41:7">gakkana mala amotteettes.<verse eid="PSA 41:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8" />«Iza iita hargey oykkides;</para>
  <para style="q2" vid="PSA 41:8">izi he ichchidasoppe</para>
  <para style="q2" vid="PSA 41:8">mulekka dendenna» geettes.<verse eid="PSA 41:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9" />Haray attiin tani ammanettiza</para>
  <para style="q2" vid="PSA 41:9">ta siiqo laggey,</para>
  <para style="q2" vid="PSA 41:9">tanara issi maaddafe miday</para>
  <para style="q2" vid="PSA 41:9">ta bolla toho denththides.<note caller="-" style="x"><char style="xo" closed="false">41:9 </char><char style="xt" closed="false"><ref loc="MAT 26:23">Mato 26:23</ref>; <ref loc="MRK 14:18">Mar 14:18</ref>; <ref loc="LUK 22:21">Luqa 22:21</ref>; <ref loc="JHN 13:18">Yoha 13:18</ref></char></note><verse eid="PSA 41:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10" />Gido attiin abeet GODAWU!</para>
  <para style="q2" vid="PSA 41:10">Neni tana maara;</para>
  <para style="q2" vid="PSA 41:10">tani halo kessana mala</para>
  <para style="q2" vid="PSA 41:10">tana hargefe paththa.<verse eid="PSA 41:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11" />Ta morkkey</para>
  <para style="q2" vid="PSA 41:11">tana xoononttayssan</para>
  <para style="q2" vid="PSA 41:11">ne tana dosizayssa</para>
  <para style="q2" vid="PSA 41:11">ta erays.<verse eid="PSA 41:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12" />Neni tana</para>
  <para style="q2" vid="PSA 41:12">ta suureteththa gishshas maaddaasa;</para>
  <para style="q2" vid="PSA 41:12">ne sinththan tana</para>
  <para style="q2" vid="PSA 41:12">mernaas woththaasa.<verse eid="PSA 41:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13" />GODAA Isra7eele Xoossay</para>
  <para style="q2" vid="PSA 41:13">mernaappe mernaa</para>
  <para style="q2" vid="PSA 41:13">gakkanawu galatetto.<note caller="-" style="x"><char style="xo" closed="false">41:13 </char><char style="xt" closed="false"><ref loc="PSA 106:48">Maza 106:48</ref></char></note></para>
  <para style="q1" vid="PSA 41:13">Amiin! Amiin!<verse eid="PSA 41:13" /></para>
  <chapter eid="PSA 41" />
  <chapter number="42" style="c" sid="PSA 42" />
  <para style="ms">Nam7anththo Maxaafa</para>
  <para style="mr">(<ref loc="PSA 42-72">Maza 42—72</ref>)</para>
  <para style="s1">Zammareta Kaabbos Qoore Nayti Hassa7an Shiishshida Ginxo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1" />Wushay pultto haath laamotiza mala,</para>
  <para style="q2" vid="PSA 42:1">abeet Xoossawu,</para>
  <para style="q2" vid="PSA 42:1">tanikka nena laamotays.<verse eid="PSA 42:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2" />«Ta shemppoya</para>
  <para style="q2" vid="PSA 42:2">tani baada Xoossa sinth</para>
  <para style="q2" vid="PSA 42:2">beyanay awudeeshshaa?» gaada</para>
  <para style="q2" vid="PSA 42:2">Xoossa, de7o Xoossa saamettadus.<verse eid="PSA 42:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3" />Asay ubbato,</para>
  <para style="q2" vid="PSA 42:3">«Ne Xoossi awan dizee?»</para>
  <para style="q2" vid="PSA 42:3">giza wode taas gallassinne omars</para>
  <para style="q2" vid="PSA 42:3">afunththi quma gidides.<verse eid="PSA 42:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4" />Ta wozinaya ceeceththan giddora</para>
  <para style="q2" vid="PSA 42:4">seerashe haytantta akeekadus;</para>
  <para style="q2" vid="PSA 42:4">daro wode ta Xoossa keeth</para>
  <para style="q2" vid="PSA 42:4">kaaleththashe</para>
  <para style="q2" vid="PSA 42:4">ililisaninne galata yeththan</para>
  <para style="q2" vid="PSA 42:4">ba7aale bonchchana</para>
  <para style="q2" vid="PSA 42:4">shiiqida daro asa giddora</para>
  <para style="q2" vid="PSA 42:4">ta waana bizaakko aamusadis.<verse eid="PSA 42:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5" />Tani ays hidota qanxxazinaa?</para>
  <para style="q2" vid="PSA 42:5">Qasse ays ceecazinaa?</para>
  <para style="q2" vid="PSA 42:5">Tani Xoossan ammanettays;</para>
  <para style="q2" vid="PSA 42:5">tana ashshiza ta Xoossaa</para>
  <para style="q2" vid="PSA 42:5">ta buro galatana.<verse eid="PSA 42:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6" />Ta Xoossawu!</para>
  <para style="q2" vid="PSA 42:6">Ta Wozinaya ceecadus;</para>
  <para style="q2" vid="PSA 42:6">hessa gishshas</para>
  <para style="q2" vid="PSA 42:6">tani Yordaanoose biittan</para>
  <para style="q2" vid="PSA 42:6">Hermoone zumbulla</para>
  <para style="q2" vid="PSA 42:6">Mizaare zuma bolla eqqada</para>
  <para style="q2" vid="PSA 42:6">nena ta qoppana.<verse eid="PSA 42:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7" />Ne piissa guunththan</para>
  <para style="q2" vid="PSA 42:7">ciimmay ciimmas ankees;</para>
  <para style="q2" vid="PSA 42:7">qasse ne dambalaynne</para>
  <para style="q2" vid="PSA 42:7">ne carko ubbay</para>
  <para style="q2" vid="PSA 42:7">ta bollara aadhdhides.<verse eid="PSA 42:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8" />GODAY ba mernaa siiqo gallas</para>
  <para style="q2" vid="PSA 42:8">taas kiittees.</para>
  <para style="q2" vid="PSA 42:8">Tanikka omars izas</para>
  <para style="q2" vid="PSA 42:8">galata mazamure shiishshays;</para>
  <para style="q2" vid="PSA 42:8">hessika ta de7o Xoossas</para>
  <para style="q2" vid="PSA 42:8">shiishshiza woosa.<verse eid="PSA 42:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9" />Ta Xoossawu taas Zaallawu!</para>
  <para style="q2" vid="PSA 42:9">«Ne tana ays dogadii?</para>
  <para style="q2" vid="PSA 42:9">Ta morkketi tana qohishin</para>
  <para style="q2" vid="PSA 42:9">ta ceecashe</para>
  <para style="q2" vid="PSA 42:9">ays de7oo?» gays.<verse eid="PSA 42:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10" />Ta morkketi tana ubba wode,</para>
  <para style="q2" vid="PSA 42:10">«Ne Xoossay awan dizee?»</para>
  <para style="q2" vid="PSA 42:10">giidi yo7on tana caddeettes;</para>
  <para style="q2" vid="PSA 42:10">meqeththika menththi cayeettes.<verse eid="PSA 42:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11" />Tani ays hidota qanxxazinaa?</para>
  <para style="q2" vid="PSA 42:11">Qasse ays ceecazinaa?</para>
  <para style="q2" vid="PSA 42:11">Tani Xoossan ammanettays;</para>
  <para style="q2" vid="PSA 42:11">tana ashshiza ta Xoossaa</para>
  <para style="q2" vid="PSA 42:11">ta buro galatana.<verse eid="PSA 42:11" /></para>
  <chapter eid="PSA 42" />
  <chapter number="43" style="c" sid="PSA 43" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1" />Abeet Xoossawu! Ne taas pirda;</para>
  <para style="q2" vid="PSA 43:1">Xoossa erontta kawoteththatara</para>
  <para style="q2" vid="PSA 43:1">ne ta gishshas mootetta;</para>
  <para style="q2" vid="PSA 43:1">Cimmiza asatappenne</para>
  <para style="q2" vid="PSA 43:1">iita asatappe tana ashsha.<verse eid="PSA 43:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2" />Ta Xoossawu! Taas ne mino miixa;</para>
  <para style="q2" vid="PSA 43:2">histtiin ne tana ays aggadii?</para>
  <para style="q2" vid="PSA 43:2">Ta morkketi tana qohishin</para>
  <para style="q2" vid="PSA 43:2">ta ceecashe ays de7oo?<verse eid="PSA 43:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3" />Ne poo7onne ne tuma taas kiitta;</para>
  <para style="q2" vid="PSA 43:3">istti tana kaaleththetto;</para>
  <para style="q2" vid="PSA 43:3">pude geeshsha zuma bolla</para>
  <para style="q2" vid="PSA 43:3">ne dizaso tana gaththetto.<verse eid="PSA 43:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4" />He wode tani</para>
  <para style="q2" vid="PSA 43:4">tana ufayssiza Xoossako baana;</para>
  <para style="q2" vid="PSA 43:4">nees yarsho yarshizasoza baada</para>
  <para style="q2" vid="PSA 43:4">nees goynnana;</para>
  <para style="q2" vid="PSA 43:4">Abeet Godaa ta Xoossawu!</para>
  <para style="q2" vid="PSA 43:4">Tani diiththan nena sabbana.<verse eid="PSA 43:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5" />Tani ays hidota qanxxazinaa?</para>
  <para style="q2" vid="PSA 43:5">Qasse ays ceecazinaa?</para>
  <para style="q2" vid="PSA 43:5">Tani Xoossan ammanettays;</para>
  <para style="q2" vid="PSA 43:5">tana ashshiza ta Xoossaa</para>
  <para style="q2" vid="PSA 43:5">ta buro galatana.<verse eid="PSA 43:5" /></para>
  <chapter eid="PSA 43" />
  <chapter number="44" style="c" sid="PSA 44" />
  <para style="s1">Zammareta Kaabbos Qoore Nayti Hassa7an Shiishshida Ginxo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 44:1">Beni aadhdhida wode</para>
  <para style="q2" vid="PSA 44:1">ne ooththida gita miishshaa</para>
  <para style="q2" vid="PSA 44:1">nuni siyidos;</para>
  <para style="q2" vid="PSA 44:1">nu aawata wodekka</para>
  <para style="q2" vid="PSA 44:1">ne ooththidayssa</para>
  <para style="q2" vid="PSA 44:1">istti nuus yootida.<verse eid="PSA 44:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2" />Kawoteththata neni ne kushen</para>
  <para style="q2" vid="PSA 44:2">goodda kessadasa;</para>
  <para style="q2" vid="PSA 44:2">nu aawata</para>
  <para style="q2" vid="PSA 44:2">istta biittan tokkadasa;</para>
  <para style="q2" vid="PSA 44:2">deraa liiqisadasa;</para>
  <para style="q2" vid="PSA 44:2">gido attiin</para>
  <para style="q2" vid="PSA 44:2">ne kawoteththata aassadasa.<verse eid="PSA 44:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3" />Istti bantta mashshan olidi</para>
  <para style="q2" vid="PSA 44:3">he biitta oykkibeettenna;</para>
  <para style="q2" vid="PSA 44:3">istti xooniday</para>
  <para style="q2" vid="PSA 44:3">ba qese minoteththan gidenna.</para>
  <para style="q2" vid="PSA 44:3">Gido attiin neni</para>
  <para style="q2" vid="PSA 44:3">isttan ufayettida gishshas</para>
  <para style="q2" vid="PSA 44:3">ne ushachcha kushey,</para>
  <para style="q2" vid="PSA 44:3">ne qeseynne</para>
  <para style="q2" vid="PSA 44:3">ne sinththa poo7o wolqqay</para>
  <para style="q2" vid="PSA 44:3">hessa ooththides.<verse eid="PSA 44:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4" />Ta Xoossawu ta kawoy nena;</para>
  <para style="q2" vid="PSA 44:4">Yaaqoobe zereththaas</para>
  <para style="q2" vid="PSA 44:4">xoono immiday</para>
  <para style="q2" vid="PSA 44:4">Xoosso nena.<verse eid="PSA 44:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5" />Nenan gididi nu morkketa</para>
  <para style="q2" vid="PSA 44:5">nu oli xoonana;</para>
  <para style="q2" vid="PSA 44:5">ne sunththan nunara eqettizayta</para>
  <para style="q2" vid="PSA 44:5">nuni yedhdhana.<verse eid="PSA 44:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6" />Tani ta tooran ammanettike;</para>
  <para style="q2" vid="PSA 44:6">ta giththa mashshayka</para>
  <para style="q2" vid="PSA 44:6">tana ashshenna.<verse eid="PSA 44:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7" />Gido attiin neni nuna</para>
  <para style="q2" vid="PSA 44:7">nu morkketappe ashshaasa;</para>
  <para style="q2" vid="PSA 44:7">qasse nuna ixxizayta</para>
  <para style="q2" vid="PSA 44:7">neni kawushshaasa.<verse eid="PSA 44:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8" />Nuni ubba wode</para>
  <para style="q2" vid="PSA 44:8">Xoossan ceeqettoos;</para>
  <para style="q2" vid="PSA 44:8">ne sunththaaka mernaas sabboos.<verse eid="PSA 44:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9" />Ha7i gidikko ne nuna aggadasa;</para>
  <para style="q2" vid="PSA 44:9">qasseka kawushshadasa;</para>
  <para style="q2" vid="PSA 44:9">neni nu olanchchatara</para>
  <para style="q2" vid="PSA 44:9">issife kezizayssa aggadasa.<verse eid="PSA 44:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10" />Nu morkketa sinththafe</para>
  <para style="q2" vid="PSA 44:10">nuna baqatissadasa;</para>
  <para style="q2" vid="PSA 44:10">nunara eqettizayti</para>
  <para style="q2" vid="PSA 44:10">nu aqota bonqqida.<verse eid="PSA 44:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11" />Neni nuna dorsata mala shukas</para>
  <para style="q2" vid="PSA 44:11">aaththa immadasa;</para>
  <para style="q2" vid="PSA 44:11">qasse kawoteththata giddon</para>
  <para style="q2" vid="PSA 44:11">nuna laalladasa.<verse eid="PSA 44:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12" />Neni ne asaa hiraysson bayzadasa;</para>
  <para style="q2" vid="PSA 44:12">gido attiin wodhe demmabeekka.<verse eid="PSA 44:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13" />Neni nuna nu shoorotas cashshas,</para>
  <para style="q2" vid="PSA 44:13">qasse nu heeran dizaytas qidhessinne</para>
  <para style="q2" vid="PSA 44:13">miichchas kessadasa.<verse eid="PSA 44:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14" />Neni nuna kawoteththata giddon</para>
  <para style="q2" vid="PSA 44:14">haysi7es kessadasa;</para>
  <para style="q2" vid="PSA 44:14">istti bantta hu7e nu bolla</para>
  <para style="q2" vid="PSA 44:14">qaaththi qaaththi</para>
  <para style="q2" vid="PSA 44:14">qidhana mala ooththadasa.<verse eid="PSA 44:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15" />Ta ubba wode kawuyadis;</para>
  <para style="q2" vid="PSA 44:15">ta sinththi yeella may7ides.<verse eid="PSA 44:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16" />He ubbay tana gakkiday</para>
  <para style="q2" vid="PSA 44:16">ta morkketi ta bolla</para>
  <para style="q2" vid="PSA 44:16">halo kessishin</para>
  <para style="q2" vid="PSA 44:16">harati kadhidi miiccida gishshassa.<verse eid="PSA 44:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17" />Nuni nena dogontta dishin</para>
  <para style="q2" vid="PSA 44:17">woykko ne caaqo qaala</para>
  <para style="q2" vid="PSA 44:17">pacinchchontta dishin</para>
  <para style="q2" vid="PSA 44:17">hayssi ubbay nu bollan gakkides.<verse eid="PSA 44:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18" />Nu wozinay neeppe</para>
  <para style="q2" vid="PSA 44:18">guye undudibeenna;</para>
  <para style="q2" vid="PSA 44:18">nu tohoy ne ogeppe</para>
  <para style="q2" vid="PSA 44:18">gaxa kezibeenna.<verse eid="PSA 44:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19" />Gido attiin neni nuna</para>
  <para style="q2" vid="PSA 44:19">menththereththada</para>
  <para style="q2" vid="PSA 44:19">do7a ogen yeggadasa;</para>
  <para style="q2" vid="PSA 44:19">girdi gida dhumankka oladasa.<verse eid="PSA 44:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20" />Nu Xoossa sunth</para>
  <para style="q2" vid="PSA 44:20">nuni balidaa gidikko</para>
  <para style="q2" vid="PSA 44:20">nu kushekka eeqa xoossata</para>
  <para style="q2" vid="PSA 44:20">woossanaas miccidaakko,<verse eid="PSA 44:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="PSA 44:21" />hayssa eroy Xoos xoonanee?</para>
  <para style="q2" vid="PSA 44:21">Izi wozinan geemmi diza</para>
  <para style="q2" vid="PSA 44:21">xuura ubbaa erees<verse eid="PSA 44:21" /></para>
  <para style="q2">
    <verse number="22" style="v" sid="PSA 44:22" />Gido attiin ubbaa gallas</para>
  <para style="q2" vid="PSA 44:22">ne gishshas</para>
  <para style="q2" vid="PSA 44:22">hayqos aadhdhi imettidos;</para>
  <para style="q2" vid="PSA 44:22">shukas efiza dorsata malakka</para>
  <para style="q2" vid="PSA 44:22">qoodettidos.<note caller="-" style="x"><char style="xo" closed="false">44:22 </char><char style="xt" closed="false"><ref loc="ROM 8:36">Oro 8:36</ref></char></note><verse eid="PSA 44:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23" />Abeet Godawu beegga!</para>
  <para style="q2" vid="PSA 44:23">Ays dhiskay?</para>
  <para style="q2" vid="PSA 44:23">Denda! Mernaas nuna aggofa.<verse eid="PSA 44:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24" />Ne sinththa nuuppe ays genththay?</para>
  <para style="q2" vid="PSA 44:24">Nu qoheteththanne</para>
  <para style="q2" vid="PSA 44:24">nu un7eteththa ays dogay?<verse eid="PSA 44:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25" />Nuni duge gudullan yegettidos;</para>
  <para style="q2" vid="PSA 44:25">biitta bollaka porccu gidos.<verse eid="PSA 44:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26" />Abeet Godawu,</para>
  <para style="q2" vid="PSA 44:26">nuna maaddanaas denda!</para>
  <para style="q2" vid="PSA 44:26">Ne mernaa siiqon nuna wozza.<verse eid="PSA 44:26" /></para>
  <chapter eid="PSA 44" />
  <chapter number="45" style="c" sid="PSA 45" />
  <para style="s1">Ciishshata Giigiso Geetettiza Yeththan Qoore Nayti Zammareta Kaabbos Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1" />Ta wozinappe lo7o qofay pulttees;</para>
  <para style="q2" vid="PSA 45:1">ta giigsida ginxoza</para>
  <para style="q2" vid="PSA 45:1">kawoza sissana;</para>
  <para style="q2" vid="PSA 45:1">ta inxarsayka</para>
  <para style="q2" vid="PSA 45:1">eranchcha xaafe bi7ire mala.<verse eid="PSA 45:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2" />Asa ubbaafe neni keeha lo7aasa;</para>
  <para style="q2" vid="PSA 45:2">ne puulan kumida</para>
  <para style="q2" vid="PSA 45:2">qaala haasayaasa;</para>
  <para style="q2" vid="PSA 45:2">hessa gishshas Xoossi nena</para>
  <para style="q2" vid="PSA 45:2">mernaas anjjides.<verse eid="PSA 45:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3" />Wolqqama kawoo!</para>
  <para style="q2" vid="PSA 45:3">Ne mashsha gixxa;</para>
  <para style="q2" vid="PSA 45:3">bonchchonne teema may7a.<verse eid="PSA 45:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4" />Tumateththas,</para>
  <para style="q2" vid="PSA 45:4">ashketeththasinne xilloteththas</para>
  <para style="q2" vid="PSA 45:4">ne teemateth may7ada</para>
  <para style="q2" vid="PSA 45:4">ola xoonanaas sinththe hordofa;</para>
  <para style="q2" vid="PSA 45:4">ne ushachcha kushey</para>
  <para style="q2" vid="PSA 45:4">malalisiza miish besso.<verse eid="PSA 45:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5" />Ne yiishshati qarata;</para>
  <para style="q2" vid="PSA 45:5">istti kawo morkketa</para>
  <para style="q2" vid="PSA 45:5">wozina ayfen caddana;</para>
  <para style="q2" vid="PSA 45:5">kawoteththati xoonettidi</para>
  <para style="q2" vid="PSA 45:5">ne toho garsan kundana.<verse eid="PSA 45:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 45:6">Ne kawoteththa algay</para>
  <para style="q2" vid="PSA 45:6">mernaas daana;</para>
  <para style="q2" vid="PSA 45:6">ne kawoteththa guufeykka</para>
  <para style="q2" vid="PSA 45:6">suureteththa guufe.<verse eid="PSA 45:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7" />Neni xilloteth dosaasa;</para>
  <para style="q2" vid="PSA 45:7">makkallateth ixxaasa.</para>
  <para style="q2" vid="PSA 45:7">Hessa gishshas Xoossay,</para>
  <para style="q2" vid="PSA 45:7">ne Xoossay</para>
  <para style="q2" vid="PSA 45:7">ne laggetapekka aaththidi</para>
  <para style="q2" vid="PSA 45:7">nena ufayssa zayten tiydes.<note caller="-" style="x"><char style="xo" closed="false">45:6-7 </char><char style="xt" closed="false"><ref loc="HEB 1:8-9">Ib 1:8-9</ref></char></note><verse eid="PSA 45:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8" />Karbbefe, godare uuththafenne</para>
  <para style="q2" vid="PSA 45:8">Burgudeppe</para>
  <para style="q2" vid="PSA 45:8">oosettida shitton ne may7oy</para>
  <para style="q2" vid="PSA 45:8">cacafettidi sawo tunnu gees;</para>
  <para style="q2" vid="PSA 45:8">Danggarsa zaalen alleqettida</para>
  <para style="q2" vid="PSA 45:8">ne kawoteththa keeththan</para>
  <para style="q2" vid="PSA 45:8">diixettiza diiththaynne</para>
  <para style="q2" vid="PSA 45:8">maasinqoy nena ufayssees.<verse eid="PSA 45:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9" />Kawoteththa keeththan diza</para>
  <para style="q2" vid="PSA 45:9">maccassata giddon</para>
  <para style="q2" vid="PSA 45:9">kawota macca nayti deettes;</para>
  <para style="q2" vid="PSA 45:9">godatteya geeshsha</para>
  <para style="q2" vid="PSA 45:9">worqqan alleqettada</para>
  <para style="q2" vid="PSA 45:9">neeppe ushachcha</para>
  <para style="q2" vid="PSA 45:9">baggan eqqadus.<verse eid="PSA 45:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10" />Ta nayee, ezga siya;</para>
  <para style="q2" vid="PSA 45:10">ne hayththa haa yegga.</para>
  <para style="q1" vid="PSA 45:10">Ne deraanne</para>
  <para style="q2" vid="PSA 45:10">ne aawaa keeththa doga.<verse eid="PSA 45:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11" />Ne medha lo7oy</para>
  <para style="q2" vid="PSA 45:11">kawo wozina ekkides;</para>
  <para style="q2" vid="PSA 45:11">izi nees goda gidida gishshas</para>
  <para style="q2" vid="PSA 45:11">ne iza bonchcha.<verse eid="PSA 45:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12" />Xiroose asay izis</para>
  <para style="q2" vid="PSA 45:12">imota ekki yaana;</para>
  <para style="q2" vid="PSA 45:12">dureti nena aadashana.<verse eid="PSA 45:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13" />Kawaa naya kawo keeththa giddon</para>
  <para style="q2" vid="PSA 45:13">ay mala lo7azee!</para>
  <para style="q2" vid="PSA 45:13">Izi may7oyka worqqan alleqides.<verse eid="PSA 45:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14" />Ba alleqo may7oza may7ada</para>
  <para style="q2" vid="PSA 45:14">kawozaakko bawus;</para>
  <para style="q2" vid="PSA 45:14">izi lagge gidida geela7oti</para>
  <para style="q2" vid="PSA 45:14">izo azhabi izas ekki yida.<verse eid="PSA 45:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15" />Istti ufayettishenne</para>
  <para style="q2" vid="PSA 45:15">hombocishe yiidi</para>
  <para style="q2" vid="PSA 45:15">kawoza keeth geleettes.<verse eid="PSA 45:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16" />Kawoo! Ne nayti</para>
  <para style="q2" vid="PSA 45:16">ne aawata soho laattana;</para>
  <para style="q2" vid="PSA 45:16">neni istta biitta</para>
  <para style="q2" vid="PSA 45:16">ubbaa bollan shuumana.<verse eid="PSA 45:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17" />Tani ne sunththi yeleta ubbaan</para>
  <para style="q2" vid="PSA 45:17">hassa7ettana mala ooththana.</para>
  <para style="q2" vid="PSA 45:17">Hessa gishshas asay</para>
  <para style="q2" vid="PSA 45:17">mernaas nena sabbana.<verse eid="PSA 45:17" /></para>
  <chapter eid="PSA 45" />
  <chapter number="46" style="c" sid="PSA 46" />
  <para style="s1">Geela7o Nayta Eedo Geetettiza Yeththan Qoore Nayti Zammareta Kaabbos Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1" />Xoossi nuni shiiqi attizasonne</para>
  <para style="q2" vid="PSA 46:1">nuus wolqqa;</para>
  <para style="q2" vid="PSA 46:1">nuna metoy gakkiza wode</para>
  <para style="q2" vid="PSA 46:1">maaddanaas izi ubbato</para>
  <para style="q2" vid="PSA 46:1">matan dees.<verse eid="PSA 46:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2" />Hessa gishshas biittay qaaxxiko,</para>
  <para style="q2" vid="PSA 46:2">zumatikka duge abban gelikko</para>
  <para style="q2" vid="PSA 46:2">nuni yayyoko.<verse eid="PSA 46:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3" />Abba dambalaykka</para>
  <para style="q2" vid="PSA 46:3">guummidi hoomotikko,</para>
  <para style="q2" vid="PSA 46:3">iza wolqqama hanon</para>
  <para style="q2" vid="PSA 46:3">zumati kokkorkkoka</para>
  <para style="q2" vid="PSA 46:3">nuni dagammoko.<verse eid="PSA 46:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4" />Xoossa katama,</para>
  <para style="q2" vid="PSA 46:4">Ubbaafe Dhoqqa Xoossay dizason</para>
  <para style="q2" vid="PSA 46:4">ufayssiza shaafati deettes.<verse eid="PSA 46:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5" />Xoossi izi giddon diza gishshas</para>
  <para style="q2" vid="PSA 46:5">he katamaya qaaxxuku;</para>
  <para style="q2" vid="PSA 46:5">wontta maaladora Xoossi</para>
  <para style="q2" vid="PSA 46:5">izo maaddana.<verse eid="PSA 46:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6" />Kawoteththati makkallan dendida;</para>
  <para style="q2" vid="PSA 46:6">kawotikka kundida;</para>
  <para style="q2" vid="PSA 46:6">izi ba qaala</para>
  <para style="q2" vid="PSA 46:6">dhoqqu histti sissides;</para>
  <para style="q2" vid="PSA 46:6">biittayka seerides.<verse eid="PSA 46:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7" />Ubbaafe wolqqama GODAY</para>
  <para style="q2" vid="PSA 46:7">nunara dees;</para>
  <para style="q2" vid="PSA 46:7">Yaaqoobe Xoossi</para>
  <para style="q2" vid="PSA 46:7">nu qotetti attiza qol7a.<verse eid="PSA 46:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8" />Haa yiite; GODAA ooso xeellite;</para>
  <para style="q2" vid="PSA 46:8">izi sa7a wostti</para>
  <para style="q2" vid="PSA 46:8">bulasidaakko be7ite.<verse eid="PSA 46:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9" />Izi sa7a gaxappe gaxa gakkanaas</para>
  <para style="q2" vid="PSA 46:9">diza ola teqqees;</para>
  <para style="q2" vid="PSA 46:9">wondafenne toora menththees;</para>
  <para style="q2" vid="PSA 46:9">gondalleka taman xuuggees.<note caller="+" style="f"><char style="fr" closed="false">46:9 </char><char style="ft" closed="false">Gondalle gizayssa issi issi birsheththa maxaafati hare gaare geettes.</char></note><verse eid="PSA 46:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10" />Shempi uttite;</para>
  <para style="q2" vid="PSA 46:10">tani Xoos gididayssa erite;</para>
  <para style="q2" vid="PSA 46:10">kawoteththata bolla</para>
  <para style="q2" vid="PSA 46:10">ta dhoqqu dhoqqu gaana;</para>
  <para style="q2" vid="PSA 46:10">biitta bollaka</para>
  <para style="q2" vid="PSA 46:10">ta dhoqqu dhoqqu gaana.<verse eid="PSA 46:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11" />Ubbaafe wolqqama GODAY</para>
  <para style="q2" vid="PSA 46:11">nunara dees;</para>
  <para style="q2" vid="PSA 46:11">Yaaqoobe Xoossi</para>
  <para style="q2" vid="PSA 46:11">nu qotetti attiza qol7a.<verse eid="PSA 46:11" /></para>
  <chapter eid="PSA 46" />
  <chapter number="47" style="c" sid="PSA 47" />
  <para style="s1">Qoore Nayti Zammareta Kaabbos Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 47:1" />Kawoteth ubbay</para>
  <para style="q2" vid="PSA 47:1">intte kushe baqqite;</para>
  <para style="q2" vid="PSA 47:1">intte qaala dhoqqu ooththidi</para>
  <para style="q2" vid="PSA 47:1">Xoossas ilili giite.<verse eid="PSA 47:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2" />Biitta ubbaa bolla bayra kawoy</para>
  <para style="q2" vid="PSA 47:2">Ubbaafe Dhoqqa Xoossay</para>
  <para style="q2" vid="PSA 47:2">izi yashissiza Xoossa.<verse eid="PSA 47:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3" />Deraa nu gars aaththides;</para>
  <para style="q2" vid="PSA 47:3">kawoteththatakka nu toho</para>
  <para style="q2" vid="PSA 47:3">garsan haarisides.<verse eid="PSA 47:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4" />Izi nuus laata biitta doorides;</para>
  <para style="q2" vid="PSA 47:4">he biittayn</para>
  <para style="q2" vid="PSA 47:4">izi dosiza Yaaqoobey ceeqettees.<verse eid="PSA 47:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5" />Ililishin Xoossay ufayssan</para>
  <para style="q2" vid="PSA 47:5">zaye punnishin GODAY</para>
  <para style="q2" vid="PSA 47:5">pude ba araatan kezides.<verse eid="PSA 47:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6" />Yexxite, Xoossas yexxite;</para>
  <para style="q2" vid="PSA 47:6">yexxite nu kawozas yexxite.<verse eid="PSA 47:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7" />Xoossi alame ubbaas kawo;</para>
  <para style="q2" vid="PSA 47:7">hessa gishshas galata mazamure</para>
  <para style="q2" vid="PSA 47:7">izas yexxite.<verse eid="PSA 47:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8" />Xoossi kawoteththata bolla kawotides;</para>
  <para style="q2" vid="PSA 47:8">ba geeshsha</para>
  <para style="q2" vid="PSA 47:8">araata bollaka uttides.<verse eid="PSA 47:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9" />Kawoteththata kaaleththiza daannati</para>
  <para style="q2" vid="PSA 47:9">Abrahaame Xoossaa</para>
  <para style="q2" vid="PSA 47:9">asaara issife shiiqida;</para>
  <para style="q2" vid="PSA 47:9">dere ubbaa kawoti Xoossassa;</para>
  <para style="q2" vid="PSA 47:9">izi ubbafekka bollara dhoqqa.<verse eid="PSA 47:9" /></para>
  <chapter eid="PSA 47" />
  <chapter number="48" style="c" sid="PSA 48" />
  <para style="s1">Qoore Nayta Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1" />GODAY gita;</para>
  <para style="q2" vid="PSA 48:1">nu Xoossa kataman</para>
  <para style="q2" vid="PSA 48:1">geeshsha zumazan</para>
  <para style="q2" vid="PSA 48:1">gita galatay izas bessees.<verse eid="PSA 48:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2" />Biitta ubbaas ufays gididay,</para>
  <para style="q2" vid="PSA 48:2">pudeha baggara beettizay</para>
  <para style="q2" vid="PSA 48:2">dhoqqanne lo7o gidida</para>
  <para style="q2" vid="PSA 48:2">Xiyoone zumay</para>
  <para style="q2" vid="PSA 48:2">wogga kawoza katama.<note caller="-" style="x"><char style="xo" closed="false">48:2 </char><char style="xt" closed="false"><ref loc="MAT 5:35">Mato 5:35</ref></char></note><verse eid="PSA 48:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3" />He katamaa gimbeza giddon,</para>
  <para style="q2" vid="PSA 48:3">izi katamays ashshiza</para>
  <para style="q2" vid="PSA 48:3">miixa gididayssa bessides.<verse eid="PSA 48:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4" />Kawoti bantta tooranchchatara</para>
  <para style="q2" vid="PSA 48:4">issife shiiqida;</para>
  <para style="q2" vid="PSA 48:4">histtidi Xiyoono olanawu yida.<verse eid="PSA 48:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5" />Gido attiin izo be7idi malalettida;</para>
  <para style="q2" vid="PSA 48:5">dagammidi guye baqatida.<verse eid="PSA 48:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6" />Istti hessan de7ishin</para>
  <para style="q2" vid="PSA 48:6">istta yashsha kokkorisi oykkides;</para>
  <para style="q2" vid="PSA 48:6">miixay oykkida</para>
  <para style="q2" vid="PSA 48:6">maccassa mala miixattida.<verse eid="PSA 48:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7" />Arshey mokkizaso bagga</para>
  <para style="q2" vid="PSA 48:7">wolqqama carkon meqqiza</para>
  <para style="q2" vid="PSA 48:7">Tarseese markabeta mala</para>
  <para style="q2" vid="PSA 48:7">istta kokkorisadasa.<verse eid="PSA 48:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8" />Nuni siyida malakka,</para>
  <para style="q1" vid="PSA 48:8">Ubbaafe Wolqqama</para>
  <para style="q2" vid="PSA 48:8">GODAA kataman,</para>
  <para style="q2" vid="PSA 48:8">nu Xoossa kataman</para>
  <para style="q2" vid="PSA 48:8">izi ooththidayssa</para>
  <para style="q2" vid="PSA 48:8">nu be7idos.</para>
  <para style="q2" vid="PSA 48:8">Xoossi he katamaa mernaas</para>
  <para style="q2" vid="PSA 48:8">minththi essana.<verse eid="PSA 48:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9" />Abeet Xoossawu,</para>
  <para style="q2" vid="PSA 48:9">ne Keeththa giddon</para>
  <para style="q2" vid="PSA 48:9">ne mernaa siiqo qoppoos.<verse eid="PSA 48:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10" />Abeet Xoossawu,</para>
  <para style="q2" vid="PSA 48:10">ne sunththa malakka</para>
  <para style="q2" vid="PSA 48:10">ne galatay sa7a gaxa gakkides;</para>
  <para style="q2" vid="PSA 48:10">ne ushachcha kushey</para>
  <para style="q2" vid="PSA 48:10">xilloteththan kumides.<verse eid="PSA 48:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11" />Ne pirda gishshas,</para>
  <para style="q2" vid="PSA 48:11">Xiyoone asay ufayettees;</para>
  <para style="q2" vid="PSA 48:11">Yuhuda katamatikka</para>
  <para style="q2" vid="PSA 48:11">ufayssan homboceettes.<verse eid="PSA 48:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12" />Xiyoone yuushon hemettite;</para>
  <para style="q2" vid="PSA 48:12">izi gimbeta yuushon</para>
  <para style="q2" vid="PSA 48:12">yaanne haa simerettite;</para>
  <para style="q2" vid="PSA 48:12">izi shakkota qoodite.<verse eid="PSA 48:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13" />Yiza yeletas yootana mala,</para>
  <para style="q2" vid="PSA 48:13">izi aaho gimbeza akeekitenne</para>
  <para style="q2" vid="PSA 48:13">izi miixata xomosite.<verse eid="PSA 48:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14" />Intte, «Meri mernaas</para>
  <para style="q2" vid="PSA 48:14">ha Xoossay nu Xoossa;</para>
  <para style="q2" vid="PSA 48:14">nu hayqqana gakkanaas</para>
  <para style="q2" vid="PSA 48:14">izi nuna kaaleththana»</para>
  <para style="q2" vid="PSA 48:14">giidi yootite.<verse eid="PSA 48:14" /></para>
  <chapter eid="PSA 48" />
  <chapter number="49" style="c" sid="PSA 49" />
  <para style="s1">Qoore Nayti Zammareta Kaabbos Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 49:1" />Derezoo, intte ubbatikka</para>
  <para style="q2" vid="PSA 49:1">hayssa siyite!</para>
  <para style="q2" vid="PSA 49:1">Intteno sa7a bolla diza ubbatoo!</para>
  <para style="q2" vid="PSA 49:1">Hayssa ezgite.<verse eid="PSA 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2" />Dhoqqaynne ziqqay,</para>
  <para style="q2" vid="PSA 49:2">dureynne manqoyka siyite.<verse eid="PSA 49:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3" />Ta wozina qofay akeeka immees;</para>
  <para style="q2" vid="PSA 49:3">Ta doonay</para>
  <para style="q2" vid="PSA 49:3">aadho erateththa qaala</para>
  <para style="q2" vid="PSA 49:3">haasayees;<verse eid="PSA 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4" />Tani ta hayth</para>
  <para style="q2" vid="PSA 49:4">leemisotakko zaarana;</para>
  <para style="q2" vid="PSA 49:4">istta birsheththaaka</para>
  <para style="q2" vid="PSA 49:4">ta diiththan qonccisana.<verse eid="PSA 49:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5" />Meto gallassi yiza wodenne</para>
  <para style="q2" vid="PSA 49:5">iitateththan tana labizayti</para>
  <para style="q2" vid="PSA 49:5">dooddi uttiko</para>
  <para style="q2" vid="PSA 49:5">ta ays babboo?<verse eid="PSA 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6" />Ba aqotan ammanettizaytassinne</para>
  <para style="q2" vid="PSA 49:6">ba dureteththa daron</para>
  <para style="q2" vid="PSA 49:6">ceeqettizaytas ta ays babboo?<verse eid="PSA 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7" />Asi barkka bana wozzenna;</para>
  <para style="q2" vid="PSA 49:7">woykko ba shemppo gishshas</para>
  <para style="q2" vid="PSA 49:7">Xoossas waaga qanxxanaas</para>
  <para style="q2" vid="PSA 49:7">dandayenna.<verse eid="PSA 49:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8" />Asa shemppo waagay</para>
  <para style="q2" vid="PSA 49:8">keehippe al7o;</para>
  <para style="q2" vid="PSA 49:8">shemppo duuththiza waagay</para>
  <para style="q2" vid="PSA 49:8">mulekka deenna.<verse eid="PSA 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9" />Ay waaga qanxxiinkka</para>
  <para style="q2" vid="PSA 49:9">izi mernaas de7ana mala,</para>
  <para style="q2" vid="PSA 49:9">woykko izi hayqqontta mala</para>
  <para style="q2" vid="PSA 49:9">ooththanawu dandayenna.<verse eid="PSA 49:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10" />Eeyatinne dammati hayqqiza mala</para>
  <para style="q2" vid="PSA 49:10">aadho eranchchatikka hayqqana;</para>
  <para style="q2" vid="PSA 49:10">ubbayka ba aqota</para>
  <para style="q2" vid="PSA 49:10">haras yeggi baana;</para>
  <para style="q2" vid="PSA 49:10">hessa ubbayka be7ana.<verse eid="PSA 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11" />Daro gade</para>
  <para style="q2" vid="PSA 49:11">istti ba sunththan haarikkoka</para>
  <para style="q2" vid="PSA 49:11">isttas mernaa keeththay duufo;</para>
  <para style="q2" vid="PSA 49:11">izikka isttas</para>
  <para style="q2" vid="PSA 49:11">yeletappe yeleta gakkanawu</para>
  <para style="q2" vid="PSA 49:11">duussaso gidana.<verse eid="PSA 49:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12" />Asi ay duretikkoka</para>
  <para style="q2" vid="PSA 49:12">ba dureteththaara kanththenna;</para>
  <para style="q2" vid="PSA 49:12">izi do7a mala hayqqana.<verse eid="PSA 49:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13" />Banan ammanettiza</para>
  <para style="q2" vid="PSA 49:13">eeyata qaadaynne</para>
  <para style="q2" vid="PSA 49:13">istta qaala kaallizayta</para>
  <para style="q2" vid="PSA 49:13">wurseththa saamay hayssa.<verse eid="PSA 49:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14" />Shukas qorettida dorsata mala</para>
  <para style="q2" vid="PSA 49:14">istti duufos doorettida;</para>
  <para style="q2" vid="PSA 49:14">hayqoy istta heenththanchcha</para>
  <para style="q2" vid="PSA 49:14">gidana;</para>
  <para style="q2" vid="PSA 49:14">istti bantta yalliso keeththafe</para>
  <para style="q2" vid="PSA 49:14">haakkidi duufon musana.</para>
  <para style="q2" vid="PSA 49:14">Suure asati maaladora</para>
  <para style="q2" vid="PSA 49:14">istta duufo bollara simerettana.<verse eid="PSA 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15" />Gido attiin Xoossi</para>
  <para style="q2" vid="PSA 49:15">ta shemppo wozzana;</para>
  <para style="q2" vid="PSA 49:15">izi tana hayqo wolqqafe</para>
  <para style="q2" vid="PSA 49:15">ashshi ekkana.<verse eid="PSA 49:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16" />Asi duretiza wodenne</para>
  <para style="q2" vid="PSA 49:16">iza aqotay dari dari biza wode</para>
  <para style="q2" vid="PSA 49:16">izaades yayyofa.<verse eid="PSA 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17" />Gaasoykka izi hayqqishe</para>
  <para style="q2" vid="PSA 49:17">aykkoka ekkidi beenna;</para>
  <para style="q2" vid="PSA 49:17">iza aqotay izara issife</para>
  <para style="q2" vid="PSA 49:17">duufon gelenna.<verse eid="PSA 49:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18" />Asi paxa diza woden,</para>
  <para style="q1" vid="PSA 49:18">«Taas kumides» giikkoka,</para>
  <para style="q2" vid="PSA 49:18">ubbay izas giigida gishshas</para>
  <para style="q2" vid="PSA 49:18">galatettikokka,<verse eid="PSA 49:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="PSA 49:19" />simmidi mulekka</para>
  <para style="q2" vid="PSA 49:19">poo7o be7onttaso</para>
  <para style="q2" vid="PSA 49:19">ba aawata maabaran gayttees.<verse eid="PSA 49:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20" />Asi erateththi baynda</para>
  <para style="q2" vid="PSA 49:20">ay duretikkoka</para>
  <para style="q2" vid="PSA 49:20">izi do7a mala hayqqana.<verse eid="PSA 49:20" /></para>
  <chapter eid="PSA 49" />
  <chapter number="50" style="c" sid="PSA 50" />
  <para style="s1">Aasaafe Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1" />Wolqqama GODAY,</para>
  <para style="q2" vid="PSA 50:1">Xoossay haasayees;</para>
  <para style="q2" vid="PSA 50:1">Arshey mokkizasoppe</para>
  <para style="q2" vid="PSA 50:1">wullizaso gakkanaas</para>
  <para style="q2" vid="PSA 50:1">sa7an diza asaa xeygees.<verse eid="PSA 50:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2" />Mulera lo7o gidida Xiyoonippe</para>
  <para style="q2" vid="PSA 50:2">Xoossi poo7isees.<verse eid="PSA 50:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3" />Nu Xoossi yaana;</para>
  <para style="q2" vid="PSA 50:3">izi co7u geenna.</para>
  <para style="q2" vid="PSA 50:3">Miza tamay iza sinththana;</para>
  <para style="q2" vid="PSA 50:3">wolqqama gotey iza yuushonna.<verse eid="PSA 50:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4" />Xoossi ba asaa pirdanaas</para>
  <para style="q2" vid="PSA 50:4">salonne sa7a xeygees.<verse eid="PSA 50:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5" />«Tanara yarshon caaqettida</para>
  <para style="q2" vid="PSA 50:5">geeshshata taakko</para>
  <para style="q2" vid="PSA 50:5">shiishshite» gees.<verse eid="PSA 50:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6" />Xoossi barkka pirdiza</para>
  <para style="q2" vid="PSA 50:6">Xoossa gidida gishshas</para>
  <para style="q2" vid="PSA 50:6">saloti iza xilloteththa awajjeettes.<verse eid="PSA 50:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7" />«Ta asazoo ne siya!</para>
  <para style="q2" vid="PSA 50:7">Tani nees yootays;</para>
  <para style="q2" vid="PSA 50:7">Isra7eele asawu!</para>
  <para style="q2" vid="PSA 50:7">Tani ne bolla markkattays.</para>
  <para style="q2" vid="PSA 50:7">Tani Xoossay ne Xoossa.<verse eid="PSA 50:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8" />Ne yarsho gishshassinne</para>
  <para style="q2" vid="PSA 50:8">neni ubbato shiishshiza</para>
  <para style="q2" vid="PSA 50:8">xuugettiza yarsho gishshas</para>
  <para style="q2" vid="PSA 50:8">tani nena borikke.<verse eid="PSA 50:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9" />Hessa malakka ne dirsafe kormata,</para>
  <para style="q2" vid="PSA 50:9">woykko ne xarphphafe deyshata</para>
  <para style="q2" vid="PSA 50:9">ekkanawu koykke.<verse eid="PSA 50:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10" />Woran diza do7a ubbati taassa;</para>
  <para style="q2" vid="PSA 50:10">shii zumata bollan diza</para>
  <para style="q2" vid="PSA 50:10">mehetikka tayta.<verse eid="PSA 50:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11" />Tani zumata bolla diza kafota</para>
  <para style="q2" vid="PSA 50:11">ubbaa erays;</para>
  <para style="q2" vid="PSA 50:11">demban diza medheteththati</para>
  <para style="q2" vid="PSA 50:11">ubbay tayta.<verse eid="PSA 50:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12" />Salo gufanththon diza ubbay taassa;</para>
  <para style="q2" vid="PSA 50:12">hessa gishshas ta gafikkoka</para>
  <para style="q2" vid="PSA 50:12">nees yootikke.<verse eid="PSA 50:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13" />Tani kormata asho miikke;</para>
  <para style="q2" vid="PSA 50:13">Woykko deyshata suuth uyikke.<verse eid="PSA 50:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14" />Xoossas galata yarsho shiishsha;</para>
  <para style="q2" vid="PSA 50:14">ne adina Ubbaafe Dhoqqa</para>
  <para style="q2" vid="PSA 50:14">Xoossas gaththa.<verse eid="PSA 50:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15" />Meto gallas</para>
  <para style="q2" vid="PSA 50:15">ne tana xeyga;</para>
  <para style="q2" vid="PSA 50:15">ta nena ashshana;</para>
  <para style="q2" vid="PSA 50:15">nekka tana bonchchana» gees.<verse eid="PSA 50:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 50:16" />Gido attiin Xoossi nagaranchchas,</para>
  <para style="q1" vid="PSA 50:16">«Ta woga neni</para>
  <para style="q2" vid="PSA 50:16">zaara zaarada biddanaas</para>
  <para style="q2" vid="PSA 50:16">woykko ta caaqo qaala</para>
  <para style="q2" vid="PSA 50:16">ne yootanaas</para>
  <para style="q2" vid="PSA 50:16">nees ay maatay dizee?<verse eid="PSA 50:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17" />Ne ta seera ixxaasa;</para>
  <para style="q2" vid="PSA 50:17">ta qaalatakka kadhaasa.<verse eid="PSA 50:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18" />Neni kayso be7ida wode</para>
  <para style="q2" vid="PSA 50:18">izara dabbotadasa;</para>
  <para style="q2" vid="PSA 50:18">laymatizayta maabarankka</para>
  <para style="q2" vid="PSA 50:18">zuppetaasa.<verse eid="PSA 50:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19" />Neni ne doona</para>
  <para style="q2" vid="PSA 50:19">iita haasayanaas doyadasa;</para>
  <para style="q2" vid="PSA 50:19">ne haasayza haasayay</para>
  <para style="q2" vid="PSA 50:19">wordo xalla.<verse eid="PSA 50:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20" />Aadhdhooson aadhdhooson</para>
  <para style="q2" vid="PSA 50:20">ne ishaa zigiraasa;</para>
  <para style="q2" vid="PSA 50:20">ne aayi naa sunththika mooraasa.<verse eid="PSA 50:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21" />Neni hayssa ubbaa ooththiza wode</para>
  <para style="q2" vid="PSA 50:21">tani co7u gadis;</para>
  <para style="q2" vid="PSA 50:21">hessa gishshas neni tana</para>
  <para style="q2" vid="PSA 50:21">ne mala gaada qoppadasa;</para>
  <para style="q2" vid="PSA 50:21">gido attiin ha7i tani</para>
  <para style="q2" vid="PSA 50:21">nena walassays;</para>
  <para style="q2" vid="PSA 50:21">qasseka ta nena</para>
  <para style="q2" vid="PSA 50:21">qonccen seerays.<verse eid="PSA 50:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22" />«Intteno Xoossa dogizaytoo!</para>
  <para style="q2" vid="PSA 50:22">Hayssa akeekite;</para>
  <para style="q2" vid="PSA 50:22">intte ixxis giikko</para>
  <para style="q2" vid="PSA 50:22">tani inttena menththereththana;</para>
  <para style="q2" vid="PSA 50:22">he wode inttena oonikka</para>
  <para style="q2" vid="PSA 50:22">ashshenna.<verse eid="PSA 50:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23" />Taas galata immiza asi</para>
  <para style="q2" vid="PSA 50:23">tana bonchchees.</para>
  <para style="q2" vid="PSA 50:23">Suure ogera biza as</para>
  <para style="q2" vid="PSA 50:23">tani atoteththaa bessana» gees.<verse eid="PSA 50:23" /></para>
  <chapter eid="PSA 50" />
  <chapter number="51" style="c" sid="PSA 51" />
  <para style="s1">Kawo Dawiti laymatidaappe guye nabe Naataaney izakko yida wode Dawiti zammareta kaabbos yexxida mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 51:1">Ne mernaa siiqoza mala</para>
  <para style="q2" vid="PSA 51:1">tana maara;</para>
  <para style="q2" vid="PSA 51:1">ne qadheta daron</para>
  <para style="q2" vid="PSA 51:1">ta mooroza qucca.<note caller="-" style="x"><char style="xo" closed="false">51:1-19 </char><char style="xt" closed="false"><ref loc="2SA 12:1-15">2Same 12:1-15</ref></char></note><verse eid="PSA 51:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2" />Ta iitateththa ubbaa</para>
  <para style="q2" vid="PSA 51:2">taappe meecca;</para>
  <para style="q2" vid="PSA 51:2">ta nagarappeka tana geeshsha.<verse eid="PSA 51:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3" />Tani ta mooroza erays;</para>
  <para style="q2" vid="PSA 51:3">ta nagaraykka</para>
  <para style="q2" vid="PSA 51:3">ubbato ta sinththana.<verse eid="PSA 51:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4" />Ta nena xalla qohadis;</para>
  <para style="q2" vid="PSA 51:4">qasseka ne sinththan</para>
  <para style="q2" vid="PSA 51:4">iita ooththadis.</para>
  <para style="q2" vid="PSA 51:4">Hessa gishshas</para>
  <para style="q2" vid="PSA 51:4">ne qaxxayda qixaaten,</para>
  <para style="q2" vid="PSA 51:4">ne ta bolla pirdida pirdankka</para>
  <para style="q2" vid="PSA 51:4">ne xillo<note caller="-" style="x"><char style="xo" closed="false">51:4 </char><char style="xt" closed="false"><ref loc="ROM 3:4">Oro 3:4</ref></char></note><verse eid="PSA 51:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5" />Tani ta aayi uloppe</para>
  <para style="q2" vid="PSA 51:5">doommada nagaranchcha;</para>
  <para style="q2" vid="PSA 51:5">yelettoosofe haa simmadakka</para>
  <para style="q2" vid="PSA 51:5">ta mooranchcha.<verse eid="PSA 51:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6" />Hekko neni asa wozinappe</para>
  <para style="q2" vid="PSA 51:6">tuma koyaasa;</para>
  <para style="q2" vid="PSA 51:6">hessa gishshas</para>
  <para style="q2" vid="PSA 51:6">ta giddo asateththaa</para>
  <para style="q2" vid="PSA 51:6">ne aadho erateth tamaarsa.<verse eid="PSA 51:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7" />Hisophphe bonccon</para>
  <para style="q2" vid="PSA 51:7">neni tana pistta;</para>
  <para style="q2" vid="PSA 51:7">tani geeyana;</para>
  <para style="q2" vid="PSA 51:7">tana meecca;</para>
  <para style="q2" vid="PSA 51:7">tani shachchafe</para>
  <para style="q2" vid="PSA 51:7">aadhdhada booxxana.<verse eid="PSA 51:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8" />Neni tana ufayssinne</para>
  <para style="q2" vid="PSA 51:8">hashshu giissiza miish sissa;</para>
  <para style="q2" vid="PSA 51:8">ne menththereththida</para>
  <para style="q2" vid="PSA 51:8">ta meqeththatakka paththa.<verse eid="PSA 51:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9" />Ne sinth ta nagarappe</para>
  <para style="q2" vid="PSA 51:9">haraso zaara;</para>
  <para style="q2" vid="PSA 51:9">ta qoho ubbaaka qucca digga.<verse eid="PSA 51:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 51:10">Ne taas geeshsha</para>
  <para style="q2" vid="PSA 51:10">wozina medhdha;</para>
  <para style="q2" vid="PSA 51:10">mino ayana ta giddon woththa.<verse eid="PSA 51:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11" />Tana ne sinththafe oloppa;</para>
  <para style="q2" vid="PSA 51:11">ne Geeshsha Ayana</para>
  <para style="q2" vid="PSA 51:11">taappe ekkofa.<verse eid="PSA 51:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12" />Ne atoteththaa ufayssaa</para>
  <para style="q2" vid="PSA 51:12">taas zaarada imma;</para>
  <para style="q2" vid="PSA 51:12">eeno giissiza ayanan</para>
  <para style="q2" vid="PSA 51:12">ne tana kunththa.<verse eid="PSA 51:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13" />Histtiko tani mooranchchata</para>
  <para style="q2" vid="PSA 51:13">ne oge tamaarsana;</para>
  <para style="q2" vid="PSA 51:13">he nagaranchchatikka</para>
  <para style="q2" vid="PSA 51:13">neekko simmana.<verse eid="PSA 51:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14" />Abeet Xoossawu,</para>
  <para style="q2" vid="PSA 51:14">tana ashshiza Xoossawu!</para>
  <para style="q2" vid="PSA 51:14">Tani shemppo wodhontta mala</para>
  <para style="q2" vid="PSA 51:14">tana maadda;</para>
  <para style="q2" vid="PSA 51:14">ta inxarsayka</para>
  <para style="q2" vid="PSA 51:14">ne xilloteththa gishshas</para>
  <para style="q2" vid="PSA 51:14">ililisan yexxo.<verse eid="PSA 51:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15" />Abeet Godawu! Ta doona doya;</para>
  <para style="q2" vid="PSA 51:15">histtiko ta inxarsay</para>
  <para style="q2" vid="PSA 51:15">nena galatana.<verse eid="PSA 51:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16" />Neni yarshon ufayettizaakko</para>
  <para style="q2" vid="PSA 51:16">ta nees yarsho shiishshana;</para>
  <para style="q2" vid="PSA 51:16">ne gidikko yarshon ufayettaka;</para>
  <para style="q2" vid="PSA 51:16">xuugettiza yarsho yarshikokka</para>
  <para style="q2" vid="PSA 51:16">neni ufayettaka.<verse eid="PSA 51:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17" />Xoossas shiiqiza yarshoy</para>
  <para style="q2" vid="PSA 51:17">ashke ayana;</para>
  <para style="q2" vid="PSA 51:17">abeet Xoossawu!</para>
  <para style="q2" vid="PSA 51:17">Meqqida wozina ne kadhakka.<verse eid="PSA 51:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 51:18">Ne dosan Xiyoono duresa;</para>
  <para style="q2" vid="PSA 51:18">Yerusalaame gimbeta gimba.<verse eid="PSA 51:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19" />He wode xilloteththa yarshoninne</para>
  <para style="q2" vid="PSA 51:19">wuri xuugettiza yarshon</para>
  <para style="q2" vid="PSA 51:19">neni ufayettana;</para>
  <para style="q2" vid="PSA 51:19">kormatikka ne yarshizason</para>
  <para style="q2" vid="PSA 51:19">yarshettana.<verse eid="PSA 51:19" /></para>
  <chapter eid="PSA 51" />
  <chapter number="52" style="c" sid="PSA 52" />
  <para style="s1">Eedoome biitta as Doyqey Sa7oolekko biidi, «Dawiti Abimelekke soo bides» gidi yooti simmiin Dawiti zammareta kaabbos hassa7an shiishshida ginxo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 52:1" />Haysso wolqqamazoo!</para>
  <para style="q2" vid="PSA 52:1">Xoossi nena kadhichides;</para>
  <para style="q2" vid="PSA 52:1">ne ays iita ooson nashettay?</para>
  <para style="q2" vid="PSA 52:1">Ays ubbaa gallas ceeqettay?<note caller="-" style="x"><char style="xo" closed="false">52:1-9 </char><char style="xt" closed="false"><ref loc="1SA 22:9-10">1Same 22:9-10</ref></char></note><verse eid="PSA 52:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2" />Nenoo baleththon kumida</para>
  <para style="q2" vid="PSA 52:2">genanchchawu!</para>
  <para style="q2" vid="PSA 52:2">harata dhayssana qaxxaasa!</para>
  <para style="q2" vid="PSA 52:2">Ne inxarsayka</para>
  <para style="q2" vid="PSA 52:2">qara magalla mala.<verse eid="PSA 52:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3" />Neni lo7o aggada iita siiqaasa;</para>
  <para style="q2" vid="PSA 52:3">tuma haasayanaappe wordo</para>
  <para style="q2" vid="PSA 52:3">haasaya dosaasa.<verse eid="PSA 52:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4" />Nenoo baleththon kumida</para>
  <para style="q2" vid="PSA 52:4">wordanchchazoo!</para>
  <para style="q2" vid="PSA 52:4">Neni as madunththiza</para>
  <para style="q2" vid="PSA 52:4">qaala siiqaasa.<verse eid="PSA 52:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5" />Gido attiin Xoossi nena</para>
  <para style="q2" vid="PSA 52:5">mernaas dhayssana;</para>
  <para style="q2" vid="PSA 52:5">izi nena ne keeththafe</para>
  <para style="q2" vid="PSA 52:5">buuci kessana;</para>
  <para style="q2" vid="PSA 52:5">paxa dizayta giddofekka</para>
  <para style="q2" vid="PSA 52:5">dhoqalli diggana.<verse eid="PSA 52:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6" />Xilloti hayssa be7idi yayyana;</para>
  <para style="q2" vid="PSA 52:6">istti iza bolla hizgi miiccana;<verse eid="PSA 52:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7" />«Xoossa baas zemppo</para>
  <para style="q2" vid="PSA 52:7">ooththonttaade,</para>
  <para style="q2" vid="PSA 52:7">ba dureteththa daron</para>
  <para style="q2" vid="PSA 52:7">ammanettizaade</para>
  <para style="q2" vid="PSA 52:7">ba iita ooson minnizaade</para>
  <para style="q2" vid="PSA 52:7">hayssa be7ite!» gaana.<verse eid="PSA 52:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8" />Gido attiin aaciza</para>
  <para style="q2" vid="PSA 52:8">wogara miththa mala</para>
  <para style="q2" vid="PSA 52:8">tani Xoossa Keeththan aacays;</para>
  <para style="q2" vid="PSA 52:8">iza mernaa siiqon tani</para>
  <para style="q2" vid="PSA 52:8">meri mernaas ammanettays.<verse eid="PSA 52:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9" />Neni ooththida ubbaas</para>
  <para style="q2" vid="PSA 52:9">tani nena mernaas galatays;</para>
  <para style="q2" vid="PSA 52:9">ne lo7o gidida gishshas</para>
  <para style="q2" vid="PSA 52:9">ta ne sunththan hidota ooththays;</para>
  <para style="q2" vid="PSA 52:9">tani Xoossa deraa sinththan</para>
  <para style="q2" vid="PSA 52:9">ne kiyateththaa sabbana.<verse eid="PSA 52:9" /></para>
  <chapter eid="PSA 52" />
  <chapter number="53" style="c" sid="PSA 53" />
  <para style="s1">Dawiti Zammareta Kaabbos Hassa7an Shiishshida Ginxo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 53:1" />Eeyati bantta wozinan,</para>
  <para style="q2" vid="PSA 53:1">«Xoossi baawa» geettes;</para>
  <para style="q2" vid="PSA 53:1">istti moorettidayta;</para>
  <para style="q2" vid="PSA 53:1">istta oosoykka harassizaaza;</para>
  <para style="q2" vid="PSA 53:1">istta garsafe</para>
  <para style="q2" vid="PSA 53:1">lo7o ooththizay deenna.<verse eid="PSA 53:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2" />Xoossa koyzaytinne akeekizayti</para>
  <para style="q2" vid="PSA 53:2">de7izakko be7anawu</para>
  <para style="q2" vid="PSA 53:2">Xoossi saloppe duge</para>
  <para style="q2" vid="PSA 53:2">asa nayta xeellees.<verse eid="PSA 53:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3" />Istti ubbayka Xoossaafe haakkida;</para>
  <para style="q2" vid="PSA 53:3">ubbayka issife tunida;</para>
  <para style="q2" vid="PSA 53:3">lo7o ooththiza asi deenna;</para>
  <para style="q2" vid="PSA 53:3">haray atto issaadeyka baawa.<note caller="-" style="x"><char style="xo" closed="false">53:1-3 </char><char style="xt" closed="false"><ref loc="ROM 3:10-12">Oro 3:10-12</ref></char></note><verse eid="PSA 53:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4" />Xoossi, «Asi kath miza mala</para>
  <para style="q2" vid="PSA 53:4">ta deraa bonqqi mizayti,</para>
  <para style="q2" vid="PSA 53:4">Xoos woossi eronttayti,</para>
  <para style="q2" vid="PSA 53:4">heyti iita ooththizayti</para>
  <para style="q2" vid="PSA 53:4">yuushshi qoppettennee?» gees.<verse eid="PSA 53:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5" />Xoossi ba asaa morkkizayta</para>
  <para style="q2" vid="PSA 53:5">meqeththaa laallana;</para>
  <para style="q2" vid="PSA 53:5">istti kase dagammi erontta</para>
  <para style="q2" vid="PSA 53:5">dagama dagammana.</para>
  <para style="q2" vid="PSA 53:5">Xoossi istta kadhida gishshas</para>
  <para style="q2" vid="PSA 53:5">istti yeellatana;<verse eid="PSA 53:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6" />Isra7eeles atoteththi</para>
  <para style="q2" vid="PSA 53:6">Xiyooneppe yidaakko!</para>
  <para style="q2" vid="PSA 53:6">Xoossi ba deraappe di7ettidayssa</para>
  <para style="q2" vid="PSA 53:6">zaariza wode</para>
  <para style="q2" vid="PSA 53:6">Yaaqoobe zareti ufayettana;</para>
  <para style="q2" vid="PSA 53:6">Isra7eele asay ufayettana.<verse eid="PSA 53:6" /></para>
  <chapter eid="PSA 53" />
  <chapter number="54" style="c" sid="PSA 54" />
  <para style="s1">Ziife asay Sa7oolekko biidi, «Dawiti nu biittan qotetti uttides» gi yootiin Dawiti zammareta kaabbos diiththan yexxida mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 54:1">Ne sunththan tana ashsha;</para>
  <para style="q2" vid="PSA 54:1">ne wolqqan taas pirda.<verse eid="PSA 54:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2" />Abeet Xoossawu! Ta woosa siya;</para>
  <para style="q2" vid="PSA 54:2">ta haasayza qaala ezga.<verse eid="PSA 54:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3" />Otoranchchati ta bolla dendida;</para>
  <para style="q2" vid="PSA 54:3">genanchchati</para>
  <para style="q2" vid="PSA 54:3">tana wodhanaas koyeettes.</para>
  <para style="q2" vid="PSA 54:3">Xoossaa wudu geettenna.<verse eid="PSA 54:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4" />Gido attiin Xoossi taas maado;</para>
  <para style="q2" vid="PSA 54:4">Godaykka taas zemppo.<verse eid="PSA 54:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 54:5">Ta morkketas</para>
  <para style="q2" vid="PSA 54:5">istta iitateththaa mala</para>
  <para style="q2" vid="PSA 54:5">isttas zaara.</para>
  <para style="q2" vid="PSA 54:5">Ne ammaneteththan</para>
  <para style="q2" vid="PSA 54:5">ne istta dhayssa.<verse eid="PSA 54:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 54:6">Tani ta dosan nees yarshana;</para>
  <para style="q2" vid="PSA 54:6">nees bessiza gishshas</para>
  <para style="q2" vid="PSA 54:6">tani ne sunththaa galatana.<verse eid="PSA 54:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7" />Ays giikko neni tana</para>
  <para style="q2" vid="PSA 54:7">ta meto ubbaafe ashshadasa;</para>
  <para style="q2" vid="PSA 54:7">ta morkketi kundishin</para>
  <para style="q2" vid="PSA 54:7">ta ayfen beyadis.<note caller="-" style="x"><char style="xo" closed="false">54:1-7 </char><char style="xt" closed="false"><ref loc="1SA 23:19">1Same 23:19</ref>; <ref loc="1SA 26:1">26:1</ref></char></note><verse eid="PSA 54:7" /></para>
  <chapter eid="PSA 54" />
  <chapter number="55" style="c" sid="PSA 55" />
  <para style="s1">Dawiti Hassa7an Shiishshida Ginxo; Dawiti Zammareta Kaabbos Diiththan Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 55:1" />Abeet Xoossawu! Ta woosa siya;</para>
  <para style="q2" vid="PSA 55:1">ta shoobbishin qelli gooppa.<verse eid="PSA 55:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 55:2" />Ezga; ta woosa siya;</para>
  <para style="q2" vid="PSA 55:2">ta qofan ta un7ettadis;</para>
  <para style="q2" vid="PSA 55:2">maracey taas kokkorides.<verse eid="PSA 55:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 55:3" />Ta morkketi mandiin hirgadis;</para>
  <para style="q2" vid="PSA 55:3">iita asati qohiin dagammadis;</para>
  <para style="q2" vid="PSA 55:3">istti ta bolla meto ehida;</para>
  <para style="q2" vid="PSA 55:3">hanqon dendidi tana morkkida.<verse eid="PSA 55:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4" />Ta wozinay hirgees;</para>
  <para style="q2" vid="PSA 55:4">hayqqanaakkonne giza dagamay</para>
  <para style="q2" vid="PSA 55:4">ta bolla wodhdhides.<verse eid="PSA 55:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5" />Yashshinne dagamay tana oykkides;</para>
  <para style="q2" vid="PSA 55:5">ta asateththay kokkorides.<verse eid="PSA 55:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6" />Tani, «Taas haraphphe mala</para>
  <para style="q2" vid="PSA 55:6">qefey dizaakko</para>
  <para style="q2" vid="PSA 55:6">piradhdha baada shempana.<verse eid="PSA 55:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7" />Tani beta baadakka</para>
  <para style="q2" vid="PSA 55:7">bazzon de7ana shin.<verse eid="PSA 55:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8" />Tani goteppenne uushoppe attizaso</para>
  <para style="q2" vid="PSA 55:8">eesotada gakkana shin» gadis.<verse eid="PSA 55:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9" />Abeet Godawu!</para>
  <para style="q2" vid="PSA 55:9">Tani katamay giddon</para>
  <para style="q2" vid="PSA 55:9">ooshshinne gene beyadis;</para>
  <para style="q2" vid="PSA 55:9">iitata zore ne dhayssa;</para>
  <para style="q2" vid="PSA 55:9">istta qofaakka</para>
  <para style="q2" vid="PSA 55:9">bulakereththa yegga.<verse eid="PSA 55:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10" />Iitati gallassinne qamma</para>
  <para style="q2" vid="PSA 55:10">katama gimbeza bollara</para>
  <para style="q2" vid="PSA 55:10">yuuyeettes;</para>
  <para style="q2" vid="PSA 55:10">iitateththinne geney</para>
  <para style="q2" vid="PSA 55:10">izi giddon dees.<verse eid="PSA 55:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11" />Bashshi izi giddon dees;</para>
  <para style="q2" vid="PSA 55:11">geneynne cimoy</para>
  <para style="q2" vid="PSA 55:11">izi dubbushatappe shaakettenna.<verse eid="PSA 55:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12" />Ta morkkey tana cayidaakko</para>
  <para style="q2" vid="PSA 55:12">ta iza dandaya aaththanakko,</para>
  <para style="q2" vid="PSA 55:12">ta bolla ceeqettizay</para>
  <para style="q2" vid="PSA 55:12">tana ixxizaade</para>
  <para style="q2" vid="PSA 55:12">gididaakko tani izappe qotettana.<verse eid="PSA 55:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13" />Gido attiin hayssa ubbaa</para>
  <para style="q2" vid="PSA 55:13">ta bolla ooththizay nena,</para>
  <para style="q2" vid="PSA 55:13">ta laggeza, ta dabbozanne</para>
  <para style="q2" vid="PSA 55:13">ta siiqoza.<verse eid="PSA 55:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14" />Nuni issoy issaara</para>
  <para style="q2" vid="PSA 55:14">ufayssan haasayettidos;</para>
  <para style="q2" vid="PSA 55:14">issifekka Xoossa soon</para>
  <para style="q2" vid="PSA 55:14">simerettidos.<verse eid="PSA 55:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15" />Iitateththi istta wozina</para>
  <para style="q2" vid="PSA 55:15">giddon diza gishshas</para>
  <para style="q2" vid="PSA 55:15">ta morkketa bolla qoppontta</para>
  <para style="q2" vid="PSA 55:15">hayqoy gakko;</para>
  <para style="q2" vid="PSA 55:15">shemppora paxa dishe</para>
  <para style="q2" vid="PSA 55:15">moogettetto!<verse eid="PSA 55:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16" />Tani gidikko ta Xoossa xeygays;</para>
  <para style="q2" vid="PSA 55:16">GODAY tana ashshees.<verse eid="PSA 55:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17" />Maalado, gallassinne omars</para>
  <para style="q2" vid="PSA 55:17">tani waassayssinne</para>
  <para style="q2" vid="PSA 55:17">ta meto izas yootays;</para>
  <para style="q2" vid="PSA 55:17">izi ta qaala siyees.<verse eid="PSA 55:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18" />Daroti tana eqettikokka,</para>
  <para style="q2" vid="PSA 55:18">izi tana ola tooraappe ashshees.<verse eid="PSA 55:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19" />Beniisofe kawoteththa araatan</para>
  <para style="q2" vid="PSA 55:19">utti diza Xoossay</para>
  <para style="q2" vid="PSA 55:19">ta woosa siyidi</para>
  <para style="q2" vid="PSA 55:19">ba oge laammonttaytanne</para>
  <para style="q2" vid="PSA 55:19">Xoossas yayyonttayta</para>
  <para style="q2" vid="PSA 55:19">kawushshana.<verse eid="PSA 55:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20" />Ta laggezi ba siiqota bolla</para>
  <para style="q2" vid="PSA 55:20">ba kushe denththides;</para>
  <para style="q2" vid="PSA 55:20">isttara caaqettida</para>
  <para style="q2" vid="PSA 55:20">caaqo qaalaakka laallides.<verse eid="PSA 55:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21" />Iza doonappe keziza qaalay</para>
  <para style="q2" vid="PSA 55:21">oyssa mala;</para>
  <para style="q2" vid="PSA 55:21">gido attiin iza wozinay</para>
  <para style="q2" vid="PSA 55:21">caddiza toora mala;</para>
  <para style="q2" vid="PSA 55:21">iza qaalati zaytepekka</para>
  <para style="q2" vid="PSA 55:21">aadhdhi shugo;</para>
  <para style="q2" vid="PSA 55:21">gido attiin qanxxiza</para>
  <para style="q2" vid="PSA 55:21">mashsha mala.<verse eid="PSA 55:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22" />Ne meto GODAA bolla woththa;</para>
  <para style="q2" vid="PSA 55:22">izi nena minththi naagana;</para>
  <para style="q2" vid="PSA 55:22">izi xilloti</para>
  <para style="q2" vid="PSA 55:22">kundana mala ooththenna.<verse eid="PSA 55:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 55:23">Neni gidikko iitata</para>
  <para style="q2" vid="PSA 55:23">duge ciimma ollan yeggana.</para>
  <para style="q2" vid="PSA 55:23">Suuth gussizaytinne</para>
  <para style="q2" vid="PSA 55:23">baleththizayti</para>
  <para style="q2" vid="PSA 55:23">ba daana layththas</para>
  <para style="q2" vid="PSA 55:23">baggaka deettenna;</para>
  <para style="q2" vid="PSA 55:23">gido attiin tani</para>
  <para style="q2" vid="PSA 55:23">nenan ammanettays.<verse eid="PSA 55:23" /></para>
  <chapter eid="PSA 55" />
  <chapter number="56" style="c" sid="PSA 56" />
  <para style="s1">Filisxeeme asay Geete kataman Dawite oykkida wode Dawiti zammareta kaabbos yexxida mazamure; «Haahoson diza wola bolla uttida haraphpheyo» geetettiza diiththa giigson shiiqida woosa.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 56:1" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 56:1">Asay tana un7eththees;</para>
  <para style="q2" vid="PSA 56:1">ta morkketi tana</para>
  <para style="q2" vid="PSA 56:1">ubba wode yedeththeettes;</para>
  <para style="q2" vid="PSA 56:1">hessa gishshas ne taas qadhetta.<verse eid="PSA 56:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2" />Ta morkketi ubbaa gallas</para>
  <para style="q2" vid="PSA 56:2">tana yedeththeettes;</para>
  <para style="q2" vid="PSA 56:2">daroti otoreteththan tana oleettes.<verse eid="PSA 56:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3" />Tana babisiza wode</para>
  <para style="q2" vid="PSA 56:3">ta nenan ammanettays.<verse eid="PSA 56:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 56:4" />Tani Xoossan</para>
  <para style="q2" vid="PSA 56:4">ammanettiza gishshas babbike;</para>
  <para style="q2" vid="PSA 56:4">izi immida hidota qaala</para>
  <para style="q2" vid="PSA 56:4">gishshassika</para>
  <para style="q2" vid="PSA 56:4">iza galatays;</para>
  <para style="q2" vid="PSA 56:4">ta Xoossan ammanettays;</para>
  <para style="q2" vid="PSA 56:4">asi tana ay ooththanee?<verse eid="PSA 56:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5" />Ubbaa gallas ta morkketi</para>
  <para style="q2" vid="PSA 56:5">taappe mooro demmanaas</para>
  <para style="q2" vid="PSA 56:5">woxxeettes;</para>
  <para style="q2" vid="PSA 56:5">istti ubba wode</para>
  <para style="q2" vid="PSA 56:5">tana qohanaas zoretteettes.<verse eid="PSA 56:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6" />Shiiqidi ta bolla maqetteettes;</para>
  <para style="q2" vid="PSA 56:6">zamadi uttidi tana kaaletteettessinne</para>
  <para style="q2" vid="PSA 56:6">ta geedon eqqetteettes;</para>
  <para style="q2" vid="PSA 56:6">tana wodhanaaska koyeettes.<verse eid="PSA 56:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7" />Xoossoo! Istta iitateththaa gishshas</para>
  <para style="q2" vid="PSA 56:7">istta yeddofa;</para>
  <para style="q2" vid="PSA 56:7">he kawoteththata</para>
  <para style="q2" vid="PSA 56:7">ne hanqon kawushsha.<verse eid="PSA 56:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8" />Neni ta yeeho beyadasa;</para>
  <para style="q2" vid="PSA 56:8">ta afunththaa makkadasa;</para>
  <para style="q2" vid="PSA 56:8">ubbatikka ne mazgaban</para>
  <para style="q2" vid="PSA 56:8">xaafettida.<verse eid="PSA 56:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9" />Tani nena xeygiza wode</para>
  <para style="q2" vid="PSA 56:9">ta morkketi guye simmeettes;</para>
  <para style="q2" vid="PSA 56:9">Xoossi tanara dizayssa</para>
  <para style="q2" vid="PSA 56:9">tani hessan erays.<verse eid="PSA 56:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10" />Ta iza qaala galatiza Xoossan,</para>
  <para style="q2" vid="PSA 56:10">ta iza qaala sabbiza GODAAN,<verse eid="PSA 56:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="PSA 56:11" />tani he Xoossan</para>
  <para style="q2" vid="PSA 56:11">ammanettiza gishshas babbike;</para>
  <para style="q2" vid="PSA 56:11">asi tana ay ooththanee?<verse eid="PSA 56:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 56:12">Tani nees adina adinettadis;</para>
  <para style="q2" vid="PSA 56:12">ta adinettoyssa galata yarsho</para>
  <para style="q2" vid="PSA 56:12">nees gaththana.<note caller="-" style="x"><char style="xo" closed="false">56:1-12 </char><char style="xt" closed="false"><ref loc="1SA 21:13-15">1Same 21:13-15</ref></char></note><verse eid="PSA 56:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13" />Neni ta shemppoyo hayqoppe</para>
  <para style="q2" vid="PSA 56:13">ta tohota dhupheppe ashshadasa.</para>
  <para style="q2" vid="PSA 56:13">Hessa gishshas izi</para>
  <para style="q2" vid="PSA 56:13">shemppora paxa dizaytas</para>
  <para style="q2" vid="PSA 56:13">poo7isiza poo7on</para>
  <para style="q2" vid="PSA 56:13">Xoossa sinththan</para>
  <para style="q2" vid="PSA 56:13">ta simerettana.<verse eid="PSA 56:13" /></para>
  <chapter eid="PSA 56" />
  <chapter number="57" style="c" sid="PSA 57" />
  <para style="s1">Dawiti Sa7oole sinththafe baqatidi gongolo giddon dishe zammareta kaabbos, «Dhayssofa» geetettiza diiththa giigson shiishshida woosa mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 57:1" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 57:1">Ne taas qadhetta;</para>
  <para style="q2" vid="PSA 57:1">tana maara;</para>
  <para style="q2" vid="PSA 57:1">ta shemppoya nenan zemppadus;</para>
  <para style="q2" vid="PSA 57:1">bashshay aadhdhana gakkanaas</para>
  <para style="q2" vid="PSA 57:1">tani ne qefeta garsan qotettana.<verse eid="PSA 57:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2" />Izi ba halchcho mala taas poliza</para>
  <para style="q2" vid="PSA 57:2">Ubbaafe Dhoqqa</para>
  <para style="q2" vid="PSA 57:2">Xoossako waassays.<verse eid="PSA 57:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3" />Xoossi saloppe maado kiittidi</para>
  <para style="q2" vid="PSA 57:3">tana ashshana;</para>
  <para style="q2" vid="PSA 57:3">tana yedhdhizayta kawushshana;</para>
  <para style="q2" vid="PSA 57:3">Xoossi ba mernaa siiqonne</para>
  <para style="q2" vid="PSA 57:3">ba tumateththaa taas kiittana.<verse eid="PSA 57:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4" />Tani ta morkketa giddon,</para>
  <para style="q2" vid="PSA 57:4">as puuzidi miza gaammo</para>
  <para style="q2" vid="PSA 57:4">misatizayta giddon days.</para>
  <para style="q2" vid="PSA 57:4">Istta achchay tooranne</para>
  <para style="q2" vid="PSA 57:4">wondafe yiishshaa mala;</para>
  <para style="q2" vid="PSA 57:4">istta inxarsayka</para>
  <para style="q2" vid="PSA 57:4">qara mashsha mala.<verse eid="PSA 57:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5" />Abeet Xoossawu! Neni salotappe</para>
  <para style="q2" vid="PSA 57:5">bollara dhoqqu dhoqqu ga;</para>
  <para style="q2" vid="PSA 57:5">ne bonchchoy sa7a ubbaa kumo.<verse eid="PSA 57:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6" />Istti ta tohos woximade woththida;</para>
  <para style="q2" vid="PSA 57:6">ta asateththaa kuunissida;</para>
  <para style="q2" vid="PSA 57:6">istti ta ogen olla bookkida;</para>
  <para style="q2" vid="PSA 57:6">gido attiin he ollan</para>
  <para style="q2" vid="PSA 57:6">banttas kundida.<verse eid="PSA 57:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7" />Ta wozinay minni dees;</para>
  <para style="q2" vid="PSA 57:7">abeet Xoossawu!</para>
  <para style="q2" vid="PSA 57:7">Ta wozinay minnidi dees;</para>
  <para style="q2" vid="PSA 57:7">tani nees yexxananne</para>
  <para style="q2" vid="PSA 57:7">nena sabbana.<verse eid="PSA 57:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8" />Ta shemppoyee birkka!</para>
  <para style="q2" vid="PSA 57:8">Diiththatinne maasinqoti</para>
  <para style="q2" vid="PSA 57:8">beeggite!</para>
  <para style="q2" vid="PSA 57:8">Tanikka wonttara dendana.<verse eid="PSA 57:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9" />Abeet Godawu, tani nena</para>
  <para style="q2" vid="PSA 57:9">asa ubbaa sinththan galatana;</para>
  <para style="q2" vid="PSA 57:9">qasse deraa giddon</para>
  <para style="q2" vid="PSA 57:9">ta nena yeththan sabbana.<verse eid="PSA 57:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10" />Ne mernaa siiqoy</para>
  <para style="q2" vid="PSA 57:10">pude salo gakkides;</para>
  <para style="q2" vid="PSA 57:10">ne tumateththayka</para>
  <para style="q2" vid="PSA 57:10">salo shaara gakkides.<verse eid="PSA 57:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 57:11">Neni salotappe bollara</para>
  <para style="q2" vid="PSA 57:11">dhoqqu dhoqqu ga;</para>
  <para style="q2" vid="PSA 57:11">ne bonchchoy</para>
  <para style="q2" vid="PSA 57:11">sa7a ubbaa kumo.<note caller="-" style="x"><char style="xo" closed="false">57:1-11 </char><char style="xt" closed="false"><ref loc="1SA 22:1">1Same 22:1</ref>; <ref loc="1SA 24:3">24:3</ref></char></note><verse eid="PSA 57:11" /></para>
  <chapter eid="PSA 57" />
  <chapter number="58" style="c" sid="PSA 58" />
  <para style="s1">Dawiti zammareta kaabbos, «Dhayssofa» geetettiza diiththa giigson shiishshida woosa mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 58:1" />Intteno dere haarizaytoo!</para>
  <para style="q2" vid="PSA 58:1">Addaka intte doonappe</para>
  <para style="q2" vid="PSA 58:1">xillo haasayay kezizee?</para>
  <para style="q2" vid="PSA 58:1">Asa ubbaas xillo pirdeetii?<verse eid="PSA 58:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2" />Akkay! Intte wozinan</para>
  <para style="q2" vid="PSA 58:2">iita miish halchcheeta;</para>
  <para style="q2" vid="PSA 58:2">intte kushey biitta bolla</para>
  <para style="q2" vid="PSA 58:2">makkalla ooso ooththees.<verse eid="PSA 58:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3" />Iitati ba aayi uloppe doommidi</para>
  <para style="q2" vid="PSA 58:3">mooro oge beettes;</para>
  <para style="q2" vid="PSA 58:3">yelettida gallassafe doommidi</para>
  <para style="q2" vid="PSA 58:3">baletteettessinne wordoteettes.<verse eid="PSA 58:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4" />Istti shooshsha mala</para>
  <para style="q2" vid="PSA 58:4">marzera deettes;</para>
  <para style="q2" vid="PSA 58:4">tulle goppe shooshsha mala</para>
  <para style="q2" vid="PSA 58:4">ba hayth tulliseettes.<verse eid="PSA 58:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5" />Muurennizayssi ay mala</para>
  <para style="q2" vid="PSA 58:5">cincca gidikkoka</para>
  <para style="q2" vid="PSA 58:5">goppe shooshshi</para>
  <para style="q2" vid="PSA 58:5">iza cenggurssaa siyenna.<verse eid="PSA 58:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 58:6">Istta achchaa menththa;</para>
  <para style="q2" vid="PSA 58:6">abeet GODAWU!</para>
  <para style="q2" vid="PSA 58:6">Gaammota banqila menththa.<verse eid="PSA 58:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7" />Istti gukkiza haaththa mala</para>
  <para style="q2" vid="PSA 58:7">dhayetto;</para>
  <para style="q2" vid="PSA 58:7">istti dukkiza</para>
  <para style="q2" vid="PSA 58:7">wondafe yiishshay dun7o.<verse eid="PSA 58:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8" />Istti bishe</para>
  <para style="q2" vid="PSA 58:8">muushiza dhaadhdhe mala</para>
  <para style="q2" vid="PSA 58:8">gidetto;</para>
  <para style="q2" vid="PSA 58:8">poo7o be7ontta awucaya yelettida</para>
  <para style="q2" vid="PSA 58:8">naa mala gidetto.<verse eid="PSA 58:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9" />Agunththa tamay oto suulisontta</para>
  <para style="q2" vid="PSA 58:9">dhayza mala nagaranchchata</para>
  <para style="q2" vid="PSA 58:9">ne eeson dhayssa.<verse eid="PSA 58:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10" />Nagaranchchata bolla</para>
  <para style="q2" vid="PSA 58:10">halo kessizayssa be7idi</para>
  <para style="q2" vid="PSA 58:10">xilloti ufayettana.</para>
  <para style="q2" vid="PSA 58:10">Iitata suuththan</para>
  <para style="q2" vid="PSA 58:10">ba toho meecettana.<verse eid="PSA 58:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11" />He wode asay,</para>
  <para style="q2" vid="PSA 58:11">«Addaka xilloti ooththida</para>
  <para style="q2" vid="PSA 58:11">lo7o oosos</para>
  <para style="q2" vid="PSA 58:11">woytoy dees;</para>
  <para style="q2" vid="PSA 58:11">tumukka sa7a bolla pirdiza</para>
  <para style="q2" vid="PSA 58:11">Xoossi dees» gaana.<verse eid="PSA 58:11" /></para>
  <chapter eid="PSA 58" />
  <chapter number="59" style="c" sid="PSA 59" />
  <para style="s1">Sa7ooli Dawite wodhanaas kiittida asati iza keeththaa dooddi uttida wode Dawiti zammareta kaabbos, «Dhayssofa» geetettiza diiththa giigson shiishshida woosa mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 59:1" />Abeet ta Xoossawu!</para>
  <para style="q2" vid="PSA 59:1">Ta morkketappe</para>
  <para style="q2" vid="PSA 59:1">tana ashsha;</para>
  <para style="q2" vid="PSA 59:1">ta bolla dendizaytappe</para>
  <para style="q2" vid="PSA 59:1">tana naaga.<note caller="-" style="x"><char style="xo" closed="false">59:1-17 </char><char style="xt" closed="false"><ref loc="1SA 19:11">1Same 19:11</ref></char></note><verse eid="PSA 59:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2" />Iita ooththizaytappe</para>
  <para style="q2" vid="PSA 59:2">tana maadda;</para>
  <para style="q2" vid="PSA 59:2">suuth gussiza asatappe</para>
  <para style="q2" vid="PSA 59:2">tana ashsha.<verse eid="PSA 59:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 59:3">Istti tana wodhanawu</para>
  <para style="q2" vid="PSA 59:3">zamadidi naagizayssa be7a!</para>
  <para style="q2" vid="PSA 59:3">menxe iita asati</para>
  <para style="q2" vid="PSA 59:3">tani mooronne</para>
  <para style="q2" vid="PSA 59:3">nagara ooththontta dishin</para>
  <para style="q2" vid="PSA 59:3">ta bolla duulateettes.<verse eid="PSA 59:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4" />Aykko mooro ta ooththontta dishin</para>
  <para style="q2" vid="PSA 59:4">tana dhayssanaas giigettida;</para>
  <para style="q2" vid="PSA 59:4">hayssa neni be7ada</para>
  <para style="q2" vid="PSA 59:4">tana maaddana denda.<verse eid="PSA 59:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 59:5">Ubbaafe Wolqqama Xoossawu!</para>
  <para style="q2" vid="PSA 59:5">Neni Isra7eele Xoossa;</para>
  <para style="q2" vid="PSA 59:5">kawoteththata ubbaa</para>
  <para style="q2" vid="PSA 59:5">qaxxayanaas ne beegga;</para>
  <para style="q2" vid="PSA 59:5">makkalla ooththizayta maaroppa.<verse eid="PSA 59:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6" />Istti kana mala hoskkattishe</para>
  <para style="q2" vid="PSA 59:6">katama giddon yuuyi pe7idi</para>
  <para style="q2" vid="PSA 59:6">omars simmana.<verse eid="PSA 59:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7" />Istta doonappe kezizayssa siyite!</para>
  <para style="q2" vid="PSA 59:7">istta inxarsay mashsha mala;</para>
  <para style="q2" vid="PSA 59:7">istti, «Oonee nuna siyanay?»</para>
  <para style="q2" vid="PSA 59:7">gi qoppeettes.<verse eid="PSA 59:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8" />Gido attiin abeet GODAWU!</para>
  <para style="q2" vid="PSA 59:8">Neni istta bolla miiccaasa;</para>
  <para style="q2" vid="PSA 59:8">kawoteththata ubbaa kadhaasa.<verse eid="PSA 59:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9" />Ta Xoossawu!</para>
  <para style="q2" vid="PSA 59:9">Ne taas miixa gidida gishshas</para>
  <para style="q2" vid="PSA 59:9">ta nenan ammanettays.<verse eid="PSA 59:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 59:10" />Ta Xoossay ba mernaa siiqon</para>
  <para style="q2" vid="PSA 59:10">tanara gayttana;</para>
  <para style="q2" vid="PSA 59:10">ta morkketa kundeth</para>
  <para style="q2" vid="PSA 59:10">izi tana bessana.<verse eid="PSA 59:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11" />Abeet nuus gondalle gidida</para>
  <para style="q2" vid="PSA 59:11">Godawu! Ta asay</para>
  <para style="q2" vid="PSA 59:11">neni halo kessizayssa</para>
  <para style="q2" vid="PSA 59:11">balontta mala</para>
  <para style="q2" vid="PSA 59:11">neni istta wodha dhayssofa;</para>
  <para style="q2" vid="PSA 59:11">gido attiin ne wolqqan</para>
  <para style="q2" vid="PSA 59:11">istta laallanne kawushsha.<verse eid="PSA 59:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12" />Istti bantta doonappe</para>
  <para style="q2" vid="PSA 59:12">kessiza nagara gishshas,</para>
  <para style="q2" vid="PSA 59:12">bantta inxarsaa qaala gishshas,</para>
  <para style="q2" vid="PSA 59:12">istti qanggida qanggeththa</para>
  <para style="q2" vid="PSA 59:12">gishshassinne</para>
  <para style="q2" vid="PSA 59:12">wordotiza gishshas</para>
  <para style="q2" vid="PSA 59:12">bantta otoreteththan oyketetto.<verse eid="PSA 59:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 59:13" />Ne hanqon istta dhayssa;</para>
  <para style="q2" vid="PSA 59:13">istta mulera dippi histta;</para>
  <para style="q2" vid="PSA 59:13">he wode Xoossi</para>
  <para style="q2" vid="PSA 59:13">Yaaqoobe zereththa</para>
  <para style="q2" vid="PSA 59:13">ayssizaadenne</para>
  <para style="q2" vid="PSA 59:13">sa7a gaxa gakkanaas diza deraa</para>
  <para style="q2" vid="PSA 59:13">haarizaade gididayssa</para>
  <para style="q2" vid="PSA 59:13">asi ubbay erana.<verse eid="PSA 59:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14" />Istti kana mala hoskkattishe</para>
  <para style="q2" vid="PSA 59:14">katama giddon yuuyi pe7idi</para>
  <para style="q2" vid="PSA 59:14">omars simmana.<verse eid="PSA 59:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15" />Istti miza miish hasishe yuuyeettes;</para>
  <para style="q2" vid="PSA 59:15">kallontta aggiko</para>
  <para style="q2" vid="PSA 59:15">kana mala laweettes.<verse eid="PSA 59:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16" />Gido attiin tani</para>
  <para style="q2" vid="PSA 59:16">ne wolqqa sabbana;</para>
  <para style="q2" vid="PSA 59:16">maalado maalado</para>
  <para style="q2" vid="PSA 59:16">ne mernaa siiqo gishshas</para>
  <para style="q2" vid="PSA 59:16">yexxana.</para>
  <para style="q2" vid="PSA 59:16">Neni taas meto gallas</para>
  <para style="q2" vid="PSA 59:16">zempponne baqata attiza miixa.<verse eid="PSA 59:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 59:17">Ta wolqqay nena;</para>
  <para style="q2" vid="PSA 59:17">ne taas miixa;</para>
  <para style="q2" vid="PSA 59:17">ne mernaa siiqon tana siiqaasa;</para>
  <para style="q2" vid="PSA 59:17">hessa gishshas galata yeththan</para>
  <para style="q2" vid="PSA 59:17">ta nena sabbana.<verse eid="PSA 59:17" /></para>
  <chapter eid="PSA 59" />
  <chapter number="60" style="c" sid="PSA 60" />
  <para style="p">Mesphexoomiyaninne Aaraamen diza deraara oletti simmidi Iyo7aabey Maxine Zullen tammanne nam7u shii Eedoome asaa wodhida wode timirtes Dawiti zammareta kaabbos, «Ciishsha» geetettiza diiththa giigson shiishshida markkateththa woosa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 60:1" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 60:1">Neni nuna aggadasa;</para>
  <para style="q2" vid="PSA 60:1">nuna menththereththa yeggadasa;</para>
  <para style="q2" vid="PSA 60:1">neni nuna hanqettadasa;</para>
  <para style="q2" vid="PSA 60:1">ha7i gidikko simmada</para>
  <para style="q2" vid="PSA 60:1">nuna giigsa.<verse eid="PSA 60:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2" />Neni biittayo qaaththada za7isadasa;</para>
  <para style="q2" vid="PSA 60:2">iza kokkoriza gishshas</para>
  <para style="q2" vid="PSA 60:2">neni izi za7a kunththa.<verse eid="PSA 60:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3" />Neni ne asaa meto bessadasa;</para>
  <para style="q2" vid="PSA 60:3">neni nuna maththosiza</para>
  <para style="q2" vid="PSA 60:3">woyne ushshu ushshadasa.<verse eid="PSA 60:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4" />Nees yayyizayti bantta morkketa</para>
  <para style="q2" vid="PSA 60:4">wondafeppe attana mala</para>
  <para style="q2" vid="PSA 60:4">malata immadasa.<verse eid="PSA 60:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5" />Neni siiqizayti attana mala</para>
  <para style="q2" vid="PSA 60:5">ne wolqqan nuna ashsha;</para>
  <para style="q2" vid="PSA 60:5">neni nuukko alla.<verse eid="PSA 60:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6" />Xoossi ba keeththan dishe,</para>
  <para style="q2" vid="PSA 60:6">«Tani xoonada Seekeeme</para>
  <para style="q2" vid="PSA 60:6">biitta shaakkana;</para>
  <para style="q2" vid="PSA 60:6">qasse Sukoote shoobbaa gishana.<verse eid="PSA 60:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7" />Gala7aadeynne Minaasey tayta;</para>
  <para style="q2" vid="PSA 60:7">Efreemey taas hu7e qoobe;</para>
  <para style="q2" vid="PSA 60:7">Yuhuday taas kawoteththa guufe.<verse eid="PSA 60:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8" />Mo7aabey ta meecettizaso;</para>
  <para style="q2" vid="PSA 60:8">Eedoomey taas caamma</para>
  <para style="q2" vid="PSA 60:8">woththizaso;</para>
  <para style="q2" vid="PSA 60:8">tani Filisxeeme</para>
  <para style="q2" vid="PSA 60:8">xoonada gererana» gides.<verse eid="PSA 60:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9" />Gimbettida katamaakko</para>
  <para style="q2" vid="PSA 60:9">tana oonee efanay?</para>
  <para style="q2" vid="PSA 60:9">Eedoome gakkanaas</para>
  <para style="q2" vid="PSA 60:9">tana oonee kaaleththanay?<verse eid="PSA 60:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 60:10">Nuna aggiday nena gidikkii?</para>
  <para style="q2" vid="PSA 60:10">«Neni nu tooranchchatara</para>
  <para style="q2" vid="PSA 60:10">olas kezikke» gadasa.<verse eid="PSA 60:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11" />Asappe gidida maadoy hada;</para>
  <para style="q2" vid="PSA 60:11">hessa gishshas nu morkketa bolla</para>
  <para style="q2" vid="PSA 60:11">nuus xoono imma.<verse eid="PSA 60:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12" />Xoossa wolqqan nu morkketa</para>
  <para style="q2" vid="PSA 60:12">nuni xoonana;</para>
  <para style="q2" vid="PSA 60:12">izi nu morkketa yedhettana.<note caller="-" style="x"><char style="xo" closed="false">60:1-12 </char><char style="xt" closed="false"><ref loc="2SA 8:13">2Same 8:13</ref>; <ref loc="1CH 18:12">1Taari 18:12</ref></char></note><verse eid="PSA 60:12" /></para>
  <chapter eid="PSA 60" />
  <chapter number="61" style="c" sid="PSA 61" />
  <para style="s1">Dawiti Zammareta Kaabbos Diiththatan Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 61:1" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 61:1">Neni ta waasoza siya;</para>
  <para style="q2" vid="PSA 61:1">ta woosaakka ezga.<verse eid="PSA 61:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2" />Ta wozinay taahiin</para>
  <para style="q2" vid="PSA 61:2">biitta gaxan dashe ta nena xeygays;</para>
  <para style="q2" vid="PSA 61:2">taappe dhoqqiza zaallaako tana kaaleththa.<verse eid="PSA 61:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3" />Neni taas geemmizasonne</para>
  <para style="q2" vid="PSA 61:3">tani ta morkketappe</para>
  <para style="q2" vid="PSA 61:3">naagetta attiza mino miixa.<verse eid="PSA 61:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4" />Tani ne Dunkaanezan mernaas daana;</para>
  <para style="q2" vid="PSA 61:4">ne qefe giddon kametta attana.<verse eid="PSA 61:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 61:5">Neni ta adina siyadasa;</para>
  <para style="q2" vid="PSA 61:5">ne sunththa yayyizayti</para>
  <para style="q2" vid="PSA 61:5">laattiza laata taaska immadasa.<verse eid="PSA 61:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6" />Kawoza shemppo gam7isa;</para>
  <para style="q2" vid="PSA 61:6">iza layththaa yeletappe yeleta gaththa.<verse eid="PSA 61:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7" />Izi Xoossa sinththan mernaas kawoto;</para>
  <para style="q2" vid="PSA 61:7">ne mernaa siiqoninne</para>
  <para style="q2" vid="PSA 61:7">ne tumateththan iza naaga.<verse eid="PSA 61:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8" />Histtiko tani ta adina</para>
  <para style="q2" vid="PSA 61:8">gallas gallas gaththana;</para>
  <para style="q2" vid="PSA 61:8">ne sunththaaka ubbato</para>
  <para style="q2" vid="PSA 61:8">yeththan sabbana.<verse eid="PSA 61:8" /></para>
  <chapter eid="PSA 61" />
  <chapter number="62" style="c" sid="PSA 62" />
  <para style="s1">Dawiti Zammareta Kaabbo Edotaanes Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 62:1" />Ta shemppoya Xoossan xalla</para>
  <para style="q2" vid="PSA 62:1">shemppo demmawus;</para>
  <para style="q2" vid="PSA 62:1">taas atoteththi izappe yees.<verse eid="PSA 62:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2" />Izi xalla taas zaallanne</para>
  <para style="q2" vid="PSA 62:2">tana ashshizayssa;</para>
  <para style="q2" vid="PSA 62:2">ta qotetta attizaso gidida gishshas</para>
  <para style="q2" vid="PSA 62:2">mulekka hirgike.<verse eid="PSA 62:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3" />Cimmidi kundana matida</para>
  <para style="q2" vid="PSA 62:3">goda malanne</para>
  <para style="q2" vid="PSA 62:3">musida lasha mala</para>
  <para style="q2" vid="PSA 62:3">wolqqay baynda as</para>
  <para style="q2" vid="PSA 62:3">dhayssanawu sugishe</para>
  <para style="q2" vid="PSA 62:3">awude gakkanaas de7andetii?<verse eid="PSA 62:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4" />Istti iza bonchcho sohoppe</para>
  <para style="q2" vid="PSA 62:4">kawushshanaas xalla koyeettes;</para>
  <para style="q2" vid="PSA 62:4">istti wordon ufayetteettes;</para>
  <para style="q2" vid="PSA 62:4">bantta doonan anjjeettes;</para>
  <para style="q2" vid="PSA 62:4">gido attiin</para>
  <para style="q2" vid="PSA 62:4">bantta wozinan qanggeettes.<verse eid="PSA 62:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5" />Ta shemppoyee!</para>
  <para style="q2" vid="PSA 62:5">Woppu gaada Xoossa xalla naaga;</para>
  <para style="q2" vid="PSA 62:5">taas hidotay izappe yaana.<verse eid="PSA 62:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6" />Izi xalla taas zaallanne</para>
  <para style="q2" vid="PSA 62:6">tana ashshizayssa;</para>
  <para style="q2" vid="PSA 62:6">ta qotetta attizaso gidida gishshas</para>
  <para style="q2" vid="PSA 62:6">mulekka hirgike.<verse eid="PSA 62:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7" />Taas atoteththinne</para>
  <para style="q2" vid="PSA 62:7">bonchchoy beettiday Xoossafe;</para>
  <para style="q2" vid="PSA 62:7">izi ta qotetta attizasonne</para>
  <para style="q2" vid="PSA 62:7">taas mino zaalla.<verse eid="PSA 62:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8" />Asoo! Ubbaa wode</para>
  <para style="q2" vid="PSA 62:8">Xoossan ammanettite;</para>
  <para style="q2" vid="PSA 62:8">izi nuus</para>
  <para style="q2" vid="PSA 62:8">qotetti attizaso gidida gishshas</para>
  <para style="q2" vid="PSA 62:8">intte wozina qofa izas yootite.<verse eid="PSA 62:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9" />Bonchchosoppe</para>
  <para style="q2" vid="PSA 62:9">yeleteththi maaddenna;</para>
  <para style="q2" vid="PSA 62:9">kadhettidasoppe yeleteththika</para>
  <para style="q2" vid="PSA 62:9">ubbay hada.</para>
  <para style="q2" vid="PSA 62:9">Istti meezaane denththontta</para>
  <para style="q2" vid="PSA 62:9">carko mala;</para>
  <para style="q2" vid="PSA 62:9">istti issi bolla</para>
  <para style="q2" vid="PSA 62:9">carko mala kawushsha.<verse eid="PSA 62:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10" />Bonqqan ammanettofte;</para>
  <para style="q2" vid="PSA 62:10">kaysi shiishshida dureteththan</para>
  <para style="q2" vid="PSA 62:10">hidota ooththofte.</para>
  <para style="q2" vid="PSA 62:10">Inttes dureteththi darikkoka</para>
  <para style="q2" vid="PSA 62:10">intte wozina iza bolla woththofte.<verse eid="PSA 62:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11" />Xoossay issito haasaydes;</para>
  <para style="q2" vid="PSA 62:11">tani nam7u yo7ota siyadis;</para>
  <para style="q2" vid="PSA 62:11">heytikka, «Wolqqay Xoossassa;<verse eid="PSA 62:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="PSA 62:12" />mernaa siiqoy Xoossassa.»</para>
  <para style="q2" vid="PSA 62:12">Abeet Godawu!</para>
  <para style="q2" vid="PSA 62:12">Neni as ubbaas</para>
  <para style="q2" vid="PSA 62:12">iza ooso ooso mala immana.<note caller="-" style="x"><char style="xo" closed="false">62:12 </char><char style="xt" closed="false"><ref loc="JOB 34:11">Iyo 34:11</ref>; <ref loc="JER 17:10">Er 17:10</ref>; <ref loc="MAT 16:27">Mato 16:27</ref>; <ref loc="ROM 2:6">Oro 2:6</ref>; <ref loc="REV 2:23">Ajju 2:23</ref></char></note><verse eid="PSA 62:12" /></para>
  <chapter eid="PSA 62" />
  <chapter number="63" style="c" sid="PSA 63" />
  <para style="s1">Yuhuda Bazzon Diza Wode Dawite Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 63:1">Neni ta Xoossa;</para>
  <para style="q2" vid="PSA 63:1">ta nena wozinappe koyays;</para>
  <para style="q2" vid="PSA 63:1">ta ashoykka nena amottees.</para>
  <para style="q2" vid="PSA 63:1">Haaththi baynda mela biittay</para>
  <para style="q2" vid="PSA 63:1">haath koyza mala ta asateththay</para>
  <para style="q2" vid="PSA 63:1">nena saamettees.<verse eid="PSA 63:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2" />Tani nena geeshshasohon xeelladis;</para>
  <para style="q2" vid="PSA 63:2">ne wolqqanne ne bonchcho</para>
  <para style="q2" vid="PSA 63:2">tani be7adis.<verse eid="PSA 63:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3" />Ne mernaa siiqoy de7oppe lo7ees;</para>
  <para style="q2" vid="PSA 63:3">ta inxarsay nena galatees.<verse eid="PSA 63:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4" />Ta de7o layththankka</para>
  <para style="q2" vid="PSA 63:4">tani nena galatana;</para>
  <para style="q2" vid="PSA 63:4">ne sunththan ta kushe</para>
  <para style="q2" vid="PSA 63:4">pude neekko denththana.<verse eid="PSA 63:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5" />Asi lo7o kath mi kallidi</para>
  <para style="q2" vid="PSA 63:5">ufayettiza mala</para>
  <para style="q2" vid="PSA 63:5">ta shemppoya nenan ufayettana;</para>
  <para style="q2" vid="PSA 63:5">tani ta inxarsan ufayssa yeththan</para>
  <para style="q2" vid="PSA 63:5">nena galatana.<verse eid="PSA 63:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6" />Tani ta hiixan dashe</para>
  <para style="q2" vid="PSA 63:6">nena hassa7ays;</para>
  <para style="q2" vid="PSA 63:6">omarsa kumeth</para>
  <para style="q2" vid="PSA 63:6">ne ooso yuushsha qoppays;<verse eid="PSA 63:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7" />Neni tana maaddiza gishshas</para>
  <para style="q2" vid="PSA 63:7">tani ne qefe kuwan uttada</para>
  <para style="q2" vid="PSA 63:7">ufayssan yexxays.<verse eid="PSA 63:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8" />Ta shemppoya shiphphi ga kaalladus;</para>
  <para style="q2" vid="PSA 63:8">ne ushachcha kusheykka</para>
  <para style="q2" vid="PSA 63:8">tana minththi oykkides.<verse eid="PSA 63:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9" />Gido attiin tana wodhana koyzayti</para>
  <para style="q2" vid="PSA 63:9">biitta garsan ciimma ollan</para>
  <para style="q2" vid="PSA 63:9">moogettana.<verse eid="PSA 63:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10" />Istti mashshas aadhdhi imettana;</para>
  <para style="q2" vid="PSA 63:10">istti godare kawo gidana.<verse eid="PSA 63:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11" />Gido attiin kawoy</para>
  <para style="q2" vid="PSA 63:11">Xoossan ufayettana;</para>
  <para style="q2" vid="PSA 63:11">Xoossa sunththan caaqqiza ubbay</para>
  <para style="q2" vid="PSA 63:11">iza galatana;</para>
  <para style="q2" vid="PSA 63:11">wordo haasayzayta</para>
  <para style="q2" vid="PSA 63:11">doonay gidikko gordettana.<note caller="-" style="x"><char style="xo" closed="false">63:1-11 </char><char style="xt" closed="false"><ref loc="1SA 23:14">1Same 23:14</ref></char></note><verse eid="PSA 63:11" /></para>
  <chapter eid="PSA 63" />
  <chapter number="64" style="c" sid="PSA 64" />
  <para style="s1">Dawiti Zammareta Kaabbos Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 64:1">Ta magana neni siya;</para>
  <para style="q2" vid="PSA 64:1">ta shemppoyo</para>
  <para style="q2" vid="PSA 64:1">wodhanaas mandiza</para>
  <para style="q2" vid="PSA 64:1">ta morkketappe tana ashsha.<verse eid="PSA 64:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2" />Pala asata maqqofenne</para>
  <para style="q2" vid="PSA 64:2">makkallanchchata duulatappe</para>
  <para style="q2" vid="PSA 64:2">tana genththa.<verse eid="PSA 64:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3" />Istti bantta inxarsaa</para>
  <para style="q2" vid="PSA 64:3">mashsha mala leefida;</para>
  <para style="q2" vid="PSA 64:3">qasse marze qaalata</para>
  <para style="q2" vid="PSA 64:3">wondafe yiishsha mala</para>
  <para style="q2" vid="PSA 64:3">dukkanaas giigsida.<verse eid="PSA 64:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4" />Istti qotettidi bantta wondafen</para>
  <para style="q2" vid="PSA 64:4">xillo as dukkeettes;</para>
  <para style="q2" vid="PSA 64:4">asi akeekontta dishin</para>
  <para style="q2" vid="PSA 64:4">dukkanaas guye geettenna.<verse eid="PSA 64:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5" />Istti iita ooththanaas</para>
  <para style="q2" vid="PSA 64:5">issoy issaara maqetteettes;</para>
  <para style="q2" vid="PSA 64:5">geemara woximade</para>
  <para style="q2" vid="PSA 64:5">woththanaas zoretteettes;</para>
  <para style="q2" vid="PSA 64:5">istti, «Nuna</para>
  <para style="q2" vid="PSA 64:5">ooni be7anee?» geettes.<verse eid="PSA 64:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6" />Istti gene maqettishe,</para>
  <para style="q2" vid="PSA 64:6">«Nuni lo7o maqqo</para>
  <para style="q2" vid="PSA 64:6">maqettidos» geettes;</para>
  <para style="q2" vid="PSA 64:6">hessika asa wozinaynne kahay</para>
  <para style="q2" vid="PSA 64:6">iitan kumidayssa bessees.<verse eid="PSA 64:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7" />Gido attiin Xoossay</para>
  <para style="q2" vid="PSA 64:7">istta ba yiishshan dukkana;</para>
  <para style="q2" vid="PSA 64:7">istti akeekontta madunththana.<verse eid="PSA 64:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8" />Izi istti haasayda qaala</para>
  <para style="q2" vid="PSA 64:8">istta bolla zaarana;</para>
  <para style="q2" vid="PSA 64:8">isttaka bashshan gaththana;</para>
  <para style="q2" vid="PSA 64:8">istta be7ida ubbay</para>
  <para style="q2" vid="PSA 64:8">aamusidi hu7e qaaththana.<verse eid="PSA 64:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9" />He wode asay ubbay</para>
  <para style="q2" vid="PSA 64:9">Xoossas yayyana;</para>
  <para style="q2" vid="PSA 64:9">Xoossa ooso qonccen yootana;</para>
  <para style="q2" vid="PSA 64:9">izi ooththidayssaka</para>
  <para style="q2" vid="PSA 64:9">yuushshi qoppana.<verse eid="PSA 64:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10" />Xilloti GODAAN ufayetetto;</para>
  <para style="q2" vid="PSA 64:10">izakka baas baqati</para>
  <para style="q2" vid="PSA 64:10">attizaso ooththetto;</para>
  <para style="q2" vid="PSA 64:10">wozina suureti ubbay</para>
  <para style="q2" vid="PSA 64:10">iza galatetto.<verse eid="PSA 64:10" /></para>
  <chapter eid="PSA 64" />
  <chapter number="65" style="c" sid="PSA 65" />
  <para style="s1">Dawiti Zammareta Kaabbos Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 65:1">Xiyoonen nees galatay bessees;</para>
  <para style="q2" vid="PSA 65:1">nuni nees adinettidayssa</para>
  <para style="q2" vid="PSA 65:1">gaththana.<verse eid="PSA 65:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2" />Abeet woosa siyizayssoo!</para>
  <para style="q2" vid="PSA 65:2">Asay ubbay neekko yaana.<verse eid="PSA 65:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3" />Nu nagaray nuna mittides;</para>
  <para style="q2" vid="PSA 65:3">neni gidikko nu balaa</para>
  <para style="q2" vid="PSA 65:3">atto ga wursadasa.<verse eid="PSA 65:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4" />Neni dooridaadeynne</para>
  <para style="q2" vid="PSA 65:4">nenara daana mala</para>
  <para style="q2" vid="PSA 65:4">ne dubbushaakko shiishsha</para>
  <para style="q2" vid="PSA 65:4">ekkidaadey anjjettidaade;</para>
  <para style="q2" vid="PSA 65:4">ne geeshshasozappenne</para>
  <para style="q2" vid="PSA 65:4">ne dunkaane anjjozappe</para>
  <para style="q2" vid="PSA 65:4">nu kallana.<verse eid="PSA 65:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5" />Abeet nuna ashshiza Xoossawu</para>
  <para style="q2" vid="PSA 65:5">ne xillo ooson malalisiza miish</para>
  <para style="q2" vid="PSA 65:5">nuus ooththa;</para>
  <para style="q2" vid="PSA 65:5">Sa7aa gaxappe gaxa gakkanaas,</para>
  <para style="q2" vid="PSA 65:5">haaho abbatappeka</para>
  <para style="q2" vid="PSA 65:5">he pinththan diza</para>
  <para style="q2" vid="PSA 65:5">asa ubbaas hidotay nena.<verse eid="PSA 65:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6" />Neni ne wolqqa gixettadasa;</para>
  <para style="q2" vid="PSA 65:6">zumatakka ne minththa essadasa.<verse eid="PSA 65:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7" />Neni abba giirissanne</para>
  <para style="q2" vid="PSA 65:7">dambala gunththa</para>
  <para style="q2" vid="PSA 65:7">sirphi ooththaasa;</para>
  <para style="q2" vid="PSA 65:7">qasse derey</para>
  <para style="q2" vid="PSA 65:7">dendiza denththa irxxisaasa.<verse eid="PSA 65:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8" />Hessaththo neni ooththida</para>
  <para style="q2" vid="PSA 65:8">malaata gishshas,</para>
  <para style="q2" vid="PSA 65:8">sa7a gaxa gakkanaas</para>
  <para style="q2" vid="PSA 65:8">de7iza asay</para>
  <para style="q2" vid="PSA 65:8">ubbay nees,</para>
  <para style="q2" vid="PSA 65:8">«Hoola!» gees.</para>
  <para style="q2" vid="PSA 65:8">Arshey mokkizasoppe</para>
  <para style="q2" vid="PSA 65:8">wullizaso gakkanaas</para>
  <para style="q2" vid="PSA 65:8">diza asa ubbaa ufayssan</para>
  <para style="q2" vid="PSA 65:8">ilili giissadasa.<verse eid="PSA 65:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9" />Neni biitta naagada haath</para>
  <para style="q2" vid="PSA 65:9">ushshaasa;</para>
  <para style="q2" vid="PSA 65:9">histtada daro duresaasa;</para>
  <para style="q2" vid="PSA 65:9">Asas kaththay mokkana mala</para>
  <para style="q2" vid="PSA 65:9">Xoossa shaafay</para>
  <para style="q2" vid="PSA 65:9">haaththan kumides;</para>
  <para style="q2" vid="PSA 65:9">hessaththo ooththada</para>
  <para style="q2" vid="PSA 65:9">neni giigsadasa.<verse eid="PSA 65:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10" />Goshsha gadetas gidiza</para>
  <para style="q2" vid="PSA 65:10">ira immaasa;</para>
  <para style="q2" vid="PSA 65:10">Phasheta liiqisaasa;</para>
  <para style="q2" vid="PSA 65:10">biittaaka puuse iran shugisaasa;</para>
  <para style="q2" vid="PSA 65:10">caarechchati doli</para>
  <para style="q2" vid="PSA 65:10">diccana mala anjjaasa.<verse eid="PSA 65:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11" />Layththaa kalo layth ooththaasa;</para>
  <para style="q2" vid="PSA 65:11">neni aadhdhidaso ubbay</para>
  <para style="q2" vid="PSA 65:11">kath xalla gidees.<verse eid="PSA 65:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12" />Mehe heemmizasohon</para>
  <para style="q2" vid="PSA 65:12">cilila maatay kumides;</para>
  <para style="q2" vid="PSA 65:12">zumbullati ufayssan kumida.<verse eid="PSA 65:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13" />Dembatan wude mehey kumides;</para>
  <para style="q2" vid="PSA 65:13">shoobbatan kaththi kumides;</para>
  <para style="q2" vid="PSA 65:13">ubbatikka ufayssan</para>
  <para style="q2" vid="PSA 65:13">ililishe yexxeettes.<verse eid="PSA 65:13" /></para>
  <chapter eid="PSA 65" />
  <chapter number="66" style="c" sid="PSA 66" />
  <para style="s1">Zammareta Kaabbos Yexettida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 66:1" />Sa7an diza as ubbay</para>
  <para style="q2" vid="PSA 66:1">intte qaala dhoqqisidi</para>
  <para style="q2" vid="PSA 66:1">ililisan Xoossa galatite.<verse eid="PSA 66:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 66:2" />«Xoossa sunththi bonchchetto!»</para>
  <para style="q2" vid="PSA 66:2">giidi yexxite;</para>
  <para style="q2" vid="PSA 66:2">bonchcho galata izas immite.<verse eid="PSA 66:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3" />Xoossas, «Ne oosoti</para>
  <para style="q2" vid="PSA 66:3">ay keena malalisizoo!</para>
  <para style="q2" vid="PSA 66:3">Ne wolqqay daro gidida gishshas</para>
  <para style="q2" vid="PSA 66:3">ne morkketi yashshan</para>
  <para style="q2" vid="PSA 66:3">ne sinththan kokkoreettes.<verse eid="PSA 66:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4" />Sa7an diza ubbay</para>
  <para style="q2" vid="PSA 66:4">nees goynnees;</para>
  <para style="q2" vid="PSA 66:4">nena sabbees;</para>
  <para style="q2" vid="PSA 66:4">ne sunththas galata mazamure</para>
  <para style="q2" vid="PSA 66:4">yexxees» giite.<verse eid="PSA 66:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5" />Haa yiite;</para>
  <para style="q2" vid="PSA 66:5">Xoossi ooththidaaz be7ite;</para>
  <para style="q2" vid="PSA 66:5">izi asa giddon malalisiza</para>
  <para style="q2" vid="PSA 66:5">ooso ooththides.<verse eid="PSA 66:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6" />Izi abba haaththa shaakkides;</para>
  <para style="q2" vid="PSA 66:6">qasse beni nu aawati</para>
  <para style="q2" vid="PSA 66:6">shaafara mela</para>
  <para style="q2" vid="PSA 66:6">biittara tohon pinnida;</para>
  <para style="q2" vid="PSA 66:6">nunikka izi ooththida</para>
  <para style="q2" vid="PSA 66:6">ooson ufayettidos.<note caller="-" style="x"><char style="xo" closed="false">66:6 </char><char style="xt" closed="false"><ref loc="EXO 14:21">Kessa 14:21</ref>; <ref loc="JOS 3:14-17">Iya 3:14-17</ref></char></note><verse eid="PSA 66:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7" />Izi ba wolqqan mernaas haarees.</para>
  <para style="q2" vid="PSA 66:7">Kawoteththata ubbaaka</para>
  <para style="q2" vid="PSA 66:7">ba ayfen xeellees;</para>
  <para style="q2" vid="PSA 66:7">hessa gishshas makkallizayti</para>
  <para style="q2" vid="PSA 66:7">iza bolla dhoqqu dhoqqu</para>
  <para style="q2" vid="PSA 66:7">gooppetto.<verse eid="PSA 66:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8" />Asawu! Nu Xoossa galatite;</para>
  <para style="q2" vid="PSA 66:8">intte galata cenggurssay siyetto.<verse eid="PSA 66:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9" />Izi nuna shemppora</para>
  <para style="q2" vid="PSA 66:9">paxa woththides;</para>
  <para style="q2" vid="PSA 66:9">nuni kundontta malakka</para>
  <para style="q2" vid="PSA 66:9">naagides.<verse eid="PSA 66:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 66:10">Neni nuna paacca xeelladasa;</para>
  <para style="q2" vid="PSA 66:10">bira seerisi geeshshiza mala</para>
  <para style="q2" vid="PSA 66:10">nuna geeshshadasa.<verse eid="PSA 66:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11" />Neni nuna woximaden</para>
  <para style="q2" vid="PSA 66:11">gelththadasa;</para>
  <para style="q2" vid="PSA 66:11">Nu zokkonkka</para>
  <para style="q2" vid="PSA 66:11">deexo ba7o ba7isadasa.<verse eid="PSA 66:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12" />Nu morkketi</para>
  <para style="q2" vid="PSA 66:12">nuna hu7era duge</para>
  <para style="q2" vid="PSA 66:12">yedhdhana mala ooththadasa;</para>
  <para style="q2" vid="PSA 66:12">nuni haaththa giddoranne</para>
  <para style="q2" vid="PSA 66:12">tama giddora kanththidos;</para>
  <para style="q2" vid="PSA 66:12">gido attiin ha7i nuna</para>
  <para style="q2" vid="PSA 66:12">ishalo soho ehadasa.<verse eid="PSA 66:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13" />Tani xuugettiza yarshora</para>
  <para style="q2" vid="PSA 66:13">ne geeshshasoho gelada</para>
  <para style="q2" vid="PSA 66:13">ta adina nees gaththana.<verse eid="PSA 66:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14" />Tani metotida wode</para>
  <para style="q2" vid="PSA 66:14">ta doonappe ta kessidayssa</para>
  <para style="q2" vid="PSA 66:14">ta inxarsan ta adinettida</para>
  <para style="q2" vid="PSA 66:14">adina ta gaththana.<verse eid="PSA 66:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15" />Tani nees xuugettiza yarshos</para>
  <para style="q2" vid="PSA 66:15">modhdhota shiishshana;</para>
  <para style="q2" vid="PSA 66:15">sawo yarshos dharshota,</para>
  <para style="q2" vid="PSA 66:15">kormatanne</para>
  <para style="q2" vid="PSA 66:15">korbeta shiishshana.<verse eid="PSA 66:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16" />Intteno Xoossas yayyizaytoo!</para>
  <para style="q2" vid="PSA 66:16">Ubbati haa yiidi siyite;</para>
  <para style="q2" vid="PSA 66:16">Xoossi taas ooththidayssa</para>
  <para style="q2" vid="PSA 66:16">tani inttes yootana.<verse eid="PSA 66:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17" />Ta qaala dhoqqu histtada</para>
  <para style="q2" vid="PSA 66:17">tani izakko waassadis;</para>
  <para style="q2" vid="PSA 66:17">ta inxarsankka izas</para>
  <para style="q2" vid="PSA 66:17">galata shiishshadis.<verse eid="PSA 66:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18" />Tani ta wozinan nagara</para>
  <para style="q2" vid="PSA 66:18">genththidaakko,</para>
  <para style="q2" vid="PSA 66:18">Goday ta woosa siyenna.<verse eid="PSA 66:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19" />Gido attiin Xoossi tumappe</para>
  <para style="q2" vid="PSA 66:19">taas siyides;</para>
  <para style="q2" vid="PSA 66:19">ta woosaakka ezgides.<verse eid="PSA 66:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20" />Ta woosa kadhontta,</para>
  <para style="q2" vid="PSA 66:20">ba mernaa siiqo</para>
  <para style="q2" vid="PSA 66:20">taappe haassontta</para>
  <para style="q2" vid="PSA 66:20">Xoossay galatetto.<verse eid="PSA 66:20" /></para>
  <chapter eid="PSA 66" />
  <chapter number="67" style="c" sid="PSA 67" />
  <para style="s1">Zammareta Kaabbos Diiththatan Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 67:1" />Xoossi nuus qadhettonne</para>
  <para style="q2" vid="PSA 67:1">nuna anjjo;</para>
  <para style="q2" vid="PSA 67:1">ba ayfeso nu bolla poo7iso.<verse eid="PSA 67:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2" />Ne ogeti sa7a bollan,</para>
  <para style="q2" vid="PSA 67:2">ashshiza ne wolqqayka</para>
  <para style="q2" vid="PSA 67:2">kawoteththata ubbaa</para>
  <para style="q2" vid="PSA 67:2">giddon erettetto.<verse eid="PSA 67:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 67:3">Asay nena galato;</para>
  <para style="q2" vid="PSA 67:3">kawoteth ubbay</para>
  <para style="q2" vid="PSA 67:3">nees galata shiishsho.<verse eid="PSA 67:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4" />Neni asas suureteththan</para>
  <para style="q2" vid="PSA 67:4">pirdiza gishshas</para>
  <para style="q2" vid="PSA 67:4">sa7a bollaka ne deraa</para>
  <para style="q2" vid="PSA 67:4">kaaleththiza gishshas</para>
  <para style="q2" vid="PSA 67:4">kawoteththati ufayetetto;</para>
  <para style="q2" vid="PSA 67:4">ililishekka nees yexxetto.<verse eid="PSA 67:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 67:5">Asay nena galato;</para>
  <para style="q2" vid="PSA 67:5">kawoteth ubbay</para>
  <para style="q2" vid="PSA 67:5">nees galata shiishsho.<verse eid="PSA 67:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6" />Biittay kath immana;</para>
  <para style="q2" vid="PSA 67:6">Xoossi, nu Xoossay nuna anjjana.<verse eid="PSA 67:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7" />Xoossi nuna anjjana;</para>
  <para style="q2" vid="PSA 67:7">Sa7a gaxa gakkanaas diza asay</para>
  <para style="q2" vid="PSA 67:7">ubbay izas yayyana.<verse eid="PSA 67:7" /></para>
  <chapter eid="PSA 67" />
  <chapter number="68" style="c" sid="PSA 68" />
  <para style="s1">Dawiti Zammareta Kaabbos Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 68:1" />Xoossi dendo;</para>
  <para style="q2" vid="PSA 68:1">iza morkketi laalettetto;</para>
  <para style="q2" vid="PSA 68:1">iza ixxizayti</para>
  <para style="q2" vid="PSA 68:1">iza sinththafe baqatetto.<verse eid="PSA 68:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2" />Cuway carkon laalettiza mala</para>
  <para style="q2" vid="PSA 68:2">neni istta laalla;</para>
  <para style="q2" vid="PSA 68:2">muqaadday taman seeriza mala,</para>
  <para style="q2" vid="PSA 68:2">iitati Xoossa sinththafe</para>
  <para style="q2" vid="PSA 68:2">seeri dhayetto.<verse eid="PSA 68:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3" />Xilloti gidikko ufayetetto;</para>
  <para style="q2" vid="PSA 68:3">Xoossa sinththan</para>
  <para style="q2" vid="PSA 68:3">ufayssan hombocetto;</para>
  <para style="q2" vid="PSA 68:3">qasseka maguletto.<verse eid="PSA 68:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4" />Xoossas yexxite;</para>
  <para style="q2" vid="PSA 68:4">iza sunththas galata mazamure yexxite.</para>
  <para style="q2" vid="PSA 68:4">Shaara bollara<note caller="+" style="f"><char style="fr" closed="false">68:4 </char><char style="ft" closed="false">Shaara bollara gizayssi bazzora geetettana dandayees.</char></note> hemettizayssa</para>
  <para style="q2" vid="PSA 68:4">dhoqqu dhoqqu histtite;</para>
  <para style="q2" vid="PSA 68:4">izas sunththay GODAA;</para>
  <para style="q2" vid="PSA 68:4">intteka iza sinththan</para>
  <para style="q2" vid="PSA 68:4">keehi ufayettite.<verse eid="PSA 68:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5" />Xoossi ba geeshshasohon dishe</para>
  <para style="q2" vid="PSA 68:5">aaway bayndaytas aawa;</para>
  <para style="q2" vid="PSA 68:5">qasse am7etaska pirdiza daanna.<verse eid="PSA 68:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6" />Xoossi barkka diza bizzatas</para>
  <para style="q2" vid="PSA 68:6">soo as immees;</para>
  <para style="q2" vid="PSA 68:6">qasho keeththan dizayta birshidi</para>
  <para style="q2" vid="PSA 68:6">istta ishalon woththees.</para>
  <para style="q2" vid="PSA 68:6">Makkallanchchati gidikko</para>
  <para style="q2" vid="PSA 68:6">suulliza bazzon de7ana.<verse eid="PSA 68:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 68:7">Neni ne asa kaaleththida wode,</para>
  <para style="q2" vid="PSA 68:7">neni isttara bazzo</para>
  <para style="q2" vid="PSA 68:7">kanththida wode,<verse eid="PSA 68:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8" />Siina Xoossa sinththan,</para>
  <para style="q2" vid="PSA 68:8">Isra7eele Xoossa sinththan</para>
  <para style="q2" vid="PSA 68:8">biittay qaaxxides;</para>
  <para style="q2" vid="PSA 68:8">saloti ira duge tigida.<note caller="-" style="x"><char style="xo" closed="false">68:8 </char><char style="xt" closed="false"><ref loc="EXO 19:18">Kessa 19:18</ref></char></note><verse eid="PSA 68:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 68:9">Neni koshshiza keena</para>
  <para style="q2" vid="PSA 68:9">ira immadasa;</para>
  <para style="q2" vid="PSA 68:9">ladda biittaaka araddisadasa.<verse eid="PSA 68:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10" />Ne derezikka izo</para>
  <para style="q2" vid="PSA 68:10">baas duussaso histtida;</para>
  <para style="q2" vid="PSA 68:10">abeet Xoossawu!</para>
  <para style="q2" vid="PSA 68:10">Manqotas koshshizaaz</para>
  <para style="q2" vid="PSA 68:10">neni kiyateththan immadasa.<verse eid="PSA 68:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11" />Goday qaala yeddides;</para>
  <para style="q2" vid="PSA 68:11">he kiitaa daro maccassati</para>
  <para style="q2" vid="PSA 68:11">deraas awajjida.<verse eid="PSA 68:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12" />Istti, «Kawoti ba olanchchatara</para>
  <para style="q2" vid="PSA 68:12">di7o gishetti ekkida.<verse eid="PSA 68:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13" />Dorsata naaganaas guyen attidayti</para>
  <para style="q2" vid="PSA 68:13">birappe oosettida qefeti bollara</para>
  <para style="q2" vid="PSA 68:13">xolqiza worqqan</para>
  <para style="q2" vid="PSA 68:13">tiyettida haraphphe</para>
  <para style="q2" vid="PSA 68:13">misle demmida» gida.<verse eid="PSA 68:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14" />Ubbaa Dandayza Xoossay</para>
  <para style="q2" vid="PSA 68:14">kawota laallida wode,</para>
  <para style="q2" vid="PSA 68:14">Xalmoone Zuma bolla</para>
  <para style="q2" vid="PSA 68:14">shach bukisides.<verse eid="PSA 68:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15" />Baasaane zumati</para>
  <para style="q2" vid="PSA 68:15">wogga gita zumata;</para>
  <para style="q2" vid="PSA 68:15">Baasaane zumata bolla</para>
  <para style="q2" vid="PSA 68:15">daro poggonoti<note caller="+" style="f"><char style="fr" closed="false">68:15 </char><char style="fqa" closed="false">Poggonoti: </char><char style="ft" closed="false">Poggonoti gizayssi amaraththo qaalan gubbita gizayssa bessees; nu qaalan iza birsheththas ziqqi dhoqqu giidi sansalata mala oykettidi biza zuma xeerata bessees.</char></note> deettes.<verse eid="PSA 68:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16" />Daro poggonoti de7iza zumatoo!</para>
  <para style="q2" vid="PSA 68:16">Xoossi daanaas doorida zumaza</para>
  <para style="q2" vid="PSA 68:16">intte ays miqqaynen xeelleetii?</para>
  <para style="q2" vid="PSA 68:16">GODAY izan mernaas de7ana.<verse eid="PSA 68:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17" />Xoossa para-gaareti</para>
  <para style="q2" vid="PSA 68:17">daro shiyan qoodettizayta;</para>
  <para style="q2" vid="PSA 68:17">Goday Siina zumaappe</para>
  <para style="q2" vid="PSA 68:17">ba geeshshasoho yides.<verse eid="PSA 68:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18" />GODAWU! Di7o ekkada</para>
  <para style="q2" vid="PSA 68:18">pude ne duussas kezadasa;</para>
  <para style="q2" vid="PSA 68:18">asa ubbaafe imota ekkadasa;</para>
  <para style="q2" vid="PSA 68:18">haray attoshin</para>
  <para style="q2" vid="PSA 68:18">makkallanchchatappeka</para>
  <para style="q2" vid="PSA 68:18">ekkadasa;<note caller="-" style="x"><char style="xo" closed="false">68:18 </char><char style="xt" closed="false"><ref loc="EPH 4:8">Efe 4:8</ref></char></note><verse eid="PSA 68:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19" />Hach hach nu tooho</para>
  <para style="q2" vid="PSA 68:19">tookkiza Goday,</para>
  <para style="q2" vid="PSA 68:19">nuna ashshiza</para>
  <para style="q2" vid="PSA 68:19">nu Xoossay galatetto.<verse eid="PSA 68:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20" />Be7ite! Nu Xoossi ashshiza Xoossa!</para>
  <para style="q2" vid="PSA 68:20">Hayqoppe attana dandayettizay</para>
  <para style="q2" vid="PSA 68:20">GODAY ashshiina.<verse eid="PSA 68:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21" />Xoossi tumappe ba morkketa</para>
  <para style="q2" vid="PSA 68:21">hu7e kinchchana;</para>
  <para style="q2" vid="PSA 68:21">nagara ogen hemettiza</para>
  <para style="q2" vid="PSA 68:21">goofaranchchata</para>
  <para style="q2" vid="PSA 68:21">hu7e qoo7ereththana.<verse eid="PSA 68:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22" />Goday, «Tani intte morkketa</para>
  <para style="q2" vid="PSA 68:22">Baasaaneppe zaarada ehana;</para>
  <para style="q2" vid="PSA 68:22">tani istta ciimma abba giddofe</para>
  <para style="q2" vid="PSA 68:22">kessada guye zaarana.<verse eid="PSA 68:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23" />Neni ne morkketa suuth</para>
  <para style="q2" vid="PSA 68:23">yedhdha aadhdhana;</para>
  <para style="q2" vid="PSA 68:23">ne kanatikka morkketa suuththafe</para>
  <para style="q2" vid="PSA 68:23">bantta gisha laaccana» gides.<verse eid="PSA 68:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 68:24">Ne xoono cifray ubbaan beettees;</para>
  <para style="q2" vid="PSA 68:24">ta Xoossanne ta kawoy azhaban</para>
  <para style="q2" vid="PSA 68:24">ba geeshsha soo</para>
  <para style="q2" vid="PSA 68:24">gelththishe qonccees.<verse eid="PSA 68:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25" />Yexxizayti sinththan,</para>
  <para style="q2" vid="PSA 68:25">qasse karabe baqqiza</para>
  <para style="q2" vid="PSA 68:25">geela7oti giddon,</para>
  <para style="q2" vid="PSA 68:25">diixxizayti guyen</para>
  <para style="q2" vid="PSA 68:25">azhabi beetteettes.<verse eid="PSA 68:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26" />Istti, «Xoossaa kumeththa</para>
  <para style="q2" vid="PSA 68:26">shiiqon galatite;</para>
  <para style="q2" vid="PSA 68:26">intteno Isra7eele zereththato</para>
  <para style="q2" vid="PSA 68:26">GODAA galatite» geettes.<verse eid="PSA 68:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27" />He cifran ubbaafe kaalotiza</para>
  <para style="q2" vid="PSA 68:27">Biniyaame zareti kaaleththeettes.</para>
  <para style="q2" vid="PSA 68:27">Kaallidi Yuhuda daannati</para>
  <para style="q2" vid="PSA 68:27">bantta butten butten beettes;</para>
  <para style="q2" vid="PSA 68:27">wurseththan Zaabiloone</para>
  <para style="q2" vid="PSA 68:27">daannatinne</para>
  <para style="q2" vid="PSA 68:27">Niftaaleme daannati kaalleettes.<verse eid="PSA 68:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 68:28">Ne wolqqa qonccisa.</para>
  <para style="q2" vid="PSA 68:28">Hayssafe kase ne nuus</para>
  <para style="q2" vid="PSA 68:28">ooththidayssaththo</para>
  <para style="q2" vid="PSA 68:28">ha7ikka ne minoteth nuna bessa.<verse eid="PSA 68:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29" />Yerusalaamen diza</para>
  <para style="q2" vid="PSA 68:29">ne Keeththa gishshas</para>
  <para style="q2" vid="PSA 68:29">kawoti imota</para>
  <para style="q2" vid="PSA 68:29">nees ekki yaana.<verse eid="PSA 68:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30" />Maqqa giddon diza do7ata<note caller="+" style="f"><char style="fr" closed="false">68:30 </char><char style="ft" closed="false">Maqqa giddon diza do7ata gizayssi Gibxe bessees.</char></note></para>
  <para style="q2" vid="PSA 68:30">neni seera.</para>
  <para style="q2" vid="PSA 68:30">Booratanne marata</para>
  <para style="q2" vid="PSA 68:30">wude misatiza</para>
  <para style="q2" vid="PSA 68:30">kawota neni laalla;</para>
  <para style="q2" vid="PSA 68:30">istti gulbatidi bantta bira</para>
  <para style="q2" vid="PSA 68:30">nees giirana mala ooththa;</para>
  <para style="q2" vid="PSA 68:30">olettanaas yeemottiza</para>
  <para style="q2" vid="PSA 68:30">asata laalla.<verse eid="PSA 68:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31" />Gita asati Gibxeppe yaana;</para>
  <para style="q2" vid="PSA 68:31">Tophphiyay ba kushe</para>
  <para style="q2" vid="PSA 68:31">Xoossako miccana.<verse eid="PSA 68:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32" />Intteno sa7a kawoteththatoo!</para>
  <para style="q2" vid="PSA 68:32">Xoossas yexxite;</para>
  <para style="q2" vid="PSA 68:32">Godaas galata mazamure shiishshite.<verse eid="PSA 68:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33" />Beniisoppe doommidi diza</para>
  <para style="q2" vid="PSA 68:33">salotappe bollara</para>
  <para style="q2" vid="PSA 68:33">bizayssas yexxite;</para>
  <para style="q2" vid="PSA 68:33">izi ba wolqqama cenggurssa</para>
  <para style="q2" vid="PSA 68:33">guunththan yootishin ezgi siyite.<verse eid="PSA 68:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34" />Iza teemay Isra7eele bollana;</para>
  <para style="q2" vid="PSA 68:34">iza wolqqayka salonna.</para>
  <para style="q2" vid="PSA 68:34">Hessa gishshas</para>
  <para style="q2" vid="PSA 68:34">Xoossa wolqqa awajjite.<verse eid="PSA 68:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 68:35">Neni ne keeththafe</para>
  <para style="q2" vid="PSA 68:35">qonccashe malalisaasa;</para>
  <para style="q2" vid="PSA 68:35">Isra7eele Xoossay</para>
  <para style="q2" vid="PSA 68:35">ba deraas minoteththinne</para>
  <para style="q2" vid="PSA 68:35">wolqqa immees.</para>
  <para style="q2" vid="PSA 68:35">Xoossi galatetto.<verse eid="PSA 68:35" /></para>
  <chapter eid="PSA 68" />
  <chapter number="69" style="c" sid="PSA 69" />
  <para style="s1">Dawiti Zammareta Kaabbos Ciishshata Giigiso Geetettiza Waaxan Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 69:1" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 69:1">Haaththa kixay taas</para>
  <para style="q2" vid="PSA 69:1">qoodhe gakkida gishshas</para>
  <para style="q2" vid="PSA 69:1">ne tana ashsha.<verse eid="PSA 69:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2" />Tohoy eqqizasoy baynda</para>
  <para style="q2" vid="PSA 69:2">caren mitettadis;</para>
  <para style="q2" vid="PSA 69:2">ciimma haaththa giddo geladis;</para>
  <para style="q2" vid="PSA 69:2">haaththa dambalay</para>
  <para style="q2" vid="PSA 69:2">tana mittana hanees.<verse eid="PSA 69:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3" />Tani maado demmanaas</para>
  <para style="q2" vid="PSA 69:3">waassashe daaburadis;</para>
  <para style="q2" vid="PSA 69:3">taas qoodhe poorandeyka</para>
  <para style="q2" vid="PSA 69:3">melides.</para>
  <para style="q2" vid="PSA 69:3">Ta Xoossa naagon dishin</para>
  <para style="q2" vid="PSA 69:3">ta ayfey baljumides.<verse eid="PSA 69:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4" />Tana mela coo ixxizayti</para>
  <para style="q2" vid="PSA 69:4">ta hu7e binanappe daro.</para>
  <para style="q2" vid="PSA 69:4">Wordora tana morkkizaytinne</para>
  <para style="q2" vid="PSA 69:4">tana dhayssanawu</para>
  <para style="q2" vid="PSA 69:4">koyzayti darida.</para>
  <para style="q2" vid="PSA 69:4">Ta kaysa ekkontta miish</para>
  <para style="q2" vid="PSA 69:4">tana qanxxa gida.<note caller="-" style="x"><char style="xo" closed="false">69:4 </char><char style="xt" closed="false"><ref loc="PSA 35:19">Maza 35:19</ref>; <ref loc="JHN 15:25">Yoha 15:25</ref></char></note><verse eid="PSA 69:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 69:5">Ta eeyateththa neni eraasa;</para>
  <para style="q2" vid="PSA 69:5">ta ooththida nagaray</para>
  <para style="q2" vid="PSA 69:5">neeppe qotettibeenna.<verse eid="PSA 69:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6" />Abeet Godawu,</para>
  <para style="q2" vid="PSA 69:6">Ubbaafe Wolqqama GODAWU!</para>
  <para style="q2" vid="PSA 69:6">Nena hidota ooththidayti</para>
  <para style="q2" vid="PSA 69:6">yeellatopetto;</para>
  <para style="q2" vid="PSA 69:6">Abeet Isra7eele Xoossawu!</para>
  <para style="q2" vid="PSA 69:6">Nena minththi koyzayti</para>
  <para style="q2" vid="PSA 69:6">ta gaason kawuyofetto.<verse eid="PSA 69:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7" />Tani cash ne gishshas</para>
  <para style="q2" vid="PSA 69:7">gaada dandayadis;</para>
  <para style="q2" vid="PSA 69:7">ta ayfesoy yeellatides.<verse eid="PSA 69:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8" />Tani ta ishanttas imath,</para>
  <para style="q2" vid="PSA 69:8">qasse ta aayey naytas</para>
  <para style="q2" vid="PSA 69:8">allaga gidadis.<verse eid="PSA 69:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9" />Tani ne keeththas</para>
  <para style="q2" vid="PSA 69:9">mishettiza mishoy</para>
  <para style="q2" vid="PSA 69:9">tana tama mala xuuggees;</para>
  <para style="q2" vid="PSA 69:9">Asay nena cayida cashshay</para>
  <para style="q2" vid="PSA 69:9">tana gakkides.<note caller="-" style="x"><char style="xo" closed="false">69:9 </char><char style="xt" closed="false"><ref loc="JHN 2:7">Yoha 2:7</ref>; <ref loc="ROM 15:3">Oro 15:3</ref></char></note><verse eid="PSA 69:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10" />Ta xoomashe yeekkadis;</para>
  <para style="q2" vid="PSA 69:10">hessankka ta qidhettadis.<verse eid="PSA 69:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11" />Tani kayo may7o may7adis;</para>
  <para style="q2" vid="PSA 69:11">isttaskka tani tosses<note caller="+" style="f"><char style="fr" closed="false">69:11 </char><char style="fqa" closed="false">Tosse: </char><char style="ft" closed="false">Tosse geetettiza qaalazi leqos, qidhes, hessa hessa malas go7ees</char></note> attadis.<verse eid="PSA 69:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12" />Tani katama geliza pengen</para>
  <para style="q2" vid="PSA 69:12">uttizaytas zigirsas attadis;</para>
  <para style="q2" vid="PSA 69:12">maththottizaytas</para>
  <para style="q2" vid="PSA 69:12">yeththas gidadis.<verse eid="PSA 69:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 69:13">Tani gidikko nena woossays.</para>
  <para style="q2" vid="PSA 69:13">Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 69:13">Ne doorida wode</para>
  <para style="q2" vid="PSA 69:13">ta woosa siya;</para>
  <para style="q2" vid="PSA 69:13">ne mernaa siiqon</para>
  <para style="q2" vid="PSA 69:13">ne ashshiza ashoza tana bessa.<verse eid="PSA 69:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14" />Caren mitettontta mala</para>
  <para style="q2" vid="PSA 69:14">tana ashsha.</para>
  <para style="q2" vid="PSA 69:14">Tana ixxizaytappe tana naaga;</para>
  <para style="q2" vid="PSA 69:14">ciimma haaththafekka tana ashsha.<verse eid="PSA 69:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15" />Di7o haaththi tana efoppo;</para>
  <para style="q2" vid="PSA 69:15">ciimma abbay tana mittofo;</para>
  <para style="q2" vid="PSA 69:15">ciimma ollay ta bolla woddofo.<verse eid="PSA 69:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 69:16">Ne mernaa siiqo kiyateththa mala</para>
  <para style="q2" vid="PSA 69:16">taas zaaro imma;</para>
  <para style="q2" vid="PSA 69:16">Ne qadheta daron taakko simma.<verse eid="PSA 69:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17" />Taappe ne ayllezappe</para>
  <para style="q2" vid="PSA 69:17">ne sinththa genththofa;</para>
  <para style="q2" vid="PSA 69:17">tani waayettiza gishshas</para>
  <para style="q2" vid="PSA 69:17">taas eeson zaaro imma.<verse eid="PSA 69:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18" />Neni taakko shiiqada tana wozza;</para>
  <para style="q2" vid="PSA 69:18">ta morkketappekka</para>
  <para style="q2" vid="PSA 69:18">tana kessa la7a yedda.<verse eid="PSA 69:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19" />Ta bolla gakkida cashsha, yeellateththaanne</para>
  <para style="q2" vid="PSA 69:19">kawushshateththaa ne eraasa;</para>
  <para style="q2" vid="PSA 69:19">ta morkketakka hu7en hu7en</para>
  <para style="q2" vid="PSA 69:19">ne demmaasa.<verse eid="PSA 69:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20" />Cashshi ta wozina madunththiin</para>
  <para style="q2" vid="PSA 69:20">ta hidota qanxxadis.</para>
  <para style="q2" vid="PSA 69:20">Taas qadhettiza as koyadis;</para>
  <para style="q2" vid="PSA 69:20">gido attiin issi asikka deenna.</para>
  <para style="q2" vid="PSA 69:20">Tana minththeththiza as koyadis;</para>
  <para style="q2" vid="PSA 69:20">gido attiin issaadeka</para>
  <para style="q2" vid="PSA 69:20">demmabeekke.<verse eid="PSA 69:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21" />Tani gafida wode</para>
  <para style="q2" vid="PSA 69:21">taas cammiza kath immida.</para>
  <para style="q2" vid="PSA 69:21">Tani saamettida wode</para>
  <para style="q2" vid="PSA 69:21">taas caala phanqida</para>
  <para style="q2" vid="PSA 69:21">ushshu immida.<note caller="-" style="x"><char style="xo" closed="false">69:21 </char><char style="xt" closed="false"><ref loc="MAT 27:48">Mato 27:48</ref>; <ref loc="MRK 15:36">Mar 15:36</ref>; <ref loc="LUK 23:36">Luqa 23:36</ref>; <ref loc="JHN 19:28-29">Yoha 19:28-29</ref></char></note><verse eid="PSA 69:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22" />Istti miza maadday</para>
  <para style="q2" vid="PSA 69:22">isttas woximade gido.</para>
  <para style="q2" vid="PSA 69:22">Istti yarsho yarshidi</para>
  <para style="q2" vid="PSA 69:22">miza maadday isttas gite gido.<verse eid="PSA 69:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23" />Xeellontta mala</para>
  <para style="q2" vid="PSA 69:23">istta ayfey goozetto;</para>
  <para style="q2" vid="PSA 69:23">istta zokkoy quunni atto.<note caller="-" style="x"><char style="xo" closed="false">69:22-23 </char><char style="xt" closed="false"><ref loc="ROM 11:9-10">Oro 11:9-10</ref></char></note><verse eid="PSA 69:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24" />Neni ne hanqoza istta bolla gussa;</para>
  <para style="q2" vid="PSA 69:24">istti qoppontta dishin</para>
  <para style="q2" vid="PSA 69:24">ne boshay istta bolla gakko.<verse eid="PSA 69:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25" />Istta duussasoy kays gido;</para>
  <para style="q2" vid="PSA 69:25">istta dunkaanen oonikka dooppo.<note caller="-" style="x"><char style="xo" closed="false">69:25 </char><char style="xt" closed="false"><ref loc="ACT 1:20">Hawa 1:20</ref></char></note><verse eid="PSA 69:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26" />Ays giikko neni qaxxaydayta</para>
  <para style="q2" vid="PSA 69:26">istti yedeththeettes;</para>
  <para style="q2" vid="PSA 69:26">qasse neni madunththida</para>
  <para style="q2" vid="PSA 69:26">asata bolla</para>
  <para style="q2" vid="PSA 69:26">meto darseettes.<verse eid="PSA 69:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27" />Istti nagara bolla nagara</para>
  <para style="q2" vid="PSA 69:27">gujji gujji baana mala aggaaga;</para>
  <para style="q2" vid="PSA 69:27">ne istta maaroppa.<verse eid="PSA 69:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28" />Istti de7o maxaafappe qucettetto;</para>
  <para style="q2" vid="PSA 69:28">xillotara issife mazgabettofetto.<note caller="-" style="x"><char style="xo" closed="false">69:28 </char><char style="xt" closed="false"><ref loc="EXO 32:32">Kessa 32:32</ref>; <ref loc="REV 3:5">Ajju 3:5</ref>; <ref loc="REV 13:8">13:8</ref>; <ref loc="REV 17:8">17:8</ref></char></note><verse eid="PSA 69:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29" />Gido attiin tani sakettashenne</para>
  <para style="q2" vid="PSA 69:29">waayettashe de7ays.</para>
  <para style="q2" vid="PSA 69:29">Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 69:29">Ne tana ashshadanne naaga.<verse eid="PSA 69:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30" />Tani Xoossa sunththa</para>
  <para style="q2" vid="PSA 69:30">yeththan galatana;</para>
  <para style="q2" vid="PSA 69:30">galata yeththan</para>
  <para style="q2" vid="PSA 69:30">iza gitateththaa qonccisana.<verse eid="PSA 69:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31" />Hayssi sangettontta boorappenne</para>
  <para style="q2" vid="PSA 69:31">korma yarshofe</para>
  <para style="q2" vid="PSA 69:31">aadhdhidi GODAA ufayssana.<verse eid="PSA 69:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32" />Qohettidayti tana</para>
  <para style="q2" vid="PSA 69:32">Xoossay ashshidayssa</para>
  <para style="q2" vid="PSA 69:32">be7idi ufayetetto.</para>
  <para style="q2" vid="PSA 69:32">Intteno Xoossako shiiqizayto</para>
  <para style="q2" vid="PSA 69:32">intte wozinay minetto.<verse eid="PSA 69:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33" />Ays giikko GODAY hiyeesata siyees;</para>
  <para style="q2" vid="PSA 69:33">qasho keeththan de7iza</para>
  <para style="q2" vid="PSA 69:33">ba asaakka kadhenna.<verse eid="PSA 69:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34" />Saloynne sa7ay,</para>
  <para style="q2" vid="PSA 69:34">abbaynne iza giddon</para>
  <para style="q2" vid="PSA 69:34">woxxi qaaxxiza ubbati</para>
  <para style="q2" vid="PSA 69:34">Xoossaa galatetto.<verse eid="PSA 69:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35" />Gaasoykka Xoossi</para>
  <para style="q2" vid="PSA 69:35">Xiyoone ashshana;</para>
  <para style="q2" vid="PSA 69:35">Yuhuda katamata zaaridi essana.</para>
  <para style="q2" vid="PSA 69:35">Iza derey he biitta laattidi</para>
  <para style="q2" vid="PSA 69:35">heen de7ana.<verse eid="PSA 69:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 69:36" />Iza oosanchchata zarey</para>
  <para style="q2" vid="PSA 69:36">he biitta laattana;</para>
  <para style="q2" vid="PSA 69:36">iza sunththa siiqizayti</para>
  <para style="q2" vid="PSA 69:36">heen de7ana.<verse eid="PSA 69:36" /></para>
  <chapter eid="PSA 69" />
  <chapter number="70" style="c" sid="PSA 70" />
  <para style="s1">Zammareta Kaabbos Dawiti Yexxida Hassa7iso Mazamure</para>
  <para style="r">(<ref loc="PSA 40:13-17">Maza 40:13-17</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 70:1">Tana ashshanawu</para>
  <para style="q2" vid="PSA 70:1">taakko haa simma;</para>
  <para style="q2" vid="PSA 70:1">abeet GODAWU!</para>
  <para style="q2" vid="PSA 70:1">Tana maaddanawu eesota.<verse eid="PSA 70:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2" />Tana wodhanawu koyzayti</para>
  <para style="q2" vid="PSA 70:2">yeellatettonne shirotetto;</para>
  <para style="q2" vid="PSA 70:2">Tani qohettanayssa amottizayti,</para>
  <para style="q2" vid="PSA 70:2">kawuyidi guye simmetto.<verse eid="PSA 70:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3" />Ta bolla, «Izas hashshu! Hashshu!»</para>
  <para style="q2" vid="PSA 70:3">gidayti yeellatidi guye simmetto.<verse eid="PSA 70:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4" />Gido attiin nena koyza ubbati</para>
  <para style="q2" vid="PSA 70:4">nenan ufayetettonne</para>
  <para style="q2" vid="PSA 70:4">hashshu getto;</para>
  <para style="q2" vid="PSA 70:4">qasse ne atoteththaa</para>
  <para style="q2" vid="PSA 70:4">dosiza ubbati,</para>
  <para style="q2" vid="PSA 70:4">«Xoossi dhoqqu dhoqqu</para>
  <para style="q2" vid="PSA 70:4">go!» getto.<verse eid="PSA 70:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5" />Tani hiyeesanne metotanchcha;</para>
  <para style="q2" vid="PSA 70:5">abeet Xoossawu!</para>
  <para style="q2" vid="PSA 70:5">Eeson taakko gakka.</para>
  <para style="q2" vid="PSA 70:5">Tana maaddizaynne</para>
  <para style="q2" vid="PSA 70:5">ashshizay nena;</para>
  <para style="q2" vid="PSA 70:5">abeet GODAWU! gam7ofa.<verse eid="PSA 70:5" /></para>
  <chapter eid="PSA 70" />
  <chapter number="71" style="c" sid="PSA 71" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 71:1">Neni taas ta baqata attizaso;</para>
  <para style="q2" vid="PSA 71:1">mulekka ne tana yeellasoppa.<verse eid="PSA 71:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2" />Ne xilloteththan tana kessa ekka;</para>
  <para style="q2" vid="PSA 71:2">ne hayththa taakko yeggada</para>
  <para style="q2" vid="PSA 71:2">tana ashsha.<verse eid="PSA 71:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3" />Ne taas ubba wode</para>
  <para style="q2" vid="PSA 71:3">geemetta attiza</para>
  <para style="q2" vid="PSA 71:3">mino zaalla gida;</para>
  <para style="q2" vid="PSA 71:3">tana ashshanaas ne azaza;</para>
  <para style="q2" vid="PSA 71:3">taas mino miixaynne</para>
  <para style="q2" vid="PSA 71:3">zaallay nena.<verse eid="PSA 71:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4" />Abeet ta Xoossawu!</para>
  <para style="q2" vid="PSA 71:4">Iitata kusheppe,</para>
  <para style="q2" vid="PSA 71:4">genanchchatappenne</para>
  <para style="q2" vid="PSA 71:4">menxe iitatappe</para>
  <para style="q2" vid="PSA 71:4">tana ashsha.<verse eid="PSA 71:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5" />Abeet Ubbaa Haariza GODAWU!</para>
  <para style="q2" vid="PSA 71:5">Ta hidotay nena;</para>
  <para style="q2" vid="PSA 71:5">yelagateththa wodeppe</para>
  <para style="q2" vid="PSA 71:5">doommada</para>
  <para style="q2" vid="PSA 71:5">ta ammanettizay nena.<verse eid="PSA 71:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6" />Tani yelettoosofe doommada</para>
  <para style="q2" vid="PSA 71:6">ta nenan zemppadis;</para>
  <para style="q2" vid="PSA 71:6">ta aayey uloppe ta yelettana mala</para>
  <para style="q2" vid="PSA 71:6">ooththiday nena;</para>
  <para style="q2" vid="PSA 71:6">ubba wode ta nena galatays.<verse eid="PSA 71:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7" />Daro asay tana</para>
  <para style="q2" vid="PSA 71:7">dumma ayfen xeellides;</para>
  <para style="q2" vid="PSA 71:7">neni gidikko ta baqata attiza</para>
  <para style="q2" vid="PSA 71:7">wogga zaalla.<verse eid="PSA 71:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8" />Gallas kumeth ne bonchcho</para>
  <para style="q2" vid="PSA 71:8">ta yootanaas,</para>
  <para style="q2" vid="PSA 71:8">ta doonan galatay kumides.<verse eid="PSA 71:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9" />Tani cimmida woden tana oloppa;</para>
  <para style="q2" vid="PSA 71:9">ta wolqqay ixxida woden</para>
  <para style="q2" vid="PSA 71:9">tana aggofa.<verse eid="PSA 71:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10" />Ays giikko ta morkketi</para>
  <para style="q2" vid="PSA 71:10">tana hilida;</para>
  <para style="q2" vid="PSA 71:10">tana wodhanawu koyzayti</para>
  <para style="q2" vid="PSA 71:10">ta bolla iita maqettida.<verse eid="PSA 71:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11" />Istti, «Xoossi iza aggides;</para>
  <para style="q2" vid="PSA 71:11">iza ashshanaykka deenna;</para>
  <para style="q2" vid="PSA 71:11">hessa gishshas ane iza</para>
  <para style="q2" vid="PSA 71:11">gooddi oykkoos» gida.<verse eid="PSA 71:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12" />Abeet Xoossawu! Taappe haakkofa.</para>
  <para style="q2" vid="PSA 71:12">Abeet ta Xoossawu!</para>
  <para style="q2" vid="PSA 71:12">Tana maaddanaas elela.<verse eid="PSA 71:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13" />Tana mootizayti yeellatidi dhayetto.</para>
  <para style="q2" vid="PSA 71:13">Tana qohanawu koyzayti</para>
  <para style="q2" vid="PSA 71:13">yeellanne kawushshateth</para>
  <para style="q2" vid="PSA 71:13">may7etto.<verse eid="PSA 71:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14" />Tani gidikko ubbato nena</para>
  <para style="q2" vid="PSA 71:14">hidota ooththays.</para>
  <para style="q2" vid="PSA 71:14">Tani galata bolla galata</para>
  <para style="q2" vid="PSA 71:14">nees gujjana.<verse eid="PSA 71:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15" />Tani ay likke haasayanaakko</para>
  <para style="q2" vid="PSA 71:15">erontta aggikokka</para>
  <para style="q2" vid="PSA 71:15">gallas kumeth ta doonay</para>
  <para style="q2" vid="PSA 71:15">ne xilloteththa gishshassinne</para>
  <para style="q2" vid="PSA 71:15">ne atoteththa gishshas haasayees;<verse eid="PSA 71:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16" />Abeet Godawu, Xoossawu!</para>
  <para style="q2" vid="PSA 71:16">Tani yaada ne wolqqama</para>
  <para style="q2" vid="PSA 71:16">ooso awajjana;</para>
  <para style="q2" vid="PSA 71:16">qasseka ne xilloteththaa xalla</para>
  <para style="q2" vid="PSA 71:16">yootana.<verse eid="PSA 71:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 71:17">Neni tana yelagateththafe</para>
  <para style="q2" vid="PSA 71:17">doommada tamaarsadasa;</para>
  <para style="q2" vid="PSA 71:17">tanikka hanno gakkanawu</para>
  <para style="q2" vid="PSA 71:17">malalisiza</para>
  <para style="q2" vid="PSA 71:17">ne oosoza awajjays.<verse eid="PSA 71:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 71:18">Ne maataa guyeppe</para>
  <para style="q2" vid="PSA 71:18">yaana yeletas,</para>
  <para style="q2" vid="PSA 71:18">ne wolqqa guyeppe yaana dere ubbaas,</para>
  <para style="q2" vid="PSA 71:18">ta qonccisana gakkanaassinne</para>
  <para style="q2" vid="PSA 71:18">ta cimada puulumana gakkanaas</para>
  <para style="q2" vid="PSA 71:18">ne tana aggofa.<verse eid="PSA 71:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 71:19">Ne xilloteththay salo gakkides;</para>
  <para style="q2" vid="PSA 71:19">Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 71:19">Neni gita miish ooththadasa;</para>
  <para style="q2" vid="PSA 71:19">nena misatizay oonikka deenna.<verse eid="PSA 71:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20" />Neni ta bolla daro meto ehadasa;</para>
  <para style="q2" vid="PSA 71:20">gidikkoka neni tana</para>
  <para style="q2" vid="PSA 71:20">ciimma ollafe</para>
  <para style="q2" vid="PSA 71:20">goochcha kessadasa;</para>
  <para style="q2" vid="PSA 71:20">ta de7o zaara ooraththadasa.<verse eid="PSA 71:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21" />Neni ta bonchcho</para>
  <para style="q2" vid="PSA 71:21">kaseyssafe darsana;</para>
  <para style="q2" vid="PSA 71:21">neni tana zaareththadakka</para>
  <para style="q2" vid="PSA 71:21">minththeththana.<verse eid="PSA 71:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22" />Abeet ta Xoossawu!</para>
  <para style="q2" vid="PSA 71:22">Ne tumateththa gishshas</para>
  <para style="q2" vid="PSA 71:22">tani nena diiththan galatana;</para>
  <para style="q2" vid="PSA 71:22">abeet Isra7eele Geeshshawu!</para>
  <para style="q2" vid="PSA 71:22">Tani maasinqon nena sabbana.<verse eid="PSA 71:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23" />Ta wozinay ufayssan kumidi</para>
  <para style="q2" vid="PSA 71:23">nees yexxiza wode,</para>
  <para style="q2" vid="PSA 71:23">neni wozzida ta shemppoya</para>
  <para style="q2" vid="PSA 71:23">nees ililawus.<verse eid="PSA 71:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24" />Ta inxarsay</para>
  <para style="q2" vid="PSA 71:24">ne xilloteththa gishshas</para>
  <para style="q2" vid="PSA 71:24">gallas kumeth haasayees;</para>
  <para style="q2" vid="PSA 71:24">ta qoheteth koyzayti</para>
  <para style="q2" vid="PSA 71:24">yeellatidanne kawuyida.<verse eid="PSA 71:24" /></para>
  <chapter eid="PSA 71" />
  <chapter number="72" style="c" sid="PSA 72" />
  <para style="s1">Solomoone Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 72:1">Suure pirda kawos,</para>
  <para style="q2" vid="PSA 72:1">ne xilloteththaka</para>
  <para style="q2" vid="PSA 72:1">kawo naas imma.<verse eid="PSA 72:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2" />Histtiko izi ne deraas</para>
  <para style="q2" vid="PSA 72:2">xilloteththan pirdana;</para>
  <para style="q2" vid="PSA 72:2">naaqettidaytasikka</para>
  <para style="q2" vid="PSA 72:2">suure pirdana.<verse eid="PSA 72:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3" />Zumati dureteth ehana;</para>
  <para style="q2" vid="PSA 72:3">zumbullatikka xilloteth</para>
  <para style="q2" vid="PSA 72:3">ne deraas ehana.<verse eid="PSA 72:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4" />Metotidayta gishshas</para>
  <para style="q2" vid="PSA 72:4">izi mootettana;</para>
  <para style="q2" vid="PSA 72:4">hiyeesata izi ashshana;</para>
  <para style="q2" vid="PSA 72:4">un7eththizayssaka izi liiqisana.<verse eid="PSA 72:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5" />Awaynne aginay</para>
  <para style="q2" vid="PSA 72:5">diza wode ubbaan</para>
  <para style="q2" vid="PSA 72:5">yeletappe yeleta gakkanawu</para>
  <para style="q2" vid="PSA 72:5">asay izas haaretto.<verse eid="PSA 72:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6" />Kawoy shooqan bukkiza</para>
  <para style="q2" vid="PSA 72:6">ira malanne gade kalssiza</para>
  <para style="q2" vid="PSA 72:6">puuse ira mala gidana.<verse eid="PSA 72:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7" />Izi diza layth ubbaan</para>
  <para style="q2" vid="PSA 72:7">xilloy ciiyana;</para>
  <para style="q2" vid="PSA 72:7">aginay dhayana gakkanaas</para>
  <para style="q2" vid="PSA 72:7">biitta bolla saroteththi darana.<verse eid="PSA 72:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8" />Abbafe biidi abba gakkanaas,</para>
  <para style="q2" vid="PSA 72:8">Efiraaxise Shaafaappe</para>
  <para style="q2" vid="PSA 72:8">sa7a gaxa gakkanaas</para>
  <para style="q2" vid="PSA 72:8">izi haarana.<note caller="-" style="x"><char style="xo" closed="false">72:8 </char><char style="xt" closed="false"><ref loc="ZEC 9:10">Zaka 9:10</ref></char></note><verse eid="PSA 72:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9" />Bazzon mehe xalla haari aqizayti,</para>
  <para style="q2" vid="PSA 72:9">iza morkketi gudulla laaccana.<verse eid="PSA 72:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10" />Tarseese kawotinne</para>
  <para style="q2" vid="PSA 72:10">harurota kawoti</para>
  <para style="q2" vid="PSA 72:10">izas giira ehana.</para>
  <para style="q2" vid="PSA 72:10">Saabanne Saaba kawoti</para>
  <para style="q2" vid="PSA 72:10">izas kushe genththo ehana.<verse eid="PSA 72:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11" />Kawoti ubbay izas gulbatana;</para>
  <para style="q2" vid="PSA 72:11">kawoteththay ubbay</para>
  <para style="q2" vid="PSA 72:11">izas haarettana.<verse eid="PSA 72:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12" />Metotanchchay waassiza wode,</para>
  <para style="q2" vid="PSA 72:12">manqonne maadoy baynda</para>
  <para style="q2" vid="PSA 72:12">as izi ashshana.<verse eid="PSA 72:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13" />Hiyeesatassinne manqotas</para>
  <para style="q2" vid="PSA 72:13">izi qadhettees;</para>
  <para style="q2" vid="PSA 72:13">metotanchchata shemppoka</para>
  <para style="q2" vid="PSA 72:13">izi hayqoppe ashshees.<verse eid="PSA 72:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14" />Istta shemppo qohoppenne</para>
  <para style="q2" vid="PSA 72:14">geneppe izi ashshana;</para>
  <para style="q2" vid="PSA 72:14">istta suuththay</para>
  <para style="q2" vid="PSA 72:14">iza sinththan al7o.<verse eid="PSA 72:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15" />Kawoy shemppo gam7o;</para>
  <para style="q2" vid="PSA 72:15">Saaba biitta worqqay izas imetto.</para>
  <para style="q2" vid="PSA 72:15">Pacey baynda izas woossetto;</para>
  <para style="q2" vid="PSA 72:15">gallas ubbaan istti iza anjjetto.<verse eid="PSA 72:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16" />Biittan daro kaththay mokko;</para>
  <para style="q2" vid="PSA 72:16">zumati kaththan kamettetto;</para>
  <para style="q2" vid="PSA 72:16">Biittay Libaanoose mala</para>
  <para style="q2" vid="PSA 72:16">kaththa biitta gido;</para>
  <para style="q2" vid="PSA 72:16">maatay demba kumiza mala</para>
  <para style="q2" vid="PSA 72:16">katama kumo.<verse eid="PSA 72:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17" />Kawoza sunththi</para>
  <para style="q2" vid="PSA 72:17">mernaas minni de7o;</para>
  <para style="q2" vid="PSA 72:17">arshey de7iza keena</para>
  <para style="q2" vid="PSA 72:17">xeygettishe gam7o.</para>
  <para style="b" vid="PSA 72:17" />
  <para style="q2" vid="PSA 72:17">Kawoteth ubbay</para>
  <para style="q2" vid="PSA 72:17">iza baggara anjjetto;</para>
  <para style="q2" vid="PSA 72:17">dere ubbay iza,</para>
  <para style="q2" vid="PSA 72:17">«Ne anjjettidaade» gi anjjo.<verse eid="PSA 72:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18" />Malalisiza miish</para>
  <para style="q2" vid="PSA 72:18">barkka ooththiza GODAY,</para>
  <para style="q2" vid="PSA 72:18">Xoossay, Isra7eele</para>
  <para style="q2" vid="PSA 72:18">Xoossay galatetto.<verse eid="PSA 72:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19" />Iza bonchcho sunththay</para>
  <para style="q2" vid="PSA 72:19">mernaas galatetto;</para>
  <para style="q2" vid="PSA 72:19">biitta ubbay</para>
  <para style="q2" vid="PSA 72:19">iza bonchchon kumo.</para>
  <para style="q2" vid="PSA 72:19">Amiin! Amiin!<verse eid="PSA 72:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20" />Isseye naa Dawite woosay</para>
  <para style="q2" vid="PSA 72:20">hayssan polettides.<verse eid="PSA 72:20" /></para>
  <chapter eid="PSA 72" />
  <chapter number="73" style="c" sid="PSA 73" />
  <para style="ms">Heedzdzanththo Maxaafa</para>
  <para style="mr">(<ref loc="PSA 73-89">Maza 73—89</ref>)</para>
  <para style="s1">Aasaafe Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1" />Wozina geesh gidida</para>
  <para style="q2" vid="PSA 73:1">Isra7eele asaas</para>
  <para style="q2" vid="PSA 73:1">Xoossi ay mala kiya!<verse eid="PSA 73:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2" />Gido attiin ta tohoy dhuphettiin</para>
  <para style="q2" vid="PSA 73:2">ta kundaychchada</para>
  <para style="q2" vid="PSA 73:2">guuththason attadis.<verse eid="PSA 73:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3" />Ays giikko iita asatanne</para>
  <para style="q2" vid="PSA 73:3">makkallanchchata dureteththaa</para>
  <para style="q2" vid="PSA 73:3">be7ada tanikka istta mala</para>
  <para style="q2" vid="PSA 73:3">hananaas amottadis.<verse eid="PSA 73:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4" />Isttas tuggay deenna;</para>
  <para style="q2" vid="PSA 73:4">istta asateththay payyanne mino.<verse eid="PSA 73:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5" />Istti hara asay</para>
  <para style="q2" vid="PSA 73:5">tuggatiza mala tuggatettenna;</para>
  <para style="q2" vid="PSA 73:5">hara asa malakka</para>
  <para style="q2" vid="PSA 73:5">metoti erettenna.<verse eid="PSA 73:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6" />Hessa gishshas istti otoreteth</para>
  <para style="q2" vid="PSA 73:6">alleqo mala qoodhen aaththeettes;</para>
  <para style="q2" vid="PSA 73:6">makkallateth afala mala</para>
  <para style="q2" vid="PSA 73:6">may7eettes.<verse eid="PSA 73:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7" />Istta wozinappe</para>
  <para style="q2" vid="PSA 73:7">iita qofay pulttees;</para>
  <para style="q2" vid="PSA 73:7">bantta ayfe kessi dereqeettes.<verse eid="PSA 73:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8" />Istti qidheettessinne</para>
  <para style="q2" vid="PSA 73:8">iita haasayeettes;</para>
  <para style="q2" vid="PSA 73:8">istti bantta otoron harata</para>
  <para style="q2" vid="PSA 73:8">un7eththanawu mandeettes.<verse eid="PSA 73:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9" />Istti salon diza Xoossaa</para>
  <para style="q2" vid="PSA 73:9">bantta doonan cayeettes;</para>
  <para style="q2" vid="PSA 73:9">Sa7an de7iza asaa</para>
  <para style="q2" vid="PSA 73:9">bantta inxarsan dukkeettes.<verse eid="PSA 73:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10" />Hessa gishshas dere ubbay</para>
  <para style="q2" vid="PSA 73:10">isttako goochchees;</para>
  <para style="q2" vid="PSA 73:10">istti yootizayssaka ubbaa</para>
  <para style="q2" vid="PSA 73:10">eeson ammaneettes.<verse eid="PSA 73:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11" />Istti, «Xoossi ay erizee?</para>
  <para style="q2" vid="PSA 73:11">Ubbaafe Dhoqqa Xoossas</para>
  <para style="q2" vid="PSA 73:11">erateththi dizee?» geettes.<verse eid="PSA 73:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12" />Hekko iitati hayssa misateettes;</para>
  <para style="q2" vid="PSA 73:12">istti ubbato wudu gonttayta;</para>
  <para style="q2" vid="PSA 73:12">dureteththi qoodhe gakkidayta.<verse eid="PSA 73:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13" />Histtiin tani</para>
  <para style="q2" vid="PSA 73:13">wozina geeshshateththan</para>
  <para style="q2" vid="PSA 73:13">naagidayssi</para>
  <para style="q2" vid="PSA 73:13">tana ay maaddidee!</para>
  <para style="q2" vid="PSA 73:13">Ta kushe</para>
  <para style="q2" vid="PSA 73:13">ta xilloteththan meeccidayssi</para>
  <para style="q2" vid="PSA 73:13">coo tana dhallibeenna.<verse eid="PSA 73:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14" />Gallas kumeth</para>
  <para style="q2" vid="PSA 73:14">tani meto beyadis;</para>
  <para style="q2" vid="PSA 73:14">wontiin wontiin</para>
  <para style="q2" vid="PSA 73:14">tani qaxxayettadis.<verse eid="PSA 73:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15" />Tani istti haasayzayssa mala</para>
  <para style="q2" vid="PSA 73:15">haasayana qoppidaakko</para>
  <para style="q2" vid="PSA 73:15">ne deraas</para>
  <para style="q2" vid="PSA 73:15">ta ammanettontta as gidana.<verse eid="PSA 73:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16" />Tani ha yo7oza shaakka</para>
  <para style="q2" vid="PSA 73:16">eranaas qoppadis</para>
  <para style="q2" vid="PSA 73:16">gido attiin ta erappe bolla gidides.<verse eid="PSA 73:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17" />Hessika tani Xoossa Geeshshasoho</para>
  <para style="q2" vid="PSA 73:17">gelana gakkanaassinne</para>
  <para style="q2" vid="PSA 73:17">iitata wurseththa</para>
  <para style="q2" vid="PSA 73:17">be7ana gakkanaassa.<verse eid="PSA 73:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18" />Addaka ne istta</para>
  <para style="q2" vid="PSA 73:18">hallixizaason woththadasa;</para>
  <para style="q2" vid="PSA 73:18">neni istta duge</para>
  <para style="q2" vid="PSA 73:18">bashshaso yeddadasa.<verse eid="PSA 73:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19" />Istti hassa7ontta eeson dhayda;</para>
  <para style="q2" vid="PSA 73:19">dagaman issoyka attontta</para>
  <para style="q2" vid="PSA 73:19">dippi gida.<verse eid="PSA 73:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20" />Abeet Godawu! Neni dendiza wode</para>
  <para style="q2" vid="PSA 73:20">asi dhiskofe beeggiin dhayza</para>
  <para style="q2" vid="PSA 73:20">agumo mala istti dhayana.<verse eid="PSA 73:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21" />Tani yiillotida wodenne</para>
  <para style="q2" vid="PSA 73:21">ta wozinaykka madunxida wode,<verse eid="PSA 73:21" /></para>
  <para style="q2">
    <verse number="22" style="v" sid="PSA 73:22" />tani qofay baynda dammadis;</para>
  <para style="q2" vid="PSA 73:22">tani ne sinththan</para>
  <para style="q2" vid="PSA 73:22">miiza mala gidadis.<verse eid="PSA 73:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23" />Gido attiin tani ubbatokka</para>
  <para style="q2" vid="PSA 73:23">nenara days;</para>
  <para style="q2" vid="PSA 73:23">ta ushachcha kushezakka</para>
  <para style="q2" vid="PSA 73:23">neni oykkadasa.<verse eid="PSA 73:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24" />Ne zoren tana kaaleththadasa;</para>
  <para style="q2" vid="PSA 73:24">hessafe guye neni</para>
  <para style="q2" vid="PSA 73:24">tana bonchchos efana.<verse eid="PSA 73:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25" />Salon neeppe attiin</para>
  <para style="q2" vid="PSA 73:25">taas haray ooni dizee?</para>
  <para style="q2" vid="PSA 73:25">Sa7ankka neeppe</para>
  <para style="q2" vid="PSA 73:25">hara oonakka koykke.<verse eid="PSA 73:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26" />Ta wolqqaynne ta wozinay</para>
  <para style="q2" vid="PSA 73:26">daaburanaas dandayees;</para>
  <para style="q2" vid="PSA 73:26">gido attiin Xoossi</para>
  <para style="q2" vid="PSA 73:26">ta wozinas minoteththinne</para>
  <para style="q2" vid="PSA 73:26">taas mernaa qaada.<verse eid="PSA 73:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27" />Neeppe haakkizayti dhayana;</para>
  <para style="q2" vid="PSA 73:27">nees ammanettonttayta</para>
  <para style="q2" vid="PSA 73:27">ubbaa neni dhayssana.<verse eid="PSA 73:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28" />Gido attiin taas Xoossako</para>
  <para style="q2" vid="PSA 73:28">shiiqoy lo7o;</para>
  <para style="q2" vid="PSA 73:28">ne ooso ubbaa yootana mala.</para>
  <para style="q2" vid="PSA 73:28">Tani Ubbaa Haariza GODAA</para>
  <para style="q2" vid="PSA 73:28">ta baqata attizaso ooththadis.<verse eid="PSA 73:28" /></para>
  <chapter eid="PSA 73" />
  <chapter number="74" style="c" sid="PSA 74" />
  <para style="s1">Asaafi Hassa7an Shiishshida Ginxo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 74:1" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 74:1">Neni nuna mernaas</para>
  <para style="q2" vid="PSA 74:1">ays yegga aggadii?</para>
  <para style="q2" vid="PSA 74:1">Heenththasohon diza</para>
  <para style="q2" vid="PSA 74:1">dorsata bolla</para>
  <para style="q2" vid="PSA 74:1">ne hanqoy ays suullidee?<verse eid="PSA 74:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2" />Beni neni doorida ne deraa</para>
  <para style="q2" vid="PSA 74:2">nees buzo histta</para>
  <para style="q2" vid="PSA 74:2">wozzida zareta hassa7a;</para>
  <para style="q2" vid="PSA 74:2">neni de7ida Xiyoone Zuma qoppa.<verse eid="PSA 74:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3" />Ane laalettida Xoossa Keeththaza</para>
  <para style="q2" vid="PSA 74:3">yuuya xeella;</para>
  <para style="q2" vid="PSA 74:3">Morkketi izan diza</para>
  <para style="q2" vid="PSA 74:3">ubbaa miish dhayssida.<verse eid="PSA 74:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4" />Ne morkketi ne soon,</para>
  <para style="q2" vid="PSA 74:4">«Nuni xoonidos» giidi gerereettes.</para>
  <para style="q2" vid="PSA 74:4">Xoono malata giidi</para>
  <para style="q2" vid="PSA 74:4">bantta bandira essida.<verse eid="PSA 74:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5" />Istti wora giddon mith qanxxanawu</para>
  <para style="q2" vid="PSA 74:5">bantta kaltta dhoqqu histti</para>
  <para style="q2" vid="PSA 74:5">oykkida as misatida.<verse eid="PSA 74:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6" />Hiillanchchati ooththida alleqota</para>
  <para style="q2" vid="PSA 74:6">kalttaninne madooshan</para>
  <para style="q2" vid="PSA 74:6">menththereththi yeggida.<verse eid="PSA 74:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7" />Xoossa Keeththaa</para>
  <para style="q2" vid="PSA 74:7">taman xuuggidi dhayssida;</para>
  <para style="q2" vid="PSA 74:7">ne xeygettizasoza tunisida.<verse eid="PSA 74:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8" />Istti bantta wozinan,</para>
  <para style="q2" vid="PSA 74:8">«Istta nuni mulera un7eththana»</para>
  <para style="q2" vid="PSA 74:8">giidi qoppida;</para>
  <para style="q2" vid="PSA 74:8">Deraan Xoossi goynettizasohota</para>
  <para style="q2" vid="PSA 74:8">ubbaa taman xuuggida.<verse eid="PSA 74:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9" />Nu shaakki eranaas</para>
  <para style="q2" vid="PSA 74:9">malatay deenna;</para>
  <para style="q2" vid="PSA 74:9">hayssafe guye nabey dendenna;</para>
  <para style="q2" vid="PSA 74:9">Hayssi awude gakkanawu</para>
  <para style="q2" vid="PSA 74:9">hananaakko eriza asi</para>
  <para style="q2" vid="PSA 74:9">nu giddon deenna.<verse eid="PSA 74:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10" />Abeet Xoossawu! Ne morkketi</para>
  <para style="q2" vid="PSA 74:10">awude gakkanawu</para>
  <para style="q2" vid="PSA 74:10">ne bolla qilccanee?</para>
  <para style="q2" vid="PSA 74:10">Istti ne sunththa</para>
  <para style="q2" vid="PSA 74:10">mernaas kadhishe daanee?<verse eid="PSA 74:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11" />Ne kusheza miccada</para>
  <para style="q2" vid="PSA 74:11">ays istta dhayssikii?</para>
  <para style="q2" vid="PSA 74:11">Ne ushachcha kusheza</para>
  <para style="q2" vid="PSA 74:11">ays shophpha garsan</para>
  <para style="q2" vid="PSA 74:11">lokkoma uttadii?<verse eid="PSA 74:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 74:12">Benippeka ta kawoy nena;</para>
  <para style="q2" vid="PSA 74:12">neni biitta bolla atoteth ehadasa.<verse eid="PSA 74:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13" />Ne gita wolqqan abba shaakkadasa;</para>
  <para style="q2" vid="PSA 74:13">iza giddon diza</para>
  <para style="q2" vid="PSA 74:13">miimintteta hu7e qoo7ereththadasa.<note caller="-" style="x"><char style="xo" closed="false">74:13 </char><char style="xt" closed="false"><ref loc="EXO 14:21">Kessa 14:21</ref></char></note><verse eid="PSA 74:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14" />Lewataane<note caller="+" style="f"><char style="fr" closed="false">74:14 </char><char style="ft" closed="false">Lewataane geetettiza miiminttey abba giddon de7iza wogga gita do7a.</char></note> geetettiza</para>
  <para style="q2" vid="PSA 74:14">miimintte hu7eta dinccadasa;</para>
  <para style="q2" vid="PSA 74:14">iza asho</para>
  <para style="q2" vid="PSA 74:14">bazzon diza medhetatas</para>
  <para style="q2" vid="PSA 74:14">quma ooththa immaasa<note caller="+" style="f"><char style="fr" closed="false">74:14 </char><char style="ft" closed="false">Iza asho bazzon diza medhetatas gizayssi laappun tammu eranchchata birsheththa maxaafan Tophphiya asatas quma woykko kath immadasa gees.</char></note>.<verse eid="PSA 74:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15" />Neni pulttotanne</para>
  <para style="q2" vid="PSA 74:15">kanchcheta doya yeddadasa;</para>
  <para style="q2" vid="PSA 74:15">ubba wode goggiza shaafata</para>
  <para style="q2" vid="PSA 74:15">qasse melissadasa.<verse eid="PSA 74:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16" />Gallassay neessa;</para>
  <para style="q2" vid="PSA 74:16">qammayka neessa;</para>
  <para style="q2" vid="PSA 74:16">qasse arshenne agina</para>
  <para style="q2" vid="PSA 74:16">istti dizason</para>
  <para style="q2" vid="PSA 74:16">minththa woththiday nena.<verse eid="PSA 74:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17" />Biittas zawa woththiday,</para>
  <para style="q2" vid="PSA 74:17">balgonne bone medhdhiday nena.<verse eid="PSA 74:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 74:18">Ne morkketi ne bolla</para>
  <para style="q2" vid="PSA 74:18">wostti qilccidaakko,</para>
  <para style="q2" vid="PSA 74:18">qasse eeya asati</para>
  <para style="q2" vid="PSA 74:18">ne sunththaa</para>
  <para style="q2" vid="PSA 74:18">wostti kadhidaakko qoppa.<verse eid="PSA 74:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19" />Nees haarettizayta shemppo</para>
  <para style="q2" vid="PSA 74:19">wora do7atas aaththa immofa;</para>
  <para style="q2" vid="PSA 74:19">metotida ne deraa</para>
  <para style="q2" vid="PSA 74:19">mernaas dogoppa.<verse eid="PSA 74:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20" />Biittan diza dhuma sohoti</para>
  <para style="q2" vid="PSA 74:20">ubbay makkallanchchatan</para>
  <para style="q2" vid="PSA 74:20">kumida gishshas</para>
  <para style="q2" vid="PSA 74:20">neni nuus caaqqida</para>
  <para style="q2" vid="PSA 74:20">caaqo qaala qoppa.<verse eid="PSA 74:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21" />Naaqettidayti yeellati simmofetto;</para>
  <para style="q2" vid="PSA 74:21">manqotinne metotidayti</para>
  <para style="q2" vid="PSA 74:21">ne sunththa galatetto.<verse eid="PSA 74:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22" />Abeet Xoossawu! Denda!</para>
  <para style="q2" vid="PSA 74:22">Neni ne sunththas mootetta;</para>
  <para style="q2" vid="PSA 74:22">eeyati gallas ubbaan</para>
  <para style="q2" vid="PSA 74:22">nena kadhizayssa qoppa.<verse eid="PSA 74:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23" />Ne morkketi</para>
  <para style="q2" vid="PSA 74:23">ne bolla waassiza waasoza,</para>
  <para style="q2" vid="PSA 74:23">nena ixxizayti</para>
  <para style="q2" vid="PSA 74:23">ne bolla ceeqettiza ceeqeteththaanne</para>
  <para style="q2" vid="PSA 74:23">istta wocama dogoppa.<verse eid="PSA 74:23" /></para>
  <chapter eid="PSA 74" />
  <chapter number="75" style="c" sid="PSA 75" />
  <para style="s1">Aasaafey zammareta kaabbos, «Dhayssofa» geetettiza diiththa giigson shiishshida mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 75:1" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 75:1">Nena galatoos;</para>
  <para style="q2" vid="PSA 75:1">ne nuus mata gidida gishshas</para>
  <para style="q2" vid="PSA 75:1">ne sunththas galata shiishshoos;</para>
  <para style="q2" vid="PSA 75:1">asaykka malalisiza</para>
  <para style="q2" vid="PSA 75:1">ne ooso ubbaa gishshas</para>
  <para style="q2" vid="PSA 75:1">haasayees.<verse eid="PSA 75:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2" />Xoossi, «Ta bara woththida woden</para>
  <para style="q2" vid="PSA 75:2">suure pirda pirdanay tana.<verse eid="PSA 75:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3" />Sa7aynne iza bolla diza</para>
  <para style="q2" vid="PSA 75:3">medheta ubbay qaaxxiza wode</para>
  <para style="q2" vid="PSA 75:3">sa7a tuussata minththa</para>
  <para style="q2" vid="PSA 75:3">essiday tana.<verse eid="PSA 75:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4" />Otoranchchata, ‹Otorettofte› gays;</para>
  <para style="q2" vid="PSA 75:4">iitatakka, ‹Intte makkallofte.<verse eid="PSA 75:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5" />Ne kace otoron</para>
  <para style="q2" vid="PSA 75:5">dhoqqu dhoqqu histtofa;</para>
  <para style="q2" vid="PSA 75:5">ne qoodhe qaaththa</para>
  <para style="q2" vid="PSA 75:5">haasayoppa› gays» gees.<verse eid="PSA 75:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6" />Bonchchoy arshey mokkizasoppe</para>
  <para style="q2" vid="PSA 75:6">woykko wullizasoppe</para>
  <para style="q2" vid="PSA 75:6">woykko bazzofe yeenna.<verse eid="PSA 75:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7" />Gido attiin suure pirdizay Xoossa;</para>
  <para style="q2" vid="PSA 75:7">izi issaa bolla pirdees;</para>
  <para style="q2" vid="PSA 75:7">issaa xillisees.<verse eid="PSA 75:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8" />GODAA kushen wancay dees;</para>
  <para style="q2" vid="PSA 75:8">izan hoommotiza hanqo woyne</para>
  <para style="q2" vid="PSA 75:8">ushshi kumi uttides;</para>
  <para style="q2" vid="PSA 75:8">he ushshaza gede kare gussides;</para>
  <para style="q2" vid="PSA 75:8">sa7an diza makkallanchchati</para>
  <para style="q2" vid="PSA 75:8">hessa uyida;</para>
  <para style="q2" vid="PSA 75:8">istti orccoka</para>
  <para style="q2" vid="PSA 75:8">ashshontta congorsida.<verse eid="PSA 75:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9" />Tani gidikko hayssa</para>
  <para style="q2" vid="PSA 75:9">mernaas awajjana;</para>
  <para style="q2" vid="PSA 75:9">Yaaqoobe Xoossaka</para>
  <para style="q2" vid="PSA 75:9">mazamuren sabbana.<verse eid="PSA 75:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10" />Tani iitata kace ubbaa menththana;</para>
  <para style="q2" vid="PSA 75:10">xillota kace gidikko</para>
  <para style="q2" vid="PSA 75:10">dhoqqu dhoqqu histtana.<verse eid="PSA 75:10" /></para>
  <chapter eid="PSA 75" />
  <chapter number="76" style="c" sid="PSA 76" />
  <para style="s1">Aasaafey Zammareta Kaabbos Diiththatan Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 76:1" />Xoossi Yuhudan erettides;</para>
  <para style="q2" vid="PSA 76:1">iza sunththika Isra7eelen gita.<verse eid="PSA 76:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2" />Iza dunkaaney Saleemen dees;</para>
  <para style="q2" vid="PSA 76:2">izas duussasoyka Xiyoone.<verse eid="PSA 76:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3" />Izi hessan dukkiza</para>
  <para style="q2" vid="PSA 76:3">wondafe yiishshaa,</para>
  <para style="q2" vid="PSA 76:3">gondalle, giththa mashshatanne</para>
  <para style="q2" vid="PSA 76:3">hara ola miishshata</para>
  <para style="q2" vid="PSA 76:3">menththereththi yeggides.<verse eid="PSA 76:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 76:4">Neni bonchcho may7ada</para>
  <para style="q2" vid="PSA 76:4">phoollaasa;</para>
  <para style="q2" vid="PSA 76:4">Ne teemateththi</para>
  <para style="q2" vid="PSA 76:4">gita zumatappeka aadhdhees.<verse eid="PSA 76:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5" />Gooba olanchchati bonqqettida;</para>
  <para style="q2" vid="PSA 76:5">isttafe issoyka ba kushe</para>
  <para style="q2" vid="PSA 76:5">denththana dandaybeenna;</para>
  <para style="q2" vid="PSA 76:5">istti wolqqama dhisko dhiskida.<verse eid="PSA 76:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6" />Abeet Yaaqoobe Xoossawu!</para>
  <para style="q2" vid="PSA 76:6">Ne hanqo gaason toga asatinne</para>
  <para style="q2" vid="PSA 76:6">toga parati kundi attida.<verse eid="PSA 76:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7" />Abeet Xoossawu! Neni yashshaasa!</para>
  <para style="q2" vid="PSA 76:7">Ne hanqoy suullida wode</para>
  <para style="q2" vid="PSA 76:7">ne sinththan oonee eqqanay?<verse eid="PSA 76:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8" />Neni saloppe pirda sissadasa;</para>
  <para style="q2" vid="PSA 76:8">biittay yayyada sirphi gadus.<verse eid="PSA 76:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 76:9">Hayssi sa7a bolla</para>
  <para style="q2" vid="PSA 76:9">un7ettidayta ashshanaas</para>
  <para style="q2" vid="PSA 76:9">neni pirdas dendiin handes.<verse eid="PSA 76:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10" />Neni as hanqikokka</para>
  <para style="q2" vid="PSA 76:10">hessi ne bonchchos gidees;</para>
  <para style="q2" vid="PSA 76:10">olappe attidayti</para>
  <para style="q2" vid="PSA 76:10">ne ba7aale bonchchana.<verse eid="PSA 76:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11" />GODAA intte Xoossaas adinite;</para>
  <para style="q2" vid="PSA 76:11">he adinettidayssaka gaththite;</para>
  <para style="q2" vid="PSA 76:11">iza yuushon diza ubbati</para>
  <para style="q2" vid="PSA 76:11">yashissiza izas</para>
  <para style="q2" vid="PSA 76:11">imota ekki yiite.<verse eid="PSA 76:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12" />Izi otorettiza daannata kawushshana;</para>
  <para style="q2" vid="PSA 76:12">wolqqama kawotakka izi yashissana.<verse eid="PSA 76:12" /></para>
  <chapter eid="PSA 76" />
  <chapter number="77" style="c" sid="PSA 77" />
  <para style="s1">Aasaafey Zammareta Kaabbo Edotaanes Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1" />Tani ta qaala dhoqqu histtada</para>
  <para style="q2" vid="PSA 77:1">Xoossako waassays;</para>
  <para style="q2" vid="PSA 77:1">tana siyana mala</para>
  <para style="q2" vid="PSA 77:1">ta iza woossays.<verse eid="PSA 77:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2" />Tani metotida gallas Xoossa koyays;</para>
  <para style="q2" vid="PSA 77:2">omarsika shempontta</para>
  <para style="q2" vid="PSA 77:2">ta kusheta izakko miccays;</para>
  <para style="q2" vid="PSA 77:2">gidikkoka tani minettanaas</para>
  <para style="q2" vid="PSA 77:2">dandayabeekke.<verse eid="PSA 77:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 77:3">Ta nena qoppashe ceecays;</para>
  <para style="q2" vid="PSA 77:3">ta yuushsha qoppashe</para>
  <para style="q2" vid="PSA 77:3">keeha daaburdes.<verse eid="PSA 77:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4" />Ta ayfeppe dhisko dhayssadasa;</para>
  <para style="q2" vid="PSA 77:4">taas gaanaazi</para>
  <para style="q2" vid="PSA 77:4">dhayana gakkanaas ceecadis.<verse eid="PSA 77:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5" />Tani aadhdhida wodeta qoppadis;</para>
  <para style="q2" vid="PSA 77:5">kase aadhdhida</para>
  <para style="q2" vid="PSA 77:5">layththatakka hassa7adis.<verse eid="PSA 77:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6" />Ta yexxidayssa giddoth</para>
  <para style="q2" vid="PSA 77:6">yuushsha qoppadis;</para>
  <para style="q2" vid="PSA 77:6">tani wozinan akeekadis;</para>
  <para style="q2" vid="PSA 77:6">ta ayanay tana denththeththiin,<verse eid="PSA 77:6" /></para>
  <para style="b" />
  <para style="q2">
    <verse number="7" style="v" sid="PSA 77:7" />«Goday nuna mernaas</para>
  <para style="q2" vid="PSA 77:7">yeggi agganee?</para>
  <para style="q2" vid="PSA 77:7">Hayssafe guye</para>
  <para style="q2" vid="PSA 77:7">nuna lo7o bessennee?<verse eid="PSA 77:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8" />Nuna siiqizayssa mulera aggidee?</para>
  <para style="q2" vid="PSA 77:8">izi yootida hidotay shaarettidee?<verse eid="PSA 77:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9" />Xoossi ba maarizayssa aggidee?</para>
  <para style="q2" vid="PSA 77:9">Hanqon ba qadheta aggidee?»</para>
  <para style="q2" vid="PSA 77:9">ga oychchays.<verse eid="PSA 77:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10" />Ubbaafe Dhoqqa Xoossawu!</para>
  <para style="q2" vid="PSA 77:10">Tana qohiday,</para>
  <para style="q2" vid="PSA 77:10">ne ushachcha kushey</para>
  <para style="q2" vid="PSA 77:10">kaseyssaththo</para>
  <para style="q2" vid="PSA 77:10">nuna maaddontta aggoyssa.<verse eid="PSA 77:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11" />GODAWU! Ne oosota</para>
  <para style="q2" vid="PSA 77:11">tani qoppana;</para>
  <para style="q2" vid="PSA 77:11">neni beni wode ooththida</para>
  <para style="q2" vid="PSA 77:11">malalisiza oosota ubbaa</para>
  <para style="q2" vid="PSA 77:11">ta yuushsha qoppana.<verse eid="PSA 77:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12" />Ne ooththida ubbaa</para>
  <para style="q2" vid="PSA 77:12">tani zaara zaarada qoppana;</para>
  <para style="q2" vid="PSA 77:12">ne wolqqama oosota ubbaa</para>
  <para style="q2" vid="PSA 77:12">tani akeekana.<verse eid="PSA 77:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 77:13">Ne ogey geeshsha;</para>
  <para style="q2" vid="PSA 77:13">nu Xoossaa mala</para>
  <para style="q2" vid="PSA 77:13">hara gita xoossi oonee?<verse eid="PSA 77:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14" />Neni malalisizaaz ooththiza Xoossa;</para>
  <para style="q2" vid="PSA 77:14">dereta giddon</para>
  <para style="q2" vid="PSA 77:14">ne wolqqa bessaasa.<verse eid="PSA 77:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15" />Yaaqoobenne Yooseefe</para>
  <para style="q2" vid="PSA 77:15">zereth gidida ne dereta</para>
  <para style="q2" vid="PSA 77:15">neni ne wolqqan wozzadasa.<verse eid="PSA 77:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 77:16">Haaththati nena be7ida;</para>
  <para style="q2" vid="PSA 77:16">Haaththati nena be7idi yayyida;</para>
  <para style="q2" vid="PSA 77:16">ciimma abbatikka kokkorida.<verse eid="PSA 77:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17" />Shaarati ira immida;</para>
  <para style="q2" vid="PSA 77:17">salon daday guummides;</para>
  <para style="q2" vid="PSA 77:17">wolqqanththi wawaci gides.<verse eid="PSA 77:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18" />Ne dada gunththay</para>
  <para style="q2" vid="PSA 77:18">gote carko giddon kooshimides;</para>
  <para style="q2" vid="PSA 77:18">ne wolqqanththa phoolleththi</para>
  <para style="q2" vid="PSA 77:18">sa7a poo7isides;</para>
  <para style="q2" vid="PSA 77:18">biittayka qaaxxi kokkorides.<verse eid="PSA 77:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19" />Neni abba giddora hemettaasa;</para>
  <para style="q2" vid="PSA 77:19">ciimma abba giddora</para>
  <para style="q2" vid="PSA 77:19">kanththaasa;</para>
  <para style="q2" vid="PSA 77:19">gidikkoka ne bida geedoy</para>
  <para style="q2" vid="PSA 77:19">erettenna.<verse eid="PSA 77:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20" />Musenne Aaroone kushen</para>
  <para style="q2" vid="PSA 77:20">neni ne dereza dorsa</para>
  <para style="q2" vid="PSA 77:20">wude mala kaaleththadasa.<verse eid="PSA 77:20" /></para>
  <chapter eid="PSA 77" />
  <chapter number="78" style="c" sid="PSA 78" />
  <para style="s1">Aasaafey Hassa7an Shiishshida Ginxo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1" />Ta derezoo ta nena</para>
  <para style="q2" vid="PSA 78:1">tamaarsizayssa siya;</para>
  <para style="q2" vid="PSA 78:1">ta doonappe ke7iza qaala ezga.<verse eid="PSA 78:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2" />Tani haasayza haasaya</para>
  <para style="q2" vid="PSA 78:2">leemison doommays;</para>
  <para style="q2" vid="PSA 78:2">beniisofe qotan diza</para>
  <para style="q2" vid="PSA 78:2">xuura yo7o qonccisays.<note caller="-" style="x"><char style="xo" closed="false">78:2 </char><char style="xt" closed="false"><ref loc="MAT 13:35">Mato 13:35</ref></char></note><verse eid="PSA 78:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3" />Nu siyidayssinne</para>
  <para style="q2" vid="PSA 78:3">nu eridayssi,</para>
  <para style="q2" vid="PSA 78:3">nu aawatikka nuus yootidayssa.<verse eid="PSA 78:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4" />He yo7ota nuni</para>
  <para style="q2" vid="PSA 78:4">istta naytappe qottoko;</para>
  <para style="q2" vid="PSA 78:4">GODAAS bessiza galata,</para>
  <para style="q2" vid="PSA 78:4">iza wolqqanne</para>
  <para style="q2" vid="PSA 78:4">malalisiza iza ooso</para>
  <para style="q2" vid="PSA 78:4">yiza yeletataskka</para>
  <para style="q2" vid="PSA 78:4">nuni yootana.<verse eid="PSA 78:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5" />Izi Yaaqoobe zaretas azazo,</para>
  <para style="q2" vid="PSA 78:5">Isra7eele asaas woga immides;</para>
  <para style="q2" vid="PSA 78:5">kase nu aawati bantta nayta</para>
  <para style="q2" vid="PSA 78:5">he wogata</para>
  <para style="q2" vid="PSA 78:5">tamaarsana mala azazides.<verse eid="PSA 78:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6" />Hessika kaalliza yeletay</para>
  <para style="q2" vid="PSA 78:6">istta eranaassa;</para>
  <para style="q2" vid="PSA 78:6">qasseka buro yelettana</para>
  <para style="q2" vid="PSA 78:6">nayti eranaassanne</para>
  <para style="q2" vid="PSA 78:6">isttika bantta naytas yootanaassa.<verse eid="PSA 78:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7" />He naytikka Xoossan ammanettana;</para>
  <para style="q2" vid="PSA 78:7">izi ooththida oosokka dogettenna;</para>
  <para style="q2" vid="PSA 78:7">iza azazotakka istti naagana.<verse eid="PSA 78:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8" />Istti kase bantta aawata mala</para>
  <para style="q2" vid="PSA 78:8">wozina muumenne</para>
  <para style="q2" vid="PSA 78:8">makkallanchcha gidettenna;</para>
  <para style="q2" vid="PSA 78:8">istti Xoossa sinththan</para>
  <para style="q2" vid="PSA 78:8">suure gidettenna;</para>
  <para style="q2" vid="PSA 78:8">Xoossaska ammanettibeettenna.<verse eid="PSA 78:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9" />Efreeme nayti olas</para>
  <para style="q2" vid="PSA 78:9">wondafenne yiish giigsi kezida;</para>
  <para style="q2" vid="PSA 78:9">gido attiin ola gallas guye simmida.<verse eid="PSA 78:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10" />Istti Xoossa caaqo qaala</para>
  <para style="q2" vid="PSA 78:10">naagibeettenna;</para>
  <para style="q2" vid="PSA 78:10">iza wogaa mala dontta ixxida.<verse eid="PSA 78:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11" />Istti izi ooththida ooso balida;</para>
  <para style="q2" vid="PSA 78:11">izi istti bessida</para>
  <para style="q2" vid="PSA 78:11">malalisiza hanotakka dogida.<verse eid="PSA 78:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12" />Izi istta aawati be7ishin</para>
  <para style="q2" vid="PSA 78:12">Gibxe biittan</para>
  <para style="q2" vid="PSA 78:12">Xaanoose demban</para>
  <para style="q2" vid="PSA 78:12">malaata ooththides.<note caller="-" style="x"><char style="xo" closed="false">78:12 </char><char style="xt" closed="false"><ref loc="EXO 7:8-12:32">Kessa 7:8—12:32</ref></char></note><verse eid="PSA 78:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13" />Abba shaakkidi giddora</para>
  <para style="q2" vid="PSA 78:13">istta pinththides;</para>
  <para style="q2" vid="PSA 78:13">izi haaththa yaanne</para>
  <para style="q2" vid="PSA 78:13">haa shaakkidi</para>
  <para style="q2" vid="PSA 78:13">goda mala essides.<note caller="-" style="x"><char style="xo" closed="false">78:13 </char><char style="xt" closed="false"><ref loc="EXO 14:21-22">Kessa 14:21-22</ref></char></note><verse eid="PSA 78:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14" />Izi istta gallas shaaran,</para>
  <para style="q2" vid="PSA 78:14">omars tama poo7on</para>
  <para style="q2" vid="PSA 78:14">kaaleththides.<note caller="-" style="x"><char style="xo" closed="false">78:14 </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">Kessa 13:21-22</ref></char></note><verse eid="PSA 78:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15" />Izi bazzon zaalla phalqidi</para>
  <para style="q2" vid="PSA 78:15">abba mala daro haath</para>
  <para style="q2" vid="PSA 78:15">istta ushshides.<note caller="-" style="x"><char style="xo" closed="false">78:15-16 </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">Kessa 17:1-7</ref>; <ref loc="NUM 20:2-13">Tay 20:2-13</ref></char></note><verse eid="PSA 78:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16" />Zaallafe haath pulttisidi</para>
  <para style="q2" vid="PSA 78:16">shaafa mala duge gogissides.<verse eid="PSA 78:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17" />Gido attiin istti iza bolla</para>
  <para style="q2" vid="PSA 78:17">nagara ooso gede gujjida;</para>
  <para style="q2" vid="PSA 78:17">Ubbaafe Dhoqqa Xoossa bolla</para>
  <para style="q2" vid="PSA 78:17">bazzon makkallida.<verse eid="PSA 78:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18" />Istti keehi amottida</para>
  <para style="q2" vid="PSA 78:18">kath oychchida;</para>
  <para style="q2" vid="PSA 78:18">erishe ba wozinan</para>
  <para style="q2" vid="PSA 78:18">Xoossa paaccida.<note caller="-" style="x"><char style="xo" closed="false">78:18-31 </char><char style="xt" closed="false"><ref loc="EXO 16:2-15">Kessa 16:2-15</ref>; <ref loc="NUM 11:4-23">Tay 11:4-23</ref>,<ref loc="NUM 11:31-35">31-35</ref></char></note><verse eid="PSA 78:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19" />Istti Xoossa bolla,</para>
  <para style="q2" vid="PSA 78:19">«Bazzon Xoossi</para>
  <para style="q2" vid="PSA 78:19">nuus maana kath</para>
  <para style="q2" vid="PSA 78:19">immana dandayzee?<verse eid="PSA 78:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20" />Zaallaa shociin pulttoy ke7idi</para>
  <para style="q2" vid="PSA 78:20">shaafa haaththi goggides;</para>
  <para style="q2" vid="PSA 78:20">histtiin izi nuus miza kath</para>
  <para style="q2" vid="PSA 78:20">immanawu dandayzee?</para>
  <para style="q2" vid="PSA 78:20">Woykko ba asaas</para>
  <para style="q2" vid="PSA 78:20">asho immanawu</para>
  <para style="q2" vid="PSA 78:20">dandayzee?» gi haasayda.<verse eid="PSA 78:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21" />GODAY hessa siyida wode</para>
  <para style="q2" vid="PSA 78:21">istta bolla daro hanqettides;</para>
  <para style="q2" vid="PSA 78:21">Yaaqoobe zareta bolla</para>
  <para style="q2" vid="PSA 78:21">tamay eexxides;</para>
  <para style="q2" vid="PSA 78:21">Isra7eele bolla iza hanqoy</para>
  <para style="q2" vid="PSA 78:21">dari dari bides.<verse eid="PSA 78:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22" />Ays giikko istti</para>
  <para style="q2" vid="PSA 78:22">Xoossan ammanibeettenna;</para>
  <para style="q2" vid="PSA 78:22">izi ashshizayssaka</para>
  <para style="q2" vid="PSA 78:22">ammanettibeettenna.<verse eid="PSA 78:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23" />Izi gidikko bollafe shaara azazides;</para>
  <para style="q2" vid="PSA 78:23">salo pengetakka doydes.<verse eid="PSA 78:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24" />Istti maana mala isttas</para>
  <para style="q2" vid="PSA 78:24">manna bukisides;</para>
  <para style="q2" vid="PSA 78:24">saloppe kath isttas immides.<note caller="-" style="x"><char style="xo" closed="false">78:24 </char><char style="xt" closed="false"><ref loc="JHN 6:31">Yoha 6:31</ref></char></note><verse eid="PSA 78:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25" />Kiitanchchata kath asay mides;</para>
  <para style="q2" vid="PSA 78:25">Xoossi istti kalli miin</para>
  <para style="q2" vid="PSA 78:25">tirpi attiza kath immides.<verse eid="PSA 78:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26" />Arshey mokkiza baggara saloppe</para>
  <para style="q2" vid="PSA 78:26">carkoy carkana mala ooththides;</para>
  <para style="q2" vid="PSA 78:26">ba wolqqan dugeha bagga</para>
  <para style="q2" vid="PSA 78:26">carko denththeththides.<verse eid="PSA 78:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27" />Izi asaas asho gudulla biitta mala,</para>
  <para style="q2" vid="PSA 78:27">abba doonan diza ace mala daro</para>
  <para style="q2" vid="PSA 78:27">piradhdhiza kafota yeddides.<verse eid="PSA 78:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28" />Istti dunkaani uttidaso</para>
  <para style="q2" vid="PSA 78:28">dunkaanaa yuushon wodhdhida.<verse eid="PSA 78:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29" />Istti amottidayssa isttas immides;</para>
  <para style="q2" vid="PSA 78:29">isttika kalli mida.<verse eid="PSA 78:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30" />Gido attiin istti</para>
  <para style="q2" vid="PSA 78:30">ba moosaa aaththontta</para>
  <para style="q2" vid="PSA 78:30">buro muussa bolla de7ishin,<verse eid="PSA 78:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31" />Xoossa hanqoy</para>
  <para style="q2" vid="PSA 78:31">istta bolla wodhdhides;</para>
  <para style="q2" vid="PSA 78:31">istta giddofe</para>
  <para style="q2" vid="PSA 78:31">mino asata wodhides;</para>
  <para style="q2" vid="PSA 78:31">Isra7eeleppe</para>
  <para style="q2" vid="PSA 78:31">payya naateththata mulqqides.<verse eid="PSA 78:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32" />Hayssi ubbay haniinkka</para>
  <para style="q2" vid="PSA 78:32">istti nagara ooththizayssa</para>
  <para style="q2" vid="PSA 78:32">aggibeettenna;</para>
  <para style="q2" vid="PSA 78:32">malalisiza iza oosotakka</para>
  <para style="q2" vid="PSA 78:32">be7idi ammanibeettenna.<verse eid="PSA 78:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33" />Hessa gishshas izi istta layththata</para>
  <para style="q2" vid="PSA 78:33">peeno mala aaththides;</para>
  <para style="q2" vid="PSA 78:33">istti diza wodeta</para>
  <para style="q2" vid="PSA 78:33">hirgan wursides.<verse eid="PSA 78:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34" />Xoossi isttafe guuththata wodhiin</para>
  <para style="q2" vid="PSA 78:34">attidayti ba nagara paaxida;</para>
  <para style="q2" vid="PSA 78:34">wozinappe koyishe</para>
  <para style="q2" vid="PSA 78:34">Xoossako simmida.<verse eid="PSA 78:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35" />Istti Xoossi isttas</para>
  <para style="q2" vid="PSA 78:35">Zaalla gididayssanne</para>
  <para style="q2" vid="PSA 78:35">Ubbaafe Dhoqqa Xoossi</para>
  <para style="q2" vid="PSA 78:35">istta wozzidayssa hassa7ida.<verse eid="PSA 78:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36" />Gido attiin istti bantta</para>
  <para style="q2" vid="PSA 78:36">inxarsan izas wordotidi</para>
  <para style="q2" vid="PSA 78:36">bantta doonan cimmida.<verse eid="PSA 78:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37" />Istta wozinay</para>
  <para style="q2" vid="PSA 78:37">Xoossan minni eqqibeenna;</para>
  <para style="q2" vid="PSA 78:37">izi isttara caaqettida</para>
  <para style="q2" vid="PSA 78:37">caaqon ammanettibeettenna.<verse eid="PSA 78:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38" />Gido attiin izi istta</para>
  <para style="q2" vid="PSA 78:38">maarizaade gidida gishshas</para>
  <para style="q2" vid="PSA 78:38">istta iitateththaa atto gides;</para>
  <para style="q2" vid="PSA 78:38">isttaka dhayssibeenna;</para>
  <para style="q2" vid="PSA 78:38">daro wode ba hanqoza</para>
  <para style="q2" vid="PSA 78:38">istta bollafe teqqides;</para>
  <para style="q2" vid="PSA 78:38">ba hanqoza bosha ubbaa</para>
  <para style="q2" vid="PSA 78:38">istta bolla yeddibeenna.<verse eid="PSA 78:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39" />Issino carki aadhdhidaappe guye</para>
  <para style="q2" vid="PSA 78:39">simmontta carko mala</para>
  <para style="q2" vid="PSA 78:39">asho may7ida as</para>
  <para style="q2" vid="PSA 78:39">gididayssa akeekides.<verse eid="PSA 78:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40" />Istti bazzon aappunto</para>
  <para style="q2" vid="PSA 78:40">iza bolla makkallidoo!</para>
  <para style="q2" vid="PSA 78:40">Mela bazzon aappunto</para>
  <para style="q2" vid="PSA 78:40">iza lancissidoo!<verse eid="PSA 78:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41" />Istti zaari zaaridi Xoossa paaccida;</para>
  <para style="q2" vid="PSA 78:41">Isra7eele Geeshshaa</para>
  <para style="q2" vid="PSA 78:41">madunththida.<verse eid="PSA 78:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42" />Izi istta morkketappe</para>
  <para style="q2" vid="PSA 78:42">wozzida gallassatanne</para>
  <para style="q2" vid="PSA 78:42">iza wolqqaa dogida.<verse eid="PSA 78:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43" />Izi Gibxe biittan malaata,</para>
  <para style="q2" vid="PSA 78:43">Xaanoose demban malalisizaaz</para>
  <para style="q2" vid="PSA 78:43">ooththidayssa qoppibeettenna.<verse eid="PSA 78:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44" />Istta shaafa haaththa</para>
  <para style="q2" vid="PSA 78:44">suuththan laammides;</para>
  <para style="q2" vid="PSA 78:44">hessa gishshas Gibxe asati</para>
  <para style="q2" vid="PSA 78:44">he shaafatappe</para>
  <para style="q2" vid="PSA 78:44">uyanaas dandaybeettenna.<note caller="-" style="x"><char style="xo" closed="false">78:44 </char><char style="xt" closed="false"><ref loc="EXO 7:17-21">Kessa 7:17-21</ref></char></note><verse eid="PSA 78:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45" />Istta olanaas udunxxetanne</para>
  <para style="q2" vid="PSA 78:45">istta biitta dhayssanaas</para>
  <para style="q2" vid="PSA 78:45">shodhdheta kiittides.<note caller="-" style="x"><char style="xo" closed="false">78:45 </char><char style="xt" closed="false"><ref loc="EXO 8:1-6">Kessa 8:1-6</ref>; <ref loc="EXO 20:24">20:24</ref></char></note><verse eid="PSA 78:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46" />Isttas mokkida kaththa gumbaros;</para>
  <para style="q2" vid="PSA 78:46">istti ooththi daaburda kaththaa</para>
  <para style="q2" vid="PSA 78:46">booles immides.<note caller="-" style="x"><char style="xo" closed="false">78:46 </char><char style="xt" closed="false"><ref loc="EXO 10:12-15">Kessa 10:12-15</ref></char></note><verse eid="PSA 78:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47" />Istta woyne tura shachchan,</para>
  <para style="q2" vid="PSA 78:47">istta balase miththatakka</para>
  <para style="q2" vid="PSA 78:47">kenchchon dhayssides.<verse eid="PSA 78:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48" />Istta miizata shachchan wodhides;</para>
  <para style="q2" vid="PSA 78:48">istta meheta wolqqanththan</para>
  <para style="q2" vid="PSA 78:48">xuuggi wursides.<note caller="-" style="x"><char style="xo" closed="false">78:47-48 </char><char style="xt" closed="false"><ref loc="EXO 9:22-25">Kessa 9:22-25</ref></char></note><verse eid="PSA 78:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49" />Ba mino hanqo, bosha, bashshinne</para>
  <para style="q2" vid="PSA 78:49">dhayssiza kiitanchchatan</para>
  <para style="q2" vid="PSA 78:49">istta bolla yeddides.<verse eid="PSA 78:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50" />Ba hanqozas oge giigsides;</para>
  <para style="q2" vid="PSA 78:50">istta iita harges</para>
  <para style="q2" vid="PSA 78:50">aaththi immides;</para>
  <para style="q2" vid="PSA 78:50">gido attiin hayqoppe</para>
  <para style="q2" vid="PSA 78:50">ashshibeenna.<verse eid="PSA 78:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51" />Gibxen yelettida bayra nayta</para>
  <para style="q2" vid="PSA 78:51">ubbaa wodhides;</para>
  <para style="q2" vid="PSA 78:51">Kaame dunkaanen</para>
  <para style="q2" vid="PSA 78:51">koyro yelettida</para>
  <para style="q2" vid="PSA 78:51">nayta wursides.<note caller="-" style="x"><char style="xo" closed="false">78:51 </char><char style="xt" closed="false"><ref loc="EXO 12:29">Kessa 12:29</ref></char></note><verse eid="PSA 78:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52" />Gido attiin izi ba asaa</para>
  <para style="q2" vid="PSA 78:52">dorsa mala kessi heemmides;</para>
  <para style="q2" vid="PSA 78:52">wude mala bazzon kaaleththides.<note caller="-" style="x"><char style="xo" closed="false">78:52 </char><char style="xt" closed="false"><ref loc="EXO 13:17-22">Kessa 13:17-22</ref></char></note><verse eid="PSA 78:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53" />Izi istta saron kaaleththides;</para>
  <para style="q2" vid="PSA 78:53">isttika hirgibeettenna;</para>
  <para style="q2" vid="PSA 78:53">istta morkketa gidikko</para>
  <para style="q2" vid="PSA 78:53">abbay mittides.<note caller="-" style="x"><char style="xo" closed="false">78:53 </char><char style="xt" closed="false"><ref loc="EXO 14:26-28">Kessa 14:26-28</ref></char></note><verse eid="PSA 78:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54" />Histtidi ba geeshsha biitta,</para>
  <para style="q2" vid="PSA 78:54">ba ushachcha kushen</para>
  <para style="q2" vid="PSA 78:54">xooni oykkida</para>
  <para style="q2" vid="PSA 78:54">zuma efides.<note caller="-" style="x"><char style="xo" closed="false">78:54 </char><char style="xt" closed="false"><ref loc="EXO 15:17">Kessa 15:17</ref>; <ref loc="JOS 3:14-17">Iya 3:14-17</ref></char></note><verse eid="PSA 78:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55" />Izi istta sinththafe</para>
  <para style="q2" vid="PSA 78:55">kawoteththaa gooddidi</para>
  <para style="q2" vid="PSA 78:55">istta biitta Isra7eele zaretas</para>
  <para style="q2" vid="PSA 78:55">gishereththi immidi</para>
  <para style="q2" vid="PSA 78:55">istta laatissides;</para>
  <para style="q2" vid="PSA 78:55">Isra7eele asaa</para>
  <para style="q2" vid="PSA 78:55">istta morkketa keeththan</para>
  <para style="q2" vid="PSA 78:55">woththides.<note caller="-" style="x"><char style="xo" closed="false">78:55 </char><char style="xt" closed="false"><ref loc="JOS 11:16-23">Iya 11:16-23</ref></char></note><verse eid="PSA 78:55" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56" />Istti gidikko Ubbaafe</para>
  <para style="q2" vid="PSA 78:56">Dhoqqa Xoossa bolla makkallida;</para>
  <para style="q2" vid="PSA 78:56">iza paaccidi iza wogatakka</para>
  <para style="q2" vid="PSA 78:56">naagontta ixxida.<note caller="-" style="x"><char style="xo" closed="false">78:56 </char><char style="xt" closed="false"><ref loc="JDG 2:11-15">Daanna 2:11-15</ref></char></note><verse eid="PSA 78:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57" />Istti beni bantta aawata mala</para>
  <para style="q2" vid="PSA 78:57">makkallanchchatanne</para>
  <para style="q2" vid="PSA 78:57">kaddizayta gidida;</para>
  <para style="q2" vid="PSA 78:57">ammanththontta bokka tooman</para>
  <para style="q2" vid="PSA 78:57">eqqida toora mala gidida.<verse eid="PSA 78:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58" />Istti goynniza dhoqqasohotan</para>
  <para style="q2" vid="PSA 78:58">iza yiillochchida;</para>
  <para style="q2" vid="PSA 78:58">bantta eeqa xoossatan</para>
  <para style="q2" vid="PSA 78:58">iza qanaatissida.<verse eid="PSA 78:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59" />Histtiin Xoossi hessa siyidi</para>
  <para style="q2" vid="PSA 78:59">keehi hanqettides;</para>
  <para style="q2" vid="PSA 78:59">Isra7eele mulera</para>
  <para style="q2" vid="PSA 78:59">yeggi aggaagides.<verse eid="PSA 78:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60" />Asaa giddon izi tokkida dunkaana</para>
  <para style="q2" vid="PSA 78:60">Seelon ba dizasoza yeggi aggides.<note caller="-" style="x"><char style="xo" closed="false">78:60 </char><char style="xt" closed="false"><ref loc="JOS 18:1">Iya 18:1</ref>; <ref loc="JER 7:12-14">Er 7:12-14</ref>; <ref loc="JER 26:6">26:6</ref></char></note><verse eid="PSA 78:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61" />Xoossa wolqqassinne</para>
  <para style="q2" vid="PSA 78:61">bonchchos malaata gidida</para>
  <para style="q2" vid="PSA 78:61">Taabotaa morkketa kushen</para>
  <para style="q2" vid="PSA 78:61">aaththi immides.<note caller="-" style="x"><char style="xo" closed="false">78:61 </char><char style="xt" closed="false"><ref loc="1SA 4:4-22">1Same 4:4-22</ref></char></note><verse eid="PSA 78:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62" />Izi ba deraa bolla hanqettides;</para>
  <para style="q2" vid="PSA 78:62">istta giththa mashshas</para>
  <para style="q2" vid="PSA 78:62">aaththi immides.<verse eid="PSA 78:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63" />Istta panththata tamay mides;</para>
  <para style="q2" vid="PSA 78:63">histtiin istta geela7oti</para>
  <para style="q2" vid="PSA 78:63">azina gelontta attida.<verse eid="PSA 78:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64" />Istta qeeseti mashshan wurida;</para>
  <para style="q2" vid="PSA 78:64">istta machchetikka</para>
  <para style="q2" vid="PSA 78:64">yeekkanaas dandaybeettenna.<verse eid="PSA 78:64" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65" />Hessafe guye Goday</para>
  <para style="q2" vid="PSA 78:65">dhiskofe beeggiza mala</para>
  <para style="q2" vid="PSA 78:65">beeggides;</para>
  <para style="q2" vid="PSA 78:65">woykko woyne ushshu uyi</para>
  <para style="q2" vid="PSA 78:65">maththottida qaray maththofe</para>
  <para style="q2" vid="PSA 78:65">beeggiza mala dendides.<verse eid="PSA 78:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66" />Izi ba morkketa shocidi</para>
  <para style="q2" vid="PSA 78:66">guye zaarides;</para>
  <para style="q2" vid="PSA 78:66">istti mernaas yeellatana mala</para>
  <para style="q2" vid="PSA 78:66">ooththides.<verse eid="PSA 78:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67" />Yooseefe dunkaane kadhides;</para>
  <para style="q2" vid="PSA 78:67">Efreeme qommota dooribeenna.<verse eid="PSA 78:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68" />Gido attiin izi Yuhuda zarenne</para>
  <para style="q2" vid="PSA 78:68">ba siiqiza Xiyoone</para>
  <para style="q2" vid="PSA 78:68">zumaa doorides.<verse eid="PSA 78:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69" />Hessan izi Xoossa Keeththaa</para>
  <para style="q2" vid="PSA 78:69">salo kessi dhoqqan keexxides;</para>
  <para style="q2" vid="PSA 78:69">sa7a mala mernaas essides.<verse eid="PSA 78:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70" />Ba aylle Dawite dooridi</para>
  <para style="q2" vid="PSA 78:70">dorsa wude heemmizasohoppe</para>
  <para style="q2" vid="PSA 78:70">ekkides.<note caller="-" style="x"><char style="xo" closed="false">78:70-71 </char><char style="xt" closed="false"><ref loc="1SA 16:11-12">1Same 16:11-12</ref>; <ref loc="2SA 7:8">2Same 7:8</ref>; <ref loc="1CH 17:7">1Taari 17:7</ref></char></note><verse eid="PSA 78:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71" />Iza dorsata heemmizasohoppe</para>
  <para style="q2" vid="PSA 78:71">kessidi ba dere Yaaqoobenne</para>
  <para style="q2" vid="PSA 78:71">ba xinxxo Isra7eele</para>
  <para style="q2" vid="PSA 78:71">heenththanchcha ooththides.<verse eid="PSA 78:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72" />Histtiin Dawitikka istta</para>
  <para style="q2" vid="PSA 78:72">suure wozinan heemmides;</para>
  <para style="q2" vid="PSA 78:72">qasseka hiillan</para>
  <para style="q2" vid="PSA 78:72">istta kaaleththides.<verse eid="PSA 78:72" /></para>
  <chapter eid="PSA 78" />
  <chapter number="79" style="c" sid="PSA 79" />
  <para style="s1">Aasaafe Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 79:1" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 79:1">Kawoteththati</para>
  <para style="q2" vid="PSA 79:1">ne biitta worajjida;</para>
  <para style="q2" vid="PSA 79:1">geeshsha gidida</para>
  <para style="q2" vid="PSA 79:1">Xoossa Keeththa tunisida;</para>
  <para style="q2" vid="PSA 79:1">Yerusalaame laalli yeggida.<note caller="-" style="x"><char style="xo" closed="false">79:1 </char><char style="xt" closed="false"><ref loc="2KI 25:8-10">2Kawo 25:8-10</ref>; <ref loc="2CH 36:17-19">2Taari 36:17-19</ref>; <ref loc="JER 52:12-14">Er 52:12-14</ref></char></note><verse eid="PSA 79:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2" />Istti ne aylleta aha</para>
  <para style="q2" vid="PSA 79:2">salo kafotas</para>
  <para style="q2" vid="PSA 79:2">quma ooththidi immida;</para>
  <para style="q2" vid="PSA 79:2">qasse ne geeshsha asata asho</para>
  <para style="q2" vid="PSA 79:2">sa7a do7atas immida.<verse eid="PSA 79:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3" />Istta suuth Yerusalaame yuushon</para>
  <para style="q2" vid="PSA 79:3">haaththa mala gussida;</para>
  <para style="q2" vid="PSA 79:3">istta aha</para>
  <para style="q2" vid="PSA 79:3">moogiza asi dhaydes.<verse eid="PSA 79:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4" />Nu shoorotas nuni qilccas gididos;</para>
  <para style="q2" vid="PSA 79:4">nu heeran dizaytas qidhessinne</para>
  <para style="q2" vid="PSA 79:4">miichchas attidos.<verse eid="PSA 79:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 79:5">Hayssi awude gakkanaas</para>
  <para style="q2" vid="PSA 79:5">hananee?</para>
  <para style="q2" vid="PSA 79:5">Neni mernaas hanqettanee?</para>
  <para style="q2" vid="PSA 79:5">Ne qanaatey tama mala</para>
  <para style="q2" vid="PSA 79:5">eexxishe de7anee?<verse eid="PSA 79:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6" />Nena erontta dereta bollanne</para>
  <para style="q2" vid="PSA 79:6">ne sunththa xeygontta</para>
  <para style="q2" vid="PSA 79:6">kawoteththata bolla</para>
  <para style="q2" vid="PSA 79:6">ne hanqoza gussa.<verse eid="PSA 79:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7" />Ays giikko istti</para>
  <para style="q2" vid="PSA 79:7">Yaaqoobe zereththata</para>
  <para style="q2" vid="PSA 79:7">wodhidanne</para>
  <para style="q2" vid="PSA 79:7">istti de7izasozikka</para>
  <para style="q2" vid="PSA 79:7">mulera dhayssida.<verse eid="PSA 79:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8" />Kase nu aawata nagara</para>
  <para style="q2" vid="PSA 79:8">nu bolla qoodoppa;</para>
  <para style="q2" vid="PSA 79:8">eeson ne maarotaa nuus kiitta;</para>
  <para style="q2" vid="PSA 79:8">ays giikko</para>
  <para style="q2" vid="PSA 79:8">nuni keehippe metotidos.<verse eid="PSA 79:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9" />Abeet nuna ashshiza Xoossawu!</para>
  <para style="q2" vid="PSA 79:9">Ne sunththa bonchcho gishshas</para>
  <para style="q2" vid="PSA 79:9">nuna maadda;</para>
  <para style="q2" vid="PSA 79:9">ne sunththa gishshas nuna ashsha;</para>
  <para style="q2" vid="PSA 79:9">nu nagarakka atto ga.<verse eid="PSA 79:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10" />Kawoteththati, Ays «Istta Xoossi</para>
  <para style="q2" vid="PSA 79:10">awan dizee?» gaanee?</para>
  <para style="q2" vid="PSA 79:10">Ne aylleta suuth</para>
  <para style="q2" vid="PSA 79:10">istti gussidayssa</para>
  <para style="q2" vid="PSA 79:10">neni halo kessizayssa</para>
  <para style="q2" vid="PSA 79:10">nu ayfey be7ishin</para>
  <para style="q2" vid="PSA 79:10">kawoteththata erisa.<verse eid="PSA 79:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11" />Qasho asata ooley</para>
  <para style="q2" vid="PSA 79:11">ne sinth gakko;</para>
  <para style="q2" vid="PSA 79:11">Hayqos pirdettidayta</para>
  <para style="q2" vid="PSA 79:11">ne mino qesen ashsha.<verse eid="PSA 79:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12" />Abeet Godawu!</para>
  <para style="q2" vid="PSA 79:12">Nu shooroti nena qidhidayssa</para>
  <para style="q2" vid="PSA 79:12">halo laappun kushe isttas zaara.<verse eid="PSA 79:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13" />He wode nuni ne deretinne</para>
  <para style="q2" vid="PSA 79:13">nees wude dorsati</para>
  <para style="q2" vid="PSA 79:13">mernaas galata nees immana;</para>
  <para style="q2" vid="PSA 79:13">yeletappe yeleta gakkanaas</para>
  <para style="q2" vid="PSA 79:13">neni nuus ooththida oosoza</para>
  <para style="q2" vid="PSA 79:13">nu yootana.<verse eid="PSA 79:13" /></para>
  <chapter eid="PSA 79" />
  <chapter number="80" style="c" sid="PSA 80" />
  <para style="s1">Zammareta kaabbos «Ciishsha» geetettiza diiththa giigson markkateththas yexettida Aasaafe mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 80:1" />Abeet Isra7eele heenththanchchawu!</para>
  <para style="q2" vid="PSA 80:1">Yooseefe nayta</para>
  <para style="q2" vid="PSA 80:1">wude mala kaaleththizayssoo!</para>
  <para style="q2" vid="PSA 80:1">Neni nu woosa siya;</para>
  <para style="q2" vid="PSA 80:1">Kirubeta bollara diza</para>
  <para style="q2" vid="PSA 80:1">araatan uttidayssoo!</para>
  <para style="q2" vid="PSA 80:1">Ne poo7on qoncca.<note caller="-" style="x"><char style="xo" closed="false">80:1 </char><char style="xt" closed="false"><ref loc="EXO 25:22">Kessa 25:22</ref></char></note><verse eid="PSA 80:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 80:2" />Efreeme, Biniyaamenne Minaase</para>
  <para style="q2" vid="PSA 80:2">sinththan qoncca beetta;</para>
  <para style="q2" vid="PSA 80:2">Ne wolqqa denththada</para>
  <para style="q2" vid="PSA 80:2">yaada nuna ashsha.<verse eid="PSA 80:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 80:3">Nuna zaara;</para>
  <para style="q2" vid="PSA 80:3">nuni attana mala</para>
  <para style="q2" vid="PSA 80:3">ne ayfeso nuus poo7isa.<verse eid="PSA 80:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4" />Abeet GODAWU</para>
  <para style="q2" vid="PSA 80:4">Ubbaafe Wolqqama Xoossawu!</para>
  <para style="q2" vid="PSA 80:4">Ne asaa woosa bolla</para>
  <para style="q2" vid="PSA 80:4">awude gakkanaas</para>
  <para style="q2" vid="PSA 80:4">ne hanqettanee?<verse eid="PSA 80:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5" />Neni istta yeeho</para>
  <para style="q2" vid="PSA 80:5">quma mala mizadasa;</para>
  <para style="q2" vid="PSA 80:5">qasse afunththa</para>
  <para style="q2" vid="PSA 80:5">haaththa mala ushshadasa.<verse eid="PSA 80:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6" />Nu shooroti nu biitta ekkanaas</para>
  <para style="q2" vid="PSA 80:6">bantta giddon ooyettana mala</para>
  <para style="q2" vid="PSA 80:6">ooththadasa;</para>
  <para style="q2" vid="PSA 80:6">nu morkketikka</para>
  <para style="q2" vid="PSA 80:6">nu bolla miiccida.<verse eid="PSA 80:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7" />Abeet Ubbaafe</para>
  <para style="q2" vid="PSA 80:7">Wolqqama Xoossawu!</para>
  <para style="q2" vid="PSA 80:7">Nuna zaara;</para>
  <para style="q2" vid="PSA 80:7">nuni attana mala</para>
  <para style="q2" vid="PSA 80:7">ne ayfeso nuus poo7isa.<verse eid="PSA 80:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8" />Neni Gibxeppe woyne ano ehadasa;</para>
  <para style="q2" vid="PSA 80:8">kawoteththata yedeththada</para>
  <para style="q2" vid="PSA 80:8">istta biittan izo tokkadasa.<verse eid="PSA 80:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9" />Neni izis biittaa qeexa giigsadasa;</para>
  <para style="q2" vid="PSA 80:9">histtiin xapho yeddada</para>
  <para style="q2" vid="PSA 80:9">biitta ubbaa gakkadus.<verse eid="PSA 80:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10" />Zumati izi kuwan,</para>
  <para style="q2" vid="PSA 80:10">Libaanoose zigati</para>
  <para style="q2" vid="PSA 80:10">izi haggatan kamettida.<verse eid="PSA 80:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11" />Ba haggata Mediteraane</para>
  <para style="q2" vid="PSA 80:11">Abba gakkanaas</para>
  <para style="q2" vid="PSA 80:11">qasse ba xeerata Efiraaxise</para>
  <para style="q2" vid="PSA 80:11">Shaafa gakkanaas yeddadus.<verse eid="PSA 80:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12" />Histtiin ogera aadhdhiza ubbay</para>
  <para style="q2" vid="PSA 80:12">izi ayfe duuththi maana mala</para>
  <para style="q2" vid="PSA 80:12">izi yuushozan diza gimbeza</para>
  <para style="q2" vid="PSA 80:12">ays laalladii?<verse eid="PSA 80:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13" />Bazzo guddunththi</para>
  <para style="q2" vid="PSA 80:13">izi bolla duri kaa7ees;</para>
  <para style="q2" vid="PSA 80:13">qasse wora do7ati</para>
  <para style="q2" vid="PSA 80:13">ubbay izo meettes.<verse eid="PSA 80:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14" />Abeet Ubbaafe</para>
  <para style="q2" vid="PSA 80:14">Wolqqama Xoossawu!</para>
  <para style="q2" vid="PSA 80:14">Neni nuukko simma;</para>
  <para style="q2" vid="PSA 80:14">salora duge xeellada nuna be7a;</para>
  <para style="q2" vid="PSA 80:14">hanno woyne miththayo naaga.<verse eid="PSA 80:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 80:15" />Iza ne ushachcha kushey</para>
  <para style="q2" vid="PSA 80:15">tokkida puute;</para>
  <para style="q2" vid="PSA 80:15">neni nees gaada dichchida aaca.<verse eid="PSA 80:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16" />Morkketi ne woyne qeexidi</para>
  <para style="q2" vid="PSA 80:16">taman xuuggida;</para>
  <para style="q2" vid="PSA 80:16">hessa gishshas neni istta</para>
  <para style="q2" vid="PSA 80:16">ne hanqoza suulen dhayssa.<verse eid="PSA 80:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17" />Ne kushey</para>
  <para style="q2" vid="PSA 80:17">ne ushachcha baggara diza asaa</para>
  <para style="q2" vid="PSA 80:17">neni nees dichchida asa naago.<verse eid="PSA 80:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18" />Hayssafe guye nuni</para>
  <para style="q2" vid="PSA 80:18">nena aggidi guye simmoko;</para>
  <para style="q2" vid="PSA 80:18">nuna shemppora paxa woththa;</para>
  <para style="q2" vid="PSA 80:18">nunikka nena galatana.<verse eid="PSA 80:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19" />Abeet Ubbaafe</para>
  <para style="q2" vid="PSA 80:19">Wolqqama Xoossawu!</para>
  <para style="q2" vid="PSA 80:19">Nuna zaara;</para>
  <para style="q2" vid="PSA 80:19">nuni attana mala</para>
  <para style="q2" vid="PSA 80:19">ne ayfeso nuus poo7isa.<verse eid="PSA 80:19" /></para>
  <chapter eid="PSA 80" />
  <chapter number="81" style="c" sid="PSA 81" />
  <para style="s1">Aasaafey zammareta kaabbos susul7en yexxida mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1" />Nuus wolqqa gidida</para>
  <para style="q2" vid="PSA 81:1">Xoossas ufayssan yexxite;</para>
  <para style="q2" vid="PSA 81:1">Yaaqoobe Xoossas ililite!<verse eid="PSA 81:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2" />Yeth doommite;</para>
  <para style="q2" vid="PSA 81:2">karabe baqqite;</para>
  <para style="q2" vid="PSA 81:2">diiththaninne maasinqon</para>
  <para style="q2" vid="PSA 81:2">lo7o mazamure yexxite.<verse eid="PSA 81:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3" />Aginay xeeriza wodenne</para>
  <para style="q2" vid="PSA 81:3">dhuman geliza wode</para>
  <para style="q2" vid="PSA 81:3">ba7aales zaye punnite.<note caller="-" style="x"><char style="xo" closed="false">81:3 </char><char style="xt" closed="false"><ref loc="NUM 10:10">Tay 10:10</ref></char></note><verse eid="PSA 81:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4" />Hayssi Isra7eeles woga;</para>
  <para style="q2" vid="PSA 81:4">Yaaqoobe Xoossay immida azazo.<verse eid="PSA 81:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5" />Gibxe biitta izi yeddi kezida wode</para>
  <para style="q2" vid="PSA 81:5">Yooseefe zaretas</para>
  <para style="q2" vid="PSA 81:5">woga histti woththides;</para>
  <para style="q2" vid="PSA 81:5">tani erontta qaalara izi taas,<verse eid="PSA 81:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6" />«Intte hasheppe tooho woththadis;</para>
  <para style="q2" vid="PSA 81:6">intte kushe deexo</para>
  <para style="q2" vid="PSA 81:6">gooshoppe shempisadis.<verse eid="PSA 81:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7" />Intte meto wode</para>
  <para style="q2" vid="PSA 81:7">tana xeygideta;</para>
  <para style="q2" vid="PSA 81:7">histtiin tani inttena ashshadis;</para>
  <para style="q2" vid="PSA 81:7">tani shaara giddora dadan</para>
  <para style="q2" vid="PSA 81:7">inttena alladis;</para>
  <para style="q2" vid="PSA 81:7">Mariiba geetettiza</para>
  <para style="q2" vid="PSA 81:7">pultto haaththa matan</para>
  <para style="q2" vid="PSA 81:7">tani inttena paaccadis.<note caller="-" style="x"><char style="xo" closed="false">81:7 </char><char style="xt" closed="false"><ref loc="EXO 17:7">Kessa 17:7</ref>; <ref loc="NUM 20:13">Tay 20:13</ref></char></note><verse eid="PSA 81:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8" />«Ta derezoo!</para>
  <para style="q2" vid="PSA 81:8">Tani nena seerizayssa siya!</para>
  <para style="q2" vid="PSA 81:8">Isra7eele asawu!</para>
  <para style="q2" vid="PSA 81:8">Ne tana ezga siyidaakko</para>
  <para style="q2" vid="PSA 81:8">aazee dizay!<verse eid="PSA 81:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9" />Intte giddon allaga xoossi dooppo;</para>
  <para style="q2" vid="PSA 81:9">hara xoossas goynnofte.<verse eid="PSA 81:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10" />Tani GODAA intte Xoossaa;</para>
  <para style="q2" vid="PSA 81:10">inttena Gibxe biittafe kessada</para>
  <para style="q2" vid="PSA 81:10">ehiday tana intte GODAA;</para>
  <para style="q2" vid="PSA 81:10">ne doona keeha hanga;</para>
  <para style="q2" vid="PSA 81:10">tani nena tuththana.<note caller="-" style="x"><char style="xo" closed="false">81:9-10 </char><char style="xt" closed="false"><ref loc="EXO 20:2-3">Kessa 20:2-3</ref>; <ref loc="DEU 5:6-7">Zaare 5:6-7</ref></char></note><verse eid="PSA 81:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11" />«Gido attiin ta asati</para>
  <para style="q2" vid="PSA 81:11">ta qaala siyibeettenna;</para>
  <para style="q2" vid="PSA 81:11">Isra7eeleti taas</para>
  <para style="q2" vid="PSA 81:11">kushe immibeettenna.<verse eid="PSA 81:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12" />Hessa gishshas tani</para>
  <para style="q2" vid="PSA 81:12">istti ba wozina</para>
  <para style="q2" vid="PSA 81:12">muumeteththaaththo</para>
  <para style="q2" vid="PSA 81:12">ba dosoyssa hanana mala</para>
  <para style="q2" vid="PSA 81:12">aggaagadis.<verse eid="PSA 81:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13" />«Ta derey tana siyidaakkoo!</para>
  <para style="q2" vid="PSA 81:13">Isra7eele asay</para>
  <para style="q2" vid="PSA 81:13">ta oge kaallidaakko!<verse eid="PSA 81:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14" />Tani istta morkketa</para>
  <para style="q2" vid="PSA 81:14">isttas gulbatissana;</para>
  <para style="q2" vid="PSA 81:14">istta baaligaaratakka</para>
  <para style="q2" vid="PSA 81:14">ta shocanakkoshin.<verse eid="PSA 81:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15" />GODAA ixxizayti</para>
  <para style="q2" vid="PSA 81:15">iza sinththan kundana;</para>
  <para style="q2" vid="PSA 81:15">istti mernaas qaxxayettana.<verse eid="PSA 81:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16" />Gido attiin tani inttena</para>
  <para style="q2" vid="PSA 81:16">muuruta gistte mizana;</para>
  <para style="q2" vid="PSA 81:16">qasse zaallaafe inttena</para>
  <para style="q2" vid="PSA 81:16">ees kalssana» gishin siyadis.<verse eid="PSA 81:16" /></para>
  <chapter eid="PSA 81" />
  <chapter number="82" style="c" sid="PSA 82" />
  <para style="s1">Aasaafe Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1" />Xoossi salon diza duulata kaaleththees;</para>
  <para style="q2" vid="PSA 82:1">xoossati ubbay shiiqiin</para>
  <para style="q2" vid="PSA 82:1">istta bolla pirdishe,<note caller="+" style="f"><char style="fr" closed="false">82:1 </char><char style="ft" closed="false">Xoossata hayssi ha qaalazi kawota, daannata, asa bolla dumma dumma ogera pirdizayta, kiitanchchatanne eeqa xoossata bessees.</char></note><verse eid="PSA 82:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2" />«Intte awude gakkanawu</para>
  <para style="q2" vid="PSA 82:2">geella pirda pirdanee?</para>
  <para style="q2" vid="PSA 82:2">Iitatakka awude gakkanaas</para>
  <para style="q2" vid="PSA 82:2">maaddanee?<verse eid="PSA 82:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3" />Wolqqay bayndaytassinne yi7otas</para>
  <para style="q2" vid="PSA 82:3">tuma pirda pirdite;</para>
  <para style="q2" vid="PSA 82:3">manqonne naaqettida asata</para>
  <para style="q2" vid="PSA 82:3">maata naagissite.<verse eid="PSA 82:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4" />Daaburanchchatanne</para>
  <para style="q2" vid="PSA 82:4">metotanchchata ashshite;</para>
  <para style="q2" vid="PSA 82:4">iitata kusheppeka</para>
  <para style="q2" vid="PSA 82:4">istta woththi ekkite.<verse eid="PSA 82:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5" />«Inttes aykko erateththinne</para>
  <para style="q2" vid="PSA 82:5">akeekay deenna;</para>
  <para style="q2" vid="PSA 82:5">intte dhuman simeretteeta;</para>
  <para style="q2" vid="PSA 82:5">biitta yochchati</para>
  <para style="q2" vid="PSA 82:5">ubbay qaaxxeettes.<verse eid="PSA 82:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6" />«Tani inttena, ‹Intte xoossata;</para>
  <para style="q2" vid="PSA 82:6">intte ubbayka</para>
  <para style="q2" vid="PSA 82:6">Ubbaafe Dhoqqa Xoossa</para>
  <para style="q2" vid="PSA 82:6">nayta› gadis.<note caller="-" style="x"><char style="xo" closed="false">82:6 </char><char style="xt" closed="false"><ref loc="JHN 10:34">Yoha 10:34</ref></char></note><verse eid="PSA 82:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7" />‹Gido attiin intte</para>
  <para style="q2" vid="PSA 82:7">asi hayqqiza mala hayqqana;</para>
  <para style="q2" vid="PSA 82:7">Qasse hara halaqati kundiza mala</para>
  <para style="q2" vid="PSA 82:7">intteka kundana› gays» gees.<verse eid="PSA 82:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8" />Abeet Xoossawu! Denda!</para>
  <para style="q2" vid="PSA 82:8">Sa7a bolla pirda;</para>
  <para style="q2" vid="PSA 82:8">kawoteththi ubbay neessa.<verse eid="PSA 82:8" /></para>
  <chapter eid="PSA 82" />
  <chapter number="83" style="c" sid="PSA 83" />
  <para style="s1">Aasaafe Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 83:1" />Abeet Xoossawu! Co7u gooppa!</para>
  <para style="q2" vid="PSA 83:1">sirphi gooppa!</para>
  <para style="q2" vid="PSA 83:1">Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 83:1">qelli gooppa!<verse eid="PSA 83:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2" />Be7a! Ne morkketi ne bolla dendida;</para>
  <para style="q2" vid="PSA 83:2">nena ixxizayti ne bolla</para>
  <para style="q2" vid="PSA 83:2">ba qoodhe qaaththida.<verse eid="PSA 83:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3" />Istti ne asa bolla</para>
  <para style="q2" vid="PSA 83:3">geeman gene duulatida;</para>
  <para style="q2" vid="PSA 83:3">neni siiqiza asata bolla</para>
  <para style="q2" vid="PSA 83:3">maqettida.<verse eid="PSA 83:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4" />Istti, «Haa yiite!</para>
  <para style="q2" vid="PSA 83:4">Istta kawoteththa dhayssoos;</para>
  <para style="q2" vid="PSA 83:4">Isra7eele geetettiza sunththi</para>
  <para style="q2" vid="PSA 83:4">mernaas hassa7ettontta mala</para>
  <para style="q2" vid="PSA 83:4">ooththoos» gida.<verse eid="PSA 83:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5" />Istti issi wozina gididi</para>
  <para style="q2" vid="PSA 83:5">issife maqettida;</para>
  <para style="q2" vid="PSA 83:5">ne bolla dendanaas caaqettida.<verse eid="PSA 83:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6" />Isttika Eedoome asata,</para>
  <para style="q2" vid="PSA 83:6">Isma7eele asata,</para>
  <para style="q2" vid="PSA 83:6">Mo7aabe zareta, Aggaari zareta,<verse eid="PSA 83:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="PSA 83:7" />Gebaale asata, Amoone asata,</para>
  <para style="q2" vid="PSA 83:7">Amaaleeqe asata, Filisxeeme</para>
  <para style="q2" vid="PSA 83:7">asatanne Xiroose asata.<verse eid="PSA 83:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8" />Asoore asati isttara</para>
  <para style="q2" vid="PSA 83:8">issifeteth medhdhida;</para>
  <para style="q2" vid="PSA 83:8">Looxe zaretaskka maado gidida.<verse eid="PSA 83:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9" />Neni Midiyaame asata bolla,</para>
  <para style="q2" vid="PSA 83:9">Sisaaranne Yaabine bolla</para>
  <para style="q2" vid="PSA 83:9">Qisoone Shaafan ooththida</para>
  <para style="q2" vid="PSA 83:9">mala istta bolla ooththa.<note caller="-" style="x"><char style="xo" closed="false">83:9 </char><char style="xt" closed="false"><ref loc="JDG 4:6-22">Daanna 4:6-22</ref>; <ref loc="JDG 7:1-23">7:1-23</ref></char></note><verse eid="PSA 83:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10" />Istti En-Doore</para>
  <para style="q2" vid="PSA 83:10">geetettizason dhayda;</para>
  <para style="q2" vid="PSA 83:10">istta ahay moogettontta</para>
  <para style="q2" vid="PSA 83:10">biitta bolla wooqqides.<verse eid="PSA 83:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11" />Oreebe bollanne</para>
  <para style="q2" vid="PSA 83:11">Za7eebe bolla ooththida mala</para>
  <para style="q2" vid="PSA 83:11">istta halaqata bolla ooththa;</para>
  <para style="q2" vid="PSA 83:11">Zebahanne Xalmuna</para>
  <para style="q2" vid="PSA 83:11">dhayssida mala</para>
  <para style="q2" vid="PSA 83:11">istta haarizaytakka neni dhayssa.<note caller="-" style="x"><char style="xo" closed="false">83:11 </char><char style="xt" closed="false"><ref loc="JDG 7:25">Daanna 7:25</ref>; <ref loc="JDG 8:12">8:12</ref></char></note><verse eid="PSA 83:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12" />Heyti, «Nuni Xoossa asaa biitta</para>
  <para style="q2" vid="PSA 83:12">nuus buzoththana» gidayta.<verse eid="PSA 83:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13" />Abeet ta Xoossawu!</para>
  <para style="q2" vid="PSA 83:13">Istta gudulla mala laalla;</para>
  <para style="q2" vid="PSA 83:13">carkoy efiza suulla mala ooththa.<verse eid="PSA 83:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14" />Xaragay wora miidi wursiza mala,</para>
  <para style="q2" vid="PSA 83:14">tama lacoy</para>
  <para style="q2" vid="PSA 83:14">zuma may7iza mala,<verse eid="PSA 83:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="PSA 83:15" />goten ne istta daganththa;</para>
  <para style="q2" vid="PSA 83:15">ne uushonkka istta yedeththa.<verse eid="PSA 83:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 83:16">Asay ne sunth koyana mala</para>
  <para style="q2" vid="PSA 83:16">neni istta ayfeso yeella mayza.<verse eid="PSA 83:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17" />Istti mernaas yeellatetto;</para>
  <para style="q2" vid="PSA 83:17">hirgettonne kawuyi dhayetto.<verse eid="PSA 83:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18" />Ne sunththay GODAA</para>
  <para style="q2" vid="PSA 83:18">gididayssanne</para>
  <para style="q2" vid="PSA 83:18">sa7a ubbaa bolla neni xalla</para>
  <para style="q2" vid="PSA 83:18">Ubbaafe Dhoqqa Xoossa</para>
  <para style="q2" vid="PSA 83:18">gididayssa istti eretto.<verse eid="PSA 83:18" /></para>
  <chapter eid="PSA 83" />
  <chapter number="84" style="c" sid="PSA 84" />
  <para style="s1">Qoore Nayti Zammareta Kaabbos Susul7en Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 84:1" />Abeet medheteththa GODAWU!</para>
  <para style="q2" vid="PSA 84:1">neni de7izasoy ay mala lo7osoo!<verse eid="PSA 84:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2" />Tani GODAA Keeththa</para>
  <para style="q2" vid="PSA 84:2">zago laamotays;</para>
  <para style="q2" vid="PSA 84:2">tani kumeththa wozinappe</para>
  <para style="q2" vid="PSA 84:2">de7o Xoossas</para>
  <para style="q2" vid="PSA 84:2">ufayssan yexxays.<verse eid="PSA 84:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3" />Abeet Ubbaafe</para>
  <para style="q2" vid="PSA 84:3">Wolqqama GODAWU!</para>
  <para style="q2" vid="PSA 84:3">Ta kawozo Xoossawu!</para>
  <para style="q2" vid="PSA 84:3">Nees yarsho yarshizasoza matan</para>
  <para style="q2" vid="PSA 84:3">siine kafoy baas</para>
  <para style="q2" vid="PSA 84:3">de7izaso demmadus.</para>
  <para style="q2" vid="PSA 84:3">Haraphpheyakka</para>
  <para style="q2" vid="PSA 84:3">baas yelizaso keexxadus.<verse eid="PSA 84:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4" />Ne Keeththan de7izaytinne</para>
  <para style="q2" vid="PSA 84:4">mernaas nena sabbizayti</para>
  <para style="q2" vid="PSA 84:4">anjjettidayta.<verse eid="PSA 84:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5" />Banttas nena wolqqa ooththizayti,</para>
  <para style="q2" vid="PSA 84:5">Xiyoone oge ba wozinan</para>
  <para style="q2" vid="PSA 84:5">amottizayti anjjettidayta.<verse eid="PSA 84:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6" />Bakka geetettiza haaththi baynda</para>
  <para style="q2" vid="PSA 84:6">shaafara istti kanththiza wode</para>
  <para style="q2" vid="PSA 84:6">he sohon pulttoy dhuuqqana;</para>
  <para style="q2" vid="PSA 84:6">Badhdhesa iraykka bukkidi</para>
  <para style="q2" vid="PSA 84:6">biitta kalssana.<note caller="+" style="f"><char style="fr" closed="false">84:6 </char><char style="ft" closed="false">Bakka gizayssa dumma dumma Geeshsha Maxaafati yeeho shoobba geettes.</char></note><verse eid="PSA 84:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7" />Istti wolqqa bolla wolqqa</para>
  <para style="q2" vid="PSA 84:7">gujji gujji baana;</para>
  <para style="q2" vid="PSA 84:7">Istti Xoossa sinththan</para>
  <para style="q2" vid="PSA 84:7">Xiyoonen beettana.<verse eid="PSA 84:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8" />Abeet Ubbaafe</para>
  <para style="q2" vid="PSA 84:8">Wolqqama GODAWU!</para>
  <para style="q2" vid="PSA 84:8">Ta woosa neni siya.</para>
  <para style="q2" vid="PSA 84:8">Abeet Yaaqoobe Xoossawu!</para>
  <para style="q2" vid="PSA 84:8">Ta gizaaz ezga.<verse eid="PSA 84:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 84:9">Neni doora tiyda</para>
  <para style="q2" vid="PSA 84:9">nu kawoza anjja;</para>
  <para style="q2" vid="PSA 84:9">izi nuus gondalle gidida gishshas</para>
  <para style="q2" vid="PSA 84:9">ne iza xeella.<verse eid="PSA 84:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10" />Harason shii gallas de7anaappe</para>
  <para style="q2" vid="PSA 84:10">Xoossa Keeththan</para>
  <para style="q2" vid="PSA 84:10">issi gallas duussi lo7o;</para>
  <para style="q2" vid="PSA 84:10">Iitata dunkaanen daanaappe</para>
  <para style="q2" vid="PSA 84:10">Xoossa Keeththa zagon</para>
  <para style="q2" vid="PSA 84:10">zabe gideththi taas lo7o.<verse eid="PSA 84:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11" />GODAY nuus arshenne gondalle;</para>
  <para style="q2" vid="PSA 84:11">izi ayoteththaninne</para>
  <para style="q2" vid="PSA 84:11">bonchchon nuna naagees;</para>
  <para style="q2" vid="PSA 84:11">Suureteththan hemettizayta</para>
  <para style="q2" vid="PSA 84:11">izi lo7o miish diggenna.<verse eid="PSA 84:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12" />Abeet Ubbaafe</para>
  <para style="q2" vid="PSA 84:12">Wolqqama GODAWU!</para>
  <para style="q2" vid="PSA 84:12">Nenan ammanettizayti</para>
  <para style="q2" vid="PSA 84:12">anjjettidayta.<verse eid="PSA 84:12" /></para>
  <chapter eid="PSA 84" />
  <chapter number="85" style="c" sid="PSA 85" />
  <para style="s1">Qoore Nayti Zammareta Kaabbos Diiththan Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 85:1">Neni ne biittas</para>
  <para style="q2" vid="PSA 85:1">kiyateth bessadasa;</para>
  <para style="q2" vid="PSA 85:1">Yaaqoobe di7ettidasoppe</para>
  <para style="q2" vid="PSA 85:1">zaaradasa.<verse eid="PSA 85:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2" />Neni ne asaa naaqo atto gadasa;</para>
  <para style="q2" vid="PSA 85:2">istta nagara ubbaa kammadasa.<verse eid="PSA 85:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3" />Neni yiillotizayssa ubbaa aggadasa;</para>
  <para style="q2" vid="PSA 85:3">suulliza ne hanqofekka</para>
  <para style="q2" vid="PSA 85:3">simmadasa.<verse eid="PSA 85:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4" />Abeet nuna ashshiza Xoossawu!</para>
  <para style="q2" vid="PSA 85:4">Ne nuna zaara;</para>
  <para style="q2" vid="PSA 85:4">Neni nu bolla</para>
  <para style="q2" vid="PSA 85:4">lanccettidayssa agga.<verse eid="PSA 85:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5" />Neni nuna mernaas hanqettanee?</para>
  <para style="q2" vid="PSA 85:5">Ne hanqoy yeletappe</para>
  <para style="q2" vid="PSA 85:5">yeleta gakkanawu gam7anee?<verse eid="PSA 85:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6" />Ne asay nenan ufayettana mala,</para>
  <para style="q2" vid="PSA 85:6">ne nuna ooraxissikii!<verse eid="PSA 85:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 85:7">Ne mernaa siiqoza nuna bessa;</para>
  <para style="q2" vid="PSA 85:7">neni nuna ashsha.<verse eid="PSA 85:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8" />Tani GODAA Xoossi</para>
  <para style="q2" vid="PSA 85:8">yootizayssa siyana;</para>
  <para style="q2" vid="PSA 85:8">istti simmidi</para>
  <para style="q2" vid="PSA 85:8">bala ogen bontta aggiko,</para>
  <para style="q2" vid="PSA 85:8">ba geeshsha deraas</para>
  <para style="q2" vid="PSA 85:8">Saroteth ehanaas</para>
  <para style="q2" vid="PSA 85:8">hidota immides.<verse eid="PSA 85:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9" />Iza bonchchoy</para>
  <para style="q2" vid="PSA 85:9">nu biittan daana mala</para>
  <para style="q2" vid="PSA 85:9">atoteththay izas yayyizaytas</para>
  <para style="q2" vid="PSA 85:9">matan dees.<verse eid="PSA 85:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10" />Siiqoynne tumateththi</para>
  <para style="q2" vid="PSA 85:10">issife sigetteettes;</para>
  <para style="q2" vid="PSA 85:10">Xilloteththinne saroteththi</para>
  <para style="q2" vid="PSA 85:10">issife idimetteettes.<verse eid="PSA 85:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11" />Ammaneteththi sa7appe</para>
  <para style="q2" vid="PSA 85:11">pude kezana;</para>
  <para style="q2" vid="PSA 85:11">Xoossa Xilloteththi</para>
  <para style="q2" vid="PSA 85:11">saloppe duge wodhdhana.<verse eid="PSA 85:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12" />Be7ite! GODAY lo7o miish immana;</para>
  <para style="q2" vid="PSA 85:12">nu biittayka lo7o kath mokisana.<verse eid="PSA 85:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13" />Xilloteththi izappe</para>
  <para style="q2" vid="PSA 85:13">sinththara baana;</para>
  <para style="q2" vid="PSA 85:13">izi baanaasokka izas giigsana.<verse eid="PSA 85:13" /></para>
  <chapter eid="PSA 85" />
  <chapter number="86" style="c" sid="PSA 86" />
  <para style="s1">Dawite Woosa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 86:1">Tani hiyeesanne metotanchcha</para>
  <para style="q2" vid="PSA 86:1">gidida gishshas</para>
  <para style="q2" vid="PSA 86:1">ta waasoza siyada</para>
  <para style="q2" vid="PSA 86:1">taas zaaro imma.<verse eid="PSA 86:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2" />Tani nees dumma as gidida gishshas</para>
  <para style="q2" vid="PSA 86:2">ne ta shemppo naaga;</para>
  <para style="q2" vid="PSA 86:2">neni ta Xoossa;</para>
  <para style="q2" vid="PSA 86:2">nenan ammanettiza</para>
  <para style="q2" vid="PSA 86:2">ne aylleza tana ashsha.<verse eid="PSA 86:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3" />Abeet Godawu!</para>
  <para style="q2" vid="PSA 86:3">Kumeththa gallas</para>
  <para style="q2" vid="PSA 86:3">ta neekko waassiza gishshas</para>
  <para style="q2" vid="PSA 86:3">ne tana maara.<verse eid="PSA 86:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4" />Abeet Godawu!</para>
  <para style="q2" vid="PSA 86:4">Tani wozinappe</para>
  <para style="q2" vid="PSA 86:4">nena woossiza gishshas</para>
  <para style="q2" vid="PSA 86:4">tana ne aylleza ufayssa.<verse eid="PSA 86:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5" />Abeet Godawu!</para>
  <para style="q2" vid="PSA 86:5">Neni nuus kiyanne atto gizaade;</para>
  <para style="q2" vid="PSA 86:5">nena woossiza ubbaas</para>
  <para style="q2" vid="PSA 86:5">ne mernaa siiqo bessaasa.<verse eid="PSA 86:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 86:6">Ta woosa siya;</para>
  <para style="q2" vid="PSA 86:6">ta shoobba woossizayssa ezga.<verse eid="PSA 86:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7" />Ne taas zaaro immiza gishshas</para>
  <para style="q2" vid="PSA 86:7">tani meto gallassan</para>
  <para style="q2" vid="PSA 86:7">neekko waassays.<verse eid="PSA 86:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8" />Abeet Godawu!</para>
  <para style="q2" vid="PSA 86:8">Ne malay xoossata giddon baawa;</para>
  <para style="q2" vid="PSA 86:8">ne oosora ginattiza</para>
  <para style="q2" vid="PSA 86:8">oosoykka deenna.<verse eid="PSA 86:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9" />Abeet Godawu!</para>
  <para style="q2" vid="PSA 86:9">Neni medhdhida</para>
  <para style="q2" vid="PSA 86:9">kawoteththay ubbay</para>
  <para style="q2" vid="PSA 86:9">neekko yiidi nees goynnana;</para>
  <para style="q2" vid="PSA 86:9">ne sunththaaka bonchchana.<note caller="-" style="x"><char style="xo" closed="false">86:9 </char><char style="xt" closed="false"><ref loc="REV 15:4">Ajju 15:4</ref></char></note><verse eid="PSA 86:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10" />Neni gita;</para>
  <para style="q2" vid="PSA 86:10">malalisiza miish ooththaasa.</para>
  <para style="q2" vid="PSA 86:10">Neni xalla Xoossa.<verse eid="PSA 86:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 86:11">Tani ne tuman baana mala</para>
  <para style="q2" vid="PSA 86:11">tana ne oge tamaarsa;</para>
  <para style="q2" vid="PSA 86:11">tani ne sunththas yayyana mala</para>
  <para style="q2" vid="PSA 86:11">taas issi wozina imma.<verse eid="PSA 86:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12" />Abeet Godaa ta Xoossawu!</para>
  <para style="q2" vid="PSA 86:12">Tani nena</para>
  <para style="q2" vid="PSA 86:12">ta kumeththa</para>
  <para style="q2" vid="PSA 86:12">wozinappe galatana;</para>
  <para style="q2" vid="PSA 86:12">Ne sunththaaka</para>
  <para style="q2" vid="PSA 86:12">mernaas bonchchana.<verse eid="PSA 86:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13" />Ays giikko ne tana bessida</para>
  <para style="q2" vid="PSA 86:13">mernaa siiqoy keehi gita;</para>
  <para style="q2" vid="PSA 86:13">neni ta shemppoyo</para>
  <para style="q2" vid="PSA 86:13">duufoppe ashshadasa.<verse eid="PSA 86:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14" />Abeet Xoossawu! Otoranchchati</para>
  <para style="q2" vid="PSA 86:14">ta bolla dendida;</para>
  <para style="q2" vid="PSA 86:14">tana wodhana koyidi</para>
  <para style="q2" vid="PSA 86:14">pangati duulateettes;</para>
  <para style="q2" vid="PSA 86:14">nena wudankka yeggibeettenna.<verse eid="PSA 86:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15" />Gido attiin abeet Godawu!</para>
  <para style="q2" vid="PSA 86:15">Neni qadhettizaadenne</para>
  <para style="q2" vid="PSA 86:15">maariza Xoossa;</para>
  <para style="q2" vid="PSA 86:15">hanqettanaas gam7iza Xoossa;</para>
  <para style="q2" vid="PSA 86:15">ne siiqoynne ne ammaneteththay</para>
  <para style="q2" vid="PSA 86:15">keehi daro.<verse eid="PSA 86:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16" />Taakko simmada taas qadhetta;</para>
  <para style="q2" vid="PSA 86:16">taas ne ayllezas wolqqa imma;</para>
  <para style="q2" vid="PSA 86:16">ne aylley naaza tana ashsha.<verse eid="PSA 86:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 86:17">ne tana maaddizayssanne</para>
  <para style="q2" vid="PSA 86:17">minththeththizayssa</para>
  <para style="q2" vid="PSA 86:17">tana ixxizayti be7idi</para>
  <para style="q2" vid="PSA 86:17">yeellatana mala</para>
  <para style="q2" vid="PSA 86:17">ne kiyateththa malata tana bessa.<verse eid="PSA 86:17" /></para>
  <chapter eid="PSA 86" />
  <chapter number="87" style="c" sid="PSA 87" />
  <para style="s1">Qoore Nayti Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1" />GODAA katamay</para>
  <para style="q2" vid="PSA 87:1">geeshsha zuma bolla keexettides.<verse eid="PSA 87:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 87:2" />GODAY Xiyoone pengeta</para>
  <para style="q2" vid="PSA 87:2">Yaaqoobey dizasota</para>
  <para style="q2" vid="PSA 87:2">ubbaafe aaththi siiqees.<verse eid="PSA 87:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3" />Hanne Xoossa katamayee!</para>
  <para style="q2" vid="PSA 87:3">Xoossay ne gishshas</para>
  <para style="q2" vid="PSA 87:3">malalisiza miish,<verse eid="PSA 87:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4" />«Tana eriza kawoteththata giddofe</para>
  <para style="q2" vid="PSA 87:4">Gibxenne Baabiloone</para>
  <para style="q2" vid="PSA 87:4">gaththa mazgabashe</para>
  <para style="q2" vid="PSA 87:4">Filisxeeme, Xiroosenne</para>
  <para style="q2" vid="PSA 87:4">Tophphiya asaa gujjana» gees.<verse eid="PSA 87:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5" />Xiyoone gishshas, «Ubbaa asay</para>
  <para style="q2" vid="PSA 87:5">izin yelettides;</para>
  <para style="q2" vid="PSA 87:5">Ubbaafe Dhoqqa Xoossi</para>
  <para style="q2" vid="PSA 87:5">izo minththi essana» geetettana.<verse eid="PSA 87:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6" />GODAY deraa ubbaa mazgabishe,</para>
  <para style="q2" vid="PSA 87:6">«Hayssi Xiyoonin yelettides»</para>
  <para style="q2" vid="PSA 87:6">giidi xaafana.<verse eid="PSA 87:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7" />Yexxizaytinne guppizayti,</para>
  <para style="q2" vid="PSA 87:7">«Nu anjjo ubbay</para>
  <para style="q2" vid="PSA 87:7">Xiyoonippe pulttees»</para>
  <para style="q2" vid="PSA 87:7">gishe ufayssan yexxana.<verse eid="PSA 87:7" /></para>
  <chapter eid="PSA 87" />
  <chapter number="88" style="c" sid="PSA 88" />
  <para style="s1">Izra7eele as Emaaney soren shiishshida ginxo Qoore nayti zammareta kaabbos diiththa giigson yexxida mazamure</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 88:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 88:1">tana ashshiza Xoossawu!</para>
  <para style="q2" vid="PSA 88:1">Tani gallassinne omars</para>
  <para style="q2" vid="PSA 88:1">ne sinththan yeekkays.<verse eid="PSA 88:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2" />Ta waasoy ne sinththi gakko;</para>
  <para style="q2" vid="PSA 88:2">ne hayth ta woosakko zaara.<verse eid="PSA 88:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3" />Ays giikko ta de7oy</para>
  <para style="q2" vid="PSA 88:3">meton kumides;</para>
  <para style="q2" vid="PSA 88:3">tani hayqqana matadis.<verse eid="PSA 88:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4" />Tani duufon geliza</para>
  <para style="q2" vid="PSA 88:4">asatara qoodettadis;</para>
  <para style="q2" vid="PSA 88:4">wolqqay baynda as gidadis.<verse eid="PSA 88:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5" />Tani ahata giddon</para>
  <para style="q2" vid="PSA 88:5">olettida asa mala,</para>
  <para style="q2" vid="PSA 88:5">hayqqidi duufon moogettida</para>
  <para style="q2" vid="PSA 88:5">aha mala,</para>
  <para style="q2" vid="PSA 88:5">tani ubbaaka</para>
  <para style="q2" vid="PSA 88:5">neni dogida asa malanne</para>
  <para style="q2" vid="PSA 88:5">ne maadoppe duuxxida</para>
  <para style="q2" vid="PSA 88:5">asa mala gidadis.<verse eid="PSA 88:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6" />Neni tana ciimma ollan,</para>
  <para style="q2" vid="PSA 88:6">duge dhuma sohon yeggadasa.<verse eid="PSA 88:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7" />Ne hanqoy tana deexxees;</para>
  <para style="q2" vid="PSA 88:7">ne hanqoza dambalay</para>
  <para style="q2" vid="PSA 88:7">tana mulera mittides.<verse eid="PSA 88:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8" />Neni ta laggeta taappe haassadasa;</para>
  <para style="q2" vid="PSA 88:8">istti tana shuunettana mala</para>
  <para style="q2" vid="PSA 88:8">ooththadasa;</para>
  <para style="q2" vid="PSA 88:8">tana giddoththida;</para>
  <para style="q2" vid="PSA 88:8">kessa ekkanawukka dandaykke.<verse eid="PSA 88:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 88:9" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 88:9">Kayo gaason ta ayfeti doljumida;</para>
  <para style="q2" vid="PSA 88:9">Ubbaa gallas</para>
  <para style="q2" vid="PSA 88:9">tani neekko waassays;</para>
  <para style="q2" vid="PSA 88:9">ta kushetakka neekko miccays.<verse eid="PSA 88:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10" />Neni hayqqidaytas</para>
  <para style="q2" vid="PSA 88:10">malalisiza miish ooththay?</para>
  <para style="q2" vid="PSA 88:10">Istti dendidi nena galatanee?<verse eid="PSA 88:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11" />Ne mernaa siiqoy duufon</para>
  <para style="q2" vid="PSA 88:11">ne ammaneteththayka</para>
  <para style="q2" vid="PSA 88:11">bashshason yootettizee?<verse eid="PSA 88:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12" />Ne malalisiza oosoy</para>
  <para style="q2" vid="PSA 88:12">dhuman erettizee?</para>
  <para style="q2" vid="PSA 88:12">Woykko ne xilloteththay</para>
  <para style="q2" vid="PSA 88:12">dogettida asata biittan beettanee?<verse eid="PSA 88:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 88:13">Neni tana maaddana mala</para>
  <para style="q2" vid="PSA 88:13">ta neekko waassays;</para>
  <para style="q2" vid="PSA 88:13">maalado maalado ta woosay</para>
  <para style="q2" vid="PSA 88:13">ne sinth gakko.<verse eid="PSA 88:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 88:14">Neni tana ays ixxay?</para>
  <para style="q2" vid="PSA 88:14">Ne sinththaa taappe</para>
  <para style="q2" vid="PSA 88:14">ays genththay?<verse eid="PSA 88:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15" />Yelagateththasofe doommada,</para>
  <para style="q2" vid="PSA 88:15">tani tuggatadissinne</para>
  <para style="q2" vid="PSA 88:15">hayqqana matadis;</para>
  <para style="q2" vid="PSA 88:15">neni tana daganththiin</para>
  <para style="q2" vid="PSA 88:15">hidota qanxxadis.<verse eid="PSA 88:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16" />Suulliza ne hanqoy</para>
  <para style="q2" vid="PSA 88:16">ta bolla gakkides;</para>
  <para style="q2" vid="PSA 88:16">babisiza ne hanqoy</para>
  <para style="q2" vid="PSA 88:16">tana dhayssides.<verse eid="PSA 88:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17" />Istti kumeththa gallas</para>
  <para style="q2" vid="PSA 88:17">di7o haaththa mala</para>
  <para style="q2" vid="PSA 88:17">tana giddoththida;</para>
  <para style="q2" vid="PSA 88:17">issi bolla gididi</para>
  <para style="q2" vid="PSA 88:17">tana dooddi oykkida.<verse eid="PSA 88:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18" />Neni ta laggetanne</para>
  <para style="q2" vid="PSA 88:18">ta siiqota taappe haassadasa;</para>
  <para style="q2" vid="PSA 88:18">dhumay xalla taas dabbo gidides.<verse eid="PSA 88:18" /></para>
  <chapter eid="PSA 88" />
  <chapter number="89" style="c" sid="PSA 89" />
  <para style="s1">Ezira7eele As Etaaney Hassa7a Ginxon Shiishshida Timirte</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 89:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 89:1">Ne mernaa siiqo gishshas</para>
  <para style="q2" vid="PSA 89:1">tani mernaas yexxana;</para>
  <para style="q2" vid="PSA 89:1">ne ammaneteththaa</para>
  <para style="q2" vid="PSA 89:1">yeleta ubbaas ta awajjana.<verse eid="PSA 89:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2" />Tani ne mernaa siiqoy</para>
  <para style="q2" vid="PSA 89:2">mernaas eqqidayssanne</para>
  <para style="q2" vid="PSA 89:2">neni ne ammaneteththaa salon</para>
  <para style="q2" vid="PSA 89:2">minththada essidayssa yootana.<verse eid="PSA 89:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3" />Neni, «Tani dooridayssara</para>
  <para style="q2" vid="PSA 89:3">caaqo qaala geladis;</para>
  <para style="q2" vid="PSA 89:3">ta aylle Dawites,<verse eid="PSA 89:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 89:4" />‹Tani ne zareta</para>
  <para style="q2" vid="PSA 89:4">mernaas kawosana;</para>
  <para style="q2" vid="PSA 89:4">ne kawoteththa algaa</para>
  <para style="q2" vid="PSA 89:4">yeleta ubbaas minththana›</para>
  <para style="q2" vid="PSA 89:4">ga caaqqadis» gadasa.<note caller="-" style="x"><char style="xo" closed="false">89:4 </char><char style="xt" closed="false"><ref loc="2SA 7:12-16">2Same 7:12-16</ref>; <ref loc="1CH 17:11-14">1Taari 17:11-14</ref>; <ref loc="PSA 132:11">Maza 132:11</ref>; <ref loc="ACT 2:30">Hawa 2:30</ref></char></note><verse eid="PSA 89:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 89:5">Saloti neni ooththida malalisiza</para>
  <para style="q2" vid="PSA 89:5">oosota awajjeettes;</para>
  <para style="q2" vid="PSA 89:5">geeshshata duulatay</para>
  <para style="q2" vid="PSA 89:5">ne ammaneteththaa sabbees.<verse eid="PSA 89:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6" />Salon GODAARA</para>
  <para style="q2" vid="PSA 89:6">likkettanaas dandayzay oonee?</para>
  <para style="q2" vid="PSA 89:6">Salo medheteththata giddonkka</para>
  <para style="q2" vid="PSA 89:6">GODAA malay oonee?<verse eid="PSA 89:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7" />Geeshshata shiiqon</para>
  <para style="q2" vid="PSA 89:7">Xoossi yashissizaade;</para>
  <para style="q2" vid="PSA 89:7">Ba yuushon diza ubbaafe</para>
  <para style="q2" vid="PSA 89:7">keehi yashissizaade.<verse eid="PSA 89:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 89:8">Ubbaafe Wolqqama Xoossawu!</para>
  <para style="q2" vid="PSA 89:8">Ne mala wolqqamay oonee?</para>
  <para style="q2" vid="PSA 89:8">Abeet GODAWU!</para>
  <para style="q2" vid="PSA 89:8">Neni ubbaa miishshan</para>
  <para style="q2" vid="PSA 89:8">ammanettidaade.<verse eid="PSA 89:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9" />Ne bul7akettiza abba seeraasa;</para>
  <para style="q2" vid="PSA 89:9">abba dambalakka</para>
  <para style="q2" vid="PSA 89:9">co7u ooththaasa.<verse eid="PSA 89:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10" />Neni Era7aabe geetettiza</para>
  <para style="q2" vid="PSA 89:10">abba do7aza qoxereththa</para>
  <para style="q2" vid="PSA 89:10">wodhadasa;</para>
  <para style="q2" vid="PSA 89:10">ne morkketa</para>
  <para style="q2" vid="PSA 89:10">ne wolqqama qesen laalladasa.<verse eid="PSA 89:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11" />Saloti neyta;</para>
  <para style="q2" vid="PSA 89:11">sa7aykka neessa;</para>
  <para style="q2" vid="PSA 89:11">biittanne izan kumida ubbaa</para>
  <para style="q2" vid="PSA 89:11">neni medhdhadasa.<verse eid="PSA 89:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12" />Pudehanne dugeha</para>
  <para style="q2" vid="PSA 89:12">neni medhdhadasa;</para>
  <para style="q2" vid="PSA 89:12">Taaboorenne Hermoone zumati</para>
  <para style="q2" vid="PSA 89:12">ufayssan ne sunththan</para>
  <para style="q2" vid="PSA 89:12">yexxeettes.<verse eid="PSA 89:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13" />Nees wolqqama qesey dees;</para>
  <para style="q2" vid="PSA 89:13">ne qesey mino;</para>
  <para style="q2" vid="PSA 89:13">ne ushachcha qesey yashshees.<verse eid="PSA 89:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14" />Xilloteththinne suure pirday</para>
  <para style="q2" vid="PSA 89:14">ne kawoteththa araataas yochcha;</para>
  <para style="q2" vid="PSA 89:14">maaroteththinne ammaneteththi</para>
  <para style="q2" vid="PSA 89:14">neeppe sinththara beettes.<verse eid="PSA 89:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 89:15">Ililisan nena sabbizaytinne</para>
  <para style="q2" vid="PSA 89:15">ne poo7on hemettizayti</para>
  <para style="q2" vid="PSA 89:15">anjjettidayta.<verse eid="PSA 89:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16" />Ne sunththan kumeththa</para>
  <para style="q2" vid="PSA 89:16">gallas ufayetteettes;</para>
  <para style="q2" vid="PSA 89:16">ne xilloteththa gishshas</para>
  <para style="q2" vid="PSA 89:16">istti nena dhoqqu dhoqqu</para>
  <para style="q2" vid="PSA 89:16">histteettes.<verse eid="PSA 89:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17" />Istti ceeqettiza wolqqay nena;</para>
  <para style="q2" vid="PSA 89:17">ne teeman istta kacey</para>
  <para style="q2" vid="PSA 89:17">dhoqqu dhoqqu gees.<verse eid="PSA 89:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18" />Nu gondalley GODAA kushenna;</para>
  <para style="q2" vid="PSA 89:18">nu kawoykka</para>
  <para style="q2" vid="PSA 89:18">Isra7eele geeshsha kushenna.<note caller="-" style="x"><char style="xo" closed="false">89:1-18 </char><char style="xt" closed="false"><ref loc="1KI 4:31">1Kawo 4:31</ref></char></note><verse eid="PSA 89:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19" />Beni neni ne ammanettida</para>
  <para style="q2" vid="PSA 89:19">asatas ajjuutan,</para>
  <para style="q2" vid="PSA 89:19">«Tani ola qaraa maaddadis;</para>
  <para style="q2" vid="PSA 89:19">deraa giddofe doorettida yelaga</para>
  <para style="q2" vid="PSA 89:19">dhoqqu dhoqqu histtadis.<verse eid="PSA 89:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20" />Ta aylle Dawite demmadis;</para>
  <para style="q2" vid="PSA 89:20">ta geeshsha zaytenkka tiyada</para>
  <para style="q2" vid="PSA 89:20">iza kawoththadis.<note caller="-" style="x"><char style="xo" closed="false">89:20 </char><char style="xt" closed="false"><ref loc="1SA 13:14">1Same 13:14</ref>; <ref loc="ACT 13:22">Hawa 13:22</ref>; <ref loc="1SA 16:12">1Same 16:12</ref></char></note><verse eid="PSA 89:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21" />Ta kushey iza maaddana;</para>
  <para style="q2" vid="PSA 89:21">ta qeseykka iza minththana.<verse eid="PSA 89:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22" />Iza ay morkkey haaridi giirisenna;</para>
  <para style="q2" vid="PSA 89:22">ay iita asikka iza qohenna.<verse eid="PSA 89:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23" />Tani iza morkketa</para>
  <para style="q2" vid="PSA 89:23">iza sinththan tinchchereththana;</para>
  <para style="q2" vid="PSA 89:23">iza ixxizaytakka shoca</para>
  <para style="q2" vid="PSA 89:23">nififi histtana.<verse eid="PSA 89:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24" />Ta ammaneteththaynne</para>
  <para style="q2" vid="PSA 89:24">ta mernaa siiqoy</para>
  <para style="q2" vid="PSA 89:24">izara issife gidana;</para>
  <para style="q2" vid="PSA 89:24">Ta sunththan iza kacey</para>
  <para style="q2" vid="PSA 89:24">dhoqqu dhoqqu gaana.<verse eid="PSA 89:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25" />Tani iza kawoteththa</para>
  <para style="q2" vid="PSA 89:25">Mediteraane Abba</para>
  <para style="q2" vid="PSA 89:25">gakkanaas aassana.</para>
  <para style="q2" vid="PSA 89:25">Iza zawakka Efiraaxisenne</para>
  <para style="q2" vid="PSA 89:25">Xegroose Shaafata</para>
  <para style="q2" vid="PSA 89:25">gakkanaas aassana.<verse eid="PSA 89:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26" />Dawiti tana,</para>
  <para style="q2" vid="PSA 89:26">‹Neni ta aawaa;</para>
  <para style="q2" vid="PSA 89:26">ta Xoossanne</para>
  <para style="q2" vid="PSA 89:26">tana ashshiza wogga zaalla›</para>
  <para style="q2" vid="PSA 89:26">gi xeygana.<verse eid="PSA 89:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27" />Tani iza taas bayra naa histtana;</para>
  <para style="q2" vid="PSA 89:27">sa7an diza kawota ubbaafe</para>
  <para style="q2" vid="PSA 89:27">ta iza gitasana.<note caller="-" style="x"><char style="xo" closed="false">89:27 </char><char style="xt" closed="false"><ref loc="REV 1:5">Ajju 1:5</ref></char></note><verse eid="PSA 89:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28" />Tani ta siiqo</para>
  <para style="q2" vid="PSA 89:28">izas mernaas naagana;</para>
  <para style="q2" vid="PSA 89:28">tani izas gelida</para>
  <para style="q2" vid="PSA 89:28">caaqo qaala minththana.<verse eid="PSA 89:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29" />Tani iza zareta</para>
  <para style="q2" vid="PSA 89:29">mernaas minththa essana;</para>
  <para style="q2" vid="PSA 89:29">iza kawoteththa araataakka</para>
  <para style="q2" vid="PSA 89:29">salo mala mernaas</para>
  <para style="q2" vid="PSA 89:29">minththa tokkana.<verse eid="PSA 89:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30" />«Gido attiin iza zereththati</para>
  <para style="q2" vid="PSA 89:30">ta woga aggiko,</para>
  <para style="q2" vid="PSA 89:30">qasse istti ta azazokka</para>
  <para style="q2" vid="PSA 89:30">naagontta ixxiko,<verse eid="PSA 89:30" /></para>
  <para style="q2">
    <verse number="31" style="v" sid="PSA 89:31" />istti ta woththida</para>
  <para style="q2" vid="PSA 89:31">maara moorikko,</para>
  <para style="q2" vid="PSA 89:31">ta azazokka bonchchontta ixxiko,<verse eid="PSA 89:31" /></para>
  <para style="q2">
    <verse number="32" style="v" sid="PSA 89:32" />tani istta nagara gishshas</para>
  <para style="q2" vid="PSA 89:32">istta guufen qaxxayana;</para>
  <para style="q2" vid="PSA 89:32">istta mooro gishshas</para>
  <para style="q2" vid="PSA 89:32">istta xurqafen shocana.<verse eid="PSA 89:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33" />Gido attiin tani ta siiqo</para>
  <para style="q2" vid="PSA 89:33">izappe haassike;</para>
  <para style="q2" vid="PSA 89:33">woykko ta ammaneteth</para>
  <para style="q2" vid="PSA 89:33">izas pacinchchike.<verse eid="PSA 89:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34" />Tani caaqqida caaqo qaala miikke;</para>
  <para style="q2" vid="PSA 89:34">ta doonappe ke7ida</para>
  <para style="q2" vid="PSA 89:34">qaala laammike.<verse eid="PSA 89:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35" />Tani issito ta geeshsha sunththan</para>
  <para style="q2" vid="PSA 89:35">caaqqida qaala</para>
  <para style="q2" vid="PSA 89:35">Dawites wordotikke.<verse eid="PSA 89:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36" />Iza zareti mernaas minnidi daana;</para>
  <para style="q2" vid="PSA 89:36">iza kawoteththa algayka</para>
  <para style="q2" vid="PSA 89:36">awa arshe mala</para>
  <para style="q2" vid="PSA 89:36">ta sinththan mernaas daana.<verse eid="PSA 89:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37" />Salo bolla ammanettida markka</para>
  <para style="q2" vid="PSA 89:37">gidada diza agina mala</para>
  <para style="q2" vid="PSA 89:37">izi mernaas minni daana» gadasa.<verse eid="PSA 89:37" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38" />Gido attiin ha7i neni</para>
  <para style="q2" vid="PSA 89:38">tiyada kawoththidayssa</para>
  <para style="q2" vid="PSA 89:38">bolla keeha hanqettadasa;</para>
  <para style="q2" vid="PSA 89:38">iza kadhadasanne</para>
  <para style="q2" vid="PSA 89:38">yegga aggadasa.<verse eid="PSA 89:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39" />Neni ne ayllezas</para>
  <para style="q2" vid="PSA 89:39">caaqqida caaqo qaala laalladasa;</para>
  <para style="q2" vid="PSA 89:39">iza kallachcha</para>
  <para style="q2" vid="PSA 89:39">baanan olada tunisadasa.<verse eid="PSA 89:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40" />Neni katamaa gimbeza</para>
  <para style="q2" vid="PSA 89:40">ubbaa laalladasa;</para>
  <para style="q2" vid="PSA 89:40">iza miixa ubbaa dhayssadasa.<verse eid="PSA 89:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41" />Ogera aadhdhiza ubbati</para>
  <para style="q2" vid="PSA 89:41">iza bonqqida;</para>
  <para style="q2" vid="PSA 89:41">izi ba shoorotas qidhes attides.<verse eid="PSA 89:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42" />Neni iza morkketas ushachchadasa;</para>
  <para style="q2" vid="PSA 89:42">istta ubbaa ufayssadasa.<verse eid="PSA 89:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43" />Neni iza mashsha</para>
  <para style="q2" vid="PSA 89:43">qaraza dun7isadasa;</para>
  <para style="q2" vid="PSA 89:43">olankka iza maaddabeekka.<verse eid="PSA 89:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44" />Neni iza kawoteththa guufaa</para>
  <para style="q2" vid="PSA 89:44">iza kusheppe woththa ekkadasa;</para>
  <para style="q2" vid="PSA 89:44">qasse iza kawoteththa</para>
  <para style="q2" vid="PSA 89:44">araataa biittan oladasa.<verse eid="PSA 89:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45" />Neni iza yelagateththa</para>
  <para style="q2" vid="PSA 89:45">layththaa qaanththadasa;</para>
  <para style="q2" vid="PSA 89:45">yeellaka mayzadasa.<verse eid="PSA 89:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 89:46">Awude gakkanaas</para>
  <para style="q2" vid="PSA 89:46">nena genththanee?</para>
  <para style="q2" vid="PSA 89:46">Neni mernaas geemmanee?</para>
  <para style="q2" vid="PSA 89:46">Ne hanqoy tama mala</para>
  <para style="q2" vid="PSA 89:46">awude gakkanaas eexxanee?<verse eid="PSA 89:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47" />Ta layththay ay keena</para>
  <para style="q2" vid="PSA 89:47">qaanththako qoppa;</para>
  <para style="q2" vid="PSA 89:47">ne asa naa coo hada medhdhadii!<verse eid="PSA 89:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48" />Asi hayqqontta mernaas</para>
  <para style="q2" vid="PSA 89:48">shemppora paxa daanaas</para>
  <para style="q2" vid="PSA 89:48">dandayzee?</para>
  <para style="q2" vid="PSA 89:48">Qasse duufon gelontta mala</para>
  <para style="q2" vid="PSA 89:48">bana ashshanaas dandayza</para>
  <para style="q2" vid="PSA 89:48">asi dizee?<verse eid="PSA 89:48" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49" />Abeet Godawu!</para>
  <para style="q2" vid="PSA 89:49">Dawites ne ammaneteththan</para>
  <para style="q2" vid="PSA 89:49">caaqqida caaqoynne</para>
  <para style="q2" vid="PSA 89:49">kase ne mernaa siiqoy</para>
  <para style="q2" vid="PSA 89:49">awan dizee?<verse eid="PSA 89:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50" />Abeet Godawu!</para>
  <para style="q2" vid="PSA 89:50">Tani ne aylley</para>
  <para style="q2" vid="PSA 89:50">ay mala borettidaakko</para>
  <para style="q2" vid="PSA 89:50">neni haasaya;</para>
  <para style="q2" vid="PSA 89:50">tani asa ubbaa boreza</para>
  <para style="q2" vid="PSA 89:50">wostta dandaydaakko</para>
  <para style="q2" vid="PSA 89:50">ane ne qoppa.<verse eid="PSA 89:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51" />Abeet GODAWU! Ne morkketi</para>
  <para style="q2" vid="PSA 89:51">ne doorada tiyda</para>
  <para style="q2" vid="PSA 89:51">kawoza cayizayssa,</para>
  <para style="q2" vid="PSA 89:51">izi bidaso ubbaan</para>
  <para style="q2" vid="PSA 89:51">iza qilccizayssa qoppa.<verse eid="PSA 89:51" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52" />GODAY meri mernaas galatetto!</para>
  <para style="q2" vid="PSA 89:52">Amiin! Amiin.<verse eid="PSA 89:52" /></para>
  <chapter eid="PSA 89" />
  <chapter number="90" style="c" sid="PSA 90" />
  <para style="ms">Oydanththo Maxaafa</para>
  <para style="mr">(<ref loc="PSA 90-106">Maza 90—106</ref>)</para>
  <para style="s1">Xoossa As Musey Woossida Woosa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1" />Godawu! Neni nuus</para>
  <para style="q2" vid="PSA 90:1">yeletappe yeleta</para>
  <para style="q2" vid="PSA 90:1">gakkanaas shiiqi attizaso gidadasa.<verse eid="PSA 90:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2" />Zumati medhettanaappe kase,</para>
  <para style="q2" vid="PSA 90:2">woykko neni sa7a</para>
  <para style="q2" vid="PSA 90:2">ooththanaappe kase</para>
  <para style="q2" vid="PSA 90:2">mernaappe mernaa gakkanaasi</para>
  <para style="q2" vid="PSA 90:2">neni Xoossa.<verse eid="PSA 90:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3" />Neni asa nayta,</para>
  <para style="q2" vid="PSA 90:3">«Asa naytoo!</para>
  <para style="q2" vid="PSA 90:3">Guye biittan simmite»</para>
  <para style="q2" vid="PSA 90:3">gaada istti medhettida biittan</para>
  <para style="q2" vid="PSA 90:3">guye zaaraasa.<verse eid="PSA 90:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4" />Shii layththi nees aadhdhida</para>
  <para style="q2" vid="PSA 90:4">issi gallassa mala;</para>
  <para style="q2" vid="PSA 90:4">woykko omarsafe issi saate mala.<note caller="-" style="x"><char style="xo" closed="false">90:4 </char><char style="xt" closed="false"><ref loc="2PE 3:8">2Phex 3:8</ref></char></note><verse eid="PSA 90:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5" />As qoppontta efiza di7o mala</para>
  <para style="q2" vid="PSA 90:5">ne efishin,</para>
  <para style="q2" vid="PSA 90:5">istti agumo mala aadhdhana;</para>
  <para style="q2" vid="PSA 90:5">maalado maalado</para>
  <para style="q2" vid="PSA 90:5">mokkiza maata mala cilileettes.<verse eid="PSA 90:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6" />Maatay maalado diccidi ciiyees;</para>
  <para style="q2" vid="PSA 90:6">omarsa wode gidikko</para>
  <para style="q2" vid="PSA 90:6">shullidi melees.<verse eid="PSA 90:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7" />Nuni ne qanggeththan wuridos;</para>
  <para style="q2" vid="PSA 90:7">ne hanqo suulen dagammidos.<verse eid="PSA 90:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8" />Neni nu iita ooso</para>
  <para style="q2" vid="PSA 90:8">ne sinththan woththadasa;</para>
  <para style="q2" vid="PSA 90:8">qasse nu genththida nagara</para>
  <para style="q2" vid="PSA 90:8">ne sinththa poo7okko</para>
  <para style="q2" vid="PSA 90:8">aaththadasa.<verse eid="PSA 90:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9" />Nu wode ubbay</para>
  <para style="q2" vid="PSA 90:9">ne hanqon aadhdhides;</para>
  <para style="q2" vid="PSA 90:9">nu layththaaka oolen wursoos.<verse eid="PSA 90:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10" />Nu daana layththay</para>
  <para style="q2" vid="PSA 90:10">laappun tamma;</para>
  <para style="q2" vid="PSA 90:10">dares giikko osppun tamma;</para>
  <para style="q2" vid="PSA 90:10">heytikka metoninne</para>
  <para style="q2" vid="PSA 90:10">ceecen kumida;</para>
  <para style="q2" vid="PSA 90:10">nu layththay eeson aadhdhees;</para>
  <para style="q2" vid="PSA 90:10">nunikka eeson baana.<verse eid="PSA 90:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11" />Ne hanqoza wolqqa oonee erizay?</para>
  <para style="q2" vid="PSA 90:11">ne hanqo seelay yashshees.<verse eid="PSA 90:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12" />Nu layththa maarara</para>
  <para style="q2" vid="PSA 90:12">nu go7ettana mala</para>
  <para style="q2" vid="PSA 90:12">nuna aadho erateth tamaarsa.<verse eid="PSA 90:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 90:13">Ne hanqoy</para>
  <para style="q2" vid="PSA 90:13">awude gakkana gam7anee?</para>
  <para style="q2" vid="PSA 90:13">Simma! Ne aylletas qadhetta!<verse eid="PSA 90:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14" />Nu layththa ubbaan</para>
  <para style="q2" vid="PSA 90:14">nuni ufayettana malanne</para>
  <para style="q2" vid="PSA 90:14">yexxana mala maalado maalado</para>
  <para style="q2" vid="PSA 90:14">ne siiqon nuna kalssa.<verse eid="PSA 90:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15" />Neni nuna metoththida</para>
  <para style="q2" vid="PSA 90:15">gallassata keenanne</para>
  <para style="q2" vid="PSA 90:15">nuni tugga be7ida layththata</para>
  <para style="q2" vid="PSA 90:15">likke nuna ufayssa.<verse eid="PSA 90:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16" />Nuus ne aylletas</para>
  <para style="q2" vid="PSA 90:16">ne oosoy qoncco;</para>
  <para style="q2" vid="PSA 90:16">ne bonchchoy nu naytas beetto.<verse eid="PSA 90:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17" />Abeet GODAWU! Nu Xoossawu!</para>
  <para style="q2" vid="PSA 90:17">Ne kiyateththi nunara gido;</para>
  <para style="q2" vid="PSA 90:17">nu ooththiza ubbaa</para>
  <para style="q2" vid="PSA 90:17">nuus injjesa; ero!</para>
  <para style="q2" vid="PSA 90:17">Nu ooththiza ubbaa nuus injjesa.<verse eid="PSA 90:17" /></para>
  <chapter eid="PSA 90" />
  <chapter number="91" style="c" sid="PSA 91" />
  <para style="s1">Nuna Naagiza Xoossaas Yexettida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 91:1" />Ubbaafe Dhoqqa GODAAN</para>
  <para style="q2" vid="PSA 91:1">zemppi de7izay,</para>
  <para style="q2" vid="PSA 91:1">ubbaa dandayza</para>
  <para style="q2" vid="PSA 91:1">Xoossa kuwan aqees.<verse eid="PSA 91:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2" />Tani GODAA,</para>
  <para style="q2" vid="PSA 91:2">«Neni taas zemppo,</para>
  <para style="q2" vid="PSA 91:2">miixanne tani nenan</para>
  <para style="q2" vid="PSA 91:2">ammanettiza</para>
  <para style="q2" vid="PSA 91:2">ta Xoossa» gaana.<verse eid="PSA 91:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3" />Izi nena shankkanchchata giteppe,</para>
  <para style="q2" vid="PSA 91:3">wodhiza iita hargefekka</para>
  <para style="q2" vid="PSA 91:3">ashshana.<verse eid="PSA 91:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4" />Izi ba wangotan</para>
  <para style="q2" vid="PSA 91:4">nena kammana;</para>
  <para style="q2" vid="PSA 91:4">iza qefeta garsan</para>
  <para style="q2" vid="PSA 91:4">neni qotetta attana;</para>
  <para style="q2" vid="PSA 91:4">iza ammaneteththay</para>
  <para style="q2" vid="PSA 91:4">nees gondallenne</para>
  <para style="q2" vid="PSA 91:4">zemppo gidana.<verse eid="PSA 91:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5" />Neni omarsan</para>
  <para style="q2" vid="PSA 91:5">daganththiza miishshas,</para>
  <para style="q2" vid="PSA 91:5">woykko gallas xongettiza</para>
  <para style="q2" vid="PSA 91:5">yiishshas,<verse eid="PSA 91:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="PSA 91:6" />dhuman oykkiza harges,</para>
  <para style="q2" vid="PSA 91:6">woykko seeta gallassan</para>
  <para style="q2" vid="PSA 91:6">wursiza iita harges yayyaka.<verse eid="PSA 91:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7" />Issi shii ne millesora,</para>
  <para style="q2" vid="PSA 91:7">qasse tammu shii neeppe</para>
  <para style="q2" vid="PSA 91:7">ushachcha baggara kundana;</para>
  <para style="q2" vid="PSA 91:7">gido attiin nena aykkoyka</para>
  <para style="q2" vid="PSA 91:7">bochchenna.<verse eid="PSA 91:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8" />Neni ne ayfen</para>
  <para style="q2" vid="PSA 91:8">xeelo xalla xeellana;</para>
  <para style="q2" vid="PSA 91:8">iitatikka qaxxayettishin be7ana.<verse eid="PSA 91:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9" />GODAA neni nees baqata attizaso,</para>
  <para style="q2" vid="PSA 91:9">Ubbaafe Dhoqqa Xoossa nees</para>
  <para style="q2" vid="PSA 91:9">zemppo histtida gishshas,<verse eid="PSA 91:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="PSA 91:10" />iita miishshi nena bochchenna;</para>
  <para style="q2" vid="PSA 91:10">boshaykka ne keeth shiiqenna.<verse eid="PSA 91:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11" />Ne biza oge ubbaan</para>
  <para style="q2" vid="PSA 91:11">nena naagana mala</para>
  <para style="q2" vid="PSA 91:11">Xoossi ba kiitanchchata azazana.<note caller="-" style="x"><char style="xo" closed="false">91:11 </char><char style="xt" closed="false"><ref loc="MAT 4:6">Mato 4:6</ref>; <ref loc="LUK 4:10">Luqa 4:10</ref></char></note><verse eid="PSA 91:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12" />Ne tohoy shuchchan</para>
  <para style="q2" vid="PSA 91:12">dhuphettontta mala</para>
  <para style="q2" vid="PSA 91:12">kiitanchchati ba kushen</para>
  <para style="q2" vid="PSA 91:12">nena denththana.<note caller="-" style="x"><char style="xo" closed="false">91:12 </char><char style="xt" closed="false"><ref loc="MAT 4:6">Mato 4:6</ref>; <ref loc="LUK 4:11">Luqa 4:11</ref></char></note><verse eid="PSA 91:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13" />Neni gaammonne</para>
  <para style="q2" vid="PSA 91:13">haso shooshsha bolla hemettana;</para>
  <para style="q2" vid="PSA 91:13">qasseka wodalla gaammonne</para>
  <para style="q2" vid="PSA 91:13">iita shooshsha yedhdhana.<note caller="-" style="x"><char style="xo" closed="false">91:13 </char><char style="xt" closed="false"><ref loc="LUK 10:19">Luqa 10:19</ref></char></note><verse eid="PSA 91:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14" />GODAY, «Izi tana siiqida gishshas</para>
  <para style="q2" vid="PSA 91:14">tani iza ashshana;</para>
  <para style="q2" vid="PSA 91:14">izi ta sunththa erida gishshas</para>
  <para style="q2" vid="PSA 91:14">tani iza naagana.<verse eid="PSA 91:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15" />Izi tana xeygiza wode</para>
  <para style="q2" vid="PSA 91:15">tani izas koyana;</para>
  <para style="q2" vid="PSA 91:15">izi metotida wode</para>
  <para style="q2" vid="PSA 91:15">tani izara issife gidana;</para>
  <para style="q2" vid="PSA 91:15">tani iza ashshananne</para>
  <para style="q2" vid="PSA 91:15">bonchchana.<verse eid="PSA 91:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16" />Tani iza layththaa adussana;</para>
  <para style="q2" vid="PSA 91:16">ta ashshizaade gididayssa</para>
  <para style="q2" vid="PSA 91:16">ta iza bessana» gees.<verse eid="PSA 91:16" /></para>
  <chapter eid="PSA 91" />
  <chapter number="92" style="c" sid="PSA 92" />
  <para style="s1">Sambata Gallas Yexettiza Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 92:1" />GODAA galatoy lo7o;</para>
  <para style="q2" vid="PSA 92:1">Abeet Ubbaafe</para>
  <para style="q2" vid="PSA 92:1">Dhoqqa Xoossawu!</para>
  <para style="q2" vid="PSA 92:1">Ne sunththaas</para>
  <para style="q2" vid="PSA 92:1">mazam-ure shiishoy lo7o.<verse eid="PSA 92:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2" />Maalado ne mernaa siiqo,</para>
  <para style="q2" vid="PSA 92:2">giddoth ne ammaneteth</para>
  <para style="q2" vid="PSA 92:2">awajjay lo7o.<verse eid="PSA 92:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3" />Tammu shayan waaxettida</para>
  <para style="q2" vid="PSA 92:3">bagananinne</para>
  <para style="q2" vid="PSA 92:3">maasinqo diixxishe awajjay lo7o.<verse eid="PSA 92:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4" />Abeet GODAWU! Ne ooththida</para>
  <para style="q2" vid="PSA 92:4">wolqqama oosoti</para>
  <para style="q2" vid="PSA 92:4">tana ufayssida;</para>
  <para style="q2" vid="PSA 92:4">ne kushey ooththida gishshas</para>
  <para style="q2" vid="PSA 92:4">tani ufayssan yexxays.<verse eid="PSA 92:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 92:5">Ne oosoy ay keena gitaa!</para>
  <para style="q2" vid="PSA 92:5">Ne qofaykka ay keena ciimmaa!<verse eid="PSA 92:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6" />Hessa eeya asi eranawu dandayenna;</para>
  <para style="q2" vid="PSA 92:6">damma asikka</para>
  <para style="q2" vid="PSA 92:6">akeekanawu dandayenna.<verse eid="PSA 92:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7" />Iitati maata mala diccikokka,</para>
  <para style="q2" vid="PSA 92:7">gene ooththiza ubbati ciiykkoka</para>
  <para style="q2" vid="PSA 92:7">istti mernaas dhayana.<verse eid="PSA 92:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8" />Gido attiin abeet GODAWU!</para>
  <para style="q2" vid="PSA 92:8">Neni mernaas ubbaafe dhoqqa.<verse eid="PSA 92:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 92:9">Ne morkketi dhayana;</para>
  <para style="q2" vid="PSA 92:9">iita ooththiza ubbati</para>
  <para style="q2" vid="PSA 92:9">piski gaanayssa nu eroos.<verse eid="PSA 92:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10" />Ta kaceza menththa</para>
  <para style="q2" vid="PSA 92:10">kace mala dhoqqisadasa;</para>
  <para style="q2" vid="PSA 92:10">lo7o zaytenkka tana tiyadasa.<verse eid="PSA 92:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11" />Ta morkketi xoonettidayssa</para>
  <para style="q2" vid="PSA 92:11">ta ayfen be7adis;</para>
  <para style="q2" vid="PSA 92:11">ta baalgaarata kundeth</para>
  <para style="q2" vid="PSA 92:11">ta ayfen be7adis.<verse eid="PSA 92:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12" />Xilloti zamba mala daayana;</para>
  <para style="q2" vid="PSA 92:12">qasse Libaanoose</para>
  <para style="q2" vid="PSA 92:12">xiidda mala diccana.<verse eid="PSA 92:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13" />Istti GODAA keeththan tokettida;</para>
  <para style="q2" vid="PSA 92:13">istti Xoossa Keeththa</para>
  <para style="q2" vid="PSA 92:13">zago gakkanaas daayana.<verse eid="PSA 92:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14" />Istti ceeggidikka ayfana;</para>
  <para style="q2" vid="PSA 92:14">istti ubba wode cililida malanne</para>
  <para style="q2" vid="PSA 92:14">minnida mala daana.<verse eid="PSA 92:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15" />Istti, «GODAY likke;</para>
  <para style="q2" vid="PSA 92:15">izi taas wogga zaalla;</para>
  <para style="q2" vid="PSA 92:15">iza bolla wosoy deenna» gaana.<verse eid="PSA 92:15" /></para>
  <chapter eid="PSA 92" />
  <chapter number="93" style="c" sid="PSA 93" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1" />GODAY kawotides!</para>
  <para style="q2" vid="PSA 93:1">Teemanne wolqqa may7ides;</para>
  <para style="q2" vid="PSA 93:1">alamey qaaxxontta mala</para>
  <para style="q2" vid="PSA 93:1">minththi essides;</para>
  <para style="q2" vid="PSA 93:1">oonikka izo qaaththenna.<verse eid="PSA 93:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2" />Ne kawoteththa araatay</para>
  <para style="q2" vid="PSA 93:2">beniisofe minni eqqides;</para>
  <para style="q2" vid="PSA 93:2">neni mernaas daasa.<verse eid="PSA 93:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 93:3">Ciimma abbay guummides;</para>
  <para style="q2" vid="PSA 93:3">ciimma abbay ba gunththa</para>
  <para style="q2" vid="PSA 93:3">dhoqqu histtides;</para>
  <para style="q2" vid="PSA 93:3">ciimma abbay dambala guunth</para>
  <para style="q2" vid="PSA 93:3">dhoqqu ooththides.<verse eid="PSA 93:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4" />Salon diza GODAY</para>
  <para style="q2" vid="PSA 93:4">gita haaththata gunththafe,</para>
  <para style="q2" vid="PSA 93:4">abba dambala gunththafekka</para>
  <para style="q2" vid="PSA 93:4">aadho wolqqama.<verse eid="PSA 93:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 93:5">Ne wogay laamettontta mino;</para>
  <para style="q2" vid="PSA 93:5">ne Keeththay mernaas</para>
  <para style="q2" vid="PSA 93:5">geeshshateththan</para>
  <para style="q2" vid="PSA 93:5">lo7i daana.<verse eid="PSA 93:5" /></para>
  <chapter eid="PSA 93" />
  <chapter number="94" style="c" sid="PSA 94" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 94:1">Neni halo kessiza Xoossa;</para>
  <para style="q2" vid="PSA 94:1">Abeet halo kessiza Xoossawu!</para>
  <para style="q2" vid="PSA 94:1">Ne bonchcho qonccisa.<verse eid="PSA 94:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2" />Abeet sa7a pirdizayssoo! Denda!</para>
  <para style="q2" vid="PSA 94:2">Otoranchchatas bessiza</para>
  <para style="q2" vid="PSA 94:2">qixaate imma.<verse eid="PSA 94:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 94:3">Iitati awude gakkanaas</para>
  <para style="q2" vid="PSA 94:3">gam7anee?</para>
  <para style="q2" vid="PSA 94:3">Istti awude gakkanaas</para>
  <para style="q2" vid="PSA 94:3">ufayettanee?<verse eid="PSA 94:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4" />Iita ooththiza ubbati</para>
  <para style="q2" vid="PSA 94:4">bantta otoro qaalan haasayeettes;</para>
  <para style="q2" vid="PSA 94:4">coo ceeqetteettes.<verse eid="PSA 94:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 94:5">Istti ne deraa liiqiseettes;</para>
  <para style="q2" vid="PSA 94:5">asaa toochcheettes.<verse eid="PSA 94:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6" />Istti am7etanne</para>
  <para style="q2" vid="PSA 94:6">bete asata wodheettes;</para>
  <para style="q2" vid="PSA 94:6">yi7ota siifeettes.<verse eid="PSA 94:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7" />Histtidi isttas,</para>
  <para style="q2" vid="PSA 94:7">«GODAY nuna be7enna;</para>
  <para style="q2" vid="PSA 94:7">Yaaqoobe Xoossi</para>
  <para style="q2" vid="PSA 94:7">akeekenna» geettes.<verse eid="PSA 94:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8" />Intteno asaa giddofe</para>
  <para style="q2" vid="PSA 94:8">dammatoo! Akeekite!</para>
  <para style="q2" vid="PSA 94:8">Intteno eeyatoo!</para>
  <para style="q2" vid="PSA 94:8">Awude intte eranee?<verse eid="PSA 94:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9" />Hayth immida</para>
  <para style="q2" vid="PSA 94:9">Xoossi siyennee?</para>
  <para style="q2" vid="PSA 94:9">Ayfe medhdhida Xoossi be7ennee?<verse eid="PSA 94:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10" />Kawoteththaa seerizayssi</para>
  <para style="q2" vid="PSA 94:10">qaxxayennee?</para>
  <para style="q2" vid="PSA 94:10">As erateth tamaarsizayssi</para>
  <para style="q2" vid="PSA 94:10">baas erennee?<verse eid="PSA 94:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11" />GODAY asa qofay dhallonttayssanne</para>
  <para style="q2" vid="PSA 94:11">hada gididayssa erees.<note caller="-" style="x"><char style="xo" closed="false">94:11 </char><char style="xt" closed="false"><ref loc="1CO 3:20">1Qoro 3:20</ref></char></note><verse eid="PSA 94:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 94:12">Neni seerizaadeynne</para>
  <para style="q2" vid="PSA 94:12">neni ne wogappe tamaarsiza</para>
  <para style="q2" vid="PSA 94:12">asi anjjettidaade.<verse eid="PSA 94:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13" />Iitati kundana ollay</para>
  <para style="q2" vid="PSA 94:13">bookettana gakkanaas,</para>
  <para style="q2" vid="PSA 94:13">ne iza metoppe shempisaasa.<verse eid="PSA 94:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14" />GODAY ba asaa olenna;</para>
  <para style="q2" vid="PSA 94:14">izi bayta aggenna.<verse eid="PSA 94:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15" />Pirday simmidi xillo pirdas</para>
  <para style="q2" vid="PSA 94:15">yoch gidana;</para>
  <para style="q2" vid="PSA 94:15">xilloti ubbay</para>
  <para style="q2" vid="PSA 94:15">tuma pirda kaallana.<verse eid="PSA 94:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16" />Makkallanchchata bolla</para>
  <para style="q2" vid="PSA 94:16">ta gishshas eqettanay oonee?</para>
  <para style="q2" vid="PSA 94:16">Iita ooththizaytarakka</para>
  <para style="q1" vid="PSA 94:16">ta gishshas mootettanay oonee?<verse eid="PSA 94:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17" />GODAY tana maaddonttaakko,</para>
  <para style="q2" vid="PSA 94:17">tani eeson duufon gelada</para>
  <para style="q2" vid="PSA 94:17">sirphi gaana.<verse eid="PSA 94:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 94:18">Tani, «Kundana hanays» gishin</para>
  <para style="q2" vid="PSA 94:18">ne mernaa siiqoy tana kaafides.<verse eid="PSA 94:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19" />Ta wozinay ceecen kumida wode</para>
  <para style="q2" vid="PSA 94:19">ne minththeththoy ufays darsees.<verse eid="PSA 94:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20" />Wogan zemppidi geella pirdizaadera</para>
  <para style="q2" vid="PSA 94:20">neni zuppetanaas dandayay?<verse eid="PSA 94:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21" />Xillo asata bolla gene duulateettes;</para>
  <para style="q2" vid="PSA 94:21">suure asata bollaka</para>
  <para style="q2" vid="PSA 94:21">hayqo pirda pirdeettes.<verse eid="PSA 94:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22" />GODAY gidikko taas</para>
  <para style="q2" vid="PSA 94:22">tani baqata attiza miixa;</para>
  <para style="q2" vid="PSA 94:22">ta Xoossi ta izan</para>
  <para style="q2" vid="PSA 94:22">zemppiza wogga zaalla.<verse eid="PSA 94:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23" />Istta iitateththaa gishshas</para>
  <para style="q2" vid="PSA 94:23">izi istta qaxxayana;</para>
  <para style="q2" vid="PSA 94:23">istta nagara gishshas</para>
  <para style="q2" vid="PSA 94:23">izi istta dhayssana;</para>
  <para style="q2" vid="PSA 94:23">GODAA nu Xoossay</para>
  <para style="q2" vid="PSA 94:23">istta dippi histtana.<verse eid="PSA 94:23" /></para>
  <chapter eid="PSA 94" />
  <chapter number="95" style="c" sid="PSA 95" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1" />Haa yiite!</para>
  <para style="q2" vid="PSA 95:1">Ane GODAAS ufayssan yexxoos;</para>
  <para style="q2" vid="PSA 95:1">nuna ashshiza zaallas ililoos.<verse eid="PSA 95:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2" />Ane iza sinth galatara shiiqoos;</para>
  <para style="q2" vid="PSA 95:2">galata mazamure ufayssan yexxoos.<verse eid="PSA 95:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3" />Gaasoykka GODAY</para>
  <para style="q2" vid="PSA 95:3">wolqqama Xoossa,</para>
  <para style="q2" vid="PSA 95:3">xoossata ubbaa bollaka</para>
  <para style="q2" vid="PSA 95:3">wolqqama kawo.<verse eid="PSA 95:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4" />Biitta ciimmati iza kushen deettes;</para>
  <para style="q2" vid="PSA 95:4">zuma xeeratikka izassa.<verse eid="PSA 95:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5" />Abba haaththi izassa;</para>
  <para style="q2" vid="PSA 95:5">hessa iza kusheti medhdhida;</para>
  <para style="q2" vid="PSA 95:5">biittaaka medhdhiday iza.<verse eid="PSA 95:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6" />Haa yiite!</para>
  <para style="q2" vid="PSA 95:6">Hokkidi ane izas goynnoos;</para>
  <para style="q2" vid="PSA 95:6">nuna medhdhida GODAA</para>
  <para style="q2" vid="PSA 95:6">sinththan gulbatoos.<verse eid="PSA 95:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7" />Izi nu Xoossa;</para>
  <para style="q2" vid="PSA 95:7">Nuni iza qooron heemettizayta;</para>
  <para style="q2" vid="PSA 95:7">nuni izas dorsa wudeta.</para>
  <para style="b" vid="PSA 95:7" />
  <para style="q1" vid="PSA 95:7">GODAY inttena gizayssa hach siyite!<verse eid="PSA 95:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 95:8" />«Kase intte aawati</para>
  <para style="q2" vid="PSA 95:8">Maasaninne Mariiban</para>
  <para style="q2" vid="PSA 95:8">ooththoyssaththo</para>
  <para style="q2" vid="PSA 95:8">intte wozina muumisopite.<note caller="-" style="x"><char style="xo" closed="false">95:7-8 </char><char style="xt" closed="false"><ref loc="HEB 3:15">Ib 3:15</ref>; <ref loc="HEB 4:7">4:7</ref></char></note><verse eid="PSA 95:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9" />Istti ta ooso be7idikka</para>
  <para style="q2" vid="PSA 95:9">tanara eqettidanne tana paaccida.<note caller="-" style="x"><char style="xo" closed="false">95:8-9 </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">Kessa 17:1-7</ref>; <ref loc="NUM 20:2-13">Tay 20:2-13</ref></char></note><verse eid="PSA 95:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10" />He yeletaa bolla tani</para>
  <para style="q2" vid="PSA 95:10">oyddu tammu layth hanqettadis;</para>
  <para style="q2" vid="PSA 95:10">tanikka, ‹Istti ubba wode</para>
  <para style="q2" vid="PSA 95:10">bantta wozinan baliza asa;</para>
  <para style="q2" vid="PSA 95:10">istti ta oge eribeettenna› gadis.<verse eid="PSA 95:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11" />Hessa gishshas tani,</para>
  <para style="q2" vid="PSA 95:11">‹Istti ta shemposo</para>
  <para style="q2" vid="PSA 95:11">mulekka gelettenna›</para>
  <para style="q2" vid="PSA 95:11">gaada hanqetta caaqqadis.»<note caller="-" style="x"><char style="xo" closed="false">95:7-11 </char><char style="xt" closed="false"><ref loc="HEB 3:7-11">Ib 3:7-11</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">95:11 </char><char style="xt" closed="false"><ref loc="NUM 14:20-23">Tay 14:20-23</ref>; <ref loc="DEU 1:34-36">Zaare 1:34-36</ref>; <ref loc="DEU 12:9-10">12:9-10</ref>; <ref loc="HEB 4:3-5">Ib 4:3-5</ref></char></note><verse eid="PSA 95:11" /></para>
  <chapter eid="PSA 95" />
  <chapter number="96" style="c" sid="PSA 96" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1" />GODAAS ooraththa</para>
  <para style="q2" vid="PSA 96:1">mazamure yexxite;</para>
  <para style="q2" vid="PSA 96:1">sa7an de7iza asawu!</para>
  <para style="q2" vid="PSA 96:1">Ubbay GODAAS yexxite.<verse eid="PSA 96:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2" />GODAAS yexxite;</para>
  <para style="q2" vid="PSA 96:2">iza sunththaa sabbite;</para>
  <para style="q2" vid="PSA 96:2">izi ashshizayssa hach hach yootite.<verse eid="PSA 96:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3" />Kawoteththata giddon</para>
  <para style="q2" vid="PSA 96:3">iza bonchcho qonccisite;</para>
  <para style="q2" vid="PSA 96:3">asa ubbaa giddon malalisiza</para>
  <para style="q2" vid="PSA 96:3">iza ooso awajjite.<verse eid="PSA 96:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4" />GODAY gita;</para>
  <para style="q2" vid="PSA 96:4">gita galataykka izas bessees;</para>
  <para style="q2" vid="PSA 96:4">ubba xoossatappe aadhdhidi</para>
  <para style="q2" vid="PSA 96:4">izi yayettanaas bessees.<verse eid="PSA 96:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5" />Dere asay goynniza xoossati</para>
  <para style="q2" vid="PSA 96:5">ubbay eeqa xoossata;</para>
  <para style="q2" vid="PSA 96:5">gido attiin GODAY</para>
  <para style="q2" vid="PSA 96:5">salota medhdhida Xoossa.<verse eid="PSA 96:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6" />Bonchchoynne teemay</para>
  <para style="q2" vid="PSA 96:6">iza yuushon dees;</para>
  <para style="q2" vid="PSA 96:6">minoteththaynne puulay</para>
  <para style="q2" vid="PSA 96:6">iza Keeththan dees.<verse eid="PSA 96:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7" />Intteno biitta bolla diza</para>
  <para style="q2" vid="PSA 96:7">dere ubbatoo!</para>
  <para style="q2" vid="PSA 96:7">GODAA bonchcho gishshassinne</para>
  <para style="q2" vid="PSA 96:7">iza wolqqa gishshas galatite.<verse eid="PSA 96:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8" />Iza sunththas bessiza bonchcho</para>
  <para style="q2" vid="PSA 96:8">GODAAS immite;</para>
  <para style="q2" vid="PSA 96:8">Yarsho ekkidi iza Keeththa zago gelite.<verse eid="PSA 96:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9" />Iza geeshshateththa puulan GODAAS goynnite;</para>
  <para style="q2" vid="PSA 96:9">biittan de7iza as ubbay</para>
  <para style="q2" vid="PSA 96:9">iza sinththan kokkorite.<verse eid="PSA 96:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10" />Kawoteththata giddon,</para>
  <para style="q2" vid="PSA 96:10">«GODAY kawotides!</para>
  <para style="q2" vid="PSA 96:10">Sa7ay minni eqqides;</para>
  <para style="q2" vid="PSA 96:10">mulekka qaaxxenna;</para>
  <para style="q2" vid="PSA 96:10">izi as ubbaas</para>
  <para style="q2" vid="PSA 96:10">issi gina pirdana» giite.<verse eid="PSA 96:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11" />Saloynne sa7ay ufayetetto!</para>
  <para style="q2" vid="PSA 96:11">abbaynne iza giddon diza</para>
  <para style="q2" vid="PSA 96:11">ubbati guummetto!<verse eid="PSA 96:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12" />Goshsha gadeynne iza bolla diza</para>
  <para style="q2" vid="PSA 96:12">ubbay ufayetto!</para>
  <para style="q2" vid="PSA 96:12">Woran diza mith ubbay</para>
  <para style="q2" vid="PSA 96:12">iza sinththan ufayssan yexxana.<verse eid="PSA 96:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 96:13" />Ays giikko GODAY yaana;</para>
  <para style="q2" vid="PSA 96:13">izi sa7a bollan pirdanaas yaana;</para>
  <para style="q2" vid="PSA 96:13">izi ha sa7a bolla xilloteththan,</para>
  <para style="q2" vid="PSA 96:13">asa bollaka</para>
  <para style="q2" vid="PSA 96:13">tumateththan pirdana.<verse eid="PSA 96:13" /></para>
  <chapter eid="PSA 96" />
  <chapter number="97" style="c" sid="PSA 97" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1" />GODAY kawotides;</para>
  <para style="q2" vid="PSA 97:1">sa7an de7iza asay ufayetto;</para>
  <para style="q2" vid="PSA 97:1">abba giddon de7iza</para>
  <para style="q2" vid="PSA 97:1">haruroti ufayetetto.<verse eid="PSA 97:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2" />Shaaraynne sakkanna dhumay</para>
  <para style="q2" vid="PSA 97:2">iza yuuyi aadhdhides;</para>
  <para style="q2" vid="PSA 97:2">xilloteththinne tumateththi</para>
  <para style="q2" vid="PSA 97:2">iza kawoteththa</para>
  <para style="q2" vid="PSA 97:2">araataas yochcha.<verse eid="PSA 97:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3" />Tamay izappe sinththara bees;</para>
  <para style="q2" vid="PSA 97:3">iza yuushon diza</para>
  <para style="q2" vid="PSA 97:3">morkketakka xuuggees.<verse eid="PSA 97:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4" />Iza wolqqanththi sa7a poo7isees;</para>
  <para style="q2" vid="PSA 97:4">biittay hessa be7idi qaaxxees.<verse eid="PSA 97:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5" />GODAA sinththan,</para>
  <para style="q2" vid="PSA 97:5">sa7a ubbaa Godaa</para>
  <para style="q2" vid="PSA 97:5">sinththan zumati</para>
  <para style="q2" vid="PSA 97:5">muqaadda mala seerida.<verse eid="PSA 97:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6" />Saloti iza xilloteththaa awajjeettes;</para>
  <para style="q2" vid="PSA 97:6">asay ubbay iza bonchcho be7ees.<verse eid="PSA 97:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7" />Misletas goynnizaytinne</para>
  <para style="q2" vid="PSA 97:7">eeqa xoossatan ceeqettizayti</para>
  <para style="q2" vid="PSA 97:7">ubbay yeellatetto!</para>
  <para style="q2" vid="PSA 97:7">eeqa xoossati Ubbay</para>
  <para style="q2" vid="PSA 97:7">GODAAS gulbatetto!<verse eid="PSA 97:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 97:8">Xiyoone asay ne xillo pirda</para>
  <para style="q2" vid="PSA 97:8">siyidi ufayettees;</para>
  <para style="q2" vid="PSA 97:8">Yuhuda katamatikka,</para>
  <para style="q2" vid="PSA 97:8">«Hashshu» geettes.<verse eid="PSA 97:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 97:9">Neni sa7a ubbaafe dhoqqaasa;</para>
  <para style="q2" vid="PSA 97:9">xoossata ubbaafe neni gitataasa.<note caller="-" style="x"><char style="xo" closed="false">97:7-9 </char><char style="xt" closed="false"><ref loc="PSA 29:1-2">Maza 29:1-2</ref></char></note><verse eid="PSA 97:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10" />GODAA dosizaytoo! Iita ixxite;</para>
  <para style="q2" vid="PSA 97:10">izi baas ammanettizayta</para>
  <para style="q2" vid="PSA 97:10">shemppo naagees;</para>
  <para style="q2" vid="PSA 97:10">qasseka iitata kusheppeka</para>
  <para style="q2" vid="PSA 97:10">ashshees.<verse eid="PSA 97:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11" />Xillotas poo7oy poo7i poo7i baana;</para>
  <para style="q2" vid="PSA 97:11">wozina suuretas ufayssi daana.<verse eid="PSA 97:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12" />Intteno xillotoo!</para>
  <para style="q2" vid="PSA 97:12">GODAAN ufayettite;</para>
  <para style="q2" vid="PSA 97:12">geeshsha sunththa</para>
  <para style="q2" vid="PSA 97:12">izayssa galatite.<verse eid="PSA 97:12" /></para>
  <chapter eid="PSA 97" />
  <chapter number="98" style="c" sid="PSA 98" />
  <para style="s1">Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1" />GODAAS ooraththa</para>
  <para style="q2" vid="PSA 98:1">mazamure yexxite;</para>
  <para style="q2" vid="PSA 98:1">gaasoykka izi malalisiza</para>
  <para style="q2" vid="PSA 98:1">miish ooththides;</para>
  <para style="q2" vid="PSA 98:1">iza ushachcha kusheynne</para>
  <para style="q2" vid="PSA 98:1">iza geeshsha qesey</para>
  <para style="q2" vid="PSA 98:1">izas xoono immides.<verse eid="PSA 98:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2" />GODAY ba ashshizayssa erisides;</para>
  <para style="q2" vid="PSA 98:2">izi ba xilloteththaka</para>
  <para style="q2" vid="PSA 98:2">kawoteththas qonccisides.<verse eid="PSA 98:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3" />Izi Isra7eeleta siiqizayssanne</para>
  <para style="q2" vid="PSA 98:3">isttas ammanettizayssa</para>
  <para style="q2" vid="PSA 98:3">hassa7ides;</para>
  <para style="q2" vid="PSA 98:3">sa7a gaxa gakkanaas diza</para>
  <para style="q2" vid="PSA 98:3">asay ubbay</para>
  <para style="q2" vid="PSA 98:3">nu Xoossay ashshizayssa be7ides.<verse eid="PSA 98:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4" />Sa7a bollan diza as ubbay</para>
  <para style="q2" vid="PSA 98:4">GODAAS ufayssan yexxite;</para>
  <para style="q2" vid="PSA 98:4">qaala dhoqqu ooththidi</para>
  <para style="q2" vid="PSA 98:4">ufayssa yeththan galatite.<verse eid="PSA 98:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5" />Bagana diixxishe</para>
  <para style="q2" vid="PSA 98:5">mazamuren GODAA galatite;<verse eid="PSA 98:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6" />Dinkenne zaye punnishe</para>
  <para style="q2" vid="PSA 98:6">nu kawaa GODAA sinththan</para>
  <para style="q2" vid="PSA 98:6">ufayssan ililite.<verse eid="PSA 98:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7" />Abbaynne abba giddon kumida</para>
  <para style="q2" vid="PSA 98:7">ubbay guummo!</para>
  <para style="q2" vid="PSA 98:7">sa7aynne sa7a bollan diza</para>
  <para style="q2" vid="PSA 98:7">ubbay yexxo!<verse eid="PSA 98:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8" />Shaafati issife</para>
  <para style="q2" vid="PSA 98:8">bantta kushe baqqetto!</para>
  <para style="q2" vid="PSA 98:8">zumati GODAA sinththan</para>
  <para style="q2" vid="PSA 98:8">issife ufayssan yexxetto!<verse eid="PSA 98:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9" />GODAY sa7a bollan pirdanaas yaana;</para>
  <para style="q2" vid="PSA 98:9">izi ha sa7a bolla xilloteththan</para>
  <para style="q2" vid="PSA 98:9">asa bollaka</para>
  <para style="q2" vid="PSA 98:9">suureteththan pirdana.<verse eid="PSA 98:9" /></para>
  <chapter eid="PSA 98" />
  <chapter number="99" style="c" sid="PSA 99" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1" />GODAY kawotides!</para>
  <para style="q2" vid="PSA 99:1">Hessa gishshas asay kokkoro!</para>
  <para style="q2" vid="PSA 99:1">kirubeta giddon</para>
  <para style="q2" vid="PSA 99:1">kawoteththa araatan uttides;</para>
  <para style="q2" vid="PSA 99:1">hessas biittayka qaaxxo.<note caller="-" style="x"><char style="xo" closed="false">99:1 </char><char style="xt" closed="false"><ref loc="EXO 25:22">Kessa 25:22</ref></char></note><verse eid="PSA 99:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2" />GODAY Xiyoonen gita;</para>
  <para style="q2" vid="PSA 99:2">kawoteththa ubbaafe</para>
  <para style="q2" vid="PSA 99:2">izi dhoqqu dhoqqu gides.<verse eid="PSA 99:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3" />Gitanne keehippe yashissiza</para>
  <para style="q2" vid="PSA 99:3">ne sunththa</para>
  <para style="q2" vid="PSA 99:3">istti ubbay sabbetto!</para>
  <para style="q2" vid="PSA 99:3">izi dumma!<verse eid="PSA 99:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4" />Tuma pirda dosiza wolqqama kawo!</para>
  <para style="q2" vid="PSA 99:4">neni suureteththas</para>
  <para style="q2" vid="PSA 99:4">yoch yeggadasa;</para>
  <para style="q2" vid="PSA 99:4">neni Yaaqoobes tumu pirdanne</para>
  <para style="q2" vid="PSA 99:4">xilloteth essadasa.<verse eid="PSA 99:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5" />Izi dumma gidida gishshas</para>
  <para style="q2" vid="PSA 99:5">GODAA nu Xoossaa</para>
  <para style="q2" vid="PSA 99:5">dhoqqu dhoqqu histtite;</para>
  <para style="q2" vid="PSA 99:5">iza toho garsankka gufannidi</para>
  <para style="q2" vid="PSA 99:5">izas goynnite.<verse eid="PSA 99:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6" />Iza qeeseta giddofe Museynne</para>
  <para style="q2" vid="PSA 99:6">Aarooney deettes;</para>
  <para style="q2" vid="PSA 99:6">Sameelikka iza sunththan</para>
  <para style="q2" vid="PSA 99:6">woossidaytappe issaa;</para>
  <para style="q2" vid="PSA 99:6">istti GODAAS waassida;</para>
  <para style="q2" vid="PSA 99:6">izikka istta waaso allides.<verse eid="PSA 99:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7" />Izi shaara tuussa giddora</para>
  <para style="q2" vid="PSA 99:7">isttas haasaydes;</para>
  <para style="q2" vid="PSA 99:7">istti izi immida maaraanne</para>
  <para style="q2" vid="PSA 99:7">woga naagida.<note caller="-" style="x"><char style="xo" closed="false">99:7 </char><char style="xt" closed="false"><ref loc="EXO 33:9">Kessa 33:9</ref></char></note><verse eid="PSA 99:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8" />Abeet GODAWU, nu Xoossawu!</para>
  <para style="q2" vid="PSA 99:8">neni istta woosa siyadasa;</para>
  <para style="q2" vid="PSA 99:8">neni istta iitateththaa gishshas</para>
  <para style="q2" vid="PSA 99:8">qaxxaydaa gidikkoka</para>
  <para style="q2" vid="PSA 99:8">isttas atto gida Xoossa.<verse eid="PSA 99:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9" />GODAA nu Xoossaa</para>
  <para style="q2" vid="PSA 99:9">dhoqqu dhoqqu histtite;</para>
  <para style="q2" vid="PSA 99:9">iza geeshsha zuma bollan</para>
  <para style="q2" vid="PSA 99:9">izas goynnite;</para>
  <para style="q2" vid="PSA 99:9">ays giikko GODAA</para>
  <para style="q2" vid="PSA 99:9">nu Xoossay geeshsha Xoossa.<verse eid="PSA 99:9" /></para>
  <chapter eid="PSA 99" />
  <chapter number="100" style="c" sid="PSA 100" />
  <para style="s1">Galata Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1" />Sa7an de7iza as ubbay</para>
  <para style="q2" vid="PSA 100:1">GODAAS ufayssan ililite.<verse eid="PSA 100:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 100:2" />GODAAS ufayssan haggazite;</para>
  <para style="q2" vid="PSA 100:2">ufayssa yeththara</para>
  <para style="q2" vid="PSA 100:2">iza sinth shiiqite.<verse eid="PSA 100:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3" />GODAY Xoossa gididayssa erite;</para>
  <para style="q2" vid="PSA 100:3">nuna medhdhiday iza;</para>
  <para style="q2" vid="PSA 100:3">nuni izayta;</para>
  <para style="q2" vid="PSA 100:3">nuni iza asati</para>
  <para style="q2" vid="PSA 100:3">izi heemmiza dorsa wudeta.<verse eid="PSA 100:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4" />Iza penge galatara,</para>
  <para style="q2" vid="PSA 100:4">iza zago sabara gelite;</para>
  <para style="q2" vid="PSA 100:4">iza galatite;</para>
  <para style="q2" vid="PSA 100:4">iza sunththaaka anjjite.<verse eid="PSA 100:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5" />Ays giikko GODAY kiya;</para>
  <para style="q2" vid="PSA 100:5">iza siiqoy mernaassa;</para>
  <para style="q2" vid="PSA 100:5">iza ammaneteththay</para>
  <para style="q2" vid="PSA 100:5">yeletappe yeleta gakkanaassa.<note caller="-" style="x"><char style="xo" closed="false">100:5 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1Taari 16:34</ref>; <ref loc="2CH 5:13">2Taari 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Iz 3:11</ref>; <ref loc="PSA 106:1">Maza 106:1</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Er 33:11</ref></char></note><verse eid="PSA 100:5" /></para>
  <chapter eid="PSA 100" />
  <chapter number="101" style="c" sid="PSA 101" />
  <para style="s1">Dawite Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1" />Tani ne siiqo gishshassinne</para>
  <para style="q2" vid="PSA 101:1">tuma pirda gishshas yexxana;</para>
  <para style="q2" vid="PSA 101:1">abeet GODAWU!</para>
  <para style="q2" vid="PSA 101:1">Tani nees galata mazamure yexxana.<verse eid="PSA 101:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2" />Tani suure oge kaallana;</para>
  <para style="q2" vid="PSA 101:2">neni taakko awude yaanee?</para>
  <para style="q2" vid="PSA 101:2">Tani ta keeththan</para>
  <para style="q2" vid="PSA 101:2">suureteththan daana.<verse eid="PSA 101:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3" />Tani ta ayfera</para>
  <para style="q2" vid="PSA 101:3">iita miish xeellike;</para>
  <para style="q2" vid="PSA 101:3">Xoossafe kare kezida asata</para>
  <para style="q2" vid="PSA 101:3">ooso ixxays;</para>
  <para style="q2" vid="PSA 101:3">tani isttara mulekka zuppetikke.<verse eid="PSA 101:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4" />Wozina geellati taappe haakketto;</para>
  <para style="q2" vid="PSA 101:4">iitateththara taas</para>
  <para style="q2" vid="PSA 101:4">gaytoteththi deenna.<verse eid="PSA 101:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5" />Geeman ba lagge zigirzayssa</para>
  <para style="q2" vid="PSA 101:5">tani sirphi ooththana;</para>
  <para style="q2" vid="PSA 101:5">otorettizayssinne ceeqettiza as</para>
  <para style="q2" vid="PSA 101:5">tani co7u ga aggike.<verse eid="PSA 101:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6" />Istti tanara daana mala</para>
  <para style="q2" vid="PSA 101:6">biitta bolla de7iza</para>
  <para style="q2" vid="PSA 101:6">ammanettizayta</para>
  <para style="q2" vid="PSA 101:6">tani lo7o ayfen xeellays.</para>
  <para style="q2" vid="PSA 101:6">Suureteththan hemettiza asi</para>
  <para style="q2" vid="PSA 101:6">taas haggazana.<verse eid="PSA 101:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7" />Cimo ooththizay oonikka</para>
  <para style="q2" vid="PSA 101:7">ta keeththan deenna;</para>
  <para style="q2" vid="PSA 101:7">wordo haasayzay</para>
  <para style="q2" vid="PSA 101:7">ta sinththan eqqenna.<verse eid="PSA 101:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8" />Biittan de7iza iita as ubbaa</para>
  <para style="q2" vid="PSA 101:8">tani hach hach dhayssana;</para>
  <para style="q2" vid="PSA 101:8">iita ooththizayta ubbaa</para>
  <para style="q2" vid="PSA 101:8">tani GODAA katamappe</para>
  <para style="q2" vid="PSA 101:8">dhoqalla dhayssana.<verse eid="PSA 101:8" /></para>
  <chapter eid="PSA 101" />
  <chapter number="102" style="c" sid="PSA 102" />
  <para style="s1">Ceecida Wodenne Metotida Wode Xoossa Sinththan Woossida Woosa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 102:1">Ta woosa siya;</para>
  <para style="q2" vid="PSA 102:1">ta waasoy neekko gakko.<verse eid="PSA 102:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2" />Ta metotida gallas</para>
  <para style="q2" vid="PSA 102:2">ne sinththa taappe genththofa;</para>
  <para style="q2" vid="PSA 102:2">ne hayththa taakko zaara;</para>
  <para style="q2" vid="PSA 102:2">tani neekko waassiza wode</para>
  <para style="q2" vid="PSA 102:2">taas eeson alla.<verse eid="PSA 102:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3" />Ays giikko ta layththay</para>
  <para style="q2" vid="PSA 102:3">cuwa mala dhayees;</para>
  <para style="q2" vid="PSA 102:3">ta meqeththaykka</para>
  <para style="q2" vid="PSA 102:3">tama bonqo mala eexxees.<verse eid="PSA 102:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4" />Ta wozinay</para>
  <para style="q2" vid="PSA 102:4">away labida maata mala handes;</para>
  <para style="q2" vid="PSA 102:4">taas qoodhey kath ixxides.<verse eid="PSA 102:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5" />Taas oole daroppe dendoyssan</para>
  <para style="q2" vid="PSA 102:5">meqeththi xalla attides.<verse eid="PSA 102:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6" />Tani bazzon diza biya kafo</para>
  <para style="q2" vid="PSA 102:6">woykko laalettida keeththan</para>
  <para style="q2" vid="PSA 102:6">de7iza gutto mala.<verse eid="PSA 102:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7" />Tani ichchiin dhiskoy yeenna;</para>
  <para style="q2" vid="PSA 102:7">tani keeththa hu7en</para>
  <para style="q2" vid="PSA 102:7">barkka uttida kafo mala gidadis.<verse eid="PSA 102:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8" />Ta morkketi ubbaa gallas</para>
  <para style="q2" vid="PSA 102:8">tana cayeettes;</para>
  <para style="q2" vid="PSA 102:8">tana iiseththizayti ta sunth</para>
  <para style="q2" vid="PSA 102:8">qanggettida mala qoodida.<verse eid="PSA 102:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9" />Tani bidinth dhiille mala qam7adis;</para>
  <para style="q2" vid="PSA 102:9">ta afunththaaka</para>
  <para style="q2" vid="PSA 102:9">ushshara walakka uyadis.<verse eid="PSA 102:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10" />Ne hanqo gaasoninne</para>
  <para style="q2" vid="PSA 102:10">ne bosha gaason</para>
  <para style="q2" vid="PSA 102:10">ne tana pude denththoosoppe</para>
  <para style="q2" vid="PSA 102:10">duge oladasa.<verse eid="PSA 102:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11" />Ta de7o layththay omarsa wode</para>
  <para style="q2" vid="PSA 102:11">kuwa mala;</para>
  <para style="q2" vid="PSA 102:11">tani maata mala meladis.<verse eid="PSA 102:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12" />Gido attiin abeet GODAWU!</para>
  <para style="q2" vid="PSA 102:12">Neni kawoteththa araatan</para>
  <para style="q2" vid="PSA 102:12">mernaas uttadasa;</para>
  <para style="q2" vid="PSA 102:12">ne sunththayka yeletappe</para>
  <para style="q2" vid="PSA 102:12">yeleta gakkanaas hassa7ettana.<verse eid="PSA 102:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13" />Neni Xiyoonis</para>
  <para style="q2" vid="PSA 102:13">kiyateth ooththiza wodey</para>
  <para style="q2" vid="PSA 102:13">gakkida gishshassinne</para>
  <para style="q2" vid="PSA 102:13">wodezikka ha7i gidida gishshas</para>
  <para style="q2" vid="PSA 102:13">neni dendada izis qadhettana.<verse eid="PSA 102:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14" />Ne oosanchchati izan diza</para>
  <para style="q2" vid="PSA 102:14">shuchchata doseettes;</para>
  <para style="q2" vid="PSA 102:14">budhettida biittaska</para>
  <para style="q2" vid="PSA 102:14">qadhetteettes.<verse eid="PSA 102:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15" />Kawoteththati GODAA</para>
  <para style="q2" vid="PSA 102:15">sunththaas yayyana;</para>
  <para style="q2" vid="PSA 102:15">sa7a kawoti ubbay</para>
  <para style="q2" vid="PSA 102:15">iza bonchchana.<verse eid="PSA 102:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16" />GODAY Xiyoono zaari essiza wode</para>
  <para style="q2" vid="PSA 102:16">izi ba gitateththa bessana.<verse eid="PSA 102:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17" />Izi hiyeesata woosaa siyana;</para>
  <para style="q2" vid="PSA 102:17">istta shoobbeka kadhenna.<verse eid="PSA 102:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18" />Buron yelettanay</para>
  <para style="q2" vid="PSA 102:18">GODAA galatana mala</para>
  <para style="q2" vid="PSA 102:18">hayssi yiza yeletas xaafetto.<verse eid="PSA 102:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19" />GODAY dhoqqan diza</para>
  <para style="q2" vid="PSA 102:19">ba geeshsha sohoppe</para>
  <para style="q2" vid="PSA 102:19">duge xeellides;</para>
  <para style="q2" vid="PSA 102:19">izi saloppe duge</para>
  <para style="q2" vid="PSA 102:19">sa7a be7ides.<verse eid="PSA 102:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20" />Hessika qashettida</para>
  <para style="q2" vid="PSA 102:20">asata waaso siyanaassinne</para>
  <para style="q2" vid="PSA 102:20">hayqos pirdettida asata</para>
  <para style="q2" vid="PSA 102:20">qashoppe birshanaassa.<verse eid="PSA 102:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21" />Hessa gishshas GODAA sunththi</para>
  <para style="q2" vid="PSA 102:21">Xiyoonin yootettana;</para>
  <para style="q2" vid="PSA 102:21">iza galatay</para>
  <para style="q2" vid="PSA 102:21">Yerusalaamen awajjettana.<verse eid="PSA 102:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22" />Deretinne kawoti issife shiiqidi</para>
  <para style="q2" vid="PSA 102:22">GODAAS he wode goynnana.<verse eid="PSA 102:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23" />Izi tani naateteththan dishin,</para>
  <para style="q2" vid="PSA 102:23">izi ta minoteththaa</para>
  <para style="q2" vid="PSA 102:23">ogen ashshides;</para>
  <para style="q2" vid="PSA 102:23">ta daana layththaaka</para>
  <para style="q2" vid="PSA 102:23">qaanththides.<verse eid="PSA 102:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24" />Histtiin tani,</para>
  <para style="q2" vid="PSA 102:24">«Abeet ta Xoossawu!</para>
  <para style="q2" vid="PSA 102:24">tani daana layththaa</para>
  <para style="q2" vid="PSA 102:24">buro baggasishin</para>
  <para style="q2" vid="PSA 102:24">ne tana ekkofa.</para>
  <para style="q1" vid="PSA 102:24">Abeet GODAWU!</para>
  <para style="q2" vid="PSA 102:24">Neni yeletappe yeleta gakkanaas</para>
  <para style="q2" vid="PSA 102:24">daasa» gays.<verse eid="PSA 102:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25" />Neni beni sa7a medhdhadasa;</para>
  <para style="q2" vid="PSA 102:25">salotikka ne kushe ooso.<verse eid="PSA 102:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26" />Heyti ubbay dhayana;</para>
  <para style="q2" vid="PSA 102:26">gido attiin neni minna daana;</para>
  <para style="q2" vid="PSA 102:26">istti ubbayka</para>
  <para style="q2" vid="PSA 102:26">afala mala wurana;</para>
  <para style="q2" vid="PSA 102:26">neni istta carqqa</para>
  <para style="q2" vid="PSA 102:26">mala laammana;</para>
  <para style="q2" vid="PSA 102:26">isttika aadhdhana.<verse eid="PSA 102:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27" />Gido attiin awudekka</para>
  <para style="q2" vid="PSA 102:27">neni nena;</para>
  <para style="q2" vid="PSA 102:27">ne layththay mulekka wurenna.<note caller="-" style="x"><char style="xo" closed="false">102:25-27 </char><char style="xt" closed="false"><ref loc="HEB 1:10-12">Ib 1:10-12</ref></char></note><verse eid="PSA 102:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28" />Nees ooththizayta nayti</para>
  <para style="q2" vid="PSA 102:28">saroteththan daana;</para>
  <para style="q2" vid="PSA 102:28">istta zereththayka</para>
  <para style="q2" vid="PSA 102:28">ne sinththan minni eqqana.<verse eid="PSA 102:28" /></para>
  <chapter eid="PSA 102" />
  <chapter number="103" style="c" sid="PSA 103" />
  <para style="s1">Dawite Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1" />Ta shemppoyee!</para>
  <para style="q2" vid="PSA 103:1">GODAA galata!</para>
  <para style="q2" vid="PSA 103:1">Ta kumeththa asateththay</para>
  <para style="q2" vid="PSA 103:1">iza geeshsha sunththa galato.<verse eid="PSA 103:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2" />Ta shemppoyee! GODAA galata!</para>
  <para style="q2" vid="PSA 103:2">Izi nees ooththida</para>
  <para style="q2" vid="PSA 103:2">kiyateththa ubbaa dogoppa.<verse eid="PSA 103:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3" />Izi ne nagara</para>
  <para style="q2" vid="PSA 103:3">ubbaa atto gees;</para>
  <para style="q2" vid="PSA 103:3">izi ne harge ubbaafe</para>
  <para style="q2" vid="PSA 103:3">nena paththees.<verse eid="PSA 103:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4" />Izi nena</para>
  <para style="q2" vid="PSA 103:4">duufon gelontta mala ashshees;</para>
  <para style="q2" vid="PSA 103:4">mernaa siiqoninne maarotan</para>
  <para style="q2" vid="PSA 103:4">nena anjjees.<verse eid="PSA 103:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5" />Golle kafoththo neni ooraxana mala</para>
  <para style="q2" vid="PSA 103:5">izi ne amo ubbaa</para>
  <para style="q2" vid="PSA 103:5">lo7o miishshan kunththana.<verse eid="PSA 103:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6" />GODAY naaqettidaytas</para>
  <para style="q2" vid="PSA 103:6">xillo ooththeessinne</para>
  <para style="q2" vid="PSA 103:6">suure pirda pirdees.<verse eid="PSA 103:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7" />Izi ba oge Muse bessides;</para>
  <para style="q2" vid="PSA 103:7">ba oosokka</para>
  <para style="q2" vid="PSA 103:7">Isra7eele asaa erisides.<verse eid="PSA 103:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8" />GODAY qadhettizaadenne</para>
  <para style="q2" vid="PSA 103:8">maarizaade;</para>
  <para style="q2" vid="PSA 103:8">izi hanqettanaas eesotonttaade;</para>
  <para style="q2" vid="PSA 103:8">iza siiqoy keehippe daro.<note caller="-" style="x"><char style="xo" closed="false">103:8 </char><char style="xt" closed="false"><ref loc="JAS 5:11">Yaaqo 5:11</ref></char></note><verse eid="PSA 103:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9" />Izi ubba wode</para>
  <para style="q2" vid="PSA 103:9">nu mooros mootenna;</para>
  <para style="q2" vid="PSA 103:9">mernaaskka hanqettenna.<verse eid="PSA 103:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10" />Izi nu nagara mala</para>
  <para style="q2" vid="PSA 103:10">nuus ooththibeenna;</para>
  <para style="q2" vid="PSA 103:10">nu iitateththaa mala</para>
  <para style="q2" vid="PSA 103:10">nuus zaaribeenna.<verse eid="PSA 103:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11" />Saloy sa7appe dhoqqiza mala</para>
  <para style="q2" vid="PSA 103:11">GODAAS yayyizaytas</para>
  <para style="q2" vid="PSA 103:11">iza siiqoy gita.<verse eid="PSA 103:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12" />Arshey mokkizasoppe</para>
  <para style="q2" vid="PSA 103:12">wullizasoy haakkiza mala</para>
  <para style="q2" vid="PSA 103:12">GODAY nu mooroza</para>
  <para style="q2" vid="PSA 103:12">nuuppe haassides.<verse eid="PSA 103:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13" />Aaway ba naytas</para>
  <para style="q2" vid="PSA 103:13">qadhettiza mala</para>
  <para style="q2" vid="PSA 103:13">GODAY baas yayyizaytas qadhettees.<verse eid="PSA 103:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14" />Nuni aazappe medhettidaakko</para>
  <para style="q2" vid="PSA 103:14">izi erees;</para>
  <para style="q2" vid="PSA 103:14">nuni biitta gididayssaka</para>
  <para style="q2" vid="PSA 103:14">izi akeekees.<verse eid="PSA 103:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15" />Asa de7oy gidikko maata mala;</para>
  <para style="q2" vid="PSA 103:15">izi bazzo ciishsha mala ciiyees.<verse eid="PSA 103:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16" />Carkoy carkiza wode</para>
  <para style="q2" vid="PSA 103:16">qoqofetti dhayees;</para>
  <para style="q2" vid="PSA 103:16">izi kase dizasoy</para>
  <para style="q2" vid="PSA 103:16">mulekka erettenna.<verse eid="PSA 103:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17" />Gido attiin GODAAS yayyizaytas</para>
  <para style="q2" vid="PSA 103:17">iza siiqoy mernaappe</para>
  <para style="q2" vid="PSA 103:17">mernaa gakkanaassa;</para>
  <para style="q2" vid="PSA 103:17">iza xilloteththayka</para>
  <para style="q2" vid="PSA 103:17">yeletappe yeleta gakkanaassa.<verse eid="PSA 103:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18" />Hessi hananay</para>
  <para style="q2" vid="PSA 103:18">iza caaqo qaala</para>
  <para style="q2" vid="PSA 103:18">naagizaytassinne</para>
  <para style="q2" vid="PSA 103:18">iza azazo polanaas</para>
  <para style="q2" vid="PSA 103:18">minettizaytassa.<verse eid="PSA 103:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19" />GODAY ba araataa salon essides;</para>
  <para style="q2" vid="PSA 103:19">iza kawoteththay ubbaa haarees.<verse eid="PSA 103:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20" />Intteno iza kiitanchchatoo!</para>
  <para style="q2" vid="PSA 103:20">Iza azazo poliza wolqqamatoo!</para>
  <para style="q2" vid="PSA 103:20">Izi gizayssa ezgizaytoo!</para>
  <para style="q2" vid="PSA 103:20">GODAA galatite.<verse eid="PSA 103:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21" />Intteno salon de7iza minotoo!</para>
  <para style="q2" vid="PSA 103:21">Iza shene ooththiza aylletoo!</para>
  <para style="q2" vid="PSA 103:21">GODAA galatite.<verse eid="PSA 103:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22" />Intteno izi haariza soho</para>
  <para style="q2" vid="PSA 103:22">ubbaan de7iza medhetatoo!</para>
  <para style="q2" vid="PSA 103:22">ubbayka GODAA galatite.</para>
  <para style="q2" vid="PSA 103:22">Ta shemppoyee! GODAA galata.<verse eid="PSA 103:22" /></para>
  <chapter eid="PSA 103" />
  <chapter number="104" style="c" sid="PSA 104" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1" />Ta shemppoyee!</para>
  <para style="q2" vid="PSA 104:1">GODAA ta Xoossa galata!</para>
  <para style="q2" vid="PSA 104:1">Abeet GODAA ta Xoossawu!</para>
  <para style="q2" vid="PSA 104:1">Neni ay keena gitaa!</para>
  <para style="q2" vid="PSA 104:1">Neni bonchchonne</para>
  <para style="q2" vid="PSA 104:1">teema may7adasa.<verse eid="PSA 104:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2" />Neni afala mala poo7o quma7adasa;</para>
  <para style="q2" vid="PSA 104:2">salotakka dunkaane mala</para>
  <para style="q2" vid="PSA 104:2">toladasa.<verse eid="PSA 104:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 104:3" />Ne keeththaa</para>
  <para style="q2" vid="PSA 104:3">salo gufanththo bollan keexxadasa;</para>
  <para style="q2" vid="PSA 104:3">shaara nees para-gaare kessadasa;</para>
  <para style="q2" vid="PSA 104:3">carko qefe toggada baasa.<verse eid="PSA 104:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4" />Neni carkota ne kiitanchcha,</para>
  <para style="q2" vid="PSA 104:4">tama lacokka ne aylle kessaasa.<note caller="-" style="x"><char style="xo" closed="false">104:4 </char><char style="xt" closed="false"><ref loc="HEB 1:7">Ib 1:7</ref></char></note><verse eid="PSA 104:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5" />Neni sa7a yochcha bolla essadasa;</para>
  <para style="q2" vid="PSA 104:5">izi meri mernaaskka qaaxxenna.<verse eid="PSA 104:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6" />Wogga gita abba biitta bollan</para>
  <para style="q2" vid="PSA 104:6">afala mala miccadasa;</para>
  <para style="q2" vid="PSA 104:6">haaththika gita zumata</para>
  <para style="q2" vid="PSA 104:6">kammides.<verse eid="PSA 104:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7" />Gido attiin ne seeriin</para>
  <para style="q2" vid="PSA 104:7">haaththati kichchida;</para>
  <para style="q2" vid="PSA 104:7">ne azazo siyidi eeson baqatida.<verse eid="PSA 104:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8" />Istti gita zumatappe</para>
  <para style="q2" vid="PSA 104:8">duge shoobbata wodhdhida;</para>
  <para style="q2" vid="PSA 104:8">neni isttas giigsidaso goggida.<verse eid="PSA 104:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9" />Haaththati simmidi</para>
  <para style="q2" vid="PSA 104:9">biitta kammontta mala,</para>
  <para style="q2" vid="PSA 104:9">istti aadhdhontta mala</para>
  <para style="q2" vid="PSA 104:9">zawa essadasa.<verse eid="PSA 104:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10" />Neni pulttota shoobban pulttisaasa;</para>
  <para style="q2" vid="PSA 104:10">haath zumata giddora</para>
  <para style="q2" vid="PSA 104:10">duge gogissaasa.<verse eid="PSA 104:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11" />Bazzo do7ati ubbay izappe uyeettes;</para>
  <para style="q2" vid="PSA 104:11">harididatikka saamos</para>
  <para style="q2" vid="PSA 104:11">izappe uyi aleettes.<verse eid="PSA 104:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12" />Salo kafoti haaththaa matan</para>
  <para style="q2" vid="PSA 104:12">bantta keeththa keexxeettes;</para>
  <para style="q2" vid="PSA 104:12">miththa haggata giddonkka</para>
  <para style="q2" vid="PSA 104:12">yexxeettes.<verse eid="PSA 104:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13" />Neni gita zumata bollan</para>
  <para style="q2" vid="PSA 104:13">saloppe ira bukisaasa;</para>
  <para style="q2" vid="PSA 104:13">biittaaka ne kushe ooso</para>
  <para style="q2" vid="PSA 104:13">ayfen kunththadasa.<verse eid="PSA 104:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14" />Neni mehes maata,</para>
  <para style="q2" vid="PSA 104:14">asas kath mokisaasa;</para>
  <para style="q2" vid="PSA 104:14">hessan asay biitta ooththidi</para>
  <para style="q2" vid="PSA 104:14">kath shiishshees.<verse eid="PSA 104:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 104:15" />Asa wozina ufayssiza woyne,</para>
  <para style="q2" vid="PSA 104:15">sinth shicissiza zaytenne</para>
  <para style="q2" vid="PSA 104:15">wolqqa immiza kath demmees.<verse eid="PSA 104:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16" />GODAA miththati,</para>
  <para style="q2" vid="PSA 104:16">izi tokkida Libaanoose zigati</para>
  <para style="q2" vid="PSA 104:16">daro ira uyi kalleettes.<verse eid="PSA 104:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17" />Isttan kafoti</para>
  <para style="q2" vid="PSA 104:17">bantta keeth keexxeettes;</para>
  <para style="q2" vid="PSA 104:17">zigiletikka ziga bolla</para>
  <para style="q2" vid="PSA 104:17">keexxidi de7eettes.<verse eid="PSA 104:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18" />Dhoqqa zumata bollan</para>
  <para style="q2" vid="PSA 104:18">Wushati de7eettes;</para>
  <para style="q2" vid="PSA 104:18">qasse guppaleti</para>
  <para style="q2" vid="PSA 104:18">shuchcha gongolon qotetteettes.<verse eid="PSA 104:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19" />Wodaa qooda erisanaas</para>
  <para style="q2" vid="PSA 104:19">neni agina medhdhadasa;</para>
  <para style="q2" vid="PSA 104:19">arshey ba wulliza wode erees.<verse eid="PSA 104:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20" />Neni dhuma ehiza wode</para>
  <para style="q2" vid="PSA 104:20">sa7ay qammees;</para>
  <para style="q2" vid="PSA 104:20">wora do7atikka kezidi</para>
  <para style="q2" vid="PSA 104:20">woxeretteettes.<verse eid="PSA 104:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21" />Wodalla gaammoti</para>
  <para style="q2" vid="PSA 104:21">maana miishshas waasseettes;</para>
  <para style="q2" vid="PSA 104:21">istti banttas miza miish</para>
  <para style="q2" vid="PSA 104:21">Xoossafe koyeettes.<verse eid="PSA 104:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22" />Arshey mokkiza wode</para>
  <para style="q2" vid="PSA 104:22">guye simmidi</para>
  <para style="q2" vid="PSA 104:22">bantta aqoson ichcheettes.<verse eid="PSA 104:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23" />He wode asi ba oosos kezees;</para>
  <para style="q2" vid="PSA 104:23">sa7ay qammana gakkanaas</para>
  <para style="q2" vid="PSA 104:23">ooththees.<verse eid="PSA 104:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 104:24">Ne oosoy ay keena daroo!</para>
  <para style="q2" vid="PSA 104:24">Ne aadho erateththan</para>
  <para style="q2" vid="PSA 104:24">neni istta ubbaa medhdhadasa;</para>
  <para style="q2" vid="PSA 104:24">ne medhdhida medhetati</para>
  <para style="q2" vid="PSA 104:24">biitta kumida.<verse eid="PSA 104:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25" />Hanna abbaya gitanne aaho;</para>
  <para style="q2" vid="PSA 104:25">qooday baynda qaaxxiza</para>
  <para style="q2" vid="PSA 104:25">medheteththati,</para>
  <para style="q2" vid="PSA 104:25">guuththatinne gitati izin kumida.<verse eid="PSA 104:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26" />Izi bollan markabeti simeretteettes;</para>
  <para style="q2" vid="PSA 104:26">qasse neni medhdhida</para>
  <para style="q2" vid="PSA 104:26">Lewataane geetettiza miiminttey</para>
  <para style="q2" vid="PSA 104:26">izin kaa7ees.<note caller="-" style="x"><char style="xo" closed="false">104:26 </char><char style="xt" closed="false"><ref loc="JOB 41:1">Iyo 41:1</ref>; <ref loc="PSA 74:14">Maza 74:14</ref>; <ref loc="ISA 27:1">Isa 27:1</ref></char></note><verse eid="PSA 104:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27" />Koshshiza wode ne isttas</para>
  <para style="q2" vid="PSA 104:27">mizaaz immana mala</para>
  <para style="q2" vid="PSA 104:27">istti ubbay neekko xeelleettes.<verse eid="PSA 104:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28" />Neni isttas immida wode</para>
  <para style="q2" vid="PSA 104:28">istti shiishsheettes;</para>
  <para style="q2" vid="PSA 104:28">neni ne kusheppe yeggiin</para>
  <para style="q2" vid="PSA 104:28">istti lo7o miish kalleettes.<verse eid="PSA 104:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29" />Neni ne sinththa</para>
  <para style="q2" vid="PSA 104:29">genththiza wode dagammeettes;</para>
  <para style="q2" vid="PSA 104:29">ne istta shemppo</para>
  <para style="q2" vid="PSA 104:29">ekkiza wode hayqqeettes;</para>
  <para style="q2" vid="PSA 104:29">duge biittankka simmi geleettes.<verse eid="PSA 104:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30" />Gido attiin neni isttas</para>
  <para style="q2" vid="PSA 104:30">ne ayana kiittida wode</para>
  <para style="q2" vid="PSA 104:30">harati medhetteettes;</para>
  <para style="q2" vid="PSA 104:30">biittaaka ooraxissaasa.<verse eid="PSA 104:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31" />GODAA bonchchoy mernaas de7o;</para>
  <para style="q2" vid="PSA 104:31">GODAY ba ooson ufayetto.<verse eid="PSA 104:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32" />Izi biitta xeelliin biittay qaaxxees;</para>
  <para style="q2" vid="PSA 104:32">qasse izi zumata bochchiin</para>
  <para style="q2" vid="PSA 104:32">zumati cuwatteettes.<verse eid="PSA 104:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33" />Tani de7iza layth ubbaan</para>
  <para style="q2" vid="PSA 104:33">GODAAS yexxana;</para>
  <para style="q2" vid="PSA 104:33">tani shemppora paxa</para>
  <para style="q2" vid="PSA 104:33">de7ida wode ubbaan</para>
  <para style="q2" vid="PSA 104:33">ta Xoossas yexxana.<verse eid="PSA 104:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34" />Tani GODAAN ufayettiza gishshas</para>
  <para style="q2" vid="PSA 104:34">ta wozina qofay iza ufaysso.<verse eid="PSA 104:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35" />Nagaranchchati biittafe dhayetto;</para>
  <para style="q2" vid="PSA 104:35">hayssafe sinththas</para>
  <para style="q2" vid="PSA 104:35">iitati dooppetto.</para>
  <para style="b" vid="PSA 104:35" />
  <para style="q2" vid="PSA 104:35">Ta shemppoyee!</para>
  <para style="q2" vid="PSA 104:35">GODAA galata!</para>
  <para style="q2" vid="PSA 104:35">GODAA galata!<verse eid="PSA 104:35" /></para>
  <chapter eid="PSA 104" />
  <chapter number="105" style="c" sid="PSA 105" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1" />GODAA galatite;</para>
  <para style="q2" vid="PSA 105:1">iza sunththa xeygite;</para>
  <para style="q2" vid="PSA 105:1">izi ooththida oosota</para>
  <para style="q2" vid="PSA 105:1">kawoteththata erisite.<verse eid="PSA 105:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2" />Izas ginxo giigsite;</para>
  <para style="q2" vid="PSA 105:2">galata yeththika yexxite;</para>
  <para style="q2" vid="PSA 105:2">malalisiza iza ooso ubbaa yootite.<verse eid="PSA 105:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3" />Geeshsha sunththan</para>
  <para style="q2" vid="PSA 105:3">izayssan ceeqettite;</para>
  <para style="q2" vid="PSA 105:3">GODAA koyzayta</para>
  <para style="q2" vid="PSA 105:3">wozinay ufayetto.<verse eid="PSA 105:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4" />GODAANNE iza wolqqa xomosite;</para>
  <para style="q2" vid="PSA 105:4">ubbato iza sinththa koyite.<verse eid="PSA 105:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5-6" style="v" sid="PSA 105:5-6" />Intteno iza aylle</para>
  <para style="q2" vid="PSA 105:5-6">Abrahaame zereththatoo!</para>
  <para style="q2" vid="PSA 105:5-6">Doorettida Yaaqoobe naytoo!</para>
  <para style="q2" vid="PSA 105:5-6">Izi ooththida malalisiza oosota,</para>
  <para style="q2" vid="PSA 105:5-6">iza malaatanne izi pirdida</para>
  <para style="q2" vid="PSA 105:5-6">pirda akeekite.<verse eid="PSA 105:5-6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7" />Izi GODAA nu Xoossaa;</para>
  <para style="q2" vid="PSA 105:7">iza suure pirdayka</para>
  <para style="q2" vid="PSA 105:7">sa7a ubbaa bolla dees.<verse eid="PSA 105:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8" />Izi ba caaqo qaala mernaas</para>
  <para style="q2" vid="PSA 105:8">ba azazida qaala shii yeleta</para>
  <para style="q2" vid="PSA 105:8">gakkanaas naagees.<verse eid="PSA 105:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9" />Izi Abrahaames caaqqida</para>
  <para style="q2" vid="PSA 105:9">caaqo qaala,</para>
  <para style="q2" vid="PSA 105:9">Yisaaqas immida qaala balenna.<note caller="-" style="x"><char style="xo" closed="false">105:9 </char><char style="xt" closed="false"><ref loc="GEN 12:7">Medhe 12:7</ref>; <ref loc="GEN 17:8">17:8</ref>; <ref loc="GEN 26:3">26:3</ref></char></note><verse eid="PSA 105:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10" />Hessa Yaaqoobes woga,</para>
  <para style="q2" vid="PSA 105:10">Isra7eelesikka</para>
  <para style="q2" vid="PSA 105:10">mernaa caaqo qaala</para>
  <para style="q2" vid="PSA 105:10">histtidi minththi essides.<note caller="-" style="x"><char style="xo" closed="false">105:10-11 </char><char style="xt" closed="false"><ref loc="GEN 28:13">Medhe 28:13</ref></char></note><verse eid="PSA 105:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11" />Qasseka, «Nees Kanaane</para>
  <para style="q2" vid="PSA 105:11">biittaa immana;</para>
  <para style="q2" vid="PSA 105:11">izikka ne zereththatas</para>
  <para style="q2" vid="PSA 105:11">laata gidana» gides.<verse eid="PSA 105:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12" />Istti qoodan qii guuththatanne</para>
  <para style="q2" vid="PSA 105:12">Kanaane biittan</para>
  <para style="q2" vid="PSA 105:12">bete gididi diza wode,<verse eid="PSA 105:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="PSA 105:13" />issi dereppe hara dere,</para>
  <para style="q2" vid="PSA 105:13">issi kawoteththafe</para>
  <para style="q2" vid="PSA 105:13">hara kawoteth yuuyida.<verse eid="PSA 105:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14" />Xoossi istta oonikka qohanaas</para>
  <para style="q2" vid="PSA 105:14">immibeenna;</para>
  <para style="q2" vid="PSA 105:14">istta gishshas kawota seerishe,<verse eid="PSA 105:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="PSA 105:15" />«Tani tiydayta bochchofte;</para>
  <para style="q2" vid="PSA 105:15">nabeta qohopite» gides.<note caller="-" style="x"><char style="xo" closed="false">105:14-15 </char><char style="xt" closed="false"><ref loc="GEN 20:3-7">Medhe 20:3-7</ref></char></note><verse eid="PSA 105:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16" />GODAY biittaa bolla</para>
  <para style="q2" vid="PSA 105:16">kosha yeddides.</para>
  <para style="q2" vid="PSA 105:16">Istta kath ubbaa dhayssides.<note caller="-" style="x"><char style="xo" closed="false">105:16 </char><char style="xt" closed="false"><ref loc="GEN 41:53-57">Medhe 41:53-57</ref></char></note><verse eid="PSA 105:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17" />Gido attiin izi ba asaa ashshanaas</para>
  <para style="q2" vid="PSA 105:17">isttafe sinththan aylleteththas</para>
  <para style="q2" vid="PSA 105:17">bayzettida Yooseefe kiittides.<note caller="-" style="x"><char style="xo" closed="false">105:17 </char><char style="xt" closed="false"><ref loc="GEN 28">Medhe 28</ref>; <ref loc="GEN 45:5">45:5</ref></char></note><verse eid="PSA 105:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18" />Iza tohoti kaatenan waaxettida;</para>
  <para style="q2" vid="PSA 105:18">izi sansalatan qashettides.<verse eid="PSA 105:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19" />Izi kase yootidayssi</para>
  <para style="q2" vid="PSA 105:19">polettana gakkanaas</para>
  <para style="q2" vid="PSA 105:19">GODAA qaalay iza paaccides.<note caller="-" style="x"><char style="xo" closed="false">105:18-19 </char><char style="xt" closed="false"><ref loc="GEN 39:20-40:23">Medhe 39:20—40:23</ref></char></note><verse eid="PSA 105:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20" />Kawoy as kiittidi</para>
  <para style="q2" vid="PSA 105:20">iza birshisides;</para>
  <para style="q2" vid="PSA 105:20">deraa haarizayssi</para>
  <para style="q2" vid="PSA 105:20">qasho keeththafe kessides.<note caller="-" style="x"><char style="xo" closed="false">105:20 </char><char style="xt" closed="false"><ref loc="GEN 41:14">Medhe 41:14</ref></char></note><verse eid="PSA 105:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21" />Kawozi iza ba keeththas</para>
  <para style="q2" vid="PSA 105:21">goda ooththides;</para>
  <para style="q2" vid="PSA 105:21">baas diza ubbaa</para>
  <para style="q2" vid="PSA 105:21">aqota bolla shuumides.<note caller="-" style="x"><char style="xo" closed="false">105:21 </char><char style="xt" closed="false"><ref loc="GEN 41:39-41">Medhe 41:39-41</ref></char></note><verse eid="PSA 105:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22" />Hessika shuumeta</para>
  <para style="q2" vid="PSA 105:22">maarara kaaleththana malanne</para>
  <para style="q2" vid="PSA 105:22">gita asata aadho erateth</para>
  <para style="q2" vid="PSA 105:22">tamaarsana mala sunththides.<verse eid="PSA 105:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23" />Hessafe guye Isra7eeley</para>
  <para style="q2" vid="PSA 105:23">Gibxe gelides;</para>
  <para style="q2" vid="PSA 105:23">Yaaqoobey Kaame biittan</para>
  <para style="q2" vid="PSA 105:23">bete as gididi de7ides.<note caller="-" style="x"><char style="xo" closed="false">105:23 </char><char style="xt" closed="false"><ref loc="GEN 46:6">Medhe 46:6</ref>; <ref loc="GEN 47:11">47:11</ref></char></note><verse eid="PSA 105:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24" />GODAY ba asaa keehi corasides;</para>
  <para style="q2" vid="PSA 105:24">istta morkketappe</para>
  <para style="q2" vid="PSA 105:24">istta aaththi minththides.<verse eid="PSA 105:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25" />Izi Gibxe asay</para>
  <para style="q2" vid="PSA 105:25">ba asaa ixxana malanne</para>
  <para style="q2" vid="PSA 105:25">ba aylleta bolla</para>
  <para style="q2" vid="PSA 105:25">dendana mala ooththides.<note caller="-" style="x"><char style="xo" closed="false">105:24-25 </char><char style="xt" closed="false"><ref loc="EXO 1:7-14">Kessa 1:7-14</ref></char></note><verse eid="PSA 105:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26" />Hessafe guye ba aylle Musenne</para>
  <para style="q2" vid="PSA 105:26">ba doorida Aaroone</para>
  <para style="q2" vid="PSA 105:26">isttako kiittides.<note caller="-" style="x"><char style="xo" closed="false">105:26 </char><char style="xt" closed="false"><ref loc="EXO 3:1-4:17">Kessa 3:1—4:17</ref></char></note><verse eid="PSA 105:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27" />Istti Gibxe asata sinththan</para>
  <para style="q2" vid="PSA 105:27">Xoossa malaata,</para>
  <para style="q2" vid="PSA 105:27">Kaame biittan</para>
  <para style="q2" vid="PSA 105:27">malalisiza miish ooththida.<verse eid="PSA 105:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28" />GODAY dhuma kiittidi</para>
  <para style="q2" vid="PSA 105:28">he biitta dhumisides;</para>
  <para style="q2" vid="PSA 105:28">gido attiin Gibxe asati</para>
  <para style="q2" vid="PSA 105:28">iza azazo ixxis gida.<note caller="-" style="x"><char style="xo" closed="false">105:28 </char><char style="xt" closed="false"><ref loc="EXO 10:21-23">Kessa 10:21-23</ref></char></note><verse eid="PSA 105:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29" />Istta haaththa suuththan laammidi</para>
  <para style="q2" vid="PSA 105:29">moleta wodhides.<note caller="-" style="x"><char style="xo" closed="false">105:29 </char><char style="xt" closed="false"><ref loc="EXO 7:17-21">Kessa 7:17-21</ref></char></note><verse eid="PSA 105:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30" />Istta biitta ubbaa</para>
  <para style="q2" vid="PSA 105:30">kawoza keeththaaka</para>
  <para style="q2" vid="PSA 105:30">shodhdhey kumides.<note caller="-" style="x"><char style="xo" closed="false">105:30 </char><char style="xt" closed="false"><ref loc="EXO 8:1-6">Kessa 8:1-6</ref></char></note><verse eid="PSA 105:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31" />Izi azaziin boxeynne uu7ey</para>
  <para style="q2" vid="PSA 105:31">istta biitta ubbaa bolla</para>
  <para style="q2" vid="PSA 105:31">shom7ushom7ides.<note caller="-" style="x"><char style="xo" closed="false">105:31 </char><char style="xt" closed="false"><ref loc="EXO 8:16-17">Kessa 8:16-17</ref>,<ref loc="EXO 8:20-24">20-24</ref></char></note><verse eid="PSA 105:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32" />Istta biitta bollan ira gishshas</para>
  <para style="q2" vid="PSA 105:32">shach wolqqanththara</para>
  <para style="q2" vid="PSA 105:32">bukisides.<verse eid="PSA 105:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33" />Izi istta woyne turanne</para>
  <para style="q2" vid="PSA 105:33">balase mith ubbaa dippi histtides;</para>
  <para style="q2" vid="PSA 105:33">istta biittan de7iza miththatakka</para>
  <para style="q2" vid="PSA 105:33">menththereththides.<note caller="-" style="x"><char style="xo" closed="false">105:32-33 </char><char style="xt" closed="false"><ref loc="EXO 9:22-25">Kessa 9:22-25</ref></char></note><verse eid="PSA 105:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34" />Izi azaziin booleynne</para>
  <para style="q2" vid="PSA 105:34">qooday baynda</para>
  <para style="q2" vid="PSA 105:34">gumbaroy kezides.<verse eid="PSA 105:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35" />Histtidi istta gaden</para>
  <para style="q2" vid="PSA 105:35">mokkida kath ubbaa mides;</para>
  <para style="q2" vid="PSA 105:35">istta biittan diza cilila miish</para>
  <para style="q2" vid="PSA 105:35">ubbaaka dippi histtides.<note caller="-" style="x"><char style="xo" closed="false">105:34-35 </char><char style="xt" closed="false"><ref loc="EXO 10:12-15">Kessa 10:12-15</ref></char></note><verse eid="PSA 105:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36" />GODAY Gibxe deren</para>
  <para style="q2" vid="PSA 105:36">bayrata ubbaa wodhides;</para>
  <para style="q2" vid="PSA 105:36">koyro yelettida nayta</para>
  <para style="q2" vid="PSA 105:36">ubbaaka dhayssides.<note caller="-" style="x"><char style="xo" closed="false">105:36 </char><char style="xt" closed="false"><ref loc="EXO 12:29">Kessa 12:29</ref></char></note><verse eid="PSA 105:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37" />Hessafe guye izi Isra7eele asaa</para>
  <para style="q2" vid="PSA 105:37">worqqanne bira alleqora kessides;</para>
  <para style="q2" vid="PSA 105:37">istta giddofe</para>
  <para style="q2" vid="PSA 105:37">kundidi attiday ooninne baawa.<verse eid="PSA 105:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38" />Gibxe asati isttas</para>
  <para style="q2" vid="PSA 105:38">daro yayyida gishshas</para>
  <para style="q2" vid="PSA 105:38">istti kezi bishin ufayettida.<note caller="-" style="x"><char style="xo" closed="false">105:37-38 </char><char style="xt" closed="false"><ref loc="EXO 12:33-36">Kessa 12:33-36</ref></char></note><verse eid="PSA 105:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39" />Xoossay istta kammanaas</para>
  <para style="q2" vid="PSA 105:39">shaara miccides;</para>
  <para style="q2" vid="PSA 105:39">omars isttas poo7isanawu</para>
  <para style="q2" vid="PSA 105:39">tama giigsides.<note caller="-" style="x"><char style="xo" closed="false">105:39 </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">Kessa 13:21-22</ref></char></note><verse eid="PSA 105:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40" />Istti miza miish oychchiin</para>
  <para style="q2" vid="PSA 105:40">kuracho misatiza kafota</para>
  <para style="q2" vid="PSA 105:40">isttas yeddides;</para>
  <para style="q2" vid="PSA 105:40">istta salo quma kalisides.<note caller="-" style="x"><char style="xo" closed="false">105:40 </char><char style="xt" closed="false"><ref loc="EXO 16:2-15">Kessa 16:2-15</ref></char></note><verse eid="PSA 105:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41" />Izi zaalla phalqiin haaththi pulttides;</para>
  <para style="q2" vid="PSA 105:41">shaafa malakka duge bazzo goggides.<note caller="-" style="x"><char style="xo" closed="false">105:41 </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">Kessa 17:1-7</ref>; <ref loc="NUM 20:2-13">Tay 20:2-13</ref></char></note><verse eid="PSA 105:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42" />Izi ba aylle Abrahaames</para>
  <para style="q2" vid="PSA 105:42">caaqqida geeshsha qaala</para>
  <para style="q2" vid="PSA 105:42">hassa7ides.<verse eid="PSA 105:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43" />Izi ba asaa ufayssan,</para>
  <para style="q2" vid="PSA 105:43">ba dooridayta ililisan kessides.<verse eid="PSA 105:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44" />Izi isttas hara kawoteththata</para>
  <para style="q2" vid="PSA 105:44">biitta immides;</para>
  <para style="q2" vid="PSA 105:44">histtiin istti harati</para>
  <para style="q2" vid="PSA 105:44">daaburi kessida kaththa</para>
  <para style="q2" vid="PSA 105:44">ayfe laattida.<note caller="-" style="x"><char style="xo" closed="false">105:44 </char><char style="xt" closed="false"><ref loc="JOS 11:16-23">Iya 11:16-23</ref></char></note><verse eid="PSA 105:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45" />Hessa izi ooththiday</para>
  <para style="q2" vid="PSA 105:45">istti izi woththida</para>
  <para style="q2" vid="PSA 105:45">maara naaganaassa;</para>
  <para style="q2" vid="PSA 105:45">iza wogaakka polanaassa.</para>
  <para style="b" vid="PSA 105:45" />
  <para style="q2" vid="PSA 105:45">GODAA galatite!<verse eid="PSA 105:45" /></para>
  <chapter eid="PSA 105" />
  <chapter number="106" style="c" sid="PSA 106" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1" />GODAA galatite!</para>
  <para style="q2" vid="PSA 106:1">Izi kiya gidida gishshas,</para>
  <para style="q2" vid="PSA 106:1">iza siiqoykka</para>
  <para style="q2" vid="PSA 106:1">mernaas gidida gishshas</para>
  <para style="q2" vid="PSA 106:1">GODAA galatite.<note caller="-" style="x"><char style="xo" closed="false">106:1 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1Taari 16:34</ref>; <ref loc="2CH 5:13">2Taari 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Iz 3:11</ref>; <ref loc="PSA 100:5">Maza 100:5</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Er 33:11</ref></char></note><verse eid="PSA 106:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2" />GODAY ooththida wolqqama</para>
  <para style="q2" vid="PSA 106:2">ooso yootanaas,</para>
  <para style="q2" vid="PSA 106:2">woykko iza galata</para>
  <para style="q2" vid="PSA 106:2">ubbaa qonccisanaas</para>
  <para style="q2" vid="PSA 106:2">dandayzay oonee?<verse eid="PSA 106:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3" />Pirday geellattontta mala</para>
  <para style="q2" vid="PSA 106:3">naagizaytinne</para>
  <para style="q2" vid="PSA 106:3">ubba wode xillo ooththizayti</para>
  <para style="q2" vid="PSA 106:3">anjjettidayta.<verse eid="PSA 106:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 106:4">Neni ne asaa maaddiza wode</para>
  <para style="q2" vid="PSA 106:4">tana qoppa;</para>
  <para style="q2" vid="PSA 106:4">istta neni ashshiza wode</para>
  <para style="q2" vid="PSA 106:4">tanakka alla.<verse eid="PSA 106:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5" />Hessika ne doorida asaas</para>
  <para style="q2" vid="PSA 106:5">sa7ay kiyiin tani beyana mala,</para>
  <para style="q2" vid="PSA 106:5">ne asaa ufayssa</para>
  <para style="q2" vid="PSA 106:5">tani ufayettana mala,</para>
  <para style="q2" vid="PSA 106:5">ne nayti bonchchettida gaason</para>
  <para style="q2" vid="PSA 106:5">tanikka ufayssan</para>
  <para style="q2" vid="PSA 106:5">magulana malassa.<verse eid="PSA 106:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6" />Nuni nu aawata mala</para>
  <para style="q2" vid="PSA 106:6">nagara ooththidos;</para>
  <para style="q2" vid="PSA 106:6">mooronne iita ooththidos.<verse eid="PSA 106:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7" />Nu aawati Gibxen de7iza wode,</para>
  <para style="q2" vid="PSA 106:7">ne malalisiza ooso</para>
  <para style="q2" vid="PSA 106:7">qoppibeettenna.</para>
  <para style="q2" vid="PSA 106:7">Ne siiqo daroteththaa</para>
  <para style="q2" vid="PSA 106:7">istti akeekibeettenna;</para>
  <para style="q2" vid="PSA 106:7">Zo7o abba lanqen makkallida.<note caller="-" style="x"><char style="xo" closed="false">106:7 </char><char style="xt" closed="false"><ref loc="EXO 14:10-12">Kessa 14:10-12</ref></char></note><verse eid="PSA 106:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8" />Gidikkoka izi ba sunththaa</para>
  <para style="q2" vid="PSA 106:8">gishshas, ba gita</para>
  <para style="q2" vid="PSA 106:8">wolqqa erisanaas</para>
  <para style="q2" vid="PSA 106:8">istta ashshides.<verse eid="PSA 106:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9" />Izi Zo7o abba seerides;</para>
  <para style="q2" vid="PSA 106:9">abbayka melides;</para>
  <para style="q2" vid="PSA 106:9">bazzon kaaleththizayssa mala</para>
  <para style="q2" vid="PSA 106:9">ciimma giddora</para>
  <para style="q2" vid="PSA 106:9">istta kaaleththidi pinththides.<verse eid="PSA 106:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10" />Izi istta</para>
  <para style="q2" vid="PSA 106:10">ixxizayta kusheppe ashshides;</para>
  <para style="q2" vid="PSA 106:10">morkketa kusheppe</para>
  <para style="q2" vid="PSA 106:10">istta wozzides.<verse eid="PSA 106:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11" />Istta morkketa haaththi mittides;</para>
  <para style="q2" vid="PSA 106:11">isttafe issoyka attibeenna.<verse eid="PSA 106:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12" />He wode Isra7eeleti</para>
  <para style="q2" vid="PSA 106:12">iza qaala ammanida;</para>
  <para style="q2" vid="PSA 106:12">iza yeththan sabbida.<note caller="-" style="x"><char style="xo" closed="false">106:9-12 </char><char style="xt" closed="false"><ref loc="EXO 14:21-31">Kessa 14:21-31</ref></char></note><note caller="-" style="x"><char style="xo" closed="false">106:12 </char><char style="xt" closed="false"><ref loc="EXO 15:1-21">Kessa 15:1-21</ref></char></note><verse eid="PSA 106:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13" />Gidikkoka istti izi ooththoyssa</para>
  <para style="q2" vid="PSA 106:13">heerakka dogida.</para>
  <para style="q2" vid="PSA 106:13">Iza zore naagontta</para>
  <para style="q2" vid="PSA 106:13">bantti koyidayssa ooththida.<verse eid="PSA 106:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14" />Istti bazzo biittan keehi amottida;</para>
  <para style="q2" vid="PSA 106:14">qasse mela biittankka</para>
  <para style="q2" vid="PSA 106:14">Xoossa paaccida.<verse eid="PSA 106:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15" />Hessa gishshas izi</para>
  <para style="q2" vid="PSA 106:15">istti woossidayssa immides;</para>
  <para style="q2" vid="PSA 106:15">gido attiin istta shemppos</para>
  <para style="q2" vid="PSA 106:15">gilqateth kiittides.<note caller="-" style="x"><char style="xo" closed="false">106:14-15 </char><char style="xt" closed="false"><ref loc="NUM 11:4-34">Tay 11:4-34</ref></char></note><verse eid="PSA 106:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16" />Asati bazzon dunkaani dishe</para>
  <para style="q2" vid="PSA 106:16">Musenne GODAAS dummatida</para>
  <para style="q2" vid="PSA 106:16">aylle Aaroone</para>
  <para style="q2" vid="PSA 106:16">qanaatida wode,<verse eid="PSA 106:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="PSA 106:17" />biittay doyettidi</para>
  <para style="q2" vid="PSA 106:17">Daataane mittides;</para>
  <para style="q2" vid="PSA 106:17">Abraame iza keeththa</para>
  <para style="q2" vid="PSA 106:17">asatara moogides.<verse eid="PSA 106:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18" />Qasse istta maabaraa giddon</para>
  <para style="q2" vid="PSA 106:18">tamay eexxiin,</para>
  <para style="q2" vid="PSA 106:18">lacoy he iita asata xuuggides.<note caller="-" style="x"><char style="xo" closed="false">106:16-18 </char><char style="xt" closed="false"><ref loc="NUM 16:1-35">Tay 16:1-35</ref></char></note><verse eid="PSA 106:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19" />Korebe Zuman de7ishe</para>
  <para style="q2" vid="PSA 106:19">worqqa seerisidi</para>
  <para style="q2" vid="PSA 106:19">mara misle medhdhida;</para>
  <para style="q2" vid="PSA 106:19">histtidi he mislaas goynnida.<verse eid="PSA 106:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20" />Istti bantta bonchcho Xoossaa</para>
  <para style="q2" vid="PSA 106:20">maata miza</para>
  <para style="q2" vid="PSA 106:20">miiza mislen laammida.<verse eid="PSA 106:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21" />Istti banttana ashshida</para>
  <para style="q2" vid="PSA 106:21">Xoossa dogida;</para>
  <para style="q2" vid="PSA 106:21">izi Gibxen gita ooso,<verse eid="PSA 106:21" /></para>
  <para style="q2">
    <verse number="22" style="v" sid="PSA 106:22" />Kaame biittankka</para>
  <para style="q2" vid="PSA 106:22">malalisizayssanne</para>
  <para style="q2" vid="PSA 106:22">Zo7o abban, «Hoola!» giissizayssa</para>
  <para style="q2" vid="PSA 106:22">ooththidayssa dogida.<verse eid="PSA 106:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23" />Hessa gishshas Xoossi</para>
  <para style="q2" vid="PSA 106:23">istta dhayssana gides;</para>
  <para style="q2" vid="PSA 106:23">gido attiin dhayssontta mala</para>
  <para style="q2" vid="PSA 106:23">iza hanqoza zaaranaas</para>
  <para style="q2" vid="PSA 106:23">Xoossi doorida</para>
  <para style="q2" vid="PSA 106:23">Musey giddon eqqides.<note caller="-" style="x"><char style="xo" closed="false">106:19-23 </char><char style="xt" closed="false"><ref loc="EXO 23:1-14">Kessa 23:1-14</ref></char></note><verse eid="PSA 106:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24" />He lo7o biittayo kadhida;</para>
  <para style="q2" vid="PSA 106:24">Hessafe guye</para>
  <para style="q2" vid="PSA 106:24">iza qaalan ammanettibeettenna.<verse eid="PSA 106:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25" />Istti bantta Dunkaaneza giddon</para>
  <para style="q2" vid="PSA 106:25">zuuzumidanne</para>
  <para style="q2" vid="PSA 106:25">GODAA qaalas</para>
  <para style="q2" vid="PSA 106:25">azazettontta ixxida.<verse eid="PSA 106:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26" />Hessa gishshas istti</para>
  <para style="q2" vid="PSA 106:26">bazzon kundi dhayana mala,</para>
  <para style="q2" vid="PSA 106:26">izi ba kushe denththidi caaqqides.<note caller="-" style="x"><char style="xo" closed="false">106:24-26 </char><char style="xt" closed="false"><ref loc="NUM 14:1-35">Tay 14:1-35</ref></char></note><verse eid="PSA 106:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27" />Istta zereththati</para>
  <para style="q2" vid="PSA 106:27">kawoteththata giddon</para>
  <para style="q2" vid="PSA 106:27">olettanayssanne</para>
  <para style="q2" vid="PSA 106:27">istti biitta gaxa gakkanaas</para>
  <para style="q2" vid="PSA 106:27">laalettanayssa yootides.<note caller="-" style="x"><char style="xo" closed="false">106:27 </char><char style="xt" closed="false"><ref loc="LEV 26:33">Lewe 26:33</ref></char></note><verse eid="PSA 106:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28" />Hessafe guye istti</para>
  <para style="q2" vid="PSA 106:28">Ba7aali-Pe7ooren diza</para>
  <para style="q2" vid="PSA 106:28">eeqas goynnizaytara</para>
  <para style="q2" vid="PSA 106:28">issife gayttida;</para>
  <para style="q2" vid="PSA 106:28">shemppoy baynda eeqatas</para>
  <para style="q2" vid="PSA 106:28">yarshettida yarshoza mida.<verse eid="PSA 106:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29" />Istti bantta ooson</para>
  <para style="q2" vid="PSA 106:29">GODAA hanqeththida;</para>
  <para style="q2" vid="PSA 106:29">histtiin istta giddon</para>
  <para style="q2" vid="PSA 106:29">iita hargey wodhdhides.<verse eid="PSA 106:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30" />Gido attiin Finihaasi dendidi</para>
  <para style="q2" vid="PSA 106:30">istta mooroza pirdiin</para>
  <para style="q2" vid="PSA 106:30">iita hargey</para>
  <para style="q2" vid="PSA 106:30">istta bollafe kichchides.<verse eid="PSA 106:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31" />Hessika yeletappe yeleta gakkanaas</para>
  <para style="q2" vid="PSA 106:31">mernaas izas</para>
  <para style="q2" vid="PSA 106:31">xilloteth gididi qoodettides.<verse eid="PSA 106:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32" />Mariiba pultto matan</para>
  <para style="q2" vid="PSA 106:32">GODAA hanqeththida;</para>
  <para style="q2" vid="PSA 106:32">istta gaason Muse bolla</para>
  <para style="q2" vid="PSA 106:32">metoy gakkides.<verse eid="PSA 106:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33" />Ays giikko istti Muse yiillosida;</para>
  <para style="q2" vid="PSA 106:33">histtiin iza doonappe</para>
  <para style="q2" vid="PSA 106:33">bessontta qaalay ke7ides.<note caller="-" style="x"><char style="xo" closed="false">106:32-33 </char><char style="xt" closed="false"><ref loc="NUM 20:2-13">Tay 20:2-13</ref></char></note><verse eid="PSA 106:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34" />GODAY dhayssite giin</para>
  <para style="q2" vid="PSA 106:34">istti Kanaane asata dhayssibeettenna.<verse eid="PSA 106:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35" />He palaappe istti</para>
  <para style="q2" vid="PSA 106:35">he kawoteththatara</para>
  <para style="q2" vid="PSA 106:35">geletti ekettidi walakettidanne</para>
  <para style="q2" vid="PSA 106:35">istta de7o woga kaallida.<verse eid="PSA 106:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36" />Xoossa asati istta eeqas goynnida;</para>
  <para style="q2" vid="PSA 106:36">hessika isttas woximade gidides.<note caller="-" style="x"><char style="xo" closed="false">106:34-36 </char><char style="xt" closed="false"><ref loc="JDG 2:1-3">Daanna 2:1-3</ref>; <ref loc="JDG 3:5-6">3:5-6</ref></char></note><verse eid="PSA 106:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37" />Istti bantta attumanne macca nayta</para>
  <para style="q2" vid="PSA 106:37">daydanththatas yarshida.<note caller="-" style="x"><char style="xo" closed="false">106:37 </char><char style="xt" closed="false"><ref loc="2KI 17:17">2Kawo 17:17</ref></char></note><verse eid="PSA 106:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38" />Istti xillo suuth</para>
  <para style="q2" vid="PSA 106:38">Kanaane eeqatas yarshida;</para>
  <para style="q2" vid="PSA 106:38">bantta attumanne macca nayta</para>
  <para style="q2" vid="PSA 106:38">suuth gussida;</para>
  <para style="q2" vid="PSA 106:38">he suuththan biittay tunides.<note caller="-" style="x"><char style="xo" closed="false">106:38 </char><char style="xt" closed="false"><ref loc="NUM 35:33">Tay 35:33</ref></char></note><verse eid="PSA 106:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39" />Hessaththo istti</para>
  <para style="q2" vid="PSA 106:39">bantta ooson tunidanne</para>
  <para style="q2" vid="PSA 106:39">layma maccassa mala</para>
  <para style="q2" vid="PSA 106:39">bantta Xoossas</para>
  <para style="q2" vid="PSA 106:39">ammanettontta ixxida.<verse eid="PSA 106:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40" />Hessa gishshas GODAA hanqoy</para>
  <para style="q2" vid="PSA 106:40">iza asaa bolla eexxi ke7ides;</para>
  <para style="q2" vid="PSA 106:40">izi bayta harassettides.<note caller="-" style="x"><char style="xo" closed="false">106:40-46 </char><char style="xt" closed="false"><ref loc="DAN 2:14-18">Daane 2:14-18</ref></char></note><verse eid="PSA 106:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41" />Izi istta hara kawoteththata kushen</para>
  <para style="q2" vid="PSA 106:41">aaththi immides;</para>
  <para style="q2" vid="PSA 106:41">istta morkketi istta haarida.<verse eid="PSA 106:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42" />Istta morkketi istta naaqqidanne</para>
  <para style="q2" vid="PSA 106:42">bantta shenen ayssida.<verse eid="PSA 106:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43" />Izi istta daroto ashshides;</para>
  <para style="q2" vid="PSA 106:43">gido attiin istta makkallas</para>
  <para style="q2" vid="PSA 106:43">gixxi kezida;</para>
  <para style="q2" vid="PSA 106:43">bantta nagara gaason dhayda.<verse eid="PSA 106:43" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44" />Gidikkoka istti waassida waasoza siyidi</para>
  <para style="q2" vid="PSA 106:44">istta waayeza qoppides.<verse eid="PSA 106:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45" />Istta gishshas</para>
  <para style="q2" vid="PSA 106:45">ba caaqo qaala hassa7ides;</para>
  <para style="q2" vid="PSA 106:45">aggontta ba siiqo daron</para>
  <para style="q2" vid="PSA 106:45">istta maarides.<verse eid="PSA 106:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46" />Istta di7ida ubbay</para>
  <para style="q2" vid="PSA 106:46">isttas qadhettana mala</para>
  <para style="q2" vid="PSA 106:46">ooththides.<verse eid="PSA 106:46" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47" />Abeet GODAWU Nu Xoossawu!</para>
  <para style="q2" vid="PSA 106:47">Nuna ashsha.</para>
  <para style="q2" vid="PSA 106:47">Nuni ne geeshsha</para>
  <para style="q2" vid="PSA 106:47">sunththa galatana mala</para>
  <para style="q2" vid="PSA 106:47">kawoteththata giddofe</para>
  <para style="q2" vid="PSA 106:47">nuna shiishsha.<verse eid="PSA 106:47" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48" />GODAY, Isra7eele Xoossi</para>
  <para style="q2" vid="PSA 106:48">mernaappe mernaa gakkanaas</para>
  <para style="q2" vid="PSA 106:48">galatetto!</para>
  <para style="q2" vid="PSA 106:48">Asay ubbay, «Amiin» go.</para>
  <para style="b" vid="PSA 106:48" />
  <para style="q2" vid="PSA 106:48">GODAA galatite!<note caller="-" style="x"><char style="xo" closed="false">106:47-48 </char><char style="xt" closed="false"><ref loc="1CH 16:35-36">1Taari 16:35-36</ref></char></note><verse eid="PSA 106:48" /></para>
  <chapter eid="PSA 106" />
  <chapter number="107" style="c" sid="PSA 107" />
  <para style="ms">Ichchashanththo Maxaafa</para>
  <para style="mr">(<ref loc="PSA 107-150">Maza 107—150</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1" />Izi kiyanne</para>
  <para style="q2" vid="PSA 107:1">iza siiqoy mernaas</para>
  <para style="q2" vid="PSA 107:1">gidida gishshas GODAA galatite.<note caller="-" style="x"><char style="xo" closed="false">107:1 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1Taari 16:34</ref>; <ref loc="2CH 5:13">2Taari 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Iz 3:11</ref>; <ref loc="PSA 100:5">Maza 100:5</ref>; <ref loc="PSA 106:1">106:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Er 33:11</ref></char></note><verse eid="PSA 107:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2" />GODAY istta wozzidayti,</para>
  <para style="q2" vid="PSA 107:2">istta morkketa kusheppe</para>
  <para style="q2" vid="PSA 107:2">izi ashshidayti hizgetto;<verse eid="PSA 107:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 107:3" />arshey mokkizasoppenne</para>
  <para style="q2" vid="PSA 107:3">wullizasoppe,</para>
  <para style="q2" vid="PSA 107:3">pudehappenne dugehappe</para>
  <para style="q2" vid="PSA 107:3">dere ubbaafe izi shiishshidayti</para>
  <para style="q2" vid="PSA 107:3">hizgi haasayetto.<verse eid="PSA 107:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4" />Isttafe issoti issoti</para>
  <para style="q2" vid="PSA 107:4">bazzo biittan toylattida;</para>
  <para style="q2" vid="PSA 107:4">ba de7iza katama efiza oge</para>
  <para style="q2" vid="PSA 107:4">demmanaas dandaybeettenna.<verse eid="PSA 107:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5" />Istti gafidanne saamettida;</para>
  <para style="q2" vid="PSA 107:5">keehippe daaburda.<verse eid="PSA 107:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6" />Istti metotida wode</para>
  <para style="q2" vid="PSA 107:6">GODAAKKO waassida;</para>
  <para style="q2" vid="PSA 107:6">izikka istta waayezappe</para>
  <para style="q2" vid="PSA 107:6">ashshides.<verse eid="PSA 107:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7" />Istti de7ana katama gakkanaas,</para>
  <para style="q2" vid="PSA 107:7">izi istta sitta ogera kaaleththides.<verse eid="PSA 107:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8" />Mernaa iza siiqozassinne</para>
  <para style="q2" vid="PSA 107:8">izi asas ooththida malalisiza</para>
  <para style="q2" vid="PSA 107:8">miishshatas istti GODAA</para>
  <para style="q2" vid="PSA 107:8">galatetto!<verse eid="PSA 107:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9" />Ays giikko izi saamettidayta</para>
  <para style="q2" vid="PSA 107:9">ushshi alisees;</para>
  <para style="q2" vid="PSA 107:9">gafidaytakka</para>
  <para style="q2" vid="PSA 107:9">lo7o miishshan kalssees.<verse eid="PSA 107:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10" />Isttafe issoti issoti birata</para>
  <para style="q2" vid="PSA 107:10">sansalatan qashettidi</para>
  <para style="q2" vid="PSA 107:10">waayettizayta;</para>
  <para style="q2" vid="PSA 107:10">sakkanna dhuma giddonkka</para>
  <para style="q2" vid="PSA 107:10">uttidayta;<verse eid="PSA 107:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="PSA 107:11" />Gaasoykka istti</para>
  <para style="q2" vid="PSA 107:11">Xoossa qaala bolla makkallidanne</para>
  <para style="q2" vid="PSA 107:11">Ubbaafe Dhoqqa Xoossa</para>
  <para style="q2" vid="PSA 107:11">zore kadhida.<verse eid="PSA 107:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12" />Hessa gishshas wolqqa ooson</para>
  <para style="q2" vid="PSA 107:12">istta ixeththides;</para>
  <para style="q2" vid="PSA 107:12">istti daaburiin</para>
  <para style="q2" vid="PSA 107:12">istta maaddizay dhaydes.<verse eid="PSA 107:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13" />Istti metotida wode</para>
  <para style="q2" vid="PSA 107:13">GODAAKKO waassida;</para>
  <para style="q2" vid="PSA 107:13">izikka istta waayezappe</para>
  <para style="q2" vid="PSA 107:13">ashshides.<verse eid="PSA 107:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14" />Sakkanna dhumappe istta kessides;</para>
  <para style="q2" vid="PSA 107:14">istti qashettida sansalatakka</para>
  <para style="q2" vid="PSA 107:14">duusereththides.<verse eid="PSA 107:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15" />Mernaa iza siiqozassinne</para>
  <para style="q2" vid="PSA 107:15">izi asas ooththida</para>
  <para style="q2" vid="PSA 107:15">malalisiza miishshatas</para>
  <para style="q2" vid="PSA 107:15">istti GODAA galatetto.<verse eid="PSA 107:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16" />Ays giikko izi xarqimalappe oosettida</para>
  <para style="q2" vid="PSA 107:16">penge menththides;</para>
  <para style="q2" vid="PSA 107:16">birata kolatatakka</para>
  <para style="q2" vid="PSA 107:16">qanxxereththides.<note caller="+" style="f"><char style="fr" closed="false">107:16 </char><char style="ft" closed="false">Kolata gizayssa issi issi bagga Gamoththo qaalan golge woykko kolata geettes.</char></note><verse eid="PSA 107:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17" />Isttafe issoti issoti</para>
  <para style="q2" vid="PSA 107:17">ba makkallateththa gaason</para>
  <para style="q2" vid="PSA 107:17">eeya gidida;</para>
  <para style="q2" vid="PSA 107:17">ba nagara gaasonkka</para>
  <para style="q2" vid="PSA 107:17">meton gelida.<verse eid="PSA 107:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18" />Istta qoodhey kath ixxiin</para>
  <para style="q2" vid="PSA 107:18">hayqqana matida.<verse eid="PSA 107:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19" />Istti metotida wode</para>
  <para style="q2" vid="PSA 107:19">GODAAKKO waassida;</para>
  <para style="q2" vid="PSA 107:19">izikka istta waayezappe</para>
  <para style="q2" vid="PSA 107:19">ashshides.<verse eid="PSA 107:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20" />Izi ba qaala kiittidi</para>
  <para style="q2" vid="PSA 107:20">istta paththides;</para>
  <para style="q2" vid="PSA 107:20">duufo doonappeka</para>
  <para style="q2" vid="PSA 107:20">istta ashshides.<verse eid="PSA 107:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21" />Mernaa iza siiqozassinne</para>
  <para style="q2" vid="PSA 107:21">izi asaas ooththida malalisiza</para>
  <para style="q2" vid="PSA 107:21">miishshatas</para>
  <para style="q2" vid="PSA 107:21">istti GODAA galatetto.<verse eid="PSA 107:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22" />Istti izas</para>
  <para style="q2" vid="PSA 107:22">galata yarsho yarshetto;</para>
  <para style="q2" vid="PSA 107:22">qasseka ufayssa yeththan</para>
  <para style="q2" vid="PSA 107:22">izi ooththida ooso qonccisetto.<verse eid="PSA 107:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23" />Isttafe issoti issoti markaben</para>
  <para style="q2" vid="PSA 107:23">gita abba giddora bida;</para>
  <para style="q2" vid="PSA 107:23">he gita abba bolla</para>
  <para style="q2" vid="PSA 107:23">bantta ooso ooththida.<verse eid="PSA 107:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24" />Istti GODAA ooso be7ida;</para>
  <para style="q2" vid="PSA 107:24">izi ciimma garsan ooththida</para>
  <para style="q2" vid="PSA 107:24">malalisiza oosota xeellida.<verse eid="PSA 107:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25" />Izi azaziin</para>
  <para style="q2" vid="PSA 107:25">gote carkoy dendides;</para>
  <para style="q2" vid="PSA 107:25">histtiin abba dambalay</para>
  <para style="q2" vid="PSA 107:25">qaaxxides.<verse eid="PSA 107:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26" />Istti pude salo kezida;</para>
  <para style="q2" vid="PSA 107:26">simmidikka duge ciimman gelida;</para>
  <para style="q2" vid="PSA 107:26">istta gakkida metoppe</para>
  <para style="q2" vid="PSA 107:26">dendoyssan</para>
  <para style="q2" vid="PSA 107:26">istta wozinay taahides.<verse eid="PSA 107:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27" />Istti maththottida asa mala</para>
  <para style="q2" vid="PSA 107:27">yiicotidi gandigarda;</para>
  <para style="q2" vid="PSA 107:27">isttas akeekiza wozinaykka</para>
  <para style="q2" vid="PSA 107:27">dammides.<verse eid="PSA 107:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28" />Istti metotida wode</para>
  <para style="q2" vid="PSA 107:28">GODAAKKO waassida;</para>
  <para style="q2" vid="PSA 107:28">izikka istta waayezappe</para>
  <para style="q2" vid="PSA 107:28">ashshides.<verse eid="PSA 107:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29" />Izi gote carkoza</para>
  <para style="q2" vid="PSA 107:29">co7u histtides;</para>
  <para style="q2" vid="PSA 107:29">abba dambalakka sirphi histtides.<verse eid="PSA 107:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30" />Co7u gida gishshas</para>
  <para style="q2" vid="PSA 107:30">istti ufayettida;</para>
  <para style="q2" vid="PSA 107:30">istti amottiza wodeben</para>
  <para style="q2" vid="PSA 107:30">gaththides.<note caller="+" style="f"><char style="fr" closed="false">107:30 </char><char style="ft" closed="false">Wodebe gizayssi markaben abbara biza asati abbafe kezidi shempizasonne abban gelanaas naagizayti shempiza abba doonan diza katama.</char></note><verse eid="PSA 107:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31" />Mernaa iza siiqozassinne</para>
  <para style="q2" vid="PSA 107:31">izi asas ooththida malalisiza</para>
  <para style="q2" vid="PSA 107:31">miishshatas</para>
  <para style="q2" vid="PSA 107:31">istti GODAA galatetto.<verse eid="PSA 107:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32" />Istti iza dere duulatan</para>
  <para style="q2" vid="PSA 107:32">dhoqqu dhoqqu histtetto;</para>
  <para style="q2" vid="PSA 107:32">qasse cimata shiiqon</para>
  <para style="q2" vid="PSA 107:32">iza galatetto.<verse eid="PSA 107:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33" />Shaafata mulera melissides;</para>
  <para style="q2" vid="PSA 107:33">pulttoti pulttontta mala teqqides.<verse eid="PSA 107:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34" />Heen de7iza asaa</para>
  <para style="q2" vid="PSA 107:34">iitateththaa gaason</para>
  <para style="q2" vid="PSA 107:34">aradda biittayo aykko</para>
  <para style="q2" vid="PSA 107:34">dolisontta maxine</para>
  <para style="q2" vid="PSA 107:34">biitta ooththides.<verse eid="PSA 107:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35" />Izi bazzon haath eelissides</para>
  <para style="q2" vid="PSA 107:35">mela biittan pulttoy</para>
  <para style="q2" vid="PSA 107:35">dhuuqqana mala ooththides.<verse eid="PSA 107:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36" />Gafidayta heen woththides;</para>
  <para style="q2" vid="PSA 107:36">isttika banttas</para>
  <para style="q2" vid="PSA 107:36">de7ana katama keexxida.<verse eid="PSA 107:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37" />Istti bantta goshshan zerida;</para>
  <para style="q2" vid="PSA 107:37">woyne tokkida;</para>
  <para style="q2" vid="PSA 107:37">daro kath shiishshida.<verse eid="PSA 107:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38" />Izi istta anjjiin</para>
  <para style="q2" vid="PSA 107:38">istti keehi corattida;</para>
  <para style="q2" vid="PSA 107:38">istta mehetakka guuththibeenna.<verse eid="PSA 107:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39" />Meton, waayeninne</para>
  <para style="q2" vid="PSA 107:39">ceecen xoonettiin</para>
  <para style="q2" vid="PSA 107:39">istta qooday guuxxides.<verse eid="PSA 107:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40" />GODAY halaqata kawushshides;</para>
  <para style="q2" vid="PSA 107:40">ogey baynda bazzon</para>
  <para style="q2" vid="PSA 107:40">toylattana mala</para>
  <para style="q2" vid="PSA 107:40">istta ooththees.<verse eid="PSA 107:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41" />Gido attiin izi metotanchchata</para>
  <para style="q2" vid="PSA 107:41">istta waayeppe kessides;</para>
  <para style="q2" vid="PSA 107:41">dorsa wude mala cora naytakka</para>
  <para style="q2" vid="PSA 107:41">isttas immides.<verse eid="PSA 107:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42" />Suure asati</para>
  <para style="q2" vid="PSA 107:42">hessa be7idi ufayetteettes;</para>
  <para style="q2" vid="PSA 107:42">gido attiin geellata</para>
  <para style="q2" vid="PSA 107:42">doonay gordettana.<verse eid="PSA 107:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43" />Era asi ha yo7oza</para>
  <para style="q2" vid="PSA 107:43">ba wozinan woththo;</para>
  <para style="q2" vid="PSA 107:43">izikka GODAA maaroteth akeeko.<verse eid="PSA 107:43" /></para>
  <chapter eid="PSA 107" />
  <chapter number="108" style="c" sid="PSA 108" />
  <para style="s1">Dawiti Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 108:1">Ta wozinay mino;</para>
  <para style="q2" vid="PSA 108:1">tani nees kumeththa</para>
  <para style="q2" vid="PSA 108:1">wozinappe yexxananne</para>
  <para style="q2" vid="PSA 108:1">nena sabbana.<verse eid="PSA 108:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2" />Ta diiththinne maasinqoy dendite!</para>
  <para style="q2" vid="PSA 108:2">tanikka maalado</para>
  <para style="q2" vid="PSA 108:2">wonttara dendana.<verse eid="PSA 108:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 108:3">Tani deraa giddon nena galatana;</para>
  <para style="q2" vid="PSA 108:3">qasse kawoteththata giddon</para>
  <para style="q2" vid="PSA 108:3">nees saban yexxana.<verse eid="PSA 108:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4" />Ne siiqoy gita;</para>
  <para style="q2" vid="PSA 108:4">salotappeka aadhdhees.</para>
  <para style="q2" vid="PSA 108:4">Ne ammaneteththayka</para>
  <para style="q2" vid="PSA 108:4">pude salo gakkees.<verse eid="PSA 108:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 108:5">Salotappe bollara</para>
  <para style="q2" vid="PSA 108:5">dhoqqu dhoqqu ga!</para>
  <para style="q2" vid="PSA 108:5">Ne bonchchoy biitta ubbaa gakko.<verse eid="PSA 108:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6" />Neni siiqizayti attana mala</para>
  <para style="q2" vid="PSA 108:6">ne ushachcha qesen nuna ashsha;</para>
  <para style="q2" vid="PSA 108:6">ta woosa siya.<verse eid="PSA 108:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7" />Xoossi ba geeshshasohon dishe,</para>
  <para style="q2" vid="PSA 108:7">«Tani xoonada</para>
  <para style="q2" vid="PSA 108:7">Seekeeme biitta shaakkana;</para>
  <para style="q2" vid="PSA 108:7">qasse Sukoote Zullaa gishana.<verse eid="PSA 108:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8" />Gala7aadey tayssa;</para>
  <para style="q2" vid="PSA 108:8">Minaaseykka tayssa;</para>
  <para style="q2" vid="PSA 108:8">Efreemey ta hu7en</para>
  <para style="q2" vid="PSA 108:8">woththiza birata qoobe;</para>
  <para style="q2" vid="PSA 108:8">Yuhuday ta kawoteththa guufe.<verse eid="PSA 108:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9" />Mo7aabey taas meechchaso;</para>
  <para style="q2" vid="PSA 108:9">Eedoomey tayssa</para>
  <para style="q2" vid="PSA 108:9">gididayssa erisanaas</para>
  <para style="q2" vid="PSA 108:9">tani ta caamma</para>
  <para style="q2" vid="PSA 108:9">iza bolla woththays;</para>
  <para style="q2" vid="PSA 108:9">tani Filisxeeme xoonada</para>
  <para style="q2" vid="PSA 108:9">gererays» gides.<verse eid="PSA 108:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10" />Gimbettida katamaakko</para>
  <para style="q2" vid="PSA 108:10">tana oonee efanay?</para>
  <para style="q2" vid="PSA 108:10">Eedoome gakkanaas</para>
  <para style="q2" vid="PSA 108:10">tana oonee kaaleththanay?<verse eid="PSA 108:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 108:11">Nuna aggiday nena gidikkii?</para>
  <para style="q2" vid="PSA 108:11">Neni nu olanchchatara</para>
  <para style="q2" vid="PSA 108:11">kezikke gadasa.<verse eid="PSA 108:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12" />Asa maadoy hada;</para>
  <para style="q2" vid="PSA 108:12">hessa gishshas nu morkketa bolla</para>
  <para style="q2" vid="PSA 108:12">nuus xoono imma.<verse eid="PSA 108:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13" />Xoossi nunara gidikko</para>
  <para style="q2" vid="PSA 108:13">nuni morkketa xoonana;</para>
  <para style="q2" vid="PSA 108:13">izi nu morkketa</para>
  <para style="q2" vid="PSA 108:13">ba tohon yedhdhana.<verse eid="PSA 108:13" /></para>
  <chapter eid="PSA 108" />
  <chapter number="109" style="c" sid="PSA 109" />
  <para style="s1">Dawiti Zammareta Kaabbos Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1" />Abeet tani galatiza Xoossawu!</para>
  <para style="q2" vid="PSA 109:1">Neni taas co7u gooppa.<verse eid="PSA 109:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2" />Iitatinne wordanchchati ba doona</para>
  <para style="q2" vid="PSA 109:2">ta bolla doyda;</para>
  <para style="q2" vid="PSA 109:2">ta bollaka wordo haasayda.<verse eid="PSA 109:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3" />Istti ixo qaalara tana giddoththida;</para>
  <para style="q2" vid="PSA 109:3">gaasoykka baynda</para>
  <para style="q2" vid="PSA 109:3">tana keehi qohida.<verse eid="PSA 109:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4" />Tani istta siiqishin</para>
  <para style="q2" vid="PSA 109:4">istti tana mootida;</para>
  <para style="q2" vid="PSA 109:4">gido attiin ta woossays.<verse eid="PSA 109:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5" />Tani lo7o ooththiin</para>
  <para style="q2" vid="PSA 109:5">taas iita zaarida;</para>
  <para style="q2" vid="PSA 109:5">ta istta siiqiin tana ixxida.<verse eid="PSA 109:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6" />Iza bolla iita daanna shuuma;</para>
  <para style="q2" vid="PSA 109:6">iza mootizaykka</para>
  <para style="q2" vid="PSA 109:6">iza ushachchan eqqo.<verse eid="PSA 109:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7" />Pirdason izi mooranchcha</para>
  <para style="q2" vid="PSA 109:7">gidi beetto;</para>
  <para style="q2" vid="PSA 109:7">iza woosaykka</para>
  <para style="q2" vid="PSA 109:7">izas simmidi gometo!<verse eid="PSA 109:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8" />Iza layththi qaammo;</para>
  <para style="q2" vid="PSA 109:8">iza shuumeteththaaka haray ekko!<note caller="-" style="x"><char style="xo" closed="false">109:8 </char><char style="xt" closed="false"><ref loc="ACT 1:20">Hawa 1:20</ref></char></note><verse eid="PSA 109:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9" />Iza nayti aawa dhaydi yi7otetto;</para>
  <para style="q2" vid="PSA 109:9">iza machcheyakka am7o gidu!<verse eid="PSA 109:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10" />Iza nayti yuuyi yuuyidi woossetto;</para>
  <para style="q2" vid="PSA 109:10">ha7i ba diza laalettida</para>
  <para style="q2" vid="PSA 109:10">keeththafekka goodettetto!<verse eid="PSA 109:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11" />Iza aqota ubbaa aco aaway laatto;</para>
  <para style="q2" vid="PSA 109:11">izi daaburdi kessida ubbaa</para>
  <para style="q2" vid="PSA 109:11">allagay bonqqo!<verse eid="PSA 109:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12" />Oonikka iza maaroppo;</para>
  <para style="q2" vid="PSA 109:12">woykko yi7o gidida naytas</para>
  <para style="q2" vid="PSA 109:12">qadhettizay dooppo!<verse eid="PSA 109:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13" />Iza nayti ubbay dhayetto;</para>
  <para style="q2" vid="PSA 109:13">kaalliza yeletan</para>
  <para style="q2" vid="PSA 109:13">iza sunththi dogetto.<verse eid="PSA 109:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14" />Iza aawata nagaray</para>
  <para style="q2" vid="PSA 109:14">GODAA sinththan qofetto;</para>
  <para style="q2" vid="PSA 109:14">iza aayey nagaray</para>
  <para style="q2" vid="PSA 109:14">mulekka qucettofo!<verse eid="PSA 109:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15" />Istta nagaray</para>
  <para style="q2" vid="PSA 109:15">GODAA sinththan ubbato beetto;</para>
  <para style="q2" vid="PSA 109:15">istta akeekissiza miishshi</para>
  <para style="q2" vid="PSA 109:15">biitta bolla dooppo.<verse eid="PSA 109:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16" />Gaasoykka izi manqidaade,</para>
  <para style="q2" vid="PSA 109:16">metotizaadenne</para>
  <para style="q2" vid="PSA 109:16">wozinay madunxidaade</para>
  <para style="q2" vid="PSA 109:16">hayqqana gakkanaas</para>
  <para style="q2" vid="PSA 109:16">gooddides attiin</para>
  <para style="q2" vid="PSA 109:16">iza maaranaas qoppibeenna.<verse eid="PSA 109:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17" />Izi qangganaas dosiza gishshas</para>
  <para style="q2" vid="PSA 109:17">izi qanggetto!</para>
  <para style="q2" vid="PSA 109:17">Izi anjjanaas dosontta gishshas</para>
  <para style="q2" vid="PSA 109:17">izappe haakkides!<verse eid="PSA 109:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18" />Qanggeth may7o mala may7ides;</para>
  <para style="q2" vid="PSA 109:18">haaththa mala izas bollan gelides;</para>
  <para style="q2" vid="PSA 109:18">zayte malakka</para>
  <para style="q2" vid="PSA 109:18">meqeththa giddo gelides.<verse eid="PSA 109:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19" />Afala mala iza kammo;</para>
  <para style="q2" vid="PSA 109:19">saqqe mala ubba wode</para>
  <para style="q2" vid="PSA 109:19">iza xeessan de7o!<verse eid="PSA 109:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20" />Hayssi tana mootizaytassinne</para>
  <para style="q2" vid="PSA 109:20">ta bolla iita haasayzaytas</para>
  <para style="q2" vid="PSA 109:20">GODAY immiza woyto gido!<verse eid="PSA 109:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21" />Gido attiin abeet</para>
  <para style="q2" vid="PSA 109:21">Ubbaafe Dhoqqa GODAWU!</para>
  <para style="q2" vid="PSA 109:21">ne sunththa gishshas</para>
  <para style="q2" vid="PSA 109:21">tana lo7o ayfen xeella;</para>
  <para style="q2" vid="PSA 109:21">ne siiqoy lo7o gidida gishshas</para>
  <para style="q2" vid="PSA 109:21">tana ashsha.<verse eid="PSA 109:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22" />Tani hiyeesanne metotanchcha asa;</para>
  <para style="q2" vid="PSA 109:22">ta wozinay madunxides.<verse eid="PSA 109:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23" />Tani omarsa wode kuwa mala</para>
  <para style="q2" vid="PSA 109:23">dhayana hanays;</para>
  <para style="q2" vid="PSA 109:23">boole malakka qoqofettadis.<verse eid="PSA 109:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24" />Xoomishin ta gulbatey daaburdes;</para>
  <para style="q2" vid="PSA 109:24">ta ashoy gilqidi</para>
  <para style="q2" vid="PSA 109:24">meqeth attides.<verse eid="PSA 109:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25" />Ta morkketas tani</para>
  <para style="q2" vid="PSA 109:25">qilcciza miish gidadis;</para>
  <para style="q2" vid="PSA 109:25">istti tana be7idi</para>
  <para style="q2" vid="PSA 109:25">ba qoodhe qaaththeettes.<note caller="-" style="x"><char style="xo" closed="false">109:25 </char><char style="xt" closed="false"><ref loc="MAT 27:39">Mato 27:39</ref>; <ref loc="MRK 15:29">Mar 15:29</ref></char></note><verse eid="PSA 109:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26" />Abeet GODAWU ta Xoossawu!</para>
  <para style="q2" vid="PSA 109:26">Tana maadda;</para>
  <para style="q2" vid="PSA 109:26">ne mernaa siiqo mala</para>
  <para style="q2" vid="PSA 109:26">tana ashsha.<verse eid="PSA 109:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 109:27">Hayssa ne kushey ooththidayssanne</para>
  <para style="q2" vid="PSA 109:27">neni polidayssa</para>
  <para style="q2" vid="PSA 109:27">ta morkketi eretto.<verse eid="PSA 109:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28" />Istti tana qanggeettes;</para>
  <para style="q2" vid="PSA 109:28">neni gidikko tana anjjaasa;</para>
  <para style="q2" vid="PSA 109:28">ta bolla dendizayti yeellatana;</para>
  <para style="q2" vid="PSA 109:28">gido attiin tani</para>
  <para style="q2" vid="PSA 109:28">ne aylley ufayettana.<verse eid="PSA 109:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29" />Tana mootizayti</para>
  <para style="q2" vid="PSA 109:29">kawushshateth may7etto;</para>
  <para style="q2" vid="PSA 109:29">bantta yeellaaka</para>
  <para style="q2" vid="PSA 109:29">kuta mala quma7etto.<verse eid="PSA 109:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30" />Tani ta inxarsan</para>
  <para style="q2" vid="PSA 109:30">GODAA keeha galatana;</para>
  <para style="q2" vid="PSA 109:30">daro derey shiiqida duulatan</para>
  <para style="q2" vid="PSA 109:30">iza sabbana.<verse eid="PSA 109:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31" />Gaasoykka istta bolla hayqo pirda</para>
  <para style="q2" vid="PSA 109:31">pirdizaytappe ashshanaas</para>
  <para style="q2" vid="PSA 109:31">manqotappe ushachcha baggara</para>
  <para style="q2" vid="PSA 109:31">izi eqqees.<verse eid="PSA 109:31" /></para>
  <chapter eid="PSA 109" />
  <chapter number="110" style="c" sid="PSA 110" />
  <para style="s1">Dawite Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1" />GODAY ta Godaas,</para>
  <para style="q2" vid="PSA 110:1">«Tani ne morkketa ne toho</para>
  <para style="q2" vid="PSA 110:1">garsan yedhisana gakkanaas,</para>
  <para style="q2" vid="PSA 110:1">ta ushachchan utta» gides.<note caller="-" style="x"><char style="xo" closed="false">110:1 </char><char style="xt" closed="false"><ref loc="MAT 22:44">Mato 22:44</ref>; <ref loc="MRK 12:36">Mar 12:36</ref>; <ref loc="LUK 20:42-43">Luqa 20:42-43</ref>; <ref loc="ACT 2:34-35">Hawa 2:34-35</ref>; <ref loc="1CO 15:25">1Qoro 15:25</ref>; <ref loc="EPH 1:20-22">Efe 1:20-22</ref>; <ref loc="COL 3:1">Qola 3:1</ref>; <ref loc="HEB 1:13">Ib 1:13</ref>; <ref loc="HEB 8:1">8:1</ref>; <ref loc="HEB 10:12-13">10:12-13</ref></char></note><verse eid="PSA 110:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2" />GODAY nees maata guufe</para>
  <para style="q2" vid="PSA 110:2">Xiyooneppe kiittana;</para>
  <para style="q2" vid="PSA 110:2">nenikka morkketa haarana.<verse eid="PSA 110:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3" />Neni ne morkketara olettiza gallas</para>
  <para style="q2" vid="PSA 110:3">ne olanchchati ba shenen</para>
  <para style="q2" vid="PSA 110:3">ne millen eqqana;</para>
  <para style="q2" vid="PSA 110:3">wontta maalado awa mala</para>
  <para style="q2" vid="PSA 110:3">geeshshateththan phoollashe</para>
  <para style="q2" vid="PSA 110:3">ne naateteththa asay neekko yaana.<verse eid="PSA 110:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4" />GODAY, «Malkexeedeqe</para>
  <para style="q2" vid="PSA 110:4">qeeseteththa mala</para>
  <para style="q2" vid="PSA 110:4">nenikka mernaas qeese gidana»</para>
  <para style="q2" vid="PSA 110:4">giidi caaqqides;</para>
  <para style="q2" vid="PSA 110:4">izi ba qofa laammenna.<note caller="-" style="x"><char style="xo" closed="false">110:4 </char><char style="xt" closed="false"><ref loc="HEB 5:6">Ib 5:6</ref>; <ref loc="HEB 6:20">6:20</ref>; <ref loc="HEB 7:17">7:17</ref>,<ref loc="HEB 7:21">21</ref></char></note><verse eid="PSA 110:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5" />GODAY ne ushachchan dees;</para>
  <para style="q2" vid="PSA 110:5">izi ba hanqo gallas</para>
  <para style="q2" vid="PSA 110:5">kawota tinchchereththana.<verse eid="PSA 110:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6" />Kawoteththata bolla izi pirdana;</para>
  <para style="q2" vid="PSA 110:6">ola wosanatakka</para>
  <para style="q2" vid="PSA 110:6">aha xalla histtana;</para>
  <para style="q2" vid="PSA 110:6">sa7an ubbaan diza kawota</para>
  <para style="q2" vid="PSA 110:6">izi menththereththana.<verse eid="PSA 110:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7" />Kawozi oge lanqen diza</para>
  <para style="q2" vid="PSA 110:7">haaththa pulttofe uyidi,</para>
  <para style="q2" vid="PSA 110:7">izi ba hu7e dhoqqu dhoqqu histtana.<verse eid="PSA 110:7" /></para>
  <chapter eid="PSA 110" />
  <chapter number="111" style="c" sid="PSA 111" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1" />GODAA galatite!</para>
  <para style="q2" vid="PSA 111:1">Suureta shiiqoninne</para>
  <para style="q2" vid="PSA 111:1">dere duulatan</para>
  <para style="q2" vid="PSA 111:1">tani kumeththa wozinappe</para>
  <para style="q2" vid="PSA 111:1">GODAA galatana.<verse eid="PSA 111:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2" />GODAA oosoti ay keena gitaa!</para>
  <para style="q2" vid="PSA 111:2">Isttan ufayettizayti ubbay</para>
  <para style="q2" vid="PSA 111:2">istti yuushshi qoppanaas bessees.<verse eid="PSA 111:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3" />Iza oosoti bonchchoninne</para>
  <para style="q2" vid="PSA 111:3">teeman kumidayta;</para>
  <para style="q2" vid="PSA 111:3">iza xilloteththika mernaas dees.<verse eid="PSA 111:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4" />Izi ba malalisiza oosota</para>
  <para style="q2" vid="PSA 111:4">hassa7ettana mala ooththides.</para>
  <para style="q2" vid="PSA 111:4">Izi kiyanne maariza GODAA.<verse eid="PSA 111:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5" />Baas yayyizaytas kath immees;</para>
  <para style="q2" vid="PSA 111:5">ba caaqo qaalaakka</para>
  <para style="q2" vid="PSA 111:5">mernaas qoppees.<verse eid="PSA 111:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6" />Allagata biitta ba deraas immidi</para>
  <para style="q2" vid="PSA 111:6">ba mino oosoza</para>
  <para style="q2" vid="PSA 111:6">ba kawoteththaa bessides.<verse eid="PSA 111:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7" />Iza oosoti tumanne suure;</para>
  <para style="q2" vid="PSA 111:7">iza wogatikka</para>
  <para style="q2" vid="PSA 111:7">ubbay ammanettizayta.<verse eid="PSA 111:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8" />Istti mernaas eqqi de7izayta;</para>
  <para style="q2" vid="PSA 111:8">tumateththaninne</para>
  <para style="q2" vid="PSA 111:8">suureteththan imettida.<verse eid="PSA 111:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9" />Izi ba asaas atoteth immides;</para>
  <para style="q2" vid="PSA 111:9">ba caaqo qaalakka</para>
  <para style="q2" vid="PSA 111:9">isttas mernaas azazides;</para>
  <para style="q2" vid="PSA 111:9">iza sunththi geeshshinne yashissizaaza.<verse eid="PSA 111:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10" />Aadho erateththas koyroy</para>
  <para style="q2" vid="PSA 111:10">GODAAS yashshateththa;</para>
  <para style="q2" vid="PSA 111:10">iza azazo ooththizaytas</para>
  <para style="q2" vid="PSA 111:10">lo7o akeekay dees.</para>
  <para style="q2" vid="PSA 111:10">GODAY mernaas galatetto!<note caller="-" style="x"><char style="xo" closed="false">111:10 </char><char style="xt" closed="false"><ref loc="JOB 28:28">Iyo 28:28</ref>; <ref loc="PRO 1:7">Leemi 1:7</ref>; <ref loc="PRO 9:10">9:10</ref></char></note><verse eid="PSA 111:10" /></para>
  <chapter eid="PSA 111" />
  <chapter number="112" style="c" sid="PSA 112" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1" />GODAY galatetto!</para>
  <para style="q2" vid="PSA 112:1">GODAAS yayyiza asi,</para>
  <para style="q2" vid="PSA 112:1">iza azazotakka polanaas</para>
  <para style="q2" vid="PSA 112:1">ufayettiza asi anjjettidayssa.<verse eid="PSA 112:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2" />Iza nayti biittan wolqqama gidana;</para>
  <para style="q2" vid="PSA 112:2">suure asata yeletay anjjettana.<verse eid="PSA 112:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3" />Aqotaynne dureteththi</para>
  <para style="q2" vid="PSA 112:3">iza keeththan dees;</para>
  <para style="q2" vid="PSA 112:3">iza xilloteththayka</para>
  <para style="q2" vid="PSA 112:3">mernaas de7ana.<verse eid="PSA 112:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4" />Kiya, qadhettizanne xillo ooththiza</para>
  <para style="q2" vid="PSA 112:4">suure asas dhuma giddon</para>
  <para style="q2" vid="PSA 112:4">poo7oy poo7ees.<verse eid="PSA 112:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5" />Kiyateththan coo tal7iza asas,</para>
  <para style="q2" vid="PSA 112:5">ba ooso suureteththan ooththiza</para>
  <para style="q2" vid="PSA 112:5">asas de7oy injjetana.<verse eid="PSA 112:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6" />Xillo asi awudenne kundenna;</para>
  <para style="q2" vid="PSA 112:6">mernaas izi hassa7ettishe de7ana.<verse eid="PSA 112:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7" />Iita miishshi iza daganththenna;</para>
  <para style="q2" vid="PSA 112:7">ays giikko iza wozinay hirgenna;</para>
  <para style="q2" vid="PSA 112:7">GODAAN ammaneettes.<verse eid="PSA 112:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8" />Iza wozinay mino;</para>
  <para style="q2" vid="PSA 112:8">mulekka yayyenna;</para>
  <para style="q2" vid="PSA 112:8">wurseththan ba morkketa</para>
  <para style="q2" vid="PSA 112:8">kundeth izi be7ana.<verse eid="PSA 112:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9" />Izi hiyeesatas kiyateththan immees;</para>
  <para style="q2" vid="PSA 112:9">qasse iza xilloteththay</para>
  <para style="q2" vid="PSA 112:9">mernaas dees;</para>
  <para style="q2" vid="PSA 112:9">iza kacey bonchchon</para>
  <para style="q2" vid="PSA 112:9">dhoqqu dhoqqu gaana.<note caller="-" style="x"><char style="xo" closed="false">112:9 </char><char style="xt" closed="false"><ref loc="2CO 9:9">2Qoro 9:9</ref></char></note><verse eid="PSA 112:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10" />Iita asi hessa be7idi yiillotees;</para>
  <para style="q2" vid="PSA 112:10">ba achchaa garccishe</para>
  <para style="q2" vid="PSA 112:10">coo gilqi dhayees;</para>
  <para style="q2" vid="PSA 112:10">iitata amoy hada gidana.<verse eid="PSA 112:10" /></para>
  <chapter eid="PSA 112" />
  <chapter number="113" style="c" sid="PSA 113" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1" />GODAY galatetto!</para>
  <para style="q2" vid="PSA 113:1">Intteno GODAA oosanchchatoo!</para>
  <para style="q2" vid="PSA 113:1">GODAA galatite!</para>
  <para style="q2" vid="PSA 113:1">Iza sunththaaka sabbite!<verse eid="PSA 113:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2" />GODAA sunththi hachchife</para>
  <para style="q2" vid="PSA 113:2">mernaa gakkanaas galatetto!<verse eid="PSA 113:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3" />Arshey mokkizasoppe biidi</para>
  <para style="q2" vid="PSA 113:3">wullizaso gakkanaaska</para>
  <para style="q2" vid="PSA 113:3">GODAA sunththi galatetto!<verse eid="PSA 113:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4" />GODAY kawoteththata ubbaafe gita;</para>
  <para style="q2" vid="PSA 113:4">iza bonchchoyka</para>
  <para style="q2" vid="PSA 113:4">salotappe dhoqqa.<verse eid="PSA 113:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5" />GODAA nu Xoossa malay oonee?</para>
  <para style="q2" vid="PSA 113:5">Izi bolla dhoqqan</para>
  <para style="q2" vid="PSA 113:5">kawoteththa araatan uttides.<verse eid="PSA 113:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6" />Izi salotaninne</para>
  <para style="q2" vid="PSA 113:6">sa7an dizayta</para>
  <para style="q2" vid="PSA 113:6">duge xeellees.<verse eid="PSA 113:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7" />Izi hiyeesa gudullafe</para>
  <para style="q2" vid="PSA 113:7">dhoqqu dhoqqu histtees;</para>
  <para style="q2" vid="PSA 113:7">metotanchchaka</para>
  <para style="q2" vid="PSA 113:7">bidinththafe denththees.<verse eid="PSA 113:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8" />Histtidi istta gita asataranne</para>
  <para style="q2" vid="PSA 113:8">dere shuumetara issife utisees;<verse eid="PSA 113:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9" />Mayneyo nayta aayo ooththees;</para>
  <para style="q2" vid="PSA 113:9">bonchchidikka izison</para>
  <para style="q2" vid="PSA 113:9">izo ufayssan woththees;</para>
  <para style="b" vid="PSA 113:9" />
  <para style="q2" vid="PSA 113:9">GODAY galatetto!<verse eid="PSA 113:9" /></para>
  <chapter eid="PSA 113" />
  <chapter number="114" style="c" sid="PSA 114" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1" />Isra7eele asay</para>
  <para style="q2" vid="PSA 114:1">Gibxe biittafe kezida wode,</para>
  <para style="q2" vid="PSA 114:1">Yaaqoobe zereththay</para>
  <para style="q2" vid="PSA 114:1">allaga qaala haasayza biittafe</para>
  <para style="q2" vid="PSA 114:1">yeggidi bida wode,<note caller="-" style="x"><char style="xo" closed="false">114:1 </char><char style="xt" closed="false"><ref loc="EXO 12:51">Kessa 12:51</ref></char></note><verse eid="PSA 114:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2" />Yuhuda asay Xoossas</para>
  <para style="q2" vid="PSA 114:2">geeshsha as gidides;</para>
  <para style="q2" vid="PSA 114:2">Isra7eele asaykka</para>
  <para style="q2" vid="PSA 114:2">izas haarettides.<verse eid="PSA 114:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3" />Zo7o abbay hessa be7idi baqatides;</para>
  <para style="q2" vid="PSA 114:3">Yordaanoose shaafaykka</para>
  <para style="q2" vid="PSA 114:3">guye simmides.<note caller="-" style="x"><char style="xo" closed="false">114:3 </char><char style="xt" closed="false"><ref loc="EXO 14:21">Kessa 14:21</ref>; <ref loc="JOS 3:16">Iya 3:16</ref></char></note><verse eid="PSA 114:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4" />Zumati dharsho mala guferettida;</para>
  <para style="q2" vid="PSA 114:4">zumbullatikka</para>
  <para style="q2" vid="PSA 114:4">dorsa laaqqa mala xikkida.<verse eid="PSA 114:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5" />Abbazoo! Ne ays baqatadii?</para>
  <para style="q2" vid="PSA 114:5">Yordaanoose shaafazoo!</para>
  <para style="q2" vid="PSA 114:5">Ays guye simmadii?<verse eid="PSA 114:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6" />Intteno zumatoo!</para>
  <para style="q2" vid="PSA 114:6">Dharsho mala ays guppidetii?</para>
  <para style="q2" vid="PSA 114:6">Intteno zumbullatoo!</para>
  <para style="q2" vid="PSA 114:6">Dorsa laaqqa mala ays xikkidetii?<verse eid="PSA 114:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7" />Hanne biittayee! Godaa sinththan</para>
  <para style="q2" vid="PSA 114:7">Yaaqoobe Xoossa</para>
  <para style="q2" vid="PSA 114:7">sinththan kokkora.<verse eid="PSA 114:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8" />Izi zaalla eele haath kessides;</para>
  <para style="q2" vid="PSA 114:8">wolqqama zaalla pultto haath kessides.<note caller="-" style="x"><char style="xo" closed="false">114:8 </char><char style="xt" closed="false"><ref loc="EXO 17:1-7">Kessa 17:1-7</ref>; <ref loc="NUM 20:2-13">Tay 20:2-13</ref></char></note><verse eid="PSA 114:8" /></para>
  <chapter eid="PSA 114" />
  <chapter number="115" style="c" sid="PSA 115" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 115:1">Nu gishshas gidontta</para>
  <para style="q2" vid="PSA 115:1">ne siiqo gishshassinne</para>
  <para style="q2" vid="PSA 115:1">ne ammaneteththa gishshas</para>
  <para style="q2" vid="PSA 115:1">ne sunththaa bonchcha.<verse eid="PSA 115:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2" />Kawoteththati ays,</para>
  <para style="q2" vid="PSA 115:2">«Istta Xoossi awan dizee?» gizoo?<verse eid="PSA 115:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3" />Nu Xoossay salon dees;</para>
  <para style="q2" vid="PSA 115:3">izi ba dosidayssa ubbaa ooththees.<verse eid="PSA 115:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4" />Gido attiin istta eeqa xoossati</para>
  <para style="q2" vid="PSA 115:4">birappenne worqqafe</para>
  <para style="q2" vid="PSA 115:4">asa kushen oosettidayta.<verse eid="PSA 115:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5" />Isttas doonay dees shin</para>
  <para style="q2" vid="PSA 115:5">haasayettenna;</para>
  <para style="q2" vid="PSA 115:5">ayfeykka dees shin demmettenna.<verse eid="PSA 115:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6" />Isttas hayththi dees shin siyettenna;</para>
  <para style="q2" vid="PSA 115:6">siidheykka dees shin singettenna.<verse eid="PSA 115:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7" />Isttas kushey dees shin</para>
  <para style="q2" vid="PSA 115:7">bochchettenna;</para>
  <para style="q2" vid="PSA 115:7">tohoykka dees shin</para>
  <para style="q2" vid="PSA 115:7">hemettettenna;</para>
  <para style="q2" vid="PSA 115:7">istta poorandey</para>
  <para style="q2" vid="PSA 115:7">cenggurs kessenna.<verse eid="PSA 115:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8" />Istta medhdhizaytinne</para>
  <para style="q2" vid="PSA 115:8">isttan ammanettizayti</para>
  <para style="q2" vid="PSA 115:8">ubbay istta mala gidetto.<note caller="-" style="x"><char style="xo" closed="false">115:4-8 </char><char style="xt" closed="false"><ref loc="PSA 135:15-18">Maza 135:15-18</ref>; <ref loc="REV 9:20">Ajju 9:20</ref></char></note><verse eid="PSA 115:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9" />Intteno Isra7eele asatoo!</para>
  <para style="q2" vid="PSA 115:9">GODAAN ammanettite!</para>
  <para style="q2" vid="PSA 115:9">Izi inttes gondallenne</para>
  <para style="q2" vid="PSA 115:9">inttena maaddizaade.<verse eid="PSA 115:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10" />Intteno Aaroone zereththatoo!</para>
  <para style="q2" vid="PSA 115:10">GODAAN ammanettite!</para>
  <para style="q2" vid="PSA 115:10">Izi inttes gondallenne</para>
  <para style="q2" vid="PSA 115:10">inttena maaddizaade.<verse eid="PSA 115:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11" />Intteno GODAAS yayyizaytoo!</para>
  <para style="q2" vid="PSA 115:11">GODAAN ammanettite!</para>
  <para style="q2" vid="PSA 115:11">Izi inttes gondallenne</para>
  <para style="q2" vid="PSA 115:11">inttena maaddizaade.<verse eid="PSA 115:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12" />GODAY nuus qoppees;</para>
  <para style="q2" vid="PSA 115:12">izi nuna anjjana;</para>
  <para style="q2" vid="PSA 115:12">izi Isra7eele asatanne</para>
  <para style="q2" vid="PSA 115:12">Aaroone zereththatakka anjjana.<verse eid="PSA 115:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13" />GODAAS yayyizayta ubbaa</para>
  <para style="q2" vid="PSA 115:13">guuth gidiin gita izi anjjana.<note caller="-" style="x"><char style="xo" closed="false">115:13 </char><char style="xt" closed="false"><ref loc="REV 11:18">Ajju 11:18</ref>; <ref loc="REV 19:5">19:5</ref></char></note><verse eid="PSA 115:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14" />GODAY inttenakka</para>
  <para style="q2" vid="PSA 115:14">intte naytakka darso!<verse eid="PSA 115:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15" />Salonne sa7a medhdhida</para>
  <para style="q2" vid="PSA 115:15">GODAY inttena anjjo!<verse eid="PSA 115:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16" />Saloti Xoossassa;</para>
  <para style="q2" vid="PSA 115:16">gido attiin sa7a</para>
  <para style="q2" vid="PSA 115:16">asa naytas immides.<verse eid="PSA 115:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17" />Hayqqidi duge duufon gelidayti</para>
  <para style="q2" vid="PSA 115:17">GODAA galatanaas</para>
  <para style="q2" vid="PSA 115:17">dandayettenna.<verse eid="PSA 115:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18" />Gido attiin nuni</para>
  <para style="q2" vid="PSA 115:18">shemppora paxa dizayti</para>
  <para style="q2" vid="PSA 115:18">hachchife doommidi</para>
  <para style="q2" vid="PSA 115:18">mernaa gakkanaas</para>
  <para style="q2" vid="PSA 115:18">GODAA galatana.</para>
  <para style="b" vid="PSA 115:18" />
  <para style="q2" vid="PSA 115:18">GODAY galatetto!<verse eid="PSA 115:18" /></para>
  <chapter eid="PSA 115" />
  <chapter number="116" style="c" sid="PSA 116" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1" />Izi ta shoobba</para>
  <para style="q2" vid="PSA 116:1">woossiza woosa</para>
  <para style="q2" vid="PSA 116:1">siyida gishshas</para>
  <para style="q2" vid="PSA 116:1">tani GODAA dosays.<verse eid="PSA 116:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2" />Izi ba hayth</para>
  <para style="q2" vid="PSA 116:2">taakko yeggida gishshas</para>
  <para style="q2" vid="PSA 116:2">tani de7iza wode ubbaan</para>
  <para style="q2" vid="PSA 116:2">iza xeygana.<verse eid="PSA 116:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3" />Hayqoy woximade mala</para>
  <para style="q2" vid="PSA 116:3">tana dooddi oykkides;</para>
  <para style="q2" vid="PSA 116:3">duufon geloy tana hirgisides.</para>
  <para style="q2" vid="PSA 116:3">Ceeceynne un7oy</para>
  <para style="q2" vid="PSA 116:3">tana toli oykkides.<verse eid="PSA 116:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4" />He wode tani,</para>
  <para style="q2" vid="PSA 116:4">«Abeet GODAWU! Hadara!</para>
  <para style="q2" vid="PSA 116:4">Tana ashsha»</para>
  <para style="q2" vid="PSA 116:4">gaada GODAA sunth xeygadis.<verse eid="PSA 116:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5" />GODAY kiyanne xillo;</para>
  <para style="q2" vid="PSA 116:5">nu Xoossay maarizayssa.<verse eid="PSA 116:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6" />GODAY ashketa naagees;</para>
  <para style="q2" vid="PSA 116:6">tani metotida wode</para>
  <para style="q2" vid="PSA 116:6">izi tana ashshides.<verse eid="PSA 116:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7" />Ta shemppoyee ane woppu ga;</para>
  <para style="q2" vid="PSA 116:7">GODAY nees</para>
  <para style="q2" vid="PSA 116:7">lo7o miish ooththides.<verse eid="PSA 116:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8" />GODAY tana hayqoppe,</para>
  <para style="q2" vid="PSA 116:8">ta ayfe afunththafe,</para>
  <para style="q2" vid="PSA 116:8">ta tohokka</para>
  <para style="q2" vid="PSA 116:8">dhupheppe ashshides.<verse eid="PSA 116:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9" />Hessa gishshas</para>
  <para style="q2" vid="PSA 116:9">tani GODAA sinththan</para>
  <para style="q2" vid="PSA 116:9">shemppora paxa dizayta</para>
  <para style="q2" vid="PSA 116:9">giddon hemettays.<verse eid="PSA 116:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10" />Ta, «Tani keeha un7ettadis»</para>
  <para style="q2" vid="PSA 116:10">giza wodekka</para>
  <para style="q2" vid="PSA 116:10">ammano aggabeekke.<note caller="-" style="x"><char style="xo" closed="false">116:10 </char><char style="xt" closed="false"><ref loc="2CO 4:13">2Qoro 4:13</ref></char></note><verse eid="PSA 116:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11" />Taas gizaazi dhayiin,</para>
  <para style="q2" vid="PSA 116:11">«Asi ubbay wordo» gadis.<verse eid="PSA 116:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12" />Izi taas kiyida kiyateththaa gishshas</para>
  <para style="q2" vid="PSA 116:12">tani GODAAS</para>
  <para style="q2" vid="PSA 116:12">ay qanxxanaas dandayazinaa?<verse eid="PSA 116:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13" />GODAY tana ashshida gishshas</para>
  <para style="q2" vid="PSA 116:13">woyne ushshu galatas shiishshada</para>
  <para style="q2" vid="PSA 116:13">iza sunththu xeygana.<verse eid="PSA 116:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14" />Iza deraa ubbaa sinththan</para>
  <para style="q2" vid="PSA 116:14">tani adinida adina</para>
  <para style="q2" vid="PSA 116:14">GODAAS gaththana.<verse eid="PSA 116:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15" />Geeshshata hayqoy</para>
  <para style="q2" vid="PSA 116:15">GODAA sinththan bonchcho.<verse eid="PSA 116:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16" />Abeet GODAWU! Tani ne aylle;</para>
  <para style="q2" vid="PSA 116:16">tani ne aylley naa;</para>
  <para style="q2" vid="PSA 116:16">tana qashoppe birshadasa.<verse eid="PSA 116:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 116:17">Tani galata yarsho nees yarshana;</para>
  <para style="q2" vid="PSA 116:17">histtada ne sunththaa xeygana.<verse eid="PSA 116:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18" />Iza deraa ubbaa sinththan</para>
  <para style="q2" vid="PSA 116:18">tani adinettida adina</para>
  <para style="q2" vid="PSA 116:18">GODAAS gaththana.<verse eid="PSA 116:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19" />Hessaka tani gaththanay,</para>
  <para style="q2" vid="PSA 116:19">Yerusalaamen diza GODAA</para>
  <para style="q2" vid="PSA 116:19">keeththa dabaabanna.</para>
  <para style="b" vid="PSA 116:19" />
  <para style="q2" vid="PSA 116:19">GODAY galatetto!<verse eid="PSA 116:19" /></para>
  <chapter eid="PSA 116" />
  <chapter number="117" style="c" sid="PSA 117" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1" />Kawoteththati ubbay</para>
  <para style="q2" vid="PSA 117:1">GODAA galatite!</para>
  <para style="q2" vid="PSA 117:1">Ubba asay iza galatan sabbite!<note caller="-" style="x"><char style="xo" closed="false">117:1 </char><char style="xt" closed="false"><ref loc="ROM 15:11">Oro 15:11</ref></char></note><verse eid="PSA 117:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2" />Ays giikko izi ba gita siiqo</para>
  <para style="q2" vid="PSA 117:2">nuna bessides;</para>
  <para style="q2" vid="PSA 117:2">iza ammaneteththayka</para>
  <para style="q2" vid="PSA 117:2">mernaassa;</para>
  <para style="b" vid="PSA 117:2" />
  <para style="q2" vid="PSA 117:2">GODAY galatetto!<verse eid="PSA 117:2" /></para>
  <chapter eid="PSA 117" />
  <chapter number="118" style="c" sid="PSA 118" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1" />Izi kiyanne iza siiqoy</para>
  <para style="q2" vid="PSA 118:1">mernaas gidida gishshas</para>
  <para style="q2" vid="PSA 118:1">GODAA galatite!<note caller="-" style="x"><char style="xo" closed="false">118:1 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1Taari 16:34</ref>; <ref loc="2CH 5:13">2Taari 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Iz 3:11</ref>; <ref loc="PSA 100:5">Maza 100:5</ref>; <ref loc="PSA 106:1">106:1</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 136:1">136:1</ref>; <ref loc="JER 33:11">Er 33:11</ref></char></note><verse eid="PSA 118:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2" />Isra7eele asay,</para>
  <para style="q2" vid="PSA 118:2">«Iza siiqoy mernaassa» go.<verse eid="PSA 118:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3" />Aaroone zereththati,</para>
  <para style="q2" vid="PSA 118:3">«Iza siiqoy mernaassa» getto.<verse eid="PSA 118:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4" />GODAAS yayyizayti ubbay,</para>
  <para style="q2" vid="PSA 118:4">«Iza siiqoy mernaassa» getto.<verse eid="PSA 118:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5" />Tani un7ettida wode</para>
  <para style="q2" vid="PSA 118:5">GODAAKKO waassadis;</para>
  <para style="q2" vid="PSA 118:5">histtiin izi ta waasoza allidi</para>
  <para style="q2" vid="PSA 118:5">tana un7ofe kessides.<verse eid="PSA 118:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6" />GODAY tanara diza gishshas</para>
  <para style="q2" vid="PSA 118:6">tani yayyike.</para>
  <para style="q2" vid="PSA 118:6">Asi tana ay ooththanee?<note caller="-" style="x"><char style="xo" closed="false">118:6 </char><char style="xt" closed="false"><ref loc="HEB 13:6">Ib 13:6</ref></char></note><verse eid="PSA 118:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7" />GODAY tana maaddanaas</para>
  <para style="q2" vid="PSA 118:7">tanara dees;</para>
  <para style="q2" vid="PSA 118:7">ta morkketa xooneteththaa</para>
  <para style="q2" vid="PSA 118:7">tani ayfen be7ana.<verse eid="PSA 118:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8" />Asan ammaneteththafe</para>
  <para style="q2" vid="PSA 118:8">GODAAN ammaneteththay lo7o.<verse eid="PSA 118:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9" />Daannatan ammaneteththafe</para>
  <para style="q2" vid="PSA 118:9">GODAAN ammaneteththay lo7o.<verse eid="PSA 118:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10" />Kawoteththati ubbay</para>
  <para style="q2" vid="PSA 118:10">tana dooddida;</para>
  <para style="q2" vid="PSA 118:10">gido attiin GODAA sunththan</para>
  <para style="q2" vid="PSA 118:10">tani istta xoonadis.<verse eid="PSA 118:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11" />Istti tana ubbasora</para>
  <para style="q2" vid="PSA 118:11">dooddi oykkida;</para>
  <para style="q2" vid="PSA 118:11">gido attiin GODAA sunththan</para>
  <para style="q2" vid="PSA 118:11">tani istta xoonadis.<verse eid="PSA 118:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12" />Istti tana</para>
  <para style="q2" vid="PSA 118:12">maththi dooddiza mala dooddida;</para>
  <para style="q2" vid="PSA 118:12">gido attiin agunththi</para>
  <para style="q2" vid="PSA 118:12">eexxiza mala</para>
  <para style="q2" vid="PSA 118:12">eexxi dhayda;</para>
  <para style="q2" vid="PSA 118:12">GODAA sunththan</para>
  <para style="q2" vid="PSA 118:12">tani istta xoonadis.<verse eid="PSA 118:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13" />Tana sugiin kundanaas</para>
  <para style="q2" vid="PSA 118:13">gandigaradis;</para>
  <para style="q2" vid="PSA 118:13">gido attiin GODAY</para>
  <para style="q2" vid="PSA 118:13">tana maaddides.<verse eid="PSA 118:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14" />GODAY taas</para>
  <para style="q2" vid="PSA 118:14">minoteththinne yeththa;</para>
  <para style="q2" vid="PSA 118:14">tana ashshizay iza.<note caller="-" style="x"><char style="xo" closed="false">118:14 </char><char style="xt" closed="false"><ref loc="EXO 15:2">Kessa 15:2</ref>; <ref loc="ISA 12:2">Isa 12:2</ref></char></note><verse eid="PSA 118:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15" />Xillota dunkaane giddon</para>
  <para style="q2" vid="PSA 118:15">xoono ililisinne</para>
  <para style="q2" vid="PSA 118:15">ufayssa yeththi,</para>
  <para style="q2" vid="PSA 118:15">«GODAA ushachcha kushey</para>
  <para style="q2" vid="PSA 118:15">wolqqama miish</para>
  <para style="q2" vid="PSA 118:15">ooththides!» gishe seetettees.<verse eid="PSA 118:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 118:16" />GODAA ushachcha kushey</para>
  <para style="q2" vid="PSA 118:16">dhoqqu dhoqqu gides!</para>
  <para style="q2" vid="PSA 118:16">GODAA ushachcha kushey</para>
  <para style="q2" vid="PSA 118:16">wolqqama miish ooththides.<verse eid="PSA 118:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17" />Tani hayqqike</para>
  <para style="q2" vid="PSA 118:17">shemppora paxa de7ana;</para>
  <para style="q2" vid="PSA 118:17">GODAY ooththida ooso</para>
  <para style="q2" vid="PSA 118:17">buroppeka awajjana.<verse eid="PSA 118:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18" />GODAY tana keehi qaxxaydes;</para>
  <para style="q2" vid="PSA 118:18">gido attiin hayqos</para>
  <para style="q2" vid="PSA 118:18">aaththi immibeenna.<verse eid="PSA 118:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19" />Tani giddo gelada</para>
  <para style="q2" vid="PSA 118:19">GODAA galatana mala</para>
  <para style="q2" vid="PSA 118:19">xilloteththa pengeta</para>
  <para style="q2" vid="PSA 118:19">ane taas doyte!<verse eid="PSA 118:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20" />Hayssi GODAA penge;</para>
  <para style="q2" vid="PSA 118:20">izara xilloti xalla gelana.<verse eid="PSA 118:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21" />Neni taas siyida gishshassinne</para>
  <para style="q2" vid="PSA 118:21">xoono immida gishshas</para>
  <para style="q2" vid="PSA 118:21">tani nena galatays.<verse eid="PSA 118:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22" />Gimbizayti kadhidi</para>
  <para style="q2" vid="PSA 118:22">ixxida shuchchay</para>
  <para style="q2" vid="PSA 118:22">gulas hu7en woththiza</para>
  <para style="q2" vid="PSA 118:22">shuch gidides.<note caller="-" style="x"><char style="xo" closed="false">118:22 </char><char style="xt" closed="false"><ref loc="LUK 20:17">Luqa 20:17</ref>; <ref loc="ACT 4:11">Hawa 4:11</ref>; <ref loc="1PE 2:7">1Phex 2:7</ref></char></note><verse eid="PSA 118:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23" />Hayssika GODAA ooso;</para>
  <para style="q2" vid="PSA 118:23">qasse nu ayfesikka</para>
  <para style="q2" vid="PSA 118:23">malalisiza miishsha.<note caller="-" style="x"><char style="xo" closed="false">118:22-23 </char><char style="xt" closed="false"><ref loc="MAT 21:42">Mato 21:42</ref>; <ref loc="MRK 12:10-11">Mar 12:10-11</ref></char></note><verse eid="PSA 118:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24" />Hayssi gallassay</para>
  <para style="q2" vid="PSA 118:24">GODAY ooththida gallassa;</para>
  <para style="q2" vid="PSA 118:24">ane nuni izan</para>
  <para style="q2" vid="PSA 118:24">ufayettoossinne ililoos.<verse eid="PSA 118:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 118:25">Ha7i nuna ashsharkkii!</para>
  <para style="q2" vid="PSA 118:25">Abeet GODAWU!</para>
  <para style="q2" vid="PSA 118:25">Ha7i nuus injjesarkkii!<note caller="-" style="x"><char style="xo" closed="false">118:25 </char><char style="xt" closed="false"><ref loc="MAT 21:9">Mato 21:9</ref>; <ref loc="MRK 11:9">Mar 11:9</ref>; <ref loc="JHN 12:3">Yoha 12:3</ref></char></note><verse eid="PSA 118:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26" />GODAA sunththan yiza asi</para>
  <para style="q2" vid="PSA 118:26">anjjettidayssa gido!</para>
  <para style="q2" vid="PSA 118:26">Nuni GODAA Keeththan</para>
  <para style="q2" vid="PSA 118:26">inttena anjjoos.<note caller="-" style="x"><char style="xo" closed="false">118:26 </char><char style="xt" closed="false"><ref loc="MAT 21:9">Mato 21:9</ref>; <ref loc="MAT 23:39">23:39</ref>; <ref loc="MRK 11:9">Mar 11:9</ref>; <ref loc="LUK 13:35">Luqa 13:35</ref>; <ref loc="LUK 19:38">19:38</ref>; <ref loc="JHN 12:13">Yoha 12:13</ref></char></note><verse eid="PSA 118:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27" />GODAY Xoossa;</para>
  <para style="q2" vid="PSA 118:27">izi nuus poo7isides;</para>
  <para style="q2" vid="PSA 118:27">cilila miththa haggata oykkite;</para>
  <para style="q2" vid="PSA 118:27">yarsho yarshizasoza bolla diza</para>
  <para style="q2" vid="PSA 118:27">kacetakko gakkanaas kezite;</para>
  <para style="q2" vid="PSA 118:27">ba7aale bonchchite.<verse eid="PSA 118:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28" />Neni ta Xoossa;</para>
  <para style="q2" vid="PSA 118:28">tani nena galatana;</para>
  <para style="q2" vid="PSA 118:28">Neni ta Xoossa;</para>
  <para style="q2" vid="PSA 118:28">tani nena gitasana.<verse eid="PSA 118:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29" />Izi kiya gidida gishshas</para>
  <para style="q2" vid="PSA 118:29">GODAA galatite!</para>
  <para style="q2" vid="PSA 118:29">Iza siiqoy mernaassa.<verse eid="PSA 118:29" /></para>
  <chapter eid="PSA 118" />
  <chapter number="119" style="c" sid="PSA 119" />
  <para style="qa">Alefe</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1" />Bantta ogen borey bayndaytinne</para>
  <para style="q2" vid="PSA 119:1">GODAA wogga mala</para>
  <para style="q2" vid="PSA 119:1">hemettizayti anjjettidayta.<verse eid="PSA 119:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2" />Izi yootidayssa ooththizaytinne</para>
  <para style="q2" vid="PSA 119:2">ba kumeththa wozinappe</para>
  <para style="q2" vid="PSA 119:2">iza koyzayti anjjettidayta.<verse eid="PSA 119:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3" />Istti makkalla miish ooththettenna;</para>
  <para style="q2" vid="PSA 119:3">GODAA ogen hemetteettes.<verse eid="PSA 119:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4" />Ne woga ammanettidi</para>
  <para style="q2" vid="PSA 119:4">naagana mala</para>
  <para style="q2" vid="PSA 119:4">neni nuna azazadasa.<verse eid="PSA 119:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5" />Ne woththida woga naaganaas</para>
  <para style="q2" vid="PSA 119:5">ta ogey minnana mala</para>
  <para style="q2" vid="PSA 119:5">ta amottays.<verse eid="PSA 119:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6" />Ne azazota ubbaa</para>
  <para style="q2" vid="PSA 119:6">ta lo7eththa akeekikko</para>
  <para style="q2" vid="PSA 119:6">mulekka yeellatikke.<verse eid="PSA 119:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7" />Ne xillo pirda tani tamaarda keena</para>
  <para style="q2" vid="PSA 119:7">suure wozinappe nena galatana.<verse eid="PSA 119:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8" />Tani ne woththida maarata naagana;</para>
  <para style="q2" vid="PSA 119:8">tana mulekka yeggofa.<verse eid="PSA 119:8" /></para>
  <para style="qa">Beete</para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9" />Naateththi ba oge geeshshateththan</para>
  <para style="q2" vid="PSA 119:9">wostti naaganaas dandayzee?</para>
  <para style="q2" vid="PSA 119:9">Ne qaalay giza mala</para>
  <para style="q2" vid="PSA 119:9">de7ikko dandayees.<verse eid="PSA 119:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10" />Tani ta kumeththa wozinappe</para>
  <para style="q2" vid="PSA 119:10">nena koyays;</para>
  <para style="q2" vid="PSA 119:10">ne azazotappe kare kezontta mala</para>
  <para style="q2" vid="PSA 119:10">tana naaga.<verse eid="PSA 119:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11" />Tani ne bolla</para>
  <para style="q2" vid="PSA 119:11">nagara ooththontta mala</para>
  <para style="q2" vid="PSA 119:11">ne qaala ta wozinan qottadis.<verse eid="PSA 119:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12" />Abeet GODAWU! Neni galatetta!</para>
  <para style="q2" vid="PSA 119:12">Ne maara tana tamaarsa.<verse eid="PSA 119:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13" />Ne doonappe keziza maara ubbaa</para>
  <para style="q2" vid="PSA 119:13">tani ta inxarsan yootays.<verse eid="PSA 119:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14" />Asi ba dureteththan ufayettiza mala</para>
  <para style="q2" vid="PSA 119:14">tani neni immida maara</para>
  <para style="q2" vid="PSA 119:14">kaallashe ufayettays.<verse eid="PSA 119:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15" />Ne woththida wogata</para>
  <para style="q2" vid="PSA 119:15">yuushsha qoppays;</para>
  <para style="q2" vid="PSA 119:15">ta wozinakka</para>
  <para style="q2" vid="PSA 119:15">ne ogetan woththadis.<verse eid="PSA 119:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16" />Ne awajjay tana ufayssees;</para>
  <para style="q2" vid="PSA 119:16">ne qaalaakka tani dogikke.<verse eid="PSA 119:16" /></para>
  <para style="qa">Gaamel</para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17" />Tani shemppora paxa</para>
  <para style="q2" vid="PSA 119:17">de7ana malanne</para>
  <para style="q2" vid="PSA 119:17">ne qaalas azazettana mala,</para>
  <para style="q2" vid="PSA 119:17">taas ne aylles lo7o miish ooththa.<verse eid="PSA 119:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18" />Ne woga giddon diza</para>
  <para style="q2" vid="PSA 119:18">malalisiza tumateththa</para>
  <para style="q2" vid="PSA 119:18">tani be7ana mala ta ayfe doya.<verse eid="PSA 119:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19" />Tani ha sa7an imaththa;</para>
  <para style="q2" vid="PSA 119:19">ne azazota taappe genththofa.<verse eid="PSA 119:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20" />Ta shemppoya ubba wode</para>
  <para style="q2" vid="PSA 119:20">ne maara demmanaas</para>
  <para style="q2" vid="PSA 119:20">keeha laamotadus.<verse eid="PSA 119:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21" />Ne azazozappe kare kezizayta,</para>
  <para style="q2" vid="PSA 119:21">otorettizaytanne qanggettizayta</para>
  <para style="q2" vid="PSA 119:21">neni seeraasa.<verse eid="PSA 119:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22" />Ta neni yootidayssa</para>
  <para style="q2" vid="PSA 119:22">naagida gishshas</para>
  <para style="q2" vid="PSA 119:22">istta cashshanne kadheza</para>
  <para style="q2" vid="PSA 119:22">ta bollafe digga.<verse eid="PSA 119:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23" />Dere kaaleththizayti ubbati</para>
  <para style="q2" vid="PSA 119:23">ta bolla maqettikokka</para>
  <para style="q2" vid="PSA 119:23">tani ne aylley</para>
  <para style="q2" vid="PSA 119:23">ne awajjata yuushsha qoppana.<verse eid="PSA 119:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24" />Ne markkateththati</para>
  <para style="q2" vid="PSA 119:24">tana ufaysseettes;</para>
  <para style="q2" vid="PSA 119:24">isttika tana zoreettes.<verse eid="PSA 119:24" /></para>
  <para style="qa">Daaleexe</para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25" />Ta shemppoy kezana hanees;</para>
  <para style="q2" vid="PSA 119:25">neni gida qaala mala tana ashsha.<verse eid="PSA 119:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26" />Tani ta oge ubbaa</para>
  <para style="q2" vid="PSA 119:26">nees qonccisadis;</para>
  <para style="q2" vid="PSA 119:26">neni taas siyadasa;</para>
  <para style="q2" vid="PSA 119:26">ne awajjata tana tamaarsa.<verse eid="PSA 119:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27" />Ne maara tana akeekissa;</para>
  <para style="q2" vid="PSA 119:27">malalisiza ne ooso</para>
  <para style="q2" vid="PSA 119:27">ta yuushsha qoppana.<verse eid="PSA 119:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28" />Ta shemppoya ceecey</para>
  <para style="q2" vid="PSA 119:28">darida gishshas daaburadus;</para>
  <para style="q2" vid="PSA 119:28">neni gida qaala mala</para>
  <para style="q2" vid="PSA 119:28">tana minththa.<verse eid="PSA 119:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29" />Baleththiza oge taappe haassa;</para>
  <para style="q2" vid="PSA 119:29">ne kiyateththan</para>
  <para style="q2" vid="PSA 119:29">ne woga tana tamaarsa.<verse eid="PSA 119:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30" />Tani tumaa oge dooradis;</para>
  <para style="q2" vid="PSA 119:30">ne wogaakka</para>
  <para style="q2" vid="PSA 119:30">ta wozinan woththadis.<verse eid="PSA 119:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 119:31">Tani ne yootidayssa</para>
  <para style="q2" vid="PSA 119:31">minththa oykkadis;</para>
  <para style="q2" vid="PSA 119:31">ne tana yeellas aaththa immofa.<verse eid="PSA 119:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32" />Neni ta wozina aassida gishshas</para>
  <para style="q2" vid="PSA 119:32">tani ne azazo ogen woxxays.<verse eid="PSA 119:32" /></para>
  <para style="qa">He</para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 119:33">Ne awajjata tana tamaarsa;</para>
  <para style="q2" vid="PSA 119:33">tani wurseththi gakkanaas</para>
  <para style="q2" vid="PSA 119:33">iza naagana.<verse eid="PSA 119:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34" />Tani ne woga naagana malanne</para>
  <para style="q2" vid="PSA 119:34">kumeththa wozinappe</para>
  <para style="q2" vid="PSA 119:34">izas azazettana mala</para>
  <para style="q2" vid="PSA 119:34">neni taas akeeka imma.<verse eid="PSA 119:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35" />Ne azazoy tana ufayssees;</para>
  <para style="q2" vid="PSA 119:35">hessa gishshas ne ogen</para>
  <para style="q2" vid="PSA 119:35">tana kaaleththa.<verse eid="PSA 119:35" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36" />Ta wozina bessontta go7as gidontta</para>
  <para style="q2" vid="PSA 119:36">ne maara polana mala zaara.<verse eid="PSA 119:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37" />Paththontta miish xeellontta mala</para>
  <para style="q2" vid="PSA 119:37">ta ayfeta naaga;</para>
  <para style="q2" vid="PSA 119:37">ne qaala mala ta de7o ooraxissa.<verse eid="PSA 119:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38" />Nees yayyana mala</para>
  <para style="q2" vid="PSA 119:38">ne gelida qaala</para>
  <para style="q2" vid="PSA 119:38">taas ne ayllezas pola.<verse eid="PSA 119:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39" />Ne pirday suure gidida gishshas</para>
  <para style="q2" vid="PSA 119:39">tani yayyiza kawushshateththafe</para>
  <para style="q2" vid="PSA 119:39">tana naaga.<verse eid="PSA 119:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40" />Tani ne woga naaganawu amottays;</para>
  <para style="q2" vid="PSA 119:40">neni xilloteththan</para>
  <para style="q2" vid="PSA 119:40">ta de7o ooraxissa.<verse eid="PSA 119:40" /></para>
  <para style="qa">Waw</para>
  <para style="b" />
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 119:41">Ne mernaa siiqoy taakko haa yo;</para>
  <para style="q2" vid="PSA 119:41">neni gida qaala mala tana ashsha.<verse eid="PSA 119:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42" />Tani ne qaalan ammanettays;</para>
  <para style="q2" vid="PSA 119:42">tana cayizaytaska</para>
  <para style="q2" vid="PSA 119:42">tani zaaro immana.<verse eid="PSA 119:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43" />Tani ne wogan hidota ooththadis;</para>
  <para style="q2" vid="PSA 119:43">tuma qaala</para>
  <para style="q2" vid="PSA 119:43">ta doonappe dhayssofa.<verse eid="PSA 119:43" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44" />Tani meri mernaaskka</para>
  <para style="q2" vid="PSA 119:44">ne wogaas ubba wode azazettana.<verse eid="PSA 119:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45" />Tani ne woga siiqiza gishshas</para>
  <para style="q2" vid="PSA 119:45">la7an simerettana.<verse eid="PSA 119:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46" />Tani kawota sinththan eqqada</para>
  <para style="q2" vid="PSA 119:46">neni yootidayssa</para>
  <para style="q2" vid="PSA 119:46">yootashe yeellatikke.<verse eid="PSA 119:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47" />Tani ne azazota dosays;</para>
  <para style="q2" vid="PSA 119:47">isttankka ufayettays.<verse eid="PSA 119:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48" />Tani siiqiza ne azazota bonchchays;</para>
  <para style="q2" vid="PSA 119:48">ne awajjata yuushsha qoppana.<verse eid="PSA 119:48" /></para>
  <para style="qa">Zay</para>
  <para style="b" />
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49" />Neni taas ne ayllezas</para>
  <para style="q2" vid="PSA 119:49">immida qaala qoppa;</para>
  <para style="q2" vid="PSA 119:49">hessa gishshas tani he qaalan</para>
  <para style="q2" vid="PSA 119:49">hidota ooththays.<verse eid="PSA 119:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50" />Ne qaalay taas de7o immides;</para>
  <para style="q2" vid="PSA 119:50">hessi meto wode</para>
  <para style="q2" vid="PSA 119:50">tana minththeththees.<verse eid="PSA 119:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51" />Otoranchchati tana keehi kadhida;</para>
  <para style="q2" vid="PSA 119:51">gido attiin tani</para>
  <para style="q2" vid="PSA 119:51">ne wogappe sher7i giikke.<verse eid="PSA 119:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 119:52">beniisofe diza ne woga</para>
  <para style="q2" vid="PSA 119:52">tani qoppadis;</para>
  <para style="q2" vid="PSA 119:52">hessan tani minettays.<verse eid="PSA 119:52" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53" />Iitati ne wogas azazettonttayssa</para>
  <para style="q2" vid="PSA 119:53">be7ada keeha hanqettadis.<verse eid="PSA 119:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54" />Tani imaththateththan</para>
  <para style="q2" vid="PSA 119:54">de7iza biittan</para>
  <para style="q2" vid="PSA 119:54">ne wogay taas mazamure gidides.<verse eid="PSA 119:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 119:55">Tani giddoth</para>
  <para style="q2" vid="PSA 119:55">ne sunththaa qoppays;</para>
  <para style="q2" vid="PSA 119:55">ne wogaakka naagays.<verse eid="PSA 119:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56" />Ta ne wogaas azazettana;</para>
  <para style="q2" vid="PSA 119:56">hessi taas ooso gidides.<verse eid="PSA 119:56" /></para>
  <para style="qa">Heet</para>
  <para style="b" />
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 119:57">Ta qaaday nena;</para>
  <para style="q2" vid="PSA 119:57">tani ne qaalas</para>
  <para style="q2" vid="PSA 119:57">azazettanaas qachchadis.<verse eid="PSA 119:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58" />Tani kumeththa wozinappe</para>
  <para style="q2" vid="PSA 119:58">nena koyays;</para>
  <para style="q2" vid="PSA 119:58">neni gida qaala mala</para>
  <para style="q2" vid="PSA 119:58">taas qadhetta.<verse eid="PSA 119:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59" />Tani ta oge xomosa xeelladis;</para>
  <para style="q2" vid="PSA 119:59">ne maara kaallanaas simmadis.<verse eid="PSA 119:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60" />Tani ne azazo naaganaas</para>
  <para style="q2" vid="PSA 119:60">eesotanaappe attiin takkike.<verse eid="PSA 119:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61" />Iitati tana oykkana gite yeggida;</para>
  <para style="q2" vid="PSA 119:61">tani gidikko</para>
  <para style="q2" vid="PSA 119:61">ne woga dogabeekke.<verse eid="PSA 119:61" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62" />Ne xillo woga gishshas ta nena</para>
  <para style="q2" vid="PSA 119:62">galatanaas giddoth dendays.<verse eid="PSA 119:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63" />Tani nees yayyizayta ubbaassinne</para>
  <para style="q2" vid="PSA 119:63">ne woga naagizaytas lagge.<verse eid="PSA 119:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 119:64">Sa7ay ne mernaa siiqon kumides;</para>
  <para style="q2" vid="PSA 119:64">ne awajjata tana tamaarsa.<verse eid="PSA 119:64" /></para>
  <para style="qa">Xeet</para>
  <para style="b" />
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 119:65">Ne gida qaala mala</para>
  <para style="q2" vid="PSA 119:65">taas ne ayllezas lo7o ooththadasa.<verse eid="PSA 119:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66" />Tani ne azazota ammanays;</para>
  <para style="q2" vid="PSA 119:66">lo7o pirdanne</para>
  <para style="q2" vid="PSA 119:66">erateth tana tamaarsa.<verse eid="PSA 119:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67" />Ta qaxxayettanaappe kase</para>
  <para style="q2" vid="PSA 119:67">ne wogappe kare kezadis;</para>
  <para style="q2" vid="PSA 119:67">ha7i tani ne qaalas azazettana.<verse eid="PSA 119:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68" />Neni lo7o; ne oosoykka lo7o;</para>
  <para style="q2" vid="PSA 119:68">hessa gishshas ne awajjata</para>
  <para style="q2" vid="PSA 119:68">tana tamaarsa.<verse eid="PSA 119:68" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69" />Otoranchchati ta sunththaa</para>
  <para style="q2" vid="PSA 119:69">wordora moorida;</para>
  <para style="q2" vid="PSA 119:69">gido attiin tani ne woga</para>
  <para style="q2" vid="PSA 119:69">ta kumeththa wozinappe</para>
  <para style="q2" vid="PSA 119:69">naagays.<verse eid="PSA 119:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70" />Istta wozinay mulekka dammides;</para>
  <para style="q2" vid="PSA 119:70">gido attiin tani</para>
  <para style="q2" vid="PSA 119:70">ne wogan ufayettays.<verse eid="PSA 119:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71" />Tani qaxxayettidayssi</para>
  <para style="q2" vid="PSA 119:71">taas lo7o gidides;</para>
  <para style="q2" vid="PSA 119:71">ne woga taamarana mala</para>
  <para style="q2" vid="PSA 119:71">tana maaddides.<verse eid="PSA 119:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72" />Daro shii birappenne worqqafe</para>
  <para style="q2" vid="PSA 119:72">ne doonappe ke7ida wogay</para>
  <para style="q2" vid="PSA 119:72">taas aadhdhees.<verse eid="PSA 119:72" /></para>
  <para style="qa">Yood</para>
  <para style="b" />
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73" />Tana ne kushey</para>
  <para style="q2" vid="PSA 119:73">medhdhidessinne giigsides;</para>
  <para style="q2" vid="PSA 119:73">ne azazo tani taamarana mala</para>
  <para style="q2" vid="PSA 119:73">taas akeeka imma.<verse eid="PSA 119:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74" />Tani ne qaala hidota ooththadis;</para>
  <para style="q2" vid="PSA 119:74">hessa gishshas nees yayyizayti</para>
  <para style="q2" vid="PSA 119:74">tana be7idi ufayetetto.<verse eid="PSA 119:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 119:75">Ne pirday xillo gididayssanne</para>
  <para style="q2" vid="PSA 119:75">neni tana qaxxayday</para>
  <para style="q2" vid="PSA 119:75">ammaneteththan gididayssa</para>
  <para style="q2" vid="PSA 119:75">tani erays.<verse eid="PSA 119:75" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76" />Neni taas ne ayllezas</para>
  <para style="q2" vid="PSA 119:76">gelida qaala mala</para>
  <para style="q2" vid="PSA 119:76">ne mernaa siiqoy</para>
  <para style="q2" vid="PSA 119:76">tana minththeththo.<verse eid="PSA 119:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77" />Ne wogay tana ufayssiza gishshas</para>
  <para style="q2" vid="PSA 119:77">tani shemppora</para>
  <para style="q2" vid="PSA 119:77">paxa de7ana mala</para>
  <para style="q2" vid="PSA 119:77">taas qadhetta.<verse eid="PSA 119:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78" />Otoranchchati tana wordon</para>
  <para style="q2" vid="PSA 119:78">mootiza gishshas yeellatetto.</para>
  <para style="q2" vid="PSA 119:78">Tani gidikko ne wogata</para>
  <para style="q2" vid="PSA 119:78">yuushsha qoppays.<verse eid="PSA 119:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79" />Nees yayyizaytinne</para>
  <para style="q2" vid="PSA 119:79">ne azazo erizayti ubbay</para>
  <para style="q2" vid="PSA 119:79">haa taakko simmetto.<verse eid="PSA 119:79" /></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80" />Tani yeellatontta mala</para>
  <para style="q2" vid="PSA 119:80">ne maaran ta wozinay</para>
  <para style="q2" vid="PSA 119:80">borey bayndaaz gido.<verse eid="PSA 119:80" /></para>
  <para style="qa">Kaaf</para>
  <para style="b" />
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81" />Ne tana ashshana mala</para>
  <para style="q2" vid="PSA 119:81">ta shemppoya keeha laamotadus;</para>
  <para style="q2" vid="PSA 119:81">tanikka ne qaala</para>
  <para style="q2" vid="PSA 119:81">hidota ooththadis.<verse eid="PSA 119:81" /></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82" />«Ayde tana minththeththandeesha?»</para>
  <para style="q2" vid="PSA 119:82">guussan ne immida</para>
  <para style="q2" vid="PSA 119:82">hidota qaala ta naagishin</para>
  <para style="q2" vid="PSA 119:82">ta ayfey doljumides.<verse eid="PSA 119:82" /></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83" />Cuwan kaqqida</para>
  <para style="q2" vid="PSA 119:83">lukkamo mala gidadis;</para>
  <para style="q2" vid="PSA 119:83">gidikkoka ne awajjata</para>
  <para style="q2" vid="PSA 119:83">balabeekke.<verse eid="PSA 119:83" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84" />Tani ne aylley</para>
  <para style="q2" vid="PSA 119:84">awude gakkanaas daanee?</para>
  <para style="q2" vid="PSA 119:84">Tana yedeththizayta bolla</para>
  <para style="q2" vid="PSA 119:84">neni awude pirdanee?<verse eid="PSA 119:84" /></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85" />Ne woga naagontta otoranchchati</para>
  <para style="q2" vid="PSA 119:85">tana dhayssanaas</para>
  <para style="q2" vid="PSA 119:85">olla bookkeettes.<verse eid="PSA 119:85" /></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86" />Ne azazoti ubbay ammanettizayta;</para>
  <para style="q2" vid="PSA 119:86">asay gaasoy baynda</para>
  <para style="q2" vid="PSA 119:86">yedeththiza gishshas</para>
  <para style="q2" vid="PSA 119:86">tana maadda!<verse eid="PSA 119:86" /></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87" />Istti tana</para>
  <para style="q2" vid="PSA 119:87">biittafe dhayssana gakkida;</para>
  <para style="q2" vid="PSA 119:87">gido attiin tani</para>
  <para style="q2" vid="PSA 119:87">ne woga aggabeekke.<verse eid="PSA 119:87" /></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88" />Ne mernaa siiqon</para>
  <para style="q2" vid="PSA 119:88">ta de7o ooraxissa;</para>
  <para style="q2" vid="PSA 119:88">tanikka ne azazota naagana.<verse eid="PSA 119:88" /></para>
  <para style="qa">Laamed</para>
  <para style="b" />
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 119:89">Ne qaalay mernaasa;</para>
  <para style="q2" vid="PSA 119:89">izikka salon minni dees.<verse eid="PSA 119:89" /></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90" />Ne ammaneteththay yeletappe</para>
  <para style="q2" vid="PSA 119:90">yeleta gakkanaas dees;</para>
  <para style="q2" vid="PSA 119:90">neni sa7as yochcha yeggadasa;</para>
  <para style="q2" vid="PSA 119:90">izikka minnidi dees.<verse eid="PSA 119:90" /></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91" />Neni gida mala ubbayka</para>
  <para style="q2" vid="PSA 119:91">hach gakkanaas minnidi dees;</para>
  <para style="q2" vid="PSA 119:91">ays giikko ubbatikka</para>
  <para style="q2" vid="PSA 119:91">ne aylleta.<verse eid="PSA 119:91" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92" />Ta metotida wode</para>
  <para style="q2" vid="PSA 119:92">dhayaychchana shin</para>
  <para style="q2" vid="PSA 119:92">ne wogay taas ufays gidides.<verse eid="PSA 119:92" /></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93" />Ne azazoti tana shemppora</para>
  <para style="q2" vid="PSA 119:93">paxa woththida gishshas</para>
  <para style="q2" vid="PSA 119:93">tani mulekka istta dogikke.<verse eid="PSA 119:93" /></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94" />Tani neessa;</para>
  <para style="q2" vid="PSA 119:94">tana ashsharkkii!</para>
  <para style="q2" vid="PSA 119:94">tani woga naaganawu koyays.<verse eid="PSA 119:94" /></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95" />Iitati tana dhayssanawu</para>
  <para style="q2" vid="PSA 119:95">zamadidi naageettes;</para>
  <para style="q2" vid="PSA 119:95">gido attiin neni yootidayssa</para>
  <para style="q2" vid="PSA 119:95">tani yuushsha qoppays.<verse eid="PSA 119:95" /></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96" />Polo gidida miish ubbaas zaway</para>
  <para style="q2" vid="PSA 119:96">dizayssa tani be7adis;</para>
  <para style="q2" vid="PSA 119:96">gido attiin polo gidida</para>
  <para style="q2" vid="PSA 119:96">ne azazotas zaway deenna.<verse eid="PSA 119:96" /></para>
  <para style="qa">Meem</para>
  <para style="b" />
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97" />Tani ne woga ay keena siiqazinaa!</para>
  <para style="q2" vid="PSA 119:97">Gallas kumeth</para>
  <para style="q2" vid="PSA 119:97">tani iza yuushsha qoppays.<verse eid="PSA 119:97" /></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98" />Ne azazoti ubba wodekka</para>
  <para style="q2" vid="PSA 119:98">tanara diza gishshas</para>
  <para style="q2" vid="PSA 119:98">ta morkketappe aaththidi</para>
  <para style="q2" vid="PSA 119:98">tana akeekanchcha histtida.<verse eid="PSA 119:98" /></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99" />Ne woththida woga</para>
  <para style="q2" vid="PSA 119:99">yuushsha qoppiza gishshas</para>
  <para style="q2" vid="PSA 119:99">tana tamaarsida ubbaafe</para>
  <para style="q2" vid="PSA 119:99">wozinama gidadis.<verse eid="PSA 119:99" /></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100" />Tani ne azazota kaalliza gishshas</para>
  <para style="q2" vid="PSA 119:100">cimatappe bollara</para>
  <para style="q2" vid="PSA 119:100">akeekiza as gidadis.<verse eid="PSA 119:100" /></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101" />Tani ne qaalas</para>
  <para style="q2" vid="PSA 119:101">azazettanaas koyza gishshas</para>
  <para style="q2" vid="PSA 119:101">ta toho iita oge ubbaafe naagadis.<verse eid="PSA 119:101" /></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102" />Neni tana tamaarsida gishshas</para>
  <para style="q2" vid="PSA 119:102">tani ne wogappe sher7i gabeekke.<verse eid="PSA 119:102" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103" />Ne qaalay ay mala mal7izee!</para>
  <para style="q2" vid="PSA 119:103">Eessa ililoppeka aadhdhidi</para>
  <para style="q2" vid="PSA 119:103">doonan mal7ees.<verse eid="PSA 119:103" /></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104" />Ne wogappe akeeka demmadis;</para>
  <para style="q2" vid="PSA 119:104">hessa gishshas tani</para>
  <para style="q2" vid="PSA 119:104">geella oge ubbaa ixxadis.<verse eid="PSA 119:104" /></para>
  <para style="qa">Noon</para>
  <para style="b" />
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105" />Ne qaalay ta tohos xomppe;</para>
  <para style="q2" vid="PSA 119:105">ta ogeska poo7o.<verse eid="PSA 119:105" /></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106" />Ne xillo woga naaganaas</para>
  <para style="q2" vid="PSA 119:106">tani caaqqida caaqoza minththana.<verse eid="PSA 119:106" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 119:107">Ta keeha metotadis;</para>
  <para style="q2" vid="PSA 119:107">Neni gida qaala mala</para>
  <para style="q2" vid="PSA 119:107">tana shemppora paxa woththa.<verse eid="PSA 119:107" /></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 119:108">Ta doonappe keziza</para>
  <para style="q2" vid="PSA 119:108">galata yarshoza</para>
  <para style="q2" vid="PSA 119:108">ne ekka;</para>
  <para style="q2" vid="PSA 119:108">ne woga tana tamaarsa.<verse eid="PSA 119:108" /></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109" />Ta shemppoya ubba wode</para>
  <para style="q2" vid="PSA 119:109">meto bolla dawus;</para>
  <para style="q2" vid="PSA 119:109">tani gidikko ne woga balabeekke.<verse eid="PSA 119:109" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110" />Iitati tana oykkanaas</para>
  <para style="q2" vid="PSA 119:110">woximade woththida;</para>
  <para style="q2" vid="PSA 119:110">gido attiin tani ne wogappe</para>
  <para style="q2" vid="PSA 119:110">sher7i gabeekke.<verse eid="PSA 119:110" /></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111" />Ne immida wogay</para>
  <para style="q2" vid="PSA 119:111">taas mernaas laata;</para>
  <para style="q2" vid="PSA 119:111">ta wozinay izan ufayettees.<verse eid="PSA 119:111" /></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112" />Ta hayqqana gakkanaas</para>
  <para style="q2" vid="PSA 119:112">ne immida azazo polanaas</para>
  <para style="q2" vid="PSA 119:112">qaala geladis.<verse eid="PSA 119:112" /></para>
  <para style="qa">Samket</para>
  <para style="b" />
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113" />Tani wozina ballata ixxays;</para>
  <para style="q2" vid="PSA 119:113">gido attiin ne woga siiqays.<verse eid="PSA 119:113" /></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114" />Neni taas gondallenne</para>
  <para style="q2" vid="PSA 119:114">baqata attizaso;</para>
  <para style="q2" vid="PSA 119:114">tani ne qaala hidota ooththays.<verse eid="PSA 119:114" /></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115" />Tani ta Xoossaa azazo</para>
  <para style="q2" vid="PSA 119:115">naagana mala</para>
  <para style="q2" vid="PSA 119:115">intteno iita ooththizaytoo!</para>
  <para style="q2" vid="PSA 119:115">Taappe haakkite!<verse eid="PSA 119:115" /></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116" />Neni gida qaala mala</para>
  <para style="q2" vid="PSA 119:116">tana kaafa;</para>
  <para style="q2" vid="PSA 119:116">histtiko tani shemppora</para>
  <para style="q2" vid="PSA 119:116">paxa de7ana;</para>
  <para style="q2" vid="PSA 119:116">ta hidotay hada gidiin</para>
  <para style="q2" vid="PSA 119:116">tana yeellasoppa.<verse eid="PSA 119:116" /></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117" />Ne tana kaafa oykka;</para>
  <para style="q2" vid="PSA 119:117">histtiko ta saron de7ana;</para>
  <para style="q2" vid="PSA 119:117">tani ubba wode</para>
  <para style="q2" vid="PSA 119:117">ne awajjata polana.<verse eid="PSA 119:117" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118" />Ne wogappe kare kezidayta</para>
  <para style="q2" vid="PSA 119:118">ubbaa yegga aggadasa;</para>
  <para style="q2" vid="PSA 119:118">istti baleththoninne wordon</para>
  <para style="q2" vid="PSA 119:118">ooththida ubbay hada gidana.<verse eid="PSA 119:118" /></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119" />Sa7an de7iza iitata ubbaa</para>
  <para style="q2" vid="PSA 119:119">neni buura mala yegga aggaasa;</para>
  <para style="q2" vid="PSA 119:119">hessa gishshas tani</para>
  <para style="q2" vid="PSA 119:119">ne immida azazo dosadis.<verse eid="PSA 119:119" /></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120" />Ta ashoy nees yayyidi kokkorees;</para>
  <para style="q2" vid="PSA 119:120">takka ne pirdas yayyays.<verse eid="PSA 119:120" /></para>
  <para style="qa">Ee</para>
  <para style="b" />
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121" />Tani suurenne xillo miish ooththadis;</para>
  <para style="q2" vid="PSA 119:121">tana un7eththizaytas</para>
  <para style="q2" vid="PSA 119:121">aaththa immofa.<verse eid="PSA 119:121" /></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122" />Taas ne aylleza lo7eteththas</para>
  <para style="q2" vid="PSA 119:122">waase gida;</para>
  <para style="q2" vid="PSA 119:122">tana otoranchchatan un7eththofa.<verse eid="PSA 119:122" /></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123" />Ta ayfeti ne ashshizayssanne</para>
  <para style="q2" vid="PSA 119:123">ne xillo qaala naagishe doljumida.<verse eid="PSA 119:123" /></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124" />Taas ne aylles</para>
  <para style="q2" vid="PSA 119:124">ne siiqoza keena ooththa;</para>
  <para style="q2" vid="PSA 119:124">ne woga tana tamaarsa.<verse eid="PSA 119:124" /></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125" />Tani ne aylle;</para>
  <para style="q2" vid="PSA 119:125">ne wogaa ta erana mala</para>
  <para style="q2" vid="PSA 119:125">taas akeeka imma.<verse eid="PSA 119:125" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 119:126">Ne immida wogay</para>
  <para style="q2" vid="PSA 119:126">moorettishe dees;</para>
  <para style="q2" vid="PSA 119:126">neni pirdana wodeya hanno.<verse eid="PSA 119:126" /></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127" />Tani ne azazo</para>
  <para style="q2" vid="PSA 119:127">worqqafe aaththada siiqays;</para>
  <para style="q2" vid="PSA 119:127">muuruta worqqafekka</para>
  <para style="q2" vid="PSA 119:127">aaththada dosays.<verse eid="PSA 119:127" /></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128" />Ne wogati ubbay</para>
  <para style="q2" vid="PSA 119:128">tumu gididayssa ammanadis;</para>
  <para style="q2" vid="PSA 119:128">hessa gishshas geella oge</para>
  <para style="q2" vid="PSA 119:128">ubbaa ixxadis.<verse eid="PSA 119:128" /></para>
  <para style="qa">Pe</para>
  <para style="b" />
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129" />Ne yootida qaalay ubbay malalisees;</para>
  <para style="q2" vid="PSA 119:129">hessa gishshas ta shemppoya</para>
  <para style="q2" vid="PSA 119:129">iza naagawus.<verse eid="PSA 119:129" /></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130" />Ne qaala birsheththay</para>
  <para style="q2" vid="PSA 119:130">poo7o immees;</para>
  <para style="q2" vid="PSA 119:130">akeekay paccidaytas</para>
  <para style="q2" vid="PSA 119:130">akeeka immees.<verse eid="PSA 119:130" /></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131" />Tani ne qaala saamettadis;</para>
  <para style="q2" vid="PSA 119:131">ta doonakka doyada yeemottays.<verse eid="PSA 119:131" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132" />Haa taakko simma;</para>
  <para style="q2" vid="PSA 119:132">ne sunththa siiqizayta ubbaas</para>
  <para style="q2" vid="PSA 119:132">neni ooththizayssa mala</para>
  <para style="q2" vid="PSA 119:132">taaska qadhetta.<verse eid="PSA 119:132" /></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133" />Ta hemeta ne qaala mala suurisa;</para>
  <para style="q2" vid="PSA 119:133">nagaray haarana mala</para>
  <para style="q2" vid="PSA 119:133">tana aaththa immofa.<verse eid="PSA 119:133" /></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134" />Tani ne azazo naagana mala</para>
  <para style="q2" vid="PSA 119:134">tana un7eththizayta</para>
  <para style="q2" vid="PSA 119:134">kusheppe wozza.<verse eid="PSA 119:134" /></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135" />Taas ne ayllezas</para>
  <para style="q2" vid="PSA 119:135">ne ayfeso poo7isa;</para>
  <para style="q2" vid="PSA 119:135">ne awajjata tana tamaarsa.<verse eid="PSA 119:135" /></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136" />Ne wogay bonchchettontta gishshas</para>
  <para style="q2" vid="PSA 119:136">ta afunththi</para>
  <para style="q2" vid="PSA 119:136">haaththa mala goggees.<verse eid="PSA 119:136" /></para>
  <para style="qa">Xaade</para>
  <para style="b" />
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137" />Abeet GODAWU! Neni xillo;</para>
  <para style="q2" vid="PSA 119:137">ne pirdayka likke.<verse eid="PSA 119:137" /></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138" />Ne immida azazoti</para>
  <para style="q2" vid="PSA 119:138">xillonne ammanththizaaza.<verse eid="PSA 119:138" /></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139" />Ta morkketi ne qaala toochchida;</para>
  <para style="q2" vid="PSA 119:139">histtiin ne qaala mishay</para>
  <para style="q2" vid="PSA 119:139">ta gomppan tama mala eexxides.<verse eid="PSA 119:139" /></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140" />Ne qaalay paacetti geeyidaaza;</para>
  <para style="q2" vid="PSA 119:140">tani ne aylley iza siiqays.<verse eid="PSA 119:140" /></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141" />Tani laafanne kadhettida asa;</para>
  <para style="q2" vid="PSA 119:141">gidikkoka tani ne woga</para>
  <para style="q2" vid="PSA 119:141">dogabeekke.<verse eid="PSA 119:141" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142" />Ne xilloteththay mernaas dees;</para>
  <para style="q2" vid="PSA 119:142">ne wogaykka tuma.<verse eid="PSA 119:142" /></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143" />Metoynne tuggay tana gakkides;</para>
  <para style="q2" vid="PSA 119:143">gido attiin ne azazoti</para>
  <para style="q2" vid="PSA 119:143">tana ufaysseettes.<verse eid="PSA 119:143" /></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144" />Neni yootidayssi mernaaskka xillo;</para>
  <para style="q2" vid="PSA 119:144">tani shemppora paxa daana mala</para>
  <para style="q2" vid="PSA 119:144">ne taas akeeka imma.<verse eid="PSA 119:144" /></para>
  <para style="qa">Qof</para>
  <para style="b" />
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 119:145">Tani Kumeththa wozinappe</para>
  <para style="q2" vid="PSA 119:145">neekko waassadis;</para>
  <para style="q2" vid="PSA 119:145">tana alla.</para>
  <para style="q2" vid="PSA 119:145">Tani ne awajjatas azazettana.<verse eid="PSA 119:145" /></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146" />Tani neekko waassays;</para>
  <para style="q2" vid="PSA 119:146">ne tana ashsha;</para>
  <para style="q2" vid="PSA 119:146">tani ne immida azazoza naagana.<verse eid="PSA 119:146" /></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147" />Bazzoy zo7ontta wonttara dendada,</para>
  <para style="q2" vid="PSA 119:147">«Tana maadda» gaada</para>
  <para style="q2" vid="PSA 119:147">neekko waassays;</para>
  <para style="q2" vid="PSA 119:147">ne taas gelida qaala</para>
  <para style="q2" vid="PSA 119:147">hidota ooththays.<verse eid="PSA 119:147" /></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148" />Ne qaala yuushsha qoppashe</para>
  <para style="q2" vid="PSA 119:148">omars kumeth ayfe qiphontta</para>
  <para style="q2" vid="PSA 119:148">utta aqays.<verse eid="PSA 119:148" /></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 119:149">Ne siiqo keena ta qaala siya;</para>
  <para style="q2" vid="PSA 119:149">ne woga mala tana</para>
  <para style="q2" vid="PSA 119:149">shemppora paxa woththa.<verse eid="PSA 119:149" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150" />Gene qoppizayti taakko shiiqida;</para>
  <para style="q2" vid="PSA 119:150">heytikka ne wogappe</para>
  <para style="q2" vid="PSA 119:150">haakki dizayta.<verse eid="PSA 119:150" /></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 119:151">Neni gidikko ta matan daasa;</para>
  <para style="q2" vid="PSA 119:151">ne azazoti ubbayka tuma.<verse eid="PSA 119:151" /></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152" />Ne istta mernaas</para>
  <para style="q2" vid="PSA 119:152">minththa essadasa;</para>
  <para style="q2" vid="PSA 119:152">hessa tani benippe doommada</para>
  <para style="q2" vid="PSA 119:152">ne wogappe tamaaradis.<verse eid="PSA 119:152" /></para>
  <para style="qa">Rees</para>
  <para style="b" />
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153" />Ta tuggaa beyada tana ashsha;</para>
  <para style="q2" vid="PSA 119:153">ays giikko tani ne woga</para>
  <para style="q2" vid="PSA 119:153">dogabeekke.<verse eid="PSA 119:153" /></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154" />Ne ta gishshas mootettada</para>
  <para style="q2" vid="PSA 119:154">tana wozza;</para>
  <para style="q2" vid="PSA 119:154">ne gida qaala mala</para>
  <para style="q2" vid="PSA 119:154">tana shemppora paxa woththa.<verse eid="PSA 119:154" /></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155" />Iitati ne woga koyontta gishshas</para>
  <para style="q2" vid="PSA 119:155">isttas atoteththi deenna.<verse eid="PSA 119:155" /></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156" />Abeet GODAWU! Ne qadhetay daro;</para>
  <para style="q2" vid="PSA 119:156">ne qaala mala</para>
  <para style="q2" vid="PSA 119:156">tana shemppora paxa woththa.<verse eid="PSA 119:156" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157" />Ta morkketinne</para>
  <para style="q2" vid="PSA 119:157">tana yedeththizayti daro;</para>
  <para style="q2" vid="PSA 119:157">gido attiin tani</para>
  <para style="q2" vid="PSA 119:157">ne yootida qaalaappe</para>
  <para style="q2" vid="PSA 119:157">sher7i gabeekke.<verse eid="PSA 119:157" /></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158" />Ne azazota naagontta gishshas</para>
  <para style="q2" vid="PSA 119:158">ta ammanettonttayta</para>
  <para style="q2" vid="PSA 119:158">beyada shaatettadis.<verse eid="PSA 119:158" /></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 119:159">Tani ne woga dosizaakko be7a;</para>
  <para style="q2" vid="PSA 119:159">ne siiqo mala</para>
  <para style="q2" vid="PSA 119:159">tana shemppora paxa woththa.<verse eid="PSA 119:159" /></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160" />Ne qaala ubbay tuma;</para>
  <para style="q2" vid="PSA 119:160">ne xilloteththa wogay mernaassa.<verse eid="PSA 119:160" /></para>
  <para style="qa">Saan</para>
  <para style="b" />
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161" />Dere haarizayti</para>
  <para style="q2" vid="PSA 119:161">tana coo yedeththida;</para>
  <para style="q2" vid="PSA 119:161">gido attiin ta wozinay</para>
  <para style="q2" vid="PSA 119:161">ne qaalas yayyees.<verse eid="PSA 119:161" /></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162" />Daro miish di7ida asi</para>
  <para style="q2" vid="PSA 119:162">ufayettiza mala</para>
  <para style="q2" vid="PSA 119:162">neni gida qaalan tani ufayettays.<verse eid="PSA 119:162" /></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163" />Tani wordo ixxayssinne shaatettays;</para>
  <para style="q2" vid="PSA 119:163">gido attiin ne woga siiqays.<verse eid="PSA 119:163" /></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164" />Ne xillo pirda gishshas</para>
  <para style="q2" vid="PSA 119:164">tani nena gallassan</para>
  <para style="q2" vid="PSA 119:164">laappunto galatays.<verse eid="PSA 119:164" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165" />Ne woga siiqizaytas</para>
  <para style="q2" vid="PSA 119:165">daro saroteththi dees;</para>
  <para style="q2" vid="PSA 119:165">istta dhuphiza miishshi deenna.<verse eid="PSA 119:165" /></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 119:166">Tani ne atoteththaa</para>
  <para style="q2" vid="PSA 119:166">ufayssan naagays;</para>
  <para style="q2" vid="PSA 119:166">ne azazotakka polays.<verse eid="PSA 119:166" /></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167" />Tani ne yootida qaala naagays;</para>
  <para style="q2" vid="PSA 119:167">ta iza daro siiqays.<verse eid="PSA 119:167" /></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168" />Tani ne wogassinne</para>
  <para style="q2" vid="PSA 119:168">ne yootida qaalas azazettana;</para>
  <para style="q2" vid="PSA 119:168">ta oge ubbay ne sinththan qoncce.<verse eid="PSA 119:168" /></para>
  <para style="qa">Taaw</para>
  <para style="b" />
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 119:169">Ta waasoy neekko gakko;</para>
  <para style="q2" vid="PSA 119:169">neni gida qaala mala</para>
  <para style="q2" vid="PSA 119:169">taas akeeka imma.<verse eid="PSA 119:169" /></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170" />Ta shoobeththi pude ne sinth gakko;</para>
  <para style="q2" vid="PSA 119:170">neni gida qaala mala</para>
  <para style="q2" vid="PSA 119:170">tana ashsha.<verse eid="PSA 119:170" /></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171" />Ne awajjata tana tamaarsadasa;</para>
  <para style="q2" vid="PSA 119:171">hessa gishshas ta metershatappe</para>
  <para style="q2" vid="PSA 119:171">galatay pulttees.<verse eid="PSA 119:171" /></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172" />Ne azazoti ubbay xillo;</para>
  <para style="q2" vid="PSA 119:172">hessa gishshas ta doonay</para>
  <para style="q2" vid="PSA 119:172">ne qaala yexxo.<verse eid="PSA 119:172" /></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173" />Tani ne azazota dooradis;</para>
  <para style="q2" vid="PSA 119:173">hessa gishshas ne kushey</para>
  <para style="q2" vid="PSA 119:173">tana maaddanaas giigi utto.<verse eid="PSA 119:173" /></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 119:174">Ne atoteththa ta laamotays;</para>
  <para style="q2" vid="PSA 119:174">ne wogay tana ufayssees.<verse eid="PSA 119:174" /></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175" />Tani nena galatana mala</para>
  <para style="q2" vid="PSA 119:175">tana shemppora paxa woththa;</para>
  <para style="q2" vid="PSA 119:175">ne wogay taas maado gido.<verse eid="PSA 119:175" /></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176" />Dhayda dorsa mala</para>
  <para style="q2" vid="PSA 119:176">tani toylattadis;</para>
  <para style="q2" vid="PSA 119:176">gido attiin tani ne woga</para>
  <para style="q2" vid="PSA 119:176">balabeekke;</para>
  <para style="q2" vid="PSA 119:176">hessa gishshas tana</para>
  <para style="q2" vid="PSA 119:176">ne aylleza koya.<verse eid="PSA 119:176" /></para>
  <chapter eid="PSA 119" />
  <chapter number="120" style="c" sid="PSA 120" />
  <para style="s1">Pude Kezishe Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1" />Tani metotida wode GODAA xeygadis;</para>
  <para style="q2" vid="PSA 120:1">izikka taas koyides.<note caller="+" style="f"><char style="fr" closed="false">120:1 </char><char style="ft" closed="false">Pude kezishe yexxida mazamure gizayssi Ibraawe deren asay Yerusalaame bishe yexxiza mazamure bessees.</char></note><verse eid="PSA 120:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 120:2">Wordotiza metershatappenne</para>
  <para style="q2" vid="PSA 120:2">cimmiza inxarsatappe</para>
  <para style="q2" vid="PSA 120:2">tana ashsha.<verse eid="PSA 120:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3" />Intteno wordanchchatoo!</para>
  <para style="q2" vid="PSA 120:3">Izi inttena wosttanee?</para>
  <para style="q2" vid="PSA 120:3">hessafe hara intte bolla</para>
  <para style="q2" vid="PSA 120:3">ay ooththanee?<verse eid="PSA 120:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4" />Izi inttena hoxe tooran caddana;</para>
  <para style="q2" vid="PSA 120:4">izi inttena</para>
  <para style="q2" vid="PSA 120:4">bonqo taman xuuggana.<verse eid="PSA 120:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5" />Ta Mesheeke deraa giddon days;</para>
  <para style="q2" vid="PSA 120:5">Qeedaare dunkaanenkka</para>
  <para style="q2" vid="PSA 120:5">uttida gishshas</para>
  <para style="q2" vid="PSA 120:5">taas aayye ana!<verse eid="PSA 120:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6" />Saroteth ixxiza asatara</para>
  <para style="q2" vid="PSA 120:6">tani daro wode de7adis.<verse eid="PSA 120:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7" />Tani saro koyays;</para>
  <para style="q2" vid="PSA 120:7">gido attiin tani saro</para>
  <para style="q2" vid="PSA 120:7">haasayza wode</para>
  <para style="q2" vid="PSA 120:7">istti oosh koyeettes.<verse eid="PSA 120:7" /></para>
  <chapter eid="PSA 120" />
  <chapter number="121" style="c" sid="PSA 121" />
  <para style="s1">Pude Kezishe Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1" />Tani, «Maadoy taas</para>
  <para style="q2" vid="PSA 121:1">awappe yaandeeshaa?» gaada</para>
  <para style="q2" vid="PSA 121:1">ta ayfeta</para>
  <para style="q2" vid="PSA 121:1">pude zumatakko denththadis.<verse eid="PSA 121:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2" />Taas maadoy salonne</para>
  <para style="q2" vid="PSA 121:2">sa7a medhdhida</para>
  <para style="q2" vid="PSA 121:2">GODAAPPE yees.<verse eid="PSA 121:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3" />Izi ne toho hallixissenna;</para>
  <para style="q2" vid="PSA 121:3">nena naagizayssi dhiskenna.<verse eid="PSA 121:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4" />Isra7eele naagizayssi</para>
  <para style="q2" vid="PSA 121:4">mulekka ichchennanne</para>
  <para style="q2" vid="PSA 121:4">dhiskenna.<verse eid="PSA 121:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5" />GODAY nena naagizayssa;</para>
  <para style="q2" vid="PSA 121:5">GODAY nees ushachcha baggara</para>
  <para style="q2" vid="PSA 121:5">kuwa gidana.<verse eid="PSA 121:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6" />Gallassa away nena xuuggenna;</para>
  <para style="q2" vid="PSA 121:6">omarsa aginaykka nena qohenna.<verse eid="PSA 121:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7" />GODAY iita ubbaafe</para>
  <para style="q2" vid="PSA 121:7">nena naagana;</para>
  <para style="q2" vid="PSA 121:7">ne shemppo heemmana.<verse eid="PSA 121:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8" />GODAY ne buussaanne yuussaa</para>
  <para style="q2" vid="PSA 121:8">hachchife mernaa</para>
  <para style="q2" vid="PSA 121:8">gakkanaas naagana.<verse eid="PSA 121:8" /></para>
  <chapter eid="PSA 121" />
  <chapter number="122" style="c" sid="PSA 122" />
  <para style="s1">Dawiti Pude Kezishe Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1" />Istti tana,</para>
  <para style="q2" vid="PSA 122:1">«Ane GODAA Keeth boos» giin</para>
  <para style="q2" vid="PSA 122:1">tani ufayettadis.<verse eid="PSA 122:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2" />Hanne Yerusalaame katamayee!</para>
  <para style="q2" vid="PSA 122:2">Nuni ne pengetara gelidi eqqidos.<verse eid="PSA 122:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3" />Yerusalaame katamaya</para>
  <para style="q2" vid="PSA 122:3">danxxetta keexettida</para>
  <para style="q2" vid="PSA 122:3">mino katama.<verse eid="PSA 122:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4" />Isra7eeles imettida woga mala</para>
  <para style="q2" vid="PSA 122:4">Isra7eele qommoti</para>
  <para style="q2" vid="PSA 122:4">GODAA sunth galatanaas</para>
  <para style="q2" vid="PSA 122:4">hee baana.<verse eid="PSA 122:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5" />Dawite zereththafe kawotidayti</para>
  <para style="q2" vid="PSA 122:5">pirdanaas heen uttida.<verse eid="PSA 122:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6" />Yerusalaame saroteththas,</para>
  <para style="q2" vid="PSA 122:6">«Nena dosizayti ubbay</para>
  <para style="q2" vid="PSA 122:6">ishalon detto;<verse eid="PSA 122:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7" />Ne gimbeta giddon saroy de7o!</para>
  <para style="q2" vid="PSA 122:7">Ne kawoteththa keeththan woppay kumo»</para>
  <para style="q2" vid="PSA 122:7">gi woossite;<verse eid="PSA 122:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8" />Ta dabbota gishshassinne</para>
  <para style="q2" vid="PSA 122:8">laggeta gishshas</para>
  <para style="q2" vid="PSA 122:8">«Ne giddon saroy do!» gays.<verse eid="PSA 122:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9" />GODAA nu Xoossa Keeththa</para>
  <para style="q2" vid="PSA 122:9">gishshas gaada</para>
  <para style="q2" vid="PSA 122:9">tani nees lo7o amo amottana.<verse eid="PSA 122:9" /></para>
  <chapter eid="PSA 122" />
  <chapter number="123" style="c" sid="PSA 123" />
  <para style="s1">Pude Kezishe Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1" />Nenoo salo araatan uttidayssoo!</para>
  <para style="q2" vid="PSA 123:1">Tani neekko pude xeellays.<verse eid="PSA 123:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2" />Ashkaray ba godaa</para>
  <para style="q2" vid="PSA 123:2">kushe xeelliza mala,</para>
  <para style="q2" vid="PSA 123:2">ashkarayakka ba godattey kushe</para>
  <para style="q2" vid="PSA 123:2">xeelliza mala,</para>
  <para style="q2" vid="PSA 123:2">nunikka izi nuna</para>
  <para style="q2" vid="PSA 123:2">maarana gakkanaas</para>
  <para style="q2" vid="PSA 123:2">nu GODAAKKO pude xeelloos.<verse eid="PSA 123:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 123:3">Nu bolla kadhey darida gishshas</para>
  <para style="q2" vid="PSA 123:3">maararkkii!</para>
  <para style="q2" vid="PSA 123:3">Nuna maara.<verse eid="PSA 123:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4" />Ceeqettizaytappe daro cashshi</para>
  <para style="q2" vid="PSA 123:4">otoranchchatappe daro kadhey</para>
  <para style="q2" vid="PSA 123:4">nuna gakkides.<verse eid="PSA 123:4" /></para>
  <chapter eid="PSA 123" />
  <chapter number="124" style="c" sid="PSA 124" />
  <para style="s1">Dawiti Pude Kezishe Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1" />Isra7eeley,</para>
  <para style="q2" vid="PSA 124:1">«GODAY nunara donttaakko</para>
  <para style="q2" vid="PSA 124:1">nu waananee?<verse eid="PSA 124:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2" />Nu morkketi nu bolla dendida wode</para>
  <para style="q2" vid="PSA 124:2">GODAY nunara bayndaako,<verse eid="PSA 124:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 124:3" />istta hanqoy nu bolla</para>
  <para style="q2" vid="PSA 124:3">tama mala eexxida wode</para>
  <para style="q2" vid="PSA 124:3">istti nuna paxa mittanashin.<verse eid="PSA 124:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4" />Haaththi nuna ekki baanashin;</para>
  <para style="q2" vid="PSA 124:4">di7oy nuna mittanashin.<verse eid="PSA 124:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5" />Kixa haaththi nuna</para>
  <para style="q2" vid="PSA 124:5">maanashin» getto.<verse eid="PSA 124:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6" />Nuna nu morkketa achchan</para>
  <para style="q2" vid="PSA 124:6">puuzisontta ashshida</para>
  <para style="q2" vid="PSA 124:6">GODAY galatetto.<verse eid="PSA 124:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7" />Nuni shankkanchchata narxafe</para>
  <para style="q2" vid="PSA 124:7">kafoy kessi ekkiza mala</para>
  <para style="q2" vid="PSA 124:7">kessi ekkidos;</para>
  <para style="q2" vid="PSA 124:7">Yardey duuxxides</para>
  <para style="q2" vid="PSA 124:7">nunikka kessi ekkidi attidos.<verse eid="PSA 124:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8" />Salonne sa7a medhdhida</para>
  <para style="q2" vid="PSA 124:8">GODAA sunththan</para>
  <para style="q2" vid="PSA 124:8">nuus maadoy yees.<verse eid="PSA 124:8" /></para>
  <chapter eid="PSA 124" />
  <chapter number="125" style="c" sid="PSA 125" />
  <para style="s1">Pude Kezishe Yexxida Mazmure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1" />GODAAN ammanettizayti</para>
  <para style="q2" vid="PSA 125:1">mernaas qaaxxontta diza</para>
  <para style="q2" vid="PSA 125:1">Xiyoone Zuma mala.<verse eid="PSA 125:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2" />Zumati Yerusalaame katama</para>
  <para style="q2" vid="PSA 125:2">yuushon diza mala</para>
  <para style="q2" vid="PSA 125:2">hachchife mernaa gakkanaas</para>
  <para style="q2" vid="PSA 125:2">GODAY ba deraa yuushon dees.<verse eid="PSA 125:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3" />Xilloti iitateth tamaarontta mala</para>
  <para style="q2" vid="PSA 125:3">iitati haarishe</para>
  <para style="q2" vid="PSA 125:3">xillota biittan gam7ettenna.<verse eid="PSA 125:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4" />Abeet GODAWU! Lo7o asatassinne</para>
  <para style="q2" vid="PSA 125:4">wozina suure asatas</para>
  <para style="q2" vid="PSA 125:4">ne lo7o ooththa.<verse eid="PSA 125:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5" />Gido attiin kase</para>
  <para style="q2" vid="PSA 125:5">ba geella oge simmizayta</para>
  <para style="q2" vid="PSA 125:5">neni iita ooththizaytara</para>
  <para style="q2" vid="PSA 125:5">issife gaththa qaxxaya;</para>
  <para style="b" vid="PSA 125:5" />
  <para style="q2" vid="PSA 125:5">Isra7eeles saroy gido!<verse eid="PSA 125:5" /></para>
  <chapter eid="PSA 125" />
  <chapter number="126" style="c" sid="PSA 126" />
  <para style="s1">Pude Kezishe Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1" />GODAY nuna di7ettidayta</para>
  <para style="q2" vid="PSA 126:1">zaaridi Xiyoone ehida wode</para>
  <para style="q2" vid="PSA 126:1">nuus agumo misatides.<verse eid="PSA 126:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2" />He wode nu doonay</para>
  <para style="q2" vid="PSA 126:2">miichchan kumides;</para>
  <para style="q2" vid="PSA 126:2">nu inxarsika</para>
  <para style="q2" vid="PSA 126:2">ufayssa mazamure yexxides;</para>
  <para style="q2" vid="PSA 126:2">histtiin kawoteththati bantta giddon,</para>
  <para style="q2" vid="PSA 126:2">«GODAY isttas</para>
  <para style="q2" vid="PSA 126:2">gita miish ooththides» gida.<verse eid="PSA 126:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3" />Tumukka GODAY</para>
  <para style="q2" vid="PSA 126:3">nuus gita miish ooththides;</para>
  <para style="q2" vid="PSA 126:3">nunikka keehi ufayettidos.<verse eid="PSA 126:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 126:4">Negebe Bazzon ira bukisada</para>
  <para style="q2" vid="PSA 126:4">shaafa haaththan</para>
  <para style="q2" vid="PSA 126:4">kunththiza mala</para>
  <para style="q2" vid="PSA 126:4">nu duussa ooraththa.<verse eid="PSA 126:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5" />Yeekkishe zeridayti</para>
  <para style="q2" vid="PSA 126:5">ufayssan yexxishe shiishshana.<verse eid="PSA 126:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6" />Zereth tookkidi yeekkishe bidayti</para>
  <para style="q2" vid="PSA 126:6">mirqqeta tookkidi</para>
  <para style="q2" vid="PSA 126:6">ufayssan yexxishe simmana.<verse eid="PSA 126:6" /></para>
  <chapter eid="PSA 126" />
  <chapter number="127" style="c" sid="PSA 127" />
  <para style="s1">Solomooney Pude Kezishe Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1" />GODAY keeth keexxontta</para>
  <para style="q2" vid="PSA 127:1">aggiko keexxizayti</para>
  <para style="q2" vid="PSA 127:1">coo mela daabureettes;</para>
  <para style="q2" vid="PSA 127:1">GODAY katama naagontta aggiko</para>
  <para style="q2" vid="PSA 127:1">naagizayti coo mela dafetteettes.<verse eid="PSA 127:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2" />Neni aqota demmanaas</para>
  <para style="q2" vid="PSA 127:2">maalado wonttara</para>
  <para style="q2" vid="PSA 127:2">denda woxxikonne</para>
  <para style="q2" vid="PSA 127:2">giddoth gakkanaas ne daaburkko</para>
  <para style="q2" vid="PSA 127:2">hessi wurikka hada;</para>
  <para style="q2" vid="PSA 127:2">GODAY ba siiqizaytas</para>
  <para style="q2" vid="PSA 127:2">shemppo immees.<verse eid="PSA 127:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3" />Nayti GODAAPPE imettiza imotata;</para>
  <para style="q2" vid="PSA 127:3">naytikka tumappe iza woyto.<verse eid="PSA 127:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4" />Asi naateththan dishe</para>
  <para style="q2" vid="PSA 127:4">yeliza attuma nayti</para>
  <para style="q2" vid="PSA 127:4">olanchcha kushen diza</para>
  <para style="q2" vid="PSA 127:4">yiishsha mala.<verse eid="PSA 127:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5" />Iza kohoti he yiishshatan</para>
  <para style="q2" vid="PSA 127:5">kumiday anjjettidaade.</para>
  <para style="q2" vid="PSA 127:5">Izi katama pengen ba morkketara</para>
  <para style="q2" vid="PSA 127:5">marshettiza wode shatumettenna.<verse eid="PSA 127:5" /></para>
  <chapter eid="PSA 127" />
  <chapter number="128" style="c" sid="PSA 128" />
  <para style="s1">Pude Kezishe Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1" />GODAAS yayyizaytinne</para>
  <para style="q2" vid="PSA 128:1">iza ogen hemettizayti</para>
  <para style="q2" vid="PSA 128:1">ubbay anjjettidayta.<verse eid="PSA 128:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2" />Neni ne daabura ayfe maana;</para>
  <para style="q2" vid="PSA 128:2">ne anjjettananne nees injjetana.<verse eid="PSA 128:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3" />Ne machchiya neson ayfiza</para>
  <para style="q2" vid="PSA 128:3">woyne mala gidana;</para>
  <para style="q2" vid="PSA 128:3">ne naytikka ne maadda yuushon</para>
  <para style="q2" vid="PSA 128:3">wogara puute mala gidana.<verse eid="PSA 128:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4" />GODAAS yayyiza asi</para>
  <para style="q2" vid="PSA 128:4">hessaththo anjjettana.<verse eid="PSA 128:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5" />GODAY nena Xiyooneppe anjjo!</para>
  <para style="q2" vid="PSA 128:5">Neni de7ida layth ubbaan</para>
  <para style="q2" vid="PSA 128:5">Izi nena</para>
  <para style="q2" vid="PSA 128:5">Yerusalaame lo7eteth besso!<verse eid="PSA 128:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6" />Izi nena nayta nayta gaththi besso!</para>
  <para style="b" vid="PSA 128:6" />
  <para style="q2" vid="PSA 128:6">Isra7eeles saroy gido!<verse eid="PSA 128:6" /></para>
  <chapter eid="PSA 128" />
  <chapter number="129" style="c" sid="PSA 129" />
  <para style="s1">Pude Kezishe Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1" />Isra7eele asay,</para>
  <para style="q2" vid="PSA 129:1">«Morkketi tana</para>
  <para style="q2" vid="PSA 129:1">yelagateththafe doommidi</para>
  <para style="q2" vid="PSA 129:1">daro wode un7eththida.<verse eid="PSA 129:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2" />Tumappe istti tana</para>
  <para style="q2" vid="PSA 129:2">yelagateththafe doommidi</para>
  <para style="q2" vid="PSA 129:2">daro wode un7eththida;</para>
  <para style="q2" vid="PSA 129:2">gido attiin istti</para>
  <para style="q2" vid="PSA 129:2">tana xoonibeettenna.<verse eid="PSA 129:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3" />Ta zokko xurqafen shoci shocidi</para>
  <para style="q2" vid="PSA 129:3">worxafettida gade misatissida» go.<verse eid="PSA 129:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4" />Gido attiin GODAY xillo;</para>
  <para style="q2" vid="PSA 129:4">iitata wodoro duusereththidi</para>
  <para style="q2" vid="PSA 129:4">tana birshi yeddides.<verse eid="PSA 129:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5" />Xiyoone ixxiza ubbay</para>
  <para style="q2" vid="PSA 129:5">yeellatidi guye simmo!<verse eid="PSA 129:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6" />Keeththa kaara bolla mokkidi</para>
  <para style="q2" vid="PSA 129:6">heerakka meliza maata mala gido!<verse eid="PSA 129:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7" />Hessi buucizaytas</para>
  <para style="q2" vid="PSA 129:7">kushe kumontta maata mala</para>
  <para style="q2" vid="PSA 129:7">woykko mirqqizaytaskka</para>
  <para style="q2" vid="PSA 129:7">danke kumontta kaththa mala.<verse eid="PSA 129:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8" />He ogera aadhdhizayti,</para>
  <para style="q2" vid="PSA 129:8">«Xoossi wolqqa immo»</para>
  <para style="q2" vid="PSA 129:8">buucizaytikka,</para>
  <para style="q2" vid="PSA 129:8">«Xoossi anjjo» gooppetto.<verse eid="PSA 129:8" /></para>
  <chapter eid="PSA 129" />
  <chapter number="130" style="c" sid="PSA 130" />
  <para style="s1">Pude Kezishe Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 130:1">Tani ciimma</para>
  <para style="q2" vid="PSA 130:1">meto giddon dashe</para>
  <para style="q2" vid="PSA 130:1">neekko waassays.<verse eid="PSA 130:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 130:2" />Abeet Godawu!</para>
  <para style="q2" vid="PSA 130:2">Ta cenggurssa siya;</para>
  <para style="q2" vid="PSA 130:2">tani shoobbizayssa</para>
  <para style="q2" vid="PSA 130:2">ne hayththati ezgetto.<verse eid="PSA 130:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 130:3">Neni nu nagara</para>
  <para style="q2" vid="PSA 130:3">kaaletta kaaletta mazgabidaakko</para>
  <para style="q2" vid="PSA 130:3">abeet Godawu oonee ne sinththan</para>
  <para style="q2" vid="PSA 130:3">eqqi dandayanee?<verse eid="PSA 130:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4" />Gido attiin nuni</para>
  <para style="q2" vid="PSA 130:4">nena bonchchana mala</para>
  <para style="q2" vid="PSA 130:4">neni nu nagara atto gaasa.<verse eid="PSA 130:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5" />Tani GODAA laamotan naagays;</para>
  <para style="q2" vid="PSA 130:5">ta shemppoya</para>
  <para style="q2" vid="PSA 130:5">dandayan naagawus;</para>
  <para style="q2" vid="PSA 130:5">iza qaalaakka hidota ooththawus.<verse eid="PSA 130:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6" />Zabeti sa7ay awude wonttaneesha</para>
  <para style="q2" vid="PSA 130:6">giidi naagizayssafekka bolla</para>
  <para style="q2" vid="PSA 130:6">tani Goda laamotan naagays.<verse eid="PSA 130:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7" />GODAA achchan siiqoynne</para>
  <para style="q2" vid="PSA 130:7">maaroteththi diza gishshas</para>
  <para style="q2" vid="PSA 130:7">Isra7eele asawu!</para>
  <para style="q2" vid="PSA 130:7">GODAAN hidota ooththite.<verse eid="PSA 130:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8" />Izi Isra7eele asaa</para>
  <para style="q2" vid="PSA 130:8">istta nagara ubbaafe ashshana.<note caller="-" style="x"><char style="xo" closed="false">130:8 </char><char style="xt" closed="false"><ref loc="MAT 1:21">Mato 1:21</ref>; <ref loc="TIT 2:14">Tito 2:14</ref></char></note><verse eid="PSA 130:8" /></para>
  <chapter eid="PSA 130" />
  <chapter number="131" style="c" sid="PSA 131" />
  <para style="s1">Dawiti Pude Kezishe Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 131:1">Ta wozinay otorettibeenna;</para>
  <para style="q2" vid="PSA 131:1">tani otoron xeella erikke;</para>
  <para style="q2" vid="PSA 131:1">ta qofan bessontta</para>
  <para style="q2" vid="PSA 131:1">gitateththas amottabeekke;</para>
  <para style="q2" vid="PSA 131:1">ta wolqqafe bollara</para>
  <para style="q2" vid="PSA 131:1">zaradhdhabeekke.<verse eid="PSA 131:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2" />Dhanth duuxxida nay</para>
  <para style="q2" vid="PSA 131:2">ba aayi ki7on</para>
  <para style="q2" vid="PSA 131:2">co7u gi uttiza mala,</para>
  <para style="q2" vid="PSA 131:2">ta shemppoya</para>
  <para style="q2" vid="PSA 131:2">ta giddon co7unne</para>
  <para style="q2" vid="PSA 131:2">woppu gadus.<verse eid="PSA 131:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3" />Isra7eele asawu!</para>
  <para style="q2" vid="PSA 131:3">Hachchife doommidi</para>
  <para style="q2" vid="PSA 131:3">mernaa gakkanaas GODAAN</para>
  <para style="q2" vid="PSA 131:3">hidota ooththite.<verse eid="PSA 131:3" /></para>
  <chapter eid="PSA 131" />
  <chapter number="132" style="c" sid="PSA 132" />
  <para style="s1">Pude Kezishe Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 132:1">Dawitenne izi dandayda</para>
  <para style="q2" vid="PSA 132:1">metoza ubbaa ne qoppa.<verse eid="PSA 132:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2" />GODAWU! Izi nees caaqqida qaala,</para>
  <para style="q2" vid="PSA 132:2">wolqqama Yaaqoobe Xoossaska</para>
  <para style="q2" vid="PSA 132:2">adinettida adinaa qoppa.<verse eid="PSA 132:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3" />Izikka, «Hayssafe sinththan</para>
  <para style="q2" vid="PSA 132:3">tani taso gelikke;</para>
  <para style="q2" vid="PSA 132:3">ta hiixankka kezikke;<verse eid="PSA 132:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 132:4" />dhiskoka dhiskike;</para>
  <para style="q2" vid="PSA 132:4">ta ayfetakka liiphikke.<verse eid="PSA 132:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 132:5" />Hessika tani GODAAS duussaso,</para>
  <para style="q2" vid="PSA 132:5">wolqqama Yaaqoobe Xoossas</para>
  <para style="q2" vid="PSA 132:5">aqoso giigsana</para>
  <para style="q2" vid="PSA 132:5">gakkanaassa» gides.<verse eid="PSA 132:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6" />Hekko nuni Taabotaza gishshas</para>
  <para style="q2" vid="PSA 132:6">Efraatan dishe siyidos;</para>
  <para style="q2" vid="PSA 132:6">Qiriyaate-Yi7aarime biittan</para>
  <para style="q2" vid="PSA 132:6">iza demmidos.<verse eid="PSA 132:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7" />Nuni, «Ane izi dizaso boos;</para>
  <para style="q2" vid="PSA 132:7">iza tohoy yedhdhizason</para>
  <para style="q2" vid="PSA 132:7">gufannidi izas goynnoos.<verse eid="PSA 132:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8" />«Abeet GODAWU! Denda!</para>
  <para style="q2" vid="PSA 132:8">Ne minoteththas</para>
  <para style="q2" vid="PSA 132:8">malata gidida Taabotaara</para>
  <para style="q2" vid="PSA 132:8">ne Keeth gelada shempa.<verse eid="PSA 132:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9" />Ne qeeseti xilloteth may7etto;</para>
  <para style="q2" vid="PSA 132:9">geesh gidida</para>
  <para style="q2" vid="PSA 132:9">ne asati ililetto» gidos.<verse eid="PSA 132:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10" />Ne aylle Dawite gishshas gaada</para>
  <para style="q2" vid="PSA 132:10">neni tiydayssa yeggofa.<note caller="-" style="x"><char style="xo" closed="false">132:6-10 </char><char style="xt" closed="false"><ref loc="2CH 6:41-42">2Taari 6:41-42</ref></char></note><verse eid="PSA 132:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11" />GODAY Dawites</para>
  <para style="q2" vid="PSA 132:11">qanththafe caaqqides;</para>
  <para style="q2" vid="PSA 132:11">laamettontta qaalan,</para>
  <para style="q2" vid="PSA 132:11">«Ne naytappe issaa tani</para>
  <para style="q2" vid="PSA 132:11">ne araatan utissana.<note caller="-" style="x"><char style="xo" closed="false">132:11 </char><char style="xt" closed="false"><ref loc="2SA 7:12-16">2Same 7:12-16</ref>; <ref loc="1CH 17:11-14">1Taari 17:11-14</ref>; <ref loc="PSA 89:3-4">Maza 89:3-4</ref>; <ref loc="ACT 2:30">Hawa 2:30</ref></char></note><verse eid="PSA 132:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12" />Ne nayti ta caaqo qaalanne</para>
  <para style="q2" vid="PSA 132:12">tani tamaarsida qaala</para>
  <para style="q2" vid="PSA 132:12">istti naagikko</para>
  <para style="q2" vid="PSA 132:12">istta naytikka</para>
  <para style="q2" vid="PSA 132:12">ne kawoteththa araatan</para>
  <para style="q2" vid="PSA 132:12">mernaas uttana» gi caaqqides.<verse eid="PSA 132:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13" />GODAY Xiyoono doorides;</para>
  <para style="q2" vid="PSA 132:13">baas de7izaso</para>
  <para style="q2" vid="PSA 132:13">ooththanaas amottidi,<verse eid="PSA 132:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14" />«Hanna taas mernaas</para>
  <para style="q2" vid="PSA 132:14">shempposo gidana;</para>
  <para style="q2" vid="PSA 132:14">tani izo dosida gishshas</para>
  <para style="q2" vid="PSA 132:14">izin de7ana.<verse eid="PSA 132:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15" />Tani izo keeha anjjana;</para>
  <para style="q2" vid="PSA 132:15">izin de7iza manqotakka</para>
  <para style="q2" vid="PSA 132:15">kath kalssana.<verse eid="PSA 132:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16" />Tani izin diza qeeseta</para>
  <para style="q2" vid="PSA 132:16">atoteth mayzana;</para>
  <para style="q2" vid="PSA 132:16">izin de7iza Xoossa asatikka</para>
  <para style="q2" vid="PSA 132:16">ufayssan yexxana.<verse eid="PSA 132:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17" />«Ha sohon Dawite zereththafe</para>
  <para style="q2" vid="PSA 132:17">kawo kessana;</para>
  <para style="q2" vid="PSA 132:17">tani tiydayssas poo7o giigsana.<note caller="-" style="x"><char style="xo" closed="false">132:17 </char><char style="xt" closed="false"><ref loc="1KI 11:36">1Kawo 11:36</ref></char></note><verse eid="PSA 132:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18" />Tani iza morkketa yeellachchana;</para>
  <para style="q2" vid="PSA 132:18">gido attiin iza hu7aan de7iza</para>
  <para style="q2" vid="PSA 132:18">kawoteththa kallachchay</para>
  <para style="q2" vid="PSA 132:18">phoollana» gides.<verse eid="PSA 132:18" /></para>
  <chapter eid="PSA 132" />
  <chapter number="133" style="c" sid="PSA 133" />
  <para style="s1">Dawiti Pude Kezishe Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1" />Ishantti issifeteththan de7izayssi</para>
  <para style="q2" vid="PSA 133:1">ay mala lo7onne</para>
  <para style="q2" vid="PSA 133:1">ay mala ufayssizaazee!<verse eid="PSA 133:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2" />Hessi Aaroone hu7en tigiin</para>
  <para style="q2" vid="PSA 133:2">buuchchaara biidi</para>
  <para style="q2" vid="PSA 133:2">iza may7o</para>
  <para style="q2" vid="PSA 133:2">macara gakkanaas goggidi</para>
  <para style="q2" vid="PSA 133:2">sawo tunnu giza al7o zayte mala.<verse eid="PSA 133:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3" />Qasseka Hermoone zumatappe</para>
  <para style="q2" vid="PSA 133:3">duge Xiyoone Zumbullata bolla</para>
  <para style="q2" vid="PSA 133:3">xokkiza xaaza mala;</para>
  <para style="q2" vid="PSA 133:3">GODAY hessan anjjonne</para>
  <para style="q2" vid="PSA 133:3">de7o mernaas azazides.<verse eid="PSA 133:3" /></para>
  <chapter eid="PSA 133" />
  <chapter number="134" style="c" sid="PSA 134" />
  <para style="s1">Pude Kezishe Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1" />Intteno GODAA aylletoo!</para>
  <para style="q2" vid="PSA 134:1">GODAA Keeththan omars ooththizaytoo!</para>
  <para style="q2" vid="PSA 134:1">ubbayka haa yiidi</para>
  <para style="q2" vid="PSA 134:1">GODAA galatite.<verse eid="PSA 134:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2" />Xoossa Keeththan</para>
  <para style="q2" vid="PSA 134:2">intte kushe denththidi</para>
  <para style="q2" vid="PSA 134:2">GODAA galatite.<verse eid="PSA 134:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3" />Salonne sa7a medhdhida GODAY</para>
  <para style="q2" vid="PSA 134:3">inttena Xiyooneppe anjjo.<verse eid="PSA 134:3" /></para>
  <chapter eid="PSA 134" />
  <chapter number="135" style="c" sid="PSA 135" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1" />Intteno GODAA aylletoo!</para>
  <para style="q2" vid="PSA 135:1">Iza galatite!</para>
  <para style="q2" vid="PSA 135:1">GODAA sunththa sabbite!<verse eid="PSA 135:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2" />Intteno GODAA Keeththan</para>
  <para style="q2" vid="PSA 135:2">ooththizaytoo!</para>
  <para style="q2" vid="PSA 135:2">Intteno nu Xoossa Keeththa zagon</para>
  <para style="q2" vid="PSA 135:2">eqqidayto galatite!<verse eid="PSA 135:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3" />Izi kiya gidida gishshas</para>
  <para style="q2" vid="PSA 135:3">GODAA galatite!</para>
  <para style="q2" vid="PSA 135:3">Izi lo7o gidida gishshas</para>
  <para style="q2" vid="PSA 135:3">iza sunththaas yexxite!<verse eid="PSA 135:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4" />GODAY Yaaqoobe</para>
  <para style="q2" vid="PSA 135:4">baas buzo ooththides;</para>
  <para style="q2" vid="PSA 135:4">Isra7eelekka baas</para>
  <para style="q2" vid="PSA 135:4">al7o miish histti doorides.<verse eid="PSA 135:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5" />GODAY gita gididayssanne</para>
  <para style="q2" vid="PSA 135:5">nu GODAY xoossata ubbaafe</para>
  <para style="q2" vid="PSA 135:5">dhoqqizayssa tani erays.<verse eid="PSA 135:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6" />Saloninne sa7an,</para>
  <para style="q2" vid="PSA 135:6">abbataninne ciimmata</para>
  <para style="q2" vid="PSA 135:6">ubbaa giddonkka</para>
  <para style="q2" vid="PSA 135:6">GODAY ba dosidayssa</para>
  <para style="q2" vid="PSA 135:6">ubbaa ooththees.<verse eid="PSA 135:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7" />Kareththa shaara sa7a gaxappe</para>
  <para style="q2" vid="PSA 135:7">izi denththees;</para>
  <para style="q2" vid="PSA 135:7">izi irara wolqqanth kiittees;</para>
  <para style="q2" vid="PSA 135:7">ba minjji woththidasoppe</para>
  <para style="q2" vid="PSA 135:7">carko kessi yeddees.<verse eid="PSA 135:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8" />Gibxe biittan asappe biidi</para>
  <para style="q2" vid="PSA 135:8">mehe gakkanaas</para>
  <para style="q2" vid="PSA 135:8">bayra yelettida ubbaa wodhides.<verse eid="PSA 135:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9" />Nenoo Gibxe! Paaroone bollanne</para>
  <para style="q2" vid="PSA 135:9">iza oosanchchata bolla</para>
  <para style="q2" vid="PSA 135:9">ooraththinne malalisiza</para>
  <para style="q2" vid="PSA 135:9">miish yeddides.<verse eid="PSA 135:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10" />Izi daro kawoteththata dhayssides;</para>
  <para style="q2" vid="PSA 135:10">wolqqama kawotakka wodhides.<verse eid="PSA 135:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11" />Amooreta kawo Sihoone,</para>
  <para style="q2" vid="PSA 135:11">Baasaane kawo Aagenne</para>
  <para style="q2" vid="PSA 135:11">Kanaane kawota ubbaa wodhides.<verse eid="PSA 135:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12" />Istta biittaaka ba deraa</para>
  <para style="q2" vid="PSA 135:12">Isra7eele laatissides.<verse eid="PSA 135:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 135:13">Ne sunththi mernaas daana;</para>
  <para style="q2" vid="PSA 135:13">yeletappe yeleta gakkanaas</para>
  <para style="q2" vid="PSA 135:13">neni hassa7ettana.<verse eid="PSA 135:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14" />GODAY ba asaas pirdana;</para>
  <para style="q2" vid="PSA 135:14">izi ba aylletaskka qadhettana.<verse eid="PSA 135:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15" />Kawoteththati goynniza</para>
  <para style="q2" vid="PSA 135:15">eeqa xoossati</para>
  <para style="q2" vid="PSA 135:15">birappenne worqqafe</para>
  <para style="q2" vid="PSA 135:15">asa kushen oosettidayta.<verse eid="PSA 135:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16" />Isttas doonay dees shin</para>
  <para style="q2" vid="PSA 135:16">haasayettenna;</para>
  <para style="q2" vid="PSA 135:16">ayfey dees shin xeellettenna.<verse eid="PSA 135:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17" />Hayththi dees shin siyettenna;</para>
  <para style="q2" vid="PSA 135:17">istta siidhen peenoykka deenna.<verse eid="PSA 135:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18" />Istta medhdhidaytinne</para>
  <para style="q2" vid="PSA 135:18">isttan ammanettizayti ubbay</para>
  <para style="q2" vid="PSA 135:18">istta mala gidetto.<verse eid="PSA 135:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19" />Isra7eele derezoo!</para>
  <para style="q2" vid="PSA 135:19">GODAA galatite;</para>
  <para style="q2" vid="PSA 135:19">Aaroone keeththa asatoo!</para>
  <para style="q2" vid="PSA 135:19">GODAA sabbite;<verse eid="PSA 135:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20" />Lewe keeththa asatoo!</para>
  <para style="q2" vid="PSA 135:20">GODAA galatite;</para>
  <para style="q2" vid="PSA 135:20">GODAAS yayyizaytoo!</para>
  <para style="q2" vid="PSA 135:20">Ubbay GODAA galatite.<verse eid="PSA 135:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21" />Yerusalaamen de7iza GODAY</para>
  <para style="q2" vid="PSA 135:21">Xiyoonen galatetto!</para>
  <para style="b" vid="PSA 135:21" />
  <para style="q2" vid="PSA 135:21">GODAY galatetto!<verse eid="PSA 135:21" /></para>
  <chapter eid="PSA 135" />
  <chapter number="136" style="c" sid="PSA 136" />
  <para style="s1">Eedon Yexxida Galata Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1" />GODAA galatite! Izi kiya;</para>
  <para style="q2" vid="PSA 136:1">iza siiqoy mernaassa.<note caller="-" style="x"><char style="xo" closed="false">136:1 </char><char style="xt" closed="false"><ref loc="1CH 16:34">1Taari 16:34</ref>; <ref loc="2CH 5:13">2Taari 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>; <ref loc="EZR 3:11">Iz 3:11</ref>; <ref loc="PSA 100:5">Maza 100:5</ref>; <ref loc="PSA 106:1">106:1</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="JER 33:11">Er 33:11</ref></char></note><verse eid="PSA 136:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2" />Xoossata Xoossa galatite!</para>
  <para style="q2" vid="PSA 136:2">iza siiqoy mernaassa.<verse eid="PSA 136:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3" />GODAA galatite!</para>
  <para style="q2" vid="PSA 136:3">iza siiqoy mernaassa.<verse eid="PSA 136:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4" />Izi xalla gita malalisiza</para>
  <para style="q2" vid="PSA 136:4">miish ooththees;</para>
  <para style="q2" vid="PSA 136:4">iza siiqoy mernaassa.<verse eid="PSA 136:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5" />Ba hiillateththan</para>
  <para style="q2" vid="PSA 136:5">salota medhdhides;</para>
  <para style="q2" vid="PSA 136:5">iza siiqoy mernaassa.<note caller="-" style="x"><char style="xo" closed="false">136:5 </char><char style="xt" closed="false"><ref loc="GEN 1:1">Medhe 1:1</ref></char></note><verse eid="PSA 136:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6" />Biittaa haaththa bollan miccides;</para>
  <para style="q2" vid="PSA 136:6">iza siiqoy mernaassa.<note caller="-" style="x"><char style="xo" closed="false">136:6 </char><char style="xt" closed="false"><ref loc="GEN 1:2">Medhe 1:2</ref></char></note><verse eid="PSA 136:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7" />Gita poo7ota medhdhides;</para>
  <para style="q2" vid="PSA 136:7">iza siiqoy mernaassa.<verse eid="PSA 136:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8" />Arshey gallas</para>
  <para style="q2" vid="PSA 136:8">poo7ana mala ooththides;</para>
  <para style="q2" vid="PSA 136:8">iza siiqoy mernaassa.<verse eid="PSA 136:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9" />Aginaynne xoolintteti</para>
  <para style="q2" vid="PSA 136:9">omars poo7isana mala</para>
  <para style="q2" vid="PSA 136:9">ooththides;</para>
  <para style="q2" vid="PSA 136:9">iza siiqoy mernaassa.<note caller="-" style="x"><char style="xo" closed="false">136:7-9 </char><char style="xt" closed="false"><ref loc="GEN 1:16">Medhe 1:16</ref></char></note><verse eid="PSA 136:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10" />Izi Gibxe biittan</para>
  <para style="q2" vid="PSA 136:10">bayrata wodhides;</para>
  <para style="q2" vid="PSA 136:10">iza siiqoy mernaassa.<note caller="-" style="x"><char style="xo" closed="false">136:10 </char><char style="xt" closed="false"><ref loc="EXO 12:29">Kessa 12:29</ref></char></note><verse eid="PSA 136:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11" />Isra7eele asaa Gibxeppe</para>
  <para style="q2" vid="PSA 136:11">kaaleththi kessides;</para>
  <para style="q2" vid="PSA 136:11">iza siiqoy mernaassa.<note caller="-" style="x"><char style="xo" closed="false">136:11 </char><char style="xt" closed="false"><ref loc="EXO 12:51">Kessa 12:51</ref></char></note><verse eid="PSA 136:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12" />Ba mino kusheninne</para>
  <para style="q2" vid="PSA 136:12">ba wolqqama qesen</para>
  <para style="q2" vid="PSA 136:12">hayssa ooththides;</para>
  <para style="q2" vid="PSA 136:12">iza siiqoy mernaassa.<verse eid="PSA 136:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13" />Zo7o abba shaakki yeggides;</para>
  <para style="q2" vid="PSA 136:13">iza siiqoy mernaassa.<verse eid="PSA 136:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14" />Isra7eele asaa</para>
  <para style="q2" vid="PSA 136:14">he abba giddora pinththides;</para>
  <para style="q2" vid="PSA 136:14">iza siiqoy mernaassa.<verse eid="PSA 136:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15" />Gibxe kawonne iza olanchchata</para>
  <para style="q2" vid="PSA 136:15">Zo7o abban mitissides;</para>
  <para style="q2" vid="PSA 136:15">iza siiqoy mernaassa.<note caller="-" style="x"><char style="xo" closed="false">136:13-15 </char><char style="xt" closed="false"><ref loc="EXO 14:21-29">Kessa 14:21-29</ref></char></note><verse eid="PSA 136:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16" />Izi ba asaa bazzora kaaleththides;</para>
  <para style="q2" vid="PSA 136:16">iza siiqoy mernaassa.<verse eid="PSA 136:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17" />Gita kawota shocides;</para>
  <para style="q2" vid="PSA 136:17">iza siiqoy mernaassa.<verse eid="PSA 136:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18" />Wolqqama kawota wodhides;</para>
  <para style="q2" vid="PSA 136:18">iza siiqoy mernaassa.<verse eid="PSA 136:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19" />Amooreta kawoza</para>
  <para style="q2" vid="PSA 136:19">Sihoone wodhides;</para>
  <para style="q2" vid="PSA 136:19">iza siiqoy mernaassa.<note caller="-" style="x"><char style="xo" closed="false">136:19 </char><char style="xt" closed="false"><ref loc="NUM 21:21-30">Tay 21:21-30</ref></char></note><verse eid="PSA 136:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20" />Qasse Baasaane kawoza</para>
  <para style="q2" vid="PSA 136:20">Aage wodhides;</para>
  <para style="q2" vid="PSA 136:20">iza siiqoy mernaassa.<note caller="-" style="x"><char style="xo" closed="false">136:20 </char><char style="xt" closed="false"><ref loc="NUM 21:31-35">Tay 21:31-35</ref></char></note><verse eid="PSA 136:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21" />Histtidi istta biitta</para>
  <para style="q2" vid="PSA 136:21">ba asaa laatissides;</para>
  <para style="q2" vid="PSA 136:21">iza siiqoy mernaassa.<verse eid="PSA 136:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22" />Ba aylle Isra7eele laatissides;</para>
  <para style="q2" vid="PSA 136:22">iza siiqoy mernaassa.<verse eid="PSA 136:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23" />Nuni kawuyida wode</para>
  <para style="q2" vid="PSA 136:23">izi nuna qoppides;</para>
  <para style="q2" vid="PSA 136:23">iza siiqoy mernaassa.<verse eid="PSA 136:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24" />Nuna nu morkketappe ashshides;</para>
  <para style="q2" vid="PSA 136:24">iza siiqoy mernaassa.<verse eid="PSA 136:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25" />Medheta ubbaas mizaaz immees;</para>
  <para style="q2" vid="PSA 136:25">iza siiqoy mernaassa.<verse eid="PSA 136:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26" />Salo Xoossa galatite!</para>
  <para style="q2" vid="PSA 136:26">iza siiqoy mernaassa.<verse eid="PSA 136:26" /></para>
  <chapter eid="PSA 136" />
  <chapter number="137" style="c" sid="PSA 137" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1" />Baabiloone shaafata</para>
  <para style="q2" vid="PSA 137:1">lanqen uttidi</para>
  <para style="q2" vid="PSA 137:1">nuni Xiyoone qoppida wode</para>
  <para style="q2" vid="PSA 137:1">yeekkidos.<verse eid="PSA 137:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2" />Heen nuni nu diiththata</para>
  <para style="q2" vid="PSA 137:2">haaththa matan dicciza</para>
  <para style="q2" vid="PSA 137:2">miththata bolla kaqqidos.<verse eid="PSA 137:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3" />Nuna di7ida asati nuni yexxidi</para>
  <para style="q2" vid="PSA 137:3">istta ufayssana mala,</para>
  <para style="q2" vid="PSA 137:3">«Xiyoone yeththafe issaa</para>
  <para style="q2" vid="PSA 137:3">ane nuus yexxite» gida.<verse eid="PSA 137:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4" />GODAA mazamure nuni allaga biittan</para>
  <para style="q2" vid="PSA 137:4">wostti yexxonii?<verse eid="PSA 137:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5" />Yerusalaame katamayee!</para>
  <para style="q2" vid="PSA 137:5">Tani nena balikko</para>
  <para style="q2" vid="PSA 137:5">ta ushachcha kushey</para>
  <para style="q2" vid="PSA 137:5">ba ooso balo.<verse eid="PSA 137:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6" />Tani nena hassa7ontta aggiko</para>
  <para style="q2" vid="PSA 137:6">ta ufayssa ubbaafe aaththada</para>
  <para style="q2" vid="PSA 137:6">Yerusalaame dosontta aggiko</para>
  <para style="q2" vid="PSA 137:6">ta inxarsay</para>
  <para style="q2" vid="PSA 137:6">gonggiraththara oyketto.<verse eid="PSA 137:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 137:7">Yerusalaamey kundiza gallas</para>
  <para style="q2" vid="PSA 137:7">Eedoome asati</para>
  <para style="q2" vid="PSA 137:7">ooththidayssa qoppa;</para>
  <para style="q2" vid="PSA 137:7">istti, «Laallite! Laallite!</para>
  <para style="q2" vid="PSA 137:7">Yochchaafe dhoqalli dhayssite!»</para>
  <para style="q2" vid="PSA 137:7">gidayssa baloppa.<verse eid="PSA 137:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8" />Hanne Baabiloone biittayee</para>
  <para style="q2" vid="PSA 137:8">ne dhayana!</para>
  <para style="q2" vid="PSA 137:8">Neni nu bolla polida iita ooso</para>
  <para style="q2" vid="PSA 137:8">ne bolla zaari ooththizay</para>
  <para style="q2" vid="PSA 137:8">anjjettidayssa.<note caller="-" style="x"><char style="xo" closed="false">137:8 </char><char style="xt" closed="false"><ref loc="REV 18:6">Ajju 18:6</ref></char></note><verse eid="PSA 137:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9" />Ne guuththa nayta oykkidi</para>
  <para style="q2" vid="PSA 137:9">zaalla bolla dincereththizay</para>
  <para style="q2" vid="PSA 137:9">anjjettidayssa.<verse eid="PSA 137:9" /></para>
  <chapter eid="PSA 137" />
  <chapter number="138" style="c" sid="PSA 138" />
  <para style="s1">Dawite Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 138:1">Tani ta kumeththa wozinappe</para>
  <para style="q2" vid="PSA 138:1">nena galatays;</para>
  <para style="q2" vid="PSA 138:1">xoossata sinththan nena sabbays.<verse eid="PSA 138:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2" />Ne geeshsha Keeththakko simmada</para>
  <para style="q2" vid="PSA 138:2">nena goynnays;</para>
  <para style="q2" vid="PSA 138:2">ne siiqo gishshassinne</para>
  <para style="q2" vid="PSA 138:2">ne ammaneteththa gishshas</para>
  <para style="q2" vid="PSA 138:2">tani ne sunththa sabbays;</para>
  <para style="q2" vid="PSA 138:2">neni ne sunththaanne ne qaala</para>
  <para style="q2" vid="PSA 138:2">ubbaafe aaththada</para>
  <para style="q2" vid="PSA 138:2">dhoqqu histtadasa.<verse eid="PSA 138:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3" />Tani xeygida gallas taas koyadasa;</para>
  <para style="q2" vid="PSA 138:3">ne minoteththan</para>
  <para style="q2" vid="PSA 138:3">tana minththeththa.<verse eid="PSA 138:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 138:4">Sa7an diza kawoti ubbay</para>
  <para style="q2" vid="PSA 138:4">ne doonappe ke7ida qaala siyidi</para>
  <para style="q2" vid="PSA 138:4">nena galatetto!<verse eid="PSA 138:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5" />GODAA bonchchoy</para>
  <para style="q2" vid="PSA 138:5">gita gidida gishshas</para>
  <para style="q2" vid="PSA 138:5">istti izi ooththida</para>
  <para style="q2" vid="PSA 138:5">ooso gishshas yexetto.<verse eid="PSA 138:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6" />GODAY bolla dhoqqan diikkoka</para>
  <para style="q2" vid="PSA 138:6">hiyeesata lo7o ayfen xeellees;</para>
  <para style="q2" vid="PSA 138:6">gido attiin otoranchchata</para>
  <para style="q2" vid="PSA 138:6">izi haahoppe erees.<verse eid="PSA 138:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7" />Tani meto giddon diikkoka</para>
  <para style="q2" vid="PSA 138:7">neni tana naagaasa;</para>
  <para style="q2" vid="PSA 138:7">ta morkketa hanqo bolla</para>
  <para style="q2" vid="PSA 138:7">ne qese denththaasa;</para>
  <para style="q2" vid="PSA 138:7">ne ushachcha kushen</para>
  <para style="q2" vid="PSA 138:7">tana ashshaasa.<verse eid="PSA 138:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8" />GODAY taas qoppidayssa polana;</para>
  <para style="q2" vid="PSA 138:8">abeet GODAWU!</para>
  <para style="q2" vid="PSA 138:8">Ne siiqoy mernaassa;</para>
  <para style="q2" vid="PSA 138:8">ne kushe ooso yegga aggofa.<verse eid="PSA 138:8" /></para>
  <chapter eid="PSA 138" />
  <chapter number="139" style="c" sid="PSA 139" />
  <para style="s1">Dawiti Zammareta Kaabbos Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 139:1">Neni tana pilgga eradasa.<verse eid="PSA 139:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2" />Tani awude uttizaakkonne</para>
  <para style="q2" vid="PSA 139:2">awude eqqizakko neni eraasa;</para>
  <para style="q2" vid="PSA 139:2">neni ta qofa ubbaa</para>
  <para style="q2" vid="PSA 139:2">haakoppe akeekaasa.<verse eid="PSA 139:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3" />Tani bizaasonne</para>
  <para style="q2" vid="PSA 139:3">shempizaso xomosaasa;</para>
  <para style="q2" vid="PSA 139:3">ta ogeta ubbaa neni eraasa.<verse eid="PSA 139:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 139:4">Tani ta doonappe issi qaalakka</para>
  <para style="q2" vid="PSA 139:4">haasayanaappe kasetada neni</para>
  <para style="q2" vid="PSA 139:4">ta qofa ubbaa eraasa.<verse eid="PSA 139:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5" />Neni ta yuusho ubbaan daasa;</para>
  <para style="q2" vid="PSA 139:5">ne kushezan tana naagaasa.<verse eid="PSA 139:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6" />Ne erateththay</para>
  <para style="q2" vid="PSA 139:6">tana keehippe malalisees;</para>
  <para style="q2" vid="PSA 139:6">tani akeekanaas</para>
  <para style="q2" vid="PSA 139:6">dandayzayssafekka dhoqqees.<verse eid="PSA 139:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7" />Tani ne Ayanappe</para>
  <para style="q2" vid="PSA 139:7">awa baanaas dandayazinaa?</para>
  <para style="q2" vid="PSA 139:7">Woykko ne sinththafe</para>
  <para style="q2" vid="PSA 139:7">awa baqatanaas dandayazinaa?<verse eid="PSA 139:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8" />Pude salo ke7ikko</para>
  <para style="q2" vid="PSA 139:8">neni heen daasa!</para>
  <para style="q2" vid="PSA 139:8">Duge si7oole wodhdhikokka</para>
  <para style="q2" vid="PSA 139:8">neni heen daasa.<verse eid="PSA 139:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9" />Arshey mokkizaso bagga</para>
  <para style="q2" vid="PSA 139:9">paalla biikko,</para>
  <para style="q2" vid="PSA 139:9">woykko arshey wullizaso bagga</para>
  <para style="q2" vid="PSA 139:9">haakka biikko,<verse eid="PSA 139:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10" />Tana heen ne kushey kaaleththees;</para>
  <para style="q2" vid="PSA 139:10">ne ushachcha kusheykka</para>
  <para style="q2" vid="PSA 139:10">tana minththi oykkees.<verse eid="PSA 139:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11" />Tani, «Dhumazoo!</para>
  <para style="q2" vid="PSA 139:11">Tana genththa;</para>
  <para style="q2" vid="PSA 139:11">poo7ozoo! Ta yuushon</para>
  <para style="q2" vid="PSA 139:11">dhuma» giikko,<verse eid="PSA 139:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="PSA 139:12" />dhumay nena xeelo diggenna;</para>
  <para style="q2" vid="PSA 139:12">omarsi nees</para>
  <para style="q2" vid="PSA 139:12">gallassa mala poo7ees;</para>
  <para style="q2" vid="PSA 139:12">dhumaynne poo7oy nees issi mala.<verse eid="PSA 139:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13" />Neni ta asateththa</para>
  <para style="q2" vid="PSA 139:13">ubbaa medhdhadasa;</para>
  <para style="q2" vid="PSA 139:13">ta aayey ulonkka</para>
  <para style="q2" vid="PSA 139:13">tana tila medhdhadasa.<verse eid="PSA 139:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14" />Neni tana keehi yegalththinne</para>
  <para style="q2" vid="PSA 139:14">malalisizaaz histta</para>
  <para style="q2" vid="PSA 139:14">medhdhida gishshas</para>
  <para style="q2" vid="PSA 139:14">ta nena galatays;</para>
  <para style="q2" vid="PSA 139:14">ne oosoti malalisizayta!</para>
  <para style="q2" vid="PSA 139:14">Ta shemppoya</para>
  <para style="q2" vid="PSA 139:14">hessa ubbaa erawus.<verse eid="PSA 139:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15" />Tani geemason medhettida wode</para>
  <para style="q2" vid="PSA 139:15">ta meqeththati</para>
  <para style="q2" vid="PSA 139:15">neeppe geemmibeettenna;</para>
  <para style="q2" vid="PSA 139:15">tani ta aayey ulon ciimma giddon</para>
  <para style="q2" vid="PSA 139:15">hiillan oosettiza wode,<verse eid="PSA 139:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="PSA 139:16" />ta aayi ulon buro suuth gida</para>
  <para style="q2" vid="PSA 139:16">ta dishin ne ayfeti be7ida;</para>
  <para style="q2" vid="PSA 139:16">ta layththatappe issoynne</para>
  <para style="q2" vid="PSA 139:16">doomettontta dishin</para>
  <para style="q2" vid="PSA 139:16">taas neni barida gallassati ubbay</para>
  <para style="q2" vid="PSA 139:16">ne mazgaban xaafettida.<verse eid="PSA 139:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 139:17">Ne taas qoppiza qofay</para>
  <para style="q2" vid="PSA 139:17">ay mala lo7oo!</para>
  <para style="q2" vid="PSA 139:17">Izikka ay keena coraa!<verse eid="PSA 139:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18" />Tani iza qoodikko aceppeka daro;</para>
  <para style="q2" vid="PSA 139:18">ta ichcha beeggiza wode</para>
  <para style="q2" vid="PSA 139:18">ha7ikka nenara de7ays.<verse eid="PSA 139:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 139:19">Neni iitata siifidaakko aazee dizay!</para>
  <para style="q2" vid="PSA 139:19">Suuth gussana saamettiza asati</para>
  <para style="q2" vid="PSA 139:19">taappe haakkite!<verse eid="PSA 139:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20" />Istti ne bolla iita miish haasayeettes;</para>
  <para style="q2" vid="PSA 139:20">ne morkketi</para>
  <para style="q2" vid="PSA 139:20">ne sunththaa mooreettes.<verse eid="PSA 139:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 139:21">Nena ixxizayta tani ixxikinaa?</para>
  <para style="q2" vid="PSA 139:21">Ne bolla dendizayta</para>
  <para style="q2" vid="PSA 139:21">tani harassettikinaa?<verse eid="PSA 139:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22" />Ta istta mulera ixxays;</para>
  <para style="q2" vid="PSA 139:22">istta tani</para>
  <para style="q2" vid="PSA 139:22">ta morkketa mala qoodays.<verse eid="PSA 139:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 139:23">Ta wozina pilggada era;</para>
  <para style="q2" vid="PSA 139:23">tana paaccada ta ceece qofaakka</para>
  <para style="q2" vid="PSA 139:23">shaakka era.<verse eid="PSA 139:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24" />Ane tanan iitay de7ikko xeella;</para>
  <para style="q2" vid="PSA 139:24">histtada mernaa ogera</para>
  <para style="q2" vid="PSA 139:24">tana kaaleththa.<verse eid="PSA 139:24" /></para>
  <chapter eid="PSA 139" />
  <chapter number="140" style="c" sid="PSA 140" />
  <para style="s1">Dawiti Zammareta Kaabbos Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 140:1">Iita asatappe tana ashsha;</para>
  <para style="q2" vid="PSA 140:1">makkallanchchatappeka</para>
  <para style="q2" vid="PSA 140:1">tana naaga.<verse eid="PSA 140:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2" />Istti ubba wode</para>
  <para style="q2" vid="PSA 140:2">iita ooththanaas maqetteettes;</para>
  <para style="q2" vid="PSA 140:2">ubba gallassika</para>
  <para style="q2" vid="PSA 140:2">oosh denththanaas</para>
  <para style="q2" vid="PSA 140:2">yo7o piqqeettes.<verse eid="PSA 140:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3" />Istti haso shooshsha mala</para>
  <para style="q2" vid="PSA 140:3">inxars qaraseettes;</para>
  <para style="q2" vid="PSA 140:3">istta doonappe goppe marze mala</para>
  <para style="q2" vid="PSA 140:3">qaalay kezees.<note caller="-" style="x"><char style="xo" closed="false">140:3 </char><char style="xt" closed="false"><ref loc="ROM 3:13">Oro 3:13</ref></char></note><verse eid="PSA 140:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 140:4">iita asata kusheppe tana ashsha;</para>
  <para style="q2" vid="PSA 140:4">ta toho qaxxanaas qoppiza</para>
  <para style="q2" vid="PSA 140:4">makkallanchchatappeka</para>
  <para style="q2" vid="PSA 140:4">tana naaga.<verse eid="PSA 140:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5" />Otoranchchati taas</para>
  <para style="q2" vid="PSA 140:5">woximade woththida;</para>
  <para style="q2" vid="PSA 140:5">gite giigsida;</para>
  <para style="q2" vid="PSA 140:5">ta ogenkka diiza woththida.<verse eid="PSA 140:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6" />Tani GODAA,</para>
  <para style="q2" vid="PSA 140:6">«Neni ta Xoossa» gays.</para>
  <para style="q2" vid="PSA 140:6">Abeet GODAWU!</para>
  <para style="q2" vid="PSA 140:6">Tani shoobbizayssa siya.<verse eid="PSA 140:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7" />Abeet Ubbaafe Wolqqama GODAWU!</para>
  <para style="q2" vid="PSA 140:7">tana ashshiza minozoo!</para>
  <para style="q2" vid="PSA 140:7">ola gallas taas gondalle gidadasa!<verse eid="PSA 140:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 140:8">Iitata amoy polettofo;</para>
  <para style="q2" vid="PSA 140:8">istta qofay</para>
  <para style="q2" vid="PSA 140:8">polettana mala ooththofa!<verse eid="PSA 140:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9" />Ta morkketan tana xoonisoppa;</para>
  <para style="q2" vid="PSA 140:9">istti qoppida iita qofay</para>
  <para style="q2" vid="PSA 140:9">istta hu7en xaaxetto.<verse eid="PSA 140:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10" />Istta bolla tama bonqoy qoletto;</para>
  <para style="q2" vid="PSA 140:10">istti taman olettetto;</para>
  <para style="q2" vid="PSA 140:10">simmi kezanaas dandayontta</para>
  <para style="q2" vid="PSA 140:10">ollan kundetto.<verse eid="PSA 140:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11" />Iita haasayzayta biittay tookkofo;</para>
  <para style="q2" vid="PSA 140:11">makkallanchchata</para>
  <para style="q2" vid="PSA 140:11">iita miishshi oykko.<verse eid="PSA 140:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12" />GODAY hiyeesatas pirdizayssanne</para>
  <para style="q2" vid="PSA 140:12">metotanchchatas</para>
  <para style="q2" vid="PSA 140:12">mootettizayssa ta erays.<verse eid="PSA 140:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13" />Xilloti tumuppe</para>
  <para style="q2" vid="PSA 140:13">ne sunththaa galatana;</para>
  <para style="q2" vid="PSA 140:13">suuretikka ne sinththan de7ana.<verse eid="PSA 140:13" /></para>
  <chapter eid="PSA 140" />
  <chapter number="141" style="c" sid="PSA 141" />
  <para style="s1">Dawite Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 141:1">Tani nena xeygays;</para>
  <para style="q2" vid="PSA 141:1">tana maaddanaas elela.</para>
  <para style="q2" vid="PSA 141:1">Tani neekko waassiza wode</para>
  <para style="q2" vid="PSA 141:1">ta waaso siya!<verse eid="PSA 141:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2" />Ta woosay exaane cuwa mala</para>
  <para style="q2" vid="PSA 141:2">ne sinth shiiqo;</para>
  <para style="q2" vid="PSA 141:2">tani ta kusheza miccizayssi</para>
  <para style="q2" vid="PSA 141:2">nees omarsa wode</para>
  <para style="q2" vid="PSA 141:2">yarsho mala gido.<note caller="-" style="x"><char style="xo" closed="false">141:2 </char><char style="xt" closed="false"><ref loc="REV 5:8">Ajju 5:8</ref></char></note><verse eid="PSA 141:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 141:3">Ta doona naaganaas</para>
  <para style="q2" vid="PSA 141:3">zabe woththa;</para>
  <para style="q2" vid="PSA 141:3">ta mettershata pengen</para>
  <para style="q2" vid="PSA 141:3">naagizayssa essa.<verse eid="PSA 141:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4" />Mooro ooththiza asatara</para>
  <para style="q2" vid="PSA 141:4">iita ooso ooththontta mala</para>
  <para style="q2" vid="PSA 141:4">ta wozina iitakko zaaroppa;</para>
  <para style="q2" vid="PSA 141:4">istta gibiraakka tana mizoppa.<verse eid="PSA 141:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5" />Xillo asi tana qaxxayo;</para>
  <para style="q2" vid="PSA 141:5">hessika taas lo7o;</para>
  <para style="q2" vid="PSA 141:5">izi tana seerikko</para>
  <para style="q2" vid="PSA 141:5">hessi ta hu7en</para>
  <para style="q2" vid="PSA 141:5">zayte tiyiza mala;</para>
  <para style="q2" vid="PSA 141:5">hessaka ta ixxike;</para>
  <para style="q2" vid="PSA 141:5">gido attiin tani ubbatokka</para>
  <para style="q2" vid="PSA 141:5">iita asata ooso bolla woossays.<verse eid="PSA 141:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6" />Istta daannati</para>
  <para style="q2" vid="PSA 141:6">aafora duge olettiza wode</para>
  <para style="q2" vid="PSA 141:6">ta qaalay tuma gididayssa</para>
  <para style="q2" vid="PSA 141:6">istti erana.<verse eid="PSA 141:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7" />Gadey goyettiza malanne</para>
  <para style="q2" vid="PSA 141:7">phashey liiqiza mala</para>
  <para style="q2" vid="PSA 141:7">istta meqeththika</para>
  <para style="q2" vid="PSA 141:7">duufo doonan laalettana.<verse eid="PSA 141:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8" />Abeet GODAWU,</para>
  <para style="q2" vid="PSA 141:8">Ubbaafe Wolqqama Xoossawu!</para>
  <para style="q2" vid="PSA 141:8">Ta ayfey nena xeellees;</para>
  <para style="q2" vid="PSA 141:8">ta zemppoy nena;</para>
  <para style="q2" vid="PSA 141:8">tana hayqos aaththada immofa.<verse eid="PSA 141:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9" />Istti taas woththida</para>
  <para style="q2" vid="PSA 141:9">woximadeppenne</para>
  <para style="q2" vid="PSA 141:9">iita ooththizayta giteppe</para>
  <para style="q2" vid="PSA 141:9">tana naaga.<verse eid="PSA 141:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10" />Ta saro aadhdhishin</para>
  <para style="q2" vid="PSA 141:10">istti bantti woththida</para>
  <para style="q2" vid="PSA 141:10">gitezan oyketetto.<verse eid="PSA 141:10" /></para>
  <chapter eid="PSA 141" />
  <chapter number="142" style="c" sid="PSA 142" />
  <para style="s1">Gongolo Giddon Diza Wode Dawiti Akeekan Yexxida Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1" />Ta qaala dhoqqu histtada</para>
  <para style="q2" vid="PSA 142:1">tani GODAAKKO waassays.</para>
  <para style="q2" vid="PSA 142:1">GODAAPPE maaroteth woossays.<verse eid="PSA 142:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2" />Ta qohoza ubbaa izas magannays;</para>
  <para style="q2" vid="PSA 142:2">ta meto ubbaa izas yootays.<verse eid="PSA 142:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3" />Tani daaburda wode</para>
  <para style="q2" vid="PSA 142:3">neni ta oge eraasa;</para>
  <para style="q2" vid="PSA 142:3">ta hemettiza ogen</para>
  <para style="q2" vid="PSA 142:3">tana oykkanaas</para>
  <para style="q2" vid="PSA 142:3">woximade woththida.<verse eid="PSA 142:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4" />Tani ta yuusho</para>
  <para style="q2" vid="PSA 142:4">simma xeelliza wode</para>
  <para style="q2" vid="PSA 142:4">tana maaddanay oonikka deenna;</para>
  <para style="q2" vid="PSA 142:4">ta baqata attanaasoyka deenna;</para>
  <para style="q2" vid="PSA 142:4">ta shemppoys wudettiza</para>
  <para style="q2" vid="PSA 142:4">asikka deenna.<verse eid="PSA 142:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 142:5">Ne tana maaddana mala</para>
  <para style="q2" vid="PSA 142:5">ta neekko waassays;</para>
  <para style="q2" vid="PSA 142:5">ta zemppoy nena;</para>
  <para style="q2" vid="PSA 142:5">ta shemppora paxa dishin</para>
  <para style="q2" vid="PSA 142:5">ta qaaday nena.<verse eid="PSA 142:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6" />Tani keehippe</para>
  <para style="q2" vid="PSA 142:6">hidota qanxxida gishshas</para>
  <para style="q2" vid="PSA 142:6">ne ta waaso siya!</para>
  <para style="q2" vid="PSA 142:6">Tana gooddizayti</para>
  <para style="q2" vid="PSA 142:6">taappe wolqqatida gishshas</para>
  <para style="q2" vid="PSA 142:6">tana ashsha.<verse eid="PSA 142:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7" />Tani ne sunththaa galatana mala</para>
  <para style="q2" vid="PSA 142:7">tana qashoppe birsha.</para>
  <para style="q2" vid="PSA 142:7">Neni taas lo7o gidida gishshas</para>
  <para style="q2" vid="PSA 142:7">xilloti ta yuushon shiiqana.<note caller="-" style="x"><char style="xo" closed="false">142:1-7 </char><char style="xt" closed="false"><ref loc="1SA 22:1">1Same 22:1</ref>; <ref loc="1SA 24:3">24:3</ref></char></note><verse eid="PSA 142:7" /></para>
  <chapter eid="PSA 142" />
  <chapter number="143" style="c" sid="PSA 143" />
  <para style="s1">Dawite Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 143:1">Ta woosa siya;</para>
  <para style="q2" vid="PSA 143:1">ta shoobbizayssa ezga;</para>
  <para style="q2" vid="PSA 143:1">neni xillonne</para>
  <para style="q2" vid="PSA 143:1">ammanettizayssa</para>
  <para style="q2" vid="PSA 143:1">gidida gishshas</para>
  <para style="q2" vid="PSA 143:1">taas zaaro imma.<verse eid="PSA 143:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2" />Ne sinththan xillo gidana asi</para>
  <para style="q2" vid="PSA 143:2">oonikka deenna;</para>
  <para style="q2" vid="PSA 143:2">tana ne aylleza</para>
  <para style="q2" vid="PSA 143:2">pirdas shiishshofa.<note caller="-" style="x"><char style="xo" closed="false">143:2 </char><char style="xt" closed="false"><ref loc="ROM 3:20">Oro 3:20</ref>; <ref loc="GAL 2:16">Gala 2:16</ref></char></note><verse eid="PSA 143:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3" />Ta hayqqana gakkanaas</para>
  <para style="q2" vid="PSA 143:3">ta morkketi tana yedeththida;</para>
  <para style="q2" vid="PSA 143:3">tana dirxxidi</para>
  <para style="q2" vid="PSA 143:3">biitta gars gelththida;</para>
  <para style="q2" vid="PSA 143:3">kase hayqqida asata malakka</para>
  <para style="q2" vid="PSA 143:3">tana dhuman woththida.<verse eid="PSA 143:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4" />Hessa gishshas tani daaburadis;</para>
  <para style="q2" vid="PSA 143:4">ta wozinaykka hidota qanxxides.<verse eid="PSA 143:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5" />Tani beni wodeta hassa7ays;</para>
  <para style="q2" vid="PSA 143:5">neni ooththida ooso ubbaa</para>
  <para style="q2" vid="PSA 143:5">yuushsha qoppays;</para>
  <para style="q2" vid="PSA 143:5">ne kushe oosotakka akeekays.<verse eid="PSA 143:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6" />Tani ta kusheza neekko miccays;</para>
  <para style="q2" vid="PSA 143:6">mela biittay haath koyza mala</para>
  <para style="q2" vid="PSA 143:6">ta shemppoya nena saamettadus.<verse eid="PSA 143:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 143:7">Tani daaburadis;</para>
  <para style="q2" vid="PSA 143:7">ne taas zaaro immanaas elela!</para>
  <para style="q2" vid="PSA 143:7">Tani hayqqida asataththo</para>
  <para style="q2" vid="PSA 143:7">duge duufon gelontta mala</para>
  <para style="q2" vid="PSA 143:7">ne sinththa taappe genththofa.<verse eid="PSA 143:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8" />Tani nena ammanettiza gishshas</para>
  <para style="q2" vid="PSA 143:8">maalado maalado ne siiqo</para>
  <para style="q2" vid="PSA 143:8">tana bessa;</para>
  <para style="q2" vid="PSA 143:8">tani ta shemppo nees hadaradis;</para>
  <para style="q2" vid="PSA 143:8">hessa gishshas ta baana oge</para>
  <para style="q2" vid="PSA 143:8">tana tamaarsa.<verse eid="PSA 143:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 143:9">Ta ne garsan qotettadis;</para>
  <para style="q2" vid="PSA 143:9">tana ta morkketappe ashsha.<verse eid="PSA 143:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10" />Neni ta Xoossa;</para>
  <para style="q2" vid="PSA 143:10">tani ne shene polana mala</para>
  <para style="q2" vid="PSA 143:10">tana tamaarsa;</para>
  <para style="q2" vid="PSA 143:10">ne lo7o Ayanay</para>
  <para style="q2" vid="PSA 143:10">tana suure oge kaaleththo.<verse eid="PSA 143:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 143:11">Ne sunththa gishshas</para>
  <para style="q2" vid="PSA 143:11">tana ashsha;</para>
  <para style="q2" vid="PSA 143:11">ne xilloteththan</para>
  <para style="q2" vid="PSA 143:11">tana metoppe kessa.<verse eid="PSA 143:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12" />Ne tana siiqiza gishshas</para>
  <para style="q2" vid="PSA 143:12">ta morkketa suppu histta wodha;</para>
  <para style="q2" vid="PSA 143:12">tana ne aylleza un7eththizayta</para>
  <para style="q2" vid="PSA 143:12">dippi histta dhayssa.<verse eid="PSA 143:12" /></para>
  <chapter eid="PSA 143" />
  <chapter number="144" style="c" sid="PSA 144" />
  <para style="s1">Dawite Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1" />Ta kusheta olas,</para>
  <para style="q2" vid="PSA 144:1">ta biradhdhetakka</para>
  <para style="q2" vid="PSA 144:1">xongeththas</para>
  <para style="q2" vid="PSA 144:1">loohissida GODAY</para>
  <para style="q2" vid="PSA 144:1">ta zaallay galatetto!<verse eid="PSA 144:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2" />Izi tana siiqizanne</para>
  <para style="q2" vid="PSA 144:2">genththiza Xoossa;</para>
  <para style="q2" vid="PSA 144:2">izi taas miixanne</para>
  <para style="q2" vid="PSA 144:2">tana ashshizayssa;</para>
  <para style="q2" vid="PSA 144:2">izi ta gondallenne</para>
  <para style="q2" vid="PSA 144:2">tani baqatada attizaso;</para>
  <para style="q2" vid="PSA 144:2">kawoteththatakka</para>
  <para style="q2" vid="PSA 144:2">izi taas haarisizayssa.<verse eid="PSA 144:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 144:3">Ne hayssa sire bonchchanaas</para>
  <para style="q2" vid="PSA 144:3">asi aazee?</para>
  <para style="q2" vid="PSA 144:3">Ne hayssaththo asas qoppanawu</para>
  <para style="q2" vid="PSA 144:3">asa nay aazee?<note caller="-" style="x"><char style="xo" closed="false">144:3 </char><char style="xt" closed="false"><ref loc="JOB 7:17-18">Iyo 7:17-18</ref>; <ref loc="PSA 8:4">Maza 8:4</ref></char></note><verse eid="PSA 144:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4" />Asi issito carki aadhdhiza</para>
  <para style="q2" vid="PSA 144:4">carko mala;</para>
  <para style="q2" vid="PSA 144:4">iza layththatikka</para>
  <para style="q2" vid="PSA 144:4">eeson dhayza kuwa mala.<verse eid="PSA 144:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 144:5">neni salaa daakkada</para>
  <para style="q2" vid="PSA 144:5">duge wodhdha!</para>
  <para style="q2" vid="PSA 144:5">zumata bochchada cuwasa!<verse eid="PSA 144:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6" />Wolqqanth yeddada</para>
  <para style="q2" vid="PSA 144:6">ne morkketa laalla!</para>
  <para style="q2" vid="PSA 144:6">Ne wondafe yiishshan</para>
  <para style="q2" vid="PSA 144:6">dukkada yedeththa!<verse eid="PSA 144:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7" />Bollafe ne kushe yeddada,</para>
  <para style="q2" vid="PSA 144:7">tana wolqqama haaththafe</para>
  <para style="q2" vid="PSA 144:7">goochcha kessa;</para>
  <para style="q2" vid="PSA 144:7">allaga asata kusheppe</para>
  <para style="q2" vid="PSA 144:7">ne tana ashsha.<verse eid="PSA 144:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8" />Istta doonay wordo haasayees;</para>
  <para style="q2" vid="PSA 144:8">istti ushachcha kushe denththidi</para>
  <para style="q2" vid="PSA 144:8">wordo caaqqeettes.<verse eid="PSA 144:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9" />Abeet Xoossawu!</para>
  <para style="q2" vid="PSA 144:9">Tani nees ooraththa</para>
  <para style="q2" vid="PSA 144:9">mazamure yexxana;</para>
  <para style="q2" vid="PSA 144:9">tammu shayan waaxettida diiththan</para>
  <para style="q2" vid="PSA 144:9">nees yexxana.<verse eid="PSA 144:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10" />Kawotas xoono immaasa;</para>
  <para style="q2" vid="PSA 144:10">ne aylle Dawite giththa</para>
  <para style="q2" vid="PSA 144:10">mashshafe ashshaasa.<verse eid="PSA 144:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11" />Wordo haasayzaytappenne</para>
  <para style="q2" vid="PSA 144:11">ba ushachcha kushe denththidi</para>
  <para style="q2" vid="PSA 144:11">wordo caaqqizaytappenne</para>
  <para style="q2" vid="PSA 144:11">allagatappe tana ashshanne naaga.<verse eid="PSA 144:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12" />Nu attuma nayti</para>
  <para style="q2" vid="PSA 144:12">ba naateteththan dalqidalqidi</para>
  <para style="q2" vid="PSA 144:12">dicciza miththa mala gidetto!</para>
  <para style="q2" vid="PSA 144:12">Nu macca naytikka</para>
  <para style="q2" vid="PSA 144:12">kawo keeththa gulan</para>
  <para style="q2" vid="PSA 144:12">alleqos essida</para>
  <para style="q2" vid="PSA 144:12">tuuqe mala gidetto.<verse eid="PSA 144:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13" />Nu gootaratan dumma dumma</para>
  <para style="q2" vid="PSA 144:13">qommo kaththi kumo;</para>
  <para style="q2" vid="PSA 144:13">nu dorsati shii laaqqa</para>
  <para style="q2" vid="PSA 144:13">gakkanaas yeletto;</para>
  <para style="q2" vid="PSA 144:13">heemettizason tammu shii</para>
  <para style="q2" vid="PSA 144:13">gakkanawu daretto.<verse eid="PSA 144:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 144:14" />Nu miizati yelizayta gidetto;</para>
  <para style="q2" vid="PSA 144:14">istti awucayontta</para>
  <para style="q2" vid="PSA 144:14">yelettidi corattetto.</para>
  <para style="q2" vid="PSA 144:14">Nuna asi di7oppo;</para>
  <para style="q2" vid="PSA 144:14">nu zagon waasoy siyettofo.<verse eid="PSA 144:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15" />Ha anjjoy iza gakkiza derey</para>
  <para style="q2" vid="PSA 144:15">anjjettida dere;</para>
  <para style="q2" vid="PSA 144:15">Xoossi izas GODAA gidida derey</para>
  <para style="q2" vid="PSA 144:15">anjjettida dere.<verse eid="PSA 144:15" /></para>
  <chapter eid="PSA 144" />
  <chapter number="145" style="c" sid="PSA 145" />
  <para style="s1">Dawiti Yexxida Galata Mazamure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1" />Abeet ta kawo Xoossawu!</para>
  <para style="q2" vid="PSA 145:1">Tani nena</para>
  <para style="q2" vid="PSA 145:1">dhoqqu dhoqqu histtana;</para>
  <para style="q2" vid="PSA 145:1">ne sunththa</para>
  <para style="q2" vid="PSA 145:1">mernaaskka galatana.<verse eid="PSA 145:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2" />Tani nena ubba gallas sabbana;</para>
  <para style="q2" vid="PSA 145:2">ne sunththaaka</para>
  <para style="q2" vid="PSA 145:2">mernaas galatana.<verse eid="PSA 145:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3" />GODAY gita;</para>
  <para style="q2" vid="PSA 145:3">gita galatay izas bessees;</para>
  <para style="q2" vid="PSA 145:3">iza gitateththay</para>
  <para style="q2" vid="PSA 145:3">asa qofappe bolla.<verse eid="PSA 145:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4" />Issi yeletay kaalliza yeletas</para>
  <para style="q2" vid="PSA 145:4">ne ooththida ooso yootees;</para>
  <para style="q2" vid="PSA 145:4">malalisiza ne oosotakka</para>
  <para style="q2" vid="PSA 145:4">qonccisana.<verse eid="PSA 145:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5" />Istti ne bonchchonne</para>
  <para style="q2" vid="PSA 145:5">ne gita teema haasayana;</para>
  <para style="q2" vid="PSA 145:5">tanikka malalisiza ne oosoza</para>
  <para style="q2" vid="PSA 145:5">zaara zaara qoppana.<verse eid="PSA 145:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6" />Asay malalisiza ne oosoza</para>
  <para style="q2" vid="PSA 145:6">gitateththa gishshas</para>
  <para style="q2" vid="PSA 145:6">haasayettana;</para>
  <para style="q2" vid="PSA 145:6">tanikka ne gitateththa awajjana.<verse eid="PSA 145:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7" />Istti ne kiyateththa daroza yootana;</para>
  <para style="q2" vid="PSA 145:7">ne xilloteththaa</para>
  <para style="q2" vid="PSA 145:7">ufayssan yexxana.<verse eid="PSA 145:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8" />GODAY qadhettizayssanne</para>
  <para style="q2" vid="PSA 145:8">maarizayssa;</para>
  <para style="q2" vid="PSA 145:8">izi hanqettanaas</para>
  <para style="q2" vid="PSA 145:8">eesotonttayssanne</para>
  <para style="q2" vid="PSA 145:8">siiqoy kumidayssa.<verse eid="PSA 145:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9" />GODAY ubbaas kiya;</para>
  <para style="q2" vid="PSA 145:9">izi ba medhdhida</para>
  <para style="q2" vid="PSA 145:9">ubbaas qadhettizayssa.<verse eid="PSA 145:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10" />Abeet GODAWU!</para>
  <para style="q2" vid="PSA 145:10">medheta ubbay nena galatana;</para>
  <para style="q2" vid="PSA 145:10">ne derey ubbayka</para>
  <para style="q2" vid="PSA 145:10">nena sabbana.<verse eid="PSA 145:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11" />Istti ne kawoteththa</para>
  <para style="q2" vid="PSA 145:11">bonchcho gishshas haasayana;</para>
  <para style="q2" vid="PSA 145:11">ne wolqqa gishshas yootana.<verse eid="PSA 145:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12" />Hessan ne wolqqama oosotanne</para>
  <para style="q2" vid="PSA 145:12">ne kawoteththa</para>
  <para style="q2" vid="PSA 145:12">teema bonchchoza</para>
  <para style="q2" vid="PSA 145:12">istti erisana.<verse eid="PSA 145:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13" />Yeletappe yeleta gakkanaas</para>
  <para style="q2" vid="PSA 145:13">ne haarana;</para>
  <para style="q2" vid="PSA 145:13">ne kawoteththay mernaassa.</para>
  <para style="b" vid="PSA 145:13" />
  <para style="q2" vid="PSA 145:13">GODAY ba gida qaalan</para>
  <para style="q2" vid="PSA 145:13">ammanettizayssa;</para>
  <para style="q2" vid="PSA 145:13">izi ba ooso ubbaan kiya.<verse eid="PSA 145:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14" />GODAY gandigarzayta kaafees;</para>
  <para style="q2" vid="PSA 145:14">kundidaytakka denththees.<verse eid="PSA 145:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15" />Ubbaa ayfey neekko xeellees;</para>
  <para style="q2" vid="PSA 145:15">isttas koshshiza woden</para>
  <para style="q2" vid="PSA 145:15">neni isttas quma immaasa.<verse eid="PSA 145:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16" />Neni ne kushe miccada</para>
  <para style="q2" vid="PSA 145:16">shemppora paxa diza ubbaa</para>
  <para style="q2" vid="PSA 145:16">amo kunththaasa.<verse eid="PSA 145:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17" />GODAY ba oge ubbaan xillo;</para>
  <para style="q2" vid="PSA 145:17">izi ba ooso ubbaan kiya.<verse eid="PSA 145:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18" />GODAY bana xeygizaytas</para>
  <para style="q2" vid="PSA 145:18">ubbaas mata;</para>
  <para style="q2" vid="PSA 145:18">wozinappe xeygiza</para>
  <para style="q2" vid="PSA 145:18">ubbaas matan dees.<verse eid="PSA 145:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19" />Izi baas yayyiza ubbaas</para>
  <para style="q2" vid="PSA 145:19">amo kunththees.</para>
  <para style="q1" vid="PSA 145:19">Qasse izi istta waasoza siyidi</para>
  <para style="q2" vid="PSA 145:19">istta ashshees.<verse eid="PSA 145:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20" />GODAY bana siiqizayta</para>
  <para style="q2" vid="PSA 145:20">ubbaa naagees;</para>
  <para style="q2" vid="PSA 145:20">gido attiin iitata</para>
  <para style="q2" vid="PSA 145:20">ubbaa dhayssana.<verse eid="PSA 145:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21" />Tani ta doonan GODAA galatana.</para>
  <para style="q2" vid="PSA 145:21">Medheta ubbay</para>
  <para style="q2" vid="PSA 145:21">iza geeshsha sunththa</para>
  <para style="q2" vid="PSA 145:21">meri mernaas galato!<verse eid="PSA 145:21" /></para>
  <chapter eid="PSA 145" />
  <chapter number="146" style="c" sid="PSA 146" />
  <para style="s1">Ashshiza Xoossas Shiiqida Galata</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1" />GODAY galatetto!</para>
  <para style="q2" vid="PSA 146:1">Ta shemppoyee,</para>
  <para style="q2" vid="PSA 146:1">GODAA galata!<verse eid="PSA 146:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2" />Ta de7o layththa ubbaan</para>
  <para style="q2" vid="PSA 146:2">tani GODAA galatana;</para>
  <para style="q2" vid="PSA 146:2">tani shemppora paxa diza wode</para>
  <para style="q2" vid="PSA 146:2">ubbaan ta Xoossa sabbana.<verse eid="PSA 146:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3" />Dere ayssizaytan ammanettofte;</para>
  <para style="q2" vid="PSA 146:3">As ashshanawu dandayontta</para>
  <para style="q2" vid="PSA 146:3">asho may7ida</para>
  <para style="q2" vid="PSA 146:3">medhetatan ceeqettofte.<verse eid="PSA 146:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4" />Istta shemppoy keziza wode</para>
  <para style="q2" vid="PSA 146:4">istti biittan simmana;</para>
  <para style="q2" vid="PSA 146:4">istta halchchoy ubbay</para>
  <para style="q2" vid="PSA 146:4">he gallas attana.<verse eid="PSA 146:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5" />Yaaqoobe Xoossay maaddiza asi</para>
  <para style="q2" vid="PSA 146:5">ba hidotakka ba GODAA bolla</para>
  <para style="q2" vid="PSA 146:5">woththida asi anjjettidaade.<verse eid="PSA 146:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6" />GODAY salonne sa7a,</para>
  <para style="q2" vid="PSA 146:6">gita abbanne istta</para>
  <para style="q2" vid="PSA 146:6">giddon diza ubbaa</para>
  <para style="q2" vid="PSA 146:6">medhdhidayssa;</para>
  <para style="q2" vid="PSA 146:6">izi ba ammaneteththaa</para>
  <para style="q2" vid="PSA 146:6">mernaas naagizayssa.<note caller="-" style="x"><char style="xo" closed="false">146:6 </char><char style="xt" closed="false"><ref loc="ACT 4:24">Hawa 4:24</ref>; <ref loc="ACT 14:15">14:15</ref></char></note><verse eid="PSA 146:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7" />Izi qohettidaytas pirdizayssa;</para>
  <para style="q2" vid="PSA 146:7">gafidayta mizi kalssizayssa.</para>
  <para style="b" vid="PSA 146:7" />
  <para style="q2" vid="PSA 146:7">GODAY qashettidayta</para>
  <para style="q2" vid="PSA 146:7">birshi yeddizayssa;<verse eid="PSA 146:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 146:8" />GODAY qooqeta xeelisees.</para>
  <para style="q2" vid="PSA 146:8">GODAY kundidayta denththees;</para>
  <para style="q2" vid="PSA 146:8">GODAY xillotakka siiqees.<verse eid="PSA 146:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9" />GODAY bete asata naagees.</para>
  <para style="q2" vid="PSA 146:9">Am7etanne yi7o nayta maaddees;</para>
  <para style="q2" vid="PSA 146:9">gido attiin iitata oge dhayssees.<verse eid="PSA 146:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10" />GODAY mernaas kawo;</para>
  <para style="q2" vid="PSA 146:10">Xiyoone! Ne Xoossi</para>
  <para style="q2" vid="PSA 146:10">yeletappe yeleta gakkanaas</para>
  <para style="q2" vid="PSA 146:10">kawotana.</para>
  <para style="b" vid="PSA 146:10" />
  <para style="q2" vid="PSA 146:10">GODAY galatetto!<verse eid="PSA 146:10" /></para>
  <chapter eid="PSA 146" />
  <chapter number="147" style="c" sid="PSA 147" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1" />GODAY galatetto!</para>
  <para style="q2" vid="PSA 147:1">Nu Xoossa mazamuren saboy</para>
  <para style="q2" vid="PSA 147:1">ay mala lo7o!</para>
  <para style="q2" vid="PSA 147:1">iza galatizayssi ufayssees;</para>
  <para style="q2" vid="PSA 147:1">hessika izas bessees.<verse eid="PSA 147:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2" />GODAY Yerusalaame ooraxissana;</para>
  <para style="q2" vid="PSA 147:2">Isra7eeleppe betidaytakka</para>
  <para style="q2" vid="PSA 147:2">shiishshana.<verse eid="PSA 147:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3" />Wozinay meqqidayta izi koolees;</para>
  <para style="q2" vid="PSA 147:3">istta madunththaaka</para>
  <para style="q2" vid="PSA 147:3">izi paththees.<verse eid="PSA 147:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4" />Izi salo xoolintteta qooda erees;</para>
  <para style="q2" vid="PSA 147:4">issaa issaa iza sunththan</para>
  <para style="q2" vid="PSA 147:4">sunththan xeygees.<verse eid="PSA 147:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5" />Nu GODAY gita;</para>
  <para style="q2" vid="PSA 147:5">izi keehippe wolqqama;</para>
  <para style="q2" vid="PSA 147:5">iza erateththaas zaway deenna.<verse eid="PSA 147:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6" />GODAY kadhettidayta bonchchees;</para>
  <para style="q2" vid="PSA 147:6">gido attiin iitata kawushshees.<verse eid="PSA 147:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7" />GODAAS galata mazamure yexxite;</para>
  <para style="q2" vid="PSA 147:7">nu Xoossas maasinqo</para>
  <para style="q2" vid="PSA 147:7">shocishe galatite.<verse eid="PSA 147:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8" />Izi salo shaara mayzees;</para>
  <para style="q2" vid="PSA 147:8">sa7as ira bukisees;</para>
  <para style="q2" vid="PSA 147:8">zumata bollaka maata mokisees.<verse eid="PSA 147:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9" />Medosassinne quuro yelotas</para>
  <para style="q2" vid="PSA 147:9">miza miish izi immees.<verse eid="PSA 147:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10" />Izi ufayettizay</para>
  <para style="q2" vid="PSA 147:10">parata wolqqaninne</para>
  <para style="q2" vid="PSA 147:10">tooranchchata</para>
  <para style="q2" vid="PSA 147:10">minoteththan gidenna.<verse eid="PSA 147:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11" />GODAY baas yayyizaytaninne</para>
  <para style="q2" vid="PSA 147:11">iza siiqon</para>
  <para style="q2" vid="PSA 147:11">ammanettizaytan ufayettees.<verse eid="PSA 147:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12" />Yerusalaame katamayee!</para>
  <para style="q2" vid="PSA 147:12">GODAA galata!</para>
  <para style="q2" vid="PSA 147:12">Hanne Xiyoonee! Ne Xoossa sabba!<verse eid="PSA 147:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13" />Izi ne penge kolata minththees;</para>
  <para style="q2" vid="PSA 147:13">ne giddon diza ne nayta anjjees.<verse eid="PSA 147:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14" />Izi ne zawa saroteththan naagees;</para>
  <para style="q2" vid="PSA 147:14">nena keehippe lo7iza</para>
  <para style="q2" vid="PSA 147:14">gistte kalssees.<verse eid="PSA 147:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15" />Izi ba kiita sa7as kiittees;</para>
  <para style="q2" vid="PSA 147:15">iza qaalaykka eeson gakkees.<verse eid="PSA 147:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16" />Izi shach afala mala miccees;</para>
  <para style="q2" vid="PSA 147:16">kenchchoka bidinththa mala</para>
  <para style="q2" vid="PSA 147:16">laallees.<verse eid="PSA 147:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17" />Izi shach shuchcha mala</para>
  <para style="q2" vid="PSA 147:17">duge yeddana;</para>
  <para style="q2" vid="PSA 147:17">he moocezan eqqanaas</para>
  <para style="q2" vid="PSA 147:17">ooninne dandayenna.<verse eid="PSA 147:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18" />Izi ba qaala kiittidi</para>
  <para style="q2" vid="PSA 147:18">shachchaa mayisees.</para>
  <para style="q2" vid="PSA 147:18">Izi carko carkissiin</para>
  <para style="q2" vid="PSA 147:18">haaththi goggees.<verse eid="PSA 147:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19" />Izi ba qaala Yaaqoobe zereththas</para>
  <para style="q2" vid="PSA 147:19">ba maaraanne wogaa</para>
  <para style="q2" vid="PSA 147:19">Isra7eele asaas qonccisees.<verse eid="PSA 147:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20" />Izi hessa mala</para>
  <para style="q2" vid="PSA 147:20">hara kawoteththatas</para>
  <para style="q2" vid="PSA 147:20">ooththibeenna;</para>
  <para style="q2" vid="PSA 147:20">istti iza woga erettenna.</para>
  <para style="b" vid="PSA 147:20" />
  <para style="q2" vid="PSA 147:20">GODAY galatetto!<verse eid="PSA 147:20" /></para>
  <chapter eid="PSA 147" />
  <chapter number="148" style="c" sid="PSA 148" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1" />GODAY galatetto!</para>
  <para style="b" vid="PSA 148:1" />
  <para style="q1" vid="PSA 148:1">Salon de7izaytoo! GODAA galatite;</para>
  <para style="q2" vid="PSA 148:1">bolla dhoqqan de7izaytoo!</para>
  <para style="q2" vid="PSA 148:1">Iza sabbite.<verse eid="PSA 148:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2" />Intteno iza kiitanchchatoo!</para>
  <para style="q2" vid="PSA 148:2">Ubbay iza galatite;</para>
  <para style="q2" vid="PSA 148:2">salon de7iza iza olanchchatoo!</para>
  <para style="q2" vid="PSA 148:2">Ubbay iza galatite.<verse eid="PSA 148:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3" />Arsheynne aginay iza galatite;</para>
  <para style="q2" vid="PSA 148:3">poo7isiza xoolinttetoo!</para>
  <para style="q2" vid="PSA 148:3">Ubbay iza galatite.<verse eid="PSA 148:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4" />Intteno ubbaafe bolla dhoqqan</para>
  <para style="q2" vid="PSA 148:4">diza salotoo! Iza galatite;</para>
  <para style="q2" vid="PSA 148:4">Salo gufanththofe bollara diza</para>
  <para style="q2" vid="PSA 148:4">haaththatoo! Iza sabbite.<verse eid="PSA 148:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5" />Izi azaziin istti ubbayka</para>
  <para style="q2" vid="PSA 148:5">medhettida gishshas</para>
  <para style="q2" vid="PSA 148:5">ubbati GODAA</para>
  <para style="q2" vid="PSA 148:5">sunththaa galatetto!<verse eid="PSA 148:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6" />Izi istta istti dizason</para>
  <para style="q2" vid="PSA 148:6">meri mernaas</para>
  <para style="q2" vid="PSA 148:6">minththi woththides;</para>
  <para style="q2" vid="PSA 148:6">Izi isttas laamettontta</para>
  <para style="q2" vid="PSA 148:6">woga immides.<verse eid="PSA 148:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7" />Sa7an de7izaytoo! GODAA galatite!</para>
  <para style="q2" vid="PSA 148:7">Abba giddon diza</para>
  <para style="q2" vid="PSA 148:7">gita medheteththatinne</para>
  <para style="q2" vid="PSA 148:7">wogga gita abba ciimmati</para>
  <para style="q2" vid="PSA 148:7">ubbayka iza sabbite.<verse eid="PSA 148:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8" />Wolqqanththinne shachchi,</para>
  <para style="q2" vid="PSA 148:8">kenchchoynne gubbanay,</para>
  <para style="q2" vid="PSA 148:8">iza azazo poliza gote carkoti</para>
  <para style="q2" vid="PSA 148:8">ubbatikka iza galatite.<verse eid="PSA 148:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9" />Zumatoo, zumbullatoo,</para>
  <para style="q2" vid="PSA 148:9">ayfe ayfiza miththatoo, zigatoo</para>
  <para style="q2" vid="PSA 148:9">ubbatikka iza galatite.<verse eid="PSA 148:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10" />Mehetoo, do7atoo,</para>
  <para style="q2" vid="PSA 148:10">sa7ara gooshettiza medhetatoo!</para>
  <para style="q2" vid="PSA 148:10">Paalliza kafotoo ubbatikka</para>
  <para style="q2" vid="PSA 148:10">iza galatite.<verse eid="PSA 148:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11" />Sa7aa kawotoo, kawoteththatoo!</para>
  <para style="q2" vid="PSA 148:11">Daannatoo, dere haarizaytoo!</para>
  <para style="q2" vid="PSA 148:11">Ubbatikka iza galatite.<verse eid="PSA 148:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12" />Panththatoo, geela7otoo,</para>
  <para style="q2" vid="PSA 148:12">cimatoo, naytoo!</para>
  <para style="q2" vid="PSA 148:12">Ubbatikka iza galatite.<verse eid="PSA 148:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13" />Iza sunththi ubbaa bolla dhoqqa;</para>
  <para style="q2" vid="PSA 148:13">iza bonchchoy</para>
  <para style="q2" vid="PSA 148:13">sa7appenne saloppe bolla;</para>
  <para style="q2" vid="PSA 148:13">hessa gishshas hayti ubbay</para>
  <para style="q2" vid="PSA 148:13">iza sunth galatetto.<verse eid="PSA 148:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14" />Iza bagga gidida Isra7eele asati</para>
  <para style="q2" vid="PSA 148:14">iza galatana mala</para>
  <para style="q2" vid="PSA 148:14">izi istta kace kessides.</para>
  <para style="b" vid="PSA 148:14" />
  <para style="q2" vid="PSA 148:14">GODAY galatetto!<verse eid="PSA 148:14" /></para>
  <chapter eid="PSA 148" />
  <chapter number="149" style="c" sid="PSA 149" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1" />GODAY galatetto!</para>
  <para style="q2" vid="PSA 149:1">GODAAS ooraththa</para>
  <para style="q2" vid="PSA 149:1">mazamure yexxite!</para>
  <para style="q2" vid="PSA 149:1">Geeshshata shiiqoson izas</para>
  <para style="q2" vid="PSA 149:1">galata mazamure yexxite!<verse eid="PSA 149:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2" />Isra7eele asati</para>
  <para style="q2" vid="PSA 149:2">bana medhdhidayssan</para>
  <para style="q2" vid="PSA 149:2">ufayettetto;</para>
  <para style="q2" vid="PSA 149:2">Xiyoone asati ba kawozan</para>
  <para style="q2" vid="PSA 149:2">keehippe ufayettetto.<verse eid="PSA 149:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3" />Durishe karabe baqqishenne</para>
  <para style="q2" vid="PSA 149:3">diith diixxishe iza sunth sabbetto.<verse eid="PSA 149:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4" />GODAY ba asan ufayettees;</para>
  <para style="q2" vid="PSA 149:4">ashketa ashshidi</para>
  <para style="q2" vid="PSA 149:4">bonchchon puulasees.<verse eid="PSA 149:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5" />He puulateththaan Xoossa asati</para>
  <para style="q2" vid="PSA 149:5">ufayssan yexxetto;</para>
  <para style="q2" vid="PSA 149:5">gadey wonttana gakkanaas</para>
  <para style="q2" vid="PSA 149:5">ililishe yexxetto.<verse eid="PSA 149:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6" />Istta doonan Xoossa galatay,</para>
  <para style="q2" vid="PSA 149:6">istta kushenkka</para>
  <para style="q2" vid="PSA 149:6">qara giththa mashshay de7o.<verse eid="PSA 149:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7" />Istti hessan kawoteththata bolla</para>
  <para style="q2" vid="PSA 149:7">halo kessana;</para>
  <para style="q2" vid="PSA 149:7">asaakka qaxxayana.<verse eid="PSA 149:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8" />Istta kawota sansalatan,</para>
  <para style="q2" vid="PSA 149:8">istta ola qaratakka</para>
  <para style="q2" vid="PSA 149:8">biratan qachchana.<verse eid="PSA 149:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9" />Hessan istta bolla</para>
  <para style="q2" vid="PSA 149:9">xaafettida pirda polidi</para>
  <para style="q2" vid="PSA 149:9">Xoossa asati xoonana.</para>
  <para style="b" vid="PSA 149:9" />
  <para style="q2" vid="PSA 149:9">GODAY galatetto!<verse eid="PSA 149:9" /></para>
  <chapter eid="PSA 149" />
  <chapter number="150" style="c" sid="PSA 150" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1" />GODAY galatetto!</para>
  <para style="b" vid="PSA 150:1" />
  <para style="q2" vid="PSA 150:1">Xoossa iza keeththan galatite;</para>
  <para style="q2" vid="PSA 150:1">iza wolqqay diza</para>
  <para style="q2" vid="PSA 150:1">salo gufanththon</para>
  <para style="q2" vid="PSA 150:1">iza galatite.<verse eid="PSA 150:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2" />Izi ooththida</para>
  <para style="q2" vid="PSA 150:2">wolqqama oosota gishshas</para>
  <para style="q2" vid="PSA 150:2">iza galatite;</para>
  <para style="q2" vid="PSA 150:2">izi keehi gita gidida gishshas</para>
  <para style="q2" vid="PSA 150:2">iza galatite!<verse eid="PSA 150:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3" />Zayen iza galatite;</para>
  <para style="q2" vid="PSA 150:3">bagananinne maasinqon</para>
  <para style="q2" vid="PSA 150:3">iza galatite.<verse eid="PSA 150:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4" />Karabe baqqishenne durishe</para>
  <para style="q2" vid="PSA 150:4">iza galatite;</para>
  <para style="q2" vid="PSA 150:4">tammu shayan waaxettida</para>
  <para style="q2" vid="PSA 150:4">diiththaninne</para>
  <para style="q2" vid="PSA 150:4">susul7en iza sabbite.<verse eid="PSA 150:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5" />Daala qaaththishe iza galatite;</para>
  <para style="q2" vid="PSA 150:5">daalaa shocishe iza galatite.<figure style="fig" alt="Different kind of singing instrument" file="BK00174B.TIF" size="span" ref="150:3-5">Dumma dumma yeththa miishshata</figure><verse eid="PSA 150:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6" />Shemppora paxa diza ubbay</para>
  <para style="q2" vid="PSA 150:6">GODAA galatite!</para>
  <para style="b" vid="PSA 150:6" />
  <para style="q2" vid="PSA 150:6">GODAY galatetto!<verse eid="PSA 150:6" /></para>
  <chapter eid="PSA 150" />
</usx>