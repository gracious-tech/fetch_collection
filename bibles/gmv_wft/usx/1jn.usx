<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Gamo Full Bible final version</book>
  <para style="h">1Yohannisa Kiita</para>
  <para style="toc1">Yohannisi Xaafida Koyro Kiita</para>
  <para style="toc2">1Yohannisa Kiita</para>
  <para style="toc3">1Yoha</para>
  <para style="mt1">Yohannisi</para>
  <para style="mt2">Xaafida Koyro Kiitaa</para>
  <para style="imt1">Giddo Qofa</para>
  <para style="ip">Yohannisi koyro yeddida kiitazan nam7u ayfe yooti deettes; heytikka he kiitaza nababizaytas Xoossaranne Xoossa Naa Yesus Kirstoosara issifeteththi de7ana mala istta minththeththanaassinne hessa he issifeteththaa dhayssiza wordo timirtefe istti naagettana malassa. Hayssi kiitay xaafettiza wode he alameza bolla keehi iita wordo timirtey dees; he timirtezikka issi issi ammaniza asata ammanoppe kare kessides; he wordo astamaareti tamaarsiza iita timirtey 1. «Xoossi Ayana alame xalla medhdhides. 2. Hayssa ha alamezan diza ayfen beettiza miish ubbaanne nu asateth Xoossi medhdhibeenna; hessa gishshas he medheteththati wurikka iita xalla. 3. Hayssi ayfen beettiza alamezinne nu asateththay nu Ayana qohanaassinne tunisanaas dandayenna.» Hessa guussi, «Koyro Xoossafe yida Yesusas asa asateththi deenna; qasseka nam7anththora issaadey hara asa bolla nagara ooththikonne izi hara as ixxiko hessaade oosozi iza ayana qohanaassinne tunisanaas dandayenna» guussa. Heyti he astamaareti, «Atoteththa guussi hayssa alameza duussas qoppontta ago koshshees» gi tamaarseettes. Hessarakka gaththidi, «Lo7o ooson gidiin woykko ase siiqoy mulekka koshshenna» gi tamaarseettes.</para>
  <para style="ip">Hessa gishshas Yohannisi ba kiitaan, «Hessaththo wordo timirtey tumu ammano timirtefe kare gididayssa tamaarssees; hessa he timirteza ixon Yesus Kirstoosi kumeththara asekko; Yesusan ammanizaytinne Xoos siiqizayti wurikka ba garsan issoy issaara siiqettanaas bessees» giidi erisides. Qasseka Yesusi tumappe asa asho may7idayssanne yelettidayssa kaddizaadey Xoossafe yelettibeenna. (4:2-3) Godaa Xoossaafe yelettonttaadey qasse Xoossaafe gididaade siiqanaas dandayenna; Xoossafe yelettidaadey ubba wode nagaran de7anaas dandayenna. (3:10)</para>
  <para style="iot">Ha Maxaafay Oykkida Kumeththa Qofa</para>
  <para style="io1">Geloso <char style="ior"><ref loc="1JN 1:1-4">1:1-4</ref> </char></para>
  <para style="io1">Poo7onne dhuma <char style="ior"><ref loc="1JN 1:5-2:29">1:5—2:29</ref> </char></para>
  <para style="io1">Xoossa naytanne Xala7e nayta <char style="ior"><ref loc="1JN 3:1-24">3:1-24</ref> </char></para>
  <para style="io1">Tumanne wordo <char style="ior"><ref loc="1JN 4:1-6">4:1-6</ref> </char></para>
  <para style="io1">Tumu siiqo <char style="ior"><ref loc="1JN 4:7-21">4:7-21</ref> </char></para>
  <para style="io1">Xooniza ammano <char style="ior"><ref loc="1JN 5:1-21">5:1-21</ref> </char></para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s1">De7o Qaala</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />De7o qaala gishshas koyroppe dizayssa nuni nu hayththan siyidayssanne nu ayfera be7idayssa lo7eththi xeellidayssa, nu kushera oykki be7idayssa gishshas haasayoos.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="JHN 1:1">Yoha 1:1</ref></char></note> <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" />De7oykka qonccides; nunikka nu ayfera be7idi markkattoos. Izas iza Aawaa achchan dizayssanne nuuska qonccida mernaa de7o gishshas nu inttes yootoos.<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="JHN 1:14">Yoha 1:14</ref></char></note> <verse eid="1JN 1:2" /><verse number="3" style="v" sid="1JN 1:3" />Intteska nunara issifeteththi daana mala nuni be7idayssanne siyidayssa inttes yootoos; nu issifeteththayka Aawaranne iza Naa Yesus Kirstoosara. <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />Nu ufayssay<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="fqa" closed="false">Nu ufayssay: </char><char style="ft" closed="false">Nu ufayssay gizayssi issi issi birsheththatan intte ufayssay geetettides.</char></note> kumeth gidana mala nu hayssa inttes xaafoos.<verse eid="1JN 1:4" /></para>
  <para style="s1">Poo7on Simereteth</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />Nu izappe siyidi inttes yootiza kiitay, «Xoossi poo7o; iza achchan mulekka dhumay deenna» gizayssa. <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />«Nu dhuman simerettishe izara nuus issifeteththi dees» giikko wordotoos attiin tuman dookko. <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />Gido attiin izi poo7on diza mala nunikka poo7on simerettiko nu garsan nuus issifeteththi dees; iza naa Yesus Kirstoosa suuththi nuna nagara ubbaafe geeshshees.<verse eid="1JN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8" />Nuni nunan nagaray baa giikko nurkka nuna baleththoos; tumaykka nunan deenna. <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />Nuni nu nagaraa paaxikko izi nu nagaraa atto gaanaassinne nu qohoppe nuna wursi geeshshanaas izi ammanettidaadenne xillo. <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />Nuni nagara ooththibeekko giikko iza nu wordanchcha kessoossinne iza qaalaykka nunan deenna.<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />Ta naytoo! Ta inttes hayssa xaafizay intte nagara ooththontta malassa; gido attiin oonikka nagara ooththiko Aawaa achchan nuus xabaqay dees; izikka xilloza Yesus Kirstoosa.<verse eid="1JN 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1JN 2:2" />Izi nu nagaray atto geetettana mala oge giigsizaade; hessika nuna xalla gidontta kumeththa alame asassara attiin nuus xalla gidenna. <verse eid="1JN 2:2" /><verse number="3" style="v" sid="1JN 2:3" />Nu iza azazota polikko nu iza eridayssa hessan eroos. <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />«Ta iza erays» gishe iza azazo polonttaade gidikko hessaadey wordo asa attiin tumay izaaden deenna. <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />Qasse oonikka iza qaalaa naagikko tumu Xoossa siiqoy izaaden polettides; nuni izan dizayssa nu erizay hessanna. <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />Ta izan days giza asi oonikka Yesusi simerettida mala simerettanaas bessees.<verse eid="1JN 2:6" /></para>
  <para style="s1">Ooraththa Azazo</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />Ta siiqotoo! Ta inttes xaafizayssi kase inttes dizaaro inttekon gam7ida azazoyo attiin hara ooraththa azazo gidenna; gam7ida azazoya kase intte siyida qaalayo. <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />Hara baggara ta inttes xaafizay Kirstoosa achchaninne intte achchan tumu gidida ooraththa azazo; gaasoykka dhumay aadhdhiin tumu poo7oy poo7isishe dees.<verse eid="1JN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9" />Poo7on days gishe ba ishaa ixxizaadey ha7ikka dhuman dees. <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />Ba ishaa siiqizaadey poo7on dees; hessaades dhuphe gidiza miishshi deenna. <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />Gido attiin ba ishaa ixxizaadey gidikko dhuma giddon dees; dhuman simerettees; dhumay iza qooqisida gishshas izi awa bizaakkonne ba bizaso erenna.<verse eid="1JN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12" />Ta naytoo! Intte nagaray Yesus Kirstoosappe dendidayssan atto geetettida gishshas ta inttes xaafays. <verse eid="1JN 2:12" /><verse number="13" style="v" sid="1JN 2:13" />Aawatoo! Kase koyroppe dizayssa intte eriza gishshas ta inttes xaafays; naateththatoo! Intte Xala7e xoonida gishshas ta inttes xaafays.<verse eid="1JN 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 2:14" />Naateththa naytoo! Intte Aawaa erida gishshas ta inttes xaafays; aawatoo! Koyroppe dizayssa iza intte erida gishshas ta inttes xaafays. Naateththatoo! Intte minota gidida gishshassinne Xoossa qaalay inttenan diza gishshas intte Xala7e xoonida gishshas ta inttes xaafays.<verse eid="1JN 2:14" /></para>
  <para style="s1">Alame Dosopite</para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />Hayssa alameza woykko ha alamezan diza ay miishsheka dosopite; oonikka ha alameza dosikko Aawaa siiqoy izaade achchan deenna. <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />Gaasoykka ha alamezan dizay wuri asho amoteth, ayfes lo7onne duussan ceeqeteth; hayti alameppe attiin Xoossaa aawappe yizayta gidettenna. <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />Alameynne alamen diza amoteththi aadhdhana; Xoossa shene polizayti gidikko mernaas daana.<verse eid="1JN 2:17" /></para>
  <para style="s1">Kirstoosara Eqettizaytappe Naageteth</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />Naytoo! Hayssi wurseththa saate; intte siyida mala Kirstoosara eqettizaadey yaana; ha7ikka Kirstoosara eqettiza daroti yida. Hayssi wurseththa saate gididayssa nu hayssan eroos. <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />Istti nu giddofe kezida; gido attiin istti kasekka nu bagga gidettenna; istti nu bagga gididaakko nunara minni eqqana; gido attiin istti wuri nu bagga gidonttayssi erettana mala nuuppe shaakettida.<verse eid="1JN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20" />Inttena qasse Kirstoosi Xillo Ayanan tiydes; hessa gishshas intte wurikka tumaa ereeta. <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />Ta inttes xaafizay intte tumaa erontta gishshas gidenna; gido attiin intte tumaa eriza gishshassinne tumaa garsafe aykko wordoyka beettonttayssa intte eriza gishshassa.<verse eid="1JN 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22" />Yesusa izi Kirstoosa gidenna gi kaddizaadefe hara wordanchchay oonee? Hessaadey Aawaanne Naaza kaddizayssi Kirstoosara eqettizaade. <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />Naaza kaddizaades oonaska Aaway deenna; Naaza ekkizaades ubbaas izas Aaway dees.<verse eid="1JN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24" />Intte koyro siyida qaalaya inttenan du; intte koyro siyidaara inttenan diikko intteka Naazaninne Aawaan daana. <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />Mernaa de7oy izi nuus immana gida hidota qaala.<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />Inttena baleththiza asata gishshas hayssa inttes xaafadis. <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />Intte qasse izappe ekkida Xillo Ayanay inttenan diza gishshas haray oonikka inttena tamaarsanaas bessenna; izi inttena tamaarsanayssi tuma attiin wordo gidenna; hessa gishshas Xillo Ayanay inttena tamaarsida mala Kirstoosan de7ite. <verse eid="1JN 2:27" /><verse number="28" style="v" sid="1JN 2:28" />Ha7i ta naytoo! Izi qoncciza wode nuus xalateththi daana mala izi yiza wodekka nu iza sinththan yeellatontta mala intte izan de7ite. <verse eid="1JN 2:28" /><verse number="29" style="v" sid="1JN 2:29" />Izi xillo gididayssa intte erizaa gidikko xillo ooththizay wuri izappe yelettidayssa intte ereeta.<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="s1">Xoossa Nayta</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />Nuni Xoossa nayta geetettana mala Aaway darssi siiqida iza siiqoy nuus ay mala gitakkonne ane be7ite! Tumukka nu iza nayta; alamey nuna erontta aggiday iza erontta aggida gishshassa. <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />Ta ishatoo! Nuni ha7i Xoossa nayta; buro nu ay hananaakko ha7i qonccibeenna; Kirstoosi qoncciza wode nu iza beyanayssanne izakka misatanayssa nu eroos. <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />Hayssa izan hidota ooththizay wuri izi geesh gidida mala bana geeshshees.<verse eid="1JN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4" />Nagara ooththizay wurikka makkalla ooththees; nagaraykka makkalla. <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />Izi nagara dhayssanaas qonccidayssa intte ereeta; izan nagaray baawa.<note caller="-" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="JHN 1:29">Yoha 1:29</ref></char></note> <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />Izan diza asi oonikka nagara ooththenna; nagara ooththizaadey oonikka gidikko iza beyibeenna woykko eribeenna.<verse eid="1JN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7" />Ta naytoo! Inttena oonikka baleththontta mala naagettite; izi xillo gidida mala xillo ooththizaadeyka xillo. <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />Nagara ooththizay Xala7eppe; gaasoykka Xala7ey koyroppeka nagara ooththizaade; Xoossa nay qonccidaykka Xala7e ooso laallanaassa.<verse eid="1JN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9" />Xoossafe yelettiday wuri nagara ooththenna; Xoossa zereththi izan diza gishshassinne izi Xoossafe yelettida gishshas nagara ooththana dandayenna. <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />Xoossa naytinne Xala7e nayti shaaketti erettizay hessanna; Xillo ooththonttaynne ba ishaa siiqonttay wuri Xoossafe gidenna.<verse eid="1JN 3:10" /></para>
  <para style="s1">Issoy Issaara Siiqeteth</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />Intte koyro siyidaara, «Nuni nu garsan siiqettana bessees» geetettida kiitaya hanno.<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="JHN 13:34">Yoha 13:34</ref></char></note> <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />Iita bagga gididi ba ishaa wodhida Qayeele mala gidopite; izi aazas wodhidee? Gaasoykka iza oosoy iita; ishaa oosoy lo7o gidida gishshassa.<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="GEN 4:8">Medhe 4:8</ref></char></note><verse eid="1JN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13" />Ta ishatoo! Inttena alame asay ixxiko malalettofte. <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" />Nuni nu ishata dosiza gishshas hayqoppe de7on pinnidayssa nu eroos; siiqoy bayndaadey wuri hayqo giddon dees.<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="JHN 5:24">Yoha 5:24</ref></char></note> <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />Ba ishaa ixxizaadey shemppo wodhida asa mala; shemppo wodhidaades mernaa de7oy bayndayssa intte ereeta. <verse eid="1JN 3:15" /><verse number="16" style="v" sid="1JN 3:16" />Yesus Kirstoosi ba shemppo nu gishshas aaththi immida gishshas siiqoy aazakko nu hessan eroos; nunikka nu shemppo nu ishata gishshas aaththi immanaas bessees. <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />Miishshi dizaadey oonikka ba ishay waayettishin be7idi izas mishettontta aggiko Xoossa siiqoy izan waani daanee? <verse eid="1JN 3:17" /><verse number="18" style="v" sid="1JN 3:18" />Ta naytoo! Tumu oosonppe attiin coo doonaninne qaalan xalla siiqeteth ane aggoos.<verse eid="1JN 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />Nuni tumu bagga gididayssa hayssan eroossinne nu wozinakka iza sinththan shempisoos. <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />Hessika nu wozinay nu bolla pirdiza miishshan ubbaan Xoossi nu wozina qofaappe bollara gidida gishshas izi ubbaa erees. <verse eid="1JN 3:20" /><verse number="21" style="v" sid="1JN 3:21" />Ta ishatoo! Nu wozinay nu bolla pirdontta aggiko nuna Xoossa sinththan yashissana miishshi deenna. <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />Nuni azazota naagiza gishshassinne iza ufayssizaaz ooththiza gishshas nu iza woossizaaz wursi nu izappe ekkana. <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" />Iza azazoykka nu iza Naaza Yesus Kirstoosa ammananassinne izi nuna azazida mala nuni nu giddon dosettana malassa.<note caller="-" style="x"><char style="xo" closed="false">3:23 </char><char style="xt" closed="false"><ref loc="JHN 13:34">Yoha 13:34</ref>; <ref loc="JHN 15:12">15:12</ref>,<ref loc="JHN 15:17">17</ref></char></note> <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />Iza azazota naagizayti wuri izan deettes; izikka isttan dees; izi nunan dizayssa nu izi nuus immida Ayanan eroos.<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s1">Ayana Paacci Xeelo</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />Ta ishatoo! Ayana wursi ammanopite; gido attiin ayanati Xoossafekkonne paacci xeellite; gaasoykka daro wordo nabeti biitta bolla laalettida. <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />Intte Xoossa Ayana erana ogey, «Yesus Kirstoosi asa asho may7idi yides» giza Ayanay wuri Xoossafekko! <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />«Yesus Kirstoosi asa asho may7idi yides» gontta ayanay Xoossafe gidenna; kase izi yaana gishin intte siyida Kirstoosara eqettiza ayanay hessa; ha7ikka izi alame bolla dees.<verse eid="1JN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4" />Ta naytoo! Intte Xoossayta; Intte istta xoonideta; gaasoykka inttenan dizay alamen dizayssafe aadhdhees. <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />Istti alame baggako; hessa gishshas istti haasayzay wuri alameppe kezizayssa; alame asay istti gizayssa siyees. <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />Nuni gidikko Xoossa bagga; Xoos erizay nu gizayssa siyanashin Xoossa bagga gidonttaadey gidikko nu gizayssa siyenna. Tumu Ayananne wordo ayana nu shaakki erizay hayssanna.<verse eid="1JN 4:6" /></para>
  <para style="s1">Xoossa Siiqo</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />Ta ishatoo! Siiqoy Xoossafe gidida gishshas nuni ane siiqettoos; as siiqiza asi wuri Xoossafe yelettidaadenne Xoos erizaade. <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />As siiqontta asi Xoos erenna; gaasoykka Xoossi siiqo. <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />Xoossay nu giddon ba siiqo qonccisiday nu iza baggara de7o demmana mala ba naa issineza haa duge ha alamezan yeddidayssana. <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />Nuni Xoos siiqibeekko shin izi nuna siiqides; nu nagaraa dhayssana mala ba naaza yeddides; siiqo guussika hessa.<verse eid="1JN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11" />Ta ishatoo! Xoossi nuna hayssaththo siiqikko nunikka nu giddon siiqettanaas bessees. <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />Xoos be7ida asi oonikka baa; nuni nu giddon siiqettizaa gidikko Xoossi nunan daana; iza siiqoykka nunan polettana.<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="JHN 1:18">Yoha 1:18</ref></char></note><verse eid="1JN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13" />Izi nuus ba Ayana immida gishshas nu izan dizayssanne izikka nunan dizayssa nu hessan eroos. <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />Aaway ba naaza hayssa ha alame asaa ashshanaas yeddidayssa nu be7idossinne iza gishshas markkattoos. <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />Yesusi Xoossa naa gididayssa ammanidi markkattiza ubbaan Xoossi deessinne izaadeyka Xoossan dees. <verse eid="1JN 4:15" /><verse number="16" style="v" sid="1JN 4:16" />Hessa gishshas Xoossi nuna siiqiza siiqo nu eroos; nu iza siiqon ammanettoos; Xoossi siiqo; siiqon dizaadey Xoossan dees; Xoossika hessaaden dees. <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />Nuni hayssa biittaa bolla de7izay Kirstoosi de7ida mala gidida gishshas nuus pirda gallas baboy deenna; hessankka siiqoy nunan kumeth gidees. <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />Siiqo giddon baboy baa; tumu siiqoy gidikko babo kessi wora yeggees; baboy qixaatera issife oyketti dees; babbizaade siiqoy kumeth gidenna.<verse eid="1JN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19" />Izi kasetidi nuna siiqida gishshas nunikka iza siiqoos. <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />Oonikka Xoos siiqays gishe ba ishaa ixxiko hessaadey wordanchcha; ba ayfera be7iza ba ishaa siiqontta asi ba ayfen be7ontta Xoossaa siiqanaas dandayenna. <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />«Xoos siiqiza asi wurikka ba ishaa siiqanaas bessees» giza ha azazoza izi nuus immides.<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s1">Xoossa Naan Ammano</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />Yesusi izi Kirstoosa gididayssa ammanizay wuri Xoossafe yelettides. Aawaa dosizay wuri naazakka izaththo dosees. <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />Nuni Xoos dosikkonne iza azazo naagikko nuni Xoossa nayta siiqizayssa hessan eroos. <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" />Xoossa doso guussi iza azazo naago; iza azazoti deexo gidettenna. <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />Gaasoykka Xoossafe yelettiday wuri alame xoonees; alame xoonizaykka nu ammano. <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />Yesusi Xoossa naa gididayssa ammanizaadefe attiin alame xoonizay haray oonee?<verse eid="1JN 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />Haaththaninne suuththan yiday hayssa Yesus Kirstoosa; izi haaththaninne suuththan yides attiin haaththan xalla yibeenna; hessaka iza gishshas markkattizay Ayana; he Ayanay tumu ayana. <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />Hessa gishshas izas heedzdzu markkati deettes. <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />Heytikka ayana, haaththenne suuth; heedzdzata qaalaykka issino. <verse eid="1JN 5:8" /><verse number="9" style="v" sid="1JN 5:9" />Nu asa markkateth ammanikko Xoossa markkateththi hessafe aadhdhees; hessika izi ba naaza gishshas immida Xoossa markkateththa. <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />Xoossa Naan ammaniza ubbaa wozinan iza gishshas markkateththi dees; Xoos ammanonttay wurikka Xoossi ba Naaza gishshas immida markkateththaa ammanontta gishshas iza wordosees.<verse eid="1JN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 5:11" />Iza markkateththika Xoossi mernaa de7o nuus immides; he de7oykka iza Naazan dees gizayssa.<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="JHN 3:36">Yoha 3:36</ref></char></note> <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />Naazi dizaades de7oy dees; Xoossa Nay bayndaades de7oy deenna.<verse eid="1JN 5:12" /></para>
  <para style="s1">Kuushsha Qofa</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />Inttes Xoossa Naan ammanizaytas mernaa de7oy dizayssa intte erana mala ta hayssa inttes xaafays. <verse eid="1JN 5:13" /><verse number="14" style="v" sid="1JN 5:14" />Nu Xoossa sinth shiiqanaas nuus diza xalateththi hayssa; nu ay miishshika iza shene mala woossiko izi nu woosaa siyana. <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />Nu iza woossiza miish izi ubbaa siyizayssa nu erizaa gidikko nu woossida miishshaa ubbaa ekkanayssa nu eroos.<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />Oonikka ba ishay bana hayqos gaththontta nagara ooththishin beyikko izas woosso; Xoossika hayqos gaththontta nagara ooththidaytas de7o immana; hayqos gaththiza nagaraykka dees; hayqos gaththiza nagara gishshas woosso giikke. <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />Makkallay wurikka nagara; hayqos gaththontta nagaraykka dees.<verse eid="1JN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18" />Xoossafe yelettiday wuri nagara ooththenna; gaasoykka Xoossa Nay iza naagizayssanne iitay iza bochchonttayssa nu eroos.<verse eid="1JN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19" />Nuni Xoossafe gididayssanne alamey kumeth iita asa kushen dizayssa nu eroos.<verse eid="1JN 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20" />Xoossa Nay yidayssanne nuni tuma Xoossaa erana mala akeeka izi nuus immidayssa nu eroos; nunikka tumu gidida iza Naaza Yesus Kirstoosan doos; Izikka tumu Xoossanne mernaa de7o.<verse eid="1JN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21" />Naytoo! Inttenateththaa eeqatappe naagite.<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>