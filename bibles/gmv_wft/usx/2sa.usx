<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2SA" style="id">- Gamo Full Bible final version</book>
  <para style="h">2Sameela Maxaafa</para>
  <para style="toc1">2Sameela Maxaafa</para>
  <para style="toc2">2Sameela Maxaafa</para>
  <para style="toc3">2Same</para>
  <para style="mt1">2Sameela Maxaafa</para>
  <para style="imt1">Giddo Qofa</para>
  <para style="ip">Nam7anththo Sameela maxaafay koyro Sameela maxaafappe kaallizayssa gidishin Dawiti koyro dugeha baggara Yuhuda kawo [1-4], guuththara gam7ishe pudeha baggara diza Isra7eelekka gujjidi dere ubbaas kawo gididi haaridayssa yootiza taarike [5-24]. Maxaafazi Dawiti ba kawoteththa aassanaassinne ba maataa minththanaas deraa giddoninne deraappe karera diza morkketara izi baaxetida mino baaxe paatti yootees. Dawiti ammanon minonne Xoossa siiqizaade; hessaththoka dereza achchan ammanettidaade gididayssa qonccisees; haraykka izi issi issi wode menxe iita ooso ooththizayssanne ba asho amo polanaas daro iita nagara ooththidayssa paatti yootees. Gidikkoka Xoossa nabe Naataaney izakko shiiqidi izi ooththida nagara iza erisiin izi ba nagaraa paaxidi Xoossi izas immida qixaateza ekkides.</para>
  <para style="ip">Dawite de7oynne izi ooththida oosoy Isra7eele asaa daro lo7ida gishshas izappe kaalliza wodetan deraa bolla metoy gakkishin gakkishin istti banttas hara kawoththanaas koyza wode, Dawite naa woykko Dawite zare gididi Dawite mala ayssiza as demmanaas amotteettes.</para>
  <para style="iot">Ha Maxaafay Oykkida Kumeththa Qofa</para>
  <para style="io1">Yuhudan Dawite kawoteth <char style="ior"><ref loc="2SA 1:1-4:12">1:1—4:12</ref> </char></para>
  <para style="io1">Kumeththa Isra7eelen Dawite kawoteth <char style="ior"><ref loc="2SA 5:1-24:25">5:1—24:25</ref> </char></para>
  <para style="io2">Izas koyro kawoteththa layththata <char style="ior"><ref loc="2SA 5:1-10:19">5:1—10:19</ref> </char></para>
  <para style="io2">Dawitenne Bersaabeho <char style="ior"><ref loc="2SA 11:1-12:25">11:1—12:25</ref> </char></para>
  <para style="io2">Metonne waaye <char style="ior"><ref loc="2SA 12:26-20:26">12:26—20:26</ref> </char></para>
  <para style="io2">Wurseththa layththata <char style="ior"><ref loc="2SA 21:1-24:25">21:1—24:25</ref> </char></para>
  <chapter number="1" style="c" sid="2SA 1" />
  <para style="s1">Dawiti Sa7oole Hayqo Sis</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 1:1" />Sa7ooli hayqqidaappe guye Dawiti Amaaleeqe asaa oli xoonidi simmides; Xigilaagenkka nam7u gallas gam7ides. <verse eid="2SA 1:1" /><verse number="2" style="v" sid="2SA 1:2" />Heedzdzanththo gallas daakettida may7o may7idi ba hu7e bolla gudulla laallidi issi naateththa naa dayssi Sa7oole gutappe yides. Dawitekko gakkida mala zaqulth zirxxi giidi bonchchos kushe denththides.<verse eid="2SA 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 1:3" />Dawitikka iza, «Ne awappe yadii?» giidi oychchides.</para>
  <para style="p" vid="2SA 1:3">Izi qasse, «Tani Isra7eele asay dizasoppe kessa ekka yadis» gides.<verse eid="2SA 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 1:4" />Dawiti qasse iza, «Aazee waaniday ane taas ubbaa yoota» giidi oychchides.</para>
  <para style="p" vid="2SA 1:4">Izikka Dawites, «Asazi olasoppe baqatides; daroy kundides; Sa7oolinne iza naa Yoonataaney hayqqida» gides.<verse eid="2SA 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 1:5" />Hessafe guye Dawiti woreza izas yootida naaza, «Sa7oolinne iza naa Yoonataaney hayqqidayssa aazan eradii?» gi oychchides.<verse eid="2SA 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 1:6" />Woreza izas yootida naateththa naazi izas zaaridi, «Toorontta dashe tani pude Gilbo7a zuma bolla kezadis; Sa7ooli heen ba toora bolla zemppi dishin para-gaaretinne toga asay goodereththishe iza bolla gakki wodhdhida. <verse eid="2SA 1:6" /><verse number="7" style="v" sid="2SA 1:7" />Izikka guye simmi xeellidi tana be7idi xeygides; tanikka, ‹Ta nees ay ooththoo?› gadis.<verse eid="2SA 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 1:8" />«Izikka tana, ‹Ne oonee?› gi oychchides. Tanikka izas, ‹Tani Amaaleeqe asa› gaada yootadis.<verse eid="2SA 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 1:9" />«Izikka taas, ‹Ta hayqqanaas toqqays; gido attiin taas shemppoy kezontta ixxides; zay haa ya; tana shempisa› gides. <verse eid="2SA 1:9" /><verse number="10" style="v" sid="2SA 1:10" />Histtiin tani izi kundichchidaappe guye izi attonttayssa erada ta izakko shiiqada iza wodhadis. Iza hu7e bolla diza kallachchazanne iza qese sagayoza ekkada hekko ta godaas ehadis» gides.<note caller="-" style="x"><char style="xo" closed="false">1:6-10 </char><char style="xt" closed="false"><ref loc="1SA 31:1-6">1Same 31:1-6</ref>; <ref loc="1CH 10:1-6">1Taari 10:1-6</ref></char></note><verse eid="2SA 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 1:11" />Hessafe guye Dawitinne izara diza asay ubbay bantta may7o daakkida. <verse eid="2SA 1:11" /><verse number="12" style="v" sid="2SA 1:12" />Istti mashshan siifettida gishshas Sa7oolessinne iza naa Yoonataanes, GODAA olanchchatassinne kumeththa Isra7eele asaas kayottida, yeekkidanne omars gakkanaas xoomida.<verse eid="2SA 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 1:13" />Dawiti qasse he woreza izas ehida naateththaza, «Ne awappe yadii?» gi oychchides. Naazikka, «Tani ne deren beti diza Amaaleeqe asa naa» gides.<verse eid="2SA 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 1:14" />Dawiti qasse, «Histtiin neni GODAY tiydayssa dhayssanaas ne kushe waana xala denththadii?» gi oychchides.<verse eid="2SA 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 1:15" />Hessafe guye Dawiti naateththatappe issaa xeygidi, «Neni izakko shiiqada iza wodha» gides. He naateththazi Amaaleeqeza caddi wodhides. <verse eid="2SA 1:15" /><verse number="16" style="v" sid="2SA 1:16" />Dawitikka Amaaleeqeza, « ‹GODAY tiydayssa tani wodhadis› gaada ne bolla nerkka ne markkattida gishshas ne suuththaa gomey ne bolla gido!» gides.<verse eid="2SA 1:16" /></para>
  <para style="s1">Sa7oole Gishshassinne Yoonataane Gishshas Shiiqida Zilassa Ginxo</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 1:17" />Dawiti Sa7oole gishshassinne Yoonataane hayqo gishshas zilalishe yeekkides. <verse eid="2SA 1:17" /><verse number="18" style="v" sid="2SA 1:18" />Qasseka, «Wondafe milas» geetettiza zilasaa Yuhuda deraa tamaarsana mala azazides. Hessi Yashaare Maxaafan xaafeti uttides.<note caller="-" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="JOS 10:13">Iya 10:13</ref></char></note><verse eid="2SA 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="2SA 1:19" />«Haysso Isra7eelee!</para>
  <para style="q2" vid="2SA 1:19">Ne bonchchoy zumbullata bolla</para>
  <para style="q2" vid="2SA 1:19">cadetti hayqqides;</para>
  <para style="q2" vid="2SA 1:19">ola qarati waani</para>
  <para style="q2" vid="2SA 1:19">hayssaththo kundidoo!<verse eid="2SA 1:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="2SA 1:20" />«Filisxeeme macca nayti</para>
  <para style="q2" vid="2SA 1:20">ufayettontta mala,</para>
  <para style="q2" vid="2SA 1:20">qaxxarettontta asaa macca nayti</para>
  <para style="q2" vid="2SA 1:20">ililontta mala,</para>
  <para style="q2" vid="2SA 1:20">hayssa Geeten woresopite;</para>
  <para style="q2" vid="2SA 1:20">Asqeloonankka awajjofte.<verse eid="2SA 1:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="2SA 1:21" />«Intteno Gilbo7a zumatoo!</para>
  <para style="q2" vid="2SA 1:21">Intte bolla iray bukkofo;</para>
  <para style="q2" vid="2SA 1:21">xaazaykka intte bolla dooppo;</para>
  <para style="q2" vid="2SA 1:21">yarshos gidiza kaththi</para>
  <para style="q2" vid="2SA 1:21">intte goshsha biittan mokkofo.</para>
  <para style="q2" vid="2SA 1:21">Heen ola qaraza</para>
  <para style="q2" vid="2SA 1:21">gondalley tunides;</para>
  <para style="q2" vid="2SA 1:21">Sa7oole gondalley</para>
  <para style="q2" vid="2SA 1:21">hayssafe guyen</para>
  <para style="q2" vid="2SA 1:21">zayten qucettenna.<verse eid="2SA 1:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="2SA 1:22" />Yoonataane wondafey</para>
  <para style="q2" vid="2SA 1:22">wodhontta simmi erenna;</para>
  <para style="q2" vid="2SA 1:22">Sa7oole mashshayka</para>
  <para style="q2" vid="2SA 1:22">morkke qanxxereththi yeggees;</para>
  <para style="q2" vid="2SA 1:22">Wolqqamatakka</para>
  <para style="q2" vid="2SA 1:22">menththereththi yeggees;</para>
  <para style="q2" vid="2SA 1:22">iza morkketakka wodhides.<verse eid="2SA 1:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="2SA 1:23" />«Sa7oolinne Yoonataaney</para>
  <para style="q2" vid="2SA 1:23">shemppora paxa dishe</para>
  <para style="q2" vid="2SA 1:23">siiqettizaytanne qofan gayttizayta.</para>
  <para style="q2" vid="2SA 1:23">Hayqqisheka shaakettonttayta;</para>
  <para style="q2" vid="2SA 1:23">golle kafoppe pilatizayta;</para>
  <para style="q2" vid="2SA 1:23">gaammofekka minnizayta.<verse eid="2SA 1:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="2SA 1:24" />«Intteno Isra7eele maccassatoo!</para>
  <para style="q2" vid="2SA 1:24">Ochcha teera misatiza al7o</para>
  <para style="q2" vid="2SA 1:24">qamisa inttena mayzida;</para>
  <para style="q2" vid="2SA 1:24">intte may7oza worqqa</para>
  <para style="q2" vid="2SA 1:24">xibaben alleqissida;</para>
  <para style="q2" vid="2SA 1:24">Sa7ooles yeekkite.<verse eid="2SA 1:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="2SA 1:25" />«Ola qarati waani hayssa mala</para>
  <para style="q2" vid="2SA 1:25">olason kundidoo!</para>
  <para style="q2" vid="2SA 1:25">Yoonataaney ne zumbullata bolla</para>
  <para style="q2" vid="2SA 1:25">cadetti hayqqides.<verse eid="2SA 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="2SA 1:26" />Ta isha Yoonataanee!</para>
  <para style="q2" vid="2SA 1:26">Tani ne gishshas kayottadis;</para>
  <para style="q2" vid="2SA 1:26">ne taas keeha al7okoshin;</para>
  <para style="q2" vid="2SA 1:26">ne siiqoy tana</para>
  <para style="q2" vid="2SA 1:26">malalisizaazakkoshin</para>
  <para style="q2" vid="2SA 1:26">macca siiqoppeka keehi</para>
  <para style="q2" vid="2SA 1:26">aadhdheeskoshin.<verse eid="2SA 1:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="2SA 1:27" />«Ola qarati waani kundidoo!</para>
  <para style="q2" vid="2SA 1:27">Ola massaratikka waani</para>
  <para style="q2" vid="2SA 1:27">hada gidanee!»<verse eid="2SA 1:27" /></para>
  <chapter eid="2SA 1" />
  <chapter number="2" style="c" sid="2SA 2" />
  <para style="s1">Yuhudan Dawite Kawoteth</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 2:1" />Hessafe guye Dawiti, «Tani Yuhuda katamatappe issineyn boo?» giidi GODAA oychchides.</para>
  <para style="q1" vid="2SA 2:1">GODAYKKA, «Ee ba» gides.</para>
  <para style="q2" vid="2SA 2:1">Dawiti zaaridi, «Katamatappe</para>
  <para style="q2" vid="2SA 2:1">awaarin boo?» gi oychchides.</para>
  <para style="q2" vid="2SA 2:1">GODAY qasse,</para>
  <para style="q2" vid="2SA 2:1">«Kebroone ba» gides.<verse eid="2SA 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 2:2" />Histtiin Dawiti ba machcheta nam7atara Kebroone bides. Isttika Izra7eelen yelettida Ahinahoomonne Qarmeloose dere as hayqqida Naabaale machcho Abigaalo.<note caller="-" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="1SA 25:42-43">1Same 25:42-43</ref></char></note> <verse eid="2SA 2:2" /><verse number="3" style="v" sid="2SA 2:3" />Hessaththoka Dawiti banara diza asaa isttaso asaara issife gaththi ehides. Isttika Kebroone katamatan uttida. <verse eid="2SA 2:3" /><verse number="4" style="v" sid="2SA 2:4" />Hessafe guye Yuhuda asay Kebroone yides. Heen Dawite tiydi Yuhuda deraa bolla kawoththida.</para>
  <para style="p" vid="2SA 2:4">Gala7aade deren Yaabuse asay Sa7oole ahaa moogidayssa Dawites yootiin,<note caller="-" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="1SA 31:11-13">1Same 31:11-13</ref></char></note> <verse eid="2SA 2:4" /><verse number="5" style="v" sid="2SA 2:5" />izikka Gala7aaden Yaabuse dere asaas hessa izas yootana mala qasttanne as yeddidi, «Hayssa mala ooththidi intte godaa Sa7oole moogidi intte lo7eteth bessida gishshas GODAY inttena anjjo. <verse eid="2SA 2:5" /><verse number="6" style="v" sid="2SA 2:6" />Ha7ikka GODAY inttes ba mino siiqonne ammaneteth qoncciso; intte ooththida lo7eteththaa gishshas tanikka inttes lo7o miish ooththana. <verse eid="2SA 2:6" /><verse number="7" style="v" sid="2SA 2:7" />Hessa gishshas minnite; goobite; intte goday Sa7ooli hayqqida gishshas Yuhuda asay tana tiydi ba bolla kawoththides» gides.<verse eid="2SA 2:7" /></para>
  <para style="s1">Isra7eele Asaa Bolla Iyaabuste Kawoteth</para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 2:8" />He wode Sa7oole ola asaa azaziza Neere naa Abineeri Sa7oole naa Iyaabuste ekkidi Mahanayme pinththides. <verse eid="2SA 2:8" /><verse number="9" style="v" sid="2SA 2:9" />Izakka Gala7aade, Aaseere, Izra7eele, Efreeme, Biniyaame bollanne kumeththa Isra7eele bolla kawoththides.<verse eid="2SA 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 2:10" />Sa7oole naa Iyaabustey Isra7eele bolla kawotishin izas layththay oyddu tammu; izi nam7u layth haarides. Yuhuda asay gidikko Dawite kaallides. <verse eid="2SA 2:10" /><verse number="11" style="v" sid="2SA 2:11" />Dawiti Kebroonen uttidi Isra7eele asaa laappun layththinne usuppun agina haarides.<verse eid="2SA 2:11" /></para>
  <para style="s1">Isra7eelesinne Yuhudas Giddon Dendida Ola</para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 2:12" />Neere naa Abineeri Sa7oole naa Iyaabuste oosanchchatara issi bolla Mahanaymeppe dendidi Geba7oone bida. <verse eid="2SA 2:12" /><verse number="13" style="v" sid="2SA 2:13" />Isttaka Xuriya naa Iyo7aabeynne Dawite asati ke7idi Geba7oone eele haaththa achchan gayttida. Issi baggay haaththaafe he pinththan, baggay haaththaafe ha pinththan uttida.<verse eid="2SA 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 2:14" />Hessafe guye Abineeri Iyo7aabes, «Ane nu baggafenne intte baggafe naateththa nayti dendidi nu sinththan ola tiran gayttetto» gides.</para>
  <para style="p" vid="2SA 2:14">Iyo7aabey, «Ero gayttetto» gides.<verse eid="2SA 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 2:15" />Hessa gishshas Biniyaame baggafe Iyaabustes tammanne nam7u asi qoodettides. Dawite baggafekka tammanne nam7u asi qoodettides. <verse eid="2SA 2:15" /><verse number="16" style="v" sid="2SA 2:16" />Hessafe guye issoy issoy ba morkke hu7e oykkidi mashshan millera caddishe issife oyketti kundida. Hessa gishshas Geba7oonen diza he biittazi, «Mashsha biitta» geetettides.<verse eid="2SA 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 2:17" />He gallassa olay keehi deexo; Abineerinne Isra7eele asay Dawite asaan xoonettida.<verse eid="2SA 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 2:18" />Xuriya attuma naa heedzdzati Iyo7aabey, Abisayeynne Asaheeley heen deettes. Asaheeley woran diza genessa mala woththas pilata. <verse eid="2SA 2:18" /><verse number="19" style="v" sid="2SA 2:19" />Izi Abineere oykkanaas hadirs ushach gontta iza geedora kaallides. <verse eid="2SA 2:19" /><verse number="20" style="v" sid="2SA 2:20" />Abineeri guye simmi xeellidi, «Asaheelee! Nenee!» gi oychchides. Izikka, «Ee tanakko!» gi zaarides.<verse eid="2SA 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 2:21" />Histtiin Abineeri iza, «Neni ta geedoppe hadirsa bagga woykko ushachcha bagga simmada naateth issaafe iza ola massara bonqqa ekka» gides. Gido attiin Asaheeley kaalettidi iza geedoppe duuxxontta ixxides.<verse eid="2SA 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 2:22" />Qasseka Abineeri izas, «Ne ta geedo kaalettizayssa aggiko nees lo7o; tani nena ays biittara oyseththoo? Histtida tani ne isha Iyo7aabe ayfeso dhoqqu gaada wostta xeelloo?» gides.<verse eid="2SA 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 2:23" />Asaheeley gidikko iza kaaleteth aggibeenna; hessa gishshas Abineeri ba toora xeeran izas ulon caddiin toorazi izas zokkozara kanththi kezides. Asaheeley heen gade bolla kundida mala heerakka hayqqides. Oonikka Asaheeley kundi hayqqidaso gakkishe eqqi ekkees.<verse eid="2SA 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 2:24" />Iyo7aabeynne Abisayey gidikko Abineere kaalettida; iza goodereththishe Geba7oone bazzo efiza ogezara Aye matan diza Aama zumbulla heera gakkishin arshey wullides. <verse eid="2SA 2:24" /><verse number="25" style="v" sid="2SA 2:25" />Hessafe Biniyaame asay Abineerekko shiiqidi zumbullaza xeeran issino gididi salfides.<verse eid="2SA 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 2:26" />Abineeri Iyo7aabe xeygidi, «Nuni mernaas ola olettishe daanee? Izas wurseththa gatey camo gididayssa ne waanada erontta aggadii? Ne asay ba ishata gooddizayssa aggana mala ne isttas azazo immonttay awude gakkanaassee?» gides.<verse eid="2SA 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 2:27" />Iyo7aabeykka zaaridi, «De7o Xoossay beyiin, ne hayssa yootontta aggidaakko asay wonttana gakkanaashe ba ishata goodo aggenna» gides.<verse eid="2SA 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 2:28" />Hessafe guye Iyo7aabey ba zaye punnides; asaykka ubbay Isra7eele gooddizayssa aggides. Olazi hessan eqqides.<verse eid="2SA 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 2:29" />Abineerinne iza asay omarsara Arabera kanththi bida; heeppe Yordaanoose shaafaa pinnidi ubbayka Bitiroonera kanththi Mahanayme yida.<verse eid="2SA 2:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 2:30" />Hessafe guye Iyo7aabey Abineere gooddizayssa aggi simmidi izi dereza shiishshida wode Dawite asaa giddofe Asaheeley attiin haray tammanne uddufun asi dhaydayssi erettides. <verse eid="2SA 2:30" /><verse number="31" style="v" sid="2SA 2:31" />Dawite asay gidikko Biniyaame asaappe Abineere kaalliza 330 as wodhides. <verse eid="2SA 2:31" /><verse number="32" style="v" sid="2SA 2:32" />Iyo7aabeynne izara diza asay Asaheeley kundidasohoppe iza ahaa denththidi Beeteliheemen iza aawa duufon moogida. Hessafe guye omars kumeth hemettishe aqidi buro gadey wontishin Kebroone gakkida.<verse eid="2SA 2:32" /></para>
  <chapter eid="2SA 2" />
  <chapter number="3" style="c" sid="2SA 3" />
  <para style="p">
    <verse number="1" style="v" sid="2SA 3:1" />Sa7oole keeththaa giddoninne Dawite keeththaa giddon diza olay daro wode gam7ides; Dawite baggay minni minni bishin Sa7oole baggay daaburi daaburi bides.<verse eid="2SA 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 3:2" />Dawiti Kebroonen dishin izas usuppun attuma nayti yelettida; izas bayra naazi Izra7eele dere as Ahinahoomppe Aminooney yelettides. <verse eid="2SA 3:2" /><verse number="3" style="v" sid="2SA 3:3" />Nam7anththo naazi Qarmeloose dere as Naabaale machcho Abigaalippe Kil7aabey yelettides; heedzdzanththo naazi Geeshure kawo Talimaye biyo Ma7ikippe Abeseloomey yelettides. <verse eid="2SA 3:3" /><verse number="4" style="v" sid="2SA 3:4" />Oydanththo naazi Adoniyaasi Hagitippe yelettides; ichchashanththo naazi Shafaaxiyay Abixaalippe yelettides; <verse eid="2SA 3:4" /><verse number="5" style="v" sid="2SA 3:5" />Usuppunththo naazi Dawite machcho Eglippe Yitiraamey yelettides; hayti Dawiti Kebroonen dishin izas yelettidayta.<verse eid="2SA 3:5" /></para>
  <para style="s1">Abineerenne Dawite Issifeteth</para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 3:6" />Sa7oole keeththinne Dawite keeththi olettishe diza wode Abineeri Sa7oole keeththan ba wolqqa minththishe dees. <verse eid="2SA 3:6" /><verse number="7" style="v" sid="2SA 3:7" />Sa7ooli Aaya biyo Erxifo laggeththo oykkides; Iyaabustey Abineere, «Ne ays ta aawa laggeththoyra aqadii?» gides.<verse eid="2SA 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 3:8" />Abineeri Iyaabuste haasayan keehi hanqettida gishshas, «Yuhuda maaddanaas tani gooshsha kanee? Hach gakkanaas tani ne aawa Sa7oole keeththaas, iza ishatassinne iza dabbotas ta ammaneteth pacinchchabeekke; nenakka Dawites aaththa immabeekke; gido attiin neni ha7i hanno ha maccassayra ta hanida miishshas tana mootay? <verse eid="2SA 3:8" /><verse number="9-10" style="v" sid="2SA 3:9-10" />GODAY Sa7oole keeththafe kawoteththaa woththi ekkidi Daaneppe biidi Bersaabehe gakkanaas diza Isra7eele bollanne Yuhuda bolla Dawite kawoteththaa caaqqi woththida caaqoza ta polontta aggiko Xoossi Abineere bolla iita miish eho» gides.<note caller="-" style="x"><char style="xo" closed="false">3:9-10 </char><char style="xt" closed="false"><ref loc="1SA 15:28">1Same 15:28</ref></char></note> <verse eid="2SA 3:9-10" /><verse number="11" style="v" sid="2SA 3:11" />Iyaabustey Abineeres keehi babbida gishshas zaaridi issi qaala phoqqanaas dandaybeenna.<verse eid="2SA 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 3:12" />Hessafe guye Abineeri Dawites, «Hanna biittaya oonassee? Tanara qaala gela; be7a Isra7eele ubbay neekko simmana mala ta nena maaddana» gi yootana mala ogath yeddides.<verse eid="2SA 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 3:13" />Dawitikka, «Ero lo7o; ta nenara qaala gelana; gido attiin ta neeppe issi miish koyays; hessika koyro taakko yashe Sa7oole biyo Milkoolo ne taas ekka yaana mala koyays; histtontta aggiko taakko yooppa» gides. <verse eid="2SA 3:13" /><verse number="14" style="v" sid="2SA 3:14" />Hessafe guye Dawiti, «Filisxeeme as xeetata attumateththaa ciloosha ciggada ekkida ta machcho Milkoolo taas imma» giidi Sa7oole naa Iyaabusteko ba qasttanneta kiittides.<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="1SA 18:27">1Same 18:27</ref></char></note><verse eid="2SA 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 3:15" />Hessa gishshas Iyaabustey ba qasttanneta kiittidi izi azina Laysha naa Palti7eelesoppe kessi ekkides. <verse eid="2SA 3:15" /><verse number="16" style="v" sid="2SA 3:16" />Izi azinay Bahirime gakkanaas yeekkishe izo kaalli bides. Hessafe guye Abineeri, «Ha7i nees gidana! Guye neso simma» gides.<verse eid="2SA 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 3:17" />Abineeri Isra7eele cimatara zorettishe isttas, «Kase aadhdhida woden Dawiti intte bolla kawotana mala koyideta. <verse eid="2SA 3:17" /><verse number="18" style="v" sid="2SA 3:18" />GODAY Dawites, ‹Ta aylle Dawite baggara tani ta deraa Isra7eele istta morkketa kusheppenne Filisxeemeta kusheppe ashshana› giza hidota qaala immi woththida gishshas hayssa intte ha7ira ooththite» gides.<verse eid="2SA 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 3:19" />Hessaththoka Abineeri Biniyaame qommotas barkka biidi hayssa yootides; hessafe guye Isra7eele asay Biniyaame keeththa asay ubbay ooththanaas koyida ubbaa Dawites yootanaas Kebroone bides. <verse eid="2SA 3:19" /><verse number="20" style="v" sid="2SA 3:20" />Abineeri 20 asatara Dawiti dizaso Kebroone bides; Dawitikka Abineeressinne izara diza as ubbaas gibira giigsides. <verse eid="2SA 3:20" /><verse number="21" style="v" sid="2SA 3:21" />Hessafe guye Abineeri Dawites, «Nenara istti caaqettana mala, ne wozinaykka amottida mala ne ubbaa haarana mala eeson baada ta godaa kawozas kumeththa Isra7eele ane shiishshays» gides. Hessa gishshas Dawiti Abineere moyzides; izikka saron bides.<verse eid="2SA 3:21" /></para>
  <para style="s1">Abineere Hayqo</para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 3:22" />Iyo7aabeynne Dawite asay he wode daro miish di7i ekkidi olaappe simmida. Abineeri gidikko Dawiti saron iza moyzida gishshas Kebroonen deenna. <verse eid="2SA 3:22" /><verse number="23" style="v" sid="2SA 3:23" />Iyo7aabeynne izara issife diza olanchcha ubbay hee gakkida mala Neere naa Abineeri kawozaakko yidayssa, kawozi iza moyzidayssanne izikka saron kezi bidayssa Iyo7aabey siyides.<verse eid="2SA 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 3:24" />Hessa gishshas Iyo7aabey kawozaakko gelidi, «Hayssi ne ooththidayssi aazee? Ane Abineeri ne kushen geliin waanada ne iza saron moyza yeddadii? <verse eid="2SA 3:24" /><verse number="25" style="v" sid="2SA 3:25" />Neere naa Abineere ne eraasa; izi yiday nena baleththanaas, ne waana kezizaakkonne gelizaakko eranaassinne ne ooththiza ubbaa wochchanaas yides» gides.<verse eid="2SA 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 3:26" />Hessafe guye Iyo7aabey Dawite achchafe kezides; Abineere ekki yaana mala as kiittides; kiitettida qasttanneti iza Seyren diza haaththa olla mata gakkishin zaarida; hessi hanishin Dawiti eribeenna. <verse eid="2SA 3:26" /><verse number="27" style="v" sid="2SA 3:27" />Abineeri guye Kebroone simmida wode Iyo7aabey iza xalla haasayssana koyza as misatidi issi bagga sher7i histtidi gede gimbeza penge efides; heen ba isha Asaheele suuth azarana koyidi izas ulon caddi wodhides.<verse eid="2SA 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 3:28" />Hessafe guye Abineere wodhidayssa Dawiti siyidi, «Taninne ta kawoteththay Neere naa Abineere suuththafe GODAA sinththan mernaas geeshsha. <verse eid="2SA 3:28" /><verse number="29" style="v" sid="2SA 3:29" />Iza suuththay Iyo7aabe hu7eninne iza aawa keeththa ubbaa bolla gido; asateththafe haaththi gogissiza hargey woykko guufen kal7atiza wobbey woykko mashshan hayqqizay woykko mizaazi dhayiin koshattizay Iyo7aabe keeththafe dhayoppo» gides.<verse eid="2SA 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 3:30" />Abineeri Geba7oonen olettida olaan Iyo7aabessinne Abisaye ishaa Asaheele wodhida gishshas isttika Abineere wodhida.<verse eid="2SA 3:30" /></para>
  <para style="s1">Dawite Kayoteth</para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 3:31" />Hessafe guye Dawiti Iyo7aabessinne izara issife diza asa ubbaas, «Intte may7o daakkidi, maaqa may7idi Abineere sinththan yeekkite» gides. Dawiti ba hu7era ahaa azhabides. <verse eid="2SA 3:31" /><verse number="32" style="v" sid="2SA 3:32" />Histtidi Abineere ahaa efidi Kebroonen moogida; kawozi Abineere duufo bolla waassi yeekkides; derezikka hessaththo yeekkides.<verse eid="2SA 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 3:33" />Kawozi Abineere gishshas kayo milas milalides;</para>
  <para style="q1" vid="2SA 3:33">«Abineeree! Shufuro asa mala</para>
  <para style="q2" vid="2SA 3:33">waana hayqqadii?<verse eid="2SA 3:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="2SA 3:34" />Ne kusheti qashettibeettenna;</para>
  <para style="q2" vid="2SA 3:34">ne tohoti agrimooqen</para>
  <para style="q2" vid="2SA 3:34">gelibeettenna;</para>
  <para style="q2" vid="2SA 3:34">asi iita asa sinththan kundiza mala</para>
  <para style="q2" vid="2SA 3:34">nekka hessaththo kundadasa.»</para>
  <para style="p" vid="2SA 3:34">Derezi ubbay qasse zaari yeekkides.<verse eid="2SA 3:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2SA 3:35" />Hessafe guye dere ubbay kath doonan gelththiza wode Dawitekko yiidi izi kath maana mala minththi woossida. Gido attiin Dawiti, «Arshey wullanaashe gakkanaas kath woykko hara miish doonan ta gelththiko Xoossay hayssa mala ta bolla eho; hayssafekka aadhdhiza miish ta bolla eho» gi caaqqides.<verse eid="2SA 3:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2SA 3:36" />Derezi ubbay hessa be7idi ufayettides; addafekka kawoza hanoy dereza ufayssides. <verse eid="2SA 3:36" /><verse number="37" style="v" sid="2SA 3:37" />Hessaththoka he gallas derezi ubbaynne kumeththa Isra7eeley kawoza kushey Neere naa Abineere hayqon bayndayssa erides.<verse eid="2SA 3:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 3:38" />Hessafe guye kawozi ba deraas, «Hach Isra7eelen daannaynne gita asi hayqqidayssa eribeekketii? <verse eid="2SA 3:38" /><verse number="39" style="v" sid="2SA 3:39" />Ta tiyettida kawo gidikkoka hach ta laafateththi taas erettides; hayti Xuriya nayti taas wolqqatida. GODAY iita ooththidaades iza ooso mala immo» gides.<verse eid="2SA 3:39" /></para>
  <chapter eid="2SA 3" />
  <chapter number="4" style="c" sid="2SA 4" />
  <para style="s1">Iyaabuste Hayqo</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 4:1" />Abineeri Kebroonen hayqqidayssa Sa7oole naa Iyaabustey siyida mala keehi yayyides; Isra7eele dereykka dagammides. <verse eid="2SA 4:1" /><verse number="2" style="v" sid="2SA 4:2" />He wode Sa7oole naa Iyaabustes kaaleththiza nam7u asati deettes; isttika Ba7aananne Erekaabe geetetteettes; istti Biniyaame qommotappe Bi7eroote dere yeleta gidida Armoone nayta; Bi7erootey Biniyaame katamatappe issiney mala qoodettawus. <verse eid="2SA 4:2" /><verse number="3" style="v" sid="2SA 4:3" />Bi7eroote asay Geetime baqati biidi hach gakkanaas heen bete as gididi dees.<verse eid="2SA 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 4:4" />Sa7oole naa Yoonataanes nam7u tohoti silida issi nay dees; Sa7oole hayqoynne Yoonataane hayqo worey Izra7eeleppe izakko gakkiza wode izas layththay ichchasha. Izikka toho sila gididay he wode iza dichchizaara ekkada eeson baqatishin kundida gishshassa. Iza sunththi Memfeboste geetettees.<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="2SA 9:3">2Same 9:3</ref></char></note><verse eid="2SA 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 4:5" />He wode Bi7eroote dere as Armoone nayti Erekaabeynne Ba7aanay Iyaabusteko baana dendida; izi gallassa shemppo ekkanaas ba hiixa bolla ishechchan dishin seeta gallas away seellishin izakko gakkida. <verse eid="2SA 4:5" /><verse number="6" style="v" sid="2SA 4:6" />Gistte koyza as misatidi keeththa giddo gelidi izas ulon caddida. Hessafe guye Erekaabeynne iza isha Ba7aanay luushu gi kezi bida.<verse eid="2SA 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 4:7" />Istti soo geliday Iyaabustey ba alga kifilen ichchi dishina; istti iza caddi wodhidaappe guye iza hu7e qanxxi ekkidi kumeththa omars Arabe ogera bida. <verse eid="2SA 4:7" /><verse number="8" style="v" sid="2SA 4:8" />Iyaabuste hu7e Dawitekko Kebroone efidi kawozas, «Nena wodhana koyza ne morkke Sa7oole naa Iyaabuste hu7e hayssa be7a; hekko GODAY hach ta godaa kawoza gishshas Sa7oole bollanne iza zereththaa bolla halo kessides» gida.<verse eid="2SA 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 4:9" />Dawitikka Bi7eroote dere as Armoone nayta Erekaabessinne iza isha Ba7aanas, «Tana metoppe ashshida De7o Xoossay be7iin, <verse eid="2SA 4:9" /><verse number="10" style="v" sid="2SA 4:10" />taas mishiraachcho qaala ehidaa izas misatiin, ‹Hekko Sa7ooli hayqqides› giidi taas yootidaade oykkada Xigilaagen wodhadis. Histtiko he addezas ta immida mogotay hessa.<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="2SA 1:1-16">2Same 1:1-16</ref></char></note> <verse eid="2SA 4:10" /><verse number="11" style="v" sid="2SA 4:11" />Histtiin ba keeththan ba alga bolla ichchi shempiza xillo as wodhida iita asatas iita qixaate immana bessennee? Iza suuththaa intte kusheppe accanaassinne inttena biittafe dhayssanaas taas bessennee?» gides.<verse eid="2SA 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 4:12" />Hessa gishshas Dawiti ba asata azaziin istti heyta wodhida; istta kushenne toho qanxxidi Kebroonen diza eele haaththa achchan kaqqida; Iyaabuste hu7e qanxxi ekkidi Kebroonen diza Abineere duufoza achchan moogida.<verse eid="2SA 4:12" /></para>
  <chapter eid="2SA 4" />
  <chapter number="5" style="c" sid="2SA 5" />
  <para style="s1">Isra7eele Bolla Dawite Kawoteth</para>
  <para style="r">(<ref loc="1CH 11:1-9">1Taari 11:1-9</ref>; <ref loc="1CH 14:1-7">14:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 5:1" />Isra7eele asay ubbay Kebroone Dawitekko biidi, «Hekko nuni ne meqeththatanne ne ashota. <verse eid="2SA 5:1" /><verse number="2" style="v" sid="2SA 5:2" />Kase Sa7ooli nu bolla kawoti diza wode Isra7eele ola asaa kaaleththizay nena; GODAY, ‹Ta dere Isra7eele naaganay nena; istta kaaleththanay nena gidana› giidi nees yooti woththides» gida.<verse eid="2SA 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 5:3" />Hessa gishshas Isra7eele asaa kaaleththizayti ubbay Kebroone yida; kawo Dawiti Kebroonen GODAA sinththan isttara caaqo qaala gelides; isttika Dawite tiydi Isra7eele bolla kawoththida.<verse eid="2SA 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 5:4" />Dawiti kawotishin izas layththay 30; izi 40 layth deraa ayssides. <verse eid="2SA 5:4" /><verse number="5" style="v" sid="2SA 5:5" />Izi Kebroonen uttidi Yuhuda bolla laappun layththinne usuppun agina, Yerusalaamen uttidi kumeththa Isra7eele bollanne Yuhuda bolla 33 layth kawotides.<verse eid="2SA 5:5" /></para>
  <para style="s1">Yerusalaame Xooneteth</para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 5:6" />Kawozinne iza asay Yerusalaamen diza Yaabuse asaa olanaas hee bida. Yaabuse asaykka Dawite, «Dawiti hayssan gelana dandayenna» gi qoppida gishshas Dawites, «Haray attoshin qooqetinne wobbeti nena teqqana; hessa gishshas ne haa gelakka» gida. <verse eid="2SA 5:6" /><verse number="7" style="v" sid="2SA 5:7" />Gido attiin Dawiti Xiyoone miixa oykkides; hinnaka ha7i Dawite katama geetettizasohoyo.<verse eid="2SA 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 5:8" />He gallas Dawiti, «Yaabuse asaa xoonana koyzay, Dawite morkke gidida wobbetakkonne qooqetakko gakkanaas haath pinniza purdera pudunththaa kezanaas bessees» gides; hessa gishshas, «Wobbetinne qooqeti kawo keeth gelettenna» geetettides.<verse eid="2SA 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 5:9" />Hessafe guye Dawiti miixayo baas duussaso histtides; izo, «Dawite katama» gi sunththides. Dawiti Miiloppe doommidi izo giddo aaththidi yuuyi aadhdhanaas gimbides. <verse eid="2SA 5:9" /><verse number="10" style="v" sid="2SA 5:10" />GODAY Ubbaafe Wolqqama Xoossay izara diza gishshas Dawiti ubba wode minni minni bides.<note caller="-" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="2SA 1:1-16">2Same 1:1-16</ref></char></note><verse eid="2SA 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 5:11" />He wode Xiroose kawo Kiraamey Dawitekko as kiita yeddides; hessaththoka ziga mith massiza hiillanchchatanne shuch massiza hiillanchchata yeddides; isttika Dawites kawo keeth keexxida. <verse eid="2SA 5:11" /><verse number="12" style="v" sid="2SA 5:12" />GODAY Isra7eele bolla iza kawoteththaa minththidayssa, ba deraa Isra7eele gishshas iza kawoteththaa aassidayssa Dawiti erides.<verse eid="2SA 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 5:13" />Dawiti Kebrooneppe bidaappe guye kaseyta bolla Yerusalaamen hara laggeththota woththides; machchetakka ekkides; hara attuma naytinne macca nayti izas yelettida. <verse eid="2SA 5:13" /><verse number="14" style="v" sid="2SA 5:14" />Izi Yerusalaamen yelida nayti, Shaamu7e, Shoobaabe, Naataane, Solomoone, <verse eid="2SA 5:14" /><verse number="15" style="v" sid="2SA 5:15" />Iyabeheere, Elshu7e, Nefege, Naafiya, <verse eid="2SA 5:15" /><verse number="16" style="v" sid="2SA 5:16" />Elshama, El7aadanne Elfaleexe geetetteettes.<verse eid="2SA 5:16" /></para>
  <para style="s1">Filisxeeme Xooneteth</para>
  <para style="r">(<ref loc="1CH 14:8-17">1Taari 14:8-17</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 5:17" />Dawiti Isra7eele asaa bolla kawotidayssa Filisxeeme asay siyidi iza koyanaas gixxi dendides; hessa siyidi Dawiti duge ba miixa wodhdhides. <verse eid="2SA 5:17" /><verse number="18" style="v" sid="2SA 5:18" />He wode Filisxeeme asay yiidi Erafayme shoobban laaletti dunkaanides. <verse eid="2SA 5:18" /><verse number="19" style="v" sid="2SA 5:19" />Hessa gishshas Dawiti GODAA, «Baada Filisxeeme asaara olettoo? Ne istta ta kushen aaththa immanee?» gi oychchides.</para>
  <para style="p" vid="2SA 5:19">GODAYKKA iza, «Ee ba; tumappe Filisxeemeta tani ne kushen aaththa immana» gides.<verse eid="2SA 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 5:20" />Hessa gishshas Dawiti Ba7aali-Paraaxime<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="ft" closed="false">Ibraaweta qaalara Ba7aali-Paraaxime guussi Menththereththidi gelida godaa guussa.</char></note> biidi Filisxeeme asaa oli xoonides; izikka, «Di7o haaththi dhuuqqi kezidi laalliza mala, GODAY ta morkketa ta sinththafe laallides» gides. Hessa gaason he sohoza sunththi Ba7aali-Paraaxime geetettides. <verse eid="2SA 5:20" /><verse number="21" style="v" sid="2SA 5:21" />Filisxeeme asay ba eeqa xoossata yeggi aggidi baqatida gishshas Dawitinne iza kaalliza asay di7i ekki bida.<verse eid="2SA 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 5:22" />Filisxeeme asay qasseka yiidi Erafayme shoobban laaletti dunkaanides. <verse eid="2SA 5:22" /><verse number="23" style="v" sid="2SA 5:23" />Hessa gishshas Dawiti GODAA oychchides; GODAYKKA izas, «Isttafe guye baggara istta giddoththada balasaane miththaafe sinththa baggara baada isttara gaytta attiin istti dizaso sitti ga kezoppa. <verse eid="2SA 5:23" /><verse number="24" style="v" sid="2SA 5:24" />Balasaane miththa xeera bollara ola giiris siyiza wode GODAY Filisxeeme ola asaa olanaas neeppe kaseti kezides guus gidida gishshas he wode eesotada sinth sitti ga ba» gides. <verse eid="2SA 5:24" /><verse number="25" style="v" sid="2SA 5:25" />Hessa gishshas Dawiti GODAY iza azazida mala ooththides; Filisxeeme asaakka Geebappe biidi Gezeere gakkanaas gooddi gooddi shocides.<verse eid="2SA 5:25" /></para>
  <chapter eid="2SA 5" />
  <chapter number="6" style="c" sid="2SA 6" />
  <para style="s1">Yerusalaame Caaqo Qaala Taabotaa Buus</para>
  <para style="r">(<ref loc="1CH 13:1-14">1Taari 13:1-14</ref>; <ref loc="1CH 15:25-16:6">15:25—16:6,43</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 6:1" />Qasseka Dawiti Isra7eele asaappe doorettida 30,000 as shiishshides. <verse eid="2SA 6:1" /><verse number="2" style="v" sid="2SA 6:2" />Izinne izara diza asay ubbay kirube bolla uttida GODAA Ubbaafe Wolqqama Xoossa sunththan xeygettida Xoossa Caaqo Qaala Taabotaa ehanaas Ba7aali-Yuhuda geetettizaso bida.<note caller="-" style="x"><char style="xo" closed="false">6:2 </char><char style="xt" closed="false"><ref loc="EXO 25:22">Kessa 25:22</ref></char></note> <verse eid="2SA 6:2" /><verse number="3" style="v" sid="2SA 6:3" />Xoossa Caaqo Qaala Taabotaza ooraththa para-gaaren woththida; zumbulla bolla diza Abinadaabe keeththafe kessi ehida; para laaggizayti Aminadaabe naa Oozanne Ahiyo.<note caller="-" style="x"><char style="xo" closed="false">6:3 </char><char style="xt" closed="false"><ref loc="1SA 7:1-2">1Same 7:1-2</ref></char></note> <verse eid="2SA 6:3" /><verse number="4" style="v" sid="2SA 6:4" />Xoossa Caaqo Qaala Taabotazi para-gaareza bolla dishin Ahiyoy izappe sinththara bees. <verse eid="2SA 6:4" /><verse number="5" style="v" sid="2SA 6:5" />Dawitinne Isra7eele asay ubbay yeththan, diiththan, maasinqon, karaben, xinaaxileninne daalan baas diza wolqqa ubbaan GODAA sinththan guppida (kaa7ida).<verse eid="2SA 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 6:6" />Istti Nakoone kaththa bale gakkishin boorati dhuphettida gishshas Oozay ba kushe yeddidi Caaqo Qaala Taabotaza oykkides. <verse eid="2SA 6:6" /><verse number="7" style="v" sid="2SA 6:7" />Oozay hessa xalateththan ooththida gishshas GODAA hanqoy iza bolla eexxides; hessa gishshas Xoossay iza wodhides; izikka heen Xoossa Caaqo Qaala Taabotaa achchan hayqqides.<verse eid="2SA 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 6:8" />GODAA hanqoy Ooza wodhida gishshas Dawiti muuzottidessinne ceecides; he sohozi hach gakkanaas, «Paareese-Oozaane» geetettees.<verse eid="2SA 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 6:9" />Dawiti he gallas GODAAS babbida gishshas, «GODAA Caaqo Qaala Taabotay waani taakko yaanee?» gides. <verse eid="2SA 6:9" /><verse number="10" style="v" sid="2SA 6:10" />Hessa gishshas Dawiti GODAA Caaqo Qaala Taabotaa banara daana mala Dawite katama ekki baana koyibeenna; hessa gishshas oge laammidi Geete dere as Abidaare soo efissides. <verse eid="2SA 6:10" /><verse number="11" style="v" sid="2SA 6:11" />GODAA Caaqo Qaala Taabotay Geete dere as Abidaare keeththan heedzdzu agina uttides; GODAY Abidaarenne izaso asaa ubbaa anjjides.<note caller="-" style="x"><char style="xo" closed="false">6:11 </char><char style="xt" closed="false"><ref loc="1CH 26:4-5">1Taari 26:4-5</ref></char></note><verse eid="2SA 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 6:12" />He wode, «Xoossa Caaqo Qaala Taabotaa gaason GODAY Abidaare, izaso asaanne izas diza ubbaa anjjides» giidi Dawites yootida. Hessa gishshas Dawiti hee biidi, Xoossa Caaqo Qaala Taabotaa Abidaaresoppe Dawite katama gita ufayssan efides. <verse eid="2SA 6:12" /><verse number="13" style="v" sid="2SA 6:13" />He GODAA Caaqo Qaala Taabotaa tookkida asati usuppun tanggo bida qoodan issi booraynne issi modhdho mari yarshettees. <verse eid="2SA 6:13" /><verse number="14" style="v" sid="2SA 6:14" />Dawiti laynoppe dadettida eefude ba xeessan gixxidi kumeththa wolqqan GODAA sinththan maggulides. <verse eid="2SA 6:14" /><verse number="15" style="v" sid="2SA 6:15" />Hessa malan Dawitinne kumeththa Isra7eele asay ufayssan ililishenne zaye punnishe GODAA Caaqo Qaala Taabotaa pude ehida. <verse eid="2SA 6:15" /><verse number="16" style="v" sid="2SA 6:16" />GODAA Caaqo Qaala Taabotay Dawite katama gelishin Sa7oole naa Milkoola maskootera xeelladus; kawo Dawiti GODAA sinththan guppishininne durishin be7ada ba wozinara iza kadhadus.<verse eid="2SA 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 6:17" />Hessafe guye GODAA Caaqo Qaala Taabotaa ehidi Dawiti izas tokkida Dunkaaneza giddon izas giigsidasohozan woththida; Dawitikka xuugettiza yarshonne issifeteththa yarsho GODAA sinththan shiishshides. <verse eid="2SA 6:17" /><verse number="18" style="v" sid="2SA 6:18" />Dawiti xuugettiza yarshozanne issifeteththa yarshoza shiishshidaappe guye dereza Ubbaafe Wolqqama GODAA sunththan anjjides. <verse eid="2SA 6:18" /><verse number="19" style="v" sid="2SA 6:19" />Isra7eele bagga gidida as ubbaas, attumasinne maccas issaas issaas issi issi uketh, issi issi muxo ashonne issi issi zabibe kompa immides; hessafe ubbayka baso baso bida.<verse eid="2SA 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 6:20" />Dawiti baso asaa anjjanaas baso simmi biin Sa7oole naa Milkoola iza mokkana kezada, «Hach Isra7eeleta kawoy gita asata garadeta sinththan coo laafa asa mala kallo beetoy izas bonchcho gidiinee?» gadus.<note caller="-" style="x"><char style="xo" closed="false">6:19-20 </char><char style="xt" closed="false"><ref loc="1CH 16:43">1Taari 16:43</ref></char></note> <verse eid="2SA 6:20" /><verse number="21" style="v" sid="2SA 6:21" />Dawitikka izis, «Ee, ne aawappenne ta keeththan diza ubbaafe aaththidi GODAA dere Isra7eele ayssana mala tana doorida GODAA sinththan maguladis; ha7ikka ta magulana. <verse eid="2SA 6:21" /><verse number="22" style="v" sid="2SA 6:22" />Hessafekka bollara kaseppe aaththada tanateththaa kawushshana; hessafe aadhdhada kadhettidaade gidana; gido attiin ne kadhida garadeta sinththan ta bonchchettana» gides.<verse eid="2SA 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 6:23" />Sa7oole naa Milkoola hayqqanaashe gakkanaas naa yelabeekku.<verse eid="2SA 6:23" /></para>
  <chapter eid="2SA 6" />
  <chapter number="7" style="c" sid="2SA 7" />
  <para style="s1">Xoossi Dawites Immida Hidota</para>
  <para style="r">(<ref loc="1CH 17:1-15">1Taari 17:1-15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 7:1" />Kawozi ba kawoteththa keeththan woppu gi uttidaappenne GODAY iza yuushon diza iza morkketappe shempisidaappe guye, <verse eid="2SA 7:1" /><verse number="2" style="v" sid="2SA 7:2" />nabe Naataanes, «Hekko tani zigappe keexettida kawoteththa keeththan days; Xoossa Caaqo Qaala Taabotay gidikko dunkaanen dees» gides.<verse eid="2SA 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 7:3" />Naataaneykka, «GODAY nenara gidida gishshas ne qoppida ubbaa ooththa» gides.<verse eid="2SA 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 7:4" />He gallassa omars GODAA qaalay Naataanekko yiidi, <verse eid="2SA 7:4" /><verse number="5" style="v" sid="2SA 7:5" />«Neni baada ta aylle Dawites: Ta izan daana keeth ne keexxaka. <verse eid="2SA 7:5" /><verse number="6" style="v" sid="2SA 7:6" />Tani Isra7eele asaa Gibxeppe kesoosofe doommada hach gakkanaas dunkaane taas aqoso histtada issisoppe haraso yuuya yuuya de7adis attiin keeththan de7abeekke. <verse eid="2SA 7:6" /><verse number="7" style="v" sid="2SA 7:7" />Tani Isra7eele asaara bidaso ubbaan ta dere Isra7eele naagana mala ta azaziin kaaleththizaytappe issaa, ‹Ne taas ziga miththafe ays keexxabeekkii?› gidaadey dizee?<verse eid="2SA 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 7:8" />«Ha7ikka ta aylle Dawites Ubbaafe Wolqqama GODAY: Ta dere Isra7eele ne ayssana mala ta nena denththadis; dors heemmizasohoppe ta nena ekkadis. <verse eid="2SA 7:8" /><verse number="9" style="v" sid="2SA 7:9" />Ne bidaso ubbaan ta nenara gidadis; ne morkketa ubbaa ta ne sinththafe dhayssadis; ha7ikka istta sunththay biitta bolla keehi erettida daro gita asatappe issaa sunththa mala ta ne sunththaa dhoqqisana. <verse eid="2SA 7:9" /><verse number="10" style="v" sid="2SA 7:10" />Izas buzo duussasoy daana mala hayssafe qaaxxontta mala ta dere Isra7eeles soho immananne minththana. Hayssafe kase hanida mala hayssafe guye iita derey istta un7eththenna. <verse eid="2SA 7:10" /><verse number="11" style="v" sid="2SA 7:11" />Ta dere Isra7eele kaaleththizayta ta shuumida wodeppe doommidi istti iza bolla ooththidayssaththo hayssafe guye iza bolla oosettenna; hessaththoka ne morkketa ubbaafe ta nena naagana. GODAY ba hu7era keeth nees keexxanayssa izi yootees. <verse eid="2SA 7:11" /><verse number="12" style="v" sid="2SA 7:12" />Ne layththaa wursada kase ne aawatanne gayttiza wode nena laattana zereth ta neeppe kessana; iza kawoteththaaka ta minththana.<note caller="-" style="x"><char style="xo" closed="false">7:12 </char><char style="xt" closed="false"><ref loc="PSA 89:3-4">Maza 89:3-4</ref>; <ref loc="PSA 132:11">132:11</ref>; <ref loc="JHN 7:42">Yoha 7:42</ref>; <ref loc="ACT 2:30">Hawa 2:30</ref></char></note> <verse eid="2SA 7:12" /><verse number="13" style="v" sid="2SA 7:13" />Ta sunththaas keeth keexxanay iza; tanikka iza kawoteththaa mernaas minththana. <verse eid="2SA 7:13" /><verse number="14" style="v" sid="2SA 7:14" />Ta izas aawa gidana; izikka taas naa gidana; izi mooro ooththiko as muriza guufera ta iza murana; asa nay lisson garafettiza mala ta iza garafana.<note caller="-" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="PSA 89:26-27">Maza 89:26-27</ref>; <ref loc="2CO 6:18">2Qoro 6:18</ref>; <ref loc="HEB 1:5">Ib 1:5</ref></char></note> <verse eid="2SA 7:14" /><verse number="15" style="v" sid="2SA 7:15" />Ta maaroteththaa neeppe kase diza Sa7ooleppe haassidayssaththo ta izappe haassike. <verse eid="2SA 7:15" /><verse number="16" style="v" sid="2SA 7:16" />Ne keeththaynne ne kawoteththi ta sinththan mernaas minni daana; ne kawoteththa araataykka mernaas minni daana» gides.<note caller="-" style="x"><char style="xo" closed="false">7:16 </char><char style="xt" closed="false"><ref loc="PSA 89:36-37">Maza 89:36-37</ref></char></note><verse eid="2SA 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 7:17" />Naataaney hayssa ajjuuta qaala kumeth Dawites yootides.<verse eid="2SA 7:17" /></para>
  <para style="s1">Dawite Woosa</para>
  <para style="r">(<ref loc="1CH 17:16-27">1Taari 17:16-27</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 7:18" />Hayssafe guye kawo Dawiti geli GODAA sinththan uttidi,</para>
  <para style="p" vid="2SA 7:18">«Ubbaa Haariza GODAWU! Ne tana hayssas gaththanaas ta oonee? Taso asaykka aazee? <verse eid="2SA 7:18" /><verse number="19" style="v" sid="2SA 7:19" />Ubbaa Haariza GODAWU, hayssi ne sinththan guuth gidishin ne gidikko ne ayllezasoy sinththafe hananayssa yootadasa; Ubbaa Haariza GODAWU! Ne asara gayttiza lose ogey hayssee?<verse eid="2SA 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 7:20" />«Dawiti nena hayssafe bollara hara ay gaana dandayzee? Ubbaa Haariza GODAWU, ne aylleza ne eraasa. <verse eid="2SA 7:20" /><verse number="21" style="v" sid="2SA 7:21" />Ne qaalaza gishshassinne ne wozina qofa mala ne hayssa gita miish ooththadasa; ne ayllezi erana mala qonccisadasa.<verse eid="2SA 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 7:22" />«Ubbaa Haariza GODAWU, ne ay mala gitaa! Mulekka nena misatizay oonikka deenna; nuni nu hayththara siyida mala neeppe attiin hara Xoossi deenna.<verse eid="2SA 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 7:23" />«Ba dere gidana mala iza ashshanaas Xoossi izappe sinththara bida derey, ba sunththas ooththana mala kawoteththatanne istta eeqa xoossata ba sinththafe gooddidi gitanne yashissiza malaata ooththidi Gibxeppe wozzi ekkida ne dere Isra7eele malay biitta bolla ooni dizee?<note caller="-" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="DEU 4:34">Zaare 4:34</ref></char></note> <verse eid="2SA 7:23" /><verse number="24" style="v" sid="2SA 7:24" />Ne dereza Isra7eele mernaas nees buzo dere ooththada minththadasa; GODAWU, ne iza Xoos gidadasa.<verse eid="2SA 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 7:25" />«Ha7ikka GODAA Xoossawu, neni ne ayllezasinne iza keeththaas immida hidotaa mernaas naaga; ne yootida malakka pola; <verse eid="2SA 7:25" /><verse number="26" style="v" sid="2SA 7:26" />hessa gishshas ne sunththi mernaas gita gidana; asaykka, ‹Ubbaafe Wolqqama GODAY Isra7eele Xoossaa› gaana. Ne aylle Dawite keeththay ne sinththan mino gidana.<verse eid="2SA 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 7:27" />«Abeet Ubbaafe Wolqqama GODAWU, Isra7eele Xoossawu, ‹Ta nees keeth keexxana› gaada hessa taas ne ayllezas qonccisadasa. Hessa gishshas ne ayllezi ha woosayo woossanaas ba wozinan xalides. <verse eid="2SA 7:27" /><verse number="28" style="v" sid="2SA 7:28" />Abeet Ubbaa Haariza GODAWU! Neni Xoossa; ne qaalaykka ammanettidayssa; hayssa lo7o miish ooththanaas neni ne ayllezas hidota immadasa. <verse eid="2SA 7:28" /><verse number="29" style="v" sid="2SA 7:29" />Izi ne sinththan mernaas minni daana mala, ha7ikka ne aylleza keeth anjjarkkii! Abeet Ubbaa Haariza GODAWU! Hayssa nerkka ne yootadasa; ne anjjon ne aylleza keeththi mernaas anjjettana» gides.<verse eid="2SA 7:29" /></para>
  <chapter eid="2SA 7" />
  <chapter number="8" style="c" sid="2SA 8" />
  <para style="s1">Dawiti Xoonida Xoonota</para>
  <para style="r">(<ref loc="1CH 18:1-17">1Taari 18:1-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 8:1" />Hessafe guye Dawiti Filisxeeme asaa xoonides; ba shene garsan ayssides; Metegi-Aama geetettiza katamayo Filisxeemeta kusheppe woththi ekkides.<verse eid="2SA 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 8:2" />Hessaththoka Dawiti Mo7aabeta xoonides; istta biitta bolla ishisidi wodoron wadhdhi xeellides; wadhdhi xeellidaytappe nam7u kushe gidizayta izi wodhiin issi kushe gidizayti paxa attida; hessa gishshas Mo7aabe asay Dawites haarettidessinne izas giirides.<verse eid="2SA 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 8:3" />Hessafekka hara Dawiti Efiraaxise shaafa matan diza dereza zaari oykkana biidi, Xoobba kawo Erahoobe naa Hadaadi7eezere oli xoonides. <verse eid="2SA 8:3" /><verse number="4" style="v" sid="2SA 8:4" />Dawiti izappe 1,000 para-gaareta, 7,000 toganchchata,<note caller="+" style="f"><char style="fr" closed="false">8:4 </char><char style="ft" closed="false">1,000 para-gaareta, 7,000 toganchchata gizayssa issi issi Geeshsha maxaafatan 17,000 toganchchata gees.</char></note> 20,000 olanchchata di7ides; 100 para-gaareta xalla ashshidi hankkoyta ubbaa gildayi yeddides.<verse eid="2SA 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 8:5" />Damasqo Aaraamen diza Xoobba kawo Hadaadi7eezere maaddanaas yida wode Dawiti isttafe 22,000 as wodhides. <verse eid="2SA 8:5" /><verse number="6" style="v" sid="2SA 8:6" />Hessafe guye Damasqon diza Aaraamen ba ola asata kambe giigsides. Aaraame asay izas haarettidessinne giirides; GODAY Dawiti bidaso ubbaan izas xoono immides.<verse eid="2SA 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 8:7" />Hadaadi7eezere shuumeti oykkida worqqa gondalleta Dawiti ekkidi Yerusalaame efides. <verse eid="2SA 8:7" /><verse number="8" style="v" sid="2SA 8:8" />Kawo Dawiti Bexahenne Berotaye geetettiza Hadaadi7eezere katamatappe keehippe daro xarqimala denththi efides.<verse eid="2SA 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 8:9" />Hamaate dere kawo Too7uyi Dawiti kumeththa Hadaadi7eezere ola asaa xoonidayssa siyida wode, <verse eid="2SA 8:9" /><verse number="10" style="v" sid="2SA 8:10" />Too7uyi Hadaadi7eezerera ubba wode olettishe diza gishshas sarokanne izi Hadaadi7eezere xoonida xoono qonccisanaas ba naa Iyoraame kawo Dawitekko kiitti yeddides; izikka birappe, worqqafenne xarqimalappe oosettida miishshata ekki yides.<verse eid="2SA 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 8:11" />Kawo Dawiti kase ba giirissida kawotappe gelida biraninne worqqan ooththida mala hayta ha miishshatakka GODAAS dummasides. <verse eid="2SA 8:11" /><verse number="12" style="v" sid="2SA 8:12" />Izas giirida kawoti, Eedoome, Mo7aabe, Amoone asaa, Filisxeeme asaanne Amaaleeqe asaa. Hessaththoka Xoobba kawo Erahoobe naa Hadaadi7eezereppe di7i ekkidayssa GODAAS dummasides.<verse eid="2SA 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 8:13" />Maxine shoobba geetettizason Dawiti Eedoome asaappe 18,000 as wodhi simmidaappe guye iza sunththay keehi nashettides.<note caller="-" style="x"><char style="xo" closed="false">8:13 </char><char style="xt" closed="false"><ref loc="PSA 60">Maza 60</ref></char></note><verse eid="2SA 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 8:14" />Kumeththa Eedoomen olanchchata kambe giigsides; Eedoome asay ubbay Dawites haarettides; Dawiti bidaso ubbaan GODAY izas xoono immides.<verse eid="2SA 8:14" /></para>
  <para style="s1">Dawite Shuumeta</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 8:15" />Dawiti kumeththa Isra7eele bolla kawotides; deraas suure pirdanne woga essides. <verse eid="2SA 8:15" /><verse number="16" style="v" sid="2SA 8:16" />Xuriya naa Iyo7aabey olanchchata halaqa; Ahiluude naa Iyoosaafixey taarike xaafe. <verse eid="2SA 8:16" /><verse number="17" style="v" sid="2SA 8:17" />Qasse Ahixuube naa Saadooqeynne Abiyaataare naa Ahimelekey qeese; Sarayay xaafe. <verse eid="2SA 8:17" /><verse number="18" style="v" sid="2SA 8:18" />Yoodahe naa Bannayay Kelite asasinne Pelite asas halaqa; Dawite attuma nayti kawoteththa keeththan zore immizayta.<note caller="+" style="f"><char style="fr" closed="false">8:18 </char><char style="ft" closed="false">Zore immizayta gizayssa issi issi kase wode birsheththati qeeseta geettes.</char></note><verse eid="2SA 8:18" /></para>
  <chapter eid="2SA 8" />
  <chapter number="9" style="c" sid="2SA 9" />
  <para style="s1">Dawitenne Memfeboste</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 9:1" />Dawiti, «Yoonataane gishshas gaada tani izas kiyateth ooththana mala Sa7oole soo asaappe attida asi dizee?» gi oychchides.<note caller="-" style="x"><char style="xo" closed="false">9:1 </char><char style="xt" closed="false"><ref loc="1SA 20:15-17">1Same 20:15-17</ref></char></note><verse eid="2SA 9:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 9:2" />He wode Sa7oole soon Xiibba geetettiza issi aylley dees; izi Dawitekko baana mala izas asay yootides. Kawozikka iza, «Xiibba geetettizay nenee?» gi oychchides.</para>
  <para style="p" vid="2SA 9:2">Izikka, «Ee tana ne oosanchchaza» gides.<verse eid="2SA 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 9:3" />Kawozikka, «Xoossa kiyateth ta izas ooththana mala Sa7oole soo asaappe attida asi deennee?» gi oychchides.<note caller="-" style="x"><char style="xo" closed="false">9:3 </char><char style="xt" closed="false"><ref loc="2SA 4:4">2Same 4:4</ref></char></note></para>
  <para style="p" vid="2SA 9:3">Xiibbayka kawozas, «Yoonataanes toho silida issi nay dees» gides.<verse eid="2SA 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 9:4" />Kawozikka, «Izi awan dizee?» gi oychchides;</para>
  <para style="p" vid="2SA 9:4">Xiibbayka, «Lodibaare geetettizason Am7eele naa Maakireson dees» gi zaarides.<verse eid="2SA 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 9:5" />Hessa gishshas kawo Dawiti Memfeboste Lodibaareppe Am7eele naa Maakire sooppe kiitti ehisides.<verse eid="2SA 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 9:6" />Sa7oole naaza Yoonataane naa Memfebostey Dawitekko yiidi iza bonchchos biitta bolla gufannidi sarokkides.</para>
  <para style="p" vid="2SA 9:6">Dawiti iza, «Memfebostee!» gi xeygides.</para>
  <para style="p" vid="2SA 9:6">Izikka, «Hekko ne oosanchchazi haan days» gides. <verse eid="2SA 9:6" /><verse number="7" style="v" sid="2SA 9:7" />Dawitikka iza, «Babbofa; ne aawa Yoonataane gishshas gaada tani nees kiyateth ooththana; ne mayza Sa7oole biittaa mulera ta nees zaarana; neni ubba wode ta maaddafe maandasa» gides.<verse eid="2SA 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 9:8" />Memfebostey biitta bolla gufannidi, «Hayqqida kana mala qoodettida taas ne hayssa keena ooththanaas ne oosanchchay ta oonee?» gides.<verse eid="2SA 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 9:9" />Hessafe guye kawozi Sa7oole aylle Xiibba xeygidi, «Sa7oolessinne izaso asaas diza miish ubbaa ne godaa naaza naa Memfebostes immadis. <verse eid="2SA 9:9" /><verse number="10" style="v" sid="2SA 9:10" />Neni, ne naytinne ne oosanchchati intte godaa naaza nay baas demmana mala iza gade izas goyidi kath izas gelththite; ne godaa naaza naa Memfebostey gidikko ay wodekka ta maaddafe maana» gides. He wode Xiibbas 15 attuma naytinne 20 oosanchchati deettes.<verse eid="2SA 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 9:11" />Hessafe guye Xiibbay kawozas, «Ta godaa kawoo! Ne oosanchcha ne azazida ubbaa ne aylley polana» gides. Hessa gishshas Memfebostey kawoza naytappe issaa mala gididi Dawite maaddafe mishe de7ides.<verse eid="2SA 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 9:12" />Memfebostes Mikka geetettiza issi guuththa nay dees; Xiibbaso asay ubbay Memfebostes ooththishe gam7ides. <verse eid="2SA 9:12" /><verse number="13" style="v" sid="2SA 9:13" />Memfebostey ubba wode kawo maaddafe miza gishshas Yerusalaamen de7ides; izas nam7u tohoti sila.<verse eid="2SA 9:13" /></para>
  <chapter eid="2SA 9" />
  <chapter number="10" style="c" sid="2SA 10" />
  <para style="s1">Amooneta Xooneteth</para>
  <para style="r">(<ref loc="1CH 19:1-19">1Taari 19:1-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 10:1" />Hessafe guye Amooneta kawoy hayqqides; iza naa Haanooney izasohon kawotides. <verse eid="2SA 10:1" /><verse number="2" style="v" sid="2SA 10:2" />Dawitikka, «Iza aaway taas kiya ooththidayssaththo tanikka Na7oose naa Haanoones iza kushe zaarana» gi qoppides. Hessa gishshas iza aawa hayqo gishshas mishettidayssa yootana mala Dawiti as kiittides; Dawiti yeddida asati biidi Amoone dere gakkida mala, <verse eid="2SA 10:2" /><verse number="3" style="v" sid="2SA 10:3" />Amoone dere shuumeti ba godaa Haanoone, «Dawiti baas seetettida mishaa qonccisanaas as kiittiday ne aawa bonchchanaas kiittidaa nees misatizee? Izi kiittida asati katamayo paacci xeellanaas, xomosanaassinne dhayssanaas gidennee?» gida. <verse eid="2SA 10:3" /><verse number="4" style="v" sid="2SA 10:4" />Hessa gishshas Haanooney Dawite asata oykkidi issaa issaa buuch baggasi meedides; istti may7ida may7ozakka pude xeessa gaththi qanxxi yeddides.<verse eid="2SA 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 10:5" />Asati keehi yeellatidayssa Dawiti siyida gishshas as isttas kiittides; kawozi, «Intte buuchchay diccanaashe gakkanaas Iyarkkon gam7idi hessafe guye simmi yiite» gides.<verse eid="2SA 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 10:6" />Amoone asay Dawiti istta ixxidayssa eridi Beet-Era7aabeppenne Xoobbafe 20,000 Aaraameppe tohora biza wottadarata hessaththoka kawo Ma7ikay 1,000 asaara qasseka Xoobbafe 12,000 as qaxxarida.<verse eid="2SA 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 10:7" />Dawiti hessa siyidi Iyo7aabe kumeththa ola asaara gaththi yeddides. <verse eid="2SA 10:7" /><verse number="8" style="v" sid="2SA 10:8" />Amoone asay kezidi ba katama geliza penge bolla salfen eqqides; Xoobba asay, Erahoobe asay, hessaththoka Xoobbiya asaynne Ma7ika asay demba bolla dumma salfida.<verse eid="2SA 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 10:9" />Iyo7aabeykka guyeranne sinththara olay bana giddoththidayssa be7idi Isra7eele garsan erettida olanchchatappe guuththata dooridi Aaraame olanchchata sinththan aaththi essides. <verse eid="2SA 10:9" /><verse number="10" style="v" sid="2SA 10:10" />Hankko attida olanchchata ba isha Abisaye istta bolla shuumidi Amoone asaa sinththan essides. <verse eid="2SA 10:10" /><verse number="11" style="v" sid="2SA 10:11" />Iyo7aabeykka, «Aaraame asay ta bolla minniko ne yaada tana maadda; Amoone asay ne bolla minniko ta baada nena maaddana. <verse eid="2SA 10:11" /><verse number="12" style="v" sid="2SA 10:12" />Hessa gishshas minna! Nuni nu derezasinne nu Xoossa katamatas ane minni olettoos; GODAY bana lo7ida mala ooththo» gides.<verse eid="2SA 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 10:13" />Hessafe guye Iyo7aabeynne izara diza ola asay Aaraame asaa olanaas gede sinth hordofides; Aaraame asay istta sinththafe baqatides. <verse eid="2SA 10:13" /><verse number="14" style="v" sid="2SA 10:14" />Aaraame asay baqatidayssa Amoone asay be7idi isttika Abisaye sinththafe baqatidi gede katamay giddo gelida; hessa gishshas Iyo7aabey Amoone asaa olizayssa aggaagidi guye Yerusalaame simmides.<verse eid="2SA 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 10:15" />Aaraame asay Isra7eele asaan xoonettidayssa be7idi qasseka issi bolla shiiqida. <verse eid="2SA 10:15" /><verse number="16" style="v" sid="2SA 10:16" />Hadaadi7eezere asata kiittidi shaafappe he pinththan diza Aaraame asaa ehisides; isttika Hadaadi7eezere ola asaa azaziza Soobake alaafeteththan Elaame bida.<verse eid="2SA 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 10:17" />Dawiti hessa siyidi kumeththa Isra7eele asaa shiishshides; hessafe guye Yordaanoose pinnidi Elaame bides; Aaraame asay olas giigettidi Dawitera tiran gayttides. <verse eid="2SA 10:17" /><verse number="18" style="v" sid="2SA 10:18" />Gido attiin istti Isra7eele sinththafe baqatida; Dawiti isttafe 700 para-gaare asatanne 40,000 tohon biza olanchchata wodhides. Hessaththo istti ola asaa azaziza Soobakekka caddi madunththida gishshas izi heen hayqqides. <verse eid="2SA 10:18" /><verse number="19" style="v" sid="2SA 10:19" />Hadaadi7eezereppe garsara diza kawoti ubbay Isra7eele asaan xoonettidayssa be7idi Isra7eele asaara saroteth medhdhidi isttas haarettida.</para>
  <para style="p" vid="2SA 10:19">Hessa gishshas Aaraame asay Amoone asaa maaddanaas babbides.<verse eid="2SA 10:19" /></para>
  <chapter eid="2SA 10" />
  <chapter number="11" style="c" sid="2SA 11" />
  <para style="s1">Dawitenne Bersaabeho</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 11:1" />Kawoti olas keziza ofinththa aginatan Dawiti Iyo7aabe kawo shuumetaranne kumeththa olanchchatara gaththi olas yeddides; isttika Amoone dere asaa dhayssida; Eraaba katamayo giddoththida; gido attiin he wode Dawiti Yerusalaamen attides.<note caller="-" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="1CH 20:1">1Taari 20:1</ref></char></note><verse eid="2SA 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 11:2" />Issi gallas bilahe wode Dawiti dhiskofe beeggidi kawo keeththa pooqe bolla kezidi simerettishe issi maccassaya ba bolla meecettishin be7ides; maccassaya keeha mala lo7o. <verse eid="2SA 11:2" /><verse number="3" style="v" sid="2SA 11:3" />Dawiti as kiittidi maccassay gishshas oyshechchides; addezikka, «Hanna Hiite dere as Ooriyo machcho El7aame biyo Bersaabeho gidekkee?» gides. <verse eid="2SA 11:3" /><verse number="4" style="v" sid="2SA 11:4" />Hessafe guye Dawiti as yeddidi izo baakko ehisiin izi dizaso geladus; histtiin izira zin7ides; he wode iza macca naas yiza agina wogappe geeya uttadus. <verse eid="2SA 11:4" /><verse number="5" style="v" sid="2SA 11:5" />Maccassaya qanththatada Dawites, «Ta nees shaaradis» gashe kiita yeddadus.<verse eid="2SA 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 11:6" />Hessafe guye Dawiti Iyo7aabes, «Hiite dere as Ooriyo haa taakko yedda» gi kiittides; Iyo7aabeykka Ooriyo Dawitekko yeddides. <verse eid="2SA 11:6" /><verse number="7" style="v" sid="2SA 11:7" />Ooriyoy Dawitekko yiin Dawiti Iyo7aabenne olanchchata saroteth oychchides; hessaththoka olazi waani olettizaakko iza oychchides. <verse eid="2SA 11:7" /><verse number="8" style="v" sid="2SA 11:8" />Hessafe guye Dawiti Ooriyo, «Ane neni neso baada toho meecetta» gides; Ooriyoy kawo keeththafe moyzetti bides; kawozi mogota kath geedora izas yeddides. <verse eid="2SA 11:8" /><verse number="9" style="v" sid="2SA 11:9" />Gido attiin Ooriyoy ba godaa oosanchchata ubbaara kawo keeththa gibbe penge bolla ichchides attiin baso bibeenna.<verse eid="2SA 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 11:10" />Dawiti, «Ooriyoy baso bibeenna» gizayssa siyida mala Ooriyo, «Ne buro ogeppe gelo bolla daasa diikkii? Neso ays babeekkii?» gi oychchides.<verse eid="2SA 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 11:11" />Ooriyoykka Dawites, «Taabotay, Isra7eele asaynne Yuhuda asay dunkaanen dishin, ta godaa Iyo7aabeynne ta godaa asay coo demba bolla dishin tani maanaassinne uyanaas qasseka ta machcheyra aqanaas waana taso boo? Intte asho! Ta hayssa mala ooththike» gides.<verse eid="2SA 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 11:12" />Dawitikka izas, «Ero, ne hach hayssan aqikko wonto ta nena moyzana» gides. Hessa gishshas Ooriyoy he gallassinne wonteththa gallas Yerusalaamen takkides. <verse eid="2SA 11:12" /><verse number="13" style="v" sid="2SA 11:13" />Wonteththa gallas Dawiti ba dizason izas gibira giigsidi mizi, ushshi kalssidi iza maththosides; gadey qammishin Ooriyoy gaden ongetti diza hiixan ichchanaas iza godaa aylleti dizaso bides attiin baso bibeenna.<verse eid="2SA 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 11:14" />Gadey wontishin Dawiti Iyo7aabes dabdaabbe xaafidi Ooriyo bolla yeddides. <verse eid="2SA 11:14" /><verse number="15" style="v" sid="2SA 11:15" />Dabdaabezan, «Ooriyo olay minnizason essa; heen izi cadetti hayqqana mala aggaagidi baqatite» gi xaafides.<verse eid="2SA 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 11:16" />Hessa gishshas Iyo7aabey katamayo giddoththida wode keehi eqettiza olanchchati diza miixan Ooriyo essides. <verse eid="2SA 11:16" /><verse number="17" style="v" sid="2SA 11:17" />Katamayin diza asay kezidi Iyo7aabera ola danxxides; Dawite olanchchatappe guuththati kundida; hessaththoka Hiite dere as Ooriyoy hayqqides.<verse eid="2SA 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 11:18" />Iyo7aabey olason hanida ubbaa Dawites kiitti yeddides. <verse eid="2SA 11:18" /><verse number="19" style="v" sid="2SA 11:19" />Kiitetti bizayssas, «Hayssa olaa hanotaa ne kawozas yootidaappe guye, <verse eid="2SA 11:19" /><verse number="20" style="v" sid="2SA 11:20" />Kawozi ne bolla hanqettidi, ‹Intte olettanaas ays hessa mala katamaykko keehi shiiqidetii? Gimbeza kaarara intte bolla wondafe dukkanayssa erekketii? <verse eid="2SA 11:20" /><verse number="21" style="v" sid="2SA 11:21" />Yerubesheete<note caller="+" style="f"><char style="fr" closed="false">11:21 </char><char style="fqa" closed="false">Yerubesheete: </char><char style="ft" closed="false">Yerubesheete issi issi Geeshsha maxaafatan Yerubaabeele, Geedoone, qasse haratan Boosheete geetettees</char></note> naa Abimelekke issi maccassaya Teebeesen gimbeza kaarara woxa mayde yeddada wodhabeekkee? Histtiin intte ays hessa keena gede gimbezaakko shiiqidetii?› gi oychchiko nenikka izas zaarada, ‹Hiite dere as ne oosanchcha Ooriyoy hayqqides› gaada yoota» gides.<note caller="-" style="x"><char style="xo" closed="false">11:21 </char><char style="xt" closed="false"><ref loc="JDG 9:53">Daanna 9:53</ref></char></note><verse eid="2SA 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 11:22" />Hessa gishshas kiitettida addezi dendi bides; hee bi gakkida mala Iyo7aabey yeddida kiita ubbaa Dawites yeddides. <verse eid="2SA 11:22" /><verse number="23" style="v" sid="2SA 11:23" />Kiitetti bidayssi Dawites, «Asati nu bolla wolqqamidi nuna olanaas demba gakkanaas yida; gido attiin nuni istta katamay penge gakkanaas gooddidos. <verse eid="2SA 11:23" /><verse number="24" style="v" sid="2SA 11:24" />Hessafe guye wondafe dukkiza asati gimbeza bolla uttidi ne aylleta gidida nu bolla wondafe dukkida; kawoza oosanchchatappe guuththata wodhida; ne oosanchcha Hiite dere as Ooriyoykka hayqqides» gides.<verse eid="2SA 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 11:25" />Dawiti kiitetti yidayssas, «Neni Iyo7aabes, ‹Ay wode gidiinkka mashshay issito hessafe woykko hayssafe mees; hessa gishshas hayssa ha hanozan kayottofa; katamayo ola oykkanaassinne dhayssanaas minna› gaada minththeththa» gides.<verse eid="2SA 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 11:26" />Ooriyo machcheya izi azinay hayqqidayssa siyada keeha mishettada izas yeekkadus. <verse eid="2SA 11:26" /><verse number="27" style="v" sid="2SA 11:27" />Kayoteththa wodey aadhdhidaappe guye Dawiti kiitti ehisidi izo baas machcho ekkides; iza Dawites attuma naa yeladus; gido attiin Dawiti ooththida oosoy GODAA ufayssibeenna.<verse eid="2SA 11:27" /></para>
  <chapter eid="2SA 11" />
  <chapter number="12" style="c" sid="2SA 12" />
  <para style="s1">Naataanenne Kawo Dawite</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 12:1" />GODAY nabe Naataane Dawitekko kiittides; izikka Dawitekko biidi, «Issi kataman nam7u asati deettes; isttafe issoy dure; hankkoyssi manqo.<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="PSA 51">Maza 51</ref></char></note> <verse eid="2SA 12:1" /><verse number="2" style="v" sid="2SA 12:2" />Durezas keehi daro dorsatinne miizati deettes. <verse eid="2SA 12:2" /><verse number="3" style="v" sid="2SA 12:3" />Gido attiin manqozas izi shammida dorsa laaqqa issineyppe attiin haray deenna; izi izo ba naytara al7isi dichchides; izara issife mawus; issife uyawus; iza ki7on ichchawus; iza izas yelo mala.<verse eid="2SA 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 12:4" />«Issi gallas durezaso imaththi yides; dure addezi ba dorsatappe woykko miizatappe ekkidi he imaththazas miza kath giigsana koyibeenna; gido attiin manqoza laaqqayo efidi baso yida imaththazas kaththi giigsides» gides.<verse eid="2SA 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 12:5" />Dawiti hessa ooththidayssa bolla keehi hanqettidi Naataanes, «De7o GODAY be7iin hayssa ooththidaades hayqoy bessees! <verse eid="2SA 12:5" /><verse number="6" style="v" sid="2SA 12:6" />Izi hayssa mala ooso ooththida gishshassinne qadhetay baynda gishshas he laaqqay gishshas oyddu kushe qanxxana bessees» gides.<verse eid="2SA 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 12:7" />Hessafe guye Naataaney Dawites zaaridi, «He bitanezi nena! GODAA Isra7eele Xoossay nena, ‹Neni Isra7eele bolla kawo gidana mala ta nena tiyadis; Sa7oole kusheppeka nena ashshadis. <verse eid="2SA 12:7" /><verse number="8" style="v" sid="2SA 12:8" />Ne godaa keeththaa ta nees immadis; ta ne godaa machchetakka ne shophpha gars gelththadis; Isra7eele keeththaanne Yuhuda keeththaa ta nees immadis; hayti ubbay nees guuxxidaakko ta nees heytappe bollara gujjanakkoshin. <verse eid="2SA 12:8" /><verse number="9" style="v" sid="2SA 12:9" />Histtiin iza sinththan iita miish ooththada GODAA qaala ays kawushshadii? Hiite dere as Ooriyo mashshan siifadasa; iza machcheyo nees ekkadasa; izakka Amooneta mashshan wodhisadasa. <verse eid="2SA 12:9" /><verse number="10" style="v" sid="2SA 12:10" />Neni tana kawushshida gishshassinne Hiite dere as Ooriyo machcho nees ekkida gishshas ne keeththafe mernaas mashshay shaakettenna› gees.<verse eid="2SA 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 12:11" />«GODAY nena, ‹Be7a ne keeththafe ne bolla iita miish ta denththana; ne ayfey be7ishin ne machcheta ekkada nees mata gidida issaades ta aaththa immana; izikka seeta gallas ne machchetara zin7ana. <verse eid="2SA 12:11" /><verse number="12" style="v" sid="2SA 12:12" />Neni kase hayssa geeman ooththadasa; tani gidikko Isra7eele ubbaa sinththan gallas poo7oy dishin qonccisana› gees» gides.<note caller="-" style="x"><char style="xo" closed="false">12:11-12 </char><char style="xt" closed="false"><ref loc="2SA 16:22">2Same 16:22</ref></char></note><verse eid="2SA 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 12:13" />Hessafe guye Dawiti Naataanes, «Tani GODAA keeha qohadis» gides;</para>
  <para style="p" vid="2SA 12:13">Naataaney izas zaaridi, «GODAY ne nagara wursida gishshas ne hayqqaka; <verse eid="2SA 12:13" /><verse number="14" style="v" sid="2SA 12:14" />Gido attiin ne hayssa ooththiin morkketi GODAA keehi kawushshana mala<note caller="+" style="f"><char style="fr" closed="false">12:14 </char><char style="ft" closed="false">GODAA keehi kawushshana mala gizayssa issi issi Geeshsha Maxaafa birsheththati Xoossa morkketi Xoossaa qidhana woykko kadhana mala ne ooththida gishshas geettes.</char></note> ne ooththida gishshas nees yelettida naazi hayqqana» gides.<verse eid="2SA 12:14" /></para>
  <para style="s1">Dawite Naaza Hayqo</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 12:15" />Naataaney baso simmi bidaappe guye Ooriyo machcheya Dawites yelida naaza bolla GODAY iita harge yeggides. <verse eid="2SA 12:15" /><verse number="16" style="v" sid="2SA 12:16" />Dawiti ba naaza gishshas Xoossaa woossidessinne xoomides. Hessafe guye gede ba kifile gelidi omars omars qanxxontta sa7a bolla ichchi aqides. <verse eid="2SA 12:16" /><verse number="17" style="v" sid="2SA 12:17" />Iza kawoteththa keeththa cimati iza sa7appe denththanaas iza matan eqqida; izi gidikko dendontta ixxides; istti mishin aykkoka mibeenna.<verse eid="2SA 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 12:18" />Laappunththa gallas naazi hayqqides; Dawite oosanchchati, «Naazi paxa dishin nu yootiin nu gizaa siyibeenna; histtiin nu ha7i naaza hayqo izas wostti yootana dandayzonii? Izi barkka ba bolla qoho gaththana dandayees» gi qoppidi yootanaas babbida.<verse eid="2SA 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 12:19" />Iza oosanchchati garsara saasuketti haasayzayssa Dawiti be7idi naazi hayqqidayssa erides; hessa gishshas, «Naazi hayqqidee?» giidi istta oychchides. Isttika izas, «Ee hayqqides» gida.<verse eid="2SA 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 12:20" />He wode Dawiti sa7a bollafe dendidi, meecettidi, gorpettidinne may7o laammidaappe guye GODAA keeth bi goynnides. Hessafe guye izi ba kifile gelides; baas quma immana mala izi oychchiin immida quma mides.<verse eid="2SA 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 12:21" />Iza oosanchchati iza, «Hayssaththo ays ooththadii? Naazi shemppora paxa dishin xoomadasanne yeekkadasa; gido attiin naazi hayqqidaappe guye ne dendada kath madasa» gida.<verse eid="2SA 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 12:22" />Dawiti isttas, «Ee tuma, naazi shemppora paxa diza wode, ‹GODAY taas atto giidi naaza shemppora paxa woththanaakkon gaada xoomadissinne yeekkadis.› <verse eid="2SA 12:22" /><verse number="23" style="v" sid="2SA 12:23" />Ha7i gidikko naazi hayqqiin ta aazas xoomoo? Ta iza haa zaaranaas dandayazinaa? Ta izakko baana attiin izi haa taakko simmenna!» gides.<verse eid="2SA 12:23" /></para>
  <para style="s1">Solomoone Yeleteth</para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 12:24" />Hessafe guye Dawiti ba machcheyo Bersaabeho minththeththides; izikko gelidi izira aqides; izakka izas attuma naa yeladus; naaza, «Solomoone» gi sunththides; GODAYKKA iza dosides; <verse eid="2SA 12:24" /><verse number="25" style="v" sid="2SA 12:25" />GODAY naaza dosida gishshas iza sunththi Yididiya geetetti xeygettana mala nabe Naataane baggara qaala kiittides.<verse eid="2SA 12:25" /></para>
  <para style="s1">Eraaba Katama Xooneteth</para>
  <para style="r">(<ref loc="1CH 20:1-3">1Taari 20:1-3</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 12:26" />He wode Iyo7aabey Amooneta katama Eraaba olidi kawoteththa keeththaa miixa oykkides. <verse eid="2SA 12:26" /><verse number="27" style="v" sid="2SA 12:27" />Hessafe guye Iyo7aabey Dawitekko as kiitti yeddidi, «Tani Eraaba olada haaththi diza katamayo oykkadis; <verse eid="2SA 12:27" /><verse number="28" style="v" sid="2SA 12:28" />Ha7i neni attida olanchchata shiishsha ekkada katamayo giddoththa oykka; ne histtontta aggiko katamayo ta oykkiko iza ta sunththan xeygettana» gides.<verse eid="2SA 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 12:29" />Hessa gishshas Dawiti kumeththa olanchchata shiishshi ekki biidi Eraaba oli oykkides. <verse eid="2SA 12:29" /><verse number="30" style="v" sid="2SA 12:30" />Istta kawoza kallachchaa iza hu7eppe ekkides; he kallachchazi issi meklite<note caller="+" style="f"><char style="fr" closed="false">12:30 </char><char style="ft" closed="false">Issi meklite gizayssi heedzdzu tammanne ichchash kilo giraame bessees</char></note> worqqa gidishin bonchchettida inqqun aleqettides; Dawiti he kallachchaza ba hu7en goxxides; Dawiti katamayppe keehi daro miish di7i ekkides. <verse eid="2SA 12:30" /><verse number="31" style="v" sid="2SA 12:31" />Heen diza deraa kessidi istta magaazen, xoylleninne kalttan go7ettidi ooso ooththana mala wolqqaththi oosisides; hessaththoka xuube medhissides. Hessa mala oosoy hara Amooneta katamata ubbaan oosettana mala ooththides. Hessafe guye Dawitinne iza olanchchati ubbay Yerusalaame simmida.<verse eid="2SA 12:31" /></para>
  <chapter eid="2SA 12" />
  <chapter number="13" style="c" sid="2SA 13" />
  <para style="s1">Aminoonenne Ti7imaaro</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 13:1" />Dawite naa Abeseloomes Ti7imaaro geetettiza mala lo7o michcha dawus; Dawite naa Aminooney izo dosides.<verse eid="2SA 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 13:2" />Aminooney ba michcho Ti7imaaro dosida gaason sakettanaashe gakkanaas ceecides; iza geela7o gidida gishshas izi izira aqana dandaybeenna.<verse eid="2SA 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 13:3" />Aminoones Iyoonadaabe geetettiza laggey dees; izi Dawite isha Shame7e naa; Iyoonadaabey keehi gene asa. <verse eid="2SA 13:3" /><verse number="4" style="v" sid="2SA 13:4" />Izi Aminoone, «Ne gilqa gilqa aqiza gaasoykka aazakkon taas ays yootikkii!» gi oychchides. Aminooney, «Ta isha Abeseloome michcho Ti7imaaro dosida gishshas gilqadis» gides.<verse eid="2SA 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 13:5" />Iyoonadaabeykka izas, «Histtiko neni, ‹Tani sakettadis› gaada hiixan keza ichcha; ne aaway nena oychchana yishin, ‹Ta michcho Ti7imaara yaada taas miza miish giigsa immidaakko tana lo7ees; kaththaaka hayssan ta xeellishin giigsada ba kushera iza tana barsana mala azazarkkii!› gaada iza oychcha» gides.<verse eid="2SA 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 13:6" />Histtiin Aminooney sakettida as misatidi ichchides; kawozi iza oychchana yiin Aminooney iza, «Ta michcho Ti7imaara yaada ta be7ishin sollo uukkada ba kushera tana barsana mala ta nena woossays» gi oychchides.<verse eid="2SA 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 13:7" />Dawiti, «Ne isha Aminooneso baada izas maana kath giigsa» giidi Ti7imaaris yootana mala kawo keeth kiittides. <verse eid="2SA 13:7" /><verse number="8" style="v" sid="2SA 13:8" />Hessa gishshas Ti7imaara izi isha Aminooney ichchi dizaso badus; guuththa bukeeso ekkada munuqidaappe guye izi be7ishin giigsada uukkadus. <verse eid="2SA 13:8" /><verse number="9" style="v" sid="2SA 13:9" />Hessafe guye basheza kessada solloza izas shiishshadus; gido attiin izi maana koyibeenna.</para>
  <para style="p" vid="2SA 13:9">Aminooney, «Ubba asaa hayssafe kessite» gides; diza asay ubbayka iza yeggi kezides. <verse eid="2SA 13:9" /><verse number="10" style="v" sid="2SA 13:10" />Hessafe guye Aminooney Ti7imaaro, «Tana barsana mala kaththaa haa ta ichchida kifile ekka ya» gides; Ti7imaara ba giigsida qumaa ekkada ba isha Aminooney ichchida kifile geladus. <verse eid="2SA 13:10" /><verse number="11" style="v" sid="2SA 13:11" />Gido attiin iza qumaa izas shiishshiin izi izo curpu histti oykkidi, «Ta michcheyee! Ane issife zin7oos» gides.<verse eid="2SA 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 13:12" />Izakka zaarada izas, «Ta ishazoo ta nena shoobbis, agga; hessi hanenna; tana wolqqara oykkofa; hayssa mala miishshi Isra7eelen oosetti erenna; hayssa yeellachchiza ooso ooththofa. <verse eid="2SA 13:12" /><verse number="13" style="v" sid="2SA 13:13" />Ta hayssafe guye waananee? Ta kawushshateththaa tookkada ta awa gelanee? Nenikka Isra7eelen kawushsha asatappe issaa mala qoodettana gidikkii? Dicca zay kawozas yoota; izi ta nena gelontta mala diggenna» gadus. <verse eid="2SA 13:13" /><verse number="14" style="v" sid="2SA 13:14" />Izi gidikko iza gizayssa siyana koyibeenna; izi izippe keehi mino gidida gishshas izo wolqqara oykkidi izi geela7oteththaa ekkides.<verse eid="2SA 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 13:15" />Hessafe guye Aminooney izo keehi ixxides; ubbaaka kase izo siiqoorippe bollara ixxides. Aminooney, «Kichcha ta achchafe keza!» gides.<verse eid="2SA 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 13:16" />Izakka, «Hessi hanenna! Neni tana kessa yedoy kase ne ta bolla gaththida qohozappe aaththada tana qohaasa!» gadus; izi gidikko iza gizayssa ekkibeenna. <verse eid="2SA 13:16" /><verse number="17" style="v" sid="2SA 13:17" />Izi ba aylleza xeygidi, «Hanno maccassayo kessada karaa gorda» gides. <verse eid="2SA 13:17" /><verse number="18" style="v" sid="2SA 13:18" />Hessa gishshas iza gelontta mala kareza gordides; he wode geela7o gidida kawo nayti may7iza alleqo may7o may7a uttadus. <verse eid="2SA 13:18" /><verse number="19" style="v" sid="2SA 13:19" />Ti7imaara ba hu7en bidinth laalladus; alleqo may7ozakka daakkadus; hessafe guye ba hu7e baqqa oykkada yeekkashe badus.<verse eid="2SA 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 13:20" />Izi isha Abeseloomey izo, «Hessi ne isha Aminooney nenara takkidee? Ta michcheye ane ha7i co7u ga; izi ne isha gidida gishshas ne ceecoppa» gides. Ti7imaara ba isha Abeseloomeson sayo gida uttadus.<verse eid="2SA 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 13:21" />Kawo Dawiti he hanoza siyidi keehi hanqettides; <verse eid="2SA 13:21" /><verse number="22" style="v" sid="2SA 13:22" />Abeseloomey Aminoone bolla iita gidiin lo7o gidiin issi qaalakka phoqqibeenna; gaasoykka Aminooney iza michcho Ti7imaaro kawushshida gishshas keehi ixxides.<verse eid="2SA 13:22" /></para>
  <para style="s1">Aminoone Hayqo</para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 13:23" />Nam7u layththafe guye Abeseloomey Efreeme dhassa matan diza Ba7aali-Haxoore kataman ba dorsata iske qanxxishe heen kawo attuma nayti beettana mala xeygides. <verse eid="2SA 13:23" /><verse number="24" style="v" sid="2SA 13:24" />Abeseloomey kawozaakko biidi, «Hekko ne aylley ba dorsata iske qanxxishe dees; hessa gishshas kawozinne iza shuumeti isttas lo7o shene gidikko taas heen beettetto» gi shoobbides.<verse eid="2SA 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 13:25" />Kawozikka, «Ta naazoo! Nu ubbay baanaas bessenna; nu nees tooho gidana» gides. Abeseloomey minththi woossiinkka kawozi baana koyibeenna; gido attiin iza anjjidi moyzi yeddides.<verse eid="2SA 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 13:26" />Abeseloomey, «Histtiko ta isha Aminooney nunara baana mala azaza» gides.</para>
  <para style="p" vid="2SA 13:26">Kawozi, «Izi inttenara ays baanee?» gi oychchides. <verse eid="2SA 13:26" /><verse number="27" style="v" sid="2SA 13:27" />Gido attiin Abeseloomey iza minththi woossida gishshas Dawiti Aminooneynne hankko attuma nayti ubbay izara issife baana mala ooththides.<verse eid="2SA 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 13:28" />Abeseloomey ba aylletas, «Aminooney woyne ushshaa uyidi maththottanaashe gakkanaas naagettite; hessafe guye tani inttena, ‹Aminoone shocite› giza wode intte iza wodhite; inttena azaziday tana gidida gishshas babbofte, minnite, xalite» gi azazides.<verse eid="2SA 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 13:29" />Abeseloome aylleti istta goday istta azazidayssa Aminoone bolla polida; hessafe guye kawoza nayti ubbay ba baqulo baqulo toggidi baqatida.<verse eid="2SA 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 13:30" />Istti buro oge bolla dishin, «Abeseloomey kawoza nayta ubbaa wodhi wursides; issaadeyka attibeenna» giza worey Dawitekko gakkides. <verse eid="2SA 13:30" /><verse number="31" style="v" sid="2SA 13:31" />Kawozi dendi eqqidi ba may7o daakkides; biitta bolla gufannides; iza matan eqqi diza iza aylleti ubbay bantta may7o daakkida.<verse eid="2SA 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 13:32" />Gido attiin Dawite isha Shame7e naa Iyoonadaabey, «Kawo nayta ubbaa wodhi wursidaa misatissidi ta goday qoppofo; iza michcho Ti7imaaro wolqqanththi oykkida wodeppe doommidi Abeseloomey gixxi dendida yo7o gidida gishshas Aminooney xalla hayqqides. <verse eid="2SA 13:32" /><verse number="33" style="v" sid="2SA 13:33" />Hayqqiday Aminoone xalla gidida gishshas, ‹Kawo nayti ubbay hayqqida› geetettidayssa kawoy ta goday ammananaas bessenna» gides.<verse eid="2SA 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2SA 13:34" />Abeseloomey eeson baqatides.</para>
  <para style="p" vid="2SA 13:34">Zabe naagizayssi dhoqqu gi xeellishin izappe arshey wulliza baggara diza ogera daro asati zumaa millera duge wodhdhishin be7ides. Zabe naagizayssi biidi kawozas, «Horonaye baggara zumbullata tiixara asay duge bishin ta be7ays» gi yootides.<verse eid="2SA 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2SA 13:35" />Iyoonadaabey Dawites, «Be7a kawo nayti yida; kase ne aylley gidayssa mala hanides» gides.<verse eid="2SA 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2SA 13:36" />Izi buro yooti wursontta dishin kawoza nayti waassishenne yeekkishe gelida; hessaththoka kawozinne iza oosanchchati ubbay keehippe yeekkida.<verse eid="2SA 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2SA 13:37" />Abeseloomey gangidi Geeshure kawo Amihuude naa Talimayekko bides; gido attiin Dawiti hayqqida naaza gishshas ubba wode yeekkishe gam7ides.<note caller="-" style="x"><char style="xo" closed="false">13:37 </char><char style="xt" closed="false"><ref loc="2SA 3:3">2Same 3:3</ref></char></note><verse eid="2SA 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 13:38" />Abeseloomey gangidi Geeshure biidi heen 3 layth uttides. <verse eid="2SA 13:38" /><verse number="39" style="v" sid="2SA 13:39" />Kawo Dawiti ba naa Aminoone hayqon gakkida kayoteththaafe minettidaappe guye Abeseloomekko baana iza wozinay dendides.<verse eid="2SA 13:39" /></para>
  <chapter eid="2SA 13" />
  <chapter number="14" style="c" sid="2SA 14" />
  <para style="s1">Yerusalaame Abeseloome Simo</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 14:1" />Kawo Dawiti Abeseloome laamotidayssa Xuriya naa Iyo7aabey erides. <verse eid="2SA 14:1" /><verse number="2" style="v" sid="2SA 14:2" />Hessa gishshas Iyo7aabey issi as Tequhe kiittidi issi wozinama maccas ehisides; izo, «Neni kayottiza as misatanaas kayo may7o may7a; qibaate tiyettofa; hayqqida asas daro wode kayottashe diza maccas misata beetta. <verse eid="2SA 14:2" /><verse number="3" style="v" sid="2SA 14:3" />Hessafe guye kawozaakko baada ta nees yootizayssa izas yoota» giidi iza yootana qaalata Iyo7aabey izis yootides.<verse eid="2SA 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 14:4" />Tequhe dere maccassaya kawozaakko geladus; sinththa guth gufannada bonchcho saroka immidaappe guye, «Kawonttoo tana maaddite!» gadus.<verse eid="2SA 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 14:5" />Kawozikka izo, «Nena aazee metiday?» gi oychchides. Izakka zaarada, «Tani tumappe azinay hayqqida am7o. <verse eid="2SA 14:5" /><verse number="6" style="v" sid="2SA 14:6" />Taas ne aylleys nam7u attuma nayti deettes; nam7ati ba garsan issoy issaara demban ooyettida; istta ashechchizay baynda gishshas issoy hankkoyssa shoci wodhides. <verse eid="2SA 14:6" /><verse number="7" style="v" sid="2SA 14:7" />Histtiin dabboti ubbay ne aylley bolla dendidi, ‹Ba ishaa wodhidayssa nuus haa aaththa imma; izi ba ishaa wodhida gishshas nunikka iza wodhana; hessafe guye neni laatay bayndaaro gidana› geettes; hessa gishshas taas attida issi xomppeza dhayssidi ta azinaza biitta bolla sunththi bayndanne zarey baynda dhonth kessana haneettes» gadus.<verse eid="2SA 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 14:8" />Kawozikka maccassayo, «Neni simma neso ba; ta ne oysha gishshas bessiza azazo immana» gides. <verse eid="2SA 14:8" /><verse number="9" style="v" sid="2SA 14:9" />Gido attiin Tequhe dere maccassaya, «Ta godaa kawoo! Qohozi ta bollanne ta aawa keeththan gakko; kawoynne iza araatay qohoppe geeyidayta gidetto» gadus.<verse eid="2SA 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 14:10" />Kawozikka izis, «Oonikka ne bolla issi miish haasayzaa gidikko haa taakko ekka ya; zaari nena waayisenna» gides.<verse eid="2SA 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 14:11" />Iza, «Suuth accizayti ta naaza wodhidi kaseppe aadhdhiza qoho gaththontta mala kawoy GODAA ba Xoossaa woosso» gadus.</para>
  <para style="p" vid="2SA 14:11">Kawozikka izis, «GODAY be7iin, ne naaza hu7e iskefe issinakka boshettuku» gi caaqqides.<verse eid="2SA 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 14:12" />Hessafe guye maccassaya, «Ta ne aylleya ta godaas kawos issi qaala yootana mala ero garkkii!» gadus; izikka, «Ero yoota» gides.<verse eid="2SA 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 14:13" />Maccassaya zaarada izas, «Neni hayssa mala yo7o Xoossa deraa bolla aazas qoppadii? Kawozi dereppe goodetti bete bida ba naaza zaaribeenna; histtiin hessa izi yootishe barkka ba bolla pirdibeennee? <verse eid="2SA 14:13" /><verse number="14" style="v" sid="2SA 14:14" />Biittan gukkida haaththi simmonttayssaththo nuni ubbayka hayqqoos; Xoossi biittafe goodettida asi iza sinththafe baqati bidason attontta mala simmi yaana oge izas giigssees attiin iza shemppoy dhayana mala koyenna.<verse eid="2SA 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 14:15" />«Ha7ikka ta hayssa yiday derezi tana babisida gishshas hessa ta godaas kawos yootanaassa; ta ne aylleya, ‹Ta kawozas yootana; izikka ta oychchidayssa polanaas dandayzaa gidana. <verse eid="2SA 14:15" /><verse number="16" style="v" sid="2SA 14:16" />Xoossi nuus immida xinxxofe tananne ta naaza shoddanaas dendida addeza kusheppe kawozi ba oosanchchayo ashshanaas eeno gaana› ga qoppadis.<verse eid="2SA 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 14:17" />«Ha7ikka ta ne aylleya, ‹Kawoy ta godazi lo7o iitappe shaakki eron Xoossa kiitanchcha mala gidida gishshas ta godaa kawoza qaalay tana minththeththo; GODAA ne Xoossay nenara gido› gays» gadus.<note caller="-" style="x"><char style="xo" closed="false">14:17 </char><char style="xt" closed="false"><ref loc="2SA 19:27">2Same 19:27</ref></char></note><verse eid="2SA 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 14:18" />Hessafe guye kawozi maccassayo, «Tanikka nena oychchiza oyshatas zaaro taappe qottofa» gides.</para>
  <para style="p" vid="2SA 14:18">Maccassayakka, «Ero, ta goday Kawoy oychcha» gadus.<verse eid="2SA 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 14:19" />Kawozikka zaaridi izo, «Ha ubbaan Iyo7aabe kushey deennee?» gi oychchides.</para>
  <para style="p" vid="2SA 14:19">Maccassaya zaarada, «Ta godaa kawozo ne asho; ta godaa kawoy haasayda ubbaafe hadirsinne ushach gizay deenna; ee ta hayssa ubbaa haasayana mala tana azazidaynne ha ubbaa qaalay ne aylley doonan haasayettana mala tana kiittiday ne oosanchcha Iyo7aabe. <verse eid="2SA 14:19" /><verse number="20" style="v" sid="2SA 14:20" />Ne oosanchcha Iyo7aabey hayssa ooththiday diza hanotaa laammana koyida gishshassa; gido attiin ta godaas Xoossa kiitanchchatas diza aadho erateththi diza gishshas biittay bolla haniza miish ubbaa izi erees» gadus.<verse eid="2SA 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 14:21" />Kawozikka Iyo7aabes, «Ero lo7o; ero; baada naateththaza Abeseloome zaara ekka ya» gides.<verse eid="2SA 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 14:22" />Iyo7aabeykka bonchcho saroka kawozas qonccisanaas duge biitta bolla gufannidi sarokkides; kawoza anjjides; kaaleththidi Iyo7aabey, «Kawozi ba oosanchchaza woosaa ekkida gishshas ne aylley ne sinththan teema demmidayssa hach erides» gides.<verse eid="2SA 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 14:23" />Hessafe guye Iyo7aabey Geeshure biidi Abeseloome Yerusalaame zaari ehides. <verse eid="2SA 14:23" /><verse number="24" style="v" sid="2SA 14:24" />Kawoy gidikko, «Baso bo; izi ta ayfeso be7anaas dandayenna» gides; hessa gishshas Abeseloomey baso bides; kawoza ayfesokka be7ibeenna.<verse eid="2SA 14:24" /></para>
  <para style="s1">Abeseloomey Kawozara Maqaynnida Maqayno</para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 14:25" />Abeseloome mala, mala lo7oy kumeththa Isra7eele asaa garsankka deenna; izas hu7e binanappe biidi toho xugunth gakkanaas borey deenna. <verse eid="2SA 14:25" /><verse number="26" style="v" sid="2SA 14:26" />Hu7e iskey iza deexxishin layththan issito cakisees; cakettida binanazi kawo keeththa meezaanen woththishin 200 saqile<note caller="+" style="f"><char style="fr" closed="false">14:26 </char><char style="ft" closed="false">200 Saqile gizayssi 2 kilo lagge gidees.</char></note> deexxees.<verse eid="2SA 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 14:27" />Abeseloomes Ti7imaaro geetettiza issi macca naynne heedzdzu attuma nayti yelettida. Macca naya keeha mala lo7o.<verse eid="2SA 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 14:28" />Abeseloomey kawoza be7ontta Yerusalaamen nam7u layth uttides. <verse eid="2SA 14:28" /><verse number="29" style="v" sid="2SA 14:29" />Hessafe guye Iyo7aabey kawozaakko baana mala Abeseloomey xeygisides; Iyo7aabey gidikko izakko yaana koyibeenna; nam7anththoka zaaridi xeygisides; Iyo7aabey yaana koyibeenna. <verse eid="2SA 14:29" /><verse number="30" style="v" sid="2SA 14:30" />Histtiin Abeseloomey ba aylletas, «Be7ite; Iyo7aabe gadey ta gadera dhassa; iza gaden maxa gakkida banggay dees; biidi izan tama yeddite» gides; hessa gishshas Abeseloome aylleti biidi Iyo7aabe kaththaa taman xuuggida.<verse eid="2SA 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 14:31" />Hessafe guye Iyo7aabey Abeseloomeso biidi, «Ne aylleti ays ta kaththaa taman xuuggidoo?» gi oychchides.<verse eid="2SA 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 14:32" />Abeseloomey Iyo7aabes zaaridi, «Tani kiittiin neni yontta ixxida gishshassa; Hanno gakkanaas ta heen dizaakko taas lo7o gidana gides gaada ne kawos yootana mala, ‹Ta nena kawozaakko yeddana koyada nena haa ya› gaada xeygisadis; ha7i gidikko ta kawoza ayfeso be7ana koyays; ay mooroy ta bolla beettiko izi tana wodho» gides.<verse eid="2SA 14:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 14:33" />Iyo7aabey kawozaakko biidi hessa izas yootides; hessafe guye kawozi Abeseloome xeygisides; izikka yiidi kawoza sinththan gufannidi sarokkides; kawozikka Abeseloome yeeri ekkides.<verse eid="2SA 14:33" /></para>
  <chapter eid="2SA 14" />
  <chapter number="15" style="c" sid="2SA 15" />
  <para style="s1">Abeseloome Makkalleteth</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 15:1" />Hessafe guye Abeseloomey para-gaarenne parata, hessaththoka izappe sinththara woxxanaas 50 asata baas giigsides. <verse eid="2SA 15:1" /><verse number="2" style="v" sid="2SA 15:2" />Abeseloomey maalado wonttara dendidi katama penge gelththiza oge gaxan eqqi naagees. Ay asikka ba misha kawos magannidi pirdisana yiza wode ubbaan Abeseloomey izaade baakko xeygi xeygidi, «Ne awa katamappe yadii?» gi oychchees; he oyshettida addezikka, «Ta ne oosanchchay Isra7eele qommota garsafe issaafe yadis» gi zaarees. <verse eid="2SA 15:2" /><verse number="3" style="v" sid="2SA 15:3" />Hessafe guye Abeseloomey izas, «Be7a! Ne maganazi likkenne bessizaaza; gido attiin kawo wokkaletappe hayssa xeellana asi nees deenna» gees. <verse eid="2SA 15:3" /><verse number="4" style="v" sid="2SA 15:4" />Kaaleththidikka, «Tani hanno biittay bolla pirdiza daanna gida shuumettidaakko aazee dizay? Maganay woykko mootoy diza asi ubbay taakko yiidi suure pirda demmana mala ta ooththanakkoshin» gees.<verse eid="2SA 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 15:5" />Hessaththoka ay asikka izakko shiiqidi sarokkiza wode Abeseloomey ba kushen idimmi oykkidi yeerees. <verse eid="2SA 15:5" /><verse number="6" style="v" sid="2SA 15:6" />Kawozaakko suure pirda demmanaas yiza Isra7eele asa ubbaakko Abeseloomey hessaththo hani hani shiiqiza gishshas Isra7eele asaa wozina ekkides.<verse eid="2SA 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 15:7" />Oyddu layththafe guye Abeseloomey kawoza, «Tani adinettida adina gaththanaas Kebroone baanaas taas piqaade imma. <verse eid="2SA 15:7" /><verse number="8" style="v" sid="2SA 15:8" />Tani ne oosanchchay Aaraame deren Geeshuren dashe, ‹GODAY tana Yerusalaame zaarizaa gidikko GODAAS Kebroonen goynnana› ga adinettadis» gides.<verse eid="2SA 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 15:9" />Kawozi iza, «Saron ba» gides; hessa gishshas Abeseloomey Kebroone bides.<verse eid="2SA 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 15:10" />Hessafe guye Abeseloomey, «Intte zaye giiris siyiza wode, ‹Abeseloomey Kebroonen kawotides› giite gaana oosanchchata kumeththa Isra7eele qommota ubbaa giddon qotara woththides» gides. <verse eid="2SA 15:10" /><verse number="11" style="v" sid="2SA 15:11" />Yerusalaameppe 200 asati izara issife bida; istti imaththateth xeygettidi ashketeththan bida attiin istti yo7oza gishshas aykkoka eriza miishshi deenna. <verse eid="2SA 15:11" /><verse number="12" style="v" sid="2SA 15:12" />Abeseloomey yarshoza shiishshiza wode Dawite zoriza Gilo dere as Akxofeele ba biitta Giloppe izakko yaana mala kiittides; hessa gishshas seerazi minnides; Abeseloome kaallizayta qooday gujetti gujetti bides.<verse eid="2SA 15:12" /></para>
  <para style="s1">Dawite Baqata</para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 15:13" />Kiitettizayssi yiidi, «Isra7eele asaa wozinay Abeseloomera dees» giidi Dawites yootides.<verse eid="2SA 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 15:14" />Hessafe guye Dawiti ba shuume ubbatas, «Dendite; ane baqatoos; nu histtontta aggiko nuuppe issaadeyka Abeseloome kusheppe kessi ekki attenna; ha7ira nu hayssafe kezana bessees; nu histtontta aggiko kaaletti yiidi nuna oykkiko izi nuna dhayssana; katamayokka mashshan siifana» gides.<verse eid="2SA 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 15:15" />Kawoza shuumetikka, «Nu kawoy koyidayssa ubbaa ooththanaas nuni ne oosanchchati giigetti uttidos» gi zaarida.<verse eid="2SA 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 15:16" />Kawozi baso asaa kumeththaara kezi bides; kawoteththa keeththaa naagana mala 10 laggeththota woththides. <verse eid="2SA 15:16" /><verse number="17" style="v" sid="2SA 15:17" />Hessa gishshas kawoy kumeththa asaara haakki bidaappe guye heen issison eqqida. <verse eid="2SA 15:17" /><verse number="18" style="v" sid="2SA 15:18" />Asay ubbay Kelitetinne Peliteti hessaththoka Geeteppe izara yida 600 asata gujjiin salfidi kawoza sinth aadhdhida.<verse eid="2SA 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 15:19" />Kawozi Geete dere as Ittayey, «Ne nunara ays yadii? Simmada kawo Abeseloomera issife utta; neni ne hu7es ne biittafe di7etta yida imaththa. <verse eid="2SA 15:19" /><verse number="20" style="v" sid="2SA 15:20" />Neni ha7i zine yadasa; histtiin ta taas awa bizaakko erontta dashe ne nunara toylattana mala ays ooththoo? Ane ha7i neni ne asata ekkada guye simma; lo7eteththinne ammaneteththay nenara gido» gides.<verse eid="2SA 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 15:21" />Gido attiin Ittayey, «De7o GODAY be7iin, hessaththoka ta godaa kawo asho; de7o gidiin hayqo gidiin awankka ta godaa kawoy hanizayssa tani ne ayllezi hanana» gi zaarides.<verse eid="2SA 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 15:22" />Dawitikka Ittaye, «Histtiko sinth aadhdha ba» gides; hessa gishshas Geete dere as Ittayey ba asatanne banara diza baso asata ekki bides.<verse eid="2SA 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 15:23" />Derey ubbay aadhdhi biza wode he dere asay waassishe yeekkides; kawozi Qediroone zulleza pinnides; asay ubbay pinnidi bazzo biitta bides.<verse eid="2SA 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 15:24" />Saadooqeykka heen dees; izara issife diza Leweti ubbay Xoossa Caaqo Qaala Taabotaa tookkida; isttika zaaridi Xoossa Caaqo Qaala Taabotaza woththida; Abiyaataarey asay kumeth katamayo yeddi kezanaashe gakkanaas yarsho shiishshides.<verse eid="2SA 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 15:25" />Hessafe guye kawozi Saadooqe, «Neni Xoossa Caaqo Qaala Taabotaza ekkada guye katamayo simma. Tani GODAA sinththan ayottidaa gidikko izi tana zaaridi Taabotazanne iza aqosoza ta be7ana mala gaththana. <verse eid="2SA 15:25" /><verse number="26" style="v" sid="2SA 15:26" />Gido attiin izi, ‹Ta nenan ufayettabeekke› gizaa gidikko baas lo7o misati beettidayssa ta bolla ooththo; tani ekkanaas giigetta uttadis» gides.<verse eid="2SA 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 15:27" />Qasseka kawozi qeese Saadooqe, «Neni nabe gidikkii? Histtiko neni ne naa Akimaasenne Abiyaataare naa Yoonataane nenara ekkada saron guye katamayo simma; neninne Abiyaataarey nam7ati intte nayta ekkidi biite. <verse eid="2SA 15:27" /><verse number="28" style="v" sid="2SA 15:28" />Taikka neeppe wore siyana gakkanaas bazzon diza shaafaa pinnizason naagana» gides. <verse eid="2SA 15:28" /><verse number="29" style="v" sid="2SA 15:29" />Hessa gishshas Saadooqeynne Abiyaataarey Xoossa Caaqo Qaala Taabotaa guye Yerusalaame zaaridi heen takkida.<verse eid="2SA 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 15:30" />Gido attiin Dawiti yeekkishe pude Dabrazayte zuma pudunththaa kezides; ba hu7e gullunttidi mela tohora dees; izara issife diza asay ubbay izayssaththo bantta hu7e gullunttidi yeekkishe pudunththaa kezeettes. <verse eid="2SA 15:30" /><verse number="31" style="v" sid="2SA 15:31" />He wode, «Seeraa giddon Abeseloomera dizay Akxofeele» gi Dawites yootida; hessa gishshas Dawiti, «Abeet GODAWU! Akxofeele zoreza hada histtarkkii» gi woossides.<verse eid="2SA 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 15:32" />Dawiti derey Xoossa goynnizasoho pude zumaa kaara gakkishin Arkke dere as Hushey ba may7o daakkidi ba hu7e bolla gudulla laallidi izara gayttanaas yides.<verse eid="2SA 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 15:33" />Hessafe guye Dawiti iza, «Neni tanara issife biikko taas tooho gidana; <verse eid="2SA 15:33" /><verse number="34" style="v" sid="2SA 15:34" />gido attiin neni guye katamayo simmada Abeseloomes, ‹Ta ne aylle gidana; kase tani ne aawaas aylle gidida mala hachchika ta nees haggazana› gaada Akxofeele zore ne laallada tana maaddana. <verse eid="2SA 15:34" /><verse number="35" style="v" sid="2SA 15:35" />Qeeseti Saadooqeynne Abiyaataarey heen nenara daana deettennee? Kawo keeththafe ne siyidayssa ubbaa isttas yoota. <verse eid="2SA 15:35" /><verse number="36" style="v" sid="2SA 15:36" />Saadooqe naa Akimaasinne Abiyaataare naa Yoonataaney nam7u attuma nayti heen isttara deettes. Ne siyiza ubbaa taas istta bolla kiita yedda» gides.<verse eid="2SA 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2SA 15:37" />Hessa gishshas Dawites siiqo lagge Hushey Abeseloomey Yerusalaame gelida mala hee gakkides.<verse eid="2SA 15:37" /></para>
  <chapter eid="2SA 15" />
  <chapter number="16" style="c" sid="2SA 16" />
  <para style="s1">Dawitenne Xiibba</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 16:1" />Dawiti zumaappe guuth aadhdhi bida mala Xiibba geetettiza Memfeboste oosanchchay 200 sollo, zabibeppe uukettida qeeri uketh xeetata, balaseppe uukettida 100 qeeri ukeththinne issi lukkamo kumeth woyne ushshi caanettida nam7u hareta laaggi ekkidi izara gayttana yides.<note caller="-" style="x"><char style="xo" closed="false">16:1 </char><char style="xt" closed="false"><ref loc="2SA 9:9-10">2Same 9:9-10</ref></char></note><verse eid="2SA 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 16:2" />Dawiti Xiibba, «Hayssa ubbaa aazas ehadii?» gi oychchides. Xiibbayka, «Hareta kawo keeththa asati toggana mala, sollozanne ukeththata naateththati maana mala, woyne ushshaza bazzon daaburda asay uyana mala ehadis» gides.<verse eid="2SA 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 16:3" />Hessafe guye kawozi, «Ne godaa naazi awanee?» gi oychchides.</para>
  <para style="p" vid="2SA 16:3">Xiibbay zaaridi, «Izi, ‹Isra7eele asay hach ta aawa kawoteth taas zaarana› gi qoppida gishshas ha7i Yerusalaamen uttides» gides.<note caller="-" style="x"><char style="xo" closed="false">16:3 </char><char style="xt" closed="false"><ref loc="2SA 19:26-27">2Same 19:26-27</ref></char></note><verse eid="2SA 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 16:4" />Hessafe guye kawozi Xiibbas, «Kase Memfebostes dizay ubbay hayssafe guye neessa» gides;</para>
  <para style="p" vid="2SA 16:4">Xiibbay, «Daro ashketeththan sinththa guth gufannada ta nees kushe denththana; kawo ta godawu ne sinththan taas ayoteththi beetto» gides.<verse eid="2SA 16:4" /></para>
  <para style="s1">Shim7e Doqeth</para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 16:5" />Kawo Dawiti Bahirime gakkishin Sa7oole keeththa asaa qommofe issaadey puttu gides; izikka Geera naa Shim7e; izi doqqishe kezides. <verse eid="2SA 16:5" /><verse number="6" style="v" sid="2SA 16:6" />Kawoza wottadaratinne kawo bonchcho naagiza zabeti ubbay Dawiteppe hadirsa baggaranne ushachcha baggara dishinkka Dawite bollanne iza shuumeta bolla shuch caddides. <verse eid="2SA 16:6" /><verse number="7" style="v" sid="2SA 16:7" />Shim7ey iza doqqishe, «Keza! Hayssafe keza! Haysso shemppo wodhidayssoo! Haysso iitazoo! <verse eid="2SA 16:7" /><verse number="8" style="v" sid="2SA 16:8" />Izappe ne kawoteththaa woththa ekkida Sa7oole keeththa asaa ubbaa suuththaa GODAY ne bolla zaarishe dees. GODAY ne kawoteththaa ne naa Abeseloomes aaththi immides; neni shemppo wodhida as gidida gishshas beya ne bolla metoy yides» gides.<verse eid="2SA 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 16:9" />Hessafe guye Xuriya naa Abisayey kawozas, «Hayssi hayqeththa kanay, kawoza ta godaa wostti doqqizee? Ta pinna baada iza qoodhe qanxxana» gides.<verse eid="2SA 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 16:10" />Gido attiin kawozi, «Intteno Xuriya naytoo! Inttena tanara gaththiza ay miish dizee? GODAY, ‹Dawite doqqa› giin izi tana doqqizaa gidikko, ‹Hayssa ays ooththadii?› giidi iza oychchana dandayzay oonee?» gides.<verse eid="2SA 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 16:11" />Hessafe guye Dawiti Abisayenne ba shuumeta ubbaa, «Ta gulbateppe kezida ta naazi tana dhayssana koykko, hayssa Biniyaame qommoza gishshas ays malaletteetii? Hessa gishshas aggaagite! GODAY iza doqqa giidi yeddidaa gidikko doqqo. <verse eid="2SA 16:11" /><verse number="12" style="v" sid="2SA 16:12" />GODAY ta kawushshateththaa be7idi hachcha doqeththaa gishshas izi taas lo7o ooththanaakko oonee erizay» gides.<verse eid="2SA 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 16:13" />Hessa gishshas Dawitinne izara diza asay ba oge sinth gujjides; Shim7ey iza ginara diza laddaara bishe doqqees, shuch caddeessinne biitta iza bolla laallees. <verse eid="2SA 16:13" /><verse number="14" style="v" sid="2SA 16:14" />Kawozinne izara issife diza asati ubbay bantti baana gi qoppidaso gakkida; keehi daaburda gishshas heen shempida.<verse eid="2SA 16:14" /></para>
  <para style="s1">Husheynne Akxofeeley Immida Zore</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 16:15" />He wode Abeseloomeynne Isra7eele asay ubbay Yerusalaame yida; Akxofeeley izara issife dees. <verse eid="2SA 16:15" /><verse number="16" style="v" sid="2SA 16:16" />Dawite lagge Arkke dere as Hushey Abeseloomekko yiidi, «Kawoo! Mernaas kawota! Kawoo! Mernaas kawota!» gides.<verse eid="2SA 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 16:17" />Abeseloomey Hushes, «Ne laggezas diza ammaneteththay nees hanno xallaa? Ne ays ne laggezara babeekkii?» gi oychchides.<verse eid="2SA 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 16:18" />Hushey Abeseloomes zaaridi, «Hessa ta wostta ooththanee? Tani GODAAN, ha derezaninne Isra7eele asaa ubbaan doorettidaade bagga gidana; izaadera issife daana. <verse eid="2SA 16:18" /><verse number="19" style="v" sid="2SA 16:19" />Histtiin ta iza naazas haggazontta oonas haggazoo? Ne aawaas ta haggazida mala neeskka haggazana» gides.<verse eid="2SA 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 16:20" />Abeseloomey Akxofeele, «Ane nuus zore imma; nu ay ooththinoo?» gides.<verse eid="2SA 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 16:21" />Akxofeeley izas zaaridi, «Kawo keeththaa naagana mala ne aaway aggi bida iza laggeththotara gela zin7a; hessafe guye neni ne aawaa keeha ixxidayssa kumeththa Isra7eeley siyikko nenara diza ubbata qesey minnana» gides. <verse eid="2SA 16:21" /><verse number="22" style="v" sid="2SA 16:22" />Hessa gishshas Abeseloomes pooqe bolla dunkaane tolida; heen kumeththa Isra7eele derey be7ishin ba aawaa laggeththotara zin7ides.<note caller="-" style="x"><char style="xo" closed="false">16:22 </char><char style="xt" closed="false"><ref loc="2SA 12:11-12">2Same 12:11-12</ref></char></note><verse eid="2SA 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 16:23" />He wode Akxofeeley immiza zorey ubbay Xoossa qaalay zorizayssa misati qoodettees; Dawitinne Abeseloomey Akxofeele zore hessaththo histti ekkeettes.<verse eid="2SA 16:23" /></para>
  <chapter eid="2SA 16" />
  <chapter number="17" style="c" sid="2SA 17" />
  <para style="s1">Hushey Abeseloome Baleththida Baleththo</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 17:1" />Hessafe guye Akxofeeley Abeseloomes, «Ne aawaa yedeththanaas 12,000 as ta doorada hach omars yeddana. <verse eid="2SA 17:1" /><verse number="2" style="v" sid="2SA 17:2" />Izi daaburdi wolqqa ixettida wode ta iza bolla daafa yeggananne shiro yeddana; histtiko izara issife diza derey iza aggidi baqatana; tani kawoza xalla wodhana. <verse eid="2SA 17:2" /><verse number="3" style="v" sid="2SA 17:3" />Deraa ubbaa neekko zaarana; neni koyzay issi asa hayqo gaason ubba deraa neekko zaarana mala ooththana; hessafe guye derey saron daana» gides. <verse eid="2SA 17:3" /><verse number="4" style="v" sid="2SA 17:4" />Iza zorezi Abeseloomenne izara diza Isra7eele cimata ubbaa ufayssides.<verse eid="2SA 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 17:5" />Abeseloomey gidikko, «Qasse ane Arkke dere as Hushe xeygidi izi gizayssaka siyoos» gides. <verse eid="2SA 17:5" /><verse number="6" style="v" sid="2SA 17:6" />Hushey izakko yiin Abeseloomey izas, «Akxofeeley nuus hayssa ha zoreza shiishshides; histtiin nuni iza ooththinoo? Akkay giikko ane ne qofa nuus yoota» gides.<verse eid="2SA 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 17:7" />Husheykka Abeseloome, «Akxofeeley nees immida zorey hanni wode nena kessi ekkenna. <verse eid="2SA 17:7" /><verse number="8" style="v" sid="2SA 17:8" />Ne aawaynne iza olanchchati mino olanchchatanne marati izippe bonqqettichchida zardo mala istti babisizayssa nekka eraasa; hessafe bollarakka ne aaway olan keehi loohida asa; omars ba olanchchatara aqenna; <verse eid="2SA 17:8" /><verse number="9" style="v" sid="2SA 17:9" />Hanni wode izi issi gongolo giddon woykko harason qotetti uttidaa gidana. Izi sinththatidi asaa bolla daafa yeggiin ne asatappe guuththati hayqqiko hessa siyida ubbay, ‹Abeseloome kaallida olanchchati wurida› gi haasayana. <verse eid="2SA 17:9" /><verse number="10" style="v" sid="2SA 17:10" />Ne aaway mino olanchcha, izara issife dizaytikka ola qarata gididayssa Isra7eele asay ubbay eriza gishshas wozinay gaammo wozina mala murtta geetettida wottadaraykka babon baqibaqana.<verse eid="2SA 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 17:11" />«Hessa gishshas ta nena zoriza zorey hayssa; izas qooday abba shaamintta mala darida Daaneppe biidi Bersaabehe gakkanaas diza Isra7eele asay ubbay neekko shiiqikko neni ne hu7era olaa kaaleththa. <verse eid="2SA 17:11" /><verse number="12" style="v" sid="2SA 17:12" />Histtiko izi gelidaso ubbaa gelidi iza bolla daafa yeggana; xaazay biitta bolla wodhdhiza mala nu iza bolla wodhdhana; iza gidiin izara diza asatappe issaadeyka kessi ekki attenna. <verse eid="2SA 17:12" /><verse number="13" style="v" sid="2SA 17:13" />Izi biidi issi katamayn gelikko Isra7eeley ubbay wodoro ekki biidi issi shuchchika heen attonttaashe gakkanaas katamayo duge laalli yeggana» gides.<verse eid="2SA 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 17:14" />Abeseloomeynne Isra7eele asay kumeth, «Akxofeele zoreppe Arkke dere as Hushe zorey lo7ees» gida; GODAY Abeseloome bolla bash ehanaas lo7o gidida Akxofeele zorey ekettontta mala ooththides.<verse eid="2SA 17:14" /></para>
  <para style="s1">Dawiti Kessi Ekki Ateth</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 17:15" />Hushey qeese Saadooqenne Abiyaataare, «Akxofeeley Abeseloomeynne Isra7eele cimati ay ay ooththanaas bessizaakko istta zorides; tani gidikko hayssa hayssa ooththite ga zoradis. <verse eid="2SA 17:15" /><verse number="16" style="v" sid="2SA 17:16" />Ha7i izas eeson kiittidi, ‹Bazzon diza shaafa purden aqontta mala, gam7ontta ne eeson pinnanaas bessees; ne histtontta aggiko kawozinne izara diza derey ubbay intte mitettana› giidi Dawites yootite» gides.<verse eid="2SA 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 17:17" />He wode Yoonataaneynne Akimaasi katama gelikko istti beettana En-Roogeelen naageettes; issi geela7o aylle daara hee baada isttas yootiin istti hessa efidi kawo Dawites yooteettes. <verse eid="2SA 17:17" /><verse number="18" style="v" sid="2SA 17:18" />Gido attiin issi naateth dayssi istta be7idi Abeseloomes yootides; hessa gishshas nam7atikka eeson dendidi Bahirimen diza issi addezaso bida; addeza gibbe giddon ollay diza gishshas istti he ollaan wodhdhida. <verse eid="2SA 17:18" /><verse number="19" style="v" sid="2SA 17:19" />He addeza machcheya micciza miish ehada iza bolla kath miccadus; hessa oonikka eribeenna.<verse eid="2SA 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 17:20" />Abeseloome asati he maccassayko yiidi, «Akimaasinne Yoonataaney awan dizoo?» gi oychchida.</para>
  <para style="p" vid="2SA 17:20">Maccassaya isttas, «Shaafaa pinni bida» gadus; isttika koyiin dhayda gishshas guye Yerusalaame simmida.<verse eid="2SA 17:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 17:21" />Asati bidaappe guye ha nam7ati ollaafe kezidi bida; kawo Dawites, «Akxofeeley ne bolla hizgi hizgi asaa denththeththiza gishshas dendada eeson gede shaafa pinna» gida. <verse eid="2SA 17:21" /><verse number="22" style="v" sid="2SA 17:22" />Hessa gishshas Dawitinne izara issife diza derey ubbay dendi Yordaanoose pinnida; gadey wontishin Yordaanoose pinnonttay oonikka deenna.<verse eid="2SA 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 17:23" />Akxofeeley istti iza zoreza ekkontta ixxidayssa be7idi ba hareza caani ekkidi ba keeththi diza katama bides; baso maarasi giigsidaappe guye ba kushen cuuletti hayqqides; hessaththo hayqqidi ba aawa duufon moogettides.<verse eid="2SA 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 17:24" />Abeseloomey kumeththa Isra7eele asaara Yordaanoose pinnishin Dawiti Mahanayme gakkides. <verse eid="2SA 17:24" /><verse number="25" style="v" sid="2SA 17:25" />Abeseloomey Iyo7aabe sohon Amasa olanchchata halaqa histti shuumides; Amasi Isra7eele dere as Yootore naa; Yootorey Iyo7aabe aayo, Xuriya michcho, Na7oose biyo Abigaalo machcho ekkides. <verse eid="2SA 17:25" /><verse number="26" style="v" sid="2SA 17:26" />Isra7eeletinne<note caller="+" style="f"><char style="fr" closed="false">17:26 </char><char style="ft" closed="false">Issi issi birsheththatan Isra7eele gizayssa Isma7eele geettes. 1 Taari 2:17</char></note> Abeseloomey Gala7aaden dunkaanida.<verse eid="2SA 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 17:27" />Dawiti Mahanayme gakkishin Amoone katama Eraabappe yida Na7oose naa Shoobbey, Lodibaareppe yida Am7eele naa Maakirenne Erogilimeppe yida Gala7aade dere as Barziley, <verse eid="2SA 17:27" /><verse number="28" style="v" sid="2SA 17:28" />hiixa minxaafeta, shel7etanne mana miishshata ekki yida; hessaththoka gisttenne bangga, dhiillenne tiya caaca; ba7elanne misira, <verse eid="2SA 17:28" /><verse number="29" style="v" sid="2SA 17:29" />ees, meqa maath, dorsatanne pila Dawitesinne deraas istti maana mala ehida. Istti hessa ooththiday, «Derezi bazzo biittan koshattides; daaburdes; saamettides» gida gishshassa.<verse eid="2SA 17:29" /></para>
  <chapter eid="2SA 17" />
  <chapter number="18" style="c" sid="2SA 18" />
  <para style="s1">Abeseloome Hayqo</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 18:1" />Dawiti banara diza deraa qoodides; istta bolla shaalaqatanne mato halaqata shuumides. <verse eid="2SA 18:1" /><verse number="2" style="v" sid="2SA 18:2" />Hessafe guye Dawiti cigo gidiza ba olanchchata Iyo7aabe, nam7anththo cigoza Iyo7aabe isha Xuriya naa Abisaye, heedzdzanththo cigoza Geete dere as Ittaye azazon aqana mala kiittides. Kawozi ba olanchchatas, «Tumappe tanikka inttenara kezana» gides.<verse eid="2SA 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 18:3" />Asati gidikko iza, «Neni nunara kezanaas bessenna; nuna baqatissiza miishshi diikko asay hessa gita miishshan qoodenna; haray attoshin nuuppe baggay hayqqikokka istti wudu geettenna; neni nerkka nuuppe tammu shiyatappe aadhdhaasa; hessa gishshas neni kataman uttada nuna maaddiko lo7o» gida.<verse eid="2SA 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 18:4" />Kawozikka, «Inttes lo7o misati beettiza ubbaa ta ooththana» gides. Hessa gishshas derey ubbay xeetan xeetan, shiyan shiyan shaaketti shaaketti salfi keziza wode kawozi gimbeza pengen eqqi dees. <verse eid="2SA 18:4" /><verse number="5" style="v" sid="2SA 18:5" />Kawozi Iyo7aabe, Abisanne Ittaye, «Ta gishshas giidi ta naaza Abeseloome bolla issi metokka gaththofte» gi azazides. Kawozi ba naa Abeseloome gishshas azazizaytas issaas issaas azazo immishin ubba olanchchatikka siyida.<verse eid="2SA 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 18:6" />Olanchchati Isra7eele olanaas salfidi kezida; olaza Efreeme wora giddon olettida. <verse eid="2SA 18:6" /><verse number="7" style="v" sid="2SA 18:7" />Heen Isra7eele asay Dawite ola asaan xoonettides; he gallas keehi daroti hayqqida; 20,000 asi hayqqides. <verse eid="2SA 18:7" /><verse number="8" style="v" sid="2SA 18:8" />Olay deraa garsan aakki aakki bides; he gallas olay wursidayssafe woray mitti dhayssida asay darees.<verse eid="2SA 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 18:9" />He wode Abeseloomey Dawite asaara toorontta dishe gayttides; Abeseloomey baqulo toggidi cippi gida haggay diza wola garsara aadhdhi bishin Abeseloome hu7e binanay haggan oykettides; izi toggida baquloya aadhdha biin izi saloppenne sa7appe giddon kaqetti attides.<verse eid="2SA 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 18:10" />Issaadey iza be7idi Iyo7aabes, «Hekko tani Abeseloomey wola bolla kaqetti dizayssa be7adis» gides.<verse eid="2SA 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 18:11" />Iyo7aabey baas yootida addezas zaaridi, «Ay gadii? Histtiin ne be7ida mala ays heerakka wodhada biittan yeggabeekkii? Ne hessaththo ooththidaakko ta nees tammu saqile biranne ola qarata qabatto immanakkoshin» gides.<verse eid="2SA 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 18:12" />Gido attiin addezi zaaridi, «Nuni siyishin kawozi, ‹Naateththaza Abeseloome bolla qohoy gakkontta mala ta gishshas giidi minththi naagite› giidi nena, Abisanne Ittaye azazida gishshas 1,000 saqile bira ne taas immidaakkoka tani ta kushe kawoza naaza bolla woththike. <verse eid="2SA 18:12" /><verse number="13" style="v" sid="2SA 18:13" />Hara baggara tani ta shemppos mishettontta aggada ta iza wodhidaakko kawozappe qotetti attiza miishshi baynda gishshas neni ne baggara taakko shiiqakka» gides.<verse eid="2SA 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 18:14" />Iyo7aabey addezas, «Hayssafe guye hayssa mala haasayan ta nenara wode wursike» gides; 3 toora ekki biidi Abeseloomey miththa bolla kaqetti dizason buro shemppo kezontta dishin toorata xongidi izas wozina ayfen caddides. <verse eid="2SA 18:14" /><verse number="15" style="v" sid="2SA 18:15" />Hessaththoka Iyo7aabe azhabiza tammati, Abeseloome giddoththi caddi wodhida.<verse eid="2SA 18:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 18:16" />Hessafe guye Iyo7aabey zaye punnidi istta diggida gishshas olanchchati Isra7eele yedeththizayssa aggida. <verse eid="2SA 18:16" /><verse number="17" style="v" sid="2SA 18:17" />Abeseloome wora giddo efidi ciimma ollan yeggida; gita shuchchata iza bolla doorida. He wode Isra7eele asay ubbay baso baso baqatides.<verse eid="2SA 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 18:18" />Abeseloomey, «Ta sunth xeygisiza nay taas deenna» giidi iza hassa7issana mala shemppora paxa diza wode kawo zulle geetettizason ba sunththan hawulte essi woththida gishshas he sohozi hach gakkanaas Abeseloome hawulte geetettees.<verse eid="2SA 18:18" /></para>
  <para style="s1">Dawite Kayoteth</para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 18:19" />He wode Saadooqe naa Akimaasi, «GODAY iza morkketa bolla kome koxxidayssa woxxa baada tani kawozas mishiraachcho yootana» gides.<verse eid="2SA 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 18:20" />Iyo7aabey, «Hach mishiraachcho qaala efanay nena gidakka; kawoza nay hayqqida gishshas hach gidontta hara gallas efandasa» gides.<verse eid="2SA 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 18:21" />Hessafe guye Iyo7aabey Tophphiya dere addezas, «Ne be7idayssa baada kawozas yoota» gides; Tophphiya dere addezi Iyo7aabes kushe denththi bessidi woxxi bides.<verse eid="2SA 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 18:22" />Saadooqe naa Akimaasi Iyo7aabes, «Ba hanaa hano; ane zay hayssa Tophphiya addeza geedora tanikka woxxays» gides.</para>
  <para style="p" vid="2SA 18:22">Iyo7aabey gidikko, «Ne ays baana koyadii? Nees imota imisiza ay mishiraachcho ekkada bay?» gides.<verse eid="2SA 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 18:23" />Akimaasikka, «Ba hanaa hano; ta baana koyays» gides.</para>
  <para style="p" vid="2SA 18:23">Hessa gishshas Iyo7aabey, «Histtiko woxxa!» gides. Hessafe guye Akimaasi demban diza ogezara woxxi Tophphiya dere addezappe sinththati bides.<verse eid="2SA 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 18:24" />Dawiti kare bagga pengefenne giddo pengefe giddon dishin zabezi dirsaa gimbe bolla diza shakko kaara kezidi kare xeellishe issi asi barkka woxxizayssa be7ides. <verse eid="2SA 18:24" /><verse number="25" style="v" sid="2SA 18:25" />Naagizayssi xeygidi hessa kawozas yootides;</para>
  <para style="p" vid="2SA 18:25">Kawozikka, «Barkka yizaade gidikko lo7o mishiraachcho ekki yizaade gidana» gides; addezi mati mati yides.<verse eid="2SA 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 18:26" />Qasseka naagizayssi hara asi woxxishin be7ides; zabezakka xeygidi, «Hekko hara asi barkka woxxi yishe dees» gides.</para>
  <para style="p" vid="2SA 18:26">Kawozi, «Hessaadeyka lo7o wore ekki yizaa gidana bessees» gides.<verse eid="2SA 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 18:27" />Naagizayssi, «Koyroyssa woththi Saadooqe naa Akimaase woth misatees» gides.</para>
  <para style="p" vid="2SA 18:27">Kawozi, «Izi lo7o asa; izi mishiraachcho qaala ekkontta yeenna» gides.<verse eid="2SA 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 18:28" />Akimaasi keehi waassidi kawozas, «Ubba miishshika injjetides» gides; hessafe guye biitta bolla zaqulth zirxxi gides; kawozasikka kushe denththidi, «Ta godaa kawoza bolla bantta kushe denththida asata aaththi immida GODAA ne Xoossay galatetto!» gides.<verse eid="2SA 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 18:29" />Kawozikka iza, «Ta naa Abeseloomey lo7o dizee?» gi oychchides.</para>
  <para style="p" vid="2SA 18:29">Akimaasikka, «Iyo7aabey kawoza oosanchchazanne tana ne aylleza kiittishin gita shiro be7adis; gido attiin izi aazakko ta erabeekke» gides.<verse eid="2SA 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 18:30" />Kawozikka iza, «Ane issi bagga aadhdha eqqa» gides. Izikka aadhdhi eqqides.<verse eid="2SA 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 18:31" />Hessafe guye Tophphiya dere addezi gakkidi, «Ta godaa kawoo, Mishiraachcho! GODAY hach ne bolla dendida morkketa ubbaafe nena ashshides» gides.<verse eid="2SA 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 18:32" />Kawozikka Tophphiya dere addeza, «Ta naa Abeseloomey lo7i dizee?» gi oychchides.</para>
  <para style="p" vid="2SA 18:32">Tophphiya dere addezikka, «Ta godaa kawoza morkketinne nena qohana ne bolla dendiza ubbati he naateththaza mala gidetto» gides.<verse eid="2SA 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 18:33" />Kawozi keehi ceecides; gimbeza penge bolla diza pooqe bolla kezidi heen yeekkides; bishekka, «Ta naa Abeseloome! Ta naa Abeseloome! Ne gishshas ta hayqqarkkinaa! Ta naa Abeseloome woo! Ta naa Abeseloome woo!» gides.<verse eid="2SA 18:33" /></para>
  <chapter eid="2SA 18" />
  <chapter number="19" style="c" sid="2SA 19" />
  <para style="s1">Iyo7aabey Dawite Walassida Walasse</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 19:1" />Iyo7aabes, «Kawo Dawiti ba naa Abeseloome gishshas yeekkishenne kayottishe dees» geetetti yootettides. <verse eid="2SA 19:1" /><verse number="2" style="v" sid="2SA 19:2" />Kawozi, «Ba naaza gishshas kayottees» gizayssa he gallas olanchchati siyida gishshas he gallassa xoonoy kumeththa olanchchata matan ceecen laametti pe7ides. <verse eid="2SA 19:2" /><verse number="3" style="v" sid="2SA 19:3" />He gallas olappe yeellatishe katama geliza asa mala dereykka shaaphettishe katama gelides. <verse eid="2SA 19:3" /><verse number="4" style="v" sid="2SA 19:4" />Kawozi ba ayfeso kammi woththidi, «Ta naa Abeseloome woo! Ta naa Abeseloome woo» gishe zilalides.<verse eid="2SA 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 19:5" />Hessafe guye Iyo7aabey kawozaso gelidi, «Ne shemppo, ne attuma nayta shemppo, ne macca nayta shemppo, ne machchetanne ne laggeththota shemppo ashshida asata hach ne yeellachchadasa. <verse eid="2SA 19:5" /><verse number="6" style="v" sid="2SA 19:6" />Nena ixxizayta ne dosaasa; qasse nena dosizayta ixxaasa; ne ola gadawatinne istta wottadarati nees aykkoka gidonttayssa hekko hach ne qonccisadasa; hach Abeseloomey shemppora paxa diin nu ubbay wuridaakko ne ufayettanayssa ta be7adis. <verse eid="2SA 19:6" /><verse number="7" style="v" sid="2SA 19:7" />Ha7i dendada kare keza asaa minththeththa; ne kezontta ixxiko ha omarsayn issi asikka nenara gidonttayssa ta GODAA sunththan caaqqays; hessi nees naateteththafe doommiin hayssa gakkanaas ne bolla gakkida iita yo7ota ubbaafe aadho meto ne bolla gaththana» gides. <verse eid="2SA 19:7" /><verse number="8" style="v" sid="2SA 19:8" />Hessa gishshas kawozi penge lanqen uttiin derezas, «Hekko kawozi penge lanqen uttides» geetetti yootettiin derezi ubbay kawozaakko yides.</para>
  <para style="s1" vid="2SA 19:8">Yerusalaame Baanaas Dawite Denth</para>
  <para style="p" vid="2SA 19:8">He wode kumeth Isra7eele asay baso baso baqatides.<verse eid="2SA 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 19:9" />Kumeththa Isra7eele qommoti, derezikka ba garsan issoy issaara marshettishe, «Kawozi nuna nu morkketa kusheppe kessi ekkides; Filisxeemeta kusheppeka nuna ashshiday iza; ha7i gidikko Abeseloome gaason dereppe baqati bides. <verse eid="2SA 19:9" /><verse number="10" style="v" sid="2SA 19:10" />Izi nuna haarana mala nu tiyda Abeseloomey gidikko olan hayqqides. Histtiin intte kawoza simo gishshas ays co7u geetii?» gides.<verse eid="2SA 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 19:11" />Kawo Dawiti qeese Saadooqessinne Abiyaataares kiita yeddishe, «Yuhuda cimatas, ‹Kumeththa Isra7eelen haasayettiza yo7o ubbay kawozi dizason izas gakkida gishshas kawoza kawoteththa keeth zaaranaas intte waanidi wurseththa as gideetii? <verse eid="2SA 19:11" /><verse number="12" style="v" sid="2SA 19:12" />Intte ta meqeththata, ta ashotanne ta ishata; histtiin intte kawoza zaaranaas waanidi wurseththa as gideetii?› giite.<verse eid="2SA 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 19:13" />«Qasse Amasi, ‹Nenikka ta meqeththinne ta asho gidikkii? Hannife doommidi ne de7o wurseth gakkanaas Iyo7aabe qoodhe ta olanchchata azazizaade ooththontta aggiko Xoossi ta bolla iita miish ooththo; hessafekka aadhdhiza iita miish ta bolla eho› gides» giidi yootite.<verse eid="2SA 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 19:14" />Izikka Yuhuda asaa ubbaa wozina issi asa wozina mala histti di7ides; isttika izas, «Neni ne asaa ubbaara simma» giidi kiita yeddida. <verse eid="2SA 19:14" /><verse number="15" style="v" sid="2SA 19:15" />Kawozi hessafe guye simmidi Yordaanoose gakkanaas yides.</para>
  <para style="p" vid="2SA 19:15">He wode Yuhuda asay kawoza ekkidi Yordaanoose pinththanaas Gelgela gakkanaas bides. <verse eid="2SA 19:15" /><verse number="16" style="v" sid="2SA 19:16" />Bahirime dere as Geera naa Biniyaame qommo Shim7ey kawo Dawite mokkanaas Yuhuda asaara issife eeson wodhdhides.<note caller="-" style="x"><char style="xo" closed="false">19:16 </char><char style="xt" closed="false"><ref loc="2SA 16:5-13">2Same 16:5-13</ref></char></note> <verse eid="2SA 19:16" /><verse number="17" style="v" sid="2SA 19:17" />Issi shii Biniyaame qommoti, hessaththoka Sa7ooleso oosanchcha Xiibbas 15 attuma naytinne 20 aylleti izara issife deettes. Hessafe guye kawozi dizaso Yordaanoose eeson wodhdhida. <verse eid="2SA 19:17" /><verse number="18" style="v" sid="2SA 19:18" />Kawozaso asaa ehanaassinne izi koyida ubbaa ooththanaas istti zokkora pinnida.</para>
  <para style="s1" vid="2SA 19:18">Dawiti Shim7e Maarida Maaro</para>
  <para style="p" vid="2SA 19:18">Geera naa Shim7ey Yordaanoose pinnides; kawoza sinththan gufannidi, <verse eid="2SA 19:18" /><verse number="19" style="v" sid="2SA 19:19" />«Ta godawu ta nena qohidayssa qoodoppa; ta godaa kawo ne Yerusalaameppe kezida gallas ta ooththida mooroza maara; ne wozinan woththofa. <verse eid="2SA 19:19" /><verse number="20" style="v" sid="2SA 19:20" />Tani ne oosanchchay ooththida nagara eriza gishshas hach ta godaa kawoza mokkanaas Yooseefe keeththa asaa ubbaafe koyrotta yadis» gides.<verse eid="2SA 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 19:21" />Hessafe guye Xuriya naa Abisayey, «Shim7ey GODAAN tiyettidaade izi cayida gishshas izas hayqoy bessennee?» gides.<verse eid="2SA 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 19:22" />Dawitikka, «Intteno Xuriya naytoo; inttenara tana aazi gaththizee? Intte hach taas morkke gidideta! Ay asikka hach Isra7eeleppe hayqqana bessizee? Hessi ta Isra7eele bolla kawotidayssa ta erida gallas gidennee?» gides. <verse eid="2SA 19:22" /><verse number="23" style="v" sid="2SA 19:23" />Hessa gishshas kawozi Shim7e, «Neni hayqqaka» gides; hessa kawozi caaqon minththides.<verse eid="2SA 19:23" /></para>
  <para style="s1">Dawiti Memfeboste Maarida Maaro</para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 19:24" />Sa7oole naa Memfebostey kawoza mokkanaas duge wodhdhides; kawozi beti boosofe doommidi simmi yida gallas gakkanaas ba tohos bessiza miish ooththibeenna; ba buuchcheka meedettibeenna; ba may7oka meeccibeenna.<note caller="-" style="x"><char style="xo" closed="false">19:24 </char><char style="xt" closed="false"><ref loc="2SA 9:1-13">2Same 9:1-13</ref>; <ref loc="2SA 16:1-4">16:1-4</ref></char></note> <verse eid="2SA 19:24" /><verse number="25" style="v" sid="2SA 19:25" />Izi kawoza mokkanaas Yerusalaameppe yiin kawozi iza, «Memfeboste, ne tanara aazas bontta aggadii?» gi oychchides.<verse eid="2SA 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 19:26" />Izikka zaaridi, «Ta godaa kawoo! Ta ne oosanchchay toho sila gidida gishshas, ‹Tani kawozara baana mala ta harey taas kooretto; ta iza bolla utta baana› gadis; gido attiin ta oosanchcha Xiibbay tana baleththides. <verse eid="2SA 19:26" /><verse number="27" style="v" sid="2SA 19:27" />Ta godaa kawo sinththan tana ne oosanchchaza sunth moorides; ayde gidiinkka ta goday kawoy neni Xoossa kiitanchcha mala gidida gishshas nena lo7ida ubbaa ooththa. <verse eid="2SA 19:27" /><verse number="28" style="v" sid="2SA 19:28" />Ta aawa keeththas ubbaas hayqoy bessishin neni gidikko tana ne oosanchchaza ne maaddafe mizaytara issife utisadasa; hayssafe haray taas hano gaada kawoza oychchanaas ta oonee?» gides.<verse eid="2SA 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 19:29" />Kawozikka, «Ne ays yo7o darsay? Neninne Xiibbay iza gadaa ubbaa intte gishetti ekkana mala ta azazadis» gides.<verse eid="2SA 19:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 19:30" />Memfebostey kawoza, «Ta godaa kawoo! Izi hashshu lo7on simmides; ubbaaka izi ekko» gides.<verse eid="2SA 19:30" /></para>
  <para style="s1">Dawiti Barziles Ooththida Kiyateth</para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 19:31" />Hessaththoka Gala7aade dere as Barziley Erogilime woradappe kawoza moyzanaas izara issife Yordaanoose pinnides.<note caller="-" style="x"><char style="xo" closed="false">19:31 </char><char style="xt" closed="false"><ref loc="2SA 17:27-29">2Same 17:27-29</ref></char></note> <verse eid="2SA 19:31" /><verse number="32" style="v" sid="2SA 19:32" />He wode Barziley wode sugida 80 layththa cima; izi keehi dure gidida gishshas kawozi Mahanaymen dishin izas maana miish ehides. <verse eid="2SA 19:32" /><verse number="33" style="v" sid="2SA 19:33" />Kawozi Barzile, «Tanara pinnada Yerusalaamen issife da; ta nena heemmana» gides.<verse eid="2SA 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2SA 19:34" />Barziley gidikko kawozas, «Tani kawozara Yerusalaamen ay keena layth daanaas boo? <verse eid="2SA 19:34" /><verse number="35" style="v" sid="2SA 19:35" />Tani ha7i 80 layththa cima; Histtiin tani iitanne kiya shaakka erana dandayanee? Hayssafe guye ne aylley mizayssanne uyizayssa mal7o shaakki eranee? Attuma nayta cenggurssinne macca nayta cenggurs ha7i ta siyana dandayanee? Histtiin ne aylley ta godaa kawozas ays bollara hara tooho gidanee? <verse eid="2SA 19:35" /><verse number="36" style="v" sid="2SA 19:36" />Ne aylley kawozara pinnidi guuththa oge baana; kawoy hessa kushe taas zaarandee? <verse eid="2SA 19:36" /><verse number="37" style="v" sid="2SA 19:37" />Ta diza katamaan hayqqada ta aawaanne ta aayey duufo achchan ta moogettana mala ne aylleza ne moyzikko izi simmo; gido attiin ne aylle Keme7aamey ta godaa kawozara pinno; histtiko nena lo7ida miish ne izas ooththa» gides.<verse eid="2SA 19:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 19:38" />Kawozikka, «Keme7aamey tanara pinnana; nena ufayssiza miish ubbaa ta izas ooththana; ne taappe koyza ay miishshika ta nees ooththana» gides.<verse eid="2SA 19:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="2SA 19:39" />Hessa gishshas derezi ubbay Yordaanoose pinnides; hessafe guye kawozi pinnides. Kawozi Barzile yeeri ekkidi anjjides; Barzileykka baso simmi bides.<verse eid="2SA 19:39" /></para>
  <para style="s1">Dawite Gishshas Deraa Marsheteth</para>
  <para style="p">
    <verse number="40" style="v" sid="2SA 19:40" />Kawozi Gelgela bishin Keme7aamey izara issife bides; Yuhuda olanchchati ubbaynne Isra7eele olanchchatappe baggay kawoza azhabidi pinththida.<verse eid="2SA 19:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="2SA 19:41" />Heerakka Isra7eele asay ubbay kawozaakko yiidi, «Nu ishati Yuhuda asati kawoza garsara banttarkka izanne izaso asata, iza kaallizaytara Yordaanoose ays pinththidoo?» gida.<verse eid="2SA 19:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="2SA 19:42" />Yuhuda asay ubbay Isra7eele asaas, «Nu hayssa ooththiday kawozi nuus mata dabbo gidida gishshassa; histtiin hayssi inttena hanqeththizee? Nuni kawoppe ekki mida miishshi dizee? Nuni ay miish ekkidonii?» gida.<verse eid="2SA 19:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="2SA 19:43" />Hessafe guye Isra7eele asay Yuhuda asaas, «Nuna kawozappe tammu kushey gakkees; hessafe bollarakka inttefe nuus aadhdhiza maatay dees; histtiin intte nuna aazas kadhidetii? Nu kawozi simmana mala koyro oychchiday nuna gidokkonii?» gida.</para>
  <para style="p" vid="2SA 19:43">Gido attiin Yuhuda asay immida zaaroy Isra7eele asay immida zaaroppe keehi mino.<verse eid="2SA 19:43" /></para>
  <chapter eid="2SA 19" />
  <chapter number="20" style="c" sid="2SA 20" />
  <para style="s1">Sheba7e Makkallateth</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 20:1" />He wode Biniyaame qommota giddofe Bikire naa Sheba7e geetettiza kofa asi dees; izi zaye punnishe,</para>
  <para style="q2" vid="2SA 20:1">«Nuus Dawitera</para>
  <para style="q2" vid="2SA 20:1">gaytoteththi deenna;</para>
  <para style="q2" vid="2SA 20:1">Isseye naakkon nuus</para>
  <para style="q2" vid="2SA 20:1">xinxxoy deenna;</para>
  <para style="q1" vid="2SA 20:1">Isra7eele asawu!</para>
  <para style="q2" vid="2SA 20:1">Ne dunkaanen dunkaanen</para>
  <para style="q2" vid="2SA 20:1">simma!» gi waassides.<note caller="-" style="x"><char style="xo" closed="false">20:1 </char><char style="xt" closed="false"><ref loc="1KI 12:16">1Kawo 12:16</ref>; <ref loc="2CH 10:16">2Taari 10:16</ref></char></note><verse eid="2SA 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 20:2" />Hessa gishshas Isra7eele asay ubbay Dawite kaddidi Bikire naa Sheba7e kaallides; gido attiin Yuhuda asay Yordaanooseppe doommidi Yerusalaame gakkanaas bantta kawozappe shaakettontta issife bida.<verse eid="2SA 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 20:3" />Dawiti Yerusalaamen diza ba kawoteththa keeth simmida wode ba kawoteththa keeththaa naagana mala kase izi woththi bida tammu laggeththo maccassata ekkides; istti issi keeththan naagetti daana mala naage woththides; isttas koshshiza qallabakka immides. Gido attiin isttara aqibeenna; istti hayqqanaashe gakkanaas am7i mala banttarkka dumma de7ida.<note caller="-" style="x"><char style="xo" closed="false">20:3 </char><char style="xt" closed="false"><ref loc="2SA 16:22">2Same 16:22</ref></char></note><verse eid="2SA 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 20:4" />Hessafe guye kawozi Amasas, «Yuhuda asay ubbay heedzdzu gallassa giddon taakko yaana mala xeyga; nekka ne hu7era beetta» gides. <verse eid="2SA 20:4" /><verse number="5" style="v" sid="2SA 20:5" />Amasi Yuhuda xeygana bides; gido attiin kawozi barida gallassatappe keehi takkides.<verse eid="2SA 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 20:6" />Dawiti Abisayes, «Ha7i Abeseloomeppe bollara Bikire naa Sheba7ey daro meto nu bolla gaththana koyza gishshas ne godaa wottadarata ekkada iza yedeththa; ne histtontta aggiko miixay diza katamata demmidi nuuppe kessi ekki attana» gides. <verse eid="2SA 20:6" /><verse number="7" style="v" sid="2SA 20:7" />Hessa gishshas Iyo7aabe wottadarati, Keliteti, Pelitetinne wolqqama olanchchati ubbay Abisaye azazon kezida; istti Yerusalaameppe keziday Bikire naa Sheba7e yedeththanaassa. <verse eid="2SA 20:7" /><verse number="8" style="v" sid="2SA 20:8" />Istti Geba7oonen wogga zaalla matan dishin Amasi isttara gayttana kezides; Iyo7aabey ola may7o may7idi giththa mashsha kohozara gixxi uttides; izi sinththe tanggida mala mashshazi kohozappe kezi gaden wodhdhides.<verse eid="2SA 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 20:9" />Iyo7aabeykka Amasa, «Ta ishazoo ne ay mala day?» gides; histtidi Iyo7aabey yeeriza as misatidi ba ushachcha kushen Amasa buuch oykkides. <verse eid="2SA 20:9" /><verse number="10" style="v" sid="2SA 20:10" />Gido attiin Amasi Iyo7aabe kushen mashshay dizayssa akeekontta aggida gishshas bana naagibeenna. Histtiin Iyo7aabey iza ulon caddides; iza maracey biitta bolla wololu gides; Iyo7aabey hara gujjontta dishin Amasi heerakka shemppo kezides. Hessafe guye Iyo7aabeynne iza isha Abisayey Bikire naa Sheba7e goodereththo doommida.<verse eid="2SA 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 20:11" />Amasa aha achchan eqqida Iyo7aabe wottadaratappe issoy, «Iyo7aabe dosizaynne Dawites gidida ubbay Iyo7aabe kaallo!» gides. <verse eid="2SA 20:11" /><verse number="12" style="v" sid="2SA 20:12" />He wode Amasa ahay suuththan moorettidi<note caller="+" style="f"><char style="fr" closed="false">20:12 </char><char style="ft" closed="false">Suuththan moorettidi gizayssi Ibraaweta maxaafan genderides gees.</char></note> oges giddo addan porccu gi dees. Heera aadhdhi biza wottadarati ubbay eqqi xeellishin he addezi be7idi ahaza mata gakkida wottadarati ubbay eqqi xeellizayssa akeekides; Amasa ahaza oge bollafe goshsha giddo efidi may7o iza bolla yeggides. <verse eid="2SA 20:12" /><verse number="13" style="v" sid="2SA 20:13" />Ahazi ogeppe dendidaappe guye asay ubbay Bikire naa Sheba7e gooddanaas Iyo7aabe kaalli bides.<verse eid="2SA 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 20:14" />Sheba7ey Isra7eele nayta qommota ubbaa giddora kanththidi Aabeeli-Beeti-Ma7ikanne Beere dere yides. Beere asay issi bolla shiiqettidi iza kaallides. <verse eid="2SA 20:14" /><verse number="15" style="v" sid="2SA 20:15" />Iyo7aabera diza wottadarati yiidi Aabeeli-Beeti-Ma7ikan Sheba7e giddoththida; katamappe kare baggara yuuyi aadhdhanaas gimbezas pude xeera gakkanaas biitta doorida; istti gimbeza laallanaas keehi shociza wode, <verse eid="2SA 20:15" /><verse number="16" style="v" sid="2SA 20:16" />he katamayn issi wozinama maccassi dizaara ba qaala dhoqqu histtada «Aso siyite! Siyite! Iyo7aabes ta yootana miishshi diza gishshas izi haa yaana mala izas yootite!» gadus. <verse eid="2SA 20:16" /><verse number="17" style="v" sid="2SA 20:17" />Iyo7aabey izikko biin maccassaya izas,</para>
  <para style="q1" vid="2SA 20:17">«Iyo7aabey nenee?» ga oychchadus.</para>
  <para style="q2" vid="2SA 20:17">Izikka izis zaaridi, «Ee tana» gides.</para>
  <para style="q1" vid="2SA 20:17">Izakka izas «Histtiko</para>
  <para style="q2" vid="2SA 20:17">tani oosanchchaya</para>
  <para style="q2" vid="2SA 20:17">gizayssa ezga» gadus.</para>
  <para style="q2" vid="2SA 20:17">Izi qasse, «Ero</para>
  <para style="q2" vid="2SA 20:17">ta ezga siyays» gides.<verse eid="2SA 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 20:18" />Izakka zaarada izas, «Beni wode asay, ‹Zore oychchanaas Aabeele katama biite!› gees; istti gida malakka polettees. <verse eid="2SA 20:18" /><verse number="19" style="v" sid="2SA 20:19" />He katamaya gita katama; Isra7eelen saroy kumidaaranne ammanettida katamaya izo; histtiin neni Isra7eelen aayo gididaaro dhayssana koyaasa. GODAA xinxxoyo mittanaas ays ne koyay?» gadus.<verse eid="2SA 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 20:20" />Iyo7aabeykka izis, «Hessi taappe haakko! Mitoynne dhaysi ha7ikka taappe haakko! <verse eid="2SA 20:20" /><verse number="21" style="v" sid="2SA 20:21" />Yo7oy hessa mala gidenna; heen zumazan Efreeme gezzefe Bikire naa Sheba7e geetettizayssi kawo Dawite bolla ba kushe denththides; intte he addeza xalla taas aaththi immiko tani hanno katamayo yedda baana» gides.</para>
  <para style="p" vid="2SA 20:21">Maccassayakka zaarada Iyo7aabes, «Addeza hu7e qanxxidi nees gimbe bollara kare yeggana» gadus.<verse eid="2SA 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 20:22" />Hessafe guye maccassaya cinccateththan kumida ba zore ubbaa deraakko ekka badus. Isttika Bikire naa Sheba7e hu7eza qanxxidi Iyo7aabes kare olida. Histtiin Iyo7aabey zaye punnides; asaykka katamayppe haakki bida. Ubbaa baggarakka laaletti baso baso bida. Iyo7aabey kawozaakko Yerusalaame simmi bides.<verse eid="2SA 20:22" /></para>
  <para style="s1">Dawite Shuumeta</para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 20:23" />Iyo7aabey Isra7eele olanchchata ubbaa bolla azazizaade gidides; Yoodahe naa Bannayay qasse Keliteta bollanne Peliteta bolla halaqa gidides. <verse eid="2SA 20:23" /><verse number="24" style="v" sid="2SA 20:24" />Adoraamey wolqqa ooso ooththizayta bolla halaqa gidides. Ahiluude naa Iyoosaafixey taarike xaafizaade gidides. <verse eid="2SA 20:24" /><verse number="25" style="v" sid="2SA 20:25" />Sheba7ey kawo keeththas xaafe gidishin Saadooqeynne Abiyaataarey qeese gidida. <verse eid="2SA 20:25" /><verse number="26" style="v" sid="2SA 20:26" />Hessaththoka Ya7ire dere as Iray Dawite zorizaade gidides.<verse eid="2SA 20:26" /></para>
  <chapter eid="2SA 20" />
  <chapter number="21" style="c" sid="2SA 21" />
  <para style="s1">Sa7oole Zereththata Qaxxayeteth</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 21:1" />Dawite kawoteththa wode heedzdzu layth kumeth iita koshay biitta bolla dendides; hessa gishshas Dawiti GODAA oychchides; GODAYKKA izas, «Sa7ooli Geba7oone asaa wodhi wursida gishshas iza bollanne izaso asaa bolla suuththa acoy dees» gides. <verse eid="2SA 21:1" /><verse number="2" style="v" sid="2SA 21:2" />Kawozi Geba7oone asaa xeygi haasayssides; Geba7ooneti Amooretappe attidayta attiin Isra7eele dere as gidettenna; Isra7eele asay kase istti naaganaas caaqqidaa gidikkoka Sa7ooli Isra7eele asaassinne Yuhuda asaas mishettiza gishshas Geba7ooneta mulera dhayssanaas koyides.<note caller="-" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="JOS 9:3-15">Iya 9:3-15</ref></char></note> <verse eid="2SA 21:2" /><verse number="3" style="v" sid="2SA 21:3" />Hessa gishshas Dawiti Geba7oone asaa, «Ta inttes ay ooththoo? GODAA xinxxo intte anjjana mala nagara ubbaas ta ay ooththana bessizee?» gi oychchides.<verse eid="2SA 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 21:4" />Geba7oone asay izas zaaridi, «Sa7ooleppe gidiin izaso asaappe bira woykko worqqa oychchanaas maatay deenna; qasseka nuni Isra7eeleppe oonakka wodhanaas maatay deenna» gida.</para>
  <para style="p" vid="2SA 21:4">Dawitikka, «Histtiin ta inttes ay ooththoo?» gi oychchides.<verse eid="2SA 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 21:5" />Isttika, «Nuni laalettana malanne Isra7eele giddon awankka dontta mala nu bolla gene ooththidi nuna dhayssidaade <verse eid="2SA 21:5" /><verse number="6" style="v" sid="2SA 21:6" />zereththafe laappun attuma nayti nuus imettetto. Nunikka GODAAN doorettida Sa7oole dere Gibi7an GODAA sinththan istta kaqqana» gi zaarida. Histtiin kawozi, «Ero ta immana» gides.<verse eid="2SA 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 21:7" />Kawo Dawiti Sa7oole naa Yoonataane giddoninne ba giddon GODAA sinththan caaqettida caaqo gishshas giidi Sa7oole naaza Yoonataane naa Memfeboste hayqoppe ashshides.<note caller="-" style="x"><char style="xo" closed="false">21:7 </char><char style="xt" closed="false"><ref loc="1SA 20:15-17">1Same 20:15-17</ref>; <ref loc="2SA 9:1-7">2Same 9:1-7</ref></char></note> <verse eid="2SA 21:7" /><verse number="8" style="v" sid="2SA 21:8" />Gido attiin kawozi Aaya biyo Erxifay Sa7ooles yelida 2 attuma nayta Armoonenne Memfeboste, isttarakka issi bolla Sa7oole biya Merooba Maholaate dere as Barzile naa Adir7eeles yelida 5 attuma nayta ekki bides.<note caller="-" style="x"><char style="xo" closed="false">21:8 </char><char style="xt" closed="false"><ref loc="1SA 18:19">1Same 18:19</ref></char></note> <verse eid="2SA 21:8" /><verse number="9" style="v" sid="2SA 21:9" />Istta Geba7oone asatas aaththi immides; Geba7ooneti istta wodhidi zumbullata bolla GODAA sinththan kaqqida; laappunati issi bolla hayqqida; istti hayqqiday kaththa shiisho wode koyro gallas, banggay maxa doomettida gallassa.<verse eid="2SA 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 21:10" />Hessafe guye Aaya biyo Erxifay maaqa ekkada zaalla bolla dunkaanadus; kaththa shiisho koyro gallassafe biidi iray bukkanaashe gakkanaas, gallas salo kafoti bochchontta mala, omars wora do7ati bochchontta mala naagashe heen gam7adus. <verse eid="2SA 21:10" /><verse number="11" style="v" sid="2SA 21:11" />Sa7oole laggeththoya Aaya biyo Erxifay ooththidayssa Dawiti siyida wode, <verse eid="2SA 21:11" /><verse number="12" style="v" sid="2SA 21:12" />biidi Sa7oole meqeththaanne iza naa Yoonataane meqeththaa Yaabuse Gala7aade asaappe ekkides. Yaabuse asay, istti kaqqidasoppe Beeti-Saane dubbushappe qotara ekki bida.<note caller="-" style="x"><char style="xo" closed="false">21:12 </char><char style="xt" closed="false"><ref loc="1SA 31:8-13">1Same 31:8-13</ref></char></note> <verse eid="2SA 21:12" /><verse number="13" style="v" sid="2SA 21:13" />Dawiti Sa7oole meqeththinne iza naa Yoonataane meqeth heeppe ehides. Hessaththoka he hayqqida asata meqeth shiishshida.<verse eid="2SA 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 21:14" />Sa7oole meqeththinne iza naa Yoonataane meqeth Biniyaame biittan Xela geetettizason iza aawa Qiise duufon moogida; kawozi azazidayssaka ubbaa ooththida. Hessafe guye biittays istti woossida woosaa Xoossi siyides.<verse eid="2SA 21:14" /></para>
  <para style="s1">Filisxeeme Bolla Dendida Ola</para>
  <para style="r">(<ref loc="1CH 20:4-8">1Taari 20:4-8</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 21:15" />Qasseka Filisxeemessinne Isra7eeles giddon olay dendides; Dawitikka ba asaara Filisxeeme asaa olanaas duge wodhdhides; izi heen daaburdes. <verse eid="2SA 21:15" /><verse number="16" style="v" sid="2SA 21:16" />Erafaye zereththatappe issoy Eshbi-Benoobe geetettiza asi dees; izi Xarqimalappe oosettida 300 saqile deexxiza tooranne ooraththa mashsha gixxi uttides; izikka Dawite wodhana qoppides. <verse eid="2SA 21:16" /><verse number="17" style="v" sid="2SA 21:17" />Gido attiin Xuriya naa Abisayey Dawite shemppo ashshanaas yiidi Filisxeeme addeza caddi wodhides. Hessafe guye Dawite asati, «Isra7eele xomppey to7ontta mala hayssafe guye ne nunara olaso kezana bessenna» gi caaqqida.<note caller="-" style="x"><char style="xo" closed="false">21:17 </char><char style="xt" closed="false"><ref loc="1KI 11:36">1Kawo 11:36</ref>; <ref loc="PSA 132:17">Maza 132:17</ref></char></note><verse eid="2SA 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 21:18" />Hessafe guye Gobbe geetettizason Filisxeeme asaara olay dendides. He wode Huushe dere as Sibikayey Erafaye zereththatappe Saafe wodhides.<verse eid="2SA 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 21:19" />Gobben Filisxeemetara dendida hara olan Beeteliheeme dere as Jaar-Orgime naa Elyaaney izas toora toomay wondiraashe mith likkizayssa Geete dere as Golyaade wodhides. <verse eid="2SA 21:19" /><verse number="20" style="v" sid="2SA 21:20" />Qasseka Geeten dendida olan izas issi issi kushe bollanne issi issi toho bolla usuppun biradhdhey, issi bolla nam7u tammanne oyddu biradhdheti diza issi wolqqama asi dees; izi Erafaye zereththa. <verse eid="2SA 21:20" /><verse number="21" style="v" sid="2SA 21:21" />Izi Isra7eele asaara eqettishin Dawite isha Shim7e naa Yoonataaney iza wodhides.<verse eid="2SA 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 21:22" />Hayti oyddati Geeten diza Erafaye zereththata; isttika Dawite kusheninne iza asata kushen kundida.<verse eid="2SA 21:22" /></para>
  <chapter eid="2SA 21" />
  <chapter number="22" style="c" sid="2SA 22" />
  <para style="s1">Dawiti Yexxida Galata Mazamure</para>
  <para style="r">(<ref loc="PSA 18">Maza 18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 22:1" />GODAY Dawite iza morkketa ubbaa kusheppenne Sa7oole kusheppe ashshida wode Dawiti hayssafe kaalliza mazamure GODAA bonchchos yexxides;<verse eid="2SA 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="2SA 22:2" />«GODAY taas zaalla,</para>
  <para style="q2" vid="2SA 22:2">taas miixanne tana ashshizaade.<verse eid="2SA 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="2SA 22:3" />Ta Xoossay ta geemettiza zaalla,</para>
  <para style="q2" vid="2SA 22:3">taas gondallenne atoteththa kace;</para>
  <para style="q2" vid="2SA 22:3">izi taas mino miixa;</para>
  <para style="q2" vid="2SA 22:3">taas zempponne</para>
  <para style="q2" vid="2SA 22:3">tana ashshizaade;</para>
  <para style="q2" vid="2SA 22:3">ne tana makkallanchchatappe</para>
  <para style="q2" vid="2SA 22:3">ashshaasa.<verse eid="2SA 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="2SA 22:4" />Galatay bessiza GODAA ta xeygays;</para>
  <para style="q2" vid="2SA 22:4">tani ta morkketappekka attays.<verse eid="2SA 22:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="2SA 22:5" />«Hayqo dambalay</para>
  <para style="q2" vid="2SA 22:5">tana giddoththides;</para>
  <para style="q2" vid="2SA 22:5">dhayssiza di7oy tana mittides.<verse eid="2SA 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="2SA 22:6" />Si7oole wodoroy</para>
  <para style="q2" vid="2SA 22:6">ta bolla xaaxettides;</para>
  <para style="q2" vid="2SA 22:6">hayqo woximadey</para>
  <para style="q2" vid="2SA 22:6">taas waaxettides.<verse eid="2SA 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="2SA 22:7" />Ta ceecida wode GODAA xeygadis;</para>
  <para style="q2" vid="2SA 22:7">ta Xoossaako waassadis.</para>
  <para style="q2" vid="2SA 22:7">Izi ba Keeththan dishe</para>
  <para style="q2" vid="2SA 22:7">ta cenggurssaa siyides;</para>
  <para style="q2" vid="2SA 22:7">ta waasoy iza hayththan gelides.<verse eid="2SA 22:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="2SA 22:8" />«Izi hanqettida gishshas biittaya</para>
  <para style="q2" vid="2SA 22:8">kokkoradussinne shirotadus;</para>
  <para style="q2" vid="2SA 22:8">salota yochchi</para>
  <para style="q2" vid="2SA 22:8">za7idessinne qaaxxides.<verse eid="2SA 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="2SA 22:9" />Iza siidheppe hanqo</para>
  <para style="q2" vid="2SA 22:9">cuway cuwattides;</para>
  <para style="q2" vid="2SA 22:9">iza doonappe xuuggiza</para>
  <para style="q2" vid="2SA 22:9">tamay eexxides;</para>
  <para style="q2" vid="2SA 22:9">tama bonqoyka kezides.<verse eid="2SA 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="2SA 22:10" />Salota daakki wodhdhides;</para>
  <para style="q2" vid="2SA 22:10">iza toho garsan dhippi gida</para>
  <para style="q2" vid="2SA 22:10">shaaray dees.<verse eid="2SA 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="2SA 22:11" />Izi kirube bolla uttidi piradhdhides;</para>
  <para style="q2" vid="2SA 22:11">carko qefe bolla uttidi</para>
  <para style="q2" vid="2SA 22:11">pude paallides.<verse eid="2SA 22:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2SA 22:12" />Dhumay iza giddoththides;</para>
  <para style="q2" vid="2SA 22:12">dhippi gida ira shaaray</para>
  <para style="q2" vid="2SA 22:12">iza genththides.<verse eid="2SA 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2SA 22:13" />Iza sinththan diza poo7ozappe</para>
  <para style="q2" vid="2SA 22:13">wawaci giza wolqqanththi kezides.<verse eid="2SA 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="2SA 22:14" />GODAY salotappe guummides;</para>
  <para style="q2" vid="2SA 22:14">Ubbaafe Dhoqqa Xoossaa</para>
  <para style="q2" vid="2SA 22:14">cenggurs sissides.<verse eid="2SA 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="2SA 22:15" />Ba yiishshaa dukkidi</para>
  <para style="q2" vid="2SA 22:15">ba morkketa laallides;</para>
  <para style="q2" vid="2SA 22:15">wolqqanth yeddidi istta shirosides.<verse eid="2SA 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="2SA 22:16" />GODAA seerappenne</para>
  <para style="q2" vid="2SA 22:16">iza siidheppe keziza hanqo</para>
  <para style="q2" vid="2SA 22:16">cuwaappe dendidayssan,</para>
  <para style="q2" vid="2SA 22:16">abba giddon diza zulleti beettida;</para>
  <para style="q2" vid="2SA 22:16">sa7a yochchati qonccida.<verse eid="2SA 22:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="2SA 22:17" />«Bollafe ba kushe yeddidi</para>
  <para style="q2" vid="2SA 22:17">tana oykkides;</para>
  <para style="q2" vid="2SA 22:17">ciimma haaththata giddofekka</para>
  <para style="q2" vid="2SA 22:17">tana kessides.<verse eid="2SA 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="2SA 22:18" />Mino morkketappe,</para>
  <para style="q2" vid="2SA 22:18">tani isttara eqettana</para>
  <para style="q2" vid="2SA 22:18">dandayontta baaligaaratappe</para>
  <para style="q2" vid="2SA 22:18">tana ashshides.<verse eid="2SA 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="2SA 22:19" />Ta metotida gallas ta bolla yida;</para>
  <para style="q2" vid="2SA 22:19">gido attiin GODAY tana kaafides.<verse eid="2SA 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="2SA 22:20" />Izi tana aakoso kessides;</para>
  <para style="q2" vid="2SA 22:20">tanan ufayettida gishshas</para>
  <para style="q2" vid="2SA 22:20">izi ashshides.<verse eid="2SA 22:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="2SA 22:21" />«GODAY taas</para>
  <para style="q2" vid="2SA 22:21">ta xilloteththa mala ooththees;</para>
  <para style="q2" vid="2SA 22:21">ta xilloteththa mala</para>
  <para style="q2" vid="2SA 22:21">taas kushe zaarides.<verse eid="2SA 22:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="2SA 22:22" />GODAA oge ta naagida gishshas</para>
  <para style="q2" vid="2SA 22:22">tani Xoossafe sher7i gaada iita ooththabeekke.<verse eid="2SA 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="2SA 22:23" />Iza woga ubbay ta sinththan dees;</para>
  <para style="q2" vid="2SA 22:23">iza maarappeka</para>
  <para style="q2" vid="2SA 22:23">haraso simmabeekke.<verse eid="2SA 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="2SA 22:24" />Iza sinththan borey baynda de7adis;</para>
  <para style="q2" vid="2SA 22:24">tanakka nagarappe naagadis.<verse eid="2SA 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="2SA 22:25" />GODAY ta xilloteththa mala,</para>
  <para style="q2" vid="2SA 22:25">iza sinththan diza</para>
  <para style="q2" vid="2SA 22:25">geeshshateththaa mala</para>
  <para style="q2" vid="2SA 22:25">taas kushe zaarides.<verse eid="2SA 22:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="2SA 22:26" />«Ammanettidaytas</para>
  <para style="q2" vid="2SA 22:26">nekka ammanettidayssa,</para>
  <para style="q2" vid="2SA 22:26">suuretas neni suure</para>
  <para style="q2" vid="2SA 22:26">gididayssa bessaasa.<verse eid="2SA 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="2SA 22:27" />Geeshshatas neni geesh gididayssa,</para>
  <para style="q2" vid="2SA 22:27">makkalla asas neni makkalla</para>
  <para style="q2" vid="2SA 22:27">gididayssa bessaasa.<verse eid="2SA 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="2SA 22:28" />Neni qohettida deraa ashshaasa;</para>
  <para style="q2" vid="2SA 22:28">gido attiin ne ayfey</para>
  <para style="q2" vid="2SA 22:28">kawushshanaas</para>
  <para style="q2" vid="2SA 22:28">otoranchchata xeellees.<verse eid="2SA 22:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="2SA 22:29" />Abeet GODAWU!</para>
  <para style="q2" vid="2SA 22:29">Neni taas xomppe;</para>
  <para style="q2" vid="2SA 22:29">GODAY ta dhumaa poo7isees.<verse eid="2SA 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="2SA 22:30" />Ne maadon morkketa ola</para>
  <para style="q2" vid="2SA 22:30">sinth suga suga baana;</para>
  <para style="q2" vid="2SA 22:30">tani ta Xoossaa wolqqan</para>
  <para style="q2" vid="2SA 22:30">gimbeza bollara xaallays.<verse eid="2SA 22:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="2SA 22:31" />«Xoossa ogey kumeththa;</para>
  <para style="q2" vid="2SA 22:31">GODAA qaalay muuruta;</para>
  <para style="q2" vid="2SA 22:31">izan ammanettidayta ubbaas</para>
  <para style="q2" vid="2SA 22:31">izi gondalle.<verse eid="2SA 22:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="2SA 22:32" />GODAAPPE attiin</para>
  <para style="q2" vid="2SA 22:32">hara Xoossi oonee?</para>
  <para style="q2" vid="2SA 22:32">nu Xoossaafe attiin</para>
  <para style="q2" vid="2SA 22:32">zaallay oonee?<verse eid="2SA 22:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="2SA 22:33" />Taas wolqqa immizayssi,</para>
  <para style="q2" vid="2SA 22:33">ta ogekka suurisizayssi</para>
  <para style="q2" vid="2SA 22:33">izi ta Xoossa.<verse eid="2SA 22:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="2SA 22:34" />Ta tohota genessa</para>
  <para style="q2" vid="2SA 22:34">toho mala pilatisees;</para>
  <para style="q2" vid="2SA 22:34">dhoqqasohotan</para>
  <para style="q2" vid="2SA 22:34">tana minththi essees.<note caller="-" style="x"><char style="xo" closed="false">22:34 </char><char style="xt" closed="false"><ref loc="HAB 3:19">Im 3:19</ref></char></note><verse eid="2SA 22:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="2SA 22:35" />Ta kusheta ola</para>
  <para style="q2" vid="2SA 22:35">tamaarssees;</para>
  <para style="q2" vid="2SA 22:35">ta qeseti xarqimala</para>
  <para style="q2" vid="2SA 22:35">wondafe zinqqeettes.<verse eid="2SA 22:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="2SA 22:36" />Ne atoteththa gondalle</para>
  <para style="q2" vid="2SA 22:36">taas immadasa;</para>
  <para style="q2" vid="2SA 22:36">ne kaafoy tana gitasides.<verse eid="2SA 22:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="2SA 22:37" />Ta tanggo aassadasa;</para>
  <para style="q2" vid="2SA 22:37">ta tohotikka dhuphettibeettenna.<verse eid="2SA 22:37" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="38" style="v" sid="2SA 22:38" />«Ta morkketa yedeththa dhayssadis;</para>
  <para style="q2" vid="2SA 22:38">istti dippi gaanaashe gakkanaas</para>
  <para style="q2" vid="2SA 22:38">guye gabeekke.<verse eid="2SA 22:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="2SA 22:39" />Mulera ta istta dhayssadis;</para>
  <para style="q2" vid="2SA 22:39">simmidikka eqqanaas</para>
  <para style="q2" vid="2SA 22:39">dandaybeettenna;</para>
  <para style="q2" vid="2SA 22:39">ta toho garsankka kundida.<verse eid="2SA 22:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="2SA 22:40" />Olas taas wolqqa immadasa;</para>
  <para style="q2" vid="2SA 22:40">tanara eqettizayta ta toho</para>
  <para style="q2" vid="2SA 22:40">garsan ne gulbatissadasa.<verse eid="2SA 22:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="2SA 22:41" />Ta morkketi guye simmi</para>
  <para style="q2" vid="2SA 22:41">baqatana mala ooththadasa;</para>
  <para style="q2" vid="2SA 22:41">tana ixxizayta dhayssadasa.<verse eid="2SA 22:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="2SA 22:42" />Istti maado demmanaas waassida;</para>
  <para style="q2" vid="2SA 22:42">gido attiin istta</para>
  <para style="q2" vid="2SA 22:42">maaddiday deenna;</para>
  <para style="q2" vid="2SA 22:42">istti GODAAKKO waassida;</para>
  <para style="q2" vid="2SA 22:42">gido attiin izi isttas zaaribeenna.<verse eid="2SA 22:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="2SA 22:43" />Gudulla mala istta liiqisa gaaccadis;</para>
  <para style="q2" vid="2SA 22:43">ogen diza urqqa mala</para>
  <para style="q2" vid="2SA 22:43">istta gindadissinne yedhettadis.<verse eid="2SA 22:43" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="44" style="v" sid="2SA 22:44" />«Ta derey qoppida daafaappe</para>
  <para style="q2" vid="2SA 22:44">tana ashshadasa;</para>
  <para style="q2" vid="2SA 22:44">kawoteththatas</para>
  <para style="q2" vid="2SA 22:44">tana hu7e histtadasa.</para>
  <para style="q2" vid="2SA 22:44">Ta erontta asay taas haarettides.<verse eid="2SA 22:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="2SA 22:45" />Allagati tana shoobbanaas yida;</para>
  <para style="q2" vid="2SA 22:45">istti tana siyida mala</para>
  <para style="q2" vid="2SA 22:45">taas azazetteettes.<verse eid="2SA 22:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="2SA 22:46" />Allagati babbida;</para>
  <para style="q2" vid="2SA 22:46">bantta miixappe kokkorishe yida.<verse eid="2SA 22:46" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="47" style="v" sid="2SA 22:47" />«GODAY de7o Xoossa;</para>
  <para style="q2" vid="2SA 22:47">ta zaallay izi anjjetto;</para>
  <para style="q2" vid="2SA 22:47">ta atoteththa zaallay</para>
  <para style="q2" vid="2SA 22:47">ta Xoossay dhoqqu dhoqqu go.<verse eid="2SA 22:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="2SA 22:48" />Ta gishshas halo kessiza Xoossay,</para>
  <para style="q2" vid="2SA 22:48">kawoteththata taas haarisizay iza.<verse eid="2SA 22:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="2SA 22:49" />Izi ta morkketa kusheppe</para>
  <para style="q2" vid="2SA 22:49">tana kessees;</para>
  <para style="q2" vid="2SA 22:49">ta morkketappe tana</para>
  <para style="q2" vid="2SA 22:49">dhoqqu dhoqqu histtadasa;</para>
  <para style="q2" vid="2SA 22:49">menxe iitatappe</para>
  <para style="q2" vid="2SA 22:49">tana ashshadasa.<verse eid="2SA 22:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="2SA 22:50" />Abeet ta GODAWU!</para>
  <para style="q2" vid="2SA 22:50">Kawoteththata giddon</para>
  <para style="q2" vid="2SA 22:50">ta nena galatana;</para>
  <para style="q2" vid="2SA 22:50">ne sunththaas galata mazamure</para>
  <para style="q2" vid="2SA 22:50">ta yexxana.<note caller="-" style="x"><char style="xo" closed="false">22:50 </char><char style="xt" closed="false"><ref loc="ROM 15:9">Oro 15:9</ref></char></note><verse eid="2SA 22:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="2SA 22:51" />Izi kawozas gita xoono immees;</para>
  <para style="q2" vid="2SA 22:51">ba tiyda Dawitesinne</para>
  <para style="q2" vid="2SA 22:51">iza zereththas,</para>
  <para style="q2" vid="2SA 22:51">ba mernaa kiyateth bessees.»<verse eid="2SA 22:51" /></para>
  <chapter eid="2SA 22" />
  <chapter number="23" style="c" sid="2SA 23" />
  <para style="s1">Dawiti Wurseththan Yootida Qaala</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 23:1" />Dawiti wurseththan haasayda qaalay hayssafe kaallizayssa;</para>
  <para style="q1" vid="2SA 23:1">«Yaaqoobe Xoossaan tiyettidayssi,</para>
  <para style="q2" vid="2SA 23:1">Ubbaafe Dhoqqa Xoossay</para>
  <para style="q2" vid="2SA 23:1">dhoqqu dhoqqu histtida asi,</para>
  <para style="q2" vid="2SA 23:1">Isra7eelen dosettida yeththanchchay,</para>
  <para style="q2" vid="2SA 23:1">Isseye naa Dawite tinbite</para>
  <para style="q2" vid="2SA 23:1">qaalay hayssa;<verse eid="2SA 23:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="2SA 23:2" />«GODAA Ayanay</para>
  <para style="q2" vid="2SA 23:2">ta baggara haasaydes;</para>
  <para style="q2" vid="2SA 23:2">iza qaalay ta doonan dees.<verse eid="2SA 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="2SA 23:3" />Isra7eele Xoossi haasaydes;</para>
  <para style="q2" vid="2SA 23:3">Isra7eele zaallay taas,</para>
  <para style="q2" vid="2SA 23:3">‹Asaa xilloteththan haarizay,</para>
  <para style="q2" vid="2SA 23:3">Xoossa yashshateththan ayssizay,<verse eid="2SA 23:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="2SA 23:4" />izi shaaray bayndason,</para>
  <para style="q2" vid="2SA 23:4">maalado xalqqey keziza</para>
  <para style="q2" vid="2SA 23:4">wode diza poo7o mala;</para>
  <para style="q2" vid="2SA 23:4">izi biitta bolla maata</para>
  <para style="q2" vid="2SA 23:4">purccisiza xalqqe mala,</para>
  <para style="q2" vid="2SA 23:4">iray bukki aadhdhishin</para>
  <para style="q2" vid="2SA 23:4">ke7iza awa mala› gides.<verse eid="2SA 23:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="2SA 23:5" />«Ta keeththi Xoossa matan</para>
  <para style="q2" vid="2SA 23:5">likke gidennee?</para>
  <para style="q2" vid="2SA 23:5">Ubba miish giigsidinne naagidi,</para>
  <para style="q2" vid="2SA 23:5">tanara mernaa caaqo qaala</para>
  <para style="q2" vid="2SA 23:5">geliday iza gidennee?</para>
  <para style="q1" vid="2SA 23:5">Ta atoteththa polo gaththanay</para>
  <para style="q2" vid="2SA 23:5">ta amo ubbaa taas immanay</para>
  <para style="q2" vid="2SA 23:5">iza gidennee?<verse eid="2SA 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="2SA 23:6" />Gido attiin iita asati ubbay,</para>
  <para style="q2" vid="2SA 23:6">kushen shiishshana dandayettontta</para>
  <para style="q2" vid="2SA 23:6">agunththa mala</para>
  <para style="q2" vid="2SA 23:6">wora wodhdhana.<verse eid="2SA 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="2SA 23:7" />Agunth bochchiza ubbaas,</para>
  <para style="q2" vid="2SA 23:7">birata woykko</para>
  <para style="q2" vid="2SA 23:7">toora tooma koshshees;</para>
  <para style="q2" vid="2SA 23:7">istti ba dizason mulera</para>
  <para style="q2" vid="2SA 23:7">taman xuugettana.»<verse eid="2SA 23:7" /></para>
  <para style="s1">Erettida Qara Asata</para>
  <para style="r">(<ref loc="1CH 11:10-41">1Taari 11:10-41</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 23:8" />Dawites erettida qara asata sunththi hayssafe kaallizayssa; koyroyssi Tahikimoone dere as Yoshebi-Baashebete gidishin izi heedzdzu halaqatas halaqa; izikka issi olan ba toora xongidi 800 as wodhida qara.<verse eid="2SA 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 23:9" />Nam7anththozi Ahihohe dere as Doode naa El7ezeere; olettanaas issi bolla shiiqida Filisxeeme asay eqettiza wode Isra7eele asay baqatides; Dawitera diza heedzdzu qarata garsafe issoy iza. <verse eid="2SA 23:9" /><verse number="10" style="v" sid="2SA 23:10" />Izi gidikko ba eqqidaso yeddibeenna; iza kushey argacanaashenne mashshara issife oykettanaashe gakkanaas Filisxeemeta olides; he gallas GODAY izas gita xoono immides. Baqati bida olanchchati hayqqida asaappe ola miishshinne may7o xalla qaaratanaas Ele7eezerekko guye simmida.<verse eid="2SA 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 23:11" />Heedzdzanththozi Harare dere as Aage naa Shaama; Filisxeemeti Leehan kumeth misiray zerettida gaden istti issi bolla shiiqi dishin Isra7eele olanchchati Filisxeemeta sinththafe baqatida. <verse eid="2SA 23:11" /><verse number="12" style="v" sid="2SA 23:12" />Shaamay gidikko ba eqqidaso yeddibeenna; he olaa eqettidi Filisxeemeta wodhides; he gallas GODAY gita xoono immides.<verse eid="2SA 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 23:13" />Kaththa shiisho wode Filisxeeme olanchchati Erafayme zullen dunkaani uttidaashe heedzdzu tammu halaqatappe heedzdzati Dawiti dizaso Adulaame gongolo yida. <verse eid="2SA 23:13" /><verse number="14" style="v" sid="2SA 23:14" />He wode Dawiti miixa giddon dees; Filisxeeme olanchchati Beeteliheemen deettes. <verse eid="2SA 23:14" /><verse number="15" style="v" sid="2SA 23:15" />Dawiti laamotidi, «Beeteliheeme penge achchan diza olla haaththaafe taas oonee ehanay!» gides. <verse eid="2SA 23:15" /><verse number="16" style="v" sid="2SA 23:16" />Hessa gishshas erettida ola qara heedzdzati Filisxeeme olanchchata giddora kanththi biidi Beeteliheeme penge achchan diza haaththa ollafe duuqqi Dawites ehida; izi gidikko GODAA sinththan yarsho histti gussides attiin uyibeenna. <verse eid="2SA 23:16" /><verse number="17" style="v" sid="2SA 23:17" />«Abeet GODAWU! Hayssa mala ooso ta wostta ooththoo? Hayssi taappe haakko! Hayssi bantta shemppo bolla pirdida asata suuth deennee?» giidi Dawiti uyana koyibeenna; hekko erettida heedzdzu ola qarati ooththida goobateththa oosoy hessa.<verse eid="2SA 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 23:18" />Xuriya naa Iyo7aabe ishaa Abisayey heedzdzu erettida ola qaratas halaqa; heedzdzu xeetu asaa bolla ba toora xongidi wodhidanne ha heedzdzu qarata mala erettida gooba asa. <verse eid="2SA 23:18" /><verse number="19" style="v" sid="2SA 23:19" />Abisayey heedzdzatappe bollara keehi erettida as gidennee? Izi isttafe gidontta aggikokka izi isttas halaqa.<verse eid="2SA 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 23:20" />Hara erettida qaray Qabxi7eele dere as Yoodahe naa Bannayay gita erettida ooso ooththides. Izikka nam7u erettida Mo7aabe asata wodhides; qasseka shachchi bukkida gallas olla giddo gelidi gaammo wodhides. <verse eid="2SA 23:20" /><verse number="21" style="v" sid="2SA 23:21" />Hessaththoka issi gita Gibxe as wodhides; he Gibxe addezi ba kushen toora oykkides; gido attiin Bannayay izara olettanaas guufe oykkidi izakko bides; Gibxe addeza kusheppe iza toora woththi ekkidi iza tooran iza wodhides.<verse eid="2SA 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 23:22" />Yoodahe naa Bannaya goobateththi hessa; izikka erettida heedzdzu qara asata mala erettida gooba asa. <verse eid="2SA 23:22" /><verse number="23" style="v" sid="2SA 23:23" />Izi he heedzdzu tammu asatappe aadhdhi bonchchettidaade; gido attiin erettida heedzdzu qara asata mala sabettenna. Dawiti Bannaya ba bonchcho zabeta bolla shuumides.<verse eid="2SA 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 23:24" />He heedzdzu tammatappe baggayta sunththi hayssafe kaallizayssa.</para>
  <para style="q1" vid="2SA 23:24">Iyo7aabe ishaa Asaheele,</para>
  <para style="q1" vid="2SA 23:24">Beeteliheeme dere as Doode</para>
  <para style="q2" vid="2SA 23:24">naa Elyaane,<verse eid="2SA 23:24" /></para>
  <para style="q2">
    <verse number="25" style="v" sid="2SA 23:25" />Harare dere as Shammaha,</para>
  <para style="q1" vid="2SA 23:25">Harare dere as Eliqa,<verse eid="2SA 23:25" /></para>
  <para style="q2">
    <verse number="26" style="v" sid="2SA 23:26" />Palixe dere as Heleexe,</para>
  <para style="q1" vid="2SA 23:26">Tequhe dere as Iqesha</para>
  <para style="q2" vid="2SA 23:26">naa Ira,<verse eid="2SA 23:26" /></para>
  <para style="q2">
    <verse number="27" style="v" sid="2SA 23:27" />Anatoote dere as Abi7eezere,</para>
  <para style="q1" vid="2SA 23:27">Huushe dere as Mebunaye,<verse eid="2SA 23:27" /></para>
  <para style="q2">
    <verse number="28" style="v" sid="2SA 23:28" />Ahihohe dere as Xalmoone,</para>
  <para style="q1" vid="2SA 23:28">Naxoofe dere as Mahiraye,<verse eid="2SA 23:28" /></para>
  <para style="q2">
    <verse number="29" style="v" sid="2SA 23:29" />Naxoofe dere as Ba7aana</para>
  <para style="q2" vid="2SA 23:29">naa Helebe,</para>
  <para style="q1" vid="2SA 23:29">Biniyaame baggafe Gibi7a dere as</para>
  <para style="q2" vid="2SA 23:29">Eribaye naa Ittaye,<verse eid="2SA 23:29" /></para>
  <para style="q2">
    <verse number="30" style="v" sid="2SA 23:30" />Piraatoone dere as Bannaya,</para>
  <para style="q1" vid="2SA 23:30">Ga7aashe zulle as Hidaaye,<verse eid="2SA 23:30" /></para>
  <para style="q2">
    <verse number="31" style="v" sid="2SA 23:31" />Arabe dere as Abi-Elboone,</para>
  <para style="q1" vid="2SA 23:31">Barhume dere as Azimoote,<verse eid="2SA 23:31" /></para>
  <para style="q2">
    <verse number="32" style="v" sid="2SA 23:32" />Shaalboone dere as Eliyaahibe,</para>
  <para style="q1" vid="2SA 23:32">Yashene nayta,</para>
  <para style="q2" vid="2SA 23:32">Yoonataane,<verse eid="2SA 23:32" /></para>
  <para style="q2">
    <verse number="33" style="v" sid="2SA 23:33" />Harare dere as Shammaha naa,</para>
  <para style="q1" vid="2SA 23:33">Harare dere as</para>
  <para style="q2" vid="2SA 23:33">Sharare naa Ahi7aame,<verse eid="2SA 23:33" /></para>
  <para style="q2">
    <verse number="34" style="v" sid="2SA 23:34" />Ma7ikate dere as</para>
  <para style="q2" vid="2SA 23:34">Ahasiba naa Elfaleexe,</para>
  <para style="q1" vid="2SA 23:34">Gilo dere as</para>
  <para style="q2" vid="2SA 23:34">Akxofeele naa El7aame,<verse eid="2SA 23:34" /></para>
  <para style="q2">
    <verse number="35" style="v" sid="2SA 23:35" />Qarmeloose dere as Hexiro,</para>
  <para style="q1" vid="2SA 23:35">Arabe dere as Paaraye,<verse eid="2SA 23:35" /></para>
  <para style="q2">
    <verse number="36" style="v" sid="2SA 23:36" />Xoobba dere as</para>
  <para style="q2" vid="2SA 23:36">Naataane naa Yigi7aale,</para>
  <para style="q1" vid="2SA 23:36">Gaade dere as Baane,<verse eid="2SA 23:36" /></para>
  <para style="q2">
    <verse number="37" style="v" sid="2SA 23:37" />Amoone dere as Zallaqa,</para>
  <para style="q1" vid="2SA 23:37">Xuriya naa Iyo7aabes</para>
  <para style="q2" vid="2SA 23:37">gondalle oykkiza Bi7eroote</para>
  <para style="q2" vid="2SA 23:37">dere as Nahiraye,<verse eid="2SA 23:37" /></para>
  <para style="q2">
    <verse number="38" style="v" sid="2SA 23:38" />Yatire dere as Ira,</para>
  <para style="q2" vid="2SA 23:38">Yatire dere as Gaareebe,<verse eid="2SA 23:38" /></para>
  <para style="q2">
    <verse number="39" style="v" sid="2SA 23:39" />Hessaththoka Hiite</para>
  <para style="q2" vid="2SA 23:39">dere as Ooriyo,</para>
  <para style="q2" vid="2SA 23:39">istti issi bolla heedzdzu</para>
  <para style="q2" vid="2SA 23:39">tammanne laappuna.<verse eid="2SA 23:39" /></para>
  <chapter eid="2SA 23" />
  <chapter number="24" style="c" sid="2SA 24" />
  <para style="s1">Dawiti Ola Asaa Qoodida Qoodo</para>
  <para style="r">(<ref loc="1CH 21:1-27">1Taari 21:1-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 24:1" />Qasseka GODAY Isra7eele asaa bolla keehi hanqettides; istta bolla Dawite denththeththidi, «Ba! Isra7eele asaanne Yuhuda asaa qooda!» gides.<verse eid="2SA 24:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 24:2" />Hessa gishshas kawozi Iyo7aabenne izara diza ola asaa azazizayta, «Daaneppe biidi Bersaabehe gakkanaas diza Isra7eele qommota ubbatakko biite; istta qooday ay keena gididaakko nu erana mala ola asata mazgabite» gides.<verse eid="2SA 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 24:3" />Iyo7aabey kawozas, «GODAA ne Xoossay ola asaa xeetu kushe darso; ta godaa kawo ayfey hessa gakki beyo; gido attiin ta godaa kawoy hessaththo ooththanaas ays koyidee?» gides.<verse eid="2SA 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 24:4" />Gidikkoka kawoza qaalay Iyo7aabenne ola asaa azazizayta xoonida gishshas Isra7eele ola asaa mazgabanaas iza sinththafe kezi bida.<verse eid="2SA 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 24:5" />Istti Yordaanoose shaafa pinnidaappe guye shoobbaza giddon diza katamaappe dugeha baggara diza Aaro7eere matan dunkaanida; heeppeka Gaade baggara aadhdhi Iyaazeere bida. <verse eid="2SA 24:5" /><verse number="6" style="v" sid="2SA 24:6" />Heeppe Gala7aadenne Hiite deren diza Qaadeese asaakko bida; qasse Daani-Jaanera yuuyidi Sidoona bida. <verse eid="2SA 24:6" /><verse number="7" style="v" sid="2SA 24:7" />Qasse Xiroose miixa, Hiiweta katamatanne Kanaaneta katamata, wurseththan Yuhudappe dugeha baggara diza Bersaabehe bida.<verse eid="2SA 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 24:8" />Biittayo uddufun aginanne nam7u tammu gallas ubbaa yuuyi xeellidaappe guye Yerusalaame simmida.<verse eid="2SA 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 24:9" />Iyo7aabey ola asaa qooda ubbaa kawoza erisides; Isra7eelen 800,000 Yuhudan 500,000 mashsha shoddi olettana dandayzati beettida.<verse eid="2SA 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 24:10" />Dawiti olanchchata qoodidaappe guye ba wozinara modhettidi, «Ta gita nagara ooththadis; ha7ikka GODAWU! Tana ne aylleza ne maarana mala ta nena woossays; ha7ikka GODAWU tani ne aylley gita bala ooso ooththida gishshas maararkkii?» gides.<verse eid="2SA 24:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 24:11" />Wonteththa gallas Dawiti dendanaappe sinththan GODAA qaalay Dawites ajjuuta yootiza nabey Gaadekko yiidi, <verse eid="2SA 24:11" /><verse number="12" style="v" sid="2SA 24:12" />«Baada Dawites, ‹GODAY nena isttafe issiniyo doorana mala heedzdzu yo7ota shiishshadis; ta ne bolla ooththana mala issiniyo doora› gides» gaada yoota.<verse eid="2SA 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 24:13" />Gaadey Dawitekko biidi, «Ne biitta bolla heedzdzu layththa koshay yo gay? Woykko ne morkketi nena heedzdzu agina gakkanaas gooddiin baqatana koyay? Woykko ne biitta bolla heedzdzu gallas kumeth iita hargey yo gay? Hessa gishshas tana kiittidayssas ta ay zaaro immanaakko qoppa» gides.<verse eid="2SA 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 24:14" />Dawiti Gaades, «Tani keeha ceecadis; iza maaroteththay gita gidida gishshas GODAA kushen nu kundana attiin ta asa kushen kundike» gides. <verse eid="2SA 24:14" /><verse number="15" style="v" sid="2SA 24:15" />Hessa gishshas GODAY he gallassa maaladoppe doommidi ba barida gallas gakkanaas Isra7eele bolla iita harge yeddides; hessa gaason Daaneppe biidi Bersaabehe gakkanaas 70,000 asi wurides. <verse eid="2SA 24:15" /><verse number="16" style="v" sid="2SA 24:16" />GODAA kiitanchchay Yerusalaame dippi histtidi dhayssanaas ba kushe yeddiin asaa bolla gakkida qohoy GODAA qadheththides; histtiin dereza wursiza kiitanchchaza, «Gidana! Agga!» gides. He wode GODAA kiitanchchay Yaabuse dere as Orna bale achchan eqqi dees.<verse eid="2SA 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 24:17" />Dawiti dereza bolla bosha gaththiza kiitanchchaza be7idi GODAAS, «Nagara ooththiday tana, balettiday tana; hayti gidikko dorsata; istti ay mooridoo? Ne kushey ta bollanne ta keeththa bolla gido» gides.<verse eid="2SA 24:17" /></para>
  <para style="s1">Dawiti Giigsida Yarshizaso</para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 24:18" />He gallas Gaadey Dawitekko biidi, «Pude Yaabuse dere as Orna bale kezada GODAAS yarsho yarshanaaso giigsa» gides. <verse eid="2SA 24:18" /><verse number="19" style="v" sid="2SA 24:19" />Hessa gishshas Dawiti GODAY Gaade baggara izas azazida mala kezides. <verse eid="2SA 24:19" /><verse number="20" style="v" sid="2SA 24:20" />Ornay duge simmi xeellishin kawozinne iza derezi baakko yizayssa be7ides; izi kare kezidi izas biitta bolla hokki ziggides.<verse eid="2SA 24:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 24:21" />Ornaykka, «Kawoo! Ta godawu taakko intte ayllezakko ays yidetii?» gides.</para>
  <para style="p" vid="2SA 24:21">Dawiti zaaridi, «Deraa bolla yaana boshay simmana mala GODAAS yarsho yarshizaso giigsanaas ne baleza shammana yadis» gides.<verse eid="2SA 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 24:22" />Ornaykka Dawites, «Kawoy! Ta goday bana lo7idayssa ekkidi yarsho shiishsho; xuugettiza yarshos boorati deettes; eeso miththas kath bukkiza lodanne boora qambaray dees. <verse eid="2SA 24:22" /><verse number="23" style="v" sid="2SA 24:23" />Kawoo! Tani Ornay hayssa ubbaa kawos immays» gides; qasseka Ornay, «GODAA ne Xoossay neekko xeello» gides.<verse eid="2SA 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 24:24" />Kawozi gidikko Ornas, «Hessaththo hanoppo; waagaza ta nees qanxxana bessees. GODAA ta Xoossaas miishshe qanxxontta yarsho shiishshike» gides.</para>
  <para style="p" vid="2SA 24:24">Hessa gishshas Dawiti balezanne boorata 50 saqilen shammides. <verse eid="2SA 24:24" /><verse number="25" style="v" sid="2SA 24:25" />Heen Dawiti yarsho yarshizaso giigsides; xuugettiza yarshonne issifeteththa yarsho yarshides; hessafe guye GODAY biittay gishshas shiiqida woosaa siyides. Isra7eele bolla yida boshazi simmides.<verse eid="2SA 24:25" /></para>
  <chapter eid="2SA 24" />
</usx>