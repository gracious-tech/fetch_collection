<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GEN" style="id">- Gamo Full Bible final version</book>
  <para style="h">Medheteththa</para>
  <para style="toc1">Medheteththa Maxaafa</para>
  <para style="toc2">Medheteththa Maxaafa</para>
  <para style="toc3">Medhe</para>
  <para style="mt1">Medheteththa Maxaafa</para>
  <para style="imt1">Giddo Qofa</para>
  <para style="ip">Medheteththa Maxaafa geetettiza ha maxaafay salotinne sa7ay medhettida medheta gishshas, asa zereththi yida yuussa gishshas, nagaraynne waaye de7oy doomettida doomeththa gishshas, Xoossaranne asa zereththara diza gaytoteththa gishshas yootees. Medheteththa gishshas nam7u waanna waanna sohotan shaakettidi xeelettanaas dandayees.</para>
  <para style="ili">1. Shempo issinippe biidi tammanne issino gakkanaas diza sohoy salotinne sa7ay medhettida medheteththa gishshassinne asa zereththas koyro taarike yootees. Addaamenne Hewaani taarikey, Qayeelenne Aabeele taarikey, Nohenne dhayssa haaththa taarikey, hessaththoka Baabiloone Gimbe taarikey de7izayssi hayssana.</para>
  <para style="ili">2. Shempo tammanne nam7afe biidi ichchash tammu gakkanaas diza sohoy Isra7eele asaas beni aawata taarikeza yootees; istta giddon koyroy ba ammanoninne Xoossas azazettiza hanotan erettida Abrahaame; hessafe qasse iza naa Yisaaqa, iza naaza naa Yaaqoobenne Yaaqoobe nayta tammanne nam7ata taarikey kaallees; hayti Yaaqoobe nayti tammanne nam7ati, tammanne nam7u Isra7eele zaretas ano gididayta; heyta he tammanne nam7u Isra7eele nayta giddonkka Yooseefe dummasidi, hessaththoka qasse Yaaqoobenne iza nayta hankko attida istta keeththa asaara Gibxe biitta efida hanotaa minththi xeellees.</para>
  <para style="ip">Ha maxaafay asa taarike yootizayssa gidikkoka, ubbaafe aaththidi izi yootizayssi Xoossi ooththida ooso gishshassa. Xoossi salotanne sa7a medhdhida taarikeza yo7o doommidi, Xoossi ba asaas qoppizayssa aggonttayssa hidotan qonccisishe polees; ha Maxaafaa giddon ha gaxappe he gaxa gakkanaas yootettiza taarikeza goday, nagaranchchata pirdizaynne qaxxayizay, ba asaa kaaleththizaynne maaddizay, istta taarikeza hanotaakka giigsizay ba hu7en Xoossa. Hayssi beni maxaafay xaafettidayssi asa ammano taarikeza mazgabidi oykkanaassinne he ammanoykka minni de7ana mala ooththanaassa.</para>
  <para style="iot">Ha Maxaafay Oykkida Kumeththa Qofa</para>
  <para style="io1">Medheteth <char style="ior"><ref loc="GEN 1:1-2:25">1:1—2:25</ref> </char></para>
  <para style="io1">Nagaranne meto doometh <char style="ior"><ref loc="GEN 3:1-24">3:1-24</ref> </char></para>
  <para style="io1">Addaameppe biidi Nohe gakkanaas diza hanota <char style="ior"><ref loc="GEN 4:1-5:32">4:1—5:32</ref> </char></para>
  <para style="io1">Nohenne bashsha haath <char style="ior"><ref loc="GEN 6:1-10:32">6:1—10:32</ref> </char></para>
  <para style="io1">Baabiloone gimbe <char style="ior"><ref loc="GEN 11:1-9">11:1-9</ref> </char></para>
  <para style="io1">Seemeppe biidi Abrahaame gakkanaas diza hanota <char style="ior"><ref loc="GEN 11:10-32">11:10-32</ref> </char></para>
  <para style="io1">Beni aawata Abrahaame, Yisaaqanne Yaaqoobe wode <char style="ior"><ref loc="GEN 12:1-35:29">12:1—35:29</ref> </char></para>
  <para style="io1">Eesawe yeleta <char style="ior"><ref loc="GEN 36:1-43">36:1-43</ref> </char></para>
  <para style="io1">Yooseefenne iza ishata <char style="ior"><ref loc="GEN 37:1-45:28">37:1—45:28</ref> </char></para>
  <para style="io1">Isra7eele asay Gibxen <char style="ior"><ref loc="GEN 46:1-50:26">46:1—50:26</ref> </char></para>
  <chapter number="1" style="c" sid="GEN 1" />
  <para style="s1">Medheteththa Gishshas</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 1:1" />Xoossi koyro salonne sa7a medhdhides. <verse eid="GEN 1:1" /><verse number="2" style="v" sid="GEN 1:2" />He wode sa7ay lo7i giigibeennanne aykkoyka baynda mela dees; ciimmasohota dhumay goozi oykkides; Xoossa Ayanay haaththafe bollara may7i uttides.<verse eid="GEN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 1:3" />Hessafe guye Xoossi, «Poo7o gido» giin poo7o gidides.<note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="2CO 4:6">2Qoro 4:6</ref></char></note> <verse eid="GEN 1:3" /><verse number="4" style="v" sid="GEN 1:4" />Poo7oy lo7o gididayssa Xoossi be7idi poo7o dhumappe shaakkides. <verse eid="GEN 1:4" /><verse number="5" style="v" sid="GEN 1:5" />Xoossi poo7oza, «Gallas», dhumaza, «Omars» gi sunththides. Gadey qammidessinne wontides; hessika koyro gallassa.<verse eid="GEN 1:5" /></para>
  <para style="p">
    <verse number="6-7" style="v" sid="GEN 1:6-7" />Hessafe guye Xoossi, «Bollara diza haaththaa garsara diza haaththaafe shaakkiza salo gufanththoy hano» giin hanides. Xoossi salo gufanththo giigsidi, salo gufanththofe bollara diza haaththaa garsara diza haaththaafe shaakkides. <verse eid="GEN 1:6-7" /><verse number="8" style="v" sid="GEN 1:8" />Xoossi he gufanththoza, «Salo» gi sunththides. Gadey qammidessinne wontides; hessika nam7anththo gallassa.<note caller="-" style="x"><char style="xo" closed="false">1:6-8 </char><char style="xt" closed="false"><ref loc="2PE 3:5">2Phex 3:5</ref></char></note><verse eid="GEN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 1:9" />Hessafe guye Xoossi, «Saloppe garsara diza haaththi issison shiiqi eelliko mela biittay qoncco» giin hanides. <verse eid="GEN 1:9" /><verse number="10" style="v" sid="GEN 1:10" />Xoossi he mela sohoza, «Biitta» gi sunththides; qasse issison eellida haaththaa, «Abba» gi sunththides; histtidi Xoossi hessi lo7o gididayssa be7ides. <verse eid="GEN 1:10" /><verse number="11" style="v" sid="GEN 1:11" />Hessafe simmiin Xoossi, «Biittay miththinne maata mokiso; zereththa ayfera diza miththinne zereththa ayfera diza teeriza mith dumma dumma qommo mokiso» giin hanides. <verse eid="GEN 1:11" /><verse number="12" style="v" sid="GEN 1:12" />Hessa gishshas biittay miththinne maata dumma dumma qommon mokisiin Xoossi hessi lo7o gididayssa be7ides. <verse eid="GEN 1:12" /><verse number="13" style="v" sid="GEN 1:13" />Gadey qammidessinne wontides; hessika heedzdzanththo gallassa.<verse eid="GEN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 1:14" />Hessafe guye Xoossi, «Gallas qammafe shaakkanaas poo7oti salo gufanththon gidetto; istti gallas, wodenne layth erisetto; <verse eid="GEN 1:14" /><verse number="15" style="v" sid="GEN 1:15" />biitta bollan poo7isana mala istti salo gufanththon poo7etto» giin hanides. <verse eid="GEN 1:15" /><verse number="16" style="v" sid="GEN 1:16" />Xoossi nam7u gita poo7ota, gitatizayssi gallas poo7ana malanne guuxxizayssi omars poo7ana mala medhdhides; xoolinttetakka medhdhides. <verse eid="GEN 1:16" /><verse number="17-18" style="v" sid="GEN 1:17-18" />Xoossi istta ha biitta bollan poo7isana mala, gallassinne qamma haarana malanne poo7oza dhumappe shaakkana mala, salo gufanththon istta woththides. Histtidi Xoossi hessi lo7o gididayssa be7ides. <verse eid="GEN 1:17-18" /><verse number="19" style="v" sid="GEN 1:19" />Gadey qammidessinne wontides; hessika oydanththo gallassa.<verse eid="GEN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 1:20" />Hessafe guye Xoossi, «Shemppora diza dumma dumma medheteththati haaththa giddon daretto; kafotikka biittafe bollaranne salo gufanththofe garsara piradhdhetto» gides. <verse eid="GEN 1:20" /><verse number="21" style="v" sid="GEN 1:21" />Histtidi Xoossi abban diza gita do7ata, haaththa giddon woxxi qaaxxiza medheteththata ubbaa, kafo ubbaa dumma dumma qommon medhdhides. Hessika lo7o gididayssa Xoossi be7ides. <verse eid="GEN 1:21" /><verse number="22" style="v" sid="GEN 1:22" />Xoossi isttas, «Yelettite; darite; abba haaththaa kumite; kafoykka biitta bollan coratto» gi anjjides. <verse eid="GEN 1:22" /><verse number="23" style="v" sid="GEN 1:23" />Gadey qammidessinne wontides; hessika ichchashanththo gallassa.<verse eid="GEN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 1:24" />Hessafe guye Xoossi, «Shemppora diza medheteththati ba qommon qommon meheti, biittara gooshettiza medheteththatinne do7ati ba qommon qommon biitta bolla kezetto» giin hanides. <verse eid="GEN 1:24" /><verse number="25" style="v" sid="GEN 1:25" />Xoossi do7ata istta qommon qommon, mehetakka istta qommon qommoninne biittara gooshettiza medheteththatakka ubbaa istta qommon qommon medhdhides; hessika lo7o gididayssa Xoossi be7ides.<verse eid="GEN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 1:26" />Hessafe simmiin Xoossi, «Ane as nu leemison nuna misatissidi medhdhoos; istti abba moleta, salo kafota, meheta, biitta bolla woxxi qaaxxiza medheteththata ubbaa haaretto» gides.<note caller="-" style="x"><char style="xo" closed="false">1:26 </char><char style="xt" closed="false"><ref loc="1CO 11:7">1Qoro 11:7</ref></char></note> <verse eid="GEN 1:26" /><verse number="27" style="v" sid="GEN 1:27" />Hessaththo Xoossi as ba leemison bana misatissidi medhdhides; izi istta addenne macca ooththi medhdhides.<note caller="-" style="x"><char style="xo" closed="false">1:27 </char><char style="xt" closed="false"><ref loc="MAT 19:4">Mato 19:4</ref>; <ref loc="MRK 10:6">Mar 10:6</ref></char></note><verse eid="GEN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 1:28" />Xoossi isttas, «Yelettite; corattite; hayssa biittaa kumitenne haarite; abba mole, salo kafotanne biitta bolla woxxi qaaxxiza, shemppora diza medheteththata ubbaa haarite» gi anjjides.<note caller="-" style="x"><char style="xo" closed="false">1:27-28 </char><char style="xt" closed="false"><ref loc="GEN 5:1-2">Medhe 5:1-2</ref></char></note><verse eid="GEN 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 1:29" />Hessafe simmiin Xoossi, «Be7ite! Tani ha biitta ubbaa bollan zereththa ayfera diza miththinne zereththa ayfera diza teeriza mith ubbaa inttes immadis; isttika inttes miza quma gidetto. <verse eid="GEN 1:29" /><verse number="30" style="v" sid="GEN 1:30" />Qasseka ha biittaa bolla diza mehenne do7a ubbaas, salo kafotas ubbaas, biittara gooshettiza medheteththata ubbaassinne shemppora paxa diza medheteththata ubbaas miza miish gidana mala, cilila miththinne maata kumeth immadis» giin hanides. <verse eid="GEN 1:30" /><verse number="31" style="v" sid="GEN 1:31" />Xoossi ba medhdhidayssa ubbaaka xeellidi daro lo7o gididayssa be7ides. Gadey qammidessinne wontides; hessika usuppunththa gallassa.<verse eid="GEN 1:31" /></para>
  <chapter eid="GEN 1" />
  <chapter number="2" style="c" sid="GEN 2" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 2:1" />Salo bollanne sa7a bolla dizay wuri hayssaththo oosetti polettides. <verse eid="GEN 2:1" /><verse number="2" style="v" sid="GEN 2:2" />Xoossi ba ooththida ooso usuppunththa gallas polidi ba ooththida ooso ubbaafe laappunththa gallas shempides.<note caller="-" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="HEB 4:4">Ib 4:4</ref>,<ref loc="HEB 4:10">10</ref></char></note> <verse eid="GEN 2:2" /><verse number="3" style="v" sid="GEN 2:3" />Qasse Xoossi laappunththa gallassaa anjjidessinne dumma gallas ooththides; ays giikko Xoossi ba ooththiza ooso wursidi shempiday he gallassanna.<note caller="-" style="x"><char style="xo" closed="false">2:2-3 </char><char style="xt" closed="false"><ref loc="EXO 20:11">Kessa 20:11</ref></char></note> <verse eid="GEN 2:3" /><verse number="4" style="v" sid="GEN 2:4" />Saloynne sa7ay medhettiday hessa malanna.</para>
  <para style="s1" vid="GEN 2:4">Edene Gannate</para>
  <para style="p" vid="GEN 2:4">GODAY sa7anne salo medhdhida wode, <verse eid="GEN 2:4" /><verse number="5" style="v" sid="GEN 2:5" />sa7a bollan maatay, miththi, ay miishshika mokkibeenna; ays giikko GODAY ira bukisibeenna; qasse biitta ooththiza asikka medhettibeenna. <verse eid="GEN 2:5" /><verse number="6" style="v" sid="GEN 2:6" />Gidikkoka haaththi biittafe pude maacotti kezidi biitta ubbaa irxxisees. <verse eid="GEN 2:6" /><verse number="7" style="v" sid="GEN 2:7" />Hessafe guye GODAY biittafe issi as medhdhidi iza siidhen de7o shemppo punnin addezi shemppora dizaade gidides.<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="1CO 15:45">1Qoro 15:45</ref></char></note><note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">As guussi Ibraaweta qaalan, «Addaame» geetettees; «Addaame» guussi, «Biitta» geetettees; he nam7u qaalati issoy issaa misateettes.</char></note><verse eid="GEN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 2:8" />Kase GODAY arshey mokkiza baggara Edene geetettizason lo7oso giigsidi ba medhdhida addeza heen woththides. <verse eid="GEN 2:8" /><verse number="9" style="v" sid="GEN 2:9" />GODAY xeellanaas lo7iza, maanaaska mal7iza dumma dumma qommo mith biittafe mokisides; Edene giddon de7o immiza miththi dees; hessaththoka lo7onne iita erisiza mith woththides.<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="REV 2:7">Ajju 2:7</ref>; <ref loc="REV 22:2">22:2</ref>,<ref loc="REV 22:14">14</ref></char></note><verse eid="GEN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 2:10" />Gannate ushshiza shaafa haaththi Edeneppe goggees. Edeneppe kezidaappe guye, oyddu shaafa gidi shaakettees. <verse eid="GEN 2:10" /><verse number="11" style="v" sid="GEN 2:11" />Koyro shaafaa sunththi Pisoone; Pisooney worqqay diza Hawila geetettiza biittaa yuusho ubbaan goggees. <verse eid="GEN 2:11" /><verse number="12" style="v" sid="GEN 2:12" />He biittaa worqqay geeshsha worqqa; qasse al7o shittoynne keehi lo7iza shuchchi heen dees. <verse eid="GEN 2:12" /><verse number="13" style="v" sid="GEN 2:13" />Nam7anththo shaafaa sunththi Giyoone; Giyooney Tophphiya<note caller="+" style="f"><char style="fr" closed="false">2:13</char><char style="fqa" closed="false">Tophphiya: </char><char style="ft" closed="false">Tophphiya gizayssa Ibraawe maxaafay Kuush gees.</char></note> biitta yuusho ubbaan goggees. <verse eid="GEN 2:13" /><verse number="14" style="v" sid="GEN 2:14" />Heedzdzanththo shaafaa sunththi Xegroose; Xegroosey Asooreppe arshey mokkiza baggara goggees; qasse oydanththo shaafay Efiraaxise geetettees.<verse eid="GEN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 2:15" />Addezi Edenen ooththana malanne naagana mala GODAA Xoossay iza efi woththides. <verse eid="GEN 2:15" /><verse number="16" style="v" sid="GEN 2:16" />Histtidi GODAA Xoossay addeza, «Edene miththa teera ubbaafe neni maana giikko ma; <verse eid="GEN 2:16" /><verse number="17" style="v" sid="GEN 2:17" />gido attiin lo7onne iita erisiza miththay teerappe mooppa; ays giikko neni izippe mida gallas tumu hayqqana» gi azazides.<verse eid="GEN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 2:18" />Hessafe guye GODAA Xoossay, «Addezi barkka dizayssi lo7o deenna; tani izas injjetiza maado as medhdhana» gides.<verse eid="GEN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 2:19" />GODAA Xoossay kase meheta do7ata salo kafota ubbaa biittafe medhdhides; qasse addezi istta ay giidi sunththanakko siyanaas izakko ehiin addezi shemppora diza medheteththata ubbaa sunththida sunththay isttas sunth gidi attides. <verse eid="GEN 2:19" /><verse number="20" style="v" sid="GEN 2:20" />Hessaththo addezi meheta, salo kafotanne, do7ata ubbaa sunththides; gido attiin Addaames injjetiza maado asi beettibeenna.<verse eid="GEN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 2:21" />Hessa gishshas GODAA Xoossay addeza dhisko dhiskisidi, izi dhiskon dishin iza mille meqeththatappe issaa ekkidi he sohozan asho kunththides. <verse eid="GEN 2:21" /><verse number="22" style="v" sid="GEN 2:22" />GODAA Xoossay addezappe ekkida meqeththaa maccas medhdhidi izo addezakko ehides. <verse eid="GEN 2:22" /><verse number="23" style="v" sid="GEN 2:23" />Ehiin addezi, «Hekko! Ha meqeththaya ta meqeththafe, ha ashoyakka ta ashoppe ekettidaaro; izakka attumasappe ekettida gishshas, maccas geetettu» gides.<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">Adde guussi Ibraaweta qaalan «Ish» geetettees; «Maccas» guussi, «Isha» geetettees; he nam7u qaalati issoy issaa misateettes.</char></note> <verse eid="GEN 2:23" /><verse number="24" style="v" sid="GEN 2:24" />Hessa gishshas asi ba aawaanne ba aayo aggees; ba machcheyra issife dees; istti nam7ay issi asho.<note caller="-" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="MAT 19:5">Mato 19:5</ref>; <ref loc="MRK 10:7-8">Mar 10:7-8</ref>; <ref loc="1CO 6:16">1Qoro 6:16</ref>; <ref loc="EPH 5:31">Efe 5:31</ref></char></note> <verse eid="GEN 2:24" /><verse number="25" style="v" sid="GEN 2:25" />Addezinne iza machcheya nam7ayka paxa kallo deettes; gido attiin issay issaas yeellati erettenna.<verse eid="GEN 2:25" /></para>
  <chapter eid="GEN 2" />
  <chapter number="3" style="c" sid="GEN 3" />
  <para style="s1">Asi Azazettontta Ixo</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1" />Shooshshay GODAA Xoossay medhdhida do7a ubbaafe aadhdhida genanchcha; issi gallas shooshshay he maccassayo, «Xoossi tumu inttena, ‹Edenen diza miththa ayfe ubbaafekka moopite› gidee?» gi oychchides.<note caller="-" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="REV 12:9">Ajju 12:9</ref>; <ref loc="REV 20:2">20:2</ref></char></note><verse eid="GEN 3:1" /></para>
  <para style="p">
    <verse number="2-3" style="v" sid="GEN 3:2-3" />Maccassaya shooshshas zaarada, «Gidenna! Xoossi hessaththo gibeena; nuni Edenen diza miththata ayfe maanaas dandayoos; gido attiin Xoossi nuna, ‹Edene giddon diza miththaa ayfe moopite; bochchofte; histtontta aggiko intte hayqqana› gides» gadus.<verse eid="GEN 3:2-3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 3:4" />Shooshshay maccassayo, «Gidenna! Intte tuma hayqqeketa; <verse eid="GEN 3:4" /><verse number="5" style="v" sid="GEN 3:5" />Xoossi hessa giday he miththay ayfe intte miikko intte ayfey doyettiin, Xoossa mala intte lo7onne iita shaakki eranayssa izi eriza gishshassa» gides.<verse eid="GEN 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 3:6" />Maccassaya he miththaa ayfey maanaas mal7izayssa, xeellanaas lo7izayssa, qasse asi aadho erateth demmanaas amosizaaz gididayssa beyada he miththaa ayfeppe ekkada madus; qasse banara diza ba azinaaska hessafe immiin izikka mides.<verse eid="GEN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 3:7" />Mida wode istta nam7aa ayfeykka doyettiin istti baas paxa kallo dizayssa eridi balase<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">Balase geetettiza miththay Tophphiyan issi issi sohon erettiza mala eth misatiza izas hayththay agunththi bayndaaz gidi uttidi izas ayfezi mal7iza miththa.</char></note> geetettiza miththa hayth sikkidi ba xeessan gixxida.<verse eid="GEN 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 3:8" />Omarsa wode, Edene giddon GODAA Xoossay hemettishin, iza cenggurssaa addezinne iza machcheya siyidi GODAA Xoossaafe Edene miththa giddon qotettida. <verse eid="GEN 3:8" /><verse number="9" style="v" sid="GEN 3:9" />Gido attiin GODAA Xoossay addeza xeygidi, «Addaame awan day?» gides.<verse eid="GEN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 3:10" />Addezikka, «Edene giddon ne cenggurssaa siyada tani kallo diza gishshas babbada qotettadis» gides.<verse eid="GEN 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 3:11" />GODAA Xoossay iza, «Neni kallo daasa giidi nees yootiday oonee? Tani nena, ‹Mooppa› gaada azazida miththaa ayfeppe madii?» gi oychchides.<verse eid="GEN 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 3:12" />Izikka, «Tanara daana mala ne immida maccassaya he miththaa ayfeppe taas immiin madis» gides.<verse eid="GEN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 3:13" />GODAA Xoossay hessafe guye maccassayo, «Neni hessa ays ooththadii?» gi oychchides.</para>
  <para style="p" vid="GEN 3:13">Maccassayakka, «Tana shooshshay baleththiin madis» gadus.<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="2CO 11:3">2Qoro 11:3</ref>; <ref loc="1TI 2:14">1Xim 2:14</ref></char></note><verse eid="GEN 3:13" /></para>
  <para style="s1">Xoossa Pirda</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14" />GODAA Xoossay hessafe guye shooshshaa,</para>
  <para style="q1" vid="GEN 3:14">«Neni hayssa ooththida gishshas,</para>
  <para style="q2" vid="GEN 3:14">mehe ubbaanne</para>
  <para style="q2" vid="GEN 3:14">do7a ubbaa garsan</para>
  <para style="q2" vid="GEN 3:14">ne xallay qanggettidaaza!</para>
  <para style="q2" vid="GEN 3:14">Neni ne ulon biittara gooshettana;</para>
  <para style="q2" vid="GEN 3:14">ne de7o layth ubbaankka</para>
  <para style="q2" vid="GEN 3:14">biitta gudulla laacca.<verse eid="GEN 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 3:15" />Tani neessinne maccassays,</para>
  <para style="q2" vid="GEN 3:15">ne zereththassinne</para>
  <para style="q2" vid="GEN 3:15">izi zereththas giddon</para>
  <para style="q2" vid="GEN 3:15">morkketeth medhdhana;</para>
  <para style="q2" vid="GEN 3:15">izi ne hu7e qoxxana;</para>
  <para style="q2" vid="GEN 3:15">nenikka iza qirphe</para>
  <para style="q2" vid="GEN 3:15">dukkana» gides.<note caller="-" style="x"><char style="xo" closed="false">3:15 </char><char style="xt" closed="false"><ref loc="REV 12:17">Ajju 12:17</ref></char></note><verse eid="GEN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 3:16" />Maccassayokka GODAA Xoossay,</para>
  <para style="q1" vid="GEN 3:16">«Ne shaaraza<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="fqa" closed="false">Shaaraza: </char><char style="ft" closed="false">Shaaraza gizayssa issi issi bagga gamoththo qaalan abbe ixeta, qanththa gees.</char></note> aginan</para>
  <para style="q2" vid="GEN 3:16">neni daro tuggatana;</para>
  <para style="q2" vid="GEN 3:16">qasse neni wolqqama miixan</para>
  <para style="q2" vid="GEN 3:16">nayta yelana.</para>
  <para style="q2" vid="GEN 3:16">Gidikkoka neni ne azinara</para>
  <para style="q2" vid="GEN 3:16">aqanaas amottana;</para>
  <para style="q2" vid="GEN 3:16">izikka nena haarana» gides.<verse eid="GEN 3:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="GEN 3:17" />Addaamekka GODAA Xoossay, «Neni ne machchey qaala siyida gishshas tani nena, ‹He miththaa ayfe mooppa› gaada azazida miththaa ayfeppe neni mida gishshas,</para>
  <para style="q1" vid="GEN 3:17">«Ne geedon biittay</para>
  <para style="q2" vid="GEN 3:17">qanggettidaaz gido!</para>
  <para style="q2" vid="GEN 3:17">Neni ne de7o layth ubbaan</para>
  <para style="q2" vid="GEN 3:17">gita daaburan</para>
  <para style="q2" vid="GEN 3:17">biitta ooththada maana.<verse eid="GEN 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="GEN 3:18" />Biittay nees agunththinne</para>
  <para style="q2" vid="GEN 3:18">kindichcho mokisana;</para>
  <para style="q2" vid="GEN 3:18">neni biittafe mokkidayssa maana.<note caller="-" style="x"><char style="xo" closed="false">3:17-18 </char><char style="xt" closed="false"><ref loc="HEB 6:8">Ib 6:8</ref></char></note><verse eid="GEN 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="GEN 3:19" />Neni biittan simmana gakkanaas</para>
  <para style="q2" vid="GEN 3:19">daaburan ne cawa gussa</para>
  <para style="q2" vid="GEN 3:19">ooththada maana;</para>
  <para style="q2" vid="GEN 3:19">neni biittafe medhettida gishshas</para>
  <para style="q2" vid="GEN 3:19">biittan simmandasa» gides.<verse eid="GEN 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 3:20" />Addaamey ba machchiyo Hewaano<note caller="+" style="f"><char style="fr" closed="false">3:20 </char><char style="fqa" closed="false">Hewaano: </char><char style="ft" closed="false">Hewaano guussi paxa duus guussa.</char></note> gi sunththides; ays giikko iza asa ubbaas aayo.<verse eid="GEN 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 3:21" />GODAA Xoossay Addaamessinne iza machcheys ite giigsidi istta mayzides.<verse eid="GEN 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 3:22" />Hessafe guye GODAA Xoossay, «Histtiin asi nuuppe issaade mala lo7onne iita erizaade gidides; izi ba kushe yeddidi de7o immiza miththaafe ekkidi qasse montta malanne mernaas paxa de7ontta mala teqettanaas koshshees» gides.<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="REV 22:14">Ajju 22:14</ref></char></note> <verse eid="GEN 3:22" /><verse number="23" style="v" sid="GEN 3:23" />Hessa gishshas izi ba medhettida biittaa ooththana mala, GODAA Xoossay Edeneppe iza kessides. <verse eid="GEN 3:23" /><verse number="24" style="v" sid="GEN 3:24" />Iza kessidi, de7o miththaako efiza oge naagana mala, kirube geetettiza kiitanchchatanne popol7u gi aadhdhi aadhdhi wodhdhiza tama laco misatiza giththa mashsha Edeneppe arshey mokkiza baggara woththides.<verse eid="GEN 3:24" /></para>
  <chapter eid="GEN 3" />
  <chapter number="4" style="c" sid="GEN 4" />
  <para style="s1">Qayeelenne Aabeele</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1" />Addaamey ba machcho Hewaanira aqiin iza shaarada attuma naa yeladus; «GODAY tana maaddiin attuma naa demmadis» gashe iza Qayeele ga sunththadus. <verse eid="GEN 4:1" /><verse number="2" style="v" sid="GEN 4:2" />Qasse iza isha Aabeelekka yeladus.<note caller="+" style="f"><char style="fr" closed="false">4:2 </char><char style="fqa" closed="false">Qayeele: </char><char style="ft" closed="false">Qayeele guussi Ibraaweta qaalan, «Qayin» geetettees. Birsheththayka, «Demmadis» guussa.</char></note></para>
  <para style="p" vid="GEN 4:2">Aabeeli dorsa heenththanchcha; Qayeeley biitta goshshanchcha. <verse eid="GEN 4:2" /><verse number="3" style="v" sid="GEN 4:3" />Undenna wodeppe guye Qayeeley ba gaden mokkida kaththaafe Godaas yarsho shiishshides. <verse eid="GEN 4:3" /><verse number="4" style="v" sid="GEN 4:4" />Gido attiin Aabeeli ba dorsata giddon koyro yelettida laaqqatappe issaa ekki shukkidi ashozappe handaza yarshides; GODAY Aabeelenne iza yarshoza ekkides. <verse eid="GEN 4:4" /><verse number="5" style="v" sid="GEN 4:5" />Qayeelenne iza yarsho ekkibeenna; hessa gishshas Qayeeley keehi yiillotides; ba ayfesokka iissides.<verse eid="GEN 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 4:6" />Histtiin GODAY Qayeele, «Ays yiillotay? Ne ayfesoy ays dhumidee? <verse eid="GEN 4:6" /><verse number="7" style="v" sid="GEN 4:7" />Ne lo7o ooththidaa gididaakko Xoossi ne yarsho ekkenneeshin? Neni lo7o ooththontta ixxiko nagaray ne karen nena naagees; nagaray nena haarana koyees; neni iza xoonana bessees» gides.<verse eid="GEN 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 4:8" />Hessafe guye Qayeeley ba isha Aabeele, «Ane gede dembaso boos» gides. Biidi istti demban dishin Qayeeley ba isha Aabeele bolla dendidi wodhides.<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="MAT 23:35">Mato 23:35</ref>; <ref loc="LUK 11:51">Luqa 11:51</ref>; <ref loc="1JN 3:12">1Yoha 3:12</ref>; <ref loc="1JN 4:10">4:10</ref>; <ref loc="HEB 12:24">Ib 12:24</ref></char></note><verse eid="GEN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 4:9" />GODAY Qayeele, «Ne ishay Aabeeli awan dizee?» gi oychchides.</para>
  <para style="p" vid="GEN 4:9">Qayeeley zaaridi, «Ta erikke; ta ishaa naagizay taneyee?» gides.<verse eid="GEN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 4:10" />GODAY Qayeele, «Hessa ays ooththadii? Beya; ne ishaa suuththi biittafe pude taakko waassees. <verse eid="GEN 4:10" /><verse number="11" style="v" sid="GEN 4:11" />Ne kusheppe ne ishaa suuththaa ekkidi mittanaas doona doyda biittaa bolla ha7i neni qanggettadasa. <verse eid="GEN 4:11" /><verse number="12" style="v" sid="GEN 4:12" />Neni ooththiinkka biittay nees kath immenna; bete asa mala neni biitta bollan toylattana» gides.<verse eid="GEN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 4:13" />Qayeeley GODAA, «Ne tana qaxxayiza qixaate tani mulekka dandaykke. <verse eid="GEN 4:13" /><verse number="14" style="v" sid="GEN 4:14" />Hekko neni tana hach ha biittafe yedeththaasa; tani ne sinththafe qotettana; bete asa mala tani biitta bolla toylattana; tana demmiday oonikka wodhana» gides.<verse eid="GEN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 4:15" />GODAY iza, «Nena oonikka wodhenna; wodhikko ne halo tani laappun kushe kessana» gides; hessa gishshas demmiday oonikka iza wodhontta mala GODAY iza bolla malata woththides. <verse eid="GEN 4:15" /><verse number="16" style="v" sid="GEN 4:16" />Qayeeley GODAA sinththafe kezidi Edene baggafe arshey mokkiza baggara diza Noode<note caller="+" style="f"><char style="fr" closed="false">4:16 </char><char style="fqa" closed="false">Noode: </char><char style="ft" closed="false">Noode guussi toylateth guussa.</char></note> geetettiza biittan de7ides.<verse eid="GEN 4:16" /></para>
  <para style="s1">Qayeele Yeleta</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17" />Qayeeley ba machcheyra aqiin iza shaarada Heenooke yeladus; he wode Qayeeley katama giigsidi he katamaa ba naaza sunththan, «Heenooke» gi sunththides. <verse eid="GEN 4:17" /><verse number="18" style="v" sid="GEN 4:18" />Heenookey Iraade yelides; Iraadey Mahuyaa7eele yelides; Mahuyaa7eeley Matusa7eele yelides; Matusa7eeley Laameeke yelides.<verse eid="GEN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 4:19" />Laameekey Aadonne Xiilo geetettiza nam7u machcheta dawuth ekkides. <verse eid="GEN 4:19" /><verse number="20" style="v" sid="GEN 4:20" />Aaday Yaabaale yeladus; Yaabaaley mehe haarishe yuuyi yuuyi dunkaanen diza asata aawa. <verse eid="GEN 4:20" /><verse number="21" style="v" sid="GEN 4:21" />Iza ishaa sunththi Yuubaale; Yuubaaley qasse diith diixxizanne susul7e punniza asata ubbata aawa; <verse eid="GEN 4:21" /><verse number="22" style="v" sid="GEN 4:22" />Xiilay qasse Tubaaliqayne geetettiza naa yeladus; Tubaaliqayney xarqimalappenne biratappe dumma dumma miishshata qoxxizaadde. Tubaaliqayne michcheya Naa7imo geetettawus.<verse eid="GEN 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 4:23" />Issi gallas Laameekey ba machcheta, «Ta machcheto Aadee, Xiilee siyite! Ane tani yootizayssa ezgite. Issi asi tana wadhdhi madunththida gishshas tani iza wodhadis; ee, tani he tana madunxissida wodallaza wodhadis. <verse eid="GEN 4:23" /><verse number="24" style="v" sid="GEN 4:24" />Qayeele halo kessanaas laappun kushe koshshiko Laameeke halo kessanaas laappun tammanne laappun kushe koshshees» gides.<note caller="-" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="MAT 18:22">Mato 18:22</ref></char></note><verse eid="GEN 4:24" /></para>
  <para style="s1">Seetenne Heenoose</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25" />Addaamey ba machcheyra aqiin hara naa yeladus. Yelada «Qayeeley wodhida Aabeele gishshas Xoossi taas hara naa immides» gashe iza Seete<note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="fqa" closed="false">Seete: </char><char style="ft" closed="false">Seete guussi Ibraaweta qaalara immides guussa</char></note> gaada sunththadus. <verse eid="GEN 4:25" /><verse number="26" style="v" sid="GEN 4:26" />Seeteykka attuma naa yelidi iza, «Heenoose» gi sunththides. Asay he wode GODAA sunth xeygidi goyno oykkides.<verse eid="GEN 4:26" /></para>
  <chapter eid="GEN 4" />
  <chapter number="5" style="c" sid="GEN 5" />
  <para style="s1">Addaame Zereth</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1" />Addaame zereththi hayssafe kaallidi xaafettides; Xoossi as medhdhida gallas bana misatissidi medhdhides.<note caller="-" style="x"><char style="xo" closed="false">5:1-2 </char><char style="xt" closed="false"><ref loc="GEN 1:27-28">Medhe 1:27-28</ref></char></note> <verse eid="GEN 5:1" /><verse number="2" style="v" sid="GEN 5:2" />Addenne maccas ooththi medhdhidi istta anjjides. Istta medhdhidi as gi sunththides.<note caller="-" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="MAT 19:4">Mato 19:4</ref>; <ref loc="MRK 10:6">Mar 10:6</ref></char></note><verse eid="GEN 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 5:3" />Addaamey 130 layth de7idi bana misatiza attuma naa yelidi iza, «Seete» gi sunththides. <verse eid="GEN 5:3" /><verse number="4" style="v" sid="GEN 5:4" />Addaamey Seete yelidaappe guye 800 layth de7ides; hara attuma naytanne macca nayta yelides. <verse eid="GEN 5:4" /><verse number="5" style="v" sid="GEN 5:5" />Addaamey mulera 930 layth de7idi hayqqides.<verse eid="GEN 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 5:6" />Seetey 105 layth de7idi Heenoose yelides; <verse eid="GEN 5:6" /><verse number="7" style="v" sid="GEN 5:7" />Seetey Heenoose yelidaappe guye 807 layth de7ides; hara attuma naytanne macca nayta yelides. <verse eid="GEN 5:7" /><verse number="8" style="v" sid="GEN 5:8" />Seetey mulera 912 layth de7idi hayqqides.<verse eid="GEN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 5:9" />Heenoosey 90 layth de7idi Qaynaane yelides; <verse eid="GEN 5:9" /><verse number="10" style="v" sid="GEN 5:10" />Heenoosey Qaynaane yelidaappe guye 815 layth de7ides; hara attuma naytanne macca nayta yelides. <verse eid="GEN 5:10" /><verse number="11" style="v" sid="GEN 5:11" />Heenoosey mulera 905 layth de7idi hayqqides.<verse eid="GEN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 5:12" />Qaynaaney 70 layth de7idi Malal7eele yelides; <verse eid="GEN 5:12" /><verse number="13" style="v" sid="GEN 5:13" />Qaynaaney Malal7eele yelidaappe guye 840 layth de7ides; hara attuma naytanne macca nayta yelides. <verse eid="GEN 5:13" /><verse number="14" style="v" sid="GEN 5:14" />Qaynaaney mulera 910 layth de7idi hayqqides.<verse eid="GEN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 5:15" />Malal7eeley 65 layth de7idi Yaareede yelides; <verse eid="GEN 5:15" /><verse number="16" style="v" sid="GEN 5:16" />Malal7eeley Yaareede yelidaappe guye 830 layth de7ides; hara attuma naytanne macca nayta yelides. <verse eid="GEN 5:16" /><verse number="17" style="v" sid="GEN 5:17" />Malal7eeley mulera 895 layth de7idi hayqqides.<verse eid="GEN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 5:18" />Yaareedey 162 layth de7idi Heenooke yelides; <verse eid="GEN 5:18" /><verse number="19" style="v" sid="GEN 5:19" />Yaareedey Heenooke yelidaappe guye 800 layth de7ides; hara attuma naytanne macca nayta yelides. <verse eid="GEN 5:19" /><verse number="20" style="v" sid="GEN 5:20" />Yaareedey mulera 962 layth de7idi hayqqides.<verse eid="GEN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 5:21" />Heenookey 65 layth de7idi Maatusaala yelides; <verse eid="GEN 5:21" /><verse number="22" style="v" sid="GEN 5:22" />Maatusaala yelidaappe guye Heenookey 300 layth Xoossa ufayssishe de7ides; hara attuma naytanne macca nayta yelides. <verse eid="GEN 5:22" /><verse number="23" style="v" sid="GEN 5:23" />Heenookey mulera 365 layth de7ides; <verse eid="GEN 5:23" /><verse number="24" style="v" sid="GEN 5:24" />Izi Xoossa ufayssishe diin Xoossi iza ekkida gishshas beettontta dhaydes.<note caller="-" style="x"><char style="xo" closed="false">5:24 </char><char style="xt" closed="false"><ref loc="HEB 11:5">Ib 11:5</ref>; <ref loc="JUD 1:14">Yuhu 14</ref></char></note><verse eid="GEN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 5:25" />Maatusaalay 187 layth de7idi Laameeke yelides; <verse eid="GEN 5:25" /><verse number="26" style="v" sid="GEN 5:26" />Maatusaalay Laameeke yelidaappe guye, 782 layth de7ides; hara attuma naytanne macca nayta yelides. <verse eid="GEN 5:26" /><verse number="27" style="v" sid="GEN 5:27" />Maatusaalay mulera 969 layth de7idi hayqqides.<verse eid="GEN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 5:28" />Laameekey 182 layth de7idi attuma naa yelidi, <verse eid="GEN 5:28" /><verse number="29" style="v" sid="GEN 5:29" />«Ha naazi GODAY qanggida biitta bollan nuna nu daaburappe shempisana» giidi Nohe gi sunththides.<note caller="+" style="f"><char style="fr" closed="false">5:29 </char><char style="ft" closed="false">Nohe guussi Ibraaweta qaalara shempo guussa.</char></note> <verse eid="GEN 5:29" /><verse number="30" style="v" sid="GEN 5:30" />Laameekey Nohe yelidaappe guye 595 layth de7ides; hara attuma naytanne macca nayta yelides. <verse eid="GEN 5:30" /><verse number="31" style="v" sid="GEN 5:31" />Laameekey mulera 777 layth de7idi hayqqides.<verse eid="GEN 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 5:32" />Nohey 500 layth de7idi Seeme, Kaamenne Yaafeete yelides.<verse eid="GEN 5:32" /></para>
  <chapter eid="GEN 5" />
  <chapter number="6" style="c" sid="GEN 6" />
  <para style="s1">Asa Iitateth</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1" />Asi biitta bolla darida wode asas macca nayti yelettida;<note caller="-" style="x"><char style="xo" closed="false">6:1-4 </char><char style="xt" closed="false"><ref loc="JOB 1:6">Iyo 1:6</ref>; <ref loc="JOB 2:1">2:1</ref></char></note> <verse eid="GEN 6:1" /><verse number="2" style="v" sid="GEN 6:2" />«Xoossa nayta» geetettiza medheteththati asa macca nayti medho lo7o gididayssa be7idi isttafe ba dooridayta machcho ekkida.<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="ft" closed="false">Xoossa nayta gizayssa issi issi birsheththa maxaafati kiitanchchata geettes</char></note> <verse eid="GEN 6:2" /><verse number="3" style="v" sid="GEN 6:3" />GODAY, «Asi hayqqizaaza; iza layththayka 120 layththafe darenna; hessa gishshas ta Ayanay asa naa bolla mernaas deenna» gides. <verse eid="GEN 6:3" /><verse number="4" style="v" sid="GEN 6:4" />He wodenne hessafe guye Xoossa nayti asa macca nayta machcho ekkiin nayti yelettida wode wogga wolqqama asati biitta bollan deettes. Isttika beni wode olas minonne erettida asa.<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="NUM 13:33">Tay 13:33</ref></char></note><verse eid="GEN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 6:5" />GODAY he wode biitta bollan diza asaa iitateththi daridayssanne istti ba wozinan qoppizayssi wuri ubba wodekka iita xalala gididayssa be7ides;<note caller="-" style="x"><char style="xo" closed="false">6:5-8 </char><char style="xt" closed="false"><ref loc="MAT 24:37">Mato 24:37</ref>; <ref loc="LUK 17:26">Luqa 17:26</ref>; <ref loc="1PE 3:20">1Phex 3:20</ref></char></note> <verse eid="GEN 6:5" /><verse number="6" style="v" sid="GEN 6:6" />GODAY as ha biitta bollan medhdhida gishshas modhettides; ba wozinan keehi seelettides. <verse eid="GEN 6:6" /><verse number="7" style="v" sid="GEN 6:7" />Hessa gishshas GODAY, «Tani medhdhida asaa ha biitta bollafe ubbaa dhayssana; asa, mehe, do7a, biittara gooshettiza medheteththatanne kafota dhayssana; ays giikko tani istta medhdhida gishshas mishettadis» gides. <verse eid="GEN 6:7" /><verse number="8" style="v" sid="GEN 6:8" />Gido attiin Nohey GODAA sinththan sabettides.<verse eid="GEN 6:8" /></para>
  <para style="s1">Nohe</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9" />Nohey hanidayssi hayssafe kaallidi xaafettides. Nohey xillo asa; izi ba woden diza asaa giddon suure asa; Nohey Xoossara giiga duus de7ides.<note caller="-" style="x"><char style="xo" closed="false">6:9 </char><char style="xt" closed="false"><ref loc="2PE 2:5">2Phex 2:5</ref></char></note> <verse eid="GEN 6:9" /><verse number="10" style="v" sid="GEN 6:10" />Nohey Seeme, Kaamenne Yaafeete geetettiza heedzdzu attuma nayta yelides.<verse eid="GEN 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 6:11" />He wode biitta bolla diza asi wuri Xoossa sinththan tunides; biittay wuri makkallan kumides. <verse eid="GEN 6:11" /><verse number="12" style="v" sid="GEN 6:12" />Xoossi duge biitta xeellishin biitta bolla diza asay wuri tunidayssa be7ides.<verse eid="GEN 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 6:13" />Hessa gishshas Xoossi Nohe, «Tani asa ubbaa dhayssana gays; asa gaason biittay makkallan kumida gishshas tani tumappe asanne biitta bolla dizaaz ubbaa dhayssana. <verse eid="GEN 6:13" /><verse number="14" style="v" sid="GEN 6:14" />Hessa gishshas mino miththafe nees markabe keexxa; he markabeza giddon kifile ooththa; histtada soo baggaranne kare baggara shidan meesha.<figure style="fig" alt="Ark, rain and people" file="CO00628B.TIF" size="span" ref="6:14">Nohe markabe</figure> <verse eid="GEN 6:14" /><verse number="15" style="v" sid="GEN 6:15" />Markabeza keexxashe iza adussateththi 300 wadha, gomppay 50 wadha, pude dhoqqateththi 133 wadha histta ooththa. <verse eid="GEN 6:15" /><verse number="16" style="v" sid="GEN 6:16" />Markabezas kaara medhdha; kaaraappenne godaappe giddon issi wadha gidizaso doya agga; pengeza markabezas millera kessa; markabeza heedzdzu pooqe kessa keexxa.<verse eid="GEN 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 6:17" />«Tani saloppe garsan shemppora diza medheteththa ubbaa dhayssanaas ha biitta bollan dhayssa haath yeddiko biittan dizayssi wuri dhayana. <verse eid="GEN 6:17" /><verse number="18" style="v" sid="GEN 6:18" />Gido attiin tani nenara caaqettana. Neni, ne machchiya, ne naytinne ne nayta machcheti nenara markabezan gelandeta. <verse eid="GEN 6:18" /><verse number="19" style="v" sid="GEN 6:19" />Istti nenara paxa daana mala shemppora diza medheteththa ubbaafe qommon qommon addenne macca nam7u nam7u histtada markabeza giddo gelththa. <verse eid="GEN 6:19" /><verse number="20" style="v" sid="GEN 6:20" />Dumma dumma qommo kafotappe, dumma dumma qommo mehetappenne biittara gooshettiza dumma dumma qommo medheteththatappe ubbaafe nam7u nam7u gididi shemppora paxa attana mala neekko yaana. <verse eid="GEN 6:20" /><verse number="21" style="v" sid="GEN 6:21" />Qasse neninne nenara dizayti maana mala dumma dumma qommo kath efada markabeza giddo gelththa» gi azazides.<verse eid="GEN 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 6:22" />Nohey ubbaaka Xoossi azazida mala ooththides.<note caller="-" style="x"><char style="xo" closed="false">6:22 </char><char style="xt" closed="false"><ref loc="HEB 11:7">Ib 11:7</ref></char></note><verse eid="GEN 6:22" /></para>
  <chapter eid="GEN 6" />
  <chapter number="7" style="c" sid="GEN 7" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1" />Hessafe guye GODAY Nohe, «Neni hayssa ha wode yeletaa giddon xillo gididayssa ta be7ida gishshas neni neso asaa ubbaara markabeza giddo gela. <verse eid="GEN 7:1" /><verse number="2-3" style="v" sid="GEN 7:2-3" />Neni geesh gidida mehenne do7a ubbaafe iza qommofe qommofe addenne macca laappun laappun, geesh gidontta mehenne do7a ubbaafe iza qommofe qommofe issi addenne issi macca qasse kafotappe iza qommofe qommofe addenne macca laappun laappun, biitta ubbaa bollan dumma dumma zereththay paxa daana mala nenara ekka gela. <verse eid="GEN 7:2-3" /><verse number="4" style="v" sid="GEN 7:4" />Ays giikko laappun gallassafe guye tani oyddu tammu gallassinne oyddu tammu qamma biitta bollan ira bukisana; histtada tani medhdhida medheta ubbaa biitta bollafe dhayssana» gides.<verse eid="GEN 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 7:5" />Nohey GODAY iza azazidayssa ubbaa ooththides.<verse eid="GEN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 7:6" />Dhaysa haaththi biitta bolla yiza wode Nohes layththay usuppun xeeta. <verse eid="GEN 7:6" /><verse number="7" style="v" sid="GEN 7:7" />Nohe, iza attuma nayti, iza machcheyanne iza nayta machcheti dhayssa haaththaafe attanaas markabeza giddo gelida.<note caller="-" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="MAT 24:38-39">Mato 24:38-39</ref>; <ref loc="LUK 17:27">Luqa 17:27</ref></char></note> <verse eid="GEN 7:7" /><verse number="8" style="v" sid="GEN 7:8" />Geeshsha meheppenne do7appe, geesh gidontta meheppenne do7appe, kafoppenne biittara gooshettiza ubbaafe, <verse eid="GEN 7:8" /><verse number="9" style="v" sid="GEN 7:9" />Xoossi Nohe azazida malakka addenne macca nam7u nam7u gididi Nohekko markabeza giddo geliin, <verse eid="GEN 7:9" /><verse number="10" style="v" sid="GEN 7:10" />laappun gallassafe guye dhayssa haaththi biitta bolla yides.<verse eid="GEN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 7:11" />Nohes usuppun xeetu layth gidishin nam7anththo aginan tammanne laappunththa gallassan he gallassankka biitta giddon diza gita ciimma pulttoy wuri dhuuqqides; salon diza haaththa maskootetikka doyetti wodhdhida.<note caller="-" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="2PE 3:6">2Phex 3:6</ref></char></note> <verse eid="GEN 7:11" /><verse number="12" style="v" sid="GEN 7:12" />Iray biitta bollan oyddu tammu gallassinne oyddu tammu omars bukkides. <verse eid="GEN 7:12" /><verse number="13" style="v" sid="GEN 7:13" />He gallassan Noheynne iza attuma nayti, Seemey, Kaameynne Yaafeetey, Nohe machcheyanne iza nayta heedzdzata machcheti issife markabeza giddo gelida. <verse eid="GEN 7:13" /><verse number="14" style="v" sid="GEN 7:14" />Isttanne do7a ubbaafe ba qommon qommon, mehe ubbaafekka ba qommon qommon, biittara gooshettizayata ubbaafe ba qommon qommon, kafo ubbaafe ba qommon qommon isttara issife gelida. <verse eid="GEN 7:14" /><verse number="15" style="v" sid="GEN 7:15" />Shemppora paxa dizayti wuri nam7u nam7u gididi Nohekko markabezan gelida; <verse eid="GEN 7:15" /><verse number="16" style="v" sid="GEN 7:16" />Xoossay Nohe azazida mala medheta ubbaafe addenne macca gididi markabeza giddo geliin Nohey giddon dishin GODAY markabeza penge gordides.<verse eid="GEN 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 7:17" />Dhayssa haaththi oyddu tammu gallas biitta bolla bukkishe gam7ides; haaththi daridi, markabeza biittafe pude denththides. <verse eid="GEN 7:17" /><verse number="18" style="v" sid="GEN 7:18" />Haaththay biitta bollan keehi dariin markabezi haaththaa bollan tookettides. <verse eid="GEN 7:18" /><verse number="19" style="v" sid="GEN 7:19" />Saloppe garsara diza dhoqqa zumati wuri mitettana gakkanaas haaththay biitta bollan keehi wolqqafe darides. <verse eid="GEN 7:19" /><verse number="20" style="v" sid="GEN 7:20" />Haaththay zumata xeerappe aadhdhidi 15 wadha gakkanaas dhoqqu gides. <verse eid="GEN 7:20" /><verse number="21" style="v" sid="GEN 7:21" />Histtiin biitta bollan shemppora paxa qaaxxiza medheteththati wuri, kafoy, mehey, do7ay, biitta bollan woxxi qaxxizaynne asi wuri hayqqides. <verse eid="GEN 7:21" /><verse number="22" style="v" sid="GEN 7:22" />Biitta bollan diza siidhera shempizay wurikka hayqqides. <verse eid="GEN 7:22" /><verse number="23" style="v" sid="GEN 7:23" />Ha biittan paxa dizay wuri asi, meheynne do7ay, biittara gooshettiza medheteththinne salo kafoti wurikka biittafe pitetti dhayiin Noheynne izara markabe giddon dizayti xalla attida. <verse eid="GEN 7:23" /><verse number="24" style="v" sid="GEN 7:24" />Haaththayka 150 gallas gakkanaas biitta bollan gam7ides.<verse eid="GEN 7:24" /></para>
  <chapter eid="GEN 7" />
  <chapter number="8" style="c" sid="GEN 8" />
  <para style="s1">Dhayssa Haaththa Wurseth</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1" />Gido attiin Xoossi Nohe, izara markabeza giddon diza do7anne mehe ubbaa qoppidi biitta bollan carko carkissiin haaththay wodhdhi wodhdhi bides. <verse eid="GEN 8:1" /><verse number="2" style="v" sid="GEN 8:2" />Qasse biitta giddon diza ciimma pulttoynne salon diza haaththa maskooteti gordettida; iraykka salon teqettides. <verse eid="GEN 8:2" /><verse number="3" style="v" sid="GEN 8:3" />Histtiin haaththay wodhdhi wodhdhi bides; he 150 gallassafe guye haaththay wodhdhides. <verse eid="GEN 8:3" /><verse number="4" style="v" sid="GEN 8:4" />Haaththay wodhdhiin markabezi laappunththa aginan tammanne laappunththa gallassan Araraate geetettiza zuma bolla shempides. <verse eid="GEN 8:4" /><verse number="5" style="v" sid="GEN 8:5" />Haaththay tammanththo agina gakkanaaska wodhdhi wodhdhi bides; tammanththo aginan koyro gallas zumatas hu7ey beettides.<verse eid="GEN 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 8:6" />Oyddu tammu gallassafe guye Nohey ba keexxida markabeza maskooteza doydi, <verse eid="GEN 8:6" /><verse number="7" style="v" sid="GEN 8:7" />issi quuro kare kessi yeddiin quurozi haaththi biitta bollafe melana gakkanaas yaanne haa piradhdhishe gam7ides. <verse eid="GEN 8:7" /><verse number="8" style="v" sid="GEN 8:8" />Qasse Nohey haaththi biitta bollafe wodhdhi wuridaakko beyanaas issi haraphphe kare yeddides. <verse eid="GEN 8:8" /><verse number="9" style="v" sid="GEN 8:9" />Gido attiin he haraphpheya haaththi biitta ubbaa bollan ha7ikka diza gishshas shempizaso demmabeekku; hessa gishshas simmada markabeza giddon diza Nohekko yiin izi ba kushe yeddidi baakko markabeza giddo ekkides.<verse eid="GEN 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 8:10" />Qasseka hara laappun gallas gam7idi ha7ikka haraphpheyo markabeza giddofe kessi yeddides. <verse eid="GEN 8:10" /><verse number="11" style="v" sid="GEN 8:11" />He haraphpheya gadey qammishin izakko simma yashe wogara xeerappe cilila hayth duuththada doonan saxxa ekka yida gishshas haaththi biitta bollafe wodhdhidayssa Nohey erides. <verse eid="GEN 8:11" /><verse number="12" style="v" sid="GEN 8:12" />Qasse Nohey hara laappun gallas gam7idi he haraphpheyo zaari yeddides; gido attiin he haraphpheya izakko simma yabeekku.<verse eid="GEN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 8:13" />Nohey 601 layth de7iin koyro aginan koyro gallas haaththi biitta bollafe xoskides; Nohey markabeza kaaraa qaari xeellidi gadey xoskidayssa be7ides. <verse eid="GEN 8:13" /><verse number="14" style="v" sid="GEN 8:14" />Nam7anththo aginan nam7u tammanne laappunththa gallassan biittay mulera melides.<verse eid="GEN 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 8:15" />He wode Xoossi Nohe hizgi azazides, <verse eid="GEN 8:15" /><verse number="16" style="v" sid="GEN 8:16" />«Neni ne machcho, ne naytanne ne nayta machcheta ekkada markabezappe keza. <verse eid="GEN 8:16" /><verse number="17" style="v" sid="GEN 8:17" />Istti yeletti daridi corattana mala shemppora diza medheteththa ubbaafe nenara dizayta, kafota, meheta, do7atanne biittara gooshettizayta ubbaa nenara kessa» gides. <verse eid="GEN 8:17" /><verse number="18" style="v" sid="GEN 8:18" />Nohey ba naytara, ba machcheyranne ba nayta machchetara markabeza giddofe kezides. <verse eid="GEN 8:18" /><verse number="19" style="v" sid="GEN 8:19" />Mehey, do7ay, biittara gooshettiza medheteththi, kafoynne biitta bollan woxxi qaaxxiza miishshi wuri ba qommon qommon markabeza giddofe kezides.<verse eid="GEN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 8:20" />Hessafe guye Nohey GODAAS yarshizaso keelidi geeshsha mehe ubbaafenne geeshsha kafo ubbaafe ekkidi yarshizason xuuggidi yarshides.<figure style="fig" alt="Noah Alter" file="LB00255B.TIF" size="span" ref="8:20">Nohey GODAAS giigsida yarshosoho</figure> <verse eid="GEN 8:20" /><verse number="21" style="v" sid="GEN 8:21" />Histtiin GODAY yarshoza peeno sawizayssa singidi ba wozinan, «Yelagateththafe doommiin asi wozinan qoppizayssi wuri iita gidikkoka tani asa gishshas gaada nam7anththo mulekka ha biitta qanggike. Qasse tani ha7i ooththida mala paxa diza medheteth ubbaa nam7anththo mulekka dhayssike. <verse eid="GEN 8:21" /><verse number="22" style="v" sid="GEN 8:22" />Ha biittay diza wode ubbaan zereththa wodeynne maxa wodey mooceynne hombey, boneynne balgoy, gallassinne qammay ubba wodekka paccenna» gides.<verse eid="GEN 8:22" /></para>
  <chapter eid="GEN 8" />
  <chapter number="9" style="c" sid="GEN 9" />
  <para style="s1">Xoossi Nohera Gelida Caaqo Qaala</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1" />Xoossi Nohenne iza nayta, «Yelettite; corattite; biitta ubbaa kumite.<note caller="-" style="x"><char style="xo" closed="false">9:1 </char><char style="xt" closed="false"><ref loc="GEN 1:28">Medhe 1:28</ref></char></note> <verse eid="GEN 9:1" /><verse number="2" style="v" sid="GEN 9:2" />Biitta do7ati, kafoti, biittan woxxi qaaxxiza miishshatinne abba giddon diza moleti wuri inttes yayettonne dagammetto; istti intte shenen detto. <verse eid="GEN 9:2" /><verse number="3" style="v" sid="GEN 9:3" />Ta inttes biittafe mokkiza dumma dumma kaththata immida malakka shemppora paxa diza medheteththati wuri inttes quma gidana. <verse eid="GEN 9:3" /><verse number="4" style="v" sid="GEN 9:4" />Shemppoy suuththa giddon diza gishshas suuththi izappe gukkontta asho moopite.<note caller="-" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="LEV 7:26-27">Lewe 7:26-27</ref>; <ref loc="LEV 17:1-16">17:1-16</ref>; <ref loc="LEV 19:26">19:26</ref>; <ref loc="DEU 12:16">Zaare 12:16</ref>,<ref loc="DEU 12:23">23</ref>; <ref loc="DEU 15:23">15:23</ref></char></note> <verse eid="GEN 9:4" /><verse number="5" style="v" sid="GEN 9:5" />Tani intte shemppoy izan diza intte suuth meheppenne do7a ubbaafe tumu ta oychchana; qasse asa ubbaafekka iza mala asa suuth oychchana. <verse eid="GEN 9:5" /><verse number="6" style="v" sid="GEN 9:6" />Xoossi as bana misatissidi medhdhida gishshas asa suuth gussiza oonakka gidikko iza suuththika asa kushen gukkana.<note caller="-" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="GEN 1:26">Medhe 1:26</ref>; <ref loc="EXO 20:13">Kessa 20:13</ref></char></note> <verse eid="GEN 9:6" /><verse number="7" style="v" sid="GEN 9:7" />Intte yelettite; corattitenne; biitta bolla keehi darite» gi anjjides.<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="GEN 1:28">Medhe 1:28</ref></char></note><verse eid="GEN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8" />Hessafe guye Xoossi Nohenne izara diza iza nayta hizgides; <verse eid="GEN 9:8" /><verse number="9-10" style="v" sid="GEN 9:9-10" />«Histtiin ha7i tani ta caaqo inttenara, inttefe guye intte zereththaranne nenara shemppora diza medheteththatara caaqettadis; ee! Tani ta caaqo kafora, mehera, biitta do7a ubbaaranne markabeppe inttenara kezida paxa diza medheteth ubbaara caaqettadis. <verse eid="GEN 9:9-10" /><verse number="11" style="v" sid="GEN 9:11" />Tani inttenara caaqettadis; hayssafe sinththan paxa dizay wuri dhayssiza haaththan mulekka dhayenna; ha biittaa dhayssiza haaththi hayssafe guye mulekka deenna» gides.<verse eid="GEN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 9:12" />Qasseka Xoossi, «Tani taappenne inttefe, inttenara diza paxa medheteththatas ubbaafe giddon yaana yeleta ubbaara caaqettiza caaqozas malatay hayssa; <verse eid="GEN 9:12" /><verse number="13" style="v" sid="GEN 9:13" />tani ta zuulla salo bolla essana; izi taappenne ha biitta bolla diza medheteththafe giddon diza caaqozas malata gidana. <verse eid="GEN 9:13" /><verse number="14" style="v" sid="GEN 9:14" />Tani biittafe bollan shaara ehida wodenne shaara bollan zuullay beettida wode, <verse eid="GEN 9:14" /><verse number="15" style="v" sid="GEN 9:15" />‹Paxa diza medheteth ubbaa dhayssanaas hayssafe sinththan mulekka dhayssa haaththi yeenna› gaada taappenne inttefe paxa diza dumma dumma qommo medheteththata ubbaafe giddon caaqqida ta qaalaa ta qoppana. <verse eid="GEN 9:15" /><verse number="16" style="v" sid="GEN 9:16" />Zuullay shaara bolla beettida wode aydekka tani iza beyada taappe Xoossaafenne ha biittaa bollan paxa diza dumma dumma qommo medheteththa ubbaafe giddon caaqo gelida mernaa caaqo qaalaa ta hassa7ana» gides.<verse eid="GEN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 9:17" />Xoossi Nohe, «Tani taappenne ha biitta bollan paxa diza ubbaafe giddon caaqqida caaqozas malatay hayssa» gides.<verse eid="GEN 9:17" /></para>
  <para style="s1">Nohenne Iza Nayta</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18" />Markabezappe kezida Nohe nayti Seeme, Kaamenne Yaafeete; Kaamey Kanaane aawa. <verse eid="GEN 9:18" /><verse number="19" style="v" sid="GEN 9:19" />Hayti heedzdzayka Nohe nayta; biitta ubbaan diza asay isttafe yelettides.<verse eid="GEN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 9:20" />Nohey goshshanchcha; izi woyne mith toketh oykkides. <verse eid="GEN 9:20" /><verse number="21" style="v" sid="GEN 9:21" />Issi gallas izi woyneppe oosettida cajje uyi maththottidi ba Dunkaaneza giddon paxa kallo ichchides. <verse eid="GEN 9:21" /><verse number="22" style="v" sid="GEN 9:22" />Kanaane aawa Kaamey ba aawaa kalloteth be7idi kare kezidi ba ishata nam7atas yootides. <verse eid="GEN 9:22" /><verse number="23" style="v" sid="GEN 9:23" />Gido attiin Seemeynne Yaafeetey may7o ekkidi nam7ayka ba hashe hashe bolla gaththi oykkidi gundiguth hemetti gelidi ba aawa kalloteth kammida; istti ba aawaa kalloteth be7ontta mala ba ayfeso guye zaarida.<verse eid="GEN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 9:24" />Nohey maththoy aadhdhiin beeggidi ubbaafe kaalo naazi ba bolla ooththidayssa eridi,<verse eid="GEN 9:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="GEN 9:25" />«Kanaaney qanggettidaaz gido!</para>
  <para style="q2" vid="GEN 9:25">Izi ba ishata aylletas</para>
  <para style="q2" vid="GEN 9:25">aylle gido!» gides.<verse eid="GEN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 9:26" />Qasseka Nohey,</para>
  <para style="q1" vid="GEN 9:26">«GODAY, Seeme Xoossi galatetto!</para>
  <para style="q2" vid="GEN 9:26">Kanaaney Seeme aylle gido!<verse eid="GEN 9:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 9:27" />Xoossi Yaafeete biitta aasso!</para>
  <para style="q2" vid="GEN 9:27">Yaafeete<note caller="+" style="f"><char style="fr" closed="false">9:27 </char><char style="fqa" closed="false">Yaafeete: </char><char style="ft" closed="false">Yaafeete guussi aasso guussa misatees.</char></note> zereththati</para>
  <para style="q2" vid="GEN 9:27">Seeme zereththatara detto!</para>
  <para style="q2" vid="GEN 9:27">Kanaaney Yaafeete</para>
  <para style="q2" vid="GEN 9:27">aylle gido!» gides.<verse eid="GEN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 9:28" />Dhayssa haaththafe guye Nohey 350 layth de7ides. <verse eid="GEN 9:28" /><verse number="29" style="v" sid="GEN 9:29" />Nohey mulera 950 layth deyidi hayqqides.<verse eid="GEN 9:29" /></para>
  <chapter eid="GEN 9" />
  <chapter number="10" style="c" sid="GEN 10" />
  <para style="s1">Nohe Nayta Zereththata</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1" />Nohe nayta, Seeme, Kaamenne Yaafeete yeletay hayssafe kaalli xaafettidayssa; dhayssa haaththaafe guye isttas attuma nayti yelettida.<verse eid="GEN 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 10:2" />Yaafeete attuma nayti Goomere, Maagooge, Maadaye, Yaawaane, Tubaale, Mesheekenne Tiraase, <verse eid="GEN 10:2" /><verse number="3" style="v" sid="GEN 10:3" />Goomere attuma nayti Ashkenaaze, Irafaatenne Togarma. <verse eid="GEN 10:3" /><verse number="4" style="v" sid="GEN 10:4" />Yaawaane attuma nayti Elishe, Tarseese, Kiitimenne Eroode.<note caller="+" style="f"><char style="fr" closed="false">10:4 </char><char style="ft" closed="false">Tarseese geetettizaara ha7i wode Ispeene geetettawus; Kiitime geetettizaara ha7i wode Qophiroose geetettawus; Eroode geetettizaara ha7i wode Eroode geetettiza harurota derekko</char></note> <verse eid="GEN 10:4" /><verse number="5" style="v" sid="GEN 10:5" />Haytanttafe abba doonan diza asay wuri ba biittan biittan, ba qaalan qaalan, ba qommon qommoninne, ba kawoteththan kawoteththan shaakettides.<verse eid="GEN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 10:6" />Kaame attuma nayti Kuushe, Gibxe, Puuxenne Kanaane.<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="ft" closed="false">Puuxe geetettizaara ha7i wode Liibiya geetettawus</char></note><verse eid="GEN 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 10:7" />Kuushe attuma nayti Seeba, Hawila, Saabite, Eraa7imenne Sabiteka.</para>
  <para style="p" vid="GEN 10:7">Eraa7ime attuma nayti Saabanne Dadaane.<verse eid="GEN 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 10:8" />Kuushey Namuruude yelides; Namuruudey biitta bollan koyro wolqqama olanchcha gidides; <verse eid="GEN 10:8" /><verse number="9" style="v" sid="GEN 10:9" />GODAA sinththankka izi wolqqama shankkanchcha gidides; hessa gishshas, «Namuruude mala GODAA sinththan wolqqama shankkanchcha gida» geetettees. <verse eid="GEN 10:9" /><verse number="10" style="v" sid="GEN 10:10" />Iza kawoteththan koyro katamati Sana7oore biittan diza Baabiloone, Ereeke, Akkaadenne Kalanahe. <verse eid="GEN 10:10" /><verse number="11-12" style="v" sid="GEN 10:11-12" />Izi he biittaafe Asoore biidi Nannawe, Erahoobotenne Kaalahe katamata ooththides; qasse Nannaweppenne Kaalaheppe giddon diza Ereseene geetettiza gita katamakka ooththides.<verse eid="GEN 10:11-12" /></para>
  <para style="p">
    <verse number="13-14" style="v" sid="GEN 10:13-14" />Gibxey Luudimeta, Anaameta, Lahaabeta, Naftuheta, Phaxirooseta, Kaasiluhetanne Filisxeemeta yelida Kaftooreta aawa. <verse eid="GEN 10:13-14" /><verse number="15-16" style="v" sid="GEN 10:15-16" />Kanaaney ba bayra naaza Sidoona, Keexeta, Yaabuseta, Amooreta, Gergeseta aawa; <verse eid="GEN 10:15-16" /><verse number="17" style="v" sid="GEN 10:17" />qasseka Hiiweta, Arqeta, Siineta, <verse eid="GEN 10:17" /><verse number="18" style="v" sid="GEN 10:18" />Arwaadeta, Xamaaretanne Hamaateta aawa. Hessafe guye Kanaane zereththati biitta bolla laalettida.<verse eid="GEN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 10:19" />Kanaane biitta zaway Sidoonappe doommidi Geraarenne Gaazara kanththidi, Sodoomenne Gamoora, Adaamanne Xaboyme kanththi biidi Lasha7ere gakkees. <verse eid="GEN 10:19" /><verse number="20" style="v" sid="GEN 10:20" />Kaame attuma nayti ba qommon qommon, ba qaalan qaalan, ba biittan biittaninne ba kawoteththan kawoteththan xaafettidayti haytantta.<verse eid="GEN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 10:21" />Seemes nayti yelettida; izi Yaafeetes bayra ishanne Eboore nayta ubbaas mayza. <verse eid="GEN 10:21" /><verse number="22" style="v" sid="GEN 10:22" />Seeme attuma nayti Elaame, Asoore, Arfaakiside, Luudenne Aaraame.<verse eid="GEN 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 10:23" />Aaraame attuma nayti Uuxe, Huule, Geterenne Meeshe.<verse eid="GEN 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 10:24" />Arfaakisidey Sheelahe yelides. Sheelahey Eboore yelides.<verse eid="GEN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 10:25" />Eboores nam7u attuma nayti yelettida; biittan diza asay iza woden shaakettida gishshas issaa sunththi Peeleege<note caller="+" style="f"><char style="fr" closed="false">10:25 </char><char style="ft" closed="false">Peeleege guussi Ibraaweta qaalara shaaketeth guussa</char></note> geetettides; iza ishaza sunththi Yoqixaane geetettees.<verse eid="GEN 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 10:26" />Yoqixaaney nayta yelides; isttika Almodaade, Shelefe, Haxarmaawete, Yerahe, <verse eid="GEN 10:26" /><verse number="27" style="v" sid="GEN 10:27" />Hadoraame, Uzaale, Diiqile, <verse eid="GEN 10:27" /><verse number="28" style="v" sid="GEN 10:28" />Oobaale, Abima7eele, Saaba, <verse eid="GEN 10:28" /><verse number="29" style="v" sid="GEN 10:29" />Ofire, Hawilanne Yobaabe; haytanti wurikka Yoqixaane attuma nayta.<verse eid="GEN 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 10:30" />Istti de7ida biittay arshey mokkiza baggara diza zuma Meesheppe biidi Safaare gakkees. <verse eid="GEN 10:30" /><verse number="31" style="v" sid="GEN 10:31" />Seeme attuma nayti ba qommon qommon, ba qaalan qaalan, ba biittan biittaninne ba kawoteththan kawoteththan xaafettidayti haytantta.<verse eid="GEN 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 10:32" />Haytanti ba qommon qommoninne ba kawoteththan kawoteththan xaafettida Nohe attuma nayta zereththata; dhayssa haaththafe simmiin kawoteththati haytanttafe biitta ubbaa bolla laalettida.<verse eid="GEN 10:32" /></para>
  <chapter eid="GEN 10" />
  <chapter number="11" style="c" sid="GEN 11" />
  <para style="s1">Baabiloone Gimbe</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1" />Biitta bollan diza asi wuri koyro issi doonanne issi qaala haasayees. <verse eid="GEN 11:1" /><verse number="2" style="v" sid="GEN 11:2" />Asay arshey mokkiza bagga simmidi bishe Sana7oore geetettiza biittan issi dembaso demmidi heen uttides.<verse eid="GEN 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 11:3" />Istti issoy issaa, «Haa yiite; xuube medhdhidi ane taman xuuggoos» giidi istta shuchcha gishshas xuube, urqqa gishshas shida <verse eid="GEN 11:3" /><verse number="4" style="v" sid="GEN 11:4" />ekkidi, «Haa yiite! Nu sunth xeygisanaassinne qasse nuni ha biitta ubbaa bollan laalettontta mala issi gita katamanne xeeray pude salo gakkiza issi gimbe ane keexxoos» gida.<verse eid="GEN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 11:5" />Gido attiin GODAY asay keexxida gita katamazanne gimbeza beyanaas duge wodhdhidi, <verse eid="GEN 11:5" /><verse number="6" style="v" sid="GEN 11:6" />«Hekko istti issi asa! Qasse istti wurikka issi qaalan haasayeettes; istti ha7i hayssa ooso oykkidaappe guye, istti baas ooththanaas qoppidayssa istta digganay deenna. <verse eid="GEN 11:6" /><verse number="7" style="v" sid="GEN 11:7" />Haa yiite! Ane nu duge wodhdhidi istti issoy issaa qaala erontta mala istta qaala walakkoos» gides. <verse eid="GEN 11:7" /><verse number="8" style="v" sid="GEN 11:8" />Hessa gishshas GODAY istta hessafe biitta ubbaa bollan laalliin istti he gita katama ooththizayssa aggaagida. <verse eid="GEN 11:8" /><verse number="9" style="v" sid="GEN 11:9" />GODAY biitta asaa qaalaa heen walakkida gishshas he katamaya Baabile<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="fqa" closed="false">Baabile: </char><char style="ft" closed="false">Baabile guussi Ibraaweta qaalara birsheththi baynda haasaya.</char></note> geetettadus. GODAY istta hessafe biitta ubbaa bollan laallides.<verse eid="GEN 11:9" /></para>
  <para style="s1">Seeme Zereth</para>
  <para style="r">(<ref loc="1CH 1:24-27">1Taari 1:24-27</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10" />Seeme zereththi hayssafe kaallidi xaafettidayssa; dhayssa haaththi simmiin nam7u layththafe guye Seemes layththay 100 gidiin Seemey Arfaakiside yelides. <verse eid="GEN 11:10" /><verse number="11" style="v" sid="GEN 11:11" />Seemey Arfaakiside yelidaappe guye 500 layth de7ides; hara attuma naytakka macca naytakka yelides.<verse eid="GEN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 11:12" />Arfaakisidey 35<note caller="+" style="f"><char style="fr" closed="false">11:12 </char><char style="ft" closed="false">35 gizayssa Ibraaweta maxaafan laappun tammu eranchchati 135 geettes.</char></note> layth de7idi Sheelahe yelides; <verse eid="GEN 11:12" /><verse number="13" style="v" sid="GEN 11:13" />Arfaakisidey Sheelahe yelidaappe guye 403 layth de7ides; hara attuma naytanne macca naytakka yelides.<verse eid="GEN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 11:14" />Sheelahey 30<note caller="+" style="f"><char style="fr" closed="false">11:14 </char><char style="ft" closed="false">30 gizayssa Ibraaweta maxaafan laappun tammu eranchchati 130 geettes.</char></note> layth de7idi Eboore yelides; <verse eid="GEN 11:14" /><verse number="15" style="v" sid="GEN 11:15" />Sheelahey Eboore yelidaappe guye 403 layth de7ides; hara attuma naytanne macca nayta yelides.<verse eid="GEN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 11:16" />Eboorey heedzdzu tammanne oyddu<note caller="+" style="f"><char style="fr" closed="false">11:16 </char><char style="ft" closed="false">heedzdzu tammanne oyddu gizayssa Ibraaweta maxaafan laappun tammu eranchchati 134 geettes.</char></note> layth de7idi Peeleege yelides; <verse eid="GEN 11:16" /><verse number="17" style="v" sid="GEN 11:17" />Eboorey Peeleege yelidaappe guye 430 layth de7ides; hara attuma naytanne macca nayta yelides.<verse eid="GEN 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 11:18" />Peeleegey 30 layth de7idi Era7e yelides; <verse eid="GEN 11:18" /><verse number="19" style="v" sid="GEN 11:19" />Peeleegey Era7e yelidaappe guye 209 layth de7ides; hara attuma naytanne macca nayta yelides.<verse eid="GEN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 11:20" />Era7ey 32 layth de7idi Saruge yelides; <verse eid="GEN 11:20" /><verse number="21" style="v" sid="GEN 11:21" />Era7ey Saruge yelidaappe guye 207 layth de7ides; hara attuma naytanne macca nayta yelides.<verse eid="GEN 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 11:22" />Sarugey 30 layth de7idi Naakoore yelides; <verse eid="GEN 11:22" /><verse number="23" style="v" sid="GEN 11:23" />Sarugey Naakoore yelidaappe guye 200 layth de7ides; hara attuma naytanne macca nayta yelides.<verse eid="GEN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 11:24" />Naakoorey 29<note caller="+" style="f"><char style="fr" closed="false">11:24 </char><char style="ft" closed="false">29 gizayssa Ibraaweta maxaafan laappun tammu eranchchati 109 geettes.</char></note> layth de7idi Taara yelides. <verse eid="GEN 11:24" /><verse number="25" style="v" sid="GEN 11:25" />Naakoorey Taara yelidaappe guye 119 layth de7ides; hara attuma naytanne macca nayta yelides.<verse eid="GEN 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 11:26" />Taaray 70 layth de7idi Abraame, Naakoorenne Haaraane yelides.<verse eid="GEN 11:26" /></para>
  <para style="s1">Taara Zereth</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27" />Taara yeletay hayssafe kaallidi xaafettidayssa; Taaray Abraame, Naakoorenne Haaraane yeliin Haaraaney Looxe yelides. <verse eid="GEN 11:27" /><verse number="28" style="v" sid="GEN 11:28" />Haaraaney ba aaway Taaray paxa dishin ba yelettida Kaladaaweta biittan Uure geetettiza gita katamaan hayqqides. <verse eid="GEN 11:28" /><verse number="29" style="v" sid="GEN 11:29" />Abraameynne Naakoorey nam7ayka machchida; Abraame machchey sunththi Soora; qasse Naakoore machchey sunththi Milka; Milkay Haaraane naa; Haaraaney Milkissinne Yiskaanissi aawa. <verse eid="GEN 11:29" /><verse number="30" style="v" sid="GEN 11:30" />Sooray maynne; izis nay baawa.<verse eid="GEN 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 11:31" />Taaray ba naa Abraame, ba naaza Haaraane naa Looxenne ba naa Abraame machcho Soora ekkidi keziin istti issife Kanaane biitta baanaas Uure geetettiza Kaladaaweta katamappe dendida; gido attiin istti Kaaraane geetettiza katama gakkanaas biidi heen de7ida. <verse eid="GEN 11:31" /><verse number="32" style="v" sid="GEN 11:32" />Taaray 205 layth de7idi Kaaraanen hayqqides.<verse eid="GEN 11:32" /></para>
  <chapter eid="GEN 11" />
  <chapter number="12" style="c" sid="GEN 12" />
  <para style="s1">Abraame Xeygeteth</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1" />GODAY Abraame, «Ne dereppe, ne dabbotappenne ne aawa keeththa asaappe shaakettada tani nena bessiza biitta ba.<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="ACT 7:2-3">Hawa 7:2-3</ref>; <ref loc="HEB 11:8">Ib 11:8</ref></char></note><verse eid="GEN 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="GEN 12:2" />«Tani nena</para>
  <para style="q2" vid="GEN 12:2">gita kawoteth ooththana;</para>
  <para style="q2" vid="GEN 12:2">qasseka anjjana;</para>
  <para style="q2" vid="GEN 12:2">Ne sunththaa gitasana;</para>
  <para style="q2" vid="GEN 12:2">nekka haratas anjjo gidana.<verse eid="GEN 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 12:3" />Nena anjjizayta ta anjjana;</para>
  <para style="q2" vid="GEN 12:3">nena qanggizaytakka</para>
  <para style="q2" vid="GEN 12:3">ta qanggana;</para>
  <para style="q2" vid="GEN 12:3">biitta bolla diza asi wuri</para>
  <para style="q2" vid="GEN 12:3">ne baggara anjjettana» gides.<note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="GAL 3:8">Gala 3:8</ref></char></note><verse eid="GEN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 12:4" />Abraamey GODAY izas yootida mala dendi bides; Looxeykka izara bides; Abraamey Kaaraane dereppe bishin izas layththay laapun tammanne ichchasha. <verse eid="GEN 12:4" /><verse number="5" style="v" sid="GEN 12:5" />Abraamey ba machchiyo Soora, ba isha naa Looxe, Kaaraanen istti demmida aylletanne heen shiishshida bantta aqota ubbaa ekkidi Kanaane biitta bides.<verse eid="GEN 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 12:6" />Abraamey he biittan Seekeemen Moore geetettizason diza gita miththaako gakkanaas bides; he wode Kanaane asati he biittan deettes. <verse eid="GEN 12:6" /><verse number="7" style="v" sid="GEN 12:7" />GODAY Abraames qonccidi, «Ha biittaa tani ne zereththas immana» gides; izi baas qonccida GODAAS he sohon yarsho yarshizaso keexxidi goynnides.<note caller="-" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="ACT 7:5">Hawa 7:5</ref>; <ref loc="GAL 3:16">Gala 3:16</ref></char></note> <verse eid="GEN 12:7" /><verse number="8" style="v" sid="GEN 12:8" />Hessafe dendidi Beeteleppe arshey mokkiza baggara diza zumatizaso biidi heen Beetele arshey wulliza baggan aggidi qasse Aye geetettiza katama arshey mokkiza bagga aggidi giddon ba dunkaane tolides; heenkka GODAAS yarsho yarshizaso keexxidi GODAA sunththaa xeygides. <verse eid="GEN 12:8" /><verse number="9" style="v" sid="GEN 12:9" />Hessafe guye Abraamey heeppe dendi biidi Negebe<note caller="+" style="f"><char style="fr" closed="false">12:9 </char><char style="ft" closed="false">Negebe geetettizayssi Ibraaweta qaalara Dugeha bagga dere guussa</char></note> geetettiza bazzo gakkides.<verse eid="GEN 12:9" /></para>
  <para style="s1">Gibxe Abraame Buus</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10" />He wode Kanaane biittan koshay dendiin koshazi keehi iita gidida gishshas Abraamey kosha wode aaththanaas duge Gibxe wodhdhides. <verse eid="GEN 12:10" /><verse number="11" style="v" sid="GEN 12:11" />Gibxe gelana hanishin Abraamey ba machchiyo Soora, «Siya! Ne daro mala lo7o maccas gididayssa ta erays. <verse eid="GEN 12:11" /><verse number="12" style="v" sid="GEN 12:12" />Gibxe asay nena be7iza wode isttas, ‹Hanna iza machcho› giidi nena aggidi tana wodhana. <verse eid="GEN 12:12" /><verse number="13" style="v" sid="GEN 12:13" />Hessa gishshas istti taas ne gaason kiyana malanne qasse ne gaason ta hayqqontta attana mala neni, ‹Ta izas michcho› ga» gides.<note caller="-" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="GEN 20:2">Medhe 20:2</ref>; <ref loc="GEN 26:7">26:7</ref></char></note><verse eid="GEN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 12:14" />Abraamey Gibxe biitta gelida wode Gibxe asati he maccassaya daro mala lo7o maccas gididayssa be7ida. <verse eid="GEN 12:14" /><verse number="15" style="v" sid="GEN 12:15" />Qasse Gibxe kawos ooththiza halaqatikka izo be7idi kawo sinththan izo nashshida; histtidi izo kawoso efida. <verse eid="GEN 12:15" /><verse number="16" style="v" sid="GEN 12:16" />Histtiin izi geedon kawoy Abraame lo7o ayfen xeellidi Abraames dorsatanne boorata, adde haretanne macca hareta, adde aylletanne macca aylleta, gaamellatakka immides.<verse eid="GEN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 12:17" />Gido attiin GODAY Abraame machcheyo Soora geedon Gibxe kawo bollanne izaso asaa bolla bosha yeddides. <verse eid="GEN 12:17" /><verse number="18" style="v" sid="GEN 12:18" />Histtiin kawozi Abraame xeygidi, «Neni hayssa ays ta bolla ooththadii? Iza ne machcho gididayssa ays taas yootabeekkii? <verse eid="GEN 12:18" /><verse number="19" style="v" sid="GEN 12:19" />Ta izo machcho ekkana mala, ‹Iza ta michcho› gaada aazas wordotadii? Hekko hanno ne machcheyo ekkada ba!» gides. <verse eid="GEN 12:19" /><verse number="20" style="v" sid="GEN 12:20" />Kawozikka ba aylleta Abraame iza machcheyranne izas dizaaz ubbaa kessidi yeddana mala azaziin aylleti istta dereppe kessi yeddida.<verse eid="GEN 12:20" /></para>
  <chapter eid="GEN 12" />
  <chapter number="13" style="c" sid="GEN 13" />
  <para style="s1">Abraamenne Looxe Shaaketeth</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1" />Hessa gishshas Abraamey ba machcheyranne baas dizaaz ubbaara Gibxeppe Negebe bazzo bides; Looxeykka izara bides. <verse eid="GEN 13:1" /><verse number="2" style="v" sid="GEN 13:2" />Abraamey he wode mehen, biraninne worqqan daro duretides.<verse eid="GEN 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 13:3" />Izi Negebeppe dendidi Beetele gakkanaas bides; Beeteleppenne Ayeppe giddon diza dere bides; hesoykka izi koyro ba dunkaane tolidi, <verse eid="GEN 13:3" /><verse number="4" style="v" sid="GEN 13:4" />yarsho shiishshanaas keexxidaso; heenkka Abraamey GODAA sunth xeygides.<verse eid="GEN 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 13:5" />Abraamera yuuyiza Looxeska daro miizi, dorsi, deyshinne dunkaaney dees. <verse eid="GEN 13:5" /><verse number="6" style="v" sid="GEN 13:6" />Gido attiin isttas daro mehey diza gishshassinne istti issife daanaas isttas biittay xuummida gishshas issife daanaas dandaybeettenna. <verse eid="GEN 13:6" /><verse number="7" style="v" sid="GEN 13:7" />Hessa geedon Abraame wude heemmizayta giddoninne Looxe wude heemmizayta giddon ooshshi medhettides; he wode Kanaanetinne Paarizeti he biittan deettes.<verse eid="GEN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 13:8" />Histtiin Abraamey Looxes, «Nuni ishantta gidida gishshas, nu giddon, ta mehe heemmizayta giddoninne ne mehe heemmizayta giddon oosh medhdhofa. <verse eid="GEN 13:8" /><verse number="9" style="v" sid="GEN 13:9" />Biittay wuri ne sinththan deennee? Ane nuni shaakettoos; neni hadirsa bagga biikko, tani ushachcha bagga baana; neni ushachcha bagga biikko tani hadirsa bagga baana» gides.<verse eid="GEN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 13:10" />Looxey yuuyi aadhdhi xeellidi Yordaanoose shoobbay biidi Zo7aare gakkanaas GODAA gannate woykko Gibxe biitta mala daro haaththi dizayssa be7ides. (Hessika GODAY Sodoomenne Gamoora geetettiza katamata dhayssanaappe kase.)<note caller="-" style="x"><char style="xo" closed="false">13:10 </char><char style="xt" closed="false"><ref loc="GEN 2:10">Medhe 2:10</ref></char></note> <verse eid="GEN 13:10" /><verse number="11" style="v" sid="GEN 13:11" />Hessa gishshas Looxey baas Yordaanoose shoobba ubbaa dooridi arshey mokkiza baggara bida gishshas istti ba garsan shaakettida. <verse eid="GEN 13:11" /><verse number="12" style="v" sid="GEN 13:12" />Abraamey Kanaane biittan de7ides; Looxey gidikko shoobban diza gita katamata giddon uttidi Sodoome katama matan ba Dunkaaneza tolides. <verse eid="GEN 13:12" /><verse number="13" style="v" sid="GEN 13:13" />He wode Sodoome asay iitanne GODAA sinththan pala nagara ooththizayta.<verse eid="GEN 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14" />Looxey Abraameppe shaakettidaappe guye GODAY Abraame, «Dhoqqu gaada neni dizasoppe arshey mokkiza bagganne geliza bagga qasse dugeha bagganne pudeha bagga xeella. <verse eid="GEN 13:14" /><verse number="15" style="v" sid="GEN 13:15" />Hayssa neni xeelliza biitta ubbaa ta neessinne ne zereththas mernaas immana.<note caller="-" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="ACT 7:5">Hawa 7:5</ref></char></note> <verse eid="GEN 13:15" /><verse number="16" style="v" sid="GEN 13:16" />Tani ne zereth biitta ace mala darsana; oonikka biitta ace taybana dandaykko ne zereththika taybettana. <verse eid="GEN 13:16" /><verse number="17" style="v" sid="GEN 13:17" />Dendada biitta bolla pudenne duge, yaanne ha yuuya xeella; gaasoykka tani hayssa biittaa nees immana» gides.<verse eid="GEN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 13:18" />Histtiin Abraamey ba Dunkaaneza shoddidi, Kebroonen Mamire geetettizason diza gita miththaa achchan de7anaas bides. Heenkka GODAAS yarsho yarshizaso keexxides.<verse eid="GEN 13:18" /></para>
  <chapter eid="GEN 13" />
  <chapter number="14" style="c" sid="GEN 14" />
  <para style="s1">Abraamey Looxe Woththi Eko</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1" />He wode Sana7oore Kawoy Amiraafeeley, Eelaasaare kawoy Aryookey, Elaame kawoy Kadorlaa7oomereynne ayzaabe kawo Tidi7aaley oyddati, <verse eid="GEN 14:1" /><verse number="2" style="v" sid="GEN 14:2" />Sodoome kawo Beera7era, Gamoora kawo Birshara, Adaama kawo Shin7aabera, Xaboyme kawo Shemebeereynne (Zo7aare geetettiza) Beela kawora olettanaas bida. <verse eid="GEN 14:2" /><verse number="3" style="v" sid="GEN 14:3" />Ha ichchashu kawoti gaaggidi issi bagga gididi, (Hayqo Abba geetettiza) Siddime shoobban shiiqida. <verse eid="GEN 14:3" /><verse number="4" style="v" sid="GEN 14:4" />Istti kase tammanne nam7u layth Kadorlaa7oomeres haarettida; gido attiin tammanne heedzdzanththo layththan iza bolla makkallida.<verse eid="GEN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 14:5" />Tammanne oydanththo layththan Kadorlaa7oomereynne izara zuppetida kawoti ba olanchchata ekki biidi, Astaroote-Qarnaymen diza Erafaymeta, Haaman diza Zuuzetanne Shaawe-Qiriyaataymen diza Eemime geetettiza dereta olidi xoonida. <verse eid="GEN 14:5" /><verse number="6" style="v" sid="GEN 14:6" />Hoore biitta asatakka Seyre zuma bolla olidi bazzo achchan diza Elparaane geetettizaso gakkanaas gooddida. <verse eid="GEN 14:6" /><verse number="7" style="v" sid="GEN 14:7" />Hessafe guye simmidi En-Mishipaaxe yida. (Ha7i he derey Qaadeese geetettees.) Istti Amaaleeqeta biitta qasse Haxaxoone Taamaare geetettizason diza Amoore asaa ubbaa olidi xoonida.<verse eid="GEN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 14:8" />Hessafe simmiin, Sodoome kawoy, Gamoora kawoy, Adaama kawoy, Xaboyme kawoynne (Zo7aare geetettiza) Beela kawoy dendidi Siidime shoobban olas salfida. <verse eid="GEN 14:8" /><verse number="9" style="v" sid="GEN 14:9" />Hayti wuri Elaame kawora, ayzaabeta kawora, Sana7oore kaworanne Eelaasaare kawora (ha ichchashu kawoti oyddu kawotara) olettida. <verse eid="GEN 14:9" /><verse number="10" style="v" sid="GEN 14:10" />He wode Siidime shoobban, shida oykkiza daro ollay dees. Sodoome kawoynne Gamoora kawoy ba ola asaara olappe baqatishin, isttafe guuththati he ollatan kundida; gido attiin attidayti pude zuma bolla baqatida. <verse eid="GEN 14:10" /><verse number="11" style="v" sid="GEN 14:11" />Oyddu kawoti Sodoomenne Gamoora katamata aqotanne miza kath ubbaa bonqqi ekki bida. <verse eid="GEN 14:11" /><verse number="12" style="v" sid="GEN 14:12" />Abraame isha nay Looxey, Sodoomen diza gishshas izakka iza aqotaakka ubbaa ekki bida.<verse eid="GEN 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 14:13" />Hessafe guye issi asi kessi ekkidi baqati yiidi Ibraawe Abraames hessa yootides; Abraamey he wode Eshkoolenne Aneere isha Amoore dere as Mamire wola achchan dees; istti wurikka ola zaaranaas Abraamera caaqettida. <verse eid="GEN 14:13" /><verse number="14" style="v" sid="GEN 14:14" />Abraamey ba dabboy di7ettidayssa siyida wode ola eriza bason yelettida heedzdzu xeetanne tammanne osppun asaa denththides; he oyddu kawota kaallidi Daane geetettiza katama gakkanaas bides. <verse eid="GEN 14:14" /><verse number="15" style="v" sid="GEN 14:15" />Heen omarsan ba asaa cugan cugan shaakkidi, ba morkketara olettidi xoonides; histtidi Damasqofe bolla baggara diza Hoobbe geetettizaso gakkanaas gooddides. <verse eid="GEN 14:15" /><verse number="16" style="v" sid="GEN 14:16" />Abraameykka ba dabbo Looxenne iza aqota ubbaa kase di7ettida maccassaanne hara asaakka woththi ekkides.<verse eid="GEN 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17" />Abraamey Kadorlaa7oomerenne izara zuppetida kawota xoonidi simmidaappe guye, Sodoome kawoy, (kawota shoobba geetettiza) Shaaweha shoobbaan iza mokkanaas kezides.<verse eid="GEN 14:17" /></para>
  <para style="s1">Malkexeedeqe Anjjo</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 14:18" />He wode, Saaleme kawoy Malkexeedeqey ukeththinne woyne ushshu ekki yides; izikka Ubbaafe Dhoqqa Xoossaa qeese. <verse eid="GEN 14:18" /><verse number="19" style="v" sid="GEN 14:19" />Izi Abraame hizgi anjjides;</para>
  <para style="q1" vid="GEN 14:19">«Ubbaafe Dhoqqa Xoossi</para>
  <para style="q2" vid="GEN 14:19">salonne sa7a medhdhidayssi</para>
  <para style="q2" vid="GEN 14:19">Abraame anjjo.<verse eid="GEN 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="GEN 14:20" />Qasse Ubbaafe Dhoqqa Xoossi,</para>
  <para style="q2" vid="GEN 14:20">Ne morkketa ne kushen</para>
  <para style="q2" vid="GEN 14:20">aaththi immidayssi</para>
  <para style="q2" vid="GEN 14:20">galatetto» gides.</para>
  <para style="m" vid="GEN 14:20">Abraamey ubbaafe tammaafe issi kushe kessidi Malkexeedeqes immides.<note caller="-" style="x"><char style="xo" closed="false">14:18-20 </char><char style="xt" closed="false"><ref loc="HEB 7:1-10">Ib 7:1-10</ref></char></note><verse eid="GEN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 14:21" />Sodoome kawoy Abraame, «Ta asaa taas zaarada ne di7ida meheza ubbaa nees ekka» gides.<verse eid="GEN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 14:22" />Gido attiin Abraamey Sodoome kawo, «Tani GODAAS, Ubbaafe Dhoqqa Xoossaas, salonne sa7a medhdhidayssas, ta kushe denththada caaqqaychchadis. <verse eid="GEN 14:22" /><verse number="23-24" style="v" sid="GEN 14:23-24" />Ta asay midayssafenne tanara bida Aneere, Eshkoolenne Mamire gakkizayssafe attiin neni, ‹Abraame tani duresadis gontta mala tani neyssafe haray atto issi miish woykko caamma kirekka ta ekkike; istti bana gakkizayssa ekketto› gees» gides.<verse eid="GEN 14:23-24" /></para>
  <chapter eid="GEN 14" />
  <chapter number="15" style="c" sid="GEN 15" />
  <para style="s1">Xoossay Abraames Gelida Caaqo Qaala</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1" />Hessafe guye GODAA qaalay ajjuutan Abraamekko yiidi, «Abraame, babbofa! Tani nees gondalle; ne anjjoy keehi gita» gides.<verse eid="GEN 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 15:2" />Abraamey, «Abeet Ubbaa Haariza GODAWU! Taas mulekka nay baynda gishshas neni immiza imotay taas ayssee? Damasqo dere as El7ezeerey tana laattana» gides. <verse eid="GEN 15:2" /><verse number="3" style="v" sid="GEN 15:3" />Qasseka Abraamey, «Neni taas aykko naa immabeekka; hessa gishshas tason diza aylley tana laattanaas dees» gides.<verse eid="GEN 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 15:4" />GODAA qaalay izakko yiidi, «Hayssi aylley nena laattenna; neeppe yelettiday nena laattana» gides. <verse eid="GEN 15:4" /><verse number="5" style="v" sid="GEN 15:5" />Hessafe guye GODAY Abraame kare kessidi, «Pude salo xeella; neni xoolintteta taybanaas dandaykko tayba; ne zereththayka hayssa mala gidana» gides.<note caller="-" style="x"><char style="xo" closed="false">15:5 </char><char style="xt" closed="false"><ref loc="ROM 4:18">Oro 4:18</ref>; <ref loc="HEB 11:12">Ib 11:12</ref></char></note><verse eid="GEN 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 15:6" />Abraameykka GODAA ammanides; iza ammanoykka Xilloteththan qoodettides.<note caller="-" style="x"><char style="xo" closed="false">15:6 </char><char style="xt" closed="false"><ref loc="ROM 4:3">Oro 4:3</ref>; <ref loc="GAL 3:6">Gala 3:6</ref>; <ref loc="JAS 2:23">Yaaqo 2:23</ref></char></note><verse eid="GEN 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 15:7" />Qasseka GODAY iza, «Ne hayssa biittaa laattana mala ta nees immanaas Uure geetettiza Kaladaaweta katamappe nena kessa ehida GODAY tana diikkinaa?» gides.<verse eid="GEN 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 15:8" />Gido attiin Abraamey iza, «Abeet Ubbaa Haariza GODAWU! Tani hayssa biittaa laattanayssa aazan eroo?» gides.<verse eid="GEN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 15:9" />GODAYKKA iza, «Heedzdzu layththa us, heedzdzu layththa deysh, heedzdzu layththa dorsa laaqqanne nam7u qommo haraphpheta taas ekka ya» gides. <verse eid="GEN 15:9" /><verse number="10" style="v" sid="GEN 15:10" />Izi heyta ubbata izas ekki efi shukkidi giddon nam7u nam7u kessi shaakkidi issaa issaa ginan woththides; gido attiin kafota nam7u kessibeenna. <verse eid="GEN 15:10" /><verse number="11" style="v" sid="GEN 15:11" />He wode ankko kafoti he ashoza bolla uttiin Abraamey istta gooddides.<verse eid="GEN 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 15:12" />Arshey wulliza wode Abraame wolqqama dhiskoy oykkiin daganththiza girdi gida dhumay iza bolla dhumides.<note caller="-" style="x"><char style="xo" closed="false">15:12 </char><char style="xt" closed="false"><ref loc="JOB 4:13-14">Iyo 4:13-14</ref></char></note> <verse eid="GEN 15:12" /><verse number="13" style="v" sid="GEN 15:13" />Histtiin GODAY izas, «Ne zereththay hara biittan bete gidi daanayssa neni tumappe era; istti aylletidi 400 layth yedhetti haarettana.<note caller="-" style="x"><char style="xo" closed="false">15:13 </char><char style="xt" closed="false"><ref loc="EXO 1:1-14">Kessa 1:1-14</ref>; <ref loc="ACT 7:6">Hawa 7:6</ref></char></note> <verse eid="GEN 15:13" /><verse number="14" style="v" sid="GEN 15:14" />Ayllesidi istta haariza kawoteththaa ta qaxxayana; hessafe guye istti daro aqora he biittaafe kezana.<note caller="-" style="x"><char style="xo" closed="false">15:14 </char><char style="xt" closed="false"><ref loc="EXO 12:40-41">Kessa 12:40-41</ref>; <ref loc="ACT 7:7">Hawa 7:7</ref></char></note> <verse eid="GEN 15:14" /><verse number="15" style="v" sid="GEN 15:15" />Neni gidikko ne aawatakko saron baana; ne keeha cimmada hayqqananne moogettana. <verse eid="GEN 15:15" /><verse number="16" style="v" sid="GEN 15:16" />Oydanththo yeletan ne zereththay ha biitta simmana; ays giikko Amoore dere asaa nagaray buro kumontta gishshassa» gides.<verse eid="GEN 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 15:17" />Arshey wulliin gadey dhumidaappe guye cooce tama lacoynne cuway beettidi he nam7u nam7u kezi shaakettida ashota giddora kanththides. <verse eid="GEN 15:17" /><verse number="18" style="v" sid="GEN 15:18" />He gallas GODAY Abraames, «Gibxe shaafappe doommidi Efiraaxise geetettiza gita shaafaa gakkanaas ha biittaa tani ne zereththaas immadis.<note caller="-" style="x"><char style="xo" closed="false">15:18 </char><char style="xt" closed="false"><ref loc="ACT 7:5">Hawa 7:5</ref></char></note> <verse eid="GEN 15:18" /><verse number="19-21" style="v" sid="GEN 15:19-21" />Heytikka Qenaaweta, Qenaazeta, Qadimooneta, Hiiteta, Paarizeta, Erafaymeta, Amooreta, Kanaaneta, Gergesetanne Yaabuseta biitta» gi caaqqides.<verse eid="GEN 15:19-21" /></para>
  <chapter eid="GEN 15" />
  <chapter number="16" style="c" sid="GEN 16" />
  <para style="s1">Aggaaronne Isma7eele</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1" />Abraame machcheya Sooray izas ha7ikka naa yelabeekku; gido attiin izis Gibxeppe yida Aggaaro geetettiza issi aylleya dawus. <verse eid="GEN 16:1" /><verse number="2" style="v" sid="GEN 16:2" />Hessa gishshas Sooray Abraame xeygada, «Beya! GODAY tana yelo diggides. Neni baada, ta aylleyra aqa; oonee erizay, tani izi baggara naa aayo gidanaakkonne» gadus; histtiin Abraamey Soora qaala siyides. <verse eid="GEN 16:2" /><verse number="3" style="v" sid="GEN 16:3" />Abraamey Kanaane biittan tammu layth uttidaappe guye Abraame machcheya Sooray Gibxeppe ehida ba aylleyo Aggaaro, ba azina Abraames machcho histta immadus. <verse eid="GEN 16:3" /><verse number="4" style="v" sid="GEN 16:4" />Abraameykka Aggaaro ekkiin iza qanththatadus; iza baas shaaray attidayssa erida wode ba godatteyo leqqadus.<verse eid="GEN 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 16:5" />He wode Sooray Abraame, «Ta qohettiza qohoy nena gakko; tani ta aylleyo nees immiin iza ha7i baas shaaray attidayssa erada tana leqqawus. Neessinne taas Xoossi pirdo» gadus.<verse eid="GEN 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 16:6" />Abraameykka Soora, «Hanno beya! Ne aylleya ne kushen dawus; neni izo nena lo7idaaz ooththa» gides; hessafe guye Sooray Aggaaro qohiin iza kezada izippe betadus.<verse eid="GEN 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 16:7" />GODAA kiitanchchay Aggaaro bazzon pultto haaththa achchan demmides; he pulttoy Shuura geetettiza biitta efiza oge matan dees. <verse eid="GEN 16:7" /><verse number="8" style="v" sid="GEN 16:8" />Izikka Aggaaro, «Hanne Soora aylle Aggaaree! Awappe yadii? Qasse awa bay?» gi oychchides.</para>
  <para style="p" vid="GEN 16:8">Iza, «Tani ta godatteyo Soorappe bete bays» gadus.<verse eid="GEN 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 16:9" />GODAA kiitanchchayka izis, «Neni ne godatteyko guye simma baada izis haaretta» gides <verse eid="GEN 16:9" /><verse number="10" style="v" sid="GEN 16:10" />Qasseka Xoossa kiitanchchay izo, «Ne zereth taybanaas dandayettonttayssa keena tani darsana» gides. <verse eid="GEN 16:10" /><verse number="11" style="v" sid="GEN 16:11" />Qasseka GODAA kiitanchchay izo,</para>
  <para style="q1" vid="GEN 16:11">«Ha7i neni qanththatadasa;</para>
  <para style="q2" vid="GEN 16:11">neni attuma naa yelana;</para>
  <para style="q2" vid="GEN 16:11">yelada iza Isma7eele<note caller="+" style="f"><char style="fr" closed="false">16:11 </char><char style="ft" closed="false">Ibraaweta qaalara Isma7eele guussi, «Xoossi siyees» guussa.</char></note></para>
  <para style="q2" vid="GEN 16:11">gaada sunththana;</para>
  <para style="q2" vid="GEN 16:11">gaasoykka Xoossi</para>
  <para style="q2" vid="GEN 16:11">ne waasaa siyides.<verse eid="GEN 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 16:12" />Izi bazzon yeda diza</para>
  <para style="q2" vid="GEN 16:12">hare mala gidana;</para>
  <para style="q2" vid="GEN 16:12">asa ubbaara izi eqettana;</para>
  <para style="q2" vid="GEN 16:12">qasse asi wurikka izara eqettana;</para>
  <para style="q2" vid="GEN 16:12">izi ba ishata ubbaara</para>
  <para style="q2" vid="GEN 16:12">ixetti daana» gides.<verse eid="GEN 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 16:13" />Aggaarakka, «Tani tana be7izayssa be7ada paxa attanee?» gaada iza baas haasayda GODAA, «Neni tana be7iza Xoossa» ga sunththadus. <verse eid="GEN 16:13" /><verse number="14" style="v" sid="GEN 16:14" />Hessa gishshas he pultto ollay, «Tana Be7iza De7o Xoossa pultto» geetettides; he ollay ha7i gakkanaas Qaadeeseppenne Baareedeppe giddon dees. <figure style="fig" alt="Woman drawing water from well" file="LB00134B.TIF" size="span" ref="16:14">Maccassi haath ollafe duuqqishin</figure><verse eid="GEN 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 16:15" />Aggaara Abraames attuma naa yeladus; Abraamey Aggaara yelida naaza Isma7eele gi sunththides.<note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="GAL 4:22">Gala 4:22</ref></char></note> <verse eid="GEN 16:15" /><verse number="16" style="v" sid="GEN 16:16" />Aggaara Isma7eele Abraames yelida wode Abraame layththay 86.<verse eid="GEN 16:16" /></para>
  <chapter eid="GEN 16" />
  <chapter number="17" style="c" sid="GEN 17" />
  <para style="s1">Qaxxara Woga</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1" />Abraame layththi uddufun tammanne uddufun gidishin GODAY izas qonccidi, «Tani Ubbaa Dandayza Xoossa; ne ta sinththan suure hemetta. <verse eid="GEN 17:1" /><verse number="2" style="v" sid="GEN 17:2" />Tani taappenne neeppe giddon diza caaqo qaalaa minththana; tani ne zereththaa keeha darsana!» gides. <verse eid="GEN 17:2" /><verse number="3" style="v" sid="GEN 17:3" />Abraamey biittan duge gufannidi hu7ey biitta bochchiin izi Xoossas ziggiin Xoossi izas, <verse eid="GEN 17:3" /><verse number="4" style="v" sid="GEN 17:4" />«Ha7i ta nenara caaqqiza caaqoy hayssa; neni daro kawoteththatas aawa gidana. <verse eid="GEN 17:4" /><verse number="5" style="v" sid="GEN 17:5" />Hachchife guye ne sunththi Abraame geetettenna; gido attiin ne sunththi Abrahaame<note caller="+" style="f"><char style="fr" closed="false">17:5 </char><char style="ft" closed="false">Ibraaweta qaalara Abrahaame guussi, «Daro asa aawa» guussa.</char></note> geetettana; aazas giikko tani nena daro kawoteththatas aawa ooththadis.<note caller="-" style="x"><char style="xo" closed="false">17:5 </char><char style="xt" closed="false"><ref loc="ROM 4:17">Oro 4:17</ref></char></note> <verse eid="GEN 17:5" /><verse number="6" style="v" sid="GEN 17:6" />Tani nena keeha darsana; tani nena daro kawoteth histtana; kawotikka neeppe kezana. <verse eid="GEN 17:6" /><verse number="7" style="v" sid="GEN 17:7" />Tani taappenne neeppe, neeppe guye ne zereththa giddon, yeletappe yeleta gakkanaas ta gelida caaqo qaala minththana; ha caaqoykka tani neessinne neeppe guye ne zereththas Xoos gidana.<note caller="-" style="x"><char style="xo" closed="false">17:7 </char><char style="xt" closed="false"><ref loc="LUK 1:55">Luqa 1:55</ref></char></note> <verse eid="GEN 17:7" /><verse number="8" style="v" sid="GEN 17:8" />Ha7i neni bete gidada diza Kanaane derey wuri neessinne neeppe guye ne zereththas mernaas laata biitta gidana mala tani immana; qasse tani istta Xoos gidana» gides.<note caller="-" style="x"><char style="xo" closed="false">17:8 </char><char style="xt" closed="false"><ref loc="ACT 7:5">Hawa 7:5</ref></char></note><verse eid="GEN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 17:9" />Qasseka Xoossi Abrahaame, «Nekka neeppe guye ne zereththayka, yeletappe yeleta gakkanaas ta caaqo qaalaa naagite. <verse eid="GEN 17:9" /><verse number="10" style="v" sid="GEN 17:10" />Taappenne neeppe, neeppe guye ne zereththa giddon intte naagana ta caaqo qaalay hayssa; intte giddon diza attumas ubbay qaxxaretto.<note caller="-" style="x"><char style="xo" closed="false">17:10 </char><char style="xt" closed="false"><ref loc="ACT 7:8">Hawa 7:8</ref>; <ref loc="ROM 4:11">Oro 4:11</ref></char></note> <verse eid="GEN 17:10" /><verse number="11" style="v" sid="GEN 17:11" />Intte shurte qaxxaretteeta; hayssi taassinne inttes giddon diza caaqo qaalaas malata gidana. <verse eid="GEN 17:11" /><verse number="12" style="v" sid="GEN 17:12" />Intte giddon sinththafe yelettana adde nayti wuri yelettida osppunththa gallas qaxxarettanaas koshshees; neson yelettidayta gidiin, woykko allagappe miishshan shamettida aylleta gidiin ne zereth gidontta addetakka qaxxaranaas koshshees. <verse eid="GEN 17:12" /><verse number="13" style="v" sid="GEN 17:13" />Neson yelettidaytinne ne miishshan shamettidayti qaxxarettetto; hayssi intte ashon diza ta caaqoy mernaa caaqo gidana. <verse eid="GEN 17:13" /><verse number="14" style="v" sid="GEN 17:14" />Qaxxarettontta attumasi wuri ba asaappe shaakettidi dhayo; gaasoykka izi ta caaqo qaalaa naagibeenna» gides.<verse eid="GEN 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 17:15" />Qasseka Xoossi Abrahaame, «Ne machchey sunththaa Soora gooppa; hayssafe guye izi sunththi Saara<note caller="+" style="f"><char style="fr" closed="false">17:15 </char><char style="fqa" closed="false">Saara: </char><char style="ft" closed="false">Saara guussi Ibraaweta qaalara, «Godatteyo woykko kawo biyo» guussa.</char></note> geetetto. <verse eid="GEN 17:15" /><verse number="16" style="v" sid="GEN 17:16" />Tani izo anjjana; tani izippe nees tumappe attuma naa immana; izo tani anjjana; iza kawoteththatas aayo gidana; kawoti izippe yelettana» gides.<verse eid="GEN 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 17:17" />Abrahaamey biitta bolla gufannidi ba wozinan miiccishe, «100 layththa asi tumu naa yelanee? Qasse izis layththay uddufun tammu gidida Saaray buro naa yelanee?» gi qoppides. <verse eid="GEN 17:17" /><verse number="18" style="v" sid="GEN 17:18" />Abrahaamey Xoossaas, «Ne Isma7eele taas anjjidaakko ay mala lo7oshin!» gides.<verse eid="GEN 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 17:19" />Xoossayka izas, «Hanenna! Ne machcheya Saaray nees attuma naa tumappe yelana; neni iza Yisaaqa<note caller="+" style="f"><char style="fr" closed="false">17:19 </char><char style="fqa" closed="false">Yisaaqa: </char><char style="ft" closed="false">Yisaaqa guussi Ibraaweta qaalara, «Izi miiccees» guussa.</char></note> gaada sunththana; izappe guye iza zereththas mernaa caaqo gidana mala ta izara caaqo qaala gelana. <verse eid="GEN 17:19" /><verse number="20" style="v" sid="GEN 17:20" />Isma7eeles gidikko ne oychchidayssa ta siyadis; tani izakka anjjana; tani iza darsana; iza zereththaa keeha darsana; izi tammanne nam7u kawota yelana; tani iza zereththaa gita kawoteth kessana. <verse eid="GEN 17:20" /><verse number="21" style="v" sid="GEN 17:21" />Gido attiin tani ta caaqo qaalaa layth hanni wode Saaray nees yelana naaza Yisaaqara caaqettana» gides. <verse eid="GEN 17:21" /><verse number="22" style="v" sid="GEN 17:22" />Xoossi Abrahaamera haasaydi wursidaappe guye, Abrahaameppe shaakettidi pude bides.<verse eid="GEN 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 17:23" />He gallassankka Abrahaamey ba naa Isma7eele bason yelettidayta ubbaa, ba miishshan shammidayta ubbaanne bason diza attumas ubbaa, Xoossi izas yootida mala qaxxarides. <verse eid="GEN 17:23" /><verse number="24" style="v" sid="GEN 17:24" />Abrahaamey qaxxarettishin izas layththay uddufun tammanne uddufuna. <verse eid="GEN 17:24" /><verse number="25" style="v" sid="GEN 17:25" />Iza naa Isma7eeley qaxxarettishin izas layththay tammanne heedzdza. <verse eid="GEN 17:25" /><verse number="26" style="v" sid="GEN 17:26" />Abrahaameynne iza naa Isma7eeley nam7atikka issi gallas qaxxarettida. <verse eid="GEN 17:26" /><verse number="27" style="v" sid="GEN 17:27" />Abrahaameson diza attumasay wuri iza soon yelettidaytinne miishshan shamettidayti wurikka izara qaxxarettida.<verse eid="GEN 17:27" /></para>
  <chapter eid="GEN 17" />
  <chapter number="18" style="c" sid="GEN 18" />
  <para style="s1">Heedzdzu Imaththata</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1" />Seeta gallas Abrahaamey Mamiren diza gita miththata garsan ba dunkaane pengen utti dishin GODAY izas qonccides. <verse eid="GEN 18:1" /><verse number="2" style="v" sid="GEN 18:2" />Abrahaamey dhoqqu gi xeellidi heedzdzu asati eqqidayta be7idi istta mokki ekkanaas ba Dunkaaneza pengefe dendidi woxxi bides; he gakki biittan hokkidi istta sinththan ziggides.<note caller="-" style="x"><char style="xo" closed="false">18:2 </char><char style="xt" closed="false"><ref loc="HEB 13:2">Ib 13:2</ref></char></note> <verse eid="GEN 18:2" /><verse number="3" style="v" sid="GEN 18:3" />Ziggi simmidi, «Abeet ta godoo! Ne tana ne aylleza bonchchizaa gidikko taso gelontta aadhdha booppa. <verse eid="GEN 18:3" /><verse number="4" style="v" sid="GEN 18:4" />Ha7i intte toho meeccana toho haaththi yiikko intte toho meecettidi hayssa miththaa kuwan shempi ekkite. <verse eid="GEN 18:4" /><verse number="5" style="v" sid="GEN 18:5" />Intte ha7i taakko intte ayllezakko yida gishshas shempi ekkidi intte bizaso baana mala tani inttes miza miish ane ehays» gides.</para>
  <para style="p" vid="GEN 18:5">Istti, «Daro lo7o; neni giza mala ooththa» gida.<verse eid="GEN 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 18:6" />Abrahaamey Dunkaaneza giddo Saarakko eesoti biidi, «Eesotada liiqo dhiillezappe heedzdzu kere gidizayssa ekka munuqada uketh uukka» gides. <verse eid="GEN 18:6" /><verse number="7" style="v" sid="GEN 18:7" />Qasse Abrahaamey ba wudezaakko woxxi biidi lo7o anqara mar dooridi issi aylles immiin izi eeson shukkidi giigsides. <verse eid="GEN 18:7" /><verse number="8" style="v" sid="GEN 18:8" />Histtiin Abrahaamey meqo maaththinne giigsida maraa ashoza imaththata sinth aaththides; istti mishin izi he miththaa garsan istta achchan eqqides.<verse eid="GEN 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 18:9" />Istti iza, «Ne machcheya Saaray awanee?» gi oychchiin izi, «Henin dunkaane giddon dawus» gides.<verse eid="GEN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 18:10" />GODAY izas, «Tani yiza layth hanni wode tumu neekko simmana; he wode ne machchiya Saaray attuma naa nees yelana» gides. Saaraykka izappe guye baggara dunkaaneza sinththan dashe hessa siyadus.<note caller="-" style="x"><char style="xo" closed="false">18:10 </char><char style="xt" closed="false"><ref loc="ROM 9:9">Oro 9:9</ref></char></note> <verse eid="GEN 18:10" /><verse number="11" style="v" sid="GEN 18:11" />Abrahaameynne Saaray keehi cimmida; Saaraska maccassatas yiza wogay aggides. <verse eid="GEN 18:11" /><verse number="12" style="v" sid="GEN 18:12" />Hessa gishshas Saaray ba wozinan, «Tani ha7i cimmidaappe guye, ta azinaykka cimmidaappe guye hayssi ufayssay taas hananee?» gaada miiccadus.<note caller="-" style="x"><char style="xo" closed="false">18:12 </char><char style="xt" closed="false"><ref loc="1PE 3:6">1Phex 3:6</ref></char></note><verse eid="GEN 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 18:13" />He wode GODAY Abrahaame, « ‹Tani cimmaychidaappe guye tumu naa yelanee?› gaada Saaray aazas miiccadee? <verse eid="GEN 18:13" /><verse number="14" style="v" sid="GEN 18:14" />GODAAS dandayettontta miishshi tumu dizee? Ta gida mala yiza layth hanni wode ta neekko yaana; he wode Saaray attuma naa yelana» gides.<note caller="-" style="x"><char style="xo" closed="false">18:14 </char><char style="xt" closed="false"><ref loc="LUK 1:37">Luqa 1:37</ref></char></note><verse eid="GEN 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 18:15" />Saaray keeha babbida gishshas, «Tani miiccabeekke» gaada lahottadus. Gido attiin izi, «Ee, neni tuma miiccadasa» gides.<verse eid="GEN 18:15" /></para>
  <para style="s1">Sodoomes Abrahaame Gaannateth</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16" />Hessafe guye asati baana dendishe Sodoome katama duge zaari xeellida; Abrahaameykka istta moyzishe isttara bides. <verse eid="GEN 18:16" /><verse number="17" style="v" sid="GEN 18:17" />He wode GODAY, «Tani ta ooththana gizayssa Abrahaameppe qottanee? <verse eid="GEN 18:17" /><verse number="18" style="v" sid="GEN 18:18" />Abrahaamey tumappe gitanne wolqqama kawoteth gidana; ha biitta asi wuri iza baggara anjjettana. <verse eid="GEN 18:18" /><verse number="19" style="v" sid="GEN 18:19" />Xilloteththinne suure ooso ooththidi GODAA oge naagana mala ba naytanne baappe guye ba soo asaa izi zorana mala tani iza dooradis; hessika GODAY Abrahaames immana gidayssa ubbaa polanaassa» gides.<verse eid="GEN 18:19" /></para>
  <para style="p">
    <verse number="20-21" style="v" sid="GEN 18:20-21" />GODAY Abrahaame, «Sodoomenne Gamoora waasoy keehi darida gishshassinne istta nagaray keehi deexxida gishshas istti ooththidayssi taakko gakkida waaso mala iitakkonne iita gidonttaakko ane tani duge wodhdha beyays» gides.<verse eid="GEN 18:20-21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 18:22" />Hessafe guye nam7u asati Sodoome simmi bida; gido attiin Abrahaamey GODAA sinththan eqqida mala dees. <verse eid="GEN 18:22" /><verse number="23" style="v" sid="GEN 18:23" />He wode Abrahaamey izakko shiiqidi, «Tumu neni xillota iitatara gaththa dhayssanee? <verse eid="GEN 18:23" /><verse number="24" style="v" sid="GEN 18:24" />He gita katamaan 50 xilloti diikko neni istta dhayssanee? Neni izan diza 50 xillota gishshas he katamaa maarkkii? <verse eid="GEN 18:24" /><verse number="25" style="v" sid="GEN 18:25" />Xillota wordotara gaththa wodhizayssinne xillotanne wordota issi ayfen xeellizayssi hessi neeppe haakko; ha biitta ubbaa bolla pirdiza neni xillo pirdikii?» gides.<verse eid="GEN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 18:26" />GODAYKKA, «He Sodoome katamaan 50 xilloti diikko he katamaa ubbaa istta gishshas tani ubbaa maarana» gides.<verse eid="GEN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 18:27" />Hessafe guye Abrahaamey, «Tani biittanne bidinththakoshin ta Godaara xalada haasaya oykkadis. <verse eid="GEN 18:27" /><verse number="28" style="v" sid="GEN 18:28" />Ichchashu tammu xillotappe ichchashati pacciko neni he paccida ichchashata gishshas he katamaa ubbaa dhayssanee?» gides.</para>
  <para style="p" vid="GEN 18:28">GODAYKKA, «Tani heen oyddu tammanne ichchash xillota demmiko he katamaa dhayssike» gides.<verse eid="GEN 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 18:29" />Abrahaamey zaareththidikka, «Heen 40 xilloti xalla beettikochchii?» gides.</para>
  <para style="p" vid="GEN 18:29">Izikka, «Tani he oyddu tammata gishshas he katamaa dhayssike» gides.<verse eid="GEN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 18:30" />Hessafe guye izi, «Ta Godoo! Ne ta bolla hanqettofa; tani gujjadakka oychchays; heen 30 xilloti xalla beettikochchii?» gides.</para>
  <para style="p" vid="GEN 18:30">GODAY, «Tani heen 30 xillo as demmiko he katamaa dhayssike» gides.<verse eid="GEN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 18:31" />Qasseka Abrahaamey, «Tani Godaara xalateththan haasaya doommadis; heen 20 xilloti xalla beettikochchii?» gides.</para>
  <para style="p" vid="GEN 18:31">GODAY, «He nam7u tammata gishshas dhayssike» gides.<verse eid="GEN 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 18:32" />Hessafe guye Abrahaamey, «Ta Godoo! Ne ta bolla hanqettofa; tani mexi issito haasayays; heen 10 xilloy beettikochchii?» gides.</para>
  <para style="p" vid="GEN 18:32">GODAY, «He tammata gishshas tani he katamaa dhayssike» gides.<verse eid="GEN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 18:33" />GODAY Abrahaamera haasaya wursidaappe guye bides; Abrahaameykka baso simmides.<verse eid="GEN 18:33" /></para>
  <chapter eid="GEN 18" />
  <chapter number="19" style="c" sid="GEN 19" />
  <para style="s1">Sodoome Nagara</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1" />He nam7u kiitanchchati omars Sodoome katama gakkiza wode Looxey he katamaa pengen uttides. Looxey istta be7idi isttara gaagganaas dendi biidi ba hu7e duge biitta gaththi ziggidi, <verse eid="GEN 19:1" /><verse number="2" style="v" sid="GEN 19:2" />«Ta godatoo! Intte aylle taso haa yerketi; intte toho meecetti aqidi wonto maaladora dendidi intte bizaso beeta» gides.</para>
  <para style="p" vid="GEN 19:2">Isttika, «Akkay bookko; nuni hayssa katamaa dubbushan aqana» gida.<verse eid="GEN 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 19:3" />Gido attiin izi istta keehi shoobbida gishshas izara biidi iza soo gelida; izikka isttas uketh uukkidi kawo aaththiin istti mida.<verse eid="GEN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 19:4" />Istti ichchontta dishin Sodoome katamaa attumasay wuri naytappe cima gakkanaas issaadeyka attontta yiidi keeththaa yuuyi aadhdhida. <verse eid="GEN 19:4" /><verse number="5" style="v" sid="GEN 19:5" />Isttika Looxe xeygidi, «Hach omars neso yida asati awan dizoo? Nuni isttara aqana mala istta nuukko kare kessa» gida.<verse eid="GEN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 19:6" />Looxey isttara gaagganaas kare kezidi sohon diza asata bolla kareza guye zaari gordidi, <verse eid="GEN 19:6" /><verse number="7" style="v" sid="GEN 19:7" />isttas, «Ta ishatoo! Hayssa iita ooso ooththofte. <verse eid="GEN 19:7" /><verse number="8" style="v" sid="GEN 19:8" />Taas adde gelontta nam7u geela7o macca nayti deettes; tani istta inttes kare kessiko intte istta inttena lo7ida mala ooththana dandayeeta; gido attiin hayta asata bolla aykkoka ooththofte; ays giikko istti ta keeth gelidi ta imath gidida» gides.<note caller="-" style="x"><char style="xo" closed="false">19:5-8 </char><char style="xt" closed="false"><ref loc="JDG 19:22-24">Daanna 19:22-24</ref></char></note><verse eid="GEN 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 19:9" />Asati iza, «Nu sinththafe kichcha!» qasseka, «Hayssi addezi ha biittan bete as gidi uttidi ha7i nu bolla pirdanaas kajjalees; ha7i nuni istta bolla ooththana qoppida iitaappe aadhdhida iita ne bolla ooththana» gida. Looxekka guye sugi yeggidi pengeza menththanaas matida. <verse eid="GEN 19:9" /><verse number="10" style="v" sid="GEN 19:10" />Gido attiin he nam7u asati ba kushe kare yeddidi Looxe soo goochchi gelththidi kareza zaari gordida. <verse eid="GEN 19:10" /><verse number="11" style="v" sid="GEN 19:11" />Hessafe guye istti keeththaa pengen diza asaa guuththafe gita gakkanaas qooqisiin istti pengeza demmanaas koyishe daaburda.<note caller="-" style="x"><char style="xo" closed="false">19:11 </char><char style="xt" closed="false"><ref loc="2KI 6:18">2Kawo 6:18</ref></char></note><verse eid="GEN 19:11" /></para>
  <para style="s1">Sodoomeppe Looxe Kes</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 19:12" />He nam7u asati Looxe, «Nees hayssa katamaa garsan diza attuma naa woykko macca naa gidiin ne nayta ekkanaas giigsidaytikka diikko woykko hara dabboy diikko istta hayssafe kessa. <verse eid="GEN 19:12" /><verse number="13" style="v" sid="GEN 19:13" />Ays giikko nuni hayssa katamaa dhayssana goos; ha deraa nagaray keehi daro gididayssa GODAY be7ida gishshas hayssa katamaa dhayssanaas nuna kiittides» gida.<verse eid="GEN 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 19:14" />Hessa gishshas Looxey ba macca nayta ekkanaas giigsidaytakko biidi isttas, «GODAY ha katamaa dhayssana giza gishshas Eleli dendidi hayssafe kezi kichchite» gides; gido attiin iza macca nayta giigsidayti izi qidhe gees gi qoppida.<verse eid="GEN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 19:15" />Gadey wonttana gishin he kiitanchchati Looxe, «Denda! Ne machchiyonne hayssan diza ne nam7u macca nayta ekkada eeson keza! Kezontta ixxiko, hanna katamaya pirdettiza wode nenikka dhayana» giidi eesosida. <verse eid="GEN 19:15" /><verse number="16" style="v" sid="GEN 19:16" />Gido attiin Looxey shinniin GODAY isttas qadhettida gishshas kiitanchchati iza kushe, iza machchey kushenne macca nayta nam7ata kushe oykkidi he katamaappe istta kessida.<note caller="-" style="x"><char style="xo" closed="false">19:16 </char><char style="xt" closed="false"><ref loc="2PE 2:7">2Phex 2:7</ref></char></note> <verse eid="GEN 19:16" /><verse number="17" style="v" sid="GEN 19:17" />Kiitanchchati istta katamaappe kessida malakka kiitanchchatappe issay, «Intte shemppo ekkidi baqatite! Guye xeellofte! Qasse hayssa shoobbaan awanka eqqofte! Zumaakko woxxite! Histtontta ixxiko intte dhayana» gides.<verse eid="GEN 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 19:18" />Gido attiin Looxey isttas, «Ta godatoo! Hessaththo gidoppo! <verse eid="GEN 19:18" /><verse number="19" style="v" sid="GEN 19:19" />Tani intte aylley intte sinththan sabettida gishshas tana ashshanaas taas daro qadhettideta; gidikkoka hayssi bashshay tana gakkidi dhayssiko hayqqana gishshas tani pude zumaakko baqatanaas dandaykke. <verse eid="GEN 19:19" /><verse number="20" style="v" sid="GEN 19:20" />Be7ite! Baqati biidi attanaas matan issi guuththa katamay dawus; ta shemppo ashshanaas hee baqatoo? Iza qeeri katama deekkee?» gides. <verse eid="GEN 19:20" /><verse number="21" style="v" sid="GEN 19:21" />Gido attiin kiitanchchay, «Ee gido! Tani ne woosaa siyadis; tani neni giza katamayo dhayssike. <verse eid="GEN 19:21" /><verse number="22" style="v" sid="GEN 19:22" />Hessa gishshas gede eeson baqata; neni gede gakkanaas tani aykkoka ooththanaas dandaykke» gides; histtiin he katamay sunththi Zo7aare<note caller="+" style="f"><char style="fr" closed="false">19:22 </char><char style="fqa" closed="false">Zo7aare: </char><char style="ft" closed="false">Zo7aare guussi Ibraaweta qaalara, «Guuth» guussa.</char></note> geetettides.<verse eid="GEN 19:22" /></para>
  <para style="s1">Sodoomenne Gamoora Katamata Dhays</para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23" />Looxey Zo7aare gakkishin buro xalqqey caarides. <verse eid="GEN 19:23" /><verse number="24" style="v" sid="GEN 19:24" />He wode GODAY tamanne xuuggiza diine Sodoome bollanne Gamoora bolla saloppe bukisides. <verse eid="GEN 19:24" /><verse number="25" style="v" sid="GEN 19:25" />Hessaththo ooththidi GODAY he zullen diza katamatanne zullen dizaaz ubbaa he katamata giddon diza asaa ubbaanne he biittan diza miththinne maata ubbaa xuuggi dhayssides.<note caller="-" style="x"><char style="xo" closed="false">19:24-25 </char><char style="xt" closed="false"><ref loc="MAT 10:15">Mato 10:15</ref>; <ref loc="MAT 11:23-24">11:23-24</ref>; <ref loc="LUK 17:29">Luqa 17:29</ref>; <ref loc="2PE 2:6">2Phex 2:6</ref>; <ref loc="JUD 1:7">Yuhu 7</ref></char></note> <verse eid="GEN 19:25" /><verse number="26" style="v" sid="GEN 19:26" />Gido attiin Looxe machchiya guye xeellada maxine shuch gidadus.<note caller="-" style="x"><char style="xo" closed="false">19:26 </char><char style="xt" closed="false"><ref loc="LUK 17:32">Luqa 17:32</ref></char></note><verse eid="GEN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 19:27" />Wonteththa gallas Abrahaamey maalado wonttara dendidi GODAA sinththan kase izi eqqidaso simmi bides. <verse eid="GEN 19:27" /><verse number="28" style="v" sid="GEN 19:28" />Izi Sodoomenne Gamoora he shoobbaan diza biitta ubbaa duge xeelliza wode wolqqama cuway xuussa tama mala he biittaafe tullu gizayssa be7ides.<verse eid="GEN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 19:29" />Xoossi he shoobban diza katamata dhayssida wode, Abrahaame qoppidi Looxey kase diza katamata dhayssida wode Looxe dhayssafe ashshides.<verse eid="GEN 19:29" /></para>
  <para style="s1">Looxe Yeleta</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30" />Looxey Zo7aaren de7anaas babbida gishshas ba macca nayta nam7atara zuma bolla kezidi gongolo giddon de7ides. <verse eid="GEN 19:30" /><verse number="31" style="v" sid="GEN 19:31" />Issi gallas bayra naya kaaloyo, «Nu aaway cimmides; biitta bolla diza woga mala nunara zin7anaas hayssa biittaan mulekka attumay deenna. <verse eid="GEN 19:31" /><verse number="32" style="v" sid="GEN 19:32" />Hessa gishshas haa ya; woyne ushshu nu aawa ushshi maththosoos; histtidi izara aqidi ane nu aawappe nuus zereth essoos» gadus. <verse eid="GEN 19:32" /><verse number="33" style="v" sid="GEN 19:33" />He gallassa omarsika ba aawaa woyne ushshu ushshidaappe guye bayraya gelada izara zin7adus; iza izara zin7iza wodekka dendiza wodekka izi eribeenna.<verse eid="GEN 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 19:34" />Wonteththa gallas bayraya kaaloyo, «Siya! Qamma tani nu aawara aqadis; hach omars qasse woyne ushshu ushshiko neni gelada izara aqa; histtidi nuni nu aawappe nuus zereth essoos» gadus. <verse eid="GEN 19:34" /><verse number="35" style="v" sid="GEN 19:35" />He gallas qamma qasseka woyne ushshu iza ushshidaappe guye kaaloya gelada izara aqadus; iza izara aqada denda biza wode izi eribeenna. <verse eid="GEN 19:35" /><verse number="36" style="v" sid="GEN 19:36" />Histtidi Looxe macca nayti nam7atikka ba aawaas qanththatida. <verse eid="GEN 19:36" /><verse number="37" style="v" sid="GEN 19:37" />Bayraya attuma naa yeladus; sunththaaka Mo7aabe<note caller="+" style="f"><char style="fr" closed="false">19:37 </char><char style="fqa" closed="false">Mo7aabe: </char><char style="ft" closed="false">Mo7aabe guussi Ibraaweta qaalara, «Ta aawappe yelettidayssa» guussa</char></note> gaada sunththadus; izikka hach gakkanaas Mo7aabetas aawa. <verse eid="GEN 19:37" /><verse number="38" style="v" sid="GEN 19:38" />Qasse kaaloyakka attuma naa yeladus; sunththaaka Beeni-Aame<note caller="+" style="f"><char style="fr" closed="false">19:38 </char><char style="fqa" closed="false">Beeni-Aame: </char><char style="ft" closed="false">Beeni-Aame guussi Ibraaweta qaalara, «Ta bagga woykko ta dabbo naa» guussa</char></note> gaada sunththadus; izikka hach gakkanaas Amoonetas aawa.<verse eid="GEN 19:38" /></para>
  <chapter eid="GEN 19" />
  <chapter number="20" style="c" sid="GEN 20" />
  <para style="s1">Abrahaamenne Abimelekke</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1" />Abrahaamey Mamireppe dendidi Negebe geetettiza biitta biidi Qaadeesenne Shuura geetettiza katamatappe giddon de7ides; Geraare biittan guuththa wode gam7ides. <verse eid="GEN 20:1" /><verse number="2" style="v" sid="GEN 20:2" />Heen Abrahaamey ba machchiyo Saara, «Iza taas michcho» giin Geraare kawo Abimelekkey kiittidi Saara baso efides.<note caller="-" style="x"><char style="xo" closed="false">20:2 </char><char style="xt" closed="false"><ref loc="GEN 12:13">Medhe 12:13</ref>; <ref loc="GEN 26:7">26:7</ref></char></note> <verse eid="GEN 20:2" /><verse number="3" style="v" sid="GEN 20:3" />Gido attiin Xoossi issi gallassa omars agumon Abimelekkeko yiidi, «Neni ehida maccassay geedon ne hayqqana; iza asa machcho» gides.<verse eid="GEN 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 20:4" />Gido attiin Abimelekkey izira aqibeenna; hessa gishshas, «Ta godoo! Neni, tani, ta kawoteththayka nena qohontta dishin nuna coo dhayssanee? <verse eid="GEN 20:4" /><verse number="5" style="v" sid="GEN 20:5" />Izi, ‹Iza ta michcho› gibeennee? Qasse iza, ‹Izi ta isha› gabeekkee? Tani hayssa tumu wozinappe ooththadis» gides.<verse eid="GEN 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 20:6" />Hessafe guye Xoossi agumon izas, «Ee, neni ne wozina geeshshateththan ooththidayssa tani erada neni izo bochchontta malanne ta sinththan nagara ooththontta mala nena tani teqqadis. <verse eid="GEN 20:6" /><verse number="7" style="v" sid="GEN 20:7" />Ha7i hanno maccassayo izi azinaas zaara; gaasoykka izi nabe gidida gishshas izi nees Xoossaa woossiko neni paxana; gido attiin ne izo zaarontta ixxiko neninne nees dizaazi wuri hayqqanayssa tumappe ne era» gides.<verse eid="GEN 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 20:8" />Abimelekkey wonteththa gallas maalado ba kawoteththan diza shuumeta ubbaa xeygidi ha yo7oza ubbaa isttas yootiin istti keehi babbida. <verse eid="GEN 20:8" /><verse number="9" style="v" sid="GEN 20:9" />Histtiin Abimelekkey Abrahaame xeygidi, «Neni nu bolla ay ooththadii? Neni ta bollanne ta kawoteththaa bolla hayssa mala qoho ehanaas tani nees ay iita miish ooththadinaa? Neni ta bolla oosettanaas bessontta iita ooththadasa» gides. <verse eid="GEN 20:9" /><verse number="10" style="v" sid="GEN 20:10" />Qasseka Abimelekkey Abrahaame, «Nena hayssa oosisiday aazee?» gi oychchiin,<verse eid="GEN 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 20:11" />Abrahaamey, « ‹Xoossas babbiza issi asikka ha deren baawa; qasseka ta machchey geedon istti tana wodhana› gaada qoppida gishshassa. <verse eid="GEN 20:11" /><verse number="12" style="v" sid="GEN 20:12" />Izakka ta aawa naa gidida gishshas taas michcho; taas aayi naa gidontta gishshas ta izo machcho ekkadis. <verse eid="GEN 20:12" /><verse number="13" style="v" sid="GEN 20:13" />Xoossi tana ta aawa keeththafe kessida wode tani izis nuni bida biittan ubbaan neni taas ooththana kiyateththi, ‹Izi taas isha› gaada yoota gadis» gides.<verse eid="GEN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 20:14" />Hessafe guye Abimelekkey dors, miiz, macca aylletanne attuma aylleta ehidi Abrahaames immides; qasse iza machchiyo Saarakka izas zaarides. <verse eid="GEN 20:14" /><verse number="15" style="v" sid="GEN 20:15" />Abimelekkey, «Hekko ta biittay ne sinththan dees; nena lo7izason da» gides. <verse eid="GEN 20:15" /><verse number="16" style="v" sid="GEN 20:16" />Saaraska, «Tani ne ishaas issi shii saqile bira<note caller="+" style="f"><char style="fr" closed="false">20:16 </char><char style="fqa" closed="false">Issi shii saqile bira: </char><char style="ft" closed="false">Issi shii saqile bira guussi tammanne issinonne bagga kilo giraame deexxizaaza guussa.</char></note> immadis; hayssi hekko nenara dizayta ubbaa sinththan neni xillo gididayssa erisana» gides.<verse eid="GEN 20:16" /></para>
  <para style="p">
    <verse number="17-18" style="v" sid="GEN 20:17-18" />GODAY Abrahaame machcheyo Saara geedon Abimelekke keeththa asa ubbaa yeliza ulo makkarssida gishshas Abrahaamey Xoossaa woossiin Abimelekkey iza machcheyanne iza macca aylleti naa yelana mala Xoossi istta paththides.<verse eid="GEN 20:17-18" /></para>
  <chapter eid="GEN 20" />
  <chapter number="21" style="c" sid="GEN 21" />
  <para style="s1">Yisaaqa Yeleteth</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1" />GODAY Saara qoppides; kase izis yootida malakka ooththides. <verse eid="GEN 21:1" /><verse number="2" style="v" sid="GEN 21:2" />Saaray shaarada cimateththan Abrahaames Xoossi gida wodey gakkiin attuma naa yeladus.<note caller="-" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="HEB 11:11">Ib 11:11</ref></char></note> <verse eid="GEN 21:2" /><verse number="3" style="v" sid="GEN 21:3" />Saaray izas yelida naaza sunththaa Abrahaamey, «Yisaaqa» gi sunththides. <verse eid="GEN 21:3" /><verse number="4" style="v" sid="GEN 21:4" />Abrahaamey naaza Yisaaqa Xoossi bana azazida mala yelettidaappe osppunththa gallas qaxxarides.<note caller="-" style="x"><char style="xo" closed="false">21:4 </char><char style="xt" closed="false"><ref loc="GEN 17:12">Medhe 17:12</ref>; <ref loc="ACT 7:8">Hawa 7:8</ref></char></note> <verse eid="GEN 21:4" /><verse number="5" style="v" sid="GEN 21:5" />Iza naa Yisaaqi izas yelettida wode Abrahaames layththay xeeta. <verse eid="GEN 21:5" /><verse number="6" style="v" sid="GEN 21:6" />Saaray, «Xoossi tana miichchides; qasse hayssa siyizay wuri tanara miiccana» gadus. <verse eid="GEN 21:6" /><verse number="7" style="v" sid="GEN 21:7" />Qasseka Saaray, «Abrahaames Saaray naa yelananne dhanththana giidi qoppiday oonee? Gidikkoka tani ha7i izas izi cimmida woden naa yeladis» gadus.<verse eid="GEN 21:7" /></para>
  <para style="s1">Aggaaronne Isma7eele Goodeteth</para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 21:8" />Guuththa naazi diccidi dhanth duuxxides; Yisaaqi dhanththafe duuxxida gallas Abrahaamey gita diggisa diggisides. <verse eid="GEN 21:8" /><verse number="9" style="v" sid="GEN 21:9" />Gibxeppe yida Aggaara Abrahaames yelida naazi Isma7eeley Yisaaqa leqqizayssa Saaray be7ada, <verse eid="GEN 21:9" /><verse number="10" style="v" sid="GEN 21:10" />Abrahaame, «Hanno aylley naazi ta naa Yisaaqara mulekka laattontta gishshas aylleyonne izi naaza kessa goodda» gadus.<note caller="-" style="x"><char style="xo" closed="false">21:10 </char><char style="xt" closed="false"><ref loc="GAL 4:29-30">Gala 4:29-30</ref></char></note><verse eid="GEN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 21:11" />Ha yo7ozi ba naaza bochchiza gishshas Abrahaamey daroppe metotettides. <verse eid="GEN 21:11" /><verse number="12" style="v" sid="GEN 21:12" />Gido attiin Xoossi Abrahaame, «Ne zereththay Yisaaqa baggara xeygettanayssa gishshas aylley gishshassinne izi naaza gishshas daro metotoppa; Saaray nees yootizayssa ubbaa siya.<note caller="-" style="x"><char style="xo" closed="false">21:12 </char><char style="xt" closed="false"><ref loc="ROM 9:7">Oro 9:7</ref>; <ref loc="HEB 11:18">Ib 11:18</ref></char></note> <verse eid="GEN 21:12" /><verse number="13" style="v" sid="GEN 21:13" />Qasse tani izi ne zereth gidida gishshas aylley naaza kawoteth histtana» gides.<verse eid="GEN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 21:14" />Abrahaamey maalado wonttara dendidi guuththa kaththinne koddan haath ekkidi Aggaaro hashen toossidi izi naazakka izis immidi kessi yeddides; iza baada Bersaabehe geetettiza bazzon toylattadus. <verse eid="GEN 21:14" /><verse number="15-16" style="v" sid="GEN 21:15-16" />Haaththayka koddaafe wuriin iza, «Ta naazi hayqqishin uttada ta iza be7ikke» gaada naaza buura garsan woththada 200 wadha gidizaso mala baada heen uttadus; heenkka izakko simma uttada ba qaala dhoqqu histta yeekkadus.<verse eid="GEN 21:15-16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 21:17" />Xoossi naaza waaso siyides; saloppe Xoossa kiitanchchay Aggaaro xeygidi, «Aggaaree! Waanadii? Xoossi naazi ichchidason yeekkizayssa siyida gishshas babbofa; <verse eid="GEN 21:17" /><verse number="18" style="v" sid="GEN 21:18" />denda eqqa; naaza denththada ne kushen oykka; tani iza gita kawoteth histtana» gides. <verse eid="GEN 21:18" /><verse number="19" style="v" sid="GEN 21:19" />Xoossi izis haaththa olla bessiin baada koddan haath kunththadus; naazakka ushshadus. <verse eid="GEN 21:19" /><verse number="20" style="v" sid="GEN 21:20" />Xoossi naazara dees; naazikka diccidi bazzo biittan wondafe dukkiza as gidides. <verse eid="GEN 21:20" /><verse number="21" style="v" sid="GEN 21:21" />Izi Paaraane bazzon de7ishin iza aaya izas machcho Gibxeppe ekkadus.<verse eid="GEN 21:21" /></para>
  <para style="s1">Abrahaamenne Abimelekke Caaqo</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22" />He wode Abimelekkey ba wottadarata halaqa Pikoolera Abrahaamekko biidi, «Neni ooththiza ubbaan Xoossi nenara dees.<note caller="-" style="x"><char style="xo" closed="false">21:22 </char><char style="xt" closed="false"><ref loc="GEN 26:26">Medhe 26:26</ref></char></note> <verse eid="GEN 21:22" /><verse number="23" style="v" sid="GEN 21:23" />Neni ta bolla woykko ta nayta bolla woykko ta zereththa bolla baleththon gene ooththontta mala ha7i hayssan Xoossa sinththan taas caaqqa; tani nees ne kiyidayssaththo nenikka taassinne neni imaththateththan diza hayssa biittazas lo7o ooththa» gides.<verse eid="GEN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 21:24" />Abrahaamey, «Tani caaqqays» gides.<verse eid="GEN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 21:25" />He wode Abrahaamey Abimelekke aylleti ekkida haaththa olla gishshas Abimelekkes magannides. <verse eid="GEN 21:25" /><verse number="26" style="v" sid="GEN 21:26" />Gido attiin Abimelekkey, «Hessa ooni ooththidaakko tani erikke; nenikka qasse taas yootabeekka; tani hach gakkanaas hessa siyabeekke» gides.<verse eid="GEN 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 21:27" />Hessafe guye Abrahaamey dorsatanne miizata ehidi Abimelekkes immiin istti nam7ay caaqettida. <verse eid="GEN 21:27" /><verse number="28" style="v" sid="GEN 21:28" />Abrahaamey meheta giddofe laappun uzzi dorsata shaakkides. <verse eid="GEN 21:28" /><verse number="29" style="v" sid="GEN 21:29" />Abimelekkey Abrahaame, «Ha neni shaakkida laappun uzzota ays shaakkadii?» gi oychchides.<verse eid="GEN 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 21:30" />Abrahaamey, «Tani hayssa haaththa ollaa bookkidayssas markka gidana mala hayta laappun uzzota taappe ekka» gides.<verse eid="GEN 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 21:31" />Heen he nam7u asati caaqettida gishshas he sohoy Bersaabehe<note caller="+" style="f"><char style="fr" closed="false">21:31 </char><char style="fqa" closed="false">Bersaabehe: </char><char style="ft" closed="false">Bersaabehe guussi Ibraaweta qaalara, «Caaqo haaththa olla woykko Laappun Haaththa Olla» guussa.</char></note> geetettides.<verse eid="GEN 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 21:32" />Bersaabehen caaqo caaqettidayssafe guye Abimelekkeynne iza wottadarata halaqa Pikooley dendidi Filisxeeme biitta simmida. <verse eid="GEN 21:32" /><verse number="33" style="v" sid="GEN 21:33" />Abrahaamey Bersaabehen Tamarssike geetettiza mith tokkidi heen GODAA Mernaa Xoossa xeygidi goynnides.<note caller="+" style="f"><char style="fr" closed="false">21:33 </char><char style="ft" closed="false">Tamarssike geetettiza miththay izas geesay qaanth gidishin zambafe dummatiza miththa</char></note> <verse eid="GEN 21:33" /><verse number="34" style="v" sid="GEN 21:34" />Abrahaamey Filisxeeme biittan daro wode imaththateththan de7ides.<verse eid="GEN 21:34" /></para>
  <chapter eid="GEN 21" />
  <chapter number="22" style="c" sid="GEN 22" />
  <para style="s1">Abrahaame Paaceteth</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1" />Hessafe guye Xoossi Abrahaame paaccides; Xoossi, «Abrahaamee!» gi xeygiin Abrahaamey, «Yee!» gi koyides.<note caller="-" style="x"><char style="xo" closed="false">22:1 </char><char style="xt" closed="false"><ref loc="HEB 11:17-19">Ib 11:17-19</ref></char></note><verse eid="GEN 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 22:2" />Xoossi, «Neni siiqiza ne mexi issi naaza Yisaaqa ekkada Mooriya geetettiza biitta ba; baada heen tani nees bessiza issi zuma bollan iza xuugettiza yarsho ooththada taas yarsha» gides.<note caller="-" style="x"><char style="xo" closed="false">22:2 </char><char style="xt" closed="false"><ref loc="2CH 3:1">2Taari 3:1</ref></char></note><verse eid="GEN 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 22:3" />Wonteththa gallas Abrahaamey maalado wonttara dendidi hare caanides; ba aylletappe nam7atanne ba naa Yisaaqa banara ekkidi xuuggiza yarshos gidiza mith qeri ekkidi Xoossi izas yootidaso baanaas dendides. <verse eid="GEN 22:3" /><verse number="4" style="v" sid="GEN 22:4" />Bishe heedzdzanththa gallas Abrahaamey dhoqqu giidi yarsho yarshanasoza haahon be7ides. <verse eid="GEN 22:4" /><verse number="5" style="v" sid="GEN 22:5" />Abrahaamey ba aylleta, «Intte harezara hayssan diishshite; taninne ta naazi gede biidi Xoossas goynnidi intteko haa simmana» gides.<verse eid="GEN 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 22:6" />Abrahaamey yarsho miththaa denththidi naaza Yisaaqa toossidi baas tamanne shuka mashsha oykkides; istti nam7ay issife bishin, <verse eid="GEN 22:6" /><verse number="7" style="v" sid="GEN 22:7" />Yisaaqi ba aawa Abrahaame, «Aabboo!» gides.</para>
  <para style="p" vid="GEN 22:7">Abrahaameykka, «Yee! Ta naazoo!» giin Yisaaqi, «Tamaynne miththi dees shin yarshettana dorsay awanee?» gides.<verse eid="GEN 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 22:8" />Abrahaameykka, «Ta naazoo! Yarshettana dorsaa Xoossi giigsana» gides; histtiin istti nam7ay issife bida.<verse eid="GEN 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 22:9" />Istti Xoossi izas yootidaso gakkida wode Abrahaamey yarsho yarshizaso heen giigsidi miththaa korides; ba naa Yisaaqa qachchidi he miththaa bollan shukkanaas ishisides.<note caller="-" style="x"><char style="xo" closed="false">22:9 </char><char style="xt" closed="false"><ref loc="JAS 2:21">Yaaqo 2:21</ref></char></note> <verse eid="GEN 22:9" /><verse number="10" style="v" sid="GEN 22:10" />Abrahaamey ba naaza shukkanaas kushe yeddidi mashsha ekkides. <figure style="fig" alt="Isaac on altar, Abraham with hands toward heaven" file="LB00291B.TIF" size="span" ref="22:10">Abrahaamey ba naa Yisaaqa yarshanaas hanishin</figure> <verse eid="GEN 22:10" /><verse number="11" style="v" sid="GEN 22:11" />Gido attiin GODAA kiitanchchay saloppe iza, «Abrahaamee! Abrahaamee!» gi xeygiin izi, «Yee!» gi koyiin,<verse eid="GEN 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 22:12" />«Naaza bolla ne kushe woththofa; iza aykkoka ooththofa; neni ne mexi issi naazakka tana diggontta gishshas neni Xoossas yayyiza as gididayssa tani ha7i eradis» gides.<verse eid="GEN 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 22:13" />Abrahaamey dhoqqu giidi xeellishin kacey turan oykettida dharsho be7ides; Abrahaamey biidi he dharshoza ekkidi xuugettiza yarsho yarshides. <verse eid="GEN 22:13" /><verse number="14" style="v" sid="GEN 22:14" />Hessa gishshas Abrahaamey he sohoza, «GODAY immizaso» gi sunththides; hach gakkanaaska he sohozi, «GODAY zuma bollan immana» geetettees.<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">GODAY immizaso gizayssi Ibraaweta qaalara Yahiwe yir7a gidishin birsheththay, «GODAY beyees» guussa</char></note><verse eid="GEN 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 22:15" />GODAA kiitanchchay saloppe nam7anththo Abrahaame xeygidi, <verse eid="GEN 22:15" /><verse number="16" style="v" sid="GEN 22:16" />«Tani nees tanan caaqqays; neni hayssa ooththida gishshas ne mexi issi naazakka tana diggontta gishshas,<note caller="-" style="x"><char style="xo" closed="false">22:16-17 </char><char style="xt" closed="false"><ref loc="HEB 6:13-14">Ib 6:13-14</ref></char></note> <verse eid="GEN 22:16" /><verse number="17" style="v" sid="GEN 22:17" />tani nena tumu anjjana; ne zereththaaka tani salo xoolintte malanne abba doonan diza ace mala ooththada darsana; ne zereththati ba morkketa katamata laattana.<note caller="-" style="x"><char style="xo" closed="false">22:17 </char><char style="xt" closed="false"><ref loc="HEB 11:12">Ib 11:12</ref></char></note> <verse eid="GEN 22:17" /><verse number="18" style="v" sid="GEN 22:18" />Neni taas azazettida gishshas ha kawoteththay wuri ne zereththa baggara anjjettana» gides.<note caller="-" style="x"><char style="xo" closed="false">22:18 </char><char style="xt" closed="false"><ref loc="ACT 3:25">Hawa 3:25</ref></char></note><verse eid="GEN 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 22:19" />Hessafe guye Abrahaamey ba aylletakko simmiin istti wuri issife Bersaabehe dendi bida. Abrahaamey Bersaabehen de7ides.<verse eid="GEN 22:19" /></para>
  <para style="s1">Naakoore Yeleta</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20" />Hessafe simmiin Abrahaames, «Milkay ne isha Naakoores nayta yeladus. <verse eid="GEN 22:20" /><verse number="21" style="v" sid="GEN 22:21" />Isttika, bayra naa Uuxe, Uuxe ishata Buuze, <verse eid="GEN 22:21" /><verse number="22" style="v" sid="GEN 22:22" />Aaraame aawa Qamu7eele, Keesade, Haazo, Pildaase, Yidilaafe, Baatu7eele geetetteettes. <verse eid="GEN 22:22" /><verse number="23" style="v" sid="GEN 22:23" />Heyta he osppun naytakka Milka Abrahaame isha Naakoores yeladus; Baatu7eeli Irbiqa yelides. <verse eid="GEN 22:23" /><verse number="24" style="v" sid="GEN 22:24" />Erehimo geetettiza iza garadeya qasse Xebaahe, Gehaame, Tehaashanne Makisa yeladus» gi yootida.<verse eid="GEN 22:24" /></para>
  <chapter eid="GEN 22" />
  <chapter number="23" style="c" sid="GEN 23" />
  <para style="s1">Saara Hayqo</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1" />Saaray 127 layth de7idaappe guye, <verse eid="GEN 23:1" /><verse number="2" style="v" sid="GEN 23:2" />iza Kanaane biittan diza (Kebroone geetettiza) Qiriyaate-Arba7e katamaan hayqqiin Abrahaamey Saaras yeekkidessinne kayottides.<verse eid="GEN 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 23:3" />Abrahaamey ba machchey aha achchafe Hiitetakko biidi, <verse eid="GEN 23:3" /><verse number="4" style="v" sid="GEN 23:4" />«Tani intte giddon imaththa; ta machcheyo mooganaas taas intte gadeppe moogoso bayzerketii!» gides.<note caller="-" style="x"><char style="xo" closed="false">23:4 </char><char style="xt" closed="false"><ref loc="HEB 11:9">Ib 11:9</ref>; <ref loc="HEB 13">13</ref>; <ref loc="ACT 7:16">Hawa 7:16</ref></char></note><verse eid="GEN 23:4" /></para>
  <para style="p">
    <verse number="5-6" style="v" sid="GEN 23:5-6" />Hiiteti izas, «Godoo! Nuni nena yootizayssa siya; neni nu giddon gita asa; neni ne machchey aha nu duufoppe nena lo7idaason mooga; neni ne machchey aha mooganaas ba duufo oonikka nena diggenna» gi zaarida.<verse eid="GEN 23:5-6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 23:7" />Abrahaamey dendi eqqidi Hiiteta halaqata sinththan ziggides. <verse eid="GEN 23:7" /><verse number="8-9" style="v" sid="GEN 23:8-9" />Izi isttas, «Intte tana, ‹Ne machchey aha mooga› giikko siyite; Xoohaare naa Efroones iza gadeza gaxan diza Makipheele geetettiza gongoloza taas duufos bayzana mala kumeththa waagan nuna zal7iserketii» gides.<verse eid="GEN 23:8-9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 23:10" />He wode Efrooney katama pengen shiiqida ba asaa Hiiteta giddon dees; hessa gishshas Hiiteti wuri siyishin Abrahaames, <verse eid="GEN 23:10" /><verse number="11" style="v" sid="GEN 23:11" />«Hessa mala gidenna; ta godoo! Ta yootizayssa siya; tani gadezakka iza giddon diza gongolozakka ta nees hayssa asaa sinththan immadis; nekka ne machchey ahaa mooga» gides.<verse eid="GEN 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 23:12" />Abrahaamey halaqata sinththan qasseka ziggidi, <verse eid="GEN 23:12" /><verse number="13" style="v" sid="GEN 23:13" />asay siyishin Efroone, «Ta yootizayssa siyarkkii! Tani he gadezas waaga qanxxana; ne taappe ekkarkkii! Heen tani ta machchey aha moogana» gides.<verse eid="GEN 23:13" /></para>
  <para style="p">
    <verse number="14-15" style="v" sid="GEN 23:14-15" />Efrooney Abrahaames zaaridi, «Ta godoo! Tani yootizayssa siya; gadezi 400 saqile bira xalla kessiza gade gidida gishshas hayssi ne giddoninne ta giddon aykkoka gidenna; ne machchey aha izan mooga» gides. <verse eid="GEN 23:14-15" /><verse number="16" style="v" sid="GEN 23:16" />Abrahaamey Hiite asay siyishin Efrooney gida waaga 400 saqile bira Efroones immides.<verse eid="GEN 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 23:17" />Mamire katamaa achchan Makipheelen diza Efroone gaden diza gongoloynne he gaden diza miththay wuri, <verse eid="GEN 23:17" /><verse number="18" style="v" sid="GEN 23:18" />katamaa pengen shiiqida Hiite asaa ubbaa sinththan wogan Abrahaame gade gidides.<verse eid="GEN 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 23:19" />Hessafe guye Abrahaamey ba machcho Saara ahaa Kanaane biittan (Kebroone geetettiza) Mamire katama achchan diza gongolon moogides. <verse eid="GEN 23:19" /><verse number="20" style="v" sid="GEN 23:20" />Hessa gishshas he gadezinne gadezan diza gongolozi Hiiteta sinththan wogan Abrahaames gidides.<verse eid="GEN 23:20" /></para>
  <chapter eid="GEN 23" />
  <chapter number="24" style="c" sid="GEN 24" />
  <para style="s1">Yisaaqanne Irbiqa Gelonne Ekko</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1" />Abrahaamey daro cimmides; GODAY iza ubbaankka anjjides. <verse eid="GEN 24:1" /><verse number="2" style="v" sid="GEN 24:2" />Abrahaamey baso as ubbaas halaqatizayssanne izappe garsara iza aqota ubbaa ayssiza aylleza, «Ne kushe ta gulbate bolla woththada caaqqa.<note caller="+" style="f"><char style="fr" closed="false">24:2,9 </char><char style="ft" closed="false">Ne kushe ta gulbate bolla woththada caaqqa woykko ta wodirappe garsara gizayssi Ibraaweta wogan laamettontta caaqo gididayssa bessees</char></note> <verse eid="GEN 24:2" /><verse number="3" style="v" sid="GEN 24:3" />Tani istta giddon diza Kanaane macca naytappe ne ta naas machcho oychchontta mala salo sa7a medhdhida Xoossaan ta nees caaqqays; <verse eid="GEN 24:3" /><verse number="4" style="v" sid="GEN 24:4" />gido attiin ta yelettida biitta ta dabbotakko baada, ta naa Yisaaqas machcho oychcha» gides.<verse eid="GEN 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 24:5" />Iza oosanchchazi, «Maccassaya tanara yaanaas dosontta ixxiko naaza neni yida biittaa guye zaara efoo?» gi oychchides.<verse eid="GEN 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 24:6" />Abrahaamey, «Ta naaza gede guye zaara efontta mala naagetta! <verse eid="GEN 24:6" /><verse number="7" style="v" sid="GEN 24:7" />GODAA salo Xoossay tana ta aawa sohoppenne ta yelettida biittaafe kessidayssi taas, ‹Ne zereththas tani hayssa biittaa immana› gi caaqqidayssi neni ta naas heeppe machcho demmana mala izi ba kiitanchcha neeppe sinththe kiittana. <verse eid="GEN 24:7" /><verse number="8" style="v" sid="GEN 24:8" />Maccassaya nenara guye yaanaas dosontta ixxiko hayssi tani nena caaqeththida caaqoy nees gometoppo; naaza guye mulekka efoppa» gides. <verse eid="GEN 24:8" /><verse number="9" style="v" sid="GEN 24:9" />Hessa gishshas oosanchchazi ba godaa Abrahaame wodira bolla ba kushe woththi caaqqides.<verse eid="GEN 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 24:10" />Hessafe guye oosanchchazi ba godaa gaamellatappe tammata ekkidi ba godaa miishshafekka muuruta muuruta ekkidi bides; Mesphexoomiya geetettiza biittan diza Naakoore katama gakkides. <verse eid="GEN 24:10" /><verse number="11" style="v" sid="GEN 24:11" />Omarsa wode maccassi haath duuqqanaas yishin katamaappe gaxan haaththa olla achchan ba gaamellata gulbatissidi,<verse eid="GEN 24:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 24:12" />«GODAWU! Ta godaa Abrahaame Xoossoo! Hach tani qoppada yidayssa taas injjesa; qasse ta godaa Abrahaames kiya ooththa. <verse eid="GEN 24:12" /><verse number="13" style="v" sid="GEN 24:13" />Beya! Tani hayssa pultto haaththa achchan eqqadis; ha katama asaa macca nayti haath duuqqanaas haa yeettes. <verse eid="GEN 24:13" /><verse number="14" style="v" sid="GEN 24:14" />Tani, ‹Ane otoza ziqqi histtada tana haath ushsha› giza wode, izakka, ‹Hekko uya! Qasse ne gaamellatakka tani ushshana› gizaara hinna ne aylle; Yisaaqas neni dooridaaro gidu; neni ta godaas kiya ooththidayssa tani hessan erana» gi woossides.<verse eid="GEN 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 24:15" />Buro izi woosa wursontta dishin Irbiqay haaththa oto tookka ekkada puttu gadus; izo Baatu7eeli yelides; Baatu7eeli Milka naa; Milkay Abrahaame isha Naakoore machcho. <verse eid="GEN 24:15" /><verse number="16" style="v" sid="GEN 24:16" />Irbiqay daro mala lo7onne gelontta geela7o. Duge wodhdhada pulttozappe ba oto haath kunththada kezadus. <verse eid="GEN 24:16" /><verse number="17" style="v" sid="GEN 24:17" />He aylley izikko woxxi biidi izo, «Ne otozappe tana guuththa haath ushsharkkii!» gides.<verse eid="GEN 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 24:18" />Iza, «Ero ta godoo! Uya» gadus. Eesotada otoza ba hasheppe woththada geddi histta oykkada iza ushshadus. <verse eid="GEN 24:18" /><verse number="19" style="v" sid="GEN 24:19" />Iza ushshidayssafe guye, «Ne gaamellatikka alana gakkanaas tani isttas haath duuqqana» gadus. <verse eid="GEN 24:19" /><verse number="20" style="v" sid="GEN 24:20" />Attida haaththe eeson haaththa gonggen tigada duuqqanaas haaththa ollay dizaso woxxadus; gaamellati wuri alana gakkanaas haaththaa ollafe duuqqa duuqqa ehada haaththa gonggen tigada ushshadus. <verse eid="GEN 24:20" /><verse number="21" style="v" sid="GEN 24:21" />Izi qoppidi yida qofaa GODAY injjesidaakko erana mala addezi co7u giidi izo xeellees.<verse eid="GEN 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 24:22" />Gaamellati haath uyi simmiin addezi ichchash giraame bagga gidiza worqqa sagayotanne 100 giraame gidiza nam7u worqqa sagayota, <verse eid="GEN 24:22" /><verse number="23" style="v" sid="GEN 24:23" />kessidi izo, «Neni oona naa? Ane taas yoota; ne aawa soon nuus aqizasoy daanee?» gides.<verse eid="GEN 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 24:24" />Iza, «Tani Milkay Naakoores yelida Baatu7eele naa. <verse eid="GEN 24:24" /><verse number="25" style="v" sid="GEN 24:25" />Nuson gidiza happaynne bassoy dees; qasse intteska aqizasoy dees» gadus.<verse eid="GEN 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 24:26" />Addezi gulbatidi GODAAS goynnishe, <verse eid="GEN 24:26" /><verse number="27" style="v" sid="GEN 24:27" />«Ba kiyateththaanne ba tumaa ta godaappe haassontta ta godaa Abrahaame GODAA Xoossay galatetto! Tani yishin GODAA Xoossay tana ta godaa dabbotaso kaaleththides» gides.<verse eid="GEN 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 24:28" />Naya woxxa baada, ba aayeyson diza asaas hanidayssa yootadus. <verse eid="GEN 24:28" /><verse number="29" style="v" sid="GEN 24:29" />Irbiqas Laaba geetettiza ishay dees; Laabay kare kezidi haaththa pultto achchan diza addezakko woxxides. <verse eid="GEN 24:29" /><verse number="30" style="v" sid="GEN 24:30" />Qalabatenne ba michchey kushen diza sagayota be7ida malanne Irbiqay addezi bana gidayssa yootiin siyida mala kezi biidi addezi gaamellatara pulttoza achchan eqqidayssa demmides. <verse eid="GEN 24:30" /><verse number="31" style="v" sid="GEN 24:31" />Iza, «Haysso GODAY nena anjjidaysso haa ya! Neni hayssan karen ays eqqadii? Tani nees keeththinne gaamellataska soo giigsadis» gides.<verse eid="GEN 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 24:32" />Hessa gishshas addezi soo gelides; Laabay gaamellata caanaa birshidi happanne basso gaamellatas yeggides. Izassinne izara diza asatas toho haath ehides. <verse eid="GEN 24:32" /><verse number="33" style="v" sid="GEN 24:33" />Qumakka iza sinth aaththides; izi, «Tana ehida guddaa inttes yootontta dashe kath miikke» gides.</para>
  <para style="p" vid="GEN 24:33">Laabay, «Histtiko yoota» gides.<verse eid="GEN 24:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 24:34" />Hessa gishshas izi, «Tani Abrahaame aylle. <verse eid="GEN 24:34" /><verse number="35" style="v" sid="GEN 24:35" />GODAY ta godaa Abrahaame keehi anjjiin izi duretides; dors, miiz, bira, worqqa, attuma aylleta, macca aylleta, gaamellatanne, hareta izas immides. <verse eid="GEN 24:35" /><verse number="36" style="v" sid="GEN 24:36" />Ta godaa machchiya Saaray ba cimateththa layththan izas attuma naa yeliin izi baas dizaaz ubbaa izas immides. <verse eid="GEN 24:36" /><verse number="37" style="v" sid="GEN 24:37" />Ta goday tana hayssaththo caaqisides; ‹Tani diza Kanaane biitta macca naytappe ta naazas machcho oychchofa; <verse eid="GEN 24:37" /><verse number="38" style="v" sid="GEN 24:38" />ta aawa asaakko ta zereththaako baada ta naazas machcho oychcha› gides. <verse eid="GEN 24:38" /><verse number="39" style="v" sid="GEN 24:39" />Tanikka ta godawu, ‹Naya tanara yaanaas dosontta ixxikochchii?› gadis. <verse eid="GEN 24:39" /><verse number="40" style="v" sid="GEN 24:40" />Izi, ‹GODAY tani iza sinththan suure hemettida Xoossi nenara ba kiitanchcha kiittana; neni ta nees ta aawa asaappe, ta zaretappe machcho demmana mala, ne biza oge ubbaa lo7eththana. <verse eid="GEN 24:40" /><verse number="41" style="v" sid="GEN 24:41" />Neni ta zaretakko biin istti nees izo immontta ixxiko he wode nees caaqoy gomettenna› gides.<verse eid="GEN 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 24:42" />«Tani hach hayssa pulttozaakko yida wode GODAWU! Ta godaa Abrahaame Xoossoo! Ne shene gidikko tani biza qofaza injjesa. <verse eid="GEN 24:42" /><verse number="43" style="v" sid="GEN 24:43" />Be7a; tani ha pulttoza achchan eqqadis; geela7o issiniya haaththe duuqqanaas yiikko tani izo, ‹Tana ne otozappe guuththa haath ushsharkkii!› gaana. <verse eid="GEN 24:43" /><verse number="44" style="v" sid="GEN 24:44" />Histtiko iza tana, ‹Ero uya› qasse, ‹Ne gaamellataska tani haath duuqqana› gizaara Xoossi ta GODAY nees dooridaaro gidu.<verse eid="GEN 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 24:45" />«Tani ta wozinan woossizayssa wursontta dishin Irbiqay ba oto hashen tookka ekkada puttu gadus; duge pulttaako wodhdhada haath duuqqadus; tani izo, ‹Tana haath ushsharkkii!› gadis.<verse eid="GEN 24:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 24:46" />«Iza eeson ba hasheppe otoza woththada, ‹Hekko uya! Qasse tani ne gaamellata ushshana› gadus; tanikka uyadis; qasse ta gaamellatakka ushshadus.<verse eid="GEN 24:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="GEN 24:47" />«Tani izo, ‹Neni oona naa?› ga oychchadis.</para>
  <para style="p" vid="GEN 24:47">«Iza, ‹Tani Milkay Naakoores yelida Baatu7eele naa› gadus.</para>
  <para style="p" vid="GEN 24:47">«Tanikka izi kushen qalabate aaththadis. <verse eid="GEN 24:47" /><verse number="48" style="v" sid="GEN 24:48" />Hessafe guye tani gulbatada GODAAS goynnadis; tani GODAA ta godaa Abrahaame Xoossa, ta godaa isha nayo iza nees ekkanaas tana likke oge kaaleththidayssa galatays. <verse eid="GEN 24:48" /><verse number="49" style="v" sid="GEN 24:49" />Ha7ikka intte ta godaas kiyana malanne ammanettanaa gidikko taas yootite; hessi hanenna giikkoka taas yootite; hessafe guye tani hananayssa ta erays» gides.<verse eid="GEN 24:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 24:50" />Laabaynne Baatu7eeli, «Ha qofazi GODAAPPE yides; nuni nees gede haa gaanaas dandayokko. <verse eid="GEN 24:50" /><verse number="51" style="v" sid="GEN 24:51" />Irbiqa hanno beya; ekkada ba! GODAY gida mala ne godaa naazas machcho gidu» gida.<verse eid="GEN 24:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="GEN 24:52" />Abrahaame aylley istti gizayssa siyida mala biittan gulbatidi Xoossas goynnides. <verse eid="GEN 24:52" /><verse number="53" style="v" sid="GEN 24:53" />Ashkarazi bira alleqonne worqqaa alleqo, may7oka kessidi Irbiqas immides; qasse al7o miishshata izi ishassinne izi aayeys immides.<verse eid="GEN 24:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="GEN 24:54" />Hessafe guye izikka izara dizayti midanne uyida; histtidi heen aqida; istti maalado wonttara dendiin, «Tana ta godaakko moyzite» gides.<verse eid="GEN 24:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 24:55" />Gido attiin izi ishaynne izi aaya, «Naya issi tammu gallassa mala nunara takku; hessafe guye iza baana» gida.<verse eid="GEN 24:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 24:56" />Izi gidikko, «GODAY tani yidayssa injjesiin intte tana gam7isopite; tani ta godaakko baana mala tana moyzite» gides.<verse eid="GEN 24:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="GEN 24:57" />Isttika, «Nayo xeygidi ane nu izo oychchoos» gida. <verse eid="GEN 24:57" /><verse number="58" style="v" sid="GEN 24:58" />Hessa gishshas Irbiqa xeygidi, «Ha addezara baanee?» gi oychchida.</para>
  <para style="p" vid="GEN 24:58">Izakka, «Ee; tani baana» gadus.<verse eid="GEN 24:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="GEN 24:59" />Histtiin istti ba michcheyo Irbiqa izo dichchizaarira, Abrahaame ayllezaranne iza asatara moyzida. <verse eid="GEN 24:59" /><verse number="60" style="v" sid="GEN 24:60" />Istti Irbiqa,</para>
  <para style="q2" vid="GEN 24:60">«Nu michcheye Irbiqaa!</para>
  <para style="q2" vid="GEN 24:60">Coratta biitta kuma;</para>
  <para style="q2" vid="GEN 24:60">ne zereththi ba morkketa katamata laattetto» gi anjjida.<verse eid="GEN 24:60" /></para>
  <para style="m">
    <verse number="61" style="v" sid="GEN 24:61" />Hessafe guye Irbiqaynne izi garadeti dendidi gaamellata toggidi addezara bida; histtiin ayllezi Irbiqa ekkidi bides.<verse eid="GEN 24:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="GEN 24:62" />He wode Yisaaqi, «Tana Be7iza De7o Xoossaa Pultto» giza pulttoza mata biidi, Negebe bazzon dees. <verse eid="GEN 24:62" /><verse number="63" style="v" sid="GEN 24:63" />Issi gallassa omars Yisaaqi ba wozinan qoppidi demba kezidi yuuyishe izi dhoqqu gi xeelliza wode gaamellati yizayta be7ides. <verse eid="GEN 24:63" /><verse number="64" style="v" sid="GEN 24:64" />Irbiqaykka dhoqqu histta xeellada Yisaaqa beyada gaamellaa bollafe wodhdhadus. <verse eid="GEN 24:64" /><verse number="65" style="v" sid="GEN 24:65" />Wodhdhada aylleza, «Nunara gaagganaas sekki dembara haa yiza addey oonee?» gadus.</para>
  <para style="p" vid="GEN 24:65">Ashkarazi, «Izi ta godaa deennee» gides; iza ba shaasheza ekkada gullunttadus.<verse eid="GEN 24:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="GEN 24:66" />Qasse ayllezi ba ooththidayssa ubbaa Yisaaqas yootides. <verse eid="GEN 24:66" /><verse number="67" style="v" sid="GEN 24:67" />Yisaaqi Irbiqa ba aayey Saara dunkaanen efidi izo machcho ekkides; izakka izas machcho gidadus; histtiin izi izo siiqidessinne ba aayey hayqon kayottizayssafe minettides.<verse eid="GEN 24:67" /></para>
  <chapter eid="GEN 24" />
  <chapter number="25" style="c" sid="GEN 25" />
  <para style="s1">Abrahaames Yelettida Hara Nayta</para>
  <para style="r">(<ref loc="1CH 1:32-33">1Taari 1:32-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1" />Qasse Abrahaamey Keexura geetettiza hara machcho ekkides. <verse eid="GEN 25:1" /><verse number="2" style="v" sid="GEN 25:2" />Iza Zimiraane, Yoqishaane, Medaane, Midiyaane, Yishibaaqenne Shuha izas yeladus.<verse eid="GEN 25:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 25:3" />Yoqishaaney Saabanne Dadaane yelides; Dadaaney Asooreta, Lexuusetanne Le7aameta yelides.<verse eid="GEN 25:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 25:4" />Midiyaane nayti Eefa, Efere, Heenooke, Abida7enne Elda7e. Hayti wurikka Keexura nayta.<verse eid="GEN 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 25:5" />Abrahaamey ba haaro ubbaa Yisaaqa laatissides. <verse eid="GEN 25:5" /><verse number="6" style="v" sid="GEN 25:6" />Gido attiin izi buro paxa dishe ba garadetappe yelida naytas baas dizayssafe woytides. Woytidi ba naa Yisaaqappe istta shaakkidi arshey mokkiza baggara diza dere yeddides.<verse eid="GEN 25:6" /></para>
  <para style="s1">Abrahaame Hayqo</para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7" />Abrahaamey mulera 175 layth de7ides. <verse eid="GEN 25:7" /><verse number="8" style="v" sid="GEN 25:8" />Abrahaamey daro wode de7idi lo7o cima cimmidi hayqqides. <verse eid="GEN 25:8" /><verse number="9" style="v" sid="GEN 25:9" />Iza nayti Yisaaqinne Isma7eeley iza Makipheele geetettiza gongolo duufon moogida; he gongolozi Mamire achchan Hiite Xoohaare naa Efroone gaden dees. <verse eid="GEN 25:9" /><verse number="10" style="v" sid="GEN 25:10" />Hessika Abrahaamey Hiitetappe shammida gade. Abrahaamey ba machchiya Saaray moogettidason moogettides.<note caller="-" style="x"><char style="xo" closed="false">25:10 </char><char style="xt" closed="false"><ref loc="GEN 23:3-16">Medhe 23:3-16</ref></char></note> <verse eid="GEN 25:10" /><verse number="11" style="v" sid="GEN 25:11" />Abrahaamey hayqqidaappe guye Xoossi iza naa Yisaaqa anjjides. He wode Yisaaqi, «Tana Be7iza De7o Xoossaa Pultto» geetettiza pultto achchan dees.<verse eid="GEN 25:11" /></para>
  <para style="s1">Isma7eele Yeleta</para>
  <para style="r">(<ref loc="1CH 1:28-31">1Taari 1:28-31</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12" />Saara aylleya Gibxeppe yida Aggaara Abrahaames yelida naaza Isma7eele yeletay hayssafe kaalli xaafettidayssa. <verse eid="GEN 25:12" /><verse number="13" style="v" sid="GEN 25:13" />Isma7eele nayti ba sunththaninne ba yeleta maaran haytantta; heytanttika Nebayoote, Qeedaare, Adibi7eele, Mibisaame, <verse eid="GEN 25:13" /><verse number="14" style="v" sid="GEN 25:14" />Mishima7e, Duuma, Maase, <verse eid="GEN 25:14" /><verse number="15" style="v" sid="GEN 25:15" />Hadaade, Teema, Yixure, Nafishaanenne Qeedima. <verse eid="GEN 25:15" /><verse number="16" style="v" sid="GEN 25:16" />Isma7eele nayti haytantta; istta sunththi istta mooththaaninne dizason dizason hayssa; isttas 12 zarkke halaqati deettes. <verse eid="GEN 25:16" /><verse number="17" style="v" sid="GEN 25:17" />Isma7eeley mulera 137 layth de7idi hayqqides; hayqqidi ba aawatan gaaggides. <verse eid="GEN 25:17" /><verse number="18" style="v" sid="GEN 25:18" />Isma7eele zereththi Gibxeppe arshey mokkiza baggan diza Hawilappenne Shuurappe giddon Asoore efiza oge achchan de7ida. Istti ba ishata ubbatara morkketeththan de7ida.<verse eid="GEN 25:18" /></para>
  <para style="s1">Yisaaqa Yeleta</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19" />Abrahaame naa Yisaaqa yeletay hayssafe kaalli xaafettidayssa. Abrahaamey Yisaaqa yelides. <verse eid="GEN 25:19" /><verse number="20" style="v" sid="GEN 25:20" />Yisaaqas layththay 40 gidida wode Irbiqa ekkides; iza Mesphexoomiyan diza Aaraame Baatu7eele nayonne Aaraame dere as Laaba michcho. <verse eid="GEN 25:20" /><verse number="21" style="v" sid="GEN 25:21" />Yisaaqi ba machchiya maynne gidida gishshas izis GODAA woossiin GODAY iza woosaa siyides; histtiin iza machchiya Irbiqaykka qanththatadus. <verse eid="GEN 25:21" /><verse number="22" style="v" sid="GEN 25:22" />Gido attiin izi ulo giddon diza nayti mentte gidida gishshas issoy issaara sugettida; histtiin iza, «Hayssi ta bolla ays hanizee?» gadus. Hessa gishshas Xoossaa oychchana biin,<verse eid="GEN 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 25:23" />GODAY izis, «Ne ulon nam7u kawoteththi dees; qasse ne ulon diza nam7u dere asati issoy issaafe shaakettana; issi dere asay hankkoytappe minnana; qasse bayray kaalozas haarettana» gides.<note caller="-" style="x"><char style="xo" closed="false">25:23 </char><char style="xt" closed="false"><ref loc="ROM 9:12">Oro 9:12</ref></char></note><verse eid="GEN 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 25:24" />Izis yelo wodey gakkiin iza 2 attuma nayta mentte yeladus. <verse eid="GEN 25:24" /><verse number="25" style="v" sid="GEN 25:25" />Koyro yelettidayssi aarissa; iza bollayka wuri iske xalla; hessa gishshas istti iza Eesawe<note caller="+" style="f"><char style="fr" closed="false">25:25 </char><char style="fqa" closed="false">Eesawe: </char><char style="ft" closed="false">Eesawe guussi Ibraaweta qaalara, «Iskama» guussa.</char></note> gi sunththida. <verse eid="GEN 25:25" /><verse number="26" style="v" sid="GEN 25:26" />Hessafe guye, iza ishay yelettishe Eesawe toho oykki yelettides; hessa gishshas iza Yaaqoobe<note caller="+" style="f"><char style="fr" closed="false">25:26 </char><char style="fqa" closed="false">Yaaqoobe: </char><char style="ft" closed="false">Yaaqoobe guussi Ibraaweta qaalara, «Qirphe oykkizayssa» guussa.</char></note> gi sunththida. Irbiqay istta yelida wode, Yisaaqas layththay usuppun tammu layththi gidides.<verse eid="GEN 25:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27" />Nayti diccida; Eesawey shankka eriza bazzo as gidides; gido attiin Yaaqoobey dunkaanen diza ashke as gidides. <verse eid="GEN 25:27" /><verse number="28" style="v" sid="GEN 25:28" />Yisaaqi Eesawe siiqides; ays giikko izi shankkatidayssafe maanaas dosides; gido attiin Irbiqay Yaaqoobe siiqadus.<verse eid="GEN 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 25:29" />Issi wode Yaaqoobey woxe kaththishin Eesawe gafay wodhishin, bazzofe yides. <verse eid="GEN 25:29" /><verse number="30" style="v" sid="GEN 25:30" />Eesawey Yaaqoobe, «Tana hayssa zo7o woxezappe miza; tana gafay wodhees» gides. (Hessa gishshas qasse iza sunththi Eedoome<note caller="+" style="f"><char style="fr" closed="false">25:30 </char><char style="fqa" closed="false">Eedoome: </char><char style="ft" closed="false">Eedoome guussi Ibraaweta qaalara, «Zo7o» guussa.</char></note> geetettides.)<verse eid="GEN 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 25:31" />Yaaqoobey iza, «Koyro taas ne bayrateththaa bayza» gides.<verse eid="GEN 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 25:32" />Histtiin Eesawey, «Hekko! Ta hayqqana gays hanna ta bayrateththaya tana ay maaddanee?» gides.<verse eid="GEN 25:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 25:33" />Yaaqoobey zaaridi, «Ane taas koyro neni caaqqa» gides; hizgiin izi caaqqides; ba bayrateththaaka Yaaqoobes bayzides.<note caller="-" style="x"><char style="xo" closed="false">25:33 </char><char style="xt" closed="false"><ref loc="HEB 12:16">Ib 12:16</ref></char></note> <verse eid="GEN 25:33" /><verse number="34" style="v" sid="GEN 25:34" />Hessafe simmiin Yaaqoobey Eesawes buddenanne misira woxe immiin izi midessinne uyides; hessafe guye dendidi bides; Eesawey ba bayrateththaa kadhides.<verse eid="GEN 25:34" /></para>
  <chapter eid="GEN 25" />
  <chapter number="26" style="c" sid="GEN 26" />
  <para style="s1">Yisaaqanne Abimelekke</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1" />He biittan kase Abrahaame woden diza koshaappe hara koshay dendides; histtiin Yisaaqi Filisxeeme kawo Abimelekkeko Geraare bides. <verse eid="GEN 26:1" /><verse number="2" style="v" sid="GEN 26:2" />GODAY Yisaaqas qonccidi, «Gibxe biitta duge booppa; tani nees yootiza biittan de7a. <verse eid="GEN 26:2" /><verse number="3" style="v" sid="GEN 26:3" />Ha biittan guuththa wode uttaashsha; tani nenara gidana; nena anjjana; ays giikko hayssa biittaa ubbaa tani neessinne ne zereththaas immana; tani ne aawa Abrahaames caaqo gelida ufayssa qaalaa minththana. <verse eid="GEN 26:3" /><verse number="4" style="v" sid="GEN 26:4" />Ne zereththaa tani salo xoolintte mala darsana; hayssa biitta ubbaa ta isttas immana; biitta asay ubbay ne zereththaa baggara anjjettana.<note caller="-" style="x"><char style="xo" closed="false">26:3-4 </char><char style="xt" closed="false"><ref loc="GEN 22:16-18">Medhe 22:16-18</ref></char></note> <verse eid="GEN 26:4" /><verse number="5" style="v" sid="GEN 26:5" />Gaasoykka Abrahaamey ta qaalaa siyidi azazettides; ta izas yootidayssa izi ubbaa naagida gishshassa» gides. <verse eid="GEN 26:5" /><verse number="6" style="v" sid="GEN 26:6" />Hessa gishshas Yisaaqi Geraaren de7ides.<verse eid="GEN 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 26:7" />He biitta asay Irbiqa gishshas denththidi Yisaaqa, «Hanna nees aazee?» gi oychchida.</para>
  <para style="p" vid="GEN 26:7">Izikka Irbiqay keeha mala lo7o gidida gishshas, «Tani iza ta machcho giikko ha asay izi geedon tana wodhanakkonne» gi babbida gishshas, «Hanna taas michcho» gides.<note caller="-" style="x"><char style="xo" closed="false">26:7 </char><char style="xt" closed="false"><ref loc="GEN 12:13">Medhe 12:13</ref></char></note><verse eid="GEN 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 26:8" />Yisaaqi heen daro wode didaappe guye Filisxeeme kawo Abimelekkey maskootera duge xeellidi Yisaaqi ba machcho Irbiqara idimettishe kaa7ishin<note caller="+" style="f"><char style="fr" closed="false">26:8 </char><char style="fqa" closed="false">Idimettishe kaa7ishin: </char><char style="ft" closed="false">Qaaqqatishe kaa7ishin gizayssi izira gayttanaas ziitizayssa bessees.</char></note> be7ides. <verse eid="GEN 26:8" /><verse number="9" style="v" sid="GEN 26:9" />Hessa gishshas Abimelekkey Yisaaqa xeygisidi, «Hekko iza nees machcho! Neni ays izo ta michcho gadii?» gi oychchides.</para>
  <para style="p" vid="GEN 26:9">Izikka, «Iza ta machcho giikko izi gaason asay tana wodhana gaada babbida gishshas gadis» gides.<verse eid="GEN 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 26:10" />Histtiin Abimelekkey, «Hayssi neni nu bolla ooththidayssi aazee? Ta asaappe issi asi ne machcheyra aqidaakko nu bolla gome ehashe aggadasa» gides. <verse eid="GEN 26:10" /><verse number="11" style="v" sid="GEN 26:11" />Hessa gishshas Abimelekkey ba asaa ubbaa, «Ha addeza woykko iza machcho bochchizay oonikka tumu hayqqo» gi azazides.<verse eid="GEN 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 26:12" />Yisaaqi he biittan kath zeriin GODAY iza anjjida gishshas he layththan xeetu kushe shiishshides. <verse eid="GEN 26:12" /><verse number="13" style="v" sid="GEN 26:13" />Izas aqotay dari dari bida gishshas keehi duretides. <verse eid="GEN 26:13" /><verse number="14" style="v" sid="GEN 26:14" />Yisaaqas dorsi, miiza wudeynne aylleti keehi darida gishshas Filisxeeme asay iza miqqaynides. <verse eid="GEN 26:14" /><verse number="15" style="v" sid="GEN 26:15" />Hessa gishshas iza aawa Abrahaame woden iza aawaa aylleti bookkida haaththa olla ubbaa Filisxeeme asay biitta zaaridi kunththides.<verse eid="GEN 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 26:16" />He wode Abimelekkey Yisaaqa, «Nuuppe shaakettada ba; neni nuuppe aadhdha minnadasa» gides. <verse eid="GEN 26:16" /><verse number="17" style="v" sid="GEN 26:17" />Hizgiin Yisaaqi heeppe dendidi Geraare shoobbaa biidi dunkaane tokkidi heen de7ides. <verse eid="GEN 26:17" /><verse number="18" style="v" sid="GEN 26:18" />Abrahaamey paxa dishe bookissida haaththa ollata Abrahaamey hayqqidaappe guye Filisxeeme asay tuccida haaththa ollata Yisaaqi qasseka bookkana mala ooththidi kase iza aaway sunththida sunththaan xeygides.<verse eid="GEN 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 26:19" />Yisaaqa aylleti shoobban haaththa olla bookkishe bookkiza ollaafe pulttiza haath demmida. <verse eid="GEN 26:19" /><verse number="20" style="v" sid="GEN 26:20" />Gido attiin Geraaren mehe heemmizayti Yisaaqa mehe heemmizaytara, «Haaththay nuyssa» gi ooyettida. Istti izara palamettida gishshas Yisaaqi he haaththa ollaa, «Eseqe»<note caller="+" style="f"><char style="fr" closed="false">26:20 </char><char style="fqa" closed="false">Eseqe: </char><char style="ft" closed="false">Eseqe guussi Ibraaweta qaalara, «Palama» guussa.</char></note> gi sunththides.<verse eid="GEN 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 26:21" />Hessafe guye istti hara haaththa ollaka bookkida; gido attiin istti he haaththa ollaa geedonkka ooyettida; hessa gishshas izi he haaththa ollaa, «Siixina»<note caller="+" style="f"><char style="fr" closed="false">26:21 </char><char style="fqa" closed="false">Siixina: </char><char style="ft" closed="false">Siixina guussi Ibraaweta qaalara, «Morkketeth» guussa.</char></note> gi sunththides. <verse eid="GEN 26:21" /><verse number="22" style="v" sid="GEN 26:22" />Hessafe guuth haraso aadhdhi hara haaththa olla bookissides; iza gaason oonikka ooyettibeenna; «Xoossi ha7i nuus aassides; nuni ha biittan darana» giidi iza, «Oroboote»<note caller="+" style="f"><char style="fr" closed="false">26:22 </char><char style="fqa" closed="false">Oroboote: </char><char style="ft" closed="false">Oroboote guussi Ibraaweta qaalara, «Aahoso» guussa.</char></note> gi sunththides.<verse eid="GEN 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 26:23" />Hessafe guye Yisaaqi pude Bersaabehe geetettizaso kezides. <verse eid="GEN 26:23" /><verse number="24" style="v" sid="GEN 26:24" />Hee bida gallas qammara GODAY izas qonccidi, «Tani ne aawa Abrahaame Xoossa; tani nenara diza gishshas babbofa! Tani nena anjjana; ta aylle Abrahaame gishshas ne zereththaa ta darsana» gides. <verse eid="GEN 26:24" /><verse number="25" style="v" sid="GEN 26:25" />Yisaaqi heen yarshizaso keexxidi GODAA sunth xeygides; heen izi ba dunkaaneza tokkides; qasse heen iza aylleti haaththa olla bookkida.<verse eid="GEN 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26" />Hessafe guye Abimelekkey bana zoriza Ahuzaatanne ba wottadarata halaqa Pikoole ekkidi Geraareppe Yisaaqakko yides.<note caller="-" style="x"><char style="xo" closed="false">26:26 </char><char style="xt" closed="false"><ref loc="GEN 21:22">Medhe 21:22</ref></char></note> <verse eid="GEN 26:26" /><verse number="27" style="v" sid="GEN 26:27" />Yisaaqi isttas, «Intte kase tana ixxidi intte biittafe kessi yeddidi ha7i qasse taakko ay ekkana yidetii?» gides.<verse eid="GEN 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 26:28" />Istti iza, «GODAY nenara dizayssa tumu nuni qonccen be7idos; hessa gishshas nuussinne nees giddon caaqo qaalay de7ana koshshees goos. <verse eid="GEN 26:28" /><verse number="29" style="v" sid="GEN 26:29" />Gido attiin nuni nees kiyateth xalla ooththidi nena saroteththan moyzidos; hessaththoka neni nu bolla iita miish ooththontta mala ane nenara caaqo caaqettoos; ha7i nena GODAY anjjidayssi qonccides» gida. <verse eid="GEN 26:29" /><verse number="30" style="v" sid="GEN 26:30" />He wode Yisaaqi isttas gibira giigsiin midanne uyida. <verse eid="GEN 26:30" /><verse number="31" style="v" sid="GEN 26:31" />Wonteththa gallas maalado wonttara dendidi istti issoy issaara caaqettida. Yisaaqi istta moyziin istti izappe saron shaakettidi bida.<verse eid="GEN 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 26:32" />He gallas Yisaaqa aylleti yiidi ba bookkida haaththa ollaa gishshas, «Nuni haath demmidos» gi izas yootida. <verse eid="GEN 26:32" /><verse number="33" style="v" sid="GEN 26:33" />Izi he haaththa ollaa, «Saabehe»<note caller="+" style="f"><char style="fr" closed="false">26:33</char><char style="fqa" closed="false">Saabehe: </char><char style="ft" closed="false">Saabehe guussi caaqo guussa.</char></note> gi sunththides; hessa gishshas he katamaa sunththi hach gakkanaas Bersaabehe<note caller="+" style="f"><char style="fr" closed="false">26:33 </char><char style="fqa" closed="false">Bersaabehe: </char><char style="ft" closed="false">Bersaabehe guussi caaqo haaththa olla guussa.</char></note> geetettees.<verse eid="GEN 26:33" /></para>
  <para style="s1">Eesawey Ekkida Dawuththa Machcheta</para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34" />Eesawe layththi 40 gidida wode Bi7eere naa Yooditonne Eeloone naa Baasemaato machcho ekkides; istti nam7ayka Hiite biitta asa. <verse eid="GEN 26:34" /><verse number="35" style="v" sid="GEN 26:35" />Isttika Yisaaqanne Irbiqa mishisishe de7ida.<verse eid="GEN 26:35" /></para>
  <chapter eid="GEN 26" />
  <chapter number="27" style="c" sid="GEN 27" />
  <para style="s1">Yaaqoobe Anjjeteth</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1" />Yisaaqi cimmiin iza ayfey xeelo ixxida wode baas bayra naaza Eesawe xeygidi iza, «Ta naazoo!» gides.</para>
  <para style="p" vid="GEN 27:1">Histtiin izi, «Yee!» gi koyides.<verse eid="GEN 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 27:2" />Izikka, «Beya! Ha7i tani cimadis; tani ayde hayqqanaakkonne ta hayqqana gallas erikke. <verse eid="GEN 27:2" /><verse number="3" style="v" sid="GEN 27:3" />Hessa gishshas ha7i ne izara shankkatiza toora ekkada bazzo baada do7a shankkatada taas asho ekkada ya. <verse eid="GEN 27:3" /><verse number="4" style="v" sid="GEN 27:4" />Ta dosiza mal7o quma kaththada taas aaththa; hessika tani hayqqanaappe kase nena anjjanaassa» gides.<verse eid="GEN 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 27:5" />Irbiqay Yisaaqi ba naa Eesawes yootizayssa he wode siyadus; Eesawey do7a shankkatidi ehanaas bazzo biin, <verse eid="GEN 27:5" /><verse number="6" style="v" sid="GEN 27:6" />Irbiqay ba naaza Yaaqoobe, «Ne aaway ne ishaa Eesawe, <verse eid="GEN 27:6" /><verse number="7" style="v" sid="GEN 27:7" />‹Do7a shankkata ehada ta maana mala taas mal7o quma kaththa; histtiko ta hayqqontta dashe GODAA sinththan nena anjjana› gishin tani siyadis. <verse eid="GEN 27:7" /><verse number="8" style="v" sid="GEN 27:8" />Ta naazoo! Ha7i tani nena azazizayssa lo7eththada siya. <verse eid="GEN 27:8" /><verse number="9" style="v" sid="GEN 27:9" />Wudeza gars baada nam7u anqara deysha laaqqata taas ekkada ya; ne ehikko tani ne aawaas mal7o quma izi dosiza mala kaththana. <verse eid="GEN 27:9" /><verse number="10" style="v" sid="GEN 27:10" />Ne aaway miidi hayqqontta dishe miidi nena anjjana mala ehada miza» gadus.<verse eid="GEN 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 27:11" />Gido attiin Yaaqoobey ba aayo Irbiqas, «Ta isha Eesawe bollan iskey dees; gido attiin ta bollay liiqo. <verse eid="GEN 27:11" /><verse number="12" style="v" sid="GEN 27:12" />Ta aaway tana oykki beykkochii? Tani iza cimmizaa izas misatikko tani anjjo aggada qanggeththa ta bolla ehanaakko» gides.<verse eid="GEN 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 27:13" />Iza aayeya iza, «Ta naazoo! He qanggeththay tana gakko. Tani nees yootizayssa ne ooththa; baada deysha laaqqata taas ekka ya» gadus.<verse eid="GEN 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 27:14" />Izi ehidi ba aayeys immiin aayeya mal7o quma iza aaway dosida mala mal7eththa kaththadus. <verse eid="GEN 27:14" /><verse number="15" style="v" sid="GEN 27:15" />Hessafe guye Irbiqay soon ba achchan diza ba bayra naa Eesawe lo7o may7o ehada kaalo naaza Yaaqoobe mayzadus. <verse eid="GEN 27:15" /><verse number="16" style="v" sid="GEN 27:16" />Qasse he deyshata ite iza kusheninne iza qoodhen mayzadus. <verse eid="GEN 27:16" /><verse number="17" style="v" sid="GEN 27:17" />Histtada ba kaththida mal7o qumaanne ukeththaa ba naa Yaaqoobe kushen woththadus.<verse eid="GEN 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 27:18" />Histtiin izi ba aawaakko bi gelidi, «Ta aawawu!» gides.</para>
  <para style="p" vid="GEN 27:18">Izikka, «Yee! Ta naazoo! Neni oonee?» gides.<verse eid="GEN 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 27:19" />Yaaqoobey ba aawaas, «Tani ne bayra naa Eesawe; neni tana azazida mala tani ooththadis; suurada, tani shankkata ehidayssa ma; histtada tana anjja» gides.<verse eid="GEN 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 27:20" />Yisaaqi Yaaqoobe, «Ta naazoo! Wostta eeson demmadii?» gi oychchides.</para>
  <para style="p" vid="GEN 27:20">Izikka, «GODAY ne Xoossi tana maaddiina» gides.<verse eid="GEN 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 27:21" />Yisaaqi Yaaqoobe, «Ta naazoo! Neni tumu ta naa Eesawekkonne tani nena oykka be7anaas ane taakko haa shiiqa» gides. <verse eid="GEN 27:21" /><verse number="22" style="v" sid="GEN 27:22" />Yaaqoobey ba aawa Yisaaqakko shiiqiin oykki be7idi, «Hayssi qaalay Yaaqoobe qaala shin kushey Eesawe kushe» gides. <verse eid="GEN 27:22" /><verse number="23" style="v" sid="GEN 27:23" />Iza kushey iza ishaa Eesawe kusheththo iskera diza gishshas erontta iza anjjides. <verse eid="GEN 27:23" /><verse number="24" style="v" sid="GEN 27:24" />Iza, «Tumu neni ta naa Eesawee?» gi oychchides.</para>
  <para style="p" vid="GEN 27:24">Izikka, «Ee tanakko!» gides.<verse eid="GEN 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 27:25" />Izikka, «Ta naazoo! Tani neni shankkatidayssa maanaas haa aaththa; maada tani nena anjjana» gides. Yaaqoobey aaththiin izi mides; woyne ushshaaka ehiin uyides.<verse eid="GEN 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 27:26" />Hessafe guye iza aawa Yisaaqi, «Ta naazoo! Haa shiiqada tana yeera» gides.<verse eid="GEN 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 27:27" />Yaaqoobey shiiqidi iza yeerides; Yisaaqi iza may7o singi siyidi, «Ta naaza peenoy GODAY anjjida goshsha mala sawees.<note caller="-" style="x"><char style="xo" closed="false">27:27-29 </char><char style="xt" closed="false"><ref loc="HEB 11:20">Ib 11:20</ref></char></note> <verse eid="GEN 27:27" /><verse number="28" style="v" sid="GEN 27:28" />Xoossi salo iranne sa7a anjjo, kaththinne ooraththa woyne ushshu palahissidi nees immo. <verse eid="GEN 27:28" /><verse number="29" style="v" sid="GEN 27:29" />Kawoteththati nees haarettetto; asi wuri nees gulbato; neni ne ishatas godaa gida; ne aayey zereththi nees gulbato; nena qanggizay qanggettidaaz gido; nena anjjizay anjjettidayssa gido» gides.<note caller="-" style="x"><char style="xo" closed="false">27:29 </char><char style="xt" closed="false"><ref loc="GEN 12:3">Medhe 12:3</ref></char></note><verse eid="GEN 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30" />Yisaaqi Yaaqoobe anjji wursidaappe guye Yaaqoobey ba aawa Yisaaqa sinththafe kezida mala Eesawey shankkafe puttu gides. <verse eid="GEN 27:30" /><verse number="31" style="v" sid="GEN 27:31" />Izikka qasse mal7o qumaa kaththidi ba aawaas aaththides; aaththidi iza, «Ta aawawu! Suurada hayssa tani shankkatidayssafe ma; histtada tana anjja» gides.<verse eid="GEN 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 27:32" />Histtiin aaway Yisaaqi iza, «Ne oonee?» gi oychchides. Izi, «Tani nees bayra naaza Eesawe» gides.<verse eid="GEN 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 27:33" />Yisaaqi dagammidi kokkorishe, «Histtiin do7a shankkatidayssa ekkidi taas aaththiday oonee? Tani ha7i neni yaanaappe sinththe maada iza anjjadis; tumukka izi anjjettidayssa gidana» gides.<verse eid="GEN 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 27:34" />Eesawey ba aawaa qaala siyida mala ba qaalaa dhoqqu histtadi daro camo yeeho yeekkidi ba aawaa, «Tana anjja; ta aawawu tanakka anjja!» gides.<verse eid="GEN 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 27:35" />Gido attiin izi, «Ne ishay yiidi tana cimmidi ne anjjo ekkichchides» gides.<verse eid="GEN 27:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 27:36" />Eesawey, «Iza eridi Yaaqoobe<note caller="+" style="f"><char style="fr" closed="false">27:36 </char><char style="fqa" closed="false">Yaaqoobe: </char><char style="ft" closed="false">Yaaqoobe guussi Ibraaweta qaalara, «Cimmides woykko baleththides» guussa.</char></note> gi sunththides; izi tana cimmishin hayssi nam7anththo; izi ta bayrateththaa ekkides; qasse ha7ikka ta anjjo ekkides» gides; qasse zaaridi ba aawaa, «Neni taas anjjofe aykkoka ashshabeekkii?» gi oychchides.<note caller="-" style="x"><char style="xo" closed="false">27:36 </char><char style="xt" closed="false"><ref loc="GEN 25:29-34">Medhe 25:29-34</ref></char></note><verse eid="GEN 27:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 27:37" />Yisaaqi Eesawes, «Tani iza ne bolla godatana mala, iza ishati izas ooththana mala, kaththinne woyne ushshi palahana mala anjjadis; histtiin ta naazoo ta nees ha7i ay ooththana dandayazinaa?» gides.<verse eid="GEN 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 27:38" />Eesawey ba aawaa, «Ta aawawu nees dizay issi anjjo xallaa? Ta aawawu! Tanakka anjjarkkii!» gides. Hessafe guye Eesawey ba qaala dhoqqu histtidi yeekkides.<note caller="-" style="x"><char style="xo" closed="false">27:38 </char><char style="xt" closed="false"><ref loc="HEB 12:17">Ib 12:17</ref></char></note><verse eid="GEN 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 27:39" />Iza aawa Yisaaqi zaaridi, «Ne dizasoy ha sa7a dureteththaafe haakkana; salo iraykka nees bukkenna.<note caller="-" style="x"><char style="xo" closed="false">27:39-40 </char><char style="xt" closed="false"><ref loc="HEB 11:20">Ib 11:20</ref></char></note> <verse eid="GEN 27:39" /><verse number="40" style="v" sid="GEN 27:40" />Neni ne giththa mashshan aqana; neni ne ishaas haarettana; gido attiin neni izara eqettiko iza qambara ne morgefe diggana» gides.<note caller="-" style="x"><char style="xo" closed="false">27:40 </char><char style="xt" closed="false"><ref loc="GEN 36:8">Medhe 36:8</ref>; <ref loc="2KI 8:20">2Kawo 8:20</ref></char></note><verse eid="GEN 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 27:41" />Aaway Yaaqoobe anjjida gishshas Eesawey Yaaqoobe keehi ixxides; izi ba wozinara, «Ta aaway hayqqana matides; izi hayqqida mala ta ishaa Yaaqoobe ta wodhana» gides.<verse eid="GEN 27:41" /></para>
  <para style="s1">Yaaqoobe Beteth</para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 27:42" />Giddotiin Irbiqay hayssa ba bayra naaza Eesawe qaala siyida gishshas ba kaalo naa Yaaqoobe xeygisa ehada, «Ne ishay Eesawey nena wodhidi halo kessanaas koyees. <verse eid="GEN 27:42" /><verse number="43" style="v" sid="GEN 27:43" />Ha7ikka ta naazoo, tani nees yootizayssa ooththa. Denda! Dendada Kaaraanen diza ta isha Laabakko baqata! <verse eid="GEN 27:43" /><verse number="44" style="v" sid="GEN 27:44" />Histtada ne ishaa hanqoy dochchana gakkanaas imaththateththan izara daashsha. <verse eid="GEN 27:44" /><verse number="45" style="v" sid="GEN 27:45" />Ne ishay nees hanqettizayssa izi aggiza wodenne ne iza bolla ooththidayssa izi baliza wode tani kiittada nena heeppe ehisana; tani issi gallas inttefe nam7atappe mela attana mala koykke» gadus.<verse eid="GEN 27:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 27:46" />Hessafe guye Irbiqay Yisaaqa, «Eesawey ekkida Hiiteta macca nayta geedon duussay tana iitees; qasse Yaaqoobeykka heyta mala Hiiteta macca naytappe machcho ekkiko tani hekko hayqqanaas koyays» gadus.<verse eid="GEN 27:46" /></para>
  <chapter eid="GEN 27" />
  <chapter number="28" style="c" sid="GEN 28" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1" />Hessa gishshas Yisaaqi Yaaqoobe xeygidi, «Kanaane asaa macca naytappe nees machcho ekkofa. <verse eid="GEN 28:1" /><verse number="2" style="v" sid="GEN 28:2" />Dendada ne aayey aawa Baatu7eelekko, Mesphexoomiya biitta baada heeppe ne aayey isha Laaba macca naytappe issiniyo nees machcho ekka. <verse eid="GEN 28:2" /><verse number="3" style="v" sid="GEN 28:3" />Ubbaa Dandayza Xoossi nena anjjo; izi nees daro nayta immo; nena daro deres aawa histto. <verse eid="GEN 28:3" /><verse number="4" style="v" sid="GEN 28:4" />Abrahaame anjjida mala nenanne ne zereth Xoossi anjjo; hayssa Abrahaamey immida biittanne nekka imaththateththan de7ida biittaa nees immo» azazides.<note caller="-" style="x"><char style="xo" closed="false">28:4 </char><char style="xt" closed="false"><ref loc="GEN 17:4-8">Medhe 17:4-8</ref></char></note> <verse eid="GEN 28:4" /><verse number="5" style="v" sid="GEN 28:5" />Histtiin Yisaaqi Yaaqoobe yeddiin Yaaqoobey Mesphexoomiya biitta Laabakko bides. Laabay Yaaqoobenne Eesawe yelida Irbiqas ishanne Aaraame biitta as Baatu7eele naa.<verse eid="GEN 28:5" /></para>
  <para style="s1">Eesawey Ekkida Hara Machcheyo</para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 28:6" />Yisaaqi Yaaqoobe anjjidayssa heeppe machcho ekkanaas Mesphexoomiya biitta iza yeddidayssa qasseka izi Yaaqoobe anjjida wode, «Kanaane maccas ekkofa» gi azazidayssa siyides; <verse eid="GEN 28:6" /><verse number="7" style="v" sid="GEN 28:7" />Yaaqoobeykka ba aawassinne ba aayeys azazettidi Mesphexoomiya biitta bidayssa Eesawey erides. <verse eid="GEN 28:7" /><verse number="8" style="v" sid="GEN 28:8" />Eesawey iza aawa Yisaaqay Kanaane macca nayta ay mala ixxizaakkonne hessan erides. <verse eid="GEN 28:8" /><verse number="9" style="v" sid="GEN 28:9" />Hessa gishshas Eesawey Abrahaame naa Isma7eelekko biidi iza nayo Mahilaato ba machchey bolla gujji ekkides. Izakka Nebayoote michcho.<verse eid="GEN 28:9" /></para>
  <para style="s1">Yaaqoobe Agumo</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10" />Yaaqoobey Bersaabeheppe Kaaraane baanaas dendides. <verse eid="GEN 28:10" /><verse number="11" style="v" sid="GEN 28:11" />Izi issi soo gakkishin arshey wulliin heen aqides; he soon diza shuchchatappe issi shuch ekki borkotidi heen dhiskides. <verse eid="GEN 28:11" /><verse number="12" style="v" sid="GEN 28:12" />Agumozan biittan eqqidi xeeray pude salo gakkiza yangare be7ides; yangareza bolla Xoossa kiitanchchati duge wodhdhishininne pude kezishin be7ides.<note caller="-" style="x"><char style="xo" closed="false">28:12 </char><char style="xt" closed="false"><ref loc="JHN 1:51">Yoha 1:51</ref></char></note> <verse eid="GEN 28:12" /><verse number="13" style="v" sid="GEN 28:13" />Yangarezas bolla xeeran GODAY eqqidi iza, «Tani GODAA ne aawa Abrahaame Xoossa, Yisaaqa Xoossa. Ha ne ichchida biittaa ta neessinne ne zereththas immana.<note caller="-" style="x"><char style="xo" closed="false">28:13 </char><char style="xt" closed="false"><ref loc="GEN 13:14-15">Medhe 13:14-15</ref></char></note> <verse eid="GEN 28:13" /><verse number="14" style="v" sid="GEN 28:14" />Ne zereththay biitta ace mala darana; isttika oyddu bagga gakkana; biitta bollan diza asi wuri ne baggaranne ne zereththa baggara anjjettana. <verse eid="GEN 28:14" /><verse number="15" style="v" sid="GEN 28:15" />Tani nenara days; neni bizaso ubbaan tani nena naagana; qasse tani nena ha biitta guye zaarada ehana; tani nees ooththana gidayssa ooththana; nenakka yeggike» gides.<verse eid="GEN 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 28:16" />Yaaqoobey dhiskofe beeggidi, «Tani erabeekkefe attiin GODAY tumu hayssan dees» gides. <verse eid="GEN 28:16" /><verse number="17" style="v" sid="GEN 28:17" />Izi babbidi, «Hayssi ay mala babisizasoo! Hayssi Xoossa Keeththafe attiin haraso deenna; hayssi salo penge» gides.<verse eid="GEN 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 28:18" />Yaaqoobey wonteththa gallas maalado wonttara dendidi ba borkotida shuchchaa ekkidi tuussa mala essidi Xoossas dummasanaas iza bolla zayte gussides. <verse eid="GEN 28:18" /><verse number="19" style="v" sid="GEN 28:19" />Yaaqoobey he sohoza Beetele<note caller="+" style="f"><char style="fr" closed="false">28:19 </char><char style="fqa" closed="false">Beetele: </char><char style="ft" closed="false">Beetele guussi Ibraaweta qaalara, «Xoossa keeth» guussa.</char></note> gi sunththides; he katamaya hessafe kase Looza geetettawus.<verse eid="GEN 28:19" /></para>
  <para style="p">
    <verse number="20-21" style="v" sid="GEN 28:20-21" />Yaaqoobey, «Ne tanara gidada ta biza ogen ne tana naagikko taas miza qumanne may7o ne immiko ta aawa soo saron ne tana zaarikko neni GODAY ta Xoossa gidana. <verse eid="GEN 28:20-21" /><verse number="22" style="v" sid="GEN 28:22" />Tani tuussa mala essida ha shuchchay Xoossa keeth gidana; neni taas immiza ubbaafe tammaafe issi kushe tani nees immana» gi adinettides.<verse eid="GEN 28:22" /></para>
  <chapter eid="GEN 28" />
  <chapter number="29" style="c" sid="GEN 29" />
  <para style="s1">Yaaqoobey Laaba Soon</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1" />Hessafe guye Yaaqoobey dendi biidi arshey mokkiza baggara diza asata dere gakkides. <verse eid="GEN 29:1" /><verse number="2" style="v" sid="GEN 29:2" />Histtidi issi demban haaththa ollay dizayssa be7ides; heedzdzu cuga dorsi qasse he haaththa olla achchan ichchides; ays giikko wudey wuri haath uyizay he ollazappe; he haaththa ollaa doona tuchcha shuchchayka gita. <verse eid="GEN 29:2" /><verse number="3" style="v" sid="GEN 29:3" />Dorsa wudey wuri heen shiiqida wode wudeza heemmizayti haaththa olla doonappe he shuchchaa genderisidi dorsaa ushsheettes. Ushshidi he shuchchaa haaththa ollaan zaaridi tucceettes.<verse eid="GEN 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 29:4" />Yaaqoobey isttas, «Haytoo! Intte awappe yidetii?» gi oychchides.</para>
  <para style="p" vid="GEN 29:4">Isttika, «Nuni Kaaraaneppe yidos» gi yootiin, <verse eid="GEN 29:4" /><verse number="5" style="v" sid="GEN 29:5" />izi, «Naakoores naaza naa Laaba ereetii?» gides.</para>
  <para style="p" vid="GEN 29:5">Isttika, «Ee, iza nu eroos» gida.<verse eid="GEN 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 29:6" />Yaaqoobey isttas, «Izi lo7o dizee?» gi oychchiin, «Ee, lo7okko; iza naa Eraheelo dors ekka yizaaro hanno beya» gida.<verse eid="GEN 29:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 29:7" />Histtiin Yaaqoobey isttas, «Be7ite! Arshey ha7i dhoqqan dees; mehe soo shiishshiza wodey buro gakkibeenna; dorsata haath ushshidi efi heemmiishshite» gides.<verse eid="GEN 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 29:8" />Gido attiin isttas, «Mehey wuri shiiqana gakkanaas, shuchchaa haaththa ollaza doonappe genderisana gakkanaas nuni ushshanaas dandayokko; hessafe guye nuni mehaa ushshana» gida.<verse eid="GEN 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 29:9" />Izi buro haasayan dishin dorsata heemmizay izo gidida gishshas Laaba naya Eraheela ba aawaa dorsata laagga ekkada gakka wodhadus. <verse eid="GEN 29:9" /><verse number="10" style="v" sid="GEN 29:10" />Yaaqoobey ba aayey isha Laaba naa Eraheeli dorsata be7ida wode biidi ollaa doonappe shuchchaa genderisidi ba aayey ishaa dorsata haath ushshides. <verse eid="GEN 29:10" /><verse number="11" style="v" sid="GEN 29:11" />Yaaqoobey Eraheelo yeeridi ufayssafe dendidayssan ba qaala dhoqqisidi yeekkides. <verse eid="GEN 29:11" /><verse number="12" style="v" sid="GEN 29:12" />Yaaqoobey izis aawa dabbonne Irbiqa naa gididayssa Eraheelis yootiin iza woxxa baada ba aawaas yootadus.<verse eid="GEN 29:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 29:13" />Laabay ba michchey naa Yaaqoobe wore siyida mala izara gaagganaas woxxides; woxxi gakkidi iza idimmi yeeri ekkidi ba soo efides; heen Yaaqoobey ba hanidayssa ubbaa Laabas yootides. <verse eid="GEN 29:13" /><verse number="14" style="v" sid="GEN 29:14" />Laabay iza, «Neni tumu ta ashonne ta suuththa» gides. Yaaqoobey izara issi agina kumeth uttides.<verse eid="GEN 29:14" /></para>
  <para style="s1">Yaaqoobe Uneteth</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 29:15" />Hessafe guye Laabay iza, «Neni taas dabbo gidida gishshas taas coo mela ooththanee? Ane nees ay qanxxanaas bessizaakko taas yoota» gides. <verse eid="GEN 29:15" /><verse number="16" style="v" sid="GEN 29:16" />Laabas nam7u macca nayti deettes; bayray sunththi Liya, kaaloya Eraheelo. <verse eid="GEN 29:16" /><verse number="17" style="v" sid="GEN 29:17" />Liya ayfey shola; Eraheeli ayfey gidikko lo7o.<verse eid="GEN 29:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 29:18" />Yaaqoobey Eraheelo siiqida gishshas, «Tani nees kaalo nayo Eraheeli gishshas nees laappun layth ooththana» gides.<verse eid="GEN 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 29:19" />Laabay, «Izo hara asas immanaappe nees immizayssi lo7o; neni tanara hayssan deya» gides. <verse eid="GEN 29:19" /><verse number="20" style="v" sid="GEN 29:20" />Hessa gishshas Yaaqoobey Eraheelo ekkanaas laappun layth ooththides; gido attiin izi izo siiqiza gishshas izas wodezi keehi qaanth misatides.<verse eid="GEN 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 29:21" />Hessafe guye Yaaqoobey Laaba, «Ta machcho taas imma; ta wodey wurides; tani izo ekkana koyays» gides. <verse eid="GEN 29:21" /><verse number="22" style="v" sid="GEN 29:22" />Hessa gishshas Laabay heen diza ubba asaa xeygi shiishshidi, bullachcha kessides. <verse eid="GEN 29:22" /><verse number="23" style="v" sid="GEN 29:23" />Gido attiin gadey qammiin izi ba naa Liya efidi Yaaqoobes immides; Yaaqoobeykka izo ekkides. <verse eid="GEN 29:23" /><verse number="24" style="v" sid="GEN 29:24" />Qasse Laabay ba aylleyo Zilfo ba naa Liyas aylle gidana mala immides.<verse eid="GEN 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 29:25" />Gadey wontiin xeelliza wode hekko Liya gidadus! Histtiin Yaaqoobey Laaba, «Hayssi neni ta bolla ooththidayssi aazee? Tani nees ooththiday Eraheeli gishshas deennee? Tana ays cimmadii?» gides.<verse eid="GEN 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 29:26" />Laabay iza, «Nu biittan bayraya dishin kaaloyo azinaas immizayssi woga deenna. <verse eid="GEN 29:26" /><verse number="27" style="v" sid="GEN 29:27" />He mishirateththa saamintta ubbaa wursa; qasse kaalotizaarokka nuni nees immana; hessafe guye hara laappun layth taas ooththaasa» gides.<verse eid="GEN 29:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 29:28" />Yaaqoobey hessaththo hanidi he saaminttaa wursides; hessafe guye Laabay ba nayo Eraheelo izas immides. <verse eid="GEN 29:28" /><verse number="29" style="v" sid="GEN 29:29" />Qasse Laabay ba aylleyo Biliha ba naa Eraheelis aylle gidana mala immides. <verse eid="GEN 29:29" /><verse number="30" style="v" sid="GEN 29:30" />Yaaqoobey Eraheelokka ekkides; Eraheelo Liyappe aaththi siiqides; hara laappun layth Laabas ooththides.<verse eid="GEN 29:30" /></para>
  <para style="s1">Yaaqoobe Nayta Yeleteth</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31" />Yaaqoobey Liya Eraheeli mala siiqonttayssa be7idi GODAY izis yeliza uloza doydes; gido attiin Eraheelis nay baa. <verse eid="GEN 29:31" /><verse number="32" style="v" sid="GEN 29:32" />Liyay shaarada attuma naa yeladus; iza sunththaaka Oroobeele ga sunththadus; ays giikko iza, «GODAY ta meto be7ides; ha7i tumu tana ta azinay siiqana» gadus.<note caller="+" style="f"><char style="fr" closed="false">29:32 </char><char style="ft" closed="false">Oroobeele guussi Ibraaweta qaalara, «Hashshu Attuma naa!» woykko «Ta meto be7ides» guussa.</char></note><verse eid="GEN 29:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 29:33" />Iza qasseka shaarada ha7ikka attuma naa yeladus; iza, «GODAY tani dosettonttayssa be7ida gishshas taas hayssaka gujjides» gaada iza Simoona ga sunththadus.<note caller="+" style="f"><char style="fr" closed="false">29:33 </char><char style="ft" closed="false">Simoona guussi Ibraaweta qaalara, «Siyides» guussa.</char></note><verse eid="GEN 29:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 29:34" />Iza qasseka shaarada attuma naa yeladus; iza, «Tani izas heedzdzu attuma nayta yelida gishshas ta azinay ba wozina taakko zaarana» gaada iza Lewe ga sunththadus.<note caller="+" style="f"><char style="fr" closed="false">29:34 </char><char style="ft" closed="false">Lewe guussi Ibraaweta qaalara, «Ba wozina taakko zaarana woykko siiqon oykettana» guussa.</char></note><verse eid="GEN 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 29:35" />Iza qasseka qanththatada attuma naa yelada iza, «Hi7a tani GODAA galatana» gadus; hessa gishshas iza Yuhuda ga sunththadus; hessafe guye yelo essadus.<note caller="+" style="f"><char style="fr" closed="false">29:35 </char><char style="ft" closed="false">Yuhuda guussi Ibraaweta qaalara, «Galata» guussa.</char></note><verse eid="GEN 29:35" /></para>
  <chapter eid="GEN 29" />
  <chapter number="30" style="c" sid="GEN 30" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1" />Eraheela Yaaqoobes nay izippe yelettonttayssa erada ba michchey bolla qanaatadus; hessa gishshas iza Yaaqoobe, «Taas naa imma; ixxis giikko ta hayqqana» gadus.<verse eid="GEN 30:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 30:2" />Yaaqoobey Eraheeli bolla hanqettidi, «Tana nees yelo digganaas Xoossa gadii?» gides.<verse eid="GEN 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 30:3" />Izakka, «Ta aylleyo Biliha hinno be7a; iza ta gishshas yelana mala neni izo ekka; histtiko izi baggara tanikka naa aayo gidana» gadus. <verse eid="GEN 30:3" /><verse number="4" style="v" sid="GEN 30:4" />Eraheela ba aylleyo Biliha machcho histti ekkana mala izas immiin Yaaqoobey izo ekkides. <verse eid="GEN 30:4" /><verse number="5" style="v" sid="GEN 30:5" />Biliha shaarada attuma naa Yaaqoobes yeladus. <verse eid="GEN 30:5" /><verse number="6" style="v" sid="GEN 30:6" />Histtiin Eraheela, «Xoossi taas pirdides; ta woosaakka siyidi taas attuma naa immides» gadus; hessa gishshas yelettida naaza, «Daane» ga sunththadus.<note caller="+" style="f"><char style="fr" closed="false">30:6 </char><char style="ft" closed="false">Daane guussi Ibraaweta qaalara, «Taas pirdides» guussa.</char></note><verse eid="GEN 30:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 30:7" />Eraheeli aylleya Biliha qasseka shaarada Yaaqoobes nam7anththo attuma naa yeladus. <verse eid="GEN 30:7" /><verse number="8" style="v" sid="GEN 30:8" />Eraheelakka, «Tani ta michcheyra wolqqama baaxe baaxetada xoonadis» gashe naaza Niftaaleme ga sunththadus.<note caller="+" style="f"><char style="fr" closed="false">30:8 </char><char style="ft" closed="false">Niftaaleme guussi Ibraaweta qaalara, «Baaxe» guussa.</char></note><verse eid="GEN 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 30:9" />Liyay baas yeloy eqqidayssa beyada ba aylleyo Zilfo efada Yaaqoobes machcho histta immadus. <verse eid="GEN 30:9" /><verse number="10" style="v" sid="GEN 30:10" />Liya aylle Zilfa Yaaqoobes attuma naa yeladus. <verse eid="GEN 30:10" /><verse number="11" style="v" sid="GEN 30:11" />Liyaykka, «Hayssi ay mala lo7o qaadaa!» gashe naaza Gaade<note caller="+" style="f"><char style="fr" closed="false">30:11 </char><char style="fqa" closed="false">Gaade: </char><char style="ft" closed="false">Gaade guussi Ibraaweta qaalara, «Lo7o qaada» guussa.</char></note> gaada sunththadus.<verse eid="GEN 30:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 30:12" />Liya aylleya Zilfay Yaaqoobes nam7anththo attuma naa yeladus. <verse eid="GEN 30:12" /><verse number="13" style="v" sid="GEN 30:13" />Liyaykka, «Tani keeha ufayettadis! Maccassayka tana ufayettizaaro gaana» gadus; hessa gishshas iza naaza Aaseere<note caller="+" style="f"><char style="fr" closed="false">30:13 </char><char style="fqa" closed="false">Aaseere: </char><char style="ft" closed="false">Aaseere guussi Ibraaweta qaalara, «Ufayssa» guussa.</char></note> ga sunththadus.<verse eid="GEN 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 30:14" />Gistte maxa aginan Oroobeeley gade giddo biidi inkoye teera demmidi ba aayo Liyas ehides; Eraheela Liya, «Ne nay ehida inkoyezappe ane taas imma» gadus.<verse eid="GEN 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 30:15" />Gido attiin, «Ne ta azinaza taappe woththa ekkidayssi gidontta ixxiin qasse ta naaza inkoyeza ekkanee?» gadus.</para>
  <para style="p" vid="GEN 30:15">Eraheelakka, «Histtiko ne naaza inkoyeza gishshas Yaaqoobey hachcha qamma nenara aqo» gadus.<verse eid="GEN 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 30:16" />He gallassa omars Yaaqoobey oososoppe simmishin Liyay iza mokkanaas kezada, «Neni tanara aqana koshshees; ays giikko tani ta naa inkoyezan nena kiras ekkaychchadis» giin izi he gallassa omars izira aqides.<verse eid="GEN 30:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 30:17" />Xoossi Liya woosa siyides; hessa gishshas iza qanththatada ichchashanththo attuma naa Yaaqoobes yeladus. <verse eid="GEN 30:17" /><verse number="18" style="v" sid="GEN 30:18" />Liyaykka, «Tani ta aylleyo ta azinaas immida gishshas Xoossi hessa kira taas qanxxides» gashe naaza Yisakoore<note caller="+" style="f"><char style="fr" closed="false">30:18 </char><char style="fqa" closed="false">Yisakoore: </char><char style="ft" closed="false">Yisakoore guussi Ibraaweta qaalara, «Ooso waaga» guussa.</char></note> gaada sunththadus.<verse eid="GEN 30:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 30:19" />Liyay qasseka shaarada usuppunththa attuma naa Yaaqoobes yeladus. <verse eid="GEN 30:19" /><verse number="20" style="v" sid="GEN 30:20" />Liyay, «Xoossi taas al7o imota immides; tani ta azinaas usuppun nayta yelida gishshas ha7i izi tana bonchchana» gadus. Hessa gishshas iza naaza Zaabiloone<note caller="+" style="f"><char style="fr" closed="false">30:20 </char><char style="fqa" closed="false">Zaabiloone: </char><char style="ft" closed="false">Zaabiloone guussi Ibraaweta qaalara, «Bonchcho» guussa.</char></note> ga sunththadus. <verse eid="GEN 30:20" /><verse number="21" style="v" sid="GEN 30:21" />Hessafe guye issi macca naa yelada izo Diina<note caller="+" style="f"><char style="fr" closed="false">30:21 </char><char style="fqa" closed="false">Diina: </char><char style="ft" closed="false">Diina guussi Ibraaweta qaalara, «Pirdides» guussa.</char></note> ga sunththadus.<verse eid="GEN 30:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 30:22" />Xoossi Eraheelo qoppides; izi woosaakka siyidi izis yeliza ulo doydes. <verse eid="GEN 30:22" /><verse number="23" style="v" sid="GEN 30:23" />Izakka shaarada attuma naa yeladus; «Xoossi ta yeella taappe denththides; <verse eid="GEN 30:23" /><verse number="24" style="v" sid="GEN 30:24" />GODAY taas hara attuma naakka gujjerennee!» gashe naaza Yooseefe<note caller="+" style="f"><char style="fr" closed="false">30:24 </char><char style="fqa" closed="false">Yooseefe: </char><char style="ft" closed="false">Yooseefe guussi Ibraaweta qaalara, «Taas gujjo woykko quccides» guussa.</char></note> ga sunththadus.<verse eid="GEN 30:24" /></para>
  <para style="s1">Yaaqoobeynne Laaba Palameteth</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25" />Eraheela Yooseefe yelidaappe guye Yaaqoobey Laaba, «Tani ta aawa biitta simmana mala tana moyza. <verse eid="GEN 30:25" /><verse number="26" style="v" sid="GEN 30:26" />Tani istta gishshas nees ooththida ta machchetanne ta nayta taas imma; tani baana; ays giikko tani nees ay mala ooththidaakko ne eraasa» gides.<verse eid="GEN 30:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 30:27" />Qasse Laabay izas, «Tani nees issi miish yootays; GODAY ne geedon tana anjjidayssa ta beyadis. <verse eid="GEN 30:27" /><verse number="28" style="v" sid="GEN 30:28" />Ne ekkana damoza taas yoota; tani nees iza qanxxana» gides.<verse eid="GEN 30:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 30:29" />Yaaqoobey, «Tani nees wostta ooththidaakko ne meheykka waani yelettidaakko neni eraasa. <verse eid="GEN 30:29" /><verse number="30" style="v" sid="GEN 30:30" />Tani yaanaappe kase nees diza guuththay ha7i keehi darides; ta aadhdhida ubbason GODAY nena anjjides; gido attiin ha7i tani taso asaas ayde ooththoo?» gides.<verse eid="GEN 30:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 30:31" />Laabay, «Tani nees ay immoo?» gi iza oychchiin, Yaaqoobey, «Taas aykkoka immofa; gido attiin neni taas issi miish ooththiko tani ne wudeza qasseka heemmananne naagana. <verse eid="GEN 30:31" /><verse number="32" style="v" sid="GEN 30:32" />Tani hach ne mehe ubbaa giddora aadhdhana; heen ne dorsaafe masara woykko puncara ubbaa, dorsa laaqqa kareththata ubbaa, deyshafe puncaranne masara gididayta ubbaa ta shaakkana; heytantti ta damoza gidetto. <verse eid="GEN 30:32" /><verse number="33" style="v" sid="GEN 30:33" />Hessa gishshas ta xilloteththi neni taas qanxxida damozaa taybanaas sinththafe ne yiza wode erettana; ta deyshaafe xalaqa gidonttay woykko kareth gidontta issi laaqqay ta achchan beettiko kaysotida mala qoodetto» gides.<verse eid="GEN 30:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 30:34" />Laabay, «Ne gida mala gido» gides. <verse eid="GEN 30:34" /><verse number="35" style="v" sid="GEN 30:35" />He gallassika Laabay xalaqa gidida orgeta ubbaa, xalaqa gidida macca deyshetanne kareththa dorsa laaqqata ubbaa kessidi heemmana mala ba attuma naytas immides. <verse eid="GEN 30:35" /><verse number="36" style="v" sid="GEN 30:36" />Histtidi he mehezara heedzdzu gallassa oge Yaaqoobeppe haakki bides; gido attiin Yaaqoobey attida Laaba meheta heenth gelides.<verse eid="GEN 30:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 30:37" />Yaaqoobey miththafe qaye guufe kessidi baggaa poqqidi baggaa poqqontta aggidi guufeza baggaa kareth, baggaa booth histtidi warardes.<note caller="+" style="f"><char style="fr" closed="false">30:37 </char><char style="fqa" closed="false">Warardes: </char><char style="ft" closed="false">Warardes gizayssa issi issi bagga gamoththo qaalan waarankides geetettees.</char></note> <verse eid="GEN 30:37" /><verse number="38" style="v" sid="GEN 30:38" />Mehey haaththe uyana yiza ubba wode meheti haath uyiza gongge giddon guufeta woththides; meheteth kezida meheti haath uyanaas yiza wode, <verse eid="GEN 30:38" /><verse number="39" style="v" sid="GEN 30:39" />he guufeta sinththan mehettida; isttika masara, xalaqanne battaka laaqqata yelida. <verse eid="GEN 30:39" /><verse number="40" style="v" sid="GEN 30:40" />Yaaqoobey laaqqata mehetappe shaakkidi dumma woththides; attida meheta masaranne xalaqa gididayta Laaba mehe sinth zaarides; hessaththo Yaaqoobey ba mehe Laaba mehera walakettontta mala dumma shaakki woththides.<verse eid="GEN 30:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 30:41" />Gooba mino macca dorsatinne deyshati meheteth keziza wode ayde gidiinkka istti he guufeta achchan mehettana mala Yaaqoobey he guufeta haaththa gongge giddon meheta sinththan woththides. <verse eid="GEN 30:41" /><verse number="42" style="v" sid="GEN 30:42" />Guufeza laafa meheta sinththan woththenna; hessa gishshas laafa laafa meheti Laabas gidiin goobizayti Yaaqoobes gidida. <verse eid="GEN 30:42" /><verse number="43" style="v" sid="GEN 30:43" />Hessaththo hanidi Yaaqoobey keehi duretidi, daro mehe wude, macca aylletanne attuma aylleta, daro gaamellatanne hareta haarides.<verse eid="GEN 30:43" /></para>
  <chapter eid="GEN 30" />
  <chapter number="31" style="c" sid="GEN 31" />
  <para style="s1">Laabappe Yaaqoobe Baqata</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1" />Laaba attuma nayti ba giddon, «Yaaqoobey nu aawa haaro ubbaa ekkides; hayssi ubbay izi shiishshida aqotay nu aawappe beettidaaza» gi haasayshin Yaaqoobey siyides. <verse eid="GEN 31:1" /><verse number="2" style="v" sid="GEN 31:2" />Yaaqoobey Laaba ayfesoy izas kase mala gidonttayssa be7ides.<verse eid="GEN 31:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 31:3" />He wode GODAY Yaaqoobe, «Neni ne aawata biitta ne dabbotakko guye simma; tani nenara gidana» gides.<verse eid="GEN 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 31:4" />Hessa gishshas Yaaqoobey Eraheelonne Liya ba mehey dizaso yaana mala kiittidi xeygisides. <verse eid="GEN 31:4" /><verse number="5" style="v" sid="GEN 31:5" />Izi isttas, «Intte aawa ayfesoy taas kaseyssa mala gidonttayssa tani be7adis; gido attiin ta aawa Xoossi tanara dees. <verse eid="GEN 31:5" /><verse number="6" style="v" sid="GEN 31:6" />Tani ta kumeththa wolqqafe intte aawaas ooththidayssa intte ereeta. <verse eid="GEN 31:6" /><verse number="7" style="v" sid="GEN 31:7" />Gido attiin intte aaway tana cimmidi ta damoza tammuto laammi laammi yeggides; gidikkoka izi tana qohontta mala Xoossi iza diggides. <verse eid="GEN 31:7" /><verse number="8" style="v" sid="GEN 31:8" />Izi, ‹Masara dorsatinne deyshati ne damoza gidana› giin wude meheti wuri masara xalla yelida; qasse izi, ‹Xalaqa dorsatinne deyshatikka ne damoza gidana› giin mehey wuri xalaqa yelides. <verse eid="GEN 31:8" /><verse number="9" style="v" sid="GEN 31:9" />Xoossi hayssaththo intte aawappe woththi ekkidi intte aawa mehe taas immides.<verse eid="GEN 31:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 31:10" />«Meheti meheteth keziza aginan agumora meheta mehessiza deysha orgeti masara, xalaqanne battaka gididayssa beyadis. <verse eid="GEN 31:10" /><verse number="11" style="v" sid="GEN 31:11" />Xoossa kiitanchchay agumon tana, ‹Yaaqoobee!› gi xeygiin tani, ‹Yee!› gaada koyadis. <verse eid="GEN 31:11" /><verse number="12" style="v" sid="GEN 31:12" />Izikka tana, ‹Dhoqqu gaada meheta mehetissiza deysha orgeti wuri masaranne xalaqa gididayssa beya; gaasoykka Laabay ne bolla ooththizayssa ubbaa ta beyadis. <verse eid="GEN 31:12" /><verse number="13" style="v" sid="GEN 31:13" />Neni shuch essada zayte iza bolla tigada adinida Beetele Xoossi tana; ha7i dendada ha biittafe kezada elelada guye ne yelettida biitta simma› » gides.<note caller="-" style="x"><char style="xo" closed="false">31:13 </char><char style="xt" closed="false"><ref loc="GEN 28:18-22">Medhe 28:18-22</ref></char></note><verse eid="GEN 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 31:14" />Hessafe guye Eraheelanne Liyay izas, «Nu aawayssafe nuna gakkanay aazee? <verse eid="GEN 31:14" /><verse number="15" style="v" sid="GEN 31:15" />Izi nuna allaga mala xeellees deennee? Izi nuna bayzi ekkides; bayzidi ekkida mishakka baas mi dhayssides. <verse eid="GEN 31:15" /><verse number="16" style="v" sid="GEN 31:16" />Xoossi nu aawappe woththi ekkidi nees immida mehey wuri tumukka nuussanne nu naytayssa; hessa gishshas Xoossi nees yootidayssa ubbaa ooththa» gida.<verse eid="GEN 31:16" /></para>
  <para style="p">
    <verse number="17-18" style="v" sid="GEN 31:17-18" />Histtiin Yaaqoobey Kanaane biittan diza ba aawa Yisaaqakko baanaas dendides; izi ba naytanne ba machcheta gaamella togisides; baas diza mehe ubbaa sinththe aaththi laaggidi Mesphexoomiyan dishe izi shiishshida haaro ubbaa ekki bides. <verse eid="GEN 31:17-18" /><verse number="19" style="v" sid="GEN 31:19" />Laabay ba dorsata iskeza qanxxanaas bichchidaashe Eraheela ba aawa eeqa misleta kaysadus. <verse eid="GEN 31:19" /><verse number="20" style="v" sid="GEN 31:20" />Yaaqoobeykka ba baqatizayssa Aaraame dere asi gidida Laabas yootontta baleththi bides. <verse eid="GEN 31:20" /><verse number="21" style="v" sid="GEN 31:21" />Izi baas dizaaz ubbaa shiishshi ekki baqatidi Efiraaxise Shaafaa pinnidi Gala7aade geetettiza gezze biitta bides.<verse eid="GEN 31:21" /></para>
  <para style="s1">Yaaqoobe Oykkanaas Laaba Kaaleteth</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22" />Yaaqoobey baqati bidayssa Laabay heedzdzanththo gallas siyides. <verse eid="GEN 31:22" /><verse number="23" style="v" sid="GEN 31:23" />Ba dabbota banara ekkidi laappun gallassa oge Yaaqoobe guye kaallidi kaallidi Gala7aade geetettiza gezze biittan iza gakki oykkides. <verse eid="GEN 31:23" /><verse number="24" style="v" sid="GEN 31:24" />He gallassa omars Xoossi Aaraame Laabakko agumora yiidi, «Neni Yaaqoobe bolla iita gidiin kiya gidiinkka haasayontta mala naageeta!» gides. <verse eid="GEN 31:24" /><verse number="25" style="v" sid="GEN 31:25" />Laabay gakkiza wode Yaaqoobey Gala7aade gezzen dunkaani uttides; qasse Laabaynne iza dabboti heen dunkaane tokkida.<verse eid="GEN 31:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 31:26" />Hessafe guye Laabay Yaaqoobe, «Neni hayssaththo ays ooththadii? Neni tana cimmada ta macca nayta olan di7ettida mala laaggada kessadasa. <verse eid="GEN 31:26" /><verse number="27" style="v" sid="GEN 31:27" />Neni ays qotan taappe kessa ekkada tana cimmadii? Tani karabeninne diiththan ufayssa yeththan nena moyzana mala taas ays yootabeekkii? <verse eid="GEN 31:27" /><verse number="28" style="v" sid="GEN 31:28" />Neni haray atto ta nayta naytanne ta macca nayta tani yeera ekkontta mala diggadasa; neni balla ooso ooththadasa. <verse eid="GEN 31:28" /><verse number="29" style="v" sid="GEN 31:29" />Tani nena qohanaas taas wolqqay dees; gido attiin ne aawa Xoossi qamma omars tana, ‹Yaaqoobe bolla iita gidiin kiya gidiinkka issi miish ne haasayontta mala naagetta!› giidi taas yootides. <verse eid="GEN 31:29" /><verse number="30" style="v" sid="GEN 31:30" />Ha7i gidikkoka neni ne aawa soo baanaas keeha laamotida gishshas ke7adasa; gido attiin taso eeqa misleta aazas kaysadii?» gides.<verse eid="GEN 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 31:31" />Yaaqoobey Laaba, «Neni ne nayta taappe wolqqan woththa ekkanaakko gaada babbida gishshas hayssaththo ooththadis. <verse eid="GEN 31:31" /><verse number="32" style="v" sid="GEN 31:32" />Gido attiin ne misleta oykkida as oonakka neni demmiko he uray hayqqo! Nees gidida miishshi ta achchan beettiko nu dabboti beyishin koyada demmiko nees ekka» gides; gaasoykka Yaaqoobey Eraheela eeqa misleta kaysidayssa eribeenna.<verse eid="GEN 31:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 31:33" />Hessa gishshas Laabay Yaaqoobe dunkaane giddo, Liya dunkaane giddonne nam7u aylleta dunkaane giddo gelides; gido attiin aykkoka demmibeenna; Liya dunkaanaappe kezidi Eraheeli dunkaane giddo gelides. <verse eid="GEN 31:33" /><verse number="34" style="v" sid="GEN 31:34" />Eraheela ba aawa eeqa misleta ekkada gaamella koora garsan qottada, iza bolla uttadus. Laabay dunkaanan dizayssa ubbaa pilggidi koyides; gido attiin aykkoka demmibeenna. <verse eid="GEN 31:34" /><verse number="35" style="v" sid="GEN 31:35" />Eraheela ba aawa, «Ta aawawu! Tana hanqettofa; tani nees eqqana dandaykke; taas maccassa wogay yides» gadus. Izi ubbason koyides; gido attiin eeqa misleta demmibeenna.<verse eid="GEN 31:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 31:36" />Yaaqoobey Laaba bolla hanqettidi, «Tani ay mooradinaa? Hessa sire ne tana kaallanaas tani ooththida nagaray aazee? <verse eid="GEN 31:36" /><verse number="37" style="v" sid="GEN 31:37" />Ha7i neni ta miishshaa ubbaa pilggada koyadasashin ay demmadii? Istti neeppenne taappe ooni wordoko pirdana mala ha yo7oza ta dabbota sinththaninne ne dabbota sinththan woththa.<verse eid="GEN 31:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 31:38" />«Tani nenara nam7u tammu layth kumeth de7adis; ne dorsinne deysha gidiin awucaybeenna; woykko ne meheppe galth mabeekke. <verse eid="GEN 31:38" /><verse number="39" style="v" sid="GEN 31:39" />Do7ay wodhidayssaka ubbaa ta bolla qoodadis attiin nees ehabeekke; gallas gidiin omars kaysoy ekkidayssa tana qanxxisadasa. <verse eid="GEN 31:39" /><verse number="40" style="v" sid="GEN 31:40" />Gallas awa seelay, omars kenchchoy tana qohides; dhiskoyka ta ayfeppe dhaydes. <verse eid="GEN 31:40" /><verse number="41" style="v" sid="GEN 31:41" />Tani hayssaththo ne soon nam7u tammu layth de7adis; ne macca naa nam7ata gishshas 14 layth, attida usuppun layth ne immida meheta gishshas nees ooththashe de7adis; gido attiin neni ta damoza tammuto laamma laamma yeggadasa. <verse eid="GEN 31:41" /><verse number="42" style="v" sid="GEN 31:42" />Ta aawati Abrahaameynne Yisaaqi goynnida Xoossi tanara gidonttaakko ne tana mela kushe kessa yeddanakoshin Xoossi ta waayenne ta daabura be7idi qamma omars nena hanqides» gides.<verse eid="GEN 31:42" /></para>
  <para style="s1">Yaaqoobeynne Laabay Gelida Caaqo Qaala</para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43" />Laabay Yaaqoobe, «Ne machcheti ta macca nayta; istti yelida naytikka ta nayta; mehezikka ta mehe; nees dizaazi wurikka tayssa; hach ha macca nayta tayta bollanne istti yelida nayta bolla ay ooththanaas dandayazinaa? <verse eid="GEN 31:43" /><verse number="44" style="v" sid="GEN 31:44" />Ane ha7i haa ya; neninne tani caaqettoos; hayssi neeppenne taappe giddon markka gido» gides.<verse eid="GEN 31:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 31:45" />Hessa gishshas Yaaqoobey issi shuch ekkidi tuussa mala essides. <verse eid="GEN 31:45" /><verse number="46" style="v" sid="GEN 31:46" />Izi ba dabbotakka, «Shuch shiishshite» gides; histtiin istti shuch shiishshidi korida; he shuchcha koraa achchanka kath mida. <verse eid="GEN 31:46" /><verse number="47" style="v" sid="GEN 31:47" />Laabay he shuchcha koraa, Yigaar-Sahaaduta gi sunththides; qasse Yaaqoobey iza Gal7eede gi sunththides.<note caller="+" style="f"><char style="fr" closed="false">31:47 </char><char style="ft" closed="false">Yigaar-Sahaadutanne Gal7eede guussi Aramayke qaalaninne Ibraawe qaalan birshishin, «Markkateththa keela» guussa.</char></note> <verse eid="GEN 31:47" /><verse number="48" style="v" sid="GEN 31:48" />Laabay, «Ha keelay neeppenne taappe giddon hach markka» gides; hessa gishshas iza sunththay Gal7eede geetettides.<verse eid="GEN 31:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="GEN 31:49" />Qasse izi he shuchcha tuussaa Mixiphpha<note caller="+" style="f"><char style="fr" closed="false">31:49 </char><char style="fqa" closed="false">Mixiphpha: </char><char style="ft" closed="false">Mixiphpha guussi Ibraaweta qaalara, «Naageso» guussa.</char></note> gi sunththides; ays giikko Laabay, «Nuni issay issaafe haakkidi diza wode GODAY ne giddoninne ta giddon gididi naago. <verse eid="GEN 31:49" /><verse number="50" style="v" sid="GEN 31:50" />Neni ta macca nayta qohiko, woykko neni ta macca nayta bolla hara maccassata ekkiko nunara ha7i oonikka baynda aggikokka ne giddoninne ta giddon Xoossay markka gididayssa era» gides.<verse eid="GEN 31:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="GEN 31:51" />Laabay qasseka Yaaqoobes, «Keelettida shuchchaa hayssa beya; qasse tani neeppenne taappe giddon essida shuchcha tuussa hayssa beya. <verse eid="GEN 31:51" /><verse number="52" style="v" sid="GEN 31:52" />Tani ne bolla gene ooththanaas ha keelappe neekko kanththontta mala nenikka ta bolla gene ooththanaas ha keelappenne ha shuchchaa tuussaafe kanththontta mala ha shuchcha koraynne ha shuchcha tuussay markka. <verse eid="GEN 31:52" /><verse number="53" style="v" sid="GEN 31:53" />Abrahaame Xoossi, Naakoore Xoossi, istta aawa Xoossi, izi nu giddon pirdo» gides. Yaaqoobey ba aawa Yisaaqi goynnida Xoossa sunththan caaqqides. <verse eid="GEN 31:53" /><verse number="54" style="v" sid="GEN 31:54" />Yaaqoobey zumaa bollan yarsho yarshides; ba dabbotakka quma maanaas xeygides; istti miidi heen zuma bollan aqida.<verse eid="GEN 31:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 31:55" />Wonteththa gallas maalado wonttara Laabay dendidi ba nayta naytanne ba macca nayta anjjidinne yeeri ekkidi guye ba soo simmides.<verse eid="GEN 31:55" /></para>
  <chapter eid="GEN 31" />
  <chapter number="32" style="c" sid="GEN 32" />
  <para style="s1">Eesawera Gaagganaas Yaaqoobe Giigeteth</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1" />Yaaqoobey dendidi sinththe bishin Xoossa kiitanchchati izara gaaggida. <verse eid="GEN 32:1" /><verse number="2" style="v" sid="GEN 32:2" />Yaaqoobey istta be7idi, «Hayssi Xoossi aqizaso» gishe he sohoza Mahanayme gi sunththides.<note caller="+" style="f"><char style="fr" closed="false">32:2 </char><char style="fqa" closed="false">Maahinayme: </char><char style="ft" closed="false">Maahinayme guussi Ibraaweta qaalara, «Nam7u cugay aqizaso woykko gutata» guussa.</char></note><verse eid="GEN 32:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 32:3" />Yaaqoobey Seyre geetettizason Eedoome biittan diza ba isha Eesawekko baappe sinththe kiita yeddides. <verse eid="GEN 32:3" /><verse number="4" style="v" sid="GEN 32:4" />Izi istta bolla kiita, «Intte ta godaa Eesawes gaana miishshi hayssa; ‹Ne aylle Yaaqoobey, tani Laaba achchan hanno gakkanaas gam7adis. <verse eid="GEN 32:4" /><verse number="5" style="v" sid="GEN 32:5" />Taas miizi, harey, dorsi, deyshi, adde aylletinne macca aylleti deettes; ha7i tani ha kiitaa ta godaas kiittizay taas lo7o qoppana mala ga kiittadis› gides» gi kiittides.<verse eid="GEN 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 32:6" />Kiitettidayti Yaaqoobekko simmidi izas, «Nuni ne isha Eesawekko bidos; ha7i izi qasse nenara gaagganaas yees; izarakka 400 asi dees» gida.<verse eid="GEN 32:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 32:7" />Yaaqoobey babbidi shoobbides; banara diza asaa 2 cugan cugan shaakkidi ba dorsaa, deyshaa, miizaanne gaamellaa 2 cugan cugan shaakkides. <verse eid="GEN 32:7" /><verse number="8" style="v" sid="GEN 32:8" />Izi, «Eesawey yiidi issi cuga oli ekkizaa gidikko attida cugay kessi ekkanaakko» gi qoppides.<verse eid="GEN 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 32:9" />He wode Yaaqoobey, «Abeet Xoossawu! Ta aawa Abrahaame Xoossawu, ta aawa Yisaaqa Xoossawu, tana, ‹Ne dabbotakko ne dere simma; tani nees lo7o ooththana› gidaso, <verse eid="GEN 32:9" /><verse number="10" style="v" sid="GEN 32:10" />neni ne ayllezas ooththida kiyateththaassinne ammaneteththaas ubbaas tani bessontta asa. Tani haa Yordaanoose shaafa pinniza wode taas issi guufeyppe attiin kushen haray deenna; gido attiin ha7i tani nam7u cuga dere gidadis. <verse eid="GEN 32:10" /><verse number="11" style="v" sid="GEN 32:11" />Ta nena woossays; ta ishaa Eesawe kusheppe tana ashsha; gaasoykka izi yiidi tananne ta nayta aayeta istta naytara dhayssanaakko gaada babbadis. <verse eid="GEN 32:11" /><verse number="12" style="v" sid="GEN 32:12" />Gido attiin neni tana, ‹Tani nees tumu lo7o ooththana; tani ne zereththay taybettanaas dandayettontta abba shaamintta mala ooththana› gidayssa qoppa» gi woossides.<note caller="-" style="x"><char style="xo" closed="false">32:12 </char><char style="xt" closed="false"><ref loc="GEN 12:17">Medhe 12:17</ref></char></note><verse eid="GEN 32:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 32:13" />He gallassa omars izi heen aqiday baas diza ubbaafe ba isha Eesawes immanaassa. <verse eid="GEN 32:13" /><verse number="14-15" style="v" sid="GEN 32:14-15" />Izikka 200 macca deyshatanne nam7u tammu deysha orgeta, 200 macca dorsatanne 200 dharshota, 300 dhanththiza gaamellatanne istta maratara, 40 miizata, 10 korma boorata, 20 macca haretanne 10 wodalla hareta qori kessides. <verse eid="GEN 32:14-15" /><verse number="16" style="v" sid="GEN 32:16" />Heyta istti wuden wuden shaakki shaakki ba aylleta kushen woththidi aylletas, «Taappe sinththati biite; wudeza issaa issaafe haassi haassi laaggite» gides.<verse eid="GEN 32:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 32:17" />Ubbaafe sinththan bizayssa, «Ta isha Eesawey nenara gaaggidi nena, ‹Ne oonee? Awa bay? Ne sinththan diza mehey wuri oonassee?› gi oychchizaa gidikko, <verse eid="GEN 32:17" /><verse number="18" style="v" sid="GEN 32:18" />‹Neni izas hayti ne aylle Yaaqoobessa; izi hayta yeddidaykka ta godaa Eesawes immanaassa; qasse izikka nuuppe guyera yees› ga» gi azazides.<verse eid="GEN 32:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 32:19" />Qasseka nam7anththonne heedzdzanththo cugatassinne wudeza kaalliza hara ubbatas hayssaththo, «Intte Eesawera gaaggiza wode hayssaththoka geeta; <verse eid="GEN 32:19" /><verse number="20" style="v" sid="GEN 32:20" />‹Ne aylle Yaaqoobey nuuppe guyera yees› gontta aggofte» gides; izi hessaththo giday, «Tani taappe sinththe immanaas kiittidayssan iza hanqo doshisana; hessafe guye tani izara gaaggiza wode izi tana mokki ekkanaakko oonee erizay» gi qoppides. <verse eid="GEN 32:20" /><verse number="21" style="v" sid="GEN 32:21" />Hessa gishshas ba immizayssa baappe sinththasi yeddides; gido attiin izi ba hu7es he gallassa omars heen ba dizason aqides.<verse eid="GEN 32:21" /></para>
  <para style="s1">Xoossara Yaaqoobe Baaxeteth</para>
  <para style="p">
    <verse number="22-23" style="v" sid="GEN 32:22-23" />He gallassa omars Yaaqoobey dendidi, ba nam7u machcheta, ba nam7u aylleta ba nayta tammanne issineta ekkidi Yaabooqe geetettiza shaafa gakkides; izi isttanne baas dizayta ubbaa pinththi yeddides; <verse eid="GEN 32:22-23" /><verse number="24" style="v" sid="GEN 32:24" />Gido attiin Yaaqoobey barkka heen attides.</para>
  <para style="p" vid="GEN 32:24">He wode issi asi gadey wonttana gakkanaas izara baaxetides. <verse eid="GEN 32:24" /><verse number="25" style="v" sid="GEN 32:25" />He addezi iza xoonanaas dandayettonttayssa be7idi Yaaqoobes wodira bochchiin iza wodiray doccides. <verse eid="GEN 32:25" /><verse number="26" style="v" sid="GEN 32:26" />Histtiin he addezi iza, «Gadey wonttana gees tana yedda» gides.<note caller="-" style="x"><char style="xo" closed="false">32:24-26 </char><char style="xt" closed="false"><ref loc="HOS 12:3-4">Hose 12:3-4</ref></char></note></para>
  <para style="p" vid="GEN 32:26">Gido attiin Yaaqoobey iza, «Ne tana anjjontta yeddike» gides.<verse eid="GEN 32:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 32:27" />Addezikka iza, «Ne sunththi oonee?» gi oychchiin izi,</para>
  <para style="p" vid="GEN 32:27">«Yaaqoobe» gi zaarides.<verse eid="GEN 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 32:28" />Addezikka iza, «Hayssafe sinththan ne sunththi Isra7eele<note caller="+" style="f"><char style="fr" closed="false">32:28 </char><char style="fqa" closed="false">Isra7eele: </char><char style="ft" closed="false">Isra7eele guussi Ibraaweta qaalara, «Baaxetees» guussa.</char></note> geetetto attiin Yaaqoobe geetettofo; ays giikko neni Xoossaranne asara baaxetada xoonadasa» gides.<verse eid="GEN 32:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 32:29" />Yaaqoobey iza, «Ne sunththi oonee?» gi oychchides.</para>
  <para style="p" vid="GEN 32:29">Addezikka, «Neni ta sunththu ays oychchay?» gi simmidi iza heen anjjides.<note caller="-" style="x"><char style="xo" closed="false">32:29 </char><char style="xt" closed="false"><ref loc="JDG 13:7-18">Daanna 13:7-18</ref></char></note><verse eid="GEN 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 32:30" />Hessa gishshas Yaaqoobey he sohoza Phin7eele<note caller="+" style="f"><char style="fr" closed="false">32:30 </char><char style="fqa" closed="false">Phin7eele: </char><char style="ft" closed="false">Phin7eele guussi Ibraaweta qaalara, «Xoossa ayfeso» guussa.</char></note> gi sunththides; ays giikko izi, «Tani Xoossaa ta ayfera be7ada hayqqontta attadis» gides. <verse eid="GEN 32:30" /><verse number="31" style="v" sid="GEN 32:31" />Izi Panu7eeleppe dendiza wode iza bolla xalqqey kezides; izi ba wodiraa gishshas wobbides. <verse eid="GEN 32:31" /><verse number="32" style="v" sid="GEN 32:32" />Yaaqoobe wodiray deshettida gishshas Isra7eele asay hach gakkanaaska geda giddon diza paashsha asho mi erettenna.<verse eid="GEN 32:32" /></para>
  <chapter eid="GEN 32" />
  <chapter number="33" style="c" sid="GEN 33" />
  <para style="s1">Eesawera Yaaqoobe Gayteth</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1" />Yaaqoobey dhoqqu gi xeellidi Eesawey 400 as banara ekki yizayssa be7ides; hessa gishshas nayta Liyas, Eraheelissinne nam7u aylletas shaakki shaakki immides. <verse eid="GEN 33:1" /><verse number="2" style="v" sid="GEN 33:2" />Ashkaratanne istta nayta sinththan Liyanne izi nayta isttafe guyen Eraheelonne Yooseefe wurseththan woththides. <verse eid="GEN 33:2" /><verse number="3" style="v" sid="GEN 33:3" />Gido attiin izi ba baggara ubbaafe sinththe aadhdhidi ba ishaakko matida wode laappunto ziggides.<verse eid="GEN 33:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 33:4" />Eesawey gidikko izara gaagganaas woxxidi iza qoodhe bolla xaaxettidi yeerides; nam7atikka yeekkida. <verse eid="GEN 33:4" /><verse number="5" style="v" sid="GEN 33:5" />Hessafe guye Eesawey dhoqqu gi xeellidi maccassatanne nayta be7idi, «Ha nenara dizayti oonanttee?» gi oychchides.</para>
  <para style="p" vid="GEN 33:5">Yaaqoobey izas, «Hayti Xoossi ne aylles taas ba kiyateththan immida nayta» gides. <verse eid="GEN 33:5" /><verse number="6" style="v" sid="GEN 33:6" />Hessafe guye aylleti ba naytara shiiqidi iza sinththan ziggida. <verse eid="GEN 33:6" /><verse number="7" style="v" sid="GEN 33:7" />Kaallidi Liyaynne izi nayti yiidi ziggida; wurseththan Yooseefeynne Eraheela yiidi ziggida.<verse eid="GEN 33:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 33:8" />Eesawey, «Sinththan tanara gaaggida mehey wuri aaza mehee?» gi oychchides.</para>
  <para style="p" vid="GEN 33:8">Izikka, «Ta godoo! Hayssi ne tana ufayssan mokka ekkanaassa» gides.<verse eid="GEN 33:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 33:9" />Eesawey, «Ta ishoo! Taas daro haaroy dees; ne miishshi nees gido» gides.<verse eid="GEN 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 33:10" />Yaaqoobey, «Akkay, ha7i ne tana mokka ekkanaa gidikko ta nees immizayssa ekka; ne tana siiqon mokka ekkishin ta be7idayssa Xoossa ayfeso be7ida mala qoodays. <verse eid="GEN 33:10" /><verse number="11" style="v" sid="GEN 33:11" />Xoossi ba kiyateththan ubbaa kunththi taas immida gishshas koshshizaazi ubbay taas dees; ta nees immizayssa ekkarkkii» giidi Yaaqoobey minththi shoobbida gishshas Eesawey izi gidayssa ekkides.<verse eid="GEN 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 33:12" />Hessafe guye Eesawey, «Denda ane boos; tanikka inttenara issife baana» gides.<verse eid="GEN 33:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 33:13" />Gido attiin Yaaqoobey iza, «Ta godoo! Ne be7iza mala nayti shugo gididayssa ne eraasa; qasse tani galo maratanne guuththa laaqqata dhanththiza dorsatanne miizata naagana koshshees; istti elle elle laaggiko meheti wuri issi gallas hayqqi wurana. <verse eid="GEN 33:13" /><verse number="14" style="v" sid="GEN 33:14" />Hessa gishshas ta godoo neni taappe sinththatada ba; ta sinththan diza meheynne nayti hemettana dandayza keena hemettidi nenara Seyren gayttana» gides.<verse eid="GEN 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 33:15" />Eesawey iza, «Histtiko tani ta asaappe guuththata nees ashshays» gides.</para>
  <para style="p" vid="GEN 33:15">Gido attiin Yaaqoobey iza, «Hessi ayssee? Tani ta godaa sinththan bonchchettidayssi taas gidana» gides.<verse eid="GEN 33:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 33:16" />Hessa gishshas Eesawey he gallas Seyre simmi bides. <verse eid="GEN 33:16" /><verse number="17" style="v" sid="GEN 33:17" />Gido attiin Yaaqoobey Sukoote bides; heen baas keeth keexxides; ba mehetaska aqizaso giigsides; hessa gishshas he sohoza Sukoote<note caller="+" style="f"><char style="fr" closed="false">33:17 </char><char style="fqa" closed="false">Sukoote: </char><char style="ft" closed="false">Sukoote guussi Ibraaweta qaalara, «Daase woykko aqoso» guussa.</char></note> gi sunththides.<verse eid="GEN 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 33:18" />Yaaqoobey Mesphexoomiyappe simmida wode Kanaane biittan diza Seekeeme giza katama saron gakkides; katamays sinththa baggara diza dembaan dunkaani uttides. <verse eid="GEN 33:18" /><verse number="19" style="v" sid="GEN 33:19" />Ba Dunkaaneza tolida gadeza Seekeeme aawa Emoore naytappe 100 saqile biran shammides.<note caller="-" style="x"><char style="xo" closed="false">33:19 </char><char style="xt" closed="false"><ref loc="JOS 24:32">Iya 24:32</ref>; <ref loc="JHN 4:5">Yoha 4:5</ref></char></note> <verse eid="GEN 33:19" /><verse number="20" style="v" sid="GEN 33:20" />Heen yarshosoho keexxidi iza, «Xoossi Isra7eele Xoossa» gi sunththides.<verse eid="GEN 33:20" /></para>
  <chapter eid="GEN 33" />
  <chapter number="34" style="c" sid="GEN 34" />
  <para style="s1">Diinanne Seekeeme Dere Asaa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1" />Liyay Yaaqoobes yelida naya Diinay he wode Seekeeme dere maccassa beyanaas kezadus. <verse eid="GEN 34:1" /><verse number="2" style="v" sid="GEN 34:2" />He biittaa haariza Hiiwey Emoore naa Seekeemey izo wolqqara oykkidi laymatides. <verse eid="GEN 34:2" /><verse number="3" style="v" sid="GEN 34:3" />Hessafe guye iza wozinay izin ekettides; izikka nayo keehi dosida gishshas siiqo qaalan baleththides. <verse eid="GEN 34:3" /><verse number="4" style="v" sid="GEN 34:4" />Seekeemey ba aawa Emoore, «Taas hanno nayo machcho oychcharkkii!» gides.<verse eid="GEN 34:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 34:5" />Yaaqoobey ba naa Diinay moorettidayssa siyida wode iza attuma nayti mehera bazzon diza gishshas istti yaana gakkanaas co7u gides.<verse eid="GEN 34:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 34:6" />Hessafe guye Seekeeme aawa Emoorey Yaaqoobera haasayanaas yides. <verse eid="GEN 34:6" /><verse number="7" style="v" sid="GEN 34:7" />Yaaqoobe attuma nayti he hanidayssa siyida mala ba dizasoppe yiidi ceecidanne shenetida; ays giikko Seekeemey Isra7eele naa bolla ooththanaas bessontta ooso ooththida gishshas daro hanqettida.<verse eid="GEN 34:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 34:8" />Gido attiin Emoorey isttas, «Ta naa Seekeemey intte nayo diina daro siiqiza gishshas hayyana izo izas machcho immerketii! <verse eid="GEN 34:8" /><verse number="9" style="v" sid="GEN 34:9" />Nunara ekettitenne gelettite; intte macca nayta nuus immite; nu macca naytakka inttes ekkite. <verse eid="GEN 34:9" /><verse number="10" style="v" sid="GEN 34:10" />Intte nu giddon uttana dandayeeta; derey keehi aaho; izan de7ite; zal7ite; izan aqo kessite» gides.<verse eid="GEN 34:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 34:11" />He wode Seekeemey Diina aawaanne izi ishata, «Tani intte ta gizayssa kunththizaa gidikko intte oychchizayssa ay gidikkoka ta immana. <verse eid="GEN 34:11" /><verse number="12" style="v" sid="GEN 34:12" />Intte koyta<note caller="+" style="f"><char style="fr" closed="false">34:12</char><char style="fqa" closed="false">Koyta: </char><char style="ft" closed="false">Koyta guussi machchi asas imettiza miish guussa.</char></note> koykko immana; imota koykko intte koyidayssa keena ta immana shin nayo ta ekkana mala ero giite» gides.<verse eid="GEN 34:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 34:13" />Ba michcheyo Diina Seekeemey tunisida gishshas Yaaqoobe attuma nayti Seekeemessinne iza aawa Emoores wordo yootida; <verse eid="GEN 34:13" /><verse number="14" style="v" sid="GEN 34:14" />isttika isttas, «Nuni hessa mala miish ooththana dandayokko; nuni nu michcheyo qaxxarettontta asas immiko hayssi nuna kawushshiza miishsha. <verse eid="GEN 34:14" /><verse number="15" style="v" sid="GEN 34:15" />Nuni intte issi miish ooththiko inttes, ‹Ero› gaana; hessika aazee giikko intte biittaa attuma asay wuri nu mala qaxxarettiko. <verse eid="GEN 34:15" /><verse number="16" style="v" sid="GEN 34:16" />Nuni nu macca nayta inttes immana intte macca naytakka nuus ekkana; nu intte giddon uttidi inttenara issi dere gidana. <verse eid="GEN 34:16" /><verse number="17" style="v" sid="GEN 34:17" />Intte qaxxarettanaas koyonttaa gidikko nuni nu michcheyo ekkidi baana» gida.<verse eid="GEN 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 34:18" />Histtiin istti gidayssi Emooressinne iza naa Seekeemes lo7o misatides. <verse eid="GEN 34:18" /><verse number="19" style="v" sid="GEN 34:19" />Ba aawa keeththan diza ubbaafe aadhdhi bonchchettida Seekeemey Yaaqoobe nayin ufayettida gishshas istti gidayssa ooththanaas gam7ibeenna. <verse eid="GEN 34:19" /><verse number="20" style="v" sid="GEN 34:20" />He wode Emooreynne iza naa Seekeemey ba asaas yootanaas ba diza katama simmi biidi, <verse eid="GEN 34:20" /><verse number="21" style="v" sid="GEN 34:21" />«Ha asati nunara siga; istti nu biittan dettonne zal7etto; nu derey keehi aaho; istta macca nayta nuni ekkana; isttika nu macca nayta ekketto. <verse eid="GEN 34:21" /><verse number="22" style="v" sid="GEN 34:22" />Gido attiin nunara istti issi asa mala de7anaas nuni issi miish ooththanaas koshshees; hessika istti qaxxarettida mala nu attuma asay wuri qaxxarettiko hanana. <verse eid="GEN 34:22" /><verse number="23" style="v" sid="GEN 34:23" />Nuni hessaththo ooththiko istta miizay, istta aqoynne istta mehey wuri nuus deennee? Hessa gishshas ane nuni istti goyssa ero goos; isttika nunara daana» gida.<verse eid="GEN 34:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 34:24" />Katamaa dubbushan shiiqida asay wuri Emooressinne iza naa Seekeemes, «Ero» gida. Histtiin he katama attumasay wuri qaxxarettides.<verse eid="GEN 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 34:25" />Heedzdzanththo gallas istti wuri ba qaxxara madunththaa sakettishin, Yaaqoobe attuma naytappe Diina ishati, Simooninne Lewey giththa mashsha ekkidi oonikka erontta katamaa gelidi, adde gididayta ubbaa wodhida. <verse eid="GEN 34:25" /><verse number="26" style="v" sid="GEN 34:26" />Emoorenne iza naa Seekeeme giththa mashshan wodhidi ba michcheyo Diina Seekeeme sooppe kessi ekkidi bida. <verse eid="GEN 34:26" /><verse number="27" style="v" sid="GEN 34:27" />Yaaqoobe attuma naytikka ahata bollara yedhetti aadhdhidi ba michcheyo Diino tunisida katamaa bonqqida. <verse eid="GEN 34:27" /><verse number="28" style="v" sid="GEN 34:28" />Istta dors, deysh, miiz, hare, qasseka katamaa giddon dizayssanne gaxan dizayssa ubbaa ekkida. <verse eid="GEN 34:28" /><verse number="29" style="v" sid="GEN 34:29" />Istta mehetanne istta machcheta guuththa naytara ubbaa di7i ekki bida; keeththan dizayssaka ubbaa bonqqida.<verse eid="GEN 34:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 34:30" />Yaaqoobey Simoonanne Lewe, «Intte ta bolla meto ehichchideta; ha biittan diza Kanaanetinne Paarizeti tana ixxana; nuni qoodan guuththa; istti issife gididi ta bolla worajjiko taninne taso asay dhayana» gides.<verse eid="GEN 34:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 34:31" />Gido attiin isttas, «Histtiin izi nu michcheyo layma maccassa mala ooththanaas bessizee?» gida.<verse eid="GEN 34:31" /></para>
  <chapter eid="GEN 34" />
  <chapter number="35" style="c" sid="GEN 35" />
  <para style="s1">Beetelen Yaaqoobe Anjjeteth</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1" />Hessafe guye Xoossi Yaaqoobe, «Dendada pude Beetele baada heen de7a; neni ne isha Eesaweppe baqatiza wode nees qonccida Xoossaas heen yarsho yarshizaso giigsa» gides.<note caller="-" style="x"><char style="xo" closed="false">35:1 </char><char style="xt" closed="false"><ref loc="GEN 28:11-17">Medhe 28:11-17</ref></char></note><verse eid="GEN 35:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 35:2" />Yaaqoobeykka baso asaanne banara diza asaa ubbaa, «Intte giddon diza allaga eeqa misleta diggite; intte bolla geeshshite; intte may7oka laammite. <verse eid="GEN 35:2" /><verse number="3" style="v" sid="GEN 35:3" />Ane dendidi pude Beetele boos; ta metotida gallas tani gizaa siyidi tani bida ubbason tanara gidida Xoossaas tani heen yarsho yarshizaso giigsana» gides. <verse eid="GEN 35:3" /><verse number="4" style="v" sid="GEN 35:4" />Hessa gishshas istti ba achchan diza hara dere asaa eeqa misleta ubbaanne ba hayththan diza gutichcha ubbaa kessidi Yaaqoobes immiin Yaaqoobey heyta Seekeemen diza wolaa garsan moogides.<verse eid="GEN 35:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 35:5" />Hessafe guye istta yuushon diza katama ubba asaa bolla Xoossafe dagamaynne yashshateththi wodhdhida gishshas Yaaqoobeynne iza attuma nayti dendidi bishin oonikka istta oykkanaas kaallibeenna.<verse eid="GEN 35:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 35:6" />Yaaqoobeynne izara diza asay wuri Kanaane biittan diza Beetele geetettiza Looza gakkida. <verse eid="GEN 35:6" /><verse number="7" style="v" sid="GEN 35:7" />Heen izi yarsho yarshizaso keexxidi he sohoza Eli-Beetele<note caller="+" style="f"><char style="fr" closed="false">35:7 </char><char style="fqa" closed="false">Eli-Beetele: </char><char style="ft" closed="false">Eli-Beetele guussi Ibraaweta qaalara, «Beetele Xoossa» guussa.</char></note> gi sunththides; ays giikko izi ba ishaappe baqatidi biza wode Xoossi izas qonccida soho gidida gishshassa.<verse eid="GEN 35:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 35:8" />Irbiqa dichchida Dibooray heen hayqqada Beeteleppe duge baggara diza wolaa garsan iza moogettadus; hessa gishshas he miththaa sunththi Alem-Bakute<note caller="+" style="f"><char style="fr" closed="false">35:8 </char><char style="fqa" closed="false">Alem-Bakute: </char><char style="ft" closed="false">Alem-Bakute guussi Ibraaweta qaalara, «Yeeho wola» guussa.</char></note> geetettides.<verse eid="GEN 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 35:9" />Yaaqoobey Mesphexoomiyappe simmidaappe guye Xoossi izas qasseka qonccidi iza anjjides; <verse eid="GEN 35:9" /><verse number="10" style="v" sid="GEN 35:10" />Xoossi iza, «Ha7i gakkanaas ne sunththi Yaaqoobe; gido attiin hayssafe guye mulekka Yaaqoobe geetettaka; ne sunththi Isra7eele geetettana» giidi izi iza Isra7eele gi sunththides.<note caller="-" style="x"><char style="xo" closed="false">35:10 </char><char style="xt" closed="false"><ref loc="GEN 32:28">Medhe 32:28</ref></char></note><verse eid="GEN 35:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 35:11" />Qasse Xoossi Yaaqoobe, «Tani Ubbaa Dandayza Xoossa; neni yeletta; coratta; dereynne dere maabaray neeppe kezana; kawotikka ne gulbateppe kezana. <verse eid="GEN 35:11" /><verse number="12" style="v" sid="GEN 35:12" />Tani Abrahaamessinne Yisaaqas immida biittaa qasse nees immana; neeppe guyekka tani ha biittaa ne zereththas immana» gides.<note caller="-" style="x"><char style="xo" closed="false">35:11-12 </char><char style="xt" closed="false"><ref loc="GEN 17:4-8">Medhe 17:4-8</ref></char></note> <verse eid="GEN 35:12" /><verse number="13" style="v" sid="GEN 35:13" />Hessafe guye Xoossi izara haasayda sohoppe pude bides.<verse eid="GEN 35:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 35:14" />Yaaqoobey Xoossi banara haasayda sohon shuch essidi iza bolla ushsha yarsho gussides; zaytekka iza bolla tigides. <verse eid="GEN 35:14" /><verse number="15" style="v" sid="GEN 35:15" />Yaaqoobey Xoossi banara haasayda sohoza, «Beetele» gi sunththides.<note caller="-" style="x"><char style="xo" closed="false">35:14-15 </char><char style="xt" closed="false"><ref loc="GEN 28:18-19">Medhe 28:18-19</ref></char></note><verse eid="GEN 35:15" /></para>
  <para style="s1">Eraheeli Hayqonne Yisaaqa Hayqo</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16" />Istti hessafe guye Beeteleppe dendi Efraata gakkanaas guuth ashshida mala Eraheelo wolqqama miixay oykkides. <verse eid="GEN 35:16" /><verse number="17" style="v" sid="GEN 35:17" />Miixay izo waayisiin izo yelissizaara, «Babbofa; hayssika attuma naa» gadus. <verse eid="GEN 35:17" /><verse number="18" style="v" sid="GEN 35:18" />Gido attiin iza hayqqa shemppo kezishin ba naa Beeni-Oone<note caller="+" style="f"><char style="fr" closed="false">35:18 </char><char style="fqa" closed="false">Beeni-Oone: </char><char style="ft" closed="false">Ben7oone guussi Ibraaweta qaalara, «Meto naa woykko ta ceece naa» guussa.</char></note> ga sunththadus; Yaaqoobey iza Biniyaame<note caller="+" style="f"><char style="fr" closed="false">35:18 </char><char style="fqa" closed="false">Biniyaame: </char><char style="ft" closed="false">Biniyaame guussi Ibraaweta qaalara, «Ta ushachcha kushe» gidishin birsheththay, «Qaada lo7o naa» guussa.</char></note> gi sunththides.<verse eid="GEN 35:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 35:19" />Hessafe guye Eraheela hayqqada Beeteliheeme giza Efraata efiza oge doonan moogettadus. <verse eid="GEN 35:19" /><verse number="20" style="v" sid="GEN 35:20" />Yaaqoobey izi duufon hawulte shuch essides; he hawulte shuchchay hach gakkanaaska Eraheeli duufo malata gidi dees.<verse eid="GEN 35:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 35:21" />Isra7eeley heeppe dendidi Edera gimbefe he pinththan ba Dunkaaneza tokkides.<verse eid="GEN 35:21" /></para>
  <para style="s1">Yaaqoobe Nayta</para>
  <para style="r">(<ref loc="1CH 2:1-2">1Taari 2:1-2</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 35:22" />Isra7eeley he biittan dishin Oroobeeley biidi ba aawaas yelida aylle Bilihara zin7ides; Isra7eeleykka ha yo7oza siyides.</para>
  <para style="p" vid="GEN 35:22">Yaaqoobe attuma nayti tammanne nam7a.<note caller="-" style="x"><char style="xo" closed="false">35:22 </char><char style="xt" closed="false"><ref loc="GEN 49:4">Medhe 49:4</ref></char></note>Isttika, <verse eid="GEN 35:22" /><verse number="23" style="v" sid="GEN 35:23" />Liya nayti Yaaqoobe bayra naa Oroobeele, Simoona, Lewe, Yuhuda, Yisakoorenne Zaabiloone. <verse eid="GEN 35:23" /><verse number="24" style="v" sid="GEN 35:24" />Eraheeli attuma nayti Yooseefenne Biniyaame. <verse eid="GEN 35:24" /><verse number="25" style="v" sid="GEN 35:25" />Eraheeli aylle Biliha attuma nayti Daanenne Niftaaleme. <verse eid="GEN 35:25" /><verse number="26" style="v" sid="GEN 35:26" />Liya osanchcha Zilfi attuma nayti Gaadenne Aaseere. Hayti Masophexoomyan Yaaqoobes yelettida iza attuma nayta.<verse eid="GEN 35:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27" />Yaaqoobey ba aaway dizaso Mamire geetettizaso yides; hessika Abrahaameynne Yisaaqi kase deyida Qiriyaate-Arba7e woykko Kebroone geetettizaso.<note caller="-" style="x"><char style="xo" closed="false">35:27 </char><char style="xt" closed="false"><ref loc="GEN 13:18">Medhe 13:18</ref></char></note> <verse eid="GEN 35:27" /><verse number="28" style="v" sid="GEN 35:28" />Yisaaqi 180 layth de7ides; <verse eid="GEN 35:28" /><verse number="29" style="v" sid="GEN 35:29" />izi daro wode de7idi keehi cimmi hayqqidi ba aawatan gaaggides; iza nayti Eesaweynne Yaaqoobey iza moogida.<verse eid="GEN 35:29" /></para>
  <chapter eid="GEN 35" />
  <chapter number="36" style="c" sid="GEN 36" />
  <para style="s1">Eesawe Yeleta</para>
  <para style="r">(<ref loc="1CH 1:34-37">1Taari 1:34-37</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1" />Eedoome geetettiza Eesawe yeletay hayssafe kaalli xaafettidayssa. <verse eid="GEN 36:1" /><verse number="2" style="v" sid="GEN 36:2" />Eesawey Kanaane biitta macca naytappe baas machcho ekkides; isttika Hiite Eeloone naa Aada, Hiiweya Xiba7oone naa Aanay yelida Oholibaamenne<note caller="-" style="x"><char style="xo" closed="false">36:2 </char><char style="xt" closed="false"><ref loc="GEN 26:34">Medhe 26:34</ref></char></note> <verse eid="GEN 36:2" /><verse number="3" style="v" sid="GEN 36:3" />Isma7eele naa Nebayooti michchiyo Baasemaato.<note caller="-" style="x"><char style="xo" closed="false">36:3 </char><char style="xt" closed="false"><ref loc="GEN 28:9">Medhe 28:9</ref></char></note> <verse eid="GEN 36:3" /><verse number="4" style="v" sid="GEN 36:4" />Aaday Eesawes Elfaaze yeladus; Baasemaatayakka Era7u7eele yeladus; <verse eid="GEN 36:4" /><verse number="5" style="v" sid="GEN 36:5" />Oholibaame Ya7uushe, Ya7ilaamenne Qoore yeladus; Kanaane biittan Eesawes yelettida attuma nayti haytantta.<verse eid="GEN 36:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 36:6" />Eesawey ba machcheta, ba attuma naytanne macca nayta, baso as ubbaa ba miizatanne ba mehe ubbaa Kanaane biittan izi haaridayssa ubbaa ekkidi ba isha Yaaqoobeppe haakki bides. <verse eid="GEN 36:6" /><verse number="7" style="v" sid="GEN 36:7" />Istta haaroy darida gishshas istti issife de7anaas dandaybeettenna; mehey isttas darida gishshas istti diza derey istta nam7atas gidanaas dandaybeenna.<verse eid="GEN 36:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 36:8" />Histtiin Eedoome geetettiza Eesawey Seyre geetettiza gezzen uttides.<verse eid="GEN 36:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 36:9" />Seyre geetettiza gezze biittan diza Eedoometa aawa Eesawe yeletay hayssafe kaalli xaafettidayssa. <verse eid="GEN 36:9" /><verse number="10" style="v" sid="GEN 36:10" />Eesawe attuma nayta sunththi hayssafe kaalli xaafettidayssa; hessatikka Eesawe machcho Aada naa Elfaazenne Eesawe machcho Baasemaati naa Era7u7eele.<verse eid="GEN 36:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 36:11" />Elfaaze nayti Temaane, Omaare, Xefo, Ga7itaamenne Qenaaze. <verse eid="GEN 36:11" /><verse number="12" style="v" sid="GEN 36:12" />Qasse Eesawe naa Elfaazes Teminaa7e geetettiza aylley dawus; izakka Elfaazes Amaaleeqe yeladus; hayti Eesawe machcho Aadis naa nayta.<verse eid="GEN 36:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 36:13" />Era7u7eele attuma nayti Nahaate, Zaraahe, Shammahanne Miizahe; hayti Eesawe machchiyo Baasemaatis naa nayta.<verse eid="GEN 36:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 36:14" />Xiba7oones naaza naa Aanay yelida Oholibaami attuma nayti hayta; iza Eesawes Ya7uushe, Ya7ilaamenne Qoore yeladus.<verse eid="GEN 36:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 36:15" />Eesawe yeletaa zereththa halaqati hayssafe kaalli xaafettidayta. Eesawes bayra naa Elfaaze attuma naytas halaqa gididayti Temaane, Omaare, Xefo, Qenaaze, <verse eid="GEN 36:15" /><verse number="16" style="v" sid="GEN 36:16" />Qoore, Ga7itaamenne Amaaleeqe; Eedoome biittan Elfaazey yelida halaqati hayta; hayti wuri Aadis naa nayta.<verse eid="GEN 36:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 36:17" />Eesawe naa Era7u7eele attuma naytas halaqa gididayti Nahaate, Zaraahe, Shammahanne Miizahe; Eedoome biittan Era7u7eeley yelida halaqati hayta; istti Eesawe machcho Baasemaatis naa nayta.<verse eid="GEN 36:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 36:18" />Eesawe machchiyo Oholibaami attuma naytas halaqa gididayti Ya7uushe, Ya7ilaamenne Qoore; istti Aana naa, Eesawe machchiyo Oholibaamippe yelettida halaqata.<verse eid="GEN 36:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 36:19" />Hayti Eedoome geetettiza Eesawe attuma naytassinne istta zereththatas halaqata.<verse eid="GEN 36:19" /></para>
  <para style="s1">Seyre Yeleta</para>
  <para style="r">(<ref loc="1CH 1:38-42">1Taari 1:38-42</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 36:20" />Eedoome biittan diza Hoore Seyre attuma nayti hayssafe kaalli xaafettidayta; heytikka Looxaane, Shobaale, Xiba7oone, Aana, <verse eid="GEN 36:20" /><verse number="21" style="v" sid="GEN 36:21" />Dishoone, Exeerenne Dishaane; isttika Eedoome biittan diza Seyre attuma nayti, Hooreta halaqata.<verse eid="GEN 36:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 36:22" />Looxaane attuma nayti Hoorenne Hemaane; Looxaane michchiya Teminaa7o.<verse eid="GEN 36:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 36:23" />Shobaale attuma nayti Aliwaane, Manahaate, Eebaale, Shefanne Oonname.<verse eid="GEN 36:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 36:24" />Xiba7oone attuma nayti Aayanne Aana; Aanaykka bazzon ba aawa Xiba7oone hareta heemmishe xabala haath demmidayssa.<verse eid="GEN 36:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 36:25" />Aana nay Dishoone; naya qasse Oholibaamo.<verse eid="GEN 36:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 36:26" />Dishoone attuma nayti Hemdaane, Eshibaane, Yitiraanenne Kaaraane.<verse eid="GEN 36:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 36:27" />Exeere attuma nayti Bilihaane, Za7iwaanenne Aqaane.<verse eid="GEN 36:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 36:28" />Dishaane attuma nayti Uuxenne Araane.<verse eid="GEN 36:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 36:29" />Hooreta halaqati haytantta; Looxaane, Shobaale, Xiba7oone, Aana, <verse eid="GEN 36:29" /><verse number="30" style="v" sid="GEN 36:30" />Dishoone, Exeerenne Dishaane. Hayti Seyre biittan ba qommon qommon shaakettida Hooreta halaqata.<verse eid="GEN 36:30" /></para>
  <para style="s1">Eedoome Kawota</para>
  <para style="r">(<ref loc="1CH 1:43-54">1Taari 1:43-54</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 36:31" />Isra7eelen kawoy kawotanaappe kase Eedoome biittan kawotida kawoti hayssafe kaalli xaafettidayta.<verse eid="GEN 36:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 36:32" />Bi7oore naa Beelay Eedoomen kawotides; iza katamaa sunththi Dinaabe geetettees.<verse eid="GEN 36:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 36:33" />Beelay hayqqiin Booxirappe yida Zaraahe nay Yobaabey kawotides.<verse eid="GEN 36:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 36:34" />Yobaabey hayqqiin Temaane biittafe yida Hushamey kawotides.<verse eid="GEN 36:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 36:35" />Hushamey hayqqiin Midiyaame asata Mo7aabe biittan xoonida Badaade naa Hadaadey, kawotides; iza katamaa sunththi Awite geetettides.<verse eid="GEN 36:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 36:36" />Hadaadey hayqqiin Maasireeqeppe yida Samilay kawotides.<verse eid="GEN 36:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 36:37" />Samilay hayqqiin shaafa achchan diza Erahooboteppe yida Sha7uley kawotides.<verse eid="GEN 36:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 36:38" />Sha7uley hayqqiin Akiboore naa Ba7aali-Hanaaney kawotides.<verse eid="GEN 36:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 36:39" />Akiboore naa Ba7aali-Hanaaney hayqqiin Hadaarey kawotides; iza katamaa sunththi Paa7u geetettees; iza machchiya Mezahaabe nayo Maxireeda yelida Mahexabi7eelo geetettawus.<verse eid="GEN 36:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 36:40" />Eesawe yeleta halaqati ba qommon qommon ba sunththan sunththan haytantta; Teminaa7e, Aliwa, Yeteete, <verse eid="GEN 36:40" /><verse number="41" style="v" sid="GEN 36:41" />Oholibaame, Eela, Pinoone, <verse eid="GEN 36:41" /><verse number="42" style="v" sid="GEN 36:42" />Qenaaze, Temaane, Mibizaare, <verse eid="GEN 36:42" /><verse number="43" style="v" sid="GEN 36:43" />Magidi7eelenne Iraame. Haytanti ba haariza biittan, ba dizason Eedoome halaqata. Hayssi Eesawey Eedoometa aawa.<verse eid="GEN 36:43" /></para>
  <chapter eid="GEN 36" />
  <chapter number="37" style="c" sid="GEN 37" />
  <para style="s1">Yooseefenne Iza Ishata</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1" />Yaaqoobey kase ba aaway deyida Kanaane biittan uttides.<verse eid="GEN 37:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 37:2" />Yaaqoobe nayti hanidayssi hayssafe kaallidi xaafettidayssa.</para>
  <para style="p" vid="GEN 37:2">Yooseefey 17 layththa naa gidida wode ba aawaa aylletappe, Bilihappenne Zilfife yelettida ba ishatara ba aawa meheta heemmees; he wode izi ba aawaas istti ooththida iita miish ehi yootees.<verse eid="GEN 37:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 37:3" />Isra7eeley Yooseefe cimateththan yelida gishshas hankko attuma nayta ubbaafe aaththi siiqees; izi izas alleqo may7o giigsides. <verse eid="GEN 37:3" /><verse number="4" style="v" sid="GEN 37:4" />Iza ishati istta aaway iza isttafe aaththi siiqizayssa be7idi istti iza ixxidi lo7o qaalan izara haasayanaas dandaybeettenna.<verse eid="GEN 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 37:5" />Yooseefey agumo agumettidi ba ishatas yootides; isttika iza gede gujji ixxida. <verse eid="GEN 37:5" /><verse number="6" style="v" sid="GEN 37:6" />Izi isttas, «Tani agumettida agumo siyite. <verse eid="GEN 37:6" /><verse number="7" style="v" sid="GEN 37:7" />Nuni gade giddon kaththa mirqqe mirqqishin ta mirqqeya dendada sitti ga eqqadus; intte mirqqeti gidikko yuuyi aadhdhidi ta mirqqeysi ziggida» gides.<verse eid="GEN 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 37:8" />Iza ishati iza, «Neni nu bolla kawotana hanay? Woykko nuna tumu haarana hanay?» gida; istti iza agumoza gishshassinne izi isttas yootida qaalaa gishshas kaseppe iza aaththi ixxida.<verse eid="GEN 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 37:9" />Qasseka Yooseefey hara agumo agumettidi ba ishanttas yootides; «Siyite; tani hara agumokka agumettadis; he agumozan arshey, aginaynne 11 xoolintteti taas ziggishin be7adis» gides.<verse eid="GEN 37:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 37:10" />He izi be7ida agumoza ba aawassinne ba ishatas yootiin iza aaway iza, «Hayssi neni agumettidayssi ay agumoo? Tumu tani, ne aayeyanne ne ishati yiidi ne sinththan sa7an gufannidi nees zigganee?» gi hanqettides. <verse eid="GEN 37:10" /><verse number="11" style="v" sid="GEN 37:11" />Iza ishati iza miqqaynida; gido attiin iza aaway ha yo7oza ba wozinan woththidi naagides.<note caller="-" style="x"><char style="xo" closed="false">37:11 </char><char style="xt" closed="false"><ref loc="ACT 7:9">Hawa 7:9</ref></char></note><verse eid="GEN 37:11" /></para>
  <para style="s1">Yooseefe Bayzeteth</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12" />Issi gallas iza ishati Seekeeme achchan ba aawaa meheta heemmanaas biin, <verse eid="GEN 37:12" /><verse number="13" style="v" sid="GEN 37:13" />Isra7eeley Yooseefe, «Ne ishati Seekeemen mehe heemmizayssa ne eraasa; haa ya; ta nena isttako kiittana» gides.</para>
  <para style="p" vid="GEN 37:13">Yooseefeykka, «Ero» gides.<verse eid="GEN 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 37:14" />Yaaqoobeykka, «Baada ne ishatinne mehey saro dizaakko be7a yaada istta hanota taas yoota» giidi iza Kebroone shoobba kiittiin izi Seekeeme bides. <verse eid="GEN 37:14" /><verse number="15" style="v" sid="GEN 37:15" />Heen demba giddon izi gede haa simerettishin issi asi iza demmidi, «Naazoo! Ay koyay?» gi oychchides.<verse eid="GEN 37:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 37:16" />Izikka, «Ta ishata koyays; istti mehe heemmizasohoy awakko taas yootarkkii!» gides.<verse eid="GEN 37:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 37:17" />Histtiin addezi, «Hessafe dendichchida; isttas, ‹Nuni Dootaane boos› gishin siyadis» gides; hessa gishshas Yooseefey ba ishata guye biidi istta Dootaanen demmides.<verse eid="GEN 37:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 37:18" />Gido attiin izi haahon dishin istti iza be7ida; izi isttako gakkontta dishin istti iza wodhanaas maqettida. <verse eid="GEN 37:18" /><verse number="19" style="v" sid="GEN 37:19" />Issoy issaas, «Be7ite! Agumo goday yees. <verse eid="GEN 37:19" /><verse number="20" style="v" sid="GEN 37:20" />Haa yiite! Iza wodhidi ha ollatappe issaa giddo yeggoos. Hessafe guye, ‹Iita do7ay iza mides› gaana; histtidi iza agumoy polettiin ane be7ana» gida.<verse eid="GEN 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 37:21" />Oroobeeley hessa siyidi istta kusheppe iza ashshanaas koyidi, «Iza wodho wodhdhoko; <verse eid="GEN 37:21" /><verse number="22" style="v" sid="GEN 37:22" />Suuth gussofte; iza intte bazzon diza ha ollaa giddo yeggite; iza bolla kushe woththofte» gides. Oroobeeley iza istta kusheppe ashshidi guye iza aawaakko yeddanaas qoppides.<verse eid="GEN 37:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 37:23" />Yooseefey ba ishataakko gakkida wode izi may7ida alleqo may7o izappe qaari ekkida; <verse eid="GEN 37:23" /><verse number="24" style="v" sid="GEN 37:24" />iza efidi haaththi baynda mela ollan yeggida.<verse eid="GEN 37:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 37:25" />Istti ba qumaa maanaas uttidaashe Isma7eele dere asati Gibxe baanaas Gala7aadeppe yizayta dhoqqu giidi be7ida; istti ba gaamellan sawo, balasaane geetettiza dhalenne karbbe caani woththida.<verse eid="GEN 37:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 37:26" />Yuhuday ba ishata, «Nuni nu ishaa wodhidi iza suuththaa qottiko nuna ay maaddanee? <verse eid="GEN 37:26" /><verse number="27" style="v" sid="GEN 37:27" />Haa yiite; iza Isma7eeletas bayzoos; iza bolla nu kushe woththoko; gaasoykka izi nu ishanne nu asho.» Histtiin iza ishati wurikka ero gida. <verse eid="GEN 37:27" /><verse number="28" style="v" sid="GEN 37:28" />Hessa gishshas Midiyaame biitta zal7anchchati hessara aadhdhishin iza ishati Yooseefe ollaafe kessidi Isma7eele asatas 20 biras bayziin istti Yooseefe Gibxe biitta efida.<note caller="-" style="x"><char style="xo" closed="false">37:28 </char><char style="xt" closed="false"><ref loc="ACT 7:9">Hawa 7:9</ref></char></note><verse eid="GEN 37:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 37:29" />Oroobeeley ollaako simmidi Yooseefey heen bayndayssa be7ida wode ceecidi ba may7o daakkides <verse eid="GEN 37:29" /><verse number="30" style="v" sid="GEN 37:30" />Izi guye ba ishataakko biidi, «Naazi heen baawa; ha7i ta awa simma boo!» gides.<verse eid="GEN 37:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 37:31" />Hessafe guye istti issi deysh ekki shukkidi Yooseefe may7o suuththan maadhida. <verse eid="GEN 37:31" /><verse number="32" style="v" sid="GEN 37:32" />Iza aleqo may7oza aawaakko efidi aawaas, «Nuni hayssa demmi ekkidos; hayssi ne naaza may7okkonne harakko ane xeella» gida.<verse eid="GEN 37:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 37:33" />Aawaykka may7ozi Yooseefeyssa gididayssa eridi, «Ee hayssi ta naaza may7o! Iita do7ay iza michchides; tumukka Yooseefe do7ay puuzereththi montta aggenna» gides.<verse eid="GEN 37:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 37:34" />Yaaqoobeykka mishettidi ba may7o peedhi yeggides; maaqa may7idi daro wode gakkanaas ba naazas yeekkides. <verse eid="GEN 37:34" /><verse number="35" style="v" sid="GEN 37:35" />Iza attuma naytinne macca nayti wuri iza minththeththanaas izakko yida; gido attiin izi minettontta ixxidi, «Hanenna! Tani yeekkada ta naakko baada duufon gelana» giidi iza aaway izas yeekkides.<verse eid="GEN 37:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 37:36" />He wode Midiyaame biitta asati Yooseefe Gibxe kawo oosanchcha Phixifaaras Gibxen bayzida; Phixifaaraykka zabeta halaqa.<verse eid="GEN 37:36" /></para>
  <chapter eid="GEN 37" />
  <chapter number="38" style="c" sid="GEN 38" />
  <para style="s1">Yuhudanne Ti7imaaro</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1" />He wode Yuhuday ba ishatappe shaakettidi Adulaame geetettiza katamaan diza Hiira geetettiza addezara de7ana bides. <verse eid="GEN 38:1" /><verse number="2" style="v" sid="GEN 38:2" />Heen Yuhuday Shu7a geetettiza Kanaane dere macca naa be7ides. Izikka izo machcho ekkidi izira de7ides. <verse eid="GEN 38:2" /><verse number="3" style="v" sid="GEN 38:3" />Iza izas shaarada attuma naa yelada Eera ga sunththadus. <verse eid="GEN 38:3" /><verse number="4" style="v" sid="GEN 38:4" />Qasseka shaarada attuma naa yelada Oonaane ga sunththadus. <verse eid="GEN 38:4" /><verse number="5" style="v" sid="GEN 38:5" />Qasse gujjadakka attuma naa yelada iza Seela ga sunththadus. Izakka iza Akizaabe geetettiza biittan yeladus.<verse eid="GEN 38:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 38:6" />Yuhuday ba bayra naaza Eera Ti7imaaro machcho ekisides. <verse eid="GEN 38:6" /><verse number="7" style="v" sid="GEN 38:7" />Yuhuda bayra naa Eeray GODAA sinththan iita as gidida gishshas GODAY iza wodhides.<verse eid="GEN 38:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 38:8" />Yuhuday Oonaane, «Ne ishaza machcho laattada izas laata naa yelada iza sunth xeygisa» gides. <verse eid="GEN 38:8" /><verse number="9" style="v" sid="GEN 38:9" />Gido attiin Oonaaney yelettiza nayti baas gidonttayssa eridi ba ishaa machcheyra aqiza wode aydekka ba ishaas nay yelettontta mala ba zereththaa biittan gussees. <verse eid="GEN 38:9" /><verse number="10" style="v" sid="GEN 38:10" />Izi ooththidayssi GODAA sinththan para gidida gishshas GODAY izakka wodhides.<verse eid="GEN 38:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 38:11" />Hessafe guye Yuhuday ba naa machcho Ti7imaaro, «Ta nayee Seelay diccana gakkanaas ne aawaa soo baada am7eteththan daashsha» gides. Hessa izi aazas gidee? giikko, «Seelay ba ishata mala hayqqanaakko» giidi hirgida gishshassa. Hessa gishshas Ti7imaara baada ba aawa soon de7adus.<verse eid="GEN 38:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 38:12" />Daro wodeppe guye Shu7a naya, Yuhuda machchiya hayqqadus. Yuhuday kayotti aaththidaappe guye ba lagge Adulaame dere as Hiira geetettizayssara ba dorsa iske qanxxiza asati dizaso Temina bides.<verse eid="GEN 38:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 38:13" />Asay Ti7imaaris, «Beya; ne bolloy Yuhuday ba dorsata iske qanxxanaas Temina bees» gi yootides. <verse eid="GEN 38:13" /><verse number="14" style="v" sid="GEN 38:14" />Iza ba am7eteththa may7oza qaarada bana baleththanaas goos ekka gullunttada Temina efiza oge doonan diza Enayme katama pengen uttadus. Hessa iza ooththiday Seelay diccidi gakkinkka iza izas machcho gidanaas ekkonttayssa erida gishshassa.<verse eid="GEN 38:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 38:15" />Iza ba ayfeso gulluntta uttida gishshas Yuhuday izo be7idi layma maccas giidi qoppides. <verse eid="GEN 38:15" /><verse number="16" style="v" sid="GEN 38:16" />Ba naa machcho gididayssa erontta dishe oge gaxa izikko shiiqidi izo, «Tanara zin7arkkii!» gides.</para>
  <para style="p" vid="GEN 38:16">Histtiin iza, «Tani nenara zin7iko neni taas ay immanee?» ga oychchadus.<verse eid="GEN 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 38:17" />Izikka, «Tani ta meheppe issi deysha laaqqa nees yeddana» gides.</para>
  <para style="p" vid="GEN 38:17">Izakka, «Neni hessa taas yeddana gakkanaas ay oyththanee?» gadus.<verse eid="GEN 38:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 38:18" />Izi, «Ay oyththoo?» gi iza oychchides.</para>
  <para style="p" vid="GEN 38:18">Izakka, «Ne maatame qalabateza iza qachchizayssaranne ne kushen diza guufeza oyththa» giin izi heyta immidi izira zin7iin iza izas shaaradus. <verse eid="GEN 38:18" /><verse number="19" style="v" sid="GEN 38:19" />Iza hessafe dendada bidaappe guye ba gullunttida goossaza qaarada ba am7eteththa may7o may7adus.<verse eid="GEN 38:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 38:20" />Yuhuday ba oyththidayssa izippe zaari ekkanaas deysha laaqqa ba lagge Adulaame bolla izis yeddides; gido attiin izi izo demmibeenna. <verse eid="GEN 38:20" /><verse number="21" style="v" sid="GEN 38:21" />Izi he biitta asaa, «Enayme katamaan oge doonan uttida layma maccassaya awa badee?» gi oychchides.</para>
  <para style="p" vid="GEN 38:21">Asay, «Layma maccassi hayssan mulekka baawa» gides.<verse eid="GEN 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 38:22" />Izikka Yuhudakko simmidi iza, «Tani izo demmabeekke; hessafekka bollara he biitta asay, ‹Layma maccassi hayssan mulekka di erenna› gida» gides.<verse eid="GEN 38:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 38:23" />Histtiin Yuhuday, «Ba oykkidayssa baas ekku; histtontta aggiko asi nuna miiccana. Histtiin tani izis deysha laaqqa yeddadis; gido attiin neni izo demmabeekka» gides.<verse eid="GEN 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 38:24" />Heedzdzu aginappe guye asay, «Ne naa machchiya Ti7imaara laymatada shaaradus» giidi Yuhudas yootides.</para>
  <para style="p" vid="GEN 38:24">Yuhudaykka, «Izo kare kessidi taman xuuggite» gides.<verse eid="GEN 38:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 38:25" />Izo kare kessiza wode, «Tani shaariday ha miishshata godaassa; beya; hayssa maatame qalabateza iza qachchizayssanne hayssi guufezi oonayssako erana dandaykko era» gaada ba bollos kiita yeddadus.<verse eid="GEN 38:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 38:26" />Yuhuday he miishshata eridi, «Taappe iza xillo; gaasoykka tani izo ta naa Seelas ekkabeekke» gides. Hessafe guye izi izira nam7anththo zin7ibeenna.<verse eid="GEN 38:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 38:27" />Iza yelana haniza wode izi ulon mentte attuma nayti deettes. <verse eid="GEN 38:27" /><verse number="28" style="v" sid="GEN 38:28" />Iza maarettishin isttafe issay ba kushe kessiin yelissizaara, «Be7ite; hayssi koyro kezees» gaada zo7o qacina iza kushen qachchadus. <verse eid="GEN 38:28" /><verse number="29" style="v" sid="GEN 38:29" />Gido attiin izi ba kushe guye ekkida wode iza ishay yelettiin iza, «Neni waana sinththata kezadii!» gadus. Hessa gishshas iza Paareese<note caller="+" style="f"><char style="fr" closed="false">38:29 </char><char style="fqa" closed="false">Paareese: </char><char style="ft" closed="false">Paareese gizayssi Ibraaweta qaalara, «Paareexe» gidishin birsheththay, «Sinththati kezides woykko moorides» guussa.</char></note> ga sunththadus. <verse eid="GEN 38:29" /><verse number="30" style="v" sid="GEN 38:30" />Hessafe guye iza kushen zo7o qacinay qashetti diza Paareese ishay yelettiin sunththay Zaraahe<note caller="+" style="f"><char style="fr" closed="false">38:30 </char><char style="fqa" closed="false">Zaraahe: </char><char style="ft" closed="false">Zaraahe guussi Ibraaweta qaalara, «Poo7o woykko wolqqanth» guussa.</char></note> geetettides.<verse eid="GEN 38:30" /></para>
  <chapter eid="GEN 38" />
  <chapter number="39" style="c" sid="GEN 39" />
  <para style="s1">Yooseefenne Phixifaara Machcho</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1" />Isma7eele asati Yooseefe Gibxe efiin Gibxe kawo oosanchchatappe Phixifaara geetettiza zabeta halaqay Yooseefe Isma7eeletappe shammides.<verse eid="GEN 39:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 39:2" />GODAY Yooseefera diza gishshas izi ooththizayssa ubbaa izas injjesides; izikka ba godaa soon Gibxen de7ides.<note caller="-" style="x"><char style="xo" closed="false">39:2 </char><char style="xt" closed="false"><ref loc="ACT 7:9">Hawa 7:9</ref></char></note> <verse eid="GEN 39:2" /><verse number="3" style="v" sid="GEN 39:3" />GODAYKKA izara de7izayssanne GODAY izi ooththidayssa ubbaa izas injjesidayssa Phixifaaray be7idi, <verse eid="GEN 39:3" /><verse number="4" style="v" sid="GEN 39:4" />Yooseefe dosides. Yooseefeykka iza oosanchcha gidides. Phixifaaray iza ba keeththa asaa bolla sunththidi baas dizaaz ubbaa iza kushen woththides. <verse eid="GEN 39:4" /><verse number="5" style="v" sid="GEN 39:5" />Phixifaaray ba keeththan dizayssa ubbaa bollanne ba aqota ubbaa bolla sunththida wodeppe doommiin GODAY Gibxe addeza keeth Yooseefe geedon anjjides. GODAA anjjoy Phixifaara soon gidiin karen diza miish ubbaa bolla wodhdhides. <verse eid="GEN 39:5" /><verse number="6" style="v" sid="GEN 39:6" />Hessa gishshas baas diza ubbaa Yooseefes sheedhdhides; izi ba miza kaththaafe attiin hara Yooseefe kushen yeggides.</para>
  <para style="p" vid="GEN 39:6">Yooseefey yegalththinne mala lo7o asa. <verse eid="GEN 39:6" /><verse number="7" style="v" sid="GEN 39:7" />Guuththa wodeppe guye iza goda machcheya Yooseefe cadda xeellada, «Haa ya; tanara zin7a» gadus.<verse eid="GEN 39:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 39:8" />Gido attiin izi ixxides; ba godaa machcheys, «Beya! Ta goday bason diza ubbaa taas sheedhdhidi aazaska hirgenna; baas dizayssa ubbaa ta kushen woththides. <verse eid="GEN 39:8" /><verse number="9" style="v" sid="GEN 39:9" />Hason taappe aadhdhizay deenna; neni iza machcho gidida gishshas nena xalla attiin ta goday taas immontta miishshi baawa. Histtiin tani hayssa mala iita miish Xoossa sinththan wostta ooththoo?» gides. <verse eid="GEN 39:9" /><verse number="10" style="v" sid="GEN 39:10" />Iza ubba wode Yooseefe saleththinkka izi eemo immibeenna; izira ishech attiin izikko shiiqanawukka koyibeenna.<verse eid="GEN 39:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 39:11" />Issi gallas izi ba ooso ooththanaas soo gelishin soo aylletappe oonikka soon baawa. <verse eid="GEN 39:11" /><verse number="12" style="v" sid="GEN 39:12" />Izakka Yooseefe may7o shiishsha oykkada, «Tanara zin7a» gadus. Gido attiin izi ba may7o izi kushen yeggidi sooppe kare woxxi kezides.<verse eid="GEN 39:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 39:13" />Yooseefey ba may7o izi kushen yeggidi sooppe kare woxxi kezidayssa iza be7ada, <verse eid="GEN 39:13" /><verse number="14" style="v" sid="GEN 39:14" />ba soo aylleta xeygada isttas, «Be7ite! Ta azinay ehida Ibraawe addezi tana kawushshishe aggides; izi tanara zin7anaas haa soo gelides; gido attiin tani ta qaala dhoqqisada waassadis. <verse eid="GEN 39:14" /><verse number="15" style="v" sid="GEN 39:15" />Histtiin izi ba may7o ta achchan yeggidi sooppe kare woxxi kezides» gadus.<verse eid="GEN 39:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 39:16" />Keeththa aaway yaana gakkanaas iza Yooseefe may7oza ba achchan woththadus. <verse eid="GEN 39:16" /><verse number="17" style="v" sid="GEN 39:17" />Hessafe guye iza izas, «Hessi neni nuus ehida Ibraawe aylley tanara zin7anaas taakko gelides; <verse eid="GEN 39:17" /><verse number="18" style="v" sid="GEN 39:18" />Gido attiin tani ta qaala dhoqqisada waassiin izi ba may7o ta achchan yeggidi sooppe kare woxxi kezides» gadus.<verse eid="GEN 39:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 39:19" />Keeththa aaway machcheyo, «Ne aylley tana hayssaththo ooththides» gaada yootida qaalaa siyidi daro hanqettides. <verse eid="GEN 39:19" /><verse number="20" style="v" sid="GEN 39:20" />Izikka Yooseefe efidi kawo qasho asay diza qasho keeththan yeggides.<verse eid="GEN 39:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 39:21" />Gido attiin Yooseefey heen qasho keeththan diza wode GODAY izara dees. Xoossi qasho keeththan izara diza ba kiyateth izas darssides. Qasseka qasho keeththa halaqaza sinththan izas bonchcho immides.<note caller="-" style="x"><char style="xo" closed="false">39:21 </char><char style="xt" closed="false"><ref loc="ACT 7:9">Hawa 7:9</ref></char></note> <verse eid="GEN 39:21" /><verse number="22" style="v" sid="GEN 39:22" />Histtiin qasho keeththaa halaqay qasho asaa ubbaa Yooseefe kushen woththides; heen oosettizayssa ubbaa bolla aawatizay iza. <verse eid="GEN 39:22" /><verse number="23" style="v" sid="GEN 39:23" />GODAY Yooseefera gididi izi ooththiza ubbaa polisiza gishshas woyne keeththaa alaafey Yooseefe alaafeteththan diza ay miishshaska waanandeesha giidi hirgi erenna.<verse eid="GEN 39:23" /></para>
  <chapter eid="GEN 39" />
  <chapter number="40" style="c" sid="GEN 40" />
  <para style="s1">Yooseefey Birshida Agumo</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1" />Guuththa wodeppe guye Gibxe kawo ushshu duuqqizayta alaafeynne quma kaththizayta alaafey ba godaa Gibxe kawo qohida. <verse eid="GEN 40:1" /><verse number="2" style="v" sid="GEN 40:2" />Kawoy ushshu duuqqizayta halaqanne quma kaththizayta halaqata nam7ata bolla keehi hanqettides. <verse eid="GEN 40:2" /><verse number="3" style="v" sid="GEN 40:3" />Hessa gishshas zabeta halaqaza keeththan Yooseefey qashettida woyne keeththan yeggides. <verse eid="GEN 40:3" /><verse number="4" style="v" sid="GEN 40:4" />Zabeta halaqay istta Yooseefes sheedhdhiin izi isttas koshshiza miishshan maaddides; isttika qasho keeth gelidi guuth gam7ida mala,<verse eid="GEN 40:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 40:5" />Gibxe kawos ushshu duuqqizayta halaqaynne quma kaththizayta halaqay, nam7ayka qasho keeththan dishe issi qamma omars baas baas agumo agumettida. Nam7ata agumo birsheththika dumma dumma. <verse eid="GEN 40:5" /><verse number="6" style="v" sid="GEN 40:6" />Yooseefey maalado isttako gelida wode istti muuzotti uttidayta be7ides. <verse eid="GEN 40:6" /><verse number="7" style="v" sid="GEN 40:7" />Hessa gishshas ba godaa qasho keeththan banara diza kawo oosanchchata, «Hach intte ayfesoy aazas dhumidee?» gi oychchides.<verse eid="GEN 40:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 40:8" />Isttika izas, «Nuni nam7ay agumo agumettidos; gido attiin nuus birshiza asi dhaydes» gida.</para>
  <para style="p" vid="GEN 40:8">Yooseefeykka isttas, «Agumo birshizay Xoossa gidennee? Intte agumoza ane taas yootite» gides.<verse eid="GEN 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 40:9" />Histtiin ushshu duuqqizayta halaqay ba agumo Yooseefes, «Tani ta agumon issi woyne mith ta sinththan dizayssa be7adis. <verse eid="GEN 40:9" /><verse number="10" style="v" sid="GEN 40:10" />Qasse he woyne miththaas heedzdzu haggay dees. Heerakka aacada ciiyadus; lo7eththa wurcada ayfadus. <verse eid="GEN 40:10" /><verse number="11" style="v" sid="GEN 40:11" />He wode Paaroone ushshaa xuu7ay ta kushen dees; tanikka woyneza ayfe maxada xuu7aza giddon gum7ada ushshaa Paaroones immadis» gi yootides.<verse eid="GEN 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 40:12" />Histtiin Yooseefeykka zaaridi, «Hessa birsheththi hayssa; heedzdzu haggati heedzdzu gallassata. <verse eid="GEN 40:12" /><verse number="13" style="v" sid="GEN 40:13" />Heedzdzu gallassata giddon kawoy nena denththidi izi nena kase ne diza alaafeteththan woththana; kase neni ushshu duuqqiza wode ooththida mala neni kawo wancaa iza kushen woththana. <verse eid="GEN 40:13" /><verse number="14" style="v" sid="GEN 40:14" />Gido attiin nees wodey lo7ida wode tana baloppa; taaska kiya; ta gishshas kawos yootada ha qasho keeththaafe tana kesisa; <verse eid="GEN 40:14" /><verse number="15" style="v" sid="GEN 40:15" />gaasoykka tana Ibraaweta biittafe wolqqara shammi ehida; gido attiin hayssaththo tana qashos gaththiza miish aykkoka ooththabeekke» gides.<verse eid="GEN 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 40:16" />Kath kaththizayta halaqay Yooseefey ushshu duuqqizayta agumo lo7eththi birshidayssa be7idi Yooseefes, «Tanikka agumo agumettadis; hessika, ‹Ta hu7en heedzdzu masoobe tookka oykkadis. <verse eid="GEN 40:16" /><verse number="17" style="v" sid="GEN 40:17" />Bolla bagga masooben Gibxe kawos uukettida dumma dumma qumay dees. Gido attiin kafoti hessa ta hu7en diza masoobezappe mida› » gi yootides.<verse eid="GEN 40:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 40:18" />Histtiin Yooseefey, «Hessa birsheththay hayssa; heedzdzu masoobeti heedzdzu gallassata. <verse eid="GEN 40:18" /><verse number="19" style="v" sid="GEN 40:19" />Heedzdzu gallassata giddon kawoy nena denththidi ne qoodhe muucidi miththa bolla kaqisana; ne ashokka kafoti maana» gides.<verse eid="GEN 40:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 40:20" />Heedzdzanththo gallas Gibxe kawoy ba yelettida gallas ba kawoteththan diza shuumeta ubbaas gibira giigsides. Ushshu duuqqizayta halaqanne kath kaththizayta halaqaa qasho keeththaafe kessidi ba shuumeta sinththan essides. <verse eid="GEN 40:20" /><verse number="21" style="v" sid="GEN 40:21" />Ushshu duuqqizayta halaqaza kase iza shuumeteththan zaariin izi kawo kushen wanca woththides. <verse eid="GEN 40:21" /><verse number="22" style="v" sid="GEN 40:22" />Gido attiin kawozi kath kaththizayta halaqaa Yooseefey iza agumo birshida mala iza kaqisides. <verse eid="GEN 40:22" /><verse number="23" style="v" sid="GEN 40:23" />Ushshu duuqqizayta halaqay gidikko Yooseefe qoppontta dogi aggides.<verse eid="GEN 40:23" /></para>
  <chapter eid="GEN 40" />
  <chapter number="41" style="c" sid="GEN 41" />
  <para style="s1">Paaroone Agumoza Birsheth</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1" />Nam7u layth kumeth aadhdhida wode Gibxe kawoy agumo agumettides; agumora izi Abbaye shaafaa doonan eqqi dishin, <verse eid="GEN 41:1" /><verse number="2" style="v" sid="GEN 41:2" />laappun ordenne modhdho miizati Abbaye shaafappe kezidi shaafaa achchan maata mishin be7ides. <verse eid="GEN 41:2" /><verse number="3" style="v" sid="GEN 41:3" />Isttafe kaallidi hara laappun mala iitanne gilqa miizati Abbaye shaafappe kezidi shaafaza doonan diza modhdho miizata achchan eqqida. <verse eid="GEN 41:3" /><verse number="4" style="v" sid="GEN 41:4" />He medho iitanne gilqa miizati laappun ordenne modhdho miizata mittishin be7ides. Hessafe guye kawoy dhiskofe beeggides.<verse eid="GEN 41:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 41:5" />Izi qasseka dhiskidi nam7anththo agumettidi laappun lo7onne muuruta tiyati issi maqa bolla diccidayssa be7ides. <verse eid="GEN 41:5" /><verse number="6" style="v" sid="GEN 41:6" />Isttafe kaallidi ayfe laafanne carkon shullidi melida laappun tiyati kezida. <verse eid="GEN 41:6" /><verse number="7" style="v" sid="GEN 41:7" />He laafa ayfe tiyati lo7onne muuruta tiyata mittida. Hessafe guye kawozi beeggidi agumo gididayssa erides. <verse eid="GEN 41:7" /><verse number="8" style="v" sid="GEN 41:8" />Gadey wontishin iza wozinay shirotdes; hessa gishshas Gibxen diza bitanchchatassinne era asata ubbaas kiittidi xeygisides; kawoy isttas ba agumoza yootides; gido attiin izas he agumoza birshanaas dandayza asi beettibeenna.<note caller="-" style="x"><char style="xo" closed="false">41:8 </char><char style="xt" closed="false"><ref loc="DAN 2:2">Daane 2:2</ref></char></note><verse eid="GEN 41:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 41:9" />He wode ushshu duuqqizayta halaqay Gibxe kawos, «Tani ta mooro hach qoppays. <verse eid="GEN 41:9" /><verse number="10" style="v" sid="GEN 41:10" />Issito kawoy ba aylles hanqettidi tananne kath kaththizayta halaqaza qasho keeththan yeggides. <verse eid="GEN 41:10" /><verse number="11" style="v" sid="GEN 41:11" />Nuni heen dishe nuus nuus agumo agumettidos; agumozaska dumma dumma birsheththi dees. <verse eid="GEN 41:11" /><verse number="12" style="v" sid="GEN 41:12" />He wode zabeta halaqaza aylle gidida issi Ibraawe panththi nunara qasho keeththan dees. Nuni nu agumo izas yootiin izi nuus hu7en hu7en nu agumo birshides. <verse eid="GEN 41:12" /><verse number="13" style="v" sid="GEN 41:13" />Histtiin he yo7oti izi nuus birshida mala hanida. Hessi aazee giikko tani kase ta alaafeteththan simmadis; hankkoyssi gidikko kaqettides» gides.<verse eid="GEN 41:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 41:14" />Histtiin Gibxe kawoy Yooseefe kiittidi xeygisides. Istti iza qasho keeththafe eeson ekki yiin ba hu7e meedettidi may7o laammidi kawozaakko gelides. <verse eid="GEN 41:14" /><verse number="15" style="v" sid="GEN 41:15" />Kawoy Yooseefe, «Ta agumettida agumoza birshanaas oonikka dandaybeenna. Gido attiin tani, ‹Yooseefey agumo siyikko birshanaas dandayees› gizaaz siyadis» gides.<verse eid="GEN 41:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 41:16" />Histtiin Yooseefey, «Tani hessa dandaykke; gido attiin Xoossay kawos lo7o birsheth immana» gides.<verse eid="GEN 41:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 41:17" />Kawoykka, «Tani ta agumon Abbaye haaththa shaafaa doonan eqqidishin, <verse eid="GEN 41:17" /><verse number="18" style="v" sid="GEN 41:18" />Laappun gitanne modhdho miizati Abbaye shaafappe kezidi haaththaa doonan maata mishin. <verse eid="GEN 41:18" /><verse number="19" style="v" sid="GEN 41:19" />Qasseka isttafe hara laappun medha iita, gilqanne laafa miizati shaafappe kezida; tani hessa mala medha iita miiz Gibxe biittan mulekka be7a erikke. <verse eid="GEN 41:19" /><verse number="20" style="v" sid="GEN 41:20" />Medha iitanne laafa miizati koyroyta laappun modhdho miizata mitti aggida. <verse eid="GEN 41:20" /><verse number="21" style="v" sid="GEN 41:21" />Gido attiin istti mittidaappe guyekka istta medhay kase malakka iiti uttida gishshas istti mittidayssa asi eranaas dandaybeenna. Hessafe guye tani dhiskofe beeggadis.<verse eid="GEN 41:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 41:22" />«Qasseka agumora laappun lo7onne muuruta tiyati issi maqa bolla diccidayta be7adis. <verse eid="GEN 41:22" /><verse number="23" style="v" sid="GEN 41:23" />Qasseka isttafe hara ayfe laafanne carkon shullida laappun tiyati kezida. <verse eid="GEN 41:23" /><verse number="24" style="v" sid="GEN 41:24" />He shulli uttida tiyati laappun lo7o tiyata mittida. Tani ha agumoza marotas yootadis; gido attiin taas agumoza birshiza asi beettibeenna» gides.<verse eid="GEN 41:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 41:25" />Hessafe guye Yooseefey Gibxe kawoza, «Nam7ayka ne be7ida agumota birsheththayka issino. Xoossi ba ooththana hanizayssa kawos qonccisides. <verse eid="GEN 41:25" /><verse number="26" style="v" sid="GEN 41:26" />He laappun lo7o miizati laappun layththata; qasse laappun lo7o tiyati laappun layththata; nam7ayka issi mala. <verse eid="GEN 41:26" /><verse number="27" style="v" sid="GEN 41:27" />He laappun medha iitanne laafa miizati laappun layththata; qasse carkon shullida paththontta laappun tiyati laappun kosha layththata.<verse eid="GEN 41:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 41:28" />«Tani kawos yootida malakka Xoossi ba ooththana hanizayssa kawos bessides. <verse eid="GEN 41:28" /><verse number="29" style="v" sid="GEN 41:29" />Laappun daro kalo layththati Gibxe biittas ubbaas yaana; <verse eid="GEN 41:29" /><verse number="30" style="v" sid="GEN 41:30" />Gido attiin laappun kosha layththati izappe kaallidi yaana. He wode Gibxe kaloy wuri dogettana; biittay koshan shocettana. <verse eid="GEN 41:30" /><verse number="31" style="v" sid="GEN 41:31" />Kalo layththatappe guye yiza gafa layththati keehi iita gidida gishshas kase kaloy mulekka qofettontta attana. <verse eid="GEN 41:31" /><verse number="32" style="v" sid="GEN 41:32" />Nam7uto kawos he agumoy beettiday aazassee giikko hayssa yo7oza Xoossi minththidi kuuyida gishshassa; Xoossi hessa eeson ooththana.<verse eid="GEN 41:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 41:33" />«Ha7i hekko eeson kawoy aadho erateththinne akeekay diza as koyidi Gibxe biittan sunththo. <verse eid="GEN 41:33" /><verse number="34" style="v" sid="GEN 41:34" />Hessaththoka laappun kalo layththatappe ichchashanththo kushe shiishshiza alaafeta kawoy shuumo. <verse eid="GEN 41:34" /><verse number="35" style="v" sid="GEN 41:35" />Istti yiza kalo layththatan kath shiishshidi kawo aawateththan minjjetto; he kaththaaka katamatan naagetto. <verse eid="GEN 41:35" /><verse number="36" style="v" sid="GEN 41:36" />Biittay koshan qohettontta mala ha kaththay Gibxe biittan laappun layththan dendana koshaas minjjettidi de7o» gides.<verse eid="GEN 41:36" /></para>
  <para style="s1">Yooseefe Shuumeteth</para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37" />Histtiin ha yo7ozi Gibxe kawossinne iza oosanchchatas lo7o gididi beettides. <verse eid="GEN 41:37" /><verse number="38" style="v" sid="GEN 41:38" />Hessa gishshas kawoy isttas, «Nuni Xoossa Ayanara diza hayssa mala hara as oona demmanee?» gi oychchides.<verse eid="GEN 41:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 41:39" />Hessafe guye kawoy Yooseefe, «Xoossi hayssa ubbaa nena erisida gishshas ne mala aadho erateththinne akeekay diza asi oonikka baawa. <verse eid="GEN 41:39" /><verse number="40" style="v" sid="GEN 41:40" />Tani nena ta keeththan shuumays; ta asay wuri nees azazettana; tani neeppe aadhdhanay ta kawoteththa algan xalla gidana» gides.<note caller="-" style="x"><char style="xo" closed="false">41:40 </char><char style="xt" closed="false"><ref loc="ACT 7:10">Hawa 7:10</ref></char></note><verse eid="GEN 41:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 41:41" />Hessa gishshas kawoy Yooseefe, «Beya! Tani nena Gibxe biitta ubbaa bollan shuumadis» gides. <verse eid="GEN 41:41" /><verse number="42" style="v" sid="GEN 41:42" />Hessafe guye kawoy ba kawoteththa qalabate ba biradhdhefe kessidi Yooseefe biradhdhen aaththides; qasseka Laynoppe dadettida may7o mayzidi iza qoodhenkka worqqa loota<note caller="+" style="f"><char style="fr" closed="false">41:42 </char><char style="fqa" closed="false">Loota: </char><char style="ft" closed="false">Lootay qoodhen aaththiza alleqo miish.</char></note> aaththides.<note caller="-" style="x"><char style="xo" closed="false">41:42 </char><char style="xt" closed="false"><ref loc="DAN 5:29">Daane 5:29</ref></char></note> <verse eid="GEN 41:42" /><verse number="43" style="v" sid="GEN 41:43" />Kawoy ba nam7anththo para-gaareza Yooseefe togisides; aylletikka, «Ziggite! Ziggite!» giidi izappe sinththara bida. Hessaththo ooththidi kawoy iza Gibxe biitta ubbaa bolla shuumides.<verse eid="GEN 41:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="GEN 41:44" />Hessafe guye kawoy Yooseefe, «Tani kawo! Gido attiin neni qaaxxa gontta Gibxe biitta ubbaan oonikka kushe woykko toho qaaththenna» gides. <verse eid="GEN 41:44" /><verse number="45" style="v" sid="GEN 41:45" />Kawoy Yooseefe, «Xaafinaate-Pa7inaahe» gi sunththides; izi izas Oona geetettiza katama qeese Phixifaara nayo Asinaato machcho immides. Histtiin Yooseefey kumeththa Gibxe biittaa yuuyi xeellides.<verse eid="GEN 41:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 41:46" />Yooseefey Gibxe kawos ooththanaas doommiza wode izas layththay heedzdzu tamma. Qasse Yooseefey kawo sinththafe kezidi Gibxe biitta ubbaa yuuyi xeellides. <verse eid="GEN 41:46" /><verse number="47" style="v" sid="GEN 41:47" />He laappun kalo layththatan biittay keehi daro kath immides. <verse eid="GEN 41:47" /><verse number="48" style="v" sid="GEN 41:48" />Yooseefey Gibxe biittan he laappun kalo layththaa kath ubbaa shiishshidi katamatan minjjides. Issi issi katamata yuushon kaxxida kath ubbaa he kataman kataman minjjides. <verse eid="GEN 41:48" /><verse number="49" style="v" sid="GEN 41:49" />Yooseefey abba shaamintta<note caller="+" style="f"><char style="fr" closed="false">41:49 </char><char style="fqa" closed="false">Abba shaamintta: </char><char style="ft" closed="false">Abba shaamintta issi issi bagga gamoththo qaalan abba shayta woykko abba ace geetetti xeygettees.</char></note> mala daro kath minjjides; kaththay wogappe dariin makkanaas dandaybeenna gishshas makki makki qolizayssa aggaagides.<verse eid="GEN 41:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 41:50" />Laappun kosha layththay yaanaappe kase Oona geetettiza katamaa qeese Phixifaara nayo Asinaatippe Yooseefey nam7u attuma nayta yelides. <verse eid="GEN 41:50" /><verse number="51" style="v" sid="GEN 41:51" />Yooseefey, «Xoossi tana ta metonne ta aawa soo asa ubbaa dogissides» gishe ba koyro naaza Minaase gi sunththides. <verse eid="GEN 41:51" /><verse number="52" style="v" sid="GEN 41:52" />Nam7anththo naazakka, «Xoossi taas ta tuggatida biittan tana ayfissides» gishe Efreeme gi sunththides.<verse eid="GEN 41:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="GEN 41:53" />Gibxe biittan diza he laappun kalo layththati wurida. <verse eid="GEN 41:53" /><verse number="54" style="v" sid="GEN 41:54" />Qasse Yooseefey kaseti yootida mala laappun kosha layththati doommida. Hara biitta ubbaan koshay dendides; gido attiin Gibxe biitta ubbaan kaththi dees.<note caller="-" style="x"><char style="xo" closed="false">41:54 </char><char style="xt" closed="false"><ref loc="ACT 7:11">Hawa 7:11</ref></char></note> <verse eid="GEN 41:54" /><verse number="55" style="v" sid="GEN 41:55" />Gibxe derey wuri koshattida wode asay, «Kath imma» gi kawos waassiin kawozi Gibxe asaa ubbaa, «Yooseefekko biidi izi yootizayssa ooththite» gides.<note caller="-" style="x"><char style="xo" closed="false">41:55 </char><char style="xt" closed="false"><ref loc="JHN 2:5">Yoha 2:5</ref></char></note><verse eid="GEN 41:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 41:56" />Koshay Gibxe biittaa ubbaa gakkida wode Yooseefey kath minjjida keeththata ubbaa doydi kath Gibxe asaas bayzisides; gaasoykka koshay kumeththa Gibxen minnides. <verse eid="GEN 41:56" /><verse number="57" style="v" sid="GEN 41:57" />Sa7a ubbaan koshay suullida gishshas biittan diza asay wuri kath Yooseefeppe shammanaas Gibxe yides.<verse eid="GEN 41:57" /></para>
  <chapter eid="GEN 41" />
  <chapter number="42" style="c" sid="GEN 42" />
  <para style="s1">Gibxe Yaaqoobe Buus</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1" />Yaaqoobey Gibxen kaththi dizayssa siyidi ba attuma nayta, «Intte issoy issaara aazas xeeletteetii? <verse eid="GEN 42:1" /><verse number="2" style="v" sid="GEN 42:2" />Be7ite! Gibxen kaththi dizayssa tani siyadis; duge Gibxe biidi nu hayqqontta paxa daana mala heeppe kath nuus shammi ehite» gides.<note caller="-" style="x"><char style="xo" closed="false">42:2 </char><char style="xt" closed="false"><ref loc="ACT 7:12">Hawa 7:12</ref></char></note> <verse eid="GEN 42:2" /><verse number="3" style="v" sid="GEN 42:3" />Hessa gishshas Yooseefe ishati tammati kath shammanaas duge Gibxe bida. <verse eid="GEN 42:3" /><verse number="4" style="v" sid="GEN 42:4" />Gido attiin Yaaqoobey Yooseefe ishaa Biniyaame izi qohettanaakko giidi qoppida gishshas iza ishatara yeddibeenna. <verse eid="GEN 42:4" /><verse number="5" style="v" sid="GEN 42:5" />Kanaane biittan wolqqama koshay diza gishshas kath shammana bizaytara Isra7eele attuma nayti Gibxe bida.<verse eid="GEN 42:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 42:6" />He wode Yooseefey he biittaa ayssizaadenne biittan diza asaa ubbaas kath bayzisizay iza gidida gishshas Yooseefe ishati gakkida mala, ba hu7e biittan gaththidi izas ziggida. <verse eid="GEN 42:6" /><verse number="7" style="v" sid="GEN 42:7" />Yooseefey ba ishata be7ida mala erides shin izi istta erontta asa mala hanqo qaalan istta, «Intte awappe yidetii?» gi oychchides.</para>
  <para style="p" vid="GEN 42:7">Isttika, «Kath shammanaas, Kanaane biittafe yidos» gida.<verse eid="GEN 42:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 42:8" />Yooseefey ba ishata erides; istti gidikko iza eribeettenna. <verse eid="GEN 42:8" /><verse number="9" style="v" sid="GEN 42:9" />Heerakka Yooseefey istta gishshas agumettida agumoza qoppidi isttas, «Intte dere xomosiza asa; intte nu biittan naagey leppiza baggay awayssako xeellanaas yideta» gides.<note caller="-" style="x"><char style="xo" closed="false">42:9 </char><char style="xt" closed="false"><ref loc="GEN 37:5-10">Medhe 37:5-10</ref></char></note><verse eid="GEN 42:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 42:10" />Histtiin istti, «Nu godoo! Nuni dere xomosiza as gidokko; nuni ne aylleti kath shammanaas yidos. <verse eid="GEN 42:10" /><verse number="11" style="v" sid="GEN 42:11" />Nu wurikka issi aawa nayta. Nuni ne aylleti ammanettiza asa» gida.<verse eid="GEN 42:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 42:12" />Histtiin Yooseefey isttas, «Gidekketa! Intte nu biittan naagoy leppiza baggay awayssako xomosi xeellana yideta» gides.<verse eid="GEN 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 42:13" />Gido attiin istti, «Nuni ne aylleti tammanne nam7u ishatanne Kanaane biittan diza issi aawa nayta. Wurseththa kaaloy ha7i nu aawara dees; issoy gidikko dhaydes» gida.<verse eid="GEN 42:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 42:14" />Yooseefey isttas, «Tani inttes yootida malakka intte biitta xomosizayta. <verse eid="GEN 42:14" /><verse number="15" style="v" sid="GEN 42:15" />Qasse intte paacettanay hayssana; tumuppe kawoy beyiin! Intte wurseththa kaalo ishay haa yontta ixxiko intte hayssafe beekketa. <verse eid="GEN 42:15" /><verse number="16" style="v" sid="GEN 42:16" />Intte yootizayssi tumukkonne paaccanaas, inttefe issaade kiittite; izi intte ishaa ekki yo; attidayti qasho keeththan gam7eeta. Hessa mala gidontta aggiko kawoy beyiin! intte yuuyi yuuyi dere xomosiza asa» <verse eid="GEN 42:16" /><verse number="17" style="v" sid="GEN 42:17" />giidi istta heedzdzu gallassas qasho keeththan yeggides.<verse eid="GEN 42:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 42:18" />Heedzdzanththo gallassan Yooseefey isttas, «Tani Xoossas babbiza asa; intte issi miish ooththiko intte shemppo ashsheeta. <verse eid="GEN 42:18" /><verse number="19" style="v" sid="GEN 42:19" />Intte tumukka ammanettiza as gidikko intte ishatappe issoy hayssan qasho keeththan do; attidayti gafida intteso asaas kath ekki biite; <verse eid="GEN 42:19" /><verse number="20" style="v" sid="GEN 42:20" />Gido attiin intte qaalay tumu gidana malanne intte hayqqontta mala intte intte wurseththa kaalo ishaa taakko ekki yaanaas koshshees» gides. Isttika ha yo7ozan ero gida.<verse eid="GEN 42:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 42:21" />Istti issoy issaa, «Tumu nu ooththida geney nuna gakkides. Izi ba shemppos hanizaazi ixxiin nuna shoobbiza wode nuni siyishe ixxidos; ha waayey nuna gakkiday hessa gishshassa» gida.<verse eid="GEN 42:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 42:22" />Oroobeeley, «Tani inttena, ‹Naaza bolla nagara ooththofte› gaada yootadis; gido attiin intte siyontta ixxideta. Histtiin ha7i iza suuththaa gomey nuna mootees» gides.<note caller="-" style="x"><char style="xo" closed="false">42:22 </char><char style="xt" closed="false"><ref loc="GEN 37:21-22">Medhe 37:21-22</ref></char></note> <verse eid="GEN 42:22" /><verse number="23" style="v" sid="GEN 42:23" />Istti gizayssa Yooseefey erizayssa istti akeekibeettenna; ays giikko izi isttara wokkalen haasayees. <verse eid="GEN 42:23" /><verse number="24" style="v" sid="GEN 42:24" />Izi isttafe shaaketti guye simmidi yeekkides; gido attiin qasse isttako simmidi istta haasayssides. Izi Simoona isttafe duuththi ashshidi istti be7ishin iza qachchides.<verse eid="GEN 42:24" /></para>
  <para style="s1">Kanaane Yooseefe Ishata Simo</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 42:25" />Yooseefey ba aylleta, «Kath istta ogoro kunththite; istta biraakka zaaridi istta ogoron ogoron yeggite; qasse isttas oge shinqe immite» gi azazides. <verse eid="GEN 42:25" /><verse number="26" style="v" sid="GEN 42:26" />Istti izi gida mala ooththidaappe guye Yooseefe ishati kaththaa ba haretan caanidi dendi bida.<verse eid="GEN 42:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 42:27" />Istti oge bolla qamma aqanaas shempidason isttafe issay ba harezas kaththaafe yegganaas ba ogoro birshidi, ogoroza doonan diza ba biraa demmides. <verse eid="GEN 42:27" /><verse number="28" style="v" sid="GEN 42:28" />Izi ba ishata, «Ta biray taas simmides; tuma hayssa be7ite! Ta ogoron dees» gides.</para>
  <para style="p" vid="GEN 42:28">Istti dagammidi kokkorishe issoy issaakko simmidi, «Xoossi aazas nu bolla hayssa ooththidee?» gida.<verse eid="GEN 42:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 42:29" />Istti Kanaane biittan diza ba aawa Yaaqoobekko soo simmi yiidi ba bolla gakkidayssa ubbaa izas yootida. <verse eid="GEN 42:29" /><verse number="30" style="v" sid="GEN 42:30" />Istti izas, «He biittays godaa gidida addezi nuna babisides; hessafe guye izi nuna he biittaa yuuyi yuuyi xomosi xeelliza asa mala ooththi godatides. <verse eid="GEN 42:30" /><verse number="31" style="v" sid="GEN 42:31" />Gido attiin nuni izas, ‹Nu ammanettiza asa; dere xomosi xeelliza as gidokko. <verse eid="GEN 42:31" /><verse number="32" style="v" sid="GEN 42:32" />Nuni tammanne nam7u ishati issi aawa nayta; issoy dhaydes; wurseththa kaaloy Kanaane biittan ha7i nu aawara dees› gi yootidos. <verse eid="GEN 42:32" /><verse number="33" style="v" sid="GEN 42:33" />Histtiin he biittays godaa gidida addezi nuna, ‹Intte ammanettiza as gididayssa tani hayssan erana; intte ishatappe issaa haan ta achchan yeggidi gafida intte soo asaas kath ekki biite. <verse eid="GEN 42:33" /><verse number="34" style="v" sid="GEN 42:34" />Intte dere yuuyi yuuyi xomosizaade gidontta, ammanettiza as gididayssa tani erana mala, intte wurseththa kaalo ishaa taakko ekki yiite. Histtiko tani haan attida intte ishaa inttes zaara immana; intteka ha biittan zal7ana dandayeeta› gides» gida.<verse eid="GEN 42:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 42:35" />Istti ba ogoroppe ogoroppe kaththaa qolidi ba ogoron ogoron biray qashora uttidayssa demmida. Isttinne istta aaway he qashora diza biraa be7idi babbida. <verse eid="GEN 42:35" /><verse number="36" style="v" sid="GEN 42:36" />Istta aawa Yaaqoobey isttas, «Intte tana ta naytappe mela kessideta; Yooseefey baawa, Simooni baawa; qasse intte Biniyaame efana koyeeta. Wuri taas dhuma girdi gides» gides.<verse eid="GEN 42:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 42:37" />Hessafe guye Oroobeeley ba aawaa, «Tani Biniyaame nees zaara ehontta aggiko ta attuma nayta nam7atakka wodha; tana ammanettada iza ta kushen imma; qasse tani iza zaarada ehana» gides.<verse eid="GEN 42:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 42:38" />Gido attiin Yaaqoobey isttas, «Ta naazi inttenara duge beenna; iza ishay hayqqiin attiday iza xalla; intte efishin ogen iita miishshi iza gakkizaa gidikko intte tana yeehoranne muuzora duufon efana» gides.<verse eid="GEN 42:38" /></para>
  <chapter eid="GEN 42" />
  <chapter number="43" style="c" sid="GEN 43" />
  <para style="s1">Yooseefe Ishati Biniyaame Ekkidi Gibxe Buus</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1" />Ha7ikka koshay Kanaane biittan minnides. <verse eid="GEN 43:1" /><verse number="2" style="v" sid="GEN 43:2" />Histtiin istti Gibxeppe ehida kaththay mulera wuriin istta aaway, «Qasseka guye biidi nuus guuththa kath shammite» gides.<verse eid="GEN 43:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 43:3" />Gido attiin Yuhuday izas, «He addezi nuna, ‹Intte isha inttenara ekki yontta aggiko ta ayfeso nam7anththo be7ekketa› giidi lo7eththi yootides. <verse eid="GEN 43:3" /><verse number="4" style="v" sid="GEN 43:4" />Neni nu ishaa nunara yeddiko nuni duge biidi nees kath shammana. <verse eid="GEN 43:4" /><verse number="5" style="v" sid="GEN 43:5" />Gido attiin neni iza yeddontta ixxiko nuni duge bookko; ays giikko he addezi nuna, ‹Intte isha inttenara ehontta aggiko intte ta ayfeso nam7anththo be7ekketa› gides» gides.<verse eid="GEN 43:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 43:6" />Isra7eeleykka, «Intte, ‹Nuus hara ishay dees› gi yootidi hayssa ha metoza ta bolla ays ehidetii?» gides.<verse eid="GEN 43:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 43:7" />Isttika izas, «He addezi nu gishshassinne nuso asaa gishshas lo7eththi oychchides. Izi nuna, ‹Intte aaway ha7ikka paxa dizee? Inttes hara ishay dizee?› gi oychchiin nuni izi oychchida oyshozas zaaro immidos. Izikka nuna, ‹Intte ishaa duge haa ekki yiite› gaanayssa nuni aazan erinoo?» gida.<verse eid="GEN 43:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 43:8" />Yuhuday ba aawa Isra7eele, «Nunikka, nenikka, nu naytikka hayqqontta paxa daana mala naaza tanara yedda; nuni ha7i elelidi baana. <verse eid="GEN 43:8" /><verse number="9" style="v" sid="GEN 43:9" />Naaza nuus ta waaseteththan imma; iza gishshas tana oychcha; tani iza nees lo7ora zaara ehontta aggiko ta diza wode ubbaan ta oyshettana. <verse eid="GEN 43:9" /><verse number="10" style="v" sid="GEN 43:10" />Nuni haan gam7onttaako hanni wode nam7anththo gede gakkidi ha simmana shin» gides.<verse eid="GEN 43:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 43:11" />Hessafe guye istta aawa Isra7eeley isttas, «Hessa gidikko histtite; he addezas kushe genththo miish nu biittan mokkiza miish ubbaafe lo7izayssa doorite; hessika shitto, ees, sawo, karbbe, miththa ayfeta intte ogoron yeggi ekki biite. <verse eid="GEN 43:11" /><verse number="12" style="v" sid="GEN 43:12" />Intte ogoro doonan simmida birazi baletan simmidaaz gidana dandayza gishshas biraakka nam7u kushe histti ekki biite. <verse eid="GEN 43:12" /><verse number="13" style="v" sid="GEN 43:13" />Qasse intte ishaakka ekkidi he addezakko eeson guye biite. <verse eid="GEN 43:13" /><verse number="14" style="v" sid="GEN 43:14" />Izi hankko intte ishaa yeddana mala Biniyaameykka inttenara simmi yaana mala Ubbaa Dandayza Xoossay he addezi inttes qadhettana mala ooththo; tani gidikko ta naytappe mela attikonne attays» gides.<verse eid="GEN 43:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 43:15" />Hessa gishshas he asati kushe genththo kase biraas nam7u kushe qasse Biniyaame ekkidi duge Gibxe biidi Yooseefe sinth shiiqida. <verse eid="GEN 43:15" /><verse number="16" style="v" sid="GEN 43:16" />Yooseefey ba ishatara Biniyaame be7idi ba keeththa halaqaza, «Ha asata taso ekkada ba; hachcha gallas istti tanara quma maana mala mehe shukkada giigsa» gi azazides.<verse eid="GEN 43:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 43:17" />Histtiin izi Yooseefey izas yootida mala he asata Yooseefeso efides. <verse eid="GEN 43:17" /><verse number="18" style="v" sid="GEN 43:18" />Asati Yooseefe soo bida gishshas babbida; isttas, «Istti nuna hayssa ehiday koyro nu ogorora simmi bida biraa gishshas gidontta aggenna; izi nuna qohanaas aylleteththan haaranaassinne nu hareta ekkanaas hanees» gi qoppida.<verse eid="GEN 43:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 43:19" />Hessa gishshas istti Yooseefe keeththaa penge gakkidi keeththaa halaqaza, <verse eid="GEN 43:19" /><verse number="20" style="v" sid="GEN 43:20" />«Nu godoo! Nuni koyro kath shammanaas haa yidos; <verse eid="GEN 43:20" /><verse number="21" style="v" sid="GEN 43:21" />simmidi bishe nu aqizaason omars nu ogoro ogoro nu birshiin nu biray paccontta nu ogoro ogoro doonan dizayssa demmidos; hessa gishshas ha7i nuni iza guye ekki yidos. <verse eid="GEN 43:21" /><verse number="22" style="v" sid="GEN 43:22" />Qasse nuni kath shammanaas hara biraakka ekki yidos. Nu biraa nu ogoro ogoro doonan ooni woththidaakko nu erokko» gi haasayssida.<verse eid="GEN 43:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 43:23" />Histtiin izi isttas, «Aykkoy baa hessas babofte! Intte Xoossi intte aawa Xoossi intte ogoro giddon inttes bira immides; tani intte biraa ekkadis» gides. Hessafe guye Simoona isttako kessides.<verse eid="GEN 43:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 43:24" />He addezi he asata Yooseefe soo efidi istta tohos haath ehiin ba toho meecettida. Istta haretaska harqqo immides. <verse eid="GEN 43:24" /><verse number="25" style="v" sid="GEN 43:25" />Yooseefera quma maana mala isttas yootettida gishshas Yooseefey yaana gakkanaas izas immana kushe genththo giigsida.<verse eid="GEN 43:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 43:26" />Yooseefey baso gelida mala istti ba giigsida kushe genththoza izas immidi iza sinththan ba hu7e duge biittan gaththi ziggida. <verse eid="GEN 43:26" /><verse number="27" style="v" sid="GEN 43:27" />Izi istta saroteth oychchi simmidi, «Intte taas yootida intte cima aaway lo7i dizee? Ha7ikka izi paxa dizee?» gides.<verse eid="GEN 43:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 43:28" />Histtiin istti, «Ee, ne aylley nu aaway ha7ikka paxa dees; izi lo7okko» gi hokki izas ziggida.<verse eid="GEN 43:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 43:29" />Izi ba aayey naa Biniyaame be7idi isttas, «Intte yootida intte wurseththa kaalo ishay hayssee?» gides. Qasse izi Biniyaame, «Ta naazoo Xoossi nena anjjo» gides. <verse eid="GEN 43:29" /><verse number="30" style="v" sid="GEN 43:30" />Yooseefey ba ishaa be7iin izas yeehoy dandayettontta ixxiin yeekkanaas issife issiso pooqqides. Izi ba dumma qol7a gelidi heen yeekkides.<verse eid="GEN 43:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 43:31" />Izi ba ayfeso meecetti simmi kezidi barkka bana minththeththidi, «Quma haa aaththite!» gides.<verse eid="GEN 43:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 43:32" />Histtiin istti izas dumma, iza ishatas dumma, heen izara miza Gibxe asatas dumma aaththida; ays giikko Gibxe asay Ibraawe asaara issife mi erettenna. Hessika Gibxe biitta asaas tunateththa. <verse eid="GEN 43:32" /><verse number="33" style="v" sid="GEN 43:33" />Istti Yooseefe sinththan bayray ba bayrateththaa mala kaaloy ba kaaloteththa mala maaran uttida. Istti issoy issaa xeellidi istta wostti utissidaakko be7idi malalettida. <verse eid="GEN 43:33" /><verse number="34" style="v" sid="GEN 43:34" />Yooseefey ba gishaappe isttas qumaa gishiza wode, Biniyaame gakkidayssi haratayssafe ichchashu kushe darees; histtiin istti ufayettishe izara midanne uyida.<verse eid="GEN 43:34" /></para>
  <chapter eid="GEN 43" />
  <chapter number="44" style="c" sid="GEN 44" />
  <para style="s1">Birappe Oosettida Yooseefe Wanca</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1" />Yooseefey ba keeththaa halaqazas, «Neni ha asata ogoroy ekkiza keena kath isttas kunththa; istta bira ubbaa istta ogoro ogoro doonan woththa; <verse eid="GEN 44:1" /><verse number="2" style="v" sid="GEN 44:2" />Histtada wurseththa kaaloza ogoro doonan ta bira wancanne iza kaththa biraa woththa» gi azaziin izi Yooseefey gida mala ooththides.<verse eid="GEN 44:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 44:3" />Gadey wontishin he asati ba hareta ekkidi baana mala moyzida. <verse eid="GEN 44:3" /><verse number="4" style="v" sid="GEN 44:4" />Istti he katamappe kezidi haakki biichchontta dishin Yooseefey ba keeththaa halaqaas, «Denda! Ha asata guye kaalla; neni ba istta gakkada, ‹Intte ays kiya gishshas iita zaaridetii?› <verse eid="GEN 44:4" /><verse number="5" style="v" sid="GEN 44:5" />‹Ays ta godaa bira wanca kaysidetii? Hayssi ta goday uyizayssanne qasse xuura miish demmiza wanca gidennee? Hayssi intte ooththidayssi gita qoho› ga» gides. He wode Gibxe biitta asati wanca garsan diza ushshaa be7idi sinththafe aazi hananaakko ereettes.<verse eid="GEN 44:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 44:6" />Histtiin izi istta guyera gakkidi izi gida malakka isttas yootides. <verse eid="GEN 44:6" /><verse number="7" style="v" sid="GEN 44:7" />Gido attiin istti, «Nu goday aazas hayssa mala qaala nu bolla haasayzee? Hessa mala miish oosoy nuuppe ne aylletappe haakko! <verse eid="GEN 44:7" /><verse number="8" style="v" sid="GEN 44:8" />Haray attoshin hayssafe kase nu ogoro doonappe demmida biraa Kanaane biittafe guye nees nu zaari ehidayssa ne eraasa. Histtiin ha7i nuni ne godaa sooppe wosttidi bira woykko worqqa kaysizonii? <verse eid="GEN 44:8" /><verse number="9" style="v" sid="GEN 44:9" />Ne aylleta nu giddofe he wancay izakkon beettidaadey hayqqo; qasse attida nuni nu godaas aylle gidana» gida. <verse eid="GEN 44:9" /><verse number="10" style="v" sid="GEN 44:10" />Izi isttas, «Hessa mala gidikko lo7o; intte gida mala gido; wancaza ekkida uray oonikka ta aylle gidana; hankko attida intte gidikko sarora baana» gides.<verse eid="GEN 44:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 44:11" />Hessafe guye istti eeson ba ogoro ogoro woththi birshida. <verse eid="GEN 44:11" /><verse number="12" style="v" sid="GEN 44:12" />Halaqazikka ubbaafe bayratizayssa ogoroppe doommidi wurseththa kaalozayssa gakkanaas koyides; he wancazakka Biniyaame ogoro giddofe demmides. <verse eid="GEN 44:12" /><verse number="13" style="v" sid="GEN 44:13" />Histtiin istti muuzottidi ba may7o daakkida; ba ogoro ogoro ba haretan caanidi guye katamaa simmida.<verse eid="GEN 44:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 44:14" />Yuhuday ba ishatara Yooseefekko geliza wode Yooseefey soon dizayssa demmidi istti iza sinththan gufannida. <verse eid="GEN 44:14" /><verse number="15" style="v" sid="GEN 44:15" />Yooseefey isttas, «Intte ay pala miish ooththidetii? Ta mala asi xuura miishshi hessaththo demmizayssa erekketiyee?» gides.<verse eid="GEN 44:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 44:16" />Histtiin Yuhuday, «Nu godaas nu ay gaanee? Nuni ay haasayanee? Woykko nuni xilloteth wostti bessanee? Xoossi ne aylleta mooro qonccisides. Histtiin nunakka gidiin he wancay izappe beettidayssika gidiin ta godaas aylle gidana» gides.<verse eid="GEN 44:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 44:17" />Gido attiin Yooseefey, «Hessa mala miish oosoy taappe haakko; ta bira wancazi izappe beettida addezi xalla ta aylle gidana. Histtiko intte intte aawaakko guye saron simmite» gides.<verse eid="GEN 44:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18" />Histtiin Yuhuday izakko shiiqidi iza, «Ta godoo! Tani issi qaala haasayana mala nena woossays; ne kawo Paaroone mala gidikkoka tana ne aylleza bolla hanqettofa. <verse eid="GEN 44:18" /><verse number="19" style="v" sid="GEN 44:19" />Neni ta goday nuna ne aylleta, ‹Inttes aaway dizee woykko ishay dizee?› ga oychchadasa. <verse eid="GEN 44:19" /><verse number="20" style="v" sid="GEN 44:20" />Nunikka, ‹Nuus cimmida aaway dees; izi cimmidi yelida kaalo naykka dees; he naaza ishay hayqqides; ba aayeeys issi iza xallay attides; aawaykka iza keehi siiqees› gi nees yootidos.<verse eid="GEN 44:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 44:21" />«Nekka ne aylletas nuus, ‹Tani iza beyana mala taas ekki yiite› gadasa. <verse eid="GEN 44:21" /><verse number="22" style="v" sid="GEN 44:22" />Nuni nu godaas nees, ‹Ee naazi ba aawappe shaakettanaas dandayenna; shaakettiko iza aaway hayqqana› gidos. <verse eid="GEN 44:22" /><verse number="23" style="v" sid="GEN 44:23" />Gido attiin neni ne aylleta, ‹Intte kaalo ishay inttenara duge yontta ixxiko nam7anththo ta ayfeso beyekketa› gadasa. <verse eid="GEN 44:23" /><verse number="24" style="v" sid="GEN 44:24" />Nuni ne aylleti nu aawaakko simmi bida wode ne nu goday nuus gidayssa izas yootidos.<verse eid="GEN 44:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 44:25" />«Nu aaway, ‹Ha7ikka simmi guye biidi guuththa kath gujji shammite› giin, <verse eid="GEN 44:25" /><verse number="26" style="v" sid="GEN 44:26" />Nuni izas, ‹Nuus kaalo ishay nunara biikkofe attiin guye baanaas dandayokko; ays giikko nu kaalo ishay nunara bontta gidikko nuni he addeza ayfeso beyanaas dandayokko› gidos.<verse eid="GEN 44:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 44:27" />«Histtiin nu aaway ne aylleta nuna, ‹Ta machcha Eraheela taas nam7u attuma nayta yelidayssa intte ereeta; <verse eid="GEN 44:27" /><verse number="28" style="v" sid="GEN 44:28" />Isttafe issoy taappe shaaketti biin tumu iza do7ay puuzereththi mides; hach gakkanaaska tani iza beyabeekke. <verse eid="GEN 44:28" /><verse number="29" style="v" sid="GEN 44:29" />Hayssa qasse intte taappe shaakki efiin iita miishshi iza gakkiko intte cimateththan ta bolla ehiza mishay tana wodhana› » gides.<verse eid="GEN 44:29" /></para>
  <para style="p">
    <verse number="30-31" style="v" sid="GEN 44:30-31" />«Hessa gishshas ha7i ta ne aylley guye ta aawaakko biza wode ta aaway naaza ba shemppo mala siiqizayssi, naazi nunara donttayssa beykko hayqqana. Nuni ne aylleti nu aawaa cimateth kayora duufon yeggana. <verse eid="GEN 44:30-31" /><verse number="32" style="v" sid="GEN 44:32" />Tani ne aylley naaza ta waaseteththan ekka yadis; tani iza, ‹Aabboo, tani iza nees saron zaarada ehontta aggiko ta layththa kumeththan ta oyshettana!› ga yoota woththadis.<verse eid="GEN 44:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 44:33" />«Hessa gishshas tani ne aylley ta godaas naaza gishshas aylletada haan attiin naazi ba ishatara guye simmo. <verse eid="GEN 44:33" /><verse number="34" style="v" sid="GEN 44:34" />Naazi baynda tani waanada guye ta aawaakko simma boo? Hanenna; ta aaway mishettana miishshaa tana bessofa» gides.<verse eid="GEN 44:34" /></para>
  <chapter eid="GEN 44" />
  <chapter number="45" style="c" sid="GEN 45" />
  <para style="s1">Yooseefey Bana Ba Ishatas Qoncciseth</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1" />He wode Yooseefey he asaa ubbaa sinththan genccana dandayontta gishshas, «Asa ubbaa ta sinththafe kessite» gi waassides. Hessa gishshas Yooseefey bana ba ishatas erisishin ishatappe attiin haray izara oonikka deenna.<note caller="-" style="x"><char style="xo" closed="false">45:1 </char><char style="xt" closed="false"><ref loc="ACT 7:13">Hawa 7:13</ref></char></note> <verse eid="GEN 45:1" /><verse number="2" style="v" sid="GEN 45:2" />Izi ba qaala dhoqqisidi Gibxe asay iza siyana gakkanaas waassi yeekkides. Kawoza soo asaykka he woreza siyides.<verse eid="GEN 45:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 45:3" />Yooseefey ba ishatas, «Tani Yooseefekko! Ta aaway hanno gakkanaas paxa dizee?» gi oychchides. Gido attiin iza ishati daro dagammida gishshas izas malthe zaaranaas dandaybeettenna.<verse eid="GEN 45:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 45:4" />Histtiin Yooseefey ba ishatas, «Taakko haa shiiqite» gides. Isttika izakko shiiqiin izi isttas, «Tani intte Gibxe biittas bayzida intte ishaa Yooseefekko, <verse eid="GEN 45:4" /><verse number="5" style="v" sid="GEN 45:5" />Xoossi tana inttefe sinththe kiittiday asa shemppo ashshanaas gidida gishshas intte tana haa bayzidayssas zil7ettofte. <verse eid="GEN 45:5" /><verse number="6" style="v" sid="GEN 45:6" />Koshay ha biittaa geliin hayssi nam7anththo layththa; qasse sinththafe yiza ichchashu layththata giddon asay biitta goyidi kath shiishshanaas dandayenna. <verse eid="GEN 45:6" /><verse number="7" style="v" sid="GEN 45:7" />Gido attiin tani inttes zereth biitta bolla ashshana malanne intte shemppo hayssa mala gita atoteththan ashshana mala, Xoossi tana inttefe sinththe ha kiittides. <verse eid="GEN 45:7" /><verse number="8" style="v" sid="GEN 45:8" />Hessa gishshas tana haa kiittiday Xoossaa attiin inttena deekketa. Xoossi tana Gibxe kawos aawa, iza aqo ubbaas godaanne Gibxe biitta haarizaade ooththides» gides.<verse eid="GEN 45:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 45:9" />«Ha7i eeson guye ta aawaakko biidi izas ne naa Yooseefey, ‹Xoossi tana Gibxe biitta ubbaa bolla godaa kessides; hessa gishshas gam7ontta taakko haa ya. <verse eid="GEN 45:9" /><verse number="10" style="v" sid="GEN 45:10" />Neni ta matan Geeseme biittan ne naytara, nayta naytara, dorsatara, mehetara, nees diza ubbaara haan daandeta. <verse eid="GEN 45:10" /><verse number="11" style="v" sid="GEN 45:11" />Buroppe ichchashu kosha layththati deettes; nena neso asaanne ne mehe koshay gakkontta mala tani nena mizana› gees giite» gides.<note caller="-" style="x"><char style="xo" closed="false">45:9-11 </char><char style="xt" closed="false"><ref loc="ACT 7:14">Hawa 7:14</ref></char></note><verse eid="GEN 45:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 45:12" />Qasseka Yooseefey isttas, «Ha inttenara haasayzayssi tumu tani Yooseefe gididayssa intteka, ta ishaa Biniyaameykka intte ayfen be7eeta. <verse eid="GEN 45:12" /><verse number="13" style="v" sid="GEN 45:13" />Taas Gibxe biittan diza bonchcho intte be7idayssa ubbaa ta aawaas yootite; eesonkka haa duge ekki yiite» gides.<verse eid="GEN 45:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 45:14" />Histtidi ba ishaa Biniyaame idimmi oykkidi yeekkides; Biniyaameykka ba ishaa idimmi oykkidi yeekkides. <verse eid="GEN 45:14" /><verse number="15" style="v" sid="GEN 45:15" />Yooseefeykka yeekkishe ba ishata ubbaa yeeri yeeri ekkides. Hessafe guye iza ishati izara haasaya oykkida.<verse eid="GEN 45:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 45:16" />Yooseefe ishata yuussa worey kawo Paaroone keeth gakkida wode kawoynne iza oosanchchati ufayettida. <verse eid="GEN 45:16" /><verse number="17" style="v" sid="GEN 45:17" />Kawoy Yooseefe, «Neni ne ishata, ‹Intte mehe caanidi Kanaane biitta simmite; <verse eid="GEN 45:17" /><verse number="18" style="v" sid="GEN 45:18" />Histtidi intte aawaanne intte soo asaa ekkidi guye taakko haa ehite. Tani inttes Gibxe biittan ubbasoppe lo7izaso immana; isttika ha biittaa modhdho kaachana› ga. <verse eid="GEN 45:18" /><verse number="19" style="v" sid="GEN 45:19" />Qasseka neni ne ishata, ‹Para-gaareza intte naytassinne intte maccassatas Gibxeppe ekki biidi intte aawaakka ekki yiite. <verse eid="GEN 45:19" /><verse number="20" style="v" sid="GEN 45:20" />Gibxe biittan diza ubbaafe aadhdhi lo7iza miish inttes gidana gishshas inttes diza haaro ekki yaana qoppofte› ga yoota» gides.<verse eid="GEN 45:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 45:21" />Histtiin Yaaqoobe nayti gida mala ooththida. Yooseefeykka kawoy azazida mala para-gaaretanne oges gidiza shinqe isttas immides. <verse eid="GEN 45:21" /><verse number="22" style="v" sid="GEN 45:22" />Isttas ubbaasikka hu7en hu7en ooraththa may7o immides; gido attiin Biniyaames heedzdzu xeetu saqile biranne ichchashu kumeththa may7o immides. <verse eid="GEN 45:22" /><verse number="23" style="v" sid="GEN 45:23" />Izikka ba aawaas Gibxen diza ubbaafe lo7izayssa tammu haren caanidi, qasse oges kath, ukeththinne hara shinqe tammu macca haretan caanidi yeddides. <verse eid="GEN 45:23" /><verse number="24" style="v" sid="GEN 45:24" />Yooseefey ba ishata moyzides. Istti bishin izi isttas, «Bishe ogen intte garsan ooyettofte» gides.<verse eid="GEN 45:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 45:25" />Istti Gibxeppe kezidi bida; Kanaane biitta biidi ba aawa Yaaqoobekko gakkida. <verse eid="GEN 45:25" /><verse number="26" style="v" sid="GEN 45:26" />Istti izas, «Yooseefey paxa dees! Qasseka izi Gibxe biitta ubbaa haarees» giin Yaaqoobe wozinay dagammida gishshas istta ammanibeenna. <verse eid="GEN 45:26" /><verse number="27" style="v" sid="GEN 45:27" />Gido attiin istti Yooseefey baas yootidayssa ubbaa izas yootininne iza ekki ehana mala Yooseefey kiittida para-gaareta izi beyiin, istta aawa Yaaqoobes shemppoy simmides. <verse eid="GEN 45:27" /><verse number="28" style="v" sid="GEN 45:28" />Yaaqoobeykka, «Hessi taas gidana; ta naazi Yooseefey hanno gakkanaas paxa dees! Tani hayqqanaappe sinththan baada iza beyana» gides.<verse eid="GEN 45:28" /></para>
  <chapter eid="GEN 45" />
  <chapter number="46" style="c" sid="GEN 46" />
  <para style="s1">Yaaqoobey Baso Asaara Gibxe Buus</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1" />Isra7eeley baas dizayssa ubbaa ekki dendidi Bersaabehe gakkides. Heenkka izi ba aawa Yisaaqa Xoossaas yarsho shiishshides. <verse eid="GEN 46:1" /><verse number="2" style="v" sid="GEN 46:2" />Xoossi omars agumora iza, «Yaaqoobe, Yaaqoobe» gi xeygiin</para>
  <para style="q2" vid="GEN 46:2">izi, «Yee!» gi koyides.<verse eid="GEN 46:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 46:3" />«Tani Xoossay ne aawa Xoossa; neni duge Gibxe baanaas babbofa; ays giikko tani nena heen gita kawoteth kessana. <verse eid="GEN 46:3" /><verse number="4" style="v" sid="GEN 46:4" />Tani nenara issife Gibxe baana; qasse tani ne zereththaa heeppe kessana. Yooseefey ba kushera ne hayqqishin nena shiishshana» gides.<verse eid="GEN 46:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 46:5" />Hessafe guye Yaaqoobey Bersaabeheppe dendides; Yaaqoobe attuma nayti ba aawa Yaaqoobe, ba naytanne ba machcheta Gibxe kawoy isttas kiittida para-gaare togisi ekki bida. <verse eid="GEN 46:5" /><verse number="6" style="v" sid="GEN 46:6" />Istti Kanaane biittan haarida aqonne mehe ubbaa ekki bida. Yaaqoobeynne iza zereththi wuri izara Gibxe bides.<note caller="-" style="x"><char style="xo" closed="false">46:6 </char><char style="xt" closed="false"><ref loc="ACT 7:15">Hawa 7:15</ref></char></note> <verse eid="GEN 46:6" /><verse number="7" style="v" sid="GEN 46:7" />Izikka ba zereth ubbaa ba attuma nayta, ba macca naytanne nayta nayta ubbaa banara Gibxe ekki bides.<verse eid="GEN 46:7" /></para>
  <para style="s1">Yaaqoobe Zereth</para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 46:8" />Yaaqoobera Gibxe biitta bida Isra7eele nayta sunththi hayssafe kaalli xaafettidayssa.</para>
  <para style="p" vid="GEN 46:8">Yaaqoobe bayra nay Oroobeele; <verse eid="GEN 46:8" /><verse number="9" style="v" sid="GEN 46:9" />Oroobeele attuma nayti Heenooke, Paalu, Hexiroomenne Karme. <verse eid="GEN 46:9" /><verse number="10" style="v" sid="GEN 46:10" />Simoona attuma nayti Yimu7eele, Yaamine, Ohaade, Yaakine, Xoohaarenne Kanaane maccassay naa Sa7oole. <verse eid="GEN 46:10" /><verse number="11" style="v" sid="GEN 46:11" />Lewe attuma nayti Gershoone, Qa7aatenne Meraare. <verse eid="GEN 46:11" /><verse number="12" style="v" sid="GEN 46:12" />Yuhuda attuma nayti Eera, Oonaane, Seela, Paareesenne Zaraahe; gido attiin Eeraynne Oonaaney Kanaane biittan hayqqida. Paareese attuma nayti Hexiroomenne Hamule. <verse eid="GEN 46:12" /><verse number="13" style="v" sid="GEN 46:13" />Yisakoore attuma nayti Tola, Puuwa, Yaashubenne Shimiroone. <verse eid="GEN 46:13" /><verse number="14" style="v" sid="GEN 46:14" />Zaabiloone attuma nayti Sereede, Eeloonenne Yaahile7eele. <verse eid="GEN 46:14" /><verse number="15" style="v" sid="GEN 46:15" />Hayti Liyay Mesphexoomiyan Yaaqoobes yelida attuma nayta; izi macca naya Diino. Hayti iza naytinne nayta nayti mulera heedzdzu tammanne heedzdza.<verse eid="GEN 46:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 46:16" />Gaade attuma nayti Xafoone, Hagge, Shuune, Exiboone, Ere, Aroodenne Ar7eele. <verse eid="GEN 46:16" /><verse number="17" style="v" sid="GEN 46:17" />Aaseere attuma nayti Yimine, Yishiwa, Yishiwenne Barihe; istta michcheyakka Seraho. Barihe attuma nayti Heeberenne Malkki7eele. <verse eid="GEN 46:17" /><verse number="18" style="v" sid="GEN 46:18" />Laabay ba naa Liyas immida Zilfay Yaaqoobes yelida nayti nayta nayti hayta; istti mulera tammanne usuppuna.<verse eid="GEN 46:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 46:19" />Yaaqoobe machcheyo Eraheeli attuma nayti Yooseefenne Biniyaame. <verse eid="GEN 46:19" /><verse number="20" style="v" sid="GEN 46:20" />Oona geetettiza katama qeese Phixifaara naya Asinaata Yooseefes Gibxen Minaasenne Efreeme yeladus.<note caller="-" style="x"><char style="xo" closed="false">46:20 </char><char style="xt" closed="false"><ref loc="GEN 41:50-52">Medhe 41:50-52</ref></char></note> <verse eid="GEN 46:20" /><verse number="21" style="v" sid="GEN 46:21" />Biniyaame nayti Beela, Bekere, Ashibeele, Geera, Na7imaane, Eehe, Orooshe, Muppiime, Huppimenne Araade. <verse eid="GEN 46:21" /><verse number="22" style="v" sid="GEN 46:22" />Yaaqoobes yelettida Eraheeli attuma naytinne nayta nayti hayta; istti mulera tammanne oydda.<verse eid="GEN 46:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 46:23" />Daane attuma nay Hushime. <verse eid="GEN 46:23" /><verse number="24" style="v" sid="GEN 46:24" />Niftaaleme attuma nayti Yahixele, Gune, Yexirenne Sheleme <verse eid="GEN 46:24" /><verse number="25" style="v" sid="GEN 46:25" />Laabay ba naa Eraheelis immida Bilihay Yaaqoobes yelida naytinne nayta nayti hayta; istti mulera laappuna.<verse eid="GEN 46:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 46:26" />Yaaqoobera Gibxe bida naytinne nayta nayti, iza nayta machcheta gujjontta mulera usuppun tammanne usuppuna. <verse eid="GEN 46:26" /><verse number="27" style="v" sid="GEN 46:27" />Gibxen Yooseefes yelettida nam7u nayta gujjiin Gibxe bida Yaaqoobe soo asay mulera laappun tamma.<note caller="-" style="x"><char style="xo" closed="false">46:27 </char><char style="xt" closed="false"><ref loc="ACT 7:14">Hawa 7:14</ref></char></note><verse eid="GEN 46:27" /></para>
  <para style="s1">Gibxe Biittan Yaaqoobenne Izaso Asaa</para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28" />Sinththati biidi Geeseme biittan bana mokkana mala Yaaqoobey Yuhuda baappe sinththe Yooseefekko yeddides; istti Geeseme gakkida wode, <verse eid="GEN 46:28" /><verse number="29" style="v" sid="GEN 46:29" />Yooseefey ba para-gaareza giigsidi ba aawaa Yaaqoobera gaagganaas Geeseme bides. Yooseefey ba aawa demmida mala idimmi oykkidi daro saate yeekkides.<verse eid="GEN 46:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 46:30" />Isra7eeley Yooseefe, «Neni paxa dishin tani ne ayfeso be7ida gishshas hi7a tani hayqqiko metenna» gides.<verse eid="GEN 46:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 46:31" />Hessafe guye Yooseefey ba ishatassinne ba aawa soo asatas, «Tani Gibxe kawozaakko baada izas, ‹Kanaane biittan diza ta ishatinne ta aawa soo asay taakko yida. <verse eid="GEN 46:31" /><verse number="32" style="v" sid="GEN 46:32" />Istti miizinne dorsa haarizayta; istti banara ba dorsata, ba miizatanne baas dizayssa ubbaa ekki yida› gaana. <verse eid="GEN 46:32" /><verse number="33" style="v" sid="GEN 46:33" />Kawoy inttena xeygidi, ‹Intte oosoy aazee?› gi oychchiko, <verse eid="GEN 46:33" /><verse number="34" style="v" sid="GEN 46:34" />intte izas, ‹Nuni ne aylleti naateththafe doommidi nu aawata malakka mehe heemmoos› giite. Histtiko izi inttena Geeseme biittan woththana; ays giikko dorsa heenththanchchay wuri Gibxe asaa achchan kadhettidayta» gides.<verse eid="GEN 46:34" /></para>
  <chapter eid="GEN 46" />
  <chapter number="47" style="c" sid="GEN 47" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 47:1" />Yooseefey gelidi Gibxe kawos, «Ta aawaynne ta ishati ba dorsatara, ba miizatara baas dizaaz ubbaa ekkidi Kanaane biittafe yiidi, ha7i Geeseme biittan deettes» gi yootides. <verse eid="GEN 47:1" /><verse number="2" style="v" sid="GEN 47:2" />Izi ba ishatappe ichchashata dooridi kawoza sinth aaththides.<verse eid="GEN 47:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 47:3" />Kawoy he ishata, «Intte oosoy aazee?» gi oychchiin istti kawozas, «Nuni ne aylleti nu aawataththo dorsa heemmoos» gi yootida. <verse eid="GEN 47:3" /><verse number="4" style="v" sid="GEN 47:4" />Qasse istti izas, «Kanaane biittan koshay darida gishshas nuus ne aylleta mehetas miza miishshi aykkoka baynda gishshas, nuni hayssan imaththateththan daana yidos; shoobbe nuna ne aylleta Geesemen woththarkkii!» gida.<verse eid="GEN 47:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 47:5" />Kawoy Yooseefe, «Ne aawaynne ne ishati neekko yida. <verse eid="GEN 47:5" /><verse number="6" style="v" sid="GEN 47:6" />Histtiin Gibxe derey ne kushen dees gidennee; ha biittan ubbaafe aadhdhidi lo7izason ne aawaanne ne ishata woththa; istti Geeseme biittan detto. Istta giddofe dumma erateththi dizayta ne erizaa gidikko heyta ta meheta bolla shuuma» gides.<verse eid="GEN 47:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 47:7" />Hessafe guye Yooseefey ba aawaa Yaaqoobe gelththidi kawo sinth aaththides. Yaaqoobey Gibxe kawo anjjides. <verse eid="GEN 47:7" /><verse number="8" style="v" sid="GEN 47:8" />Kawoykka Yaaqoobe, «Nees aappun layththee?» gi oychchides.<verse eid="GEN 47:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 47:9" />Yaaqoobey kawozas, «Tani yuuya yuuya deyida layththay 130; ta layththay beni ta aawati yuuyi yuuyi deyida layththatappe guuththanne metoy darida layththa» gides. <verse eid="GEN 47:9" /><verse number="10" style="v" sid="GEN 47:10" />Hessafe guye Yaaqoobey kawoza anjjidi iza sinththafe kare kezides.<verse eid="GEN 47:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 47:11" />Yooseefey ba aawaanne ba ishata Gibxe biittan woththides; kawoy azazida mala Gibxe biittan Eraamise achchan diza ubbasoppe aadhdhidi lo7iza gade isttas immides. <verse eid="GEN 47:11" /><verse number="12" style="v" sid="GEN 47:12" />Yooseefey qasse ba aawaas, ba ishatassinne ba aawa soo asaa ubbaas istta nayta qooda mala kath immides.<verse eid="GEN 47:12" /></para>
  <para style="s1">Gibxe Kosha Minoteth</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13" />Gidikkoka koshay darida gishshas biitta ubbaa bolla kaththi dhaydes. He koshaan Gibxe dereynne Kanaane derey nam7ayka qohettida. <verse eid="GEN 47:13" /><verse number="14" style="v" sid="GEN 47:14" />Yooseefey Gibxe kath bayzidi Gibxeninne Kanaane biittan diza miish ubbaa shiishshidi Gibxe kawo keeth gelththides. <verse eid="GEN 47:14" /><verse number="15" style="v" sid="GEN 47:15" />Gibxe miishshaynne Kanaane miishshay ubbay wuriin Gibxe asay wuri Yooseefekko yiidi iza, «Nuus kath imma; nu miishshay wurida gishshas nuni ne dishin ays hayqqizonii?» gida.<verse eid="GEN 47:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 47:16" />Histtiin Yooseefey isttas, «Intte mehe ekki yiite; intte miishshay wuridaa gidikko tani kath inttes mehera laammana» gides. <verse eid="GEN 47:16" /><verse number="17" style="v" sid="GEN 47:17" />Hessa gishshas istti ba mehe Yooseefes ehiin Yooseefey istta para, dorsa, deyshe, miizinne hare kaththara laammides; izi he layth istta mehe ubbaara kath laammi laammi mizi shaachchides.<verse eid="GEN 47:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 47:18" />He layththay wuriin nam7anththo layththan istti izakko yiidi izas, «Nuni nu godaappe qottiza miishshi deenna; nu miishshay wurides; nuus diza mehekka ubbaa nees sheedhdhidos; nu godaas nees nunateththafenne nu gadeppe attiin nu immana miishshi haray deenna. <verse eid="GEN 47:18" /><verse number="19" style="v" sid="GEN 47:19" />Ne dishin nu ays hayqqizonii? Nu gadeykka ays dhayzee? Nunakka nu gadezakka kaththara laamma; nuni kawos aylletana; nu gadeykka izas gido; nuni hayqqontta de7on daana malanne nu gadeykka oxxontta mala zereth nuus imma» gida.<verse eid="GEN 47:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 47:20" />Yooseefey Gibxe biitta ubbaa kawos shammides. Gibxeti wuri koshay minnida gishshas ba gadeza bayziin gadezi kawos gidides. <verse eid="GEN 47:20" /><verse number="21" style="v" sid="GEN 47:21" />Yooseefey Gibxe asa ubbaa ha gaxappe doommidi he gaxa gakkanaas kawos aylle kessides. <verse eid="GEN 47:21" /><verse number="22" style="v" sid="GEN 47:22" />Gidikkoka kawoy qeesetas kath immiza gishshas qeeseta gade shammibeenna. Hessa gishshas qeeseti ba gade bayzibeettenna.<verse eid="GEN 47:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 47:23" />Yooseefey asaa, «Histtiin hach tani inttenanne intte gade kawos shammida gishshas zereth ekkidi intte gaden gaden zerite. <verse eid="GEN 47:23" /><verse number="24" style="v" sid="GEN 47:24" />Gido attiin kath maxi gelththiza wode kaththaafe ichchashu kusheppe issi kushe kawos immite. Ichchash kusheppe attida oyddu kushezi intte gades zereth, intteso asaassinne intte naytas quma gido» gides.<verse eid="GEN 47:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 47:25" />Histtiin istti, «Neni nuna ashshadasa! Nu godaa sinththan nuni nashettidaa gidikko nu kawos aylle gidana» gida. <verse eid="GEN 47:25" /><verse number="26" style="v" sid="GEN 47:26" />Hessa gishshas Yooseefey Gibxe biittan kaxxida kaththaas ichchash kusheppe issi kushe kawos immizayssi woga gidana mala ooththides. He wogazikka hach gakkanaas eqqi dees. Kawos gidontta gadey qeeseta gade xalla.<verse eid="GEN 47:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27" />Isra7eeleti Gibxe biittan Geeseme geetettizason uttida; istti heen aqota demmida; istti yelettidanne daro corattida.<verse eid="GEN 47:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 47:28" />Yaaqoobey Gibxe biittan 17 layth de7ides. Yaaqoobey de7ida layththay issi xeetanne oyddu tammanne laappuna. <verse eid="GEN 47:28" /><verse number="29" style="v" sid="GEN 47:29" />Yaaqoobes hayqo wodey matiin ba naa Yooseefe xeygisidi, «Tani ne sinththan sabettidaa gidikko ne kushe ta gulbate bolla woththada neni taas kiyattanaassinne ammanettanaas ane caaqqa. Tana Gibxen moogoppa. <verse eid="GEN 47:29" /><verse number="30" style="v" sid="GEN 47:30" />Gido attiin tani ta aawatan gaaggiza wode tana Gibxeppe efada istti moogettidason mooga» gides.<note caller="-" style="x"><char style="xo" closed="false">47:29-30 </char><char style="xt" closed="false"><ref loc="GEN 49:29-32">Medhe 49:29-32</ref>; <ref loc="GEN 50:6">50:6</ref></char></note></para>
  <para style="p" vid="GEN 47:30">Histtiin Yooseefey, «Tani nena neni gida mala ooththana» gides.<verse eid="GEN 47:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 47:31" />Yaaqoobey iza, «Ane taas caaqqa» gides. Yooseefeykka izas caaqqides; hessafe guye Yaaqoobey ba hiixan gufannidi Xoossas goynnides.<verse eid="GEN 47:31" /></para>
  <chapter eid="GEN 47" />
  <chapter number="48" style="c" sid="GEN 48" />
  <para style="s1">Minaasenne Efreeme</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1" />Hessafe guye asay Yooseefes, «Ne aaway sakettees» gi yootiin izi ba nam7u attuma nayta Minaasenne Efreeme ekki bides. <verse eid="GEN 48:1" /><verse number="2" style="v" sid="GEN 48:2" />Asay Yaaqoobe, «Beya! Ne nay Yooseefey neekko yides» giin Isra7eeley minettidi ba hiixa bolla dendi uttides.<verse eid="GEN 48:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 48:3" />Yaaqoobey Yooseefe, «Ubbaa Dandayza Xoossi Kanaane biittan Looza geetettizason taas qonccidi heen tana anjjides. <verse eid="GEN 48:3" /><verse number="4" style="v" sid="GEN 48:4" />Izi tana, ‹Ta nees yelo immana ne yelotakka darsana; tani nena daro dere histtana. Ha biittaa tani neeppe guye ne zereththas mernaas laata biitta histta immana› gides.<note caller="-" style="x"><char style="xo" closed="false">48:3-4 </char><char style="xt" closed="false"><ref loc="GEN 28:13-14">Medhe 28:13-14</ref></char></note><verse eid="GEN 48:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 48:5" />«Histtiin ha7i ne nam7u attuma nayti tani neekko hayssa yaanaappe kase Gibxen nees yelettidayti tayta; Efreemeynne Minaasey taas Oroobeelenne Simoona mala. <verse eid="GEN 48:5" /><verse number="6" style="v" sid="GEN 48:6" />Isttafe guye nees yelettidayti ne nayta; istti laattana derey Efreemenne Minaase sunththan summo. <verse eid="GEN 48:6" /><verse number="7" style="v" sid="GEN 48:7" />Tani Mesphexoomiyappe simmishin Efraata geetettiza dere gakkana gishin Eraheela Kanaane biittan hayqqiin tani izo Beeteliheeme geetettiza Efraata efiza oge doonan moogadis» gides.<note caller="-" style="x"><char style="xo" closed="false">48:7 </char><char style="xt" closed="false"><ref loc="GEN 35:16-19">Medhe 35:16-19</ref></char></note><verse eid="GEN 48:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 48:8" />Isra7eeley Yooseefe attuma nayta nam7ata be7idi, «Hayti oonee?» gi oychchides.<verse eid="GEN 48:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 48:9" />Yooseefeykka ba aawaas, «Hayti Xoossi taas haan hayssan immida ta nayta» gides.</para>
  <para style="p" vid="GEN 48:9">Histtiin Isra7eeley, «Ta istta anjjana mala taakko haa shiishsha» gides.<verse eid="GEN 48:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 48:10" />Yaaqoobey cimmiin iza ayfey daaburda gishshas demmanaas dandaybeenna. Hessa gishshas Yooseefey ba attuma nayta izakko shiishshiin iza aaway istta idimmidi yeerides. <verse eid="GEN 48:10" /><verse number="11" style="v" sid="GEN 48:11" />Yaaqoobey Yooseefe, «Tani ne ayfeso beyana gaada qoppabeekke; gido attiin Xoossi hekko ne naytakka tana bessides» gides. <verse eid="GEN 48:11" /><verse number="12" style="v" sid="GEN 48:12" />Yooseefey istta Yaaqoobe gulbate bollafe denththidi ba hu7e biitta gaththi ziggides.<verse eid="GEN 48:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 48:13" />Yooseefey ba nam7u attuma nayta ekkidi Efreeme ba ushachcha baggan Yaaqoobes hadirsa baggara, Minaase ba hadirsa baggan Yaaqoobes ushachcha baggara izakko shiishshides. <verse eid="GEN 48:13" /><verse number="14" style="v" sid="GEN 48:14" />Gido attiin Yaaqoobey ba kushe yaanne haa qaaseththi aaththidi ba ushachcha kushe kaalo naaza Efreeme hu7e bolla, ba hadirsa kushe bayra naaza Minaase hu7e bolla woththides.<verse eid="GEN 48:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 48:15" />Hessafe guye Yaaqoobey Yooseefe,</para>
  <para style="q2" vid="GEN 48:15">«Ta aawati Abrahaameynne Yisaaqi</para>
  <para style="q2" vid="GEN 48:15">iza sinththan</para>
  <para style="q2" vid="GEN 48:15">suuren de7ida Xoossi,</para>
  <para style="q2" vid="GEN 48:15">ta de7o ubbaan hach gakkanaas</para>
  <para style="q2" vid="GEN 48:15">tana heemmida Xoossi,<verse eid="GEN 48:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="GEN 48:16" />iita miishsha ubbaafe</para>
  <para style="q2" vid="GEN 48:16">tana ashshida kiitanchchay,</para>
  <para style="q2" vid="GEN 48:16">ha nayta anjjo.</para>
  <para style="q2" vid="GEN 48:16">Ta sunththaynne</para>
  <para style="q2" vid="GEN 48:16">ta aawata Abrahaamenne</para>
  <para style="q2" vid="GEN 48:16">Yisaaqa sunththay isttan xeygetto.</para>
  <para style="q2" vid="GEN 48:16">Istti biitta bollan</para>
  <para style="q2" vid="GEN 48:16">corattetto» gi anjjides.<verse eid="GEN 48:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 48:17" />Yooseefey ba aaway ba ushachcha kushe Efreeme hu7e bolla woththidayssa dosibeenna. Hessa gishshas Efreeme hu7e bollafe denththidi Minaase hu7e bolla woththanaas ba aawa kushe oykkides. <verse eid="GEN 48:17" /><verse number="18" style="v" sid="GEN 48:18" />Yooseefey ba aawaas, «Aabboo hessaththo deenna! Bayray hayssa gidontta gishshas ne ushachcha kushe hayssa bolla woththa» gides.<verse eid="GEN 48:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 48:19" />Gido attiin iza aaway ixxidi izas, «Ta naazoo! Ta erays; izikka gita dere gidana. Gidikkoka kaalo ishay izappe aadhdhi gitatana; iza zereththayka daro gita kawoteth gidana» gides.<verse eid="GEN 48:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 48:20" />Izi he gallas istta anjjidi,</para>
  <para style="q2" vid="GEN 48:20">«Isra7eele nayti anjjo anjjiza wode,</para>
  <para style="q2" vid="GEN 48:20">‹Xoossi inttena Efreeme malanne</para>
  <para style="q2" vid="GEN 48:20">Minaase mala ooththo› giidi</para>
  <para style="q2" vid="GEN 48:20">intte sunththan anjjana» gides.</para>
  <para style="q2" vid="GEN 48:20">Histtidi Efreeme Minaaseppe</para>
  <para style="q2" vid="GEN 48:20">sinththe aaththides.<note caller="-" style="x"><char style="xo" closed="false">48:20 </char><char style="xt" closed="false"><ref loc="HEB 11:21">Ib 11:21</ref></char></note><verse eid="GEN 48:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 48:21" />Hessafe guye Yaaqoobey Yooseefe, «Ta hayqqana gays; gido attiin Xoossi inttenara gidana; qasse izi intte aawata biitta inttena guye zaarana. <verse eid="GEN 48:21" /><verse number="22" style="v" sid="GEN 48:22" />Qasse nena ne ishatara gakkiza biittaafe gisha darssada nees immays; hessika tani Amooretappe ta mashshaninne tooran ola ekkida biitta» gides.<verse eid="GEN 48:22" /></para>
  <chapter eid="GEN 48" />
  <chapter number="49" style="c" sid="GEN 49" />
  <para style="s1">Yaaqoobey Ba Naytas Yootida Bassa Qaala</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1" />Hessafe guye Yaaqoobey ba attuma nayta xeygidi, «Sinththafe inttes hananayssa tani inttes yootana mala haa shiiqite.<verse eid="GEN 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="GEN 49:2" />«Intteno Yaaqoobe naytoo!</para>
  <para style="q2" vid="GEN 49:2">Issife haa shiiqidi siyite;</para>
  <para style="q2" vid="GEN 49:2">intte aaway Isra7eeley</para>
  <para style="q2" vid="GEN 49:2">inttes yootizayssa ezgite.<verse eid="GEN 49:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="GEN 49:3" />«Oroobeele ta naa bayrazoo,</para>
  <para style="q2" vid="GEN 49:3">neni ta wolqqa;</para>
  <para style="q2" vid="GEN 49:3">ta minoteththas koyro;</para>
  <para style="q2" vid="GEN 49:3">neni bonchchonkka wolqqankka</para>
  <para style="q2" vid="GEN 49:3">ubbaafe aadhdhaasa.<verse eid="GEN 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="GEN 49:4" />Neni bixalay baynda para mala;</para>
  <para style="q2" vid="GEN 49:4">ne dosidaa hanaasa;</para>
  <para style="q2" vid="GEN 49:4">neni ne aawa hiith kezadasa;</para>
  <para style="q2" vid="GEN 49:4">ne aawa hiiththaaka tunisadasa.</para>
  <para style="q2" vid="GEN 49:4">Hessa gishshas halaqateththi</para>
  <para style="q2" vid="GEN 49:4">nees bessenna.<verse eid="GEN 49:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="GEN 49:5" />«Simooninne Lewey ishantta;</para>
  <para style="q2" vid="GEN 49:5">istti iita ooththanaas</para>
  <para style="q2" vid="GEN 49:5">mashshanne toora ekkeettes.<verse eid="GEN 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 49:6" />Tani istta</para>
  <para style="q2" vid="GEN 49:6">zoreteththan gelikke;</para>
  <para style="q2" vid="GEN 49:6">tani istta</para>
  <para style="q2" vid="GEN 49:6">shiiqosonkka uttike.</para>
  <para style="q2" vid="GEN 49:6">Ays giikko istti</para>
  <para style="q2" vid="GEN 49:6">ba hanqon as wodhidanne</para>
  <para style="q2" vid="GEN 49:6">bana ekka ekka giin</para>
  <para style="q2" vid="GEN 49:6">boorata gildayi qanxxida.<verse eid="GEN 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="GEN 49:7" />Istta iita hanqoynne</para>
  <para style="q2" vid="GEN 49:7">istta meqeththa iitateththi</para>
  <para style="q2" vid="GEN 49:7">qanggettidaaz gido!</para>
  <para style="q2" vid="GEN 49:7">Tani istta</para>
  <para style="q2" vid="GEN 49:7">Yaaqoobe asaa giddon laallana;</para>
  <para style="q2" vid="GEN 49:7">Isra7eele biittan dharccana.<verse eid="GEN 49:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="GEN 49:8" />«Yuhuda ne ishati</para>
  <para style="q2" vid="GEN 49:8">nena galatana;</para>
  <para style="q2" vid="GEN 49:8">neni ne morkketa morge</para>
  <para style="q2" vid="GEN 49:8">naaqqa oykkana;</para>
  <para style="q2" vid="GEN 49:8">ne aawa nayti</para>
  <para style="q2" vid="GEN 49:8">nees hokkidi ziggana.<verse eid="GEN 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="GEN 49:9" />Yuhuda neni</para>
  <para style="q2" vid="GEN 49:9">wodalla gaammo mala;</para>
  <para style="q2" vid="GEN 49:9">ta naazoo!</para>
  <para style="q2" vid="GEN 49:9">Neni shankkati oykkidi,</para>
  <para style="q2" vid="GEN 49:9">cogotti ichchida gaammo mala.</para>
  <para style="q2" vid="GEN 49:9">Neni asi bana bosheththanaas</para>
  <para style="q2" vid="GEN 49:9">koyontta macca gaammo mala.<note caller="-" style="x"><char style="xo" closed="false">49:9 </char><char style="xt" closed="false"><ref loc="NUM 24:9">Tay 24:9</ref>; <ref loc="REV 5:5">Ajju 5:5</ref></char></note><verse eid="GEN 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="GEN 49:10" />Dere haarizaadey</para>
  <para style="q2" vid="GEN 49:10">yaana gakkanaashe,</para>
  <para style="q2" vid="GEN 49:10">kawoteththaa algay Yuhudappe,</para>
  <para style="q2" vid="GEN 49:10">halaqateththa guufey</para>
  <para style="q2" vid="GEN 49:10">iza keeththafe shaakettenna.</para>
  <para style="q2" vid="GEN 49:10">Qasse dere asay</para>
  <para style="q2" vid="GEN 49:10">izas azazettana.<verse eid="GEN 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="GEN 49:11" />Izi ba hare kaththa giddon</para>
  <para style="q2" vid="GEN 49:11">ba hare gutteka</para>
  <para style="q2" vid="GEN 49:11">doorettida kaththan qachchana.</para>
  <para style="q2" vid="GEN 49:11">Izi ba haath woyne ushshan,</para>
  <para style="q2" vid="GEN 49:11">ba may7o qasse</para>
  <para style="q2" vid="GEN 49:11">woyne maadhan meeccana.<verse eid="GEN 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 49:12" />Iza ayfey woyne ushshafe</para>
  <para style="q2" vid="GEN 49:12">aadhdhi zo7ana;</para>
  <para style="q2" vid="GEN 49:12">iza achchayka</para>
  <para style="q2" vid="GEN 49:12">maaththafe aadhdhi boottana.<verse eid="GEN 49:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="GEN 49:13" />«Zaabilooney</para>
  <para style="q2" vid="GEN 49:13">abba doonan daana;</para>
  <para style="q2" vid="GEN 49:13">iza biittay</para>
  <para style="q2" vid="GEN 49:13">daro markabetas</para>
  <para style="q2" vid="GEN 49:13">shemposo gidana;</para>
  <para style="q2" vid="GEN 49:13">iza zaway Sidoona gakkana.<verse eid="GEN 49:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="GEN 49:14" />«Yisakoorey nam7u goday</para>
  <para style="q2" vid="GEN 49:14">go7ettiza mino hare mala.<verse eid="GEN 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 49:15" />Izi ba shempizasoy</para>
  <para style="q2" vid="GEN 49:15">lo7o gididayssanne</para>
  <para style="q2" vid="GEN 49:15">ba derey ufayssizaaz</para>
  <para style="q2" vid="GEN 49:15">gididayssa be7idi,</para>
  <para style="q2" vid="GEN 49:15">tooho tookkanaas ba zokko</para>
  <para style="q2" vid="GEN 49:15">ziqqi histtidi,</para>
  <para style="q2" vid="GEN 49:15">aylleteththa ooso ooththana.<verse eid="GEN 49:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="GEN 49:16" />«Daaney Isra7eele</para>
  <para style="q2" vid="GEN 49:16">qommotappe issaas</para>
  <para style="q2" vid="GEN 49:16">pirdiza daanna gidana.<verse eid="GEN 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="GEN 49:17" />Daaney para toggidaadey</para>
  <para style="q2" vid="GEN 49:17">guye kundana mala</para>
  <para style="q2" vid="GEN 49:17">para qirphe dukkiza</para>
  <para style="q2" vid="GEN 49:17">oge doonan diza haso shooshsha.<verse eid="GEN 49:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="GEN 49:18" />«Abeet Godoo!</para>
  <para style="q2" vid="GEN 49:18">Ta ne maado naagays.<verse eid="GEN 49:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="GEN 49:19" />«Gaadey bonqqizaytan</para>
  <para style="q2" vid="GEN 49:19">deshettana;</para>
  <para style="q2" vid="GEN 49:19">gido attiin izikka</para>
  <para style="q2" vid="GEN 49:19">istta geedo kaallidi</para>
  <para style="q2" vid="GEN 49:19">istta bonqqana.<verse eid="GEN 49:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="GEN 49:20" />«Aaseere maadday aakkana;</para>
  <para style="q2" vid="GEN 49:20">kawotas izi</para>
  <para style="q2" vid="GEN 49:20">lo7o quma immana.<verse eid="GEN 49:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="GEN 49:21" />«Niftaalemey qashettontta</para>
  <para style="q2" vid="GEN 49:21">yeda diza,</para>
  <para style="q2" vid="GEN 49:21">lo7o laaqqata yeliza genessa.<verse eid="GEN 49:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="GEN 49:22" />«Yooseefey melontta pultto</para>
  <para style="q2" vid="GEN 49:22">haaththa achchan tokettada,</para>
  <para style="q2" vid="GEN 49:22">izi ayfey lasha bollara</para>
  <para style="q2" vid="GEN 49:22">alalettana gakkanaas</para>
  <para style="q2" vid="GEN 49:22">ayfe immiza miththay mala.<verse eid="GEN 49:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="GEN 49:23" />Wondafeza dukkizayti</para>
  <para style="q2" vid="GEN 49:23">iza bolla worajjida;</para>
  <para style="q2" vid="GEN 49:23">ba wondafenkka</para>
  <para style="q2" vid="GEN 49:23">gooddi gooddi caddeettes.<verse eid="GEN 49:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 49:24" />Gido attiin Yaaqoobe</para>
  <para style="q2" vid="GEN 49:24">Godaa Xoossa wolqqan</para>
  <para style="q2" vid="GEN 49:24">iza heemmiza Isra7eele zaallan</para>
  <para style="q2" vid="GEN 49:24">iza wondafey minnides;</para>
  <para style="q2" vid="GEN 49:24">iza mino qeseykka</para>
  <para style="q2" vid="GEN 49:24">pilatides.<verse eid="GEN 49:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="GEN 49:25" />Nena maaddiza ne aawa Xoossan</para>
  <para style="q2" vid="GEN 49:25">Ubbaa Dandayzayssaninne</para>
  <para style="q2" vid="GEN 49:25">nena anjjiza Xoossan</para>
  <para style="q2" vid="GEN 49:25">pude bollafe beettiza maadoninne</para>
  <para style="q2" vid="GEN 49:25">garsa biittafe beettizan anjjon</para>
  <para style="q2" vid="GEN 49:25">qasseka aayi uloppenne</para>
  <para style="q2" vid="GEN 49:25">dhanththafe beettiza anjjon</para>
  <para style="q2" vid="GEN 49:25">nena anjjana.<verse eid="GEN 49:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="GEN 49:26" />Ne aawa anjjoy beni wodeppe</para>
  <para style="q2" vid="GEN 49:26">hanno gakkanaas</para>
  <para style="q2" vid="GEN 49:26">minni diza zumatappenne</para>
  <para style="q2" vid="GEN 49:26">mernaa zumata</para>
  <para style="q2" vid="GEN 49:26">ubbaafe aadhdhees.</para>
  <para style="q2" vid="GEN 49:26">Hessa gishshas hayssi</para>
  <para style="q2" vid="GEN 49:26">ha anjjoy wurikka Yooseefe gakko.</para>
  <para style="q2" vid="GEN 49:26">Ba ishata bolla halaqa gidida</para>
  <para style="q2" vid="GEN 49:26">Yooseefe bolla wodhdho.<verse eid="GEN 49:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="GEN 49:27" />«Biniyaamey bonqqiza</para>
  <para style="q2" vid="GEN 49:27">kana suyte mala.</para>
  <para style="q2" vid="GEN 49:27">Ba shankkatidayssa</para>
  <para style="q2" vid="GEN 49:27">maalado mees;</para>
  <para style="q2" vid="GEN 49:27">ba di7idayssa</para>
  <para style="q2" vid="GEN 49:27">omars gishereththees» gides.<verse eid="GEN 49:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 49:28" />Hayti tammanne nam7u Isra7eele qommota; qasse istta aaway istta issaa issaa istta hano mala isttas bessiza anjjo hessaththo anjjides.<verse eid="GEN 49:28" /></para>
  <para style="s1">Yaaqoobe Hayqo</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29" />Hessafe guye izi isttas, «Tani ta aawatan gaaggana gays; tana Hiite as Efroone gaden diza gongolon, ta aawatara moogite. <verse eid="GEN 49:29" /><verse number="30" style="v" sid="GEN 49:30" />Hessika Kanaane biittan, Mamire achchan diza Makipheele geetettiza gongolo; hayssika Abrahaamey moogos Hiite as Efrooneppe gadaara gaththi shammida gongolo.<note caller="-" style="x"><char style="xo" closed="false">49:30 </char><char style="xt" closed="false"><ref loc="GEN 23:3-20">Medhe 23:3-20</ref></char></note> <verse eid="GEN 49:30" /><verse number="31" style="v" sid="GEN 49:31" />Abrahaameynne iza machcheya Saaray heen moogettida; Yisaaqinne iza machcheya Irbiqaykka heen moogettida; tani qasse Liya heen moogadis.<note caller="-" style="x"><char style="xo" closed="false">49:31 </char><char style="xt" closed="false"><ref loc="GEN 25:9-10">Medhe 25:9-10</ref>; <ref loc="GEN 35:29">35:29</ref></char></note> <verse eid="GEN 49:31" /><verse number="32" style="v" sid="GEN 49:32" />He gadezinne izan diza gongoloy Hiitetappe shamettidayssa» gi azazides.<verse eid="GEN 49:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 49:33" />Yaaqoobey ba naytas azazo wursidaappe guye ba toho pude ba hiixan shiishshi ekkidi hayqqidi ba aawatan gaaggides.<note caller="-" style="x"><char style="xo" closed="false">49:33 </char><char style="xt" closed="false"><ref loc="ACT 7:15">Hawa 7:15</ref></char></note><verse eid="GEN 49:33" /></para>
  <chapter eid="GEN 49" />
  <chapter number="50" style="c" sid="GEN 50" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1" />Yooseefey ba aawaa aha bolla kundidi yeekkidessinne iza yeerides. <verse eid="GEN 50:1" /><verse number="2" style="v" sid="GEN 50:2" />Hessafe guye Yooseefey dhale shiishshiza ba oosanchchata ba aawa Isra7eele aha sawiza shitto tiydi melissana mala azaziin istti tiydi melissida. <verse eid="GEN 50:2" /><verse number="3" style="v" sid="GEN 50:3" />Shitto tiyoy xalla 40 gallas kumeth wursides; ays giikko hayssi tiyoy wonakka oyddu tammu gallas ekkees. Gibxe asati izas laappun tammu gallas yeekkida.<verse eid="GEN 50:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 50:4" />Yeeho gallassati aadhdhiin Yooseefey Gibxe kawo keeththaa asata, «Tani intte sinththan sabettidaa gidikko kawos hizgi yootite; <verse eid="GEN 50:4" /><verse number="5" style="v" sid="GEN 50:5" />Ta aaway tana issi caaqo caaqisides; izi tana, ‹Tani hayqqana hanays; tani taas Kanaane biittan woocida gongolo duufon tana mooga› gides. Hessa gishshas, ‹Ha7i tani pude baada ta aawa moogana mala yeddarkkii! Hessafe guye tani simmana› » gides.<note caller="-" style="x"><char style="xo" closed="false">50:5 </char><char style="xt" closed="false"><ref loc="GEN 47:29-31">Medhe 47:29-31</ref></char></note><verse eid="GEN 50:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 50:6" />Histtiin kawoy, «Izi nena caaqisida mala pude baada ne aawa mooga» gides.<verse eid="GEN 50:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 50:7" />Yooseefey ba aawa mooganaas pude bides. Kawoza oosanchchati wuri, iza kawoteththa keeththan diza gita asay wuri Gibxe biittan diza gita asay wuri Yooseefe kaallidi bides. <verse eid="GEN 50:7" /><verse number="8" style="v" sid="GEN 50:8" />Qasse Yooseefe soo asay wuri iza ishatinne iza aawa soo asay izara biin; istta naytinne mehey xalla Geesemen attida. <verse eid="GEN 50:8" /><verse number="9" style="v" sid="GEN 50:9" />Para-gaaretikka toga asaykka izara pude bides; iza kaallidi bida asay keehi daro.<verse eid="GEN 50:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 50:10" />Istti Yordaanoose shaafaa achchan diza Axaade geetettiza bale gakkidi ba qaalaa dhoqqu histtidi izas zilalidanne yeekkida; heen Yooseefey ba aawa yeehon laappun gallas uttides. <verse eid="GEN 50:10" /><verse number="11" style="v" sid="GEN 50:11" />He biittan diza Kanaane asati Axaade geetettiza yeeho balen he yeehoza be7idi, «Gibxe asay ay misha yeeho yeekkizoo!» gida. Hessa gishshas Yordaanoose achchan diza he soy, Gibxeta yeeho geetettides.<verse eid="GEN 50:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 50:12" />Yaaqoobe nayti ba aaway istta azazida mala ooththida; <verse eid="GEN 50:12" /><verse number="13" style="v" sid="GEN 50:13" />Iza ahaa Kanaane biitta efidi Mamire achchan diza Makipheele geetettiza gongolon, Abrahaamey Hiite as Efrooneppe moogos shammida gaden iza moogida.<note caller="-" style="x"><char style="xo" closed="false">50:13 </char><char style="xt" closed="false"><ref loc="ACT 7:16">Hawa 7:16</ref></char></note> <verse eid="GEN 50:13" /><verse number="14" style="v" sid="GEN 50:14" />Yooseefey ba aawa moogidaappe guye, ba ishatanne iza aawa mooganaas izara bida hara asata ubbaara Gibxe simmides.<verse eid="GEN 50:14" /></para>
  <para style="s1">Yooseefey Ba Ishata Woppisides</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15" />Istta aaway hayqqidayssa be7idi, Yooseefe ishati ba garsan, «Ooni erizee Yooseefey nuna ba ulon morkkidi nuni izas ooththida iita miish ubbaas halo kessana koykko, nuni waananee?» gida. <verse eid="GEN 50:15" /><verse number="16" style="v" sid="GEN 50:16" />Hessa gishshas Yooseefekko kiita, «Ne aaway hayqqanaappe kase; <verse eid="GEN 50:16" /><verse number="17" style="v" sid="GEN 50:17" />Intte Yooseefe, ‹Neni ne ishata nagaranne istti nena qohida iita qohoza hayyana atto ga› giidi yootite gides. Hessa gishshas ha7i hayyana, nu nagaraa, ne aawa Xoossa aylleta nagaraa atto ga» gida. He kiitay izakko gakkiin, Yooseefey yeekkides.<verse eid="GEN 50:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 50:18" />Hessafe guye iza ishati barkka izakko biidi iza sinththan gufannidi, «Nuni ne aylleta» gida.<verse eid="GEN 50:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 50:19" />Gido attiin Yooseefey isttas, «Babbofte; tana inttes Xoossa gidetiyee? <verse eid="GEN 50:19" /><verse number="20" style="v" sid="GEN 50:20" />Intte taas iitanaas ooththideta shin hayssi daro asay hayqqontta attana mala Xoossi lo7os hayssa ooththides. <verse eid="GEN 50:20" /><verse number="21" style="v" sid="GEN 50:21" />Hessa gishshas hekko intte babofte; tani inttenanne intte nayta mizana» giidi, izi istta minththeththidi lo7o qaalan haasayides.<verse eid="GEN 50:21" /></para>
  <para style="s1">Yooseefe Hayqo</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22" />Yooseefey ba aawa soo asaa ubbaara Gibxen gam7ides; izi 110 layth de7ides. <verse eid="GEN 50:22" /><verse number="23" style="v" sid="GEN 50:23" />Efreeme nayta, heedzdzanththo yeleta gakkanaas be7ides; qasse Minaase naa Maakire naytakka izi ba naa mala histtides.<verse eid="GEN 50:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 50:24" />Hessafe guye Yooseefey ba ishata, «Tani hayqqana gays; gido attiin Xoossi inttena maaddanaas tumu wochchana; izi inttena ha biittafe kessidi Abrahaames, Yisaaqassinne Yaaqoobes immana giidi caaqqida biittaa zaari efana» gides. <verse eid="GEN 50:24" /><verse number="25" style="v" sid="GEN 50:25" />Yooseefey Isra7eele nayta, «Xoossi inttena maaddanaas tumu xomosiza wode, intte ta meqeththa ha biittafe pude ekki biite» giidi caaqechides.<note caller="-" style="x"><char style="xo" closed="false">50:25 </char><char style="xt" closed="false"><ref loc="EXO 13:19">Kessa 13:19</ref>; <ref loc="JOS 24:32">Iya 24:32</ref>; <ref loc="HEB 11:22">Ib 11:22</ref></char></note><verse eid="GEN 50:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 50:26" />Yooseefey 110 layth de7idi hayqqiin, istti shitton iza aha tiydi melissidaappe guye Gibxe biittan wongire giddon woththida.<verse eid="GEN 50:26" /></para>
  <chapter eid="GEN 50" />
</usx>