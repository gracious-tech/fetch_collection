<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="OBA" style="id">- Gamo Full Bible final version</book>
  <para style="h">Abdiyu Tinbite</para>
  <para style="toc1">Abdiyu Tinbite</para>
  <para style="toc2">Abdiyu Tinbite</para>
  <para style="toc3">Ab</para>
  <para style="mt1">Abdiyu Tinbite</para>
  <para style="imt1">Giddo Qofa</para>
  <para style="ip">Hayssi guuththa maxaafazi beettiday Kirstoosi yelettanaappe kase 586 layththan Yerusalaamey laalettidaappe guye qonccen erettontta wodenna. He wode arshey mokkiza dugeha baggara diza Yuhudas adussa wodeesofe morkke gidida Eedoome asay Yerusalaame laaleteththan ufayettidi biitta oli oykkizayta maaddishe katamay haaro ubbaa bonqqees; Abdiyuy Eedoome asaa, hankko Isra7eele morkketara issi bolla mino qixaateynne xooneteththi gakkanayssa kaseti yootides.</para>
  <para style="iot">Ha Maxaafay Oykkida Kumeththa Qofa</para>
  <para style="io1">Eedoome otoreteththinne qixaate <char style="ior"><ref loc="OBA 1:1-9">1-9</ref> </char></para>
  <para style="io1">Eedoome menxe iitateth <char style="ior"><ref loc="OBA 1:10-14">10-14</ref> </char></para>
  <para style="io1">Isra7eele xoono <char style="ior"><ref loc="OBA 1:15-21">15-21</ref> </char></para>
  <chapter number="1" style="c" sid="OBA 1" />
  <para style="s1">Nabe Abdiyuy Beyida Ajjuuta</para>
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1" />Abdiyuy be7ida ajjuuta;</para>
  <para style="q1" vid="OBA 1:1">GODAY Eedoome gishshas</para>
  <para style="q2" vid="OBA 1:1">Abdiyu kiittides;</para>
  <para style="q2" vid="OBA 1:1">nu siyida Xoossa kiitay,</para>
  <para style="q2" vid="OBA 1:1">«Tani Xoossay Eedoome bolla</para>
  <para style="q2" vid="OBA 1:1">meto gaththana mala azazada</para>
  <para style="q2" vid="OBA 1:1">deraa giddo as kiittadis» gees.<verse eid="OBA 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="OBA 1:2" />GODAY Eedoomes,</para>
  <para style="q1" vid="OBA 1:2">«Ta nena dere asaappe laafisana;</para>
  <para style="q2" vid="OBA 1:2">neni as ubbaan</para>
  <para style="q2" vid="OBA 1:2">leqettidaaz gidana.<verse eid="OBA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3" />Nenoo zaalla gomppan dizayssoo!</para>
  <para style="q2" vid="OBA 1:3">Ne duussaso dhoqqasohon</para>
  <para style="q2" vid="OBA 1:3">keexxidayssoo!</para>
  <para style="q2" vid="OBA 1:3">‹Ta dizasoppe tana ziqqaso</para>
  <para style="q2" vid="OBA 1:3">woththana dandayzay oonee?›</para>
  <para style="q2" vid="OBA 1:3">gizayssoo!</para>
  <para style="q2" vid="OBA 1:3">Ne wozina otoroteththi</para>
  <para style="q2" vid="OBA 1:3">nena baleththides.<verse eid="OBA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4" />Ne golle kafo mala</para>
  <para style="q2" vid="OBA 1:4">keeha pude piradhdhikokka,</para>
  <para style="q2" vid="OBA 1:4">ne keeth xoolintte giddon</para>
  <para style="q2" vid="OBA 1:4">keexxikokka</para>
  <para style="q2" vid="OBA 1:4">ta nena heeppe</para>
  <para style="q2" vid="OBA 1:4">haa duge woththana.<verse eid="OBA 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5" />«Kaysoti woykko bonqqizayti</para>
  <para style="q2" vid="OBA 1:5">omars yiikko</para>
  <para style="q2" vid="OBA 1:5">baas gidizayssa ekkeettes;</para>
  <para style="q2" vid="OBA 1:5">Kath maxizayti piixe ashsheettes;</para>
  <para style="q2" vid="OBA 1:5">gido attiin ne morkketi</para>
  <para style="q2" vid="OBA 1:5">issinokka ashshettenna.<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="fqa" closed="false">Piixe: </char><char style="ft" closed="false">Piixe geetettizayssi amaraththo qaalan qaarmiya geetettees.</char></note><verse eid="OBA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6" />Intteno Eesawe zereththatoo!</para>
  <para style="q2" vid="OBA 1:6">Intte keeth bonqqettides;</para>
  <para style="q2" vid="OBA 1:6">hekko intte haaroy wuri</para>
  <para style="q2" vid="OBA 1:6">bogettides.<verse eid="OBA 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7" />Nenara caaqettida laggeti</para>
  <para style="q2" vid="OBA 1:7">nena baleththida;</para>
  <para style="q2" vid="OBA 1:7">nena dosiza laggeti</para>
  <para style="q2" vid="OBA 1:7">ne bolla morkketeththan dendida;</para>
  <para style="q2" vid="OBA 1:7">ne kath midayti nees yarde</para>
  <para style="q2" vid="OBA 1:7">woththidi nena</para>
  <para style="q2" vid="OBA 1:7">ne dereppe gooddida;</para>
  <para style="q2" vid="OBA 1:7">gido attiin istti hessa ne bolla</para>
  <para style="q2" vid="OBA 1:7">ooththishin neni erabeekka.<verse eid="OBA 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8" />«He wode Eedoomeppe</para>
  <para style="q2" vid="OBA 1:8">aadho eranchchata,</para>
  <para style="q2" vid="OBA 1:8">Eesawe zumaappe</para>
  <para style="q2" vid="OBA 1:8">erateth dhayssana.<verse eid="OBA 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9" />Eedoome deren de7iza</para>
  <para style="q2" vid="OBA 1:9">asati wurikka hayqqana;</para>
  <para style="q2" vid="OBA 1:9">Temaane oliza wolqqama</para>
  <para style="q2" vid="OBA 1:9">olanchchati babbana.<verse eid="OBA 1:9" /></para>
  <para style="s1">Xoossay Eedoome Qaxxayiza Gaaso</para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10" />«Ne isha Yaaqoobe zereththata</para>
  <para style="q2" vid="OBA 1:10">neni gene wodhida gishshas</para>
  <para style="q2" vid="OBA 1:10">ne kawuyada mernaas dhayana.<verse eid="OBA 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11" />Yerusalaame morkketi</para>
  <para style="q2" vid="OBA 1:11">penge menththidi</para>
  <para style="q2" vid="OBA 1:11">haarida miish ubbaa</para>
  <para style="q2" vid="OBA 1:11">bonqqiza wode</para>
  <para style="q2" vid="OBA 1:11">neni lanqera eqqa xeelladasa;</para>
  <para style="q2" vid="OBA 1:11">hessa gishshas Yerusalaame bolla</para>
  <para style="q2" vid="OBA 1:11">saama yeggi gishetti</para>
  <para style="q2" vid="OBA 1:11">ekkidaytappe</para>
  <para style="q2" vid="OBA 1:11">neni dummatakka.<verse eid="OBA 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12" />Yuhuda deren de7iza ishata bolla</para>
  <para style="q2" vid="OBA 1:12">gakkida meton neni ufayettana</para>
  <para style="q2" vid="OBA 1:12">koshshennashin ufayettadasa;</para>
  <para style="q2" vid="OBA 1:12">qasse istta dhayoninne meton</para>
  <para style="q2" vid="OBA 1:12">ufayettananne otorettana</para>
  <para style="q2" vid="OBA 1:12">nees bessennashin otorettadasa.<verse eid="OBA 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13" />Ta derey dhayza gallas</para>
  <para style="q2" vid="OBA 1:13">istta pengera</para>
  <para style="q2" vid="OBA 1:13">neni gelana bessennashin;</para>
  <para style="q2" vid="OBA 1:13">istti dhayza gallas metotishin</para>
  <para style="q2" vid="OBA 1:13">neni ufayettana bessennashin;</para>
  <para style="q2" vid="OBA 1:13">qasseka istti dhayza gallas</para>
  <para style="q2" vid="OBA 1:13">ne istta haaro</para>
  <para style="q2" vid="OBA 1:13">boggana nees bessennashin.<verse eid="OBA 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14" />Goodettidi qotettidayta wodhana</para>
  <para style="q2" vid="OBA 1:14">ne oyddu oge bolla</para>
  <para style="q2" vid="OBA 1:14">naagana bessennashin naagadasa;</para>
  <para style="q2" vid="OBA 1:14">qasse attida asata</para>
  <para style="q2" vid="OBA 1:14">meto gallas ne aaththa</para>
  <para style="q2" vid="OBA 1:14">immanaas bessennashin</para>
  <para style="q2" vid="OBA 1:14">immadasa.<note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="ISA 34:5-17">Isa 34:5-17</ref>; <ref loc="ISA 63:1-6">63:1-6</ref>; <ref loc="JER 49:7-22">Er 49:7-22</ref>; <ref loc="EZK 25:12-14">Hizi 25:12-14</ref>; <ref loc="EZK 35:1-15">35:1-15</ref>; <ref loc="AMO 1:11-12">Amo 1:11-12</ref>; <ref loc="MAL 1:2-5">Mil 1:2-5</ref></char></note><verse eid="OBA 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15" />«Ta Xoossay asa ubbaa bolla</para>
  <para style="q2" vid="OBA 1:15">pirdiza wodey gakkida gishshas</para>
  <para style="q2" vid="OBA 1:15">Eedoomee! Ne ooththida</para>
  <para style="q2" vid="OBA 1:15">iita oosoy</para>
  <para style="q2" vid="OBA 1:15">ne bolla simmana;</para>
  <para style="q2" vid="OBA 1:15">hessa gishshas ne ooso mala</para>
  <para style="q2" vid="OBA 1:15">ne ekkana.<verse eid="OBA 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16" />Anjjettida ta zuma bolla</para>
  <para style="q2" vid="OBA 1:16">intte waaye ushshu uyida mala</para>
  <para style="q2" vid="OBA 1:16">intte yuushon diza hankko derey</para>
  <para style="q2" vid="OBA 1:16">waaye ushshu uyana;</para>
  <para style="q2" vid="OBA 1:16">uyidayti wurikka dhayana.<verse eid="OBA 1:16" /></para>
  <para style="s1">Isra7eele Dere Xoono</para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17" />«Xiyoone zuman metoppe</para>
  <para style="q2" vid="OBA 1:17">attanay daana;</para>
  <para style="q2" vid="OBA 1:17">he zumayakka geesh gidana;</para>
  <para style="q2" vid="OBA 1:17">Yaaqoobe derey bonqqettida</para>
  <para style="q2" vid="OBA 1:17">ba haaro zaari ekkana.<verse eid="OBA 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18" />Yaaqoobe zereththati tama mala,</para>
  <para style="q2" vid="OBA 1:18">Yooseefe zereththati</para>
  <para style="q2" vid="OBA 1:18">tama laco mala gidiin</para>
  <para style="q2" vid="OBA 1:18">Eesawe zereththati</para>
  <para style="q2" vid="OBA 1:18">uttula mala gidana;</para>
  <para style="q2" vid="OBA 1:18">tamay uttula miza mala</para>
  <para style="q2" vid="OBA 1:18">Yaaqoobe zereththatinne</para>
  <para style="q2" vid="OBA 1:18">Yooseefe zereththati</para>
  <para style="q2" vid="OBA 1:18">Eesawe zereththata dhayssana.<verse eid="OBA 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19" />«Yuhuda dereppe</para>
  <para style="q2" vid="OBA 1:19">dugeha baggara diza</para>
  <para style="q2" vid="OBA 1:19">Negebe asay Eedoome</para>
  <para style="q2" vid="OBA 1:19">biitta laattana;</para>
  <para style="q2" vid="OBA 1:19">arshey wulliza baggara</para>
  <para style="q2" vid="OBA 1:19">gadhan diza asati</para>
  <para style="q2" vid="OBA 1:19">Filisxeeme, Efreemenne</para>
  <para style="q2" vid="OBA 1:19">Samaariya biitta laattana;</para>
  <para style="q2" vid="OBA 1:19">qasse Biniyaame zereththati</para>
  <para style="q2" vid="OBA 1:19">Gala7aade biitta laattana.<verse eid="OBA 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20" />Beti bida Isra7eele asay</para>
  <para style="q2" vid="OBA 1:20">Alahe geetettiza</para>
  <para style="q2" vid="OBA 1:20">dereppe simmidi</para>
  <para style="q2" vid="OBA 1:20">Kanaane biittafe</para>
  <para style="q2" vid="OBA 1:20">Sirafta gakkanaas</para>
  <para style="q2" vid="OBA 1:20">diza biitta laattana;</para>
  <para style="q2" vid="OBA 1:20">bete biidi Sirafta deren diza</para>
  <para style="q2" vid="OBA 1:20">Isra7eele asay</para>
  <para style="q2" vid="OBA 1:20">Negeben diza katamata laattana.<verse eid="OBA 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21" />Attida Isra7eele asati</para>
  <para style="q2" vid="OBA 1:21">Xiyoone zumaa bolla uttidi</para>
  <para style="q2" vid="OBA 1:21">Eedoome dere ayssana;</para>
  <para style="q2" vid="OBA 1:21">qasse kawoteththayka</para>
  <para style="q2" vid="OBA 1:21">Xoossas gidana» gi yootides.<verse eid="OBA 1:21" /></para>
  <chapter eid="OBA 1" />
</usx>