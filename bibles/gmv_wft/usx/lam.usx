<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LAM" style="id">- Gamo Full Bible final version</book>
  <para style="h">Ermaasa zilas</para>
  <para style="toc1">Ermaasa zilas</para>
  <para style="toc2">Ermaasa zilas</para>
  <para style="toc3">Er Zila</para>
  <para style="mt1">Ermaasa Zilas</para>
  <para style="imt1">Giddo Qofa</para>
  <para style="ip">Ermaasa zilasi Kirstoosi yelettanaappe kase 586 layththan Yerusalaamey laalettida gishshassinne derey goodettida gishshas ichchashu zilassa ginxota shiishshi oykkides; ha maxaafan dariza baggay yeeho gishshassinne kayoteththa gishshas yootizaa gidikkoka asi Xoossan ammanettana gishshassinne hidota qanxxontta daana mala tamaarsiza ginxo kifileykka izan dees; hayti zilasati ayhuda asay Kirstoosi yelettanaappe kase 586 layththan deraa bolla gakkida bashshaa yuushshi qoppana mala layththan layththan xoomaninne kayoteththan Xoossa goyno wogata istti poliza gallassatan go7etteettes.</para>
  <para style="iot">Ha Maxaafay Oykkida Kumeththa Qofa</para>
  <para style="io1">Koyro zilas: Yerusalaame waayenne kayoteth <char style="ior"><ref loc="LAM 1:1-22">1:1-22</ref> </char></para>
  <para style="io1">Nam7anththo zilas: Xoossi Yerusalaame bolla yeggida qixaate <char style="ior"><ref loc="LAM 2:1-12">2:1-12</ref> </char></para>
  <para style="io1">Heedzdzanththo zilas: Sinththafe yaana hidota <char style="ior"><ref loc="LAM 3:1-66">3:1-66</ref> </char></para>
  <para style="io1">Oydanththo zilas: Yerusalaame dhayo <char style="ior"><ref loc="LAM 4:1-22">4:1-22</ref> </char></para>
  <para style="io1">Ichchashanththo zilas: Maaroteth demmanaas woosa <char style="ior"><ref loc="LAM 5:1-22">5:1-22</ref> </char></para>
  <chapter number="1" style="c" sid="LAM 1"/>
  <para style="s1">Yerusalaame Waayenne Kayo</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 1:1"/>Kase izin daro kawoteththay</para>
  <para style="q2" vid="LAM 1:1">diza katamaya</para>
  <para style="q2" vid="LAM 1:1">waanada oletta attadee!</para>
  <para style="q2" vid="LAM 1:1">Dereta giddon kase gita gididaara</para>
  <para style="q2" vid="LAM 1:1">waanada am7i mala gidadee!</para>
  <para style="q2" vid="LAM 1:1">Awuraajjata garsan</para>
  <para style="q2" vid="LAM 1:1">godatto gididaara</para>
  <para style="q2" vid="LAM 1:1">ha7i waanada aylle gidadee!<verse eid="LAM 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2"/>Iza giddoththi</para>
  <para style="q2" vid="LAM 1:2">camo yeeho yeekkawus;</para>
  <para style="q2" vid="LAM 1:2">izis afunththayka</para>
  <para style="q2" vid="LAM 1:2">shagalara goggees;</para>
  <para style="q2" vid="LAM 1:2">izi laggetappe izo</para>
  <para style="q2" vid="LAM 1:2">minththeththizay</para>
  <para style="q2" vid="LAM 1:2">oonikka deenna;</para>
  <para style="q2" vid="LAM 1:2">ubbatikka izo kaddida;</para>
  <para style="q2" vid="LAM 1:2">zaaridikka izis morkke gidida.<verse eid="LAM 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3"/>Yuhuday daro waayettidaappenne</para>
  <para style="q2" vid="LAM 1:3">tooshettidaappe guye di7ettadus;</para>
  <para style="q2" vid="LAM 1:3">iza kawoteththata</para>
  <para style="q2" vid="LAM 1:3">giddon uttadus;</para>
  <para style="q2" vid="LAM 1:3">izis shempizasoykka dhaydes;</para>
  <para style="q2" vid="LAM 1:3">iza meto garsan dishin</para>
  <para style="q2" vid="LAM 1:3">gooddizayti ubbay izo demmida.<verse eid="LAM 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4"/>Oonikka izi ba7aaleta</para>
  <para style="q2" vid="LAM 1:4">bonchchanaas</para>
  <para style="q2" vid="LAM 1:4">yontta gishshas</para>
  <para style="q2" vid="LAM 1:4">Xiyoone ogeti yeekkeettes;</para>
  <para style="q2" vid="LAM 1:4">izi pengetara gelizaynne</para>
  <para style="q2" vid="LAM 1:4">kezizay deenna;</para>
  <para style="q2" vid="LAM 1:4">izi qeeseti ceeceettes;</para>
  <para style="q2" vid="LAM 1:4">geela7otikka muuzotteettes;</para>
  <para style="q2" vid="LAM 1:4">izakka gita meto</para>
  <para style="q2" vid="LAM 1:4">garsan tuggatawus.<verse eid="LAM 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5"/>Izi nagaray daro gidida gaason</para>
  <para style="q2" vid="LAM 1:5">GODAY izi bolla meto yeggides;</para>
  <para style="q2" vid="LAM 1:5">izi morkketi izo haarida;</para>
  <para style="q2" vid="LAM 1:5">izi naytikka morkketan di7ettida;</para>
  <para style="q2" vid="LAM 1:5">izi morkketas duussi lo7ides.<verse eid="LAM 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6"/>Xiyoone macca nayppe</para>
  <para style="q2" vid="LAM 1:6">izi puulateththinne teemay</para>
  <para style="q2" vid="LAM 1:6">shaaketti kichchides;</para>
  <para style="q2" vid="LAM 1:6">izi daannati maata</para>
  <para style="q2" vid="LAM 1:6">mizasoy dhayda</para>
  <para style="q2" vid="LAM 1:6">genessa mala gidida;</para>
  <para style="q2" vid="LAM 1:6">istti bana gooddizaytappe</para>
  <para style="q2" vid="LAM 1:6">wolqqay wuriin baqatida.<verse eid="LAM 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7"/>Yerusalaamey metotida wodeninne</para>
  <para style="q2" vid="LAM 1:7">waayettida gallassatan</para>
  <para style="q2" vid="LAM 1:7">kase izis diza aqota</para>
  <para style="q2" vid="LAM 1:7">yuushsha qoppawus;</para>
  <para style="q2" vid="LAM 1:7">iza morkke kushen</para>
  <para style="q2" vid="LAM 1:7">kundida wode</para>
  <para style="q2" vid="LAM 1:7">izo maaddizay</para>
  <para style="q2" vid="LAM 1:7">oonikka baynda wode,</para>
  <para style="q2" vid="LAM 1:7">izi morkketi izi kundeththaa</para>
  <para style="q2" vid="LAM 1:7">be7idi izi bolla miiccida.<verse eid="LAM 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8"/>Yerusalaamey daro deexo</para>
  <para style="q2" vid="LAM 1:8">nagara ooththadus;</para>
  <para style="q2" vid="LAM 1:8">kadheska attadus;</para>
  <para style="q2" vid="LAM 1:8">iza kallo dishin be7ida gishshas</para>
  <para style="q2" vid="LAM 1:8">kase izo bonchchidayti ubbay</para>
  <para style="q2" vid="LAM 1:8">izo kadhida;</para>
  <para style="q2" vid="LAM 1:8">izakka ba baggara yeellatada</para>
  <para style="q2" vid="LAM 1:8">biitta xeellashe guye simmadus.<verse eid="LAM 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9"/>Izi tunateththi</para>
  <para style="q2" vid="LAM 1:9">izi may7o bolla beettides;</para>
  <para style="q2" vid="LAM 1:9">sinththafe izi bolla hananayssa</para>
  <para style="q2" vid="LAM 1:9">iza qoppabeekku;</para>
  <para style="q2" vid="LAM 1:9">izi kundeththi</para>
  <para style="q2" vid="LAM 1:9">daganththizaaz gidides;</para>
  <para style="q2" vid="LAM 1:9">iza, «Ta Godaa Xoossoo!</para>
  <para style="q2" vid="LAM 1:9">Ta metotiza metoza be7a;</para>
  <para style="q2" vid="LAM 1:9">ta morkketi tana xoonida»</para>
  <para style="q2" vid="LAM 1:9">ga woossiinkka</para>
  <para style="q2" vid="LAM 1:9">izo minththeththizay</para>
  <para style="q2" vid="LAM 1:9">oonikka beettibeenna.<verse eid="LAM 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10"/>Izi aqota ubbaa bolla</para>
  <para style="q2" vid="LAM 1:10">morkkey ba kushe yeddides;</para>
  <para style="q2" vid="LAM 1:10">Xoossa asaa shiiqon</para>
  <para style="q2" vid="LAM 1:10">gelontta mala neni diggidayti</para>
  <para style="q2" vid="LAM 1:10">eeqa xoossatas</para>
  <para style="q2" vid="LAM 1:10">goynniza ayzaabeti</para>
  <para style="q2" vid="LAM 1:10">gede izi Xoossa Keeththan</para>
  <para style="q2" vid="LAM 1:10">gelishin be7adus.<verse eid="LAM 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11"/>Izi asay miza kath demmanaas</para>
  <para style="q2" vid="LAM 1:11">koshshan daaburees;</para>
  <para style="q2" vid="LAM 1:11">shemppora paxa daanaas</para>
  <para style="q2" vid="LAM 1:11">baas diza</para>
  <para style="q2" vid="LAM 1:11">aqota maana kaththara</para>
  <para style="q2" vid="LAM 1:11">laammeettes;</para>
  <para style="q2" vid="LAM 1:11">Yerusalaame asay, «Abeet GODAWU!</para>
  <para style="q2" vid="LAM 1:11">Nuni kawuyidos;</para>
  <para style="q2" vid="LAM 1:11">nuna xeellada nuus qoppa.<verse eid="LAM 1:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12"/>«Godaa Xoossi</para>
  <para style="q2" vid="LAM 1:12">ba wolqqama hanqoza</para>
  <para style="q2" vid="LAM 1:12">nu bolla yeddida wode</para>
  <para style="q2" vid="LAM 1:12">nu bolla gakkida meto mala</para>
  <para style="q2" vid="LAM 1:12">metoy gakkida asi dizaa gidikko</para>
  <para style="q2" vid="LAM 1:12">intteno ogera aadhdhi biza</para>
  <para style="q2" vid="LAM 1:12">ubbato ane be7ite!</para>
  <para style="q2" vid="LAM 1:12">Ha metoy inttes</para>
  <para style="q2" vid="LAM 1:12">kawushsha misatizee?<verse eid="LAM 1:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13"/>«Izi bolla dhoqqasohoppe</para>
  <para style="q2" vid="LAM 1:13">tama yeddides;</para>
  <para style="q2" vid="LAM 1:13">he tamazikka nuus</para>
  <para style="q2" vid="LAM 1:13">meqeththan gelides;</para>
  <para style="q2" vid="LAM 1:13">nu tohota qachchanaas</para>
  <para style="q2" vid="LAM 1:13">gite yeggides;</para>
  <para style="q2" vid="LAM 1:13">histtidi nuna</para>
  <para style="q2" vid="LAM 1:13">guye zaari kundisides;</para>
  <para style="q2" vid="LAM 1:13">kumeththa gallas</para>
  <para style="q2" vid="LAM 1:13">nuna daaburssides;</para>
  <para style="q2" vid="LAM 1:13">coo melakka toylasides.<verse eid="LAM 1:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14"/>«Ta nagara shiishshi qachchidi</para>
  <para style="q2" vid="LAM 1:14">ta morgen woththides;</para>
  <para style="q2" vid="LAM 1:14">ta wolqqaka wursides;</para>
  <para style="q2" vid="LAM 1:14">tani eqettanaas</para>
  <para style="q2" vid="LAM 1:14">dandayontta morkketas</para>
  <para style="q2" vid="LAM 1:14">GODAY tana aaththi immides.<verse eid="LAM 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15"/>«Nu garsan diza olanchchata</para>
  <para style="q2" vid="LAM 1:15">ubbatara Xoossi eqettides;</para>
  <para style="q2" vid="LAM 1:15">nu giddofe yelagata dhayssanaas</para>
  <para style="q2" vid="LAM 1:15">olanchchata nu bolla yeddides.</para>
  <para style="q2" vid="LAM 1:15">Woyne miththa ayfe</para>
  <para style="q2" vid="LAM 1:15">ushshu kessanaas</para>
  <para style="q2" vid="LAM 1:15">yedhdhiza mala</para>
  <para style="q2" vid="LAM 1:15">GODAY boshettontta</para>
  <para style="q2" vid="LAM 1:15">geela7o misatiza</para>
  <para style="q2" vid="LAM 1:15">Yuhuda asaa yedhides.<verse eid="LAM 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16"/>«Morkkey nu bolla goobides;</para>
  <para style="q2" vid="LAM 1:16">nu naytikka barkka attida;</para>
  <para style="q2" vid="LAM 1:16">nuna zori minththeththizayti</para>
  <para style="q2" vid="LAM 1:16">nuuppe haakkida;</para>
  <para style="q2" vid="LAM 1:16">hessa gishshas ta yeekkayssinne</para>
  <para style="q2" vid="LAM 1:16">afunththa gussays.<verse eid="LAM 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 1:17"/>Xiyoona ba kushe miccadus;</para>
  <para style="q2" vid="LAM 1:17">izo minththeththizaadey deenna;</para>
  <para style="q2" vid="LAM 1:17">Yaaqoobe zaretas shooroti</para>
  <para style="q2" vid="LAM 1:17">izas morkke gidana mala</para>
  <para style="q2" vid="LAM 1:17">Xoossi azazo kessides;</para>
  <para style="q2" vid="LAM 1:17">Yerusalaameykka istta giddon</para>
  <para style="q2" vid="LAM 1:17">tuna miishsha mala qoodettadus.<verse eid="LAM 1:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18"/>«Xoossi xillo;</para>
  <para style="q2" vid="LAM 1:18">tani gidikko</para>
  <para style="q2" vid="LAM 1:18">iza azazo bolla makkalladis;</para>
  <para style="q2" vid="LAM 1:18">intte wurikka siyite;</para>
  <para style="q2" vid="LAM 1:18">ta metozakka xeellite;</para>
  <para style="q2" vid="LAM 1:18">macca naytinne</para>
  <para style="q2" vid="LAM 1:18">naateththa attuma nayti</para>
  <para style="q2" vid="LAM 1:18">taappe di7etti bida.<verse eid="LAM 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 1:19"/>Tani ta dosizayta xeygadis;</para>
  <para style="q2" vid="LAM 1:19">istti gidikko tana kaddida;</para>
  <para style="q2" vid="LAM 1:19">ta qeesetinne cimati</para>
  <para style="q2" vid="LAM 1:19">ba shemppo ashshanaas</para>
  <para style="q2" vid="LAM 1:19">kath koyishe</para>
  <para style="q2" vid="LAM 1:19">katamay giddon wurida.<verse eid="LAM 1:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20"/>«Abeet GODAWU!</para>
  <para style="q2" vid="LAM 1:20">Ta waayeza be7a!</para>
  <para style="q2" vid="LAM 1:20">ta giddo asateththay metotides;</para>
  <para style="q2" vid="LAM 1:20">ta keeha makkalladis;</para>
  <para style="q2" vid="LAM 1:20">ta wozinaykka meqqides;</para>
  <para style="q2" vid="LAM 1:20">Karen gidiin soon</para>
  <para style="q2" vid="LAM 1:20">deraa hayqoy wursees.<verse eid="LAM 1:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21"/>«Derey ta zilalizayssa siyides;</para>
  <para style="q2" vid="LAM 1:21">gido attiin oonikka tana</para>
  <para style="q2" vid="LAM 1:21">minththeththizaadey</para>
  <para style="q2" vid="LAM 1:21">beettibeenna;</para>
  <para style="q2" vid="LAM 1:21">ta morkketi ubbayka</para>
  <para style="q2" vid="LAM 1:21">ta metotoyssa siyida;</para>
  <para style="q2" vid="LAM 1:21">neni ooththoyssaka eridi</para>
  <para style="q2" vid="LAM 1:21">istti ufayettida;</para>
  <para style="q2" vid="LAM 1:21">ne istta bolla ehana ga</para>
  <para style="q2" vid="LAM 1:21">qachchida gallassaya yu;</para>
  <para style="q2" vid="LAM 1:21">isttika ta mala zilaletto.<verse eid="LAM 1:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22"/>«Istta iitateththi</para>
  <para style="q2" vid="LAM 1:22">ne sinththan beetto;</para>
  <para style="q2" vid="LAM 1:22">ta nagara gaason</para>
  <para style="q2" vid="LAM 1:22">ne ta bolla ooththoyssaththo</para>
  <para style="q2" vid="LAM 1:22">istta bollaka ooththa;</para>
  <para style="q2" vid="LAM 1:22">ta ceecada zilaliza</para>
  <para style="q2" vid="LAM 1:22">zilasay darides;</para>
  <para style="q2" vid="LAM 1:22">ta wozinaykka daaburdes»</para>
  <para style="q2" vid="LAM 1:22">gishe waasseettes.<verse eid="LAM 1:22"/></para>
  <chapter eid="LAM 1"/>
  <chapter number="2" style="c" sid="LAM 2"/>
  <para style="s1">Xoossi Yerusalaame Bolla Ehida Hanqo</para>
  <para style="p">
    <verse number="1" style="v" sid="LAM 2:1"/>GODAY Xiyoone macca nayo ba hanqon wostti kawushshidee!</para>
  <para style="q1" vid="LAM 2:1">Isra7eele bonchcho</para>
  <para style="q2" vid="LAM 2:1">saloppe duge sa7an yeggides;</para>
  <para style="q2" vid="LAM 2:1">izi ba hanqo gallas ba</para>
  <para style="q2" vid="LAM 2:1">toho shempisizaso</para>
  <para style="q2" vid="LAM 2:1">gididaaro zaari</para>
  <para style="q2" vid="LAM 2:1">qoppanaas koyibeenna.<verse eid="LAM 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2"/>Yaaqoobe duussaso ubbaa Xoossi</para>
  <para style="q2" vid="LAM 2:2">qadhetay baynda dhayssides;</para>
  <para style="q2" vid="LAM 2:2">Yuhuda dere miixata</para>
  <para style="q2" vid="LAM 2:2">izi ba hanqon laallides;</para>
  <para style="q2" vid="LAM 2:2">izi kawoteththanne</para>
  <para style="q2" vid="LAM 2:2">dere ayssizayta</para>
  <para style="q2" vid="LAM 2:2">kawushshidi duge</para>
  <para style="q2" vid="LAM 2:2">biittan yeggides.<verse eid="LAM 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3"/>Izi ba gita hanqon</para>
  <para style="q2" vid="LAM 2:3">Isra7eele wolqqa liiqisides;</para>
  <para style="q2" vid="LAM 2:3">morkkey iza olanaas yiza wode</para>
  <para style="q2" vid="LAM 2:3">ba maado kushe</para>
  <para style="q2" vid="LAM 2:3">isttafe denththides;</para>
  <para style="q2" vid="LAM 2:3">ba yuushon diza ubbaa</para>
  <para style="q2" vid="LAM 2:3">miza tama laco mala</para>
  <para style="q2" vid="LAM 2:3">iza hanqoy Yaaqoobe bolla</para>
  <para style="q2" vid="LAM 2:3">eexxi kezides.<verse eid="LAM 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4"/>Izi morkke mala</para>
  <para style="q2" vid="LAM 2:4">wondafe dafi oykkides;</para>
  <para style="q2" vid="LAM 2:4">iza ushachcha kushey</para>
  <para style="q2" vid="LAM 2:4">yiishshaa yeddanaas giigsides;</para>
  <para style="q2" vid="LAM 2:4">bana lo7izayta ubbaa</para>
  <para style="q2" vid="LAM 2:4">morkke mala shukkides;</para>
  <para style="q2" vid="LAM 2:4">Xiyoone dunkaaneta bollaka</para>
  <para style="q2" vid="LAM 2:4">ba hanqo tama mala qolides.<verse eid="LAM 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5"/>Xoossi morkke mala gididi</para>
  <para style="q2" vid="LAM 2:5">Isra7eele dippi histtides;</para>
  <para style="q2" vid="LAM 2:5">kawoteththa keeththaaka</para>
  <para style="q2" vid="LAM 2:5">dhayssides;</para>
  <para style="q2" vid="LAM 2:5">izi miixaakka laallides;</para>
  <para style="q2" vid="LAM 2:5">Yuhuda asaa bolla</para>
  <para style="q2" vid="LAM 2:5">kayonne zilas darssides.<verse eid="LAM 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6"/>Izi ba keeththa kaththa giddon diza</para>
  <para style="q2" vid="LAM 2:6">gaabba shoddiza mala</para>
  <para style="q2" vid="LAM 2:6">shoddi olides;</para>
  <para style="q2" vid="LAM 2:6">Xoossi Xiyoono</para>
  <para style="q2" vid="LAM 2:6">iza layththan layththan</para>
  <para style="q2" vid="LAM 2:6">bonchchiza ba7aaletanne</para>
  <para style="q2" vid="LAM 2:6">sambatata diggides;</para>
  <para style="q2" vid="LAM 2:6">izi ba mino hanqon</para>
  <para style="q2" vid="LAM 2:6">kawozanne qeeseza</para>
  <para style="q2" vid="LAM 2:6">kawushshides.<verse eid="LAM 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7"/>GODAY yarsho</para>
  <para style="q2" vid="LAM 2:7">yarshizasohoza kadhides;</para>
  <para style="q2" vid="LAM 2:7">ba keeththaaka aggides;</para>
  <para style="q2" vid="LAM 2:7">ba kawoteththa keeththa gimbeta</para>
  <para style="q2" vid="LAM 2:7">morkkes aaththi immides;</para>
  <para style="q2" vid="LAM 2:7">ba7aale gallassatan</para>
  <para style="q2" vid="LAM 2:7">ooththizayssaththo</para>
  <para style="q2" vid="LAM 2:7">istti GODAA Keeththan</para>
  <para style="q2" vid="LAM 2:7">keehi waassida.<verse eid="LAM 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8"/>GODAY Xiyoone katama gimbe</para>
  <para style="q2" vid="LAM 2:8">laallanaas qanxxi dendides;</para>
  <para style="q2" vid="LAM 2:8">mixe wodoroza piddisides;</para>
  <para style="q2" vid="LAM 2:8">izi istta dhayssontta aggenna;</para>
  <para style="q2" vid="LAM 2:8">miixatinne gimbetti laalettida;</para>
  <para style="q2" vid="LAM 2:8">isttika issife dhayda.<verse eid="LAM 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9"/>Izi pengeti duge biittan gelida;</para>
  <para style="q2" vid="LAM 2:9">kare gordiza birata kolatati</para>
  <para style="q2" vid="LAM 2:9">meqeretti wodhdhida;</para>
  <para style="q2" vid="LAM 2:9">izi kawozinne daannati</para>
  <para style="q2" vid="LAM 2:9">ayzaabetan di7etti bida;</para>
  <para style="q2" vid="LAM 2:9">hayssafe guye kase isttas diza</para>
  <para style="q2" vid="LAM 2:9">wogay ooththenna;</para>
  <para style="q2" vid="LAM 2:9">izi nabetaska hayssafe guye</para>
  <para style="q2" vid="LAM 2:9">GODAAPPE ajjuutay qonccenna.<verse eid="LAM 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10"/>Xiyoone dere cimati</para>
  <para style="q2" vid="LAM 2:10">biitta bolla co7u gi uttida;</para>
  <para style="q2" vid="LAM 2:10">istti ba hu7en gudulla laallida;</para>
  <para style="q2" vid="LAM 2:10">maaqaka may7ida;</para>
  <para style="q2" vid="LAM 2:10">Yerusalaame geela7oti</para>
  <para style="q2" vid="LAM 2:10">duge biitta xeellida.<verse eid="LAM 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11"/>Ta derey wurides;</para>
  <para style="q2" vid="LAM 2:11">naateththa naytinne qeeri nayti</para>
  <para style="q2" vid="LAM 2:11">katama giddon labbani kundida.</para>
  <para style="q2" vid="LAM 2:11">Hessa gishshas ta ayfey</para>
  <para style="q2" vid="LAM 2:11">afunththan baljumides;</para>
  <para style="q2" vid="LAM 2:11">taas maracey kokkorides;</para>
  <para style="q2" vid="LAM 2:11">ta wozinaykka seerides;<verse eid="LAM 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12"/>Olason madunxi kundida</para>
  <para style="q2" vid="LAM 2:12">asata mala</para>
  <para style="q2" vid="LAM 2:12">katamay giddon istti daaburda;</para>
  <para style="q2" vid="LAM 2:12">istti bantta aayeta,</para>
  <para style="q2" vid="LAM 2:12">«Kaththinne haaththi</para>
  <para style="q2" vid="LAM 2:12">nuus awan dizee?»</para>
  <para style="q2" vid="LAM 2:12">gi oychchishe istti qese bolla</para>
  <para style="q2" vid="LAM 2:12">borkotidi shemppo kezida.<verse eid="LAM 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 2:13"/>«Hanne Yerusalaame!</para>
  <para style="q2" vid="LAM 2:13">Ta ne gishshas</para>
  <para style="q2" vid="LAM 2:13">ay gaanaas dandayazinaa?</para>
  <para style="q2" vid="LAM 2:13">Ta nena aazara ginasa xeelloo?</para>
  <para style="q2" vid="LAM 2:13">Hanne dosettida</para>
  <para style="q2" vid="LAM 2:13">Xiyoone geela7oyee!</para>
  <para style="q2" vid="LAM 2:13">Ta nena wostta minththeththanaas</para>
  <para style="q2" vid="LAM 2:13">dandayazinaa?</para>
  <para style="q2" vid="LAM 2:13">ne madunththay</para>
  <para style="q2" vid="LAM 2:13">abbafeka cimmatees;</para>
  <para style="q2" vid="LAM 2:13">nena paththanaas</para>
  <para style="q2" vid="LAM 2:13">dandayzay oonee?<verse eid="LAM 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14"/>Ne nabeta ajjuutay</para>
  <para style="q2" vid="LAM 2:14">wordonne coo hada;</para>
  <para style="q2" vid="LAM 2:14">ne nagara qonccisidi</para>
  <para style="q2" vid="LAM 2:14">nena di7eteththafe ashshettenna;</para>
  <para style="q2" vid="LAM 2:14">istti nees yootiza tinbitey</para>
  <para style="q2" vid="LAM 2:14">baleththizaazinne</para>
  <para style="q2" vid="LAM 2:14">ogeppe kare kessizaaza.<verse eid="LAM 2:14"/></para>
  <para style="m">
    <verse number="15" style="v" sid="LAM 2:15"/>Ne achchara aadhdhi biza ubbay</para>
  <para style="q2" vid="LAM 2:15">ne bolla ba kushe baqqi kaa7ana;</para>
  <para style="q2" vid="LAM 2:15">biitta ubbaan</para>
  <para style="q2" vid="LAM 2:15">aadho lo7o geetettiza</para>
  <para style="q2" vid="LAM 2:15">katamayanne</para>
  <para style="q2" vid="LAM 2:15">dere ubbay ufayettiza</para>
  <para style="q2" vid="LAM 2:15">katamaya hanii?» gaana;</para>
  <para style="q2" vid="LAM 2:15">qidhishekka ba hu7e qaaththana.<verse eid="LAM 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16"/>Ne morkketi ubbay issife</para>
  <para style="q2" vid="LAM 2:16">bantta doona keehi doyda;</para>
  <para style="q2" vid="LAM 2:16">bantta ach saxxishe qidhida;</para>
  <para style="q2" vid="LAM 2:16">«Nuni izo mittidos!</para>
  <para style="q2" vid="LAM 2:16">nuni amottidaara hanno;</para>
  <para style="q2" vid="LAM 2:16">shemppora paxa diidi</para>
  <para style="q2" vid="LAM 2:16">gakki ayfen be7idos» gida.<verse eid="LAM 2:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17"/>Xoossi ba qoppidayssa ooththides;</para>
  <para style="q2" vid="LAM 2:17">daro wodeppe kase yootida</para>
  <para style="q2" vid="LAM 2:17">qaala polides;</para>
  <para style="q2" vid="LAM 2:17">izi nena qadhetay</para>
  <para style="q2" vid="LAM 2:17">baynda laallides;</para>
  <para style="q2" vid="LAM 2:17">ne waayettishin</para>
  <para style="q2" vid="LAM 2:17">morkkey ufayettana mala</para>
  <para style="q2" vid="LAM 2:17">ne morkketa</para>
  <para style="q2" vid="LAM 2:17">dhoqqu dhoqqu histtides.<verse eid="LAM 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18"/>Yerusalaame gimbe</para>
  <para style="q2" vid="LAM 2:18">giddon diza asawu!</para>
  <para style="q2" vid="LAM 2:18">Xoossaako waassite;</para>
  <para style="q2" vid="LAM 2:18">intte afunththi omarsinne</para>
  <para style="q2" vid="LAM 2:18">gallas di7o mala goggo;</para>
  <para style="q2" vid="LAM 2:18">intteka shempofte;</para>
  <para style="q2" vid="LAM 2:18">intte ayfesikka shemppo immofte.<verse eid="LAM 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19"/>Qammaa kumeth dendidi waassite;</para>
  <para style="q2" vid="LAM 2:19">Godaa sinththan intte wozina</para>
  <para style="q2" vid="LAM 2:19">haaththa mala gussite;</para>
  <para style="q2" vid="LAM 2:19">oge doonan koshatti kundida</para>
  <para style="q2" vid="LAM 2:19">ne nayta</para>
  <para style="q2" vid="LAM 2:19">shemppo gishshas ne kushe</para>
  <para style="q2" vid="LAM 2:19">pude izakko denththada woossa.<verse eid="LAM 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20"/>Abeet GODAWU!</para>
  <para style="q2" vid="LAM 2:20">Hayssa ne be7a!</para>
  <para style="q2" vid="LAM 2:20">Neni hayssaththo kase oona bolla</para>
  <para style="q2" vid="LAM 2:20">ooththa erizaakko ane akeeka;</para>
  <para style="q2" vid="LAM 2:20">aaya yela dichchida naa</para>
  <para style="q2" vid="LAM 2:20">zaara maanaas bessizee?</para>
  <para style="q2" vid="LAM 2:20">Qeeseynne nabey</para>
  <para style="q2" vid="LAM 2:20">Xoossa Keeththan</para>
  <para style="q2" vid="LAM 2:20">hayqqanaas bessizee?<verse eid="LAM 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21"/>Yelagatinne cimati hayqqidi</para>
  <para style="q2" vid="LAM 2:21">ogen kundi attida;</para>
  <para style="q2" vid="LAM 2:21">yelaga maccassatinne</para>
  <para style="q2" vid="LAM 2:21">attumati mashshan hayqqida;</para>
  <para style="q2" vid="LAM 2:21">ne hanqettida gallas</para>
  <para style="q2" vid="LAM 2:21">istta wodhadasa;</para>
  <para style="q2" vid="LAM 2:21">qadhetay bayndaka shukkadasa.<verse eid="LAM 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22"/>Ba7aale gallas diggisas</para>
  <para style="q2" vid="LAM 2:22">xeygiza mala</para>
  <para style="q2" vid="LAM 2:22">ta morkketa ta bolla xeygadasa;</para>
  <para style="q2" vid="LAM 2:22">ne hanqo gallas</para>
  <para style="q2" vid="LAM 2:22">oonikka kessi ekkibeenna;</para>
  <para style="q2" vid="LAM 2:22">woykko shemppora paxa</para>
  <para style="q2" vid="LAM 2:22">attiday deenna;</para>
  <para style="q2" vid="LAM 2:22">ta yela dichchidayta</para>
  <para style="q2" vid="LAM 2:22">morkkey taappe dhayssides.<verse eid="LAM 2:22"/></para>
  <chapter eid="LAM 2"/>
  <chapter number="3" style="c" sid="LAM 3"/>
  <para style="s1">Maareteththan Beettiza Hidota</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 3:1"/>Godaa hanqo guufen waaye be7ida</para>
  <para style="q2" vid="LAM 3:1">asi tana.<verse eid="LAM 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2"/>Izi tana ba sinththafe</para>
  <para style="q2" vid="LAM 3:2">kessi yeddides;</para>
  <para style="q2" vid="LAM 3:2">poo7oy baynda gede dhuman</para>
  <para style="q2" vid="LAM 3:2">tana gelththides.<verse eid="LAM 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3"/>Izi kumeththa gallas</para>
  <para style="q2" vid="LAM 3:3">zaari zaaridi tana shocides.<verse eid="LAM 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4"/>Izi ta asateththaaka ceegissides;</para>
  <para style="q2" vid="LAM 3:4">ta meqeththatakka</para>
  <para style="q2" vid="LAM 3:4">menththereththides.<verse eid="LAM 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5"/>Izi tana metoninne</para>
  <para style="q2" vid="LAM 3:5">iita tugga giddo yeggides.<verse eid="LAM 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6"/>Hayqqidi gam7ida asa mala</para>
  <para style="q2" vid="LAM 3:6">tani dhuman</para>
  <para style="q2" vid="LAM 3:6">daana mala ooththides.<verse eid="LAM 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7"/>Ta kezontta mala</para>
  <para style="q2" vid="LAM 3:7">ta yuushoza dirdes;</para>
  <para style="q2" vid="LAM 3:7">mino sansalatan</para>
  <para style="q2" vid="LAM 3:7">tana qachchides.<verse eid="LAM 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8"/>Tani maado koyada</para>
  <para style="q2" vid="LAM 3:8">waassa xeygiinkka</para>
  <para style="q2" vid="LAM 3:8">izi ta waasaa</para>
  <para style="q2" vid="LAM 3:8">siyanaas koyibeenna.<verse eid="LAM 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9"/>Ta ogeza masettida</para>
  <para style="q2" vid="LAM 3:9">shuchchan gordides;</para>
  <para style="q2" vid="LAM 3:9">ta aadhdha biza</para>
  <para style="q2" vid="LAM 3:9">ogezakka geellasides.<verse eid="LAM 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10"/>Izi taas zamadi uttida</para>
  <para style="q2" vid="LAM 3:10">zardo mala gidides;</para>
  <para style="q2" vid="LAM 3:10">qasseka qotetti naagiza</para>
  <para style="q2" vid="LAM 3:10">gaammo mala gidides.<verse eid="LAM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11"/>Tana ta biza ogeppe</para>
  <para style="q2" vid="LAM 3:11">goochchi kessidi</para>
  <para style="q2" vid="LAM 3:11">duusereththi yeggides;</para>
  <para style="q2" vid="LAM 3:11">tana asi bayndason olaagides.<verse eid="LAM 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12"/>Izi ba wondafe</para>
  <para style="q2" vid="LAM 3:12">dafi oykkides;</para>
  <para style="q2" vid="LAM 3:12">tana caddanaas</para>
  <para style="q2" vid="LAM 3:12">ba yiish giigsi woththides.<verse eid="LAM 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13"/>Izi yiishshaa yeddidi</para>
  <para style="q2" vid="LAM 3:13">taas wozina ayfen caddides.<verse eid="LAM 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14"/>Tani ta dere asaas</para>
  <para style="q2" vid="LAM 3:14">qidhe miish gidadis;</para>
  <para style="q2" vid="LAM 3:14">gallas kumeth ta bolla</para>
  <para style="q2" vid="LAM 3:14">qidhe mazamure yexxeettes.<verse eid="LAM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15"/>Izi ta de7oza camon kunththides;</para>
  <para style="q2" vid="LAM 3:15">izi tana ciye ushshu kalssides.<verse eid="LAM 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16"/>Izi ta ach shuchchan menththides;</para>
  <para style="q2" vid="LAM 3:16">izi tana gudullan yedhettides.<verse eid="LAM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17"/>Ta shemppoys saroteththi dhaydes;</para>
  <para style="q2" vid="LAM 3:17">ufayssi izi aazakkonne</para>
  <para style="q2" vid="LAM 3:17">ta baladis.<verse eid="LAM 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18"/>Hessa gishshas,</para>
  <para style="q2" vid="LAM 3:18">«Ta bonchchoy</para>
  <para style="q2" vid="LAM 3:18">taappe shaakettides;</para>
  <para style="q2" vid="LAM 3:18">tani Xoossafe naagiza hidota</para>
  <para style="q2" vid="LAM 3:18">ubbay dhaydes» gadis.<verse eid="LAM 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19"/>Ta waayenne ta toylateththaa</para>
  <para style="q2" vid="LAM 3:19">ta qoppishin ta de7oy</para>
  <para style="q2" vid="LAM 3:19">tana cammides.<verse eid="LAM 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 3:20"/>Ubbaa wodekka ta hayssa qoppishin</para>
  <para style="q2" vid="LAM 3:20">ta wozinay ceecees.<verse eid="LAM 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 3:21"/>Gidikkoka tani</para>
  <para style="q2" vid="LAM 3:21">hayssa qoppiza wode</para>
  <para style="q2" vid="LAM 3:21">taas sinththafe hidotay dees.<verse eid="LAM 3:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22"/>Hessika nuni dhayontta aggiday</para>
  <para style="q2" vid="LAM 3:22">GODAA siiqoy</para>
  <para style="q2" vid="LAM 3:22">daro gidida gaasonna;</para>
  <para style="q2" vid="LAM 3:22">iza qadhetaykka mernaas</para>
  <para style="q2" vid="LAM 3:22">wurontta gishshassa.<verse eid="LAM 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23"/>Istti maalado maalado ooraththa;</para>
  <para style="q2" vid="LAM 3:23">Ne ammaneteththayka daro.<verse eid="LAM 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24"/>Taas qaaday GODAA;</para>
  <para style="q2" vid="LAM 3:24">hessa gishshas ta izan xalla</para>
  <para style="q2" vid="LAM 3:24">hidota ooththays.<verse eid="LAM 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25"/>GODAY bana hidota</para>
  <para style="q2" vid="LAM 3:25">ooththizaytassinne</para>
  <para style="q2" vid="LAM 3:25">iza koyzaytas lo7o.<verse eid="LAM 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26"/>GODAY as ashshiza ashoza</para>
  <para style="q2" vid="LAM 3:26">izaadey co7u gi naagikko lo7o.<verse eid="LAM 3:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="LAM 3:27"/>Asi yelagateththa woden</para>
  <para style="q2" vid="LAM 3:27">qambara tookkiko lo7o.<verse eid="LAM 3:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28"/>GODAY iza toossida gishshas</para>
  <para style="q2" vid="LAM 3:28">izi barkka co7u gi utto.<verse eid="LAM 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29"/>Sinththafe izas hidotay daana</para>
  <para style="q2" vid="LAM 3:29">dandayza gishshas</para>
  <para style="q2" vid="LAM 3:29">bana ziqqi histti haariso.<verse eid="LAM 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30"/>Baqqana koyidaades</para>
  <para style="q2" vid="LAM 3:30">izi ba shagala besso;</para>
  <para style="q2" vid="LAM 3:30">kawushshateththika ekko.<verse eid="LAM 3:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31"/>GODAY ase mernaaskka</para>
  <para style="q2" vid="LAM 3:31">yeggi aggenna.<verse eid="LAM 3:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LAM 3:32"/>Izi asa bolla meto ehikkoka</para>
  <para style="q2" vid="LAM 3:32">ba mernaa siiqon</para>
  <para style="q2" vid="LAM 3:32">simmi qadhettees;<verse eid="LAM 3:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33"/>Izi odidi asa bolla meto</para>
  <para style="q2" vid="LAM 3:33">woykko waaye ehi erenna.<verse eid="LAM 3:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34"/>Deraan diza qasho asay</para>
  <para style="q2" vid="LAM 3:34">ubbay genen yedhettishin,<verse eid="LAM 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35"/>Ubbaafe Dhoqqa Xoossay beyishin</para>
  <para style="q2" vid="LAM 3:35">asas asateththa</para>
  <para style="q2" vid="LAM 3:35">maatay digettiza wode,<verse eid="LAM 3:35"/></para>
  <para style="q2">
    <verse number="36" style="v" sid="LAM 3:36"/>qasseka tuma pirday</para>
  <para style="q2" vid="LAM 3:36">geellattiza wode</para>
  <para style="q2" vid="LAM 3:36">GODAY hessa mala</para>
  <para style="q2" vid="LAM 3:36">hanota demmennee?<verse eid="LAM 3:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37"/>Xoossi azazontta dishin</para>
  <para style="q2" vid="LAM 3:37">ba gidaaz polanaas</para>
  <para style="q2" vid="LAM 3:37">dandayzay oonee?<verse eid="LAM 3:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38"/>Iita gidiin woykko lo7o gidiin</para>
  <para style="q2" vid="LAM 3:38">ba gidaaz polizay</para>
  <para style="q2" vid="LAM 3:38">Ubbaafe Dhoqqa Xoossaa gidennee?<verse eid="LAM 3:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39"/>Histtiin shemppora</para>
  <para style="q2" vid="LAM 3:39">paxa diza asi ba nagaran</para>
  <para style="q2" vid="LAM 3:39">qaxxayettishe aazas zuuzumizee?<verse eid="LAM 3:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40"/>Hessa aggidi nuni</para>
  <para style="q2" vid="LAM 3:40">nu oge ane pilggi xeelloos;</para>
  <para style="q2" vid="LAM 3:40">GODAAKKOKA simmoos.<verse eid="LAM 3:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41"/>Ane nuni nu wozinanne</para>
  <para style="q2" vid="LAM 3:41">nu kushe salon diza</para>
  <para style="q2" vid="LAM 3:41">Xoossako pude denththidi,<verse eid="LAM 3:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42"/>«Nu GODAWU! Nuni makkallidos;</para>
  <para style="q2" vid="LAM 3:42">nagarakka ooththidos;</para>
  <para style="q2" vid="LAM 3:42">hessa gishshas neni</para>
  <para style="q2" vid="LAM 3:42">nuna maarabeekka.<verse eid="LAM 3:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43"/>Neni hanqon kumada</para>
  <para style="q2" vid="LAM 3:43">nuna gooddadasa;</para>
  <para style="q2" vid="LAM 3:43">ne nuna</para>
  <para style="q2" vid="LAM 3:43">qadhetay baynda wodhadasa.<verse eid="LAM 3:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44"/>Woosay neekko aadhdhi</para>
  <para style="q2" vid="LAM 3:44">bontta mala</para>
  <para style="q2" vid="LAM 3:44">nena shaaran kammadasa.<verse eid="LAM 3:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45"/>Ne nuna ayzaabeta giddon</para>
  <para style="q2" vid="LAM 3:45">orcconne buura kessadasa.<verse eid="LAM 3:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46"/>Nu morkketi ubbay</para>
  <para style="q2" vid="LAM 3:46">ba doona nu bolla doyda.<verse eid="LAM 3:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47"/>Nuni bashshaninne</para>
  <para style="q2" vid="LAM 3:47">laaleteththan metoninne</para>
  <para style="q2" vid="LAM 3:47">shiron kumdos» goos.<verse eid="LAM 3:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48"/>Ta derey wurida gishshas</para>
  <para style="q2" vid="LAM 3:48">ta ayfeppe afunththi</para>
  <para style="q2" vid="LAM 3:48">di7o mala goggides.<verse eid="LAM 3:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="LAM 3:49"/>Shempontta ubba wode</para>
  <para style="q2" vid="LAM 3:49">ta ayfeppe afunththi gukkees.<verse eid="LAM 3:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="LAM 3:50"/>Hessi hananay Xoossi saloppe</para>
  <para style="q2" vid="LAM 3:50">duge xeellana gakkanaassa.<verse eid="LAM 3:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51"/>Tani diza kataman diza</para>
  <para style="q2" vid="LAM 3:51">ubbaa maccassata bolla</para>
  <para style="q2" vid="LAM 3:51">gakkida metoza</para>
  <para style="q2" vid="LAM 3:51">tani ta ayfen be7ida gishshas</para>
  <para style="q2" vid="LAM 3:51">ta wozinay ceecides.<verse eid="LAM 3:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52"/>Gaasoykka baynda</para>
  <para style="q2" vid="LAM 3:52">taas morkke gididayti</para>
  <para style="q2" vid="LAM 3:52">kafo mala tana shankkatida.<verse eid="LAM 3:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53"/>Istti tani shemppora</para>
  <para style="q2" vid="LAM 3:53">paxa dishin duge ollan yeggida;</para>
  <para style="q2" vid="LAM 3:53">shuchchika ta bolla olida.<verse eid="LAM 3:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54"/>Haaththi kumidi</para>
  <para style="q2" vid="LAM 3:54">taas hu7e bollara goggides;</para>
  <para style="q2" vid="LAM 3:54">tani dhayadis gaada qoppadis.<verse eid="LAM 3:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55"/>Ta GODAWU!</para>
  <para style="q2" vid="LAM 3:55">Tani ciimma olla giddon dashe</para>
  <para style="q2" vid="LAM 3:55">ne sunththa xeygadis.<verse eid="LAM 3:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56"/>Ta waaso ne siyana mala</para>
  <para style="q2" vid="LAM 3:56">ta nena woossiin siyadasa.<verse eid="LAM 3:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57"/>Ta nena xeygida wode</para>
  <para style="q2" vid="LAM 3:57">ne taakko shiiqada,</para>
  <para style="q2" vid="LAM 3:57">«Yayyofa» gadasa.<verse eid="LAM 3:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58"/>Godoo! Ne taas mootettada</para>
  <para style="q2" vid="LAM 3:58">tana ashshadasa.<verse eid="LAM 3:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59"/>GODAWU! Ne ta bolla</para>
  <para style="q2" vid="LAM 3:59">gakkida qohoza beyadasa;</para>
  <para style="q2" vid="LAM 3:59">ne taas pirda.<verse eid="LAM 3:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60"/>Ta morkketi ta bolla</para>
  <para style="q2" vid="LAM 3:60">halo kessanaas qoppidayssanne</para>
  <para style="q2" vid="LAM 3:60">istti ta bolla</para>
  <para style="q2" vid="LAM 3:60">zuppetidayssa ne beyadasa.<verse eid="LAM 3:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61"/>Ta GODAWU!</para>
  <para style="q2" vid="LAM 3:61">Istti tana cayida cashshanne</para>
  <para style="q2" vid="LAM 3:61">ta bolla maqettida maqqoza</para>
  <para style="q2" vid="LAM 3:61">ne siyadasa.<verse eid="LAM 3:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62"/>Gallas kumeth ta morkketi</para>
  <para style="q2" vid="LAM 3:62">ta bolla saasuketteettessinne</para>
  <para style="q2" vid="LAM 3:62">zuuzumeettes.<verse eid="LAM 3:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63"/>Ne istta xeella!</para>
  <para style="q2" vid="LAM 3:63">Istti eqqidi gidiin uttidi</para>
  <para style="q2" vid="LAM 3:63">ba yeththan tana caddeettes.<verse eid="LAM 3:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64"/>Ta GODAWU! Ne isttas</para>
  <para style="q2" vid="LAM 3:64">istta ooso mala imma.<verse eid="LAM 3:64"/></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65"/>Istta wozina dammisa;</para>
  <para style="q2" vid="LAM 3:65">Ne qanggeththi istta gakko.<verse eid="LAM 3:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66"/>Abeet GODAWU!</para>
  <para style="q2" vid="LAM 3:66">Ne istta ne hanqon goodda;</para>
  <para style="q2" vid="LAM 3:66">salo garsafe dhayssa.<verse eid="LAM 3:66"/></para>
  <chapter eid="LAM 3"/>
  <chapter number="4" style="c" sid="LAM 4"/>
  <para style="s1">Yerusalaame Bolla Gakkida Qixaate</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 4:1"/>Worqqay waani tasides;</para>
  <para style="q2" vid="LAM 4:1">Walakay baynda muuruta worqqay</para>
  <para style="q2" vid="LAM 4:1">waani laamettidee!</para>
  <para style="q2" vid="LAM 4:1">Xoossa keeththi</para>
  <para style="q2" vid="LAM 4:1">keexettida bonchcho shuchchati</para>
  <para style="q2" vid="LAM 4:1">oge doonan laalettida.<verse eid="LAM 4:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2"/>Kase bonchchettida</para>
  <para style="q2" vid="LAM 4:2">worqqa misatiza</para>
  <para style="q2" vid="LAM 4:2">Xiyoone nayti ha7i waanidi</para>
  <para style="q2" vid="LAM 4:2">kushen urqqafe tilidi medhdhida</para>
  <para style="q2" vid="LAM 4:2">mana miishsha mala gididoo!<verse eid="LAM 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3"/>Worakanati ba marata dichchanaas</para>
  <para style="q2" vid="LAM 4:3">ba dhanth dhanththeettes;</para>
  <para style="q2" vid="LAM 4:3">ta derey gidikko</para>
  <para style="q2" vid="LAM 4:3">bazzon diza</para>
  <para style="q2" vid="LAM 4:3">yanchcha kafota mala</para>
  <para style="q2" vid="LAM 4:3">menxe iitides.<verse eid="LAM 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4"/>Daro saamettida gishshas</para>
  <para style="q2" vid="LAM 4:4">guuththa nayta inxarsi</para>
  <para style="q2" vid="LAM 4:4">pude gonggiraththara oykettides;</para>
  <para style="q2" vid="LAM 4:4">nayti kath woossida shin</para>
  <para style="q2" vid="LAM 4:4">oonikka isttas immibeenna.<verse eid="LAM 4:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5"/>Kase lo7o kath mizayti</para>
  <para style="q2" vid="LAM 4:5">ha7i metotidi</para>
  <para style="q2" vid="LAM 4:5">oge bolla toylattida;</para>
  <para style="q2" vid="LAM 4:5">kase lo7o may7o may7idi</para>
  <para style="q2" vid="LAM 4:5">ishalon diccidayti</para>
  <para style="q2" vid="LAM 4:5">ha7i bidinththan ichchida.<verse eid="LAM 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6"/>Ta dereza bolla gakkida qixaatey</para>
  <para style="q2" vid="LAM 4:6">oona kusheykka</para>
  <para style="q2" vid="LAM 4:6">bochchontta dishin</para>
  <para style="q2" vid="LAM 4:6">eeson aadhdha wodhdhida</para>
  <para style="q2" vid="LAM 4:6">Sodoome katama</para>
  <para style="q2" vid="LAM 4:6">asaa gakkida qixaatezappeka</para>
  <para style="q2" vid="LAM 4:6">keehi iita.<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="GEN 19:24">Medhe 19:24</ref></char></note><verse eid="LAM 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7"/>Istta kaaleththizayti</para>
  <para style="q2" vid="LAM 4:7">shachchafe aadhdhida geeshsha;</para>
  <para style="q2" vid="LAM 4:7">maaththafe aadhdhi booththa;</para>
  <para style="q2" vid="LAM 4:7">istta bollay zo7o inqqufe</para>
  <para style="q2" vid="LAM 4:7">aadhdhida aarissa;</para>
  <para style="q2" vid="LAM 4:7">qasse isttas medhaykka</para>
  <para style="q2" vid="LAM 4:7">simpere geetettiza</para>
  <para style="q2" vid="LAM 4:7">shuchcha mala.<verse eid="LAM 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8"/>Ha7i gidikko istta medhay</para>
  <para style="q2" vid="LAM 4:8">shaalapeka aadhdhi karettides;</para>
  <para style="q2" vid="LAM 4:8">oonikka istta ogen be7idi erenna;</para>
  <para style="q2" vid="LAM 4:8">istti meqeth xalla attida;</para>
  <para style="q2" vid="LAM 4:8">mela miththa mala gidida.<verse eid="LAM 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9"/>Koshan hayqqidaytappe</para>
  <para style="q2" vid="LAM 4:9">mashshan hayqqidayti lo7o;<verse eid="LAM 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10"/>Ta asaa bolla gakkida hanqo gaason</para>
  <para style="q2" vid="LAM 4:10">naytas mishettiza aayeti</para>
  <para style="q2" vid="LAM 4:10">ba yelida nayta</para>
  <para style="q2" vid="LAM 4:10">ba kushera doysi mida.<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="DEU 28:57">Zaare 28:57</ref>; <ref loc="EZK 5:10">Hizi 5:10</ref></char></note><verse eid="LAM 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11"/>Xoossi ba wolqqama</para>
  <para style="q2" vid="LAM 4:11">hanqoza qonccisides;</para>
  <para style="q2" vid="LAM 4:11">Xiyoono dippi histti</para>
  <para style="q2" vid="LAM 4:11">dhayssiza tama oyseththides.<verse eid="LAM 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12"/>Biitta bolla diza kawotappe</para>
  <para style="q2" vid="LAM 4:12">woykko alame bolla diza</para>
  <para style="q2" vid="LAM 4:12">asaappe oonikka istta morkketi</para>
  <para style="q2" vid="LAM 4:12">woykko worajjizayti</para>
  <para style="q2" vid="LAM 4:12">Yerusalaame pengeta</para>
  <para style="q2" vid="LAM 4:12">menththi gelana giidi</para>
  <para style="q2" vid="LAM 4:12">oonikka qoppibeenna.<verse eid="LAM 4:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13"/>Hayssi haniday nabetinne</para>
  <para style="q2" vid="LAM 4:13">qeeseti ooththida</para>
  <para style="q2" vid="LAM 4:13">nagara gaasonna;</para>
  <para style="q2" vid="LAM 4:13">qasse istti xillota suuth</para>
  <para style="q2" vid="LAM 4:13">gussida gishshassa.<verse eid="LAM 4:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14"/>Qooqe asa mala</para>
  <para style="q2" vid="LAM 4:14">istti oge bolla gadigadana;</para>
  <para style="q2" vid="LAM 4:14">istti suuththan tunida gishshas</para>
  <para style="q2" vid="LAM 4:14">istta may7o bochchanaas</para>
  <para style="q2" vid="LAM 4:14">xalizaadey deenna.<verse eid="LAM 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15"/>Hessa gishshas asay istta bolla,</para>
  <para style="q2" vid="LAM 4:15">«Kichchite! Intte tuna! Haakkite!</para>
  <para style="q2" vid="LAM 4:15">Nuna bochchofte!» gi waassana.</para>
  <para style="b" vid="LAM 4:15"/>
  <para style="q2" vid="LAM 4:15">Hessa gaason istti baqatidi</para>
  <para style="q2" vid="LAM 4:15">kawoteththaa giddon toylattishe</para>
  <para style="q2" vid="LAM 4:15">asay isttas, «Intte nunara</para>
  <para style="q2" vid="LAM 4:15">hayssan daanaas</para>
  <para style="q2" vid="LAM 4:15">dandayekketa» gida.<verse eid="LAM 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16"/>Istta laalliday Xoossa;</para>
  <para style="q2" vid="LAM 4:16">hayssafe guye izi isttas qoppenna;</para>
  <para style="q2" vid="LAM 4:16">istta qeesetas</para>
  <para style="q2" vid="LAM 4:16">bonchchoy imettenna;</para>
  <para style="q2" vid="LAM 4:16">cimataska puulay deenna.<verse eid="LAM 4:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17"/>Nu ayfey maado demmanaas</para>
  <para style="q2" vid="LAM 4:17">xeellishe coo mela daaburdes;</para>
  <para style="q2" vid="LAM 4:17">nuna ashshanaas</para>
  <para style="q2" vid="LAM 4:17">dandayontta deretappe</para>
  <para style="q2" vid="LAM 4:17">maado demmanaas</para>
  <para style="q2" vid="LAM 4:17">laamotan naagidos.<verse eid="LAM 4:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18"/>Asay nu geedon eqqiza gishshas</para>
  <para style="q2" vid="LAM 4:18">nu ogera hemettanaas</para>
  <para style="q2" vid="LAM 4:18">dandaybeekko;</para>
  <para style="q2" vid="LAM 4:18">nuus wurseththi matides;</para>
  <para style="q2" vid="LAM 4:18">nu layththi wurides;</para>
  <para style="q2" vid="LAM 4:18">nu dhayza wodey gakkides.<verse eid="LAM 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19"/>Nuna gooddizayti salora paalliza</para>
  <para style="q2" vid="LAM 4:19">gollefe aadhdhi eesoteettes;</para>
  <para style="q2" vid="LAM 4:19">istti nuna zuma bollara gooddida;</para>
  <para style="q2" vid="LAM 4:19">bazzon nuna zuggi naagida.<verse eid="LAM 4:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20"/>Nuni iza kuwa garsan</para>
  <para style="q2" vid="LAM 4:20">utti de7ana gi qoppidayssa,</para>
  <para style="q2" vid="LAM 4:20">Xoossi tiydayssa,</para>
  <para style="q2" vid="LAM 4:20">nuus de7o shemppoka gididayssa</para>
  <para style="q2" vid="LAM 4:20">bantta woximaden oykkida.<verse eid="LAM 4:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21"/>Intteno Uuxe biittan diza</para>
  <para style="q2" vid="LAM 4:21">Eedoome asatoo!</para>
  <para style="q2" vid="LAM 4:21">Ufays nococu giite!</para>
  <para style="q2" vid="LAM 4:21">Gido attiin qaaday</para>
  <para style="q2" vid="LAM 4:21">inttenakka gakkana;</para>
  <para style="q2" vid="LAM 4:21">intte maththottananne</para>
  <para style="q2" vid="LAM 4:21">kallo attana.<verse eid="LAM 4:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22"/>Intteno Xiyoone asatoo!</para>
  <para style="q2" vid="LAM 4:22">Intte mooro gaason qaxxayettoyssi</para>
  <para style="q2" vid="LAM 4:22">inttes gidana;</para>
  <para style="q2" vid="LAM 4:22">hayssafe guye inttena</para>
  <para style="q2" vid="LAM 4:22">di7ettida biittan gam7isenna;</para>
  <para style="q2" vid="LAM 4:22">gido attiin Eedoome asatoo!</para>
  <para style="q2" vid="LAM 4:22">Izi inttena intte</para>
  <para style="q2" vid="LAM 4:22">nagara gishshas qaxxayana;</para>
  <para style="q2" vid="LAM 4:22">izi intte moorozakka</para>
  <para style="q2" vid="LAM 4:22">qoncce kessana.<verse eid="LAM 4:22"/></para>
  <chapter eid="LAM 4"/>
  <chapter number="5" style="c" sid="LAM 5"/>
  <para style="s1">Maarettanaas Woossida Woosa</para>
  <para style="p">
    <verse number="1" style="v" sid="LAM 5:1"/>Abeet GODAWU!</para>
  <para style="q1" vid="LAM 5:1">Nu bolla gakkidayssa ne qoppa;</para>
  <para style="q2" vid="LAM 5:1">nu kawushshateththaka xeella.<verse eid="LAM 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2"/>Nu biitta allagati laattida;</para>
  <para style="q2" vid="LAM 5:2">nu keeththaaka</para>
  <para style="q2" vid="LAM 5:2">baas duussaso ooththida.<verse eid="LAM 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3"/>Nuni yi7o gididos;</para>
  <para style="q2" vid="LAM 5:3">nu aayeti am7eta gidida.<verse eid="LAM 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4"/>Nuni nu haaththa</para>
  <para style="q2" vid="LAM 5:4">miishshan shammi uyidos;</para>
  <para style="q2" vid="LAM 5:4">nuni nu miththaaka</para>
  <para style="q2" vid="LAM 5:4">shammi ekkidos.<verse eid="LAM 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5"/>Nuna gooddizayti</para>
  <para style="q2" vid="LAM 5:5">nuus geedon eqqida;</para>
  <para style="q2" vid="LAM 5:5">keehippe daaburdos;</para>
  <para style="q2" vid="LAM 5:5">shempoka digettidos.<verse eid="LAM 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6"/>Nuni kath kallanaas giidi</para>
  <para style="q2" vid="LAM 5:6">Asoore asatassinne</para>
  <para style="q2" vid="LAM 5:6">Gibxes kushe immidos.<verse eid="LAM 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7"/>Nu aawati nagara ooththida;</para>
  <para style="q2" vid="LAM 5:7">nuni istta qixaate ekkidos.<verse eid="LAM 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8"/>Aylleti nuna haarida;</para>
  <para style="q2" vid="LAM 5:8">istta kusheppe nuna kessi</para>
  <para style="q2" vid="LAM 5:8">ekkanay oonikka deenna.<verse eid="LAM 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9"/>Bazzon diza ola gaason</para>
  <para style="q2" vid="LAM 5:9">nuni nu shemppo</para>
  <para style="q2" vid="LAM 5:9">aaththi immidi kath demmidos.<verse eid="LAM 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10"/>Kosha daroppe</para>
  <para style="q2" vid="LAM 5:10">dendidayssan hargidos;</para>
  <para style="q2" vid="LAM 5:10">nu medhaykka</para>
  <para style="q2" vid="LAM 5:10">shaala mala gidides.<verse eid="LAM 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11"/>Maccassata Xiyoonen tunisida;</para>
  <para style="q2" vid="LAM 5:11">geela7otakka Yuhuda katamatan</para>
  <para style="q2" vid="LAM 5:11">wolqqan oykki kawushshida.<verse eid="LAM 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12"/>Daannata istti kaqqida;</para>
  <para style="q2" vid="LAM 5:12">cimatakka bonchchibeettenna.<verse eid="LAM 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13"/>Yelaga attuma nayti</para>
  <para style="q2" vid="LAM 5:13">woxan gaaccana mala</para>
  <para style="q2" vid="LAM 5:13">wolqqaththida;</para>
  <para style="q2" vid="LAM 5:13">panththati deexo mith</para>
  <para style="q2" vid="LAM 5:13">tookkidi gadigadida.<verse eid="LAM 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14"/>Cimati pirdanaas</para>
  <para style="q2" vid="LAM 5:14">uttiza dubbusha aggida;</para>
  <para style="q2" vid="LAM 5:14">panththatikka</para>
  <para style="q2" vid="LAM 5:14">bantta mazamure aggida.<verse eid="LAM 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15"/>Ufayssi nu wozinappe dhaydes;</para>
  <para style="q2" vid="LAM 5:15">nu durissika</para>
  <para style="q2" vid="LAM 5:15">yeehon laamettides.<verse eid="LAM 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16"/>Kallachchay nu hu7eppe kundides;</para>
  <para style="q2" vid="LAM 5:16">nu nagara ooththida gishshas</para>
  <para style="q2" vid="LAM 5:16">aayye ana!<verse eid="LAM 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17"/>Hessa gaason</para>
  <para style="q2" vid="LAM 5:17">nu wozinay daaburdes;</para>
  <para style="q2" vid="LAM 5:17">nu ayfeykka baljumides.<verse eid="LAM 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18"/>Xiyoone biittay bula gidida gishshas</para>
  <para style="q2" vid="LAM 5:18">worakanati guppizasoho gidides.<verse eid="LAM 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 5:19"/>Abeet GODAWU!</para>
  <para style="q2" vid="LAM 5:19">Neni mernaas haaraasa;</para>
  <para style="q2" vid="LAM 5:19">ne kawoteththay yeletappe</para>
  <para style="q2" vid="LAM 5:19">yeleta gakkanaas daana.<verse eid="LAM 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20"/>Ne nuna ays ubba wode</para>
  <para style="q2" vid="LAM 5:20">co7u gay?</para>
  <para style="q2" vid="LAM 5:20">qasse ays</para>
  <para style="q2" vid="LAM 5:20">hayssa gakkanaas aggaagadii?<verse eid="LAM 5:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21"/>GODAWU! Neni nuna neekko zaara;</para>
  <para style="q2" vid="LAM 5:21">nunikka neekko simmana!</para>
  <para style="q2" vid="LAM 5:21">beni nu bonchchoza zaarada</para>
  <para style="q2" vid="LAM 5:21">nuna ooraththa!<verse eid="LAM 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22"/>Ne hessaththo ooththontta aggiko</para>
  <para style="q2" vid="LAM 5:22">nuna mulera aggadii?</para>
  <para style="q2" vid="LAM 5:22">ne hanqozaska zaway baawee?<verse eid="LAM 5:22"/></para>
  <chapter eid="LAM 5"/>
</usx>
